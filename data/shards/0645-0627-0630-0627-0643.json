1,0],["ما ذاكَ إلاّ لِجَري الفُلكِ بينَهُمَا","والجوشُ يَجذُبُها بينَ السِّماكَينِ",110,"ن",1,0],["ما ذاكَ إلاّ أَنَّ ربّك بالذي","فيهِ الزواجِرُ للورى أَوحى لها",111,"ل",3,0],["ما ذاك إلا لشكواها فقد عطفت","قلبي على كل شاك بعدها شفقا",112,"ق",2,0],["ما ذاك مما تشت","كي من صفعه الشماشك",113,"ك",1,0],["ما ذاك على ذات اللمى والخالِ","لو تجعلني للثغر منها والي",114,"ي",1,1],["ما ذاكَ عَن رَوض رَأَيت بِها وَلا","عَن وَصل غانية وَضم غلام",115,"م",1,0],["ما ذاك إلا لسر فيه أودعه","لهديه برسُول اللّه والصحب",116,"ب",1,0],["ما ذاك إلا لأمر كان عن قدرٍ","فما لنا ولكم أن نعلم السببا",117,"ب",2,0],["ما ذاك إلاَّ أنه قد فَرَّ مِن","خَوفٍ وقد جارَتْ به الأحْكامُ",118,"م",1,0],["ما ذاك أوَّلَ شائِمٍ","لِلْبَرْقِ أرْدَتْهُ الصَّواعِقْ",119,"ق",1,0],["مَاذَاكَ إِلاَّ أَنَّ وَقَّادَ الجَوَى","بَيْنَ الجَوَانِحِ دَائِمُ الإِيْقَادِ",120,"د",1,0],["ما ذاكَ إِلاَّ أَنَّ سُلْطان الهَوى","وَبِهِ عَزَزْنَ أعَزُّ من سُلْطاني",121,"ن",2,0],["ما ذاك إلا لبُشْرى صحّةٍ وردَتْ","بالنّجْحِ للدّينِ والدنْيا بها لهَجُ",122,"ج",1,0],["ماذاك منها قيل الاَّ حسرةٌ","لفراقها ابناً قد مضى وتفجُّعُ",123,"ع",1,0],["ما ذاك الا سحر ما روته","ببابل صنيع مني السداد",124,"د",1,0],["ماذاكُمُ نُوراً تراهُ وَهوَ إذ","يبدو فترمُقُهُ عُيُونُ الناسِ",125,"س",1,0],["ماذاك إلا مصاب قد ألمَّ بها","فزال باذخها وانهاض راسيها",126,"ي",3,0],["ما ذاك إِلا أَن تَكو","ن أَرَدتَ بي أَمراً شَطط",127,"ط",1,0],["ما ذاكر اللجة ريًّا له","كذاكر اللجة فيها الخطر",128,"ر",1,0],["ما ذاكَ عُوفيتِ يا لَمياءُ مِن كِبَرٍ","إِنّي وَطَرفِ الصِبا المَقرور ما قَرَحا",129,"ح",2,0],["ما ذاك إلا أنهم بعد الهدى","تبعوا لضلال فهدموا أركانها",130,"ن",3,0],["ما ذاكَ إِلّا لِأَنَّ العَيشَ مُقتَبلٌ","وَاللَيلُ مُلتَحفٌ بِالبَردِ وَالطولِ",131,"ل",1,0],["ما ذاكَ إلا جالِبٌ","للضُّرِّ فيما يَعتميه",132,"ي",2,0],["ما ذاك إلا لالتماس مكارم","من سادة نالوا السعادة في الأزل",133,"ل",1,0],["ما ذاك إلا أنهم","قوم المظلل بالغمام",134,"م",1,0],["ما ذاك من عبث ولكن في الهوى","ميلان غصن البانة المتأود",135,"د",1,0],["ما ذاكَ اِلّا قَلبَهُ","طور بِهِ لبي النَدا",136,"د",2,0],["ما ذاك من عجب وفي سودائها","سر العوالم والأغر الأبيض",137,"ض",1,0],["ما ذاك إلا سطوة هولية","تركت نظام المبطلين مبددا",138,"د",2,0],["ما ذاك إلا مدحة أمديتها","وغدا به حسن المديح مذمم",139,"م",1,0],["ما ذاك إلا نور مظهر كوكب","يمحو سناه دجا الظلام الفاحم",140,"م",1,0],["ما ذاك إلّا كمهدٍ بعض مفخرةٍ","إلى سماءِ السنا والفخرِ علياءَ",141,"ا",2,0],["ما ذاك إلّا كالغمام ونورها","كم قد أزاح غمامةً وحجابا",142,"ب",2,0],["ما ذاك إلا من فعال تجاذبٍ","بين العقول لها القلوب تساعدُ",143,"د",1,0],["ما ذاك إلّا من عواطف ملكنا","عبد الحميد له العلى ومحامدُ",143,"د",1,0],["ما ذاك إلامن تسامي عزةٍ","فاقت بنسبتها لسامي المحتدِ",144,"د",1,0],["ما ذاك إلّا لإعلان المحبة من","شأن الملوك لمن أوفى العبوديه",145,"ي",2,0],["ما ذاكَ من سَفَهٍ ولكن لا هوىً","ما لَم يَذر رَبَّ البصيرةِ كالعَمِي",146,"م",2,0],["ما ذاكَ إِلاَّ انَّ قلبيَ مُوثَقٌ","بالأَسرِ منكَ وأنَّ دمعيَ مُطلَقُ",147,"ق",1,0],["ما ذاكَ إلاَّ أَنَّ غُصنَ قَوامِها","نَضِرٌ بأَنفَاسِ الصبِّا يَتأوَّدُ",148,"د",1,0],["ما ذاك إلا أن أخبار النوى","وردت بفرقة شمله فتخوفا",149,"ف",2,0],["ما ذاك إلا أن شربهم صفا","لهم وشربك في السلوك مشوب",150,"ب",1,0],["ما ذاكَ إلا أن ينا","لَ الفضل وهو المنتخَبْ",151,"ب",1,0],["ما ذاك إلا لأن السعد كان لها","فضلاً بدار علاء خير منتدب",152,"ب",1,0],["ما ذاك إلا أنهم تركوا لنا","في كل شيء قدوة وتدبر",153,"ر",1,0],["ماذا كسبت وقد بذلت من القوى","والمال بالآلاف والمليون ؟",154,"ن",1,0],["ما ذاكَ إلَّا كي تشُدَّ بَصائراً","لكلامِها مِنْ مُعْجَبٍ أوْ مُتَّبعْ ..",155,"ع",1,0],["مَا ذَاكَ حُسْنِي يَا إِلَهِي رَحْمَةً","عُدْ لِي بِحُبِّي كَيْ أُنَاجِي عَالِمَا",156,"م",2,0],["ما ذاك بعد سوى محمد الكريم","الخسيم والأبناء والآباء",157,"ا",2,0],["ما ذاك شيبٌ بلى عنوان داهيةٍ","قلت غناءً لديها نفثة الراقي",158,"ق",2,0],["ما ذاك سوى رؤياي إذا","أبحرتَ بعالمِ أسراري",159,"ر",2,0],["ما ذاكَ شِعْرٌ أوْ حَديثُ كَهانَةٍ","أَتُراهُ سِحْرًا ؟ قالَها السُّفَهاءُ",160,"ا",2,0],["ماذا كأنَّكَ في الملاحِمِ صعقَةٌ","حقّاً فكنتَ بمُعجَبيكَ جديرا",161,"ر",2,0],["ما ذاك عيبٌ من الأزمانِ نحسبه","إنَّ العيوبَ بنا آجالها الفطنُ",162,"ن",1,1],["ما ذاك مدح أن أقل للشمس يا","شمس وقولي للأسود أسودُ",163,"د",1,0],["ماذاكَ إلا أنا في الصمتِ أعشقهُ","وبيْ أراهُ بعينِ الوَهمِ هَيمانا",164,"ن",2,0],["ما ذاكَ بِدَعٌ أنْ تجُودَ لِهَوْلِهِ","فَيضُ الجُفونِ بِوَبْلِها السَّحّاءِ",165,"ا",2,0],["ما ذاك إلا لإني بِتُّ مُقْتنِعاً","أنْ ليسَ يُحْرسُ غابُ الأُسدِ بالغنمِ",166,"م",1,0],["ما ذَاكَ إلا أنَّ بِيْضَ مَدَامِعي","غَاضَتْ مُبَدَّلَةً بحُمْرِ دِماءِ",167,"ا",2,0],["مَا ذَاكَ أَعْمَى وَلَكِنْ عَيْنُهُ عُصِبَتْ","لا بَلْ أَقُوْلُ عَنِ الأنْذَالِ قَدْ عُصِمَتْ",168,"ت",1,1],["ما ذاكَ عَنْ جُهْدٍ بذلتُ وطاقةٍ","لكنَّهُ فضلُ الذي خلقَ الوَرَى",169,"ر",2,0],["ما ذاك مين بل السني ينقلها","عن سيد الرسل والشيعي يرويها",170,"ي",3,0],["ما ذاك إلّا الوَهم يخشى من دفعهِ","ولو كان ذاحزم يعوج عن الندلا",171,"ل",2,0]]}