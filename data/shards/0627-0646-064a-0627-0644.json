288",""],[5956,"أسعى لتحسين أحوالها","https://www.poetsgate.com/ViewPoem.aspx?id=183396",""],[5956,"الوحدة واشتهاء الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183881",""],[5956,"هل ذاك حلم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183899",""],[5956,"أخشى عليكِ يا أمي","https://www.poetsgate.com/ViewPoem.aspx?id=192716",""],[5956,"رغم التآمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192938",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"محقُ السلاح أكبر ضامن للسلام","https://www.poetsgate.com/ViewPoem.aspx?id=194890",""],[5956,"سبحانَه القيُّومُ سمّاعُ الدُّعا","https://www.poetsgate.com/ViewPoem.aspx?id=204194",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""],[6079,"في ذكرى ميلاد والدي حفظه الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=210598",""],[6125,"عَاقَرتُ حُبَّكِ فَاستَحَلتُ مُرِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=209068",""],[6127,"وطن الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=189444",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""],[6331,"الصَّبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82022&r=&rc=3",""],[6346,"ذهابٌ بلا عودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84887&r=&rc=12",""]],"verses":[["إِنّي إِلى العَذبِ النَميرِ أَصابَني","بِيَدِ الهَوانِ شَرِبتُ بِالأَملاحِ",0,"ح",1,0],["إِنِّيَ آلَيتُ عَلى حَلفَةٍ","وَلَم أُقِلهُ عَثرَةَ العاثِرِ",1,"ر",1,0],["أَنّى ألَمَّ بِكَ الخَيالُ يَطيفُ","وَمَطافُه لَكَ ذِكرَةٌ وَشُعوفُ",2,"ف",1,1],["أَنّى اِلتَقَينا الِتَقى في كُلِّ مُجتَمَعٍ","أَهلٌ بِأَهلٍ وَإِخوانٌ بِإِخوانِ",3,"ن",1,0],["إِنّي إِلى تَقبيلِ كَفِّكَ شَيِّقٌ","شَوقاً يَضُمُّ عَلى جَوىً أَضلاعي",4,"ع",2,0],["أني ألوذ بدولة نصْريةٍ","حليَتْ محاسنها بكل كمالِ",5,"ل",1,0],["إِنّي إِلى جَبَلَي تَميمٍ مَعقِلي","وَمَحَلُّ بَيتي في اليَفاعِ الأَطوَلِ",6,"ل",1,0],["أَنّى اِلتَفَتُّ رَأَيتَ رَأساً طائِراً","أَو مُهجَةً مَطعونَةَن بِسِنانِ",7,"ن",1,0],["إنِّي إلهٌ طالما عَبَدَ الوَرَى","ظلِّي وخافوا لعنَتي وعقابي",8,"ب",2,0],["اني التفت فلا ارى شيئا سوى","بحر به الامواج كالابراج",9,"ج",1,0],["اني الى الموت اهدى","في كل يوم تحايا",10,"ا",3,0],["اني التفت رأيت مرأى مشجيا","او مشهداً تندى له الاعيان",11,"ن",1,0],["أنَّي التفت أرى الحياة كأنها","شخص يقابلني بوجه أسفع",12,"ع",1,0],["إِنّي اِلتَفَتُّ إِلى الشَبا","بِ الغابِرِ المُتَمَثِّلِ",13,"ل",1,0],["إِنّي إِلى خَيرِ البَرِيَّةِ كُلِّها","رَحَلتُ وَما ضاقَت عَلَيَّ المَطامِعُ",14,"ع",1,1],["إِني التفتُ إِلى مكانِكِ والمنى","شُلَّت وقلبي لا يطيقُ حراكا",15,"ك",2,0],["إني التفت إلى مكانك بعدما","خليته فبكيت سوء مكاني",16,"ن",2,0],["إني إليكَ لضدُّ","بي منهُ جرحٌ ممضُّ",17,"ض",1,1],["إني إلى التفليسِ ماضٍ إذا","أهملتَ هذا الأمرَ مستقبلا",18,"ل",2,0],["إني إلى العفافِ منهُ شيِّق","وكلُّ لهوٍ دنيويٍّ موبقُ",19,"ق",1,0],["إني إلى طلعتِهِ شيِّقُ","واللفظُ عنْ أوصافِهِ ضيِّقُ",20,"ق",1,1],["أَن يَألَفِ الهَضبَ لا يَبغِ الوُهودَ بِهِ","أَو يَألَف الوَهدَ لا يُؤثَر بِهِ ريعا",21,"ع",2,0],["أَنىَّ اِلتفتُ أَرى أَما","مي من رجال السوء ضدا",22,"د",2,0],["إني إلى حاجة لي","بلا عصا لا أَسير",23,"ر",1,0],["إني أُلِمُّ بما أُشاهد يقظةً","فأشك في عيني وَفي إِلمامي",24,"م",2,0],["إِنّي إِلَيكِ بِما وَعَدتِ لناظِرٌ","نَظَرَ الفَقيرِ إِلى الغَنِيِّ المُكثِرِ",25,"ر",1,0],["إِنِّي إِلى اللَّهِ مِن عُقْبَى بُليتُ بها","جَرَى بها الحُكْمُ والأَمْرُ الإِلهِيُّ",26,"ي",1,0],["إني الذي أبدع هذا السنا","من عدمٍ..ولم يعش غير حين",27,"ن",1,0],["إني الدمشقي الذي احترف الهوى","فاخضوضرت بغنائه الأعشاب",28,"ب",1,0],["أنّى التفتّ رأيت رأسا طائرا","أو مهجة مطعونة بسنان",29,"ن",1,0],["إني الهِزبَرُ الذي إِن رِئَى في بَلدٍ","واحتازَهُ خِيفَ دهراً ذَلِك البَلدُ",30,"د",1,0],["أنيَّ ألامُ وفي غاب الغرامُ أنا","ليثٌ وأجمعُ أهل العشقِ أشبالُ",31,"ل",1,0],["إني أَلَذُّ عذابي في مَسَرَّتها","فيا صبابةُ زِيدي يا غرام قِدِ",32,"د",1,0],["إنّي اِلتجأتُ إِلى مقبولِ حضرتهِ","وكلُّ مَن عاذَ بالمقبول مقبولُ",33,"ل",1,0],["أنّى التفتّ فلا ترى إلا حديداً","أو شواظاً محرِقاً ودُخانا",34,"ن",2,0],["اني اليك بمدحي قد اتيت وبي","في النفس شيء ولا يخفى على الفطن",35,"ن",1,0],["إني إلى الحسن صاب","أشتاقه مذ ولدت",36,"ت",1,0],["إني إلى الورد عدت","وفي حماه نزلت",37,"ت",1,0],["إني التزمت خطيئة نُسِبت إلى","جهري ولم تسكن عقودَ سرائري",38,"ر",2,0],["إني ألذُّ العيشُ فيها بما","أولى عزيز الدين من رِفد",39,"د",1,0],["إني إلى رب العلى متوجه","بك عند كل ملمة تتمغط",40,"ط",1,0],["إِنِّي إِلَيْكَ مِنْ ذُنُوبِي تُبْتُ","وَبِمَحَبَّةِ الْهُدَى مَتَتُّ",41,"ت",1,0],["إِنّي أَلَذّ وَأَشتَهي سَقَمي بِهِ","وَمِنَ الشَقاوَةِ ما يَلَذُّ وَيُشتَهى",42,"ه",2,0],["إِنّي إِلى وَصلِها عَينُ الفَقيرِ فَإِن","تُغِنِّني بِقَريضي فَهيَ تُغنيني",43,"ن",2,0],["أَنّى التَفَتَّ بِها رَأَيتَ أَهِلَّةً","تَرنو بِمِثلِ عُيونِ غزلانِ النَّقا",44,"ق",2,0],["إني إليك بأحمد متشفع","ختم النبيين الرسول الطاهر",45,"ر",1,0],["إِنّي إِلَيكَ بَشيرُ الناسِ أَجمَعُهُم","يُنبيكَ بِالصِدقِ فَلتُهنِئكَ أَخبارُ",46,"ر",1,0],["إِني إِلَيكَ لَباسط","كَف الأَسير المُستَجير",47,"ر",1,0],["أنَّى التفتُّ ‘ بدا لِعَيْني شاخصٌ","دُوْنَ المُرَادِ وحارسٌ وحدودُ",48,"د",1,0],["اني المقيم على العهود ان تطل","بعد فعهدك بالضمير يصان",49,"ن",1,0],["أنى التبهج بالدنيا وزخرفها","وطيب عيشتها في روضها البهج",50,"ج",1,0],["إني الكفيل بإشهار الذي صنعت","يداك يا صاغرا يعنى بإصغاري",51,"ر",2,0],["أَنَّى التفتَّ فأنتَ في حِرزين من","حَرَمَيْ شهيدٍ سيِّدٍ وإمامِ",52,"م",1,0],["إنّي الشّجاعُ وقد جزِعتُ كما ترى","منّي الغَداةَ بمصرع ابن شجاعِ",53,"ع",1,1],["إِنّي الصديقُ لمن كنتَ الصديقَ له","ومن تُعادِي له منّي معاداتي",54,"ت",2,0],["إني الذي أبداً لوجهك ساجد","روح الوجود حياة من هو واجد",55,"د",1,0],["أَنّى التْفَتُّ رَأَيْتُ مِنْكَ مَحاسِناً","إِنْ مِلْتُ نَشْواناً فَهُنَّ سُقَاتي",56,"ت",2,0],["أَنَّى التفتُّ رَأَيْتُ مِنْ إِحْسانِهِ","أَثراً مُشاهَدَةً وَمِنْ إِجمالِهِ",57,"ل",2,0],["أنىَّ السلو وفيها خانني جلدي","وهل على مثلها صبر وسلوان",58,"ن",1,0],["اني الوصول إلى الخلاص ولا ترى","عيني إليه في العباب سبيلا",59,"ل",2,0],["أنى الحسود ينل من فضل الذي","منه الفضائل والمعارف نقبس",60,"س",1,0],["أنيَّ إلى الغير الرحال اشدها","ومن الذي شرعاً بذاك يسلم",61,"م",1,0],["إنى التفتن رأين ما يدمي الحشى","من نهب أبيات وسلب رداء",62,"ا",2,0],["إنّي إليكَ أبا العاصي موجّعة","أبا الحسين سقته الواكف الديمُ",63,"م",1,1],["إني الوفيُّ بعهد مصر وما أنا","للعهد بالناسي ولا بالسالي",64,"ل",2,0],["انِّي الى نامي شَذا","ميٍّ لبالصَّبِّ المشوقِ",65,"ق",1,0],["انِّي الذي اشتهرت جميلُ خلائقي","بفعالِ معروفٍ وقولٍ أحمدِ",66,"د",1,0],["إنِّي إِلى وصالكم مشتاق","أنحلني الفِراق والأشواق",67,"ق",1,0],["إِنّي المَشوقُ إِلى المَنازِلِ وَالحِمى","وُرْقُ الصّبابة في حشايَ صَوادِحُ",68,"ح",1,0],["إِنّي إِلَيك لَباعِثٌ بِخَريدَةٍ","مِنها عَلى شَمسِ النّهارِ مَلامِحُ",68,"ح",1,0],["إِنّي إِلَيكَ أَخا الإِحسانِ مُعتَذِرٌ","وَبابُ عُذري لَدَيكُم غير مُنغَلِقِ",69,"ق",1,0],["إِنّي إِلَيك لَمرسلٌ بِخَريدَةٍ","ضاءَت مُحيّاً وَهيَ تبسم مَبسَما",70,"م",2,0],["إِنّي إِلَيكَ موجِّهٌ ميّاسةً","بِنتَ اِفتِكارٍ مثلُها لا يولَدُ",71,"د",1,0],["إِنّي إِلَيهِ مُرسَلٌ بِخَريدَةٍ","حَسناءَ بِكرٍ ذاتِ طَرفٍ أَشكَلِ",72,"ل",1,0],["إني إليك إذا كتبتُ قصيدةً","لم يأتنى لجوابها مَرجوعُ",73,"ع",1,1],["إِنّي ألام وَما المَلام بصالح","وَسطا عَلى البازي المطلّ العقعق",74,"ق",1,0],["إنّي العليلُ ولكنّي اِمرؤٌ عذبت","له وساغت في قلبه العللُ",75,"ل",1,0],["إِنّي إِلى سُقيا يَمينِكَ عاطِشٌ","وَسَحابُها فَوقَ الخَلائِبِ ماطِرُ",76,"ر",1,0],["إني ألفت العيش منقطعاً","على الحلم المحال",77,"ل",1,0],["إِني إِلَيهِ لَعاشق مَتشوق","فَاِبعث إِلي بِهِ بِغَير مطال",78,"ل",1,0],["اني إلى قربهم قد زاد بي شغفي","والقلب اشجنه بالبعد تذكار",79,"ر",1,0],["اني إلى فضلك المبذول مستندي","فداو عيني دواء مثل يعقوب",80,"ب",1,0],["إني الغريق بما منى جرى ولانت","الغوث والشافع المقبول فافتقد",81,"د",1,0],["أني التفت فجدول متسلسل","أو جنة مرضية أو جوسق",82,"ق",1,0],["إني إلى الآداب نضِوُ مَفاوزٍ","ولكم أعاني دونَها وأَلاقي",83,"ق",2,0],["أَني القَتيل فيهم","فَهَل علي يَبكون",84,"ن",1,0],["إني إلى ذاك الجمال لشيق","وطلوعه من بعد طول غروبه",85,"ب",2,0],["إِنّي المُجاهِدُ وَاللَه النَصير لِمَن","شاءَ وَيَكفي عَزاءً قَلب مَنجودِ",86,"د",1,0],["إني إلى صلةٍ لأحوج كالذي","عدني وصلني يا سخيّا يكرمُ",87,"م",1,0],["اني ألومك والذي","أصفيتني يحدو الملامه",88,"م",2,0],["إني إليك أخا التقى","ألقي عنان القول عذرا",89,"ر",2,0],["إِنِّى إِلَيهِ مُعلَقُ","وَالقَلبَ مِنِّى مُحرَقُ",90,"ق",1,0],["انى التفت تجدهم بارزين على","ذرى المعالي ولاة الرأي والشان",91,"ن",1,0],["إني ألازمُ محبوبي ولو زأرت","حولي من الأهلِ آسادٌ وأشبالُ",92,"ل",1,0],["إنّي المحبُّ على البعادِ وإنْ تكنْ","كافيتَ حبّي يا فلانُ تهكُّما",93,"م",2,0],["أني التفت رأيت ما","يهنا به طرف البصير",94,"ر",1,0],["إنِّي الجَريحُ بلَحظ من","ضربَت بدفٍّ إذ وَفَت",95,"ت",1,1],["إني العَماءُ ولا عَماءَ لذاتي","وأنا الذي أتى ولست بآتي",96,"ت",2,1],["إنِّى اليك أبَداً فَقيرٌ","إنَّك فى الأشياءِ بى قَديرُ",97,"ر",1,0],["أنَّي التفتَّ رَأَيتَ فتنَةَ ناظِرٍ","مَاذا الذي يُنجيكَ من فتناتِها",98,"ت",3,0],["إني إليك رسول اللَه ملتجئ","فكن على بلين العطف منعطفا",99,"ف",2,0],["إني السطا للحادثات ونحن في","أمن الليالي والزمان مسالم",100,"م",1,0],["إنِّي إلى عفوِ الإمامِ عن الذي","لم أجنِهِ ورضاهُ عني ظامي",101,"م",2,0],["إني التمست لحيهم","إن مات منزلة تليق",102,"ق",1,0],["أنّى اِلتفتّ فَلا أَرى","إِلّا كَئيباً أَو حَزينا",103,"ن",2,0],["إِنّي أَلفت العشق في شرخ الصبا","وَتركته وَالسن في ريعانِ",104,"ن",1,0],["أَنّى اِلتفتَّ اليوم في بشره","أَلفيت روّاداً وَورّادا",105,"د",2,0],["أَنّى اِلتفت تجد لذكري رنّة","في كُلِّ وعد صادِق وَتوعّدِ",106,"د",1,0],["إِنّي إِلى أَجَلٍ إِن كُنتِ عالِمَةً","إِلَيهِ ما مُنتَهى عِلمي وَآثاري",107,"ر",2,0],["أنى التفتن لم يجدن مهربا","وهل لفاقد الكفيل مهرب",108,"ب",1,0],["إِني التَجأت إِلَيكُم أَبتَغي كَرَماً","وَأَنتَ أَكرَم ذي جود بِمَوجود",109,"د",1,0],["أَنَّ