تكم مرَّ التعب",249,"ب",1,0],["إني النَّسِيُّ الذي ينسى حماقتهُ","أليس حبُّكِ بعضاً من حماقاتي",250,"ت",2,0],["إني الأسيرُ ونارُ حبِّكِ جنَّتي","ووصالُكِ الأملُ الذي أتصبَّرُ",251,"ر",1,0],["أَنَّى الْتَفَتُّ فَلَا شَيْئاً أَرَاهُ سِوَى","مَخَالِبِ اليَأْسِ لَا تُبْقِي وَ لَا تَدَعُ",252,"ع",1,0]]}