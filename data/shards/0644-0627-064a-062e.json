لكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5431,"حرٌ..هكذا الرجلُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=212403",""],[5493,"يا طائرًا بالنور","https://www.poetsgate.com/ViewPoem.aspx?id=197223",""],[327,"إنَّ الوليدَ أميرَ المؤمنين لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3926",""],[5528,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=201194",""],[5533,"اِرْتفاعُ ضَغْطِ الدَّم","https://www.poetsgate.com/ViewPoem.aspx?id=176252",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203238",""],[2110,"لا تبك رسما عفا ولا طللا","https://www.poetsgate.com/ViewPoem.aspx?id=156290",""],[5644,"ضجيج صمت","https://www.poetsgate.com/ViewPoem.aspx?id=198643",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5720,"قِباب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=207599",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[4455,"ترك الأشياء طُرّاً وانحنى","https://www.poetsgate.com/ViewPoem.aspx?id=82286",""],[5782,"أوزان وشطآن","https://www.poetsgate.com/ViewPoem.aspx?id=185767",""],[5807,"ألزمت نفسي خمولاً","https://www.poetsgate.com/ViewPoem.aspx?id=187232",""],[5848,"البال ما روقه قهوة ولا شاهي","https://www.poetsgate.com/ViewPoem.aspx?id=48888",""],[5858,"استعطفي البدر","https://www.poetsgate.com/ViewPoem.aspx?id=188026",""],[5864,"تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=190339",""],[5950,"حكيت للناس حزن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=139979",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5956,"وشاح الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182126",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6093,"المرء يصنع للحاجات أخلاقا","https://www.poetsgate.com/ViewPoem.aspx?id=191743",""],[6093,"لا يَخْدَعَنَّكَ كونُ الدَّربِ وَاحِدَةً","https://www.poetsgate.com/ViewPoem.aspx?id=205819",""],[6115,"الذيب يأخذ صيدته بذراعه","https://www.poetsgate.com/ViewPoem.aspx?id=180785",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[6271,"عاشق التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80707&r=&rc=13",""]],"verses":[["لا يُخَلّى غَديرُهُم","عَن حَيا الماءِ ظامِيا",0,"ي",2,0],["لا يُخلِفُ المالَ إِلّا رَيثَ يُتلِفُهُ","وَلا يُذَمُّ عَلى ما رَوَّحَ الراعي",1,"ع",2,0],["لا يُخلِفُ الدَهرُ ما تَجودُ بِهِ","وَلا يُعيرُ الرِجالَ ما تَهَبُ",2,"ب",1,0],["لا يَخْدَعَنّكَ مَعْقِلٌ أشِبٌ ولَو","حلَّتْ علَيْهِ نِطاقَها الجَوْزاءُ",3,"ا",2,0],["لا يَخْضَعونَ لخَطْبٍ إن ألمَّ بِهمْ","وهَلْ تَهُزُّ الرِّياحُ الهُوجُ أطْوادا",4,"د",2,0],["لا يَخدَعَنَّكَ صِحَّةٌ وَيَسارُ","ما لا يَدومُ عَلَيكَ فَهوَ مُعارُ",5,"ر",1,1],["لاَ يُخْطِيءُ التَّوفِيقُ فِي حَقٍّ","فَيُنْصِفَ وَهْوَ يُولِي",6,"ل",2,0],["لا يَخفِيَنَّ عَلَيكَ أَنَّ مُحَمَّداً","مِن نَسلِ كُلِّ ضِفِنَّةٍ مِبطانِ",7,"ن",1,0],["لا يَخفَيَنَّ عَلَيكَ أَنَّ مُجاشِعاً","لَو يُنفَخونَ مِنَ الخُؤورِ لَطاروا",8,"ر",3,0],["لا يَخفَيَنَّ عَلَيكَ أَنَّ مُجاشِعاً","شَبَهُ الرِجالَ وَما هُمُ بِرِجالِ",9,"ل",1,0],["لا يخدع الآل بالموماة أعينها","من شربهن عن الأشوار في القربِ",10,"ب",1,0],["لا يختشِي موتَ نعمى كفهِ بشرٌ","كأنَّ أنعمهُ للخلقِ أقوات",11,"ت",1,0],["لا يختشي بيت قلبي غزوَ لائمه","فإنَّ للبيتِ ربًّا سوف يحميه",12,"ي",2,0],["لا يختشي ملاعب الظنون","والأمر مبنيٌّ على السكون",13,"ن",1,0],["لا يُخطئنِّي منك لَوزينَجٌ","إذا بدا أعجبَ أو عجّبا",14,"ب",2,0],["لا يُخْدَع المتَعلِّلُون ولا يعُمْ","في البحر إلى الحوتُ أو سُبَّاحُه",15,"ح",2,0],["لا يخدشنّ سفيهُ القوم في أدمي","فما مواقع أظفاري بتخديش",16,"ش",1,0],["لا يخيبنَّ ناظمٌ لك سمطاً","بات يفري عن دره الأصدافا",17,"ف",2,0],["لا يخطئ السالكون قصدهم","ميلاً إلى فتنة وناعقها",18,"ق",3,0],["لا يخلُ من نعمة وموعظة","تنهى الفتى أن ينفّر النعما",19,"م",2,0],["لا يَخدَعَنَّكَ كَلبِيٌّ بِذِمَّتِهِ","إِنَّ القُضاعِيَّ إِن جاوَزتَهُ غولُ",20,"ل",1,0],["لا يَخافُ المَثري وَلا كَلبَهُ الض","ضاري وَلا لِاِمرِئٍ بِهِ اِستِهزاءُ",21,"ا",2,0],["لا يَخدَعَنَّكَ ضَعفُهُنَّ فَإِنَّما","بِالضَعفِ أَهلَكَتِ الهَزيرَ الأَرنَبُ",22,"ب",1,0],["لا يَخدَعَنَّ الناظِرينَ بِروجُها","تِلكَ البُروجُ مَخابِئٌ لِلعارِ",23,"ر",1,0],["لا يَخدَعَنَّ العارِفونَ نُفوسَهُم","إِنَّ المَخادِعَ نَفسَهُ لَجَهولُ",24,"ل",1,0],["لا يَخدَعَنَّكَ مِنهُ طيبُ مَنطِقِهِ","فَطالَما لَعِبَت بِالعَقلِ أَوتارُ",25,"ر",1,0],["لا يخاف الراعي ذئاباً تعاوى","من بعيد ملحة في الطواف",26,"ف",1,1],["لا يخاف الذي يموت حكما","من سؤال لمنكر ونكير",27,"ر",1,0],["لا يخدم الأمم الرجال إذا همو","لم يخدموا الأخلاق والآدابا",28,"ب",2,0],["لا يَخدَعَنَّكَ مِن عَدُوٍّ دَمعُهُ","وَاِرحَم شَبابَكَ مِن عَدُوٍّ تَرحَمُ",29,"م",1,0],["لا يَخلِطُ الغَدرَ بِالوَفاءِ وَلا","وَبيعُ إِلفُ الخُلّانِ بِالمَلَل",30,"ل",1,0],["لاَ يُخْلِفُ الوَعْدَ مَيْمُوناً نَقِيبَتُهُ","رَحْبُ الفِنَاءِ أَرِيبٌ حِينَ يُعْتَرَمُ",31,"م",1,0],["لا يَخطُبنَّ إليَّ حَلْيَ مَدائحي","أَحَدٌ فقد وجَدَ السِّوارُ المِعصمَا",32,"م",2,0],["لا يَختَشي سُخطَهُ عَلَيهِ وَلا","يَحذَرُ مِن مَكرِهِ وَلا غَضَبِه",33,"ب",2,0],["لا يخدعنَّك منها وهي صامتة","صمت القبور فراغ الموت والعدم",34,"م",1,0],["لا يَخونُ الخَليلَ شَيئاً وَلَكِن","رُبَّما يُحسَبُ المُطيعَ أَمينا",35,"ن",2,0],["لا يَخدَعَنَّكَ ظاهِرٌ مِن مُحنِقٍ","خافَ الشَكاةَ فَلاذَ بِالكِتمانِ",36,"ن",1,0],["لا يَخدعنّك أَنها","راقت وَكللها الحبب",37,"ب",1,0],["لا يَخلِطُ الهَيمَةَ بِالتَنويمِ","مُنخَفِضٌ في كَنَفِ التَشويمِ",38,"م",1,0],["لا يَخرُجُ الحَمدُ مِنّي قَبلَ تَجرُبَةٍ","وَلا أَكونُ أُجاجاً بَعدَ تَجريبِ",39,"ب",1,0],["لا يَخفِضُ الرِزَّ عَن أَرضٍ أَلَمَّ بِها","وَلا يَضِلُّ عَلى مِصباحِهِ الساري",40,"ر",2,0],["لا يَخدَعَنَّكَ داعٍ قامَ في مَلَإٍ","بِخُطبَةٍ زانَ مَعناها وَطَوَّلَها",41,"ل",3,0],["لا يَخدَعَنَّكَ أُخرانا كَأَوَّلِنا","في نَحوِ ما نَحنُ فيهِ كانَتِ الأُمَمُ",42,"م",1,0],["لا يخدعنْك تزلفٌ يدلي به","يا شرق إن الغرب غير صديق",43,"ق",1,0],["لا يخدع المرء إنساناً لغايته","إلا إذا كان ذاكَ المرء شَيطانا",44,"ن",2,0],["لا يَخاف الَّذي يَنام بقبرٍ","ما به من عقارب وأفاعي",45,"ع",2,0],["لا يَخْلُبَنَّكَ بارِقٌ مُتَلَمِّعٌ","إنّ البُروقَ تَخونُ في تَلْماعِها",46,"ع",3,0],["لِأَيِّ خَلِيلٍ فِي الزَّمَانِ أُرَافِقُ","وَأَكْثَرُ مَنْ لاقَيْتُ خِبٌّ مُنَافِقُ",47,"ق",1,1],["لا يَخْدَعَنَّكَ في الْمُدَامَةِ جَاهِلٌ","إِنَّ الْمُدَامَةَ نُهْزَةُ الأَكْيَاسِ",48,"س",1,0],["لا يَخْفِضُ الْبُؤْسُ نَفْساً وَهْيَ عَالِيَةٌ","وَلا يُشِيدُ بِذِكْرِ الْخَامِلِ النَّشَبُ",49,"ب",1,0],["لا يخدعنك منه مظهرُ هادئ","فالبحر أهدؤه المخيفُ الأقتم",50,"م",1,0],["لا يَخْدَعنَّهم الجمال، ولا الغِنَى","إن يَبْتَغُوهُ، فإِنهّمْ تُجَّار",51,"ر",1,0],["لا يخدعنَّكم الدُّهاةُ بزائفٍ","من قولهم، عذبِ المذاق، زُعاف",52,"ف",1,0],["لا يخدعنَّكم الشبابُ؛ فإِنه","ليَمُرُّ مثلَ البرق في الإسراع",53,"ع",1,0],["لا يخدعَنَّكم امرُؤٌ","في دينه قد سُووِما",54,"م",2,0],["لا يخدعنكم الهزبر بصمته","فلعلَّ في صدر الهزبر أتُونا",55,"ن",2,0],["لا يخْشَعُون لِدَمْع أطْ","فَال يَتَامَى في المهود",56,"د",1,0],["لا يَخْلِطُ الغَدْرَ بالوَفَاء ، وَلاَ","يبيعُ إِلْفَ الخُلاَّنِ بالمَلَل",57,"ل",1,0],["لا يخدعنّ الناظرين برجها","تلك البروج مخابيء للعار",58,"ر",1,0],["لا يخاف المثري، ولا كلبه الضاري","، ولا لامرىء به استهزاء",59,"ا",2,0],["لا يخدعتك ضعفهنّ فإنّما","بالضعف أهلكت الهزير الأرنب",60,"ب",1,0],["لا يخدع الله قوما يؤمنون به","فتلك خدعة إنسان لإنسان",61,"ن",1,0],["لا يُخطىء ُ السالكون قصدْهُم","ميلاً إلى فتنة ٍ وناعقها",62,"ق",3,0],["لا يُخْدَع المتَعَلِّلُونَ ولا يَعُمْ","في البحر إلا الحوتُ أو سُبَّاحُه",63,"ح",2,0],["لا يخدعنك لسان منه منطلق","وافطن فتلك جهارا عادة البقر",64,"ر",1,0],["لا يخصب الظن حيث تنمو","فالنفس من شرها عقيم",65,"م",1,0],["لا يخدعنك حسن أنت لابسه","فلابس الحلى في الدنيا إلى عطل",66,"ل",1,0],["لا يخصب الظن في جدب الزمان ولا","يضوع في قفره عرف الرياحين",67,"ن",1,0],["لا يخدعنك ما ترى من حبنا","فكأنه مع يومه ملحود",68,"د",1,0],["لا يُخرِجُ القَسرُ مِنّي غَيرَ مَأَبِيَةٍ","وَلا أَلينُ لِمَن لا يَبتَغي ليني",69,"ن",2,0],["لا يَخافُ الأَملاكَ مُذ فارَقَ المَه","دَ وَهَل تَرهَبُ الأُسودُ الذِئابا",70,"ب",2,0],["لا يُخامِركَ في بَقائِكَ شَكٌّ","حَسبُكَ العَدلُ بِالبَقاءِ كَفيلا",71,"ل",2,0],["لا يخدعنَّك ظاهرٌ من باطنٍ","حتى يصدّقه لك البرهان",72,"ن",1,1],["لا يَخْطُرُ الفَرُّ فِي كَرٍّ بِخاطِرِهِ","وَلا يُؤَخِّرُ عَنْ إِقدَامِهِ قَدَمَا",73,"م",2,0],["لاَ يُخْدَعَنَّ لَبيبُنَا منْ صَيْحَةٍ","إنْ قَلَّدَ العُمْيَان صَوْتَ البَبَغَاءْ",74,"ا",2,0],["لا يختشى فوتاً قوياً فارجعوا","ولينصرف من كان يلقى ومصرفا",75,"ف",2,0],["لا يختشيى كذبا في القول مادحه","ولا يرى خيبة في القصد راجيه",76,"ي",2,0],["لا يخرج التوفيقُ عن عَزماتِه","بل صاحبٌ وأخٌ لها ومُعين",77,"ن",1,0],["لا يخدعنّك لفظ طاب ظاهرهُ","من قائل بتّ مسروراً بظاهره",78,"ر",2,1],["لا يخدعنّك بالمنى","نفس تحدّث بالفواقر",79,"ر",1,0],["لا يخدعنّك إلفٌ","مواصل فيه ودّ",80,"د",1,0],["لا يخدعنَّك منا ظاهر حَفلٌ","بالابتسام وغَلغِل في خوافينا",81,"ن",2,0],["لا يخملُ الصدَّ منها والهوى بدني","ولا أطيقُ بلايا الحبِّ والزمنِ",82,"ن",1,1],["لا يخلط الجِدَّ بهزل ولا","يَهنيه في غير المعالي قرار",83,"ر",1,0],["لاَ يَخْدَعّنَّكَ حُسْنُ مَنْظَرِهِ","مِنْ خَارِجٍ وَالرَّوْضُ وَالنَّهْرُ",84,"ر",1,0],["لا يخلف القول إلّا في الوعيد ولا","ينفكّ عن حبّ إنجاز المواعيد",85,"د",1,0],["لا يَخدَعَنَّكَ رفقُه وليانُهُ","بعدَ الهوانِ ببطشهِ وعتوِّه",86,"و",2,0],["لا يُخلِدونَ إلى الرّاحاتِ من تَرَفٍ","ولا خُلُودَ إذا ما كانَ إِخْلادُ",87,"د",1,0],["لا يخدعنَّكَ منه لينُ قوامه","هَذا الَّذي صَدَع القُلوبَ بلينِهِ",88,"ن",2,0],["لا يَختَشي نوبَ الليالي جارُهُ","وَلو اِنّ سائرها به موتورُ",89,"ر",1,0],["لا يُخمِدُ الحَربَ إِلّا رَيثَ يُوقِدُها","في كُلِّ فَجٍّ لَهُ خَيل مَسانيفُ",90,"ف",1,0],["لا يخاف الأذى ويؤذي فيعفو","ويجازى جفاءهم باقتراب",91,"ب",1,0],["لا يختشى فَهوَ غَيث البرِّ إِن هتنا","إِذا سَطا لِمَعت بِطشاً بواترُه",92,"ر",2,0],["لا يختشى فَهوَ غ