367,"كم قلت للعاني المنى بلحاقه","https://www.aldiwan.net/poem17256.html","الكامل"],[367,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[372,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[381,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[381,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[381,"يا من لصب واله","https://www.aldiwan.net/poem49241.html","مجزوء الكامل"],[406,"لا يخيبن الفتى من أمرد","https://www.aldiwan.net/poem49503.html","الرمل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[430,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[433,"لم ترض أني قد حرمت وصالها","https://www.aldiwan.net/poem12711.html","الكامل"],[438,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[440,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[442,"يا خالق الخلق يا من جوده الجود","https://www.aldiwan.net/poem14289.html","البسيط"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[459,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[462,"حي الوزير كريمة أعطافه","https://www.aldiwan.net/poem15168.html","الكامل"],[462,"دأماء الجود وخضرمه","https://www.aldiwan.net/poem15691.html","المتدارك"],[466,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[506,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[516,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[539,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[539,"مما ابتلى الله به مراكشا","https://www.aldiwan.net/poem48194.html","عموديه"],[552,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"]],"verses":[["لا يُخَلّى غَديرُهُم","عَن حَيا الماءِ ظامِيا",0,"ي",2,0],["لا يُخلِفُ المالَ إِلّا رَيثَ يُتلِفُهُ","وَلا يُذَمُّ عَلى ما رَوَّحَ الراعي",1,"ع",2,0],["لا يُخلِفُ الدَهرُ ما تَجودُ بِهِ","وَلا يُعيرُ الرِجالَ ما تَهَبُ",2,"ب",1,0],["لا يَخْدَعَنّكَ مَعْقِلٌ أشِبٌ ولَو","حلَّتْ علَيْهِ نِطاقَها الجَوْزاءُ",3,"ا",2,0],["لا يَخْضَعونَ لخَطْبٍ إن ألمَّ بِهمْ","وهَلْ تَهُزُّ الرِّياحُ الهُوجُ أطْوادا",4,"د",2,0],["لا يَخدَعَنَّكَ صِحَّةٌ وَيَسارُ","ما لا يَدومُ عَلَيكَ فَهوَ مُعارُ",5,"ر",1,1],["لاَ يُخْطِيءُ التَّوفِيقُ فِي حَقٍّ","فَيُنْصِفَ وَهْوَ يُولِي",6,"ل",2,0],["لا يَخفِيَنَّ عَلَيكَ أَنَّ مُحَمَّداً","مِن نَسلِ كُلِّ ضِفِنَّةٍ مِبطانِ",7,"ن",1,0],["لا يَخفَيَنَّ عَلَيكَ أَنَّ مُجاشِعاً","لَو يُنفَخونَ مِنَ الخُؤورِ لَطاروا",8,"ر",3,0],["لا يَخفَيَنَّ عَلَيكَ أَنَّ مُجاشِعاً","شَبَهُ الرِجالَ وَما هُمُ بِرِجالِ",9,"ل",1,0],["لا يخدع الآل بالموماة أعينها","من شربهن عن الأشوار في القربِ",10,"ب",1,0],["لا يختشِي موتَ نعمى كفهِ بشرٌ","كأنَّ أنعمهُ للخلقِ أقوات",11,"ت",1,0],["لا يختشي بيت قلبي غزوَ لائمه","فإنَّ للبيتِ ربًّا سوف يحميه",12,"ي",2,0],["لا يختشي ملاعب الظنون","والأمر مبنيٌّ على السكون",13,"ن",1,0],["لا يُخطئنِّي منك لَوزينَجٌ","إذا بدا أعجبَ أو عجّبا",14,"ب",2,0],["لا يُخْدَع المتَعلِّلُون ولا يعُمْ","في البحر إلى الحوتُ أو سُبَّاحُه",15,"ح",2,0],["لا يخدشنّ سفيهُ القوم في أدمي","فما مواقع أظفاري بتخديش",16,"ش",1,0],["لا يخيبنَّ ناظمٌ لك سمطاً","بات يفري عن دره الأصدافا",17,"ف",2,0],["لا يخطئ السالكون قصدهم","ميلاً إلى فتنة وناعقها",18,"ق",3,0],["لا يخلُ من نعمة وموعظة","تنهى الفتى أن ينفّر النعما",19,"م",2,0],["لا يَخدَعَنَّكَ كَلبِيٌّ بِذِمَّتِهِ","إِنَّ القُضاعِيَّ إِن جاوَزتَهُ غولُ",20,"ل",1,0],["لا يَخافُ المَثري وَلا كَلبَهُ الض","ضاري وَلا لِاِمرِئٍ بِهِ اِستِهزاءُ",21,"ا",2,0],["لا يَخدَعَنَّكَ ضَعفُهُنَّ فَإِنَّما","بِالضَعفِ أَهلَكَتِ الهَزيرَ الأَرنَبُ",22,"ب",1,0],["لا يَخدَعَنَّ الناظِرينَ بِروجُها","تِلكَ البُروجُ مَخابِئٌ لِلعارِ",23,"ر",1,0],["لا يَخدَعَنَّ العارِفونَ نُفوسَهُم","إِنَّ المَخادِعَ نَفسَهُ لَجَهولُ",24,"ل",1,0],["لا يَخدَعَنَّكَ مِنهُ طيبُ مَنطِقِهِ","فَطالَما لَعِبَت بِالعَقلِ أَوتارُ",25,"ر",1,0],["لا يخاف الراعي ذئاباً تعاوى","من بعيد ملحة في الطواف",26,"ف",1,1],["لا يخاف الذي يموت حكما","من سؤال لمنكر ونكير",27,"ر",1,0],["لا يخدم الأمم الرجال إذا همو","لم يخدموا الأخلاق والآدابا",28,"ب",2,0],["لا يَخدَعَنَّكَ مِن عَدُوٍّ دَمعُهُ","وَاِرحَم شَبابَكَ مِن عَدُوٍّ تَرحَمُ",29,"م",1,0],["لا يَخلِطُ الغَدرَ بِالوَفاءِ وَلا","وَبيعُ إِلفُ الخُلّانِ بِالمَلَل",30,"ل",1,0],["لاَ يُخْلِفُ الوَعْدَ مَيْمُوناً نَقِيبَتُهُ","رَحْبُ الفِنَاءِ أَرِيبٌ حِينَ يُعْتَرَمُ",31,"م",1,0],["لا يَخطُبنَّ إليَّ حَلْيَ مَدائحي","أَحَدٌ فقد وجَدَ السِّوارُ المِعصمَا",32,"م",2,0],["لا يَختَشي سُخطَهُ عَلَيهِ وَلا","يَحذَرُ مِن مَكرِهِ وَلا غَضَبِه",33,"ب",2,0],["لا يخدعنَّك منها وهي صامتة","صمت القبور فراغ الموت والعدم",34,"م",1,0],["لا يَخونُ الخَليلَ شَيئاً وَلَكِن","رُبَّما يُحسَبُ المُطيعَ أَمينا",35,"ن",2,0],["لا يَخدَعَنَّكَ ظاهِرٌ مِن مُحنِقٍ","خافَ الشَكاةَ فَلاذَ بِالكِتمانِ",36,"ن",1,0],["لا يَخدعنّك أَنها","راقت وَكللها الحبب",37,"ب",1,0],["لا يَخلِطُ الهَيمَةَ بِالتَنويمِ","مُنخَفِضٌ في كَنَفِ التَشويمِ",38,"م",1,0],["لا يَخرُجُ الحَمدُ مِنّي قَبلَ تَجرُبَةٍ","وَلا أَكونُ أُجاجاً بَعدَ تَجريبِ",39,"ب",1,0],["لا يَخفِضُ الرِزَّ عَن أَرضٍ أَلَمَّ بِها","وَلا يَضِلُّ عَلى مِصباحِهِ الساري",40,"ر",2,0],["لا يَخدَعَنَّكَ داعٍ قامَ في مَلَإٍ","بِخُطبَةٍ زانَ مَعناها وَطَوَّلَها",41,"ل",3,0],["لا يَخدَعَنَّكَ أُخرانا كَأَوَّلِنا","في نَحوِ ما نَحنُ فيهِ كانَتِ الأُمَمُ",42,"م",1,0],["لا يخدعنْك تزلفٌ يدلي به","يا شرق إن الغرب غير صديق",43,"ق",1,0],["لا يخدع المرء إنساناً لغايته","إلا إذا كان ذاكَ المرء شَيطانا",44,"ن",2,0],["لا يَخاف الَّذي يَنام بقبرٍ","ما به من عقارب وأفاعي",45,"ع",2,0],["لا يَخْلُبَنَّكَ بارِقٌ مُتَلَمِّعٌ","إنّ البُروقَ تَخونُ في تَلْماعِها",46,"ع",3,0],["لِأَيِّ خَلِيلٍ فِي الزَّمَانِ أُرَافِقُ","وَأَكْثَرُ مَنْ لاقَيْتُ خِبٌّ مُنَافِقُ",47,"ق",1,1],["لا يَخْدَعَنَّكَ في الْمُدَامَةِ جَاهِلٌ","إِنَّ الْمُدَامَةَ نُهْزَةُ الأَكْيَاسِ",48,"س",1,0],["لا يَخْفِضُ الْبُؤْسُ نَفْساً وَهْيَ عَالِيَةٌ","وَلا يُشِيدُ بِذِكْرِ الْخَامِلِ النَّشَبُ",49,"ب",1,0],["لا يخدعنك منه مظهرُ هادئ","فالبحر أهدؤه المخيفُ الأقتم",50,"م",1,0],["لا يَخْدَعنَّهم الجمال، ولا الغِنَى","إن يَبْتَغُوهُ، فإِنهّمْ تُجَّار",51,"ر",1,0],["لا يخدعنَّكم الدُّهاةُ بزائفٍ","من قولهم، عذبِ المذاق، زُعاف",52,"ف",1,0],["لا يخدعنَّكم الشبابُ؛ فإِنه","ليَمُرُّ مثلَ البرق في الإسراع",53,"ع",1,0],["لا يخدعَنَّكم امرُؤٌ","في دينه قد سُووِما",54,"م",2,0],["لا يخدعنكم الهزبر بصمته","فلعلَّ في صدر الهزبر أتُونا",55,"ن",2,0],["لا يخْشَعُون لِدَمْع أطْ","فَال يَتَامَى في المهود",56,"د",1,0],["لا يَخْلِطُ الغَدْرَ بالوَفَاء ، وَلاَ","يبيعُ إِلْفَ الخُلاَّنِ بالمَلَل",57,"ل",1,0],["لا يخدعنّ الناظرين برجها","تلك البروج مخابيء للعار",58,"ر",1,0],["لا يخاف المثري، ولا كلبه الضاري","، ولا لامرىء به استهزاء",59,"ا",2,0],["لا يخدعتك ضعفهنّ فإنّما","بالضعف أهلكت الهزير الأرنب",60,"ب",1,0],["لا يخدع الله قوما يؤمنون به","فتلك خدعة إنسان لإنسان",61,"ن",1,0],["لا يُخطىء ُ السالكون قصدْهُم","ميلاً إلى فتنة ٍ وناعقها",62,"ق",3,0],["لا يُخْدَع المتَعَلِّلُونَ ولا يَعُمْ","في البحر إلا الحوتُ أو سُبَّاحُه",63,"ح",2,0],["لا يخدعنك لسان منه منطلق","وافطن فتلك جهارا عادة البقر",64,"ر",1,0],["لا يخصب الظن حيث تنمو","فالنفس من شرها عقيم",65,"م",1,0],["لا يخدعنك حسن أنت لابسه","فلابس الحلى في الدنيا إلى عطل",66,"ل",1,0],["لا يخصب الظن في جدب الزمان ولا","يضوع في قفره عرف الرياحين",67,"ن",1,0],["لا يخدعنك ما ترى من حبنا","فكأنه مع يومه ملحود",68,"د",1,0],["لا يُخرِجُ القَسرُ مِنّي غَيرَ مَأَبِيَةٍ","وَلا أَلينُ لِمَن لا يَبتَغي ليني",69,"ن",2,0],["لا يَخافُ الأَملاكَ مُذ فارَقَ المَه","دَ وَهَل تَرهَبُ الأُسودُ الذِئابا",70,"ب",2,0],["لا يُخامِركَ في بَقائِكَ شَكٌّ","حَسبُكَ العَدلُ بِالبَقاءِ كَفيلا",71,"ل",2,0],["لا يخدعنَّك ظاهرٌ من باطنٍ","حتى يصدّقه لك البرهان",72,"ن",1,1],["لا يَخْطُرُ الفَرُّ فِي كَرٍّ بِخاطِرِهِ","وَلا يُؤَخِّرُ عَنْ إِقدَامِهِ قَدَمَا",73,"م",2,0],["لاَ يُخْدَعَنَّ لَبيبُنَا منْ صَيْحَةٍ","إنْ قَلَّدَ العُمْيَان صَوْتَ البَبَغَاءْ",74,"ا",2,0],["لا يختشى فوتاً قوياً فارجعوا","ولينصرف من كان يلقى ومصرفا",75,"ف",2,0],["لا يختشيى كذبا في القول مادحه","ولا يرى خيبة في القصد راجيه",76,"ي",2,0],["لا يخرج التوفيقُ عن عَزماتِه","بل صاحبٌ وأخٌ لها ومُعين",77,"ن",1,0],["لا يخدعنّك لفظ طاب ظاهرهُ","من قائل بتّ مسروراً بظاهره",78,"ر",2,1],["لا يخدعنّك بالمنى","نفس تحدّث بالفواقر",79,"ر",1,0],["لا يخدعنّك إلفٌ","مواصل فيه ودّ",80,"د",1,0],["لا يخدعنَّك منا ظاهر حَفلٌ","بالابتسام وغَلغِل في خوافينا",81,"ن",2,0],["لا يخملُ الصدَّ منها والهوى بدني","ولا أطيقُ بلايا الحبِّ والزمنِ",82,"ن",1,1],["لا يخلط الجِدَّ بهزل ولا","يَهنيه في غير المعالي قرار",83,"ر",1,0],["لاَ يَخْدَعّنَّكَ حُسْنُ مَنْظَرِهِ","مِنْ خَارِجٍ وَالرَّوْضُ وَالنَّهْرُ",84,"ر",1,0],["لا يخلف القول إلّا في الوعيد ولا","ينفكّ عن حبّ إنجاز المواعيد",85,"د",1,0],["لا يَخدَعَنَّكَ رفقُه وليانُهُ","بعدَ الهوانِ ببطشهِ وعتوِّه",86,"و",2,0],["لا يُخلِدونَ إلى الرّاحاتِ من تَرَفٍ","ولا خُلُودَ إذا ما كانَ إِخْلادُ",87,"د",1,0],["لا يخدعنَّكَ منه لينُ قوامه","هَذا الَّذي صَدَع القُلوبَ بلينِهِ",88,"ن",2,0],["لا يَختَشي نوبَ الليالي جارُهُ","وَلو اِنّ سائرها به موتورُ",89,"ر",1,0],["لا يُخمِدُ الحَربَ إِلّا رَيثَ يُوقِدُها","في كُلِّ فَجٍّ لَهُ خَيل مَسانيفُ",90,"ف",1,0],["لا يخاف الأذى ويؤذي فيعفو","ويجازى جفاءهم باقتراب",91,"ب",1,0],["لا يختشى فَهوَ غَيث البرِّ إِن هتنا","إِذا سَطا لِمَعت بِطشاً بواترُه",92,"ر",2,0],["لا يختشى فَهوَ غَيث البرِّ إِن هتنا","إِذا سَطا لمَعت بِطشاً عَواملُه",93,"ل",2,0],["لا يختَشى فَهوَ غَيث البرّ إِن هَتَنا","بَل يرتَجى وَهوَ لَيث الغاب إِن زَأَرا",94,"ر",2,0],["لا يختشى فَهوَ غَيث البرّ إِن هَتَنا","بَل يُرتَجى وَهوَ لَيث الغاب إِن حملا",95,"ل",2,0],["لا يختشى فَهوَ غَيث البرّ إِن هَتَنا","بَل يرتَجى وَهوَ لَيث الغاب إِن وَثَبا",96,"ب",2,0],["لا يختشى فَهوَ غَيث البرِّ إِن هَتَنا","إِذا سَطا لمَعَت بَطشاً قَواضبُه",97,"ب",2,0],["لا يَخيطُ الكَرى جُفونَ أعادي","هِ على الأمْنِ بالمَحَلِّ القاصي",98,"ص",2,0],["لا يَخدَعَنّي مُنعِمٌ مِن بَعدِهِ","أَغنى نَداهُ البَحرُ عَن أَوشالِهِ",99,"ل",2,0],["لا يَخدَعَنَّكَ في خَدَّيهِ ماءُ رِضاً","فَإِنَّ في قَلبِهِ ناراً مِنَ الغَضَبِ",100,"ب",1,0],["لا يخطرُ الفكرُ في كتابَتهِ","كأنَّ أقلامَه لها خاطِر",101,"ر",1,0],["لا يخطىء المقاصدَ التصورُ","لا الجبن محمودٌ ولا التهوّرُ",102,"ر",1,0],["لا يَخدَعَنَكَ جَمال صوره","ما لَم يَزَنها حسن سيرَهُ",103,"ر",2,1],["لا يَخُطر الإِنصاف قَط","وَلا الحُنوّ بِبالِهِ",104,"ل",2,0],["لا يَخيبَنَّ الفَتى من أمرَدٍ","ردَّهُ في الوقتِ أو جادَلَهُ",105,"ه",1,1],["لا يختشي في الله لوم لائم","أفتى على الحقّ وبالحقّ قضى",106,"ا",1,0],["لا يختشي وقع اليماني ولا","طعن الرديني لا ولا يحذر",107,"ر",1,0],["لا يخطُبُ العوراءَ من فيهِ ولا","يخشى كريمةَ جارِه إقلالَها",108,"ل",3,0],["لا يخى من مضاربه","يلب في الروع أمجد",109,"د",1,0],["لا يخلعُ الإِسلامُ حُلَّةَ آمِنٍ","منهُ وَلا الإِشراكُ رِبقَةَ هائِبِ",110,"ب",1,0],["لا يخل منك مكان والمكان فلا","يحويك كل مكان منك مشهود",111,"د",1,0],["لا يخلُقُ الليل لألحاظها","وحشةَ عين العاكر المعتمِ",112,"م",1,0],["لا يُخلفُ الظنَّ ولا","يَلقَى الحقوقَ بالعُذُرْ",113,"ر",1,0],["لا يخلُقُ الخَجْلَةَ في وجهه","لا مادحٌ أَثنَى ولا عائبُ",114,"ب",1,0],["لا يَخلُقُ العَدلُ في خلائقهم","ليناً ولا يُكْرَمُونَ إن شربوا",115,"ب",3,0],["لا يختشي غضبَ العساكرِ بعدما","صرفَ الزمان إلى رضا الرحْمنِ",116,"ن",1,0],["لا يَخْشى الجارُ صُروفَ ردىً","ويمين الدولةِ مُنْجِدهُ",117,"د",2,0],["لا يَخفِضونَ لِغَيرِ اللهِ أرؤسَهُم","ولا يَنامونَ لو أطفالُهُم جَفَلُوا",118,"ل",3,0],["لا يخدعنّك صبرٌ طال والألمُو","لن يقنعَ القومُ حتّى يرجعَ الغضبُ",119,"ب",1,0],["لا يخجل الغيث يوماً أن يقر له","ويرى الليث عاراً منه إن فرقا",120,"ق",2,0],["لا يَخدَعَنَّكَ بِالخُروجِ إذا أتى","فَلَدَيهِ قَلبُ حَقائِقِ الأعيانِ",121,"ن",1,0],["لا يَختفي حتى يعودَ لِحينِه","أيَخالُني أخشى منَ الهِجرانِ",121,"ن",1,0],["لا يَختشي مِن بَأسِه ذو حِرفَةٍ","إن كان أيرٌ عندَه كبيرُ",122,"ر",1,0],["لا يَخِفّون في الجميل ولا تُس","حبُ في الخير منهمُ أذيالُ",123,"ل",1,0],["لا يَخطُرُ البانُ ما تَخ","طُرُ الهُوَينا بِبالِ",124,"ل",1,0]]}