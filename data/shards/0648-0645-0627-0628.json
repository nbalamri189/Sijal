انُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[53,"سئمت الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=11431",""],[50,"ألا يا خاتم الملك ال","https://www.poetsgate.com/ViewPoem.aspx?id=19974",""],[50,"نبا بك خلف الظاعنين وساد","https://www.poetsgate.com/ViewPoem.aspx?id=22565",""],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[90,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"بين قطرين","https://www.poetsgate.com/ViewPoem.aspx?id=179019",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"إذا عَرَضَتْ أحْدَاجُ سلمى، فنادِها","https://www.poetsgate.com/ViewPoem.aspx?id=31564",""],[45,"عَذيركَ مِنْ نَأيٍ غَدَا، وَبُعَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=32880",""],[45,"سُقيتِ الغَوادِي من طُلُولٍ وأرْبُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=31223",""],[47,"أَسَيْفُ الهُدَى ، وَقَرِيعَ العَرَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14643",""],[28,"لقد هتك العبد الطرماح ستره","https://www.poetsgate.com/ViewPoem.aspx?id=21521",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[51,"أسومُكَ ما يسومُ العبدُ مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=30081",""],[51,"عزمتُ على تطليقِ عرسي لعُسرتي","https://www.poetsgate.com/ViewPoem.aspx?id=30691",""],[51,"أمامك فانظر أيَّ نهجيك تَنْهُج","https://www.poetsgate.com/ViewPoem.aspx?id=27417",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[20,"وما بدأت خيلا لي اخا ثقة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502583",""],[29,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[85,"تفدِّيك يا مَكسُ الجيادُ الصَّلادِمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9741&r=&rc=231",""]],"verses":[["وَما بَينَنا يَومَ الجَزاءِ تَفاوُتٌ","سِوى أَنَّهُ خاضَ الطَريقَ أَمامي",0,"ي",1,0],["وَما بِهِم إِلى النَدى","لا ظَمَأٌ وَلا قَرَم",1,"م",1,0],["وَما بَرِحَت في كُلِّ عَصرٍ سُيوفُهُ","مَواضِعَ تيجانِ الرِجالِ البَطارِقِ",2,"ق",1,0],["وَما بِالصَفا مِن حالِقٍ وَمُقَصِّرٍ","وَمِن ماسِحٍ رُكنَ العَتيقِ وَطائِفِ",3,"ف",1,0],["وَما بُعدَ ما بَيني وَبَينَكَ سامِعاً","وَأَنتَ بِمَرأىً مِن مُقامي وَمَسمَعِ",4,"ع",1,0],["وَما بُكائي عَلى إِلفٍ فُجِعتُ بِهِ","إِلّا لِكُلِّ فَتىً كَالصارِمِ الذَكَرِ",5,"ر",1,0],["وَما بَرِحَت تَبكي قَتيلاً عُيونُها","فَلا دَمعُها يَرقا وَلا عَبَراتُها",6,"ت",3,0],["وَما بَقِيَ الجَبَلُ المُشمَخِرُّ","فَما ضَرَّنا الجَبَلُ الواجِبُ",7,"ب",1,0],["وَما بَلَغَ المَرمى البَعيدَ سِوى اِمرىءٍ","يَروحُ وَيَغدو عِرضَةً لِلجَواذِبِ",8,"ب",1,0],["وَما بَعدَ ذا مِن آصِراتٍ إِذا اِنتَهَت","يَكونُ إِلى آلِ النَبيِّ اِنتِسابُها",9,"ب",3,0],["وَما بَينَ خَيلي وَالمَطالِبِ حاجِزٌ","وَلا دونَ عَزمي لِلظَلامِ حِجابُ",10,"ب",1,0],["وَما بَعَثَ الزَمانُ عَلَيكَ إِلّا","وُفورُ العِرضِ وَالنَفسُ العِصاءُ",11,"ا",2,0],["وَما بَرِحَتْ عَيني تَفيضُ شُؤونُها","وَيرزِمُ نِضوي وَالحَمائِمُ تَهتِفُ",12,"ف",1,0],["وما بيَ الرّبْعُ لكنْ مَنْ يَحِلُّ بهِ","وإنّما لسُلَيْمى يُكْرَمُ السَّلَمُ",13,"م",1,0],["وما بيَ عنْ غايَةٍ نَبْوَةٌ","وإنْ خَذَلَتْ رُمْحيَ الأكْعُبُ",14,"ب",1,0],["وما بَلَغَتْ إلا بِنا العَرَبُ العُلا","وقد كانَ منّا عِزُّها وثَراؤُها",15,"ا",3,0],["وما بي نَوالٌ أرْتَجيه فَطالما","نَقَعْتُ الصّدى والماءُ مُقْتَسَمٌ ثَمْدُ",16,"د",1,0],["وَما بَينَنا مِن ريبَةٍ فَيُراقِبا","وَلا مِثلُها يُرمى بِسَوءٍ وَلا مِثلي",17,"ي",1,0],["وَما بي دَمي بَل لي إِذا مُتُّ راحَةٌ","وَلَكِن لِكَيما تَسلَمي فَاِسمَعي هَتفي",18,"ي",1,0],["وما بيَ إلا أنْ سَرى الرّكْبُ مَوْهِنا","وأعْمَلَ في رَمْلِ الحِمى النصَّ والوَخْدا",19,"د",2,0],["وما بُليَتْ نفْسُ امْرئٍ متطرِّفٍ","بأوْحَشَ منْ عَبْدٍ عَبوسٍ مُقَيَّدِ",20,"د",1,0],["وما بَرِحَتْ واللهُ ناصِرُ دينِهِ","قضاياهُ في عَكْسٍ لدَيْكَ وفي طَرْدِ",21,"د",1,0],["وما بالُ هذا العِيسِ لا تَسْأمُ السُّرَى","كَما جُهِّزَتْ عنْدَ المَغارِ جُنودُهُ",22,"د",2,0],["وَمَا بِغَرِيبَةٍ نُوَبُ اللَّيَالِي","وَلَكِنَّ النَّجَاةَ هِيَ الْغَرِيبَهْ",23,"ب",2,0],["وما بِي إلاّ نَفْحَةٌ حاجِريّةٌ","سرَتْ والدُجَى ما بيْنَ وهْنٍ وتَغْليسِ",24,"س",1,0],["وَما بِها أَن لا تَكو","نَ مِنَ الثَوابِ عَلى يَسارَه",25,"ر",2,0],["وَما بِالَّذي أَبصَرَتهُ العُيو","نُ مِن قَطعِ يَأسٍ وَلا مِن يَقَن",26,"ن",1,0],["وَما بالُ قَومِيَ لا يَنزِلونَ","بِغَيرِ جُرُبّي وَبارِ اللِوا",27,"ا",1,0],["وَما بَرِحَ الإِحسانُ مِنّا سَجِيَّةً","تَوارَثَها عَن صيدِ آبائِنا الأَبنا",28,"ن",2,0],["وَما بغيَتي إِلّا بَقاؤُكَ سالِماً","لِذا الدينِ لا مالٌ جَزيلٌ أُثابُهُ",29,"ب",2,0],["وَما بِاِختِيارٍ تَسَلَّيتُ عَنكِ","وَلَكِنَّني مُكرَهٌ لا بَطَل",30,"ل",1,0],["وَما بِكَ مِن فَقرٍ إِلى نَصرِ ناصِرٍ","كَفَتكَ مِنَ اللَهِ الكَلاءَةُ وَالنَصرُ",31,"ر",1,0],["وَما بَلَّتِ البُردَ تِلكَ الدُمو","عُ إِلّا وَفي البُردِ لَيثٌ أَبَلّ",32,"ل",1,0],["وَمَا بَرِحْتَ وًَفِيّاً","لِكُلِّ خِلٍ مُخَالِمْ",33,"م",1,0],["وَمَا بَرِحْتَ مُعِيناً","أَخَاكَ وَالْوَقْتُ عَارِمْ",33,"م",1,0],["وما بيننا حيٌّ وما بين آدم","ألا هكذا سوِّى البريَّة باريها",34,"ي",3,0],["وما بال عينيك اللتين أراهما","تُديران لحظاً يحمل الحزن وانيا",35,"ي",2,0],["وَما باتَ النَوائِحُ مِن قُرَيشٍ","يُراوِحنَ التَفَجُّعَ بِاِنتِحابِ",36,"ب",1,0],["وَما بالَيتِ يَومَ رَأَيتِ دَمعي","لَهُ سَبَلٌ يَفيضُ عَلى نِجادي",37,"ي",1,0],["وَما بِكُمُ صَبرٌ عَلى مَشرَفِيَّةٍ","تَعَضُّ فِراخَ الهامِ أَو تَسطِيُرها",38,"ر",3,0],["وَما بِالمَيسِ يَرحَلُ وَفدُ تَيمٍ","وَلَكِن بِالسَوِيَّةِ وَالحِصارِ",39,"ر",1,0],["وَما باتَ قَومٌ ضامِنينَ لَنا دَماً","فَتوفِيَنا إِلّا دِماءٌ شَوافِعُ",40,"ع",1,0],["وَما بِكَ رَدٌّ لِلأَوابِدِ بَعدَما","سَبَقنَ كَسَبقِ السَيفِ ما قالَ عاذِلُه",41,"ل",2,0],["وما بجنبيَّ من صفح وعائدة","عن الأسِدّة أن العِي كالعَضَبِ",42,"ب",1,1],["وَما بالُ كُتبِكَ قَد أَصبَحَت","تَنَكَّبُني مَعَ هَذا النَكَب",43,"ب",1,0],["وَما بَلَغَت مِن كُلِّ أَمرٍ عَشيرَهُ","وَلَكِن لِنَفسي بَعدُ ما قَد تَوَجَّدُ",44,"د",1,0],["وما بكيت لكوني فيك ذا تلفٍ","إلاَّ لكون سعير القلب مأواك",45,"ك",1,0],["ومآبُ الهموم بالليل صدري","بل فؤادي بل مهجتي أوْ تؤُوبُ",46,"ب",1,0],["وما بكُم أن تنصروا أولياءَكم","ولكنْ هَناتٌ في القلوب تَنجنَجُ",47,"ج",1,0],["وما بغيتم ولكن كنتمُ فئةً","سقيتمُ من بَغى الكأس التي جَدَحا",48,"ح",2,0],["وما بِئْسَ عوْن المرْءِ كان ابنُ مَخْلدٍ","نَصِيحُكَ والأعْدَاءُ نَحْوَكَ صُمَّدُ",49,"د",1,0],["وما بي غنىً عما لديك ولو غدتْ","مفاتيحُ ما مُلِّكتُ عبءَ بعير",50,"ر",1,0],["وما بيَ إِلا أنْ يراها مُمَيِّزٌ","فَيَتْبَعها من رأيه نظر شزر",51,"ر",1,0],["وما بيَ من وَهْنٍ فأرضى بمُسخطٍ","ولا البغيُ من شأني فأسخط ما يُرضي",52,"ي",1,0],["وما بكت عيناه من حسرة","ولا شكا بين الحشا لذعه",53,"ع",2,0],["وما بات عانيكم كانعاً","ولا هَمُّ جارِكمُ مكتنِع",54,"ع",1,0],["وما برحت في كل حالٍ تسوسها","له شيمٌ زهر المحاسن روعها",55,"ع",3,0],["وما بي في احتمائك من سقامٍ","ولكنّ المُصحِّح يحتميكا",56,"ك",2,0],["وما بي رغبةٌ عن عبدِ عبدٍ","لديكَ وإن جعلتَ أذاي شُغلك",57,"ك",1,0],["وما برحتْ نفسي تنقّي ثمارَها","وتعطيكُها إعطاءَ غيرِ بخيل",58,"ل",1,0],["وما بيَ قصْبُ البحتري وثلبُهُ","وإن صال فحلٌ ذاتَ يومٍ على فحلِ",59,"ل",1,0],["وما بي سخائي عنك لكن تتبُّعي","رضاك وهل يسخو بمثلك أمثالي",60,"ل",2,0],["وما بي أن أنافسه نفيساً","وكيف يُنافَسُ الحرُّ البذولُ",61,"ل",1,0],["وما بي سلوةٌ فأقول سيروا","فإن الريحَ طيبةٌ قبولُ",61,"ل",1,0],["وما بي نيلُ ما استوهبتُ لكن","تُحَبُّ لحُبّ ساكنها الطُّلولُ",61,"ل",1,0],["وما بطَّأَتْ بي عنك نفسٌ مُمَثَّلٌ","لها فيك ظنّ بالمغيبِ مرجَّمُ",62,"م",1,0],["وما بعد تحريمين في الكأس مشربٌ","لمن كان من أهل الحِجا متوسِّما",63,"م",2,0],["وما بيَ قُرباكِ القريبةُ إنه","بعيدٌ من الأحياءِ مَنْ سَكَنَ الرَّجمْ",64,"م",1,0],["وما بيَ زُهدٌ في التفضُّلِ إنّه","لفضلٌ ولكن للرجال شكائمُ",65,"م",1,0],["وما بيَ ضنَّتْ إذ عزمتُ فراقها","ولكن بحظي من ولائكَ ضَنَّتِ",66,"ت",1,0],["وَما بِزَمزَمَ مِن شُمطٍ مُحَلِّقَةٍ","وَما بِيَثرِبَ مِن عونٍ وَأَبكارِ",67,"ر",1,0],["وَما بَلَغَت خَيلُ اِمرِئٍ كانَ قَبلَهُ","بِحَيثُ اِنتَهَت آثارُهُ وَمَحارِبُه",68,"ب",2,0],["وَما بِها غَيرُ أَدماثٍ وَأَبنِيَةٍ","وَخالِداتٍ بِها ضَبحٌ مِنَ النارِ",69,"ر",1,0],["وَما بِتُّ إِلّا واثِقاً إِن مَدَحتُهُ","بِدَولَةِ خَيرٍ مِن نَداهُ يُديلُها",70,"ل",3,0],["وَما بَنى قَصرَهُ إِلّا لِيُحجَبَ عَن","أَبصارُنا في زَواياهُ خَطاياهُ",71,"ا",2,0],["وَما بَرِحَت مِصرٌ إِلَيكَ مَشوقَةٌ","وَمِثلُكَ مَن يَشتاقُ لُقياهُ بُلدانِ",72,"ن",1,0],["وَما بي بِحَمدِ اللَهِ في الحُبِّ ريبَةٌ","فَيَعتِبَ فيها صاحِبٌ وَحَميمُ",73,"م",1,0],["وَما بَلَغَ العُشّاقُ حالاً بَلَغتُها","هُناكَ مُقامٌ ما إِلَيهِ سَبيلُ",74,"ل",1,0],["وَما بَرِحتُ بِسُتو","رِ فَضلِكُم تَعَلُّقي",75,"ي",1,0],["وَما بَرِحَت تَبكي وَأَبكي صَبابَةً","إِلى أَن تَرَكنا الأَرضَ ذاتَ نَقائِعِ",76,"ع",1,0],["وَما بَرِحَ الواشي لَنا مُتَجَنَّباً","فَلَمّا رَأى الإِعراضَ مِنكَ تَعَرَّضا",77,"ض",2,0],["وَما بالُ كُتبي لا يُرَدُّ جَوابُها","فَهَل أُكرِمَت أَن لا تُقابَلَ بِالرَدِّ",78,"د",1,0],["وَما بَيضَةٌ باتَ الظَليمُ يَحُفُّها","بِوَعساءَ أَعلى تُربِها قَد تَلَبَّدا",79,"د",2,0],["وَما بَكَتِ النِساءُ عَلى قَتيلٍ","بِأَشرَفَ مِن قَتيلِ الغانِياتِ",80,"ت",1,1],["وما بكل بلاد العرب من جذل","ولا بكل بلاد العرب مسعود",81,"د",1,0],["وما بمطفئ اوا","ر حقده الا الدم",82,"م",1,0],["وما بالذي قد دان باللَه من عمى","ولكنما حب السلامة يعميه",83,"ه",1,1],["وما بيننا غير هذا الفناء","وهذا الجدار وهذا الحريم",84,"م",1,0],["وما بيننا غير هذا الفناء","وهذا الجدار وهذى الحريم",85,"م",1,0],["وما بين حام يهاب الجار ساحته","وناشئ يزدهيه الطوق والزغب",86,"ب",1,0],["وَما بِكَ مِمّا تُبصِرُ العَينُ شُبهَةٌ","وَلَكِن مَشيبٌ عَجَّلَتهُ العَظائِمُ",87,"م",1,0],["وَما باطِلاً يَنزِلُ النازِلون","وَلا عَبَثاً يُزمِعونَ السَفَر",88,"ر",1,0],["وَما بَلاءُ أَبي بَكرٍ بِمُتَّهَمٍ","بَعدَ الجَلائِلِ في الأَفعالِ وَالخِدَمِ",89,"م",1,0],["وَما بَيني وَبَينَهُما حِجابُ","وَلا دوني عَلى الآياتِ سِترُ",90,"ر",1,0],["وَما بالُ الطَعامِ يَكادُ يَقدى","كَما تَرَكَتهُ أَيدي الصانِعينا",91,"ن",2,0],["وَما بِكَ غَيرُ حُبِّكَ أَن تَراها","وَعِثيَرُها لِأَرجُلِها جَنيبُ",92,"ب",1,0],["وَما بَلَدُ الإِنسانِ غَيرُ المُوافِقِ","وَلا أَهلُهُ الأَدنَونَ غَيرُ الأَصادِقِ",93,"ق",1,0],["وَما بَينَ كاذَتَي المُستَغيرِ","كَما بَينَ كاذَتي البائِلِ",94,"ل",1,0],["وَما بَلَغَت مَشيئتَها اللَيالي","وَلا سارَت وَفي يَدِها زِمامي",95,"ي",1,0],["وما بينَ أثناءِ الكلامِ تَغَازُلٌ","عِتَابٌ وعَتْبٌ كاذِبٌ ووعُودُ",96,"د",1,0],["وما بُحْتُ بالسِّرِ الذي كان بيننا","ولكنما لحظُ المُحِبِّ مُريبُ",97,"ب",1,0],["وَمابَرِحَ الأَعداءُ حَتّى بَدَهتَهُم","بِظَلماءِ زَحفٍ بِيضُها تَتَلَهَّبُ",98,"ب",1,0],["وَما بَرِحَت صُروفُ الدَهرِ حَتّى","أَرَتنا الأُسدَ قَتلى لِلقُرودِ",99,"د",1,0],["وَما بَلَغَ النَومُ المُسامِحُ لَذَّةً","سِوى أَرَقي في حُبِّها وَسُهادي",100,"د",2,0],["وَما بِعُيونِ القَومِ عَن ذاكَ مِن عَماً","وَلَكِن زُروعٌ أَينَعَت لِحَصادِها",101,"د",3,0],["وَما بَعَثتَ عِتاقَ الخَيلِ في سَفَرٍ","إِلّا تَعَرَّفتَ فيهِ اليُمنَ وَالرَشَدا",102,"د",2,0],["وَما بَلَغَت آمالُنا بِكَ غايَةً","نَراها رِضىً في قَدرِكَ المُتَجَدِّدِ",103,"د",1,0],["وَمابَرَحَت ظُنونُكِ فِيَّ حَتّى","تَناوَلَني عِقابُكِ مِن جَديدِ",104,"د",1,0],["وَما بالَهُ يَأبى دُخولي وَقَد رَأى","خُروجِيَ مِن أَبوابِهِ وَيَدي صِفرُ",105,"ر",1,0],["وَمابَرِحَت تُدني نَجاحاً لِآمِلٍ","مُرَجٍّ وَتَستَدعي رَجاءً لِآيِسِ",106,"س",1,0],["وَما بَرَحَت حَطّى مَضى اللَيلُ فَانقَضى","وَأَعجَلَها داعي الصَباحِ المُلَمَّعِ",107,"ع",1,0],["وَما بَرِحَ التَفريطُ حَتّى أَصارَهُم","إِلى خُطَّةٍ فيها الخَزِيَّةُ وَالخَسفُ",108,"ف",1,0],["وَما بِغُلامِنا تَفديكَ نَفسي","نُبُوٌّ عَنكَ إِن حاوَلتَ نَيكا",109,"ك",2,0],["وَما باعَدَ النَأيُ المَسافَةَ بَينَنا","فَيُفرِطَ شَوقٌ في الجَوانِحِ أَو يَغلو",110,"ل",2,0],["وَما بِصَوابٍ أَن يُؤَخَّرَ حَظُّها","وَقَد سَبَقَت أَوضاحُها وَحُجولُها",111,"ل",3,0],["وَما بَينَنا مِن ريبَةٍ في مَوَدَّةِ","وَلا مِثلُها يُرمى بِسوءٍ وَلا مِثلي",112,"ي",1,0],["وَما باتَ مَطوِيّاً عَلى أَريَحِيَّةٍ","بِعَقبِ النَوى إِلّا امرُؤٌ باتَ مُغرَما",113,"م",2,0],["وَما بَرِأَت طائِيَّةٌ مِن خِتانِها","وَلا وُجِدَت في مَسجِدِ الدينِ صَلَّتِ",114,"ت",1,0],["وَما باتَ مِن قَومٍ يُصَلّونَ قِبلَةً","وَلا غَيرُهُم إِلّا قُرَيشٌ تَقودُها",115,"د",3,0],["وَما بِجودِ أَبي الأَشبالِ مِن شَبَهٍ","إِلّا السَحابُ وَإِلّا البَحرُ إِذ زَخَرا",116,"ر",2,0],["وَما بَيَّنَ الأَيّامَ إِلّا اِبنُ لَيلَةٍ","رُكوباً لَها وَالدَهرُ جَمُّ التَلاتِلِ",117,"ل",1,0],["وَما باتَ جارٌ عِندَ مَروانَ خائِفاً","وَلَو كانَ مِمَّن يَتَّقي كانَ أَظلَما",118,"م",2,0],["وَما بَينَ أَيدي آلِ مَروانَ بِالقَنا","وَبَينَ المَوالي ناكِثاً مِن تَزاحُمِ",119,"م",1,0],["وَما بِها بَعدَ آثارِ الحَلالِ بِها","غَيرُ الرَمادِ وَغَيرُ المُثَّلِ الجونِ",120,"ن",1,0],["وما بالُ أعناقِ الكؤوسِ عَواطِلاً","وكانَتْ به في مثلِ حَلْيِ العَرائسِ",121,"س",1,0],["وما بالُ حاناتِ العِراقِ تنكَّرَتْ","فأصبحَ منها مُوحِشاً كلُّ آنسِ",121,"س",1,0],["وَما بَقاءُ آخِرٍ","قَد غابَ عَنهُ أَوَّلُه",122,"ل",2,0],["وَما بارَكَ في فَضلٍ بِهَطلٍ","وَلَكِن زادَنا فيكَ اِعتِقادا",123,"د",2,0],["وَما بَينَنا سِترٌ يُراعى سِوى التُقى","وَلا دونَنا إِلّا العَفافُ حِجابُ",124,"ب",1,0],["وَما بِعتُكُم روحي بِأَيسَرِ وَصلِكُم","وَبي مِن غِنىً عَن قَبضِ ما لِيَ مِن حَقِّ",125,"ق",1,1],["وَما بالُها لَم يُروَ مِن مائِها الصَدى","لِظامٍ وَلا يوري لِقاصِدِها زَندُ",126,"د",1,0],["وَما بالُهُم عَدّوا ذُنوبي كَثيرَةً","وَما لِيَ ذَنبٌ غَيرَ نَصرِ أَقارِبي",127,"ب",2,0],["وما بعجيب موطن البدر في العلى","وما بجديد أن يرى الأفق مسكنا",128,"ن",2,0],["وما بدا ليَ جُودٍ أمَرْتَ به","عينٌ تفوز به عيني ولا أَثَرُ",129,"ر",1,0],["وَما بِالوِلايَةِ إِقرارُهُم","وَلَكِن أَقَرّوا لَهُ بِالوَلاءِ",130,"ا",2,0],["وَما بَرِحَت صُوَراً إِلَيكَ نَوازِعاً","أَعِنَّتُها مُذ راسَلَتكَ الرَسائِلُ",131,"ل",1,0],["وَما بِكَ إِركابي مِنَ الرُشدِ مَركَباً","أَلا إِنَّما حاوَلتَ رُشدَ الرَكائِبِ",132,"ب",1,0],["وَمَا بَيْنَ سَلِّ السَّيْفِ وَالْمَوْتِ فُرْجَةٌ","لَدَى الْحَرْبِ إِلَّا رَيْثَمَا أَتَكَلَّمُ",133,"م",1,0],["وما بُنيَتْ بينَ الفراتِ وجلِّقٍ","سدى إنما هذا لسرٍّ قد اقتضى",134,"ض",2,0],["وما بقيتْ واللهِ تخشى مذلةٌ","وأوقافُ نورِ الدينِ مِنْ خلفها ظهرُ",135,"ر",1,0],["وما برحَتْ إلى الشهباءِ منا","سراةُ بني أبي بكرٍ تسامى",136,"م",2,0],["وَما بِيَ إِلّا حُبُّ لَيلى كِفايَةٌ","جُنوناً وَإِنّي في الغَرامِ أَسيرُ",137,"ر",1,0],["وَما بالُهُ يَبكي فَقالَت لِما بِهِ","أَلا إِنَّما أَبكي لَها لا لِما بِيا",138,"ي",2,0],["وَما بِيَ إِشراكٌ وَلَكِنَّ حُبَّها","كَعودِ الشَجى أَعيا الطَبيبَ المُداوِيا",139,"ي",2,0],["وَما بِتُّ إِلّا خاصَمَ البَينَ حُبُّها","مَكينانِ مِن قَلبِ مُطيعٍ وَسامِعِ",140,"ع",1,1],["وَما بَرِحَ الواشونَ حَتّى بَدَت لَنا","بُطونُ الهَوى مَقلوبَةً لِظُهورِ",141,"ر",1,0],["وَما بِيَ إِلّا حُبُّ لَيلى كِفايَةً","جُنوناً وَإِنّي في الهَوى لَأَسيرُ",142,"ر",1,1],["وَما بالُ لَيلى لَيسَ تَخلُصُ مِن دَمي","وَتَعلَمُ أَنَّ النارَ حامٍ وَقودُها",143,"ه",2,0],["وَما بالُ الَّذينَ سَبوا فُؤادي","أَقاموا أَم أَجَدَّ بِهِم رَواحُ",144,"ح",1,0],["وَما بالُ النُجومِ مُعَلَّقاتٌ","بِقَلبِ الصَبِّ لَيسَ لَها بَراحُ",144,"ح",1,0],["وَما بَوسِ التُرابِ لِحُبِّ أَرضِ","وَلَكِن حُبُّ مَن وَطِئَ التُرابَ",145,"ب",1,0],["وما بِرسولِ اللهِ إذ ناله الأَذَى","سِوَى ما ارْتَضَتْ أخلاقُه وشمائلُهْ",146,"ل",2,0],["وما بَعْضُ الحُماةِ وإن تَغالىَ","بِثَبْتٍ في الخطوب ولا صَليبِ",147,"ب",1,0],["وما بالسمهريِّ يغيبُ عيبٌ","إذا سكنَ الجوانحَ والكُبودا",148,"د",2,0],["وما بجنودِ قسطنطينَ نُكرٌ","إذا كرَّ الغُزاةُ مُكبِّرينا",149,"ن",2,0],["وما بَلغَ الجَلالُ وإن تناهى","جَلالكَ في الهُداةِ الطالعينا",149,"ن",2,0],["وما ببني عُثمانَ في الحربِ رِيبَةٌ","إذا ابتدرَ السَّيفَ الكميُّ المُقارعُ",150,"ع",1,0],["وَما بَرَحَ الغُزاةُ ذَوي فِرارٍ","إِذا كَرِهَت نُفوسُهُم المَنونا",151,"ن",2,0],["وَما بي غَيرُ جَهلِكَ مِن خَفاءٍ","وَما بِكَ غَيرُ عِلمي مِن ضَلالِ",152,"ل",1,0],["وَما بِيَدي أُجري يَراعي وَإِنَّما","يَدُ اللَهِ تُجريهِ فَيَمضي مُقَوَّما",153,"م",2,0],["وَما بَينَ الرِضى وَالسُخطِ إِلّا","تَأَمُّلُ ناظِرٍ فيما بَدا لي",154,"ي",1,0],["وما بِكَ في حاتمٍ رِيبةٌ","بلى إنّه للجوادُ العَلَمْ",155,"م",1,0],["وما بَرحتْ عَوادي الدهرِ تَجرِي","على أهلِ المآثمِ والشُّرورِ",156,"ر",1,0],["وما بِمُحمّدٍ خَوفُ المنايا","ولا في سيفِه خُلُقٌ يُعاب",157,"ب",1,0],["وما بَرَحَ الحَبْرُ السَّمينُ يَغرُّهم","ويأكلُ من أموالِهم ما يُصادِفُ",158,"ف",1,0],["وَما بَعُدَت شَمسُ الضُحى في مَحَلِّها","وَقَد أَلحَفَتكُم نورَها مُتَوَقِّدا",159,"د",2,0],["وَما بِاِختِياري فارَقَ الحُبَّ صَبرُهُ","وَلَكِن فِراقَ السَيفِ كَفَّ شَبيبِ",160,"ب",1,0],["وما بالُها لم تحمل الوجْدَ والهوى","لغيري لهُ روحي ولمْ يعدُهُ جسمي",161,"ي",1,0],["وَما بَلَغَ المُثنونَ في الخَيرِ مِدحَةً","وَلو صَدَقوا إِلا الَذي فيكَ أَفضَلُ",162,"ل",1,0],["وَما بي مِن شَكوىً لِنَفسي مِنهُمُ","وَلا جَزَعٍ إِنّي إِذاً لَجَزوعُ",163,"ع",1,0],["وَما بُحتُ إِلّا أَن نَسِيتُ وَإِنَّما","بِهِ كُلُّ مَن يَهوى هَوىً يَتَمَثَّلُ",164,"ل",1,0],["وَما باؤوا كَما باؤوا عَلَينا","بِفَضلِ دِمائِهِم حَتّى أَراحوا",165,"ح",3,0],["وَما بِها صَبوَةٌ وَلا حَزنٌ","تَضحَكُ مِنها لِدَمعِها الأُخرى",166,"ر",2,0],["وَما بُغيَتي في مِنَّةٍ لي أَنالُها","وَأَبلُغُها إِلّا نَظَرتُ إِلى أُخرى",167,"ا",1,0],["وما بعدت غايات طاغٍ مصارم","إذا امتُطِيت يوما إليه الصَّوارمُ",168,"م",1,0],["وما بلغَ الإسكندرُ الرتبَةَ التي","بلغْتَ ولا كِسرَى الملوكِ وتُبّع",169,"ع",1,0],["وما بلغتْكَ البُردُ أنضاءَ نيّةٍ","ولكنّها أرماقُ ريحٍ تَفسَّخ",170,"خ",1,0],["وما بالُه قادَ هذا الرّعيلَ","وقُلّدَ ذا الصّارمَ المُنتَضَى",171,"ا",1,0],["وَمابالُ مَولاهِم لِسِرِّكَ مَوضِعاً","وَمابالَهُ أَمسى يُشارِكُ في الأَمرِ",172,"ر",1,0],["وَما بي وَالحَميدُ اللَهُ كَسرٌ","وَلَكِن فَقدُ حُملانِ الأَميرِ",173,"ر",1,0],["وَما باعَها إِلّا لِعُظمِ خَراجِهِ","لِأَنَّ الَّذي يَجبي الخَراجَ ظَلومُ",174,"م",1,0],["وَما بِها مِن هَشيمِ العُربِ عَرفَجَةٌ","وَلا بِها مِن غِذاءِ العُربِ خُطبانُ",175,"ن",1,0],["وَما بِكَ إِن لَم تُعطَ تِلكَ جَلادَةٌ","وَما مِنكَ إِن لَم تَلقَ تِلكَ رُقادُ",176,"د",1,0],["وَما باتَ شَجِيَّ القَل","بِ مُشتاقٌ كَما بِتُّه",177,"ت",2,0],["وَما بالُ قَلبي لا يَزولُ عَنِ الصِبى","وَقَد زَعَموا أَنَّ القُلوبَ تُقَلَّبُ",178,"ب",1,0],["وَما بِحِصنٍ نُعاسٌ إِذ تُؤَرِّقُهُ","أَصواتُ حَيٍّ عَلى الأَمرارِ مَحروبِ",179,"ب",1,0],["وَما بَعدَ مَرَ الخَمسَ عَشرَةَ مِن صِباً","وَلا بَعدَ مَرِّ الأَربَعينَ صَباءُ",180,"ب",3,0],["وَما بَرِحَت لي أَلوَّةٌ حَرَجِيَّةٌ","تُصَيِّرُ مِن رَطبِ العِضاهِ أَلُوَّتي",181,"ت",2,0],["وَما بَلَغوا أَن يَكونوا لَهُ","عَبيداً وَذَلِكَ أَقصى الأَمَد",182,"د",1,0],["وَما بَرِحَت في الصِدرِ لِلضَغنِ أَنؤُرٌ","عَجِبتُ لَها لَم تَشتَعِل في صِدارِهِ",183,"ر",2,0],["وَما بَرِحَ الإِنسانُ في البُؤسِ مُذ جَرَت","بِهِ الرَوحُ لا مُذ زالَ عَن رَأسِهِ الغِرسُ",184,"س",1,0],["وَما بَرِحَت أَجسادُها تَطلُبُ العُلا","مِنَ الدَهرِ حَتّى زايَلَتها رُؤوسُها",185,"س",3,0],["وَما بي طِرقٌ لِلمَسيرِ وَلا السُرى","لِأَنّي ضَريرٌ لا تُضيءُ لِيَ الطُرقُ",186,"ق",1,0],["وَما بَرَدَت أَعضاءُ مَيتٍ مُكَرَّمٍ","وَإِن عَزَّ حَتّى أُغلِيَ الماءُ لِلغَسلِ",187,"ل",1,0],["وَما بَيضُ أُنثى يَهزِمُ القَيضَ فَرخَهُ","كَبَيضِ ذُكورٍ بِالحَديدِ يُهَزَّمُ",188,"م",1,0],["وَما بَكَيتُ رَميماً وَهيَ نائِيَةٌ","وَإِن عَلِمتُ حِبالَ الوَصلِ أَرماما",189,"م",2,0],["وَما بَرِحا وَالصَمتُ مِن شيمَتَيهِما","يَقُصّانِ فينا عِبرَةً أَو يَخُطّانِ",190,"ن",1,0],["وَما بَرَّ مَن ساواهُما في قِياسِهِ","بِبِرَّي عُقوقٍ بَل هُما سَبُعانِ",191,"ن",1,0],["وَما بَرِحَ الوَجيفُ عَلى المَطايا","وَتِلكَ نُفوسُنا حَتّى بَراها",192,"ا",3,0],["وما بِعْتُ الهَوى بَيعاً بِشَرطٍ","وَلا اسْتَثْنَيْتُ فيهِ بِالخِيارِ",193,"ر",1,0],["وما بَقيِ تَصْحيفُ مقلوِبهِ","مُضَعَّفاً قَوْمٌ مِنَ المَغْرِبِ",194,"ب",1,0],["وَما بي عَلى عينيك خوف من العمى","إذا بكتا لكن دموعك تنفد",195,"د",1,0],["وما بعدَ هذا سوى عزلِهِ","إذا أمر تمَّ بدا نقصهُ",196,"ص",2,0],["وما بسمتي إلا دموعٌ من اللظى","قد التمعتْ في وجهِ سهمانَ حاسِرِ",197,"ر",1,0],["وما بُرْدَةٌ في طَيّها مِثْلُ مِبْرَدٍ","بعاجِزَةٍ عن ضَمّ شَخْصٍ وأوصال",198,"ل",1,0],["وما بَرِحَتْ في ساحة السّهْلِ يرْتمي","بها موْجُها حتى نهَتْها حُزُونها",199,"ن",3,0],["وما بنى الحق له الثبوت","وما بنى الباطل عنكبوت",200,"ت",1,0],["وَما بِيَ إِشراكٌ وَلَكِنَّ حُبَّها","وَعُظمَ الجَوى أَعيا الطَبيبَ المُداوِيا",201,"ي",2,0],["وَمَا بَدَأتُ خليلاً لِي أَخَا ثِقَةٍ","بِرِيبَةٍ لا وَرَبِّ الحِلِّ والَحرَمِ",202,"م",1,1],["وَمَا بِيَ مِنْ فَقْرٍ لِدُنْيَا وإِنَّمَا","طِلابُ الْعُلا مَجْدٌ وإِنْ كَانَ لِي مَجْدُ",203,"د",1,0],["وَمَا بِيَ ما أَخْشَاهُ مِنْ صَوْلَةِ الْعِدا","لَوَ انَّ الْهَوَى يُولِي يَداً أَوْ يُسامِحُ",204,"ح",1,0],["وَمَا بَالُكَ لاَ تُسْمِعْنَا","صَوْتِكَ مَا بالُكْ",205,"ك",1,0],["وَمَا بِيَ ظاهِرَةٌ لِلأَسى","سِوَى مَا ترَى الْعَيْنُ مِنْ سَاخِرِ",206,"ر",1,0],["وَمَا بَلَغ الغَايَاتِ وَهْيَ بَعِيدَةٌ","بِرَغْمِ العِدَى إِلاَّ الذِي هُوَ أَصْبَرُ",207,"ر",1,0],["وَمَا بِهِ يَغْصِبُ مِنْ دَهْرِهِ","مَضَنَّةً يَمْنَعُهَا الدَّهْرُ",208,"ر",1,0],["وَمَا بَدَتْ فِي النَّقْعِ أَسْيَافُهُ","إِلاَّ وَقدْ بَشَّ بِهَا ثَغرُ",208,"ر",1,0],["وَمَا بَقَائِي إلاَّ اغْتِرَابٌ","إِذَا ثَوَى رِفْقتِي جَمِيعَا",209,"ع",2,0],["وَمَا بَرَحَ الشَّعْرُ فِي كُلِّ عَصْرٍ","لَهُ كُوْكَبٌ يُجْتَلى فِي حَلَبْ",210,"ب",1,0],["ومَا بَنَوْهُ على الأَحقابِ منْ أُطُمٍ","لِغَيْرِ أَبْنائِهم قَدْ حَلَّ سُكْناها؟",211,"ا",3,0],["وما بكيت على لهوي ولا مرحي","لكن بكيت على طهري الذي انتحرا",212,"ر",2,0],["وما بلدٌ كدَانيةٍ ولكن","أُسَلِّي النَّفْسَ عنْهَا بالمُحَالِ",213,"ل",1,0],["وما برحَ الناسُ شَطرَيْن: منهم","ذئابٌ جياعٌ، ومنهم غَنَمْ",214,"م",1,0],["وما بالُها اليومَ عني تُشيحُ","وفي مقلتيها عتابٌ كمين؟",215,"ن",1,0],["وما بارح الأسماعَ وقعُ حديثه","فكيف به أمسى حديثًا مردَّدا؟",216,"د",2,0],["وما بالُهم لم يوحِ غي","رهمو بالاستبداد وَاح؟",217,"ح",1,0],["وما برحت شمَّاءَ، شامخةَ الذرا","فهل ثَمَّ أشياخي بها ولدَاتِيا؟",218,"ي",2,0],["وما بي لعمري من وقار؛ وإنما","هو العجز لولاه سَبَقت خياليا",218,"ي",2,0],["وما بال هذا العيس لا تسأم السرى","كما جهرت عند المغار جنوده",219,"د",2,0],["وما بليت نفس امرىء متطرق","بأوحش من عبد عبوس مقيد",220,"د",1,0],["وما باعها إلا لعظم خراجه","لأن الذي يجني الخراج ظلوم",221,"م",1,0],["وما بلغ المرمى البعيد سوى امرئ","يروح ويغدو عرضة للجواذبِ",222,"ب",1,0],["وَمَا بَاتَ شَجيَّ الْقَلْ","مشتاق كما بته",223,"ت",2,0],["وَمَا بِكَ إِنْ لمْ تُعْطَ تِلْكَ جَلاَدَة","ٌ وَمَا مِنْكَ إِنْ لَمْ تَلْق رُقَادُ",224,"د",1,0],["وما بلغتْ منْ كلّ أمرٍ عشيرهُ","ولكنّ نفسي بعضَ ما فيه تحمدُ",225,"د",1,0],["وما بدلت من زرقة البحر ألهَبَتْ","بحمرتها آذيَّهُ فتلهبا",226,"ب",2,0],["وما بينَ هذينِ يمشي الزمانُ","ويُفنى مُلوكاً ويستخلِف",227,"ف",1,0],["وما برِحت أيدي الخطوب تنوشُني","بفارسَ حتى بغَّضَ الحلَّ ترحال",228,"ل",1,0],["وما بالنفوسِ اللواتي ملكنَ","بأطماحهنَّ عَنانَ السّما",229,"ا",1,0],["وما برِحَ القمرُ المستديرُ","يَسبحُ في فلَكٍ مِن سنا",229,"ا",1,0],["وَما بعُيُونِ القَوْمِ عن ذاكَ منْ عَمًى،","ولَكِنْ زُرُوعٌ أيْنَعَتْ لحِصَادِها",230,"د",3,0],["وَمَا بَلَغَ النّوْمُ المُسَامِحُ لَذّةً،","سِوَى أرَقِي في جَبِهَا، وَسُهَادي",231,"د",2,0],["وَمَا بَرِحَتْ حتّى مَضَى اللّيلُ فانقَضَى،","وأعجَلَهَا داعي الصّباحِ المُلَمَّعِ",232,"ع",1,0],["وَمَا بَالُ كُتْبِكَ قد أصْبَحَتْ","تنكبني معَ هذي النكبْ",233,"ب",1,0],["وَمَا بَرِئَتْ طَائِيّةٌ مِنْ خِتانِها،","وَلا وُجدَتْ في مسجد الدّينِ صَلّتِ",234,"ت",1,0],["وما بكِ ترتابين؟ هل من غَضَاضةٍ","إذا كتبتْ أختُ الهوى للذي تَهْوَى؟",235,"و",2,0],["وما بي رغبة ٌ من عبدِ عبدٍ","لديكَ وإن جعلتَ أذاي شُغلك",236,"ك",1,0],["وما بيَ صنَّتْ إذ عزمتُ فراقها","ولكن بحظي من ولائكَ ضَنَّتِ",237,"ت",1,0],["وما بكُم أن تنصروا أوليائكم","ولكنْ هَناتٌ في القلوب تَنجنجُ",238,"ج",1,0],["وما بي فاعلموا من حبّ ظبيٍ","ولكنّي ذكرت بها سواها",239,"ا",3,0],["وَمَا بَدَأتُ خَيلاً لِي أَخَا ثِقَةٍ","بِرِيبَةٍ لا وَرَبِّ الحِلِّ والَحرَمِ",240,"م",1,1],["وما بلَغَتْ خَيْلُ امرىء ٍ كانَ قَبْلَهُ","بحيثُ انتهتْ آثارُهُ ومحاربهْ",241,"ب",2,0],["وما بكَ مما تُبصرُ العينُ شُهبة ٌ","ولكن مشيبٌ عجلته العظائم",242,"م",1,0]]}