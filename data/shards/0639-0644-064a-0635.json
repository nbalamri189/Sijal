{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[10,"يؤرقني التذكر حين أمسي","https://www.aldiwan.net/poem21102.html","الوافر"],[10,"أيا عيني ويحكما استهلا","https://www.aldiwan.net/poem21121.html","الوافر"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[37,"على صادرات أو قوارب آلفت","https://www.aldiwan.net/poem7600.html","الطويل"],[85,"سنون تعاد ودهر يعيد","https://www.aldiwan.net/poem63719.html","المتقارب"],[28,"وأفلت دجال النفاق وما نجا","https://www.aldiwan.net/poem5107.html","الطويل"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85286","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[96,"صدى الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66383&r=&rc=59",""],[116,"على صحبتي للكلب عوتبت مرة","https://www.aldiwan.net/poem41724.html","الطويل"],[143,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[224,"يا حب كلي شباب","https://www.aldiwan.net/poem41442.html","المجتث"],[232,"أبا صالح ما العيش بعدك صالح","https://www.aldiwan.net/poem44572.html","الطويل"],[271,"على صورتي قد لاح صدق ودادي","https://www.aldiwan.net/poem35187.html","الطويل"],[271,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[271,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[305,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[329,"الليل والسقم والقيود","https://www.aldiwan.net/poem54949.html","مخلع البسيط"],[349,"وما ضره شن صغير وقد سرى","https://www.aldiwan.net/poem20248.html","الطويل"],[354,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[442,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[459,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[459,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[516,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[559,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"],[564,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"]],"verses":[["عَلى صَهَواتِها أَبناءُ مَوتٍ","حَواسِرُ لِلرَدى وَمُقَنَّعينا",0,"ن",2,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","لِعانٍ عائِلٍ غَلَقٍ بِوَترِ",1,"ر",1,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","لِيَومِ كَريهَةٍ وَطِعانِ حِلسِ",2,"س",1,0],["عَلى صَخرَ الأَغَرَّ أَبي اليَتامى","وَيَحمِلُ كُلَّ مَعثَرَةٍ وَكَلّا",3,"ل",2,0],["عَلى صَخرِ بنِ عَمروٍ إِنَّ هَذا","وَإِن قَد قَلَّ بَحرُكَ وَاِضمَحَلّا",3,"ل",2,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","إِذا ما النابُ لَم تَرأَم طِلاها",4,"ا",3,0],["عَلَى صَخَبِ الرَّوَاعِدِ فِي حِمَاهُ","وَرَقْصِ المَوْتِ بَيْنَ طُلىً وَهَامِ",5,"م",1,0],["على صادرات أو قوارب آلفت","مراتعها بين الَّلصَاف فذي أرُل",6,"ل",1,1],["عَلى صَفحَتَيهِ حَديثُ القُرى","وَأَيّامُ عادٍ وَدُنيا ثَمود",7,"د",1,0],["عَلى صاعِدٍ أَو مِثلِهِ مِن رِباطِهِ","إِذا دارَكَ الرَكضَ المُغيرونَ صَدَّرا",8,"ر",2,0],["عَلى صُعَداءَ مِن زَفَراتِ شَوقٍ","تَرَفَّعَ عَروُها تَحتَ الشَغافِ",9,"ف",1,0],["عَلَى صفاتِكَ دَلَّتْنا نَجَابَتُهُ","وَبانَ مِنْ أَيْنَ ماءُ الوَرْدِ يُعْتَصَرُ",10,"ر",1,0],["عَلى صَفحَتَيهِ مِن مُتونِ جِلائِهِ","كَفى بِالَّذي أُبلي وَأَنعَتُ مُنصُلا",11,"ل",2,0],["عَلى صدرها نهدان قاما أَمامها","وَمن خلفها أَردافها تترجرج",12,"ج",1,0],["على صُحفٍ غُرِّ الحواشي كريمةٍ","جرى قلمٌ عفُّ السريرةِ واليدِ",13,"د",1,0],["على صحف غرّ الحواشي كريمة","جرى قلم عفّ السذريدة واليد",14,"د",1,0],["على صحبتي للكلب عوتبت مرة","وأثر ذاك العتب مني في القلب",15,"ب",1,1],["علىَّ صاروا عند نُصحى ولو","عملتُ بالغِشّ لكانوا معي",16,"ع",2,0],["عَلى صَعيدي جِنانٌ","وَفي سَمائي رَبابُ",17,"ب",1,0],["على صفحات المكرمات كآبة","لفقدك لما غيبتك الصفائح",18,"ح",1,0],["على صورتي قد لاحَ صدقُ ودادي","ورُوحي بها كالجمرِ تحتَ رمادِ",19,"د",1,1],["على صغَري في السنّ أَكبرتُ بلوتي","وقد أُغلقَت مني الحشى والمسامع",20,"ع",1,0],["على صدرِها أهوى البنفسجَ ذابلاً","كعينِ لألبابِ الرجالِ خلوب",21,"ب",1,0],["على صرفي الأنفاس في غير طائل","ولا نافع من فعل فضل وواجب",22,"ب",1,0],["على صحف مشحونة بآثام","وجرم وأوزار وكم من مثالب",22,"ب",1,0],["عَلى صَدره عنوانُ فضلٍ مرقّشٍ","بِسمرِ القَنا نقطاً وَبيضِ الظبى خطّا",23,"ط",2,0],["على صراط من المنايا","يشبّ من تحته الوقود",24,"د",1,0],["علَى صَهَواتِ الخَيْلِ مَرْبَاهُ مُذْنَشَا","إذا رَبَّ طِفلاً مَهدُهُ وَسَرِيرُهُ",25,"ه",1,0],["عَلى صَهوات الصافِنات تَخالهم","أُسوداً لَها فَوق الصُقور زَئيرُ",26,"ر",1,0],["على صهواتها أسد ترامت","بهم يوم الوغى تعطو القلالا",27,"ل",2,0],["على صدره حسَدٌ أن غَدَتْ","بأوجهكم تستنيرُ الصدورُ",28,"ر",1,0],["على صدره بالطُّول سبعٌ ضعائفٌ","تدبِّرها بالعَرضِ سَبعٌ شدائدُ",29,"د",1,0],["على صحف البيداء منها كتائب","سطور قناها في المصف كتابها",30,"ب",3,0],["على صورة الماء الحياة به بدت","وصورة علم بالهواء ترود",31,"د",1,0],["عَلى صورَةِ الإِنسانِ غَطَّيتَ صورَةَ ال","حِمارِ وَغَطَّتها الثِيابُ الفَضافِضُ",32,"ض",1,0]]}