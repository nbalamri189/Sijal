oetsgate.com/ViewPoem.aspx?id=199704",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[5711,"بمدرجِ الأقلاعِ مِنْ يأسِ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=24707",""],[5720,"نَفَحَات","https://www.poetsgate.com/ViewPoem.aspx?id=204565",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[5957,"الزمن الخرافي","https://www.poetsgate.com/ViewPoem.aspx?id=207667",""],[5961,"موائد إحسان","https://www.poetsgate.com/ViewPoem.aspx?id=199766",""],[5997,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=214219",""],[6056,"طري العود","https://www.poetsgate.com/ViewPoem.aspx?id=130346",""],[6056,"الجادل المختال","https://www.poetsgate.com/ViewPoem.aspx?id=130360",""],[6346,"بَريقٌ وشعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84885&r=&rc=10",""]],"verses":[["عَلى صَهَواتِها أَبناءُ مَوتٍ","حَواسِرُ لِلرَدى وَمُقَنَّعينا",0,"ن",2,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","لِعانٍ عائِلٍ غَلَقٍ بِوَترِ",1,"ر",1,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","لِيَومِ كَريهَةٍ وَطِعانِ حِلسِ",2,"س",1,0],["عَلى صَخرَ الأَغَرَّ أَبي اليَتامى","وَيَحمِلُ كُلَّ مَعثَرَةٍ وَكَلّا",3,"ل",2,0],["عَلى صَخرِ بنِ عَمروٍ إِنَّ هَذا","وَإِن قَد قَلَّ بَحرُكَ وَاِضمَحَلّا",3,"ل",2,0],["عَلى صَخرٍ وَأَيُّ فَتىً كَصَخرٍ","إِذا ما النابُ لَم تَرأَم طِلاها",4,"ا",3,0],["عَلَى صَخَبِ الرَّوَاعِدِ فِي حِمَاهُ","وَرَقْصِ المَوْتِ بَيْنَ طُلىً وَهَامِ",5,"م",1,0],["على صادرات أو قوارب آلفت","مراتعها بين الَّلصَاف فذي أرُل",6,"ل",1,1],["عَلى صَفحَتَيهِ حَديثُ القُرى","وَأَيّامُ عادٍ وَدُنيا ثَمود",7,"د",1,0],["عَلى صاعِدٍ أَو مِثلِهِ مِن رِباطِهِ","إِذا دارَكَ الرَكضَ المُغيرونَ صَدَّرا",8,"ر",2,0],["عَلى صُعَداءَ مِن زَفَراتِ شَوقٍ","تَرَفَّعَ عَروُها تَحتَ الشَغافِ",9,"ف",1,0],["عَلَى صفاتِكَ دَلَّتْنا نَجَابَتُهُ","وَبانَ مِنْ أَيْنَ ماءُ الوَرْدِ يُعْتَصَرُ",10,"ر",1,0],["عَلى صَفحَتَيهِ مِن مُتونِ جِلائِهِ","كَفى بِالَّذي أُبلي وَأَنعَتُ مُنصُلا",11,"ل",2,0],["عَلى صدرها نهدان قاما أَمامها","وَمن خلفها أَردافها تترجرج",12,"ج",1,0],["على صُحفٍ غُرِّ الحواشي كريمةٍ","جرى قلمٌ عفُّ السريرةِ واليدِ",13,"د",1,0],["على صحف غرّ الحواشي كريمة","جرى قلم عفّ السذريدة واليد",14,"د",1,0],["على صحبتي للكلب عوتبت مرة","وأثر ذاك العتب مني في القلب",15,"ب",1,1],["علىَّ صاروا عند نُصحى ولو","عملتُ بالغِشّ لكانوا معي",16,"ع",2,0],["عَلى صَعيدي جِنانٌ","وَفي سَمائي رَبابُ",17,"ب",1,0],["على صفحات المكرمات كآبة","لفقدك لما غيبتك الصفائح",18,"ح",1,0],["على صورتي قد لاحَ صدقُ ودادي","ورُوحي بها كالجمرِ تحتَ رمادِ",19,"د",1,1],["على صغَري في السنّ أَكبرتُ بلوتي","وقد أُغلقَت مني الحشى والمسامع",20,"ع",1,0],["على صدرِها أهوى البنفسجَ ذابلاً","كعينِ لألبابِ الرجالِ خلوب",21,"ب",1,0],["على صرفي الأنفاس في غير طائل","ولا نافع من فعل فضل وواجب",22,"ب",1,0],["على صحف مشحونة بآثام","وجرم وأوزار وكم من مثالب",22,"ب",1,0],["عَلى صَدره عنوانُ فضلٍ مرقّشٍ","بِسمرِ القَنا نقطاً وَبيضِ الظبى خطّا",23,"ط",2,0],["على صراط من المنايا","يشبّ من تحته الوقود",24,"د",1,0],["علَى صَهَواتِ الخَيْلِ مَرْبَاهُ مُذْنَشَا","إذا رَبَّ طِفلاً مَهدُهُ وَسَرِيرُهُ",25,"ه",1,0],["عَلى صَهوات الصافِنات تَخالهم","أُسوداً لَها فَوق الصُقور زَئيرُ",26,"ر",1,0],["على صهواتها أسد ترامت","بهم يوم الوغى تعطو القلالا",27,"ل",2,0],["على صدره حسَدٌ أن غَدَتْ","بأوجهكم تستنيرُ الصدورُ",28,"ر",1,0],["على صدره بالطُّول سبعٌ ضعائفٌ","تدبِّرها بالعَرضِ سَبعٌ شدائدُ",29,"د",1,0],["على صحف البيداء منها كتائب","سطور قناها في المصف كتابها",30,"ب",3,0],["على صورة الماء الحياة به بدت","وصورة علم بالهواء ترود",31,"د",1,0],["عَلى صورَةِ الإِنسانِ غَطَّيتَ صورَةَ ال","حِمارِ وَغَطَّتها الثِيابُ الفَضافِضُ",32,"ض",1,0],["على صديق ومولى لي فجعت به","ما أن له في جميع الصالحين لُمَهْ",33,"م",2,0],["على صِغَرٍ من سِنَّه وجِراحِهِ","يَسيل بِخَمريٍّ مِن الوَجدِ عانِد",34,"د",1,0],["عَلَيَّ صَنيعَةٌ لِنسيمِ نجدِ","بما أهواهُ مِن نَفَحاتِ نجدِ",35,"د",1,1],["على صورة الإنسان في عين فعله","تجلى له الإجلال من وجه جعله",36,"ه",1,0],["على صورة الرحمن جاء حكايةً","وعان معاناة المعاني عنايةً",36,"ه",1,0],["على صوامع دير القدس قدسها","حنان يحيى فأحيا لليلة الأحد",37,"د",1,0],["على صفحاتِ العمر خطت يدُ الدهر","عِظاتٍ لذي الذكرى تُسطرُ بالتبرِ",38,"ر",1,1],["على صُدْغِهِ الشِّعْرَى تَلُوْحُ وتَلْتَظِي","وفي نَحْرِهِ الجَوْزَاءُ تَزْهَى وتَزْدَانُ",39,"ن",1,0],["على صفحتي خديه للبشر لمعة","كلمعة سيف سل من خلل الغمدِ",40,"د",1,0],["عَلَى صُوىً مُسْتَرْعِفِ الشِمامِ","يَدُرْنَ غَرْقَى غَرَقَ الدُوامِ",41,"م",1,0],["على صافنات من جياد سوابق","قوادمها شهب لواحقها شقر",42,"ر",1,0],["عَلى صَدى أسودَ المُواري","في اللَّحدِ وَالتُّرابِ وَالصَّفيحِ",43,"ح",1,0],["عَلى صَلَوَيهِ مُرهَفاتٌ كَأَنَّها","قَوادِمُ نَسرٍ بُزَّ عَنهُنَّ مَنكِبُ",44,"ب",1,0],["عَلِيٌّ صَوتُهُ سَوطٌ","عَلَينا لا عَلى الفَرَسِ",45,"س",1,1],["على صفوة الله ربّ العبادِ","ورَبّ السماءِ وباري النسم",46,"م",1,0],["على صدر مذعان كأن جرانها","يمان نضا جفنين فهو دلوق",47,"ق",1,0],["على صحائف هذا الدهر كاتبة","ذكرا تفسره آياتها الغرر",48,"ر",1,0],["على صفحات مُقْمَرٍّ جبينٍ","وخدٍّ وَرْدُه من تحت آسِ",49,"س",1,0],["على صاحبٍ قَفَّى ولا جا عَنَه مردود","وانا من فراقه قمت أجاوب حمام الدوح",50,"ح",1,0],["على صفحتي صمصامة الموت راقم","حساب المنايا والكتاب المعجل",51,"ل",1,0],["على صَرماءَ فيها أصرَماها","وخَريتُ الفلاةِ به مليلُ",52,"ل",1,1],["على صهواتهن ذَوُو إباء","أباةٌ عن مماطلة الغريم",53,"م",1,0],["عَلى صُدْغِهِ بِالِمسْكِ مِنْهُ نَوَاضِخُ","وَفي خَدِّهِ بالمْسكِ مِنْهُ نَوَاسِخُ",54,"خ",1,1],["على صفح ومغفرةٍ","وإحسان ألاقيه",55,"ي",2,0],["على صداق دنانير وجملتُها","من المئين ثلاثُ صرفها عشرِ",56,"ر",1,0],["عَلى صَرْماء فيها أَصْرماها","وَخرّيتُ الفَلاةَ بِها قَليلُ",57,"ل",1,0],["عليٌّ صديقُ أبي كاسمه","عليٌّ بحلْيِ العلا متسمْ",58,"م",1,1],["على صخرةٍ قد جلسنَا هناك","ولمّا انحنَيتِ لصوتِ الخرير",59,"ر",1,0],["على صغَرِ السّنّ استقلَّ برُتبةٍ","تحمّلَ من أعْبائِها ما تحمَّلا",60,"ل",2,0],["على صدر الغبي نشا فأضحى","لقى والشمر يركب منه صدرا",61,"ر",2,0],["على صهواتها قلل تردت","عليها مفرغات الرد سبكا",62,"ك",2,0],["علَى صَلَوَيهِ مُرهَفاتٌ كأنَّها","قَوادِمُ دَلَّتها نُسورٌ نَواشِرُ",63,"ر",1,1],["على صهوات السابحات تخالها","إذا مرقت بين الصفوف الشواهينا",64,"ن",2,0],["عَلى صَفحاتِ الدَهرِ يَبقى مُخلَّد ال","ثَناءِ وَقَد ضَمَّ الأَنام صَفيحُ",65,"ح",1,0],["على صَدرِهِ عَرَقٌ يَرشَحُ","بِهِ كُلُّهُ جالِساً يَسبَحُ",66,"ح",1,0],["على صدرٍ ذاك الإلف ألقى أكفه","يحاكي إذا ما أحدق الأسد الوردا",67,"د",2,0],["عَلى صِغَرٍ حلاوة اصغريهِ","مغذّيهِ بِها ذاكَ الحَليبُ",68,"ب",1,0],["عَلى صَفَحاتِ الدَهرِ يَبقى ثَناؤُها","عَلَيكَ وَأَنتَ الكُفءُ يا اِبنَ الأَكارِم",69,"م",1,0],["عَلى صَفحاتِ النَهرِ مِنها بَواسِق","بِها الطَلعُ مَنضود وَما ثُمَّ حاسِر",70,"ر",1,0],["على صخرة الفتح ارتمى وهو خاشع","يخاطبها لو تستجيب صخورها",71,"ر",3,0],["عَلى صَحب أَجنُّ بِهِم","وَناد راق رَونَقه",72,"ه",1,1],["على صدر الغمار رمى سبوحاً","لدى خطواتها خجل الجوادُ",73,"د",1,0],["على صدر الحضيض جرت سواقٍ","من الأعيان فامتلأَت وهادُ",73,"د",1,0],["على صهواتها غرٌّ كرامٌ","مسامير الوغى سم العران",74,"ن",1,0],["على صدرك كتبتك في طرف شاطي بحر مهجور","أميز وسط موجه بين تفعيله وتفعيله",75,"ل",2,1],["على صوت موّالي تمخطر لي وقط الشال","ألا يا من حباك الله جمالٍ ما حبا مجمول",76,"ل",1,0],["على صدر الزمن بكتب شعوري موعد وعنوان","تعرف الشوق لو فتشت عن سر ابتساماتي",77,"ت",2,0],["على صَوتِهِ صامِتًا إِنْ حَكَى","على أَمنِهِ خائِفًا إِنْ صَرَخْ",78,"خ",1,0],["على صَدرِ مَن أَبكِي حَنِينِي وأَشتَكِي","ضَيَاعِي, وقَد صَارَت دُمُوعِي مَشَانِقَا؟!",79,"ق",2,0],["على صَدرِ مَن أَبكِي حَنِينِي وأَشتَكِي","ضَيَاعِي, وقَد صَارَت ضلوعي زوارقا؟!",80,"ق",2,0],["على صبر فرقاك ماعاد بي حيل","الله يبدِّلْ حالة الهجر بوصال",81,"ل",1,0],["على صدري خلعت بكل مطرزت(ن)وبالاكتاف","والبستوا على راسي عمامة صاحب اللمّه",82,"م",2,0],["على صدرك يابن سالف بسالف مامضى مريت","ثمود اشقى ثمود(ن) هاج اشقاها واشقاها",83,"ا",3,1],["على صَدفِ الشعرِ ثارَتْ خطَاكِ","لأنَّكِ تكتشفِينَ المَدَى",84,"د",2,0],["على صوت الربابه اللي شكت عيني لهاالمنوال","كتبت ابيات من شعري لجل تتنهد همومي",85,"م",2,1],["على صراط مستقيم لمن","صار من الأبرار فاسترشدا",86,"د",2,0],["علَى صَوتهِ تبدُو تجاعِيدُ نبرَةٍ","وقَدْ غُزِلَتْ يومًا حُدَاءً لِغُربةِ",87,"ه",1,0],["على صَدرِهَا عِقدٌ إذا اهْتَزَّ خِلتَهُ","شِرَاعَاً عَلَى الأَموَاجِ يَدفَعُهُ الغَمْرُ",88,"ر",1,0],["على صدور الخرد الحسانِ","مات المحب العاشق المعاني",89,"ن",2,1],["عَلَىْ صَهْوَةٍٍ مِنْ جِوَاْدٍ بَدَتْ","لَهُ مُغْرَمَاْتٍ سِيُوْفَاً فِدَاْ",90,"د",2,0],["على صَهوةٍ للموت أبْقتك جَامِحا","وها فُزْتَ خَسْراناً ومافُزت رابِحا",91,"ح",2,1],["على صفحات النور منك تحية","إذا نشرت والوعي ثم سطور",92,"ر",1,0],["على صوتي كتبت وفي المرايا","بخطٍ من ضياءٍ أنت عمري",93,"ر",2,0],["على \"صوبِ\" الرصافةِ حينَ سارتْ","يُهزُّ الكرخُ هزَّاً باليمينِ",94,"ن",1,0],["عَلَىٰ صَوْنِ حَقٍّ رَأَتْ أُمَّةٌ","وَفَاءَ الشَّهِيدِ بِهِ جُسِّدَا",95,"د",2,0],["على صخر أصم ذوي سواد","شديد حالك مثل الكحال",96,"ل",1,0],["على صهوات الخيل صالوا وللعدى","كواسر كالعقبان فوق المراقب",97,"ب",1,0],["على صدره حطّتْ فراشات وجدها","ومن كرمه صبّتْ غراما له صرْفا",98,"ف",2,0],["على صدرك التاريخ أطبقَ ثقله","كأنّ الجبال الراسياتِ تُحدّقُ",99,"ق",1,0],["على صدري البلاغة في اضطرامٍ","وجنّك بالهزيمة مبعدونا",100,"ن",2,0],["على صغر سنه ممّيل عقاله","كااااشخ وناسي لايصك الزراير",101,"ر",1,0],["على صفحاتِ الماءِ يَمتدُّ طيفُهُ","ويَروي ظِماءَ المستنيرينَ جُرفُهُ",102,"ف",2,0],["على صراط الهدى بالله سيرهمُ","بالعلم والحِلم والإصلاح في الذات",103,"ت",1,0],["عَلى صَدرِها ارتاحَ رَأْسُ الوَلي","دِ ، وأَسقَتهُ كالشَّهدِ أَثدَاؤُها",104,"ا",3,0],["على صفحاته نقشت سطور","ثمار النصر من ورق الحديد",105,"د",1,0],["على صفحات ورد الخد خال","زها لولا الإله لقلت يعبد",106,"د",1,0],["على صيفِ الهوى كانْ الهواءُ هو البقاء","في حينْ كلُ هوايَّ كانْ وداع",107,"ع",1,0],["عَلَىٰ صَوْتِ الْأَثِيْرِ الشَّا","دِيِ الْحَادِيْ بِنَادِيْنَا",108,"ن",2,0],["على صوت الهدير يريق","في القفراء إيناسه",109,"س",2,0],["عَلَى صَفَحَاتِهَا كَتَبُوا","بِحُبِّ فُرَاتِنَا نَعمَر",110,"ر",1,0],["على صخب اختلافك وانعطافي","تنازع في تقلبنا القوافي",111,"ف",2,1],["على صاحب التهليل عند نزول من","تعالى مكانا ان يحيط به فكر",112,"ر",1,0],["عَلَىٰ صَوْنِ الوَفَاْ مَاْ دُمْتُ حَيَّاً","وَإِنْ وَفَّىٰ بِغَمْضِ الرُّوْحِ جَفْنِي",113,"ن",2,0],["على صفحة جبينه ينعكس نورالقمر بضياه","ينوّرلي ظلام الفكر، لحظة يبتدي مسراي",114,"ا",2,0],["على صدق المشاعر قلت أبا اضرب أروع الأمثال","أضحّي بالعمر من شان ترجح عنده الكفه",115,"ف",2,0],["عَلَى صَدْرِ الزَّمَانِ جَثَتْ سُطُورَاً","بِمَا قدْ هَالَ ذَاكِرَتِي وَرَاعَا",116,"ع",2,0]]}