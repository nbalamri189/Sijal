{"poems":[[55,"شرس تيقظه تيقظ خائف","https://www.aldiwan.net/poem30082.html","الكامل"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[46,"فَحْواكَ عَيْنٌ على نَجْوَاكَ يامَذِلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15642&r=&rc=2",""],[113,"من لي به والسحر ملئ جفونه","https://www.aldiwan.net/poem16259.html","الكامل"],[240,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[438,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119887","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120137","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69408","المتدارك"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103057","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""]],"verses":[["شَرِسٌ تَيَقُّظُهُ تَيَقُّظُ خائِفٍ","وَفِعالُ نَجدَتِهِ فِعالُ شُجاعِ",0,"ع",1,1],["شرس السجية إن شرست له","ويلين إن لاينت أخدَعه",1,"ع",2,0],["شَرَستَ بَل لِنتَ بَل قانَيتَ ذاكَ بِذا","فَأَنتَ لا شَكَّ فيكَ السَهلُ وَالجَبَلُ",2,"ل",1,0],["شَرِسٌ وَيُتبَعُ ذاكَ لينَ خَليقَةٍ","لا خَيرَ في الصَهباءِ ما لَم تُقطَبِ",3,"ب",1,0],["شَرِسَ القُوى عَجْلانَ أهوجَ يرتمِي","يُزجي الغوائلَ مُستبِدّاً عاتيا",4,"ي",2,0],["شَرسْتَ بَلْ لِنْتَ بَلْ قانَيْتَ ذَاكَ بِذا","فأَنتَ لاَشكَّ فيكَ أَنتَ السَّهْلُ والجَبَلُ",5,"ل",1,0],["شَرس يَقدُّ الخَطبَ لينُ خِطابِهِ","وَالنَصلَ شدّةُ بَأسِهِ في لينِهِ",6,"ن",2,0],["شَرِسُ الخَلائِقِ في الوَغى فَإِذا اِحتَبى","في القَومِ فَهُوَ المُسمِحُ المُتَغاضي",7,"ض",2,0],["شرس ولكن فيه لين خلائق","كالدهر جامع شدة ورخاء",8,"ا",2,0],["شرس ليَّن لجافٍ ووافٍ","متلف مخلف مفيت مفيدُ",9,"د",1,0],["شرسا تلقاه إن رم","ت لديه الرفد جبسا",10,"س",2,0],["شرسٌ يسفكُ الدماءَ ويُردى","باغتيالٍ مستضعفَ الحيوانِ",11,"ن",1,0],["شَرِسٌ مَرِسٌ فَطِنٌ نَدِسٌ","ما لاذَ بِهِ أَحَدٌ فَشَقي",12,"ق",2,0],["شرس العريكة ليس يقنعها","إن الخطوب لها من الخدم",13,"م",1,0],["شرس المراس يقوم دون محله","كسرى مقام الخائف المتهيب",14,"ب",1,0],["شرساء خلق مكفهر وجهها","في طيها للمرء سم أنقع",15,"ع",1,0]]}