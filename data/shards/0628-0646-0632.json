{"poems":[[31,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[64,"بنزع الرطوبة من جسمها","https://www.aldiwan.net/poem52225.html","المتقارب"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128758","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[5111,"تُفَّاحَةُ المنْتَهَى","https://www.poetsgate.com/ViewPoem.aspx?id=212059",""],[5183,"الجلاء عن قاعدة بنزرت","https://www.poetsgate.com/ViewPoem.aspx?id=185647",""],[5431,"لأنك خبزي الأسمر ...","https://www.poetsgate.com/ViewPoem.aspx?id=198413",""],[5431,"قصيدة اليوم ...","https://www.poetsgate.com/ViewPoem.aspx?id=202682",""],[5476,"كِبْرِيَاءُ الْمَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=194644",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""]],"verses":[["بِنَزوَةِ لِصٍّ بَعدَ ما مَرَ مُصعَبٌ","بِأَشعَثَ لا يُفلى وَلا هُوَ يُغسَلُ",0,"ل",1,0],["بن زِياد وَيَزيدُ بغيا","وَاللَهُ وَالأَيامُ حَربُ مَن بَغى",1,"ا",1,0],["بنزع الرطوبة من جسمها","تكلّس أجزاؤه وانهدم",2,"م",1,1],["بنزو فؤآدي كلما","برق من الزوراء عن",3,"ن",1,0],["بنزوى فيا نزوى سعدت بقبره","أأم بمناقى أم بأجبال يحمد",4,"د",1,0],["بِنزِاعٍ يَبغُونَ رأساً وجِلدا","ذاكَ ما أَرطمِيسُ رامَتهُ حِقدا",5,"ا",1,0],["بنزوة ٍتحملُ النشوى وتدفعُهَا","قابيلُ تَقتلنِي فيْ طورِ تكوينِي",6,"ن",2,0],["بنزرت لمجدك قاعدةٌ","نهضت بلوائك تعقده",7,"د",2,0],["بنزف العشق تُبقيني","بتاريخ الهوى الأكبر!",8,"ر",1,0],["بنزوة الشعر تبدو اليوم ملتهمةْ","تُدنسُ الحبَ إذْ تأتيه منهزمةْ!",9,"م",2,1],["بِنَزْفِ التَّضَارِيسِ فِي مُقْلَتِي","رَوَيْتُ الْمَدَى عَنْ مَرَايَا الْمِيَاهْ",10,"ا",2,0],["بنزور مسحابٍ لنا في العوايد","بنحور هجنٍ مقبلات جداها",11,"ا",3,0]]}