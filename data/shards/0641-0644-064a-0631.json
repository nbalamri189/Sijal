{"poems":[[65,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[75,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[90,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[53,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[45,"قد صدق الورد في الذي زعما","https://www.aldiwan.net/poem10576.html","المنسرح"],[60,"لا تطلبن معيشة بمذلة","https://www.aldiwan.net/poem31132.html","الكامل"],[60,"لا تطلبن معيشة بمذلة واربأ","https://www.aldiwan.net/poem31182.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[208,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[369,"أأراكة الوادي سقتك غيوث","https://www.aldiwan.net/poem60972.html","الكامل"],[371,"هذا غريمي في الغرام","https://www.aldiwan.net/poem17097.html","مجزوء الكامل"],[411,"ظفر بن عبد الله أكرم","https://www.aldiwan.net/poem49852.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122665","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84507","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52104","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110318","البسيط"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82187","الكامل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144203","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201808","الوافر"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76503","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58171","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139490",""],[4888,"ما الحب؟","https://www.poetsgate.com/ViewPoem.aspx?id=207682",""],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[4978,"رد على قصيدة لِمنْ أغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=177244",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5343,"امسح دموعك،","https://www.poetsgate.com/ViewPoem.aspx?id=132672",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5660,"رَبابُ إِنّي إِذا عَزَّيتُ مُعتَذِرا","https://www.poetsgate.com/ViewPoem.aspx?id=27049",""],[402,"هل الهلال فحيوا طالع العيد","https://www.poetsgate.com/ViewPoem.aspx?id=35360",""],[5943,"رمسُ الحبيب بدمع العين يسقينا","https://www.poetsgate.com/ViewPoem.aspx?id=34784",""],[5956,"فلسطين أرض العرب*","https://www.poetsgate.com/ViewPoem.aspx?id=182863",""],[5956,"فلسطين عربية باعتراف التوراة والإنجيل والقرآن","https://www.poetsgate.com/ViewPoem.aspx?id=192361",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""]],"verses":[["فلْيَرْعَ حَوْذانَ الغُمَيْرِ هَجْمَةٌ","لِعامِرٍ طائِرَةُ النّسائِلِ",0,"ل",1,0],["فَليُرغِمِ الحَظَّ المَوَلِّيَ أَنَّهُ","وَلّى فَلَم أُتبِعهُ خُطوَةَ تابِعِ",1,"ع",1,0],["فليُرجِفوا بعد النزوح فما هم","إلا الذباب قد استطار مطنطِنا",2,"ن",2,0],["فليرضَ بالتهجين أو فلينصرف","عما يكون جزاءَه التهجين",3,"ن",1,0],["فَليُرِنا الوَردُ إِن شَكا يَدَهُ","أَحسَنَ مِنهُ مِن جودِهِ سَلِما",4,"م",2,0],["فَليَرجِعَنَّ إِلَيكَ رِزقُكَ كُلُّهُ","لَو كانَ أَبعَدَ مِن مَحَلِّ الكَوكَبِ",5,"ب",1,0],["فَليَرجِعَنَّ إِلَيكَ رزقُكَ كُلُّهُ","لَو كانَ أَبعَدُ مِن مَقامِ الكَوكَبِ",6,"ب",1,0],["فَلْيَرْجِعِ الشَّبل مَرْفُوعَ المَقَامِ بِكُ","مْ وَلْتَزْهَ مِصْرُ بِكُمْ مَرْفُوعَةَ الْجِيدِ",7,"د",1,0],["فَليَرعَ مَجدُكَ مِنهُ كُلَّ خَميلَةٍ","كَفَلَت لَها نُعماكَ أَلّا تُمعِرا",8,"ر",2,0],["فَليُرغَمِ الدَهرُ أَنفاً أَنَّ حادِثَهُ","أَرادَنا بِسُهادٍ فَاِستَحالَ كَرى",9,"ر",2,0],["فَليَرمِيَنَّكَ بَعضَ أَسهُمِهِ","فَتُبَلُّ مِنكَ بِثَغرَةِ النَحرِ",10,"ر",1,0],["فليرغم الحسّادُ إنَّ خدودهم","حُطَّت لمَوطَأكم نِعَالَ نِعَالِ",11,"ل",1,0],["فليرجعوا وليكفّوا عن ضلالتهم","فما لغير الهوى للمرء عينان",12,"ن",1,0],["فَلي رامحُ الأقلام لَيس يطيشهُ","تهيّبُ ذي بأسٍ إذا جال في حربِ",13,"ب",1,0],["فلْيّرجِعَنَّ العاذلون على الهوى","ولهم بحُسْنِ تَجَلُّدي تَحْديث",14,"ث",1,0],["فَليُرغَم القَمَرُ الَّذي","في وَجهِهِ أَثَرُ الرَغامِ",15,"م",1,0],["فلْيَرْعَ ثابتَ عَهدِهِ","كيلا يُزعزعَه التَّجافي",16,"ف",2,0],["فَليرعُدَنَّ ويَبرُقَنَّ عَلَيكُمُ","مَن كانَ أجلَبَ بالشِّنانِ وَقَعقَعا",17,"ع",2,0],["فلْيروا منا خميساً لَجِبا","عجلاً يحمل موتاً عجبا",18,"ب",2,0],["فليرو علم النحو عن شعبان","عن الغماري عن أبي حيّان",19,"ن",1,0],["فليركبِ الأخطار في","تحصيل ما ينفي الملامَه",20,"م",2,0],["فليرأب الصدع قومي بالتفافهم","من حول عارف إخواناً لاخوان",21,"ن",1,0],["فليرحلن إلي نائل خالد","وليكفين رواحلي الترحيلا",22,"ل",2,0],["فليرْفَعِ اليقِظُ المهذّبُ نفسَه","عن رقدةِ المتغافلِ المغبونِ",23,"ن",1,0],["فلي روح بظرف ابي نواس","ولكن في وقاري كالمعري",24,"ي",1,0],["فليرحنا وَليكن ريحا الى","خَصبنا ياتي بأَنواع الجراد",25,"د",1,0],["فَليَروه عَنِّيَ عَبدَ اللّهِ","عَن شَيخُنا المُحرر الأَواه",26,"ه",1,0],["فَليَرْحَلَنَّ إلى الرِّسْتَاقِ ناقتَهُ","وليصْحَبْنَ بها من شاءَ من شَجَنِ",27,"ن",1,0],["فليرقبن من ليس تحت لوائه","وليسفكن دما لهم مهدورا",28,"ر",2,0],["فليرو عني مدحهم حسنٌ وهل","يروى سوى حسنٍ ظما الأصداء",29,"ا",2,0],["فلْيَرْعَني اللهُ الّذي انْسكبَتْ","آلاؤهُ والقلبُ يَشكُرُهُ",30,"ر",2,0],["فليرضى عني الناس أو فليسخطوا","أنا لم أعد أسعى لغير رضاكا",31,"ك",2,0],["فليرحم الله من وافت إلى هدَفٍ","إليه في سيرنا لا بد أن نصلا",32,"ل",2,0],["فَلْيَرْكَبْ المَوْجَ وَ ليُبْحِرْ لطِيَّتِهِ","فَلَنْ يَرانَا دُمُوعاً في مَرَاسِيهِ",33,"ي",2,0],["فليرث قلبك للمحروم من وطن","ولتبك عينك هذا الظلم في البشر",34,"ر",1,0],["فليرجعِ الودّ شمسا جدّ دافئة","وليورق الخير أو فليُنفخِ الصورُ !!",35,"ر",1,0],["فَليَرحَمِ اللَهُ ذاكَ الأَبَّ مُرتَضيا","وَليُلهِمِ الأَهلَ صَبرَ المُخلَصِ الوافي",36,"ف",2,0],["فليرجع الشرق مرفوع المقام","بكم ولتزه مصر بكم مرفوعة الجيد",37,"د",1,0],["فليرحم الله من قد جرَّ أدمعنا","مدى السنين التي ضمَّتْ مآسينا",38,"ن",2,0],["فَلْيرْجِعُوا للسَّبْيِ إن لم يكْتفوا","بالجُزءِ، أو يحظَوا بأسوإ مُنْقلَبْ",39,"ب",1,0],["فَلْيرجِعوا للسَّبْيِ إن لم يقبلوا","بالجُزء أو يَلْقُونَ أسوأَ منقلَبْ",40,"ب",1,0],["فليرحَمِ الله الفَقِيْ","دَ وأنْ يبلغَهُ مُناهْ",41,"ا",2,0]]}