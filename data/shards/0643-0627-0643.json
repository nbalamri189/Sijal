{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[298,"أيا هند لا تنكحي بوهةً","https://www.aldiwan.net/poem411.html",""],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[473,"أما ترى الزهرة والهلال","https://www.aldiwan.net/poem60467.html","مجزوء الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46454","المتقارب"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61277","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99155","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""]],"verses":[["كَإِكْرَامِهِمْ خَيْرَ الأُبُوَّةِ قَبْلَهُ","لَقَدْ أَكْرَمُوا خَيْرَ البَنِينَ ومَن أَحْرَى",0,"ر",2,0],["كأَكدَرَ مُلتَئِمِ خَلقُهُ","تَراهُ إِذا ما عَدا تَولَبا",1,"ب",2,0],["كآكل سم اوجب الموت اكله","وكل بتقدير لرب البرية",2,"ه",1,0],["كَأُكرَةٍ مِن فَضَّةٍ","وَصَولَجانٍ مِن ذَهَبِ",3,"ب",1,0],["كَأَكاليلٍ زَهورٍ حَمَلَت","عَقرَباً يَلسَعُ مِن تاهَ وَتاها",4,"ا",3,0],["كأكل فؤاد في جلائهم","نشوان قد لعبت فيه العناقيد",5,"د",1,0],["كأكل النار منها النفس إن لم","تجد حطباً وبعضَ الموقدينا",6,"ن",2,0],["كَأكمهَ يَسخر مِن مُبصِرٍ","وَحافٍ يَشير عَلى ناعل",7,"ل",1,0],["كَأكعبِ الرمح لَكن لا تثقِّفها","يَد صَناع وَلَكن فكرةٌ وَفمُ",8,"م",1,0],["كأكل الجنة ذات الرفعه","أو زائل ببطء أو بسرعة",9,"ه",1,0],["كأكؤس فضة فيها","بقايا شهلة الخمر",10,"ر",1,0],["كآكل الأَفيون يسري به السم","مُ ويسترسل في لذته",11,"ت",2,0],["كاكتشاف النفط أو كالكهربا","واختراع الخصب من قحط الحجرْ",12,"ر",1,0]]}