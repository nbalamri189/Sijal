{"poems":[[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[408,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"]],"verses":[["إِذ ظَلَّ يَحسَبُ كُلَّ شَخصٍ فارِساً","وَيَرى نَعامَةَ ظِلِّهِ فَيَحولُ",0,"ل",1,0],["إِذ ظَلَّلَتهُ الغَمامُ الغُرُّ وَانهَصَرَت","عَطفاً عَلَيهِ فُروعُ الضَّالِ وَالسَّلَمِ",1,"م",1,0],["إِذ ظَلَّ غَلّابٌ يَذودُ حُماتَهُم","إِنَّ التَقَرُّبَ مِن رِضاكَ يُشَجِّعُ",2,"ع",1,0],["إذْ ظَلّ يدعو أخاهُ كلُّ ذي رحمٍ","إليك عنِّي فليسَتْ بينَنا رَحِمُ",3,"م",1,0],["إذ ظن أما مثل من عن ملكه","قد راح عنه بصفقة المغبون",4,"ن",1,0],["إذ ظلها ضاف وإذ ماؤها","صاف وإذ بلبلها يسجع",5,"ع",1,0]]}