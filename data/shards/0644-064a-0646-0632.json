{"poems":[[57,"بشر منى بظلوم أن تحل بها","https://www.aldiwan.net/poem26100.html","البسيط"],[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[32,"تعرفت أطلالا فهاجت لك الهوى","https://www.aldiwan.net/poem29521.html","الطويل"],[29,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[74,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[53,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[47,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[71,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[122,"تخَطّت منك قافيةٌ عشاء","https://www.aldiwan.net/poem491.html",""],[310,"ألا في جوار الله تم نفاسها","https://www.aldiwan.net/poem56498.html","الطويل"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[438,"لئن زاد في ذقنه حمرة","https://www.aldiwan.net/poem12792.html","المتقارب"],[458,"تمهل أمام الماء حين ابتسامه","https://www.aldiwan.net/poem61235.html","الطويل"],[482,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216685",""],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202554","الطويل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202165","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93826","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140053",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65440","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89191","المتقارب"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103579","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199068","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94549","الوافر"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116044","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139674",""],[4984,"للختام - جدارية : 12 -","https://www.poetsgate.com/ViewPoem.aspx?id=190018",""],[6152,"أذوي احتراقا","https://www.poetsgate.com/ViewPoem.aspx?id=203688",""]],"verses":[["لَيَنزِلَنَّ بِها طيبٌ تَطيبُ بِهِ","تِلكَ البِقاعُ وَنورٌ يَكشِفُ الظُلَما",0,"م",2,0],["لَئِنْ زيّنوا الدُّنْيا بزُهْرِ وُجوهِهِمْ","لقدْ زيّنوا بالذِّكْرِ كلَّ مُجلَّدِ",1,"د",1,0],["لَئِن زُوِّجَت مَيٌّ خَسيساً لَطالَ ما","بَغى مُنذِرٌ ميا خَليلا يُهينُها",2,"ن",3,0],["لَئِن زَلَّ يَوماً بِالفَرَزدَقِ حِلمُهُ","وَكانَ لِقَيسٍ حاسِداً لا يَضيرُها",3,"ر",3,0],["لئن زانَ هذا العقدُ جِيداً للذَّةٍ","لقد زانَ فرقاً للفضائلِ تاجها",4,"ج",3,0],["لئن زهوت بشيء لا زمان له","إني إذا لزهيد الرأي مضعوف",5,"ف",1,0],["لَئِن زُوِيَت عَنّا الحُظوظُ فَمِثلُها","إِذا خَسَّ فِعلُ الدَهرِ عَن مِثلِنا يُزوى",6,"و",2,0],["لَئِن زُلزِلَ الثَغرانِ عِندَ ذَهابِهِ","لَقَد سَكَنَت بِالناطَلوقِ الزَلازِلُ",7,"ل",1,0],["لئنْ زادَ مالُ المرءِ معْ نَقْصِ علمِهِ","فذلكَ خسرٌ لا يقابلُهُ خُسرُ",8,"ر",1,0],["لئن زعموا الأذى والبَغْيَ عدلاً","فما خَفِيَ الصوابُ ولا عَمينا",9,"ن",2,0],["لئن زمّت ركابُ الوفد عنكم","وألفيتم منازلهم خلاء",10,"ا",2,0],["لَئِن زانَ هَذا القبرَ منها فريدةٌ","فَقَد راعَ سلكَ الملكِ مِنها اِنحِلاسها",11,"س",3,0],["لِيَنزُلْ إن كان كذلك من","بَصَري لا أُفْقِيَ أَسْوده",12,"د",2,0],["لئن زاد في ذَقْنه حُمرةً","بما زادَ في الوجهِ من صفرتِهْ",13,"ه",1,1],["لئن زارها العشاق من كل بقعة","فكم عاشق في غربة بعنائي",14,"ي",1,0],["لئن زارني والشامُ داري ودارُه","بنجدٍ ومرماها لقد أبعدَ المسرى",15,"ر",2,0],["لين زاد الزود به وامْسَى وليع","واحترق بين القوافي والشعور",16,"ر",1,0],["لئن زاد طول البعد منكم تماديا","فقد زادت الأشواق طول بعادى",17,"د",2,0],["لَئِنْ زاد طُولُ البُعدِ منكم تَمادِياً","فقد زادتِ الأَشواقُ طول تمادي",18,"د",2,0],["لئن زهت الدنيا بحسن غضارها","وعزت ملاهى لهوها وازدهارها",19,"ر",3,1],["لئن زالت مناصبهم فَهُمْ هُمْ","وما زالت مناصب الاحترام",20,"م",1,0],["لئن زار المنام جفون صب","وتابعه الخيال له رفيق",21,"ق",1,0],["لئن زعموا أنّ الخلاء وجُودُهُ","مُحالٌ فمنقوضٌ بكفيّ وكيستي",22,"ي",1,0],["لئن زارني بعد ذا شخصه","فذا اليوم عيد المنى الأكبر",23,"ر",1,0],["لئن زفَّ ودك نحوي لقد","غدا من فؤادي بأعلى مكان",24,"ن",1,0],["لينزجر الباغي ويأمن سالك","ببيداء ترمي من جوانبها ذعرا",25,"ر",2,0],["لئن زاد الزمان لنا عنادَه","فإنَّ اللَه لم يترك عبادَه",26,"د",2,1],["لئن زادَني قُربُ المزارِ تشُّوقاً","لِلُقياك آذى فِعلَهُ عَدَمُ الحسِّ",27,"س",1,1],["لئن زمناً عنِّا تسَّتر ختمهم","فعن مجده في الناس قد كُشف الستر",28,"ر",1,0],["لَئِنْ زَعَمُوا البُؤْسَ فِيكِ مُقِيمٌ","فَخَيْرُكِ أدْوَمُ مِنْهُ وَأَدْنَى",29,"ن",2,0],["لئن زعموا الغياب يفيد صبّا","لقد كذبوا فقد زدت اختناقا!",30,"ق",2,0]]}