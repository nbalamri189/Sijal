22,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4767,"مبدئي في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198464",""],[4859,"سلّم النبضات","https://www.poetsgate.com/ViewPoem.aspx?id=191367",""],[5038,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=190133",""],[585,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5121,"صَبَاحُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215854",""],[5121,"عَجِيب","https://www.poetsgate.com/ViewPoem.aspx?id=216023",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[5189,"جميلُ الخلق","https://www.poetsgate.com/ViewPoem.aspx?id=190888",""],[5277,"وطن الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=189276",""],[5277,"طفلةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=190765",""],[5277,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=191024",""],[5277,"طيفُ الغوالي","https://www.poetsgate.com/ViewPoem.aspx?id=214546",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5431,"تسألني القصيدة عن هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=183091",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5751,"تعال بنفسجًا","https://www.poetsgate.com/ViewPoem.aspx?id=214806",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[944,"أخي أنتَ ومولايَ","https://www.poetsgate.com/ViewPoem.aspx?id=96322",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5853,"((الى ابنتي ..خلود))","https://www.poetsgate.com/ViewPoem.aspx?id=175625",""],[5873,"تصرّم الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=215353",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5956,"العبّارة المصرية","https://www.poetsgate.com/ViewPoem.aspx?id=192129",""],[5956,"إسلام ساندرا","https://www.poetsgate.com/ViewPoem.aspx?id=193137",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[5956,"تصادُمُ السمُوِّ بالدنُوِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193936",""],[6142,"هلم نرق ماء العيون لمن أحيا","https://www.poetsgate.com/ViewPoem.aspx?id=155751",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَما أَحفِلُ الخَطبَ مِن بَعدِها","إِذا جَلَّ بَل لا أُبالي الحِماما",0,"م",2,0],["فَما أُحيلُ عَليهِم عِندَ نازِلَةٍ","لَكِن أُحيلُ عَلى ذَنبِ المَقاديرِ",1,"ر",1,0],["فَما أَحرَزَت أَيدي اِمرِئِ الَقيسِ خَصلَة","مِنَ الخَيرِ إِلّا خَصلَةً تَستَفيدُها",2,"د",3,0],["فما أحد منهم وفى بعهوده","ولا أحد منهم بما قال قد برّا",3,"ر",2,0],["فَما أَحصَنَتهُ بِالسُعودِ لِمالِكٍ","وَلا وَلَدَتهُ أُمُّهُ لَيلَةَ القَدرِ",4,"ر",1,0],["فَما أَحَدٌ مِنّا بِمُهدٍ لِجارِهِ","أَذاةً وَلا مُزرٍ بِهِ وَهوَ عامِدُ",5,"د",1,0],["فَما أَحَدٌ مِنَ الأَقوامِ عَدّوا","عُروقَ الأَكرَمينَ عَلى اِنتِسابِ",6,"ب",1,0],["فَما أَحيَ لا تَنفَكُّ مِنّي قَصيدَةٌ","إِلَيكَ بِها تَأتيكَ مِنّي رِكابُها",7,"ب",3,0],["فَما أَحيَ لا أَجعَل لِساني لِغَيرِكُم","وَلا مِدَحي ما حَيَّ لِلزَيتِ عاصِرُه",8,"ر",2,0],["فَما أَحَدٌ مِن قَيسِ عَيلانَ فاخِراً","عَلَيهِ وَلا مِنهُم كَثيرٌ يُكاثِرُه",9,"ر",2,0],["فَما أَحَدٌ في الناسِ يَعدِلُ دَرأَنا","بِعِزٍّ وَلا عِزٌّ لَهُ حينَ نَجنَفُ",10,"ف",1,0],["فَما أَحَدٌ إِلّا يَرانا أَمامَهُ","وَأَربابَهُ مَن فَوقِهِ حينَ نَلتَقي",11,"ق",2,0],["فَما أَحَدٌ مِن غَيرِهِم بِسَبيلِهِم","وَما الناسُ إِلّا مِنهُمُ بِمُقيمِ",12,"م",1,0],["فما أُحرِّكُ في فكّيّ عن غَضَبٍ","لسانَ مُنْتَهِشِْ الأعْراض منتهسِ",13,"س",1,0],["فما أُحَدّثُ إلّا","عن ممرضي وطبيبي",14,"ب",2,0],["فما أحدٌ إلى الإنصافِ يدعو","وكلٌّ في هواهُ لهُ انخراطُ",15,"ط",1,0],["فَما اِحتَمى جانِبٌ لَم يَحمِهِ مَلِكٌ","وَلا مَضى صارِمٌ لَم يُمضِهِ بَطَلُ",16,"ل",1,0],["فما أحدٌ بمالكِ أمرِ مِصرٍ","وما بالشّعبِ جُبْنٌ أو جُمودُ",17,"د",1,0],["فَما أَحضَرُ اللَذاتِ إِلّا تَخَلُّفاً","وَلَم أَرَ مَخلوقاً بِغَيرِ يَمينِ",18,"ن",1,0],["فَما اِحتِيالي وَقَد خُلِقتُ فَتىً","تَجري بِما ساءَني المَقاديرُ",19,"ر",1,0],["فَما أَحسَنَ بِالمَعشو","قِ أَن يَهجُرَ أَحيانا",20,"ن",2,0],["فَما أَحرَزَتهُ كَي يَكونَ لِغَيرِها","وَلا جَمَعَتهُ لِلنَدى وَالمَنائِحِ",21,"ح",1,0],["فَمَا أَحْزَنْتَ في حَرْبٍ عَدُوَّاً","وَلا أَفْرَحْتَ فِي سِلْمٍ حَبِيبَا",22,"ب",2,0],["فَمَا احْتِيَالِي وَنَفْسِي غَيْرُ صَابِرَةٍ","عَلَى البُعَادِ وَهَمِّي غَيْرُ مُنْفَرِجِ",23,"ج",1,0],["فَمَا أَحْرَاهُ فِي التّارِيخِ يَوْماً","بِتَبْجِيلٍ يُخَص بِهِ وَفَخْرِ",24,"ر",1,0],["فما احتقر الناسُ إلا الأديب","ولا احترم الناسُ إلا الثريا",25,"ي",2,0],["فما احد في الارض غيرك نافعي","افعل له اخلصني المحبة وامحض",26,"ض",1,0],["فما أحوك على الأيام قافيةً","إلّا وفيها على جبيه عنوان",27,"ن",1,0],["فَمَا أحدٌ إِلاَّ مُصَابٌ بحبِهَا","بِقَتلٍ وإلاَّ فالمصيبةُ في العَقلِ",28,"ل",1,0],["فَما أَحدَثَت فيها العُهودُ كَأَنَّما","تَلَعَّبُ بِالسَمّانِ فيها الزَخارِفُ",29,"ف",1,0],["فما احتجت في أخذ الخيول محطة","ولا صرف مال بل عفكتهم عفكا",30,"ك",2,0],["فما أحمد ممن يضيع جاره","ولكنه ممن يضيع ماله",31,"ل",2,0],["فما أحمد معط ولا مانع سدى","فاوسعه حمدا كلما جاد أو ضنا",32,"ن",2,0],["فما أحد في الناس منك إذا دعا","إلى نصرة الإسلام أولا ولا أملا",33,"ل",2,0],["فما أحسن التقوى وما أيمن الهدى","وأسعد عبد سل في نصره نصلا",33,"ل",2,0],["فَما اِحتَلَّ إِلّا صُلبَ كُلِّ خَلِيفَةٍ","مُحِيطٍ بِأَحكامِ الشَريعَةِ عالِمِ",34,"م",1,0],["فَما أَحَسَّت بِهِ إِلّا اِنثَنَت هَزَماً","وَنَكهَةُ الذِئبِ لا تَخفى عَلى الغَنَمِ",35,"م",1,0],["فَما أَحسَنَتْ حَقَّ الوَفاءِ مسرّتي","وَلَكن عَساها أَحسنتْ عِنديَ العُذرا",36,"ر",2,0],["فما أحلى إذا وقفتْ إليها","تبالي بالجمالِ ولا تبالي",37,"ل",2,0],["فما أحلى الغناء بعذب شعر","نحيّي فيه عالمنا الوليدا",38,"د",2,0],["فَمَا أَحْلَى الْعِتَابَ بِهِ وَلَكِنْ","مُضَمَّنُهُ يُعَدُّ مِنَ الْمُحَالِ",39,"ل",1,0],["فما أحنف في الحلم أو معن في الندى","وهذا لكلٍّ عروةٌ وعصام",40,"م",1,0],["فما أحزن الأيام قبل مصابه","شهيد توي إلا الحسين بن فاطم",41,"م",1,0],["فما أحلى الغرامَ بلا سخاءٍ","ولا بخلٍ ووَصلكِ بينَ بينا",42,"ن",2,0],["فما أحلى النِّقابَ على المُحيّا","إذا حَفِظَ الخفارةَ والوقارا",43,"ر",2,0],["فَما أَحلى هَواها في فؤادي","وان بخلت عَلى بما اريد",44,"د",1,0],["فَما أَحد منهم يَقول انا لها","سواه واى يَنتَهي مثله قربا",45,"ب",2,0],["فَمَا أَحْبَبتَ مِنْ خُلُقٍ رَضِيّ","ومَا أحْبَبتَ مِنْ خَلْقٍ وَضِيِّ",46,"ي",1,0],["فَما اِحتِياجي إِلى زَهر الرِياض وَفي","خَدّي عذار كَريحان عَلى نَهرِ",47,"ر",1,0],["فما أحسن الدنيا التي كنت زينها","وإذا صرت للأخرى فما أحسن الاخرى",48,"ر",2,0],["فما أحسن القرآن قرآن أحمد","وما أحسن الاذكار اذكاره النثرا",48,"ر",2,0],["فَما أحسَنَ الدُّنيا إِذا كُنتَ جانِبي","وإِن غِبتَ عَن عَيني فَما أقبح الدُّنيا",49,"ي",2,0],["فما أحسَبُ شَيئاً غَي","رَها مِن صَرفهِ سالِم",50,"م",1,0],["فَما أحسَنتَ في القَولِ","كَما تُحسِنُ في الفِعلِ",51,"ل",1,0],["فما أحسن الشيب من زائر","ومن زاجر عن فنون الخلاعة",52,"ه",1,0],["فما أحد في الكون يعطي مسرة","على كل حال أو يعيش بلا عسر",53,"ر",1,0],["فما احتجْتُ بعد السَّيل شرعة وارد","ولا احتجتُ بعد الرَّوض ندًى لرائد",54,"د",1,0],["فما أحرزَ الآمالَ مثلُ مُهاجرٍ","إِلَيْهَا وفاتَ النُّجْحَ من بات ثاويا",55,"ي",2,0],["فما أحسن المسكين ان كان صابراً","وأحلى غنيا محسنا ثم شاكرا",56,"ر",2,0],["فما أحنُّ إلى ربعٍ ولا طللٍ","برامتيك ولا أرتاح للظّعن",57,"ن",1,0],["فما أحدث البعدُ إلاَّ أسىً","ولا ذلك القربُ إلاَّ ولوعاً",58,"ع",2,0],["فَما اِحتَاجَ فَخُّ سُؤالي بِهِ","إِلى صَيدِ طائِرِ أَخبارِهِ",59,"ر",2,0],["فَما أَحَدٌ يَبدُو لَه مِن حجابِهِ","فَينظرُ إِلا وَهوَ بِالذُّلِّ خاشِعُ",60,"ع",1,0],["فما احتيالي إذا طالَ الزمانُ بهم","وما أرى الزمنَ الخالي بأوّابِ",61,"ب",1,0],["فما أحسن التشبيب إلا بذكره","وإن هام قلبي بالسواجي السواجم",62,"م",1,0],["فَما أَحلَى الهَوَى وَأمرَّ طَعماً","وأَقتَلَ والهَوَى مُرٍّ وَحُلوُ",63,"و",1,0],["فما أحدٌ أحبُّ إليّ فيما","أُسِرُّ وما أبوحُ به وأُبدي",64,"د",2,0],["فما احْتكمْتُ وعيْنَيْها إلى فَمِها","إلاّ شُغِلتُ عن الخَصْمين بالحَكَمِ",65,"م",1,0],["فما اِحتَجبت عنّي ولا غاب شخصها","من العينِ إِلّا في ضميري تمثَّلا",66,"ل",2,0],["فَما أَحسَنَها بيضاً","تَمَشَّينَ إِلى دُعجِ",67,"ج",1,0],["فما احسن العلم ان اظهرت","ادلته الحق فيمن نطق",68,"ق",1,0],["فَما أَحسنه في العين","وفي القلب واحلاهُ",69,"ا",2,0],["فما أحسنَ الدُّنيا وأحلى نَعيمها","لدينا وإن كانت غرورا وزُخرفا",70,"ف",2,0],["فما أَحرى سكوتَكَ في رياض","تُضيع بها أغانيكَ العِذابا",71,"ب",2,0],["فما احمرَّ منه فُصوصُ العقيق","وما اسودَّ منه عُيونُ المَها",72,"ه",2,0],["فما أحلاه من برٍّ تلافى","تلافي حين خيَّم في خيامي",73,"م",2,0],["فما أَحَدٌ منكم أَحَقُّ تَمَسُّكاً","بِنسْبَةِ سامٍ حين يُذْكَرُ سامُ",74,"م",1,0],["فما أحسن الدنيا بأوبتك التي","تجلت لنا عن وجه أكرم آيب",75,"ب",1,0],["فما أحامي على مقامي","وما أعالي فما أبالي",76,"ل",2,0],["فَما أحَمِّلُ صَبري فَوقَ طاقَتِهِ","وَلا أكَلِّفُ قَلبي فَوقَ ما يَسَعُ",77,"ع",1,0],["فَما اِحتَوَت الدُنيا وَلا الشَمس أَشرَقَت","عَلى مثلهم لا لا ورب المَشارق",78,"ق",1,0],["فما احيلاها وما أملحها","عاطلة من الحلى والحلل",79,"ل",1,0],["فما احاذر من أن","أنازل الأبطالا",80,"ل",2,0],["فما أحلى بنار الحب حرقي","كأني بين جنات وطيب",81,"ب",1,0],["فما أحقر العيش المحبب ينتهي","إذا أضرب القلب الخفوق عن الضرب",82,"ب",1,0],["فما أحوك على الأيام قافيةً","إلّا وفيها على حبَّيه عنوان",83,"ن",1,0],["فما أحاطت ولاذت في سُرادقه","إلا وأحرق أحشائي الّذي أجدُ",84,"د",1,0],["فما أحدٌ يريدُ البسط إلا","ويضربُ ما على رأس الإمام",85,"م",1,0],["فَما أَحَدٌ يَعُدُّ لِيَومِ خَيرٍ","وَلا أَحَدٌ يَعودُ عَلى حَميمِ",86,"م",1,0],["فَما اِحتَجَبَت فَتَوئسُ أُمُّ بَدرٍ","قُلوبَ الطامِعينَ وَما تَجودُ",87,"د",1,0],["فما أَحْلاه من أُنسٍ بدارٍ","صَبوحُك فِيهِ من رِيمِ الفَلاةِ",88,"ه",1,1],["فَما احمَرَّ مِنها الخَدُّ إِلّا لأَنَّهُ","عَلَيهِ دِماءُ العاشِقينَ أَريقا",89,"ق",2,0],["فما أحد لأنعمه","إذا ما عدّ أحصاها",90,"ه",2,0],["فما أحيلى عاقبات الرضا","اذا انجلي داء العنا المؤلم",91,"م",1,0],["فَما أَحسَن الفتيانَ تَهوى جباهُهم","عُيون الموا