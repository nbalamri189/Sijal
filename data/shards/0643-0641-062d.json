{"poems":[[85,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[68,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[82,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[189,"لله خد بدت من حسنه حجج","https://www.aldiwan.net/poem14648.html","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138543",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66490","البسيط"]],"verses":[["كف حمل الري جدك","والرسول جيش بشرق",0,"ق",1,0],["كَفٌّ حَكى وابِلَ الأَنواءِ وابِلُها","حَتّى غَدا يَحسُدُ المَحكِيَّ لِلحاكي",1,"ك",2,0],["كفَّ حكمُ الماءِ منها سورةً","تُسْكِرُ الصّاحيَ منها بالشّميم",2,"م",1,0],["كفحمةٍ عَمَّ صِبْغُ النارِ ظاهرَها","وغادر البعضَ من مُسْوَدِّ فاحِمه",3,"م",2,0],["كف حلماً عن العدو فأضحى","في استلاب النفس الزكية يطمع",4,"ع",1,0],["كفّ حكى وابل الأنواءِ وابلها","بل غَمَّرَ الخلق فيضاً سيبها الزّاكي",5,"ك",2,0]]}