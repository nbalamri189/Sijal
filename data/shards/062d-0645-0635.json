{"poems":[[83,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[133,"صور تلوح لخاطر المعمود","https://www.aldiwan.net/poem67437.html","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76799","السريع"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119472","الرجز"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104422","البسيط"],[5533,"أَهْدُوا السَّلامَ إلى حِمْص","https://www.poetsgate.com/ViewPoem.aspx?id=176318",""],[5533,"حَنِيْن إلى حِمْص","https://www.poetsgate.com/ViewPoem.aspx?id=176641",""],[5829,"حمص العدية","https://www.poetsgate.com/ViewPoem.aspx?id=158855",""],[5912,"ساروت في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205007",""],[5912,"شام الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=205018",""]],"verses":[["حِمصُ الَّتي تَدعوكَ جَهِّز دَعوَةً","لِغَياثِها إِن لَم تُجَهِّز عَسكَرا",0,"ر",2,0],["حِمصُ العَديَّةُ كُلُّنا يَهواكِ","يا كَعبةَ الأبطالِ إِنَّ ثَراكِ",1,"ك",1,0],["حمص لمن اضحى بها جنة","يدنو لديها الآمل القاصي",2,"ي",1,1],["حمصه كالدر في التشكيل","عدسه منتخب جليل",3,"ل",1,0],["حمص البطون تهادى في قبا ورع","تضلهم قبة الهادي عن النصب",4,"ب",1,0],["حِمْصُ الحَبِيبَةُ قَدْ بِيعَتْ بلا ثَمَنٍ","للغادِرينَ وما للغَدْرِ نِسْيانُ",5,"ن",1,0],["حِمْصُ الحَبِيْبةُ لا تَبْكي لنَائِبةٍ","دَمْعُ الأَرَامِلِ ما للحُسْنِ قَدْ خُلِقا",6,"ق",2,0],["حمص وأي بلاد الأرض تشبهها","فخرا تأصل أنساباً وأعراقا",7,"ق",2,1],["\"حِمصُ\" التي زَفّتْ زُهُورَ شَبَابهَا","حَيثُ النّعِيم بِقُرْبِهِمْ قَدْ هَلّا",8,"ل",2,0],["حِمْصيَّةٌ في رُبَى الإزهار سَاكنةٌ","يَطوفُ بيتِي مِنَ الرَّيْحَانِ أَصْنَافُ",9,"ف",1,0]]}