ه"],[388,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[390,"يا زائرا قد قصد المشاهدا","https://www.aldiwan.net/poem53586.html","الرجز"],[402,"يا قلب لا تستشعر الأحزانا","https://www.aldiwan.net/poem49719.html","الكامل"],[402,"أولى الذخائر بالسياسة","https://www.aldiwan.net/poem49914.html","مجزوء الكامل"],[406,"أظن العدا أن ارتحالي ضائري","https://www.aldiwan.net/poem32201.html","الطويل"],[407,"طاف الخيال وحيه بسلام","https://www.aldiwan.net/poem67468.html","الكامل"],[413,"يواعدني بالوصل منه ويخلف","https://www.aldiwan.net/poem53882.html","الطويل"],[413,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[413,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[436,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[456,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[456,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[459,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[459,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[480,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[493,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[498,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[498,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[498,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[504,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[527,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[538,"إذا مطمع يوما غزاني غزوته","https://www.aldiwan.net/poem56860.html","الطويل"],[549,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[549,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[556,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[565,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[573,"فؤادي بسهم المقلتين رماه","https://www.aldiwan.net/poem2836.html","الطويل"]],"verses":[["وَأَرضٍ يَضُلُّ اللَيلُ بَينَ فُروجِها","وَيُجزِعُهُ أَجزاعُها وَالأَجارِعُ",0,"ع",1,0],["وَأَرضَعُ بِالخِداعِ عَنِ المَعالي","وَكانَ الطِفلُ أَولى بِالرِضاعِ",1,"ع",1,0],["وَأَرضٍ مُقَنَّعَةٍ بِالهَجي","رِ تَنضو مِنَ الآلِ عَنها خِمارا",2,"ر",2,0],["وَأَرضاً تَبَدَّلَ قُطّانُها","مَجَرَّ القَنا بِمَجَرِّ المَساحي",3,"ي",1,0],["وَأَرضاً بِنُوّارِ الأَقاحي صَقيلَةً","تَرَدَّدُ فيها شَمأَلٌ وَجَنوبُ",4,"ب",1,0],["وَأَرضَعنَ أَفواهَ المَطامِعِ فَجعَةً","فَطَمنَ بِها عِندَ النَجاحِ المَطالِبا",5,"ب",2,0],["وَأَرضٍ بِها بِعتُ الصَبابَةَ وَالصِبا","وَناهَضَ قَلبي الهَمَّ مِن كُلِّ جانِبِ",6,"ب",1,0],["وَأَرضاً إِذا ما اِجتَلاها الهَجي","رُ طَلَّقَها مِن يَدَيهِ الضَريبُ",7,"ب",1,0],["وَأَرضاني عَلى الأَيّا","مِ بَعدَ اللَومِ وَالعَتبِ",8,"ب",1,0],["وَأَرضى بطَيفٍ وهيَ تأبى طروقَهُ","أُغازِلُهُ والعاذلاتُ هواجِعُ",9,"ع",1,0],["وأرضٌ حَصاها لُؤلُؤٌ وتُرابُها","تَضوَّعَ مِسْكاً والمِياهُ شَمولُ",10,"ل",1,0],["وأرْضى بحَظٍّ في الثّراءِ مؤَخَّرٍ","إذا كانَ بَيتي في العَلاءِ مُقَدَّما",11,"م",2,0],["وأرضى اللهَ نَصْرُهُمُ لِدِينٍ","بهِ بُعِثَ ابنُ عمّهِمُ رَسولا",12,"ل",2,0],["وَأَرضَت بِسُخطي مِعشَراً كانَ سَخَطَهُم","يَهونَ عَلَيها في رِضايَ وَمِن أَجلي",13,"ي",1,0],["وَأَرضُ اللَهِ واسِعَةٌ وَلَكِن","إِذا نَزَلَ القَضا ضاقَ الفَضاءُ",14,"ا",2,0],["وَأُرضي هَوى نَفسي وَإِن صَحَّ قَولُهُم","هَوى النَفسِ ذُلٌّ وَالخِيانَةُ عارُ",15,"ر",1,0],["وَأَرضٌ كَسَتها كِرامُ الشُهورِ","حَرائِرَ مِن نَسجِ آذارِها",16,"ر",3,0],["وَأَرضى بَني الرَبداءِ وَاِعتَمَّ زَهوُهُ","وَأَكمامُهُ حَتّى إِذا ما تَهَصَّرا",17,"ر",2,0],["وَأَرضى بِغَيرِ البَذلِ مِنها لَعَلَّها","تُفارِقُنا أَسماءُ وَالوِدُّ صالِحُ",18,"ح",1,0],["وَأَرضٍ خَلاءٍ تَسحَلُ الريحُ مَتنَها","كَساها سَوادُ الَليلِ أَردِيَةً خُضرا",19,"ر",2,0],["وَأَرضى المُغيرِيِّينَ في الحُكمِ إِنَّهُم","بُحورٌ وَأَخوالُ البُحورِ القَماقِمِ",20,"م",1,0],["وَأَرضَ هِرَقلَ قَد قَهَرتَ وَداهِراً","وَتَسعى لَكُم مِن آلِ كِسرى النَواصِفُ",21,"ف",1,0],["وأرض البَرّ بعد وكل بحر","يعولُ الفُلك مركبه الشحينا",22,"ن",2,1],["وَأَرضى بِما تَرضى عَلى السَخطِ وَالرِضا","وَأُغضي عَلى عِلمٍ بِأَنَّكَ تَظلِمُ",23,"م",1,0],["وَأَرضٌ كُنتُ أَملَؤُها خُيولاً","وَجَوٌّ كُنتُ أُرهِجُهُ غُبارا",24,"ر",2,0],["وأرضيت في الخلق خلاَّقهم","وفي دولة الملك سلطانها",25,"ن",3,0],["وأرْضعتْك الحظُوظُ دِرَّتَها","رضاعةً مِن ورائِها حَشكُ",26,"ك",1,0],["وَأَرضى بِأُخرى قَد تَبَدَّلتُ إِنَّني","إِذا ساءَني وادٍ تَبَدَّلتُ وادِيا",27,"ي",2,0],["وَأُرضِعَ الحِكمَةَ عيسى الهُدى","أَيّامَ تُربي مَهدُهُ وَالوِساد",28,"د",1,0],["وأرضٌ نفضتُ العِزَّ عن منكبي بها","كما نفص الأرطى ظباءُ الصرائمِ",29,"م",1,0],["وَأَرضٍ بِها جَيلانُ ريحٍ مَريضَةٍ","يَغُضُّ البَصيرُ طَرفَهُ مِن فَضائِها",30,"ا",3,0],["وأرضَى ما أكونُ من اللَّيالي","إذا ما عادَ بِشْرُكَ لي فَدَاما",31,"م",2,0],["وَاِرضَ لِلناسِ بِما تَرضى بِهِ","وَاِتبَعِ الحَقَّ فَنِعمَ المُتَّبَع",32,"ع",1,0],["وارضَ عنها وإذا لم","ترضَ فاغفر لي الهديه",33,"ي",2,0],["وأرضَعَني ثَدْيَ المنى فكأنّني","وليدٌ أتى عمرانَ شيخ التقدمِ",34,"م",1,0],["وأرْضُ بُنْصُرَ قد أهْدى غرائبها","لملكهم مَلْكُهَا في سالف القدمِ",35,"م",1,0],["وَاِرضَ لي المَوتَ بِهَجرَيكَ فَإِن","لَم أَمُت شَوقاً فَزِدني أَلَما",36,"م",2,0],["وَأَرضى مِنَ الأَيّامِ أَن لا تُميتَني","وَبي دونِ أَقراني نَوائِبُها النُكدُ",37,"د",1,0],["وَأَرضَعَتهُ وَلَم تَيأَس حَليمَةُ مِن","قَولِ المَراضِعِ إِنَّ البُؤسَ في اليَتَمِ",38,"م",1,0],["وَاِرضَ عَنّي جُعِلتُ أَفديكَ إِنّي","وَالعَزيزِ الجَليلِ أَهوى رِضاكا",39,"ك",2,0],["وأرضَى الألى ضَلُّوا السَّبيلَ بشيرُهم","لَدُنْ جَمَعوا مِن مالِهِ ما تَبَدَّدا",40,"د",2,0],["وَارْضَ حُكمَ الرسولِ إنّكَ مَرْدُو","دٌ ومَنْ مِثْلُهُ قضاءً وحُكما",41,"م",2,0],["وَأَرضاً يَكادُ اللَيلُ في عَرَصاتِها","لِشِدَّةِ ما قَد ضاوَعَ المِسكُ يَعبَقُ",42,"ق",1,0],["وَأَرضى بِهِ أَهل الحُتوفِ وَلَم يَضَع","بِهِ الذُخرَ زاداً لِلَتي هيَ أَنفَعُ",43,"ع",1,0],["وأرْضَعَتْهُ وأُسْدُ الغِيلِ تَكفُلُهُ","بالبَدْوِ كلُّ دَرُورٍ حافِلِ الريّ",44,"ي",1,0],["وَأَرضٍ تَهُبُّ الريحُ فيها مَريضَةً","حَسورٍ لِطَرفِ الناظِرِ المُتَأَمِّلِ",45,"ل",1,1],["وَاِرضَي بِما راعَكِ الزَمانُ بِهِ","ما كُلُّ يَومٍ يَصفو لَكِ الحَلَبُ",46,"ب",1,0],["وَأَرضٌ لا تَحُسُّ بِمَن عَلَيها","وَلا يَبقى بِها مِنهُم عَريبُ",47,"ب",1,0],["وَأَرضَعَ المَجدُ أَطفالاً وَأَمَّلَهُم","دَهرٌ فَماتوا أُلي شَيبٍ وَما فُطِموا",48,"م",3,0],["وأرضٍ بِتُّ أقْري الوَحشَ زادي","بها ليَثُوبَ لي مِنْهُنّ زادُ",49,"د",1,0],["وَأَرضٍ عَليها نَسجُ رِيحٍ مَرِيضَةٍ","قَطَعتُ بحُرجُوجٍ مُسَانَدَةٍ القَرا",50,"ر",2,0],["وَأَرضى بِالإِهانَةِ مَع أُناسٍ","أُراعيهِم وَلَو قَتلي أَحَلّوا",51,"ل",3,0],["وارض يا ويحك من دن","ياك بالقوتِ اليسيرِ",52,"ر",1,0],["وارضَ الحياةَ نعيمَها أو بؤسَها","نُعْمى الحياةِ وبؤسُها أقسام",53,"م",1,0],["وأرض لم تطأ قدمٌ حصاها","وجوٌّ لم يدنِّسْه الزفير",54,"ر",1,0],["وارْضيْ بِما رَاعَك الزَّمانُ بِهِ","ما كُلّ يوْم يصْفُوا لَكِ الْحلبُ",55,"ب",1,0],["وأرض الله واسعة ولكن","إذا نزل القضاء ضاق الفضاء",56,"ا",2,0],["وارض يا بارئي بفضلك عني","واكفني بالقبول ما دمت حيا",57,"ي",2,0],["وأرض فلسطين إذا ما ذكرتها","ذكرت كراماً جودهم يغلب البحرا",58,"ر",2,0],["وأرض اللّه واسعةٌ ففيها","تجد بدلا وعن ضيق فضاء",59,"ا",2,0],["وارضَ بالشىء الذي يؤتى وإنْ","قَلّ فالعاقل يرضى بالأقَلّْ",60,"ل",1,0],["وأرضَ بالقسمةِ واعلم أنهُ","لا يقي مما قضاهُ الله واقْ",61,"ق",1,0],["وارضيتني صونا فياقبر ما الذي","ترى زدتني في صونها وخفائها",62,"ا",3,0],["وأرضيت المهيمنَ والبرايا","فشدّت نحوَ ساحتِك الرحال",63,"ل",1,0],["وأرضيت رب العالمين بطاعة","اطعت بها رب الورى متفردا",64,"د",2,0],["وأرضيت رب العرش في حفظ دينه","على الخلق والإسلام كاد بأن يثوى",65,"و",2,0],["وأرضعته بنو سعد فأسعدهم","حتى غدا الجدب مثل الخصب عندهم",66,"م",1,0],["وَاِرضَ الَّذي يَرضى وَقَدِّم أَمرَهُ","وَأَطِعهُ طاعَةَ مُقتَدٍ لِإِمامِ",67,"م",1,0],["وأرض بالله معينا","في شتاء ومصيف",68,"ف",1,0],["وارض تستقرّ وطود رضوى","وأجبال موثقة فساح",69,"ح",1,0],["وارضها كسماء في نضارتها","ونورها الشمرق الزاهي دراريها",70,"ي",3,0],["وأرضى باللظى مثوى","ووجهك جنة الخلد",71,"د",1,0],["وأرضٌ لِلهُدى فيها","ولِلمعروف أعوانُ",72,"ن",1,0],["وأرضٌ غد للوحي بين عِراصها","مجالٌ وللإسلام في أهلها نصر",73,"ر",1,0],["وَارْضَ يَا رَبَّنَا رِضىً غَيْرَ مَمْزُو","جٍ بِسُخْطٍ عَنِ الذِينَ حَمَوْهُ",74,"و",2,0],["وأرضى بأن الفى المنايا أو المنى","لديك وآمالي يضيقك وسعها",75,"ع",3,0],["وارضى على حكم الليالي فينثني","حسامي طام والوشيج ضئيل",76,"ل",1,0],["وأرضيك في الحالين أني مذنب","وأنك عثرات المسيء تقبل",76,"ل",1,0],["وأرضاك لي مولى مد الدهر مالكا","وما أنا عن هذا المقام ملول",76,"ل",1,0],["وارض لحكم الزمان حالا","وان عنا صرفه المبيح",77,"ح",1,0],["وارضي بما لجميعِ الناسِ فيه رِضاً","ولا تكوني مَلاكاً إننا بشر",78,"ر",1,0],["وارض بها للهاشميّ مآثر","يَعود عَلَينا خير تلك المآثر",79,"ر",1,0],["وَأَرضعَه ثُديَّ المجد دَرّاً","وآواه من العَلياء حضنا",80,"ن",2,0],["وارض التواضع خلقاً إنه خلق ال","أخيار فاقتد بهم تنجو من الوصب",81,"ب",1,0],["وَاِرضَ بِاللَهِ وَكيل","إِنَّهُ نِعمَ الكَفيل",82,"ل",1,0],["وارض بمر القضا تنج من الخطر","واسأل من اللَه كشف البؤس والضرر",83,"ر",1,0],["وأرضكم أرضكم فشقّوا","في جوفها القبر الغريب",84,"ب",1,0],["وارض بالجدِّ فالسعادةُ وهمٌ","أزليٌّ ودعوة لا تُجاب",85,"ب",1,0],["وارضى عنك احيانا","فيفنى ذاك في ذنبك",86,"ك",1,0],["وأرض فؤادي إلى الغيث ظمأى","وما أنت إلا سحابة صيف",87,"ف",1,0],["وَاِرض عَني وَراعني مِثل ما كن","ت وَدَعني مِمَّن توشح كبرا",88,"ر",2,0],["وأرْضُه حَرَمٌ ملآنُ من كَرَمٍ","إليه من كُلِّ أَرضٍ مُنْتَهَى السُّبُل",89,"ل",1,0],["وأَرضٍ قد قطعتُ بها الهَوَاهي","من الجِنَّانِ سَربَخُها مَلِيعُ",90,"ع",1,0],["وَأَرضَيتُ فيكَ الحُبَّ وَالحُبُّ جائِرٌ","وَأَغضَبتُ فيكَ العَزمَ وَالعَزمُ ناصِحُ",91,"ح",1,1],["وَأَرضَيتُ في حبّيكِ مَن أَغضَبَ العُلا","وَيا لَيتَهُ لَو كانَ عَنِّيَ راضِيا",92,"ي",2,0],["وأرضى بِنَزر العيشِ في ظلِّ غُربةٍ","إذا كنتُ أرجو نُقلتي بسلام",93,"م",1,0],["وإرْضَ بنزر العيش واقنع ببَرْضِه","فكم نَهِمٍ قد أهلكته مِعاؤه",94,"ا",3,0],["وارضَ الدنِيَّ من الدُّنا قُوتَ الفنا","فمصيرُ كل مسرَّةٍ لفناءِ",95,"ا",2,0],["وارض عنه قبل أن يمسي رفات","وأنله من مناه منتهاه",96,"ه",1,0],["وأرض عن ربك تظفر برضاه","واشكر الرحمن تحظى بولاه",97,"ه",1,0],["وارض وفوض لتغنم","وسلم الأمر تسلم",98,"م",1,0],["وَأَرض سامِراء أَرض العَسكَرِ","سَلِّم عَلى عَلِيٍّ المطهَّرِ",99,"ر",1,0],["وارضَ الزَّمانَ على تَقَلُّبِ صَرْفِهِ","أولا فأَبدِلْ بالزَّمانِ زمَانا",100,"ن",2,0],["وارضَ الخُمولَ معَ السَّلا","مةِ فالبَلاءُ معَ الرِّياسَهْ",101,"س",2,0],["وأرضاً نَبَتْ بي وهي آهِلَةُ الرُّبى","هي القَفرُ لاَ بل دُون وحشتها القَفْرُ",102,"ر",1,0],["وَاِرضَوا بِما قَسَمَ الإِلهُ لَكُم بِهِ","وَدَعوا وِراثَةَ كُلِّ أَصيَدَ حامِ",103,"م",1,0],["وأرضى بما تَرْضَوْنَ بالسخط والرضا","وآلف بين النَّاس من راح يألف",104,"ف",1,0],["وأرضاً حَماها ناصر بحسامه","حمىً لم يطأه للنوائب حافر",105,"ر",1,0],["وأرض يَفْرَقُ الخرّيت فيها","ويفزعُ من مهالك ما يراها",106,"ا",3,0],["وأَرْضي سُيولٌ من خُيولِ مُظَفَّرٍ","وَلَيلي نجومٌ من سَماءِ مُبارَكِ",107,"ك",1,0],["وأرضِي به والأرضُ بيني وبينه","من الخصْب جَنَّاتٌ خَفَتْ وعيونُ",108,"ن",1,0],["وأرضك كافورٌ يخاضُ وجوهرٌ","وأرضهُمُ صخرٌ يداس وطينُ",108,"ن",1,0],["وأرضَى عن الأقدارِ كيف تصرَّفَت","وغيرِيَ بالأقدارِ يَرضَى ويغضَبُ",109,"ب",1,0],["وأرضٍ حمتها كماةُ الوغى","يُخافُ ويُرهبُ سُكانُها",110,"ن",3,0],["وأرضيت في المجد حتى تبلَّجتْ","أسِرَّتُه عن واضح الثَّغر باسِمِ",111,"م",1,0],["وأرضهم ما فارقتها صواعق","من الظلم بل والجور بل والولاول",112,"ل",1,0],["وأرضَك يا نجل العيون فإنني","فتنت بذاك الفاتر المتضايق",113,"ق",1,0],["وارض بالله وانتظم بهداهم","نعم ذاك الرضاء والإنتظام",114,"م",1,0],["وارْضَ بِنَهجِ الهاشميِّ مَنْهَجاً","فإنَّهُ المَأمونُ من زَيْغِ الزَّلَلْ",115,"ل",1,0],["وارْضَ باللهِ في شُؤُنِكَ قلباً","إنَّما يُورِثُ الرِّضاءُ الرِّضاءُ",116,"ا",2,0],["وأرضٍ دون كنعانَ وبيتٍ","بلا جُدْرٍ وسيفٍ دون ثائرْ",117,"ر",1,0],["وأرض المُصطفى في صاحبِيه","بنصر لا يفلّ له اعتزام",118,"م",1,0],["وارْضَعْ بِثَدْيِ الأُمَّهاتِ الّتي","تَحْنُو ويَكْفيكَ بِها مَفْخَرا",119,"ر",2,0],["وَأَرضى بِها مِن بَحرِ آخَرَ إِنَّهُ","هُوَ الرأيُ أَن تَرضى النُفوسُ ثَمادَها",120,"د",3,0],["وأرضَوْا بأنْ تمشوا ولا كرمٌ لكمْ","في دار مجد الأكرمين ضيوفي",121,"ي",1,0],["وأرضاكُمُ عسري وإن كان عُسركمْ","وأسخطكمْ يُسري وإن لم يكن يسري",122,"ي",1,0],["وارضوا عن الكرارْ","والصهر وابن العمْ",123,"م",1,0],["وَأَرْضَعَ جَنَّاتِهَا دَرَّةُ","فَعَمَّمَ بِالنُّورِ أَشْجَارَهَا",124,"ر",3,0],["وأُرضيه جُهْدِي والتجني يصدُّه","وكم مُستجنٍّ لا يُطاقُ رضَاهُ",125,"ا",2,0]]}