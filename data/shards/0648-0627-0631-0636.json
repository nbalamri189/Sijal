يت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5837,"عشق العلا","https://www.poetsgate.com/ViewPoem.aspx?id=77449",""],[5936,"النعيرية","https://www.poetsgate.com/ViewPoem.aspx?id=184770",""],[161,"زَهْرَةُ الحيَاةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202595",""],[6068,"أعواذلي كفِّي اللوائم واعدلي -28-","https://www.poetsgate.com/ViewPoem.aspx?id=175792",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[463,"صحا القلبُ لكن صبوة ٌ وحنينُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60264&r=&rc=320",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["وَأَرضٍ يَضُلُّ اللَيلُ بَينَ فُروجِها","وَيُجزِعُهُ أَجزاعُها وَالأَجارِعُ",0,"ع",1,0],["وَأَرضَعُ بِالخِداعِ عَنِ المَعالي","وَكانَ الطِفلُ أَولى بِالرِضاعِ",1,"ع",1,0],["وَأَرضٍ مُقَنَّعَةٍ بِالهَجي","رِ تَنضو مِنَ الآلِ عَنها خِمارا",2,"ر",2,0],["وَأَرضاً تَبَدَّلَ قُطّانُها","مَجَرَّ القَنا بِمَجَرِّ المَساحي",3,"ي",1,0],["وَأَرضاً بِنُوّارِ الأَقاحي صَقيلَةً","تَرَدَّدُ فيها شَمأَلٌ وَجَنوبُ",4,"ب",1,0],["وَأَرضَعنَ أَفواهَ المَطامِعِ فَجعَةً","فَطَمنَ بِها عِندَ النَجاحِ المَطالِبا",5,"ب",2,0],["وَأَرضٍ بِها بِعتُ الصَبابَةَ وَالصِبا","وَناهَضَ قَلبي الهَمَّ مِن كُلِّ جانِبِ",6,"ب",1,0],["وَأَرضاً إِذا ما اِجتَلاها الهَجي","رُ طَلَّقَها مِن يَدَيهِ الضَريبُ",7,"ب",1,0],["وَأَرضاني عَلى الأَيّا","مِ بَعدَ اللَومِ وَالعَتبِ",8,"ب",1,0],["وَأَرضى بطَيفٍ وهيَ تأبى طروقَهُ","أُغازِلُهُ والعاذلاتُ هواجِعُ",9,"ع",1,0],["وأرضٌ حَصاها لُؤلُؤٌ وتُرابُها","تَضوَّعَ مِسْكاً والمِياهُ شَمولُ",10,"ل",1,0],["وأرْضى بحَظٍّ في الثّراءِ مؤَخَّرٍ","إذا كانَ بَيتي في العَلاءِ مُقَدَّما",11,"م",2,0],["وأرضى اللهَ نَصْرُهُمُ لِدِينٍ","بهِ بُعِثَ ابنُ عمّهِمُ رَسولا",12,"ل",2,0],["وَأَرضَت بِسُخطي مِعشَراً كانَ سَخَطَهُم","يَهونَ عَلَيها في رِضايَ وَمِن أَجلي",13,"ل",2,0],["وَأَرضُ اللَهِ واسِعَةٌ وَلَكِن","إِذا نَزَلَ القَضا ضاقَ الفَضاءُ",14,"ا",2,0],["وَأُرضي هَوى نَفسي وَإِن صَحَّ قَولُهُم","هَوى النَفسِ ذُلٌّ وَالخِيانَةُ عارُ",15,"ر",1,0],["وَأَرضٌ كَسَتها كِرامُ الشُهورِ","حَرائِرَ مِن نَسجِ آذارِها",16,"ر",3,0],["وَأَرضى بَني الرَبداءِ وَاِعتَمَّ زَهوُهُ","وَأَكمامُهُ حَتّى إِذا ما تَهَصَّرا",17,"ر",2,0],["وَأَرضى بِغَيرِ البَذلِ مِنها لَعَلَّها","تُفارِقُنا أَسماءُ وَالوِدُّ صالِحُ",18,"ح",1,0],["وَأَرضٍ خَلاءٍ تَسحَلُ الريحُ مَتنَها","كَساها سَوادُ الَليلِ أَردِيَةً خُضرا",19,"ر",2,0],["وَأَرضى المُغيرِيِّينَ في الحُكمِ إِنَّهُم","بُحورٌ وَأَخوالُ البُحورِ القَماقِمِ",20,"م",1,0],["وَأَرضَ هِرَقلَ قَد قَهَرتَ وَداهِراً","وَتَسعى لَكُم مِن آلِ كِسرى النَواصِفُ",21,"ف",1,0],["وأرض البَرّ بعد وكل بحر","يعولُ الفُلك مركبه الشحينا",22,"ن",2,1],["وَأَرضى بِما تَرضى عَلى السَخطِ وَالرِضا","وَأُغضي عَلى عِلمٍ بِأَنَّكَ تَظلِمُ",23,"م",1,0],["وَأَرضٌ كُنتُ أَملَؤُها خُيولاً","وَجَوٌّ كُنتُ أُرهِجُهُ غُبارا",24,"ر",2,0],["وأرضيت في الخلق خلاَّقهم","وفي دولة الملك سلطانها",25,"ن",3,0],["وأرْضعتْك الحظُوظُ دِرَّتَها","رضاعةً مِن ورائِها حَشكُ",26,"ك",1,0],["وَأَرضى بِأُخرى قَد تَبَدَّلتُ إِنَّني","إِذا ساءَني وادٍ تَبَدَّلتُ وادِيا",27,"ي",2,0],["وَأُرضِعَ الحِكمَةَ عيسى الهُدى","أَيّامَ تُربي مَهدُهُ وَالوِساد",28,"د",1,0],["وأرضٌ نفضتُ العِزَّ عن منكبي بها","كما نفص الأرطى ظباءُ الصرائمِ",29,"م",1,0],["وَأَرضٍ بِها جَيلانُ ريحٍ مَريضَةٍ","يَغُضُّ البَصيرُ طَرفَهُ مِن فَضائِها",30,"ا",3,0],["وأرضَى ما أكونُ من اللَّيالي","إذا ما عادَ بِشْرُكَ لي فَدَاما",31,"م",2,0],["وَاِرضَ لِلناسِ بِما تَرضى بِهِ","وَاِتبَعِ الحَقَّ فَنِعمَ المُتَّبَع",32,"ع",1,0],["وارضَ عنها وإذا لم","ترضَ فاغفر لي الهديه",33,"ي",2,0],["وأرضَعَني ثَدْيَ المنى فكأنّني","وليدٌ أتى عمرانَ شيخ التقدمِ",34,"م",1,0],["وأرْضُ بُنْصُرَ قد أهْدى غرائبها","لملكهم مَلْكُهَا في سالف القدمِ",35,"م",1,0],["وَاِرضَ لي المَوتَ بِهَجرَيكَ فَإِن","لَم أَمُت شَوقاً فَزِدني أَلَما",36,"م",2,0],["وَأَرضى مِنَ الأَيّامِ أَن لا تُميتَني","وَبي دونِ أَقراني نَوائِبُها النُكدُ",37,"د",1,0],["وَأَرضَعَتهُ وَلَم تَيأَس حَليمَةُ مِن","قَولِ المَراضِعِ إِنَّ البُؤسَ في اليَتَمِ",38,"م",1,0],["وَاِرضَ عَنّي جُعِلتُ أَفديكَ إِنّي","وَالعَزيزِ الجَليلِ أَهوى رِضاكا",39,"ك",2,0],["وأرضَى الألى ضَلُّوا السَّبيلَ بشيرُهم","لَدُنْ جَمَعوا مِن مالِهِ ما تَبَدَّدا",40,"د",2,0],["وَارْضَ حُكمَ الرسولِ إنّكَ مَرْدُو","دٌ ومَنْ مِثْلُهُ قضاءً وحُكما",41,"م",2,0],["وَأَرضاً يَكادُ اللَيلُ في عَرَصاتِها","لِشِدَّةِ ما قَد ضاوَعَ المِسكُ يَعبَقُ",42,"ق",1,0],["وَأَرضى بِهِ أَهل الحُتوفِ وَلَم يَضَع","بِهِ الذُخرَ زاداً لِلَتي هيَ أَنفَعُ",43,"ع",1,0],["وأرْضَعَتْهُ وأُسْدُ الغِيلِ تَكفُلُهُ","بالبَدْوِ كلُّ دَرُورٍ حافِلِ الريّ",44,"ي",1,0],["وَأَرضٍ تَهُبُّ الريحُ فيها مَريضَةً","حَسورٍ لِطَرفِ الناظِرِ المُتَأَمِّلِ",45,"ل",1,1],["وَاِرضَي بِما راعَكِ الزَمانُ بِهِ","ما كُلُّ يَومٍ يَصفو لَكِ الحَلَبُ",46,"ب",1,0],["وَأَرضٌ لا تَحُسُّ بِمَن عَلَيها","وَلا يَبقى بِها مِنهُم عَريبُ",47,"ب",1,0],["وَأَرضَعَ المَجدُ أَطفالاً وَأَمَّلَهُم","دَهرٌ فَماتوا أُلي شَيبٍ وَما فُطِموا",48,"م",3,0],["وأرضٍ بِتُّ أقْري الوَحشَ زادي","بها ليَثُوبَ لي مِنْهُنّ زادُ",49,"د",1,0],["وَأَرضٍ عَليها نَسجُ رِيحٍ مَرِيضَةٍ","قَطَعتُ بحُرجُوجٍ مُسَانَدَةٍ القَرا",50,"ر",2,0],["وأَرْضٍ بِهَا الْتَاثَ السُّعُونُ قَطَعْتُهَا","وأَوْدِيَةٍ قَفْرٍ يَصيحُ بِهَا الهَدَا",51,"د",2,0],["وَأَرضى بِالإِهانَةِ مَع أُناسٍ","أُراعيهِم وَلَو قَتلي أَحَلّوا",52,"ل",3,0],["وارض يا ويحك من دن","ياك بالقوتِ اليسيرِ",53,"ر",1,0],["وارضَ الحياةَ نعيمَها أو بؤسَها","نُعْمى الحياةِ وبؤسُها أقسام",54,"م",1,0],["وأرض لم تطأ قدمٌ حصاها","وجوٌّ لم يدنِّسْه الزفير",55,"ر",1,0],["وارْضيْ بِما رَاعَك الزَّمانُ بِهِ","ما كُلّ يوْم يصْفُوا لَكِ الْحلبُ",56,"ب",1,0],["وأرض الله واسعة ولكن","إذا نزل القضاء ضاق الفضاء",57,"ا",2,0],["وأرضى ذرى الطّود الأشمّ فطالما","تحدّى وسامى كلّ نجم وأتعبا",58,"ب",2,0],["وارض يا بارئي بفضلك عني","واكفني بالقبول ما دمت حيا",59,"ي",2,0],["وأرض فلسطين إذا ما ذكرتها","ذكرت كراماً جودهم يغلب البحرا",60,"ر",2,0],["وأرض اللّه واسعةٌ ففيها","تجد بدلا وعن ضيق فضاء",61,"ا",2,0],["وارضَ بالشىء الذي يؤتى وإنْ","قَلّ فالعاقل يرضى بالأقَلّْ",62,"ل",1,0],["وأرضَ بالقسمةِ واعلم أنهُ","لا يقي مما قضاهُ الله واقْ",63,"ق",1,0],["وارضيتني صونا فياقبر ما الذي","ترى زدتني في صونها وخفائها",64,"ا",3,0],["وأرضيت المهيمنَ والبرايا","فشدّت نحوَ ساحتِك الرحال",65,"ل",1,0],["وأرضيت رب العالمين بطاعة","اطعت بها رب الورى متفردا",66,"د",2,0],["وأرضيت رب العرش في حفظ دينه","على الخلق والإسلام كاد بأن يثوى",67,"و",2,0],["وأرضعته بنو سعد فأسعدهم","حتى غدا الجدب مثل الخصب عندهم",68,"م",1,0],["وَاِرضَ الَّذي يَرضى وَقَدِّم أَمرَهُ","وَأَطِعهُ طاعَةَ مُقتَدٍ لِإِمامِ",69,"م",1,0],["وأرض بالله معينا","في شتاء ومصيف",70,"ف",1,0],["وارض تستقرّ وطود رضوى","وأجبال موثقة فساح",71,"ح",1,0],["وارضها كسماء في نضارتها","ونورها الشمرق الزاهي دراريها",72,"ي",3,0],["وأرضى باللظى مثوى","ووجهك جنة الخلد",73,"د",1,0],["وأرضٌ لِلهُدى فيها","ولِلمعروف أعوانُ",74,"ن",1,0],["وأرضٌ غد للوحي بين عِراصها","مجالٌ وللإسلام في أهلها نصر",75,"ر",1,0],["وَارْضَ يَا رَبَّنَا رِضىً غَيْرَ مَمْزُو","جٍ بِسُخْطٍ عَنِ الذِينَ حَمَوْهُ",76,"و",2,0],["وأرضى بأن الفى المنايا أو المنى","لديك وآمالي يضيقك وسعها",77,"ع",3,0],["وارضى على حكم الليالي فينثني","حسامي طام والوشيج ضئيل",78,"ل",1,0],["وأرضيك في الحالين أني مذنب","وأنك عثرات المسيء تقبل",78,"ل",1,0],["وأرضاك لي مولى مد الدهر مالكا","وما أنا عن هذا المقام ملول",78,"ل",1,0],["وارض لحكم الزمان حالا","وان عنا صرفه المبيح",79,"ح",1,0],["وارضي بما لجميعِ الناسِ فيه رِضاً","ولا تكوني مَلاكاً إننا بشر",80,"ر",1,0],["وارض بها للهاشميّ مآثر","يَعود عَلَينا خير تلك المآثر",81,"ر",1,0],["وَأَرضعَه ثُديَّ المجد دَرّاً","وآواه من العَلياء حضنا",82,"ن",2,0],["وارض التواضع خلقاً إنه خلق ا