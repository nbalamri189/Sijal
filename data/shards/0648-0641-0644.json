{"poems":[[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[63,"ومقيل عفر زرته ويد الردى","https://www.aldiwan.net/poem45885.html","الكامل"],[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[93,"من يبتني للعلم دارا إنما","https://www.aldiwan.net/poem11198.html","الكامل"],[93,"أوقد الصيف في الصعيد لظاه","https://www.aldiwan.net/poem11417.html","الخفيف"],[88,"وقفت على البسفور والريح عاصف","https://www.aldiwan.net/poem44421.html","الطويل"],[37,"وفليقا مل الشمال من الشو","https://www.aldiwan.net/poem7081.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[78,"يا قمرا أصبح لي مالكا","https://www.aldiwan.net/poem14254.html","السريع"],[85,"لما أتم نوح السفينه","https://www.aldiwan.net/poem8025.html","الرجز"],[85,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[66,"زمان الربيع","https://www.aldiwan.net/poem40962.html","المتقارب"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[69,"جهادك مقبول وعامك قابل","https://www.aldiwan.net/poem28976.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"هل عرفت الربع أجلى","https://www.aldiwan.net/poem65035.html","مجزوء الرمل"],[50,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[100,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[136,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[144,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[144,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[158,"هدية لأشبال فلسطين","https://www.aldiwan.net/poem23650.html","الخبب"],[170,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[230,"يا من حوى الفضل وحاز الفخرا","https://www.aldiwan.net/poem51069.html","الرجز"],[238,"بقبر الصعيدي فاستشفعن","https://www.aldiwan.net/poem19092.html","المتقارب"],[238,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[262,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[272,"بالابرق الفرد اطلال قديمات","https://www.aldiwan.net/poem52092.html","البسيط"],[272,"كلام بلا نحو طعام بلا ملح","https://www.aldiwan.net/poem52102.html","الطويل"],[323,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[378,"إني ودينك يا من جاد بالبعث","https://www.aldiwan.net/poem66896.html","البسيط"],[407,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[417,"على مثله تجري الدموع السواجم","https://www.aldiwan.net/poem54054.html","الطويل"],[417,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[433,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[433,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[440,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[440,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[440,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[440,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[444,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[454,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[459,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[465,"بكت وقد أبصرتني ضاحك الشعر","https://www.aldiwan.net/poem3471.html","عموديه"],[465,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[515,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[516,"يا أيها الملك الذي","https://www.aldiwan.net/poem12304.html","مجزوء الكامل"],[552,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[564,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"]],"verses":[["وَفَلَّلتَ مِن جَنَباتِ الخُطوبِ","بِعَزٍ إِذا جارَ دَهرٌ أَجارا",0,"ر",2,0],["وَفَلَلْتُ عَنْ بَقَرِ الصَّريمَةِ غَرْبَهُ","وَالرُّعْبُ أَقْمَأَ بِاللِّوى أَشْباحَها",1,"ح",3,0],["وفَلَيْتُ ناصِيَةَ الفَلا بمَناسِمٍ","وَسَمَ المَطِيُّ بِها جِباهَ البيدِ",2,"د",1,0],["وفَلَتْ بأيديهنَّ ناصِيةَ الفَلا","فشَكا الكَلالَ إِلى الأظَلِّ الكاهلُ",3,"ل",1,0],["وفَلَلْتَ منْ حدِّ الزّمانِ وإنّهُ","أوْحى وأمْضى منْ غِرارِ المُوسَى",4,"س",2,0],["وفُلَّتْ جُموعٌ ناصَبَتْكَ فإنّها","تُقارِعُ سيْفاً في يدِ الصَّمَدِ الوِتْرِ",5,"ر",1,0],["وَفَلاةٍ كَأَنَّها ظَهرُ تُرسٍ","قَد تَجاوَزتُها بِحَرفٍ نَعوبِ",6,"ب",1,0],["وَفَلاةٍ كَأَنَّها ظَهرُ تُرسٍ","لَيسَ إِلّا الرَجيعَ فيها عَلاقُ",7,"ق",1,0],["وَفَلاحُنَا بِتَكَاتُفِ الجِنْسَيْنِ فِي","أَدَبٍ يَزنْهُمَا وَفِي عُرْفَانِ",8,"ن",1,0],["وَفَلاَةٍ كَأَنَّمَا الرَّمْلُ فِيهَا","شَرَرٌ مُدَّ لَمْعَةً وَاضْطِرَامَا",9,"م",2,0],["وفلت له لا تَدن مني فإنني","بغيض إليّ الكاذب المتخرّص",10,"ص",1,0],["وفليقاً مِلْ الشمال من الشَّوْ","حط تُعطي وتمنع التوتيرا",11,"ر",2,1],["وفلتْهُم مُهنَّداتٌ حِدادٌ","تُحْسن الفَلْي عن سواءِ المفالي",12,"ل",2,0],["وفلاةٍ قطعتُها بفَلاةٍ","كاللِّياحِ الملمَّع الأزلام",13,"م",1,0],["وَفَلاةِ يَعفورٍ يَحارُ بِها القَطا","وَكَأَنَّما الهادي بِها مَأمومُ",14,"م",1,0],["وَفَلذَةَ الكبدِ الَّتي ضَمَّها","مَبيتُها الدهرَ بأوحالكا",15,"ك",2,0],["وَفَلَتِ الفَرخَةُ صوفَ الثَعلَبِ","وَتَيَّمَ اِبنَ عِرسَ حُبُّ الأَرنَبِ",16,"ب",1,0],["وَفَلَلنَ مِن ذاكَ اللِسانِ حَديدَةً","يَخشى لَئيمٌ بَأسَها وَوَقاحُ",17,"ح",1,0],["وفلسطين بينهم كمزادٍ","كل شارٍ يزيد حين يشاء",18,"ا",2,0],["وَفَلَّ الصَباحُ","جُيوشَ الظَلامِ",19,"م",1,0],["وَفَلَلتَ حَدَّ جُموعِهِم بِصَوارِمٍ","كَكَراكَ نافِرَةٍ عَنِ الأَجفانِ",20,"ن",1,0],["وفَلاةٍ أَبَداً ظامِئَةٍ","مُشْفِقٌ من قَطعِها العَوْدُ عَنود",21,"د",1,0],["وفلَّ قتالَ المشركينَ سيوفُكم","فما السيفُ إلا غمدُهُ والحمائلُ",22,"ل",1,0],["وَفلّاحُ مصرٍ كَم تَوالَت مَصائِبٌ","عَلَيهِ تَلقّى شَرَّها وَهوَ مُرغَمُ",23,"م",1,0],["وَفَلَّلَ حُبُّ الهامِ شَفرَةَ عَضبِهِ","وَإِن لَم تَزَل في كُلِّ يَومٍ تُواصِلُه",24,"ل",2,0],["وَفلَسطين لَن تَكون ضَحيه","قَبل أَن تَذهَب النُفوس ضَحيه",25,"ي",2,0],["وَفَلاةٍ يَستَفِزُّ الحَشا","مِن صُواها ضَبحُ بومٍ وَهام",26,"م",1,0],["وَفَلاةٍ عَمياءَ يَردى بِها السَفَ","رُ خَلاءٍ يَهابُها الجَنِيُّ",27,"ي",1,0],["وفُلكك يلقى الفلكَ في اليمّ من علٍ","كما يتَلاقَى سَيّدٌ ومَسود",28,"د",1,0],["وَفَلاةٍ أَلبَسَتها","ظُلمَةُ اللَيلِ جِلالا",29,"ل",2,0],["وَفَلاةٍ زَوراءَ تَلقى بِها العي","نَ رِفاضاً يَمشينَ مَشيَ النِساءِ",30,"ا",2,0],["وَفَلُّوا لِجَمْعِ التِّبْرِ صُمَّ صُخُورِهَا","وَأَيْسَرُ مَا فَلُّوهُ أَغْلَى مِنَ التِّبْرِ",31,"ر",1,0],["وَفَلَّ جَرْوَلُ غَرْبَ الزِّبْرِقَانِ بِهِ","فَبَاءَ مِنْهُ بِصَدْعٍ غَيْرِ مَجْبُورِ",32,"ر",1,0],["وفلولا تكابت الروح فيها","مثلما تكبت العجوز السعالا",33,"ل",2,0],["وفلسفةٌ أطلعتَ في الشعر نُورَها","هي اليومَ ثَكْلى عن جميلٍ تُناشد",34,"د",1,0],["وفلك جلّ عن حصرٍ فماذا","يقول العبد في بدءِ الأمالي",35,"ل",2,0],["وَفَلَّ شَبا المَواضي بِالمَواضي","وَلاقى بِالزَرافاتِ الجَحافِل",36,"ل",1,0],["وَفَلَلتَ غَربَ كَتيبَةٍ بِطَليعَةٍ","وَشَفَعتَ بِكرَ صَنيعَةٍ بِعَوانِ",37,"ن",1,0],["وَفِلِسْطِينُ انتَفَضَتْ أَبَدًا","تَحْيَا بِالقَلْبِ تُجَسُّدُنَا",38,"ن",2,0],["وَفَلَّلَ البِيضَ في الهاماتِ ضَربُهُمُ","مِن بَعدِ أَن أَنهَلُوها في المَكَرِّ دَما",39,"م",2,0],["وفلّ بالرأي العوالي السُمْرا","وصيَّر الجود عطايا تَتْرَى",40,"ر",2,0],["وَفُلْكُ افْتِقَارِي لِبَحْرِ اعْتِبَارِي","ثَوَى وَنَسِيمُ اصْطِبَارِي سَكَنْ",41,"ن",1,0],["وَفَلَّلَتْ شَبَاتَهُ","وَإِنَّهَا مَسْنُونَهْ",42,"ن",2,0],["وفل جيوش الجهل عنا بعلمه","وما زال فضل العلم للجهل غالبا",43,"ب",2,0],["وَفل شوكة أَهل الشرك مرتضيا","لِلَّه ربا فَما العزى وَما اللات",44,"ت",1,0],["وَفل جهادة اشوكة الشرك اذ دَعا","كباشجهاد المشركين الى الذبح",45,"ح",1,0],["وَفلاةٍ كَأَنَّها ظَهرُ تُرسٍ","عُودُهُ واحِدٌ قَديمُ المِطالِ",46,"ل",1,0],["وفل أعداءكم من حوالكم سرباً","وزان أسيافكم بالسل والمث",47,"ث",1,0],["وَفَلاً كَأعمار النسور مسحتها","بيد المَطِيَّة أَعيَت المُسّاحا",48,"ح",2,0],["وفلَّ قضاء الله شفرة صارم","أُقارع أعدائي به وأُصارم",49,"م",1,0],["وفلَّ الموت مضرب هندوانٍ","وأرزى بالحمائل والنجاد",50,"د",1,0],["وفلّ ما نصَبوا من زُورِ كيدِهِمُ","ربُّ به رُدَّ عنك النّصْبُ والنصَبُ",51,"ب",1,0],["وفلاةٍ قطعتُها بمطيٍّ","أربُ النفسِ لُفّ في توحيدِه",52,"د",2,0],["وفِلْذَةُ قَلبي فِي حِماها رَهِينَةً","وإنسانُ عَيْني فِي ذَراها مُخَيِّما",53,"م",2,0],["وفُلَّتْ ظُبى كُلِّ عَضْبٍ صقيلٍ","وَهُبَّتْ ذُرى كلِّ سُورٍ مَنيعِ",54,"ع",1,0],["وفلولُ من فات الفِرارَ بنفسِهِ","جاءَتْ يُعاجِلُها إِلَيْكَ فِرارُها",55,"ر",3,0],["وفَلَّ عَنِّيَ أَحزابَ العِدى مَلِكٌ","مُعَوَّدٌ أن يَفُلَّ الجحفلَ اللجِبا",56,"ب",2,0],["وفلدت جيدها عقدا ترفع عن","عقود در وياقوت ومرجان",57,"ن",1,0],["وفُلَيْح العوراء يشدو لديه","فيسنِّي حنينه وادكارهْ",58,"ر",2,0],["وفلسفة الأقدار ليس لها ونى","إذا حكمت لكنها تتهيأ",59,"ا",1,0],["وفلاةٍ تَرْهَبُ العيسُ بما","قلَّ تحقيقاً بها مضمونَها",60,"ن",3,0],["وفلَجَتْ حُجةُ فض","لي والزمانُ خصمي",61,"م",2,0],["وفلا عجاج الطَّرد عن نصرٍ إذا","ما كُرَّ طيبُ حديثهِ لم يُمْللِ",62,"ل",1,0],["وفلَّلت صبري الأيَّامُ جاهدةً","إن الفلول لحدِّ الصارم الذَّكرِ",63,"ر",1,0],["وفليتُ أحشاءَ البلاد وأهلها","حتى وجدتُ الصبح بين حنادس",64,"س",1,0],["وفلّقْتَ هاماتٍ به طالَ ما غدَتْ","متوّجةً في عِزّةِ الغَيِّ والكِبْرِ",65,"ر",1,0],["وف لي بعهدك إنني","لك فيه من أو في البريه",66,"ي",2,0],["وَفَلاحُ قلبٍ لا يُرجّى بعدما","وَلِيَتْ عليه الطّفلةُ المِغْناجُ",67,"ج",1,0],["وَفَلَّقَ فيهِم بَيضَةَ المَجدِ قاسِمٌ","فَناوَلَهُم قَيضاً وَناوَلَهُ المُحّا",68,"ح",2,0]]}