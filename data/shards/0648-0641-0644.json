https://www.poetsgate.com/ViewPoem.aspx?id=203499",""],[5616,"غفوة","https://www.poetsgate.com/ViewPoem.aspx?id=207671",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5739,"الصين والسور ..!","https://www.poetsgate.com/ViewPoem.aspx?id=135078",""],[5745,"من وحي مهرجان بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=200061",""],[5939,"اضرب كي تقطع رأس الأفعى","https://www.poetsgate.com/ViewPoem.aspx?id=136646",""],[6068,"فلسفة الغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178196",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["وَفَلَّلتَ مِن جَنَباتِ الخُطوبِ","بِعَزٍ إِذا جارَ دَهرٌ أَجارا",0,"ر",2,0],["وَفَلَلْتُ عَنْ بَقَرِ الصَّريمَةِ غَرْبَهُ","وَالرُّعْبُ أَقْمَأَ بِاللِّوى أَشْباحَها",1,"ح",3,0],["وفَلَيْتُ ناصِيَةَ الفَلا بمَناسِمٍ","وَسَمَ المَطِيُّ بِها جِباهَ البيدِ",2,"د",1,0],["وفَلَتْ بأيديهنَّ ناصِيةَ الفَلا","فشَكا الكَلالَ إِلى الأظَلِّ الكاهلُ",3,"ل",1,0],["وفَلَلْتَ منْ حدِّ الزّمانِ وإنّهُ","أوْحى وأمْضى منْ غِرارِ المُوسَى",4,"س",2,0],["وفُلَّتْ جُموعٌ ناصَبَتْكَ فإنّها","تُقارِعُ سيْفاً في يدِ الصَّمَدِ الوِتْرِ",5,"ر",1,0],["وَفَلاةٍ كَأَنَّها ظَهرُ تُرسٍ","قَد تَجاوَزتُها بِحَرفٍ نَعوبِ",6,"ب",1,0],["وَفَلاةٍ كَأَنَّها ظَهرُ تُرسٍ","لَيسَ إِلّا الرَجيعَ فيها عَلاقُ",7,"ق",1,0],["وَفَلاحُنَا بِتَكَاتُفِ الجِنْسَيْنِ فِي","أَدَبٍ يَزنْهُمَا وَفِي عُرْفَانِ",8,"ن",1,0],["وَفَلاَةٍ كَأَنَّمَا الرَّمْلُ فِيهَا","شَرَرٌ مُدَّ لَمْعَةً وَاضْطِرَامَا",9,"م",2,0],["وفلت له لا تَدن مني فإنني","بغيض إليّ الكاذب المتخرّص",10,"ص",1,0],["وفليقاً مِلْ الشمال من الشَّوْ","حط تُعطي وتمنع التوتيرا",11,"ر",2,1],["وفلتْهُم مُهنَّداتٌ حِدادٌ","تُحْسن الفَلْي عن سواءِ المفالي",12,"ل",2,0],["وفلاةٍ قطعتُها بفَلاةٍ","كاللِّياحِ الملمَّع الأزلام",13,"م",1,0],["وَفَلاةِ يَعفورٍ يَحارُ بِها القَطا","وَكَأَنَّما الهادي بِها مَأمومُ",14,"م",1,0],["وَفَلذَةَ الكبدِ الَّتي ضَمَّها","مَبيتُها الدهرَ بأوحالكا",15,"ك",2,0],["وَفَلَتِ الفَرخَةُ صوفَ الثَعلَبِ","وَتَيَّمَ اِبنَ عِرسَ حُبُّ الأَرنَبِ",16,"ب",1,0],["وَفَلَلنَ مِن ذاكَ اللِسانِ حَديدَةً","يَخشى لَئيمٌ بَأسَها وَوَقاحُ",17,"ح",1,0],["وفلسطين بينهم كمزادٍ","كل شارٍ يزيد حين يشاء",18,"ا",2,0],["وَفَلَّ الصَباحُ","جُيوشَ الظَلامِ",19,"م",1,0],["وَفَلَلتَ حَدَّ جُموعِهِم بِصَوارِمٍ","كَكَراكَ نافِرَةٍ عَنِ الأَجفانِ",20,"ن",1,0],["وفَلاةٍ أَبَداً ظامِئَةٍ","مُشْفِقٌ من قَطعِها العَوْدُ عَنود",21,"د",1,0],["وفلَّ قتالَ المشركينَ سيوفُكم","فما السيفُ إلا غمدُهُ والحمائلُ",22,"ل",1,0],["وَفلّاحُ مصرٍ كَم تَوالَت مَصائِبٌ","عَلَيهِ تَلقّى شَرَّها وَهوَ مُرغَمُ",23,"م",1,0],["وَفَلَّلَ حُبُّ الهامِ شَفرَةَ عَضبِهِ","وَإِن لَم تَزَل في كُلِّ يَومٍ تُواصِلُه",24,"ل",2,0],["وَفلَسطين لَن تَكون ضَحيه","قَبل أَن تَذهَب النُفوس ضَحيه",25,"ي",2,0],["وَفَلاةٍ يَستَفِزُّ الحَشا","مِن صُواها ضَبحُ بومٍ وَهام",26,"م",1,0],["وَفَلاةٍ عَمياءَ يَردى بِها السَفَ","رُ خَلاءٍ يَهابُها الجَنِيُّ",27,"ي",1,0],["وفُلكك يلقى الفلكَ في اليمّ من علٍ","كما يتَلاقَى سَيّدٌ ومَسود",28,"د",1,0],["وَفَلاةٍ أَلبَسَتها","ظُلمَةُ اللَيلِ جِلالا",29,"ل",2,0],["وَفَلاةٍ زَوراءَ تَلقى بِها العي","نَ رِفاضاً يَمشينَ مَشيَ النِساءِ",30,"ا",2,0],["وَفَلُّوا لِجَمْعِ التِّبْرِ صُمَّ صُخُورِهَا","وَأَيْسَرُ مَا فَلُّوهُ أَغْلَى مِنَ التِّبْرِ",31,"ر",1,0],["وَفَلَّ جَرْوَلُ غَرْبَ الزِّبْرِقَانِ بِهِ","فَبَاءَ مِنْهُ بِصَدْعٍ غَيْرِ مَجْبُورِ",32,"ر",1,0],["وفلولا تكابت الروح فيها","مثلما تكبت العجوز السعالا",33,"ل",2,0],["وفلسفةٌ أطلعتَ في الشعر نُورَها","هي اليومَ ثَكْلى عن جميلٍ تُناشد",34,"د",1,0],["وفلك جلّ عن حصرٍ فماذا","يقول العبد في بدءِ الأمالي",35,"ل",2,0],["وَفَلَّ شَبا المَواضي بِالمَواضي","وَلاقى بِالزَرافاتِ الجَحافِل",36,"ل",1,0],["وَفَلَلتَ غَربَ كَتيبَةٍ بِطَليعَةٍ","وَشَفَعتَ بِكرَ صَنيعَةٍ بِعَوانِ",37,"ن",1,0],["وَفِلِسْطِينُ انتَفَضَتْ أَبَدًا","تَحْيَا بِالقَلْبِ تُجَسُّدُنَا",38,"ن",2,0],["وَفَلَّلَ البِيضَ في الهاماتِ ضَربُهُمُ","مِن بَعدِ أَن أَنهَلُوها في المَكَرِّ دَما",39,"م",2,0],["وفلّ بالرأي العوالي السُمْرا","وصيَّر الجود عطايا تَتْرَى",40,"ر",2,0],["وَفُلْكُ افْتِقَارِي لِبَحْرِ اعْتِبَارِي","ثَوَى وَنَسِيمُ اصْطِبَارِي سَكَنْ",41,"ن",1,0],["وَفَلَّلَتْ شَبَاتَهُ","وَإِنَّهَا مَسْنُونَهْ",42,"ن",2,0],["وفل جيوش الجهل عنا بعلمه","وما زال فضل العلم للجهل غالبا",43,"ب",2,0],["وَفل شوكة أَهل الشرك مرتضيا","لِلَّه ربا فَما العزى وَما اللات",44,"ت",1,0],["وَفل جهادة اشوكة الشرك اذ دَعا","كباشجهاد المشركين الى الذبح",45,"ح",1,0],["وَفلاةٍ كَأَنَّها ظَهرُ تُرسٍ","عُودُهُ واحِدٌ قَديمُ المِطالِ",46,"ل",1,0],["وفل أعداءكم من حوالكم سرباً","وزان أسيافكم بالسل والمث",47,"ث",1,0],["وَفَلاً كَأعمار النسور مسحتها","بيد المَطِيَّة أَعيَت المُسّاحا",48,"ح",2,0],["وفلَّ قضاء الله شفرة صارم","أُقارع أعدائي به وأُصارم",49,"م",1,0],["وفلَّ الموت مضرب هندوانٍ","وأرزى بالحمائل والنجاد",50,"د",1,0],["وفلّ ما نصَبوا من زُورِ كيدِهِمُ","ربُّ به رُدَّ عنك النّصْبُ والنصَبُ",51,"ب",1,0],["وفلاةٍ قطعتُها بمطيٍّ","أربُ النفسِ لُفّ في توحيدِه",52,"د",2,0],["وفِلْذَةُ قَلبي فِي حِماها رَهِينَةً","وإنسانُ عَيْني فِي ذَراها مُخَيِّما",53,"م",2,0],["وفُلَّتْ ظُبى كُلِّ عَضْبٍ صقيلٍ","وَهُبَّتْ ذُرى كلِّ سُورٍ مَنيعِ",54,"ع",1,0],["وفلولُ من فات الفِرارَ بنفسِهِ","جاءَتْ يُعاجِلُها إِلَيْكَ فِرارُها",55,"ر",3,0],["وفَلَّ عَنِّيَ أَحزابَ العِدى مَلِكٌ","مُعَوَّدٌ أن يَفُلَّ الجحفلَ اللجِبا",56,"ب",2,0],["وفلدت جيدها عقدا ترفع عن","عقود در وياقوت ومرجان",57,"ن",1,0],["وفُلَيْح العوراء يشدو لديه","فيسنِّي حنينه وادكارهْ",58,"ر",2,0],["وفلسفة الأقدار ليس لها ونى","إذا حكمت لكنها تتهيأ",59,"ا",1,0],["وفلاةٍ تَرْهَبُ العيسُ بما","قلَّ تحقيقاً بها مضمونَها",60,"ن",3,0],["وفلَجَتْ حُجةُ فض","لي والزمانُ خصمي",61,"م",2,0],["وفلا عجاج الطَّرد عن نصرٍ إذا","ما كُرَّ طيبُ حديثهِ لم يُمْللِ",62,"ل",1,0],["وفلَّلت صبري الأيَّامُ جاهدةً","إن الفلول لحدِّ الصارم الذَّكرِ",63,"ر",1,0],["وفليتُ أحشاءَ البلاد وأهلها","حتى وجدتُ الصبح بين حنادس",64,"س",1,0],["وفلّقْتَ هاماتٍ به طالَ ما غدَتْ","متوّجةً في عِزّةِ الغَيِّ والكِبْرِ",65,"ر",1,0],["وف لي بعهدك إنني","لك فيه من أو في البريه",66,"ي",2,0],["وَفَلاحُ قلبٍ لا يُرجّى بعدما","وَلِيَتْ عليه الطّفلةُ المِغْناجُ",67,"ج",1,0],["وَفَلَّقَ فيهِم بَيضَةَ المَجدِ قاسِمٌ","فَناوَلَهُم قَيضاً وَناوَلَهُ المُحّا",68,"ح",2,0],["وفل شبا عضب يصمّم في العدا","بأَقطع من ماضي الغرارين بتار",69,"ر",1,0],["وفلاةٍ كأنما نشر اللي","لُ على ركبها جُناحَيْ غُداف",70,"ف",1,0],["وفل منها جموعاً وهي شامخةً","بلهذم ألحق الأشلاء بالشلل",71,"ل",1,0],["وفَلْسُ المرء جُنْدٌ وهو صَرْفٌ","ولم تقم الجنود بغير فلسِ",72,"س",1,0],["وفلل جمعهم بجنود رأي","تزيد على الجحافل والجنودِ",73,"د",1,0],["وَفلاةٍ قفرةٍ في بَطنِها","طائفُ الجنِّ يُغنّي ويرف",74,"ف",1,0],["وفلكُ نوحِ جرَتْ كذَاك بِه","في الماء والماءُ قدْ طَغَا وطَمَا",75,"م",2,0],["وفل جيوش الضلال وقد","أذلهم بالفنا واباد",76,"د",1,0],["وفلاةٍ فليتها بأمونٍ","ملّت البيدُ وخدها والذميلا",77,"ل",2,0],["وفلَّجن كالأُقحوانِ الثَّنايَا","وكحَّلن بالسِّحر منها الجُفونا",78,"ن",2,0],["وَفَلاة ذات أَكلٍ","لِلُّحومِ اليَعمُلاتِ",79,"ت",1,0],["وفُلك عليه كالعذارى مَوائس","خوافقُ أعلامٍ وميل قلوع",80,"ع",1,0],["وَفَلَّقْتَ هَامَ المُجرِمِينَ جَميِعَهَا","وَعَفَّرْتَهَا فِي غَورِهَا والشَّنَاخِبِ",81,"ب",1,0],["وَفَلاةٍ كَأَنَّها لُجّةُ اليم","م عَلَيها مِنَ السَرابِ أَياءُ",82,"ا",2,0],["وفلسطين مع شقيقتها الشا","م عليه تثني وتعلن شكره",83,"ر",2,0],["وفل عرى صبري وولت مسرتي","لفقد الذي هد الندى والمعاليا",84,"ي",2,0],["وفلسفةٌ تقوم على جمادٍ","أشال نشوءَه القومُ الرعاع",85,"ع",1,0],["وَفللت سَيفاً في يمين ابن نجدة","وَأَبرزت صلا مِن كَمينة أَرقم",86,"م",1,0],["وفلَّت ظبي قضبٍ لعدنان بتَكٍ","فردَّت ظباها ثلَّما للمغامدِ",87,"د",1,0],["وفل شوكة أهل الشرك مرتضياً","دين الحنيفة والأديان أشتات",88,"ت",1,0],["وَفَلَّ بِالسَيفِ لَمّا عَزَّ عُزّاها","كَم مِن مَفاخِرَ تُبنى في ذُرى الشَرَفِ",89,"ف",1,0],["وفُلّ جيش تَناهى في تألّبه","وَجاءَه النصر ينبي عَن تغلبه",90,"ه",1,0],["وفلك العرفان أمسي في دجى","فغير ذاك البدر لن يزينه",91,"ن",2,0],["وفل شباتهُم طوعا وكرها","بكل عرموم مجرٍ لهيم",92,"م",1,0],["وفلسفة ركنت إلى هداها","فكان بعطفها قيدى وحبسي",93,"س",2,0],["وفلَّقتُ أحشاءهُ خيفةً"