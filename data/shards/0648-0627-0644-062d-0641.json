{"poems":[[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[79,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[64,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[242,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[280,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[280,"قضى صادق الآثار في أمرك الأرضى","https://www.aldiwan.net/poem25491.html","الطويل"],[458,"أرقصي أيتها الأضواء","https://www.aldiwan.net/poem61391.html","مجزوء الرمل"],[469,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[563,"أنت هو الملفوظ واللافظ","https://www.aldiwan.net/poem34401.html","السريع"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203698","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136223","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79937","الخفيف"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76548","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135910","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135774","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135654","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45038","الطويل"],[4248,"","https://poetry.dctabudhabi.ae/diwan/poem/105549","الرجز"],[5039,"كتمه","https://www.poetsgate.com/ViewPoem.aspx?id=48137",""],[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5344,"البسمات غير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183173",""],[5769,"قبلتين وسجود","https://www.poetsgate.com/ViewPoem.aspx?id=215917",""]],"verses":[["وأُلْحِفُهُ البُرْدَ في شَتْوَةٍ","تَغُضّ الهَريرَ لَها الأكْلُبُ",0,"ب",1,0],["وَأَلْحَفَ مِنْكَ اللهُ أُمَّةَ أَحْمَدٍ","أَمَانَاً كَمَا يَضْفُو عَلَى الْغَادَةِ الْمِرْطُ",1,"ط",1,0],["وألحفتها خُضْرَ أوراقِها","مغذوَّةً بالحَلَبِ الأعذَبِ",2,"ب",1,0],["وَألحَفُوهُ بَيَاضَ الشَّحمِ فَوقَهُمَا","فَجَاء كَالخَمرِ تَلوِيناً وَلَم يَحُلِ",3,"ل",1,0],["وَالحَفِيدُ العَظِيمُ يَمَّمَهُ اليَوْمَ","فَثَنَى فَضَلاً بِفَضْلٍ فَخُلِّدْ",4,"د",1,0],["وَأَلْحَفَهَا مِنْ مَحاسِنِهِ","بُرُوداً حَكَتْ سُنْدُساً وَحَرِيرَا",5,"ر",2,0],["وأَلْحَفَ فِي الأَمانِ عَلَى اهْتِداءٍ","إِلَى اسْتِنقاذِ مَعْشَرِهِ الغَوِيِّ",6,"ي",1,0],["وَأَلْحَفْتهَا نُعْمَاكَ وَهْيَ مُطِيعَةٌ","رِدَاءً قَشِيبَا لا دَريساً وَلا رَحْضَا",7,"ض",2,0],["والحفيّ الموكب الس","ساني لشعب يتعبد",8,"د",1,0],["وألحفُه كلَّ فينانةٍ","نباتاً نظيماً ونوراً بدد",9,"د",1,0],["والحفظ والمأكول والآكل","والأكل والمجهوظ والجاهظ",10,"ظ",1,0],["والحفاة الأيتام حولي جياعٌ","والأيامى في غصة وانتحاب...",11,"ب",1,0],["والحفظ للمستوجبات اللاتي","قد قُررت يا صاح الإيمان",12,"ن",1,0],["والحفظ من شر الزمان وأهله","وبلائه والجبر للمكسور",13,"ر",1,0],["والحفيظُ العليمُ مَن في هداهُ","نابَ عن جدِّه الحفيظِ العليم",14,"م",1,0],["وَأُلحِفُها إِذا ما الكَلبُ وَلّى","بَراثِنَهُ وَجَبهَتَهُ الجَليدا",15,"د",2,0],["والحفر للرغيف والابانه","بمدية فهي له اهانه",16,"ه",1,0],["وَأَلحِف ثَراها في بِساطِ زَبَرجَدٍ","عَلَيهِ نُثارٌ مِن لُجَينٍ وَعِقيانِ",17,"ن",1,0],["والحفظِ في الأنفاس والأحبابِ","ونيلِ ما يؤدي لاقترابِ",18,"ب",1,0],["والحفظَ من كلِّ قريبٍ أو بعيدْ","وكل ذي وصفٍ لطيفٍ أو شديدْ",19,"د",1,0],["والحفظ من كل هزيزْ","في ذي الحياة والمماتْ",20,"ت",1,0],["والحفظَ دائماً مدى الدهورِ","ويومَ حشري وفي القُبُورِ",21,"ر",1,0],["وَأَلحَفَهُم ثَوبَ الحَنانِ وَمَن بِهِ","تَرَدّى فَلا يَخشى المَعَرَّةَ أَو يَعرى",22,"ر",2,0],["والحفظ او معرفة الخمسمائه","بدونه فرض لدا كل فئه",23,"ه",1,0],["والحفل عينك والمعازيم غرقا","ولحن الزمن غيرت عزفه ورتمه",24,"م",2,0],["والحفلُ مُزْدانٌ بِعُلماءِ العُلا","منْ كُلِّ أرضٍ جاءَ مَشرِقُهم هُدى",25,"د",2,0],["والحفظ وبكل محمودٍ يطال","يالعليم ويالمجيب ويالقدير..",26,"ر",1,0],["وأُلِحُّ في طلبي لها فتصدني","وكلَّما حاولتها زاد الجحودُ",27,"د",1,0]]}