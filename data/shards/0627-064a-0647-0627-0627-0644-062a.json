{"poems":[[93,"صاحت الضفضع لما شاهدت","https://www.aldiwan.net/poem62742.html","عموديه"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[76,"أيها التائه مهلا","https://www.aldiwan.net/poem13210.html","مجزوء الرمل"],[230,"نح كأس الغرام إني سقيت","https://www.aldiwan.net/poem55154.html","البسيط"],[473,"أيها التيس الذي ما","https://www.aldiwan.net/poem59560.html","مجزوء الرمل"],[473,"أيها التائه الذي","https://www.aldiwan.net/poem60371.html","مجزوء الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203794","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141250","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101026","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200926","الرمل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99459","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29301","الرمل"],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5638,"ملحمة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=199068",""],[6358,"دخان الخرائط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77584&r=&rc=43",""]],"verses":[["أَيُّها التاريخُ سَجِّل أَنَّنا","أُمَّةٌ قَد غَلَبَت حَتّى النُجوم",0,"م",1,0],["أَيُّها التاجِرُ بُلِّغتَ الأَرَب","طالِعُ التاجِرِ في حُسنِ الأَدَب",1,"ب",1,0],["أَيُّها التائِهُ مَهلا","ساءَني أَن تِهتَ جَهلا",2,"ل",2,1],["أيُّها التائهُ المُدلُّ علَينا","وَيكَ قُل لي من أَنتَ إنّي نَسيتُ",3,"ت",1,0],["أَيُّها التَيسُ الَّذي ما","مِثلُهُ في العالَمينا",4,"ن",2,1],["أَيُّها التائِهُ الَّذي","ضَلَّ عَمّا يُرادُ بِه",5,"ب",2,1],["أَيّها التاجُ لِأَبناءِ العُلى","مَن بهِ الدّهرَ سَما حَمدٌ وَمدحُ",6,"ح",1,0],["أيها التائهون في مهمه الأم","س سراب دروبكْم وشقاءُ",7,"ا",2,0],["أيها التاج ما لبستك إلا","وبرأسي بقية من خمار",8,"ر",1,0],["أيّها التائهون في الظلمات","أيها الغارقون في الشّهوات",9,"ت",1,1],["أيها التاركو الوزارة حيرى","تسأل الناس عن كفيء وأهل",10,"ل",1,0],["أيها التيس ولا تغضبْ","وخذ قولي وثيقة",11,"ق",2,1],["أيها التركي ما عن","دك للصب النحيل",12,"ل",1,1],["أَيُّها التائِهُ خَفِّف مِن خُطاك","إِنَّ في القَبرِ فُؤاداً ما سَلاك",13,"ك",1,1],["أيها التأريخ سجل ما تراه","ومُرِ المجد بأن يلقي سناه",14,"ا",2,1],["أيها التأريخ هذا موطني","وأنا إنسانهُ كلي فداه",14,"ا",2,0],["أيها التأريخ إني صوتهُ","أيقظتني من غشاواتي مُناه",14,"ا",2,0],["أيها التائهون عجباً لأن الشعب","..في محنة الظلام ... مقيد",15,"د",1,0],["أَيُّهَا التَّارِيخُ ذَكِّرْ","مَا لِمَوْتُورٍ رَجَاءْ",16,"ا",2,0],["أيها التايمز الجميل هذه ليست أغنيتي","أيتها البحار الهائجة هذه ليست سفني",17,"ي",1,1]]}