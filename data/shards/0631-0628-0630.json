{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[74,"رب ذي شرط على الخ","https://www.aldiwan.net/poem19459.html","مجزوء الرمل"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[93,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[51,"أي عيش يكون أبلغ من عي","https://www.aldiwan.net/poem62174.html","الخفيف"],[104,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[77,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85499","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62223","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[131,"طرقت أسيماء الرحال ودوننا","https://www.aldiwan.net/poem24275.html","الكامل"],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[203,"لمن الأمر غيره سبحانه","https://www.aldiwan.net/poem45163.html","الخفيف"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[556,"رب ذنب يضيق عن مسرح العذ","https://www.aldiwan.net/poem47201.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48876","الخفيف"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98088","الخفيف"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132902","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10422","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94144","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94093","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100390","المديد"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127379","الرمل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103513","المديد"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130390","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76444","الرمل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105563","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33066","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[4984,"منَّة رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=180976",""],[5596,"الخسارة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=206771",""],[5725,"أقل العثرة","https://www.poetsgate.com/ViewPoem.aspx?id=213611",""],[5948,"عِش بجَدِّ ولا يضركَ نَوك","https://www.poetsgate.com/ViewPoem.aspx?id=100589",""],[5309,"يا رعاة القلب ماذا ردكم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573664",""],[2696,"لأُصَرِّفَنّ سِوَى حُذَيْفَة َ مِدْحتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27410&r=&rc=14",""]],"verses":[["رُبَّ ذُنوبٍ لِلفَتى","لَيسَ لَها اليَومَ عِذَر",0,"ر",1,0],["رَبِذٍ يَداهُ بِالقِداحِ إِذا شَت","هَتّاكِ غاياتِ التِجارِ مُلَوَّمِ",1,"م",1,0],["رُبَّ ذي شرطٍ على الخ","دِّ وذي خالٍ ممسَّك",2,"ك",1,1],["ربّ ذي حاجةٍ أرقْتَ لها لَي","لاً طويلاً وباتَ ناعمَ بالِ",3,"ل",1,0],["رُبَّ ذي نعمةٍ هناك ومالٍ","تركوه مُحالفَ الإعدام",4,"م",1,0],["رُبَّ ذِهنٍ مِثلَ النَهارِ مُنيرٍ","صارَ بِالبُؤسِ كَالظَلامِ دَجِيّا",5,"ي",2,0],["رُبَّ ذي نِعمَةٍ تَعَرَّضَ مِنها","حائِلٌ بَينَهُ وَبَينَ المَساغِ",6,"غ",1,0],["رُبَّ ذكرى وما هجعتُ استحالتْ","لخيالٍ سَرَى فَأذْكى شجوني",7,"ن",2,0],["رَبِذاً فخَيْفاناً فيعبُوباً فذا","شِيَةٍ أغَرّ فمُنْعَلاً فمجنَّبا",8,"ب",2,0],["رب ذي علم قد أَصاب ثراء","بعد أَن كانَ بادي الإنفاض",9,"ض",1,0],["رَبِذٌ قَوَائِمُهُ سَرِيعٌ رَجْعُهُ","نَحَّى عَلَيْهِ رَاكِبٌ لَمْ يَنْعَسِ",10,"س",1,0],["رَبِذٍ يَداهُ بِالقِداحِ إِذا شَتا","هَتّاكِ غاياتِ التِجارِ مُلَوَّمِ",11,"م",1,0],["رُبَّ ذِي فِطْنَةٍ أَسَاءَ إِلَيْهِ","زَمَنٌ غَالِبٌ عَلَيْهِ الْفَسَادُ",12,"د",1,0],["رَبِذُ الخِلافِ إِذا اِتلَأَبَّ وَرِجلُهُ","في وَقعِها وَلَحاقِها تَحنيبُ",13,"ب",1,0],["رُبَّ ذِي هَمٍّ تَراهُ مُطرِقاً","وَهوَ في إِطراقِهِ حَيَّةُ وادِ",14,"د",1,0],["ربَّ ذي زينةٍ يميلُ على الأر","ض أرتنا أثوابهُ أكفانهْ",15,"ن",2,0],["ربِذٌ إذا ما الحُضْرُ زَلزلَ أَرضَه","أَهْوَى يَفوتُ النّاظرَ المُتَأمِّلا",16,"ل",2,0],["رَبذُ القِداحِ من الرِّماحِ وَمَا لَهُ","إِلّا السِّباعَ وطيْرَها أيسارُ",17,"ر",1,0],["ربّ ذنبٍ يضيق عن مَسرَحِ العُذ","ر وجانٍ لا صفحَ عن إجرامِهْ",18,"م",2,1],["رب ذكرى أعادت الميت حياً","في جديد الثياب من أكفانه",19,"ن",2,0],["رُبَّ ذي خُلَّةٍ تنسَّمَ لِقط","طِكَ سلحاً ونالَ عُرّاً وشَرّا",20,"ر",2,0],["رُبَّ ذنبٍ ينمِي على العُذرِ حَتَّى","يُبصِرُ الاحتياج عنه يشينُه",21,"ن",2,1],["رب ذي شق له في طرسه","خيلاء الفاتحين الثملين",22,"ن",1,0],["رَبِذُ القَوائِمِ حينَ يَندى عِطفُه","وَيَمورُ مِن بعدِ الحَميمِ حَميمُ",23,"م",1,0],["رَبِذٍ قَوائِمُهُ شَديدٍ أَسرُهُ","صَلتِ المُعَذَّرِ ذي سَبيبٍ ضافِ",24,"ف",1,0],["رب ذقن تقول قد ضر طولي","حيث أني اتصلت بالخصيتين",25,"ن",1,1],["رب ذئب قد دعوه باسم نور","إذ تبدت في البرايا شمس زوره",26,"ر",2,1],["رب ذي قرن يلوم فتى","واذا ما لام لم يلم",27,"م",1,0],["رب ذكرى من حبي","ب لحبيب لا يراه",28,"ه",1,0],["رب ذكرى كلما شط النوى","برحها ينسيك أحبابا وعهدا",29,"د",2,0],["رُبَّ ذي شبلين قَسوَرَةٍ","قد أَجَمَّ الحَينُ في أَجَمِه",30,"م",2,1],["رب ذي طمرين أشعث","يعتريه وصف غيره",31,"ر",2,1],["رب ذي نصح رمى أَخلاقكم","فاِنثَنَيتُم عنه تَرمون الحجر",32,"ر",1,0],["رب ذي جهلٍ يسمى عالماً","وهو لا يعرف قام أو قعد",33,"د",1,0],["ربذا يَدفق الحَياة عَلى الوا","دي وَيَستَن في الكَنانَة مَجرى",34,"ر",2,0],["رَبِذٌ إِذا عَرِقَت مَغابِنُهُ","ذَهَبَ السُكونُ وَأَقبَلَ العُنُفُ",35,"ف",1,0],["ربَّ ذكرى آلمت ثم شفت","فهي كالوردةِ أشواكاً ونشرا",36,"ر",2,0],["رب ذنوب كُفِّرت مِنَّة","ولم يكن منا لها جاحد",37,"د",1,0],["رُب ذي نُهيةٍ تنوّر فكراً","قاد اقوامه برأيٍ سديد",38,"د",1,0],["رب ذنب ماله من مخرجٍ","لكسيرٍ لم يقم من كبوةِ",39,"ه",1,0],["رُبَّ ذي أربة مقلٍ من الما","لً وذي عَنجهيةٍ محمودِ",40,"د",1,0],["رُبَّ ذِكرى قَرَّبَت مَن نَزَحا","قَسَماً ما حُلتُ عَن عَهدِكُمُ",41,"م",1,0],["ربذس قوائمهُ شديدٍ أسرهُ","صلتِ المعذَّرِ ذي بيبٍ ضافِ",42,"ف",1,0]]}