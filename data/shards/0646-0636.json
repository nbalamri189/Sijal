9.html","الطويل"],[459,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[459,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[462,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[462,"بقيت بهاء الدينِ ما وضح الضحى","https://www.aldiwan.net/poem15370.html","الطويل"],[462,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[462,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[462,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[465,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[465,"هذا فتى الزقزوق يرأف بالزرزور","https://www.aldiwan.net/poem3246.html","عموديه"],[465,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[465,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[515,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[515,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[539,"أتاك كما تأتي اللآلئ في العقد","https://www.aldiwan.net/poem48213.html","عموديه"],[541,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[552,"نضوت ثياب اللهو عني فقلصت","https://www.aldiwan.net/poem47235.html","الطويل"],[552,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[552,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[552,"يقولون لي لم أنت بالذل راكد","https://www.aldiwan.net/poem48107.html","الطويل"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[564,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[574,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"]],"verses":[["نَضَحنَ مِنَ الشَدِّ نَضحَ المَزادِ","ثُمَّ اِنطَلَقنَ اِنطِلاقَ العَزالي",0,"ل",2,0],["نَضَحَ الثَرى ذو أَنتَ فيهِ مُجَلجِلٌ","يَستَخلِفُ الأَكلاءَ بَعفَ المَقلَعِ",1,"ع",1,0],["نَضا عَنّي السَوادَ بِلا مُرادي","وَأَعطاني البَياضَ بِلا التِماسي",2,"س",2,0],["نَضَتهُ يَدُ الإِعتابِ عَمّا سَخَطتُهُ","كَما يُنتَضى العَضبُ الجُرازُ مِنَ الغِمدِ",3,"د",1,0],["نُضي فَقَضى حَقَّ الضَرائِبِ في الوَغى","وَأَثنَت عَلَيهِ حينَ رَدَّ المَغامِدُ",4,"د",1,0],["نَضَوتُ شَباباً لَم أَنَل فيهِ سُبَّةً","عَلى أَنَّ شَيطانَ البَطالَةِ مارِدُ",5,"د",1,0],["نُضي فَاِستَباحَ حِمى المُلهِياتِ","وَراعَ الغَواني بِظِفرٍ وَنابِ",6,"ب",1,0],["نُضِدَتْ عليهِ بَنيّةٌ منْ رَمْسِهِ","كالغِمْدِ مُشْتَمِلاً على الصّمصامِ",7,"م",1,0],["نضَبَ المَعينُ وقُلِّصَ الظلُّ الذي","ظَلْنا وَقوفاً عندَهُ وجُلوسا",8,"س",2,0],["نضَحْتُ على نِيرانِ قلْبي بقُرْبِهِ","ووسّدْتُهُ ما بيْنَ نحْري وساعِدي",9,"د",2,0],["نَضَدتَ رَياحينَ الطَلاقَةِ غَضَّةً","وَرَقرَقتَ ماءَ البِرِّ وَهوَ سَلاسِلُ",10,"ل",1,0],["نِضْوُ خُبْرٍ لَيْسَ يَفْتِنُهُ","زُخْرُفُ الدُّنْيَا وَلاَ يُصْبِي",11,"ب",2,0],["نَضَت في السُرى مِنها أَظَلّاً وَمَنسِما","بِزيزاءَ وَاِستَبقَت أَظَلّاً وَمَنسِما",12,"م",2,0],["نَضا البُردَ عَنهُ فَهوَ ذو مِن جُنونِهِ","أَجارِيِّ تَسهاكٍ وَصَوتٍ صُلاصِلِ",13,"ل",1,0],["نضت عن محيّاها النقاب عشيّةً","فأسفر صبح الحسن من كل جانب",14,"ب",1,0],["نضُرت هذه المدارس روضاً","من بني القوم مُنبتاً أزهارا",15,"ر",2,0],["نَضَختُ أدِيمَ الوُدِّ بَينِي وَبَينَهُم","بآصِرِةِ الأرحَامِ لَو يَتَبَلَّلُ",16,"ل",1,0],["نَضَوتُ عَلى الأَيّامِ ثَوبَ جَلادَتي","وَلَكِنَّني لَم أَنضَ ثَوبَ التَجَلُّدِ",17,"د",1,0],["نَضَعُ الخَطِّيَّ في أَكتافِكُم","حَيثُ نَهوى عَلَلاً بَعدَ نَهَل",18,"ل",1,0],["نِضْوَى سَقامٍ يقود ضعفُهما","له شدادَ القلوب مُقتَسره",19,"ر",2,0],["نَضّاخة بالطَل غير رامسه","والجدُّ عالٍ والكؤوس كائسه",20,"س",2,0],["نضْحٌ ونشحٌ يغمسانك في","فرحٍ ونُعم أيَّما غمس",21,"س",1,0],["نضحتَ بالماء في يومٍ وقد نفحت","في عامهِ كلِّه بالماء كفّاكا",22,"ك",2,0],["نضا الدهرُ عن أسآرها جُلَّ لونها","فغادرها من لونها في غلائلِ",23,"ل",1,0],["نُضْحِي له كقِداحٍ في يَدَيْ صَنَعٍ","فكُلُّنَا بينَ مَبْرِيٍّ ومسفون",24,"ن",1,0],["نِضْواً تراهُ إذا ما قام مُعْتَصِماً","بالأرضِ يَعْجِنُ منها شَرَّ معجون",24,"ن",1,0],["نَضا السُترُ عَن حَسَناتِ الوجودِ","وَكانَت كَأَسرارِهِ الموضمَرات",25,"ت",1,0],["نَضَت بُردَها عَن غُصنِ بان مُنَعَّمٍ","نَضيرٍ كَما اِنشَقّ الكِمامُ عَن الزَهرِ",26,"ر",1,0],["نَضْنَاضُ فَيْفَاءَ يَرَى أَنّهُ","بالرَّمْلِ غَانٍ وهُوَ المُرْمِلُ",27,"ل",1,0],["نَضَحتُ بِذِكراكُم حَرارَةَ قَلبِها","فَسارَت وَطولُ الأَرضِ في عَينِها شِبرُ",28,"ر",1,0],["نَضَبَ الفُراتُ وَكانَ بَحراً زاخِراً","وَاِسوَدَّ وَجهُ الرَقَّةِ البَيضاءِ",29,"ا",2,0],["نَضا السَيفَ حَتّى اِنقادَ مَن كانَ آبِياً","فَلَمّا اِستَقَرَّ الحَقُّ شيمَت مَضارِبُه",30,"ب",2,0],["نَضَبَت بَينَنا البَشاشَةُ وَالوُ","دُّ وَغارا كَما يَغورُ القَليبُ",31,"ب",1,0],["نَضَوتُ الصِبا نَضوَ الرِداءِ وَساءَني","مُضِيُّ أَخي أُنسٍ مَتى يَمضِ لا يَجي",32,"ج",2,0],["نَضَوتُ الأَسى عَنّي اِصطِباراً وَرُبَّما","أَسيتُ فَلَم أَصبِر وَلَم أَتَصَبَّرِ",33,"ر",1,0],["نَضيفَ نازِلَةً تَقري النَوالَ كَما","كُنّا نُزولاً عَلى الطائِيِّ أَضيافا",34,"ف",2,0],["نَضَوتَ الصَومَ وَاِستَبدَلتَ مِنهُ","هِلالَ الفِطرِ بورِكَ مِن هِلالِ",35,"ل",1,0],["نُضارُ الداعِرِيَّةِ إِنَّ مِنها","إِذا نُسِبَت أَسِرَّتُها نُضارا",36,"ر",2,0],["نَضَتِ البراقعَ عن مَحاسِنِ رَوْضَةٍ","ريضَتْ بمحتَفلِ الحَيا أنوارُها",37,"ر",3,0],["نضَّرْنَ وجهَ المكرُماتِ وطالما","سفرَتْ لنا عن حُرِّ وجهٍ شاحبِ",38,"ب",1,0],["نضا الكِبَرَ إلاّ على حاسدٍ","تُجاذِبُهُ حُلَّةُ الكِبرياءِ",39,"ا",2,0],["نضّر له الدنيا ومدَّ ربيعها","وانشره مؤتلقا بكل شعاع",40,"ع",1,0],["نضبت رحمة الوجود جميعاً","وبك الرحمة التي ليس تنضب",41,"ب",1,0],["نُضِيَت سُيوفُكَ لِلقِراعِ فَأُغمِدَت","وَالخُرَّمِيَّةُ كَيدُها مَخرومُ",42,"م",1,0],["نَضَوتَهُ دُلَفِيّاً مِن كِنانَتِهِ","فَأَصبَحَت فَوزَةُ العُقبى لَهُ هَدَفا",43,"ف",2,0],["نَضا ضَوءُها صِبغَ الدُجُنَّةِ فَاِنطَوى","لِبَهجَتِها ثَوبُ السَماءِ المُجَزَّعُ",44,"ع",1,0],["نَضَوتَ لَهُ رَأيَينَ سَيفاً وَمُنصَلاً","وَكُلٌّ كَنَجمٍ في الدُجُنَّةِ ثاقِبِ",45,"ب",1,0],["نَضيرٌ تَرى فيهِ أَساريعَ مائِهِ","صَبيحٌ تُغاديهِ الأَكُفُّ النَواعِمُ",46,"م",1,0],["نَضَحَ النَدى نُوّارَها فَكَأَنَّما","مَسَحَت مَعاطِفَها يَمينُ سَماحِ",47,"ح",1,0],["نُضِيَت يَوماً بِهِ ظُبَتا","مَشرَفِيٍّ لَيسَ بِالقَصِمِ",48,"م",1,0],["نَضِنُّ بهم أن يُفضَحوا في قُبورِهم","ونحمِي لهم مجداً قديما وسُؤْدُدا",49,"د",2,0],["نَضرةُ الأوطانِ في أفيائِهِ","وجَلالُ المُلكِ مِن نَعمائهِ",50,"ه",1,0],["نَضِنُّ بِمصرَ إن عَدَتِ العوادي","ولكنّا بأنفسنا نجودُ",51,"د",1,0],["نضِجُّ مُكبِّرين إذا رَمَيْنا","ونستبِقُ الجِنانَ إذا رُمِينا",52,"ن",2,0],["نُضَحِّي بالنّساءِ وبالذراري","ونَخرجُ والدّمُ الجاري يَسيلُ",53,"ل",1,0],["نَضَتِ المَنِيَّةُ عَنهُ ثَوبَ حَياتِهِ","ها إِنَّما ثَوبُ الحَياةِ مُعارُ",54,"ر",1,0],["نَضَيتُ لَهُ وَجهي وَعَزماً مُؤُيَّداً","أَراوِحُهُ حيناً وَحيناً أُوالِجُه",55,"ج",2,0],["نُضِحَتْ حرارَةُ قَلبِهِ بمَوَدّةٍ","ضَرَبتْ علَيهِ سُرادِقَ الإيمانِ",56,"ن",1,0],["نَضَحَتْ جوانحَكِ الرّياحُ بلؤلؤ","للطَّلِّ فيه رَدْعُ مِسْكٍ جائل",57,"ل",1,0],["نَضوا كلّ لَفْحٍ من غِرارِ مهنّدٍ","هو الجَمرُ إلاّ أنّه ليس يُنفَخ",58,"خ",1,0],["نَضَت عَنها القَميصَ لِصَبِّ ماءِ","فَوَرَّدَ وَجهَها فُرطُ الحَياءِ",59,"ا",2,1],["نُضَحي وَنُمسي كَبَني آدَمٍ","وَما عَلى الغَبراءِ إِلّا سَفيه",60,"ه",1,1],["نضَتْ فيصلاً من صقال السيوف","يُقَبِّلُ فيه الضحى شارِفَه",61,"ف",2,0],["نضبتْ في قدَحِ العمرِ الطِّلا","وهيَ في الأرواح تستهوي الشِّفاهْ",62,"ه",1,0],["نضَبَتْ خمْرُ بابلٍ","وهوى الكأسُ وانكسَرْ",63,"ر",1,0],["نَضَّروا الصَخرَ في رُؤوسِ الرَواسي","وَلَدَينا في مَوطِنِ الخِصبِ بورُ",64,"ر",1,0],["نُضَمِّخُ بالعَبيرِ له جَناحاً","أحَمَّ كأنّهُ طُلِيَ المِدادا",65,"د",2,0],["نَضَا عَنْهُ أَثْوَابَ الْفَنَاءِ وَرَفْرَفَتْ","إِلَى الْفَلَكِ الأَعْلَى بِهِ مُضوَاؤُهُ",66,"ا",3,0],["نضرَ الله عَهْدَهمْ وَسَقاهمْ","مَا سَقى الأوّلِينَ صَوْبُ العِهَادِ",67,"د",1,0],["نَضِجَتْ حِكْمَةُ الخَلاَئِقِ مِنْهَا","فِي أَوَانٍ بَدِيعَةِ الزِّينَاتِ",68,"ت",1,0],["نَضَى السِّتْرُ عَنْ جَلاَلِ امْرِىءِ","القَيْسِ بِسِفْرٍ مِنَ البَيَانِ جَليلِ",69,"ل",1,0],["نَضَتْ يَدُرَبِّ العَرْشِ عَنْهُ حِجَابَهُ","وَكَانَ عَلَى التِّمْثَالِ ظِلاًّ مِنَ الرَّدَى",70,"د",2,0],["نَضَّاحَةً مَاءَ قَارٍ","مَنْفُوخَةً كِبْريَاءَ",71,"ا",2,0],["نضيت موارده وجف أديمه","وتقلص الريان والمُعْشَوْشِبْ",72,"ب",1,0],["نَضَت الوقارَ عن الحياة","فما استقرّ له مكانْ!",73,"ن",1,0],["نَضْرَةٌ فِي أَزَاهِرِ الصُبْحِ تُمْسِي","بَعْدَ لأْيٍ تَصَوُّحاً وذُبُولاَ",74,"ل",2,0],["نِضْوُ السُّهاد أطال من إغفائه","وشفاه شافي المَوْتِ من بُرحائِهِ",75,"ا",3,1],["نضتْكَ لدَرْءِ الشرِّ عَضْباً \" صياقلٌ \"","أعَدَّتْ لِلُقْيا كلِّ مستكبرٍ عَضْبا",76,"ب",2,0],["نضت الروح وهزتها لواء","وكسته واكتست منه الدماء",77,"ا",2,1],["نضالِ المستبدِّ ، يَرى انكشافاً","عَمايتَه ، وعثرتَه سَدادا",78,"د",2,0],["نضجتْ بالصَّغار منهم جلودٌ","ولقد تنضج الجلودُ بِكَي",79,"ي",1,0],["نضا الستر عن حسنات الوجود","وكانت كأسراره المضمرات",80,"ت",1,0],["نضِّره له الدنيا ومد ربيعَها","وانشرهُ مؤتلقاً بكل شعاع",81,"ع",1,0],["نضحي على فرش الغرام كأننا","نمنا وللاشواق غير نيام",82,"م",1,0],["نضوت عني هموماً كنت ألبسها","مع الحياة فلي بالموت سلوان",83,"ن",1,0],["نُضرِمُ النارَ ولا","نَعلَمُ ما تَحوي القُدور",84,"ر",1,0],["نَضَتِ الأَجِلَّةَ وَالبَراقِعَ وَاِكتَسَت","مِمّا تُثيرُ بَراقِعاً وَجِلالا",85,"ل",2,0],["نَضَلَت مَأثُراتُهُ وَلُهاهُ","كُلَّ سَهمٍ أَعدَدتُهُ لِلنِضالِ",86,"ل",1,0],["نضا ثوب الكرى عن ناظريه","وبات يردّد الذّكر المبينا",87,"ن",2,0],["نضر إذا شئنا وننفع من نشا","ونولى الاباء الجعد والخلق البسطا",88,"ط",2,0],["نضرٌ كنانةٌ خزيمةُ السري","مدركةٌ إلياسُ بنُ مضرِ",89,"ر",1,0],["نضوٌ على رَمقٍ فان يعيشُ بهِ","لكنهُ رمقٌ مهما يعيش فاني",90,"ن",2,0],["نضارُ لمن يدهُ كالنحاس","ونارٌ لمن قلبه كالحديدِ",91,"د",1,0],["نضبَ الدمعُ بعدَ ما كانَ ينسا","بُ كما فاضَ في البلادِ النيلُ",92,"ل",1,0],["نَضوانَ من خمر الكَرى لحظُه","في قِتلتي فاقَ على الحدِّ",93,"د",1,0],["نَضُّ العَطاءِ إِلى مَوا","رِدِ جودِهِ تُنضى الرِكاب