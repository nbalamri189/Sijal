2,"على ميم وادي الرقمتين سلامي","https://www.aldiwan.net/poem16854.html","الطويل"],[347,"صفاء الذات منها إذا تجلت","https://www.aldiwan.net/poem15544.html","الوافر"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[351,"ألا يا قادما بالخير يسعى","https://www.aldiwan.net/poem40356.html","الوافر"],[351,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[362,"لي فرس صائم حكى فرس الشطرنج","https://www.aldiwan.net/poem60870.html","المنسرح"],[362,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[362,"أسائل عنها الركب وهي مع الركب","https://www.aldiwan.net/poem60986.html","الطويل"],[369,"بدائع من أفعالهن البدائع","https://www.aldiwan.net/poem57327.html","الطويل"],[390,"برئت من الأرجاس رهط امية","https://www.aldiwan.net/poem53633.html","الطويل"],[402,"ويوم جلا عنا ظلام همومنا","https://www.aldiwan.net/poem49507.html","الطويل"],[406,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[413,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[413,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[413,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[429,"أروه الجلنار من الخدود","https://www.aldiwan.net/poem12608.html","الوافر"],[429,"هون عليك وكن للخطب مصطبرا","https://www.aldiwan.net/poem12617.html","البسيط"],[434,"أيا شرف الدين الذي سوق يحده","https://www.aldiwan.net/poem2598.html","الطويل"],[436,"عمري لقد أعذر الدمع الذي وكفا","https://www.aldiwan.net/poem34796.html","البسيط"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[441,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[451,"إن نام أيار عن ورد وعدت به","https://www.aldiwan.net/poem61272.html","البسيط"],[451,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[456,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[456,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[459,"ألا من مبلغ عني هماما","https://www.aldiwan.net/poem15137.html","الوافر"],[462,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[512,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[536,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[538,"وإن الكريم من يكرم معسرا","https://www.aldiwan.net/poem56815.html","الطويل"],[549,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[549,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[549,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[549,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[549,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[549,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[573,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["وَما غَرَضي أَنّي أَسومُكَ خُطَّةً","كَفاني قَليلٌ مِن رِضاكَ كَفاني",0,"ي",1,0],["وَما غَمَراتُ المَوتِ إِلّا اِنغِماسَةٌ","وَلا ذي المَنايا غَيرُ تَهويمِ نائِمِ",1,"م",1,0],["وَما غَيرُ دارِ المَرءِ إِلّا مَذَلَّةٌ","وَلا غَيرُ قَومِ المَرءِ إِلّا فَواقِرُ",2,"ر",1,0],["وَما غابَ عَنّي وَجهُها مُذ رَأَيتُها","وَلا مالَ بي عَنها إِلى غَيرِها قَلبي",3,"ي",1,1],["وما غضّ منْ عالٍ جِنايةُ سافِلٍ","وأسْبابُ حُكْم اللهِ جلّتْ عنِ الحَصْرِ",4,"ر",1,0],["وَما غالَت قَريحَتَهُ اللَيالي","وَلا خانَتهُ ذاكِرَةُ الشَبابِ",5,"ب",1,0],["وَما غادَرتُ في السودانِ قَفراً","وَلَم أَصبُغ بِتُربَتِهِ أَديمي",6,"م",2,0],["وَما غادَرتَهُ حَتّى أَفاقوا","وَمِن أَمراضِ عَيشِهِمُ أَبَلّوا",7,"ل",3,0],["وما غرب بدر التمام","إلا خجل من طلعت",8,"ت",1,0],["وما غرّني ذو ظاهر متودّد","إذا كان فيه باطن متلصّص",9,"ص",1,0],["وَما غَرَّهُم مِن ثَأرِهِم عُقَدُ المُنى","وَلا عَقدَ إِلّا عَقدُ جارٍ مُشَمِّرِ",10,"ر",1,0],["وَما غَرَّ أَولادُ القُيونِ مُجاشِعاً","بِذي صَولَةٍ يَحمي العَرينَ المُمَنَّعا",11,"ع",2,0],["وما غُبن الأقوام مثلَ عقولهم","ولا مثلها كسباً أفاد كسوبُها",12,"ب",3,0],["وما غُيِّب الأقوام عن مثل خطة","تغيب عنها يوم قيلت أريبها",12,"ب",3,0],["وَما غَضَّ مِنِّيَ هَذا الإِسارُ","وَلكِن خَلَصتُ خُلوصَ الذَهَب",13,"ب",1,0],["وما غَرَّهم لا يَبْعَد اللَّهُ غيرَهُمْ","بليْثٍ على لجْبِ المحجَّة صائدِ",14,"د",1,0],["وما غاب عن مكنون صدرك غائب","وإن غاب عن عينيك يا ابنَ الأكارمِ",15,"م",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","غلى أُخْرى بمُعْتَدٍّ لئيما",16,"م",2,0],["وما غارمٌ حَصَّلَتْ كفُّهُ","له الحمدَ والأجرَ بالغارمِ",17,"م",1,0],["وما غُللتَ بِغُلِّ البُخْلِ عنْ كرم","وقد يُغَلُّ بغُلِّ البُخل أيمان",18,"ن",1,0],["وَما غُدانَةُ في شَيءٍ مَكانَهُمُ","أَلحابِسو الشاءِ حَتّى تَفضُلَ السُؤَرُ",19,"ر",1,0],["وَما غَرَّ كَلباً مِن كُلَيبٍ بِحَيَّةٍ","أَصَمَّ عَلى أَنيابِهِ السَمُّ شابِكِ",20,"ك",1,0],["وَما غَيرُ الشَآمِ وَساكِنيهِ","لَبانَتنا وَإِن بَعدَ الشَآمُ",21,"م",1,0],["وَما غَيرُ مَن قَد أَتى مُدبِرٌ","وَلا غَيرُ مَن قَد مَضى مُقبِلُ",22,"ل",1,0],["وَما غُلِبنا عَلى دَمعٍ وَلا جَلَدٍ","حَتّى أَتَتنا نَواكُم مِن صَياصينا",23,"ن",2,0],["وما غضَّ منك الحبسُ والذِكرُ سائرٌ","طليقٌ له في الخافقينَ ذَمِيلُ",24,"ل",1,0],["وما غاب حتى عيونُ العُلَى","تَفيضُ وأنفُسُها تهلعُ",25,"ع",1,0],["وما غابَ حتى طَبَّقَ الأرضَ جُودُهُ","ودانَ لنعماهُ مُقِرٌّ وجاحدُ",26,"د",1,0],["وَما غَرَّني حُسنُ المَبادي لِأَنَّهُ","مِنَ الدَهرِ مَحتومٌ بِسوءِ العَواقِبِ",27,"ب",1,0],["وَما غَيَّرَت مِنهُ الخِلافَةُ شيمَةً","وَقَد أَمكَنَتهُ عَنوَةً مِن قِيادِها",28,"د",3,0],["وَما غَلَبَتني نِيَّهُ الدارِ عِندَهُ","عَلى رِفدِهِ في ساحَتي وَاِصطِناعِهِ",29,"ع",2,0],["وَما غَرَّ الوِبارَ بَني كُلَيبٍ","بِغَيثي حينَ أَنجَدَ وَاِستَطارا",30,"ر",2,0],["وَما غَضِبَت لِلَّهِ أَيدي قَبيلَةٍ","عَلى مُشرِكٍ إِلّا الجُنَيدُ حُسامُها",31,"م",3,0],["وَما غابَ مَن يَقصو وَمَعناهُ حاضِرٌ","وَلازالَ مَن يَخفى وَآثارُهُ تَبدو",32,"د",2,0],["وَما غَيَّبَتهُ الأَرضُ إِلّا لِأَنَّها","لِأَقدامِهِ ما كانَ يُمكِنُها اللَثمُ",33,"م",1,0],["وما غنِموا إلّا مُنىً كَذبتْ لهم","وكان لهم بالقَصْرِ عن نَيلها قصرُ",34,"ر",1,0],["وما غَرَسَ الدَّهرُ في تُربَةٍ","غِراساً ولم يَجْنِ أثمارَهَا",35,"ر",3,0],["وَما غَيَّضَ السُلوانَ دَمعي وَإِنَّما","نَزَفتُ دُموعي في فِراقِ الصَواحِبِ",36,"ب",1,0],["وَما غَفلوا عَنِ الأَحقادِ تَغلي","مَراجِلُها وَما جَهلوا اليَقينا",37,"ن",2,0],["وما غال جيشَ الشرْق قبلَكَ غائلٌ","ولاسِيّما بعدَ العَطايا الجسائم",38,"م",1,0],["وما غاظ حُسّادي سوى الصدق وحده","وما من سَجايا مِثليَ الإفكُ والحُوب",39,"ب",1,0],["وما غَرّ نَفْساً سوَى نفسِها","وعُمْرُ الفتى من أماني الفتى",40,"ا",1,0],["وَما غَرَّكَ يا شاطِ","رُ مِنّي غَيرُ إِذعاني",41,"ي",1,0],["وما غلامٌ عشقتهُ زمناً","كأنّما البدر حلّ في حللِه",42,"ل",2,0],["وَما غَفَلاتُ العَيشِ إِلّا مَناحِسٌ","وَإِن ظَنَّ قَومٌ أَنَّهُنَّ سُعودُ",43,"د",1,0],["وَما غُذِيَ الأَميرُ كَما رَعاهُ","فَنيقُ الشَولِ مِن سَلَمٍ وَشِرسِ",44,"س",1,0],["وَما غَضَبي إِذا جَرَتِ القَضايا","بِتَفضيلِ اليَمينِ عَلى الشِمالِ",45,"ل",1,0],["وما غُبِنَ الغادي بها ولوَ انَّهُ","تملَّكَها عَيْنُ الدَّباةِ بمِثْقال",46,"ل",1,0],["وَمَا غي الهَدِيَّةِ عَارِيَّةٌ","بِهَا مَنْ يُقَدِّمُهَا يُوصَمُ",47,"م",1,0],["وَما غَرَّهَا مِنِّي افْتِرَارٌ وَإِنَّمَا","يَدُلُّ عَلَى اليَأْسِ انْكِشَافُ التَّصَنُّعِ",48,"ع",1,0],["وما غاندي بذي بطْش","ولا هو بالفتى الجلد",49,"د",1,0],["وما غاندي سوى عزم","من الصوَّان منقدِّ",49,"د",1,0],["وما غرني حسن المبادي نه","من الهر محتوم بسوء العواقب",50,"ب",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","إلى أُخْرى بمُعْتَدٍّ لئيما",51,"م",2,0],["وما غلاه موت ولا هاضه كرى","ولكن غدا من حلم ذا العيش صاحيا",52,"ي",2,0],["وما غلِطوا ورأَوا سفهَ الليالي","فداووْا بالجنون من الجنونِ",53,"ن",1,0],["وما غفلتْ أحراسُهم غير أنّنا","سقطنا عليهم مثلَما سقَط النَّدى",54,"د",2,0],["وَما غَمَدَ الظُبى حَتّى أَزالَت","جِبالاً لا تُحَرِّكُها الزَلازِل",55,"ل",1,0],["وما غاب من أحييت بالشبه ذكره","ولم يفقد الضرغام من وجد الشبلا",56,"ل",2,0],["وما غمضت استغفر الله مقلتي","نعم غمضت لكن على دمعة تجري",57,"ي",1,0],["وَما غُربَةٌ عِن دارِ ذُلٍّ بِغُربَةٍ","لَوَ اِنّ الفَتى أَكدى وَغَثَّت مَآكِلُه",58,"ل",2,0],["وما غيظي على الجهّال منهم","كما غيظي على أهل الأصول",59,"ل",1,0],["وما غَرَبَتْ نجومُ الأفْقِ لكنْ","نُقِلْنَ من السماءِ إلى الرياض",60,"ض",1,0],["وما غيرُ النفوسِ هي البرايا","وأنثاها أو الرجلِ الإهابُ",61,"ب",1,0],["وما غائبٌ مَن غاب وهو محافظٌ","وما زائرٌ مَن زارَ وهو على رَحلِ",62,"ل",1,0],["وما غَيرة العشّاق إلا وفاؤهم","وكلُّ محبٍّ لا يغار فلن يفي",63,"ف",2,0],["وما غبت عن عيني وان كنت غائبا","فشخصك في قلبي كأنك حاضر",64,"ر",1,0],["وما غاب عن عينيّ نور جبينها","وكان لروحي في الدياجير هاديا",65,"ي",2,0],["وما غذيت بغير لظى، فنارى","كمرتكم الغمامة ذي العفاء",66,"ا",2,0],["وما غرني مظهر كاذب","ولا كان من طبعيَ الاعتداء",67,"ا",2,0],["وما غدرتْ بك بل غدرُها","بمُهجتها وهيَ لم تَفهَمِ",68,"م",1,0],["وما غاب عن قلبي الرشادُ وطُرْقُه","ولكنْ حُسَامُ الحبِّ يَقْرَعُه قرعا",69,"ع",2,0],["وَما غردت وَرقاء في عذباتها","سحيرا عَلى غصن من الايك مائد",70,"د",1,0],["وَما غَرّاءُ سارِيَةٌ هَطُولٌ","تَبَجَّسُ بِانْسِفاحٍ وارْتِجاجِ",71,"ج",1,0],["وَما غدا ينشدُنا مُنشدٌ","يا عَينُ هَذا المُصطَفى أَحمَدُ",72,"د",1,0],["وما غردت ورق على غصن دوحة","وما لاح برق النجد جنح ظلام",73,"م",1,0],["وَما غابَت وَحَقِّكَ عَن عِياني","وَلا شاهَدتُ فيها غَيرَ ذاتي",74,"ت",2,0],["وَما غَدا في رَمَضانَ مُنزَلاً","وَما الَّذي أُنزِلَ قَبلُ في صَفَر",75,"ر",1,0],["وَما غَربت عَن الأَبصار شَمس","فَشَكّ الناظِرون بِأَن تَعودا",76,"د",2,0],["وَما غَضب الإِنسان إِلّا حَماقَةٌ","إِذا كانَ فيما لَيسَ لِلّه يَغضَبُ",77,"ب",1,0],["وما غَناءُ القريضِ في زمَني","وأيُّ ماءٍ يُصابُ في يَبَس",78,"س",1,0],["وما غَرَّ منّي القومَ حتّى تَألّبوا","سوى غَيْبتي عن رِحلةٍ هُم شُهودها",79,"د",3,0],["وما غَرَّني داعي الهوى غيرَ أنّني","نظَرْتُ فأصباني بعَينَيْه مَنْ يُصْبي",80,"ب",2,0],["وما غابَ عنَّا ما إِليه مَصيرُه","ونورُكَ فيه لا مَحالَةَ لامِعُ",81,"ع",1,0],["وَما غضبت الّا لأَصنامِها الَّتي","أُذِلَّت وَهم أَنصارُها لشقائِهِم",82,"م",1,0],["وما غضَّ من إسعافِنا بجميعِ","أرَدْناهُ إلاّ أّنَّهُ إذ حَلا خَلا",83,"ل",2,0],["وما غابَ مَن أُفْقَاهُ عَيني وخَاطِرِي","لهُ مَطلعُ مِن ذَا وفي تِلك مَغرِبُ",84,"ب",1,0],["وما غيرك المدعوُّ إن شبَّ جمرها","وأنشبَ نابُ الخطب فينا وظفره",85,"ر",2,0],["وما غِبتَ عنها حين غِبتَ حقيقة","وكيفَ ولم تخرج هنيهة من فكر",86,"ر",1,0],["وما غرَّني في الكون برق المطامع","إذا كانت العلياء حشو مسامعي",87,"ي",1,0],["وما غالتْ بك المُدَّاحُ حَمْداً","إذا ما فيك أطنَبَ ثمَّ غالى",88,"ل",2,0],["وما غرَسوا نخيلَ العيسِ إلا","وهمْ فيها من الطَلْعِ النضيد",89,"د",1,0],["وما غبَنْتَ بنجمٍ من بينكَ هوى","وقد بقيتَ مضيئاً أيها القمرُ",90,"ر",1,0],["وما غاية المثني وفيك خلائق","تقصّر عن أوصافهنّ الخلائقُ",91,"ق",1,0],["وَمَا غَناءُ دُموعِ العَيْنِ عن كَبِدٍ","حَرَّى ونِضْوٍ يُقاسِي الليلَ مُلْتَهِفا",92,"ف",2,0],["وَمَا غَدَا غيرَ كأْسِ المَدْحِ مُصطَبِحاً","وَلَمْ يَرُحْ غيرَ كأْسِ المَجْدِ مُغْتَبِقا",93,"ق",2,0],["وما غضبوا ولا عتبوا","وذاك دليل بأسهم",94,"م",1,0],["وما غنيت وحولي من موائدها","غنم ومن خمرها ريّ لظمآن",95,"ن",1,0],["وما غرامي بُشعطان يغازلها","تصَّوفت فوق أحلام لشطآن",96,"ن",1,0],["وما غيرُ مدحي طبَّق الأرض فيكُمُ","وإن كان مِلءَ الأرض ما قد مُدحتمُ",97,"م",1,0],["وما غشّ سمعَك أشنا إلي","ك من ناصح في الندى يعذلُ",98,"ل",1,0],["وما غادَيا أو راوحاك زيارةً","نراك بها مستبشرا ناعمَ البالِ",99,"ل",1,0],["وما غابَ عن دارِ العلا شخصُ هالكٍ","مضَى وبنوه الصالحون شُهودُ",100,"د",1,0],["وما غيرُ تأميلي بديني قضاؤه","فكم أتقاضاه وأنحتُ من جِلدي",101,"ي",1,0],["وما غالتْ هواي نوىً شَطونٌ","ولكن زادَ بُعْدي في ولوعي",102,"ع",2,0],["وما غضبي طعماً في النَّوال","ولكنَّهُ غضبٌ للغبن",103,"ن",1,0],["وما غَسْلُه بالماءِ إلّا تطوّعاً","وإلّا فَقولا لي متى نَجُسَ البحرُ",104,"ر",1,0],["وما غَرَّني إلا لكَونِي عَرفتُه","صديقَ أخي العلياءِ والعَلَم الفردِ",105,"د",1,0],["وَما غَيَّرتني ضَجرَةٌ عَن تَكَرُّمي","وَلا عابَ أَضيافي غِنايَ وَلا فَقري",106,"ي",1,0],["وما غُبِنّا بل اِنتمْ","بذاك أظهرُ غُبْنا",107,"ن",2,0],["وَما غاب إلّا أَحضر البدر وجهُهُ","وليس له في منتهى الهُشِّ قِسْمُهُ",108,"م",2,0],["وَما غاب وجهي عن مدى لَحْظِ طَرْفهِ","لَدى الخلق إلّا وهو عنّيَ سائلُ",109,"ل",1,0],["وَما غرّنِي إلّا مشيرٌ بمدحكمْ","وكم عارفٍ يقتادُهُ غيرُ عارفِ",110,"ف",1,0],["وَما غَبَطَ الحسَّادُ إلّا فضيلةً","وحسبُك مجداً أن تَرى لك غابطا",111,"ط",2,0],["وما غرّنِي من مومضٍ فيَّ مِدْحَةً","وَما غَرّت الأقوامَ إلّا المَدائحُ",112,"ح",1,0],["وَما غَرّكمْ إلّا التغافلُ عنكُمُ","عَلى ظالمٍ مِنكمْ لَدينا وعائثِ",113,"ث",1,0],["وَما غَرّني مِنها سلامةُ سالمٍ","فَكَمْ سالمٍ من حولِهِ أَلفُ عاطِبِ",114,"ب",1,0],["وما غزله إلا من العدم الذي","تقدر في العلم القديم له القدر",115,"ر",1,0],["وما غَدَرتْ ما أَخْلفَت ما تشَبَّهت","بِغَانيةٍ مَا كُلُّ غَانية هِنْدُ",116,"د",1,0]]}