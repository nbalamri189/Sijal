{"poems":[[53,"أيا جبلي نجد أبينا سقيتما","https://www.aldiwan.net/poem29656.html","الطويل"],[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[55,"وما غاب عني وجهها مذ رأيتها","https://www.aldiwan.net/poem26516.html","الطويل"],[77,"يحييك بالريحان والروح من قبر","https://www.aldiwan.net/poem36490.html","الطويل"],[86,"أيدري المسلمون بمن أصيبوا","https://www.aldiwan.net/poem10481.html","الوافر"],[86,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[86,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[83,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[88,"وقفت على البسفور والريح عاصف","https://www.aldiwan.net/poem44421.html","الطويل"],[27,"لقد سرني أن لا تعد مجاشع","https://www.aldiwan.net/poem5768.html","الطويل"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[47,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[51,"قصدت إليك لا أدلي بشيء","https://www.aldiwan.net/poem66295.html","الوافر"],[51,"تظلّم شِعري إلى القاسمِ","https://www.aldiwan.net/poem66302.html","المتقارب"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[29,"مالك عز التغلبي الذي له","https://www.aldiwan.net/poem6090.html","الطويل"],[91,"أطال الليل أم طال المقام","https://www.aldiwan.net/poem62708.html","عموديه"],[85,"أحيث تلوح المنى تأفل","https://www.aldiwan.net/poem62838.html","المتقارب"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[62,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[62,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[45,"أنبيك عن عيني وطول سهادها","https://www.aldiwan.net/poem63499.html","الطويل"],[45,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[28,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[28,"صل يا جنيد الخير لله صولة","https://www.aldiwan.net/poem5582.html","الطويل"],[66,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[66,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[105,"رويدك أيها الجبار فينا","https://www.aldiwan.net/poem43385.html","الوافر"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[48,"وشاعر ما يفيق من خطله","https://www.aldiwan.net/poem66556.html","المنسرح"],[46,"أودع يومي عالما إن مثله","https://www.aldiwan.net/poem22325.html","الطويل"],[46,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[46,"يلام الممسك الإعطاء حتى","https://www.aldiwan.net/poem23234.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[45,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""],[51,"قصدتُ إليك لا أُدْلي بشيءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30446",""]],"verses":[["وَما غَرَضي أَنّي أَسومُكَ خُطَّةً","كَفاني قَليلٌ مِن رِضاكَ كَفاني",0,"ي",1,0],["وَما غَمَراتُ المَوتِ إِلّا اِنغِماسَةٌ","وَلا ذي المَنايا غَيرُ تَهويمِ نائِمِ",1,"م",1,0],["وَما غَيرُ دارِ المَرءِ إِلّا مَذَلَّةٌ","وَلا غَيرُ قَومِ المَرءِ إِلّا فَواقِرُ",2,"ر",1,0],["وَما غابَ عَنّي وَجهُها مُذ رَأَيتُها","وَلا مالَ بي عَنها إِلى غَيرِها قَلبي",3,"ي",1,1],["وما غضّ منْ عالٍ جِنايةُ سافِلٍ","وأسْبابُ حُكْم اللهِ جلّتْ عنِ الحَصْرِ",4,"ر",1,0],["وَما غالَت قَريحَتَهُ اللَيالي","وَلا خانَتهُ ذاكِرَةُ الشَبابِ",5,"ب",1,0],["وَما غادَرتُ في السودانِ قَفراً","وَلَم أَصبُغ بِتُربَتِهِ أَديمي",6,"م",2,0],["وَما غادَرتَهُ حَتّى أَفاقوا","وَمِن أَمراضِ عَيشِهِمُ أَبَلّوا",7,"ل",3,0],["وما غرب بدر التمام","إلا خجل من طلعت",8,"ت",1,0],["وما غرّني ذو ظاهر متودّد","إذا كان فيه باطن متلصّص",9,"ص",1,0],["وَما غَرَّهُم مِن ثَأرِهِم عُقَدُ المُنى","وَلا عَقدَ إِلّا عَقدُ جارٍ مُشَمِّرِ",10,"ر",1,0],["وَما غَرَّ أَولادُ القُيونِ مُجاشِعاً","بِذي صَولَةٍ يَحمي العَرينَ المُمَنَّعا",11,"ع",2,0],["وما غُبن الأقوام مثلَ عقولهم","ولا مثلها كسباً أفاد كسوبُها",12,"ب",3,0],["وما غُيِّب الأقوام عن مثل خطة","تغيب عنها يوم قيلت أريبها",12,"ب",3,0],["وَما غَضَّ مِنِّيَ هَذا الإِسارُ","وَلكِن خَلَصتُ خُلوصَ الذَهَب",13,"ب",1,0],["وما غَرَّهم لا يَبْعَد اللَّهُ غيرَهُمْ","بليْثٍ على لجْبِ المحجَّة صائدِ",14,"د",1,0],["وما غاب عن مكنون صدرك غائب","وإن غاب عن عينيك يا ابنَ الأكارمِ",15,"م",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","غلى أُخْرى بمُعْتَدٍّ لئيما",16,"م",2,0],["وما غارمٌ حَصَّلَتْ كفُّهُ","له الحمدَ والأجرَ بالغارمِ",17,"م",1,0],["وما غُللتَ بِغُلِّ البُخْلِ عنْ كرم","وقد يُغَلُّ بغُلِّ البُخل أيمان",18,"ن",1,0],["وَما غُدانَةُ في شَيءٍ مَكانَهُمُ","أَلحابِسو الشاءِ حَتّى تَفضُلَ السُؤَرُ",19,"ر",1,0],["وَما غَرَّ كَلباً مِن كُلَيبٍ بِحَيَّةٍ","أَصَمَّ عَلى أَنيابِهِ السَمُّ شابِكِ",20,"ك",1,0],["وَما غَيرُ الشَآمِ وَساكِنيهِ","لَبانَتنا وَإِن بَعدَ الشَآمُ",21,"م",1,0],["وَما غَيرُ مَن قَد أَتى مُدبِرٌ","وَلا غَيرُ مَن قَد مَضى مُقبِلُ",22,"ل",1,0],["وَما غُلِبنا عَلى دَمعٍ وَلا جَلَدٍ","حَتّى أَتَتنا نَواكُم مِن صَياصينا",23,"ن",2,0],["وما غضَّ منك الحبسُ والذِكرُ سائرٌ","طليقٌ له في الخافقينَ ذَمِيلُ",24,"ل",1,0],["وما غاب حتى عيونُ العُلَى","تَفيضُ وأنفُسُها تهلعُ",25,"ع",1,0],["وما غابَ حتى طَبَّقَ الأرضَ جُودُهُ","ودانَ لنعماهُ مُقِرٌّ وجاحدُ",26,"د",1,0],["وَما غَرَّني حُسنُ المَبادي لِأَنَّهُ","مِنَ الدَهرِ مَحتومٌ بِسوءِ العَواقِبِ",27,"ب",1,0],["وَما غَيَّرَت مِنهُ الخِلافَةُ شيمَةً","وَقَد أَمكَنَتهُ عَنوَةً مِن قِيادِها",28,"د",3,0],["وَما غَلَبَتني نِيَّهُ الدارِ عِندَهُ","عَلى رِفدِهِ في ساحَتي وَاِصطِناعِهِ",29,"ع",2,0],["وَما غَرَّ الوِبارَ بَني كُلَيبٍ","بِغَيثي حينَ أَنجَدَ وَاِستَطارا",30,"ر",2,0],["وَما غَضِبَت لِلَّهِ أَيدي قَبيلَةٍ","عَلى مُشرِكٍ إِلّا الجُنَيدُ حُسامُها",31,"م",3,0],["وَما غابَ مَن يَقصو وَمَعناهُ حاضِرٌ","وَلازالَ مَن يَخفى وَآثارُهُ تَبدو",32,"د",2,0],["وَما غَيَّبَتهُ الأَرضُ إِلّا لِأَنَّها","لِأَقدامِهِ ما كانَ يُمكِنُها اللَثمُ",33,"م",1,0],["وما غنِموا إلّا مُنىً كَذبتْ لهم","وكان لهم بالقَصْرِ عن نَيلها قصرُ",34,"ر",1,0],["وما غَرَسَ الدَّهرُ في تُربَةٍ","غِراساً ولم يَجْنِ أثمارَهَا",35,"ر",3,0],["وَما غَيَّضَ السُلوانَ دَمعي وَإِنَّما","نَزَفتُ دُموعي في فِراقِ الصَواحِبِ",36,"ب",1,0],["وَما غَفلوا عَنِ الأَحقادِ تَغلي","مَراجِلُها وَما جَهلوا اليَقينا",37,"ن",2,0],["وما غال جيشَ الشرْق قبلَكَ غائلٌ","ولاسِيّما بعدَ العَطايا الجسائم",38,"م",1,0],["وما غاظ حُسّادي سوى الصدق وحده","وما من سَجايا مِثليَ الإفكُ والحُوب",39,"ب",1,0],["وما غَرّ نَفْساً سوَى نفسِها","وعُمْرُ الفتى من أماني الفتى",40,"ا",1,0],["وَما غَرَّكَ يا شاطِ","رُ مِنّي غَيرُ إِذعاني",41,"ي",1,0],["وما غلامٌ عشقتهُ زمناً","كأنّما البدر حلّ في حللِه",42,"ل",2,0],["وَما غَفَلاتُ العَيشِ إِلّا مَناحِسٌ","وَإِن ظَنَّ قَومٌ أَنَّهُنَّ سُعودُ",43,"د",1,0],["وَما غُذِيَ الأَميرُ كَما رَعاهُ","فَنيقُ الشَولِ مِن سَلَمٍ وَشِرسِ",44,"س",1,0],["وَما غَضَبي إِذا جَرَتِ القَضايا","بِتَفضيلِ اليَمينِ عَلى الشِمالِ",45,"ل",1,0],["وما غُبِنَ الغادي بها ولوَ انَّهُ","تملَّكَها عَيْنُ الدَّباةِ بمِثْقال",46,"ل",1,0],["وَمَا غي الهَدِيَّةِ عَارِيَّةٌ","بِهَا مَنْ يُقَدِّمُهَا يُوصَمُ",47,"م",1,0],["وَما غَرَّهَا مِنِّي افْتِرَارٌ وَإِنَّمَا","يَدُلُّ عَلَى اليَأْسِ انْكِشَافُ التَّصَنُّعِ",48,"ع",1,0],["وما غاندي بذي بطْش","ولا هو بالفتى الجلد",49,"د",1,0],["وما غاندي سوى عزم","من الصوَّان منقدِّ",49,"د",1,0],["وما غرني حسن المبادي نه","من الهر محتوم بسوء العواقب",50,"ب",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","إلى أُخْرى بمُعْتَدٍّ لئيما",51,"م",2,0]]}