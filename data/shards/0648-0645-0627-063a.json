www.poetsgate.com/ViewPoem.aspx?id=149398",""],[5112,"طارق","https://www.poetsgate.com/ViewPoem.aspx?id=212407",""],[5246,"إذا ندب الورقُ المغرد إلفَه","https://www.poetsgate.com/ViewPoem.aspx?id=187078",""],[5277,"حديث النفس","https://www.poetsgate.com/ViewPoem.aspx?id=187899",""],[5277,"عشريّة الطارمية","https://www.poetsgate.com/ViewPoem.aspx?id=205451",""],[5277,"كربٌ وبلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206649",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[5397,"أترقد عين الصب والنجم يسهر","https://www.poetsgate.com/ViewPoem.aspx?id=157961",""],[5431,"يضمك تحناني طويلا لتصبرا","https://www.poetsgate.com/ViewPoem.aspx?id=187842",""],[5431,"أيحتاج ماء الغيم إنْ ظلّ بي يُروى !!","https://www.poetsgate.com/ViewPoem.aspx?id=201461",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5431,"الحسين...","https://www.poetsgate.com/ViewPoem.aspx?id=215715",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5690,"تسامت بك الدنيا فأنت أميرُها","https://www.poetsgate.com/ViewPoem.aspx?id=172156",""],[5720,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=199858",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5877,"سوّد الله قلب جوالي","https://www.poetsgate.com/ViewPoem.aspx?id=37474",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5970,"يقولون في الصبر الجميل تعلة","https://www.poetsgate.com/ViewPoem.aspx?id=130657",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""],[231,"النفس الضائعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79122&r=&rc=8",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""]],"verses":[["وما غبطوا سوى غفلات دهر","مضت كأنامل تُثنى حسابا",0,"ب",2,0],["وَما غَرَضي أَنّي أَسومُكَ خُطَّةً","كَفاني قَليلٌ مِن رِضاكَ كَفاني",1,"ن",2,0],["وَما غَمَراتُ المَوتِ إِلّا اِنغِماسَةٌ","وَلا ذي المَنايا غَيرُ تَهويمِ نائِمِ",2,"م",1,0],["وَما غَيرُ دارِ المَرءِ إِلّا مَذَلَّةٌ","وَلا غَيرُ قَومِ المَرءِ إِلّا فَواقِرُ",3,"ر",1,0],["وَما غابَ عَنّي وَجهُها مُذ رَأَيتُها","وَلا مالَ بي عَنها إِلى غَيرِها قَلبي",4,"ب",2,1],["وما غضّ منْ عالٍ جِنايةُ سافِلٍ","وأسْبابُ حُكْم اللهِ جلّتْ عنِ الحَصْرِ",5,"ر",1,0],["وَما غالَت قَريحَتَهُ اللَيالي","وَلا خانَتهُ ذاكِرَةُ الشَبابِ",6,"ب",1,0],["وَما غادَرتُ في السودانِ قَفراً","وَلَم أَصبُغ بِتُربَتِهِ أَديمي",7,"م",2,0],["وَما غادَرتَهُ حَتّى أَفاقوا","وَمِن أَمراضِ عَيشِهِمُ أَبَلّوا",8,"ل",3,0],["وما غرب بدر التمام","إلا خجل من طلعت",9,"ت",1,0],["وما غرّني ذو ظاهر متودّد","إذا كان فيه باطن متلصّص",10,"ص",1,0],["وَما غَرَّهُم مِن ثَأرِهِم عُقَدُ المُنى","وَلا عَقدَ إِلّا عَقدُ جارٍ مُشَمِّرِ",11,"ر",1,0],["وَما غَرَّ أَولادُ القُيونِ مُجاشِعاً","بِذي صَولَةٍ يَحمي العَرينَ المُمَنَّعا",12,"ع",2,0],["وما غُبن الأقوام مثلَ عقولهم","ولا مثلها كسباً أفاد كسوبُها",13,"ب",3,0],["وما غُيِّب الأقوام عن مثل خطة","تغيب عنها يوم قيلت أريبها",13,"ب",3,0],["وَما غَضَّ مِنِّيَ هَذا الإِسارُ","وَلكِن خَلَصتُ خُلوصَ الذَهَب",14,"ب",1,0],["وما غَرَّهم لا يَبْعَد اللَّهُ غيرَهُمْ","بليْثٍ على لجْبِ المحجَّة صائدِ",15,"د",1,0],["وما غاب عن مكنون صدرك غائب","وإن غاب عن عينيك يا ابنَ الأكارمِ",16,"م",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","غلى أُخْرى بمُعْتَدٍّ لئيما",17,"م",2,0],["وما غارمٌ حَصَّلَتْ كفُّهُ","له الحمدَ والأجرَ بالغارمِ",18,"م",1,0],["وما غُللتَ بِغُلِّ البُخْلِ عنْ كرم","وقد يُغَلُّ بغُلِّ البُخل أيمان",19,"ن",1,0],["وَما غُدانَةُ في شَيءٍ مَكانَهُمُ","أَلحابِسو الشاءِ حَتّى تَفضُلَ السُؤَرُ",20,"ر",1,0],["وَما غَرَّ كَلباً مِن كُلَيبٍ بِحَيَّةٍ","أَصَمَّ عَلى أَنيابِهِ السَمُّ شابِكِ",21,"ك",1,0],["وَما غَيرُ الشَآمِ وَساكِنيهِ","لَبانَتنا وَإِن بَعدَ الشَآمُ",22,"م",1,0],["وَما غَيرُ مَن قَد أَتى مُدبِرٌ","وَلا غَيرُ مَن قَد مَضى مُقبِلُ",23,"ل",1,0],["وَما غُلِبنا عَلى دَمعٍ وَلا جَلَدٍ","حَتّى أَتَتنا نَواكُم مِن صَياصينا",24,"ن",2,0],["وما غضَّ منك الحبسُ والذِكرُ سائرٌ","طليقٌ له في الخافقينَ ذَمِيلُ",25,"ل",1,0],["وما غاب حتى عيونُ العُلَى","تَفيضُ وأنفُسُها تهلعُ",26,"ع",1,0],["وما غابَ حتى طَبَّقَ الأرضَ جُودُهُ","ودانَ لنعماهُ مُقِرٌّ وجاحدُ",27,"د",1,0],["وَما غَرَّني حُسنُ المَبادي لِأَنَّهُ","مِنَ الدَهرِ مَحتومٌ بِسوءِ العَواقِبِ",28,"ب",1,0],["وَما غَيَّرَت مِنهُ الخِلافَةُ شيمَةً","وَقَد أَمكَنَتهُ عَنوَةً مِن قِيادِها",29,"د",3,0],["وَما غَلَبَتني نِيَّهُ الدارِ عِندَهُ","عَلى رِفدِهِ في ساحَتي وَاِصطِناعِهِ",30,"ع",2,0],["وَما غَرَّ الوِبارَ بَني كُلَيبٍ","بِغَيثي حينَ أَنجَدَ وَاِستَطارا",31,"ر",2,0],["وَما غَضِبَت لِلَّهِ أَيدي قَبيلَةٍ","عَلى مُشرِكٍ إِلّا الجُنَيدُ حُسامُها",32,"م",3,0],["وَما غابَ مَن يَقصو وَمَعناهُ حاضِرٌ","وَلازالَ مَن يَخفى وَآثارُهُ تَبدو",33,"د",2,0],["وَما غَيَّبَتهُ الأَرضُ إِلّا لِأَنَّها","لِأَقدامِهِ ما كانَ يُمكِنُها اللَثمُ",34,"م",1,0],["وما غنِموا إلّا مُنىً كَذبتْ لهم","وكان لهم بالقَصْرِ عن نَيلها قصرُ",35,"ر",1,0],["وما غَرَسَ الدَّهرُ في تُربَةٍ","غِراساً ولم يَجْنِ أثمارَهَا",36,"ر",3,0],["وَما غَيَّضَ السُلوانَ دَمعي وَإِنَّما","نَزَفتُ دُموعي في فِراقِ الصَواحِبِ",37,"ب",1,0],["وَما غَفلوا عَنِ الأَحقادِ تَغلي","مَراجِلُها وَما جَهلوا اليَقينا",38,"ن",2,0],["وما غال جيشَ الشرْق قبلَكَ غائلٌ","ولاسِيّما بعدَ العَطايا الجسائم",39,"م",1,0],["وما غاظ حُسّادي سوى الصدق وحده","وما من سَجايا مِثليَ الإفكُ والحُوب",40,"ب",1,0],["وما غَرّ نَفْساً سوَى نفسِها","وعُمْرُ الفتى من أماني الفتى",41,"ا",1,0],["وَما غَرَّكَ يا شاطِ","رُ مِنّي غَيرُ إِذعاني",42,"ن",2,0],["وما غلامٌ عشقتهُ زمناً","كأنّما البدر حلّ في حللِه",43,"ل",2,0],["وَما غَفَلاتُ العَيشِ إِلّا مَناحِسٌ","وَإِن ظَنَّ قَومٌ أَنَّهُنَّ سُعودُ",44,"د",1,0],["وَما غُذِيَ الأَميرُ كَما رَعاهُ","فَنيقُ الشَولِ مِن سَلَمٍ وَشِرسِ",45,"س",1,0],["وَما غَضَبي إِذا جَرَتِ القَضايا","بِتَفضيلِ اليَمينِ عَلى الشِمالِ",46,"ل",1,0],["وما غُبِنَ الغادي بها ولوَ انَّهُ","تملَّكَها عَيْنُ الدَّباةِ بمِثْقال",47,"ل",1,0],["وَمَا غي الهَدِيَّةِ عَارِيَّةٌ","بِهَا مَنْ يُقَدِّمُهَا يُوصَمُ",48,"م",1,0],["وَما غَرَّهَا مِنِّي افْتِرَارٌ وَإِنَّمَا","يَدُلُّ عَلَى اليَأْسِ انْكِشَافُ التَّصَنُّعِ",49,"ع",1,0],["وما غاندي بذي بطْش","ولا هو بالفتى الجلد",50,"د",1,0],["وما غاندي سوى عزم","من الصوَّان منقدِّ",50,"د",1,0],["وما غرني حسن المبادي نه","من الهر محتوم بسوء العواقب",51,"ب",1,0],["وما غَيْثٌ إذا ما اجتازَ أرضاً","إلى أُخْرى بمُعْتَدٍّ لئيما",52,"م",2,0],["وما غلاه موت ولا هاضه كرى","ولكن غدا من حلم ذا العيش صاحيا",53,"ي",2,0],["وما غلِطوا ورأَوا سفهَ الليالي","فداووْا بالجنون من الجنونِ",54,"ن",1,0],["وما غفلتْ أحراسُهم غير أنّنا","سقطنا عليهم مثلَما سقَط النَّدى",55,"د",2,0],["وَما غَمَدَ الظُبى حَتّى أَزالَت","جِبالاً لا تُحَرِّكُها الزَلازِل",56,"ل",1,0],["وما غاب من أحييت بالشبه ذكره","ولم يفقد الضرغام من وجد الشبلا",57,"ل",2,0],["وما غمضت استغفر الله مقلتي","نعم غمضت لكن على دمعة تجري",58,"ر",2,0],["وَما غُربَةٌ عِن دارِ ذُلٍّ بِغُربَةٍ","لَوَ اِنّ الفَتى أَكدى وَغَثَّت مَآكِلُه",59,"ل",2,0],["وما غيظي على الجهّال منهم","كما غيظي على أهل الأصول",60,"ل",1,0],["وما غَرَبَتْ نجومُ الأفْقِ لكنْ","نُقِلْنَ من السماءِ إلى الرياض",61,"ض",1,0],["وما غيرُ النفوسِ هي البرايا","وأنثاها أو الرجلِ الإهابُ",62,"ب",1,0],["وما غائبٌ مَن غاب وهو محافظٌ","وما زائرٌ مَن زارَ وهو على رَحلِ",63,"ل",1,0],["وما غَيرة العشّاق إلا وفاؤهم","وكلُّ محبٍّ لا يغار فلن يفي",64,"ف",2,0],["وما غبت عن عيني وان كنت غائبا","فشخصك في قلبي كأنك حاضر",65,"ر",1,0],["وما غاب عن عينيّ نور جبينها","وكان لروحي في الدياجير هاديا",66,"ي",2,0],["وما غذيت بغير لظى، فنارى","كمرتكم الغمامة ذي العفاء",67,"ا",2,0],["وما غرني مظهر كاذب","ولا كان من طبعيَ الاعتداء",68,"ا",2,0],["وما غدرتْ بك بل غدرُها","بمُهجتها وهيَ لم تَفهَمِ",69,"م",1,0],["وما غاب عن قلبي الرشادُ وطُرْقُه","ولكنْ حُسَامُ الحبِّ يَقْرَعُه قرعا",70,"ع",2,0],["وَما غردت وَرقاء في عذباتها","سحيرا عَلى غصن من الايك مائد",71,"د",1,0],["وَما غَرّاءُ سارِيَةٌ هَطُولٌ","تَبَجَّسُ بِانْسِفاحٍ وارْتِجاجِ",72,"ج",1,0],["وَما غدا ينشدُنا مُنشدٌ","يا عَينُ هَذا المُصطَفى أَحمَدُ",73,"د",1,0],["وما غردت ورق على غصن دوحة","وما لاح برق النجد جنح ظلام",74,"م",1,0],["وَما غابَت وَحَقِّكَ عَن عِياني","وَلا شاهَدتُ فيها غَيرَ ذاتي",75,"ت",2,0],["وَما غَدا في رَمَضانَ مُنزَلاً","وَما الَّذي أُنزِلَ قَبلُ في صَفَر",76,"ر",1,0],["وَما غَربت عَن الأَبصار شَمس","فَشَكّ الناظِرون بِأَن تَعودا",77,"د",2,0],["وَما غَضب الإِنسان إِلّا حَماقَةٌ","إِذا كانَ فيما لَيسَ لِلّه يَغضَبُ",78,"ب",1,0],["وما غَناءُ القريضِ في زمَني","وأيُّ ماءٍ يُصابُ في يَبَس",79,"س",1,0],["وما غَرَّ منّي القومَ حتّى تَألّبوا","سوى غَيْبتي عن رِحلةٍ هُم شُهودها",80,"د",3,0],["وما غَرَّني داعي الهوى غيرَ أنّني","نظَرْتُ فأصباني بعَينَيْه مَنْ يُصْبي",81,"ب",2,0],["وما غابَ عنَّا ما إِليه مَصيرُه","ونورُكَ فيه لا مَحالَةَ لامِعُ",82,"ع",1,0],["وَما غضبت الّا لأَصنامِها الَّتي","أُذِلَّت وَهم أَنصارُها لشقائِهِم",83,"م",1,0],["وما غضَّ من إسعافِنا بجميعِ","أرَدْناهُ إلاّ أّنَّهُ إذ حَلا خَلا",84,"ل",2,0],["وما غابَ مَن أُفْقَاهُ عَيني وخَاطِرِي","لهُ مَطلعُ مِن ذَا وفي تِلك مَغرِبُ",85,"ب",1,0],["وما غيرك المدعوُّ إن شبَّ جمرها","وأنشبَ نابُ الخطب فينا وظفره",86,"ر",2,0],["وما غِبتَ عنها حين غِبتَ حقيقة","وكيفَ ولم تخرج هنيهة من فكر",87,"ر",1,0],["وما غرَّني في الكون برق المطامع","إذا كانت العلياء حشو مسامعي",88,"ي",1,0],["وما غالتْ بك المُدَّاحُ حَمْداً","إذا ما فيك أطنَبَ ثمَّ غالى",89,"ل",2,0],["وما غرَسوا نخيلَ العيسِ إلا","وهمْ فيها من الطَلْعِ النضيد",90,"د",1,0],["وما غبَنْتَ بنجمٍ من بينكَ هوى","وقد بقيتَ مضيئاً أيها القمرُ",91,"ر",1,0],["وما غاية المثني وفيك خلائق","تقصّر عن أوصافهنّ الخلائقُ",92,"ق",1,0],["وَمَا غَناءُ دُموعِ العَيْنِ عن كَبِدٍ","حَرَّى ونِضْوٍ يُقاسِي الليلَ مُلْتَهِفا",93,"ف",2,0],["وَمَا غَدَا غيرَ كأْسِ المَدْحِ مُصطَبِحاً","وَلَمْ يَرُحْ غيرَ كأْسِ المَجْدِ مُغْتَبِقا",94,"ق",2,0],["وما غضبوا ولا عتبوا","وذاك دليل بأسهم",95,"م",1,0],["وما غنيت وحولي من موائدها","غنم ومن خمرها ريّ لظمآن",96,"ن",1,0],["وما غرامي بُشعطان يغازلها","تصَّوفت فوق أحلام لشطآن",97,"ن",1,0],["وما غيرُ مدحي طبَّق الأرض فيكُمُ","وإن كان مِلءَ الأرض ما قد مُدحتمُ",98,"م",1,0],["وما غشّ سمعَك أشنا إلي","ك من ناصح في الندى يعذلُ",99,"ل",1,0],["وما غادَيا أو راوحاك زيارةً","نراك بها مستبشرا ناعمَ البالِ",100,"ل",1,0],["وما غابَ عن دارِ العلا شخصُ هالكٍ","مضَى وبنوه الصالحون شُهودُ",101,"د",1,0],["وما غيرُ تأميلي بديني قضاؤه","فكم أتقاضاه وأنحتُ من جِلدي",102,"د",2,0],["وما غالتْ هواي نوىً شَطونٌ","ولكن زادَ بُعْدي في ولوعي",103,"ع",2,0],["وما غضبي طعماً في النَّوال","ولكنَّهُ غضبٌ للغبن",104,"ن",1,0],["وما غَسْلُه بالماءِ إلّا تطوّعاً","وإلّا فَقولا لي متى نَجُسَ البحرُ",105,"ر",1,0],["وما غَرَّني إلا لكَونِي عَرفتُه","صديقَ أخي العلياءِ والعَلَم الفردِ",106,"د",1,0],["وَما غَيَّرتني ضَجرَةٌ عَن تَكَرُّمي","وَلا عابَ أَضيافي غِنايَ وَلا فَقري",107,"ي",1,0],["وما غُبِنّا بل اِنتمْ","بذاك أظهرُ غُبْنا",108,"ن",2,0],["وَما غاب إلّا أَحضر البدر وجهُهُ","وليس له في منتهى الهُشِّ قِسْمُهُ",109,"م",2,0],["وَما غاب وجهي عن مدى لَحْظِ طَرْفهِ","لَدى الخلق إلّا وهو عنّيَ سائلُ",110,"ل",1,0],["وَما غرّنِي إلّا مشيرٌ بمدحكمْ","وكم عارفٍ يقتادُهُ غيرُ عارفِ",111,"ف",1,0],["وَما غَبَطَ الحسَّادُ إلّا فضيلةً","وحسبُك مجداً أن تَرى لك غابطا",112,"ط",2,0],["وما غرّنِي من مومضٍ فيَّ مِدْحَةً","وَما غَرّت الأقوامَ إلّا المَدائحُ",113,"ح",1,0],["وَما غَرّكمْ إلّا التغافلُ عنكُمُ","عَلى ظالمٍ مِنكمْ لَدينا وعائثِ",114,"ث",1,0],["وَما غَرّني مِنها سلامةُ سالمٍ","فَكَمْ سالمٍ من حولِهِ أَلفُ عاطِبِ",115,"ب",1,0],["وما غزله إلا من العدم الذي","تقدر في العلم القديم له القدر",116,"ر",1,0],["وما غَدَرتْ ما أَخْلفَت ما تشَبَّهت","بِغَانيةٍ مَا كُلُّ غَانية هِنْدُ",117,"د",1,0],["وَما غَيرُكُم وَاللَهِ إِلّا أُصولَكُم","نُخبِرُ عَنهُم لا حَديثاً مُرَجَّما",118,"م",2,0],["وَما غابَةٌ لَفتٌ بأحقُبَ قاربٍ","يُزَمجِرُ في أحشائِها وَيُزَمزِم",119,"م",1,0],["وَما غِروٌ غِنايَ بِها وَسَرّي","وَإن لَم اُغنَ مِنكَ فَذاكَ غَروُ",120,"و",1,0],["وَما غامَت سَماءُ نَداهُ إلاَّ","هَمَت بِالبِرِّ مِن هُنّا وَهُنّا",121,"ن",2,0],["وَما غَدَت أَلسُن البشرى مؤرّخة","محمد صالح في الخَير قَد وُلدا",122,"د",2,0],["وما غَيَّرَ الحال في حكمها","ولكنه غَيَّرَ الحاكمينا",123,"ن",2,0],["وما غضبت لغير اللّه منتقماً","وما قهرت سوى القوم الألى حقدوا",124,"د",3,0],["وما غضبت لنفسي في مساورة","لكنه لبلادي ذلك الغضب",125,"ب",1,0],["وما غلظت ولكني رأيتهمُ","صبوا المصائب حتى ضجت الدولُ",126,"ل",1,0],["وما غُسِلوا بالماءِ بل بدمائهمْ","وما حُنِّطوا إِلا منْ التُّرْبِ لا العطر",127,"ر",1,0],["وَما غايَةُ التعذيبِ عِندي وكنْهُه","سِوى قَرنِ ذي علمٍ بغمرٍ أخي جهلِ",128,"ل",1,0],["وما غرّني من حسنهِ بِجمالهِ","ولكنّني بالسرّ مِن حسنهِ أدرى",129,"ر",2,0],["وما غرَّني أفعالُه غيرَ أنني","سمعت له قولاً وأعجبني جسما",130,"م",2,0],["وما غرَّني جهل ولكن أُبوَّةٌ","رَعَيتُ لها حَقَّ المكانَة والبر",131,"ر",1,0],["وما غيرنا يأسو كلوم مُهزم","مريح إلى سعي بنا غيرُ مخفق",132,"ق",1,0],["وما غَرّني إلا لدانة مَنطق","ورقةُ ألفاظِ وحَسنُ خطاب",133,"ب",1,0],["وما غَرَّ الغواةُ بعنبسيٍّ","يُشرِّدُ عن فرائسِهِ السَّباعا",134,"ع",2,0],["وما غادروه غيرَ إلفِ صبابةٍ","وجفنٍ قريحٍ هامعِ الدمع هاملِ",135,"ل",1,0],["وما غرّني ذكرى حبيبي عن النوى","بلى إِنَّ نقع الغيث في الجدب ظاهرُ",136,"ر",1,0],["وما غاب من أبىق بدوراً طوالعاً","بأنوارها في حالك الخطب يهتدى",137,"د",2,0],["وما غربت إلا وأبدت صفاتها","بدور أمدت بالسنا كل طالع",138,"ع",1,0],["وما غاظها غير أن الامام","علياً علا جده المقبل",139,"ل",1,0],["وَما غَضَبُ الإِنسانُ مِن غَيرِ قُدرَةٍ","سِوى نَهكَةً في جِسمِهِ وَشُحوبِ",140,"ب",1,1],["وَما غالبتهُ مُنذُ كانَ كَتيبَةٌ","لِتظهِرَهُ إِلّا وَكانَ لَهُ الغَلبُ",141,"ب",1,0],["وما غَيَّرْتُ ما أُبْ