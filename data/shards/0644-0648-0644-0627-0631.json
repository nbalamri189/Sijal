{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[63,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[154,"يا نازحا عني ولو","https://www.aldiwan.net/poem68492.html","مجزوء الكامل"],[164,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[303,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[333,"طال الطريق فمن يقول لسادر","https://www.aldiwan.net/poem54951.html","الكامل"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[409,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[409,"لولا الرجا ما انتهضت إرادة","https://www.aldiwan.net/poem34171.html","الرجز"],[416,"هاجت هواك بواكر الأظعان","https://www.aldiwan.net/poem67466.html","الكامل"],[438,"شق الكمال عليه جيب سواده","https://www.aldiwan.net/poem12595.html","الكامل"],[443,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[545,"عوجا على ربع ليلى أم محمود","https://www.aldiwan.net/poem56853.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86867","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48677","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48593","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63740","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6753","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49977","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50014","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115867","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35817","المنسرح"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111779","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108953","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101067","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105428","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46438","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53201","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60826","البسيط"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33930","السريع"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129875","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34740","البسيط"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79715","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100828","البسيط"],[3232,"","https://poetry.dctabudhabi.ae/diwan/poem/100431","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123878","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74075","السريع"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108060","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108065","الكامل"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125771","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132097","الكامل"],[3791,"","https://poetry.dctabudhabi.ae/diwan/poem/145991","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133215","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136550",""],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4578,"أآهدي إليَّ تفضلاً تمثالهُ","https://www.poetsgate.com/ViewPoem.aspx?id=49508",""],[4984,"هي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=175730",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5022,"غن الهو","https://www.poetsgate.com/ViewPoem.aspx?id=201037",""],[5026,"مستقلون على عجلة الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=213501",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[2365,"من غاله حدث أو خانه زمن","https://www.poetsgate.com/ViewPoem.aspx?id=200667",""],[5410,"زفرة","https://www.poetsgate.com/ViewPoem.aspx?id=133059",""],[2546,"حَقُّ الذي يعشقُ نفسينِ أن","https://www.poetsgate.com/ViewPoem.aspx?id=17200",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5956,"سُوَرُ الغَزَل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182264",""],[5956,"لولا ريالُك","https://www.poetsgate.com/ViewPoem.aspx?id=183705",""],[5956,"مقدمة عن فن الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185693",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"أرجوك لا تمرض","https://www.poetsgate.com/ViewPoem.aspx?id=193797",""]],"verses":[["لَولا رِجالٌ تَغالَوا في سِياسَتِهِم","مِنّا وَمِنهُم لَما لُمنا وَلا عَتَبوا",0,"ب",3,0],["لولا ربيعُ نَوالِكَ الغَمرِ النَّدى","ما كانَ يَذهَلُ عن ربيعِ ديارِه",1,"ر",2,0],["لولا رَجاءُ لِقائِيها لَمَا تَبِعَتْ","عَنْسي دَليلاً كَسِرّ الغِمدِ إصْلِيتا",2,"ت",2,0],["لولا رسول الله فيهم بادوا","وأصبحوا يرويهم العبادُ",3,"د",1,0],["لَولا رِياحُ رِياحٍ لَم أَكُ أمتَطي","ذا الأَخضَرَ الطامي وَذاكَ الأَحوَصا",4,"ص",2,0],["لولا رجاءُ لقائكم","من بعدها لأرقته",5,"ت",2,0],["لولا رجاءٌ وآمالٌ تحدثُني","بما يهّونُ عني بعضَ ما وَقَعِا",6,"ع",2,0],["لَولاَ رَجَاؤُكَ لَم أسِر مِن بِيشةٍ","عَرضَ العِرَاقِ بِفِتيَةٍ وَرَواحِلِ",7,"ل",1,0],["لولا رياضُ الشعرِ في صحرائها","كانتْ جياتُك محنةً وَشدائدا",8,"د",2,0],["لولا رجائي فيك قل تصبّري","وقطعت حبل شقاوتي لولاكا",9,"ك",2,0],["لولا رجاءٌ وخوفٌ منك مُقتَسَمٌ","ما كان عن ذنْبه دهرٌ بمُعْتَذِر",10,"ر",1,0],["لولا رجائي ثانياً للقائهِ","ما كنتُ أحيا ساعةً في نائه",11,"ا",3,1],["لولا رسائلك التي فعلت بنا","فعل المدام ولم تكن بمدام",12,"م",1,0],["لولا رجا الإِنسان أجر فعله","ما قام يوماً للصلاة أو مشى",13,"ا",1,0],["لَولا رَجاؤُكَ ما تَخَطَّت ناقَتي","عَرضَ الدَبيلِ وَلا قُرى نَجرانِ",14,"ن",1,0],["لولا رجاءٌ في رجاءٍ ما اعتلى","للشّرْعِ ضوءُ عَمودِ وعِمادِه",15,"د",2,0],["لولا رجائي فيك لم يبق الهوى","والشوق فيّ بقيّة لتجلّد",16,"د",1,0],["لوْلا رِواياتُ الهَوى عن أهلِه","لمْ يَروِ طَرفي الدّمعَ عن إنسانهِ",17,"ن",2,0],["لَولا رَجاؤُكَ لَم تَعسِف بِنا قُلصٌ","أَجوازَ مَهمَهَةٍ قَفرِ الصَّوى بيدِ",18,"د",1,0],["لولا رجائي للإمام الهادي","أن ينقم الثار من الأعادي",19,"ي",1,0],["لَولا رَجا الراجين أَنك قادم","بِالنَصر وَالبُشرى وَجَبر كَسير",20,"ر",1,0],["لولا رضاك عن البلاد وأهلها","فارقتها غضبان وهي حبائبي",21,"ب",2,0],["لولا رضاك بهم وعهدك فيهمُ","ملأ الحمى المتطيرون شكوكا",22,"ك",2,0],["لولا رياضتُها لعقلك ما","سُمِّيتَ ربَّ الشعر والشعرى",23,"ر",2,0],["لولا رياسَتُكُمْ وما دَبَّرْتُمُ","فينا لضاعَ مُدبِّرٌ ومدبَّر",24,"ر",1,0],["لولا رق الخصر منه حكما","بانطلاق المدمع المنحبسِ",25,"س",1,0],["لَولا رَجاءُ العَفوِ كُنتُ كَناقِعٍ","بَرحَ الغَليلِ بِرَشفِ لَمعِ الآلِ",26,"ل",1,0],["لولا رجاء كان يمنح خاطري","وعدي يعود لقاءه مستَبشِرا",27,"ا",1,0],["لولا رجاءَ دنوٍ من أحبّتنا","بغير حُزْنٍ على الأَطلال من إبلِ",28,"ل",1,0],["لولا رجاءُ لقائِكم","ودُنُوُّ دارِكمُ لذابا",29,"ب",2,0],["لَولا رَجاءُ الإِيابِ لَاِنصَدَعَت","قُلوبُنا بَعدَهُ مِنَ الحَزَنِ",30,"ن",1,0],["لولا رسالات الكحيل وحقكم","لخلعت في ستر الغرام عذارا",31,"ر",2,0],["لولا رواسخ حلم منه تمسكه","مادت لهيبته أرسى رواسيه",32,"ي",2,0],["لولا رجال النيل أع","وز كل مقتات طحينه",33,"ن",2,0],["لولا رضاهم بما الرحمن قدره","عليهم لم يروا تلك المقاديرا",34,"ر",2,0],["لَولا رَقيبٌ لِلمُروءة ممسكٌ","لي عَن هَجا مَن لَيسَ مِن أَكفائي",35,"ا",2,0],["لولا رحيل دُماك ما أدمى الأسى","قلباً يقلبه جوى وغرام",36,"م",1,0],["لولا رِضاك لأمْستْ أمَّةٌ بَدداً","لازلتَ تجمعُ شمْلَ الأُمة البددِ",37,"د",1,0],["لَولا رَجئي العَطفَ مِن سَيِّدي","بَقيتُ بَينَ البابِ وَالدارِ",38,"ر",1,0],["لولا رجاء تلمحي من نورهم","يحيى الفؤاد بسيره وطروقه",39,"ق",2,0],["لولا رسولُ اللّه لم ندرِ الهدى","وبهِ غدا نرجو النجاة ونسعَدُ",40,"د",1,0],["لولا ربيحةُ ما استأنستُ ما عمدت","نفسي إليك ولو مُثّلت من طينِ",41,"ن",1,0],["لولا رجائي في ودادك والوفا","لكرهت عيشي في الهوى ومقامي",42,"م",2,0],["لولا رضاك بما في القلب من ألم","لما رضيت بجرح غير مندمل",43,"ل",1,0],["لولا رسيس هوى له يقتادني","ما اقتادني حلو اللمى حمر الوجن",44,"ن",1,0],["لولا رجالٌ من مرينٍ رفّعوا","منكم لكنْتم بالحضيض الأوهدِ",45,"د",1,0],["لولا رجالٌ من مرينٍ قاتلوا","عنكم لكنتم كالنساءِ الخرّدِ",45,"د",1,0],["لولا رجاء أبي الفوارس لم أزل","ما بين ظفر للخطوب وناب",46,"ب",1,0],["لَولا رَباب وَنزار وَما","يَبتَغيان وَيريدانِ",47,"ن",1,0],["لولا رشاً حاضرٌ في الربع يشبهه","لكان قلبي على هجرانه احترقا",48,"ق",2,0],["لولا رجائي في قريب لقائه","لنظمتُ يوم فراقه ديوانا",49,"ن",2,0],["لولا رجائي بربي التقيك لما","رغبتُ في العيش والدنيا واهليها",50,"ي",3,0],["لولا رفيقك ما شردت عن الهدى","فلقد عرفتك طاهر الأعراق",51,"ق",1,0],["لولا رجاء البرء ما أرجأتها","من بعد ما سبقت عتاق الفره",52,"ه",1,0],["لولا رجائي بأن الله يحفظه","لقطّعت بيد الأشواق أكبادي",53,"د",2,0],["لولا رواقُ ظلام الليل ما قربت","من التي كان ضوء الصبح يزجرها",54,"ر",3,0],["لَولا رَجاؤُكَ لَمْ أَبْرَحْ عَلى يَأَسٍ","يا رَبّ فَاجْعَلْ رَجائِي غَيْرَ مُنْعَكِسٍ",55,"س",1,0],["لولا رسائله الحسان قضى أمى","صبٌّ بحسن في الهوى أقوالهُ",56,"ل",2,0],["لولا رسمت لهذا الشعر غايته","يغنيك أصلحه عن درب ما فسدا",57,"د",2,0],["لولا رسالته الأخلاق ما كملت","وما تميّز طبع الناس من غنم",58,"م",1,0],["لولا رسالته لم تأتنا قصص","للآخرين ولم نحفظ لماضين",59,"ن",1,0],["لولا رياحُك عن سُليْمانَ انَثَنتْ","ما استرفدَ النملُ البريء وما انثَنى",60,"ن",2,0],["لَولَا رِجَالٌ مُخلِصُونَ عَلَى ثَرَى","مِصرَ الأَبِيَّةِ ، لَاْنقَضَتْ أَحلَامُ",61,"م",1,0],["لولا رجاؤك لم تشسع بطيتنا","مرو ولم يترك الأهلون والوطن",62,"ن",1,0],["لولا ربيع الحبّ في قلبي","ما كنت أحلم بالندى الرطِبِ",63,"ب",1,0],["لولا رجائي العطفَ من سَيِّدي","بقيتُ بين البابِ والدَّارِ",64,"ر",1,0],["لولا رسالتُهُ ما فازَ مجتهدٌ","تنجو بها أممٌ والكونُ قد غرقا",65,"ق",2,0],["لولا رأيتِ يدي معْنَ بنِ زائدة","لم تستميتي لحجبي عن صداقاتي",66,"ت",2,0],["لولا ريالُكِ يا رياض لما بنى ال","مظلوم داراً أو كسا أولادَهُ",67,"د",2,1],["لولا رأيتُ الفنَّ جبرياً سرى","في العقل والنجوى لَرُمْتُ تقاعدي..",68,"د",2,0],["لولا رباطي فيكَ أنكَ مرَّةً","ساعدْتَني -عجباً- هوايَ يبيدُ",69,"د",1,0],["لولا رحيقُ العمر في الأدواءِ لم","نمكث طويلاً في الضُّحَى الوهَّاجِ",70,"ج",1,0]]}