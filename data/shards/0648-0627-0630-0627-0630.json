{"poems":[[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[93,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[27,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[72,"يوم الوفا يا سيد الأحباب","https://www.aldiwan.net/poem18248.html","الكامل"],[91,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[70,"أحبابنا أزف الرحي","https://www.aldiwan.net/poem43038.html","مجزوء الكامل"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[28,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[28,"نام الخلي وما أغمض ساعة","https://www.aldiwan.net/poem5624.html","الكامل"],[58,"ما غاض دمعي عند نازلة","https://www.aldiwan.net/poem31191.html","أحذ الكامل"],[49,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[49,"اصبر لكل مصيبة وتجلد","https://www.aldiwan.net/poem62041.html","الكامل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[31,"أأقام أمس خليطنا أم سارا","https://www.aldiwan.net/poem42537.html","الكامل"],[52,"يا من أراه لج في طيرانه","https://www.aldiwan.net/poem26820.html","الكامل"],[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[19,"أبا دليجة من لحي مفرد","https://www.aldiwan.net/poem361.html",""],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85348","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20984","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[94,"دمعة على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=12814",""],[91,"العيون السود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67806&r=&rc=90",""],[156,"لم أمش في طرق العزاء لأنني","https://www.aldiwan.net/poem55628.html","الكامل"],[181,"وإذا ذكرتك لم أجد لك وحشة","https://www.aldiwan.net/poem4118.html","الكامل"],[224,"أبى الحظ إلا أن يصارعني دهري","https://www.aldiwan.net/poem41876.html","الطويل"],[224,"أودك جاحظة المقلتين","https://www.aldiwan.net/poem41903.html","المتقارب"],[321,"اشكر لتوكيل البحيرة مصطفى","https://www.aldiwan.net/poem67205.html","الكامل"],[367,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[417,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[430,"عج بالديار وحي ذاك المعهدا","https://www.aldiwan.net/poem41428.html","الكامل"],[459,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[459,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[462,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[501,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[552,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[552,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[552,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[559,"وإذا ذات كل شيء تبدت","https://www.aldiwan.net/poem34338.html","الخفيف"],[559,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"]],"verses":[["وَإِذَا ذُكِرْتَ كَأَنَّ هَبَّاتِ الصَّبَا","رَكَدَ الْكَبَاءُ بِجَوِّهَا والْمَنْدَلُ",0,"ل",1,0],["وَإِذا ذو الفُضولِ ضَنَّ عَلى المَو","لى وَصارَت لِخَيمِها الأَخلاقُ",1,"ق",1,0],["وَإِذَا ذَكَرْتَ فِدَى سَعِيدٍ مِنْهُمُ","وَضَحَتْ صَحِيفَتُهُمْ مِن العُنْوَانِ",2,"ن",1,0],["وَإِذا ذَكَرتُكُمُ شَدَدتُم قُوَّتي","وَإِذا نَزَلتُ بِغَيثِكُم كانَ الحَيا",3,"ا",1,0],["وإذا ذكرت الصاحب النائي فقل","عقبى اللقا يا سيد الأصحاب",4,"ب",1,0],["وَإِذا ذَكَرتُكِ هَزَّ ذِكرَكِ أَضلُعي","شَوقاً كَما هَزَّ النَسيمُ بُنودا",5,"د",2,0],["وَإِذا ذَكَرتُكُمُ غَني","تُ بِذاكَ عَن زادٍ وَماءِ",6,"ا",2,0],["وَإِذا ذَكَرتُ بَني عُبَيدٍ عَبَّدوا","حُرَّ الدُموعِ لِلَوعَةِ المُتَذَكِّرِ",7,"ر",1,0],["وَإِذا ذَكَرتَ أَباكَ أَو أَيّامَهُ","أَخزاكَ حَيثُ تُقَبَّلُ الأَحجارُ",8,"ر",1,0],["وَإِذا ذَكَرتُكَ يا اِبنَ موسى أَسبَلَت","عَيني بِدَمعٍ دائِمِ الهَمَلانِ",9,"ن",1,0],["وِإِذا ذَكَرتُكَ مَيِّتاً سَفَحَت","عَيني الدُموعُ فَفاضَ وَاِنسَكَبا",10,"ب",2,0],["وَإِذا ذَكَرتُكَ يا أُخَيَّ تَقَطَّعَت","كَبِدي فَأُقلِقتُ الجَوانِحُ وَالحَشا",11,"ا",1,0],["وَإِذا ذَكَرتَ مُحَمَّداً وَمَصابَهُ","فَاِذكُر مُصابَكَ بِالنَبِيِّ مُحَمَّدِ",12,"د",1,0],["وَإِذا ذَكَرتَ التائِبينَ عَنِ الطِلا","لا تَنسَ حَسرَتَهُم عَلى أَوقاتِها",13,"ت",3,0],["وَإِذا ذَهَبتُ أَسومُ قَلبي خُطَّةً","مِن هَجرِها أَلفَيتُهُ خَوّارا",14,"ر",2,0],["وَإِذا ذَكَرتَ وَكِدتَ فَاِذكُر أَنَّهُ","لَيسَ الثَناءُ لِما أَرَدتَ مُطيفا",15,"ف",2,0],["وَإِذا ذَكَرتُ فَعالَهُ","بَشَّرتُ نَفسي بِالفَوائِد",16,"د",1,0],["وَإِذا ذَكَرتُ بَني قُتَيبَةَ أَصبَحَت","نَفسي تُنازِعُني القَريضَ جَديدا",17,"د",2,0],["وَإِذا ذَكَرتُ أَبا دُلَيجَةَ أَسبَلَت","عَيني فَبَلَّ وَكيفُها سِربالي",18,"ل",2,0],["وإذا ذكَرْتُكُمُ أميلُ كأنّني","مِن طيبِ ذِكْرِكُمُ سقيتُ الرّاحا",19,"ح",2,0],["وإذا ذممت جوار قوم فاِرتحل","عنهم إِلى بلد حمدت شطير",20,"ر",1,0],["واذا ذَكَّرتُ نَفسي ما خَلا","عادَ في العَينِ كتَسهيدِ الرَّمَد",21,"د",1,0],["وَإِذَا ذَكَرْنَا العيدَ فَلْنَذْكُر أَخاً","لَكُمَا يُنَادِيهِ المَكَانُ الخَالِ",22,"ل",1,0],["وإذا ذكرتكم شربت مدامعي","فكأنّني ثمل أعبّ الراحا",23,"ح",2,0],["وإذا ذكرت أبا رياض عادني","شجن الغريب طغى هواه فناحا",23,"ح",2,0],["وإذا ذكرتك هزّ ذكرك أضلعي","شوقا كما هزّ انسيم بنودا",24,"د",2,0],["وإِذا ذكَرْتُكَ يَوْمَ سِرْتَ مُوَدِّعاً","وَقَفَ الأَسى في القَلْبِ غَيْرَ مُوَدِّعِ",25,"ع",1,0],["وَإِذا ذَكَرتُكَ لَم أَجِد لَكَ وَحشَةً","إِذ لا تُفارِقُ قَلبِيَ المعمُودَا",26,"د",2,1],["وَإِذا ذاكَ أُلقي في ذِراعَيك هامَتي","وَأَرمي فُؤادي في أُنامِلِكِ العشرِ",27,"ر",1,0],["وَإِذا ذاكَ أَقضي سَعيداً لِأَنّي","أَكونُ وَصَلتُ إِلى قَلبِ ميّ",28,"ي",1,0],["وَإِذا ذَكَرتَ لِما أَشَرتَ مُؤَرِّخا","اِشكُر لِتَوكيلِ البُحَيرَةِ مُصطَفى",29,"ف",2,0],["وَإِذا ذَكَرتُ مَوارِداً مِن جودِهِ","عَذُبَت فَبِالذِكرى عَذابُ الغُلَّةِ",30,"ه",1,0],["وإذا ذكرت لبانة قضَّيتها","ولعت مدامع أعيني بمحاجري",31,"ر",2,0],["وإذا ذكرت اللاء خيمن بها","فيبيت طرفي بالهيام مسهدا",32,"د",2,0],["وإذا ذكرت المزن عند ندائه","فترى يديه من السحائب أجودا",32,"د",2,0],["وإذا ذكرت الأكرمين فإنه","لأعزهم عزما واسمحهم يدعا",32,"د",3,0],["وإذا ذُكرتَ له تحفّزَ قلبُه","طرَباً إليك ومرَّ نحوك مجفِلا",33,"ل",2,0],["وإذا ذَوى من دَوحةٍ غصنٌ فيا","سَرْعانَ ما يُودَى بآخرَ ناضرِ",34,"ر",1,0],["وإذا ذُكاء اليوم أضْمَر ضوءها","نقْعٌ كأثْباجِ الظَّلامِ المُعْتِمِ",35,"م",1,0],["وإذا ذَكَرْتَ لَدى الأحبَّةِ وَجْدَنا","سُقْ للحَديثِ لَطائِفَ التَّذْكارِ",36,"ر",1,0],["وإذا ذوى غصنٌ فلا جزعٌ وقدْ","أبقى لنا الأصلَ الأشمَّ السّامي",37,"م",2,0],["وإذا ذكرتُك عرّجتْ","عن ساحتي الخططُ العظامُ",38,"م",1,0],["وَإِذا ذَكرناهُ فَلا وَجَلٌ","يُخشى وَلا همٌّ ولا نَصبُ",39,"ب",1,0],["وإذا ذات كل شيء تبدت","عنده حقق التقرب وصفَهْ",40,"ف",2,1],["وإذا ذكرتكمو أميل كأنني","غصن يقابل في الرياض رياحا",41,"ح",2,0]]}