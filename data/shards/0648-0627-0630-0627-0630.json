{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[95,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[29,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[74,"يوم الوفا يا سيد الأحباب","https://www.aldiwan.net/poem18248.html","الكامل"],[93,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[72,"أحبابنا أزف الرحي","https://www.aldiwan.net/poem43038.html","مجزوء الكامل"],[47,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[30,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[30,"نام الخلي وما أغمض ساعة","https://www.aldiwan.net/poem5624.html","الكامل"],[60,"ما غاض دمعي عند نازلة","https://www.aldiwan.net/poem31191.html","أحذ الكامل"],[51,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[51,"اصبر لكل مصيبة وتجلد","https://www.aldiwan.net/poem62041.html","الكامل"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[33,"أأقام أمس خليطنا أم سارا","https://www.aldiwan.net/poem42537.html","الكامل"],[54,"يا من أراه لج في طيرانه","https://www.aldiwan.net/poem26820.html","الكامل"],[52,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[52,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[19,"أبا دليجة من لحي مفرد","https://www.aldiwan.net/poem361.html",""],[70,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85348","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20984","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[111,"ساحر الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=613",""],[96,"دمعة على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=12814",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[93,"العيون السود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67806&r=&rc=90",""],[159,"لم أمش في طرق العزاء لأنني","https://www.aldiwan.net/poem55628.html","الكامل"],[184,"وإذا ذكرتك لم أجد لك وحشة","https://www.aldiwan.net/poem4118.html","الكامل"],[228,"أبى الحظ إلا أن يصارعني دهري","https://www.aldiwan.net/poem41876.html","الطويل"],[228,"أودك جاحظة المقلتين","https://www.aldiwan.net/poem41903.html","المتقارب"],[325,"اشكر لتوكيل البحيرة مصطفى","https://www.aldiwan.net/poem67205.html","الكامل"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[422,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[435,"عج بالديار وحي ذاك المعهدا","https://www.aldiwan.net/poem41428.html","الكامل"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[463,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[466,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[505,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[556,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[556,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[556,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[563,"وإذا ذات كل شيء تبدت","https://www.aldiwan.net/poem34338.html","الخفيف"],[563,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38988","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72289","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75733","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49942","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115931","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80031","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79851","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101026","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101009","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53103","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104952","المتدارك"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123744","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128110","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93898","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140045",""],[2933,"","https://poetry.dctabudhabi.ae/diwan/poem/198220","الكامل"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113641","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91114","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85055","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85277","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59507","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95370","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102928","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111445","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28685","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35092","الكامل"],[4617,"","https://poetry.dctabudhabi.ae/diwan/poem/116532","الطويل"],[5038,"دار السلام","https://www.poetsgate.com/ViewPoem.aspx?id=195233",""],[5210,"أتظن أني بعد بعدك باقي","https://www.poetsgate.com/ViewPoem.aspx?id=169358",""],[5232,"عاشقٌ وقتيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=212604",""],[5279,"فِي مَدْحِ المُصْطَفَى","https://www.poetsgate.com/ViewPoem.aspx?id=183878",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""]],"verses":[["وَإِذَا ذُكِرْتَ كَأَنَّ هَبَّاتِ الصَّبَا","رَكَدَ الْكَبَاءُ بِجَوِّهَا والْمَنْدَلُ",0,"ل",1,0],["وَإِذا ذو الفُضولِ ضَنَّ عَلى المَو","لى وَصارَت لِخَيمِها الأَخلاقُ",1,"ق",1,0],["وَإِذَا ذَكَرْتَ فِدَى سَعِيدٍ مِنْهُمُ","وَضَحَتْ صَحِيفَتُهُمْ مِن العُنْوَانِ",2,"ن",1,0],["وَإِذا ذَكَرتُكُمُ شَدَدتُم قُوَّتي","وَإِذا نَزَلتُ بِغَيثِكُم كانَ الحَيا",3,"ا",1,0],["وإذا ذكرت الصاحب النائي فقل","عقبى اللقا يا سيد الأصحاب",4,"ب",1,0],["وَإِذا ذَكَرتُكِ هَزَّ ذِكرَكِ أَضلُعي","شَوقاً كَما هَزَّ النَسيمُ بُنودا",5,"د",2,0],["وَإِذا ذَكَرتُكُمُ غَني","تُ بِذاكَ عَن زادٍ وَماءِ",6,"ا",2,0],["وَإِذا ذَكَرتُ بَني عُبَيدٍ عَبَّدوا","حُرَّ الدُموعِ لِلَوعَةِ المُتَذَكِّرِ",7,"ر",1,0],["وَإِذا ذَكَرتَ أَباكَ أَو أَيّامَهُ","أَخزاكَ حَيثُ تُقَبَّلُ الأَحجارُ",8,"ر",1,0],["وَإِذا ذَكَرتُكَ يا اِبنَ موسى أَسبَلَت","عَيني بِدَمعٍ دائِمِ الهَمَلانِ",9,"ن",1,0],["وِإِذا ذَكَرتُكَ مَيِّتاً سَفَحَت","عَيني الدُموعُ فَفاضَ وَاِنسَكَبا",10,"ب",2,0],["وَإِذا ذَكَرتُكَ يا أُخَيَّ تَقَطَّعَت","كَبِدي فَأُقلِقتُ الجَوانِحُ وَالحَشا",11,"ا",1,0],["وَإِذا ذَكَرتَ مُحَمَّداً وَمَصابَهُ","فَاِذكُر مُصابَكَ بِالنَبِيِّ مُحَمَّدِ",12,"د",1,0],["وَإِذا ذَكَرتَ التائِبينَ عَنِ الطِلا","لا تَنسَ حَسرَتَهُم عَلى أَوقاتِها",13,"ت",3,0],["وَإِذا ذَهَبتُ أَسومُ قَلبي خُطَّةً","مِن هَجرِها أَلفَيتُهُ خَوّارا",14,"ر",2,0],["وَإِذا ذَكَرتَ وَكِدتَ فَاِذكُر أَنَّهُ","لَيسَ الثَناءُ لِما أَرَدتَ مُطيفا",15,"ف",2,0],["وَإِذا ذَكَرتُ فَعالَهُ","بَشَّرتُ نَفسي بِالفَوائِد",16,"د",1,0],["وَإِذا ذَكَرتُ بَني قُتَيبَةَ أَصبَحَت","نَفسي تُنازِعُني القَريضَ جَديدا",17,"د",2,0],["وَإِذا ذَكَرتُ أَبا دُلَيجَةَ أَسبَلَت","عَيني فَبَلَّ وَكيفُها سِربالي",18,"ل",2,0],["وإذا ذكَرْتُكُمُ أميلُ كأنّني","مِن طيبِ ذِكْرِكُمُ سقيتُ الرّاحا",19,"ح",2,0],["وإذا ذممت جوار قوم فاِرتحل","عنهم إِلى بلد حمدت شطير",20,"ر",1,0],["واذا ذَكَّرتُ نَفسي ما خَلا","عادَ في العَينِ كتَسهيدِ الرَّمَد",21,"د",1,0],["وَإِذَا ذَكَرْنَا العيدَ فَلْنَذْكُر أَخاً","لَكُمَا يُنَادِيهِ المَكَانُ الخَالِ",22,"ل",1,0],["واذا ذكرته عهد الصبا","قال لي تلك الاعيب الصغر",23,"ر",1,0],["وإذا ذكرتكم شربت مدامعي","فكأنّني ثمل أعبّ الراحا",24,"ح",2,0],["وإذا ذكرت أبا رياض عادني","شجن الغريب طغى هواه فناحا",24,"ح",2,0],["واذا ذكرت الله فاعرف قدره","بين الرجا والخوف مصروف الفكر",25,"ر",1,0],["وإذا ذكرتك هزّ ذكرك أضلعي","شوقا كما هزّ انسيم بنودا",26,"د",2,0],["وإِذا ذكَرْتُكَ يَوْمَ سِرْتَ مُوَدِّعاً","وَقَفَ الأَسى في القَلْبِ غَيْرَ مُوَدِّعِ",27,"ع",1,0],["وَإِذا ذَكَرتُكَ لَم أَجِد لَكَ وَحشَةً","إِذ لا تُفارِقُ قَلبِيَ المعمُودَا",28,"د",2,1],["وَإِذا ذاكَ أُلقي في ذِراعَيك هامَتي","وَأَرمي فُؤادي في أُنامِلِكِ العشرِ",29,"ر",1,0],["وَإِذا ذاكَ أَقضي سَعيداً لِأَنّي","أَكونُ وَصَلتُ إِلى قَلبِ ميّ",30,"ي",1,0],["وَإِذا ذَكَرتَ لِما أَشَرتَ مُؤَرِّخا","اِشكُر لِتَوكيلِ البُحَيرَةِ مُصطَفى",31,"ف",2,0],["وَإِذا ذَكَرتُ مَوارِداً مِن جودِهِ","عَذُبَت فَبِالذِكرى عَذابُ الغُلَّةِ",32,"ه",1,0],["وإذا ذكرت لبانة قضَّيتها","ولعت مدامع أعيني بمحاجري",33,"ر",2,0],["وإذا ذكرت اللاء خيمن بها","فيبيت طرفي بالهيام مسهدا",34,"د",2,0],["وإذا ذكرت المزن عند ندائه","فترى يديه من السحائب أجودا",34,"د",2,0],["وإذا ذكرت الأكرمين فإنه","لأعزهم عزما واسمحهم يدعا",34,"د",3,0],["وإذا ذُكرتَ له تحفّزَ قلبُه","طرَباً إليك ومرَّ نحوك مجفِلا",35,"ل",2,0],["وإذا ذَوى من دَوحةٍ غصنٌ فيا","سَرْعانَ ما يُودَى بآخرَ ناضرِ",36,"ر",1,0],["وإذا ذُكاء اليوم أضْمَر ضوءها","نقْعٌ كأثْباجِ الظَّلامِ المُعْتِمِ",37,"م",1,0],["وإذا ذَكَرْتَ لَدى الأحبَّةِ وَجْدَنا","سُقْ للحَديثِ لَطائِفَ التَّذْكارِ",38,"ر",1,0],["وإذا ذوى غصنٌ فلا جزعٌ وقدْ","أبقى لنا الأصلَ الأشمَّ السّامي",39,"م",2,0],["وإذا ذكرتُك عرّجتْ","عن ساحتي الخططُ العظامُ",40,"م",1,0],["وَإِذا ذَكرناهُ فَلا وَجَلٌ","يُخشى وَلا همٌّ ولا نَصبُ",41,"ب",1,0],["وإذا ذات كل شيء تبدت","عنده حقق التقرب وصفَهْ",42,"ف",2,1],["وإذا ذكرتكمو أميل كأنني","غصن يقابل في الرياض رياحا",43,"ح",2,0],["وإذا ذكرنا الري قلنا أنه","من أنعم الرحمن فيض الماء",44,"ا",2,0],["وإذا ذكرت لها ثنا","عبد العظيم تقول زدنا",45,"ن",2,0],["وَإِذا ذَكرت كَمالكم يَهتاجُني","هَيَجان ذي ودٍّ حليف غَرامي",46,"م",2,0],["وإذا ذكرناه على ألمٍ","ألم بنا شفينا",47,"ن",2,0],["وإذا ذكرت من الحي مصابه","بالطف ضاقت بي له سعة الفضا",48,"ض",2,0],["وَإِذا ذكرت وَفضلك استحيت بما","كانَت به من فضلها تتعجب",49,"ب",1,0],["وإِذا ذّكَرت الأصْفياءِ كأنَّ في","قلْبي ما تضُمُّ جناحَها",50,"ح",3,0],["وإذا ذكرتُك فاض دمعى حُرقةً","لو كان يُغنى فيضُ دَمعِ الذَّاكِرِ",51,"ر",1,0],["وإذا ذوو الفضل استوت أقدامُهم","وجدوه أحرى القوم أن يتقدَّما",52,"م",2,0],["وإذا ذكره أطافَ بأُخرى","كاد شوقاً فؤادها أن يطيرا",53,"ر",2,0],["وإذا ذكرتِ خواطري وعواطفي","لا تذكري عبثَ الصِّبا بكهولتي",54,"ي",1,0],["وإذا ذلت الشعوب فعقبى","حاكميها عقبى الخسيس الأذل",55,"ل",1,0],["وإذا ذكرتَ تميمَ فهو جريرها","شعراً وأكثمها الحكيم المِصدَع",56,"ع",1,0],["وإذا ذكرت الشامتين بموته","فبموت خير الخلق سرّ الاسود",57,"د",1,0],["وإذا ذو الجدال رام جوابا","كان إقرارهُ بِعَجزٍ جوابَه",58,"ب",2,0],["وإذا ذكرت وكنت تأكلُ ناسياً","فيه فأمسك ساعةَ الذكر",59,"ر",1,0],["وإذا ذهلت عن المقال فلا ترع","فالْعِيُّ صاحبه هنالك يعذر",60,"ر",1,0],["وَإذَا ذَكَرتَ الله تَوحِيداً رَأي","تَ وُجُوهَهُم مَكسُوفَةَ الألوَانِ",61,"ن",1,0],["وَإِذَا ذَكَرتَ بِمِدحَةٍ شُرَكَاءَهُم","يَتَبَاشَرُونَ تَبَاشُرَ الفَرحَانِ",61,"ن",1,0],["وإذا ذكر المعروف فما","لسواك به شيء يُذكَر",62,"ر",1,0],["وإذا ذكرنا الشعر فه","وكما سمعتَ به حَبيبُه",63,"ب",2,0],["وإذا ذكرتكم فكلي ألسن","وبذكركم يترنم المترنم",64,"م",1,0],["وإذا ذاقها أمالته نحوي","صح ما قيل إنها قواده",65,"د",2,0],["وإذا ذكروا السلو يقول قلبي","تصامم عن أباطيل النصارى",66,"ر",2,0],["وإذا ذكرتكم تفيض مدامعي","بدم وكل جوارحي تبكيكم",67,"م",1,0],["وإذا ذكرت أبا الكرام تقطعت","كبدي وبرح بي نزاع مؤلم",67,"م",1,0],["وإذا ذكَّرته أنَّهم","قد أساءوا قال لا بل أحسنوا",68,"ن",3,0],["وَإِذا ذُكرنا كان عنبرُ ذكرنا","طيباً به طيب الزَمان يضمَّخ",69,"خ",1,0],["وإذا ذقت من شرابي نصيباً","فهو عين القبول فارقص وغن",70,"ن",1,0],["وإذا ذكرت بمدحة ذا شيمة","فأمامنا ممن تفيا ظلها",71,"ل",3,0],["واذا ذلك القتيل أنيس","ذو المخازي والفعلة الشنعاء",72,"ا",2,0],["وإذا ذكرنَ المكرمات فانني","تاللهِ بعد أبي الهمام همامُها",73,"م",3,0],["واذا ذكت نيران ملحمة","حمر كأن شرارها قصر",74,"ر",1,0],["وإذا ذكرت حديث ربرب ضارج","لا تنس ذكر أهلة الزوراء",75,"ا",2,0],["وإِذا ذَلَلنا بانكِسارِ جُنُودِنا","فَعَلَيهِ أَعظَمُ لَزبةٍ دَهماءِ",76,"ا",2,0],["وَإِذا ذَكَرتُكَ أَو عَليّا لَم أَزَل","حَزنانَ مِن كَمَد وَمِن وُسواسِ",77,"س",1,0],["وَإِذا ذَكَرتَ قَبيلَهُ عَنساً فَخُذ","ما شِئتَ مِن شَرَفٍ وَعِزٍّ سَرمَدا",78,"د",2,0],["واذا ذكر اسم الله يقرن باسمه","لتعظيمه فى كل كتب أتت تتلى",79,"ل",2,1],["وَإِذا ذَكَرْتُكَ في النَّوى فَكَأَنّني","أَنَا وَالْمَآذِنُ في الْبِلادِ نُكَبِّرُ",80,"ر",1,0],["وإذا ذكرتك خلت أني شارب","ثمل سقاه من المدامة ساق",81,"ق",1,0],["وإذا ذكرتمْ في الهوى قتلى الهوى","قولوا بأنّيَ عَاشقٌ وقتيلُ .",82,"ل",1,0],["وإِذَا ذَكَرْتُ مِنَ الخِلاَلِ تَعُوزُنِي","تَكْبُو المَعَانِي وَالحُرُوفُ فَتَعْجَزَا",83,"ز",2,0],["وَإِذَا ذَكَرْتُ العِيسَ تَجْتَابُ السُّرَىٰ","وَخْدًا يُبلِّغُهَا الدَّخُولَ فَحَوْمَلَا",84,"ل",2,0],["وإذا ذكريات تلك المثاني","لك عادت تردد الألحانا",85,"ن",2,0],["وإذا ذكرتك في المجالس مادحاً","أثنى عليك الحاضرون طويلا",86,"ل",2,0]]}