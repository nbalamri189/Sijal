131,"العِزُّ وَالمَجدُ في الهِندِيَّةِ القُضُبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71147&r=&rc=4",""],[6346,"أغالب قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83393&r=&rc=9",""],[572,"روحٌ من الماءِ في جِسْمٍ مِنَ الصفَرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9301&r=&rc=158",""]],"verses":[["تقضض من مهابته البرايا","تقضض صفحة الورق التهابا",0,"ب",2,0],["تَقَضَّت لُباناتُ الصِبا وَتَصَرَّمَت","فَلا نَهيَ لِلّاحي عَلَيَّ وَلا أَمرُ",1,"ر",1,0],["تَقَضَّى كَرِيمَ الْعُمْرِ فِي غَيْرِ طَائِلٍ","كَمَا بَدَّدَ الْوَفْرَ الْغَزِيرَ كَرِيمهُ",2,"م",2,0],["تُقْضى مناسِكُهُ ويُمْسَحُ رُكْنُهُ","أبَداً وتُقْذَفُ للدّموعِ جِمارُهُ",3,"ر",2,0],["تقضّى زَماني في لعَلّ وفي عسى","فلا عزْمَةٌ تُمْضى ولا لوْعَةٌ تَهْدا",4,"د",2,0],["تَقَضَّينَ مِن أَعرافِ لُبنى وَغَمرَةٍ","فَلَمّا تَعَرَّفنَ اليَمامَةَ عَن عَفرِ",5,"ر",1,0],["تقضَّيتُ منها فوق ما أحسب المنى","وبُرد عفافي صانه الله من بُردِ",6,"د",1,0],["تقضى النهار برأب الثأي مجتهداً","وتقطع اليل بالتدبير والأرق",7,"ق",1,0],["تَقضي القُضاةُ عَلى تَيمٍ وَإِن رَغَمَت","فَاِكتُب قَضاءَكَ وَاِطبَع بِالخَواتيمِ",8,"م",1,0],["تقضَّت ليالي الوصل إلاَّ ادِّكارها","وغابَ حبيب القلب إلاَّ خياله",9,"ل",2,0],["تَقضي عَلى المَرءِ اللَيالي أَو لَهُ","فَالحَمدُ مِن سُلطانِها وَالذامُ",10,"م",1,0],["تَقضي السِياسَةُ غَيرَ مالِكَةٍ لِما","حَكَمَت بِهِ نَقضاً وَلا تَوكيدا",11,"د",2,0],["تَقضَمُ الجَمرَ وَالحَديدَ الأَعادي","دونَهُ قَضمَ سُكَّرِ الأَهوازِ",12,"ز",1,0],["تُقِضُّ أَضالِعي أَنفاسُ وَجدٍ","لِمُختَضَرٍ كَما اِختُضِرَ القَضيبُ",13,"ب",1,0],["تَقَضّى الهَمومُ لَم يُلَبِّث طُروقُها","زَماعي وَلَم يُغلَق عَلَيَّ رِتاجُها",14,"ج",3,0],["تَقَضّى الصِبا إِلّا خَيالاً يَعودُني","بِهِ ذو دَلالٍ أَحوَرُ الطَرفِ فاتِرُه",15,"ر",2,0],["تَقضي بِقوتِ عِيالي حَقَّ زَورَتِها","لِلَّهِ أَنتَ لَقَد أَفحَشتَ في الغَزَلِ",16,"ل",1,0],["تَقَضّى الصِبا إِلّا تَلَوُّمَ راحِلِ","وَأَغنى المَشيبُ عَن مَلامِ العَواذِلِ",17,"ل",1,1],["تَقَضَّت لَيالي الشَهرِ إِلّا بَقِيَّةً","تَهَجَدُ فيها جاهِداً أَو تَقومُها",18,"م",3,0],["تَقَضَّت بَشاشاتُ المَجالِسِ بَعدَهُ","وَوَدَّعَنا إِذ وَدَّعَ الأُنسُ وَالعِلمُ",19,"م",1,0],["تَقَضّى غَيرَ لَيلٍ ماتَقَضّى","كَأَنَّ بِمَضجَعي فيهِ سَليما",20,"م",2,0],["تَقَضّى وَأَلقى بَينَ جَنبَيَّ لَوعَةً","أُباكي بِها أُخرى اللَيالي البَواكِيا",21,"ي",2,0],["تَقضي فَيَمسَحُ عَهدَ الظُلمُ عادِلُها","عَنّا وَيَمحو زَمانَ السوءِ ماحيها",22,"ي",3,0],["تُقضَى الدّيونُ بها فلا ابنُ أميّةٍ","يشكو المَطَالَ ولا حُوَيْطِبُ يَعْتِبُ",23,"ب",1,0],["تَقضي الذمامَ وتَمضِي غيرَ مُكْتَرِثٍ","كأنّما الأمرُ لم يَفدَحْ ولم يَهُلِ",24,"ل",1,0],["تُقضَ إِلَيهِ حاجَةٌ أَو يَقُل","هَلأ لِيَ مِمّا بِيَ مِن مَخرَجِ",25,"ج",1,0],["تَقَضّتْ ليالينا بها ونَعيمُها","فكَرَّ على الشمل الجميعِ مُفرِّقه",26,"ق",2,0],["تَقَضّى الناسُ جيلاً بَعدَ جيلٍ","وَخُلِّفَتِ النُجومُ كَما تَراها",27,"ا",3,0],["تَقَضّى زَمَانُ الوَصلِ بَيني وَبَينَها","وَلَم يَنقَصِ الشوقُ الَّذي كانَ أَكثَرا",28,"ر",2,0],["تقضّي في مسائك ألف أمرٍ","وتقطع في نهارك ألف ميل",29,"ل",1,0],["تُقضى الدُيونُ وَلَيسَ يُنجِزُ مَوعِداً","هَذا الغَريمُ لَنا وَلَيسَ بِمُعسِرِ",30,"ر",1,0],["تقضّت الأيام والشهور","والسيف في غير وغى مشهور",31,"ر",1,0],["تُقْضَى الأَمَانِيُّ وَالْهَوَى في","ذَرَاكُمَا مُصْبِحُ ومُمْسِي",32,"س",2,0],["تقضي إلى النسمات في غدواتها","عما تكابد في نواك وتجرع",33,"ع",1,0],["تقضت به أيامه البيض كلها","أياديه أمطار وناديه معلم",34,"م",1,0],["تقضت به أيامه من جمالها","تنور منها نير متجسم",34,"م",1,0],["تقضى ثمين العمر في نشوة الهوى","وحشو مزادي باطل وغرور",35,"ر",1,0],["تقضى الليالى حزيناً بائساً قلقاً","وقلبك الغض فى جنبيك يضطرب",36,"ب",1,0],["تُقَضّى دُيُونُ المُنْعِمِينَ، وَيُقتَنَى","لَهُمْ منْ بَوَاقِي ما أعاضَتهُمُ فَخْرُ",37,"ر",1,0],["تقض أضلاعي أنفاس وجد","لمختضر كما اختضر القضيب",38,"ب",1,0],["تقضي النهار برأب الثأي مجتهداً","وتقطع الليل بالتدبير والأرَق",39,"ق",1,0],["تقضي وتندفع الأكدار والألم ال","عاري يبدل بالإحسان والنعم",40,"م",1,0],["تَقَضَّت لُبَانَاتُ المَحَبَّةِ والوَصلِ","من البيضِ ِإلا عَيشَ بِنت محمد أعلي",41,"ي",1,1],["تَقَضَّت أزمُنَ العَفَلاَتِ عني","ومَا خَرَّقتُ عن بصِرَى الغِطَاء",42,"ا",2,0],["تُقَضّي الدَهرَ عاماً بَعدَ عامٍ","وَتُفنيهِ بِعُمرٍ غَيرِ فانِ",43,"ن",1,0],["تقضت ليال ضاعفت لكم الأجرا","بأيامها واجتلت الأثم والوزرا",44,"ر",2,1],["تقضّي لبانات الصدود وتتثني","لأمرك فيها جامح وذلول",45,"ل",1,0],["تَقَضى فأجفانُ السَّحابِ دوامعٌ","عليه وأنفاسُ الرياح تَصَعَّدُ",46,"د",1,0],["تقضّي بما فيه وأُعقِب بعده","زمان بأنواع المكاره ماطِر",47,"ر",1,0],["تَقَضَّت قِصاراً وَلَكِنَّها","أَطالَت عَلَيَّ اللَيالي البَواقي",48,"ق",2,0],["تقضّى منهُ إبراقٌ ورعدٌ","وَذا الشرّ الدرور بغيرِ بسِّ",49,"س",1,0],["تَقضي بِها صَبري وَضاقَت مَذاهِبي","وَاِعظِم مِنها فيكَ ما أَتَوَقَّعُ",50,"ع",1,0],["تَقَضَّى وَهوَ مِلءُ العَينِ حُسناً","كَمَا استَمتَعتَ مِن شَمسِ الأصِيلِ",51,"ل",1,0],["تَقْضي كواكبُ أطرافِ الرّماح له","على المُلوكِ بنَصْرٍ أو بِخذْلان",52,"ن",1,0],["تَقضي لَهُ المَشاعِرُ اِستيعادُهُ","إِذا اِرتايَ بِشَرفِ التَفَرُّدِ",53,"د",1,0],["تَقَضّى الَّذي قَد كانَ بِالأَمسِ بَينَنا","وَأَسكَتَني دَهري فَهَل يَسكُتُ الدَهرُ",54,"ر",1,1],["تقضَّت لياليها بطيبٍ كأنه","لتقصيره منها مختَطَف الدجا",55,"ج",2,0],["تقضَّى عليه الحول والحول بعده","وغَرْبُ النوى من مقلة الصب ينزع",56,"ع",1,0],["تقضَّت وما قضيت منها لبانة","وولت فأولتني جوى يتنوع",56,"ع",1,0],["تقضَّتْ لنا أعوام وصل كأنما","يرى عامنا في سرعة السير كالشهر",57,"ر",1,0],["تقضَّى لي بها زمن نفيس","كحلت عليه أجفاني بسهد",58,"د",1,0],["تقضت له من نحو عشرين حجة","سقيماً فلم يرقد مناماً على جنب",59,"ب",1,0],["تقضَّت بك الأعمار في غير طاعة","سوى عمل ترضاه وهو سراب",60,"ب",1,0],["تَقَضَّى عليَّ لنا زمنٌ بالحمى","ولئنْ قضى الله أنْ لا يدوما",61,"م",2,0],["تَقَضَّتْ رَجاءَ الراغِبينَ سِجَالُهُ","وعَمَّتْ كما عَمَّ الغَمامُ مَوَاهِبُهْ",62,"ب",2,0],["تقضيى فلم يترك فؤاداً من الأسى","خلياً ولا عينا مهنأة بابن",63,"ن",1,0],["تقضي وتمضي الأمور فيها","وهي إلى أمرهم تؤولُ",64,"ل",1,0],["تَقضِي له الأقلامُ من حاجاتها","ما استقضت الذابلَ والمهنَّدا",65,"د",2,0],["تقضي على الألباب أين خلاصها","من شَوبها ما استُحظِيت أو أُلغِيتْ",66,"ت",1,0],["تقضي الليالي والسنون ببينهِ","فلا غروَ أن أبكى وأن أقرع السنّا",6