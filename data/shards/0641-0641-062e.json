{"poems":[[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[164,"تولى بعد ما غسل الذنوبا","https://www.aldiwan.net/poem58907.html","الوافر"],[382,"سبيل الراهب الراجي برب","https://www.aldiwan.net/poem59274.html","الوافر"],[438,"نثرن عليه من صدف الخيام","https://www.aldiwan.net/poem12735.html","الوافر"],[443,"إذا شكرت زهر الرياض يد الحيا","https://www.aldiwan.net/poem2534.html","الطويل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[556,"نجوت القنا والبيض تدمى متونها","https://www.aldiwan.net/poem47142.html","الطويل"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[580,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122615","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55976","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65950","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122493","المتقارب"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144909","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120515","السريع"],[4912,"أهنيك بل نفسي أهني بما سنى","https://www.poetsgate.com/ViewPoem.aspx?id=181788",""],[5206,"أئمة بني خروص","https://www.poetsgate.com/ViewPoem.aspx?id=187433",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[6023,"ففخراً بشعر من فتى كان أهله","https://www.poetsgate.com/ViewPoem.aspx?id=123882",""]],"verses":[["فَفَخراً بِنَيلِكِ هَذي الخِلالَ","فَفي عُشرِ مِعشارِها مُفتَخَر",0,"ر",1,0],["ففخراً إِنها سبعون جداً","ملوكاً أنجبت هذا النجيبا",1,"ب",2,0],["ففخر الناس ذو فضلٍ مسيحي","وفخرُ الفضل ذو نَسكٍ وفضل",2,"ل",1,0],["ففَخْراً يا بني عِمرانَ فخْراً","على الأملاكِ من سامٍ وحامِ",3,"م",1,0],["ففخرك يا رب المفاخر شائع","بأنك قد قلّدتني منعما يدا",4,"ا",1,0],["ففخراً يا خُزَيْمُ فكلُّ فخرٍ","إلى أنواركم أعمى بليدُ",5,"د",1,0],["ففخرُ الفتى بالفضلِ منه وعنده","أجلُّ له من فخرهِ بأبيهِ",6,"ي",2,0],["فَفخراً بنِي فِهْرٍ بأنِّيَ منكُمُ","إذا عِيق عن عليائها مَن تعوّقا",7,"ق",2,0],["فَفَخْراً لقدْ أَصبحتَ للخلق مَالِكاً","وأَصبحتَ فيهم للجميل متمِّما",8,"م",2,0],["فَفخراً فقد أفنَى الكلابَ أسودُها","غِلاباً وقد أخسَى النُّباحَ زئيرُها",9,"ر",3,0],["ففخرة المرء في الدنيا عشيرته","ويستعز الفتى بالصاحب الشهمِ",10,"م",1,0],["ففخرهم عار وعزهم وهى","وسعيهم خسر وعقباهم ردى",11,"د",2,0],["ففخرٌ بهَذَا وفخرٌ بِذَاكَ","علَى النَّيِّرَينِ وِسَامي النُّجُومِ",12,"م",1,0],["ففخر عبد الله في الناس أن","يقول قد ناقضني صالح",13,"ح",1,0],["ففخره ومجده منصوصُ","لأنه بنورها مخصوصُ",14,"ص",1,0],["ففخري قاهر للناس بادٍ","قهور الشمسِ توماض الذُبال",15,"ل",1,0],["ففخر مولانا بالآئه","فاقت على العد بغير امتنان",16,"ن",1,0],["ففخراً بما في عظم فخرك شبهه","ولا لك شبه في الأنام إذا قسنا",17,"ن",2,0],["فَفَخْرُهُمُ سَمَا عَنْ كُلِّ فَخْرٍ","فَلَيْسَ البَحرُ تُشبِهُهُ الوَشَايِلْ",18,"ل",1,0],["ففخرنا بعروج المصطفى عنت","إن لم يكن ربنا بالفوق متصفا",19,"ف",2,0],["ففخراً بشعر من فتى كان أهله","يهاديهم بالشِّعر من كان يشعر",20,"ر",1,1]]}