{"poems":[[75,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[74,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[53,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[72,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[94,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[64,"بنفسي من ينتابني ويعودني","https://www.aldiwan.net/poem52339.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54663","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[119,"ربطت بحبل عنقا الشرق حبلى","https://www.aldiwan.net/poem41749.html","الوافر"],[119,"شكوت إلى رسول الله هما","https://www.aldiwan.net/poem42156.html","الوافر"],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[193,"كتاب سعادة الدارين سفر","https://www.aldiwan.net/poem35139.html","الوافر"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[276,"إلى صارم الدين الفتى ابن محمد","https://www.aldiwan.net/poem52060.html","الطويل"],[276,"أراني ما ذكرت لك الفراقا","https://www.aldiwan.net/poem52101.html","الوافر"],[302,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[307,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[333,"لولا ولولا ولولا","https://www.aldiwan.net/poem54933.html","المجتث"],[333,"مجالي الصبا لا طواك الزمن","https://www.aldiwan.net/poem55036.html","المتقارب"],[354,"نهدت إلى الهند في فتية","https://www.aldiwan.net/poem15880.html","المتقارب"],[369,"إن قصرت بي عن الأغراض أيامي","https://www.aldiwan.net/poem60648.html","البسيط"],[438,"هل يا حداة النجب","https://www.aldiwan.net/poem12478.html","مجزوء الرجز"],[438,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[466,"ضرب من الشعر قس الأولون إلى","https://www.aldiwan.net/poem15116.html","البسيط"],[469,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[484,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[520,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[520,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[563,"لمن أشتكي ما بي وما بي هو الله","https://www.aldiwan.net/poem33587.html","الطويل"],[563,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[563,"فديتك يا من قد خفيت فلاحا","https://www.aldiwan.net/poem34672.html","الطويل"],[567,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[567,"ربيبة من ذوات الغنج والحور","https://www.aldiwan.net/poem52918.html","البسيط"],[567,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110381","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110361","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86890","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86754","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34399","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37733","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38984","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70725","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71022","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145777","المتقارب"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67824","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62569","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62542","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80169","البسيط"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178093","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64542","الطويل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82271","الهزج"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113998","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49542","المتقارب"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101836","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89546","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28024","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27902","الطويل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60840","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137246",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94292","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93796","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9610","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201712","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134002","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97911","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205692",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132126","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135739","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119669","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119654","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123505","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91028","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94532","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35046","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136436",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5010,"إن الرسول لنور","https://www.poetsgate.com/ViewPoem.aspx?id=190564",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5281,"طوارق الدَّهر","https://www.poetsgate.com/ViewPoem.aspx?id=200091",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5306,"الكوكب الدرّي","https://www.poetsgate.com/ViewPoem.aspx?id=174807",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"عبدة الشيطان ....","https://www.poetsgate.com/ViewPoem.aspx?id=207545",""],[5558,"إِلَيكَ قَوافي الشِّعرِ تَمشي وتَركُضُ","https://www.poetsgate.com/ViewPoem.aspx?id=212411",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5956,"أ أنتِ بقربي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183476",""],[6093,"أشكو إلى الله منْ هَمٍّ يُساورُني","https://www.poetsgate.com/ViewPoem.aspx?id=176150",""],[6152,"ذات خوف","https://www.poetsgate.com/ViewPoem.aspx?id=207355",""]],"verses":[["هُوَ الكَريمُ الَّذي سَنَّ الكِرامُ لَهُ","زُهرَ المَساعي فَلَم تَستَهوِهِ البِدَعُ",0,"ع",1,0],["هو الكافل الدنيا بأنعمهِ فما","يحسّ لمفقودٍ بأيامه فقد",1,"د",1,0],["هو الكيْسُ اشتريناه بكيسٍ","ومن لا يشتري كيساً بكيس",2,"س",1,0],["هو الكاتبُ النِّحريرُ والمِدرهُ الذي","به انفرجتْ عنّا الخطوبُ الضواغطُ",3,"ط",1,0],["هو الكالئُ الراعي ونَحْنُ وغيرُنا","بعيْنَيْهِ مَرْعيُّون رعْيَ السوائمِ",4,"م",1,0],["هُوَ الكامِلُ المَولى الَّذي إِن ذَكَرتَهُ","فَيا طَرَبَ الدُنيا وَيا فَرَحَ العَصرِ",5,"ر",1,0],["هو الكونُ حيٌّ يحبُّ الحَيَاةَ","ويحتقرُ الميْتَ مهما كَبُرْ",6,"ر",1,0],["هُو الكونُ خلف سُبَاتِ الجُمودِ","وفي أُفقِ اليَقظاتِ الكُبَرْ",6,"ر",1,0],["هُوَ الكَلمُ قَد أَعيى الأُساةَ عِلاجُهُ","فَلَيسَ لَهُ إِلّا الحَبيبُ المُساعِفُ",7,"ف",1,0],["هو الكونُ مرآتي ومجلى مفاتني","وما لغديرٍ أن يُمثِّلَ صورتي",8,"ي",1,0],["هُوَ الكَوْكَبُ الهَادِي بِسَاطِعٍ نُورِهِ","إِذَا اشْتَدَّتِ الأَسْدَافُ وَالحَلكاتُ",9,"ت",1,0],["هُوَ الكوكبُ اللَّمَّاحُ يَسْطَعُ بالْمُنَى","وتَنْطِقُ بالغيثِ العَميم مَخَايِلُهْ",10,"ل",2,0],["هو الكشاف للبلوى سريعاً","هو الجيلي فداه أنا وجيلي",11,"ي",1,0],["هو الكشاف للبلوى بحق","وحصن الملتجى في النازلات",12,"ت",1,0],["هُوَ الكَريمُ الَّذي فيهِ الزَمانُ بَدا","زاهي المَحاسنِ عَذبِ الكَأسِ صافيها",13,"ي",3,0],["هوَ الكنزُ المُباح لمَن أتاه","عليهِ لَم نَضع رصَداً وقفلا",14,"ل",2,0],["هوَ الكريمُ الّذي للكتبِ قاطبةً","مِن نورِ جَدواه تنويرٌ وتأويلُ",15,"ل",1,0],["هو الكاتب الوحي الحليم وأخته","مع المصطفى في جنة الخلد ترتع",16,"ع",1,0],["هُوَ الكوثر الفياض في آل فارح","اغر يُنادي للندى فَيجيب",17,"ب",1,0],["هُوَ الكرم الَّذي مَلأَ البَرايا","هوَ العلم الَّذي ركب البراقا",18,"ق",2,0],["هُوَ الكَريمُ الَّذي ما زالَ نائلُه","تَتلو غواديَه فينا روائحُهُ",19,"ح",2,0],["هو الكمالُ إذا قيسَ الكمال به","فكيف ذاك العلا يسعى به جسدُ",20,"د",1,0],["هو الكريم المرجى","لماه دقّ وجلّا",21,"ل",2,0],["هو الكون ينل كالكائن","صلالاً من الشر ما إن تريم",22,"م",1,0],["هُوَ الكُلُّ لا غَيرُهُ كُلُّهُ","فَكُلٌّ بِهِ مُغرَمٌ مُستَهامُ",23,"م",1,0],["هوَ الكمالُ فدامَتْ عَيْنُه أبداً","مَصْروفةً عنكَ يا أسمي بني سام",24,"م",1,0],["هو الكريمُ بن الكري","مِ الأنجبُ بن الأنجبِ",25,"ب",1,0],["هو الكنُف الوطيّ كما عهِدْنا","فأجدرُ أن تُناخَ به المطيُ",26,"ي",1,0],["هو الكميُّ إذا ضاقَ الجدالُ ولم","يستبرقِ الحبرُ من عيٍّ ومن لَكن",27,"ن",1,0],["هو الكلم المأثور كم لسهامه","وقد شددت في قلب شاني من كلم",28,"م",1,0],["هو الكفيل بإصلاح وتوضحة","هو الدليل لنا في أي ما سبل",29,"ل",1,0],["هو الكفيل ولكن قد كفلت له","أبا الفوارس نجح السعي والطلب",30,"ب",1,0],["هو الكف والباع الطويل إذا سطوا","وهم عند بطش الراحتين أنامله",31,"ل",2,0],["هو الكل بل لا كل والكل هالك","وفان وهذا كل هذا هو الله",32,"ل",2,0],["هو الكون ثوب والسداءُ هو الأمرُ","ولحمته الخلق اقتضى نهيه الأمرُ",33,"ر",1,1],["هو الكل إلا أن صولة فعله","حجاب له يسقي البرية راحا",34,"ح",2,0],["هُوَ الكريمُ الذي تُملى القُلوبُ بهِ","أُنساً وتُجلَى بمَرأى وَجههِ المُقَلُ",35,"ل",1,0],["هو الكريمُ الذي تَسمُو مَواهِبُهُ","عن النُضارِ فيُهدِي أَنفَسَ الدُرَرِ",36,"ر",1,0],["هوَ الكريمُ الجوادُ ابنُ الجَوادِ لهُ","بالفَضلِ يَشهَدُ بَدْوُ الأرضِ والحَضَرُ",37,"ر",1,0],["هُوَ الكَورِيُّ باني العِزِّ وَالمج","دِ لِلإِسلامِ وَالشَرَفِ العَتيدِ",38,"د",1,0],["هو الكريمُ الّذي جادَت أناملهُ","على الأنام كبحرٍ مفعم خضلِ",39,"ل",1,0],["هو الكنز لكن في الموانع كنزه","على كل عزم بان في البين عجزه",40,"ه",1,0],["هُوَ الكريمُ الذي في الشرقِ مسكنُهُ","وذكرُهُ سائرٌ كالعنبرِ العطرِ",41,"ر",1,0],["هو الكريمُ الذي بينَ العباد غدا","كالبدرِ بينَ نجومِ الليلِ يشتهرُ",42,"ر",1,0],["هُوَ الكنز للعرفان وَالكَف للندى","هُوَ الحلم وَالمَعروف وَالخَير وَالبر",43,"ر",1,0],["هُوَ الكَوكَب الأَسنى المُضيء بدولة","يلقِّبه سلطانُها بِوَحيد",44,"د",1,0],["هوَ الكَريمُ الَّذي ما رَدَّ سائِلَهُ","ما شَكَّ شَخصانِ في هَذا وَلا اِختَلَفا",45,"ف",2,0],["هوَ الكَريمُ الَّذي قَد صارَ حاتَمهُ","نَسْياً فلَيسَ له ذا الآنَ إذْكارُ",46,"ر",1,0],["هُوَ الكامِلُ الفذُّ الّذي في كَمالِهِ","يَفوقُ كَمالَ البدرِ في لَيلةِ البدرِ",47,"ر",1,0],["هوَ الكامِلُ السامي كَمالاً عَلى تُقىً","مَصوناً بِكلِّ الدَّهرِ عَن عيبِ عَيّابِ",48,"ب",1,0],["هو الكريم الذي تُغْنيك رؤيتهُ","عن الكنوزِ وإكسيرِ الأنابيق",49,"ق",1,0],["هو الكريم الحليم القرْم سيدُنا","بَلْعربٌ سيدُ الأحرارِ والخدِم",50,"م",1,0],["هُوَ الكأسُ والسُمُّ فلْيَجْرَعِ السُمَّ","مِنْ كأسِكُمْ مَنْ بأمْسِ اصْطَلاهَا",51,"ا",3,0],["هُوَ الْكَنْزُ يَا طُوبى لِمَنْ كَانَ كَنْزَهُ","خَصِيمٌ بِإعْجَازٍ لِمَنْ ظَنَّ عَجْزَهُ",52,"ه",1,0],["هو الكريم الذي ترجى منافعه","وأكثر الناس معدود من السقطِ",53,"ط",1,0],["هو الكامل المرضي والفاضل الذي","تدين لعلياه السُّراة الأكابرُ",54,"ر",1,0],["هو الكريم الذي يممته لهفا","فأمني الخير واستشفيته فشفى",55,"ف",2,0],["هُوَ الكِتابُ الَّذي قَدَمتهُ سَنَداً","عَلى التَعلُقِ مثل العَهدِ يُكتَتَبُ",56,"ب",1,0],["هو الكريم ولا كريم مثله","يرقى ل (زايد) أو إليه يَصعدُ",57,"د",1,0],["هو الكاشف الأستار عن نير الهدى","هو الباعث المبعوث بالحنفية",58,"ه",1,0],["هُوَ الكَلبُ إِذا ماتَ","فَلَم يوجَد لَهُ فَقدُ",59,"د",1,0],["هُوَ الكفيلُ بما يرجو مؤَمِّلهُ","لاكِنَّهُ بعَفافِ النفسِ عنهُ غَنى",60,"ن",2,0],["هو الكلبُ أَسَّدَهُ جَهْلُهُ","وطال فخالُوْهُ ليثَ الثَّرى",61,"ا",1,0],["هو الكريم الأريحى الذي","بالجود رقاب الرجال",62,"ل",1,0],["هُوَ الكاسي مِنَ السُؤدُ","دِ وَالعاري مِنَ الكِبرِ",63,"ر",1,0],["هو الكاتِبُ المحصي عليكم فِعالَكم","وأَعمالكم من خالِصٍ ورياءِ",64,"ا",2,0],["هو الكرم العريَض لأن جرمي","عظيمٌ والعطابكَ من علاكا",65,"ك",2,0],["هوَ الكَوكَب الوَقّادُ في قُنَّةِ العُلا","إِذا ما دَجا الخطبُ المَهيلُ تُشَعشَها",66,"ه",2,0],["هو الكريم فما تحصى مواهبه","من العطايا ومنه الجودُ والرفد",67,"د",1,0],["هو الكل والأجزاء عينُ وجودِه","فيا مثبتي بي لست غير مثبتي",68,"ت",2,0],["هو الكريمُ السَّمحُ إذ جادَ فلا","تَقِس بكفِّ جودِه نهراً جَرى",69,"ا",1,0],["هو الكوكبُ الدوارُ مُلْتمعُ الضِيَا","به في طريق العلم والدين يقتدى",70,"د",2,0],["هو الكاتب الفذ الذي في يراعه","قد اجتمعا سحر البلاغة والخمر",71,"ر",1,0],["هو الكوكب الأسنى وقسورة الحمى","وموئل من لاذوا وسؤل الذي ابتهل",72,"ل",1,0],["هو الكريم الذي يعفو ويصفح عن","جان وإن طال تفريط وتقصير",73,"ر",1,0],["هو الكوكب الأسنى الذي من ضيائه","قد اقتبست أضواء كل توقد",74,"د",1,0],["هُوَ الكَرَمُ الَّذي مَلَأَ البَرايا","نَدا يَدِهِ اِصطِباحاً وَاِغتِباقا",75,"ق",2,0],["هُوَ الكاسِرُ العَظمَ الأَمينَ وَما يَشَأ","مِنَ الأَمرِ يَجمَع بَينَهُ وَيُفَرِّقِ",76,"ق",1,0],["هو الكلب نَبْح المجتدي رأس ُماله","هو الغدر عضّاضاً هو السبُّ والقذف",77,"ف",1,0],["هو الكنز والإمداد خير ذخيرة","ترى نثره دراً له الحسن ناظم",78,"م",1,0],["هو الكوكبُ السيارُ قد ذر قرنهُ","على الكون فانجابت غيومٌ وأسحارُ",79,"ر",1,0],["هو الكتَّان يا نسَّا","ج، فانسج منه منفردا",80,"د",2,0],["هو الكريم ولكن كان ذا شغفٍ","بالشح إذا خلق الله المحبينا",81,"ن",2,0],["هو الكبير والجليلُ والعظيمْ","هو الوكيلُ والحسيبُ والعليمْ",82,"م",1,0],["هو الكريم إذا ما جئت تسأله","تسحّ كفّاه من نقدٍ ومن دُرَر",83,"ر",1,0],["هو الكوكب الدُّريّ نور زجاجة ال","نبيّ الذي تاهت بعلياه هاشمُ",84,"م",1,0],["هو الكهف للهف الذى برح الاذى","بذىء مائق مارق فش",85,"ش",1,0],["هو الكوكب العظمي المؤيد أحمد","لأن غاب فالانجال من بعده الزهر",86,"ر",1,0],["هو الكامل الأوصاف ذو الرشد والحجى","فأفديهِ بالأرواح من مفردٍ برِّ",87,"ر",1,0],["هو الكلّ في كلّ معيداً ومبدياً","وَما نَحن إِلّا فيه مِن صورِ الفنا",88,"ا",1,0],["هو الكعبة الغراء دوما يحجها","ذو والحجر عالو الكعب ثم بنو الغبرا",89,"ر",2,0],["هو الكامل المشهور احمد فارس","هو الفاضل المشكور والمتأدب",90,"ب",1,0],["هو الكامل ابن الكاملين اعدهم","إلى عمر الفاروق لامتوهما",91,"م",2,0],["هُوَ الْكَمَالُ الَّذِيْ رَبَّاهُ خَالِقُهُ","وَقَدْ أَتانَا بِهَذَا خَيْرُ بُرْهَانِ",92,"ن",1,0],["هو الكرمة الأولى على ملعب البلى","تحسّى حميّاها تقيٌّ وفاجر",93,"ر",1,0],["هو الكريم الذي ما ردَّ حاجبهُ","ولم يشن منهُ بالمنِّ والسأمِ",94,"م",1,0],["هُوَ الَكَرِيْمُ إِذَاْ الْفُرْسَاْنُ قَدْ تَعِبَتْ","وَالْخَيْلُ هُدَّتْ مِنَ الْأَسْفَاْرِ وَالسَّلَبِ",95,"ب",1,0],["هُوَ الْكِنَاْنُ إِذَاْ أَشْقَتْكَ عَاْصِفَةٌ","هُوَ الْبَنَاْنُ أَسَاْلَ الصَّخْرَ فِيْ الْعُلَبِ",95,"ب",1,0],["هو الكريمُ الذي ما خابَ سائلُهُ","سبحانَهُ كلُّ ما في الكونِ من كَرَمِه",96,"م",2,0],["هو الكبيرُ الذي تَسمو الحياةُ بهِ","ويُنبِتُ الجيلُ غاباتٍ وصفصافا",97,"ف",2,0],["هو الكثيرُ الذي مَا قَلَّ موردُهُ","وما قَلَى مَن عَليهِ جارَ أو جَافى",97,"ف",2,0],["هو الكوكب الدرّي فافخر بمثله","إذا جنَّ ليل الجاهلية أسودا",98,"د",2,0],["هو الكريم على الله وفي الذك","ر الكريم له الترديد في الكلم",99,"م",1,0],["هو الكبير فلا سلطان يبلغه","طالت حميّته كلّ الملاعينِ",100,"ن",1,0],["هو الكَونُ فيه العُسْرُ واليُسْرُ دائِماً","وبِاللّهِ تَجْنِي اليُسْرَ ، والعُسْرَ تَنفُضُ",101,"ض",1,0],["[ هوَ الكَوْكَبُ الدُّرِّيُّ وَالمَلِكُ الَّذِي","لَهُ مِنْ سُلَيْمانٍ وَعُثْمانَ مَفْخَرُ ]",102,"ر",1,0],["هو الكريم الذي عزّت جوانبه","هو اللبيب وكشّاف الخفيّات",103,"ت",1,0],["هو الكنز لم يعرفه في الخلق غيره","فلولاه ما تم الوجود لموجد",104,"د",1,0],["هو الكاشف الغمى هو الواهب الغنى","هو الوازع العظمى هو المحك الألوى",105,"و",2,0],["هو الكون عَسْفٌ وعطفٌ معاً","وإلا لَمَا كان لي يُلهمُ",106,"م",1,0],["هو الكميُّ إذا ساقُ الوغى انكشفت","وإن بدتَ ساق غيد الحي لم يَفِلِ",107,"ل",1,0],["هو الكهف الذي آوي إليه","ملاذي حين يُقصيني الزمان",108,"ن",1,0]]}