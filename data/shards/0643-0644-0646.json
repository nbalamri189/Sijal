//www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[458,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[458,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[458,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[461,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[468,"يا معاذي حقا ويا أستاذي","https://www.aldiwan.net/poem60142.html","الخفيف"],[479,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[479,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[479,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[500,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[500,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[505,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[538,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[558,"إنما نحن ربنا في شئونه","https://www.aldiwan.net/poem33689.html","المديد"],[558,"كلنا بالتخصيص والتعميم","https://www.aldiwan.net/poem33852.html","الخفيف"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[558,"ملكوت السماء والأرض","https://www.aldiwan.net/poem34415.html","الخفيف"],[558,"كلنا واحد هو الأمر","https://www.aldiwan.net/poem34497.html","الخفيف"],[558,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[558,"بوجودي فغذني يا قوتي","https://www.aldiwan.net/poem34717.html","الخفيف"],[558,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"],[562,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[562,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[562,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[562,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[567,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[575,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"]],"verses":[["كِلْنِي لِعِلْمِي فِي صِحَابِي إِنَّنِي","بِهْمُ خَبيرٌ مَاهِرٌ وَمُجَرِّبُ",0,"ب",1,0],["كُلُّنا بُلِّغَ ما أَمَّلَهُ","فَابلُغِ الغايَةَ مِن كُلِّ أَمَل",1,"ل",1,0],["كلُّ نَاجٍ إِلَى مَدى","لاحِقٌ بِالَّذِي ثوى",2,"و",2,0],["كلنا خابطون في ظلمات","حائر بائر بهنّ الدليل",3,"ل",1,0],["كل نعماء غير نعماك عندِي","في صِلاة الصَّلاة مثل الخداج",4,"ج",1,0],["كلنا في محبَّة ابن عليّ","يتوالى والجود منه يزيد",5,"د",1,0],["كلُّ نفسٍ لِمَوْقِتِ","ليسَ حيٌّ بِمُفْلِتِ",6,"ت",1,1],["كُلُّ نَجمٍ لا اِهتِداءَ بِهِ","لا أُبالي لاحَ أَو غَرُبا",7,"ب",2,0],["كُلُّ نَهرٍ لا اِرتِواءَ بِهِ","لا أُبالي سالَ أَو نَضَبا",7,"ب",2,0],["كُلُّنا مُنتَظِرٌ ساعَتَهُ","وَالمَصيرُ الحَقُّ ما نَنتَظِرُ",8,"ر",1,0],["كُلُّ نَجمٍ إِلى الأُفولِ وَلَكِن","آفَةُ النَجمِ أَن يَخافَ الأُفولا",9,"ل",2,0],["كُلُّ نَفسٍ لَم يُشرِقِ الحُبُّ فيها","هِيَ نَفسٌ لَم تَدرِ ما مَعناها",10,"ا",3,0],["كُلُّ نَجمٍ يَكونُ مِن قَبلِ أَن يَب","دو سَديماً عَنِ العُيونِ خَفِيّا",11,"ي",2,0],["كُلُّ نارٍ غَيرُ نارِ ال","عِشقِ بَردٌ وَسَلامُ",12,"م",1,0],["كلٌّ نَسُوكَ ولم يعودوا","يذكرونكَ في الحَيَاةْ",13,"ه",1,0],["كلنا مؤمن يسبح للرحمن","في ظل عرشه الممدود",14,"د",1,0],["كلنا ننتظر الموت به","زاحما آخرنا اولنا",15,"ن",2,0],["كلنا يسعى ان يعيش سعيدا","كلنا يهوى بالحياة انتفاعا",16,"ع",2,0],["كلنا من بكى أباه وكل","بعد حين مودّع مبكى",17,"ا",1,0],["كُلُّنا وارِدُ السَرابِ وَكُلٌّ","حَمَلٌ في وَليمَةِ الذِئبِ طاعِم",18,"م",1,0],["كُلُّنا إِلَيهِ غَداً","لَيسَ بِالبَعيدِ غَدُ",19,"د",1,0],["كَلِن تَرَفَّعتُ قَدراً عَنكَ أَنَّ أَبي","نَجدٌ كَريمٌ وَجَدّي سادَ مَن سَبَقَه",20,"ق",2,0],["كُلُّ نَفسٍ سَتُوَفّى سَعيَها","وَلَها ميقاتُ يَومٍ قَد وَجَب",21,"ب",1,0],["كُلُّ نَفسٍ سَتُقاسي مَرَّةً","كُرَبَ المَوتِ فَلِلمَوتِ كُرَب",21,"ب",1,0],["كُلُّنا في غَفلَةٍ وَال","مَوتُ يَغدِ وَيَروحُ",22,"ح",1,0],["كُلُّ نَطّاحٍ مِنَ الدَه","رِ لَهُ يَومٌ نَطوحُ",22,"ح",1,0],["كُلُّنا صائِرٌ إِلى المَلِكِ الدَي","يانِ رَبِّ الأَربابِ يَومَ الوَعيدِ",23,"د",1,0],["كُلُّنا يُكثِرُ المَذَمَّةَ لِلدُن","يا وَكُلٌّ بِحُبِّها مَفتونُ",24,"ن",1,0],["كِلنا لَهُ فِضَّةً بِالكَفِّ فاضِلَةً","عَنّا وَكال لَنا مِن دونِهِ ذَهَبا",25,"ب",2,0],["كلّ نارٍ كانتْ من الغزو تذكى","خمِدتْ في حسامهِ المَشْرَفيِّ",26,"ي",1,0],["كلّ نوّاحةٍ عليكَ حشاها","حَشْوُهُ منك كلّ داءٍ دَويِّ",26,"ي",1,0],["كلّ نفسٍ رَمِيّةٌ لزَمانٍ","قدر سهم له فَقل كيف يرمي",27,"ي",1,0],["كلّ نمّامةِ الرياح تلاقي","منه أنفاسَ روضةٍ تَتَضَوَّع",28,"ع",1,0],["كلُّ نافي العمر في شِرَّتِهِ","للصِّبَا نارٌ وفي الوَجْنَةِ نور",29,"ر",1,0],["كُلُّنَا لِلْفَنَاءِ أَوْ تَصْعَق الأَرْ","ضُ وَتَأْتِي بَعْدَ الشُّؤُونِ شُؤُونُ",30,"ن",1,0],["كلُّ نفسٍ دُونه فيما ادَّعى","كلُّ حقٍّ باطلٌ فيما زَعمْ",31,"م",1,0],["كُلُّنا يُعجبُ","بِفَتى المَغربِ",32,"ب",1,0],["كُلُّنا يَطربُ","لانتصار الأَبي",32,"ي",1,0],["كلُّ نفسٍ منها ابتهال وسؤْلٌ","ودُعاءٌ وَرَغْبَة وَابْتِغَاءُ",33,"ا",2,0],["كلُّ نَدْبٍ لوْ حَكَى غَرْبَهُ السَّيْ","فُ لَمَا اسْتصحبَ سَيْفٌ قِرَابا",34,"ب",2,0],["كلُّنا نَبْشَعُ من كأس الرَّدى","غير أنّا لا نَرانا نَسْتَبِدّ",35,"د",1,0],["كُلُّ ناعٍ فَسَيُنعى","كُلُّ باكٍ فَسَيُبكى",36,"ا",1,1],["كلّنا يا ابنَ حُديج","لكَ في العلم خوَل",37,"ل",1,1],["كُلُّنا يَشهَدُ الإِلهُ كَسيرٌ","يَتَرَجّى بِضُعفِ رَأيٍ جُبورا",38,"ر",2,0],["كُلُّنا غادِرٌ يَميلُ إِلى الظُل","مِ وَصَفوُ الأَيّامِ لِلتَعكيرِ",39,"ر",1,0],["كُلُّنا لا يَبُرُّها بِمَقالٍ","فَاِعذُروها إِذ لَيسَ بِالفِعلِ تَحنو",40,"ن",2,0],["كلنا مشتاق إليها ولكن","لا تضاهي أَشواقكم أَشواقي",41,"ي",1,0],["كلّ نَبتٍ عبقريٍّ أطلَعت","جعلت منه طعاماً للحسَد",42,"د",1,0],["كلُّ نجم مهجةٌ تهفو وعينٌ لا تنامْ","وشعاعُ البدر معشوقٌ به جُنَّ الغمامْ",43,"م",1,0],["كلُّ نَوْعٍ مِنَ العَطَاءِ لَهُ حُسْنٌ","وَخَيْرٌ أَلاَّ يُذَاعَ الجَميلُ",44,"ل",1,0],["كلُّ نَجمٍ مِلءُ العُيُونِ ظهُوراً","بِسَنَاهُ وَمَا مُنُاهُ الظُّهُورُ",45,"ر",1,0],["كُلُّ نُور يَخْبُو وَنُورهُمَا فِي ال","ذِّكْرِ أَبْقَى مِنْ كُلِّ نُورٍ وَأَهْدَى",46,"د",2,0],["كُلُّ نَفْسٍ وَجَمَتْ مِنْ خَشْيَةٍ","وَأَحَسَّتْ مَا تُعَانِي مِنْ بَلاَءْ",47,"ا",2,0],["كل نَوْحٍ لَهُ صَدى فِي فؤَادِي","وَجَوَابٌ مِنْ عَبْرَتِي وَمِدَادِي",48,"ي",1,1],["كُلُّنا ناحِلٌ فأنت بَرَاكَ الله","لَكِنْ أنا بَرَانِي السَّقَامُ",49,"م",1,0],["كُلُّ نيقٍ في أَنيقٍ","أَنا لَيثٌ بَينَ أَروى",50,"و",2,0],["كلنا مَسَّه من الدهر ظُفْرٌ","آهِ من ظُفْرِه ومن فَتَكاته",51,"ت",2,0],["كلّنا في الضياع والتيه فانهض :","ويدي في يدك نرفع منارا",52,"ر",2,0],["كلّنا يهوى الهنا لكنّنا","كلّما رمنا الهنا غاب المرام",53,"م",1,0],["كلّنا في السرى حيارى ولكن","كلّنا في انتظار ميلاد فجر",54,"ر",1,0],["كلّنا في انتظار فجر حبيب","وانتظار الحبيب بصبى ويغري",54,"ر",2,0],["كلُّنا في الجْمود والجهل وحشيون","لكنْ حقوقنا مدنيه",55,"ي",2,0],["كلُّنا في النفاقِ والختلِ نُبدي","كلَّ يوم مهارة فنيه",55,"ي",2,0],["كلُّنا بالذي تمنى سعيد","لا نبالي أن البلاد شقيه",55,"ي",2,0],["كلُّنا نحسُدُكم أن نِلْتُمُ","شَرَفَ الفُرصةِ – من قبلُ – اهتبالا",56,"ل",2,0],["كلُّنا نمشي على آثارِكمْ","بالضَحيّات خفافاً وثِقالا",56,"ل",2,0],["كلّ نجم إلى الأقوال ولكنّ","آفة النّجم أن يخاف الأقولا",57,"ل",2,0],["كلنا في أمواج بحرك نفني","ثم لا يفنى بحرك القمقام",58,"م",1,0],["كلّ نور غير نور مرّ بالأعين وسنى","يا رفيقي ، أنت راعيت فجري صار أسنى",59,"ن",2,0],["كُلُّنَا لِلْفَنَاءِ، أَوْ تَصْعَقَ الأَرْ","ضُ ، وتأتي بعدَ الشئون شؤونُ",60,"ن",1,0],["كلّ نطقي وان يقال جدا لا","هي هذي اقول اين زماني",61,"ن",2,0],["كل نشر لا بد يطوى وقد يغ","دو بآن كون الوجود زوالا",62,"ل",2,0],["كلُنا عبدٌ لعُمرِه","كلُنا يَسعى لدَهرِه",63,"ر",2,1],["كلُّنا أسرى حياةٍ","أذهلتنا عن نُشور",64,"ر",1,0],["كل نورٍ للشمسِ والبدرِ يَبدُو","أنتَ أصلٌ لهُ ومِنكَ استعيرا",65,"ر",2,0],["كِلنا لَهُ بِالصاعِ إِذ كالَها","وَما ظَلَمناهُ بِها أَوَعا",66,"ع",2,0],["كلنُّا نجعلُ الظنونَ يقينا","ويقينُ الأمور يُجعَلُ ظنَّا",67,"ن",2,0],["كلُّ نَوْعٍ فيهِ مِنَ الحُسْنِ أَنْوا","عٌ وَمَجْمُوعُها بِلا تَفْريقِ",68,"ق",1,0],["كلنا فوقها رهن الزوال فلا","أضلّ بعد الكفى من سعي مزداد",69,"د",1,0],["كُلُّ نَفسٍ في دَهرِها رَهنُ يَومٍ","يَترُكُ الدَهرَ بِالَّذي فيهِ بُطلا",70,"ل",2,0],["كلُّ نقصٍ عنه تنزّه قدماً","وَكمالُ السنا له والسناءُ",71,"ا",2,0],["كل نار في فؤادٍ","هي من لفح لظاها",72,"ا",3,0],["كُلُّ نَذلٍ مُستَبَدٍّ","في مُحَيّاهُ عَلامَه",73,"م",2,0],["كلُّ نفسٍ لها كتابٌ وميعا","دٌ إذا جاءَ لا يُرَدُّ قَضاءُ",74,"ا",2,0],["كُلُّ نُحولِ جسمي","مِن خَصرِكَ النَحيلِ",75,"ل",1,0],["كلُّ نُصْحٍ، باتَ أَمْرا","منكَ رأياً، من لَبيبِ",76,"ب",1,0],["كل نهب الطلى مباح حتى الرأ","س حريب الآذان والأكتاف",77,"ف",1,0],["كلّنا في جماله ذو هيامِ","وعلينا من حبّه دار كأسُ",78,"س",1,1],["كِلْنِي إِلى عُنْفِ الصُّدُودِ فَرُبَّما","كانَ الصُّدُودُ مِنَ النَّوى بِي أَرْفَقا",79,"ق",2,0],["كلّنا واردٌ حياض المنايا","ذائقٌ ضاع جهدُه بالمحال",80,"ل",1,0],["كلنا يفنى ولن تبقي","يدُ الأيامِ نفسا",81,"س",2,0],["كُلُّ نجمٍ سَيَعتَريه أفولُ","وَقُصارى سفر البَقاء القفولُ",82,"ل",1,1],["كلُّنا للتردى ولم تُخلَق الأَع","لالُ إلاّ ما بيننا سفراءَ",83,"ا",2,0],["كلنا نستغفر اللَه لما","قد عملناه ملاء أو خلا",84,"ل",2,0],["كلنا عطف عليها","وهي لا ترحمنا",85,"ن",2,0],["كلنا في الحياة يخشى من المو","ت فيا فرحتا لأهل القبور",86,"ر",1,0],["كُلُّ نَعيمٍ وَكُلُّ عَيش","قَبلَ الثَلاثينَ يُستَطابُ",87,"ب",1,0],["كُلٌّ نفيسٌ وفرقُ بَينكُما","أنّك فَرْدٌ وتلك أشْباه",88,"ا",2,0],["كلٌّ نَفيسٌ فليس الفَرقُ بينكما","إلاّ بأنّك فَرْدٌ وهْيَ أَشْباه",89,"ا",2,0],["كلُّ نَفسٍ لها رَجاءٌ مِن ال","لهِ إذا اصبحَت تُشيرُ إِلَيهِ",90,"ي",2,0],["كل نظمٍ بغيركم غيرُ عذبٍ","ونثارٍ بغيركم فهْو صاب",91,"ب",1,0],["كل نفسٍ أتت بغير صوابٍ","بطريق الصلاح فيه تُعاب",91,"ب",1,0],["كلنا أموات لكن بخت من قدم إحسان","من فعاله ومن قوله وفي قلبه إيمان",92,"ن",1,1],["كلُّنا في مدائن الصَّمْت صرن","بانكساراتنا نُدير ال