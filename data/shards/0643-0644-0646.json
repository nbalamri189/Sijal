shqas&qid=79570&r=&rc=26",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""],[2220,"يا هلال الدياجِ لحْ بالنهارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11413&r=&rc=287",""],[5001,"أيها الساري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80724&r=&rc=14",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""],[6344,"سلالم الشَّك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87968&r=&rc=8",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["كِلْنِي لِعِلْمِي فِي صِحَابِي إِنَّنِي","بِهْمُ خَبيرٌ مَاهِرٌ وَمُجَرِّبُ",0,"ب",1,0],["كُلُّنا بُلِّغَ ما أَمَّلَهُ","فَابلُغِ الغايَةَ مِن كُلِّ أَمَل",1,"ل",1,0],["كلُّ نَاجٍ إِلَى مَدى","لاحِقٌ بِالَّذِي ثوى",2,"و",2,0],["كلنا خابطون في ظلمات","حائر بائر بهنّ الدليل",3,"ل",1,0],["كل نعماء غير نعماك عندِي","في صِلاة الصَّلاة مثل الخداج",4,"ج",1,0],["كلنا في محبَّة ابن عليّ","يتوالى والجود منه يزيد",5,"د",1,0],["كلُّ نفسٍ لِمَوْقِتِ","ليسَ حيٌّ بِمُفْلِتِ",6,"ت",1,1],["كُلُّ نَجمٍ لا اِهتِداءَ بِهِ","لا أُبالي لاحَ أَو غَرُبا",7,"ب",2,0],["كُلُّ نَهرٍ لا اِرتِواءَ بِهِ","لا أُبالي سالَ أَو نَضَبا",7,"ب",2,0],["كُلُّنا مُنتَظِرٌ ساعَتَهُ","وَالمَصيرُ الحَقُّ ما نَنتَظِرُ",8,"ر",1,0],["كُلُّ نَجمٍ إِلى الأُفولِ وَلَكِن","آفَةُ النَجمِ أَن يَخافَ الأُفولا",9,"ل",2,0],["كُلُّ نَفسٍ لَم يُشرِقِ الحُبُّ فيها","هِيَ نَفسٌ لَم تَدرِ ما مَعناها",10,"ا",3,0],["كُلُّ نَجمٍ يَكونُ مِن قَبلِ أَن يَب","دو سَديماً عَنِ العُيونِ خَفِيّا",11,"ي",2,0],["كُلُّ نارٍ غَيرُ نارِ ال","عِشقِ بَردٌ وَسَلامُ",12,"م",1,0],["كلٌّ نَسُوكَ ولم يعودوا","يذكرونكَ في الحَيَاةْ",13,"ه",1,0],["كلنا مؤمن يسبح للرحمن","في ظل عرشه الممدود",14,"د",1,0],["كلنا ننتظر الموت به","زاحما آخرنا اولنا",15,"ن",2,0],["كلنا يسعى ان يعيش سعيدا","كلنا يهوى بالحياة انتفاعا",16,"ع",2,0],["كلنا من بكى أباه وكل","بعد حين مودّع مبكى",17,"ا",1,0],["كُلُّنا وارِدُ السَرابِ وَكُلٌّ","حَمَلٌ في وَليمَةِ الذِئبِ طاعِم",18,"م",1,0],["كُلُّنا إِلَيهِ غَداً","لَيسَ بِالبَعيدِ غَدُ",19,"د",1,0],["كَلِن تَرَفَّعتُ قَدراً عَنكَ أَنَّ أَبي","نَجدٌ كَريمٌ وَجَدّي سادَ مَن سَبَقَه",20,"ق",2,0],["كُلُّ نَفسٍ سَتُوَفّى سَعيَها","وَلَها ميقاتُ يَومٍ قَد وَجَب",21,"ب",1,0],["كُلُّ نَفسٍ سَتُقاسي مَرَّةً","كُرَبَ المَوتِ فَلِلمَوتِ كُرَب",21,"ب",1,0],["كُلُّنا في غَفلَةٍ وَال","مَوتُ يَغدِ وَيَروحُ",22,"ح",1,0],["كُلُّ نَطّاحٍ مِنَ الدَه","رِ لَهُ يَومٌ نَطوحُ",22,"ح",1,0],["كُلُّنا صائِرٌ إِلى المَلِكِ الدَي","يانِ رَبِّ الأَربابِ يَومَ الوَعيدِ",23,"د",1,0],["كُلُّنا يُكثِرُ المَذَمَّةَ لِلدُن","يا وَكُلٌّ بِحُبِّها مَفتونُ",24,"ن",1,0],["كِلنا لَهُ فِضَّةً بِالكَفِّ فاضِلَةً","عَنّا وَكال لَنا مِن دونِهِ ذَهَبا",25,"ب",2,0],["كلّ نارٍ كانتْ من الغزو تذكى","خمِدتْ في حسامهِ المَشْرَفيِّ",26,"ي",1,0],["كلّ نوّاحةٍ عليكَ حشاها","حَشْوُهُ منك كلّ داءٍ دَويِّ",26,"ي",1,0],["كلّ نفسٍ رَمِيّةٌ لزَمانٍ","قدر سهم له فَقل كيف يرمي",27,"م",2,0],["كلّ نمّامةِ الرياح تلاقي","منه أنفاسَ روضةٍ تَتَضَوَّع",28,"ع",1,0],["كلُّ نافي العمر في شِرَّتِهِ","للصِّبَا نارٌ وفي الوَجْنَةِ نور",29,"ر",1,0],["كُلُّنَا لِلْفَنَاءِ أَوْ تَصْعَق الأَرْ","ضُ وَتَأْتِي بَعْدَ الشُّؤُونِ شُؤُونُ",30,"ن",1,0],["كلُّ نفسٍ دُونه فيما ادَّعى","كلُّ حقٍّ باطلٌ فيما زَعمْ",31,"م",1,0],["كُلُّنا يُعجبُ","بِفَتى المَغربِ",32,"ب",1,0],["كُلُّنا يَطربُ","لانتصار الأَبي",32,"ي",1,0],["كلُّ نفسٍ منها ابتهال وسؤْلٌ","ودُعاءٌ وَرَغْبَة وَابْتِغَاءُ",33,"ا",2,0],["كلُّ نَدْبٍ لوْ حَكَى غَرْبَهُ السَّيْ","فُ لَمَا اسْتصحبَ سَيْفٌ قِرَابا",34,"ب",2,0],["كلُّنا نَبْشَعُ من كأس الرَّدى","غير أنّا لا نَرانا نَسْتَبِدّ",35,"د",1,0],["كُلُّ ناعٍ فَسَيُنعى","كُلُّ باكٍ فَسَيُبكى",36,"ا",1,1],["كلّنا يا ابنَ حُديج","لكَ في العلم خوَل",37,"ل",1,1],["كُلُّنا يَشهَدُ الإِلهُ كَسيرٌ","يَتَرَجّى بِضُعفِ رَأيٍ جُبورا",38,"ر",2,0],["كُلُّنا غادِرٌ يَميلُ إِلى الظُل","مِ وَصَفوُ الأَيّامِ لِلتَعكيرِ",39,"ر",1,0],["كُلُّنا لا يَبُرُّها بِمَقالٍ","فَاِعذُروها إِذ لَيسَ بِالفِعلِ تَحنو",40,"ن",2,0],["كلنا مشتاق إليها ولكن","لا تضاهي أَشواقكم أَشواقي",41,"ق",2,0],["كلّ نَبتٍ عبقريٍّ أطلَعت","جعلت منه طعاماً للحسَد",42,"د",1,0],["كلُّ نجم مهجةٌ تهفو وعينٌ لا تنامْ","وشعاعُ البدر معشوقٌ به جُنَّ الغمامْ",43,"م",1,0],["كلُّ نَوْعٍ مِنَ العَطَاءِ لَهُ حُسْنٌ","وَخَيْرٌ أَلاَّ يُذَاعَ الجَميلُ",44,"ل",1,0],["كلُّ نَجمٍ مِلءُ العُيُونِ ظهُوراً","بِسَنَاهُ وَمَا مُنُاهُ الظُّهُورُ",45,"ر",1,0],["كُلُّ نُور يَخْبُو وَنُورهُمَا فِي ال","ذِّكْرِ أَبْقَى مِنْ كُلِّ نُورٍ وَأَهْدَى",46,"د",2,0],["كُلُّ نَفْسٍ وَجَمَتْ مِنْ خَشْيَةٍ","وَأَحَسَّتْ مَا تُعَانِي مِنْ بَلاَءْ",47,"ا",2,0],["كل نَوْحٍ لَهُ صَدى فِي فؤَادِي","وَجَوَابٌ مِنْ عَبْرَتِي وَمِدَادِي",48,"د",2,1],["كُلُّنا ناحِلٌ فأنت بَرَاكَ الله","لَكِنْ أنا بَرَانِي السَّقَامُ",49,"م",1,0],["كُلُّ نيقٍ في أَنيقٍ","أَنا لَيثٌ بَينَ أَروى",50,"و",2,0],["كلنا مَسَّه من الدهر ظُفْرٌ","آهِ من ظُفْرِه ومن فَتَكاته",51,"ت",2,0],["كلّنا في الضياع والتيه فانهض :","ويدي في يدك نرفع منارا",52,"ر",2,0],["كلّنا يهوى الهنا لكنّنا","كلّما رمنا الهنا غاب المرام",53,"م",1,0],["كلّنا في السرى حيارى ولكن","كلّنا في انتظار ميلاد فجر",54,"ر",1,0],["كلّنا في انتظار فجر حبيب","وانتظار الحبيب بصبى ويغري",54,"ر",2,0],["كلُّنا في الجْمود والجهل وحشيون","لكنْ حقوقنا مدنيه",55,"ي",2,0],["كلُّنا في النفاقِ والختلِ نُبدي","كلَّ يوم مهارة فنيه",55,"ي",2,0],["كلُّنا بالذي تمنى سعيد","لا نبالي أن البلاد شقيه",55,"ي",2,0],["كلُّنا نحسُدُكم أن نِلْتُمُ","شَرَفَ الفُرصةِ – من قبلُ – اهتبالا",56,"ل",2,0],["كلُّنا نمشي على آثارِكمْ","بالضَحيّات خفافاً وثِقالا",56,"ل",2,0],["كلّ نجم إلى الأقوال ولكنّ","آفة النّجم أن يخاف الأقولا",57,"ل",2,0],["كلنا في أمواج بحرك نفني","ثم لا يفنى بحرك القمقام",58,"م",1,0],["كلّ نور غير نور مرّ بالأعين وسنى","يا رفيقي ، أنت راعيت فجري صار أسنى",59,"ن",2,0],["كُلُّنَا لِلْفَنَاءِ، أَوْ تَصْعَقَ الأَرْ","ضُ ، وتأتي بعدَ الشئون شؤونُ",60,"ن",1,0],["كلّ نطقي وان يقال جدا لا","هي هذي اقول اين زماني",61,"ن",2,0],["كل نشر لا بد يطوى وقد يغ","دو بآن كون الوجود زوالا",62,"ل",2,0],["كلُنا عبدٌ لعُم