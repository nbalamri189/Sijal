{"poems":[[74,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[53,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[76,"خذها يرن لها الجواد صهيلا","https://www.aldiwan.net/poem13220.html","الكامل"],[83,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39542","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[92,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[164,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[164,"يا من لدمع مارقي وصبيبه","https://www.aldiwan.net/poem58943.html","الكامل"],[201,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[203,"لك أن تشا وعلي أن لا أجزعا","https://www.aldiwan.net/poem45648.html","الكامل"],[240,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[242,"رد فضل ذي العرش المجيد","https://www.aldiwan.net/poem18156.html","مجزوء الكامل"],[276,"ألف التذكر مبدئا ومعيدا","https://www.aldiwan.net/poem52063.html","الكامل"],[347,"أو ما رأيت إلى شئونه","https://www.aldiwan.net/poem55342.html","مجزوء الكامل"],[347,"نقالة الموتى وما نقلت","https://www.aldiwan.net/poem55347.html","أحذ الكامل"],[411,"عاجلت ثوب علاك بالتوسيخ","https://www.aldiwan.net/poem50011.html","الكامل"],[445,"قل للهوى حكمت فاحكم لي","https://www.aldiwan.net/poem34825.html","أحذ الكامل"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123698","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74064","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86462","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81709","الكامل"],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""]],"verses":[["وأصخ لمدحة ناظمٍ في حجرِها","آوى يتيم النظم غير مسفه",0,"ه",1,0],["وأصخْ إلى مَثَلِي فإني ضاربٌ","مثلاً ومنك الفهمُ والتفهيمُ",1,"م",1,0],["وَأَصِخ إِلى سَجعِ القَريضِ فَرُبَّما","نَدبَ القَريضُ مِنَ الوَفاءِ هَديلا",2,"ل",2,0],["وَأَصِخ وَطارِحني الشُجونَ وَغَنِّني","بِهِمُ وَنازِعني أَفاويقَ السُرى",3,"ر",2,0],["وأصختُ للنسماتِ وهي هوازجٌ","فسمعتُ قصفَ العاصفِ المجنونِ",4,"ن",1,0],["واصخبي في شعابِ قلبي وضجِّي","فوق آلامه الجسام وثوري",5,"ر",2,0],["وأصخنا تفسّر الوهم بالأوهام","والظنّ بالظنون الرواجم",6,"م",1,0],["وأصَخْتُ سَمعاً للنُعاة وليتنَني","من أجل يومِكَ كنتُ غيرَ سميع",7,"ع",1,0],["وأصخت سمعك للخطيب ووعظهِ","من حينَ بداته إلى الإِتمامَ",8,"م",1,0],["وأَصخ لصوتٍ العندليب فقد شذا","وارم الغراب مسكتا لنعيبه",9,"ب",2,0],["وأصخ لي واتخذني","يا أخا البؤس خليلا",10,"ل",2,0],["وأصخ لشعري إن رحمتَ فلم يزلْ","شعري يحنُّ إليكَ حتى تسمعا",11,"ع",2,0],["وَأَصِخ إِلى عَذراءَ ناهِدَةٍ","حَلِيَت بِمَدحِكَ حُرَّةٍ بِكرِ",12,"ر",1,0],["وَأَصِخ لِمَدحِ مُفَوَّهٍ","تَرضى بِهِ غَيباً وَمَشهَد",13,"د",1,0],["وَأَصِخْ لِمَنْ نَادَاكُمُ","بِنَتَائِجِ الْفِكْرِ الْبَلِيدْ",14,"د",1,0],["وأصخ نقص عليك من انبائها","ما كانَ منها قائما وَحيدا",15,"د",2,0],["وأصخ الى زفراته","حرى واصغ إلى انينه",16,"ن",2,0],["واصخ إلى الأرواح ثائرة","غضبي على ما يصنع البشر",17,"ر",1,0],["وأصخْتَ للواشي فزَوَّقَ ما اشْتَهى","والحُرُّ للوَاشينَ غَيرُ مُصيخِ",18,"خ",1,0],["وأَصِخْ لِمَظْلَمَتِي فقد وَضَحَتْ","واسمَعْ فعندِي شاهِدا عَدْلِ",19,"ل",1,0],["وَأَصِخ وُقيتَ بِنا لقافيةٍ","تَبقى بقاءَ صُخورها الصمِّ",20,"م",1,0],["وأصخ إلى الناي الرخيم ممازجاً","للعود والسنطير في دقاته",21,"ت",2,0],["وَأصِخ لِفَائدةٍ جَلِيلٍ قَدرُهَا","تُهدِيكَ للتَّحقِيقِ وَالعِرفَانِ",22,"ن",1,0],["وَأَصِخ لِصَوت كبارها","وَصِغارها عندَ التناد",23,"د",1,0],["واصخ لها عربية تهدي الثنا","ء معطراً من كل قافية شرود",24,"د",1,0],["واصخت للبشرى فأوقر مسمعي","ناعيك في نوح وفي تغريد",25,"د",1,0],["وأصِخْ لما يُملي لسان الحالِ مِنْ","حِكَمٍ ورُبَّ مقالةٍ لم تُلْفَظِ",26,"ظ",1,0],["وأصخنا سمعاً إليها فقالت","حين ولت تمشي على استحياء",27,"ا",2,0],["وأصخ تسمع على أرجائه","صيحة الهول ولحن الوتر",28,"ر",1,0]]}