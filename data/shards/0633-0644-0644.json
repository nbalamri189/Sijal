{"poems":[[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[63,"مزجنا دماء بالدموع السواجم","https://www.aldiwan.net/poem45816.html","الطويل"],[77,"أخذت وأمواج الردى متلاطمة","https://www.aldiwan.net/poem36100.html","الطويل"],[77,"نهضوا وقد جن االدجى وتخالفت","https://www.aldiwan.net/poem36353.html","الكامل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[89,"ولما سعى الساعون أن نهجر الوغى","https://www.aldiwan.net/poem45088.html","الطويل"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[85,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[85,"جبريل هلل في السماء وكبر","https://www.aldiwan.net/poem63765.html","الكامل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[77,"زمانك أفراح لدينا وأعياد","https://www.poetsgate.com/ViewPoem.aspx?id=33809",""],[45,"أمَا مُعِينٌ على الشّوقِ الذي غَرِيَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=31603",""],[144,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[156,"بياض خديك موصول بصدغين","https://www.aldiwan.net/poem55509.html","البسيط"],[161,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[194,"رب جنين من جنى النمير","https://www.aldiwan.net/poem13053.html","الرجز"],[230,"عاقب بما شئت سوى الهجر","https://www.aldiwan.net/poem51028.html","السريع"],[281,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[282,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[283,"سللت علينا باللحاظ خناجرا","https://www.aldiwan.net/poem32775.html","الطويل"],[306,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[365,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[365,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[404,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[430,"الا دع يا ابن كلثوم فخارا","https://www.aldiwan.net/poem40806.html","الوافر"],[440,"شيما سنا البارق المنهل فالتمحا","https://www.aldiwan.net/poem34813.html","البسيط"],[459,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[462,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[469,"لقد جار ما تشكوه في الحكم واعتدا","https://www.aldiwan.net/poem60213.html","الطويل"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[516,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[552,"جلب البرق لقلبي","https://www.aldiwan.net/poem47298.html","مجزوء الرمل"],[552,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"]],"verses":[["سَلَلنا رِقابَ العيسِ مِن خَلَلِ الدُجى","تُلاعِبُها أَشطانُها وَالمَقاوِدُ",0,"د",1,0],["سَلَلتَ عَلَيهِ الحَزمَ حَتّى جَلَوتَهُ","كَما اِنجابَ غَيمُ العارِضِ المُتَراكِبِ",1,"ب",1,0],["سَلَلنا النَواظِرَ في عَرضِهِ","فَطَوَّلَ مِن شَأوِها المُنتَضى",2,"ا",1,0],["سَلَلنَ بِأَيدي المُشرِكينَ قواضِباً","سَتُغمَدُ مِنهُم في الطُّلَى وَالجماجِمِ",3,"م",1,0],["سَلَلْتُ لِنَصْرِي مِنْ عُلاَكَ مهندا","كَفَفْتُ بِهِ كَفّاً مِنَ الْبَغْيِ ظَالِمَهْ",4,"م",2,0],["سَلْلنِي عَنِ الْمُنْبَتِّ حِينَ تَقَطَّعَتْ","أَسْبَابُهُ تِيهاً وَلاَ مَنْ يَسْأَلُ",5,"ل",1,0],["سَلَلْتَ حُسامَ العَضْدِ والقُطْرُ راجِفٌ","وللرّوْعِ إنبْراقٌ علَيْهِ وإرْعادُ",6,"د",1,0],["سللت صارم رأيٍ قد أزلت به","ما كان في السيل من طيش ومن نزق",7,"ق",1,0],["سللت لنصر الدين سيفَ عزيمة","فللتَ به ما لم يكن فلُّه سهلا",8,"ل",2,0],["سُلِلَت مِن وادي المُلوكِ فَاِزدَهى","وَأَلقَتِ الشَمسُ عَلَيهِ رَأدَها",9,"د",3,0],["سُلِلتَ مِنَ الحَفائِرِ قَبلَ يَومٍ","يَسُلُّ مِنَ التُرابِ الهامِدينا",10,"ن",2,0],["سَل لِلفَقيرِ عَلى تَكَرُّمِهِ الغِنى","وَاِطلُب مَزيداً في الرَخاءِ لِموسِرِ",11,"ر",1,0],["سَلَلتَ سُيوفاً عَلَّمَت كُلَّ خاطِبٍ","عَلى كُلِّ عودٍ كَيفَ يَدعو وَيَخطُبُ",12,"ب",1,0],["سَلَلتَ دونَ بَني العَبّاسَ سَيفَ وَغىً","يَدمى وَعَزماً إِذا أَضرَمتَهُ وَقَدا",13,"د",2,0],["سَلَلتَ دونَ بَني الإِسلامِ سَيفَ وَغىً","أَبرا الجَوانِحَ مِن أَوغامِها وَشَفى",14,"ف",2,0],["سَل لِلمَنازِلِ سَقيَةً","وَالرَبعِ وَالدَيرَينِ أَقوى",15,"و",2,0],["سَللتَ سيفاً على عِداكَ فما","يَقرُّ قلبُ الخلافِ من وَهَلِه",16,"ل",2,0],["سَلْ لِيجَ ما حَلَّ بأرْجائِها","فَقَدْ غَدَتْ أَرْجاؤُها بَلْقَعَا",17,"ع",2,0],["سللت حسام العضد والقطر واجف","وللروع إبراق عليه وإرعاد",18,"د",1,0],["سلَلتَ دونَ بني العبّاسِ سَيْفَ وغًى","يُدْمي، وَعَزْماً، إذا ضَرّمتَهُ وَقَدَا",19,"د",2,0],["سَلَلتُهُ وَضَرَبتُ النائِباتُ بِهِ","ما كُلُّ مَن سَلَّ سَيفاً صارِماً ضَرَبا",20,"ب",2,0],["سَلَلْتَ سَيْفاً قَتَلْتَ العالَمِينَ بِهِ","فَكَيْفَ لَوْ جَرَّدَتْ عَيْناكَ سَيْفَيْنِ",21,"ن",1,0],["سل لي الاقالة والغفران من ملك","كبائرَ الذنب في غفرانه لمم",22,"م",1,0],["سَللتُهُ مَن رَحِمِ الغَديرِ","كَأَنَّها صَفائِحُ البلّورِ",23,"ر",1,0],["سَلْ لحظَ عينيك وتفتيرَه","إن كان لي شيء من الصبر",24,"ر",1,0],["سَلَلْتَ سِهَاماً مِنْ كِنَانَةَ لَمْ تَزَلْ","يُقَرْطِس مِنْهَا فِي الْمُنى كُلُّ صَائِبِ",25,"ب",1,0],["سللت على اليأس الرجيم عزيمتي","حساماً فألقته قتيلاً مضرجا",26,"ج",2,0],["سَلَلتَ عَلَينا بِاللِّحاظِ خَناجِرا","فَقَد بَلَغَت مِنّا النُفوسُ الحَناجِرا",27,"ر",2,1],["سَللتُ لَه الحسامَ فخلتُ أنّي","أَسلتُ مِنَ المجرّةِ فيهِ نَهرا",28,"ر",2,0],["سَللْنَ سيوفاً ولاقَيْنَنا","فلا تَسألِ اليومَ ماذا لَقينا",29,"ن",2,0],["سَلَلْنَ سيوفاً من جفونٍ وِجئنَنا","يُحَيَّينَ بالألحاظِ خوفَ المُراقِب",30,"ب",1,0],["سللت من ذهني لها صارماً","ولم يفت صارمي المقتل",31,"ل",1,0],["سللن صوارم الأجناح بيضاً","فعادت من دم الحجلات حمرا",32,"ر",2,0],["سَلَلْتَهُ لِحِمى الإِسلامِ مُنْتَقِماً","مِمَّنْ عَتا فِي سبيلِ اللهِ أَوْ جَمَحا",33,"ح",2,0],["سللتَ على المال سيفَ العطاءِ","فلاحيك في الجود مستقتلُ",34,"ل",1,0],["سَلَلتَ بالعادة في جسمه","رأياً هو الصَّمصامةُ القاضبُ",35,"ب",1,0],["سللْتَ يا عضُد الدين الهُمامَ لهم","سيفاً من الرأي عضباً غير ما قَضمِ",36,"م",1,0],["سَلَلتَ حُسامُ اللَحظِ مِنها عَلى الوَرى","وَقَد كانَ أَحرى أَن يُصانَ وَيُغمَدا",37,"د",2,0],["سَلَّ للّهِ أنصُلاً في سَناها","ماحِياتٍ ظَلامَ أهلِ النِفاقِ",38,"ق",1,0],["سللتم على عباس بيض عزائم","قهرتم بها سلطانه وهو قاهر",39,"ر",1,0],["سَلّ لِلعَينين في جُنْ","ح الدُّجى سيفاً صقيلا",40,"ل",2,0],["سَللتُمْ على آلِ النبيّ سيوفَه","مُلِئْنَ ثُلوماً في الطّلى وفلولا",41,"ل",2,0],["سَل لَيلَةَ الخَيفِ هَل أَمضَيتُ آخِرَها","بِالراحِ تَحتَ نَسيمِ الخُرَّدِ الغيدِ",42,"د",1,0]]}