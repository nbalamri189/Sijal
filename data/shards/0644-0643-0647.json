{"poems":[[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[72,"يا ابن الأولى اتخذوا السماء مطامحا","https://www.aldiwan.net/poem19691.html","الكامل"],[91,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[45,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[85,"قلبٌ يذوب ، ومدمعٌ يجري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9553&r=&rc=43",""],[110,"بك يستغاث من العدا","https://www.aldiwan.net/poem16254.html","مجزوء الكامل"],[116,"لك هل من مسامت او موازي","https://www.aldiwan.net/poem40930.html","عموديه"],[129,"أهدى السلام إلى الكريم المفضل","https://www.aldiwan.net/poem50544.html","الكامل"],[199,"طرقت على علل الكرى أسماء","https://www.aldiwan.net/poem51991.html","الكامل"],[230,"السقم في اللحظ السقيم","https://www.aldiwan.net/poem50789.html","مجزوء الكامل"],[283,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[283,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[306,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"]],"verses":[["لَكِ هَامُهَا تَعْنُو وَجَاهُكَ فَوْقَهَا","تَاجٌ يُشِيرُ إِلَيْهِ كُلُّ مُسَلِّمِ",0,"م",1,0],["لك هوَّة تسع الفضاء ورتبة","لا تستطيع لها النجوم مراما",1,"م",2,0],["لَكَ هَذا الأُفقُ لَكِن","هُوَ أَيضاً لِلكَواكب",2,"ب",1,0],["لَكَ هامَةُ المَجدِ التَليدِ وَهَضبُهُ","وَشِعابُهُ وَنُجودُهُ وَرُباهُ",3,"ا",2,0],["لَكَ هَضبَةُ الحِلمِ الَّتي لَو وازَنَت","أَجَأً إِذا ثَقُلَت وَكانَ خَفيفا",4,"ف",2,0],["لَكَ هِمَّةٌ ما تُستطَاعُ ونَجدةٌ","مَذخورةٌ للأمرِ سَاعَةَ يَحْزُبُ",5,"ب",1,0],["لكَ هذه المُهَجُ التي تدعَى الوَرَى","فأمُرْ مُطاعَ الأمْرِ وادْعُ مُجابا",6,"ب",2,0],["لكهم السهادُ بيوتَ هدبها","وأَقام بين رُسومِها الحُمْر",7,"ر",1,0],["لَكَ همة عُلوية","تَسمو السُهى وَالفَرقَدا",8,"د",2,0],["لك هل من مسامت او موازي","في العراقين او بمرو وراز",9,"ز",1,1],["لكَ همَّةٌ قعساء في النعماء ما","تزدادُ إلا رفعةً بتنقلِ",10,"ل",1,0],["لكَ همةٌ علويةٌ كرميَّةٌ","وسجيةٌ معسولةٌ لَمْيَاءُ",11,"ا",2,0],["لك همّةٌ ما هَمُّها","إلاّ إلى الأمر الجسيم",12,"م",1,0],["لَكَ هِمَّةٌ عَلياءُ عُصرونِيَّةٌ","فَالشُهبُ شُهبٌ تَحتَها تَتَحَمحَمُ",13,"م",1,0],["لَكَ هَيبَةُ الحَجّاجِ لا فَتَكاتُهُ","قِدماً فَأَنتَ السيِّدُ الجَحجاحُ",14,"ح",1,0],["لَك همّةٌ تقفُ المعالي دونَها","وَتقول هذا مبلغي فتقدّمِ",15,"م",1,0]]}