{"poems":[[95,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[74,"يا ابن الأولى اتخذوا السماء مطامحا","https://www.aldiwan.net/poem19691.html","الكامل"],[93,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[47,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[46,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[87,"قلبٌ يذوب ، ومدمعٌ يجري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9553&r=&rc=43",""],[113,"بك يستغاث من العدا","https://www.aldiwan.net/poem16254.html","مجزوء الكامل"],[119,"لك هل من مسامت او موازي","https://www.aldiwan.net/poem40930.html","عموديه"],[132,"أهدى السلام إلى الكريم المفضل","https://www.aldiwan.net/poem50544.html","الكامل"],[202,"طرقت على علل الكرى أسماء","https://www.aldiwan.net/poem51991.html","الكامل"],[234,"السقم في اللحظ السقيم","https://www.aldiwan.net/poem50789.html","مجزوء الكامل"],[287,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[287,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138303",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122327","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70996","الخفيف"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146948","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93570","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137070",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137255",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137542",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133984","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36716","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131298",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111523","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136467",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5431,"الى قمرٍ أسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198438",""]],"verses":[["لَكِ هَامُهَا تَعْنُو وَجَاهُكَ فَوْقَهَا","تَاجٌ يُشِيرُ إِلَيْهِ كُلُّ مُسَلِّمِ",0,"م",1,0],["لك هوَّة تسع الفضاء ورتبة","لا تستطيع لها النجوم مراما",1,"م",2,0],["لَكَ هَذا الأُفقُ لَكِن","هُوَ أَيضاً لِلكَواكب",2,"ب",1,0],["لَكَ هامَةُ المَجدِ التَليدِ وَهَضبُهُ","وَشِعابُهُ وَنُجودُهُ وَرُباهُ",3,"ا",2,0],["لَكَ هَضبَةُ الحِلمِ الَّتي لَو وازَنَت","أَجَأً إِذا ثَقُلَت وَكانَ خَفيفا",4,"ف",2,0],["لَكَ هِمَّةٌ ما تُستطَاعُ ونَجدةٌ","مَذخورةٌ للأمرِ سَاعَةَ يَحْزُبُ",5,"ب",1,0],["لكَ هذه المُهَجُ التي تدعَى الوَرَى","فأمُرْ مُطاعَ الأمْرِ وادْعُ مُجابا",6,"ب",2,0],["لكهم السهادُ بيوتَ هدبها","وأَقام بين رُسومِها الحُمْر",7,"ر",1,0],["لَكَ همة عُلوية","تَسمو السُهى وَالفَرقَدا",8,"د",2,0],["لك هل من مسامت او موازي","في العراقين او بمرو وراز",9,"ز",1,1],["لكَ همَّةٌ قعساء في النعماء ما","تزدادُ إلا رفعةً بتنقلِ",10,"ل",1,0],["لكَ همةٌ علويةٌ كرميَّةٌ","وسجيةٌ معسولةٌ لَمْيَاءُ",11,"ا",2,0],["لك همّةٌ ما هَمُّها","إلاّ إلى الأمر الجسيم",12,"م",1,0],["لَكَ هِمَّةٌ عَلياءُ عُصرونِيَّةٌ","فَالشُهبُ شُهبٌ تَحتَها تَتَحَمحَمُ",13,"م",1,0],["لَكَ هَيبَةُ الحَجّاجِ لا فَتَكاتُهُ","قِدماً فَأَنتَ السيِّدُ الجَحجاحُ",14,"ح",1,0],["لَك همّةٌ تقفُ المعالي دونَها","وَتقول هذا مبلغي فتقدّمِ",15,"م",1,0],["لك همة عليا وفضل باهر","وذكا وعلم ثم لطف أبهر",16,"ر",1,0],["لك هم وهمة ولك الطو","ل وعار ان لا يهم الهمام",17,"م",1,0],["لَك همّةٌ كَالبرقِ وَهيَ عَلِيَّةٌ","كَالرّيشِ تَبدو عِندَها الأَوتادُ",18,"د",1,0],["لَكَ هَيبةٌ مِنها الضَّياغِمِ تَختَشي","وَيَدكُّ مِنها في الوَغى الأَطوادُ",18,"د",1,0],["لك هذا تقدير من خلق الخل","ق فحمداً للخالق الملاَّك",19,"ك",1,0],["لك هضبة في الملك قحطانية","طرق الحوادث نحوها أوْعَار",20,"ر",1,0],["لَكَ هَيبة في الصَدر يا اِبن محمد","تَكسو لبيد الشعر ثَوب بَليد",21,"د",1,0],["لك همة قعساء دون مرامها","الشعرى ودون محلها القمران",22,"ن",1,0],["لك همة معزوة لكواكبٍ","وبسالة معزوة لقساور",23,"ر",1,0],["لك همة يعنو لها","ولعزمها حدّ السنان",24,"ن",1,0],["لك همة علوية وعناية","للخلق اسعافاتها عادات",25,"ت",1,0],["لك همةُ هامُ الكواكب دونها","لك عزمةٌ هي غاربٌ لا منسم",26,"م",1,0],["لك هِمّةٌ طوْعَ النّدى وعنِ الردى","جعلَ الوفاءُ حِباءَها وإباءَها",27,"ا",3,0],["لَكَ هَضبةُ العِلمِ الَّتي فرعت عُلا","هَامَ النَعائم وَالسماك الأَعزَلِ",28,"ل",1,0],["لك هيبة ملء القلوب ومنظرٌ","ملء العيون وحكمة وسداد",29,"د",1,0],["لك هكطور سوف يعطي فصبرا","بنت شيخ البحار أمي أتتني",30,"ي",1,0],["لكهف الكهرباء أُقادُ حتى","مجاريها تساقُ اليَّ جرَّا",31,"ر",2,0],["لك همةٌ ضاقت بها سِعة الفضا","ومناقبٌ مثل النجوم زَواهر",32,"ر",1,0],["لك هَدْيُها الأوجاع ُ فاقبل ْ هديَها","مفقودة ٌ وقد التقاها الفاقد ُ",33,"د",1,0],["لك همة تدني البعيد لواله","أضحى منوطاً في مناط الفرقد",34,"د",1,0],["لك هم إن اردت عيشاً رغيداً","قدوةٌ فاتبعهم ومنار",35,"ر",1,0],["لك هاجت زوابعي باضطراب","بك فاحت حدائقي بالورود",36,"د",1,0]]}