{"poems":[[93,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[511,"لو كنت تبصر منذ يوم قد ناى","https://www.aldiwan.net/poem2423.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[1595,"","https://poetry.dctabudhabi.ae/diwan/poem/142930","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74324","الخفيف"],[3791,"","https://poetry.dctabudhabi.ae/diwan/poem/145991","الكامل"]],"verses":[["لَعَجِبتِ مِن زَورِ الوُشاةِ وَإِفكِهِم","وَمِنَ الَّذي قاسَيتُ في حُبّيكِ",0,"ك",1,0],["لَعُجنا عَلَيكِ العيسَ بَعدَ مَعاجِها","عَلى البيضِ أَتراباً عَلى النُؤيِ وَالوَدِّ",1,"د",1,0],["لعَجبتَ قُبحاً مِنهما وملاحة","منه وقلت حظيرة ام مكنِس",2,"س",1,0],["لعجزه ونحن إن الفنا","لا ندعي الكمال فيما قلنا",3,"ن",2,0],["لَعَجِزتُ عَن وَصفِ الأَميرِ وَإِنَّما","يومي الخَديمُ بِمَقصِدٍ مَفهومِ",4,"م",1,0],["لعجيبٌ مني سوى أن عليا","كَ إلى حُسْن مَرْجِع الصبر تَصْبُو",5,"ب",2,0],["لَعجت بي لَواعج الشَوق سراً","لَيتَ لي لِلَّذي عَشقت وصول",6,"ل",1,0],["لعجبتُ من مُغض على نار الغضا","ما زال مستنداً إلى صبرٍ يهي",7,"ي",1,0]]}