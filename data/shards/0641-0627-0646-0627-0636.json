{"poems":[[47,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[63,"أقول لسائق الأظعان رفقا","https://www.aldiwan.net/poem51343.html","الوافر"],[147,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[189,"حوى الملك ملك أغاث النفوسا","https://www.aldiwan.net/poem14706.html","المتقارب"],[290,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[354,"كم صرعت من أسد العرين","https://www.aldiwan.net/poem15976.html","الرجز"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74996","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82126","الطويل"],[3066,"","https://poetry.dctabudhabi.ae/diwan/poem/104398","الخفيف"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103979","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[5121,"اللَّيْلُ وَالْكَلِمَاتْ","https://www.poetsgate.com/ViewPoem.aspx?id=33571",""],[5376,"أبث النفس بالأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=202177",""],[5411,"براءةٌ منْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=188231",""],[5736,"لك الشريان","https://www.poetsgate.com/ViewPoem.aspx?id=203902",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205983",""]],"verses":[["فَإِن أَضعُف عَنِ اِستِصلاحِ شَأني","فَتِلكَ السِنُّ شاهِدَةٌ بِعُذري",0,"ر",2,0],["فإن أضحى غبارك كحل قوم","فحظ الهجن ذاك من العتاق",1,"ق",1,0],["فَإِن أَضرَبوا عَن ذي الفَقارِ فَبَعدَما","أَصابوكَ أَجرى مِنهُ حَدّاً وَأَقطَعا",2,"ع",2,0],["فإنْ أَضْمروا غدرَ فرعونَ فيك","فسيفُك مثل العصا عند موسى",3,"س",2,0],["فأنا ضيف له حت","ماً إلى يوم مآبي",4,"ب",2,0],["فَإِن أَضعَنَ فَالحِفاظُ مَذهَبي","وَإِن غَدَرنَ فَالوَفاءُ ديني",5,"ن",2,0],["فإن أَضحكتك الجند بالناس ساعة","فَلا تغترر فاللَه يَكفيك أَزمانا",6,"ن",2,0],["فأن أضرمت أو أنجيت أم خالد","فحصر الزناد هن أورى وأثقب",7,"ب",1,0],["فأنا ضامن له كما ضمنت","على نفسي لأنه أخي وشبيه",8,"ي",2,0],["فَإن أضَفتُ إلَى ذَا الحَظّ مِن عَمَلِي","شَيئاً أفُوزُ بِهِ فِي يَومِ مُنقَلَبِ",9,"ب",1,0],["فإن أضا برق بارق ومضى","يشتاق منكم به بها وسنا",10,"ن",2,0],["فَإِنّ أَضيعَ الوَرى لِخَيرِهِ","من باعَ أخراهُ بِدُنيا غَيرِهِ",11,"ه",1,0],["فَأَنَا ضَرِيِحِي مُسْتَعِدٌّ هَاهُنَا","وَالْوَيْلُ إِنْ مَاتَتْ بِهِ الْكَلِمَاتُ",12,"ت",1,0],["فإن أضنت بكبوتها","فما نامت على زللِ",13,"ل",1,0],["فَإنْ أضَعْتَ صُواعَ الجُبِّ كُنْتَ بِذا","كَ دونَ جَدْوى تجذّ الخُسْرَ أجْذاذا",14,"ذ",2,0],["فإنْ أضناكَ ليلُ السهدِ توقًا","فذا شهدُ الرضابِ يسيلُ خمرا",15,"ر",2,0],["فأنا ضمير الوصل في أسمائهم","صرت المضاف إلى وجوهٍ غاضبه",16,"ب",2,0]]}