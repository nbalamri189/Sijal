gate.com/ViewPoem.aspx?id=188355",""],[5894,"في الجفن كسر تحته تضعيفي","https://www.poetsgate.com/ViewPoem.aspx?id=131429",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5943,"شوق","https://www.poetsgate.com/ViewPoem.aspx?id=11024",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[1920,"الوطن القلب","https://www.poetsgate.com/ViewPoem.aspx?id=191447",""],[1920,"في القبر","https://www.poetsgate.com/ViewPoem.aspx?id=210377",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[5956,"آخر دمعة","https://www.poetsgate.com/ViewPoem.aspx?id=193309",""],[5957,"أنت الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=27115",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[5957,"خيال","https://www.poetsgate.com/ViewPoem.aspx?id=187589",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[6068,"في القلب من ذكر الرسول سعادة -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175852",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6070,"بكيتُ حتى سَكَبْتُ الحِبْرَ مِنْ قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=197536",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6093,"الدُّرَّةُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181003",""],[6093,"لا تأخذوا رأيي بشعر معاصر","https://www.poetsgate.com/ViewPoem.aspx?id=192870",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[6152,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=203276",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[138,"ألا هَلْ أتَى بَحْريِّنا صُنعُ ربِّنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17340&r=&rc=14",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""],[5567,"إسراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81756&r=&rc=20",""],[5567,"نداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81827&r=&rc=77",""]],"verses":[["في القُربِ لَيّانُ دُيونِ الهَوى","وَفي نَوى الدارِ رَجيعُ السَقام",0,"م",1,0],["في القَلبِ مِنكَ جِراحَةٌ أَبداً","ما زِلتُ أَدمُلُها وَتَقرِفُها",1,"ف",3,0],["في القُربِ وَالبُعدِ مالي مِنهُمُ فَرَجٌ","فالوَجدُ إِن نَزلوا والشَّوقُ إِن ظَعَنوا",2,"ن",3,0],["فَيا لَقَتيلَي غَدرَةٍ قَد سُقيتُما","بِها السُمَّ وَالمَكرُ الخَفِيُّ يَبينُ",3,"ن",1,0],["في القلبِ مِنكِ جَوى المُحب","بِّ وَرَاحةُ الصَبِّ الشَقِيق",4,"ق",1,0],["في القَلبِ مِن مَضَضِ الهُمومِ مُثَقَّفٌ","ماضٍ وَمَكروهُ الضَريبَةِ أَشطَبُ",5,"ب",1,0],["في القبر ليلك سرمد لا ينقضي","والشمس فوقك كل يوم تشرق",6,"ق",1,0],["في القصر او في القبر شئت فحيثما","تسكن فانت السيد القمقام",7,"م",1,0],["في القبر أم في فؤادي الواجف","عكفت يا ابني ولم تزل عاكف",8,"ف",1,1],["في القَيدِ مُمتَنِعُ الخُطى وَخَيالِهِ","يَطوي البِلادَ وَيَنشُرُ الآفاقا",9,"ق",2,0],["في القَفرِ حَيّاتٌ يُسَيِّبُها بِهِ","حاوي القَضاءِ وَفي الرِياضِ أَفاعي",10,"ع",2,0],["فَيالِقُ أَفشى في البِلادِ مِنَ الضُحى","وَأَبعَدُ مِن شَمسِ النَهارِ وَأَقرَبُ",11,"ب",1,0],["في القلبِ من حَرِّ الفِراقِ شُوَاظُ","والدمعُ قد شَرِقَتْ به الألحاظُ",12,"ظ",1,1],["في القَفرِ يَعطِفُها أَقَبُّ تَرى","نَسَفاً بِليتَيهِ مِنَ الكَدمِ",13,"م",1,0],["في القَلبِ مِنّي وَالجَوانِحِ وَالحَشا","مِن حُبِّهِ حَرٌّ كَحَرِّ شُواظِ",14,"ظ",1,0],["في القَلبِ يَجرَحُ دائِماً","فَالقَلبُ مَجروحُ النَواحي",15,"ح",2,0],["في القَلبِ مِنّي عَلَيها","حَرارَةٌ تَتَوَقَّد",16,"د",1,0],["في القُرِّ إِن كانَ وَفي يَومِ لا","يَبرُزُ إِلّا كُلُّ مُشتاقِ",17,"ق",1,0],["في القَولِ يَأتيكَ بَيانُ الفَتى","وَالعَيُّ ما أَغناكَ عَنهُ السُكوتُ",18,"ت",1,0],["في القَصرِ ذي الشُرُفاتِ البيضِ جارِيَةٌ","رَيّا التَرائِبِ وَالأَردافِ وَالقَضَبِ",19,"ب",1,0],["في القلْب ذكْرُكَ لا يزُول وإن أتى","دونَ اللقاء سَباسِبٌ وهُجولُ",20,"ل",1,0],["فيا لقلب غنيّ النور مزّقه","على النوى حقد أحباب وحقد عدى",21,"د",2,0],["فِي الْقُدْسِ فِي لُبْنَانَ فِي جُلَّقٍ","قَوْمٌ يُكِنُّونَ لِمِصْرَ الْوِدَادْ",22,"د",1,0],["في القفص المذهب الثمين","ينشد ما ينشد من لحون",23,"ن",1,0],["في القُرَيّاتِ القُصا بَينَ قَومٍ","يَحسَبونَ البَحرَ مِثل القَرِيِّ",24,"ي",1,0],["في القلب غيرُ البُغْضِ، غيرُ الهوى","فكيف أحكِي يا ضجيجَ الدروب",25,"ب",1,0],["في القلبِ شيءٌ ما لهُ سابقٌ","وفيهِ أخفى من نوايا الغيوب",25,"ب",1,0],["فيا لقصيٍّ ما زوى اللهُ عنكمُ","بهِ من فخارٍ لا يبارى وسؤددِ",26,"د",1,0],["في القُرى يوسعوننا وصماتٍ","مُخجِلٍ أمرها \" البداةَ \" مَعيب",27,"ب",1,0],["في القلب من أثرِ الهُموم ووَسْمِها","سِمةٌ على النَّفسَ الحزين تلوح",28,"ح",1,0],["في القلب كنز شباب لا نفاد له","يعطي ويزداد ما ازدادت عطاياه",29,"ا",2,0],["فَيالَ قُصَيٍّ أَلَم تُخبَروا","بِما حَلَّ مِن شُؤونٍ في العَرَب",30,"ب",1,0],["فَيا لَقُصَيٍّ هَل لَكُم في نُفوسِكم","وَهَل لَكُمُ فيما يَجيءُ بِهِ الغَدُ",31,"د",1,0],["في القيظِ وَالقُرِّ لا ظِلٌّ وَلا كَنَفٌ","لَها فَلَيسَت بِغَيرِ النَقعِ تَحتَجِبُ",32,"ب",1,0],["فَيالِقَومي وَما قَومي سِوى عَرَبٌ","وَلَن يُضَيَّعَ فيهُم ذَلِكَ النَسَبُ",33,"ب",1,0],["في القَدِّ والثغرِ والريقِ الشَّهِيِّ وطِي","ب الرِّيحِ واللون والتَّفْلِيج والشَّنَبِ",34,"ب",1,0],["في القلوبِ مختبئ","للقلوبِ مختلبُ",35,"ب",1,0],["في القلب من حَرِّ الصبابة نارُ","جَمرٌ عليه مَهابةٌ ووقارُ",36,"ر",1,1],["في القَصرِ غزالٌ تُكبِرهُ","غِزلانُ الرَملِ وَتحسدُه",37,"د",2,0],["في القلب إبراهيم وهو خليله","أمسى به خضر الوداد كليما",38,"م",2,0],["في القادسيّةِ كان مصرعُ إخوةٍ","والأمُّ قالت والدموعُ تفيض",39,"ض",1,0],["فيالقُ أعطتها الرعودُ قصيفَها","وقد كَمَنَت في مدفعٍ وقذيفة",40,"ه",1,0],["فيالِقُه سحائبُ في حَشاها","صواعقُ منذراتٌ بالدَّوي",41,"ي",1,0],["فَيا لِقَساوِرَ قد صُيّرَتْ","قَنَافِذَ بالأَسْهُمِ الصُّيَّب",42,"ب",1,0],["في القَلبِ نيرانُ الهَوى كُلَّما","ذَكَرتُها مُوقَدَةٌ مُشعَلَه",43,"ل",2,0],["في القَلبِ مِنكَ صَبابَةٌ وَكَآبَةٌ","كِلتاهُما النارُ الَّتي لا تَخمُدُ",44,"د",1,0],["فيا لقلبٍ لا يهابُ الظبا","مرهفةَ الحد ويخشى الجفون",45,"ن",1,0],["في القلبِ منه مكانٌ لا يُتَيِّمُه","أجفانُ بيضٍ ولكنْ بِيضُ أجفان",46,"ن",1,0],["في القُربِ منّي والبِعا","دِ يُصادَفانِ على مِثال",47,"ل",1,0],["في القُرْبِ مُرتاحاً إذا لاقاهُمُ","وعلى البِعادِ إليهمُ مُلْتاحا",48,"ح",2,0],["في القبر بل في الحين","يغضب عليك الله",49,"ه",1,0],["في القلب والجسم والأركان","تصلح بها كل أحوال",50,"ل",1,0],["في القلبِ ميزانُ العبادِ ، فإنْ صف","فالعيشُ صافٍ ، والبعيدُ قريبُ",51,"ب",1,0],["فيا لقلبي لأحزان أكاتمها","عليهم ولدمع غير مكتتم",52,"م",1,0],["في القَلبِ منه غُلّةٌ فَلَوِ اُغتَدى","في ماءِ خدَّيْهِ غَرِيقاً مَا ارْتَوَى",53,"و",2,0],["في القلب منزلةُ الغزال الشامسِ","فقل السلام على النّفور الآنسِ",54,"س",1,1],["في القومِ قومٌ كِرامٌ لا فُتورَ لهمْ","ما الذِّكرُ عندهُمُ في الوقتِ مَحدودُ",55,"د",1,0],["فِي القَلبِ مَا فيهِ منَ ال","ألَمِ المُمِضِّ عَلَى صِبَاك",56,"ك",1,0],["فِي القَبرِ أنتَ مُمَدَّدٌ","وعلَى تُرَابٍ وَجنتَاك",56,"ك",1,0],["في القلبِ منكمْ حَزازاتٌ لو اِنكَشَفتْ","لِعاذِلي فيكمُ ما بات يَعذُلني",57,"ن",2,0],["في القلب من حرّ المصيبة لوعةٌ","لا تعلمون بها وقلبي أعلمُ",58,"م",1,0],["في القربِ والبعدِ هجرانٌ ومَقْلِيَةٌ","فليس ينفعنِي قربٌ ولا بُعُدُ",59,"د",1,0],["في القلب أنت وما في القلب أنت كما","إن أنت في بصري ما أنت في بصري",60,"ر",2,0],["في القُربِ تَنْساني وقِد","ماً كنتَ لي في الْبُعدِ ذَاكِرْ",61,"ر",1,0],["في القطر من سطعت محاسن وجهها","للزوج تمحو غيهب الظلماء",62,"ا",2,0],["في القطر أعمال إذا استثمرته","فيها أفادك والفقير المحتقر",63,"ر",1,0],["في القرن الأَول والقرنِ الأَخيرِ لَقَد","أَحيا لَنا العمران الدينَ عن قدرِ",64,"ر",1,0],["في القلزم المجتاز مأذون فإن","غوضبت فهو محرم محظور",65,"ر",1,0],["في القَوافي كَما يَشاءُ وَيَرضى","أَمرُهُ نافِذٌ بِغَيرِ معينِ",66,"ن",1,0],["في القدس أولد من جديد حاملا","للنائمين اليائسين بشاره",67,"ر",2,0],["فَيا لِقَتيل في الهَوى طَل ثَأره","وَإن دمي المطول إِحدى العَجائِب",68,"ب",1,0],["فِي القَدَمِ العادِيِّ وَالعِزِّ العَرِكْ","مِنْ كُلِّ زأَّارٍ وَمَخَّاضٍ عَلِكْ",