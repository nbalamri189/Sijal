{"poems":[[55,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[55,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[90,"أن بليلا من نسيم السحر","https://www.aldiwan.net/poem44414.html","الرجز"],[74,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[82,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[82,"ذات لفظ تجني بسمعك منه","https://www.aldiwan.net/poem31340.html","الخفيف"],[107,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[78,"بكفه ساحر البيان إذا","https://www.aldiwan.net/poem39322.html","المنسرح"],[108,"تحية موجزة","https://www.poetsgate.com/ViewPoem.aspx?id=179384",""],[82,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[190,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[343,"إن العيون على القلوب شواهد","https://www.aldiwan.net/poem68809.html","الكامل"],[466,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122738","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141313","الرمل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101601","الخفيف"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129356","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129509","الرمل"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124273","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131110",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""]],"verses":[["يَنطَقُ عَنّي بِلِسانِ ضِغني","نَبَّهتُ يَقظانَ قَليلَ الأَمنِ",0,"ن",1,0],["يَنطَحنَ بِالأَقرانِ بَينَ مُعلَمٍ","بِالدَمِ أَو مُعَلَّمٍ بِالعِثيَرِ",1,"ر",1,0],["ينطق بالحب لها بائحا","وهي التي تفعل أنطاقه",2,"ه",1,0],["ينطقني جودك المرتجَى","ويدعو اللسان إلى صدحه",3,"ح",2,0],["ينطقُ الموتُ من ظباه فَيَمْضي","حُكمُهُ في الوَرَى بأمْرٍ وَحيِّ",4,"ي",1,0],["يَنطَوي جَفْنُها عَلى سَيفِ لَحظٍ","تُغْمَدُ المُرهَفاتُ حِينَ يُسَلُّ",5,"ل",1,0],["يَنطادُ عُلْويَّ المطالبِ مُمعِناً","ويصولُ جنِّيَّ القُوى جبّارا",6,"ر",2,0],["يَنطِقُ في عُجمةٍ بلفظتهِ","نُصَمُّ عنها وتُسْمِع البَصَرا",7,"ر",2,0],["ينطق لكن بلسان العجل","وهو الفصيح قولُه، إن يقُل",8,"ل",1,0],["ينطقُ الموتُ من ظباه فَيَمْضِي","خيرُ وسميّ رحمة ٍ وَوَليّ",9,"ي",1,0],["ينطق عن تجربة ودرسِ","وحكمةٍ مسطورةٍ في طرش",10,"ش",1,0],["يَنطِقنَ وَالأَفواهُ صامِتَةٌ فَما","يَخفى عَلَيكَ بَرَيئُها وَمُريبُها",11,"ب",3,0],["ينطقُ الغيبُ على مقْولهِ","بالذي كان من السرِّ كَمَنْ",12,"ن",1,0],["يَنطَحُ النَّطحَ بِرَوقَيهِ وَهَل","تَثلُمُ الصَّخرَ قُرُونُ الوَعِلِ",13,"ل",1,0],["يَنطِقُ الحقّ عَلى رَغمِ الحَسود","لَم يَكُن في اللَّهِ يَخشى قائِلا",14,"ل",2,0],["يَنطَوي اللَيلُ عَلَيهِ فَإِذا","واجَهَ الشَرقَ تَجَلّى وَاِنكَشَف",15,"ف",1,0],["ينطق بالحق وبالصوابِ","لكنه يُبْطئ في الجوابِ",16,"ب",1,0],["ينطق الجهّال بالجهر ومن","حذقوا العلم يكمّون الشّفاها",17,"ا",3,0],["ينطف السم على ريقته","وبه تؤسى جروح البائسين",18,"ن",1,0],["ينطق الخوف كل عيّ وهذي","رعشة النجم عجّلت بافتضاحه",19,"ح",2,0],["ينطِق من غيرِ هَذر","يصمُتُ من غَيرِ حَصر",20,"ر",1,0],["ينطق عن صامتها صنعة","ومن غريب الوصف نطق الجماد",21,"د",1,0],["ينطق الصامت في سر الهوى","سوف يلقى ذايع الاسرار غيا",22,"ي",2,0],["ينطق حاله بما أضمره","والتبس الداء عليه والغذا",23,"ذ",2,0],["ينطوي للمشوق جسم سقيم","من شجون على فؤاد سقيم",24,"م",1,0],["ينطح عدانا ماحسب للعواقيب","ولا أرسلهم مندوب للصلح بكتاب",25,"ب",1,0],["ينطّق فوق راحته حصاهُ","يسبّح حامداً ربّ السماءِ",26,"ا",2,0],["ينطوي في سبيل أبناءِ دنيا","هُ ويلقى من دهرهِ نائباتهْ",27,"ت",2,0],["ينطح الغيمة في مشرقها","تتهادى في أياديه المزون",28,"ن",1,0]]}