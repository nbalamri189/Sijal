m36289.html","عموديه"],[298,"للشمس إذ هجعت أضغاث أحلام","https://www.aldiwan.net/poem36845.html","عموديه"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[329,"ليبك أبا الجدعاء ضيف معيلُ","https://www.aldiwan.net/poem412.html",""],[337,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[353,"يا آل بيت الشرف","https://www.aldiwan.net/poem40036.html","مجزوء الرجز"],[357,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[364,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[364,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[371,"تمادى بهم أمد سرمد","https://www.aldiwan.net/poem57478.html","المتقارب"],[386,"لعمرك إنني وأبا رياح","https://www.aldiwan.net/poem1826.html","الوافر"],[396,"ليبك عقالاً كل كسر مؤربٍ","https://www.aldiwan.net/poem597.html",""],[403,"دع اللوم إن سالت دموعي على خدي","https://www.aldiwan.net/poem33938.html","الطويل"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[416,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[429,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[432,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[458,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[461,"أسى وسرور ناصر ومخذل","https://www.aldiwan.net/poem15268.html","الطويل"],[461,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[461,"وأبلج سمح من ذؤابة خندف","https://www.aldiwan.net/poem16113.html","الطويل"],[477,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[479,"كأس من الراح أم كأس من الأدب","https://www.aldiwan.net/poem36934.html","البسيط"],[482,"لي بالعقيق مليحة أودعها","https://www.aldiwan.net/poem24362.html","عموديه"],[495,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[529,"كذا فليكن رزء العلى والعوالم","https://www.aldiwan.net/poem37212.html","الطويل"],[538,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[538,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[551,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[551,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[558,"ردني الله له ردا جميلا","https://www.aldiwan.net/poem33577.html","الرمل"],[558,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[558,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[558,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[562,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[586,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"]],"verses":[["لِيَبكِ الزَمانُ طَويلاً عَلَيكَ","فَقَد كُنتَ خِفَّةَ روحِ الزَمانِ",0,"ن",1,0],["لي بِالنِضالِ الَّذي نَشِطَت لَهُ","عَهدٌ قَديمٌ مُعَجَّمُ الأَثَرِ",1,"ر",1,0],["لَيَبكِهِ مُقتِرٌ أَفنى حَريبَتَهُ","دَهرٌ وَحالَفَهُ بُؤسٌ وَإِقتارُ",2,"ر",1,0],["لِيَبكِ عَلَيهِ مِن سُلَيمٍ جَماعَةٌ","فَقَد كانَ بَسّاماً وَمُحتَضَرَ القِدرِ",3,"ر",1,0],["لِيَبكِ الخَيرَ صَخراً مِن مَعَدٍّ","ذَوُو أَحلامِها وَذَوُو نُهاها",4,"ا",3,0],["لِيَبكِ عَلَيكَ قَومُكَ لِلمَعالي","وَلِلهَيجاءِ إِنَّكَ ما فَتاها",4,"ا",3,0],["لَيُبَارِكُ الزَّمَنْ الَّذِي رَجَّحْتَهُ","فَضْلاً عَلَى مُتَقَادِمِ الأَزْمَانِ",5,"ن",1,0],["لِيَبْرُزِ العِلْمُ مِنْ تِلْكَ الصُّفُوفِ لَنَا","عَلامَ يَمْكُثُ فِيهَا وَهْوَ مُلْتَثِمُ",6,"م",1,0],["ليبصر منهم من حجاه مثقّفٌ","ومن لفظه درّ ومن علمه بحر",7,"ر",1,0],["لِيَبكِ عَلى النُعمانِ شَربٌ وَقَينَةٌ","وَمُختَبِطاتٌ كَالسَعالي أَرامِلُ",8,"ل",1,0],["لِيَبكِ يَزيدَ ضارِعٌ لِخُصومَةٍ","وَمُختَبِطٌ مِمّا تُطيحُ الطَوائِحُ",9,"ح",1,0],["لِيَبكِكِ كُلُّ يَومٍ صُمتِ فيهِ","مُصابَرَةً وَقَد حَمِيَ الهَجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ لَيلٍ قُمتِ فيهِ","إِلى أَن يَبتَدي الفَجرُ المُنيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مُضطَهَدٍ مَخوفٍ","أَجَرتيهِ وَقَد عَزَّ المُجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مِسكينٍ فَقيرٍ","أَغَثتيهِ وَما في العَظمِ زيرُ",10,"ر",1,0],["لي بالجنا الحلو في ناديك مرتفقٌ","وبالندى الغمر مصطاف ومرتبع",11,"ع",1,0],["ليَ بغل لا يعرف الأكل عندِي","غير أنَّ المياه للشربِ سهله",12,"ل",2,0],["لِيَبْهَجِ الدِّينُ والدنيا فإنهما","قد أصبحا في جَنابيه بمصطحَبِ",13,"ب",1,0],["لِيُبَكِّني الأعداءُ إني رحمةٌ","لهُمُ فكيف تظنُّ بالأحبابِ",14,"ب",1,0],["ليبقَى جديدٌ بعد بالٍ وكلُّهم","سَيْبلَى على الصّيفاتِ والشَّتَواتِ",15,"ت",1,0],["ليبكِها راغبٌ كانت ذريعتهُ","حتى تبدل ميسوراً بمعسور",16,"ر",1,0],["ليُبرِّد حشاكَ أن شواها","فوق أعناقهم وأنت المليك",17,"ك",1,0],["ليُبلِغَني عنه رباطةَ جأشِه","فيكسرُ في ذَرْعي ويكْسِفُ باليا",18,"ي",2,0],["لِيَ بَعلٌ ظَنَّهُ الناسُ أَبي","صَدِّقوني أَنَّهُ غَيرُ أَبي",19,"ي",1,1],["لِيَبكِ عَلَيهِ المُسلِمونَ فَإِنَّهُم","أَضاعوا بِهِ مُحيِ العُصورِ الدَوائِرِ",20,"ر",1,0],["لِيَبلُغَ عُذراً أَو يُصيبَ رَغيبَةً","وَمَبلَغُ نَفسٍ عُذرَها مِثلُ مَنجَحِ",21,"ح",1,0],["لِيَبُلَّ غُلَّتَهُ التي لا ترتوي","ويَكُضَّ تُهْمَةَ قلبهِ المَغْفورِ",22,"ر",1,0],["لي بَينَهُنَّ وَلائِدٌ","هُم مِن سَوادِ العَينِ نور",23,"ر",1,0],["لي بُغيَةٌ في واسِطٍ ما دونَها","إِلّا مُناقَلَةُ الهِجانِ الوُخَّدِ",24,"د",1,0],["لِيَبكِ وَكيعاً خَيلُ حَربٍ مُغيرَةٌ","تَساقى المَنايا بِالرُدَينِيَّةِ السُمرِ",25,"ر",1,1],["لِيَبكِ عَلى سَلمٍ يَتيمٌ وَبائِسٌ","وَمُستَنزَلٌ عَن ظَهرِ ساطٍ مُثابِرِ",26,"ر",1,0],["لِيَبكِ عَلى الحَجّاجِ مَن كانَ باكِياً","عَلى الدينِ أَو شارٍ عَلى الثَغرِ واقِفِ",27,"ف",1,1],["لِيَبكِ اِبنَ لَيلى غاطِشٌ سارَ شُقَّةً","وَحَبلانِ حَبلا مُستَجيرٍ وَسائِلِ",28,"ل",1,0],["لِيَبكِ اِبنَ لَيلى كُلُّ سارٍ لِنائِلٍ","عَلى عُرضِ لَيلٍ مُدلَهِمِّ الغَياطِلِ",29,"ل",1,1],["لِيَبلُغنَ مِلءَ الرَرضِ نوراً وَرَحمَةً","وَعَدلاً وَغَيثَ المُغبِراتِ القَواتِمِ",30,"م",1,0],["لِيَبكِ عَلى الاِسلامِ مَن كانَ باكياً","فَقَد تُرِكَت أَركانُهُ وَمعالِمُه",31,"ه",1,1],["لِيَبكِ عَلى نَفسِهِ مَن بَكى","فَما أَوشَكَ المَوتَ ما أَوشَكا",32,"ك",2,1],["لِيَبكِ رَسولَ اللَهِ مَن كانَ باكِيا","وَلا تَنسَ قَبراً بِالمَدينَةِ ثاوِيا",33,"ي",2,1],["لِيَبْكِ عَلَيْكِ الْقَلْبُ لا الْعَيْنُ إِنَّنِي","أَرَى الْقَلْبَ أَوْفَى بِالْعُهُودِ وَأَكْرَمَا",34,"م",2,0],["لي بينكم مرخصٌ لدمعي","وَهْوَ عزيزٌ عليَّ غالي",35,"ي",1,0],["لي بالحجازِ وساكنيهِ مآربُ","أرضٌ حكَتْ حللَ الربيعِ مدبَّجا",36,"ج",2,0],["لي بالمعرةِ شمسٌ","رضاهُ عينُ مرادي",37,"ي",1,1],["لي بِالحَياة تَعلق وَتَشدد","وَالعُمر ما بَعدَ المَدى فَسينفد",38,"د",1,1],["لي بلاءٌ وأنتَ تعرفهُ","رحمةُ الخطّاط في الكُتُب",39,"ب",1,0],["لِيَبُتَّنَّ كُلَّ عِق","دٍ إِذا نَظمُهُ اِئتَلَف",40,"ف",1,0],["لِيَبكِ مُسِنٌّ ثُمَّ أَجَلَّهُ","مَعاشِرُ لَمّا قيلَ أَشيَبُ أَجلَهُ",41,"ل",2,1],["لِيَبكِكَ الشَربُ وَالمُدامَةُ وَال","فِتيانُ طُرّاً وَطامِعٌ طَمِعا",42,"ع",2,0],["لي بعد نأي إليهن","نَ أوبة ورجوع",43,"ع",1,0],["لِيَبْكِ الصِّبَا قَلْبِي وَطَرْفِي كِلاهُما","وَقَلَّ لَهُ مِنِّي نَجِيعٌ وَأَدْمُعُ",44,"ع",1,0],["لِي بِهِ صَاحِبٌ عَلَيَّ عَزِيزٌ","مِثْلُ مَا عِنْدَهُ مِنَ الشَّوْقِ عِنْدِي",45,"ي",1,0],["لِيَبْسِمْ فِي مُحَيَّاكِ الرَّجَاءُ","وَيُبْرِقُ فِي أَسِرَّتِكِ الْهَنَاءُ",46,"ا",2,1],["لِيَبكِ عَلَيكِ وَليندُب غَريبٌ","يعدُّ أَباهُ غُربَتَهُ مَضاضا",47,"ض",2,0],["لِي بيْنَكُمْ صِلَةٌ عَزَّتْ أوَاصِرُهَا","لأَنَّهَا صِلَةُ القُرآنِ وَالنَّسَبِ",48,"ب",1,0],["لِيُبلَّ غُلَّتَهُ التي لا ترتوي","ويكظّ نهمة قلبه المغفورِ",49,"ر",1,0],["لي بِالظَعائن نَهاب العُقول رَشاً","قَوامُهُ بانة وَالقَلب جَلمودُ",50,"د",1,0],["لي بتلك الطلول احباب قلب","وطلول الاحباب حينا تراد",51,"د",1,0],["لي بِالحُدوجِ وبِالغواني صَبابَةٌ","ولي بوردِ الرَوض وَالرَيحان",52,"ن",1,0],["لِيَبكِ طَويلاً كُلُّ مُكدٍ وَعائِلٍ","عَلى مَلِكٍ أَغنى وَأَروى وَأَشبَعا",53,"ع",2,0],["لي بِاِمتِداحِكَ عَن ذِكرِ الهَوى شُغُلُ","وَبِاِرتِياحِكَ عَن عَيشِ الصِبا بَدَلُ",54,"ل",1,1],["ليبكِيكَ من كانت حياتُك عِزّهُ","وأصبح لَمَّا مُتّ يُغْضي على الصُّغْر",55,"ر",1,0],["ليبكهم للدين من كان باكيا","فما شام هذا الدين في عصرهم نحسا",56,"س",2,0],["ليبرزن من عليه القتل مكتتب","لمضجع لو تكونوا في بيوتكم",57,"م",1,0],["ليُبعِدَنِّيَ عَنهُم شَدُّ ناجِيَةٍ","وَجناءَ غُفلٍ مِن التَوقِيعِ وَالوَقَعِ",58,"ع",1,0],["لِيَبكِ العُلى وَالمَجدُ وَالبَأسُ وَالنَدى","لَقَد صَلَّ واديها وَجَفَّت مَسايِلُه",59,"ل",2,0],["ليبيا كَبَتْ والنّيلُ يَبْكي حُرقَةً","وَتَخَضَّبَتْ مِنْ جُرْحِها الفَيْحاءُ",60,"ا",2,0],["لي بينَ غزلانِكم ظبيٌ كَلِفتُ به","ظبيٌ تَرَعرَعَ في جنّاتِ رضوانِ",61,"ن",1,0],["لي بهما في الحب قد زادني","بهجره لدغا على لدغ",62,"غ",1,0],["لي بين سلع والعقيق عهود","يبلى الزمان وذكرهن جديد",63,"د",1,1],["لي بالعَقيقِ سَقى العَقيقُ غَمامَةً","قَلبٌ أَسيرٌ ما لَهُ مِن فادِ",64,"د",1,0],["لِيَبلوا الَّتي قالَت بِصَحراءِ مَنعَجٍ","لِيَ الشِركُ يا اِبنَي فائِدِ بنِ حَبيبِ",65,"ب",1,0],["لي بِمَن ماتَ بِداءِ ال","عِشقِ في حُبِّكَ أُسوَه",66,"و",2,0],["لِيَبكِكَ الضَيفُ وَالمَجالِسُ وَال","حَيُّ المُخَوّي وَطامِعٌ طَمِعا",67,"ع",2,0],["ليبعد من ضرو يسعد من شقا","وينجد من بؤس وينقذ من حبس",68,"س",1,0],["ليبك عليه من رآه ومن حوى","هداه بأيامٍ لديه قلائل",69,"ل",1,0],["لي بِرُبى نَجد هَوىً تالِدٌ","تَخِذتهُ بِالشامِ لي دينا",70,"ن",2,0],["لي بَعدَكُم زَفَراتٌ نارُها صعدٌ","تُشِبُّها عَبَراتٌ ماؤُها صَبَبُ",71,"ب",1,0],["لِيَبكِ ابنَ كُلثُومٍ فَقَد حانَ يَومُهُ","يَتامى وَأَضيافٌ وَكُلٌّ مُضَيَّعُ",72,"ع",1,1],["ليبكِ فخار العرب من كان باكيا","فلم يبقِ من أَعلامِه الدهرُ باقيا",73,"ي",2,0],["لي بينهنَّ وَراء الليلِ ساحرةٌ","لا يستفيق بها وَجدي وَتهيامي",74,"م",2,0],["ليبرد حر بالفؤاد يثيره اش","تياق لقلبي شامل ولظاهر",75,"ر",1,0],["ليَبْكِ أَبا الجَدْعاءِ ضَيْفٌ مُعَيَّلُ","وأَرْمَلَةٌ تَغْشَى النَّدِيَّ فتَرْمُلُ",76,"ل",1,1],["لِيَبكِ عَلى المَيلاءِ مَن كانَ باكِياً","إِذا خَرَجَت مِن رَحرَحانَ خُدورُها",77,"ر",3,0],["لي بَينَهنَّ دُرَّة","ما اِستخرجت مِن صَدفِ",78,"ف",1,0],["لِيُبلِغَنِي استلامَ بَنانِ مَلكٍ","تُقِرُّ بِفَضلِ نِعمَتِهِ عِظَامِي",79,"م",2,0],["لي بسامي عُلاك إدْلالُ مثْلِي","إذ تلَقّيتُ في اعتمادِك رُشدا",80,"د",2,0],["لي بعدَ أُلاَّفى الّذينَ رحَلوا","و