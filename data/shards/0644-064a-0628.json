ق مليحة أودعها","https://www.aldiwan.net/poem24362.html","عموديه"],[497,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[531,"كذا فليكن رزء العلى والعوالم","https://www.aldiwan.net/poem37212.html","الطويل"],[540,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[540,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[553,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[553,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[560,"ردني الله له ردا جميلا","https://www.aldiwan.net/poem33577.html","الرمل"],[560,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[560,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[560,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[564,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[588,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[736,"","https://poetry.dctabudhabi.ae/diwan/poem/97764","المتقارب"],[1171,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/206003","الطويل"]],"verses":[["لِيَبكِ الزَمانُ طَويلاً عَلَيكَ","فَقَد كُنتَ خِفَّةَ روحِ الزَمانِ",0,"ن",1,0],["لي بِالنِضالِ الَّذي نَشِطَت لَهُ","عَهدٌ قَديمٌ مُعَجَّمُ الأَثَرِ",1,"ر",1,0],["لَيَبكِهِ مُقتِرٌ أَفنى حَريبَتَهُ","دَهرٌ وَحالَفَهُ بُؤسٌ وَإِقتارُ",2,"ر",1,0],["لِيَبكِ عَلَيهِ مِن سُلَيمٍ جَماعَةٌ","فَقَد كانَ بَسّاماً وَمُحتَضَرَ القِدرِ",3,"ر",1,0],["لِيَبكِ الخَيرَ صَخراً مِن مَعَدٍّ","ذَوُو أَحلامِها وَذَوُو نُهاها",4,"ا",3,0],["لِيَبكِ عَلَيكَ قَومُكَ لِلمَعالي","وَلِلهَيجاءِ إِنَّكَ ما فَتاها",4,"ا",3,0],["لَيُبَارِكُ الزَّمَنْ الَّذِي رَجَّحْتَهُ","فَضْلاً عَلَى مُتَقَادِمِ الأَزْمَانِ",5,"ن",1,0],["لِيَبْرُزِ العِلْمُ مِنْ تِلْكَ الصُّفُوفِ لَنَا","عَلامَ يَمْكُثُ فِيهَا وَهْوَ مُلْتَثِمُ",6,"م",1,0],["ليبصر منهم من حجاه مثقّفٌ","ومن لفظه درّ ومن علمه بحر",7,"ر",1,0],["لِيَبكِ عَلى النُعمانِ شَربٌ وَقَينَةٌ","وَمُختَبِطاتٌ كَالسَعالي أَرامِلُ",8,"ل",1,0],["لِيَبكِ يَزيدَ ضارِعٌ لِخُصومَةٍ","وَمُختَبِطٌ مِمّا تُطيحُ الطَوائِحُ",9,"ح",1,0],["لِيَبكِكِ كُلُّ يَومٍ صُمتِ فيهِ","مُصابَرَةً وَقَد حَمِيَ الهَجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ لَيلٍ قُمتِ فيهِ","إِلى أَن يَبتَدي الفَجرُ المُنيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مُضطَهَدٍ مَخوفٍ","أَجَرتيهِ وَقَد عَزَّ المُجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مِسكينٍ فَقيرٍ","أَغَثتيهِ وَما في العَظمِ زيرُ",10,"ر",1,0],["لي بالجنا الحلو في ناديك مرتفقٌ","وبالندى الغمر مصطاف ومرتبع",11,"ع",1,0],["ليَ بغل لا يعرف الأكل عندِي","غير أنَّ المياه للشربِ سهله",12,"ل",2,0],["لِيَبْهَجِ الدِّينُ والدنيا فإنهما","قد أصبحا في جَنابيه بمصطحَبِ",13,"ب",1,0],["لِيُبَكِّني الأعداءُ إني رحمةٌ","لهُمُ فكيف تظنُّ بالأحبابِ",14,"ب",1,0],["ليبقَى جديدٌ بعد بالٍ وكلُّهم","سَيْبلَى على الصّيفاتِ والشَّتَواتِ",15,"ت",1,0],["ليبكِها راغبٌ كانت ذريعتهُ","حتى تبدل ميسوراً بمعسور",16,"ر",1,0],["ليُبرِّد حشاكَ أن شواها","فوق أعناقهم وأنت المليك",17,"ك",1,0],["ليُبلِغَني عنه رباطةَ جأشِه","فيكسرُ في ذَرْعي ويكْسِفُ باليا",18,"ي",2,0],["لِيَ بَعلٌ ظَنَّهُ الناسُ أَبي","صَدِّقوني أَنَّهُ غَيرُ أَبي",19,"ب",2,1],["لِيَبكِ عَلَيهِ المُسلِمونَ فَإِنَّهُم","أَضاعوا بِهِ مُحيِ العُصورِ الدَوائِرِ",20,"ر",1,0],["لِيَبلُغَ عُذراً أَو يُصيبَ رَغيبَةً","وَمَبلَغُ نَفسٍ عُذرَها مِثلُ مَنجَحِ",21,"ح",1,0],["لِيَبُلَّ غُلَّتَهُ التي لا ترتوي","ويَكُضَّ تُهْمَةَ قلبهِ المَغْفورِ",22,"ر",1,0],["لي بَينَهُنَّ وَلائِدٌ","هُم مِن سَوادِ العَينِ نور",23,"ر",1,0],["لي بُغيَةٌ في واسِطٍ ما دونَها","إِلّا مُناقَلَةُ الهِجانِ الوُخَّدِ",24,"د",1,0],["لِيَبكِ وَكيعاً خَيلُ حَربٍ مُغيرَةٌ","تَساقى المَنايا بِالرُدَينِيَّةِ السُمرِ",25,"ر",1,1],["لِيَبكِ عَلى سَلمٍ يَتيمٌ وَبائِسٌ","وَمُستَنزَلٌ عَن ظَهرِ ساطٍ مُثابِرِ",26,"ر",1,0],["لِيَبكِ عَلى الحَجّاجِ مَن كانَ باكِياً","عَلى الدينِ أَو شارٍ عَلى الثَغرِ واقِفِ",27,"ف",1,1],["لِيَبكِ اِبنَ لَيلى غاطِشٌ سارَ شُقَّةً","وَحَبلانِ حَبلا مُستَجيرٍ وَسائِلِ",28,"ل",1,0],["لِيَبكِ اِبنَ لَيلى كُلُّ سارٍ لِنائِلٍ","عَلى عُرضِ لَيلٍ مُدلَهِمِّ الغَياطِلِ",29,"ل",1,1],["لِيَبلُغنَ مِلءَ الرَرضِ نوراً وَرَحمَةً","وَعَدلاً وَغَيثَ المُغبِراتِ القَواتِمِ",30,"م",1,0],["لِيَبكِ عَلى الاِسلامِ مَن كانَ باكياً","فَقَد تُرِكَت أَركانُهُ وَمعالِمُه",31,"ه",1,1],["لِيَبكِ عَلى نَفسِهِ مَن بَكى","فَما أَوشَكَ المَوتَ ما أَوشَكا",32,"ك",2,1],["لِيَبكِ رَسولَ اللَهِ مَن كانَ باكِيا","وَلا تَنسَ قَبراً بِالمَدينَةِ ثاوِيا",33,"ي",2,1],["لِيَبْكِ عَلَيْكِ الْقَلْبُ لا الْعَيْنُ إِنَّنِي","أَرَى الْقَلْبَ أَوْفَى بِالْعُهُودِ وَأَكْرَمَا",34,"م",2,0],["لي بينكم مرخصٌ لدمعي","وَهْوَ عزيزٌ عليَّ غالي",35,"ل",2,0],["لي بالحجازِ وساكنيهِ مآربُ","أرضٌ حكَتْ حللَ الربيعِ مدبَّجا",36,"ج",2,0],["لي بالمعرةِ شمسٌ","رضاهُ عينُ مرادي",37,"ي",1,1],["لي بِالحَياة تَعلق وَتَشدد","وَالعُمر ما بَعدَ المَدى فَسينفد",38,"د",1,1],["لي بلاءٌ وأنتَ تعرفهُ","رحمةُ الخطّاط في الكُتُب",39,"ب",1,0],["لِيَبُتَّنَّ كُلَّ عِق","دٍ إِذا نَظمُهُ اِئتَلَف",40,"ف",1,0],["لِيَبكِ مُسِنٌّ ثُمَّ أَجَلَّهُ","مَعاشِرُ لَمّا قيلَ أَشيَبُ أَجلَهُ",41,"ل",2,1],["لِيَبكِكَ الشَربُ وَالمُدامَةُ وَال","فِتيانُ طُرّاً وَطامِعٌ طَمِعا",42,"ع",2,0],["لي بعد نأي إليهن","نَ أوبة ورجوع",43,"ع",1,0],["لِيَبْكِ بَنُو عُثْمَانَ مَا دَامَ جِذْمُهُمْ","عَلَيْهِ بأَصْلاَلٍ تُعَرَّى وتُخْشَبُ",44,"ب",1,0],["لِيَبْكُوا عَلَى خَيْرِ البَرِيَّةِ كُلِّهَا","تَخَوَّنَهُ رَيْبٌ مِنَ الدَّهْرِ مُعْطِبُ",44,"ب",1,0],["لِيَبْكِ الصِّبَا قَلْبِي وَطَرْفِي كِلاهُما","وَقَلَّ لَهُ مِنِّي نَجِيعٌ وَأَدْمُعُ",45,"ع",1,0],["لِي بِهِ صَاحِبٌ عَلَيَّ عَزِيزٌ","مِثْلُ مَا عِنْدَهُ مِنَ الشَّوْقِ عِنْدِي",46,"د",2,0],["لِيَبْسِمْ فِي مُحَيَّاكِ الرَّجَاءُ","وَيُبْرِقُ فِي أَسِرَّتِكِ الْهَنَاءُ",47,"ا",2,1],["لِيَبكِ عَلَيكِ وَليندُب غَريبٌ","يعدُّ أَباهُ غُربَتَهُ مَضاضا",48,"ض",2,0],["لِي بيْنَكُمْ صِلَةٌ عَزَّتْ أوَاصِرُهَا","لأَنَّهَا صِلَةُ القُرآنِ وَالنَّسَبِ",49,"ب",1,0],["لِيُبلَّ غُلَّتَهُ التي لا ترتوي","ويكظّ نهمة قلبه المغفورِ",50,"ر",1,0],["لي بِالظَعائن نَهاب العُقول رَشاً","قَوامُهُ بانة وَالقَلب جَلمودُ",51,"د",1,0],["لي بتلك الطلول احباب قلب","وطلول الاحباب حينا تراد",52,"د",1,0],["لي بِالحُدوجِ وبِالغواني صَبابَةٌ","ولي بوردِ الرَوض وَالرَيحان",53,"ن",1,0],["لِيَبكِ طَويلاً كُلُّ مُكدٍ وَعائِلٍ","عَلى مَلِكٍ أَغنى وَأَروى وَأَشبَعا",54,"ع",2,0],["لي بِاِمتِداحِكَ عَن ذِكرِ الهَوى شُغُلُ","وَبِاِرتِياحِكَ عَن عَيشِ الصِبا بَدَلُ",55,"ل",1,1],["ليبكِيكَ من كانت حياتُك عِزّهُ","وأصبح لَمَّا مُتّ يُغْضي على الصُّغْر",56,"ر",1,0],["ليبكهم للدين من كان باكيا","فما شام هذا الدين في عصرهم نحسا",57,"س",2,0],["ليبرزن من عليه القتل مكتتب","لمضجع لو تكونوا في بيوتكم",58,"م",1,0],["ليُبعِدَنِّيَ عَنهُم شَدُّ ناجِيَةٍ","وَجناءَ غُفلٍ مِن التَوقِيعِ وَالوَقَعِ",59,"ع",1,0],["لِيَبكِ العُلى وَالمَجدُ وَالبَأسُ وَالنَدى","لَقَد صَلَّ واديها وَجَفَّت مَسايِلُه",60,"ل",2,0],["ليبيا كَبَتْ والنّيلُ يَبْكي حُرقَةً","وَتَخَضَّبَتْ مِنْ جُرْحِها الفَيْحاءُ",61,"ا",2,0],["لي بينَ غزلانِكم ظبيٌ كَلِفتُ به","ظبيٌ تَرَعرَعَ في جنّاتِ رضوانِ",62,"ن",1,0],["لي بهما في الحب قد زادني","بهجره لدغا على لدغ",63,"غ",1,0],["لي بين سلع والعقيق عهود","يبلى الزمان وذكرهن جديد",64,"د",1,1],["لي بالعَقيقِ سَقى العَقيقُ غَمامَةً","قَلبٌ أَسيرٌ ما لَهُ مِن فادِ",65,"د",1,0],["لِيَبلوا الَّتي قالَت بِصَحراءِ مَنعَجٍ","لِيَ الشِركُ يا اِبنَي فائِدِ بنِ حَبيبِ",66,"ب",1,0],["لي بِمَن ماتَ بِداءِ ال","عِشقِ في حُبِّكَ أُسوَه",67,"و",2,0],["لِيَبكِكَ الضَيفُ وَالمَجالِسُ وَال","حَيُّ المُخَوّي وَطامِعٌ طَمِعا",68,"ع",2,0],["ليبعد من ضرو يسعد من شقا","وينجد من بؤس وينقذ من حبس",69,"س",1,0],["ليبك عليه من رآه ومن حوى","هداه بأيامٍ لديه قلائل",70,"ل",1,0],["لي بِرُبى نَجد هَوىً تالِدٌ","تَخِذتهُ بِالشامِ لي دينا",71,"ن",2,0],["لي بَعدَكُم زَفَراتٌ نارُها صعدٌ","تُشِبُّها عَبَراتٌ ماؤُها صَبَبُ",72,"ب",1,0],["لِيَبكِ ابنَ كُلثُومٍ فَقَد حانَ يَومُهُ","يَتامى وَأَضيافٌ وَكُلٌّ مُضَيَّعُ",73,"ع",1,1],["ليبكِ فخار العرب من كان باكيا","فلم يبقِ من أَعلامِه الدهرُ باقيا",74,"ي",2,0],["لي بينهنَّ وَراء الليلِ ساحرةٌ","لا يستفيق بها وَجدي وَتهيامي",75,"م",2,0],["ليبرد حر بالفؤاد يثيره اش","تياق لقلب