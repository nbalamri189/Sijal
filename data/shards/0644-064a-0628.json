{"poems":[[53,"نعوه على ضن قلبي به","https://www.aldiwan.net/poem29746.html","المتقارب"],[73,"أفدتني من نفائس الدرر","https://www.aldiwan.net/poem11981.html","المنسرح"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[10,"أعيني جودا بالدموع على صخر","https://www.aldiwan.net/poem21097.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[93,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[88,"بكى الفضل لما أن قضى نحبه جبر","https://www.aldiwan.net/poem45039.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[4,"لعمري لئن أمسى يزيد بن نهشل","https://www.aldiwan.net/poem21278.html","الطويل"],[47,"أيا أم الأسير سقاك غيث","https://www.aldiwan.net/poem25257.html","الوافر"],[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"نفرٌ من الخلطاءِ والأصحابِ","https://www.aldiwan.net/poem8329.html","الكامل"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"أرى ابن حريث لا يبالي عضيهتي","https://www.aldiwan.net/poem66736.html","الطويل"],[91,"لي بعل ظنه الناس أبي","https://www.aldiwan.net/poem8743.html","عموديه"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[14,"قلت لقوم في الكنيف تروحوا","https://www.aldiwan.net/poem38313.html","الطويل"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[45,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[28,"ليبك وكيعا خيل حرب مغيرة","https://www.aldiwan.net/poem5071.html","الطويل"],[28,"نعى لي أبا حرب غداة لقيته","https://www.aldiwan.net/poem5135.html","الطويل"],[28,"ليبك على الحجاج من كان باكيا","https://www.aldiwan.net/poem5316.html","الطويل"],[28,"نعائي ابن ليلى للسماح وللندى","https://www.aldiwan.net/poem5378.html","الطويل"],[28,"ليبك ابن ليلى كل سار لنائل","https://www.aldiwan.net/poem5436.html","الوافر"],[28,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[58,"ليبك على الاسلام من كان باكيا","https://www.aldiwan.net/poem30873.html","الطويل"],[49,"ليبك على نفسه من بكى","https://www.aldiwan.net/poem62211.html","المتقارب"],[49,"ليبك رسول الله من كان باكيا","https://www.aldiwan.net/poem63203.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[69,"بالله يا سائق الجمال","https://www.aldiwan.net/poem28358.html","مخلع البسيط"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[69,"لي بالمعرة شمس","https://www.aldiwan.net/poem29113.html","المجتث"],[102,"لي بالحياة تعلق وتشدد","https://www.aldiwan.net/poem33119.html","الكامل"],[48,"يا عمرو أضحت مبضة كبدي","https://www.aldiwan.net/poem66564.html","المنسرح"],[46,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[46,"ليبك مسن ثم أجله","https://www.aldiwan.net/poem23556.html","الطويل"],[19,"أيتها النفس أجملي جزعا","https://www.aldiwan.net/poem347.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42685","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42575","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54523","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[92,"يَا أيُّها الشَّادِي المغرِّدُ ههُنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14581&r=&rc=26",""]],"verses":[["لِيَبكِ الزَمانُ طَويلاً عَلَيكَ","فَقَد كُنتَ خِفَّةَ روحِ الزَمانِ",0,"ن",1,0],["لي بِالنِضالِ الَّذي نَشِطَت لَهُ","عَهدٌ قَديمٌ مُعَجَّمُ الأَثَرِ",1,"ر",1,0],["لَيَبكِهِ مُقتِرٌ أَفنى حَريبَتَهُ","دَهرٌ وَحالَفَهُ بُؤسٌ وَإِقتارُ",2,"ر",1,0],["لِيَبكِ عَلَيهِ مِن سُلَيمٍ جَماعَةٌ","فَقَد كانَ بَسّاماً وَمُحتَضَرَ القِدرِ",3,"ر",1,0],["لِيَبكِ الخَيرَ صَخراً مِن مَعَدٍّ","ذَوُو أَحلامِها وَذَوُو نُهاها",4,"ا",3,0],["لِيَبكِ عَلَيكَ قَومُكَ لِلمَعالي","وَلِلهَيجاءِ إِنَّكَ ما فَتاها",4,"ا",3,0],["لَيُبَارِكُ الزَّمَنْ الَّذِي رَجَّحْتَهُ","فَضْلاً عَلَى مُتَقَادِمِ الأَزْمَانِ",5,"ن",1,0],["لِيَبْرُزِ العِلْمُ مِنْ تِلْكَ الصُّفُوفِ لَنَا","عَلامَ يَمْكُثُ فِيهَا وَهْوَ مُلْتَثِمُ",6,"م",1,0],["ليبصر منهم من حجاه مثقّفٌ","ومن لفظه درّ ومن علمه بحر",7,"ر",1,0],["لِيَبكِ عَلى النُعمانِ شَربٌ وَقَينَةٌ","وَمُختَبِطاتٌ كَالسَعالي أَرامِلُ",8,"ل",1,0],["لِيَبكِ يَزيدَ ضارِعٌ لِخُصومَةٍ","وَمُختَبِطٌ مِمّا تُطيحُ الطَوائِحُ",9,"ح",1,0],["لِيَبكِكِ كُلُّ يَومٍ صُمتِ فيهِ","مُصابَرَةً وَقَد حَمِيَ الهَجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ لَيلٍ قُمتِ فيهِ","إِلى أَن يَبتَدي الفَجرُ المُنيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مُضطَهَدٍ مَخوفٍ","أَجَرتيهِ وَقَد عَزَّ المُجيرُ",10,"ر",1,0],["لِيَبكِكِ كُلَّ مِسكينٍ فَقيرٍ","أَغَثتيهِ وَما في العَظمِ زيرُ",10,"ر",1,0],["لي بالجنا الحلو في ناديك مرتفقٌ","وبالندى الغمر مصطاف ومرتبع",11,"ع",1,0],["ليَ بغل لا يعرف الأكل عندِي","غير أنَّ المياه للشربِ سهله",12,"ل",2,0],["لِيَبْهَجِ الدِّينُ والدنيا فإنهما","قد أصبحا في جَنابيه بمصطحَبِ",13,"ب",1,0],["لِيُبَكِّني الأعداءُ إني رحمةٌ","لهُمُ فكيف تظنُّ بالأحبابِ",14,"ب",1,0],["ليبقَى جديدٌ بعد بالٍ وكلُّهم","سَيْبلَى على الصّيفاتِ والشَّتَواتِ",15,"ت",1,0],["ليبكِها راغبٌ كانت ذريعتهُ","حتى تبدل ميسوراً بمعسور",16,"ر",1,0],["ليُبرِّد حشاكَ أن شواها","فوق أعناقهم وأنت المليك",17,"ك",1,0],["ليُبلِغَني عنه رباطةَ جأشِه","فيكسرُ في ذَرْعي ويكْسِفُ باليا",18,"ي",2,0],["لِيَ بَعلٌ ظَنَّهُ الناسُ أَبي","صَدِّقوني أَنَّهُ غَيرُ أَبي",19,"ي",1,1],["لِيَبكِ عَلَيهِ المُسلِمونَ فَإِنَّهُم","أَضاعوا بِهِ مُحيِ العُصورِ الدَوائِرِ",20,"ر",1,0],["لِيَبلُغَ عُذراً أَو يُصيبَ رَغيبَةً","وَمَبلَغُ نَفسٍ عُذرَها مِثلُ مَنجَحِ",21,"ح",1,0],["لِيَبُلَّ غُلَّتَهُ التي لا ترتوي","ويَكُضَّ تُهْمَةَ قلبهِ المَغْفورِ",22,"ر",1,0],["لي بَينَهُنَّ وَلائِدٌ","هُم مِن سَوادِ العَينِ نور",23,"ر",1,0],["لي بُغيَةٌ في واسِطٍ ما دونَها","إِلّا مُناقَلَةُ الهِجانِ الوُخَّدِ",24,"د",1,0],["لِيَبكِ وَكيعاً خَيلُ حَربٍ مُغيرَةٌ","تَساقى المَنايا بِالرُدَينِيَّةِ السُمرِ",25,"ر",1,1],["لِيَبكِ عَلى سَلمٍ يَتيمٌ وَبائِسٌ","وَمُستَنزَلٌ عَن ظَهرِ ساطٍ مُثابِرِ",26,"ر",1,0],["لِيَبكِ عَلى الحَجّاجِ مَن كانَ باكِياً","عَلى الدينِ أَو شارٍ عَلى الثَغرِ واقِفِ",27,"ف",1,1],["لِيَبكِ اِبنَ لَيلى غاطِشٌ سارَ شُقَّةً","وَحَبلانِ حَبلا مُستَجيرٍ وَسائِلِ",28,"ل",1,0],["لِيَبكِ اِبنَ لَيلى كُلُّ سارٍ لِنائِلٍ","عَلى عُرضِ لَيلٍ مُدلَهِمِّ الغَياطِلِ",29,"ل",1,1],["لِيَبلُغنَ مِلءَ الرَرضِ نوراً وَرَحمَةً","وَعَدلاً وَغَيثَ المُغبِراتِ القَواتِمِ",30,"م",1,0],["لِيَبكِ عَلى الاِسلامِ مَن كانَ باكياً","فَقَد تُرِكَت أَركانُهُ وَمعالِمُه",31,"ه",1,1],["لِيَبكِ عَلى نَفسِهِ مَن بَكى","فَما أَوشَكَ المَوتَ ما أَوشَكا",32,"ك",2,1],["لِيَبكِ رَسولَ اللَهِ مَن كانَ باكِيا","وَلا تَنسَ قَبراً بِالمَدينَةِ ثاوِيا",33,"ي",2,1],["لِيَبْكِ عَلَيْكِ الْقَلْبُ لا الْعَيْنُ إِنَّنِي","أَرَى الْقَلْبَ أَوْفَى بِالْعُهُودِ وَأَكْرَمَا",34,"م",2,0],["لي بينكم مرخصٌ لدمعي","وَهْوَ عزيزٌ عليَّ غالي",35,"ي",1,0],["لي بالحجازِ وساكنيهِ مآربُ","أرضٌ حكَتْ حللَ الربيعِ مدبَّجا",36,"ج",2,0],["لي بالمعرةِ شمسٌ","رضاهُ عينُ مرادي",37,"ي",1,1],["لي بِالحَياة تَعلق وَتَشدد","وَالعُمر ما بَعدَ المَدى فَسينفد",38,"د",1,1],["لي بلاءٌ وأنتَ تعرفهُ","رحمةُ الخطّاط في الكُتُب",39,"ب",1,0],["لِيَبُتَّنَّ كُلَّ عِق","دٍ إِذا نَظمُهُ اِئتَلَف",40,"ف",1,0],["لِيَبكِ مُسِنٌّ ثُمَّ أَجَلَّهُ","مَعاشِرُ لَمّا قيلَ أَشيَبُ أَجلَهُ",41,"ل",2,1],["لِيَبكِكَ الشَربُ وَالمُدامَةُ وَال","فِتيانُ طُرّاً وَطامِعٌ طَمِعا",42,"ع",2,0],["لي بعد نأي إليهن","نَ أوبة ورجوع",43,"ع",1,0],["لِيَبْكِ الصِّبَا قَلْبِي وَطَرْفِي كِلاهُما","وَقَلَّ لَهُ مِنِّي نَجِيعٌ وَأَدْمُعُ",44,"ع",1,0],["لِي بِهِ صَاحِبٌ عَلَيَّ عَزِيزٌ","مِثْلُ مَا عِنْدَهُ مِنَ الشَّوْقِ عِنْدِي",45,"ي",1,0],["لِيَبْسِمْ فِي مُحَيَّاكِ الرَّجَاءُ","وَيُبْرِقُ فِي أَسِرَّتِكِ الْهَنَاءُ",46,"ا",2,1],["لِيَبكِ عَلَيكِ وَليندُب غَريبٌ","يعدُّ أَباهُ غُربَتَهُ مَضاضا",47,"ض",2,0],["لِي بيْنَكُمْ صِلَةٌ عَزَّتْ أوَاصِرُهَا","لأَنَّهَا صِلَةُ القُرآنِ وَالنَّسَبِ",48,"ب",1,0],["لِيُبلَّ غُلَّتَهُ التي لا ترتوي","ويكظّ نهمة قلبه المغفورِ",49,"ر",1,0]]}