{"poems":[[95,"نادي الشبيبة بين أندية الحمى","https://www.aldiwan.net/poem11473.html","الكامل"],[53,"بادر غروس يديك بالسقيا","https://www.aldiwan.net/poem66710.html","أحذ الكامل"],[48,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[164,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[170,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[280,"فتح البسيطة عنكم محكي","https://www.aldiwan.net/poem25548.html","أحذ الكامل"],[290,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[458,"غضي عيونك يا نجوم فإنني","https://www.aldiwan.net/poem61323.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138353",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59650","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132872","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122098","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202160","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36266","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94634","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94635","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83169","البسيط"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52176","الكامل"],[4831,"الشيطان الأكبر","https://www.poetsgate.com/ViewPoem.aspx?id=208041",""],[4908,"تائه في سفره","https://www.poetsgate.com/ViewPoem.aspx?id=207282",""],[4935,"هذي صفات بر تقي إنسانها","https://www.poetsgate.com/ViewPoem.aspx?id=129534",""],[5038,"صروف الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=189078",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5725,"مرت عجالا","https://www.poetsgate.com/ViewPoem.aspx?id=181676",""],[5725,"يغتابنا العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=193602",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""]],"verses":[["هَذِي صَحِيفَتُهُمْ تُصَوِّرُ لِلنُّهَى","عَزَمَاتِ فُتْيَانٍ وَحَزْمِ رِجَالِ",0,"ل",1,0],["هذي صَنَائِعُكَ التي نطقَتْ","بالشكر أخْرِسها عن الشَّكوى",1,"و",2,0],["هَذي صِفاتُ اللَهِ جَلَّ جَلالُهُ","فَاِلحَق بِمَن هَجَرَ الغُواةَ مُظاهِرا",2,"ر",2,0],["هَذِي صَوَافِنُ عِزِّهَا","تَمْشِي وَتَخْتَالُ اخْتِيَالاَ",3,"ل",2,0],["هذي صحائفهم بأيدي رُسلهم","بعد العقوبة ملؤها استعفار",4,"ر",1,0],["هذي صفاتي وما أخنى عليَّ سوى","دهر بقرع صفاتي مغرمٍ سدِك",5,"ك",1,0],["هذي صقليّةُ العجماءُ ما نطقت","إِلا بلسنٍ يضاهي الماءَ تشرابا",6,"ب",2,0],["هَذِي صَوارِمُكُم مُوَصلَة","أَعداءَكُم بالقَتلِ والفَتْكِ",7,"ك",1,0],["هذي صحائف ضيغم","تتلى وما فيها خطر",8,"ر",1,0],["هذي صفاتٌ لم يحزها سيدٌ","مَلِكٌ ولا مَلَكُ السماء السامي",9,"م",2,0],["هذي صُدورُهُمُ لِبغضِ المُصطَفى","تَغلي عَلى الأَهلَيِ غَليَ المِرجَل",10,"ل",1,0],["هذي صلاتي لا أذان يؤمها","غردا ولا الأجراس بالضوضاء",11,"ا",2,0],["هذي صروح شاهقات ناطحت","سحبا محاسنها الدراري تخجل",12,"ل",1,0],["هذي صفاتهمُ أعظم بدولتنا","أخَّاذة وهْيَ طوَع الحلم حواطه",13,"ط",2,0],["هذي صفاتُ الليث ما للشِبل لا","يقفوه أم فيه فتورة ذاهلِ",14,"ل",1,0],["هَذي صَلاة الناس فَرض واجب","عَلَيهم وَلَيسَ عَنها راغب",15,"ب",1,0],["هذي صُبابة ما أَبقَت يدايَ وقد","عرفتُ حرفهُما فانظر ولا تسل",16,"ل",1,0],["هَذِي صَنَائِعُ بَلَّغَتْ كُلَّ المُنَى","فَلَهُنَّ كُلُّ النَّاسِ لَيْسَ بِنَاسِ",17,"س",1,0],["هذي صفاتُك يا مَكين وإِن غدا","فيمَنْ سِواك مَديحُها مغصوبا",18,"ب",2,1],["هذي صحائفك اليتيمة لم تجد","شرفا تخص بها وكنت بخيلا",19,"ل",2,0],["هذي صفات البحرِ أمَّا البَرُّ","حاياتُ أو مدُّ يكون أو جَزرُ",20,"ر",1,0],["هَذي صلاةُ صِلاتٍ والنّداءُ لَها","إن كانَ وتْراً فموْلَى الخَلْقِ يَشفَعُهُ",21,"ع",2,0],["هَذي صُوَرُ الحسانِ تَجلو الكَرَبا","هُزّوا شَجراتِهنَّ تلَقوا عَجَبا",22,"ب",2,1],["هذي صحيفتنا وافتك عن طلبٍ","لتظهر الحق في المرأى بتحقيقِ",23,"ق",1,0],["هذي صفاتك يا سليل كرامةٍ","فعزوتها كرماً بجود المنجدِ",24,"د",1,0],["هَذي صَحائِفُ كَالمرآةِ صادِقَةٌ","تَجلو لَنا صُوَرَ الماضينَ عَن كَثَبِ",25,"ب",1,0],["هذي صحافية بصحفي اثبتت","وبها المتاجر في الولاية رابح",26,"ح",1,0],["هذي صليما في ظلال الغابِ","حيِّ العروسَ تُطلُّ تحتَ نقابِ",27,"ب",1,1],["هَذِي صَوَارِمُنا قَدْ ثَلّها صَدَأٌ","وخيلنا اضطرمتْ في صدرها الحمم",28,"م",1,0],["هذي صروح العشق يصعب نيلها","من لي أنا والعاشقين حليفُ ؟",29,"ف",1,0],["هذي صفات بر تقي إنسانها","أوج الكمال ويزدهى تبيانها",30,"ن",3,1],["هذي صُروفُ الزّمانِ الْمُرِّ قَدْ عَصَفَتْ","بِوالِهٍ يَرْتَجي في ضَغْثِهِ الَأمَلا",31,"ل",2,0],["هذي صناديقُ الربيعِ فتحْتها","وأطرْتُ منها كالفراشِ أمانيا",32,"ي",2,0],["هذي صهيبائي تشع سنى","فاطبق علينا الليل ياكأسُ",33,"س",1,0],["هذي صهيبائي لإنْ نضبت","فأمنن بعتق الكأس يا ثغرُ",34,"ر",1,0],["هَذي(صَلَاح الدّين) بَارَكَتِ اسْمُها","بِالْفَارِسِ الْمَنْصُورِ بِالصَّلَواتِ",35,"ت",1,0],["هذي صلاتي على المختارٍ أرفعُها","وليرحمٍ اللهُ من ماتوا ومن غربوا",36,"ب",3,0],["هذي صنائعك الجلال تحيطني","يامن مكارمُ كفه لا تنفدُ",37,"د",1,0]]}