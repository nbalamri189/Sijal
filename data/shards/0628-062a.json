bi.ae/diwan/poem/5379","البسيط"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[77,"بتافلفت برغوث كثير","https://www.poetsgate.com/ViewPoem.aspx?id=34083",""],[77,"بِتنا نُكابدُ همَّ القحطِ لييلتنا","https://www.poetsgate.com/ViewPoem.aspx?id=33562",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[50,"طَرَقَتَنَا بالزَّابيَيْنِ الرَّبَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17925",""],[58,"أَحُسَيْنُ إنِّيَ واعِظٌ وَمُؤَدِّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=10082",""],[45,"هَلاّ سألتَ، بجَوّ ثَهْمَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=31623",""],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[91,"عام 1910","https://www.poetsgate.com/ViewPoem.aspx?id=53146",""],[51,"كان هزلاً فعاد جِدّاً غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=30613",""],[89,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[20,"ماذا ترجون إِن أَودى ربيعكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69775&r=&rc=16",""],[10,"يا عَينِ جُودي بالدّموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10485&r=&rc=10",""]],"verses":[["بِتنا سُجوداً عَلى الأَكوارِ يَحمِلُنا","لَواغِبٌ قَد لَطَمنَ الأَرضَ بِالثَفَنِ",0,"ن",1,0],["بِتنَ بِالشَدِّ يُخَرِّقنَ الثَرى","دَلَجَ اللَيلِ وَيَرقَعنَ القَتاما",1,"م",2,0],["بِتنا ضَجيعَينِ في ثَوبَي هَوىً وَتُقىً","يَلُفُّنا الشَوقُ مِن فَرعٍ إِلى قَدَمِ",2,"م",1,0],["بِتنا ضَجيعَينِ في ثَوبِ الظَلامِ كَما","لَفَّ الغُصَينَينِ مَرُّ الريحِ بِالأُصُلِ",3,"ل",1,0],["بِتُّ أَلهو بِناعِمِ الجيدِ غَضٍّ","وَفَمٍ بارِدِ المُجاجَةِ عَذبِ",4,"ب",1,0],["بِتُّ بِشَمٍّ وَاِعتِناقٍ لَهُ","مُستَغنِياً عَن كُلِّ رَيحانِ",5,"ن",1,0],["بِتُّ لَيلي غافِلاً عَمّا بِها","وَهيَ مِن طولِ التَشَكّي في أَلَم",6,"م",1,1],["بِتُّ وَالهَمُّ يا لُبَينى ضَجيعي","وَجَرَت مُذ نَأَيتِ عَنّي دُموعَي",7,"ع",2,1],["بِتْنَا نَجُرُّ بِهَا بُرُودَ عَفَافِنَا","قُشُبَ الْجُيُوبِ صَوَافِي الأَردَانِ",8,"ن",1,0],["بِتَاجِرةٍ رِيحٌ أَرَاحَكَ بَرْدَهَا","إِلَهٌ مَتَى اسْتَرْحَمْتَهُ فَهْوَ يَرْحَمُ",9,"م",1,1],["بِتافَلْفَلْتَ بُرْغوثٌ كثيرٌ","يضِجُّ لهوْلِهِ الملِكُ الأثيرُ",10,"ر",1,1],["بِتْنا نُكابِدُ هَمَّ القَحْطِ لَيْلَتَنا","وأنْجَدَ السُّهْدُ والكَرْبُ البَراغِيثا",11,"ث",2,1],["بِتَّ في حُلَّةِ النَعيمِ وَبِتنا","في ثِيابٍ مِنَ الأَسى وَالسُهادِ",12,"د",1,0],["بِتُّ أَخشى عَلَيكُمُ أَن يَقولوا","إِن أَثَرتُم مِن كامِناتِ الحُقودِ",13,"د",1,0],["بِتَصحيفِكَ الثاني وَحَذفِكَ ثالِثاً","يَصيرُ حَيّاً يُحيي البِلادَ بِسِجمِهِ",14,"م",2,0],["بِتُّ مِنهُ بَينَ سَهلٍ مُطمِعٍ","خادِعٌ يُتلى بِحُزنٍ مُؤيِسِ",15,"س",1,0],["بِتَعَمُّدٍ مِنهُ وَحِلمٍ","حينَ يَبغي الحِلمَ راجِح",16,"ح",1,0],["بِتَشْرِيفِهَ تَشْرِيفُ عَصْرٍ وَأُمَّةٍ","وَإِيفَاءُ مَفْرُوضٍ لأَكْرَمِ نَائِبِ",17,"ب",1,0],["بتَصَاريفِ عَازمٍ ثَقِفٍ","وَأَسَالِيبِ حَازِمٍ ذَهِنِ",18,"ن",1,0],["بِتْ فِي ظِلالِ الخُلْدِ وَلْيَطْلَعْ لَنَا","بَيْنَ الثَّوَابِتِ وَجْهُكَ البَسَّامُ",19,"م",1,0],["بِتَسليمَةٍ بَينَ خَمسٍ وَسِتٍّ","إِذا ضَمَّكَ المَجلِسُ الحافِلُ",20,"ل",1,0],["بِتَنهِيَةِ الدَحلَينِ غَيَّرَ رَسمَهُ","مِنَ المورِ نَأّاجٌ تَمُرُّ أَعاصِرُه",21,"ر",2,0],["بِتَفريقِ طِيّاتٍ تَياسَرنَ قَلبَهُ","وَشَقَّ العَصا مِن عاجِلِ البَينِ قادِحُ",22,"ح",1,0],["بتنا نراقبه بأول ليلةٍ","فإِذا به قد لاح في نصف الشهرْ",23,"ر",1,0],["بتْنَا خَيالَيْنِ الْتَحَفْنا بالضنى","والسقم ما نخشى من الرقباءِ",24,"ا",2,0],["بتَومبيل جرى في الأرض منسرحاً","كما جرى الماء من سفح الأهاضيب",25,"ب",1,0],["بِتنا نَرانا كَأَنّا مالِكونَ لَنا","يا لَيتَها صَدَّقَت بِالحَقِّ رُؤيانا",26,"ن",2,0],["بِتُّ أُرائي صاحِبَيَّ تَجَلُّداً","وَقَد عَلِقَني مِن هَواكِ عَلوقُ",27,"ق",1,1],["بِتِلكَ أُسَلّي حاجَةً إِن ضَمِنتُها","وَأُبرِئُ هَمّاً كانَ في الصَدرِ داخِلا",28,"ل",2,0],["بِتُّ أَبكيكُما وَإِنَّ عَجيباً","أَن يَبيتَ الأَسيرُ يَبكي الطَليقا",29,"ق",2,0],["بِتنا بِدارَةِ جَوّاتا يُفَزِّعُنا","صَوتُ الدَجاجِ وَأَصواتُ النَواقيسِ",30,"س",1,0],["بتدابيرَ تَفلِقُ الحجرَ الصلْ","د وتَشفي من كل داء عياءِ",31,"ا",2,0],["بتسبيحٍ له مُنجٍ","وعتهُ أذُنُ الحوتِ",32,"ت",1,0],["بتَدْبيره طَوراً وطْوراً بيمْنه","ومَا قادَهُ التَّدبيرُ فاليُمْنُ أقْوَدُ",33,"د",1,0],["بَتَّ القُوى من حبلنا","فأذاقنا فقد التَصَبّرْ",34,"ر",1,0],["بتَّ تيساً له قرونٌ عوالٍ","وهو تيسٌ له نبيبٌ وقَفْط",35,"ط",1,0],["بتُّ وبات الصبيان في أرق","من بحَّةٍ لم تزل تُفزِّعنا",36,"ن",2,1],["بتمريس لثديينِ","مرينيْنِ بتفليكِ",37,"ك",1,0],["بتلبيةٍ لا أحفِلُ الدهرَ بعدها","بذي صَمَمٍ عني ولا مُتصاممِ",38,"م",1,0],["بتُ شر المبيت ما ذُقْتُ غُمْضاً","طولَ ليلي والليلُ ليلُ تمام",39,"م",1,0],["بِتِسعينَ أَلفاً تَألَهُ العَينُ وَسطَهُ","مَتى تَرَهُ عَينا الطُرامَةِ تَدمَعا",40,"ع",2,0],["بِتُّ لا الإِلهامُ بابٌ مُشَرَعٌ","لي وَلا الأَحلامُ تَمشي في رِكابي",41,"ي",1,0],["بِتُّ مَرمى لِلدَهرِ بي يَتَعَلَّم","كَيفَ يُصمي القُلوب وَالئكبادا",42,"ا",1,0],["بِتنا عَنِ الراصِدينَ يَكتُمُنا","الأَسوَدانِ الظَلم وَالشَعَرُ",43,"ر",1,0],["بِتُّ أَرعى في الظَلامِ الأَنجُما","لَيسَ لِلعُشّاقِ حَظٌّ في الكَرى",44,"ر",2,1],["بِتنا إِذا التُركِيُّ ضَجَّ مُهَلِّلاً","عَبَثَ الهَوى بِالفارِسِيِّ فَصَفَّقا",45,"ق",2,0],["بِتنا وَباتَ الشَرقُ يَمشي القَهقَرى","مَعَ ذاكَ نَحسَبُ أَنَّنا نَتَقَدَّمُ",46,"م",1,0],["بِتَّ لا جَيشَ وَلا عَلَمٌ","يا صَريعَ الجَيشِ وَالعَلَمِ",47,"م",1,0],["بِتُّ وَالبَدرُ نَديمي","فَفَعَلنا وَتَرَكنا",48,"ن",2,0],["بِتُّ أُعاطيها فَتاةً جَمَعَت","لِعاشِقيها الحُسنَ وَالإِحسانا",49,"ن",2,0],["بِتُّ بِلَيلٍ باتَهُ","كُلُّ عَدُوٍّ لي وَلَك",50,"ك",1,0],["بِتنا بِها حَيثُ لا رَوعٌ يُخامِرُنا","وَنفحَةُ الراحِ وَالرَيحانِ مُختَمِرَه",51,"ر",2,0],["بت ليلي لما نعوا حافظا لي","وكأني من حية ملسوع",52,"ع",1,0],["بت العلاقات بالدنيا ونعمتها","موتى قد احتضنت اجسادهم حفر",53,"ر",1,0],["بِتنا نُراعيهِ كَما","يَرعى السُراةُ الكَوكَبا",54,"ب",2,0],["بِتنا وَباتَت حَناناً حَولَنا وَرِضاً","ثَلاثَةٌ بَينَ سَمعِ الحُبِّ وَالبَصَرِ",55,"ر",1,0],["بِتنا نُقاسي الدَواهي مِن كَواكِبِهِ","حَتّى قَعَدنا بِها حَسرى تُقاسينا",56,"ن",2,0],["بِتنا وَمِمّا بَينَنا","بَحرٌ وَدونَ البَحرِ بيد",57,"د",1,0],["بِتَأميلِهِ يَغنى الفَتى قَبلَ نَيلِهِ","وَبِالذُعرِ مِن قَبلِ المُهَنَّدِ يَنقَدُّ",58,"د",1,0],["بِتنا يُناوِلُنا المُدامَ بِكَفِّهِ","مَن لَيسَ يَخطُرُ أَن نَراهُ بِبالِهِ",59,"ل",2,0],["بِتنا وباتَ نسيمُ الحيِّ يجذِبُنَا","إِذا التزمنا عناقاً جَذبَ غيرانِ",60,"ن",1,0],["بِتنا وظلمةُ ليلِنا بلقائِها","صبحٌ وبِنَّا والصَّبَاحُ ظلامُ",61,"م",1,0],["بِتنا وباتَ الصَّبا وهْنَاً يُغَازِلُنَا","وفَرشُنا الرملُ رشَّتْهُ يدُ الدِّيَمِ",62,"م",1,0],["بتنا وباتَ التُّقَى يقظانَ يحرُسُنَا","ودينُنا في الهوى قولٌ ولا عملُ",63,"ل",1,0],["بِتَّها وَالقُرانُ يَصدَعُ فيها ال","هَضبَ حَتّى كادَت تَكونُ حِراءَ",64,"ا",2,0],["بِتُّ لَيلَ التَمامِ أَسهَرُ بِالوَص","لِ بِطَيفِ الخَيالِ وَهُوَ كَذوبُ",65,"ب",1,0],["بِتُّ أُفَدّيهِ وَلا أَرعَوي","لِنَهيِ ناهٍ عَنهُ أَو لَحيِ لاح",66,"ح",1,0],["بِتُّ أُبدي وَجداً وَأَكتُمُ وَجدا","لِخَيالٍ مِنَ البَخيلَةِ يُهدى",67,"د",2,1],["بِتَصَرُّفِ التَرفِ العَلي","لِ وَحُمرَةِ الخَدِّ المُوَرَّد",68,"د",1,0],["بِتنا عَلى رَقبَةِ الواشينَ مُكتَنِفَي","صَبابَةٍ نَتَشاكى البَثَّ وَالكَمَدا",69,"د",2,0],["بِتَدبيرِكَ المَيمونِ أُغلِقَ كَيدُهُ","عَلَيهِ وَكَلَّت سُمرُهُ وَبَواتِرُه",70,"ر",2,0],["بِتَدبيرِ مَأمونٍ عَلى الأَمرِ رَأيُهُ","ذَكيرٍ وَأَمضى المُرهَفاتِ ذَكيرُها",71,"ر",3,0],["بِتُّ أُعطى مِنهُ غَرائِبَ حُسنٍ","باتَ عَن مَنعِها الوَفاءُ مَريضا",72,"ض",2,0],["بِتُّ وَوالي السَوادِ مِثلي","يَجمَعُنا بِرُّهُ اللَطيفُ",73,"ف",1,0],["بِتنا وَلي قَمرانِ وَجهُ مُساعِدي","وَالبَدرُ إِذ وافى التَمامَ وَأَكمَلا",74,"ل",2,0],["بِتَسديدِهِ تُلغى الأُمورُ وَتُجتَبى","وَتُنقَضُ أَسبابُ الخُطوبِ وَتُبرَمُ",75,"م",1,0],["بِتُّ عَن راحَتَيهِ شارِبَ خَمرٍ","وَكَأَنّي لِلسُقمُ شارِبُ سِمِّ",76,"م",1,0],["بِتنا جُنوحاً عَلى كُثبِ اللِوى فَأَبى","خَيالُ ظَمياءَ إِلّا أَن يُحَيِّينا",77,"ن",2,0],["بِتنا بِباشِيّا مِنَ اجلِكَ لَيلَةً","بَلِيَ المَطِيُّ بِبُؤسِها وَبَلينا",78,"ن",2,0],["بِتَوبَةِ عَبدٍ قَد أَنابَ فُؤادُهُ","وَما كانَ يُعطي الناسَ غَيرَ ظِلامِ",79,"م",1,0],["بِتْنا وضَوْءُ الكؤوسِ يَهتِكُ بال","إشْراقِ سِترَ الدُّجى فينهَتِكُ",80,"ك",1,0],["بِتَفَكُّرٍ