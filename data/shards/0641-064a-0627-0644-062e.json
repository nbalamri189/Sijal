{"poems":[[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[74,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[45,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[42,"قد كان ما بي قبل رؤيتكم","https://www.aldiwan.net/poem42325.html","أحذ الكامل"],[70,"ما اسم فتى حروفه","https://www.aldiwan.net/poem1547.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[108,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[186,"روزا فتاة بني الجاويش قد رحلت","https://www.aldiwan.net/poem61047.html","البسيط"],[186,"من آل فياض عزيز ماجد","https://www.aldiwan.net/poem61152.html","البسيط"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[214,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[264,"دع نظم كل تغزل","https://www.aldiwan.net/poem35753.html","مجزوء الكامل"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[287,"قلت لما أزمع الحي الرحيلا","https://www.aldiwan.net/poem32307.html","الرمل"],[287,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[376,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[396,"حسين إعلم أن الشيطنه قد لها ناس","https://www.aldiwan.net/poem54560.html","عموديه"],[484,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[484,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[549,"في كل عضو منك روح تقى","https://www.aldiwan.net/poem67236.html","عموديه"],[566,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[567,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126882","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122777","المنسرح"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112466","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38198","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70948","المديد"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78086","المواليا"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108630","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42442","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106980","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137241",""],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201753","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201696",""],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121374","الكامل"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60283","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66436","السريع"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125781","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216616",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95334","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36556","الدوبيت"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123487","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73171","البسيط"],[4767,"عزاء القديح","https://www.poetsgate.com/ViewPoem.aspx?id=89967",""],[4885,"ضمة وقبلتين","https://www.poetsgate.com/ViewPoem.aspx?id=214944",""],[5002,"ألواَنُ الدُّمُوعِ....","https://www.poetsgate.com/ViewPoem.aspx?id=207168",""],[5206,"أرض الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=187396",""],[5268,"رصيفُ الجامِعَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=206995",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5690,"دهر يزعزع ركن المجد والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=172140",""],[5939,"بُعدًا هواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=178576",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""]],"verses":[["في الخَيلِ وَالخافِقاتِ السودِ لي شُغلٌ","لَيسَ الصَبابَةُ وَالصَهباءُ مِن شُغلي",0,"ل",2,0],["في الخدِّ لامٌ وفي عطف الصبا ألف","وآلة المنع بين اللاّم والألف",1,"ف",1,0],["في الخضم الطامي ستنكس فلكي","صخرة في طريقها أي نكس",2,"س",1,0],["في الخَدِّ أَن عَزَمَ الخَليطُ رَحيلاً","مَطَرٌ تَزيدُ بِهِ الخُدُودُ مُحولا",3,"ل",2,1],["في الخَدِّ تُحدِرُهُ الشُؤُونُ","لَهُ سَيلٌ تَبادِرُ سَكبُهُ كَفّى",4,"ف",2,0],["في الخَطّ عن ترتيبها","مُقْلَتُهُ إن نَظَرَتْ",5,"ت",1,0],["فِي الخافِتِ الرَّاجِفِ مِنْ صَوْتِهِ","رَجْعّ بَعِيدٌ مِنْ صَدَى نَفْسِ",6,"س",1,0],["في الخيالات وفي شكوى","الحنين المستكين",7,"ن",1,0],["في الخدِّ كالتفاح لا","يَخبو توقُّدُ جمره",8,"ر",2,0],["في الخَمس عَشرة قَد وَلَّت فحسرتُها","تَبقى مَدى الدَّهرِ لا خَمساً وَلا عَشرا",9,"ر",2,0],["في الخَمسِ وَالعشرينَ وَلَّى وَلَم يَدَع","ثَمَراً بِهِ يَسلو الحَزينُ وَيُجبَرُ",10,"ر",1,0],["في الخندقِ الصخرُ مثل الرملِ صار لهُ","مِن بعدِ أن عجزت عنه المعاويلُ",11,"ل",1,0],["فيالخير تأتي في الزيادة هذه","وذلك يأتي في الزيادة بالكسر",12,"ر",1,0],["في الخير خفَّ كما النسي","مُ وفي الوقار كيذبل",13,"ل",1,0],["في الخيمة انقصمت عراي لزلتي","وَالنار للعاصين بالمرصاد",14,"د",1,0],["في الخُصورِ الهيفِ جالَت وُشَّحٌ","لَطُفَت وَالسوقُ غَصَّصنَ الحُجولا",15,"ل",2,0],["في الخَدِّ مِنهُ نُقطَةٌ مِن عَنبَرٍ","أَكادُ أَن أَشرَبَها بِوَهمي",16,"م",2,0],["في الخَفضِ يَخفضُ صَوتَه","فَإِذا عَلا شَرَفاً أَهَلا",17,"ل",2,0],["في الخفا والنجاسة والخساسه والأردجاس","معدن الغم والغفلة ووسواس خناس",18,"س",1,0],["في الخلق والخلق سواه وأكمله","دينا تنزه عن حصر بآماد",19,"د",1,0],["في الخير أسعى دائما فجميعنا","لجميعنا جزء من الأجزاء",20,"ا",2,0],["في الخِدرِ منها العِيسُ تحملُ جُؤذراً","ويُقلُّ منه الليثُ سَرْجَ حِصانهِ",21,"ن",2,0],["في الخَصرِ ما في الجِيدِ من وَرَعٍ","لا تسألي مَن منهما الأتقى",22,"ق",2,0],["في الخُشبِ تَحتَ الهَدَبِ اليَخضورِ","مَثواةُ عَطّارينَ بِالعُطورِ",23,"ر",1,0],["في الخيمةِ الزَّرقاءِ بِتِّ كأنَّما","أمسَيتِ فوقَ القُبَّةِ الزَّرقاءِ",24,"ا",2,0],["في الخير كنت لكل فرد ساعياً","سعياً بخير النفع كان يعود",25,"د",1,0],["في الخُلدِ حلّ وقَد حظي بنعيمها","واللّه ملّكه بحور عينِ",26,"ن",1,0],["في الخيمِ المُشرِفاتِ آنِسَةٌ","قَد أَلزَمَتني رِعايَةَ الخيَمِ",27,"م",1,0],["في الخضم المائج المتسع","هي مي هي نور الأمل",28,"ل",1,0],["في الخَلقِ أَنفَذَ حُكمَهُ","طِبقَ المُرادِ وَمُقتضى",29,"ض",2,0],["في الخنا مَشْتىً له وله","فيه مُصطافٌ ومُرْتَبَعُ",30,"ع",1,0],["في الخدّ منه جنة ونار","والثغر فيه الشهد والعقار",31,"ر",1,0],["في الخير والحسرة والندامه","ومعقبات الخزي في القيامه",32,"ه",1,0],["في الخَد وَالخال عُطر الوَرد وَالعُود","رَياهُما كادَ بَعدَ المَوت يَحيينا",33,"ن",2,0],["في الخارجية نورٌ يدهش البصرا","ويخجل النيرين الشمس والقمرا",34,"ر",2,1],["في الخالِ والجيدِ عمري ما عبدا","لا تحسبوا أنَّ ذاك الخالَ حينَ بدا",35,"د",2,0],["في الخصر في الردف","اجول رائحا ومغتدي",36,"د",2,0],["في الخطب قد وقفت عليه حياتها","والجفن منها ما جفاه رقاد",37,"د",1,0],["في الخَيرِ قَد أَقامَ خير قلَّه","قَد مُلئت تُرباً بِغَير عِلَّه",38,"ه",1,0],["في الخط خط الاستواء ترصعت","فصلت بمنطقة البروج وثنت",39,"ت",1,0],["فيا لخصمٍ لم أطق قتله","من نَتنه الخانق للقلب",40,"ب",1,0],["في الخلد كنت كآدم","ورجعت فِعلةَ آدم",41,"م",1,0],["في الخندقِ المشهور إذ ألقى بها","بيدٍ ورام دفاعها بثمار",42,"ر",1,0],["في الخلق ثم الأمر ثم إليه في","هود مرد الأمر أي ذا المنزل",43,"ل",1,0],["في الخير مالي متجر رابحُ","وسوء فعلي بيّن واضحُ",44,"ح",1,1],["في الخلق والخُلق والمجد الرفيع وفي","جميع ما تبتغي سلطانة جاها",45,"ا",3,0],["في الخَلقِ عَمّا تَبتَغي عَجزٌ وَفي","خُلُقِ الزَّمانِ تَجهمٌ وَصُدودُ",46,"د",1,0],["في الخمس بعد العشر ساحرةٌ","اعيت فنون قهارم السحر",47,"ر",1,0],["في الخصم أنكى وهي النكايه","وقد رفأت ثوبه والرايه",48,"ه",1,0],["في الخلد يسمو راسخاً للدهر","ألفته سح عرقاً فوارا",49,"ر",2,0],["في الخلد زنث جرى اسمه وكسا","بالإسكمندر في الورى انطلقا",50,"ق",2,0],["في الخصلتين ماهرا غواي","فز ينب لديه مثل زيد",51,"د",1,0],["في الخال عَلى خَدِّك حارَ الطرفُ","أَحكيه عَلى الوجه وَأَعيا الوَصفُ",52,"ف",1,1],["في الخلق والخلق فاق الخلق أجمعهم","حسنا وناهيك خلقا راضيا دمثا",53,"ث",2,0],["في الخمرِ من خَدَّهِ القاني ومنظرهِ","وريقِ فيهِ ومن عينيهِ أَوصافُ",54,"ف",1,0],["في الخلد في جنات عدن بالذي","جاؤوا إليك به من القربات",55,"ت",1,0],["في الخَدِّ حُمْرَةُ وردٍ أُشرِبَتْ خجلا","تحكي احمرار دمائي في الهوى هَدَرا",56,"ر",2,0],["فِي الخَدِّ أثْلاَمُهُ كالسَّهْلِ يُوْشِمُهَا","يبدُو بِه الوَجْهُ كالأجْواَءِ والغَممِ",57,"م",1,0],["فِي الخُلْدِ قَرَّتْ فَاسْتَقَرَّ جَنَابُهَا","نِعمَ المَقَرُّ ونِعمَ ذَاكَ المَفْزَعُ",58,"ع",1,0],["في الخُطوةِ الأولى سألتِ عن الهوى","وصدىً بقلبينا يُطيلُ تضرُّعَهْ",59,"ع",2,0],["في الخلدِ ناظرةٌ أصحابها زمرٌ","لرؤيةِ الله فيها ران حالمُها",60,"م",3,0],["في الخلدِ فردوسُه والحمد لاهجه","لا يْتركنَّ تسابيحاً بعطرِ فمِ",61,"م",1,0],["في الخافقين لقد رنّ قصائده","وكم تغنت بها الآلات في الطربِ",62,"ب",1,0],["في الخدِّ أَبغي خالَها","أَنوي أُكلّمُ خالَها",63,"ل",3,0],["فيا لخدور قد أبيحت ونسوة","أريعت وعين السبط ترعى انذعارها",64,"ر",3,0]]}