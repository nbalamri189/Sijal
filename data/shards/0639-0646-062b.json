{"poems":[[73,"يا أولي العلم خبروني فإني","https://www.aldiwan.net/poem3860.html","الخفيف"],[46,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[190,"نكهات الشباب تغني عن المس","https://www.aldiwan.net/poem43789.html","الخفيف"],[463,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59260","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84507","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36588","الدوبيت"],[4755,"عَمَّ يَتَحَدَّثُون ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184735",""],[4929,"ردا على بيتين للشاعر أبرهيم الباشا","https://www.poetsgate.com/ViewPoem.aspx?id=202330",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5409,"متى يحرر وادينا صحائفه","https://www.poetsgate.com/ViewPoem.aspx?id=155444",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""]],"verses":[["عَن ثَلاثٍ لَزِمنَني أَخواتٍ","مُفصِحاتٍ نيطَت بِثَنتَينِ عُجمِ",0,"م",1,0],["عَن ثامِرٍ ضافٍ وَنَبتِ قَرارَةٍ","وافٍ وَنَورٍ كَالمَراجِلِ خافِ",1,"ف",1,0],["عن ثالث الحَرَمين ندفعُ عُصْبة","دخلَتْهُ كالمكروبِ إذْ يتسلَّل",2,"ل",1,0],["عن ثنايا هشيمة جفرات","واهنات القوى وناب كسير",3,"ر",1,0],["عن ثقةٍ أنّ حبالَ عهدِه","لفاتلٍ لم يألُ في إبرامِها",4,"م",3,0],["عَنْ ثُرَيَّا النُّورِ عَنْ قُطْبِ السَّنَا","عَنْ شِهَابِ الحُسْنِ عَنْ شَمْسِ الكَمَالْ",5,"ل",1,0],["عن ثقفيّهم عن الكتامي","عن الشلوبين الرضى الإمام",6,"م",1,0],["عن ثغورٍ كالبروقِ اللُّمعِ","قَرَّ طرفُ الفخرِ منها بالحسن",7,"ن",1,0],["عَن ثغرِكَ وَالرِضاب في فيكِ كَنوا","بِالبارِقِ وَالعُذَيبِ مِن أَرض عَقيق",8,"ق",1,0],["عَن ثَورَةٍ فِي عَامِهَا الثَّالِثِ ؟!","عَن وَارِثٍ لِلشَّعبِ مِن وَارِثِ ؟!",9,"ث",1,1],["عَن ثائِرٍ يَرمِي بأحلامِهِ","خَضْرَاءَ بَينَ العَهْدِ والنَّاكِثِ ؟",9,"ث",1,0],["عن ثناءٍ أوليتَ شِعريْ شذيٍّ","دونَهُ يضْمحِلُّ في العطرِ ورْدُ",10,"د",1,0],["عن ثغرها ورحيق الشهد يرفده","عن وجنتيها وزهر الورد ينديها",11,"ي",3,0],["عن ثورةٍ كجنين حان مولده","لما تكامل في الأفكار لا الرحم",12,"م",1,0],["عن ثورها عن حَق مَن تحلو له","بسماتُها، عن حقِّ مَن يحلو لها",13,"ه",2,0],["21- عَنْ ثَوْرَةٍ نَحْكِي فُصُولَ تَتَابُعِ (م)","الصَّمْتِ الدَّنِيْ، عَنْ غَزَّةَ الأَلْغَامِ",14,"م",1,0]]}