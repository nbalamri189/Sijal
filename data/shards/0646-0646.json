نا السَيفُ مُنتَضى",8,"ض",2,0],["نُناجيهِ فَنَستَرعي حَكيماً","وَنَسأَلُهُ فَنَستَجدي جَوادا",9,"د",2,0],["نُنَظِّمُ مِنها لُؤلُؤاً في سُلوكِهِ","وَمِن عَجَبٍ تَنظيمُ ما لا يُثَقَّبُ",10,"ب",1,0],["نَنسى أَيادي الزَمانِ فينا فَما","نَذكُرُ مِن دَهرِنا سِوى نُوَبِه",11,"ب",2,0],["نَنصُبُ في الأَرضِ لها","عِقالَ حَتفٍ كالوَهَقْ",12,"ق",1,0],["نُنافِسُ في الدُنيا وَنَحنُ نَعيبُها","لَقَد حَذَّرَتناها لَعَمري خُطوبُها",13,"ب",3,1],["نُنافِسُ فيها وَأَيّامُنا","تَرَدَّدُ فينا بِآفاتِها",14,"ت",3,0],["نَنسى المَنايا عَلى أَنّا لَها غَرَضُ","فَكَم أُناسٍ رَأَيناهُم قَدِ اِنقَرَضوا",15,"ض",3,1],["نُنْشأُ بالبعث بعد ميتتنا","أما يُعيدُ الزجاجَ مَن سبَكه",16,"ك",2,0],["نَنامُ من الأيّامِ في غَرَضِ النَّبْلِ","ونُغْذى بمُرّ الصّاب منها فنستحلي",17,"ل",2,1],["نَنتَقي لَفظَ وَصفِهِ ونُرَوِّي","مُدَداً في خواطِرِ الأَفكارِ",18,"ر",1,0],["ننصُرُ اللهَ ونحمِي أُمّةً","نحن منها في الصَّميمِ المُعرقِ",19,"ق",1,0],["نَنُوءُ من الجِراحِ بما حملنا","ونمشِي للكفاحِ مُصفَّدينا",20,"ن",2,0],["نَنسى وَيَعطِفُنا الإِخاءُ فَنَذكُرُ","وَالحُبُّ يُطوى في القُلوبِ وَيُنشَرُ",21,"ر",1,1],["نُنازِلُ من دون النّحورِ أسِنّةً","إذا انتصَبَتْ فيها الثُّدِيُّ الفَوالك",22,"ك",1,0],["نُنافِسُ فيها وَأَيّامُها","تَرَدَّدُ فينا بِآفاتِها",23,"ت",3,0],["نَنزِلُ مِن دارٍ لَنا رَحبَةٍ","تَُطَلُّ بِالآفاتِ أَو توبَلُ",24,"ل",1,0],["نَنْتَظِمْ فِي شِبْهِ تَاجٍ بَاهِرٍ","يُزْرِي بِالدِّرِّ",25,"ر",1,0],["نَنَادِي أَبرَّ الأَصْدِقَاءِ وَلَمْ يكنْ","يُخَيِّبُ إِذْ يُدْعَى رَجَاءً لآمِلِ",26,"ل",1,0],["نُنَادِي أَبَا جِبْرِيلَ بِاسْمِ وَحِيدِهِ","وَقَدْ كَانَ لاَ يُعْتَاقُ عَنْهُ بِشَاغِل",26,"ل",1,0],["نناجيكَ هذي راية العُربِ فاحمها","فمن حولها أجنادُكَ البُسَلاءُ",27,"ا",2,0],["نندبُ الكاتبَ الذي يرسل القو","لَ قويَّ الأداءِ معنى ومَبنَى",28,"ن",2,0],["ننازع أيامنا صفوها","وما للصفاء بها واجده",29,"د",2,0],["ننجز لا نمضي ولا ننثني","لا نحن أيقاظ ولا نوم",30,"م",1,0],["نُنْزِلُ الضَّيْفَ- إذَا مَا حَلَّ في حبَّة ِ القلبِ وألواذِ الحشا","رُبَّ ضَيْفٍ تاجِرٍ أَخسَرتُهُ بعته المطعمَ وابتعتُ الثَّنا",31,"ا",1,0],["نَنُوطُ آمَالَنَا مِنْهُ إلى مَلِكٍ","مُرَدَّدٍ في صَرِيحِ المَجدِ، مَنسُوبِ",32,"ب",1,0],["'نّني كلّما تأمّلت طفلا","خلت أنّي أرى ملاكا سويا",33,"ي",2,0],["ننتابه غرضين عند صوافنٍ","وضوامرٍ يصرفن بالأكوار",34,"ر",1,0],["ننضّر البؤس عند البائسين منى","والعقل عاطفة والثكل إيمانا",35,"ن",2,0],["ننهمي أمطارا … أو تهوي","أشلاء … أو نمضي فرسان",36,"ن",1,0],["ننجرّ … لا نمضي … ولا ننثني","لا نحن أيقاظ … ولا نوّم",37,"م",1,0],["نناجي البارق النجدي نبكي","وقد يبكي الموله ما يعاني",38,"ن",2,0],["نناجيكمو يا ساكني حلب الشهبا","مناجاة من نيرانه دنت الشهبا",39,"ب",2,1],["ننعي البشاشة والندى وتواضعا","بذَّ العدا ترعى عهود ولاكا",40,"ك",2,0],["ننعي وفاءً في طباعك خلقةً","وتجلداً جُبلت عليه قواكا",40,"ك",2,0],["ننال بأدنى القولِ منك مدَى العلا","ولا عجبٌ أن يُحضر الدُّرُّ بالماسِ",41,"س",1,0],["نُنَعَّمُ في دارِ الرِضا وَنُرَفَّهُ","تَوَجَّه بِهِ لِلَّهِ في كُلِّ أَزمَةٍ",42,"ه",1,0],["نُناجي بِإضمارِ الهَوى ظاهرَ الهَوى","بِأَطيبَ من نجوى الأَماني الكَواذبِ",43,"ب",1,0],["نَنظُر سُلَيمَى فإِن ضَنَّت بنائِلِها","عَنَّا انصَرَفنا وماذا يَنفَعُ النَّظَرُ",44,"ر",1,0],["نناديهم فلا نلقى جوابا","نداء الحر ليس له مجيب",45,"ب",1,0],["ننبينا المجتبى هادي الأنام إلى","دار السلام ودار الخلد والنظر",46,"ر",1,0],["ننشُّدُ الوَصلَ قد يكونُ قريبا","هل على العاشقين ثَمَّ حِساب",47,"ب",1,0],["نُنهِلُ الخطيّ من أعدائنا","ثُمَّ نَفري الهامَ إِن لَم نَفتَرش",48,"ش",1,0],["نَنعِشُ العافي وَمَن لاذَ بِنا","بِسِجالٍ جِئنَ مِن أَيدي نُعُش",48,"ش",1,0],["ننشر الأحلام خمراً","كرمها في شفتينا",49,"ن",2,0],["ننقذ المستجير","ونقيل العثار",50,"ر",1,0],["نناجي الامل الذاوي","وشغلك في الهوى شغلي",51,"ل",2,0],["ننزل بدار السلام","جنات فيها رضا الله",52,"ه",1,0],["ننال بالشافع المقبول","ماليس يخطر بقلب إنسان",53,"ن",1,0],["نُنافِسُ في الدُنيا غُروراً وَإِنَّما","قَصارى غِناها أَن يَؤولَ إِلى الفَقرِ",54,"ر",1,0],["ننظِمُ من أمداحِه جوهراً","نُخرجُه من بحرِه الزاخِرِ",55,"ر",1,0],["ننام مسرورين في غبطة","لم ندر ما عاقبة النائم",56,"م",1,0],["ننازع في ميراثه قبل دفنه","كأنا أمنا قبله موقع الدفن",57,"ن",1,0],["ننازع