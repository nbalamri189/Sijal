{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[54,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[47,"ولي منة في رقاب الضباب","https://www.aldiwan.net/poem25271.html","المتقارب"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"لعمرك ما أعطى الرجال حقوقهم","https://www.aldiwan.net/poem65513.html","الطويل"],[91,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[70,"علي وعندي ما تريد من الرضا","https://www.aldiwan.net/poem42844.html","الطويل"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[61,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[49,"ننافس في الدنيا ونحن نعيبها","https://www.aldiwan.net/poem10383.html","الطويل"],[49,"رضيت لنفسك سوءاتها","https://www.aldiwan.net/poem10854.html","المتقارب"],[49,"ننسى المنايا على أنا لها غرض","https://www.aldiwan.net/poem62138.html","البسيط"],[80,"نفوسنا بالرجاء ممتسكه","https://www.aldiwan.net/poem31223.html","المنسرح"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"ننسى ويعطفنا الإخاء فنذكر","https://www.aldiwan.net/poem43089.html","الكامل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"رضيت لنفسك سوآتها","https://www.aldiwan.net/poem62479.html","المتقارب"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54851","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[54,"عَلِّلانِي بِسَمَاعٍ وَطِلا","https://www.poetsgate.com/ViewPoem.aspx?id=13864",""],[45,"أتَارِكِي أنْتَ أمْ مُغْرًى بتَعْذيبي","https://www.poetsgate.com/ViewPoem.aspx?id=31689",""],[91,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=53397",""]],"verses":[["نَنثَني جازِعينَ مِن عَدوَةِ الدَه","رِ وَنَرتاعُ لِلمَنايا الدَواني",0,"ن",2,0],["نُنادي أميرَ المؤْمِنينَ ودونَهُ","أعادٍ يُزِجّونَ العَقارِبَ لُسَّعا",1,"ع",2,0],["نَنهَبُ اللَهوَ غافِلَينَ وَكُنّا","نَحسَبُ الدَهرَ قَد أَنابَ وَتابا",2,"ب",2,0],["نُنزِلُ الضَيفَ إِذا ما حَلَّ في","حَبَّةِ القَلبِ وَأَلواذِ الحَشا",3,"ا",1,0],["نُنَكِّبُ عَنهُنَّ فُرسانُهُنَّ","وَنَبدَأُ بِالأَخيَرِ الأَخيَرِ",4,"ر",1,0],["ننتابُ فيها نائلاً","جَزْلاً متى شئنا انتيابهْ",5,"ب",2,0],["ننادم أقواماً لغير هوادة","صبوح المنايا تارة وغبوقها",6,"ق",3,0],["نَنأى عَنِ الحُسنِ وَنَشتاقُهُ","وَنَهجُرُ الماءَ وَنَشكو الأُوام",7,"م",1,0],["نُنَزِّهُ سِرّاً بَينَنا وَنَصونُهُ","وَلو كانَ فيما بَينَنا السَيفُ مُنتَضى",8,"ض",2,0],["نُناجيهِ فَنَستَرعي حَكيماً","وَنَسأَلُهُ فَنَستَجدي جَوادا",9,"د",2,0],["نُنَظِّمُ مِنها لُؤلُؤاً في سُلوكِهِ","وَمِن عَجَبٍ تَنظيمُ ما لا يُثَقَّبُ",10,"ب",1,0],["نَنسى أَيادي الزَمانِ فينا فَما","نَذكُرُ مِن دَهرِنا سِوى نُوَبِه",11,"ب",2,0],["نَنصُبُ في الأَرضِ لها","عِقالَ حَتفٍ كالوَهَقْ",12,"ق",1,0],["نُنافِسُ في الدُنيا وَنَحنُ نَعيبُها","لَقَد حَذَّرَتناها لَعَمري خُطوبُها",13,"ب",3,1],["نُنافِسُ فيها وَأَيّامُنا","تَرَدَّدُ فينا بِآفاتِها",14,"ت",3,0],["نَنسى المَنايا عَلى أَنّا لَها غَرَضُ","فَكَم أُناسٍ رَأَيناهُم قَدِ اِنقَرَضوا",15,"ض",3,1],["نُنْشأُ بالبعث بعد ميتتنا","أما يُعيدُ الزجاجَ مَن سبَكه",16,"ك",2,0],["نَنامُ من الأيّامِ في غَرَضِ النَّبْلِ","ونُغْذى بمُرّ الصّاب منها فنستحلي",17,"ي",1,1],["نَنتَقي لَفظَ وَصفِهِ ونُرَوِّي","مُدَداً في خواطِرِ الأَفكارِ",18,"ر",1,0],["ننصُرُ اللهَ ونحمِي أُمّةً","نحن منها في الصَّميمِ المُعرقِ",19,"ق",1,0],["نَنُوءُ من الجِراحِ بما حملنا","ونمشِي للكفاحِ مُصفَّدينا",20,"ن",2,0],["نَنسى وَيَعطِفُنا الإِخاءُ فَنَذكُرُ","وَالحُبُّ يُطوى في القُلوبِ وَيُنشَرُ",21,"ر",1,1],["نُنازِلُ من دون النّحورِ أسِنّةً","إذا انتصَبَتْ فيها الثُّدِيُّ الفَوالك",22,"ك",1,0],["نُنافِسُ فيها وَأَيّامُها","تَرَدَّدُ فينا بِآفاتِها",23,"ت",3,0],["نَنزِلُ مِن دارٍ لَنا رَحبَةٍ","تَُطَلُّ بِالآفاتِ أَو توبَلُ",24,"ل",1,0],["نَنْتَظِمْ فِي شِبْهِ تَاجٍ بَاهِرٍ","يُزْرِي بِالدِّرِّ",25,"ر",1,0],["نَنَادِي أَبرَّ الأَصْدِقَاءِ وَلَمْ يكنْ","يُخَيِّبُ إِذْ يُدْعَى رَجَاءً لآمِلِ",26,"ل",1,0],["نُنَادِي أَبَا جِبْرِيلَ بِاسْمِ وَحِيدِهِ","وَقَدْ كَانَ لاَ يُعْتَاقُ عَنْهُ بِشَاغِل",26,"ل",1,0],["نناجيكَ هذي راية العُربِ فاحمها","فمن حولها أجنادُكَ البُسَلاءُ",27,"ا",2,0],["نندبُ الكاتبَ الذي يرسل القو","لَ قويَّ الأداءِ معنى ومَبنَى",28,"ن",2,0],["نُنْزِلُ الضَّيْفَ- إذَا مَا حَلَّ في حبَّة ِ القلبِ وألواذِ الحشا","رُبَّ ضَيْفٍ تاجِرٍ أَخسَرتُهُ بعته المطعمَ وابتعتُ الثَّنا",29,"ا",1,0],["نَنُوطُ آمَالَنَا مِنْهُ إلى مَلِكٍ","مُرَدَّدٍ في صَرِيحِ المَجدِ، مَنسُوبِ",30,"ب",1,0],["'نّني كلّما تأمّلت طفلا","خلت أنّي أرى ملاكا سويا",31,"ي",2,0]]}