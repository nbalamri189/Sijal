","https://www.aldiwan.net/poem23149.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54851","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[100,"كانوا رجالا","https://www.poetsgate.com/ViewPoem.aspx?id=50425",""],[54,"عَلِّلانِي بِسَمَاعٍ وَطِلا","https://www.poetsgate.com/ViewPoem.aspx?id=13864",""],[45,"أتَارِكِي أنْتَ أمْ مُغْرًى بتَعْذيبي","https://www.poetsgate.com/ViewPoem.aspx?id=31689",""],[91,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=53397",""],[94,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[100,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[100,"كانوا رجالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67691&r=&rc=178",""],[115,"بعيشك هات اخبار المغاني","https://www.aldiwan.net/poem40469.html","عموديه"],[115,"نناجيكمو يا ساكني حلب الشهبا","https://www.aldiwan.net/poem41252.html","عموديه"],[135,"حق على شعراء مصر رثاكا","https://www.aldiwan.net/poem49172.html","الكامل"],[142,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[150,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[155,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[181,"زوروا بنا اليوم سلمى أيها النفر","https://www.aldiwan.net/poem58885.html","البسيط"],[211,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[304,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[321,"سكن الليل والأماني عذاب","https://www.aldiwan.net/poem26685.html","عموديه"],[322,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[328,"سكر الليل بكاسات السكون","https://www.aldiwan.net/poem54974.html","الخفيف"],[342,"في اصطخاب الحياة","https://www.aldiwan.net/poem55316.html","مجزوء الخفيف"],[342,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[391,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[391,"يا من له الحول والقوه","https://www.aldiwan.net/poem54466.html","عموديه"],[406,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[432,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[441,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[441,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[441,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[449,"سلام على الماضي","https://www.aldiwan.net/poem1000.html",""],[479,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[544,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[551,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[562,"نفذ القضا من أوج ذلك المنبر","https://www.aldiwan.net/poem52778.html","الكامل"]],"verses":[["نَنثَني جازِعينَ مِن عَدوَةِ الدَه","رِ وَنَرتاعُ لِلمَنايا الدَواني",0,"ن",2,0],["نُنادي أميرَ المؤْمِنينَ ودونَهُ","أعادٍ يُزِجّونَ العَقارِبَ لُسَّعا",1,"ع",2,0],["نَنهَبُ اللَهوَ غافِلَينَ وَكُنّا","نَحسَبُ الدَهرَ قَد أَنابَ وَتابا",2,"ب",2,0],["نُنزِلُ الضَيفَ إِذا ما حَلَّ في","حَبَّةِ القَلبِ وَأَلواذِ الحَشا",3,"ا",1,0],["نُنَكِّبُ عَنهُنَّ فُرسانُهُنَّ","وَنَبدَأُ بِالأَخيَرِ الأَخيَرِ",4,"ر",1,0],["ننتابُ فيها نائلاً","جَزْلاً متى شئنا انتيابهْ",5,"ب",2,0],["ننادم أقواماً لغير هوادة","صبوح المنايا تارة وغبوقها",6,"ق",3,0],["نَنأى عَنِ الحُسنِ وَنَشتاقُهُ","وَنَهجُرُ الماءَ وَنَشكو الأُوام",7,"م",1,0],["نُنَزِّهُ سِرّاً بَينَنا وَنَصونُهُ","وَلو كانَ فيما بَينَنا السَيفُ مُنتَضى",8,"ض",2,0],["نُناجيهِ فَنَستَرعي حَكيماً","وَنَسأَلُهُ فَنَستَجدي جَوادا",9,"د",2,0],["نُنَظِّمُ مِنها لُؤلُؤاً في سُلوكِهِ","وَمِن عَجَبٍ تَنظيمُ ما لا يُثَقَّبُ",10,"ب",1,0],["نَنسى أَيادي الزَمانِ فينا فَما","نَذكُرُ مِن دَهرِنا سِوى نُوَبِه",11,"ب",2,0],["نَنصُبُ في الأَرضِ لها","عِقالَ حَتفٍ كالوَهَقْ",12,"ق",1,0],["نُنافِسُ في الدُنيا وَنَحنُ نَعيبُها","لَقَد حَذَّرَتناها لَعَمري خُطوبُها",13,"ب",3,1],["نُنافِسُ فيها وَأَيّامُنا","تَرَدَّدُ فينا بِآفاتِها",14,"ت",3,0],["نَنسى المَنايا عَلى أَنّا لَها غَرَضُ","فَكَم أُناسٍ رَأَيناهُم قَدِ اِنقَرَضوا",15,"ض",3,1],["نُنْشأُ بالبعث بعد ميتتنا","أما يُعيدُ الزجاجَ مَن سبَكه",16,"ك",2,0],["نَنامُ من الأيّامِ في غَرَضِ النَّبْلِ","ونُغْذى بمُرّ الصّاب منها فنستحلي",17,"ي",1,1],["نَنتَقي لَفظَ وَصفِهِ ونُرَوِّي","مُدَداً في خواطِرِ الأَفكارِ",18,"ر",1,0],["ننصُرُ اللهَ ونحمِي أُمّةً","نحن منها في الصَّميمِ المُعرقِ",19,"ق",1,0],["نَنُوءُ من الجِراحِ بما حملنا","ونمشِي للكفاحِ مُصفَّدينا",20,"ن",2,0],["نَنسى وَيَعطِفُنا الإِخاءُ فَنَذكُرُ","وَالحُبُّ يُطوى في القُلوبِ وَيُنشَرُ",21,"ر",1,1],["نُنازِلُ من دون النّحورِ أسِنّةً","إذا انتصَبَتْ فيها الثُّدِيُّ الفَوالك",22,"ك",1,0],["نُنافِسُ فيها وَأَيّامُها","تَرَدَّدُ فينا بِآفاتِها",23,"ت",3,0],["نَنزِلُ مِن دارٍ لَنا رَحبَةٍ","تَُطَلُّ بِالآفاتِ أَو توبَلُ",24,"ل",1,0],["نَنْتَظِمْ فِي شِبْهِ تَاجٍ بَاهِرٍ","يُزْرِي بِالدِّرِّ",25,"ر",1,0],["نَنَادِي أَبرَّ الأَصْدِقَاءِ وَلَمْ يكنْ","يُخَيِّبُ إِذْ يُدْعَى رَجَاءً لآمِلِ",26,"ل",1,0],["نُنَادِي أَبَا جِبْرِيلَ بِاسْمِ وَحِيدِهِ","وَقَدْ كَانَ لاَ يُعْتَاقُ عَنْهُ بِشَاغِل",26,"ل",1,0],["نناجيكَ هذي راية العُربِ فاحمها","فمن حولها أجنادُكَ البُسَلاءُ",27,"ا",2,0],["نندبُ الكاتبَ الذي يرسل القو","لَ قويَّ الأداءِ معنى ومَبنَى",28,"ن",2,0],["ننجز لا نمضي ولا ننثني","لا نحن أيقاظ ولا نوم",29,"م",1,0],["نُنْزِلُ الضَّيْفَ- إذَا مَا حَلَّ في حبَّة ِ القلبِ وألواذِ الحشا","رُبَّ ضَيْفٍ تاجِرٍ أَخسَرتُهُ بعته المطعمَ وابتعتُ الثَّنا",30,"ا",1,0],["نَنُوطُ آمَالَنَا مِنْهُ إلى مَلِكٍ","مُرَدَّدٍ في صَرِيحِ المَجدِ، مَنسُوبِ",31,"ب",1,0],["'نّني كلّما تأمّلت طفلا","خلت أنّي أرى ملاكا سويا",32,"ي",2,0],["ننضّر البؤس عند البائسين منى","والعقل عاطفة والثكل إيمانا",33,"ن",2,0],["ننهمي أمطارا … أو تهوي","أشلاء … أو نمضي فرسان",34,"ن",1,0],["ننجرّ … لا نمضي … ولا ننثني","لا نحن أيقاظ … ولا نوّم",35,"م",1,0],["نناجي البارق النجدي نبكي","وقد يبكي الموله ما يعاني",36,"ن",2,0],["نناجيكمو يا ساكني حلب الشهبا","مناجاة من نيرانه دنت الشهبا",37,"ب",2,1],["ننعي البشاشة والندى وتواضعا","بذَّ العدا ترعى عهود ولاكا",38,"ك",2,0],["ننعي وفاءً في طباعك خلقةً","وتجلداً جُبلت عليه قواكا",38,"ك",2,0],["ننال بأدنى القولِ منك مدَى العلا","ولا عجبٌ أن يُحضر الدُّرُّ بالماسِ",39,"س",1,0],["نُنَعَّمُ في دارِ الرِضا وَنُرَفَّهُ","تَوَجَّه بِهِ لِلَّهِ في كُلِّ أَزمَةٍ",40,"ه",1,0],["نُناجي بِإضمارِ الهَوى ظاهرَ الهَوى","بِأَطيبَ من نجوى الأَماني الكَواذبِ",41,"ب",1,0],["نَنظُر سُلَيمَى فإِن ضَنَّت بنائِلِها","عَنَّا انصَرَفنا وماذا يَنفَعُ النَّظَرُ",42,"ر",1,0],["نناديهم فلا نلقى جوابا","نداء الحر ليس له مجيب",43,"ب",1,0],["ننبينا المجتبى هادي الأنام إلى","دار السلام ودار الخلد والنظر",44,"ر",1,0],["ننشُّدُ الوَصلَ قد يكونُ قريبا","هل على العاشقين ثَمَّ حِساب",45,"ب",1,0],["نُنهِلُ الخطيّ من أعدائنا","ثُمَّ نَفري الهامَ إِن لَم نَفتَرش",46,"ش",1,0],["نَنعِشُ العافي وَمَن لاذَ بِنا","بِسِجالٍ جِئنَ مِن أَيدي نُعُش",46,"ش",1,0],["ننشر الأحلام خمراً","كرمها في شفتينا",47,"ن",2,0],["ننقذ المستجير","ونقيل العثار",48,"ر",1,0],["نناجي الامل الذاوي","وشغلك في الهوى شغلي",49,"ي",1,0],["ننزل بدار السلام","جنات فيها رضا الله",50,"ه",1,0],["ننال بالشافع المقبول","ماليس يخطر بقلب إنسان",51,"ن",1,0],["نُنافِسُ في الدُنيا غُروراً وَإِنَّما","قَصارى غِناها أَن يَؤولَ إِلى الفَقرِ",52,"ر",1,0],["ننظِمُ من أمداحِه جوهراً","نُخرجُه من بحرِه الزاخِرِ",53,"ر",1,0],["ننام مسرورين في غبطة","لم ندر ما عاقبة النائم",54,"م",1,0],["ننازع في ميراثه قبل دفنه","كأنا أمنا قبله موقع الدفن",55,"ن",1,0],["ننازع في ميراثهم قبل دفنهم","كأنا ولم يلحق بنا الموت موتانا",56,"ن",2,0],["نناغي الليالي كلما لاح بارق","سعدنا بمرآه وإن كان خلبا",57,"ب",2,0],["ننسى ولا ننساه في ال","يوم العصيب الحاشر",58,"ر",1,0],["ننسى ولا ننساكما","رغم انقضاء الحقب",59,"ب",1,0],["ننحلُّ في الشوقِ أعمارًا سواسيةً:","نبضُ (الثلاثينَ) في أحشاءِ (خمسينا)!",60,"ن",2,0],["نَنجو سِراعاً كأنَّ البُعدَ غلَّ لنا","أَو اِمتَطينا بِذاك الدَّوِّ ظُلْمانا",61,"ن",2,0],["نَنهَى عن الحُزنِ المُذيبِ قلوبَنا","مثلَ النَّديمِ يَعيبُ شُربَ المُسكِرِ",62,"ر",1,0]]}