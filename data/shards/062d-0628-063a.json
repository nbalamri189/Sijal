{"poems":[[87,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119900","الخفيف"],[4831,"يا لائمي في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208008",""],[5956,"حضارة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182203",""]],"verses":[["حُبٌّ غَرَستَ بِراحَتَيكَ وَلَم يَزَل","يَسقيهِ مِن كِلتا يَدَيكَ غَمامُ",0,"م",1,0],["حب غصن الشباب غض نضير","ورداء النعيم ضاف صقيلُ",1,"ل",1,0],["حبٌّ غزاني صُرتُ منْهُ مُجَرّحا","وِمنَ الهوَى ما قَدْ يُعِلُّ ويُؤْلِمُ",2,"م",1,0],["‏حب غريب حبنا ما مسّهُ","‏ ‏ غش ولا غدر وكان الأمتعا",3,"ع",2,0]]}