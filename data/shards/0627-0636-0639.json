aspx?id=170374",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5408,"أحزان سندسية","https://www.poetsgate.com/ViewPoem.aspx?id=190869",""],[5431,"وأنت انبثاق الضوء أنت شعابه","https://www.poetsgate.com/ViewPoem.aspx?id=197637",""],[5486,"امرأة من حجر","https://www.poetsgate.com/ViewPoem.aspx?id=211189",""],[5549,"هو بغية المتعلمين ومن بغى","https://www.poetsgate.com/ViewPoem.aspx?id=181312",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5691,"رسالة التعليم","https://www.poetsgate.com/ViewPoem.aspx?id=206587",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5784,"بوجهها كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=202317",""],[5802,"أضِعِ الكرَى لتحفُّظِ «الإيضاحِ»","https://www.poetsgate.com/ViewPoem.aspx?id=186771",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5842,"ويحكِ يادمشق .. ! / غسان عبد الفتاح","https://www.poetsgate.com/ViewPoem.aspx?id=174873",""],[5851,"أصداء من جزيرة الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=175285",""],[5851,"جسر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175295",""],[6019,"رمادٌ تدره الرياح","https://www.poetsgate.com/ViewPoem.aspx?id=53048",""],[6198,"خريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79293&r=&rc=67",""],[1583,"الموعد الضائع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73063&r=&rc=20",""],[6236,"مرثية حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81709&r=&rc=17",""],[6299,"أضَعْتُمْ أبي إذْ قال شِقُّ وِسَادِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19682&r=&rc=7",""],[6320,"وَمْضَةُ أَلَم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84352&r=&rc=49",""],[6320,"نَشِيجُ الخِضَمّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83635&r=&rc=16",""]],"verses":[["أَضَعتُ الهَوى حِفظاً لِحَزمي وَإِنَّما","يُصانُ الهَوى في قَلبِ مَن ضاعَ حَزمُهُ",0,"م",2,0],["أَضَعتُم وِداداً لَو رَعَيتُم عُهودَهُ","لَما قامَ بَينَ الأُمَّتَينِ خِصامُ",1,"م",1,0],["أَضَعنَ مَواقتِ الصَلواتِ عَمداً","وَحالَفنَ المَشاعِل والجِرارا",2,"ر",2,0],["أضعافَ ما أهديتنا من منّةٍ","تُهدِي إليكَ ثوابَها عاشورا",3,"ر",2,0],["أضعف الهمّ جسمه فإذا قا","لَ لرجليه بادري كتبت لا",4,"ل",2,0],["أضعْتني فرعيتُ","وخُنتني فوفيتُ",5,"ت",1,0],["أَضَعتَ الَّذي لَستَ تَعتادُهُ","وَما كُنتَ تَعرِفُ ما في يَدَيك",6,"ك",1,0],["أَضَعتَ وُدَّ مُحِبٍّ","مازالَ يَحفَظُ وُدَّك",7,"ك",1,0],["أَضَعتَ العُمرَ خُسراناً","فَبِاللَهِ مَتّى تَربَح",8,"ح",1,0],["أَضَعتُم أَبي قتلاً فَكُنتُم بِثَأرِهِ","عَلى قَومِكُم يا آلَ عَمرِو بن مَرثَدِ",9,"د",1,0],["أَضَعتُم أَبي إذ مالَ شِقُّ وِسادِه","عَلى جَنَفٍ قد ضاعَ مَن لَم يُوَسَّدِ",9,"د",1,0],["أضَعْتُمُ مَجْدَ قَوْمٍ","شادوا الحَياةَ فَخارا",10,"ر",2,0],["أضعتُ بها قلباً صحيحاً فليتَهُ","يُرَدُّ عليَّ اليوم وهو صديعُ",11,"ع",1,0],["أُضعِفَت بَهجَةُ الخِلافَةِ وَاِرتَد","دَ شَبابُ الدُنيا إِلى عُنفُوانِه",12,"ن",2,0],["أَضَعُ الخُدودَ عَلى مَمَرِّ نِعالِكُم","فَكَأَنَّني بِتُرابِها أَتَبَرَّكُ",13,"ك",1,0],["أَضعِف بِمَن أَمسى وَأَصبَحَ أَمرُهُ","تَبَعاً لأِمرِ الدودَةِ الشَعراءِ",14,"ا",2,0],["أضعْتَ حقي لأجلِ ليني","وغيرُ ذا كانَ منكَ أحسنْ",15,"ن",1,1],["أضعفُ مِنْ حجَّةِ الروافضِ في","دعواهمُ أنَّ منهمُ المهدي",16,"ي",1,0],["أَضَعتَ الَّذي قَد كانَ في السِرِّ بَينَنا","وَسِرُّكَ عِنسي كانَ في أَحصَنِ الحِصِن",17,"ن",1,0],["أَضَعْت حُقُوقَهُ وأَضَاعَ حَقِّي","فيالَكِ صُحْبَةً ذَهَبَتْ ضَيَاعَا",18,"ع",2,0],["أَضَعتَ بَينَ الأُلى مَضَوا حُرَقاً","أَم ضاعَ ما اِستَودَعوكَ إِذ بَكَروا",19,"ر",3,1],["أَضَعتُ ما كُنتُ أَفنَيتُ الزَمانِ بِهِ","بَل جَرَّ ما كانَ أَعدائي وَحُرّابي",20,"ب",2,0],["أَضَعتَ شاءً جَعَلتَ الذِئبَ حارِسَهُ","أَما عَلِمتَ بِأَنَّ الذِئبَ حَرّاسُ",21,"س",1,0],["أَضَعْتُ زَمَانِي بَيْنَ قَوْمٍ لَوَ انَّ لِي","بِهِمْ غَيْرَهُمْ مَا أَرْهَقَتْنِي الْبَوائِقُ",22,"ق",1,0],["أَضَعْتُمُوني وَكانَتْ لِي بِكُمْ ثِقَةٌ","مَتَى خَفَرْتُمْ ذِمَامَ الْعَهْدِ يا عَرَبُ",23,"ب",1,0],["أضعتُمْ في الهواء كنوزَ مالٍ","وملءَ الأرض بُؤْسٌ وافتقار",24,"ر",1,0],["أُضْعِفَتْ بَهجَةُ الخِلافةِ، وَارْت","دّ شَبَابُ الدّنْيَا إلى عُنْفُوَانِهْ",25,"ن",2,0],["أضَعْتُ تاريخي ، وأنتِ مثلي","بغير تاريخٍ ولا مصيرِ",26,"ر",1,0],["أَضَعْتَ الَّذي قَدْ كَانَ في السِّرِّ بَيْنَنا،","وَسِرُّكَ عِنْدي كَانَ في أَحْصَنِ الحِصْنِ",27,"ن",1,0],["أضعنا بلا قصد طريقا أضاعنا","ولاح لنا درب بدأناه فانمحى",28,"ح",2,0],["أَضعفتَني الأَهوال عَن كُل شَيءٍ","لَم تَدَع لي لِحَمل ظلي اِقتِدارا",29,"ر",2,0],["أضعف الناس أعظم الناس يدعى","أن يلاحظه لطف طرف انتصارك",30,"ك",1,0],["أضعت شبابي بين حلم وغفلة","وأنفقت عمري في الأماني الكواذب",31,"ب",1,1],["أضعت من حقنا يا دهر ما يجب","مهلا أما لك في أهل النهي أرب",32,"ب",1,1],["أضعت لهم حقا لحفظ حقوقكم","وذلك أمر أوجبته النصائح",33,"ح",1,0],["أضعت ِ دربا ً إلى الأقصى على عمد ٍ","فقادكِ الحقدُ للثاراتِ كالذنب ِ",34,"ب",1,0],["أَضعَفَت مَتنِيَ الخُطوبُ فَأَعدا","ني عَلَيها بِساعِدٍ مُشتَدِّ",35,"د",1,0],["أَضعت العمر لا عمل رَضى","أَفوز به وَلا قَلب سَليم",36,"م",1,0],["أضعت دنياك بهجرانه","إن نلت وصلاً ضاعت الأخرى",37,"ر",2,0],["أَضعَفَ صَبري إِذ بَدَوتَ مُقبِلاً","وَردٌ بِخَدَّيكَ جَنىً مُضَعَّفُ",38,"ف",1,0],["أَضعُها في مكحلَه","للهَزل والخُزَعبَلَه",39,"ه",1,0],["أضعت أنا فضلي وأصبح حافظا","وكيف يضيع الفضل عند أمين",40,"ن",1,0],["أضعف بِمن يهوي هواهُ بهِ إلى","مَهوى غرورٍ وهوَ لا يتمنّعُ",41,"ع",1,0],["أَضَعتُ شَبابي وَمالي سُدىً","عَلى حُبِّ ظَبيٍ بَديعَ الجَمالِ",42,"ل",1,1],["أضعتَ رشدَ الذي يدعو بدعوته ال","أقطارَ وهو لها أُسٌّ وأركان",43,"ن",1,0],["أضعت بذاك الخل در طهارةٍ","ظننت بقوس العهد في وده قزح",44,"ح",1,0],["أضعتَ العُمرَ في إصلاح حالِكْ","ومَا فكّرتَ وَيْحَكَ في مآلِكْ",45,"ك",1,1],["أضعتم وصايا المصطفى وهجرتم","طريقته في نهيه والأوامر",46,"ر",1,0],["أضعتُ لا جهلاً قَراها فغادرَتْ","على سَخَطٍ منِّي المَفارقَ شيبا",47,"ب",2,0],["أضَعْتَ نُصحَكَ فِيمن ليس يسمَعهُ","ولا يَرى في ضَلالاتِ الهوى حَرَجَا",48,"ج",2,0],["أضعتم ملكنا بالمطل","ل والتغرير والبرم",49,"م",1,0],["أضعتم أموراً باعتزالِ محمدٍ","فلمّا مضت قلتم له كيف ترجِعُ",50,"ع",1,0],["اضعف الروعَ قواهم فاغْتدى","عَسلانُ الرمح 