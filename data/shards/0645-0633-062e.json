{"poems":[[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[74,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[53,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[93,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[87,"يا ملكا تعبدا","https://www.aldiwan.net/poem63720.html","مجزوء الرجز"],[46,"ألم تك ريحانة الواصف","https://www.aldiwan.net/poem30021.html","المتقارب"],[106,"مرثية فارس سابق","https://www.aldiwan.net/poem26160.html","عموديه"],[50,"يا عمرو ما للناس قد","https://www.aldiwan.net/poem65271.html","مجزوء الكامل"],[92,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[234,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[275,"قالت أتسخو إذا الكريم سخا","https://www.aldiwan.net/poem35054.html","المنسرح"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[580,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27614","البسيط"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21209","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201732","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200524","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202948","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202849","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204759","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[6070,"سُبْحانَ مَنْ جَمَعَ الضدّينِ في بَدَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=189127",""]],"verses":[["مُسَخِّراً قَوْمَهُ طُرّاً لِخِدْمَتِهِ","وَمَا بَغَى رُبَّ سُوءٍ مَحْضَ إِحْسَانِ",0,"ن",1,0],["مسخَّرةٌ تجري بما ينفع الورى","على يدِه فانظر إلى البحرِ والفلك",1,"ك",1,0],["مسخّرةً تجوب دجى الليالي","بمثل الليل كالفرس الذَّنوبِ",2,"ب",1,0],["مَسَختِ في عَينَيَّ لَونَ النَهار","لَمّا لَمَحتِ اللَيلَ بِالمَرصَدِ",3,"د",1,0],["مُسَخَّراً لِأُمَّةٍ","مِن حَقِّها أَن تَسعَدا",4,"د",2,0],["مُسِختَ وَكُنتَ الطَموحَ الجَمو","حَ في خِلقَةِ الكَلبَةِ الصارِفِ",5,"ف",1,0],["مُسِخَ الفارسُ لصاً قاتلاً","مُسِخَ الفارسُ كَذَّاباً صَفِيقا",6,"ق",2,0],["مُسِخَ النَدى بُخلاً فَما","أَحَدٌ يَجودُ لِذي عَدَم",7,"م",1,0],["مُسَخّرون بما توحي الوحاةُ لهم","كما تُهَزُّ دواليبٌ من الخشب",8,"ب",1,0],["مسخّرة مضطرة في بروجها","تسِير بتدبير الإله على قَدْر",9,"ر",1,0],["مَسَختُ حبِّي للحبِّ محتقراً","إذ كلُّ شيء كالحبِّ قد مُسِخا",10,"خ",2,0],["مُسخَّنةٌ وفاترةٌ تراءت","لنا في الكأسِ ناراً في جَليد",11,"د",1,0],["مَسَخَتْ وفاتُكَ أَدْمُعِي فلَكَم جَرَت","كالدُّرِ وهِيْ اليَوْمَ كالمرْجَان",12,"ن",1,0],["مسخوا النوال فصار بخلا","والوداد فصار ضغنا",13,"ن",2,0],["مسخً الماكسينٍ ضبعاً وذئباً","فلهذا تناجلاَ أمَّ عمرو",14,"ر",2,0],["مسخَ الضبّ في الجدالة قدْماً","وسهيلَ السماءِ عمداً بصغرِ",14,"ر",1,0],["مسخراتٌ بأمرِ الله ليس لها","إلا الشهادةُ والتسبيحُ والذكر",15,"ر",1,0],["مُسخَّرٌ كلُّ من تحت السماء لهُ","لا ينبغي أن يناوي مُلكهُ أحدَ",16,"د",1,0],["مسخن للكليتين ينجي","من البواسير ومن قولنج",17,"ج",1,0],["مُسخَ العالم شيئاً آخراً","فهو عني كل يوم في انزواء",18,"ا",2,0],["مسخ القرد حيث اصبح انساناً","على عكس ما ادّعى القدماء",19,"ا",2,1],["مسخ الناس نفسهم فاستراحوا","قلت لا أستطيع مسخاً لنفسي",20,"ي",1,0],["مسخ الكبار نفوسهم بتصنّعٍ","والشعب من جهلٍ بألف دثار",21,"ر",1,1],["مسخنا اليوم أرواحا وشكلا","تدل بنا على الذوق الغبي",22,"ي",1,0],["مسخ الناس حولهم أحجارا","وسراة الخلود عاشر يومٍ",23,"م",1,0],["مَسَخَتْهم ثقافة مَسَخوها","وأشارتْ لحمقهم بالبَنانِ",24,"ن",1,0],["مسخِّرُ الطيرِ على الهواءِ","وخالقُ الأرضِ مع السماءِ",25,"ا",2,0],["مسخرةٌ اليك بها جيادٌ","موطدة الظهور الى الركوب",26,"ب",1,0],["مُسَخّرُ الكونَ للإنسانِ مِنْ كرمٍ","لِيَعْرِفَ اللَّهَ فِي السَّراءِ والمِحَنِ",27,"ن",1,0]]}