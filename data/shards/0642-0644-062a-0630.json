{"poems":[[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[156,"زائر","https://www.aldiwan.net/poem17106.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66699","الرمل"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49909","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79845","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141254","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135099","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136539",""],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[5055,"شيل السفوح","https://www.poetsgate.com/ViewPoem.aspx?id=108499",""]],"verses":[["قلتُ ذِي غَيْرَةُ الأُبَيْرَةِ أَلَّا","تَشْتَهِي أَنْ تُفَارِقَ الأَبَّارَهْ",0,"ر",2,0],["قُلْتُ: ذَكَّرْتَنِي بِصَاحِبِ مُوسَى","يَا صَدِيقِي، فَزِدْتَ فِيكَ هُيَامِي",1,"م",2,0],["قلت ذمَّ اللهُ ربّي جَمعُكمْ","وبه تَنطِق آيات الزُّبُرْ",2,"ر",1,0],["قلت ذاك الجمال لما تبدى","كثرت دهشتي وقل ثباتي",3,"ت",2,0],["قلتُ ذا الطيبُ من كثيب حماها","حَملته لنا الصَبا في الهُبوبِ",4,"ب",1,0],["قلت ذا أمر طوته الأعصر","حلّةٌ بالية لا تقتنى",5,"ن",2,0],["قلت ذاك الشّعب شعب السّبسب","مزّقت شملهم أيدي الفنا",5,"ن",2,0],["قُلتُ ذا تَابِعٌ عِتَابَهُمُ أن","فُسَهُم خاطِراً وَهُم ما أساءُوا",6,"ا",1,0],["قلت ذاك الجمال لما تدى","وغدا مشرقاً بكل الجهات",7,"ت",1,0],["قلت ذوبي أسىً فقالت فداء","الأوجه البِيض والعُيون السُود",8,"د",1,0],["قلت ذا والله بلاي واشوف وش مدة ...زماني","لايكون اللي كتب لي (فارقه من غير ...زله",9,"ل",2,0],["قلت ذاك الماي من بعد الوضوح","والسراب يباعد أطراف السراب",10,"ب",1,0]]}