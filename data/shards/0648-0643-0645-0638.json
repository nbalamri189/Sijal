{"poems":[[55,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[65,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[47,"ترى الليل يقضي عقبة من هزيعه","https://www.aldiwan.net/poem64683.html","الطويل"],[48,"أبيدة قالت للوعول مسرة","https://www.aldiwan.net/poem22328.html","الطويل"],[48,"أبيدةُ قالت للوعولِ، مُسِرّةً:","https://www.poetsgate.com/ViewPoem.aspx?id=18320",""],[164,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[371,"وكم ظل أو كم بات عندي كتابه","https://www.aldiwan.net/poem17906.html","الطويل"],[435,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[469,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[469,"وكم ظل مدلجاً نحو لذة","https://www.aldiwan.net/poem3338.html","عموديه"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100587","المتقارب"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53767","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122662","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37862","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62528","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96611","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76880","السريع"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113756","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100110","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26971","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105752","الرجز"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141527","المنسرح"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133258","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135433","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94613","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94491","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117216","الطويل"],[5087,"إلا يا جامع البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=96363",""],[5431,"وما زالت الأحياء بالسوط تُقمعُ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=200185",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5595,"سَلاماً أيّها الوطنُ","https://www.poetsgate.com/ViewPoem.aspx?id=144627",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""]],"verses":[["وَكَم ظَهرِ صَعبٍ عادَ بِالذُلِّ يُمتَطى","وَعَرنينِ آبٍ باتَ بِالضَيمِ يُقرَعُ",0,"ع",1,0],["وكمْ ظَمَأٍ تحتَ الضّلوعِ أُجِنُّهُ","إِلى رَشَفاتٍ من وَراءِ لِثامِ",1,"م",1,0],["وكم ظلم الظِّلمانَ حق صحاحِها","ومثلُ خصيم الدهرِ أذعنَ واظَّلمْ",2,"م",1,0],["وَكَم ظَهَرَت بَعدَ اِستِتارِ مَكانِها","شَناةٌ خَباها كاشِحٌ في ضُلوعِهِ",3,"ع",2,0],["وَكَم ظالِمٍ يَتَلَذُّ شَهداً كَأَنَّهُ","ظَليمٌ قَراهُ بِالفَلاةِ هَبيدُ",4,"د",1,0],["وكم ظالمٍ يلتذُّ شهداً، كأنّه","ظليمٌ، قراهُ، بالفلاةِ، هِبيد",5,"د",1,0],["وكم ظهرت في أحمد من مخائل","على مهده والسعد تبدو علائمه",6,"م",2,0],["وَكَم ظَلامِ وَغَىً جَلّى غَياهِبَهُ","مِن بَعدِ أَن صارَ وَقتُ الظُهرِ كَالطَفَلِ",7,"ل",1,0],["وَكَم ظَهرت لهُ آياتُ صدقٍ","تدلُّ عَلى الهُدى مُذ كانَ حَملا",8,"ل",2,0],["وَكم ظنّ غرّ أنّ في الخفضِ همّه","إِلى أَن رآه وَهو يستخفضُ الدأبا",9,"ب",2,0],["وَكَم ظَلَّ أَو كَم باتَ عِندي كِتابُهُ","سَميرَ ضَميرٍ أَو جَنانَ جَنانِ",10,"ن",1,1],["وكم ظفرنا بنيل من مواهبه","جودا وكم برزت آثاره فينا",11,"ن",2,0],["وكم ظَلَّلَتْ من حَريرِ الهجيرِ","وكم أنْزَلَتْ من طريدِ العِشاءِ",12,"ا",2,0],["وكم ظنَّ لي صبراً وليست حقيقةٌ","وهبتُ لعيتيهِ الحقيقةَ والظنّا",13,"ن",2,0],["وكم ظلَّ مدلجاً نحو لذَّةٍ","وليل الأسى وحفُ الهيادب داجِ",14,"ج",1,1],["وَكَم ظَفر الأقوامُ في البيض كالدُّمى","بفُوفِ المنى منهنَّ لا بثيابِ",15,"ب",1,0],["وكم ظبيات بها قد رعت","بقيصوم قلبي غدت سارحه",16,"ح",2,0],["وكم ظفرت بمن أهوى فيقنعني","منه الفكاهة والتعليل والنظرُ",17,"ر",1,0],["وَكَم ظَلِلتُ أنادي الرَّبعَ بَعدَهُمُ","يا رَبعُ أهلُكَ بَعدَ البَينِ ما صَنَعُوا",18,"ع",3,0],["وَكَم ظَبيٍ حَكى حَسناً","وَلَكِن فاتَهُ الشّنَبُ",19,"ب",1,0],["وكم ظهرت منه محاسنُ جمّةٌ","فما ينتهي بالفضل إلا ويبتدي",20,"د",2,0],["وَكم ظاعنٍ في الظاعنينَ مقوّض","من الربعِ في سوداءِ قلبي مطنبِ",21,"ب",1,0],["وكم ظلمت ولم ترحم نواح اخ","على اخيه وكم يتمت ولدانا",22,"ن",2,0],["وَكَمْ ظَلْتُ فِيهَا أَنَا وَالنَّسِيمُ","غَدَاةَ التَّفَرُّقِ نَشْكُو ضِرَارَا",23,"ر",2,0],["وكم ظهرت من قبل إبان بعثه","إمارات خير للورى ومخايل",24,"ل",1,0],["وكم ظهرت له من معجزات","يصدقها تدبر آبهنه",25,"ن",2,0],["وَكَم ظَلام بِتُّهُ ساهِرا","يَرقب طَرفي للتّقى فجرَه",26,"ر",2,0],["وكم ظهرت في حَملِهِ من بَشائرِ","وكم من كراماتِ الولادةِ والوَضع",27,"ع",1,0],["وكم ظهرت من معجزات عظيمةٍ","على يدهِ جلَّت عن الحصرِ والجمعِ",27,"ع",1,0],["وكم ظلَّلتهُ في الفيافي غَمامةٌ","وحامت أمام الغارِ وُرقِيَّةُ السَجعِ",27,"ع",1,0],["وَكم ظالمٍ يُندي من العَضِّ كَفَّهُ","مَقالتَهُ يا وَيلَتَي أَينَ أَذهَبُ",28,"ب",1,0],["وكم ظفرت كفى هناك بسيد","ولوع بإكرام الخليط المعاشر",29,"ر",1,0],["وَكَم ظاعِنٍ قَد ظَنَّ أَن لَيسَ آيِباً","فَآبَ وَأَودى حاضِرونَ كَثيرُ",30,"ر",1,1],["وكم ظِباء رُعتُها أَلحاظُها","أسرعُ في الأنفس من حدِّ الظُبا",31,"ا",1,0],["وكم ظلومٍ تزولُ دولتُهُ","وليسَ ما سنَّ من أذى زائلُ",32,"ل",1,1],["وكم ظهرت في الكون للوضع ىية","فسارت مسار البدر تعلو منازله",33,"ل",2,0],["وكم ظلوم غشوم عاتهٍ مردٍ","قصمته بسيوف القهر تحتاده",34,"د",2,0],["وَكَم ظلَّ في اللَيل البَهيم على السُرى","يُحرّك مهمازاً وتسري ركائبُه",35,"ب",2,0],["وكم ظلَّ فيهِ السمع يصغي تشفُّعاً","وكم أسكر المنطيق في طيبة الذكرِ",36,"ر",1,0],["وكَم ظريفِ لَطيفٍ لامعٍ بسنى","لم تغش أنوارَهُ بالكون أستارُ",37,"ر",1,0],["وكم ظلت ابغي الوصل والدهر قد بغى","بتبديلهِ وصلي بتهصير أوصالي",38,"ل",2,0],["وكم ظامىء قد رام يروى بريها","فآب وقد أضحى عليل أوامها",39,"م",3,0],["وكم ظبي من الأنس","مليح فيك مرعاه",40,"ا",2,0],["وكم ظامئٍ والنبعُ منه قريبةٌ","ولكنها الرؤيا من الضيقِ بلقعُ",41,"ع",1,0],["وكم ظلت تؤرشفه انتهاكا","وما رضيت حشاشتها سواكا ....",42,"ك",2,0],["وكم ظن أن يسعى رفيقاً إلى الحمى","ليحظى فأضحى سعيه وهو مخفق",43,"ق",1,0],["وكمْ ظلمٍ طواهُ الحرُّ يأبى","خنوعاً أنْ تمزقّه الجروحُ",44,"ح",1,0],["وَكَمْ ظَمَأٍ وَجُوعٍ لَوْ","لِجُمْلٍ مَا لَهَا صَبْرُ!",45,"ر",1,0]]}