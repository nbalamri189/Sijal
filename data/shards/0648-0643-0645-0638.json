{"poems":[[53,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[45,"ترى الليل يقضي عقبة من هزيعه","https://www.aldiwan.net/poem64683.html","الطويل"],[46,"أبيدة قالت للوعول مسرة","https://www.aldiwan.net/poem22328.html","الطويل"],[46,"أبيدةُ قالت للوعولِ، مُسِرّةً:","https://www.poetsgate.com/ViewPoem.aspx?id=18320",""],[161,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[170,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[190,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[367,"وكم ظل أو كم بات عندي كتابه","https://www.aldiwan.net/poem17906.html","الطويل"],[430,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[465,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[465,"وكم ظل مدلجاً نحو لذة","https://www.aldiwan.net/poem3338.html","عموديه"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"]],"verses":[["وَكَم ظَهرِ صَعبٍ عادَ بِالذُلِّ يُمتَطى","وَعَرنينِ آبٍ باتَ بِالضَيمِ يُقرَعُ",0,"ع",1,0],["وكمْ ظَمَأٍ تحتَ الضّلوعِ أُجِنُّهُ","إِلى رَشَفاتٍ من وَراءِ لِثامِ",1,"م",1,0],["وكم ظلم الظِّلمانَ حق صحاحِها","ومثلُ خصيم الدهرِ أذعنَ واظَّلمْ",2,"م",1,0],["وَكَم ظَهَرَت بَعدَ اِستِتارِ مَكانِها","شَناةٌ خَباها كاشِحٌ في ضُلوعِهِ",3,"ع",2,0],["وَكَم ظالِمٍ يَتَلَذُّ شَهداً كَأَنَّهُ","ظَليمٌ قَراهُ بِالفَلاةِ هَبيدُ",4,"د",1,0],["وكم ظالمٍ يلتذُّ شهداً، كأنّه","ظليمٌ، قراهُ، بالفلاةِ، هِبيد",5,"د",1,0],["وكم ظهرت في أحمد من مخائل","على مهده والسعد تبدو علائمه",6,"م",2,0],["وَكَم ظَلامِ وَغَىً جَلّى غَياهِبَهُ","مِن بَعدِ أَن صارَ وَقتُ الظُهرِ كَالطَفَلِ",7,"ل",1,0],["وَكَم ظَهرت لهُ آياتُ صدقٍ","تدلُّ عَلى الهُدى مُذ كانَ حَملا",8,"ل",2,0],["وَكم ظنّ غرّ أنّ في الخفضِ همّه","إِلى أَن رآه وَهو يستخفضُ الدأبا",9,"ب",2,0],["وَكَم ظَلَّ أَو كَم باتَ عِندي كِتابُهُ","سَميرَ ضَميرٍ أَو جَنانَ جَنانِ",10,"ن",1,1],["وكم ظفرنا بنيل من مواهبه","جودا وكم برزت آثاره فينا",11,"ن",2,0],["وكم ظَلَّلَتْ من حَريرِ الهجيرِ","وكم أنْزَلَتْ من طريدِ العِشاءِ",12,"ا",2,0],["وكم ظنَّ لي صبراً وليست حقيقةٌ","وهبتُ لعيتيهِ الحقيقةَ والظنّا",13,"ن",2,0],["وكم ظلَّ مدلجاً نحو لذَّةٍ","وليل الأسى وحفُ الهيادب داجِ",14,"ج",1,1],["وَكَم ظَفر الأقوامُ في البيض كالدُّمى","بفُوفِ المنى منهنَّ لا بثيابِ",15,"ب",1,0]]}