5493,"مَظْلَمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=199530",""],[5493,"ويحَ الصدود","https://www.poetsgate.com/ViewPoem.aspx?id=199747",""],[5493,"غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=206893",""],[5510,"بين الخطوبة والزواج","https://www.poetsgate.com/ViewPoem.aspx?id=206242",""],[5561,"ألقت معاذيرها ...","https://www.poetsgate.com/ViewPoem.aspx?id=194433",""],[5606,"سعيد وسعيده","https://www.poetsgate.com/ViewPoem.aspx?id=198393",""],[5672,"ما لم يقله رؤبة بن العجاج","https://www.poetsgate.com/ViewPoem.aspx?id=213612",""],[5677,"مجرد رأي","https://www.poetsgate.com/ViewPoem.aspx?id=179850",""],[5688,"تنصحني لأنسى ولكن...","https://www.poetsgate.com/ViewPoem.aspx?id=201026",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5784,"من وحي الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=202425",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5848,"فواتير الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=53370",""],[5887,"يا طائر الدوح","https://www.poetsgate.com/ViewPoem.aspx?id=35290",""],[5906,"في الحكمة / الصدق / عنوان الكرامة","https://www.poetsgate.com/ViewPoem.aspx?id=187981",""],[5906,"أختاه","https://www.poetsgate.com/ViewPoem.aspx?id=188222",""],[6089,"في شفتي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213031",""],[6159,"سبورة الفوضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85855&r=&rc=1",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""],[6256,"ضاعت حقيبتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65917&r=&rc=5",""]],"verses":[["لَكِنَّ في أَكتافِهِم وَظُهورِهِم","فَبِذاكَ فَاِفخَر بِئسَ ذاكَ المَفخَرُ",0,"ر",1,0],["لَكِنَّ فَاضِلَ كُتَّابِ الشُّرُوُطِ بِهَا","يَحْيَ أَبَرَّ فَتَىً لِلْفَضْلِ مُشْتَرِطٍ",1,"ط",1,0],["لَكِنَّ فِي مُهْجَاتنَا أَسْمَاءهُمْ","تَجْرِي بِهَا ذِكْرَاهُمُ مَجْرَى الدَّمِ",2,"م",1,0],["لَكِنَّ في الناسِ مَغروراً بِنِعمَتِهِ","ما جائَهُ اليَأسُ حَتّى جائَهُ الأَجَلُ",3,"ل",1,0],["لكن فعلتَ كآباءٍ لكم فُعُلٍ","بِيضِ الصنائع كشَّافين للكُربِ",4,"ب",1,0],["لكنّ في الشيخ عُزَيريةً","قد تركَتْهُ شَرساً مشغبا",5,"ب",2,0],["لَكنَّ في اليأس لي عَفْواً وعافية","واليأْسُ رفْدٌ لِعافٍ غَيْرُ مَرْفودِ",6,"د",1,0],["لك نفسٌ وطينةٌ لا تُذمَّا","نِ فشبِّه بجوهرَيْكَ الفعالا",7,"ل",2,0],["لكنَّ فضلَ اللَّهِ غيرُ مُحرَّمٍ","إذ عاقَ فضل مُبخَّلٍ تحريمُ",8,"م",1,0],["لَكِنَّ فَرطَ الهِيامِ أَسكَرَنا","وَقَبلَنا العاشِقونَ كَم سَكَروا",9,"ر",3,0],["لكن في الفجر الحيا","ة وفي الضحى لهما الممات",10,"ت",1,0],["لَكِ نَفْسٌ مُواتِيَهْ","والمنايا مُعَادِيَهْ",11,"ه",1,1],["لَكَ نَفسٌ أَمّارَةٌ لَكَ بِالخَي","رِ وَكَفٌّ بِالمَكرُماتِ نَدِيَّه",12,"ي",2,0],["لكن فنَّ الشعر وردُ أحبة","يُهدى فهاك قصيدتي بل وردتي",13,"ي",1,0],["لَكِنَّ في قَلبي إِذا صَدَّ الرَشا","عَنّي أَسىً يَعتادُني وَغَليلا",14,"ل",2,0],["لَكِنَّ في الحُبِّ أَسقاماً مُنَهَّلَةً","لِذي الحَلاوَةِ حَتّى يَجهَدَ الكَبِدا",15,"د",2,0],["لَكَ نَفْسٌ كَأَنَّهَا كُلُّ نَفْسٍ","وَكأَنَّ الخَفَاءَ عِنْدَكَ جَهْرُ",16,"ر",1,0],["لكنّ في يده البرا","عَةَ والكتاب هم السلاح",17,"ح",1,0],["لكنّ في صّدري دجى الموتى وأحزان البيوت","ونشيجّ أيتام … بلا مأوى … بلا ماء وقوت",18,"ت",1,0],["لكن في مقولي أباءً","والناس أخلاقهم شكول",19,"ل",1,0],["لكن في أغواره درراً","ولآلئاً أبقى من الزمن",20,"ن",1,0],["لكن فقدك يا فؤاد وإن يكن","أَجل دنا سيظل شر فواجعي",21,"ع",2,0],["لكن فيها للأنام منافعاً","قد تجمع الشملين بعد شتات",22,"ت",1,0],["لكنّ فضلك فيها قَد أناب لنا","أزكى المعارف بنياناً وتذكارا",23,"ر",2,0],["لَكِنَّ فقدانَ مَن أَضحى بِمَصرَعِهِ","نورُ الهُدى وَبهاءُ العِلمِ مَسلوبا",24,"ب",2,0],["لَكِنَّ فينا عِندَ كُلِّ مُصيبَةٍ","تَستَوكِفُ العَبَراتِ صَبرُ كِرامِ",25,"م",1,0],["لكنَّ فِرعَونَ إن نادى بها جَبَلاً","لَبَّت حجارتُه في قَبضَةِ الباني",26,"ن",2,0],["لكن فضلت عليه أنك دائماً","تبقى وهذا اليوم تابع أمسه",27,"س",2,0],["لكنَّ في الكونِ أسراراً تُسيِّرُنا","وقد خُلِقنا لتأويبٍ وإدلاج",28,"ج",1,0],["لكن في تصحيفه ما صدّني","وقضى لجسمي فيه بالتسكين",29,"ن",1,0],["لَكنّ فضلِ اللّه خيرٌ لها","وَللّذي خلّفهُ فقدُها",30,"د",3,0],["لَكِن في اللَهِ ظَنّي عِقدُهُ حُسنُ","وَعُمدَةَ المَرءِ في الأَعمالِ نِيَّتُهُ",31,"ت",2,0],["لَك نَفسي الفداء لَو كانَ يُفدى","سيد غاب في الثَرى وَتَوارى",32,"ر",2,0],["لكنَّ في حَيني وفي شِقوتي","ما يَجعلُ الأعداءَ خُلانا",33,"ن",2,0],["لكنَّ في جُود ابنِ يَحيَى نهلة الص","صَادي وفيه ثَروةٌ للمُقتِرِ",34,"ر",1,0],["لكن في أخلاقهِ الفِطريَّه","معرفةُ المقدور حسن النَّيَه",35,"ه",1,0],["لكنَّ فيه فسحةً قد تُقبَل","عن الإمامِ الشافعي تُنقَل",35,"ل",1,0],["لكن فقدنا من نقدنا به","ومن يرينا منه سبل الرشاد",36,"د",1,0],["لكنَّ فِعلَك فيهم جاءَ مُبتَدَعا","ألقَيتَهم في يدِ الإفرنج مُتَّبِعا",37,"ع",2,0],["لكنْ فراقُكَ آسانِي وآسَفَنِي","ففي الجوانحِ نارٌ منه تَضطرمُ",38,"م",1,0],["لك نفسٌ لم تمتها غايةٌ","في المعالي أعجزَ الناس مطاها",39,"ا",3,0],["لَكِنْ فُلانٌ تَرِبَتْ كَفُّهُ","لِلسُّنّةِ الْغَرّاءِ أَبْدَى الْجَفا",40,"ف",2,0],["لكِنَّ في ساكِنِيهِ لُؤماً","نَفَّرَني عَنْ رُبا رُبوعِهْ",41,"ع",2,0],["لَكَ نَفسُ الأَملاكِ في عِزَّةِ الأَف","لاكِ في جودٍ مَن يَداهُ الغَمامُ",42,"م",1,0],["لكن فكن مستبصراً","إن كنت من أهل النظر",43,"ر",1,0],["لَكِنَّ فيهِ مُهنّداً ما اِستَلَّهُ","إِلّا وَمِن عشّاقِهِ أَجرى الدّما",44,"م",2,0],["لَكِن فناءُ الخَلقِ حُكمٌ نافِذٌ","لَم يَنجُ مِنه كَبيرُنا وَصَغيرُ",45,"ر",1,0],["لكن في بيتي عروج أحمد","شط عن القصد فوافي الكذبا",46,"ب",2,0],["لكن في غلبات حكم الوجد ما","لا يستطاع وكم عليه مراصد",47,"د",1,0],["لَكن في الأنس عُيوباً أُخرى","وَأَنتُم مني بِذاكَ أَدرى",48,"ر",2,0],["لَكِن فُؤادي لَم يَمِل وَما صَبا","وَلَو أشاءُ ضَمَّ قُطرَيهِ الصِّبَى",49,"ب",2,0],["لكنَّ في عيني قذًى","من نورِ شيبٍ سابتِ",50,"ت",1,0],["لك نفسٌ قدسيَّةُ الذات فيها","حزتَ أعلى مراتب العرفان",51,"ن",1,0],["لك نفسٌ قدسيَّةٌ قد تمحَّض","ت بها للإله سرًّا وجهرا",52,"ر",2,0],["لكنَّ في روض الشفاعة دوحةً","قدسية رفّت بها الأغصان",53,"ن",1,0],["لكنَّ في العلوة كل أنكد","يدعى بحمال وهم بمحشد",54,"د",1,0],["لكنّ في عزمات الصبر مُتّسعاً","لقلب صبّ تمادى ضَيّقاً حَرجا",55,"ج",2,0],["لكن فديتكَ من غزالٍ أكحلِ","وقف الهوى بي حيثُ أنتَ فليس لي",56,"ي",1,0],["لكنّ في اسناده نظرا ففي","ه راويان وما هما ثبتان",57,"ن",1,0],["لك نَفسي ايُّها الساقي فدى","وَلجفنيك اذا ما هو ما",58,"م",2,1],["لكن فطرت حشا بالود قد فطرت","لما جعلت أهيل الود لي فرطا",59,"ط",2,1],["لَكَ نَفسي الفِداء يا حامل ال","كاس أَرقها فإِن كاسي اللثات",60,"ت",1,0],["لك نفس من المكارم صيغت","فلهذا عزت على النظراء",61,"ا",2,0],["لَكِنَّ في جَاهِ آصبَعٍ وَنِصفِ","ذِرَاعَ كَالهِيرابِ خُذ مِن وَصفيَ",62,"ي",1,0],["لَكَنّ فيها سِلاحاً","تخاف مِنها الفَوارِس",63,"س",1,0],["لكن في بلغاريا ضحكةً","تبكي من التضليل لم يغره",64,"ر",2,0],["لكن في ذلك السلام عِتاب","فاق لطفاً وراق قدحاً وهجداً",65,"د",2,0],["لك نفسي أيها ال","جاني فخذ جهد المقلِّ",66,"ل",1,0],["لَكنّ في النّاسِ أَشباحاً يُلازِمُها","عقمُ القِسيّ الَّتي ما شَدَّها وَتَرُ",67,"ر",1,0],["لكن فيه حرمةً مدفونةً","هي حرمة المدفون بين رحابه",68,"ب",2,0],["لكِن فما الحيلَةُ ما التدبيرُ","وما لَهُ عونٌ ولا نَصيرُ",69,"ر",1,0],["لكنّ في قصري وراء البدور","باقٍ إِلى يَومِ النشور اللُّباب",70,"ب",1,0],["لك نَفس برّ نكّبت","بك عَن طَريق المأثمِ",71,"م",1,0],["لَكن فَضلك رَبي لَستُ أَذكرُه","إِلا وَآبت لي الآمال بِالظفر",72,"ر",1,0],["لكنّ فيها ملكاً مكمّلا","يوحي لنا الحسن كما تنزلا",73,"ل",2,0],["لَكِن فَلى عَذوولي مَنَقَذُ","مَن ذَلَّ بَحرُ العِشقِ وَالاِفتِتانِ",74,"ن",1,0],["لك نفسي تشتاق ما سرت ليلا","تتجلى لها بحسن باهر",75,"ر",1,0],["لكن فيه كآبة","دلّت على أمر خطير",76,"ر",1,0],["لكن فغبْ عنها وعنك لتسلكا","ليسَ العجبْ ممن هلكْ بل مَنْ سَلَكْ",77,"ك",1,0],["لكن فضل محمد","فوق الجميع بلا ريا",78,"ي",2,0],["لكن فوليفيت لما ألقى","بها على الجميع حاز السبقا",79,"ق",2,0],["لكن فيبوس انبرى على الأثر","وفي مثال ابن إفيتوس ظهر",80,"ر",1,0],["لكن فيبوساً أثار له","أنياس يعصم بأس معصمه",81,"ه",1,0],["لكن فوسيذاً بأسرته","في الحال صاح ينيله المددا",81,"د",2,0],["لكن فيبوساً بقدورته","وولائه هكطوراً افتقدا",81,"د",2,0],["لكن فؤادي جملةً ينخلع","لهاجسي بالشلو إن الذباب",82,"ب",1,0],["لكن في بغداد مذ شاع ذا","حازت أهالي البغي أحزانا",83,"ن",2,0],["لكنَّ في مدح الهمام نرى الورى","قد اجمعوا من حيث ليس معاند",84,"د",1,0],["لكنَّ في وصفها فالناس قاطبةً","قد اجمعوا بالثنا حمداً وإشكارا",85,"ر",2,0],["لكن فضلك مرجو ليوسعها","حسن القبول على العلات والنقم",86,"م",1,0],["لَكنَّ فَضلَ اللَهِ في مُرادِه","يُؤتيهِ مَن يَشاءُ مِن عِبادِه",87,"ه",1,0],["لكنَّ فيها من عمان سادة","ورئيس صِدْقٍ خصمُهُ فَرَّارُ",88,"ر",1,0],["لكنّ فجرك جاء من رحم الدجى","ونهضت عملاقاً تُرى فتهابُ",89,"ب",1,0],["لكنّ في السهرة تزول الخلافآت","مثل البقر والضان متخآلطينآ",90,"ن",2,0],["لكنَّ فِي يَدِهِ قِرَى أُمَمٍ","دُونَ المَلامِ, وفَوقَ مَن رَجَّى",91,"ج",2,0],["لكن فكري بعد الكد أخرج من","معناهما ما به جلت معانينا",92,"ن",2,0],["لَكِنَّ فُرْسَاْنَ الْجِهَاْدِ تَوَاْفَدُوْا","نَحْوَ الْعِرَاْقِ، فَخَاْفَهُمْ أَوْغَاْدُهُ",93,"د",2,0],["لَكِنَّ فِي الْحُبِّ إِحْيَاْءً لأَنْفُسِنَاْ","وَفِي الْمَحَبَّةِº إِشْفَاْءً مِنَ الْكَمَدِ",94,"د",1,0],["لكنّ فرحة هذا القلب تكتبها","صِلاتُ عيدٍ لنا من غابر الأزل",95,"ل",1,0],["لكنّ في أحمد المختار قد قصرت","أشعار كل الورى فضلًا عن الخطبِ",96,"ب",1,0],["لكِنْ فقَدْ رحَلَتْ بِلا أمَلٍ","لي في الْوِداعِ فكَيفَ بِالعسَلِ",97,"ل",1,0],["لكنْ فاتنتي ذا شعري","سيذوبُ بأنهرهِ الحجرُ",98,"ر",1,0],["لَكِنَّ فِي تَغْرِيِدِهِ الْرَّامِي غَدَا","يَحْدُو بِأَسْيَافٍ كَفُرْسَانٍ عَدَا",99,"د",2,0],["لكن فراق مهذب ال","أخلاق هين الطبع لين",100,"ن",1,0],["لكن في المجمع العلمي لي أملا","والله أن يجمع الفرقان مأمول",101,"ل",1,0],["لكن فيها ماستوا صقر وغراب","لن الصقور اوكارها باعل الجبل",102,"ل",1,0],["لكِنَّ فَاكِ وناظِرَيْكِ أَرَيْنَنِي","شَيْطانَ حُسْنٍ ثَمَّ ليْس بَرِيئا",103,"ا",2,0],["لكنّ فؤادي تأسرُه","أنغامُ الحبِّ وتسعدُه",104,"د",2,0],["لكنَّ في عينِ النفاقِ بقيةً","من فُرقةٍ وتمزقِ الأعلامِ",105,"م",1,0],["لكنَّ في الشعرِ خيباتٍ تلاحقهُ","تطفو بساحتهِ منْ شطحةِ العدمِ",106,"م",1,0],["لكنَّ في عينِ الكرى غابَ الهوَى","يمضِي بعيدًا والنوَى يَستقطبُ",107,"ب",1,0],["لكِنَّ فِي كَفِّ الوَفاءِ حِكايَةً","لَا غَدْرَ بَينَ سُطُورِهَا كيْ يُكتَبَا",108,"ب",2,0],["لكنَّ في هذي الأمور منازلا","من بعدها تتغيّرُ الأحو