ps://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4279,"","https://poetry.dctabudhabi.ae/diwan/poem/101972","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83185","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58080","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58065","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58037","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72382","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120231","الطويل"],[4714,"أَلا خل عَيْنَيْك اللجوجين تدمعا","https://www.poetsgate.com/ViewPoem.aspx?id=189677",""],[4915,"أَرضي غروري","https://www.poetsgate.com/ViewPoem.aspx?id=212677",""],[5038,"عراقيّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=195224",""],[3591,"إذا ما أنشدت أهلي دمائي","https://www.poetsgate.com/ViewPoem.aspx?id=149383",""],[5246,"إذا ندب الورقُ المغرد إلفَه","https://www.poetsgate.com/ViewPoem.aspx?id=187078",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5277,"عصفورةُ الشّجن","https://www.poetsgate.com/ViewPoem.aspx?id=214550",""],[5320,"مجلة","https://www.poetsgate.com/ViewPoem.aspx?id=42043",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5409,"أمحتضن الوادي حضانة مرضعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155273",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5616,"جرح وتعديل","https://www.poetsgate.com/ViewPoem.aspx?id=203229",""],[5804,"وسائلةٍ عنّي","https://www.poetsgate.com/ViewPoem.aspx?id=214751",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5818,"تعلّمت أنّ الأمور الكبيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=193177",""],[5956,"لأنفعَ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=194886",""],[6003,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=201019",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""]],"verses":[["وَلَيسَ عَلى زُهرِ الكَواكِبِ سُبَّةٌ","إِذا غَضَّ مِن أَنوارِها زِبرِقانُها",0,"ن",3,0],["وَلَيسَ عَجيباً إِن طَغى فيكَ مِقوَلٌ","رَآكَ حَقيقاً في المَعالي فَجَوَّدا",1,"د",2,0],["وَلَيسَ عَجيباً إِن تَخَمَّطَ بازِلٌ","سَرَت فيهِ أَعراقُ القُرومِ المَصاعِبِ",2,"ب",1,0],["وَلَيسَ عَلى ناري حِجابٌ يَكُنُّه","لِمُستَوبِصٍ لَيلاً وَلَكِن أُنيرُها",3,"ر",3,0],["وليس عِذاراً ما أرى غير أنَّه","لماءِ حياةِ الرِّيق أقبل خضره",4,"ر",2,0],["ولي سعاد شجونٍ ما يعبّ لها","إمَّا خيالٌ وإلاَّ فهو تخييل",5,"ل",1,0],["وليس عجيباً ذاك منهُ فإنهُ","إذا غمر الماءُ الحجارةَ تَصلبُ",6,"ب",1,0],["وليس على صريعِ اللَّه عَتْبٌ","وفيه عن محارمه نُكُوبُ",7,"ب",1,0],["وليس عجيباً أن ينوبَ تكرُّمٌ","غذيتُ به عن آمِلٍ لك غائبِ",8,"ب",1,0],["وليس عيشي وإن دامت غَضَارتُهُ","عَليَّ بعد أخي النَّائي بمحمودِ",9,"د",1,0],["وليس على يدٍ بقرار أمنٍ","ولا ليدٍ بثروتها كفيل",10,"ل",1,0],["وليس على مال الخليفةِ محملٌ","لبُطلٍ وفيه للحقائق محملُ",11,"ل",1,0],["وَلَيسَ عِندَكَ في أَمرٍ تُحاوِلُهُ","وَالحَمدُ لِلَّهِ لا عَجزٌ وَلا كَسَلُ",12,"ل",1,0],["وَلَيسَ عَجيباً بِأَن","يُرى الظَبيُ مُستَوحِشا",13,"ش",2,0],["وَلَيسَ عَدُوّاً كُنتَ تَسعى لِأَجلِهِ","وَلَكِنَّها سُبلُ الحَجيجِ تُجيرُها",14,"ر",3,0],["وليس على ضيم يقيم سوى الذي","اذا ناله ضيم فلا يتألم",15,"م",1,0],["وَلَيسَ عَجيباً أَن يَموتَ أَخو الصِبا","وَلَكِن عَجيبٌ عَيشُهُ عيشَةَ السالي",16,"ل",2,0],["وليس علينا ملام وقد","لقيناهمُ بمعاذيرِنا",17,"ن",2,0],["وليس على البحر الذي راح زاخرا","ملام إذا لم ترو ورادها القلب",18,"ب",1,0],["وَلَيسَ عَلى مِثلِ صَرفِ الزَما","نِ يَبقى أَميرٌ وَلا إِمرَه",19,"ر",2,0],["وَلَيسَ عَلى عَبدٍ تَقِيٍّ نَقيصَةٌ","إِذا صَحَّحَ التَقوى وَإِن حاكَ أَو حَجَم",20,"م",1,0],["وَلَيسَ عَجيباً إِن طَغَت أَعيُنُ الحِمى","وَقَد أَكسَبَتها الجودَ أَنمُلُكَ العَشرُ",21,"ر",1,1],["وَلَيسَ عَجيباً أَن غُرِرتُ بِنَظرَةٍ","إِلَيها فَمِن شَأنِ البُدورِ غُرورُها",22,"ر",3,0],["وَلَيْسَ عُلُوُّ النَّفْسِ بِالْجَدِّ وَحْدَهُ","وَلَيْسَ كَمَالُ الْمَرْءِ فِي شَرَفِ الْمَأْوَى",23,"و",2,0],["وَلَيسَ عَلَيهِ شَيءٌ غَيرَ هَذا","كَذاكَ يُميتُ بِالخَوفِ الفُراقُ",24,"ق",1,0],["وَلَيسَ عِندِيَ مِن آلَةِ","السُرى غَيرُ قِربَه",25,"ب",2,0],["وَلَيسَ عُكوفُهُنَّ عَلى المُصَلّى","أَماناً مِن غِوارٍ مُجرَماتِ",26,"ت",1,0],["وَلَيسَ عِندَهُمُ دينٌ وَلا نُسُكٌ","فَلا تَغِرَّكَ أَيدٍ تَحمِلُ السُبَحا",27,"ح",2,0],["وَلَيسَ عَلى الحَقائِقِ كُلُّ قَولي","وَلَكِن فيهِ أَصنافُ المَجازِ",28,"ز",1,0],["وَلَيسَ عَلَيَّ غَيرُ بُلوغُ جُهدي","وَضَيفي قانِعٌ مِنّي بِضَفِّ",29,"ف",1,0],["وليس على ليل قد اسودَّ فحمه","ملام ولكنَّ الملام على الساري",30,"ر",2,0],["ولَيْسَ عَجِيباً أَن تدانَتْ منيّتي","يُصَدقُ فيها أَولي أَمْر آخِري",31,"ر",2,0],["وَلَيسَ عَن حَوضِهِ المَورود مِن صَدرٍ","كَبا الفَوارِسُ في الميدانِ أَو جالوا",32,"ل",3,0],["وَلَيسَ عَلى ناري حِجابٌ يَكُنُّها","لِمُستَوبِصٍ لَيلاً وَلَكِن أُنيرُها",33,"ر",3,0],["وليس عجيبا أن تغص عقيلة","بأخرى وتشكو بالضرار الضرائر",34,"ر",1,0],["وليس عدانا وراء الحدود","ولكن عدانا وراء الضلوع",35,"ع",1,0],["وليس عليه ما تكاملَ زيُّه","إذا عَرِىَ الخَلْقُ الكثيرُ وجاعا",36,"ع",2,0],["وليس عكوفُهنّ، على المصلّى،","أماناً عن غوارٍ مُجرمات",37,"ت",1,0],["وليس على صريعِ اللَّهِ بأسٌ","إذا مَهَدَتْ مصارعَها الجُنُوبُ",38,"ب",1,0],["وليس على نَقيذ اللَّه عَتْبٌ","وفيه عن محارمه نُكُوبُ",38,"ب",1,0],["وليس عندي سوى سير الخيال بهم","كما مضى العهد في سهل واجبال",39,"ل",1,0],["وليس عليكمْ مِن عُميْرٍ وعامِرٍ","إذا ما عدلتم في البريْةِ نامُوا",40,"م",3,0],["وليس عثمان الذي","أقصده في المحفلِ",41,"ل",1,0],["وليسعدوا بالطالع المزدهي","وليزدهوا بالمسعد المستجيب",42,"ب",1,0],["وليس عندي سواك من ار","تجيه في ذي وفي المآت",43,"ت",1,0],["وليس عندك ما عندي بما وصفوا","ما بعد ما قيل هذا عنه مصطبرُ",44,"ر",1,0],["وَلَيسَ عَسى أَو رُبَّما أَو لَعَلَّما","وَيا طالَما إِلّا قُيودَ المَعاطِبِ",45,"ب",1,0],["وَلَيسَ عَجيباً أَن يُحَقَّرَ عالِمٌ","لَدى ضِدِّهِ أَو أَن يُوَقَّرَ جاهِلُ",46,"ل",1,0],["وَلَيسَ عُقوقاً مِنهُمُ بَل تَعالِياً","إِلى خَيرِ غاياتٍ وَأَشرَفِ بُنيانِ",47,"ن",1,0],["وَلَيسَ عَلَينَا أَن تَبينَ بِكِ النَّوى","فَتَنأَي ولاَ مِن أَن تَموتَ النّمائِمُ",48,"م",1,0],["وليس عليه حُجَّةٌ في قتيله","وليس عليه في الجروح قِصاصُ",49,"ص",1,0],["وليس عندي ما به","استر يوما فقري",50,"ر",2,0],["وليس على منوالها ونسيجها","يحوك ابن برد لا ولا حاك شاعر",51,"ر",1,0],["وليس على حال تدوم وما قضى","بها موطرا زيد لعمري ولا عمرو",52,"ر",2,0],["وليس على الانفاق بلحقه الاسى","ولكن على الامساك بأخذه الاسف",53,"ف",1,0],["وليس عُمْرُ الخَمْر ما لم يَحُلْ","حَوْلٌ عليها عندنا عُمْرا",54,"ر",2,0],["وَلَيسَ عَنها عائِقٌ","يَعوقُ إِلّا الكَسَلُ",55,"ل",1,0],["وَلَيسَ عَجيباً أَنَّ نارَ جَوانِحي","تَزيدُ بِماءِ الدَمعِ وَقداً وَإِحراقا",56,"ق",2,0],["وَليسَ عَجيباً ما أُتيحَ مُيَسَّراً","بِرَأيِ أَبي الفَتحِ المُوَفَّقِ مِن فَتحِ",57,"ح",1,0],["وَلَيسَ عَلى كَئيبٍ جُنَّ شَوقاً","فَلَم يَعقِل بِحُبِّكَ مِن جُناحِ",58,"ح",1,0],["وَلَيسَ عَلى بَابِ اِبنِ إِدريسَ حاجِبٌ","وَلَيس عَلى بابِ اِبنِ اِدريسَ مِن قِفل",59,"ل",1,1],["وَلَيسَ على الصَباح إِذا تجلّى","وَلَم يُبصِرهُ أَعمى العين عابُ",60,"ب",1,0],["وَليس عليك إنْ نكثوا وَخانوا","وليس عليك إنْ وَعَدوك زورا",61,"ر",2,0],["وليس على قدر سؤال فإنني","أرى أن قدري دون مقدار ذرة",62,"ه",1,0],["وَلَيسَ عَلى قُربِهِ بِالمَكانِ","بُعدٌ وَمَن حَلَّ فيهِ ثَواءَ",63,"ا",2,0],["وَلَيسَ عَلى شَيءٍ مِنَ العَقلِ واجِدُ","بِكُم وَلَهُ بِاللَومِ عَن قَصدِكُم عَقلُ",64,"ل",1,0],["وَلَيسَ عَجيباً أَنَّ هاروت لَحظه","مُذ اِستخدم الأَلباب ما زالَ يسحرُ",65,"ر",1,0],["وَلَيسَ عَلَيكَ حق لازِم لي","سِوى اِنّي بسوح عَلاك ضَيف",66,"ف",1,0],["وليس عن قَصْدِه","تَمْنَعُ لكنْ تَكاد",67,"د",1,0],["وليسَ عِندَ اللَّيالي أنَّ أقبحَ ما","صَنَعنَ بي أن جَعَلن الشِّعر مُكتَسَبي",68,"ب",2,0],["وَلَيسَ عَينُك عن قَتلي بنائِمةٍ","فأينَ ما سَلَبتنيهِ من الوسَنِ",69,"ن",1,0],["وليس عليه لومٌ إذ رآنا","نياماً بالتواني يا حبيبي",70,"ب",2,0],["وَلَيسَ عَلى مَآثرهم","وَإِن جَلَت بِمتكل",71,"ل",1,0],["وليس على الإنسان ان يعملوا به","وليس