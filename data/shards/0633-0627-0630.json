{"poems":[[55,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[65,"أما وتجني طيفها المتأوب","https://www.aldiwan.net/poem46154.html","الطويل"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[79,"برئت إلى الشوق المبرح من قلبي","https://www.aldiwan.net/poem36770.html","الطويل"],[95,"سلام على القدس ومن به","https://www.aldiwan.net/poem11150.html","الطويل"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[29,"أمن عهد ذي عهد تفيض مدامع","https://www.aldiwan.net/poem5971.html","الطويل"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[11,"وعاذلة هبت بليل تلومني","https://www.aldiwan.net/poem238.html",""],[72,"تعالوا بنا نطوي الحديث الذي جرى","https://www.aldiwan.net/poem42918.html","الطويل"],[72,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19183","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10367","الطويل"],[90,"اعرني لساناً ايها الشعر للشكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19582&r=&rc=85",""],[147,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[215,"أخاصم نور البدر عمدا لعلني","https://www.aldiwan.net/poem46312.html","الطويل"],[215,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[215,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[234,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[275,"دعني أجازف بالهوى والحسن","https://www.aldiwan.net/poem35249.html","الكامل"],[275,"بما في ليالي الهوى من أرق","https://www.aldiwan.net/poem35459.html","المتقارب"],[275,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[275,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[371,"أمنت بحمد الله مما أحاذر","https://www.aldiwan.net/poem17199.html","الطويل"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[376,"سأذكر ما أنا فيه وما","https://www.aldiwan.net/poem57387.html","المتقارب"],[402,"سلام على القدس الشريف ومن به","https://www.aldiwan.net/poem11026.html","عموديه"],[469,"أيا ظاعناً أنا من بعده","https://www.aldiwan.net/poem3552.html","عموديه"],[543,"بمكتبة ابن زيدان حللت","https://www.aldiwan.net/poem47967.html","عموديه"],[580,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48608","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122326","الطويل"],[983,"","https://poetry.dctabudhabi.ae/diwan/poem/114044","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80201","الوافر"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145104","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89547","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77230","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77295","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201751","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68003","الطويل"],[3679,"","https://poetry.dctabudhabi.ae/diwan/poem/146388","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91741","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21407","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131291",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131028",""],[3800,"","https://poetry.dctabudhabi.ae/diwan/poem/146653","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136954",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67481","الوافر"],[4804,"لئن بعدت عن الاحباب دارُ","https://www.poetsgate.com/ViewPoem.aspx?id=92090",""],[5285,"لا لن أعاتبُ زهرتي","https://www.poetsgate.com/ViewPoem.aspx?id=203648",""],[5324,"آن الأوان .","https://www.poetsgate.com/ViewPoem.aspx?id=207639",""],[5324,"آن الأوان.","https://www.poetsgate.com/ViewPoem.aspx?id=211060",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5533,"جَفانِي النَّوْم","https://www.poetsgate.com/ViewPoem.aspx?id=176665",""],[5616,"مفاتن","https://www.poetsgate.com/ViewPoem.aspx?id=203233",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5956,"سأكتب شعراً إلى أن أموت ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182173",""],[5956,"كلانا تزوج عَن غير حُب","https://www.poetsgate.com/ViewPoem.aspx?id=182204",""],[5956,"سرُ ليلي وإعراضي","https://www.poetsgate.com/ViewPoem.aspx?id=182306",""],[5956,"سأكون دون إقامة وأبورُ","https://www.poetsgate.com/ViewPoem.aspx?id=204590",""],[5969,"حِداداً على روحي","https://www.poetsgate.com/ViewPoem.aspx?id=198800",""],[6068,"فلسفة الغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178196",""],[6093,"بِشَامِ الغيد روحي والمرامُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176151",""]],"verses":[["سَأَذهَبُ عَنكُم غَيرَ باكٍ عَلَيكُمُ","وَما لِيَ عُذرٌ أَن تَفيضَ المَدامِعُ",0,"ع",1,0],["سأذْكُرُهُ للرَّكْبِ كلّتْ مَطيُّهُمْ","وللسّفْرِ إذ أعْياهُمُ وَجْهُ مَطْلَبِ",1,"ب",1,0],["سَأَذْكُرُهُمْ حَيْثُ احْتَلَلْتُ وَإِنْ نَسُوا","وَأَمْدَحُهُمْ مَهْمَا قَدَرْتُ وَإِنْ ذَمُّوا",2,"م",3,0],["سَأَذْهَبُ فِي اللَّذَّاتِ مِلْءَ أَعِنَّتِي","وَأَرْكِضُ خَيْلَ اللَّهْو فِي طَلَقِ رَحْبِ",3,"ب",1,0],["سَأَذْكُرُ مَا أَحْيَا نَعِيمِي بِأُنْسِهِمْ","وَوِرْدِي مِنْ حُلْوِ اللِّقَاءِ وَعَذْبِهِ",4,"ب",2,0],["سَأَذكُرُ مِن هُنَيدَةَ ما عَلِمتُم","وَأَرفَعُ شَأنَ جِعثَنَ وَالرَبابِ",5,"ب",1,0],["سَأَذكُرُ ما لَم تَذكُروا عِندَ مِنقَرٍ","وَأُثني بِعارٍ مِن حُمَيدَةَ أَشنَعا",6,"ع",2,0],["سَأَذكُرُ ما قالَ الحُطَيأَةُ جارُكُم","وَأُحدِثُ وَسماً فَوقَ وَسمِ المُخَبَّلِ",7,"ل",1,0],["سَأَذكُرُ مِنكُم كُلَّ مُنتَخَبِ القُوى","مِنَ الخورِ لا يَرعى حِفاظاً وَلا حِمى",8,"م",2,0],["سَأَذخَرُ مِن مالي دِلاصاً وَسابِح","وَأَسمَرَ خَطِّيّاً وَعَضباً مُهَنَّدا",9,"د",2,0],["سَأَذكُرُ إِحساناً تَقَدَّمَ مِنكُمُ","وَأَترُكُ إِكراماً لَهُ ما تَأَخَّرا",10,"ر",2,0],["سَأُذكي لَهُ بَينَ المُلوكِ مَجامِراً","فَمِن ذِكرِهِ نَدٌّ وَمِن فِكرِيَ الجَمرِ",11,"ر",1,0],["سَأَذكُرُ ما حَيِّتُ جِدارَ قَبرٍ","بِظاهِرِ جِلَّقَ رَكِبَ الرِمالا",12,"ل",2,0],["سَأَذكُرُ ما حَييتُ جِدارَ قَبرٍ","بِظاهِرِ جِلَّقَ رَكِبَ الرِمالا",13,"ل",2,0],["سَأَذخَرُ مِن مالي دِلاصاً وَسابِحاً","وَأَسمَرَ خَطِّيّاً وَعَضباً مُهَنَّدا",14,"د",2,0],["سأذكركم ذكر المحبِّ حبيبه","وأشكركم شكر الجدوب ندى القطر",15,"ر",1,0],["سَأَذكُرُهُ ما عِشتُ لا ذِكرَ عاتِبٍ","كَذِكرِ اِمرِيءِ القَيسِ الدَخولَ فَحَومَلا",16,"ل",2,0],["سأذكركم ذكر الهديل أليفه","وأصفح عما قد تريدون من ضرّى",17,"ر",2,0],["سأذكر أنى قد شقيت بحبكم","وأنى فضّحتُ المكتّم من سرى",17,"ر",2,0],["سأذكر قبراً فوق قلبي أقمته","يقيم به روح عزيز مبجل",18,"ل",1,0],["سأذكر قبراً لو أطقت نسيته","ألا إنما النسيان موتٌ معجل",18,"ل",1,0],["سأذكر ليل العيد أني عشقتكم","ولم أك يوما لاعباً يتعشق",19,"ق",1,0],["سأذكر ليل العيد ما كان من هوىً","نعمنا به والدهر كالصل مطرق",19,"ق",1,0],["سأذكر ليل النحر والبدر يرتمى","بأمواجه والنور كالزهر يخنق",19,"ق",1,0],["سَأَذكرُ المرجةَ في الفَجرِ إِذ","أَبكَرتَ كَالحَسّونِ إِذ يُبكِرُ",20,"ر",1,0],["سأذكر إن نسيتَ قديمَ عهدي","وأُسهِل إن ألمَّ بك امتناع",21,"ع",1,0],["سأذيقهُ اللذاتِ حتى يَشتفي","ويقولُ لي إني اكتفيتُ فدَعني",22,"ن",2,0],["سأذكرُ يا هندُ من حبِّنا","وداعَ الصّباحِ وشوقَ الغَسَق",23,"ق",1,0],["سأذكُرُ في دار الحبيبةِ سمرةً","تزوّدتُ منها أطيبَ الكلمات",24,"ت",1,0],["سأذكرُ من ليلى لياليَّ والهوى","يمزِّقُ من أثوابِ صبري وعفتي",25,"ي",1,0],["سَأَذكُرُ ما أَولَيتَ وَالذِكرُ شُكرُهُ","وَضامِنَتي فيهِ اللَيالي الغَوابِرُ",26,"ر",1,0],["سَأَذكُرُ لِلأَيّامِ عُرساً بِدَهرِهِ","أَقامَ عَلَيهِ مِن لَياليهِ مَأتَما",27,"م",2,0],["سَأذكرُ ما أنا فيه وما","لقيتُ وأشرَحه ذاكِرا",28,"ر",2,1],["سأذكر ما أحي نعيمي بأنسهم","ووردي من حلو اللقاء وعذبه",29,"ب",2,0],["سأذكر بعد وداعك منك خلا","ئقَ مثل نسيم السحر",30,"ر",1,0],["سَأذهبُ مُرغَماً عنه صباحاً","وفي سفري على اللهِ اتَّكَلتُ",31,"ت",1,0],["ساذَجةٍ لكنَّها","بالحُسْنِ قد تَزوَّقت",32,"ت",1,0],["ساذج العيش ما كلفت زماني","بدخان أو قهوة أو راحِ",33,"ح",1,0],["ساذكرهم في كل ارض حللتها","وذكر الفتى للحشر يمتد حبله",34,"ل",2,0],["سأذود عن محيي هواك بكل ما","وسعت حياة تعاسة وفتون",35,"ن",1,0],["سَأَذكُر فَيضَ لُطفِكَ كُل يَومٍ","وَإِن أَنساهُ تَنساني يَميني",36,"ن",2,0],["سأذكركم والشوق يزداد وَقْده","إذا ما دَنَتْ من أندونيسيا السواحل",37,"ل",1,0],["سَأَذكُرُهُ ما بَلَّ ريقيَ مِقوَلي","وَما ناخَ شَجواً بِالأَراكِ هَديلُ",38,"ل",1,0],["سَأَذودُ عِرضي عَن حِيا","ضِ الجَهلِ إِنَّ العرضَ غالِ",39,"ل",1,0],["سَأَذكُرُ بِالسودانِ ما لاحَ كَوكَبٌ","سَنى كَوكَب في مِصرَ لَيسَ بِطالِعِ",40,"ع",1,0],["ساذج ما عاشر الأولاد كي","يغتدي في مكرهم متصفا",41,"ف",2,0],["سأذكر يوماً وقفةً فِي مُروجِها","وحولي بِهَا رِيمُ الفَلا وعَتودها",42,"د",3,0],["سأذكرهم طول الحياة بصالح","وأهدي لهم سهل القريض وجزله",43,"ل",2,0],["سَأذكر ذاك الجَمعَ طوراً وَأَنثني","عَلى الكَبد الحرّا بدمع غمام",44,"م",1,0],["سأَذكُرُ مِن نَفسي خَلائِقَ جَمَّةً","وَمَجداً قَديماً طالَما قَد تَرفَّعا",45,"ع",2,0],["ساذكره ذكر الوفي الذي يرى","رثاءك فرضاً بالقريض المحبر",46,"ر",1,0],["سأذكره في كل يوم وليلة","ولو أن في ذكر الكهول له ذنبا",47,"ب",2,0],["سأذهل عنك لا عجزاً ولكن","ليجزيك الزمان بسوء فعلك",48,"ك",1,0],["سأذكره ولو فلي من","تهى أعماق آذيس",49,"س",1,0],["سأذعن كرهاً لاعج الغيظ مكمنا","لكبر إلاهٍ لم يكن فوق ما أنا",50,"ن",2,0],["سأذكركم إذا الارز احتواني","غداً وأفاءَني الظلُّ الظليل",51,"ل",1,0],["سأذكر عن بني وهب أموراً","وليس الغمر كالرجل الخبيرِ",52,"ر",1,1],["سأذكر يا أبا أيوب فضلاً","حوته لك الجحاجحة الكبارُ",53,"ر",1,0],["سأذودُ عنه وبالنفيسِ أبادِلُ ال","ماءَ النميرَ وقد جرى طولَ العقودِ",54,"د",1,0],["سأذيقك المرّ الزؤامَ من الردى","فاختر لموتِك أيّ حبلٍ ترغبُ",55,"ب",1,0],["سأذيقك المر الزؤام من الردى",".فاختر لنفسك أي حبل ترغب",56,"ب",1,0],["سأذيع حبّكِ يا دمشقُ وثورتي","كي تستبينَ لك الأمورُ كما هيا",57,"ي",2,0],["سَأَذْكُرُ حُبَّهَ ما طارَ طَيْرٌ","وما بَعْدَ النَّهَارِ أَتَى المَغِيْبُ",58,"ب",1,0],["سأذيع للأحباب عطر قصائدي","حتى أجفّ وعندها أتوقف",59,"ف",1,0],["سأذيب حزني عن عقارب ساعتي","ولقد يعاود أرضيَ الدوران",60,"ن",1,0],["سأذكر حباً يموج بعيني","جميلا حميماً كثيف الحنان",61,"ن",1,0],["سأذوي بكاءً لأجل هوانا ال","ذبيح، فما وَحّدْتنا السماءْ",62,"ا",2,0],["سأذرف كل دمعي يا ملاكي","لأنّ الليلَ عندي الإنعزالُ",63,"ل",1,0],["سأذلّ باقي العمر لم يرأف أخي","أبداً بحالي، أم له تبريرُ؟",64,"ر",1,0],["سَأَذوي عَلى دَمْعِ النِساءِ مُتَيمَا","لأَبعث لِلعُشاقِ وَعْدَاً مُؤَكَّدَا",65,"د",2,0],["سأذكر في بهاك منمنمات","على نسق النقاوة والسمات",66,"ت",1,1],["سأذْكُرُ وائلاً ما قلتُ خيراً","وعندَ البأس ينتفضُ الحسامُ",67,"م",1,0]]}