{"poems":[[55,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[65,"أما وتجني طيفها المتأوب","https://www.aldiwan.net/poem46154.html","الطويل"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[79,"برئت إلى الشوق المبرح من قلبي","https://www.aldiwan.net/poem36770.html","الطويل"],[95,"سلام على القدس ومن به","https://www.aldiwan.net/poem11150.html","الطويل"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[29,"أمن عهد ذي عهد تفيض مدامع","https://www.aldiwan.net/poem5971.html","الطويل"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[11,"وعاذلة هبت بليل تلومني","https://www.aldiwan.net/poem238.html",""],[72,"تعالوا بنا نطوي الحديث الذي جرى","https://www.aldiwan.net/poem42918.html","الطويل"],[72,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19183","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10367","الطويل"],[90,"اعرني لساناً ايها الشعر للشكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19582&r=&rc=85",""],[146,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[214,"أخاصم نور البدر عمدا لعلني","https://www.aldiwan.net/poem46312.html","الطويل"],[214,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[214,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[226,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[232,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[273,"دعني أجازف بالهوى والحسن","https://www.aldiwan.net/poem35249.html","الكامل"],[273,"بما في ليالي الهوى من أرق","https://www.aldiwan.net/poem35459.html","المتقارب"],[273,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[273,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[369,"أمنت بحمد الله مما أحاذر","https://www.aldiwan.net/poem17199.html","الطويل"],[369,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[374,"سأذكر ما أنا فيه وما","https://www.aldiwan.net/poem57387.html","المتقارب"],[400,"سلام على القدس الشريف ومن به","https://www.aldiwan.net/poem11026.html","عموديه"],[466,"أيا ظاعناً أنا من بعده","https://www.aldiwan.net/poem3552.html","عموديه"],[540,"بمكتبة ابن زيدان حللت","https://www.aldiwan.net/poem47967.html","عموديه"],[577,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21407","الطويل"]],"verses":[["سَأَذهَبُ عَنكُم غَيرَ باكٍ عَلَيكُمُ","وَما لِيَ عُذرٌ أَن تَفيضَ المَدامِعُ",0,"ع",1,0],["سأذْكُرُهُ للرَّكْبِ كلّتْ مَطيُّهُمْ","وللسّفْرِ إذ أعْياهُمُ وَجْهُ مَطْلَبِ",1,"ب",1,0],["سَأَذْكُرُهُمْ حَيْثُ احْتَلَلْتُ وَإِنْ نَسُوا","وَأَمْدَحُهُمْ مَهْمَا قَدَرْتُ وَإِنْ ذَمُّوا",2,"م",3,0],["سَأَذْهَبُ فِي اللَّذَّاتِ مِلْءَ أَعِنَّتِي","وَأَرْكِضُ خَيْلَ اللَّهْو فِي طَلَقِ رَحْبِ",3,"ب",1,0],["سَأَذْكُرُ مَا أَحْيَا نَعِيمِي بِأُنْسِهِمْ","وَوِرْدِي مِنْ حُلْوِ اللِّقَاءِ وَعَذْبِهِ",4,"ب",2,0],["سَأَذكُرُ مِن هُنَيدَةَ ما عَلِمتُم","وَأَرفَعُ شَأنَ جِعثَنَ وَالرَبابِ",5,"ب",1,0],["سَأَذكُرُ ما لَم تَذكُروا عِندَ مِنقَرٍ","وَأُثني بِعارٍ مِن حُمَيدَةَ أَشنَعا",6,"ع",2,0],["سَأَذكُرُ ما قالَ الحُطَيأَةُ جارُكُم","وَأُحدِثُ وَسماً فَوقَ وَسمِ المُخَبَّلِ",7,"ل",1,0],["سَأَذكُرُ مِنكُم كُلَّ مُنتَخَبِ القُوى","مِنَ الخورِ لا يَرعى حِفاظاً وَلا حِمى",8,"م",2,0],["سَأَذخَرُ مِن مالي دِلاصاً وَسابِح","وَأَسمَرَ خَطِّيّاً وَعَضباً مُهَنَّدا",9,"د",2,0],["سَأَذكُرُ إِحساناً تَقَدَّمَ مِنكُمُ","وَأَترُكُ إِكراماً لَهُ ما تَأَخَّرا",10,"ر",2,0],["سَأُذكي لَهُ بَينَ المُلوكِ مَجامِراً","فَمِن ذِكرِهِ نَدٌّ وَمِن فِكرِيَ الجَمرِ",11,"ر",1,0],["سَأَذكُرُ ما حَيِّتُ جِدارَ قَبرٍ","بِظاهِرِ جِلَّقَ رَكِبَ الرِمالا",12,"ل",2,0],["سَأَذكُرُ ما حَييتُ جِدارَ قَبرٍ","بِظاهِرِ جِلَّقَ رَكِبَ الرِمالا",13,"ل",2,0],["سَأَذخَرُ مِن مالي دِلاصاً وَسابِحاً","وَأَسمَرَ خَطِّيّاً وَعَضباً مُهَنَّدا",14,"د",2,0],["سأذكركم ذكر المحبِّ حبيبه","وأشكركم شكر الجدوب ندى القطر",15,"ر",1,0],["سَأَذكُرُهُ ما عِشتُ لا ذِكرَ عاتِبٍ","كَذِكرِ اِمرِيءِ القَيسِ الدَخولَ فَحَومَلا",16,"ل",2,0],["سأذكركم ذكر الهديل أليفه","وأصفح عما قد تريدون من ضرّى",17,"ر",2,0],["سأذكر أنى قد شقيت بحبكم","وأنى فضّحتُ المكتّم من سرى",17,"ر",2,0],["سأذكر قبراً فوق قلبي أقمته","يقيم به روح عزيز مبجل",18,"ل",1,0],["سأذكر قبراً لو أطقت نسيته","ألا إنما النسيان موتٌ معجل",18,"ل",1,0],["سأذكر ليل العيد أني عشقتكم","ولم أك يوما لاعباً يتعشق",19,"ق",1,0],["سأذكر ليل العيد ما كان من هوىً","نعمنا به والدهر كالصل مطرق",19,"ق",1,0],["سأذكر ليل النحر والبدر يرتمى","بأمواجه والنور كالزهر يخنق",19,"ق",1,0],["سَأَذكرُ المرجةَ في الفَجرِ إِذ","أَبكَرتَ كَالحَسّونِ إِذ يُبكِرُ",20,"ر",1,0],["سأذكر إن نسيتَ قديمَ عهدي","وأُسهِل إن ألمَّ بك امتناع",21,"ع",1,0],["سأذيقهُ اللذاتِ حتى يَشتفي","ويقولُ لي إني اكتفيتُ فدَعني",22,"ن",2,0],["سأذكرُ يا هندُ من حبِّنا","وداعَ الصّباحِ وشوقَ الغَسَق",23,"ق",1,0],["سأذكُرُ في دار الحبيبةِ سمرةً","تزوّدتُ منها أطيبَ الكلمات",24,"ت",1,0],["سأذكرُ من ليلى لياليَّ والهوى","يمزِّقُ من أثوابِ صبري وعفتي",25,"ي",1,0],["سَأَذكُرُ ما أَولَيتَ وَالذِكرُ شُكرُهُ","وَضامِنَتي فيهِ اللَيالي الغَوابِرُ",26,"ر",1,0],["سَأَذكُرُ لِلأَيّامِ عُرساً بِدَهرِهِ","أَقامَ عَلَيهِ مِن لَياليهِ مَأتَما",27,"م",2,0],["سَأذكرُ ما أنا فيه وما","لقيتُ وأشرَحه ذاكِرا",28,"ر",2,1],["سأذكر ما أحي نعيمي بأنسهم","ووردي من حلو اللقاء وعذبه",29,"ب",2,0],["سأذكر بعد وداعك منك خلا","ئقَ مثل نسيم السحر",30,"ر",1,0],["سَأذهبُ مُرغَماً عنه صباحاً","وفي سفري على اللهِ اتَّكَلتُ",31,"ت",1,0],["ساذَجةٍ لكنَّها","بالحُسْنِ قد تَزوَّقت",32,"ت",1,0],["سأَذكُرُ مِن نَفسي خَلائِقَ جَمَّةً","وَمَجداً قَديماً طالَما قَد تَرفَّعا",33,"ع",2,0]]}