{"poems":[[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[240,"يا ابن الزريشي ما زريش","https://www.aldiwan.net/poem31907.html","مجزوء البسيط"],[463,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[466,"رفقا بها يا أيها الزاجر","https://www.aldiwan.net/poem16434.html","السريع"],[505,"قرأنا معاني السر فالحكم ظلهر","https://www.aldiwan.net/poem37685.html","الطويل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202164","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141202","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201704","الوافر"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216809","السريع"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""]],"verses":[["فمخطئٌ يطرق راسا خجلاً","وصائب يبدو بوجه مسفرِ",0,"ر",1,0],["فَمَخبَرٌ لِلقُلوبِ يُدوي","وَمَنظَرٌ لِلعُيونِ يُعشي",1,"ش",2,0],["فمختمرٌ ما عدا ليلتينِ","ومسفرُعشرٍ خَطَاها فتمّْ",2,"م",1,0],["فمِخْدَعُ البيت وجوْزُ الفَلا","سِيَّانِ أمْناً أيُّها الحاذِرُ",3,"ر",1,0],["فمختاره الهادي لحضرةِ قدسه","هدانا ومحقا قد غدون الخواطر",4,"ر",1,0],["فَمُخَيَّمُ الأَشواق حولَ خِيامه","وتَشَعُّبُ الأَهواء بين شِعابِه",5,"ب",2,0],["فمختلطات الهمّ فيها كثيرة","فليس لها رسمٌ وليس لها حدُّ",6,"د",1,0],["فمخلوق وخلّاق ودنياً","من الأسرار يحجبها السكوت",7,"ت",1,0],["فمخرجها ومسكنها الفيافي","وشردها وليس لها خلود",8,"د",1,0],["فمخلق العمر كموشيِّه","ومالك الأرض كخاوي الوطاب",9,"ب",1,0],["فمخضب ومؤزر ومعمم","ومزنر ومبرقع ومقرطق",10,"ق",1,0],["فم خص تعظيم الرسول بموضعٍ","فذاك هو المنقوصُ والناقصُ الجد",11,"د",1,0]]}