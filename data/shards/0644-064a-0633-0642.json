{"poems":[[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[95,"لي سقف حلق كسماء الشتا","https://www.aldiwan.net/poem11067.html","السريع"],[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[45,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[71,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[102,"الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50342",""],[101,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[159,"لي سقام مواصل","https://www.aldiwan.net/poem55570.html","مجزوء الخفيف"],[203,"أصبحي يا هموم فينا وبيتي","https://www.aldiwan.net/poem45549.html","الخفيف"],[409,"ما رحلتم عن مقلتي وسوادي","https://www.aldiwan.net/poem33943.html","الخفيف"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[463,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[491,"قالت ولم تقصد لقول الخنا","https://www.aldiwan.net/poem479.html",""],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126871","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122559","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112885","الرمل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27603","الوافر"],[2599,"","https://poetry.dctabudhabi.ae/diwan/poem/142618","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93952","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204770","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118835","الخفيف"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91429","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33437","الخفيف"],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5717,"لا در در الجهل كم جر على ال","https://www.poetsgate.com/ViewPoem.aspx?id=170595",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6124,"عناقُ الحروفِ العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=109747",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["لِيُسقَ عَهدُكُمُ عَهدُ السُرورِ فَما","كُنتُم لِأَرواحِنا إِلّا رَياحينا",0,"ن",2,0],["لي سقف حلق كسماء الشتا","خلو لدى الأبصار من كوكب",1,"ب",1,1],["ليس قدر الفتى من العيش إلاّ","قدر انتاج سعيه المتوالي",2,"ل",2,0],["لَيسَ قَولي في شَمسِ فِعلِكَ كَالشَم","سِ وَلَكِن في الشَمسِ كَالإِشراقِ",3,"ق",1,0],["لِيَسقَمِ الدَهرُ أَو تَصحِح مَوَدَّتُهُ","فَاليَومَ أَوَّلَ يَومٍ صَحَّ لي أَمَلُ",4,"ل",1,0],["ليسَ قفاءُ عاذلي العسوفِ","إلاّ معَ المجرورِ والظّروفِ",5,"ف",1,0],["لَيسَ قصدي مِمّا ذكرت عتاباً","غير أني أوردته في السياق",6,"ق",1,0],["ليس قصدي أن تيأسوا ، لحطاكم","قصة من دم الصخور العواتي",7,"ت",2,0],["ليس قصدي إذلال نهديك .. لكن","جاء دوري لكي أكون لئيما ..",8,"م",2,0],["لِي سَقامٌ مُواصِلُ","وَدُمُوعٌ هَوَامِلُ",9,"ل",1,1],["ليسَ قلبي لغيرِ من يحفظُ القل","بَ سواءَ أبيتِ هذا أو رضيتِ",10,"ت",1,0],["ليس قرب الأجسام عندي قرباً","إنما القرب في صميم الفؤاد",11,"د",1,0],["ليس قتل الشعوب سهلا","وكم شعب غبين أدال من خسفه",12,"ف",2,0],["ليسقِ مكارماً لك واصلتني","سكوبٌ من حيا شكري دَفوقُ",13,"ق",1,0],["ليسَ قولاً ما لم تَقِفْ شَعَفاتُ ال","نَّخل ِصَفّاً ، وتَنهَض الأعذاقُ",14,"ق",1,0],["ليسَ قَولاً إلا وماءُ الفُراتَين ِ","لَهُ عِدْلَ مَوجِهِ أحداقُ",14,"ق",1,0],["لَيسَ قَطا مِثلَ قُطَيٍّ وَلا ال","مَرعِيُّ في الأَقوامِ كَالراعي",15,"ع",2,0],["ليس قلبي يا خليليَّ مِنِّي","إن نزا شوقاً إليها وتاقا",16,"ق",2,0],["ليسقي بهمّتهِ الزائرين","لسبطِ النبيّ ومَولى الأمَم",17,"م",1,0],["ليس قلبي صَفا المشقَّر جسمي","وفؤادي من نُطفةٍ أمشاج",18,"ج",1,0],["ليس قصدي في الغواني","وافتخار بمكان",19,"ن",1,0],["لِيَسقِيَ مِن تُدمِيرَ قُطراً مُحَبَّباً","يَقِرُّ بِعَينِ القُطرِ أَن تَشرَبَ القَطرَا",20,"ر",2,0],["ليسقي زرعه كرماً وجوداً","ليقري بالغداةِ وبالعشيّ",21,"ي",1,0],["ليس قلبى معى فيستمع اللو","م ولكنه تلاشى أنينا",22,"ن",2,0],["ليس قلب الأوصار عليها","طائراً إذ بدت كقامة غصن",23,"ن",1,0],["ليس قولي شعرا فذلك وحي","صيغ كالشعر كي يزيد جمالا",24,"ل",2,0],["ليس قصدي إلاك يا روح روحي","في احتراكي إن كان أوفي ركودي",25,"ي",1,0],["لَيْسَ قَلْبي عَنِ الاَنينِ بِصاحِ","وَالْحُسَيْنُ الشَّهيدُ أصْلُ مُرادي",26,"ي",1,0],["لَيسَ قَلبي وَلا المَدامع طوعى","أحتكم فيهما وَلا من شؤوني",27,"ن",2,0],["ليس قصدي وقصيدي اختلفا","أنا من وافق سري علني",28,"ي",1,0],["ليسَ قدرُ الفؤادِ أن يَهواكا","لا ولا قدرُ ناظرٍ أن يَراكا",29,"ك",2,1],["ليسقيَ العمر بعضا من حلاوته","ويلبس الدفء منذ الخلق مالبِسا",30,"س",2,0],["ليُسقى غمام الوجد ضوءَ انفعاله","ويبلغَ احساسَ الكواكبِ حرُّه",31,"ر",2,0],["ليسقي كلَّ صاديةٍ","ويروي كلَّ من وردا",32,"د",2,0],["ليس قعود الأعزل الجبان في","يوم الهياج للكمي المعلم",33,"م",1,0],["لَيسَ قَلبِي! وَإِنَّما قَلبُ باغٍ","مَن يُعادِيكِ يا شَذَى الأُقحُوانِ",34,"ن",1,0],["ليسقي همزةً كانتْ قديماً","تفيضُ الأُنسَ في إنسٍ هواكِ",35,"ك",1,0],["ليسَ قربيْ غيري وناقوسُ قلبيْ","هدهدَ الدمعَ شارداً ونحيلا",36,"ل",2,0]]}