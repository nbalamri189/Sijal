{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[79,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[85,"يا خير من ورث السماح عن الألى","https://www.aldiwan.net/poem54238.html","الكامل"],[90,"قصدوا الرياضة لاعبين وبينهم","https://www.aldiwan.net/poem44415.html","الكامل"],[23,"أبلغ ربيعة وابن أمه نوفلا","https://www.aldiwan.net/poem21450.html","الكامل"],[53,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[94,"كنا كزوجي طائر","https://www.aldiwan.net/poem38903.html","مجزوء الكامل"],[94,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[94,"أراك فتحلو لدي الحياة","https://www.aldiwan.net/poem38925.html","المتقارب"],[91,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[87,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[58,"نغفل والأيام لا تغفل","https://www.aldiwan.net/poem58538.html","السريع"],[47,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[47,"رأيت البحبحاني استقلت","https://www.aldiwan.net/poem66636.html","البسيط"],[51,"يا عتب هجرك مورث الأدواء","https://www.aldiwan.net/poem63211.html","الكامل"],[68,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[82,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[82,"طربت متى كنت غير الطروب","https://www.aldiwan.net/poem31567.html","المتقارب"],[54,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[50,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[108,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[102,"سياح الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=50398",""],[102,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[102,"تحت السكاكين","https://www.poetsgate.com/ViewPoem.aspx?id=50374",""],[102,"البعث العربي","https://www.poetsgate.com/ViewPoem.aspx?id=50164",""],[69,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[92,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[47,"رَأيتُ البَحبَحانيّ اسْتَقَلّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=32050",""],[53,"أنجِز الوعدَ إنَّ خيرَ مواعي","https://www.poetsgate.com/ViewPoem.aspx?id=30094",""],[102,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[136,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[147,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[154,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[159,"رب ليل طلعت فيه","https://www.aldiwan.net/poem55779.html","مجزوء الرمل"],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[185,"وجدت بها وجد المضل بعيره","https://www.aldiwan.net/poem59075.html","الطويل"],[189,"عن سيف دين الله سل أرناطا","https://www.aldiwan.net/poem14806.html","الكامل"],[197,"غدوت بخيرة ورخاء حال","https://www.aldiwan.net/poem13118.html","الوافر"],[201,"ولهان يفترش الرمال أصيلا","https://www.aldiwan.net/poem39898.html","الكامل"],[233,"عن لي أن أقبلك","https://www.aldiwan.net/poem50890.html","مجزوء الخفيف"],[239,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[241,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[245,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[266,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[289,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[301,"قد حال ما بيني وبين مآربي","https://www.aldiwan.net/poem33319.html","الكامل"],[332,"بعد حين ستواريني كما","https://www.aldiwan.net/poem55021.html","مجزوء الرمل"],[368,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[375,"بعض من غارمني لازمني","https://www.aldiwan.net/poem57252.html","الرمل"],[375,"دارت عيون في محاجر","https://www.aldiwan.net/poem57443.html","مجزوء الكامل"],[407,"يسائلني من باهتدائي يستهدي","https://www.aldiwan.net/poem33949.html","الطويل"],[410,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[413,"غالبتني عليك أيدي المنايا","https://www.aldiwan.net/poem31678.html","عموديه"],[433,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[443,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[443,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[455,"لله إفريز كروضة خرم","https://www.aldiwan.net/poem13781.html","الكامل"],[480,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[482,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[482,"قل هكذا مد الشباك","https://www.aldiwan.net/poem37068.html","مجزوء الكامل"],[508,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[517,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[909,"","https://poetry.dctabudhabi.ae/diwan/poem/97682","الكامل"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21379","الوافر"]],"verses":[["فَتْخُ الْقَواَدِمِ لِلْفَنَا قَدْ أَبْرَمَتْ","أَمْراً بِهَا كَفُّ الْقَضَاءِ الْمُبْرِمِ",0,"م",1,0],["فَتَخَالُهُمْ جَزَراً عَلَى صَهَوَاتِهَا","وَتَخَالُهَا مِنْ تَحْتِهِمْ أَوْضَامَا",1,"م",2,0],["فَتُخَبرَ أَنَّ عيصَ بَني عَديٍّ","تَفَرَّعَ نَبتُهُ الحَسَبَ النُضارا",2,"ر",2,0],["فتخصني منه بأوفر قسمة","فَسَحَتْ لعبدك في الرضى ميدانا",3,"ن",2,0],["فتخالها وتخاله كفريسةٍ","سقطت فزمجر دونها الضرغام",4,"م",1,0],["فَتَخالُهُ حَسّانَ إِذ حَرَّبتَهُ","فَدَعِ الفَضاءَ إِلى مَضيقِكَ وَاِفسَحِ",5,"ح",1,0],["فتخيَّرْ من اثنتيْن ولا يُغْ","لِق عليكَ المذاهبَ استغلاقُك",6,"ك",1,0],["فَتَخالَسا نَفسَيهِما بِنَوافِذٍ","كَنَوافِذِ العُبُطِ الَّتي لا تُرقَعُ",7,"ع",1,0],["فَتَخَطَّفَ الكأسَ الخلوبَ","وحطَّمَ الجامَ الثَّمينْ",8,"ن",1,0],["فَتَخْفُقُ فيه أَغاني الورودِ","ويخضرُّ فِرْدَوْسُ نفسي الحَصيدْ",9,"د",1,0],["فتخطو أَناشيدُ قلبيَ سَكْرى","تغرِّدُ تَحْتَ ظِلالِ القَمَرْ",10,"ر",1,0],["فتخمد أنفاس وتيبس أوجه","لنا يبس أزهار بألوانها تسبى",11,"ب",2,0],["فَتَخَيَّرها كَما تَختارُهُ","وَاِدَّخِر في الصَحبِ وَالكُتبِ اللُبابا",12,"ب",2,0],["فَتَخَيَّر كُلَّ مَن شَب","بَ عَلى الصِدقِ وَشابا",13,"ب",2,0],["فَتْخَاءُ في الجوِّ خُدَارِيّةٌ","كالغَيْمِ والغَيْمُ لها مُثْقِلُ",14,"ل",1,0],["فَتَخالُهُ وَتَخالُهُنَّ إِزاءَهُ","مَلِكاً تَدينُ لَهُ المُلوكُ مُمَثَّلا",15,"ل",2,0],["فَتُخطِئُ في الغِناءِ عَلى المُغَنّي","وَتُخطِئُ في النِدامِ عَلى النَديمِ",16,"م",1,0],["فَتَخالَفَ الأَهواءَ فيما بَينَنا","وَالمَوتُ عِندَ تَخالُفِ الأَهواءِ",17,"ا",2,0],["فَتَخَيَّرتُ ما أَقولُ وَأُهدي","نَحوَ تِلكَ الأَخلاقِ وَالأَلطافِ",18,"ف",1,0],["فتخافُ أذمارُ الكريهةِ فتكَهُ","خَوْفَ البُغاثِ من العُقابِ الكاسِرِ",19,"ر",1,0],["فتخرجُ من قعرها لؤلؤاً","يُنَظّمُ للكأسِ فوقَ التريبِ",20,"ب",1,0],["فَتَخالِهُنَّ كَرَوضَةٍ في لُجَّةٍ","وَكَأَنَّما يَصفِرنَ مِن قَصَباتِ",21,"ت",1,0],["فتَخرُقُ جَيبَ المُزْن والمُزْنُ دالِحٌ","وتُوقِدُ موجَ اليَمِّ واليَمُّ أسفَع",22,"ع",1,0],["فَتَخصِمُني فَأَسكُتُ لا","أُحيرُ القَولَ كَالحَجَرِ",23,"ر",1,0],["فَتُخَضِّبَ الأمواجَ والآفاقَ","والجَبَل الخَصيبْ",24,"ب",1,0],["فَتَخِفَّ فِي أَكْبَادِنَا شُعَلُ الأَسَى","وَتَكُفَّ عَنْ خَدِّ الخُدُود الأَدْمُعُ",25,"ع",1,0],["فتخيرته، وكان شافعه","لطف الغزال وقوة الأسد",26,"د",1,0],["فتخالهُ -إن قال شعرًا- أحمدًا","وتخالُهُ عند الخطابة حيدَرا",27,"ر",2,0],["فتخلص محمديا من ال","علة واشطح على رؤوس العباد",28,"د",1,0],["فتخبره : أن دنياه ريح ... ودرّامة ، من طيوف السهاد","ضجيج فراغ ، يلوك صداه ... ويوهم شدقيه ، بالازدراد",29,"د",1,0],["فتختال في صدره موجة","من الفجر تهوى المدى الأبعدا",30,"د",2,0],["فتخضرّ عافية الفن فيه","وأوجاعه وحدهنّ الصحيحه",31,"ح",2,0],["فتخلّي عن الجنوب وخلّي","\" كمران \" المصون حرّ البنود",32,"د",1,0],["فَتخَالُ حامِلَ آيهِ مَحْمُولا","ثَكْلى ومُوجَعَة ٍ تُصِيبُ عَوِيلا",33,"ل",2,0],["فتخلّعي نجدِ الفُهومَ عَوارِياً","وتَبَسمي نجد الفُنونَ نضائدا",34,"د",2,0],["فتخالُ الضياءَ والماءُ موجٌ","في رواحٍ من جانبٍ ومجي",35,"ي",1,0],["فتُخطِىءُ في الغِناءِ على المُغَنّي،","وَتُخطىءُ في النِّدامِ على النّدِيمِ",36,"م",1,0],["فتخيَّرْ من اثنتيْنِ ولا يُغْ","لِق عليكَ المذاهبَ استغلافُك",37,"ك",1,0],["فتخبره : أن دنياه ريح","ودرّامة ، من طيوف السهاد",38,"د",1,0],["فتخاله بسرور نفسك إذ تسر","وتظنه حذراً تخافُهُ ضيغما",39,"م",2,0],["فتخاذلت رجلاي وارتعدت يدي","وأشل قول فؤاد مات أشاجعي",40,"ع",2,0],["فَتَخرَى وتَعيَا بَعدَمَا كُنتَ تَدَّعِى","وتُصبِحَ نَهباً لِلمَرَابِر والدَّوَا",41,"و",2,0],["فَتَخُصَّ مَن أَثنى فَطالَ لِسانُهُ","وَتَعُمَّ مَن بِضَميرِهِ ناجاكا",42,"ك",2,0],["فتخاله من رعده في برقه","متبسماً حيناً وحيناً معولا",43,"ل",2,0],["فتخيَّرْتُ لَها التَّشْ","بيهَ في المَعنَى المُصيبِ",44,"ب",1,0],["فتخزيهم أقلامهم في حياتهم","وتخزى إذا ماتوا وراءهم النسلا",45,"ل",2,0],["فَتُخبِرَكِ العَينَانِ عَن قَلبيَ الَّذِى","مَلِلتُ به لا كالقُلوبِ الصَّحائحِ",46,"ح",1,0],["فتخالُه مَلَكا رمى بشهابه","في الرَّوع شيطانَ الحروب فشاطا",47,"ط",2,0],["فَتخلصُ مِن صُروفِ زَمانِ سُوءٍ","خَلاصَ السَيفِ حودث بِالصِقالِ",48,"ل",1,0],["فتخالنا فوق الرمال ونحن في","سكر الغرام يثينةً وجميلا",49,"ل",2,0],["فَتَخَيَّرتُ قُبْلَةَ النْ","نورِ من ذلِك الحلك",50,"ك",1,0],["فَتِخالُ جانيهِ إِلَي","هِ بِذَنبِهِ مُتَقَرِّبا",51,"ب",2,0],["فَتَخَلَّصَتْ بِسَنَاهُ إِذْ لَبَّاهَا","كَالشَّمْسِ إِشْرَاقُ الضًُّحَى جَلاَّهَا",52,"ا",3,0],["فَتخال القرطاسَ صفحةَ خدٍّ","وتخالُ المِدادَ فيه عِذارا",53,"ر",2,0],["فَتُخرِسُ مَنطِقي وتَحُولُ بَيني","وبَينَ كَلامِهِم مِمَّا تُوَالي",54,"ل",2,0],["فتخير ما حلا من","ها مراع للكتاب",55,"ب",1,0],["فتخيَّرت عزَّ القَنوع وأَنشدَت","دَعني فَلَيسَ الذلُّ ضَربةَ لازِبِ",56,"ب",1,0],["فتخذتُ الهمّ كأسي","ولياليّ الندامى",57,"م",2,0],["فتَخالُها بحُجولها مشكولةً","وتَظُنُّه بحُسامِه مَغْلولا",58,"ل",2,0],["فتُخلِّص من يَدَيهِ خائِفاً","خافَ أَن يُحضِرَهُ بينَ يَدَيك",59,"ك",1,0],["فتخالُه متقلِّباً","من كفِّ حامله مبادِر",60,"ر",1,0],["فتخضُّر روضات العلوم ونجتني","ثمار الهدى والحق من روضها الوردي",61,"د",2,0],["فَتَختال البُيوت مِنها بروجاً","وَالمَعاني أَهِلَّةً وَشُموسا",62,"س",2,0],["فتخليت عنك عجزا ولو أغ","نى دفاعي لطال عنك الدفاع",63,"ع",1,0],["فتخال البيض لها جنحا","والسمر بكفيها الخضب",64,"ب",1,0],["فَتَخَيَّرَ الرحمنُ طِيبَ ثَراهُمُ","داراً وقبراً للنَّبيِّ المُرْسَلِ",65,"ل",1,0],["فَتُخْلِقُ بالإِرْقَالِ ثَوْبَ شَبابِهِ","وتَتْرُكُهُ بالأُفْقِ أَشيَبَ أَجْلَها",66,"ل",3,0],["فتخال فيه الوردَ خالطَ نَرْجِساً","واللازورد مطرّزاً ببهار",67,"ر",1,0],["فتخالُها مثلَ السفائنِ في الضحى","تعلو وترسبُ في بحارِ الآلِ",68,"ل",1,0],["فتخطي فوقفة فتدنّي","فكلام فموعد فلقاء",69,"ا",2,0],["فتخالها فوق الموا","طي بين أرجلنا شراك",70,"ك",1,0],["فتخيّر ربّاً أوِ اثنينِ واعبُدْ","فإذا لمْ تفعلْ فأنتَ الغشُومُ",71,"م",1,0],["فتخلّقوا في خُلقِه فتخلّقوا","بدمِ الأسودِ وأنفُسِ الأبطالِ",72,"ل",1,0],["فَتَخالَسا سلبَ النفوسِ كِلاهما","وَسط المجالِ مجالدٌ ومقاتلُ",73,"ل",1,0],["فَتُخبِرنا الشَمالُ إِذا أَتَتنا","وَتُخبِر أَهلَنا عَنّا الجَنُوبُ",74,"ب",1,0]]}