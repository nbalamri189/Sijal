//www.poetsgate.com/ViewPoem.aspx?id=203088",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[242,"لي في هوى المحبوب اعظم نشوة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563720",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""],[6259,"أوقد البين في الخميس خميسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59386&r=&rc=34",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""],[6359,"المجلس الطاريء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69093&r=&rc=7",""]],"verses":[["فَتْخُ الْقَواَدِمِ لِلْفَنَا قَدْ أَبْرَمَتْ","أَمْراً بِهَا كَفُّ الْقَضَاءِ الْمُبْرِمِ",0,"م",1,0],["فَتَخَالُهُمْ جَزَراً عَلَى صَهَوَاتِهَا","وَتَخَالُهَا مِنْ تَحْتِهِمْ أَوْضَامَا",1,"م",2,0],["فَتُخَبرَ أَنَّ عيصَ بَني عَديٍّ","تَفَرَّعَ نَبتُهُ الحَسَبَ النُضارا",2,"ر",2,0],["فتخصني منه بأوفر قسمة","فَسَحَتْ لعبدك في الرضى ميدانا",3,"ن",2,0],["فتخالها وتخاله كفريسةٍ","سقطت فزمجر دونها الضرغام",4,"م",1,0],["فَتَخالُهُ حَسّانَ إِذ حَرَّبتَهُ","فَدَعِ الفَضاءَ إِلى مَضيقِكَ وَاِفسَحِ",5,"ح",1,0],["فتخيَّرْ من اثنتيْن ولا يُغْ","لِق عليكَ المذاهبَ استغلاقُك",6,"ك",1,0],["فَتَخالَسا نَفسَيهِما بِنَوافِذٍ","كَنَوافِذِ العُبُطِ الَّتي لا تُرقَعُ",7,"ع",1,0],["فَتَخَطَّفَ الكأسَ الخلوبَ","وحطَّمَ الجامَ الثَّمينْ",8,"ن",1,0],["فَتَخْفُقُ فيه أَغاني الورودِ","ويخضرُّ فِرْدَوْسُ نفسي الحَصيدْ",9,"د",1,0],["فتخطو أَناشيدُ قلبيَ سَكْرى","تغرِّدُ تَحْتَ ظِلالِ القَمَرْ",10,"ر",1,0],["فتخمد أنفاس وتيبس أوجه","لنا يبس أزهار بألوانها تسبى",11,"ب",2,0],["فَتَخَيَّرها كَما تَختارُهُ","وَاِدَّخِر في الصَحبِ وَالكُتبِ اللُبابا",12,"ب",2,0],["فَتَخَيَّر كُلَّ مَن شَب","بَ عَلى الصِدقِ وَشابا",13,"ب",2,0],["فَتْخَاءُ في الجوِّ خُدَارِيّةٌ","كالغَيْمِ والغَيْمُ لها مُثْقِلُ",14,"ل",1,0],["فَتَخالُهُ وَتَخالُهُنَّ إِزاءَهُ","مَلِكاً تَدينُ لَهُ المُلوكُ مُمَثَّلا",15,"ل",2,0],["فَتُخطِئُ في الغِناءِ عَلى المُغَنّي","وَتُخطِئُ في النِدامِ عَلى النَديمِ",16,"م",1,0],["فَتَخالَفَ الأَهواءَ فيما بَينَنا","وَالمَوتُ عِندَ تَخالُفِ الأَهواءِ",17,"ا",2,0],["فَتَخَيَّرتُ ما أَقولُ وَأُهدي","نَحوَ تِلكَ الأَخلاقِ وَالأَلطافِ",18,"ف",1,0],["فتخافُ أذمارُ الكريهةِ فتكَهُ","خَوْفَ البُغاثِ من العُقابِ الكاسِرِ",19,"ر",1,0],["فتخرجُ من قعرها لؤلؤاً","يُنَظّمُ للكأسِ فوقَ التريبِ",20,"ب",1,0],["فَتَخالِهُنَّ كَرَوضَةٍ في لُجَّةٍ","وَكَأَنَّما يَصفِرنَ مِن قَصَباتِ",21,"ت",1,0],["فتَخرُقُ جَيبَ المُزْن والمُزْنُ دالِحٌ","وتُوقِدُ موجَ اليَمِّ واليَمُّ أسفَع",22,"ع",1,0],["فَتَخصِمُني فَأَسكُتُ لا","أُحيرُ القَولَ كَالحَجَرِ",23,"ر",1,0],["فَتُخَضِّبَ الأمواجَ والآفاقَ","والجَبَل الخَصيبْ",24,"ب",1,0],["فَتَخِفَّ فِي أَكْبَادِنَا شُعَلُ الأَسَى","وَتَكُفَّ عَنْ خَدِّ الخُدُود الأَدْمُعُ",25,"ع",1,0],["فتخيرته، وكان شافعه","لطف الغزال وقوة الأسد",26,"د",1,0],["فتخالهُ -إن قال شعرًا- أحمدًا","وتخالُهُ عند الخطابة حيدَرا",27,"ر",2,0],["فتخلص محمديا من ال","علة واشطح على رؤوس العباد",28,"د",1,0],["فتخبره : أن دنياه ريح ... ودرّامة ، من طيوف السهاد","ضجيج فراغ ، يلوك صداه ... ويوهم شدقيه ، بالازدراد",29,"د",1,0],["فتختال في صدره موجة","من الفجر تهوى المدى الأبعدا",30,"د",2,0],["فتخضرّ عافية الفن فيه","وأوجاعه وحدهنّ الصحيحه",31,"ح",2,0],["فتخلّي عن الجنوب وخلّي","\" كمران \" المصون حرّ البنود",32,"د",1,0],["فَتخَالُ حامِلَ آيهِ مَحْمُولا","ثَكْلى ومُوجَعَة ٍ تُصِيبُ عَوِيلا",33,"ل",2,0],["فتخلّعي نجدِ الفُهومَ عَوارِياً","وتَبَسمي نجد الفُن