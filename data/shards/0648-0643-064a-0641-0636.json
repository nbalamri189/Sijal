{"poems":[[63,"سر سرك الله فيما أنت منتظر","https://www.aldiwan.net/poem51675.html","البسيط"],[435,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[463,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64775","البسيط"],[5720,"رِحْلةُ الذَّات","https://www.poetsgate.com/ViewPoem.aspx?id=203389",""]],"verses":[["وكيفَض يَبعُدُ أمرٌ أنتَ طالبُه","واللهُ طالبُه والبدوُ والحَضَرُُ",0,"ر",1,0],["وكيف ضمّ عباباً زاخراً كرماً","وكوكباً في سماء المجد سيّارا",1,"ر",2,0],["وكيفَ ضمُّوا أمرَهم واجتمعوا","فاستوزروا الرأيَ وأنتَ منعزلْ",2,"ل",1,0],["وكيف ضمنت عن قلمي وقلبي","سداداً لم تخفْ دَرَك اختلالِ",3,"ل",1,0],["وكيف ضاقت على الأهلين تربتُهُ","وللأجانب من جنبيه مضطجَعُ",4,"ع",1,0],["وكيف ضلّ بأيدي الحادثات فتىً","مُعطي النّجاةِ وهادي كلّ ضلّالِ",5,"ل",1,0],["وكيفَ ضيّعتُمُ عَهْداً حَفِظْتُ لهُ","ودائعَ الحبِّ في جَهْدٍ وإِسْرارِ",6,"ر",1,0],["وَكَيْفَ ضَاعَ فُؤَادِي عِنْدَ فَاتِنَةٍ","فِيْ عَيْنِهَا الصُّبْحُ يَجْرِيْ خَلْفهَا تَبَعَا",7,"ع",2,0]]}