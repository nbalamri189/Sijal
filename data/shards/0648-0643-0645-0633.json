وافر"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[456,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[456,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[468,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[480,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[480,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[527,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[549,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[565,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[573,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[573,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[573,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[573,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[573,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"]],"verses":[["وَكَم سَرَقنا عَلى الأَيّامِ مِن قُبَلٍ","خَوفَ الرَقيبِ كَشُربِ الطائِرِ الوَجِلِ",0,"ل",1,0],["وَكَم سَعيُ ساعٍ جَرَّ حَتفاً لِنَفسِهِ","وَلَولا الخُطى ما شاكَ ذا الرَجلِ شائِكُ",1,"ك",1,0],["وَكَم سَخَطٍ أَمسى دَليلاً إِلى رِضىً","وَكَم خَطَإٍ أَضحى طَريقاً إِلى عَمدِ",2,"د",1,0],["وَكَم سِلمٍ وَإِن غَرَّال","عِدى أَدمى مِنَ الحَربِ",3,"ب",1,0],["وَكَمْ سَاعَةٍ شَافَهْتُ فِي مَوْقِفِ النَّوَى","تُقَبِّحُ وَجْهَ الصَّبْرِ وَهْوَ جَمِيلُ",4,"ل",1,0],["وكمْ سِيقَ للقَبْرِ في خِرْقَةٍ","فَتىً مُلِئَتْ منْ كُساهُ التّخوتْ",5,"ت",1,0],["وَكَم ساعَةٍ بَينَ ساعِ الحَياةِ","سَقَتكَ المُرارَ بِكَأسِ الضَجَر",6,"ر",1,0],["وَكَم سَأَلوها لَثمَ أَذيالِكَ الَّتي","لَها فَوقَ أَجرامِ السَمَواتِ مَسحَبُ",7,"ب",1,0],["وَكَم سائِلٍ بِالغَيثِ عَنكَ أَجَبتَهُ","هُناكَ الأَيادي الشَفعُ وَالسُؤدَدُ الوِترُ",8,"ر",1,0],["وَكَم سائِلٍ بِالغَيبِ عَنكُم أَجَبتُهُ","هُناكَ الأَيادي الشَفعُ وَالسَودَدُ الوِترُ",9,"ر",1,0],["وَكَم ساعَدَ الأَعداءُ أَوَّلَ مُطمَعٍ","رَأَوكَ بِعُقباهُ أَحَقَّ وَأَسعَدا",10,"د",2,0],["وكم ساع لها بخطا ابن حرب","ليسعدها بما يغني ويجدي",11,"ي",1,0],["وكم سعى راجياً تخليص موطنه","والشعب كان لما يرجوه منتظرا",12,"ر",2,0],["وكم سقاها الغيثُ إذ هُمْ بها","من سَبَلٍ كالشهد لم يُقطَبِ",13,"ب",1,0],["وكم سمعنا رعدَهُ ناعراً","من طَرَبٍ فيها على مَطْربِ",13,"ب",1,0],["وكم سِّيئٍ يوماً سيقْفوه صالحٌ","وكم شامت يوماً سيقفوه حاسدُ",14,"د",1,0],["وكم ساور العقبانَ في اللؤم صرْفُه","وكم غاوصَ الحيتانَ في زاخر الحُوَمْ",15,"م",1,0],["وكَمْ سفُهَ الهجرانُ والحلمُ صامتٌ","وكم خَرُقَ الإقصار والجودُ كاظمُ",16,"م",1,0],["وَكَم سَقاني وَاللَيلُ مُعتكرٌ","في جامِد الماء ذائبَ الوَردِ",17,"د",1,0],["وَكَم سَهَرَت في رِضاكِ الجُفونُ","وَأَنتِ عَلى غَضَبٍ غافِيَه",18,"ي",2,0],["وَكَم سِحرٍ سَمِعنا مُنذُ حينٍ","تَضاءَلَ بَينَ أَعيُنِنا وَنادى",19,"د",2,0],["وكم سالمٍ من طعنهمْ وهو عُرضَةٌ","لرشقَةِ عينٍ أو لطعنِ بَنَان",20,"ن",1,0],["وَكَم سَهَرٍ في الهَوى هاجَهُ","صُدودُ الغَواني وَإِعراضُها",21,"ض",3,0],["وَكَم سُئِلتَ فَما أُلفيتَ ذا بَخلٍ","وَلا وَجَدنا عَطاءً مِنكَ مَمنونا",22,"ن",2,0],["وَكَم ساعٍ لِيُثري لَم يَنَلهُ","وَآخِرُ ما سَعى الخُلُقُ الثَراءَ",23,"ا",2,1],["وَكَم سِرتُ إِثرَ الظاعِنينَ مُصَيِّراً","هَوايَ دَليلاً وَالتَذَكَّرَ حادِيا",24,"ي",2,0],["وكم سيّئاتٍ أُحْصِيَتْ فنسيتَها","وأنتَ متى تقرأ كتابَكَ تذْكرْها",25,"ر",3,0],["وكمْ سهرتْ عيني عليكمْ ونمتمُ","ورمتُ بكمْ عزِّي فصادفتُ زلّتي",26,"ي",1,1],["وكم سريٍّ بحره زاخرٌ","وكم فضيلٍ فازَ بالفضلِ",27,"ل",1,0],["وَكَم ساجَلَت فيها البِحارَ يَمينُهُ","وَكَم جانَسَت فيها الرِياضَ شَمائِلُه",28,"ل",2,0],["وَكَم سُئِلَ المِسواكُ عَن ذَلِكَ مَلولٍ","فَأَخبَرَ أَنَّ الريقَ قَد عَطَّلَ الشَهدا",29,"د",2,0],["وَكَم سِوى ذاكَ وَهَذاكَ وَذا","أَبادَهُم حَتفاً وَقَتلاً هَكَذا",30,"ذ",2,0],["وكم سُتِرَتْ لِلْحُسْنِ بالحَلْيِ مِنْ حُلىً","وكم جَسَدٍ غَطَّى مَحَاسِنَهُ البُرْدُ",31,"د",1,0],["وكَمْ سَعِدَتْ بالطالِعِ السَّعْدِ أُمَّةٌ","وكَمْ شَقِيَتْ بالطَّالعِ النَّحْسِ مَعْشَرُ",32,"ر",1,0],["وَكَم ساعٍ لِيُحبَرَ في بِناءٍ","فَلَم يُرزَق بِما يَبنيهِ حَبرا",33,"ر",2,0],["وَكَم سَليلٍ رَجاهُ لِلجَمالِ أَبٌ","فَكانَ خَزياً بِأَعلى هَضبَةٍ رُفِعا",34,"ع",2,0],["وَكَم سَحابَةِ قَومٍ غَرَّ لامِعُها","وَإِن دَعَتكَ بِإِرعادٍ وَإِبراقِ",35,"ق",1,0],["وَكَم سَرَحَ الخَليطُ لَهُم سَواماً","فَما نَفَعَ القَبائِلَ مِن قِبالِ",36,"ل",1,0],["وَكَم سَحَتَت كَفّاهُ مِثلَكِ في ضُحى","شَبيبَتِها إِذ لَم تَرَ الدَهرَ مُهرَما",37,"م",2,0],["وَكَم سَرَوا عالَماً أَوَّلاً","وَما سَرُوا فَمَتى يَسرُوانِ",38,"ن",1,0],["وَكَم سَرَتِ الرِفاقُ إِلى صَلاحٍ","فَمارَسَتِ الشَدائِدَ في سُراها",39,"ا",3,0],["وكَمْ سُرُورٍ هَمَى علَيْنَا","سحابةً ثرّةً تجُودُ",40,"د",1,0],["وكم سألْنا وفي الأفْواهِ جَابتُنا","وفي السؤالِ عَزاءٌ للمشوقينا",41,"ن",2,0],["وكم سَرابٍ بعيدٍ راح يخدَعُنا","فقلت حتى هُنا نلقى المُرائينا",41,"ن",2,0],["وكم سائرٍ سارها خُطوةً","فلمَّا تخطَّى سواها عثر",42,"ر",1,0],["وكم سلِمتْ أجسامهم، فتمارضوا","وراغوا من الأعمال روْغَ الثعالب",43,"ب",1,0],["وكم سِيىء يوماً سيقْفوه صالحٌ","وكم شامت يوماً سيقفوه حاسدُ",44,"د",1,0],["وكم سجت بدمعي","لما رأيت ابتسامك",45,"ك",1,0],["وكَم سَلَبتِ لَبِيباً لُبَّهُ وَلَهاً","حتى غَدَا كَلِفاً في لَوعَةٍ وعَنَا",46,"ن",2,0],["وكَم سَهِرُوا بِإنشَادِ القَوافي","وكَأسَاتٍ كَلَونِ دَمِ الغَزَالِ",47,"ل",1,0],["وكَم سَقِيمٍ أتَاهُ لاَ حَرَاكَ لَهُ","عَانَى يُيَمِّمُهُ الدَّيمُومَةَ القُذُفَا",48,"ف",2,0],["وكَم سَقَوا الحَمِيمَ الوِدَّ صِرفاً","وكَم سَقَوُا العِدَى سُمَّ الأَفَاعِى",49,"ع",2,0],["وكم سبقته للسودانَ ناسٌ","وما فعلوا سوى زجرِ البغالِ",50,"ل",1,0],["وكم سرى ليَ ما بين الورى أدبٌ","سناهُ يلحظهُ الأعمى وينظرهُ",51,"ر",2,0],["وَكَم سَعَيتَ لِحَظٍّ كُنتَ تَلحَظُهُ","فَذادَكَ الجِدُّ حَظّاً غَيرَ مُرتَقَبِ",52,"ب",1,0],["وكم سكبا لأجلك من دموع","يورّد هاجفون كالجراح",53,"ح",1,0],["وَكَم سَقاني مِن كَأسٍ عَلى ظَمَأٍ","أَمَرَّ في الطَعمِ مِن صابٍ وَمِن سَلَعِ",54,"ع",1,0],["وَكَم سَيِّدٍ في مالِكٍ ذِي نَباهَةٍ","إِذا فَقَدَتهُ الحَربُ طالَ أَيامُها",55,"م",3,0],["وكم سببٍ تَوجَّه ثم تأتِي","عوائقُ ما ألمَّ بها الحساب",56,"ب",1,0],["وكم سلمتُ للأٌقدارِ لكنْ","جِبِلَّةُ كلِّ مَنْ نُكِب اكتئاب",56,"ب",1,0],["وكم سوءة للمرء فيها تذلّه","بدفع أذى مأكولها ومقاتها",57,"ت",3,0],["وكم سقى قبلهم كأس الردى امما","حتى لقد راح كل منهم ثملا",58,"ل",2,0],["وكم سائل عن وصف من أسس العلا","ومن قد علا عن وصفه كيف يوصف",59,"ف",1,1],["وَكم سَقَتني المرَّ أختٌ لها","فَرُحتُ أَشكوها إلى التالِيَه",60,"ي",2,0],["وكم سبقتَهُمُ للمجد إذ فَتَروا","وكم هَدَيْتَهُمُ للحقّ إذ جهلوا",61,"ل",3,0],["وكم سِرتُ لا أبغي سواي مشيِّعا","لقلبي ولا عزمي بغيريّ يشتدّ",62,"د",1,0],["وَكَم سَيَّرَت مَدحَ المُلوكِ وَأَوجَبَت","حُقوقاً عَلى الأَجوادِ وَالكُرَماءِ",63,"ا",2,0],["وَكَم سَقَيتَ العَوالي مِن طُلى مَلِكٍ","وَكَم قَرَيتَ العَوافي مِن قَرا بَطل",64,"ل",1,0],["وكم سرني فيها المنى بحديثه","وأغصب عيني در ما سمعت أذني",65,"ن",2,0],["وكَمْ سَيِّدٍ منْهُم يُطاعُ احْتكامُه","عَهدناهُ عَبْداً لِلْعَبِيدِ بِها قِنَّا",66,"ن",2,0],["وكَمْ سُؤدَدٍ فينا تَرَدَّدَ مَحضُه","ومَجْدٍ أَبَى إبلاءَ جِدّتِهِ الدَّهْرُ",67,"ر",1,0],["وَكَمْ سُكّانِ دُنْياً لَوْ أَفاقُوا","لَما سَكَنَتْ قُلُوبُهُمُ الصُّدُورا",68,"ر",2,0],["وَكَمْ سَيْلٍ ثَنَيْتَ بِها وَمَيْلٍ","أَقَمْتَ فَلَمْ تَدَعْ فِيهِ اعْوِجاجا",69,"ج",2,0],["وَكَم سَمَكٍ فيهِ عَلَيهِ جَواشِنٌ","مِنَ التِّبرِ صيغَت وَهوَ بادي المَقاتِلِ",70,"ل",1,0],["وَكَم سُكرٍ لَنا مِن لَح","ظِها ناهيكَ مِن سُكرِ",71,"ر",1,0],["وكم ساقَ في الظلماء والنجم شاهدٌ","رواحل واطٍ في الرواح لواطا",72,"ط",2,0],["وكم ساقٍ يغص به","وهذا منيةُ الناسِ",73,"س",1,0],["وكم سهو وكم لهو وهزل","وكم ميل إلى دار الزوال",74,"ل",1,0],["وكم سالك كم ناسك متعبد","وكم مخلص في غيبه والشهادة",75,"ه",1,0],["وكم سقم عافى وكم معتد كفى","ورد بسعي خائب غير ظافر",76,"ر",1,0],["وَكَم سبلٍ رَكِبتَ بها جياداً","يودُّ لها الهلالُ يكونُ نَعلا",77,"ل",2,0],["وَكم سامر التفكير لا يَمتلى كرى","وَكم ساير التدبير لا يَأتَلي حدبا",78,"ب",2,0],["وَكَم ساعٍ لِيُثري لَم يَنَلهُ","وَآخَرُ ما سَعى نالَ الثَراءِ",79,"ا",2,0],["وَكَمْ سَيِّدٍ يَستَوْجِبُ الرَّفعَ قَدْرُهُ","غَدا شَاكياً مِن لَحْنِ أَيَّامهِ خَفْضَا",80,"ض",2,1],["وَكَم سَلَكتُ رُبى الوَعساءِ مُجتَهِداً","عَلَيَّ أُرَوّي صَدى قَلبي بِرَيّاكِ",81,"ك",1,0],["وَكَم سَوط لَهُ صَوت عَليه","وَندب في الأَصائل وَالبُكورِ",82,"ر",1,0],["وَكَم سالَ دَمع مِن جُفون قَريحة","فَرُدَّ بلوعات الحَشا وَهوَ جامدُ",83,"د",1,0],["وكم سألتُ الحيا سُقْيا منازِلهمْ","فقالتِ العيْنُ ما للأدمُعِ الهُمُل",84,"ل",1,0],["وكم سحَب السّحابُ الخَدَّ حتّى","تَعلّمَ من أناملَك انْهِمالا",85,"ل",2,0],["وكم سارَ لي من لَفْظةٍ هيَ دُرّةٌ","عُلاكَ لها تاجٌ وفكْري لها صَدَف",86,"ف",1,0],["وَكَم سُدَّ بابُ الرِزقِ عَنّي فَسُمتُها","أَنامِلَ لِلأَرزاقِ فيها مَفاتِحُ",87,"ح",1,0],["وَكَم سَدَّت خِلالكَ ه","ذِهِ في الثَّغرِ مِن خَلَلِ",88,"ل",1,0],["وكم سَحبوا من ثيابِ العُلى","ومن طَرزِها الفاخِر الفاخِرا",89,"ر",2,0],["وَكم سنةٍ حُذِّرتُها فَتَزحزَحت","بِخَيرٍ وَاِقبالٍ وَجدٍّ مصاحبِ",90,"ب",1,0],["وَكَم سرت في طُرقِ السلو فَلَم أَجِد","سَبيلاً وَضاقَت في هَواكِ المَقاصِدِ",91,"د",1,0],["وكم سَعَوْا بي فلَمْ أحفِل بسعْيِهِمُ","لكنْ ثِقاتُكُ ما زالوا بغشِّهِمُ",92,"م",1,0],["وكم سقَتْ الأعداءَ كأساً مريرةً","صوارمُ تَثْنيهِمْ صريماً ومُرّانُ",93,"ن",1,0],["وكم سوق حرب للأعادي أقمتهُ","وموت لهم ايظقته وهو حالم",94,"م",1,0],["وكم سُمْتُ أَوْراقَها فِي الرِّياحِ","لأَخْصِفَ فِيهَا لعارٍ سَليبِ",95,"ب",1,0],["وكم سَرَتِ الرِّفاقُ بِلا دَليلٍ","إِلَيْهِ والمطيُّ بلا حُدَاءِ",96,"ا",2,0],["وكم ساجِدٍ لله مِنَّا ورَاكِعٍ","يَبيتُ عَلَى شَفْعٍ ويَغْدُو عَلَى وَتْرِ",97,"ر",1,0],["وكم سَبقتَ إِليها واحتوَيتَ لَهَا","مَدىً جَعلتَ إِليها الصِّدْقَ ميدانا",98,"ن",2,0],["وكم سال دمعي لحال تزو","لُ وهو على فقدها سائلُ",99,"ل",1,0],["وكم سابقٍ فيهم ولم يَحْفَ رُسغُهُ","ولا ابتلَّ في شَوطِ الرِّهانِ سبيبُهُ",100,"ب",2,0],["وكم سواك لم يجُزْ حِسابُهُ","أعدادَ ما تُملى عليه الحُسَّبُ",101,"ب",1,0],["وكم سلكت بي والغرام تنوفةٌ","تضل كما شاءَ الهوى سلوةٌ تهدي",102,"د",2,0],["وَكَم سائِلٍ أُمنِيَّةً لَو يَنالُها","لَظَلَّ بِسوءِ القَولِ في القَومِ يَقنَعُ",103,"ع",1,0],["وكم سهرت جفن الكئيب ترقبا","لطيف خيال الحسن من فرط حيرة",104,"ه",1,0],["وكم سهرت منا الجفون وما لها","مذاق لطعم النوم في جنب طاعتي",105,"ت",2,0],["وكم سهرت على ود النوافح في","صيد الظباء عليها الروح تنفتق",106,"ق",1,0],["وَكَمْ سَحَبَتْ عَلَى سَحْبانَ ذَيْلاً","ونَغّصَ ما حَوَتْهُ عَلَى ابنِ هَانِي",107,"ي",1,0],["وكَمْ سَدّوا إذا سَمِعوا حَديثاً","لِخَيْرِ الرُّسْلِ أثْقابَ الأَذانِ",107,"ن",1,0],["وَكَم سَيِّدٍ لَهُمُ في اللِقا","ءِ غودِرَ في صِرَّةِ يَسعُلُ",108,"ل",1,0],["وكم ساءَكمْ نفعي ولم يك منكُمُ","وسرَّكُمُ ما قيَّض الدّهرُ من ضَرِّي",109,"ي",1,0],["وكم سليبِ رماحٍ غير مستترٍ","وكم صريعِ حمامٍ غيرِ ملحودِ",110,"د",1,0],["وكم سطا فيهمْ بأُسْدِ الشّرى","ومُطعمِي الأضيافِ في الجَدْبِ",111,"ب",1,0],["وَكَم سَلَبٍ أجرى الدّماء جفوننا","وَلَم تَجنِهِ فينا يمينٌ لغاصِبِ",112,"ب",1,0],["وَكَم سَقاني الطَّرْقَ الأُجاج فجا","زيتُ زُلالاً تخاله ضَرَبا",113,"ب",2,0],["وَكَمْ سَنَنْتُ رُسُومَاً غَيْرَ مُشْكِلَةٍ","كَانَتْ لِمَنْ أَمَّهَا مُسْتَرْشِدَاً قِبْلَهْ",114,"ل",2,0],["وكم سائلٍ لي قَدْ مَضى وَهْوَ قائِلٌ","فِداك بخيلٌ ندَّ عن كَفِّه النَّدى",115,"د",2,0],["وكم سبَتْني بِلا حَرْبٍ وكم فَتَنتْ","إِنْسَانَ عَيْنيَ فيها عينُ إِنْسَان",116,"ن",1,0],["وكم سِيقَ من نُعمى إِليَّ ونعمةٍ","وكم قيل لي أَهلاً وسهلاً ومَرْحَبَا",117,"ب",2,0],["وكَمْ سرَّني دَهْرِي بِه ثُمَّ ساءَني","ونَعَّمني دهراً به ثم أَشْقَاني",118,"ي",1,0],["وكَمْ سَائِلٍ قَدْ قَال هل هي روضةُ","فقلتُ وَعِقْدُ الدُّرِّ في جيدِها النَّهْرُ",119,"ر",1,0]]}