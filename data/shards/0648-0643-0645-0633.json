,"https://www.poetsgate.com/ViewPoem.aspx?id=200762",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5943,"نزعنا السَّرجَ","https://www.poetsgate.com/ViewPoem.aspx?id=11091",""],[5943,"العين إن خاصمت","https://www.poetsgate.com/ViewPoem.aspx?id=20470",""],[5957,"لماذا عدتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=55378",""],[5957,"الرحيل الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179589",""],[5973,"هل تسمعين أنين الروح جومانا","https://www.poetsgate.com/ViewPoem.aspx?id=14048",""],[6071,"وكم سهم بغيٍ لم أخف أن يصيبني","https://www.poetsgate.com/ViewPoem.aspx?id=187188",""],[6093,"سفيرنا القدوة","https://www.poetsgate.com/ViewPoem.aspx?id=188406",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[240,"أُبِثُّكَ مَجْدَ کلدِّينِ حَالاً سَمَاعُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26475&r=&rc=0",""]],"verses":[["وَكَم سَرَقنا عَلى الأَيّامِ مِن قُبَلٍ","خَوفَ الرَقيبِ كَشُربِ الطائِرِ الوَجِلِ",0,"ل",1,0],["وَكَم سَعيُ ساعٍ جَرَّ حَتفاً لِنَفسِهِ","وَلَولا الخُطى ما شاكَ ذا الرَجلِ شائِكُ",1,"ك",1,0],["وَكَم سَخَطٍ أَمسى دَليلاً إِلى رِضىً","وَكَم خَطَإٍ أَضحى طَريقاً إِلى عَمدِ",2,"د",1,0],["وَكَم سِلمٍ وَإِن غَرَّال","عِدى أَدمى مِنَ الحَربِ",3,"ب",1,0],["وَكَمْ سَاعَةٍ شَافَهْتُ فِي مَوْقِفِ النَّوَى","تُقَبِّحُ وَجْهَ الصَّبْرِ وَهْوَ جَمِيلُ",4,"ل",1,0],["وكمْ سِيقَ للقَبْرِ في خِرْقَةٍ","فَتىً مُلِئَتْ منْ كُساهُ التّخوتْ",5,"ت",1,0],["وَكَم ساعَةٍ بَينَ ساعِ الحَياةِ","سَقَتكَ المُرارَ بِكَأسِ الضَجَر",6,"ر",1,0],["وَكَم سَأَلوها لَثمَ أَذيالِكَ الَّتي","لَها فَوقَ أَجرامِ السَمَواتِ مَسحَبُ",7,"ب",1,0],["وَكَم سائِلٍ بِالغَيثِ عَنكَ أَجَبتَهُ","هُناكَ الأَيادي الشَفعُ وَالسُؤدَدُ الوِترُ",8,"ر",1,0],["وَكَم سائِلٍ بِالغَيبِ عَنكُم أَجَبتُهُ","هُناكَ الأَيادي الشَفعُ وَالسَودَدُ الوِترُ",9,"ر",1,0],["وَكَم ساعَدَ الأَعداءُ أَوَّلَ مُطمَعٍ","رَأَوكَ بِعُقباهُ أَحَقَّ وَأَسعَدا",10,"د",2,0],["وكم ساع لها بخطا ابن حرب","ليسعدها بما يغني ويجدي",11,"ي",1,0],["وكم سعى راجياً تخليص موطنه","والشعب كان لما يرجوه منتظرا",12,"ر",2,0],["وكم سقاها الغيثُ إذ هُمْ بها","من سَبَلٍ كالشهد لم يُقطَبِ",13,"ب",1,0],["وكم سمعنا رعدَهُ ناعراً","من طَرَبٍ فيها على مَطْربِ",13,"ب",1,0],["وكم سِّيئٍ يوماً سيقْفوه صالحٌ","وكم شامت يوماً سيقفوه حاسدُ",14,"د",1,0],["وكم ساور العقبانَ في اللؤم صرْفُه","وكم غاوصَ الحيتانَ في زاخر الحُوَمْ",15,"م",1,0],["وكَمْ سفُهَ الهجرانُ والحلمُ صامتٌ","وكم خَرُقَ الإقصار والجودُ كاظمُ",16,"م",1,0],["وَكَم سَقاني وَاللَيلُ مُعتكرٌ","في جامِد الماء ذائبَ الوَردِ",17,"د",1,0],["وَكَم سَهَرَت في رِضاكِ الجُفونُ","وَأَنتِ عَلى غَضَبٍ غافِيَه",18,"ي",2,0],["وَكَم سِحرٍ سَمِعنا مُنذُ حينٍ","تَضاءَلَ بَينَ أَعيُنِنا وَنادى",19,"د",2,0],["وكم سالمٍ من طعنهمْ وهو عُرضَةٌ","لرشقَةِ عينٍ أو لطعنِ بَنَان",20,"ن",1,0],["وَكَم سَهَرٍ في الهَوى هاجَهُ","صُدودُ الغَواني وَإِعراضُها",21,"ض",3,0],["وَكَم سُئِلتَ فَما أُلفيتَ ذا بَخلٍ","وَلا وَجَدنا عَطاءً مِنكَ مَمنونا",22,"ن",2,0],["وَكَم ساعٍ لِيُثري لَم يَنَلهُ","وَآخِرُ ما سَعى الخُلُقُ الثَراءَ",23,"ا",2,1],["وَكَم سِرتُ إِثرَ الظاعِنينَ مُصَيِّراً","هَوايَ دَليلاً وَالتَذَكَّرَ حادِيا",24,"ي",2,0],["وكم سيّئاتٍ أُحْصِيَتْ فنسيتَها","وأنتَ متى تقرأ كتابَكَ تذْكرْها",25,"ر",3,0],["وكمْ سهرتْ عيني عليكمْ ونمتمُ","ورمتُ بكمْ عزِّي فصادفتُ زلّتي",26,"ي",1,1],["وكم سريٍّ بحره زاخرٌ","وكم فضيلٍ فازَ بالفضلِ",27,"ل",1,0],["وَكَم ساجَلَت فيها البِحارَ يَمينُهُ","وَكَم جانَسَت فيها الرِياضَ شَمائِلُه",28,"ل",2,0],["وَكَم سُئِلَ المِسواكُ عَن ذَلِكَ مَلولٍ","فَأَخبَرَ أَنَّ الريقَ قَد عَطَّلَ الشَهدا",29,"د",2,0],["وَكَم سِوى ذاكَ وَهَذاكَ وَذا","أَبادَهُم حَتفاً وَقَتلاً هَكَذا",30,"ذ",2,0],["وكم سُتِرَتْ لِلْحُسْنِ بالحَلْيِ مِنْ حُلىً","وكم جَسَدٍ غَطَّى مَحَاسِنَهُ البُرْدُ",31,"د",1,0],["وكَمْ سَعِدَتْ بالطالِعِ السَّعْدِ أُمَّةٌ","وكَمْ شَقِيَتْ بالطَّالعِ النَّحْسِ مَعْشَرُ",32,"ر",1,0],["وَكَم ساعٍ لِيُحبَرَ في بِناءٍ","فَلَم يُرزَق بِما يَبنيهِ حَبرا",33,"ر",2,0],["وَكَم سَليلٍ رَجاهُ لِلجَمالِ أَبٌ","فَكانَ خَزياً بِأَعلى هَضبَةٍ رُفِعا",34,"ع",2,0],["وَكَم سَحابَةِ قَومٍ غَرَّ لامِعُها","وَإِن دَعَتكَ بِإِرعادٍ وَإِبراقِ",35,"ق",1,0],["وَكَم سَرَحَ الخَليطُ لَهُم سَواماً","فَما نَفَعَ القَبائِلَ مِن قِبالِ",36,"ل",1,0],["وَكَم سَحَتَت كَفّاهُ مِثلَكِ في ضُحى","شَبيبَتِها إِذ لَم تَرَ الدَهرَ مُهرَما",37,"م",2,0],["وَكَم سَرَوا عالَماً أَوَّلاً","وَما سَرُوا فَمَتى يَسرُوانِ",38,"ن",1,0],["وَكَم سَرَتِ الرِفاقُ إِلى صَلاحٍ","فَمارَسَتِ الشَدائِدَ في سُراها",39,"ا",3,0],["وكَمْ سُرُورٍ هَمَى علَيْنَا","سحابةً ثرّةً تجُودُ",40,"د",1,0],["وكم سألْنا وفي الأفْواهِ جَابتُنا","وفي السؤالِ عَزاءٌ للمشوقينا",41,"ن",2,0],["وكم سَرابٍ بعيدٍ راح يخدَعُنا","فقلت حتى هُنا نلقى المُرائينا",41,"ن",2,0],["وكم سائرٍ سارها خُطوةً","فلمَّا تخطَّى سواها عثر",42,"ر",1,0],["وكم سلِمتْ أجسامهم، فتمارضوا","وراغوا من الأعمال روْغَ الثعالب",43,"ب",1,0],["وكم ساجلتني خيالاتها","كما ساجل المغرم المغرما",44,"م",2,0],["وكم سِيىء يوماً سيقْفوه صالحٌ","وكم شامت يوماً سيقفوه حاسدُ",45,"د",1,0],["وكم سجت بدمعي","لما رأيت ابتسامك",46,"ك",1,0],["وكَم سَلَبتِ لَبِيباً لُبَّهُ وَلَهاً","حتى غَدَا كَلِفاً في لَوعَةٍ وعَنَا",47,"ن",2,0],["وكَم سَهِرُوا بِإنشَادِ القَوافي","وكَأسَاتٍ كَلَونِ دَمِ الغَزَالِ",48,"ل",1,0],["وكَم سَقِيمٍ أتَاهُ لاَ حَرَاكَ لَهُ","عَانَى يُيَمِّمُهُ الدَّيمُومَةَ القُذُفَا",49,"ف",2,0],["وكَم سَقَوا الحَمِيمَ الوِدَّ صِرفاً","وكَم سَقَوُا العِدَى سُمَّ الأَفَاعِى",50,"ع",2,0],["وكم سبقته للسودانَ ناسٌ","وما فعلوا سوى زجرِ البغالِ",51,"ل",1,0],["وكم سرى ليَ ما بين الورى أدبٌ","سناهُ يلحظهُ الأعمى وينظرهُ",52,"ر",2,0],["وَكَم سَعَيتَ لِحَظٍّ كُنتَ تَلحَظُهُ","فَذادَكَ الجِدُّ حَظّاً غَيرَ مُرتَقَبِ",53,"ب",1,0],["وكم سكبا لأجلك من دموع","يورّد هاجفون كالجراح",54,"ح",1,0],["وَكَم سَقاني مِن كَأسٍ عَلى ظَمَأٍ","أَمَرَّ في الطَعمِ مِن صابٍ وَمِن سَلَعِ",55,"ع",1,0],["وَكَم سَيِّدٍ في مالِكٍ ذِي نَباهَةٍ","إِذا فَقَدَتهُ الحَربُ طالَ أَيامُها",56,"م",3,0],["وكم سببٍ تَوجَّه ثم تأتِي","عوائقُ ما ألمَّ بها الحساب",57,"ب",1,0],["وكم سلمتُ للأٌقدارِ لكنْ","جِبِلَّةُ كلِّ مَنْ نُكِب اكتئاب",57,"ب",1,0],["وكم سوءة للمرء فيها تذلّه","بدفع أذى مأكولها ومقاتها",58,"ت",3,0],["وكم سقى قبلهم كأس الردى امما","حتى لقد راح كل منهم ثملا",59,"ل",2,0],["وكم سائل عن وصف من أسس العلا","ومن قد علا عن وصفه كيف يوصف",60,"ف",1,1],["وَكم سَقَتني المرَّ أختٌ لها","فَرُحتُ أَشكوها إلى التالِيَه",61,"ي",2,0],["وكم سبقتَهُمُ للمجد إذ فَتَروا","وكم هَدَيْتَهُمُ للحقّ إذ جهلوا",62,"ل",3,0],["وكم سِرتُ لا أبغي سواي مشيِّعا","لقلبي ولا عزمي بغيريّ يشتدّ",63,"د",1,0],["وَكَم سَيَّرَت مَدحَ المُلوكِ وَأَوجَبَت","حُقوقاً عَلى الأَجوادِ وَالكُرَماءِ",64,"ا",2,0],["وَكَم سَقَيتَ العَوالي مِن طُلى مَلِكٍ","وَكَم قَرَيتَ العَوافي مِن قَرا بَطل",65,"ل",1,0],["وكم سرني فيها المنى بحديثه","وأغصب عيني در ما سمعت أذني",66,"ن",2,0],["وكَمْ سَيِّدٍ منْهُم يُطاعُ احْتكامُه","عَهدناهُ عَبْداً لِلْعَبِيدِ بِها قِنَّا",67,"ن",2,0],["وكَمْ سُؤدَدٍ فينا تَرَدَّدَ مَحضُه","ومَجْدٍ أَبَى إبلاءَ جِدّتِهِ الدَّهْرُ",68,"ر",1,0],["وَكَمْ سُكّانِ دُنْياً لَوْ أَفاقُوا","لَما سَكَنَتْ قُلُوبُهُمُ الصُّدُورا",69,"ر",2,0],["وَكَمْ سَيْلٍ ثَنَيْتَ بِها وَمَيْلٍ","أَقَمْتَ فَلَمْ تَدَعْ فِيهِ اعْوِجاجا",70,"ج",2,0],["وَكَم سَمَكٍ فيهِ عَلَيهِ جَواشِنٌ","مِنَ التِّبرِ صيغَت وَهوَ بادي المَقاتِلِ",71,"ل",1,0],["وَكَم سُكرٍ لَنا مِن لَح","ظِها ناهيكَ مِن سُكرِ",72,"ر",1,0],["وكم ساقَ في الظلماء والنجم شاهدٌ","رواحل واطٍ في الرواح لواطا",73,"ط",2,0],["وكم ساقٍ يغص به","وهذا منيةُ الناسِ",74,"س",1,0],["وكم سهو وكم لهو وهزل","وكم ميل إلى دار الزوال",75,"ل",1,0],["وكم سالك كم ناسك متعبد","وكم مخلص في غيبه والشهادة",76,"ه",1,0],["وكم سقم عافى وكم معتد كفى","ورد بسعي خائب غير ظافر",77,"ر",1,0],["وَكَم سبلٍ رَكِبتَ بها جياداً","يودُّ لها الهلالُ يكونُ نَعلا",78,"ل",2,0],["وَكم سامر التفكير لا يَمتلى كرى","وَكم ساير التدبير لا يَأتَلي حدبا",79,"ب",2,0],["وَكَم ساعٍ لِيُثري لَم يَنَلهُ","وَآخَرُ ما سَعى نالَ الثَراءِ",80,"ا",2,0],["وَكَمْ سَيِّدٍ يَستَوْجِبُ الرَّفعَ قَدْرُهُ","غَدا شَاكياً مِن لَحْنِ أَيَّامهِ خَفْضَا",81,"ض",2,1],["وَكَم سَلَكتُ رُبى الوَعساءِ مُجتَهِداً","عَلَيَّ أُرَوّي صَدى قَلبي بِرَيّاكِ",82,"ك",1,0],["وَكَم سَوط لَهُ صَوت عَليه","وَندب في الأَصائل وَالبُكورِ",83,"ر",1,0],["وَكَم سالَ دَمع مِن جُفون قَريحة","فَرُدَّ بلوعات الحَشا وَهوَ جامدُ",84,"د",1,0],["وكم سألتُ الحيا سُقْيا منازِلهمْ","فقالتِ العيْنُ ما للأدمُعِ الهُمُل",85,"ل",1,0],["وكم سحَب السّحابُ الخَدَّ حتّى","تَعلّمَ من أناملَك انْهِمالا",86,"ل",2,0],["وكم سارَ لي من لَفْظةٍ هيَ دُرّةٌ","عُلاكَ لها تاجٌ وفكْري لها صَدَف",87,"ف",1,0],["وَكَم سُدَّ بابُ الرِزقِ عَنّي فَسُمتُها","أَنامِلَ لِلأَرزاقِ فيها مَفاتِحُ",88,"ح",1,0],["وَكَم سَدَّت خِلالكَ ه","ذِهِ في الثَّغرِ مِن خَلَلِ",89,"ل",1,0],["وكم سَحبوا من ثيابِ العُلى","ومن طَرزِها الفاخِر الفاخِرا",90,"ر",2,0],["وَكم سنةٍ حُذِّرتُها فَتَزحزَحت","بِخَيرٍ وَاِقبالٍ وَجدٍّ مصاحبِ",91,"ب",1,0],["وَكَم سرت في طُرقِ السلو فَلَم أَجِد","سَبيلاً وَضاقَت في هَواكِ المَقاصِدِ",92,"د",1,0],["وكم سَعَوْا بي فلَمْ أحفِل بسعْيِهِمُ","لكنْ ثِقاتُكُ ما زالوا بغشِّهِمُ",93,"م",1,0],["وكم سقَتْ الأعداءَ كأساً مريرةً","صوارمُ تَثْنيهِمْ صريماً ومُرّانُ",94,"ن",1,0],["وكم سوق حرب للأعادي أقمتهُ","وموت لهم ايظقته وهو حالم",95,"م",1,0],["وكم سُمْتُ أَوْراقَها فِي الرِّياحِ","لأَخْصِفَ فِيهَا لعارٍ سَليبِ",96,"ب",1,0],["وكم سَرَتِ الرِّفاقُ بِلا دَليلٍ","إِلَيْهِ والمطيُّ بلا حُدَاءِ",97,"ا",2,0],["وكم ساجِدٍ لله مِنَّا ورَاكِعٍ","يَبيتُ عَلَى شَفْعٍ ويَغْدُو عَلَى وَتْرِ",98,"ر",1,0],["وكم سَبقتَ إِليها واحتوَيتَ لَهَا","مَدىً جَعلتَ إِليها الصِّدْقَ ميدانا",99,"ن",2,0],["وكم سال دمعي لحال تزو","لُ وهو على فقدها سائلُ",100,"ل",1,0],["وكم سابقٍ فيهم ولم يَحْفَ رُسغُهُ","ولا ابتلَّ في شَوطِ الرِّهانِ سبيبُهُ",101,"ب",2,0],["وكم سواك لم يجُزْ حِسابُهُ","أعدادَ ما تُملى عليه الحُسَّبُ",102,"ب",1,0],["وكم سلكت بي والغرام تنوفةٌ","تضل كما شاءَ الهوى سلوةٌ تهدي",103,"د",2,0],["وَكَم سائِلٍ أُمنِيَّةً لَو يَنالُها","لَظَلَّ بِسوءِ القَولِ في القَومِ يَقنَعُ",104,"ع",1,0],["وكم سهرت جفن الكئيب ترقبا","لطيف خيال الحسن من فرط حيرة",105,"ه",1,0],["وكم سهرت منا الجفون وما لها","مذاق لطعم النوم في جنب طاعتي",106,"ت",2,0],["وكم سهرت على ود النوافح في","صيد الظباء عليها الروح تنفتق",107,"ق",1,0],["وَكَمْ سَحَبَتْ عَلَى سَحْبانَ ذَيْلاً","ونَغّصَ ما حَوَتْهُ عَلَى ابنِ هَانِي",108,"ن",2,0],["وكَمْ سَدّوا إذا سَمِعوا حَديثاً","لِخَيْرِ الرُّسْلِ أثْقابَ الأَذانِ",108,"ن",1,0],["وَكَم سَيِّدٍ لَهُمُ في اللِقا","ءِ غودِرَ في صِرَّةِ يَسعُلُ",109,"ل",1,0],["وكم ساءَكمْ نفعي ولم يك منكُمُ","وسرَّكُمُ ما قيَّض الدّهرُ من ضَرِّي",110,"ر",2,0],["وكم سليبِ رماحٍ غير مستترٍ","وكم صريعِ حمامٍ غيرِ ملحودِ",111,"د",1,0],["وكم سطا فيهمْ بأُسْدِ الشّرى","ومُطعمِي الأضيافِ في الجَدْبِ",112,"ب",1,0],["وَكَم سَلَبٍ أجرى الدّماء جفوننا","وَلَم تَجنِهِ فينا يمينٌ لغاصِبِ",113,"ب",1,0],["وَكَم سَقاني الطَّرْقَ الأُجاج فجا","زيتُ زُلالاً تخاله ضَرَبا",114,"ب",2,0],["وَكَمْ سَنَنْتُ رُسُومَاً غَيْرَ مُشْكِلَةٍ","كَانَتْ لِمَنْ أَمَّهَا مُسْتَرْشِدَاً قِبْلَهْ",115,"ل",2,0],["وكم سائلٍ لي قَدْ مَضى وَهْوَ قائِلٌ","فِداك بخيلٌ ندَّ عن كَفِّه النَّدى",116,"د",2,0],["وكم سبَتْني بِلا حَرْبٍ وكم فَتَنتْ","إِنْسَانَ عَيْنيَ فيها عينُ إِنْسَان",117,"ن",1,0],["وكم سِيقَ من نُعمى إِليَّ ونعمةٍ","وكم قيل لي أَهلاً وسهلاً ومَرْحَبَا",118,"ب",2,0],["وكَمْ سرَّني دَهْرِي بِه ثُمَّ ساءَني","ونَعَّمني دهراً به ثم أَشْقَاني",119,"ن",2,0],["وكَمْ سَائِلٍ قَدْ قَال هل هي روضةُ","فقلتُ وَعِقْدُ الدُّرِّ في جيدِها النَّهْرُ",120,"ر",1,0],["وَكَم سَرَوةَ تَحتَ جُنحِ الظَلامِ","كَسَرَ بِصَدرِ الأَديبِ اِنكَتَم",121,"م",1,0],["وكَم سائلٍ مستَفهِم مِن حَذارِه","عليكَ أعبدَ اللهِ غاضَ أمِ البَحرُ",122,"ر",1,0],["وَكَم سَيِّدٍ لولاكَ عَمُّكَ عَمُّهُ","وَكَفُّكَ ذي مَوصُوَلةٌ في ذِراعِهِ",123,"ع",2,0],["وكم سقى راهباً من عز رهبتها","كأساً فأفردها مع كل منفرد",124,"د",1,0],["وكم سأل العواذل عن حديثي","فقلت لهم على العهد القديم",125,"م",1,0],["وكم سكة مستورة بمصائب","لغرٍّ رمى منها بخطب ونكبة",126,"ه",1,0],["وَكم سترت الهَوى كيما أُغالطه","فَدل سقمي عَلى ما في طوياتي",127,"ت",2,0],["وكم سار نظمي للملوك منادياً","وقومي في صدر المعالي لهم رصد",128,"د",1,0],["وكم سنة شهباء كادت لقحطها","لتقتات أهل اليسر فيها حمارها",129,"ر",3,0],["وكم ساويت بنيهمُ بنصحي","فلا الراضين هزّ ولا الغضابا",130,"ب",2,0],["وكم سَلَقَ العُذَّلُ سمعي بألْسُنٍ","حدادٍ فلم يَسْمَعْ لما قال سالقه",131,"ق",2,0],["وَكَم سَعى لي لسلا مِن فاس","وَمِن رِباطِ الفَتح مِن أُناسِ",132,"س",1,0],["وكم سجد العباد فيه وإنما","بهامته صدر النوائب يقرع",133,"ع",1,0],["وكم سبب جُبتُ لا أنثني","ولا أرعوي لعذول عذل",134,"ل",1,0],["وكم سعوا لطماح طالح وسدوا","لحاصل الحرص كالمرسالة السدم",135,"م",1,0],["وكم سهوا وسطوا عمداً وطحطحهم","معسكر السام والأرماس والسدم",135,"م",1,0],["وكم سرقت من سرى","وكم شرقت في السرى",136,"ر",2,0],["وكم سبقت منسماً","حب السنا بمنسمي",136,"ي",1,0],["وكم سحيق ساقني","وكم رشيق شاقني",136,"ي",1,0],["وكم سجرت من طغى","بشدتي لما بغى",136,"غ",2,0],["وكم سحرت من صغى","لوعظي المعظم",136,"م",1,0],["وكم سرور ولا كيوم به","قارن بدر الكمال برجاه",137,"ا",2,0],["وكم سدلت رداء التيه منتشيا","أمشي الهوينا وأثني نعطفا صلفا",138,"ف",2,0],["وكم سررت بوصل من أوانسه","ولم أخل أنه يستخلف الأسفا",138,"ف",2,0],["وَكم سحبت به ذيلَ الشبابِ وكم","جنيتُ غصنَ الهَوى فيهِ وغانيهِ",139,"ي",2,0],["وكم سمعنه يروي ما ما تَعَلّمه","حتى يعلمنا ما قد جهلناه",140,"ا",2,0],["وكم سامَ مِنِّي مُهْجَتي فأَطَعْتُهُ","وكم سُمْتُ قَلْبي تَرْكَهُ فعَصاني",141,"ن",2,0],["وكم ساءَني صَرْفُ الزَّمانِ فَسَرَّني","وكمْ راعَني كَيْدُ العِدا فَرَعاني",141,"ن",2,0],["وكمْ سُطاً أَعْرَبَتْ عنها العُروبةُ مِنْ","فُحولِ أَبطالِكَ الغُرِّ المناجيدِ",142,"د",1,0],["وكمْ سَفاهٍ عَلْيهِ أَعْدَى","وكمْ صَوابٍ إِليهِ أَرشَدْ",143,"د",1,0],["وكم سنحت لي سانحات من الهوى","فقلت لها ما للغرام وماليّا",144,"ي",2,0],["وكم ساعدتني مذ دفنت قوامهُ","حمامةُ أيكٍ بالغرامِ تبوحُ",145,"ح",1,1],["وَكَم سَلَب الحُبُّ الرِجالَ عُقولَهُم","وَحُبُّ الفَتى يعمِيه عَن سبلِ الهُدى",146,"د",2,0],["وكم سن من خير واهدى كرامة","وانقذ مكروبا وظفر آمالا",147,"ل",2,0],["وكم سر سرى منه وسير","شريف منه شرفت الهداة",148,"ه",1,0],["وكم سحرت بها الألحاظ ساحرة","من وحي قلب شجيّ بالغرام ندي",149,"د",2,0],["وكم سامرت سمارا فتوا","إلى المجد انتموا من محتدين",150,"ن",1,1],["وكم سجد القناص بالارض اذ رأى","طريدته للفتك في طرف ناقم",151,"م",1,0],["وَكَمْ سُتِرَ الْبَدْرُ الْمُنِيرُ وَوَجْهُهَا","بِلَيْلَيْنِ مِنْ جُنْحٍ بَهِيمٍ وَمِنْ شَعْرِ",152,"ر",1,0],["وَكَمْ سَاعَدَتْهَا وَهْيَ بِالشّرْبِ بَرَّةٌ","وَمَا بِرُّهَا بِالبِدْعِ كَلاَّ وَلاَ النُّكْرِ",153,"ر",1,0],["وكم سبى من عداةٍ كم غَزَا دُولا","حتى أطاعتهُ أدناها وأقصاها",154,"ا",3,0],["وكم سائل وافى إليك مؤملا","فأعطيته أضاف ما كان أملا",155,"ل",2,0],["وكم سيف أقام الحد فيهم","أسى وقضى بسفك دمائهنه",156,"ن",2,0],["وكم سمعتُ لداعٍ مَن لمكرمةٍ","فهل سمعتَ سواه من يقولُ أنا",157,"ن",2,0],["وكم ساءَلتني الحرب أَغلى وديعةٍ","فبتُّ ولم ابسطْ إلى ريبةٍ يدي",158,"د",2,0],["وكم سارق أغرى صغيراً بفلسه","ليغتال ديناراً رآه بعبه",159,"ب",2,0],["وكم ساجد راكع قائم","أطار الكرى عنه ألف سهاد",160,"د",1,0],["وكم سكرنا ولم نشرب بكاس طلا","وكم طربا ولم نضرب باوتار",161,"ر",1,0],["وكم سقتني ليلة الوصل من","رضابها المعسول خمراً حلال",162,"ل",1,0],["وكم سلمت من بعد أن أسلمت له","وسلّمت أقوام سمت واختفت أخر",163,"ر",1,0],["وكم ساروا بما يرجون منه","من الخيل المسومّة العراب",164,"ب",1,0],["وكم سمعتُ لكم في العهد من قسمٍ","فكان عهدكم زوراً وبهتانا",165,"ن",2,0],["وكم سقتنا سلافا من سلافتها","تصوب صوب الحيا أو مدمعي الجاري",166,"ر",2,0],["وكم سماطٍ لَيْسَ يُحْصى حَدّا","كأنّه البَحْرُ إذا ما امْتَدّا",167,"د",2,0],["وكم ساعة تنسيك عمراً مشرداً","لساعة أُنسٍ، من مدى العمر، أنفسُ",168,"س",1,0],["وكم سرنا بلا خوف جهارا","ركبنا الخيل أو جئنا السفينا",169,"ن",2,0],["وكم سائلٍ قد مد قبلي يمينه","إليه فأولاها من الرفد كافيا",170,"ي",2,0],["وكم سقت في آثاركم من نصيحة","وقد يستفيد الظنة المتنصح",171,"ح",1,0],["وكم سَبحَت فُلكُ المُنى في بحارها","مواخِرَ فاليومَ استَوت بي على الجودِي",172,"د",2,0],["وكم سمت نحوها نفس تؤمّلها","من قبل لكنها ضلت مساعيها",173,"ي",3,0],["وكم سَحَرتْ ومَا عبثت لسِحْرٍ","وكم قتلتْ ومَا حملت سِلاَحَا",174,"ح",2,0],["وَكَم سَفكتَ لَهُم في مقلتيك دَما","فَلم تَزَل فاتِناً طوراً وَمنتقما",175,"م",2,0],["وكم سرحت طرفي في البرايا","فلم أر من اصافيه بودي",176,"د",2,0],["وكم سحائب فضل منك هاطلة","على البرية طراً تخجل الديما",177,"م",2,0],["وَكَم سامَرت فيها مِن أَغنٍّ","يُعير البَدر حُسناً إِن تَبدَّى",178,"د",2,0],["وَكَم سَقطت طَيارة أَنا فَوقَها","فَما مَسَّني ضُ