{"poems":[[63,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[100,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[55,"أيذهب هذا الدهر والحال بيننا","https://www.aldiwan.net/poem26301.html","الطويل"],[55,"أيذهب هذا العيد عني وليس لي","https://www.aldiwan.net/poem26428.html","الطويل"],[41,"يا لقومي لكثرة العذال","https://www.aldiwan.net/poem42361.html","الخفيف"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[89,"إليك إلهي في بكاء أجيده","https://www.aldiwan.net/poem45100.html","الطويل"],[56,"دعانا أبو عمرو عمير بن جعفر","https://www.aldiwan.net/poem58604.html","الطويل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[44,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[33,"أجد بأحياء الجميع بكور","https://www.aldiwan.net/poem25929.html","الطويل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[52,"أأسمع ما قال الحمام السواجع","https://www.aldiwan.net/poem26857.html","الطويل"],[46,"رام دنياه ناسك","https://www.aldiwan.net/poem23276.html","مجزوء الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72250","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[85,"الرُّشْدُ أَجملُ سِيرة يا أَحمدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9540&r=&rc=30",""],[120,"ترى يذكر الأحياء أهل المقابر","https://www.aldiwan.net/poem49360.html","الطويل"],[142,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[169,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[199,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[199,"أي ذنب جنيت حتى تجنى","https://www.aldiwan.net/poem45568.html","الخفيف"],[235,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[281,"أيذهب يوم لم أكفر ذنوبه","https://www.aldiwan.net/poem1372.html",""],[297,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[297,"أي ذنب في هواكم أذنبه","https://www.aldiwan.net/poem33327.html","الرمل"],[328,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[348,"أيذل رسلي في اقتضاء وعوده","https://www.aldiwan.net/poem19891.html","الطويل"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[416,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[461,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[466,"فإن شئتم مياد زرنا وزرتم","https://www.aldiwan.net/poem50471.html","الطويل"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[579,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"]],"verses":[["أَيَذهَلُ قَلبٌ أَنتِ سِرُّ ضَميرِهِ","فَلا كانَ يَوماً مِنكِ يا عَلوَ خالِيا",0,"ي",2,0],["أيّ ذكر ؟ أيّ شوق عادني","فإذا قلبي جناحا طائر",1,"ر",1,0],["أَيَذهبُ هذا الدَهرُ وَالحالُ بَينَنا","عَلى ما أَرى لا يَستَقيمُ لَنا الدَهرُ",2,"ر",1,1],["أَيَذهَبُ هَذا العيدُ عَني وَلَيسَ لي","مَعَ الناسِ فيهِ لا سُرورٌ وَلا فَرَح",3,"ح",1,1],["أَيُّ ذَنبٍ عَليَّ إِن قُلتُ إِنِّي","لأُحِبُّ الحِجَازِ حُبَّ الزُلاَلِ",4,"ل",1,0],["أيذِلّ قوم ناهضون وعندهم","شرف يعزّز جانبَيه لمُرهف",5,"ف",1,0],["أيُّ ذنبٍ لساتر نظمه عن","كَ ومن ذا يهدِي لطود حصاته",6,"ت",2,0],["أيّ ذهنٍ وأيّ برٍّ وحامٍ","كله قد حلا لذوق الجاني",7,"ن",2,0],["أيذهبُ هذا عنك يا ابن محمدٍ","وأنت مَعاذٌ في الأمور الحوازبِ",8,"ب",1,0],["أَيُذكَرُ عَمرٌو إِن سَطَوتَ وَعَنتَرٌ","وَهَيهاتَ مِن كِسرى هُناكَ وَخاقانُ",9,"ن",1,0],["أي ذنب لي ان تباعدت الشقة","بين اعتقادهم واعتقادي",10,"ي",1,0],["أي ذي كبرة مشى","فوق وعر وما عثر",11,"ر",1,0],["أيذكرك الإنسان في العسر جائعاً","وينساك عند اليسر إذ هو يشبع",12,"ع",1,0],["أَيُذْبَحُ بين المسلمينَ مُؤَذِّنٌ","مُقيمٌ على دِينِ النّبِيِّ مُحَمّدِ",13,"د",1,0],["أَيَذهَبُ هَذا الدَهرُ لَم يُرَ مَوضِعي","وَلَم يَدرِ ما مِقدارَ حَلّي وَلا عَقدي",14,"ي",1,0],["أَيُّ ذي سُدَدٍ يُناويكَ فيهِ","ظالِماً وَالنَدى بِذَلِكَ قاضِ",15,"ض",1,0],["أَيَذهَبُ عَقلي بَعدَ عِلمي وَإِن عَلا","عِذارِيَ مِن بَعدِ المَشيبِ قَتيرُ",16,"ر",1,0],["إئذنْ يَفِضْ هذا البيانُ فإنّه","ممّا يُفيضُ بَيانُكَ المُتَدَفِّقُ",17,"ق",1,0],["أَيذهبُ بين مَأدُبةٍ وأُخرى","فَبِئْسَ الضّيفُ ضيفُ ذَوي السَّخَاءِ",18,"ا",2,0],["أَيَذهَبُ عُمري وَالعَوائِقُ دونَهُ","عَلى ما أَرى إِنّي إِلى اللَهِ راجِعُ",19,"ع",1,0],["أَيُّ ذَنبٍ أَصابَهُ","فَسَما فَوقَهُ زُحَل",20,"ل",1,0],["أي ذي مسكةٍ يقول صريحاً","وعليها سيف الأذى مشهور",21,"ر",1,0],["أَي ذَواتِ الحِجالِ عِشتُنَّ لِلبِر","رِ وَدُمتُنَّ قُدوَةً لِلرِجالِ",22,"ل",1,0],["أَيَذْهَبُ رَيْعانُ الشَّبابِ ولَمْ أَزُرْ","غرائرَ من همدانَ بيضاً نُحورُها",23,"ه",2,1],["أَيَذْهَبُ قَلْبِي غيلَةً ثُمَّ لا أَرَى","لَهُ بَيْنَكُمْ مِنْ ثائِرٍ أَوْ مُطالِبِ",24,"ب",1,0],["أَيُذْكِرُكَ التَّوْدِيعُ أَوَّلَ مُلْتَقىً","كَشَفْنَا بِهِ سِتْرَ الغَرَامِ المقَنَّعِ",25,"ع",1,0],["أيَّ ذنب جنيتَ في المهد حتى","يصبح الهمُّ في الحياة جزاءك؟",26,"ك",1,0],["أيذوي شبابي بين جدران قرية","بباب كأن الصمت فيها مخيم؟",27,"م",1,0],["أئذا غزا النازي فرن","سَا لا تكفُّ عن النّباح؟!",28,"ح",1,0],["أئذا صفا جوّ السلا","م زفرتَ؛ فانتشر الغمام؟",29,"م",1,0],["أَئذا وَجَدْت الغِيد أَلهاكَ الهوى","وإذا وجدت الشِّعْرَ عزَّ الأَغيد؟",30,"د",1,0],["أيذكر ثدي الأم في كل لحظةٍ","ويبكي حجور المحصنات الحرائر",31,"ر",1,0],["أيُذادُ عن تلك المحاسنِ ناظرى","وتريد مني أن يسَوَّغَها الفمُ",32,"م",1,0],["أَيذهَبُ العُمرُ لا يَخشى مُعانَدَتي","خَصمي وَجاري بِقُربي غَيرُ مُنتَفِعِ",33,"ع",1,0],["أي ذنبٍ جنيتُ ح","تى بهِ اليومَ أُعدمُ",34,"م",1,0],["أيُّ ذنبٍ جنيتُ حتى تجنى","إنني كدتُ بعدهُ أن أجِنَّا",35,"ن",2,1],["أَيَّ ذِمرٍ غالَتِ الأَي","يامُ مَمنوعٍ ذِمارُه",36,"ر",2,0],["أيذهبُ يوم لم أكفر ذنوبه","بذكر شفيع في الذنوب مشفع",37,"ع",1,1],["أَيذخُر الحزنُ عن أَبناءِ فاطمةٍ","يَوماً وَهَل مِنهُم أولى بمَذخورِ",38,"ر",1,0],["أَيُّ ذَنبٍ في هَواكم أَذنَبه","مغرَمٌ لم يقضِ منكم أَربَه",39,"ب",2,1],["أيّ ذنب جنَيته أيّ ذنب","حين خلفتها بلا إسعاد",40,"د",1,0],["أي ذنب جنيت في الحب حتى","تستبيك الدموع من أجفاني",41,"ي",1,0],["أَيُذَلُّ رُسْلي في اقْتضاءِ وُعُودِهِ","وَأَقْرَبُ مِمَّا أَرْتَجِيهِ الكَواكِبُ",42,"ب",1,1],["أَيُّ ذمٍ لو كان فِعْلُك بالأح","بابِ هذا يا ريمُ بالأعداء",43,"ا",2,0],["أَيُّ ذكرى قد ذكرناكم بها","وكذا فليذْكرِ الخِلُّ الخليلا",44,"ل",2,0],["أيذهبُ إدراري شَعاعاً وعصمتي","بحبل سديد الحضرتين أبي نصْر",45,"ر",1,0],["أَيَذهَبُ مَيّادٌ بِأَلبابِ نِسوَتي","وَنُسوَةِ مَيّادٍ صَحيحٌ قُلوبُها",46,"ه",2,0],["أيُّ ذنبٍ تُرَى وأيَّةُ زَلَّه","للمُحِبِّ الذي تحلَّلتَ قَتْلهْ",47,"ل",2,1],["أَيُّ ذنبٍ أَذنَبْتُه ونعم أَذْ","نَبْتُ قد جئتُ تَائِباً مِنْ ذَنْبي",48,"ي",1,0],["أيُّ ذكرى من جحودٍ واختيالٍ","نازعتْهُ في شريفِ المجدِ فخرَا !",49,"ر",2,0]]}