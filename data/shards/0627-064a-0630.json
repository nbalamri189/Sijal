,[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5431,"صفقة العهر ...ليس من خان منّا","https://www.poetsgate.com/ViewPoem.aspx?id=209119",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5781,"قارئ كفّ","https://www.poetsgate.com/ViewPoem.aspx?id=208937",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[6152,"ذكرك لي حياة","https://www.poetsgate.com/ViewPoem.aspx?id=206727",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""]],"verses":[["أَيَذهَلُ قَلبٌ أَنتِ سِرُّ ضَميرِهِ","فَلا كانَ يَوماً مِنكِ يا عَلوَ خالِيا",0,"ي",2,0],["أيّ ذكر ؟ أيّ شوق عادني","فإذا قلبي جناحا طائر",1,"ر",1,0],["أَيَذهبُ هذا الدَهرُ وَالحالُ بَينَنا","عَلى ما أَرى لا يَستَقيمُ لَنا الدَهرُ",2,"ر",1,1],["أَيَذهَبُ هَذا العيدُ عَني وَلَيسَ لي","مَعَ الناسِ فيهِ لا سُرورٌ وَلا فَرَح",3,"ح",1,1],["أَيُّ ذَنبٍ عَليَّ إِن قُلتُ إِنِّي","لأُحِبُّ الحِجَازِ حُبَّ الزُلاَلِ",4,"ل",1,0],["أيذِلّ قوم ناهضون وعندهم","شرف يعزّز جانبَيه لمُرهف",5,"ف",1,0],["أيُّ ذنبٍ لساتر نظمه عن","كَ ومن ذا يهدِي لطود حصاته",6,"ت",2,0],["أيّ ذهنٍ وأيّ برٍّ وحامٍ","كله قد حلا لذوق الجاني",7,"ن",2,0],["أيذهبُ هذا عنك يا ابن محمدٍ","وأنت مَعاذٌ في الأمور الحوازبِ",8,"ب",1,0],["أَيُذكَرُ عَمرٌو إِن سَطَوتَ وَعَنتَرٌ","وَهَيهاتَ مِن كِسرى هُناكَ وَخاقانُ",9,"ن",1,0],["أي ذنب لي ان تباعدت الشقة","بين اعتقادهم واعتقادي",10,"د",2,0],["أي ذي كبرة مشى","فوق وعر وما عثر",11,"ر",1,0],["أيذكرك الإنسان في العسر جائعاً","وينساك عند اليسر إذ هو يشبع",12,"ع",1,0],["أَيُذْبَحُ بين المسلمينَ مُؤَذِّنٌ","مُقيمٌ على دِينِ النّبِيِّ مُحَمّدِ",13,"د",1,0],["أَيَذهَبُ هَذا الدَهرُ لَم يُرَ مَوضِعي","وَلَم يَدرِ ما مِقدارَ حَلّي وَلا عَقدي",14,"د",2,0],["أَيُّ ذي سُدَدٍ يُناويكَ فيهِ","ظالِماً وَالنَدى بِذَلِكَ قاضِ",15,"ض",1,0],["أَيَذهَبُ عَقلي بَعدَ عِلمي وَإِن عَلا","عِذارِيَ مِن بَعدِ المَشيبِ قَتيرُ",16,"ر",1,0],["إئذنْ يَفِضْ هذا البيانُ فإنّه","ممّا يُفيضُ بَيانُكَ المُتَدَفِّقُ",17,"ق",1,0],["أَيذهبُ بين مَأدُبةٍ وأُخرى","فَبِئْسَ الضّيفُ ضيفُ ذَوي السَّخَاءِ",18,"ا",2,0],["أَيَذهَبُ عُمري وَالعَوائِقُ دونَهُ","عَلى ما أَرى إِنّي إِلى اللَهِ راجِعُ",19,"ع",1,0],["أَيُّ ذَنبٍ أَصابَهُ","فَسَما فَوقَهُ زُحَل",20,"ل",1,0],["أي ذي مسكةٍ يقول صريحاً","وعليها سيف الأذى مشهور",21,"ر",1,0],["أَي ذَواتِ الحِجالِ عِشتُنَّ لِلبِر","رِ وَدُمتُنَّ قُدوَةً لِلرِجالِ",22,"ل",1,0],["أَيَذْهَبُ رَيْعانُ الشَّبابِ ولَمْ أَزُرْ","غرائرَ من همدانَ بيضاً نُحورُها",23,"ه",2,1],["أَيَذْهَبُ قَلْبِي غيلَةً ثُمَّ لا أَرَى","لَهُ بَيْنَكُمْ مِنْ ثائِرٍ أَوْ مُطالِبِ",24,"ب",1,0],["أَيُذْكِرُكَ التَّوْدِيعُ أَوَّلَ مُلْتَقىً","كَشَفْنَا بِهِ سِتْرَ الغَرَامِ المقَنَّعِ",25,"ع",1,0],["أيَّ ذنب جنيتَ في المهد حتى","يصبح الهمُّ في الحياة جزاءك؟",26,"ك",1,0],["أيذوي شبابي بين جدران قرية","بباب كأن الصمت فيها مخيم؟",27,"م",1,0],["أئذا غزا النازي فرن","سَا لا تكفُّ عن النّباح؟!",28,"ح",1,0],["أئذا صفا جوّ السلا","م زفرتَ؛ فانتشر الغمام؟",29,"م",1,0],["أَئذا وَجَدْت الغِيد أَلهاكَ الهوى","وإذا وجدت الشِّعْرَ عزَّ الأَغيد؟",30,"د",1,0],["أيذكر ثدي الأم في كل لحظةٍ","ويبكي حجور المحصنات الحرائر",31,"ر",1,0],["أيُذادُ عن تلك المحاسنِ ناظرى","وتريد مني أن يسَوَّغَها الفمُ",32,"م",1,0],["أَيذهَبُ العُمرُ لا يَخشى مُعانَدَتي","خَصمي وَجاري بِقُربي غَيرُ مُنتَفِعِ",33,"ع",1,0],["أي ذنبٍ جنيتُ ح","تى بهِ اليومَ أُعدمُ",34,"م",1,0],["أيُّ ذنبٍ جنيتُ حتى تجنى","إنني كدتُ بعدهُ أن أجِنَّا",35,"ن",2,1],["أَيَّ ذِمرٍ غالَتِ الأَي","يامُ مَمنوعٍ ذِمارُه",36,"ر",2,0],["أيذهبُ يوم لم أكفر ذنوبه","بذكر شفيع في الذنوب مشفع",37,"ع",1,1],["أَيذخُر الحزنُ عن أَبناءِ فاطمةٍ","يَوماً وَهَل مِنهُم أولى بمَذخورِ",38,"ر",1,0],["أَيُّ ذَنبٍ في هَواكم أَذنَبه","مغرَمٌ لم يقضِ منكم أَربَه",39,"ب",2,1],["أيّ ذنب جنَيته أيّ ذنب","حين خلفتها بلا إسعاد",40,"د",1,0],["أي ذنب جنيت في الحب حتى","تستبيك الدموع من أجفاني",41,"ي",1,0],["أَيُذَلُّ رُسْلي في اقْتضاءِ وُعُودِهِ","وَأَقْرَبُ مِمَّا أَرْتَجِيهِ الكَواكِبُ",42,"ب",1,1],["أَيُّ ذمٍ لو كان فِعْلُك بالأح","بابِ هذا يا ريمُ بالأعداء",43,"ا",2,0],["أَيُّ ذكرى قد ذكرناكم بها","وكذا فليذْكرِ الخِلُّ الخليلا",44,"ل",2,0],["أيذهبُ إدراري شَعاعاً وعصمتي","بحبل سديد الحضرتين أبي نصْر",45,"ر",1,0],["أَيَذهَبُ مَيّادٌ بِأَلبابِ نِسوَتي","وَنُسوَةِ مَيّادٍ صَحيحٌ قُلوبُها",46,"ه",2,0],["أيُّ ذنبٍ تُرَى وأيَّةُ زَلَّه","للمُحِبِّ الذي تحلَّلتَ قَتْلهْ",47,"ل",2,1],["أَيُّ ذنبٍ أَذنَبْتُه ونعم أَذْ","نَبْتُ قد جئتُ تَائِباً مِنْ ذَنْبي",48,"ب",2,0],["أيُّ ذكرى من جحودٍ واختيالٍ","نازعتْهُ في شريفِ المجدِ فخرَا !",49,"ر",2,0],["أيذلُّ مظلوما وجدّك جدّه","كيما يعزَّ بذله علجانِ",50,"ن",1,0],["أيّ ذنبٍ بدا فديتك منّي","ما الّذي أوجبَ اِنقطاعك عنّي",51,"ن",2,0],["ايُّ ذكر يبقى لمن عاش ميتاً","وطواهُ الخمولُ قبل اللحود",52,"د",1,0],["أيُّ ذُلٍّ أصابَنا بين قَومٍ","أهملُوا الدّين عن نِفاقٍ فضاعَا",53,"ع",2,0],["أي ذنب تعاتب الدهر فيه","وعاتب الأيام داء عضال",54,"ل",1,0],["أيذكر الناس أن أوديتُ تغريدي","فيطربون وجسمي طيّ أخدود",55,"د",1,1],["أيذهبُ عمري هكذا بين معشر","مجالسهم عافَ الكريم حُلُولها",56,"ل",3,1],["أيذل من بمحمد قد","عزّ بين الناس قدرا",57,"ر",2,0],["أيُذَلُّ مثلى فى محبَّتِكُم","هيهاتَ مثلي قَطُّ ما خَضَعا",58,"ع",2,0],["أيَذهَبُ يومٌ واحدٌ إن أسَأتُهُ","بصالح أيامي وحُسنِ بَلائيا",59,"ي",2,0],["أيذكر اذ بالسيف قد حز رأسه","صحابي ابن مسعود فللَه فاعجبا",60,"ب",2,0],["إيذَنْ بجدواكَ تُدْرِكْنا وكيفَ با","وقد ضَمِنْتَ لنا أن لا نموتَ صدا",61,"د",2,0],["أَيّ ذَنبٍ جَناهُ كَي تُرهِقوهُ","وَتَكونَ السُجونُ بَعضَ جَزائِه",62,"ا",3,0],["أي ذات كانت وما جاء عنها","كونها واستقام عنها بقاها",63,"ا",3,0],["أيُّ ذنبٍ جنيتُ يا حبُّ لمَّا","زدتني لوعةً وأشغلتَ بالي",64,"ل",2,0],["أيذبل ورد الوصل فينا وإنه","ربيبُ دموع لم تزل منكِ أو مني",65,"ن",2,0],["أي ذنبٍ سوى المذل","ة في الحب جيته",66,"ت",2,0],["أَيذهب ثأْري أَو تُطَلُّ على العِدا","ذُحولي وأَعطىَ القياد رمانِ",67,"ن",1,0],["أَيذهب عمري لم أَنَل فيه راحَةً","ولم أَستفد إِلا عَناً ولُغوبا",68,"ب",2,0],["أيَذْهَبُ مطلولاً دَمي ومحمدٌ","لثأْريَ يملا الأرضَ خَيْلاً وفرسانا",69,"ن",2,0],["أيذهبُ مدحٌ من مُحِبِّكَ ضائِعاً","وما المدحُ في جنبِ الإلهِ بضائِعِ",70,"ع",1,0],["أيُّ ذنب للدهر عندي ببعدي","عنك يا ليته تَلاَفَى تَلاَفِي",71,"ف",2,0],["أَيَذهَبُ أَهلي بِالفَناءِ وَإِخوَتي","وَرَهطي وَقَد أَيقَنتُ أَن سَوفَ أَذهَبُ",72,"ب",1,0],["أي ذنبٍ جنيتُ حتى دهاني","قَدَرٌ قد جرى على ميقات",73,"ت",1,0],["أَيَذهب ثار الهاشميين في العِدى","وَيُصبح ذاكَ الحَق أَكلة باطل",74,"ل",1,0],["أيذهب ذا الزمان وليس يدري","من المعروف ما حليّ وعقدي",75,"د",2,0],["أَيَّ ذَنبٍ أَذنَبتُهُ أَيُّ ذَنبِ","أَيَّ ذَنبٍ لَولا مَخافَةُ رَبّي",76,"ب",2,1],["أيّ ذكرى تعودُ لي بعد عامٍ","لم تزل فيه نازفاتٍ جراحي",77,"ح",2,1],["أيُّ ذنبٍ ليَ قل لي","غير حظٍّ منك قلِّ",78,"ل",1,1],["أَيذم يا نَجل الأَكارم مصقع","ظُلماً وَيمدح في العبادِ بليد",79,"د",1,0],["أي ذنب جناه في العيش حتى","يحرم العون أو يسام الأليما",80,"م",2,0],["أيُذْنِبُ دهْرٌ أو يُلمُّ بحادِثٍ","يَروعُ ومِنْ جَدْواكَ شافٍ وشافِعُ",81,"ع",1,0],["إئذنوا لي يا رعابيب الوطن","ألثم المبسم منكم والجبين",82,"ن",1,0],["أَيذكرُ صحبي اليَوم أَني مروّعٌ","أَرجّي زَماناً بالمصائب ظالمي",83,"م",2,0],["أئذا تلامس مرة","شفتاك مستك المعرة",84,"ر",2,0],["أيذوي الصبا فينا لأنك ناشئ","ربيع الصبا في وجنتيه غضير",85,"ر",1,0],["أَيُّ ذَنبٍ في وَردِ خَدٍّ جَنَيتُ","يا عَذولاً لَمّا نَهى ما اِنتَهيتُ",86,"ت",1,1],["أيذكرن أياما مضت ولياليا","ونحن كهدب العين قد لاصق الهدبا",87,"ب",2,0],["أيذكرن في وادي الأراك عشية","تجسم فيها الحب يجذبنا جذبا",87,"ب",2,0],["أيذكرن يوما في الحديقة شائقا","نهبنا به اللذات في ظلها نهبا",87,"ب",2,0],["أَيُّ ذِكرى تُشجيكِ أَيُّ خَيالٍ","راحَ يُضنيكِ مِن فِراقِ خَليلِ",88,"ل",1,0],["أَيُّ ذَنب جَنَيتَهُ أَهل وُدي","فَيَكون الصُدود بَعض عقابي",89,"ب",2,0],["أيذهبُ خصمٌ في دمٍ لي مضيعٍ","ويأمنُ مني اليومَ بطَشه قادر",90,"ر",1,0],["أيذوب أشواقاً ويفنى حسرة","وفنا جناب الفضل منك رحيبُ",91,"ب",1,0],["أيُذاد عن حرم النوال مؤملٌ","لحنانكم آماله تتطلّع",92,"ع",1,0],["أيُّ ذنبٍ أذنَبتهُ ليتَ شعري","كان هذا جزاءَهُ أيُّ ذَنبِ",93,"ب",1,0],["أيُذكَرُ في أعلى المنابرِ خطبَةٌ","ومستَعصِمٌ باللَه لم يك في الذكر",94,"ر",1,0],["أي ذنب بدا واني بدراً","في سما الفضل بكرة وأصيلا",95,"ل",2,0],["أيذكر لي هذا الكتابُ مودّتي","وعودُكِ أشهى منطقاً لو تكلَّما",96,"م",2,1],["أيَّ ذَنبٍ أنتِ عني تكتمينْ","لوه تُجرين دوماً مدمعَكْ",97,"ك",1,0],["أيّ ذنب جناه آدم حتى","نتلقى العقاب نحن جميعا؟",98,"ا",1,0],["أيّ ذنبٍ إلى شقاكِ رماني؟","يابلاداً تموتُ فيها الأماني",99,"ن",2,1],["أيذكرون وقد كانوا إذا ذكروا","يسبح السيف والقرطاس والقلم",100,"م",1,0],["أيذوبُ حُلمُ سعادتي بوسادةٍ","شبعتْ بدمع ِنواظري ليُسلِّما؟",101,"م",2,0],["أيُّ ذاكَ السحرِ طيفي ؟ يا لَهُ","يا لهُ من زائرٍ ما أمتَعَهْ !",102,"ع",2,0],["أي ذنب أي عيب","دونه الصفح اغتفارا",103,"ر",2,0],["أي ذي كسب خسارته","حبك أستحلى الذي كسبا",104,"ب",2,0],["أيذهب الرشد وقد اشرقت","آل المعز اليوم انوارا",105,"ر",2,0],["أي ذنبٍ لنا إذا عرف الشعب","...لنا أننا له قد وفينا",106,"ن",2,0],["أيّ ذنبٍ ليرتوي الرملُ نزفي؟","وأدوني ولم تجفّ الدماءُ !!!",107,"ا",2,0],["أي ذلٍ أمام مرأى الرعايا","في انبطاح من التعهر أدنى!!",108,"ن",2,0],["أَيُّ ذئبٍ خائنٍِ أيُّ قَطيعْ","أيُّ غَدْرٍ في روابيها يشيعْ؟",109,"ع",1,1],["أيُّ ذَنْبٍ جَنيْتُه كيْ يطُولَ","الأسْرُ إنِّي أصْبحْتُ أَخْشَى الحِماما",110,"م",2,0],["[ أَيُذِيبُ أَحْشائِي تَبَسُّمُ ثَغْرِها","أَمْ خَدُّها المُتَوَرِّدُ المُتَعَصْفِرُ ]",111,"ر",1,0],["أيذْكُرُ قلبًا بِشَوْقي اكْتَوى","وليسَ بهِ من حَبيبٍ سِواهْ",112,"ا",2,0],["أ يُذِلُّني في آخِرِ العُمُرِ الذي","أحتاجُ منه رعايةً وتَنَعُّما",113,"م",2,0],["أَيُّ ذَنْبَ لِيْ بِعَشْقِيْ رُبَّمَاْ","صَاْرَ بُؤْسِيْ فِيْ مَحَبّتْهِاْ ثَمَنْ",114,"ن",1,0],["أَيَّ ذَنبٍ أَجرَمتُهُ بِقَصِيدِي ؟","أَيَّ إِثمٍ بِأَحرُفِي قَدْ تَوَلَّى ؟",115,"ل",2,0],["أَيُّ ذَنبٍ ؟ إ