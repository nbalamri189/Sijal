{"poems":[[63,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[55,"أيذهب هذا الدهر والحال بيننا","https://www.aldiwan.net/poem26301.html","الطويل"],[55,"أيذهب هذا العيد عني وليس لي","https://www.aldiwan.net/poem26428.html","الطويل"],[41,"يا لقومي لكثرة العذال","https://www.aldiwan.net/poem42361.html","الخفيف"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[89,"إليك إلهي في بكاء أجيده","https://www.aldiwan.net/poem45100.html","الطويل"],[56,"دعانا أبو عمرو عمير بن جعفر","https://www.aldiwan.net/poem58604.html","الطويل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[44,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[33,"أجد بأحياء الجميع بكور","https://www.aldiwan.net/poem25929.html","الطويل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[52,"أأسمع ما قال الحمام السواجع","https://www.aldiwan.net/poem26857.html","الطويل"],[46,"رام دنياه ناسك","https://www.aldiwan.net/poem23276.html","مجزوء الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72250","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[85,"الرُّشْدُ أَجملُ سِيرة يا أَحمدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9540&r=&rc=30",""],[118,"ترى يذكر الأحياء أهل المقابر","https://www.aldiwan.net/poem49360.html","الطويل"],[140,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[167,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[197,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[197,"أي ذنب جنيت حتى تجنى","https://www.aldiwan.net/poem45568.html","الخفيف"],[233,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[279,"أيذهب يوم لم أكفر ذنوبه","https://www.aldiwan.net/poem1372.html",""],[295,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[295,"أي ذنب في هواكم أذنبه","https://www.aldiwan.net/poem33327.html","الرمل"],[326,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[346,"أيذل رسلي في اقتضاء وعوده","https://www.aldiwan.net/poem19891.html","الطويل"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[413,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[459,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[464,"فإن شئتم مياد زرنا وزرتم","https://www.aldiwan.net/poem50471.html","الطويل"],[560,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[577,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"]],"verses":[["أَيَذهَلُ قَلبٌ أَنتِ سِرُّ ضَميرِهِ","فَلا كانَ يَوماً مِنكِ يا عَلوَ خالِيا",0,"ي",2,0],["أَيَذهبُ هذا الدَهرُ وَالحالُ بَينَنا","عَلى ما أَرى لا يَستَقيمُ لَنا الدَهرُ",1,"ر",1,1],["أَيَذهَبُ هَذا العيدُ عَني وَلَيسَ لي","مَعَ الناسِ فيهِ لا سُرورٌ وَلا فَرَح",2,"ح",1,1],["أَيُّ ذَنبٍ عَليَّ إِن قُلتُ إِنِّي","لأُحِبُّ الحِجَازِ حُبَّ الزُلاَلِ",3,"ل",1,0],["أيذِلّ قوم ناهضون وعندهم","شرف يعزّز جانبَيه لمُرهف",4,"ف",1,0],["أيُّ ذنبٍ لساتر نظمه عن","كَ ومن ذا يهدِي لطود حصاته",5,"ت",2,0],["أيّ ذهنٍ وأيّ برٍّ وحامٍ","كله قد حلا لذوق الجاني",6,"ن",2,0],["أيذهبُ هذا عنك يا ابن محمدٍ","وأنت مَعاذٌ في الأمور الحوازبِ",7,"ب",1,0],["أَيُذكَرُ عَمرٌو إِن سَطَوتَ وَعَنتَرٌ","وَهَيهاتَ مِن كِسرى هُناكَ وَخاقانُ",8,"ن",1,0],["أي ذنب لي ان تباعدت الشقة","بين اعتقادهم واعتقادي",9,"ي",1,0],["أي ذي كبرة مشى","فوق وعر وما عثر",10,"ر",1,0],["أيذكرك الإنسان في العسر جائعاً","وينساك عند اليسر إذ هو يشبع",11,"ع",1,0],["أَيُذْبَحُ بين المسلمينَ مُؤَذِّنٌ","مُقيمٌ على دِينِ النّبِيِّ مُحَمّدِ",12,"د",1,0],["أَيَذهَبُ هَذا الدَهرُ لَم يُرَ مَوضِعي","وَلَم يَدرِ ما مِقدارَ حَلّي وَلا عَقدي",13,"ي",1,0],["أَيُّ ذي سُدَدٍ يُناويكَ فيهِ","ظالِماً وَالنَدى بِذَلِكَ قاضِ",14,"ض",1,0],["أَيَذهَبُ عَقلي بَعدَ عِلمي وَإِن عَلا","عِذارِيَ مِن بَعدِ المَشيبِ قَتيرُ",15,"ر",1,0],["إئذنْ يَفِضْ هذا البيانُ فإنّه","ممّا يُفيضُ بَيانُكَ المُتَدَفِّقُ",16,"ق",1,0],["أَيذهبُ بين مَأدُبةٍ وأُخرى","فَبِئْسَ الضّيفُ ضيفُ ذَوي السَّخَاءِ",17,"ا",2,0],["أَيَذهَبُ عُمري وَالعَوائِقُ دونَهُ","عَلى ما أَرى إِنّي إِلى اللَهِ راجِعُ",18,"ع",1,0],["أَيُّ ذَنبٍ أَصابَهُ","فَسَما فَوقَهُ زُحَل",19,"ل",1,0],["أي ذي مسكةٍ يقول صريحاً","وعليها سيف الأذى مشهور",20,"ر",1,0],["أَي ذَواتِ الحِجالِ عِشتُنَّ لِلبِر","رِ وَدُمتُنَّ قُدوَةً لِلرِجالِ",21,"ل",1,0],["أَيَذْهَبُ رَيْعانُ الشَّبابِ ولَمْ أَزُرْ","غرائرَ من همدانَ بيضاً نُحورُها",22,"ه",2,1],["أَيَذْهَبُ قَلْبِي غيلَةً ثُمَّ لا أَرَى","لَهُ بَيْنَكُمْ مِنْ ثائِرٍ أَوْ مُطالِبِ",23,"ب",1,0],["أَيُذْكِرُكَ التَّوْدِيعُ أَوَّلَ مُلْتَقىً","كَشَفْنَا بِهِ سِتْرَ الغَرَامِ المقَنَّعِ",24,"ع",1,0],["أيَّ ذنب جنيتَ في المهد حتى","يصبح الهمُّ في الحياة جزاءك؟",25,"ك",1,0],["أيذوي شبابي بين جدران قرية","بباب كأن الصمت فيها مخيم؟",26,"م",1,0],["أئذا غزا النازي فرن","سَا لا تكفُّ عن النّباح؟!",27,"ح",1,0],["أئذا صفا جوّ السلا","م زفرتَ؛ فانتشر الغمام؟",28,"م",1,0],["أَئذا وَجَدْت الغِيد أَلهاكَ الهوى","وإذا وجدت الشِّعْرَ عزَّ الأَغيد؟",29,"د",1,0],["أيذكر ثدي الأم في كل لحظةٍ","ويبكي حجور المحصنات الحرائر",30,"ر",1,0],["أيُذادُ عن تلك المحاسنِ ناظرى","وتريد مني أن يسَوَّغَها الفمُ",31,"م",1,0],["أَيذهَبُ العُمرُ لا يَخشى مُعانَدَتي","خَصمي وَجاري بِقُربي غَيرُ مُنتَفِعِ",32,"ع",1,0],["أي ذنبٍ جنيتُ ح","تى بهِ اليومَ أُعدمُ",33,"م",1,0],["أيُّ ذنبٍ جنيتُ حتى تجنى","إنني كدتُ بعدهُ أن أجِنَّا",34,"ن",2,1],["أَيَّ ذِمرٍ غالَتِ الأَي","يامُ مَمنوعٍ ذِمارُه",35,"ر",2,0],["أيذهبُ يوم لم أكفر ذنوبه","بذكر شفيع في الذنوب مشفع",36,"ع",1,1],["أَيذخُر الحزنُ عن أَبناءِ فاطمةٍ","يَوماً وَهَل مِنهُم أولى بمَذخورِ",37,"ر",1,0],["أَيُّ ذَنبٍ في هَواكم أَذنَبه","مغرَمٌ لم يقضِ منكم أَربَه",38,"ب",2,1],["أيّ ذنب جنَيته أيّ ذنب","حين خلفتها بلا إسعاد",39,"د",1,0],["أي ذنب جنيت في الحب حتى","تستبيك الدموع من أجفاني",40,"ي",1,0],["أَيُذَلُّ رُسْلي في اقْتضاءِ وُعُودِهِ","وَأَقْرَبُ مِمَّا أَرْتَجِيهِ الكَواكِبُ",41,"ب",1,1],["أَيُّ ذمٍ لو كان فِعْلُك بالأح","بابِ هذا يا ريمُ بالأعداء",42,"ا",2,0],["أَيُّ ذكرى قد ذكرناكم بها","وكذا فليذْكرِ الخِلُّ الخليلا",43,"ل",2,0],["أيذهبُ إدراري شَعاعاً وعصمتي","بحبل سديد الحضرتين أبي نصْر",44,"ر",1,0],["أَيَذهَبُ مَيّادٌ بِأَلبابِ نِسوَتي","وَنُسوَةِ مَيّادٍ صَحيحٌ قُلوبُها",45,"ه",2,0],["أيُّ ذنبٍ تُرَى وأيَّةُ زَلَّه","للمُحِبِّ الذي تحلَّلتَ قَتْلهْ",46,"ل",2,1],["أَيُّ ذنبٍ أَذنَبْتُه ونعم أَذْ","نَبْتُ قد جئتُ تَائِباً مِنْ ذَنْبي",47,"ي",1,0],["أيُّ ذكرى من جحودٍ واختيالٍ","نازعتْهُ في شريفِ المجدِ فخرَا !",48,"ر",2,0]]}