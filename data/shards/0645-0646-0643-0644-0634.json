"الكامل"],[4424,"","https://poetry.dctabudhabi.ae/diwan/poem/205340","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4755,"العُودُ رَنَّ كَأَنَّمَا (يَرْنَا)","https://www.poetsgate.com/ViewPoem.aspx?id=191590",""],[5240,"عج بالكناس وعج بربع لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=171237",""],[5376,"نامت حمائمها والليل أسلانا","https://www.poetsgate.com/ViewPoem.aspx?id=188443",""],[5593,"وليلة لم أذق من حرها وسناً","https://www.poetsgate.com/ViewPoem.aspx?id=181036",""],[5720,"نشيدُ البَيعَة","https://www.poetsgate.com/ViewPoem.aspx?id=201302",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6089,"لم تبق لي لغةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214527",""]],"verses":[["مِن كُلِّ شَوهاءَ الضُلوعِ مُثيرُها","مُتَعَوِّذٌ وَالناظِرُ المُتَأَمِّلُ",0,"ل",1,0],["مِن كُلِّ شَوهاءِ اليَدَينِ طِمِرَّةٍ","وَمُقَلَّصٍ عَبلِ الشَوى ذَيّالِ",1,"ل",1,0],["مِن كُلِّ شَوساءَ لَمّا خُشَّ ناظِرُها","أَدنَت مُذَمَّرَها مِن واسِطِ الكورِ",2,"ر",1,0],["من كل شيءٍ يُسْتَتَا","بُ وما استُهُ بالمُستَتابهْ",3,"ب",2,0],["من كلِّ شَحْذانِ الْحشا لُهْمُمٌ","يأكل ما لا يحسِبُ الحاسبُ",4,"ب",1,0],["مِن كُلِّ شَمطاءَ وَلّى","شَبابُها وَالغُرورُ",5,"ر",1,0],["مِن كُلِّ شَهمٍ كَالهِزَبرِ الباسِلِ","وَكُلِّ قيلٍ قائِلٍ وَفاعِلِ",6,"ل",1,0],["من كلّ شخصٍ يحتسي من ريحِهِ","روحاً يحرّك جسمَه بهبوبِ",7,"ب",1,0],["مِن كُلِّ شارِدَةٍ تُغادِرُ بَعدَها","حَظَّ الرِجالِ مِنَ القَصيدِ خَسيسا",8,"س",2,0],["مِن كُلِّ شَهباءَ قَد شابَت مَشافِرُها","تَنحازُ مِن حِسِّها الأَفعى إِلى الوَزَرِ",9,"ر",1,0],["منْ كُلّ شاردَةٍ إذا سَيَّرتُهَا","وخَدَتْ بهِنَّ اليَعْمُلاتُ الذُّمَّل",10,"ل",1,0],["مِن كُلِّ شاعِفَةٍ إِذا طَرَقَت","طَرَقَ المُحِبُّ لَها طَبائِبُهُ",11,"ب",2,0],["مِنْ كُلِّ شَوْحَطَةٍ رَفِيعٍ صَدْرُهَا","شَقَّاءَ تَسْبِقُ رَجْعَةَ الكَلاَّبِ",12,"ب",1,0],["مِنْ كلِّ شَعْشَاعٍ خَفِيفِ الْخُطَا","ذِي مِرَّةٍ مُنْجَرِدٍ أَرْوَعا",13,"ع",2,0],["مِنْ كُلِّ شادِيَةٍ كَأَنَّ حَنِينَها","هَمْسُ الْمُنَى لِلْيائِسِ الْكَدَّاحِ",14,"ح",1,0],["من كلِّ شَحْذانِ الْحشا فَهِمُ","يأكل ما لا يحسِبُ الحاسبُ",15,"ب",1,0],["مِن كلِ شاردةٍ يطيبُ لقيدها","سهد الجفون ويعذُب التأريق",16,"ق",1,0],["من كلّ شيء قد قضيتُ لُبانةً","إلا الخنى وقبائحَ الآثامِ",17,"م",1,0],["مِن كلِّ شَهْم مِثل سَهمٍ صارِد","لأصيدِ الكُماةِ سابٍ صائِد",18,"د",1,0],["من كُلّش مُنخرقِ السِربال تحسَبُه","إذا تسربلَ بالظَلماءِ عِفريتا",19,"ت",2,0],["مِن كُلِّ شَمس تَحتَ فَجر الطلى","في لَيل شعرٍ طَلع الفرقدان",20,"ن",1,0],["من كل شاكٍ غدا سكرانَ من دمه","يميس جذلان تحت البيض بالمكث",21,"ث",1,0],["من كل شيء يبعدنا","عن ربنا كائنا ما كان",22,"ن",1,0],["من كل شائبة وعله","وصنوف إخوان بهم",23,"م",1,0],["من كل شهبا إذا مالت بجانحها","ترمي الحجال على العداد بالعدم",24,"م",1,0],["من كل شهم مجيد تلتقيه كما","الضرغام بالنقع يدعو الجمع في فلل",25,"ل",1,0],["من كل شادٍ يستبي البابنا","سحراً بطيب بسيطهِ ونشديه",26,"د",3,0],["من كلِّ شهمٍ كوَقْعِ السَّهمِ رَمْشَتُهُ","يومَ الصِّدامِ والفُرْسانِ عُنوَانُ",27,"ن",1,0],["من كلِّ شَيخٍ كبيرٍ مُفْرَدٍ عَلَمٍ","كأنَّهُ عَلَمٌ في رأسِهِ نارُ",28,"ر",1,0],["من كلِّ شهمٍ مهدَويٍّ دأبُه","ضرْبُ الطُّلا بالسّيفِ أو بَذْلُ القِرى",29,"ر",2,0],["من كل شمس إذا قابلتها التثمت","كأنما أشفقت أن ألثم الشفقا",30,"ق",2,0],["من كل شيطان بذي","فشافعي من هول ذي",31,"ي",1,0],["من كل شيء تبدى لي فحققه","قلبي فزال بتحقيقي وتطميسي",32,"س",2,0],["من كل شهم جليل طاب عنصره","لأحمد الأيدي البيضاء قد شكرا",33,"ر",2,0],["من كل شهم سري طاب عنصره","وفضله انطلقت في مدحه اللسن",34,"ن",1,0],["من كل شهم جليل طاب محتده","وقد غدا في البرايا مفرداً علما",35,"م",2,0],["من كل شهم ماجد ما راقه","إن العباد تعيش وهي عبيد",36,"د",1,0],["من كل شيخ مجون في شباب فتى","يقرى المجون بقلب غير نساء",37,"ا",2,0],["مِن كلِّ شادٍ تُغذِّي الروحَ نَغمَتُهُ","حَلاوَة الأُنسِ غِرّيد وَصدّاحِ",38,"ح",1,0],["مِن كُلِّ شَهمٍ ماجِد حلاحِل","لِكلّ فَضلٍ وَعلا مُستاهلِ",39,"ل",1,0],["من كل شهم حديد المنتضى ذرب","لا يختشي الأسد في الهيجا وتخشاه",40,"ا",2,0],["من كل شهم إذا ترى ما","في خوّة الحرب للطراد",41,"د",1,0],["من كل شهم إذا تبدوا الكماة له","بنقض كالنسر لما إن يري الجيفا",42,"ف",2,0],["من كل شهم إذا تبدو الكماة له","ينقض كالنسر تدعوه الفريسات",43,"ت",1,0],["من كل شهم على طرف كنجم دجى","يضىء نورا ويولي النار إن رجما",44,"م",2,0],["من كل شي يقتضي للخزن","مؤونةً من مدسمٍ أو دهنِ",45,"ن",1,0],["من كل شمطاء ان أسفرت","تزري بشمس الضحى والهلال",46,"ل",1,0],["من كلِّ شَيْظَمةٍ جردْاء سَلْهبةٍ","أو شَيْظهَمِ أَجْرَدٍ كالسّيد سرْحوبِ",47,"ب",1,0],["من كل شيظمَةٍ وأجرد شيظمٍ","يعدو بأروع في الحروب مظفر",48,"ر",1,0],["من كل شمس برجها غاب الظيا","وبها الرماح تريك أوج مدار",49,"ر",1,0],["من كل شهم إذا نودي لمكرمةٍ","لبى نداء المنادي وهو معطاء",50,"ا",2,0],["منْ كلِّ شاردةٍ تُدِلُّ بِمِقْوَلٍ","لو كانَ مضرِبَ صارمٍ لم يُثلم",51,"م",1,0],["من كل شاردة إذا ما قالها","طارت بها في الخافقين رواته",52,"ت",2,0],["من كل شامخة الذرا ينحط عن","شرفاتها نسر ويسقط قشعم",53,"م",1,0],["من كلّ شاردة يهيم ببثها","غادٍ فيودعها حقيبة رائح",54,"ح",1,0],["مِن كُلِّ شِيعِيٍّ خَبِيثٍ وَصفُهُ","وَصفُ اليهُودِ مُحَلِّلِي الحِيتَانِ",55,"ن",1,0],["مِن كُلِّ شارِدَةٍ مِثالٌ رائِعٌ","لِلَهِ قُدرَةُ ذَلِكَ الصَيّادِ",56,"د",1,0],["مِن كُلِّ شارِدَةٍ كَأَنَّ عِنانَها","يُعطيكَ سالِفَةَ الغَزالِ السَّانِحِ",57,"ح",1,0],["منِ كل شيءٍ فائتٍ فارقتُه","خَلَفٌ وما بالحاجبيّة مَخْلَفُ",58,"ف",1,0],["مِن كُل شَيء حسنٍ قَد حَوى ال","أحسنَ وَصفاً وَنَفى الأَدونا",59,"ن",2,0],["مِن كُل شَهم لَيسَ يَحذر قَتله","إِن لَم يَكُن بِنَجاته المَحذور",60,"ر",1,0],["من كل شهم وفيّ العهد صادقه","وكل ليث قويّ الساعدين أبي",61,"ب",2,0],["مِن كُلِّ شارِدَةٍ عَذراءَ ناهِدَةٍ","يَكونُ إِهداؤُها لَهُم لَها عُرُسا",62,"س",2,0],["من كل شهم أروع يروع من","حاز الطريق وهو فها مرتقب",63,"ب",1,0],["من كل شيخ مجونٍ في لباس فتى","يقرى المجونَ بقولٍ دون فحشاءِ",64,"ا",2,0],["من كل شيخ قد التفت عمامته","على المذلّة يطوى عمره هونا",65,"ن",2,0],["مِن كُلِّ شَيىءٍ يَنفَعُ","بَل مِن نَفائِسَ تُقتَنى",66,"ن",2,0],["من كلِّ شيءٍ لطُلاَّبِ العُلا بَدَلٌ","أرضٌ بأرضٍ وَسُلطَانٌ بِسُلطانِ",67,"ن",1,0],["من كل شهم أشم الأنف مبتسم","في القرع يحسب جد الموت كالعب",68,"ب",1,0],["مِن ك