{"poems":[[55,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[87,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63984","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"]],"verses":[["كُلَّ أَغَرٍّ يَدِقُ الذِهابا","مُجَرِّراً عَلى الرُبى أَهدابا",0,"ب",2,0],["كُلُّ اِغتِرابٍ مَتاعٌ في الحَياةِ سِوى","يَومٍ يُفارِقُ فيهِ المُهجَةَ الجَسَدُ",1,"د",1,0],["كُلُّ أغانيِّ فُرَيجٍ غَلطْ","وجوهرُ الجوهرِ منه سَقَطْ",2,"ط",1,1],["كلّ أَغرّ يشق كلّ دجى","بطلعة في الزَمان غَرّاءِ",3,"ا",2,0]]}