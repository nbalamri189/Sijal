{"poems":[[90,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[45,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[154,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[208,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[226,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[479,"مهلا دريد عن التسرع إنني","https://www.aldiwan.net/poem2159.html","الكامل"],[556,"ألا أرقت لضوء برق أومضا","https://www.aldiwan.net/poem47737.html","الكامل"],[563,"لهب النار في الفتيلة كالرو","https://www.aldiwan.net/poem34711.html","الخفيف"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20379","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71067","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102968","الكامل"],[5707,"طرق الصَّوَاب بك استبان سَبِيلهَا","https://www.poetsgate.com/ViewPoem.aspx?id=189187",""],[6328,"في رحاب الضاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82139&r=&rc=14",""]],"verses":[["وإذا أُهِنتم فاشكروا","وإذا لُطِمتم فابسِموا",0,"م",3,0],["وَإِذا اِهتَزَّ لِلنَدى كانَ بَحراً","وَإِذا اِهتَزَّ لِلوَغى كانَ نَصلاً",1,"ل",2,0],["وَإِذا أَهابَ بِها الهُداةُ رَأَيتَها","تَعصي الهُداةَ وَتَتبَعُ الضُلّالا",2,"ل",2,0],["وإذا أهملته شَبَّ علَى","حبّه الندْىَ مَداهُ واتصلْ",3,"ل",1,0],["وإذا اهتديت إلى الصواب فإنها","في حق خالقها تقوم وتقعد",4,"د",1,0],["وَإِذا اِهتَزَّ مُقبِلاً زانَهُ أَتلَع","كَالجِذعِ ما يُنالُ العِذارُ",5,"ر",1,0],["واذا اهتزَزنَ لنا تهزُّ قلوبَنا","هيفُ الخصور ورُجَّحُ الأكفالِ",6,"ل",1,0],["وإذا اهتاج من حرارة قبلا","تي أوما إليَّ بالتهديد",7,"د",1,0],["وإذا اهْتَزَزتُ لمَدْحِ ذي كَرَمٍ","فأنا لسانٌ والزَّمانُ فُم",8,"م",1,0],["وإذا أهانكَ معشرٌ أكرِمهُم","فتكون حين ترى الهوان وتسمعُ",9,"ع",1,0],["وإِذا أهبتَ بهمْ ليومِ عظيمةٍ","حمّلتَ أعباءَ العظيمة نُهّضا",10,"ض",2,0],["وإذا أهملوه زاد سواداً","وعلا النور ظلمة التفويت",11,"ت",1,0],["وَإِذا أَهلُ بَلدَةٍ أَنكَروني","عَرَفَتني الدَوُيَّةُ المَلساءُ",12,"ا",2,0],["وإذا أَهابَ بهم إلى أَغراضه","سبقوا إلى ما شاءَ كَفٌّ المُومى",13,"م",2,0],["وَإِذا أَهنتَ أَخاكَ أَو أَفردتَهُ","عَمداً فَأَنتَ الواهِنُ المَذمومُ",14,"م",1,0],["وإذا أهالتك الرماح بفتكها","هانت عليك من الدمى بقدود",15,"د",1,0],["وَإِذا أهل الْوَفْد من ميقاتهم","طويت غمامته وَزَالَ ظليلها",16,"ل",3,0],["وإذا أهَانُوها فإنَّ مصيرَهم ْ","عَيْشُ الهَوان ِو ذلَّةُ الخِذلان ِ",17,"ن",1,0]]}