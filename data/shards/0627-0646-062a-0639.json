poem3162.html","عموديه"],[465,"يا سائلاً عن غليل قلبي","https://www.aldiwan.net/poem3204.html","عموديه"],[469,"زفرات ولوعة واكتئاب","https://www.aldiwan.net/poem60489.html","البسيط"],[494,"أن تعلم الأيام موضع عبده","https://www.aldiwan.net/poem67300.html","عموديه"],[496,"يا قلب ما أغفلك","https://www.aldiwan.net/poem10253.html","السريع"],[506,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[530,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[539,"إن تعيشي فإننا سنعيش","https://www.aldiwan.net/poem47520.html","عموديه"],[552,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[559,"فر يا طائرا إلى ربك","https://www.aldiwan.net/poem34262.html","الخفيف"],[561,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[576,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[576,"لا كانت الشمس فكم أصدأت","https://www.aldiwan.net/poem2808.html","السريع"]],"verses":[["أَنتَ عَلى البُعدِ هُمومي إِذا","غِبتَ وَأَشجاني عَلى القُربِ",0,"ب",1,0],["أنتَ عَبْدُ الْحَليمِ حِلْمَكَ نَرْجُو","فَالمُسَمّى لَهُ نَصِيبُ مِنِ اسْمِهْ",1,"ه",1,0],["أَنتَ عَبدُ الحَميدِ وَالتاجُ مَعقو","دٌ وَعَبدُ الحَميدِ رَهنَ القُيودِ",2,"د",1,0],["أَنتَ عَلَّمتَنا الرُجوعَ إِلى الحَق","قِ وَرَدَّ الأُمورِ لِلأَسبابِ",3,"ب",1,0],["أنتِ عماد السماء لكن","خفِيت عن عين كل راء",4,"ا",2,0],["إن تعالى الثناءُ كانوا بنيه","أو تعالى الفخار كانوا بناته",5,"ت",2,0],["أنتَ عيني وليس من حق عَيني","غَضُّ أَجفانها على الأقْذاءِ",6,"ا",2,0],["أنت علَّمتَني إباءَ الدَّنايا","يا مليكي فما أسأتُ الأَداءَ",7,"ا",2,0],["إنْ تُعَلِّلْ قمريةُ الأُنْس قلبي","فبما راعَهُ الغرابُ النَّعُوبُ",8,"ب",1,0],["أنت عندي كماء بئرِك في الصَيْ","ف ثقيل يعلوك بَرْدٌ شديدُ",9,"د",1,0],["أنت عندي العَدُوُّ أكره إقدا","مك لكن أرى ردىً تعْريدَك",10,"ك",1,0],["أنت عَوَّدتَني التَّسَحُّبَ بالحلْ","م فلا تَمْنَعنَّني تَعْويدَكْ",10,"ك",1,0],["أنتَ عِيدٌ للناسِ في كلِّ عيدٍ","بل لَعَمْرِي في سائر الأزمان",11,"ن",1,0],["أنت عندي وشيْخِكَ السيد الما","جِدِ لا شك صادقُ الكُنيتين",12,"ن",1,0],["أَنتَ عَصرٌ مُستَجمِعٌ في سُوَيعا","تٍ وَدُنيا رَحيبَةٌ في مَكانِ",13,"ن",1,0],["أَنتَ عَيني وَأَنتَ أَح","لى لِعَيني مِنَ الوَسَن",14,"ن",1,0],["أَنْتَ عذَّبتني بَدِقَّة حِسِّي","وتعقَّبْتَني بكُلِّ الدَّواهي",15,"ي",1,0],["أَنْتَ عودٌ مزّقت أوتارَه كفُّ الحياةْ","فهو في وحشته الخَرساءِ بَيْنَ الكائِناتْ",16,"ت",1,0],["إِنْ تَعْبِسي لَدَمٍ مِنّا هُريقَ بها","فقد حَقَنّا دَمَ الإسلامِ فابْتَسِمِي",17,"م",2,0],["أَنتَ عَلِيمٌ بِكُلِّ مُعجِزَةٍ","وَلَو سَأَلنا سِواكَ لَم يُجِبِ",18,"ب",1,0],["إنْ تُعْرضُوا عنِّي فمِنْ دونِكُمْ","في الأرض لي مضطَرَبٌ واسِعُ",19,"ع",1,0],["إِن تَعاطَوا تِلكَ المَكايِدِ ضاعوا","في مَسافاتِها الطِوالِ العِراضِ",20,"ض",1,0],["إِن تُعاوِدُهُ مُذكِراً لا تُعاوِد","ذائِبَ القَولِ جامِدَ الأَوراقِ",21,"ق",1,0],["إِن تُعطَ مَرضاتَهُ وَتُحرَم رَذا","ذَ الغَيثِ أَو وَبلَهِ فَلا تُبلِ",22,"ل",1,0],["إِن تُعَنِّف عَلى السَماحِ فَلا تَع","دُ عَلِيّاً مُسَيِّراً أَو مُبِنّا",23,"ن",2,0],["إنْ تَعمُرِ السُّورَ أو تُهمِلْ عَمارَتَه","فإنَّه بك ما عُمِّرْتَ مَعمورُ",24,"ر",1,0],["أَنتَ عَلَّمتَني التَجَرّي عَلى الدَه","رِ وَفَتكي بِكُلِّ خَطبٍ شَديدِ",25,"د",1,0],["أنت عاتٍ ونحنُ كالزَّبَدِ الذا","هبِ يعلو حينا ويمضي جفاءَ",26,"ا",2,0],["إن تَعُد محسِناً إليّ فَعُد بي","للعهودِ المقدّساتِ الكرائم",27,"م",1,0],["إِن تُعطِ وَجهاً كاسِفاً مِن تَحتِهِ","كَرَمٌ وَحِلمُ خَليقَةٍ لا تُجهَلُ",28,"ل",1,0],["إِن تُعطِ وَجهاً كاسِفاً مِن تَحتِهِ","كَرَمٌ وَحِلمُ خَليفَةٍ لا تُجهَلُ",29,"ل",1,0],["أَن تَعلَقَ الدَلوُ بِالدَلوِ الغَريبَةِ أَو","يُلابِسَ الطُنُبَ المُستَحصِدَ الطُنُبُ",30,"ب",1,0],["إِن تَعدُ دارُكُم أَزُركِ وَإِن أَمُت","فَعَلَيكِ مِنّي رَحمَةٌ وَسَلامُ",31,"م",1,0],["إِن تَعودي تَكُن تِهامَةُ داري","وَبِنَجدٍ إِذا حَلَلتِ مَعادي",32,"د",2,0],["إِن تَعدُنا رِقبَةٌ إِذ نَأتِ غَيرَكُمُ","فَأَنتِ أَوجَهُ مَن يُنأَى وَيُجتَنَبُ",33,"ب",1,0],["أنت علَّمتهم وسوف تراهم","من شُيوخِ الوغى فنعم المُعلِّمْ",34,"م",1,0],["أنتَ علّمتَ تلاميذَ الوغَى","كُلَّ فنٍّ غاب عمّن عَلّما",35,"م",2,0],["أَنتِ عَلَّمتِ الشُّعوبَ الأُوَلا","سُبُلَ المجدِ وأسبابَ العُلا",36,"ل",2,0],["إِن تَعلِقِ اليَومَ بِالأَعناقِ بَيعَتُهُ","يَعلَق بِكُلِّ وَريدٍ نابُ ثُعبانِ",37,"ن",1,0],["إن تَعْجَبِي لِلعِرضِ يُبذلُ هَيِّناً","وهو الحياةُ بأسرها فَكَذاكِ",38,"ك",1,0],["أَنتَ عَلى التَحقيقِ موسى فَقَد","أَمِنتَ أَن تَغرَقَ في البَحرِ",39,"ر",1,0],["أَنتَ عَلى ما بِكَ مِن قُدرَةٍ","فَلَستَ مِثلَ الفَضلِ بِالواجِدِ",40,"د",1,0],["أَنتَ عَذَّبتَني وَأَنحَلتَ جِسمي","فَاِرحَمِ اليَومَ دائِمَ الأَمراضِ",41,"ض",1,0],["أَنتَ عَونُ الشَيطانِ إِن لَم تُعِنّي","فَاِرعَ ما قُلتُ تَشفِ مِنّي قِماحا",42,"ح",2,0],["إِن تَعُد في الجِسمِ يَوماً رَوحُهُ","فَهُوَ كَالرَبعِ خَلا ثُمَّ عَمَر",43,"ر",1,0],["إِن تَعمَرِ الدُنيا فَلا بُدَّ مِن","يَومِ رَدىً يَترُكُها خاوِيَه",44,"و",3,0],["إِن تُعيدوها نُعِد لَكُمُ","مِن هِجاءٍ سائِرٍ كَلِمُه",45,"م",2,0],["إِنْ تعْنَ مِصْرُ بِشَأْنِهِ وَلَهَا","فِي السَّبْقِ عَادَاتٌ وَمَا أَحْرَى",46,"ر",2,0],["أَنْتَ عَيْنُ العُقَابِ تَنْظُرُ مِنْ عَا","لٍ فَمَا فِي العَبَابِ إِنْ تَرْنُ سِرُّ",47,"ر",1,0],["إِنْ تَعْظُمِ السَّرَّاءُ فَهْيَ رَهِينَةٌ","بِإِجَازَةِ الضَّرَّاءِ ثُمَّ تُتَاحُ",48,"ح",1,0],["أنْتَ عَسّلْتَثَغْرَها فقُلوبُ النَّاس","نَحْلٌ أكْمَامُهَاشَفَتَاهَا",49,"ا",3,0],["أنتِ علّمْتنِي البيان فما لي","كلّما لُحْتِ حار فيكِ بياني",50,"ن",2,0],["أنتَ عَمَرْتَ الأرضَ من يَبَاب","لولاك ما حَبَا عليها حَابِي",51,"ب",2,0],["أنت عند القبر ساهٍ، وأنا","أحمل الأجداث طرّاً في فؤادي",52,"د",2,0],["إنْ تُعْقَدِ الحَفلاتُ كنتَ مقدَّماً","أو تُنبرِ الأمراءُ كنتَ قريعا",53,"ع",2,0],["أنت عندي في حالة المرحوم","أن أدهى من أن ينام سليمي",54,"م",2,0],["أنت عندي كماء بئرِك في الص","يفِ ثقيل يعلوه بردٌ شديد",55,"د",1,0],["أنتِ عيشي، نعم، ورؤيتك الخل","دَ، وَكُنْت الحَدِيثَ والأَشْغَالا",56,"ل",2,0],["إن تعي بالزمن الطويل فربّما","صحب الأناة الصّانع المتأنّق",57,"ق",1,0],["أنت عوني والمساعد أن","قد لي سيف البلا كبدي",58,"د",2,0],["أنت عين مع العمى قام مصبا","ح ضياها بكشف ليل الضلال",59,"ل",1,0],["إن تعد أغتفر لدهري ما فا","ت وإلا فقد ترى الحر جلدا",60,"د",2,0],["إِن تُعرِضي وَتَضِنّي بِالنِوالِ لَنا","فَواصَلن إِذا واصَلتِ أَمثالي",61,"ل",2,0],["إن تعذرِي فالعذرُ منك سجيةٌ","ووِدادك النامِي كظلٍّ زائلِ",62,"ل",1,0],["أنتَ عشْ وانتعشْ وزدْ واحم واحمد","واسلُ واسترْ أيا طويلَ النجادِ",63,"د",1,0],["أنت عيدٌ لنا وأيامنا صارتْ","برؤياك كُلُّها أعيادَا",64,"د",2,0],["أَنتَ علَّمتهُ عليكَ التجَنِّي","حينَ أَقصيتهُ ولمْ يَجْنِ ذَنْبا",65,"ب",2,0],["إِن تَعمَ عَن رُشدِها قَومي فَلا عَجَبٌ","مِن قَبلِها عَمِيت عَن رُشدِها مُضَرُ",66,"ر",1,0],["أنت عطل وإن فخرت كما الطنبور","عطل إذا نأى عنه زير",67,"ر",1,0],["أَنتَ عنّي وعَن ثنائي غنيٌّ","ما لعلياكَ بالثناءِ اِعتلاءُ",68,"ا",2,0],["أنتِ علمتِ فؤادي","فيكِ كيفَ يتألمُ",69,"م",1,0],["إن تعيني على همومِ الليالي","فاحملي شطرها وأحملُ شطرا",70,"ر",2,0],["إن تعشْ يرجعِ المنامُ إليها","أو تمتْ بعدها ففي الحبِّ متنا",71,"ن",2,0],["أنت عند التجريد ضوءٌ ولكن","أنت عند اللباس كالمنجُوفِ",72,"ف",1,0],["إن تعد عادت من الوصل وريقه","تونق العين بأزهار أنيقه",73,"ه",1,0],["إِن تُعارِض بكِ الرجالَ نساءٌ","عارَضتهم بالحُجَّةِ البَيضاء",74,"ا",2,0],["إن تُعْزَ للغُصن الميَّاس قامتُه","فإنّ للدِّعص منه ثِقْلَ مؤتزرِ",75,"ر",1,0],["أَن تُعرِضوا مِن غَيرِ ما سَبَبٍ","تَتَشَبَّثونَ بِهِ وَلا عُذرِ",76,"ر",1,0],["أَنتِ عَرَّضتِني بِإِرسا","لِكِ اللَحظَ لِلفِتَن",77,"ن",1,0],["أَنتَ عَونُ القَليلِ نَصّارَةُ المَظ","لومِ غَوثُ المُستَصرِخِ المُستَجيرِ",78,"ر",1,0],["أنت على ضعف حالتي أبداً","أشفقُ من والد على والدِ",79,"د",1,0],["أَنتَ عَلى أَن أَعيشَ مُقتَدِراً","يا قاتِلي لَو رَعَيتَ في الأَجرِ",80,"ر",1,0],["إن تُعرِضي عنِّي دلالاً تندَمي","هل مثلَ قلبي في الهوى تَجِدينا",81,"ن",2,0],["إنِ تَعبثوا بحقوقِها وشُعورِها","حَفِظَت عُروبَتَها بقَلبٍ حاقد",82,"د",1,0],["أَنتَ عَبد اللَه ذو الشرف","وَهو عَبد اللَه ذو السرف",83,"ف",1,0],["أَنتَ عِندي خُزَيمَةُ الشاهِد الصا","دِقُ إِذ كانَ شاهِداً لِلنَبِيِّ",84,"ي",1,0],["أَنتَ عِمادُ الدُنيا وَأَنتَ عِما","دُ الدينِ