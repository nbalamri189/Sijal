39,"بسكوتة!","https://www.poetsgate.com/ViewPoem.aspx?id=195175",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5957,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182458",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[4442,"فتح الله للحقيقة بابا","https://www.poetsgate.com/ViewPoem.aspx?id=170992",""],[6084,"وليلة وافانى الزمان بجيشه","https://www.poetsgate.com/ViewPoem.aspx?id=170869",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[6102,"كُرَةُ النَّدَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=186288",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[549,"كي لا يميل الكوكب","https://www.poetsgate.com/ViewPoem.aspx?id=213799",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""],[6344,"سؤالٌ خارج حدود النُّبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87961&r=&rc=1",""]],"verses":[["فَفَرَّجَ ضيقَ القَومِ عَنّا طعانُهُ","وَشَتَّتَ شَملَ الكُفرِ عَنّا ضِرابُهُ",0,"ب",2,0],["فَفَرَّقتَ فَرعَيها وَكُنتَ سَدادَها","إِذا كانَ يَومٌ بالِغاً كُلَّ مُعظَمِ",1,"م",1,0],["فَفَرّوا وَشَدَّ اللَهُ رُكنَ نَبِيِّهِ","بِكُلِّ فَتىً حامي الحَقيقَةِ باسِلِ",2,"ل",1,0],["فَفَرّوا إِلى حِصنِ القُصورِ وَغَلَّقوا","وَكائِن تَرى مِن مُشفِقٍ غَيرِ وائِلِ",2,"ل",1,0],["فَفَريقٌ هالِكٌ مِن عَجَفٍ","وَفَريقٌ كانَ أَودى فَذَهَب",3,"ب",1,0],["ففرحَةُ الموهوب أعدِمتُها","وترحةُ المسلوب أردفْتُها",4,"ت",3,0],["فَفَرَّقتَ حَتّى لَيسَ غَيرَ مُفَرِّقٍ","وَخاصَمتَ حَتّى لَيسَ غَيرَ التَخاصُمِ",5,"م",1,0],["فَفَرَّقَ بَينَ السابِقينَ بِطَعنَةٍ","عَلى عَجَلٍ مِن سَلهَبٍ غَيرِ ناصِلِ",6,"ل",1,0],["ففريق مقلد لسواه","وفريق اباح ما لا يباح",7,"ح",1,0],["ففرنسا ذلك الشعب العزيز","ما له من بأسكم حرز حريز",8,"ز",1,0],["فَفِراقٌ يَكونُ فيهِ دَواءٌ","أَو فِراقٌ يَكونُ مِنهُ الداءُ",9,"ا",2,0],["فَفَريقٌ مُمَتَّعونَ بِمِصرٍ","وَفَريقٍ في أَرضِهِم غُرَباءُ",10,"ا",2,0],["فَفَرحَةُ الناسِ بِإِدبارِهِ","كَغَيظِهِم كانَ بِإِقبالِهِ",11,"ل",2,0],["فَفِرَّ إِلى اللَهِ مِن لُؤمِهِم","فَإِنّي أَرى الناسَ قَد أَصلَدوا",12,"د",3,0],["فَفِراقٌ أَصابَني مِن فِراقٍ","وَفِراقٌ أَصابَني مِن صُدودِ",13,"د",1,0],["ففرطُ البعدِ عن عن وطنٍ وأهلٍ","حِمامٌ قبلَ أنْ تلقى الحِماما",14,"م",2,0],["ففرَّقَ بيننا سَفَهاً","وعندَ اللهِ نجتمعُ",15,"ع",1,0],["فَفَرَغنَ مِن سَبعٍ وَقَد جُهِدَت","أَحشاؤُهُنَّ مَوائِلَ الخُمرِ",16,"ر",1,0],["فَفَرى جَمّاعُهُنَّ كَما","قُدَّ مَخلولانِ مِن عُصبِ",17,"ب",1,0],["فَفَرَّقتُمُ أَشياعَهُ وَهَدَمتُمُ","بِمُلكِكُمُ العادِيِّ مُلكاً مُوَلَّدا",18,"د",2,0],["فَفَرِّجي كُربَةً شَجيتُ بِها","وَحَرَّ حُزنٍ في الصَدرِ كَاللَهَبِ",19,"ب",1,0],["فَفَرِّق مالَكَ الجَمِّ","وَخَلِّ الأَرضَ تَسبيلا",20,"ل",2,0],["ففريق في جنان","وفريق في سعير",21,"ر",1,0],["ففرنسا همة لا تنثني","أمشت في النار أم تحت الجليد",22,"د",1,0],["فَفَرَّقتُ المَواكِبَ عَنهُ قَهراً","بِطَعنٍ يَسبُقُ البَرقَ اليَماني",23,"ن",2,0],["فَفَرَرْتِ مِنْ قَفَصِ الْكَفِيلِ","إلى الْفَضَاءِ الأَوْسَعِ",24,"ع",1,0],["ففرّق الدهر شملينا وجرّعني","بغير ذنب كؤوس الصبر غسلينا",25,"ن",2,0],["ففرَّقنا دَهر وشتّتَ شملَنا","كذلك دَأْب الدهر مُعْط ومانعُ",26,"ع",1,0],["ففرارا من المذلّة في آ","دَمَ كان الفرارُ من إبليسِ",27,"س",1,0],["فَفَرَعتَ مِنها كُلَّ ما لا يُرتَقى","إِنَّ النُجومَ قَلائِصٌ ما تُركَبُ",28,"ب",1,0],["ففرقنا جمعا وكدّر صفونا","وجوّعنا جوعا فقدنا له الصبرا",29,"ر",2,0],["ففروا خِفافاً وهي ملء بيوتهم","فما بتن إلا فارغات خواليا",30,"ي",2,0],["ففر بهم قد اودعوا فيه مركب","يظن بأن البحر فيه لهم بقيا",31,"ي",2,0],["ففر طرف الدين وانجاب بكم","عند دجى الضلالة المحلولك",32,"ك",1,0],["فَفَرَّجَ اللَهُ وَالبِيضُ الحِدادُ لَنا","وَعِزَّةٌ لَم تَكُن يَوماً لِمَن غَشَما",33,"م",2,0],["ففررت منه إلى فتى","ما خاب معتصم ببابه",34,"ب",2,0],["فَفرقةُ الحشوِ قَومٌ قد يصاحبهم","في الحقِّ سو