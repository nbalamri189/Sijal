",""],[5232,"معاذَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=212799",""],[5246,"لينظر في طلابه وهي عادة","https://www.poetsgate.com/ViewPoem.aspx?id=187049",""],[5277,"سيدةُ المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=200484",""],[592,"أما والذي لا يعلم الغيب غيره","https://www.poetsgate.com/ViewPoem.aspx?id=128850",""],[5376,"وهل للهجر قرب ما أنابا","https://www.poetsgate.com/ViewPoem.aspx?id=189753",""],[5431,"من شعر الحكمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=211087",""],[5431,"شعر معتّق...","https://www.poetsgate.com/ViewPoem.aspx?id=211179",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5525,"ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=7195",""],[5582,"أَغِزْلانَ رِيمٍ فِي الهَوادِجِ أَمْ دُمَى","https://www.poetsgate.com/ViewPoem.aspx?id=63578",""],[5660,"أَيُنقِذُ مِن حُكمِ القَضاءِ قَتيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32461",""],[5661,"خليلي قد اتسعت محنتي","https://www.poetsgate.com/ViewPoem.aspx?id=181396",""],[5671,"أضيق صدر الدهر والحزم واسع","https://www.poetsgate.com/ViewPoem.aspx?id=169351",""],[5720,"سَتَصْلَاهُمْ جَهَنَّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=204856",""],[5790,"ذكر الحمى فصبا وكان قد ارعوى","https://www.poetsgate.com/ViewPoem.aspx?id=112164",""],[5848,"أول إرهابيه سعوديه","https://www.poetsgate.com/ViewPoem.aspx?id=53213",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5909,"وإن أنتِ لم تستجيبِ لهذا !","https://www.poetsgate.com/ViewPoem.aspx?id=209204",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6069,"وقفت مع العشاق في كل موقفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105709",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِن أَنا أَهلَكتُ الزَمانَ فَما الَّذي","يُصَدَّعُ عَزمي في صُدورِ العَظائِمِ",0,"م",1,0],["وَإِن أَنا أَضمَرتُ السَلوَّ تَراجَعَت","مِنَ الشَوقِ أَخلاقٌ يُزِلنَ التَخَلُّقا",1,"ق",2,0],["وَإِن آنَسَ الأَضيافَ صَمَّتَ كَلبَهُ","وَطَأطَأَ أَعناقَ المَطِيِّ الصَوارِفِ",2,"ف",1,0],["وَإِن أَنا لَم يَستَنزِلِ المَجدُ حَبوَتي","فَلا أَهَلَت مِنّي الرُبى وَالمَرابِعُ",3,"ع",1,0],["وَإِن أَنسَ يَوماً ذَمَّكُم يُمسِ فِعلُكُم","عَلى الذَمِّ عِندي مِن أَشَدِّ البَواعِثِ",4,"ث",1,0],["وَإِنّا نَرى لِجِوارِ الدِيارِ","حُقوقاً فَكَيفَ جِوارُ النَسَب",5,"ب",1,0],["وَإِنّا نَقودُ الخَيلَ تَحكي رُؤوسُه","رُؤوسَ نِساءٍ لا يَجِدنَ فَوالِيا",6,"ي",2,0],["وَإِن أَنتُمُ جِئتُم وَقَد حيلَ بَينَكُم","وَبَيني بِيَومٍ لِلمَنونِ عَصيبِ",7,"ب",1,0],["وَإِنْ أَنَا أَرْجَأْتُ الأُمُورَ إلَى غَدٍ","طَعَنْتُ بِغَرْبِ الْعَجْزِ فِي ثُغْرَةِ الْحَزْمِ",8,"م",1,0],["وإنْ أنْتَ لم تَفْعَلْ فما أنْتَ في الوَرى","بأوّلِ موْلَى جارَ في حُكْمِ عبْدِهِ",9,"د",2,0],["وإنْ أنْتَ بالإقْبالِ قابَلْتَ وَفْدَها","فتَسْمَحُ بالأمْداحِ فيكَ القَرائِحُ",10,"ح",1,0],["وإنْ أنتَ في روْضِ الجِهادِ غَرَسْتَهُ","تَبسّمَ عنْ زَهْرِ الفُتوحِ افتِتاحُهُ",11,"ح",2,0],["وَإِن أَنتَ نازَلتَ الكَريمَ فَلاقِهِ","بِما أَنتَ مِن أَهلِ المُروءَةِ قائِلُه",12,"ل",2,0],["وَإِن أَنتَ نازَلتَ اللَئيمَ فَكُن فَتىً","تُزايِلُهُ في فِعلِهِ وَتُحامِلُه",12,"ل",2,0],["وَإِن أَنعَمتَ بِالإِصلاحِ فَاِبدَأ","بِتِلكَ فَإِنَّها بَيتُ القَصيدِ",13,"د",1,0],["وَآن أَنْ تُطْلَقَ العَزَائِمُ مِنْ","ذَاكَ الجُمُودِ المُوْرُوثِ مِنْ قِدَمِ",14,"م",1,0],["وأنا نرى من قد تأبّط شَره","بعين تَقُدّ الإبط أو تَخلع الكَتْفا",15,"ف",2,0],["وأن أنا أرسلت الحديث فأصْغيا","وإلاّ فما يُجدي لسمعكما قرعي",16,"ع",2,0],["وَإِنّا نُهينُ المالَ في غَيرِ ظِنَّةٍ","وَما يَشتَكينا في السِنينَ ضَريرُها",17,"ر",3,0],["وَأَنّا نَزَعنا المُلكَ مِن عُقرِ دارِهِ","وَنَنتَهِكُ القَرمَ المُمَنَّعَ جانِبُه",18,"ب",2,0],["وإن انتزاعَ الحقّ من كفّ غاصبٍ","وقد نَشَبتْ أظفارُهُ كلَّ مَنْشبِ",19,"ب",1,0],["وإن انتظامَ الفصلِ والفضلِ في يدٍ","لشيءٌ إلى السادات جِدُّ مُحبَّبِ",19,"ب",1,0],["وإن أنت لم تردَعك رادعة النُّهى","فعنديَ مشحوذ الغِرارَينِ مقصلُ",20,"ل",1,0],["وإن انتهى خَبري إلى","من كنتُ أَخدُمُه كفاني",21,"ن",2,0],["وَأَنّا نُطعِمُ الأَضيافَ قِدماً","إِذا العَذراءُ أَخرَجَها القُتارُ",22,"ر",1,0],["وإنا نحن قوم قد أُهنَّا","وإنا نحن قوم أبرياءُ",23,"ا",2,0],["وإنّ أناساً صِرْتُ جارَ بيوتِهم","عباديدُ شَذْرٍ فُصِّلَتْ بزبرجَدِ",24,"د",1,0],["وَإِن أَنهَضَتهُ كافِئاً في مُلِمَّةٍ","مِنَ الدَهرِ سَلَّت سَيفَها مِن قِرابِها",25,"ب",3,0],["وَإِن أَنا أَهدَيتُ القَريضَ مَجازِياً","فَلَن يوكَسَ المُهدى إِلَيهِ وَلا المُهدي",26,"د",2,0],["وَإِنّا نَرى سيما النَبِيِّ مُحَمَّدٍ","وَسُنَّتَهُ في وَجهِكَ الضاحِكِ الطَلقِ",27,"ق",1,0],["وَإِن أَنا لَم أَجعَل بِأَعناقِ طَيِّءٍ","مَواقِعَ يَبقى عارُها غَيرَ ذاهِبِ",28,"ب",1,0],["وإن آنسَتْ شَخصاً من الإنسِ صَرْصَرَتْ","كما صَرصرَتْ في الطِّرسِ أقلامُ كاتبِ",29,"ب",1,0],["وَإِن أَنقَذتَ نَفسَكَ في مَعادٍ","وَصَيَّرتَ العَفافَ بِها مَعادِن",30,"ن",1,0],["وأنا نذيرك إنْ تُلاحظ صبوةً","فاللّحظُ منكَ لنارِها كِبريتُ",31,"ت",1,0],["وَإِن أَنعَموا ثُنّوا عَلَيهِ بِصالِحِ","وَلَم يُتبِعوا الإِحسانَ مِنّاً مُكَدَّرا",32,"ر",2,0],["وَأَن أَنزَلتُها في الوُد","دِ مِنّي السَمعَ وَالبَصَرا",33,"ر",2,0],["وَإِنَّ اِنهِمالَ الدَمعِ يا لَيلَ كُلَّما","ذَكَرتُكِ يَوماً خالِياً لَسَريعُ",34,"ع",1,0],["وإن أنا أطربتُ هَذي النُفوسَ","فَصَوتُكَ لا صَوتِيَ المُطرِبُ",35,"ب",1,0],["وَإِنَّ إِنصِرافي عَنكِ لا تُنقِصينَ لي","مِنَ الحَقِّ شَيئاً فَاعلَمي لِثَقِيلُ",36,"ل",1,0],["وَإِن أَنظَرَتهُ خُطوبُ الزَما","نِ عُضَّ بِنابٍ شَديدِ العَصَل",37,"ل",1,0],["وَإِن أَنا قُلتُ لا تَحمِل جُرازاً","فَهُزَّ أَخا السَفاسِقِ وَاِضرِبَنّي",38,"ن",2,0],["وَإِن أَنتَ في مَجدٍ أَصَبتَ غَنيمَةً","فَعُد لِلَّذي صادَفتَ مِن ذاكَ وَاِزدَدِ",39,"د",1,0],["وإنا نزلنا بمنحدر","وهم طفقوا يصعدون الأكاما",40,"م",2,0],["وأنانيةُ أنثى لم تُطِقْ","فاتناً تملكهُ أنثى سواها",41,"ا",3,0],["وَإِنّا نَقودُ الخَيلَ تَحكي رُؤوسُها","رُؤوسَ نِساءٍ لا يَجِدنَ فَوالِيا",42,"ي",2,0],["وَإِنْ أَنْتُمَا غَنَّيْتُمَانِيَ فَلْتَكُنْ","أَنَاشِيدَ يَهْفُو دُونَ تَسْمَاعِهَا الصَّبْرُ",43,"ر",1,0],["وَإِنْ أَنْتَ أَتْرَعْتَ الأَبَارِيقَ فَلْتَكُنْ","سُلافاً وَإِيَّاكَ الْفَضِيخَ مِنَ التَّمْرِ",44,"ر",1,0],["وَإِنَّ أَنْصَارَهُمْ قَلِيلٌ","وَإِنَّ أَعْدَاءَهُمْ كُثَارْ",45,"ر",1,0],["وإن أنا حييت الشآم تنفست","ربى الأرز عن أزهاره بلهاتي",46,"ت",2,0],["وأنا نمضغُ الموتَي","نش من ظلمٍ ومن ذلّ",47,"ل",1,0],["وإِنْ أُنْشِدَتْ فِي دار حُكْمِكَ مِدْحَتي","لقد جُلِيَتْ بِكْراً على خَيْرِ مُفتَضِّ",48,"ض",1,0],["وإن أنصفت والانصاف أولى","بمثلك فاعلمنْ يا ابن الوزير",49,"ر",1,0],["وأنِ انقضيْتَ، وما انقضَتْ لي عزمةٌ","كلا، ولا فَلَّ المشيبُ سلاحي",50,"ح",2,0],["وإن أنت لم تغفل فما أنت في الورى","بأول مولى جار في حكم عبده",51,"د",2,0],["وإن أنا أرجأت الأمور إلى غد","طعنت بغرب الفخر في ثغرة الحزم",52,"م",1,0],["وأنَّا نعودُ بنفضِ الأكفِّ","عنكَ وأنتَ العظيمُ الخَطَر",53,"ر",1,0],["وإن أنس لا أنس \" الفرات \" وموقفا","به مثلت ظلم النفوس الفظائع",54,"ع",1,0],["وأنَّا نسينا عناءَ القلوب","لأنَّا بهذى الدُّجى هادئونا",55,"ن",2,0],["وإن أنسَ لآ أنس حول \" الفرات \"","مناظر تُصبي الحليمَ الرزينا",55,"ن",2,0],["وإن أنت لم تردَعك رادعة النُّهى","فعنديَ مشحوذ الغِراريين مقصلُ",56,"ل",1,0],["وَأَنْ أَنْزَلْتُها في الوُدِّ","مني السمعَ والبصرا؟",57,"ر",2,0],["وَإِن أَنتَ فاكَهتَ الرِجالَ فَلاتَجِم","وَقُل مِثلَ ما قالوا وَلا تَتَزَنَّدِ",58,"د",1,0],["وَإِنَّ اِنثِنائِيَ عَن هاشمٍ","بِما اِسطَعتُ في الغَيبِ وَالمَحضَرِ",59,"ر",1,0],["وإنّ انقيادى طوعَ ما أنا كارهٌ","يدلُّك أنَّ المرءَ ليس بقادرِ",60,"ر",1,0],["وإن أنت توليه النوال إلاهه","بعيد الذي لاقاه من ضره بدنا",61,"ن",2,0],["وَإِن أَنتُمُ أَغفَلتُمُوها تَضاءَلَت","وَلَم يَنتَفِع فيها أُوَامٌ لِحائِمِ",62,"م",1,0],["وَإِن آنستُما بُخلاً فَلَسنَا","بِأَوَّلِ مَن رَجا حَرَجاً بَخِيلا",63,"ل",2,0],["وَإِن أَنكَرَت دَعواهُم فَكُلٌ","يُؤيد مُدَّعاهُ بِشاهِدينِ",64,"ن",1,0],["وَإِنّا نراكُم تنظرونَ عيوبهُ","مَحاسنَ مسحورينَ في شكلهِ سحرا",65,"ر",2,0],["وَإِن أَنكروا مِن غيّهم خلقَ ربّنا","جَميعَ الّذي فيهم وفي غيرهم أجرى",65,"ر",2,0],["وإن أنا ناجيتُ القلوبَ تمايلتْ","بها نسماتُ الشعرِ قلباً على قلبِ",66,"ب",1,0],["وان انا لم اسفح على السفح عبرتي","فلا اضحك الرحمن لي بعدها سنا",67,"ن",2,0],["وإن أنت لحت تزول النحوس","ويبسم حتى الزمان العبوس",68,"س",1,0],["وإن أنا زرت الناس فالناس فيهم","نصيح ومذاق وأخر قالي",69,"ل",2,0],["وإن أنا أكثرت المقام فربما","رماني إخوان الصفا بملال",69,"ل",1,0],["وَأَنَّا نَرْتَجِي لَهُمْ بَشِيراً","يَقُولُ أَلاَ انْعَمُوا بِالْقَوْمِ عَيْنَا",70,"ن",2,0],["وان أنس للتاريخ لا أنس موقفا","لآل عطا في صدقهم إذ تصلبوا",71,"ب",3,0],["وإن أنا زاحمتُ حتى أموت","دخلتُ وقد خرجت مهجتي",72,"ت",2,0],["وإن أنتَ لم تَفعَل فَهَل أنتَ مُكرِمي","بِحَلقِهِمَا من مُحرِزٍ ومُقَاتِلِ",73,"ل",1,0],["وإن أنشَدتِ من شِعري قليلاً","تصبّاني على فيكِ الصّبوح",74,"ح",1,0],["وَإِنْ أَنا أَغْبَبْتُهُ زائِراً","تَعَهَّدَنِي تائِقاً واقْتَضانِي",75,"ن",2,0],["وَإِن أَنتَ آثَرتَ تَسريحَهُ","فَرَأيُكَ أَسمى وَأَسنى وَأَرقى",76,"ق",2,0],["وإن أَنا لا أَسعى له خفتُ عارَه","وَشبعُ الفَتى عارٌ إذا جاعَ صاحبُه",77,"ب",2,0],["وإِن أَنا جُبتُ البيدَ في طَلَبِ العُلى","فكم جابها قَبلي كِرامٌ وما عيبوا",78,"ب",3,0],["وَإِنْ أَنتَ لم تملك من الأَمر غير ما","تضرِّبه فالعجزُ أَولى وَأخلق",79,"ق",1,0],["وإِن أَنت لم توسر فَلا تَكُ عائِلاً","فَإِنّ يَسار المُعسِرينَ التَعزُّبُ",80,"ب",1,0],["وإن أنكرتَ فالإنكا","رُ من عَينَيكَ عِرفانُ",81,"ن",1,0],["وإن أَنا ثقَّلْتُ في مَطلبي","فمثلكَ من للصديق احتَملْ",82,"ل",1,0],["وإن أنا أتربتُ فالمكرمات","تُحدِّثُ بأنِّيَ فَعَّالَها",83,"ل",3,0],["وإنْ أنختُ لدى علياك راحلتي","كنتُ الأَمير وكان الدهر مأمورا",84,"ر",2,0],["وإن أنا لم اشكر صنيعك مادحا","ظلام وماوا في على أفق فجر",85,"ر",1,0],["وإن أنا لم أصدق بدعواي فيكم","فيؤتُ بما باء اللعين ابن ملجمِ",86,"م",1,0],["وإِنْ أَنْجَبَتْهُ أَزْدُهُ وتُجِيبُهُ","فَصَفْوَتُهُ عَدْنانُهُ وَمَعَدُّهُ",87,"د",2,0],["وإِن أنا لم أصبر على جَوْر دَلّهِ","متى أدنُ منه ينأ عني ويبعدِ",88,"د",1,0],["وأن أُنسَى وعندك باعثاتٌ","على حقّي ومُذكِرةٌ بشاني",89,"ن",2,0],["وإن آنسوا من جو أرضٍ مخافة","طَهورِ الثَّرى لوَّاحةٍ للمناهل",90,"ل",1,0],["وَإِن أُناسٌ وَنَوا عَن كُلِّ مَكرُمَةٍ","وَضاقَ باعُهُم عَن وُسعِها وَسِعوا",91,"ع",3,0],["واِنْ أنفدَ القطرُ تَسكابَهُ","فدِيمةُ جفنيَّ لم تَنْفَدِ",92,"د",1,0],["وإن أنت أسقطت الأخير فإنه","فريضة إسلام برب البرية",93,"ه",1,0],["وإن أنت دافعت الحسود بحجةٍ","فلا تعد والجبار يخذلُ من كذب",94,"ب",1,0],["وإن أُنْمي لِسُدَّتِكُمْ بِطَوْري","يَقولُ البَدْرُ إنِّي مَهْدَوِيُّ",95,"ي",1,0],["وإن أنتما لم تعرفاه فإنه","يفوح نسيم المسك من جنباته",96,"ت",2,0],["وإن انجراح الثكل عند اندمالها","وليس لمقذوف مدى الدهر من دمل",97,"ل",1,0],["وإنّا نُرَجِّي أن يُتَاحَ لجَيْشِنا","ذُرَى مُتْوَحٍ مُنْقَادَةً بِزِمامِ",98,"م",1,0],["وأَنْ أُناجي اللهَ مُسْتَمتعاً","بِخَلْوةٍ أَحْلى مِنَ الشَّهْدِ",99,"د",1,0],["وأَنّا نَجْعَلُ الْقُرآنَ جِسْراً","فَمَصْدَرُنا عَلَيْهِ والْوُرُودُ",100,"د",1,0],["وإنْ أنتَ طاعَنْتَ أغنَوْك في ال","قناةِ وقد حضروا عن سِنانِ",101,"ن",1,0],["وإنْ أنكرتُما منّي ضلالاً","فماذا ضرّ غيري من ضلالي",102,"ل",2,0],["وإنْ أنتَ أفقدتنا غيرَه","فأَهدِ إليه البقاءَ الطّويلا",103,"ل",2,0],["وإنْ أنتما اِستوقفتما عن مَسيلها","غُروبَ مآقينا فما هنّ وُقَّفُ",104,"ف",1,0],["وإنْ أنْهَبَ الأموالَ جودُ أكفّهمْ","أفاؤوا بأطرافِ الرّماح وأخلفوا",105,"ف",3,0],["وإن آنسوا نارَ الوغى خَدَفوا به","جراثيمَها إن سالماً أو مشائطا",106,"ط",2,0],["وَإنْ أنتَ لم تحرسْكَ نفسُك نَجْدَةً","فليس بحامٍ عن جنابك حارسُ",107,"س",1,0],["وَإِنْ أَنتِ يَوماً تخيّرتِ لي","فَشيبِيَ أصلحُ من مِيتتِي",108,"ي",1,0],["وأنا نيتي به وله","حاش لله أن أكون أنا",109,"ن",2,0],["وإن أنكرت حالي","وكنت لي تشين",110,"ن",1,0],["وأنا ناظر لهم فكأني","مصحف قد أقيم في بيت فاسق",111,"ق",1,0],["وإن أنا لا أدعو يقول ألا تدعو","على الحب أرواحاً بذلت وأنفسا",112,"س",2,0],["وأنا نفس جميع ال","ناس نسلي وجدودي",113,"د",2,0],["وأنا ناري إذا ما","شئت أشقى بخلود",113,"د",1,0],["وإِن انْتَقَمتَ فإِنَّ أَيْ","سَرَ ما استحقُّوا الانتقامُ",114,"م",1,0],["وَإِنّا نُجَدِّعُ أَنفَ الفَخارِ","إِذا ما القِسيُّ غَمَمنَ الرِواقا",115,"ق",2,0],["وإن أنت متن الوزر أمسيت راكبا","فما أنت جانيه عليك مسطر",116,"ر",1,0],["وان انوار ذاك العصر ما برحت","تريك ما ازهرّ من علم وعمران",117,"ن",1,0],["وَإِن أَنا لَم أَبلُغ مَراماً أَرُومُهُ","فَكَم حَسَراتٍ في نُفوسٍ كَرِيمةِ",118,"ه",1,0],["وإنْ أنكر ذو النَّصْبِ","عندي فيهِ عِرْفانُ",119,"ن",1,0],["وإن أنس لا أنس الهمام أخا النهى","فتى كنهه عن طائر الفكر عازب",120,"ب",1,0],["وإن أناساً بالإمام تهاونوا","لأفضل منهم في اليهود وفي الرومِ",121,"م",1,0],["وإن أنصفوه إذن لأقيم","على القلب لا الأرض تمثاله",122,"ل",2,0],["وإِنْ أَنْكَرَتْ أَفْهامُهُمْ بعضَ هَمْزِهَا","فقد عَرَفَتْ أكبادُهُمْ صِحَّةَ الهَمْزِ",123,"ز",1,0],["وإن أنكر الضيفُ فضل الكرام","فهم في قطيعته أكرم",124,"م",1,0],["وإن انتزاعك سلطانهم","كنزع السلاح من القاتل",125,"ل",1,0],["وَإِنّ اِنشِعارَ القلبِ بِالهَجرِ وَالجَفا","وَضَبَّته وَصلٌ كَذاكَ تقرُّبُ",126,"ب",1,0],["وَإِنْ أَنْجَزَ الإِمْكَانُ يَوْماً بِجَلْسَةٍ","لَدَيْكَ أَتَاكَ الْقَوْلُ بِالشَرْحِ واللَّخْصِ",127,"ص",1,0],["وإن أنا لم أَذكرْ جميلَك في المَلا","فما أنا للفعلِ الجميلِ بذاكر",128,"ر",1,0],["وإنْ أنا لم أذكرْه في الناسِ مادحاً","فإنيَ غاوِ حائرٌ غيرُ راشد",129,"د",1,0],["وإن أنا أصلحتُ الفسادَ جهالةً","من الأمر أفسدت الذي هو صالح",130,"ح",1,0],["وإنْ أنصح الجهَّالَ أرجعِ بخِزْيةٍ","وتمزيق عِرْضٍ لم تَخِطْه المناصح",130,"ح",1,0],["وإنْ أنا لم أُحبِبْ ذوى النصح في الدنا","غُشِشْتُ وما لي غيرُ إبليسَ ناصحُ",130,"ح",1,0],["وإن أنهلت حسبها مورداً","ثغور الأعادي وثغر الأقاح",131,"ح",1,0],["وإن أنت قطعت العلائق نازحاً","عن الخلق أبصرت الحقائق تسطعُ",132,"ع",1,0],["وأنا نَبتَني شرف المعالي","وننعشُ عثرةَ المولى العديم",133,"م",1,0],["وَإِن أَنسَ لا أَنسَ الفَرِيقَ وَأَهلَهُ","وَرَبعاً بِهِ رَوضُ الهَناءِ نَضِيرُ",134,"ر",1,0],["وَإنْ أنْعَمُوا قُلْنَا غُيُوثٌ هَوَاطِلٌ","وَإنْ نَقِمُوا قُلْنَا لُيُوثٌ غَوَالِبُ",135,"ب",1,0],["وإن أنس لا أنس يوم التقينا","هنالك في المرقص الدائر",136,"ر",1,1],["وَإِن أنتَ وسطَ الدستِ قابلتَ وجههُ","فَعظّمهُ تَعظيماً وهلّل وكبّرِ",137,"ر",1,0],["وَإِن أَنا قبّلتُ البساطَ وكمّه","تطاولتُ في قولي وزدتُ تعظُّما",138,"م",2,0],["وإِن أَنت كيّفته كان في ال","كونِ غَيثاً وليثاً مهابا",139,"ب",2,0],["وَإِن أَنتَ لَم تَبغِ الزِيادَةَ في العُلا","فَأَنتَ عَلى النُقصانِ مِنهُنَّ حاصِلُ",140,"ل",1,0],["وَإِنَّ اِنفرادي عَنهُمُ وَتَغَرُّبي","تَرامى بِيَ الأَمواجُ وَالحَزنُ وَالسُهبُ",141,"ب",1,0],["وإِنْ أَنَا قصَّرْتُ في مَدْحِهِمْ","فقد بالَغَتْ هِمَّتي في هِجائي",142,"ا",2,0],["وإِنْ أَنا فارَقْتُ الشَّبابَ فإِنَّ لي","صَباباتِ نَفْسِ لا تَشيبُ فُروقُها",143,"ق",3,0],["وإِنْ أَنْكَر النّاسَ ما أَدَّعى","فقد عَلِمَ اللهُ مِصْداقَهُ",144,"ق",2,0],["وإن أنتَ حقَّقتَ القِراءَةَ فاحذَرِ الز","زِيادةُ فيها واسأَلِ العَونَ ذا القَهرِ",145,"ر",1,0],["وَإن أُنِيلُوا بُغيَةً فَكُلأَةٌ","بِحَيثُ لا تُهدَى لسَمعٍ نَبأَةٌ",146,"ه",1,0],["وإن أنسً لم أنس العوادي جوارياً","ترض القرى من مصدر العلم والصدرا",147,"ر",2,0],["وإن أَنا أثنيتُ الجميل جعلتُهُ","لمستوجب الشكر الجميل مؤثَّرا",148,"ر",2,0],["وَإِنَّ أَنْدَلُساً هَذِي لَمُعْجِزَةٌ","بَقَاؤهَا وَقَرارٌ فِي نَوَاحِيهَا",149,"ي",3,0],["وأن أنتم أمعرتم فتعففوا","وإن كان فضل الخير فيكم فأفضلوا",150,"ل",3,0],["وَإِن أَنصَفتَني أَحرَقتُ مِنهُم","بِنُضجِ الكَيِّ أَثباجَ البُطونِ",151,"ن",1,0],["وَإِن أنتمُ لَم تغضبوا بعدَ هذهِ","فَكونوا نساءً لا تعبّ من الكحلِ",152,"ل",1,0],["وإن أَنتَ لَم تَجعَل لِعِرضِكَ جَنَّةً","مِنَ الذَمِّ سارَ الذَمُّ كُلَّ مَسيرِ",153,"ر",1,0],["وإن أنكرت ما بي وساءت ظنونها","وقالت لها عني بشاميِّةٍ عفرا",154,"ر",2,0],["وإن أنكرتنا عصبةُ الصلح منهم","فللحق قوم آخرون بنا بروا",155,"ر",3,0],["وإن أنكر وامُلَ ابنِ يعقوب بيننا","فموسى على ما أنكروا شاهدٌ بَرُّ",156,"ر",1,0],["وإن أنكرت نجدٌ ليومك شمسها","ففي مصر يومٌ سابغ الحزن أو بد",157,"د",1,0],["وإن أنس لن أنس عقائل أحمد","وقد نهبت أحشاءهن المصايب",158,"ب",1,0],["وإنْ أنتَ أنعَمْتَ التأمُلَ خِلتَهَا","يَتيمَةَ دارِ المُلكِ تَمَّ بِهَا العِقدُ",159,"د",1,0],["وأن أناساً شبهوهُ بخلقِهِ","لقد عدلوهُ جل ذو العزِّ بالأمم",160,"م",1,0],["وان انتم تكاسلتم وخمتم","برغم منكم ابتدروا ابتدارا",161,"ر",2,0],["وإن أَنتَ ناديت أَهل الحفاظ","فعرِّض بذكرِيَ أَو نادِ بي",162,"ب",2,0],["وإن أنس لا أنس الفواطم والعدا","تجاذبها أقراطها والمعاضدا",163,"د",2,0],["وَإِن أَنتَ لَم تُبقِ بَينَ المَلامِ","وَبَينَ الغَرامِ فَتىً يَعقِلُ",164,"ل",1,0],["وإن أنت أقرأت أمرا بتحقق","فلا تزدنه إن أخذت على عشر",165,"ر",1,0],["وإنَّ أُناساً زوجوكَ فتاتَهم","لجِدُّ حراصٍ أن يكونَ لها بَعلُ",166,"ل",1,1],["وان انا اطلقت الأوابد في الضحى","ترامت إليَّ الشمسُ من برجها العالي",167,"ل",2,0],["وإن أنعَمتْ عفواً عليكَ بنعمةٍ","فتأتيكَ بالمكروهِ في صورةٍ أُخرى",168,"ر",2,0],["وإن أنت لن تشفي من الداء من يشفي","شكوتُ إلى علياكَ نفساً أطعنتُها",169,"ه",2,0],["وإن أنا في الدنيا تفكرتُ خامرت","فُؤادي وما إن لي سواكَ مُخامِرُ",170,"ر",1,0],["وإن أنا في الشيطان والنفس والهَوى","تفكرتُ ضاقَ الكونُ بي والمحاضِرُ",170,"ر",1,0],["وإن أنا في الأخرى تذكرتُ ساعةً","وفكرتُ نفسي يومَ تُبلى السرائِرُ",170,"ر",1,0],["وَإِن أَنتُما لَم تُسعِداني عَلى الأَسى","فلا تُعدِماني وَقفَةً وَتَوَجُّعا",171,"ع",2,0],["وَإِن أَنتَ لا قَيتَ في نَجدَةٍ","فَلا يَتَهَيَّبكَ أَن تَقدُما",172,"م",2,0],["وآن أن ترتوي نفوس","إلى لذاذاتها حِرَار",173,"ر",1,0],["وان أنس لا أنسى قبيلة خده","لدى شجر البستان فى مجمع النهر",174,"ر",1,0],["وإن أنفس ما يهدَى وأحمده","عقبى (....) القدر والهمم",175,"م",1,0],["وإن أنت تعكس ما قلته","يصح فجمعي في وحدتي",176,"ت",2,0],["وإن أنت من أهل القراض جعلتني","غلهي فوفقني إلى أحسن القرضِ",177,"ض",1,0],["وإن أنا عن أخلاقهم جئت مفصحا","لما وسع القرطاس ما أنا أشرح",178,"ح",1,0],["وَإِن أَنتَصِر مِنهُ أَكُن مثلَ رائِشٍ","سِهامَ عَدُوٍّ يُستَهاضُ بِها العَظمُ",179,"م",1,0],["وإن أنتَ أجزلتَ القريضَ فإنّه","لعنتر بعبس أو لعلقمة الفحلِ",180,"ل",1,0],["وإن أنتَ جشَّمتَهَا خُطَّةً","تُنافي رضاها تَجِدهَا مُطِيعَة",181,"ع",2,0],["وإن أنتُما أفشيتُماه فلا رأت","عيونُكما يوم الحساب محمّدا",182,"د",2,0],["وإن أناساً طاولوا ابن معيبدٍ","ليطوون احشاءً على الزفرات",183,"ت",1,0],["وَإِن أَنا لَم أَوقد ليَ الحَرب بِالظبا","فَلا رَجَّعت باسمي حداة القَوافل",184,"ل",1,0],["وان أنس لا أنس زين العباد","عليلاً يكابد أغلالها",185,"ل",3,0],["وإن أنتمو أنعمتمو وبذلتمو","فقد يستتم النعمةَ المتفضلُ",186,"ل",1,0],["وإن أنَا أرخيتُ الأعنَّةَ وانبرَى","بلغتُ وإن حاولتُ إدراكَ فرقد",187,"د",1,0],["وإنَّ إِناثاً فى العلا كخديجةٍ","فلَسنَ متى تُرجَى العُلا بإناث",188,"ث",1,0],["وَإِن أَنا أَبعَثُ ذهني لَهُ","لِفكرٍ أراهُ إِذن ما انبَعَث",189,"ث",1,0],["وَإِن أَنا حاوَلتُ القُعودَ تَواتَرَت","هُمومٌ مَتى تَعلَق بِروحِيَ تَجبذِ",190,"ذ",1,0],["وان انكرت دار الاحبَّة لوعتي","فآياتُ شوقي والغرام شواهدي",191,"د",2,0],["وَإِن أَنتَ عاشَرتَ الكِرامَ فَكُن لَهُم","أَميناً وَفِيّاً مُخلِصاً حازِماً أَمرا",192,"ر",2,0],["وإن أنت أزمعت الشخوص إلى حمى","ديارك والأوطان يوماً من الدهر",193,"ر",1,0],["وإن أنس لا أنس يوم المطار","وقد دنت الساعة القاضيه",194,"ي",2,1],["وأنا نجيّك والذي","يسقيك من ودّي هَتُونه",195,"ن",2,0],["وإن انتقامي لظلم الرجال","من البدء منكن حتى الختام",196,"م",1,0],["وإن أنا لم أرض الضمير بمنطقي","ولو أنا أرضيت الورى كنت خاسرا",197,"ر",2,0],["وَإِن أَنتُما حَيَّيتُماني تَحِيَّةً","فَلا تَعدوا ريحانَ قِلّايَةَ القِسِّ",198,"س",1,0],["وَإِنا نَستَضيء إِذا ضَلَلنا","بعَبد اللَه أَزكى الناس آلا",199,"ل",2,0],["وإن أنت لم تدرك حنانا لعيشة","فإن الردى أحنى عليك وأرحم",200,"م",1,0],["وأنانيةٌ تحل له القت","لِ لتحقيق غاية في كيانه",201,"ن",2,0],["وان أنس لا أنسى شواطئك التي","عليها أكف الزهر قد نسجت مرطا",202,"ط",2,0],["وان انا بالسِلوان حدَّثتُها فَما","حديثي لديها غير جَهلٍ مركَّبِ",203,"ب",1,0],["وإن أنس لا أنس الذين تظافروا","على الفتك بالجاني فقلت لهم مهلا",204,"ل",2,0],["وَإِنْ أَنْتَ أَفْنَتْكَ المَعَاني وَكُنْتَهَا","شَهِدْتَ المَغَانِي آهِلاَتِ الجَوَانِحِ",205,"ح",1,0],["وآن ان اشرع في المقصود","معتصما بالواحد المعبود",206,"د",1,0],["وآن أن أذكر قوماً درجوا","ومن مضيق شحهم قد خرجوا",207,"ج",3,0],["وإن أنت قاربتَ المَعاهد قل لَهَا","مَشوقٌ عَلَى عهد المحبة ثاوِيا",208,"ي",2,0],["وان انقطاعاً لانقراض مرادفٌ","فكلا بكل إن تشأ ذاك عرّف",209,"ف",1,0],["وَإِن أَناخ عَلى الأَفغان ذو جشعٍ","رأيت في فارِس من يدفع الجَشَعا",210,"ع",2,0],["وَآنَ أَن ترجع الأَيّام هاتِفة","أَن الجَلال إِلى أَوطانه رجعا",210,"ع",2,0],["وَإِن أَنا لَم أَنشر من الوجد ما اِنطَوى","فأَنتَ بِما تطوي الضُلوع عَليمُ",211,"م",1,0],["وان أَنتَ لم تَحمِ العيالَ مِنَ الطوى","اذا أَمنوا لم يَحمهم حِينَ تَفْزَعُ",212,"ع",1,0],["وإن انس لا أنسى الحسين تحوطه","أسود عرين من ذواته هاش",213,"ش",1,0],["وَإن أنحس أَيام لنا سلفت","بها شرين الهَوى غَيّاً وَبعناها",214,"ا",3,0],["وَإِن أَنتَ قَد كلفتها فوق وسعِها","تخلّت وَإِن أَلزمتَها الحَقَّ شذّت",215,"ت",1,0],["وإن أَنا لم أَمنحه إخلاص نيتي","فلا فرق ما بيني وَبين لَئيمِ",216,"م",1,0],["وإن أنسَ شيئاً فإني نسي","ت يا صاحبي أينا قد أساء",217,"ا",2,0],["وَإِن أَنتَ لَم تَعكسه يَوماً فَإِنَّهُ","يَلوح لَدى الأَفهام طَوراً وَيَعزُبُ",218,"ب",1,0],["وَإِنّا نُزَكِّيكُم وَنَحمِلُ كَلَّكُم","وَنَجبُرُ مِنكُم ذا العيالِ المُعَصَّبا",219,"ب",2,0],["وإِنّا نَرى مِن أُعدِمَ الحِلمَ مُعِدماً","وإِن كانَ مَدثوراً مِنَ المالِ مُترِبا",219,"ب",2,0],["وإن أنتم لم تغضبوا بعد هذه","فكونوا نساءً لا تعاب من الكحل",220,"ل",1,0],["وإن أنت شبهت الإمام وجوده","بمعنٍ أو الطائي فإنك هاضمه",221,"م",2,0],["وَإِن أَنتَ لَم تَرِدِ الفِرِنجَ بِوَقعَةٍ","فَمَن ذا الَّذي يَقوى لِبُنيانِها هَدَما",222,"م",2,0],["وان انا لم اكتب رثاك بمهجتي","فلا خط في طرس المثوية لي سطر",223,"ر",1,0],["وإنْ انتْم لم تذْعروهم بسَطْوةٍ","فما الأمرُ مسْموعٌ ولا الخوف لازم",224,"م",1,0],["وإن أنتَ لم تكفف طويلَهُ وانثنت","معاطِفُكَ الهيفاءُ أقبلتَ بالقبضِ",225,"ض",1,0],["وإن أنتم دعيتم للطعامِ","فأوصيكم كلوا أكل الكرامِ",226,"م",1,0],["وإن أنا طلقت النهار بجوزها","خطبت خدارياً من الليل داجيا",227,"ي",2,0],["وَأَنانِيَّتي مَثارُ بَلائي","وَهيَ داءُ الحَياة وَهيَ المَنونُ",228,"ن",1,0],["وَإِن أَنا أَعطَيتُ الزَمان مَنالَهُ","فَلا ضَمَّني عَمي النَبيل وَلا أَبي",229,"ب",2,0],["وَأَنا ناظمٌ ما عَلَّمتَنِي","وَأَنا عَونُكَ إِن خَطبٌ أَلَمْ",230,"م",1,0],["وَإِن أُنزِلَ الخُدَّامُ يَوماً لِضَيعَةٍ","يُقالُ لَهُ اِنزِل عَن حِمارِكَ أَقلَفُ",231,"ف",1,0],["وإن أنا لم أوفي حق حزني","عليك فلست بالخل الموافي",232,"ف",2,0],["وانا نهني عيدنا ببقائكم","ولسنا نهنيكم بفطر ولا نحر",233,"ر",1,0],["وإِنْ أَنكرت مقلتاه دمي","فسائلْ به حُمرةَ الوَجْنتيْنِ",234,"ن",1,0],["وإن أنس لا أنسى بنات الهدى غدت","سبايا على عجف المطا كالإما أسرى",235,"ر",2,0],["وإن انكر الأسباب فاصدعه لائما","وإن صده المقدور كان له العذر",236,"ر",1,0],["وإنَّ أنَّ سَوفَ ثم واجل","نعم وليتَ جيرُ آيٍ وجلل",237,"ل",1,0],["وإن أنشوا تدفقت المعاني","وإن نطقوا يحيزك الذكاء",238,"ا",2,0],["وإن أنس لا أنس الحسين وقد غدا","على رغم أنف الدين نهب الصوارم",239,"م",1,0],["وان أنتم لم تثأروا بدمائكم","فكونوا عبيدا أو نعاما مصلما",240,"م",2,0],["وإن أنت قريب الفوت","أو ساقط فلا ترفع",241,"ع",1,0],["وَإنا نُعَزِّيكَ لا ناصِحينَ","وَلَكن قَضاءً لِما قَد وَجَب",242,"ب",1,0],["وإِنْ أَنْسَ لا أَنْسَ أُمي تَقُولُ","وفي جَفْنِها حائرُ الأَدْمُعِ",243,"ع",1,0],["واِنّا نَذودُ المُعلَمينَ إِذا اِنتَخَوا","وَنَضرِبُ رَأسَ الأَصيَدِ المُتَفاقِمِ",244,"م",1,0],["وإن أنا لم أترك رقاش وجمعهم","أذلَّ على وطء الهوان من النعل",245,"ل",1,0],["وانا نهني به مجدكم","وذاك علينا يحق احترامه",246,"م",2,0],["وانا نسلي بالبقاء نفوسنا","وما هي في الاجسام الا ودائع",247,"ع",1,0],["وان أنتما ناديتما في ملمة","فهل أحد غيري يجيب نداكما",248,"م",2,0],["وإن أنتَ لا تؤوى مروع نوائبٍ","بمن يلتجى في النائبات مروعها",249,"ع",3,0],["وإن أنتم علمتموهم ظفرتم","بعز به ترقون في الحل والحرم",250,"م",1,0],["وأنا نرى الإيمان قولا ونية","وفعلا إذا ما وافق الشرع يقبل",251,"ل",1,0],["وإن انظلم يوم للصادق مقاديره","غافل,له الله هو احرص منه وأحرص له",252,"ل",2,0],["وإنّا نهج أحمد قد تبعنا","وفيه الخير في الدنيا يقينا",253,"ن",2,0],["وأنا نُزوحٌ موغِلٌ في ذاتِهِ","ونَوازِعٌ في ضِدِّها تَتَوغَّلُ",254,"ل",1,0],["وإن أنت خلفت المفيد بنفعه","فأجرك جار منه بالخير والنُّعم 10",255,"م",1,0],["وَإِنْ أَنَا أَسْرَفْتُ فِي الْقَوْلِ حِيناً","فَمِنْ وَحْيِ مَاضٍ وَقَلْبٍ مُعَنَّى",256,"ن",2,0],["ٍوإن أنت فضَّلت هذا الخضوع","فَقَوّلي ستلقاهُ (ميمٌ وتا)..",257,"ت",2,0],["وإنَّ أناملي تهْوى وروداً","متى تمتدُّ فالْأشْواكُ تُدْمي",258,"م",2,0],["وأنا نعم ( للحين) شاعر هواوي","إن ظقت وإلا إن رقت جيتك بطاروق",259,"ق",1,0],["وإن أنا أحببت الخلود بِحُبِها","رأيت رِضاها من سهيل يسهلُ",260,"ل",1,0],["وَأَنَّ انْسِدَالَ الشَّعرِ فَوقَ جَبِينِهَا","وِشِاحٌ على أَطرَافِهِ خُصَلٌ خُضْرُ",261,"ر",1,0],["وأَنَا نَظَرْتُ بِلَا عُيُونٍ كَيْ أَرَى","لَو كَانَتِ الدُّنْيَا بِدُونِ شَبَابِ",262,"ب",1,0],["وإن أنا لم أزرك ولم أعرج","عسى وجدت بمعتلج البطاح",263,"ح",1,0],["وإن أناساً يصبرون تعففاً","على فقد عادات الغنى الكرام",264,"م",1,1],["وان أنا لم أملأ لها البيد غارة","فمن للمهارى القب ان اسرجت حربا",265,"ب",2,0],["وان أنا لم اوف المكارم حقها","فقد ضاع منها الحق أوقضت النحبا",265,"ب",2,0],["وان أنا لم أملك من الدهر مقودا","لمن أترك الاقدام والنهي والامرا",266,"ر",2,0],["وإنْ أنسى غزالي يا حبيبي","فقلْ للهِ درُّكَ يا غزالي",267,"ل",2,0],["وإنا نحيي فيك نفساً طموحة","إلى البحث في استخراج ما كان خافيا",268,"ي",2,0],["وإنْ آنستَ صدقاً من حبيبٍ","فلا تقسُ عليهِ ولا تهادنْ",269,"ن",1,0],["وإن أناساً أقسموا من غبائهم","على الله أنا لا نزال ولن نسرا",270,"ر",2,0],["وإن أندت به طيبا ورود","فما أسْكنْت ُ شكاً وارتيابا",271,"ب",2,0],["وإنّ انزلاقات الظلام كثيرة","ولكنّ من ينجو النبيه الممانع",272,"ع",1,0],["وأنّ انغماس المبدعين بخمره","انزلاقٌ خرافيُ الفضاء محلقُ",273,"ق",1,0],["وإنّ انبلاج الفجر لابدّ شاهدٌ","على أرخبيل العشق حيثُ يساكنه",274,"ن",2,0],["وانا نجومي ... في الغداري مسامير","على السما ... دقت بكل النواحي",275,"ح",2,0],["وَإِنْ أَنا قَبَّلْتُ البِساطَ وَكَفَّهُ","تَطاوَلْتُ فِي قَوْمِي وَزِدْتُ تَعَظُّمَا",276,"م",2,0],["وَ إِن أَنتَ أَيقَنتَ الهَلاكَ فَقُل لَهُم","أَيُنقِذُ مِن حُكمِ القَضاءِ قَتيلُ",277,"ل",1,0],["وإن أنا زاحمت حتى أموت","دخلت وقد زهقت مهجتي",278,"ت",2,0],["وإن أنكرتني بعد عرف نفوسهم","فقد عرفتني في الرجال المجامع",279,"ع",1,0],["وَأنَّا نُمْهِلُ السُّفَهَاءَ حَتَّىٰ","إِذَا شِئْنَا .. أَخَذْنَا قَادِرِيْنَا",280,"ن",2,0],["وأنا نذير العاشقين فمن يرد","طول الحياة فلا يذوقن الهوى",281,"و",2,0],["وانا نذرٍ علي ليا لمحتك باقف آآكبِّر","لربٍ حط في قلبي غلاك بمنتهى التعقيد",282,"د",1,0],["وإن انتهيت إلى أواخرها","فسحائب النعماء تتصلُ",283,"ل",1,0],["وإن أنتِ لم تستجيبِ لهذا","سيستبقُ الباقيات الجنونْ",284,"ن",1,0],["وإن أنس لاأنس الحسين مجدلا","وأصحابه صرعى مجدلة جزر",285,"ر",1,0],["وإِنْ أَنْسَ لا أنْسَى النِّسَاءَ كأنَّها","قَطاً رِيعَ عَنْ أوكارِهِ وَهْو هَاجِدُ",286,"د",1,0],["وإن أنتم أنكرتم أن قده","تقلد من عينيه مثل حسامه",287,"م",2,0],["وَأَنَّا نَرُدُّ الظَّالِمِينَ بِرِشوَةٍ","وَنَدفَعُ عَنَّا ما يَضِيقُ بِهِ الصَّدرُ",288,"ر",1,0],["وإنّا نبْدأ الأحلامَ شِعراً","فتنبجسُ الخوابي بالصَّبوحِ",289,"ح",1,0],["وآناً نُبكّي كالطيور وجودَنا","بلحنٍ... وكالأزهار نضحك آنا",290,"ن",2,0],["وأنا نقوشُ العزِّ والفتحُ الذي","ضَجَّتْ له الدنيا وضاقَ الكوكبُ",291,"ب",1,0]]}