م","كَما رُدَّ النِكاحُ بِلا وَلِيِّ",164,"ي",1,0],["وَمَرَّ بابَكُ مُرَّ العَيشِ مُنجَذِماً","مُحلَولِياً دَمُهُ المَعسولُ لَو رُشِفا",165,"ف",2,0],["وَمَرَّ تَهفو ذُؤابَتاهُ عَلى","أَسمَرَ مَتناً يَومَ الوَغى جَسَدِه",166,"د",2,0],["وَمَرَّ وَنارُ الكَربِ تَلفَحُ قَلبَهُ","وَما الرَوحُ إِلّا أَن يُخامِرَهُ الكَربُ",167,"ب",1,0],["وَمُرَحِّبٍ بِالزائِرينَ وَبِشرُهُ","يُغنيكَ عَن أَهلٍ لَدَيهِ وَمَرحَبِ",168,"ب",1,0],["وَمَرَّ بِالقَومِ يَتلُوُ وَهوَ مُنصَرِفٌ","يَس وَهيَ شِفاءُ النَّفسِ مِن وَصَمِ",169,"م",1,0],["ومرتجَّةِ الأردافِ طاويةِ الحشا","يموتُ بها فوجٌ ويحيا بها فوجُ",170,"ج",1,1],["ومروجُهُ الخضرُ الضواحكُ تنثني","فيها الغصونُ وتستلذُّ دهورُ",171,"ر",1,0],["وَمُرَقرَقِ الإِفرِندِ أَبرَقَ بَهجَةً","وَدَجا فَأَطلَعَ في الظَلامِ ضِياءَ",172,"ا",2,1],["وَمُرتَبَعٍ حَطَطتُ الرَحلَ مِنهُ","بِحَيثُ الظِلُّ وَالماءُ القَراحُ",173,"ح",1,1],["وَمَرَّ يَجُدُّ بي فيهِ هَواهُ","وَقَد لَعِبَ الصِبا بِقَضيبِ قَدِّهِ",174,"د",2,0],["وَمُرهَفٍ كَلِسانِ النارِ مُنصَلِتٍ","يَشفي مِنَ الثارِ أَو يَنفي مِنَ العارِ",175,"ر",1,1],["وَمَرَّ لايَلوي وَما ضَرَّ مَن","أَعرَضَ لَو سَلَّمَ أَو عَرَّضا",176,"ض",2,0],["وَمُرَقرَقِ الإِفرِندِ يَمضي في العِدا","أَبَداً فَيَفتُكُ ما أَرادَ وَيَنسُكُ",177,"ك",1,1],["وَمُرَّ عَلَينا كُلّ يَومٍ مُسلِّماً","سَلامَ حَثيثِ السَيرِ لا يَتمهَّلُ",178,"ل",1,0],["ومَرَّ النبيُّ بِسُفَّانَةٍ","فقامَتْ إليه تَبُثُّ الأَلَمْ",179,"م",1,0],["وَمُرْ بالأكيدرِ يَقذفْ به","إليك على كِبرهِ من عَلِ",180,"ل",1,0],["وَمَرَّ خِشفاً رَبيبا","وَزادَ حُسناً وَطَولا",181,"ل",2,0],["وَمَرَّ سَبع وَعشر في البِلاد لَهُ","وَحكمه مَزج تَرهيب وَتَرغيبِ",182,"ب",1,0],["وَمَرَّت بِهِ ذكريات الهَوى","رَواجعَ مِن ذَلِكَ المَنزل",183,"ل",1,0],["ومريضٍ وعُوَّدٍ صرخ المو","ت وكانوا يدعون بالابلال",184,"ل",1,0],["وَمَرهَنَةٌ عِندَ الغُرابِ حَبيبَهُ","فَأَوفَيتُ مَرهوناً وَخَلَفاً مُسابِيا",185,"ي",2,1],["وَمَرقَبَةٍ نَمَيتُ إِلى ذُراها","تُذِلُّ الطَيرَ مُشرِفَةِ القَذالِ",186,"ل",1,0],["وَمَرقَبَةٍ يا أُمَّ عَمرٍ طِمِرَّةٍ","مُذَبذَبَةٍ فَوقَ المَراقِبِ عَيطَلِ",187,"ل",1,0],["وَمَرِّرنَ حَتّى كُنَّ لِلماءِ مُنتَهاً","وَغادَرَهُنَّ السَيلُ فيما يُغادِرُ",188,"ر",1,0],["وَمَرقَبَةٍ شَمّاءَ أَقعَيتَ فَوقَها","لِيَغنَمَ غازٍ أَو لِيُدرِكَ ثائيرُ",189,"ر",1,0],["وَمَربَطُ أَفراسٍ وَخَيمٌ مُصَرَّعٌ","وَهابٍ كَجُثمانِ الحَمامَةِ هامِدُ",190,"د",1,0],["وَمَربَعُ حَيٍّ صالِحينَ نأَت بِهِم","نَوىً بَعدَ إِسعافٍ وَسَكنٌ مَعاهدُ",190,"د",1,0],["وَمُراسِلٌ فيهِم يُجيبُ وَقَد","حَنَّت إِلى ميعادِهِ النَفسُ",191,"س",1,0],["وَمَرقَبَةٍ مِثلِ السِنانِ عَلَوتُها","كَأَنّي لِأَردافِ الكَواكِبِ ناجَيتُ",192,"ت",1,0],["ومَرّ على آثارِهَا دَبَرَانُهَا","كصاحبِ رِدءٍ كُمِّنتْ خيلُه خَلفا",193,"ف",2,0],["وَمَرَّ ذا فَرَحٍ يَسعى بِمِسرَجَةٍ","فَاِستَلَّ عَذراءَ لَم تَبرُز لِأَزواجِ",194,"ج",1,0],["وَمُرِنَّةٍ جَمَعَت إِلى نُدمانِها","بِدَعَ السُرورِ يَقُدنَ كُلَّ مَقادِ",195,"د",1,0],["وَمَرَّ أَمامَ القَومِ يَسحَبُ ذَيلَهُ","يُجاذِبُ مِنهُ الرِدفَ في مَشيِهِ الخَصرا",196,"ر",2,0],["وَمَرَّ بِفِكري خاطِراً فَجَرَحتُهُ","وَلَم أَرَ جِسماً قَطُّ يَجرَحُهُ الفِكرُ",197,"ر",1,0],["وَمَرَّ يُريدُ ديوانَ ال","خَراجِ مُضَمَّخاً عِطرا",198,"ر",2,0],["وَمَرَّ يَتلوهُ وَلَم يُبالِ","بِالحَزنِ وَالسَهلِ وَبِالرِمالِ",199,"ل",1,0],["وَمَرَّ لِلحينِ بِنا ضَحوَةً","فَصادَ مِنّي القَلبَ عَيناهُ",200,"ا",2,0],["وَمَروانُ قَد دارَت عَلى رَأسِهِ الرَحى","وَكانَ لِما أَجرَمتَ نَزرَ الجَرائِمِ",201,"م",1,0],["وَمُرتَجَّةِ الأَردافِ مَهضومَةِ الحَشا","تَحورُ بِسحرٍعَينُها وَتَدورُ",202,"ر",1,0],["وَمُريدٍ رُشدي كَتَمَتُ هَواكُم","حَذَراً أَن يَلِجَّ في تَفنيدي",203,"د",2,0],["وَمَروانُ لَمّا أَن طَغى وَأَتَتكُمُ","زَوائِرُ مِنهُ بادِئاتٍ وَعُوَّدا",204,"د",2,0],["وَمُرَفَّلينَ عَلى العَشيرَةِ أَصبَحوا","سَبقاً مَرازِبَةَ العِراقِ قُعودا",205,"د",2,0],["وَمُرَفَّلينَ عَلى العَشي","رَةِ في الحُلومِ وَفي الوَطائِد",206,"د",1,0],["وَمَرَّت فَقالَت مَتى نَلتَقي","فَهَشَّ اِشتِياقاً إِلَيها الخَبيثُ",207,"ث",1,1],["وَمَريضَةٍ مَرَضَ الهَوى","بَكَرَت بِعَبرَتِها تَعيب",208,"ب",1,1],["وَمُرادُهُم عَذبٌ خَسيسٌ قَدرُهُ","شَرِبوا لَهُ مَقراً لِكَيما يَلسِبا",209,"ب",2,0],["وَمِرآةُ المَنجِمِ وَهِيَ صُغرى","أَرَتهُ كُلَّ عامِرَةٍ وَقَفرِ",210,"ر",1,0],["وَمَرّوا بِمَقصودِ الحِمامِ فَغادَروا","خَوالِدَ ضَمَّت فيهِ أَفرُخَها الوُرقا",211,"ق",2,0],["وَمَرَّ موسى وَلَم يَترُك لِأُمَّتِهِ","إِلّا أَحاديثاً يُوَدَعنَ المَهاريقا",212,"ق",2,0],["ومَراثٍ لَوْ أنّهُنّ دُمُوعٌ","لمَحَوْنَ السّطُورَ في الإنْشادِ",213,"د",1,0],["ومُرْسِلِ الغارَةِ مَبثوثَةً","مِن أدهَمِ اللّوْنِ ومن وَرْدِهِ",214,"د",2,0],["ومُرْ بفِرَاقِ شِيمتِها الليالي","تُجِبْكَ إلى إرادتِكَ امْتِثالا",215,"ل",2,0],["وَمُراحٍ وَمُسرَحٍ وَحُلولٍ","وَرَعابيبَ كَالدُمى وَقِبابِ",216,"ب",1,0],["ومَرَّ يَسْتَقصي حُصونَ الغَرْبِ","ويَبتليها بوَبيلِ الحَرْبِ",217,"ب",1,0],["وَمَرَّ بِنا يَومه الأَربعون","يُجدِّد لي ذكر يَومٍ عَصيب",218,"ب",1,0],["ومرّ يومي هادئاً ساكناً","وأيُّ شيءٍ خادع كالسكون",219,"ن",1,0],["ومرهفٍ سرت بين الموجتين به","حتّى ضربت وموج الموت يلتطم",220,"م",1,0],["وَمَرِحْنا بها سحابةَ يوم","وبأشجارها نقشْنا اسمينا",221,"ن",2,0],["ومراحنا بِقُرى الشمال وكوخَنا","تحت العرائش في ظلالِ اللوفِ",222,"ف",1,0],["ومرَّ على النهرِ ثغرُ النسيم","يُقَبِّلُ كلَّ شراعٍ عبرْ",223,"ر",1,0],["ومرَّتْ إزائي فتابعتُها","بقلبي وعيني إلى أمِّها",224,"ه",2,0],["ومِرْآتُها لا يَقْتَضيها جَمالُها","بمَرْآتِها والطّبْعُ غيرُ التّصَنّع",225,"ع",1,0],["ومركب الأفراد والأعلام","وخصماء الظلم والظلاّم",226,"م",1,0],["وَمَرَّتْ جُيوشُ المزْنِ رَهْواً كأَنَّها","عَسَاكِرُ زَنْجٍ مُذْهَبَاتُ المناصِلِ",227,"ل",1,0],["ومُرْتجِزٍ أَلْقَى بِذِي الأَثْلِ كَلْكَلاً","وحَطَّ بجَرْعَاءِ الأَبَارِقِ ما حَطَّا",228,"ط",2,0],["وَمُرقِصَةٍ رَدَدتُ الخَيلَ عَنها","وَقَد هَمَّت بِإِلقاءِ الزَمامِ",229,"م",1,0],["ومُرتَقَى نِيقٍ عَلَى نَقنَقٍ","أَدبَرَ عَودٍ في إكَافٍ قَمُوص",230,"ص",1,0],["وَمُرْتَبَعٍ لُذْنَا بِهِ غِبَّ سُحْرَةٍ","وَلِلصُّبْحِ أَنْفَاسٌ تَزيدُ وَتَنْقُصُ",231,"ص",1,1],["وَمَرْبَعٍ لِنَسِيمِ الْفَجْرِ هَيْنَمَةٌ","فِيهِ وَلِلطَّيْرِ فِي أَرْجَائِهِ لَغَطُ",232,"ط",1,0],["وَمَرَّ الفُرَاتُ العَذْبُ وَارْتَاعَ دِجْلَةٌ","وَشَجَّتْ كَأَجْفَانِ الكَظِيم الرَّوَافِدُ",233,"د",1,0],["ومُرُوءَةٌ فِي وَجْهِ كُل","مُصَانِعٍ قَامَتْ بِعُذْرِكْ",234,"ك",1,0],["وَمُرْضِعٍ مِنْ نَضْبِهَا تَشْتكِي","وَهَرِمٍ مِنْ ضَعْفِهِ يُهْتِرُ",235,"ر",1,0],["وَمُروءَةً فِي كُلِّ حَادِثَةٍ","لَها دَاعٍ مُجَابْ",236,"ب",1,0],["ومري القفرَ أن يفيضَ عيونً","تفرشُ الطرق ياسميناً ووردا",237,"د",2,0],["وَمُرقَبَةٌ كَالزِجِّ أَشرَفتُ فَوقَها","أُقَلِّبُ طَرفي في فَضاءٍ عَريضِ",238,"ض",1,0],["وَمَرقَبَةٍ دونَ السَماءِ عَلَوتُها","أُقَلِّبُ طَرفي في فَضاءِ سَباسِبِ",239,"ب",1,1],["وَمُرَدَّدٌ فيهِ عَلى","كَرِّ السِنينَ الباقِّيَه",240,"ي",2,0],["ومَرَرْتُ بالتاريخِ أَملأُ نَاظِرِي","منه وأُحْيِي بالفناءِ وُجُودِي",241,"د",2,0],["ومُرتَقِبٍ لي غُدوَةً وعَشِيَّةً","يُسائِلُ عنّي وهو لي غيرُ وامقِ",242,"ق",1,0],["ومَرْحَى بالصواريخ اللَّواتي","يدين لنا بها الفَلَك المدار",243,"ر",1,0],["ومرتقب الإقبال من كل وجهة","وأمر وللصنع الجميل معود",244,"د",1,0],["ومرضعة طفلا من العود ثديها","ولا در إلا الدر من أدب محض",245,"ض",1,0],["ومرّ عهد كعمر الحلم يرقبه","متى يعود يمنيه ويختلف ؟",246,"ف",1,0],["ومرتجة ِ الأرداف مهضومة الحشا","تمور بسحرٍ عينها وتدور",247,"ر",1,0],["ومروانُ لما أن طغا وأتتكم","زَوَائرُ منْهُ بَادئَاتٍ وَعُوَّدَا",248,"د",2,0],["وَمَرْقَبَةٍ يَا أُمَّ عَمْروٍ طِمِرَّةٍ","مَذَبْذَبَةٍ فَوْقَ المُرَاقِبِ عَيْطَلِ",249,"ل",1,1],["ومر المعمل في تسليحها","هو يدعى معملاً فليعمل",250,"ل",1,0],["ومَرْحَباً بك في طياتها نَفَسٌ","كنسمةِ الفجرِ قد طُلّت بانداء",251,"ا",2,0],["ومرافق نُدلَ الفنادقِ","بين مَردوخ وحَنّه",252,"ن",2,0],["ومرتقبٌ للشرِ والشرُّ غائبٌ","ومسْتَحْقِرٌ للشرّ والشرُّ قادم",253,"م",1,0],["ومُرِّي بكفي تَشُقُّ الطريقَ","لعاصفةٍ بهما تعصِف",254,"ف",1,0],["ومرّ على وادي القُرى ظِلُّ عارضٍ","من الشُؤْم لم يلبث بها أن تَمطَّرا",255,"ر",2,0],["ومَرَيْتُ جَفْني مَريَ ذي ثِقَةٍ","ورجعتُ عنك رجوعَ مُنْدَحِر",256,"ر",1,0],["ومُرِّي على هذي الهياكل أقبلت","عليها الجمْاهير الرُّعاع فحطِّمي",257,"م",2,0],["ومرضى قلوب من وعود وخلفه","ولم تهو يوماً أنهن صحاح",258,"ح",1,0],["ومُرّوا بأنحاءِ العراقِ مُضاعةً","وزوروا قرىً موبوءةً وبقاعا",259,"ع",2,0],["ومر يَهزَأ من أيد تقاومه","تسعَى لتحكيم أسداد وتبتدِر",260,"ر",1,0],["ومرموقون من بُعدٍ وقُربٍ","لهم أُفقٌ وللقمرين أُفْقُ",261,"ق",1,0],["وَمُرَدَّدٍ بَينَ القَوَافي يَجْتَني","مَا شَاءَ مِنْ ألِفِ القَرِيضِ وَلامِهِ",262,"م",2,0],["ومرَّتْ تحثُّ السَّائقاتُ جمالَ","بها مُجْتَوَى ذي مَعْيَطٍ فالمَخَارِما",263,"م",2,0],["ومروانُ سادسُ مَنْ قد قضى","وكانَ ابنُهُ بعدهُ سابعا",264,"ع",2,0],["وَمَرّ بِنَا المُختارُ مُختارُ طَيّءٍ،","فَرَوّى مُشاشاً كان ظَمآنَ صَادِيَا",265,"د",3,1],["وَمُرِدَّة ٍ وَطْفَاءَ وَافَقَ نُوْؤُهَا","قَبْلَ الْهِلاَلِ بِدِيمَة ٍ دَيْجُورِ",266,"ر",1,0],["ومَرَّتْ على لين الوسادة صُورَتي","تُخضّبُها دمعاً وتُغْرِقُها شجوا",267,"و",2,0],["ومَرَّتْ على لين الوسادة صُورَتي","تتخضّبها دمعاً .. وتُغْرِقُها شجوا",268,"و",2,0],["ومرأى البحر أحسن كل شيءٍ","اذا لبست غواربه سفينا",269,"ا",1,0],["ومرّ على النهر ثفر النّسيم","يقبّل كل شراع عبر",270,"ر",1,0]]}