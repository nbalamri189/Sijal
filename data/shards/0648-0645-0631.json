مَت بِهِنَّ نَوىً شَطونُ",1,"ن",1,0],["وَمُرَقرَقِ الغَربَينِ إِلّا كُلفَةً","مِمّا يُطَبِّقُ دائِماً وَيُصَمِّمُ",2,"م",1,0],["وَمَرَّ عَلى الرَأسِ مَرَّ الغَمامِ","قَليلَ المُقامِ سَريعَ الزِيالِ",3,"ل",1,0],["وَمُراغِمٍ يَغدو عَلى قَنَصي","فَيَحوزُهُ وَيَدايَ مُحتَبِلُ",4,"ل",1,0],["وَمُرادي يَقِلُّ في جَنبِ نُعما","كَ فَأَينَ التَكَرُّمُ المَألوفُ",5,"ف",1,0],["وَمَراقي العُلى بِأَن بِتَّ تَعلو","ها وُثوباً إِذا عَلا الناسُ زَحفا",6,"ف",2,0],["وَمُرَوِّعٍ لي بِالسَلامِ كَأَنَّما","تَسليمُهُ فيما يَمُضُّ وَداعُ",7,"ع",1,1],["وَمُرُّ قَولٍ ذَلَّ عِزّي لَهُ","لَو مُزِجَ الماءُ بِهِ عَرمَضا",8,"ض",2,0],["وَمُرَجَّلٍ جَعدٍ يَنوءُ بِهِ","جيدُ الغَزالِ وَناعِمٌ رَخصُ",9,"ص",1,0],["وَمُرَجِّلينَ مِنَ الحِمامِ غَرانِقٍ","مِثلِ الغُصونِ ثِيابُها الوَرَقُ النَدي",10,"د",2,0],["وَمُر بِجَوابٍ يُشبِهُ البَدءَ عَودُهُ","لِيُردي عَدوّاً أَو لِيُكبِتَ حاسِدُ",11,"د",1,0],["وَمَرَّت عَلى لُبّي فَقُلتُ لَعَلَّها","تُجاوِزُني مَكظومَةً فَاِستَمَرَّتِ",12,"ت",1,0],["وَمَرَّت حَواميها عَلى لِمَّةِ الدُجى","تُجاذِبُ بِالإِدلاجِ مِنها الذَوائِبا",13,"ب",2,0],["وَمَرقَبَةٍ رَبَأتُ عَلى ذُراها","وَلِلَّيلِ اِنجِفالٌ وَاِنجِيابُ",14,"ب",1,0],["وَمُرَبّي العُلى إِذا بَلَغَ الغا","يَةَ رَبّاهُ في العُلى ما يُرَبّي",15,"ي",1,0],["وَمُرْدٌ على جُرْدٍ بأَيدٍ تَمُدُّها","إِلى الشَّرفِ الضَّخمِ الخلائفُ والرُّسْلُ",16,"ل",1,0],["وَمَرَتْ أَدمُعي مَطايا تَرامَتْ","بسُلَيمَى تَوَقُّصاً وَذَميلا",17,"ل",2,0],["وَمُر تَبَعٍ مِن مَسقَطِ الرَّملِ بِالحِمى","يُخاصِرُهُ وادٍ أَغَنُّ خَصيبُ",18,"ب",1,1],["وَمُرتَبَعاً بِهِ الغُدرانُ تَخدي","إِلَيها الناجياتُ عَلى وَجاها",19,"ا",3,0],["وَمُرْتَبَعٍ لُذْنا بِأَذْيالِ دَوْحِهِ","مِنَ الحَرِّ وَالبَيْضاءُ شُبَّتْ لَظاتُها",20,"ت",3,1],["وَمُرْتَدٍ بِالُّدجَى رَوَّحْتُ صَهْوَتَهُ","بَعْدَ اخْتِلاسِ ذَماءِ الرِّيحِ بِالعَنَقِ",21,"ق",1,1],["ومُرْضِعَةٍ ما لَمْ تَلِدْهُ فإنْ بَكى","تبَسَّمَ في وَجْهِ الصّباحِ الحَنادِسُ",22,"س",1,0],["ومَرَرْنَ بالوادي على عَذَبِ الحِمى","فحَكَيْنَ هِزّةَ بانِهِ بِقُدودِ",23,"د",1,0],["ومَرْتٍ يضِلُّ الذّئْبُ فيهِ إذا دَجا","بهِ الليلُ أو شَبَّتْ لَظاها الأماعِزُ",24,"ز",1,0],["ومَربوطَةٍ جُرْدٍ سَوابِقَ حَوْلَهُ","بمَرْكوزَةٍ مُلْسِ المُتونِ لِدانِ",25,"ن",1,0],["ومُرْتَبَعاً بالحِمى والنّعي","مُ يُلْقي بِحاشِيَتَيْهِ عَصاهْ",26,"ا",2,0],["ومُرنَّحينَ سَقاهُمُ خَدَرُ الكَرى","نُطَفاً يَعافُ كُؤوسَهُنَّ الواغِلُ",27,"ل",1,0],["ومُرَنَّحينَ مِنَ النُّعاسِ بَعَثْتُهُمْ","والعينُ تَكسِرُ جَفنَها تَهْويما",28,"م",2,0],["ومُرْهَفٌ أنحَلَ الهَيجاءُ مَضرِبَهُ","لا يَألَفُ الدَّهرَ إلا هامَةَ البَطَلِ",29,"ل",1,0],["ومُرتَعِدِ الأُنْبوبِ يُرْوي سِنانَهُ","دَمٌ مائِرٌ والدُّهْمُ مِن نَضْحِهِ شُقُ",30,"ق",1,0],["ومَرابِضُ الآسادِ في أيَّامِهِ","بالعَدْلِ مثْلُ مَجاثِمِ الأطْلاءِ",31,"ا",2,0],["وَمُرقِصَةٍ رَدَدتُ الخَيلَ عَنه","وَقَد هَمَّت بِإِلقاءِ الزَمامِ",32,"م",1,0],["وَمُراقَبٍ رَجَعَ السَلامَ بِطَرفِهِ","وَمُحَيَّرٍ لَم يَستَطع تَسليما",33,"م",2,1],["ومرّ بِها قِطٌ أنيسٌ فشمّها","وأسْرَعَ في ضم التّرابِ وغطّاها",34,"ا",3,0],["وَمُرْضِعَةٍ طِفْلاً مِنَ الْعُودِ ثَدْيُهَا","وَلاَ دَرَّ إِلاَّ مِنْ أَدَبٍ مَحْضِ",35,"ض",1,0],["وَمُرْسِلَ المَثَلِ الْجَارِي بِكُلِّ عُلاَ","فَوْقَ البَسِيطَةِ مِنْ شَامٍ إِلى يَمَنِ",36,"ن",1,0],["ومُرْتَحِلٍ أجْرَيْتُ دمْعي خلْفَهُ","ليُرْجِعَهُ فاسْتَنّ في إثْرِهِ قَصْدا",37,"د",2,0],["ومُرْتَقِبُ الإقْبالِ في كلِّ وجْهَةٍ","وأمْرٍ ولِلصّنْعِ الجَميلِ معوَّدِ",38,"د",1,0],["وَمَرَّ حَدٌّ عَلى وَبارٍ","فَهَلَكَت جَهرَةً وَبارُ",39,"ر",1,0],["وَمَرقَبَةٍ عَيطاءَ بادَرتُ مُقصِراً","لِأَستَأَنِسَ الأَشباحَ أَو أَتَنَوَّرا",40,"ر",2,0],["وَمَريضَةٍ مَرَضَ النُعاسِ ذَعَرتُها","بادَرتُ عِلَةَ نَومِها بِغِرارِ",41,"ر",1,0],["وَمُرهَقٍ قَد دَعاني فَاِستجَبتُ لَهُ","أَجَزتُ غُصَّتُهُ مِن بَعدَ ما شَرِقا",42,"ق",2,0],["وَمَرَّ بِأَكنافِ اليَدَينِ نَضِيَّهُ","وَلِلحَتفِ أَحياناً عَنِ النَفسِ عاجِمُ",43,"م",1,0],["وَمَريضَةٍ قَفرٍ يُحاذَرُ شَرُّها","مِن هَولِها قَمِنٍ مِنَ الحَدَثانِ",44,"ن",1,0],["وَمَرَحنا في ساحِها فَنَسينا ال","أَهلَ وَالأَصدِقاءَ وَالأَحبابا",45,"ب",2,0],["وَمَرَّ بِالشَرقِ زَمانٌ وَما","يَمُرُّ بِالبالِ وَلا يَخطِرُ",46,"ر",1,0],["وَمُرِ النارَ أَن تَكُفَّ أَذاها","وَمُرِ الغَيثَ أَن يَسيلَ اِنهِمارا",47,"ر",2,0],["وَمُروءَةٌ لَو أَنَّها قَد قُسِّمَت","بَينَ اليَهودِ لَأَحسَنوا وَتَصَدَّقوا",48,"ق",3,0],["وَمُر كُلَّ مَعنىً فارِسِيٍّ بِطاعَتي","وَكُلَّ نُفورٍ مِنهُ أَن يَتَوَدَّدا",49,"د",2,0],["وَمَرامِيَ الأَقصى يَراهُ سَماحُكُم","سَهلاً وَإِقتاري يَراهُ مَغنَما",50,"م",2,0],["وَمُرقَبَةٌ كَالزِجِّ أَشرَفتُ فَوقَه","أُقَلِّبُ طَرفي في فَضاءٍ عَريضِ",51,"ض",1,0],["وَمَرَّت تَحُثُّ السائِقاتِ جِمالَها","بِها مُجتَوى ذي مَعيَطٍ فَالمَخارِما",52,"م",2,0],["وَمَرَّت بِقاعِ الرَوضَتَينِ وَطَرفُها","إِلى الشَرَفِ الأَعلى بِها مُتَشارِفُ",53,"ف",1,0],["وَمَرَّت سِراعاً عيرُها وَكَأَنَّها","دَوافِعُ بِالكِريَونِ ذاتُ قُلوعِ",54,"ع",1,0],["وَمَروانُ سادِسُ مَن قَد مَضى","وَكانَ اِبنُهُ بَعدَهُ سابِعا",55,"ع",2,0],["وَمَرَّت عَلى التَقوى بِهِنَّ كَأَنَّها","سَفائِنُ بحرٍ طابَ فيها مَسيرُها",56,"ر",3,0],["وَمَرَّ فَأَروى يَنبُعًا فَجُنوبَهُ","وَقَد جيدَ مِنهُ جَيدَةٌ فَعَبَاثِرُ",57,"ر",1,0],["وَمَرَّتْ بِالْحُقُودِ فَشَرَّدَتْهَا","وَعَادَتْ بِالْحُقُوقِ إلى النِّصَابِ",58,"ب",1,0],["ومرخصاً في سوق تعليمه","من دره المنظوم ما قد غلا",59,"ل",2,0],["وَمُراقِبٍ فِي نَفْسِهِ وَبِلادِهِ","ذِمَمَ العُلَى مُسْتمْسِكٌ بِحِبَالِهَا",60,"ل",3,0],["وَمُرْشِدَاتُ جُنْدِهِ الشُّجْعَانِ","نَحْنُ مُهَيِّئَاتُ الاِسْتِقْبَالِ",61,"ل",1,0],["وَمِرْقَماً إِذَا احْتَسَى مِدَادَهَا","مَجَّ شُعَاعاً يَقْشَعُ الظَّلامَا",62,"م",2,0],["وَمُرَوِّضاً خَيْلَ البُخَارِ يَحُثُّهَا","بِهُدَى البَصِيرِ وَجُرْأَةِ المُتَرامِي",63,"م",2,0],["وَمُرُوجٌ مُدَبَّجَاتٌ كَوَشْيٍ","أَتْقَنَتْ صُنْعَهُ حِسَانُ المَعَاصِمْ",64,"م",1,0],["وَمُرّوا نَقصِفُ اليَومَ","فَإِنّي بائِعٌ خُفّي",65,"ي",1,0],["وَمَرواناً قَتَلنا عَن يَزيدٍ","كَذاكَ قَضاؤُنا في المُعتَدينا",66,"ن",2,0],["وَمُرتَفِقٌ لَم يَرجُ آخِرَ لَيلِهِ","مَناماً وَأَحلى نَومَةٍ لَو يَنامُها",67,"م",3,0],["وَمَربوعَةٍ رِبعيَّةٍ قَد لَبأتُها","بِكَفَّيَّ مِن دَوِّيَّةٍ نَفَراً سَفرا",68,"ر",2,0],["ومرسلها ملء الفضاء كتائباً","تدين لها غُلبُ الملوك بإذعَانِ",69,"ن",1,0],["ومُره ثم احكم به أن ونى","ما يحكم