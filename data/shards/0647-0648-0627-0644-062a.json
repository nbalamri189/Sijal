{"poems":[[37,"هو التيس لؤما وهو إن راء غفلة","https://www.aldiwan.net/poem39617.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[64,"إذا ما الأرض لم تنخل مرارا","https://www.aldiwan.net/poem52177.html","الوافر"],[51,"هو التنقل من يوم إلى يوم","https://www.aldiwan.net/poem63102.html","البسيط"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[125,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[275,"هو التصوير قد مد الظلالا","https://www.aldiwan.net/poem35205.html","الوافر"],[543,"أتى بقدوم فاطمة البشير","https://www.aldiwan.net/poem48146.html","عموديه"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107029","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118418","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134207","البسيط"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131900","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88910","الطويل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32380","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108136","البسيط"],[4691,"للاحق يُنشدُ الشعر .. إخوانية","https://www.poetsgate.com/ViewPoem.aspx?id=88158",""],[4955,"بالجد لا بجدود المرء عزته","https://www.poetsgate.com/ViewPoem.aspx?id=193838",""],[5092,"همسة","https://www.poetsgate.com/ViewPoem.aspx?id=178125",""],[3591,"لكنما يا بني الأوطان ينقصنا","https://www.poetsgate.com/ViewPoem.aspx?id=149534",""],[5190,"هو التاريخ شاهدنا","https://www.poetsgate.com/ViewPoem.aspx?id=175249",""],[5206,"تقريظ كتاب الاستقامة للكُدَمي","https://www.poetsgate.com/ViewPoem.aspx?id=187427",""],[5277,"وما مثلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=191713",""],[5431,"حبكِ ثابتي حاءٌ...وباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=183467",""],[5431,"في حب الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=202478",""],[5452,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=112743",""],[5768,"بَيْرُوتُ وأُمَّتُنَا الْجَرِيحَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=215488",""],[6070,"هو التأريخُ أخبارٌ عَديدَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=189439",""],[5567,"حمام الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82096&r=&rc=137",""]],"verses":[["هُوَ التَيسُ لُؤماً وَهوَ إِن رَاءَ غَفلَةً","مِنَ الجارِ أَو بَعضِ الصَحابَةِ ذيبُ",0,"ب",1,1],["هُو التَّاجُ والإِكْلِيلُ في كلِّ مَحْفِلٍ","بل السَّيْفُ سيْفُ الدولة المُتَقَلّدُ",1,"د",1,0],["هو التنين جاع فمصَّ رأسٌ","له ذنباً وصَيَّرَه غذاءُ",2,"ا",2,0],["هُوَ التَنَقُّلُ مِن يَومٍ إِلى يَومِ","كَأَنَّهُ ما تُريكَ العَينُ في النَومِ",3,"م",1,1],["هو التّاركُ الثغْرَ القَصِيَّ دُروبُهُ","مَقَرّاً لفُسطاطٍ وداراً لنازل",4,"ل",1,0],["هُوَ التعصب قد وَاللَه أَخَّركم","عَن الشعوب الَّتي تَسعى فتقترب",5,"ب",1,0],["هو التقي السخي الخِرْقُ منطبقا","هو الخضمُّ هو الهاضوم ينطبق",6,"ق",1,0],["هو التصويرُ قد مدَّ الظِّلالا","على الشمسِ التي احتجبت دَلالا",7,"ل",2,1],["هو التَّتمثيلُ زادَ بكم جَمالاً","كما زانت قلائِدَها النُّحورُ",8,"ر",1,0],["هو التجلي التام والمجلى الأتم","ومالك الحدوث سلطان القدم",9,"م",1,0],["هو التني النقي المنتف شرقا","هو الأبي الوفي الأمر الناهي",10,"ه",2,0],["هو التقي الذي كانت عبادته","يزهو بها في كمال الفوز اسلام",11,"م",1,0],["هو التّقِيُّ الذي جَلّت مناقِبُه","من أن أَعُدّ لها أعشارَ مِعشارِ",12,"ر",1,0],["هو التحفة المنصان شارح لوعتي","مطوَّل متنِ القدِّ مختصرُ الخصر",13,"ر",1,0],["هُوَ التارِكُ المالَ الرَغيبَ حَمِيَّةً","وَلَلمَوتُ مِن بَعضِ المَعيشَةِ أَروَحُ",14,"ح",1,0],["هو التباعد عن زهو يداخلنا","إذا قليلاً زها في كفنا الذهب",15,"ب",1,0],["هو التاريخ زانتهُ","مناقب حفّها الطهرُ",16,"ر",1,0],["هوَ التوكُّلُ من دونِ التواكلِ إن","شئتَ المضيَّ على دربِ الأجلَّاءِ",17,"ا",2,0],["هو التاريخُ يلفظُ كلَّ فظِّ","وما يومًا هنا استوعبتَ دَرْسَهْ",18,"س",2,0],["هو التباعد عن زهو بداخلنا","إذا قليلاً زها في كفنا الذهب",19,"ب",1,0],["هو التجرد عما عم من حقد","لا عجز يدفع أو نعماء يجتلب",19,"ب",1,0],["هُوَ التَّارِيخُ شَاهِدُنَا","فَسَلْ خُوفو ، سَلِ الهَرَمَا",20,"م",2,0],["هَوَ التَّاجُ لِلدِّينِ القَوِيمِ مُؤَيِّدٌ","مُقَوَّمَهُ لمّا بَدَوهُ مُعَوَّجَا",21,"ج",2,0],["هو الترياقُ إمّا رمتَ برْءاً","ويسقي من يرومَ العرضَ سُمّا",22,"م",2,0],["هو التاريخ يكتبنا بفخرٍ","هي الأمجاد يصنعها الإباءُ",23,"ا",2,0],["هو التواب عن ضوء ظليلٍ","وكلّ الناس ومضٌ من صداه",24,"ا",2,0],["هو التقيّ بهيّ الوجه كالقمر","قد حاز كلّ معاني الحسن أتقانا",25,"ن",2,0],["هُوَ التَّدْمِيرُ يَفْجَعُنَا نَهَارًا","وَفِي الْإِمْسَاءِ تَخْطِيطٌ وَقَاحُ",26,"ح",1,0],["هو التأريخُ أخبارٌ عَديدَهْ","كما الأقلامُ تكتبُ في جَريدَهْ",27,"د",2,1],["هو التاريخ في كفيك نهر","حنون يُلبس الدنيا حنينا",28,"ن",2,0]]}