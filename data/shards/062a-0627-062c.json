"],[5894,"كل الأنام من العدالة شاكر","https://www.poetsgate.com/ViewPoem.aspx?id=131408",""],[5897,"همسة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=156356",""],[5997,"الرحى جوعى","https://www.poetsgate.com/ViewPoem.aspx?id=214466",""],[6029,"نشيج المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=189014",""],[4442,"ذهب الورق وانطوى سلطانه","https://www.poetsgate.com/ViewPoem.aspx?id=170989",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""]],"verses":[["تاج السبيك هو الرفيع","لش يرض إل من ومن",0,"ن",1,0],["تاج الرسالة خَتمِها وقِوامِها","وعِمادِها السامي على النظراءِ",1,"ا",2,0],["تاج العلى والعلم والكرم الذي","أضحى له تبر الثنا مسبوكا",2,"ك",2,0],["تاجروني بطاعتي","تربحوا في البضائع",3,"ع",1,0],["تاجٌ متى لاح فالإزراء يتبعه","حتماً إذا تبع التيجان تبجيلُ",4,"ل",1,0],["تاجُ حُسْنٍ يَثْنيهِ تاجٌ من الإح","سان تاجانِ طالما مَلكانا",5,"ن",2,0],["تاجرٍ فاجرٍ جَموعٍ منوعٍ","يرهقُ الناسَ في اقتضاءِ ديونِهْ",6,"ن",2,0],["تاجُ المُلوكِ وَصِهرُها في دارِمٍ","أَيّامَ يَربوعٌ مَعَ الرُعيانِ",7,"ن",1,0],["تاجِر بي اللَهَ تَفُز بِالرِضى","وَتَربَحِ الجَنَّةَ في التَجرِ",8,"ر",1,0],["تاج كقرص الشمس ملء إطاره","عتق ومجد تالد وفخار",9,"ر",1,0],["تاجِرُ القَومِ صَدوقٌ وَأَمين","لَفظَةٌ مِن فيهِ لِلقَومِ يَمين",10,"ن",1,0],["تاجَ البِلادِ تَحِيَّةٌ وَسَلامُ","رَدَّتكَ مِصرُ وَصَحَّتِ الأَحلامُ",11,"م",1,1],["تاجٌ تَنَقَّلَ في العُصورِ مُعَظَّماً","وَتَأَلَّفَت دُوَلٌ عَلَيهِ جِسامُ",11,"م",1,0],["تاجُ أَحرارِها غُلاماً وَكَهلاً","راعَها أَن تَراهُ في الأَصفادِ",12,"د",1,0],["تاجُ النِيابَةِ في رَفيعِ رُؤوسِكُم","لَم يُشرَ لُؤلُؤُهُ وَلا ياقوتُهُ",13,"ت",2,0],["تاجٌ تَنَقَّلَ في الخَيا","لِ فَما اِستَقَرَّ عَلى جَبين",14,"ن",1,0],["تاجُ الحَضارَةِ حينَ أَش","رَقَ لَم يَجِدهُم حافِلين",14,"ن",1,0],["تاجٌ تَرى فيهِ إِذا قَلَّبتُهُ","جَهدَ الشَريفِ وَهِمَّةَ الصُعلوكِ",15,"ك",1,0],["تاجُ لُؤَيِّ بنِ غالِبٍ وَبِهِ","سَما لَها فَرعُها وَمَحتِدُها",16,"د",3,0],["تاجَرْتَهُم فربِحتَ أثمانَ العُلَى","إنّ المحامدَ للعُلَى أثمانُ",17,"ن",1,0],["تاجِرُ مَدحٍ يَصطَفيهِ عَلى","تَقويمِهِ الحَمدَ وَتَثمينِهِ",18,"ن",2,0],["تاجٌ كبَدْرِ التَّمِّ عادَ ضِياؤُهُ","بعدَ الكُسوفِ فِراقَ عينِ المُبْصِرِ",19,"ر",1,0],["تاجُك في النور غريقٌ وفي","عرشك غَنَّى كل نجمٍ صَدُوح",20,"ح",1,0],["تأجّجَ في صُدورِ القومِ غَيظٌ","له في كلّ جانحةٍ ضِرامُ",21,"م",1,0],["تاجُ البطولات على رأسهِ","مؤتلقٌ والغارُ فوق الجبينْ",22,"ن",1,0],["تاجُ مِصرَ مَعقِدُهُ","كانَ تَحتَ خِنصَرِها",23,"ر",3,0],["تاجروا فيك ساوموك استباحوك","وباعوك كاذبات الاماني",24,"ن",2,0],["تاجان زانا مفرقيه، وإن يكنْ","تاج البيان على المفارق أدْوَما",25,"م",2,0],["تاج الجزيرة وهي مهد جدودكم","نزل القضاء فنكّست راياته",26,"ت",2,0],["تاج بغداد والشام ولبنان","وبحر للروم طاغ عنيد",27,"د",1,0],["تاجُ حُسْنٍ يَثْنيهِ تاجٌ من الإحس","سان تاجانِ طالما مَلكانا",28,"ن",2,0],["تاجُك في النور غريقٌ وفي","عرشك غبَّى كل نجمٍ صَدُوحْ",29,"ح",1,0],["تاجَر الناسُ بِالحُطام وَكانوا","في المَعالي تَراهُم تُجارا",30,"ر",2,0],["تاج رأسي الرواس مهديّ آل","هم لعمري نور الهدى للعباد",31,"د",1,0],["تاج المشايخ في العراق وغيرها","وهو الإمام المقتدي بكماله",32,"ل",2,0],["تاجرٌ يطلُبُ رِبحا","من بِضاعاتٍ ودُور",33,"ر",1,0],["تاجُ الزُّمُردّ فوق مَف","رقها يُرَّصعُ بالعقيقِ",34,"ق",1,0],["تاج الخلافِة وهْو تاجُ فَضائلٍ","تَقْضِي الجواهرُ دُونَه والعَسْجَد",35,"د",1,0],["تأجج في الضلوع فصار نارا","كوت رأسي بمبسمها المكين",36,"ن",1,0],["تاج الخلافة بهجة ال","دنيا وعز المسلمين",37,"ن",1,0],["تاج مِن الدَرك الأَدنى يَطوفُ بِهِ","عَلى الخَفافيشِ في أَشلاءِ أَطمارِ",38,"ر",1,0],["تَأَجَّجَتْ نَارُهُ السَّوْدَاءُ لَمَّا دَعَا","إِلىَ الرَّحِيلِ عَنِ الْحَمْرَالَهُ دَاعِ",39,"ع",1,0],["تاجرت بالشعر بغي الريح فاِنعكست","حالي عَلى فعاد الريح خسرانا",40,"ن",2,0],["تاج الملوج جمال الدهر غرته","وبدر هالة دين المصطفى العلم",41,"م",1,0],["تاجُ المَليكِ حُلى التاريخِ كَلِلَهِ","شَرَفَت مُلكُكَ وَالإِحسانِ مَشكورِ",42,"ر",1,0],["تاجٌ أرادَ الحُسّادُ أن يضَعوا","منه وقد كان جَلَّ وارتفعا",43,"ع",2,0],["تاجٌ يا دهْرٌ فضائلُه","من فَوقِ جَبينِك تَعْقِده",44,"د",2,0],["تاجرت في شعري إليك وإنَّما","نَفَقَ القريض لديك بعد كساده",45,"د",2,0],["تاجرْ هواه وثِقْ بذمّته","تكن شريكَ المقمورِ لا القامرْ",46,"ر",1,0],["تأجَّنُ غُدراني وماؤك سَلسَلٌ","وتخبُثُ أوطاني وتُربُك طيِّبُ",47,"ب",1,0],["تاجُ الملوكِ ذو المقامِ الأفضلِ","يحمي حمى الليث صغار الأشبل",48,"ل",1,0],["تاجَ الملوكِ وبغدادَ فليس سِوى","تاج الملوكِ لما تبْغي وبغدادِ",49,"د",1,0],["تاج الملوك فتى النَّعماء اذ حُبست","سحبُ السماء وعزَّ الجودُ والسبل",50,"ل",1,0],["تاجُ الملوكِ غَمامُ أنْمُلهِ","هامٍ فلا قَزَعٌ ولا صلفُ",51,"ف",1,0],["تاجُ الملوكِ والملاذُ المُعْتصَمْ","مشَمِّرٌ يزْجُر أسْطار القلمْ",52,"م",1,0],["تاجُ المُلوكِ فتى المَسا","عي الغُرِّ والمَجْدِ البَديعِ",53,"ع",1,0],["تاجُ الملوكِ فتى النَّوالِ إذا","هَرَّ الشتاءُ وأخْلَفَ السَّبَلُ",54,"ل",1,0],["تاج المُلوكِ مُشارُ الدهر واحدُه","بمثلهِ الدَّهرُ لم يسمح ولم يجُد",55,"د",1,0],["تاجُ المُلوكِ وأحْمَدُ","الخَيْراتِ والماضي العَزومُ",56,"م",1,0],["تاجُ الملوك ومِطْعامُ العَشيِّ إذا","هَرَّ الشتاءُ وعَزَّ الودْق والحَلَب",57,"ب",1,0],["تاج الملوك مُشار كلِّ فضيلةٍ","وجلالُ الإسلام الجَوادُ المُفْضِل",58,"ل",1,0],["تاج الملوك ومكْفى كلِّ مضطهدٍ","فالضَّيف ذو ثروةٍ والجار معصوم",59,"م",1,0],["تاج هو الاسلام مركزه النهى","فيه المنزل درة عصماء",60,"ا",2,0],["تاجُ أَهلِ اللهِ بل أَحمَدُهُمْ","أَتَرى كلَّ ولِيٍّ أَحمَدَا",61,"د",2,0],["تاجُ الوزارةِ طوقُ المجدِ خاتَمُهُ","إنسانُ عينِ المعالي زَندُ يُمناها",62,"ا",3,0],["تاج الملوك خير من","هز المواضي والقنا",63,"ن",2,0],["تاج الخلافة والربع الذي شرفت به","المعالم قد عفاه إقفار",64,"ر",1,0],["تاجانِ زاناكَ.. أيٌّ فاقَ توأمَهُ:","في قلبكَ السهمُ أم في هامكَ الحجرُ؟",65,"ر",1,1],["تاجانِ زاناكَ.. فاصْدِقْني بأيِّهِما:","على سِواكَ من الأحرار تفتخرُ؟",65,"ر",1,0],["تأجج الوجد في الأحشا واضطربا","وانضب الهم والأحزان ما كلما",66,"م",2,1],["تاج مجيد قد سما بك واعتلى","ما بين شعب عنه نفسك تبذل",67,"ل",1,0],["تاج به أشرقتما وسنا كما","كالشمس ما بين الجموع فهللوا",67,"ل",3,0],["تاج جليل لا يحاكي دره","قدراً سوى ما من علومك نقبس",68,"س",1,0],["تاج الإِمارة أَسنى مَن لَهُ رُفِعَت","راياتُ مكرمةٍ مِن سالف الزَمَن",69,"ن",1,0],["تاج الإِمارة مَظهر","بَحر العُلوم الأَكبر",70,"ر",1,0],["تاجه العز وَحَسبي","أَنهُ رَبُّ المَعالي",71,"ل",2,0],["تاجُ الملوك الذي أرْبتْ مكارمهُ","على الكرام وإِنْ جادوا وإنْ كرَموا",72,"م",3,0],["تاج المَعالي وَفيهِ الدّهر قَد شَرفت","وَشَرّفت حيثُما صارَت له خدَما",73,"م",2,0],["تاجُ مَجْدٍ في أَعَالِي جَبْهَتي","وَسِوَارٌ، خالدٌ في مِعْصَمِي",74,"ي",1,0],["تاج العلا بدر الدجى شمس الضحى","دهر الهدى قهر العدى والناكلِ",75,"ل",1,0],["تاجره بالمدح تحصل","لكفك الأرباحُ",76,"ح",1,0],["تاجرت مدحك يا أبا الفضل الذي","فضل الورى جودا فكنت الرابحا",77,"ح",2,0],["تاجرت فيه الشعر عند كساده","فرجعت عنه بصفقة لم توكس",78,"س",1,0],["تاج المفاخر طلّاع المنابرِ غف","فار الحرائرِ سلطان السلاطينِ",79,"ن",1,0],["تاجَ الخِلافَةِ نور الفهم قوَّتهُ","جسمُ اللطَافَةِ روحُ الحلم جَوهَرَهُ",80,"ر",2,0],["تاج الأئمة قطب الشرع محكمه","علامة الخلق من ناء ومقترب",81,"ب",1,0],["تاج السلاطين قطب الدين عاضده","ومظهر العدل والإحسان والشيم",82,"م",1,0],["تاج راسي ما له مْكافي","يجعله في مفرقي زينه",83,"ن",2,0],["تاج التصوف وَالتعفف وَالهدى","لِلَّه وافي العهد وَالميثاق",84,"ق",1,0],["تاج المفاخر والبها","لاهوت شمس الأَنجم",85,"م",1,0],["تاج السمو وطوقه ونطاقه","ويمينه وجبينه والمفرق",86,"ق",1,0],["تاجروا بالأنفس اللَه ولم","يبتغوا إلا رضاه عوضا",87,"ض",2,0],["تاج العرائس في اللغات مفقة","مصباح ليل الجاهل المتكبر",88,"ر",1,0],["تاجٌ بلقيسَ تاج قامعةِ الج","نِّ وذاتِ الجلال والسلطانِ",89,"ن",1,0],["تاجرت رب السما في أنفس","برضى اللَه مذ اللَه اشتراها",90,"ا",3,0],["تاجُها العَسجَدِيُّ رَصَّعَه","بِالجمانِ الثراء وَالسَرَفُ",91,"ف",1,0],["تاجُ رَمسيسَ عَلى البُعدِ صُوىً","لِلأُولى مِنّا سَرَوا في مَجهَلِ",92,"ل",1,0],["تاج القلوب يعيش في سودائها","ويعيش في سودائه الفقراء",93,"ا",2,0],["تاجُ عقيقٍ به تحلى","وزاد حسناً هذا الفضاء",94,"ا",2,0],["تاج الرياسة عَنكُم لا يَنقل","نصل يُسل لَكُم وَيغمد منصل",95,"ل",1,1],["تاجرت في الحب فلم أربح سوى","أن الجوى سعرّ قلبي فالتهب",96,"ب",1,0],["تَاجُ المَكارِمِ والأَكار