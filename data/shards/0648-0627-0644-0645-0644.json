bi.ae/diwan/poem/113836","الكامل"],[4755,"لَيلٌ.. وصَنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203125",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[5121,"هَمْسُ الْقُبَل","https://www.poetsgate.com/ViewPoem.aspx?id=67536",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5199,"الفاتنه","https://www.poetsgate.com/ViewPoem.aspx?id=145686",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5508,"جدَّ الصبَّا في أباطيل الهوى لعب","https://www.poetsgate.com/ViewPoem.aspx?id=110820",""],[5573,"شمس عمري","https://www.poetsgate.com/ViewPoem.aspx?id=200341",""],[5606,"يحسب إن الفوزياجي بالرشاوي","https://www.poetsgate.com/ViewPoem.aspx?id=198631",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203238",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203466",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[5866,"نحمد الله","https://www.poetsgate.com/ViewPoem.aspx?id=182813",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6023,"فدموعهم في الذَّاريات وروحهم","https://www.poetsgate.com/ViewPoem.aspx?id=123877",""],[6115,"رفرفي ياراية التوحيد عالي","https://www.poetsgate.com/ViewPoem.aspx?id=196475",""],[6134,"السعد وافي معلناً بهناء","https://www.poetsgate.com/ViewPoem.aspx?id=169526",""],[6144,"نسوان","https://www.poetsgate.com/ViewPoem.aspx?id=13697",""],[463,"لو كانَ يرفقُ ظاعنٌ بمشيِّعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60141&r=&rc=197",""]],"verses":[["والمُلْكُ لا يحْمِلُ أعْباءَهُ","مَنْ لمْ تُهذِّبْهُ التّجاريبُ",0,"ب",1,0],["والمُلْتَقى كثَبٌ وإنْ طالَ المَدى","وتقلّبتْ بمُعمَّرٍ أطْوارُهُ",1,"ر",2,0],["وَالْمُلْكُ لَمْ يُقْصَرْ عَلَى أًمَّةٍ","وَإِنَّمَا الْمُلْكُ لِغُلاَّبِهِ",2,"ب",2,0],["وَالْمُلْتَقَى كَثِبٌ وَفِي وِرْدِ الرَّدَى","نَهَلَ الوَرَى مَنْ شاءَ ذَلِكَ أَوْ أَبَى",3,"ب",2,0],["وَالمَلكُ فَوقَ سَريرِ المُلكِ تَحرُسُهُ","عَينُ الإِلَهِ وَتَرعى أَعيُنُ الشُهُبِ",4,"ب",1,0],["والملوك يرجعوا عبيد","ولعزّوا يذلّل",5,"ل",1,0],["والملك يصلح عقباها بصالحه","والفضل يقسم من ساداتِها بعلي",6,"ل",2,0],["وَالمُلبِدينَ عَلى خوصٍ مُخَدَّمَةٍ","قَد بانَ فيهِنَّ مِن طولِ السُرى خَضَعُ",7,"ع",1,0],["والملاكُ الجميلُ مَا بَيْنَ ريحانٍ","وعُشْبٍ وسِنديانٍ ظَليلِ",8,"ل",1,0],["وَالمُلكُ يَحرُسُهُ في ظِلِّ واهِبهِ","غُلبٌ مِنَ العُجم أَو شُمٌّ مِنَ العَرَبِ",9,"ب",1,0],["والملك سعيد حاضره","لك في الدنيا حر غده",10,"د",2,0],["وَالمُلكُ بِالأَموالِ أَمنَعُ جانِباً","وَأَعَزُّ سُلطاناً وَأَصدَقُ مَظهَرا",11,"ر",2,0],["وَالمُلكُ يُؤخَذُ أَو يُرَدُّ وَلَم يَزَل","يَرِثُ الحُسامَ عَلى البِلادِ حُسامُ",12,"م",1,0],["والملك أفرحُ مايكون بنصرة","تمت هيأها له الخلاقُ",13,"ق",1,0],["وَالمُلهِياتُ فَمَن لَها وَالغادِيا","تُ الرائِحاتُ مِنَ الجِيادِ الصافِناتِ",14,"ت",1,0],["وَالمَليكُ الَّذي يَرى المَنَّ إِشراَ","كاً بِوَصفِ المُهَيمِنِ المَنّانِ",15,"ن",1,0],["والمُلْكُ إن قامَ به حازِمٌ","أضحى حِمىً والجدّ غيرُ المزاح",16,"ح",1,0],["وَالمُلكُ إِن رَفَعَ الدُستورُ حائِطَهُ","فَغايَةُ العَجزِ أَلّا يَبلُغَ الشُهُبا",17,"ب",2,0],["والمُلْكُ يومئِذٍ لواءٌ خاِفقٌ","يَلقَى الرّياحَ وليسَ غيرُكَ حامل",18,"ل",1,0],["والملوكُ الصِّيدُ من ذي إصْبَحٍ","وَرُعَينٍ وبَني الشّاهِ مَعَدّ",19,"د",1,0],["وَالمُلكُ يَفنى وَلا يَبقى لِمالِكِهِ","أَودى اِبنُ عادٍ وَأَودى نَسرُهُ لُبَدُ",20,"د",1,0],["وَالمُلكُ لِلَّهِ وَالدُنِّيا بِها غِيَرٌ","خَيرٌ وَشَرٌّ وَإِعدامٌ وَإِنجادُ",21,"د",1,0],["وَالمُلكُ ثُبِّتَ لِلقَديمِ وَأُبرِزَت","بِلقيسُ عارِيَةً بِغَيرِ صِدارِ",22,"ر",1,0],["وَالمُلكُ لِلَّهِ ما الأَجرازُ مُمرِعَةٌ","بِحَملِ قَومِكَ أَسيافاً وَأَجرازا",23,"ز",2,0],["وَالمُلكُ لِلَّهِ مَن يَظفَر بِنَيلِ غِنىً","يَردُدهُ قَسراً وَتَضمَن نَفسُهُ الدَرَكا",24,"ك",2,0],["وَالمُلكُ لِلَّهِ ما ضاعَت أَكابِرُهُ","وَلا أُصاغِرُ أَحياءٍ وَلا هُلُكِ",25,"ك",1,0],["وَالمَليكانِ ذاهِبانِ مُوَلّى","مُستَجِدٌّ وَراحِلٌ مَعزولُ",26,"ل",1,0],["وَالمَلكُ فينا هُوَ الفَقيرُ لِما","يَلزَمَهُ مِن مَعونَةِ الخَدَمِ",27,"م",1,0],["والمُلْهِمَأتُ إلى جوانبهمْ","يُكثرْنَ من غمزٍ وإيماءِ",28,"ا",2,0],["والملك كالناس له أوطانُ","ينظمها للأمم السلطانُ",29,"ن",1,0],["وَالمُلْتَقَى صَرْحُ هُدَى","صَرْحُ النَّدَى وَالكَرَمِ",30,"م",1,0],["وَالمُلْك عَادَ أَعَزَّ مِمَّا","كَانَ فِي أَيَّامِ جَدِّكْ",31,"ك",1,0],["وَالمُلكُ جِسْمٌ أَنْتَ فِيهِ هَامَةٌ","وَيَدَاكَ مَشْرِقُ شَمْسِهِ وَالمَغْرِبِ",32,"ب",1,0],["وَالمَلِيكُ العَظِيمُ أَيَّدَهُ الله","خَلِيقٌ بِرَفْعِ شَأْنِ الخَلِيقِ",33,"ق",1,0],["والملهمون بنو هومير ما تركوا","لما أهل لهم سجعاً لطائره",34,"ر",2,0],["وَالمُلوكُ عاجِزَةٌ","عن نُضارِ موسِرِها",35,"ر",3,0],["والملكُ يظهر بالثناء جلاله","والشعر مثل الدرّ في تيجانه",36,"ن",2,0],["والملكُ مؤْتَلقُ السَّنَا","فيه العشيَّةُ كالغَداةِ",37,"ه",1,0],["والملكُ عبءٌ، يؤُود الظهرَ محملُهُ","لا هامة عاطلٌ بالتاج تَزْدان",38,"ن",1,0],["والمُلْتَقَى كَثَبٌ وفي وِرْدِ الرّدَى","نَهَلَ الورَى من شاء ذلك أوْ أبا",39,"ب",2,0],["والمليحات مهرجان من الحسن","يغنّي من الهوى مهرجان",40,"ن",1,0],["والمُلْهَمَ الحائرَ الجبَّارَ ، هل وصَلَتْ","كَفُّ الرَّدى بحياةٍ بَعْدَه سَبَبا؟",41,"ب",2,0],["والمُلصِقونَ بعرش اللهِ ما نسجت","أطماعُهم : بِدعَ الأهواءِ والرِيّبا",41,"ب",2,0],["والملكُ للَّه، والدّنيا بها غِيَرٌ:","خيرٌ وشرٌّ وإعدامٌ وإيجاد",42,"د",1,0],["وَالمليكِ لئن دبّت عقاربهُ","لَيَمَنُونَّ بحيَّاتٍ مناهيش",43,"ش",1,0],["والملة السمحاء ملة أحمد ال","مختار بشر عمها وسرور",44,"ر",1,0],["وَالملكُ في الأَقوامِ مُستَودعٌ","عارِيَّة فَالشَرطُ فيهِ الأَداء",45,"ا",2,0],["والمليكُ الهمامُ بالحجفلِ المَجْ","ر لسمعِ الردَى يُقعِقع شَنَّا",46,"ن",2,0],["وَالمُلكُ لا يَبقى لَهُ إِلّا كَما","يَبقى عَلى وَجهِ المُدامِ حَبابُها",47,"ب",3,0],["والملك فوق تختهِ متوجاً","بدررٍ قد نضدّت وجوهرِ",48,"ر",1,0],["والملك أفضله ما باتَ صاحبه","والملك للملك في الأخرى يؤهّلهُ",49,"ل",2,0],["والملك ملككم تراث أبوة","أبقت عليه لكم يدا وتصرفا",50,"ف",2,0],["والملكُ الأعظم في خُطَّة","من شدةِ الأمرِ وطول السَّهَر",51,"ر",1,0],["والمُلك محميُّ الذمارِ محجَّبٌ","فالمُنْتَضى ومن انتضى سيفان",52,"ن",1,0],["وَالمُلكُ آلَ إِليكَ يحدو خطوَه","شوقٌ إليكَ وَإن أَتى متأَخِّرا",53,"ر",2,0],["وَالمُلكُ إِلّا بِراعٍ مِنكُمُ نَقَدٌ","يَضيعُ وَهوَ لِذِئبانِ الفَلا جُزُرُ",54,"ر",1,0],["وَالمُلكُ قَد كادَت تَميلُ قَناتُهُ","وَتَخُرُّ مِن أَعلى السِماكِ عِمادُهُ",55,"د",2,0],["والملكُ بالأفرادِ والمجموعُ ما","عزّت وذلّتأمةٌ وبلاد",56,"د",1,0],["والملكُ فيها واحدٌ وموحّدٌ","لا خوفَ من غبنٍ ومن تفضيل",57,"ل",1,0],["وَالملك ملكي وَيَبقى","وَجهي وَيفنى الوجود",58,"د",1,0],["وَالمَلِكُ الضَليلُ في ضَلَّةٍ","إِذ فُقتَهُ فَضلاً وَإيمانا",59,"ن",2,0],["والمَلِكُ الصَّالِحُ قَدْ جَدَّ في","المُلْكِ وَما من جَدَّ كاللاعِبِ",60,"ب",1,0],["وَالمُلحِدونَ حَمَدوا طَريقَتي","حينَ رَأَوني لِهَواها مُلحِدا",61,"د",2,0],["وَالملك حازَ حُلى الجَمال","وَالعَين ما نَظرت خِلافَه",62,"ه",1,0],["وَالمُلكُ لِلَّهِ لَيسَ الاِمر مُشتَرِكا","وَلَيسَ لِلَّهِ في الاحكام أَعوان",63,"ن",1,0],["والمُلْكُ مُلْكُ الأرضِ أجمعِها","كالطّوقِ منه أُلزِمَ النَّحرا",64,"ر",2,0],["والملْكُ مثْلُ الشّمسِ كاسِرةً","أبصارَنا من دُونِها كَسرا",64,"ر",2,0],["والمُلقِّي العَلياءَ مِن شَرفِ المح","تدِ مَجداً أَشفَّ مِنها وأَعلَى",65,"ل",2,0],["والملائكة وكتب الله ذي الفضل والشان","والرسل كلهم أيقن بهم أي ايقان",66,"ن",1,0],["وَالمَلكُ كالغاب منه خدر ذي لِبَدٍ","ومنه مرتَبعٌ لِلشّاء وَالنَعَمِ",67,"م",1,0],["والمُلْكُ أَهَّلَكَ اللُّه اللطيفُ له","من بعدِ ما كادَ أَنْ يُشْفِي على الهَلَكِ",68,"ك",1,0],["والمُلْكُ شمسٌ ولولا ياسِرٌ أُخِذَتْ","كم