{"poems":[[32,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[90,"قضى والليل معتكر بهيم","https://www.aldiwan.net/poem45034.html","الوافر"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[53,"إن قال لا قالها للآمريه بها","https://www.aldiwan.net/poem66385.html","البسيط"],[45,"وشامخ من الجبال أقود","https://www.aldiwan.net/poem9548.html","الرجز"],[47,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[47,"عفى علي بن إسحاق بفتكته","https://www.aldiwan.net/poem66819.html","البسيط"],[68,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[48,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[48,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9901","الوافر"],[108,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[108,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[102,"اعتراف بلا توبة","https://www.poetsgate.com/ViewPoem.aspx?id=50337",""],[47,"عَفّى عَلِيُّ بنُ إسحاقٍ، بِفَتكَتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31810",""],[53,"إنْ قال لا قالها للآمريهِ بها","https://www.poetsgate.com/ViewPoem.aspx?id=30553",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[164,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[173,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[240,"أبثك وجدي لو أصخت لمعمود","https://www.aldiwan.net/poem32105.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[369,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[376,"دنت فرأتني عاتبا متطرفا","https://www.aldiwan.net/poem57300.html","الطويل"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[438,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[463,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[463,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[520,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[520,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[556,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112450","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48543","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48542","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105444","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202079","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133806","المتقارب"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126620","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19972","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45436","الطويل"],[2049,"","https://poetry.dctabudhabi.ae/diwan/poem/118058","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48224","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27992","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27768","البسيط"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116762","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120638","السريع"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96434","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201328","السريع"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74257","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112607","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113895","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132577","الوافر"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126979","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138711",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91950","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114579","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135563","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77129","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119689","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133102","الطويل"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34747","البسيط"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18818","الرجز"],[4755,"المعنى في وجه الشاعر..","https://www.poetsgate.com/ViewPoem.aspx?id=190897",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[4978,"تشطير عين سارة لغالية أبو ستة","https://www.poetsgate.com/ViewPoem.aspx?id=177201",""],[4978,"رد مشاكس","https://www.poetsgate.com/ViewPoem.aspx?id=177202",""],[5050,"خير الرجال فتى في الهول قد ثبتا","https://www.poetsgate.com/ViewPoem.aspx?id=38203",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["وَلَم يَقِل إِلّا فَضاءً فَدفَدا","كَأَنَهُّ العَيّوقُ حينَ عَرَّدا",0,"د",2,0],["ولم يقتنُوْا بعد الثناء ذخيرةً","سوى الصّارم المصقول والصافن النَّهدِ",1,"د",1,0],["ولم يقتله إبراهيم فيما","أرى بل إن قاتله سليم",2,"م",1,0],["وَلَم يُقَل بَعدَ زَلَّةٍ لَهُمُ","كُرُّوا المَعَاذِيرَ إنما حَسِبُوا",3,"ب",3,0],["ولم يَقُلْها لمن يَعفُو فواضلَهُ","كالَّافظين بها منعاً وحِرمانا",4,"ن",2,0],["وَلَم يَقَع إِلّا عَلى بَطنِ يَدِ","وَلَم يَدَع لِلشاعِرِ المُجَوِّدِ",5,"د",1,0],["وَلَم يَقصُر وَفائي عَن مَداهُ","فَيُسلِمَني إِلى التَقصيرِ عُذري",6,"ر",2,0],["وَلَم يُقَل لَكَ في وِترٍ طَلَبتَ بِهِ","تِلكَ المَكارِمُ لا قَعبانِ مِن لَبَني",7,"ن",2,0],["وَلَم يَقرَعِ الأَسماعَ وَقعُ خِطابِهِ","وَلَم يَطرُقِ الهَيجاءَ مَوقِعُ خَطبِهِ",8,"ب",2,0],["وَلَم يَقُد لِلحُروبِ أُسدَ وَغىً","تَسري بِها مِن رِماحِها أَجَمُ",9,"م",1,0],["وَلَم يَقرِ في الحَوضِ راعي السَوا","مِ إِلّا لِيورِدَهُ ما قَرى",10,"ر",2,0],["وَلَم يَقتَرِف مِن رِضا رَبِّهِ","وَلَكِن جَرائِمُه يَقتَرِف",11,"ف",1,0],["وَلَم يَقرِ الضُيوفَ إِذا أَتَوهُ","وَلَم يُروِ السُيوفَ مِنَ الكُماةِ",12,"ه",1,0],["ولم يقترف ذنبًا، ولم يجن مأثمَا","سوى أنه بالدين شُدْت أواصره",13,"ر",2,0],["ولم يقض في ظلِّ الصوامع عيشهُ","قعيدًا، وليس المسلمُ الحقُّ قُعددا",14,"د",2,0],["ولم يقل : إلف ومألوفة","تجمعا سبحان من جمعا",15,"ع",2,0],["وَلمْ يَقُلْ لكَ في وِتْرٍ طَلَبْتَ بِهِ:","تِلكَ المَكارِمُ لا قَعبَانِ مِن لَبَنِ",16,"ن",1,0],["ولم يُقلْها لمن يَعفُو فواضلَهُ","كاللافظين بها منعاً وحِرمانا",17,"ن",2,0],["ولم يقْعُدْ بها في الوصف حشْدٌ","ولكنْ لا ينال نداك حشدُ",18,"د",1,0],["ولم يقولوا أحاديث السما انقطعت","وما بقى غير ما القرآن يحكيه",19,"ي",2,0],["وَلَم يَقُل وَحدَهُ ما قالَ بَل شَهدَت","بِهِ الأَفاضِلُ مِن بَغدادَ عَن كَمَلِ",20,"ل",1,0],["وَلَم يَقتَنِع منهُم بِدُنيا اِستفادها","وَلكنّهُ قَد شاركَ القومَ في الأخرى",21,"ر",2,0],["وَلم يَقَع مِن قَبلُ في مِسمَعِ","أَمامَ هذا الهَيكَلِ الأَطهَرِ",22,"ر",1,0],["ولم يقبلوا حكم الدعِيّ لأنهم","تسامَوا وسادُوا في المهود وقادوا",23,"د",3,0],["وَلَم يَقتَنِع مِنهُ بِما شادَ قَومُهُ","وَما أَحكَموهُ مِن بِناءٍ وَتَشيِيدِ",24,"د",1,0],["وَلَم يقتنص عفواً بسهم تنصّلٍ","سليم الحلى عن ظنّة تخدش الأهبا",25,"ب",2,0],["ولم يَقْترِنْ سَعْدانِ أسعدُ منهما","لدينٍ ولا دُنيا على عَهْدِ عاهد",26,"د",1,0],["ولَم يَقتصِر مِنهم عَلى مثلِ فعلِهِم","فتحسَبُه استَملى من القَوم واقتَفا",27,"ف",2,0],["ولم يقل ايش قال الناس أو فعلوا آه","مراقب الله كأنه للمهيمن يراه",28,"ا",2,0],["ولم يقعِ التوقيعُ فصْلَ قضيّةٍ","وإن كان فيها الحكمُ للعين باديا",29,"ي",2,0],["ولم يقولوا إلا بما علموا","ولا روَوا فيك غيرَ ما سمِعوا",30,"ع",3,0],["ولم يقصِّر قومُه عن سودَدٍ","يُخبَرُ عن أوّلهم بالآخرِ",31,"ر",1,0],["ولم يَقعُدْ عن المعروف جُندٌ","من الكرماء إلا قام جُندُ",32,"د",1,0],["ولم يقف جودك عن غاية","حتى شفعت الجود باستشهاده",33,"د",2,0],["ولم يقدم الفسطاط إلا وعزمه","يؤخر رجلاً خوفه ويقدم",34,"م",1,0],["ولم يقرها إلا شبا السيف في الوغى","وإلا سقيطاً من قناً متحطم",35,"م",1,0],["وَلَم يَقْرِها إِلّا الصّفيحَ مُثلَّماً","وإلّا الوَشيجَ بالطِّعانِ مُدَقّقا",36,"ق",2,0],["وَلَم يَقِهِ فِرعَونَ عَونٌ أَعَدَّهُ","وَلا مُردُ نَمروذٍ حَمَت وَأَشايِبُه",37,"ب",2,0],["ولم يقم منه ولكن يفح","فيه إذا قيل لهم تفسحوا",38,"ح",3,0],["ولم يقد من نفسه ولا انتصل","ولا رأى ردّ الذي كان وصل",38,"ل",1,0],["ولم يقاتله على اغتصابه","ما هو كان عنده أولى به",38,"ه",1,0],["ولم يقل بأنه أقاما","ولا رأى من بعده إماما",38,"م",2,0],["ولم يَقْرَع النَّاقُوسَ بعدَ انْهِزامِه","ولكنَّه من بَعْدِه قَرعَ السِّنَّا",39,"ن",2,0],["وَلَم يَقِفِ البَشكَنسَ في وَجهِ زَحفِهِم","وَلا أَوطَأوا الجُرمانُ ثَغرَةَ مِعوَرِ",40,"ر",1,0],["ولم يقم مهتاجاً","كالأسد الزءآر",41,"ر",1,0],["ولم يقصد بها غيظي ولكن","جرى فيها على النمط الجديد",42,"د",1,0],["ولم يقتنع حتى تطلع طامعاً","إلى سَفَرٍ يرقى العلى بعده السُفْرُ",43,"ر",1,0],["وَلَم يَقبل لَهُم قَولاً وَآبت","لَهُ الأرسال حائِرة خِيابا",44,"ب",2,0],["ولم يقل في قديم الدهر مفتخراً","أنا الذي نظر الأعمى إلى أدبي",45,"ب",2,0],["ولم يَقْضِ أيامَه فاغِراً","لِمَيْتَتِه فَاهُ مِثْلُ الكِلاب",46,"ب",1,0],["ولم يقرع الأذنَ إلا العويلُ","يردّده الجبل المتعب",47,"ب",1,0],["ولم يق صبر يستعان على النوى","به بعد توديع الخليط ولا جفن",48,"ن",1,0],["ولم يقع ترتيبها على نسق","بل باعتبار ماتهيا واتفق",49,"ق",1,0],["ولم يقل بعلة للوتد","إلا إذا صدرا أتى أو ابتدي",50,"ي",1,0],["ولم يقل بما أتى في الكامل","من بعد وقص هامة للناقل",50,"ل",1,0],["ولم يقع واو وقبلها فتح","في الضرب مع يا بعد حرف منفتح",50,"ح",1,0],["وَلَم يُقَم في يَوم بَأسٍ وَنَدىً","وَلا تَلاقى سَبَبٌ إِلى سَبَب",51,"ب",1,0],["ولم يقدر لي صالح العمل","سبحانك اللهم حقق الأمل",52,"ل",1,0],["ولم يقل إنه يعني استوى فوق عرشه","قعوداً في جسمٍ تبعضَ مقتسم",53,"م",1,0],["وَلَم يُقرَها السَعدِيُّ عَمرو بنُ مالِكٍ فَيُش","عَبُ مِن حَوضِ المَنايا لَها قِسما",54,"م",2,0],["ولم يقرع الباب الذي لا يرومه","وحاجبه إلا القروم الجحاجح",55,"ح",1,0],["ولمَ يقُلْ إِن أتاه المرءُ مجتدياً","لا خيلَ عندك تُهديها ولا مالُ",56,"ل",1,0],["ولم يقل فيه إن الله يعرفهم","فقل به إن تكن للحقِّ متبعا",57,"ع",2,0],["ولم يقيد بشيء ما يزيد على","ما قيدته لنا حتى يوفيها",58,"ي",3,0],["ولم يقض جيراني لبانة ذي الهوى","ولم يرعووا من طول تحلية الصدي",59,"ي",1,0],["ولم يَقُل مِعشَارَ ما يَقتَضِي","بعضُ أيادِيكَ العراضِ الطوال",60,"ل",1,0],["ولم يقم من بعدهِ فيهِ سوى","ستة أشهرٍ وفي اللحد ثوى",61,"ث",3,0],["ولم يقم في الملك إلا عاما","وأيُّ ملكٍ ونعيم داما",61,"م",2,0],["ولم يقر ما جرا ولا حج حجةً","فيضرب سهما أو يصاحب أكبلا",62,"ل",2,0],["ولم يُقم في الحان ممن مشى","خلفيَ غير العاجز الظالع",63,"ع",1,0],["وَلَم يُقم حولهم إلا مُداهنهم","من بعد ما أخبر الأقوام كاهنهم",64,"م",1,0],["وَلَم يَقُل ما لَهُ يَوماً لآخذه","أَنا القَتيل بِلا إثم وَلا حَرَج",65,"ج",1,0],["ولم يقض غير القبطان وقد نجا","من الوت ملاحون فوق الزوارق",66,"ق",1,0],["ولم يقتبس من دينه قوة وما","أتاه عيسى من علوم بها جئت",67,"ت",1,0],["ولم يقض لي الدين","ولم ينجز بهم وعدي",68,"د",2,0],["ولم يقم معي إلى الأكل أحد","إلا أناساً من عساكر البلد",69,"د",1,0],["ولم يقصده راج منه نيلاً","وآب ولم ينل بالنيل قصده",70,"د",2,0],["ولم يقطع لحمزة من كريم","ولم يرفع بمعتدل القوام",71,"م",1,0],["ولم يقرع له ثغرٌ لاطفا","لهيب من ذوي حقدٍ لئام",71,"م",1,0],["وَلم يَقُم برجالٍ ماجدين لَهُم","عزمٌ يبدّدُ من جونِ العَنا حلكه",72,"ك",2,0],["ولم يقم بينهم غش ولا كذب","ولا خصام على رزق ولا مالِ",73,"ل",1,0],["ولم يَقُلِ اخلَع وَهوَ واطِئُ عَرشِهِ","فإِنَّك بالعَرشِ المُعَظَّمِ ذا استوا",74,"و",2,0],["ولم يقل لك بذا الذكر اذكرا","وذلك الذكرَ به لا تذكرا",75,"ر",2,0],["ولم يقس بالسماويات جوهره","ألا قياس سماويّ بأرضيّ",76,"ي",1,0],["ولم يقف حتى الأياسين أتى","فقال قد أنفذت للفلك فتى",77,"ت",2,0],["وَلَم يَقضِ لي دَينُ الغَرامِ مَقالَتي","لَعَلَّ خَيالاً طارِقاً سَيَعود",78,"د",1,0],["ولم يقم طائعاً إلا ويظعنه","رأيٌ إلى سفرٍ بالرغم يُزمِعه",79,"ع",2,0],["وَلَم يَقُل صَقرُ بني أُمَيَّةٍ","إذ صادَهُ كَيداً لَهُ أطرِق كَرَا",80,"ا",1,0],["وَلَم يُقَصِّر في مَدى الكَيدِ الَّذي","جارَى بِهِ عَمراً قَصِيرٌ بَل شَأَى",80,"ا",1,0],["وَلَم يُقَصِّر في طِلابِ ثارِهِ","مُحَرِّقٌ مِن بَعدِهِم ولا ائتلى",80,"ا",1,0],["ولم يقدروا في دفع هذا بممكن","لأن عضال الداء فيهم تمكنا",81,"ن",2,0],["وَلَم يُقَدِّم عَلَيَّ خُلقاً","وَلَم أُقَدِّم عَلَيهِ خَلقا",82,"ق",2,0],["وَلَم يَقُل مُنتَصِحاً إِيّاكِ","بَينَ مَقاطيها رَكِبتِ فاكِ",83,"ك",1,0],["ولَم يَقُم لِلحَربِ لكنّها","ذُبابةٌ حَطَّت على لَحنِهِ",84,"ن",2,0],["ولم يقتدوا إلا لتحقيق نسبة","إليهم فهم لي في التناسب إخوان",85,"ن",1,0],["وَلَمْ يَقْبَلْ تَآمُرَهُمْ شَرِيْفٌ","وَإِنْ لَبِسَ الْعِمَاْمَةَ ذُو الْخِمَاْرِ",86,"ر",1,0],["ولم يقصر فتيان الوغى اجتهدوا","( للخصم منذ اعلنوها ثورةً حملوا",87,"ل",3,0],["ولم يقصر بنا الثوار فاجتهدوا","من خصمنا مذ اعلنوها ثورةً حملوا",88,"ل",3,1],["ولم يقر على ذل يعاينه","وليس ممن على ضيم العلى سكتا",89,"ت",2,0],["ولم يقاسي من الأهوال فادحة","ولا أستهين بلوعات وروعات",90,"ت",1,0],["ولم يقهر لنا العدوان سيفا","يمانيا ولم يكسر جناحا",91,"ح",2,0],["ولم يقد بنا للشعر راحا","كراح الله في عيسى الجنين",92,"ن",1,0],["ولم يقدر بنا للعلم نورا","كنور الله في طه الأمين",92,"ن",1,0],["ولم يقدر لنا م قد سمكنا","به للضاد من حصن حصين",92,"ن",1,0],["ولم يقع الإحصا لعلمك في الوجو","د علوا وسفلا بل ولا في القيامتي",93,"ت",2,0]]}