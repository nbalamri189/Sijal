{"poems":[[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[242,"أعضلت علتي فجئت رئيسا","https://www.aldiwan.net/poem19700.html","الخفيف"],[264,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[398,"حب علي بن أبي طالب","https://www.aldiwan.net/poem53626.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122622","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128720","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69394","المتقارب"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110345","الكامل"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104435","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124758","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132005","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""]],"verses":[["وَأَمَّ مَديَنَ زَيدٌ فَاِستَوَت يَدُهُ","عَلى العَدُوِّ وَساقَ السَّبيَ كَالغَنَمِ",0,"م",1,0],["وَأَمَّ مُرسَلُهُ بَغدادَ مُنتَجِعاً","حَمّالَةَ الضَيمِ في سُلطانِهِ وَصَمُ",1,"م",1,0],["وَأَمَّمْتُ كَنْزَ الْغِنَى عَيْنَ أَعْيَا","نِ السُّرَاةِ بَحْرَ النَّدَى إِدْرِيسَا",2,"س",2,0],["وأمّ مرفوع باب الفتح منخفضاً","بالجزم يعرب حالاً لاح غير خفي",3,"ف",2,0],["وَأُمُّ موسى إِذ رَمَت تابوتَهُ","وَرَدَّهُ وَعَينُها الَّتي أَقَر",4,"ر",1,0],["وَأُمُّ مَن نابذه عاهِر","تُبذَلُ لِلنازِل وَالراكِبِ",5,"ب",1,0],["وأمَّ مَن أمَّ من صَفِّ الملائِكَةِ ال","أبرارِ فاعجَب عَلَى بَرِّ وأبرار",6,"ر",1,0],["وأم معبد في مطوي قصتها","أدلة أعربت ما كان منعجما",7,"م",2,0],["وأم معبد وافاها وبارك في","شاة شكت عجفا من فقدها العلفا",8,"ف",2,0],["واممتُ دارَك في حِلى وطنيَّتي","ومحبة الأوطان أفضل حِلية",9,"ه",1,0],["وَأَمَّمنَ بَحراً إِذا ما شَرَعنَ","إِلى مائِهِ العَذبِ عِفنَ البِحارا",10,"ر",2,0],["وأممت مهد السين تعرضها على","أممٍ من الغرب احتشدن هناكا",11,"ك",2,0],["وأم مهبط وحي اللَه مضطهداً","يشكو إلى اللَه ما لاقى من المحن",12,"ن",1,0],["وأم مع الأولاد مثل أبيهم","عليها احتم التعديل في القسم ترشد",13,"د",1,0],["وأمما لم تجن","وما لها أوزار",14,"ر",1,0],["وأم مع الصديق أكالة القرى","تلين له الشجوى وتطوى له الفجوا",15,"و",2,0],["وأمُّ محمدٍ بالحب تطوي","صحاري الوجد تبحث عن عزاءِ",16,"ا",2,0]]}