{"poems":[[53,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[87,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[119,"سارت تزمزم للحمى الركبان","https://www.aldiwan.net/poem40480.html","عموديه"],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[190,"بعبد الواحد استعصمت لما","https://www.aldiwan.net/poem43203.html","الوافر"],[242,"أخذنا طريق القوم حمدا لسيد","https://www.aldiwan.net/poem18181.html","الطويل"],[242,"بعبد الخالقالجود السخي","https://www.aldiwan.net/poem19750.html","الوافر"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[374,"عفا الله عما جره اللهو والصبا","https://www.aldiwan.net/poem4295.html","الطويل"],[396,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[406,"يا الله","https://www.aldiwan.net/poem10310.html","عموديه"],[409,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[422,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[484,"مجزوء الوافر","https://www.aldiwan.net/poem36908.html","مجزوء الوافر"],[505,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87168","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132907","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111781","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108628","الوافر"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116494","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93436","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121157","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88957","الوافر"],[3497,"","https://poetry.dctabudhabi.ae/diwan/poem/204010","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86268","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114060","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90817","الوافر"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139592",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[1696,"اللَه اللَه اللَه","https://www.poetsgate.com/ViewPoem.aspx?id=173328",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""]],"verses":[["بع بُناناً فأنت عنها غنيٌّ","إنما يقتني الدجاجة ديك",0,"ك",1,0],["بِعَبد شَمسٍ فازَ عَبدُ المطلِب","لا كفءَ لِلغالب إِلا مَن غُلِب",1,"ب",1,0],["بِعَبد الغنيّ اِستَغنتِ العَينُ أَن تَرى","مَحاسِنَ طُرزٍ في الرِياضِ حسانِ",2,"ن",1,0],["بعبادك القوم الذين قلوبهم","طارت اليك وكلها وجدان",3,"ن",1,0],["بعبدك طه المصطفى سيد الورى","ومن هو للأملاك والأنبيا مولى",4,"ل",2,0],["بعبد الواحد استعصمت لما","دهاني من زماني ما دهاني",5,"ن",2,1],["بِعَبْدِ السَّلاَمِ قُطْبِ الأَقْطَابِ كُلِّهِمْ","فَكُلٌّ بِهِ لِلْفَخْرِ يُدْلِي بِأَوْحَدِ",6,"د",1,0],["بِعَبْدِ الْخَالِقِالْجُودِ السَّخِيِّ","مَلاَذِ الْخَلْقِ ذِي الْخُلُقِ الْبَهِيِّ",7,"ي",1,1],["بعُبَّادِ عِيسَى هَاضَ أُمَّةَ أحْمَدٍ","لأَشْيائِهَا بَخْساً وأعْيُنِهَا بَخْصا",8,"ص",2,0],["بعبد الرحيم الفاضل انبجست لنا","عيون العُلا تجري بمدِّ سيوله",9,"ل",2,0],["بعبدالله مع علوي وبصري","جديد مع محمد نق جيبي",10,"ب",2,0],["بعبارة الإخلاص حين نقولها","يصفو لنا روض الهدى وشذاه",11,"ا",2,0],["بعبارة رقت ورا","قت فهي كالسحر الحلال",12,"ل",1,0],["بعبرة مشتاق إذا لم تجد لها","من الدَّمع ما يروي الدّيار بكتْ دما",13,"م",2,0],["بعَبْدٍ حَبا يُمْنَاكَ مُعْجِزَ رَبِّهِ","وأَصْفاكَ منه طاعَةَ المُخْلِصِ الحُرِّ",14,"ر",1,0],["بعبك أيها الوطني","تراض جوامح الزمن",15,"ن",1,1],["بعبيدك الأملاك املاك السما","ء وكل سر شاهدوه وتاهوا",16,"ا",1,0],["بعبد اللَطيف الخلوتيِّ وَمصطفى","رَفيع الذرى البكريْ التقيِّ عميدنا",17,"ن",2,0],["بعباس المنيف على البرايا","وأفضلها وأطولها نجادا",18,"د",2,0],["بعبدك حُرمةٌ والّكر فحشٌ","فلا تُحوِج إلى ذكر الوسيله",19,"ه",1,0],["بعبد الله يعلو كلُّ مدحٍ","وفي ذكراهُ ينتظمُ النظامُ",20,"م",1,0],["بعبد القادر الأبطال سرت","سرور الممتلين من العقار",21,"ر",1,0],["بعبارة خلابة غلابة","تروي المدارك كوثرا وشمولا",22,"ل",2,0],["بعبادة المخلوق من حجر ومن","بشر ومن قبر ومن أوثان",23,"ن",1,0],["بعبدك المضاف للرحمن","المدني الدار والأوطان",24,"ن",1,0],["بِعَبدِ العَزيزِ ابن الخَلائفِ وَالَّذي","جَميعُ المَعالي تَنتَمي حَيث يَنتمي",25,"م",2,0],["بعبد المجيد النّدب ثمّ شهابنا","انسنا بروح الصدق في ظلمة الدّجنِ",26,"ن",1,0],["بعباس النضال حليف ملك","ووافي الفضل بسام النوال",27,"ل",1,0],["بعبد الله طلت إلى الأماني","وأعقب قبح إعساري يسار",28,"ر",1,0],["بِعَبّاس غَدَت مِصر رِياضا","لَنا تَصفو مَناهِلَها حِياضا",29,"ض",2,1],["بِعَبدِ الإِلاَهِ أصبَحَت نِسوَةٌ بِهِ","زَلِيخَا وَرَاوَدَت عَن اطهَرِ جَانِبِ",30,"ب",1,0],["بعبرتها أقبلت تسبح","على ركبتي زفس تنطرح",31,"ح",1,0],["بعبد القادر المولى تسمى","وللأسماء سر في العباد",32,"د",1,0],["بِعِبْءِ هَمٍّ لِيَومِ الحَشْرِ أَثْقَلَهُ","وَهَبْ لَه مِن جَميلِ الصَّبْرِ أَجْمَلَهُ",33,"ه",1,0],["بعبد الكريم العيش أصبح صالحاً","وأمسى به الدهر المعادي مُصالحا",34,"ح",2,1],["بعبدها مطمئنة طهرت","من رجسها لا إله إلا الله",35,"ل",2,0],["بعبدك ميكائيل رب يكيله","الوفى ولا صناعاً هناك ولا حتما",36,"م",2,0],["بعبادة المولى فريد أوانه","محيي الدجا بتلاوة القرآن",37,"ن",1,0],["بعبارة أنت الذي سطرتها","يوما وصارت حكمة الأزمان",38,"ن",1,0],["بعبد العزيز ابن الإمام بن فيصل","حليف العلى نسل الكرام الأطايب",39,"ب",1,0],["بعبد مناف سيد العرب أرغمت","على الخفض من نعتي أنوف",40,"ف",1,0]]}