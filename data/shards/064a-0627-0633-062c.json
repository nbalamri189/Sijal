{"poems":[[99,"يا سجين الحياة أين الفرار","https://www.aldiwan.net/poem24992.html","الخفيف"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[230,"أي صوت حيته بالأمس باريس","https://www.aldiwan.net/poem55196.html","الخفيف"],[482,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[484,"يا سجينا ما حال سجنك إيه","https://www.aldiwan.net/poem37583.html","الخفيف"],[742,"","https://poetry.dctabudhabi.ae/diwan/poem/146201","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44917","الخفيف"],[4723,"في السجن","https://www.poetsgate.com/ViewPoem.aspx?id=62015",""],[5111,"يا قُضَاةً","https://www.poetsgate.com/ViewPoem.aspx?id=212529",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5431,"رثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=204906",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""]],"verses":[["يا سجين الحياة أين الفرار","أوصد الليل بابه والنهار",0,"ر",1,1],["يا سجلَ التَّاريخ، حدِّث بما عا","يَنتَ، ليس السَّماعُ مثلَ العيان",1,"ن",1,0],["يا سجلَّ الخلود فَاِفسَح مجالاً","لاسمهِ في صَحيفةِ الفُضلاءِ",2,"ا",2,0],["يا سُجَّعَ الورقِ لقد شاقَني","حمامةٌ فوقَ النقا تَسجعُ",3,"ع",1,0],["يا سجينا ما حال سجنك إيه","لم أفكر في غير تونس فيه",4,"ي",2,1],["يا سجستان قد بلوناك دهراً","في حراميك من كلا طرفيك",5,"ك",1,1],["يا سجيني آنَ القصاصُ وهذا","وعدُ ربِّي حَقّاً لأول جاني",6,"ن",2,0],["يا سَجينَ الآلامِ يا عاثرَ الحَظ","ظِ كَفاكَ الشُرودُ وَالاغفاءُ",7,"ا",2,0],["يا سجنُ إنّي قد غدوتُ وحيدا","ونَظَمتُ آلامي إليكَ قصيدا",8,"د",2,1],["يَا سُجُونًا انْصِفِيْنِيْ","كَانَ حُبًّا ، وَاخْتَفَا",9,"ف",2,0],["يا سجيناً وكلُّ دنياكَ سجنٌ","كُنْ سوى أنْ تكونَ نفسكَ سِجنا",10,"ن",2,0],["ياسجنُ أفكار الصباح طليقة ...","من ذا سيحبسُ ومضةً في الراس؟",11,"س",1,0],["ياسجون الود فكي عن سجين.","كل قيدٍ من دلالك من جفاك.",12,"ك",1,0]]}