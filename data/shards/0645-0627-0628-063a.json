{"poems":[[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136279","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121027","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127026","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136816",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5526,"كوكب منعزل","https://www.poetsgate.com/ViewPoem.aspx?id=193337",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""]],"verses":[["ما بَغاها مِن عِندِ غَيرِكَ مَن يَف","رُقُ بَينَ الأَطواقِ وَالأَغلالِ",0,"ل",1,0],["ما بغيتي غير ان ادعى بعبدكمو","حسبي انتسابي لكم عن عم أو خال",1,"ل",1,0],["ما بغيضٌ إلى الكرام خصوصاً","وحبيبٌ إلى الأنامِ عموما",2,"م",2,1],["ما بغوه لَو زِدْت الف راسِ","هِجْن مَعْ لَك شيكٍ نْصِرْفَه",3,"ف",2,0],["ما بغية أبتغيها لي سواه ولا","من ناقة لي في الدنيا ولا جمل",4,"ل",1,0],["ما بغي ابدي معاني سركم عند مبعد","خوف من ذا يشبهكم ومن ذا يلحد",5,"د",1,0],["مابغا يبدل فيه لأسمع تبديل","والناس قالوا ماتخافه أفبده",6,"د",2,0],["ما بغيتك ساعه بعده .. ياالاميره ترحلين","عاشقك يبغاك قربه لين ما بعد الأزل",7,"ل",1,0],["(مابغيت أطيح بيده) لين ماربي بلاني","ولا أنا لو هي بكيفي (مابغيت أطيح بيده)",8,"د",2,0],["مابغيته غير دربٍ شتّت اقدام الدليله","مزنةٍ ما بللتني واستحيت اطلب مطرها",9,"ر",3,0]]}