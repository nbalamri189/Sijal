{"poems":[[55,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[55,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[73,"أرى شأنيك شأنهما انبجاس","https://www.aldiwan.net/poem4022.html","الوافر"],[74,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[31,"أرى شعراء الناس لما تقاذفوا","https://www.aldiwan.net/poem6105.html","الطويل"],[34,"أرى شجرات الدار خضرا ولا أرى","https://www.aldiwan.net/poem27712.html","الطويل"],[87,"أرى شجراً في السماء احتجب","https://www.aldiwan.net/poem8087.html","المتقارب"],[64,"أرى شغفي بطلاب العلى","https://www.aldiwan.net/poem52290.html","المتقارب"],[47,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[30,"أرى شعراء الناس غيري كأنهم","https://www.aldiwan.net/poem5321.html","الطويل"],[82,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[107,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[107,"ألا لا أرى في مصر إلا دعاويا","https://www.aldiwan.net/poem43396.html","الطويل"],[77,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"جيب الزمان على الآفات مزرور","https://www.aldiwan.net/poem22547.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[208,"تبدت لنا حوراء في صورة الإنس","https://www.aldiwan.net/poem53124.html","الطويل"],[308,"تملكت في وجدي لعشقي في الورى","https://www.aldiwan.net/poem57843.html","الطويل"],[371,"وقالوا قصها عن رأي عين","https://www.aldiwan.net/poem17716.html","الوافر"],[415,"أرى شعرات ينتبذن كأنها","https://www.aldiwan.net/poem31979.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[520,"لك المجد والفضل الذي ليس يجحد","https://www.aldiwan.net/poem12072.html","الطويل"],[594,"","https://poetry.dctabudhabi.ae/diwan/poem/28416","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48895","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48846","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63869","الطويل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/198730","الوافر"],[982,"","https://poetry.dctabudhabi.ae/diwan/poem/199804","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107226","الوافر"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130643","البسيط"],[1541,"","https://poetry.dctabudhabi.ae/diwan/poem/198487",""],[1914,"","https://poetry.dctabudhabi.ae/diwan/poem/202239","المتقارب"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69483","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109663","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10488","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129845","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76081","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202915","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200433","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204816","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200177","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62811","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62781","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62806","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45806","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131092",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101371","الوافر"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20887","المتقارب"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33078","الوافر"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62053","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52182","البسيط"],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[4578,"بشاير وافتنا بسعد محمدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49407",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[444,"صباح مُحلّى حُبّا","https://www.poetsgate.com/ViewPoem.aspx?id=184403",""],[5922,"صراخ فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=185119",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[2588,"شاخصة (تحذير)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65600&r=&rc=32",""]],"verses":[["أَرى شَجَراً طالَت وَقَصَّرَ ظِلُّها","فَلا أَورَقَت يَوماً وَطالَ ذَواها",0,"ا",3,0],["أَرى شَيبَةً في العارِضَينِ فَيَلتَوي","بِقَلبِيَ حَدّاها جَوىً وَغَليلُ",1,"ل",1,0],["أَرى شَعبانَ يُذكِرُني اِشتِياقي","فَمَن لي أَن يُذَكِّرَكُم ثَوابي",2,"ب",2,0],["أَرى شَعباً بِمَدرَجَةِ العَوادي","تَمَخَّخَ عَظمَهُ داءٌ عُقامُ",3,"م",1,0],["أَرى شَأنَيكَ شَأنهُما اِنبِجاسُ","تَجَنَّبَ مُقلَتَيكَ لَهُ النُعاسُ",4,"س",1,1],["أرى شعرات الشيب تؤذن بالردى","وينذرني منها طلوع هلال",5,"ل",1,0],["أَرى شُعَراءَ الناسِ لَمّا تَقاذَفوا","بِكُلِّ عَضوضٍ تَملَأُ الفَمَ عاقِرِ",6,"ر",1,1],["أَرَى شَجراتِ الدارِ خُضراً ولا أَرى","سِوى شَجراتِ الدارِ شَيئاً تَرَوَّحُ",7,"ح",1,1],["أَرى شَجَراً في السَماءِ اِحتَجَب","وَشَقَّ العَنانَ بِمَرأى عَجَب",8,"ب",1,1],["أرى شَغَفِي بطِلاب العُلَى","يُعرِّضُنِي للأمور العِظَامِ",9,"م",1,1],["أَرى شَملَكُم يا أَهلَ حِمصٍ مُجَمَّعاً","بِعَقبِ اِفتِراقٍ مِنكُمُ وَتَشَعُّبِ",10,"ب",1,0],["أَرى شُعَراءَ الناسِ غَيري كَأَنَّهُم","بِمَكَّةَ قُطّانَ الحَمامِ الأَوالِفِ",11,"ف",1,1],["أرَى شَعَرَاتي السودَ قادتْك في الصبا","وَقَطَّعْتِ في عَصرِ المشيبِ سَلاسِلي",12,"ل",2,0],["أرى شِيَعاً وأحزاباً غِضاباً","لغيرِ اللهِ والوطنِ الغَضُوبِ",13,"ب",1,0],["أرى شعباً يُقادُ إلى المنايا","فيذهب مُمعِناً خَبَب الجنيبِ",13,"ب",1,0],["أَرى شِيَماً تُفني الأَماديحَ كُلَّها","وَما بَرَحَت تُملي عَلَيَّ الأَهاجِيا",14,"ي",2,0],["أرى شعراءَ المُلكِ تَنْحِتُ جانبي","وتَنبو عن اللّيْثِ المخاضُ الأوارك",15,"ك",1,0],["أَرى شَواهِدَ جَبرٍ لا أُحَقِّقُهُ","كَأَنَّ كَلّاً إِلى ما ساءَ مَجرورُ",16,"ر",1,0],["أَرى شَرِسَ الحَياةِ غَداً","يُفارِقُها وَليّنَها",17,"ن",3,0],["أرى شخصَها أُنساً لغيري فديتُها","وذكري لذاك الشخص في خلوتي أُنسي",18,"ي",1,0],["أرى شعره المنشور قدام خده","وبيته للثم تحت علامتي",19,"ي",1,0],["أَرى شَيبي مُعاراً فيهِ بَعضي","لِبَعضٍ إِنَّ ذاكَ لِنَشرِ سِرِّ",20,"ر",1,0],["أرى شعَراتٍ يَنْتَبِذْن كأنَّها","على الماءِ صَدْعٌ في الزُّجاجةِ بادي",21,"ي",1,1],["أرى شِبهَهُ الأيّامَ عادتْ بصيرةً","ومُذنِبَها قد جاءَ وهو مُنيبُها",22,"ب",3,0],["أرى شرف الأخلاق وهي عطية","بها الله يشقي من يشاء ويسعد",23,"د",1,0],["أَرى شَعراتٍ عَلى حاجِبَيَّ","بيضاً رقاقاً طِوالاً قِياما",24,"م",2,0],["أرى شعراء العصر بعدك كلهم","سواء ولست المستخار المحابيا",25,"ي",2,0],["أرى شيعاً فأخ شاردٌ","يسام الأذى من أخ طارد",26,"د",1,0],["أرى شَجَرَ الخوخِ استجدَّتْ ملابِسَا","تَوَقَّدن حتى خلتُهُنَّ مَقابسا",27,"س",2,1],["أرى شعري بمدحك قد تسامى","وعلَّق لي على صدري وِسامَا",28,"م",2,1],["ارى شفتيك من مسكٍ وخمرٍ","وطعمهما إذا ما ذيق مر",29,"ر",1,1],["أَرَى شَوقِي يُجاذِبُني لِمَغنىً","عَلَيهِ السَّعدُ مُمتَدُّ الظِّلالِ",30,"ل",1,0],["أريشة بيد العواد تخفق أم","ذي مهجة الصب ليت الصب قد شعرا",31,"ر",2,0],["أرى شعراء الوقت دونك قصرت","إلى عفوك الأدنى تخب وتعنق",32,"ق",1,0],["أَرى شَعراتٍ عَلى حاجِبَي","ي بيضاً رقاقاً طِوالاً قِياما",33,"م",2,0],["أَرى شَيبَ الرِجالِ مِنَ الغَواني","بِمَوقِعِ شَيبِهِنَّ مِنَ الرِجالِ",34,"ل",1,1],["أرى شهوة الإنسان ناراً بجوفه","ولكنها في نقطةٍ منه تنطفي",35,"ي",1,1],["أَريشُ وَأَبري لِلظَلومِ مَعابِلاً","إِذا خَرَجَت مِن بَدئِها لَم تُنَزَّعِ",36,"ع",1,1],["أرى شفقاً يلوح على سماءٍ","كما ذاب العقيق على الزجاج",37,"ج",1,0],["أريش بمهجةِ الأيامى سهمى","وأغمسُ في جوانِحها الحِرابا",38,"ب",2,0],["أَرى شِيَمَ الناسِ الأَذى وَأَشدُّهُم","أَذىً جاهِلٌ أَوليتَه مِنكَ إِحسانا",39,"ن",2,1],["أرى شعراء العصر ضلّوا طريقهم","فلا يلتقي ما عشت فكري بفكرهم",40,"م",1,1],["أرى شعراء يعشوق غوانياً","من الشعر يحكين العصور الخواليا",41,"ي",2,1],["أرى شعراء فارغين كشعرهم","يريدون إغداقاً لهم بثناء",42,"ا",2,1],["أرى شعر غيري شعر نفسي متى يرقْ","وأبرأ من شعري اذا لم يرق ليا",43,"ي",2,0],["أرى شجراً قد أورقَ الوعدُ عودَه","وأنتَ له إنْ سَلّمَ اللهُ مُثْمِرُ",44,"ر",1,0],["أرى شعراءَ الناسِ فيَّ ثلاثةً","حسوداً ومدّاحاً ونُكساً مُجَهَّلا",45,"ل",2,0],["أرى شُعَبَ الوادي تَسيلُ عليكُم","وأذرَعكم تَثنى متونَ الوسائدِ",46,"د",1,0],["أَريش سِهام القَول مني لِنَحر مَن","قَلاني وَأَرميه بِريش القَشاعم",47,"م",1,0],["أرى شبها ما بين دمعي وخدها","لأن كلا الاثنين ينمي إلى الورد",48,"د",1,0],["أَرى شَفَتَيها مِثلَ طَوقِ وَيُذيل","وَشِعراً كَليف النَخلِ دونَ المَناكِب",49,"ب",1,0],["أرى شبحاً يسير أمام عيني","لغايته فأحسبه ورائي",50,"ا",2,0],["أرى شعرات على حاجبيّ نبت","ن جميعا توآما توآما",51,"م",2,1],["أَرى شَعَراً بِخَدِّكَ غَيرَ حُلوٍ","شَبيهاً حينَ يُمشَطُ بِالخُيوطِ",52,"ط",1,0],["أرى شجر النارنج أبدى لنا جنى","كقطر دموع ضرجتها اللواعج",53,"ج",1,0],["أرى شكر أهل الفضل فرضاً موكدا","كجودت باشا ذي المحامد أحمدا",54,"د",2,1],["أرى شُعاعاً على لبنانَ منبسِطاً","زَعَمتُهُ وَضَحاً من شمسِ لبنان",55,"ن",1,1],["أرى شوقَها لاتصالٍ به","حديثُ المياه لرَوضٍ نَضِر",56,"ر",1,0],["أرى شهر شوال أبان لطيفاً","بها الكون يزهو بالنعيم المؤيد",57,"د",1,0],["أرى شزراً على عينيكَ يطغى","تشيح به وتملؤه انسجاما",58,"م",2,0],["أرى شارع الحيّ الذي تسكنينه","من الشوق يحدوه وقد صار مزهرا",59,"ر",2,0],["أرى شَعْبها صَرْعى كجُندٍ لدى الوغى","إذاهو مغلوبٌ بسيْفٍ وقاسرِ",60,"ر",1,0],["أرى شيئاً يطلُّ مِنَ المَرايا","يُراقبُ ما تبقى منْ بقايا",61,"ا",3,1],["أرى شبَح الآدابِ يمشي مغمّضاً","وأخشى عثاراً منه في هُوًّةِ الرًّمْسِ",62,"س",1,1]]}