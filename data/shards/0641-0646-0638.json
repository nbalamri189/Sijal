45770","الكامل"],[3638,"","https://poetry.dctabudhabi.ae/diwan/poem/203037","بسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66442","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92368","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66552","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44660","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44718","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44684","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90915","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45094","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83357","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83396","البسيط"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114605","الكامل"],[4755,"جَاءَتْ بِكَأسِ المَاءِ تَحسَبُ أَنَّني","https://www.poetsgate.com/ViewPoem.aspx?id=184576",""],[4578,"ماذا تقول بمدحك الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=49340",""],[4955,"لماذا نسيء الظن دون تحقق","https://www.poetsgate.com/ViewPoem.aspx?id=195098",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5092,"سيمفونية قصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=139889",""],[5183,"قابيلان","https://www.poetsgate.com/ViewPoem.aspx?id=180190",""],[5277,"التحديقُ في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=206971",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5324,"مرثيّة الغرم .","https://www.poetsgate.com/ViewPoem.aspx?id=207570",""],[5409,"حتام يحدو الليل في","https://www.poetsgate.com/ViewPoem.aspx?id=155294",""],[5638,"عيون.....","https://www.poetsgate.com/ViewPoem.aspx?id=198255",""],[5691,"ليلاي...!","https://www.poetsgate.com/ViewPoem.aspx?id=206654",""],[5906,"غبار أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=188911",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6213,"عهدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76274&r=&rc=31",""],[6333,"جرح وقصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7035&r=&rc=6",""]],"verses":[["فَنْظُرْ لِمَا هُوَ نَاجٍ","مِنْ حُسْنِهَا مُسْتَبِينَا",0,"ن",2,0],["فنظر في وجها بديع","الدني هي بلا ثمن",1,"ن",1,0],["فنظرتهنّ تحيّراً ونظرنني","حتى كلانا ناظر منظور",2,"ر",1,0],["فنظمتها زهراء والشهب روضة","على الأفق تجلى والمجرَّة جدول",3,"ل",1,0],["فنظمتها وأخاف قولك مازحاً","هذي القصيد لزوم ما لا يلزم",4,"م",1,0],["فَنَظَرنَ لا يَدرينَ أَذهَبُ يَسرَةً","فَيَحِدنَ عَنّي أَم أَميلُ يَمينا",5,"ن",2,0],["فَنَظَمتُ فيكَ بَديعَ شِعرٍ فاتَ أَن","تَرقى إِلى دَرَجاتِهِ الأَوهامُ",6,"م",1,0],["فنظمن من در المباسم جامدا","ونثرن من در المدامع ذائبا",7,"ب",2,0],["فنَظَمْنا منَ الثَّناءِ عُقوداً","يُخْجِلُ الدُّرَّ نَظمُها والعَقيقا",8,"ق",2,0],["فنظمْتَهم جمعاً وقد نَشَرَتْهُمُ","أيدي الزَّمانِ فَفُرِّقُوا أيدي سَبا",9,"ب",2,0],["فَنَظَمتَها فَوقَ الرِقابِ غَلاغِلاً","وَتَخالُها بَينَ الضُلوعِ غَليلا",10,"ل",2,0],["فَنَظْرَتُهُ وَحْيٌ وَسَاكِنُ صَدْرِهِ","فُؤَادُ خَبِيرٍ نَاطِقٍ بِالْعَظَائِمِ",11,"م",1,0],["فنِظَامُ أعْمَالِ التُّقَى آدَابُها","فاصْحَب بها أهْلَ التُّقَى والسُّؤْدَدِ",12,"د",1,0],["فَنَظْرَةٌ مِنْهُ لَوْ مَسَّتْ ظَلامَ دُجىً","ما زُمِّلَ اللَّيْلُ في أَثْوابِه السُّودِ",13,"د",1,0],["فنظرة منك في حالي يكون بها","فوزي بربي وانقاذي من الضرر",14,"ر",1,0],["فَکنْظُرِ اليَوْمَ بَعْضَ مَنْ كُنْتَ تَهْوَى","فَکنْجُ مِنْ شَأْنِهِ، وَدَعْني وَشاني",15,"ن",2,0],["فنظرتَّ فيهم ثم قلتَ لبعضهم","أَما أبوه فليس يرضى ما جنى",16,"ن",2,0],["فنظرت في عطفيك تيها عندها","نظر المدل وقلت لست بدون",17,"ن",1,0],["فنظرت عن عين البصي","رة والإصابة لا محاله",18,"ل",2,0],["فنظَمتُ من وحيِ الدموعِ قصيدةً","وعرائسُ الإلهامِ دمعُ الغيدِ",19,"د",1,0],["فنظمي علا كلَّ القريض لأنه","بعُلوة غَزْلي في قَوافٍ أقولُها",20,"ل",3,0],["فَنَظِيرُهُ الدُّنْيَا فَظَاهِرُهَا","حُلْوٌ وَبَاطِنُ حُلْوِهَا مُرُّ",21,"ر",1,0],["فنظرت معسول القنا فوق القنا","وَاللَيل تحت نقاب شمس الاسعد",22,"د",1,0],["فنظمتها عصماءَ مث","لَ الدرِّ ينظم في النحور",23,"ر",1,0],["فنظَنَّى الحِمامُ أنّك أزجي","تَ إليه كتيبةً شهباءَ",24,"ا",2,0],["فَنَظرت بَيتاً لا أَشكّ بِأَنَّهُ","بَيت الخَلاء لِمَن يُريد تَنفّسا",25,"س",2,0],["فَنَظرت ما بَين العذيب وَبارق","دَمعي وَصَبري منجداً وَمغورا",26,"ر",2,0],["فنظْمُهُ مُستَحسَنُ الإقواء","يَهتَزُّ مثْلَ الصَّعدةِ السّمراء",27,"ا",2,0],["فَنَظَرتُ مِن ذي في حَريرٍ ناعِمٍ","وَضَرَبتُ مِن ذا في حَديدٍ بارِدِ",28,"د",1,0],["فَنَظَمتُ مدحاً وَلا وَفاءَ بِمِثلِهِ","وَسَجدتُ شُكراً لا نهوضَ بحقِّهِ",29,"ق",2,0],["فنظرنا فيها وقلنا جميعاً","إن هذا خرق بها لا محاله",30,"ل",2,0],["فنظرت ما لم تنظري وسمعت ما","لم تسمعي وعرفت ما لم تعرفي",31,"ف",2,0],["فنظمكُمُ وحظكُمُ عقود","تزين بالمحاسن كلَّ طِرْس",32,"س",1,0],["فنظرةٌ منك تُحيِيهم وتجعلُهم","محمولَةً عنهمُ الأثقالُ والكُلَفُ",33,"ف",1,0],["فَنَظَّمْنَا المفاخِرَ كاللآلِي","وحَلَّيْنَا المعالِيَ كالنُّحورِ",34,"ر",1,0],["فنظنّ تذكر بالمدي","ح ومن ولائي فيك اذكر",35,"ر",1,0],["فَنَظَمْتُها فِي كُلِّ أُفْقٍ نازِحٍ","وبَعَثْتُها مَعَ كُلِّ نَجْمٍ ثاقِبِ",36,"ب",1,0],["فَنَظَمْتَ فِي صَدرِ الوزارة عِقْدَها","وَعَقَدْتَ فِي رأسِ الرِّيَاسَةِ تاجَهَا",37,"ج",3,0],["فنظم كسمط الدر زاه وناصع","ونثر كزهر الروض ذاك ورائع",38,"ع",1,0],["فنظَراً وإن نأت دارُكُمُ","وأرشِدوا لمن يقول نظَرا",39,"ر",2,0],["فنظَّم فيلا الودح اليواقيت والحلى","وألحف متن الأرض بسط الزبرجد",40,"د",1,0],["فنظْرَةٌ من رَمْشِ طَرفِ عينِهِ","لا شكَّ تَكْفيني لدى تَكْفِينِي",41,"ن",2,0],["فنظْرةُ طَرْفِكِ تفويقهُ","وكسرةُ جَفْنِكِ دفعُ الوَتَرْ",42,"ر",1,0],["فنظل في لهو إلى أن ينجلي","صبح على مهد الدجى مولود",43,"د",1,0],["فَنَظَرتُ مَن ذاكَ الهِلالِ لِنّيرِ","وَعَلِقتُ مِن ذاكَ الغَزالِ بِأَتلَعِ",44,"ع",1,0],["فَنَظرتها صفصفاً مجرَّده","عَن كُل مَشروبٍ وَكُل مائِدَه",45,"ه",1,0],["فَنظرته مِن خباها الناسُ","وَغَرَّها الهَيئة وَاللباس",46,"س",1,0],["فَنَظَرا لَها بِعَين القُرَّمِ","وَهَبَطا مثلَ القَضاء المُبرَمِ",47,"م",1,0],["فَنَظَرَ السَبع خيالَ جسمه","كَذا خَيال أَرنَبٍ بِجَنبه",48,"ه",1,0],["فَنَظَرت بابا بِغَير عتبه","وَأَدخَلت منقارَها وَالرَقَبه",49,"ه",1,0],["فنظرته حَتّى توهم مَسمَعي","خَفَقان قَلبي قارِعاً بالباب",50,"ب",1,0],["فنظمتُ فِيكَ بديعَ شِعْرٍ فَاتَ أنْ","تَرْقَى إلَى حُجُرَاتِهِ الشعرَاءُ",51,"ا",2,0],["فَنظمته شُكراً لأنعمك الَّتي","أَوليتنيها منعماً مُتَفَضِّلا",52,"ل",2,0],["فنظم اشعاره نظماً يقي ابداً","ونشد تاريخه نشداً يخرّينا",53,"ن",2,0],["فَنَظَرتُ في زادٍ لِدارِ إِقامَتي","وَسَأَلتُ رَبّي أَن يَحُلَّ عِقالي",54,"ل",2,0],["فنظمتُ من در القريض قلائداً","فصَّلتها بمكارمٍ وفضائلِ",55,"ل",1,0],["فنظمت من درَر المعاني حليةً","ونسَجتُ من حبر القوافي مُطْرَفا",56,"ف",2,0],["فنظمنا له وقد راقَ حسناً","عقد مدحٍ وكانَ للمدحِ أهلا",57,"ل",2,0],["فنظمتُ هذا الدرَّ تهنئةً","لمنِ النُّضارُ إليه ينتسبُ",58,"ب",1,0],["فنظمتهُ نظمَ الفرائد مثلما","نظمت اليكَ قلائد الاوفادِ",59,"د",1,0],["فنظرته والموت دون وصوله","نظر الحسين بياض ماء الشاطي",60,"ط",2,0],["فَنَظَرنَ مِن خَلَلِ الحِجالِ بِأَعيُنٍ","مَرضى مُخَالِطوها السَقامُ صِحاحِ",61,"ح",1,0],["فنظام الملك متسق","ومقام العز مزدان",62,"ن",1,0],["فنظرت من خلفي لانظر من هنا","فاذا الوشاة بجنبنا كالشاء",63,"ا",2,0],["فنظمتُه فيه مديحاً منزهاً","ونَثراً علا قدراً على كلِّ ناثر",64,"ر",1,0],["فَنظِيرُهَا المُبدِي لَنَا تَفسِيرَهَا","فِي ذِي المَعَارِجِ لَيس يَفتَرقَانِ",65,"ن",1,0],["فنظرتُ الهلالُ فوقَ قضيبٍ","ونظرتُ الظلامً فوقَ الشعَاعِ",66,"ع",1,0],["فنظمت فيك من المديح قلائداً","نظمت كما نظم الجمان منضدا",67,"د",2,0],["فنَظَمتُ الدرَّ منّى كلِما","في ثَنا عبد الغنى النابُلُسي",68,"ي",1,0],["فنظلّ نستبقُ الحديثَ عن الهوى","من غَيْرة وتغضُّب وعتاب",69,"ب",1,0],["فنظرت الربى بشوق ولهف","مستعيدا فيها عهود الشباب",70,"ب",1,0],["فنظمت أفكار الجنون فأصبحت","شعرا لديه العقل يسجد صاغرا",71,"ر",2,0],["فنظامي يرق فيه مديحاً","فهو نور أو نسمة سحريه",72,"ي",2,0],["فَنظمتها وَاللَيل يَحنق غيرة","عقداً عَلى جيد الزَمان معلقا",73,"ق",2,0],["فنظمت قلبى والوفاء قصيدة","تروى على الأحقاب والأجيال",74,"ل",1,0],["فنظمت تهنئة الوكيل ومعجز","نظمي لآلئ ما لهن ثقوب",75,"ب",1,0],["فنظرتُ في أمر البناء مُعجّلاً","وصنعتُ عُرساً يالهامِنْ صانعِ",76,"ع",1,0],["فنظرتُ نحو خليلتي متأملاً","فوجدتُها محجوبةً ببراقعِ",76,"ع",1,0],["فنظرتها تدعو زيارة مولدٍ","لوليِّ قطر الشرق عند تمام",77,"م",1,0],["فَنظمت مِن غرر البَديع قَلائِداً","وَهِيَ الثُرَيا نَظمَها لا يَنثر",78,"ر",1,0],["فنظرتِ الى ما قد كنت قارئاً","فوجدتك ثائرةً بتجهم",79,"م",1,0],["فنظمّت منه للنحور قلائداً","تملّ الغواني عندها صحبة العقد",80,"د",1,0],["فنظّمت بدموع العين ما نثرت","كأَنما العين بعد البين ما نَظَرَت",81,"ت",1,0],["فَنَظْمُ الكُلَى بِالطَّعْنِ يُرْوي لِرُمْحِهِ","وَنَثْرُ الطُّلَى بِالضَّرْبِ عَنْ مَشْرَفِيَّهِ",82,"ي",2,0],["فَنَظَرتُ في حُسنِ الرَجا وأَجِبَتُهُم","أَمطارُ عَفوِ اللَهِ قَد تُطفيها",83,"ي",3,0],["فَنَظمتُ الشعرَ تَقليداً وَهَل","تَظهَرُ الأَخزافُ في جَنب النُضارْ",84,"ر",1,0],["فَنَظَرتُ إِلى الرياضِ بِحُزنٍ","وَغَمامُ السَماءِ يَسقي الخُزامى",85,"م",2,0],["فنظام علم الطب أرخ زانه","تاليف داود الحكيم الثاني",86,"ن",2,0],["فَنَظَمتُ ما يَرجو المُحِبّ بِقَولِهِ","عَن كاسِدٍ لِلعَجزِ وَالتَقصيرِ",87,"ر",1,0],["فَنظرَة من رَسول اللَّهِ تُلحِقُني","بِالسابِقينَ وَأَن أَمشي عَلى مَهَلِ",88,"ل",1,0],["فَنَظرَةٌ من رَسول اللَهِ تُسعِدُني","دُنيا وَأخرى بِأَنواعِ السَعاداتِ",89,"ت",1,0],["فنظرت بالنور المبين الى مدى","ما ادركت اثراً له الزقاء",90,"ا",2,0],["فَنَظَرْتُهَا.. وشَرِبْتُ أَعْذَبَ بَسْمَةٍ","مِنها, فَمَاجَتْ دَاخِلِي شُطْآنُ",91,"ن",1,0],["فنظرت بالنور المبين إلى مدى","ما أدركت أثراً له الزرقاء",92,"ا",2,0],["فنظلمُ مَنْ كانوا لنا خيرَ إخوةٍ","ونخسرُهُم مِنْ دونِ أيِّ عتابِ",93,"ب",1,0],["فنظفر بالمرغوب في عز حاجة","ونَفتح نحو الشغل من جدنا دربا",94,"ب",2,0],["فنظمتُ شعري لحن أشواقي","عزفُ الهوى في الشعر أوهامي!",95,"م",2,0],["فنظرة الله في الدارين معتمدي","ونصرة الله للتوفيق عنوان",96,"ن",1,0],["فنظمأُ منْ حرِّ الهجيرِ بظلِّنا","وأشتيةُ الأرضِ الخرابِ لواهبُ",97,"ب",1,0],["فنظرت نظرة من أصيب ولم يفق","إلا ليجبر من سناك كسورا",98,"ر",2,0],["فَنَظْفَرُ مِنْ جَدِيدٍ بِالْمَزَايَا","وَنَكْسِبُ مِنْ عَظِيمِ الْخُلْدِ كَسْبَا",99,"ب",2,0],["فنظمت من ولهي إليكِ قصائداً","ماكنت أنظم مثلها لسواكِ",100,"ك",1,0],["فنظرته وكأنه","كف تلوح من مشوق",101,"ق",1,0],["فَنَظْرَتَهَا الأُولَى فُؤَادِيَ مَا دَرَى","أَضَاءَ ظَلامِي أَمْ نَهَارِيَ أَظْلَمَا؟!",102,"م",2,0],["فنظرْتُ في عيْنيْكِ أمْسحُ بالْبَنان ِالنَّرْجِسا","متأمِّلاً لُقْياهُما أبداً ولي أنْ تُحْرَسا",103,"س",2,0],["فَنِظامُ الغابِ يَغزوهُ خَرابٌ","وكِبارٌ في الوَرى عادوا صِغارا",104,"ر",2,0],["فنَظرَةٌ بالصَّمتِ وَاجِفَةٌ","وَلَحظَةُ الوَدَاعِ كَالوَهَمِ",105,"م",1,0],["فنظرتُ في عينيك أقرأ طالعي","وسرحتُ منهمكاً فماذا أصنع",106,"ع",1,0],["فنظمتُ من أمسي فواجع حاضري","ومن السحائب غيمة ترويني",107,"ن",2,0]]}