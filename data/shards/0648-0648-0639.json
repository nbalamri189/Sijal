ل"],[469,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[475,"زايلت ما صنعوا إليك برحلة","https://www.aldiwan.net/poem4781.html","الكامل"],[520,"حرام على قلبي يرى وهو ساكن","https://www.aldiwan.net/poem12286.html","الطويل"],[556,"لما طلعن علي في غسق","https://www.aldiwan.net/poem47773.html","أحذ الكامل"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[591,"بان الخيال وإن أبان نزيلا","https://www.aldiwan.net/poem17663.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34416","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54103","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67015","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64796","الوافر"],[1332,"","https://poetry.dctabudhabi.ae/diwan/poem/203109","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122045","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128713","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48953","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87836","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202555","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60924","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60821","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61014","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99093","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100255","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140300",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74044","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216470","الكامل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33131","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114308","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111451","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105570","الوافر"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35455","الرمل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77695","الكامل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72907","البسيط"],[4557,"","https://poetry.dctabudhabi.ae/diwan/poem/178160","المتقارب"],[4797,"العام اخذت البيرق","https://www.poetsgate.com/ViewPoem.aspx?id=78478",""],[4862,"سلام خاص لأحلى أصدقاء","https://www.poetsgate.com/ViewPoem.aspx?id=122611",""],[4978,"تمادى البغي واشتد الحصار","https://www.poetsgate.com/ViewPoem.aspx?id=181592",""],[5030,"بيوت الله","https://www.poetsgate.com/ViewPoem.aspx?id=215723",""],[4119,"منيتني بتعلة","https://www.poetsgate.com/ViewPoem.aspx?id=16104",""],[5219,"سهم اللحاظ","https://www.poetsgate.com/ViewPoem.aspx?id=197682",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[5736,"لعنة الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=208873",""],[5783,"غربة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34583",""],[5929,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=197059",""],[6225,"محِبٌّ . . وليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80919&r=&rc=188",""],[6233,"عيناكِ تعلنان هزيمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82633&r=&rc=32",""],[6233,"سيمر العاشق فانتظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78445&r=&rc=8",""]],"verses":[["وَوَعدٍ تُنَفِّرُهُ بِالعَطا","ءِ كَالعامِ أَزعَجَهُ القابِلُ",0,"ل",1,0],["وَوَعدُ ذي الشَيبَةِ بِال","وَصلِ غُرورٌ باطِلُ",1,"ل",1,0],["وَوَعَدتَهُ وَعداً تَعَلَّقَهُ","وَالوَعدُ مَلويٌّ بِهِ الأَمَلُ",2,"ل",1,0],["وَوَعدُكِ إِيّانا وَلَو قُلتِ عاجِلٌ","بَعيدٌ كَما قَد تَعلَمينَ سَحيقُ",3,"ق",1,0],["وَوَعَدْتَنِي وَتَكَرَّرَ الْوَعْدُ الَّذِي","أَبَتِ الْمَكَارِمُ أَنْ يَكُونَ أَفيكَا",4,"ك",2,0],["وَوُعُودُهَا مِنْ بَعْدِ ذَا مُسْتَمْنَحٌ","إِنْجَازُهَا مِنْ مُنْعِمٍ وَهَّابِ",5,"ب",1,0],["وَوَعَدْتَ بِالْعُذْرِ الْجَمِيلِ وَإِنَّنِي","لأَخَافُ مَنْ يَبْغِي وَلاَ مَنْ يُعْتِبُ",6,"ب",1,0],["وَوَعدٍ يُعَذِّبُ فيهِ الكَريمُ","إِمّا بِخُلفٍ وَإِمّا مِطالِ",7,"ل",1,0],["ووعدت بالسلوان واش عابكم","فكأننا في كذبنا نتخاير",8,"ر",1,0],["ووعد بعض الناس وعد كما","يقال لا حسِّي ولا مِسِّي",9,"س",2,1],["ووعدته وعداً ستملكه بهِ","وتكون في الحالين مالك رقَّه",10,"ه",1,0],["وَوَعيدٍ لهم تَكَشَّفَ عن بطْ","شٍ أبى حَدُّهُ اعتداءَ الحُدُودِ",11,"د",1,0],["ووعدتَ التي وعدت من البرْ","ر وعندي بالخلف منك رُهون",12,"ن",1,0],["وَوَعَدتَني يَومَ الخَمي","سِ فَلا الخَميسُ وَلا الأَحَد",13,"د",1,0],["وَوَعدُكَ فِعلٌ قَبلَ وَعدٍ لِأَنَّهُ","نَظيرُ فَعالِ الصادِقِ القَولِ وَعدُهُ",14,"د",2,0],["وَوَعَدتُهُ أَنّي أَقومُ بِشُكرِها","فَحَمَلتُ مِنهُ نَقاً فَلَم أَنهَض بِهِ",15,"ب",2,0],["وَوَعدٌ لَيسَ يُعرَفُ مِن عُبوسِ اِن","قِباضِهِمِ أَوَعدٌ أَم وَعيدُ",16,"د",1,0],["وَوَعدُكَ مُحتَاجٌ إِلى فَسحِ مُدَّتي","وَرَبُّكَ أَدرى ما تَخَلَّفَ مِن عُمري",17,"ر",2,0],["ووعدتَ أمسِ بأنْ تزورَ فلم تزر","فغدوتُ مشغولَ الفؤادِ مشتتا",18,"ت",2,1],["ووَعَدْتَ أمسِ بأنْ تزورَ فلمْ تزرْ","فقعدتُ مسلوب الفؤادِ مشتتا",19,"ت",2,1],["وَوَعدٌ وَخُلفٌ بَعدَهُ وَتَمَنُّعٌ","وَسُرعَةُ هُجرانٍ وَوَصلٌ مُوَصَّلُ",20,"ل",1,0],["وَوَعوا شُكري إِلَيهِ وَكانوا","مَلَأوا دورَ المُلوكِ نِباحا",21,"ح",2,0],["وَوَعدٌ كَجَنى النَحلِ","وَلَكِن ذاكَ مَثلوبُ",22,"ب",1,0],["ووَعادِيَةٍ سَومِ الجَرادِ شَهِدتُها","لَها قَيرَوانٌ خَلفَها مُتَنَكِّبُ",23,"ب",1,1],["ووعودُ الغرامِ ماذا عراها","أغدتْ في الثَرَى الْخضيبِ وعيدا",24,"د",2,0],["ووعاه رهطُ ابن مريمَ إنجي","لاً ورهطُ ابنِ هاشمٍ قرآنا",25,"ن",2,0],["ووعَدَت بالعذْرِ الجميلِ وإنني","لأخافُ من يَبْغي عليَّ ويَعْتِبُ",26,"ب",1,0],["ووعودَ من يتحضّنون شؤوننا","ملأى من التخدير والتنويم",27,"م",1,0],["وَوَعَدْتُهُ أنّي أقُومُ بِشُكْرِها،","فحَمَلْتُ منهُ نقى فلَم أنهَضْ بهِ",28,"ب",2,0],["ووعيد أضنى جلادة عزمي","وغدا منه هيكلي كالخيال",29,"ل",1,0],["ووعود طالت وطال مداها","وتمادت وأشغلت لي بالي",29,"ل",2,0],["ووعد ربك في تطهير عترته","بحكم الذكر لا يخفى على أحد",30,"د",1,0],["ووعد الفائز في المضمارِ","بعشرةٍ تسطع كالدراري",31,"ي",1,0],["ووعد إذا ما لحن وهنا بروقة","أتاك مع الاصباح سحبا هوامعا",32,"ع",2,0],["ووعيد وموعد","ونكير ومنكر",33,"ر",1,0],["ووعاها الدهر في آثاره","جذوة حمراء في رأس الحقب",34,"ب",1,0],["ووعدتني قبل الصباح بزورةٍ","والليل يسبل للوصال ستائري",35,"ر",2,0],["ووعدتَ ووعدُك يا مولا","ي الحقّ لداعٍ منتهج",36,"ج",1,0],["وَوَعدُكَ رَبّي في اِذكُروني مُحَقَّقٌ","بِقَولِكَ أَذكُركُم كِتاباً مُنَزَّلا",37,"ل",2,0],["وَوَعدُكَ صِدقٌ مُنجَزٌ غَيرَ مُخلَفٍ","لِذاكِرِكَ المَذكورِ عِندَكَ في المَلا",37,"ل",2,0],["ووعلمت أن الدهر","ساعات وأوقات يسيره",38,"ر",2,0],["ووعدُهُ بِسُرعَةِ ال","إِنجازِ يَأتي مُثمِرا",39,"ر",2,0],["وَوَعدُكَ لي تَمَكَّنَ مِنهُ مطلٌ","فَفي تَقويمِهِ أَبدى اِعوِجاجا",40,"ج",2,0],["ووعدتني وصلا وقد أخلفتني","إن الكريم لوعده لني خلفا",41,"ف",2,0],["ووَعْدُكَ أَلزَمَنِي من ذَرَاكَ","وِصالَ المُحِبِّ ورَعْيَ الرَّقِيبِ",42,"ب",1,0],["ووعدُكَ بالفضلِ أَنساهُمُ","وَعيدَ الرَّدى حَيْثُ حلُّوا خِيامَهْ",43,"م",2,0],["ووعدٍ ولم يُنجزه أمسِ لعلّه","من اليوم أن يلقى النجاح قمينُ",44,"ن",1,0],["ووعدُ الدهر عندي في","علاكم قَلَّما انجذما",45,"م",2,0],["ووعوداً يكنّ عند الكريم ال","عهدِ حتى يفي بهنّ نذورا",46,"ر",2,0],["ووعودٌ يجمحُ المطلُ بها","أن يرَى ميقاتُها عندك حدَّا",47,"د",2,0],["ووعورُ جرْولةٍ إذا أحْفَظْتَهُ","ومع الرِّضا فهو البِراثُ المَهْيَعُ",48,"ع",1,0],["ووعدتهُ سقيا الغمام فلا رأت","وجهاً إلى إخلافه أخلافه",49,"ف",2,0],["وَوَعدتَني في حاجَتي فَصَدَقتَني","وَوَفَيتَ إِذ كَذَبوا الحَديثَ وَبَدَّلوا",50,"ل",3,0],["ووعدك رهن فالتفت نحو فكه","فإن مواعيد الكرام رهائن",51,"ن",1,0],["وَوَعدننِي ما لا يَفِينَ بهِ","من غير معذِرَةٍ لمعتَذِرِ",52,"ر",1,0],["وَوَعَدتَني وَعداً فَقَد أَنجَزتَهُ","وَفَتَحتَ عَن أَبوابِكَ الأَقفالا",53,"ل",2,0],["وَوَعَدتَني فَقَفَرتَ وَعدَكَ بِالَّتي","لَم يَقفُها مَنٌّ وَلا تَثريبُ",54,"ب",1,0],["وَوَعدْتَنِي بِاللَّحْظِ مِنْكَ زِيادةً","فَوَجدْتُ مِيعادَ العَلِيلِ عَلِيلا",55,"ل",2,0],["وَوعدُ وَصلِكَ دينٌ لا وَفاءَ لَهُ","فَلَيتَهُ كانَ بِالهُجرانِ يا قاسي",56,"س",2,0],["ووعظٍ وتذكيرٍ إذا ما جلاهما","فليس سوى هامٍ من الدمع هامر",57,"ر",1,0],["وَوَعِيْدُ أَقْوَامٍ صَمَمْتُ لِسَمْعِهِ","سَمْعُ الأَذَى من آفَةِ الآذانِ",58,"ن",1,0],["ووَعْدُكَ بالمَطالِ يَفُتُّ قَلْبي","وليسَ يَفُتُّ في كَفِّي بِعُرَّهْ",59,"ر",2,0],["ووَعَدْتِ من طيف الخيال بزَورَةٍ","أنّى، ودونَ الطَّيف طَرفٌ ساهرُ",60,"ر",1,0],["وَوَعَدْتَنِي وَعْداً فَمِثْلِي يَرْتَجِي","إِنْجَازَهُ كَرَماً وَمِثْلُكَ يُنْجِزُ",61,"ز",1,0],["ووعدت صبك بالأبيرق شربة","لعسى تبرد لوعة المحزون",62,"ن",1,0],["ووعيتَ توقيعَ الإخاء مُرجِّعاً","لحنَ التحالف والرقيِّ مُرنِّما",63,"م",2,0],["وَوَعَدتِهِ ما تَعلَمي","نَ فَهَل نَسيتِ قَديمَ وَعدِك",64,"ك",1,0],["وَوَعيدٍ مُصَوِّرٍ لعذابٍ","يُفقِدُ الرُّشدَ في لَظَى النِّيرانِ",65,"ن",1,0],["ووعدت نفسي عند رؤية ياسر","أن سوف تظفر من يداه بسرها",66,"ر",3,0],["ووعدَتني بالخير شهراً كاملاً","وقطعتَ بعد الشهر حبلَ رجائي",67,"ا",3,0],["ووعيتَ القول وهو في","علمِه الكوني كالبحرِ طَمَا",68,"م",2,0],["ووعدتني إن لا تخوني موثقي","أفلا وفيتِ ببعض ذاك الموعد",69,"د",1,0],["ووعدك في الحياة له مرادي","ولست أريده يوم التناد",70,"د",1,0],["ووعدتني فمطلتني","يا ماطلي بخلوفِ وعدِك",71,"ك",1,0],["ووعدتم فتبدلت أوعادكم","عمداً وقام مقامها الإيعاد",72,"د",1,0],["وَوعود اللئام كالماءِ تصلي","هِ شواظاً فَيَستَحيل بخارا",73,"ر",2,0],["وَوَعدكم بِالتَلاقي غَير شامِلنا","من يَوم ما قَد نَأَيتُم عَن مَنازِلنا",74,"ن",2,0],["ووعظاً نَهِيٌّ الأمرِ والنَهيِ في النُهَى","تَناهت بهِ فالجهلُ عنهنَّ زائِحُ",75,"ح",1,0],["ووعى عواقبها فلم يَعِ صدره","بغضًا لمعتقد ولا لمكابر",76,"ر",1,0],["وَوَعدٍ يُضيءُ الداجِياتِ تَكاءَت","مِطالاً فَوافى عافِياً مُستَهامُهُ",77,"م",2,0],["وَوَعْدُهُ مُنْجَزٌ وَلَيْسَ مُعَلَّقاً","مَزِيدُ مَآثِرٍ بِهَا اللُّبُّ يَذْهَلُ",78,"ل",1,0],["وَوَعى ابنُ قافانِيسَ أمر ذِيُومِذٍ","فاستَوقَفَ الأَفرِاسَ ثُمَّ تَرَجَّلا",79,"ل",2,0],["ووَعرِفِيثُسٍ ومن فانُوفَةِ","وَقُدسِ إِكرِيسا وقِيبارِيسَةِ",80,"ه",1,0],["وَوَعرِ لَقدَمُونِيا العَمِيقَه","كذا سُرى إِسبَرطَةَ الأَنيقَه",80,"ه",1,0],["ووعد الحر دين مستحقٌ","قبيح أن يعلل بالمطال",81,"ل",1,0],["وَوَعظٌ وتذكيرٌ إِلى اللَهِ مُنهِضٌ","وزجرٌ يَلينُ الصَخرُ مِنهُ ويَخشَعُ",82,"ع",1,0],["ووعد القصاد نحو بابه","برّاً يحار الفكر في حسابه",83,"ه",1,0],["وَوَعى عَنِ الإِلهِ كُلّ ما","بَثَّهُ في سِرِّهِ وَما نَسي",84,"ي",1,0],["وَوَعاه عَنهُ مُصطَفى مُتَخيّر","صحّت رِسالته وَصُدّق قِيلُهُ",85,"ل",2,0],["وَوَعَدتُ بِالعَملِ الَّذي نَفسي بِهِ","تَصبو وَتَنمي نَحوَهُ أَوصابُها",86,"ب",3,0],["ووعت رسائلَ جمة منشورها","في حسنهِ يزري بكل فريدةِ",87,"ه",1,0],["ووعد الإله وقول النبي","إذا ما الهموم توالت تولت",88,"ت",1,0],["ووعدت داري بالفخر قبل الكتاب","ووفيت بأمر الله بالعهد الوثيق",89,"ق",1,0],["ووعد الجميلة مني لها","سلامٌ على شفتيها العسل",90,"ل",1,0],["ووعد الله في الإسراء حقٌّ","وما يحميكم منه الجدار",91,"ر",1,0],["ووعدا بيوتَ الله بالذكر والتقى","وإنْ حان وقتٌ للصلاةِ نثابرُ",92,"ر",1,0],["ووعدتني بطويلة","تأتي فكانت ليلتي",93,"ي",1,0],["ووعد قطعنا والنجوم شواهد","فواحر قلبي إذ يسير لحتفه",94,"ف",2,0],["ووعظا بأهوال المعاد مخوفا","وعلما بأنباء القرون الأوائل",95,"ل",1,0],["ووعى أنه رثاء ومدح","وسيوف بين الأكف بواتر",96,"ر",1,0],["ووعودٌ منها سحائبُ صيفٍ","ووعودٌ منها السَّحابُ الثِّقالُ",97,"ل",1,0],["ووعدك لو انه بليل نصيته","نورك بحندس مظلم الليل قمراي",98,"ا",2,0],["ووُعِدتُ بالتّاريخ يذكرُ حبَّنا","بحروفِ شعرٍ خطّها لخلودي",99,"د",2,0],["ووعود الهوى سحابة صيف","والليالي فيهن ..أسهر مضنى",100,"ن",2,0],["وَوُعُودُ خَارِطَةِ الطَّرِيقِ بَوَارُ","كَاسَ الخُنُوعِ تَجَرَّعَتْهَا نِزَارُ",101,"ر",1,0],["ووعودُ الأمس تسقي الغدَ .. حتى","يرتدي الوردَ على النبع الغرامُ",102,"م",1,0],["ووعدتُ مملكتي إذا أتممتُها","بالشعر .. لا باللؤلؤ المكنونِ",103,"ن",1,0],["ووعود الأمس مضيَّعةٌ","ماللإغواءة من أثر",104,"ر",1,0]]}