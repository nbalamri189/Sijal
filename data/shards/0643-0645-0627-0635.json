{"poems":[[55,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[74,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[91,"الزهر أكبر مصرع الصداح","https://www.aldiwan.net/poem44607.html","الكامل"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54758","الخفيف"],[108,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[133,"يا صاحبي لقد غفا","https://www.aldiwan.net/poem67428.html","مجزوء الكامل"],[266,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[422,"أيها السيد صبرا","https://www.aldiwan.net/poem53985.html","مجزوء الرمل"],[435,"هناء مديدا بدره يتوقد","https://www.aldiwan.net/poem40083.html","الطويل"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[505,"من زار منقطع العلائق حيشا","https://www.aldiwan.net/poem37990.html","الكامل"],[545,"وصاحت مسامير الرحال وكلفت","https://www.aldiwan.net/poem56875.html","الطويل"],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122559","الخفيف"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137672",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105464","البسيط"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96554","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98106","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53183","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27943","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67871","الهزج"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142148","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104674","الوافر"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147327","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79725","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62942","المتقارب"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103818","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103884","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66576","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136921",""],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105122","الكامل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138828",""],[4755,"بين الخوف والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=183541",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""]],"verses":[["كَما صَمَّ عالي ذِكرِكَ الخَلقَ كُلَّهُ","كَذاكَ أَقَمتَ العالَمينَ نَواعِيا",0,"ي",2,0],["كَم اِصطِبارٌ عَلى ضَيمٍ وَمَنقَصَةٍ","وَكَم عَلى الذُلُّ إِقرارٌ وَإِذعانُ",1,"ن",1,0],["كَمَا صَفَّقَتْ رِيحُ الشَّمَالِ شَمُولَهَا","فَبَانَ ارْتِيَاحُ السكْرِ فِي غُصُنِ الْبَانِ",2,"ن",1,0],["كَما صَعصَعَ البازي القَطا وَتَكَشَّفَت","عَن المُقرَمِ الغَيرانِ عيطٌ لَواقِحُ",3,"ح",1,0],["كم أصفهانيّ غدا بك أغيراً","في الترب لم يفتح عيون منوّه",4,"ه",1,0],["كم أصغت الأزهار فيه للحنه","في ليلة بيضاء ذات وشاح",5,"ح",1,0],["كما صار آمالي غُروراً وخدمتي","هباءً وسعيي خيبةً وتَبابَا",6,"ب",2,0],["كَمْ أَصُوغُ الْوَدَاعَ إِثْرَ وَدَاعٍ","فِي بِعَادٍ يَجِيءُ تِلْوَ بِعَادِ",7,"د",1,0],["كم أصبح الفحْم -وهُو فحم-","كالزاد لم تَخل منه دار",8,"ر",1,0],["كم أصبحت عند الرَرى","بدءَ الحديثِ وفصلَهُ",9,"ه",1,0],["كما صقلت مر الصبا متن ديمة","فجعدها حسناً هبوب الجنايب",10,"ب",1,0],["كم أصابَ الحتفُ منَّا","كلَّما سدُّدَ سهمه",11,"م",2,0],["كما صدت الأيام عني وأعرضت","وانكرني منها وفاءٌ وموعدُ",12,"د",1,0],["كم أصلحوا الفاسدَ من دهرهم","وقوَّموا المائدَ بالعادلِ",13,"ل",1,0],["كم أصْلَحَتْ بالله نَفْحَةُ قَلْبِهِ","قَلْباً بِسوءِ ضَميرِه مَغْشوشا",14,"ش",2,0],["كَما صاحَ سِربٌ مِن عَصافيرِ صَيفَةٍ","تَواعَدنَ كَرماً بالسَراةِ مُمَزَّحا",15,"ح",2,0],["كم أصاخوا إليك والرأيُ شورى","وأجابوا نداءَك المسموعا",16,"ع",2,0],["كم أُصادي وكم أُداجي فما حا","لُ مصادٍ في نفسه ومداج",17,"ج",1,0],["كما صحبوا ورقا أخضرا","يفوق على التبر شانا أهم",18,"ا",3,0],["كَم أَصابَت وَأَبادَت مُغرَما","مِثلُهُ الآسادُ لَم تَفتَرِسِ",19,"س",1,0],["كما صار فوق الخيل في حومة الوغى","إذا دارت الهيجاء قطب رحاها",20,"ا",3,0],["كم أصدرت وارداً عنها وكم جعلت","لآل جعفر فيه الورد والصدرا",21,"ر",2,0],["كما صاح في أَفنان ضالٍ عشيةً","بأسفل ذى بِيضان جونُ الأَخاطبِ",22,"ب",1,0],["كما صاح جَونا ضالتَينِ تلاقيا","كحيلانِ فى أَعلى ذرًى لم تُخَصَّل",23,"ل",1,0],["كم أصدقوا بحياتي","أجازَ حُكميَ أم لا",24,"ل",2,0],["كما صدقت في الصاحب بن محمد","ظنون وفازت للموالين آمال",25,"ل",1,0],["كما صنع الرامي الذي جاز سهمه","فريسته فاستلزم القلبَ حزنه",26,"ن",2,0],["كما صدَّت عن الشمسِ","سِراعاً أعيُنُ الرُّمدِ",27,"د",1,0],["كم أصبحت هدفاً لصولة","غاصب ومباءة لمذلة وضياعِ",28,"ع",1,0],["كما صَبَرَ الأُلى مِن قَبلُ كانوا","فإِنَّ الصَبرَ ظُلمَتُهُ ضِياءُ",29,"ا",2,0],["كَما صَكتِ الأقدَار فيَّ حروفها","يتيهُ بوحيِ العَاديَات سُبَاتِي",30,"ت",2,0],["كم أصاب البؤس نفساً حرة","واستباح العرض منها والشيم",31,"م",1,0],["كما صوبت أعصبٌ أبصرت","بضاح من الأرض سرب الحجل",32,"ل",1,0],["كم أصبحت دمنٌ وهي الديار به","فالآن انظر عمران الدنيا دِمَن",33,"ن",1,0],["كما صَمَّ ثلته بالبراحِ","الى حرزها الرابحُ المُعْرِبُ",34,"ب",1,0],["كما صار لون الماء لون إنائه","وفي الأصل لون الماء أبيض مفجب",35,"ب",1,0],["كما صرف الرحمن ملك أميةٍ","إليه ولوذي بالتجمل والصبر",36,"ر",1,0],["كمْ أُصْدِرَتْ عَنها نواهِلَ بعْدَما","قدْ أُورِدَتْ وهِيَ الظّماءُ زُلالَها",37,"ل",3,0],["كَمِ اصْطَنَعْتَ وَكَمْ أَوْلَيْتَنِيَ حَسَناً","فَلَيْسَ يَبْلُغُ أَقْصَى الشُّكْرِ أَدْناهُ",38,"ا",2,0],["كم أصاب الصغار كعكاً وحلوى","وأصاب العراء والزمهريرا",39,"ر",2,0],["كم أصدروا عنها الردى بوروده","فاستعذبوا الإيراد بالإصدار",40,"ر",1,0],["كما صنعت أهلُ الوفاءِ بكربلا","وخيلُ الرّدى فيها تخوض وتعتق",41,"ق",1,0],["كَم أَصبَحَ الآنَ عُمرِي؟! لَو سَأَلتُ غَدِي","لَقَالَ لِي: صارَ عُمرًا بَعدُ لَم يَحِنِ",42,"ن",1,0],["كمْ أصابَ القلبَ بعدَ الفقدِ منْ","قاصماتِ الظهرِ من تعبٍ وعَيْ",43,"ي",1,0]]}