ائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5183,"الموقف الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=180261",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5324,"عراق ليس في الدنيا سواهُ .","https://www.poetsgate.com/ViewPoem.aspx?id=207660",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5376,"لنا في الخنا طَرْفٌ من الذلِّ مرتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199640",""],[5433,"ليل الهجاد","https://www.poetsgate.com/ViewPoem.aspx?id=36841",""],[5526,"انكسار الشم انوف","https://www.poetsgate.com/ViewPoem.aspx?id=192756",""],[5561,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=192900",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5596,"الى الشيخ الصوّافي","https://www.poetsgate.com/ViewPoem.aspx?id=206689",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5749,"الفكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=132697",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[402,"فخار للكنانة أن تكوني","https://www.poetsgate.com/ViewPoem.aspx?id=36820",""],[5883,"ثلة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=22793",""],[5897,"عروس الحسن ..غادة","https://www.poetsgate.com/ViewPoem.aspx?id=156854",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[5943,"بإيمانٍ فلاحُ المسلمينا","https://www.poetsgate.com/ViewPoem.aspx?id=37270",""],[5956,"تعبتُ من ابتسامي","https://www.poetsgate.com/ViewPoem.aspx?id=183898",""],[6084,"خطب ألم بركن الدين فانهدما","https://www.poetsgate.com/ViewPoem.aspx?id=170875",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""],[6142,"خلق الوصي طلاع الكون ترتع في","https://www.poetsgate.com/ViewPoem.aspx?id=155726",""],[6225,"شكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80956&r=&rc=225",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""],[6225,"المرأة المؤمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80908&r=&rc=177",""],[6285,"أحبك يا تبوك ولا أبالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86822&r=&rc=15",""]],"verses":[["وَلِلإِنسانِ مِن هَذي اللَيالي","وَهوبٌ لا يَدومُ وَمُستَرِدُّ",0,"د",1,0],["وَلِلأَرماحِ بِالقَومِ","حِكاكُ الإِبِلِ الجُربِ",1,"ب",1,0],["وللآمِلِ الصّادي متَى يَبْدُ مَنْهَلٌ","ولمْ يَكُ منْ أحْواضِهِ يتنكَّبُ",2,"ب",1,0],["وَلْلإِنْصَافِ قُسْطَاسٌ قَوِيمٌ","يَبِينُ بِهِ مِنَ الْخَطَأَ الصَّوَابُ",3,"ب",1,0],["وَلِلأَرضِ أَمّا سُودُها فَتَجَلَّلَت","بَياضًا وَأَمّا بِيضُها فاِدهَأَمَّتِ",4,"ت",1,0],["وَلِلأَضيافِ إِذ طَرَقوا هُدوءً","وَلِلمَكَلِ المُكِلِّ وَكُلِّ سَفرِ",5,"ر",1,0],["ولِلأُمَمِ المُباحَةِ كُنْتِ أَقْوَى","مُؤَازَرَةٍ عَلَى الدَّهْرِ العَتِيِّ",6,"ي",1,0],["وَلِلآدَابِ أَحْسَابٌ غَوَالٍ","إذَا اتَّصَلَتْ بِأَنْسَابِ غَريقَهْ",7,"ق",2,0],["وللأَحيَاءِ أَيّامٌ تَقضَّى","يَلُفُّ خِتَامُها سُوقاً بسُوقِ",8,"ق",1,0],["وللأسنة شهب كلما غربت","في الدار عين تجلَّت من عواليها",9,"ي",3,0],["وللأرواح كالأجساد زادٌ","به تنمو المشاعر والحُلوم",10,"م",1,0],["وللأبعد الأقصى تلاع مريعة","أقام بها مثل السنام عسيبها",11,"ب",3,0],["وللأوغادِ أموالٌ تراها","مصوناتٍ بأعراضٍ مُذالَهْ",12,"ل",2,0],["وللإله سجالٌ مِنْ فواضلِه","كلُّ امرئٍ ناهلٌ منها وعَلّان",13,"ن",1,0],["وللأميرِ بقاءٌ لا انقطاعَ له","أخرى الليالي وأجْرٌ غير ممنون",14,"ن",1,0],["وَلِلأَطيارِ أَن تَشتاقَ أَيّاراً وَأَلوانَه","وَما لِلقَلبِ وَهوَ القَلبُ أَن يَهوى وَأَن يَعشَق",15,"ق",1,0],["وللارض ارواح وشمس مضيئةض","فيا شمسها ذرى ويا ريحها هبى",16,"ب",2,0],["وللاشياء أضداد إليها","تصير إذا صبرت لها مليا",17,"ي",2,0],["وَلِلأَوطانِ في دَمِ كُلِّ حُرٍّ","يَدٌ سَلَفَت وَدَينٌ مُستَحِقُّ",18,"ق",1,0],["وَلِلأُمورِ ظُهورٌ","تَبدو لَنا وَظُنونُ",19,"ن",1,0],["وَلِلأَبارِيقِ عِندَ المَزجِ لَجلَجَةٌ","كَنُطقِ مُرتَبِكِ الأَلفاظِ مَذعورِ",20,"ر",1,0],["وَلِلأُمورِ إِذا الآراءُ ضِقنَ بِها","يَومَ التَجادُلِ مِن آرائِهِ فيحُ",21,"ح",1,0],["وللأحزابِ وِجْهتُها فدعها","إلى أن يقشعَ النُّورُ الضَّبابا",22,"ب",2,0],["وَلِلأَخلاقِ بِالأُمَمِ اِنتِقالٌ","تَدانى الحينُ مِنها أَم تَمادى",23,"د",2,0],["وَلِلإِنسانِ ظاهِرُ ما يَراهُ","وَلَيسَ عَلَيهِ ما تُخفي الغُيوبُ",24,"ب",1,0],["وَلِلأَشياءِ عِلّاتٌ وَلَولا","خُطوبٌ لِلجُسومِ لَما رُفِضنَه",25,"ن",2,0],["وَلِلأَرمَينِ خَطبٌ مُستَفيضٌ","يَعومُ بِلُجِّهِ مُتَعجِّبوهُ",26,"ب",3,0],["وللأدب الريان فيها محافلاً","وَللعلم فيها معهداً ثم معهدا",27,"د",2,0],["وَللأرض من بعد الخَراب عمارة","وَللراحلين المبعدين رجوع",28,"ع",1,0],["وللأثير يد في الكون قاهرة","تَدَحرَجَت بِعصاها هذِه الأكر",29,"ر",1,0],["وَللأَمرُ ذو الَميسُورِ خَيرٌ مَغَبَّةً","مِنَ الأَمرِ ذي الَمعسُورَةِ الُمَتَردِّدِ",30,"د",1,0],["وَلِلأَزاهِرِ فِكْرٌ","يَرْوِيهِ عَنْهَا العَبِيرُ",31,"ر",1,0],["وللأصائل والأسحار أثخنتها","عات من الريح إرهاقاً بحافره",32,"ر",2,0],["وللأماني أوقات اذا قدرت","وللأماني آيات وايذان",33,"ن",1,0],["وللأمواج من حَنَقٍ نَشيشٌ","كما يَغلي على النيرانِ قِدر",34,"ر",1,0],["وللأهل أبصار روان تعلّقت","بعينيه إيجاب هنالك أم سلب",35,"ب",1,0],["وللإله سجالٌ مِنْ فواضلهِ","كلُّ امرىء ناهلٌ منها وعَلاَّن",36,"ن",1,0],["وللأحزاب وجهتها فدعها","إلى أن يقشع النور الضبا",37,"ب",2,0],["وللاملاك والاملاك كم قد","يحط ببابه تاج وهام",38,"م",1,0],["وللاماجد رغم الفاجرين على","صحائف المجد اخبار صحيحات",39,"ت",1,0],["وللآل الكرام ذوي المعالي","وأقطاب محبتهم نصيبي",40,"ب",2,0],["وللأب في الابن النجيبِ فراسةٌ","تربَّعَ يقيناً كلّما خالَه ظنَّا",41,"ن",2,0],["وللاماني احاديث وأعذبها","ما كان اسناده أدنى إلى الكذب",42,"ب",1,0],["وللاشيآء أوقات فمن لم","يوافقها تعرض للملام",43,"م",1,0],["وللأمور وللأعمال عاقبة","فأخشَ الجزا بغتة واحذره عن مهل",44,"ل",1,0],["وللأيّام مختلف وصرف","يفيدك صرفها خفض ورفع",45,"ع",1,0],["وللأمور تسابيب وإن كثرت","معلق سبب منها إلى سبب",46,"ب",1,1],["وَللأَحزانِ في صَدري اِعتِلاجٌ","وَلِلأَفكارِ في قَلبي اِطِّرادُ",47,"د",1,0],["وللألحانِ ترجيعٌ لطيفٌ","لهُ ذابت سويداءُ الجنان",48,"ن",1,0],["وللأمواجِ حَولينا هديرٌ","يُعيدُ لنا وِداع الراحلينا",49,"ن",2,0],["وللأوتارِ ترنيمٌ شجيٌّ","كترجيعِ النواحِ على اللحود",50,"د",1,0],["وَلِلأَحْبَارِ عَنهُ إِذا دَعاهُم","لِيبلُوَ صِدْقَ دَعْواهُم نَكولُ",51,"ل",1,0],["وَللأَقْوالِ إِنْ سُمِعَتْ سِهامٌ","تُقَصِّرُ عَنْ مَواقِعِها السِّهامُ",52,"م",1,0],["وَلِلأَقاحي ثُغورُ الغِيدِ باسِمَةٌ","سيكَت بِأَسحِلَةٍ أَنيابُها الأُشُرُ",53,"ر",1,0],["وَلِلأَقاحِ وَلِلتُفّاحِ مَبسَمُهُ","وَخَدُّهُ وَاِمتِياحي الراحَ من فيهِ",54,"ي",2,0],["وَلِلأَغالِقِ حُكمٌ في التَغَلغُلِ لا","يَنالُهُ ناسِجٌ بِالعَرضِ وَالعِظَمِ",55,"م",1,0],["وَلِلأَقاحي ثُغورُ الغيدِ باسِمَةٌ","شيكَت بِإِسحِلَةٍ أَنيابُها الأُشُرُ",56,"ر",1,0],["وللأسد الاسلامي الحظان أن على","صحائفه قوى بمدحك برهاني",57,"ن",2,0],["وَللأسى في الحشا نارٌ إذا اتقدتْ","سمعت منها أَزيزاً دونه الجرس",58,"س",1,0],["وللأمومةِ برّاً ليتهم كتبوا","وكيف يُحيي عطاها الحبُ والألمُ",59,"م",1,0],["وَلِلأَيّامِ في الحُكمِ اِختِلافٌ","وَهَمُّ عَشِيَّةِ يُمحى بِبُكرَه",60,"ر",2,0],["وللأيادي من نداهُ يدٌ","عامرةٌ بالجودِ غناءُ",61,"ا",2,0],["وللاعمار اختمها بخير","ويوم البعث نبعث فأزينا",62,"ن",2,0],["وللأم المباحة آنت أقوى","مؤازرة على الدهر العتي",63,"ي",1,0],["وللأزهر الصَّرح إشراقةٌ","من الشمس أضواؤها تُصْقَلُ",64,"ل",1,0],["وللامُورِ مَواقيتٌ مُقَدَّرَةٌ","وكُلُّ أمرٍ لهُ حَدُّ ومِيزانُ",65,"ن",1,0],["وللأكفاء يومئذٍ عَلَيْهم","هبوطٌ في الحضيض ولا صعود",66,"د",1,0],["وللأطيار أن سغبت","بأجسام العدى يقري",67,"ر",2,0],["وللأَعاجِمِ فيه مّذْهَبٌ كَثُرَتْ","أَعلامُهُ فهو إِلاَّ ذِكْرَهُ بالِ",68,"ل",1,0],["وللاتراك طرمذة","تسمى البلف بالعجمي",69,"م",2,0],["وللأَرض يحيا تُربُها وهو ميِّتٌ","وإن لم يَجُدها صوبُ أسحمَ هطّالِ",70,"ل",1,0],["وللأمر كنتَ الليثَ إما حفِظتَهُ","تَعاوَتْ تَعاطاه ثعالبُ تَضبَحُ",71,"ح",1,0],["وَلِلأَقاحي قِبابٌ كُلُّها ذَهَبٌ","مِن حَولِها شُرُفاتٌ كُلُّها دُرَرُ",72,"ر",1,0],["وللأرضِ ثوبٌ بالنجيعِ مُخَضَّبٌ","وللشمسِ وجهٌ بالقَتامُ مُلَثَّمُ",73,"م",1,0],["وللأئمَّةِ الهُداةِ من بَني","حيدَرَةٍ أُولي النُّصوصِ المُقنِعَهْ",74,"ع",2,0],["وللإمامة أنوار مقدسة","تجلو البغيضين من ظلم ومن ظلم",75,"م",1,0],["وللأشراف والعلماء فينا","نرى كلب الولائمِ لا يميلُ",76,"ل",1,0],["وللإجلالِ والإكبارِ قَلبٌ","وللإخلاصِ أعماقُ الضَّميرِ",77,"ر",1,0],["وللأقوامِ تَطْوافٌ عليها","طوافَهمُ على الرّكنِ اليَماني",78,"ن",2,0],["وَللأرضِ رَيٌّ مِن سيول نجيعِهِ","وللطّير من لحم الجسومِ طعامُ",79,"م",1,0],["وللأصحاب ودّعنا","وأهلَ البيت والمحرمْ",80,"م",1,0],["وللأموِيِّ النَّظْم والنَّثر في الذي","ذكَرْنا وإِعْراب كما نحن أعْرَبْنا",81,"ن",2,0],["وَلِلأُسُدِ الواعونَ شِدَّةَ بَأسِهِ","وَما دافَعَت في كُلِّ هَيجا مَناكِبُه",82,"ب",2,0],["وللاردن قد كسيت ضفاف","ثياب نضارة أبدا زهيه",83,"ي",2,0],["وللأوتارِ في صدري حنينٌ","يهيجُ الشّوقَ في نفس العميدِ",84,"د",1,0],["وللأسى سيوف","مشحوذة الغرار",85,"ر",1,0],["وَللأقاليم أَرزاقٌ مضاعفةٌ","بحسن تَدبيره تَزداد في القيم",86,"م",1,0],["وللأمر تدبير يراعي نظامه","فمن رأيه إبرامه وصوابه",87,"ب",2,0],["وللأشرار تشديد العقابِ","ونيران المدافع والحسامُ",88,"م",1,0],["وللأمة البيتُ أم للذئاب","تدبر للناس فيه الغيل",89,"ل",1,0],["وللأثمار فيها طُ","رَفٌ بالطَّرْف مَلْقوطه",90,"ط",2,0],["وللأطْيار أسجاعٌ","بآصالٍ وأسحار",91,"ر",1,0],["وللأرضِ صوتٌ بلا سَامعٍ","وللخيلِ سرجٌ بلا راكِبِ",92,"ب",1,0],["«ولِلأَوْطانِ فِي دَمِ كُلِّ حُرٍّ»","حُقُوقٌ لا تُضَيَّعُ بِالفِراقِ",93,"ق",1,0],["ولِلأَعرابِ يا وَطَنِي وَداعًا","فَكَمْ قَتَلُوا وَكَمْ شَدُّوا وَثَاقِي!!",93,"ق",2,0],["وللأرض من نسج الربيع غلائلٌ","مخضَّرةٌ مبسوطة بفضاها",94,"ا",3,0],["وللأضْيَاف إن طَرقُوا هُدُوًّا","وللكَلِّ المُكِلِّ وكُلّ سَفْرِ",95,"ر",1,0],["وَلِلإِبرِيقِ بَينَهُمُ بَرِيقٌ","لِلَيلِ الهَجرِ وَالأَكدارِ ج