{"poems":[[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[72,"أقسمت ما الملك المؤيد في الورى","https://www.aldiwan.net/poem19008.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[70,"ما له قد خان عهده","https://www.aldiwan.net/poem42968.html","مجزوء الرمل"],[70,"ورقيب عدمته من رقيب","https://www.aldiwan.net/poem42998.html","الخفيف"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[61,"لك في السفرجل منظر تحظى به","https://www.aldiwan.net/poem51292.html","الكامل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[66,"لي جار كأنه البوم في الشك","https://www.aldiwan.net/poem38605.html","الخفيف"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[107,"صبر الفؤاد على فعال الجافي","https://www.aldiwan.net/poem16208.html","الكامل"],[126,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[126,"يا أميم انظري عذاب المشوق","https://www.aldiwan.net/poem50565.html","الخفيف"],[126,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[141,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[148,"قل للنسيم إذا الصباح أعله","https://www.aldiwan.net/poem68470.html","الكامل"],[180,"لبني الجبيلي الكرام مناحة","https://www.aldiwan.net/poem61190.html","الكامل"],[184,"لا تصحبن وإن صحب","https://www.aldiwan.net/poem43844.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[195,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[219,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[219,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[219,"ذاب قلبي عليه حين تدانى","https://www.aldiwan.net/poem55285.html","الخفيف"],[219,"جف ورد الجميل في اللحد","https://www.aldiwan.net/poem55295.html","الخفيف"],[233,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[233,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[280,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[280,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[280,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[280,"نشر الربيع لنا مطاوي طيبه","https://www.aldiwan.net/poem32889.html","الكامل"],[295,"سقيا لمثناة الحجاز وطيبها","https://www.aldiwan.net/poem33334.html","الكامل"],[318,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[326,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[326,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[364,"لا تحدث سواك نفس بفضل","https://www.aldiwan.net/poem17184.html","الخفيف"],[413,"من أبي الهدى لاح فينا مظهر","https://www.aldiwan.net/poem54096.html","الخفيف"],[429,"در علم يلوح في فلك الفضل","https://www.aldiwan.net/poem12460.html","الخفيف"],[429,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[429,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[429,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[434,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[451,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[451,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[462,"وضعيف البناء عن حمل ثوبيه قوي","https://www.aldiwan.net/poem3300.html","عموديه"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[556,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[560,"مكسميس المظلوم بطركنا الذي","https://www.aldiwan.net/poem52635.html","الكامل"],[560,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[573,"رب لهو رفلت في أثوابه","https://www.aldiwan.net/poem2992.html","الخفيف"]],"verses":[["هُوَ كَاتِبٌ هُوَ شَاعِرٌ","هُوَ نَاثِرٌ لِلدُّرِ نَاظِمْ",0,"م",1,0],["هُوَ كَالقَنَاةِ عَدَالةً فِي خَلْقِهِ","وَبِخُلْقِهِ هُوَ كَالقَنَاةِ قَوِيمُ",1,"م",1,0],["هو كرب تأبى الحمية أنّا","بسوى السيف نبتغي تفريجه",2,"ج",2,0],["هو كعبة للجود ما بين الندى","منها وبين الطالبين حجاز",3,"ز",1,0],["هو كعبة الفضل التي قد أغربت","أهل المقاصدِ حولها بطواف",4,"ف",1,0],["هو كالبحر حَدِّثِ ال","ناسَ عنه ولا حرَجْ",5,"ج",1,0],["هُوَ كَالزُهرَةِ وَال","مِرّيخِ في لينٍ وَشِدَّه",6,"د",2,0],["هُوَ كَاللَيلِ في الظَلامِ وَعِندي","هُوَ كَالصُبحِ قاطِعُ اللَذاتِ",7,"ت",1,0],["هُوَ كَالصَخرَةِ عِندَ القِبطِ أَو","كَالحَطيمِ الطُهرِ عِندَ المُسلِمين",8,"ن",1,0],["هو كالحبيب سعدت منه بحسنه","متأملا وبلثمه وعناقه",9,"ق",2,0],["هو كالرِّيمِ ما تَلفَّتَ جيداً","وهو كالغُصْنِ ما تأوَّدَ قَدَّا",10,"د",2,0],["هُوَ كَالماءِ إِن أَرَدتَ لَهُ قَب","ضاً وَإِن رُمتَ مَورِداً فَسَرابُ",11,"ب",1,0],["هُوَ كَوكَبُ الإِسلامِ أَيَّةَ ظُلمَةٍ","يَخرِق فَمُخُّ الكُفرِ فيها رارُ",12,"ر",1,0],["هوَ كعْبَةُ الفضلِ الذي قُصَّادُهُ","قد حَقَّقُوا منه بُلوغَ المَقْصِدِ",13,"د",1,0],["هُوَ كَائِنٌ مِن رُوحِ مِصْرَ وَأَمْرهِا","سَامِي الحَقِيقَةِ بَارِعُ التِّمْثَالَ",14,"ل",1,0],["هُوَ كَعبة المَعروف أَضحى قاصِداً","بِالسَعي كَعبة رَبِهِ لِطَواف",15,"ف",1,0],["هو كعبةُ الأربابِ طرًّا مالهُ","مِنْ مُشْبه في أعصرِ الأعْوَامِ",16,"م",1,0],["هُوَ كَهفُ الأرباب يوم عقابٍ","يومَ يأتونَ مِنْ فكان عميقِ",17,"ق",1,0],["هو كَهْفى إن ساءنى الدهرُ يوماً","وهو سيفى في الحادثاتِ مجيرِى",18,"ر",2,0],["هُوَ كَالغَوادي لا تَمُنُّ إِذا هَمَت","لا كَالغَمامِ تَباعَدَت أَحيانُهُ",19,"ن",2,0],["هو كالربيع فلست تعدم دائباً","حُسنَيهِ إما طلّهُ أو ظله",20,"ل",2,0],["هُوَ كاهِنُ اللَّهِ الَّذي أَبكى التُّقَى","أَسَفاً وَناحَ عَلَيهِ صَدرُ الهَيكَلِ",21,"ل",1,0],["هو كالإناء من النضا","ر حكت صلابته الحجر",22,"ر",1,0],["هو كنزُ الرحمنِ في كلّ عصرٍ","هُم جميعاً أرصادهُ الأمناءُ",23,"ا",2,0],["هو كالملّاح حين","التهم اليمّ متاعه",24,"ه",1,0],["هو كالورد قد تجمل بالنضرة","والظرف لا بزاهي البرود",25,"د",1,0],["هو كلب وليس يخطىء من قا","ل ولكنه بروح حمار",26,"ر",1,0],["هو كالدمية المصاغة من ذهب","أحمر قد أفرغت بقالب فضه",27,"ض",2,0],["هو كأس الحياة نجرعه","مزج الصاب فيه بالشهد",28,"د",1,0],["هُوَ كَالغَيثِ يَملَأُ الأَرضَ جَدوا","هُ فَسِيّانِ مِنهُ قُربي وَبُعدي",29,"د",2,0],["هُوَ كَفّارَةُ ما أَر","كَبُ فيها مِن جُناحِ",30,"ح",1,0],["هُوَ كَالغَيثِ لَدى السِلمِ سَماحاً","وَغَداةَ الحَربِ لَيثٌ لا يُرامُ",31,"م",1,0],["هُوَ كاسِرٌ كِسرى وَمُتبِعُ تُبَّعٍ","ذُلاً أَحاطَ بِهِ وَقاسِرُ قَيصَرِ",32,"ر",1,0],["هُوَ كَعبَةُ الجودِ الَّتي بِطَوافِها","يَستَعصِمُ المُحتاجُ وَالمُجتاحُ",33,"ح",1,0],["هُوَ كَالإِمامِ فَكُلُّ شَحرورٍ عَلى","فَنَنٍ بِمنبَرِهِ أَتى وَخَطيبِهِ",34,"ب",2,0],["هُوَ كيمياوِيُّ الرَبيعِ أَجادَ في","تَفضيضِهِ صُنعاً وفي تَذهيبِهِ",34,"ب",2,0],["هو كَعبةُ الفَضلِ الَّتي يَهوي لَها","من أُمَّة الفُضلاءِ قَلبُ مُنيبها",35,"ب",3,0],["هُوَ كَالظَفرِ في بَنانِ المَعالي","وَسِواهُ مَهما عَلا كَقَلامَه",36,"م",2,0],["هو كالطينة التي نحن منها","فهو كلُّ الأنام في إنسان",37,"ن",1,0],["هو كاسٌ عافه الشر","ب فجفّت قطراته",38,"ه",1,0],["هو كالطَّودِ وقاراً في الحُبا","وهْو كالجَودِ بِداراً بالحِباء",39,"ا",2,0],["هُوَ كَأسٌ وَسَكرَةُ المَوتِ قالَت","ذاكَ مِنّي ما كُنتَ مِنهُ تَحيدُ",40,"د",1,0],["هو كالبحر إنْ تَرِدْه تراه","معدن الدرّ بل مقرّ الجوهر",41,"ر",1,0],["هو كالشافعيّ علماً إسحا","قَ ويحيى ضبطاً وعُمقَ أصالَهْ",42,"ل",2,0],["هو كالشّافعيّ في الحلمِ والعل","مِ وفي النصّ دونَه داوودُ",43,"د",1,0],["هو كالسيفِ غير أنّ له من","كل وجهٍ للمفسدين غِرارُ",44,"ر",1,0],["هو كعبةُ الإفضالِ إلا أنها","بعُدَتْ ومن لم يسَطِعْ لم يحْجُجِ",45,"ج",1,0],["هو كوكب الخلفاء إذ هديت به","لمناهج الإنعام والإكرام",46,"م",1,0],["هو كالشهد ذائب مزج العن","بر فيه فما خمور القناني",47,"ن",2,0],["هو كل الغنى وكل","وجودي يا زماني فلن تراني العديما",48,"م",2,0],["هو كالصقر وما با","لى رفيف الطير صقر",49,"ر",1,0],["هو كالجبل الشامخ لم","يعبأ ولم يهززه صخر",49,"ر",1,0],["هو كالبحر الذي إن","ماج لا يثنيه قطر",49,"ر",1,0],["هو كالجو الذي يض","حك وهو المكفهر",49,"ر",1,0],["هو كالصحراء في الت","تيه وفيها الأمن غدر",49,"ر",1,0],["هو كالذرّ لا كمثلِ أبي ذرٍّ","وكم بين طّيب وخبيث",50,"ث",1,0],["هو كالزّلالِ عذوبةً وسلاسةً","وإذا شددتَ قواه فهو الجَندلُ",51,"ل",1,0],["هو كل شيء في الوجود الواحدِ","هو كل موجود هناك وواجدِ",52,"د",1,1],["هو كافرٌ بالوزنِ …لو كُتبت","لعيونِهِ الأشعارُ والمدحُ",53,"ح",1,0],["هو كوكبُ الشَّرقِ اُستقرَّ قَرارُهُ","في جَنَّةٍ فُتِحَتْ لهُ أخدارُها",54,"ر",3,0],["هوَ كوكبٌ في الشرقِ يسطَعُ نُورُهُ","ويلوحُ فضلُ شُعاعِهِ في المَغربِ",55,"ب",1,0],["هُوَ كَهْلُ الحِجَى وإِن كَانَ طِفْلاً","مَا سَخَا جِيدُه بنزعِ سَحَابِه",56,"ب",2,0]]}