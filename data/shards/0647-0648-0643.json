{"poems":[[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[72,"أقسمت ما الملك المؤيد في الورى","https://www.aldiwan.net/poem19008.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[70,"ما له قد خان عهده","https://www.aldiwan.net/poem42968.html","مجزوء الرمل"],[70,"ورقيب عدمته من رقيب","https://www.aldiwan.net/poem42998.html","الخفيف"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[61,"لك في السفرجل منظر تحظى به","https://www.aldiwan.net/poem51292.html","الكامل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[66,"لي جار كأنه البوم في الشك","https://www.aldiwan.net/poem38605.html","الخفيف"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[100,"بعد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=50191",""],[110,"صبر الفؤاد على فعال الجافي","https://www.aldiwan.net/poem16208.html","الكامل"],[129,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[129,"يا أميم انظري عذاب المشوق","https://www.aldiwan.net/poem50565.html","الخفيف"],[129,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[144,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[151,"قل للنسيم إذا الصباح أعله","https://www.aldiwan.net/poem68470.html","الكامل"],[183,"لبني الجبيلي الكرام مناحة","https://www.aldiwan.net/poem61190.html","الكامل"],[187,"لا تصحبن وإن صحب","https://www.aldiwan.net/poem43844.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[198,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[222,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[222,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[222,"ذاب قلبي عليه حين تدانى","https://www.aldiwan.net/poem55285.html","الخفيف"],[222,"جف ورد الجميل في اللحد","https://www.aldiwan.net/poem55295.html","الخفيف"],[236,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[236,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[283,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[283,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[283,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[283,"نشر الربيع لنا مطاوي طيبه","https://www.aldiwan.net/poem32889.html","الكامل"],[298,"سقيا لمثناة الحجاز وطيبها","https://www.aldiwan.net/poem33334.html","الكامل"],[321,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[329,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[329,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[365,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[367,"لا تحدث سواك نفس بفضل","https://www.aldiwan.net/poem17184.html","الخفيف"],[417,"من أبي الهدى لاح فينا مظهر","https://www.aldiwan.net/poem54096.html","الخفيف"],[433,"در علم يلوح في فلك الفضل","https://www.aldiwan.net/poem12460.html","الخفيف"],[433,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[433,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[433,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[438,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[444,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[454,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[454,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[465,"وضعيف البناء عن حمل ثوبيه قوي","https://www.aldiwan.net/poem3300.html","عموديه"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[552,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[559,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[561,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[563,"مكسميس المظلوم بطركنا الذي","https://www.aldiwan.net/poem52635.html","الكامل"],[563,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[576,"رب لهو رفلت في أثوابه","https://www.aldiwan.net/poem2992.html","الخفيف"]],"verses":[["هُوَ كَاتِبٌ هُوَ شَاعِرٌ","هُوَ نَاثِرٌ لِلدُّرِ نَاظِمْ",0,"م",1,0],["هُوَ كَالقَنَاةِ عَدَالةً فِي خَلْقِهِ","وَبِخُلْقِهِ هُوَ كَالقَنَاةِ قَوِيمُ",1,"م",1,0],["هو كرب تأبى الحمية أنّا","بسوى السيف نبتغي تفريجه",2,"ج",2,0],["هو كعبة للجود ما بين الندى","منها وبين الطالبين حجاز",3,"ز",1,0],["هو كعبة الفضل التي قد أغربت","أهل المقاصدِ حولها بطواف",4,"ف",1,0],["هو كالبحر حَدِّثِ ال","ناسَ عنه ولا حرَجْ",5,"ج",1,0],["هُوَ كَالزُهرَةِ وَال","مِرّيخِ في لينٍ وَشِدَّه",6,"د",2,0],["هُوَ كَاللَيلِ في الظَلامِ وَعِندي","هُوَ كَالصُبحِ قاطِعُ اللَذاتِ",7,"ت",1,0],["هُوَ كَالصَخرَةِ عِندَ القِبطِ أَو","كَالحَطيمِ الطُهرِ عِندَ المُسلِمين",8,"ن",1,0],["هو كالحبيب سعدت منه بحسنه","متأملا وبلثمه وعناقه",9,"ق",2,0],["هو كالرِّيمِ ما تَلفَّتَ جيداً","وهو كالغُصْنِ ما تأوَّدَ قَدَّا",10,"د",2,0],["هُوَ كَالماءِ إِن أَرَدتَ لَهُ قَب","ضاً وَإِن رُمتَ مَورِداً فَسَرابُ",11,"ب",1,0],["هُوَ كَوكَبُ الإِسلامِ أَيَّةَ ظُلمَةٍ","يَخرِق فَمُخُّ الكُفرِ فيها رارُ",12,"ر",1,0],["هوَ كعْبَةُ الفضلِ الذي قُصَّادُهُ","قد حَقَّقُوا منه بُلوغَ المَقْصِدِ",13,"د",1,0],["هُوَ كَائِنٌ مِن رُوحِ مِصْرَ وَأَمْرهِا","سَامِي الحَقِيقَةِ بَارِعُ التِّمْثَالَ",14,"ل",1,0],["ةو كيف المسير ودربي طويل","طويل وجهدي قصير قصير ؟ !",15,"ر",1,0],["هُوَ كَعبة المَعروف أَضحى قاصِداً","بِالسَعي كَعبة رَبِهِ لِطَواف",16,"ف",1,0],["هو كعبةُ الأربابِ طرًّا مالهُ","مِنْ مُشْبه في أعصرِ الأعْوَامِ",17,"م",1,0],["هُوَ كَهفُ الأرباب يوم عقابٍ","يومَ يأتونَ مِنْ فكان عميقِ",18,"ق",1,0],["هو كَهْفى إن ساءنى الدهرُ يوماً","وهو سيفى في الحادثاتِ مجيرِى",19,"ر",2,0],["هُوَ كَالغَوادي لا تَمُنُّ إِذا هَمَت","لا كَالغَمامِ تَباعَدَت أَحيانُهُ",20,"ن",2,0],["هو كالربيع فلست تعدم دائباً","حُسنَيهِ إما طلّهُ أو ظله",21,"ل",2,0],["هُوَ كاهِنُ اللَّهِ الَّذي أَبكى التُّقَى","أَسَفاً وَناحَ عَلَيهِ صَدرُ الهَيكَلِ",22,"ل",1,0],["هو كالإناء من النضا","ر حكت صلابته الحجر",23,"ر",1,0],["هو كنزُ الرحمنِ في كلّ عصرٍ","هُم جميعاً أرصادهُ الأمناءُ",24,"ا",2,0],["هو كالملّاح حين","التهم اليمّ متاعه",25,"ه",1,0],["هو كالورد قد تجمل بالنضرة","والظرف لا بزاهي البرود",26,"د",1,0],["هو كلب وليس يخطىء من قا","ل ولكنه بروح حمار",27,"ر",1,0],["هو كالدمية المصاغة من ذهب","أحمر قد أفرغت بقالب فضه",28,"ض",2,0],["هو كأس الحياة نجرعه","مزج الصاب فيه بالشهد",29,"د",1,0],["هُوَ كَالغَيثِ يَملَأُ الأَرضَ جَدوا","هُ فَسِيّانِ مِنهُ قُربي وَبُعدي",30,"د",2,0],["هُوَ كَفّارَةُ ما أَر","كَبُ فيها مِن جُناحِ",31,"ح",1,0],["هُوَ كَالغَيثِ لَدى السِلمِ سَماحاً","وَغَداةَ الحَربِ لَيثٌ لا يُرامُ",32,"م",1,0],["هُوَ كاسِرٌ كِسرى وَمُتبِعُ تُبَّعٍ","ذُلاً أَحاطَ بِهِ وَقاسِرُ قَيصَرِ",33,"ر",1,0],["هُوَ كَعبَةُ الجودِ الَّتي بِطَوافِها","يَستَعصِمُ المُحتاجُ وَالمُجتاحُ",34,"ح",1,0],["هُوَ كَالإِمامِ فَكُلُّ شَحرورٍ عَلى","فَنَنٍ بِمنبَرِهِ أَتى وَخَطيبِهِ",35,"ب",2,0],["هُوَ كيمياوِيُّ الرَبيعِ أَجادَ في","تَفضيضِهِ صُنعاً وفي تَذهيبِهِ",35,"ب",2,0],["هو كَعبةُ الفَضلِ الَّتي يَهوي لَها","من أُمَّة الفُضلاءِ قَلبُ مُنيبها",36,"ب",3,0],["هُوَ كَالظَفرِ في بَنانِ المَعالي","وَسِواهُ مَهما عَلا كَقَلامَه",37,"م",2,0],["هو كالطينة التي نحن منها","فهو كلُّ الأنام في إنسان",38,"ن",1,0],["هو كاسٌ عافه الشر","ب فجفّت قطراته",39,"ه",1,0],["هو كالطَّودِ وقاراً في الحُبا","وهْو كالجَودِ بِداراً بالحِباء",40,"ا",2,0],["هُوَ كَأسٌ وَسَكرَةُ المَوتِ قالَت","ذاكَ مِنّي ما كُنتَ مِنهُ تَحيدُ",41,"د",1,0],["هو كالبحر إنْ تَرِدْه تراه","معدن الدرّ بل مقرّ الجوهر",42,"ر",1,0],["هو كالشافعيّ علماً إسحا","قَ ويحيى ضبطاً وعُمقَ أصالَهْ",43,"ل",2,0],["هو كالشّافعيّ في الحلمِ والعل","مِ وفي النصّ دونَه داوودُ",44,"د",1,0],["هو كالسيفِ غير أنّ له من","كل وجهٍ للمفسدين غِرارُ",45,"ر",1,0],["هو كعبةُ الإفضالِ إلا أنها","بعُدَتْ ومن لم يسَطِعْ لم يحْجُجِ",46,"ج",1,0],["هو كوكب الخلفاء إذ هديت به","لمناهج الإنعام والإكرام",47,"م",1,0],["هو كالشهد ذائب مزج العن","بر فيه فما خمور القناني",48,"ن",2,0],["هو كل الغنى وكل","وجودي يا زماني فلن تراني العديما",49,"م",2,0],["هو كالصقر وما با","لى رفيف الطير صقر",50,"ر",1,0],["هو كالجبل الشامخ لم","يعبأ ولم يهززه صخر",50,"ر",1,0],["هو كالبحر الذي إن","ماج لا يثنيه قطر",50,"ر",1,0],["هو كالجو الذي يض","حك وهو المكفهر",50,"ر",1,0],["هو كالصحراء في الت","تيه وفيها الأمن غدر",50,"ر",1,0],["هو كالذرّ لا كمثلِ أبي ذرٍّ","وكم بين طّيب وخبيث",51,"ث",1,0],["هُوَ كالمدارِ حكايةٌ لا تنتهي","والفصلُ فيها لا يعودُ لأَصْلِهِ",52,"ل",2,0],["هو كالزّلالِ عذوبةً وسلاسةً","وإذا شددتَ قواه فهو الجَندلُ",53,"ل",1,0],["هو كل شيء في الوجود الواحدِ","هو كل موجود هناك وواجدِ",54,"د",1,1],["هو كافرٌ بالوزنِ …لو كُتبت","لعيونِهِ الأشعارُ والمدحُ",55,"ح",1,0],["هو كوكبُ الشَّرقِ اُستقرَّ قَرارُهُ","في جَنَّةٍ فُتِحَتْ لهُ أخدارُها",56,"ر",3,0],["هوَ كوكبٌ في الشرقِ يسطَعُ نُورُهُ","ويلوحُ فضلُ شُعاعِهِ في المَغربِ",57,"ب",1,0],["هُوَ كَهْلُ الحِجَى وإِن كَانَ طِفْلاً","مَا سَخَا جِيدُه بنزعِ سَحَابِه",58,"ب",2,0]]}