1,"أحتاج عمرا كي أرى دمعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=191667",""],[5431,"بالنعش راودني اشتهاؤك!...","https://www.poetsgate.com/ViewPoem.aspx?id=196703",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[5431,"وفنائي على ذراعيك حيّ!!","https://www.poetsgate.com/ViewPoem.aspx?id=201377",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5587,"أَتَى الرَّبِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193849",""],[5652,"مرت مواني رحلة الذات في غاء","https://www.poetsgate.com/ViewPoem.aspx?id=181103",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5751,"حزنٌ بلون الفَرَح","https://www.poetsgate.com/ViewPoem.aspx?id=214719",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5853,"أمسية التوت","https://www.poetsgate.com/ViewPoem.aspx?id=188355",""],[5861,"أيوب آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=190702",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[1920,"نفَس جديد","https://www.poetsgate.com/ViewPoem.aspx?id=198941",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5956,"من صفات سيد المرسلين","https://www.poetsgate.com/ViewPoem.aspx?id=192611",""],[5956,"أنعمْ بسيفٍ صارمٍ كأبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193096",""],[5956,"وُصِفَ البلال الحلو مثل أبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193440",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5956,"من الجلوس اللّا سليم ظهر نجلي اْحدَودَب","https://www.poetsgate.com/ViewPoem.aspx?id=194784",""],[5956,"إن المهيمن وحده هو قادر","https://www.poetsgate.com/ViewPoem.aspx?id=208056",""],[5956,"يا جابراً بمهارة لكسورنا","https://www.poetsgate.com/ViewPoem.aspx?id=210305",""],[5957,"إن بعد العسر يسرا","https://www.poetsgate.com/ViewPoem.aspx?id=180664",""],[6167,"الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85476&r=&rc=5",""],[6229,"ذلك الصوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65179&r=&rc=2",""],[6237,"القلب الكبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77899&r=&rc=41",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["هُوَ كَاتِبٌ هُوَ شَاعِرٌ","هُوَ نَاثِرٌ لِلدُّرِ نَاظِمْ",0,"م",1,0],["هُوَ كَالقَنَاةِ عَدَالةً فِي خَلْقِهِ","وَبِخُلْقِهِ هُوَ كَالقَنَاةِ قَوِيمُ",1,"م",1,0],["هو كرب تأبى الحمية أنّا","بسوى السيف نبتغي تفريجه",2,"ج",2,0],["هو كعبة للجود ما بين الندى","منها وبين الطالبين حجاز",3,"ز",1,0],["هو كعبة الفضل التي قد أغربت","أهل المقاصدِ حولها بطواف",4,"ف",1,0],["هو كالبحر حَدِّثِ ال","ناسَ عنه ولا حرَجْ",5,"ج",1,0],["هُوَ كَالزُهرَةِ وَال","مِرّيخِ في لينٍ وَشِدَّه",6,"د",2,0],["هُوَ كَاللَيلِ في الظَلامِ وَعِندي","هُوَ كَالصُبحِ قاطِعُ اللَذاتِ",7,"ت",1,0],["هُوَ كَالصَخرَةِ عِندَ القِبطِ أَو","كَالحَطيمِ الطُهرِ عِندَ المُسلِمين",8,"ن",1,0],["هو كالحبيب سعدت منه بحسنه","متأملا وبلثمه وعناقه",9,"ق",2,0],["هو كالرِّيمِ ما تَلفَّتَ جيداً","وهو كالغُصْنِ ما تأوَّدَ قَدَّا",10,"د",2,0],["هُوَ كَالماءِ إِن أَرَدتَ لَهُ قَب","ضاً وَإِن رُمتَ مَورِداً فَسَرابُ",11,"ب",1,0],["هُوَ كَوكَبُ الإِسلامِ أَيَّةَ ظُلمَةٍ","يَخرِق فَمُخُّ الكُفرِ فيها رارُ",12,"ر",1,0],["هوَ كعْبَةُ الفضلِ الذي قُصَّادُهُ","قد حَقَّقُوا منه بُلوغَ المَقْصِدِ",13,"د",1,0],["هُوَ كَائِنٌ مِن رُوحِ مِصْرَ وَأَمْرهِا","سَامِي الحَقِيقَةِ بَارِعُ التِّمْثَالَ",14,"ل",1,0],["ةو كيف المسير ودربي طويل","طويل وجهدي قصير قصير ؟ !",15,"ر",1,0],["هُوَ كَعبة المَعروف أَضحى قاصِداً","بِالسَعي كَعبة رَبِهِ لِطَواف",16,"ف",1,0],["هو كعبةُ الأربابِ طرًّا مالهُ","مِنْ مُشْبه في أعصرِ الأعْوَامِ",17,"م",1,0],["هُوَ كَهفُ الأرباب يوم عقابٍ","يومَ يأتونَ مِنْ فكان عميقِ",18,"ق",1,0],["هو كَهْفى إن ساءنى الدهرُ يوماً","وهو سيفى في الحادثاتِ مجيرِى",19,"ر",2,0],["هُوَ كَالغَوادي لا تَمُنُّ إِذا هَمَت","لا كَالغَمامِ تَباعَدَت أَحيانُهُ",20,"ن",2,0],["هو كالربيع فلست تعدم دائباً","حُسنَيهِ إما طلّهُ أو ظله",21,"ل",2,0],["هُوَ كاهِنُ اللَّهِ الَّذي أَبكى التُّقَى","أَسَفاً وَناحَ عَلَيهِ صَدرُ الهَيكَلِ",22,"ل",1,0],["هو كالإناء من النضا","ر حكت صلابته الحجر",23,"ر",1,0],["هو كنزُ الرحمنِ في كلّ عصرٍ","هُم جميعاً أرصادهُ الأمناءُ",24,"ا",2,0],["هو كالملّاح حين","التهم اليمّ متاعه",25,"ه",1,0],["هو كالورد قد تجمل بالنضرة","والظرف لا بزاهي البرود",26,"د",1,0],["هو كلب وليس يخطىء من قا","ل ولكنه بروح حمار",27,"ر",1,0],["هو كالدمية المصاغة من ذهب","أحمر قد أفرغت بقالب فضه",28,"ض",2,0],["هو كأس الحياة نجرعه","مزج الصاب فيه بالشهد",29,"د",1,0],["هُوَ كَالغَيثِ يَملَأُ الأَرضَ جَدوا","هُ فَسِيّانِ مِنهُ قُربي وَبُعدي",30,"د",2,0],["هُوَ كَفّارَةُ ما أَر","كَبُ فيها مِن جُناحِ",31,"ح",1,0],["هُوَ كَالغَيثِ لَدى السِلمِ سَماحاً","وَغَداةَ الحَربِ لَيثٌ لا يُرامُ",32,"م",1,0],["هُوَ كاسِرٌ كِسرى وَمُتبِعُ تُبَّعٍ","ذُلاً أَحاطَ بِهِ وَقاسِرُ قَيصَرِ",33,"ر",1,0],["هُوَ كَعبَةُ الجودِ الَّتي بِطَوافِها","يَستَعصِمُ المُحتاجُ وَالمُجتاحُ",34,"ح",1,0],["هُوَ كَالإِمامِ فَكُلُّ شَحرورٍ عَلى","فَنَنٍ بِمنبَرِهِ أَتى وَخَطيبِهِ",35,"ب",2,0],["هُوَ كيمياوِيُّ الرَبيعِ أَجادَ في","تَفضيضِهِ صُنعاً وفي تَذهيبِهِ",35,"ب",2,0],["هو كَعبةُ الفَضلِ الَّتي يَهوي لَها","من أُمَّة الفُضلاءِ قَلبُ مُنيبها",36,"ب",3,0],["هُوَ كَالظَفرِ في بَنانِ المَعالي","وَسِواهُ مَهما عَلا كَقَلامَه",37,"م",2,0],["هو كالطينة التي نحن منها","فهو كلُّ الأنام في إنسان",38,"ن",1,0],["هو كاسٌ عافه الشر","ب فجفّت قطراته",39,"ه",1,0],["هو كالطَّودِ وقاراً في الحُبا","وهْو كالجَودِ بِداراً بالحِباء",40,"ا",2,0],["هُوَ كَأسٌ وَسَكرَةُ المَوتِ قالَت","ذاكَ مِنّي ما كُنتَ مِنهُ تَحيدُ",41,"د",1,0],["هو كالبحر إنْ تَرِدْه تراه","معدن الدرّ بل مقرّ الجوهر",42,"ر",1,0],["هو كالشافعيّ علماً إسحا","قَ ويحيى ضبطاً وعُمقَ أصالَهْ",43,"ل",2,0],["هو كالشّافعيّ في الحلمِ والعل","مِ وفي النصّ دونَه داوودُ",44,"د",1,0],["هو كالسيفِ غير أنّ له من","كل وجهٍ للمفسدين غِرارُ",45,"ر",1,0],["هو كعبةُ الإفضالِ إلا أنها","بعُدَتْ ومن لم يسَطِعْ لم يحْجُجِ",46,"ج",1,0],["هو كوكب الخلفاء إذ هديت به","لمناهج الإنعام والإكرام",47,"م",1,0],["هو كالشهد ذائب مزج العن","بر فيه فما خمور القناني",48,"ن",2,0],["هو كل الغنى وكل","وجودي يا زماني فلن تراني العديما",49,"م",2,0],["هو كالصقر وما با","لى رفيف الطير صقر",50,"ر",1,0],["هو كالجبل الشامخ لم","يعبأ ولم يهززه صخر",50,"ر",1,0],["هو كالبحر الذي إن","ماج لا يثنيه قطر",50,"ر",1,0],["هو كالجو الذي يض","حك وهو المكفهر",50,"ر",1,0],["هو كالصحراء في الت","تيه وفيها الأمن غدر",50,"ر",1,0],["هو كالذرّ لا كمثلِ أبي ذرٍّ","وكم بين طّيب وخبيث",51,"ث",1,0],["هُوَ كالمدارِ حكايةٌ لا تنتهي","والفصلُ فيها لا يعودُ لأَصْلِهِ",52,"ل",2,0],["هو كالزّلالِ عذوبةً وسلاسةً","وإذا شددتَ قواه فهو الجَندلُ",53,"ل",1,0],["هو كل شيء في الوجود الواحدِ","هو كل موجود هناك وواجدِ",54,"د",1,1],["هو كافرٌ بالوزنِ …لو كُتبت","لعيونِهِ الأشعارُ والمدحُ",55,"ح",1,0],["هو كوكبُ الشَّرقِ اُستقرَّ قَرارُهُ","في جَنَّةٍ فُتِحَتْ لهُ أخدارُها",56,"ر",3,0],["هوَ كوكبٌ في الشرقِ يسطَعُ نُورُهُ","ويلوحُ فضلُ شُعاعِهِ في المَغربِ",57,"ب",1,0],["هُوَ كَهْلُ الحِجَى وإِن كَانَ طِفْلاً","مَا سَخَا جِيدُه بنزعِ سَحَابِه",58,"ب",2,0],["هو كالمحيط تفيض فيه جواهرٌ","ومكارم وعوارف وفواضل",59,"ل",1,0],["هُوَ كِسرى المُلوكِ لَحظاً وَلَكِن","فَعَلَّهُ بِاِمرِئِ الهَوى فَعَلَ قَيصَر",60,"ر",1,0],["هو كل شيء واحد في علمه","وسوى الذي من وصفه يتكثر",61,"ر",1,0],["هُوَ كنز مَعروف وَكَعبة وافد","هُوَ حصن مصر وَعزُّها وَحِماها",62,"ا",3,0],["هُوَ كالصفر في الحِساب فَلا قَد","ر له عِندَنا لَدى الإِنفِراد",63,"د",1,0],["هو كنز الندى ورب أياد","واكفات تسح سح الغوادي",64,"د",2,0],["هو كالبدر بل إِنَّ نورَ ال","بدرِ من نور وجهه يستعارْ",65,"ر",1,0],["هوَ كَعبَةُ الجودِ الّتي","فيها يُطافُ وَلا تَطوف",66,"ف",1,0],["هو كالروض جامعُ كل باهٍ","من صنوف الشميم والزهواتِ",67,"ت",1,0],["هو كالبحر نوالاً","بل على البحر يزيد",68,"د",1,0],["هو كالطير ربما نحب الطي","رُ فأبكى ولم يكن أسوانا",69,"ن",2,0],["هو كالجوهر اليتيم صفاء","ليس بالاكتساب ذاك الصفاء",70,"ا",2,0],["هو كَاللَيلِ من ظلامٍ وعندي","هو كالصُبح قاطعُ اللّذاتِ",71,"ت",1,0],["هو كان الأنيسَ فيها ولولا","ه أصيبتْ عقولُنا بالخبالِ",72,"ل",1,0],["هو كعبةٌ والجودُ مش","عرُه ومروته المروَّه",73,"و",2,0],["هو كف الله التي نستن","يل الخلق مهما تروم من جدواها",74,"ا",3,0],["هو كالماء رقة في نفوس","ظاميات تذوب بالافكار",75,"ر",1,0],["هو كامل وله جمال وافر","وعلى طويل جفاه لي دمع جري",76,"ر",2,0],["هو كعبة الدنيا ورك","ن حياتها والملتزم",77,"م",1,0],["هو كافل الملك الغياثيّ الذي","لم يرض في الدنيا سواه كفيلا",78,"ل",2,0],["هُو كالهَواءِ بعينِهِ لا عينُهُ","مَلأ الخُلُوَّ ولا يُرَى بِعِيَانِ",79,"ن",1,0],["هَوَ كُلُّهُ حَقٌّ وَعَدلٌ ذُو رِضَى","وَالشَّانُ فِي المَقضِيِّ كُلَّ الشَّانِ",79,"ن",1,0],["هُوَ كَالشَمسُ يَبهَرُ العَينَ نوراً","فَليُمَتَّع بِهِ جَميعُ الأَنامِ",80,"م",1,0],["هو كهفي من نوب الدنيا","وشفيعي في يوم المحشر",81,"ر",1,0],["هو كعبة العلماء كم في بايه","أضحى كمزدحم الحجيج زحامها",82,"م",3,0],["هو كالغمامة أو كبحر ساكن","طورا وطورا خائض الأهوال",83,"ل",1,0],["هو كعبة المجد التي قد أصبحت","أمنا لخوف اللاجئ المتطلب",84,"ب",1,0],["هو كوكب الشرف الذي أوصاه","تزرى لرفعة قدرها بالكوكب",84,"ب",1,0],["هو كونٌ في ذاته من هيولى","وبروح من صورة الرحمان",85,"ن",1,0],["هُوَ كُلَّما أَحيا لِمَيتٍ أَو أَعا","دَ لِأَكمَهٍ بَصَراً كَما المُعتادِ",86,"د",1,0],["هو كهف تحصين وبر مبرة","وسماء أغداق وبحر مكارم",87,"م",1,0],["هو كهف إذا لجأنا إليه","في مخوف مما نخال أمنا",88,"ن",2,0],["هو كوكب إيضاح بهجة ضوئه","مغن عن المصباح والتنوير",89,"ر",1,0],["هو كنز في الحشا أحفظه","سوف لا تفتحه إلا السنون",90,"ن",1,0],["هو كنة الحياة ما زال سرّاً","كل حكمٍ فيه يؤول لنقض",91,"ض",1,0],["هو كاتب وسواد قلبي حبره","أو ما تر أن مداده من نار",92,"ر",1,0],["هو كعبة المعروف راحته","كالركن مستلما وملتزما",93,"م",2,0],["هو كالظبا حدّاً فتلك خضيبة","بدمٍ وهذا بالمداد خضيب",94,"ب",1,0],["هو كالنبي فضيلةً لكن ذا","من حظّه كاسٍ وهذا عار",95,"ر",1,0],["هو كوكب العلماء والصلحاء وال","خلصاء والرؤساء ذو الفكر الوري",96,"ر",2,0],["هو كاملُ الأوصافِ عزَّ نظيرُه","كَسبُ العلا طرزٌ له ووشاح",97,"ح",1,0