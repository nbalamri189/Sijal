{"poems":[[56,"لقد رحل ابن موسى بالمعالي","https://www.aldiwan.net/poem27429.html","الوافر"],[87,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[47,"بقيت مسلما للمسلمينا","https://www.aldiwan.net/poem66692.html","الوافر"],[48,"تمنت غلاما يافعا نافعا لها","https://www.aldiwan.net/poem22785.html","الطويل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/839","الوافر"],[164,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[190,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[190,"بكى صبي فرأت أمه","https://www.aldiwan.net/poem43634.html","السريع"],[216,"ونشوانة الأعطاف غرثاء بضة","https://www.aldiwan.net/poem37848.html","الطويل"],[287,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[287,"يا هاربا ووشيك الطعن يتبعه","https://www.aldiwan.net/poem32892.html","البسيط"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[385,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[422,"ليهنكم العقد المبارك إنه","https://www.aldiwan.net/poem53852.html","الطويل"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[440,"سررت بليل كالحداد لبسته","https://www.aldiwan.net/poem25316.html","الطويل"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[580,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107191","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64866","الطويل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198204","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79840","المتقارب"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130572","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100472","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27551","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67209","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60851","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93593","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82913","المتقارب"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130014","البسيط"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205193","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134093","الوافر"],[302,"","https://poetry.dctabudhabi.ae/diwan/poem/90121","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89064","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108199","الطويل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106799","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111062","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199085","الطويل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105145","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66127","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139622",""],[4578,"فرق المليحة قد أضا أم فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=49398",""],[4932,"سررتم فَإِنِّي بعدكم غير مسرور","https://www.poetsgate.com/ViewPoem.aspx?id=189366",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[3591,"إن كان دهرك قبلاً غير محمود","https://www.poetsgate.com/ViewPoem.aspx?id=149454",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""]],"verses":[["سُرِرتُم بِاِفتِقادِ فَتىً بَكاهُ","رَسولُ اللَهِ وَالدينُ الحَنيفُ",0,"ف",1,0],["سِر رُوَيداً في فَضاءٍ سافِرٍ","ضاحِكِ الصَفحَةِ كَالفِردَوسِ صاح",1,"ح",1,0],["سُرِرنا بِأَن أَمَّرتَهُ وَنَصَبتَهُ","لَنا عَلَماً نَأوي إِلى ظِلِّهِ غَدا",2,"د",2,0],["سَرَرتَ بِهِ القُلوبَ غَداةَ جاءَت","وِلايَتُهُ وَأَقرَرتَ العُيونا",3,"ن",2,0],["سُرِرتِ بِهِ إِذ قيلَ أَعطَيتِ فارِساً","وَما هُوَ إِلّا ضَيغَمٌ لَكِ فارِسُ",4,"س",1,0],["سَرَرتُ بِفَكِّهِ حَيِّي نُمَيرٍ","وَسُؤتُ بَني رَبيعَةَ وَالضِبابِ",5,"ب",1,0],["سررتني حين أرضيت الإِله بها","فما تبالي إذا أسخطت زنديقا",6,"ق",2,0],["سررت بترك جاهلهم يولي","لأن الضد مملول المكان",7,"ن",1,0],["سررت بود أهل الفضل منهم","ولم أجفل بثيران الفدان",7,"ن",1,0],["سررت من أبصرني مقبلا","بمقلة شهلاء خدّاعه",8,"ع",2,0],["سُرِرْتُ وريعانُ الشبابِ مساعدي","إليها ولن أخشى رقيبي وعاذلِيِ",9,"ل",2,0],["سَرَرتَ دِمَشقَ بِهَذا القُدوم","فَأَهدَيتَ حَلياً إِلى عاطِلِ",10,"ل",1,0],["سَرَرتني حينَ كُنتَ الظَبيَ مُلتَفِتاً","وَقَد عَققت وَأَنتَ الكَلبُ مُنقَلَبا",11,"ب",2,0],["سَررتُ موهِناً نَحوي فَأَبدَت مَسَرَّتي","وَحَيَّت فَأَحَييتَني بِحُسنِ التَحِيَّةِ",12,"ه",1,1],["سُررت بِها أَهل المَودة وَالوَلا","وَلَكنها أَودَت بِحاسدك الشاني",13,"ن",2,0],["سُرِرْنا وسُرَّ النَّاس فيما أتوا به","بيوم له شأن وناهيك من شان",14,"ن",1,0],["سرّ رمز المجد مبنى بيته","علم السؤدد سرًّا وجهارا",15,"ر",2,0],["سُرِرتَ بِلَيلٍ كَالحِدَادِ لَبِستَهُ","وَسَاءَكَ صُبحٌ كَالرِّدَاءِ المُصَبَّغِ",16,"غ",1,1],["سُرِرْتُ به حيناً فلمّا بلوتُهُ","بكيتُ عليه بالدّموعِ الذّوارفِ",17,"ف",1,0],["سُرِرْنا بأَن أَمَّرْتَه ونصبيتَه","لنا عَلَماً يأْوِي إِلى ظِلِّه الهُدى",18,"د",2,0],["سُرِرتُ بِما قَد جاءَنِي مِن نِظامِهِ","وَرُحتُ وَأَيمُ اللَّهِ بادِي المَسَرَّةِ",19,"ه",1,0],["سُرِرْتُ بِرِقِّي في هَواهُ فعُهْدتي","يُحرِّرُها جَفْني بمُحْمَرِّ دمْعِهِ",20,"ع",2,0],["سرَرْتُ به نفسي وأقرَرتُ ناظري","وأكثَرتُ إعجابي به وتعجُّبي",21,"ب",2,0],["سررتُ بها غير أنَّ الحبيب","فقدانُه ساءَ قلب المشوقا",22,"ق",2,0],["سررت بجعفرِ إذ حلّ أرضي","كما سر المسافر بالإياب",23,"ب",1,1],["سررت به وأنا قد بقينا","نطارح لوعة مما رأينا",24,"ن",2,0],["سررتُ بها لما علمت وجودها","من الله ذي العَرشِ المجيد المطالبِ",25,"ب",1,0],["سُررنا به والمجدُ أعلن بُشره","وأفرح من هذي الأَنامِ قُلوبا",26,"ب",2,0],["سررتُ باليمن الميمونِ حين صَفت","لابن الرسول فما في تلك أكدارُ",27,"ر",1,0],["سُررت بِها قَلبي وَجليت ناظِري","وَحليت جيدي حينَ نَظمتها عقدا",28,"د",2,0],["سُررتُ بِهجرِكِ لَمّا علمتُ","بِأَنَّ لِقَلبِك فيه سُرورا",29,"ر",2,1],["سررتُ لمّا وعى سمعي بأنّك قد","أصبحتَ تركَبُ أو تمشي على قدَمِ",30,"م",1,0],["سررتُ بإسلام الوليد ديانةً","وأقلقني علمي بأنك مقلق",31,"ق",1,0],["سررت بمصر لاحب لجاه","ولكني ارجى ان أراكا",32,"ك",2,1],["سررتَ كلَّ صديق في مواقفها","ما كادَ يسأل حتّى سُرَّ بالخَبَرِ",33,"ر",1,0],["سررت بنيل القصد من غير موعدِ","ولا شيء أشهى من سرور مجددِ",34,"د",1,1],["سررت بنعماه ولكن حزنت من","قصوري بحق الشكر في فضل سيدي",34,"د",2,0],["سُررت بذي العلياءِ قبل وفودها","فقد كلفت قبل الزيارة والوفدِ",35,"د",1,0],["سُرِرنَا بِهِ حَتَّى ظَنَنَّا بِأنَّه","أَتانَا مِنَ الرَّحمنِ فِي يَدِنا اليُمنَى",36,"ن",2,1],["سررت بني العلى إن شاب منهم","شباب علم الفخر البنينا",37,"ن",2,0],["سررنا بيوم عدت فيه موفقا","لسعي مجيد نجمه غير آفل",38,"ل",1,0],["سررنا ولا كسرور الحسين","سرور لنفس وان كان عيدا",39,"د",2,0],["سُرِرْتُ بمَسْراهُ وباتَ على النَّوى","قريباً به منِّي مَزارُ الأحبَّاءِ",40,"ا",2,0],["سُرِرْتُمْ كما سُرَّ العَبِيدُ بِسَيِّدٍ","تُزَفُّ إليهِ بَضَّةُ الفَتَياتِ",41,"ت",1,0],["سررتَ علياً والنبيَّ وفاطما","بذاك وموسى والجوادَ محمدا",42,"د",2,0],["سررُ المعالي استبشرت بقدومهِ","وزهت معاطفها به تتأودُ",43,"د",1,0],["سررتم فَإِنِّي بعدكم غير مسرور","وَكم لي على الأطلاق وَقْفَة مهجور",44,"ر",1,1],["سررت فيك أيامي قبل تلبيتي","إلى المنايا وقد حاولنني طلبا",45,"ب",2,0],["سررت يوماً بشعري والسرور به","أمضى الوسائل في إدراك مقصودي",46,"د",2,0],["سر رويداً بمن حملت فلو أد","ركت معناه لم تسر غير وان",47,"ن",1,0],["سُرِرتُ فَبَينَ مَن كَانُوا","صَدِيقِي أسعَدُ الأنوَر",48,"ر",1,0],["سُرُرتِ بِهِمْ أنْ آنَسُوكِ وسَاءَني","مَحَارِيبُ مِنْهُمْ أَوْحَشَتْ ومَسَاجِدُ",49,"د",1,0],["سُرِرْتُ بِأَشْتَاتِ المُنَى إِذْ تَأَلَّفَتْ","وَلَكِنَّهَا مِنْ شِقْوَتِي ذَهَبَتْ سُدَى",50,"د",2,0]]}