{"poems":[[44,"لست مستبقيا أخا لك لا","https://www.aldiwan.net/poem50259.html","المنسرح"],[49,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[18,"كليب لا خير في الدنيا ومن فيها","https://www.aldiwan.net/poem23920.html","البسيط"],[33,"قف بالديار عفا من أهلها الأثر","https://www.aldiwan.net/poem42547.html","البسيط"],[50,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[52,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[302,"لله ما أحلى وصال الملاح","https://www.aldiwan.net/poem33298.html","السريع"],[369,"أصون سمعك عن شكواي إجلالا","https://www.aldiwan.net/poem60797.html","البسيط"],[447,"أنا الغريب فلولا المجد والحسب","https://www.aldiwan.net/poem14420.html","البسيط"],[510,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[519,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[534,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[543,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[572,"من تراه ينصفني من خليل","https://www.aldiwan.net/poem69533.html","الخفيف"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44953","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26470","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77404","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91209","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216693","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119681","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81930","الكامل"],[5277,"شيء من التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=191291",""],[5431,"هو في النهاية واقعٌ لايملصُ","https://www.poetsgate.com/ViewPoem.aspx?id=198801",""],[709,"ويا وميضَ بروقِ المزنِ إنْ سفرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=2956",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5687,"خيبة صغرى","https://www.poetsgate.com/ViewPoem.aspx?id=208139",""],[572,"من ترى ينصفُني من خَليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9428&r=&rc=285",""]],"verses":[["لا أًصحَبُ الخائنَ اللَئيمَ وَلا","أَقطَعُ وَصلَ الخَليلَ مِن مللِه",0,"ل",2,0],["لا أَصحَبُ الخَوفَ وَلا أُرافِقُه","وَالمَوتُ حَتمٌ كُلُّ حَيٍّ ذائِقُه",1,"ق",2,0],["لا أصاب الرَّدى جوادَك يا ربْ","عُ ولا فاجَأَ الحمامُ نجيدَكْ",2,"ك",1,0],["لا أصْلَ ديوانها وَلِيتَ ولا","كُنْتَ كمن زَمَّ أو كمنْ خطما",3,"م",2,0],["لا أَصلَحَ اللَهُ مِنّا مَن يُصالِحُكُم","ما لاحَتِ الشَمسُ في أَعلى مَجاريها",4,"ي",3,0],["لا أَصرِفُ الدَهرَ وُدّي عَنكِ أَمنَحُهُ","أُخرى أُواصِلُها ما أَورَقَ الشَجَرُ",5,"ر",1,0],["لا أصحبَ اللَه فتيةً طربوا","إلى ذواتِ الثديّ والحبَل",6,"ل",1,0],["لا أَصطَفي أَبَداً سِواكِ خَليلَةً","فَثِقي بِذَلِكَ وَالكِرامُ ثِقاتُ",7,"ت",1,0],["لا اصطفاقَ الغصونِ لا هَذرَ الطي","رِ ولا أنَّةَ النميرِ الصافي",8,"ف",2,0],["لا أصحب الندم الممض لفقدهم","فندامة الإنسان في أن يندما",9,"م",2,0],["لا أَصلح اللَهُ عدوّاً لحا","عَلى الهَوى لَمّا رأى الوصلَ لاح",10,"ح",1,0],["لا أصبحَ المجدُ من بالي ومن أربَى","إن كنتُ عنكَ بسَيْري ناعِماً بالا",11,"ل",2,0],["لا أَصطفي من بني الأَيام غير صَفٍ","ولست أَرضى بدوني حيث أَصطحب",12,"ب",1,0],["لا أصْلح اللهُ حال ثلّةٍ تلدُ","في كل حين أجيراً إرثهُ بلدُ",13,"د",1,1],["لا أصْلح الله ثلّة هي السّندُ","لتلك في جُرمها المشهود والمَدَدُ",13,"د",1,0],["لا أصلح الله حال فتية سمعوا","إن يَلْكمُ النومُ لكمةً بها خمدوا",13,"د",3,0],["لا أصبح الليلُ من فَودَيهِ ما بزَغَتْ","شمسُ المُدامة بالآصالِ والبُكَرِ",14,"ر",1,0],["لاَ أَصْطَفِي جَلِيسا","لا أَرْتَضِي أَنِيسا",15,"س",2,0],["لا أَصطَفيه مُخَاطَباً","وأسَرُّ إنعنِّي انحَجَب",16,"ب",1,0],["لاَ أَصُدُّ مُتَّهِمَاً لِلصَّدِيْقِ","أُسْرَتِي وَأُسْرَتُهُ مِنْ قَبِيْلِ",17,"ل",1,0],["لا أَصطَفي فيها مَقالَة مالِك","وَيَسُرُّني ما قالَ فيها ضَرار",18,"ر",1,0],["لا أَصبَحَت بِالخَيرِ عَينٌ أَبصَرَت","تِلكَ المَناخِرَ وَالثَنايا السودا",19,"د",2,0],["لا أَصبَحَ الفَوزُ بِالبِليَردِ يُقنِعنا","وَلا التَغَلُّبُ بِالشِطرَنجِ يَكفينا",20,"ن",2,0],["لا أَصطفي غير العَزيزِ منالُه","رَأياً وَلا تَرضى العِدا فَتكاتي",21,"ت",2,0],["لا أصابت عصا لئيم قفاه","أو ثوى في الطريق ليلَ صباحا",22,"ح",2,0],["لا أصرِمُ العهدَ والهنديّ يصرمني","فالصرم للعهد عندي أقبح العار",23,"ر",1,0],["لا أصله سهل لمدركه ولا","نسر السماء إلى ذراه بطائر",24,"ر",1,0],["لا أصطفيكَ حبيبةً كحبيبتي","إذ فيك تجتمع الحسانُ بنفسِها",25,"س",3,0],["لا أصلَ إلا أنّه متقنّعٌ","بشخوصه حسب الهوى يتقمصُ",26,"ص",1,0],["لاَ أًصْبَحَ اللَّيْلُ مِنْ فَوْدَيهِ مَا بَزَغَتْ","شمسُ المجامة ِ باآصالِ والبكرِ",27,"ر",1,0],["لا أصْلَ، لا أرضَ، لا تاريخَ ظلَّ لهُ","هُم مَزَّقُوا مِثلَما شاءوا، وَهُم رَتَقُوا",28,"ق",3,0],["لا أصطفي المحظور لو جسني..","مهما حلا وعم حسنا وخص..",29,"ص",1,0],["لا أصدُّ منهمُ للصّديقِ","أسرتي وأسرتُهُ من قبيلِ",30,"ل",1,0]]}