ViewPoem.aspx?id=20779",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[231,"الجبار العاجز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79148&r=&rc=22",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""],[463,"سلْ أبرقَ الحنَّانِ واحبسْ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60166&r=&rc=222",""],[463,"دعاها معقَّلة ً بالعراقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60165&r=&rc=221",""],[6262,"وَشْمٌ ثالث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80123&r=&rc=21",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""],[147,"لاَ زِلْتَ تَعْلُو وَإِنْ حُسَّادُكَ اكْتَأَبُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27443&r=&rc=10",""]],"verses":[["تُسَمَّحُ عِطفَهُ بَعدَ اِجتِنابٍ","وَتَخطِمُ أَنفَهُ بَعدَ اِمتِناعِ",0,"ع",1,0],["تَسَمَّعتُ وَاستَوضَحتُ ثُمَّ استَجَزتُهُ","بِأَبيَضَ مَلحوبٍ قَواءٍ مَنازِلُه",1,"ل",2,0],["تَسمَعُ لِلحَليِ وَسواساً إِذا اِنصَرَفَت","كَما اِستَعانَ بِريحٍ عِشرِقٌ زَجِلُ",2,"ل",1,0],["تَسمَعُ الرَعدَ في المَخيلَةِ مِنها","مِثلَ هَزمِ القُرومِ في الأَشوالِ",3,"ل",1,0],["تَسمَعُ في تَيهائِهِ الأَفلالِ","عَنِ اليَمينِ وَعَنِ الشِمالِ",4,"ل",1,0],["تُسَمَّى اِمُرؤُ القَيسِ اِبنَ سَعدٍ إِذا اِعَتزَت","وَتأَبى السِبالُ الصُهبُ وَالآنُفُ الحُمرُ",5,"ر",1,0],["تَسمو تَميمٌ بِسامٍ ذي مُراهَنَةٍ","عِندَ المُواطِنِ سَبّاقِ الأَضاميمِ",6,"م",1,0],["تَسمَعُ الرَعدَ في المَخيلَةِ مِنها","كَهَديرِ القُرومِ في الأَشوالِ",7,"ل",1,1],["تَسَمَّع في بُيوتِ بَني كِلابٍ","بَني البَنا تَنوحُ عَلى تَميمِ",8,"م",1,1],["تُسمَّى عطايا الشعرِ جائزةً له","وأنتَ تسميها بفضلك واجبه",9,"ه",1,0],["تَسَمَّع للمنازل ما تقولُ","لأمرٍ ما تكلمتِ الطلولُ",10,"ل",1,1],["تَسمَّيْتُمُ فينا ملوكاً وأنْتُمُ","عبيدٌ لما تحوي بطونُ المزاودِ",11,"د",1,0],["تسمع الشعر مُعْمِلاً فيه تهوِي","نك صَفْحاً وفي الندى تشديدَكْ",12,"ك",1,0],["تسمو لأقرانها مبارِزةً","لا من وراء الستور والحُجَرِ",13,"ر",1,0],["تسمَّعْ أحاديثَها صاحياً","فإنك من حُمقٍ مُنْتَش",14,"ش",1,0],["تُسمعانِ الأصمَّ صوتين شتَّى","هي في نخرةٍ وأنت تغطُّ",15,"ط",1,0],["تَسْمُو الرِّجالُ بآباءٍ وآونةً","تسمو الرجالُ بأبناءٍ وتزدان",16,"ن",1,0],["تَسمو كَأَنَّ شَراراً بَينَ أَذرُعِها","مِن ناسِفِ المَروِ مَرضوحٌ وَمَنجولُ",17,"ل",1,0],["تَسمو العُيونُ إِلى عَزيزٍ بابُهُ","مُعطى المَهابَةِ نافِعٍ ضَرّارِ",18,"ر",1,0],["تَسمَعُ طَوراً لَهُ خَريراً","وَتارَةً في الزَرى دَبيبا",19,"ب",2,0],["تسمَّعت إحداهن وهي حليلة","له تتلوى بالاسى وتقول",20,"ل",1,0],["تُسَمَّرُ في رَأسِ القِلاعِ كُراتُها","وَيَسكُنُ أَعجازَ الحُصونِ المُذَنَّبُ",21,"ب",1,0],["تُسمِعُ الأَرضُ قَيصَراً حينَ تَدعو","وَعَقيمٌ مِن أَهلِ مِصرَ الدُعاءُ",22,"ا",2,0],["تَسمو إِلى حِلَلِ العَلياءِ أَنفُسُهُم","كَأَنَّ أَنفُسَهُم يَطلُبنَ أَوطانا",23,"ن",2,0],["تَسمو بَواذِخُ ما يَبنونَ مِن شَرَفٍ","كَما سَما الهَضبُ مِن ثَهلانَ أَو حَضَنِ",24,"ن",1,0],["تَسمو إِلى الرُتبَةِ العُليا مَحاسِنُهُ","فَما تَرى وَسَطاً مِنها وَلا دونا",25,"ن",2,0],["تَسَمَّع وَأَنصِت يا يَزيدُ مَقالَتي","وَهَل أَنتَ إِن أَفهَمتُكَ الحَقَّ فاهِمُه",26,"م",2,0],["تَسِمُ الفارِسَ المُقَدَّمَ بالعا","رِ وبعضُ الإقدامِ عارٌ باقي",27,"ق",2,0],["تَسمَعُ لِلجِنِّ عازِفينَ بِها","تَضبَحُ مِن رَهبَةٍ ثَعالِبُها",28,"ب",3,0],["تَسَمَّع مِنَ الأَيامِ إِن كُنتَ سامِعاً","فَإِنَّكَ فيها بَينَ ناهٍ وَآمِرِ",29,"ر",1,0],["تَسَمَّع وَدَع مَن أَغلَقَ الغَيُّ سَمعَهُ","كَأَنّي بِداعٍ قَد أَتى فَدَعاكا",30,"ك",2,0],["تَسمو بِهِمَّتِكَ اِبنَ أُرتُقَ هِمَّةٌ","حَفَّت بِأَلوِيَةٍ مِنَ العَزَماتِ",31,"ت",1,0],["تسمع الشعر وشعري منك لك","وبالهامك أبدعتُ الرويّ",32,"ي",1,0],["تَسِمُ الْعُيُونَ بِنُورِهَا لَكِنَّهَا","بَرْدٌ عَلَى شُرَّابِهَا وَسَلامُ",33,"م",1,0],["تَسُمُ الْعُيُونَ بِنَارِهَا لَكِنَّهَا","بَرْدٌ عَلَى شُرَّابِهَا وَسَلامُ",34,"م",1,0],["تَسمو الشُّعوبُ بكلِّ حرٍّ ماجدٍ","وجَبتْ عليه حقوقُها فقضاها",35,"ا",3,0],["تَسَمّى مُدِلّاً بِأَفعالِهِ","وَساعَدَهُ الجَدُّ فَاِستَرسَلا",36,"ل",2,0],["تَسْمو به العَينُ الطَّموحُ إلى التي","تَفنى الرِّقابُ بها ويَفْنى النائل",37,"ل",1,0],["تَسَمّى رَشيداً مِن لُؤَيِّ بنِ غالِبٍ","أَميرٌ وَهَل في العالَمينَ رَشيدُ",38,"د",1,1],["تَسَمّى سُروراً جاهِلٌ مُتَخَرِّصٌ","بِفيهِ البَرى هَل في الزَمانِ سُرورُ",39,"ر",1,1],["تَسَمَّت رِجالٌ بِالمُلوكِ سَفاهَةً","وَلا مُلكَ إِلّا لِلَّذي خَلَقَ المُلكا",40,"ك",2,1],["تَسْمو بما قُلّدَتْهُ من أعِنّتِها","مُنِيفَةً كصَوادي يَثرِبَ السُّحُقِ",41,"ق",1,0],["تسمى زليخاً وَهيَ شمطاءُ فظةٌ","من الناس طراً بالقَساوة تذكر",42,"ر",1,0],["تسمع الأمهات وَهي إليها","مسرعات بغامها فَتُجيب",43,"ب",1,0],["تسمو بها الأرواحْ","عَن عالم الإِثمِ",44,"م",1,0],["تسمَّعن صوتكِ تحت الظلام","فجُبنَ الثرى وطوين الفضاءْ",45,"ا",2,0],["تسمُّحٌ للعرب القروم","لم يُلفَ في الفرس ولا في الروم",46,"م",1,0],["تُسْمِعُ النَّفْسَ في هدوء الأماني","رَنّةَ الحَقِّ والجمال الخَلوبِ",47,"ب",1,0],["تَسْمَعُ لِلْبَلْعِ نَقِيقاً كَمَا","نَقَّتْ ضَفَادِي لَيْلَةٍ رَاكِدَهْ",48,"د",2,0],["تَسْمُو فَيَتْبَعُهَا فَتَهْوِي وَهْوَ فِي","آثَارِهَا مَرَّ الشِّهَابِ حِرَاقُ",49,"ق",1,0],["تَسِمُ الظَّلامَ ذُبَالَتَانِ بِرَأْسِهِ","تَقِدَان لَيْسَ عَلَيْهِمَا أَطْبَاقُ",49,"ق",1,0],["تَسَمَّعُ مِنْهَا النفْسُ حِسّاً يَشُوقهَا","شَجِيّاً كَتَرْجِيعِ الهَزَارِ المُغَرِّدِ",50,"د",1,0],["تَسْمُو بِرَأْيِكَ رَائِداً","فِي كُلِّ مَحْمَدَةٍ مَرَادَكْ",51,"ك",1,0],["تَسْمعُ الْحُبَّ في نَواحِيهِ هَمْساً","يتَناجَى ويَشْتَكي أشْجَانَه",52,"ن",2,0],["تُسمَّى خَلائقَ محمودةً","ويُدعَ ى أبا الخُلُقِ الأطيب!",53,"ب",1,0],["تسمع طورا له خريرا","وتارة في الثرى دبيبا",54,"ب",2,0],["تسمو إلى أفقه القدسيّ طاهرة","طهر الدّموع تسابيحي وألحاني",55,"ن",2,0],["تَسَمَّينَ يَا حَسْنَاءُ قَالَتْ تَحَبُّباً","أَنَا اسْمِيَ لَيْلَى هَلْ تَرَى اسْمِيَ مُعْجِبَا",56,"ب",2,0],["تَسْمَعُ لِلْبَلْعِ نَقِيقاً، كَمَا","نقَّت ضَفاى ِ ليلة ٍ راكِدَه",57,"د",2,0],["تَسمَع القَول كَالجُمان وَتَشمم","عَبيراً وَتَنظرنَ حِسانا",58,"ن",2,0],["تسمعُ النجوى وإن خفيت","وهي ليست تسمع العُذلا",59,"ل",2,0],["تَسمَعُ البُومُ وَهوَ يَنأَمُ وهناً","ونَئِيمُ الصَّدَى يُجِيبُ البُومَا",60,"م",2,0],["تَسمو الإِمارَةُ إِذ تُعذى إِلَيكَ كَما","تَسمو تَميمُ بنُ مُرٍّ حينَ تَنتَسِبُ",61,"ب",1,0],["تسمعُ للماءِ نشيشاً إِذا","ما وصل الماءُ إِلى قَلبي",62,"ب",2,0],["تسمو إلى مرمي الفخار همومه","فهو البعيد مطارح الآلاءِ",63,"ا",2,0],["تَسمّى جَمالَ الدينِ مع قبحِ فعلهِ","كَما وَضعوا لفظَ المفازَةِ للصَحرا",64,"ر",2,0],["تَسمَعُ لِلرِّيح اِذا اصمَعَدّا","بَينَ الخُطَى مشنهُ ما ارقَدّا",65,"د",2,0],["تَسمو العُيون إِلَيهِ حين يرَينَه","كَالبَدرِ فَرَّجَ طَخيَةَ الظَلماءِ",66,"ا",2,0],["تَسَمّى بأسماء الإخاء معاشرٌ","وما عندهم من ذمَّةٍ لإخاءِ",67,"ا",2,0],["تَسمو بِهِ نَفسٌ لَهُ مَطبوعَةٌ","كَرَماً وَآباءٌ لَهُ أَجوادُ",68,"د",1,0],["تسمى بالشهور فكل سمع","له رجب وأيديه جمادي",69,"د",2,0],["تَسَمَّى بلَفظٍ لِلْحَيَاةِ ولِلْحَيَا","فَيَا شَرَفَ اسْمٍ منْهُما صِيغَ واشْتُقَّا",70,"ق",2,0],["تَسْمُو بِأَخْمَصِهِ الْمَنابِرُ واطِئاً","وَتَتِيهُ إِنْ رُقِيَتْ بِها خُطَباؤُهُ",71,"ا",3,0],["تسمو تلمسان افتخاراً ولتعش","فاس اذا ما أمها هذا الأديب",72,"ب",1,0],["تَسمو بجدٍّ لا يزال عنانهُ","في كفّ جدّ بالنجاح مختّمِ",73,"م",1,0],["تسمو إلى درك الحقائق همتي","فأصد عن إدراكهن وأعزل",74,"ل",1,0],["تسمو بجيدٍ بالغ صعداً","شرف الصروح بغير ما جهد",75,"د",1,0],["تَسمو بِأَتلَعَ مِثلِ الجِذعِ يَقدُمُها","عَرفاءُ غَرباءُ في حَيزومِها جَوَفُ",76,"ف",1,0],["تسمنون الذئب السمين ليس","تشري على الشاة فيه داء الصراع",77,"ع",1,0],["تَسمو عَلى الجَوزاء رفعة قَدرِهِ","شَرَفاً كَما يَنحطّ قَدر حَسودهِ",78,"د",2,0],["تُسمّي الشّمسُ من حَسدٍ سناها","بعَيْنٍ أو بحاجبٍ اخْتِلاقا",79,"ق",2,0],["تَسمَحُ بالحَظِّ لطُلابه","فكيف لا تَسمَحُ بالخَطِّ",80,"ط",1,0],["تُسمى الرِماحُ قَناً فَأَمّا بَعدَما","صارَت بِكَفِّكَ فَالرِماحُ عَوالِ",81,"ل",1,0],["تسمعُ منه أُذُني ضِدَّ ما","تَراهُ من أفعالِه عَيني",82,"ن",2,0],["تَسمُ السماءَ نظيرَه","في عزةٍ متساميه",83,"ي",2,0],["تَسمَعُ تَعزافاً لَهُ رَنَّةٌ","في باطِنِ الوادي وَفي القَردَدِ",84,"د",1,0],["تَسمو إِلى كَبِدِ السَماءِ كَأَنَّها","تَبغي هُناكَ دِفاعَ كربٍ مُعضِل",85,"ل",1,0],["تسمو به نَفسٌ عِصَا","مِيَةٌ إلى أعلَى المراتب