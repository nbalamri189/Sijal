i.ae/diwan/poem/120520","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52142","المتقارب"],[416,"حَمدْنَا الذي أدَّى ابنُ يَحْيَى فأصْبَحَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=22334",""],[557,"بين العمر والأماني","https://www.poetsgate.com/ViewPoem.aspx?id=15725",""],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5010,"إذا مات الأمل تسلطت الخيبات","https://www.poetsgate.com/ViewPoem.aspx?id=190465",""],[5111,"سَبْكُ الحُروفِ","https://www.poetsgate.com/ViewPoem.aspx?id=212327",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5881,"مَرَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=183813",""],[5976,"احساسي .. وجرّة لحوني","https://www.poetsgate.com/ViewPoem.aspx?id=34994",""],[6144,"مدارسنا ومدارسهم","https://www.poetsgate.com/ViewPoem.aspx?id=21675",""],[6177,"الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""]],"verses":[["وَأَجدَبَ القَومُ وَاِضطُرَّت أَكُفُّهُمُ","وَإِن تَطَهَّرنَ مِن إِثمٍ إِلى الزَلَمِ",0,"م",1,0],["وَأَجدَرُ الناسِ أَن تَعنوا الرِقابُ لَهُ","مَنِ اِستَرَقَّ رِقابَ الناسِ بِالنِعَمِ",1,"م",1,0],["وَأَجدَرَ إِن نابَهُ نائِبٌ","بِرَدِّ الأُمورِ إِلى الآمِرِ",2,"ر",1,0],["وأجْدادُهُ ممّنْ رَعاهُنَّ سِتّةٌ","تَطيبُ بِهمْ أعْراقُهُ والمَغارِسُ",3,"س",1,0],["وَأَجدَرَنا أَن يَنفُخَ الكيرَ خالُهُ","يَصوغُ القُروطَ وَالشُنوفَ بِيَثرِبا",4,"ب",2,0],["وأَجدرُ من تبكي عليه يراعةٌ","بصفحة طِرسٍ والمدادُ نجيعُها",5,"ع",3,0],["وَأَجدَرَ إِن تَجاسَرَ ثُمَّ نادى","بِدَعوى يالَ خِندِفَ أَن يُجابا",6,"ب",2,0],["وأجدى من التعنيف حسنُ معونةٍ","برأيٍ ولينٍ من خطابِ المخاطبِ",7,"ب",1,0],["وأجْدَى وأنْدَى بطْنَ كَفٍّ من الحَيَا","وآبى إباءً من صَفاةٍ وأجْمَدُ",8,"د",1,0],["وأجدِرْ باحتراقكْ حين تعشو","إلى نارٍ وأبْعِدْ باقتباسك",9,"ك",1,0],["وأجدى على السلطان في ذاك أنه","يريدُ بها كيف اتقاء الغوائلِ",10,"ل",1,0],["وأجدبتِ الأرضُ التي كنتِ روضةً","عليها وأبدتْ مَكْلحاً بعد مُبْتَسَمْ",11,"م",1,0],["وأجدَّ أعلامَ الهُدَى","بعد الخُلوقةِ والطُّسوم",12,"م",1,0],["وَأَجدَرُ الدورِ أَن تُسقى بِساكِنِها","دارٌ غَدا الناسُ يَستَسقونَ أَهليها",13,"ي",3,0],["واجِدٌ تَحتَ أَخمَصَيهِ الَّتي يَر","مي إِلَيها هَمُّ المُسامي وَيَجري",14,"ر",2,0],["واجِدٌ غايَةَ صَدرٍ مِن جَوىً","ناشِدٌ بُلغَةَ عَينٍ مِن وَسَن",15,"ن",1,0],["واجِداتُ القِرى بِقَتلى الأَعادي","مِن حَشاها لَدى النشورِ نُشورُ",16,"ر",1,0],["واجِداً بِالخَليجِ ما لَم يَجِد قَطُّ","بِما شانَ لا وَلا بِالرَزيقِ",17,"ق",1,0],["واجِدٌ بِالخَليلِ مِن بُرَحاءِ ال","شَوقِ وِجدانَ غَيرِهِ بِالحَبيبِ",18,"ب",1,0],["وَأَجَدَّ الشَوقَ وَهناً","إِذ رَأى بَرقاً وَميضا",19,"ض",2,0],["وَأَجِدُّ ثُمَّ أَقولُ في","أَدنى مُهازَلَةِ المُهازِل",20,"ل",1,0],["وَأَجَدَّ إِذ زَنَأَ الزَمانُ تَوَسُّعاً","في رَوحَةٍ وضأَعَزَّ ذِمَةَ جارِ",21,"ر",1,0],["واجِداً مِن غَيرِ وَجدٍ","لاوِياً خَطماً وَشِدقا",22,"ق",2,0],["وَأَجدَبَ مِن ثَورِ زِرّاعَةٍ","أَصابَ عَلى جوعِهِ سُنبُلا",23,"ل",2,0],["وَاَجدُ عَلى مَولاكَ في الفَقرِ وَالغِنى","وَلا تَقرِبِ الخُلقَ الَّذي أَنتَ عائِبُه",24,"ه",1,1],["وَأَجدَرَ أَلاّ يَقصُرُوا عَن كَرامةٍ","ثَوِيّاً وَإِن كانَ الإِقامَةُ أَشهُرا",25,"ر",2,0],["وَأَجدَرَ أَلاّ يَترُكُوا عانِياً لَهُم","فيَغُبرَ حَولاً في الحَدِيدِ مُكَفَّرا",25,"ر",2,0],["وَأَجدرَ أَن لاَ يَترُكُوا عَانِياً لَهُم","فَيَغبُرُ حَولاً في الحَديدِ مُكفَّرا",26,"ر",2,0],["وَأَجدَرَ أَن لاَ يَترُكُوا مِن كَرَامةٍ","ثوِبّاً وَإِن كانَ الثوايَةُ أغضرا",26,"ر",2,0],["واجِداً منذُ جَفا بُرْقُعُهَا","ناظِري من قَلْبِهِ في القَلْبِ كَي",27,"ي",1,0],["وأَجْدَرَ مِنَّا أَن تَبِيتَ نِسَاؤُهُمْ","نِيَاماً إِذَا داعي المَخَافَةِ نَدَّدَا",28,"د",2,0],["وَأَجَدَّ هَذَا الحَوْلُ إِلْفاً بَيْنَهُمْ","هُوَ عَوْدُ ذَاكَ البَدْءِ مِنْ أَحْوَالِ",29,"ل",1,0],["وأجدرْ بأن يشتاق مثلُك مثلها","وأنعِمْ بأن تحنو عليها وأخلِق",30,"ق",1,0],["وَاجدُ القَصْدِ، طرْفُهُ في ارْتِفاعٍ","مِنْ سُمُوٍّ، وكَفُّهُ في انصِبابِ",31,"ب",1,0],["وَاجِداً غَايَةَ صَدْرٍ مِنْ جَوًىº","ناشِداً بُلغَةَ عَيْنٍ مِنْ وَسَنْ",32,"ن",1,0],["وأجدَّ في دعة ٍ، وأبعدَ غاية ً","في روحة ٍ، وأعزَّ ذمَّة َ جارِ",33,"ر",1,0],["وأجدَّ الشوقّ وهناً،","أَنْ رَأَى وَجْهاً وَميضا",34,"ض",2,0],["واجداده آل البتول ايمة ال","برية اقمار الهدى الخلص الطهر",35,"ر",1,0],["وَأَجدَبَتِ البِلادُ فَكُنَّ غُبراً","وَعادَ القَطرُ مَنزوراً قَليلا",36,"ل",2,0],["وَأَجدَرَ أَن تَكونَ لَدَيهِ مَلكاً","يُريكَ جَلادَةً وَيُسِرُّ وَجداً",37,"د",2,0],["وأجدر بالتأميل في كل معضل","بنو الدين والراجون حسن العواقب",38,"ب",1,0],["وأجدت عمّته بطين لازب","وهجرته والهجر فيه كريم",39,"م",1,0],["واجدمعوا شذ كذا أجدزوما","أتى كفزد دولج فلتعلما",40,"م",2,0],["وَأَجْدِرْ بِمَنْ أَمَّ مَثْوَاكَ أَنْ","يَنَالَ مُنَاهُ وَلَمْ يُغْتَبَنْ",41,"ن",1,0],["وَأجْدِرْ بِفَاسٍ أنْ تُرَاجِعَ رُشْدَها","وَقَد رَحَضَتْ مَرَّاكشٌ غَيَّهَا رَحْضا",42,"ض",2,0],["وَأَجدَرُ أَن تَقولَ فَلا تُمارى","أَنا اِبنُ جَلا وَطَلاعُ الثَنايا",43,"ا",3,0],["وأجد ليلي في امتراء قريحتي","وتعود غوراً بينما تسترسل",44,"ل",1,0],["وَأَجَدَّ في جَسَدي ضَنّاً","قَد كانَ أَخلَقَهُ البِعاد",45,"د",1,0],["وَأَجَدَّ لي وَجداً جَعَلتُ عَهادَهُ","دَمعاً بِمَعهَدِ جَمعِنا مُتَفَرِّقا",46,"ق",2,0],["وَاِجدُد إِلى الجَدِّ وَاِترُك دونَهُ العَبَثا","تَفُز بِحَلٍّ وَوَصلٍ غَيرِ مُنبَتِلِ",47,"ل",1,0],["وَأَجَدَّ الوَجدُ لِاِدِّكارِهِ","لِيَ مَنسِيَّ الأَماني بِمُنَي",48,"ي",1,0],["وَأجدل مرقب يُمسي غَراب","يِهدّدهُ بِأَنواع الوَعيد",49,"د",1,0],["وَأَجدى عَلى الأَيتامِ فيهِم بِغُرفِهِ","فَكانَ مِنَ الآباءِ أَحنى وَأَعوَدا",50,"د",2,0],["وأَجدادُكم شُفَعاء العُصاةِ","بيوم به ناره تسعرُ",51,"ر",1,0],["وأجدّت له الرياض ثناءً","ما على طيب عَرْفه من مزيد",52,"د",1,0],["وأجدب ربْعي بالخطوب فلم اُبلْ","وكفُّكَ رجَّافُ العَشيِّ هَطولُ",53,"ل",1,0],["وأجدر من نال منك الرِّضى","محبُ ذُراكَ على البُعد زارا",54,"ر",2,0],["وَاِجدَعْ أُنوفاً رَغَمَتْ","من كلّ ذي أنفٍ رَغَمْ",55,"م",1,0],["وأجِد لي رزْقَاً وإِخ","واناً ومنزلةً وعمراً",56,"ر",2,0],["وَأَجدَرَ بِقومٍ أَمطَرَتهُم هِباتُها","بِأَن يَأمَلوا اِنفِراجَ المَآزِمِ",57,"م",1,0],["وَأَجدَبَ بَعدَ الخَصبِ إِذ كانَ زاهِراً","بِكُلِّ كِتابٍ لِلفَوائِدِ واسِقِ",58,"ق",1,0],["وَاجدعوا أَنفَ الممانعْ","فَالخديويُّ السَعيدُ",59,"د",1,0],["واجداً منكَ متَى اسْتَصْ","رَخَ لِلْمَجدِ صَريخا",60,"خ",2,0],["وَأَجد الراحة وَالسَماحَه","وَالزُهد لا شَكَ شَريك الراحَه",61,"ه",1,0],["وَاجِدٌ بِالْعُلُومِ وجْدَ مُحِبٍّ","رَاعَهُ مَنْ يُحِبُّ بِالإِعْرَاضِ",62,"ض",1,0],["واجدع بعضبك آنافاً شمخن على","عداك من جهل مفتون بها خطل",63,"ل",1,0],["وَأَجدِر بمشتَاقٍ أَلُوفٍ تَقاذَفَت","بِهِ عَن دِيارِ الأَكرَمِينَ المَطاوِحُ",64,"ح",1,0],["وأجد السرى وأصى بسمعي","لحداه ترجع الأخبارا",65,"ر",2,0],["وَأَجدِر بِهِندٍ أن تُسَاقَ سَبسَّةُ","لَهَا مِن بَنشى إسحَاقَ شَرُّ حَلِيلِ",66,"ل",1,0],["واجد حداك فان فيه راحة","للعيس مع رى الفواد الصادي",67,"د",2,0],["واجد أنت هدى أو قبساً","لا تجاوز أن هذا الليل عسعس",68,"س",1,0],["واجدَةٌ عندهُ عشيرتُهُ","من سَعةِ البّر ما يُرْغِّبُها",69,"ب",3,0],["وأجدُّ من رسمِ المكارمِ","ما شكت قومٌ عُفوَّه",70,"و",2,0],["واجدٌ ماجدٌ حليمٌ كريمٌ","ترقب الخلقَ عينهُ كل آنِ",71,"ن",1,0],["وَأَجَدَّ لي كَلفاً وَبَرحَ صَبابَةٍ","وَأَعادَ مِن شَغَفِ الهَوى ما قَد مَضى",72,"ض",2,0],["وَأَجَدُّ بِالظَّرِبِ الهُمامِ وَبِابنِه","تَركُ الفَوارِسِ تَجفَئِظُّ وَتَألَمُ",73,"م",1,0],["وأجدر خلق الله بالصفح، حسّد","لما وهب الرحمن من بركات",74,"ت",1,0],["وَأِجدادُ صدقٍ لا يُعابُ فَعالُهُم","هُمُ النَضَدُ السِرُّ الغَطارِفَةَ الشمُّ",75,"م",1,0],["واجداً منها بديلاً مثل ما","وجدَت مني بديلاً لا تشُك",76,"ك",1,0],["وأجدّ للآداب عمر شبابها","غضا وقد وصلت لسنّ الياس",77,"س",1,0],["وأجدعُ أنْفي وهو موضعُ نخوتي","وأقطعُ كفي عامداً ببناني",78,"ن",2,0],["وأجداث بطيبة طيبات","لعنزة أحمد الغر الكرام",79,"م",1,0],["واجدر الناس فخراً بالحياة فتى","سما به للمعالي الفضل والادب",80,"ب",1,0],["واجد مغرم وصب ولوع","واجب القلب والحشاشة مغرى",81,"ر",2,0],["واجدُّ فيه لبغيتي","متطلِّبا والجد عاثر",82,"ر",1,0],["وأجدر أن يساق مصاب حمى","لمارستان لا مستشفيات",83,"ت",1,0],["وأجدرهم بتسلية ورفق","وأولاهم بأحسن وجود",84,"د",1,0],["وَأَجِدُّ كُلَّ الجِدِّ في إِرضائِهِ","فَعَساهُ يُخلِدُ لِلوَفا وَيُنيبُ",85,"ب",1,0],["وأَجْدَى الوَسائِل صَوْغُ الثَّناءِ","عَلَيْهِ اعتِمادِي وَفيهِ اعْتِمَالِي",86,"ل",2,0],["وأجَدَرُ من أشرَكتُمُ في نعيمِكُم","شريكُكُمُ في حادِثاتِ الطَوارِقِ",87,"ق",1,1],["وأجدر الناسِ ان يُراحَ لها","غصنٌ من المجدِ في ذُراك نمَا",88,"م",2,0],["وأَجدر أنْ يُتَاحَ له ثَنَاءٌ","مَصُونٌ غير متبذلٍ مُباحِ",89,"ح",1,0],["وَأجدَلٌ وَأخيَلٌ وَأفعى","مَصرُوفَةٌ وَقَد يَنَلنَ المنعَا",90,"ع",2,0],["وَأَجدَرَنا أَن يَدخُلَ البَيتَ بِاِستِهِ","إِذا القُفُّ دَلّى مِن مَخارِمِهِ رَكبا",91,"ب",2,0],["وأجدر من نال الأماني ساكن","ظهور المذاكي في بطون السمالق",92,"ق",1,0],["وأجدت التشبيب في كل عودٍ","فغدا السرور راقصاً ذا ارتياح",93,"ح",1,0],["واجداً لم أَزل من الله زادا","أنهُ المانح الجميع العطايا",94,"ا",3,0],["وَأُجِدّ في إرضائه بتأدّبي","وَأَراه منهُ جاهلاً يتغيظ",95,"ظ",1,0],["وَأَجدَبتُ لَمّا أَن حَلَلتُ جَنابَهُ","وَإِن كانَ شِرباً لِلعُفاةِ وَمَرتَعا",96,"ع",2,0],["وأجدر منكم بالملامة أمةٌ","تضام ولكن ما لها عزمات",97,"ت",1,0],["وَأَجدَر خَلق اللَهِ بِالعَفوِ وَالرِضا","مُحبٌّ أَتَت مِنهُ الإِساءَة في الفرطِ",98,"ط",1,0],["واجدا في النور طورا وَالظَلام","تارة حبا له النفس تَطير",99,"ر",1,0],["وأجدر أن اصول على زماني","بعزم منك كالخطي لدنا",100,"ن",2,0],["وأجدت التشبيب في كل عود","فغدا السرو راقصا إذا ارتياح",101,"ح",1,0],["وأجد في طلب النجوم وإنها","لعقود در في النحور تنير",102,"ر",1,0],["واجد بالعلا وبالمجد وجداً","لم يجده بيوسف يعقوب",103,"ب",1,0],["وأجدر بشيء إذا ما تبعَّث","من ضيق أن يكون قويا",104,"ي",2,0],["واجدر بمن قد حازها أن تشوقه","وقد لاح منها انجما وتهاويلا",105,"ل",2,0],["وأجدبَ عالي الرُّبى مُقفِرٍ","كثير الفدافد والأنجُدِ",106,"د",1,0],["وأجْدى عَلَى الأيْتَام فيهم بِعْرُفِهِ","فكانَ منَ الآباءِ أحنى وأوداَ",107,"د",2,0],["وأجدب غصن أيكتنا وعاد اليأس يسقيها","عشقنا عطرها نغما فكيف يموت.. شاديها؟",108,"ا",1,0],["واجد الزين عند الحاضره والقبايل","شفت واجد ومرّنى مرور الكرام",109,"م",1,0],["وأجدبَ عيشُ المرءِ من بعد نضرةٍ","وعضّتهُ ذي الدّنيا