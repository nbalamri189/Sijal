{"poems":[[85,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[87,"كان للغربان في العصر مليك","https://www.aldiwan.net/poem8044.html","الرمل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[70,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[102,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[254,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[264,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[287,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[454,"تتجاهلين","https://www.aldiwan.net/poem1012.html",""],[469,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100133","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107216","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95553","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48980","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108468","الرمل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47199","الوافر"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28084","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121175","الطويل"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123756","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205851","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201751","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204818","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118944","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87384","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99380","الوافر"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125938","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91953","المتقارب"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85090","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114276","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111389","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77080","الكامل"],[4000,"","https://poetry.dctabudhabi.ae/diwan/poem/97823","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5956,"أرتين قد بدأ المسير مهللا","https://www.poetsgate.com/ViewPoem.aspx?id=205422",""],[6024,"أنياب المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=186354",""]],"verses":[["فدهريّ عيد بالسرور وبالمنى","وكلّ ليالي العمر لي ليلةُ القدرِ",0,"ر",1,0],["فدهيُهُ للدواهي الرُّبْدِ يَدمغُها","وسَهْوهُ عن عيوب الناس والغِيَبِ",1,"ب",1,0],["فَدَها السُلطانَ ذا الخَطبُ المَهول","وَدَعا خادِمَهُ الغالي يَقول",2,"ل",1,0],["فدَهَى الأَسودَ بنَ مُطَّلِبٍ أَي","يُ عمىً مَيِّتٌ به الأَحياءُ",3,"ا",2,0],["فَدُهِشْتُ بينَ جمالِهِ وجَلالِهِ","وغدا لسانُ الحال عنّي مُخْبِرا",4,"ر",2,0],["فدهاك غزو مثلما","يحكون عن يوم النشور",5,"ر",1,0],["فَدَهِمنَهُم دَهماً بِكُلِّ طِمِرَّةٍ","وَمُقَطِّعٍ حَلَقَ الرِحالَةِ مِرجَمِ",6,"م",1,0],["فدهرك ليس فيه من صلاح","فدارِ فسادَه الساري وساير",7,"ر",1,0],["فَدَهرُنا بِلِسانِ الحالِ قالَ لَنا","بُشرى لِطائِعِهِ وَيلٌ لِعاصيهِ",8,"ي",2,0],["فدهرنا كالحُلم","يمر مر السحب",9,"ب",1,0],["فدهشت لا أدري أحيرة ذاهل","عن نفسه أم بالجمال الباهر",10,"ر",1,0],["فدهريَ جنحٌ لا يرَّجى صباحهُ","وقد كان صبحي في ذراك بلا جنح",11,"ح",1,0],["فدهشت مسلوب الحجا ذاوي الرجا","يوري الجوى بين الضلوع زنادا",12,"د",2,0],["فدُهِشتُ حِينَ سَمِعتُ باهِرَ لَفظِهِ","فَلَقَد أَشاعَ بِمَا طَوَاهُ جَنانِي",13,"ن",2,0],["فدهريّ في لهو وقلبي في عمى","وعمري في نقص وذنبي في نما",14,"م",2,0],["فدهاهم من قوله مادهام","وتنادوا من ذا الرفيع العمادِ",15,"د",1,0],["فدهتهُ الخطوبُ نفياً وقيداً","وهو كالطودِ راسخٌ لا يميلُ",16,"ل",1,0],["فدهاني بسقام","سالب رشدي وصبري",17,"ر",2,0],["فدهرٌ بالحقيقة غير دهر","وناس في الحقيقة غير نَاسِ",18,"س",1,0],["فَدَهماءُ مَرضوضٍ كَأَنَّ عِراضَها","بِها نَضوُ مَحذوفٍ جَميلٍ مَحافِدُه",19,"د",2,0],["فدهم الليالي العاديات مغيرة","وقد اوسعت ايام عسرى مجالها",20,"ل",3,0],["فدهشت من كنز بمبسمها له","قفل من الياقوت والفيروزج",21,"ج",1,0],["فدهاني النعىّ واختطف الآ","مال في لهفة الفؤاد الحنون",22,"ن",1,0],["فدهتْه جذبةٌ من سائق","اوشكتْ تخلع منه الكتفا",23,"ف",2,0],["فدهري رباني رضيعاً وها أنا","سأجزيه من نفسي وأعطيه من حسي",24,"س",2,0],["فدهشتُ من فرحي وقتل نعم نعم","ما كان حبكُم حديثاً يُفتُرى",25,"ر",2,0],["فَدهشت مِن فَرحي بِهِ فَكَأَنني","شاهَدت أَحمَد عِندَ بَذل نَواله",26,"ل",2,0],["فَدَهاكَ منهُ بنادِرٍ من سوءِهِ","لَمّا نَدَرتَ وَكنتَ من أَفرادهِ",27,"د",2,0],["فدهم الخيل في ميدان تبر","يصاغ لها كرات من عقيق",28,"ق",1,0],["فدهرى أمام العزم منى كأنه","غريقوذاك العزم أمواج دأماء",29,"ا",2,0],["فَدهرٌ أَدار بدار الرَدى","وَأَبكت لياليه ضحّاكها",30,"ك",3,0],["فدهشت من حسن بدي","ع مثله لم أجتل",31,"ل",1,0],["فدهشت من ذاك الجمال وحسنه","ووقفت وقفة مولع متحير",32,"ر",1,0],["فَدَهرُكَ فِيمَا قَد يَسُرُّ قَطَعتَهُ","فَلاَ يَنقَطِع فِي الهَمِّ وَالغَمِّ دَهرُك",33,"ك",1,0],["فَدَهَى جَيشَهُ بِشَرِّ وَبَاءٍ","فَغَدَت جُندُهُ تَخِرُّ فُلُولا",34,"ل",2,0],["فَدَهشاً أَطرَقَ وَالجَوبَ عَلى","كاهِلِهِ أَلقى وَعاد وَجِلا",35,"ل",2,0],["فدهاه والبأس ذو لفس لمفس","من بني لومذونٍ القهار",36,"ر",1,0],["فَدَهَشتَ لِما أَن أَمطَت خِمارَها","وَاِستَقبَلَتني زَرقة الإِلعاسِ",37,"س",1,0],["فَدهيتُ بِالنعمانِ أَعظم دهيةٍ","وَرجعتُ مِن بعدِ السميذع أطردُ",38,"د",1,0],["فَدَهرِهِم غرهم جَهلا وَما عَلِموا","اِنَّ الزَمانَ قَريب الاِلتِفاتات",39,"ت",1,0],["فدهرك في دار سواها مسالم","وقدرك مرفوع وشملك محروس",40,"س",1,0],["فَدَهَاهُمْ مَا دَهَاهُمْ","واسْتَحالَ الرِّبْحُ خُسْرا",41,"ر",2,0],["فدهاني دهري بكل خدوع","ورماني حظي بكل مكور",42,"ر",1,0],["فدهاني بما دعاني إليه","ما تعانى، والجد جد مزاح",43,"ح",1,0],["فدهشتُ لمّا أن رأيته واقفاً","قربي وخفتُ، كما سُررتُ كثيرا",44,"ر",2,0],["فدهتهما من حيث لما يشعروا","بحبائل نيطت بأنواع الحيل",45,"ل",1,0]]}