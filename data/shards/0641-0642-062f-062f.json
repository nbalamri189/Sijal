{"poems":[[79,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[119,"ما قام في بيت النبي المجتبي","https://www.aldiwan.net/poem41245.html","عموديه"],[139,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[154,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[173,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[309,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[473,"أيا من يهاب ومن يتقى","https://www.aldiwan.net/poem59813.html","المتقارب"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83334","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122803","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66641","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109189","الطويل"],[1613,"","https://poetry.dctabudhabi.ae/diwan/poem/97578","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108985","البسيط"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100473","السريع"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26246","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137445",""],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107026","المتقارب"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138780",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125861","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83522","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133153","الطويل"],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""]],"verses":[["فَقَدْ دَرَأَتْ حَقَّ الْوَصِيِّ سَفَاهَةً","عَلِيٍّ وَأَعْلَتْ مِنْ قِدَاحِ بَنِي حَرْبِ",0,"ب",1,0],["فقد دالتِ الدنيا لآل محمّدٍ","وقد جرَّرت أذيالَها الدولةُ البِكر",1,"ر",1,0],["فقد دعوناك فكن وسيلة","لجدك الهادي الامين المتجبى",2,"ب",2,0],["فقد دانت العليا إليكَ وأرخت","جميع تهاني البِشْرِ عيدُ محمدِ",3,"د",1,0],["فَقَد دانَ ما بَينَ الأَحابيشِ وَالتُركِ","فَكَم ذي اِرتِباكٍ في الضَلالِ بِهِ هُدى",4,"د",2,0],["فَقَد دُفنت تِلكَ الحقودُ وَأُطفِئَت","لَواقِحُ غلٍّ في الصُّدورِ اِلتهابُها",5,"ب",3,0],["فَقَد دَهى الحُكمَ أَمرٌ لا مَرَدَّ لَهُ","هانَ القَوِيُّ لَهُ وَاِستَأسَدَ الواني",6,"ن",2,0],["فقد دنا سفر لا بد منه إلى","قبرو بعث وحشر الروح والصور",7,"ر",1,0],["فقد دانت الدنيا لربِّ مَحاسنٍ","مَحاسنُ قومٍ آخرين عُيوبُها",8,"ب",3,0],["فَقَد دَهِمَ الفَجرُ طَرفَ الدُجى","فَصَيَّرَ أَدهَمَهُ أَبلَقا",9,"ق",2,0],["فقد داهمتنا الحادثات وما لنا","يدان بما تبدي النعوت الجلاليه",10,"ي",2,0],["فَقَد دامَ إِلْطاطٌ بهمْ في حقوقهمْ","وأعْوَزَ إنصافٌ وطال تحيُّفُ",11,"ف",1,0],["فَقَد دَكَّ طَودُ باذِخِ المَجدِ شامِخٌ","وَغُيضَ بَحرُ زاعِبِ الفَيضِ زاخِرُه",12,"ر",2,0],["فَقَد دُفِنَ امرُىء القَيسِ بنُ حُجرٍ","بِ أنقَرَةٍ وَقَيسٌ في عُمانِ",13,"ن",1,0],["فقد دعا ربَّه المحجوبُ في أنسٍ","بأن يَحُلَّ به سُقم حَوى كَرَبا",14,"ب",2,0],["فقد دق فينا أمره وتباينت","أصالته فيما يقول وخرقه",15,"ق",2,0],["فَقد دلّت مخايله على ما","تؤمّله وطالعه السعيدُ",16,"د",1,0],["فقد دعاني لجنات النعيم وبال","فوز العظيم حباني العز والجاها",17,"ا",3,0],["فقد درى اللَه بذاك الذي","كل فؤادٍ لنواه حزين",18,"ن",1,0],["فَقَد دارَت عَلَينا مِن رَحاها","طَحونٌ كُلَّ ما لاقَت زَبونُ",19,"ن",1,0],["فقد دهتنا الليالي بالصروف وما","زالت تجدد فينا لوعة الكمد",20,"د",1,0],["فقد دّل اجماعهم كلهم","بمن لم يوال له جاحد",21,"د",1,0],["فقد دنى بوارُ مَن","مَنحتَ صافي مَشربك",22,"ك",1,0],["فقد دعاهم أصيل بيتٍ","إلى كتاب من الوكيل",23,"ل",1,0],["فقد دهوتم فلسطينا بباقعة","من أدعياء تَعَدَّوْا باسم صهيون",24,"ن",1,0],["فَقَد دَجا اللَيلُ بِوادي القرى","أَما لِهذا اللَيل أَن يقمرا",25,"ر",2,0],["فقد دب داءُ الجهل وانفصمت عرى","من الدين حتى انحط عن حاله الأقوى",26,"و",2,0],["فقد درَجَ الأنام بكلِّ ذنبٍ","وقد مََرَدَ العصيُّ على المحامدْ",27,"د",1,0]]}