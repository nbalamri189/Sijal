{"poems":[[90,"لله سر في الأنام مطلسم","https://www.aldiwan.net/poem45067.html","الكامل"],[39,"كالهالكي أمال الرأس مجتنحا","https://www.aldiwan.net/poem6485.html","البسيط"],[53,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[47,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[60,"ناديت همدان والأبوان مغلقة","https://www.aldiwan.net/poem31135.html","البسيط"],[22,"قالت أمامة عرسي وهي خالية","https://www.aldiwan.net/poem21655.html","البسيط"],[15,"وإذا تباشرك الهموم","https://www.aldiwan.net/poem45266.html","مجزوء الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142054","الخفيف"],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[164,"رجلان لا أحتاج أن أسميهما","https://www.aldiwan.net/poem58677.html","الكامل"],[194,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[482,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[495,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61085","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56613","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47105","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205041","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91507","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[5956,"شَعْرتان ومكيّف","https://www.poetsgate.com/ViewPoem.aspx?id=182357",""]],"verses":[["كالهدُب في شفر العيون فإنه","لولاه تنشتر العيون وتسجم",0,"م",1,0],["كالهالكيّ أمالَ الرأسَ مجتنحاً","يجلو عن البيض في أكتافها النُّقَبُ",1,"ب",1,1],["كالهُنْدوانِيات حدّ مضاربٍ","عند اخْتِبارِهِمُ ولين صِفاحِ",2,"ح",1,0],["كَالهِلالِ اِنفَرَدَت نُقلَتُهُ","لا يُجاريهِ رُكابٌ في الأُفُق",3,"ق",1,0],["كَالهَيكَلِ المَبنِيِّ إِلّا أَنَّهُ","في الحُسنِ جاءَ كَصورَةٍ في هَيكَلِ",4,"ل",1,0],["كَالهِندُوانِيِّ لا يُخزيكَ مَشهَدُهُ","وَسطَ السُيوفِ إِذا ما تُضرَبُ البُهَمُ",5,"م",1,0],["كَالهُندُوانِيُّ لَم تُغَلِل مَضارِبُهُ","وَجهٌ جَميلٌ وَقَلبٌ غَيرُ وَجّابِ",6,"ب",1,0],["كَالهُندُوانِيِّ لا تَثني مَضارِبُهُ","ذاتُ الحَرابِيِّ فَوقَ الدارِعِ البَطَلِ",7,"ل",1,0],["كَالهُندُوانِيّ المُهَنَّ","دِ هَزَّهُ القِرنُ المُناجِز",8,"ز",1,0],["كالهوا كالأطيار كالفكرِ حرا","يلفحُ الأدهار",9,"ر",1,0],["كالهرقليَّاتِ النوا","صعِ ليس يَنفيها انتقادُ",10,"د",1,0],["كالهر يخرى ثم ينكر ريحه","فيظل يدفن ماخرى ويشمه",11,"م",2,0],["كَالهُندُ وانِىِّ عَلاهُ الرَّونَقُ","يَعلُو عَلَيها لُمَعٌ وَسَفسَقُ",12,"ق",1,0],["كالهندةاني الصقيل بمائه","نار الفرند جديرة ان تقبسا",13,"س",2,0],["كالهَيْقِ بينَ نجائبٍ مزمومةٍ","قلُصٍ تَرامَى في الفلاةِ روازحِ",14,"ح",1,0],["كَالهَودَجِ الساطِعِ المَحفوفِ يَحمِلُهُ","صَقبانِ مِن عَرعَرٍ ما فَوقَهُ كَنَف",15,"ف",1,0],["كإلهام فهم وهم للوهم فاقد","وتحقيق هذا الروح فيه موارد",16,"د",1,0],["كَالهِلال كَالقَضيب كَالطلا","إِن تَبَدى أَو تَثَنى أَو رنا",17,"ن",2,0],["كالهلال الذي بدا في سماه","ثم ساقت له الرياح الغماما",18,"م",2,0],["كالهيولا فكل عنصر نفس","ماغته لا يستقيم قواها",19,"ا",3,0],["كالهيشريِّ المرتضى حمّودةٍ","ذاك الإمامِ المنتقاةِ صفاتُه",20,"ت",2,0],["كالهر يدخل في المطاعم راجيا","لكسيرة مترقبا أن ينهرا",21,"ر",2,0],["كَالهَيكل الطمّاح يَه","وى النصّ تقعده الرساغ",22,"غ",1,0],["كَالهُوجِ لا لَأيَ بِها","تَقُودُ قَودَ الشُذَّبِ",23,"ب",1,0],["كَالهَضبِ فيه نحو ذا قد قالوا","بأنّها تُسمَى به الجبال",24,"ل",1,0],["كالهيكلِ العظميِّ يبدو شكلها","وَتُعيدُ لَثْمَ حبيبها وتجودُ",25,"د",1,0]]}