{"poems":[[55,"يا مقلقي قلقي عليك","https://www.aldiwan.net/poem29917.html","مجزوء الكامل"],[53,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[91,"لهفي يطول على شبابك","https://www.aldiwan.net/poem44755.html","مجزوء الكامل"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[99,"أقبل بموكبك الأغَر","https://www.aldiwan.net/poem24760.html","مجزوء الكامل"],[83,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[106,"سيدة الاقمار","https://www.poetsgate.com/ViewPoem.aspx?id=16826",""],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[164,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[292,"بكرت لتحزن عاشقاً طفل","https://www.aldiwan.net/poem1914.html","أحذ الكامل"],[302,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[409,"سؤالكم كان مفتاح الكنوز لأب","https://www.aldiwan.net/poem33962.html","البسيط"],[416,"ما يلمع البرق إلا حن مغترب","https://www.aldiwan.net/poem67530.html","البسيط"],[447,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[447,"على الشهيد الشريف اللوذعي علي","https://www.aldiwan.net/poem14474.html","البسيط"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80189","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56220","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112804","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112858","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48986","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141282","البسيط"],[1920,"","https://poetry.dctabudhabi.ae/diwan/poem/200379","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104802","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110347","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202676","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88647","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106829","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65973","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87372","الكامل"],[3327,"","https://poetry.dctabudhabi.ae/diwan/poem/144510","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109952","الكامل"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119640","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95072","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83452","الكامل"],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[5273,"زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=28760",""],[5273,"صرير","https://www.poetsgate.com/ViewPoem.aspx?id=178298",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5281,"رحلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=199222",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5376,"نورٌ على نورٍ بهاء محمد ِ","https://www.poetsgate.com/ViewPoem.aspx?id=188493",""],[5376,"كلي هواك وما أنست ببعضي","https://www.poetsgate.com/ViewPoem.aspx?id=198997",""],[5509,"أنت الشعاع","https://www.poetsgate.com/ViewPoem.aspx?id=93493",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5526,"عايش","https://www.poetsgate.com/ViewPoem.aspx?id=193728",""],[5605,"الدوابشة","https://www.poetsgate.com/ViewPoem.aspx?id=177654",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5708,"مَلَكْتَ قلبيَ قهرا","https://www.poetsgate.com/ViewPoem.aspx?id=158078",""],[5763,"صهيلُ الكبرياء على فمِ عنيزةَ","https://www.poetsgate.com/ViewPoem.aspx?id=27058",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"يا ضيعة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=152676",""],[5879,"يا راكب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=215462",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[5956,"يا حُبَّنا الأعلى","https://www.poetsgate.com/ViewPoem.aspx?id=194669",""],[6191,"مواوِيل الخلاص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88102&r=&rc=0",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6237,"قصيدتي فيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77904&r=&rc=46",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""]],"verses":[["أَنتَ الشَقيقُ فَلَو جَنَي","تَ لَما أَخَذتُ عَلى يَديكا",0,"ك",2,0],["أنت الشراب الذي أسَغْتُ به الْ","غُصَّةَ يا سيدي ويا سندي",1,"د",2,0],["أَنتِ الشُّعورُ الحيُّ يزخَرُ دافقاً","كالنَّارِ في روحِ الوُجُودِ النَّامي",2,"ي",1,0],["انت الشهيد وعل اهلك","يدفنونك في ثيابك",3,"ك",1,0],["أَنتَ الشُجاعُ إِذا ما لَم يَطَأ فَرَسٌ","غَيرَ السَنَوَّرِ وَالأَشلاءِ وَالقُلَلِ",4,"ل",1,0],["أنت الشفاء المدَّخر","فاسكب ضياءك في دمي",5,"ي",1,0],["أَنتَ الشَفيقُ عَلى الهُدى أَنتَ الَّذي","رَبَّيتَهُ في الغَربِ وَهوَ وَليدُ",6,"د",1,0],["أنتِ الشبابُ إلى الاعراس مُنطلقٌ أنا الكهولةُ يومٌ ما لديه غدُ","أنتِ الحياةُ التي تنسابُ ضاحكةً إلى الحياةِ .. أنا الموتُ الذي يَئِدُ",7,"د",1,0],["أنت الشهيد على اشراق سيرته","وللبصائر بالمشهود ايقان",8,"ن",1,0],["انت الشفاء وهل أعز من الشفا","عند السقيم وأنت روح آخر",9,"ر",1,0],["أَنتَ الشُجاعُ إِذا هُمُ نَزَلوا","عِندَ المَضيقِ وَفِعلُكَ الفِعلُ",10,"ل",1,0],["أَنتَ الشَهيدُ عَلَينا وَالشَفيعُ لنا","فمن شفعتَ له تُستر فضائحُهُ",11,"ح",2,0],["أنت الشريف فشمر للعلوم تنل","ما لم ينل قبل سعد الدين والعضد",12,"د",1,0],["أَنتَ الشِهابُ الَّذي يُرمى العَدُوُّ بِهِ","فَيَستَنيرُ وَتَخبو عِندَهُ الشُهُبُ",13,"ب",1,0],["أنت الشهيد بنا الخبير وأنت يا","قيوم يا غفار فاغفر ذنبنا",14,"ن",2,0],["أنت الشكور القادر الحكم القوي","ي لما تشا الفتاح أنت افتح لنا",14,"ن",2,0],["أنت الشفيع لنا فليت عليك يا","شهر الصيام عن الفراق شفيع",15,"ع",1,0],["أنت الشهيد سعيداً قد قتلت على","خير العقائد في حل ومرتحل",16,"ل",1,0],["أنت الشهاب إن دجت","ليلتها المضلَّهْ",17,"ل",2,0],["أنت الشفيع المرتضى يوم لا","تغني نفوس عن نفوس تضام",18,"م",1,0],["أنت الشفيع فكن لي حين ينزل بي","من عالم الغيب أمر فيه تنكيل",19,"ل",1,0],["أنت الشفيع الوجيه المرتضى وأنا ال","بر الرؤوف الرحيم الأكرم الكرما",20,"م",2,0],["أَنتَ الشُجاع شُجاع العَقل في فَطنٍ","تَسطو عَلى الجَهل حَيثُ النور قَد سَكَبا",21,"ب",2,0],["أنت الشهاب المستضئ بك وابن من","في نوره الزاهي إليك هدينا",22,"ن",2,0],["أنت الشجيع إذا تقاعست بالرجا","ل كذا الجواد إذا الزمان عتا ومر",23,"ر",1,0],["أنت الشريف المصطفى أنت الذي","حارت جميع الخلق في معناكا",24,"ك",2,0],["أَنتَ الشهيدُ وكلُّ عضوٍ شاهدٌ","في المجلسينِ بصدقِكَ العُثمانِي",25,"ن",2,0],["أنت الشّعار الذّي لم تحي مملكةٌ","إلاّ وكان لها من بردتيه دم",26,"م",1,0],["أنت الشّعار الذّي تقضي الجحافل في","ظلاله وهي للهيجاء تبتسم",26,"م",1,0],["أنتِ الشّراع وحرقتي المجدافُ","أنّى الخلاصُ ورمشك السّيّافُ",27,"ف",1,1],["أَنتَ الشَّفيعُ الرَّفيعُ المُستَجيبُ إِذا","ما قالَ نَفسِيَ نَفسِي كُلُّ مُحتَرَمِ",28,"م",1,0],["أَنتَ الشَّفِيعُ إِذَا ما خافِتِ الرُّسُلُ","وَالأَنبياءُ جَمِيعاً خَوفَ هَيباتِ",29,"ت",1,0],["انت الشهيد وليس أكرم منك اب","طال لنا ماتوا على الأعواد",30,"د",1,0],["أنتَ الشريفُ ابنُ الشريفِ وغيركم","إِلا بكم هيهاتَهُ لم يَشْرُفِ",31,"ف",1,0],["أنت الشقيق ولادة ولذلك لي","روح لروحك في الخلوص شقيق",32,"ق",1,0],["انت الشفاء لدائها","ولكل جرح انت سابر",33,"ر",1,0],["أنتَ الشبيبةُ غَّة ضحّاكة","أفتقتلين بها الحياةَ تحسرا",34,"ر",2,0],["أنت الشفا شما وما فوق الشفا","ضما ومن هذين أحلى طعمك",35,"ك",1,0],["أنتَ الشَريف كَما سُميت وَحسبُنا","بين الملا شَرَفاً من اسمك ذكرُهُ",36,"ر",2,0],["أنت الشفاء لمدنف وصب","لو رام ذاك سواك ما وجدا",37,"د",2,0],["انت الشِهابيُّ الشهاب","العزم والماضي المُهنَّد",38,"د",1,0],["أنت الشفيع غدا يوم اللواءَ كما","أنت المجير من اللاواء قبل غد",39,"د",1,0],["أَنتَ الشَهيد عَلى قَول أَفوه بِهِ","ما دُمت عائِشة فَالحَمدُ غاياتي",40,"ت",2,0],["أنت الشجاع ولا كفو يقاس به","أنت الكريم مزيد الباع مصطنعا",41,"ع",2,0],["أنت الشفيع المرجّى كن لنا أبداً","في كل أمرٍ نصيراً غير مغلوب",42,"ب",1,0],["أَنتَ الشَفيعُ المُرتجى كن شافِعاً","بي من ذُنوبٍ وَزرُها لا يُحمَلُ",43,"ل",1,0],["أَنْتَ الشَّهِيْدُ الَّذِيْ أَحْيَيْتَ أُمَّتَنَاْ *** وَمَاْ قَبِلْتَ - مِنَ الأَعْدَاْءِ - إِجْحَاْفَاْ","نِلْتَ الشَّهَاْدَةَ - فِيْ سَاْحِ الْجِهَاْدِ - وَمَاْ *** خِفْتَ الْعَدُوَّ، وَلاْ وَاْلَيْتَ أَجْلاْفَاْ",44,"ف",2,0],["أنتِ الشَّريكةُ في الحياةِ وجلُّها","أنتِ الفَراشةُ فوقَ ورْدي تَرْتَعُ",45,"ع",1,0],["أنتِ الشَّهيقُ بِمُهْجَتي","والآهُ في حَرِّ الزَّفيرْ",46,"ر",1,0],["أنتِ الشُّموس وتشْجينا مَغاربها","كالبَدْر يضْحك حتَّى حينَ ينْخسف",47,"ف",1,0],["أنتَ الشِّفَاءُ لِنَفسِي والطَّبِيبُ لَهَا","اللهُ أَرشَدَهَا، اللهُ عَافَاهَا",48,"ا",3,0],["انت الشفيع الذي في ظل رحمته","تمحى الخطايا فستر العفو مسدول",49,"ل",1,0],["أنت الشفيع وخيرنا ورجاؤنا","عند الاله وروضة المتوسِّدِ",50,"د",1,0],["أنت الشفيع وهل لمثلي مغنم","إلا النبيّ وشربة بالحوضِ",51,"ض",1,0],["أنت الشعاع ُ، بكل أرض ٍ أقتفى","يا خيرَ وجه ٍ ، ألتقيه مغردا !",52,"د",2,0],["أنتَ الشِّفاءُ لِنفسٍ غالَها سَقَمٌ","وكاد يُهلِكُها جُرمٌ ويُردِيها",53,"ي",3,0],["انت الشموس اللي تجي صبحي شروق","وانت القمر .. يامهجتي في محياك",54,"ك",1,0],["أَنتَ الشَّرَارَةُ يَا عَلِيُ","وَنَحنُ مِنْ أَصلِ الوُقُودِ",55,"د",1,0],["أنت الشريفة في خَلْقٍ وفي خُلُقٍ","ثمينةٌ بالفدا والأرث للنعمِ",56,"م",1,0],["أنت الشِّفا وحياتي","لم أستطع عنك صَبْرا",57,"ر",2,0],["أنت الشقائقُ والطيوبُ تهُزُّني","يا غيمةً فيها الهوى المتمرِّدُ",58,"د",1,0],["أنت الشآم فلا تَراعي عصفها","خطي خطاك إلى ذرى العلياء",59,"ا",2,0],["أنت الشآم وما ينفك بيرقها","يزهو ويخفق في الآفاق والحقب",60,"ب",1,0],["أنت الشجاع الذي قدّ القميص، ولا","كفّ تهدهدني، والدمع هطّال",61,"ل",1,0],["‏أنتِ الشراب مع الرحيق تمازَجاْ","‏ ‏ لم تعرف الدنيا مثيله حانا",62,"ن",2,0],["أنت الشهيد سنلتقيك جميعُنا","في جنةٍ ولَدَيك ألفُ عروسِ",63,"س",1,0],["أنتَ الشِراعُ الذيْ ما جَاءَ قارِبُه","فقالَ للبحرِ كنْ وِرداً لمن وَرَدا",64,"د",2,0],["أنت الشفيع وأنت أن","ت رؤوف قلب كم حنا",65,"ن",2,0],["أنت الشعور وأنت الشعر يا أملي","وأنت مبدع ألحاني ومنشيها",66,"ي",3,0],["أنتِ الشفاءُ جراحاتي أنوءُ بها","فمن حنان يديكِ اليومَ داويني!",67,"ن",2,0]]}