{"poems":[[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[264,"دع سوانا إن رمت يوما رضانا","https://www.aldiwan.net/poem35570.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122719","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87128","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104576","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54438","المنسرح"],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5431,"على لسان شاعر!...","https://www.poetsgate.com/ViewPoem.aspx?id=205607",""],[5655,"دَعْ سالفَ الأمواتِ لا تَبكْهِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=107219",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[5703,"دعْ سَوط هجرك","https://www.poetsgate.com/ViewPoem.aspx?id=208757",""]],"verses":[["دَعَستُ عَلى غَطشٍ وَبَغشٍ وَصُحبَتي","سُعارٌ وَإِرزيزٌ وَوَجرٌ وَأَفكُلُ",0,"ل",1,0],["دَعْ سِوَى هَذِهِ البُدَاءَةِ مِمَّا","كَانَ فِيهِ التَّعْقِيبُ وَالإِتْمَامُ",1,"م",1,0],["دَعْ سُلَيْمَى تكونُحَيثُ تَرَانِي","أوْ فَدَعْنِي أكُونُحَيثُ أرَاهَا",2,"ا",3,0],["دع سوانا إن رمت يوماً رضانا","وتصبّر إن كنت ترجو لقانا",3,"ن",2,1],["دَع سِحرَ بابِلَ فالدُّعجُ العُيونِ لَنا","مِن لَحِظها سِحرُ هاروتُ وَبابِدُه",4,"ه",1,0],["دَع سِواهُم وَلُذ بِهم حَيث مِنهُم","لاحَ بَدرُ العُلوم وَالتَكريم",5,"م",1,0],["دَع سيفَ مِقوليَ البليغِ يذودُ عن","أعراضِكم بفِرِندِهِ المُتوَقّدِ",6,"د",1,0],["دع سلام الخمر في تصفيقها","وارتشف راحاً مرحا",7,"ح",2,0],["دع سلاف الخمر في تصفيقه","وارتشف من ثغره خمر أتروق",8,"ق",1,0],["دَعْ سرَّ وجدي فما أَبوحُ به","وخلِّ حالي فلستُ أَكشفُها",9,"ف",3,0],["دع سوء ظنٍّ بهم واُحذر مخادعةً","والمكر واُذكر وعيداً فيهما وردا",10,"د",2,0],["دعست على الشِرْيان راقصة","فتعرّق الإحساس باللمسِ",11,"س",1,0],["دَعْ سالفَ الأمواتِ لا تَبكْهِمْ","وابْكِ على نفسك يا جاهلُ",12,"ل",1,1],["دع سيدي للغير ذكراً إنما","في غير ذكراك اليراعة أبكمُ",13,"م",1,0],["دَعْ سَوطَ هَجْرِكَ جانباً وَتعالَ لي","فقدْ اكتفى منّي عَدوّيْ واشْتفى",14,"ف",2,0]]}