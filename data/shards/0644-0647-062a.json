{"poems":[[51,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[51,"يظلم الناس يعلم الله أفرى","https://www.aldiwan.net/poem62879.html","الخفيف"],[61,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[66,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[40,"أرقت بسلع إن ذا الشوق يأرق","https://www.aldiwan.net/poem42338.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85576","البسيط"],[150,"إذا بهرت للهاشمي دلالة","https://www.aldiwan.net/poem68439.html","الطويل"],[198,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[212,"عليوة إن الدمع أفشى وخبرا","https://www.aldiwan.net/poem37887.html","الطويل"],[270,"الحب علمني ما لذة الأرق","https://www.aldiwan.net/poem35428.html","البسيط"],[298,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[305,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[328,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[364,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[464,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"]],"verses":[["لَهتْ نفسُه عما مضى من شبابه","بإقلاع سلم أمسُه غيرُ عائدِ",0,"د",1,0],["لهتكتَ الحياء عنك فأبدى","لك وجهاً كوجه أمِّك سكرى",1,"ر",2,0],["لَهتنا أن نُلِمَّ بساحَتَيها","رياحٌ إن سَطت أردَت سَطَاها",2,"ا",3,0],["لَهُ تاجٌ يُريكَ النارَ تُجلى","وَتَنظُرُ لِلدُخانِ بِهِ اِحتِجابا",3,"ب",2,0],["لَهُ تالِدٌ قَد وَقَّرَ الجودُ هامَهُ","فَقَرَّت وَكانَت لا تَزالُ تَفَزَّعُ",4,"ع",1,0],["لَهُ تَحْتَ أَسْتَارِ الْغُيُوبِ وَفَوْقَهَا","عُيُونٌ تَرَى الأَشْيَاءَ لا وَهْمُ وَاهِمِ",5,"م",1,0],["له تواضَعَ جبريلُ على ثقةٍ","لمَّا تواضعَ أقوامٌ على غَرَرِ",6,"ر",1,0],["لَهُ تَعتَري المَرءَ الغَرِيبَ صَبابَةٌ","وَشَوقٌ إِلى أَوطانِهِ حِينَ يَبرُقُ",7,"ق",1,0],["له تبث هواها كي يجازيها","بالمثل وهو عن الأهواء في شغل",8,"ل",1,0],["له تحت أستار الغيوب شهادةٌ","مُعدَّلةٌ لم تبقِ قولاً لقائل",9,"ل",1,0],["له تليلٌ مثلُ ما ينثني","غصنٌ به ريحُ الصَّبا تلعبُ",10,"ب",1,0],["له تُعرف الجوداتُ من قبل حاتمٍ","وفي عدلِه قد فاق كسرى وقيصرا",11,"ر",2,0],["له تُنصَبُ الراياتَ في كلِّ بقعةٍ","به قامَ للإيمان اسمٌ وأظْهَرا",11,"ر",2,0],["له تُنسب العَلياءُ في الأرضِ كُلّها","له تَقْطَعُ الوُفَّاد نجداً ومعبرا",11,"ر",2,0],["لَهت بشعري يَداها مدَّةً ويَدي","تلهو بخاتمها والعقدِ والحلق",12,"ق",1,0],["له تواجدُ صوفيٍّ إذا ذكرت","(ليلى) بحلقةِ زُهّاد وَنُسّاك",13,"ك",1,0],["له تتبع الرسل الكرام وتقتفي","لآثاره في وردها والمصادر",14,"ر",1,0],["لَهُ تجافي حليمٍ في مجاملةٍ","يُنكي بِها في العدى جندٌ هو الندمُ",15,"م",1,0],["لَهُ تَراءَت كُنوزُ الأَرضِ عَن كَثَبِ","وَراوَدَتهُ الجِبالُ الشَمُّ مِن ذَهَبِ",16,"ب",1,0],["له تحت أعماقه صورةٌ","تؤكّدُ أن الختام ابتداء",17,"ا",2,0],["له تُصاغُ عيونُ القولِ إن نُطِقَتْ","وفي عُلاهُ فصيحُ الشِّعرِ إن قُرِضا",18,"ض",2,0],["لهُ تخفضُ الأصواتُ في كلِّ مشهدٍ","وترفعُ هامات العدى بالعوامل",19,"ل",1,0],["له تزخرف أفناء الجنان وعن","رضوانه حلَّ منها العرضُ والطول",20,"ل",1,0]]}