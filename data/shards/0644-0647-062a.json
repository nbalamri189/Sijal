{"poems":[[53,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[53,"يظلم الناس يعلم الله أفرى","https://www.aldiwan.net/poem62879.html","الخفيف"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[68,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[46,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[42,"أرقت بسلع إن ذا الشوق يأرق","https://www.aldiwan.net/poem42338.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85576","البسيط"],[154,"إذا بهرت للهاشمي دلالة","https://www.aldiwan.net/poem68439.html","الطويل"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[216,"عليوة إن الدمع أفشى وخبرا","https://www.aldiwan.net/poem37887.html","الطويل"],[275,"الحب علمني ما لذة الأرق","https://www.aldiwan.net/poem35428.html","البسيط"],[303,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[469,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70684","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67845","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56207","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56316","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56317","المجتث"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126361","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106903","البسيط"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84840","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116498","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146341","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129398","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118009","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77151","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17775","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28928","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136403",""],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99123","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139626",""],[4738,"طَوايا نِظامي في الزَّمانِ لها نَشرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205737",""],[4767,"مجنون العرب","https://www.poetsgate.com/ViewPoem.aspx?id=178506",""],[4816,"حرف شعرا تسامى","https://www.poetsgate.com/ViewPoem.aspx?id=199485",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5431,"له...له...","https://www.poetsgate.com/ViewPoem.aspx?id=191170",""],[5431,"نجمات...","https://www.poetsgate.com/ViewPoem.aspx?id=205710",""],[5544,"فحَلّق بِها يا هَيثَم المجد عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=213408",""],[5080,"يكبّل لحظة ويزيح أخرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88132&r=&rc=2",""]],"verses":[["لَهتْ نفسُه عما مضى من شبابه","بإقلاع سلم أمسُه غيرُ عائدِ",0,"د",1,0],["لهتكتَ الحياء عنك فأبدى","لك وجهاً كوجه أمِّك سكرى",1,"ر",2,0],["لَهتنا أن نُلِمَّ بساحَتَيها","رياحٌ إن سَطت أردَت سَطَاها",2,"ا",3,0],["لَهُ تاجٌ يُريكَ النارَ تُجلى","وَتَنظُرُ لِلدُخانِ بِهِ اِحتِجابا",3,"ب",2,0],["لَهُ تالِدٌ قَد وَقَّرَ الجودُ هامَهُ","فَقَرَّت وَكانَت لا تَزالُ تَفَزَّعُ",4,"ع",1,0],["لَهُ تَحْتَ أَسْتَارِ الْغُيُوبِ وَفَوْقَهَا","عُيُونٌ تَرَى الأَشْيَاءَ لا وَهْمُ وَاهِمِ",5,"م",1,0],["له تواضَعَ جبريلُ على ثقةٍ","لمَّا تواضعَ أقوامٌ على غَرَرِ",6,"ر",1,0],["لَهُ تَعتَري المَرءَ الغَرِيبَ صَبابَةٌ","وَشَوقٌ إِلى أَوطانِهِ حِينَ يَبرُقُ",7,"ق",1,0],["له تبث هواها كي يجازيها","بالمثل وهو عن الأهواء في شغل",8,"ل",1,0],["له تحت أستار الغيوب شهادةٌ","مُعدَّلةٌ لم تبقِ قولاً لقائل",9,"ل",1,0],["له تليلٌ مثلُ ما ينثني","غصنٌ به ريحُ الصَّبا تلعبُ",10,"ب",1,0],["له تُعرف الجوداتُ من قبل حاتمٍ","وفي عدلِه قد فاق كسرى وقيصرا",11,"ر",2,0],["له تُنصَبُ الراياتَ في كلِّ بقعةٍ","به قامَ للإيمان اسمٌ وأظْهَرا",11,"ر",2,0],["له تُنسب العَلياءُ في الأرضِ كُلّها","له تَقْطَعُ الوُفَّاد نجداً ومعبرا",11,"ر",2,0],["لَهت بشعري يَداها مدَّةً ويَدي","تلهو بخاتمها والعقدِ والحلق",12,"ق",1,0],["له تواجدُ صوفيٍّ إذا ذكرت","(ليلى) بحلقةِ زُهّاد وَنُسّاك",13,"ك",1,0],["له تتبع الرسل الكرام وتقتفي","لآثاره في وردها والمصادر",14,"ر",1,0],["لَهُ تجافي حليمٍ في مجاملةٍ","يُنكي بِها في العدى جندٌ هو الندمُ",15,"م",1,0],["لَهُ تَراءَت كُنوزُ الأَرضِ عَن كَثَبِ","وَراوَدَتهُ الجِبالُ الشَمُّ مِن ذَهَبِ",16,"ب",1,0],["له تحت أعماقه صورةٌ","تؤكّدُ أن الختام ابتداء",17,"ا",2,0],["له تُصاغُ عيونُ القولِ إن نُطِقَتْ","وفي عُلاهُ فصيحُ الشِّعرِ إن قُرِضا",18,"ض",2,0],["لهُ تخفضُ الأصواتُ في كلِّ مشهدٍ","وترفعُ هامات العدى بالعوامل",19,"ل",1,0],["له تزخرف أفناء الجنان وعن","رضوانه حلَّ منها العرضُ والطول",20,"ل",1,0],["له تشهد الأشهاد في كل مشهد","ةكل إمام فيه أم بأمة",21,"ه",1,0],["لَهُ تَعالى الحَمدُ وَالشُّكرُ عَلى","إِفضالِهِ قَد جَلَّ شاناً وَعَلا",22,"ل",2,0],["لهُ تَعالى حَمدُنا وَالشُّكر","قَد حارَ في عدِّ نداهُ الفِكرُ",22,"ر",1,0],["له تشهدُ الهيجاءُ والخيل والظُّبَي الْ","قواضي المواضي والخميسُ العرنْدسُ",23,"س",1,0],["لَهُ تَشْهَدُ الآيَاتُ فِي كُلِّ سُورَةٍ","بِمَا خَصَّهُ الْمَولى بِمَعْنًى وَصُورَةٍ",24,"ه",1,0],["له تشهد الفرسان في ساحة الوغا","بعزمٍ أراهم من سطا بأسه العبرْ",25,"ر",1,0],["له تحجّ المواضي","وفيه نادوا وعجّوا",26,"ج",3,0],["له تحزّ المواضي","وفيه نادوا وعزّوا",27,"ز",3,0],["له تكاثرُ آياتٍ قد اشتهرت","في كلِّ عصرٍ فَويلٌ للذي كفَرَه",28,"ر",2,0],["لهتكت ستري في هواك ولذِّ لي","خلع العذار ولج فيك مؤنبي",29,"ب",2,0],["له تلطف آسٍ في تلمسه","نهديك محتشماً في اللمس متئدا",30,"د",2,0],["لهُ تعزت في الأنام حسنه","فتمَّ ثنتين وعشرين سنه",31,"ه",1,0],["لَهُ تَحفظ الأَيّام تاريخ مَطلَع","فَتَزهو بِهِ بَينَ الأَنام وَتَحمد",32,"د",1,0],["لهتهم لهى ما ليس فيهن طائل","وعلقمها في كل طبع منقع",33,"ع",1,0],["له ترجُمانٌ من بني الماء نَبَّهَتْ","على فَضْلِها بالقُرْب منه الأَناملُ",34,"ل",1,0],["له تآليف غدت عديده","لكل من طالعها مفيده",35,"ه",1,0],["له تكية وفيها مدفون","من خارج الشام تجاه القابون",35,"ن",1,0],["له تغضي النواظر حين يرنو","له نظر وتنخفض الرؤوس",36,"س",1,0],["له تتضاءل الأبطال خوفاً","إذا هزّ الحسام المشرفيّا",37,"ي",2,0],["لَهُ تالِد المَجدِ الأَثيلِ وِراثَة","بِنَفسِ لَها في المُكرَمات تَقدم",38,"م",1,0],["لَهُ تَبَعٌ قَد يَعلَمُ النَاسُ أَنَّهُ","عَلى مَن يُداني صَيِّفٌ وَرَبيعُ",39,"ع",1,0],["لَهُ تِسعَةٌ طُلنَ مِن بَعدِ أَن","قَصُرنَ لَهُ بِسعَةٌ في الشَوى",40,"ا",1,0],["له تبعٌ قد يعلمُ الناسُ انه","على من يداني ضيفُ وربيعُ",41,"ع",1,0],["له تحضر الآداب حين يريدها","وتخضع طوعاً عنده وهو آمر",42,"ر",1,0],["له تطاع ملوك الأرض قاطبةً","وللشباب تراعي حرمة الكتم",43,"م",1,0],["له تسجد الأفلاك والأرض كلها","تقرُّ ودين الله فيه يشيَّد",44,"د",1,0],["له تربةٌ فيها الشِّفاءُ، وقُبَّةٌ","يُجابُ بها الداعي إذا مَسَّهُ الضُّرُ",45,"ر",1,0],["له تجري قناة الخير بحراً","وعَمَّن حوله فيها انسداد",46,"د",1,0],["له تفرد علامة عزل رسم الدليل","ما يشَابَه دليله ولا أرتكا منكبه",47,"ب",2,0],["له تآليف أبقت ذكرهُ هيَ في","حدائقِ العلمِ والآدابِدوحات",48,"ت",1,0],["له تصانيفُ ذاعت في الورى هي في","صفيحِ فلسفةِ التاريخِ غرّاتُ",48,"ت",1,0],["له تحفةَ المودودِ تسميةٌ فقد","تاتي بهذا للمراد جلاء",49,"ا",2,0],["له تصبح الأحلام مثل خميلة","بها نشوة الآمال صبحٌ مُبلّجُ",50,"ج",1,0],["له ترفع الآهات نحو ربيبها","تُنقى بدمع العارفين فتُثلجُ",50,"ج",1,0],["له تيه الغرام اذا أراده","ورعشة خافقي عشقا زياده",51,"د",2,1],["له تظل عيون الكون شاخصة","وتسرق اللحن في الاسحار نجمات",52,"ت",1,0],["لهُ تنحني شُمُّ الرُؤوسِ كَرامَةً","وتَزحَفُ في طابُورِهِ حين يَزحَفُ",53,"ف",1,0],["لهُ تهدي المنافِي ثوبَ ضوءٍ","فقدْ وجدَتْ على مغناهُ ذِكرى",54,"ر",2,0]]}