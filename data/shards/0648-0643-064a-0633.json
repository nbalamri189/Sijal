{"poems":[[190,"ترى العقيان كالذهب المصفى","https://www.aldiwan.net/poem43175.html","الوافر"],[261,"فداؤك نفس عبد أنت مولى","https://www.aldiwan.net/poem48500.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38420","السريع"]],"verses":[["وكيسي منه خلو مثل كفيّ","أما هذا من العجب العجاب",0,"ب",1,0],["وكيسي الفارغُ المطروح خلفي","بعيدُ العهد بالقطع الحلال",1,"ل",1,0],["وَكَيِّس القَومِ الّذي لَم يَنَم","وَبارد القَومِ كَثيرِ النّعاس",2,"س",1,0]]}