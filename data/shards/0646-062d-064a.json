.com/ViewPoem.aspx?id=175135",""],[5187,"هيا نتساقى","https://www.poetsgate.com/ViewPoem.aspx?id=29791",""],[5277,"ظلٌّ وحرور","https://www.poetsgate.com/ViewPoem.aspx?id=206087",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5320,"ولدى القعيد","https://www.poetsgate.com/ViewPoem.aspx?id=42967",""],[5363,"رحيلك مرٌّ (رثاء)","https://www.poetsgate.com/ViewPoem.aspx?id=200029",""],[5376,"شآم أين العلا بل أين بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=199004",""],[5497,"وطنٌ يعز المرء في الأرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206937",""],[5573,"بدينا بذكر الي سماه اعتلى بها - مجالسي","https://www.poetsgate.com/ViewPoem.aspx?id=206494",""],[5690,"سلوا عن فؤادي من بار واحنا يفدا","https://www.poetsgate.com/ViewPoem.aspx?id=172144",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5704,"مذ غاب عني ...","https://www.poetsgate.com/ViewPoem.aspx?id=191806",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""],[5804,"مساجلة ( الطغاة )","https://www.poetsgate.com/ViewPoem.aspx?id=189659",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[5853,"جمل المعصرة","https://www.poetsgate.com/ViewPoem.aspx?id=175719",""],[5912,"ساروت في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205007",""],[5943,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=11025",""],[5943,"خفقُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=34275",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5956,"في عُشّنا الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=182125",""],[5956,"ميمي هربتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182276",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5956,"أنا والشعر والعالم","https://www.poetsgate.com/ViewPoem.aspx?id=185582",""],[5956,"أشتاق أن ألقاك في فردوسه","https://www.poetsgate.com/ViewPoem.aspx?id=192017",""],[5956,"آخر دمعة","https://www.poetsgate.com/ViewPoem.aspx?id=193309",""],[5956,"تُنسينا السيارة","https://www.poetsgate.com/ViewPoem.aspx?id=193870",""],[5956,"نحيا معاً في بلدة ميمونة","https://www.poetsgate.com/ViewPoem.aspx?id=194002",""],[5956,"المجد الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=194172",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""],[6093,"ما زال حبك في الضمائر ساكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201519",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6346,"غزة والحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83386&r=&rc=2",""]],"verses":[["نَحيلَةُ مُستَنِّ الوِشاحِ خَريدَةٌ","إِذا نَهَضَت لَم يَستَطِع رِدفَها الخَصرُ",0,"ر",1,0],["نُحَيّا بِها وَنُسَقّى مَعاً","وُنُتبِعُها الوَردَ وَالياسَمينا",1,"ن",2,0],["نَحيا جَميعاً وَلَم يُفِدكُم","طَعنٌ لَنا في الكُلى فَوارُ",2,"ر",1,0],["نَحَيِّيكُمْ وَمَا فِينَا مُدَاجٍ","وَنَحْمَدُكُمْ وَمَا فِينَا مَحَابِ",3,"ب",1,0],["نحْ يا حمام مع الباكي على غصنٍ","رطبٍ وقف بحمىً لم يعفه القِدم",4,"م",1,0],["نحيفة الجسم ولكنها","تَهْوَى العنيفَ الجافيَ الضبطه",5,"ط",2,0],["نَحيباً تَدَافَعَ في مهجتي","وسَالَ يَرُنُّ بنَدْبِ القلوبْ",6,"ب",1,0],["نَحيفُ الشَوى يَعدو عَلى أُمِّ رَأسِهِ","وَيَحفى فَيَقوى عَدوُهُ حينَ يُقطَعُ",7,"ع",1,0],["نُحَيَّا ونُسْقى في الزُّجاجةِ باطلاً","إذا نحنُ حقَّقْنا التَّحيَّةَ والسُّقيا",8,"ا",1,0],["نَحِيلٌ عَنَاهُ انتِقَاءُ الكَلاَم","لَقَد جَلَّ مِن ناحِلٍ نَاجِلِ",9,"ل",1,0],["نَحى المغربَ الأقصى بسَطْوةِ بأسِهِ","فغادَرَه رَهْواً وقد كان مُرتَجا",10,"ج",2,0],["نحيفٌ مِن شُراةِ الخلد يحمِي","تراثَ الشرق أو يرْعى ذمامهْ",11,"م",2,0],["نُحَيِّي الدَّاعِيَاتِ الأَولِيَاتِ","لِمُؤْتَمَرِ النِّسَاءِ الفُضْلَيَاتِ",12,"ت",1,1],["نُحَيِّي بَنِي الْعَرَبِ الأَوْفِياءَ","وَنُسْمِعُهُمْ غَرَدَ الْبُلْبُلِ",13,"ل",1,0],["نُحيِّي المرء إن نجىّ حياةً","فكيف إذا نجا الوطنُ المفدَّى",14,"د",2,0],["نحيَّة ً سلَّفتْكها مِقتي","قبلَ التَّلاقي لركبِها رَتَكُ",15,"ك",1,0],["نحيد خُصومه عنه ومَن لا","يخافُ الليثَ أقبلَ مصمئِلاَّ",16,"ل",2,0],["نَحِيلٌ يُعنِّيني العِيانُ إذا بَدا","صَبَاحاً ويُشجِيني الحَمامُ إذا غَنَّى",17,"ن",2,0],["نَحيْا بها ويُحيِّي ال","نفوسَ طيبُ البخور",18,"ر",1,0],["نحيل كأنيَ من خصرهِ","ولكنني دونهُ الموجعُ",19,"ع",1,0],["نَحيلَةُ جَفنِ العينِ مِن غيرِ عِلَّة","كَذاكَ سُيوفُ الهندِ تَبلى جُفونُها",20,"ن",3,0],["نُحَيِّي وُجُوهاً في الجِنَانِ وَجيهَةً","بمَا لَقِيَتْ حُمْراً وُجُوهَ المَلاحِمِ",21,"م",1,0],["نحييه ما دامت وأيم الله في","أرجائنا امراء من عبد الحميد",22,"د",1,0],["نحييه تذكاراً لآثار بدت","غرراً لطلعة ذلك العصر السعيد",22,"د",1,0],["نحييه ما سطعت لاحمد سنة","في مثل هذا اليوم بالذكر المجيد",22,"د",1,0],["نحييه لا نصغي الملام ولا نرى","للعذل وجها في التقدم والمزيد",22,"د",1,0],["نحييه ما دمنا فانا في حمى","أسد أناه الله تسوية العبيد",22,"د",1,0],["نحييه وهو أحق بالاحياء يا","من رمت أن لانستقيم ولا نفيد",22,"د",1,0],["نحييه ما عرش الخلافة عامر","منآل عثمان أشداء الوعيد",22,"د",1,0],["نحييه لا نرضى التهاون اننا","قوم على نهج الهداية لا نحيد",22,"د",1,0],["نحيزةٌ بهمُ من عهدِ (يعرب) أنْ","يأبوا على الذلَّ إخلاداً وأركانا",23,"ن",2,0],["نُح يا حمام وَصوّح أَيُّها البانُ","فَإِنّ أَحباب قَلبي في الثَرى بانوا",24,"ن",3,1],["نحيي اللَيالي لِنُميت العَنا","وَنبذل السَعي لِنوفي الوعود",25,"د",1,0],["نحيي حِمى زرود بِالقَوافي","وَتَبكِ عَلَيهِ بِالدَمع البَديدِ",26,"د",1,0],["نَحيبٌ اِذا قيلَ الحسينُ وَقتلُهُ","يَزيدُ وَفي قَلبي الحَزينِ وَجيبُ",27,"ب",1,0],["نحييها بأكوار المطايا","ونستسقي المدامع في رباها",28,"ا",3,0],["نحيا لهيبا كأنا شبه ألهة","ونغتدي بانتهاء النار إيحاء",29,"ا",2,0],["نحيلانِ جسمي والتصبُّر بعدها","ونضوانِ بعدي عهدها وذمامها",30,"م",3,0],["نحيلُ خَصْرٍ لينُهُ","يَحُلَّهُ ويعقِدُه",31,"د",2,0],["نحيي بذكرك في الأملاك مأثرة","يا ناصر الحق إن عدت مزاياها",32,"ا",3,0],["نحيل للنقد ما نبديه إذ عرفوا","بالنار ما البون بين العود والحطب",33,"ب",1,0],["نحيا فُروسِيَّةَ العُشَّاقِ إنْ حَمِيَتْ","أشواقُنا.. إنَّ للأشواقِ (حِطِّينَا)!",34,"ن",2,0],["نَحيلةُ خَصرٍ مثلَ جسمي من الضَّنَى","تَرِفُّ عليهِ مثلَ قلبي بُنودُها",35,"د",3,0],["نحيل جسم كئيبٍ","قد مله الجلساء",36,"ا",2,0],["نَحى مصراً فحلّ بها عزيزاً","وَفيه أصبحت تفترّ ثَغرا",37,"ر",2,0],["نُحيّيك يا حلف السعادة من له","مناقب ضاءت كالنجوم الزواهرِ",38,"ر",1,0],["نَحيا وأنت حَياتُنا فاتَت وَلَو","كُنّا ذَوي بَشَريَّةٍ مِتنا مَعا",39,"ع",2,0],["نحيا به وله نسقى المنون وهل","يهوى المنية إِلا أصيد بطل",40,"ل",1,0],["نَحيفٌ لَه جِسمٌ يعزُّ ضَريبه","نَحيلٌ وَأَمّا ضَربُهُ فَثَخينُ",41,"ن",1,0],["نَحيلةُ الخصرِ عقدُ العشرِ مِن يَدِها","أَضحى يُمَنطِقهُ لَو غير منتحِلِ",42,"ل",1,0],["نُحَيِّ أطلالاً عفا آياتِها","تَعاقُبُ الأيام والسِّنينا",43,"ن",2,0],["نحيف خصر كثيف ردف","ظامي الحشا مفعهم المعاصم",44,"م",1,0],["نَحيفٌ راحَ كَالشَنِّ","وَلَكِن باتَ كَالوَطبِ",45,"ب",1,0],["نحيفاً يقاسي نير قيدٍ وعلةٍ","ويدعو بني فهرٍ وأبن له فهر",46,"ر",1,0],["نَحّى السَديسَ فَاِنتَحى لِلمُعَدَّلِ","عَزلُ الأَميرِ لِلأَميرِ المُبدَلِ",47,"ل",1,0],["نحيد عن الباقي النفيس وبيننا","منافسةٌ فيما يزول وينفَدُ",48,"د",1,0],["نحييه بالنعمى فيعيا وعهدنا","به ناعم الآصال والبكرات",49,"ت",1,0],["نحيا على حب الجمال وان نمُت","فتحية من أهله تحيينا",50,"ن",2,0],["نحيا على المله وسنة نبينا","ويدوم فينا الخير والأمن برضاه",51,"ا",2,0],["نحيى به أعضاء إنسانها","وهو لنا كالمسك في حقه",52,"ق",2,0],["نَحيفُ قَوامٍ لا من السُّقْمِ رِقّةً","بها صِرْتُ رِقّاً بالنُحُولِ له قِنَّا",53,"ن",2,0],["نَحيلات أَعطاف وَهنَّ موالى","مَريضات ألحاظ وَهُنَ صَحايح",54,"ح",1,0],["نحيي لكي يطعن صلب الدجى","بكاسه والليل داجي النواح",55,"ح",1,0],["نحيفات ما بين الحشا وهي بدَّن","ضعيفات رجع الطرف وهي قوادر",56,"ر",1,0],["نحيلة العطف وسني الطرف ما تركت","قلباً سليماً وجفناً غير سهران",57,"ن",1,0],["نحيلة جسمٍ ألبستك نحولها","وصدتك عن وصلي وأعلمتك عن صدي",58,"د",2,0],["نحيف اذا ارضعته النقس راجلا","تراه سميناً خطبه وهو راكب",59,"ب",1,0],["نحيي طلعة الموت","إذا ما شاهت الطلعه",60,"ع",2,0],["نُح يا يَرَاعي كيفَ شئ","تَ فقَد نشَأتَ على الصريرِ",61,"ر",1,0],["نحيف الخد ذو أذنين طالا","وقاما صدره رحبٌ رقيُّ",62,"ي",1,0],["نُحيي شخصَهُ ويقولُ أهلاً","تبدلُنا الطَلاقة بالشُحوبِ",63,"ب",1,0],["نحيي على طول البلى رسم دمنة","كأن لم تكن من آلفين جميع",64,"ع",1,0],["نح يا حمام كما تشاء فكلنا","من دهره مضنى الفؤاد وجيعه",65,"ع",2,0],["نحيي من الدنيا التي نستعيدها","مكانًا من الدنيا له العود أحمدُ",66,"د",1,0],["نُحَيّي وَنَفني وَالحَياةُ تَعِلُّهُ","وَدَلالَةُ الإِعدامِ في الإِيجادِ",67,"د",1,0],["نحيفُ الشَّوى بالي السَّرابيل مرملٌ","قليلُ التَّصابي ساهمُ الوجه قاحله",68,"ل",2,0],["نح يا حمام كنوحي وانتحب شجناً","على ربوع الحمى مثلي وأهليه",69,"ي",2,0],["نَحيبَ الثّاكِلِ الوا","لِهِ أَو غاشِيَة الهَدمِ",70,"م",1,0],["نَحْيَا عَلَى البُؤْسِ ... نَبْكِي المَجْدَ نَنْدُبُهُ","نُجِيدُ فَنَّ التَّبَاكِي ... نَرْقُبُ ... الأَجَلاَ",71,"ل",2,0],["نَحيَا عَلَيكَ كَأنَّنَا نُزَلَاءُ","ونُذَلُّ فِيكَ كَأنَّنَا دُخَلَاءُ",72,"ل",3,1],["نحيف القد والمبسم عذيب وكاحل الاعيان","ونظرة من عيونه السود شرى نجم سطى مالكون",73,"ن",1,0],["نَحْيَاْ عَلَىْ أَمَلِ اللِّقَاْءِ، وَكُلَّمَاْ","صَعُبَ الْجَفَاْº تَتَبَاْعَدُ الأَحْيَاْءُ",74,"ا",2,0],["نحيا على الدُّخانِ تشربُه السَّما","لاصفْوَ يُرشُدُنا من البُهتانِ",75,"ن",1,0],["نحيا فلسطين والأشعاَرُ تَلفَعها","\"غزه\" تُصَادي أيا آلي وأمْواتي",76,"ت",2,0],["نحيا سوى لحظة ننسى عواقِبَها","فهل حسبنا غدا لو هزَّنا هزَّا ؟",77,"ز",2,0],["نحيا بفيضِ نعيمِ الطُهرِ في غَدِنا","بوعدِ صدقٍ يَبُثُّ النورَ في ثِقتي",78,"ت",2,0],["نُحْي ماضينا التليد","عزّ أندلس الأبيَّا",79,"ي",2,0],["نحيا في أعمقِ فلسفةٍ","صارتْ للرغبةِ مفتاحا",80,"ح",2,0],["نحيفٌ خصرُها والعودُ بانٌ","وظلُّ وصالها يبدو عسيرا",81,"ر",2,0],["نحيا به نهتدي من نوره فهو ال","كون الفسيح وفيه الأنجم الزهر",82,"ر",1,0],["نحى تعالى ضمنى","يازهرة بين الورى",83,"ر",2,0],["نحيلٌ من الخوف المقيم لربّنا","برتك همومٌ في الإله جسائمُ",84,"م",1,0],["نحيا بذل خنوعا ليس يسعفنا","أنى لنا العز والأسياد أولاد",85,"د",1,0],["نحيا سعوديين في كل الدّنا","قانوننا بمحجةٍ بيضاء",86,"ا",2,0],["نحيت المكاره عن طريقي وسكتي","وخليت من بعدي يسج الخُطا بها",87,"ب",3,0],["نحيلٌ وحتى الوهم لم يبق عندهُ","وتاللّه ما أبقى الغرام لهُ عندا",88,"د",2,0],["نحّى الوزيرَ وألقاهُ مُعاقبةً","في السجنِ منعزلاً في ركْنِ سرْدابِ",89,"ب",1,0],["نحيي الليالي وشمع الحب نوقدهُ","ننسى الخوالي فإن القلب طمَّاحُ",90,"ح",1,0],["نحيل الخصر وضاح الثنايا","نظيم الدر منظوم بفاها",91,"ا",3,0],["نُحيّكَ يا صاحبي بالفصيحِ","ونُهديكَ شعرًا جميلاً نديّا",92,"ي",2,1],["43. نحيا بها في الشام إن نام الورى","عن ذكرها, في الشام ما أحلى السمر",93,"ر",1,0],["نحيل هام من وتر","إذا ما شلاه انعقد",94,"د",1,0],["نحيي الحضارات التي في أرضنا","مدفونةً كالموميات بمقبرهْ",95,"ر",2,0],["نُحْ يا زَمَانُ عَلى الرِّجَالِ فَرُبَّمَا","زَمَنُ الرِّجَالِ مَعَ الرَّجَالِ تَوَلّى",96,"ل",2,1],["نَحيَا كِرَاماً ما غوانا عَيْشُنَا","وَنَمُوتُ لا نَرضَى الخُنُوعَ وَذُلّا",96,"ل",2,0],["نحيا على أملٍ للخيرِ يحملنا","بصادقِ الهمس بالتذكارِ تحكيهِ",97,"ي",2,0],["نحيا بماضٍ لهُ في النفس باصرة ٌ","ماأغمضتْْ جفنَها ،مامسَّها الوَجَفُ",98,"ف",1,0],["نحيا ونفنى يا حبيبة ما لنا","إلا الصدى والطيفُ فالأصل انتهى",99,"ه",2,0],["نحيا حياةً كأنْ مِنْ قبلُ ما بدأت","ولم تذوقي كهذا الحب والنَّهمِ",100,"م",1,0],["‏نحيا خياليّين نقتات الرؤى","‏ ‏ وأشد عَوْنٍ للحِجَى التخييلُ",101,"ل",1,0],["نحيا بتنكيت وتبكيت معاً","وكأننا المصفاةُ تَطَّرِحُ الكدَرْ",102,"ر",1,0],["نحيا بدهر يخاف الفنُّ فرقتنا","يخشَى علينا طوالَ الليل لم ينمِ",103,"م",1,0],["نحيا على آثار فنك دائما","فالفنُّ منك على الوجود يجودُ",104,"د",1,0],["نحيا بمنزله كأنه بيتنا","خدمٌ لنا يمشون تحت الأمرِ..",105,"ر",1,0],["نحيا في حِسَّينِ سويّاً","في مضحكةٍ معَ مَبْكَى..",106,"ك",2,0],["نحيا معاً في بلدةٍ ميمونةٍ","في حضن مطروحٍ بدون صروفِ..",107,"ف",1,0],["نحَيِّيهِ بقلبٍ عبقريٍّ","يحاول أن يواكبه وقارا",108,"ر",2,0],["نحيلة الخصر جالت بالوشاح وقد","هب النسيم ولكن ألم الخصرا",109,"ر",2,0],["نحيي التنافسَ في النُّفوسِ بعزمنا","ونُميتُ بالخُلقِ الرفيعِ ضَغائِنا",110,"ن",2,0],["نحى الحسام وأدنى للحشى جلدا","صلدا بصالية الأرزاء لم يذب",111,"ب",1,0],["نُحِيلُ زِمَامَ الأمُورِ لِمَنْ","يُجَرِّعُنَا المُرَّ وَالعَلْقَمَا.!",112,"م",2,0]]}