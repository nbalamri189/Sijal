3&r=&rc=10",""],[2220,"ناحتْ مطوقة ٌ فحنَّ حزينُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19271&r=&rc=813",""],[6320,"عَوْدَةُ الجَوَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84341&r=&rc=38",""]],"verses":[["ناحَت خَميلاتُ الأَراكِ وَقَد بَكى","مِن وَحشَةٍ نَزَلَت عَلَيهِ البانُ",0,"ن",1,0],["ناح الحمام وغرّد الشحرور","هذا به شجن وذا مسرور",1,"ر",1,1],["ناحل أصفر من","غير سقام وارتياع",2,"ع",1,0],["ناحَ الحمام بها وأبكاني الأسى","فتعلمت نوح الحمام وأدمعي",3,"ع",2,0],["ناحَتْ عليهِ فتاةٌ","ويلي لمَنْ تتركونَهْ",4,"ه",1,0],["ناحِلٌ كَالكُرَةِ الصُغرى سَرى","صَوتُهُ في كُرَةِ الأَرضِ الفَضاء",5,"ا",2,0],["ناحَ إِذ جَفنايَ في أَسرِ النُجوم","رَسَفا في السُهدِ وَالدَمعُ طَليق",6,"ق",1,0],["ناحتْ وما فقدت إِلفاً ولا فُجِعَتْ","فذكّرتنيَ أوطاري وأوطاني",7,"ن",2,0],["ناحِلِ الجِسمِ قَصيرٍ دَقيقٍ","دَقَّ في الحَربِ الرِماحَ الطِوالا",8,"ل",2,0],["ناحَت حمامة أَيكٍ","فَيا حَمامةُ نوحي",9,"ح",2,1],["ناح قيثارُهُ الشجي","يُ بما رقَّ وانسجمْ",10,"م",1,0],["نَاحَتْ عَرَائِسُهُمْ عَلَى أَزْوَاجِهَا","وَالأُمَّهَاتُ بَكَتْ عَلَى الأَوْلاَدِ",11,"د",1,0],["ناحل الخصر ثقيل ردفه","مائس القد ردينيُّ الخطر",12,"ر",1,0],["ناح الحمام لنوحي في محبتكم","عطفا فطوقته من ادمعي دررا",13,"ر",2,0],["ناحَ الرَّويُّ على أطْلالِ عِزّتِنا","إنا غُثاءٌ بِهَ قَدْ ضاقَتِ الشِّرَعُ",14,"ع",1,0],["ناحَت بَنو الخُوري الكِرامَ تَأَسُّفا","مِن بَعدِ حنونَ الكَريمَ الماجدِ",15,"د",1,1],["ناح ابنُ بولادٍ نقولا عِندَما","خَطَفَت قرينَتَهُ المَنايا الظالِمةْ",16,"م",2,1],["ناحَت بَني العَبسيِّ مَصرَعَ راحِلٍ","كَالرُمحِ باتَ موسَّداً تَحتَ الثَرى",17,"ر",2,1],["ناحَ التُقَى بَعدَهُ وَالمُكرَماتُ كَما","أَبكى عُيونَ الحِجى والنُّبلِ وَالأَدبِ",18,"ب",1,0],["ناحَت بَنو الجلخِ الكِرامَ مودِّعاً","خَضبَ الجُفونِ بِدَمعِها لَمّا مَضى",19,"ض",2,1],["ناحَت بَنو فرَجِ اللَهِ الكِرامَ لَهُ","بِمَدمَعٍ مِثل صَوبِ المُزنِ مُنتَثِرِ",20,"ر",1,0],["ناحَت دِيارُ بَني سيُّورُ فاضِلَةً","أَبكَت بَني الصالحاني عِندَما فُقِدَتْ",21,"ت",1,1],["ناحَت بَنو سيُّورَ بَعدَكَ رُكنَها","لا بَل لعَمرِي كُنتَ رُكناً لِلمَلا",22,"ل",2,0],["ناحَت بَنو العَتقِيِّ غُصناً ناضِراً","أَجرى لِمَصرَعِهِ العُيونُ تَأسُّفا",23,"ف",2,1],["ناحَ اِبنُ مزهرَ سَلومَ الكَريمَ عَلى","فَتىً كَغُصنٍ بِرَوضِ الحُسن مَيّالِ",24,"ل",1,1],["ناحَتْ عَلَيهِ العُلَى وَالمَكرُماتُ كَما","أَبكى المَحابِرَ والأقلامَ وَالصُحُفا",25,"ف",2,0],["ناحَت لِمَصرَعِهِ الفَضائلُ مِثلَما","بَكَتِ العفاةُ بِدَمعِها المِدرارِ",26,"ر",1,0],["ناحَت لِمَصرَعِه العُيونُ وَدونَها","في كُلِ قَلبٍ بَعدَهُ نارُ الغَضى",27,"ض",2,0],["ناحَت عَلى فَقدِهِ بَيروتُ نادِبَةً","وَكانَ في أَرضِها مِن أَعظَمِ العَمَدِ",28,"د",1,0],["ناحتْ عليه الشهبُ وهي عرائسٌ","وبكى عليه الغيمُ وهوَ جهام",29,"م",1,0],["ناحت عليوة بالبكى من حين ما","بَسَمَ القتيرُ بهامتي مُسْتَبْشِراً",30,"ر",2,1],["ناح وما نوحه لما بي","كل على ما به ينوح",31,"ح",1,0],["ناحَت فَباحَت وَلَم تَدرِ الدُّموعَ وَلَم","يَبُح لِساني وَأَبدَت عَبرَتي شاني",32,"ن",2,0],["ناحتْ عَلَى (بردى) الأطيارُ فانفجرتْ","بعد النضوبِ عيونُ الدمع من (بردى)",33,"د",2,0],["ناحلاتِ الأشباحِ مثْلِ المَداري","وهْي تَفْلي شَعْراً من اللّيْلِ وَحْفا",34,"ف",2,0],["ناحِراً للعُداةِ حتّى لوَحْشِ ال","بيد أيضاً بلَحْمِهم تَعْييد",35,"د",1,0],["ناحَت مَلائِكَةُ السَماءِ عَلَيهُمُ","وَبَكَوا وَقد سُقّوا كُؤوسَ الذُبَّل",36,"ل",1,0],["ناحَتْ فباحَت في فُروعِ البانِ","عن لوعَتي وعن جَوَى أحْزاني",37,"ن",2,0],["ناحَتْ مُطَوَّقَةٌ في البان تُزْعِجُني","بما تُهَيِّجُ من وَجْدي وأشجاني",38,"ن",2,1],["ناحت صباح على الغصون حمامة","فتحّدرت عبرات كل حزين",39,"ن",1,1],["ناحت ونحن صبابةً لكنَّها","باحت بما اخفي من الأحزانِ",40,"ن",1,0],["ناحَت فَواخِتُ سُحبٍ وَكرُها الفَلَكُ","بُكاؤُها لِطَواويسِ الرُبى ضَحِكُ",41,"ك",1,1],["ناحتْ على عَذَبِ الفروعِ واِلفُها","منها بمرأى فوقَهنَّ ومسمَعِ",42,"ع",1,0],["ناحتْ على اعلى الغصونِ ومائد","الأغصانِ يَحمِلُها على أن تَسْجَعا",43,"ع",2,0],["ناحوا وما الخَنْساءُ في تَعديدها","وتَلَهَّفوا فَتَنَفَّسوا بأُوارِ",44,"ر",1,0],["ناحَت عليه جِيادُ الخيل عابِسَةً","والسَّيفُ والضَّيفُ والإكرامُ والجودُ",45,"د",1,0],["ناحتْ عليهِ بنو طِرادٍ حَسرَةً","وتأسَّفتْ لفِراقِهِ كلُّ البَلَ