{"poems":[[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[53,"قل للأمير وما بالحق من باسدع","https://www.aldiwan.net/poem64608.html","البسيط"],[164,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[473,"بكت لبيني بكاء مكتئب","https://www.aldiwan.net/poem60386.html","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46555","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88648","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130131","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81300","الخفيف"]],"verses":[["مِن أَثرٍ يونِقُ الفَتى حَسَنٍ","أَو خَبَرٍ يَبسُطُ المُنى عَجَبِ",0,"ب",1,0],["من اثنتين فلا تبخل بواحدةٍ","إمّا النوال وإما راحة الياس",1,"س",1,0],["من آثر الباري على شهواته","من مقنب كالشهب يتلوا مقنبا",2,"ب",2,0],["مِن إِثمِدٍ لَم يَزَل يُدَحرِجُهُ","مِن طَرفِها سِربُ دَمعِها السَرِبِ",3,"ب",1,0],["مَن آثر الحَق سلم","مَن قَمع النفس غنم",4,"م",1,0],["مَن آثر المال شقى","مَن طَلَبَ الخَير وقى",4,"ق",2,0],["من اثكل الزهراء في ابنائها","حنقا ومن هو كافل ايتامها",5,"م",3,0],["منّا ثمانٍ وثماني","يعرفنَ بائعة الأواني",6,"ن",2,0],["من أثر في الصخر مذ مشى قدماه","لا ظل له في انجلا الضحاء وان راد",7,"د",1,0],["مِن آثار المُنى يَعز مَداها","فَإِذا بِالمُنى عنان مساق",8,"ق",1,0]]}