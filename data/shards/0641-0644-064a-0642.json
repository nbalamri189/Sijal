افر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101523","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53883","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48780","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145848","الخفيف"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31573","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93111","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144785","الوافر"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113817","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27782","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27611","الرمل"],[2250,"","https://poetry.dctabudhabi.ae/diwan/poem/145173","الوافر"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98589","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102541","المتقارب"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127388","الرمل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104280","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82822","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53009","الرجز"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26997","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107531","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83367","الخفيف"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104918","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120281","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[4677,"زيتونة","https://www.poetsgate.com/ViewPoem.aspx?id=203969",""],[4693,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=30634",""],[5090,"دموعُ العين","https://www.poetsgate.com/ViewPoem.aspx?id=184304",""],[5431,"إنّ الإباء لنا من مائه بردى ....","https://www.poetsgate.com/ViewPoem.aspx?id=197082",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[5997,"الوَمْضَة","https://www.poetsgate.com/ViewPoem.aspx?id=214258",""]],"verses":[["فَلْيَقُرَّا عَيْناً بِعَيْشٍ مَدِيدٍ","وَليَكُونَا لِكُلِّ عَينٍ قرَّهْ",0,"ر",2,0],["فَلْيَقُلْ أَبْلَغَ المَقَالَةِ فِي الدَّهْ","رِ وَفِي صَرْفِهِ الأَلِيمِ الأَلِيمِ",1,"م",1,0],["فلْيقم كاشحي بنقضِ الذي قل","تُ وإلّا فليُطرقِ اسْتِحياءَ",2,"ا",2,0],["فلْيَقُلْ قائل لذي الصَّدَر الْمَيْ","مون منْهُمْ في أَمْرِهِ والورود",3,"د",1,0],["فليقذف النّابشونَ الشرَّ ما نبشوا","فمدية العنز في تلك الأنابيش",4,"ش",1,0],["فلْيقُلِ البصْريُّ ما يَشْتهي","سوّغْتُه المعسولَ من طَعمي",5,"م",2,0],["فَل يُقَرِّبُهُ شَوقٌ إِلى نَهرٍ","وَلَيسَ تنقُلُهُ في الرَوضِ عَيناهُ",6,"ا",2,0],["فَليَقُل ما شاءَ عَنّي لائِمي","أَنا أَهواها وَلا أَحتَشِمُ",7,"م",1,0],["فَلي قَلبُ مَحزونٍ وَعَقلُ مُدَلَّهٍ","وَوَحشَةُ مَهجورٍ وَذُلُّ غَريبِ",8,"ب",1,0],["فليقصِدِ المُسْتَمْسِكُونَ بِحَبْلِهِ","دارَ البقاءِ مِنَ الطَّرِيقِ الأَقْصَدِ",9,"د",1,0],["فَلِيقُ النَسا حَبِطُ الموقِفَي","نِ يَستَنُّ كالتيسِ في الحُلَّبِ",10,"ب",1,0],["فَلْيَقُلِ الْعَاذِلُ مَا شَاءَهُ","فَالْعِشْقُ دَأْبُ الشَّاعِرِ الْمُفْلِقِ",11,"ق",1,0],["فَلْيَقُلْ حَاسِدِي عَلَيَّ كَمَا شَا","ءَ فَسَمْعِي عَنِ الْخَنَا في احْتِجَابِ",12,"ب",1,0],["فليَقضِ قاضيهم، فلن","نَنْصَاعَ للحُكمِ الظلومِ",13,"م",1,0],["فليقلعوا عن غيّهم إنّي أرى","خور الشيوخ بهم ولمّا يهرموا",14,"م",3,0],["فلي قوافٍ سلبْنَ النّحلَ ريقتَه","والماءَ رقّته والسحرَ رُقْيتَهُ",15,"ه",1,0],["فلي قمر في ذلك الافق قد سما","يفوق على الاقمار بالواضح الاسنى",16,"ن",2,0],["فليقل المسواك ما عنده","فهو عن الضحاك والزهري",17,"ي",1,0],["فليقولوا ما يشاءون","فما للناس جئنا",18,"ن",2,0],["فَليَقطَعوا مِنها الرَجا","ءَ فَقَد ثَوَت تَحتَ الرِجامِ",19,"م",1,0],["فليقه أجرد كالرمح الضلع","جد بالهاب كتضريم الضرع",20,"ع",1,0],["فليقا عينا بعيش مديد","وليكونا لكل عين قره",21,"ر",2,0],["فَلْيَقُلْ خائِنُوكَ صَحوَة ُمَوتٍ","وَلْيُجَنُّوا مِن كَثرَة ِالتَّسآل ِ!",22,"ل",1,0],["فلي قلبٌ يراها كلُّ وقتٍ","بناظرِه إذا عُدِمَ العِيانُ",23,"ن",1,0],["فلي قلبٌ هُناكَ بغيرِ جِسمٍ","ولي جِسمٌ هُناكَ بغيرِ قلبِ",24,"ب",1,0],["فليقتدوا بجدود بيننا رفعوا","صروح مجد وطيد ليس بالفاني",25,"ن",2,0],["فليقُل ما شاءَ عني قائلٌ","عاشِقٌ مادمتُ احيي عاشقُ",26,"ق",1,0],["فلي قلبٌ إذا هبّتْ قَبولٌ","يكاد لطيبها عنّي يَزولُ",27,"ل",1,0],["فليقل ما شاءه معترض","وليقل ما شاءه ممتثل",28,"ل",1,0],["فليقولوا لا تكترثْ يا نهارُ","هكذا هكذا يكونُ الكِبَارُ",29,"ر",1,1],["فَلَيَقْضِ عِدَّتَهُ السُّرورُ فَإِنَّني","طَلَّقْتُ بَعْدَهُمُ السُّرورَ ثَلاثا",30,"ث",2,0],["فليقتدِ بك من أناب","فلا يقول لك اصطبارا",31,"ر",2,0],["فلي قلب عليه مستقيم","ولي اذن عن الفحشاء صما",32,"م",2,0],["فليَقتَفِ الآثارَ من رام العُلا","وليستَمِع آثارَ أحمَدَ طه",33,"ه",1,1],["فليقم من يشا على الضيم أني","لبريء من أهل ذاك المهب",34,"ب",1,0],["فليقلب العين الذي قد بدا","فإنه المشهود في قلبه",35,"ب",2,0],["فليقم من شاء منكم","أو يَرُحْ رَائحَ أمسِ",36,"س",1,0],["فلي قلب بأرض الشرق عان","وجسم حل بالغرب القصي",37,"ي",1,0],["فليقد هامة عبّاس بهامته","إذا المزاود وافت راس عبّاس",38,"س",1,0],["فلي قلب حائر قليل الهدى","فبصره يا هادي الحائرين",39,"ن",1,0],["فليقل ما شاء فهي","المستحيل",40,"ل",1,0],["فليقتدي بك من أناب","ولا يقول لك اصطبارا",41,"ر",2,0],["فَليُقصِرِ اللَومَ عُذّالي أَما عَلِموا","بِأَنَّني لَستُ مِمَّن يَنقُض العَهدا",42,"د",2,0],["فليقتطفْ داني الجنى من غرسه","كما اجتنى من العلوم كلَّ فنْ",43,"ن",1,0],["فَلَيقُل ما شاءَ مَن شا","ءَ فَقَولي مُستَقيمُ",44,"م",1,0],["فليقم كل امرئ منا العزا","وليساعد بالبكا شجواً أخاه",45,"ا",2,0],["فلي قلب متبول ونفس تدلهت","بحبك يا مولاي قبل فطامها",46,"م",3,0],["فَليَقُم أَيُّكُمُ لا فَرقَ إِن","كانَ غَضَّ العُمرِ أَو شَيخاً مُسِن",47,"ن",1,0],["فَليُقل فَوقَ أَبِيهِ قد سَما","سَلَّ سَيفَ الفَوزِ يا نِعمَ السَّلِيل",48,"ل",1,0],["فليقتدِ به من يشاء","خيرُ الورى خيرهُ اقتداء",49,"ا",2,0],["فليقل فيّ ما يَشاءُ حَسودي","لا أبالي بميِّتِ الأَحياءِ",50,"ا",2,0],["فليقطعني معشر فإنني","قطعت منهم قبلهم علائقي",51,"ق",2,0],["فليقصرن عن الملامة من يرى","عملا يطول عليه من اعماله",52,"ه",1,0],["فلي قيصر قرم جليل تهابه","جميع ملوك الارض هيبة رئبال",53,"ل",1,0],["فليقتلوا جسدي ستبقى مهجتي","مزروعة في الدار .. ما كانت تخون",54,"ن",1,0],["فلي قلم يعاندني وأخشى","رعاك الله عاقبة الهجاء",55,"ا",2,0],["فلي قلبٌ يمزقُه اشتياقي","وليس له مجيرٌ أو نصيرُ",56,"ر",1,0],["فليقطف الحزن من أرواحنا ثمرا","وليغمد الظلم في الأحشاء ماغمدا",57,"د",2,0],["فلي قلبٌ أحبّكِ من عصور","بإحساسٍ وعلّمني شعورهْ",58,"ر",2,0],["فَلي قَلبٌ تَؤوبُ إليهِ رُوحي","ولي روحٌ يُسامِرُها حُطامي",59,"م",2,0],["فلي قرّاءُ من أرقى البرايا","يحبّون الحقيقة والعلوما",60,"م",2,0],["فَلِي قَلْب لرؤيتهم مشوق","لَهُم فِي كُلِّ جَارِحَةٍ مَكَانُ",61,"ن",1,0]]}