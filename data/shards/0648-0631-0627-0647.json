م شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[563,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48548","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95552","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111905","الرمل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131345","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198227","الخفيف"],[4916,"العود لا طاحت سنونه","https://www.poetsgate.com/ViewPoem.aspx?id=135661",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[5183,"مُلعِزَه رق204م","https://www.poetsgate.com/ViewPoem.aspx?id=186394",""],[5183,"الهمة الوثابة","https://www.poetsgate.com/ViewPoem.aspx?id=185637",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[402,"عز المعالي مات يوسف سابا","https://www.poetsgate.com/ViewPoem.aspx?id=35358",""],[5829,"ولا تبقوا حصونا للهوان","https://www.poetsgate.com/ViewPoem.aspx?id=195343",""],[5848,"كثير من السهر","https://www.poetsgate.com/ViewPoem.aspx?id=53155",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""]],"verses":[["وراهنَ قلبي خفوقَ البروق","وكان لدمعِي عليهِ الغَلَب",0,"ب",1,1],["وراهبةٍ طرقناها بليل","ودونَ مزارِها أرَجٌ يفوح",1,"ح",1,1],["ورآه العيوق في فلك المج","د فأمسى يخاله العيوقا",2,"ق",2,0],["ورآه ثعبانُ الجبال فغمَّه","ما فيه من مَرَحٍ وفيْضِ شبابِ",3,"ب",1,0],["وَرَآهُ رَذيلَةً","لا تُماشي التَأَدُّبا",4,"ب",2,0],["وَرَآها صورَةً في أُمَّةٍ","وَمِنَ القُدوَةِ ما توحي الصُوَر",5,"ر",1,0],["وَرَاهِبةٍ أَغلَقَت دَيْرَها","فَكُنّا مَعَ اللَّيل زُوّارها",6,"ر",3,0],["ورآهُ يَهدِرُ بالوعيدِ فراعه","وأتى غَدٌ فَانْقَادَ لا يَتوقَّفُ",7,"ف",1,0],["وَرَآها النِساءُ تَغلو فَسَب","ن غَلاءً لَمّا اِستَبانَ الغَلاءُ",8,"ا",2,0],["ورآها وقد بَدَتْ","مِثلَ حوريّة الحُلُمْ",9,"م",1,0],["ورآها فتندّتْ عينهُ","رحمةً فاحتال يُخفي من بُكاها",10,"ا",3,0],["وَرَآهُ كَمْ رُؤيَا كَذُوبٌ نَاهِجاً","نهْجاً يُفِيدُ الجِيلَ وَالأَعْقَابَا",11,"ب",2,0],["وَرَآهُ مُزْدَاناً بِأَلْوَانِ","الأَشِعَّةِ مَنْ رَآكْ",12,"ك",1,0],["ورَآهُ لِلشُّورَى ظَهِيراً صادِقاً","مُذْ سَاسَ فِي المُلْكِ الأُمُورِ وَدَبَّرَا",13,"ر",2,0],["وراهبة ٍ أغلقتْ دَبْرَها","فكنّا مع الليل زُوّارها",14,"ر",3,0],["وَرَآهُ أَهلاً لِلعُلا فَاِختَصَّهُ","بِعَظيمِ رُتبَتِهِ وَفَضلِ حِبائِهِ",15,"ا",3,0],["ورآه بالإعراض عن","ه حَبِيبُهُ أحْرَى وأوْلَى",16,"ل",2,0],["وَرَآهُ مَيسَرَة الغُلام رَفيقُهُ","وَمِنَ الهَجيرِ يُظِلُّهُ مَلَكانِ",17,"ن",1,0],["وَرَآهُ إِنسان فَأرعدَ هَيبَةً","قالَ الجَليل القَدرِ لِلرُّعبانِ",17,"ن",1,0],["وَرَآهُ كَأَنَّهُ سَدُّ ياجو","جَ وَماجوجَ المُعجِز النُقّابِ",18,"ب",1,0],["وَرآها قَد أَرخصَت كلَّ غالٍ","فَتَغالى في حُسنها المَنعوتِ",19,"ت",1,0],["وَراهُنَّ رَبّي مِثلَ ما قَد وَرَينَني","وَأَحمى عَلى أَكبادِهِنَّ المَكاوِيا",20,"ي",2,0],["وراهبٍ شرقٍ بالدمع لا نُسكا","لكنّه الديرُ سجّانُ اللبانات",21,"ت",1,0],["ورآه مُبشِّراً بكُم جا","ءَ فأَعطَى هُنَيدةَ للبُشْرى",22,"ر",2,0],["ورآهم يصافحون عدوَّ","لم يزلْ يشرب الدِّماءَ شرابا",23,"ب",2,0],["ورآها المخلوق فاهتزّ لا بل","ودّ لو يرتقي إليها طلوعا",24,"ع",2,0],["ورآه البحرُ أَوفَى جمَّةً","منه بالنائل لمّا طفَحا",25,"ح",2,0],["ورآه في زيد بن حارثةٍ هنا","طه النبيُّ وحبَّ فيه معاذا",26,"ذ",2,0],["وَرَآه مجرّداً عَن ثَباتٍ","وَسَدادٍ وَهمةٍ فَاِزدَراه",27,"ا",2,0],["ورآه أحد القو","م فأخفاه احتيالا",28,"ل",2,0],["ورآها ذَهَباً في","لازَوَرْد من رآها",29,"ا",3,0],["ورآه غاية سامية","لا يدانيها علىالمجد قباب",30,"ب",1,0],["ورآها غيرُهم امنيةً","ملكَ النعمةَ فيها من ملك",31,"ك",1,0],["ورآها للسير أقوى المطايا","فمضى وهو غافل للبلايا",32,"ي",2,0],["وَرَآها تُقرى بهامِ ذَويهِ","حَنَقاً في تَخمطٍ وَاِختِيالِ",33,"ل",1,0],["ورآها الجند فاجتازوا بها","عند ذي القرنين هوْلَ المحشر",34,"ر",1,0],["ورآها يافعٌ غض الصبى","قلبه من لاعج الوجد خلي",35,"ل",2,0],["وَرَآهَا لَم تَسلُ عَن رُؤيَةٍ","وَجهاً بِهِ أسرَارُ الجَمَالِ تَمَوَّج",36,"ج",1,0],["ورآهَا مِن بَعْدِ حَوْلٍ وشَهْرَيْ","ن بدَرْجٍ قد كان مِن قبلُ عندي",37,"د",2,0],["وراهم أخيل حديد الفؤاد","يجيل حدود الحديد الحداد",38,"د",1,0],["وَرآهم فَريسةً لِلنفاقِ","قَيَّدَ القَومَ كُلَهُم في وثاقِ",39,"ق",1,0],["وَرآهُ أهلُ السِياسَةِ في مَي","دانِها يَمْتطي أعزَّ مُطَهَّمْ",40,"م",1,0],["وراه ناسٍ يحدّونه","إلين مايكثر هباله",41,"ل",2,0],["وراهب الشرك يهوي في اللظى هربا","من شدة البأس من ذي مِرة أمِر",42,"ر",1,0],["ورآها مدينة ترأب الصد","ع وتُبنىْ بعزمها العلياء",43,"ا",2,0],["ورآه العالم الحر وقد","حرر الأكثر ممن غلبا",44,"ب",2,0],["ورآهُ يحبو في صدارَةِ مَجلِسٍ","فيقولُ : شِبلٌ للمعالي قد رَقى",45,"ق",2,0],["ورآها تنكرت منه لما","عرفت أنه بها مفتون",46,"ن",1,0],["ورآهم من كان يقصد خصمه","فيراه من قبل الوصول قتيلا",47,"ل",2,0],["ورآه كبَّر للصلاة مُهَلَّلاً","في مذبح الشهدا .. فقام مُسَمَّعا !",48,"ع",2,0],["ورآه كم رؤيا كذوب ناهجا","نهجا يفيد اليل والأعقابا",49,"ب",2,0],["وراهنّا على قوم نيام","فيا بئس التطلع والرهان",50,"ن",1,0],["ورا هذا السهر تنهيدتين وخافقٍ محروق","وانا ما اتصوّر انك يا حبيبي ما تصوّرني",51,"ن",2,0],["وَرَاهَنْتُ أَيَّامِيْ بَأَنَّيْ قَدْ أَرَى","سِوَاكَ أَخَاً يَحْنُوْ عَلَيْهَا وَيُحْدِبُ",52,"ب",1,0],["ورآها ولم تكن ذاتَ بعلٍ","ورأته فكان بعلا وخلا !",53,"ل",2,0]]}