{"poems":[[53,"إن هتك الثياب في دهرنا","https://www.aldiwan.net/poem64954.html","الخفيف"],[123,"ولد العبد الذي إنعامكم","https://www.aldiwan.net/poem4355.html","الرمل"],[189,"وثقيل في القلب والعين والسم","https://www.aldiwan.net/poem14124.html","الخفيف"],[333,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[351,"يا نساء الحي عدننيه","https://www.aldiwan.net/poem24115.html","المديد"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95553","الخفيف"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""]],"verses":[["وهو دينٌ وأحسنُ الأمرِ فيه","أن يكون القضاءُ قبل التقاضي",0,"ض",2,0],["وَهوَ دون اسمٍ لِعِلمِي أَنَّهُ","لا يُسَمِّي العَبدَ إلاّ سيدُه",1,"ه",1,0],["وهْو دونَ الكلابِ قَدْرا ولو أن","صفتَ نَزّهتَ عنه ذِكْر الكلاب",2,"ب",1,0],["وهو داج حينا وحينا مضىء","عبقريّ في البخل والإحسان",3,"ن",1,0],["وَهوَ ديني وَهوَ آخِرَتي","وَهَو ناري وَهوَ جَنَّتِيَه",4,"ي",2,0],["وَهوَ دَهِيُّ العِلْمِ وَالتَعَبُّرِ","حَتَّى اسْتَقَامَتْ بِي عَلَى التَيَسُّرِ",5,"ر",1,0],["وهو دار من النعيم أعدت","لذوى القدر من كرام العبادِ",6,"د",1,0],["وهو دواء للذي له أكل","من مرض وللعموم يحتمل",7,"ل",1,0],["وهودرٌّ صانه النظم فما","احسن الشعر إذا لم يبتذل",8,"ل",1,0],["وهو دلظ ثم الوشيظة والناظر","والظام بعده وفظاظ",9,"ظ",1,0],["وهودهُ نحوها بالعز علودها","سعد السعود ومجري الماء في العودِ",10,"د",1,0],["وَهُوِّدَ ( القدسُ) صمتا والهوان غدا","شعارنا فاستبيحَ العُرْبُ كَالغَنَمِ",11,"م",1,0]]}