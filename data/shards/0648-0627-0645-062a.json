spx?id=5434",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5762,"الذبيح الصاعد","https://www.poetsgate.com/ViewPoem.aspx?id=13136",""],[5765,"لوحةٌ للمشهد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=212676",""],[402,"راعنا خطبهم وكان جسيما","https://www.poetsgate.com/ViewPoem.aspx?id=36301",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5881,"تنثر أعذاراً وتختلق","https://www.poetsgate.com/ViewPoem.aspx?id=183796",""],[5906,"آمال نافقة","https://www.poetsgate.com/ViewPoem.aspx?id=188823",""],[5956,"جلستُ على الشط","https://www.poetsgate.com/ViewPoem.aspx?id=183252",""],[5964,"أجدك ما ينفك طيفك سارياً","https://www.poetsgate.com/ViewPoem.aspx?id=181301",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[463,"رقَّ لبغدادَ القضاءُ والقدرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60077&r=&rc=133",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[572,"من ترى ينصفُني من خَليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9428&r=&rc=285",""]],"verses":[["وَاِمتَدَّ مِن نورِ النَبِ","يِّ عَلَيكَ عُنوانٌ مُبينُ",0,"ن",1,0],["وَأَمتَعَني عَلى العَشا بِوَليدَةٍ","فَأُبتُ بِخَيرٍ مِنكِ يا هَوذُ حامِدا",1,"د",2,0],["وَاِمتَطِ العَزمَ جَواداً لِلعُلا","وَاِجعَلِ الحِكمَةَ لِلعَزمِ زِماما",2,"م",2,0],["وَأَمتَعَكُم بِالنيلِ فَهوَ مُبارَكٌ","عَلى أَهلِهِ خِصباً وَرِيّاً وَمَورِدا",3,"د",2,0],["وامتد في تلك البطاح أمامها","ما شئت من ظل وماء جار",4,"ر",1,0],["وَامْتَصِصْ نَهْدَ كُلِّ رَوْدٍ حَصَانٍ","وَدَعِ الجَائِعَ الرَّضِيعَ فَطِيمَا",5,"م",2,0],["وامتلأ الوادي بإمدادهِ","كأنَّه القربةُ ممَّا انْتفخ",6,"خ",1,0],["وامتدح من آل شادٍ ملكاً","طاهر السرِّ كريم العلن",7,"ن",1,0],["وامتناعُ النفسِ مما تشتهي","خشيةَ الإنفاق نقصٌ في النسَبْ",8,"ب",1,1],["وامتثالُ الجميلِ ما في حُلاه","نسخُهُ من جمالهِ الإجمالا",9,"ل",2,0],["وَاِمتَنَعَ السَيرُ عَلى النَواجي","رُبَّ جَوادٍ لاحيقٍ هِملاجِ",10,"ج",1,0],["وَاِمتَلَأَت بِلطَرَبِ الأَنفُسُ","وَأَنتِ في صَمتِكِ لَم تَطرَبي",11,"ي",1,0],["وَاِمتِحانٌ صَعَّبَتهُ وَطأَةٌ","شَدَّها في العِلمِ أُستاذٌ نَكِر",12,"ر",1,0],["وأَمْتَري وَدْقَ سِمْطَيْ لُؤلُؤٍ بَرِدٍ","عَذْبٍ وأَرْشُفُ ثَغْراً قَطُّ ما رُشِفا",13,"ف",2,0],["وامتزج الظلمة بالنور وال","أدوار فيهن الأفاعيلُ",14,"ل",1,0],["وَاِمتِداحي إِيّاكَ حَتّى كَأَنّي","لَم أَكُن أَعلَمَ الجَميعِ بِحالِك",15,"ك",1,0],["وَاِمتِداحيكَ لا لِشَيءٍ وَلَكِن","هَذَيانٌ مِن شاعِرٍ مَجّانِ",16,"ن",1,0],["وَاِمتَعَضَ الزَنبَقُ في قَولِهِ","وَقالَ لِلأَزهارِ يا عُصبَتي",17,"ت",2,0],["وَأَمتَهِنُ الوَردَ الأَغَرَّ إِلَيكُم","مِن أَجلِكِ حَتّى لَحمُهُ قَد تَخَدَّدا",18,"د",2,0],["وَاِمتَدَّ لِلناظِرِ في مَرتَدِّهِ","كَوكَبُ عِفريتَ هَوى لِعِدِّهِ",19,"د",2,0],["وامتد فوق سرير كان أوفقُ لي","على تشعشعهِ من عَرشِ بلقيس",20,"س",1,0],["وأمَتْني إلى الأجْداثِ أُمٌّ","يَعِزّ عَلَيّ أنْ سارَتْ أمامي",21,"م",2,0],["وامتدَّها بابنِ السَّليم راتبا","مشمِّراً عن ساقهِ مُحاربا",22,"ب",2,0],["وامتاز من بينهما فريق","سلاحه العقل والذكاء",23,"ا",2,0],["وامتنعت يثرب في النبوّة","وامتلأت من مظهر وقوّه",24,"ه",1,0],["وَأَمتَثِلُ الأَوامِرَ مِن أَبيها","وَقَد مَلَكَ الهَوى مِنّي زِمامي",25,"م",2,0],["وامتطى صهوةَ الرياحِ جريئاً","وتحدّى الطيورَ في الطيران",26,"ن",1,0],["وامتدادٌ كأنَّه الأمَلُ الطَّا","ئشُ مَا ضاقَ ذَرْعُهُ بمُحَالِ",27,"ل",1,0],["وامتدّ في حضن الطريق وداؤه","حيّ وصفرته من الأموات",28,"ت",1,0],["وامتزجنا والحبّ يضفي علينا","صبوات مرحى وجوّا وديعا",29,"ع",2,0],["وامتدّت الملّة السمحا يرفّ على","جبينها تاج إعظام وإكبار",30,"ر",1,0],["وامتد من باب إلى","باب كغابات النمور",31,"ر",1,0],["وامتطاهم حتى إذا نالَ بغياً","خَلَعَ اللُّجْمَ عنهُمُ والعِذارا",32,"ر",2,0],["وامتنع الّسير على النّواحي","ربّ جواد لاحق هملاج",33,"ج",1,0],["وامتدت الأيدي مص","افحة بيمناها يمينه",34,"ن",2,0],["وامتزاج الروح بالروح كما","تمزج الصهباء بالماء المعين",35,"ن",1,0],["وامتدت الأيدي مسلمةً","واصطكت الأضراس والحنكُ",36,"ك",1,0],["وامتطى صهوة الغرام وأمضى","في هوانا أيامه وشهورَه",37,"ر",2,0],["وَاِمتَنَعتُم مِن أَن يُباحَ لَكُم جا","رٌ بِبيضِ الظُبى وَسُمرِ العَوالي",38,"ل",2,0],["وامتدّ عمري إلى أن نلت من سندي","خليفة اللّه أفياء وأظلالا",39,"ل",2,0],["وامتدتِ الأبصارُ نحوك مدّها","بعد الصيام إلى الهلال لتفطرا",40,"ر",2,0],["وأمت مطامعك الكواذب بالعزا","وأرح بيأسك ساحة الصدر",41,"ر",1,0],["وأمتْ أموركَ في الفؤا","دِ فموتها أحيى لها",42,"ل",3,0],["وامتياز الماس والجوهر","عن باقي الحجر",43,"ر",1,0],["وأمتك المرحومة الوسط التي","سمت قبل اجتازت كمال التشرف",44,"ف",1,0],["وأمته خير القرون وخيرهم","صحابته أزكى الأنام وأورع",45,"ع",1,0],["وأمتد خصبك من ورد ومن كلأ","ولا تمكن من أخفافك النقب",46,"ب",1,0],["وَاِمتَدَّ في نُعماكَ سا","بِغُ ظِلِّها وَحَلا جَناها",47,"ا",3,0],["وَاِمتَلَأَ الدَستُ مِن سَنا قَمَرٍ","يَنجابُ عَن نورِ وَجهِهِ الظُلَمُ",48,"م",1,0],["وَاِمتِداحي لِأَبي الفَض","لِ الجَوادِ المُستَماحِ",49,"ح",1,0],["وَامْتَطِ الْقَصْدَ فِي الأُمُورِ ذَلُولاً","إِنَّمَا يَبْلُغُ الذِينَ امْتَطَوْهُ",50,"و",2,0],["وامتناع الحبيب أصحبني الد","دهر لباس الضنا وقلبا يؤوسا",51,"س",2,0],["وامْتَازَ بالتَّقْوى فَقَلْبٌ واجِبٌ","من خَوْفِ خَالِقِهِ وَجِسْمٌ نَاحِلُ",52,"ل",1,0],["وامتَطَى اللجّة خَضْراء بِما","ألِفَ العَيْشَ لَدَيْهِم أخْضَرا",53,"ر",2,0],["وَاِمتَرى حُزنُهُ مَدامِعَ أَهلِ ال","أَرضِ حَتّى جَرَت دُموعُ السَماءِ",54,"ا",2,0],["وَأَمَّتني عَلى الهُدى","دينٌ مَن هُوَ مَنبَعُ",55,"ع",1,0],["وأمتنا في طريقتهم","ومعافات من الفتن",56,"ن",1,0],["وَاِمتدّ ظلّ عُرى الأمانِ وأينعت","وَاِفتنّ شادي العدلِ في التلحينِ",57,"ن",1,0],["وَاِمتِع بِعُمرٍ قَد تَشيدُ حِصنُهُ","في العِزِّ وَالفَوزِ العَظيمِ مَديدُهُ",58,"د",2,0],["وامتزاجي به وكونيَ فيه","ولك العلم أصل كل نظام",59,"م",1,0],["وَاِمتَصص من رَحيق قَطر لساني","قَهوات تُغنيكَ عَن بنت حانَه",60,"ن",2,0],["وأمُتّ بالقُربى إليك فطالما","جُعل الأديبُ من الأديبِ نَسيبا",61,"ب",2,0],["وَاِمتازَ رَسمي بِهِ وَالشَمس تَرفع عَن","أَرض المَذَلة ظلّاً خَطُهُ السحر",62,"ر",1,0],["وَآمَت صَواديحُ النَّهارِ وَأَعرَضَت","لَوامِعُ يُطوى رَيطُها وَبُرودُها",63,"د",3,0],["وامتثل ما أني عمن دعي لابن عباس","فده أحسن وأسلم من ظنون أو تجساس",64,"س",1,0],["وأمتنا تنام على سرير","تهدهدها المفاتن والفسوق",65,"ق",1,0],["وامتَنَّ بالإِكرام وهو يهنيني","فإذا ندبت فَقُلْ قَتِيلُ عِذَارِهِ",66,"ر",2,0],["وامتثلت منشور ملك الهوى","قائلة من بعد ذا لا عصيت",67,"ت",1,0],["وأمِتْ بجَهدِكَ قُوَّةَ الغَضَبِ الّذي","تحيا البَصيرَةُ والتُّقى بمَماتِهِ",68,"ت",2,0],["وامتَطْيُت الفلاةَ أَقْتَحِمُ الهو","لَ وَلولاهُ مَا امتطيْتُ الفلاتا",69,"ت",2,0],["وامتدَّ يعطو عِزَّةً جيدُها","فهل رأيت الرشَأَ العاطيا",70,"ي",2,0],["وامتدَّ هذا الظلُّ في","بيتك هذا الضخمِ",71,"م",1,0],["وامتدّ باعُ الملك منه بساعدٍ","متوغِّلٍ قبل الحسامِ المخذمِ",72,"م",1,0],["وامتعض المجد لها من طول ما","حاق بها الضيم فثار فانتصرْ",73,"ر",1,0],["وامتدَّ ليلُ السافيا","تِ بجوِّها ونَهارُها",74,"ر",3,0],["وامتلأتْ من شُهبها أفلاكُها","وضُمّت الغيلُ على آسادِها",75,"د",3,0],["وامتزاجٌ كالماء والخمرِ في التحقيقِ","بل كالأرواحِ والأجسامِ",76,"م",1,0],["وامتطوا صهوةَ المعالي وداسوا","وجناتِ الشهورِ والأعوامِ",76,"م",1,0],["وامتدت القوم أسماطا تشيعها","والذكر يرفع أصواتا لصاغيه",77,"ي",2,0],["وامتطيت صوتها","إيه عز من غلبا",78,"ب",2,0],["وَأَمتَعَنا مِن وَجنَتَيهِ بِمِثلِ ما","تَمَزَّجَ كَفّاهُ مِنَ الماءِ وَالخَمرِ",79,"ر",1,0],["وَاِمتَرَتهُ الجَنوبُ حَتّى إِذا ما","وَجَدَت فَودَهُ عَلَيها ثَقيلا",80,"ل",2,0],["وامتَطينَا متنَها سيَّارةً","جَادَ عَنها بِجَناحيهِ البُرَاق",81,"ق",1,0],["واِمتلا رَبْعِيَ الجديبُ من الخِصْ","ب كما أَشتَهيه لا بِاِنتِجاعي",82,"ع",2,0],["وَاِمتَزَجنا حتَّى جَعلتك لمّا","غِبتَ عن مقلتِي لجدِّي ضجيعا",83,"ع",2,0],["وامتلا الكاس ولا كاس هنا","والوِعا فاض وما ثمَّ وعا",84,"ع",2,0],["وامْتِزَاجُ أَنْفُسِنَا بِالصَّفَاءِ","كامْتِزَاجِ صَوْبِ حَياً لِشَمُولِ",85,"ل",1,0],["وامتنعوا فيما أتاه عنهم","أن يجعلوا الحاكم إلا منهم",86,"م",1,0],["وامتنع المختار مع من كانا","يطيعه ووجهوا كيسانا",86,"ن",2,0],["وأَمَتَّ حاسِديَ الَّذي","لم تُكرِموه بالضَّرِيح",87,"ح",1,0],["وامتِعاضٌ مِنَ المَلامَةِ والإع","راضِ والانقباضِ والانحِرافِ",88,"ف",1,0],["وامتحان المحب بالسَب فرضاً","ثمَّ صَفع الرسول أفضلُ سُنه",89,"ن",2,0],["وَاِمتَطى صَهوة الجِياد فَهابَت","بَطشَه الأُسدُ في مبادي صِباه",90,"ا",2,0],["وَاِمتَلا قَلبُهُ مِن الرُعب حَتّى","كادَ ينفلّ عُمرُه وَشباه",90,"ا",2,0],["وَاِمتاز مِن قصب الرهان بِما بِهِ","أَنسى بِأَندلسٍ غَنائمَ طارق",91,"ق",1,0],["وَاِمتاز في الإسعاف مِن خَير وَمن","مال وَأَبطال لقمع عَنيد",92,"د",1,0],["وَاِمتطيت العَزم في تَكميله","مُعرِضاً عَن لو وَعن لَيتَ وَكَم",93,"م",1,0],["وَامتثال لأَمر صَدرٍ كَريم","ناطه بَيننا بإكِرام طالب",94,"ب",1,0],["وَاِمتاز في تَدبيره بِرياسة","وَسِياسة نجحت بِكُل جسيم",95,"م",1,0],["وَاِمتازَ عَن كُل الوَرى بِمَناقب","جلّت عَن الإحصاء في قُرطاس",96,"س",1,0],["وَاِمتَطى غارب العلا في هداها","مِن ضلال بِكُل رَأي سَديد",97,"د",1,0],["وامتدَّتِ الأطلالُ ساجدَةً له","بجِبالِها من قائِمٍ أوْ أقْعَسِ",98,"س",1,0],["وامتد للجوزاءِ نظمُ قطارها","وتلاحقتْ فقطارها مستعمل",99,"ل",1,0],["وامتنعت ملامس الصغيرِ","عسى ترد غارة الكبيرِ",100,"ر",1,0],["وامتلكوا مصر امتلاك قبرصا","وكمَّلوا من أمرهم ما نقصا",101,"ص",2,0],["وامتدت السبْل للركبان واعتدلت","هوج العواصف والأنواء للسفن",102,"ن",1,0],["وامتيازات كل مملكةٍ في","مصرَ أقوى من جحفل جرار",103,"ر",1,0],["وامتزاجٌ مثلما يُمْ","زَجُ بالماءِ العُقار",104,"ر",1,0],["وَاِمتَدّ ذاكَ الصّبحُ يَنشُرُ ضَوءهُ","بِبَشائِرِ الأَفراحِ في أَكوانِها",105,"ن",3,0],["وَاِمتدَّ بِالفَرَحِ العَيشُ الرّغيدُ لَنا","وَأَرغَدُ العَيش بِالأَفراحِ مَعضودُ",106,"د",1,0],["وَأَمتَطي أَدهم اللّيلِ البهيمِ دُجى","وَلا أُريح بِهِ مِن رَكبهِ رَكبي",107,"ب",2,0],