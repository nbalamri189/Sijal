{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[63,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[71,"ما اسم إذا صحفوه كان مجلبة","https://www.aldiwan.net/poem3873.html","البسيط"],[27,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[45,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[28,"يا ابن المراغة والهجاء إذا التقت","https://www.aldiwan.net/poem5645.html","الكامل"],[61,"كر الخطوب على الفوارس","https://www.aldiwan.net/poem51598.html","مجزوء الكامل"],[61,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[49,"سلام على قبر النبي محمد","https://www.aldiwan.net/poem62046.html","الطويل"],[80,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[31,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[50,"يا ليلتي تزداد نكرا","https://www.aldiwan.net/poem62410.html","مجزوء الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142323","الكامل"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[113,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[113,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[179,"أسألت مغنى دمنة وطلولا","https://www.aldiwan.net/poem59055.html","الكامل"],[193,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[202,"وكأن ريح صنانه من نتنه","https://www.aldiwan.net/poem53027.html","الكامل"],[208,"ألا بالحمى إن جزت يا راكب الوجنا","https://www.aldiwan.net/poem13296.html","الطويل"],[227,"وضعيفة الألحاظ ساحرة","https://www.aldiwan.net/poem51042.html","أحذ الكامل"],[346,"أيا سيد الوزراء استمع","https://www.aldiwan.net/poem19885.html","المتقارب"],[348,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[362,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[403,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[434,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[462,"ولم أر يوماً كان أبهج منظراً","https://www.aldiwan.net/poem3507.html","عموديه"],[466,"النبت بين مفضض ومذهب","https://www.aldiwan.net/poem60430.html","الكامل"],[513,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[527,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[534,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[536,"يا رب أنت رازق العباد","https://www.aldiwan.net/poem47427.html","عموديه"],[549,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[556,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[567,"إن أبانا بكر آدم فاعلموا","https://www.aldiwan.net/poem52001.html","الطويل"]],"verses":[["وَكانَ راعي كُلَّ تَرعِيَّةٍ","في الناسِ أَو كانَ إِمامَ الإِمام",0,"م",1,0],["وَكَأَنَّ رُمحَكَ حالِبٌ لِدَمِ الطُلى","وَكَأَنَّ سَيفَكَ في الجَماجِمِ جازِرُ",1,"ر",1,0],["وكأن راويها يطوفُ علَيْهِمُ","بابْنِ الغَمامةِ وابْنَةِ الزَّرْجونِ",2,"ن",1,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَد","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",3,"م",1,0],["وَكَانَ رَسُولُ اللهِ بِالشِّعْرِ يَعْتَنِي","وَكَمْ حُجَّةٍ فِي شِعْرِ كَعْبٍ وَحَسَّانِ",4,"ن",1,0],["وَكانَ رَأسَ العمى في جاهِلِيَّتِهِ","فَصارَ في مُقلَةِ الدينِ الحَنيفِ قَذى",5,"ذ",2,0],["وَكَأَنَّ رَكبَكَ وَالمَهارى تَفتَلي","هاجوا مِنَ الأُدَمى النِعامَ الأُبَّدا",6,"د",2,0],["وَكَأَنَّ رَوحَتَهُنَّ بَينَ يَلَملَمٍ","وَالنَعفِ ذي السَرَحاتِ أَوبُ نَعامِ",7,"م",1,0],["وَكَأَنَّ رَيِّضَها إِذا باشَرتَها","كانَت مُعاوِدَةَ الرَحيلِ ذَلولا",8,"ل",2,0],["وكان رضاء فيك أنك قابض","عليها جميعا واحدا بعد واحد",9,"د",1,0],["وَكَأَنَّ رَفرَفَهُ رِواقٌ مِن ضُحىً","وَكَأَنَّ حائِطَهُ عَمودُ صَباحِ",10,"ح",1,0],["وَكَأَنَّ رَيعانَ الصِبا رَيحانُهُ","سِرَّ السُرورِ يَجودُهُ وَيَقوتُهُ",11,"ت",2,0],["وَكَأَنَّ راحَ القاطِفينَ فَرَغنَ مِن","أَثمارِهِ صُبحاً وَمِن أَرطابِهِ",12,"ب",2,0],["وَكانَ رَجائي أَن أَؤوبَ مُمَلَّكاً","فَصارَ رَجائي أَن أَأوبَ مُسَلَّما",13,"م",2,0],["وَكَأَنَّ راياتِ الهُذَيلِ إِذا بَدَت","فَوقَ الخَميسُ كَواسِرُ العِقبانِ",14,"ن",1,0],["وكأن راحة ريحه","عبثت ببساتين البسابس",15,"س",1,0],["وكان رياضاً غضَّةً فتكدَّرَتْ","موارِدُها واصفرَّ في تُربها العُشبُ",16,"ب",1,0],["وَكانَ رَسولُ اللَهِ أَفضَلَ مَن مَشى","عَلى الأَرضِ إِلّا أَنَّهُ لَم يُخَلَّدِ",17,"د",1,0],["وكأنّ ركنَ أناتِهِ سَبَلٌ","بموارِدِ المَعروفِ يَنفَجِرُ",18,"ر",1,0],["وَكَأَنَّ ريقَتَها صَبيرُ غَمامَةً","بَرَدَت عَلى صَحوٍ بُعَيدَ ضَحاءِ",19,"ا",2,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ قارِحٍ","بِالشَيِّطَينِ نُهاقُهُ التَعشيرُ",20,"ر",1,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ لاحِبٍ","لَفَحَ الهَجيرُ بِمَشعَلٍ أَجّاجِ",21,"ج",1,0],["وَكَأَنَّ رَجعَ حَديثِها","قِطَعُ الرِياضِ كُسينَ زَهرا",22,"ر",2,0],["وكانَ رأياً لم يكُنْ من صاحبِ","ساعدَهُ عليهِ غير الحاجبِ",23,"ب",1,0],["وكأن راهبةً هناك سجينةً","مغمورةً بدموعها وعذابها",24,"ه",2,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَداً","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",25,"م",1,0],["وكانَ رَسُولُ اللهِ قد قَالَ أَقبِلُوا","فولّوا إنّما أنتَ سَاحرُ",26,"ر",1,0],["وكأنّ روحي شعلةٌ مجنونةٌ","تطغَى فتُضرمُني بما تتضرّمُ",27,"م",1,0],["وكأن ركبك لا يسير على الثرى","وكأن جبريلاً لركبك حاد",28,"د",1,0],["وكأنَّ رحلي فوق أحقبَ قارحٍ","بالشَّيِّطَيْن نُهَاقُهُ تَعْشِيْرُ",29,"ر",1,0],["وكَأَنَّ رُبًّا أَوْ كُحَيْلاً مُقْعَداً","حَشَّ الوَقُودُ بِهِ جَوَانِبَ قُمْقُمِ",30,"م",1,0],["وَكَانَ رَجَائي أنْ أؤوبَ مُمَلَّكاً،","فَصَارَ رَجَائي أنْ أؤوبَ مُسَلَّمَا",31,"م",2,0],["وَكَانَ رَفِيقٌ مِنْهُمُ مُتَأَلِّمَا","يَرَى آسِفاً ذَاكَ الدِّعَابَ المُذَمَّمَا",32,"م",2,0],["وكأن روحي للولوه اسيرة","وكان قلبي للجوى مخلوق",33,"ق",1,0],["وكان رفيق الغار للطهر وحده","ولله كم في خلوة الغار من سر",34,"ر",1,0],["وكأَنَّ رَيّا مِن خُزامَى خالطت","رَيحَانَ رَوضِ قرَارةٍ مَوبولا",35,"ل",2,0],["وَكَأَنَّ رَنَّةَ ما يُصبنَ مِنَ الحَصى","في كُلِّ فَدفَدَةٍ صَليلُ دَراهِمِ",36,"م",1,0],["وكأنَّ ريح صنانِه من نتنِه","في أنف باكيةٍ سعوطٌ يُنشقُ",37,"ق",1,1],["وكان رسول الله ركنهم الذي","به يتقون البأس اكرم به ركنا",38,"ن",2,0],["وكأنّ رقَةَ لفظها جمعت","طِيبَ الوصال ولذّةَ البِشر",39,"ر",1,0],["وَكانَ رَسُولي بِخَطِّ الوَزِيرِ","يُوَجَّهُ مُلْتَمساً لِلجَوابِ",40,"ب",1,0],["وَكأَنَّ رَحلي فَوقَ ذي جُدُدٍ","بشَواهُ وَالخَدَّينِ كالنقسِ",41,"س",1,0],["وكان رجاءً لي فَفُتُّ بفَوتْهِ","كأنّيَ كنتُ اسْماً وكان هو المَعْنى",42,"ن",2,0],["وَكأَنَّ رمحك إِذ تَغَلغَل فيهم","سلك ينظمهم وَهم تقصارُ",43,"ر",1,0],["وكان رجائي أن تعيش ولا يرى","الصرف الليالي في جنابك مطمع",44,"ع",1,0],["وكأن ريح جنوبها يد حالبٍ","قد قام يمسح شطرها وينالها",45,"ل",3,0],["وكأنَّ رأيك لم يلُحْ قَبَساً إذا","عَمِيتْ عشايا الرأي والأسحارُ",46,"ر",1,0],["وكان رمحاً فوق متن نظيمةٍ","زغفٍ قضيبُ ألبان فوق المنهل",47,"ل",1,0],["وكان رداءُ الملح أزرقَ مصمتاً","وها ردنهُ بالعذب أزرقُ معلم",48,"م",1,0],["وَكأَنَّ ريحَ الراحِ في إِبريقِها","نَدٌّ تَضَوَّعَ مِن جَوانِبِ مِشجَبِ",49,"ب",1,0],["وكأن راحة كفه لعفاته","بحر تدفق من تدفق بحره",50,"ر",2,0],["وكَأَنَّ رَجْعَ حَدِيثِها","إنْ مَرّ بالْمَصْروعِ يَشْفَى",51,"ف",2,0],["وَكانَ رَسولُ اللَهِ يَدعوهُمُ إِلى الر","رَشادِ وَلا يَألو مَساءً وَمَسفَرا",52,"ر",2,0],["وكانَ رِزقي آتياً فَقَطَّعَه","بعضُهمُ عَمداً وعَني مَنَعَه",53,"ه",1,0],["وَكانَ رَأسيَ لَيلاً","ما فيهِ للعينِ شُهْبُ",54,"ب",1,0],["وكان روحاً مجرداً وهدى","إشراقه زائد وتنويره",55,"ر",2,0],["وَكانَ رديني كأَنَّ كعوبه","قطا سابق مستورد الماء صائفُ",56,"ف",1,0]]}