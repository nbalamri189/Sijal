68","الكامل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17763","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101153","الطويل"],[4955,"إن تسألوا مني الفؤاد يجبكم","https://www.poetsgate.com/ViewPoem.aspx?id=188745",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[585,"لك الله من ربحٍ عددناه مغنما","https://www.poetsgate.com/ViewPoem.aspx?id=161857",""],[5121,"لِلْكَرَوَانِ فُلَّة","https://www.poetsgate.com/ViewPoem.aspx?id=179415",""],[4045,"هنيئا أمير المؤمنين لك الظّفر","https://www.poetsgate.com/ViewPoem.aspx?id=200278",""],[5302,"صراع نفس","https://www.poetsgate.com/ViewPoem.aspx?id=202725",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5376,"ديار وما ليلى بها بتدلل","https://www.poetsgate.com/ViewPoem.aspx?id=194872",""],[5431,"مازلتَ تحبو بالشغاف معلّقا","https://www.poetsgate.com/ViewPoem.aspx?id=198124",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5582,"لِمَن الهَوادِجُ وَالقبب","https://www.poetsgate.com/ViewPoem.aspx?id=63458",""],[5653,"والنفس عادمة الكمال وإنما","https://www.poetsgate.com/ViewPoem.aspx?id=26443",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[402,"جرى حكم الحديد على النياق","https://www.poetsgate.com/ViewPoem.aspx?id=36034",""],[402,"أشيري إلى عاصي الهوى يتطوع","https://www.poetsgate.com/ViewPoem.aspx?id=36339",""],[6070,"العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=187816",""]],"verses":[["وَكانَ راعي كُلَّ تَرعِيَّةٍ","في الناسِ أَو كانَ إِمامَ الإِمام",0,"م",1,0],["وَكَأَنَّ رُمحَكَ حالِبٌ لِدَمِ الطُلى","وَكَأَنَّ سَيفَكَ في الجَماجِمِ جازِرُ",1,"ر",1,0],["وكأن راويها يطوفُ علَيْهِمُ","بابْنِ الغَمامةِ وابْنَةِ الزَّرْجونِ",2,"ن",1,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَد","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",3,"م",1,0],["وَكَانَ رَسُولُ اللهِ بِالشِّعْرِ يَعْتَنِي","وَكَمْ حُجَّةٍ فِي شِعْرِ كَعْبٍ وَحَسَّانِ",4,"ن",1,0],["وَكانَ رَأسَ العمى في جاهِلِيَّتِهِ","فَصارَ في مُقلَةِ الدينِ الحَنيفِ قَذى",5,"ذ",2,0],["وَكَأَنَّ رَكبَكَ وَالمَهارى تَفتَلي","هاجوا مِنَ الأُدَمى النِعامَ الأُبَّدا",6,"د",2,0],["وَكَأَنَّ رَوحَتَهُنَّ بَينَ يَلَملَمٍ","وَالنَعفِ ذي السَرَحاتِ أَوبُ نَعامِ",7,"م",1,0],["وَكَأَنَّ رَيِّضَها إِذا باشَرتَها","كانَت مُعاوِدَةَ الرَحيلِ ذَلولا",8,"ل",2,0],["وكان رضاء فيك أنك قابض","عليها جميعا واحدا بعد واحد",9,"د",1,0],["وَكَأَنَّ رَفرَفَهُ رِواقٌ مِن ضُحىً","وَكَأَنَّ حائِطَهُ عَمودُ صَباحِ",10,"ح",1,0],["وَكَأَنَّ رَيعانَ الصِبا رَيحانُهُ","سِرَّ السُرورِ يَجودُهُ وَيَقوتُهُ",11,"ت",2,0],["وَكَأَنَّ راحَ القاطِفينَ فَرَغنَ مِن","أَثمارِهِ صُبحاً وَمِن أَرطابِهِ",12,"ب",2,0],["وَكانَ رَجائي أَن أَؤوبَ مُمَلَّكاً","فَصارَ رَجائي أَن أَأوبَ مُسَلَّما",13,"م",2,0],["وَكَأَنَّ راياتِ الهُذَيلِ إِذا بَدَت","فَوقَ الخَميسُ كَواسِرُ العِقبانِ",14,"ن",1,0],["وكأن راحة ريحه","عبثت ببساتين البسابس",15,"س",1,0],["وكان رياضاً غضَّةً فتكدَّرَتْ","موارِدُها واصفرَّ في تُربها العُشبُ",16,"ب",1,0],["وَكانَ رَسولُ اللَهِ أَفضَلَ مَن مَشى","عَلى الأَرضِ إِلّا أَنَّهُ لَم يُخَلَّدِ",17,"د",1,0],["وكأنّ ركنَ أناتِهِ سَبَلٌ","بموارِدِ المَعروفِ يَنفَجِرُ",18,"ر",1,0],["وَكَأَنَّ ريقَتَها صَبيرُ غَمامَةً","بَرَدَت عَلى صَحوٍ بُعَيدَ ضَحاءِ",19,"ا",2,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ قارِحٍ","بِالشَيِّطَينِ نُهاقُهُ التَعشيرُ",20,"ر",1,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ لاحِبٍ","لَفَحَ الهَجيرُ بِمَشعَلٍ أَجّاجِ",21,"ج",1,0],["وَكَأَنَّ رَجعَ حَديثِها","قِطَعُ الرِياضِ كُسينَ زَهرا",22,"ر",2,0],["وكانَ رأياً لم يكُنْ من صاحبِ","ساعدَهُ عليهِ غير الحاجبِ",23,"ب",1,0],["وكأن راهبةً هناك سجينةً","مغمورةً بدموعها وعذابها",24,"ه",2,0],["وكَأَنَّ رَحْلِيَ فَوْقَ أَحْقَبَ قَارِحٍ","يَحْدُو سلائِبَ مِنْ بَنَاتِ الأَخْدَرِ",25,"ر",1,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَداً","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",26,"م",1,0],["وكانَ رَسُولُ اللهِ قد قَالَ أَقبِلُوا","فولّوا إنّما أنتَ سَاحرُ",27,"ر",1,0],["وكأنّ روحي شعلةٌ مجنونةٌ","تطغَى فتُضرمُني بما تتضرّمُ",28,"م",1,0],["وكأن ركبك لا يسير على الثرى","وكأن جبريلاً لركبك حاد",29,"د",1,0],["وكأنَّ رحلي فوق أحقبَ قارحٍ","بالشَّيِّطَيْن نُهَاقُهُ تَعْشِيْرُ",30,"ر",1,0],["وكَأَنَّ رُبًّا أَوْ كُحَيْلاً مُقْعَداً","حَشَّ الوَقُودُ بِهِ جَوَانِبَ قُمْقُمِ",31,"م",1,0],["وَكَانَ رَجَائي أنْ أؤوبَ مُمَلَّكاً،","فَصَارَ رَجَائي أنْ أؤوبَ مُسَلَّمَا",32,"م",2,0],["وَكَانَ رَفِيقٌ مِنْهُمُ مُتَأَلِّمَا","يَرَى آسِفاً ذَاكَ الدِّعَابَ المُذَمَّمَا",33,"م",2,0],["وكأن روحي للولوه اسيرة","وكان قلبي للجوى مخلوق",34,"ق",1,0],["وكان رفيق الغار للطهر وحده","ولله كم في خلوة الغار من سر",35,"ر",1,0],["وكأَنَّ رَيّا مِن خُزامَى خالطت","رَيحَانَ رَوضِ قرَارةٍ مَوبولا",36,"ل",2,0],["وَكَأَنَّ رَنَّةَ ما يُصبنَ مِنَ الحَصى","في كُلِّ فَدفَدَةٍ صَليلُ دَراهِمِ",37,"م",1,0],["وكأنَّ ريح صنانِه من نتنِه","في أنف باكيةٍ سعوطٌ يُنشقُ",38,"ق",1,1],["وكان رسول الله ركنهم الذي","به يتقون البأس اكرم به ركنا",39,"ن",2,0],["وكأنّ رقَةَ لفظها جمعت","طِيبَ الوصال ولذّةَ البِشر",40,"ر",1,0],["وَكانَ رَسُولي بِخَطِّ الوَزِيرِ","يُوَجَّهُ مُلْتَمساً لِلجَوابِ",41,"ب",1,0],["وَكأَنَّ رَحلي فَوقَ ذي جُدُدٍ","بشَواهُ وَالخَدَّينِ كالنقسِ",42,"س",1,0],["وكان رجاءً لي فَفُتُّ بفَوتْهِ","كأنّيَ كنتُ اسْماً وكان هو المَعْنى",43,"ن",2,0],["وَكأَنَّ رمحك إِذ تَغَلغَل فيهم","سلك ينظمهم وَهم تقصارُ",44,"ر",1,0],["وكان رجائي أن تعيش ولا يرى","الصرف الليالي في جنابك مطمع",45,"ع",1,0],["وكأن ريح جنوبها يد حالبٍ","قد قام يمسح شطرها وينالها",46,"ل",3,0],["وكأنَّ رأيك لم يلُحْ قَبَساً إذا","عَمِيتْ عشايا الرأي والأسحارُ",47,"ر",1,0],["وكان رمحاً فوق متن نظيمةٍ","زغفٍ قضيبُ ألبان فوق المنهل",48,"ل",1,0],["وكان رداءُ الملح أزرقَ مصمتاً","وها ردنهُ بالعذب أزرقُ معلم",49,"م",1,0],["وَكأَنَّ ريحَ الراحِ في إِبريقِها","نَدٌّ تَضَوَّعَ مِن جَوانِبِ مِشجَبِ",50,"ب",1,0],["وكأن راحة كفه لعفاته","بحر تدفق من تدفق بحره",51,"ر",2,0],["وكَأَنَّ رَجْعَ حَدِيثِها","إنْ مَرّ بالْمَصْروعِ يَشْفَى",52,"ف",2,0],["وَكانَ رَسولُ اللَهِ يَدعوهُمُ إِلى الر","رَشادِ وَلا يَألو مَساءً وَمَسفَرا",53,"ر",2,0],["وكانَ رِزقي آتياً فَقَطَّعَه","بعضُهمُ عَمداً وعَني مَنَعَه",54,"ه",1,0],["وَكانَ رَأسيَ لَيلاً","ما فيهِ للعينِ شُهْبُ",55,"ب",1,0],["وكان روحاً مجرداً وهدى","إشراقه زائد وتنويره",56,"ر",2,0],["وَكانَ رديني كأَنَّ كعوبه","قطا سابق مستورد الماء صائفُ",57,"ف",1,0],["وكانَ رسولُ اللّه يوصي بحبّه","وَعَن بُغضهِ ينهى الأنام ويمنعُ",58,"ع",1,0],["وَكَأنَّ راحَةَ أحمَدٍ بِنَوالِها","خُورُ السِّحابِ حَدى بِه ميكالُه",59,"ل",2,0],["وكان رفيقي في حياتي وحَبَّذا","لَوِ اسطَعتُ أن أبقى برفقتهِ الدهرا",60,"ر",2,0],["وَكانَ رَماني مِن كِنانة نبله","بِما فيهِ لي حَتفي وَفيهِ نَجاها",61,"ا",3,0],["وكان روحاً له من بسطةٍ جسد","إذ عطلاه فلا روح ولا جسدُ",62,"د",1,0],["وكأنَّ راحَتَهُ الذِراعُ إِفاضَةً","وكأنَّما الأنْوَاءُ منها الأنْمُلُ",63,"ل",1,0],["وكأنَّ راسِمَ خَطِّهِ إقْلِيْدِسٌ","فَمَوَاثِلُ الأَشْكالِ فيه فُنُوْنُ",64,"ن",1,0],["وكان رأيي أن للنساءِ","حكماً على مستعذبي الدماءِ",65,"ا",2,0],["وَكَأَنَّ ريقَتَها عَلى عَلَلِ الكَرى","عَسَلٌ مُصَفّىً في القَلالِ وَقَرقَفُ",66,"ف",1,0],["وَكَأَنَّ رُمحَكَ مُنقَعٌ في عُصفُرٍ","وَكَأَنَّ سَيفَكَ سُلَّ مِن فِرصادِ",67,"د",1,0],["وكَأنَّ رَاحَتَهُ وَأنْمُلَ كَفِّهِ","بحر تُمَدُّ لَهَا بِهِ خِلْجَان",68,"ن",1,0],["وَكأنّ ريقَتَها غديرُ غمامةٍ","شيبَت مشاربه بمزجِ عقارِ",69,"ر",1,0],["وكَأَنَّ ربَّكَ في الجَما","لِ على اقتراحي مَثَّلَكْ",70,"ك",1,0],["وكأن ريب الدهر في يده","سيف على الأعناق يلتمع",71,"ع",1,0],["وكأنَّ راحتَه الغمامُ وصَوبُها","من خالص الذّهب المُلثُّ الوابلُ",72,"ل",1,0],["وكان رجائي منك ما يُكمد العدى","فعادَ رجائي إن تدومَ على الحبّ",73,"ب",1,0],["وكأنَّ رونق ذلك الحسب الذي","ينهى إليه بها أشاع فرنده",74,"د",2,0],["وكأنّ راكبَهُ المُخِبَّ برَحلهِ","حادي سماحجَ الحقّ الأقراب",75,"ب",1,0],["وكأنَّ ريقتَها إذا وسِنَت","صهباءُ أنحَلَ جرمَها الصَفقُ",76,"ق",1,0],["وكأنَّ ريّاها إذا نشَأَت","نَشرُ الخُزامى جادَها الوَدقُ",76,"ق",1,0],["وكأن روح اللَه في فمه","يحيي به من شاء أو يردي",77,"د",2,0],["وكان روض الصبا يفترُّ مبتهجاً","بها وغصن الندى يهتز تياها",78,"ا",3,0],["وكأن روح اللَه في نفثاته","يدعو به العاصي فيصبح تائبا",79,"ب",2,0],["وكأَنَّ رَيِّقَهُ ولمَّا يَحْتَفِلْ","دُونَ السَّماءِ عُجَاجَةٌ كَدْرَاءُ",80,"ا",2,0],["وكان رسول الله في كل حربه","لإسلام أهل الشرك في الحرب قابل",81,"ل",1,0],["وكأن ربك قد برا","ك كما ابتغيت لما براك",82,"ك",1,0],["وَكانَ رَجائي فيكَ ذُخراً جَعَلتُهُ","مَلاذيَ في دَفع الهُمومِ وَمَفزَعي",83,"ع",2,0],["وكان ربيعنا في كل محل","إذا ضنت بوابلها الغيوم",84,"م",1,0],["وكان رأسك قرس الشمس مشرقة","وكان مطلع ضوء الصبح مغناك",85,"ك",1,0],["وَكَأَنَّ ريقَتَها إِذا رَقَدَت","راحٌ يَفوحُ بِأَطيَبِ النَّسَمِ",86,"م",1,0],["وكأنَّ رُمحَك غُصنُ بانٍ مائدٍ","وطُيورُ أنفُسهم عليه غَوادِ",87,"د",1,0],["وكأنّ رافلة الغصون عرائسٌ","لابن الصليب عواقد الزنارِ",88,"ر",1,0],["وَكانَ رَحى الوَطيسِ إِذا تحامَت","وَلِلهَيجاءِ حينَ تَقومُ ساقا",89,"ق",2,0],["وَكَأَنَّ ريقَتَها إِذا نَبَّهتَها","كَأسٌ يُصَفِّقُها لِشُربٍ صاقي",90,"ق",2,0],["وَكأنَّ رَونقَهُ حِداقُ جَنادِبٍ","يَلمعنَ في مَسجورَةِ الرَمضاءِ",91,"ا",2,0],["وكان رسول اللَه أكرمَ مُنجَبٍ","جرى في ظهور الطيِّبين المناجب",92,"ب",1,0],["وكان رقادي بين كاس وروضة","فصار سهادي بين طرف وصارم",93,"م",1,0],["وكان رأْياً لم آتِهِ عبثاً","وَفَّقَني اللهُ فيهِ لِلْرَشَدِ",94,"د",1,0],["وكان رقيبها في الخد خال","فليس له يطيق الصب رشفا",95,"ف",2,0],["وَكأَنَّ رَسمَ سُطورِها في طِرسِها","وَشيٌ تُنَمِّقُهُ أَكُفُ غَواني",96,"ن",2,0],["وكان رضوانكم رضوانها فلذا","يا مالك الروح مما لا نحب خلت",97,"ت",1,0],["وكان رقيق الطبع يفتر باسماً","يميناً إلى جلاسه ويسارا",98,"ر",2,0],["وكأنَّ رْحلي والقرابَ وَنمرقي","بسراة مخضُوبِ الظَّناببِ أخرجِ",99,"ج",1,0],["وكان رسول الله بين ظهورهم","تروح وتغدو بالجلال محافله",100,"ل",2,0],["وكأن رامية الحمام تهابه","فتكفَّ يوم الرمي عنه نبالا",101,"ل",2,0],["وكأن راكبه على ظهر الصَبا","من سرعةٍ أو فوق ظهر الشمأل",102,"ل",1,0],["وَكَأَنَّ ريحَ لَطيمَةٍ هِندِيَّةٍ","وَذَكِيَّ جادِيٍّ بِنُصعٍ مَجسَدِ",103,"د",1,0],["وكأن رأسك رأسه لو لم يكن","عن منكبيه مميزاً مفصولا",104,"ل",2,0],["وكان رجائي منه بذلا اعده","لقربي اباهيه وخصم اجاذبه",105,"ب",2,0],["وكأنَّ روحي قد غدت هيَ روحها","حالي أنا في الحبِّ طابقَ حالها",106,"ل",3,0],["وكان رجع حنيني الشعر أنفثه","ومنه في كل بيتٍ دمعةٌ تكف",107,"ف",1,0],["وكان رنين المال يثلج صدرنا","ولكنه أمسى أنيناً مذمما",108,"م",2,0],["وَكَأَنَّ رِحْمِيَ مِنْ كَثِيِرِ مَحَبَّتِي","حَمَلَتْ رُبَاعاً حِيِنَ جِئْتَ بُشُورَا",109,"ر",2,0],["وكان رجا بالطّالقان ذخيرة","كنوزا له كانت على الدهر تدّخر",110,"ر",1,0],["وكان رجائي أن أعيش منعما","قريرا ولي في منزل الأمن مضجع",111,"ع",1,0],["وكأنَّ ربَّاً ما عبدنا ليلةً","كلا وإنَّ إلهنا عشتارُ",112,"ر",1,0],["وكأن ربيع العمر يمضي لحاله","وأبقى بكأسي في النوى أتجرع",113,"ع",1,0],["وكأن روحي جنّةٌ في نبعها","اغتسلت ذنوبك بالضياء لتُشرقا",114,"ق",2,0],["وَكأَنَّ رِيقَةَ ثَغْرِها فِي رَشْفِها","عَسَلٌ يُخالِطُ فِي المِزاجِ زُلالا",115,"ل",2,0],["وَكأَنَّ راحَتَهُ غَمامَةُ صَيِّبٍ","تَرَكَ السَّباسِبَ أَبْحُراً مَحْوِيُّها",116,"ي",3,0],["وَكَأَنَّ رَيَّاها إِذا انْتَبَهَتْ","مِنْ رَوْضَةٍ بالحُسْنِ غَنَّاءِ",117,"ا",2,0],["وَكأَنَّ رِيقَةَ ثَغْرِها","صَهْباءُ مِنْ بِنْتِ العِنَبْ",118,"ب",1,0],["وكأن راحته الذراع إفاضة","ً وكأنما الأنوار منها الأنملُ",119,"ل",1,0],["وكان ردت للعناد وعودت للمقدريه","والله أني ما اتنازل لين اعديه السحابه",120,"ب",2,0],["وكان رؤية أولى ححبتنا","ببرء للقلوب وللحداق",121,"ق",1,0],["وكان ربيعا لي فأقوت مرابعي","من الزهر والشدو الرخيم المرجع",122,"ع",1,0],["وكأنَّ رأسَكَ صَخْرةٌ","محشوةٌ (زُبَرَ الحَديدْ)",123,"د",1,0]]}