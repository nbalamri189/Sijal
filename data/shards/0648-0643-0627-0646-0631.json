{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[65,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[73,"ما اسم إذا صحفوه كان مجلبة","https://www.aldiwan.net/poem3873.html","البسيط"],[29,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[29,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[87,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[47,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[30,"يا ابن المراغة والهجاء إذا التقت","https://www.aldiwan.net/poem5645.html","الكامل"],[63,"كر الخطوب على الفوارس","https://www.aldiwan.net/poem51598.html","مجزوء الكامل"],[63,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[51,"سلام على قبر النبي محمد","https://www.aldiwan.net/poem62046.html","الطويل"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[33,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[54,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[52,"يا ليلتي تزداد نكرا","https://www.aldiwan.net/poem62410.html","مجزوء الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62218","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142323","الكامل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[47,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[119,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[119,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[185,"أسألت مغنى دمنة وطلولا","https://www.aldiwan.net/poem59055.html","الكامل"],[199,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[208,"وكأن ريح صنانه من نتنه","https://www.aldiwan.net/poem53027.html","الكامل"],[214,"ألا بالحمى إن جزت يا راكب الوجنا","https://www.aldiwan.net/poem13296.html","الطويل"],[233,"وضعيفة الألحاظ ساحرة","https://www.aldiwan.net/poem51042.html","أحذ الكامل"],[352,"أيا سيد الوزراء استمع","https://www.aldiwan.net/poem19885.html","المتقارب"],[354,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[368,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[410,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[441,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[445,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[467,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[467,"ولم أر يوماً كان أبهج منظراً","https://www.aldiwan.net/poem3507.html","عموديه"],[471,"النبت بين مفضض ومذهب","https://www.aldiwan.net/poem60430.html","الكامل"],[518,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[532,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[539,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[541,"يا رب أنت رازق العباد","https://www.aldiwan.net/poem47427.html","عموديه"],[554,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[561,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[572,"إن أبانا بكر آدم فاعلموا","https://www.aldiwan.net/poem52001.html","الطويل"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17763","الكامل"]],"verses":[["وَكانَ راعي كُلَّ تَرعِيَّةٍ","في الناسِ أَو كانَ إِمامَ الإِمام",0,"م",1,0],["وَكَأَنَّ رُمحَكَ حالِبٌ لِدَمِ الطُلى","وَكَأَنَّ سَيفَكَ في الجَماجِمِ جازِرُ",1,"ر",1,0],["وكأن راويها يطوفُ علَيْهِمُ","بابْنِ الغَمامةِ وابْنَةِ الزَّرْجونِ",2,"ن",1,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَد","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",3,"م",1,0],["وَكَانَ رَسُولُ اللهِ بِالشِّعْرِ يَعْتَنِي","وَكَمْ حُجَّةٍ فِي شِعْرِ كَعْبٍ وَحَسَّانِ",4,"ن",1,0],["وَكانَ رَأسَ العمى في جاهِلِيَّتِهِ","فَصارَ في مُقلَةِ الدينِ الحَنيفِ قَذى",5,"ذ",2,0],["وَكَأَنَّ رَكبَكَ وَالمَهارى تَفتَلي","هاجوا مِنَ الأُدَمى النِعامَ الأُبَّدا",6,"د",2,0],["وَكَأَنَّ رَوحَتَهُنَّ بَينَ يَلَملَمٍ","وَالنَعفِ ذي السَرَحاتِ أَوبُ نَعامِ",7,"م",1,0],["وَكَأَنَّ رَيِّضَها إِذا باشَرتَها","كانَت مُعاوِدَةَ الرَحيلِ ذَلولا",8,"ل",2,0],["وكان رضاء فيك أنك قابض","عليها جميعا واحدا بعد واحد",9,"د",1,0],["وَكَأَنَّ رَفرَفَهُ رِواقٌ مِن ضُحىً","وَكَأَنَّ حائِطَهُ عَمودُ صَباحِ",10,"ح",1,0],["وَكَأَنَّ رَيعانَ الصِبا رَيحانُهُ","سِرَّ السُرورِ يَجودُهُ وَيَقوتُهُ",11,"ت",2,0],["وَكَأَنَّ راحَ القاطِفينَ فَرَغنَ مِن","أَثمارِهِ صُبحاً وَمِن أَرطابِهِ",12,"ب",2,0],["وَكانَ رَجائي أَن أَؤوبَ مُمَلَّكاً","فَصارَ رَجائي أَن أَأوبَ مُسَلَّما",13,"م",2,0],["وَكَأَنَّ راياتِ الهُذَيلِ إِذا بَدَت","فَوقَ الخَميسُ كَواسِرُ العِقبانِ",14,"ن",1,0],["وكأن راحة ريحه","عبثت ببساتين البسابس",15,"س",1,0],["وكان رياضاً غضَّةً فتكدَّرَتْ","موارِدُها واصفرَّ في تُربها العُشبُ",16,"ب",1,0],["وَكانَ رَسولُ اللَهِ أَفضَلَ مَن مَشى","عَلى الأَرضِ إِلّا أَنَّهُ لَم يُخَلَّدِ",17,"د",1,0],["وكأنّ ركنَ أناتِهِ سَبَلٌ","بموارِدِ المَعروفِ يَنفَجِرُ",18,"ر",1,0],["وَكَأَنَّ ريقَتَها صَبيرُ غَمامَةً","بَرَدَت عَلى صَحوٍ بُعَيدَ ضَحاءِ",19,"ا",2,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ قارِحٍ","بِالشَيِّطَينِ نُهاقُهُ التَعشيرُ",20,"ر",1,0],["وَكَأَنَّ رَحلي فَوقَ أَحقَبَ لاحِبٍ","لَفَحَ الهَجيرُ بِمَشعَلٍ أَجّاجِ",21,"ج",1,0],["وَكَأَنَّ رَجعَ حَديثِها","قِطَعُ الرِياضِ كُسينَ زَهرا",22,"ر",2,0],["وكانَ رأياً لم يكُنْ من صاحبِ","ساعدَهُ عليهِ غير الحاجبِ",23,"ب",1,0],["وكأن راهبةً هناك سجينةً","مغمورةً بدموعها وعذابها",24,"ه",2,0],["وكَأَنَّ رَحْلِيَ فَوْقَ أَحْقَبَ قَارِحٍ","يَحْدُو سلائِبَ مِنْ بَنَاتِ الأَخْدَرِ",25,"ر",1,0],["وَكأَنَّ رُبّاً أَو كُحَيلاً مُعقَداً","حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ",26,"م",1,0],["وكانَ رَسُولُ اللهِ قد قَالَ أَقبِلُوا","فولّوا إنّما أنتَ سَاحرُ",27,"ر",1,0],["وكأنّ روحي شعلةٌ مجنونةٌ","تطغَى فتُضرمُني بما تتضرّمُ",28,"م",1,0],["وكأن ركبك لا يسير على الثرى","وكأن جبريلاً لركبك حاد",29,"د",1,0],["وكأنَّ رحلي فوق أحقبَ قارحٍ","بالشَّيِّطَيْن نُهَاقُهُ تَعْشِيْرُ",30,"ر",1,0],["وكَأَنَّ رُبًّا أَوْ كُحَيْلاً مُقْعَداً","حَشَّ الوَقُودُ بِهِ جَوَانِبَ قُمْقُمِ",31,"م",1,0],["وَكَانَ رَجَائي أنْ أؤوبَ مُمَلَّكاً،","فَصَارَ رَجَائي أنْ أؤوبَ مُسَلَّمَا",32,"م",2,0],["وَكَانَ رَفِيقٌ مِنْهُمُ مُتَأَلِّمَا","يَرَى آسِفاً ذَاكَ الدِّعَابَ المُذَمَّمَا",33,"م",2,0],["وكأن روحي للولوه اسيرة","وكان قلبي للجوى مخلوق",34,"ق",1,0],["وكان رفيق الغار للطهر وحده","ولله كم في خلوة الغار من سر",35,"ر",1,0],["وكأَنَّ رَيّا مِن خُزامَى خالطت","رَيحَانَ رَوضِ قرَارةٍ مَوبولا",36,"ل",2,0],["وَكَأَنَّ رَنَّةَ ما يُصبنَ مِنَ الحَصى","في كُلِّ فَدفَدَةٍ صَليلُ دَراهِمِ",37,"م",1,0],["وكأنَّ ريح صنانِه من نتنِه","في أنف باكيةٍ سعوطٌ يُنشقُ",38,"ق",1,1],["وكان رسول الله ركنهم الذي","به يتقون البأس اكرم به ركنا",39,"ن",2,0],["وكأنّ رقَةَ لفظها جمعت","طِيبَ الوصال ولذّةَ البِشر",40,"ر",1,0],["وَكانَ رَسُولي بِخَطِّ الوَزِيرِ","يُوَجَّهُ مُلْتَمساً لِلجَوابِ",41,"ب",1,0],["وَكأَنَّ رَحلي فَوقَ ذي جُدُدٍ","بشَواهُ وَالخَدَّينِ كالنقسِ",42,"س",1,0],["وكان رجاءً لي فَفُتُّ بفَوتْهِ","كأنّيَ كنتُ اسْماً وكان هو المَعْنى",43,"ن",2,0],["وَكأَنَّ رمحك إِذ تَغَلغَل فيهم","سلك ينظمهم وَهم تقصارُ",44,"ر",1,0],["وكان رجائي أن تعيش ولا يرى","الصرف الليالي في جنابك مطمع",45,"ع",1,0],["وكأن ريح جنوبها يد حالبٍ","قد قام يمسح شطرها وينالها",46,"ل",3,0],["وكأنَّ رأيك لم يلُحْ قَبَساً إذا","عَمِيتْ عشايا الرأي والأسحارُ",47,"ر",1,0],["وكان رمحاً فوق متن نظيمةٍ","زغفٍ قضيبُ ألبان فوق المنهل",48,"ل",1,0],["وكان رداءُ الملح أزرقَ مصمتاً","وها ردنهُ بالعذب أزرقُ معلم",49,"م",1,0],["وَكأَنَّ ريحَ الراحِ في إِبريقِها","نَدٌّ تَضَوَّعَ مِن جَوانِبِ مِشجَبِ",50,"ب",1,0],["وكأن راحة كفه لعفاته","بحر تدفق من تدفق بحره",51,"ر",2,0],["وكَأَنَّ رَجْعَ حَدِيثِها","إنْ مَرّ بالْمَصْروعِ يَشْفَى",52,"ف",2,0],["وَكانَ رَسولُ اللَهِ يَدعوهُمُ إِلى الر","رَشادِ وَلا يَألو مَساءً وَمَسفَرا",53,"ر",2,0],["وكانَ رِزقي آتياً فَقَطَّعَه","بعضُهمُ عَمداً وعَني مَنَعَه",54,"ه",1,0],["وَكانَ رَأسيَ لَيلاً","ما فيهِ للعينِ شُهْبُ",55,"ب",1,0],["وكان روحاً مجرداً وهدى","إشراقه زائد وتنويره",56,"ر",2,0],["وَكانَ رديني كأَنَّ كعوبه","قطا سابق مستورد الماء صائفُ",57,"ف",1,0],["وَكَأَنَّ ريقَتَها إِذا نَبَّهتَها","كَأسٌ يُصَفِّقُها لِشُربٍ صاقي",58,"ق",2,0],["وَكَأَنَّ ريحَ لَطيمَةٍ هِندِيَّةٍ","وَذَكِيَّ جادِيٍّ بِنُصعٍ مَجسَدِ",59,"د",1,0]]}