 ...","https://www.poetsgate.com/ViewPoem.aspx?id=199533",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5628,"لقاء في هيروشيما(1)","https://www.poetsgate.com/ViewPoem.aspx?id=178534",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5725,"وتمنعي","https://www.poetsgate.com/ViewPoem.aspx?id=195411",""],[5751,"صلاة الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=214777",""],[402,"هل في الرثاء لقائليه جديد","https://www.poetsgate.com/ViewPoem.aspx?id=35424",""],[5809,"خيبة","https://www.poetsgate.com/ViewPoem.aspx?id=205661",""],[5829,"يا رب أنعم","https://www.poetsgate.com/ViewPoem.aspx?id=157286",""],[5829,"رحلة في تضاريس الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=181380",""],[5956,"بين الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=181865",""],[5956,"اسمكم عمر يذكرني بقول عمر","https://www.poetsgate.com/ViewPoem.aspx?id=194192",""],[5956,"يومُ الخميس يحوز مني رأفتي","https://www.poetsgate.com/ViewPoem.aspx?id=215907",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[199,"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20775",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[5309,"قالوا اترجو من الهك نصرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573557",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[6259,"طرقت خيالاً بعد طول صدودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59364&r=&rc=12",""]],"verses":[["وَأَصابَهُ صَرفُ الرَدى بِرَزيَّةٍ","كَالرُمحِ أَنهَرَ طَعنَةً نَجلاءَ",0,"ا",2,0],["وأصابَهُ رَيْبُ المنيّةِ إذ رَمى","طُوِيَتْ على شَلَلٍ يَمينُ الرّامي",1,"م",2,0],["وإصابَةُ الخُلَفاءِ فيما حاوَلوا","مَقْرونَةٌ بِكِفايَةِ الوُزَراءِ",2,"ا",2,0],["وَآصالُ لَهوٍ في مُسَنّاةِ مالِكٍ","مُعاطاةَ نَدمانٍ إِذا شِئتَ أَو سَبحا",3,"ح",2,0],["وأصابتْ آراؤه مَفْصِلَ الحَقْ","قِ فكم خُطّةٍ به مفصولهْ",4,"ل",2,0],["وأصاخت له السماواتُ والأرْ","ضُ ومن فيهما من السكانِ",5,"ن",1,0],["وَأُصانِعُ الواشينَ فيكِ تَجَمُّلاً","وَهُمُ عَلَيَّ ذَوو ضَغائِنَ دُؤَّبُ",6,"ب",1,0],["وَأَصابَ الرِمالَ كَي يُحيِيها","فَهَما مَيِّت وَقَبرُ",7,"ر",1,0],["واصابته في النهاية منه","نكبات وراءها نكبات",8,"ت",1,0],["وَأَصارَت بَنكَ مِصرٍ كَهفَها","حَبَّذا الرُكنُ وَأَعظِم بِالسَنَد",9,"د",1,0],["وَأَصابَ مِنها ذو الهَوى","ما قَد أَصابَ أَخو الوَقار",10,"ر",1,0],["وَأَصابَ خُرطومُ الذُبابَةِ صَفحَةً","خُلِقَت لِسَيفِ الهِندِ أَو لِذُبابِهِ",11,"ب",2,0],["وأصابَ جبَّارَ المَدا","ئِنِ قائمَ الفئتينِ جالِس",12,"س",1,0],["وَأَصابوا ما لَهُ مِن بَعدِهِ","أَلِغَيٍّ قَد مَضى أَم لِرَشَد",13,"د",1,0],["وأصابَ السودَ سهامُ البي","ضِ بِبَيْنِ البيض وبالنكَدِ",14,"د",1,0],["وَأَصاخوا كَأَنَّما كانَ يَرمي","هِم بِذاكَ التَدبيرِ مِن مَنجَنيقِ",15,"ق",1,0],["وأصابَها مِئَةً له من نفعها","ما جَلَّ عن عَدٍّ وعن إحْصاءِ",16,"ا",2,0],["وأَصابَ الوليدَ خَدْشَةُ سَهْمٍ","قَصَّرَتْ عنها الْحَيَّةُ الرَّقْطاءُ",17,"ا",2,0],["وَأَصابَهُ سِحرُ البَخيلَةِ بَعدَ ما","أَلِفَ الصَلاةَ وَعاذَ بِالمِسباحِ",18,"ح",1,0],["وأصار النهار لَيلاً بهيماً","وأصار اللَيل البَهيم نهارا",19,"ر",2,0],["وأصار فرحتنا بمُقْبلِ يومهِ","مأساةَ مَيتٍ في الشباب الباكرِ",20,"ر",1,0],["وَأَصَابَ عَنْ عُرْضٍ إِيادَ فَأَصْبَحَتْ","مَنْكُوسَةَ الأَعْلامِ فِي سِنْدَادِ",21,"د",1,0],["وَأَصَابُوا لِحِسِّهِمْ مَا اسْتَطَابُوا","مِنْ هَنِيءٍ وَمِنْ مَرِيءٍ بُرَادِ",22,"د",1,0],["وَأَصَابَ مِنْ نُعْمَى فُؤَادٍ قَبْلَهُ","مَا لَمْ يُصِبْ إِلاَّ الكُفَاةُ الصِّيدُ",23,"د",1,0],["وَأَصابَتني الغُمومُ لِمَنعا","كَ وَصابَتكَ أَدمُعي وَالغمامُ",24,"م",1,0],["وأَصَابَ من قَبَس الزَّكَانةِ شُعْلَةً","وَهَّاجَةً فَغَدت فَتيتَ رَمَادِ",25,"د",1,0],["وأصاروا بالتَّرجَماتِ علومَ الرُّو","مِ وِرْداً للنّاهلِ المستفيدِ",26,"د",1,0],["وَأَصابَ في المَيْدانِ فارسَ أُمَّةٍ","رَفَع الكِنَانةَ بَعْدَ طُولِ نِضَالِ",27,"ل",1,0],["واصاع الباغي العتل وان اتت","نحوي النبال على مرام الرامي",28,"م",2,0],["وأصَاخُوا لِسَردِ شِعرِكَ حتى","خَالَكَ الجَاهِلُونَ حَبراً زَعِيمَا",29,"م",2,0],["وأَصالةٌ في الرأى بالسِّ","حر الموشَّى لا تُكادُ",30,"د",1,0],["وأصاب فيها الرأيَ والألبابُ لم","تظفرَ برأيٍ قبلُ غيرِ خِدَاج",31,"ج",1,0],["وآصالُنا في ساحل البحر نَعْتلى","به الرملَ ما بين الكَثيب إلى الوَهد",32,"د",1,0],["وَأَصابَ قُلَّةَ غرَّب بَعَجَت بِهِ","ريحٌ شَآمِيَةٌ فَيامَنَ وَاِنتَحى",33,"ا",1,0],["وأصاختْ إلى الوشاةِ فلجتْ","في التجني ولجَّ في الاعتذارِ",34,"ر",1,0],["وَأَصاخَت حيناً لِتَسمَعَ صَوت اللَ","هِ وَاللَهُ معرِضٌ في السَماءِ",35,"ا",2,0],["وأصالةُ في منطقٍ ما خلتُها","إلا أصالةَ من له سيماه",36,"ا",2,0],["وَأَصابَ الحِجامُ كَلبي فَأَضحى","بَينَ كَلبٍ وَكَلبَةٍ عَيّارَةِ",37,"ر",2,0],["وأصابَ العدلَ في مقتلهِ","ظالمٌ باغٍ تولاهُ الجنون",38,"ن",1,0],["وأصابَهُ سكرُ الغرامِ فلم يُفِقِ","ونَفى الكرى فجفونُه لم تَنْطبقْ",39,"ق",1,0],["وأصابَ بنتي من دفائِن غدرِكم","وجفاءِكم دهياءُ لَيسَ تُطاقُ",40,"ق",1,0],["وَأَصاب دُرُّ الدَمعِ لؤلؤ ثَغرِها","ثُمَّ استَفاضَ فَبَلَّ دُرَّ عُقودِها",41,"د",3,0],["وأُصارمُ الأَحباب لا عن جفوةٍ","منِّي ولا متعرِّضاً لشقاق",42,"ق",1,0],["وإصابةٌ في الرأي تشهدُ أنّهُ","سهمٌ لشاكلةِ الرميّ مسدَّدُ",43,"د",1,0],["وأصاب لذات أتت عن صفوة ال","أفكار من كدر ومن تعقيد",44,"د",1,0],["وأصافيه كلما","غازل الطرف وعده",45,"د",2,0],["وأصاتت الأيامُ بي قم تحتشمْ","وأشارت العلياء خاطرْ تعظُمِ",46,"م",1,0],["وأصاب سِرَّ اللّه من أبنائهمْ","دونَ الرجالِ ثلاثةٌ كُرَماءُ",47,"ا",2,0],["وأصاخَ مِن وَلَهِ الفراقِ وقد نأَى","عنه الخليطُ لباغمٍ ولصادحِ",48,"ح",1,0],["وأصارهمْ طولُ السُّرى من غير أنْ","عرفوا الكلالَ إِلى قوائم ظُلَّعِ",49,"ع",1,0],["وَأَصاحبي دونَ الرّجالِ إِذا اِلتَوى","خطبٌ يُبرّئُ غائباً من حاضرِ",50,"ر",1,0],["وأُصادِي اللّئامَ دَهري فهل يق","ضى بأن بتّ للأكارم جارا",51,"ر",2,0],["وَأُصاحِبُهُم فيها الفَصاحَةَ وَالحِجي","وَبَذلُ اللُهى وَالمُشَرِّفِيُّ المَدَرَّبُ",52,"ب",1,0],["وأصابوا مقاتلي إذ رموني","وأنا إذ رميتهم طاش سهمى",53,"م",2,0],["وأصاب منه جندُه ما لم تُصِبْ","منه جنودُ الأرض مجتمعات",54,"ت",1,0],["وَأَصَابَ مَرْعىً في فنَائِكَ مُمْرِعاً","فَأَخَلَّ فيهِ بالْحُظُوظِ وَأحْمَضَا",55,"ض",2,0],["وأصار غصْنَ الدينِ مخضَرّاً به","ونما فأورَق أحسنَ الإيراقِ",56,"ق",1,0],["وأصاره نورا منيراً هاديا","صلوا عليه وسلموا تسليما",57,"م",2,0],["وأصاب حشاي بقارعةٍ","توري وجداً ترمي شررا",58,"ر",2,0],["وأصانها طوراً تصيخ كأنها","أخو صبوةٍ أصغي لذكرى هوى هند",59,"د",1,0],["وأصات عن قلب تفطر بالظما","وفم تلبد بالعجاج الأقتم",60,"م",1,0],["وأصابعُ المنثورِ تومئ نحونا","حسداً وتغمزها عيونُ النرجسِ",61,"س",1,0],["وَأَصَارَهَا قَاعاً لَعَمْرِي صَفْصَفاً","لِمُرِيدِ سُقْيَاهَا السَّحَابُ عَوَاصِ",62,"ص",1,0],["وأصابت عويمر بن طفيل","غدّةٌ مثل ما تصيب الجمالا",63,"ل",2,0],["وأصاب العيون دمع سخين","ثائر من عصارة الأكباد",64,"د",1,0],["وأصاخت إلى الجنوب تَقَصَّى","أَثَرَ الجدب في أقاصي البلاد",65,"د",1,0],["وأصاب أكباد الأحبة سهمها","إذ لم يجد هدفاً سوى الأكباد",66,"د",1,0],["وأصاب والدها الجنون فقل له","يا مذنباً هيهات ذنبك يغتفر",67,"ر",1,0],["وأصابوا من ساكني مصر أُنساً","نافياً عنهم وحشة الهجرانِ",68,"ن",1,0],["وأصاب الاحرار في ظل","ها أمنا ولاقى المتيمون الظّلالا",69,"ل",2,0],["وأصَالة الرأي الذي آثاره","رَوِيَتْ بما يُجْريه من سلساله",70,"ل",2,0],["وَأصَارَهُم وَالله تَحتَ نِعَالِ أه","لِ الحَقِّ بَعدَ مَلاَبِسِ التِّيجَانِ",71,"ن",1,0],["وَأصَارَهُم تَحتَ الحَضِيضِ وَطَالَمَا","كَانُوا هُمُ الأعلاَمَ لِلبُلدانِ",71,"ن",1,0],["وَأَصابَها السُّلَمِيُّ نَشدَةَ باخِل","شَنعاء طائِرُ ذِكرِها غِرّيدُ",72,"د",1,0],["وأصابع المنثور مس","رعةً تشير إلى الرِّقاب",73,"ب",1,0],["وَأَصارَها وَطءُ الجِيادِ هَشِيمَةً","سَودَاءَ مُعتَبراً لِعَينِ الوَاطي",74,"ط",2,0],["واصا وزير الدولة العليا الذي","قد قصرت عن شأوه الوزراء",75,"ا",2,0],["واصا الوزير الذي لولا تسنمه","فيه الوزارة لاندكت رواسيه",76,"ي",2,0],["واصا عميد مليكنا السامي الذي","قد فاق في سلطانه الاملاكا",77,"ك",2,0],["واصا الوزير العادل الشهم الذي","تتلى مآثره بكل لسان",78,"ن",1,0],["واصابني الثلثين فيك مقدماً","واثم نعوم بنا المتأخر",79,"ر",1,0],["وأصاب من عليا نزار اسدها","بأساً فصبّ على نزار مصايبا",80,"ب",2,0],["وأصابع المنثور تومى أنه","أضحى الزمان لشكرها مستوجبا",81,"ب",2,0],["وأصابع المنثور تومى انه","أضحى من الأفراح أعظم شاكر",82,"ر",1,0],["وأصابع المنثور فيها دائباً","تومي إلى النمام حتى يعرفا",83,"ف",2,0],["وأصابِعُ الأترجِ تحسبُ مدَّةً","للهجر فيها مِثلُه لم يُهجَرِ",84,"ر",1,0],["وأصابَ للرمّان حبّةَ قَلبه","فتفرَّطَتْ منهُ صحاحُ الجوهري",84,"ر",2,0],["وأَصَابَهَا إعصارُهَا ببِلاَدِهَا","جنَّاتِهَا ونَخِيلِهَا وزرُوعِهَا",85,"ع",3,0],["وَأَصاب الست الجهات فوفّى","وَتعدّى السَماء سَبعاً طِباقا",86,"ق",2,0],["وَأَصابَ شاكلة الغُيوب بخاطرٍ","في يَومه للأمر ينظر من غدِ",87,"د",1,0],["واصاب قوس الحاجبين بأسهم","صنعت من الأهدا قلب عميدها",88,"د",3,0],["واصارهُ رأسَ الكنيسةِ كلها","وكذا خلائفُهُ بلا نُكرانِ",89,"ن",1,0],["وَآصالٌ وَأَسحارٌ قصارٌ","بهامات العَنا وَالصَفو عاشا",90,"ش",2,0],["وأصابنا الفشل الذي يقفوه ذل","واضطهاد ليس بالحسبان",91,"ن",1,0],["وَأَصارَ الضِّدَّين نهْبَ تراثي","في إِناء من خَلِّه يَشْرَبانِ",92,"ن",1,0],["وأصاب في أقصى الرشاد مؤرخٌ","هي دمعة سكبت من الآماق",93,"ق",1,0],["وأصابهم حسد النفوس وحاولوا","إغلاق باب من لدى فتاح",94,"ح",1,0],["واصابَ شاكِلَةَ الصَّوابِ مُوَفَّقا","مِنْ بَعْدِ نَبْوَتهِ الحُسامُ النابي",95,"ب",2,0],["وأصاب الشيطانَ في جمراتٍ","مَن رُمى في لهيبها لن يعافي",96,"ف",2,0],["وأصابني سهم الفراق بمقتلٍ","ونأى الذين عددتهم ترياقاً",97,"ق",2,0],["وأصابعُ الأطفالِ قد جَمُدتْ وما","من حِضنِ أمٍّ بالحنانِ يُطَوِّقُ",98,"ق",1,0],["وأصابَها سهمُ النوائبِ بَعدما","بَلَغَتْ من العَلياءِ أيَّ مَكان!",99,"ن",1,0],["وَأصَابِعِي نَايُ العِنَاقِ وَمَا جَنَتْ","كَفّي ثِمَاراً مِنْ كُرومٍ مُغدِقَةْ",100,"ق",2,0],["وأصاخ يطرب من زئيرك عند ما","دوّى الزئير وقيل فاض المرجل",101,"ل",1,0],["وأَصَاخَ سَمْعِي مُرْغَماً لِحَدِيْثِها","كالشَّهْدِ غَيْثاً للْمسامعِ يَهْطُلُ",102,"ل",1,0],["وأصاب قمصر منه برحٌ بارح","حتى سرى منها إلى جونان",103,"ن",1,0],["واصابتْ سهماً خافقهُ","فأتاها يكشفُ أوراقهْ",104,"ق",2,0],["وأصابيع زينب وسواها","من ضروب المآكل الفاخرات",105,"ت",1,0],["وأصابعي البيضاء يرهبها","طيشُ الب