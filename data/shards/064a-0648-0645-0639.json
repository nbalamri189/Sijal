ml","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88595","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54107","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62506","الرجز"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216851",""],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136784",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216400",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92071","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66581","البسيط"],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143526","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198890","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198227","الخفيف"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198186","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119509","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139650",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139590",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139523",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[4767,"الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=179578",""],[4791,"الحسن الحذر","https://www.poetsgate.com/ViewPoem.aspx?id=36958",""],[4791,"الجرح الاول","https://www.poetsgate.com/ViewPoem.aspx?id=36968",""],[5055,"صحم عروس المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=105044",""],[5431,"الحسين...","https://www.poetsgate.com/ViewPoem.aspx?id=215715",""],[4444,"شردت يا هذا شرود البعير","https://www.poetsgate.com/ViewPoem.aspx?id=85447",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""]],"verses":[["يَومُ عاشوراءَ الَّذي لا أَعانَ ال","صَحبُ فيهِ وَلا أَجارَ القَبيلُ",0,"ل",1,0],["يَومٌ عَبوسٌ قَد مَضى","بِفَتىً أَغَرَّ مُحَجَّلِ",1,"ل",1,0],["يوم عاثت ذئاب آثور فيها","عَيْثةً تحمل الشَنار سميجه",2,"ج",2,0],["يومٌ عريضٌ في الفَخارِ طَويلُ","ما تَنقَضي غُرَرٌ لهُ وحُجُول",3,"ل",1,1],["يومَ عايَنْتُ كُماةَ الحرْبِ في","مَعْرَكٍ لو كانَ حَرْباً لم يُرَدْ",4,"د",1,0],["يَؤُمُّ عَيناً بِها زَرقاءَ طامِيَةً","يَرى عَلَيها لُجَينَ الماءِ أَطراقا",5,"ق",2,0],["يَومَ عُبَيدُ اللَهَ كَالمُعتَدي","عَلَيَّ في حُبِّكِ أَو مُعتَدي",6,"د",2,0],["يومٌ على ما شابه سعيد","قد تكدر الأيام وهي عيد",7,"د",1,0],["يوم عليه بنيتْ أيام","لأمةٍ جدودُها قيام",8,"م",1,0],["يومٌ على مصرٍ أغَرُّ مُحجلٌ","لمستْ به الأملَ البعيدَ براجِهَا",9,"ه",2,0],["يوم عريض فى الفخار طويل ... نقضى غرر له وحجول","مسحت ثغور الشام أد معها به ... ولقد تبل الترب وهى همول",10,"ل",1,1],["يومٌ على مصرٍ أغَرُّ مُحجَّلٌ","لمستْ به الأملَ البعيدَ براحِهَا",11,"ح",3,0],["يَوْمَ عَرْضِ الحِسَابِ والخلْقُ صَفَّا","مَنْ تُرَاهُ يُهَانُ ، مَنْ سَيُكَرَّمْ",12,"م",1,0],["يوم عظيم كساه من محاسنه","ملك به في البرايا يُضربَ المَثِلُ",13,"ل",1,0],["يوم عبت دم الذبيح أخي","الذابح وابن المشرد السرمدي",14,"ي",1,0],["يومٌ عَلَت زَفَراتي يا عليُّ به","واستحسنت عَبراتي يا أبا الحَسَنِ",15,"ن",1,0],["يومَ عيدٍ وحكم فصل جديد","يُوسع الروضَ جِدَّةً واقتبالا",16,"ل",2,0],["يومٌ على الإسلام قبلَك فرحةٌ","ويكون بعدك حسرةً وتفجُّعا",17,"ع",2,0],["يومُ عزٍّ اشْبهتْ نُصْرتُه","نصر عز الدين للجار الأذَلْ",18,"ل",1,0],["يومَ عيد العلاءِ والكرم الطَّل","قِ المرجى والسُؤدد الوضاح",19,"ح",1,0],["يوم عظيم لم تلده الأزمنُ","للّه منظره المسر المحزن",20,"ن",1,1],["يومَ عَينَاها بِساطُ السَّما","والرِّمَاحُ السودُ في الهُدُبِ",21,"ب",1,0],["يوم عيد هنئته ألف عام","وافد بالمنى رحابك وفده",22,"د",2,0],["يومُ عيدِ العرشِ يومٌ مُشرِقٌ","نورُه شَرقا وغَربا قد أضَا",23,"ض",2,0],["يومَ عيدِ النَّحرِ وَلَّى راحلاً","وهْوَ للأكبادِ ضحَّى ونَحَرْ",24,"ر",1,0],["يوم عاشور الَّذي قد أَرانا","كل يوم مصابه عاشورا",25,"ر",2,0],["يومَ عُدتمْ للقضاءِ","مرّةً أخرى ببسطَة",26,"ط",2,0],["يومَ عرفناكم تروَّتْ","مهجٌ بالتصديهْ",27,"ي",2,0],["يوم عَدل الوَقت مَ احلاكم","كالعِسَل بالزِّبد مَعيونا",28,"ن",2,0],["يوم عظيم الهولِ من خشيةِ ال","عذاب فيه تقشعر الجلود",29,"د",1,0],["يومٌ على الدُنيا أطلَّ بروعةٍ","ملأت صُراخاً أرضَها وسماءها",30,"ا",3,0],["يوم عاد انبعاث سير المنايا","لاختلاس الأرواحِ قبل خطاها",31,"ا",3,0],["يوم عمرو ولم يكن يوم عمرو","وبعظم من الزمان يطاها",31,"ا",3,0],["يوم عرضي لمن خلقتُ ولمَّا","لم يُبدَّل ما أخرجَت شفتانِ",32,"ن",1,0],["يوم على الطرف الأغر","علا أغر مشهر",33,"ر",1,0],["يَوم عَنّا تَضيقُ مِصرُ وَلا مَه","جَرَ إِلّا رُباهُ أَرضَ الجُدودِ",34,"د",1,0],["يومَ عرس ابن حُسين حيدر","أصيدٌ من سادةٍ صيدٍ كرام",35,"م",1,0],["يومٌ عَلَى فَلك السِّماكِ تطايرتْ","أَفراحُه فأزالتِ الأَتْراحا",36,"ح",2,0],["يوم عَدْنا في الجهاله في سِداد","قبل لا ننظر رَعابيب البنات",37,"ت",1,0],["يَومٌ عَبوسٌ قَمطَريرٌ شَرُّهُ","في الخَلقِ مُنتَشِرٌ عَظيمُ الشانِ",38,"ن",1,0],["يوم عليّ ضياءُ ثغرِ صباحِهِ","أدهى وأحلكُ من ظلامةِ حاليا",39,"ي",2,0],["يَوْمٌ عَلى الرُّومِ تُنْشِي رِيْحُهُ سُحُباً","أَمْطارُهُنَّ مُصِيباتٌ مُصِيباتُ",40,"ت",1,0],["يوم عيدتك نحوسه","وغدت عليك كؤوسه",41,"س",2,1],["يوم عضت على شكائمها الخيل","ورضت من الصدور صدورا",42,"ر",2,0],["يوم علا النقع بحر الصدام","وما إن انضموا وتم النظام",43,"م",1,0],["يوم على أمل منكم ويوم لقى","والشوق بين الرجا واليأس صنوان",44,"ن",1,0],["يومُ ((عيدِ )) الجُلوسِ يومٌ عظيمٌ","قدْ سَما رفْعَةً وبالعِزِّ قد نَمْ",45,"م",1,0],["يومٌ عَدَدْنَاهُ مِنَ الأَعْيادِ بَلْ","أَرْبَى عَلَى الأَعْيادِ بالْلألآءِ",46,"ا",2,0],["يومٌ عليك مباركٌ","ما شئت من فرج وطيب",47,"ب",1,1],["يوم عرس الهمام كاظم فرد الد","دَهر زوج العلى خدينِ السداد",48,"د",1,0],["يوم عاطتنا اميمٌ ريقها","فشربنا من لماها قدحا",49,"ح",2,0],["يوم عرسٍ وحبورٍ ومُنىً","طالبُ المجد به قد ربحا",49,"ح",2,0],["يوم عرسٍ قد قارن المشترى بالس","سعد لألاء غرةٍ غراء",50,"ا",2,0],["يوم عرس الفتى محمدِ مأوى ال","الحمدِ ندب زكا أروماً وطابا",51,"ب",2,0],["يومٌ علىٌّ فيه أضحى على","عرش علاً عن مجده أفصحا",52,"ح",2,0],["يوم عديم الند قد","ثارت به هوجاؤه",53,"ا",3,0],["يوم عاود بين روضه والغدير","الحضور أشواقنا في حفلته",54,"ت",2,0],["يومٍ عن الحب تأمرني وتنهاني","ويومٍ تناولني الإخلاص بكفوفك",55,"ك",1,0],["يوم عرشك تجلى لبسوها زهور","في حماها أهلها كل شبٍ وشيب",56,"ب",1,0],["يؤمُّ على الأعناق سيفا مسلّطا","مهابا كما لو قام في الكون أعوره !!",57,"ر",2,0],["يوم عريبٍ مع احسانها","ان طالت الأيام يوم قصير",58,"ر",1,0],["يومٌ عبوسٌ كأن الموتَ ألبسَهُ","ثوبَ التتار وأصلاهُ مُصلانا",59,"ن",2,0],["يومٍ عبوسٍ مالنا عنه مجناب","والريق وسط الحلق ماله بلالي",60,"ل",2,0]]}