{"poems":[[366,"عج بالعقيق وقف بذات الاجرع","https://www.aldiwan.net/poem68093.html","الكامل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18517","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66300","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73202","الخفيف"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""]],"verses":[["خث المطيّ أَخا الغَرام هنيهَة","وَاِصبِر عَلى حرّ الوَطيس البَلقَع",0,"ع",1,0],["خَثعَمِيٌّ مُغَصَّصٌ جُرجُماني","يُ مُحِلٌّ غَزا مَعَ اِبنِ نُمَيرِ",1,"ر",1,0],["خثم الكلام فسر اليها ذاكراً","ما قلت وارحل ان سئمت ربودا",2,"د",2,0],["خث الأرومة مازهم عنه وهل","ألفيت مع نور النجوم شباخا",3,"خ",2,0],["خثوطُ بانس قد أثمرَ الحُسنَ فلَلَبا","نُ غَدا يُعتزَى إلى خُوطِ بَانِه",4,"ن",2,0],["خ ثمن أبن زهر وله فل ستة","جلت حض لذ بل وفزن شم وُوطلا",5,"ا",1,0]]}