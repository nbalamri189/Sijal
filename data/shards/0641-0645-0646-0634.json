=189296",""],[4796,"صباحي","https://www.poetsgate.com/ViewPoem.aspx?id=180991",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4876,"سيري على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=207496",""],[4930,"إلى العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212929",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[585,"يا نازح الدار هل أحسست بالدار","https://www.poetsgate.com/ViewPoem.aspx?id=161940",""],[5150,"ذكرى دائمة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203768",""],[5270,"لئن كنتُ محتاجاً إلى العلم إنني","https://www.poetsgate.com/ViewPoem.aspx?id=84260",""],[5290,"سريتم وطرفي من كرى العزم ما هبا","https://www.poetsgate.com/ViewPoem.aspx?id=113129",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5413,"هو الشمس إلا أنه ليس يختفي!","https://www.poetsgate.com/ViewPoem.aspx?id=200669",""],[5413,"فما بالُه يزدادُ!","https://www.poetsgate.com/ViewPoem.aspx?id=201571",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5587,"هذي الرسائل","https://www.poetsgate.com/ViewPoem.aspx?id=196819",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5725,"رحيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180108",""],[5744,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=207274",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5829,"ويا نعماه تسكنه الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=164686",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[2220,"إذا كان من ترجونه تحذرونه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11657&r=&rc=531",""]],"verses":[["فَمِن شُهُبٍ كَغُرّانِ المَساعي","وَمِن دُهمٍ كَأَخلاقِ اللِئامِ",0,"م",1,0],["فَمِن شِعابِ نَدىً أَمواهُهُ دُفَعٌ","وَمِن طِعانِ قَناً آبارُهُ خُسُفُ",1,"ف",1,0],["فَمِنْ شِيَمِ الأَيّامِ أَنْ يُسْلَبَ الغِنى","حَسيبٌ وَأَنْ يُكْسَى الهَوانَ أَديبُ",2,"ب",1,0],["فَمَن شَكَّ فيما قُلتُهُ فَقِياسُهُ","عَلى مَعشَرٍ يَنفونَ شَكَّ المُنازِعِ",3,"ع",1,0],["فمن شاء أن يدعو لدين محمد","فيدعو لمولانا الخليفة بالبُقُيا",4,"ي",2,0],["فمن شمس يصافحها طلوع","ومن شمس يعانقها غروب",5,"ب",1,0],["فمن شاء فلْبيكِ الدماءَ نفاسةً","وإن شاءَ فليضْحك إلى فِهْر هائمِ",6,"م",1,0],["فمن شاءَ فليبكِ الدماءَ نفاسةً","ومن شاء فليضحَكْ إلى فهْرِ هائم",7,"م",1,0],["فَمِن شِدَّةِ الهَولِ في صِدقِهِ","رَغِبنا إِلى البَرقِ أَن يَكذِبا",8,"ب",2,0],["فمن شقىّ إلى لص إلى نفق","إلا ظلام بروعى رائح غاد",9,"د",1,0],["فَمَن شاءَ فَليَنظُر إِلَيَّ فَمَنظَري","نَذيرٌ إِلى مَن ظَنَّ أَنَّ الهَوى سَهلُ",10,"ل",1,0],["فَمَن شاءَ فَليَبخَل وَمَن شاءَ فَليَجُد","كَفاني نَداكُم مِن جَميعِ المَطالِبِ",11,"ب",1,0],["فمن شموسٍ قد تُوِّجَتْ ظُلَماً","ومن غصونٍ قد أثمرَتْ عَنَما",12,"م",2,0],["فَمِنْ شَرَفٍ على الجوزاءِ تُنبي","فَوارعُه عن الشرفِ القَديمِ",13,"م",1,0],["فَمِنْ شرقِّيهِ لَهَبٌ","ومن غربيِّهِ صَخَبُ",14,"ب",1,0],["فَمَن شاءَ تَعويجي فَإِنّي مُعَوَّجٌ","وَمَن شاءَ تَقويمي فَإِنّي مُقَوَّمُ",15,"م",1,0],["فمن شادنٍ بابليّ الجفونِ","نفورِ الوصالِ أنيسِ الصدودِ",16,"د",1,0],["فَمَن شاءَ فَليَفخَر بِما شاءَ مِن نَدىً","فَلَيسَ لِحَيٍّ غَيرَنا ذَلِكَ الفَخرُ",17,"ر",1,0],["فَمَنْ شَكَّ فِي حُكْمِ الْقَضَاءِ فَهَذِهِ","جَلِيَّةُ مَا شَاءَ الْقَضَاءُ الْمُحَتَّمُ",18,"م",1,0],["فمَن شاءَ فَلْيُخْبِرْ فإِنِّي حاضِرٌ","ولا شَيءَ أَجْلَى للشُّكُوكِ من الخُبْرِ",19,"ر",1,0],["فَمَنْ شَاعرٌ مِنَّا فَحَمْدُكَ نَاظِمٌ","وَمَنْ نَاثِرٌ مِنَّا فَمَجْدُكَ كَاتِبُ",20,"ب",1,0],["فَمَنْ شَاءَ بُرهاناً عَلَى صَادِقِ الهَوَى","فهذِي الْجُمُوعُ الزاخراتُ دَلائلُهْ",21,"ل",2,0],["فَمنْ شَاء مَجْدَ المُلْكِ في بُعْدِ شَأْوِه","فَهذِي عَوالِيهِ وتِلْكَ قَوَاضِبه",22,"ب",2,0],["فمن شاقه بَردُ النعيم بفارسٍ","فاني إلى حَرِّ العراقين ميّال",23,"ل",1,0],["فَمَن شَاءَ فَليَحفَظ بَسَاتِينَ عِرضِهِ","فَإنَّ جِنَانَ العِرضِ خَيرُ جِنَانِ",24,"ن",1,0],["فمن شمال إلى يمين","ومن يمين إلى شمال",25,"ل",1,0],["فَمَن شَكَّ فيهِ حينَ يُذكرا أَفكَلُ","تُحَمُّ بِهِ أَحشاؤُهُ وَتُقلَقَلُ",26,"ل",1,0],["فَمَن شَكَّ في الإِبراءِ فالحِسُّ يَشهَدُ","تَمَسَّكَ بِالوثقى مِنَ الحَقِّ عُروَةً",26,"ه",1,0],["فمن شاء بعد اليوم فليحيى أو يمت","فما غيشة ترضى ولا ميتة تشنا",27,"ن",2,0],["فمن شاء فلينظر يرى ما يعزه","وإلا فليرى ما يذلهُ",28,"ل",2,0],["فمن شط عنك اليوم جهلا وغرة","اتاك ذليلا في غد راغم الانف",29,"ف",1,0],["فمن شاء فليسئله من كل طالب","ليعلم ما جهلا به يتشدق",30,"ق",1,0],["فمن شك فيها فليجل فيى فكره","ليؤمن بالأقدار من أذنه غصبا",31,"ب",2,0],["فَمَن شاءَ الغِنى دُنيا وأخرى","بِلا تعبٍ فقد وافاهُ سهلا",32,"ل",2,0],["فمن شغل قلبي بما نلتُه","ذهلتُ به عن جميع الأمورِ",33,"ر",1,1],["فمن شاء فليحسد ومن شاء فليَدَعْ","فلست أبالي مَن أَقَلّ وأكثرا",34,"ر",2,0],["فَمَن شَبَّهَ العُمرَ كَأساً يَقِرُّ","قَذاهُ وَيَرسُبُ في أَسفَلِه",35,"ه",1,1],["فمن شاء حرباً فهو قاتل نفسه","ومن شاء سلماً نال ما يتطلب",36,"ب",1,0],["فمن شرفات الشام باتت حدوده","شمالا إلى نجران بل هو يجنب",37,"ب",1,0],["فَمِنْ شِيَمٍ سَعيدَاتِ المَرَامِي","وَمنْ هِمَمٍ بَعيدَاتِ المَرَاقِي",38,"ق",2,0],["فَمن شكر المَعروفَ يَوماً فَقَد أَتى","أَخا العُرف مِن حسن المُكافاة من عَلُ",39,"ل",1,0],["فمن شأنها تبدو وتَخفى عن النُّهى","تشوقُ إلى شرقٍ وتَرغبُ عن غرب",40,"ب",1,0],["فْمن شاءَ فلْيَخْشُنْ ومنْ شاءَ فلْيلِنْ","فما نَقدُنا إنْ قارَضونا بزائفِ",41,"ف",1,0],["فَمَن شامَهُ قال ماءٌ يرفُّ","وَمن شَمَّهُ قال مِسكٌ يشب",42,"ب",1,0],["فمن شِدَّةٍ فيه ومن لين جانبٍ","ومن كرم في طبعه وسخاء",43,"ا",2,0],["فمن شوقٍ إلى وطنٍ وأهلٍ","غَدَوْتُ اليومَ ذا قلبٍ مذاب",44,"ب",1,0],["فمن شهابِ الدولة اليومَ لكم","آخرُ مجدٍ فاقَ ذاك الأوّلا",45,"ل",2,0],["فمن شكا قبيح الفراقِ جاهداً","فإنما أشكو الحسان العينا",46,"ن",2,0],["فمَنْ شِئْتَ منهُم فهو مِصباحُك الّذي","يُفيدُ العُلا نوراً وكوكَبُك الدُرّي",47,"ر",2,0],["فمَنْ شِئْتَ منهم فهْو في السّبْقِ أوّلٌ","ومَنْ شئْتَ منهم فهو في العزّ آخرُ",48,"ر",1,0],["فَمن شاءَ رامَ الوَصل أَو قالَ ظالِماً","لذي وُدِّهِ ذَنب وَلَيسَ لهُ ذَنب",49,"ب",1,0],["فمن شاء أعطاه على رغم غيره","ومن شاء بالحرمان أبدى امتناعه",50,"ع",2,0],["فَمِنْ شُعَب لازِوْرَدِيَّةٍ","تَصَاعَدُ في حالَكٍ مُدْمَجِ",51,"ج",1,0],["فَمَنْ شَافِعِي بين الورى عِنْدَ مالِكي","لنُعمانِ خدّيهِ الشقائقُ تُنْسَب",52,"ب",1,0],["فمن شفيق رواق العدل منبسط","اذ قد رعاه بطرف غير وسنان",53,"ن",1,0],["فمن شمسٍ على غُصْنٍ","ومِنْ غُصْنٍ على دِعْص",54,"ص",1,0],["فَمَن شامَ مِنها أَيَّ عُضوٍ بِطَرفِهِ","فَما هوَ عَمّا قَد رَأى ينقلُ الطّرفا",55,"ف",2,0],["فمَن شَبَّهَ البَحرِيَّ بِالبَحرِ مُخطئٌ","وَلَيسَ لِذا التشبيه عندي اِلْتِفاتُ",56,"ت",1,1],["فمن شهد العِذار فعن","هواهُ غير معذورِ",57,"ر",1,0],["فمن شكا قبح الفراقِ جاهداً","فإنما أشكو الحسان العينا",58,"ن",2,0],["فَمِنْ شِهَاٍب وَمِنْ شَمْسٍ وَمنْ شَرَفٍ","أضَاءَ نُورٌ وَلَكن غَيْرُ مُنْكَسِفِ",59,"ف",1,0],["فمنشا سهادي ناظر متناعس","وأصل بلائي معطف متنعم",60,"م",1,0],["فَمَن شَكَّ فَليَنظُر بِوَجهِ خَليلنا","عُذاراً عَلَيهِ الأُنس أَلقى إِخضِرارَهُ",61,"ر",2,0],["فمن شجرٍ أظهرنَ فيه طَلاقَةً","وكان عَبُوسا قبلَهُن مُقَطَّبا",62,"ب",2,0],["فمن شذا فخرِهم إن رحتِ سائلةً","تجري الصَبا الغضُّ في مغناهُ حاملةً",63,"ه",1,0],["فمِنْ شَعْره \"الليل البهيم\" ومن سنى","مُقَبَّله للحسن نورٌ يمدُّه",64,"د",2,0],["فمن شق ينال الركب منها","ومن شق ينال القاعدونا",65,"ن",2,0],["فمنشية الميدان بالحسن واليها","على الفلك العالى زهت وعلى الفلك",66,"ك",1,0],["فمن شكر المعروف يوماً فقد أتى","أخا العرف من جنس المكافأة من غل",67,"ل",1,0],["فمن شاء وافى الصيد والطيب والنسا","وقد تم حج للإله حججناه",68,"ن",3,0],["فمن شاءَ فَلْيأْخُذْ ومن شَاءَ فَلْيَدعْ","نصائح لم تُبْذَلْ لأَخْذِ كِفاءِ",69,"ا",2,0],["فمن شام أُساق إلى حجاز","وارجع في القيود كما سريت",70,"ت",1,0],["فمن شاء فليقطع ومن شاء فليصلْ","فذلك ستر فيه للذاتِ صونها",71,"ن",3,0],["فمن شاء فليكفر ومن شاء فليقل","بأني على حق يقينٍ من الأمر",72,"ر",1,0],["فمِن شرفِ النبيّ على الوجودِ","ختامُ الأولياءِ من العقود",73,"د",1,1],["فمن شاء فليسمعْ فإني قائلٌ","ومن شاء فلينطِق فحسْبُ الهوى حسبي",74,"ب",2,0],["فمن شرط الأمانة أن يراه","بخيلا في أمانته عيانا",75,"ن",2,0],["فمن شاء فليثبت ومن شاء فليزل","فهذا الذي ساقت إليه المقادر",76,"ر",1,0],["فمن شاء فليرحل ومن شاء فليقم","فإني إلى الله المهيمنِ راحل",77,"ل",1,0],["فمن شاء فليرحل ومن شاء فليقم","فما الأمر إلا كائنٌ وهو بائن",78,"ن",1,0],["فمن شاء فليرحل ومن شاء فليقم","فقد عُرفَ المعنى وقد حُقق القصد",79,"د",1,0],["فمن شأ فليعذر فؤادي على الجوى","ومن شأ فليعذل فما انا راجع",80,"ع",1,0],["فَمَن شاءَ أَن يَلقى جَهَنَّمَ قَبلَ أَن","يَموتَ فَفي حانِ المُدامِ جَهَنَّمُ",81,"م",1,0],["فمن شاء توفيق النصوص وجمعها","أصاب وبالتوفيق شُدَّ له أزر",82,"ر",1,0],["فمن شام منها اليوم برق تبسُّم","ففي الغد تلقاه بوجه جهنَّم",83,"م",1,0],["فمن شاحب ماضي العزيمة خادر","هلال إذا يبدو هزبر اذا يسطو",84,"ط",2,0],["فمن شاء يسلم سلم","ويحظى بنور الحكم",85,"م",1,0],["فَمِن شُباطٍ خامسٌ مُديمُ","يمضي بذاك النَوِّ يا نديمُ",86,"م",1,0],["فمن شباننا جم عديدٌ","تثيرهم الرذيلة والبغاء",87,"ا",2,0],["فمن شاء فلينظر أسوداً بروضة","تراعي عصا راع وتعنو لرائد",88,"د",1,0],["فمن شاءَ يحظى بالسّعادة منهمُ","ليأتُوا بمدح طيّب فيه إِنشاءُ",89,"ا",2,0],["فَمَن شاءَ تَقويمي فَإِنّي مُقَوَّمٌ","وَمن شاءَ تَعويجي فَإِنّي مُعَوَّجُ",90,"ج",1,0],["فمن شاء فليَعصِ ومن شاء فليطع","فكلا يجازي بالذي هو صانع",91,"ع",1,0],["فمَن شاءَهُ للعِلْمِ ألْفى إمامَهُ","يُجَلّي لهُ في كلِّ مُشكلةٍ هدْيا",92,"ي",2,0],["فَمَن شَكَ فَليَسأل بِهِ الرُكن وَالصَفا","وَزَمزم وَالمِيقات وَاللَه حاكم",93,"م",1,0],["فَمَن شأنُهُ الإِقدامُ لا يَتّقي الوَغا","وَمَن شَأنُهُ الإِدراكُ يُدرِكُ مُبهَما",94,"م",2,0],["فَمَن شَأنُه حبُّ المَعالي وَكسبها","يَهوّنُ قَصد الصَعب في نجح مَقصد",95,"د",1,0],["فمن شرفات الفضل لما تزيلوا","إلى دركات الجهل أهوتهمُ الأهوا",96,"و",2,0],["فمن شانهمْ حَوزُ الممالكِ والعُلى","ومن طبعهم بذلُ النَّدى والمكارمُ",97,"م",1,0],["فمنشور ا