{"poems":[[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[78,"عفا الله عن سحر على كل حالة","https://www.aldiwan.net/poem13998.html","الطويل"],[85,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[28,"أبلغ معاوية الذي بيمينه","https://www.poetsgate.com/ViewPoem.aspx?id=21004",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[233,"يا نازحا ليس يدنو","https://www.aldiwan.net/poem31898.html","المجتث"],[268,"قصرت ما طال من هم ومن حزن","https://www.aldiwan.net/poem35262.html","البسيط"],[280,"فؤادي كئيب بالصبابة مدنف","https://www.aldiwan.net/poem32699.html","الطويل"],[374,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[377,"يحار الطرف في دل عجيب","https://www.aldiwan.net/poem48827.html","الوافر"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[462,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[462,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[466,"اسحب أبا عبد الإله","https://www.aldiwan.net/poem59532.html","مجزوء الكامل"],[466,"ما استطعم القصد مثل بشري","https://www.aldiwan.net/poem60003.html","مخلع السريع"],[475,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[480,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[560,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"]],"verses":[["إسحاقُ أُمْتِعْتَ بالسلامةِ وال","أمْنِ ولا فارقَ التُّقى خلدَك",0,"ك",1,0],["أَسِحرٌ ظَلَمتِ النَفس وَاِخترتِ فُرقَتي","فَجَمَّعتِ أَحزاني وَهُنَّ شَوارِدُ",1,"د",1,0],["إِسحاقُ ماتَ فَلا صَبوحَ وَمَعبَدٌ","أَودى فَلَيسَ مَعَ الغَبوقِ فَلاحُ",2,"ح",1,0],["أَسحَبُها عِندَهُ لَدى مَلِكٍ","ثِيابُهُ مِن جَليسِهِ وَجِلَه",3,"ل",2,0],["إِسحاقُ حَيثُ يَقولُ لَمّا هابَهُ","لِأَبيهِ حَيثُ رَأى مِنَ الأَحلامِ",4,"م",1,0],["أَسِحْراً تُرِينَا أَمْ صَحَائِفَ كُلَّمَا","نقَلِّبُهَا وَجْهاً نَرَى عَجَباً بَدَا",5,"د",2,0],["إِسْحَاقُ لم يُوهَبْ عُذوبةَ صَوْتِه","وعِنَانُ لم تُمْنَح جَمَالَ أَدَائه",6,"ا",3,0],["أسحاره فجره أصائله","ليلاته الناغمات أو بكره",7,"ر",2,0],["إسْحَقُ حَيْثُ يَقُولُ لمّا هَابَهُ","لأبِيهِ، حَيْثُ رَأى مِنَ الأحْلامِ",8,"م",1,0],["اسحبي الذيلَ يا قنيطرةَ المجدِ","وكحِّل جفنيك يا حرمونُ",9,"ن",1,0],["أَسِحرُ عَينِكَ يا قا","تِلي أَمِ السَيفُ أَمضى",10,"ض",2,0],["إسحاقُ أم معبدٌ أعطاك حرفتَهُ","فالفنُّ عندك مملوءٌ من الفِتن",11,"ن",1,0],["أَسُحّ دَماً مِن بَينِ جَفنَيَّ سائِلاً","بِخَدّي فَهَل إِنسانُ عَينَيَّ يَرعُفُ",12,"ف",1,0],["إسحاق صَوَّر في يعقوب بَرْكتَه","لما دعاه إلى التبريك والقُبُل",13,"ل",1,0],["أَسحرٌ ما بِطَرفك أَم حُسامٌ","يَسلُّ عَلى القُلوب بِلا ذُنوب",14,"ب",1,0],["اسحب ذيول الثّيه ما ساء العدى","وانهض إذا سرّ الوليّ مشترا",15,"ر",2,0],["أسحّهمُ في كلّ مسغبةٍ حياً","وأثبتهم في كلّ حادثةٍ ركنا",16,"ن",2,0],["أسحُّ الورى كفاً والبق أنملاً","ببيض المواضي والمثقفة اللّدن",17,"ن",1,0],["اِسحَب أَبا عَبدَ الإِلَهِ","أَذيالَ أَثوابِ التَباهي",18,"ا",3,1],["أَسحَبُها رائِحاً فَأَغدو","بَينَ ثَناءٍ وَبَينَ شُكرِ",19,"ر",1,0],["أسحبُ تحتَ ظِلِّهِ","مِنَ السُّرورِ الاُزرا",20,"ر",2,0],["أسحر السحر في جفن الغزال","لقد مغربي بالشمال",21,"ل",1,1],["أسِحْراً كان شُغلي في هَواكا","لَقد تُهِمَتْ بسحِرٍ مُقلتاكا",22,"ك",2,1]]}