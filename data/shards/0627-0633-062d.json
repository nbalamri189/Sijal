{"poems":[[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[80,"عفا الله عن سحر على كل حالة","https://www.aldiwan.net/poem13998.html","الطويل"],[87,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[45,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[30,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[30,"أبلغ معاوية الذي بيمينه","https://www.poetsgate.com/ViewPoem.aspx?id=21004",""],[101,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[240,"يا نازحا ليس يدنو","https://www.aldiwan.net/poem31898.html","المجتث"],[275,"قصرت ما طال من هم ومن حزن","https://www.aldiwan.net/poem35262.html","البسيط"],[287,"فؤادي كئيب بالصبابة مدنف","https://www.aldiwan.net/poem32699.html","الطويل"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[385,"يحار الطرف في دل عجيب","https://www.aldiwan.net/poem48827.html","الوافر"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[469,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[469,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[473,"اسحب أبا عبد الإله","https://www.aldiwan.net/poem59532.html","مجزوء الكامل"],[473,"ما استطعم القصد مثل بشري","https://www.aldiwan.net/poem60003.html","مخلع السريع"],[482,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[487,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[567,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126751","الخفيف"],[1549,"","https://poetry.dctabudhabi.ae/diwan/poem/144358","الطويل"],[1817,"","https://poetry.dctabudhabi.ae/diwan/poem/144631","الرجز"],[1884,"","https://poetry.dctabudhabi.ae/diwan/poem/203971","المنسرح"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177831","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75944","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128241","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35907","المنسرح"],[3758,"","https://poetry.dctabudhabi.ae/diwan/poem/143434","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45070","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28646","المجتث"],[4568,"","https://poetry.dctabudhabi.ae/diwan/poem/143589","الكامل"],[5185,"ودّع جمال","https://www.poetsgate.com/ViewPoem.aspx?id=71966",""],[5189,"ترفّق أيها البدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=197057",""],[5677,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=179981",""],[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""]],"verses":[["إسحاقُ أُمْتِعْتَ بالسلامةِ وال","أمْنِ ولا فارقَ التُّقى خلدَك",0,"ك",1,0],["أَسِحرٌ ظَلَمتِ النَفس وَاِخترتِ فُرقَتي","فَجَمَّعتِ أَحزاني وَهُنَّ شَوارِدُ",1,"د",1,0],["إِسحاقُ ماتَ فَلا صَبوحَ وَمَعبَدٌ","أَودى فَلَيسَ مَعَ الغَبوقِ فَلاحُ",2,"ح",1,0],["أَسحَبُها عِندَهُ لَدى مَلِكٍ","ثِيابُهُ مِن جَليسِهِ وَجِلَه",3,"ل",2,0],["إِسحاقُ حَيثُ يَقولُ لَمّا هابَهُ","لِأَبيهِ حَيثُ رَأى مِنَ الأَحلامِ",4,"م",1,0],["أَسِحْراً تُرِينَا أَمْ صَحَائِفَ كُلَّمَا","نقَلِّبُهَا وَجْهاً نَرَى عَجَباً بَدَا",5,"د",2,0],["إِسْحَاقُ لم يُوهَبْ عُذوبةَ صَوْتِه","وعِنَانُ لم تُمْنَح جَمَالَ أَدَائه",6,"ا",3,0],["أسحاره فجره أصائله","ليلاته الناغمات أو بكره",7,"ر",2,0],["إسْحَقُ حَيْثُ يَقُولُ لمّا هَابَهُ","لأبِيهِ، حَيْثُ رَأى مِنَ الأحْلامِ",8,"م",1,0],["اسحبي الذيلَ يا قنيطرةَ المجدِ","وكحِّل جفنيك يا حرمونُ",9,"ن",1,0],["أَسِحرُ عَينِكَ يا قا","تِلي أَمِ السَيفُ أَمضى",10,"ض",2,0],["إسحاقُ أم معبدٌ أعطاك حرفتَهُ","فالفنُّ عندك مملوءٌ من الفِتن",11,"ن",1,0],["أَسُحّ دَماً مِن بَينِ جَفنَيَّ سائِلاً","بِخَدّي فَهَل إِنسانُ عَينَيَّ يَرعُفُ",12,"ف",1,0],["إسحاق صَوَّر في يعقوب بَرْكتَه","لما دعاه إلى التبريك والقُبُل",13,"ل",1,0],["أَسحرٌ ما بِطَرفك أَم حُسامٌ","يَسلُّ عَلى القُلوب بِلا ذُنوب",14,"ب",1,0],["اسحب ذيول الثّيه ما ساء العدى","وانهض إذا سرّ الوليّ مشترا",15,"ر",2,0],["أسحّهمُ في كلّ مسغبةٍ حياً","وأثبتهم في كلّ حادثةٍ ركنا",16,"ن",2,0],["أسحُّ الورى كفاً والبق أنملاً","ببيض المواضي والمثقفة اللّدن",17,"ن",1,0],["اِسحَب أَبا عَبدَ الإِلَهِ","أَذيالَ أَثوابِ التَباهي",18,"ا",3,1],["أَسحَبُها رائِحاً فَأَغدو","بَينَ ثَناءٍ وَبَينَ شُكرِ",19,"ر",1,0],["أسحبُ تحتَ ظِلِّهِ","مِنَ السُّرورِ الاُزرا",20,"ر",2,0],["أسحر السحر في جفن الغزال","لقد مغربي بالشمال",21,"ل",1,1],["أسِحْراً كان شُغلي في هَواكا","لَقد تُهِمَتْ بسحِرٍ مُقلتاكا",22,"ك",2,1],["أسحرتها بني العروبة لمّا اِس","تَنكَرت فعل خصمِها اِستِنكارا",23,"ر",2,0],["أسح دموعي في طلالك أبتغي","بذلك نفعاً والبكا غير نافع",24,"ع",1,0],["إسحاق لو كنت لقيت حاتما","كان نداه لنداك خادما",25,"م",2,0],["أَسحمُ لا تكدَرُ السَّماءُ إذا","جادَ ولا الشَّمسُ منه تَحتجبُ",26,"ب",1,1],["أسحر حلال، أم هي الخمر حللت","لشاربها لا لغو فيها يؤثم",27,"م",1,0],["أَسحرٌ لِتلكَ العَينِ في القَلبِ أَم وَخز","وَلينٌ لِذاكَ الجسمِ في اللَمسِ أَم خَزُّ",28,"ز",1,1],["أسحر بابل في جفنيك مع سقم","أم السيوف لقتل العرب والعجم",29,"م",1,1],["إِسحاقُ كانَ الذَبيحُ قَد أَجمَعَ الن","ناسُ عَلَيهِ الإِدِّعاءُ لِمَه",30,"م",2,0],["أسِحرٌ بأجفانه أم خُمارُ؟","ومِسكٌ بعارضه أم عِذارُ؟",31,"ر",1,1],["إسحَقِي رُمحَ ذِيُوميذَ الأَلَد","وَاصرَعِيهِ عِند أَبوَابِ البلد",32,"د",1,0],["أَسِحرٌ قَد سَرى مِن جيدِ ريمِ","أَمِ العَرفُ الأَريجُ مِنَ النَسيمِ",33,"م",1,1],["إِسحقَ مِنهُم وَإِسح","قَ ما عَلِمناهُ سِلعَهْ",34,"ع",2,0],["إسحاقُ يأتي مجده بفَعاله","وعليٌّ العالي الذُّرا وأبو علي",35,"ل",2,0],["إسحق يشهد لم تكن متحيزاً","لجماعة أبداً ولا لقرين",36,"ن",1,0],["أسحرٌ أنت يا بدرًا تهاوى","منَ الأحلامِ فانكَشفَ المنامُ",37,"م",1,0],["اسحر بها سامع وشاعر وناقد","ماهو بشرك الا بسحر البياني",38,"ن",2,0],["اِسحَقَنِّي يا حبيبي","كن شجاعا لا كَهاما",39,"م",2,0],["إسحاق . يعقوب . داود المضيء . سلي","مان الحكيم . وهل مثل الخليل أب ؟؟",40,"ب",1,0]]}