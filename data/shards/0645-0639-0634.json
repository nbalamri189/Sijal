22,"","https://poetry.dctabudhabi.ae/diwan/poem/139650",""],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105485","الخفيف"],[4935,"بلسان الشكر نهدي","https://www.poetsgate.com/ViewPoem.aspx?id=129345",""],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[5122,"ذرب القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=17648",""],[5136,"وداع ذات اللمام الصون صبح غد","https://www.poetsgate.com/ViewPoem.aspx?id=121563",""],[5136,"ما للعواذل لا كانوا ولا خلقوا","https://www.poetsgate.com/ViewPoem.aspx?id=121637",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[2365,"نائح في الغصون بالليل ناحا","https://www.poetsgate.com/ViewPoem.aspx?id=200663",""],[5376,"ما اعتدْتُ بعداً عنك يا أمي","https://www.poetsgate.com/ViewPoem.aspx?id=191870",""],[5409,"يا ديار العبيد إن المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=155281",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""],[5459,"ضرع القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=202593",""],[1547,"لا تلمني على الدموع الجواري","https://www.poetsgate.com/ViewPoem.aspx?id=16772",""],[5704,"مَعْشُوقتِي","https://www.poetsgate.com/ViewPoem.aspx?id=191144",""],[5764,"بعطيك قصه !","https://www.poetsgate.com/ViewPoem.aspx?id=162640",""],[5906,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=187982",""],[6006,"مكناس","https://www.poetsgate.com/ViewPoem.aspx?id=214149",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""],[6056,"ملاك الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=130338",""],[6056,"لوحة الإحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=130351",""],[6070,"صوَّرْتُها قَمَراً في دَوحَةِ الشَّجَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189786",""],[6142,"هذه الروضة للسبط أبي الس","https://www.poetsgate.com/ViewPoem.aspx?id=155763",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["مَعشَرٌ إِن بَلَوتَهُم","غَيبَهُم وَالمَبادِيا",0,"ي",2,0],["مَعشَرٌ تَمّوا فَلَم يَنثَمِلوا","ثَلَمَ الأَقمارِ يَنظُرنَ التَماما",1,"م",2,0],["مَعشَرٌ إِن غابَتِ الأَرضُ بِهِم","لَم يَغيبوا عِندَ مَجدٍ وَفَعالِ",2,"ل",1,0],["مَعشَرٍ كانوا قُبَيلَ ال","عِزِّ قِدماً وَفَريقَه",3,"ق",2,0],["مَعشَرٌ فاتَ المَساعي سَعيُهُم","ضَلَّ مَن كاثَرَ رَملاً بِعَدَد",4,"د",1,0],["مَعشَرٌ مِنهُم رَسولُ اللَهِ وَال","كاشِفُ الكَربِ إِذا الكَربُ عَرا",5,"ا",1,0],["معْشَرٌ يجْعَلُ الضّيوفَ أصْدِقاءً","كَرَماً والأمْوالَ بعْضَ الأعادي",6,"د",2,0],["معْشَرٌ يجْعَلُ الحُسام على الطفْ","لِ اعْوذاذا والمَهْدَ ظَهْرَ الجَوادِ",6,"د",1,0],["معْشَر أورِثوا الهِدايَةَ عنْ هو","دٍ فمِنْ مُهْتَدٍ بهِ أو هادي",6,"د",2,0],["مَعَشَّقٌ لِلمَعالي لا يَزالُ لَهُ","في كُلِّ مَرتَبَةٍ عَذراءُ تُختَطَبُ",7,"ب",1,0],["معشر العرب أين أنتم من القو","م إذا ما تمّ انقلاب الزمان",8,"ن",1,0],["معشرٌ كنتُ خلتهم قبل بلوا","يَ أَوِدَّاءَ صِفْوةً أصدقاءَ",9,"ا",2,0],["معشرٌ أشبهوا القُرودَ ولكن","خالفوها في خِفَّةِ الأرواحِ",10,"ح",1,0],["معشر فيهم نُكولٌ إن نَوَوْا","فِعْلَ خيرٍ وعلى الشر مُرودُ",11,"د",1,0],["معشرٌ يغدرُ الشبابُ ويُوْفُو","ن وما المبْرمُون كالنُقّاض",12,"ض",1,0],["معشر قربهم من الناس عرٌّ","لصحيح وقذرة لنظيف",13,"ف",1,0],["معشر ينكرون معرفة العر","ف ويأبى هناك إلا اعترافا",14,"ف",2,0],["مَعشرٌ ما زال منهم","من له العز اللُّهامُ",15,"م",1,0],["مُعشِباتٌ أجنابُه من نداهُ","مُورقاتٌ أقلامُه من بَنانه",16,"ن",2,0],["مَعَ شَوقٍ إِلَيكَ تَقدَحُ في القَل","بِ عَقّابيلُ بَثِّهِ وَنُدوبُ",17,"ب",1,0],["مَعشَرٌ أَمسَكَت حُلومُهُمُ الأَر","ضَ وَكادَت مِن عِزِّهِم أَن تَميدا",18,"د",2,0],["مَعشَرٌ يُنجِزونَ بِالخَيرِ وَالشَر","رِ يَدَ الدَهرِ مَوعِداً وَوَعيدا",18,"د",2,0],["مَعشَرٌ لولا أحاديثُ النَّدى","عنهمُ لم يَعرفِ الناسُ السَّمَر",19,"ر",1,0],["مَعْشَرٌ أصبحوا وُجوداً وأمسَوا","عَدَماً والخُطوبُ فيها اعتبارُ",20,"ر",1,0],["مَع شادِنٍ رُبَّ أَقراطٍ وَمِنطَقَةٍ","وَقَينَةٍ ذاتِ أَحجالٍ وَأَخراصِ",21,"ص",1,0],["مَعشَرٌ أَصبَحَت فَضائِلُهُم في ال","أَرضِ تُتلى بِأَلسُنِ الحُسّادِ",22,"د",1,0],["معشوقةٌ حَيّتْ بوردةِ وجنةٍ","وَسقَتْ بكاسِ فمٍ سلافاً مُسْكرا",23,"ر",2,0],["مَعشَرٌ أَصبَحوا حُصونَ المَعالي","وَدُروعَ الأَحسابِ وَالأَعراضِ",24,"ض",1,0],["مَعْشراً ضَمُّوا القُوَى في ظِلِّهِ","وبَنُوا بُنيانَهمْ مِن أجلِهِ",25,"ه",1,0],["مُعَشِّراتُ كُرومٍ","أَبنائُها حَبَشِيَّه",26,"ي",2,0],["مَعْشَرٌ صَانَهُمُ اللهُ لأَنْ","يُودَعُوا مِنْ أحْمَدَ السِّرِّ المَصُونا",27,"ن",2,0],["مَعشريَ المعشرُ قادوا العُلى","والإنْسَ والجِنَّ بلا رِبق",28,"ق",1,0],["مَعشوقَةٌ فيهِ مَلاحَتُهُ","ما بَينَ مُتَّصِلٍ وَمُفتَرِقِ",29,"ق",1,0],["مَعشَرٌ صَيَّروا المُدامَةَ قُربا","ناً وَناسٌ أَلقوا بِها التَنجيسا",30,"س",2,0],["مَعشوقَةٌ يَجري مَعَ الدَمِ حُبُّها","في قَلبِ نَصرانِيِّها وَالمُسلِمِ",31,"م",1,0],["معشوقتي عن هَواها لست منصرفاً","وإن فروا بسيوف الغدر أوداجي",32,"ج",2,0],["معشر إذا وعدوا","في كلامهم كذبوا",33,"ب",3,0],["معشوقةٌ في فَرْعِها","تاجٌ مِنَ الوَرْدِ الخَضيبْ",34,"ب",1,0],["مَعْشَرٌ لا وَلِيدُهُمُ طَاهِرُ الْمَهْ","دِ وَلا كَهْلُهُمْ عَفِيفُ الْوِسِادِ",35,"د",1,0],["مَعْشَرُهَا مِنْ أُنْسِهَا مُوحِشٌ","وَأَتْعَسُ الخَلْقِ لَهَا مَعْشَرُ",36,"ر",1,0],["معشر أورثوا الهداية عن هود","فمن مهتد به أو هاد",37,"د",1,0],["مَعشَرٌ يُنجِزُونَ بالخَيْرِ وَالشّرّ","يَدَ الدّهْرِ مَوْعِداً وَوَعيدَا",38,"د",2,0],["معشوقة ٌ حَيّتْ بودرة ِ وجنة","ٍ وَسَقَتْ بكاسِ فمٍ سُلافاً مُسْكرا",39,"ر",2,0],["معشر ليس يبلغ الذمُّ فيهم","حدَّه وصفتهم بتيوسِ",40,"س",1,0],["مَعشَرٌ يُنسَبُ الفَخارُ إِلَيهِم","فَتَكاتٌ لِكُلِّ ضَيمٍ نَوافِ",41,"ف",1,0],["مَعشَرَ مَن يُدلي لَهُ بِتَوَدُّدِ","تَعالوا فَعِندي لِلنَبيِّ مُحَمَّدِ",42,"د",1,0],["مع شيطان رجيم","يطلب الإسلام ثارا",43,"ر",2,0],["معشر المرد لا تصدّوا عن العش","شاق تيها فقد تغيض البحار",44,"ر",1,1],["معشوقة عشقت عذاب محبها","حسناً وقتلُ الصب أحسن رائها",45,"ا",3,0],["مَعشَرَ القِبطِ يا بَني مِصرَ في السَر","راءِ قد كُنتُمُ وَفي الضَرّاءِ",46,"ا",2,1],["معشوقةٌ من جميع الناس إنْ ضَعُفَتْ","منها قُواها وتُخشَى حين تَزْدَحم",47,"م",1,0],["مَعشَرٌ عارَكوا صُروفَ اللَيالي","وَدَرَوا أَنَّ لَذَّةَ العُمرِ ساعَه",48,"ع",2,0],["مَعشَرٌ حُبُّهُم وَطاعَتُهُم حِص","نٌ لَنا مِن عَذابِ نارِ السَعيرِ",49,"ر",1,0],["مَعشَرٌ لا يَرونَ إِطلاقَ كَفٍّ","بِنَوالٍ وَلا لِسانٍ بِوَعدِ",50,"د",1,0],["معشرٌ ما ظفرتُ منهم عَقيب ال","قصِد عند السؤال إلا بخَجلَه",51,"ل",2,0],["مَعشَر أشرِّقَت بهم سبُل الحقّ","ولولاهُم لكانت ظلاما",52,"م",2,0],["مُعشَّقةً زَفَّ التميميُّ دونَها","إِلى دون مَولاكُم بأَلفِ",53,"ف",1,0],["معشوقة النفس في الوطن","لكنها ما لها عهود",54,"د",1,0],["مَعشرٌ مِنهم صرارٌ واِبنهُ","وَيَزيدٌ ونفيعٌ وَعُمَر",55,"ر",1,0],["مَعشَرٌ مَعدِنُ الخِلافَةِ فيهِم","بَدؤُها مِنهُمُ وَفيهُم تَحورُ",56,"ر",1,0],["معشر كانوا كأزهار الربا","رضعوا في المهد من أثداء جود",57,"د",1,0],["مُعشِبٌ وهْو مُعلَمٌ ببَهارٍ","من رياضٍ تَوشَّحَتْها الحُزون",58,"ن",1,0],["معشره في الوغى أسود","وفي صميم العلا قروم",59,"م",1,0],["معشرٌ صُوِّروا من الكَرمِ المح","ضِ ففاقوا مَنْ صيغ من صَلصالِ",60,"ل",1,0],["معشّقةً مكانَ ترى الغواني","إذا عرَّسن يودَعنَ الغوالي",61,"ل",2,0],["معشر الرشد والهدى حَكَمَ البغ","يُ عليهم سفاهةً والضلالُ",62,"ل",1,0],["معشر حازوا المعالي بالظُّبى","وأذلوا الصعب بالسمر الطوالِ",63,"ل",1,0],["مَعْشري لا مَعْشرٌ كُهُمٌ","زانَهم حُسْنٌ وإِحْسانُ",64,"ن",1,0],["معشوقة الحركات عامُ دنوّها","والوصلِ أطولُ منه يومُ بعادها",65,"د",3,0],["مَعَ شادِنٍ رَقَّت حَوا","شي خُلقِهِ رَطبُ الصِبا",66,"ب",2,0],["معشرٌ خُوّلوا الكثيرَ وفيما","يُنفقون الإنزارُ والإقلالُ",67,"ل",1,0],["معشرٌ إنْ خُبِروا فغصونٌ","حَسُنَتْ مرأىً ومَرّت مَذاقا",68,"ق",2,0],["معشوقةٌ في هَواها باتَ كلُّ فتىً","يَهيمُ والشيخُ عنها ليسَ يزدجِرُ",69,"ر",1,0],["مَعشَرٌ حَتفُهُم سُيوفُ بَني العَل","لاتِ يَخشَونَ أَن يَضيعَ اللِواءُ",70,"ا",2,0],["معشر مِن طباطبا كلّ شهم","عادَ فيه دست الإمامة عالي",71,"ل",2,0],["معشوقة التفويف نمق جيدها","ما بين موشيٍّ وبين مدبج",72,"ج",1,0],["مَع شبلكَ المصباح دامَ ضِياؤُهُ","يَجلو مِنَ العَلياءِ ما قَد أَظلَما",73,"م",2,0],["معشوقُه كلُّ علمٍ","لا زينبٌ وضمانُ",74,"ن",1,0],["معشر في الندى بحور وفي السل","م بدور وفي الهياج أسودُ",75,"د",1,0],["معشر قرضوا القريض وباعو","ه بزيف كما يباع الغلولُ",76,"ل",1,0],["معشر قد بليت منهم باجبا","س ثقال ذوي رؤوس خفافِ",77,"ف",1,0],["مَعْشُوقَةِ الحَرَكَاتِ حَرَّك قَدُّهَا","قَلْبًا إلَيْهَا كَانَ قَبْلُ سَكُونَا",78,"ن",2,0],["معشر بالولاء خصو وفيهم","أنزل الوحي بالكتاب المبين",79,"ن",1,0],["معشر قد أنزل اللَه بهم","آية التطهير بل أنزل قل لا",80,"ل",2,0],["معشر طهّرت قلوبهمو الحك","مة والعلم عن أسى أو شكاة",81,"ه",1,0],["مَعْشُوْقَةُ اللَّحَظَاتِ طَيِّبَةُ الشَّذَا","تَفْتَرُّ عَنْ أَلْمَى أَغَرَّ مُفلَّجِ",82,"ج",1,0],["مَعشَرٌ يُطعمونَ مِن ذُروَةِ الشو","لِ وَيُسقونَ خَمرَةَ الأَقحافِ",83,"ف",1,0],["معشوقة لي وأحشائي مبلبلة","في مندل الخد فتت مسكة الخال",84,"ل",1,0],["معشوقةٌ وهي الملالُ وإنَّها","لعلى الملال كثيرةُ العشَّاقِ",85,"ق",1,0],["معشرٌ كلُّهم عرانين مجدٍ","ينشر الحيُّ منهم المقبورا",86,"ر",2,0],["معشرٌ ما خُلِقوا إلاَّ فدا","لبسوا الفخرَ مُعاراً فنبا",87,"ب",2,0],["معشرٌ بيتُ عُلاهم عامرُ","بهم للضيفِ زاهٍ زاهرُ",87,"ر",1,0],["معشوقةُ اللحظاتِ قد كُحلت","بالفاتِنَينِ السحر والغنج",88,"ج",1,0],["معشرٌ طابوا فروعاً في العُلى","وزكوا في طينة المجد أُروما",89,"م",2,0],["معشرُ المجدِ شيعة الشرفِ البا","ذخ بيضُ الوجوه خضر الفناء",90,"ا",2,0],["معشوقةً أقبلت للوصلِ","لسانُها ناطقٌ بالفصل",91,"ل",1,0],["مُعشُرٌ كَالغُيوثِ في حَلبَةِ السِلمِ","وَفي الحَربِ كَاللُيوثِ الضَواري",92,"ر",2,0],["معشوقة اللحظ يا طوبى لعاشقها","محبوبة اللفظ لا بعداً لشانيها",93,"ي",3,0],["معشر الإنجليز مصر لأهلي","ها ومن ظن غير ذلك ضلا",94,"ل",2,0],["معشر الإنجليز مصر استقلت","وجديرٌ بالنيل أن يستقلا",94,"ل",2,0],["معشر العشاق موتوا في الهَوى","إن موت العشق أَحلى من عسل",95,"ل",1,0],["معشارُ قيمتها بكراً لسيدها","ونصف عشرٍ إذا غلفوقها ثقبا",96,"ب",2,0],["معشر من لاذ فيهم مخلصاً","أصلحوا من شأنه ما قد فسد",97,"د",1,0],["معشر ترجف البلاد إذا ساروا عج","الاً لمأزق مشهود",98,"د",1,0],["معشوقة كلفت بحبك فاغتدى","في جيد مجدك عقدها منظوما",99,"م",2,0],["مَع شِدَّةِ الحِرصَِ العَظِيم