{"poems":[[90,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[30,"أظن رجال الدرهمين تسوقهم","https://www.aldiwan.net/poem5309.html","الطويل"],[60,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[68,"لا يمتطي المجد من لم يركب الخطرا","https://www.aldiwan.net/poem41548.html","البسيط"],[71,"وعمر إسلامه بيته","https://www.aldiwan.net/poem28005.html","المتقارب"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199480","المتقارب"],[96,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[119,"رعا الله قلب المستهام الذي ذابا","https://www.aldiwan.net/poem41254.html","عموديه"],[132,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[137,"أحاطت بغايات العلا والمفاخر","https://www.aldiwan.net/poem4236.html","الطويل"],[189,"المال والجاه ضائعان","https://www.aldiwan.net/poem14676.html","مخلع البسيط"],[190,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[287,"رويدك كم تجني وكم تتدلل","https://www.aldiwan.net/poem32666.html","الطويل"],[310,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[383,"ما كل يوم ينال المرء ما طلبا","https://www.aldiwan.net/poem415.html",""],[519,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122604","المنسرح"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145629","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120028","الوافر"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77441","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112890","الكامل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44832","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35827","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108877","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101071","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26431","الوافر"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112658","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89295","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91927","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91728","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35595","السريع"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35507","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125867","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58114","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147295","الوافر"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143623","الرجز"],[5090,"دموعُ العين","https://www.poetsgate.com/ViewPoem.aspx?id=184304",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5271,"فرح","https://www.poetsgate.com/ViewPoem.aspx?id=123671",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5606,"جددي ياعين دمعك","https://www.poetsgate.com/ViewPoem.aspx?id=195419",""],[5683,"برج الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=32346",""],[5704,"تشطير لنونية المتنبي \" ما كل ما يتمنى المرء يدركه\"","https://www.poetsgate.com/ViewPoem.aspx?id=204264",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5829,"صانع الامل","https://www.poetsgate.com/ViewPoem.aspx?id=213787",""],[5956,"شِباكُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=183742",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""]],"verses":[["وأحزم الناس من أن نام بات له","طرف على حدثان الدهر يقظانا",0,"ن",2,0],["وَأَحزَمُهُم مَن قَرَّ في قَعرِ بَيتِهِ","وَأَيقَنَ أَنَّ العَزمَ لا بُدَّ واقِعُ",1,"ع",1,0],["وَأَحزِمُ صَبراً حينَ يُدعى إِلى الوَغى","إِذا كانَ أَصواتُ الكُماةِ تَغمغما",2,"م",2,0],["وَأَحزَمُ الناسِ مَن لَو ماتَ مِن ظَمَإٍ","لا يَقرَبُ الوِردَ حَتّى يَعرِفَ الصَدَرا",3,"ر",2,0],["وأحزنَ ذلكَ حزَّانهم","وأفرحَ موسى بإسلامِهِ",4,"ه",1,0],["وَاِحزُر وَناظِر في الحَديثِ فَإِنَّهُ","يُبدي مَسَمَّةَ سِرِّ كُلِّ ضِمارِ",5,"ر",1,0],["وأحزن حين يشاء القضاء","ففيم العناء؟ ففيم العناء؟",6,"ا",2,0],["وأحزن الشعر بيت راح ينشده","دمع تحدّر من أجفان مكتئب",7,"ب",1,0],["واحزنت عمدا بالتباعد صادقا","وفرحت بالمضنى الموله كذابا",8,"ب",2,0],["وأحزنتَ الأنامَ من الرعايا","بموتك من كبيرِ أو صَبِيّ",9,"ي",1,0],["وأحزَمُ من ساسَ الديانَةَ والدُّنا","وأكرَمُ مأمولٍ وأحلمُ قادِرِ",10,"ر",1,0],["وأحزمُ العالمين من لا","يحتقر الذمَّ من لسان",11,"ن",1,0],["وأحزمهم رأيا إذا ما رزيّة","دهت وألمت من خطوب عظائم",12,"م",1,0],["وَأَحزَمُ خَلقِ اللَهِ رَأياً فَتىً إِذا","نَبا مَنزِلٌ يَوماً بِهِ يَتَحَوَّلُ",13,"ل",1,0],["وَأحزَمهم من قال لم أبل أمره","على أنّ أمري ما بلوني معيّبُ",14,"ب",1,0],["وَأَحزم رأياً في حِمايَةِ عزّه","وَأَوسعُ صَدراً في كفايته الشجبا",15,"ب",2,0],["وَأَحزَمهم رأياً وأقوم سيرة","وَأَكمَلهم نفساً وأوفاهم نحبا",15,"ب",2,0],["وأحزم الأنس من إن فرصة عرضت","لم يجعل السبب الموصول مقتضباً",16,"ب",2,0],["وأحزابُ السُرورِ لَها قُدومٌ","إلينا والهُمومُ لَها اِنهِزامُ",17,"م",1,0],["وأَحزَّ بي أن يَدورَ في خَلدي","مِن جَزَعٍ ما يَدُورُ في خَلَدِك",18,"ك",1,0],["وَأَحْزَانُ العُروبَةِ جاثِمَاتٌ","عَلَى بَسَماتِنا، فمَتَى تُغَادِرْ؟",19,"ر",1,0],["وأحزم من يجول غداة حرب","على عبل الشوى قلق الحزامِ",20,"م",1,0],["وَأَحزَنتَ في الأَحزاب صَخرَ بنَ حَربِهم","وَأَرجَعتهُ بِالخِزي خِزياً مُخَلَّدا",21,"د",2,0],["واحزم وكن في همة ميمونة","وطريقة بالعزم وادلج واقتفى",22,"ف",2,0],["وَاحزَن طَوِيلاً وَاجزَعِ","فَهوَ مَكَانُ الجَزَعِ",23,"ع",1,0],["وَأَحزَمُ ما يَكونُ الدَهرَ رَأياً","إِذا عي المُشاوِرُ وَالمُثيرُ",24,"ر",1,0],["وأحزم مولىً قلت فيه مؤرخاً","محمد حمدي العظم أحزم حازم",25,"م",1,0],["وأحزم الخلق من ان فرصة عرضت","له تهتك فيها الجهد وافتضحا",26,"ح",2,0],["وأحزابهم إذا بيتوا كيد ربهم","بيثرب فاجتاحتهم العدواء",27,"ا",2,0],["وَأَحزَمُ ما يَكونُ الدَهرَ رَأياً","إِذا عَيَّ المُشاوِرُ وَالمُشيرُ",28,"ر",1,0],["وأحزابُهُم قَسرا سباهُم بفاطرٍ","كيسٍ إذا صُفَّت صُفُوفُ النوائِبِ",29,"ب",1,0],["وأحزاب سلعٍ قد كفيها وتلكمو","قريظة قرضٌ والنضير نظير",30,"ر",1,0],["وأحزانٍ وإجرام ٍويأس","وذكرى عاشق وكرىً سليب",31,"ب",1,0],["واحزنى لشيبه الخضيب","واحزنى لجسمه السليب",32,"ب",1,0],["واحزني وليس يجدي حزني","لميت في الطف لم يكفن",32,"ن",1,0],["واحزن على ما قد أصابك وانتحب","ودع الذي بين الورى لك قد أضل",33,"ل",1,0],["وَأَحزنُ الناس من يَمضي بِهِ كَسَلٌ","عَن فُرصة نالَها إقدامُ من نَشطا",34,"ط",2,0],["وَأَحزن عاقل قَد أَلجأته","دَواعي الدَهر لِلوَغد الجَهول",35,"ل",1,0],["وَا حَزني مِن جَفنكَ الأَوطفِ","وَخَصرِك المُختَصَر المُخطفِ",36,"ف",1,1],["وَا حزَني مِن شادِنٍ","في عُقد الصَبر نَفث",37,"ث",1,0],["وأحزانُكم كالبحرِ لا فيضَ بعده","وما ثمَّ إلا مَوْجُهُ المتلاطم",38,"م",1,0],["واحزينا ذبحت أنصاره","وبنوه وهو لا يخشى العدى",39,"ا",1,0],["واحزم على الخَيراتِ واعمَل واعتَدِل","ولا تَكُن مِمَّن تَعَدَّى واعتَدى",40,"ا",1,0],["واحزنْ على ذنبٍ بدمع أحمر","مسترسِلٍ هَطِلٍ هَتُونٍ هَامِلِ",41,"ل",1,0],["وأحزن إذ قرأت سواد سطر","تفجر من غياهبه العويل",42,"ل",1,0],["واحزني من قولها","خان عهودي ولها",43,"ل",3,1],["وأحزانٌ وأشجانٌ اطلت","على قلبي الشغوف المستجيرُ",44,"ر",1,0],["واحزناً على الصبى","أكان ديناً يقتضى",45,"ض",2,0],["واحزمْ ضُلُوعكَ أنَّ الشمسَ غَاربَةٌ","واكتم أَنينكَ قَدْ ضَاقَتْ بِكَ السُبُلُ",46,"ل",1,0],["واحزابٌ تحاصرنا","توارئ جمْعهم بددا",47,"د",2,0],["وأحزني يانفس والاحددي","الله اللي زاد يا نفسي شقاك",48,"ك",1,0],["وأحزاني أوراق .. وعنا وقتي أقلام","وماكان .. للبسمه .. سلام .. وتحيات",49,"ت",1,0],["واحزنْ ولو زمنًا ما عاد فائته","( ولا يَرُدُّ عليك الفائتَ الزمنُ)",50,"ن",1,0],["وأحزنني دهرٌ تكدرَ صفوهُ","فهلَّا يَمُنُّ الدهر يوماً بسلوةِ",51,"ه",1,0],["واحزمْ مرادَك إن أقدَمْتَ مُبتدِئاً","واعزم فعزمك لا يرديكَ بالفشل",52,"ل",1,0],["وأحزن حين أغضِبهم بمجدي","وأعطي عبْسَهم مني ابتساما",53,"م",2,0],["وأحْزاناً نُطِيلُ بها اشْتِغَالاَ","وقائلة رأت جسمي ولوني",54,"ي",1,0]]}