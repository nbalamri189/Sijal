[5490,"وقفت بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=176378",""],[5582,"لِغِبْطَةِ العَيْشِ عِلاَّتٌ وَآفاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=186754",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[5790,"ما كنت أحسب أني بين أظهركم","https://www.poetsgate.com/ViewPoem.aspx?id=112137",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[6088,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=207606",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""],[520,"إن السعادة قد اظل زمانها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577667",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[159,"وَمُهَفْهَفٍ كَالغُصْنِ هَزّتْهُ الصَّبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26930&r=&rc=1",""],[6308,"إني أحبكَ أكثر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87729&r=&rc=7",""]],"verses":[["وَكأَنَّ عِيسَهُمُ عَلى حَدَقٍ","تُدمِي الجُفونَ دُموعُها تَخطو",0,"ط",2,0],["وَكانَ عَبدُ اللَهِ أُنساً لَنا","وَأُنسُ عَبدِ اللَهِ لا يُنكَرُ",1,"ر",1,0],["وَكانَ عَلى كُرسِيِّهِ خَيرَ جالِسٍ","لِهَيبَتِهِ تَعنو الوُجوهُ وَتَخشَعُ",2,"ع",1,0],["وَكانَ عَلَيكَ الدَهرُ يَخفِقُ قَلبُهُ","فَلَمّا شَفاكَ اللَهُ أَهدَأتَ أَحشاهُ",3,"ا",2,0],["وَكَانَ عَلَى طِيبِ الزَّمَانِ وَخُبْثِهِ","جَنِيَّ ثِمَارِ الأُنْسِ عَذْباً مَنَاهِلُهْ",4,"ل",2,0],["وَكَانَ عَلَى جَهْلٍ يَعِيشُ بِحُبِّهَا","وَبِالأَمَلِ المَدْفُونِ فِيهِ تَكتَمَا",5,"م",2,0],["وَكَأَنَّ عافِيَةَ النُسورِ عَلَيهِمُ","حُجٌّ بِأَسفَلِ ذي المَجازِ نُزولُ",6,"ل",1,0],["وَكانَ عَتيداً لَدَيَّ الجَوابُ","وَلَكِن لِهَيبَتِهِ لَم أُجَب",7,"ب",1,0],["وكانَ على حالِ الحسين من الظما","إلى وِرْدِ غوثٍ والزمانُ يزيده",8,"د",2,0],["وكان عليه جوهر الذكر أبيضاً","فزاوجت فيه جوهر الدمع أحمرا",9,"ر",2,0],["وكأنّ عيني راحةٌ ملكيّة","حلف النوال بأنها لا تطبق",10,"ق",1,0],["وَكانَ عَقلي كَعُقولِ الوَرى","وَكانَ قَلبي مِثلَ باقي القُلوب",11,"ب",1,0],["وَكَأَنَّ عَهدَكَ عَهدَ يوسُفَ كُلُّهُ","ظِلٌّ وَسُنبُلَةٌ وَقَطرُ غَمامِ",12,"م",1,0],["وَكَأَنَّ عيدَكِ عيدُها لَمّا مَشى","فيها البَشيرُ بِبِشرِهِ وَجَمالِهِ",13,"ل",2,0],["وَكانَ عَلى قُربِنا بَينَنا","مَهامِهُ مِن جَهلِهِ وَالعَمى",14,"ا",1,0],["وَكانَ عَلى أَشرافِ كُلِّ ثَنِيَّةٍ","سَنا فِتنَةٍ يَدعو إِلى الغَيِّ ثاقِبُه",15,"ب",2,0],["وَكانَ عَطاءُ اللَهِ قَبلَكَ كَاِسمِهِ","لِعافٍ ضَريكٍ أَولِأَسيانِ بائِسِ",16,"س",1,0],["وَكَأنّ عدُوّكَ خافِقُهُ","بِجَناحِ فُؤادٍ مُرتَعِدِ",17,"د",1,0],["وكان عليه الحق ليلاً يجوبُهُ","إليكَ فلما لاحَ وَجْهُكَ أصبَحا",18,"ح",2,0],["وَكَأَنَّ عَبرَتَها عَشِيَّةَ وَدَّعَت","مُهراقَةٌ مِن ماءِ وَجهي أَو دَمي",19,"م",2,0],["وكانَ عنِ الإسلامِ أعظمَ آبقٍ","فأُوثق حتى نَهْضُهُ متثاقِلُ",20,"ل",1,0],["وَكانَ عَلى عَهدِ الشَبابِ تَغَنِّياً","يَشوقُ أَخا وَجدٍ فَعادَ نَحيبا",21,"ب",2,0],["وكان على العدوِّ أشدَّ ظُفراً","إذا شَهِدَ الوغى وأحدَّ نابا",22,"ب",2,0],["وَكانَ عَلى الرَعِيَّةِ شَرَّ راعٍ","وَأَشأَمَ مالِكٍ في الدَهرِ سادا",23,"د",2,0],["وَكَأَنَّ عَقرَبَ صُدغِهِ وَقَفَت","لَمّا دَنَت مِن نارِ وَجنَتِهِ",24,"ه",1,0],["وَكانَ عَزْمِي عندَ الوصولِ بكُمْ","أجْمَلَ مِنْ أنْ أُساقَ لِلْحاصِلْ",25,"ل",1,0],["وَكَأَنَّ عُقبى طَعمِها صَبرٌ","وَعَلى البَديهَةِ مُزَّةُ الطَعمِ",26,"م",1,0],["وَكَأَنَّ عُمرَ المَرءِ شُقَّةُ ظاعِنٍ","تُسرى بِأَنفاسٍ لَهُ وَتُسارُ",27,"ر",1,0],["وَكانَ عِقَالٌ مُؤلِياً بِأَلِيَّةٍ","ليَستَلِبَن أَثوَابَهُ أَو لِيُعذَرا",28,"ر",2,0],["وَكَأَنَّ عِيرَهُمُ تُحَثُّ غُدَيَّةً","دَومٌ يَنُوءُ بِيانِعِ الأَوقالِ",29,"ل",1,0],["وكأنَّ عينَيْها تَضمَّنتا","ما في فؤادكَ من جوَى السُّقْمِ",30,"م",1,0],["وكأنَّ عينَ السَّلسبيلِ تَفجَّرتْ","لكَ عن رحيقِ الجنّةِ المختومِ",31,"م",1,0],["وكَانَ عَهْدِي مِنَ اللاَّئِي مَضَيْنَ مِنَ","البِيضِ البَهَالِيلِ لاَ رَثّاً وَلاَ صَلِفَا",32,"ف",2,0],["وكانَ عَظِيماً يُطْرِقُ الجَمْعُ عِنْدَهُ","ويَعْنُو له رَبُّ الكَتِيبةِ هائِبَا",33,"ب",2,0],["وَكَانَ عِدَاهُمْ عَلَى بُؤْسِهِمْ","وَطُولِ جِهَادِهِمُ المُجْهِدِ",34,"د",1,0],["وكان على رأسِهِ وردتانِ","فقدَّمَ لي تَيْنِك الوردتينْ",35,"ن",1,0],["وَكانَ عَلى ما بَينَ عَمّانَ واقِفاً","إِلى الصينِ قَد أَلقَوا لَهُ بِالخَزائِمِ",36,"م",1,0],["وكان عثمانُ ذا صدق وذا ورَع","مراقباً وجزاه اللضه غفرانا",37,"ن",2,0],["وكان عُنْوانَها الغالي الذي اتجَهَتْ","إليه باسطةَ الأيدِي فأعلاها",38,"ا",3,0],["وكان عِناقُنا لمّا افترقنا","وَثَاقاً للمودّةِ لا يُحَلُّ",39,"ل",1,0],["وكانَ عليه أن يشُدَّ بعَزمه","قُوَى الأمر منها أن يَجدَّ ويسْهَرا",40,"ر",2,0],["وَكانَ، عَلى ثنية كُلّ إشراف،","سَنَا فِتْنَةٍ يَدْعُو إلى الغَيّ ثَاقِبُهْ",41,"ب",2,0],["وكان عهدي منَ اللائي مَضَيْنَ","البِيضِ البَهَالِيلِ رَثَّا وَلاَ صَلِفَا",42,"ف",2,0],["وكان على العدو أشد ظفرا","إذا شهد الوغى وأحدنا",43,"ن",2,0],["وكان عندي على هذا الأسى جلدٌ","حتى تجاوزتَ في بغْيٍ وعدوانِ",44,"ن",1,0],["وكأَنَّ عقربَ صُدغِهِ لمَّا انثنتْ","قافٌ معلقةٌ بعطفَةِ فاءِ",45,"ا",2,0],["وَكانَ عليٌّ حمزةٌ وعبيدةٌ","أَثافيَها إِن كنتَ شبّهتها قدرا",46,"ر",2,0],["وكأنَّ عارضه صفيحةُ جوهرٍ","وكأنَّ حاجبَه مُطَرَّرُ باسِقِ",47,"ق",1,0],["وكأنَّ عارضَه صفيحةُ جوهرٍ","متنمنماً فيها عِذارَ غَريرِ",48,"ر",1,0],["وكان على حملي وحملي مرابطاً","ويحمل بعض الكل عني بل الكل",49,"ل",1,0],["وكان عودك عبدا واعتياد هنا","صباحه عنه ثغر البشر يبتسم",50,"م",1,0],["وكان على شهر له الرعب ناصر","وريح الصبا للنصر هو جاء زعزع",51,"ع",1,0],["وكان عليه أن يرى أولياءه","ويبلوَهم كي يشكروا أو يكذبوا",52,"ب",3,0],["وكان عليهم أن يجيروا أسيرهم","فلم قتّلوا من بعد ذاك وصلَّبوا",52,"ب",3,0],["وكانَ عَلَى وَفْقِ الأمانِي وحُكْمِها","تَلاقي النّدى والوَرْد في الزّمنِ النضْرِ",53,"ر",1,0],["وَكَأنَّ عِدَاهُ وَصَارمَه","لَيْلٌ والصُّبْحُ يُبَدّدُهُ",54,"د",2,0],["وَكَأَنَّ عَيبَتَها وَفَضلَ فِتانِها","فَنَنانِ مِن كَنَفَي ظَليمِ نافِرِ",55,"ر",1,0],["وَكَأَنَّ عَبْدَ اللهِ عَبْدُ اللهِ فِي","حَرَكاتِ هِمَّتِهِ وَفَضْلِ سُكُونِهِ",56,"ن",2,0],["وَكَأَنَّ عَسكَرَهُ المَجَرَّةُ أَشبَهَت","نَهراً يَشُقُّ حَديقَةً مِن نَرجِسِ",57,"س",1,0],["وكان عندي مَسخَره","أَكحلُ منها بصرَه",58,"ه",1,0],["وَكَأَنَّ عَلى أَعلامِها وَإِكامِها","إِذا ما اِرتَدَت بِالآلِ أَردِيَّةَ المَحضِ",59,"ض",1,0],["وَكانَ علَى الرَّوّي لنا اتِّفاقٌ","وَعِندَ الوزنِ كانَ لنا اختِلافُ",60,"ف",1,0],["وَكانَ عَلى مَشَقّة كُلّ أينٍ","صَبوراً عِندَ مُشتدِّ الهَجيرِ",61,"ر",1,0],["وَكانَ عيدُ الوَرى مِن بَعدِ صَومِهِمُ","فَجِئتَهُم أَنتَ قَبلَ العيدِ بِالعيدِ",62,"د",1,0],["وكأنّ عُذّالي إذا ذكَروا الحِمَى","تأْتِي حشايَ بقادحٍ وزِناد",63,"د",1,0],["وكان عجيباً فيه لو أنّ ساعةً","تَمُرُّ ولا تَنتابُ فيها عجائب",64,"ب",1,0],["وكان عصَا موسى لديّ ودادُ","أظلّ ولي ما عشت فيه مآرب",65,"ب",1,0],["وكانَ عَلى أنَّه","يَجوزُ المَدى فانعَطَف",66,"ف",1,0],["وكأن عَيني إذ بكَت لوَداعِه","زُفَّت إليهِ بثوب لاذٍ أحمَرِ",67,"ر",1,0],["وكأن عليه من جِنّ قبولاً","إِذا حي الدواجِنُ قتانُ",68,"ن",1,1],["وكان عهدي بك حسن التأدب","والصمت الجميل بلا حقد ولا ضغن",69,"ن",1,0],["وكان عليه أن يحوز مدى العلى","أليّة برورٍ وحلف مؤكّد",70,"د",1,0],["وكان عِطراً كما عهدنا","مَشْيُ الصَّبا فيكِ والهبوبُ",71,"ب",1,0],["وكان عصري عظيما","وباله من عصر",72,"ر",1,0],["وكَان عندِي نُخبَةٌ","مِمَّن بِكُم تَباهَوا",73,"ا",1,0],["وَكانَ على الهُدى حَدَثاً فإنّي","تظنّ بِه الضّلالة حينَ شابا",74,"ب",2,0],["وكان عرش الإله قدماً","عليَّ يبدو له ارتقاء",75,"ا",2,0],["وَكَانَ عَلَيْهَا اَنْ أُقَدَّمُ قَبْلَهَا","أَشَّدَّ وَأَدْهَى مِنْ تَقَدُّمِهَا قَبْلِي",76,"ل",2,0],["وكان عبد الله إذ سماه","أبوه يرجو ذاك أو يراه",77,"ه",1,0],["وكان عنده بحالة الولد","لم يك في مقامه له أحد",77,"د",1,0],["وكان عاملا لهم على اليمن","وخان فيمن خان منهم وافتتن",77,"ن",1,0],["وكان عَيْشِي بِمَشيبي قذىً","نَعَم فَمَا الشَّيْبَةُ إِلاَّ قَذَاه",78,"ا",2,0],["وكان علَّمها قطعَ الفراتِ به","تعلُّمُ العومِ في بحر الدَّم السَّرب",79,"ب",1,0],["وَكَانَ عَزْمِي عَنِ السُّلوِّ إذَا","عَنَّفني العَاذِلُون يُوثِقُهُ",80,"ق",2,0],["وَكانَ عَميدُ هَذا الوَقتَ مِنهُم","يُشارُ إِلى عُلاهُ بِالبَنانِ",81,"ن",1,0],["وكانَ عليهمُ برّاً عطوفاً","وداعٍ للوِفاقِ وللوئامِ",82,"م",1,0],["وَكانَ عِندَ بَني النَّجارِ جَارَهُمُ البَ","اقي وَكانَ لَهُم مِن مالِهِ الفاني",83,"ن",2,0],["وكان على التنزيل أكبر شاهد","كذاك على الأسرار بالشفع والوتر",84,"ر",1,0],["وكانَ عليهِ للأيّامِ دَيْنٌ","فقدْ قُضِيَتْ على المرءِ الدُّيونُ",85,"ن",1,0],["وَكانَ عَهدي بِهِ أَن لا يُقاطعني","مِن حَيث في حُبِّه قاطَعت خلاني",86,"ن",2,0],["وَكانَ عَلى الأَيّام وَعدٌ فَأَنعمت","عَلى الوَطن المَألوف مُذ آب بِالنَجز",87,"ز",1,0],["وكان عنوان ما أقبلت تصنعه","للقوم والوطن الأعوان والحشما",88,"م",2,0],["وكان عزمي ضئيلَ الشخصِ خاملَهُ","فمذ رجوتُكَ رام الكبرَ وانتعشا",89,"ش",2,0],["وكأنّ عيدَ الوردِ فيه عندنا","بل ليس يَجْمَعُ عندنا ما يَجْمَع",90,"ع",1,0],["وَكَانَ عَلى مَتْنِ الْبُرَاقِ مَسِيرُهُ","إلَى الْمَلإِ الأَعْلى وَتَمَّ سُرُورُهُ",91,"ه",1,0],["وكأنَّ عِيسَهم صقو","رٌ أو سفائِنُ في بحارْ",92,"ر",1,0],["وكان على رشف الشرى ورضابه","أبا سفر لا يجتلي ضيم ظابه",93,"ه",1,0],["وكان عتادك يوم الوغى","حساما صقيلا وحصداء رففا",94,"ف",2,0],["وكأن عزمته وحد","د لسانه ظبتا مهند",95,"د",1,0],["وَكَأنَّ عَارِضَهُ عَلَى وَجَنَاتِهِ","آسٌ تَنَمْنَمَ فِي ريَاضِ شَقِيقِ",96,"ق",1,0],["وكان عهدي قبل ذا","بالماء يطفي اللهبا",97,"ب",2,0],["وكان على ما كان من لَعِب الصبي","نُؤمَّل عُمراً فيه ذو الغيّ راشدُ",98,"د",1,0],["وكأنّ عقربَ من الزمَان وصالَه","يوماً فأخلفَ بالصّدودِ رجائى",99,"ا",2,0],["وكان على خلق فاضل","كريما وفيا عظيم الذكاء",100,"ا",2,0],["وكأن عثمانيِّ بيرق خدِّها","بدم القلوب مطوَّق ومخلَّق",101,"ق",1,0],["وَكانَ عيسى بَعدَ ذي القَرنينِ","بِنَحوِ خَمسينَ وَمائَتَينِ",102,"ن",1,0],["وكأن عرف نسيمها عند الصبا","عرف العبير يفوح فيه العنبر",103,"ر",1,0],["وكأَنّ عِمرانَ المكرَّمَ مُلتقى","لُبِّ العُلى وابناه لبُّ لُبابِه",104,"ب",2,0],["وَكانَ عَهدي بِها غَراءَ وَاصِلَةً","إِذا بِها فارك تَجفو وَلا تَصل",105,"ل",1,0],["وكان على ظهر البراق مسيره","بعزّ وإكرام لكل مقام",106,"م",1,0],["وكان عليٌّ أرمدَ العينِ يبتغي","دواءً فلما لم يحسَّ مُداويا",107,"ي",2,1],["وَكانَ عَلَينا ذِمَّةٌ إِن تَجاوَزوا","مِنَ الأَرضِ مَعروفاً إِلَينا وَمُنكَرا",108,"ر",2,1],["وكان على النمسا الى الآن لم يزل","يكرُّ كميُّ السرب أصيد مقدما",109,"م",2,0],["وكان على الروس الذين دماءَهم","اراقوا فدى البلغار يحرق أُرما",109,"م",2,0],["وَكانَ عَلى عُوارِكَ سِترُ صَونٍ","فَدالَ السِترُ وَاِنكَشَفَ العُوارُ",110,"ر",1,0],["وَكانَ عَهدي بِهِ ضَخماً لَهُ عَجُزٌ","كَأَنَّهُ بَعضُ أَجذاعِ الزَرانيقِ",111,"ق",1,0],["وكان عين الكلام منه","بسرِّه كان أو بجهره",112,"ر",2,0],["وَكانَ عطاء السر مِنهُ خَليقةً","وَإِن خالَها تَخفى عَلى الناسِ تُعلم",113,"م",1,0],["وكان عالماً غزير العلمِ","والفضلِ موصوفاً بفرط الحلمِ",114,"م",1,0],["وَكأَنَّ عَينَ غُرابِ أَدهَمَ داجِنٍ","مُتَعَوِّدِ الإِقبالِ وَالإِدبارِ",115,"ر",1,0],["وكان على بعد البلادين بينكم","هدى الدين سلك الكهرباء والمجرى",116,"ر",2,0],["وكان عزيزاً أن أقيم بمنزلي","إِقامة وهن راغم الأنف صاغر",117,"ر",1,0],["وكان عظيماً لو نجوا غير أنهم","رأوا حسن ما أبقوا من الذكر أعظما",118,"م",2,0],["وكان عزيزاً أنّ بيني وبينها","حِجاباً فقد أمسيتُ منك على عَشر",119,"ر",1,0],["وكان على رأسي قضاء مسيّر","له فوق آمال الورى الحكم والسخر",120,"ر",1,0],["وكان عظيماً فاتحاً غير سافكٍ","من القتل لم يرهب ولم يعشق القتلا",121,"ل",2,0],["وَكانَ عَن سَيدي يَعقوب آخذها","عَن جُمعة الأَكبر",122,"ر",1,0],["وكأن عضته ممسكةً","صدغ أحاط بوجنة غضه",123,"ض",2,0],["وكأن عيد جلوسه","للناس عيد أكبر",124,"ر",1,0],["وكان عريناً لا تضام ليوثه","وكان كناسا لا تهان رباربه",125,"ب",2,0],["وكان على ما قد رأيت من العلى","ومثلك لا تخفى عليه مناقبه",126,"ب",2,0],["وكأن عاماً عشته","في ظلة يوم قصير",127,"ر",1,0],["وكان عليلاً في جزيرته الهوى","فصح بأمواه أتته بها تبري",128,"ر",2,0],["وكان عبيدُ اللهِ أولَ قائمٍ","لمَكرمَةِ الدّنيا وآخرَ قاعدِ",129,"د",1,0],["وكان على قدْرِ المحاسنِ طالِباً","فألْقى عليْهِ الجوُّ بيضَ الدّراهِمِ",130,"م",1,0],["وكان عفيف القول لا يقرب الأذى","ولا يذكر الإخوان إلَّا تحبُّبا",131,"ب",2,0],["وكان على كنز القناعة آمنًا","وإن قصر المسعى بدنياه أو نبا",131,"ب",2,0],["وكان عزيز النفس في غير جفوة","ولا صلف منه، إذا صد أو صبا",131,"ب",2,0],["وكان عليك احتمال الثقي","ل من أكلها وعلينا التعب",132,"ب",1,0],["وكان عليهم حين سارت بنودهم","لقاء الطوى قبل الخميس العرمرم",133,"م",1,0],["وَكَأَنَّ عِطفَ الصَولَجانِ بِكَفّهِ","صُدغ بَدا في الخَدِّ مِنهُ لامُهُ",134,"م",2,0],["وَكانَ عَلى العَذلِ سَهلَ المَرا","مِ سَمحَ المقادَةِ فَاِستَصعَبا",135,"ب",2,0],["وكان عيبُ النملة الأقلُّ","أن لا ترى في الدَينِ ما يحلُّ",136,"ل",1,0],["وكأنَّ عبقرَ مثلَنا","تبكي على الأدبِ الرفيع",137,"ع",1,0],["وكان عقيق دمعي من جفاه","من العينين يتبع شبه عين",138,"ن",1,0],["وَكانَ عَلى بَيانِكُمُ دَليلاً","دَليلَ النَجمِ يَبدو لِلسُّراةِ",139,"ه",1,0],["وكأن عطرك لم يكن محبوبا","فلقد ضربت على حياتك حائطا",140,"ا",1,0],["وكان عند المسلمين مرتضى","وضبط الملك زمانا وقضى",141,"ض",2,0],["وكأن عوداً عاطلاً","في صفحتيه إذا تبدّى",142,"د",2,0],["وكان على تفاخرهم مبرا","باحسان ومعروف وبر",143,"ر",1,0],["وكان عالِماً بِما أضمروا","مِن الأمور قبلَ أنْ تظهرا",144,"ر",2,0],["وكأن عهد الحب كان سحابة","عاشت سنين العمر تحلم بالمطر",145,"ر",1,0],["وكان على أكوارها كل وقته","يفور به سهل ويعلو به نجد",146,"د",1,0],["وكان عليها قد تتبع ما مضى","من الكتب أضحى عند علمها حتما",147,"م",2,0],["وكان عود النّدى قد جفّ ناضره","حتى أعاد إليه ماءه فجرى",148,"ر",2,0],["وكان عزاءَ مَنْ يشكو جريحاً","فجرَّحَهُ الزَّمانُ وما تعزَّى",149,"ز",2,0],["وكان على دين النبي محمد","ويا حبذا الدين القويم لسائد",150,"د",1,0],["وكان عل هذا ذوو الدين والتقى","بعلم وحلم لا بطيش ولا عجل",151,"ل",1,0],["وكأنَّ عيشَ المرءِ مسكونٌ به","ضنك الحياةِ بأنةٍ يتألمُ",152,"م",1,0],["وكأن عمري راح عني غفلة","لم يرن فرحا كان فيه مماحكا",153,"ك",2,0],["وكان عمودا للهدى فأصابه","عمود فأرداه بوجه الثرى لقا",154,"ق",2,0],["وكان على الأذى يبدي اعتذارا","إليه على الحقيقة صح مبنى",155,"ن",2,0],["وكان عليه ممتلئا ظغونا","له شحن الشقا صدرا وبطنا",155,"ن",2,0],["وكأنَّ عينيَ صفحةٌ مرقومةٌ","بحروفِ مجدٍ فانتشت أجفانا",156,"ن",2,0],["وكان عذريَ أني لا أريدُ هوىً","يدميه يوماً إذا ولّى ويدميني",157,"ن",2,0],["وَكانَ عَنْها يَذُودُ المُعْتَدِينَ إِلَى","أَنْ لَيْسَ تَرْهَقُها مِنْهُمْ مَخافاتُ",158,"ت",1,0],["وكان على الوادي يلوح مذنبا","وأذياله من يصطفيهم ويصحب",159,"ب",1,0],["وكان عليهِ أن يَبني ويَبني","وما كَلَّتْ يداهُ عنِ البِناءِ",160,"ا",2,0],["وكان عهدي بسيف الدين يذكرني","والسيف يقطر حداه عبيط دم",161,"م",1,0],["وكان علَيَّ أن أدري بأنَّ التّ","خَيُّلَ أسُّ تطويرِ الوجودِ",162,"د",1,0],["وكان عند رسول اللّه لحظتها","فما اشتكى قصرا منها ولا طولا",163,"ل",2,0],["وَكَاَنَّ عُشّاقَ السَّلامِ مَراكِبٌ","مَوجٌ يَحُطُّ بِها وَمَوجٌ يَرفَعُ",164,"ع",1,0],["وكأن عزمك قال حين تقدمت","بك همةٌ لم ترض أن تتأخرا",165,"ر",2,0],["وكأن علم الكائنات وديعةٌ","مخزونةٌ وصدوركم خزانها",166,"ن",3,0],["وكان عبد اللّه ذنباً إن خطر","أستغفر اللّه من الملاهي",167,"ي",1,0],["وكان عَصِيُّ الشِّعرِ يُلْقي قِيادَه","إليك ويَدْنو منه ما كان نائيا!",168,"ي",2,0],["وكأَنَّ عقربَ صُدْغِهِ لمَّا انثنتبْ","قافٌ معلقة ٌ بعطفة ِ فاءِ",169,"ا",2,0],["وَكَانَ عُمْرِي رَبِيْعَاً","وَكَانَ شَعْرِيَ أشْقَرْ",170,"ر",1,0]]}