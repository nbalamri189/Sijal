,"ريم يتيه بحسن صورته","https://www.aldiwan.net/poem27215.html","الكامل"],[67,"يا أيها السيد الذي شهدت","https://www.aldiwan.net/poem18094.html","المنسرح"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[46,"يا رب عيشة ذي الضلال خسار","https://www.aldiwan.net/poem22565.html","الكامل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"لمن الديار عفون بالتهطال","https://www.aldiwan.net/poem21828.html","الكامل"],[76,"مظلومة باللحظ وجنتها","https://www.aldiwan.net/poem38882.html","أحذ الكامل"],[76,"ومدامة صلى الملوك لوجهها","https://www.aldiwan.net/poem38977.html","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30439","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141999","المتقارب"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/8199","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116988","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[45,"معَ الدّهرِ ظُلمٌ ليسَ يُقلِعُ رَاتِبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31697",""],[105,"لهان على نعاتك أن نصابا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55035&r=&rc=205",""],[135,"ريب المنون وصرف الدهر أعياني","https://www.aldiwan.net/poem49155.html","البسيط"],[155,"ومهفهف كالغصن هزته الصبا","https://www.aldiwan.net/poem55804.html","الكامل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[204,"يا من تنزهنا حدائق وجهه","https://www.aldiwan.net/poem53219.html","الكامل"],[204,"صنم تصور أحسن التصوير","https://www.aldiwan.net/poem53255.html","الكامل"],[210,"لقد كان لي بغل به رتبتي تعلو","https://www.aldiwan.net/poem13400.html","الطويل"],[210,"الحمد لله قد سرت بك الأمم","https://www.aldiwan.net/poem13493.html","البسيط"],[231,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[275,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[275,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[276,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[280,"أترى الهلال أنار ضوء جبينه","https://www.aldiwan.net/poem60770.html","الكامل"],[282,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[322,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[348,"أيا ملكا تزف له القوافي","https://www.aldiwan.net/poem20433.html","الوافر"],[353,"ألا لله عاقبة الأمور","https://www.aldiwan.net/poem40214.html","الوافر"],[364,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[364,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[364,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[369,"بنفسي من أغلقت كفي بحبله","https://www.aldiwan.net/poem4316.html","الطويل"],[371,"جنى ما جنى وانصرف","https://www.aldiwan.net/poem57310.html","مجزوء المتقارب"],[371,"أرأيت دارهم أولئك معشري","https://www.aldiwan.net/poem57417.html","الكامل"],[396,"وكأن عليه من جِن قبولاً","https://www.aldiwan.net/poem619.html",""],[429,"سالت مأسورة قامت مخاصمة","https://www.aldiwan.net/poem40823.html","البسيط"],[437,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[458,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[479,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[538,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[551,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[558,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[567,"أبعد مصاب الأم آلف مضجعا","https://www.aldiwan.net/poem69542.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[575,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[586,"لم يبق في قلب عاشق رمقا","https://www.aldiwan.net/poem17621.html","المنسرح"]],"verses":[["وَكأَنَّ عِيسَهُمُ عَلى حَدَقٍ","تُدمِي الجُفونَ دُموعُها تَخطو",0,"ط",2,0],["وَكانَ عَبدُ اللَهِ أُنساً لَنا","وَأُنسُ عَبدِ اللَهِ لا يُنكَرُ",1,"ر",1,0],["وَكانَ عَلى كُرسِيِّهِ خَيرَ جالِسٍ","لِهَيبَتِهِ تَعنو الوُجوهُ وَتَخشَعُ",2,"ع",1,0],["وَكانَ عَلَيكَ الدَهرُ يَخفِقُ قَلبُهُ","فَلَمّا شَفاكَ اللَهُ أَهدَأتَ أَحشاهُ",3,"ا",2,0],["وَكَانَ عَلَى طِيبِ الزَّمَانِ وَخُبْثِهِ","جَنِيَّ ثِمَارِ الأُنْسِ عَذْباً مَنَاهِلُهْ",4,"ل",2,0],["وَكَانَ عَلَى جَهْلٍ يَعِيشُ بِحُبِّهَا","وَبِالأَمَلِ المَدْفُونِ فِيهِ تَكتَمَا",5,"م",2,0],["وَكَأَنَّ عافِيَةَ النُسورِ عَلَيهِمُ","حُجٌّ بِأَسفَلِ ذي المَجازِ نُزولُ",6,"ل",1,0],["وَكانَ عَتيداً لَدَيَّ الجَوابُ","وَلَكِن لِهَيبَتِهِ لَم أُجَب",7,"ب",1,0],["وكانَ على حالِ الحسين من الظما","إلى وِرْدِ غوثٍ والزمانُ يزيده",8,"د",2,0],["وكان عليه جوهر الذكر أبيضاً","فزاوجت فيه جوهر الدمع أحمرا",9,"ر",2,0],["وكأنّ عيني راحةٌ ملكيّة","حلف النوال بأنها لا تطبق",10,"ق",1,0],["وَكانَ عَقلي كَعُقولِ الوَرى","وَكانَ قَلبي مِثلَ باقي القُلوب",11,"ب",1,0],["وَكَأَنَّ عَهدَكَ عَهدَ يوسُفَ كُلُّهُ","ظِلٌّ وَسُنبُلَةٌ وَقَطرُ غَمامِ",12,"م",1,0],["وَكَأَنَّ عيدَكِ عيدُها لَمّا مَشى","فيها البَشيرُ بِبِشرِهِ وَجَمالِهِ",13,"ل",2,0],["وَكانَ عَلى قُربِنا بَينَنا","مَهامِهُ مِن جَهلِهِ وَالعَمى",14,"ا",1,0],["وَكانَ عَلى أَشرافِ كُلِّ ثَنِيَّةٍ","سَنا فِتنَةٍ يَدعو إِلى الغَيِّ ثاقِبُه",15,"ب",2,0],["وَكانَ عَطاءُ اللَهِ قَبلَكَ كَاِسمِهِ","لِعافٍ ضَريكٍ أَولِأَسيانِ بائِسِ",16,"س",1,0],["وَكَأنّ عدُوّكَ خافِقُهُ","بِجَناحِ فُؤادٍ مُرتَعِدِ",17,"د",1,0],["وكان عليه الحق ليلاً يجوبُهُ","إليكَ فلما لاحَ وَجْهُكَ أصبَحا",18,"ح",2,0],["وَكَأَنَّ عَبرَتَها عَشِيَّةَ وَدَّعَت","مُهراقَةٌ مِن ماءِ وَجهي أَو دَمي",19,"م",2,0],["وكانَ عنِ الإسلامِ أعظمَ آبقٍ","فأُوثق حتى نَهْضُهُ متثاقِلُ",20,"ل",1,0],["وَكانَ عَلى عَهدِ الشَبابِ تَغَنِّياً","يَشوقُ أَخا وَجدٍ فَعادَ نَحيبا",21,"ب",2,0],["وكان على العدوِّ أشدَّ ظُفراً","إذا شَهِدَ الوغى وأحدَّ نابا",22,"ب",2,0],["وَكانَ عَلى الرَعِيَّةِ شَرَّ راعٍ","وَأَشأَمَ مالِكٍ في الدَهرِ سادا",23,"د",2,0],["وَكَأَنَّ عَقرَبَ صُدغِهِ وَقَفَت","لَمّا دَنَت مِن نارِ وَجنَتِهِ",24,"ه",1,0],["وَكانَ عَزْمِي عندَ الوصولِ بكُمْ","أجْمَلَ مِنْ أنْ أُساقَ لِلْحاصِلْ",25,"ل",1,0],["وَكَأَنَّ عُقبى طَعمِها صَبرٌ","وَعَلى البَديهَةِ مُزَّةُ الطَعمِ",26,"م",1,0],["وَكَأَنَّ عُمرَ المَرءِ شُقَّةُ ظاعِنٍ","تُسرى بِأَنفاسٍ لَهُ وَتُسارُ",27,"ر",1,0],["وَكانَ عِقَالٌ مُؤلِياً بِأَلِيَّةٍ","ليَستَلِبَن أَثوَابَهُ أَو لِيُعذَرا",28,"ر",2,0],["وَكَأَنَّ عِيرَهُمُ تُحَثُّ غُدَيَّةً","دَومٌ يَنُوءُ بِيانِعِ الأَوقالِ",29,"ل",1,0],["وكأنَّ عينَيْها تَضمَّنتا","ما في فؤادكَ من جوَى السُّقْمِ",30,"م",1,0],["وكأنَّ عينَ السَّلسبيلِ تَفجَّرتْ","لكَ عن رحيقِ الجنّةِ المختومِ",31,"م",1,0],["وكانَ عَظِيماً يُطْرِقُ الجَمْعُ عِنْدَهُ","ويَعْنُو له رَبُّ الكَتِيبةِ هائِبَا",32,"ب",2,0],["وَكَانَ عِدَاهُمْ عَلَى بُؤْسِهِمْ","وَطُولِ جِهَادِهِمُ المُجْهِدِ",33,"د",1,0],["وكان على رأسِهِ وردتانِ","فقدَّمَ لي تَيْنِك الوردتينْ",34,"ن",1,0],["وَكانَ عَلى ما بَينَ عَمّانَ واقِفاً","إِلى الصينِ قَد أَلقَوا لَهُ بِالخَزائِمِ",35,"م",1,0],["وكان عثمانُ ذا صدق وذا ورَع","مراقباً وجزاه اللضه غفرانا",36,"ن",2,0],["وكان عُنْوانَها الغالي الذي اتجَهَتْ","إليه باسطةَ الأيدِي فأعلاها",37,"ا",3,0],["وكان عِناقُنا لمّا افترقنا","وَثَاقاً للمودّةِ لا يُحَلُّ",38,"ل",1,0],["وكانَ عليه أن يشُدَّ بعَزمه","قُوَى الأمر منها أن يَجدَّ ويسْهَرا",39,"ر",2,0],["وَكانَ، عَلى ثنية كُلّ إشراف،","سَنَا فِتْنَةٍ يَدْعُو إلى الغَيّ ثَاقِبُهْ",40,"ب",2,0],["وكان على العدو أشد ظفرا","إذا شهد الوغى وأحدنا",41,"ن",2,0],["وكان عندي على هذا الأسى جلدٌ","حتى تجاوزتَ في بغْيٍ وعدوانِ",42,"ن",1,0],["وكأَنَّ عقربَ صُدغِهِ لمَّا انثنتْ","قافٌ معلقةٌ بعطفَةِ فاءِ",43,"ا",2,0],["وَكانَ عليٌّ حمزةٌ وعبيدةٌ","أَثافيَها إِن كنتَ شبّهتها قدرا",44,"ر",2,0],["وكأنَّ عارضه صفيحةُ جوهرٍ","وكأنَّ حاجبَه مُطَرَّرُ باسِقِ",45,"ق",1,0],["وكأنَّ عارضَه صفيحةُ جوهرٍ","متنمنماً فيها عِذارَ غَريرِ",46,"ر",1,0],["وكان على حملي وحملي مرابطاً","ويحمل بعض الكل عني بل الكل",47,"ل",1,0],["وكان عودك عبدا واعتياد هنا","صباحه عنه ثغر البشر يبتسم",48,"م",1,0],["وكان على شهر له الرعب ناصر","وريح الصبا للنصر هو جاء زعزع",49,"ع",1,0],["وكان عليه أن يرى أولياءه","ويبلوَهم كي يشكروا أو يكذبوا",50,"ب",3,0],["وكان عليهم أن يجيروا أسيرهم","فلم قتّلوا من بعد ذاك وصلَّبوا",50,"ب",3,0],["وكانَ عَلَى وَفْقِ الأمانِي وحُكْمِها","تَلاقي النّدى والوَرْد في الزّمنِ النضْرِ",51,"ر",1,0],["وَكَأنَّ عِدَاهُ وَصَارمَه","لَيْلٌ والصُّبْحُ يُبَدّدُهُ",52,"د",2,0],["وَكَأَنَّ عَيبَتَها وَفَضلَ فِتانِها","فَنَنانِ مِن كَنَفَي ظَليمِ نافِرِ",53,"ر",1,0],["وَكَأَنَّ عَبْدَ اللهِ عَبْدُ اللهِ فِي","حَرَكاتِ هِمَّتِهِ وَفَضْلِ سُكُونِهِ",54,"ن",2,0],["وَكَأَنَّ عَسكَرَهُ المَجَرَّةُ أَشبَهَت","نَهراً يَشُقُّ حَديقَةً مِن نَرجِسِ",55,"س",1,0],["وكان عندي مَسخَره","أَكحلُ منها بصرَه",56,"ه",1,0],["وَكَأَنَّ عَلى أَعلامِها وَإِكامِها","إِذا ما اِرتَدَت بِالآلِ أَردِيَّةَ المَحضِ",57,"ض",1,0],["وَكانَ علَى الرَّوّي لنا اتِّفاقٌ","وَعِندَ الوزنِ كانَ لنا اختِلافُ",58,"ف",1,0],["وَكانَ عَلى مَشَقّة كُلّ أينٍ","صَبوراً عِندَ مُشتدِّ الهَجيرِ",59,"ر",1,0],["وَكانَ عيدُ الوَرى مِن بَعدِ صَومِهِمُ","فَجِئتَهُم أَنتَ قَبلَ العيدِ بِالعيدِ",60,"د",1,0],["وكأنّ عُذّالي إذا ذكَروا الحِمَى","تأْتِي حشايَ بقادحٍ وزِناد",61,"د",1,0],["وكان عجيباً فيه لو أنّ ساعةً","تَمُرُّ ولا تَنتابُ فيها عجائب",62,"ب",1,0],["وكان عصَا موسى لديّ ودادُ","أظلّ ولي ما عشت فيه مآرب",63,"ب",1,0],["وكانَ عَلى أنَّه","يَجوزُ المَدى فانعَطَف",64,"ف",1,0],["وكأن عَيني إذ بكَت لوَداعِه","زُفَّت إليهِ بثوب لاذٍ أحمَرِ",65,"ر",1,0],["وكأن عليه من جِنّ قبولاً","إِذا حي الدواجِنُ قتانُ",66,"ن",1,1],["وكان عهدي بك حسن التأدب","والصمت الجميل بلا حقد ولا ضغن",67,"ن",1,0],["وكان عليه أن يحوز مدى العلى","أليّة برورٍ وحلف مؤكّد",68,"د",1,0],["وكان عِطراً كما عهدنا","مَشْيُ الصَّبا فيكِ والهبوبُ",69,"ب",1,0],["وكان عصري عظيما","وباله من عصر",70,"ر",1,0],["وكَان عندِي نُخبَةٌ","مِمَّن بِكُم تَباهَوا",71,"ا",1,0],["وَكانَ على الهُدى حَدَثاً فإنّي","تظنّ بِه الضّلالة حينَ شابا",72,"ب",2,0],["وكان عرش الإله قدماً","عليَّ يبدو له ارتقاء",73,"ا",2,0],["وَكَانَ عَلَيْهَا اَنْ أُقَدَّمُ قَبْلَهَا","أَشَّدَّ وَأَدْهَى مِنْ تَقَدُّمِهَا قَبْلِي",74,"ي",1,0],["وكان عبد الله إذ سماه","أبوه يرجو ذاك أو يراه",75,"ه",1,0],["وكان عنده بحالة الولد","لم يك في مقامه له أحد",75,"د",1,0],["وكان عاملا لهم على اليمن","وخان فيمن خان منهم وافتتن",75,"ن",1,0],["وكان عَيْشِي بِمَشيبي قذىً","نَعَم فَمَا الشَّيْبَةُ إِلاَّ قَذَاه",76,"ا",2,0],["وكان علَّمها قطعَ الفراتِ به","تعلُّمُ العومِ في بحر الدَّم السَّرب",77,"ب",1,0],["وَكَانَ عَزْمِي عَنِ السُّلوِّ إذَا","عَنَّفني العَاذِلُون يُوثِقُهُ",78,"ق",2,0]]}