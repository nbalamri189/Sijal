{"poems":[[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[65,"سل الركب يا ذواد عن آل جساس","https://www.aldiwan.net/poem46149.html","الطويل"],[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[95,"رأيته ورآني","https://www.aldiwan.net/poem11233.html","المجتث"],[49,"هواك هواي على كل حال","https://www.aldiwan.net/poem25166.html","المتقارب"],[66,"طلبت المستقر بكل أرض","https://www.aldiwan.net/poem67562.html","الوافر"],[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[60,"لنقل الصخر من قلل الجبال","https://www.aldiwan.net/poem30908.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39576","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[98,"إِلَى رَاقِصَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187825",""],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[92,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[264,"منك الكتاب يا علي","https://www.aldiwan.net/poem35796.html","مجزوء الرجز"],[276,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[435,"بدا ينجلي تحت الغلالة والبرد","https://www.aldiwan.net/poem40517.html","الطويل"],[473,"ألا رب فتيان كأن وجوههم","https://www.aldiwan.net/poem59742.html","الطويل"],[484,"أينفى الاعتصاب بنفي سبع","https://www.aldiwan.net/poem37607.html","الوافر"],[495,"بلوت الناس قرناً بعد قرنٍ","https://www.aldiwan.net/poem666.html",""],[505,"قلبي منكم خائف خافق","https://www.aldiwan.net/poem37656.html","السريع"],[563,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44575","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70745","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16837","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108541","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110282","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143014","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106991","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87698","الرجز"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21596","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205836",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134010","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133986","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91350","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44894","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199088","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33470","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72509","الطويل"],[4755,"حَمَلْنا مِن البُؤسِ حَدَّ البَذَخْ","https://www.poetsgate.com/ViewPoem.aspx?id=183727",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4813,"وقد نلت أنواع الشدائد كلها","https://www.poetsgate.com/ViewPoem.aspx?id=133404",""],[4578,"تذكرت شرقيّ الحمى من أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49354",""],[4930,"حملتُ الصخر","https://www.poetsgate.com/ViewPoem.aspx?id=213599",""],[5183,"الخد النضر","https://www.poetsgate.com/ViewPoem.aspx?id=186378",""],[5232,"موسمُ العشَّاق","https://www.poetsgate.com/ViewPoem.aspx?id=213610",""],[5232,"إشراق","https://www.poetsgate.com/ViewPoem.aspx?id=213697",""],[5277,"البصرة..البلحُ المالحُ","https://www.poetsgate.com/ViewPoem.aspx?id=199865",""],[5431,"نور على نورِ","https://www.poetsgate.com/ViewPoem.aspx?id=199391",""],[5431,"أحب الذقن...","https://www.poetsgate.com/ViewPoem.aspx?id=200144",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5956,"تُوُفِّيتَ يا عبدَ هادي ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=192984",""],[6079,"ألا ليت القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=207373",""],[6089,"الكلماتُ البالغاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=213394",""]],"verses":[["وَذُقتُ لَها أَستَغفِرُ اللَهَ ريقَةً","كَبَيضاءَ قَد شيبَت بِحَمراءَ كالوَردِ",0,"د",1,0],["وذُقْتُ عَفا عَنّا الإلهُ وعَنكُمُ","جَني ريقَةٍ تُلهي أخاكُمْ عنِ الكاسِ",1,"س",1,0],["وَذُقتَ مِن جاءَ زَيدٌ","وَمِن شُروحِ الشُمُنّي",2,"ن",2,0],["وَذُقْتُ مَا لَمْ أَذُقْهُ","مِنْ لَذَّةِ النِّيرَانِ",3,"ن",1,0],["وَذُقنا مَرارَةَ كَأسِ الصُدودِ","فَأَينَ حَلاوَةُ كَأسِ الوِصالِ",4,"ل",1,0],["وَذُقتُ مِنَ الزَمانِ وَذاقَ مِنّي","وَجَدتُ مَذاقَهُ حُلواً وَمُرّا",5,"ر",2,0],["وذقت من غير موردي جُرَعاً","ساغت فخف أن تغصَّك الجُرَع",6,"ع",1,0],["وَذُقتُ مَرارَةَ الأَشياءِ طُرّاً","فَما طَعمٌ أَمَرَّ مِنَ السُؤالِ",7,"ل",1,0],["وذقتُ الحنانَ بها والرِّضى","يداً بَرَّةً وفماً طاهرا",8,"ر",2,0],["وَذُقْنَا سُلاَفاً أَبَتْ أَنْ تَرِفَّ","بِكَفِّ النُواسِيِّ والأخْطَلِ",9,"ل",1,0],["وَذُقْتُ الحنَانَ بها والرِّضا","يَدًا بَرَّةً وفمًا طاهِرَا",10,"ر",2,0],["وذُقْتُ الوحشةَ الكبرى فكانت","أنيسَ الناعمين بها اضطجاعا",11,"ع",2,0],["وذُقتُ من الغِيد شرَّ السُموم","طعْماً يُميتُ ويُستَلْطَف",12,"ف",1,0],["وذقت معناه الّذي","مع لفظه قد لذّ لي",13,"ل",2,0],["وَذقت مَرارة التَجريب حَتّى","تبينت النحاس من النضار",14,"ر",1,0],["وَذقت كأس الهَوى العذرى ما هجعت","عَيناكَ في جنح لَيل جن مظلمة",15,"م",2,0],["وذقتُ بفيَّ لذةً تَبعثُ الهوى","فها أنا من تلك اللذاذة في حرب",16,"ب",1,0],["وذقت الهوى من عفتي وتصبري","كما ذقت من بلباله زمن البعدِ",17,"د",1,0],["وَذُقتُهُم في السُخطِ مِنهُم وَفي الرِضا","فَما ذُقتُ إِلّا مَن حَلَت لي خِصالُهُ",18,"ل",2,0],["وذقنا في الإخاء لذيذ سكر","فنحن به نشاوى دون كرع",19,"ع",1,0],["وَذُقتُ مَرارَةَ الأَشياءِ جَمعاً","فَما طَعمٌ أَمَرُّ مِنَ السُؤالِ",20,"ل",1,0],["وذقتُ ماء الوصلِ من حانكم","والماءُ يدري بردخُ الذائقُ",21,"ق",1,0],["وذقت كما ذاق العدو تباعدي","وما الأكل إلا الفرق والجمع توبتي",22,"ي",1,0],["وَذُقتُ طَعمَ الجُنونِ فيهِ","فَكانَ أَحلى مِنَ العُقارِ",23,"ر",1,0],["وذقتُ بها العيشَ الذي سمحت به","سنون التصابي والحبيبُ المسامح",24,"ح",1,0],["وَذُقتُ مَهوى النَجمِ ريقاً خَصِراً","لَو كانَ مِن ناجودِ خَمرٍ ما غَذا",25,"ذ",2,1],["وذقت رضاباً لاح بين مراشف","بعيدة عهدٍ بالسماح كما ذقت",26,"ت",1,0],["وذق ثمر البغي الوخيم ولا تلم","عدواً فأنت المجتنيه من الدهر",27,"ر",1,0],["وذقت الشهد في أبيات شعر","وكم عسل شهي في كلام",28,"م",1,0],["وذقتُ \"السَّبايا\" من يديك نواعماً","فلم يغرني فوق الموائد \"كُسْكس\"(13)",29,"س",1,0],["وذقت له استغفر اللَه ريقة","هي الخمر لكن لم تدنس بذائق",30,"ق",1,0],["وَذُقت فيهِ فَرَحاً وَحُزنا","مَن لَم يَكُن في كُل أَمر مِرنا",31,"ن",2,0],["وَذُق كَالَّذي قَد ذاقَ مِنكَ مَعاشِرٌ","لَعِبتَ بِهُم إِذ أَنتَ بِالناسِ تَلعَبُ",32,"ب",1,0],["وذقت منها الجنى شهيا","والنجم من فوقنا شهيد",33,"د",1,0],["وذق من كل مألوف شهيا","له النفس الزكية مستجيده",34,"د",2,0],["وذق شراب التهاني قد حلا وصفا","وانهض للثم بنان الزهر في العود",35,"د",1,0],["وَذُق لَماها حَديثاً عَن قَديم هَوى","بِكْرٍ ثَوى دونَها في العَصر سابور",36,"ر",1,0],["وَذقتمُ مِن كُؤوسَ الحُبِّ عَلقَمَهُ","وَالحُبُّ أَيسَرُ ما في كَأسهِ الفَزَعُ",37,"ع",1,0],["وذقت مرارات الزمان وشجوه","على حين لا خيرا يرام ولا خلا",38,"ل",2,0],["وذقت بكفي في حالتي","من صابهِ وجنى نحلهِ",39,"ل",2,0],["وذقت بثغر الفكر شهد مجاجها","فساغ شرابا في لهات فم العقل",40,"ل",1,0],["وذُقنا مِن الظُّلمِ ما لَم يَذُقْ","بَريءٌ لِكُلِّ ادِّعاءٍ رَضَخْ",41,"خ",1,0],["وذق من شراب الهوى نغبة","من الحب من كأسه ثملج",42,"ج",1,0],["وذقت حلاوات الزمان ومره","وعلمني حكماً دوام التجارب",43,"ب",1,0],["وذقت عذاب الهون بعد وصالهم","ولم أستطع صبراً وقد مر عذبه",44,"ب",2,0],["وذقتُ القهرَ من أهلي وناسي","وطعمَ الموتِ في ركبِ المآسي",45,"س",2,0],["وذقت غرامه بردا","بحيث الطعم يستعر",46,"ر",1,0],["وَذُقُ إنْ شئتَ من روحي رحيقا ً","وزفَّ مواسمي عطراً وفلّا",47,"ل",2,0],["وذقتُ الكأسَ ذقتُ الكأسَ مزَّا","وشوكُ العمرِ في الأعماقِ غزَّا",48,"ز",2,1],["وذقت طيف خيال كم يزاورني","قد اشبه المسك مهما جاوز الحدّا",49,"د",2,0],["وذقتُ قربك في حبٍ يُعمدني","في أنهر النور مغمورا كمسحورِ",50,"ر",1,0],["وذقنٌ لها غنى الغرام المورطُ","أُزيلت فكم قلب لحلقٍ سيسقطُ",51,"ط",1,1],["وذقْ طعمَ الحروف قبيل لفظٍ","فبعض حروفنا مثل المحزِّ",52,"ز",1,0],["وذق من خمر حب اللّه للفردوس صرفاً","حذارِ بأن يخالطها مدامُ",53,"م",1,0],["وذقت نوائب الدهر ِ","وذاك اليأس بي عنكبْ ؟",54,"ب",1,0],["وذقتَ بنفيي أشدَّ العذاب","وعانيتَ ما حطَّمَ المطمحا",55,"ح",2,0],["وذقتَ بحبّها هجرًا مريرًا","وعانيتَ العذاب بلا اضطرارِ",56,"ر",1,0],["وذقتُ من الأحلى كثيرًا بحكمةٍ","وما بطرَتْ نفسي ولا ساءَ حُكمُها",57,"م",3,0]]}