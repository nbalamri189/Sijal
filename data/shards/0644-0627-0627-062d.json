","https://www.poetsgate.com/ViewPoem.aspx?id=189030",""],[5953,"يا ألهي بأحمد وعلي","https://www.poetsgate.com/ViewPoem.aspx?id=93809",""],[5956,"لولا اللقاءُ والخيالُ","https://www.poetsgate.com/ViewPoem.aspx?id=182089",""],[5956,"ضيّعتُها وأخذتُ أرجع نحوها ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182141",""],[5956,"شَعْرتان ومكيّف","https://www.poetsgate.com/ViewPoem.aspx?id=182357",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""],[572,"لا أُحِبُّ الدُواة َ تُحْشَى يراعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9159&r=&rc=16",""]],"verses":[["لا أَحالَت لَكَ الحَوادِثُ لَوناً","وَتَعَدَّتكَ ناسِجاتُ الجِواءِ",0,"ا",2,0],["لا أَحسَبُ الدَهرَ يُبلي جِدَّةً أَبَداً","وَلا تُقَسِّمُ شَعباً واحِداً شُعَبُ",1,"ب",1,0],["لا أحبّ النسيم إلا إذا هب","ب على كل حاضر أو بادي",2,"د",2,0],["لا أُحِبُّ الجَميلَ مِن سِرِّ مَولىً","لَم يَدَع ماكَرِهتُهُ إِعلانا",3,"ن",2,0],["لا أحسب العيشَ يَبلَى ثوبُ جِدَّتهِ","ولا إخالُ زماني يُعقِبُ العُقَبا",4,"ب",2,0],["لا أحبُّ المَعَادَ من حفرةِ القبْ","رِ إذا شيبَ لي بسوء المآبِ",5,"ب",1,0],["لا أحب الرئيس ذا العزِّ يُضْحي","جارُهُ والرجالُ مُستَعبِدوهُ",6,"د",3,1],["لا أحب الرزق يجري أمره","كلما أملتُهُ مجرى المُتع",7,"ع",1,0],["لا أحب التي لذيذُ جَناها","مُتمنَّىً وشوكُها مضمون",8,"ن",1,0],["لا أَحسَنَت كَي تُعلِنَ الصُحُفُ إِسمَها","فَتَعلَمَ جاراتٌ لَها وَقَبيلُ",9,"ل",1,0],["لا أُحِبُّ الإِنسانَ يَرضَخُ لِلوَه","مِ وَيَرضى بِتافِهاتِ الأَماني",10,"ن",2,1],["لا أُحِسَّ الآلامَ في القُربِ وَالبُع","دِ وَلَم يُبقِ لي الغَرامُ فُؤادا",11,"د",2,1],["لا أُحِبُّ الفَتى أَراهُ إذا ما","عَضَّهُ الدَّهرُ جاثِماً في الضَّلالِ",12,"ل",1,0],["لا أَحفِلُ المَرءَ أَو تُقَدِّمُهُ","شَتّى خِصالٍ أَشَفُّها أَدَبُه",13,"ب",2,0],["لا أُحرَمَن تَعجيلَ ما","قَدَّمتَ مِن رَأيٍ وَمَوعِد",14,"د",1,0],["لا أَحفِلُ الأَشباحَ حَتّى أَرى","بَيانَ ما تَأتي بِهِ الأَفئِدَه",15,"د",2,0],["لا أَحسِبُ الأجفانَ يَلقَى بَعْضُها","بَعْضاً إذا كانَ الفِراقُ المُلتَقى",16,"ق",2,0],["لا أحمَدُ الأيامَ بَعْدَ بَتاتِها","سبباً وصلتُ إليه من أسبابه",17,"ب",2,0],["لا أَحاشي بَينَكُم مِن أَحَد","فَكميُّ الحَرب صِنوُ الأَعزلِ",18,"ل",1,0],["لا أَحمِلُ البُخلَ إِلى حُفرَتي","لِتَأكُلي البُخلَ مَعَ الآكِلين",19,"ن",1,0],["لا أَحُطُّ الحِزامَ طَوعاً عَنِ المَح","ذوفِ دونَ اِبنِ خالِدِ الوَهّابِ",20,"ب",1,1],["لا اِحتَبَت في القَومِ ماثِلَةً","ثُمَّ قَصَّت قِصَّةَ الأُمَمِ",21,"م",1,0],["لا أَحمِلُ اللَومَ فيها وَالغَرامَ بِها","ما كَلَّفَ الَلهُ نَفساً فَوقَ ما تَسَعُ",22,"ع",1,1],["لا أَحقِدُ الآنَ عَلى صاحِبٍ","إِن رابَني مَعدِنَ خَيرٍ حَقَد",23,"د",1,0],["لا أَحمِلُ الهَمَّ لي يَومٌ يُغَيِّبُني","وَلَو حَلَلتُ مَعَ الجَوزاءِ وَالحَمَلِ",24,"ل",1,0],["لا أحسبُ الأيام في","هِ أو أَعُدُّ الحِقبا",25,"ب",2,0],["لا أَحْفلُ الطَّيْرَ إِنْ غَنَّتْ وَإِنْ نَعَبَتْ","سِيَّان عِنْدِي صَفَّارٌ وَشَحَّاجُ",26,"ج",1,0],["لا أُحِبُّ النَسلَ بَعدَ اِبني وَلا","تَطمَعُ الحَسناءُ مِنّي بِالعشق",27,"ق",1,0],["لا أحسب الروح الا انها خُلقت","من الهوى فاختفت عن عالم الصور",28,"ر",1,0],["لا أَحْمِلُ اللَّوْمَ فيها والغَرَامَ بها","ما كلف نفساً فوق ما تسع",29,"ع",1,1],["لا أُحابيكَ سيدي وأُراني","لستُ في حاجةٍ إلى التعريف",30,"ف",1,0],["لا أُحب العِناقَ من أجل ذكرى","خَلّفتها عناقةُ التوديع",31,"ع",1,0],["لا أحبّ الإنسان يرضخ للوهم،","ويرضى بتاففهات الأماني",32,"ن",2,1],["لا أحسب العيس يَبلَى ثوبُ جِدَّتهِ","ولا إخالُ زماني يُعْقِبُ العُقَبا",33,"ب",2,0],["لا أحسَبُ السِّيدَ في بَيدائِهِ أسَداً","ولا أفِرُّ إذَا مَا جَاءني الأسَدُ",34,"د",1,0],["لا أحبّ الوصال بل أتمنّى","لا لأنّ الفراق غبّ الوصال",35,"ل",1,1],["لا أَحمد العزمَ ما لم تَنحطمْ قُضُبٌ","من السّيوف ولَم تُحْصَدْ بِها لِمَم",36,"م",1,0],["لا أحِبُّ الحياةَ إلا لأمري","ن مدى اللهوِ أو قضاءِ الحقوق",37,"ق",1,0],["لا احليه بالرباء والحسناء","وجه يستقبح التحسينا",38,"ن",2,0],["لا أَحسبُ الوصلَ حظّاً في الصبابةِ بَل","حظّي منَ الحسنِ أنّي بعضُ مَن قُتلا",39,"ل",2,0],["لا أحفظُ البيت من جارات ربته","ولن يحالف عِرسي قبلك العدُمُ",40,"م",1,0],["لا أحسنُ الظن وحوشيتَ من","قولي لمصحوبٍ ولا صاحبِ",41,"ب",1,0],["لا أحضَرَ الله ثقيلاً به","ما دامَت الأحباب فيه حضور",42,"ر",1,0],["لا أَحبُّ السَّبْعَ البحارَ وعندِي","من أَيادِيكُمُ موارِدُ عَشْرِ",43,"ر",1,0],["لا أحب النّخْلَ ذا سعَفٍ","قد حَماني شوكُه البلَحا",44,"ح",2,0],["لا أحب الوداع من أجل كونى","ما رأيت الوداع الا لبين",45,"ن",1,1],["لا أُحبُّ الجليسَ فَظّاً غليظاً","جافيَ الطبع سَيّءَ الخُلْق نَكْدَا",46,"د",2,1],["لا أحسدُ المثري على ما عنده","من خيره وعِرضُه فيما وهَنْ",47,"ن",1,0],["لا أُحِلّ الفراقَ من رشإٍ في","كم أحلَّت نواه نفسا حراما",48,"م",2,0],["لا أُحِبُّ المَرءُ إِن لَم","أَجِدِ المَرءَ عِفيفا",49,"ف",2,1],["لا أَحَسُدُ المَرءَ عَلى ضَيعَةٍ","وَلا عَلى دارٍ وَلا كَنزِ",50,"ز",1,1],["لا أحول عن موضعي","ما أساءت أو أحسنت",51,"ت",1,0],["لا احب اللبثَ في زمنٍ","حاجتي فيه إلى البشر",52,"ر",1,0],["لا أُحِبُّ الأَوْتارَ تَعْلُو كما لا","أشْتَهي الضَّرْبَ لازِماً للعَمُودِ",53,"د",1,0],["لا أحبُّ الدواةُ تُخْشَى يَراعاً","تلك عندي من الدُّوِيِّ معيبهْ",54,"ب",2,1],["لا أحفلن بعاذل","واللَه في هذا عذيري",55,"ر",2,0],["لا أحسب المرءَ في هذا الوجود سوى","حيٍّ أليف شقاءٍ يتَّقي العدَما",56,"م",2,1],["لا أُحِبُّ الضريرَ غيرَ ضريرِ","ثاقبِ الفكرِ ذي فؤادٍ بصيرَ",57,"ر",1,1],["لا أَحسُدُ المَرءَ عَلى دِرهَمِهِ","وَإِنَّما أَحسُدُهُ عَلى الأَدَب",58,"ب",1,1],["لا أحب الوغى ولا أنا منه","كل ما يقتل النفوس حرام",59,"م",1,0],["لا احسب الصحف التي تسودت","بمدحه إلا وضاء الصحف",60,"ف",1,0],["لا أحبُّ الفِجَّ الثقيلَ ولو جا","د ببذلِ المِئين والآلافِ",61,"ف",1,0],["لا أحب الصديق إن لم يشارك","ني قبل السرور في الاحزان",62,"ن",1,0],["لا أحب الهوى إذا اعترضته","شائبات الصدود والهجران",62,"ن",1,0],["لا أحب الرّدى ولا أتقيه","فضلال حبّي له وتقاتي",63,"ي",1,0],["لا أَحمِلُ اللَومَ فيها وَالغَرامَ بِها","ما حَمَّلَ اللَهُ نَفساً فَوقَ ما تَسَعُ",64,"ع",1,0],["لا أحمد الغيث ان عداك ولا","اذا انبرى في ثراك ينسجم",65,"م",1,0],["لا أَحدَ أذلّ مِن جديس","أَهَكذا يفعل بالعروسِ",66,"س",1,1],["لا أَحمَدُ الأَيّامَ حَتّى أَوصَلَت","عَني مُعِزَّ الدَولَةِ المَحمُودا",67,"د",2,0],["لا أحمد المرء أقصى ما يجود به","إذا عضرناه أصناف الشواريز",68,"ز",1,0],["لا احتوي خلة الصديق ولا","أتبع نفسي شيئاً إذا ذهبا",69,"ب",2,0],["لا أحِبُ الأكلَ والشر","ب مع الناس جميعا",70,"ع",2,1],["لا أحبسُ الدرهم عن حاجتي","فحافظُ المحبوس محبوس",71,"س",1,0],["لا أحب البُرْيْقَ إلاّ مغيراً","لا أحبُّ الرياحَ إلاّ شمالا",72,"ل",2,0],["لا أحمد البعد عنها بعد معرفتي","بأنها لبعادي غير حامدة",73,"ه",1,0],["لا أَحتَسِي ماءَهُ عَلى رَنَقٍ","وَلا يَراني لِبَينِهِ جَزِعا",74,"ع",2,0],["لا أُحب المديحَ الا بمثلٍ","لا مديحاً بليس لي من مثيلِ",75,"ل",1,1],["لا أحب العذار إل","لا إذا شاب صاحبه",76,"ب",2,0],["لا أحب النديم يومض بالطر","ف إذا ما خلا بعرسٍ نديم",77,"م",1,0],["لا أحرم اللَه هذا القطر من ملك","يصيب رأياً بإنقاذٍ وإنعام",78,"م",1,0],["لا أحسب الماضي لعمري إنه","من جمعة لم تتصل بخميس",79,"س",1,0],["لا أَحقِر النَّظرةَ السَّليمةَ في ال","وُدِّ ولا استقلُّها عجبَا",80,"ب",2,0],["لا أحسبنك قد علوت بمنزلٍ","عما خلا لك من رفيعِ ذراه",81,"ا",2,0],["لا احمرّ خدٌّ لا تعذّر سندسٌ","لا ماد غُصنٌ في أَريضِ خَمائل",82,"ل",1,0],["لا أحسنت حربًا، ولا","في السلم طاب السلم غبَّا",83,"ب",2,0],["لا أَحمدُ الدّمعَ إِلّا حينَ يَنسَجمُ","فَخلِّ دَمعَكَ يَسقي الرَّبعَ وَهوَ دَمُ",84,"م",1,1],["لا أحدٌ درى مقامي النائي","هما هما قد خففا شقائي",85,"ي",1,0],["لا أحاشي كل ربات النقاب","لا أُحاشي زوج إكسيون من",86,"ن",1,0],["لا أحب الثرى ولكنَّ نفسي","نفَّست كربها بلثم ثراكا",87,"ك",2,0],["لا أَحسِبُ الشَرَّ جاراً لا يُفارِقُني","وَلا أحُزُّ عَلى ما فاتَني الوَدَجا",88,"ج",2,1],["لا أُحِبُّ الَّذي يَلومُ وَإِن كا","نَ حَريصاً عَلى صَلاحي وَرُشدي",89,"د",2,0],["لا أحدٌ ببالغٍ لأرْفَعِ المَنَازِلِ","جناتِ عَدْنٍ حُورُها تَسْحَبُ في الغَلائلِ",90,"ل",1,0],["لا أحسبُ القلبَ إن ولى الحبيبُ بهِ","يدعى بعودٍ لأن النفس لم تعدِ",91,"د",1,0],["لا أحسب الحب إذ تخفى شعائره","إلا لعمر أبي غيما بلا مطر",92,"ر",1,0],["لا أحمل الزيتونَ.. في المنفى معي","وشراءُ زيتِ المُترفينَ.. مَذَلَّةْ",93,"ل",2,0],["لا أُحِبُّ انكِسارَهُ حِينَ يَأتِي","ليسَ يَدرِي عليهِ تَبكِينَ! أَو لَهْ!",94,"ل",2,0],["لا احدن يقول اني بمآ قلت جنيت","ياكم شعور بوسط عيني دفنته",95,"ت",2,0],["لا احدٍ يقول إني المسؤول","هذي طبوع الحيآويّه",96,"ي",2,0],["لا احدٍ يسب الحظ لآصآر ضآيق","الحظ مآله ذنب في كل ضيقه",97,"ق",2,1],["لا أحمد المرء أقصى ما يجود به","إذا عصرناه أصناف الشواريز",98,"ز",1,0],["لا أٌحِبُّ القُيودَ والأغلالا","إنَّنِي شاعرٌ يُحِبُّ الجمالا",99,"ل",2,1],["لا أحملُ بُعدكَ ثانيةً","أبنصف الشهر تحدِّدُهُ",100,"د",2,0],["لا احنا تعايشنا ولاتحقق أحلام","كانت معانا من زمان الطفوله",101,"ل",2,0],["لاأحرق الي مايغطي باللزوم إلباسه",".وأترك إحروب القصايد من يدي وانساها",102,"ا",3,0],["لااحدٍ يلوم القلوب اليا تهاونا","حيث انها سنة الله في مخاليقه",103,"ق",2,0],["لَا أحب الرَّقِيب إِلَّا لِأَنِّي","لَا أرى من أحب حَتَّى أرَاهُ",104,"ه",1,1],["لا أحاشي ولا أراقب فيهم","لوم من لامني يرد أذي",105,"ي",1,0],["لا أحسب الدهر حلواً دون لقيانا","لولا اللقاءُ لكان العيش أحزانا",106,"ن",2,1],["‏لا أحسن التدبير حتى في الهوى","‏ ‏ وحيِيتُ عمري خائباً موؤودا",107,"د",2,0],["لا أحسد الشعرات أعشق شكلها","قد آنَسْتَني إنني لَوَحِيد",108,"د",1,0],["لا أحييك في غنائي مهما","وعيوني تجيد فن بكاء",109,"ا",2,0],["لا أُحِبُّ الدُواة َ تُحْشَى يراعاً","تلكَ عندي من الدّويِّ معيبَهْ",110,"ب",2,1]]}