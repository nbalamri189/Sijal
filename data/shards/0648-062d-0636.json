{"poems":[[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[35,"وحض الذي ولى على الصبر والتقى","https://www.aldiwan.net/poem39139.html","الطويل"],[92,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[28,"تراها إذا صم النهار كأنما","https://www.aldiwan.net/poem5057.html","الطويل"],[61,"سل الملحي كيف رأى عقابي","https://www.aldiwan.net/poem51790.html","الوافر"],[66,"أزل بالخمر أدواء الخمار","https://www.aldiwan.net/poem39065.html","الوافر"],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[115,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[115,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[115,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[135,"وافت بأفراح المحب عناية","https://www.aldiwan.net/poem49083.html","الكامل"],[143,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[256,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[275,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[304,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[479,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[500,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[500,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[500,"طراز سر له في سمك قبته","https://www.aldiwan.net/poem38081.html","البسيط"]],"verses":[["وحُضورُهمْ في حادِثٍ كمَغيبِهمْ","وقِيامُهُمْ لمُلِمّةٍ كقُعودِ",0,"د",1,0],["وَحَضَّ الَّذي وَلّى عَلى الصَبرِ وَالتُقى","وَلَم يَهمُمِ البالي بِأَن يَتَجَشَّعا",1,"ع",2,1],["وحَضَرْتُ مائدَةَ الحَيَاةِ فلمْ أَجِدْ","إلاَّ شراباً آجِناً مَسْمُوما",2,"م",2,0],["وحضارة الفصحى وروح بيانها","وقريشٌ العالون والأنصار",3,"ر",1,0],["وَحَضارَةٌ مِن مَنطِقِ الوادي لَها","أَصلٌ وَمِن أَدَبِ البِلادِ نِجارُ",4,"ر",1,0],["وَحَضارَةُ الإِسلامِ تَن","طِقُ عَن مَكانِ المُسلِماتِ",5,"ت",1,0],["وَحِضنَينِ مِن ظَلماءِ لَيلٍ سَرَيتُهُ","بِأَغيَدَ قَد كانَ النُعاسُ لَهُ سُكرا",6,"ر",2,0],["وحضَّ على المُناهدةِ النَّدَامى","بألفاظٍ مهذَّبةٍ عِذابِ",7,"ب",1,0],["وَحَضَرَتنا مِنَ الأَزهارِ مَلأى","مِنَ الوَردِ المُكَلَّلِ بِالبَهارِ",8,"ر",1,0],["وحضَنْتَ هاتيكَ الأسِرَّةَ فوقَها","أُسْدٌ مُضَرَّجَةٌ تلوبُ لواغِبا",9,"ب",2,0],["وحضرة حال القوم فالحسن الرضا","ابو البركات القرم سيدها الفرد",10,"د",1,0],["وحضور الأرواح من حضرة ال","إحسان للمجلس العظيم الفخار",11,"ر",1,0],["وحضرة القدس قد حفت لزورته","بكل معنى عجيب النسق نوراني",12,"ي",1,0],["وحضوركم كل المرام فإنّ في","جمع الأحبة للسرورِ سبيلا",13,"ل",2,0],["وَحَضَّ السَقامِ عَلى ذا المَقامِ","مُشيرٌ لَعَمرُكَ لَم يُستَشَر",14,"ر",1,0],["وحضور الطعام قبل طلوع الش","مس مذ أمس بارد الألوان",15,"ن",1,0],["وحَضْرَةُ السَّعْدِ فِي أبْهَى مَنَاظِرِها","رَاحَتْ بِخِدْمَتِها الأَقْدارُ تَزْدَلِفُ",16,"ف",1,0],["وحضائر ومحاضر ومناظر","ونواظر نور الجمال الأرفع",17,"ع",1,0],["وحضرت في ذاك المساء لخبره","وكأن حضرت ليوم عقد نكاح",18,"ح",1,0],["وحضرَةُ القُدْسِ له","تُدْلي بحبلٍ أَطْوَلِ",19,"ل",1,0],["وحضْرةٌ من فُؤادي فيكَ حاضرةٌ","وعن جَنابكَ طرْفَ العينِ ما اشْتغلَتْ",20,"ت",1,0],["وحضْرَةٌ كتبَ الباري القديمُ على","سجِلِّها كُلَّما جاءَتْ به الكُتُبُ",21,"ب",1,0]]}