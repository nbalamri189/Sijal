ttps://www.poetsgate.com/ViewPoem.aspx?id=214821",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5367,"شُهود","https://www.poetsgate.com/ViewPoem.aspx?id=197191",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5574,"لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=206010",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5956,"عمّقتَ بي يا صاحبي الإيمانا","https://www.poetsgate.com/ViewPoem.aspx?id=194750",""],[5975,"أنتِ قلبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=53268",""],[6152,"العناق","https://www.poetsgate.com/ViewPoem.aspx?id=201768",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["وحُضورُهمْ في حادِثٍ كمَغيبِهمْ","وقِيامُهُمْ لمُلِمّةٍ كقُعودِ",0,"د",1,0],["وَحَضَّ الَّذي وَلّى عَلى الصَبرِ وَالتُقى","وَلَم يَهمُمِ البالي بِأَن يَتَجَشَّعا",1,"ع",2,1],["وحَضَرْتُ مائدَةَ الحَيَاةِ فلمْ أَجِدْ","إلاَّ شراباً آجِناً مَسْمُوما",2,"م",2,0],["وحضارة الفصحى وروح بيانها","وقريشٌ العالون والأنصار",3,"ر",1,0],["وَحَضارَةٌ مِن مَنطِقِ الوادي لَها","أَصلٌ وَمِن أَدَبِ البِلادِ نِجارُ",4,"ر",1,0],["وَحَضارَةُ الإِسلامِ تَن","طِقُ عَن مَكانِ المُسلِماتِ",5,"ت",1,0],["وَحِضنَينِ مِن ظَلماءِ لَيلٍ سَرَيتُهُ","بِأَغيَدَ قَد كانَ النُعاسُ لَهُ سُكرا",6,"ر",2,0],["وحضَّ على المُناهدةِ النَّدَامى","بألفاظٍ مهذَّبةٍ عِذابِ",7,"ب",1,0],["وَحَضَرَتنا مِنَ الأَزهارِ مَلأى","مِنَ الوَردِ المُكَلَّلِ بِالبَهارِ",8,"ر",1,0],["وحضَنْتَ هاتيكَ الأسِرَّةَ فوقَها","أُسْدٌ مُضَرَّجَةٌ تلوبُ لواغِبا",9,"ب",2,0],["وحضرة حال القوم فالحسن الرضا","ابو البركات القرم سيدها الفرد",10,"د",1,0],["وحضور الأرواح من حضرة ال","إحسان للمجلس العظيم الفخار",11,"ر",1,0],["وحضرة القدس قد حفت لزورته","بكل معنى عجيب النسق نوراني",12,"ن",2,0],["وحضوركم كل المرام فإنّ في","جمع الأحبة للسرورِ سبيلا",13,"ل",2,0],["وَحَضَّ السَقامِ عَلى ذا المَقامِ","مُشيرٌ لَعَمرُكَ لَم يُستَشَر",14,"ر",1,0],["وحضور الطعام قبل طلوع الش","مس مذ أمس بارد الألوان",15,"ن",1,0],["وحَضْرَةُ السَّعْدِ فِي أبْهَى مَنَاظِرِها","رَاحَتْ بِخِدْمَتِها الأَقْدارُ تَزْدَلِفُ",16,"ف",1,0],["وحضائر ومحاضر ومناظر","ونواظر نور الجمال الأرفع",17,"ع",1,0],["وحضرت في ذاك المساء لخبره","وكأن حضرت ليوم عقد نكاح",18,"ح",1,0],["وحضرَةُ القُدْسِ له","تُدْلي بحبلٍ أَطْوَلِ",19,"ل",1,0],["وحضْرةٌ من فُؤادي فيكَ حاضرةٌ","وعن جَنابكَ طرْفَ العينِ ما اشْتغلَتْ",20,"ت",1,0],["وحضْرَةٌ كتبَ الباري القديمُ على","سجِلِّها كُلَّما جاءَتْ به الكُتُبُ",21,"ب",1,0],["وحضْرَتُها والرَاحُ والنُّقْلُ والغِنا","ونَرْجِسُها والزَّهرُ والآسُ والوَرْدُ",22,"د",1,0],["وَحَضَرَ الكُلُّ صِحاف المائِدَه","وَشَهِدوا ساخِنةً وَبارِدَه",23,"ه",1,0],["وَحَضَرت تَنظره الرِجال","وَقُلتُ في رُؤيَتِهِ ما قالوا",24,"ل",3,0],["وَحَضَر الدُبُّ وَحَطَّهُ عَلى","خَيشومه لِصَدره فَنَزَلا",25,"ل",2,0],["وَحَضْرَةٍ زَيَّنَتْهَا بُقْعَةٌ جُعِلَتْ","وُسْطَى لِعِقْدٍ نَفِيسٍ مِنْ مَبَانِيهَا",26,"ي",3,0],["وحضرتهُ الدنيا ونائلهُ الغمرُ","أعد حديث الكرام",27,"م",1,0],["وحضرة شاهدي عدلٍ عليها","لتنكح بعد ميقاتِ الفراقِ",28,"ق",1,1],["وحضارة شمّاء تحكي نهضةً","غير الصدارة لا تريد بديلا",29,"ل",2,0],["وحضوري في حضائركم","وشهودي الواحد الأحد",30,"د",1,0],["وحضوراً في مماتي أي","ثمّ في غسلى وملتحدى",30,"د",2,0],["وحضارة الإسلام طود شامخٌ","بالعلم والإدراك والعرفان",31,"ن",1,0],["وحضارة الإسلام خير حضارةٍ","إذ شيدت في منهج القرآن",31,"ن",1,0],["وحضنتها ضما بكل تلهف","وبكل جارحة جنوت عليها",32,"ي",3,0],["وَحَضرَة الحُسينِ والي حَلبا","كَم بَذلا جُهداً وَقاسا تَعَبا",33,"ب",2,0],["وحضرات العلما الثقات","مع وجوه الثغر والذوات",34,"ت",1,0],["وحضرات العلما الأفاضل","والأمر الذوات والقناصل",35,"ل",1,0],["وحضوا على العلم ابناءها","فليس لها العلم بالضائر",36,"ر",1,0],["وَحَضرنَ بعدك الاِمتحان فلم تُر","إلّا كآبة آسفٍ وبكاءُ",37,"ا",2,0],["وحضَّ إذ خصَّ بالتشريف أمته","على النكاح لما قد جاء في الأثرِ",38,"ر",1,0],["وحضرَةُ الملكِ وحَمْراؤهُ","حكَتْ بُروجَ الأفْقِ أبراجُها",39,"ج",3,0],["وحضْرتُكَ العَلياءُ عزّ جَنابُها","حَديثُ عُلاها مُسْنَدٌ ومُصحَّحُ",40,"ح",1,0],["وحضنت هذا الطين فاتقد الهوى","في مائه وترابه المسبوك",41,"ك",1,0],["وحضر الغلام عندي مفردا","وأحضر الراجل شدّا أي عدا",42,"د",2,0],["وَحَضَّ كُلَّ النَّاسِ أَن يَقُولُوا","شَهَادَةً تَزكُوا بِهَا العُقُولُ",43,"ل",1,0],["وحضرتنا التقييد عنا بها انتفى","بإثبات اطلاق ووحدة حال",44,"ل",1,0],["وحضٍ عنيد ودايم الدوم منحوس","يالله دخيلك من حضوضٍ مناحيس",45,"س",1,0],["وحضارةٌ بَرّاقةٌ كمنارةٍ","أضحَتْ تُنادي بالخليجِ هديلا",46,"ل",2,0],["وَحُضُورُكَ الْمُنْسَابُ عِطْراً حَانِياً","قَدْ لَفْلَفَ الْقَلْبَ انْشِرَاحًا فاسْتَقى",47,"ق",2,0],["وحضنُ الشّمسَ لي مَأوى","تراهُ القلبُ قدْ عَفَّ !!!",48,"ف",1,0],["وحضرة القدس لم تترك مساجدها","فهن والقدس مثل الحلب والعلب",49,"ب",1,0],["وحضننا لعناقِ البينِ مجتمعٌ","لكنه بعناق الحب ينهزمُ",50,"م",1,0],["وحضنَّاه بشوقٍ عابثٍ","فانبرى يرقص طِيبًا حولنا",51,"ن",2,0],["وحضور ما شابه من فتور","وارتفاع يبقيه فوق المنائر",52,"ر",1,0],["وحضارتي فى مصر نبض حضارتي","قمم من الأنحاب والأعلام",53,"م",1,0],["وحضى على بغض الموالي وراكن","إليهم لكي تبقى لديهم مآكله",54,"ل",2,0],["وحَضَرْتَ معنى الكونِ في أَسرارِه","خَطَراتهِنَّ لَوائِحًا وبَوارقا",55,"ق",2,0],["وحضرت للمبنا عليها مزاهبي","واسد الشرى منهو يواثب تواثبه",56,"ب",2,0],["٢- وحضنُكِ مرتعٌ من دنْدناتٍ","على أنغامِها قد قِيلَ شعْرُ",57,"ر",1,0],["وحضرموت تخلت عن مكاربها","فاستوطنوا زمناً يُنعى إلى زمنِ",58,"ن",1,0],["وحضوركم عندي يحل أمورنا","ومتاعباً نفسية تغشانا",59,"ن",2,0],["وحضنتُ الهوى ولم أتحوّلْ","عنهُ ذاكَ الهوى لعزميَ شدّا",60,"د",2,0],["وحضنتها لما تعالى نبضها","وتبرمت أتعبتني أشواقا",61,"ق",2,1],["وحضارةٍ رَعَتِ الظلامَ طويلا","والسّامريَّ وعجلَهُ المرذولا",62,"ل",2,0]]}