{"poems":[[90,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[49,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[93,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[72,"هوانا بالهوى كم ذا التجني","https://www.aldiwan.net/poem42447.html","الوافر"],[91,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[47,"أيها العاتب الذي ليس يرضى","https://www.aldiwan.net/poem64637.html","الخفيف"],[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[107,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[107,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[107,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85522","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[101,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[215,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[242,"هوان لدنيا غزلها بيد النقض","https://www.aldiwan.net/poem19304.html","الطويل"],[333,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[354,"حروف هوى ثلاث من ثلاث","https://www.aldiwan.net/poem15551.html","الوافر"],[358,"هوانا هوى الغيد الحسان بلا مرا","https://www.aldiwan.net/poem39996.html","الطويل"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[563,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[580,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[580,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138191",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112473","المديد"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112429","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86814","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56163","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64543","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49575","الطويل"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130677","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27984","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27273","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83050","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65142","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140007","الطويل"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60283","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205922","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36727","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44892","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44896","الرمل"],[4107,"","https://poetry.dctabudhabi.ae/diwan/poem/198752","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94911","الوافر"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73202","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4666,"","https://poetry.dctabudhabi.ae/diwan/poem/198799","الكامل"],[4728,"الجد والغي","https://www.poetsgate.com/ViewPoem.aspx?id=176883",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4961,"ليسَ في أوَّل ِ الطريق ِ يُكتشَفُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=40462",""],[3271,"عاهل الريف الثور","https://www.poetsgate.com/ViewPoem.aspx?id=104127",""],[5075,"الحب سر","https://www.poetsgate.com/ViewPoem.aspx?id=187768",""],[5237,"أبت همي إلا الولوع بمن تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=113109",""],[5268,"المَوتُ والحرِّيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=206993",""],[5277,"أتراك","https://www.poetsgate.com/ViewPoem.aspx?id=184885",""],[5356,"إصبعي مخدوش","https://www.poetsgate.com/ViewPoem.aspx?id=205813",""],[5411,"أَنَّى لَكَ العُتْبَى","https://www.poetsgate.com/ViewPoem.aspx?id=200024",""],[5413,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208710",""],[5419,"نعمة","https://www.poetsgate.com/ViewPoem.aspx?id=32227",""],[5431,"مادمت أنت بناره متورّطا ....","https://www.poetsgate.com/ViewPoem.aspx?id=200964",""],[5622,"المقعدُ الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=210326",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5751,"هوانا الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=215016",""],[5943,"بريء","https://www.poetsgate.com/ViewPoem.aspx?id=21949",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""],[5956,"الحمد لله على إرساله لمحمد","https://www.poetsgate.com/ViewPoem.aspx?id=192571",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[5975,"أنا في هذه الدنيا سجينُ","https://www.poetsgate.com/ViewPoem.aspx?id=53401",""],[6142,"بالغريين وبين الذكوات","https://www.poetsgate.com/ViewPoem.aspx?id=155734",""],[6142,"جاءنا بالشريعة السهلة الس","https://www.poetsgate.com/ViewPoem.aspx?id=155701",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6152,"المُتلون","https://www.poetsgate.com/ViewPoem.aspx?id=204602",""],[6152,"الشعر أن يطابق القول الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=213198",""],[5309,"يدافع عن عرض الفتى حسن فعله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573596",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""]],"verses":[["هو أن رشّ جاش وحلاً وإلاّ","جاش نقعاً على الوجوه مثارا",0,"ر",2,0],["هَوانا غَريبٌ شُزَّبُ الخَيلِ وَالقَنا","لَنا كُتُبٌ وَالباتِراتُ رَسائِلُ",1,"ل",1,0],["هُوَ إِن ذَكَرتَ الشِعرَ مِن أُمَرائِهِ","وَإِذا ذَكَرتَ المَجدَ فَهوَ عِصامي",2,"م",2,0],["هَواناً بِالهَوى كَم ذا التَجَنّي","وَكَم هَذا التَعَلُّلُ وَالتَمَنّي",3,"ن",2,1],["هو ان صاح فالجوانح تهفو","واذا نادى فالقلوب تجيب",4,"ب",1,0],["هُوَ إِن أوتيتَهُ أَسنى النِعَم","هَل تَرى الجُهّالَ إِلّا كَالنَعَم",5,"م",1,0],["هُوَ أَندى مِنَ الغَمامِ وَأَوفى","وَقَعاتٍ مِنَ الحُسامِ وَأَمضى",6,"ض",2,0],["هو أنشودة الحيا","ةِ وفيضٌ من النغم",7,"م",1,0],["هو إن مات شهيداً خالدٌ","في حياةٍ من جلالٍ وعِظَمْ",8,"م",1,0],["هو إن سألتَ أُولي المعارف ما اسمه","سُلٌّ يُذيبُ حَياتها وجُذامُ",9,"م",1,0],["هو إن طَمَّ على الأرضِ الأذى","رحمةُ الأرضِ ومَحيَا الأُمَمِ",10,"م",1,0],["هو إن سالموه نادى بسلم","وهو إن حاربوه خار الطعانا",11,"ن",2,0],["هُوَ أَنَّةٌ وَتَسِيلُ مِنْ","جَرَّائِهَا نَفْسٌ صَبِيبُ",12,"ب",1,0],["هُوَ أَنشا عِبادَهُ","وَهوَ إِن شاءَ يَنسَخِ",13,"خ",1,0],["هو أن تظل على الأصابع رعشة","وعلى الشفاه المطبقات سؤال",14,"ل",1,0],["هو أن نثور لأي شيء تافه","هو يأسنا .. هو شكنا القتال",14,"ل",1,0],["هو ان بدا بدر وان قصد الجفا","ليث يريع النذل هول نزاله",15,"ل",2,0],["هوانا الهوى والعاشقون جميعهم","وإن عظموا في ظل رايتنا جند",16,"د",1,0],["هَوَانٌ لِدُنْيَا غَزْلُهَا بِيَدِ النَّقْضِ","إِذَا لَمْ تَكُنْ تُرْضِي الذِي لَمْ يَزَلْ يُرْضِي",17,"ض",2,1],["هو إن ثار فالبسيطة روما","وهو نيرونها بلا نيران",18,"ن",1,0],["هَوانٌ ثُمَّ وَيلٌ ثُمَّ يَأسٌ","لِأَطماعِ المُحِبِّ بِها اِجتِثاثُ",19,"ث",1,0],["هَوانا هَوى الغيد الحسان بِلا مِرا","تُباع بِهِ مِنّا النُفوس وَتُشتَرى",20,"ر",2,1],["هوان كُلّ كَليم بَينَهُم لسن","هَوان كُلّ كَليم القَلب مُغتَربِ",21,"ب",1,0],["هو انفراد الكثير بما تجلى","وما قد غاب منه عن الحوادث",22,"ث",1,0],["هو إِنْ سرتَ عديلُ","ونزيلٌ بِحِنَائِك",23,"ك",1,0],["هو أَنْدَى يَداً وَأَبْهَر أَنْوا","راً وأَوْرَى زَنْداً وأَحْسَنَ مَنْظر",24,"ر",1,0],["هو أَندى يداً وأَكرَمُ أَفعا","لاً وأَسْمَى مُلْكاً وأَعْلَى مَنَارَا",25,"ر",2,0],["هو أن نراهم ضارعوا النزلاء في","فيض الأكف وبسطها بعطاء",26,"ا",2,0],["هو أن يبكي فسؤدده","صيرته الحادثات هبا",27,"ب",2,0],["هو إن لم يأخذ استقلاله","قتل النفس والأشرب السم",28,"م",1,0],["هُوَ أَنتَ يا تَوفيق أَفخَم دَولة","شَيّدت مِنها حُسنَها بِظَهير",29,"ر",1,0],["هَوَانَا بِهِ كَمْ يَحْمِلِ الصَّيْحَ فِي الْهَوى","وَمِنْ شَوْقِكُمْ لَمْ يَبْقَ إلاَّ بَقَايَاهُ",30,"ه",1,0],["هو أنني لما رأيت بأن لا","يُجلي عن الألباب كل صداءِ",31,"ا",2,0],["هو أنت اللّه الذي كنت والازا","ل كانت بكن وبعد كقبل",32,"ل",1,0],["هو أنت اللّه المكون للكي","ف وللكم والمتى والمحل",32,"ل",1,0],["هو أنت اللّه الاله القديم ال","أحد الفرد الباطن المتجلي",32,"ل",2,0],["هو أنت اللّه الرفيع الجمال الصم","د الدائم الجلال الأجل",32,"ل",1,0],["هو أنت اللّه الذي لم يلد ك","لا ولما يولد وينسب لأصل",32,"ل",1,0],["هو أنت اللّه المقدس عن كف","وء وضد وعن شريك وشكل",32,"ل",1,0],["هو أنت اللّه المنزه عن ادرا","ك حس وعن توهم عقل",32,"ل",1,0],["هو أنت اللّه المنزه عن ح","د ورسم وأي فصل ووصل",32,"ل",1,0],["هو أنت اللّه الذي بدأ الخل","ق وافناه قهره المتولي",32,"ل",2,0],["هو أنت اللّه المعيد لما أفني","ت بعثاً إلى جزاء وفصل",32,"ل",1,0],["هو أنت اللّه الذي دان حقاً","إنه لا إله غيرك عقلي",32,"ل",2,0],["هو أنت اللّه الذي اسمك","الحسي سري سره بجزء وكل",32,"ل",1,0],["هو أنت اللّه اختصصت بقيو","مية حاطت الوجود بحول",32,"ل",1,0],["هو أنت اللّه العزيز الثنا عن","سنة أو نوم وسهو وغفل",32,"ل",1,0],["هو أنت اللّه الذي ملك العر","ش وما فيه من دقيق وجل",32,"ل",1,0],["هو أنت اللّه المهاب فمن يش","فع إلا بالاذن ممن تولي",32,"ل",2,0],["هو أنت اللّه العليم قديماً لا","بعلم كعلمنا بعد جهل",32,"ل",1,0],["هو أنت اللّه المفيض لمن ش","ئت بما شئت من علوم وعقل",32,"ل",1,0],["هو أنت اللّه الذي وسع الكر","سي والعرش عزه المتعلي",32,"ل",2,0],["هو أنت اللّه الحفيظ فلا","تنسى ولا تعتريك وصمة كل",32,"ل",1,0],["هو أنت اللّه المبر باعلا","ن وسر بلطفك المستهل",32,"ل",1,0],["هو أنكى رأياً لطارقة الخطب","وأذكى لطارق الضيف نارا",33,"ر",2,0],["هو ان يمت فالمدح فيه مخلد","والنجل يحيى للمكارم باقى",34,"ق",2,0],["هو انْتَاشَنِي منْ غمرةِ الموتِ بَعْدَما","يئستُ وقالوا هالكٌ في الهوالك",35,"ك",1,0],["هو أنس الوحيد في خلوات","هو نعم الرفيق في الاسفار",36,"ر",1,0],["هو أنقذ البيت المقدس عنوة","والظلم قد عمَّ البلاد وطبقا",37,"ق",2,0],["هوان الذوق من هذا وهذا","إذا كنا بحضرته قرانا",38,"ن",2,0],["هو أنني وهابه أسرارهم","عرفانها فِصراطُنا ممدود",39,"د",1,0],["هُوَ أنكَرَ التَّكلِيمَ وَالفَوقِيَّةَ ال","عُليَا كَقولش الجَهمِ ذِي صَفوَانِ",40,"ن",1,0],["هُوَ أنكَرَ الوَصفَينِ وَصفَ الفَوقِ وَالتَّ","كلِيمِ إنكَاراً عَلَى البُهتَانِ",40,"ن",1,0],["هوانُ البَخيلِ عَلى أهلِه","هوانُ قعيسٍ على عمَّتِه",41,"ه",1,0],["هُو أنبلُ الفضلاء إلا أنّهُ","بين الأفاطن أفضلُ النّبلاء",42,"ا",2,0],["هوانُك غبنٌ فاطلب الفوز بالتقى","فإن التُقى نهجُ تلوحُ صواه",43,"و",3,0],["هو أن لفظ الشيء صار مخصصاً","بالجسم عندي بالدليل الأكمل",44,"ل",1,0],["هو أن حُفَّاظَ الكتاب إذا هُمُ","قاموا إلى حشر وأرفع منزل",44,"ل",1,0],["هو انتخاب، أجل بل تلك غربلة","وهم هنالك في غِربالها وضرُ",45,"ر",1,0],["هُوَ أَنَّ سَيِّدنا الَّذي","حازَ العُلومَ السامِيَه",46,"ي",2,0],["هُوَ إِن شئتَ طَريفٌ تالِدٌ","وَهُوَ اِن شئت عَظيمٌ لا يُحَدّْ",47,"د",1,0],["هُوَ إِن شئتَ فَراغٌ مُطلَقٌ","وَهوَ إِن شئتَ جَزاءُ المُستَريبِ",48,"ب",1,0],["هُوَ أَن تَظغى عَلَينا نَوَبٌ","فَتَغنَّينا بِهجرانٍ وَبينِ",49,"ن",1,0],["هو أنشودةٌ على كل ثغرٍ","وهو قَطْر لكل صادٍ وماءُ",50,"ا",2,0],["هو انطونيوس مَن سادَ وصفاً","بتحكيم الحجى والمعجزاتِ",51,"ت",1,0],["هُوَ إِن شئت مَحض نار وَنور","وَ