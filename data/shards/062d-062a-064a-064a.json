ps://www.aldiwan.net/poem31880.html","الرجز"],[407,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[413,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[413,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[429,"الله يعلم أنني ما خلته","https://www.aldiwan.net/poem12780.html","الكامل"],[436,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[436,"قد عادت الشمس في أعلى مطالعها","https://www.aldiwan.net/poem34798.html","البسيط"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[436,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[436,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[436,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[436,"اليوم أبهجت المنى إبهاجها","https://www.aldiwan.net/poem34909.html","الكامل"],[441,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[451,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[451,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[451,"لا الرمز يغني ولا التصريح يرضيني","https://www.aldiwan.net/poem61353.html","البسيط"],[451,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[451,"ألقاك في وطني الحبيب الأول","https://www.aldiwan.net/poem61630.html","الكامل"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[473,"لا در دري إن أطعمت نازلكم","https://www.aldiwan.net/poem1824.html","البسيط"],[477,"قل هكذا الشعر ترتاح النفوس له","https://www.aldiwan.net/poem37190.html","البسيط"],[498,"يا آخذا وسط الشآم","https://www.aldiwan.net/poem37633.html","مجزوء الكامل"],[498,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[511,"من لي بعطف أخ خلي الإخاء ورا","https://www.aldiwan.net/poem67719.html","البسيط"],[513,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[513,"قل للمكرم إدلالاً وما بحر ال","https://www.aldiwan.net/poem12282.html","البسيط"],[538,"لو هاج صحبك شيئا من رواحلهم","https://www.aldiwan.net/poem56656.html","الخفيف"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[549,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[549,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[549,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[551,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[556,"معرفة الله عند عارفه","https://www.aldiwan.net/poem33563.html","المنسرح"],[556,"نهر القضاء بما يختار خالقنا","https://www.aldiwan.net/poem34625.html","البسيط"],[556,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[559,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[560,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[565,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[565,"ومستدير كجرم البدر مسطوح","https://www.aldiwan.net/poem69754.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"أوحشتموا نظري فكم من عبرة","https://www.aldiwan.net/poem17613.html","الكامل"]],"verses":[["حَتّى يَزولَ فَحولُها","مِنكُم وَقَد دانوا وَدَينوا",0,"ن",3,0],["حَتّى يَظُنَّ الصُبحَ سَيفاً مُنتَضىً","أَهوى إِلَيهِ مَعَ الكَمِيِّ المُعلِمِ",1,"م",1,0],["حَتّى يَقولَ الغابِطونَ وَقَد رَأوا","فَعَلاتِهِ زاحِم بِجِدٍّ أَودَعِ",2,"ع",1,0],["حَتّى يَقولَ الساهِرونَ لَوَمضِهِ","نَضَرَ العِراقُ بِقَطرِ هَذا العارِضِ",3,"ض",1,0],["حَتّى يَذوقَ لِحَدِّ أَنصُلِها","طَعناً وَلا طَعنَ القَنا القَصَدِ",4,"د",1,0],["حَتّى يَشُقَّ عَلى العَقيقِ مَزادَهُ","مِن غابِقٍ لِرِياضِهِ أَو صابِحِ",5,"ح",1,0],["حتّى يرُدَّ قِوامَ دولَةِ هاشِمٍ","مَنْ يَرتَجيهِ لِما يَقولُ العاذِلُ",6,"ل",1,0],["حتى يَمُجَّ غِرارُ المَشْرَفيِّ دَماً","والرّمْحُ ما بينَ لَبّاتٍ وأوْداجِ",7,"ج",1,0],["حتى يَرى لَيلَهُ بالصُّبْحِ مُلتَثِماً","وقد قَضى بالكَرى للعاجزِ الفَشَلُ",8,"ل",1,0],["حَتّى يَذوقَ القَومُ طَعمَ الهَوى","فَيَعذِروا في الحُبِّ مَن فَنَّدوا",9,"د",3,0],["حتّى يُهيبَ بأهْلِهِ الوعْدُ الذي","حشَرَ الرّئيسَ إليْهِ والمرؤوسا",10,"س",2,0],["حتّى يُرَى وليمَةً","لٍكُلِّ مرهوبِ التُّغا",11,"غ",2,0],["حتّى يُراعَي وجْهُهُ في وِجْهَتي","بعِنايةٍ تَشْفي الصّدورَ وتَشْرَحُ",12,"ح",1,0],["حَتَّى يَكُونَ اسْمُ السَّعِيدِ مُضَمَّناً","فِي كُلِّ مِنْبَر خُطْبَةِ وَخطَابِ",13,"ب",1,0],["حَتّى يُفيدَكَ مِن بَنيهِ رَهينَةً","نَعشٌ وَيَرهَنَكَ السَماكُ الفَرقَدا",14,"د",2,0],["حَتّى يَقولُ الناسُ مِمّا رَأوا","يا عَجَبا لِلمَيِّتِ الناشِرِ",15,"ر",1,0],["حَتّى يَظَلَّ عَميدُ القَومِ مُتَّكِئاً","يَدفَعُ بِالراحِ عَنهُ نِسوَةٌ عُجُلُ",16,"ل",1,0],["حَتّى يُصَبِّحَ أَقواماً يُحارِبُهُم","أَو يُسلَبوا دونَ صَفِّ القَومِ أَسلابا",17,"ب",2,0],["حَتّى يَؤوبَ بِما يَؤوبُ","كَثيرَ فَضلِ العُرفِ حامِد",18,"د",1,0],["حَتّى يَئِضنَ كَأَمثالِ القَنا ذَبَلَت","مِنها طَرائِقُ لَدناتٌ عَلى أَوَدِ",19,"د",1,0],["حَتّى يَعودَ مِنَ البَلاءِ كَأَنَّهُ","في الكَفِّ أَفوَقُ ناصِلٌ مَعصوبُ",20,"ب",1,0],["حتى يصب لها فضل النطاف إذا","ما كدَّر الماحة الساقون ذا القُلُبِ",21,"ب",1,0],["حتى يقول موَاليه وحاسده","هذا ابن أيوب أم هذا ابن داود",22,"د",1,0],["حتى يغني الرَّجا بشراك يا ظمإي","سعد السعود ومجري الماء في العود",23,"د",1,0],["حتى يقول بغيظه","أوَّاه من عدوانه",24,"ن",2,0],["حتى يعيشَ جَريرٌ","لعيبه أو نُصَيْبُ",25,"ب",1,0],["حتى يُزَيِّنَهَا بزينةِ ماجدٍ","ليست بتطويقٍ ولا توشيحِ",26,"ح",1,0],["حتى يُغَيَّبَ في مُطَمْطَمَةٍ","لا أهلُه فيها ولا ولَدُهْ",27,"د",2,0],["حتى يصدِّقَ من كَنا","ك فوارسٌ لهمُ كريرُ",28,"ر",1,0],["حتى يعود حديثُه","وكأنه عسلٌ مشور",29,"ر",1,0],["حتّى يلاقيني أجفى جُفاتِهمُ","بلا فتورٍ يُرى فيه ولا كسلِ",30,"ل",1,0],["حتى يراه الإلهُ مُعترفاً","بالحقّ يرعى الحقوق والحُرَما",31,"م",2,0],["حتى يقول جليسي","عليَّ أيضاً تُعمِّي",32,"م",2,0],["حتى يرى فيه كل سؤلٍ","ومُنْيةٍ عبدُه بُنان",33,"ن",1,0],["حتى يراني الله كَيْ","ف صيانتي قَدْري وشاني",34,"ن",2,0],["حَتّى يَظَلَّ لَهُ مِنهُنَّ واعِيَةٌ","مُستَوهِلٌ عامِلُ التَقزيعِ وَالصَخَبِ",35,"ب",1,0],["حَتّى يَرى التيهَ عَلى المُلوكِ","وَلا يُبالي سَطَوَةَ الأَميرِ",36,"ر",1,0],["حَتّى يَمُرَّ الفاتِحونَ فَإِنَّهُم","كَشَوا الأَذى عَنكُنَّ وَالإِذلالا",37,"ل",2,0],["حَتّى يَبينَ لِناظِري","مَن مِنهُما زاهٍ وَزاهِر",38,"ر",1,0],["حتَّى يُواريها ضَبابُ الموتِ","في وادي الدُّثورْ",39,"ر",1,0],["حَتّى يَصيدَ بِسَعدِكَ الأَبطالُ في","يَومِ الوَغى بِأَسِنَّةٍ وَقَواضِبِ",40,"ب",1,0],["حَتّى يَجودَكَ دَمعُ الطَلّ مُنهَمِراً","مِن أَعيُن الزَهرِ لم تَبخَل بِإِسعادِ",41,"د",1,0],["حَتّى يَراكَ الجَمعُ أَوَّلَ طالِعٍ","وَيَرَوا عَلى أَعرافِكَ المِنديلا",42,"ل",2,0],["حتى يقولَ جميعُ الخالدينَ بها","يا ليتَ أنّا معاً كُنّا مُحِبِّينا",43,"ن",2,0],["حَتّى يُشارَ إِلَيكَ ذا مَولاهُمُ","وَهُمُ المَوالي وَالخَليقَةُ أَعبُدُ",44,"د",1,0],["حَتّى يَقولَ الناسَ ماذا عاقِلاً","وَيَقولَ بَيتُ المالِ ماذا مُسلِما",45,"م",2,0],["حتى يصيرا زعفراناً عرقا","وقبل ذاك قد عقدت زئبقا",46,"ق",2,0],["حَتّى يَتِمَّ لَكَ الثَناءُ مُخَلَّداً","أَبَداً كَما تَمَّت لِيَ النَعماءُ",47,"ا",2,0],["حَتّى يَروحَ مُتارِكاً كَمُعارِكٍ","بِجَميعِهِ وَمُسالِماً كَمُحارِبِ",48,"ب",1,0],["حَتّى يَعودَ الجَديدَ المُشتَرى خَلَقاً","تَرذُلُهُ العَينُ وَالمُنصاتُ مُنآدا",49,"د",2,0],["حَتّى يَكادَ يُرينا ضَوءُ عارِضِهِ","مِنَ العِراقِ مُحِلّاً بِالسَواجيرِ",50,"ر",1,0],["حَتّى يَراهُ لِغَيظِهِ مُتَجَرِّعاً","يَحبوهُ في يُسرٍ وَفي إِفلاسِ",51,"س",1,0],["حَتّى يَعودَ الذِئبُ لَيثاً ضَيغَماً","وَالغُصنُ ساقاً وَالأَرارَةُ نيقا",52,"ق",2,0],["حَتّى يَرى رَتبيلُ مِنها غارَةً","شَعواءَ غَيرَ تَرَجُّمِ الأَخبارِ",53,"ر",1,0],["حَتّى يَرِعنَ وَهُنَّ حَولَ مُعَمَّمٍ","بِالتاجِ في حَلَقِ المُلوكِ نِضارِ",54,"ر",1,0],["حَتّى يُداوِيَ أَهلُهُ مَأمومَةً","في الرَأسِ تُدبِرُ مَرَّةً وَتَثورُ",55,"ر",1,0],["حَتّى يُرى وَهوَ مَحزومٌ كَأَنَّ بِهِ","حُمّى المَدينَةِ أَو داءَن مِنَ المومِ",56,"م",1,0],["حَتّى يَبيتَ عَلَيهِم حَيزُ أَدرَكَهُم","مِنّا جَوادِعُ قَد أُلحِقنَ بِالسُنَنِ",57,"ن",1,0],["حتى يعودَ ثَراكَ غَضْ","ضَ العُودِ مُخضَرَّ الَملابِس",58,"س",1,0],["حتى يُشِيبَ منهمُ الأَشفارا","فلم نَزَلْ نأخُذُها نَهارا",59,"ر",2,0],["حتى يُبَدِّلَ للعُشَّاقِ زورَتَه","طَيفٌ يَصُدُّ عن العُشَّاقِ صاحبُه",60,"ب",2,0],["حتى يعودَ الشَرْقَ لابسَ حُلَّةٍ","من أرجوانِ الفَجرِ أو زِريابِه",61,"ب",2,0],["حَتّى يَأُوبَ بِها عوجاً مُعَطَّلَةً","تَشكو الدَوابِرَ وَالأَنساءَ وَالصُفُقا",62,"ق",2,0],["حَتّى يُفَرِّجُها في حالِ مُدَّتِها","فَقَد يَزيدُ اِختِناقاً كُلُّ مُضطَرِبِ",63,"ب",1,0],["حَتّى يُرينا أَدهَمَ اللَي","لِ شَبيهَ الأَبلَقِ",64,"ق",1,0],["حَتّى يَرى الجُبَناءُ عَن حَملِ الهَوى","غاياتِ عِزِّهُمُ الَّتي لَم تُلحَقِ",65,"ق",1,0],["حَتّى يَكادُ لِسانُ الصُبحِ يُفشينا","لِلَّهِ كَم قَد قَضَينا مِنكُمُ وَطَراً",66,"ر",2,0],["حَتّى يَقولَ كُلُّ رَبِّ رُتبَةٍ","قَد رَجَعَ الحَقُّ إِلى نِصابِهِ",67,"ب",2,0],["حتى يمتِّع باليقين مكذبٌ","عينيه في رؤيا يضلُّ سناهَا",68,"ا",3,0],["حتى يلوح خيالٌ","عرفته في صبايا",69,"ا",3,0],["حَتّى يُقالَ لَقَد أَضحى أَبو دُلَفٍ","وَخَلقُهُ قَد طَغى حُسناً عَلى خُلُقِه",70,"ق",2,0],["حَتّى يَظَلَّ بِماءٍ سافِحٍ وَدَمٍ","في الرَبعِ يُحسَبُ مِن عَينَيهِ قَد رَعَفا",71,"ف",2,0],["حَتّى يُرى مُعتَدِلاً أَ