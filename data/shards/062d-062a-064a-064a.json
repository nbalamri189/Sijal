aldiwan.net/poem31869.html","البسيط"],[410,"ما زلت في غبطة عيشى عالما","https://www.aldiwan.net/poem31880.html","الرجز"],[411,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[417,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[417,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[433,"الله يعلم أنني ما خلته","https://www.aldiwan.net/poem12780.html","الكامل"],[440,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[440,"قد عادت الشمس في أعلى مطالعها","https://www.aldiwan.net/poem34798.html","البسيط"],[440,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[440,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[440,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[440,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[440,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[440,"اليوم أبهجت المنى إبهاجها","https://www.aldiwan.net/poem34909.html","الكامل"],[444,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[454,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[454,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[454,"لا الرمز يغني ولا التصريح يرضيني","https://www.aldiwan.net/poem61353.html","البسيط"],[454,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[454,"ألقاك في وطني الحبيب الأول","https://www.aldiwan.net/poem61630.html","الكامل"],[459,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[459,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[459,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[459,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[459,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[466,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[476,"لا در دري إن أطعمت نازلكم","https://www.aldiwan.net/poem1824.html","البسيط"],[480,"قل هكذا الشعر ترتاح النفوس له","https://www.aldiwan.net/poem37190.html","البسيط"],[501,"يا آخذا وسط الشآم","https://www.aldiwan.net/poem37633.html","مجزوء الكامل"],[501,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[514,"من لي بعطف أخ خلي الإخاء ورا","https://www.aldiwan.net/poem67719.html","البسيط"],[516,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[516,"قل للمكرم إدلالاً وما بحر ال","https://www.aldiwan.net/poem12282.html","البسيط"],[541,"لو هاج صحبك شيئا من رواحلهم","https://www.aldiwan.net/poem56656.html","الخفيف"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[552,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[552,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[554,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[559,"معرفة الله عند عارفه","https://www.aldiwan.net/poem33563.html","المنسرح"],[559,"نهر القضاء بما يختار خالقنا","https://www.aldiwan.net/poem34625.html","البسيط"],[559,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[562,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[562,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[563,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[568,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[568,"ومستدير كجرم البدر مسطوح","https://www.aldiwan.net/poem69754.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"أوحشتموا نظري فكم من عبرة","https://www.aldiwan.net/poem17613.html","الكامل"]],"verses":[["حتى يقولَ لمن قد زَمَّ في خَفَرٍ","خِدرَ الفواطِمِ إجلالًا لما عُهِدا",0,"د",2,0],["حَتّى يَزولَ فَحولُها","مِنكُم وَقَد دانوا وَدَينوا",1,"ن",3,0],["حَتّى يَظُنَّ الصُبحَ سَيفاً مُنتَضىً","أَهوى إِلَيهِ مَعَ الكَمِيِّ المُعلِمِ",2,"م",1,0],["حَتّى يَقولَ الغابِطونَ وَقَد رَأوا","فَعَلاتِهِ زاحِم بِجِدٍّ أَودَعِ",3,"ع",1,0],["حَتّى يَقولَ الساهِرونَ لَوَمضِهِ","نَضَرَ العِراقُ بِقَطرِ هَذا العارِضِ",4,"ض",1,0],["حَتّى يَذوقَ لِحَدِّ أَنصُلِها","طَعناً وَلا طَعنَ القَنا القَصَدِ",5,"د",1,0],["حَتّى يَشُقَّ عَلى العَقيقِ مَزادَهُ","مِن غابِقٍ لِرِياضِهِ أَو صابِحِ",6,"ح",1,0],["حتّى يرُدَّ قِوامَ دولَةِ هاشِمٍ","مَنْ يَرتَجيهِ لِما يَقولُ العاذِلُ",7,"ل",1,0],["حتى يَمُجَّ غِرارُ المَشْرَفيِّ دَماً","والرّمْحُ ما بينَ لَبّاتٍ وأوْداجِ",8,"ج",1,0],["حتى يَرى لَيلَهُ بالصُّبْحِ مُلتَثِماً","وقد قَضى بالكَرى للعاجزِ الفَشَلُ",9,"ل",1,0],["حَتّى يَذوقَ القَومُ طَعمَ الهَوى","فَيَعذِروا في الحُبِّ مَن فَنَّدوا",10,"د",3,0],["حتّى يُهيبَ بأهْلِهِ الوعْدُ الذي","حشَرَ الرّئيسَ إليْهِ والمرؤوسا",11,"س",2,0],["حتّى يُرَى وليمَةً","لٍكُلِّ مرهوبِ التُّغا",12,"غ",2,0],["حتّى يُراعَي وجْهُهُ في وِجْهَتي","بعِنايةٍ تَشْفي الصّدورَ وتَشْرَحُ",13,"ح",1,0],["حَتَّى يَكُونَ اسْمُ السَّعِيدِ مُضَمَّناً","فِي كُلِّ مِنْبَر خُطْبَةِ وَخطَابِ",14,"ب",1,0],["حَتّى يُفيدَكَ مِن بَنيهِ رَهينَةً","نَعشٌ وَيَرهَنَكَ السَماكُ الفَرقَدا",15,"د",2,0],["حَتّى يَقولُ الناسُ مِمّا رَأوا","يا عَجَبا لِلمَيِّتِ الناشِرِ",16,"ر",1,0],["حَتّى يَظَلَّ عَميدُ القَومِ مُتَّكِئاً","يَدفَعُ بِالراحِ عَنهُ نِسوَةٌ عُجُلُ",17,"ل",1,0],["حَتّى يُصَبِّحَ أَقواماً يُحارِبُهُم","أَو يُسلَبوا دونَ صَفِّ القَومِ أَسلابا",18,"ب",2,0],["حَتّى يَؤوبَ بِما يَؤوبُ","كَثيرَ فَضلِ العُرفِ حامِد",19,"د",1,0],["حَتّى يَئِضنَ كَأَمثالِ القَنا ذَبَلَت","مِنها طَرائِقُ لَدناتٌ عَلى أَوَدِ",20,"د",1,0],["حَتّى يَعودَ مِنَ البَلاءِ كَأَنَّهُ","في الكَفِّ أَفوَقُ ناصِلٌ مَعصوبُ",21,"ب",1,0],["حتى يصب لها فضل النطاف إذا","ما كدَّر الماحة الساقون ذا القُلُبِ",22,"ب",1,0],["حتى يقول موَاليه وحاسده","هذا ابن أيوب أم هذا ابن داود",23,"د",1,0],["حتى يغني الرَّجا بشراك يا ظمإي","سعد السعود ومجري الماء في العود",24,"د",1,0],["حتى يقول بغيظه","أوَّاه من عدوانه",25,"ن",2,0],["حتى يعيشَ جَريرٌ","لعيبه أو نُصَيْبُ",26,"ب",1,0],["حتى يُزَيِّنَهَا بزينةِ ماجدٍ","ليست بتطويقٍ ولا توشيحِ",27,"ح",1,0],["حتى يُغَيَّبَ في مُطَمْطَمَةٍ","لا أهلُه فيها ولا ولَدُهْ",28,"د",2,0],["حتى يصدِّقَ من كَنا","ك فوارسٌ لهمُ كريرُ",29,"ر",1,0],["حتى يعود حديثُه","وكأنه عسلٌ مشور",30,"ر",1,0],["حتّى يلاقيني أجفى جُفاتِهمُ","بلا فتورٍ يُرى فيه ولا كسلِ",31,"ل",1,0],["حتى يراه الإلهُ مُعترفاً","بالحقّ يرعى الحقوق والحُرَما",32,"م",2,0],["حتى يقول جليسي","عليَّ أيضاً تُعمِّي",33,"م",2,0],["حتى يرى فيه كل سؤلٍ","ومُنْيةٍ عبدُه بُنان",34,"ن",1,0],["حتى يراني الله كَيْ","ف صيانتي قَدْري وشاني",35,"ن",2,0],["حَتّى يَظَلَّ لَهُ مِنهُنَّ واعِيَةٌ","مُستَوهِلٌ عامِلُ التَقزيعِ وَالصَخَبِ",36,"ب",1,0],["حَتّى يَرى التيهَ عَلى المُلوكِ","وَلا يُبالي سَطَوَةَ الأَميرِ",37,"ر",1,0],["حَتّى يَمُرَّ الفاتِحونَ فَإِنَّهُم","كَشَوا الأَذى عَنكُنَّ وَالإِذلالا",38,"ل",2,0],["حَتّى يَبينَ لِناظِري","مَن مِنهُما زاهٍ وَزاهِر",39,"ر",1,0],["حتَّى يُواريها ضَبابُ الموتِ","في وادي الدُّثورْ",40,"ر",1,0],["حَتّى يَصيدَ بِسَعدِكَ الأَبطالُ في","يَومِ الوَغى بِأَسِنَّةٍ وَقَواضِبِ",41,"ب",1,0],["حَتّى يَجودَكَ دَمعُ الطَلّ مُنهَمِراً","مِن أَعيُن الزَهرِ لم تَبخَل بِإِسعادِ",42,"د",1,0],["حَتّى يَراكَ الجَمعُ أَوَّلَ طالِعٍ","وَيَرَوا عَلى أَعرافِكَ المِنديلا",43,"ل",2,0],["حتى يقولَ جميعُ الخالدينَ بها","يا ليتَ أنّا معاً كُنّا مُحِبِّينا",44,"ن",2,0],["حَتّى يُشارَ إِلَيكَ ذا مَولاهُمُ","وَهُمُ المَوالي وَالخَليقَةُ أَعبُدُ",45,"د",1,0],["حَتّى يَقولَ الناسَ ماذا عاقِلاً","وَيَقولَ بَيتُ المالِ ماذا مُسلِما",46,"م",2,0],["حتى يصيرا زعفراناً عرقا","وقبل ذاك قد عقدت زئبقا",47,"ق",2,0],["حَتّى يَتِمَّ لَكَ الثَناءُ مُخَلَّداً","أَبَداً كَما تَمَّت لِيَ النَعماءُ",48,"ا",2,0],["حَتّى يَروحَ مُتارِكاً كَمُعارِكٍ","بِجَميعِهِ وَمُسالِماً كَمُحارِبِ",49,"ب",1,0],["حَتّى يَعودَ الجَديدَ المُشتَرى خَلَقاً","تَرذُلُهُ العَينُ وَالمُنصاتُ مُنآدا",50,"د",2,0],["حَتّى يَكادَ يُرينا ضَوءُ عارِضِهِ","مِنَ العِراقِ مُحِلّاً بِالسَواجيرِ",51,"ر",1,0],["حَتّى يَراهُ لِغَيظِهِ مُتَجَرِّعاً","يَحبوهُ في يُسرٍ وَفي إِفلاسِ",52,"س",1,0],["حَتّى يَعودَ الذِئبُ لَيثاً ضَيغَماً","وَالغُصنُ ساقاً وَالأَرارَةُ نيقا",53,"ق",2,0],["حَتّى يَرى رَتبيلُ مِنها غارَةً","شَعواءَ غَيرَ تَرَجُّمِ الأَخبارِ",54,"ر",1,0],["حَتّى يَرِعنَ وَهُنَّ حَولَ مُعَمَّمٍ","بِالتاجِ في حَلَقِ المُلوكِ نِضارِ",55,"ر",1,0],["حَتّى يُداوِيَ أَهلُهُ مَأمومَةً","في الرَأسِ تُدبِرُ مَرَّةً وَتَثورُ",56,"ر",1,0],["حَتّى يُرى وَهوَ مَحزومٌ كَأَنَّ بِهِ","حُمّى المَدينَةِ أَو داءَن مِنَ المومِ",57,"م",1,0],["حَتّى يَبيتَ عَلَيهِم حَيزُ أَدرَكَهُم","مِنّا جَوادِعُ قَد أُلحِقنَ بِالسُنَنِ",58,"ن",1,0],["حتى يعودَ ثَراكَ غَضْ","ضَ العُودِ مُخضَرَّ الَملابِس",59,"س",1,0],["حتى يُشِيبَ منهمُ الأَشفارا","فلم نَزَلْ نأخُذُها نَهارا",60,"ر",2,0],["حتى يُبَدِّلَ للعُشَّاقِ زورَتَه","طَيفٌ يَصُدُّ عن العُشَّاقِ صاحبُه",61,"ب",2,0],["حتى يعودَ الشَرْقَ لابسَ حُلَّةٍ","من أرجوانِ الفَجرِ أو زِريابِه",62,"ب",2,0],["حَتّى يَأُوبَ بِها عوجاً مُعَطَّلَةً","تَشكو الدَوابِرَ وَالأَنساءَ وَالصُفُقا",63,"ق",2,0],["حَتّى يُفَرِّجُها في حالِ مُدَّتِها","فَقَد يَزيدُ اِختِناقاً كُلُّ مُضطَرِبِ",64,"ب",1,0],["حَتّى يُرينا أَدهَمَ اللَي","لِ شَبيهَ الأَبلَقِ",65,"ق",1,0],["حَتّى يَرى الجُبَناءُ عَن حَملِ الهَوى","غاياتِ عِزِّهُمُ الَّتي لَم تُلحَقِ",66,"ق",1,0],["حَتّى يَكادُ لِسانُ الصُبحِ يُفشينا","لِلَّهِ كَم قَد قَضَينا مِنكُمُ وَطَراً",67,"ر",2,0],["حَتّى يَقولَ كُلُّ رَبِّ رُتبَةٍ","قَد رَجَعَ الحَقُّ إِلى نِصابِهِ",68,"ب",2,0],["حتى يمتِّع باليقين مكذبٌ","عينيه في رؤيا يضلُّ سناهَا",69,"ا",3,0],["حتى يلوح خيالٌ","عرفته في صبايا",70,"ا",3,0],["حَتّى يُقالَ لَقَد أَضحى أَبو دُلَفٍ","وَخَلقُهُ قَد طَغى حُسناً عَلى خُلُقِه",71,"ق",2,0],["حَتّى يَظَلَّ بِماءٍ سافِحٍ وَدَمٍ","في الرَبعِ يُحسَبُ مِن عَينَيهِ قَد رَعَفا",72,"ف",2,0],["حَتّى يُرى مُعتَدِلاً أَمرُهُ","بَعدَ اِلتِياثِ الأَمَلِ الظالِعِ",73,"ع",1,0],["حَتّى يَؤوبَ الحَقُّ وَهُوَ المُشتَفي","مِنكُم وَما لِلدينِ فيكُم ثارُ",74,"ر",1,0],["حَتّى يَحُلَّ مِنَ المُهَلَّبِ مَنزِلاً","لِلمَجدِ في غُرُفاتِهِ تَشييدُ",75,"د",1,0],["حَتّى يُعايِنَها مُعايَنَةً","غَزِلاً وَحَقَّ لِقَسِّهِم غَزَلُه",76,"ل",2,0],["حَتّى يَرى أَنَّ ما قالَ الوُشاةُ لَهُ","فينا لَدَيهِ إِلَينا كُلَّهُ نُقِلا",77,"ل",2,0],["حَتّى يَذوقَ كَما ذُقنا فَيَمنَعَهُ","مِمّا يَلَذُّ حَديثُ النَفسِ وَالسَهَرُ",78,"ر",1,0],["حَتّى يُخَيَّلَ أَنّي شارِبٌ ثَمِلٌ","بَينَ الرِياضِ وَبَينَ الكَأسِ وَالوَتَرِ",79,"ر",1,0],["حَتّى يُجازِيَ أَقواماً بِسَعيِهِمِ","مِن آلِ لَأيٍ وَكانوا سادَةً نُجُبا",80,"ب",2,0],["حَتّى يَجيءَ إِلَيكَ عِلجٌ نازِحٌ","فَيُصيبَ عَفوَتَها وَعَبدٌ أَوكَعُ",81,"ع",1,0],["حَتّى يُفارِقَ هامُهُم أَجسامَهُم","ضَرباً يُفَجِّرُ مِن دَمٍ يَنبوعا",82,"ع",2,0],["حتّى يقولَ النّاسُ أَتْعَبَ مالِكاً","بِحُسامِهِ وأَراحَ عِزرِيلا",83,"ل",2,0],["حَتّى يُقالَ فَكَم إِذَن","ماذا هَوى هَذا جُنونُ",84,"ن",1,0],["حتى يميّزَ في المجالس بيننا","ويُقاسَ بين هجائهِ وهجائيه",85,"ي",2,0],["حَتّى يُدانى الخَمرُ وَالخَميرُ","وَاِنشَقَّ عَنّي بابُها المَسمورُ",86,"ر",1,0],["حَتّى يَقولُ الناسُ بَينَهُمُ","شَغَفُ المُرَعَّثِ داخِلُ الحُبِّ",87,"ب",1,0],["حَتّى يُبيدَ عَلى عَمدٍ سَراتَهُمُ","بِالنافِذاتِ مِنَ النَبلِ المَصايِيبِ",88,"ب",1,0],["حَتّى يَلُفَّ نَخيلَهُم وَزُروعَهُم","لَهَبٌ كَناصِيَةِ الحِصانِ الأَشقَرِ",89,"ر",1,0],["حَتّى يُقالَ لِمَن تَعَرَّقَ دَهرَهُ","يا ذا الزَمانَةِ هَل رَأَيتَ عَبيدا",90,"د",2,0],["حتى يعودَ بنا قَعرِ مُظلمةٍ","لحْدٌ ويُلبسَنا في واحدٍ كَفَنا",91,"ن",2,0],["حتى يقول قائل","تبت يدا ابي لهب",92,"ب",1,0],["حتى يبدل من خصومته رضىً","ومن القساوة رأفةً وحنانا",93,"ن",2,0],["حتى يوالي غيره في أَرضه","حتى يرى كل الورى إخوانا",93,"ن",2,0],["حتى يَكون ال