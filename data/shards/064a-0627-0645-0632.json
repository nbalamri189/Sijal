{"poems":[[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[93,"يا مزهراً صيغ من جذوع","https://www.aldiwan.net/poem11160.html","مخلع البسيط"],[83,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"يا موعدا منها ترقبته","https://www.aldiwan.net/poem63581.html","الخفيف"],[33,"يا موقد النار يذكيها ويخمدها","https://www.aldiwan.net/poem25916.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85534","البسيط"],[262,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[299,"يا مزمع السير بلغت المنى مهلا","https://www.aldiwan.net/poem36282.html","عموديه"],[329,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[398,"يا مزهرا صيغ من جذوع","https://www.aldiwan.net/poem11035.html","عموديه"]],"verses":[["يا مُزْمِعاً عنّا العَشيَّ رِكابَهُ","هَلاّ لبِثْتَ ولوْ بقَدْرِ فُواقِ",0,"ق",1,0],["يَا مَزْهَراً صِيغَ مِنْ جُذًُوعٍ","رَقَّتْ وَضُمَّتْ ضَمَّ الصَّوَانِ",1,"ن",1,1],["يا مُزْجيَ البُدن القلاص خوافقاً","رفقاً بها فالسعيُ في إخفاقِ",2,"ق",1,0],["يا مُزيلَ الظَلامِ عَنّي وَرَوضي","يَومَ شُربي وَمَعقِلي في البَرازِ",3,"ز",1,0],["يا مُزنَةً يَحتَثُّها بارِقٌ","وَرَوضَةً أَنوارُها تَزهَرُ",4,"ر",1,0],["يا مُزمِعَ البَينِ إِن جَدَّ الرَحيلُ فَلا","كانَ الرَحيلُ فَإِنّي غَيرُ صَبّارِ",5,"ر",1,0],["يا مزهق الروح إرضاءً لشهوته","هدمت مِمّا بناه اللَه أَركانا",6,"ن",2,0],["يا مزجي العيس من جرعاء كاظمة","عرج على منحني واديهم وعج",7,"ج",1,0],["\"يا مزمعَ السَّيرِ بُلِّغْتَ المنى؛ مهلاً\"","يؤَدِّ حَقّاً من التَّوديعِ قَلبانِ",8,"ن",1,1],["يا مزهرا للفن كا","نَ صَداهُ مشبوب النواح",9,"ح",1,0],["يا مزهرا صيغ من جذوع","رقت وضمن ضم الصوان",10,"ن",1,1]]}