يف"],[4728,"ابتهالات لله","https://www.poetsgate.com/ViewPoem.aspx?id=176966",""],[4771,"يا مُزْمعاً عَن مُلْكه وسريره","https://www.poetsgate.com/ViewPoem.aspx?id=106588",""],[4797,"الأمير سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=132241",""],[4830,"قولوا لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=211228",""],[4869,"ماعاد ادوّر صداقه","https://www.poetsgate.com/ViewPoem.aspx?id=151575",""],[4929,"المفهوم الحقيقي للعيد","https://www.poetsgate.com/ViewPoem.aspx?id=204784",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5539,"مزون السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=194074",""],[5573,"عديت لك سبعين بارق وشديت","https://www.poetsgate.com/ViewPoem.aspx?id=205474",""],[5587,"قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=188350",""],[5694,"أغنى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=132103",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5943,"مزنة من ترياق","https://www.poetsgate.com/ViewPoem.aspx?id=41605",""],[5956,"أرجوك يا أرتين تحقيق المنى","https://www.poetsgate.com/ViewPoem.aspx?id=202208",""],[6038,"كويتيه","https://www.poetsgate.com/ViewPoem.aspx?id=25685",""],[6038,"يا موزع الرنات","https://www.poetsgate.com/ViewPoem.aspx?id=25687",""]],"verses":[["يا مُزْمِعاً عنّا العَشيَّ رِكابَهُ","هَلاّ لبِثْتَ ولوْ بقَدْرِ فُواقِ",0,"ق",1,0],["يَا مَزْهَراً صِيغَ مِنْ جُذًُوعٍ","رَقَّتْ وَضُمَّتْ ضَمَّ الصَّوَانِ",1,"ن",1,1],["يا مُزْجيَ البُدن القلاص خوافقاً","رفقاً بها فالسعيُ في إخفاقِ",2,"ق",1,0],["يا مُزيلَ الظَلامِ عَنّي وَرَوضي","يَومَ شُربي وَمَعقِلي في البَرازِ",3,"ز",1,0],["يا مُزنَةً يَحتَثُّها بارِقٌ","وَرَوضَةً أَنوارُها تَزهَرُ",4,"ر",1,0],["يا مُزمِعَ البَينِ إِن جَدَّ الرَحيلُ فَلا","كانَ الرَحيلُ فَإِنّي غَيرُ صَبّارِ",5,"ر",1,0],["يا مزهق الروح إرضاءً لشهوته","هدمت مِمّا بناه اللَه أَركانا",6,"ن",2,0],["يا مزجي العيس من جرعاء كاظمة","عرج على منحني واديهم وعج",7,"ج",1,0],["\"يا مزمعَ السَّيرِ بُلِّغْتَ المنى؛ مهلاً\"","يؤَدِّ حَقّاً من التَّوديعِ قَلبانِ",8,"ن",1,1],["يا مزهرا للفن كا","نَ صَداهُ مشبوب النواح",9,"ح",1,0],["يا مزهرا صيغ من جذوع","رقت وضمن ضم الصوان",10,"ن",1,1],["يا مزموم النهايد","لا والذي سوّاك",11,"ك",1,1],["يا مزنة التأميل يوم الندى","للوفد بل يا قمر النادي",12,"د",2,0],["يا مزمع الهجران عمداً والقلى","ما كان ما زعم العذول كما زعم",13,"م",1,0],["يا مزنة الجود الذيب سيفه","على العدا صاعقة تلهبُ",14,"ب",1,0],["يا مزنة الغيث صفي","دمع المعنى الكلف",15,"ف",1,1],["يا مزنة نعم الزمانُ على الورى","درَّت وَما سَمِعت له بساسا",16,"س",2,0],["يا مزمع البين في ترحالك الأَجل","وَأَنتَ لاه بِحُب البين مُشتَغل",17,"ل",1,1],["يا مُزنةَ الصَّيف من دَرّ الحيا صُوبي","بواكفِ القطْرِ مُنْهلّ الشَّآبيبِ",18,"ب",1,1],["يا مُزنَةَ الحَيِّ يَحدُو عِيسَها الحادي","هَلّا شَفَيتِ بِرِيٍّ غُلَّةَ الصادي",19,"د",2,1],["يا مُزَنِيَّ النجار يا مازن","يّ الجار إن لم يوجد له وَزَر",20,"ر",1,0],["يا مزريا بالببغاء فصاحة","أنا ذا مطوقك الصدوح الزاقي",21,"ق",2,0],["يا مزجر النضو فيه قاطعا شققاً","لم يحتفل بعياف الطير أن زجرا",22,"ر",2,0],["يا مُزْنَة ما تَغِبّ نافعة","والمزن في طول صوبه ضرر",23,"ر",1,0],["يا مزعجي أسد الشرى ما قعودكم","وقد ظفرت من ليثكم ظفر الكلب",24,"ب",1,0],["يا مُزدَهَينَ بحُسِنهم وجُسومِهِم","الحُسنُ ظِلٌّ والجُسومُ تُرابُ",25,"ب",1,1],["يا مزيدي اجتلاء غادات غيب","صانها الله في الخدود الجميله",26,"ه",1,1],["يا مزوّد المسلم بزادٍ من تقى عن كل زاد","ويْعوذ بك ممن وقب ويْعوذ بك ممن حسد",27,"د",1,0],["يا مُزْمعاً عَن مُلْكه وسريره","ماذا أضرَّكَ لو لبثْتَ قليلا؟",28,"ل",2,1],["يامزبن الخايف سلاليل قهيدان","اللي عدوه في الملاقى يسمه",29,"م",2,0],["يامُزهِرَ الخدَّينِ نأيُكَ قاتلي","بينَ الجوانحِ قد تلاطَمَ واصطفَقْ",30,"ق",1,0],["يامزورين الضحك بين الصداقه","ماني مضيع بينكم من صديقي",31,"ق",2,0],["يا مُزدَهٍ بقَشيبِ اللِّبسِ في بطرٍ","والخير ُ من كفه ينبوعُهِ نضَبا",32,"ب",2,0],["يا مزجي زيافة تنشر البيد","بأخفافها وتطوي الأديما",33,"م",2,0],["يامزون السحايب لك بقلبي مكان","مثل منزال ضبي في ربيع جميل",34,"ل",1,1],["يامزنة الغيث المسمى لك ابديت","مافي خفوقي يشتكي من صوابه",35,"ب",2,0],["يامزنة القطر المدي عينك ابكيت","لو تحملين الود للي شقابه",35,"ب",2,0],["يَا مُزِيلَ الهُمُومِ عَنِّي وَ إِلْفِي","نَاطِقٌ كَالحَمَامِ لَحْنَا أَصِيلَا",36,"ل",2,0],["يامزنة هلت مدامعها بلابرق ورعد","واعشوشبت منها الفياض ولبست ألوان الزهور",37,"ر",1,1],["يامزار أهل الرجوله والحسب","ياعرين الليوث الضاريات",38,"ت",1,0],["يامزنةَ الشعرِ قدْ اغدقتِ ترياقي","وأطفأَ الغيثُ منكِ نارَ إحراقي",39,"ق",2,1],["يا مزجَ سوريَّا بإيرانَ التي","جعلتك معجزة الوسامة والغنا",40,"ن",2,0],["يا مزين البرقع قلبي خذيته","وكل نبضاته تنادي ابيك",41,"ك",1,0],["يا مزين الدار ومنور البيت","وزيادة في دلالك ضحكة رهيبه",42,"ب",2,0]]}