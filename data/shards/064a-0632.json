ك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[45,"أدْمُعٌ قَدْ غُرِينَ بالهَمَلانِ","https://www.poetsgate.com/ViewPoem.aspx?id=31784",""],[80,"هل كان أودعَ سرَّ قلب محجراً","https://www.poetsgate.com/ViewPoem.aspx?id=3244",""],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[28,"ألم يك جهلا بعد سبعين حجة","https://www.poetsgate.com/ViewPoem.aspx?id=21316",""],[28,"يا عجبا للعذارى يوم معقلة","https://www.poetsgate.com/ViewPoem.aspx?id=21598",""],[88,"أطلَّ صباح العيد في الشرق يسمع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19511&r=&rc=14",""]],"verses":[["يَزيدُ لَها بِالخِمسِ بَينَ ضُلوعِها","تَنَسُّمُ ريحِ الشيحِ وَالعَلَجانِ",0,"ن",1,0],["يَزيدُ بِهِ وَجهي ضِياءً وَبَهجَةً","وَما تُنقَصُ الظَلماءِ مِن بَهجَةِ النَجمِ",1,"م",1,0],["يَزِمُّ إِلى العافينَ أَعناقَ مالِهِ","وَمالُ رِجالٍ مُقرَمٌ لَم يُخَطَّمِ",2,"م",1,0],["يَزُرُّ السَماحَ عَلَيهِ الشُفوفَ","وَيُلبِسُهُ العِزَّ بيضاً وَلاما",3,"م",2,0],["يُزَعفَرُ مِن عَضَّ الشَكيمِ لُعابُها","وَيُرعَدُ مِن قَرعِ العَوالي خَصيلُها",4,"ل",3,0],["يُزَمجِرُ مِن وَقعِ الصَفيحِ عَلى الطُلى","وَيُرعِدُ مِن وَقعِ القَنا بِالحَوارِكِ",5,"ك",1,0],["يُزايِلُ اللَيلَ عَلى رَحلِهِ","وَيُؤثِرُ القَومَ بِطُعمِ الخُفوق",6,"ق",1,0],["يَزورُكَ بَينَ قُلوبِ العُداةِ","فَيَقطَعُها في اِتِّصالِ المَزارِ",7,"ر",1,0],["يَزيدُ عَلى مُشتَهى الجودِ جوداً","وَيَبني عَلى غايَةِ المَجدِ مَجدا",8,"د",2,0],["يَزيدُ عَلى لُؤْمِ الزَّمانِ تَكَرُّماً","وَيَرْنو إِليهِ عابِساً وَهْوَ يَبْسِمُ",9,"م",1,0],["يُزيرونَ أَطْرافَ القَنا ثُغَرَ العِدا","وَقَد أَقْعَتِ الجُرْدُ المَذاكِي على قُتْرِ",10,"ر",1,0],["يُزْهَى بهِ الخِلَعُ المَيْمونُ طائِرُها","زَهْوَ الخَرائِدِ بالمكْحولَةِ النُّجُلِ",11,"ل",1,0],["يَزورُ الوَغى في غِلْمَةٍ منْ هَوازِنٍ","رِقاقِ حَواشي الأوْجُهِ الغُرِّ شُرَّخِ",12,"خ",1,0],["يُزْهى بها الدّهْرُ والأيّامُ مُشْرِقَةٌ","تهُزُّ في ظِلِّهِ أعْطافَها تيها",13,"ي",3,0],["يُزيرُها عِصمَةُ الدِّينِ الطُّلَى فَبِها","يُقامُ ما مَسَّ لِيتَ القِرْنِ منْ مَيَلِ",14,"ل",1,0],["يَزيدُكَ وَجهُها حُسناً","إِذا ما زِدتَهُ نَظَرا",15,"ر",2,0],["يَزيدُ سَفاهَةً فَأَزيدُ حِلماً","كَعودٍ زادَهُ الإِحراقُ طيبا",16,"ب",2,0],["يَزَعُ الإلاَهُ مِنَ النَّفُوسِ مَنِ ارْتَضَى","حَتَّى يَبِينَ مُحِقُّهَا وَالْمُبْطِلُ",17,"ل",1,0],["يُزرُّ علَيْها هوْدَجُ المُلْكِ هالَةً","يَدورُ علَيْها كُلُّ غَفْرٍ وفَرْقَدِ",18,"د",1,0],["يُزْجِي منَ النّقْعِ المُثارِ سَحائِاً","رَكِبَتْ منَ العَزْمِ الشّديدِ رِياحا",19,"ح",2,0],["يُزجي عَقارِبَ قَولِهِ","لَمّا رَأى أَنّي أَهابُه",20,"ب",2,0],["يَزِلُّ عَن جَبهَتِهِ الأَمشاطُ","لَقَد مُنوا بِتَيِّحانٍ ساطي",21,"ط",2,0],["يَزيدُ يَغُضُّ الطَرفَ دوني كَأَنَّما","زَوى بَينَ عَينَيهِ عَلَيَّ المَحاجِمُ",22,"م",1,0],["يَزُرُّ وَيَلفِظُ أَوبارَها","وَيَقرو بِهِنَّ حُزوناً حُزونا",23,"ن",2,0],["يَزِنُ الأُمورَ كَأَنَّما هُوَ صَيرَفٌ","يَزِنُ النُضارَ بِدِقَّةٍ وَحِسابِ",24,"ب",1,0],["يَزينُ تَواضُعُهُ نَفسَهُ","كَما زانَ حُسنَ المِلاحِ الخَفَر",25,"ر",1,0],["يُزهى مُدَجَّجُنا بِرُمحٍ واحِدٍ","وَأَراهُما لا يُزهَيانِ بِغابِ",26,"ب",1,0],["يَزعُمُ التيسُ أَنَّني خالُهُ الأَد","نى تَناهى في السَبِّ لي وَالإِهانَه",27,"ن",2,0],["يَزُفُّ عَروسَ اللَهوِ أَحوَرُ أَغيَدُ","لَهُ مَبسِمٌ عَذبٌ وَخَدٌّ مُوَرَّدُ",28,"د",1,0],["يَزيدُ يُقَدِّمُ الشَقَراءَ حَتّى","يُرَوّي صَدرَها الأَسَلَ النِهالا",29,"ل",2,0],["يُزَجِّينَها مَشيَ النَزيفِ وَقَد جَرى","صُبابُ الكَرى في مُخِّها فَتَقَطَّعا",30,"ع",2,0],["يَزُرنَ عَلى تَنائيهِ يَزيداً","بِأَكنافِ المُوَقَّرِ وَالرَقيمِ",31,"م",1,0],["يَزُرنَ أَميرَ المُؤمِنينَ وَعِندَهُ","لِذي المَدحِ شُكرٌ وَالصَنيعَة مَحمِلُ",32,"ل",1,0],["يزيد مياه البحر سائل دمعه","ولا يدرك الشيء الذي هو سائله",33,"ل",2,0],["يَزْدَحِمُ الفِتْيَانُ فِي بَابِهَا","وَتَتْبَعُ الْقَافِلَةُ الَقَافِلَهْ",34,"ل",2,0],["يَزِينُ سِوَاهُ تَحْجِيلٌ يَسِيرٌ","وَحُجِّلَ كَلُّهُ حَتَّى الُوَتِينيِ",35,"ي",1,0],["يَزِيدُهَا فِي طَرِيقِ المَجْدِ مَا أَخَذَتْ","عَنْ مَحْتِدٍ بِقَدِيمِ المَجْدِ مِزْدَانِ",36,"ن",1,0],["يَزْدَادُ لُطْفاً مَا عَلا قَدْرُهُ","وَهَكَذَا شَأْنُ الرِّجَالِ العِظَامْ",37,"م",1,0],["يَزيدُ التَنائي وَصلَ خَرقاءَ جِدَّةً","إِذا خانَ أَرماثَ الحِبالِ وُصولُها",38,"ل",3,0],["يَزيدُ بنُ شَدّادِ بنِ صَخرِ بنِ مَالِكٍ","وَذَلِكَ عَمّي العُدمُلِيُّ المُشَهَّرُ",39,"ر",1,0],["يزيد حسناً على نهر المجرّة قد","أغناه دُرُّ حَبابٍ عن دراريها",40,"ي",3,0],["يُزار به البيتُ العتيقُ وزمزمٌ","ويعرفّه حتى الصّفا والمُعَرَفُ",41,"ف",1,0],["يزور هبوبُ الريح إلاّ فناءها","فلم تَحْظَ من وصل النسيم بمَوْعد",42,"د",1,0],["يزهو محّياه الوضيء كأنه","قمر يشع إليك بالأنوار",43,"ر",1,0],["يُزَيِّنُ أَيّامَ اِبنِ أَروى فَعالُهُ","وَعادِيُّ مَجدٍ في أَشَمِّ رَفيعِ",44,"ع",1,1],["يُزجونَ نَحوَكَ أَطلاحاً مُخَدَّمَةً","قَد مَسَّها النَكبُ وَالأَنقابُ وَالعَجَفُ",45,"ف",1,0],["يَزيفُ وَيَستَطيرُ البَرقُ فيهِ","كَما حَرَّقتَ في الأَجَمِ الضِراما",46,"م",2,0],["يَزدادُ قُرباً مِنهُمُ أَن يوعَدا","أَورَثتَنا تُراثَ غَيرِ أَنكَدا",47,"د",2,0],["يَزَعُ الهَيامُ عَنِ الثَرى وَيَمُدُّهُ","بُطحٌ تَهايُلُهُ عَلى الكُثبانِ",48,"ن",1,0],["يزيدهم عَجْم الكرابة نجدة","وعزَّاً إذا العيدانُ خان صليبُها",49,"ب",3,0],["يَزُفّونَ حَولَ الهاشِمِيَ نَبِيِّهِم","عَلى وَجهِهِ نورٌ مِنَ اللَهِ يُزهِرُ",50,"ر",1,0],["يزاحمُون بأشعارٍ ملفَّقةٍ","كأنَّها بين أهلِ الشعرِ حشوات",51,"ت",1,0],["يزيدني العذل تبريحاً ألذّ به","فليت عذَّال حبِّي فيكَ ما برحت",52,"ت",1,0],["يزدادُ معنًى بيته حسناً به","فكأنه بيتُ القريضِ مولدا",53,"د",2,0],["يزولُ وما زالتْ مذاقته الصبى","ويبلى وما تبلى روائحه البُردُ",54,"د",1,0],["يزدحم اللثم على كفِّه","تزاحم البهم على المكرع",55,"ع",1,0],["يزور الوصل عن لمياء تحكم لا","حكم الأذلَّة لكن حكم إدلال",56,"ل",1,0],["يزجي سحائبه بنان مؤمَّل","في الخافقين نوافح من سجله",57,"ل",2,0],["يزيد اتّضاعاً كلّما زادَ رفعةً","وكم صاعدٍ أخنى عليه اخْتياله",58,"ل",2,0],["يزهو الشآم بمن فارقت طلعته","وا حرّ قلباه ممن قلبه شبم",59,"م",1,0],["يزيد لفظي بهجةً ورونقاً","كأنه الخمرة إذ تُعتقا",60,"ق",2,0],["يزيدُ اللَّه فيها كلَّ يومٍ","فلا تنفكُّ دائمةَ النَّماءِ",61,"ا",2,0],["يَزينُها بإشاراتٍ ملحَّنةٍ","كأنها نغمُ التأليف ذي النِّسَبِ",62,"ب",1,0],["يَزِينُ ويَحْمِي وَهْوَ في السِّلْم زينةٌ","لمن يَرْتَدِيه وهو في الحرب مِزودُ",63,"د",1,0],["يُزايد نفْسَه في الرفد حتى","يطولَ المطلُ من طول الزيادِ",64,"د",1,0],["يُزلّون عن أكباد كل حَنِيّة","خِفافاً مع الآجال تعلو وتقصر",65,"ر",1,0],["يُزري علينا به قوم فيجشِمنا","تمويهُ عذر وبعض العذر معتسَر",66,"ر",1,0],["يزداد في القول إنجازاً ومَشربُهُ","محضُ العذوبة لم يَمْلَح لإبحار",67,"ر",1,0],["يزري على الشعر أقوامٌ بحاكته","وما عليه إذا أُلبستَهُ زاري",67,"ر",2,0],["يزعمها بنتَهُ وأُقسم لل","شوكيُّ أولى بها من البشر",68,"ر",1,0],["يَزوَرُّ كبراً وما أضعاف قيمته","من الخساسة عند الله ثفروق",69,"ق",1,0],["يزداد ضيقاً على المراس كما","تزداد ضيقاً أنشوطة الوَهق",70,"ق",1,0],["يُزنّجُ منها الناسبون وشيظةً","وجمهورها في الناسبين مُرَوَّمُ",71,"م",1,0],["يزيدُك كلَّما أغليتَ حمداً","به رِبحاً وفيه لك انهضامُ",72,"م",1,0],["يُزْهَى به الإسلامُ في عِيديهِ","لَبَّيهِ مقرونٌ إلى سَعْدَيهِ",73,"د",3,0],["يُزَجّونَ الحَميرَ بِأَرضِ نَجدٍ","وَما لَهُمُ مِنَ الأَمرِ الخِيارُ",74,"ر",1,0],["يَزيدُ اللَيلُ كُربَتَهُ اِشتِداداً","وَفَرطُ الهَمِّ لَيلَتَهُ سَوادا",75,"د",2,0],["يَزيدُ وَحشَتَهُ إِعراضُ عُوَّدِهِ","وَيَنكَءُ الجُرحَ في أَحشائِهِ العَذَلُ",76,"ل",1,0],["يَزرَعُ حَولي زَهَراتِ المُنى","وَشَوكُها في قَلبِيَ الدامي",77,"ي",1,0],["يَزدادُ شِعرِيَ حُسناً حينَ أَذكُرُكُم","إِنَّ المَليحَةَ فيها يَحسُنُ الغَزَلُ",78,"ل",1,0],["يُزيلُ بِهِ اللَأواءَ جودُكَ لا الحَيا","وَيَجلو بِهِ الظَلماءَ وَجهُكَ لا البَدرُ",79,"ر",1,0],["يُزيلُ بَناتِ الهامِ عَن سَكَناتِها","وَما يَلقَهُ مِن ساعِدٍ فَهوَ طائِحُ",80,"ح",1,0],["يَزُرُّ أَكفالَها غَيرانُ مُبتَرِكٌ","كَاللَوحِ جُرِّدَ دَفّاهُ مِنَ الزُبُرِ",81,"ر",1,0],["يُزَعزِعُ فيها الريحُ كُلَّ عَشِيَّةٍ","هَزيمٌ بِسُلّافِ الرِياحِ رَجيعُ",82,"ع",1,0],["يزداد كونك من اطرافه سعة","في فهمها العقل كل العقل حيران",83,"ن",1,1],["يزول الفتى وشعور الفتى","ويبقى هنالك مالا يزول",84,"ل",1,0],["يزري على الباكين في بؤسهم","دموعهم من ليس بالثاكل",85,"ل",1,0],["يزور غمار الحادثات بكله","فيخرج من كرب ويدخل في كرب",86,"ب",1,0],["يزيد هلالهَ حسنا وحسنى","هلالُ من محّياك الوسيم",87,"م",1,0],["يزهو على ورقِ الغصون نثيرها