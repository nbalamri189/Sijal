{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[111,"الله أكبر فاز المجد واغتبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66838&r=&rc=17",""],[445,"فداؤك من لو كان في وسعه الفدا","https://www.aldiwan.net/poem34785.html","الطويل"],[482,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[566,"قلت لعنس قد ونت طليح","https://www.aldiwan.net/poem27836.html","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113939","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[4981,"عاش الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=192011",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""]],"verses":[["مرزَّأَة وأخرى ذات نوح","وأخرى ما لأعينها جمود",0,"د",1,0],["مرزء الأرض خلاها وحل بها","لك السلامة لم تحلل ولم تحل",1,"ل",1,0],["مرزء وسع الدنيا بما حملت","عدلا وعلما وحلما وافرا وعطا",2,"ط",2,0],["مُرَزَّأَ أفلاذِ الفؤادِ مصائِباً","توالت بِهَا الأيامُ مَثَنىً ومَوحَدَا",3,"د",2,0],["مرزءٍ ذاقَ طعمَ الثُّكلِ منذَهِلٍ","مثلي تجرَّعَ منه الصَّابَ والسَّلعا",4,"ع",2,0],["مُرَزَّأٍ بِسَيبِهِ نَفوحِ","في البَدوِ ذُو بَدوٍ وَذو مَمنوحِ",5,"ح",1,0],["مُرَزَّأ أريحِيّاً ماجِداً أربا","ليثاً هزَبراً بنَصرِ اللَهِ موعودا",6,"د",2,0],["مُرزِماتٍ يَحنِنَّ وَالرَكبُ باكو","نَ فَهُم في الهَوى وَهُنَّ سَواءُ",7,"ا",2,0],["مرزوقُ شكراً قد نصرتَ قضيّتي","وجعلتَ خصمي مُلْجَمَاً مُستاءَا",8,"ا",3,0],["مرزّأة اطلّ الحسن منها","فحصّنها الوقار بمئزرينِ",9,"ن",1,0]]}