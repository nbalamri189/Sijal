{"poems":[[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144596","الكامل"],[4718,"هذا رسولٍ للهدى كله انوار","https://www.poetsgate.com/ViewPoem.aspx?id=137566",""],[4869,"حبك الهندي","https://www.poetsgate.com/ViewPoem.aspx?id=151513",""],[4869,"عاشق الريم","https://www.poetsgate.com/ViewPoem.aspx?id=151535",""],[4869,"الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151652",""],[4902,"جتني","https://www.poetsgate.com/ViewPoem.aspx?id=5043",""],[4924,"منت رايق","https://www.poetsgate.com/ViewPoem.aspx?id=24470",""],[4987,"ضايق البال","https://www.poetsgate.com/ViewPoem.aspx?id=49565",""],[5039,"اخر السهره","https://www.poetsgate.com/ViewPoem.aspx?id=48110",""],[5122,"الدرة اللي تلبس اللماسي","https://www.poetsgate.com/ViewPoem.aspx?id=27279",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[5225,"صدفه","https://www.poetsgate.com/ViewPoem.aspx?id=27447",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5344,"وينك يا معذرب قصتهم .. (هجينية)","https://www.poetsgate.com/ViewPoem.aspx?id=180712",""],[5433,"وردتين حمر","https://www.poetsgate.com/ViewPoem.aspx?id=36235",""],[5461,"غرتني الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=22528",""],[5526,"لا تامن سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=194420",""],[5573,"الاماني والامل","https://www.poetsgate.com/ViewPoem.aspx?id=200216",""],[5573,"نيات قلبك يالوفي مخشوشه","https://www.poetsgate.com/ViewPoem.aspx?id=204548",""],[5606,"إن كان تنشد عن حياتي فأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=194544",""],[5606,"يصير والا مايصير","https://www.poetsgate.com/ViewPoem.aspx?id=197425",""],[5747,"شوق شما","https://www.poetsgate.com/ViewPoem.aspx?id=61618",""],[5747,"اللي خذاك بطيب خاطر رجعك","https://www.poetsgate.com/ViewPoem.aspx?id=61675",""],[5756,"قصة حياة","https://www.poetsgate.com/ViewPoem.aspx?id=5435",""],[5837,"خسارة","https://www.poetsgate.com/ViewPoem.aspx?id=189956",""],[5848,"ماغيرها داخل البحرين مملوحة","https://www.poetsgate.com/ViewPoem.aspx?id=48963",""],[5848,"يا للأسف","https://www.poetsgate.com/ViewPoem.aspx?id=53383",""],[5931,"حزن الموادع !","https://www.poetsgate.com/ViewPoem.aspx?id=174801",""],[5976,"تباريح (مرثيه)","https://www.poetsgate.com/ViewPoem.aspx?id=30348",""],[5976,"لساني المسموم","https://www.poetsgate.com/ViewPoem.aspx?id=33337",""],[6113,"ذكريات....بحرجده","https://www.poetsgate.com/ViewPoem.aspx?id=36932",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""]],"verses":[["جتى أكتحلت بخده وبخطه","وغدوت بينهما حريق المجمر",0,"ر",1,0],["جتنا شتايم من بلد كلها ابقار","اكالة الخنزير لابو جربها",1,"ه",2,0],["جتني على مهل اللقآ والمواصيل","ورآحت على درب الجفى .. وانتهتني",2,"ن",2,1],["جتني رساله قلت للزين ترنيم","ماكنت احسب ان البلا محتويها",3,"ي",3,0],["جتني القصايد لاجل الاردن مغابيش","في صبح غير وطلته كلها خير",4,"ر",1,1],["جتني وشافتها عيونٍ حايرات","ذا شعاع الشمس أو هذا سناها",5,"ا",3,1],["جت تسائلني علامك منت رايق","قلت رايق بس ابكتب فيك حاجه",6,"ج",2,0],["جتك الاشواق رجليه وخياله","غير الاول تحمل شوقي التالي",7,"ل",2,0],["جت على آخر السهره ثقيلة خطاوي","مخطر ٍ بعضها في بعضها الثاني يسيح",8,"ح",1,1],["جت لها واهج اصفر يتبعه ظل ٍ سماوي","وكلما قرّبت خطوه لنا شلنا طريح",8,"ح",1,0],["جت على كيف كيفك تجلد القلب الهواوي","لين مايحلف انه في عذابه مستريح",8,"ح",1,0],["جت وحطت مابين الشمس والوجنه (يساوي)","وكل كسر ٍ بقلبي خلّته (1) صحيح",8,"ح",1,0],["جتني بها وأخجلتني من تأديبها","كنها فتاتن هدبها ينعس أنعاسي",9,"س",2,0],["جتني تهادى غيمةٍ مستقلّة","هتانها يعطر انفاس الاصباح",10,"ح",1,1],["جتك وتحدت نار شوقك ولا فاد","نفسك على رغم التحدي صبرها",11,"ر",3,0],["جتكم وصوف المسرجات السريعات","يالله عسا مااقول بالوصف زلّه",12,"ل",2,1],["جتني ثم قالت علامك ساكت وانا ابغى كلامك","واللي زرع بي غرامك واللي كرّمْنا بدينه..",13,"ن",2,0],["جت في يدها وردتينٍ حمر","قبل الشفق والشمس محمره",14,"ر",2,1],["جتني لياليها على دف ونغوم","اثر الليالي بالغرابيل جزله",15,"ل",2,0],["جتني بيوت الشعر خيلٍ بثر خيل","حجلٍ وساع نحور تبغى تصونك",16,"ك",1,0],["جتني وهي تمسح مدامع نكدها","والجرح عيا يندمل واحتملته",17,"ت",2,0],["جتني تهوش بشوشة منفوشه","جنية تسطى على المتخارش",18,"ش",1,0],["جتني خطاوي رجلها مربوشه","وانا من الي يكتويني قارش",18,"ش",1,0],["جتك العلوم ولا تقل ليش وأش في","وباقي علوم أعطيتها الستر وأخفيت",19,"ت",1,0],["جت وقالت هويصير أومايصير","أشتكي شوقي وأبين لك غلاك",20,"ك",1,1],["جتك الرساله وانتبه لاتزما","والطير مايكفخ بليا جناحين",21,"ن",1,0],["جتك المشاعر ثايره وارغمت شوقي للخضوع","حتى الضياع اللي تركته خلف غيرك يتبعك",22,"ك",1,0],["جتني ظروف للكدر مستعده","قامت تحدد لي الاحزان ميعاد",23,"د",1,1],["جتني من اغلى انسان مدري وش اقول","خسارةٍ ما بعدها من خسارة",24,"ر",2,0],["جت تسمع الشعر ! واصل الشعر شوفتها","هي أجمله ف امسية والا ف أصبوحة",25,"ح",2,0],["جتني تمايل من جميع الأماكن","سوالفٍ فيها السخافات تنساب",26,"ب",1,0],["جت ترتجف بي زهرة البعد وتفوح","تبكي الذبول اللي قدرها كتبها",27,"ب",3,0],["جتني تسولف عن غرامي وحبّي","وان ّ الهوا في صدرها كان مكتوم .. !!",28,"م",1,0],["جتْك المعاني كلّها .. سقتها سوق","كلّه بكيفي .. ما رضيت الغصيبه .. !!",29,"ب",2,0],["جت وهي تنوي على حبي تهده","مدري من ذاك الجفاوش مستفيده",30,"د",2,0],["جت وهي مترده وياه ضده","جت تقول بنفسهاالله لايعيده",30,"د",2,0],["جتني الهيئه وسوّت لي كمين","سالفه لوقلتهاالهرجه تطول",31,"ل",1,0],["جت وقال الشيخ لاتتكلمين","اسكتي يابنت وممنوع الدخول",31,"ل",1,0]]}