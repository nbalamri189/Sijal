"],[6186,"متجردٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82884&r=&rc=4",""],[5957,"رفقا بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82586&r=&rc=128",""],[6260,"أنشودة التحرير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68349&r=&rc=41",""],[5190,"شموع ودموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85041&r=&rc=116",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""]],"verses":[["هِيَ لَوْنُها مِنْ وَجْنَتَيْهِ وَطَعْمُها","مِنْ رِيقِهِ وَحَبابُها مِنْ ثَغْرِهِ",0,"ر",2,0],["هِيَ لا تَضِلُّ سَبيلَها فَكَأَنَّما","خُلِقَ السَبيلُ لَها بِغَيرِ نَواحي",1,"ح",2,0],["هِيَ لا بَراحَ تَرُدُّ كَيدَ عَدُوِّكُم","وَتَفُلُّ غَربَ الغاصِبِ المُجتاحِ",1,"ح",1,0],["هِيَ لَيْلَى عَبْدُ المَسِيحِ فَحَدِّثْ","عَنْ كَمَالٍ وَعِفَّةٍ وَمَبرَّهْ",2,"ر",2,1],["هي للجاهل عزّ","ولذي العلم حقاره",3,"ر",2,0],["هي للدَّاني بحارٌ","وهي للنائي سحائب",4,"ب",1,0],["هيلَت الأسماعُ من لفْظٍ له","واقْشعرّتْ لمعانيه الجُلودُ",5,"د",1,0],["هي لولا اعصامها بذيول الش","مس هامت في الجو أي هيام",6,"م",1,0],["هي للناظرين ديوان","شعر قد ازدهر",7,"ر",1,0],["هي ليلةٌ لا زِلْتَ تَلبَسُ مثلَها","في نِعمَةٍ وُصِلَتْ بها السَّرَّاءُ",8,"ا",2,0],["هِيَ لِلوارِدينَ ماءٌ زُلالٌ","وَسِواها لامِعٌ كَالسَرابِ",9,"ب",1,0],["هي لحظةٌ وهي الحياة ومن يعش","من بعدها يجد الحياة فضولا",10,"ل",2,0],["هِيَ لُقْيَةٌ وَهْمِيَّةٌ","سَمَحَتْ بِهَا خَطَرَاتُ ظَنِّي",11,"ن",2,0],["هِيَ للأبطالِ أزكى مطعماً","يا بني سعدٍ وأشهى مَشربا",12,"ب",2,0],["هِيَ للأقوامِ شَرٌّ وأذىً","وَهْيَ للبغضاءِ نَارٌ تَستَعِرْ",13,"ر",1,0],["هِيَ لولاكَ لارتمتْ تقذفُ الصّخ","رَ وتُزجِي هَباءها المنثورا",14,"ر",2,0],["هيَ لو علمتَ من المحا","سنِ عند أرفع مرتبه",15,"ب",2,0],["هِيَ لا تَجتَدي مُحِبّاً وَلا تُج","دي عَليهِ فَفيمَ يَبكي الحَسودُ",16,"د",1,0],["هي لُمعةُ القَبَسِ الأخير وقد خبا","نجمُ المساءِ ورعشةُ الأضواءِ",17,"ا",2,0],["هِيلاَنَةُ ضَمِنَتْ لَهَا وَلِيُوسُفَ","أَجْراً يَفُوقُ رَجَاءَ أَتْقَى رَاجِي",18,"ج",2,1],["هي ليلةٌ مزجَ السرورُ صباحَها","بمسائِها ومساءها بصباحها",19,"ح",3,0],["هي ليلةُ الفاروقِ تتلو مجدَهُ","والدهرُ والأيامُ من ألواحها",19,"ح",3,0],["هِيَ للصحابةِ مِن بَني الأنصار","من كلِّ بَدريٍّ وكلّ حَواري",20,"ر",2,0],["هيَ للذينَ لو امتحنتَ بلاءهم","لعجِبتَ من سُخْريَّةِ الأقدار",20,"ر",1,0],["هي للذي من كلِّ ما يَصِمُ الفتى","كاسٍ ، ومن جُهْدٍ يُشرّفُ عاري",20,"ر",2,0],["هِيَ لا عَدمتك بامتداحك قطعة","تَسمو لِأَعلى ذُروة وَتَحاذي",21,"ذ",2,0],["هي ليلاي لا عدمت صباحاً","من ضياها به الدجا يتنور",22,"ر",1,0],["هي ليلة القدر التي مَنْ قامها","في جنة المأوى استحق دخولا",23,"ل",2,0],["هي ليلةَ القدرِ التي قال النبي","أَنسيتها لكن كنتُ أراني",24,"ن",2,0],["هيَ لَيست تأليفَ فكرٍ ولكن","وارداتٌ للمتّقينَ حُبينا",25,"ن",2,0],["هي لولاه لم يلذّ بها العيش وما","عاش خالد لولاها",26,"ا",3,0],["هِيَ لي جُنَّةٌ مِنَ الفَقرِ ما عِش","تُ وَحِصنٌ مِنَ الخُطوبِ حَصينُ",27,"ن",1,0],["هِيَ لا رَيبَ رَوضَةٌ ذاتُ وَصلٍ","بِنَعيمٍ مِن خُلدِ جَنَّةِ عَدنِك",28,"ك",1,0],["هي ليلةٌ في حُبنا قصُرَت","ما كان أحلاها وأحلاكِ",29,"ك",1,0],["هي ليلة في العمر قد سنحت","فاغنم ليالي عمرك الضاحي",30,"ح",2,0],["هيَ لا شكَّ آيةٌ ظهرت","فاِنفِ عنها مقالَ ذي التَشكيك",31,"ك",1,0],["هي لَهوٌ لنا إذا حلَّت الكأ","س ولاةٌ في دَنِّها للمجوسِ",32,"س",1,0],["هيَ لَو لَم تَكُن ظِباً وَبُدوراً","ما صدَعنَ الدُجى وَجُبنَ القِفارا",33,"ر",2,0],["هي لولا الكَأْسُ لا معنى لها","دارتِ الدنيا عَلَى كفِّ المدير",34,"ر",1,0],["هيَ للحرّ اِصطباحٌ وَاِغتباق","مُذهلٌ عَن لذّةٍ بالأطيبين",35,"ن",1,0],["هيَ للخدودِ النّاعماتِ نَسيبةٌ","شَبَهاً فلِمْ نُسِبَتْ إلى النُّعْمان",36,"ن",1,0],["هي ليلةٌ عَلِقَ الرُّقادُ بناظري","فقَضى خيالُك فَرْضَ وَصْلٍ فُوِّتا",37,"ت",2,0],["هيَ لو تعلمينَ شُعْلةٌ نارٍ","أحْدَثتْ في الفؤادِ لذْعاً جميلا",38,"ل",2,0],["هي ليلَي والوَرى أجمعُهم","قَيسُها كلٌّ بها صبٌّ وَلوعُ",39,"ع",1,0],["هيَ للنَّصر آيةٌ فإذا ما","رفعتْ أردفتْ بآية حمد",40,"د",1,0],["هي لؤلؤ تفتر عن درّ بدا","يزري بسعدى في البها كحمائله",41,"ل",2,1],["هي لولا ملابسُ الوَشي غُصنٌ","وغزالُ الصّريمِ لولا شَواها",42,"ا",3,0],["هي لِلشَّعبِ صوتُه في شعوبٍ","وجَناحُ المُنى لمن يَتَسامى",43,"م",2,0],["هىَ لِلشَّعبِ تُرجمانٌ وقولُ ال","صِّدقِ للتُّرجمانِ كان لِزاما",43,"م",2,0],["هي للِشَّعبِ أيُّ مرآةِ خُلقٍ","يَتراءى كما يكونُ تَماما",43,"م",2,0],["هي لولا كؤوسها ما تبدت","ما تبدت كؤوسها لولاها",44,"ا",3,0],["هي لي تارة به وله بي","مثل نهر يدور في مَنْجَنُونِه",45,"ن",2,0],["هي لم تكن شيئاً وقد","صارت به شيئاً يسود",46,"د",1,0],["هي لِحْيةٌ حُلِقت علي","ها من مَلاَحَتِهَا لِحى",47,"ح",2,0],["هِيَ لا شَكَّ مُعْصِرٌ غيرَ أَن ال","قَدَّ مِنْها يَقُولُ لِي هِيَ أَمْرَدْ",48,"د",1,0],["هي للنطاسي زينة كالتاج في","هام الملوك مرصعا ومنضدا",49,"د",2,0],["هي لابتزار المال منك تظاهرت","في ثوب حب وهو ثوب رياء",50,"ا",2,0],["هي لا تبالي أن يصاب لها","هامٌ إذا حاطت عرضا",51,"ض",2,0],["هي لهْوي نحَتُّ هولَ أساها","بأزاميلِ هِمتي كيفَ تُمحَى",52,"ح",2,0],["هي للشّعوب وللحكومة نورها ال","هادي وإن تبطش فبطش القيصر",53,"ر",1,0],["هِيل المتيّم بعد الأمن مُذ أفلت","أقماره فهو داهي القلب واهيه",54,"ي",2,0],["هي لوعة في وائل من بعد سح","بان وفي ذبيان بعد زياد",55,"د",1,0],["هي لمحة المذهول لا رؤيا الكرى","ليت الكرى من بعد فقدك زارا",56,"ر",2,0],["هي ليس يدركها عينٌ سواها ولا","تقولُ أهل النهى في مطلبٍ ما هي",57,"ي",1,0],["هي لمّا لبستُها سبَّحتْ","حسبي الله تعالى وكفى",58,"ف",2,0],["هِيَ لَفَظَةٌ مَقبُوحَةٌ بِدعِيَّةٌ","مَذمُومَةٌ مِنَّا بِكُلِّ لِسَانِ",59,"ن",1,0],["هِيَ لِلزِنا سَبَبٌ وَإِنَّ رُبوعَنا","مَهد الهِدايَةِ عِفَّةٌ تَتَجَسَّمُ",60,"م",1,0],["هي للزائرين من ذا وهَذا","موئل عند قصدها مولاها",61,"ا",3,0],["هِيَ لَبوة عظمت مَهابتها وَفي","غاب الرِياسة خلفت آسادا",62,"د",2,0],["هي للعدالة قطبها وهي التي","ما ضل عن نهج الهدى حكامها",63,"م",3,0],["هي للفتى الجاني محل خلاعة","ولصالح النساك حضرة قدس",64,"س",1,0],["هي لولا القبحُ ما كانت عفيفه","فهي رغم الأنف عذراءُ شريفه",65,"ف",2,0],["هي لي تدلُّ بحسنها","وأنا أدلُّ لها بروحي",66,"ح",2,0],["هي لا ترضي برأيي ولا تأتي","برأي فهل عراها الخمود",67,"د",1,0],["هي لم تنسني إذا مر عام","حافظات عهداً لنا وذماما",68,"م",2,0],["هِيَ لَنْ تَعُودَ فَرَعْشَةٌ نَارِيَّةٌ","شَرِبَتْ حُضُونَ لِحَائِهَا بِجَف