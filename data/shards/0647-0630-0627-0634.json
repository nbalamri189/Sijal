4,"","https://poetry.dctabudhabi.ae/diwan/poem/93874","البسيط"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140160",""],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132012","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78219","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81250","المجتث"],[4718,"ياما حلا الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=137107",""],[4755,"تَجْتَاحُنِيْ فِيْ هَذِهِ الآوِنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=184716",""],[4767,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=215856",""],[4788,"أعيشك","https://www.poetsgate.com/ViewPoem.aspx?id=132245",""],[4858,"شوق والد إلى أولاده","https://www.poetsgate.com/ViewPoem.aspx?id=30458",""],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[4858,"أطلق جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=138073",""],[5007,"سهم الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=142374",""],[5052,"أتلفتُ حَوبائي","https://www.poetsgate.com/ViewPoem.aspx?id=205347",""],[5150,"شكرا","https://www.poetsgate.com/ViewPoem.aspx?id=202785",""],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5187,"أنا وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=29693",""],[5277,"وللهوى عطره","https://www.poetsgate.com/ViewPoem.aspx?id=206207",""],[5320,"آه على الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=41642",""],[5493,"كفُّ المدى","https://www.poetsgate.com/ViewPoem.aspx?id=197091",""],[5493,"مفتاح الوغى","https://www.poetsgate.com/ViewPoem.aspx?id=204834",""],[5499,"ماشفت ابردي","https://www.poetsgate.com/ViewPoem.aspx?id=177626",""],[5536,"رساله الى امرأه مسافره","https://www.poetsgate.com/ViewPoem.aspx?id=22807",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5764,"رجلي وبابك","https://www.poetsgate.com/ViewPoem.aspx?id=191426",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5923,"عذراً دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=177795",""],[5988,"هذا شبيهُ الحبيب قد طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=99715",""],[6003,"عنترة !!","https://www.poetsgate.com/ViewPoem.aspx?id=189043",""],[161,"بارك الله لكما","https://www.poetsgate.com/ViewPoem.aspx?id=175728",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""]],"verses":[["هَذَا شَهِيدٌ مِنْ وُلاَتِكَ خَامِسٌ","يَهْوِي بِحَيْثُ هَوَيْتَ فِي المَيْدَانِ",0,"ن",1,0],["هذا شهابُ سمائكم متوقِّدٌ","بالذّهنِ فوقَ الكوكبِ المتوقّد",1,"د",1,0],["هذا شبابُ الشّرق يطلبُ حقَّه","ويُطيعُ فيه شُيوخَه الأبرارا",2,"ر",2,0],["هذا شرَابُ الباذلين نُفوسَهم","باللهِ هل نَقَع الصَّدى وشفاكِ",3,"ك",1,0],["هذا شعاع العبقرية لم يزل","يولي الحياة طلاقة وسماحا",4,"ح",2,0],["هذا شعاعٌ لاح","يخفق في وهجِ",5,"ج",1,0],["هَذَا شَقَائِيَ فِيِكُمْ","يَا غِبْطَةَ الْحُسَّادِ",6,"د",1,0],["هذا شهيد العلم، عزَّزنا به","من راح من شهدائنا الأبرار",7,"ر",1,0],["هذا شراعي ولكن","من لي بريحٍ تهبُ",8,"ب",1,0],["هذا شَبابُكَ يا سَليمُ تَزينُه","تِلك الخِلالُ الغُرُّ وَالأَخلاقُ",9,"ق",1,1],["هذا شِهابٌ ساطِعٌ مُشرِقٌ","والليلةُ الليلاءُ من بَعدِه",10,"د",2,0],["هذا شراب القوم سادتنا وقد","أخطأ الطريقة من يقل بخلاف",11,"ف",1,0],["هذا شبابك في الربيع","فهل بسمت إلى الربيع",12,"ع",1,0],["هذا شبابك في العيون","الناظرات وفي الأثير",12,"ر",1,0],["هذا شبابي الذي شابت مباهجه","يهفو إليك ويشكو نار أحزاني",13,"ن",2,0],["هذا شيمك المِسكين عاد لَهُ","ما زالَ يُغريكَ حَتّى نالَ ما طَلَبَه",14,"ب",2,0],["هذا شِعارُكَ تكُسونِي دقائِقَهُ","وهذِه هذِهِ لا شَكَّ أَشعاري",15,"ر",2,0],["هَذا شِفاءٌ لِلعُيو","نِ وَذا شِفاءٌ لِلصُدورِ",16,"ر",1,0],["هذا شَقيقُ الرُّوح فَارَقَ في الحَشَا","بيتاً له قد صارَ شطراً مُفْردا",17,"د",2,0],["هذا شعور ضيوف بيننا كرمت","أخلاقهم حبذا من هكذا شعرا",18,"ر",2,0],["هَذا شمام وذا رضوى لديه وذا","في الجود سيحان بل هذاك جيحانُ",19,"ن",1,0],["هذا شقاء ما له دافع","إسمع فإن الله لي سامع",20,"ع",1,0],["هذا شفيع الخلق هذا الذي","قد خصّه الله برفع المقام",21,"م",1,0],["هذا شِعارُكَ قد وافيتَ أَربُعَنا","يا قائداً حاذقاً فاقتْ مزاياه",22,"ا",2,0],["هَذا شعاعي فيك بل بلاغي","عن هيت أَهل البيت وَالمصلى",23,"ل",2,0],["هذا شعارُ بنيك فيكَ وكلهم","فحواه ينشرُ حيث حلَّ مُذيعا",24,"ع",2,0],["هذا شرب أولي اليمين ولكن ال","أبرار شربهم المقرب خيرة الرحمن",25,"ن",1,0],["هذا شهابك بالمرصاد يثقب من","يسمعون وترديهم قوافيه",26,"ف",3,0],["هذا شعورك أم يراعك جار","ببديع ما تنشيه من أشعار",27,"ر",1,1],["هذا شباب القطر بين ظهوركم","متشرد ينساب في أسمائه",28,"ه",1,0],["هَذا شعار غد هَذا دلائله","قَد ضَمَّ عَن سعده أَو نحسه حججا",29,"ج",2,0],["هذا شَواظ الهَوى في القَلبِ مُلتَهِب","وَفي التَنَفُّسِ مِن آثار اِحراقي",30,"ق",2,0],["هَذا شِراع مُكسر","وَذا شِراع مفر",31,"ر",1,0],["هذا شرينا رفقته مانبيعه","يعيش عالي الراس والنذل ماعاش",32,"ش",1,0],["هَذَا شُعُوْرٌ لَمْ أَذُقْ قَبْلَهُ","مَا ذُقْتُهُ, مُذْ مِتُّ فِي الثَّامِنَه",33,"ن",2,0],["هذا شعوري إنني","في القول لا أتملق",34,"ق",1,0],["هذا شهر ومع الشهر كم إسبوع","في كل ليل أسهرك شوق وأعيشك",35,"ك",1,1],["هذا شريط من حياةِ أحبّتي","أنغامُهُ في القلبِ جدّ عذابِ",36,"ب",1,0],["هذا شذوذٌ في الطّبيعة والنُّهى","هذا لَعَمري لا يراهُ المَذهبُ",37,"ب",1,0],["هذا شذوذٌ في الطّبيعة والنّهى","هذا لعَمْرُكَ سُبّةُ الأعصار",38,"ر",1,0],["هَذا شخِيرُ الرَّعْد أيْقَظَ غَيْمَة","فَبَكَتْ ولَكنَّ الدُّموعَ دِمَاءُ",39,"ا",2,0],["هذا شعوريَ ما جفّتْ منابعهُ","بل إنّني في الهوى أتلفتُ حَوبائي",40,"ا",3,0],["هذا شعوري وكم حاولتُ أكتمهُ","والقلبُ يخشى لسانَ الحالِ أن يدري",41,"ر",2,0],["هذا شُعوري بعدَ تجربةٍ","قدْ ذقتُ مِنها حَنظلَ الكَدرِ",42,"ر",1,0],["هذا شعوري مثلُ شِعري صادقٌ","مرآةُ ذاتي حينما يَتَدَفَّقُ",43,"ق",1,0],["هذا شميمُ نداك في إصباحهِ","واللونُ لونُ جبينكِ الزهري",44,"ر",2,0],["هذا شراب الكوكاكولا هكذا","يحوى رفات عناكب وذباب",45,"ب",1,0],["هذا شريدُ الرُّوحِ في فَجِّ الرُّؤى","أحْلامُهُ مَرهونة الأسبابِ",46,"ب",1,0],["هذا شبابُ الشامِ يبذلُ روحهُ","بذْلًا يُزيلُ الظُّلمَ عنْهُ ويَطرُدُ",47,"د",1,0],["هذا شهر عدى بعيني، كن بالحسبان حول","مريت بفصول السنه ، للحين ماشفت ابردي",48,"د",2,0],["هذا شعوري فاعذريني إنني","ما اعتدت أن أخفي عليك شعوري",49,"ر",2,0],["هذا شفاء وهدى ورحمة","فاستشف او فاستهدوا فاسترحم",50,"م",1,0],["‏هذا شعوري نثرته شعر بكتابك","‏في كل مره بتهملني .. بتلهمني",51,"ن",2,0],["هذا شفاء للسقيم","وإنه كأس الامل",52,"ل",1,0],["هذا شبابيْ على الجُدرانِ أنْثُرُهُ","ضاعَ الشبابُ فأنَّىْ تنفعُ النِّحَلُ",53,"ل",1,0],["هذا شبيهُ الحبيب قد طلعا","غاب كما غابَ ثم قد لمعا",54,"ع",2,1],["هذا شجاعٌ في البلادِ إذا رأى","متذمراً لا يستحي أنْ يصفعَهْ",55,"ع",2,0],["هَذَا شَرِيفُ الأصْلِ وَافَى مَنْ أتَى","فِي حَضٍَرةِ التَّأْمِينِ زَوَّجْنَاهُ",56,"ا",2,0],["هذا شعاعك بات يهدى ضوءه","تحت الدجنة طرف كل شريد",57,"د",1,0]]}