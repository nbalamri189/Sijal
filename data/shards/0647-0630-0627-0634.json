{"poems":[[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[74,"يا أهل فضل الله إن لبيتكم","https://www.aldiwan.net/poem18556.html","الكامل"],[107,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[107,"مصر اذكري في الخالدين فتاك","https://www.aldiwan.net/poem42088.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54713","المجتث"],[108,"سبق الفضاء!","https://www.poetsgate.com/ViewPoem.aspx?id=179491",""],[203,"لغيري الدهر سلم","https://www.aldiwan.net/poem45393.html","المجتث"],[229,"هذا شبابك يا سليم تزينه","https://www.aldiwan.net/poem55200.html","الكامل"],[245,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[308,"بشر فؤادك بالنصيب الوافي","https://www.aldiwan.net/poem16794.html","الكامل"],[332,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[332,"يا ربة الشعر والأحلام ما صنعت","https://www.aldiwan.net/poem55054.html","البسيط"],[365,"مهلا فمالك في هذا الجمال شبه","https://www.aldiwan.net/poem68135.html","البسيط"],[436,"وغادة عادت الدنيا ببهجتها","https://www.aldiwan.net/poem12436.html","البسيط"],[471,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"],[565,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"]],"verses":[["هَذَا شَهِيدٌ مِنْ وُلاَتِكَ خَامِسٌ","يَهْوِي بِحَيْثُ هَوَيْتَ فِي المَيْدَانِ",0,"ن",1,0],["هذا شهابُ سمائكم متوقِّدٌ","بالذّهنِ فوقَ الكوكبِ المتوقّد",1,"د",1,0],["هذا شبابُ الشّرق يطلبُ حقَّه","ويُطيعُ فيه شُيوخَه الأبرارا",2,"ر",2,0],["هذا شرَابُ الباذلين نُفوسَهم","باللهِ هل نَقَع الصَّدى وشفاكِ",3,"ك",1,0],["هذا شعاع العبقرية لم يزل","يولي الحياة طلاقة وسماحا",4,"ح",2,0],["هذا شعاعٌ لاح","يخفق في وهجِ",5,"ج",1,0],["هَذَا شَقَائِيَ فِيِكُمْ","يَا غِبْطَةَ الْحُسَّادِ",6,"د",1,0],["هذا شهيد العلم، عزَّزنا به","من راح من شهدائنا الأبرار",7,"ر",1,0],["هذا شراعي ولكن","من لي بريحٍ تهبُ",8,"ب",1,0],["هذا شَبابُكَ يا سَليمُ تَزينُه","تِلك الخِلالُ الغُرُّ وَالأَخلاقُ",9,"ق",1,1],["هذا شِهابٌ ساطِعٌ مُشرِقٌ","والليلةُ الليلاءُ من بَعدِه",10,"د",2,0],["هذا شراب القوم سادتنا وقد","أخطأ الطريقة من يقل بخلاف",11,"ف",1,0],["هذا شبابك في الربيع","فهل بسمت إلى الربيع",12,"ع",1,0],["هذا شبابك في العيون","الناظرات وفي الأثير",12,"ر",1,0],["هذا شبابي الذي شابت مباهجه","يهفو إليك ويشكو نار أحزاني",13,"ن",2,0],["هذا شيمك المِسكين عاد لَهُ","ما زالَ يُغريكَ حَتّى نالَ ما طَلَبَه",14,"ب",2,0],["هذا شِعارُكَ تكُسونِي دقائِقَهُ","وهذِه هذِهِ لا شَكَّ أَشعاري",15,"ر",2,0],["هَذا شِفاءٌ لِلعُيو","نِ وَذا شِفاءٌ لِلصُدورِ",16,"ر",1,0],["هذا شَقيقُ الرُّوح فَارَقَ في الحَشَا","بيتاً له قد صارَ شطراً مُفْردا",17,"د",2,0]]}