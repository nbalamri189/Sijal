{"poems":[[71,"قيل لي برطل الذهب","https://www.aldiwan.net/poem28582.html","مجزوء الخفيف"],[33,"طال ليلي لسرى طيف ألم","https://www.aldiwan.net/poem41333.html","الرمل"],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[203,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[399,"القصر والكوخ","https://www.aldiwan.net/poem24308.html","عموديه"],[567,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56155","الرمل"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216504","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107539","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[5107,"نداء من المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=32889",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5458,"لن يظل الورد ذابل","https://www.poetsgate.com/ViewPoem.aspx?id=113361",""],[5461,"قصيدة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=5295",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[6082,"الحزن منّي","https://www.poetsgate.com/ViewPoem.aspx?id=59108",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6304,"يقظان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1616&r=&rc=6",""]],"verses":[["كيفَ همْ يحرقونني","وأنا أشتري الحطبْ",0,"ب",1,0],["كَيفَ هَذا يَستَوي في حُكمِهِ","أَنَّهُ بَرٌّ وَأَنّي مُتَّهَم",1,"م",1,0],["كيف هنّا فقادنا أغبياء","ولصوص متوّجون أكارم ؟",2,"م",1,0],["كيفَ هامَ القطارُ حينَ رآها","أترى حسنُها استهامَ القطارا",3,"ر",2,0],["كيف هذا يا ربّ ؟ رفقا بنا رف","قا فقد غصّت الكؤوس دموعا",4,"ع",2,0],["كيفَ هذي الدُّنيا وهذا الزَّمانُ","كلَّ يومٍ يُقالُ ماتَ فُلانُ",5,"ن",1,1],["كيف هدَّ الموت ركناً","كان في التهريج فاقْ",6,"ق",1,0],["كيف هل مرغت حجارتها الشم","وهل أركنت إلى الإفساد",7,"د",1,0],["كيف هذا العفَافُ يُصبحُ خزياً","كيف هذا الملاكُ يجني ويأثم",8,"م",1,0],["كيف هذا الأمر يا ليث الشَرى","ترتضي مثواك في جوف الثرى",9,"ر",2,0],["كيف هدّوا فردوسنا؟كيف رجّت","كلّ ما حولنا زوابع سودُ ؟",10,"د",1,0],["كيف هنتم وفي الهوان ضياعٌ","وانهيارٌ وسُبةٌ.. وبَوَارُ؟",11,"ر",1,0],["كيف هذا الحلم أمسى من سعير الثأر ناهل","وهو من غنى بوحي من ربا الجنات نازل",12,"ل",1,0],["كيف هذا من هوى قلبي يجيني","يا أرق الناس قولي وش دهاك",13,"ك",1,0],["كيفَ هذا ولي عشيقٌ خصيٌّ؟","وأنا ما امتلكتُ يوماً حرارهْ",14,"ر",2,0],["كيف هذا لست ادري","انّ ذاك غصب عنّي",15,"ن",2,0],["كَيفَ هانَتْ دُمُوعُنا ؟ فَغَدَونا","بَعدَ عُمرِ الغَرامِ كالأَعداءِ !",16,"ا",2,0],["كيف هزت عواصف الرمل مهدا","ضجرت من بٌكائِهِ الأوطانُ",17,"ن",1,0]]}