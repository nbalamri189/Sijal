[45,"أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31336",""],[99,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[105,"هفت العروش وزلزلت زلزالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54905&r=&rc=75",""],[105,"قصوا الحديث عن الفريق النائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55043&r=&rc=213",""],[99,"إمرأة مِنْ دُخَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68837&r=&rc=389",""],[27,"حيوا أمامة َ واذكروا عهداً مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16336&r=&rc=0",""]],"verses":[["لا تَجعَلَنَّ دَليلَ المَرءِ صورَتَهُ","كَم مَخبَرٍ سَمجٍ عَن مَنظَرٍ حَسَنِ",0,"ن",1,0],["لا تَجمَعَنّي وَالزَمانَ فَإِنَّهُ","عَودٌ يَحُكُّ جِرانَهُ بِجِراني",1,"ن",2,0],["لا تَجعَلَنهُ دَيدَناً وَدابا","وافَقَ مِنّا أَجَلٌ كِتابا",2,"ب",2,0],["لا تَجمَعي هَجراً عَليَّ وَغُربَةً","فَالهَجرُ في تَلَفِ الغَريبِ سَريعُ",3,"ع",1,1],["لا تَجزَعي وَاِصطَبِري","لِوَصلِنا وَاِرتَقِبي",4,"ي",1,0],["لاَ تُجَاورْ أَطْنَابَ خَيْمَةِ ظَبْيٍ","فَهَاتِيكَ لِلْقُلُوبِ حِبَالَهْ",5,"ل",2,0],["لا تَجعَلي الواشينَ رُسلَكِ في الهَوى","فَلَأَصدَقُ الرُسُلِ الجَمادُ الناطِقُ",6,"ق",1,0],["لا تَجزَعَنَّ فَلَستَ أَوَّلَ ماجِدٍ","كَذَبَت عَلَيهِ صَحائِفُ الفُجّارِ",7,"ر",1,0],["لا تَجمَعَنَّ عَلَيَّ عَتبِكَ وَالنَوى","حَسبُ المُحِب عُقوبَةً أَن يُهجَرا",8,"ر",2,0],["لاَ تُجِيبِينَ أَدْمُعِي سَائِلاتٍ","وَعَزِيزٌ عَلَىَّ ألاَّ تُبِيِني",9,"ن",2,0],["لا تجزعَنّ فإن خلفك أمةً","تمشي كمشيك للعَلاء وتتبع",10,"ع",1,0],["لا تجعلوا العلم فيها كل غايتكم","بل علّموا النَشء علماً ُينتج العملا",11,"ل",2,0],["لا تَجفُوَنَّ بَني تَميمٍ إِنَّهُم","تابوا النَصوحَ وَراجَعوا حُسنَ الهُدى",12,"ا",1,0],["لا تَجزَعوا أَن تُنسَبوا لِأَبيكُمُ","فَاللُؤمُ يَبقى وَالجِبالُ تَزولُ",13,"ل",1,0],["لا تجعلِ اسميَ للعذَّال منتصباً","فما لتعريف وجدي فيك تنكير",14,"ر",1,0],["لا تجعلنْ بيتَ قلب المستهام ولا","بيتَ التغزُّل باللمياءِ مكسورا",15,"ر",2,0],["لا تجزعنَّ أبا العبَّاس من خطرٍ","عداك فالوقت باكي الفكر باسمه",16,"م",2,0],["لا تَجاهلْ هناك يا من أبي اللَّ","هُ عليه أن يشبه الجُهَلاءَ",17,"ا",2,0],["لا تجهَّمْ بشراء ال","خير واصدِفْ عن بُغاتِهْ",18,"ت",2,0],["لا تجمعنَّ إلى عيبٍ تُعاب به","عَيبَ الخداع فلن تزداد طيبَ نَثَا",19,"ث",2,0],["لا تَجْبُنَنَّ لأن النفس واحدة","فإنما الموت أيضاً واحدٌ فَقَدِ",20,"د",1,1],["لا تجشِمَنْ أهلي إليك وفادةً","لِيَفِدْ عليهمْ برُّك الوَفّادُ",21,"د",1,0],["لا تجعلوا من حديث الناس موعظةً","ولا يزلْ عُرفكم أسمارَ سُمّار",22,"ر",1,0],["لا تَجْعلنّي لما أرى غَرضاً","تلعبُ فيه مَحادِسُ الحُدُس",23,"س",1,0],["لا تجعلنّي قذاةَ الكأسِ مقليةً","بعد اعتداديَ من منفوسِ ريحانك",24,"ك",1,0],["لا تجمعنّ إلى ذكراه نِسبَتَه","فقد كفاكَ مكان النسبةِ ابنُ جلا",25,"ل",2,0],["لا تجمُدا لاتَ حينَ معذرةٍ","ما لم تذوبا لمُستذيبِكما",26,"م",2,0],["لا تجعلنَّك عصبةٌ عن ظِنَّةٍ","حُزْني وأنت سرُورُ كل حزين",27,"ن",1,0],["لا تجشَّم لي التخلُّق إن كنْ","تَ مَلولاً إنَّ التجَشُّم شِقْوه",28,"و",2,0],["لا تجعلنْه كراجي الغيثِ أصعَقَهُ","وإنما أمَّلَ الإسقاءَ راجيه",29,"ي",2,0],["لا تجزعَنَّ من الصدود فإنما","غرض المفَدِّي أن يرى تَيّاها",30,"ا",3,0],["لا تَجزَعي فَالمَوتُ لَيسَ يَضيرُنا","فَلَنا إِيابٌ بَعدَه وَنُشورُ",31,"ر",1,0],["لا تجزعن اذا ما نكبة حزبت","فانما الدهر ارخاء وتشديد",32,"د",1,0],["لا تجزعنّ اذا ما فتنة حدثت","ما انت وحدك بالاضرار مقصود",33,"د",1,0],["لا تَجعَلي حُبَّ القَديمِ وَذِكرَهُ","حَسَراتِ مِضياعٍ وَدَفعَ مُبَدَّدِ",34,"د",1,0],["لا تَجعَلوا الدينَ بابَ الشَرِّ بَينَكُمُ","وَلا مَحَلَّ مُباهاةٍ وَإِدلالِ",35,"ل",1,0],["لا تَجِئها بِالمَتاعِ المُقتَنى","سَرَقاً مِن كُلِّ قَومٍ وَنِهابا",36,"ب",2,0],["لا تُجزِهِم عَنكَ حُلماً وَاِجزِهِم عَنَتاً","في الحِلمِ ما يَسَمُ الأَفعالَ أَو يَصِمِ",37,"م",1,0],["لا تَجعَلوهُ هَوىً وَخُلقاً بَينَكُم","وَمَجَرَّ دُنيا لِلنُفوسِ وَمَتجَرا",38,"ر",2,0],["لا تَجزِني بِضَناً بي بَعدَها بَقَرٌ","تَجزي دُموعِيَ مَسكوباً بِمَسكوبِ",39,"ب",1,0],["لا تَجسُرُ الفُصَحاءُ تُنشِدُ هَهُنا","بَيتاً وَلَكِنّي الهِزَبرُ الباسِلُ",40,"ل",1,0],["لا تَجِدُ الخَمرَ في مَكارِمِهِ","إِذا اِنتَشى خَلَّةً تَلافاها",41,"ا",3,0],["لا تجمعوا لغةَ النبيطِ وتيهَكُم","وأُصولَكُم وأسامِيَ الأشرافِ",42,"ف",1,0],["لا تجزعَنْ إنْ فات ما رُمْتَهُ","واشْدُدْ عُرَى عزمِكَ بالصَّبْرِ",43,"ر",1,1],["لا تَجَرَّم عَلى تِلادِكَ تَختا","رُ الَّتي في وُقوعِها تَبذيرُه",44,"ر",2,0],["لا تَجمَعَنَّ عَلَينا رِدَّةً وَبَذا","قَولٍ فَذَلِكَ سوءُ الكَيلِ وَالحَشَفُ",45,"ف",1,0],["لا تُجاوِز مِقدارَ سَطوِكَ إِن لَم","تَتَطَوَّل بِالصَفحِ مِقدارَ جُرمي",46,"ي",1,0],["لاتُجزَيَنَّ أَبا عُبَيدَةَ صالِحاً","عَن طولِ وَقفَتِنا بِقِنَّسرينا",47,"ن",2,1],["لا تَجبُرُ الأيَّامُ كَسْرَ عِصابةٍ","كُسِرَتْ وذَلَّ بجابرٍ جَبَّارُها",48,"ر",3,0],["لا تَجزَعَنَّ مِنَ الحَوادِثِ إِنَّما","خَرقُ الرِجالِ عَلى الحَوادِثِ يُجزِعُ",49,"ع",1,0],["لا تَجزَعَنَّ إِذا نابَتكَ نائِبَةٌ","واصبر ففي الصّبر عند الضّيقِ متَّسعُ",50,"ع",1,1],["لا تَجعَلَنَّ المالَ كَسبَكَ مُفرَداً","وَتُقى إلَهَكَ فَاِجعَلَن ما تَكسِبُ",51,"ب",1,0],["لا تَجزَعَنَّ فَمَن تَعَت","تَبَ دامَ وَصلُ تَعَتُّبِه",52,"ب",2,0],["لا تَجتَني الطَيِّباتِ يَوماً مِنَ ال","غَرسِ يَدٌ كانَ غَرسُها الحَسَكا",53,"ك",2,0],["لا تَجنَحَنَّ إِلى حَيٍّ تُمايِلُهُ","وَإِن جَنَحتَ إِلَيهِ فَاِتَّخِذ نَفَقا",54,"ق",2,0],["لا تَجزَعَنَّ إِذا اِرتاعوا لِرائِحَةٍ","بِفيكَ لَيسَ لَها في الحُسنِ مِن أَثَرِ",55,"ر",1,1],["لا تَجسُرُ الأُسدُ أَن تَغشى مَناهِلَهُم","قَومٌ إِذا الشَرُّ أَبدى ناجِذَيهِ لَهُم",56,"م",1,0],["لا تجزعنَّ لعلةٍ رهنَ الدجى","ستزول عند تبلُّج الإصباحِ",57,"ح",1,0],["لا تجزعي يوم الفداء فكلنا","مهج تحلق كالنسور عليك",58,"ك",1,0],["لا تجفف أيديكم أدمعا تنفع","قلباً لمّا يزل موجوعا",59,"ع",2,0],["لا تجزعوا للشاعر الملهم","ما مات لكن صار في الأنجم",60,"م",1,1],["لا تجزعوا للشاعر الملهم","بنضرة الأيام لم ينعم",60,"م",1,0],["لا تجزعوا للشاعر الملهم","والله ما نام مع النوَّم",60,"م",1,0],["لا تَجعَلَنْ جَسَدي لها حَطَباً","فيه تُحَرَّقُ منّيَ النفسُ",61,"س",1,0],["لا تَجعَلوا البَغيَ ظَهراً إِنَّهُ جَمَلٌ","مِنَ القَطيعَةِ يَرعى وادِيَ النِقَمِ",62,"م",1,0],["لا تُجزِرَن عِرضَكَ الأَساوِدَ وَاِس","تَخفِ بِأَنفِ بادٍ لِمُجتَدِعِه",63,"ع",2,0],["لا تجعلوا بالشينِ نطقَكُمُ","فسبَّكمْ بالزينِ والقافِ",64,"ف",1,0],["لا تَجمَعي صَرمي وَهَجري باطِلاً","وَتَفَهَّمي وَاِستَيقِني اِستيقانا",65,"ن",2,0],["لا تَجعَلَن أَحَداً عَلَيكَ إِذا","أَحبَبتَهُ وَهَوَيتَهُ رَبّا",66,"ب",2,0],["لا تجزعِي لِصروفِ دَهرِكِ واثْبُتي","فالبأس صَبرٌ واليقينُ ثَباتُ",67,"ت",1,0],["لا تجزَعوا للحادثاتِ تُصيبُكم","وخُذوا سبيلَ الفِتيةِ الحُنَفاءِ",68,"ا",2,0],["لا تَجهَل الأَعيادُ حينَ نُقيمُها","أَنَّ الغَدَ المَأمولَ عيدٌ أَكبَرُ",69,"ر",1,0],["لا تَجزَعوا لِلمُلكِ بَعدَ ذَهابِهِ","المُلكُ لِلَهِ العَلِيِّ الشانِ",70,"ن",1,0],["لا تَجعَلوا النيلَ صَيداً في مَخالِبِها","فَالوَيلُ لِلنيلِ إِن هاجَت ضَواريها",71,"ي",3,0],["لا تَجعَلَنها في المَهانَةِ آيَةً","تُخزي الوُجوهَ وَفي الجُمودِ مِثالا",72,"ل",2,0],["لا تجزعنَّ لِطُولِ البَينِ إِن جَزعَت","أَطلالُ كلِّ شَجيِّ الرَسم محزونِ",73,"ن",1,0],["لا تجزعي إنّهُ العهدُ الذي انبعثت","أنوارُهُ تَصدَعُ العهدَ الذي سَلَفا",74,"ف",2,0],["لا تجزعوا واسمعوا ماذا يُقال لكم","فما بكم تحت أطباق الثَرى صَممُ",75,"م",1,0],["لا تَجمَعا مالي وَعِرضِيَ باطِلاً","كَلّا لَعَمرُ أَبيكُما حَبّاقِ",76,"ق",1,1],["لا تَجعَلونَ الثَلاثا لِاِجتِماعِكُمُ","إِنَّ الكَتاتيبَ تَخلو في الثُلاثاءِ",77,"ا",2,0],["لاَ تَجْعَلُوني في الحَمِيرِ كَناظِمٍ","سَرَقَتْ يَدَاهُ فَقُطِّعَتْ أُذُناهُ",78,"ه",1,0],["لا تَجعَلِ الماءَ لَها قاهِراً","وَلا تُسَلِّطها عَلى مائِها",79,"ا",3,0],["لا تَجمَعا بي شَملَ ذي طَرَبٍ","قَد با كَرَ الإِبريقَ وَالقَدَحا",80,"ح",2,0],["لا تَجعَلِن في غَدٍ وَعدي وَبَعدَ غَدٍ","فَإِن فَعَلتِ فَما وَفَّيتِ ميعادا",81,"د",2,0],["لا تُجرِ شَيبَكَ لِلصِبى فَرَساً","وَاِقعُد فَإِنَّ لَدَيكَ قَد قَعَدوا",82,"د",3,0],["لا تَجمَعوا المالَ وَاِحبوهُ مُوالِيَهُ","فَالمُمسِكونَ تُراثٌ كُلَّ ما جَمَعوا",83,"ع",3,0],["لاتَجلِسَن حُرَّةٌ مُوَفَّقَةٌ","مَع اِبنِ زَوجٍ لَها وَلا خَتَنِ",84,"ن",1,1],["لا تَجعَلَن حالي إِذا","غُيِّبتُ أَيأَسَ حالَتَيّا",85,"ت",3,0],["لا تَجحَديهِ عَلى التَغَرُّبِ حَقَّهُ","فَإِذا جَهِلتِ مَكانَهُ فَتَعَلَّمي",86,"م",2,0],["لا تجردني في الوَغى لقراع","فأَنا اليوم صارم مفلول",87,"ل",1,0],["لا تجزعي يا بثن إني واثق","بيراعتي وعواقب الأيام",88,"م",1,0],["لا تجبننَّ فَلَيسَ ال","جبان شيئاً يحوز",89,"ز",1,0],["لا تَجْمَعُ الأَيَّامُ كَيْفَ تَصَرَّفَتْ","فِي الْقَلْبِ بَيْنَ الْخَمْرِ وَالْوَسْوَاسِ",90,"س",1,0],["لاَ تَجْعَلُوهُ وَدَاعِي","عِنْدَ المَمَاتِ وَزَادِي",91,"ي",1,0],["لا تجْزَعِي مِنْ نكبةِ الدّنيا وإنْ","ساءَتْ فرُبَّ مساءَةٍ لسِرورِ",92,"ر",1,0],["لا تَجعَلَنّا أَبَيتَ اللَعنَ ضاحِكَةً","كَمَعشَرٍ صُلِموا الآذانَ أَو جُدِعوا",93,"ع",3,0],["لا تجعلونا للوعود فريسة","نلْهو بهنَّ، وهنَّ ذرُّ رماد",94,"د",1,0],["لا تجُودي بقطرةٍ، يا فلَسطي","نُ، عليهم، أو نَسمةٍ لا تجودي",95,"د",2,0],["لا تجعلوا سَفكَ الدماء مناقبًا","للفاتحين بل اجعلوه ذنوبا",96,"ب",2,0],["لا تُجهدنَّ الشعر يا نَظامَه","فصفاتُه تُغنيك عن تَوصيفه",97,"ف",2,0],["لا تجمع العدلَ والتسليحَ أنظمةٌ","الا كما جمعوا الجزارَ والغنما",98,"م",2,0],["لا تُجَرّمْ على قِلادِكَ، تَخْتَا","رُ التي في وُقُوعِهَا تَبذيرُهْ",99,"ر",2,0],["لا تجرحي التمثال في إحساسه","فلكم بكى في صمته .. تمثال",100,"ل",1,0],["لا تجعلنا في المهانة آية ً","تخزي الوجوه وفي الجمود مثالا",101,"ل",2,0],["لا تجزعوا للحادثات تصيبكم","وخذوا سبيل الفتية الخنفاء",102,"ا",2,0],["لا تجيئي لموعدي .. واترُكيني","في ضَلالٍ ، يبكي عليه اليقينُ",103,"ن",1,0],["لا تجفونَّ بني تميمٍ إنهمْ","تابُوا النَّصوحَ وَرَاجَعوا حسنَ الهوى",104,"ا",1,0]]}