 على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[468,"دار الصديق إذا تشعب خلقه","https://www.aldiwan.net/poem60409.html","الكامل"],[538,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[538,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[551,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[551,"صبرا ففي الصبر الجميل","https://www.aldiwan.net/poem47185.html","مجزوء الكامل"],[558,"لا تظن الله معنا ها هنا في ذا الوجود","https://www.aldiwan.net/poem34604.html","الرمل"],[562,"لا تجزعوا يا بني العوراء واصطبروا","https://www.aldiwan.net/poem52575.html","البسيط"],[562,"لا تجزعوا يا بني النجار واصطبروا","https://www.aldiwan.net/poem52601.html","البسيط"],[562,"لا تجزعوا يا بني الضباط واصطبروا","https://www.aldiwan.net/poem52604.html","البسيط"],[562,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[562,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"],[562,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[569,"لا تجعلني كأَقوام علمتهم","https://www.aldiwan.net/poem52035.html","البسيط"],[575,"لا تجر دمعا على سعاد","https://www.aldiwan.net/poem2818.html","مخلع البسيط"],[575,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[586,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem17611.html","الكامل"]],"verses":[["لا تَجعَلَنَّ دَليلَ المَرءِ صورَتَهُ","كَم مَخبَرٍ سَمجٍ عَن مَنظَرٍ حَسَنِ",0,"ن",1,0],["لا تَجمَعَنّي وَالزَمانَ فَإِنَّهُ","عَودٌ يَحُكُّ جِرانَهُ بِجِراني",1,"ن",2,0],["لا تَجعَلَنهُ دَيدَناً وَدابا","وافَقَ مِنّا أَجَلٌ كِتابا",2,"ب",2,0],["لا تَجمَعي هَجراً عَليَّ وَغُربَةً","فَالهَجرُ في تَلَفِ الغَريبِ سَريعُ",3,"ع",1,1],["لا تَجزَعي وَاِصطَبِري","لِوَصلِنا وَاِرتَقِبي",4,"ي",1,0],["لاَ تُجَاورْ أَطْنَابَ خَيْمَةِ ظَبْيٍ","فَهَاتِيكَ لِلْقُلُوبِ حِبَالَهْ",5,"ل",2,0],["لا تَجعَلي الواشينَ رُسلَكِ في الهَوى","فَلَأَصدَقُ الرُسُلِ الجَمادُ الناطِقُ",6,"ق",1,0],["لا تَجزَعَنَّ فَلَستَ أَوَّلَ ماجِدٍ","كَذَبَت عَلَيهِ صَحائِفُ الفُجّارِ",7,"ر",1,0],["لا تَجمَعَنَّ عَلَيَّ عَتبِكَ وَالنَوى","حَسبُ المُحِب عُقوبَةً أَن يُهجَرا",8,"ر",2,0],["لاَ تُجِيبِينَ أَدْمُعِي سَائِلاتٍ","وَعَزِيزٌ عَلَىَّ ألاَّ تُبِيِني",9,"ن",2,0],["لا تجزعَنّ فإن خلفك أمةً","تمشي كمشيك للعَلاء وتتبع",10,"ع",1,0],["لا تجعلوا العلم فيها كل غايتكم","بل علّموا النَشء علماً ُينتج العملا",11,"ل",2,0],["لا تَجفُوَنَّ بَني تَميمٍ إِنَّهُم","تابوا النَصوحَ وَراجَعوا حُسنَ الهُدى",12,"ا",1,0],["لا تَجزَعوا أَن تُنسَبوا لِأَبيكُمُ","فَاللُؤمُ يَبقى وَالجِبالُ تَزولُ",13,"ل",1,0],["لا تجعلِ اسميَ للعذَّال منتصباً","فما لتعريف وجدي فيك تنكير",14,"ر",1,0],["لا تجعلنْ بيتَ قلب المستهام ولا","بيتَ التغزُّل باللمياءِ مكسورا",15,"ر",2,0],["لا تجزعنَّ أبا العبَّاس من خطرٍ","عداك فالوقت باكي الفكر باسمه",16,"م",2,0],["لا تَجاهلْ هناك يا من أبي اللَّ","هُ عليه أن يشبه الجُهَلاءَ",17,"ا",2,0],["لا تجهَّمْ بشراء ال","خير واصدِفْ عن بُغاتِهْ",18,"ت",2,0],["لا تجمعنَّ إلى عيبٍ تُعاب به","عَيبَ الخداع فلن تزداد طيبَ نَثَا",19,"ث",2,0],["لا تَجْبُنَنَّ لأن النفس واحدة","فإنما الموت أيضاً واحدٌ فَقَدِ",20,"د",1,1],["لا تجشِمَنْ أهلي إليك وفادةً","لِيَفِدْ عليهمْ برُّك الوَفّادُ",21,"د",1,0],["لا تجعلوا من حديث الناس موعظةً","ولا يزلْ عُرفكم أسمارَ سُمّار",22,"ر",1,0],["لا تَجْعلنّي لما أرى غَرضاً","تلعبُ فيه مَحادِسُ الحُدُس",23,"س",1,0],["لا تجعلنّي قذاةَ الكأسِ مقليةً","بعد اعتداديَ من منفوسِ ريحانك",24,"ك",1,0],["لا تجمعنّ إلى ذكراه نِسبَتَه","فقد كفاكَ مكان النسبةِ ابنُ جلا",25,"ل",2,0],["لا تجمُدا لاتَ حينَ معذرةٍ","ما لم تذوبا لمُستذيبِكما",26,"م",2,0],["لا تجعلنَّك عصبةٌ عن ظِنَّةٍ","حُزْني وأنت سرُورُ كل حزين",27,"ن",1,0],["لا تجشَّم لي التخلُّق إن كنْ","تَ مَلولاً إنَّ التجَشُّم شِقْوه",28,"و",2,0],["لا تجعلنْه كراجي الغيثِ أصعَقَهُ","وإنما أمَّلَ الإسقاءَ راجيه",29,"ي",2,0],["لا تجزعَنَّ من الصدود فإنما","غرض المفَدِّي أن يرى تَيّاها",30,"ا",3,0],["لا تَجزَعي فَالمَوتُ لَيسَ يَضيرُنا","فَلَنا إِيابٌ بَعدَه وَنُشورُ",31,"ر",1,0],["لا تجزعن اذا ما نكبة حزبت","فانما الدهر ارخاء وتشديد",32,"د",1,0],["لا تجزعنّ اذا ما فتنة حدثت","ما انت وحدك بالاضرار مقصود",33,"د",1,0],["لا تَجعَلي حُبَّ القَديمِ وَذِكرَهُ","حَسَراتِ مِضياعٍ وَدَفعَ مُبَدَّدِ",34,"د",1,0],["لا تَجعَلوا الدينَ بابَ الشَرِّ بَينَكُمُ","وَلا مَحَلَّ مُباهاةٍ وَإِدلالِ",35,"ل",1,0],["لا تَجِئها بِالمَتاعِ المُقتَنى","سَرَقاً مِن كُلِّ قَومٍ وَنِهابا",36,"ب",2,0],["لا تُجزِهِم عَنكَ حُلماً وَاِجزِهِم عَنَتاً","في الحِلمِ ما يَسَمُ الأَفعالَ أَو يَصِمِ",37,"م",1,0],["لا تَجعَلوهُ هَوىً وَخُلقاً بَينَكُم","وَمَجَرَّ دُنيا لِلنُفوسِ وَمَتجَرا",38,"ر",2,0],["لا تَجزِني بِضَناً بي بَعدَها بَقَرٌ","تَجزي دُموعِيَ مَسكوباً بِمَسكوبِ",39,"ب",1,0],["لا تَجسُرُ الفُصَحاءُ تُنشِدُ هَهُنا","بَيتاً وَلَكِنّي الهِزَبرُ الباسِلُ",40,"ل",1,0],["لا تَجِدُ الخَمرَ في مَكارِمِهِ","إِذا اِنتَشى خَلَّةً تَلافاها",41,"ا",3,0],["لا تجمعوا لغةَ النبيطِ وتيهَكُم","وأُصولَكُم وأسامِيَ الأشرافِ",42,"ف",1,0],["لا تجزعَنْ إنْ فات ما رُمْتَهُ","واشْدُدْ عُرَى عزمِكَ بالصَّبْرِ",43,"ر",1,1],["لا تَجَرَّم عَلى تِلادِكَ تَختا","رُ الَّتي في وُقوعِها تَبذيرُه",44,"ر",2,0],["لا تَجمَعَنَّ عَلَينا رِدَّةً وَبَذا","قَولٍ فَذَلِكَ سوءُ الكَيلِ وَالحَشَفُ",45,"ف",1,0],["لا تُجاوِز مِقدارَ سَطوِكَ إِن لَم","تَتَطَوَّل بِالصَفحِ مِقدارَ جُرمي",46,"ي",1,0],["لاتُجزَيَنَّ أَبا عُبَيدَةَ صالِحاً","عَن طولِ وَقفَتِنا بِقِنَّسرينا",47,"ن",2,1],["لا تَجبُرُ الأيَّامُ كَسْرَ عِصابةٍ","كُسِرَتْ وذَلَّ بجابرٍ جَبَّارُها",48,"ر",3,0],["لا تَجزَعَنَّ مِنَ الحَوادِثِ إِنَّما","خَرقُ الرِجالِ عَلى الحَوادِثِ يُجزِعُ",49,"ع",1,0],["لا تَجزَعَنَّ إِذا نابَتكَ نائِبَةٌ","واصبر ففي الصّبر عند الضّيقِ متَّسعُ",50,"ع",1,1],["لا تَجعَلَنَّ المالَ كَسبَكَ مُفرَداً","وَتُقى إلَهَكَ فَاِجعَلَن ما تَكسِبُ",51,"ب",1,0],["لا تَجزَعَنَّ فَمَن تَعَت","تَبَ دامَ وَصلُ تَعَتُّبِه",52,"ب",2,0],["لا تَجتَني الطَيِّباتِ يَوماً مِنَ ال","غَرسِ يَدٌ كانَ غَرسُها الحَسَكا",53,"ك",2,0],["لا تَجنَحَنَّ إِلى حَيٍّ تُمايِلُهُ","وَإِن جَنَحتَ إِلَيهِ فَاِتَّخِذ نَفَقا",54,"ق",2,0],["لا تَجزَعَنَّ إِذا اِرتاعوا لِرائِحَةٍ","بِفيكَ ل