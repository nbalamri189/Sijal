{"poems":[[52,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[358,"قل لي سمي أمير المؤمنين لما","https://www.aldiwan.net/poem40151.html","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216391",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135751","الرجز"],[6038,"العيد الوطني للملكة 1422ه","https://www.poetsgate.com/ViewPoem.aspx?id=25699",""]],"verses":[["وَلَم بايدَ نَسِياً","وَلا هَوى لِلنُصُبِ",0,"ب",1,0],["وَلِم بخلت عَلَينا يا عَليُّ بِهِ","ما كانَ يدعى بَخيلا بِالعَطاء علي",1,"ي",1,0],["ولم بشرِّ العنا تُسقطهُ زلَّتُهُ","ترميه في دركاتٍ أَيهَ نهضتُهُ",2,"ه",1,0],["وَلّم بدوره للهدد كل صقّار","بْحُرّ أدنى للقَنَص من مخابيه",3,"ي",2,0],["ولُمَّ باللام عليَّ الخيرا","واجعل له إليَّ ربي سيرا",4,"ر",2,0],["ولمبادي صقر الجزيرة الأبي ثبتّ وأرسيت","خفاق أخضر علمها دولتك مستقله",5,"ل",2,0]]}