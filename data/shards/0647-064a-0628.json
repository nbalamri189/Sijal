poetsgate.com/ViewPoem.aspx?id=194897",""],[5956,"عزرائيل هو إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=215497",""],[5957,"قد صار باب الحب عني موصدا","https://www.poetsgate.com/ViewPoem.aspx?id=30632",""],[6066,"يَومَ عُرسُكِ يَا أَرِيج","https://www.poetsgate.com/ViewPoem.aspx?id=12670",""],[6093,"(أوجزتُ كلَّ قضيتي في المطلعِ)*","https://www.poetsgate.com/ViewPoem.aspx?id=205546",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""],[6115,"الغيض للنسوان ماهو للرجال","https://www.poetsgate.com/ViewPoem.aspx?id=181764",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[496,"أسمى الذي تصبو به العشاق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599211",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[119,"يا نبيا علا على الأنبياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55610&r=&rc=7",""],[6262,"الرجفةُ تبدأُ من يدِها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80104&r=&rc=2",""],[572,"بَرَزَتْ وأترابٌ لها عُرُبٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9273&r=&rc=130",""]],"verses":[["هَيبَةً مِن جَلالِها مِثلَ ما يُق","صِرُ مِن دونِ والِدٍ مَولودُ",0,"د",1,0],["هِيَ بَعضُ اِسمِ مَن أُحِبُّ وَلاءً","وَبِتَكريرِ بَعضِها يَستَتِمُّ",1,"م",1,0],["هِيَ بِاليَرَاعَةِ وَالصَّحِيفَةِ قَدْ","أَغْنَتْ غَنَاءَ السَّيْفِ وَالعَلَمِ",2,"م",1,0],["هِيبَتْ لقومٍ شرَّةٌ فاجْتبُوا","ولم يَهَبْ شِرَّتَنا هائبُ",3,"ب",1,0],["هَيْبَةً منهُمُ لحربي كما ها","بَ شبا الأجدَلِ القطا الأُسْرُوبُ",4,"ب",1,0],["هيبتُه قارعةٌ للأكبادْ","يفْلِقُ أرواحَ العدا في الأجسادْ",5,"د",1,0],["هي بالليل كلُّ شخصٍ تراه","ماثلاً في الظلام كالجرثوم",6,"م",1,0],["هيبةً للأَمير ما منْ عرتْهُ","بِمَلومٍ ملامة الهَيَّبانِ",7,"ن",1,0],["هي بنتٌ ولدتُماها جميعاً","فلَه حَمْلُها ومِنْك المنيُّ",8,"ي",1,0],["هِيَ بَلقيسُ في الخَمائِلِ صَرحٌ","مِن عُبابٍ وَصاحَت غَيرُ نِكسِ",9,"س",1,0],["هي بعضُ أقراني وقد عرفتْ","صبري الجميلَ وأنكرتْ مَسِّي",10,"س",2,0],["هِيَ بِكرٌ زُفَّت إِلَيكَ عَروساً","وَلَها عِندَكَ الصَداقُ الجَزيلُ",11,"ل",1,0],["هِيَ بَيعَةُ الرِضوانِ يُشرَعُ وَسطَها","بابُ السَلامَةِ فَاِدخُلوا بِسَلامِ",12,"م",1,0],["هي بيضٌ أم أعينُ البيضِ أمستْ","تتصدَّى لصيدِ أُسْدِ العرينِ",13,"ن",1,0],["هي بَيْعَةُ الرضوانِ لم تتركْ لهم","ليلاً يُنامُ ولا صَبَاحاً ينعمُ",14,"م",1,0],["هَيبَةٌ لَو لَم يَغتَدِ بِسِواها","لَعَنَت دونَها القَنا الخَطّارُ",15,"ر",1,0],["هي بغْيَةٌ أضْلَلْتُموها فارْجِعوا","في آلِ ياسِينٍ ثَوَتْ ياسِين",16,"ن",1,0],["هِيَ بَدرُ السَماءِ لا بَل هِيَ الشَم","سُ تَدَلَّت في مُذهَبٍ وَجِسادِ",17,"د",1,0],["هي بنتُ السماءِ وهو من الأرض","سليلٌ نما الترابُ عظامَه",18,"م",2,0],["هِيَ بَلْدَةٌ صِدْقُ العَزِيمَةِ شادَهَا","كمْ لِلْعَزِيمَةِ آيَةٌ إِنْ تَصْدُقِ",19,"ق",1,0],["هيَ بَدْءُ عَهْدٍ لِلْعُرُوَبةِ مُقْبِلٌ","كَبَدِيلِ مِنْ عَهْدِ الشَّتَاتِ المُدْبِرِ",20,"ر",1,0],["هِيَ بِكْرُ الْوُجُودِ لاَ يَتَمَلَّى","مُجْتلاَهَا إِلاَّ شهُودُ البُكُورِ",21,"ر",1,0],["هِيَ بِيعَةٌ شِيدَتْ عَلَى أُسُسِ الْهُدَى","مِنْ فَضْلِ خَيْرِ مُشَيِّدٍ وَمُؤَسِّسِ",22,"س",1,1],["هِيَ بِالْكَمَالِ فَرِيدَةٌ يَزْهَى بِهَا","عَقْدُ اللَّداتِ وَدُرُّهُ مُخْتَارُ",23,"ر",1,0],["هِيَ بَيْنَ الْحِسَانِ زَهْرَةُ أُنْسٍ","حُسْنُهَا بِالْحَيَاءِ مِنْهَا مُسَيَّجْ",24,"ج",1,0],["هِيَ بَضْعَةٌ لشَقيَّةٍ","زَلاّءُ مَا كَانَتْ بِعَاقرْ",25,"ر",1,0],["هِيَ بُسْتَانهُ فَغَرَّدَ فِيهِ","وحَبَا كُلَّ قَلْبِهِ بُسْتانَه",26,"ن",2,0],["هي بِنْيَةٌ قامتْ بغير دعامةٍ","هي دولة قد أنْشِئَتْ لتزولا",27,"ل",2,0],["هِيَ بَكْرٌ زُفَّتْ إِليْكَ عَرُساً","وَلَهَا عِنْدَكَ الصَّدَاقُ الجَزِيلُ",28,"ل",1,0],["هِيبَتْ لقومٍ شرَّة ٌ فاحْتبُوا","ولم يَهَبْ شِرَّتَنا هائبُ",29,"ب",1,0],["هِيَ بَلقيسُ في الخَمائِلِ صَرحٌ","مِن عُبابٍ وَصاحَبٌ غَيرُ نِكسِ",30,"س",1,0],["هِيَ بَعض وَصفِكَ وَالخَلائق كُلَها","تَثني عَلى مَجد لَدَيك مُنيف",31,"ف",1,0],["هيبة حفها شموس شؤن","رصعت بالمريخ والميزان",32,"ن",1,0],["هيبة الحق قر في كل قل","شأنه فانجلى بسر علاء",33,"ا",2,0],["هي بزتني الشباب فقد","صارَ في أجفانِها كحلا",34,"ل",2,0],["هي بهجةٌ للناظرين وسَلْوَةٌ","لِلْهَمِّ وهي الرَّوضةُ الغَنَّاءُ",35,"ا",2,0],["هي بيعةٌ أحيا الإلهُ بها الورى","وحمى بها دينَ النيبِّ المُصطفى",36,"ف",2,0],["هيبةُُ الوجهِ وإجلالُ المحيّا","هيبة ٌ تُربكُ جلاداً عتيّا",37,"ي",2,0],["هيَ بَلدةٌ للنصرِ والأنصارِ","دارُ الهدى أكرم بها من دارِ",38,"ر",1,0],["هيَ بَدرٌ والفتحُ شمسٌ وباقي ال","غَزَوات النجوم والأضواءُ",39,"ا",2,0],["هيَ بالأمس غادةٌ ذات دلّ","يملأ النفس غبطة مرآها",40,"ا",3,0],["هي بالأمس وردةٌ تنعش الأرواح","بل يسكر القلوب شذاها",40,"ا",3,0],["هي بالأمس دمية تبعث الإيمان","بالقلب جلّ من سوّاها",40,"ا",3,0],["هي بعض تاريخ البلاد فلم تكن","تاريخ فرد ينطوي ويثار !",41,"ر",1,0],["هِيَ بِنتُ فِكري وَالكَريمُ يَغارُ أَن","تُهدى إِلى غَيرِ الكَريمِ بَناتُهُ",42,"ت",2,0],["هِيَ بَعضُ لَيلاتٍ بَهيَّاتٍ بها","حيَّا النفوسَ وطالما أحياها",43,"ا",3,0],["هِيَ بَعلَبَكُّ سَمَت بِمَجدِ الدينِ بَه","رَم شاهَ دانَ لِشَأوِهِ بَهرامُ",44,"م",1,0],["هَيبَتُهُ تَكادُ تَغنيهِ لَدى ال","رَوعِ عَنِ اِستِظهارِهِ بِالجُندِ",45,"د",1,0],["هيَ بلا اِشتباهِ","أُخوَّةٌ في اللَهِ",46,"ه",1,0],["هي بهجتي هي وجهتي هي قبلتي","في حين أسجد للإله الغافر",47,"ر",1,0],["هِيَ بَيت القَصيد من ذلِك","الفَن وَقطب التوشيح وَالتَوشيع",48,"ع",1,0],["هي بَحر من البَلاغَة عَذب","فَاِعتَرَف وَاِغترف بِمَرعى مريع",48,"ع",1,0],["هَيبَتُهُ تُغمِدُ أَسيافَهُ","وَرُبَّ جُرحٍ لَيسَ في الأَحشا",49,"ش",2,0],["هي بالطبيعة أمُّه حقّاً وهوْ","منها بنعمته أبوها المُنعِم",50,"م",1,0],["هي بكرٌ وفي البكارة أم","يا إمام الهداة زدني شرحا",51,"ح",2,0],["هيبة لله في مطلعه","ملأت قلب الأَعادي رعبا",52,"ب",2,0],["هي بشرى الإسلام والأيّام","والليالي والدهر والأعوام",53,"م",1,1],["هي بعضُ وجدانِ الوجودِ يَزفه","حُبَّاً لمن هو أطلعَ الإنجيلا",54,"ل",2,0],["هيَ بي وَلوعَةِ مُهجتي أدرَى","وبكلِّ ما ألقاهُ من مِحنِ",55,"ن",1,0],["هي بين الضلوع جذوة نارٍ","وخلالَ الأجفان مزنة ماءِ",56,"ا",2,0],["هي بهجة الأكوان والكنز الذي","فاق الكنوز بغنجه وشمائله",57,"ل",2,0],["هيبة تملأ الصدور ولكن","أين فيها تواضع العباد",58,"د",1,0],["هي بحر وما سواها فموج","وهي خمر والعالمون حباب",59,"ب",1,0],["هيبةٌ في وَداعةٍ وانبِساطٌ","في وَقارٍ ورِقَّةٌ في شهامَهْ",60,"م",2,0],["هي بَدْرُهُنّ وَهُنّ أنْجُمُهَا","فَعَلاَمَ لا أتَخَيّرُ القَمَرَا",61,"ر",2,0],["هي بدرٌ وإن أحسنَ لونٍ","ظهر البدرُ فيه لونُ السماءِ",62,"ا",2,0],["هيبةٌ تملأُ القلوبَ فَقَلبُ ال","دَّهرِ مِنه مُروَّعٌ رِعْدِيدُ",63,"د",1,0],["هَيبةٌ أَرْغَبت صروفَ اللَّيالِي","فَهِي منها مَنصورةٌ بالرُّعب",64,"ب",1,0],["هي بنا نسعى معاً بهمة","ينحط عنها النجم في مقامه",65,"م",2,0],["هيَ بنت الكرام آل طبا من","هم من اللّه علّة الإيجادِ",66,"د",1,0],["هيبةٌ تَقتُلُ العَدُوَّ بلا طَع","نِ قناةٍ ولا صفاحَ صِفاح",67,"ح",1,0],["هيَ بينَ النسآءِ كالوردِ بينَ ال","زهرِ جلَّت فقلَّت النُّظَرآءُ",68,"ا",2,0],["هِيَ بضعة الشهم المؤيد حيدر","عالي الذرى صَدر الصُدور الناصح",69,"ح",1,0],["هِيَ بِالحَمد حَرِيهْ","دائِماً في كُل عَصرِ",70,"ر",1,0],["هي بيعة الرضوان تحيي كل من","أصفى ويقتل سيفها من خلطا",71,"ط",2,0],["هيَ بشرى دعت جميع العباد","للتمادي على صريح الوداد",72,"د",1,1],["هي باللثم حطيم","مدة العام وكعبه",73,"ب",2,0],["هي بضعة مني ففي أضرارها","ضري كما تبجيلها تبجيلي",74,"ل",2,0],["هي بين الرياض قطرة مزن","قد تدلت من تحت غصن تدلى",75,"ل",2,0],["هي بالود منك أولى فمن ذا","بعدها يستحق حفظ الوداد",76,"د",1,0],["هي بالجودِ لأجزالِ الحَبا","كَعبةٌ تعتادُها الوفد استلاما",77,"م",2,0],["هي باحةُ الشرف المقدَّسة التي","ولدت بها منك العُلى أشرافَها",78,"ف",3,0],["هي بالزفير إليك ذاتُ بوارقٍ","ومن الحنين عليك ذاتُ رعود",79,"د",1,0],["هي بنت وهي أخت برةٌ","وهي زوجٌ وهي أمٌ نافعة",80,"ع",2,0],["هي بنت كناصع الثلج ذكرا","ها وفي الصّدر نفحة الأزهار",81,"ر",1,1],["هي بنتٌ لكم وأختٌ وزوجٌ","وهي أمٌّ يطيب فيها بنوها",82,"و",3,0],["هي بضعة من خمسة","وصلت بأصحاب العباء",83,"ا",2,0],["هيبةٌ خرَّتِ الجبالُ لديها","ساجداتٍ وكبرَ المشرقانِ",84,"ن",1,0],["هيبةٌ ترجفُ العوالم منها","وجلالٌ أحاطَ بالأكوانِ",84,"ن",1,0],["هي بيننا وتظل دهراً بعدنا","وهي التي شهدت ضحى الطوفانِ",85,"ن",1,0],["هيبةُ الملك تجلت","حين حيَّاها الوجود",86,"د",1,0],["هيب الغرام فَكُن إن حلّ ذا وجل","كم باسل منه داهي الطرف داميه",87,"ي",2,0],["هي بي إن كنت خوبست","خذ عمود النور فيكست",88,"ت"