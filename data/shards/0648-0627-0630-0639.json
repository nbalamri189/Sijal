{"poems":[[53,"ذكرتك لما طبق الأفق عارض","https://www.aldiwan.net/poem30131.html","الطويل"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[70,"لما التحى وتبدلت","https://www.aldiwan.net/poem42860.html","مجزوء الكامل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"]],"verses":[["وَإِذ عَيشُنا الرَقراقُ يُسبِغُ خَفضَه","عَلينا وَإِذ طَيرُ النَعيمِ وُقوعُ",0,"ع",1,0],["وأذعَرُ بالعِزِّ الإِمامِيِّ صَرْفُهُ","مَخافَةَ أنْ يَقتادَ جاريَ عانِيا",1,"ي",2,0],["وَأَذَعتُ عَنهُ بِأَنَّهُ","لَم يَقصِدِ القَصدَ الخَسيسا",2,"س",2,0],["وَإِذ عِلمُ مَجلِسِهِ مَورِدٌ","زُلالٌ لِتِلكَ العُقولِ الظِماءِ",3,"ا",2,0],["وأذعتُه نبأً لكم ما مثله","نبأٌ يُذاعُ ولا حديثٌ يُنقلُ",4,"ل",1,0],["وأذعتَ دعوتَها وجُزْتَ بصوتِها","في المغْرِبينِ شوامخَ الأطوادِ",5,"د",1,0],["وإذ على آثاره خيل العرب","وخيله من هرب إلى هربْ",6,"ب",1,0]]}