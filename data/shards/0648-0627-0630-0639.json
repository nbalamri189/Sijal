{"poems":[[53,"ذكرتك لما طبق الأفق عارض","https://www.aldiwan.net/poem30131.html","الطويل"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[70,"لما التحى وتبدلت","https://www.aldiwan.net/poem42860.html","مجزوء الكامل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[100,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[116,"أنا من تسمع عنه وترى","https://www.aldiwan.net/poem42905.html","الرمل"],[134,"بسيفك صال الدين في الشرق والغرب","https://www.aldiwan.net/poem4252.html","الطويل"],[151,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[276,"لله قلعة بيران وعزتها","https://www.aldiwan.net/poem25443.html","البسيط"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[454,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[459,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[462,"تأرج عرض الدهر من نشر منطقي","https://www.aldiwan.net/poem16146.html","الطويل"],[552,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[568,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"]],"verses":[["وَإِذ عَيشُنا الرَقراقُ يُسبِغُ خَفضَه","عَلينا وَإِذ طَيرُ النَعيمِ وُقوعُ",0,"ع",1,0],["وأذعَرُ بالعِزِّ الإِمامِيِّ صَرْفُهُ","مَخافَةَ أنْ يَقتادَ جاريَ عانِيا",1,"ي",2,0],["وَأَذَعتُ عَنهُ بِأَنَّهُ","لَم يَقصِدِ القَصدَ الخَسيسا",2,"س",2,0],["وَإِذ عِلمُ مَجلِسِهِ مَورِدٌ","زُلالٌ لِتِلكَ العُقولِ الظِماءِ",3,"ا",2,0],["وأذعتُه نبأً لكم ما مثله","نبأٌ يُذاعُ ولا حديثٌ يُنقلُ",4,"ل",1,0],["وأذعتَ دعوتَها وجُزْتَ بصوتِها","في المغْرِبينِ شوامخَ الأطوادِ",5,"د",1,0],["وإذ على آثاره خيل العرب","وخيله من هرب إلى هربْ",6,"ب",1,0],["وإذعاننا جرّأ المفسدين","علينا وأغراهم المأثمُ",7,"م",1,0],["وَأَذَعتُم عَن فُؤادي سَلوَةً","إِنَّ هَذا لَحَديثٌ مُفتَرى",8,"ر",2,0],["وأذعنَ ناءٍ واستقامَ مُعانِدٌ","ولان قياداً كُلُّ مُمتَنِعٍ صَعبِ",9,"ب",1,0],["وأذعنت البلادُ له","ولم تصرم لها شعب",10,"ب",1,0],["وَإِذ عجَزت عنهُ صناعةُ طبّهم","أَجابوا نَعم فوقَ الصناعةِ قَد يَبرا",11,"ر",2,0],["وَأَذْعَنَتْ وَهيَ الشمَّاءُ ذُرْوَتُها","عَلَى حجَاجٍ لهَا مِنْ قَبْلُ مَذْكورِ",12,"ر",1,0],["وَإِذ عَلِمتُ بانَ الحَقُّ جَوهَرُها","لا تُعجِبَن لِحَسودٍ قامَ يُنكِرُها",13,"ه",2,0],["وأَذعَنَ صرفُ الدَّهْرِ سمعاً وطاعةً","لما فُهْتَ من قولٍ وأَمضَيْتَ من فعلِ",14,"ل",1,0],["وإذ عرضت لبيع كل ما ملكت","يدي خذلت كما قد ضيعوا داري",15,"ر",2,0],["وأذعنتْ طائعةً مختارةً","بميلها إليك وانقيادِها",16,"د",3,0],["وأذْعن من عُلْيا كُلَيبٍ ودارمٍ","فرزْدَقُها حامي الحمى وجريرها",17,"ر",3,0],["وَإِذ علّنِي مِن ريقهِ ثم علّنِي","عَلى ظمإٍ مُستعذَبُ الرّيق أشنبُ",18,"ب",1,0],["وَإِذْ عُذْرِي وَاضِحٌ بِالشَّبَابِ","وَسُكْرِي بِهِ مِنْ أَشَدَّ الشُّكَرْ",19,"ر",1,0]]}