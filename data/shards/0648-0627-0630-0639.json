{"poems":[[55,"ذكرتك لما طبق الأفق عارض","https://www.aldiwan.net/poem30131.html","الطويل"],[65,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[72,"لما التحى وتبدلت","https://www.aldiwan.net/poem42860.html","مجزوء الكامل"],[46,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[102,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[119,"أنا من تسمع عنه وترى","https://www.aldiwan.net/poem42905.html","الرمل"],[137,"بسيفك صال الدين في الشرق والغرب","https://www.aldiwan.net/poem4252.html","الطويل"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[280,"لله قلعة بيران وعزتها","https://www.aldiwan.net/poem25443.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[445,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[458,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[463,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[466,"تأرج عرض الدهر من نشر منطقي","https://www.aldiwan.net/poem16146.html","الطويل"],[556,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[572,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122573","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44777","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119865","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64883","الهزج"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79396","الوافر"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19972","الرجز"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111279","الطويل"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198294","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65112","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86335","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91725","الرجز"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126513","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54495","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205460","الوافر"],[4119,"تفي بضمانها البيض الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=16114",""],[5038,"جرح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=189582",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5246,"أرقا أُعايشُ والفراق يؤرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187072",""],[402,"أدار العدل ما أنساك دهري","https://www.poetsgate.com/ViewPoem.aspx?id=35544",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["وَإِذ عَيشُنا الرَقراقُ يُسبِغُ خَفضَه","عَلينا وَإِذ طَيرُ النَعيمِ وُقوعُ",0,"ع",1,0],["وأذعَرُ بالعِزِّ الإِمامِيِّ صَرْفُهُ","مَخافَةَ أنْ يَقتادَ جاريَ عانِيا",1,"ي",2,0],["وَأَذَعتُ عَنهُ بِأَنَّهُ","لَم يَقصِدِ القَصدَ الخَسيسا",2,"س",2,0],["وَإِذ عِلمُ مَجلِسِهِ مَورِدٌ","زُلالٌ لِتِلكَ العُقولِ الظِماءِ",3,"ا",2,0],["وأذعتُه نبأً لكم ما مثله","نبأٌ يُذاعُ ولا حديثٌ يُنقلُ",4,"ل",1,0],["وأذعتَ دعوتَها وجُزْتَ بصوتِها","في المغْرِبينِ شوامخَ الأطوادِ",5,"د",1,0],["وإذ على آثاره خيل العرب","وخيله من هرب إلى هربْ",6,"ب",1,0],["وإذعاننا جرّأ المفسدين","علينا وأغراهم المأثمُ",7,"م",1,0],["وَأَذَعتُم عَن فُؤادي سَلوَةً","إِنَّ هَذا لَحَديثٌ مُفتَرى",8,"ر",2,0],["وأذعنَ ناءٍ واستقامَ مُعانِدٌ","ولان قياداً كُلُّ مُمتَنِعٍ صَعبِ",9,"ب",1,0],["وأذعنت البلادُ له","ولم تصرم لها شعب",10,"ب",1,0],["وَإِذ عجَزت عنهُ صناعةُ طبّهم","أَجابوا نَعم فوقَ الصناعةِ قَد يَبرا",11,"ر",2,0],["وَأَذْعَنَتْ وَهيَ الشمَّاءُ ذُرْوَتُها","عَلَى حجَاجٍ لهَا مِنْ قَبْلُ مَذْكورِ",12,"ر",1,0],["وَإِذ عَلِمتُ بانَ الحَقُّ جَوهَرُها","لا تُعجِبَن لِحَسودٍ قامَ يُنكِرُها",13,"ه",2,0],["وأَذعَنَ صرفُ الدَّهْرِ سمعاً وطاعةً","لما فُهْتَ من قولٍ وأَمضَيْتَ من فعلِ",14,"ل",1,0],["وإذ عرضت لبيع كل ما ملكت","يدي خذلت كما قد ضيعوا داري",15,"ر",2,0],["وأذعنتْ طائعةً مختارةً","بميلها إليك وانقيادِها",16,"د",3,0],["وأذْعن من عُلْيا كُلَيبٍ ودارمٍ","فرزْدَقُها حامي الحمى وجريرها",17,"ر",3,0],["وَإِذ علّنِي مِن ريقهِ ثم علّنِي","عَلى ظمإٍ مُستعذَبُ الرّيق أشنبُ",18,"ب",1,0],["وَإِذْ عُذْرِي وَاضِحٌ بِالشَّبَابِ","وَسُكْرِي بِهِ مِنْ أَشَدَّ الشُّكَرْ",19,"ر",1,0],["وأذعنت فِرقُ الإشراكِ واعتقدت","بالسيف ما لم يكن بالحقِّ يُقتصَد",20,"د",1,0],["وَإِذ عتاقُ العُربُ تورى في الدُجى","قَدحاً وَتَصهَلُ تَحتَ كُلِّ غَضَنفَرِ",21,"ر",1,0],["وأذعنت البرية واستقادت","لأروع أمره المعتوم أمرُ",22,"ر",1,0],["وإِذ عِطفُكَ مُخْتالٌ","وميّالٌ على عِطْفي",23,"ف",2,0],["وأذعنَ للهوى القلبُ المعنَّى","كإذعانِ الشبيبةِ للمشيبِ",24,"ب",1,0],["وَأَذعَرُ الرَبرَبَ عَن أَطفالِهِ","بِأَعوَجِيٍّ دُلَفي المُنتَسَب",25,"ب",1,0],["وأذعنتم وقد حَزَّت ظباها","بأيدنا عليكم كارهينا",26,"ن",2,0],["وإذ عطلت منه المدارس أرخوا","تعطل درس العلم بعد سليمان",27,"ن",1,0],["وأذعر منه هيبة وهو المنى","كما يذعر المخمور أوّل كاس",28,"س",1,0],["وأذعت حلمك في الورى حتّى غدوا","يتقرّبُون لكم بكلّ جناية",29,"ه",1,0],["وَاِذ عادَ لي بِالوَصلِ قَد قُلتُ هاتِفاً","أَيا نَفسُ طيبي بِالهَنا في الهَوى وَاصفي",30,"ي",1,0],["وَإِذ عشقت لَيتني","عَنهمو لَم أفرّق",31,"ق",1,0],["واذ علا نوره مرآة خاطره","فمثله قد تراءى وصف من هبطا",32,"ط",2,0],["وأَذْعَنَتْ واستقادتْ","مُنىً لنا قد نَشَزْنا",33,"ن",2,0],["وَأَذعَنَ الطَّودُ لِطَودٍ باذِخٍ","اَشَمَّ يُستَذرى بِهِ ويُحتَمى",34,"ا",1,0],["واذعر أن دعيت لعبد شمسٍ","وقد أمسكت بالحرم الصواري",35,"ر",2,0],["وأذعنت الممالك واستجابت","ملبية لدعوتك العباد",36,"د",1,0],["وَأَذَعْتَ سِرّي وَالمُنى","وَنَشَرْتَ ذاكَ عَلى حِبالِكْ",37,"ك",1,0],["وإذ عظم المسرى قريش وكذبوا","وعاد من الإسلام من عبد الحر ما",38,"م",2,0],["وأذع سلامي للأحبة ناقلاً","عني أحرَّ مشاعرٍ تتدفق",39,"ق",1,0],["وإذ عصفت عواصفهم بشر","وقتنيها يد سبقت بخير",40,"ر",1,0],["وإذ عُذْرِيَ واضحٌ بالشّبابِ","وسُكريَ فيهِ أشّدَ السّكرْ",41,"ر",1,0]]}