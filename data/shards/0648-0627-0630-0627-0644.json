 من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5442,"كل يوم تنوي الرحيل مرارا","https://www.poetsgate.com/ViewPoem.aspx?id=114780",""],[5459,"الحبيب الصدوق","https://www.poetsgate.com/ViewPoem.aspx?id=196699",""],[5536,"بعد أن ضاقت بي","https://www.poetsgate.com/ViewPoem.aspx?id=37056",""],[5550,"عاملِ الناسَ","https://www.poetsgate.com/ViewPoem.aspx?id=214056",""],[5596,"غزة فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=205674",""],[5616,"خيام","https://www.poetsgate.com/ViewPoem.aspx?id=203428",""],[5628,"في محراب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=178542",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5751,"إطلالة","https://www.poetsgate.com/ViewPoem.aspx?id=214789",""],[5751,"ليالي سَجاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=214792",""],[2546,"تَحَبَّبْ فإنَّ الحبَّ داعية ُ الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=17526",""],[5809,"شهادة","https://www.poetsgate.com/ViewPoem.aspx?id=205325",""],[5939,"تحذير شديد اللهجة لحبيبتي المتمردة","https://www.poetsgate.com/ViewPoem.aspx?id=178582",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6102,"العراب","https://www.poetsgate.com/ViewPoem.aspx?id=182907",""],[6115,"رجل كما الصقر يطلع فوق","https://www.poetsgate.com/ViewPoem.aspx?id=181733",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6225,"العروبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80915&r=&rc=184",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[6277,"شرب فطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64450&r=&rc=13",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["وَإِذا لَم تَدرِ ما قَومٌ مَضوا","فَسَلِ الآثارَ وَاِستَنبِ الدِيارا",0,"ر",2,0],["وَإِذا لَطَفتُ لَهُنَّ قالَ عَواذِلي","ذِئبُ الغَضاةِ يُريغُ وُدَّ الرَبرَبِ",1,"ب",1,0],["وَإِذا لَم أَرَ سِحراً ساعَةً","عَبِثَ الشَوقُ بِدَمعي فَاِنسَكَب",2,"ب",1,0],["وإذا لمْ يكُنْ لذالِكَ رسْمٌ","قائِمٌ تِلْكَ حالَةٌ خفِيّهْ",3,"ه",1,0],["وَإِذا لَنا نامورَةٌ","مَرفوعَةٌ لِشَرابِها",4,"ب",3,0],["وَاِذا لا تَرَى في النَاسِ شَيئًا يَفوقُها","وَفِيهِنَّ حُسنٌ لَو تَأَمَّلتَ مَجنَبُ",5,"ب",1,0],["وَإِذا لَقيتَ عَلى زَرودَ مُجاشِعاً","تَرَكوا زَرودَ خَبيثَةَ الأَعطانِ",6,"ن",1,0],["وَإِذا لَقيتَ بَني خَضافِ فَقُل لَهُم","يَومُ الزُبَيرِ كَسا الوُجوهَ غُبارا",7,"ر",2,0],["وَإِذا لَقيتَ قُرومَ فَرعَي خِندِفٍ","يَبذَخنَ بَعدَ تَزايُفٍ وَتَخاطُرِ",8,"ر",1,0],["وإذا لبسْنَ خلاخِلاً","كذَّبْن أسماء الخلاخلْ",9,"ل",1,0],["وإذا لم تَحِنْ محائنُ قومٍ","فلماذا تجري نحوسُ النجوم",10,"م",1,0],["وأذالت من وشْيها كُلَّ بُردٍ","كان قِدماً تصونُه في الصِّوان",11,"ن",1,0],["وإذ المشيبُ شبيبةٌ منضورةٌ","وإذ المواعظُ كلُّهُنَّ مَلاه",12,"ه",1,0],["وَإِذا لَم يَكُن عَفافٌ وَفِسقٌ","لَم تَكُن حِشمَةٌ وَلا اِستِحياءُ",13,"ا",2,0],["وَإِذا لَم تُبصِرِ النَفسُ المُنى","في الضُحى كَيفَ تَراها في مَساها",14,"ا",3,0],["وإذا لم يرقك منه بياني","فاستمع ما تقول مني الدموع",15,"ع",1,0],["واذا لم يكن اتى عن شعور","فهو غث من الطلاوة غار",16,"ر",1,0],["وإذا لم تزد على ما بنى الأو","ل شيئا فلست للفن ركنا",17,"ن",2,0],["وإذا لم يكن ثوابك للغر","س فلا خير للجَنىَ في ثوابك",18,"ك",1,0],["وَإِذ النَفسُ أُنهِضَت مِن مَريضٍ","دَرَجَ البُرءُ في قُوى جُثمانِه",19,"ن",2,0],["وَإِذا لَقوا جَيشاً تَيَقَّنَ أَنَّهُ","مِن بَطنِ طَيرِ تَنوفَةٍ مَحشورُ",20,"ر",1,0],["وَإِذا لَم تَسِر إِلى الدارِ في وَق","تِكَ ذا خِفتُ أَن تَسيرَ إِلَيكا",21,"ك",2,0],["وَإِذا لَم تَجِد مِنَ الناسِ كُفواً","ذاتُ خِدرٍ أَرادَتِ المَوتَ بَعلا",22,"ل",2,0],["وَإِذَ الأَرضُ أَظلَمَت كانَ شَمساً","وَإِذا الأَرضُ أَمحَلَت كانَ وَبلاً",22,"ل",2,0],["وَإِذا لَم يَكُن مِنَ المَوتِ بُدٌّ","فَمِنَ العَجزِ أَن تَكونَ جَبانا",23,"ن",2,0],["وَإِذا لَم يُكرِمِ النا","سَ امرُؤٌ لَم يُكرِموهُ",24,"و",2,0],["وإذ الأرض قد تضوع منها","عن ثراها النديّ عطر الصباح",25,"ح",1,0],["وإذا لَمْ يَصِحَّ بالْعِلْمِ ذَوْقُ","وُجِدَ الشَّهْدُ مِنَ الجَهْلِ صابا",26,"ب",2,0],["وإذِ العِراصُ تبيتُ يَسحَبُ لأمَةً","فيها ابنُ هَيْجاءٍ ويصفِنُ صاهل",27,"ل",1,0],["وَإِذا لُصوصُ الأَرضِ أَعيَت والِياً","أَلقى السُؤالَ بِها عَلى تُوّابِها",28,"ب",3,0],["وَإِذا لَم تَنَل يَداكَ اِغتِصابي","رامَتا بِالخِداعِ كَيدي وَخَلسي",29,"س",2,0],["وَإِذالَةُ الإِنسانِ لَيسَ بِمانِعٍ","مِنها تُحَرِّزُهُ بِدِرعٍ ذائِلِ",30,"ل",1,0],["وإذا لم تُنْعِشْ بِرَوْحِ التّمَنّي","رَمَقِي واقتضى فنائي بَقاكا",31,"ك",2,0],["وإذا لم يكن هنالك رأيٌ","لي أفضي به فلا أستعيرُ",32,"ر",1,0],["وإذا لم أرد لأبسط رأيي","في جوابي فإنني معذور",32,"ر",1,0],["وإذ أَلمت به دهياء كارثة","فأورثته الجوى وَالحُزنَ وَالكمدا",33,"د",2,0],["وإذا لم تُقرن بعلمٍ بَناتُ ال","عَقل منا لَم تأَتِ يوماً نتاجا",34,"ج",2,0],["وَإِذَا لَمَحْنَ أَخَا الْمَشِيبِ قَلَيْنَهُ","وَسَتَرْنَ ضَاحِيَةَ الْمَحَاسِنِ بِالْيَدِ",35,"د",1,0],["وَإِذَا لَمْ أَعُدْ لِيُسْلِكِ أَنِّي","لَم أَعِشْ خَامِلاً وَمِتُّ كَبِيرَا",36,"ر",2,0],["وإذا لم تصح صياح الثكالى","قمتَ عنه وأنت صفرُ اليَدين",37,"ن",1,0],["وَإِذَا لَمْ تَع الْمَعَأنِي فَنَقِّبْ","تَجِدِ الْعَيْبَ كلَّهُ في الْوِعاءِ",38,"ا",2,0],["وإِذا لَمحْتَ الشَّرْقَ خِلْتَ عَرَائِساً","مَاسَتْ بثوبٍ كالشَّباب جَدِيدِ",39,"د",1,0],["وإذ الفصيلُ دعوته","صدحت له منها عشائر",40,"ر",1,0],["وإذا لا حظوا قميصي جديدا","ردّدوا : فوق ركبتيها خزانه",41,"ن",2,0],["وإذا لمح النّور جرى","وتخفّى تحت جنح من مساء",42,"ا",2,0],["وإذا لم يصح باعلم ذوق","وجد الشهد من الجهل صابا",43,"ب",2,0],["وإذ الأنْفُسُ اخْتَلَفْنَ فَما يُغ","ني اتّفاقُ الأسْماءِ وَالألْقَابِ",44,"ب",1,0],["وإذا لم تحن محاين قومٍ","ت وينغلُّ في مجاري السموم",45,"م",1,0],["واذا لم تجد كراما ففي الخل","وة صحح من طورك الاعمالا",46,"ل",2,0],["وإذا لمست حريرة جسيتها","حِقْفاً وغصناً إذ تميسُ مبرعما",47,"م",2,0],["وإذا لك الأمر الصعيب رموا له","هوّن عليك يهن له تر سلما",47,"م",2,0],["وإذا لاحَ نحو يبَرِينَ بَرْقٌ","هامَ شَوْقاً وهَام حبّاً وعِشقاً",48,"ق",2,0],["وإذا لم يكن ودادٌ ولا بُغضٌ","فهذا تراهُ بعد اللِّقاءِ",49,"ا",2,0],["وإذا لم تأخذ بها وبما قلتُ","فأنتَ الغَرِيقُ في الدَّأْماءِ",49,"ا",2,0],["وِإذَا لَم أجِدهُ لَستُ مُجِيدَا","لاَ ولَم أُبرِزِ النَّظِيمَ الصَّمِيمَا",50,"م",2,0],["وإِذَا لاَحَ لاَحَ بَدراً أوَ أبهَى","مَالِبَدرٍ طُلُوعَهُ مِن طُلُوعِ",51,"ع",1,0],["وإذا لم يشكُ مثلي علةً","هل من الحكمة أن يلزم دارهْ",52,"ر",2,0],["وإذا لقى الإنسان منهم فرجةً","أبصرتَهُ كمبشرٍّ بغلامِ",53,"م",1,0],["وَإِذا لَظى الحَربِ الزَّبونِ تَأَجَّجَت","أَطفى لَوافِحَها بِحَملَةِ فَيصَلِ",54,"ل",1,0],["وَإِذا ليلُ غَرامي أظلَما","ولِنَفسي لَم أجِد من مؤنسِ",55,"س",1,0],["وَإِذا لَم أكُن بمدحكَ حسّا","ناً فَهذي قصيدتي حسناءُ",56,"ا",2,0],["وإذا لم يكُ إلا علمهُ","كانت الأوراقُ منه أفضلا",57,"ل",2,0],["وَإِذا لَقيتَ القَومَ فَاِضرِب فيهِمُ","حَتّى يَرَوكَ طِلاءَ أَجرَبَ مُهمَلِ",58,"ل",1,0],["وَإِذا لَقيتَ الباهِشينَ إِلى النَدى","غُبراً أَكُفُّهُم بِقاعٍ مُمحِلِ",58,"ل",1,0],["وَإِذا لبوة مخدِّرَة الحُس","نِ تَرَدَّت من كَهفِها المَحدورِ",59,"ر",1,0],["وإذا لم يكن من الموت بدٌّ","فطويل الحياة نَزْرٌ حقير",60,"ر",1,0],["وإذا لم اعد إليك سريعاً","لا عداني من المذلة عمو",61,"و",1,0],["وإذا لم تجد معينا فآلات","المنايا علي المني أعوان",62,"ن",1,0],["واذ الجزائر رصعت","بالكهربا النور الشهير",63,"ر",1,0],["واذا لم يكف فامعن نظرا","تلق فقد المصطفى يسلي الجوى",64,"و",2,0],["وإذا لم تعد ترى","أهيف القدّ أهيفا",65,"ف",2,0],["وإذِ المعاهدُ مشرقاتٌ بالمنى","وَالسفحُ مَغنىً لم يبن سكّانُهُ",66,"ن",2,0],["وإذا لم تبعثه في أول الأم","ر اختياراً فابعثه بالدبوس",67,"س",1,0],["وإذا لم أسد خلة خل","هات قل لي بالله كيف أسود",68,"د",1,0],["وإذا لم أسد خلة حر","هات قل لي بالله كيف أسود",69,"د",1,0],["وَإِذا لَوى وجهاً لِكشفِ ظلامةٍ","شاهَدت بدرَ التمّ ضاء بمظلمِ",70,"م",1,0],["وَإِذا لهُ عقلٌ يحكِّمهُ عَلى","ما عن تصوّره بوجهٍ يضلعُ",71,"ع",1,0],["وإذا لم يكن لمثلى نصيب","من حماكم فما أشدّ شجوني",72,"ي",1,0],["وإذا لم يراقب الله قوم","جعل الله سعيهم في تباب",73,"ب",1,0],["وَإِذا لَم يَكُن مِنَ الذُلِّ بُدٌّ","فَاِلقَ بِالذُلِّ إِن لَقيتَ الكِبارا",74,"ر",2,0],["وَإِذا لَم يَكُن فَقَد ثَبَتَ الفِعلُ","لِعَبدٍ وَمانَ في مُدَّعاهُ",75,"ا",2,0],["وَإِذا لَم تصن بِأَيدي كَريم","فَهيَ لَيسَت بِذات عرضٍ مَصونِ",76,"ن",1,0],["وإذا لَقيتَ لَقِيتَ سَم","حَ الخُلق سَمحَ الرّاحتَينِ",77,"ن",1,0],["وإِذا لَم أجِد كَريماً فَما يَح","سُنُ بي أَن أَموتَ إِلا كَريما",78,"م",2,0],["وَإِذا لَم يَكُ المُعل طَبيباً","لَيسَ يَرجا لِلداءِ مِن إِفراق",79,"ق",1,0],["وإذا لم تر الذي هي تهوى","قنعت من وصاله بالثماد",80,"د",1,0],["وإذا لامني العوا","ذِلُ فيه وفَنَّدُوا",81,"د",3,0],["وإذا لم تجد خليلاً وفيًّا","فاعلم أنَّ الحسام أوفى خليلا",82,"ل",2,0],["وإذا لم يكن لحلمك أهل","فمن الحلم أن تكون جهولا",82,"ل",2,0],["وإذا لم تكن رأتكم عيوني","فرأكم فكري بعين المثالِ",83,"ل",1,0],["وإذا لذت به من حادث","شادر غما للعدى بالجود ركني",84,"ن",2,0],["وإذا لاقيته في صومة","في قتام الحرب تلقى شمس دجن",84,"ن",1,0],["وإذا لم يكن لديك شراب","فانف عنّي الخمار بالجلاب",85,"ب",1,0],["وإِذا لم يعظني وعظ من أَنا واعظ","سفاه على مثلي وأَي سفاه",86,"ه",1,0],["وإذا لم يكن سبي","ل إلى القرب أو سبب",87,"ب",1,0],["وإذا لحِقتَ وقصَّرتْ بي ناقتي","والثّقل ما بي ما يُقَصِّر حاملي",88,"ل",2,0],["وإذا لم يك أمر زائداً","فأدام الله هذا وأطالَهْ",89,"ل",2,0],["وإذا لقيتَ المجدَ فاصحب أهله","واكثر فأنت بمن تكاثر تُعرفُ",90,"ف",1,0],["وإذا لم يصبحوا أربابَها","وزَروا فيها وكانوا الوسطا",91,"ط",2,0],["وإذا لم تَجِدْ من الصبر بُدَّاً","فتعزَّلْ وَجِدْ من الناس بُدَّا",92,"د",2,0],["وإذا لثمت يمينه وخرجت من","أبوابه لثم الرجال يميني",93,"ن",2,0],["وإذا لم تُنِلِ الرِّفْ","دَ فما لي من مُنيلِ",94,"ل",1,0],["وإِذا لبستَ اللّيلَ تلبسُهُ","عَطِرَ الغلائِلِ بارداً خَضِلا",95,"ل",2,0],["وإذا ليالي الأربعين تكاملتْ","لِلمرءِ فهو إلى الرّدى من حالقِ",96,"ق",1,0],["وَإِذِ النّضارةُ في أَديمي جَمّةٌ","وَالشّيبُ في فَوْدَيَّ لمّا يطلُعِ",97,"ع",1,0],["وإذا لم تدعْ صروفُ اللّيالي","لي أُصولاً فكيف أرجو فروعا",98,"ع",2,0],["وإذا لم يكنْ سوى الموت فالما","ضي بطيئاً كمن يموت سريعا",98,"ع",2,0],["وإِذا لم يكن لهمْ يومَ حشرٍ","روعةٌ تُتقى فلستَ مَروعا",98,"ع",2,0],["وَإِذا لَم أَذق منَ الدّهر إحلا","ءً مدى العم