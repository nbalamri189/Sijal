{"poems":[[55,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[74,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[53,"قل لأمير المؤمنين المعتاد","https://www.aldiwan.net/poem10882.html","الرجز"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[47,"شاقني بالعراق برق كليل","https://www.aldiwan.net/poem65569.html","الخفيف"],[124,"يا أخلاي مرحبا وسلاما","https://www.aldiwan.net/poem49269.html","الخفيف"],[333,"أنا في شعري وشعري قصتي","https://www.aldiwan.net/poem54959.html","الرمل"],[333,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[484,"بين كفيها طرحت الأملا","https://www.aldiwan.net/poem36897.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83336","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48559","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48824","الخفيف"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107215","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133808","الخفيف"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117074","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144075","الرجز"],[288,"","https://poetry.dctabudhabi.ae/diwan/poem/200300","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127996","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110271","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85053","الخفيف"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142995","المنسرح"],[4767,"سيد الساجدين","https://www.poetsgate.com/ViewPoem.aspx?id=198230",""],[4791,"سحابة الغره","https://www.poetsgate.com/ViewPoem.aspx?id=36948",""],[4869,"المعمّره القذافيه","https://www.poetsgate.com/ViewPoem.aspx?id=151677",""],[5055,"ثارت الفتنة","https://www.poetsgate.com/ViewPoem.aspx?id=101192",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[6102,"عذلوني","https://www.poetsgate.com/ViewPoem.aspx?id=184448",""],[6308,"كفي ولونُ الجدائل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87725&r=&rc=3",""]],"verses":[["بَينَ كَفٍّ تَقي المَطامِعَ وَالآما","لَ أَو ذابِلٍ يُغيرُ وَيَسبي",0,"ب",2,0],["بينَ كتاب ومصلى إذا","أمسى سواه بين كأسٍ وشاد",1,"د",1,0],["بين كُفاةٍ ورجالٍ أنجادْ","فهو إذا ما عُدَّ فردُ الأفرادْ",2,"د",1,0],["بَينَ كَوكَبٍ","يَسحَبُ الذَنَب",3,"ب",1,0],["بَينَ كَأسٍ وَعِلَّةٍ فَهوَ إمّا","مُبتَدي نَشوَةٍ وَإِمّا عَليلُ",4,"ل",1,0],["بين كأس وأخوة ونعما","ليلة بين أخوة ومدام",5,"م",1,0],["بين كفّيك وجودي خافقا","وفؤادي غارقا في دمه",6,"م",2,0],["بين كأسي وخمرها ذوبُ وجدا","ني وحسي ووحدتي وشقائي",7,"ي",1,0],["بين كأسٍ حمراء من نار ليلا","ي وشكى في عودها للوصال",8,"ل",1,0],["بين كأسٍ وروضةٍ وغدير","وسماعٍ ولذةٍ وغضاره",9,"ر",2,0],["بين كفيها طرحت الأملا","ظبية قلبي بها قد شغلا",10,"ل",2,1],["بَينٌ كَفى الدُنيا نَعابُ غَرابِهش","وَبِهِ كَفى مُتَشائِماً بِسَوادِهِ",11,"د",2,0],["بينكم واهتضموا ما استعبدوا","من بلاد كلما اشتدوا تلين",12,"ن",1,0],["بين كلِّ العباد بالحقِّ تقضي","وترى الطاعةَ الكريمةَ فضلا",13,"ل",2,0],["بَينَكُم ظَبيٌ بِقَلبي راتِعُ","فَعَلَيهِ ما تَغَنّى ساجِعُ",14,"ع",1,0],["بين كرّات بلبل مطمئن","وشكايات ربرب مفؤود",15,"د",1,0],["بَينَ كُهُولِ هَاشِمٍ والمُردِ","بَدرٌ بَدَا بَينَ نُجومِ السَّعدِ",16,"د",1,0],["بين كِلاب جيَف","عراضُهم ذاتُ نُقَطْ",17,"ط",1,0],["بينَ كابِي الجَبِين مُنْعَفِرِ الخَد","دِّ وعانٍ مُشذَّبِ الأَصْحابِ",18,"ب",1,0],["بين كأس الهوى وكاس الحميا","قدر غالب له واراده",19,"د",2,0],["بين كفيه ضم كأس دماء","نالها من لدى الصليب الأطهر",20,"ر",1,0],["بين كفي لجامها وهي تمشي","طوع كمي فيها الوطا مصحوب",21,"ب",1,0],["بين كريمين منزلٌ واسع","والودّ حالٌ تقرّب الشاسع",22,"ع",1,1],["بين كسرى وهاشمٍ كنتَ عِقداً","لم ينل منه مِن لئيمٍ مِراء",23,"ا",2,0],["بينك وبين مزاعمك منتهى الفرق","فيك الحسن والزين كلّه تصوَّر",24,"ر",1,0],["بينك وبين معمّر القذافي","تشابهٍ بالشارع وبالزنقه",25,"ق",2,0],["بين كف السالفة وناب العطبْ","من رمى نفسه على حد الشفير",26,"ر",1,0],["بين كأسٍ دوَّارةٍ في انتشاءٍ","وصَبوحٍ ملعونةٍ وغَبوق",27,"ق",1,0],["بَينَ كَفَّيهِ العَذارَى ما لَهُنْ","غَيرُ أَوجاعِ الشَّكاوَى وَ البُكاءْ",28,"ا",2,0],["بين كفِّي أنا ولونِ الجدَائِلْ","ألفُ صَوْتٍ يقولُ لي: لا تُحاوِلْ",29,"ل",1,1]]}