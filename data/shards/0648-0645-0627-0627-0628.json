://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67318","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/839","الوافر"],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[90,"على كرند","https://www.poetsgate.com/ViewPoem.aspx?id=179017",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[45,"تصدت لنا دعد وصدت على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=31307",""],[46,"كأنّك، عن كيدِ الحوادثِ، راقد،","https://www.poetsgate.com/ViewPoem.aspx?id=18310",""],[91,"البدر الآفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67945&r=&rc=223",""],[121,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[127,"إلى أي شطر من حياتي أيمّمُ","https://www.aldiwan.net/poem783.html",""],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[153,"ماضٍ وأعرف ما دربي وما هدفي","https://www.aldiwan.net/poem17105.html","عموديه"],[156,"وما أبقى الهوى والشوق مني","https://www.aldiwan.net/poem55563.html","الوافر"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[200,"الشعر في أرؤس من يدعي","https://www.aldiwan.net/poem45166.html","الخفيف"],[200,"اراك نسيت يا ظبي الصريم","https://www.aldiwan.net/poem45571.html","الوافر"],[209,"ألكني وفر لابن الغريرة عرضه","https://www.aldiwan.net/poem2026.html","الطويل"],[230,"وحق تورد الخجل","https://www.aldiwan.net/poem50845.html","مجزوء الوافر"],[236,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[238,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[240,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[253,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[276,"تحيف حالتي حيف الزمان","https://www.aldiwan.net/poem25417.html","الوافر"],[281,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[298,"معاطف أم رماح سمهريات","https://www.aldiwan.net/poem33315.html","البسيط"],[304,"إذا عاينت في الإنشا حلاهم","https://www.aldiwan.net/poem57702.html","الوافر"],[306,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[347,"وما أبالي إذا لاقت جموعهم","https://www.aldiwan.net/poem24136.html","البسيط"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[372,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[407,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[410,"وضح الصباح لناظر المتأمل","https://www.aldiwan.net/poem31960.html","الكامل"],[410,"ما خطر السلوان في بالي","https://www.aldiwan.net/poem32547.html","السريع"],[433,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[442,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[454,"لا الرمز يغني ولا التصريح يرضيني","https://www.aldiwan.net/poem61353.html","البسيط"],[454,"عزيت نفسي وما عزيتها اسفا","https://www.aldiwan.net/poem61722.html","البسيط"],[459,"وما ابن أرض غرض لابن سما","https://www.aldiwan.net/poem55882.html","الرجز"],[459,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[462,"أعيذكم بمجدكم ومدحي","https://www.aldiwan.net/poem15378.html","الوافر"],[462,"أهم بشكوى الدهر ثم تردني","https://www.aldiwan.net/poem16154.html","الطويل"],[465,"صفاتك تفغم الآفاق طيبا","https://www.aldiwan.net/poem3170.html","عموديه"],[465,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[483,"صار بفؤاد الوجد نحو ربوعها","https://www.aldiwan.net/poem24440.html","عموديه"],[506,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[516,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[541,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[552,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[552,"أيا شجرات الواديين لعلني","https://www.aldiwan.net/poem47324.html","الطويل"],[552,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[552,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[552,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[554,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"]],"verses":[["وَما اِبنُ غيلٍ تُذيعُ المَوتَ طَلعَتُهُ","إِذا تَطَلَّعَ غَضباناً مِنَ الأَجَمِ",0,"م",1,0],["وَما أَبقَيتَ في جَفني دُموع","وَلا جِسماً أَعيشُ بِهِ نَحيلا",1,"ل",2,0],["وَما أَبقَيتُ فيها بَعدَ بِشرٍ","سِوى الغِربانِ تَحجُلُ في فَلاها",2,"ا",3,0],["وَما اِبنُكَ إِلّا جِلاءُ العُيونِ","إِذا ناظِرٌ بِسِواهُ اِكتَحَل",3,"ل",1,0],["وما أبصرت عيني كزهر قَرَنْفُلِ","حكى خدَّ من يَسْبي الفُؤادَ وعَرْفَهُ",4,"ف",2,0],["وَما أَبصَرَ الناسُ الَّتي وَضَحَت لَهُ","وَراءَ خُفافِ الطَيرِ إِلّا تَمادِيا",5,"ي",2,0],["وَما اِبتَنى الناسُ مِن بُنيانِ مَكرُمَةٍ","إِلّا لَكُم فَوقَ مَن يَبني العُلا غُرَفُ",6,"ف",1,0],["وَما اِبتَعَثَتني في هَوايَ لُجاجَةٌ","إِذا لَم أَجِد فيها إِمامي مُقَدَّما",7,"م",2,0],["وما أبصرت عيناي من وارث العلى","كناصر دين الله يبسط فضله",8,"ل",2,0],["وما ابتغاءُ الدواءِ إلا","بُغْيا سبيل إلى البقاءِ",9,"ا",2,0],["وما ابنُ عمارٍ أُرى مُقْلِعاً","أو نلتقي في رَهَجٍ راهجِ",10,"ج",1,0],["وما ابنك إلا من بني النَّشْء والبلىَ","لكلٍّ على حوض المنون مواردُ",11,"د",1,0],["وما ابنك إلا مُستعارٌ رَدَدْتَهُ","وكلُّ عَواريِّ الزمان رَدائدُ",11,"د",1,0],["وما ابنك إلا وافد نحو ربه","ومن أوفدتْه عزْمةُ الله وافدُ",11,"د",1,0],["وما أبعد الشوكيّ في ذاك إنهُ","لأولى بدعوى النسل منه وأذكر",12,"ر",1,0],["وما أبو أحمدٍ بدونهما","لراهبٍ أو لراغب حُرما",13,"م",2,0],["وما ابتلاهُمْ لإعناتٍ ولا عبث","ولا لجهلٍ بما يطويه إبطان",14,"ن",1,0],["وما ابنُ مَنينٍ قتيلٌ ثَوى","فسوفَ يُرَى عِرضُه أَمْينُ",15,"ن",1,0],["وَما أَبقى المُصابُ عَلى فُؤادي","فَأَزعَمُ أَنَّهُ دامٍ طَعينُ",16,"ن",1,0],["وَما أَبصَرتُ أَحمَقَ مِن","هُ في عُجمٍ وَلا عَرَبِ",17,"ب",1,0],["وما ابنك إلا الخير من صلب خير","فِلم لا يرجى فيه أو يُتوسم",18,"م",1,0],["وما أبطأَ الإِنجاحَ حتى أهُزَّهُ","بنكتةِ شعرٍ قد أصاب مقيمُها",19,"م",3,0],["وما أبتغِي إلا رِضَاكَ ثوابَها","وذاك ثوابٌ لو علمتَ جَزيلُ",20,"ل",1,0],["وما أبتغي إلا الكرامةَ إنها","سجيَّةُ نفسٍ مِرَّةٍ مُلِئَتْ كِبْرا",21,"ر",2,0],["وَما اِبتَدَروا العُلا إِلّا شَآهُم","وَإِلّا راحَ أَوفَرَهُم نَصيبا",22,"ب",2,0],["وَما اِبتَسَمَت إِلّا خَفا البَرقُ لامِعاً","ذَطوفاً لَأَبصارِ الرُناةِ عَلى قَصدِ",23,"د",1,0],["وَما أَبقَتِ الأَيّامُ وَجداً لِواجِدٍ","كَما أَنَّها لَم تُبقِ صَبراً لِصابِرِ",24,"ر",1,0],["وَما أَبوغانِمٍ عَمّا تُهيبُ بِهِ","إِلَيهِ بِالمُقتَضي سَعياً وَلا الآلي",25,"ل",2,0],["وَما أَبهَجَتني كَبوَةُ الجَحشِ إِذ كَبا","لِفيهِ لَوَ اَنَّ الجَحشَ أَقلَعَ عَن ظُلمي",26,"م",2,0],["وَما اِبنُ هَرثَمَةَ المَشهورُ مَوقِفُهُ","إِلّا الحُسامُ أَصابَ الداءَ فَاِنحَسَما",27,"م",2,0],["وَما إِبِلٌ أَدعى إِلى فَرعِ قَومِها","وَخَيرٌ قِرىً لِلطارِقِ المُتَنَوِّرِ",28,"ر",1,0],["وَما اِبنايَ إِلّا مِثلُ مَن قَد أَصابَهُ","حِبالُ المَنايا مَرُّها وَاِشتِعابُها",29,"ب",3,0],["وما أبْتُ عن جدواهُ إلا مُشَيَّعَاً","بإفْضالِ ذي فضْلٍ وإنعام منعمِ",30,"م",1,0],["وَما أَبقى عَلى إِدمانِ هَذا","وَلا هاتا العُيونُ وَلا القُلوبُ",31,"ب",1,0],["وَما أُبالي وَخَيرُ القَولِ أَصدَقُهُ","حَقَنتَ لي ماءَ وَجهي أَو حَقَنتَ دَمي",32,"م",2,0],["وَما أُبَرِّئُ نَفسي وَهيَ آمِرَةٌ","بِالسُوءِ ما لَم تَعُقها خيفَةُ النَّدَمِ",33,"م",1,0],["وَمَا أَبْقَتْ بِهِ الأَشْوَاقُ مِنِّي","سِوَى رَمَقٍ تَجُولُ بِهِ الأَمَانِي",34,"ن",2,0],["وَما اِبنُ عِصامٍ غَيرَ هَضبَةِ عِصمَةٍ","تُجيرُ وَسُقيا رَحمَةٍ تَتَجَدَّدُ",35,"د",1,0],["وَما أَبقَت عَوادي الدَهرِ إِلّا","بَقايا الذِكرِ لِلأُمَمِ الخَوالي",36,"ل",2,0],["وَما اِبتَلَتِ الأَقوامُ لَيلَةَ حُرَّةٍ","لَنا عَنوَةً إِلّا بِمَهرٍ مُبَلَّتِ",37,"ت",1,0],["وما ابنُ قُطَيَّةٍ إلاَّ شَرِيكٌ","لهُمْ في كُلِّ مَا يَتَخَطَّفُونا",38,"ن",2,0],["وما ابنُ عُبَيدِ اللّهِ يدعوكَ وحدَهُ","غداةَ رأى أن ليسَ في القوس مَنزَع",39,"ع",1,0],["وَما أَبقَيتُ مِن عَيلانَ إِلّا","كَما أَبقى مِنَ البَظرِ المَواسي",40,"س",2,0],["وَما اِبنُ زُرَيقٍ مُقصِرٌ دونَ ضَربَةٍ","عَلى أَنفِهِ مِن ضامِنٍ لِمَزيدِ",41,"د",1,0],["وَما اِبتَسَمَت أَيّامُهُ النُكدُ عَن رِضاً","وَلَكِن تَحاشى وَالصُدورُ حَواقِدُ",42,"د",1,0],["وَما أَبهَجتِني مُنذُ اِلتَقَينا","وَإِن نَوَّهتِ بي وَرَفَعتِ سِمعي",43,"ع",2,0],["وَما أُبالي وَأَرداني مُبَرَّأَةٌ","مِنَ العُيوبِ إِذا ما الحَتفُ أَرداني",44,"ن",2,0],["وَما أَبغي كِفاءَكَ عَن جَميلٍ","وَأَمّا بِالقَبيحِ فَلا تَدِنّي",45,"ن",2,0],["وَما أَبْقَى الحَوَادِثُ مِنْكَ إلَّا","كما أَبْقَتْ مِنَ القَمرِ الدَّآدي",46,"د",2,0],["وَما أَبقَيتَ في جَفني دُموعاً","وَلا جِسماً أَعيشُ بِهِ نَحيلا",47,"ل",2,0],["وَما أَبعَدتُ حَتّى ثارَ خَلفي","غُبارُ سَنابِكِ الخَيلِ العِتاقِ",48,"ق",1,0],["ومَا أُبْتُ بِالْحِرْمَانِ إِلَّا لأَنَّنِي","أَوَدُّ مِنَ الأَيَّامِ مَا لا تَوَدُّهُ",49,"د",2,0],["ومَا أُبَالِي ونَفْسِي غَيْرُ خاطِئَةٍ","إِذا تَخَرَّصَ أَقْوامٌ وَإِنْ كَذَبُوا",50,"ب",3,0],["وَمَا ابْتَغَى إِلاَّ المُؤَاخَ","اةَ وَرَعْي الحِرَمِ",51,"م",1,0],["وَمَا ابْنُ ربيعٍ إنْ تَنَاوَلْتَ عَهْدَهُ","بمُسْلِمِهِ لا يَطْمعَنْ ثَمَّ طَامِعُ",52,"ع",1,0],["وما ابنُ حَضَيْرٍ إنْ أَرَدْتَ بمَطْمَعٍ","فَهَلْ أَنْتَ عَنْ أُحْمُوقَةِ الغَيّ نَازِعُ",52,"ع",1,0],["وَما أَبغي سِوى شُكري ثَواباً","وَإِنَّ الشُكرَ مِن خَيرِ الثَوابِ",53,"ب",1,0],["وما أبتغي إلا حياة عميقةً","تسرُّ، فأرضى، أو تسوء؛ فأنقم",54,"م",1,0],["وما ابهج الشمسَ عند الغروب","يحي رُباها وعند الُّطلوع",55,"ع",1,0],["وما أبتغي رَدَّ العوادي منيخةً","على يدِ من يُزجِي إليَّ العواديا",56,"ي",2,0],["وما ابتسمت إلا خفا البرق لامعاً","خطوفاً لأبصار الرناة على قصد",57,"د",1,0],["وما ابتسمَت أيّامُه النُّكدُ عن رضًى،","ولكنْ تحاشى، والصّدورُ حواقد",58,"د",1,0],["وما أبقى المصاب على فؤادي","فأزعم أنّه دام طغين",59,"ن",1,0],["وما ابتسامة ولهانين لفهما","بعد النوى وانصداع الشمل لقيان",60,"ن",1,0],["وما أبالي وقد أصبحت مطرحاً","إذا خلت لي من الإنسان أوطان",60,"ن",1,0],["وما أبتغي منها وقدماً عرفتها","وقد عشت فيها ناقماً أتبرم",61,"م",1,0],["وَما أَبقى فَعالِكَ لي مَقالا","وَلَكِنَّ اِرتِياحَكَ يَستَعيدُ",62,"د",1,0],["وما أبالي به حتى أحاذره","فخشية الموت عندي أبرد الطرف",63,"ف",1,0],["وَمَا أَبْقَى الهَوى وَالشَّوْقُ مِنِّي","سِوى رُوحٍ ترَدّدُ في خيَالِ",64,"ل",1,1],["وما ابتاع المصطفى الطهر عائض","فيعتاضه عنه الحليم المجرب",65,"ب",1,0],["وما ابنُ عمّارٍ إذا قستهُ","بجمعهم في الشعرِ إلا إمامُ",66,"م",1,0],["وما أبقيتَ يومَ صددتَ روحي","فما تبقى من الجسدِ الرميمِ",67,"م",1,0],["وَما أَبتغي مِن نَهشَلٍ بَعدَ جَندَل","إِذا ما دَعى الدَّاعِي لِأَمرٍ مُجَلَّلِ",68,"ل",1,0],["وَما أَبتَغي في جَندَلٍ بَعد خالِدٍ","لِطارِقِ لَيلٍ أَو لِعانٍ مُكَبَّلِ",68,"ل",1,0],["وما أبْدَاه مَن أهوا","ه مِن صَدٍّ ومِن عِلَلِ",69,"ل",1,0],["وَما أَبتَغيهِ يَسيرٌ إِذا","أُضيفَ إِلى جودِكَ الغَمرِ نَزرُ",70,"ر",1,0],["وَمَا ابْتَغَوْا قَطُّ أَمْراً","يَحْكِي سَحَابَةَ صَيْفِ",71,"ف",1,0],["وما ابن بجاد غير طير محلق","سيهوي وإن طال المجال ويتعب",72,"ب",1,0],["وَما أُبالي إِذا ما الدَهرُ قَيّض لي","لقياك مِن بعد ما يَمنى ليَ الماني",73,"ن",2,0],["وَمَا أَبغِي عَلَى تَلَفِي دَلِيلاً","كَفانِي أَننِي حَيٌّ كَفانِي",74,"ن",2,0],["وَما أَبَقٌ إِلا حَياً مُتَهَلِّلٌ","إِذا جادَ لَمْ تُقْلِعْ مَواطِرُ سُحْبِهِ",75,"ب",2,0],["وَما أُبرّئُ نَفسي إِنَّها حَكمَت","بالحبِّ فاِحتكَمَت فيها الصَباباتُ",76,"ت",1,0],["وما ابن الصيرفي إذا أتاهم","يساوي عندهم في الفضل حبه",77,"ب",2,0],["وَما أُبالي ولكن ما أَقول لهم","وَكلّما أَبصَروني راكباً عتبوا",78,"ب",3,0],["وَما أُبالي إِذا لاقَت جُموعُهُمُ","بِالغَذقَذونَةِ مِن حُمّى وَمِن مومِ",79,"م",1,1],["وَما اِبنَةُ الكَرمِ بِمَرمى لَحظي","وَلا لَها اللَهُ بِحُبّي مُحظِ",80,"ظ",1,0],["وما أبينَ اليَقَقَ المُستَنِي","رَ عَلى الحانِكِ الحالِكِ الفاحِمِ",81,"م",1,0],["وَما أَبدَع الشَمل المُشَتَّت بَينَنا","وَلَو جمع الشَمل الشَتيت لأَبدَعا",82,"ع",2,0],["وما ابيضَّ الغرابُ الجَونُ إلاّ","لينْعَبَ بانتقالٍ وارتحالِ",83,"ل",1,0],["وما أُبالِي بالّذي نَالَني","لو أَنَّني منهم على بَالِ",84,"ل",1,0],["وما أَبقي احتفالُكَ فيَّ هَمّاً","ولا فيما يخصُّنِيَ اهتماما",85,"م",2,0],["وَمَا أَبْعَدَ القَفْرَ عن عَيْنِ راءِ","وَمَا أَقْرَبَ الوَقْرَ من سَمْعِ ناءِ",86,"ا",2,0],["وما أبقت الأيام عندي بقية","من الصبر إلا رقم حزن على حزن",87,"ن",1,0],["وما أبالي متى عادت لعزتها","إذا رجمت كأني في القرابين",88,"ن",1,0],["وما أُبالي مدى إعراضِ ذى سَفهٍ","عني ولكن أُبالي عنه أعراضي",89,"ض",2,0],["وما ابن أرضٍ غَرضٌ لابن سَمَا","نارانِ لم يُخمدْهما سلطانُ مَا",90,"م",2,1],["وما ابنك في المجد إلا أبوه","إذا نُسبَ الشِّبلُ للباسلِ",91,"ل",1,0],["وما أبْقَتْ لي الأيامُ عَوْناً","سِواكُم يا بني الحَسَبِ الكريمِ",92,"م",1,0],["وما أبْقَتِ الأيامُ لي غير جودكم","مُعيناً وباقي الناسِ مُقْوٍ وحارِمُ",93,"م",1,0],["وما ابتسمت ثغور الأرض حتى","قد مت فشقت السحب الجيوبا",94,"ب",2,0],["وما ابيضت بها الأيام لكن","ثنتها خيفة الأعداء شيبا",94,"ب",2,0],["وما أبيض وجهُ الخائض الحرب والوغى","بصارمهِ لولا سوادُ القساطل",95,"ل",1,0],["وما أبصرت عيني سواها لأنها","أماطت لثام الحسن عن وجهها كشفا",96,"ف",2,0],["وما ابتدعَ العوارفُ منْ علومٍ","وما قالَ الفلاسفةُ الأكابرْ",97,"ر",1,0],["وما أبقت الدنيا علينا وإنما","سهام المنايا مخطئ ومصيب",98,"ب",1,0],["وَما أُبالي عَدوّاً بَعدُ شاحَنَنِي","أَم زاحمت سَعَفات الصّمِّ مِن حَضَنِ",99,"ن",1,0],["وَما أُبالِي إذا ما كنتُمُ وَضَحاً","لناظِرَيَّ أضاء الخلقُ أم دَجَنوا",100,"ن",3,0],["وَما أُبالي إِذا ما كنتُ مجتهداً","ألّا أَفوزَ بِما أَهوى من القسمِ",101,"م",1,0],["وَما أَبتغي إلّا القليلَ وكم شفى","كثيرَ سَقامٍ في الرّجال قليلُ",102,"ل",1,0],["وما أبقى الزّمانُ لنا أُصولاً","فنطمعَ أنْ تدوم به الفروعُ",103,"ع",1,0],["وَما أَبقَتْ بِها الرَّوحاتُ إلّا","ظهوراً أو ضلوعاً أو مِلاطا",104,"ط",2,0],["وما أبالِي ونفسي ما تملّكها","أَسْرُ الغرامِ أقامَ الحيُّ أم ساروا",105,"ر",3,0],["وما أُبالي بعد خُبْرٍ بهِ","صرّح أو صمَّمَ في خُلّتِي",106,"ي",1,0],["وَما أَبقَتِ الأَيّامُ مِنّي وَلا الصِبا","سِوى كَبِدٍ حَرّى وَقَلبٍ مُقَتَّلِ",107,"ل",1,0]]}