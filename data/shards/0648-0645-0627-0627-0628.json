عرة الشجون",199,"ن",1,0],["وما أبقَى الزمانُ فتىً فتِيًّا","يدورُ .. فللبقاءِ به الزوالُ",200,"ل",1,0],["وما أبتغي في ذاك أجراً ولا أرى","وفي النفي عرفاني فنحن كما كنا",201,"ن",2,0],["وما أبلغتني إلا قفاراً","تعبت بها وأتعبت المطيا",202,"ي",2,0]]}