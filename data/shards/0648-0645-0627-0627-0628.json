3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[5277,"أهل قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185166",""],[5284,"هرمنا","https://www.poetsgate.com/ViewPoem.aspx?id=191799",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[5344,"طبعي مزوح","https://www.poetsgate.com/ViewPoem.aspx?id=154945",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5638,"سلام","https://www.poetsgate.com/ViewPoem.aspx?id=198252",""],[5660,"فَلَستُ أَرى فَيضَ الفُراتِ بِناضِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=24646",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5781,"بِلَونِ عينيكَ القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=204074",""],[5781,"سفرُ الشفاهِ..قصيدة وصلاة","https://www.poetsgate.com/ViewPoem.aspx?id=208989",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[6097,"لأيًا بعدَ جيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=190694",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[5309,"قضيت العمر في سكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573569",""],[231,"يقظة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79175&r=&rc=49",""],[6225,"إشباع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78019&r=&rc=105",""],[2220,"إذا أنت لم تعرف إلهك فاعتكف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11821&r=&rc=690",""],[5536,"سيف دولتنا عليا !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76355&r=&rc=33",""]],"verses":[["وَما اِبنُ غيلٍ تُذيعُ المَوتَ طَلعَتُهُ","إِذا تَطَلَّعَ غَضباناً مِنَ الأَجَمِ",0,"م",1,0],["وَما أَبقَيتَ في جَفني دُموع","وَلا جِسماً أَعيشُ بِهِ نَحيلا",1,"ل",2,0],["وَما أَبقَيتُ فيها بَعدَ بِشرٍ","سِوى الغِربانِ تَحجُلُ في فَلاها",2,"ا",3,0],["وَما اِبنُكَ إِلّا جِلاءُ العُيونِ","إِذا ناظِرٌ بِسِواهُ اِكتَحَل",3,"ل",1,0],["وما أبصرت عيني كزهر قَرَنْفُلِ","حكى خدَّ من يَسْبي الفُؤادَ وعَرْفَهُ",4,"ف",2,0],["وَما أَبصَرَ الناسُ الَّتي وَضَحَت لَهُ","وَراءَ خُفافِ الطَيرِ إِلّا تَمادِيا",5,"ي",2,0],["وَما اِبتَنى الناسُ مِن بُنيانِ مَكرُمَةٍ","إِلّا لَكُم فَوقَ مَن يَبني العُلا غُرَفُ",6,"ف",1,0],["وَما اِبتَعَثَتني في هَوايَ لُجاجَةٌ","إِذا لَم أَجِد فيها إِمامي مُقَدَّما",7,"م",2,0],["وما أبصرت عيناي من وارث العلى","كناصر دين الله يبسط فضله",8,"ل",2,0],["وما ابتغاءُ الدواءِ إلا","بُغْيا سبيل إلى البقاءِ",9,"ا",2,0],["وما ابنُ عمارٍ أُرى مُقْلِعاً","أو نلتقي في رَهَجٍ راهجِ",10,"ج",1,0],["وما ابنك إلا من بني النَّشْء والبلىَ","لكلٍّ على حوض المنون مواردُ",11,"د",1,0],["وما ابنك إلا مُستعارٌ رَدَدْتَهُ","وكلُّ عَواريِّ الزمان رَدائدُ",11,"د",1,0],["وما ابنك إلا وافد نحو ربه","ومن أوفدتْه عزْمةُ الله وافدُ",11,"د",1,0],["وما أبعد الشوكيّ في ذاك إنهُ","لأولى بدعوى النسل منه وأذكر",12,"ر",1,0],["وما أبو أحمدٍ بدونهما","لراهبٍ أو لراغب حُرما",13,"م",2,0],["وما ابتلاهُمْ لإعناتٍ ولا عبث","ولا لجهلٍ بما يطويه إبطان",14,"ن",1,0],["وما ابنُ مَنينٍ قتيلٌ ثَوى","فسوفَ يُرَى عِرضُه أَمْينُ",15,"ن",1,0],["وَما أَبقى المُصابُ عَلى فُؤادي","فَأَزعَمُ أَنَّهُ دامٍ طَعينُ",16,"ن",1,0],["وَما أَبصَرتُ أَحمَقَ مِن","هُ في عُجمٍ وَلا عَرَبِ",17,"ب",1,0],["وما ابنك إلا الخير من صلب خير","فِلم لا يرجى فيه أو يُتوسم",18,"م",1,0],["وما أبطأَ الإِنجاحَ حتى أهُزَّهُ","بنكتةِ شعرٍ قد أصاب مقيمُها",19,"م",3,0],["وما أبتغِي إلا رِضَاكَ ثوابَها","وذاك ثوابٌ لو علمتَ جَزيلُ",20,"ل",1,0],["وما أبتغي إلا الكرامةَ إنها","سجيَّةُ نفسٍ مِرَّةٍ مُلِئَتْ كِبْرا",21,"ر",2,0],["وَما اِبتَدَروا العُلا إِلّا شَآهُم","وَإِلّا راحَ أَوفَرَهُم نَصيبا",22,"ب",2,0],["وَما اِبتَسَمَت إِلّا خَفا البَرقُ لامِعاً","ذَطوفاً لَأَبصارِ الرُناةِ عَلى قَصدِ",23,"د",1,0],["وَما أَبقَتِ الأَيّامُ وَجداً لِواجِدٍ","كَما أَنَّها لَم تُبقِ صَبراً لِصابِرِ",24,"ر",1,0],["وَما أَبوغانِمٍ عَمّا تُهيبُ بِهِ","إِلَيهِ بِالمُقتَضي سَعياً وَلا الآلي",25,"ل",2,0],["وَما أَبهَجَتني كَبوَةُ الجَحشِ إِذ كَبا","لِفيهِ لَوَ اَنَّ الجَحشَ أَقلَعَ عَن ظُلمي",26,"م",2,0],["وَما اِبنُ هَرثَمَةَ المَشهورُ مَوقِفُهُ","إِلّا الحُسامُ أَصابَ الداءَ فَاِنحَسَما",27,"م",2,0],["وَما إِبِلٌ أَدعى إِلى فَرعِ قَومِها","وَخَيرٌ قِرىً لِلطارِقِ المُتَنَوِّرِ",28,"ر",1,0],["وَما اِبنايَ إِلّا مِثلُ مَن قَد أَصابَهُ","حِبالُ المَنايا مَرُّها وَاِشتِعابُها",29,"ب",3,0],["وما أبْتُ عن جدواهُ إلا مُشَيَّعَاً","بإفْضالِ ذي فضْلٍ وإنعام منعمِ",30,"م",1,0],["وَما أَبقى عَلى إِدمانِ هَذا","وَلا هاتا العُيونُ وَلا القُلوبُ",31,"ب",1,0],["وَما أُبالي وَخَيرُ القَولِ أَصدَقُهُ","حَقَنتَ لي ماءَ وَجهي أَو حَقَنتَ دَمي",32,"م",2,0],["وَما أُبَرِّئُ نَفسي وَهيَ آمِرَةٌ","بِالسُوءِ ما لَم تَعُقها خيفَةُ النَّدَمِ",33,"م",1,0],["وَمَا أَبْقَتْ بِهِ الأَشْوَاقُ مِنِّي","سِوَى رَمَقٍ تَجُولُ بِهِ الأَمَانِي",34,"ن",2,0],["وَما اِبنُ عِصامٍ غَيرَ هَضبَةِ عِصمَةٍ","تُجيرُ وَسُقيا رَحمَةٍ تَتَجَدَّدُ",35,"د",1,0],["وَما أَبقَت عَوادي الدَهرِ إِلّا","بَقايا الذِكرِ لِلأُمَمِ الخَوالي",36,"ل",2,0],["وَما اِبتَلَتِ الأَقوامُ لَيلَةَ حُرَّةٍ","لَنا عَنوَةً إِلّا بِمَهرٍ مُبَلَّتِ",37,"ت",1,0],["وما ابنُ قُطَيَّةٍ إلاَّ شَرِيكٌ","لهُمْ في كُلِّ مَا يَتَخَطَّفُونا",38,"ن",2,0],["وما ابنُ عُبَيدِ اللّهِ يدعوكَ وحدَهُ","غداةَ رأى أن ليسَ في القوس مَنزَع",39,"ع",1,0],["وَما أَبقَيتُ مِن عَيلانَ إِلّا","كَما أَبقى مِنَ البَظرِ المَواسي",40,"س",2,0],["وَما اِبنُ زُرَيقٍ مُقصِرٌ دونَ ضَربَةٍ","عَلى أَنفِهِ مِن ضامِنٍ لِمَزيدِ",41,"د",1,0],["وَما اِبتَسَمَت أَيّامُهُ النُكدُ عَن رِضاً","وَلَكِن تَحاشى وَالصُدورُ حَواقِدُ",42,"د",1,0],["وَما أَبهَجتِني مُنذُ اِلتَقَينا","وَإِن نَوَّهتِ بي وَرَفَعتِ سِمعي",43,"ع",2,0],["وَما أُبالي وَأَرداني مُبَرَّأَةٌ","مِنَ العُيوبِ إِذا ما الحَتفُ أَرداني",44,"ن",2,0],["وَما أَبغي كِفاءَكَ عَن جَميلٍ","وَأَمّا بِالقَبيحِ فَلا تَدِنّي",45,"ن",2,0],["وَما أَبْقَى الحَوَادِثُ مِنْكَ إلَّا","كما أَبْقَتْ مِنَ القَمرِ الدَّآدي",46,"د",2,0],["وَما أَبقَيتَ في جَفني دُموعاً","وَلا جِسماً أَعيشُ بِهِ نَحيلا",47,"ل",2,0],["وَما أَبعَدتُ حَتّى ثارَ خَلفي","غُبارُ سَنابِكِ الخَيلِ العِتاقِ",48,"ق",1,0],["ومَا أُبْتُ بِالْحِرْمَانِ إِلَّا لأَنَّنِي","أَوَدُّ مِنَ الأَيَّامِ مَا لا تَوَدُّهُ",49,"د",2,0],["ومَا أُبَالِي ونَفْسِي غَيْرُ خاطِئَةٍ","إِذا تَخَرَّصَ أَقْوامٌ وَإِنْ كَذَبُوا",50,"ب",3,0],["وَمَا ابْتَغَى إِلاَّ المُؤَاخَ","اةَ وَرَعْي الحِرَمِ",51,"م",1,0],["وَمَا ابْنُ ربيعٍ إنْ تَنَاوَلْتَ عَهْدَهُ","بمُسْلِمِهِ لا يَطْمعَنْ ثَمَّ طَامِعُ",52,"ع",1,0],["وما ابنُ حَضَيْرٍ إنْ أَرَدْتَ بمَطْمَعٍ","فَهَلْ أَنْتَ عَنْ أُحْمُوقَةِ الغَيّ نَازِعُ",52,"ع",1,0],["وَما أَبغي سِوى شُكري ثَواباً","وَإِنَّ الشُكرَ مِن خَيرِ الثَوابِ",53,"ب",1,0],["وما أبتغي إلا حياة عميقةً","تسرُّ، فأرضى، أو تسوء؛ فأنقم",54,"م",1,0],["وما ابهج الشمسَ عند الغروب","يحي رُباها وعند الُّطلوع",55,"ع",1,0],["وما أبتغي رَدَّ العوادي منيخةً","على يدِ من يُزجِي إليَّ العواديا",56,"ي",2,0],["وما ابتسمت إلا خفا البرق لامعاً","خطوفاً لأبصار الرناة على قصد",57,"د",1,0],["وما ابتسمَت أيّامُه النُّكدُ عن رضًى،","ولكنْ تحاشى، والصّدورُ حواقد",58,"د",1,0],["وما أبقى المصاب على فؤادي","فأزعم أنّه دام طغين",59,"ن",1,0],["وما ابتسامة ولهانين لفهما","بعد النوى وانصداع الشمل لقيان",60,"ن",1,0],["وما أبالي وقد أصبحت مطرحاً","إذا خلت لي من الإنسان أوطان",60,"ن",1,0],["وما أبتغي منها وقدماً عرفتها","وقد عشت فيها ناقماً أتبرم",61,"م",1,0],["وَما أَبقى فَعالِكَ لي مَقالا","وَلَكِنَّ اِرتِياحَكَ يَستَعيدُ",62,"د",1,0],["وما أبالي به حتى أحاذره","فخشية الموت عندي أبرد الطرف",63,"ف",1,0],["وَمَا أَبْقَى الهَوى وَالشَّوْقُ مِنِّي","سِوى رُوحٍ ترَدّدُ في خيَالِ",64,"ل",1,1],["وما ابتاع المصطفى الطهر عائض","فيعتاضه عنه الحليم المجرب",65,"ب",1,0],["وما ابنُ عمّارٍ إذا قستهُ","بجمعهم في الشعرِ إلا إمامُ",66,"م",1,0],["وما أبقيتَ يومَ صددتَ روحي","فما تبقى من الجسدِ الرميمِ",67,"م",1,0],["وَما أَبتغي مِن نَهشَلٍ بَعدَ جَندَل","إِذا ما دَعى الدَّاعِي لِأَمرٍ مُجَلَّلِ",68,"ل",1,0],["وَما أَبتَغي في جَندَلٍ بَعد خالِدٍ","لِطارِقِ لَيلٍ أَو لِعانٍ مُكَبَّلِ",68,"ل",1,0],["وما أبْدَاه مَن أهوا","ه مِن صَدٍّ ومِن عِلَلِ",69,"ل",1,0],["وَما أَبتَغيهِ يَسيرٌ إِذا","أُضيفَ إِلى جودِكَ الغَمرِ نَزرُ",70,"ر",1,0],["وَمَا ابْتَغَوْا قَطُّ أَمْراً","يَحْكِي سَحَابَةَ صَيْفِ",71,"ف",1,0],["وما ابن بجاد غير طير محلق","سيهوي وإن طال المجال ويتعب",72,"ب",1,0],["وَما أُبالي إِذا ما الدَهرُ قَيّض لي","لقياك مِن بعد ما يَمنى ليَ الماني",73,"ن",2,0],["وَمَا أَبغِي عَلَى تَلَفِي دَلِيلاً","كَفانِي أَننِي حَيٌّ كَفانِي",74,"ن",2,0],["وَما أَبَقٌ إِلا حَياً مُتَهَلِّلٌ","إِذا جادَ لَمْ تُقْلِعْ مَواطِرُ سُحْبِهِ",75,"ب",2,0],["وَما أُبرّئُ نَفسي إِنَّها حَكمَت","بالحبِّ فاِحتكَمَت فيها الصَباباتُ",76,"ت",1,0],["وما ابن الصيرفي إذا أتاهم","يساوي عندهم في الفضل حبه",77,"ب",2,0],["وَما أُبالي ولكن ما أَقول لهم","وَكلّما أَبصَروني راكباً عتبوا",78,"ب",3,0],["وَما أُبالي إِذا لاقَت جُموعُهُمُ","بِالغَذقَذونَةِ مِن حُمّى وَمِن مومِ",79,"م",1,1],["وَما اِبنَةُ الكَرمِ بِمَرمى لَحظي","وَلا لَها اللَهُ بِحُبّي مُحظِ",80,"ظ",1,0],["وما أبينَ اليَقَقَ المُستَنِي","رَ عَلى الحانِكِ الحالِكِ الفاحِمِ",81,"م",1,0],["وَما أَبدَع الشَمل المُشَتَّت بَينَنا","وَلَو جمع الشَمل الشَتيت لأَبدَعا",82,"ع",2,0],["وما ابيضَّ الغرابُ الجَونُ إلاّ","لينْعَبَ بانتقالٍ وارتحالِ",83,"ل",1,0],["وما أُبالِي بالّذي نَالَني","لو أَنَّني منهم على بَالِ",84,"ل",1,0],["وما أَبقي احتفالُكَ فيَّ هَمّاً","ولا فيما يخصُّنِيَ اهتماما",85,"م",2,0],["وَمَا أَبْعَدَ القَفْرَ عن عَيْنِ راءِ","وَمَا أَقْرَبَ الوَقْرَ من سَمْعِ ناءِ",86,"ا",2,0],["وما أبقت الأيام عندي بقية","من الصبر إلا رقم حزن على حزن",87,"ن",1,0],["وما أبالي متى عادت لعزتها","إذا رجمت كأني في القرابين",88,"ن",1,0],["وما أُبالي مدى إعراضِ ذى سَفهٍ","عني ولكن أُبالي عنه أعراضي",89,"ض",2,0],["وما ابن أرضٍ غَرضٌ لابن سَمَا","نارانِ لم يُخمدْهما سلطانُ مَا",90,"م",2,1],["وما ابنك في المجد إلا أبوه","إذا نُسبَ الشِّبلُ للباسلِ",91,"ل",1,0],["وما أبْقَتْ لي الأيامُ عَوْناً","سِواكُم يا بني الحَسَبِ الكريمِ",92,"م",1,0],["وما أبْقَتِ الأيامُ لي غير جودكم","مُعيناً وباقي الناسِ مُقْوٍ وحارِمُ",93,"م",1,0],["وما ابتسمت ثغور الأرض حتى","قد مت فشقت السحب الجيوبا",94,"ب",2,0],["وما ابيضت بها الأيام لكن","ثنتها خيفة الأعداء شيبا",94,"ب",2,0],["وما أبيض وجهُ الخائض الحرب والوغى","بصارمهِ لولا سوادُ القساطل",95,"ل",1,0],["وما أبصرت عيني سواها لأنها","أماطت لثام الحسن عن وجهها كشفا",96,"ف",2,0],["وما ابتدعَ العوارفُ منْ علومٍ","وما قالَ الفلاسفةُ الأكابرْ",97,"ر",1,0],["وما أبقت الدنيا علينا وإنما","سهام المنايا مخطئ ومصيب",98,"ب",1,0],["وَما أُبالي عَدوّاً بَعدُ شاحَنَنِي","أَم زاحمت سَعَفات الصّمِّ مِن حَضَنِ",99,"ن",1,0],["وَما أُبالِي إذا ما كنتُمُ وَضَحاً","لناظِرَيَّ أضاء الخلقُ أم دَجَنوا",100,"ن",3,0],["وَما أُبالي إِذا ما كنتُ مجتهداً","ألّا أَفوزَ بِما أَهوى من القسمِ",101,"م",1,0],["وَما أَبتغي إلّا القليلَ وكم شفى","كثيرَ سَقامٍ في الرّجال قليلُ",102,"ل",1,0],["وما أبقى الزّمانُ لنا أُصولاً","فنطمعَ أنْ تدوم به الفروعُ",103,"ع",1,0],["وَما أَبقَتْ بِها الرَّوحاتُ إلّا","ظهوراً أو ضلوعاً أو مِلاطا",104,"ط",2,0],["وما أبالِي ونفسي ما تملّكها","أَسْرُ الغرامِ أقامَ الحيُّ أم ساروا",105,"ر",3,0],["وما أُبالي بعد خُبْرٍ بهِ","صرّح أو صمَّمَ في خُلّتِي",106,"ي",1,0],["وَما أَبقَتِ الأَيّامُ مِنّي وَلا الصِبا","سِوى كَبِدٍ حَرّى وَقَلبٍ مُقَتَّلِ",107,"ل",1,0],["وَما أبقَى هَواها في عِظامي","سِوَى عَظمٍ بِهِ لَصِقَ الأَديمُ",108,"م",1,0],["وَما اِبتَهجت بِأَبطال سيوفُهم","بِالفَصل تحكم في الأَعناق وَالسُوق",109,"ق",1,0],["وما أبو جعفرٍ إِلاَّ مُنيفُ ذُرىً","من الجبال وصوُبٌ منْ حَياً رَذِم",110,"م",1,0],["وما أباحَ الحقَّ من نصرِهِ","فَهْوَ له ن بعدُ لا يُعْدَمُ",111,"م",1,0],["وما ابتَسمَتْ ثَنايا أمْ أَقاحٍ","ويكنفُها شِفاهٌ أم شَقيقُ",112,"ق",1,0],["وما أبالي إذا ما الدهر حاربني","إن كان صري بهذي الحادثات معي",113,"ع",2,0],["وما أباليْ ونفسي في سلامتها","طولَ اعتلالي بأعصابي وأوصالي",114,"ل",2,0],["وما أبيت عليهم غير أنهمُ","يأبون كل الذي يبنيه غيرُهم",115,"م",1,0],["وما أَبعدَتِ التوب","ةُ والصَّبوةُ تسويفَه",116,"ف",2,0],["وَما أُبرِّي نَفسِيَ الأمّاره","بِالسّوءِ بِالتّصريحِ وَالإِشاره",117,"ه",1,0],["وما اِبن فَتحِ اللَّهِ نادى دُجىً","قُمْ يا نَديمي عاطِني الكَأسا",118,"س",2,0],["وما أبقى الحِمام علي عطفاً","ولكني خفيت عن الحِمام",119,"م",1,0],["وما أُبالي بِحَرْبِ دَهْرٍ","جَنَحْتُمُ دُونَهُ لِسلْمي",120,"م",2,0],["وما أَبْدَتْهَ مِنْ كَفِّ خَضيبٍ","أَمدَّ خِضابَ شَيْبي بالنُّصولِ",121,"ل",1,0],["وما أبقت لنا الأيام شيئاً","يناطُ بهِ رجاءٌ في القِمَطر",122,"ر",1,0],["وما أبقت يد الأيام فيه","مكاناً للخديعة والرياء",123,"ا",2,0],["وما ابتسمت إِلاَّ لأن حبيبها","تبدى لها بعد التجهم فرحانا",124,"ن",2,0],["وَمَا ابْنُ يُوسُفَ إِلاَّ رَحْمَةٌ نَفَحَتْ","عَنْ أَيِّ رُوحٍ بِهِ دِينُ الهُدَى انْتَعَشَا",125,"ش",2,0],["وَمَا أَبْصَرَتْ عَيْنٌ كَمِشْوَرِهَا الَّذِي","تُنَاسِبُهُ فِي رِفْعَةٍ هِمَّةُ البَانِي",126,"ن",2,0],["وما أبقى على كبدي ولكن","لتأنسَ في محبّتِكم ضُلوعي",127,"ع",2,0],["وما ابن أبي سلولٍ ذا نفاق","فإن قلتم بلى فاستخبرونا",128,"ن",2,0],["وما أبقتْ صروفُ الدهر حيا","فلا مولى يدوم ولا وُلاةُ",129,"ه",1,0],["وما أبقى النفوسَ على خطوبٍ","لها يُسْتَرْخَصُ العِلْقُ الثمين",130,"ن",1,0],["وما أبطأت غدراً ولكن عادها","لمثلك في صدق العزيمة تبتلى",131,"ل",2,0],["وما أبصرَت عيني محلاً حللتِهِ","ولا مَعهَداً إلا سفكتُ بهِ دَمي",132,"م",2,0],["وَما أُبالِي وَصَرفُ الدَهرِ يُسخِطُني","وَسَيبُ نُعماكَ إِنَّ السَيلَ يُرضِيني",133,"ن",2,0],["وما أبقوا هماماً يعربيا","خليا من تعديهم مصونا",134,"ن",2,0],["وما أبهى اجتهادك في رضاه","وما أوفى بشكر علاه فاك",135,"ك",1,0],["وَما إِبِلي بِمُقتَدَرٍ عَلَيها","وَما حِلمي الأَصيلُ بِمُستَعارِ",136,"ر",1,0],["وما أبدت تجنبها إلى أن","رأت في الرأس شيباً أجنبيّا",137,"ي",2,0],["وما أبتغي في ذاك أجراً ولا أرى","عليه جزاء إن تزيدوا إذا أبنا",138,"ن",2,0],["وما أبدت سوى شطر","وما أخفت ضنائنها",139,"ن",3,0],["وَما اِبنُ مِراسٍ حينَ جِئتُ مُطَرَّداً","بِذي عِلَّةٍ دوني وَلا حاقِدِ الصَدرِ",140,"ر",1,0],["وَما أبعدتني عَنك إِلا حَوادث","تمنت بها رُوحي عَن الجَسد البُعدا",141,"د",2,0],["وَما اِبن داود وَلا سُلطانه","لَو لَم تَكُن أَسماؤكم في الخاتم",142,"م",1,0],["وَما أُبالي وَلو كُل الوَرى صرفت","عَني بِأَوجهها وَاللَه وَهوَ مَعي",143,"ع",2,0],["وما أبصرت أجمل منه حسنا","غداة بفيه فصل عقد جوهر",144,"ر",1,0],["وَما أَبناءُ دَهري يَعرِفوني","وَهَل لِلنَقصِ علمٌ بِالكَمالِ",145,"ل",1,0],["وما ابتاع من أنعامنا وحروثنا","فتزكى كما قد كان تزكى بلا صد",146,"د",1,0],["وما ابن يمين أن يفوز بنجدة","وإن عظمت أسبابها يتكبر",147,"ر",1,0],["وما ابتغي من درس شعري دعاية","ولكن عويناتٍ لعمْش النواظر",148,"ر",1,0],["وما ابن شُمَيط إِذ يحرِّض قومه","هناك بمخذولٍ ولا بمضيع",149,"ع",1,0],["وَما أُبنَ حَتّى قُلنَ يا لَيتَ أَنَّنا","تُرابٌ وَلَيتَ الأَرضَ بِالناسِ تُخسَفُ",150,"ف",1,0],["وما أبو الهدى وافى قائلاً لكم","روحي وأرواح من في الكائنات فدا",151,"د",2,0],["وما أبناء توت غير شعبٍ","يَدينُ له الزمان ولا يدانُ",152,"ن",1,0],["وما ابرئ نفسي اليوم من لمم","لكن رجعت لغفارٍ وستار",153,"ر",1,0],["وما أبقى الهوى للصبِّ مِنَّه","لقد تلِفَت به العشّاق طُرّا",154,"ر",2,0],["وما أَبو جَعْدَةَ في ثُلَّةٍ","أَسرعَ منه في نفوسِ الأَنَامْ",155,"م",1,0],["وما أبليتُها في السّعي عَجزاً","فتُجبرُني على أخذِ النّوالِ",156,"ل",1,0],["وما أبقى المنُازكُ من دموعي","سوى عَلَقٍ تُبرضُهُ الجفونُ",157,"ن",1,0],["وما أبقى الراومِسُ كلَّ قَيظٍ","ولا المُتَهَدِّجاتِ منَ الغَمامِ",158,"م",1,0],["وما ابرئ نفسي انها اقترفت","جرائماً عاد منها الظهر موزورا",159,"ر",2,0],["وما أبهى محيّاه وأحلى","رقيق قريضه العَذب الغرامي",160,"م",2,0],["وَما أبتغي ماءَ الحَياة مكدّراً","وَقد عفت من قبل التكدّر سائغَهْ",161,"غ",2,0],["وما أبصرتُ من هذا","ولا من تلك في آنِ",162,"ن",1,0],["وما ابتدر الأملاك غاية سؤددٍ","ومكرمة إلاّ وجدناك سابقا",163,"ق",2,0],["وما أبقتِ الدنيا لنا من جُسومنا","_ على بأسِنا ما يستقيمُ به الظِّلّ",164,"ل",1,0],["وما ابنُ أبيك الخير يوماً بضارعٍ","بحربٍ ولا نائي العزيمة ناكلِ",165,"ل",1,0],["وما أبرّيء نفسي من غوايتها","كأنها من أجاج الجهل مغسوله",166,"ل",2,0],["وما أبرّىء نفسي من غوايتها","فإن نفسي بفعل السوء أماره",167,"ر",2,0],["وما أبهى محياه وأحلى","رقيق قريضه عذب المدام",168,"م",1,0],["وما أبهاك يوم البذل مرءا","وما أوراك يوم الفخر زندا",169,"د",2,0],["وماابن هلال راح يشدو مؤرخا","زفاف الثريا حل للكوكب الدري",170,"ر",2,0],["وما ابن الهلالي راح ينشد قائلا","سهام قضاء اللَه ليس لها رد",171,"د",1,0],["وما ابيضَّ يومُ النّصرِ واخضرَّ روضُهُ","من الخصبِ حتى اسودَّ بالنّقعِ واغبرَّا",172,"ر",2,0],["وما أُبالي إذا الدُّنيا حَلَتْ لكم","واعْذَوْذَبَتْ أنْ غدَتْ لي ذات إمرار",173,"ر",1,0],["وَما أَبصَرَت عَينايَ لِلخَم