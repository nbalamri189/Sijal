{"poems":[[93,"إني أقمت على التعلة","https://www.aldiwan.net/poem11123.html","مجزوء الكامل"],[93,"خير الحلى من أدب وطهر","https://www.aldiwan.net/poem11237.html","البسيط"],[88,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[51,"جرى لك الطائر السعيد","https://www.aldiwan.net/poem61859.html","مخلع البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا مجير الورى من الحدثان","https://www.aldiwan.net/poem66415.html","الخفيف"],[70,"لله غانية يوما خلوت بها","https://www.aldiwan.net/poem42423.html","البسيط"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[62,"نار الهوى تسبك القلوب وبال","https://www.aldiwan.net/poem52274.html","المنسرح"],[61,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[49,"الخير والشر عادات وأهواء","https://www.aldiwan.net/poem10313.html","البسيط"],[49,"أرى المقادير تعمل العملا","https://www.aldiwan.net/poem63065.html","المنسرح"],[49,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[49,"يا من تبغى زمنا صالحا","https://www.aldiwan.net/poem65352.html","السريع"],[97,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[105,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[105,"ولقد عجبت من الغواة وقولهم","https://www.aldiwan.net/poem43117.html","الكامل"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[105,"خفوا يلاقون النبي بيثرب","https://www.aldiwan.net/poem44019.html","الكامل"],[105,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[105,"هي الأواصر أدناها الدم الجاري","https://www.aldiwan.net/poem44225.html","البسيط"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"كفاك أني قد بت لم أنم","https://www.aldiwan.net/poem65259.html","المنسرح"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85369","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55070","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[100,"خير ما في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=50388",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[94,"الكعبة السمراء","https://www.poetsgate.com/ViewPoem.aspx?id=15616",""],[51,"يا منْ سكونُ النفس في تأميلهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30331",""],[115,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[128,"فأنا المقر بذا ولكن ليس لي","https://www.aldiwan.net/poem50556.html","الكامل"],[135,"أهدي إلى السامي المقام سلاميه","https://www.aldiwan.net/poem48994.html","الكامل"],[137,"عللاني واسقياني","https://www.aldiwan.net/poem67933.html","مجزوء الرمل"],[142,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[160,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[198,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[204,"لا شيء أحسن من إلفين قد قسما","https://www.aldiwan.net/poem53183.html","البسيط"],[211,"كل لفظ من حسين","https://www.aldiwan.net/poem46600.html","مجزوء الرمل"],[223,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[223,"كيف حال المريض ماذا جرى له","https://www.aldiwan.net/poem41605.html","الخفيف"],[223,"أي داء يشفه أي داء","https://www.aldiwan.net/poem41610.html","الخفيف"],[223,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[229,"كللت ودك لي بالبر والنفل","https://www.aldiwan.net/poem50842.html","البسيط"],[232,"يا من سبي العشاق حسنه","https://www.aldiwan.net/poem14715.html","مجزوء الكامل"],[254,"لا تخف","https://www.aldiwan.net/poem25016.html","مجزوء الرمل"],[259,"ليس يخفى ما كان بالحب فاشي","https://www.aldiwan.net/poem35780.html","الخفيف"],[290,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[298,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[303,"يا لقومي من سطوة الترك سلوا","https://www.aldiwan.net/poem58002.html","الخفيف"],[320,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[328,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[328,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[353,"السعد أصبح كاملا بمحمد","https://www.aldiwan.net/poem40391.html","الطويل"],[364,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[366,"إن ينثروا الدر من مجد فما نثروا","https://www.aldiwan.net/poem17274.html","البسيط"],[369,"مات معز الدين من قبل أن","https://www.aldiwan.net/poem4301.html","السريع"],[371,"أرأيت ما سبقت إليه مخائلي","https://www.aldiwan.net/poem57236.html","الكامل"],[377,"كللت بالمجد بكر قد غدت","https://www.aldiwan.net/poem59127.html","الرمل"],[393,"مالي أرى قوما اذا سمعوا","https://www.aldiwan.net/poem53663.html","أحذ الكامل"],[393,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[402,"أفض عليك لبوس الصبر والجلد","https://www.aldiwan.net/poem46440.html","البسيط"],[409,"العجز لا ينقص رزقا ولا","https://www.aldiwan.net/poem31684.html","عموديه"],[409,"مثوبة الفاقد عن فقده","https://www.aldiwan.net/poem31930.html","السريع"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"عاد له الدهر كما قد بدا","https://www.aldiwan.net/poem12389.html","السريع"],[453,"مؤسس الدولة المرهوب جانبها","https://www.aldiwan.net/poem61383.html","البسيط"],[453,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[458,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[458,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[479,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[479,"مشاعر الحب نبض في مجاريها","https://www.aldiwan.net/poem37173.html","البسيط"],[479,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[479,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[558,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[558,"حرم آمن لكعبة قلبي","https://www.aldiwan.net/poem34955.html","الخفيف"],[562,"ذكر النقا فاهتز من ذكر النقا","https://www.aldiwan.net/poem52720.html","الكامل"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["كُلٌّ لَهُ فَضْلٌ عَلَيَّ","وَذَاكَ فَضْلٌ عَائِدٌ لَهْ",0,"ل",2,0],["كُلٍّ لَهَا بِنَفْسِهَا وَالجِسْمِ","عِنَايَةٌ عَنْ حِكْمَةٍ وَعِلْمِ",1,"م",1,0],["كل لحن إذا سمعناه منها","دبّ فينا دبيب بنت الحان",2,"ن",1,0],["كلُّ ليالي الزمانِ عُرْسٌ","وكلُّ أيامهنّ عيدُ",3,"د",1,0],["كلُّ لكلٍ في الشبا","ب وفي مَناعمه سَجيرُ",4,"ر",1,0],["كلَّلَتْ كفُّهُ سماءَ المعالي","بنجومِ المعروف والإحسان",5,"ن",1,0],["كُلٌّ لَهُ حاجَةٌ مِن وَصلِ صاحِبِهِ","لَولا يَسيرُ حَياءٍ كادَ يَقضيها",6,"ي",3,0],["كل له يوم وأنت بمرصد","لتصيّد الأحباب والأضداد",7,"د",1,0],["كُلٌّ لهُ في حبيبهِ أرَبٌ","لو سُئِلوا عن مَداهُ ما علِموا",8,"م",3,0],["كِللٌ لا تُحَطُّ عن أَظهُر العِي","س وعيسٌ لا يشتكينَ الكَلالا",9,"ل",2,0],["كُلٌّ لَهُ سَعيُهُ وَالسَعيُ مُختَلِفٌ","وَكُلُّ نَفسٍ لَها في سَعيِها شاءُ",10,"ا",2,0],["كُلٌّ لَهُ عِلَّةٌ يَفوهُ بِها","سُبحانَ رَبّي ما أَكثَرَ العِلَلا",11,"ل",2,0],["كُلٌّ لَهُ أَجَلٌ يُراوِغُهُ","وَيَحيدُ عَنهُ وَهوَ لازِمُهُ",12,"م",2,0],["كُلُّ لِسانٍ هُوَ في مُلكِهِ","بِالشُكرِ في إِحسانِهِ مُرتَهَن",13,"ن",1,0],["كلٌّ له ليلى ومن لم يَلقها","فحياته عبثٌ ومحضُ هباءِ",14,"ا",2,0],["كلٌّ له ليلى يرى في حبها","سرّ الدٌّنى وحقيقةَ الأشياءِ",14,"ا",2,0],["كلَّ لفظٍ أرقَّ مِن","ضحكة الزهر للدِّيم",15,"م",1,0],["كلُّ لحنٍ مذكرٍ","أشعل القلب فاضطرم",15,"م",1,0],["كلُّ لحنٍ في هدوءٍ شاملٍ","تشتهي النفسُ به أن تستعيدَه",16,"ه",1,0],["كلُّ لحنٍ لَجِبٍ يَغشَى دمي","لَعِبَ العازف بالعُودِ المُرِنّ",16,"ن",1,0],["كلٌّ لأشراكِ التحيّلِ ناصِبٌ","فاخلبْ بني دنياك إن لم تغلبِ",17,"ب",1,0],["كلّ لاهٍ عمّا يطيل شجاهُ","يملأ العينَ من رقادِ خليِّ",18,"ي",1,0],["كُلٌّ لِعَلياكَ قد كانَت حَمِيَّتُهُ","مؤكِّداً كلّ ما يأتي وما يَذرُ",19,"ر",1,0],["كلٌّ لِوجْهِكَ لَيسَ شَيءٌ غَيرُه","إلّا يصيرُ إلى بِلىً وَنَفادِ",20,"د",1,0],["كُلٌّ لَنا سَلَبٌ وَكُلٌّ قُوَّةٌ","نُرمى بِها إِن حُمَّ يَومٌ أَشهَبُ",21,"ب",1,0],["كُلٌّ لَهُ مَذهَبٌ يَرجو الفَلاحَ بِهِ","وَالحَقُّ يَعرِفُهُ ذو الفِطنَةِ اللَبِقُ",22,"ق",1,0],["كلٌّ له في العالَمين جَزاؤُه","ومِنَ الجماعةِ حَاكِمٌ لا يَظْلِمُ",23,"م",1,0],["كُلُّ لحمٍ من جُنودي ودمٍ","فهو لحمي يا ابن بشر ودمي",24,"م",2,0],["كلٌّ له من نفسهِ ضاربٌ","إن يُدبرِ الخوفُ بهِ يُقبلِ",25,"ل",1,0],["كُلٌّ له من سَراةِ المسلمينَ أخٌ","يَحمي الذِّمارَ ويرعى حُرمَةَ الجارِ",26,"ر",1,0],["كُلُّ لُؤمٍ وَعقوقٍ دونه","فعل شَمعون لَئيم الموصلِ",27,"ل",1,0],["كلٌّ لِما شاء الإِلهُ مُيَسَّر","والنَّاسُ بَيْنَ مُقَرَّب وَمُشَرَّدِ",28,"د",1,0],["كَلَّ لِساني عَن وَصفِ مَدحِكَ يا اِب","نَ الصيدِ وَاِستُضعِفَت قِوى هِمَمي",29,"م",2,0],["كِل لِمَن يُقصيكَ مِثلاً صاعَهُ","وَإِذا قارَبَ وُدّاً فَاِقتَرِب",30,"ب",1,0],["كُلٌّ لَهُ فَزَعٌ وَكُلٌّ جازِعٌ","يَبغي القَرارَ وَلا قَرارَ لِمُجرِمِ",31,"م",1,0],["كلل الشيب رأسه ببياض","زاده في عيني هناك جلالا",32,"ل",2,0],["كلُّ لحنٍ من الملاحن مهما","أبدعته أناملُ العزّافِ",33,"ف",1,0],["كُلٌّ لَدَيْكِ رَقِيقٌ","إِذَا قَسَا القَلْبُ أَوْ رَقّْ",34,"ق",1,1],["كلُّ ليلٍ لهُ زَوالٌ ولَيْلي","دقَّ أطنابَهُ لِغَيرِ زَوَال",35,"ل",1,0],["كلُّ ليل له نجومٌ ولكنْ","أينَ أمثالهُنَّ من أمثالي",35,"ل",2,0],["كلٌّ لهُ مأساتُهُ لا أرى","فَرْقَاً ولكنَّ المآسي ضُرُوب",36,"ب",1,0],["كلُّلنا ممتَثِلٌ من وَحيكم","ما يُريد الوَطنُ الحُرُّ امتِثالا",37,"ل",2,0],["كلُّ لياليكُمْ هنيئاً لكم","بيضٌ ، ودَهري كلُّه في مِحاق",38,"ق",1,0],["كلَّلتْ رأسَهُ \" الثّلوجُ \" ، ومسَّتْهُ","بأذيِالها مُتونُ السَّحاب",39,"ب",1,0],["كلّ لباناتي طيوف ورؤى","كأنّهنّ شطحات صوفي",40,"ف",2,0],["كلُّ لنوابِل معونة ٌ لمناله","عندَ الضرورة ِ زينة ٌ لمُنيله",41,"ل",2,0],["كل لفظ بعليه فحواه لكن","ليس الا بقائليه الكلام",42,"م",1,0],["كلٌّ لهُ طبع فلا تكُ لائما","وأمِل هَوَاك إلى المقالِ الأعدلِ",43,"ل",1,0],["كللت تيجان الطروس بلؤلؤ","من مدحكم وملأت هذي القافيهْ",44,"ي",2,0],["كَلَّلاني تَوِّجاني","وَبِشِعري غَنِّياني",45,"ي",1,0],["كلٌّ له في سعيِه مَذهبٌ","وكلُّ عيشٍ فله آلَهْ",46,"ل",2,0],["كلٌّ له يومَ الفخار مناقبٌ","ثمَّ الأكابرُ فضلُها لا يُدفَعُ",47,"ع",1,0],["كلٌّ له بك عمن حوله شغلٌ","وفكرة فيك تنسيه وتذهِلُهُ",48,"ل",2,0],["كلُّ لَيثٍ لا يرهبُ الموتَ لا تن","فَكّ منهُ إلى الوغى رغباءُ",49,"ا",2,0],["كلُّ لَيثٍ أمامهُ ألفُ ثورٍ","بَل ألوفٌ منهم وزد ما تشاءُ",49,"ا",2,0],["كُلِّلَ من إفرندِهِ جوهراً","ينهبُ أرواحاً ولا يُنْهَبُ",50,"ب",1,0],["كلٌّ له حَرَمٌ من صون صاحبه","ولن يُصاد مصونٌ يألف الحَرَما",51,"م",2,0],["كُلٌّ لصاحبه تُبلى سرائرهُ","بكلِّ ما أظهرا من بعد ما كتما",51,"م",2,0],["كل لفظٍ من حسين","هو روحٌ من حسين",52,"ن",1,1],["كلَّ لَيلٍ يا رَبِّ أَغمُرُ بِالدَمعِ","سَريري مِن أَجلِ تِلكَ الخطيَّه",53,"ه",1,0],["كُلَّ لَيلٍ أَرى خَيالَ ضَريحي","وَأَرى المَوتَ يستعدُّ خِلاله",54,"ل",2,0],["كُلُّ لَيلٍ يَمُرُّ يَسلُبُ مِنهُ","زَهراتٍ تَعهَّدَتها دِمائي",55,"ا",2,0],["كلّ لَيلٍ تَزورُها فَتُناجي","كَ طَويلاً في خِدرِها المُتَنائي",56,"ا",2,0],["كَلَّلْتَ ودَّك لي بالبِرّ والنَّفَلِ","لما بَعَثْتَ بما أَهْوَى مِن الكِللِ",57,"ل",1,1],["كُلٌّ لَهُ فَنٌّ وَقَل","بي المُستَهامُ هَواكَ فَنُّه",58,"ن",2,0],["كل لون من هوان","فيه ما يردي مشينُ",59,"ن",1,0],["كلّ لطفٍ وكلّ ظرفٍ وذوقٍ","ليس إلّا عن المحبّة ناشي",60,"ي",1,0],["كلّ لغايته مضى","يطوي حشاه على اكتئاب",61,"ب",1,0],["كلَّ لسانٌ صارمٌ","عنها وعينٌ مُبْصِره",62,"ر",2,0],["كل لحظٍ ومثله لكن الفت","ك تراه في الحرب للمكسور",63,"ر",1,0],["كُلٌّ لَهُ مِفضَلٌ مُختارُ","لا سِيَّما مُديرُهُ كَليار",64,"ر",1,0],["كل ليل لا بد يعقبه الفج","ر فلا تأخذي الحياة قطوبا",65,"ب",2,0],["كل لحن مخلّد من أغانيك","حياة الأرواح والأجسام",66,"م",1,0],["كُلُّ لَبيبٍ عارِفٌ بِسِرِّها","وَإِنَّم يُنكِرُ مَعناها الغُمُر",67,"ر",1,0],["كُلُّ لَبيبٍ رامَ كَشَفَ سَترُها","بِحَدسِهِ أَصبَحَ مَفضوحَ الحَصَر",67,"ر",1,0],["كُلٌّ لَهُ البُشرى لِأَنَّ قُلوبَنا","جَنّاتها تُسقى بِماء تودُّدِ",68,"د",1,0],["كُلٌّ له قَلْب ولا ألَمٌ","عَجَباً ولِي ألمٌ ولا قَلْب",69,"ب",1,0],["كُلٌّ لَهُ حاجَةٌ مِنّا بِصاحِبِهِ","فَالمَدحُ عِندي كَما المَعروفُ عِندَكُمُ",70,"م",1,0],["كل له دأب وأحرابه","عليه طول العمر من دابه",71,"ب",2,0],["كلٌّ لَهُ حِجرُ الرِّئاسَةِ مَولِدٌ","بِمراضعٍ مِن سِلكِها وقَوابِلِ",72,"ل",1,0],["كُلِّلَتْ بالمجد بِكرٌ قد غدت","في مصاف الرسْل نوراً وسلاما",73,"م",2,1],["كلٌّ لهُ فَضلٌ يَفوزُ بِهِ","وَالنَجمُ يقصرُ عن سَنا البَدرِ",74,"ر",1,0],["كُلٌّ لَهُ زادٌ يَدلُّ بِحملِهِ","وَولاكُم يَومَ القِيامَةِ زادُ",75,"د",1,0],["كلٌّ لَهُ عُمرٌ مُفْضٍ إلى أَجلٍ","متى أتى المرءَ لم ينقصْ ولم يزِدِ",76,"د",1,0],["كل له رزق سيأتيه ولا","زيادة فيه ولا نقص",77,"ص",1,0],["كلٌّ لهُ حَدٌّ إذا ما انتهَى","إليهِ وافَاهُ على حَدِّهِ",78,"د",2,0],["كلٌّ له ممَّا اعتراه صبابة","كبدٌ تذوب ومهجة تتسعر",79,"ر",1,0],["كلُّ لُبٍّ صاعدٍ في صَعْدَةٍ","قابضٍ منها بِلِيْتَيْ أَرْقَمِ",80,"م",1,0],["كَلَّل شَطَّيْهِ أُولُو هِمَّةٍ","مدَّتْ لهم في الطَّيِّباتِ المَدَى",81,"د",2,0],["كل له منزل حي ومؤتلف","وعزّة لم تكن وهما وتمويها",82,"ي",3,0],["كل له دورُهُ والكل تجربةٌ","تلهو الحياةُ بها في الصحو والحلمِ",83,"م",1,0],["كَلَّ لسانٌ أفصحت بشكره","أوابدُ القول على إعجامِها",84,"م",3,0],["كلّ ليثٍ مشى الرُّوَيدَ وخفَّف","تَ إلى سبقه خُفوفَ السِّمعِ",85,"ع",1,0],["كل لسانٍ ثنويٌّ مشرِكٌ","وهو لكم في شعره فردٌ صمدْ",86,"د",1,0],["كلُّ لدن المهزِّ يهدي لباغيك","وباغٍ جهلاً حياة وقتلا",87,"ل",2,0],["كل لذة حلم","تنجلي بها السحب",88,"ب",1,0],["كل لغيره قبل الود مفتقر","هو الحياة وهذا كل ما فيها",89,"ي",3,0],["كل لضوه جوهر فرد فلا","يبلى بتجزئة ولا استبعاض",90,"ض",1,0],["كللت أرجاؤه لا بالحرير","بل بأزهار كساها الازدهار",91,"ر",1,0],["كل له أهل وك","ل أخوة بالموجب",92,"ب",1,0],["كل لصاحبه الصدى","يحنو القرين على القرين",93,"ن",1,0],["كل له وطنية يجري بها","تياره الصافي مع الأنفاس",94,"س",1,0],["كلَّلَهُ المجدُ بتَاجِ عِزِّه","وهوَ بِعَرشِ كلِّ قَلبٍ مُرتَقِ",95,"ق",1,0],["كل لون على البياض يغطي","بانتقاص من السوى وازدياد",96,"د",1,0],["كل لطف من لطفه مستعار","وهو عني على الحقيقة يبني",97,"ي",1,0],["كلٌّ لهُ قلبٌ وقلبُ أخي الهَوَى","لَربيبِ قومٍ في هَواهُ تَعلَّقا",98,"ق",2,0],["كلُّ له مِن دَهْرِه مَقصِدٌ","وأَنْتَ مِنْ دُونِ الوَرى مَقْصِدي",99,"ي",1,0]]}