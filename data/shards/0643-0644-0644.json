oetsgate.com/ViewPoem.aspx?id=200520",""],[4816,"المعذره","https://www.poetsgate.com/ViewPoem.aspx?id=12851",""],[4578,"عيدٌ أعيد على الأنام مجدُ","https://www.poetsgate.com/ViewPoem.aspx?id=49393",""],[4931,"اجمل جميله","https://www.poetsgate.com/ViewPoem.aspx?id=37335",""],[4962,"خير قائد","https://www.poetsgate.com/ViewPoem.aspx?id=208975",""],[4968,"مرحّل الأوزار","https://www.poetsgate.com/ViewPoem.aspx?id=208096",""],[3271,"الشعاع المقيد","https://www.poetsgate.com/ViewPoem.aspx?id=104118",""],[5121,"مَلاَذ","https://www.poetsgate.com/ViewPoem.aspx?id=94051",""],[5136,"من في الملوك يقاس بالشمس","https://www.poetsgate.com/ViewPoem.aspx?id=121607",""],[5147,"إن الحياة وإن تمادى عمرها","https://www.poetsgate.com/ViewPoem.aspx?id=166745",""],[5190,"روح وريحان","https://www.poetsgate.com/ViewPoem.aspx?id=121512",""],[5219,"يا منحة الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=194996",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5409,"تأتي الحياة فترتدينا برهةً","https://www.poetsgate.com/ViewPoem.aspx?id=155301",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5413,"فبدأتُ حيثُ توقفواْ","https://www.poetsgate.com/ViewPoem.aspx?id=200584",""],[5436,"موال حب للعراق(للشاعرجميل حسين الساعدي)","https://www.poetsgate.com/ViewPoem.aspx?id=138980",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5461,"إمسح الدمعة","https://www.poetsgate.com/ViewPoem.aspx?id=6000",""],[5493,"كل له ظله","https://www.poetsgate.com/ViewPoem.aspx?id=197568",""],[5525,"ما لي على الحب سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=7263",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5608,"كل ليله","https://www.poetsgate.com/ViewPoem.aspx?id=33397",""],[5644,"أي شأن من شؤونك","https://www.poetsgate.com/ViewPoem.aspx?id=211271",""],[5703,"أخطأ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=206208",""],[5717,"يهدي الى الدين وناهيك به","https://www.poetsgate.com/ViewPoem.aspx?id=170594",""],[5725,"صبريني","https://www.poetsgate.com/ViewPoem.aspx?id=202933",""],[5848,"ابن حزن وجروح","https://www.poetsgate.com/ViewPoem.aspx?id=48951",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[5853,"انا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=175703",""],[5937,"كي لايحزن الفلاح","https://www.poetsgate.com/ViewPoem.aspx?id=211882",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[5976,"يا بو سعد ..","https://www.poetsgate.com/ViewPoem.aspx?id=35084",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[6089,"يا ابنَ ابتساماتي","https://www.poetsgate.com/ViewPoem.aspx?id=215727",""],[6102,"خَطٌّ أَحمَر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183988",""]],"verses":[["كُلٌّ لَهُ فَضْلٌ عَلَيَّ","وَذَاكَ فَضْلٌ عَائِدٌ لَهْ",0,"ل",2,0],["كُلٍّ لَهَا بِنَفْسِهَا وَالجِسْمِ","عِنَايَةٌ عَنْ حِكْمَةٍ وَعِلْمِ",1,"م",1,0],["كل لحن إذا سمعناه منها","دبّ فينا دبيب بنت الحان",2,"ن",1,0],["كلُّ ليالي الزمانِ عُرْسٌ","وكلُّ أيامهنّ عيدُ",3,"د",1,0],["كلُّ لكلٍ في الشبا","ب وفي مَناعمه سَجيرُ",4,"ر",1,0],["كلَّلَتْ كفُّهُ سماءَ المعالي","بنجومِ المعروف والإحسان",5,"ن",1,0],["كُلٌّ لَهُ حاجَةٌ مِن وَصلِ صاحِبِهِ","لَولا يَسيرُ حَياءٍ كادَ يَقضيها",6,"ي",3,0],["كل له يوم وأنت بمرصد","لتصيّد الأحباب والأضداد",7,"د",1,0],["كُلٌّ لهُ في حبيبهِ أرَبٌ","لو سُئِلوا عن مَداهُ ما علِموا",8,"م",3,0],["كِللٌ لا تُحَطُّ عن أَظهُر العِي","س وعيسٌ لا يشتكينَ الكَلالا",9,"ل",2,0],["كُلٌّ لَهُ سَعيُهُ وَالسَعيُ مُختَلِفٌ","وَكُلُّ نَفسٍ لَها في سَعيِها شاءُ",10,"ا",2,0],["كُلٌّ لَهُ عِلَّةٌ يَفوهُ بِها","سُبحانَ رَبّي ما أَكثَرَ العِلَلا",11,"ل",2,0],["كُلٌّ لَهُ أَجَلٌ يُراوِغُهُ","وَيَحيدُ عَنهُ وَهوَ لازِمُهُ",12,"م",2,0],["كُلُّ لِسانٍ هُوَ في مُلكِهِ","بِالشُكرِ في إِحسانِهِ مُرتَهَن",13,"ن",1,0],["كلٌّ له ليلى ومن لم يَلقها","فحياته عبثٌ ومحضُ هباءِ",14,"ا",2,0],["كلٌّ له ليلى يرى في حبها","سرّ الدٌّنى وحقيقةَ الأشياءِ",14,"ا",2,0],["كلَّ لفظٍ أرقَّ مِن","ضحكة الزهر للدِّيم",15,"م",1,0],["كلُّ لحنٍ مذكرٍ","أشعل القلب فاضطرم",15,"م",1,0],["كلُّ لحنٍ في هدوءٍ شاملٍ","تشتهي النفسُ به أن تستعيدَه",16,"ه",1,0],["كلُّ لحنٍ لَجِبٍ يَغشَى دمي","لَعِبَ العازف بالعُودِ المُرِنّ",16,"ن",1,0],["كلٌّ لأشراكِ التحيّلِ ناصِبٌ","فاخلبْ بني دنياك إن لم تغلبِ",17,"ب",1,0],["كلّ لاهٍ عمّا يطيل شجاهُ","يملأ العينَ من رقادِ خليِّ",18,"ي",1,0],["كُلٌّ لِعَلياكَ قد كانَت حَمِيَّتُهُ","مؤكِّداً كلّ ما يأتي وما يَذرُ",19,"ر",1,0],["كلٌّ لِوجْهِكَ لَيسَ شَيءٌ غَيرُه","إلّا يصيرُ إلى بِلىً وَنَفادِ",20,"د",1,0],["كُلٌّ لَنا سَلَبٌ وَكُلٌّ قُوَّةٌ","نُرمى بِها إِن حُمَّ يَومٌ أَشهَبُ",21,"ب",1,0],["كُلٌّ لَهُ مَذهَبٌ يَرجو الفَلاحَ بِهِ","وَالحَقُّ يَعرِفُهُ ذو الفِطنَةِ اللَبِقُ",22,"ق",1,0],["كلٌّ له في العالَمين جَزاؤُه","ومِنَ الجماعةِ حَاكِمٌ لا يَظْلِمُ",23,"م",1,0],["كُلُّ لحمٍ من جُنودي ودمٍ","فهو لحمي يا ابن بشر ودمي",24,"م",2,0],["كلٌّ له من نفسهِ ضاربٌ","إن يُدبرِ الخوفُ بهِ يُقبلِ",25,"ل",1,0],["كُلٌّ له من سَراةِ المسلمينَ أخٌ","يَحمي الذِّمارَ ويرعى حُرمَةَ الجارِ",26,"ر",1,0],["كُلُّ لُؤمٍ وَعقوقٍ دونه","فعل شَمعون لَئيم الموصلِ",27,"ل",1,0],["كلٌّ لِما شاء الإِلهُ مُيَسَّر","والنَّاسُ بَيْنَ مُقَرَّب وَمُشَرَّدِ",28,"د",1,0],["كَلَّ لِساني عَن وَصفِ مَدحِكَ يا اِب","نَ الصيدِ وَاِستُضعِفَت قِوى هِمَمي",29,"م",2,0],["كِل لِمَن يُقصيكَ مِثلاً صاعَهُ","وَإِذا قارَبَ وُدّاً فَاِقتَرِب",30,"ب",1,0],["كُلٌّ لَهُ فَزَعٌ وَكُلٌّ جازِعٌ","يَبغي القَرارَ وَلا قَرارَ لِمُجرِمِ",31,"م",1,0],["كلل الشيب رأسه ببياض","زاده في عيني هناك جلالا",32,"ل",2,0],["كلُّ لحنٍ من الملاحن مهما","أبدعته أناملُ العزّافِ",33,"ف",1,0],["كُلٌّ لَدَيْكِ رَقِيقٌ","إِذَا قَسَا القَلْبُ أَوْ رَقّْ",34,"ق",1,1],["كلُّ ليلٍ لهُ زَوالٌ ولَيْلي","دقَّ أطنابَهُ لِغَيرِ زَوَال",35,"ل",1,0],["كلُّ ليل له نجومٌ ولكنْ","أينَ أمثالهُنَّ من أمثالي",35,"ل",2,0],["كلٌّ لهُ مأساتُهُ لا أرى","فَرْقَاً ولكنَّ المآسي ضُرُوب",36,"ب",1,0],["كلُّلنا ممتَثِلٌ من وَحيكم","ما يُريد الوَطنُ الحُرُّ امتِثالا",37,"ل",2,0],["كلُّ لياليكُمْ هنيئاً لكم","بيضٌ ، ودَهري كلُّه في مِحاق",38,"ق",1,0],["كلَّلتْ رأسَهُ \" الثّلوجُ \" ، ومسَّتْهُ","بأذيِالها مُتونُ السَّحاب",39,"ب",1,0],["كلّ لباناتي طيوف ورؤى","كأنّهنّ شطحات صوفي",40,"ف",2,0],["كلُّ لنوابِل معونة ٌ لمناله","عندَ الضرورة ِ زينة ٌ لمُنيله",41,"ل",2,0],["كل لفظ بعليه فحواه لكن","ليس الا بقائليه الكلام",42,"م",1,0],["كلٌّ لهُ طبع فلا تكُ لائما","وأمِل هَوَاك إلى المقالِ الأعدلِ",43,"ل",1,0],["كللت تيجان الطروس بلؤلؤ","من مدحكم وملأت هذي القافيهْ",44,"ي",2,0],["كَلَّلاني تَوِّجاني","وَبِشِعري غَنِّياني",45,"ن",2,0],["كلٌّ له في سعيِه مَذهبٌ","وكلُّ عيشٍ فله آلَهْ",46,"ل",2,0],["كلٌّ له يومَ الفخار مناقبٌ","ثمَّ الأكابرُ فضلُها لا يُدفَعُ",47,"ع",1,0],["كلٌّ له بك عمن حوله شغلٌ","وفكرة فيك تنسيه وتذهِلُهُ",48,"ل",2,0],["كلُّ لَيثٍ لا يرهبُ الموتَ لا تن","فَكّ منهُ إلى الوغى رغباءُ",49,"ا",2,0],["كلُّ لَيثٍ أمامهُ ألفُ ثورٍ","بَل ألوفٌ منهم وزد ما تشاءُ",49,"ا",2,0],["كُلِّلَ من إفرندِهِ جوهراً","ينهبُ أرواحاً ولا يُنْهَبُ",50,"ب",1,0],["كلٌّ له حَرَمٌ من صون صاحبه","ولن يُصاد مصونٌ يألف الحَرَما",51,"م",2,0],["كُلٌّ لصاحبه تُبلى سرائرهُ","بكلِّ ما أظهرا من بعد ما كتما",51,"م",2,0],["كل لفظٍ من حسين","هو روحٌ من حسين",52,"ن",1,1],["كلَّ لَيلٍ يا رَبِّ أَغمُرُ بِالدَمعِ","سَريري مِن أَجلِ تِلكَ الخطيَّه",53,"ه",1,0],["كُلَّ لَيلٍ أَرى خَيالَ ضَريحي","وَأَرى المَوتَ يستعدُّ خِلاله",54,"ل",2,0],["كُلُّ لَيلٍ يَمُرُّ يَسلُبُ مِنهُ","زَهراتٍ تَعهَّدَتها دِمائي",55,"ا",2,0],["كلّ لَيلٍ تَزورُها فَتُناجي","كَ طَويلاً في خِدرِها المُتَنائي",56,"ا",2,0],["كَلَّلْتَ ودَّك لي بالبِرّ والنَّفَلِ","لما بَعَثْتَ بما أَهْوَى مِن الكِللِ",57,"ل",1,1],["كُلٌّ لَهُ فَنٌّ وَقَل","بي المُستَهامُ هَواكَ فَنُّه",58,"ن",2,0],["كل لون من هوان","فيه ما يردي مشينُ",59,"ن",1,0],["كلّ لطفٍ وكلّ ظرفٍ وذوقٍ","ليس إلّا عن المحبّة ناشي",60,"ش",2,0],["كلّ لغايته مضى","يطوي حشاه على اكتئاب",61,"ب",1,0]