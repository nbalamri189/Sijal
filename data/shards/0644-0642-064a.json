oem9857.html","المتقارب"],[512,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[513,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[513,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[513,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[513,"قد كان حبي محض","https://www.aldiwan.net/poem12302.html","المجتث"],[536,"مما ابتلى الله به مراكشا","https://www.aldiwan.net/poem48194.html","عموديه"],[541,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[549,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[551,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[551,"بنو حنيفة لا يرضى الدعي بهم","https://www.aldiwan.net/poem68389.html","البسيط"],[551,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[554,"ما شئتما الآن للزمان","https://www.aldiwan.net/poem2484.html","مخلع البسيط"],[556,"لمن طلل بين الأجارع بالي","https://www.aldiwan.net/poem33537.html","الطويل"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[560,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"],[573,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"]],"verses":[["لَقينَ قُلوبَنا بِجُنودِ حَربٍ","تَطاعَنُ بِالدَمالِجِ وَالبُرينا",0,"ن",2,0],["لَقيتُ ظَلامَ اللَيلِ في لَونِ مَفرَقي","وَفارَقتُهُ وَالصُبحُ في لَونِ صارِمي",1,"م",2,0],["لَقيتُ مِنَ المُقامِ عَلى الأَماني","كَما لَقِيَ الطُموحُ مِنَ الصِقاعِ",2,"ع",1,0],["لَقيتُ الأَرضَ شاحِبَةَ المُحَيّا","تَلاعَبُ بِالضَراغِمِ وَالذِئابِ",3,"ب",1,0],["لَقيتُكَ في صَدرِهِ شاحِباً","وَمِن حِليَةِ العَرَبيِّ الشَحوبُ",4,"ب",1,0],["لِقَيسيَّةٍ لا ذِكرُها فاضِحٌ أَباً","وَلاوَجهُها نُهبى العيونِ الرَّوامِقِ",5,"ق",1,0],["لَقًى دونَ أدنى شأْوِهِ كلُّ طالِبٍ","وهلْ غايَةٌ ضَمَّتْ حُبارى وأجْدَلا",6,"ل",2,0],["لقيت ولي العهد دنياها كم","لقي العطشان الجدول المترنما",7,"م",2,0],["لَقينا يَومَ صَهباءٍ سَرِيَّه","حَناظِلَةً لَهُم في الحَربِ نِيَّه",8,"ي",2,1],["لَقيناهُم بِأَسيافٍ حِدادٍ","وَأُسدٍ لا تَفِرُّ مِنَ المَنِيَّه",8,"ي",2,0],["لَقِيَ اللَهَ رَبَّهُ فَاِترُكوا المَر","ءَ لِدَيّانِهِ فَسيحِ الرِحابِ",9,"ب",1,0],["لَقِيَتْكَ حَاضِرَةُ البِلادِ لَقَاءهَا","لأَجَلِّ ذِي حَقٍ عَلَى الأَوْطَانِ",10,"ن",1,0],["لَقَيَتْكَ مِصْرُ وَمَا تَغَالَتْ مُلْتَقَىً","أُمٍّ لأَيْرَارِ مِنَ الوُمدَانِ",11,"ن",1,0],["لَقَيْتَ مُنْفَرِداً فِيهَا العَنَاءَ وَمَا","نَسَيْتَ فِي الغَنْمِ حَظَّ البَائِسِ العَانِي",12,"ن",2,0],["لَقِيَ الْحَتْفَ وَالأَسَى عَمَمٌ","عَلَمٌ مِنُ مَفَاخِرٍ الزَّمَنِ",13,"ن",1,0],["لَقِيَ النَّعِيمَ السَّرْمَدِيَّ جَزَاءَ مَا","عَانَاهُ فِي جِدٍّ وَفِي إِيْمَانِ",14,"ن",1,0],["لَقِيَتْكَ مِصْرُ بِثَغْرِهَا المُتَبَسِّمِ","وَتَنَوَّرَتْ بِضِيَائِكِ المُتَوَسَّمِ",15,"م",1,1],["لَقىً بَينَ أَجمادٍ وَجَرعاءَ نازَعَت","حِبالاً بِهِنَّ الجازِئاتُ الأَوابِدُ",16,"د",1,0],["لقيتُك في غرب وأنت رئيسه","وبابُك للأعلام مجتمعُ الوفدِ",17,"د",1,0],["لقيتها ليتني ما كنت القاها","تمشي وقد أثقل الأملاق ممشاها",18,"ا",3,1],["لَقى الأُخَيطِلُ بِالجَولانِ فاقِرَةً","مِثلَ اِجتِداعِ القَوافي وَبرَ هِزّانا",19,"ن",2,0],["لَقيتُم عامِراً وَبَني سُلَيمٍ","عَلى عَلياءَ مُشرِفَةِ الرِعانِ",20,"ن",1,0],["لَقيتُم بِأَيدي عامِرٍ مَشرَفِيَّةً","تَعَضُّ بِهامِ الدارِعينَ وَتَجرَحُ",21,"ح",1,0],["لَقيتَهُمُ وَخَيلُهُمُ سِمانٌ","بِساهِمَةِ النَواظِرِ وَالخُدودِ",22,"د",1,0],["لَقيتَ لَنا بَوازِيَ ضارِياتٍ","وَطَيرُكَ في مَجاثِمِها لُبودُ",23,"د",1,0],["لَقيتَ القُرومَ الخاطِراتِ فَلَم يَكُن","نَكيرُكَ إِلّا أَن تَشولَ وَتَيعَرا",24,"ر",2,0],["لَقيتَ شُجاعاً لَم تَلِدهُ مُجاشِعٌ","وَأَخوَفُ حَيّاتِ الجِبالِ ذُكورُها",25,"ر",3,0],["لَقِيَ الأُخَيطِلُ أُمَّهُ مَخمورَةً","قُبحاً لِذَلِكَ شارِباً مَخمورا",26,"ر",2,0],["لَقِيَ الأُخَيطِلُ ما لَقيتَ وَقَبلَهُ","طاحَ البَعيزُ بِغَيرِ عِرضٍ وافِرِ",27,"ر",1,0],["لَقَيتُم بِالجَزيرَةِ خَيلَ قَيسٍ","فَقُلتُم مارَ سَرجِس لا قِتالا",28,"ل",2,0],["لَقيتَ لَنا حَوامِيَ راسِياتٍ","وَجولاً يَرتَمي بِكَ بَعدَ جولِ",29,"ل",1,0],["لقينا بها ثلباً ضريراً كأنه","إلى كل من ألاقي من الناس مذنبُ",30,"ب",1,1],["لَقيتُ نُجومَ الأُفقِ وَهيَ صَوارِمٌ","وَخُضتُ سَوادَ اللَيلِ وَهوَ خُيولُ",31,"ل",1,0],["لَقَيناهُم بِأَسيافٍ قِصارٍ","كَفَينَ مَؤونَةَ الأَسَلِ الطِوالِ",32,"ل",1,0],["لَقيناهُم بِها لَمّا سَمَونا","وَنَحنُ عِصابَةٌ وَهُمُ أُلوفُ",33,"ف",1,0],["لقِيتُ من البَرِّ التّباريحَ بعدما","لقيتُ من البحر ابيضاضَ الذوائبِ",34,"ب",1,0],["لقيتُ البَرْحَ يوماً من لقاءٍ","له قاسٍ ويوماً من حِجابِهْ",35,"ب",2,0],["لقي التجارب غانياً عن عُونها","بقريحةٍ أذكى من النبراس",36,"س",1,0],["لقي الأنامِلَ والمراضع مُقدِماً","لم يَنهزمْ عنها بأجرٍ حابط",37,"ط",1,0],["لقيت أم ربيق","وسوف تلقى رُبيقا",38,"ق",2,0],["لقى طافياً مثلَ الجزيرةِ فوقَهُ","أبابيل شتى من نسورٍ ومن رخمْ",39,"م",1,0],["لقى الناسُ من زناهُنَّ شرّاً","فهُمُ بين جافر وسقيم",40,"م",1,0],["لقي الراحة التي كان نزا","عاً لها في عشيه والبكور",41,"ر",1,0],["لقينا في الزريبة يوم نصر","كيوم التل في تاريخ مصر",42,"ر",1,0],["لَقِيَت طُهرَ بَقاياكِ كَما","لَقِيَت يَثرِبٌ أُمَّ المُؤمِنين",43,"ن",1,0],["لَقِيَ الحَديدُ حَمِيَّةً أَمَوِيَّةً","لا تَكتَسي صَدَأً وَلا هِيَ تُطرَقُ",44,"ق",1,0],["لَقيتَ الدَواهِيَ مِن كَيدِها","وَما كَالسِياسَةِ داهٍ يَكيد",45,"د",1,0],["لَقِيَ الرِجالُ الحادِثاتِ بِصَبرِهِم","حَتّى اِنجَلَت غُمَمٌ لَها وَغِمارُ",46,"ر",1,0],["لَقيتِ عَليماً بِالغَواني وَإِنَّما","هُوَ القَلبُ كَالإِنسانِ يُغرى وَيُخدَعُ",47,"ع",1,0],["لَقيتَ الَّذي لَم يَلقَ قَلبٌ مِنَ الهَوى","لَكَ اللَهُ يا قَلبي أَأَنتَ حَديدُ",48,"د",1,0],["لَقينا في عَدُوِّكَ ما لَقينا","لَقينا الفَتحَ وَالنَصرَ المُبينا",49,"ا",1,0],["لَقيتَ القَنا عَنهُ بِنَفسٍ كَريمَةٍ","إِلى المَوتِ في الهَيجا مِنَ العارِ تَهرُبُ",50,"ب",1,0],["لَقى لَيلٍ كَعَينِ الظَبيِ لَوناً","وَهَمٍّ كَالحُمَيّا في المُشاشِ",51,"ش",1,0],["لَقيتَ العُفاةَ بِاّمالِها","وَزُرتَ العُداةَ بِآجالِها",