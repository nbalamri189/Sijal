{"poems":[[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67015","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132651","السريع"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121424","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""]],"verses":[["إيهِ اِسبيرِيا فَدَتكِ الجَواري","مَنشَآتٍ كَأَنَّهُنَّ القُصورُ",0,"ر",1,0],["أيها سألت تجد","آيها التي كتبا",1,"ب",2,0],["إيْها سَقَطْتَ على الخَبِيْرِ بِحَالِهِمْ","عند العَرُوْضِ حَقَائِقُ الأَوْزَانِ",2,"ن",1,0],["أيها سيوف العرب لا تضربي","غير طلى أعدائك الطامعه",3,"ع",2,1],["إيهاً سليمانُ بن فه","دٍ والحديثُ له شجونُ",4,"ن",1,0],["إيه أَسماي وَالمحبُّ وَلوعٌ","بِلِقاءِ الحَبيب في كلّ حالِ",5,"ل",1,0],["إيهِ أَسماي وَالمحبُّ حَزينٌ","كَامِنُ الغمّ ساهِرٌ لِليالِ",5,"ل",1,0],["إيه أَسمايَ زادكِ اللَهُ فَضلاً","وَكَمالاً وَأَنتِ تاجُ الكَمالِ",5,"ل",1,0],["إيه أسماء لا تكوني حطاما","أو هشيما تعيث فيه الشاء",6,"ا",2,0],["إيه أسماء لا تنامي على الحد","باء حتى تحفّها حواء",6,"ا",2,0],["\"إيه \"\"أسما\"\"! أهلا وسهلا بأسمى\"","كوكب أنعش الفؤاد حلولا",7,"ل",2,0],["\"إيه \"\"أسما\"\" أهلا، ومرحى لقلب\"","بات من نفس نوره مأهولا",7,"ل",2,0]]}