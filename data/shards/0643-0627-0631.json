{"poems":[[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[87,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[199,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[382,"لك الله من علم إلى الحق رافع","https://www.aldiwan.net/poem59347.html","الطويل"],[409,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[466,"وأنيقة أنف يضوع طيبها","https://www.aldiwan.net/poem15169.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38399","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141423","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88893","الكامل"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45540","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76496","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77183","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52158","الطويل"],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[5431,"وكانت له قطفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=197851",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""]],"verses":[["كَأَركانِ سَلمى إِذ بَدَت وَكَأَنَّها","ذُرى أَجَإٍ إِذ لاحَ فيها مُواسِلُ",0,"ل",1,0],["كاروا العمائم واقلولَوا على شُعَبٍ","وأقبلوا بين أكوارٍ وأكوار",1,"ر",1,0],["كَأُرغُنِ الدَيرِ إِكثاري وَمَوقِعُهُ","وَكَالأَذانِ عَلى الأَسماعِ إِقلالي",2,"ل",2,0],["كارِثةٌ أَعْظَمَهَا دهْرُهَا","وَمِثْلُهَا تُعْظِمَهُ الأَدْهُرُ",3,"ر",1,0],["كَأَرضٍ تَنزَعُ ما أَنتبَتَت","وَكانَ لَها مَرَّةً زُخرُفُ",4,"ف",1,0],["كآرائِهِ رَايَاتُهُ في عُلوُهِّا","لَها خالِدُ الإقْبالِ إلفٌ مؤَازِرُ",5,"ر",1,0],["كأريوسَ نسطورٍ وبيروسَ بالما","ومع فُوِتيُسْ يعقوبُ ذاك البرادعي",6,"ع",2,0],["كارهاً فارقتها وأباً","قطب أهل الأرض في بلده",7,"د",2,0],["كأريج عرض ابن الحسين وذكره","في العَمِّ إذ تُتْلى عُلاهُ ومجدهُ",8,"د",2,0],["كَأَرضٍ بِها البطّيخُ لَو قَد زَرعته","يَصيرُ بِها البطّيخُ لا شَكّ حَنظَلا",9,"ل",2,0],["كارم لها الغيث واستشهد لها بندى","الجواد ثمَّ اروِ كيف الغيث قد لؤما",10,"م",2,0],["كآرامِ الصَّرِيمةِ أو مَهاها","وليسَ سِوَى الرِّماحِ لها قُرُون",11,"ن",1,0],["كأربعين من جرارٍ إذا","قدرتها من أوسطِ الجرِّ",12,"ر",1,0],["كأ رءوس الخزرجيين غدوة","وأيمانهم بالمشرفية بَرْوَقُ",13,"ق",1,0],["كأَراقمٍ عَطشى تَدَلَّت وارِداً","أَو فاتِحاً لِلورد منها فاهُ",14,"ا",2,0],["كاره غش ساد طه سطوة","ما مثله حكماً ولا يأتي علا",15,"ل",2,0],["كَأَرشاشِ غَربٍ بَينَ قَرني محالَةٍ","مقحمهُ دامي السَلائِقِ ناضِحُ",16,"ح",1,0],["كارض ترينا زهرة فنشمها","فيسحرنا من زهرة الأَرض طيبها",17,"ب",3,0],["كَأَرزَةِ طَودٍ وَحَورَتِهِ","وَمَلّولَةٍ فَوقَ قُنَّتِهِ",18,"ه",1,0],["كَآريسَ في بَأسِهِ اِندَفَقا","وَأَنياسُ عامِلُهُ سَبَقا",18,"ق",2,0],["كآرِيسَ يَمشي على قَومِ إِنسِ","إِلى الوَيلِ سِيقُوا بِفِتنَةِ زَفسِ",19,"س",1,0],["كَآرِسٍ مِن بابِهِ صاحَ وَما","رُمتَ اِبنَ فيلامِنِ نِداءي لِلحِما",20,"م",2,0],["كَإِرغامٍ بَصيراً أَو بِعَجز","عَنِ الإِدراكِ مِن إِقلال وَفر",21,"ر",1,0],["كأرضٍ سقتها بعد جدب سحائبٌ","فأمرَعَ منها روضُها والفدافدُ",22,"د",1,0],["كارِعاً من زُلالِها لا بِجامٍ","فهي ساقٌ وسَلْسَبيلٌ وجامُ",23,"م",1,0],["كارثةٌ بالبلادِ قد عصفَتْ","لم تُبقِ شيئاً بها ولم تَذَرِ",24,"ر",1,0],["كأرواح النسيم بها اعتلال","وقد طبعت بألفاظ صحاح",25,"ح",1,0],["كأرض له جادت بنخل قصيدة","على كفه نامت وكانت له قطفا...",26,"ف",2,0],["كار النشامى يالخوي عادة ٍ لي","نبغى الفخر قبل يجي مالك الموت",27,"ت",1,0]]}