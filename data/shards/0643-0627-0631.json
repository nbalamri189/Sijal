{"poems":[[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[193,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[273,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[374,"لك الله من علم إلى الحق رافع","https://www.aldiwan.net/poem59347.html","الطويل"],[400,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[459,"وأنيقة أنف يضوع طيبها","https://www.aldiwan.net/poem15169.html","الكامل"]],"verses":[["كَأَركانِ سَلمى إِذ بَدَت وَكَأَنَّها","ذُرى أَجَإٍ إِذ لاحَ فيها مُواسِلُ",0,"ل",1,0],["كاروا العمائم واقلولَوا على شُعَبٍ","وأقبلوا بين أكوارٍ وأكوار",1,"ر",1,0],["كَأُرغُنِ الدَيرِ إِكثاري وَمَوقِعُهُ","وَكَالأَذانِ عَلى الأَسماعِ إِقلالي",2,"ي",1,0],["كارِثةٌ أَعْظَمَهَا دهْرُهَا","وَمِثْلُهَا تُعْظِمَهُ الأَدْهُرُ",3,"ر",1,0],["كَأَرضٍ تَنزَعُ ما أَنتبَتَت","وَكانَ لَها مَرَّةً زُخرُفُ",4,"ف",1,0],["كآرائِهِ رَايَاتُهُ في عُلوُهِّا","لَها خالِدُ الإقْبالِ إلفٌ مؤَازِرُ",5,"ر",1,0],["كأريوسَ نسطورٍ وبيروسَ بالما","ومع فُوِتيُسْ يعقوبُ ذاك البرادعي",6,"ع",2,0],["كارهاً فارقتها وأباً","قطب أهل الأرض في بلده",7,"د",2,0],["كأريج عرض ابن الحسين وذكره","في العَمِّ إذ تُتْلى عُلاهُ ومجدهُ",8,"د",2,0]]}