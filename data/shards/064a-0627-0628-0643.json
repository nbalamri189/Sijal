{"poems":[[39,"يا بكر بكرين ويا خلب الكبد","https://www.aldiwan.net/poem6923.html","الرجز"],[23,"ما بال عيني لا تنام كأنما","https://www.aldiwan.net/poem21397.html","الكامل"],[58,"يا بكر ما فعلت بك الأرطال","https://www.aldiwan.net/poem58518.html","الكامل"],[50,"يا من له في عينه عقرب","https://www.aldiwan.net/poem10815.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64073","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131581",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32894","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125859","الرمل"],[4668,"","https://poetry.dctabudhabi.ae/diwan/poem/199420","المنسرح"],[4755,"السلام على ثأري الهارب","https://www.poetsgate.com/ViewPoem.aspx?id=201770",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""]],"verses":[["يا بِكر بِكْرين ويا خِلْبَ الكبِد","أصبحت مني كذراع في عَضُدْ",0,"د",1,1],["يا بِكرَ آمِنَةَ المُبارَكَ ذِكرُهُ","وَلَدَتكَ مُحصَنَةٌ بِسَعدِ الأَسعَدِ",1,"د",1,0],["يا بَكْرُ ما فَعلتْ بِكَ الأَرْطالُ","يا دارَ ما فَعلتْ بكِ الأَيّامُ",2,"م",1,1],["يا بَكرُ مَن سَمَّيتُهُ سَيِّدي","مَلُحتَ لي جِسماً فَما تَعذُبُ",3,"ب",1,0],["يا بكاءً أفنى مآقيَّ حتى","إِن عيني تبكي بغير مآقي",4,"ق",2,0],["يا بَكْرُ قَدْ عَجَّلْتَ لَوْماً باكِرَا","يَتْرُكُ فِي القَلْبِ سُعَاراً ساعِرَا",5,"ر",2,1],["يا بكا طرفي على تلك الطلولْ","لم يعد من بعدها في العين ضَوْ",6,"و",1,0],["يا بكيل الجناحين عواد يا قوم عواد","قبل ريح العذاب الضريره",7,"ر",2,0],["يا بُكرَةَ الثَكلى إِلى حُفرَةٍ","مُستَودَعٍ فيها عَزيزٌ الثُكول",8,"ل",1,0],["يا بكابيشَ بمصر سيطروا","مثلما سيطر فيها أولوها",9,"و",3,0],["يا بكر حواء كم تعيش وكم","تسحب ذيل الحياة يا لبد",10,"د",1,0],["يا بُكَاءَ الثلاثِينَ مليونَ في","حُلكَةِ البُؤسِ يَبْيَضُّ في شارِبِي",11,"ب",2,0],["يا بِكْرَ يائسةِ الدهو-","-رِ أَمَضَّهَا فَقْدُ الْوَليدِ",12,"د",1,0]]}