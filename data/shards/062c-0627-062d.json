{"poems":[[259,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[458,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[458,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[469,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[469,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56704","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66298","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[5495,"تبارينه ذمم","https://www.poetsgate.com/ViewPoem.aspx?id=175422",""]],"verses":[["جاحدٌ، نِدٌّ،فؤادي","أيُّ جِنّ فيك جان؟",0,"ن",1,0],["جاحِداً وَجْدي بهم من حَذَرٍ","حين تَرميني عيونُ الرُّقَباء",1,"ا",2,0],["جاحدي يعلن الهزيمة لاقا","ها فما كان طعنه في طعني",2,"ن",2,0],["جاحد الحق له الخسر فما","يخسر الحق جحودا حذفه",3,"ف",2,0],["جاحدٌ في الهوى دمي","وبهِ نمَّ خدُّه",4,"د",2,0],["جاحدٌ ديني فإنْ أثبتهُ","شاهدُ السَّقمِ تمادى ومطل",5,"ل",1,0],["جاحِظاتٌ ، ولِلشَّواطيءِ آذانٌ","وَلِلحَقِّ صَرخة ٌ لا تُعاقُ",6,"ق",1,0],["جاحظة جحظتها فتنة","تشقى بها الحوراء والأحورُ",7,"ر",1,0],["جاحدُهُ يُزَجُّ في قعر لظىً","يوم الجزا ولا نجوت إذ نجا",8,"ج",2,0],["جاحدَ فرضٍ آكلاً حراما","لكن يُصلِّي جُنُباً في الحان",9,"ن",1,0],["جا حتى السمج بالكاع خلاه","لاكن كلنه نعرف هاي متصير",10,"ر",1,0]]}