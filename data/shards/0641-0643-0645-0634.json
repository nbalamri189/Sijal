{"poems":[[49,"لمن جاهد الحساد أجر المجاهد","https://www.aldiwan.net/poem25321.html","الطويل"],[93,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[91,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[87,"يا مكس دنياك عاره","https://www.aldiwan.net/poem7115.html","المجتث"],[47,"فداؤك نفسي دون رهطي ومعشري","https://www.aldiwan.net/poem63567.html","الطويل"],[47,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[63,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[99,"يا رامي السهم يدري أين موضعه","https://www.aldiwan.net/poem24998.html","البسيط"],[76,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[50,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[78,"هو الفتح منظوما على إثره الفتح","https://www.aldiwan.net/poem39462.html","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54278","البسيط"],[138,"حتى متى نحن على فترة","https://www.aldiwan.net/poem21028.html","السريع"],[164,"يساري في يمينك لا تزال","https://www.aldiwan.net/poem58723.html","الخفيف"],[164,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[173,"لا عز إلا بحد الصارم الذكر","https://www.aldiwan.net/poem1630.html",""],[190,"أف لهذا الزمان من نكده","https://www.aldiwan.net/poem43886.html","المنسرح"],[201,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[264,"نهارا تجلى الحق في ليلة السبت","https://www.aldiwan.net/poem35961.html","الطويل"],[275,"من أين للكوكب السيار أن يقفا","https://www.aldiwan.net/poem35062.html","البسيط"],[275,"أتضمد جرحا وتمسح دمعا","https://www.aldiwan.net/poem35212.html","المتقارب"],[275,"عديني أفي الدنيا أقل من الوعد","https://www.aldiwan.net/poem35448.html","الطويل"],[275,"تفتحت الدنيا وقلبك مغلق","https://www.aldiwan.net/poem35602.html","الطويل"],[275,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[285,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[396,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[438,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[556,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[572,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122703","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96998","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38389","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138717",""],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100625","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56265","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56041","الوافر"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78166","السريع"],[1501,"","https://poetry.dctabudhabi.ae/diwan/poem/146657","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79959","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108725","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100448","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89533","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67196","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93539","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65967","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202410","المنسرح"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134199","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133983","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91545","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[3770,"","https://poetry.dctabudhabi.ae/diwan/poem/111346","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101353","الهزج"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105126","الطويل"],[4270,"","https://poetry.dctabudhabi.ae/diwan/poem/124283","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73271","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133093","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4767,"الأتست (قسم اعتماد الصرف)","https://www.poetsgate.com/ViewPoem.aspx?id=88157",""],[4927,"أَحْلاْمُ الْعِشْق","https://www.poetsgate.com/ViewPoem.aspx?id=29948",""],[4984,"نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=183238",""],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5111,"زَهْراءُ قَرْطَاجَ","https://www.poetsgate.com/ViewPoem.aspx?id=212239",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5491,"خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=215330",""],[5616,"الحمدُ لله","https://www.poetsgate.com/ViewPoem.aspx?id=205246",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5956,"صانعة الدساتير المجيدة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182608",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[3792,"صبا قلبي لليلى ولم تعرف","https://www.poetsgate.com/ViewPoem.aspx?id=129245",""],[5190,"الزاهية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85079&r=&rc=154",""]],"verses":[["فَكَم شالَني مِن قَعرِ ظَلماءَ لَم يَكُن","لِيُنقِذَني مِن قَعرِها حَشدُ حاشِدِ",0,"د",1,0],["فَكَم شَقِيَت في ذي الحَياةِ فَضائِلٌ","وَكَم نَعِمَت في ذي الحَياةِ عُيوبُ",1,"ب",1,0],["فكم شبابٍ من الأحرار قد هلكوا","وللإرادات قد صاروا قرابينا",2,"ن",2,0],["فكم شهدت قتالا","وكم تورّدت غاره",3,"ر",2,0],["فَكَم شِعبِ جودٍ يَصغُرُ البَحرُ عِندَهُ","تَوَرَّدتُهُ مِن سَيبَكَ المُتَفَجِّرِ",4,"ر",1,0],["فَكَم شَذرَةٍ ثَمَّ مَنسِيَّةٍ","أُطيحَت وَكَم نَغمَةٍ مُدغَمَه",5,"م",2,0],["فكَمْ شُجاعٍ شَرَى للهِ مُهْجَتَه","فأكرَهَ الرُّمْحَ حتَّى احمرَّ عامِلُه",6,"ل",2,0],["فكم شفاه جراحات إذا انطبقت","جرح الإباء عليها غير ملتئم",7,"م",1,0],["فَكَم شاقَني مِن مَنظَرٍ فيكَ رائِقٍ","هَزَزتُ لَهُ مِن مِعطَفِ السُكرِ صاحِيا",8,"ي",2,0],["فَكَم شَديدٍ بِهِ قَد","دَفَعتُ خَوفَ شَديدِه",9,"د",2,0],["فكم شاربٍ منكمْ صحا بعدَ سُكرهِ","وما كانَ لولا السيفُ من سُكرهِ يَصْحو",10,"ح",2,0],["فَكَم شاقَني مِن بَعدِ نَأيٍ وَهِجرَةٍ","خَيالٌ لِشَرٍّ بِالدُجَيلِ غَريبُ",11,"ب",1,0],["فَكَمْ شَقَقْتُ فُؤَادَ الْبِيد مُنْصَلِتاً","مَنْ يَطْلُب المَجْدَ لاَ يَبْخَلْ بِمَجْهُودِ",12,"د",1,0],["فَكَم شَهِدتُ الحَربَ في فِتيَةٍ","عِندَ الوَغى في عِثيَرِ القَسطَلِ",13,"ل",1,0],["فكم شملت وما حنثت بقولٍ","ولا اسطاعت تجاريها الشمالُ",14,"ل",1,0],["فكم شر أَتى سبباً لخير","وكسْرٍ كان عقباه انجبارا",15,"ر",2,0],["فَكَم شَأى شاءٍ العَليا فَأَحرَزَها","أَبو سِنانٍ جَميلُ الذِكرَ وَالسّيرِ",16,"ر",1,0],["فكم شريف الآباء ذي كرم","يعحر عن قوت يومه وغده",17,"د",2,0],["فكم شكوت ولكن لم أجد أحدا","يصغي فأبكي وهل تروي الدموع صدى",18,"د",2,0],["فكم شاعرٍ لا عن شعورٍ بحبّه","غدا بين سبتٍ في الصبابة والسبت",19,"ت",1,0],["فكم شكا فاقةً من كان في سعةٍ","وكم مَشى مترفاً من آلفَ الشظفا",20,"ف",2,0],["فكم شقيَت وشقيتُ وكلٌّ","يُكفكِفُ دَمعاً ويسترُ صدعا",21,"ع",2,0],["فكم شاقني نورُ المقاصيرِ في الدُّجى","ولذَّةُ عَيني في التنوُّرِ والسُّهد",22,"د",1,0],["فكم شاقَني الوادي الذي لِهَديرهِ","طَربنا وأستارُ الظّلامِ تمزَّق",23,"ق",1,0],["فكم شاعرٍ فيها تبسّمَ أو بكى","وقد جاءَها في نزهة أو عبادة",24,"ه",1,0],["فَكَمْ شادٍ لَها طَرِبٍ وَحادٍ","بها غَرِدٍ بُكُوراً وادِّلاجا",25,"ج",2,0],["فكم شر كفيت وكم كروب","زويت وما يقي من تلك آثار",26,"ر",1,0],["فكم شَعْشَعَتْ خَدَّاهُ لي من مُدامةٍ","أَدَرْت عليها البابِلِيَّ المُشَعْشَعَا",27,"ع",2,0],["فكَمْ شافِعٍ فِي ظِلِّكَ الصَّوْمَ بالتُّقى","وكَمْ واصِلٍ فِي أَمْنِكَ اللَّيْلَ بالذِّكْرِ",28,"ر",1,0],["فكم شتّ شملَ هوى جامعٍ","ونفَّر من ساكنٍ مطمئنّ",29,"ن",1,0],["فَكَم شاهدتُ قَبلك من رجالٍ","ودِدْتُ لأجلهمْ ما كان حِسّي",30,"س",2,0],["فَكَمْ شُبَهٍ بِهُدَاهُ جَلاَ","وَكَمْ حُجَّةٍ بِحِجَاهُ فَصَلْ",31,"ل",1,0],["فَكَم شَقَّ سَيفُكَ مِن هامَةٍ","وَرُمحُكَ يُعجِمُ ما قَد مَشَق",32,"ق",1,0],["فكم شمل خطب لا نطيق دفاعه","فزعنا إلى عليائه فتبددا",33,"د",2,0],["فَكَم شوهِدَت إِذْ ماتَ مِنهُ كَرامةٌ","عَياناً وَأَمرٌ لِلعَوائِدِ خارِقُ",34,"ق",1,0],["فَكَم شامَهُ الأَعداءُ جَيشاً عَرمرَماً","وَلَيسَت عُيونُ القَومِ بِالأَعيُنِ الرُّمدِ",35,"د",1,0],["فكم شيد فيه هيكل جاء جامعا","لأتقن وضع مثله ليس يوضع",36,"ع",1,0],["فكم شكرتهُ الرياضُ التي","أَزاهرهُا بعضُ آثاره",37,"ر",2,0],["فكم شتت منهم في الفيافي","وكم بدّدت منهم في السباسبْ",38,"ب",1,0],["فكم شمنا وباءً في شتاءٍ","وفي قلب الثلوج قد استقرَّا",39,"ر",2,0],["فَكَم شُجاع تَصطَفي حُبَه","أَعداؤُهُ وَهُوَ لَهُم يُقهَرُ",40,"ر",1,0],["فكم شهر الوغى وله استعار","تراه من حشا الصب استعاره",41,"ر",2,0],["فكم شقَّ فجراً من دجى ليل حادثٍ","وأضحك للأيام من أوجهٍ طلح",42,"ح",1,0],["فكم شدهت لباً وكم شدخت رياً","وكم كسرت جبراً وكم جبرت كسرا",43,"ر",2,0],["فكم شمخت إليه أنوف قومٍ","وعادوا بالصغار مجدعينا",44,"ن",2,0],["فكم شتت كفاه شملاً مجمعاً","ولا سيما آل النبي الأماجدا",45,"د",2,0],["فَكَم شَرَقٍ بَعدَ الزُلالِ وَغُصَّةٍ","تُذيقُ العِدى مِن جُرعَةِ المَوتِ عَلقَما",46,"م",2,0],["فكم شفى القلبَ منه حدُّ صارِمه","بفلقِ جمجمةٍ أو ضرب أعناق",47,"ق",1,0],["فَكَم شَكَت عُشاقَها لَها جَوىً","شِكاية المَرضى إِلى طَبيبها",48,"ب",3,0],["فكم شاحب رث العزيمة خلفنا","ومستنصح يرجو انتصاراً وخائف",49,"ف",1,0],["فكم شموسٍ بها وكم شهبٍ","وكم نجومٍ وكم مجرّات",50,"ت",1,0],["فكم شهدت مصر له بمزية","مغارسها بالنفع للقطر تثمر",51,"ر",1,0],["فكم شيدت للعدل مبنى عماده","كما هدمت صرح المظالم بالقسر",52,"ر",1,0],["فكم شفي المفؤد من حكم له","تسبب للموؤد عمراً مجددا",53,"د",2,0],["فَكَم شَكَونا وَما أَجدَت شكايتُنا","حَتّى يَئِسنا وَبَأْسُ الدَهرِ لَم يَلِن",54,"ن",1,0],["فَكَم شَباب تَولّى","كَما يَراه الرائي",55,"ي",1,0],["فكم شاد للدين أركانه","وعظم للّه فيه شعارا",56,"ر",2,0],["فكم شمنا سنا البدر","بوجه منه وقاد",57,"د",1,0],["فكم شيدوا عزاً وقادوا إلى الوغى","جنوداً وكبار الأعزاء صغرّوا",58,"ر",3,0],["فكم شامت بي كان بالأمس حاسدا","على منصبي أفنى أنامله عضا",59,"ض",2,0],["فَكَم شَفى من أَنفسٍ مَكلومَةٍ","بالدَهرِ قد أَعيا الإسا فيها الأَسا",60,"ا",1,0],["فَكَم شَرقَت فِيكُنَّ شَمسٌ على الحِمَى","تَراها عِشاءً بَينَ سِربِ وَرَبربِ",61,"ب",1,0],["فكم شاهدت عيناي ما فيه غنيةٌ","لذي عبرةٍ فيما اعترته النوائب",62,"ب",1,0],["فكم شرود سرت في مدحه وزهت","وأغربت بثناءٍ ليس يغترب",63,"ب",1,0],["فكم شهم سما قدراً وجاهاً","بكفٍّ ملؤها كرم وجود",64,"د",1,0],["فكم شيكاً تلقى سائلوه","وكم من خدمة أعطى سنينا",65,"ن",2,0],["فَكَمْ شَرَحَتْ صَدْرِيْ بِحُسْنِ حَدِيْثِهَاْ","وَهِمْتُ لَعَلِّيْ فِي الْمَحَبَّةِ أُفْلِحُ",66,"ح",1,0],["فكم شعوب تحررت وسرت","في ليلها تستنير بالشُعل 4",67,"ل",1,0],["فكمْ شفّ الْجمالُ لهُ فؤاداً","وكمْ هتفَ الْوصالُ بهِ فثابا",68,"ب",2,0],["فَكَمْ شَعَّ نُورٌ مِنْ بَهَاكِ ، وَكَمْ سَلا","يُدَاعِبُهُ رَوْضُ الْجَمَالِ وَكَوْثَرُ",69,"ر",1,0],["فكمْ ( شارونُ ) هدّمَ من بُيوتٍ","وكمْ من ( بوشَ ) حالفَهُ انْضمام",70,"م",1,0],["فَكَمْ شَهَدْتَ بِقَاعِ الَأَرْضِ جَوْرًا","قَدِيمًا لَا يُحَاطُ بِهِ وَنَصْبَا",71,"ب",2,0],["فكم شفَّني في السقامِ هيامٌ","وزاد بحبَّك فيَّ نحولا",72,"ل",2,0],["فكم. شاركتك التحنان عمراً","وبالآلام وحدي أستقلُّ",73,"ل",1,0],["فكم شهيدٍ لنا ما زالَ يَمنحُنا","ضوءًا، ونعرُجُ خلفَ النورِ إذ عرَجا",74,"ج",2,0],["فَكَمْ شَقَيْتُ وَ أَشْقَيْتُ الزَّمَانَ مَعِي","أُحَكِّمُ الصَّبْرَ فِي حُكْمِي عَلَى عِلَلِي",75,"ل",2,0]