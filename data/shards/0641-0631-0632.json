{"poems":[[72,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[87,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[83,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[556,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63996","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110312","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65398","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86456","الطويل"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101332","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83590","السريع"],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""],[5929,"لا تحسبي الحب لهوا","https://www.poetsgate.com/ViewPoem.aspx?id=196922",""]],"verses":[["فَرُزِقتُ مالَم يُرزَقوا وَنَطَقتُ ما","لَم يَنطِقوا وَلَحِقتُ مالَم يَلحَقوا",0,"ق",3,0],["فر زالت سهامك صائبات","على رغم الوشاية والسعاية",1,"ا",3,0],["فَرُزْتَ الأُفعُوانَ الصِّلَّ جَهْلاً","فكيفَ وجدْتَ نابَ الأُفعُوانِ",2,"ن",1,0],["فَرِزؤُكَ قَد عَمَّ البَرِيَّةَ كُلَّهُم","كَما كانَ فيهِم جودُ يُمناكَ قَد عَمّا",3,"م",2,0],["فَرُزؤُكَ قَدَّ اليَومَ كُلَّ مُسَرَّدٍ","وَفَلَّ غراري كُلّ أَبيَض مُرهَفِ",4,"ف",1,0],["فرُزْءٌ على رُزءٍ وفجعٌ يُبيتنِي","على حَرِّ جمرٍ أو فِراشِ قَتادِ",5,"د",1,0],["فَرِزءُ مُتَمِّمٍ رُزئي وفَجعي","كَفجَعتِه بصاحِبِ ذي الخِمار",6,"ر",1,0],["فرزقُكَ سوفَ تُدْرِكُهُ جميعاً","ولو أَضْحَىْ بأفواهِ السِّباع",7,"ع",1,0],["فرزانك منه بالوسام مرصعاً","به خير صدرٍ لم يطئ بابه حقد",8,"د",1,0],["فرزقهُ يخرُجُ من ضربها","وخارجُ الضّرب بها يجمعُ",9,"ع",1,0],["فرزء الفتى لا رزؤها بمصابها","إذا عدت الأرزاء فعل صواب",10,"ب",1,0],["فرزء الفتى المهدي كان ابتداءها","ورزء علي القدر كان اختتامها",11,"م",3,0],["فَرزقهم ضاقَ وَمن ضيقِه","جَرى ولكِن من شُقوقِ القَصَب",12,"ب",1,0],["فَرُزِ الرِّجالَ ولا يَغُرُّكَ قَولُهُمْ","فَعُيونُهُمْ بِالقَولِ أَصَدَقُ حالا",13,"ل",2,0],["فَرُزْتُ مَرادَها عَبَثاً لَعَلّيْ","إذا ما جُزتُ أحفظُ مُستَقريْ",14,"ر",2,0],["فَرْزَانَةٌ حُرَّةٌ خَوْدٌ مُنَعَّمَةٌ","خَرِيدَةٌ فُنُقٌ تَخْتَالُ مِنْ طَرَبِ",15,"ب",1,0]]}