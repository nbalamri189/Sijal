{"poems":[[53,"ما أستزيد لقاسم من ربه غير البقاء","https://www.aldiwan.net/poem7960.html","مجزوء الكامل"],[91,"خطبت تؤبنك الدموع","https://www.aldiwan.net/poem44716.html","مجزوء الكامل"],[47,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[68,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[71,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[177,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[202,"يا قمرا مطلعه في الحشى","https://www.aldiwan.net/poem51838.html","السريع"],[234,"أوهمتني من رقة العذر","https://www.aldiwan.net/poem51007.html","أحذ الكامل"],[416,"أتظن يا إدريس أنك مفلت","https://www.aldiwan.net/poem67503.html","الكامل"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[443,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[457,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[463,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[463,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[469,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[519,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[519,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[563,"لما انثنت ثاء الثنا الموروث","https://www.aldiwan.net/poem34696.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54098","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70751","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70729","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96665","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80219","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19990","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48215","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53116","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137162",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65127","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216439","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117918","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123531","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102927","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40064","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40156","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40145","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21586","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90847","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73090","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136557",""],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134239","الكامل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115309","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76746","الكامل"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[2052,"ملك كما حدثت عنه رأيته","https://www.poetsgate.com/ViewPoem.aspx?id=189613",""],[5145,"سفرت لنا عن سنة البدر","https://www.poetsgate.com/ViewPoem.aspx?id=108134",""],[5145,"من كان يصبو إلى الأوصاف والغزل","https://www.poetsgate.com/ViewPoem.aspx?id=108227",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""]],"verses":[["ملك كأن خِلاله","خُلقتْ له بعد انتقاءِ",0,"ق",3,0],["ملك كأن التاج فو","ق جبينه نجم لموع",1,"ع",1,0],["مُلكٌ كَمُلكِ سُلَيمانَ الَّذي خَضَعَت","لَهُ البَرِيَّةُ قاصيها وَدانيها",2,"ي",3,0],["مَلكٌ كَأَنَّ الدَهرَ عَبدٌ لَهُ","وَسائِرُ الأَيّامِ أَعوانُه",3,"ن",2,0],["مُلْكُ كسرى عنهُ تغني كِسرةٌ","وعنْ البحرِ ارتشافٌ بالوشلْ",4,"ل",1,0],["مَلِكٌ كما حُدِّثتَ عنه رأفَةٌ","فالخمرُ مَاءٌ والشراسَةُ لِين",5,"ن",1,0],["مَلِكٌ كَرِيمٌ قَدْ تَمَثَّلَ مِنْ حَلَى","مَلِكٍ كَرِيمٍ فِي مِثَالٍ أَوْحَدِ",6,"د",1,0],["مَلِكٌ كَالرَّبِيعِ خَلقاً وَخُلقاً","خصَّهُ اللهُ بِالعُلاَ وَحَبَاهُ",7,"ا",2,0],["مَلّكَكَ الدُنيا وَأَربابَها","وَصيّرَ الناسَ بِها أَعبُدَك",8,"ك",1,0],["ملِك كأن الله أفرده","دون الورى بالمجد والفخر",9,"ر",1,0],["مَلِكٌ كَأَنَّ المَوتَ يَتبَعُ أَمرَهُ","حَتّى يُقالَ تُطيعُهُ الأَقدارُ",10,"ر",1,0],["ملك كوّن الإله له الأق","دار فيما يريده كيف شآء",11,"ا",2,0],["ملك كأنّ العالمين بما حوت","كرما وإجلالا لديه هباء",12,"ا",2,0],["مَلِكٌ كَأَنَّكِ يَا مَحاسِنَ فِعلِهِ","من سَيِّئاتِ زمانِكَ استغفَارُ",13,"ر",1,0],["ملك كيف شاء ما شاء يلهو","برعايا القلوب باستخفاف",14,"ف",1,0],["ملَّكَكَ الودُّ عزيزَ رقِّها","وهي من الكرائم الحرائرِ",15,"ر",1,0],["مَلَّكك المجدَ أنّ بابَك مف","توحٌ وبابَ الأرزاقِ مسدودُ",16,"د",1,0],["ملكك في الحرب أبو نجدتها","وأنت في السلم أخو ديوانها",17,"ن",3,0],["مَلِكٌ كلّما رَقي للمعالي","فله النيّراتُ أدنى المَراقي",18,"ق",2,0],["ملكٌ كلّما سرى لطِلابٍ","يحسَبُ الأرضَ كلّها كالنقيرِ",19,"ر",1,0],["ملكٌ كأنّي إن نطَقْتُ بمدحِه","شتّتُّ في الأسْماعِ سِمْطَ فَريدِ",20,"د",1,0],["ملك كهاتيك الحروف مقدس","في هيكل الناموس والباغوث",21,"ث",1,0],["مَلِكٌ كُلَيبٌ في ذُؤابَةٍ وائِلٍ","عَبدٌ لَهُ وَزُرارَةٌ في خَندَفِ",22,"ف",1,0],["مِلْكُكَ قلبي بل قلوبَ الورى","حقٌّ فها أنتَ ابنُ عبْدِ الملكِ",23,"ك",1,0],["ملك كما ترضى وعدلٌ قائمُ","منك الندى ولك الولاء الدائمُ",24,"م",1,1],["ملك كريمٌ كيِّسُ مُتَيَقِّظ","ذو همةٍ تعلو على الهِمَّات",25,"ت",1,0],["ملك كريم خيرُ مَنْ","سكن البلاد ومَنْ شَحِط",26,"ط",1,0],["ملكٌ كأنّ نوالهُ غيثٌ هَمى","مِن ودقِ محنيةٍ دفوقٍ معصرِ",27,"ر",1,0],["مَلَكٌ كَريمٌ في الثَرى","قَد ضاعَ عَن طرقِ السَما",28,"م",2,0],["مَلِكٌ كِلتا يَدَيهِ","بِعَطاياهُ دَرورُ",29,"ر",1,0],["مَلِكٌ كُلُّ مالِكٍ خَلَقَ الخَل","لاق أَرضٌ تُداسُ وَهوَ سَماءُ",30,"ا",2,0],["ملكٌ كان إذا ما جاءه","مادحٌ أجرى عليه الذهبا",31,"ب",2,0],["ملكٌ كيِّسٌ يُفَرِّقُ للعا","فِينَ بين النُّظَّارِ والأكياسِ",32,"س",1,0],["ملك كلّ رب ملك عظيم","خامل ذكره لديه حقير",33,"ر",1,0],["مُلكِكُم شامِخُ الذُرى مُتَرامٍ","في سُهولٍ لا تَنتَهي وَنُجودِ",34,"د",1,0],["ملك كفى للعرب فخراً انه","اضحى لها في الدهر خير امام",35,"م",1,0],["ملك كسرى عنه تغنى كسرة","وعفاف النفس أغني وأجل",36,"ل",1,0],["ملكٌ كلّ كلُّ من رام يحكي","من معالي كماله وكماله",37,"ل",2,0],["ملِكٌ كأنّ الشمسَ غُرَّةُ وجْهِهِ","تهْدي إلى سُبُلِ الهُدى ضُلّالَها",38,"ل",3,0],["ملِكٌ كأنّ الغيثَ جودُ يَمينِه","مهْما أنالَ القاصدِين نَوالَها",38,"ل",3,0],["ملك كما ترجو لمصر مصدِّق","بشراك، مرتسم لما هو راسم",39,"م",1,0],["ملكٌ كِرام العرب أمته التي","شرعت لكل موحد أن يفخرا",40,"ر",2,0],["ملكٌ كريمٌ كالنسيم لطافةً","فإذا دَجا خَطبٌ قسا وتمرّدا",41,"د",2,0],["ملك كأن الجود أقسم باسمه","أن لا ترى بوجوده فقراء",42,"ا",2,0],["مَلِكٌ كَفَتني كَفُّهُ أَنْ أَجْتَدِي","وأَجَلَّني فأبيتُ أن أَتَبَدَّلا",43,"ل",2,0],["مَلكٌ كَسا الإِسلامَ مِن ذَبِّهِ","بُرْداً بتَدْبيجِ الظّبا مُعلمَا",44,"م",2,1],["مُلْكُكَ هَذا الَّذي تَملأه","صِباهُ يَجري وَالدهر في طلقِ",45,"ق",1,0],["ملك كسرى به تمزق لما","أن دعاة فلم يجب للدعاء",46,"ا",2,0],["ملك كأن الموت يتبع قوله","حَتى يُقالَ تُطيعُهُ الأَقدارُ",47,"ر",1,1],["ملك كريم جاء من ملك على","أمنا جيوش المؤمنين أمين",48,"ن",1,0],["مَلكٌ كتيبتُهُ كتابتُهُ","فَرْدٌ بجيشِ النّصرِ في جُنْدِ",49,"د",1,0],["مَلِكٌ كسا الإِسلامَ ثَوْبَ نضارةٍ","بظبا أطاحَتْ كفُّه أعداءها",50,"ا",3,0],["مَلِكٌ كانض أَمنَ الديِّنَ إن خا","فَ مِنَ الُمشرِكينَ داءَ عُضَالا",51,"ل",2,0],["ملكَّك الحسُن قلوبَ الورى","فاعدل بحكم الحُبّ يا جائر",52,"ر",1,0],["ملك كساه الله حلة حلمه","وفشا الأمان بعدله في الناس",53,"س",1,1],["مَلكٌ كأنّ الشَمسَ فوقَ جبينهِ","مُتَهَلّلُ الأمساءِ والأصباحِ",54,"ح",1,1],["ملكٌ كانت الوزارةُ ترعا","هُ بعينٍ مذ كان رهنَ المهودِ",55,"د",1,0],["ملك كما اتَّقَر الصباح وراءه","طلّ كما برد المساء طليل",56,"ل",1,0],["ملك كان له ملائكة العلى","حرسٌ وأحكام المهيمن عسكرُ",57,"ر",1,0],["ملك كما حدثت عنه رأيته","يعطي الكثير ولا يراه كثيرا",58,"ر",2,1],["ملك كأن براحتيه للعدى","والسائلين إماتة ونشورا",58,"ر",2,0],["ملك كأن الله قال له","عم الورى بالعرف والنكر",59,"ر",1,0],["ملك كأن رسول الله خلّفه","في آله فهو يحميهم من الخلل",60,"ل",1,0],["ملك كأن الله قال لكفه","كفي الأنام بجودك الهتان",61,"ن",1,0]]}