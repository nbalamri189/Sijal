,["فَنعافِ صارَةَ فَالقَنانِ كَأَنَّها","زُبُرٌ يُرَجِّعُها وَليدُ يَمانِ",8,"ن",1,0],["فَنِعمَ مَصيرُ الصادِقينَ إِذا دُعوا","إِلى اللَهِ يَوماً لِلوَجاهَةِ وَالقَصدِ",9,"د",1,0],["فَنِعمَ صاحِبُ قَومٍ لا سِلاحَ لَهُم","وَصاحِبُ الرَكبُ عَثمانُ بنِ عَفّانا",10,"ن",2,1],["فنعمَ الحصنُ إن طلعت خطوبٌ","ونعم القطبُ إن دارَ الثناء",11,"ا",2,0],["فنعمَ الأهلُ قد أضحتْ وماذا","يقولُ المدْحُ في أهلِ الصلاح",12,"ح",1,0],["فَنِعمَ ذَوُ الحِبايَةِ كانَ قَومي","لِقَومِكَ لَو جَزى بِالخَيرِ جازي",13,"ز",2,0],["فَنَعِمنا هُنَيهَةً","بِالوَلاءِ المُجَدَّدِ",14,"د",1,0],["فنعم الغمد آمنة","ونعم السيف لهذمه",15,"م",2,0],["فنعمةُ اللّهِ وهيَ سابغَةٌ","عندي من الحاسدينَ تنتصرُ",16,"ر",1,0],["فَنِعمَ اِختِيارُ العالَمينَ كِلاهُما","بِما حَصَّلا مِن كُلِّ غَضِّ الضَرائِبِ",17,"ب",1,0],["فَنُعمٌ وَلَم تُنعِم بِنَيلٍ نَعُدُّهُ","وَجُملٌ وَلَم تُجمِل بِعارِفَةٍ جُملُ",18,"ل",1,0],["فَنِعمَ الفَتى عيسى إِذا البُزلُ حارَدَت","وَجاءَت بِصُرّادٍ مَعَ اللَيلِ بارِدِ",19,"د",1,0],["فَنِعمَ مُناخَ الكَلَّ أَرعى رِكابَهُ","طُروقاً إِلَيهِم في السِنينَ المَواحِلِ",20,"ل",1,0],["فَنَعِمنا بِالحاشِرِيَّةِ حَتّى","خِلتُ نورَ المُدامِ مَطلَعَ فَجرِ",21,"ر",1,0],["فَنَعِمتُ مِن شَمسٍ إِذا حُجِبَت بَدَت","مِن نورِها فَكَأَنَّها لَم تُحجَبِ",22,"ب",1,0],["فَنَعِمتُ بالاً إِذ دَخَلتُ عَلَيهِمُ","وَسَقَطتُ مِنها حَيثُ جِئتُ عَلى هَوى",23,"ا",1,0],["فَنِعمَ السَبيلُ السَوِيُّ الأَمينُ","وَنِعمَ المَطِيُّ السِماحُ الذُلُلْ",24,"ل",1,0],["فَنِعمَ العِبادُ المُصطَفَونَ لِأَمرِهِ","وَمِن دوُنِهِم حُندٌ كَثيفٌ مُجَنَّدُ",25,"د",1,0],["فَنِعمَ الفَتى تَعشو إِلى ضَوءِ نارِهِ","إِذا الريحُ هَبَّت وَالمَكانُ جَديبُ",26,"ب",1,0],["فَنِعمَ الشَيخُ أَنتَ عَلى المَخازِي","وَبِئسَ الشَيخُ أَنتَ لَدى المَعالي",27,"ل",2,0],["فَنَعِمنا وَالعَينُ حَيٌّ كَمَيتٍ","بِحَديثٍ كَنَشوَةِ الخَندَريسِ",28,"س",1,1],["فَنِعمَ الدَفينُ اللَيلُ إِن باتَ كاتِماً","هَواكَ وَبُعداً لِلصَباحِ إِذا نَمّا",29,"م",2,0],["فنعمت لقاح المحل يهدي زفيرها","سرى الضيف أو نعمت مطايا المجاهد",30,"د",1,0],["فَنِعْفُ وَدَاع فَالصِّفَاحُ فَمَكَّةٌ","فَلَيْسَ بِهَا إلاَّ دِمَاءٌ ومَحْرَبُ",31,"ب",1,0],["فنعم فتى الدنيا لئنْ كانَ فاجراً","وفوق الفتى إن كان ليسَ بفاجِرِ",32,"ر",1,1],["فَنَعَاهُ نَاعٍ رَاعَهُنَّ فَجِئْنَ فِي","هَرَجٍ لِتَوْدِيعِ الفَقِيدِ النَّائِي",33,"ا",2,0],["فنعافِ صارة َ فالقَنانِ كأنَّها","زُرُرٌ يُرجِّعها وليد يمانِ",34,"ن",1,0],["فَنعم ظَلام لَم يَكُن فيهِ ثالث","وَيا حَبَذا بَدرٌ أَضاءَ وَدار",35,"ر",1,0],["فنعم اب وابن نوالهما جرت","اياديه بالحسنى لكل موحد",36,"د",1,0],["فنعم مسكنه غراٌ له أبداً","من السحاب قلاداتٌ وتيجان",37,"ن",1,0],["فَنَعلُكُ قَد زَلَّت وأصبَحَتَ هَاوياً","كَما قَد هَوَى مِن قُلَّةِ النِّيقِ مَنهَوِ",38,"و",1,0],["فَنِعمَ اِبنُ أُختِ القَومِ غَيرَ مُكَذَّبٍ","زُهَيرٌ حُساماً مُفرَداً مِن حَمائِلِ",39,"ل",1,0],["فنعمَ الرياضُ لمرتادِها","ونعمَ الديارُ لمنتابها",40,"ب",3,0],["فنعم الخل في الخلوات علم","عرفت الله منه بما عرفتا",41,"ت",2,0],["فَنِعمَ فَتى الجلّى وَمُستَنبِطُ النَدى","وَمَلجَأُ مَكروبٍ وَمَفزَعُ لاهِثِ",42,"ث",1,0],["فنعمتُها بؤس وفَرْحَتها أسًى","وصِحتُها سقم وإعطاؤها ردّ",43,"د",1,0],["فَنِعمَ إِمامُ القَومِ إِذا كانَ غازِياً","وَنِعمَ الفَتى في أَهلِهِ وَالمُسافِرُ",44,"ر",1,0],["فَنَعَ القَلبَ أَن تَلَمَّ نَواها","فَرَحَ النَفسِ بِالغِنى المَغنومِ",45,"م",1,0],["فَنِعمَ مُعَرَّسُ الأَضيافِ وَهناً","إِذا ما الشَولُ عارَضَتِ الشَمالا",46,"ل",2,0],["فنُعْمٌ ولم أَرَ إنعامَها","وجُمْلٌ ولم أر إجمالها",47,"ل",3,0],["فَنِعْمَ الْغَيْثُ سَيْبُكَ وَهْوَ هَامٍ","وَقَدْ حُسِبَ الْكِرَامُ مِنَ اللِّئَامِ",48,"م",1,0],["فنعمَ الموتُ بعدَ السكرِ منها","وإلقاءُ السَّلامِ على عبيد",49,"د",1,0],["فنعمَ المحباتُ اللواتي إِلى الرَّدى","تَوالينَ يحسبنَ الحياةَ حراما",50,"م",2,0],["فَنِعْمَ مَا أَنْتَ عِنْدَ الخَيْرِ تَسْأَلُهُ","وَنِعْمَ مَا أَنْتَ عِنْدَ البأسِ تَحْتَضِرُ",51,"ر",1,0],["فَنِعمَ المُعتَرى رَحَلَت إِلَيهِ","رَحى حَيزومِها كَرَحى الطَحينِ",52,"ن",1,0],["فَنِعمَ لي وَصفٌ وَبِئسَ الفَتى","مَن مالَهُ في مَشرَبي شِرُّ",53,"ر",1,0],["فنِعْمَ الوزيرُ اتّخذْتَ الوزيرَ","ونِعْمَ القرينُ ارتضَيْتَ القَرينا",54,"ن",2,0],["فنعم إذا الحيوان يؤلم ذبحه","فله به عوض يكون جليلا",55,"ل",2,0],["فنعود الرجا قنوطاً وللخو","ف مزيلاً على الدجا سرباله",56,"ل",2,0],["فنعمَ أخٌ هُنِّيتَ فيه مزوَّجاً","وحقَّ وأيم الله فيه لك الهنا",57,"ن",2,0],["فنعم الرجال ونعم الكمال","بأفكارها وبأذهانها",58,"ن",3,0],["فنعم الأمير كريم الأيادي","بنيل النوال أشاد السنن",59,"ن",1,0],["فنعت فيكم بإخلاصي بحبّكم","وقد كفاني إذا ألبست أكفاني",60,"ن",2,0],["فَنِعمَ الشَيءُ كُنتَ وَلَيسَ شَيءٌ","مِن الدُنيا وَما فيها يَدومُ",61,"م",1,0],["فنِعم مُناخَ ظالعةٍ وسَقْياً","ذَراك الرحبُ أو يدُك الحلوبُ",62,"ب",1,0],["فنعمَ ملاذُ الحيِّ والمحْل عارق","ونِعمَ ملاذُ الحيِّ والشرُّ رائعُ",63,"ع",1,0],["فنِعم مُناخُ الطَّارقينَ عشيَّةً","اذا أخمدتْ نار اليَفاع الزعازعُ",64,"ع",1,0],["فنعم الفتى عبد الجليل هو الذي","إِلى الفخر والمجدِ الأثيلِ حبيبُ",65,"ب",1,0],["فنعم مُناخُ الطارقينَ عَشيَّةً","اذا الليلةُ الورهاءُ خَبَّ سَفيرها",66,"ر",3,0],["فنعيمي وشقوتي قدُّه الع","سال ليناً وريقه المعسولُ",67,"ل",1,0],["فَنَعيمي بُؤسٌ وَأَيّامُ عَيشي","في زَمانِ الصُدودِ مِثلُ اللَيالي",68,"ي",1,0],["فنعثي في نظم التسلسلِ مفردٌ","وسمتي بنهجِ ابن العواتك واحدُ",69,"د",1,0],["فنعزو الفلاح في سهوٍّ لغيرك","وتُنسى كحالِ كلّ حلوٍ ملكناهُ",70,"ن",3,0],["فنعمة الله إذا أُطلقت","ولم تقيد بالوفاء تنفر",71,"ر",1,0],["فنِعمَ بها طَرفاً قَذى بِوُجوهِهِم","فَمِثلُكَ مَن بالحُسنِ حَقًّا تَنَعَّما",72,"م",2,0],["فنعمَ مشيراً أنتَ والرّأيُ ضيِّقٌ","ونعم ظهيراً أنت والخطب أشنعُ",73,"ع",1,0],["فنِعمَ شرابُ أُنسٍ حينَ نَلهُو","عَلى الأُخرى اليمَانِيَةِ السَلاما",74,"م",2,0],["فَنِعمَ رِجالِ الشَرقِ قَوماً وَمَعشَراً","فَطالَ بِها بَنَتِ المَعاني وَقَد نَما",75,"م",2,0],["فنعمَ إمامُ العلم والكوكبُ الذي","أتى نوره في صفحة الدين ساطع",76,"ع",1,0],["فنعرفُهم بحبِّهمِ عَليّاً","وإن ذوي النفاقِ لَيَعرِفونا",77,"ن",2,0],["فَنعم الصَدرُ خَير الناس طرّا","لَقَد أَحيا بِنَشر العَدل مَصرا",78,"ر",2,0],["فنعم الرئيس العادل الكافل الَّذي","يَذود عَن الأَوطان كُلَّ مخاصم",79,"م",1,0],["فَنَعِيمُ كُلِّ مُتَيَّمٍ وشَقاؤهُ","حَسبُ الَّذي قَدْ خُطَّ فِيها تُقْدَرُ",80,"ر",1,0],["فنعم إحسانها","وبئس هذا الجزاء",81,"ا",2,0],["فن