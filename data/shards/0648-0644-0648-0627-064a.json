{"poems":[[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[113,"ألف سلام عليك من مشتاق","https://www.aldiwan.net/poem16234.html","الخفيف"],[567,"في اللحد شرشل بيك بات ونفسه","https://www.aldiwan.net/poem52520.html","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53878","البسيط"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106704","الطويل"],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""]],"verses":[["ولو أيامك العصماء جاءت","بكل أغر مزدانٍ حفيل",0,"ل",1,0],["وَلِوائي مِن الهَوى فَوقَ رَأسي","خافق لَيسَ تَحتَهُ مِن رِفاق",1,"ق",1,0],["ولَوائحٌ مِن رَحمةِ اللهِ انجَلَتْ","لمُؤَرِّخيهِ تُنيرُ فوقَ ضريحِهِ",2,"ح",2,0],["ولو أياها أبت سواه","ولم تزل حوله تحومُ",3,"م",1,0],["ولو أيقَنُوا مِنهَا النَّجَا بِبَنَاتِهِم","لزُفّت لنا أبكارُهُم والعَوَانِسُ",4,"س",1,0],["ولوايقن المرتاب في حال ريبته","سكن طير صدره واهتنا واستراح به",5,"ب",2,0]]}