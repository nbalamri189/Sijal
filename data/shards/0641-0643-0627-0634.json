{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[203,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122452","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204267",""]],"verses":[["فَكاشَفْتُهَا مَا بِي وَإِنَّ افْتِضَاحَهُ","لأَيْسَرُ لِي مِنْ أَنْ يُرَدَّ لَهَا أَمْرُ",0,"ر",1,0],["فكاشفتها مابي غراماً مبرحاً","يغالبني فيهِ النُّهى وأغالبهْ",1,"ب",2,0],["فكاشَحنِي الغريمُ وصَارَ يَرغُو","ويُوعِدُ بالرِّمَاحِ وبالصِّفَاحِ",2,"ح",1,0],["فكاشفته البظراء جهراً","بفسقها حين قل خيره",3,"ر",2,0]]}