فت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6213,"نهر الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76256&r=&rc=13",""],[6242,"مَنْ ضيّعَك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87556&r=&rc=3",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[406,"مليون توقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63261&r=&rc=71",""],[6355,"شرف الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66576&r=&rc=36",""],[4890,"رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72398&r=&rc=88",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""]],"verses":[["أَطفالُ نَورٍ أَرضَعَت","ها الفِرَقُ المَطافِلُ",0,"ل",1,0],["أطفأتْها دماؤهم بل سيوفٌ","أبهلتْهنَّ أيما إبهالِ",1,"ل",1,0],["أطفأتَ نارهمُ وكنَّ نوائراً","وأبحتَ حقدَهمُ وكان دواجنا",2,"ن",2,0],["أَطَفنَ بِهِ حَتّى اِستَوى وَكَأَنَّها","هَجائِنُ أُدمٍ حَولَ أَعيَسَ مُلبِدِ",3,"د",1,0],["اطفأ الدهر شعلة كانت الاضواء","منها يملأن منا العيونا",4,"ن",2,0],["اطفأ اليأس كريح صرصر","عصفت آخر ومض للمنى",5,"ن",2,0],["أطفيء سخونة حرّنا بندى","أو ما ترى المريخ محترقا",6,"ق",2,0],["أَطفَأتَ جَمرَتُهُم وَكانَت ذا سَناً","وَالعَمقُ بَعضُ حَريقِها المُتَوَقِّدِ",7,"د",1,0],["أَطفَأتَ نارَ العِدى عَنهُم وَقَد ذَكُوَت","وَذُدتَ نابَ الرَدى عَنهُم وَقَد صَرَفا",8,"ف",2,0],["أَطفَأَ السَيفَ عَنكُمُ وَهوَ نارٌ","يَتَلظّى حَدّاهُ فيكُم مَنونا",9,"ن",2,0],["أطفأْتَ بالكَرِّ والإِقدامِ نارَهُمُ","وقبلُ كانتْ على الإسلامِ تَضطَرِمُ",10,"م",1,0],["أَطفَأتُ نارَ هَواكَ مِن قَلبي","وَحَلَلتُني مِن عُروَةِ الحُبِّ",11,"ب",1,1],["أَطفَأَ اللَحدُ وَالثَرى لُبَّكَ المُس","رَجَ في وَقتِ ظُلمَةِ الأَلبابِ",12,"ب",1,0],["أَطَفتُ بِها أَشكو إِلَيها وَتَشتَكي","وَقَد تَرجَمَ المُكّاءُ عَنها فَأَفهَما",13,"م",2,0],["أطفأ الجنديُّ في ميدانها","جُذوةَ البَغْيِ ببأسٍ مُحْتَدِمْ",14,"م",1,0],["أَطَفنَ بِمَعسُولِ الدُعابَةِ سادِرٍ","كَخُوطِ الأَبالم يَهصِرِ العُودَ عاضِدُ",15,"د",1,0],["أَطفَأتَ نِيرانِ العَداوةِ بَعْدَما","أوطَأتَ منها المُوقِدِين وَطيسا",16,"س",2,0],["أَطْفَأْتَ نِيرانَ الوغَى بِدِمائِهِمْ","ولها بِقَرْعِ النَّبْعِ أَيُّ ضِرامِ",17,"م",1,0],["أطفَأتَ عنّي زَمني بعدَمَا","أُوقِفْتُ من جَمْرٍ على حَرْق",18,"ق",1,0],["أَطفت شَرارةَ لهوي","ولَوتْ بشدَّةِ عَدْوي",19,"و",2,1],["أطفأوا جمرةَ الجحيم فكانت","فتنة ما جرى بها التقدير",20,"ر",1,0],["أطْفَتْ سنانَك أرواحٌ تَمُوتُ به","هُبوبَ أرواحِ لَيْلٍ في سَنى قَبَسِ",21,"س",1,0],["أَطَفَّ لأَنِفِهِ الُموسَى قَصيرٌ","لِيَجدَعَهُ وكانَ بهِ ضَنينا",22,"ن",2,0],["أَطْفِئُوا الأَعْيُنَ هَلْ إِطْفَاؤُهَا","يَمْنَعُ الأَنْفَاسَ أَنْ تصْعَدَ زَفْرَا",23,"ر",2,0],["أطفلة الأمس هذي؟! أين دميتها؟","وأين مهد أبات الليل أرمقه؟",24,"ق",2,0],["أطفلة الأمس هذي؟! أين لتغتها؟","تصيُر الحرف عيداً حين تنطقه",24,"ق",2,0],["أَطفَأَ الشَمسَ من هَدا","ني بِها حينَ أَسرَجا",25,"ج",2,0],["أَطفَأَ السقمُ بِرُغمي نورهُ","وَرعافٌ كُلَّما كَفَّ دَفَق",26,"ق",1,0],["أُطْفِىءَ النُورُ ودالَتْ دَوْلَةٌ","وَطَوَى الدهْرُ المُنَى حِينَ طَواها",27,"ا",3,0],["أطفالُ وادي النيل يَو","مَ الزَّحْفِ من بعض الجُنود",28,"د",1,0],["اطفأت أزهر كوكب ملأ الفضا","ضوءا وجئت بظلمة الاكدار",29,"ر",1,0],["أطفأت بالثقاب مدّ جحيم","أتراها ملومة أم عذيره ..؟",30,"ر",2,0],["أطفأ الجندي في ميدانها","جذوة البغي ببأس مختدم",31,"م",1,0],["أَطفالَهُ لَهُم مِن حَولِهِ زَجَلٌ","وَلِلنِساء عَلى ما صابَهُ وَجَل",32,"ل",1,0],["أطفئ بماء القرب جمر الهوى","وزوج الحسن من الشعر",33,"ر",1,0],["أَطفَأتَ ناراً يُغَشّي الأَرضَ لاهِبُها","لَولاكَ لَم تُبقِ مِن شَيءٍ وَلَم تَذَرِ",34,"ر",1,0],["أطفأت نار المنى بباسي","ونلت مالي بلا إمكاسِ",35,"س",1,1],["أَطفَأَت نيرانَ العَدُوِّ وَأوقِدَت","نارٌ قَدَحتَ بِراحَتَيكَ زِنادَها",36,"د",3,0],["أطفا الصحو مشعلي فاسكب ال","زيت وأشعل بربك المصباحا",37,"ح",2,0],["أطفالُنا اتّخَذوا الشوارع مسكناً","أفَينبَغي أن نُهمِلُ الصبيانا",38,"ن",2,0],["أطفى حرارة شوقي","وُقِيتَ شَرَّ حِمامِكْ",39,"ك",1,0],["أطفت بالقوم فما استقبلوك","إلا بذكرى من وفاءٍ هزيل",40,"ل",1,0],["أَطفىء ضياكَ وَأَظلِم مِثلَ إِظلامي","وَخلِّني في كَوابيسي وَأَحلامي",41,"ي",1,1],["أَطفىء ضياكَ فَإِن النورَ يُذكرني","أَمسي وَتقلق روحي هذِهِ الشُهبُ",41,"ب",1,0],["أَطفَئهُ يا لَيلُ وَاِغمرني بِحالِكَةٍ","مِنَ الظَلامِ فَأَنسى حينَ أَحتَجِبُ",41,"ب",1,0],["أطفأتَ ما أوْقَدوا نَقضاً لِما اعتَقَدوا","لَقَد تَبَايَن إطفاء وإيْقادُ",42,"د",1,0],["أَطفتُ بِه مَدحي وَقصّرت دونهُ","وَلَكِنّني اِستوفرتُ مِن فضلكَ الأجرا",43,"ر",2,0],["اطفئ لظى القلب بشهدِ الرِّضاب","فإنما الأيامُ مثلُ السّحاب",44,"ب",1,0],["أطفأْتَ نارَ الخَدِّ منك بها","وتَركْتَ صَدْرَك مِلْؤه الحُرَق",45,"ق",1,0],["أطفا شُواظَ النار عنا عفوُه","قِدَماً وما كانت بِلاه لتنطفي",46,"ف",2,0],["أَطَفتَ بِقُسطَنطينَة الرومِ مُسنِداً","إِلَيها القَنا حَتّى اِكتَسى الذِلَّ سورُها",47,"ه",2,1],["أَطفَأتُ ناري بِمُقلَتَيك","وَأُفرِغَت رَحمَتي عَلَيك",48,"ك",1,0],["أَطفأَته بَعتادٍ","من الأَميرِ حُسَيْنِ",49,"ن",1,0],["أطفا تكاثرها سنا أنوارها","فأضاء نور تقاك عند محاقها",50,"ق",3,0],["أطفأت جمرتها بإخوتك الألى","يتسنمون غوارب الأهوال",51,"ل",1,0],["أطفأت نور الله إلا أنه","أطفاك من لفحاته بضرام",52,"م",1,0],["أطفأتُ من جسدي المُزَوَّرِ زَيْفَهُ","وأَتَيْتُ يحملُني إليكِ الجوهرُ",53,"ر",1,0],["أطفئ دمي سيدي أطفئ بكاءاتي","فقد أتيتك دنيا من عذابات",54,"ت",1,1],["أطفالهم بلغوا الحلوم بقربهم","شوقاً من الهيجاء لا الحسناء",55,"ا",2,0],["أطفئي الوجد من جوانح مشتا","ق ثمين يكاد يقضي غراما",56,"م",2,0],["أَطفأتَ نارَ حُروبِهم بِمثالِها","فَمَضَت وَما مِنهُم لَها إِيقادُ",57,"د",1,0],["أَطفىءْ صَدايَ فَإِنَّني","جَفَّت عَلى شَفَتي الأَماني",58,"ن",2,0],["أطَفنَ ببلكوثٍ ثلاثاً يَعُدنَه","ويومينِ لا يطمعن إِلاَّ الشكائِما",59,"م",2,1],["أطفَا بك الرحمن من","سمر القرى نار الفِتَنْ",60,"ن",1,0],["أُطفي صدايَ بنهلة من ثغره","وشِفا جوايَ بقبلةٍ من خدّه",61,"د",2,0],["أطفأت نار الفرس يا مصطفى","من بعدما أوقدت ألف عام",62,"م",1,0],["أَطَفنا بِمَحمودِ السَجِيَّةِ ماجِدُ","رِضاهُ لِما نَرجو مِنَ الخَيرِ مَوعِدُ",63,"د",1,0],["أُطَفِّرُ حِيطَانَ السَّبِيعِ وإِنَّنِى","بِأَبوَابِ حِيطَانِ السَّبِيعِ لَعَالِم",64,"م",1,0],["أطفاله كل ليل","وساعة ونهار",65,"ر",1,0],["أَطفَأتَ نيرانَ الطُغاةِ وَقَد","ذَلَّ التَقِيُّ وَعَزَّ ذو الفِسقِ",66,"ق",1,0],["أطفالُ أغصانِ الرياضِ تهُزُّها","في مَهدِها ريحُ الصبا المعطارُ",67,"ر",1,1],["أطفأ اللَه سطحها ودحاها","وحباها الأوتادَ من صفوانِ",68,"ن",1,0],["أطْفَالَهَا إذْ كُلَّهُمْ يَصْخَبُ","عَنْ طُعْمَةٍ كَانَتْ لَهُمْ تُجْلَبُ",69,"ب",1,0],["أُطفِي بِحَمزَةَ وَالعَبّاسِ جَمرَةَ ذي","بأسٍ وَأَطوي زَمانِي في ضَمانِهِمِ",70,"م",1,0],["اِطفاء أَنواري تَرومُ وَدون ما","قَد رُمته اطفاء نور ذكاء",71,"ا",2,0],["أُطفِى بهِ شَوقاً أَذَابَ حَشَاشَتى","كادَت سِوَى إِطفَائِهِ تَتَقَطَّعُ",72,"ع",1,0],["أطفو على السطح ظِلّاً","من السكون مقاما",73,"م",2,0],["أَطفأنَ نورَ شَبيبَتي","وَفَرَشنَني كَنَفَ الغَيورِ",74,"ر",1,0],["أطفَأتُمُ نُورَ الكِتَابِ وَسُنَّةِ ال","هَادِي بِذَا التَّحرِيفِ وَالهَذَيَانِ",75,"ن",1,0],["اطفأ نيراني بمشمولة","كأنها شعلة نيران",76,"ن",1,0],["أطفنا به واليوم أقتم غائم","ولست ترى فينا من الوجدن صاحيا",77,"ي",2,0],["إِطفاء نور اللَه كلا انها","انوار علام قضى اتمامها",78,"م",3,0],["أطفي بذكركم شوقاً أكابده","وربما رضي الحران بالبلل",79,"ل",1,0],["أَطفي المَصابيح إِنَّ الروح يُؤنسها","في ظُلمة اللَيل أَن تَخلو بِها رُوح",80,"ح",1,0],["أَطفالُها ما سَمِعَت بِالفَلا","قَطُّ فَعادَت الفَلا دارَها",81,"ر",3,0],["أطفأت جمرة حقده بتحلّم","فالحقدُ نارٌ والتحلّم ماء",82,"ا",2,0],["أطفأت شوقها برؤيا مليك","في ذرى المجد حاز أرفع قدر",83,"ر",1,0],["أطفأت مصباحا يضي","ءُ دياجي الليل البهيم",84,"م",1,0],["أطفال عقلٍ قد بُليت بنصحهم","فالكل ظنوا أنهم أفذاذُ",85,"ذ",1,1],["أطفي اواري برشف","منه لذيد المذاق",86,"ق",1,0],["أطفأ عنِّي نار كلبين ألّبا","عليَ الكلاب ذو الفَعَال ابن مالك",87,"ك",1,1],["اطفئ الحزن بالدموع اذا ما","حمة الشوق اثرت في فؤادي",88,"د",2,0],["اطفيء سراجا ونارا من قويسقة","واغلق الباب ارغاما لمرتجم",89,"م",1,0],["اطفِيتْ نَارْ الصَّبْ بِحْشَاه","لِكْ مَا حِوَتْ يَمْنَايْ شِلَّه",90,"ل",2,0],["