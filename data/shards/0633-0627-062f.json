","https://www.aldiwan.net/poem56032.html","عموديه"],[449,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[452,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[453,"غلب الجوع فهاتي المش هاتي","https://www.aldiwan.net/poem61231.html","الرمل"],[458,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[458,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[458,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[458,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[458,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[464,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[479,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[500,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[500,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[500,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[515,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[529,"جملة ماجاء من الحروف","https://www.aldiwan.net/poem37305.html","الرجز"],[538,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[538,"لا تعاتبني فلا عتب علي","https://www.aldiwan.net/poem47492.html","عموديه"],[551,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[553,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[562,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[584,"من حس لي الأخوين كالغصنين","https://www.aldiwan.net/poem69383.html","مجزوء الكامل"],[586,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"],[586,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["سَأَدَّرِعُ الصَوارِمَ وَالعَوالي","وَما عُرّيتُ مِن خِلَعِ الشَبابِ",0,"ب",1,0],["سَادَ الأَنامَ فَلَمْ يُعْدَلْ بِهِ أَحَدٌ","وَكُلُّ صَيْدٍ كَما قد قيلَ في الفَرَإِ",1,"ا",1,0],["سادَ وَأَلفى قَومَهُ سادَةً","وَكابِراً سادوكَ عَن كابِرِ",2,"ر",1,0],["سَأَدعوهُمُ جُهدي إِلى البِرِّ وَالتُقى","وَأَمرِ العُلا ما شايَعَتني الأَصابِعُ",3,"ع",1,0],["سادَت عَلى أَهلِ القُصو","رِ وَسَوَّدَت أَهلَ الوَبَر",4,"ر",1,0],["سادوا وَشادوا وَأَبلَوا في مَناكِبِها","بَلاءَ مُضطَلِعٍ بِالأَمرِ مِعوانِ",5,"ن",1,0],["سادَةٌ جَمَّعوا شَتاتَ المَعالي","عُظَماءُ الحُلومِ وَالأَخطارِ",6,"ر",1,0],["سادا بِغَيرِ تَكَلُّفٍ","عَفواً بِفَيضِ نَداهُما",7,"م",2,0],["سادتي جاز فضلكم آمالي","أجدير شاني بأدنى إحتفال",8,"ل",1,1],["سَادَ الإِخَاءُ عَلَى الجُمُوعِ فَلا","رُتَبٌ تُمَيِّزُهَا وَلا مِهَنُ",9,"ن",1,0],["ساد في الناس يافعاً ثم كهلاً","ثم شيخاً في التجربات عميدا",10,"د",2,0],["سَادةٍ ذَادةٍ عن الخُرَّدِ البِي","ضِ إذا اليَومُ كانَ كالأَيَّامِ",11,"م",1,0],["سادَ وَلَم يُعلَم بِسُؤدَدِهِ","أَبو وَداعَةَ قِردٌ في اِستِهِ قَمَعُ",12,"ع",1,1],["سادة السادات من دين ودنيا","بلغاءٍ وزراءٍ أولياء",13,"ا",2,0],["ساد ابن يحي في الصّبا بِثنىً","أسرى به شرقاً إلى غرْب",14,"ب",1,0],["سادوا الزمانَ كما ترى عباده","وسرَاته وهداتهُ وكماته",15,"ت",2,0],["سادت بحسن ونعمةٍ فلذا","قدْ صحَّ قولُ الورى لها سودي",16,"د",2,0],["سادت بكَ الصلوات ما أسرى بنا","للصبحِ أشهب والظلام بهيم",17,"م",1,0],["سادتي كم أتشكى","لحليّ يتغمَّمْ",18,"م",1,1],["سادتي ما كان أجمع شملي","فأصاب ذلك الشمل عين",19,"ن",1,1],["سادةٌ إن سألتَ عنهم أخا الإح","نةِ أثْنى عليهمُ غيرَ راضي",20,"ض",2,0],["سادةُ الناسِ كالجبالِ وأنتُمْ","كالنجوم التي تفوقُ الجِبالا",21,"ل",2,0],["سأدعو اللَّه مبتهلاً إليه","عليك مع الدعاة على إلالِ",22,"ل",1,0],["سادةٌ في الحق قدماً قادةٌ","وعلى اللَّوْماء فيه مَرَنه",23,"ن",2,0],["سادَ في الكَونِ مِثلَما سادَ فيهِ","خالِقُ الكَونِ مُبدِعُ الأَشياءِ",24,"ا",2,0],["سَأَدعو عَلى الجُردِ الجِيادِ لِأَنَّها","سَرَت فَأَتَت بي وادِياً غَيرَ ذي زَرعِ",25,"ع",1,0],["سَأُديرُ دِفَّتَها وَأَحمي أَهلَها","وَأَقودُها في عِصمَةٍ وَأَمانِ",26,"ن",1,0],["سادَةُ أَفريقيا","لُجَّتِها وَالأَكَم",27,"م",1,0],["ساداتُ كُلِّ أُناسٍ مِن نُفوسِهِمِ","وَسادَةُ المُسلِمينَ الأَعبُدُ القَزَمُ",28,"م",1,0],["ساداتُ نَبهانَ بنِ عَمرٍ أَقبَلوا","يُزجونَ قَحطَبَةً بِهِ وَشَبيبا",29,"ب",2,0],["سادوا وَسادَهُمُ الأَغَرُّ مُحَمَّدٌ","بِخِلالِ أَبلَخَ في الهَزاهِزِ أَبلَجِ",30,"ج",1,0],["سادَ الأَنامَ بِنَفسِهِ وَجُدودِهِ","لا مِثلَ ما في الناسِ سادَ عِصامُ",31,"م",1,0],["سادَتْ بنو حَمدانَ مَجْداً لم يَزَلْ","يُثْنى بحدِّ أسِنَّةٍ وسُيوفِ",32,"ف",1,0],["سادوا وسادَهمُ أبو حَسَنٍ","بِعُلىً تَزِينُ النَّظمَ والنَّثرا",33,"ر",2,0],["سادوا وَقَد تَرَكوا جِسمي بِلا رَمَقٍ","عِندي لِيَندُبَهُم وَالقَلبُ عِندَهُمُ",34,"م",1,0],["سأُدمي جفوني بالسهاد عقوبةً","إذا وقفت عنك الدموعَ الجواريا",35,"ي",2,0],["سادةٌ يُطْلعُ الدراريَّ منهم","فلَكٌ في العلى قَديمُ المدارِ",36,"ر",1,0],["سادِراً عامِداً تُشَهِّرُ بِاِسمي","كَي يَبوحَ الوُشاةُ بِالأَسرارِ",37,"ر",1,0],["سادوا وَقادوا ثُمَّ أَجلى جَمعُهُم","عَن وَحدَةٍ فَكَأَنَّهُم ماقادوا",38,"د",3,0],["سادَ السُراةُ بِما اِستَفادوا عَنهُمُ","إِنَّ الشُموسَ لِعِلَّةُ الأَقمارِ",39,"ر",1,0],["سَادُوا بِباطِلِهمْ ودَاسُوا حقَّنا","ولَنَحْنُ أخْلَقُ أن نَسُودَ وأجْدَرُ",40,"ر",1,0],["سادَ العِراقَ وَأَلفى فيهِ والِدهُ","مُطَلَّباً بِتِراتٍ غَيرَ مُطَّلِبِ",41,"ب",1,0],["سادَ الرِّجالَ فَقَصَّرَتْ عَنْ شَأْوِهِ","هِمَمُ المُؤَوِّبِ لِلْعُلا وَالمُسْئِدِ",42,"د",1,0],["سادَ المُلوكَ ثَلاثَةٌ ما مِنهُمُ","إِن حُصِّلوا إِلّا أَغَرُّ قَريعُ",43,"ع",1,1],["سادَ الرَبيعُ وَسادَ فَضلٌ بَعدَهُ","وَعَلَت بِعَبّاسِ الكَريمِ فُروعُ",43,"ع",1,0],["سَأَدعو بِأَخلاقي الكَرائِمِ قُربَها","وَبِالوُدِّ إِن كانَت تَدومُ عَلى الوُدِّ",44,"د",1,0],["سادِراً أَحسَبُ غَيِّي رَشَداً","فَتَناهَيتُ وَقَد صابَت بِقُر",45,"ر",1,0],["سَادَ فِي مَوْضِعِ الحَرَاكِ سُكونٌ","عَادَ فِيهِ بِالخَيْبَةِ التَّأْمِيلُ",46,"ل",1,0],["سَادَاتُ عَدْنَانَ لَمْ يَأْبَوْا تَعَاطِيَهَا","فَأَيُّ عُذْرٍ لِمَنْ عَنْ نَهْجِهِمْ صَدَفَا",47,"ف",2,0],["سادتي عفوا ! ستبدو قصتي","عندكم عاديّة ، ممتهنه",48,"ن",2,0],["سادَ السكونُ على العوالم كُلَّها","وتَجلبب الوادي رِداءَ خموله",49,"ل",2,0],["ساداتُ نَبْهَانَ بنِ عَمْروٍ أقْبَلُوا","يُزْجُونَ قَحْطَبَةً به، وَشَبيبَا",50,"ب",2,0],["سادِراً عَامِداً تُشهِّرُ بکسْمي","كَيْ يَبُوحَ الوُشاة ُ بالأَسْرَارِ",51,"ر",1,0],["سادات كبار الالى اعبد","والمصطفى حامي الحما السيد",52,"د",1,0],["سادت مناقبه بين الورى مثلاً","وفضله سار بين العجم والعربِ",53,"ب",1,0],["سأدرك بالممهد منك ثأري","ولو في الجو طار بك الرياحُ",54,"ح",1,0],["سأدعو من يجيب غداةَ يدعى","إِلى الُحلّى وإن بعدَ المغَار",55,"ر",1,0],["سادَ الوَرى طِفلاً وَبَرَّزَ يافِعاً","لَم يَتَّغِر وَبَنى المكارِمَ أَمرَدا",56,"د",2,0],["سادُوا قُرَيشاً عُلاً في جاهِلِيَّتِها","وَمَن يُسامي قُرَيشاً أَو يُبارِيها",57,"ي",3,0],["سادَ الفَسادُ بِهِمْ فَسا","دَ التُّركَ فيهِ بَلا مُعاكِسْ",58,"س",1,0],["سأَدعو الله معْ سَرَف المَعاصِي","فقد تدعو العُصاة وقد تُجاب",59,"ب",1,0],["سادَ الوَرى في سائر الأعصارِ","وَعَصرهُ سيّدُ كلِّ عصرِ",60,"ر",1,0],["سادتِ الأرضَ فالمساجدُ أضحت","وَالزوايا عبيدها والإماءَ",61,"ا",2,0],["سادَ كلَّ الوَرى بكلّ كمالٍ","خيرُ حرٍّ للَّه عبدٌ رقيقُ",62,"ق",1,0],["سادَه اللَّه وحدهُ فهوَ عب","دُ اللَّه حقّاً له الأنام عبيدُ",63,"د",1,0],["سادَتي يا بني النبيّ نداءٌ","مِن عُبيدٍ يُرضيه هذا النداءُ",64,"ا",2,0],["سادةُ الناسِ أنتُم باِتّفاقٍ","وَخلافٌ في غيركم أو خفاءُ",64,"ا",2,0],["سادتي انشروا العلوم لتشفي","ما يجسم البلادِ من اسقام",65,"م",1,0],["سادوا بخير المرسلين وكم حووا","مجدا به من طارف وتلاد",66,"د",1,0],["سادوا وشادوا محلا في العلا ولهم","باعظم الرسل تعظيم وتبجيل",67,"ل",1,0],["ساد الورى ولقد شاد العلا رتبا","افديه من حرم بالمجد معمور",68,"ر",1,0],["ساد الانام سماحة وحماسة","فعلى كلا الحالين فهو الطائي",69,"ا",2,0],["سادرا كالضلال في قلب حب","عاش أيامه أسير العيون",70,"ن",1,0],["سأدفع الدين في يوم وفي سنةٍ","إن كنت في سنة الأحلام تلقاني",71,"ي",1,0],["سادُوا ولم يَبلُغوا ما أنتَ بالغُه","كذلِك الأرَض فيها السهل والجبل",72,"ل",1,0],["سادُوا وقادُوا الورَى وما احْتَلمَوا","وكَمَّلوا حِلْمَهمْ وما اكْتَهلوا",73,"ل",3,0],["سأَدفعُ بالراح جيشَ الهموم","ومن عالَ نفسي وما غالها",74,"ل",3,0],["سادَتي أَن تَصِلوني","رَحمَةً أَو تَهجُرون",75,"ن",1,0],["ساداتُ مَكَّةَ وَالأَشرافُ مِن مُضَرٍ","أَنتُم وَجيرانُ بَيتِ اللَهِ وَالحَرَمِ",76,"م",1,0],["سَأُدرِكُها وَشيكاً وَاللَيالي","مُخَزَّرَةٌ نَواظِرُهُنَّ حولُ",77,"ل",1,0],["سادَت بِهِم هاشِمٌ عَلى سالِفِ الد","دَهرِ وَسادَت بِهاشِمٍ مُضَرُ",78,"ر",1,0],["سادتي لاتهملوا مادحكم","فَلَقَد لذت بكم منتصرا",79,"ر",2,0],["سَأَدفَعُ في صَدرِ التَواني بِراحَتي","وَأَلطُمُ خَدّي هَزلِهِ بِيَدَي جِدّي",80,"د",2,0],["سادَ بِمَجدٍ وَسَماحٍ مَعاً","وَما سَماحُ المَرءِ إِلّا رَباح",81,"ح",1,0],["سادَ بِجودِهِ وَبَأسِهِ مَعاً","كُلَّ المُلوكِ مَشرِقاً وَمَغرِبا",82,"ب",2,0],["ساد الانام برى السهام حمى الحمى","أهدى السلام فنال منا ما يريد",83,"د",1,0],["سادت بنيره الجبال وأشرقت","وتشرفت وتزينت وغدت تميد",83,"د",1,0],["ساد فينا وصار ترجى أياديه","ويخشى حسابه وعقابُه",84,"ب",2,0],["سادَ الأكابرَ فضلاً راجحاً وَحجى","لذاك أَلقتْ إليه بالمقاليد",85,"د",1,0],["سادوا الممالكَ من هندٍ لأندلسٍ","محكّمين بها عدلاً وإحسانا",86,"ن",2,0],["سادوا الأنام علا وهم من جنسهم","ومن الحجارة إثمدٌ في الأعين",87,"ن",1,0],["سادِراً والطريقُ شتّى المناحى","وهو في شا