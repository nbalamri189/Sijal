{"poems":[[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[47,"يا قتيلا للحية السوداء","https://www.aldiwan.net/poem10212.html","الخفيف"],[18,"إن في الصدر من كليب شجوناً","https://www.aldiwan.net/poem23959.html","الخفيف"],[82,"يا رسولي الذي يحدث سمعي","https://www.aldiwan.net/poem31299.html","الخفيف"],[52,"سترى حول سريري","https://www.aldiwan.net/poem62247.html","مجزوء الرمل"],[78,"يا قتيلا من يده","https://www.aldiwan.net/poem39332.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43665","المديد"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96978","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/141860","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79805","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79818","الخفيف"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96040","الرمل"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105081","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118939","الخفيف"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34724","الخفيف"],[4590,"","https://poetry.dctabudhabi.ae/diwan/poem/20865","الرمل"]],"verses":[["يا قَتيلاً قَوَّضَ الدَهرُ بِهِ","عُمُدَ الدينِ وَأَعلامَ الهُدى",0,"ا",1,0],["يا قتيل الآداب انك باق","وستحيا في انفس العشاق",1,"ق",1,0],["يا قَتيلاً لِلِّحيَةِ السَوداءِ","آفَةُ المُردِ في خُروجِ اللِحاءِ",2,"ا",2,1],["يا قَتيلاً نَماهُ فَرعُ كَريمٌ","فَقدُهُ قَد أَشابَ مِنّي المِساحا",3,"ح",2,0],["يا قتولاً أرى لها في نضالي","حدّ سهمٍ مثلّماً حَدّ سَهْمي",4,"م",2,0],["يا قَتيلاً قَتَلَتهُ","عَبدَةُ الحَوراءُ ظُلما",5,"م",2,0],["يا قَتيلاً مِنْ يَدِه","مَيّتاً مِنْ كمَدِهْ",6,"د",2,1],["يا قَتيلاً طُلَّ مِنهُ دَمٌ","بَينَ أَسدِ الغابِ طُلَّبهِ",7,"ه",1,1],["يا قَتيلَ الرّعافِ كَيفَ نَبا مِن","كَ حُسامٌ لَهُ مَضاءٌ وَفَتكُ",8,"ك",1,0],["يا قَتيمَ الرّعافِ أَعزز عَلَينا","بِدَمِ طَلُّهُ مِنَ الأَنفِ سَفكُ",8,"ك",1,0],["يا قَتيلَ الرّعافِ إِنّي غَريقٌ","في بِحارٍ لَم يَجرِ فيهِنَّ فُلكُ",8,"ك",1,0],["يا قَتيلاً مُهراقاً دَمُهُ","وَبِحَدِّ المُنتَضى لَم يُهرق",9,"ق",1,0],["يا قَتِيلَ الْفِينيك يَكْفِيكَ قَتْلا","كَ فَأَغْمِدْ حُسامَكَ الْمَسْلُولا",10,"ل",2,0],["يا قتيلاً شقت عليه المعالي","جيبها واكتست ضناً وسقاما",11,"م",2,0],["يا قتيل العلياء يومك أبكى","كل عين خلا عيون الأعادي",12,"د",2,0],["يا قتيلاً وما نعته المرنّات","ولم تبكه الضُبا الباترات",13,"ت",1,0],["يا قتيلاً ولا مزنةُ نبعٍ","بشباها وليّ ثار نعاكا",14,"ك",2,0],["ياقتيه الشام للعلياء ثورتكم","وما لا يضيع مع العلياء مجهود",15,"د",1,0],["يا قتيلاً أصبحت دار العلى","بعده قفراً وربع الجود محلا",16,"ل",2,0],["يا قتيلاً تقل سمر العوالي","منه رأساً على سنا الشمس موف",17,"ف",1,0],["يا قتيل الغرام كن بي مُعَنى","أنا في الحب ألطف الناس معنى",18,"ن",2,1],["يا قَتيلَ العُراةِ مُلقىً عَلى الش","طِّ تَطاهُ الخُيولُ في الجانِبَينِ",19,"ن",1,0],["يا قتيلاً قوض الدهر به","سقف بيتي جميعاً من عل",20,"ل",1,0]]}