{"poems":[[88,"بين السرائر ضنة دفنوك","https://www.aldiwan.net/poem10365.html","الكامل"],[95,"إنا نحيي حفلكم ويسرنا","https://www.aldiwan.net/poem11405.html","الكامل"],[48,"يدعو الغراب أناس حاتما سفها","https://www.aldiwan.net/poem23344.html","البسيط"],[92,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[164,"حصنت ذا الوجه الأغر","https://www.aldiwan.net/poem58781.html","مجزوء الرجز"],[164,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[190,"إن صد إلفك بعد وده","https://www.aldiwan.net/poem43918.html","مجزوء الكامل"],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[275,"يا حبذا وطن يضم تلاديا","https://www.aldiwan.net/poem34977.html","الكامل"],[275,"من رقصة الإنس أم من رقصة الجان","https://www.aldiwan.net/poem35257.html","البسيط"],[308,"قد شاع أنك زرتني متسترا","https://www.aldiwan.net/poem57574.html","الكامل"],[382,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[484,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[567,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203594","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72306","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93635","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76504","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123470","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133116","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147286","الكامل"],[4755,"كُله جشائب","https://www.poetsgate.com/ViewPoem.aspx?id=191418",""],[4858,"نذير الثّلج","https://www.poetsgate.com/ViewPoem.aspx?id=155081",""],[4978,"هذا التمازج","https://www.poetsgate.com/ViewPoem.aspx?id=177195",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5185,"الدرع","https://www.poetsgate.com/ViewPoem.aspx?id=117928",""],[572,"لولا اطّرادُ الصّيدِ لم تَكُ لذّة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=25016",""],[5410,"ثورة أنين","https://www.poetsgate.com/ViewPoem.aspx?id=133057",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5720,"يا أيها الشبلُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199718",""],[5829,"نفحات السحر","https://www.poetsgate.com/ViewPoem.aspx?id=152736",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5848,"كرهت نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=53378",""],[5848,"مالك ومال للتعب ياجارة الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=48821",""],[5939,"حكايات الرمال","https://www.poetsgate.com/ViewPoem.aspx?id=178632",""],[5956,"لِمَ تقطعين الغاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=182417",""],[5956,"ماذا أقول لمن أردتُ زواجها؟","https://www.poetsgate.com/ViewPoem.aspx?id=182522",""],[5956,"لم ألقَ حسناءً عليّ تجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=182620",""],[5956,"‏متزلف أنا للإله الباري","https://www.poetsgate.com/ViewPoem.aspx?id=183921",""],[5956,"الفطرة البيضاء، والفطرة السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192038",""],[5956,"تنقلكم شوّش استقراري","https://www.poetsgate.com/ViewPoem.aspx?id=193157",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""],[5956,"كرّسْتَ وقتك من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=194263",""],[5977,"سنابل المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=213793",""],[6108,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=192588",""]],"verses":[["هَذا التُرابُ وَأَنتِ أَعلَمُ مُلتَقى","هَذا الوَرى مِن سوقَةٍ وَمُلوكِ",0,"ك",1,0],["هَذَا التَّآلُفُ بَيْنَكُمْ عَنْوَانُ مَا","نَرْجُوهُ لِلنَّشءِ العَزِيزِ النَّامِي",1,"م",2,0],["هَذا التَكَذُّبُ ما لِلجَونِ مَّعرِفَةٌ","وَلا يُبالي أَنالَ المَدحَ أَم شَتُما",2,"م",2,0],["هذا التعنُّتُ في تَبصُّرِه","متوقّداً كتوقُّ اللَهَب",3,"ب",1,0],["هذا التقي بن التقي","المنتقي من الدرر",4,"ر",1,0],["هذا التخاذلُ بينكم صرتم به","عون لكم عون على من عادا",5,"د",2,0],["هذا التأني وهذا الحلمُ قد فَعلا","ما أَعجزَ البيضَ يوم الروع والأسلا",6,"ل",2,1],["هذا التبسّم للحي","اة مع النعيم بمستحدّه",7,"د",2,0],["هذا التفرق والتخاذل بيننا","آثار ما بذلوه منذ سنين",8,"ن",1,0],["هذا الترابُ مقدَّسٌ برفاتهِ","ونباتهِ وبهِ أفي أجداديا",9,"د",3,0],["هذا التثنِّي ثنى كلَّ القلوبِ إلى","قدٍّ فحامت طيوراً فوقَ أغصان",10,"ن",1,0],["هذا التواتر كاذبٌ إذ لم يكن","عندي أنا الطرفان مثل الواسطه",11,"ه",1,0],["هذا التواضع إن أردتَ مواهبا","تغنيك فاقصده تجدهُ واهبا",12,"ب",2,1],["هذا التماسي وحسن الظن رائده","اللّه ناشدتكم في الرائح الغادي",13,"د",2,0],["هذا التقي الذاكر القوام في الليل","المعظم ربه تعظيما",14,"م",2,0],["هذا التقي المظلوم ما بين الورى","من صيروه بظلمهم مشتوما",14,"م",2,0],["هذا التَّقِيُّ النَّقِيُّ الطَّاهرُ النَّسَبِ اُبْ","نُ الطَّاهرِ النَّسبِ ابنِ الطَّاهرِ النَّسَبِ",15,"ب",1,0],["هذا التعصب عندنا محض اسمه","والفعل مجهول لدى الكرماء",16,"ا",2,0],["هذا التقى الطاهر الذيل الذي","يسمو بعرض في الأنام مصون",17,"ن",1,0],["هذا التناقض أوهى علمهم وبذا","يستضحك الجهل فيه ساير لمثل",18,"ل",1,0],["هذا التناقض في اعتقادك شاهد","يقضي عليك بأن دينك عجرفه",19,"ف",2,0],["هذا التقي الندب مِن حَسناته","فَاِنظُر لَها وَعَلَيهِ سائِرها قس",20,"س",1,0],["هَذا التَعيس وَذاك ما قَد مر في أَفكاره","في ذلك الاسطبل او ما عد من اثاره",21,"ه",1,0],["هذا التَّمدُّنُ حقّاً إن عُنيتَ به","لا غيرُه فاترُكِ الأوهامَ والخوَرا",22,"ر",2,0],["هذا التَّمدن هذا الفضلُ فاعنَ به","ليس التمدنُ بالألحانِ والغزَل",23,"ل",1,0],["هذا التاريخُ يُعيدُ نفسَه زمناً","حُسنُ المعادِ بيُمنِ العدلِ لا تُحِل",23,"ل",1,0],["هذا التقى يا خليلي خذ به أبداً","أوصى به الله كما في محكم السور",24,"ر",1,0],["هذا التشاؤم لم تَشأهُ سجيتي","هو قوة عظمى أتت تستعبد",25,"د",1,0],["هذا التَّرَاخِي إن صَارَ يُدعَى","\"عَيشًا كَرِيمًا\" فالمَوتُ وَاجبْ",26,"ب",1,0],["هذا التنَوُّعُ في الطّبيعة حكمةٌ","يقضي بها مَن شأنُهُ التّدبيرُ",27,"ر",1,0],["هذا التمازج في الأرواح أهواه","به حللت وقلبي صار سكناه",28,"ا",2,1],["هذا التنائي خنجرٌ وكآنني","في كلِّ يومٍ قُطِّعتْ أشلائيهْ",29,"ي",2,0],["هذا التوحد صار آخرَ معقلٍ","للثائرين ، وخلفه الميدان",30,"ن",1,0],["هذا التّرابُ أخو الحياة ِ وَما لَهُ","من لذّة ٍ حتّى يُصِيبَ غَلِيلا",31,"ل",2,0],["هذا التراب ينادي اليوم منغمساً","في طعنة الغدر، بالآلام مختضبا",32,"ب",2,0],["هذا الترابُ دمٌ بالدّمعِ ممتزجٌ","تهبُّ منه على الأجيالِ أنسامُ",33,"م",1,0],["هذا التغني .. فابتهجْ بمكانةٍ","تسمو بها في جنةِ الرحمنِ",34,"ن",1,0],["هذا التجلي فاغتنمها سنحة","واقصد رضا الرحمن في الاوطار",35,"ر",1,0],["هذا التحرر يا نساء مكيدة","قد حاكها الغرب البغيض وداء",36,"ا",2,0],["هذا التعب مكتوب والضيق مقري","والسالفة طالت وانا ماني بخير !",37,"ر",1,0],["هذا التعب .. من سنين العمر متمادي","رافقني سنين من عمري , ورافقته",38,"ت",2,1],["هذا التعب , من سنين طوال متمادي","من كثر ما هو وفا لي عمر , رافقته",38,"ت",2,0],["هذا الترابُ إذا تَجَلْ","لَتْ فيهِ رُوحُ اللهْ",39,"ه",1,1],["هذا التحمْحُمُ من فؤادك هادلٌ","بجوارحي ومسامعي متغلبُ",40,"ب",1,0],["‏ ‏هذا التكرم للكريمة لا لها","ردُّ اللئيمة أن تريك هياجَها",41,"ج",3,0],["هذا التجاذب والتصادم بيننا","متفتح لجماله الأخدودُ",42,"د",1,0],["هذا التشاؤم في الأنام عقيدة","وأقرّها القرآن في الأنوارِ*",43,"ر",1,0],["هذا التنوع فرحةٌ ضد الأسى","ضد الملالة خدمةٌ لتفاؤلي",44,"ل",2,0],["هذا التنقل شوّش استقراري","فأخذت ألمسُ هل خلعتُ إزاري؟",45,"ر",2,1],["هذا التوجه فينا كان من قِدَمٍ","إلى النهار حماةُ العِلْمِ والعَلَمِ",46,"م",1,0],["هذا التقيُّ النقي الشهم أوصلني","بعد الإله تماماً مثلما حلُمي",47,"م",2,0],["هذا التنافس يا صحاب مزية","للقادة الأحرار للعظماءِ",48,"ا",2,0],["هذا التناقضُ في الوجود أضاعني","ويظلُّ عمْري للمناجل سنْبُلةْ",49,"ل",2,0]]}