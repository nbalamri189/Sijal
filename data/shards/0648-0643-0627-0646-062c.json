{"poems":[[79,"وكأن جنح الليل أسود سارق","https://www.aldiwan.net/poem35999.html","الطويل"],[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[53,"وكأن جرذان المحلة كلها","https://www.aldiwan.net/poem64707.html","الطويل"],[93,"بكيت ولكن بالدموع السخينة","https://www.aldiwan.net/poem8782.html","عموديه"],[40,"صدقت معية نفسه فترحلا","https://www.aldiwan.net/poem7809.html","الكامل"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[47,"هجاني النغيل وما خلتني","https://www.aldiwan.net/poem65634.html","المتقارب"],[30,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[30,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[63,"أي قواف يعز مونقها","https://www.aldiwan.net/poem51511.html","المنسرح"],[51,"ستباشر الأجداث وحدك","https://www.aldiwan.net/poem62062.html","مجزوء الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[52,"أصفراء كان الود منك مباحا","https://www.aldiwan.net/poem63958.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[124,"يا حبذا أمسى من","https://www.aldiwan.net/poem49366.html","مجزوء الرجز"],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50661.html","الطويل"],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[173,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[234,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[261,"فديت عز الدولة المرتجى","https://www.aldiwan.net/poem48357.html","السريع"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[275,"راحتي في راحتيها","https://www.aldiwan.net/poem35375.html","مجزوء الرمل"],[287,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[353,"عوفيت من جرب به","https://www.aldiwan.net/poem20452.html","مجزوء الكامل"],[405,"وقد رزينا به محضا خليقته","https://www.aldiwan.net/poem4511.html","البسيط"],[463,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[463,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[469,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[469,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[473,"أبا علي علي ليس ينصفه","https://www.aldiwan.net/poem59876.html","البسيط"],[498,"ويوم كأن الدهر سامحني به","https://www.aldiwan.net/poem67368.html","الطويل"],[549,"في كل عضو منك روح تقى","https://www.aldiwan.net/poem67236.html","عموديه"],[556,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[572,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[580,"حكيت جسمي تحولاً","https://www.aldiwan.net/poem2898.html","المجتث"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104085","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48729","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77613","الرجز"],[1120,"","https://poetry.dctabudhabi.ae/diwan/poem/73941","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73494","الوافر"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114006","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108974","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27791","الطويل"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21468","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60873","البسيط"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84925","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100213","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204861","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118797","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97962","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91783","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103806","الكامل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114632","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75691","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122437","الوافر"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130867","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[4487,"","https://poetry.dctabudhabi.ae/diwan/poem/18777","الطويل"],[4976,"في رحاب شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=207834",""],[5030,"أم المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=215814",""],[5038,"النحر الخضيب","https://www.poetsgate.com/ViewPoem.aspx?id=196698",""],[585,"أجل إنه الفجر الذي أنت آمله","https://www.poetsgate.com/ViewPoem.aspx?id=161921",""],[5102,"غلطة..","https://www.poetsgate.com/ViewPoem.aspx?id=12894",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[402,"في أي جو بالأسى مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=36328",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[694,"قد كان بعدك أنباء وهنبثة","https://www.poetsgate.com/ViewPoem.aspx?id=81337",""],[469,"كفي كؤوسك فالمدامة ما سقت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574769",""],[1134,"قُلْتُ لِزِيرٍ لَمْ تَصِلْهُ مَرْيَمُهْ","https://diwany.org/%D9%82%D9%8F%D9%84%D9%92%D8%AA%D9%8F-%D9%84%D9%90%D8%B2%D9%90%D9%8A%D8%B1%D9%8D-%D9%84%D9%8E%D9%85%D9%92-%D8%AA%D9%8E%D8%B5%D9%90%D9%84%D9%92%D9%87%D9%8F-%D9%85%D9%8E%D8%B1%D9%92%D9%8A%D9%8E%D9%85/","الرجز"],[463,"أرأيتَ أمْ حبستْ لحاظكَ عبرة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60108&r=&rc=164",""]],"verses":[["وكأنّ جُنْحَ اللّيْلِ أسْودُ سارِقٌ","سَرَقَ الصّباحَ الطَّلْقَ ثَوْباً أبْيَضا",0,"ض",2,1],["وَكَانَ جِسْراً لِتَلاقِي الْعُلَى","مِنْ عُدْوَتَيْهَا وَبِهَذَا سُمِي",1,"م",2,0],["وكأن جنبك بالجوى متقرّح","وكأن قلبك بالهموم رضيض",2,"ض",1,0],["وكأن جُرذان المحلة كلها","في حلقهِ يقرضن خُبزاً يابسا",3,"س",2,1],["وَكانَ جَواداً لا يَضُنُّ بِحاجَةٍ","لِذَلِكَ أَعطى روحَهُ لِلمَنِيَّةِ",4,"ه",1,0],["وَكَأَنَّ جِزيَةَ تاجِرٍ وُهِبَت لَهُ","يَوماً إِذا اِستَقبَلنَ غَيثاً مُبقِلا",5,"ل",2,0],["وَكانَ جِسماً هامِداً","حَرَّكتُهُ فَاِضطَرَبا",6,"ب",2,0],["وَكانَ جَنابُهُم فيها مَهيباً","وَلَلأَخلاقِ أَجدَرُ أَن تُهابا",7,"ب",2,0],["وَكانَ جَزائِيَ ما قَد عَلِم","تَ وَما لَم يَكُن لَكَ أَن تَفعَلَه",8,"ل",2,0],["وَكانَ جَريرٌ عَلى قَومِهِ","كَبَكرِ ثَمودٍ لَها الأَنكَدِ",9,"د",1,0],["وَكَأَنَّ جارَ بَني المُعَلّى مُشرِفٌ","مِن رَأسِ رَهوَةَ فَوقَ أُمِّ وُعولِ",10,"ل",1,0],["وكان جُودُ الكِرامِ يُنبِتُها","فصارَ مَنْعُ اللِّئامِ يُحْرِقُها",11,"ق",3,0],["وَكَأَنَّ جَمعَكَ قَد غَدا","ما بَينَهُم حِصَصاً وَكَدَّك",12,"ك",1,0],["وكان جِبْرِيلُ مرآة رأَيْتَ بِها","في الليلِ نوراً وفي المُسْتَضْعَفِ الأَيَدَا",13,"د",2,0],["وكأنّ جُرْدَ الخيل تحت حُماتها","عُقبانُ جوٍّ جُنّحٍ بِقساوِرِ",14,"ر",1,0],["وكان جُرحُكِ إلهامي مُشاركَةً","وكان يأخذُ من جُرحي ويُعطيني",15,"ن",2,0],["وكانَ جَمَّعَ أمْوالاً وَعَدَّدَها","وظَنَّهَا لِصُروفِ الدَّهْرِ تُدَّخَرُ",16,"ر",1,0],["وَكانَ جَواري الحَيِّ إِذ كُنتِ فيهِمُ","قِباحاً فَلَمّا غِبتِ صِرنَ مِلاحا",17,"ح",2,0],["وكان جَرْحُك يأسو كلَّ ما جرحَتْ","يدُ الزمان ويحيى كلَّ ما اجتاحا",18,"ح",2,0],["وكان جرحي قد أوى","على الليالي فغفر",19,"ر",1,0],["وكان جديراً أن نزور دياركم","على الرأسِ نَسْعَى لا على الإبْل نركبُ",20,"ب",1,0],["وَكَأَنَّ جاديّاً بِهِ وَأَرَندَجا","وَبِوجهِهِ سُفعٌ كَلَونِ السُّندُسِ",21,"س",1,0],["وَكأَنَّ جاحِمَ كُلِّ نارٍ أُوقِدَت","لِلحَربِ في عَينَيهِ نارُ مُهَوِّلِ",22,"ل",1,0],["وكأنّ جودَك دِيمةٌ ومديحنا","نَشْر ونحن الزَّهْر حين سقانا",23,"ن",2,0],["وكان جسماً وروحاً","يسمو بها كلُّ بَرّ",24,"ر",1,0],["وكان جوفي بالخوى مأتماً","فاليوم بيت العرس في معدتي",25,"ت",2,0],["وكان جودك في وجود أولي اللهى","عام يغيث وسبعة جارود",26,"د",1,0],["وكأنْ جنَّةُ وردٍ","خَلعت ثوباً عليها",27,"ي",3,0],["وَكانَ جَزيلاً لِلعُفاةِ عَطاؤُهُ","يَظُنّونَ جَهلاً أَنَّهُ هازِلٌ هازي",28,"ز",2,0],["وَكأَنَّ جِسمِى مِن دَمي","بِأَظافِرِى الرُّكْنُ المُخَلَّقْ",29,"ق",1,0],["وَكانَ جبريلُ روح القدسِ زائرنا","فَغابَ عنّا وكلّ الخير محتجبُ",30,"ب",1,0],["وكأن جاثمةَ الثَّغامِ بعُقرها","أشياخُ حيّ جالسين القُرفُصا",31,"ص",2,0],["وكان جباناً لسانُ السؤالِ","فأصبح وهو جريءٌ جسورُ",32,"ر",1,0],["وكأنَّ جذوةَ حدّه في مائهِ","ناري تزيد على البكاء توقدا",33,"د",2,0],["وكأنَّ جوهرها أفاض شعاعهُ","وجهُ المظفّر بينُ الأملاك",34,"ك",1,0],["وَكان جاهُكَ مَمدوداً عَلَيهِ إِذا","رَنا إِلَيهِ الأَذى غَطّاهُ رَفرَفُهُ",35,"ف",2,0],["وَكانَ جَوابي طاعَةً لا مَقالَةً","وَمَن ذا الَّذي لا يَستَجيبُ إِلى اليُسرِ",36,"ر",1,0],["وكأنَّ جِيدَكِ في استقامتِهِ","مُتَمَسِّكٌ بالعروةِ الوثقى",37,"ق",2,0],["وَكأنّ جارَهُمُ مقيمٌ بينهمْ","في منزلٍ قَفْرٍ ورسمٍ داثرِ",38,"ر",1,0],["وَكَأَنَّ جُؤْجُؤَهُ وَرِيْشَ جَنَاحِهِ","خُضِبَا بِنَقْشِ يَدِ الفَتَاةِ العَاتِقِ",39,"ق",1,0],["وكان جَفْنَكَ مُضْنىً","فصرتَ كلُّكَ جَفْنَكْ",40,"ك",1,0],["وكأنَّ جنَّ قرائح","الشعراءِ تلبثُ صاحيَه",41,"ي",2,0],["وكأنّ جسمَك من وراء حجابها","دينٌ يشحُّ بهِ تقيُّ مُسلمُ",42,"م",1,0],["وكان جزاء المانع الخير عزله","ولست بمستشف بما هو كائن",43,"ن",1,0],["وَكانَ جوعاناً فَرامَ يُقرِضُه","فَلا تعنِّفه فَهَذا غَرَضُه",44,"ه",1,0],["وَكانَ جَميلُ الصَّبرِ أَليَقَ بِالفَتى","وَلا دَرَّ دَرِّي إِن تَجَمَّلتُ بِالصَّبرِ",45,"ر",1,0],["وَكَانَ جَمّاً شَاؤُهُ وَنَعَمُهْ","وَفَقْدُ مالٍ كَالجُنُونِ لَمَمُهْ",46,"م",2,0],["وَكانَ جَنابُها يَخضرُّ آسا","فَأَصبَحَ وَهُوَ مَبيضٌ أَقاحا",47,"ح",2,0],["وكأنَّ جيد جدايَةٍ أودُميَةٍ","من مرمَرٍ حاطا به عِقداها",48,"ا",3,0],["وكأن جود يديه ساعة دفنه","مس الثرى فاخضرت الحصباء",49,"ا",2,0],["وكان جليساً للخضارمةِ العُلى","بمقعد صدقٍ للنفوسِ مؤيدا",50,"د",2,0],["وكأن جدوله المرقرق صفحة","سيف تشرب من خلال الغلفق",51,"ق",1,0],["وَكانَ جلَّ ديونٍ فاقتضينَ بِهِ","وَقَد يلوّي الغَريمَ الماطِلُ المَعِكُ",52,"ك",1,0],["وكان جبريل يأتي ببيت مكتكمُ","محبّةً لنبيٍّ فيه مُختارِ",53,"ر",1,0],["وَكَان جَميع القُطر مُفتَخر بِهِ","فَأَضحى كَثَكلي حُزنه غَير منجلى",54,"ل",2,0],["وَكانَ جَميعُ الواقِفينَ مُنَهنَهاً","يساقِطُ دَمعاً مِن دِماء حُشاشَتي",55,"ت",2,0],["وكأن جعدك فوق خدك مرسلا","ليل أحم البردتين مكوكب",56,"ب",1,0],["وكان جسمي قافزاً مثلهم","لولا ضناه دون ترديد",57,"د",1,0],["وكان جسمي عليلاً فاشتفت عللي","وطاب وقتي وأنفاسي وأحياني",58,"ن",2,0],["وكأن جسمي ذرة","في الريح أو هو نفثة",59,"ه",1,0],["وَكانَ جَنبي بجنبها لصقاً","إِذا تمشّت وَفي يَدي يدها",60,"د",3,0],["وَكان جلال الدَهر وَهوَ جمالُه","وَكان وليّ الأَمر دفع المهمة",61,"ه",1,0],["وكأن جلدة وجهها","سلخت على عجل بخنجر",62,"ر",1,0],["وكأن جنح الليل طرف ادهم","متضمن من صبحه تحجيلا",63,"ل",2,0],["وكأن جمر جوانحى","فى خده تتلهب",64,"ب",1,0],["وكان جديرا أن يزلزل أرضها","ويبكي لديها الدهر نوح الحمائم",65,"م",1,0],["وكانَ جدولها الزلال مجرة","وَكأَنَّما ذاك الحباب الأنجم",66,"م",1,0],["وكان جسما فقيد الروح ذا ظلم","فمذ بدا النور أحياه وجلاه",67,"ا",2,0],["وكان جوابُهُ عِندي عَتيداً","ويكفي مثلَهُ منِّي القَليلُ",68,"ل",1,0],["وكان جزاهم كالمحارب ربه","ويسعى فساداً في البرارى وفي البحر",69,"ر",1,0],["وكان جناحي ان نَهضتُ أقلّني","ويحوي الجناحُ الريشَ ان يتنَزعا",70,"ع",2,0],["وَكانَ جِهادٌ قَد مَلَكنا بِأَمرِهِ","مِنَ المُلكِ مُستَعلي البِناءِ المُذَهَّبِ",71,"ب",1,0],["وكان جلالُكم لما تجلَّى","على الأكوانِ حررتَ الرقابا",72,"ب",2,0],["وكان جبريلُ بالتسليمِ يُقرئها","وتنقضي عندها للناسِ حاجاتُ",73,"ت",1,0],["وَكَأَنَّ جَدَّكَ لِلْأَنامِ نَذيرُ","وَكَأَنَّ حَيدَرَ لِلْهُداةِ أَميرُ",74,"ر",1,1],["وكان جديراً أن يكون مخلداً","فكيف وملء الخافقين عقائله",75,"ل",2,0],["وكان جوابك برقيةً","تضمنت الجملة أو تكادْ",76,"د",1,0],["وكأنَّ جيشَكَ وهو يزحَفُ واقِفاً","جبَلٌ يسيرُ إلى القِتالِ حَسيرا",77,"ر",2,0],["وكان جسرا لتلاقي اعلى","من عدوتيها وبهذا سمي",78,"م",2,0],["وكان جناحاه الملائك تحمين","مسالك سبل الحق من كل شبهتي",79,"ت",2,0],["وكان جبريل بالآيات يحضرنا","فغاب عنا وكل الغيب محتجب",80,"ب",1,0],["وكأنّ جوهرها أفاض شعاعه","وجه المظفِّر نيِّر الأملاك",81,"ك",1,0],["وَكَانَ جَمّاً شَاؤُهُ وَنَعَمُهْ","وَفَقْدُ مالٍ كَ",82,"ك",1,0],["وكأنَّ جائمة َ الثِّغامِ بعقرها","أشياخُ حي جالسينَ القرفصا",83,"ص",2,0]]}