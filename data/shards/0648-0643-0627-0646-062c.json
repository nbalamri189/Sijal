{"poems":[[77,"وكأن جنح الليل أسود سارق","https://www.aldiwan.net/poem35999.html","الطويل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[51,"وكأن جرذان المحلة كلها","https://www.aldiwan.net/poem64707.html","الطويل"],[91,"بكيت ولكن بالدموع السخينة","https://www.aldiwan.net/poem8782.html","عموديه"],[38,"صدقت معية نفسه فترحلا","https://www.aldiwan.net/poem7809.html","الكامل"],[85,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[45,"هجاني النغيل وما خلتني","https://www.aldiwan.net/poem65634.html","المتقارب"],[28,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[28,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[61,"أي قواف يعز مونقها","https://www.aldiwan.net/poem51511.html","المنسرح"],[49,"ستباشر الأجداث وحدك","https://www.aldiwan.net/poem62062.html","مجزوء الكامل"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"أصفراء كان الود منك مباحا","https://www.aldiwan.net/poem63958.html","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[121,"يا حبذا أمسى من","https://www.aldiwan.net/poem49366.html","مجزوء الرجز"],[129,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50661.html","الطويل"],[157,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[170,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[186,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[230,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[257,"فديت عز الدولة المرتجى","https://www.aldiwan.net/poem48357.html","السريع"],[262,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[271,"راحتي في راحتيها","https://www.aldiwan.net/poem35375.html","مجزوء الرمل"],[283,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[349,"عوفيت من جرب به","https://www.aldiwan.net/poem20452.html","مجزوء الكامل"],[400,"وقد رزينا به محضا خليقته","https://www.aldiwan.net/poem4511.html","البسيط"],[459,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[459,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[465,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[465,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[469,"أبا علي علي ليس ينصفه","https://www.aldiwan.net/poem59876.html","البسيط"],[494,"ويوم كأن الدهر سامحني به","https://www.aldiwan.net/poem67368.html","الطويل"],[545,"في كل عضو منك روح تقى","https://www.aldiwan.net/poem67236.html","عموديه"],[552,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[568,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[576,"حكيت جسمي تحولاً","https://www.aldiwan.net/poem2898.html","المجتث"]],"verses":[["وكأنّ جُنْحَ اللّيْلِ أسْودُ سارِقٌ","سَرَقَ الصّباحَ الطَّلْقَ ثَوْباً أبْيَضا",0,"ض",2,1],["وَكَانَ جِسْراً لِتَلاقِي الْعُلَى","مِنْ عُدْوَتَيْهَا وَبِهَذَا سُمِي",1,"م",2,0],["وكأن جنبك بالجوى متقرّح","وكأن قلبك بالهموم رضيض",2,"ض",1,0],["وكأن جُرذان المحلة كلها","في حلقهِ يقرضن خُبزاً يابسا",3,"س",2,1],["وَكانَ جَواداً لا يَضُنُّ بِحاجَةٍ","لِذَلِكَ أَعطى روحَهُ لِلمَنِيَّةِ",4,"ه",1,0],["وَكَأَنَّ جِزيَةَ تاجِرٍ وُهِبَت لَهُ","يَوماً إِذا اِستَقبَلنَ غَيثاً مُبقِلا",5,"ل",2,0],["وَكانَ جِسماً هامِداً","حَرَّكتُهُ فَاِضطَرَبا",6,"ب",2,0],["وَكانَ جَنابُهُم فيها مَهيباً","وَلَلأَخلاقِ أَجدَرُ أَن تُهابا",7,"ب",2,0],["وَكانَ جَزائِيَ ما قَد عَلِم","تَ وَما لَم يَكُن لَكَ أَن تَفعَلَه",8,"ل",2,0],["وَكانَ جَريرٌ عَلى قَومِهِ","كَبَكرِ ثَمودٍ لَها الأَنكَدِ",9,"د",1,0],["وَكَأَنَّ جارَ بَني المُعَلّى مُشرِفٌ","مِن رَأسِ رَهوَةَ فَوقَ أُمِّ وُعولِ",10,"ل",1,0],["وكان جُودُ الكِرامِ يُنبِتُها","فصارَ مَنْعُ اللِّئامِ يُحْرِقُها",11,"ق",3,0],["وَكَأَنَّ جَمعَكَ قَد غَدا","ما بَينَهُم حِصَصاً وَكَدَّك",12,"ك",1,0],["وكان جِبْرِيلُ مرآة رأَيْتَ بِها","في الليلِ نوراً وفي المُسْتَضْعَفِ الأَيَدَا",13,"د",2,0],["وكأنّ جُرْدَ الخيل تحت حُماتها","عُقبانُ جوٍّ جُنّحٍ بِقساوِرِ",14,"ر",1,0],["وكان جُرحُكِ إلهامي مُشاركَةً","وكان يأخذُ من جُرحي ويُعطيني",15,"ن",2,0],["وكانَ جَمَّعَ أمْوالاً وَعَدَّدَها","وظَنَّهَا لِصُروفِ الدَّهْرِ تُدَّخَرُ",16,"ر",1,0],["وَكانَ جَواري الحَيِّ إِذ كُنتِ فيهِمُ","قِباحاً فَلَمّا غِبتِ صِرنَ مِلاحا",17,"ح",2,0],["وكان جَرْحُك يأسو كلَّ ما جرحَتْ","يدُ الزمان ويحيى كلَّ ما اجتاحا",18,"ح",2,0],["وكان جرحي قد أوى","على الليالي فغفر",19,"ر",1,0],["وكان جديراً أن نزور دياركم","على الرأسِ نَسْعَى لا على الإبْل نركبُ",20,"ب",1,0],["وَكَأَنَّ جاديّاً بِهِ وَأَرَندَجا","وَبِوجهِهِ سُفعٌ كَلَونِ السُّندُسِ",21,"س",1,0],["وَكأَنَّ جاحِمَ كُلِّ نارٍ أُوقِدَت","لِلحَربِ في عَينَيهِ نارُ مُهَوِّلِ",22,"ل",1,0],["وكأنّ جودَك دِيمةٌ ومديحنا","نَشْر ونحن الزَّهْر حين سقانا",23,"ن",2,0],["وكان جسماً وروحاً","يسمو بها كلُّ بَرّ",24,"ر",1,0],["وكان جوفي بالخوى مأتماً","فاليوم بيت العرس في معدتي",25,"ت",2,0],["وكان جودك في وجود أولي اللهى","عام يغيث وسبعة جارود",26,"د",1,0],["وكأنْ جنَّةُ وردٍ","خَلعت ثوباً عليها",27,"ي",3,0],["وَكانَ جَزيلاً لِلعُفاةِ عَطاؤُهُ","يَظُنّونَ جَهلاً أَنَّهُ هازِلٌ هازي",28,"ز",2,0],["وَكأَنَّ جِسمِى مِن دَمي","بِأَظافِرِى الرُّكْنُ المُخَلَّقْ",29,"ق",1,0],["وَكانَ جبريلُ روح القدسِ زائرنا","فَغابَ عنّا وكلّ الخير محتجبُ",30,"ب",1,0],["وكأن جاثمةَ الثَّغامِ بعُقرها","أشياخُ حيّ جالسين القُرفُصا",31,"ص",2,0],["وكان جباناً لسانُ السؤالِ","فأصبح وهو جريءٌ جسورُ",32,"ر",1,0],["وكأنَّ جذوةَ حدّه في مائهِ","ناري تزيد على البكاء توقدا",33,"د",2,0],["وكأنَّ جوهرها أفاض شعاعهُ","وجهُ المظفّر بينُ الأملاك",34,"ك",1,0],["وَكان جاهُكَ مَمدوداً عَلَيهِ إِذا","رَنا إِلَيهِ الأَذى غَطّاهُ رَفرَفُهُ",35,"ف",2,0],["وَكانَ جَوابي طاعَةً لا مَقالَةً","وَمَن ذا الَّذي لا يَستَجيبُ إِلى اليُسرِ",36,"ر",1,0],["وكأنَّ جِيدَكِ في استقامتِهِ","مُتَمَسِّكٌ بالعروةِ الوثقى",37,"ق",2,0],["وَكأنّ جارَهُمُ مقيمٌ بينهمْ","في منزلٍ قَفْرٍ ورسمٍ داثرِ",38,"ر",1,0],["وَكَأَنَّ جُؤْجُؤَهُ وَرِيْشَ جَنَاحِهِ","خُضِبَا بِنَقْشِ يَدِ الفَتَاةِ العَاتِقِ",39,"ق",1,0],["وكان جَفْنَكَ مُضْنىً","فصرتَ كلُّكَ جَفْنَكْ",40,"ك",1,0]]}