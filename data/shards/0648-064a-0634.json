الكامل"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[432,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[432,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[434,"فتى ربه درهمه","https://www.aldiwan.net/poem26355.html","مجزوء المتقارب"],[439,"أضاء لها فجر النهى فنهاها","https://www.aldiwan.net/poem34917.html","الطويل"],[452,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[452,"بسفح الصالحية قد نزلنا","https://www.aldiwan.net/poem13864.html","الوافر"],[453,"وقفنا لدى الشلال وقفة عابد","https://www.aldiwan.net/poem61225.html","الطويل"],[453,"إلى ابن حبيب من ثنائي أجله","https://www.aldiwan.net/poem61789.html","الطويل"],[458,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[458,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[458,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[458,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[461,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[461,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[461,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[461,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[464,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[464,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[464,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[464,"طربي إلى ماء الحمى ونزيله","https://www.aldiwan.net/poem3443.html","عموديه"],[477,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[482,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[495,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[500,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[504,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[505,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[515,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[527,"يبكي من الموت أبو طيب","https://www.aldiwan.net/poem45964.html","السريع"],[529,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[551,"أبي يعصب الغاوون ما في عيابهم","https://www.aldiwan.net/poem47883.html","الطويل"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[562,"جاء الصيام قرير العين مبتهجا","https://www.aldiwan.net/poem52754.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"بذلت وإن ضنوا وفيت وإن خانوا","https://www.aldiwan.net/poem2844.html","الطويل"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[575,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[575,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[586,"بساط يملأ الأبصار نورا","https://www.aldiwan.net/poem17526.html","الوافر"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَيَشتَقُّ القَنا الذا","بِلُ ما بَينَ الشَقيقَينِ",0,"ن",1,0],["وَيَشدو فيهِ راعِدُهُ","كَما تَشدو زَواخِرُه",1,"ر",2,0],["وَيَشهَقُ فيها بِالأَصايِلِ وَالضُحى","حَيا كُلِّ عَرّاصِ الشَآبيبِ ماطِرِ",2,"ر",1,0],["وَيَشحَبُ فيهِ عَلى أَنَّهُ","يُبَدِّلُ في كُلِّ يَومٍ صِدارا",3,"ر",2,0],["وَيَشكو وشاحاها مِنَ الخَصرِ دِقَّةً","إِلى كَفَلٍ مِلءِ الإِزارِ نَبيلِ",4,"ل",1,0],["وَيَشكُرُ حَجْلَيها السِوارانِ إِذْ حَكى","مُسَوَّرَها في الرِيِّ مِنها المُخَدَّمُ",5,"م",1,0],["وَيَشفي نَجيَّ الهَمِّ عَينانِ مِنهُما","نِجادي وَرُدني في دَمٍ خَضِلانِ",6,"ن",1,0],["وَيُشْرِقُ وَجْهي حِيْنَ يُنْسَبُ والِدي","وَتَلْقَى عليه لِلسِّيادَةِ مَيسِما",7,"م",2,0],["ويشتدُّ بي والرّححُ يلْثِمُ نَحْرَهُ","إِلى كلِّ قِرْنٍ للأسنّةِ كارِهِ",8,"ر",2,0],["ويَشُبُّ ناراً لا يَرُدُّ زَفيرُها","والليلُ مُعْتَكِرٌ طَنينَ فَراشِ",9,"ش",1,0],["وَيَشكو السَيفُ مِن كَفّي مَلال","وَيَسأَمُ عاتِقي حَملَ النِجادِ",10,"د",1,0],["وَيَشرَبنَ مِن بارِدٍ قَد عَلِم","أَن لا دِخالَ وَأَن لا عُطونا",11,"ن",2,0],["وَيَشُقُّ أَجوازَ القِفارِ مُغامِراً","وَعرُ الطَريقِ لَدَيهِ كَالصَحصاحِ",12,"ح",1,0],["وَيَشأو رُقى هوجو وَيَأتي نَسيبُهُ","لَنا مِن لَيالي أَلفَريدَ بِأَربَعِ",13,"ع",1,0],["وَيَشرَبنَ أَجناً وَالنُجومُ كَأَنَّها","مَصابيحُ دَحّالٍ يُذَكّي ذُبالَها",14,"ه",2,1],["وَيَشَبَحُ بِالكَفَّينِ شَبَحاً كَأَنَّهُ","أَخو فُجرَةٍ عالى بِهِ الجِذعَ صالِبُه",15,"ب",2,0],["ويشجُعَ رعديد ويعتزّ صاغر","وينشطَ للسعي الحثيث كسول",16,"ل",1,0],["وَيُشفينَ مَن يَغتالُنا بِعَداوَةٍ","وَيُسعِدنَ في الدُنيا بِنا مَن نُساعِدُ",17,"د",1,0],["وَيَشهَدوا أَنَّ ما قالَ الرَسولُ لَهُم","حَقٌّ وَيوفوا بِعَهدِ الواحِدِ الأَحَدِ",18,"د",1,0],["ويشوقني مغنى الوصالِ فكلَّما","ذُكر العقيقُ بكيتهُ بدمائي",19,"ا",2,0],["ويشيم ما سنى أبوه من العلا","لا قاصراً عنه ولا متبلدا",20,"د",2,0],["ويشتاقُ أبناؤه والبنات","وصاحبة البيت بيت القصيد",21,"د",1,0],["ويشبع الأمر آراءً مسددة","تمضي وتدفع صدر الحادث الشكس",22,"س",1,0],["ويُشمُّني تُفَّاحهُ أو وَرْدَهُ","ذاك الجَنِيُّ ووردُه تفاحهُ",23,"ح",2,0],["ويشهدُ أنْ سَتَسْمُو للمعالي","فتبلُغَها فما كذب الشَّهِيدُ",24,"د",1,0],["ويشمخ المعتفي عليه إذا","لاقى بخيلاً وخده ضرِع",25,"ع",1,0],["ويشوقه برق السحاب وإنما","يعنى ببرق المبسم البرّاق",26,"ق",1,0],["ويشفق منها في بقية عمرهِ","أمنتَ وأنفُ الدهر أجدعُ أكثمُ",27,"م",1,0],["ويشفي غليلَ استِه بالمَنيِّ","ورُب شِفاء بماءٍ مَهين",28,"ن",1,0],["وَيَشُدُّ هَذا ذاكَ مِن أَزرارِهِ","فَيَشُدُّني ذَيّاكَ مِن أَزراري",29,"ر",2,0],["وَيَشقى مَوطِني وَأَنامُ عَنهُ","إِذاً مَن يَدفَعُ الخَطَرَ الجُساما",30,"م",2,0],["وَيَشرَبُ اللَذاتِ مِن كَأسِهِ","وَأَشرَبُ الغَصّاتِ مِن كَأسي",31,"ي",1,0],["وَيُشرِقُ وَجهُ الأَرضِ حينَ تَحُلُّها","كَأَنَّكَ تَوحيدٌ حَوَتهُ وَإيمانُ",32,"ن",1,0],["وَيَشتَهي لَو أَنَّهُ","يَملِكُ مِنها شَعَرَه",33,"ر",2,0],["وَيَشوقُني وَجهُ النَهارِ مُلَثَّماً","وَيَروقُني خَدُّ الأَصيلِ مَوَرَّدا",34,"د",2,0],["وَيَشوقُني الوادي إِذا","ناجى النَسيمَ الرَطبَ شيحُه",35,"ح",2,0],["وَيَشوقُني زَمَنُ الكَثي","بِ وَقَد مَضى زَمَنُ الكَثيبِ",36,"ب",1,0],["ويشيِّدونَ من الرِّمالِ البيضِ","والحَصَبِ النضيرْ",37,"ر",1,0],["ويشعل النار التي","في اول الحرب تشب",38,"ب",1,0],["ويشهد الله ما أتيتم","إلا هدى الرأى والدهاء",39,"ا",2,0],["ويشق صفحة خده","ندما ولات زمان مندم",40,"م",1,0],["ويشتهى الدولة العليا معززة","من الوئام بأنصار وأعوان",41,"ن",1,0],["وَيُشيدُ العِزَّ بِأَيدينا","وَطَنٌ نَفديهِ وَيَفدينا",42,"ا",1,0],["وَيُشيرُ في الثاني بِأَن","تُعطى رِياضاً في تِهامَه",43,"م",2,0],["وَيُشيرُ بِالرَأسِ المُكَلَّلِ نَحوَها","شَيخٌ وَبِاللَحظِ البَريءِ بَتولُ",44,"ل",1,0],["وَيُشاطِرُ الأَقرانَ ذُخرَ سِلاحِهِ","وَيَصُفُّ حَولَ خِوانِهِ الأَعداءَ",45,"ا",2,0],["وَيُشَكُّ فيهِ فَلا يُكَلِّفُ نَفسَهُ","غَيرَ التَرَفُّعِ وَالوَقارِ نِضالا",46,"ل",2,0],["وَيُشيرُ مُتَّبِعُ الرِجالِ إِلى","قَمَرٍ كَثيرٍ مِنهُمُ تَبَعُه",47,"ع",2,0],["ويَشربُ الرَّاحَ به شاربٌ","مُرتَفِق بالتاجِ مَعْصوبُ",48,"ب",1,0],["وَيَشرَبُها بِالكَيفِ وَالأَينِ وَالمَتى","وَيَعرِفُها بِالجِنسِ وَالنَوعِ وَالفَصلِ",49,"ل",1,0],["وَيَشفي عِندَ أَخذِ الثَأرِ مِنهُم","نُفوساً لَيسَ تَقنَعُ بِالمَطالِ",50,"ل",1,0],["ويشِبُّ نيرانَ الحُروب بمرهفٍ","كصبيب ماءٍ في الجماجِم غائِرِ",51,"ر",1,0],["وَيُشرِقُ بَطنُ مَكَّةَ حينَ نُضحي","بِهِ وَمُناخُ واجِبَةِ الجَنوبِ",52,"ب",1,0],["وَيَشتاقُ عانيها مِنَ الأَمنِ نَهلَةً","وَ