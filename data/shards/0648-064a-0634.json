{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[63,"نظرت وكم من نظرة تلد الردى","https://www.aldiwan.net/poem45788.html","الطويل"],[63,"سقى الله ليل الخيف دمعي أو الحيا","https://www.aldiwan.net/poem45811.html","الطويل"],[63,"لحاني هذيم صاحبي ليلة النقا","https://www.aldiwan.net/poem45812.html","الطويل"],[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[63,"ألا بأبي من حيل دون مزاره","https://www.aldiwan.net/poem46137.html","الطويل"],[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[3,"إذا جحد الجميل بنو قراد","https://www.aldiwan.net/poem140.html",""],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[30,"ويشربن أجنا والنجوم كأنها","https://www.aldiwan.net/poem29451.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"هو الليل يغريه الأسى فيطول","https://www.aldiwan.net/poem44837.html","الطويل"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"أهواه فتان اللواحظ أغيدا","https://www.aldiwan.net/poem18548.html","الكامل"],[72,"حيت سفرتي من نداك المديد","https://www.aldiwan.net/poem18566.html","المتقارب"],[72,"أهلا بطيف على الجرعاء مختلس","https://www.aldiwan.net/poem19016.html","البسيط"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"وشيخ يبيت غلام له","https://www.aldiwan.net/poem66537.html","المتقارب"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"وأحمق ذي لحية","https://www.aldiwan.net/poem42875.html","مجزوء الرجز"],[70,"جعل الرقاد لكي يواصل موعدا","https://www.aldiwan.net/poem42964.html","الكامل"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[70,"رحل الشباب ولم أنل","https://www.aldiwan.net/poem43017.html","مجزوء الكامل"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[85,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[85,"اليوم ينتحر المقطم","https://www.aldiwan.net/poem7276.html","مجزوء الكامل"],[85,"الله في الخلق من صب ومن عانى","https://www.aldiwan.net/poem7881.html","البسيط"],[85,"اليوم نسود بوادينا","https://www.aldiwan.net/poem7914.html","المتدارك"],[85,"كان ابن داود يقر","https://www.aldiwan.net/poem8016.html","مجزوء الكامل"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[45,"يزداد في غي الصبا ولعه","https://www.aldiwan.net/poem64662.html","الكامل"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[66,"طلبت نديما يوجد الراح راحة","https://www.aldiwan.net/poem39206.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[80,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[31,"ألم تربع على الطلل المريب","https://www.aldiwan.net/poem42657.html","الوافر"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"عهد لمصر من الحياة جديد","https://www.aldiwan.net/poem43166.html","الكامل"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[81,"يخف بشرا إذا انهلت أنامله","https://www.aldiwan.net/poem61495.html","البسيط"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[52,"هاتيك دارهم فعرج واسأل","https://www.aldiwan.net/poem26755.html","الكامل"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[50,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[50,"ألا ما لقلبي لا يزول عن الهوى","https://www.aldiwan.net/poem64833.html","الطويل"],[46,"أخو الراح إن قال قولا وجدت","https://www.aldiwan.net/poem22185.html","المتقارب"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"إذا ابنا أب واحد ألفيا","https://www.aldiwan.net/poem22362.html","المتقارب"],[46,"إذا ودك الإنسان يوما لخلة","https://www.aldiwan.net/poem22609.html","الطويل"],[46,"أرقت فهل نجم الدجنة آرق","https://www.aldiwan.net/poem23015.html","الطويل"],[46,"النفس إن لم تذق موتا مشارفة","https://www.aldiwan.net/poem23379.html","البسيط"],[1,"يا عجبا من عبد عمرو وبغيه","https://www.aldiwan.net/poem34012.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9908","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42713","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199472","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50270","الطويل"],[104,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[46,"إذا ابْنا أبٍ واحدٍ أُلِفيا","https://www.poetsgate.com/ViewPoem.aspx?id=18053",""],[24,"أمِنْ دِمْنة ِ الدَّارِ أَقْوَتْ سِنِينَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10886&r=&rc=27",""],[3,"إذا جحدَ الجميلَ بنو قرادٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10672&r=&rc=26",""]],"verses":[["وَيَشتَقُّ القَنا الذا","بِلُ ما بَينَ الشَقيقَينِ",0,"ن",1,0],["وَيَشدو فيهِ راعِدُهُ","كَما تَشدو زَواخِرُه",1,"ر",2,0],["وَيَشهَقُ فيها بِالأَصايِلِ وَالضُحى","حَيا كُلِّ عَرّاصِ الشَآبيبِ ماطِرِ",2,"ر",1,0],["وَيَشحَبُ فيهِ عَلى أَنَّهُ","يُبَدِّلُ في كُلِّ يَومٍ صِدارا",3,"ر",2,0],["وَيَشكو وشاحاها مِنَ الخَصرِ دِقَّةً","إِلى كَفَلٍ مِلءِ الإِزارِ نَبيلِ",4,"ل",1,0],["وَيَشكُرُ حَجْلَيها السِوارانِ إِذْ حَكى","مُسَوَّرَها في الرِيِّ مِنها المُخَدَّمُ",5,"م",1,0],["وَيَشفي نَجيَّ الهَمِّ عَينانِ مِنهُما","نِجادي وَرُدني في دَمٍ خَضِلانِ",6,"ن",1,0],["وَيُشْرِقُ وَجْهي حِيْنَ يُنْسَبُ والِدي","وَتَلْقَى عليه لِلسِّيادَةِ مَيسِما",7,"م",2,0],["ويشتدُّ بي والرّححُ يلْثِمُ نَحْرَهُ","إِلى كلِّ قِرْنٍ للأسنّةِ كارِهِ",8,"ر",2,0],["ويَشُبُّ ناراً لا يَرُدُّ زَفيرُها","والليلُ مُعْتَكِرٌ طَنينَ فَراشِ",9,"ش",1,0],["وَيَشكو السَيفُ مِن كَفّي مَلال","وَيَسأَمُ عاتِقي حَملَ النِجادِ",10,"د",1,0],["وَيَشرَبنَ مِن بارِدٍ قَد عَلِم","أَن لا دِخالَ وَأَن لا عُطونا",11,"ن",2,0],["وَيَشُقُّ أَجوازَ القِفارِ مُغامِراً","وَعرُ الطَريقِ لَدَيهِ كَالصَحصاحِ",12,"ح",1,0],["وَيَشأو رُقى هوجو وَيَأتي نَسيبُهُ","لَنا مِن لَيالي أَلفَريدَ بِأَربَعِ",13,"ع",1,0],["وَيَشرَبنَ أَجناً وَالنُجومُ كَأَنَّها","مَصابيحُ دَحّالٍ يُذَكّي ذُبالَها",14,"ه",2,1],["وَيَشَبَحُ بِالكَفَّينِ شَبَحاً كَأَنَّهُ","أَخو فُجرَةٍ عالى بِهِ الجِذعَ صالِبُه",15,"ب",2,0],["ويشجُعَ رعديد ويعتزّ صاغر","وينشطَ للسعي الحثيث كسول",16,"ل",1,0],["وَيُشفينَ مَن يَغتالُنا بِعَداوَةٍ","وَيُسعِدنَ في الدُنيا بِنا مَن نُساعِدُ",17,"د",1,0],["وَيَشهَدوا أَنَّ ما قالَ الرَسولُ لَهُم","حَقٌّ وَيوفوا بِعَهدِ الواحِدِ الأَحَدِ",18,"د",1,0],["ويشوقني مغنى الوصالِ فكلَّما","ذُكر العقيقُ بكيتهُ بدمائي",19,"ا",2,0],["ويشيم ما سنى أبوه من العلا","لا قاصراً عنه ولا متبلدا",20,"د",2,0],["ويشتاقُ أبناؤه والبنات","وصاحبة البيت بيت القصيد",21,"د",1,0],["ويشبع الأمر آراءً مسددة","تمضي وتدفع صدر الحادث الشكس",22,"س",1,0],["ويُشمُّني تُفَّاحهُ أو وَرْدَهُ","ذاك الجَنِيُّ ووردُه تفاحهُ",23,"ح",2,0],["ويشهدُ أنْ سَتَسْمُو للمعالي","فتبلُغَها فما كذب الشَّهِيدُ",24,"د",1,0],["ويشمخ المعتفي عليه إذا","لاقى بخيلاً وخده ضرِع",25,"ع",1,0],["ويشوقه برق السحاب وإنما","يعنى ببرق المبسم البرّاق",26,"ق",1,0],["ويشفق منها في بقية عمرهِ","أمنتَ وأنفُ الدهر أجدعُ أكثمُ",27,"م",1,0],["ويشفي غليلَ استِه بالمَنيِّ","ورُب شِفاء بماءٍ مَهين",28,"ن",1,0],["وَيَشُدُّ هَذا ذاكَ مِن أَزرارِهِ","فَيَشُدُّني ذَيّاكَ مِن أَزراري",29,"ر",2,0],["وَيَشقى مَوطِني وَأَنامُ عَنهُ","إِذاً مَن يَدفَعُ الخَطَرَ الجُساما",30,"م",2,0],["وَيَشرَبُ اللَذاتِ مِن كَأسِهِ","وَأَشرَبُ الغَصّاتِ مِن كَأسي",31,"ي",1,0],["وَيُشرِقُ وَجهُ الأَرضِ حينَ تَحُلُّها","كَأَنَّكَ تَوحيدٌ حَوَتهُ وَإيمانُ",32,"ن",1,0],["وَيَشتَهي لَو أَنَّهُ","يَملِكُ مِنها شَعَرَه",33,"ر",2,0],["وَيَشوقُني وَجهُ النَهارِ مُلَثَّماً","وَيَروقُني خَدُّ الأَصيلِ مَوَرَّدا",34,"د",2,0],["وَيَشوقُني الوادي إِذا","ناجى النَسيمَ الرَطبَ شيحُه",35,"ح",2,0],["وَيَشوقُني زَمَنُ الكَثي","بِ وَقَد مَضى زَمَنُ الكَثيبِ",36,"ب",1,0],["ويشيِّدونَ من الرِّمالِ البيضِ","والحَصَبِ النضيرْ",37,"ر",1,0],["ويشعل النار التي","في اول الحرب تشب",38,"ب",1,0],["ويشهد الله ما أتيتم","إلا هدى الرأى والدهاء",39,"ا",2,0],["ويشق صفحة خده","ندما ولات زمان مندم",40,"م",1,0],["ويشتهى الدولة العليا معززة","من الوئام بأنصار وأعوان",41,"ن",1,0],["وَيُشيدُ العِزَّ بِأَيدينا","وَطَنٌ نَفديهِ وَيَفدينا",42,"ا",1,0],["وَيُشيرُ في الثاني بِأَن","تُعطى رِياضاً في تِهامَه",43,"م",2,0],["وَيُشيرُ بِالرَأسِ المُكَلَّلِ نَحوَها","شَيخٌ وَبِاللَحظِ البَريءِ بَتولُ",44,"ل",1,0],["وَيُشاطِرُ الأَقرانَ ذُخرَ سِلاحِهِ","وَيَصُفُّ حَولَ خِوانِهِ الأَعداءَ",45,"ا",2,0],["وَيُشَكُّ فيهِ فَلا يُكَلِّفُ نَفسَهُ","غَيرَ التَرَفُّعِ وَالوَقارِ نِضالا",46,"ل",2,0],["وَيُشيرُ مُتَّبِعُ الرِجالِ إِلى","قَمَرٍ كَثيرٍ مِنهُمُ تَبَعُه",47,"ع",2,0],["ويَشربُ الرَّاحَ به شاربٌ","مُرتَفِق بالتاجِ مَعْصوبُ",48,"ب",1,0],["وَيَشرَبُها بِالكَيفِ وَالأَينِ وَالمَتى","وَيَعرِفُها بِالجِنسِ وَالنَوعِ وَالفَصلِ",49,"ل",1,0],["وَيَشفي عِندَ أَخذِ الثَأرِ مِنهُم","نُفوساً لَيسَ تَقنَعُ بِالمَطالِ",50,"ل",1,0],["ويشِبُّ نيرانَ الحُروب بمرهفٍ","كصبيب ماءٍ في الجماجِم غائِرِ",51,"ر",1,0],["وَيُشرِقُ بَطنُ مَكَّةَ حينَ نُضحي","بِهِ وَمُناخُ واجِبَةِ الجَنوبِ",52,"ب",1,0],["وَيَشتاقُ عانيها مِنَ الأَمنِ نَهلَةً","وَلَو أَنَّ أَطرافَ الأَسِنَّةِ مَورِدُ",53,"د",1,0],["وَيَشُقُّ مُصطَفَقَ العُبابِ إِذا طَغى","يَرمي عُبابَ الشَرِّ وَالطُغيانِ",54,"ن",1,0],["وَيُشَيِّعُ الأَهرامَ يَومَ يُصيبُها","أَجَلُ الدُهورِ وَأَهلَها فَتَميدُ",55,"د",1,0],["ويَشتَهِي نَيلَهُ مُثرٍ وَذُو عَدَمٍ","كَالرَّاحِ تَحسُنُ للِصَّاحِي وَللِثَّمِلِ",56,"ل",1,0],["وَيَشتَهي جودَكُم مُثرٍ وَذو عَدَمٍ","كَالخَمرِ يَعشَقُها صاحٍ وَنَشوانُ",57,"ن",1,0],["وَيَشتَهي نَيلَهُ مُثرٍ وَذو عَدَمٍ","كَالراحِ تَصلُحُ لِلصاحي وَلِلثَمِلِ",58,"ل",1,0],["وَيَشكُرُ كانَ مَنزِلُها قَديماً","بِمَنزِلَةِ الأَذِلّاءِ الضِعافِ",59,"ف",1,0],["وَيَشكُرُ لا أَخو كَرَمٍ فَيُخثى","وَلا مُتَحَفِّلٌ بِالجارِ وافي",59,"ي",1,0],["وَيَشُدُّ حاديها بِحَبلٍ كامِلٍ","كَعَسيبِ نَخلٍ خوصُهُ لَم يَنجَلِ",60,"ل",1,0],["وَيَشُوقَ الأَضْيَافَ في بادَهَنْجٍ","مِنْ بعيدٍ قُرُونُهُ كالمَنَارَهْ",61,"ر",2,0],["ويَشفي مشوقاً منكَ بالقُربِ لوعَةً","وبَرْحَ غليلٍ في الجوانحِ يُقْلِقُه",62,"ق",2,0],["وَيَشُكُّ فيها الناظِرونَ إِذا مَشَت","أَتسيلُ أَم تَمشي لَهُم تَأويدا",63,"د",2,0],["وَيَشوقُني بَيتُ الحَبي","بِ إِذا غَدَوتُ وَأَينَ بَيتُه",64,"ت",2,0],["وَيَشكُرُ خِصيانٌ عَلَيهِم غَضارَةٌ","وَهَل يُدرِكُ المَجدَ الخَصِيُّ المُجَبَّبُ",65,"ب",1,0],["وَيَشكُرُ خِصيانٌ عَلَيهِم غَضارَةٌ","وَهَل يُدرِكُ المَجدَ الخَصِيُّ المُحَجَّبُ",66,"ب",1,0],["وَيَشرَبُ مِنها إِلى أَن يَقيءَ","وَلا غَروَ إِن قُلتَ حَتّى يَموتا",67,"ت",2,0],["وَيَشرَبُها فَيَقلِسُها غَويٌّ","لَقَد شامَ الخَفِيَّ مِنَ الشِماتِ",68,"ت",1,0],["وَيَشجُبُ كُلُّ اِمرِئٍ في الزَمانِ","مِن آلِ عَدنانَ أَو يَشجُبِ",69,"ب",1,0],["وَيُشرَبُ ماءُ المُزنِ ما دامَ صافِياً","وَيَزهَدُ فيهِ وارِدٌ إِن تَعَكَّرا",70,"ر",2,0],["وَيُشبِهُ كَعباً إِذ بَكى وَمُتَمِّماً","لَدى كُلِّ عَقلٍ مَعبَدٌ وَمُخارِقُ",71,"ق",1,0],["وَيَشتَهي الناسُ ما لا يُسعَفونَ بِهِ","وَشِركَةُ الخَلقِ دونَ الحَملِ في الوَحَمِ",72,"م",1,0],["وَيَشرَبُ حَتّى يَغمُرَ المَحضُ قَلبَهُ","وَإِن أُعطَهُ أَترُك لِقَلبِيَ مَجثَما",73,"م",2,0],["وَيشملني أبناؤُها برعاية","أَرى أَنَّني قد لا أَرى مثلها بعد",74,"د",1,0],["وَيَشكو السَيفُ مِن كَفّي مَلالاً","وَيَسأَمُ عاتِقي حَملَ النِجادِ",75,"د",1,0],["وَيَشْدُو بِهَا الْقُمْرِيُّ حَتَّى كَأَنَّهُ","أَخُو صَبْوَةٍ أَوْ دَبَّ فِيهِ رَحِيقُ",76,"ق",1,0],["وَيَشْهَدُ ذَا الرَّوضِ الأَرِيضُ وَدوْحُهُ","وَمَا فِيهِ مِنْ زَهْرٍ وعِطْرٍ مُضَوَّعِ",77,"ع",1,0],["ويشكو فقرهُ قبوي","ويشكو محلهُ حقلي",78,"ي",1,0],["ويشتكي النجود للحزون","وجرب الغربة في السفين",79,"ن",1,0],["ويشدو في مسامعكِ الأغاني","بلحنٍ علَّم السجعَ الحَماما",80,"م",2,0],["ويشهدُ الحقُّ أنّ الحقَّ في يدهِ","سيفٌ يروُعُ المنايا غيرُ مغمود",81,"د",1,0],["ويُشعِلُ في القلوبِ وميضَ نارٍ","كنيرانِ الكليمِ هدىً ورشدا",82,"د",2,0],["ويشدو بالمروءة إن تراءت","وبالصنع الجميل إذا تبدّى",82,"د",2,0],["وَيَشْرَكُني في نَشرِهِ الريحُ غُدوةً","فتجري إلى الآفاقِ طَيِّبَةَ النشرِ",83,"ر",1,0],["ويشمت بي حتّى على الموت طغمةٌ","غدت في زمان المكر أسطورة المكرِ",84,"ر",1,0],["ويشمُّون كالكلاب ممرّي","ولهم مثلُها فضولٌ سليقي",85,"ق",2,0],["ويشجُبُ كلُّ امرىءٍ، في الزمانِ،","منْ آلِ عدْنانَ، أو يشجُب",86,"ب",1,0],["ويَشْرَبْنَ من بارِدٍ قَدْ عَلِمْ","نَ أن لا دِخَالَ وأن لا عُطُونَا",87,"ن",2,0],["ويشكوا السيفُ منْ كفي ملالاً","ويسأمُ عاتقي حملَ النجادِ",88,"د",1,0]]}