],[451,"إلى ابن حبيب من ثنائي أجله","https://www.aldiwan.net/poem61789.html","الطويل"],[456,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[456,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[456,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[456,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[459,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[459,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[459,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[459,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[462,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[462,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[462,"طربي إلى ماء الحمى ونزيله","https://www.aldiwan.net/poem3443.html","عموديه"],[475,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[480,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[493,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[498,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[502,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[503,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[512,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[512,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[513,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[525,"يبكي من الموت أبو طيب","https://www.aldiwan.net/poem45964.html","السريع"],[527,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[527,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[549,"أبي يعصب الغاوون ما في عيابهم","https://www.aldiwan.net/poem47883.html","الطويل"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[560,"جاء الصيام قرير العين مبتهجا","https://www.aldiwan.net/poem52754.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"بذلت وإن ضنوا وفيت وإن خانوا","https://www.aldiwan.net/poem2844.html","الطويل"],[573,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[573,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[584,"بساط يملأ الأبصار نورا","https://www.aldiwan.net/poem17526.html","الوافر"],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَيَشتَقُّ القَنا الذا","بِلُ ما بَينَ الشَقيقَينِ",0,"ن",1,0],["وَيَشدو فيهِ راعِدُهُ","كَما تَشدو زَواخِرُه",1,"ر",2,0],["وَيَشهَقُ فيها بِالأَصايِلِ وَالضُحى","حَيا كُلِّ عَرّاصِ الشَآبيبِ ماطِرِ",2,"ر",1,0],["وَيَشحَبُ فيهِ عَلى أَنَّهُ","يُبَدِّلُ في كُلِّ يَومٍ صِدارا",3,"ر",2,0],["وَيَشكو وشاحاها مِنَ الخَصرِ دِقَّةً","إِلى كَفَلٍ مِلءِ الإِزارِ نَبيلِ",4,"ل",1,0],["وَيَشكُرُ حَجْلَيها السِوارانِ إِذْ حَكى","مُسَوَّرَها في الرِيِّ مِنها المُخَدَّمُ",5,"م",1,0],["وَيَشفي نَجيَّ الهَمِّ عَينانِ مِنهُما","نِجادي وَرُدني في دَمٍ خَضِلانِ",6,"ن",1,0],["وَيُشْرِقُ وَجْهي حِيْنَ يُنْسَبُ والِدي","وَتَلْقَى عليه لِلسِّيادَةِ مَيسِما",7,"م",2,0],["ويشتدُّ بي والرّححُ يلْثِمُ نَحْرَهُ","إِلى كلِّ قِرْنٍ للأسنّةِ كارِهِ",8,"ر",2,0],["ويَشُبُّ ناراً لا يَرُدُّ زَفيرُها","والليلُ مُعْتَكِرٌ طَنينَ فَراشِ",9,"ش",1,0],["وَيَشكو السَيفُ مِن كَفّي مَلال","وَيَسأَمُ عاتِقي حَملَ النِجادِ",10,"د",1,0],["وَيَشرَبنَ مِن بارِدٍ قَد عَلِم","أَن لا دِخالَ وَأَن لا عُطونا",11,"ن",2,0],["وَيَشُقُّ أَجوازَ القِفارِ مُغامِراً","وَعرُ الطَريقِ لَدَيهِ كَالصَحصاحِ",12,"ح",1,0],["وَيَشأو رُقى هوجو وَيَأتي نَسيبُهُ","لَنا مِن لَيالي أَلفَريدَ بِأَربَعِ",13,"ع",1,0],["وَيَشرَبنَ أَجناً وَالنُجومُ كَأَنَّها","مَصابيحُ دَحّالٍ يُذَكّي ذُبالَها",14,"ه",2,1],["وَيَشَبَحُ بِالكَفَّينِ شَبَحاً كَأَنَّهُ","أَخو فُجرَةٍ عالى بِهِ الجِذعَ صالِبُه",15,"ب",2,0],["ويشجُعَ رعديد ويعتزّ صاغر","وينشطَ للسعي الحثيث كسول",16,"ل",1,0],["وَيُشفينَ مَن يَغتالُنا بِعَداوَةٍ","وَيُسعِدنَ في الدُنيا بِنا مَن نُساعِدُ",17,"د",1,0],["وَيَشهَدوا أَنَّ ما قالَ الرَسولُ لَهُم","حَقٌّ وَيوفوا بِعَهدِ الواحِدِ الأَحَدِ",18,"د",1,0],["ويشوقني مغنى الوصالِ فكلَّما","ذُكر العقيقُ بكيتهُ بدمائي",19,"ا",2,0],["ويشيم ما سنى أبوه من العلا","لا قاصراً عنه ولا متبلدا",20,"د",2,0],["ويشتاقُ أبناؤه والبنات","وصاحبة البيت بيت القصيد",21,"د",1,0],["ويشبع الأمر آراءً مسددة","تمضي وتدفع صدر الحادث الشكس",22,"س",1,0],["ويُشمُّني تُفَّاحهُ أو وَرْدَهُ","ذاك الجَنِيُّ ووردُه تفاحهُ",23,"ح",2,0],["ويشهدُ أنْ سَتَسْمُو للمعالي","فتبلُغَها فما كذب الشَّهِيدُ",24,"د",1,0],["ويشمخ المعتفي عليه إذا","لاقى بخيلاً وخده ضرِع",25,"ع",1,0],["ويشوقه برق السحاب وإنما","يعنى ببرق المبسم البرّاق",26,"ق",1,0],["ويشفق منها في بقية عمرهِ","أمنتَ وأنفُ الدهر أجدعُ أكثمُ",27,"م",1,0],["ويشفي غليلَ استِه بالمَنيِّ","ورُب شِفاء بماءٍ مَهين",28,"ن",1,0],["وَيَشُدُّ هَذا ذاكَ مِن أَزرارِهِ","فَيَشُدُّني ذَيّاكَ مِن أَزراري",29,"ر",2,0],["وَيَشقى مَوطِني وَأَنامُ عَنهُ","إِذاً مَن يَدفَعُ الخَطَرَ الجُساما",30,"م",2,0],["وَيَشرَبُ اللَذاتِ مِن كَأسِهِ","وَأَشرَبُ الغَصّاتِ مِن كَأسي",31,"ي",1,0],["وَيُشرِقُ وَجهُ الأَرضِ حينَ تَحُلُّها","كَأَنَّكَ تَوحيدٌ حَوَتهُ وَإيمانُ",32,"ن",1,0],["وَيَشتَهي لَو أَنَّهُ","يَملِكُ مِنها شَعَرَه",33,"ر",2,0],["وَيَشوقُني وَجهُ النَهارِ مُلَثَّماً","وَيَروقُني خَدُّ الأَصيلِ مَوَرَّدا",34,"د",2,0],["وَيَشوقُني الوادي إِذا","ناجى النَسيمَ الرَطبَ شيحُه",35,"ح",2,0],["وَيَشوقُني زَمَنُ الكَثي","بِ وَقَد مَضى زَمَنُ الكَثيبِ",36,"ب",1,0],["ويشيِّدونَ من الرِّمالِ البيضِ","والحَصَبِ النضيرْ",37,"ر",1,0],["ويشعل النار التي","في اول الحرب تشب",38,"ب",1,0],["ويشهد الله ما أتيتم","إلا هدى الرأى والدهاء",39,"ا",2,0],["ويشق صفحة خده","ندما ولات زمان مندم",40,"م",1,0],["ويشتهى الدولة العليا معززة","من الوئام بأنصار وأعوان",41,"ن",1,0],["وَيُشيدُ العِزَّ بِأَيدينا","وَطَنٌ نَفديهِ وَيَفدينا",42,"ا",1,0],["وَيُشيرُ في الثاني بِأَن","تُعطى رِياضاً في تِهامَه",43,"م",2,0],["وَيُشيرُ بِالرَأسِ المُكَلَّلِ نَحوَها","شَيخٌ وَبِاللَحظِ البَريءِ بَتولُ",44,"ل",1,0],["وَيُشاطِرُ الأَقرانَ ذُخرَ سِلاحِهِ","وَيَصُفُّ حَولَ خِوانِهِ الأَعداءَ",45,"ا",2,0],["وَيُشَكُّ فيهِ فَلا يُكَلِّفُ نَفسَهُ","غَيرَ التَرَفُّعِ وَالوَقارِ نِضالا",46,"ل",2,0],["وَيُشيرُ مُتَّبِعُ الرِجالِ إِلى","قَمَرٍ كَثيرٍ مِنهُمُ تَبَعُه",47,"ع",2,0],["ويَشربُ الرَّاحَ به شاربٌ","مُرتَفِق بالتاجِ مَعْصوبُ",48,"ب",1,0],["وَيَشرَبُها بِالكَيفِ وَالأَينِ وَالمَتى","وَيَعرِفُها بِالجِنسِ وَالنَوعِ وَالفَصلِ",49,"ل",1,0],["وَيَشفي عِندَ أَخذِ الثَأرِ مِنهُم","نُفوساً لَيسَ تَقنَعُ بِالمَطالِ",50,"ل",1,0],["ويشِبُّ نيرانَ الحُروب بمرهفٍ","كصبيب ماءٍ في الجماجِم غائِرِ",51,"ر",1,0],["وَيُشرِقُ بَطنُ مَكَّةَ حينَ نُضحي","بِهِ وَمُناخُ واجِبَةِ الجَنوبِ",52,"ب",1,0],["وَيَشتاقُ عانيها مِنَ الأَمنِ نَهلَةً","وَلَو أَنَّ أَطرافَ الأَسِنَّةِ مَورِدُ",53,"د",1,0],["وَيَشُقُّ مُصطَفَقَ العُبابِ إِذا طَغى","يَرمي عُبابَ الشَرِّ وَالطُغيانِ",54,"ن",1,0],["وَيُشَيِّعُ الأَهرامَ يَومَ يُصيبُها","أَجَلُ الدُهورِ وَأَهلَها فَتَميدُ",55,"د",1,0],["ويَشتَهِي نَيلَهُ مُثرٍ وَذُو عَدَمٍ","كَالرَّاحِ تَحسُنُ للِصَّاحِي وَللِثَّمِلِ",56,"ل",1,0],["وَيَشتَهي جودَكُم مُثرٍ وَذو عَدَمٍ","كَالخَمرِ يَعشَقُها صاحٍ وَنَشوانُ",57,"ن",1,0],["وَيَشتَهي نَيلَهُ مُثرٍ وَذو عَدَمٍ","كَالراحِ تَصلُحُ لِلصاحي وَلِلثَمِلِ",58,"ل",1,0],["وَيَشكُرُ كانَ مَنزِلُها قَديماً","بِمَنزِلَةِ الأَذِلّاءِ الضِعافِ",59,"ف",1,0],["وَيَشكُرُ لا أَخو كَرَمٍ فَيُخثى","وَلا مُتَحَفِّلٌ بِالجارِ وافي",59,"ي",1,0],["وَيَشُدُّ حاديها بِحَبلٍ كامِلٍ","كَعَسيبِ نَخلٍ خوصُهُ لَم يَنجَلِ",60,"ل",1,0],["وَيَشُوقَ الأَضْيَافَ في بادَهَنْجٍ","مِنْ بعيدٍ قُرُونُهُ كالمَنَارَهْ",61,"ر",2,0],["ويَشفي مشوقاً منكَ بالقُربِ لوعَةً","وبَرْحَ غليلٍ في الجوانحِ يُقْلِقُه",62,"ق",2,0],["وَيَشُكُّ فيها الناظِرونَ إِذا مَشَت","أَتسيلُ أَم تَمشي لَهُم تَأويدا",63,"د",2,0],["وَيَشوقُني بَيتُ الحَبي","بِ إِذا غَدَوتُ وَأَينَ بَيتُه",64,"ت",2,0],["وَيَشكُرُ خِصيانٌ عَلَيهِم غَضارَةٌ","وَهَل يُدرِكُ المَجدَ الخَصِيُّ المُجَبَّبُ",65,"ب",1,0],["وَيَشكُرُ خِصيانٌ عَلَيهِم غَضارَةٌ","وَهَل يُدرِكُ المَجدَ الخَصِيُّ المُحَجَّبُ",66,"ب",1,0],["وَيَشرَبُ مِنها إِلى أَن يَقيءَ","وَلا غَروَ إِن قُلتَ حَتّى يَموتا",67,"ت",2,0],["وَيَشرَبُها فَيَقلِسُها غَويٌّ","لَقَد شامَ الخَفِيَّ مِنَ الشِماتِ",68,"ت",1,0],["وَيَشجُبُ كُلُّ اِمرِئٍ في الزَمانِ","مِن آلِ عَدنانَ أَو يَشجُبِ",69,"ب",1,0],["وَيُشرَبُ ماءُ المُزنِ ما دامَ صافِياً","وَيَزهَدُ فيهِ وارِدٌ إِن تَعَكَّرا",70,"ر",2,0],["وَيُشبِهُ كَعباً إِذ بَكى وَمُتَمِّماً","لَدى كُلِّ عَقلٍ مَعبَدٌ وَمُخارِقُ",71,"ق",1,0],["وَيَشتَهي الناسُ ما لا يُسعَفونَ بِهِ","وَشِركَةُ الخَلقِ دونَ الحَملِ في الوَحَمِ",72,"م",1,0],["وَيَشرَبُ حَتّى يَغمُرَ المَحضُ قَلبَهُ","وَإِن أُعطَهُ أَترُك لِقَلبِيَ مَجثَما",73,"م",2,0],["وَيشملني أبناؤُها برعاية","أَرى أَنَّني قد لا أَرى مثلها بعد",74,"د",1,0],["وَيَشكو السَيفُ مِن كَفّي مَلالاً","وَيَسأَمُ عاتِقي حَملَ النِجادِ",75,"د",1,0],["وَيَشْدُو بِهَا الْقُمْرِيُّ حَتَّى كَأَنَّهُ","أَخُو صَبْوَةٍ أَوْ دَبَّ فِيهِ رَحِيقُ",76,"ق",1,0],["وَيَشْهَدُ ذَا الرَّوضِ الأَرِيضُ وَدوْحُهُ","وَمَا فِيهِ مِنْ زَهْرٍ وعِطْرٍ مُضَوَّعِ",77,"ع",1,0],["ويشكو فقرهُ قبوي","ويشكو محلهُ حقلي",78,"ي",1,0],["ويشتكي النجود للحزون","وجرب الغربة في السفين",79,"ن",1,0],["ويشدو في مسامعكِ الأغاني","بلحنٍ علَّم السجعَ الحَماما",80,"م",2,0],["ويشهدُ الحقُّ أنّ الحقَّ في يدهِ","سيفٌ يروُعُ المنايا غيرُ مغمود",81,"د",1,0],["ويُشعِلُ في القلوبِ وميضَ نارٍ","كنيرانِ الكليمِ هدىً ورشدا",82,"د",2,0],["ويشدو بالمروءة إن تراءت","وبالصنع الجميل إذا تبدّى",82,"د",2,0],["وَيَشْرَكُني في نَشرِهِ الريحُ غُدوةً","فتجري إلى الآفاقِ طَيِّبَةَ النشرِ",83,"ر",1,0],["ويشمت بي حتّى على الموت طغمةٌ","غدت في زمان المكر أسطورة المكرِ",84,"ر",1,0],["ويشمُّون كالكلاب ممرّي","ولهم مثلُها فضولٌ سليقي",85,"ق",2,0],["ويشجُبُ كلُّ امرىءٍ، في الزمانِ،","منْ آلِ عدْنانَ، أو يشجُب",86,"ب",1,0],["ويَشْرَبْنَ من بارِدٍ قَدْ عَلِمْ","نَ أن لا دِخَالَ وأن لا عُطُونَا",87,"ن",2,0],["ويشكوا السيفُ منْ كفي ملالاً","ويسأمُ عاتقي حملَ النجادِ",88,"د",1,0],["ويشتفى العاني","بلثمه فاه",89,"ا",2,0],["ويشمل اسلافا له وبقية","اليه عزثهم طاهرات السلاسل",90,"ل",1,0],["ويشهد منه السر في كل نازل","لقطع الدواهي هزة الصارم الهندي",91,"ي",1,0],["ويشرف الاملاك لثم وصيده","ولديه املاك البرية اعبد",92,"د",1,0],["ويشهد أمر القرب فعلاً وتنجلي","له حضرة التقريب من داخل الخدر",93,"ر",1,0],["ويَشُكُّ الآخَرُ في صاحِبِهِ","وتَكادُ، تَكادُ تُلاعِنُني",94,"ن",2,0],["ويَشتُمُهَا بَعدِى أَلَم يَكُ عَالِماً","بِأني إِذَا شُوتِمتُ أُلفِيتُ أشتَمَا",95,"م",2,0],["وَيَشُنُّ فِيمَا قَد حَوَاهُ إغَارَةً","فَتَظنُّهُ لَولاَ الجَلاَلَةُ هَازِلا",96,"ل",2,0],["وَيَشرَبُ بَعدَهُ الوِلدانُ ريّاً","وَأَحمَدُ قَد تَضَمَّنَهُ القُبورُ",97,"ر",1,0],["وَيُشبِهُ التُركَ إِقداماً وَمَحمِيَةً","فَإِن دَعاهُ وَفاءٌ عاوَدَ العَرَبا",98,"ب",2,0],["وَيَشيمُ رُوّادُ النَدى مِن بِشرِهِ","بَرقاً وَمِن إِحسانِهِ أَمطارا",99,"ر",2,0],["وَيَشرَهُ في العَفوِ عَن قُدرَةٍ","وَيَكرَهُ سَبقَ الحُسامِ العَذَل",100,"ل",1,0],["وَيُشاكِلُ الشَمسَ المُنيرَةَ وَجهُهُ","نوراً وَبُعدَ تَناوُلٍ وَأَديما",101,"م",2,0],["ويشرب كأساً صرفة من مدامةٍ","فيا حبذا كاس ويا حبذا خمر",102,"ر",1,0],["ويشهد بالتّقوى عليك وضدِّها","فما هوا إلاَّ شاهد ومعدّل",103,"ل",1,0],["ويشكو ضياعا والأيادي مظلة","وما أحمد ممن أضاع له حزبا",104,"ب",2,0],["وَيَشتاقُكُم قَلبي فَأَذكُرُ دونَكُم","مَهامِهَ لا أَشتاقُها وَسَباسِبا",105,"ب",2,0],["وَيُشيرُ إِلى القَلَمِ المَيمُو","نِ بِما يُنشِيهِ مِنَ الحِكَمِ",106,"م",1,0],["ويشمّه عودا ومسكا فاخراً","ويجيد بالكافور منه فياقه",107,"ق",2,0],["ويشكو فقدك الغربال يوما","بمسطية تعلّق او تباع",108,"ع",1,0],["ويشدّ حبلا محصدا","دهرٌ وينقض بعد شدّه",109,"د",2,0],["وَيشكرهُ واللَّه شُكراً مؤبّدا","عَلى نعمةِ الإسلامِ واللَّه منعمُ",110,"م",1,0],["ويشهدُ لي على ما في ضميري","سطورُ الدمع ما بين السطورِ",111,"ر",1,0],["ويشتري الحمد بما يقتنى","في كل سوق بالثنا حافل",112,"ل",1,0],["ويشتمنى قوم كوتهم ضغائن","على الرغم ما قالوا فإني فتى العصر",113,"ر",1,0],["ويَشْهَدُ السيفُ والمُرّانُ ما فَعَلتْ","يَمِيْنه وكذا الأقلامُ والصُحُفُ",114,"ف",1,0],["وَيَشقى أخو الجهل في جهلِهِ","وَيحرجُ بالعالِمِ المَذهَبُ",115,"ب",1,0],["وَيُشبِهونَ إذا طاروا إلى عملٍ","جِنّاً تَطيرُ بِأَمرٍ من سُلَيمانِ",116,"ن",1,0],["وَيُشعِفُ قَلبَهُ لَمعُ المَواضي","إِذا اِنتُضِيَت وَيُطرِبُهُ الصَهيلُ",117,"ل",1,0],["ويشهد العين بغير حاجبِ","وللحمى يسير كالكواكبِ",118,"ب",1,0],["وَيَشهَدُ مِنّي سِرَّ كَونِكَ سَيِّدي","جَلِيّاً مَعَ التَنزيهِ بَل عَنهُ قَد عَلا",119,"ل",2,0],["ويشكو فؤادي لحظها ويطيعه","كما يشتكي المظلوم من جور ظالم",120,"م",1,0],["ويشبه المرهفات البيض أعينها","في قتلها الصب إلا أنها سود",121,"د",1,0],["ويشوقُنا ذيَّالِكَ الوطنُ الذي","ملأ القلوبَ تشوُّقاً وتحمُّسا",122,"س",2,0],["ويشبهونَ وهم في صدرِ مجلِسِهم","حباتِ عقدٍ يُحَلّي جيدَ أُختِهم",123,"م",1,0],["ويشتاقُ تطريبَ الحماسةِ والهوى","ويهوى من الغاداتِ حفّاتِ أذيال",124,"ل",1,0],["وَيشمل الناس وعد","يرجى وَيَخشى وَعيد",125,"د",1,0],["وَيشوقني من نحو طيبه نسمة","تنبي المشوق بطيب الاطياب",126,"ب",1,0],["ويَشوقُهُ كَهْلاً إلى عَهْدِ الصِّبا","بَرْقٌ لَمُوعٌ أوْ حَمَامٌ هادِلُ",127,"ل",1,0],["ويشاهد الأشهادُ عزَّ مقامه","وسموه في رتبة العلياء",128,"ا",2,0],["وَيَشوقُني نَجدٌ وَظِلُّ المُنحَنى","وَالخيفُ وَالجرعاءُ وَالعلمانِ",129,"ن",1,0],["وَيَشوقُني وَقعُ السِهامِ وَنَزعُها","إِذ يُرسِلُ اللَحَظاتِ مِثلَ الأَسهُمِ",130,"م",1,0],["وَيَشوقُني ضالُ العُذَيبِ وَظِلُّهُ ال","ضافي وَرَندٌ بِالحِمى وَبشامُ",131,"م",1,0],["وَيشوقُني ذِكرُ الصَبابة والصِبا","وَيَروقُني حُسنُ الرداح الكاعِبِ",132,"ب",1,0],["ويشوقني أنْ أجتلي","ه عَلى التمنُّعِ والتجنّي",133,"ن",2,0],["وَيشير إِذْ يهذي بعشرِ أصابع","وَيدورُ مثل أبي الرياح وَيلبط",134,"ط",1,0],["ويشكره