ه","ولديه املاك البرية اعبد",101,"د",1,0],["ويشهد أمر القرب فعلاً وتنجلي","له حضرة التقريب من داخل الخدر",102,"ر",1,0],["ويَشُكُّ الآخَرُ في صاحِبِهِ","وتَكادُ، تَكادُ تُلاعِنُني",103,"ن",2,0],["ويَشتُمُهَا بَعدِى أَلَم يَكُ عَالِماً","بِأني إِذَا شُوتِمتُ أُلفِيتُ أشتَمَا",104,"م",2,0],["وَيَشُنُّ فِيمَا قَد حَوَاهُ إغَارَةً","فَتَظنُّهُ لَولاَ الجَلاَلَةُ هَازِلا",105,"ل",2,0],["وَيَشرَبُ بَعدَهُ الوِلدانُ ريّاً","وَأَحمَدُ قَد تَضَمَّنَهُ القُبورُ",106,"ر",1,0],["وَيُشبِهُ التُركَ إِقداماً وَمَحمِيَةً","فَإِن دَعاهُ وَفاءٌ عاوَدَ العَرَبا",107,"ب",2,0],["وَيَشيمُ رُوّادُ النَدى مِن بِشرِهِ","بَرقاً وَمِن إِحسانِهِ أَمطارا",108,"ر",2,0],["وَيَشرَهُ في العَفوِ عَن قُدرَةٍ","وَيَكرَهُ سَبقَ الحُسامِ العَذَل",109,"ل",1,0],["وَيُشاكِلُ الشَمسَ المُنيرَةَ وَجهُهُ","نوراً وَبُعدَ تَناوُلٍ وَأَديما",110,"م",2,0],["ويشرب كأساً صرفة من مدامةٍ","فيا حبذا كاس ويا حبذا خمر",111,"ر",1,0],["ويشهد بالتّقوى عليك وضدِّها","فما هوا إلاَّ شاهد ومعدّل",112,"ل",1,0],["ويشكو ضياعا والأيادي مظلة","وما أحمد ممن أضاع له حزبا",113,"ب",2,0],["وَيَشتاقُكُم قَلبي فَأَذكُرُ دونَكُم","مَهامِهَ لا أَشتاقُها وَسَباسِبا",114,"ب",2,0],["وَيُشيرُ إِلى القَلَمِ المَيمُو","نِ بِما يُنشِيهِ مِنَ الحِكَمِ",115,"م",1,0],["ويشمّه عودا ومسكا فاخراً","ويجيد بالكافور منه فياقه",116,"ق",2,0],["ويشكو فقدك الغربال يوما","بمسطية تعلّق او تباع",117,"ع",1,0],["ويشدّ حبلا محصدا","دهرٌ وينقض بعد شدّه",118,"د",2,0],["وَيشكرهُ واللَّه شُكراً مؤبّدا","عَلى نعمةِ الإسلامِ واللَّه منعمُ",119,"م",1,0],["ويشهدُ لي على ما في ضميري","سطورُ الدمع ما بين السطورِ",120,"ر",1,0],["ويشتري الحمد بما يقتنى","في كل سوق بالثنا حافل",121,"ل",1,0],["ويشتمنى قوم كوتهم ضغائن","على الرغم ما قالوا فإني فتى العصر",122,"ر",1,0],["ويَشْهَدُ السيفُ والمُرّانُ ما فَعَلتْ","يَمِيْنه وكذا الأقلامُ والصُحُفُ",123,"ف",1,0],["وَيَشقى أخو الجهل في جهلِهِ","وَيحرجُ بالعالِمِ المَذهَبُ",124,"ب",1,0],["وَيُشبِهونَ إذا طاروا إلى عملٍ","جِنّاً تَطيرُ بِأَمرٍ من سُلَيمانِ",125,"ن",1,0],["وَيُشعِفُ قَلبَهُ لَمعُ المَواضي","إِذا اِنتُضِيَت وَيُطرِبُهُ الصَهيلُ",126,"ل",1,0],["ويشهد العين بغير حاجبِ","وللحمى يسير كالكواكبِ",127,"ب",1,0],["وَيَشهَدُ مِنّي سِرَّ كَونِكَ سَيِّدي","جَلِيّاً مَعَ التَنزيهِ بَل عَنهُ قَد عَلا",128,"ل",2,0],["ويشكو فؤادي لحظها ويطيعه","كما يشتكي المظلوم من جور ظالم",129,"م",1,0],["ويشبه المرهفات البيض أعينها","في قتلها الصب إلا أنها سود",130,"د",1,0],["ويشوقُنا ذيَّالِكَ الوطنُ الذي","ملأ القلوبَ تشوُّقاً وتحمُّسا",131,"س",2,0],["ويشبهونَ وهم في صدرِ مجلِسِهم","حباتِ عقدٍ يُحَلّي جيدَ أُختِهم",132,"م",1,0],["ويشتاقُ تطريبَ الحماسةِ والهوى","ويهوى من الغاداتِ حفّاتِ أذيال",133,"ل",1,0],["وَيشمل الناس وعد","يرجى وَيَخشى وَعيد",134,"د",1,0],["وَيشوقني من نحو طيبه نسمة","تنبي المشوق بطيب الاطياب",135,"ب",1,0],["ويَشوقُهُ كَهْلاً إلى عَهْدِ الصِّبا","بَرْقٌ لَمُوعٌ أوْ حَمَامٌ هادِلُ",136,"ل",1,0],["ويشاهد الأشهادُ عزَّ مقامه","وسموه في رتبة العلياء",137,"ا",2,0],["وَيَشوقُني نَجدٌ وَظِلُّ المُنحَنى","وَالخيفُ وَالجرعاءُ وَالعلمانِ",138,"ن",1,0],["وَيَشوقُني وَقعُ السِهامِ وَنَزعُها","إِذ يُرسِلُ اللَحَظاتِ مِثلَ الأَسهُمِ",139,"م",1,0],["وَيَشوقُني ضالُ العُذَيبِ وَظِلُّهُ ال","ضافي وَرَندٌ بِالحِمى وَبشامُ",140,"م",1,0],["وَيشوقُني ذِكرُ الصَبابة والصِبا","وَيَروقُني حُسنُ الرداح الكاعِبِ",141,"ب",1,0],["ويشوقني أنْ أجتلي","ه عَلى التمنُّعِ والتجنّي",142,"ن",2,0],["وَيشير إِذْ يهذي بعشرِ أصابع","وَيدورُ مثل أبي الرياح وَيلبط",143,"ط",1,0],["ويشكره الورى طراً على ما","يعاب سواه من طول الفتيله",144,"ه",1,0],["ويشفع رسوله الطهر فينا","فهو الشافع الحميد المقام",145,"م",1,0],["ويشملنا بعافية وعفو","فنضحي في سرور وابتهاج",146,"ج",1,0],["ويشفع فينا أحمد سيد الورى","نبي الهدى فالجاه ثم فسيح",147,"ح",1,0],["وَيُشهدني مرّ النسيمِ بسروها","ترنّح غيدٍ في غلائِلها القشبِ",148,"ب",1,0],["وَيَشْتَاقُ مِن أَعْلامِ وَجْرَةَ مَنْزِلاً","غَدَتْ أُسْدُهُ طَوْعَ الظِّباء السَّوَانِحِ",149,"ح",1,0],["ويُشْرِقُ بالوفْدِ حَوْمَ الحجيج","على مَشْعرَيْ زَمْزَمٍ والحطيم",150,"م",1,0],["ويشكَرُ مُفْتَتَحُ المكْرماتِ","ولا مِثْلما يُشكَرُ المُخْتَتَم",151,"م",1,0],["ويُشنِّفُ الأسماعَ بارعُ مَنطِقٍ","يَثْني زِمامَ الرّاكبِ ال