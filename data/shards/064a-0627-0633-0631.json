.com/ViewPoem.aspx?id=177418",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[4623,"محبتي لك نجتني من العطب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146603",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5991,"بكماله ما في الوجو مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=116384",""],[6089,"خذْ ما تشاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=213643",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""],[6210,"نافذة لعينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7248&r=&rc=17",""],[6210,"قالت لي الريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7244&r=&rc=16",""],[6249,"حبٌّ مختَلَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85657&r=&rc=0",""]],"verses":[["يا سَرحَةً بِالقاعِ لَم","يُبلَل بِغَيرِ دَمي ثَراها",0,"ا",3,0],["يا سَرْحَةَ القاعِ رَوّاكِ الحَيا غَدَقاً","منْ ديمَةٍ هَطَلَتْ وُطْفاً عَزاليها",1,"ي",3,0],["يا سَرَواتِ الرَّكْبِ رِفْقاً بِنا","فالأرْحَبيّاتُ رَذايا طِلاحْ",2,"ح",1,0],["يا سِراجَ النّادي وحتْفَ الأعادِي","وعِمادَ المُلْكِ الكَريمِ المَناحي",3,"ح",2,0],["يا سِراجَ الجَمالِ يا ابْنَ سِراجِ","يا هِلالاً في أسْعَدِ الأبْراجِ",4,"ج",1,1],["يا سراةَ الشآمِ أشكو إليكم","أرضَ قُلٍّ فلاحها للرجاء",5,"ا",2,1],["يا سراة الأنصار تاج بينكم","لرؤوس الأنساب أدنى حليّ",6,"ل",2,1],["يا سِرَّ سِرٍّ يَدِقُّ حَتّى","يَخفى عَلى وَهمِ كُلِّ حَيِّ",7,"ي",1,1],["يا سَراة الكُتّاب إن عبيد ال","لَه يُعدي بدائه من بعيدِ",8,"د",1,0],["يا سراةَ البِلاد يَكفي البِلادا","ماأَذابَ القُلوبَ وَالأَكبادا",9,"د",2,1],["ياسِر أَخاكَ وَلا تَهجُم لَهُ حَرَماً","مِن قَبلُ زُكِّيَ في أَكمامِهِ العَلَسُ",10,"س",1,0],["يا سرحة الماء إن جاء الخَريف غداً","فإنما هذه الأوراق تنتثرُ",11,"ر",1,0],["يا سَرحَةَ الروحِ أَينَ الحَيُّ واكَبِدي","لَهفى تَذوبُ وَبَيتِ اللَهِ مِن حَسَرِ",12,"ر",1,1],["يا سَرْحَةَ الأَمَلِ الْمَمْنُوعِ جَانِبُهُ","ويا غَزَالَةَ وادِي الْحُسْنِ إِنْ سَرَحَتْ",13,"ت",1,0],["يا سَريّاً بِمَدْحِهِ","يأمَنُ المَادِحُ السَّرِفْ",14,"ف",1,0],["يَا سرَّ أَحْمَدَ وَالْبَقَاءُ تَسَلْسُلٌ","مَاذَا تُسَامُ لِصَوْنِ أَكْرَمِ مَحتدَ",15,"د",1,0],["يا سراج الجمالِ يا بن سِراج","يا هلالاً في أسعد الأبْراجِ",16,"ج",1,1],["يا سراج النادي وحتف الأعادي","وعماد الملك الكريم المناح",17,"ح",1,0],["يا سريري.. ويا شراشف أمي","يا عصافير.. يا شذا، يا غصون",18,"ن",1,0],["يا سراج الرسل يا قمر ال","أنبيا يا كوكب الرشد",19,"د",1,0],["يا سُراةَ الحي مثلكُمُ","يتلافى الحادث الجللا",20,"ل",2,0],["يا سراةَ الأنامِ عزَّ زمانٌ","قد أقمتم به وأنتم سَراتُه",21,"ت",2,0],["يا سُروري بِنَيلِ تُحفَةٍ خِلٍّ","صادِقِ الوُّدِّ بِالثَناءِ جَديرِ",22,"ر",1,1],["يا سَرحَةً بجوار الماءِ ناضِرةً","سَقاكِ دمعي إذا لم يوفِ ساقيكِ",23,"ك",1,1],["يا سراجَ الأنامِ جنحَ الَّظلامِ","ومُبيدَ العُداة يَوم الِّلطامِ",24,"م",1,1],["يا سَراسُنقُرَ خُذها مِدحَةً","حُسنُها أَورَثَ مَن عاداكَ حُزنا",25,"ن",2,0],["يا سُروري بها وقد وَلِهَ القل","بُ فأَلهت بِسِرِّها اللاهوتي",26,"ت",2,0],["يا سريعَ الغَوثِ غَوثاً","مِنكَ يُدرُكُني سَريعا",27,"ي",3,0],["يا سَرِيّاً لَهُ السَعادَةُ وافَت","مِن طَريقِ العُلا بِفَلَكِ السُرورِ",28,"ر",1,1],["يا سُروراً عَلى القُلوب تَجلّى","وَبِعقد الهَنا لَنا قَد تَحلّى",29,"ل",2,1],["يا سرور الزَمان خيم عَلَينا","وَالقَنا بِالقَنان أَو بِالقيان",30,"ن",1,0],["يا سُروري وراحَتي وَشِفائي","وَعَنائي وَعِلَتي وَاكِتئابي",31,"ب",2,0],["ياسروره ياحبوره إن ختم له بالشهاده","ياكريما يارحيما يالطيفا لعباده",32,"د",2,0],["يا سر عيسى نبي اللَه في زمن","لا هرمس لك محمول على المثل",33,"ل",1,0],["يا سَرْحة الوادي سُقِيتِ من الحيا","غَدَقاً يواصل ديله بقِطاره",34,"ر",2,1],["يا سَرحة الوادي سقتكِ مزنةٌ","تضحَكُ قبلَ الدَّوحِ من بُكاها",35,"ا",3,0],["يا سِربِهِ الجزعَ من دُجيلٍ","حديقةً بين جنتينِ",36,"ن",1,0],["يا سرحةً من ثمارها حسبي","لا خفرتك البروقُ ذمَّةَ ما",37,"م",2,0],["يا سَروَةً في كَثيبِ","أَسرَفتَ في تَعذيبي",38,"ب",2,1],["يا سربُ نعمانَ لقد شاقني","لما سنحتَ الرشاُ الأغيدُ",39,"د",1,0],["يا سرحة الشاطئ المنساب كوثره","على اليواقيت في أشكال حصباء",40,"ا",2,1],["يا سِراجَ الدّينِ يا شَمسَ الهُدَى","يا مُقيمَ الفَرضِ يا مُحيي السُّنَن",41,"ن",1,0],["يا سَرْحَة الوادي وظِلُّكِ وارفٌ","مَنْ لي بجعل أفْوَدَيكِ وِسادي",42,"د",2,0],["يا سراج الركاب مرأى وذكراً","لا عدمنا سراجك الوهاجا",43,"ج",2,0],["يا سريع الخطا إلى الغاية القص","وى كريماً موفَّقاً محمودا",44,"د",2,0],["يا سَرْوَتَيْ حمْرَانَ جا","دكما الغوادي والسَّواري",45,"ر",2,0],["يأسِرُ ألبابَهُمْ بمقلتِهِ","فالقومُ من آسرٍ ومأسور",46,"ر",1,0],["يا سِرَاجَيْ هاشمٍ وكفى","بسراجَيْ سُرْجِ ذا البَشَر",47,"ر",1,0],["يا سر سر وجود الكون منشأه","قدما وآدم بين الطين والماء",48,"ا",2,0],["يا سراجاً ويا رتاجاً تداعى","فات منا سداده والضياء",49,"ا",2,0],["يَأسِرُ الأسْماعَ ما يُنْشِي الشَّغوفْ","بِالثَّنَا المَأثُورْ",50,"ر",1,0],["يا سراجي ومنجدي وطبيبي","يا حبيبي وكعبتي واعتقادي",51,"د",2,0],["يا سروري يا حبوري","حبذا يا صاح قصدي",52,"د",2,0],["يا سروري إذا اجيب ندائي","وحبيبي احيا الفؤاد طلابه",53,"ب",2,0],["يا سروري بوارد الفيض حقا","يا سروري بفايضات النوال",54,"ل",1,0],["يا سرور الفواد بالفيض يبدو","بمعان يدوم فيها السرور",55,"ر",1,0],["يا سَرحَةً حَرُمَت عَلَيّ وَإِنَّها","لَأَلَذّ مِن ماءِ الحَياةِ وَأَعذَبُ",56,"ب",1,0],["يا سريع الحساب يا مهلك المد","رك أدرك خصمي بخزي وويل",57,"ل",1,0],["يا سَرحةَ الماءِ قد سُدَّت موارِدُهُ","أما إليكِ طَريقٌ غيرُ مسدودِ",58,"د",1,1],["يا سُروري إِذ تَلافَت","مَنيَتي بَعدَ الصُدود",59,"د",1,0],["يا سراةَ الركب دونكم","مهجةً أمست لكم تبعا",60,"ع",2,0],["يا سر طه طور سينا تينها","زيتونها طس يس المنى",61,"ن",2,0],["يا سر سمسار السير خمار","الدير مهتار الطير خونا",62,"ن",2,0],["يا سر سر ما عنى الجبار","لعبده موسى بذات النار",63,"ر",1,0],["يا سر قَلبي يا حرف نصبي","يا قاف قربي ممن دعاني",64,"ي",1,0],["يا سراجَ الفخرِ يا غايتَهُ","دعوةً لم تُبْقِ في العَيْشِ نكد",65,"د",1,0],["يا سِراجَ الهُدى عليك صلاةٌ","وسلامٌ يَعُمُّ منهُ الرِّضاء",66,"ا",2,0],["ياسر التيسير أكرم من","يممت مغناه ركبان",67,"ن",1,0],["يا سريّ الشعر لا ترضى به","غير فذ شامخ يأبى القرين",68,"ن",1,0],["يا سرودا في الخطايا","بغرور قد خطر",69,"ر",1,1],["يا سَرحَةَ الوادي وَيا بانَ الغَضا","أَهدوا لَنا مِن نَشرِكُم مَعَ الصَبا",70,"ب",2,0],["يا سَرِيّ بن سائب بن شراحي","ل أمولى تُعَدُّ أم عربيا",71,"ي",2,1],["يا سرَّ هذا العمر أحسبه","لما رايتك منهلاً خصرا",72,"ر",2,0],["يا سريع الفرج يا واسع الفضل والجود","يا مفرّج على أيوب يا ناصراً هود",73,"د",1,0],["يا سرحة الحي حي حجام","أعشب واديك بالحيا الهامي",74,"م",2,1],["يا سِراجاً أسنى منَ الشّمس والشّمْ","سُ سِراجٌ قد جاءَ في القرآنِ",75,"ن",1,0],["يا سراجاً قد اطفأته المنونُ","أنت في القلب لا الترابِ دفينُ",76,"ن",1,1],["يا سرحةَ الشاطىءِ المنسابِ كوثَرهٌ","على اليواقيت في أشكال حصباءِ",77,"ا",2,0],["يا سَرحَةَ الحَيِّ يا مَطولُ","شَرحُ الَّذي بَينَنا يَطولُ",78,"ل",1,1],["يا سر إِيجاد الوجود وَرحمة","للكون أَعرابيه وَالأَعجَمي",79,"م",2,0],["يَا سُرُوري بالَّتدَاني","يَا هَنَا حَظِّي وَسَعْدِي",80,"د",2,0],["يا سرحةُ فوق قبري لا تظللني","وانما ظلها ضاف لزواري",81,"ر",2,1],["يأسر الصب بفرع","كان سبطا أو مجعد",82,"د",1,0],["يا سراةَ الحيِّ ودّي فيكم","ضاع وا ويلي وَقَلبي مرتهن",83,"ن",1,0],["يأسُ راجٍ تسوءُ منه الظنونُ","بنوال المولى الكريم جنون",84,"ن",1,1],["يا سراجاً لما سمت باسمه الشم","س غدا البدر دونها في انحطاط",85,"ط",1,1],["يا سرحة المعروف إن قلائصي","هربت إليك من الزمان المجدب",86,"ب",1,0],["يأْسِر الناس بقدٍّ","وبخدٍّ وبجيدِ",87,"د",1,0],["يا سراج جمال للشهود بدا","لو قابل البدر بعضا من سناك غدا",88,"ا",1,0],["يا سروري يا حياتي دائماً","نشأتي منك وأيضاً نشوتي",89,"ت",2,0],["يا سريعَ الصُّدودِ بَل يا مَديدَ الهَج","رِ قَصِّر بالوَصلِ لَيلي الطَّويلا",90,"ل",2,0],["يا سراة الحي ما أشجى النوى","لفؤاد مستهام محمد",91,"د",1,1],["يا سروري وغايتي في حياتي","ومنى النفس فيك حين مماتي",92,"ت",2,0],["يا سُرَّ من را بُوركتِ من بلدٍ","بُوركَ في نبتهِ وفي شَجرِه",93,"ر",2,0],["يا سرمدا ملأ الحياة غرابة","وبغربة الأشياء عين تنظر",94,"ر",1,0],["ياسر إلهامِ الهوى ونقائِه","ومشارب القلبِ المحبّ وزاده",95,"د",2,0],["ياسر خورشيد المعظم من ذا","هز الحسام تهابه أسد الفلا",96,"ل",2,0],["يا سره الأسمى ويا روح النهي","ومن تسلمت في علا أفضلها",97,"ل",3,0],["ياسر مايخفا ولاهو بمكشوف","الى متى للناس بابك موارب",98,"ب",1,0],["يا سرجةً برواق جينيف ارتوت","من جدولٍ بدم الضحايا ينضحُ",99,"ح",1,0],["ياسر سر السرها أسراك من","أسراك في أشراك أسر آسر",100,"ر",1,0],["ياسرع مازوله يقفّي وينساك","لو كان أعطى لك عهود ووثيقه",101,"ق",2,0],["يا سراةَ القومِ هل من خالديٍّ","يمتطي السيفَ لحربٍ واحتراسي ؟",102,"س",2,0],["يَا سِرَّ قَافِيَتِي هَذِي مَوَاوِيلِي","كَتَبْتُ بِالحَرْفِ جُرْحِي بِالتَّفَاصِيلِ",103,"ل",1,1],["يا سُرّةَ الإيمانِ حَبلُكِ موثَقٌ","بعُرَى السّما، يجري به الإيحاءُ",104,"ا",2,0],["يا سراج الرشد يا شمس الهدى","يا ابن من فيه ازدهى فخر لؤي",105,"ي",1,0],["يا سرّ روحي يا ملاك مدائني","أنا نورسّ يهفو وأنتٰ جداولُ",106,"ل",1,0],["ياسراباً عزّ في قيعاتهِ","اجْدٓبٓ الروحٓ فرامتْ منْهلكْ",107,"ك",1,0],["ياسُرّ من جاءٓ يوماً في زيارتها","إني رمانيْ هوى العشّاقِ في هبلي",108,"ل",2,0],["ياسرّ من نظرالآتون بهجتها","ياشعر بُحترها منْ لفظه الجزلِ",108,"ل",1,0],["يا سراجي الوضاح في كل مسراي","ويا غاية عندي سوت كل غايه",109,"ا",3,0],["ياسر هذا الوجود حيث عممه","فضلا وجودا بإمداد مدى الحقب",110,"ب",1,0],["يا سرّ مرَّى لقد أصبحت لي سكناً","لما سكنك إمامان لنا قطنا",111,"ن",2,1],["يا سروةٌ للبان يا غصن النقا","ولفضلك المياس قلبي طائر",112,"ر",1,0],["يا سرّ هذا البوحِ ضمّ إليكَ أع","طافي فكمْ لي في انتظارِك تآتي",113,"ت",2,0],["يا سرَّ سِرِّ المُسْتَسَرِّ وسرُّ (ها)","فيكَ استتمتْ ياءَها المنضودا",114,"د",2,0],["يا سَريا سما به الإسراء","وَسنيا منه اِستَنارَت ذُكاء",115,"ا",2,1],["يا سر العز يا عزيزُ سلاما","إذ ذهبتم نموذجا للولاء",116,"ا",2,0],["يا سري الابدي يا سحر الدجى","لغزي الذي لا يقبل التاويلا",117,"ل",2,0],["يا سري السحري اني متعب","والصخر مثلي .. وحشة ونحيب",118,"ب",1,0],["يا سرابَ التِّيهِ .. يا بَرْقَ الْمُنى","يا جُنونَ الليلِ في كفِّ الغسَقْ",119,"ق",1,0]]}