ين",9,"ن",1,0],["ثم عند البعث لما","جمع الشمل الشتات",10,"ت",1,0],["ثُمَّ عَرَّفتَهُم جِباهَ رِجالٍ","صامِتِيّينَ في الوَغى مُصمَتينا",11,"ن",2,0],["ثُمَّ عاضَدتُهُ فَكُنتُ لَهُ عَي","ناً وَعَوناً في كُلِّ حَربٍ عَوانِ",12,"ن",1,0],["ثُمَّ عُد لِلوِصالِ مِن غَيرِ مَطلٍ","مِثلَما كُنتَ قَبلَ ذاكَ وَكُنّا",13,"ن",2,0],["ثُمَّ عاضَدتَهُ فَكُنتَ لَديهِ","مِثلَ هارونَ في فَتى عِمرانِ",14,"ن",1,0],["ثُمَّ عِلمي عَلى حَداثَةِ سِنّي","بِصُروفِ الدُهورِ وَالتَصريفِ",15,"ف",1,0],["ثُمَّ عُجناهُنَّ خوصاً كَالقَطا ال","قارِبِ المَنهَلَ مِن أَينِ الكَلالِ",16,"ل",1,0],["ثُمَّ عِظاماً أَقَامَها عَصَبٌ","ثُمَّتَ لَحماً كَساهُ فَالتأَما",17,"م",2,0],["ثم عادَ الإيمان يقوى إلى أن","سلَّه الشيطان الرجيمُ الغرور",18,"ر",1,0],["ثم عانقتها وقلت اهدئي ان","ي على ما تبكين لست قويا",19,"ي",2,0],["ثُمَّ عودي مِن بَعدِ ذا وَاِشكُريني","وَاِذكُري ما رَأَيتِهِ مِن فِعالي",20,"ل",2,0],["ثمّ عندَ اللقاء يُعرفُ إن كان","هنلكم \" نجيبةٌ ! \" أو نجيب",21,"ب",1,0],["ثم عذراً فهي ما في قدرتي","لا يسامُ المرءُ إلاّ ما أطاقْ",22,"ق",1,0],["ثم عَرِّض بي كأنك في","ذكرِ حالي غيرُ مُقْتصِد",23,"د",1,0],["ثمّ عادَ النبيُّ والأصحابُ","وَالأسارى والفيء والأسلابُ",24,"ب",1,0],["ثمَّ عدنان ناله ومعدٌّ","وَنزارٌ وهكذا نجباءُ",25,"ا",2,0],["ثمَّ عادَت تعدو علَيها فلم تد","رِ أتانٌ أم سابقٌ عدّاءُ",25,"ا",2,0],["ثمَّ عادَ الضيفُ الكريمُ إلى الأه","لِ وَتمّت من ربّه النعماءُ",25,"ا",2,0],["ثمَّ عادَ النبيُّ يتبعهُ السع","دُ وَتَمشي أمامه السرّاءُ",25,"ا",2,0],["ثمّ عادَ النبيُّ وَالصحبُ بالفو","زِ وَطابت بطيبةَ الأنداءُ",25,"ا",2,0],["ثمّ عادَ الضيفُ الكريمُ إلى الأَه","لِ وَقَد زادَ برّه والحباءُ",26,"ا",2,0],["ثمَّ عد سالما تُرافِقُك البُش","رى وَتَسعى أَمامَك السَرّاءُ",27,"ا",2,0],["ثم عِشنا ثلاثةً بفم الحا","سد من عيشنا الثَرَى والصخور",28,"ر",1,0],["ثم علَتْها رِقّةٌ فانثنتْ","قائلةً يُجْزَى بمثلَيْ هواه",29,"ا",2,0],["ثُمَّ عِندَ المَسَاءِ فَاعكف على ذا","وعَلَى ذا بِأَعظَمِ الأقدَاحِ",30,"ح",1,0],["ثُمَّ عَينُ الكُبرى وَأَحسِن بِها عَي","ناً وَماءً وَعَينُ بَلودانِ",31,"ن",1,0],["ثم عاد الرقصُ أَورى ما يكونْ","زندُه والعزفُ موصولُ الهدير",32,"ر",1,0],["ثم عرج على اليمن الفي","حاء ذات السهول والآكام",33,"م",1,0],["ثم عد بالأخبار","عنهم هل هم حافظون للجار",34,"ر",1,0],["ثُمَّ عَدلي بِما يَطمَئِنُّ بالي","وِعاءٌ هُوَ الَّذي أَتَرَقَّب",35,"ب",1,0],["ثُمَّ عَبدُ العَزيزِ قَرمٌ هِجانٌ","لَم يُضَيِّع لَمّا اِعتَرَتهُ الأُمورُ",36,"ر",1,0],["ثم عودي إليّ بعد قليل","تجديني كما أنا فاطمئني",37,"ن",2,0],["ثُم عُد سالِما لَنا وَاِلَيهِ","كُل عام تَعود وَالعود أَحمد",38,"د",1,0],["ثُم عَجَّ بي لِلنَّهر عَن أَيمَن القَص","ر فَفي ذاكَ راحَتي وَهَنائي",39,"ا",2,0],["ثم عجَّزت عن صِفاتِك شعري","أو لَيسَت تُعجِّز الأَشعارا",40,"ر",2,0],["ثُمَّ عاطَيتهُ مِن العَتب كَأساً","شَبَت مَعسولَها بِدَمع مُراق",41,"ق",1,0],["ثُم عَلَيَّ بنَ أَبي طالِبٍ","خيرَ امامٍ عاشَ مَظلوما",42,"م",2,0],["ثم على من دعى الأنام إلى","مقالهم لا إله إلا اللّه",43,"ل",2,0],["ثم عذراً إذ رأيت نظامي","في اختلال وركة وانكسار",44,"ر",1,0],["ثم عاد الكل نحوك في","طلب التخليص من كبده",45,"د",2,0],["ثم عادت من العراق إلينا","بعد بينٍ مشمولةً بالنوالِ",46,"ل",1,0],["ثم عادت تقتضيني ردَّها","أين هذا قبلَ أن يُغلَق رهني",47,"ن",2,0],["ثمَّ عِدْني بوِصالٍ","وامْطُلَنْ عاماً فَعَامَا",48,"م",2,0],["ثم عاملتني بما ينبغي لي","من وقار ونائل مستفاد",49,"د",1,0],["ثم عبدُ العزيزِ فِي الذَّوقِ والت","تَنسِيقِ وَالتَّنظِيمِ الذي يَسبينَا",50,"ن",2,0],["ثم عِشنا حتى رأَينا زماناً","فيه بالجودِ منهمُ صارَ يُطرَى",51,"ر",2,0],["ثم عنه صدرت كل الورى","والسموات العلى والفلك",52,"ك",1,0],["ثم عنها بأنها ثَقُلَتْ قا","ل لإظهار نشأة تقتضيها",53,"ي",3,0],["ثم عقلي فوق العقول به","حاش لله أن أكون أنا",54,"ن",2,0],["ثم عنهم خلعوا ما","عاقهم دون المنون",55,"ن",1,0],["ثم عنه كل شيء","هالك فيه وبالي",56,"ل",2,0],["ثم عرِّج نحو كاظمة","حيث تلك الساح والبقع",57,"ع",1,0],["ثم عدنا بعد ذاك وذا","ما لنا رِيٌّ ولا شبع",57,"ع",1,0],["ثم عن الكون كن","منقبضاً معرضا",58,"ض",2,0],["ثم علم الكلام ردَّ على من","حاولوا أن يكون دين جديد",59,"د",1,0],["ثم عم السلام والعدل ظل","لم يكدر به الصفاء نزاع",60,"ع",1,0],["ثُمَ عادَ الأَمير بِالنَصر للأو","طان يَسعى وَالشُكر كانَ جَزاه",61,"ا",2,0],["ثمَّ عُمراً يَطولُ وهوَ مَديدٌ","لَيسَ يَعروهُ في الزّمانِ اِنتِهاءُ",62,"ا",2,0],["ثُمَّ عَنّي اِلثُما شَريفَ يَديهِ","ثُمَّ عودا بِذِكرِهِ عَلِّلاني",63,"ن",2,0],["ثم عدنا حيث كنا","من رجاء للتلاقي",64,"ق",2,0],["ثُمَّ عادَت شَبائِهاً تَتَباهى","بِأَعالي شِبائِهٍ أَقرانِ",65,"ن",1,0],["ثُمَّ عَلى الْجَوازِ هَلْ يُلْتَزَمُ","فِي مَنْ يَؤُمُّ الْفِقْهَ أَوْ لا يَلْزَمُ",66,"م",1,0],["ثم عقلت ناقتي في شجره","ونلت من بعض النخيل ثمره",67,"ه",1,0],["ثم على أصحابه والآل","أهل التقى والعلم والكمال",67,"ل",1,0],["ثم عني بلّغه صاح غراماً","زايداً في الحشا آثار غليلا",68,"ل",2,0],["ثم عاطاني سُلافاً","مِثلُها مِنْ فِيهِ يُعْطِي",69,"ط",2,0],["ثُم عَلقت ناقَتي في شَجرة","وَنلت مِن بَعض النخيل ثَمَرة",70,"ه",1,0],["ثم عادوا وأقبلوا","تالداً بعده طريف",71,"ف",1,0],["ثم عرِّجْ من بيت لِهْيا على مَقْ","رى فَسَطْرا من قبل سَجْع الحَمام",72,"م",1,0],["ثُمَّ عَدِّ القَولَ إِن أَفهَمتَهُ","عِندَ مَن يَحفَظُ إَيمانَ العَهد",73,"د",1,0],["ثم عج بي من غير عجب وسربي","نحو سربي للحلّة الفيحاء",74,"ا",2,0],["ثُم عَلاها بِالماءِ فَاِضطَربَت","وَطَيَّرَت بِالحباب وَالزَبَد",75,"د",1,0],["ثم عاد السكوتُ فانتصبت أَلبا","كقاضٍ أمامَه الخُصماءُ",76,"ا",2,0],["ثم عانقته وقلت ونار ال","خد تزداد بالعتاب سعيرا",77,"ر",2,0],["ثم عرج على الخيام وحاذر","من ظباء ألحاظها ختاله",78,"ل",2,0],["ثُمَّ عَلى عَبدِ العَزيزِ","رَحمَةٌ تَجَدَّدُ",79,"د",1,0],["ثم على ذا فاقفها إن تكن","تعقل أو تبصرُ أو تسمعُ",80,"ع",1,0],["ثم على الضعيفين في ذلكم","شاتان من أوساطها تقرعُ",80,"ع",1,0],["ثم عنه نادِ من يَسلو فَقَد","طالَما أَمسيت فيه نادِما",81,"م",2,0],["ثم عزوها على رأد الضحى","ولقى في كبد الغرب شفون",82,"ن",1,0],["ثم عرّج نحو وادي طيبة","لحمى طه التهامي أحمدا",83,"د",2,0],["ثمَّ علَى أهلِ البَقِيع","مَن قَدرُهُم قَدرٌ رَفِيع",84,"ع",1,0],["ثُمَّ على آلٍ كِرَام","وَصَحبِهِ أُولِى المَقام",84,"م",1,0],["ثم عودا وبشرا وطني","فالعيش ان نموت فداه",85,"ا",2,0],["ثم عادوا منها وظلوا اليها","في أشدّ النزوع والتوقانِ",86,"ن",1,0],["ثم عادت إلى المنابت سعيا","ساريات العروق في أسراب",87,"ب