العدل دعوى يعجب الناس حسنها","https://www.aldiwan.net/poem43060.html","الطويل"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[105,"دعا فأثار الساكنين دعاؤه","https://www.aldiwan.net/poem43426.html","الطويل"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[40,"أراد اليوم جيرتك الغيارا","https://www.aldiwan.net/poem42293.html","الوافر"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[75,"ثوت مضر الحمراء تحت طرافها","https://www.aldiwan.net/poem69036.html","الطويل"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[48,"دعوا غناء سماعه","https://www.aldiwan.net/poem66273.html","المجتث"],[46,"تقواك زاد فاعتقد أنه","https://www.aldiwan.net/poem22036.html","السريع"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85502","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1313","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42501","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43633","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43803","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43660","الوافر"],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[41,"صدعَ البينُ والتَّفرّقُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=4207",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""]],"verses":[["ثوروا لَها وَلتَهُنُ فيها نُفوسُكُمُ","إِنَّ المَناقِبَ لِلأَرواحِ أَثمانُ",0,"ن",1,0],["ثَوَّرتُها تَنتَعِلُ الظَلاما","لا نَقوَ أَبقَينَ وَلا سُلامى",1,"م",2,1],["ثَوى بِالأَمسِ فيكَ عُلاً وَمَجدٌ","وَأَنتَ اليَومَ مَثوىً لِلعُلومِ",2,"م",1,0],["ثَوى المِصَكُّ الَّذي قَد كُنتُ آملُهُ","عَوناً وَخُيِّبَ فيهِ ذلِكَ الأَمَلُ",3,"ل",1,0],["ثَوى مِنهُما ثِنيَ النِجادِ مُشَيِّعٌ","نَجيدٌ وَمَيلاءُ الوِشاحِ كَعابُ",4,"ب",1,0],["ثَوى صافِناً في مَربِطِ الهونِ يَشتَكي","بِتَصهالِهِ مانالَهُ مِن أَذى الشَكلِ",5,"ل",1,0],["ثَوَى وَفِي وُلدِهِ فَضَائِلُهُ","ذُخْرٌ مِنَ الصَّالِحَاتِ مُقْتَسِمُ",6,"م",1,0],["ثَوْبٌ كَأَنَّكِ فِيهِ","نَسَجْتِ لَمْحَ الَّلآلِي",7,"ي",1,0],["ثَوَتِ النَفسُ من الحُمولِ لَدَيها","وَتَولَّى بالجِسمِ منّيَ صَحبي",8,"ب",2,0],["ثَوى بَينَ نِسعَيها عَلى ما تَجَشَّمَت","جَنينٌ كَدُعموصِ الفَراشَةِ مُغرِقُ",9,"ق",1,0],["ثوب السماء لأنه","بدرٌ بدا للنّاسِ",10,"س",1,0],["ثَوى حامِلُ الأَثقالِ عَن كُلِّ مُغرَمٍ","وَدامِغُ شَيطانِ الغَشومِ السَمَلَّقِ",11,"ق",1,0],["ثَوانِيَ أَجيادٍ يُوَدِّعنَ مَن صَحا","وَمَن بَثُّهُ عَن حاجَةِ اللَهوِ شاغِلُه",12,"ل",2,0],["ثَوبَاه منه الصَّقِيعُ تَلحَفُه","والتُربُ من سَافِيَائِه التَرِبُ",13,"ب",1,0],["ثوباه منه الصقيع تلفحه","والترب من سافياته الترب",14,"ب",1,0],["ثَوى بِمَكَّةَ بِضعَ عَشرَةَ حِجَّةً","يُذَكِّرُ لَو يَلقى خَليلاً مُؤاتِيا",15,"ي",2,1],["ثوى بحرها في ساحلِ الشامِ وانْبرت","لآلِ نماها عذبها لا أجاجها",16,"ج",3,0],["ثوبٌ من الحب أودى بي مشهره","فالجسم أصفره والدَّمع أحمره",17,"ر",2,1],["ثوت في مهاوي التراب كالتبر خالصاً","فحققت أن الترب بعض المعادن",18,"ن",1,0],["ثَوَّبَتْ بي إلى عليٍّ معالي","هِ فلبَّيتُ أوّل التثويبِ",19,"ب",1,0],["ثَوْبيَ الرثُّ والثيابُ طِرَاءٌ","وطعامي بِرَغْمِيَ المجشُوبُ",20,"ب",1,0],["ثوبٌ تمزِّقه الأناملُ رقةً","ويُذيبه الماء القَراح فينْهَجُ",21,"ج",1,0],["ثواباً منه كالريع","لمدح فيه كالبذر",22,"ر",1,0],["ثوتْ في قَرار الدَنِّ حتى تهلهلت","ملابسُها عنِ صَفْوها وملابسه",23,"س",2,0],["ثوت تصطلي شمس الظهائر برهةً","إلى أن أفادت لونَ شمس الأصائلِ",24,"ل",1,0],["ثوابُهُم أن يُمَنُّوا مسْتَثيبَهُمُ","وهل يُثيبُ على الأعمالِ أوثان",25,"ن",1,0],["ثوتْ في نعيمٍ نِعْمةُ الله إذ غدتْ","وراحتْ وظَلَّتْ في ذراك استكنَّتِ",26,"ت",1,0],["ثَوَت بَينَ جُدرانٍ كَقَلبِ مُضيمِها","تَلَمَّسُ فيها مَنفَذاً فَتَخيبُ",27,"ب",1,0],["ثوروا عَلَيهِم وَاِطلُبوا اِستِقلالَكُم","وَتَشَبَّهوا بِالصِربِ وَاليونانِ",28,"ن",1,0],["ثَورٌ غَدا أُعجوبَةً","بِلِحيَةٍ مُدَوَّرَه",29,"ر",2,0],["ثَوْرَةُ الشَّرِّ وأَحْلامُ السَّلامْ","وجَمالُ النُّورْ",30,"ر",1,0],["ثوبوا إلى أنفسكم","فقد أسأتم للادب",31,"ب",1,0],["ثوروا على العادات ثورة حانق","وتمردوا حتى على الاقدار",32,"ر",1,0],["ثورة أقبلت السلمُ بها","عجبُ الرائين سحرُ السامعين",33,"ن",1,0],["ثَوابَةُ أَو مِهرانُ يَقتَضِيانِهِ ال","سُمُوَّ اِقتِضاءَ الوَعدِ مِن مُنجِزِ الوَعدِ",34,"د",1,0],["ثُؤوبُ ذي الأَثرِ إِن يُعِد صَنَعٌ","لَهُ صِقالاً يَوماً يَعُد لَهُ أُثُرُه",35,"ر",2,0],["ثَوى اِبنايَ في بَيتي مُقامٌ كِلاهُما","أَخِلَّتُهُ عَنّي بَطيءٌ ذَهابُها",36,"ب",3,0],["ثوباً تمزِّقُهُ الأناملُ رِقَّةً","ويُذيبُه الماءُ القَرَاح فيبهُجُ",37,"ج",1,0],["ثَوى بِرُزاءَ خَيرُ فَتى أُناسٍ","ثَوى بِرُزاءَ وَاِرتَحَلَ الوُفودُ",38,"د",1,1],["ثَوى مِنهُمُ في بِئرِ بَدرٍ عِصابَةٌ","ذوو نَجَداتٍ في الحُروبِ وَفي المَحلِ",39,"ل",1,0],["ثَوبُ مَن ماتَ عَلى وارِثِهِ","وَعَلى مَن ماتَ ثَوبُ مِن مَدَر",40,"ر",1,1],["ثَوبٌ خَلَعتُ العِزَّ حينَ لَبِستُهُ","إِذ كانَ إِذ ذُلُّ الصَبابَةِ يورَثُ",41,"ث",1,0],["ثَوَتِ الخُطوبُ مَخافَةً مِن بَأسِهِ","صَرعى وَذَلَّ بِها الزَمانُ الأَحنَثُ",41,"ث",1,0],["ثَوبٌ تُجَندِرُهُ الرِيا","حُ وَقَد أَضَرَّت بِالطِرازِ",42,"ز",1,0],["ثَوى في الثَرى مَن كانَ يَحيا بِهِ الثَرى","وَيَغمُرُ صَرفَ الدَهرِ نائِلُهُ الغَمرُ",43,"ر",1,0],["ثَوى بِالمَشرِقَينِ لَهُم ضَجاجٌ","أَطارَ قُلوبَ أَهلِ المَغرِبَينِ",44,"ن",1,0],["ثَوَت لِفِراقِهِ الآدابُ شُعثاً","وَجَفَّت بَعدَهُ غُدُرُ الكَلامِ",45,"م",1,0],["ثَوى مالُهُ نَهبَ المَعالي فَأَوجَبَت","عَلَيهِ زَكاةُ الجودِ ما لَيسَ واجِبا",46,"ب",2,0],["ثَوَى زمناً يشكو الجراحَ فلم تَزَلْ","تُداويه حتّى ارتدَّ يَشكوهُ جَارِحُهْ",47,"ح",2,0],["ثَوتْ تَتجرَّعُ الآلامَ شتَّى","على أيدي الدُّهاةِ الماكرينا",48,"ن",2,0],["ثَوى العَدلُ في الفاروقِ وَاِنجابَ ظِلُّهُ","غَداةَ اِنطَوَت أَعلامُهُ وَهيَ تَخفَقُ",49,"ق",1,0],["ثَوَت أُمَمُ الإِسلامِ مِن بَعدِما مَضى","تُراعُ بِأَهوالِ الخُطوبِ وَتُصعَقُ",49,"ق",1,0],["ثَوى عاثِرَ الآمالِ يونِسُهُ الأَسى","وَتُوحِشُهُ أَوطارُهُ وَمَآرِبُه",50,"ب",2,0],["ثَوى فيهِ أَقوامٌ مَلَلنا ثَواءَهم","وَيا رُبَّ ثاوٍ لا يُملُّ ثَواؤُهُ",51,"ا",3,0],["ثَوَوْا في الأرضِ عُمَّالاً عليها","يُؤَدُّونَ الإتاوةَ والنِّصابا",52,"ب",2,0],["ثُوبوا جُموعَ المشركينَ فإنّما","غَرَّتكمُ الأوثانُ والأنصابُ",53,"ب",1,0],["ثَورَةُ الغاضب للحَقِّ تُرى","هَذِهِ أَم شغبٌ مِن وُكَّلِ",54,"ل",1,0],["ثَوانِيَ لِلأَعناقِ يَندُبنَ ما خَلا","بِيَومِ اِختِلافٍ مِن مُقيمٍ وَظاعِنِ",55,"ن",1,0],["ثَوى جَسَدي وَشيَّعهُم فُؤادي","وَعَيني ما تَجِفُّ لَهُم غِزارا",56,"ر",2,0],["ثَوَت تَحتَ لَيلِ القارِ خَمسينَ حِجَّةً","تَرُدُّ مُهوراً غالِياتٍ وَخُطّابا",57,"ب",2,0],["ثَوَتْ مُضَرُ الحمراءُ تحتَ طِرافِها","وقالتْ نِزارٌ يا ربيعةُ ألجِمي",58,"ي",1,1],["ثَوَى بكَ عز المُلكِ فيهم ولم تَزَلْ","وأنتَ لهُ العِلْقُ النفيسُ ومَعْلَقُه",59,"ق",2,0],["ثوروا إليه ونادوا","إنّ الصلاةَ جماعه",60,"ع",2,0],["ثَوبِيَ مُحتاجٌ إِلى غاسِلٍ","وَلَيتَ قَلبي مِثلَهُ في النَقاء",61,"ق",3,0],["ثَوانِيَ ضَيفٌ فَلَم أَقرِهِ","أَوائِلَ مِن عَزمَتي أَو ثَواني",62,"ن",2,0],["ثورةٌ في الجحيم أرجفت العر","شَ وكادت منها السماءُ تمور",63,"ر",1,0],["ثوبوا إلى العلم إن العلم مكرمة","وَفي تلقيه لا يأخذكم الضجرُ",64,"ر",1,1],["ثَوَوا في الثَرى مِن بَعدِما سُربِلوا العُلا","وَمِن بَعدِما سُمّوا نُجومَ المَحافِلِ",65,"ل",1,0],["ثوى وساق نجب الصّحاب","بورك في البحر وفي السّحابِ",66,"ب",1,0],["ثَوَتْ فِي ضَمِيرِ الدَّهْرِ والْجَوُّ ظُلْمَةٌ","بِلا كَوْكَبٍ وَالأَرْضُ تَسْبَحُ في غَمْرِ",67,"ر",1,0],["ثَوَى بُرْهَةً في الأَرْضِ حَتى إِذا قَضَى","لُبانَتَهُ مِنْهَا دَعَتْهُ سَمَاؤُهُ",68,"ا",3,0],["ثَوَى المَلِيكُ القُطْبُ فِي حِينِ لاَ","رَبْعٌ خَلاَ مِنْهُ وَلاَ قُطْرُ",69,"ر",1,0],["َّثونا عن الحقوق فلمّا كبَّر","النصرُ ، أعوزتْنا التراجم",70,"م",1,0],["ثَوى عَلى جَمرِ الغَضا من فراقكُم","فَهَل مِن خَيالٍ عَن غَرامي باحِثِ",71,"ث",1,0],["ثَوابُ اللَهِ أَعظَمُ لِلمُرَبّي","فَصَبرٌ إِن أَفاتَ فَقدَ أَعاضا",72,"ض",2,0],["ثَوبُ السُرورِ سَلَبتَني","وَجَعَلتَ أَحزاني لِباسي",73,"س",2,0],["ثَوَيت في الطَيِّبينِ دوني","فَما لِمَثوايَ في الخباثِ",74,"ث",1,0],["ثوبي بالٍ وَلا أُبالي","في جُدَدٍ كُنتُ أَو رَثاثِ",74,"ث",1,0],["ثوى عَبد الغَني هَوىً بِقَلبي","فَلَيسَ وَإِن نَأى عَنّي بِنائي",75,"ا",3,0],["ثوى اليومَ في هذي الحفيرة عالِمٌ","باسرارها . لهه بالعقل ناشد",76,"د",1,0],["ثوَى اليومَ في هذي الحفيرة شاعرٌ","على الظلم محتجٌّ عن العدل ذائد",76,"د",1,0],["ثوتِ النفسُ في الحمولِ لديها","وتولَّى بالجِسْمِ منّي صَحْبي",77,"ب",2,0],["ثوروا عليهم واطلبوا استقلالكم","ونشبّهوا بالصّرب واليونان",78,"ن",1,0]]}