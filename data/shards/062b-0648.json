78.html","الكامل"],[407,"وليل كسا الآفاق ثوب ظلامه","https://www.aldiwan.net/poem50198.html","الطويل"],[407,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[430,"ثوى البحري اندراوس ترب لحد","https://www.aldiwan.net/poem40515.html","الوافر"],[438,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[440,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[442,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[442,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[442,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[446,"لهوى الحجاز بأفق قلبي مبدأ","https://www.aldiwan.net/poem23812.html","الكامل"],[459,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[462,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[465,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[465,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[465,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[465,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[483,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[496,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[516,"أبا حسن كدرت ماء صفائي","https://www.aldiwan.net/poem11997.html","الطويل"],[516,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[539,"ألم به الوشي فأعرض هازئا","https://www.aldiwan.net/poem47505.html","عموديه"],[547,"أمن رسم دار ماء عينيك يسفح","https://www.aldiwan.net/poem1860.html","الطويل"],[552,"ألا لله ما صنع الحمام","https://www.aldiwan.net/poem47251.html","الوافر"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[554,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[559,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[559,"ثوب صدق المجال فوق قميصي","https://www.aldiwan.net/poem34425.html","الخفيف"],[559,"خيطان خيط أبيض وهو الوجود","https://www.aldiwan.net/poem34578.html","الرجز"],[559,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[563,"لقد حل الأمين ضريح مجد","https://www.aldiwan.net/poem52620.html","الوافر"],[563,"ضريح قد سقاه سحاب فضل","https://www.aldiwan.net/poem52671.html","الوافر"],[563,"ثوى في اللحد أسقفنا المفدى","https://www.aldiwan.net/poem52685.html","الوافر"],[563,"لهذا الفرق دان الفرقدان","https://www.aldiwan.net/poem52922.html","الوافر"],[563,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[563,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"],[576,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[576,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"]],"verses":[["ثوروا لَها وَلتَهُنُ فيها نُفوسُكُمُ","إِنَّ المَناقِبَ لِلأَرواحِ أَثمانُ",0,"ن",1,0],["ثَوَّرتُها تَنتَعِلُ الظَلاما","لا نَقوَ أَبقَينَ وَلا سُلامى",1,"م",2,1],["ثَوى بِالأَمسِ فيكَ عُلاً وَمَجدٌ","وَأَنتَ اليَومَ مَثوىً لِلعُلومِ",2,"م",1,0],["ثَوى المِصَكُّ الَّذي قَد كُنتُ آملُهُ","عَوناً وَخُيِّبَ فيهِ ذلِكَ الأَمَلُ",3,"ل",1,0],["ثَوى مِنهُما ثِنيَ النِجادِ مُشَيِّعٌ","نَجيدٌ وَمَيلاءُ الوِشاحِ كَعابُ",4,"ب",1,0],["ثَوى صافِناً في مَربِطِ الهونِ يَشتَكي","بِتَصهالِهِ مانالَهُ مِن أَذى الشَكلِ",5,"ل",1,0],["ثَوَى وَفِي وُلدِهِ فَضَائِلُهُ","ذُخْرٌ مِنَ الصَّالِحَاتِ مُقْتَسِمُ",6,"م",1,0],["ثَوْبٌ كَأَنَّكِ فِيهِ","نَسَجْتِ لَمْحَ الَّلآلِي",7,"ل",2,0],["ثَوَتِ النَفسُ من الحُمولِ لَدَيها","وَتَولَّى بالجِسمِ منّيَ صَحبي",8,"ب",2,0],["ثَوى بَينَ نِسعَيها عَلى ما تَجَشَّمَت","جَنينٌ كَدُعموصِ الفَراشَةِ مُغرِقُ",9,"ق",1,0],["ثوب السماء لأنه","بدرٌ بدا للنّاسِ",10,"س",1,0],["ثَوى حامِلُ الأَثقالِ عَن كُلِّ مُغرَمٍ","وَدامِغُ شَيطانِ الغَشومِ السَمَلَّقِ",11,"ق",1,0],["ثَوانِيَ أَجيادٍ يُوَدِّعنَ مَن صَحا","وَمَن بَثُّهُ عَن حاجَةِ اللَهوِ شاغِلُه",12,"ل",2,0],["ثَوبَاه منه الصَّقِيعُ تَلحَفُه","والتُربُ من سَافِيَائِه التَرِبُ",13,"ب",1,0],["ثوباه منه الصقيع تلفحه","والترب من سافياته الترب",14,"ب",1,0],["ثَوى بِمَكَّةَ بِضعَ عَشرَةَ حِجَّةً","يُذَكِّرُ لَو يَلقى خَليلاً مُؤاتِيا",15,"ي",2,1],["ثوى بحرها في ساحلِ الشامِ وانْبرت","لآلِ نماها عذبها لا أجاجها",16,"ج",3,0],["ثوبٌ من الحب أودى بي مشهره","فالجسم أصفره والدَّمع أحمره",17,"ر",2,1],["ثوت في مهاوي التراب كالتبر خالصاً","فحققت أن الترب بعض المعادن",18,"ن",1,0],["ثَوَّبَتْ بي إلى عليٍّ معالي","هِ فلبَّيتُ أوّل التثويبِ",19,"ب",1,0],["ثَوْبيَ الرثُّ والثيابُ طِرَاءٌ","وطعامي بِرَغْمِيَ المجشُوبُ",20,"ب",1,0],["ثوبٌ تمزِّقه الأناملُ رقةً","ويُذيبه الماء القَراح فينْهَجُ",21,"ج",1,0],["ثواباً منه كالريع","لمدح فيه كالبذر",22,"ر",1,0],["ثوتْ في قَرار الدَنِّ حتى تهلهلت","ملابسُها عنِ صَفْوها وملابسه",23,"س",2,0],["ثوت تصطلي شمس الظهائر برهةً","إلى أن أفادت لونَ شمس الأصائلِ",24,"ل",1,0],["ثوابُهُم أن يُمَنُّوا مسْتَثيبَهُمُ","وهل يُثيبُ على الأعمالِ أوثان",25,"ن",1,0],["ثوتْ في نعيمٍ نِعْمةُ الله إذ غدتْ","وراحتْ وظَلَّتْ في ذراك استكنَّتِ",26,"ت",1,0],["ثَوَت بَينَ جُدرانٍ كَقَلبِ مُضيمِها","تَلَمَّسُ فيها مَنفَذاً فَتَخيبُ",27,"ب",1,0],["ثوروا عَلَيهِم وَاِطلُبوا اِستِقلالَكُم","وَتَشَبَّهوا بِالصِربِ وَاليونانِ",28,"ن",1,0],["ثَورٌ غَدا أُعجوبَةً","بِلِحيَةٍ مُدَوَّرَه",29,"ر",2,0],["ثَوْرَةُ الشَّرِّ وأَحْلامُ السَّلامْ","وجَمالُ النُّورْ",30,"ر",1,0],["ثوبوا إلى أنفسكم","فقد أسأتم للادب",31,"ب",1,0],["ثوروا على العادات ثورة حانق","وتمردوا حتى على الاقدار",32,"ر",1,0],["ثورة أقبلت السلمُ بها","عجبُ الرائين سحرُ السامعين",33,"ن",1,0],["ثَوابَةُ أَو مِهرانُ يَقتَضِيانِهِ ال","سُمُوَّ اِقتِضاءَ الوَعدِ مِن مُنجِزِ الوَعدِ",34,"د",1,0],["ثُؤوبُ ذي الأَثرِ إِن يُعِد صَنَعٌ","لَهُ صِقالاً يَوماً يَعُد لَهُ أُثُرُه",35,"ر",2,0],["ثَوى اِبنايَ في بَيتي مُقامٌ كِلاهُما","أَخِلَّتُهُ عَنّي بَطيءٌ ذَهابُها",36,"ب",3,0],["ثوباً تمزِّقُهُ الأناملُ رِقَّةً","ويُذيبُه الماءُ القَرَاح فيبهُجُ",37,"ج",1,0],["ثَوى بِرُزاءَ خَيرُ فَتى أُناسٍ","ثَوى بِرُزاءَ وَاِرتَحَلَ الوُفودُ",38,"د",1,1],["ثَوى مِنهُمُ في بِئرِ بَدرٍ عِصابَةٌ","ذوو نَجَداتٍ في الحُروبِ وَفي المَحلِ",39,"ل",1,0],["ثَوبُ مَن ماتَ عَلى وارِثِهِ","وَعَلى مَن ماتَ ثَوبُ مِن مَدَر",40,"ر",1,1],["ثَوبٌ خَلَعتُ العِزَّ حينَ لَبِستُهُ","إِذ كانَ إِذ ذُلُّ الصَبابَةِ يورَثُ",41,"ث",1,0],["ثَوَتِ الخُطوبُ مَخافَةً مِن بَأسِهِ","صَرعى وَذَلَّ بِها الزَمانُ الأَحنَثُ",41,"ث",1,0],["ثَوبٌ تُجَندِرُهُ الرِيا","حُ وَقَد أَضَرَّت بِالطِرازِ",42,"ز",1,0],["ثَوى في الثَرى مَن كانَ يَحيا بِهِ الثَرى","وَيَغمُرُ صَرفَ الدَهرِ نائِلُهُ الغَمرُ",43,"ر",1,0],["ثَوى بِالمَشرِقَينِ لَهُم ضَجاجٌ","أَطارَ قُلوبَ أَهلِ المَغرِبَينِ",44,"ن",1,0],["ثَوَت لِفِراقِهِ الآدابُ شُعثاً","وَجَفَّت بَعدَهُ غُدُرُ الكَلامِ",45,"م",1,0],["ثَوى مالُهُ نَهبَ المَعالي فَأَوجَبَت","عَلَيهِ زَكاةُ الجودِ ما لَيسَ واجِبا",46,"ب",2,0],["ثَوَى زمناً يشكو الجراحَ فلم تَزَلْ","تُداويه حتّى ارتدَّ يَشكوهُ جَارِحُهْ",47,"ح",2,0],["ثَوتْ تَتجرَّعُ الآلامَ شتَّى","على أيدي الدُّهاةِ الماكرينا",48,"ن",2,0],["ثَوى العَدلُ في الفاروقِ وَاِنجابَ ظِلُّهُ","غَداةَ اِنطَوَت أَعلامُهُ وَهيَ تَخفَقُ",49,"ق",1,0],["ثَوَت أُمَمُ الإِسلامِ مِن بَعدِما مَضى","تُراعُ بِأَهوالِ الخُطوبِ وَتُصعَقُ",49,"ق",1,0],["ثَوى عاثِرَ الآمالِ يونِسُهُ الأَسى","وَتُوحِشُهُ أَوطارُهُ وَمَآرِبُه",50,"ب",2,0],["ثَوى فيهِ أَقوامٌ مَلَلنا ثَواءَهم","وَيا رُبَّ ثاوٍ لا يُملُّ ثَواؤُهُ",51,"ا",3,0],["ثَوَوْا في الأرضِ عُمَّالاً عليها","يُؤَدُّونَ الإتاوةَ والنِّصابا",52,"ب",2,0],["ثُوبوا جُموعَ المشركينَ فإنّما","غَرَّتكمُ الأوثانُ والأنصابُ",53,"ب",1,0],["ثَورَةُ الغاضب للحَقِّ تُرى","هَذِهِ أَم شغبٌ مِن وُكَّلِ",54,"ل",1,0],["ثَوانِيَ لِلأَعناقِ يَندُبنَ ما خَلا","بِيَومِ اِختِلافٍ مِن مُقيمٍ وَظاعِنِ",55,"ن",1,0],["ثَوى جَسَدي وَشيَّعهُم فُؤادي","وَعَيني ما تَجِفُّ لَهُم غِزارا",56,"ر",2,0],["ثَوَت تَحتَ لَيلِ القارِ خَمسينَ حِجَّةً","تَرُدُّ مُهوراً غالِياتٍ وَخُطّابا",57,"ب",2,0],["ثَوَتْ مُضَرُ الحمراءُ تحتَ طِرافِها","وقالتْ نِزارٌ يا ربيعةُ ألجِمي",58,"م",2,1],["ثَوَى بكَ عز المُلكِ فيهم ولم تَزَلْ","وأنتَ لهُ العِلْقُ النفيسُ ومَعْلَقُه",59,"ق",2,0],["ثوروا إليه ونادوا","إنّ الصلاةَ جماعه",60,"ع",2,0],["ثَوبِيَ مُحتاجٌ إِلى غاسِلٍ","وَلَيتَ قَلبي مِثلَهُ في النَقاء",61,"ق",3,0],["ثَوانِيَ ضَيفٌ فَلَم أَقرِهِ","أَوائِلَ مِن عَزمَتي أَو ثَواني",62,"ن",2,0],["ثورةٌ في الجحيم أرجفت العر","شَ وكادت منها السماءُ تمور",63,"ر",1,0],["ثوبوا إلى العلم إن العلم مكرمة","وَفي تلقيه لا يأخذكم الضجرُ",64,"ر",1,1],["ثَوَوا في الثَرى مِن بَعدِما سُربِلوا العُلا","وَمِن بَعدِما سُمّوا نُجومَ المَحافِلِ",65,"ل",1,0],["ثوى وساق نجب الصّحاب","بورك في البحر وفي السّحابِ",66,"ب",1,0],["ثَوَتْ فِي ضَمِيرِ الدَّهْرِ والْجَوُّ ظُلْمَةٌ","بِلا كَوْكَبٍ وَالأَرْضُ تَسْبَحُ في غَمْرِ",67,"ر",1,0],["ثَوَى بُرْهَةً في الأَرْضِ حَتى إِذا قَضَى","لُبانَتَهُ مِنْهَا دَعَتْهُ سَمَاؤُهُ",68,"ا",3,0],["ثَوَى المَلِيكُ القُطْبُ فِي حِينِ لاَ","رَبْعٌ خَلاَ مِنْهُ وَلاَ قُطْرُ",69,"ر",1,0],["َّثونا عن الحقوق فلمّا كبَّر","النصرُ ، أعوزتْنا التراجم",70,"م",1,0],["ثَوى عَلى جَمرِ الغَضا من فراقكُم","فَهَل مِن خَيالٍ عَن غَرامي باحِثِ",71,"ث",1,0],["ثَوابُ اللَهِ أَعظَمُ لِلمُرَبّي","فَصَبرٌ إِن أَفاتَ فَقدَ أَعاضا",72,"ض",2,0],["ثَوبُ السُرورِ سَلَبتَني","وَجَعَلتَ أَحزاني لِباسي",73,"س",2,0],["ثَوَيت في الطَيِّبينِ دوني","فَما لِمَثوايَ في الخباثِ",74,"ث",1,0],["ثوبي بالٍ وَلا أُبالي","في جُدَدٍ كُنتُ أَو رَثاثِ",74,"ث",1,0],["ثوى عَبد الغَني هَوىً بِقَلبي","فَلَيسَ وَإِن نَأى عَنّي بِنائي",75,"ا",3,0],["ثوى اليومَ في هذي الحفيرة عالِمٌ","باسرارها . لهه بالعقل ناشد",76,"د",1,0],["ثوَى اليومَ في هذي الحفيرة شاعرٌ","على الظلم محتجٌّ عن العدل ذائد",76,"د",1,0],["ثورته لاجت تشعل ألفين طاقه","ماهيب شبّة قاز في جمر دوّه",77,"و",2,0],["ثوتِ النفسُ في الحمولِ لديها","وتولَّى بالجِسْمِ منّي صَح