{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[47,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[47,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[63,"أعن الأهلة في الدياجر","https://www.aldiwan.net/poem51676.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[47,"زَعَمَ الغُرَابُ مُنَبّىءُ الأنْبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=32958",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[264,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem35511.html","البسيط"],[385,"أهدى السرور إلى الكئيب","https://www.aldiwan.net/poem48810.html","مجزوء الكامل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69370","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106976","الرجز"],[4767,"اختفاء المختار","https://www.poetsgate.com/ViewPoem.aspx?id=187661",""],[4767,"الحَجْر","https://www.poetsgate.com/ViewPoem.aspx?id=211043",""],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[5121,"نُزْهَة","https://www.poetsgate.com/ViewPoem.aspx?id=49545",""],[5721,"الرقص على حبال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214687",""],[5956,"سلام بعد الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182523",""]],"verses":[["حَتّى أَخَذتَ عَلَيهِم حَتفَ أَنفُسِهِم","ما أَظلَموا بِبُروقِ العارِضِ الهَطِلِ",0,"ل",1,0],["حَتّى أَخَذنا ما أَرَدنا مِنها","ثُمَّ اِنصَرَفنا راغِبينَ عَنها",1,"ه",2,0],["حَتّى أَخَذتَ بِنَصلِ سَيفِكَ عَنوَةً","مِنهُ الَّذي أَعيا عَلى الخُلَفاءِ",2,"ا",2,0],["حَتّى أُخالَ مِنَ الصَبابَةِ بارِئاً","خَلواً وَإِن كُنتُ المُعَنّى الواجِدا",3,"د",2,0],["حتَّى أخذْنَ من المنا","طقِ للذي تحوي المآزر",4,"ر",1,0],["حتى أخو الحرمان في حُبِّهِ","كأنما أنت الحبيبُ الضنينْ",5,"ن",1,0],["حَتى أخذْتَ بنصْلِ سيْفكَ عَنوَةً،","مِنْهُ الّذي أعْيا عَلى الحلفاء",6,"ا",2,0],["حتى أخال بأني في بلهنيةٍ","وأن عيني لم يدمع لها شان",7,"ن",1,0],["حتّى أُخيّل أنّي شاربٌ ثملٌ","أتيه مثلك في دلٍّ وفي خفر",8,"ر",1,0],["حَتّى اِختَفى فَكَأَنَّهُ","شَكَ بِخاطر مُستَريب",9,"ب",1,0],["حتى اخذت بينهم قراري","كنا تساءلنا عن الديار",10,"ر",1,0],["حتى أخذت عليها الجَوَّ والفَلَكا","بطامحٍ فاتَ أسبابَ السُّها دَركا",11,"ك",2,0],["حَتّى أَخَذتُ أَماناً مِن مَكارِمِهِ","أَن لا يُقَلقِلَ في الآفاقِ أَفراسي",12,"س",2,0],["حتى اختلست رشفة","من ريقها المثلج",13,"ج",1,0],["حتى اختفى عمَّن يجالِسُهم وعن","كل الزبائن دونما إخطار",14,"ر",1,0],["حتى اختَفتْ في صدرهِ","والصدر أصبح مَحجَرا",15,"ر",2,0],["حتى اختفوا، وقد بدا لدونهم","فودُ العملّسْ ثم فود السّعل",16,"ل",1,0],["حَتَّى اخْتَبَأْتُ بِلاَ حِسٍّ يُسَايِرُنِي","فَالطَّيْرُ غَابَتْ وَطَارَتْ فِي تَجَلِّيِهَا",17,"ي",3,0],["حَتَّى أُخَلِّصُ قَلْبِي مِنْ مَواجِعِهِ","إِذَا نَفَثْتُ بِهِ مَا كَنَّ مِنْ ضَجَرِ",18,"ر",1,0],["حتى أخفف بعض ما في خافقي","وتعيش مسعودا بما لك داما",19,"م",2,0]]}