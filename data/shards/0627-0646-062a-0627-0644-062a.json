e.com/ViewPoem.aspx?id=182266",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[5956,"أبشِرْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=182324",""],[6019,"يوم اللغة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=201467",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6124,"عِِشرُونَ عَاماً","https://www.poetsgate.com/ViewPoem.aspx?id=103198",""],[6125,"في ضَيِّ عينيكِ القصيدُ تَبَعثَرا","https://www.poetsgate.com/ViewPoem.aspx?id=210971",""],[6152,"متناقض في حبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213343",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6213,"نغم المذاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85455&r=&rc=90",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""],[6233,"عيناكِ تعلنان هزيمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82633&r=&rc=32",""],[6239,"من خلف غبار الوهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75991&r=&rc=39",""],[6247,"بشراكِ أمَّ المؤمنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80290&r=&rc=29",""],[6355,"الصمت أبلغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66621&r=&rc=81",""]],"verses":[["أَنتِ الَّتي وَكَّلتِ عَي","نِيَ بالسُهادِ وَبِالبُكاءِ",0,"ا",2,0],["أنت التي أنجبتهم وجعلتهم","في مسلك لسعودهم مسلوك",1,"ك",1,0],["أنت التي فيأت أجمل زهرةٍ","ملأت عيون الطهر في ناديك",1,"ك",1,0],["أنت التي أيدت بيتاً باذخاً","كان البناة له عماد ملوك",1,"ك",1,0],["أَنتِ الَّتي تُنسي الحَوائِجَ أَهلَها","وَأَخا البَيانِ بَيانَهُ المَعهودا",2,"د",2,0],["أَنتِ الَّتي اِتَّخَذَ الجَمالَ لِعِزِّهِ","مِن مَظهَرٍ وَلِسِرِّهِ مِن مَوضِعِ",3,"ع",1,0],["أَنتِ الَّتي يَحمي وَيَمنَعُ عِرضَها","سَيفُ الشَريفِ وَخِنجَرُ الصُعلوكِ",4,"ك",1,0],["أنتِ التي بعثت إليَّ خيالها","يوماً يلوم على قليلِ نعاسِ",5,"س",1,1],["أنتِ التي ما فات عِلمَكِ حادثٌ","في الغابرينَ ولن يكونَ فَواتُ",6,"ت",1,0],["أَنتِ الَّتي قَد سِمتِهِ","بِبَلِيَّةٍ وَضناً وَكَربِ",7,"ب",1,0],["أَنتِ الَّتي تَشتَفي عَيني بِرُؤيَتِها","وَهُنَّ عِندي كَماءٍ غَيرَ مَشروبِ",8,"ب",1,0],["أنتِ التي أقمت مر","فوعَ البناء مِن هَبَا",9,"ب",2,0],["أنتِ التي علَّمتِني معنى الحيا","ةِ حبيبةً ونجيَّةً وصديقا",10,"ق",2,0],["أَنتِ الَّتِي وَطَّدْتِ بَيْتاّ بَاذِخاً","كَانَ البُنَاةُ لَهُ عِمَادَ مُلُوكِ",11,"ك",1,0],["أنت التي أججت أشواقه","أنت التي لوعته في صباهْ",12,"ا",2,0],["أنت التي نَبَّهْتِ أَه","لَ الكهفِ من طُولِ الرقود",13,"د",1,0],["أنْت التي أَشْعَلْتِ كلَّ","عَزيمَة في بورسعيد",13,"د",1,0],["أَنتِ الَّتي جَدَّدَ إِحسانُها","أُنساً لِرَبعِ الكَرَمِ الموحِشِ",14,"ش",1,0],["أنتِ التي لم تدَع في مُهجَتي رَمقاً","وليسَ بابُ الرّضا يوماً بمفتوح",15,"ح",1,0],["أنتِ التي طلعت عذراءَ طاهرةً","زهراءَ سافرةً ما بين أحلاك",16,"ك",1,0],["أنت التي خيرتني بين جنّته","وبين نيرانِه فاخترت نيراني",17,"ن",2,0],["أنت التي ورَدَ الإلهُ مؤنَّساً","منها وفيها شانُها يتعظم",18,"م",1,0],["أنتِ التي موضوع كل محبةٍ","يا ليتني في حبها محمول",19,"ل",1,0],["أَنتِ التي هي قُدسُ القُدسِ مَقْدسُها","مِنها نَنال سِعاداتِ الأَخِصّاءِ",20,"ا",2,0],["أنتِ التي لَولاَه كُنتِ شَريدَةً","وَهوَ الَّذي لم ينشَغل لَولاَكِ",21,"ك",1,0],["أَنت الَّتي لوْلاَكَ ما","غلَبتْ مَلاَئِكَتي لِجِنِّي",22,"ن",2,0],["أنتِ التي شَغَفَت قلب المحبّ بها","على السماع فكانت عنهُ لم تَغِبِ",23,"ب",1,0],["أنتِ التي شرَّفتِ ربعاً ما حِلاً","فغدا خصيباً بالسرور مُنَعَمَّا",24,"م",2,0],["أنتِ التي غادرتِني","غرضاً لأحداثِ الخُطوبِ",25,"ب",1,0],["أنت التي أودى غرا","مك بالأكاسر والقياصر",26,"ر",1,0],["أنت التي آخاك منذ مناوس","قلب الشجاع وحجة السفاك",27,"ك",1,0],["أنت التي قد نظمته درراً","فكان من درك الذي نظما",28,"م",2,0],["أنت التي كان قلب الصب يغلبها","بالصبر لكن جفاه الصبر فانغلبا",29,"ب",2,0],["أنت التي علمتني سرف الهوى","إذا أسلمتك يد الشباب زمامي",30,"م",2,0],["أنتِ التي ملكت قلبي بعفَّتها","فإن بعدت فما في العيش من أرب",31,"ب",1,0],["أنتِ التي عَوَّقْتِ جَيْ","شَ الشَّيبِ عن رأسي بقلبي",32,"ب",2,0],["أنتِ الّتي أهملتُها وهجرتُها","ونأيتُ عنها أنشُدُ الألقابا",33,"ب",2,0],["انت التي كتب الله الجمال لها","بين العذارى وكل اللطف اعطاك",34,"ك",1,0],["أَنتَ التَقِيُّ اِبنُ التَقِيِّ سَجِيَّةً","وَالأَكرَمُ اِبنُ الأَكرَمينَ الأَشهُرُ",35,"ر",1,0],["أَنتِ الَّتي ما زِلتُ فيكِ مُعَذَّباً","بِسَماعِ لَومِ العاذِلينَ عِداكِ",36,"ك",1,0],["أنت التي يا من إليها المنتهى","في الحسن أدهى منك حسناً عقلك",37,"ك",1,0],["أنتِ التي أحييت فيَّ المنى","وكنتِ لي في العيشِ ما اشتهي",38,"ي",1,0],["أَنتِ الَّتي أنقَذتني مِن غمرَةٍ","كادَت تُغادرُني طَريحَ وسادي",39,"د",2,0],["أَنتِ الَّتي أحرَزتِ كُلَّ فَضيلَةٍ","شَرَفاً بِهِ يَزدانُ صَدر النّادي",39,"د",2,0],["أنتِ التي جادت بمر","يم والمسيح المنتظر",40,"ر",1,0],["أَنتِ الَّتي قَد جاءَ في تاريخِهِ","يَختارها في كُلِ عَصرٍ يوسفُ",41,"ف",1,0],["أنت التي ملكت امري كله","وغدت بكفك ميتتي وحياتي",42,"ت",2,0],["أَنتِ الَّتي سَمتني سلم العُداة وَقَد","يُسالِمُ المَرءُ أَعداءً وَإِن وُترا",43,"ر",2,0],["أنت التي منك جدت كل امراضي","واسأل الله منها الدهر يحميك",44,"ك",1,0],["أَنتِ الَّتي أَورَثَت قَلبي مَوَدَّتُها","داءً دَخيلاً وَشَوقاً غَيرَ مُنصَرِمِ",45,"م",1,0],["أنتِ التي رُمتِ العُلى فطلبتها","بالأَكرَمَيْنِ النفسِ والأحسابِ",46,"ب",1,0],["أنتِ التي زمنَ الصبى علمتني","في حِجرِ أُمي الخيرَ والإحسانا",47,"ن",2,0],["أنت ِ التي عرّفت بالماءِ طهرتَهُ","ومن صفائك كم نقّيت ُ أنهاري",48,"ر",2,0],["أنت التي نهشت ْ فؤادي بالهوى","عجبا أإنَّ لظبيةٍ أنيابا",49,"ب",2,0],["أنتِ التي داويتِه","إذ كان دونكِ يمرَض",50,"ض",1,0],["أنتِ التي أرغبها فاعلَمي","إني بما أرغبهُ مُتعَب",51,"ب",1,0],["أنتِ التي أمرها في العاشقين على","حكم المحبة قد أمضته عيناكِ",52,"ك",1,0],["أنتِ التي تختالُ فيها أحرفي","وبها فؤادي كلّ حين يحتفي",53,"ي",1,1],["انت التي غمر الضمائر حبها","فلها التليد من الهوى والطارف",54,"ف",1,0],["أنت التي عمَّا أكابد في الهوى","سببٌ وعما حلَّ بي المسئول",55,"ل",1,0],["أنت التوازن في صوتٍ يهدهدني","فإن تفارق غدوت الفقدَ مرتسما",56,"م",2,0],["أنتَ التولُّه والتدلُّه والمنى","والمبتدا والمنتهى والبلْسمُ",57,"م"