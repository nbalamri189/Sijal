{"poems":[[74,"يا رب ضيفان قوم جلد هامته","https://www.aldiwan.net/poem20023.html","البسيط"],[91,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[113,"يا رب بدري غاب عن طرفي وفي","https://www.aldiwan.net/poem16543.html","الكامل"],[385,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[396,"يا أرحم الراحمين يا أرحم الراحمين","https://www.aldiwan.net/poem54481.html","عموديه"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112746","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128709","السريع"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33867","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77347","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103466","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133260","الكامل"],[4859,"وتنوّعت أوجاعنا والصمت واحد!","https://www.poetsgate.com/ViewPoem.aspx?id=208549",""],[4929,"أزمة الأفراح في بلاد الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=199280",""],[5121,"يا نجماً","https://www.poetsgate.com/ViewPoem.aspx?id=34104",""],[5818,"ضاقت بي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=196975",""],[5956,"لله أشكو ذلتي وضلالي","https://www.poetsgate.com/ViewPoem.aspx?id=192524",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""]],"verses":[["يا رُب ضيفان قوم جلد هامته","جلد على الطارق الطاري من الأدم",0,"م",1,1],["يا ربّ ضاع الصدق بين سراتنا","يا رب عم الزُّور والبُهتان",1,"ن",1,0],["يا ربِّ ضِقنا بالذي نحملُ","فحسبُنا آلامُنا في الحياهْ",2,"ه",1,0],["يا رَب ضَيف الطَيف زارَ وَلَم يَعُد","فَمَتى إِلى دار المُتَيم يقرب",3,"ب",1,0],["يا رَب ضقت بِغُربَتي","ذرعاً وَبِالكَرب المُتاح",4,"ح",1,0],["يارب ضاق الخناق","من فعل مالا يطاق",5,"ق",1,0],["يا رب ضاق العبد فارحم سيدي","وأجره وادركه بأشرف نجدة",6,"ه",1,0],["يا رب ضيف نازل في حمى","نبيّك المختار يبغى قراه",7,"ا",2,0],["يا رُبَّ ضَخمٍ مِنَ الأَبطالِ جَدَّ لَهُ","كَأَنَّهُ وَهوَ مُلقىً تَحتَهُ جَبَلُ",8,"ل",1,0],["يا رَبِّ ضَيفُك في جَوفِ التُرابِ وَفي","هَولِ الحِسابِ وَفي حشري وَميزاني",9,"ن",2,0],["يا رُبَّ ضحضاحٍ قَريب المشرَعِ","مُطَّرِدٍ مثل السُيوفِ اللُمَّعِ",10,"ع",1,1],["يا رب ضاعف أجره","وأدم بفضلك نصره",11,"ه",1,0],["ياربّ ضاق فضاؤُنا وتمزقت","أحلامُنا ومَدى المُنى صلبٌ وجامد",12,"د",1,1],["يارَبُّ ضاقتْ بنا الدنيا بمارَحُبَتْ","ولم يَعُدْ ملجأٌ إلاكَ مقصودُ",13,"د",1,0],["يا ربّ ضيف ٍلملمَ الوردَ الندي","قد قال شهدًا ساحَ من أندائهِ",14,"ا",3,0],["يا ربّ ضاقت بي الدنيا بما رحبتْ","أنّى اتجهت أرى دمعاً وأحزانا",15,"ن",2,0],["يا رب ضعني في حنانك دائماً","لولاك أصبح دون أي جمالِ..",16,"ل",1,0],["يا ربُّ ضاقتْ، وآذى ضيقُها الرَّحِبا","ترنو إليك، وما في أفقها نَضبا",17,"ب",2,1]]}