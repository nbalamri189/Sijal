{"poems":[[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[88,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[72,"ما لي نديم سوى ورقاء ساجعة","https://www.aldiwan.net/poem18523.html","البسيط"],[89,"لقد يرتقي في الجمع فرد ذرى المجد","https://www.aldiwan.net/poem44863.html","الطويل"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[45,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[45,"لعمرك ما أبو فهم لفهم","https://www.aldiwan.net/poem66641.html","الوافر"],[61,"إلمامها أهدى إلى الصب لمم","https://www.aldiwan.net/poem51439.html","المنسرح"],[2,"أمن آل ليلى عرفت الطلولا","https://www.aldiwan.net/poem25046.html","المتقارب"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[50,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[46,"عظيم لعمري أن يلم عظيم","https://www.aldiwan.net/poem23645.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[76,"إذا أدارت بنانه قلما","https://www.aldiwan.net/poem38995.html","المنسرح"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[45,"أمِنْكَ تأوُّبُ الطّيفِ الطّرُوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31688",""],[2,"أمِنْ آلِ لَيلى عَرَفْتَ الطُّلُولا","https://www.poetsgate.com/ViewPoem.aspx?id=5263",""],[136,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[161,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[170,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[186,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[199,"دار الهوى فلسلطان الظبا دول","https://www.aldiwan.net/poem51907.html","البسيط"],[212,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[236,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[283,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[283,"هات اسقني الراح في الياقوت كالذهب","https://www.aldiwan.net/poem32872.html","البسيط"],[365,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[403,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[404,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[410,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[417,"يا معشر السادة الأشراف لا برحت","https://www.aldiwan.net/poem53851.html","البسيط"],[433,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[438,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[459,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[462,"بقيت لكل مكرمة وبأس","https://www.aldiwan.net/poem16169.html","الوافر"],[465,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[469,"أيا من لا أمل له ارتشافا","https://www.aldiwan.net/poem59874.html","الوافر"],[494,"بالقفص للقصف منزل كثب","https://www.aldiwan.net/poem67420.html","المنسرح"],[552,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[556,"ألا أبلغا سعد بن ليث وجندعاً","https://www.aldiwan.net/poem1921.html","الطويل"]],"verses":[["إِذا أَدنَيتُ رِجلي مِن ثَراها","فَزِعتُ بِها إِلى قَتَدِ البَعيرِ",0,"ر",1,0],["إِذا اِدُّرِعَت تَجَنَّبَتِ المَواضي","مَعاجِمَها وَقَهقَهَتِ الكِعابُ",1,"ب",1,0],["إذا ادَّرَعَ الظَّلْماءَ نمَّ سَناهُما","عَليهِ فلَمْ يُؤْمَنْ رَقيبٌ وغَيْرانُ",2,"ن",1,0],["إِذا أَدبَرَت خِلتَها دِعصَةً","وَتُقبِلُ كَالظَبيِ تِمثالُها",3,"ل",3,0],["إِذا أُدلِجوا لَيلَةً وَالرِكا","بُ خوصٌ تَخَضخَضَ أَشوالُها",3,"ل",3,0],["إِذا اَدرَؤوا مِنهُمُ بِقِردٍ رَمَيتَهُ","بِموهِيَةٍ صُمَّ العِظامِ العَوارِقِ",4,"ق",1,0],["إذا أدرك المجد المؤثّل معشر","أُحاد فأنّا نحن ندركه مثنى",5,"ن",2,0],["إِذا ادلَمَّست ظَلمَاءُ أمرَينِ جِندِسٌ","فَبَدرٌ لَهُم فِيهَا مُضِيءٌ وكَوكَبُ",6,"ب",1,0],["إِذا اِدلَهَمَّ أَو أَضاءَ بارِقُه","وَهَدَرَت عَلى الثَرى شَقاشِقُه",7,"ق",2,0],["إذا أدار ادكارَ الوصلِ لي قدحاً","من أحمرِ الدمع غناني على قدحي",8,"ي",1,0],["اذا آده امر تقوى بشعبه","كما يتقوى قائد الجند بالجند",9,"د",1,0],["إِذا ادَّرَع الليلَ البهيمَ تفرَّجتْ","غياهبُهُ عن أبيضِ الوجهِ باسمِ",10,"م",1,0],["إِذا آدَ البَلاءُ تَحَمَّلاهُ","عَلى دَفَّي مُوَقَّعَةٍ رَكوبِ",11,"ب",1,0],["إِذا اِدَّلَجَت لِبَيعَتِها تَوَخَّت","طَريقاً غَيرَ بيعَتِها أَثيما",12,"م",2,0],["إذا ادلهمَّ ابتسمَتْ لشائمٍ","أقطارُه فاختلَفتْ منه الشِّيَمْ",13,"م",1,0],["إِذا أَدلَجوا لِحِوالِ الغِوارِ","لَم تُلفَ في القَومِ نِكساً ضَئيلا",14,"ل",2,0],["إِذا اِدَّعَوا جاءَتِ الدُنيا مُصَدِّقَةً","وَإِن دَعَوا قالَتِ الأَيّامُ آمينا",15,"ن",2,0],["إِذا أَدرَكَت خِلّاً مِنَ الدهرِ فاقَةٌ","فما بال جَدْوَى راحتي لا تُدارِكُه",16,"ك",2,0],["إِذا أُديرَ سَناها في الدّجى غَمَسَتْ","دُهْمَ الحنادس في التحجيل والغَررِ",17,"ر",1,0],["إِذا أَدبَرَت أَثَّت وَإِن هِيَ أَقبَلَت","فَرُؤدُ الأَعالي شَختَةُ المُتَوَشَّحِ",18,"ح",1,0],["إِذا أَدبَرتِ ماتَ النا","سُ إِن قيلَ لَهُم موتوا",19,"ت",3,0],["إذا أدركَ البَيْنُ السِّماكَ ظعَنْتُمُ","وخُوضوا المَنايا والسِّماكُ مُقيمُ",20,"م",1,0],["إِذا أَدلَجَ السَعدِِيُّ أَدلَجَ سارِقاً","فَأَصبَحَ مَخطُوماً بِلُؤمٍ مُعَذَّرا",21,"ر",2,0],["إِذَا أَدلَجَ الأَزدِيُّ أَدلَجَ سارِقاً","فَأَصبَحَ مَخطُوماً بِلَومٍ مُعَذَّرا",22,"ر",2,0],["إذا أدارتْ بنانُه قلماً","لم تدرِ للشِّبهِ أيُّها القلمُ",23,"م",1,1],["إذا أَدْلَجَتْ حَتَّى تَرى الصُبحَ واصَلَتْ","أدِيمَ نَهارِ الشَّمْسِ ما لَمْ تَغَيَّبِ",24,"ب",1,0],["إذا أدباؤها انتظموا قصيدًا","فإِنك بينهم بيتُ القصيد",25,"د",1,0],["إذا ادَّرعت أُمةٌ باليقينِ","تولَّى المُهيْمِنُ إنجادها",26,"د",3,0],["إذا آدَ البَلاءُ تَحَمّلاهُ","عَل دَفّيْ مُوَقَّعَةٍ، رَكُوبِ",27,"ب",1,0],["إذا أدلجوا لحوالِ الغوا","لم تُلْفِ في القَوْمِ نِكساً ضَئيلا",28,"ل",2,0],["إذا ادلهمّت دياجي المشكلات له","رأيٌ يسهّلُ منها كلَّ ما صعبا",29,"ب",2,0],["إذا ادعى الذنب للمخطين صارمه","دعا لهم عفوه عنهم أياديه",30,"ي",2,0],["إِذا اِدَّعَوا يالَ إِبراهيمَ ظَلَّ لَهُم","يَومٌ يُشَيِّبُ مِن هامِ العِدى اللِّمَما",31,"م",2,0],["إذا ادخر المالَ الملوك فإنما","جزيلُ الثَّنا والحمدِ جُلُّ اكْتِسابه",32,"ب",2,0],["إذا أدارت ظباءُ الأنسِ أعينَها","حُمَّ الحمامُ وخام المُحْرَبُ البطل",33,"ل",1,0],["إذا آدني الدهر اللئيم بجفوة","تحوّل أهلوه على عصبة لدّ",34,"د",1,0],["إِذا اِدلَهَمَّ الخَطبُ اِمتَطوا هِمَماً","تُشرِقُ مِنها الأَوضاحُ وَالغُرَرُ",35,"ر",1,0],["إذا أدركته للمنايا قضيةٌ","قضت باستلاب للأماني مدارك",36,"ك",1,0],["إِذا اِدَّرَعَت بِمُلآءِ السَرابِ","فَوَيلٌ لِظِلمانِها أَو مَهاها",37,"ا",3,0],["إِذا أَدارَ كُمَيتَ الرَّاحِ مُبتَسِماً","أَصبى الكُماةَ رِجالَ الحَربِ وَهوَ صَبي",38,"ب",2,0],["إذا أُديرَتْ على الأسماعِ مالَ لها","عِطْفُ الكريمِ كمَيْلِ الشّاربِ الثَّمِل",39,"ل",1,0],["إذا أَدَارتْ من الوصالِ كؤوساً","أسكرتنا بهنّ عَلاًّ ونَهْلاَ",40,"ل",2,0],["إذا أدركت فيها مسرة ساعة","أتتك إساءات تنسيك بالتي",41,"ي",1,0],["إذا أدْمَتْ قَوارِصُهُم فؤادي","كَظَمتُ على أَذَاهم وانطويْتُ",42,"ت",1,0],["إذا ادّعى الشرف السامي تفرُّدَكم","في المجد أظهر في دعواه برهانا",43,"ن",2,0],["إذا ادّخر المالَ الأنامُ أفادَه","جوادٌ يَرى الإسعافَ خيرَ ادّخارِه",44,"ر",2,0],["إذا ادخر المال البخيل فإنما","ذخيرته من كل صيبٍ معظم",45,"م",1,0],["إذا ادلهمَّ الظلام أمسى","لها سليطانِ يوقَدانِ",46,"ن",1,0],["إذا ادّرعوا الرَّقْمَ والعبقرِيَّ","سطَوا بالترائك والأدرعِ",47,"ع",1,0],["إذا ادرعتَ في الدجى فقَبَسٌ","وإن توسّدتَ الثرى فعضُدُ",48,"د",1,0],["إذا أدْركْتَ من شَهرٍ هِلالاً","أهابَ بكض السُّعودُ إلى هِلالِ",49,"ل",1,0],["إذا أدلج العافون في ضوء نارهم","سروا من هزيع الليل في لاحبٍ رحب",50,"ب",1,0],["إِذا اِدَّرَعَت زُجاجاتُها سَناها","تَوَهَّمَهُ النَديمُ لَهُ غِلافا",51,"ف",2,0],["إِذا اِدَّعاهُ اللَجينُ أَكذَبَهُ","بِالراحِ في صَبغِ جِسمِهِ الذَهَبُ",52,"ب",1,0],["إِذا اِدَّعى ما شاء من","فَضيلةٍ فما ظَلَمْ",53,"م",1,0],["إِذا أَدرَكَت أولاهُم أُخرَياتُهُم","حَنَوتُ لَهُم بِالسَندَرِيِّ المُوَتَّرِ",54,"ر",1,0]]}