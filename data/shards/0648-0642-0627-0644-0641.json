{"poems":[[74,"وقال فكر في حديث الوفا","https://www.aldiwan.net/poem19371.html","السريع"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55076","المنسرح"],[102,"ليلة","https://www.poetsgate.com/ViewPoem.aspx?id=50184",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[119,"هل هداك الله ففاضت عيوننا","https://www.aldiwan.net/poem41255.html","عموديه"],[139,"سخا بفرائد الأفراح دهري","https://www.aldiwan.net/poem49121.html","الوافر"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[164,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[534,"إن امرءا عادى إمام الهدى","https://www.aldiwan.net/poem37476.html","السريع"],[556,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66735","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66817","الوافر"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109255","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101421","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28480","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137377",""],[2693,"","https://poetry.dctabudhabi.ae/diwan/poem/100550","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65989","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65946","الوافر"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146379","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202982","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130066","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203183","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135254","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103023","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103024","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103022","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58133","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52159","البسيط"],[4935,"لذى العلى الصديق يحيي المجتبي","https://www.poetsgate.com/ViewPoem.aspx?id=129507",""],[5005,"حرفٌ في مهبِّ الريح..","https://www.poetsgate.com/ViewPoem.aspx?id=189357",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["وقالَ فكِّر في حديث الوفا","وخلني من لفظك المنتقى",0,"ق",2,1],["وقال فقال الحق دافع لومه","ببيّنةٍ إذْ لم تزلْ تتقوّلُ",1,"ل",1,0],["وَقَالَ فِي النَّقْلِ مَنْ يُنَادِمُنَا","مَنْ كَنِقُولاَ فِي الخَلقِ وَالخُلُقِ",2,"ق",1,0],["وقال : فتى تاهت سفينة عمره","وغابت وراء اليأس عنه المرافيء",3,"ي",2,0],["وقال : فتاتي فيك تورق فتنة","ويختال فجر كالطفوله هانيء",3,"ي",2,0],["وَقَالَ فَتًى شَأُنُ الرَّحِيقِ يُعَتَّقُ","وَلَكِنَّ تَعْتِيقَ العَفَافِ مِنَ الخَبْلِ",4,"ل",1,0],["وقال فلان قد رأيتك ماشيا","فقلت رأيتك راكبا",5,"ب",2,0],["وقال فم البشارةِ حين قلنا","لهُ أرخِ حُلى تأهيلِ خيرِ",6,"ر",1,0],["وقال فإني منذ أعداد حجة","لمنتظر لقياك يا أيها البدر",7,"ر",1,0],["وقال فلا جزاه الله خيرا","زعيمهم ولا رؤى عظامه",8,"م",2,0],["وقال فقال الله لي بعد مدة","بأنك أنت الختم رب المفاخر",9,"ر",1,0],["وقال فلا يشغلك مني ولاية","وكن كل شهر طول عمر زائري",9,"ر",2,0],["وقال فؤادي ليس يعذرك الإخا","على جفوةٍ إذ ليس يعذرك الحِبُّ",10,"ب",1,0],["وقال فريق نرتضي بقضائه","ولا نرتضي المقضى اقبح خصلة",11,"ه",1,0],["وقال فريق نرتضي باضافة","اليه وما فينا فنلقى بسخطة",11,"ه",1,0],["وقال فقال فصلا في زمان","يكون العيُّ فيه من البيانِ",12,"ن",1,0],["وقال فلم تقبلْ ولكن تلوَّمَتَ","على أنه ما قال إلا لتقْبلا",13,"ل",2,0],["وقال في لهَاةِ أيّ خطرٍ","تقذِفُ بي وعَرِض ما أيِّ بلدْ",14,"د",1,0],["وقالَ فينا غيرَ ما الله ارْتَضى","لنا بِغَيْبهِ وبالوَهْمِ اشْتَفى",15,"ف",2,0],["وقال فيه الْمُصْطَفَى بُغْضُهُ","عُنْوانُ كُفْرٍ ونِفاقٍ صَريحْ",16,"ح",1,0],["وقال في مجدك إنْ كنتَ تفي","عقدتَ أنْ لا تقرضَ الشّعرَ فَحَلْ",17,"ل",1,0],["وقال في وصية الخليل","بنيه ما يذكر في التنزيل",18,"ل",1,0],["وقال فيما جاء في الأخبار","عنه له أنت قسيم النار",18,"ر",1,0],["وقال فيما جاء في الحكاية","في يوم خيبر سأعطي راية",18,"ه",1,0],["وقال في جمع من الملاء","اقول في الجد لكم برأي",18,"ي",1,0],["وقال في قاتله ما قالا","لأنه قتله ضلالا",18,"ل",2,0],["وقال في بعض الذي كان ذكر","أن عليا خير كل من غبر",18,"ر",1,0],["وقال في خُمِّ له معلِناً","ما لم يُلقّوْه بإِنكارِ",19,"ر",1,0],["وقال فلا وربِّك لا يَفيئوا","إليكَ ولا يَكونوا مؤمِنينا",20,"ن",2,0],["وَقالَ في ذا تُستَطابُ النارُ","ما لَهُمُ عَن مِثلِ ذا اِصطِبارُ",21,"ر",1,0],["وقال في قطف الزهور راحه","من فوق هاتيك الغصون الخضر",22,"ر",1,0],["وقال فياض أني قملةٌ سرحت","عليه قلت نعم والبق قد سبقا",23,"ق",2,1],["وقال فيما ابن محبوب يبدله","ولا يشاركه فيه إذا احتسبا",24,"ب",2,0],["وقالَ فَخِلْنا القَضِيبَ","يمِيلُ بِأَوراقهِ",25,"ق",2,0],["وَقالَ فُؤادي لا تُطِع مُتَجَنِّباً","فَخالَفتُهُ وَاِختَرتُ قَومي عَلى قَلبي",26,"ب",2,0],["وقال فيم اتهامي بالسلو وما","عدته نفسي يوما من أمانيها",27,"ي",3,0],["وقال في خبر كوفان في حرم","ما أمها من بغي إلا وقد قصفا",28,"ف",2,0],["وقال فتي في القوم يوماً لخاله","أنا لك عم فاسمع القول يا طسم",29,"م",1,0],["وقال فأفرجت وجلت همومي","مقالته سأبلغك المرادا",30,"د",2,0],["وقال فهمتُ دليل الخطاب","ومن عَشِقَ الدَّنَّ باس القدح",31,"ح",1,0],["وقال فلْيَكُ سمّا فيك قلت له","هذا هو السم ممزوجاً مع العسل",32,"ل",1,0],["وَقالَ في المدح من لم يُعيِه حصر","فمبلغ العلم فيه أَنه بشرُ",33,"ر",1,0],["وقال فأنصت الأقوام طرّاً","وكانَ كلامهُ الدرّ النضيدا",34,"د",2,0],["وقالَ فيما قالَ خُطّ الموتُ","على البرايا ليسَ منه فَوتُ",35,"ت",1,0],["وقال في ظهرك جاءت يدي","فقلت لا والعهد في رقبتي",36,"ي",1,0],["وقال فقرٌ راحلٌ للباديه","قال الشقا معك أكون باديه",37,"ه",1,0],["وقال في حظّه الأوفى مؤرخه","بالفتح والنصر طل عزّا سليمان",38,"ن",1,0],["وقال في شأنه الأعلى مؤرخه","بدا بعيد منىً أضحى سليمان",39,"ن",1,0],["وقال في حظك الأوفى مؤرخه","حييت بالسعد والفتح الإلهيّ",40,"ي",1,0],["وقال في حظك الأوفى مؤرخه","ملك تسربل برديه سليمان",41,"ن",1,0],["وقال في نجواه أواه لما","بكم حبونا الملك فيلا قدما",42,"م",2,0],["وقالَ فريقٌ إن جبريل خائِنٌ","فباءُوا بلعنٍ من عليكِ معظَّمِ",43,"م",1,0],["وقال في ثغره الدرُّ النضير ألاَ","يَرَى لآلئ دمعي عقدُها انتَسقا",44,"ق",2,0],["وقال في نظم التهاني أرخو","ميلاد خير مفرد لزينبا",45,"ب",2,0],["وقال في لغةٍ ما كنت أعرفها:","(قد جفَّ يا مَرْوتي في الشِّعر مَوْردُه",46,"د",2,0],["وقال فتى منهم حديث قدومه","بنغمة إشفاق ونبرةَ ساخر !",47,"ر",1,0],["وقالَ في سُخْرٍ: ألَمْ تَصْحُ مِنْ","نَوْمِكَ، واصْطَادَتْكَ وَهْمُ الشِّبَاكْ؟",48,"ك",1,0]]}