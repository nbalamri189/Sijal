الوَرى عَفيفُ المَقالِ",5,"ل",1,0],["ساهِمَ الوَجهِ لِما حَلَّ بِهِ","سادِرَ النَظرَةِ مِن وَقعِ الخَبَر",6,"ر",1,0],["سَأُهدي النَفسَ في نَفسِ الشَمالِ","فَقَد لَقِحَ التَشَوُّقُ عَن حِيالِ",7,"ل",1,1],["ساهِمُ الوَجهِ شَديدٌ أَسرُهُ","مُغبَطُ الحارِكِ مَحبوكُ الكَفَل",8,"ل",1,0],["سَأُهدي لَها في كُلِّ عامٍ قَصيدَةٍ","وَأَقعُدُ مَكفِيّاً بِيَثرِبَ مُكرَما",9,"م",2,0],["ساهر في ظلم الخ","ير لتأمين البريَّه",10,"ي",2,0],["ساهٍ وما تُتَّقَى في الرأي سَقْطتهُ","داهٍ وما يُنطوى منه على رِيبِ",11,"ب",1,0],["سأهدي إليه كل يوم قصيدةً","يَودُّ لها أن لم يلده المدبِّر",12,"ر",1,0],["ساهرٌ لا ينامُ عن حاجةِ السّا","هر حتى يذوق طعمَ المنام",13,"م",1,0],["ساهِرٌ غَيرَ أَنَّهُ","خادِرُ الروحِ وَالعِظام",14,"م",1,0],["سَأَهواكَ في الحالَينِ سُخطِكَ وَالرِضا","وَأَرضاكَ في الحُكمَينِ جورِكَ وَالعَدلِ",15,"ل",1,0],["ساهَرتُها وَالكأسُ يَسعى بِها","مَن ريقُهُ أَشهى مِنَ الكأسِ",16,"س",1,0],["سَأُهدي لِعاوي قَيسَ عَيلانَ إِذ عَوى","لِشَقوَتِهِ إِحدى الدَواهي الَّتي أُهدي",17,"د",2,0],["سأُهدي إليك نسيمَ العِتابِ","وأُضمِرُ من حَرِّ عَتْبٍ سَعِيرا",18,"ر",2,0],["سَأهُزُّ بالكِلَمِ المُهذَّبِ عِطفَه","طَرَباً وأخلُبُ لبَّه بخلابِه",19,"ب",2,0],["ساهِلِ الناسَ إِذا ما غَضِبوا","وَإِذا عَزَّ صَديقُكَ فَهُن",20,"ن",1,0],["ساهِرِ النارِ راقِدِ الجارِ رَحبِ ال","دارِ حَيِّ الأَكنافِ مَيتِ الحُقودِ",21,"د",1,0],["ساهم يلمح السحائب في الأف","قِ بعين عميقة الأغوارِ",22,"ر",1,0],["ساهر العينين موصول السهاد","ما الذي يجري لهيباً في الرماد",23,"د",1,0],["سَأَهجو الوَغدَ مُقرانَ","فَلا غَروَ وَلا بِدعا",24,"ع",2,1],["ساهَرتُهُ أَحسِبُهُ مُنتَشِياً","يَهُزُّ عِطفَيهِ هُناكَ الطَرَبُ",25,"ب",1,0],["ساهِرُ الهَمِّ وَالصَريمَةِ لا يَب","غي قَراراً وَلا يُريدُ هُجوعا",26,"ع",2,0],["ساهِرٌ في ظَلامِها أَقبس النو","رَ لِقَلبي بِلَثم خدّ وَكَفِّ",27,"ف",1,0],["سَأُهدي إِلى الأَذنابِ أَولادِ يَشكُرٍ","قَوافِيَ شِعرٍ لَيسَ يَنمي سَليمُها",28,"م",3,0],["ساهِراً هاجِراً لِنَومي حَتّى","لاحَ تَحتَ الظَلامِ فَجرٌ سَقيمُ",29,"م",1,0],["ساهِراً عُمرَ لَيلَتي وَكَأَنّي","طائِرٌ تَحتَهُ مِنَ الكورِ وَكرُ",30,"ر",1,0],["ساهرتُ أحلامَ الظلام وكلُّها","أشباحُ هجر أو طيوفُ وَداع",31,"ع",1,0],["ساهرةً تخفقُ أوراقُها","على فمي آناً وآنا يدي",32,"ي",1,0],["ساهرة وحدها تُطِلُّ","بملتقى النور والظلامِ",33,"م",1,0],["سَاهِرَةَ اللَّيْلِ عَلَى أَنَّهَا","لِمَرْقَصٍ أَوْ مَقْمَرٍ تَسْهَرُ",34,"ر",1,0],["سَأَهجُرُ طائِعاً في حُبِّ فَوزٍ","نِساءَ العالَمينَ وَلا أُبالي",35,"ل",2,0],["ساهرًا في سبيلها، متسهينًا","بالنفيسين: وقته، والمال",36,"ل",1,0],["ساهر الجرح لم ينم","كيف يغفو على الضرم",37,"م",1,1],["ساهر كالنجوم يستولد الفجر","ويومي إليه بالأجراح",38,"ح",1,0],["ساه .. في مقعده المهمل","كسؤال ينسى أن يسأل",39,"ل",1,1],["سأُهدي لعَاوِي قَيسِ عَيلانَ إذا عَوَى","لِشِقوَتِهِ إحدى الدّوَاهي التي أُهدِي",40,"د",2,0],["سأهدل كالحمائم في رياض","من الأحلام وارفة الظلال",41,"ل",1,1],["ساهر القلب إذا رامَ عُظمَى","إن كَرى النومِ للأعينِ حاصا",42,"ص",2,0],["سَأَهْبطُ من بَحرِ الليالي مذاهباً","متى قصرتْ بي في هواهُ مَذاهِبي",43,"ب",2,0],["سأهدى من التسهيد ميلاً لمقلتي","ومن صنعة الظلماء ما عشت إثمدا",44,"د",2,0],["سَاهِى الفوادِ تَمَشَّت فى مَفاصِلِهِ","صَهباءُ أَخلصَها الحانوتُ والقِيرُ",45,"ر",1,0],["ساهراً حول شاطىء الرمل وحدي","نادبا شاكيا بجنح الظلام",46,"م",1,0],["سأهدم عرش اللات قبل فراقها","على اللات والعُزّى عفاءٌ وإرغام",47,"م",1,0],["سَأهجر الأَوطانَ لا كارِهاً","لكِن لِأَسبابٍ دَعَت أَهجُرُ",48,"ر",1,0],["ساهِرٌ في كَآبَتي وَحَبيبي","بِسَلامٍ يَنام عن أَشجانِه",49,"ن",2,0],["سَأُهدي لِلأَئِمَّةِ مِن سَلامي","وَغُرِّ مَدائِحي أَزكى هَدِيِّ",50,"ي",1,0],["ساهِرُ المَعروفِ لا تَر","قُدُ في اللَزبَةِ نارُه",51,"ر",2,0],["ساهَرٌ يَنظِمُ في جي","دِ مَعاليكَ الثَناءا",52,"ا",3,0],["سأهواك جسماً طهرُه في أثامه","وروحاً ترابيا تعذّبه السما",53,"م",2,0],["ساهم النظرات ابدو شبحاً","كهلال الشك نضوا ضمنا",54,"ن",2,0],["سأَهتفُ بِالشَكوى كَما هَتفت بِها","عَلى البان في أَوراقها الورق سُجَّعا",55,"ع",2,0],["سأهتف في القيامة عند ربي","وعند الحوض في حال الزحام",56,"م",1,0],["ساهر لو عرض الغمض على","جفنه طيب الكرى ما قَبلا",57,"ل",2,0],["ساهرُ المقلة في الوجد فما","يطعم الغمض به إلاَّ قليلا",58,"ل",2,0