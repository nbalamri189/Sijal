{"poems":[[53,"ألا إنها غمر السخائم والغمر","https://www.aldiwan.net/poem30425.html","الطويل"],[55,"ألا كتبت تنهى وتأمر بالهجر","https://www.aldiwan.net/poem26313.html","الطويل"],[55,"سأهجر إلفي وهجراننا","https://www.aldiwan.net/poem26387.html","المتقارب"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[86,"ثمن المجد والمحامد غالي","https://www.aldiwan.net/poem10352.html","الخفيف"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[73,"سأهدي النفس في نفس الشمال","https://www.aldiwan.net/poem11943.html","الوافر"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[72,"لا وخمر بابليه","https://www.aldiwan.net/poem20560.html","مجزوء الرمل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"بوجه أبي إسحاق صدع كطيزه","https://www.aldiwan.net/poem64015.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"بات والكأس في الظلام","https://www.aldiwan.net/poem62746.html","عموديه"],[70,"إذا كنت مشغولا وذا يوم جمعة","https://www.aldiwan.net/poem42757.html","الطويل"],[78,"وشمعة تنفي ظلام الدجى","https://www.aldiwan.net/poem14055.html","السريع"],[28,"أتوعدني قيس ودون وعيدها","https://www.aldiwan.net/poem5046.html","الطويل"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[49,"عجبا ما ينقضي مني لمن","https://www.aldiwan.net/poem63154.html","الرمل"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[44,"سأهجو الوغد مقران","https://www.aldiwan.net/poem30023.html","الهزج"],[74,"لاعب تلك الريح ذاك اللهب","https://www.aldiwan.net/poem12840.html","الرجز"],[105,"مت لتحيا ولا تردها حياة","https://www.aldiwan.net/poem43410.html","الخفيف"],[102,"جئت تتلو علي صفحة ماض","https://www.aldiwan.net/poem33091.html","الخفيف"],[39,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[52,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12825","الوافر"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[100,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[28,"أتوعدني قيس ودون وعيدها","https://www.poetsgate.com/ViewPoem.aspx?id=21580",""],[118,"سأهدل كالحمائم في رياض","https://www.aldiwan.net/poem49286.html","الوافر"],[140,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[153,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[158,"خذا بي نحو الصوت لا تتبعا الصدى","https://www.aldiwan.net/poem58787.html","الطويل"],[179,"قد كنت أحسبنى بالبين مضطلعا","https://www.aldiwan.net/poem59041.html","البسيط"],[195,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[209,"منازل كانت جلوة العين والحشا","https://www.aldiwan.net/poem46626.html","الطويل"],[221,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[221,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[233,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[233,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[233,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[326,"بحبي بأشواقي بدمعي الذي همى","https://www.aldiwan.net/poem54998.html","الطويل"],[340,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[351,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[413,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[413,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[429,"من يكن جاهلا عطاء الله","https://www.aldiwan.net/poem12493.html","الخفيف"],[434,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[438,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[451,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[456,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"ساهرة الليل نؤوم الضحى","https://www.aldiwan.net/poem56309.html","السريع"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[477,"أبكي لفرقتهم وهم أحياء","https://www.aldiwan.net/poem37605.html","الكامل"],[513,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[556,"سلام على الإخوان في حضرة القدس","https://www.aldiwan.net/poem33548.html","الطويل"]],"verses":[["سَأَهجِرُ أَبكارَ القَوافي فَإِنَّني","أَراها عَلى الأَيّامِ تَقتَصُّ بِالغَدرِ",0,"ر",1,0],["سَأَهجُرُ كَي تَرضَي وَأَهلِكَ حَسرَةً","وَحَسبِيَ أَن تَرضَي وَيُهلِكَني هَجري",1,"ي",1,0],["سَأَهجُرُ إِلفي وهِجرانُنا","إِذا ما اِلتَقَينا صُدودُ الخُدودِ",2,"د",1,1],["سَاهِراً لَمْ يَدْرِ فِي اسْتخْ","لاصِهِ طَعْمَ اغْتِمَاض",3,"ض",1,0],["ساهِمَ الوَجهِ مِن جَديلَةَ أَو لِح","يانَ أَفنى ضِرائَهُ الإِطلاقُ",4,"ق",1,0],["ساهِدُ الرَأيِ نائِمُ الحِقدِ لاهٍ","عَن مَلاهي الوَرى عَفيفُ المَقالِ",5,"ل",1,0],["ساهِمَ الوَجهِ لِما حَلَّ بِهِ","سادِرَ النَظرَةِ مِن وَقعِ الخَبَر",6,"ر",1,0],["سَأُهدي النَفسَ في نَفسِ الشَمالِ","فَقَد لَقِحَ التَشَوُّقُ عَن حِيالِ",7,"ل",1,1],["ساهِمُ الوَجهِ شَديدٌ أَسرُهُ","مُغبَطُ الحارِكِ مَحبوكُ الكَفَل",8,"ل",1,0],["سَأُهدي لَها في كُلِّ عامٍ قَصيدَةٍ","وَأَقعُدُ مَكفِيّاً بِيَثرِبَ مُكرَما",9,"م",2,0],["ساهر في ظلم الخ","ير لتأمين البريَّه",10,"ي",2,0],["ساهٍ وما تُتَّقَى في الرأي سَقْطتهُ","داهٍ وما يُنطوى منه على رِيبِ",11,"ب",1,0],["سأهدي إليه كل يوم قصيدةً","يَودُّ لها أن لم يلده المدبِّر",12,"ر",1,0],["ساهرٌ لا ينامُ عن حاجةِ السّا","هر حتى يذوق طعمَ المنام",13,"م",1,0],["ساهِرٌ غَيرَ أَنَّهُ","خادِرُ الروحِ وَالعِظام",14,"م",1,0],["سَأَهواكَ في الحالَينِ سُخطِكَ وَالرِضا","وَأَرضاكَ في الحُكمَينِ جورِكَ وَالعَدلِ",15,"ل",1,0],["ساهَرتُها وَالكأسُ يَسعى بِها","مَن ريقُهُ أَشهى مِنَ الكأسِ",16,"س",1,0],["سَأُهدي لِعاوي قَيسَ عَيلانَ إِذ عَوى","لِشَقوَتِهِ إِحدى الدَواهي الَّتي أُهدي",17,"ي",1,0],["سأُهدي إليك نسيمَ العِتابِ","وأُضمِرُ من حَرِّ عَتْبٍ سَعِيرا",18,"ر",2,0],["سَأهُزُّ بالكِلَمِ المُهذَّبِ عِطفَه","طَرَباً وأخلُبُ لبَّه بخلابِه",19,"ب",2,0],["ساهِلِ الناسَ إِذا ما غَضِبوا","وَإِذا عَزَّ صَديقُكَ فَهُن",20,"ن",1,0],["ساهِرِ النارِ راقِدِ الجارِ رَحبِ ال","دارِ حَيِّ الأَكنافِ مَيتِ الحُقودِ",21,"د",1,0],["ساهم يلمح السحائب في الأف","قِ بعين عميقة الأغوارِ",22,"ر",1,0],["ساهر العينين موصول السهاد","ما الذي يجري لهيباً في الرماد",23,"د",1,0],["سَأَهجو الوَغدَ مُقرانَ","فَلا غَروَ وَلا بِدعا",24,"ع",2,1],["ساهَرتُهُ أَحسِبُهُ مُنتَشِياً","يَهُزُّ عِطفَيهِ هُناكَ الطَرَبُ",25,"ب",1,0],["ساهِرُ الهَمِّ وَالصَريمَةِ لا يَب","غي قَراراً وَلا يُريدُ هُجوعا",26,"ع",2,0],["ساهِرٌ في ظَلامِها أَقبس النو","رَ لِقَلبي بِلَثم خدّ وَكَفِّ",27,"ف",1,0],["سَأُهدي إِلى الأَذنابِ أَولادِ يَشكُرٍ","قَوافِيَ شِعرٍ لَيسَ يَنمي سَليمُها",28,"م",3,0],["ساهِراً هاجِراً لِنَومي حَتّى","لاحَ تَحتَ الظَلامِ فَجرٌ سَقيمُ",29,"م",1,0],["ساهِراً عُمرَ لَيلَتي وَكَأَنّي","طائِرٌ تَحتَهُ مِنَ الكورِ وَكرُ",30,"ر",1,0],["ساهرتُ أحلامَ الظلام وكلُّها","أشباحُ هجر أو طيوفُ وَداع",31,"ع",1,0],["ساهرةً تخفقُ أوراقُها","على فمي آناً وآنا يدي",32,"ي",1,0],["ساهرة وحدها تُطِلُّ","بملتقى النور والظلامِ",33,"م",1,0],["سَاهِرَةَ اللَّيْلِ عَلَى أَنَّهَا","لِمَرْقَصٍ أَوْ مَقْمَرٍ تَسْهَرُ",34,"ر",1,0],["سَأَهجُرُ طائِعاً في حُبِّ فَوزٍ","نِساءَ العالَمينَ وَلا أُبالي",35,"ي",1,0],["ساهرًا في سبيلها، متسهينًا","بالنفيسين: وقته، والمال",36,"ل",1,0],["ساهر الجرح لم ينم","كيف يغفو على الضرم",37,"م",1,1],["سأُهدي لعَاوِي قَيسِ عَيلانَ إذا عَوَى","لِشِقوَتِهِ إحدى الدّوَاهي التي أُهدِي",38,"د",2,0],["سأهدل كالحمائم في رياض","من الأحلام وارفة الظلال",39,"ل",1,1],["ساهر القلب إذا رامَ عُظمَى","إن كَرى النومِ للأعينِ حاصا",40,"ص",2,0],["سَأَهْبطُ من بَحرِ الليالي مذاهباً","متى قصرتْ بي في هواهُ مَذاهِبي",41,"ب",2,0],["سأهدى من التسهيد ميلاً لمقلتي","ومن صنعة الظلماء ما عشت إثمدا",42,"د",2,0],["سَاهِى الفوادِ تَمَشَّت فى مَفاصِلِهِ","صَهباءُ أَخلصَها الحانوتُ والقِيرُ",43,"ر",1,0],["ساهراً حول شاطىء الرمل وحدي","نادبا شاكيا بجنح الظلام",44,"م",1,0],["سأهدم عرش اللات قبل فراقها","على اللات والعُزّى عفاءٌ وإرغام",45,"م",1,0],["سَأهجر الأَوطانَ لا كارِهاً","لكِن لِأَسبابٍ دَعَت أَهجُرُ",46,"ر",1,0],["ساهِرٌ في كَآبَتي وَحَبيبي","بِسَلامٍ يَنام عن أَشجانِه",47,"ن",2,0],["سَأُهدي لِلأَئِمَّةِ مِن سَلامي","وَغُرِّ مَدائِحي أَزكى هَدِيِّ",48,"ي",1,0],["ساهِرُ المَعروفِ لا تَر","قُدُ في اللَزبَةِ نارُه",49,"ر",2,0],["ساهَرٌ يَنظِمُ في جي","دِ مَعاليكَ الثَناءا",50,"ا",3,0],["سأهواك جسماً طهرُه في أثامه","وروحاً ترابيا تعذّبه السما",51,"م",2,0],["ساهم النظرات ابدو شبحاً","كهلال الشك نضوا ضمنا",52,"ن",2,0],["سأَهتفُ بِالشَكوى كَما هَتفت بِها","عَلى البان في أَوراقها الورق سُجَّعا",53,"ع",2,0],["سأهتف في القيامة عند ربي","وعند الحوض في حال الزحام",54,"م",1,0],["ساهر لو عرض الغمض على","جفنه طيب الكرى ما قَبلا",55,"ل",2,0],["ساهرُ المقلة في الوجد فما","يطعم الغمض به إلاَّ قليلا",56,"ل",2,0],["ساهرُ الطرفِ للمكارمِ مُحتا","طٌ عليها بخاطرٍ غيرِ ساهِ",57,"ه",1,0],["ساهر في حباطة الدين حتى","لم يذق جفنه لذيذ الرقاد",58,"د",1,0],["ساه على الحادثات النازلات به","كأنه للردى لم يبر والحرض",59,"ض",1,0],["سأهرق من اسرى دمائي تحررا","وأبدلها من نخوتي الحس والدما",60,"م",2,0],["سأهجرُ دارَك لا عن قِلىً","كما يهجر المرتعَ المُربِعُ",61,"ع",1,0],["ساهمتَني يسرَك والعسرَ ترى","بخسَ العلا وغَبنَها أن أُبخَسا",62,"س",2,0],["ساهَمَ في المجد فعلَّى به","مُقادحٌ ليس له قامرُ",63,"ر",1,0],["ساهمتُهم عِبءَ المصابِ وكلُّنا","تحت التجمُّل حاملٌ صبَّارُ",64,"ر",1,0],["ساهرةُ الليلِ نؤومُ الضُّحَى","ريَّانةٌ والأرضُ تشكو الظَّما",65,"ا",1,1],["سأهدي إلى علياك كلَّ خريدةٍ","من الفضل لم تعلق بها كفُّ فارع",66,"ع",1,0],["سأهز من قومي الذين بلوتهم","ما ترتضيه الهمة القعساء",67,"ا",2,0],["ساهرته حتى جفت","أجفانه طيب الكرى",68,"ا",1,0],["سأهدم ما تبني العقول لأهلها","من الفكر في أرض الخيالات والحدسِ",69,"س",1,0]]}