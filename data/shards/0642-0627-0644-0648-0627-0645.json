{"poems":[[79,"إن كنت تنكر ما تجن ضلوعي","https://www.aldiwan.net/poem35994.html","الكامل"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[47,"قالوا مطايا التي تهوى سترتحل","https://www.aldiwan.net/poem65632.html","البسيط"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[108,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[170,"طاب العميد الكندري شمائلا","https://www.aldiwan.net/poem46881.html","الكامل"],[189,"قالوا محا الجدري بهجته","https://www.aldiwan.net/poem14119.html","أحذ الكامل"],[189,"قالوا محا حسنه تجدره","https://www.aldiwan.net/poem14620.html","المنسرح"],[190,"قالوا مللت من الحبيب","https://www.aldiwan.net/poem43195.html","مجزوء الكامل"],[371,"قالوا متى يعتب السلطان قلت إذا","https://www.aldiwan.net/poem17821.html","البسيط"],[376,"أطرق والفكرة للمطرق","https://www.aldiwan.net/poem57283.html","السريع"],[406,"الجدار الفولاذي","https://www.aldiwan.net/poem6710.html","عموديه"],[411,"قالوا مشيبك قد تبسم ضاحكا","https://www.aldiwan.net/poem49947.html","الكامل"],[435,"قالوا معذبك الذي","https://www.aldiwan.net/poem40272.html","مجزوء الكامل"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[520,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[580,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[591,"قولوا لرسامكم","https://www.aldiwan.net/poem17725.html","مجزوء الرجز"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39119","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70683","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109201","الكامل"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118419","الكامل"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198623","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83251","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111281","الكامل"],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147053","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112599","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112339","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92190","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114314","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125834","البسيط"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54379","المجتث"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139498",""],[4963,"شاعر سعودي والدواسر لابتي","https://www.poetsgate.com/ViewPoem.aspx?id=35635",""],[5296,"زعموا","https://www.poetsgate.com/ViewPoem.aspx?id=155330",""],[5732,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=177885",""],[6089,"خذْ ما تشاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=213643",""]],"verses":[["قالُوا مَتى ظعَنَ الّذينَ تخلّفوا","نارَ الجَوى بفؤادِكَ المَصْدوعِ",0,"ع",1,0],["قالوا: مَكانَكَ قد جِئنا بواحِدَةٍ","وجِئتَنا بثَلاثٍ لا تُباليها",1,"ي",3,0],["قالوا مَطايا الَّتي تَهوى سَتَرتَحِلُ","في يَومِنا أَو غَدٍ وَالبَينُ مُقتَبَلُ",2,"ل",1,1],["قَالُوا مُحَمَّدُ قُلْنَا الاسْمُ مُشْتَهِرٌ","فَرُبَّما كانَ غَيْرُ المُصْطَفَى قُصِدَا",3,"د",2,0],["قالوا ما لم يك معقولاً","فعلوا ما لم يك ينتظر",4,"ر",1,0],["قالوا مَلِلْنَا باللّسا","نِ وما الضّمِيرُ مَلالَها",5,"ل",3,0],["قالوا: معاهدةُ الفَخارِ، وقلتمو:","داءٌ عضالٌ، لا دواءٌ شاف",6,"ف",1,0],["قالوا مَحا السُّلطانُ عنْهُ لا مَحا","سِمَةَ الفحولِ وكانَ قَرْماً صائِلا",7,"ل",2,0],["قالوا مَحَا الجُدريُّ بهجتَه","قَسَما بربِّ مِنىً لقد كَذَبوا",8,"ب",3,1],["قالوا محا حُسْنَه تَجَدُّرُهُ","فقلتُ حَسْبِي ما شئتمُ قولُوا",9,"ل",3,1],["قالوا مللت من الحبي","ب عن الحبيب ولن أمّلا",10,"ل",2,1],["قالوا مَتى يَعتِبُ السُلطانُ قُلتُ إِذا","سُلِبتَ حَظَّيهِ مِن عَدل وَمِن كَرَمِ",11,"م",1,1],["قالوا مَتى تَسلو فَقُلتُ اقصِروا","فَلا مَتى إِلا مَتى نَلتَقي",12,"ق",2,0],["قالوا: منَ الفولاذِ ، قلتُ : وما الَّذي","يعني ، أمام بطولةِ الأفذاذِ ؟",13,"ذ",1,0],["قالُوا مَشيبُكَ قد تبسَّمَ ضاحِكاً","وهْوَ النَّهار أتاكَ بالأنْوارِ",14,"ر",1,1],["قالوا معذبك الذي","فتن الأهلة والغصونا",15,"ن",2,1],["قالوا مُتاجرُه رهينُ خَسارةٍ","إن صافقتْ يدُه يدي فليُغبَنِ",16,"ن",1,0],["قالوا من البحر المحيطِ تصعَّدتْ","لا بل من الفَلكِ المحيطِ تنزّلتْ",17,"ت",1,0],["قالوا مضت سنة وفيها سلوة","تنهي هموم النفس عن برحائها",18,"ا",3,0],["قالوا مُحِبَّك يا حبيبُ صَبَرْ","ما عِنْدَ قائِلِ ذا الكلامِ خبَرْ",19,"ر",1,1],["قالوا مَتى تُذِيبهُ","فَقُلْتُ حَتّى يَرْسُمُ",20,"م",1,0],["قالُوا مَحَتْ عارِضاهُ بَهْجتَهُ","فَبَدْرُ مَرآهُ لِلْغُروبِ جَنَحْ",21,"ح",1,1],["قالوا من الحرُّ المهذبَ قلتُ مَنْ","لما يَخِسْ بالعهد والميثاق",22,"ق",1,0],["قالوا مضى عيسى بأعجوباته","في قومه كذبوا بذا التجديف",23,"ف",1,1],["قالوا محمد قد زارت كتائبُه","كالأسد تزأر في أنيابها العصل",24,"ل",1,0],["قالوامتى دام القلوب بدا له","في قصرنا والمد انهما سرا",25,"ر",2,0],["قالوا محا شعرك المحبوب بالشنب","فكان مني جواب بارع الأدب",26,"ب",1,1],["قَالُوا مُشَبِّهَةٌ مَجَسِّمَةٌ فَلاَ","تَسمَع مَقَالَ مُجَسِّمٍ حَيَوَانِ",27,"ن",1,0],["قالوا مؤامَرة قُلنا مطالبَة","بِالحَق لا طلب منا إِلى الشحن",28,"ن",1,0],["قالوا محال خلق شيء مثله","والعقل بين ذاك أي بيان",29,"ن",1,0],["قالوا مدحت إناساً لا خلاق لهم","مدحاً يناسب أنواع الأزاهير",30,"ر",1,1],["قالوا معاهدة قلنا لهم كذب","وإفك مضطرب في الشر خوّان",31,"ن",1,0],["قالوا مُقِلٌّ وقالوا ذو ثراءٍ ومَن","في الناس مثلي غدا لغزاً لدى النّاسِ",32,"س",1,1],["قالوا مذاقُ الصبر مرٌّ بعدنا","كيف استطعت فقلتُ ساغ لياسي",33,"ي",1,1],["قَالُوا مَتَى لَم تَحظَ بِالأورَادِ ذَا","جَدٍّ عَدَتكَ الوَارِدَاتُ النُّزَّلُ",34,"ل",1,1],["قالوا مدينة إِتلَنتَا خرافيةٌ","فيه الجوامع إِلا الصدق والشرفُ",35,"ف",1,1],["قالوا مدام الهوى قول بموجبه","يسل قلت شبابي من يد الهرم",36,"م",1,0],["قالوا مرادك ماذا","فقلتُ أَنتم مُرادي",37,"د",2,0],["قالوا مليكٌ قلتُ ذا ملكٌ فلا","تزروا بهِ ما حازهُ زمنٌ عبر",38,"ر",1,0],["قالُوا مُحالُ الهَوى كَم ذا تُلازِمُهُ","قُلتُ اِترُكُوا عَذلي إِنَّ الهَوى دِيني",39,"ن",2,0],["قالوا محمدُ قد قضى قلنا قضى","حقا حقوقَ العلم والعلياء",40,"ا",2,1],["قالوا من انت وقلت فيصل بن جزاء","شاعر سعودي والدواسر لابتي",41,"ت",2,1],["قالوا مُناظرةٌ ويحكمُ بيننا","من يُنْصِتونَ لهذه الأبياتِ",42,"ت",1,0],["قالوا من اللي صوبك قلت عافون","قالوا عدوك قلت ياناس لا لا",43,"ل",2,0],["قالوا: مبالغةٌ، فقلت: قليلةٌ","إن قلتُ: أنت بلاغتي ولغاتي",44,"ت",2,0]]}