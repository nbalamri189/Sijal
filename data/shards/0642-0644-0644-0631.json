{"poems":[[87,"لحظها لحظها رويدا رويدا","https://www.aldiwan.net/poem7779.html","الخفيف"],[52,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[505,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[556,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132481","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127945","المديد"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105877","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121728","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66590","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66591","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""]],"verses":[["قل لراج أن يسترق يراعى","أنا لا أشترى بذا التاج قيدا",0,"د",2,0],["قُل لِرَوحِ بنِ حاتِمٍ بنِ قَبيصِ ال","مَجدُ فينا وَفيكُمُ إِعجابُ",1,"ب",1,0],["قل لركبِ الأحباب والحبُّ دينٌ","صاح إذ تجهد السرى أظعانه",2,"ن",2,0],["قل لرواةِ الشّعر جوبوا بها","فجّاً من الإحسانِ لا يُطرَقُ",3,"ق",1,0],["قل لريب الزَّمانِ كيف تراني","شاكياً بعدها وأنت تراني",4,"ن",2,0],["قل لرائى المصطفى كرما","قد رأيت الناس في رجل",5,"ل",1,0],["قُل لِرَيحانَةِ العُلا والمكارِم","والكريم النجار وابنِ الأكارم",6,"م",1,1],["قُل لِرَقيبٍ قد أتى لِصِبْيَةٍ","أرَقّ مَعْنىً من نَسِيمِ السَّحَرِ",7,"ر",1,1],["قل لرهطٍ منا عتوا واستطالوا","واساءوا ومالهم إحسان",8,"ن",1,0],["قل لرهطٍ رشحوا أنفسهم","بغية الكسب وان يمسوا عظاما",9,"م",2,0],["قُلْ لِراقِي الجُفُونِ إِنَّ لِجفْنِي","فِي بِحارِ الدُّموع سَبْحاً طَويلاَ",10,"ل",2,0],["قُلْ لِرَائِيْهِ قُلْ أَعُوذُ بِرَبِّ النَّ","اسِ هذَا الوَزِيرُ رَبُّ النَّاسِ",11,"س",1,0],["قل لروِّاد منبت الجود مهلاً","أمحل الجدبُ منه خصبَ المراعي",12,"ع",2,0]]}