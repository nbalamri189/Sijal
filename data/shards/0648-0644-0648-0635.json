{"poems":[[55,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[3,"ترى هذه ريح أرض الشربه","https://www.aldiwan.net/poem124.html",""],[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[29,"أتعرف أم أنكرت أطلال دمنة","https://www.aldiwan.net/poem5729.html","الطويل"],[53,"إذا خاب داع أو تناهى دعاؤه","https://www.aldiwan.net/poem8166.html","الطويل"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[53,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[53,"إذا جددت نعمة لامرئ","https://www.aldiwan.net/poem66732.html","المتقارب"],[87,"أبا الهول طال عليك العصر","https://www.aldiwan.net/poem63767.html","المتقارب"],[45,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[30,"تزود منها نظرة لم تدع له","https://www.aldiwan.net/poem5002.html","الطويل"],[63,"لقد سودت عرس ابن حمزة وجهه","https://www.aldiwan.net/poem51480.html","الطويل"],[82,"أحن إلى العشرين عاما وبيننا","https://www.aldiwan.net/poem31375.html","الطويل"],[107,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[83,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[77,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[48,"هو البر في بحر وإن سكن البرا","https://www.aldiwan.net/poem22605.html","الطويل"],[48,"إذا قال فيك الناس ما لا تحبه","https://www.aldiwan.net/poem23083.html","الطويل"],[48,"الموت ربع فناء لم يضع قدما","https://www.aldiwan.net/poem23085.html","البسيط"],[48,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[48,"أتت خنساء مكة كالثريا","https://www.aldiwan.net/poem23582.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[53,"أبا بكر لك المثْلُ المعلَّى","https://www.poetsgate.com/ViewPoem.aspx?id=30261",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[113,"هجوعك بعد بينهم حرام","https://www.aldiwan.net/poem16261.html","الوافر"],[133,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[146,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[154,"دموع على الخدين ترسل مزنها","https://www.aldiwan.net/poem68585.html","الطويل"],[164,"محب يمنى نفسه ويسوف","https://www.aldiwan.net/poem58925.html","الطويل"],[189,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[189,"يذم من الشعر الأبيض","https://www.aldiwan.net/poem14708.html","المتقارب"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[233,"أرى الدهر مختارا لقصدي بجوره","https://www.aldiwan.net/poem50920.html","الطويل"],[239,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[301,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[357,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[357,"على حكم الهوى أدر المداما","https://www.aldiwan.net/poem39957.html","الوافر"],[461,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[518,"يا من بليغ المعاني من عبارته","https://www.aldiwan.net/poem12044.html","البسيط"],[518,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[554,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[561,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[565,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"]],"verses":[["وَلَو صَرَّحَ بِاليَأسِ","أَبى وَجدِيَ أَن أَسلو",0,"ل",2,0],["وَلَو صَلَّتِ العُربُ يَومَ الوَغى","لِأَبطالِها كُنتُ لِلعُربِ كَعبَه",1,"ب",2,0],["وَلَو صَبا نَحوَنا مِن عُلوِ مَطلَعِهِ","بَدرُ الدُجى لَم يَكُن حاشاكِ يُصبينا",2,"ن",2,0],["وَلَو صَرَمَت حَبلي أُمامَةُ تَبتَغي","زِيادَةَ حُبٍّ لَم أَجِد ماأُزيدُها",3,"د",3,0],["ولو صِين حيٌّ عن شَكاةٍ لَكُنتَهُ","ولكن لكُلٍّ في الشَّكاة نصيبُ",4,"ب",1,0],["ولو صَيّحتُ بالجنِّ","للجَّ الجنُّ في الفرِّ",5,"ر",1,0],["ولو صمّمتَ لم يُعجزك نفعي","وأنَّى يعجزُ المرءُ الحَويل",6,"ل",1,0],["ولو صُفِّيتْ كان أصفى لها","ولكنَّ دُنيا الفتى جافيه",7,"ف",3,0],["وَلَو صُوِّروا مِن نَواحي الطِباعِ","تَوالَوا عَلَيكَ سِباغَ الصُوَر",8,"ر",1,0],["وَلَو صَدَقوا في جَدِّهِم لَحَذِرتُهُم","فَهَل فيَّ وَحدي قَولُهُم غَيرُ كاذِبِ",9,"ب",1,0],["ولو صَحَّ ما يُعزى إليه لحلَّقتْ","بأشلائه رُبْدُ النُّسورِ سِغَابَا",10,"ب",2,0],["وَلَو صاحَبَتهُ الأَنبِياءُ ذَوُو النُهى","رَأَوهُ مَعَ المُلكِ العَظيمِ المُسَوَّدا",11,"د",2,0],["ولو صدَقَتْ لم تُلْقَ ثَكْلى تَسلَّبت","مِنَ الحُزْنِ في حُمْرِ الحِلَى والغَلائلِ",12,"ل",1,0],["ولو صحّ مشيٌ نحوه لابتَدَرتُهُ","فجئتُ الصِّبا أحبو على العينِ والأنْفِ",13,"ف",1,0],["وَلَو صَنَعَت صَنيعَكِ لَم نَخُنها","وَلَم نُؤثِر مُصانَعَةَ المَوالي",14,"ل",2,0],["وَلَو صافَحَ العيدُ شَخصاً إِذَن","لَصافَحَكَ العيدُ إِذ أَقبَلا",15,"ل",2,0],["وَلِوَصيفٍ وَوَصيفٍ أَيضاً","يَدٌ فَقَد خاضَ المَنايا خَوضا",16,"ض",2,0],["وَلَو صُيِّرَ بِرجاساً","لَما أَخطَأَهُ رَشقُ",17,"ق",1,0],["ولو صالت الأسدُ الغضاب مصالَهُ","لما امتنعت منها الجيوش الجحافل",18,"ل",1,0],["وَلَو صَدَقوا ما اِنفَكَّ في شَرِّ حالَةٍ","يُعاني بِها الأَسفارَ أَشعَثَ مُغبَرّا",19,"ر",2,0],["وَلَو صِرتُ سِلكاً ما حَماني تَضاؤُلي","حِماماً تَوَخّى عامِراً وَسُلَيكا",20,"ك",2,0],["وَلَو صَفا العَقلُ أَلقى الثِقلَ حامِلُه","عَنهُ وَلَم تَرَ في الهَيجاءِ مُعتَرِكا",21,"ك",2,0],["وَلَو صُرِفَ الهُدى بِجَميلِ فِعلٍ","إِلى مُهَجٍ نَفِسنَ لِما نَفِسنَه",22,"ن",2,0],["وَلَو صَلَّت بِمَنزِلِها وَصامَت","لَأَلَفَت ماتُحاوِلُهُ لَدَيها",23,"ي",3,0],["ولو صنعاءُ كنْتَ بها لهَزّتْ","هَوَايَ إليكَ نَوقٌ أو جِمال",24,"ل",1,0],["وَلَوْ صَاحَ بِي فِي غَارَةٍ لَوَزَعْتُهَا","عَلَى مَتْنِ مَحْبُوكِ السَّرَاةِ بِمُرْهَفِ",25,"ف",1,0],["ولو صُدِعَتْ في سَفح لُبنانَ صخرةٌ","لدكَّ ذُرا الأهرامِ هذا التصدُّعُ",26,"ع",1,0],["ولو صارفتني في محبتها الدنا","رضيت بها منها وما أنا نادم",27,"م",1,0],["ولو صَحَّ من مثلٍ للدَّمارِ","ما كانَ غيرَهمُ ، والتَّوى",28,"ا",1,0],["ولو صمتَ لم يُعجزك نفعي","وأنَّى يعجزُ المرءُ الحَويل",29,"ل",1,0],["ولو صدقت فالصدق في طي كذبها","إذا عاهدت بالوعد فهو وعيد",30,"د",1,0],["وَلَو صَحب الهَوى سُمر العَوالي","لَما نَفذت وَعيرها الثَمام",31,"م",1,0],["ولو صادفَ الدَمعَ أسطولُكم","لَخِفنا من الدَمعِ أن يُغرِقَه",32,"ق",2,0],["ولَو صَدَقَ النَّاسَ في شَانِهِ","لَحَذَّرَهُم قَاعَهُ الصَّفصَفَا",33,"ف",2,0],["ولو صحا طورا لعنَّفتُه","في حبّه بيضاءَ مِكسالَهْ",34,"ل",2,0],["وَلَو صَلَحَت تيجانُهُم لَكَ زينَةً","إِذاً ما اِستَطاعَت أَن تَعَدّى المُخَلخَلا",35,"ل",2,0],["وَلَو صَدَقنا النَفسَ فيها نُزوعَها","قَصَدنا عَلى بُعدِ الديارِ رُبوعَها",36,"ه",2,0],["ولو صحْتُ صوتاً واحداً يا لأحمدٍ","لظلّتْ عليك الخيلُ والرجل توجفُ",37,"ف",1,0],["ول وُصفتَ لقُسٍّ كنتَ تُفْحِمه","ولو ذُكرتَ لعَمرٍ وكنتَ تُرْعِبه",38,"ب",2,0],["ولو صاحَب الشيبُ عصرَ الشباب","لكانت محبتُه تُمحَض",39,"ض",1,0],["وَلَو صحَّ هَذا لاِقتضى فيهِ أنّهُ","أَقلُّ الوَرى عَقلاً وأضعفُهم فكرا",40,"ر",2,0],["ولو صار حكمي في جوامع صحّتي","أَعَرْتك منها حِصّتي وحقوقي",41,"ق",2,0],["وَلَو صَبَروا ماتوا كِراماً أَعِزَّةً","وَلَكِنَّ عِندَ السوءِ خانَهُمُ الصَبرُ",42,"ر",1,0],["وَلَو صاليتَ نار الشوق أَمسى","علَى خدَّيك للدَمع اِنسجامُ",43,"م",1,0],["وَلَو صافَحت صَخراً أصمّ لَفَجّرت","يَنابيعه بِالمالِ لا الماء منصبّا",44,"ب",2,0],["وَلَو صامَ عَنهُ للدُجا تمَّ صَومهُ","وَهَل لَيسَ صَوم ثابت لمتمِّهِ",45,"م",2,0],["وَلَو صَدح الحمام أَعادَ صَدحاً","لَهُ وَأَعار مَسمعه الحماما",46,"م",2,0],["ولو صحَّ وفاء لم","يُصِبْ سيفُ وغىً قَيْنا",47,"ن",2,0],["ولو صددت عن الأيام ما عرفت","فيها حلاوة عيش من مرارته",48,"ت",2,0],["ولو صغى فكري إلى مثوبة","ومال ما نفقت من آماله",49,"ل",2,0],["ولو صدق الوشاةُ إليك عنّي","لقالوا إِنّه دَنِفٌ سقيمُ",50,"م",1,0],["ولو صدقوا ماتوا وزالت نفوسهم","ولم يبق فيهم قائل وله فكر",51,"ر",1,0],["ولو صَحَّ الكلامُ بلا بَيانٍ","بَلَغتُ من الدَّعاوي ما أريدُ",52,"د",1,0]]}