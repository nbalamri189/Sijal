{"poems":[[53,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[3,"ترى هذه ريح أرض الشربه","https://www.aldiwan.net/poem124.html",""],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[27,"أتعرف أم أنكرت أطلال دمنة","https://www.aldiwan.net/poem5729.html","الطويل"],[51,"إذا خاب داع أو تناهى دعاؤه","https://www.aldiwan.net/poem8166.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[51,"إذا جددت نعمة لامرئ","https://www.aldiwan.net/poem66732.html","المتقارب"],[85,"أبا الهول طال عليك العصر","https://www.aldiwan.net/poem63767.html","المتقارب"],[43,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[28,"تزود منها نظرة لم تدع له","https://www.aldiwan.net/poem5002.html","الطويل"],[61,"لقد سودت عرس ابن حمزة وجهه","https://www.aldiwan.net/poem51480.html","الطويل"],[80,"أحن إلى العشرين عاما وبيننا","https://www.aldiwan.net/poem31375.html","الطويل"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[46,"هو البر في بحر وإن سكن البرا","https://www.aldiwan.net/poem22605.html","الطويل"],[46,"إذا قال فيك الناس ما لا تحبه","https://www.aldiwan.net/poem23083.html","الطويل"],[46,"الموت ربع فناء لم يضع قدما","https://www.aldiwan.net/poem23085.html","البسيط"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[46,"أتت خنساء مكة كالثريا","https://www.aldiwan.net/poem23582.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[51,"أبا بكر لك المثْلُ المعلَّى","https://www.poetsgate.com/ViewPoem.aspx?id=30261",""],[110,"هجوعك بعد بينهم حرام","https://www.aldiwan.net/poem16261.html","الوافر"],[130,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[133,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[143,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[144,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[151,"دموع على الخدين ترسل مزنها","https://www.aldiwan.net/poem68585.html","الطويل"],[161,"محب يمنى نفسه ويسوف","https://www.aldiwan.net/poem58925.html","الطويل"],[186,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[186,"يذم من الشعر الأبيض","https://www.aldiwan.net/poem14708.html","المتقارب"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[230,"أرى الدهر مختارا لقصدي بجوره","https://www.aldiwan.net/poem50920.html","الطويل"],[236,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[298,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[354,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[354,"على حكم الهوى أدر المداما","https://www.aldiwan.net/poem39957.html","الوافر"],[459,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[516,"يا من بليغ المعاني من عبارته","https://www.aldiwan.net/poem12044.html","البسيط"],[516,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[552,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[559,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[563,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"]],"verses":[["وَلَو صَرَّحَ بِاليَأسِ","أَبى وَجدِيَ أَن أَسلو",0,"ل",2,0],["وَلَو صَلَّتِ العُربُ يَومَ الوَغى","لِأَبطالِها كُنتُ لِلعُربِ كَعبَه",1,"ب",2,0],["وَلَو صَبا نَحوَنا مِن عُلوِ مَطلَعِهِ","بَدرُ الدُجى لَم يَكُن حاشاكِ يُصبينا",2,"ن",2,0],["وَلَو صَرَمَت حَبلي أُمامَةُ تَبتَغي","زِيادَةَ حُبٍّ لَم أَجِد ماأُزيدُها",3,"د",3,0],["ولو صِين حيٌّ عن شَكاةٍ لَكُنتَهُ","ولكن لكُلٍّ في الشَّكاة نصيبُ",4,"ب",1,0],["ولو صَيّحتُ بالجنِّ","للجَّ الجنُّ في الفرِّ",5,"ر",1,0],["ولو صمّمتَ لم يُعجزك نفعي","وأنَّى يعجزُ المرءُ الحَويل",6,"ل",1,0],["ولو صُفِّيتْ كان أصفى لها","ولكنَّ دُنيا الفتى جافيه",7,"ف",3,0],["وَلَو صُوِّروا مِن نَواحي الطِباعِ","تَوالَوا عَلَيكَ سِباغَ الصُوَر",8,"ر",1,0],["وَلَو صَدَقوا في جَدِّهِم لَحَذِرتُهُم","فَهَل فيَّ وَحدي قَولُهُم غَيرُ كاذِبِ",9,"ب",1,0],["ولو صَحَّ ما يُعزى إليه لحلَّقتْ","بأشلائه رُبْدُ النُّسورِ سِغَابَا",10,"ب",2,0],["وَلَو صاحَبَتهُ الأَنبِياءُ ذَوُو النُهى","رَأَوهُ مَعَ المُلكِ العَظيمِ المُسَوَّدا",11,"د",2,0],["ولو صدَقَتْ لم تُلْقَ ثَكْلى تَسلَّبت","مِنَ الحُزْنِ في حُمْرِ الحِلَى والغَلائلِ",12,"ل",1,0],["ولو صحّ مشيٌ نحوه لابتَدَرتُهُ","فجئتُ الصِّبا أحبو على العينِ والأنْفِ",13,"ف",1,0],["وَلَو صَنَعَت صَنيعَكِ لَم نَخُنها","وَلَم نُؤثِر مُصانَعَةَ المَوالي",14,"ل",2,0],["وَلَو صافَحَ العيدُ شَخصاً إِذَن","لَصافَحَكَ العيدُ إِذ أَقبَلا",15,"ل",2,0],["وَلِوَصيفٍ وَوَصيفٍ أَيضاً","يَدٌ فَقَد خاضَ المَنايا خَوضا",16,"ض",2,0],["وَلَو صُيِّرَ بِرجاساً","لَما أَخطَأَهُ رَشقُ",17,"ق",1,0],["ولو صالت الأسدُ الغضاب مصالَهُ","لما امتنعت منها الجيوش الجحافل",18,"ل",1,0],["وَلَو صَدَقوا ما اِنفَكَّ في شَرِّ حالَةٍ","يُعاني بِها الأَسفارَ أَشعَثَ مُغبَرّا",19,"ر",2,0],["وَلَو صِرتُ سِلكاً ما حَماني تَضاؤُلي","حِماماً تَوَخّى عامِراً وَسُلَيكا",20,"ك",2,0],["وَلَو صَفا العَقلُ أَلقى الثِقلَ حامِلُه","عَنهُ وَلَم تَرَ في الهَيجاءِ مُعتَرِكا",21,"ك",2,0],["وَلَو صُرِفَ الهُدى بِجَميلِ فِعلٍ","إِلى مُهَجٍ نَفِسنَ لِما نَفِسنَه",22,"ن",2,0],["وَلَو صَلَّت بِمَنزِلِها وَصامَت","لَأَلَفَت ماتُحاوِلُهُ لَدَيها",23,"ي",3,0],["ولو صنعاءُ كنْتَ بها لهَزّتْ","هَوَايَ إليكَ نَوقٌ أو جِمال",24,"ل",1,0],["وَلَوْ صَاحَ بِي فِي غَارَةٍ لَوَزَعْتُهَا","عَلَى مَتْنِ مَحْبُوكِ السَّرَاةِ بِمُرْهَفِ",25,"ف",1,0],["ولو صُدِعَتْ في سَفح لُبنانَ صخرةٌ","لدكَّ ذُرا الأهرامِ هذا التصدُّعُ",26,"ع",1,0],["ولو صَحَّ من مثلٍ للدَّمارِ","ما كانَ غيرَهمُ ، والتَّوى",27,"ا",1,0],["ولو صمتَ لم يُعجزك نفعي","وأنَّى يعجزُ المرءُ الحَويل",28,"ل",1,0],["وَلَو صَحب الهَوى سُمر العَوالي","لَما نَفذت وَعيرها الثَمام",29,"م",1,0],["ولو صادفَ الدَمعَ أسطولُكم","لَخِفنا من الدَمعِ أن يُغرِقَه",30,"ق",2,0],["ولَو صَدَقَ النَّاسَ في شَانِهِ","لَحَذَّرَهُم قَاعَهُ الصَّفصَفَا",31,"ف",2,0],["ولو صحا طورا لعنَّفتُه","في حبّه بيضاءَ مِكسالَهْ",32,"ل",2,0],["وَلَو صَلَحَت تيجانُهُم لَكَ زينَةً","إِذاً ما اِستَطاعَت أَن تَعَدّى المُخَلخَلا",33,"ل",2,0],["وَلَو صَدَقنا النَفسَ فيها نُزوعَها","قَصَدنا عَلى بُعدِ الديارِ رُبوعَها",34,"ه",2,0],["ولو صحْتُ صوتاً واحداً يا لأحمدٍ","لظلّتْ عليك الخيلُ والرجل توجفُ",35,"ف",1,0],["ول وُصفتَ لقُسٍّ كنتَ تُفْحِمه","ولو ذُكرتَ لعَمرٍ وكنتَ تُرْعِبه",36,"ب",2,0],["ولو صاحَب الشيبُ عصرَ الشباب","لكانت محبتُه تُمحَض",37,"ض",1,0],["وَلَو صحَّ هَذا لاِقتضى فيهِ أنّهُ","أَقلُّ الوَرى عَقلاً وأضعفُهم فكرا",38,"ر",2,0],["ولو صار حكمي في جوامع صحّتي","أَعَرْتك منها حِصّتي وحقوقي",39,"ق",2,0],["وَلَو صَبَروا ماتوا كِراماً أَعِزَّةً","وَلَكِنَّ عِندَ السوءِ خانَهُمُ الصَبرُ",40,"ر",1,0],["وَلَو صاليتَ نار الشوق أَمسى","علَى خدَّيك للدَمع اِنسجامُ",41,"م",1,0],["وَلَو صافَحت صَخراً أصمّ لَفَجّرت","يَنابيعه بِالمالِ لا الماء منصبّا",42,"ب",2,0],["وَلَو صامَ عَنهُ للدُجا تمَّ صَومهُ","وَهَل لَيسَ صَوم ثابت لمتمِّهِ",43,"م",2,0],["وَلَو صَدح الحمام أَعادَ صَدحاً","لَهُ وَأَعار مَسمعه الحماما",44,"م",2,0],["ولو صحَّ وفاء لم","يُصِبْ سيفُ وغىً قَيْنا",45,"ن",2,0],["ولو صددت عن الأيام ما عرفت","فيها حلاوة عيش من مرارته",46,"ت",2,0],["ولو صغى فكري إلى مثوبة","ومال ما نفقت من آماله",47,"ل",2,0],["ولو صدق الوشاةُ إليك عنّي","لقالوا إِنّه دَنِفٌ سقيمُ",48,"م",1,0],["ولو صدقوا ماتوا وزالت نفوسهم","ولم يبق فيهم قائل وله فكر",49,"ر",1,0],["ولو صَحَّ الكلامُ بلا بَيانٍ","بَلَغتُ من الدَّعاوي ما أريدُ",50,"د",1,0]]}