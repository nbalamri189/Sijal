{"poems":[[53,"دع صاعدا يقتني الدنيا وزبرجها","https://www.aldiwan.net/poem64955.html","البسيط"],[58,"طلل توهمه فصاح مسلما","https://www.aldiwan.net/poem58511.html","الكامل"],[33,"أضحى فؤادك غير ذات أوان","https://www.aldiwan.net/poem41285.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62203","الكامل"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64064","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63770","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96651","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11938","السريع"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131524",""],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76897","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86397","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89580","الكامل"],[5596,"عيدالاضحى بعدما قُدّم موعده وأُخّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=205670",""]],"verses":[["دعْ صاعداً يقتني الدنيا وزِبرِجها","في العلم باللَّهِ مما ناله عِوضُ",0,"ض",1,1],["دِعْصٌ يُقِلُّ قَضيبَ بانٍ فوقَهُ","شمسُ النّهارِ تُقِلُّ ليلاً مُظْلِما",1,"م",2,0],["دَعصٌ مِنَ الأَنقاءِ إِن هِيَ أَدبَرَت","أَو أَقبَلَت فَكَصَعدَةِ المُرّانِ",2,"ن",1,0],["دِعْصَا نَقاَ رَفَدَ العَجَاجُ تُرَابَهُ","حُرٍّ صَبِيحَةَ دِيمَةٍ وذِهَابِ",3,"ب",1,0],["دِعصٌ ردفهُ وقوامهُ","صُبحٌ وليلٌ خَدُّه وِعذاره",4,"ر",2,0],["دع صاعداً إذ مضى يمضي ولا يَقِفُ","ففي أبي خَلَفٍ من صاعدٍ خَلَفُ",5,"ف",1,1],["دِعْصٌ يميلُ عليه غُصْنٌ أهْيَفٌ","غصنٌ يضيءُ عليه بدرٌ أَزْهَر",6,"ر",1,0],["دعصٌ وغصنٌ تحت صبحٍ أبيضٍ","مِن تحتِ ليلٍ مدلهمٍّ أسودِ",7,"د",1,0],["دِعصُ نَقاً تَحمِلُهُ بانَةٌ","شَمسُ ضُحىً في زِيِّ شَمّاسِ",8,"س",1,0],["دع صاحب ابن العميد كافي الكفاه","وآل برمك وآل المرزبان",9,"ن",1,0],["دَع صُحبَة القَوم أبدَوا من ملالِهِمُ","يوما وَقَد كرهوا منك الثَّوى بِدَعا",10,"ع",2,1],["دعص إِذا ولَّت قضيب إِذا أتت","حسانة الادبار والاقبال",11,"ل",1,0],["دعصٌ من الرمل في ردف وفي عكنٍ","لولا تماسكه بالحلي لا تنسفا",12,"ف",2,0],["دَعصُ الجِواءِ لَنا سَمَر","بِهِ بَينَ أَفياءِ القَمَر",13,"ر",1,1],["دع صاحب الملكوت في ملكوته","واقنع بما أولاك ما تتأمر",14,"ر",1,0]]}