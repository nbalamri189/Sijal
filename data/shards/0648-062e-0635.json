ttps://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[404,"أخا الود بعد البعد قلبي ما أنسى","https://www.aldiwan.net/poem33704.html","الطويل"],[404,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[430,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[433,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[433,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[433,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[433,"وتفرد في علم النجوم بقسمة","https://www.aldiwan.net/poem12737.html","الطويل"],[442,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[450,"تتجاهلين","https://www.aldiwan.net/poem1012.html",""],[459,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[459,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[462,"وفقير عصف المحل به","https://www.aldiwan.net/poem15697.html","الرمل"],[465,"عيون المها مالي بسحرك من يد","https://www.aldiwan.net/poem3556.html","عموديه"],[478,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[500,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[507,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[515,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[516,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[525,"نبي براه الله من نوره الأسمى","https://www.aldiwan.net/poem13283.html","الطويل"],[525,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[530,"أطلقت دمعي بعد تقييد الهوى","https://www.aldiwan.net/poem37213.html","الكامل"],[552,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[552,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[552,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"]],"verses":[["وَخَصَصتَهُ بِالبِشرِ مِنكَ وَإِنَّما","بِشرُ الإِمامِ قَرابَةُ الإِنعامِ",0,"م",1,0],["وَخَصَّصْتُهُ لَكَ بِالْعِلاَجِ لِكَوْنِهِ","يُحْتَاجُ دُونَ سِوَاهُ كُلَّ زَمَانِ",1,"ن",1,0],["وَخصَصْتُ بِالإِلْقَاءِ غَيْرَكَ غَيْرَةً","وَجَعَلْتُ ذِكْرَكَ شَاهِدَ الأَعْمَالِ",2,"ل",1,0],["وخُصَّ أميرَ المُسْلمينَ برَحْمَةٍ","تُبوّئُهُ دارَ المُقامَةِ والأجْرِ",3,"ر",1,0],["وخَصائِصٌ للّهِ بثّ ضُروبَها","في الأرْضِ سادَ لأجْلِها مَنْ سادا",4,"د",2,0],["وَخَصَصْتَنِي بالرُّزْءِ وَالثُّكْلِ الذي","أَوْهَى القُوَى مِنِّي وَهَدَّ المَنْكِبَا",5,"ب",2,0],["وَخَصمٍ تَمَنّى فَاِجتَنَيتُ بِهِ المُنى","وَعَوجاءَ حَرفٍ لَيِّنٍ عَذَباتُها",6,"ت",3,0],["وَخُصَّ كاتِبَهُم زولا بِأَطيَبِها","كَيما يُقابَلُ إِحسانٌ بِإِحسانِ",7,"ن",1,0],["وَخَصمٍ أَبا بَدرٍ أَلَدَّ أَبَتَّهُ","عَلى مِثلِ طَعمِ الحَنظَلِ المُتَفَلِّقِ",8,"ق",1,0],["وَخَصَصْتَ بِالعَرَبِ الكِرَامِ مَبَاحِثاً","أَحْسَنْتَ فِيهَا غَايَةَ الإِحْسَانِ",9,"ن",1,0],["وَخَصْرٌ إِلَيْهِ يَنْتَهِي رَحْبُ صَدْرِهَا","وَقَدْ دَقَّ حَتَّى خِيلَ بِالثَّوْبِ مُبْرَمَا",10,"م",2,0],["وخصّ أنصاره الأَعْلَيْنَ صفوته","وأسكنوا من جوار الله أعلاهُ",11,"ا",2,0],["وخُصْصتَ بالبشرى من الله ربَّنا","كما عمَّ أقطارَ البلاد نوالُكا",12,"ك",2,0],["وَخَصمٍ قِيامٍ بِالعَراءِ كَأَنَّهُم","قُرومٌ غَيارى كُلَّ أَزهَرَ مُصعَبِ",13,"ب",1,0],["وَخَصمٍ كَنادي الجِنِّ أَسقَطتُ شَأوَهُم","بِمُستَحصِدٍ ذي مِرَّةٍ وَصُروعِ",14,"ع",1,0],["وَخَصمٍ قَد أَقَمتُ الدَرءَ مِنهُ","بِلا نَزِقِ الخِصامِ وَلا سَؤومِ",15,"م",1,0],["وخصّ مغنى دمشق الحزنُ متصلاً","بفرقتين أباتتها على وصَب",16,"ب",1,0],["وخصَّنا بجَناها لا بشوكتها","فنحن في نِعَمٍ منها بلا محنِ",17,"ن",1,0],["وَخَصمٍ غِضابٍ يَنفُضونَ لِحاهُمُ","كَنَفضِ البَراذينِ الغِراثِ المَخالِيا",18,"ي",2,0],["وَخُصّا بِالعَمارِ وَبِالتَحايا","رُفاتَ المَجدِ مِن توتَنخَمينا",19,"ن",2,0],["وَخَصرٌ تَثبُتُ الأَبصارُ فيهِ","كَأَنَّ عَلَيهِ مِن حَدَقِ نِطاقا",20,"ق",2,0],["وَخَصَّ بِهِ عَبدَ العَزيزِ بنَ يوسُفٍ","فَما هُوَ إِلّا غَيثُها وَمَعينُها",21,"ن",3,0],["وَخَصَّكَ اللَهُ بِالفَضلِ الَّذي شَهِدَت","بِهِ لَعَمرُكَ في الفُرقانِ مِن طُرُقِ",22,"ق",1,0],["وخصوماً ببغْيِهمْ","ضجَّت الأَرضُ والسما",23,"م",2,0],["وَخَصيفَ اللَونِ جادَت بِهِ مَرخَةٌ","مِن مُخدَجٍ أَو تَمام",24,"م",1,0],["وَخَصيفٍ لَدى مَناتِجِ ظِئرَي","نِ مِنَ المَرخِ أَتأَمَت زُنُدُه",25,"د",2,0],["وَخَصمٍ تَمَنّى عَلَيَّ المُنى","لَأَن جاشَ بَحرُ قُرَيعٍ فَسالا",26,"ل",2,0],["وَخَصمٍ يَهُدُّ القَرمَ رَجعُ جَوابِهِ","مَلَأتُ لَهُ صاعَ الخِصامِ فَوَفَّيتُ",27,"ت",1,0],["وَخَصمٍ موقِدٍ لِشَرارِ شَرٍّ","أَمامَ مَعاشِرٍ خُزرٍ غِضابِ",28,"ب",1,0],["وخَصَّهُ بِوقَارٍ قَرَّ مِنهُ لَهُ","فِي أَنفُسِ الخَلقِ تَعظِيمٌ وتَبجِيلُ",29,"ل",1,0],["وَخَصلَةٍ هِيَ أَيضاً يُستَدَلُّ بِها","عافانِيَ اللَهُ مِنها حينَ عافاكا",30,"ك",2,0],["وَخِصيَةٍ في حُسنِ ياقوتَةٍ","سيقَت إِلى أَصيَدَ مَحجوبِ",31,"ب",1,0],["وَخَصمَي ضِرارٍ ذَوَي تُدرَإِ","مَتَى يَأتِ سِلمُهُما يَشغَبِ",32,"ب",1,0],["وخصورٌ بها ضمورٌ وأعجا","زٌ ثقالٌ تعيا بهن الخصور",33,"ر",1,0],["وخصّ بها عبد العزيز بن يوسفٍ","فما هو إلا غيثها ومعينها",34,"ن",3,0],["وخصائص الله بث ضروبها","في الأرض ساد لأجلها من سادا",35,"د",2,0],["وخصوصيات واقفة","تهذي كالمذياع الألكن",36,"ن",1,0],["وخصورا تميد بين زنود","بضّة الخصورر اللّدانا",37,"ن",2,0],["وخصلتان ارتاحتا في يدي","من الدجى المخمور مسكوبتان",38,"ن",1,0],["وخصصتني بمودةٍ وكرامةٍ","حتى سلوتُ بها عن الأوْطَانِ",39,"ن",1,0],["وخُصَّ إمامَنا منا سلاماً","إمامَ المسلمينَ هُوَ العَلِيمُ",40,"م",1,0],["وخصرٌ حوتْه قبضةُ الكفِّ ناحلٌ","وردفٌ ثقيلٌ للمآزِر دافعُ",41,"ع",1,0],["وخصوا جميعَ الأقربينَ سلامنَا","وأولادكم من كابرٍ وأصاغرِ",42,"ر",1,0],["وخصرٌ لها واهٍ ضعيفٌ كسلوتى","وردف كَدِعصِ الرمل ملءُ المآزر",43,"ر",1,0],["وخُصَّ الإمام العدلَ ألف تحيَّة","وألفَ سلامٍ مِن وَفيٍّ مُصاحبِ",44,"ب",1,0],["وَخُصَّ بِالشَرَفِ المَحضِ الَّذي اِرتَفَعَت","لَهُ النَواظِرُ وَالنورِ الَّذي بَهَرا",45,"ر",2,0],["وَخُصِصتَ في زَمَنِ الحَياةِ بِجَنَّةٍ","حَسُنَ المَصيفُ بِها وَطابَ المَربَعُ",46,"ع",1,0],["وَخَصَّكَ فيهِ بِالسُؤالِ كَرامَةً","وَما إِن بَراهُ اللَهُ إِلّا لِيُسأَلا",47,"ل",2,0],["وَخُصِصتَ بِالإِبداعِ في فَعَلاتِكَ ال","حُسنى لِيَظهَرَ عَجزُ مَن يَتَهَمَّمُ",48,"م",1,0],["وخُصَّ بتشريف على الناس كلهم","ومن لم يقل هذا تقوَّله قسرا",49,"ر",2,0],["وَخَصْرُها ناحِلٌ مِثْلِي عَلى كَفَلٍ","مُرَجْرَجٍ قَدْ حَكى الأَحْزَان في الخَلَدِ",50,"د",1,0],["وخصمه في مشكل من أمرهِ","شكى لَه أشكاله أشكالهُ",51,"ل",2,0],["وَخِصالُ الفَتى تَنمُّ عَلَيهِ","مِثل ريح عَرَفتَها مِن شَذاها",52,"ا",3,0],["وَخَصَّ بِأَسناها النَّسيبَ فَلَم يَزَلْ","إِذا ذكَرَتْ أَهلَ المَناقِبِ أَوحَدا",53,"د",2,0],["وخَصَّكُم بالصبر دُوني وخَصَّني","بحزنٍ عليكم يبتدى ويعود",54,"د",1,0],["وخَصْرٍ كصبري فوق رِدْفٍ كصَدِّه","فذا ظالعٌ واهٍ وذاك ضَليع",55,"ع",1,0],["وخصلةٌ إن كشفت عنها","لم تمس منه على غرور",56,"ر",1,0],["وَخُصَّ رَشيداً ذا المنار وشيخهُ","وَشيخَهما إن شئتَ بالحصصِ الكبرى",57,"ر",2,0],["وَخصّوا مُحبّيه بنسبةِ حبّهم","فَأَعطوا لكلٍّ مِن عَداوتهم قدرا",57,"ر",2,0],["وَخَصّص قوتاً ليسَ يُنسى بحالةٍ","لِذكراهُ كلُّ الناسِ لا زال مضطرّا",58,"ر",2,0],["وَخُصوصاً في عَينِهم وَعَديمِ ال","شَكلِ مِن بَينِهم أَبي مَنصورِ",59,"ر",1,0],["وخُصَّ بِأَبهى مِنبَرٍ بَعدَ مِنبَرٍ","بِطَيبَةَ مَبنيٍّ إلى جانبِ القَبرِ",60,"ر",1,0],["وخصرها كزاهدٍ","منقطعٍ في الجبلِ",61,"ل",1,0],["وخصرٍ تظلُّمُه يُشتَهى","وردفٍ يُحَبُّ لما قد ظلم",62,"م",1,0],["وخصر قد تلطف في اختصار","فيا للّه ما احلى اختصاره",63,"ر",2,0],["وخصره كاد ان يخفى لرقته","كأنما هو من حالي قد اختصره",64,"ر",2,0],["وخصك الله بالفتح المبين وقد","اطاعه الماضيان السيف والقدر",65,"ر",1,0],["وخصك الله بالرأي السديد وقد","اطاعك الماضيان السيف والقلم",66,"م",1,0],["وخصر كأمثال الجديل مهفهفٍ","وردف زرى بالموجِ لمّا تموّجا",67,"ج",2,0],["وَخَصَّك اللَهُ بما تَرتَضى","مِن سُؤدُدٍ مَحضٍ وَمُلكٍ كَبير",68,"ر",1,0],["وخصّه بالخُلُق المرتضى","سمحٌ حليم خاشع مُشفق",69,"ق",1,0],["وخصّ منّي بالدعا إخوانكَ","من قد غدوا على التقى أعوانكَ",70,"ك",1,0],["وخصك الله بالعدل الذي اعتدلت","منه الطبائع واعتلت به النوب",71,"ب",1,0],["وخَصرُكِ رقَّ حتى كادَ يَفنى","لذلكَ رقَّ شِعري والشعور",72,"ر",1,0],["وخصرٍ كافرٍ وهلمَّ جرا","فأفتَحُ قلعةً سُوراً فسُورا",73,"ر",2,0],["وَخصاصة تفنى النفوس لها وان","تكن النفوس حجارة وَحَديدا",74,"د",2,0],["وَخص بادنى قاب قوسين رفعة","وَبالحوض في بحر السنا المتهلل",75,"ل",1,0],["وخصه الله منه","بالفضل من تكرماته",76,"ت",2,0],["وخصصتني بغريبة عربية","تهوى لقلبي ما الذي يهواهُ",77,"ا",2,0],["وَخَصمٍ مُضِلٍّ في الضَجاجِ تَرَكتُهُ","وَقَد كانَ ذا شَغبِ فَوَلّى مُواتِيا",78,"ي",2,0],["وخصمت بالمصروف حتى وفره","وحياتكم ما انساق عندي باقي",79,"ق",2,0],["وخصصهم بالقرب منه وبالرضا","وبالنور والفتح المبين ورحمة",80,"ه",1,0],["وخص صفي الدين منهم بفضله","زيادة إحسان وألطاف رأفة",80,"ه",1,0],["وخصه اللَه بالفضل العظيم وبالذك","ر الرفيع وبالإخلاص والسير",81,"ر",1,0],["وخصر طواه الخمص عند اختياره","وأحشاء لم تعني بأكل طعام",82,"م",1,0],["وخصه الرب الأعلى","منه بفضل كبير",83,"ر",1,0],["وَخصَّ بالرعبِ نصراً وَالصبا وله","طُهرٌ ومسجدهُ القيعان والأكمُ",84,"م",1,0],["وخصّصه بالودّ الّذي أنت أهلهُ","وَأَعلن لَه فضل المزيّة في الصحبِ",85,"ب",1,0],["وخصم بلادنا ما تاب يوماً","ولو الفى صليل السيف تابا",86,"ب",2,0],["وَخَصرُكَ الناحِلُ المُعافى","مِنهُ لِجِسمي السَقامَ أَهدى",87,"د",2,0],["وَخَصّص كُلّ خَلقٍ في مَزايا","شَهدنا أَنَّهُ مولي العَطايا",88,"ي",2,0],["وَخص أُصوله بِأَعز وَصف","وَأَكمل عُنصر وَأَتم خير",89,"ر",1,0],["وَخصك بِالهُدى في كُل أَمر","فَلَست تَشاء اِلّا ما يَشاء",90,"ا",2,0],["وخَصَّك المَلكُ المَيمونُ طائرُه","بمفْخَرٍ جَلَّ عن حَدٍّ ومقْياس",91,"س",1,0],["وخَصَّ قَوماً بالدُّرَر","مُؤيَّدُ المُلْكِ وَزَر",92,"ر",1,0],["وخَصَّ قوماً بالدُّرَر","ياجُودُ قَولاً مُعتَبَر",93,"ر",1,0],["وخَصمٍ يَعجِزُ الأَقوامُ عنهُ","شديدِ الضِّغنِ أَقعَسَ مُسمَغِدِّ",94,"د",1,0],["وَخِصالٍ قَطُّ ما حُمِلَت","لا عَلى جُبنٍ وَلا 