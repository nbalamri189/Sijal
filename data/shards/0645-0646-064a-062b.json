{"poems":[[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[254,"إنا وباهلة بن يعصر بيننا","https://www.aldiwan.net/poem2101.html","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113979","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89265","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4935,"إن باري الخلق غافر","https://www.poetsgate.com/ViewPoem.aspx?id=129274",""],[5038,"قم من جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=190216",""]],"verses":[["مَن يثوِ فيهم يلقَ كلّ مشفّع","وَأبو البتولِ هو الشفيع الأعظمُ",0,"م",1,0],["مَن يَثقَفوا مِنّا فَلَيسَ بِمُفلِتٍ","أَبَداً وَقَتلُ بَني قُتَيبَةَ شافي",1,"ف",2,0],["منّي ثناءً صادِقاً ولخَيرُ ما","تحبوهُ قيلٌ ليسَ بالمُتَقَوَّلِ",2,"ل",1,0],["من يثرب جاءَت البشرى بمقدمه","لسهل لينة ممتدا الى الجبل",3,"ل",1,0],["من يثنه في كل حال عقلُه","يظلم ويستولي عليه الأحمقُ",4,"ق",1,1],["من يثرب جاء المدائن وانثنى","من غير شك والأنامُ رقود",5,"د",1,0],["من يثق بالله دوماً","لم يكن والله خاسر",6,"ر",1,0],["مَنْ يَثْلِمُ السَّيفَ وَالسَّيّافَ وا عَجَباً","وَسَيفُكَ الْمُصْطَفى وَالْآلُ وَالرُّسُلُ",7,"ل",1,0]]}