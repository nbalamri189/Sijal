{"poems":[[37,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[74,"وقحبة في حرها","https://www.aldiwan.net/poem18937.html","مجزوء الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[261,"أبا الحسين الزمان ذو دول","https://www.aldiwan.net/poem48473.html","المنسرح"],[438,"وقحمل الخضاب على المشيب لكي","https://www.aldiwan.net/poem12782.html","أحذ الكامل"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20006","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128715","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71084","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59489","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[520,"قل لجمال الملك يا ابن الذي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577486",""]],"verses":[["وَقَحَّمَ سَيرُنا مِن قورِ حِسمى","مَروَتَ الرَعيِ ضاحِيَةَ الظِلالِ",0,"ل",1,0],["وَقِح تعامى عن مدانس عِرضه","فزهاه عُجباً ثوبه المَرْحوض",1,"ض",1,0],["وقحبةٌ في حرِّها","حرٌّ يُنافي ذكرها",2,"ه",2,1],["وَقِحتَ وَلَم يَقِح جُرحي فَيَبرا","وَهَل تَدمى الأَهِلَّةُ أَو تَقيحُ",3,"ح",1,0],["وقحبةٍ تبلع القضيب ولا","تعجبها غيره من الحمل",4,"ل",1,0],["وقحملَ الخضابَ على المَشيبِ لكيْ","يُصْبي الحسانَ بديعُ حِلْيَتِه",5,"ه",1,1],["وقِحُ الحسنِ غير أَني أَرى الور","دَ في وجْهه من الرَّوض خَجْلا",6,"ل",2,0],["وَقَحطانُ تَبهى بِهِ","وَتَبهى بِهِ خِندِفُ",7,"ف",1,0],["وق حر وجهي حرّ نار جهنم","وسعيرها المتوقّد المتوهّج",8,"ج",1,0],["وقحطبة الهمام همام طي","وما المُسْلِيُّ عامرُ منه دونا",9,"ن",2,0],["وقحطانُ من بعد المُفَضَّلِ لم يَثُرْ","عليها له حول الحُصَيبْ قَتامُ",10,"م",1,0],["وقحطانُ رب التاج والملك يشجب","وغوثُ الأنام الغوثُ ربُّ الجحافل",11,"ل",1,0],["وَقِحٌ تَجَاوَزَ كُلَّ حَدٍّ وَهوَ إِن","يَستَضحكِ القَومَ استَطالَ بِبَهجةِ",12,"ه",1,0],["وقح ٍ شطح والشطحه المشطوحه","طرس ٍ أعدّه فرخه المرخومي",13,"م",2,0],["وقّحت طبعهُ القذائف تُلقى","لم يرعُها الردى ولم تخشَ ثَارا",14,"ر",2,0],["وقحبةٍ محكوكة غضة","يرغب في خلواتها الزاهد",15,"د",1,0]]}