{"poems":[[35,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[72,"وقحبة في حرها","https://www.aldiwan.net/poem18937.html","مجزوء الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[256,"أبا الحسين الزمان ذو دول","https://www.aldiwan.net/poem48473.html","المنسرح"],[432,"وقحمل الخضاب على المشيب لكي","https://www.aldiwan.net/poem12782.html","أحذ الكامل"],[575,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"]],"verses":[["وَقَحَّمَ سَيرُنا مِن قورِ حِسمى","مَروَتَ الرَعيِ ضاحِيَةَ الظِلالِ",0,"ل",1,0],["وَقِح تعامى عن مدانس عِرضه","فزهاه عُجباً ثوبه المَرْحوض",1,"ض",1,0],["وقحبةٌ في حرِّها","حرٌّ يُنافي ذكرها",2,"ه",2,1],["وَقِحتَ وَلَم يَقِح جُرحي فَيَبرا","وَهَل تَدمى الأَهِلَّةُ أَو تَقيحُ",3,"ح",1,0],["وقحبةٍ تبلع القضيب ولا","تعجبها غيره من الحمل",4,"ل",1,0],["وقحملَ الخضابَ على المَشيبِ لكيْ","يُصْبي الحسانَ بديعُ حِلْيَتِه",5,"ه",1,1],["وقِحُ الحسنِ غير أَني أَرى الور","دَ في وجْهه من الرَّوض خَجْلا",6,"ل",2,0]]}