"],[5376,"أم البنين إليها القلبُ متصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198234",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5459,"نصر وخُسر","https://www.poetsgate.com/ViewPoem.aspx?id=214873",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5713,"إِذا ابتسمت من الْغَوْر البروق","https://www.poetsgate.com/ViewPoem.aspx?id=189213",""],[4209,"فديتك صاحبي بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=118061",""],[5725,"رحيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180108",""],[5809,"ابيض واسود","https://www.poetsgate.com/ViewPoem.aspx?id=205477",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[463,"على كلِّ حالٍ جانبَ الحقِّ أمنعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60126&r=&rc=182",""]],"verses":[["إِذا أَبطَأنَ بِالغَدَواتِ فَاِعبَأ","قِرىً لِضُيوفِهِنَّ مَعَ العَشايا",0,"ا",3,0],["إِذا اِبتَدَرَت نِساؤُهُمُ المَساعي","فَما ظَنّي وَظَنُّكَ بِالرِجالِ",1,"ل",1,0],["إِذا اِبتَدَرَ المَلامَ نَدى يَدَيهِ","مَضى طَلقاً عَلى سُنَنِ المِراحِ",2,"ح",1,0],["إِذا إِبِلي مُطِلَت رَعيَها","فَهَل يَنفَعُ البَلَدُ المُعشِبُ",3,"ب",1,0],["إِذا اِبتَدَرَ الرِهانَ مُبادِروهُ","تَمَطَّرَ دونَهُم يَومَ الجَزاءِ",4,"ا",2,0],["إِذا ابتَدَروا الغاياتِ قَرًّبَها لَهُم","وَجيفُ جيادٍ أَو ذَميلُ قِلاصِ",5,"ص",1,0],["إذا ابْتَسَمْنَ سَلَبْنَ البَرْقَ رَوْعَتَهُ","وإنْ نَظَرْنَ فجَعْنَ الظّبْيَ بالكَحَلِ",6,"ل",1,0],["إذا ابْتَسَمَتْ عُجْباً بَكَيْتُ صَبابةً","فمِن لُؤلُؤٍ نَظْمٍ ومِنْ لُؤلؤٍ نَثْرِ",7,"ر",1,0],["إِذا اِبتَسَمتِ لَنا فَالدَهرُ مُبتَسِمٌ","وَإِن كَشَرتِ لَنا عَن نابِهِ كَشَرا",8,"ر",2,0],["إِذا اِبتَدَرَ الناسُ المَكارِمَ بَذَّهُم","عَراضَةُ أَخلاقِ اِبنِ لَيلى وَطولُها",9,"ل",3,1],["إِذَا أبُو الهَوْلِ أَبْدَى مِصْرَ مُرْعَبَةً","فَمَا يُخَبِّرُ عَنْ طَاعَاتِهَا الهَرَمُ",10,"م",1,0],["إِذا أَبطَأَت أَيدي اِمرِئِ القَيسِ بِالقِرى","عَنِ الرَكبِ جاءَت حاسِراً لا تُقَنِّعِ",11,"ع",1,0],["إِذا اِبن أَبي موسى بِلالٌ بَلَغتِهِ","فَقامَ بِفَأسٍ بَينَ وصلَيكِ جازِرُ",12,"ر",1,0],["إذا ابتسمت في ظلمة الليل أشرقا","فعُدنا من الآمال في أنجم ُزهر",13,"ر",1,0],["إذا ابتسمت لي عزتي ونزاهتي","فلست أبالي بالزمان المعبّس",14,"س",1,0],["إِذا أَباؤنا وَأَبوكَ عُدّوا","أَبانَ المُقرِفاتُ مِنَ العِرابِ",15,"ب",1,0],["إِذا اِبتَسَمَت أَبدَت غُروباً كَأَنَّها","عَوارِضُ مُزنٍ تَستَهِلُّ وَتَلمَحُ",16,"ح",1,0],["إِذا اِبتُدِرَ المَكارِمُ كانَ فيكُم","رَبيعُ الناسِ وَالحَسَبُ الأَثيلُ",17,"ل",1,0],["إذا ابتسر الحرب أخلامها","كشافاً وهُيَّخَتِ الأفحل",18,"ل",1,1],["إِذا اِبنُكِ سارَ في بَرٍّ وَبَحرٍ","فَمَن يَدعو لَهُ أَو يَستَجيرُ",19,"ر",1,0],["إذا أبصرت جدّاً من زمان","فخالطه بشيءٍ من مزاح",20,"ح",1,0],["إذا ابن عليّ سار في الشعرِ ذكره","فقل حسناً زكَّى قصيداً ومقصدا",21,"د",2,0],["إذا ابن عليٍّ وابن يحيى تساجلا","فقل طارف المجد الرَّضي وتليده",22,"د",2,0],["إذا ابْتدروا غايات لفظٍ رأيتهم","من الروض أنشى أو من الريح أنشطا",23,"ط",2,0],["إذا ابن تقيّ الدِّين جاد نباته","علينا فلا مدّت يدُ النيل أصبُعا",24,"ع",2,0],["إذا ابْيضَّ مسود العذار فإنما","هوَ الصبح للّذّات بالليلِ قاطع",25,"ع",1,0],["إذا ابن قَومٍ وإن كانوا ذوي كرمٍ","لم يفعلِ الخير أمسى غير مُنتجَبِ",26,"ب",1,0],["إذا أبصرَ الدنيا اسْتَهلَّ كأنه","بما سوف يلقى من أذاها يُهَدَّدُ",27,"د",1,0],["إذا أبو قاسمٍ جادتْ لنا يدهُ","لم يُحمَد الأجودانِ البحر والمطرُ",28,"ر",1,1],["إذا أُبدِئَ الطول منهم أُعي","دَ أو أُوتِر العرف فيهم شفع",29,"ع",1,0],["إذا أبصر الدنيا استهلَّ كأنه","يرى ما سيلقى من أذاها ويسمع",30,"ع",1,0],["إذا ابن خِيار بدا","فحَيَّ على لَعْنِهِ",31,"ن",2,1],["إِذا اِبتَدَرا ما تَطرَحُ الكَفُّ فاتَهُ","بِهِ حَبَشِيٌّ كَيِّسُ اللَحَظانِ",32,"ن",1,0],["إِذا أَبصَرَتهُ ذاتُ طِنءٍ تَبَسَّمَت","إِلَيهِ وَقالَت إِنَّ ذا لَخَليقُ",33,"ق",1,0],["إِذا اِبتَدَرَ الناسُ السِجالَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",34,"ح",1,0],["إِذا اِبتَذَلَت حَسناءُ ثُمَّ عَذَلَتها","تَوَلَّت وَقالَت كُلُّكُم مُتَبَذِّلُ",35,"ل",1,0],["إِذا أَبطَل الأَملاك غَيري لِلثَنا","فَإِنّيَ وَضّاحُ الجَبين إِلى المَدحِ",36,"ح",1,0],["إِذا أَبدى الشَبابُ هَوىً وَزَهواً","أَشارَ إِلَيهِ حِلمُكَ وَالأَناةُ",37,"ه",1,0],["إِذا اِبتَسَمَت تَأَلَّقَ عارِضاها","عَلى ضَرَبٍ يُصَفَّقُ في ضَريبِ",38,"ب",1,0],["إِذا أَبَتِ الحُقوقَ نُفوسُ قَومٍ","وَمَلّوا رَجعَ واجِبِها المُعادِ",39,"د",1,0],["إِذا اِبتَلى يَومَ جَداهُ اِمرُؤٌ","أَغناهُ عَن أَن يَتَرَجّى غَدَه",40,"د",2,0],["إِذا اِبتَدَروهُ بِالسُؤالِ اِنتَحى لَهُم","عَلى وَفرِهِ حَتّى يَجورَ فَيَعتَدي",41,"د",2,0],["إِذا اِبتَدا بُخَلاءُ الناسُ عارِفَةً","يَتبَعُها المَنُّ فَالمَرزوقُ مَن حُرِما",42,"م",2,0],["إِذا اِبتَدَرا مَدى مَجدٍ بَعيدٍ","تَمَطَّرَ دونَهُ فَرَسا رِهانِ",43,"ن",1,0],["إِذا اِبنا دُخانٍ واقِفا وِردَ عُصبَةٍ","لِئامٍ وَإِن كانوا قَليلي الحَلايِبِ",44,"ب",1,0],["إِذا اِبنُ أَبي سودٍ خَلا مِن مَكانِهِ","فَقَد مالَتِ الأَيّامُ بِالحَدَثِ المُجلي",45,"ل",2,0],["إذا ابتسمَ الشقائقُ فيه صبحاً","تأوَّد من نسيمِ صِباً عليلِ",46,"ل",1,0],["إذا أبدَعَ المُدَّاحُ أبدَعَ عُرْفُه","فكانَ بما يُسْدي من العُرْفِ أبدَعا",47,"ع",2,0],["إِذا اِبتَدَرَت قَيسُ بنُ عَيلانَ غايَةً","مِنَ المَجدِ مَن يَسبِق إِلَيها يُسَوَّدِ",48,"د",1,0],["إِذا أَبزَت بِهِ يَوماً أَهَلَّت","كَما تُبزي الصَعائِدُ وَالعِشارُ",49,"ر",1,0],["إِذا أَبقَتِ الدُنيا عَلى المَرءِ دينَهُ","فَمافاتَهُ مِنها فَلَيسَ بِضائِرِ",50,"ر",1,0],["إِذا اِبتَسَمَ المَهدِيُّ نادَت يَمينُهُ","أَلا مَن أَتانا زائِراً فَلَهُ الحُكمُ",51,"م",1,0],["إِذا أَبطا الرَسولُ فَظُنَّ خَيراً","فَسوءُ الظَنِّ في عَجَلِ الرَسولِ",52,"ل",1,1],["إِذا اِبتَدَأَ الساقي وَثَنّى وَثَلَّثا","وَجَسَّ لَنا الشادونَ مَثنى وَمَثلَثا",53,"ث",2,1],["إِذا اِبتَسَمَت وَالفاحِمُ الجَعدُ مُسبَلٌ","تُضِلُّ وَتَهدي مِن ظَلامٍ وَمِن ظَلمِ",54,"م",1,0],["إذا أبدلوا بالباءِ حرفَ ختامِهِ","ترى اسماً وفعلاً ثم حرفاً له وبرْ",55,"ر",1,0],["إِذا اِبتَسَمَت قُلتَ اِنكِلالُ غَمامَةٍ","خَفى بَرقُها في عارِضٍ مُتَهَلِّلِ",56,"ل",1,0],["إِذا اِبتَدَرَت أَجادِلُها مَطاراً","أَسَفَّ النَسرُ وَاِنحَطَّ الأَنوقُ",57,"ق",1,0],["إِذا اِبتَدَرَ السُرى مِنها فَريقٌ","تَعَثَّرَ في مَساريهِ فَريقُ",57,"ق",1,0],["إذا أبصرتَ دهرك مستريباً","فدافعه بِعَزمٍ مُكفَهِرِّ",58,"ر",1,0],["إذا أبدَتِ الأزْبادَ في الصَّحن راعَنا","بِرازُ كميِّ البأسِ من فوقه دِرع",59,"ع",1,0],["إِذا ابتَدَرَ الناسُ الفِعالَ فَخُذ عَصاً","وَدَعدِع بِمَعزى يا ابنَ طالِقَةِ الذَربِ",60,"ب",1,0],["إِذا اِبتَهَلتُ سَأَلتُ اللَهَ رَحمَتَهُ","كَنَّيتُ عَنكَ وَما يَعدوكَ إِضماري",61,"ر",2,1],["إذا أبصرتَ أكّالاً","للحم الصيدِ في الحرم",62,"م",1,0],["إِذا اِبتَسَمَت جادَت جُفوني بِوابِلٍ","مِنَ الغَيثِ أَجرَتهُ بُروقُ المَباسِمِ",63,"م",1,1],["إِذا أَبصَرَ المَرءُ المُروءَةَ وَالتُقى","فَإِنَّ عَمى العَينَينِ لَيسَ يَضيرُ",64,"ر",1,0],["إِذا اِبنُ داوودَ أَعطاني مَعونَتَهُ","كانَ الفَراغُ وَلَم أَربَع عَلى عودِ",65,"د",1,0],["إِذا اِبنا أَبٍ واحِدٍ أُلفِيا","جَواداً وَعَيراً فَلا تَعجَبِ",66,"ب",1,1],["إِذا أُبيدَت فَما عِندي إِذا أُخِذَت","فَرعٌ يَنوبُ وَلا عَذراءُ تُفتَرَعُ",67,"ع",1,0],["إِذا اِبتَهَجتَ وَأَعطاكَ المَليكُ غِنىً","غَدَوتَ كَالرَبعِ لَم تُحمَد عَوافيكا",68,"ك",2,0],["إِذا اِبتَكَرَت إِلى العَرّافِ فَاِعرِف","مَكانَ عَصا تَصِكُّ بِها قَراها",69,"ا",3,1],["إِذا اِبتَدَرَ القَومُ السِلاحَ وَجَدتَني","مَنيعاً إِذا بَلَّت بِقائِمِهِ يَدي",70,"د",2,0],["إِذا أَبرَزَ الرَوعُ الكَعابَ فَإِنَّهُم","مَصادٌ لِمَن يَأوي إِلَيهِم وَمَعقِلُ",71,"ل",1,0],["إِذا اِبتَسَمَت في الليلِ وَالليلُ دُونَها","أَضاءَ دُجى الليلِ البَهِيمِ اِبتِسامُها",72,"ه",2,0],["إِذا ابْتَسَمْنَ فَدُرُّ الثَّغرِ مُنْتَظمٌ","وَإنْ نَطَقْنَ فَدُرُّ اللَّفظِ مَنْثُورُ",73,"ر",1,0],["إذا آبتسمت سلمى تلالؤ مزنة","يمانية من عارض متبسم",74,"م",1,0],["إذا أَبصرت عيناً إليها تُصوِّبُ","فَقلت لَهم إني فَلا تتكذّبوا",75,"ب",3,0],["إِذَا ابْتَسَمَتْ في مُظْلِمِ اللَّيْلِ فَرَّجَتْ","دُجَى اللَّيْلِ عَنْ عَذْبٍ أَغَرَّ مُوشَّمِ",76,"م",1,0],["إِذَا أَبْصَرُوا شَخْصَاً يَقُولُونَ جَحْفَلٌ","وَجُبْنُ الْفَتَى سَيْفٌ لِعَيْنَيْهِ بَارِقُ",77,"ق",1,0],["إِذَا أَبْصَرُونِي فِي النَّدِيِّ تَحَاجَزُوا","عَنِ الْقَوْلِ وَاسْتَغْنَوا عَنِ الْعُرْفِ بِالنُّكْرِ",78,"ر",1,0],["إِذَا أَبْصَرَتْ زُرْقَ الْمَوَارِدِ رَفْرَفَتْ","عَلَيْهَا فَطَافٍ فَوْقَهَا وَغَرِيقُ",79,"ق",1,0],["إذا أبرَمَ الخصمُ المعاندُ برمةً","فيا ويحه صُبَّتْ عليه الصواعقُ",80,"ق",1,0],["إذا ابتسموا فالباتراتُ بواسمٌ","وإن غضبوا فالباتراتُ غِضاب",81,"ب",1,0],["إِذَا أَبْصَرَ الإِحْسَانَ فيها تَلأْلأَتْ","أَسَارِيرُه واهْتَزّ بالعُجْبِ جَانِبُه",82,"ب",2,0],["إذا ابنُ أبي الهَيْجاءِ هِيجَ تَجَهَّمَتْ","وُجوهُ المَنايا في ظُبّىً تَتَبَسَّمُ",83,"م",1,0],["إذا ابتدر القوم السلاح وجدتني","منيعاً إذا ابتلت بقائمه يدي",84,"د",2,0],["إذا ابتدرَ النّاسُ المكارمَ بزَّهمْ","عَرَاضَة ُ أَخْلاَقِ ابنِ لَيْلَى وَطُولُها",85,"ل",3,1],["إذا أُبدىء الطَّوْلُ منهم أُعي","د أو أُوتر العُرف فيهم شُفِع",86,"ع",1,0],["إِذَا ابْتُذِلَتْ جَفَّتْ وَلَوْ صِينَ كِمُّهَا","وَلَمْ تَسْتَعِدْ زَهْواً وَطِيباً مِنَ الطَّلِّ",87,"ل",1,0],["إذا أبصرت دهرك مكفهراً","فدافعه بعزمٍ مكفهر",88,"ر",1,0],["إذا أَبصَر المحزون أَرضَ شَذُونةٍ","وحُسن مُحيّاها أَفاقَ مِنَ الحُزن",89,"ن",1,1],["إِذَا ابتَسَمَت خِلتَ البُرُوقَ إبتِسَامَهَا","سَناً في هَوَاءٍ مِثلُ آخَرَ في هَوَا",90,"و",2,0],["إِذا أَبْصَرَتْكَ العَيْنُ جَادَتْ بِمُذْهَبٍ","عَلَى مَذْهَبٍ فِي الخَدِّ بَيْنَ المَذاهِبِ",91,"ب",1,0],["إِذا أَبْرقتْ ضرباً سيوفُك أَمطرتْ","رؤوسَ الأَعادي فَوق أَرْضِ المصائبِ",91,"ب",1,0],["إذا ابطات عنا من المحسن الحسنى","حمدناه علما إن موجبه منا",92,"ن",2,1],["إذا أباح الغنا والدف في عرس","جعلته دينه المرقوم في الكتب",93,"ب",1,0],["إِذا ابتَسَمَت ظَمياءُ وَاللَّيلُ مُسدِفٌ","تَجَلَّى ظَلامُ اللَّيلِ حِينَ تُباشِرُه",94,"ر",2,0],["إذا أبرم التيار داراته حكى","أنامل خرّاط يحرّر مُدْهُنا",95,"ن",2,0],["إذا أبصرت رأسا فيه طول","كمثل الدرج أو سفط لتمّه",96,"م",2,1],["إذا ابن جميل مشى خلتنا","تموج بنا إن مشى زلزله",97,"ل",2,1],["إذا أبصرت أعمى في طريق","فقده من الطريق إلى المضيق",98,"ق",1,0],["إذا أبصرت كوخا في طريق","عليه معلقا ترس وسيف",99,"ف",1,1],["إذا أبصرت أعمى فيه خير","فقد ترك الخبيث ردي طباعه",100,"ع",2,0],["إذا ابتغيتُ كؤوسَ الراحِ مُتْرَعة