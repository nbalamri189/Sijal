3,"إذا أبصرت ناظرنا","https://www.aldiwan.net/poem12404.html","مجزوء الوافر"],[433,"انزع لباسك فالآجال حاكمة","https://www.aldiwan.net/poem12489.html","البسيط"],[459,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[459,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[459,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[459,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[459,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[459,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[469,"سبى عقلي هلال بني هلال","https://www.aldiwan.net/poem59726.html","الوافر"],[469,"أيا حسن الخلق قم نصطبح","https://www.aldiwan.net/poem59980.html","المتقارب"],[516,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[530,"تراه عن وداد الخل حادا","https://www.aldiwan.net/poem37438.html","الوافر"],[552,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[563,"من عاش في الأرض لا يخلو من الكمد","https://www.aldiwan.net/poem52790.html","البسيط"],[563,"عفت دار كقلبك بعد سلمى","https://www.aldiwan.net/poem52972.html","الطويل"],[576,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[586,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["إِذا أَبطَأنَ بِالغَدَواتِ فَاِعبَأ","قِرىً لِضُيوفِهِنَّ مَعَ العَشايا",0,"ا",3,0],["إِذا اِبتَدَرَت نِساؤُهُمُ المَساعي","فَما ظَنّي وَظَنُّكَ بِالرِجالِ",1,"ل",1,0],["إِذا اِبتَدَرَ المَلامَ نَدى يَدَيهِ","مَضى طَلقاً عَلى سُنَنِ المِراحِ",2,"ح",1,0],["إِذا إِبِلي مُطِلَت رَعيَها","فَهَل يَنفَعُ البَلَدُ المُعشِبُ",3,"ب",1,0],["إِذا اِبتَدَرَ الرِهانَ مُبادِروهُ","تَمَطَّرَ دونَهُم يَومَ الجَزاءِ",4,"ا",2,0],["إِذا ابتَدَروا الغاياتِ قَرًّبَها لَهُم","وَجيفُ جيادٍ أَو ذَميلُ قِلاصِ",5,"ص",1,0],["إذا ابْتَسَمْنَ سَلَبْنَ البَرْقَ رَوْعَتَهُ","وإنْ نَظَرْنَ فجَعْنَ الظّبْيَ بالكَحَلِ",6,"ل",1,0],["إذا ابْتَسَمَتْ عُجْباً بَكَيْتُ صَبابةً","فمِن لُؤلُؤٍ نَظْمٍ ومِنْ لُؤلؤٍ نَثْرِ",7,"ر",1,0],["إِذا اِبتَسَمتِ لَنا فَالدَهرُ مُبتَسِمٌ","وَإِن كَشَرتِ لَنا عَن نابِهِ كَشَرا",8,"ر",2,0],["إِذا اِبتَدَرَ الناسُ المَكارِمَ بَذَّهُم","عَراضَةُ أَخلاقِ اِبنِ لَيلى وَطولُها",9,"ل",3,1],["إِذَا أبُو الهَوْلِ أَبْدَى مِصْرَ مُرْعَبَةً","فَمَا يُخَبِّرُ عَنْ طَاعَاتِهَا الهَرَمُ",10,"م",1,0],["إِذا أَبطَأَت أَيدي اِمرِئِ القَيسِ بِالقِرى","عَنِ الرَكبِ جاءَت حاسِراً لا تُقَنِّعِ",11,"ع",1,0],["إِذا اِبن أَبي موسى بِلالٌ بَلَغتِهِ","فَقامَ بِفَأسٍ بَينَ وصلَيكِ جازِرُ",12,"ر",1,0],["إذا ابتسمت في ظلمة الليل أشرقا","فعُدنا من الآمال في أنجم ُزهر",13,"ر",1,0],["إذا ابتسمت لي عزتي ونزاهتي","فلست أبالي بالزمان المعبّس",14,"س",1,0],["إِذا أَباؤنا وَأَبوكَ عُدّوا","أَبانَ المُقرِفاتُ مِنَ العِرابِ",15,"ب",1,0],["إِذا اِبتَسَمَت أَبدَت غُروباً كَأَنَّها","عَوارِضُ مُزنٍ تَستَهِلُّ وَتَلمَحُ",16,"ح",1,0],["إِذا اِبتُدِرَ المَكارِمُ كانَ فيكُم","رَبيعُ الناسِ وَالحَسَبُ الأَثيلُ",17,"ل",1,0],["إذا ابتسر الحرب أخلامها","كشافاً وهُيَّخَتِ الأفحل",18,"ل",1,1],["إِذا اِبنُكِ سارَ في بَرٍّ وَبَحرٍ","فَمَن يَدعو لَهُ أَو يَستَجيرُ",19,"ر",1,0],["إذا أبصرت جدّاً من زمان","فخالطه بشيءٍ من مزاح",20,"ح",1,0],["إذا ابن عليّ سار في الشعرِ ذكره","فقل حسناً زكَّى قصيداً ومقصدا",21,"د",2,0],["إذا ابن عليٍّ وابن يحيى تساجلا","فقل طارف المجد الرَّضي وتليده",22,"د",2,0],["إذا ابْتدروا غايات لفظٍ رأيتهم","من الروض أنشى أو من الريح أنشطا",23,"ط",2,0],["إذا ابن تقيّ الدِّين جاد نباته","علينا فلا مدّت يدُ النيل أصبُعا",24,"ع",2,0],["إذا ابْيضَّ مسود العذار فإنما","هوَ الصبح للّذّات بالليلِ قاطع",25,"ع",1,0],["إذا ابن قَومٍ وإن كانوا ذوي كرمٍ","لم يفعلِ الخير أمسى غير مُنتجَبِ",26,"ب",1,0],["إذا أبصرَ الدنيا اسْتَهلَّ كأنه","بما سوف يلقى من أذاها يُهَدَّدُ",27,"د",1,0],["إذا أبو قاسمٍ جادتْ لنا يدهُ","لم يُحمَد الأجودانِ البحر والمطرُ",28,"ر",1,1],["إذا أُبدِئَ الطول منهم أُعي","دَ أو أُوتِر العرف فيهم شفع",29,"ع",1,0],["إذا أبصر الدنيا استهلَّ كأنه","يرى ما سيلقى من أذاها ويسمع",30,"ع",1,0],["إذا ابن خِيار بدا","فحَيَّ على لَعْنِهِ",31,"ن",2,1],["إِذا اِبتَدَرا ما تَطرَحُ الكَفُّ فاتَهُ","بِهِ حَبَشِيٌّ كَيِّسُ اللَحَظانِ",32,"ن",1,0],["إِذا أَبصَرَتهُ ذاتُ طِنءٍ تَبَسَّمَت","إِلَيهِ وَقالَت إِنَّ ذا لَخَليقُ",33,"ق",1,0],["إِذا اِبتَدَرَ الناسُ السِجالَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",34,"ح",1,0],["إِذا اِبتَذَلَت حَسناءُ ثُمَّ عَذَلَتها","تَوَلَّت وَقالَت كُلُّكُم مُتَبَذِّلُ",35,"ل",1,0],["إِذا أَبطَل الأَملاك غَيري لِلثَنا","فَإِنّيَ وَضّاحُ الجَبين إِلى المَدحِ",36,"ح",1,0],["إِذا أَبدى الشَبابُ هَوىً وَزَهواً","أَشارَ إِلَيهِ حِلمُكَ وَالأَناةُ",37,"ه",1,0],["إِذا اِبتَسَمَت تَأَلَّقَ عارِضاها","عَلى ضَرَبٍ يُصَفَّقُ في ضَريبِ",38,"ب",1,0],["إِذا أَبَتِ الحُقوقَ نُفوسُ قَومٍ","وَمَلّوا رَجعَ واجِبِها المُعادِ",39,"د",1,0],["إِذا اِبتَلى يَومَ جَداهُ اِمرُؤٌ","أَغناهُ عَن أَن يَتَرَجّى غَدَه",40,"د",2,0],["إِذا اِبتَدَروهُ بِالسُؤالِ اِنتَحى لَهُم","عَلى وَفرِهِ حَتّى يَجورَ فَيَعتَدي",41,"د",2,0],["إِذا اِبتَدا بُخَلاءُ الناسُ عارِفَةً","يَتبَعُها المَنُّ فَالمَرزوقُ مَن حُرِما",42,"م",2,0],["إِذا اِبتَدَرا مَدى مَجدٍ بَعيدٍ","تَمَطَّرَ دونَهُ فَرَسا رِهانِ",43,"ن",1,0],["إِذا اِبنا دُخانٍ واقِفا وِردَ عُصبَةٍ","لِئامٍ وَإِن كانوا قَليلي الحَلايِبِ",44,"ب",1,0],["إِذا اِبنُ أَبي سودٍ خَلا مِن مَكانِهِ","فَقَد مالَتِ الأَيّامُ بِالحَدَثِ المُجلي",45,"ل",2,0],["إذا ابتسمَ الشقائقُ فيه صبحاً","تأوَّد من نسيمِ صِباً عليلِ",46,"ل",1,0],["إذا أبدَعَ المُدَّاحُ أبدَعَ عُرْفُه","فكانَ بما يُسْدي من العُرْفِ أبدَعا",47,"ع",2,0],["إِذا اِبتَدَرَت قَيسُ بنُ عَيلانَ غايَةً","مِنَ المَجدِ مَن يَسبِق إِلَيها يُسَوَّدِ",48,"د",1,0],["إِذا أَبزَت بِهِ يَوماً أَهَلَّت","كَما تُبزي الصَعائِدُ وَالعِشارُ",49,"ر",1,0],["إِذا أَبقَتِ الدُنيا عَلى المَرءِ دينَهُ","فَمافاتَهُ مِنها فَلَيسَ بِضائِرِ",50,"ر",1,0],["إِذا اِبتَسَمَ المَهدِيُّ نادَت يَمينُهُ","أَلا مَن أَتانا زائِراً فَلَهُ الحُكمُ",51,"م",1,0],["إِذا أَبطا الرَسولُ فَظُنَّ خَيراً","فَسوءُ الظَنِّ في عَجَلِ الرَسولِ",52,"ل",1,1],["إِذا اِبتَدَأَ الساقي وَثَنّى وَثَلَّثا","وَجَسَّ لَنا الشادونَ مَثنى وَمَثلَثا",53,"ث",2,1],["إِذا اِبتَسَمَت وَالفاحِمُ الجَعدُ مُسبَلٌ","تُضِلُّ وَتَهدي مِن ظَلامٍ وَمِن ظَلمِ",54,"م",1,0],["إذا أبدلوا بالباءِ حرفَ ختامِهِ","ترى اسماً وفعلاً ثم حرفاً له وبرْ",55,"ر",1,0],["إِذا اِبتَسَمَت قُلتَ اِنكِلالُ غَمامَةٍ","خَفى بَرقُها في عارِضٍ مُتَهَلِّلِ",56,"ل",1,0],["إِذا اِبتَدَرَت أَجادِلُها مَطاراً","أَسَفَّ النَسرُ وَاِنحَطَّ الأَنوقُ",57,"ق",1,0],["إِذا اِبتَدَرَ السُرى مِنها فَريقٌ","تَعَثَّرَ في مَساريهِ فَريقُ",57,"ق",1,0],["إذا أبصرتَ دهرك مستريباً","فدافعه بِعَزمٍ مُكفَهِرِّ",58,"ر",1,0],["إذا أبدَتِ الأزْبادَ في الصَّحن راعَنا","بِرازُ كميِّ البأسِ من فوقه دِرع",59,"ع",1,0],["إِذا ابتَدَرَ الناسُ الفِعالَ فَخُذ عَصاً","وَدَعدِع بِمَعزى يا ابنَ طالِقَةِ الذَربِ",60,"ب",1,0],["إِذا اِبتَهَلتُ سَأَلتُ اللَهَ رَحمَتَهُ","كَنَّيتُ عَنكَ وَما يَعدوكَ إِضماري",61,"ر",2,1],["إذا أبصرتَ أكّالاً","للحم الصيدِ في الحرم",62,"م",1,0],["إِذا اِبتَسَمَت جادَت جُفوني بِوابِلٍ","مِنَ الغَيثِ أَجرَتهُ بُروقُ المَباسِمِ",63,"م",1,1],["إِذا أَبصَرَ المَرءُ المُروءَةَ وَالتُقى","فَإِنَّ عَمى العَينَينِ لَيسَ يَضيرُ",64,"ر",1,0],["إِذا اِبنُ داوودَ أَعطاني مَعونَتَهُ","كانَ الفَراغُ وَلَم أَربَع عَلى عودِ",65,"د",1,0],["إِذا اِبنا أَبٍ واحِدٍ أُلفِيا","جَواداً وَعَيراً فَلا تَعجَبِ",66,"ب",1,1],["إِذا أُبيدَت فَما عِندي إِذا أُخِذَت","فَرعٌ يَنوبُ وَلا عَذراءُ تُفتَرَعُ",67,"ع",1,0],["إِذا اِبتَهَجتَ وَأَعطاكَ المَليكُ غِنىً","غَدَوتَ كَالرَبعِ لَم تُحمَد عَوافيكا",68,"ك",2,0],["إِذا اِبتَكَرَت إِلى العَرّافِ فَاِعرِف","مَكانَ عَصا تَصِكُّ بِها قَراها",69,"ا",3,1],["إِذا اِبتَدَرَ القَومُ السِلاحَ وَجَدتَني","مَنيعاً إِذا بَلَّت بِقائِمِهِ يَدي",70,"د",2,0],["إِذا أَبرَزَ الرَوعُ الكَعابَ فَإِنَّهُم","مَصادٌ لِمَن يَأوي إِلَيهِم وَمَعقِلُ",71,"ل",1,0],["إِذا اِبتَسَمَت في الليلِ وَالليلُ دُونَها","أَضاءَ دُجى الليلِ البَهِيمِ اِبتِسامُها",72,"ه",2,0],["إِذا ابْتَسَمْنَ فَدُرُّ الثَّغرِ مُنْتَظمٌ","وَإنْ نَطَقْنَ فَدُرُّ اللَّفظِ مَنْثُورُ",73,"ر",1,0],["إذا أَبصرت عيناً إليها تُصوِّبُ","فَقلت لَهم إني فَلا تتكذّبوا",74,"ب",3,0],["إِذَا أَبْصَرُوا شَخْصَاً يَقُولُونَ جَحْفَلٌ","وَجُبْنُ الْفَتَى سَيْفٌ لِعَيْنَيْهِ بَارِقُ",75,"ق",1,0],["إِذَا أَبْصَرُونِي فِي النَّدِيِّ تَحَاجَزُوا","عَنِ الْقَوْلِ وَاسْتَغْنَوا عَنِ الْعُرْفِ بِالنُّكْرِ",76,"ر",1,0],["إِذَا أَبْصَرَتْ زُرْقَ الْمَوَارِدِ رَفْرَفَتْ","عَلَيْهَا فَطَافٍ فَوْقَهَا وَغَرِيقُ",77,"ق",1,0],["إذا أبرَمَ الخصمُ المعاندُ برمةً","فيا ويحه صُبَّتْ عليه الصواعقُ",78,"ق",1,0],["إذا ابتسموا فالباتراتُ بواسمٌ","وإن غضبوا فالباتراتُ غِضاب",79,"ب",1,0],["إِذَا أَبْصَرَ الإِحْسَانَ فيها تَلأْلأَتْ","أَسَارِيرُه واهْتَزّ بالعُجْبِ جَانِبُه",80,"ب",2,0],["إذا ابنُ أبي الهَيْجاءِ هِيجَ تَجَهَّمَتْ","وُجوهُ المَنايا في ظُبّىً تَتَبَسَّمُ",81,"م",1,0],["إذا ابتدر القوم السلاح وجدتني","منيعاً إذا ابتلت بقائمه يدي",82,"د",2,0],["إذا ابتدرَ النّاسُ المكارمَ بزَّهمْ","عَرَاضَة ُ أَخْلاَقِ ابنِ لَيْلَى وَطُولُها",83,"ل",3,1],["إذا أُبدىء الطَّوْلُ منهم أُعي","د أو أُوتر العُرف فيهم شُفِع",84,"ع",1,0],["إِذَا ابْتُذِلَتْ جَفَّتْ وَلَوْ صِينَ كِمُّهَا","وَلَمْ تَسْتَعِدْ زَهْواً وَطِيباً مِنَ الطَّلِّ",85,"ل",1,0],["إذا أبصرت دهرك مكفهراً","فدافعه بعزمٍ مكفهر",86,"ر",1,0],["إذا أَبصَر المحزون أَرضَ شَذُونةٍ","وحُسن مُحيّاها أَفاقَ مِنَ الحُزن",87,"ن",1,1],["إِذَا ابتَسَمَت خِلتَ البُرُوقَ إبتِسَامَهَا","سَناً في هَوَاءٍ مِثلُ آخَرَ في هَوَا",88,"و",2,0],["إِذا أَبْصَرَتْكَ العَيْنُ جَادَتْ بِمُذْهَبٍ","عَلَى مَذْهَبٍ فِي الخَدِّ بَيْنَ المَذاهِبِ",89,"ب",1,0],["إِذا أَبْرقتْ ضرباً سيوفُك أَمطرتْ","رؤوسَ الأَعادي فَوق أَرْضِ المصائبِ",89,"ب",1,0],["إذا ابطات عنا من المحسن الحسنى","حمدناه علما إن موجبه منا",90,"ن",2,1],["إذا أباح الغنا والدف في عرس","جعلته دينه المرقوم في الكتب",91,"ب",1,0],["إِذا ابتَسَمَت ظَمياءُ وَاللَّيلُ مُسدِفٌ","تَجَلَّى ظَلامُ اللَّيلِ حِينَ تُباشِرُه",92,"ر",2,0],["إذا أبرم التيار داراته حكى","أنامل خرّاط يحرّر مُدْهُنا",93,"ن",2,0],["إذا أبصرت رأسا فيه طول","كمثل الدرج أو سفط لتمّه",94,"م",2,1],["إذا ابن جميل مشى خلتنا","تموج بنا إن مشى زلزله",95,"ل",2,1],["إذا أبصرت أعمى في طريق","فقده من الطريق إلى المضيق",96,"ق",1,0],["إذا أبصرت كوخا في طريق","عليه معلقا ترس وسيف",97,"ف",1,1],["إذا أبصرت أعمى فيه خير","فقد ترك الخبيث ردي طباعه",98,"ع",2,0],["إذا ابتغيتُ كؤوسَ الراحِ مُتْرَعةً","أَوْمَتْ إليَّ يدُ الأصباحِ بالشفق",99,"ق",1,0],["اذا ابرقوا في الحرب صاروا صوارما","وان رعدوا اسدا وان مطروا مزنا",100,"ن",2,0],["إذا ابتسمتْ في شعرِها وهو مُنْشَرٌ","فللهِ برقٌ بالظلامِ قَبيسُ",101,"س",1,0],["إِذا اِبتَسَمت فَاللُؤلُؤُ الصِرفُ ثغرها","وَإِمّا بَكَت فَالماسُ تَحتَ الحَواجِبِ",102,"ب",1,0],["إذَا أبتِ الليالِي أن تُريني","عدوّي نهب عادية الضباع",103,"ع",1,0],["إذَا أَبْصَرُوا شَرْيَانَ فَقْرِكَ نَابِضاً","قَلَوْكَ وَإِنْ كُنْتَ الْعَلِيمَ الْمُنَجَّذَا",104,"ذ",2,0],["إذا ابتدرَ الناسُ المكارَمَ نِلتَها","بسابقِ عَزمٍ لا يَملُّ مِنَ الحصرِ",105,"ر",1,0],["اذا ابتَسَمت على همِّي وغمِّي","أرى المأمونَ يجتازُ الدروبا",106,"ب",2,0],["إِذا ابْنُ عَلِيٍّ رامَ يَوْماً بَحِزْمِهِ","لِقاءَ خُطُوبِ الدَّهْرِ دَقَّ جَلِيلُها",107,"ل",3,0],["إِذا اِبتَسَمنَ في الدُجى فَغَمنَ بِال","مِسكِ الفَلا وَاِنجابَتِ الدُجُنَّه",108,"ن",2,0],["إِذا أبرَقت شمسُ الضحى وشيَ طرزها","تَهادوا بأذنابِ الطواويس إذ تربى",109,"ب",2,0],["إِذا اِبتَسَمَت بَدا لَكَ أُقحُوانٌ","أَصابَ نَدى الدُجُنَّةِ بَعدَ رَكِّ",110,"ك",1,0],["إِذا ابنُ عَلِيٍّ تَولَّى العُلى","تولَّى المُغالونَ في وَصفِها",111,"ف",3,0],["إذا أبو الجيش قام منتصِفاً","من الليالي هانت شدائدُها",112,"د",3,0],["إذا أبصرت بالمرء اتضاعاً","فلا تَجهلْه من تلك العلامه",113,"م",2,0],["إذا أبصرْتَ في لَفظي فُتوراً","وخَطَّي والبَلاغَةِ والبَيانِ",114,"ن",1,1],["إِذا أَبرَمَت أَمراً فَلِلجودِ أَمرها","وَإِن هيَ لَم تُبرَم فَفيهِ اشتوارُها",115,"ر",3,0],["إذا ابتَسَمَتْ والقرمُ تدمى كلومُهُ","بكَتْ بدمٍ قانٍ بتلك المباسم",116,"م",1,0],["إذا آب الرجاءُ إليه لاقى","بساحة مجده حسن المآب",117,"ب",1,0],["إذا أبْعَدَته ملوك الزمان","تُقَبّلُ منه مكان القدم",118,"م",1,0],["إِذا أَبْصَرْتَ ناظِرَنَا","وقد حَفَّتْ بِهِ الخَدَمُ",119,"م",1,1],["إذا ابْنُ آوى تولّتْهُ سعادته","أوى إليه مُطيعاً كاسرُ الأسدِ",120,"د",1,0],["إذا ابتهل الداعونَ كان دُعَاؤها","ألا يا بني عبد الرحيم اسلموا لنا",121,"ن",2,0],["إذا أبى طارت به حَميَّةٌ","علويَّةٌ أقربُ برجَيْها السما",122,"م",2,0],["إذا أبصر العقل في قسمةٍ","تعجّب من غلَط الكائلِ",123,"ل",1,0],["إذا ابتاع المكارم لم يُسفِّه","من الأعواض ما فيها يبيعُ",124,"ع",1,0],["إذا أبتُمُ سُرَّتْ وإن بنتم سُرَتْ","وراءكُمُ تقفو علاكم وتتبعُ",125,"ع",1,0],["إذا ابتدر الغاراتِ كان سهامُها","له من قتيلٍ أو أسيرٍ مصفَّدِ",126,"د",1,0],["إذا إِبِلي أمستْ تُماطَلُ رَعْيَها","فهل يَنفَعنِّي من بلادٍ خَصيبُها",127,"ب",3,0],["إِذا أَبدى مُؤامَرَةَ التَجَنّي","أَقَمتُ لَها وُجوهَ الإِحتِمالِ",128,"ل",1,0],["إِذا اِبتَسَمَ الرَوضُ عَن ثَغرِهِ","جَلَتهُ مُساويكُ أَمطارِهِ",129,"ر",2,0],["إذا ابتسمت أجفانه وجفانه","رأيت جبين المجد أبلج مسفرا",130,"ر",2,0],["إذا أَبْدَيْتَ عُذْراً للمطايا","فَمَاذا عُذْرُ مَنْ تَرَكَ العِهادا",131,"د",2,0],["إِذا أبهتَته من مساعيك خلَّةٌ","تمنّى لها أنّ العيون هواجعُ",132,"ع",1,0],["إِذا أَباحَت حِمى قَومٍ عُقوبَتُهُ","غادى لَهُ العَفوُ قَوماً بِالمَراصيدِ",133,"د",1,0],["إذا ابتُلِيتَ بأمرٍ لا تُطيقُ لهُ","دفعاً فبالصَّبرِ عالجهُ ولا تَزِدِ",134,"د",1,0],["إذا أَبصَرتُ نارَهُما تَمَنَّى","فُؤَادي أَنَّهُ قد كان فَحْما",135,"م",2,0],["إِذا ابْتَسمت لم تُبق للشَّمْسِ آيَةٍ","وتغتاظُ منها الشَّمْسُ إِذْ يَفْرحُ البدرُ",136,"ر",1,0],["إِذا ابتسم الوِصال يهيم عِشقاً","وإِن عَبَس الصّدودُ سلا ومَلاّ",137,"ل",2,0],["إِذا ابتسمتْ سيوفُ الهند يوماً","فمَبْسِمُها يدلُّ على النّحيب",138,"ب",1,0]]}