{"poems":[[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[51,"ذكر الأخفش القديم فقلنا","https://www.aldiwan.net/poem65885.html","الخفيف"],[91,"نظرت دودة تدب على الأرض","https://www.aldiwan.net/poem8792.html","عموديه"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[62,"قد قلت للتلميذ أذهله","https://www.aldiwan.net/poem52195.html","أحذ الكامل"],[45,"كم ليلة ذات أجراس وأروقة","https://www.aldiwan.net/poem62684.html","البسيط"],[66,"ما عشت لا زاركم إلا ثناي وإن","https://www.aldiwan.net/poem40956.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[46,"لا تطيعي هواك أيتها النف","https://www.aldiwan.net/poem22141.html","الخفيف"],[46,"العالم العالي برأي معاشر","https://www.aldiwan.net/poem23316.html","الكامل"],[51,"ذُكِر الأخفشُ القديمُ فقُلنا","https://www.poetsgate.com/ViewPoem.aspx?id=30256",""],[125,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem23783.html","الرمل"],[129,"فلا تحسبن البعد يمحو ودادكم","https://www.aldiwan.net/poem50664.html","الطويل"],[222,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[226,"ابن إبراهيم طب إنا وإن","https://www.aldiwan.net/poem55182.html","الرمل"],[260,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[260,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[283,"ألا هل إلى الخل الوصول وصول","https://www.aldiwan.net/poem32645.html","الطويل"],[321,"كان عيد الفدا لحظك أوفر","https://www.aldiwan.net/poem67178.html","الخفيف"],[321,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[362,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[367,"أهدت لك العنبر في وسطه","https://www.aldiwan.net/poem17111.html","السريع"],[367,"جهادك النصر لا لولا تنغصه","https://www.aldiwan.net/poem17221.html","البسيط"],[367,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[392,"ضاقت أسباب البرايا","https://www.aldiwan.net/poem54437.html","عموديه"],[392,"الحذر كل الحذر كل الحذر من","https://www.aldiwan.net/poem54520.html","عموديه"],[392,"طلب الراحة في الدنيا محال","https://www.aldiwan.net/poem54543.html","عموديه"],[392,"يا طالبا جنة الدنيا وراحتها","https://www.aldiwan.net/poem54544.html","عموديه"],[404,"هذي مناسك أحمد وصفاته","https://www.aldiwan.net/poem33477.html","الكامل"],[417,"أتى ببراهينٍ غدا كل جاحد","https://www.aldiwan.net/poem54154.html","الطويل"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[501,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[501,"من بات ملتحفا في ذيل منقبتي","https://www.aldiwan.net/poem38000.html","البسيط"],[501,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[559,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"]],"verses":[["فالزم المنقاش واعلم","أنه دهر ارتفاق",0,"ق",1,0],["فالزمِ الصّدْق إنه للفريقَي","نِ نجاةٌ والخَتْلُ يجزيك خَتلا",1,"ل",2,0],["فَاِلزُمي الأَرضَ فَهيَ أَحنى عَلى الدودِ","وَخَلّي الكَلامَ فَالصَمتُ أَريَح",2,"ح",1,0],["فَالزَهرُ في الحَقلِ أَشلاءٌ مُبَعثَرَةٌ","وَالطَيرُ لا طائِرٌ إِلّا جَناحاكِ",3,"ك",1,0],["فالْزَمِ القبر فهوَ بيتٌ شبيهٌ بكَ","في صَمْتِ قلبِه وخرابِهْ",4,"ه",1,0],["فَاِلزَمِ التَمَّ أَيُّها البَدرُ دَوماً","وَاِلزَمِ البَدرَ أَيُّهَذا التَمامُ",5,"م",1,0],["فالزئبق الفرّار تصحبه","أرواح أجساد إذا أَبِقا",6,"ق",2,0],["فَالزَوُّ وَالجَوسَقُ المَيمونُ قابَلَهُ","غَنجُ الصَبيحِ الَّذي يُدعى بِصَنّاجِ",7,"ج",1,0],["فَأُلزِمُ النَفسَ نَشري نَشرَ ذِكرِكُمُ","إِنّي حَضَرتُ وَأَطوي عَنكُمُ خَبَري",8,"ر",2,0],["فَالزَم حِماهُ تَجِد ما شِئتَ مِن أَرَبٍ","وَشِم نَداهُ إِذا ما البَرقُ لَم يُشَمِ",9,"م",1,0],["فَاِلزَمي النُسكَ إِن عَلِقتِ وَفِرّي","مِن ذَوي الجَهلِ كَي تُعَدِّيَ لَبيبَه",10,"ب",2,0],["فَاِلزَم ذَراكَ وَإِن تَشَعَّثَ جُدرُهُ","فَالعِسُّ قَد يَرويكَ وَهوَ مُثَلَّمُ",11,"م",1,0],["فالزمِ الصّدْق إنه للفريقي","يْنِ نجاة ٌ والخَتْلُ يجزيك خَتلا",12,"ل",2,0],["فالزمان الغض رهن للصبا","والصبا سعد فقل إني معك",13,"ك",1,0],["فأَلْزَمُ من طوق الحَمامِ مودَّتي","وأثبتُ رسماً من خطوط الرواجبِ",14,"ب",1,0],["فالزهر والطير فيك حي","والله والناس والشجر",15,"ر",1,0],["فَاِلزَمِ العُرفَ تَعِش في ظِلِّنا","في عدادِ الكاتِبين المُكرَمين",16,"ن",1,0],["فالزم أخي بالذلّ طيبَ مجلسهْ","وانشق لطيب طيبه من أنفسِهْ",17,"ه",1,0],["فالزم بذلك أبوابَ العزيز وقم","وصفّ أقدامَ وصف الاقتِفا وقف",18,"ف",1,0],["فَألزمُهُ بِالعَشرِ عَشر أَنامِلي","وَيَنفُضُها حَتّى يَكادُ يَزولُ",19,"ل",1,0],["فَالزَمِ الخَيرَ كَيفَما أَنتَ وَاِعلُ","فَوقَ تِلكَ الرِقابِ بِالحَزمِ وَاِنحَرُ",20,"ر",1,0],["فَالزَم فَدَيتُ خُطَّةً","كُلَّ عَلَيها شاكِرُ",21,"ر",1,0],["فَالزَمانُ الخؤن أَنجَل من أَن","يَتَقاضى مِن غدوة لِمساء",22,"ا",2,0],["فَالزِرُّ في العَنبَرِ مَعناهُما","زُر هَكَذا مُستَتِراً في الظَلامِ",23,"م",1,0],["فَالزَغفُ في اللَهِ تُبليهِ وَتُخلِقُهُ","وَالسَيفُ في اللَهِ تُغليهِ وَتُرخِصُهُ",24,"ص",2,0],["فَأَلزَمُ حَيّاً كِسرَ دارٍ تَضيقُ بي","كَما يَلزَمُ المَوتى المَلاحِدَ في القَبرِ",25,"ر",1,0],["فالزموها باقتصاد","واجعلوها أعلى بضاعه",26,"ع",2,0],["فالزم الذكر تنل ما لاخطر","في قلوب الناس في حين القفول",27,"ل",1,0],["فالزهاده والقناعة مالهم","بختهم طوبى لهم نعم الرجال",28,"ل",1,0],["فالزم الله وجالسه وكن","لسواه من جميع الغير قال",28,"ل",1,0],["فالزم لطاته واشكر لنعمته","واصبر لنقمته في حال أو مال",29,"ل",1,0],["فالزم طريقته وكن متمسكاً","بفعاله وبهديه وبقيله",30,"ل",2,0],["فألزمه بالحقّ والحقّ قوله","فأسْلَمَ من بعد الجحود وسلّما",31,"م",2,0],["فالزَّينبيُّ بحقِّهِ وبصدْقهِ","للطَّالبيِّ فتى العُلى يَتَقَيَّلُ",32,"ل",1,0],["فالْزَمْ رِجالاً أَجَلَّ اللهُ سيرَتَهُمْ","وكلُّ نيطَتِها ذوقٌ وعِرْفَانُ",33,"ن",1,0],["فالْزَمْ حِمانا ولا تنهَجْ لرُحْبِ سِوًى","فنحنُ ساعَدَنا في شأْنِنا القَدَرُ",34,"ر",1,0],["فالْزَمِ الأَولِياءَ قلباً وحقِّقْ","وُدَّهم في سَريرةٍ خَلْصاءِ",35,"ا",2,0],["فألزمك الرحمن أن ترض بالقضا","ولا ترض بالمقتضيِّ فافهم طريقتي",36,"ي",1,0],["فَالزَّهْرُ فِي الرِّوْضِ لِي بِسَاطٌ","والغَيْمُ فِي الجَوِّ لِي شِرَاعُ",37,"ع",1,0]]}