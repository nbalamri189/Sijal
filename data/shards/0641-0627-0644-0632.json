px?id=40442",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5376,"أرَّا ومارَّا والعواصمُ واحدُ","https://www.poetsgate.com/ViewPoem.aspx?id=196641",""],[5431,"للحب منزلةٌ بها تُرضيه ...","https://www.poetsgate.com/ViewPoem.aspx?id=199053",""],[5431,"كنه الحياة ...","https://www.poetsgate.com/ViewPoem.aspx?id=203124",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5490,"نور على نور","https://www.poetsgate.com/ViewPoem.aspx?id=176475",""],[5512,"لا يزهر القلب من غير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=205392",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[5829,"الإمعة","https://www.poetsgate.com/ViewPoem.aspx?id=153912",""],[5906,"يا من بنظرة معجب","https://www.poetsgate.com/ViewPoem.aspx?id=188860",""],[5975,"هذي حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=58788",""],[6068,"سؤال وجواب (الزوجة الثانية)؟ -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175848",""],[6069,"أبت عبرات العين بعدك أن ترقا","https://www.poetsgate.com/ViewPoem.aspx?id=105692",""],[6093,"هَلْ تَأْذَنِيْنَ لِشَاعِرٍ بِلْ عَاشقٌ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=180692",""],[6225,"إلزام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80957&r=&rc=226",""],[2220,"هذي المنازلُ والفؤادُ الساري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11418&r=&rc=292",""],[2220,"الناسُ أولاد حوّاء سواي أنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11456&r=&rc=330",""]],"verses":[["فالزم المنقاش واعلم","أنه دهر ارتفاق",0,"ق",1,0],["فالزمِ الصّدْق إنه للفريقَي","نِ نجاةٌ والخَتْلُ يجزيك خَتلا",1,"ل",2,0],["فَاِلزُمي الأَرضَ فَهيَ أَحنى عَلى الدودِ","وَخَلّي الكَلامَ فَالصَمتُ أَريَح",2,"ح",1,0],["فَالزَهرُ في الحَقلِ أَشلاءٌ مُبَعثَرَةٌ","وَالطَيرُ لا طائِرٌ إِلّا جَناحاكِ",3,"ك",1,0],["فالْزَمِ القبر فهوَ بيتٌ شبيهٌ بكَ","في صَمْتِ قلبِه وخرابِهْ",4,"ه",1,0],["فَاِلزَمِ التَمَّ أَيُّها البَدرُ دَوماً","وَاِلزَمِ البَدرَ أَيُّهَذا التَمامُ",5,"م",1,0],["فالزئبق الفرّار تصحبه","أرواح أجساد إذا أَبِقا",6,"ق",2,0],["فَالزَوُّ وَالجَوسَقُ المَيمونُ قابَلَهُ","غَنجُ الصَبيحِ الَّذي يُدعى بِصَنّاجِ",7,"ج",1,0],["فَأُلزِمُ النَفسَ نَشري نَشرَ ذِكرِكُمُ","إِنّي حَضَرتُ وَأَطوي عَنكُمُ خَبَري",8,"ر",2,0],["فَالزَم حِماهُ تَجِد ما شِئتَ مِن أَرَبٍ","وَشِم نَداهُ إِذا ما البَرقُ لَم يُشَمِ",9,"م",1,0],["فَاِلزَمي النُسكَ إِن عَلِقتِ وَفِرّي","مِن ذَوي الجَهلِ كَي تُعَدِّيَ لَبيبَه",10,"ب",2,0],["فَاِلزَم ذَراكَ وَإِن تَشَعَّثَ جُدرُهُ","فَالعِسُّ قَد يَرويكَ وَهوَ مُثَلَّمُ",11,"م",1,0],["فالزمِ الصّدْق إنه للفريقي","يْنِ نجاة ٌ والخَتْلُ يجزيك خَتلا",12,"ل",2,0],["فالزمان الغض رهن للصبا","والصبا سعد فقل إني معك",13,"ك",1,0],["فأَلْزَمُ من طوق الحَمامِ مودَّتي","وأثبتُ رسماً من خطوط الرواجبِ",14,"ب",1,0],["فالزهر والطير فيك حي","والله والناس والشجر",15,"ر",1,0],["فَاِلزَمِ العُرفَ تَعِش في ظِلِّنا","في عدادِ الكاتِبين المُكرَمين",16,"ن",1,0],["فالزم أخي بالذلّ طيبَ مجلسهْ","وانشق لطيب طيبه من أنفسِهْ",17,"ه",1,0],["فالزم بذلك أبوابَ العزيز وقم","وصفّ أقدامَ وصف الاقتِفا وقف",18,"ف",1,0],["فَألزمُهُ بِالعَشرِ عَشر أَنامِلي","وَيَنفُضُها حَتّى يَكادُ يَزولُ",19,"ل",1,0],["فَالزَمِ الخَيرَ كَيفَما أَنتَ وَاِعلُ","فَوقَ تِلكَ الرِقابِ بِالحَزمِ وَاِنحَرُ",20,"ر",1,0],["فَالزَم فَدَيتُ خُطَّةً","كُلَّ عَلَيها شاكِرُ",21,"ر",1,0],["فَالزَمانُ الخؤن أَنجَل من أَن","يَتَقاضى مِن غدوة لِمساء",22,"ا",2,0],["فَالزِرُّ في العَنبَرِ مَعناهُما","زُر هَكَذا مُستَتِراً في الظَلامِ",23,"م",1,0],["فَالزَغفُ في اللَهِ تُبليهِ وَتُخلِقُهُ","وَالسَيفُ في اللَهِ تُغليهِ وَتُرخِصُهُ",24,"ص",2,0],["فَأَلزَمُ حَيّاً كِسرَ دارٍ تَضيقُ بي","كَما يَلزَمُ المَوتى المَلاحِدَ في القَبرِ",25,"ر",1,0],["فالزموها باقتصاد","واجعلوها أعلى بضاعه",26,"ع",2,0],["فالزم الذكر تنل ما لاخطر","في قلوب الناس في حين القفول",27,"ل",1,0],["فالزهاده والقناعة مالهم","بختهم طوبى لهم نعم الرجال",28,"ل",1,0],["فالزم الله وجالسه وكن","لسواه من جميع الغير قال",28,"ل",1,0],["فالزم لطاته واشكر لنعمته","واصبر لنقمته في حال أو مال",29,"ل",1,0],["فالزم طريقته وكن متمسكاً","بفعاله وبهديه وبقيله",30,"ل",2,0],["فألزمه بالحقّ والحقّ قوله","فأسْلَمَ من بعد الجحود وسلّما",31,"م",2,0],["فالزَّينبيُّ بحقِّهِ وبصدْقهِ","للطَّالبيِّ فتى العُلى يَتَقَيَّلُ",32,"ل",1,0],["فالْزَمْ رِجالاً أَجَلَّ اللهُ سيرَتَهُمْ","وكلُّ نيطَتِها ذوقٌ وعِرْفَانُ",33,"ن",1,0],["فالْزَمْ حِمانا ولا تنهَجْ لرُحْبِ سِوًى","فنحنُ ساعَدَنا في شأْنِنا القَدَرُ",34,"ر",1,0],["فالْزَمِ الأَولِياءَ قلباً وحقِّقْ","وُدَّهم في سَريرةٍ خَلْصاءِ",35,"ا",2,0],["فألزمك الرحمن أن ترض بالقضا","ولا ترض بالمقتضيِّ فافهم طريقتي",36,"ي",1,0],["فَالزَّهْرُ فِي الرِّوْضِ لِي بِسَاطٌ","والغَيْمُ فِي الجَوِّ لِي شِرَاعُ",37,"ع",1,0],["فالزم طريقَتَك المُثلَى وحَسبُك مِن","ضِلِّ الصُّخُورِ بأجسامِ القَوارير",38,"ر",1,0],["فَاِلزَمْ مَجالِسَه تُمنحْ نفائسَه","فَإِنَّ صُحبتَه نَفعٌ بِلا ضَرَرِ",39,"ر",1,0],["فالزرعُ في الأرضِ إذا أخبثَت","ضاعَ وعاد نفعُه بالضِّرار",40,"ر",1,0],["فالزَّهر ما قد راق من بسامها","حسناً وطيباً نفحه يتأرَّج",41,"ج",1,0],["فألزمهم بطن حراقةٍ","وصرت مجاذيفهم سائرينا",42,"ن",2,0],["فَالزَورُ يُصفَعُ عِندَهُ","وَالضَيفُ يُنتَفُ شارِبُه",43,"ب",2,0],["فالزهر ينثر للعرو","س وقد يُرش به الذبيحُ",44,"ح",1,0],["فالزهرة الزهراء بعض إمائه","والمشتري مملوكه وشراه",45,"ا",2,0],["فأَلْزَمْتُهُ خَدِّي ورَوَّيْتُ تُرْبَهُ","بِدَمْعي وباقي حَقِّهِ لم أُوَفِّهِ",46,"ف",2,0],["فالزَّبْرِقانُ مِنَ البَصيرَةٍ نورُهُ","والأفْعُوانُ مِنَ الجِدالِ مُجَاجُهُ",47,"ج",2,0],["فالزم رحابا ضم سبط محمد","فهو الذي بالفيض تهمى راحته",48,"ت",2,0],["فالزعفران درهم وقدره","ملح وقدر درهمين صبره",49,"ه",1,0],["فالزاجُ تسع العفص بالميزان","والماءُ في تقديره مثلانِ",49,"ن",1,0],["فالزم على الاخلاص ثم التقوى","إن رمت أن تلقى المُنى وتقوى",49,"ق",3,0],["فَأَلزَمَهُ عَقل القَتيلِ ابن حُرَّةٍ","وَقال حَبيب إِنَّما كُنتُ أَلعَبُ",50,"ب",1,0],["فَالزَّهْرُ بَيْنَ مُفَضَّضٍ وَمُذَهَّبٍ","وَالرَّوْضُ بَيْنَ مُوَشَّحٍ وَمدَبَّجِ",51,"ج",1,0],["فالزاد قصد وَالشراب تعلل","وَالسير وصل وَالظهور مراقد",52,"د",1,0],["فالزهرُ يكملُ حسناً بالأريجِ كما","يُستحسنُ الحسنَ حيث الطبعَ حَسّانُ",53,"ن",1,0],["فالزهر منطرح والنهر منطفح","والطرف مُنسرح والقلب منشرح",54,"ح",1,0],["فالزهر أسماؤه الحسنى بجملتها","والزهرُ ما أعطتِ السماء من أثر",55,"ر",1,0],["فالزمهريرُ مع الأثير تحكما","بالابردِ والتسخين في الأطوار",56,"ر",1,0],["فَأَلزَمَ قَيساً رَميَةً ذاتَ عانِدٍ","وَسَلَّ وَسَلّا يَضرِبانِ وَيَضرِبُ",57,"ب",1,0],["فَأَلزَمَني الفِراشَ الأَمسَ طولاً","وَإِنّي اليَومَ أَعرُجُ في حِجالي",58,"ل",2,0],["فالزّردُ يوم الغار لم يثبت له","فضلٌ وكان الفضل للخدَرنَق",59,"ق",1,0],["فالزَّيتُ قد قلَّ في فَتيلي","وكادَ أنْ يَنطفي سراجي",60,"ج",2,0],["فالزُّهدُ عندَ عليٍّ فِي الدُّنَى خُلُقٌ","سوَّى بناظِرِهِ الإِبريزَ والمَدَرَا",61,"ر",2,0],["فالزو والقاطول أحسن منظر","وغنا عريب ما لذاك نديد",62,"د",1,0],["فالزم الباب لا تحل عنه","يوماً لم يفز غير من حظي بالحضورِ",63,"ر",1,0],["فالزهر تشرق والأزهار تعبق عن","شذاهم وسناهم فانتشق وشم",64,"م",1,0],["فألزم نفسك اليأس","من الناس تعش حرا",65,"ر",2,0],["فالزهد فرض علي الاعيان قاطبة","في كل دور من الافعال والكلم",66,"م",1,0],["فالزم لسنته من غير ماسرف","فالمسرفون لهم مقت بفعلهم",66,"م",1,0],["فالزم الأشغال إن كنت ترى","أن هجر الخل للخل يطيب",67,"ب",1,0],["فالزي الأخضر في شرفٍ","والزي الأسود والأحمر",68,"ر",1,0],["فالزُّهْرَ أشبهْتُها اجْتِلاءً","والزَّهْرَ أحْكي تضوُّعَهْ",69,"ع",2,0],["فالزَّهْرُ أبدَعُهُ الذي بكِمامِه","والمِسْكُ أعْبَقُهُ الذي لم يُفْتَقِ",70,"ق",1,0],["فألزم شعبه صحبتها","وجرته للمسلك المؤبق",71,"ق",1,0],["فالزمهما في كل حال فهما","سلّم كل طالب للسَّلم",72,"م",1,0],["فَالزَّهرَةُ الحسنا وَميليتا وَعِشتا","روتُ وَالعِزّى إِلى إِيزيسا",73,"س",2,0],["فالزمان المريح تكرار شيء","واحد واطَّراد حال معاد",74,"د",1,0],["فالزهر والجوهر المصفى","صنوان في النور توأمان",75,"ن",1,0],["فالزمي الرمس حين لا","حلمَ في عين باصر",76,"ر",1,0],["فالزم مكانَكَ في الثرى","إن شئتَ، أو فالزم سماءَكْ",77,"ك",1,0],["فالزم بنيه وخذ عنهم طريقته","واسلك على سنن طابت مساعيه",78,"ي",2,0],["فألزمه واعن به فإنك للأولى","سبقوا إذا لازمته لحاق",79,"ق",1,0],["فالزَمي الصَّمتَ في مَكانِكِ إِيَّا","كِ خِلافاً وهاكِ أمرِي فَعِيهِ",80,"ي",2,0],["فَالزائِرونُ بِعبرةٍ نالوا المُنى","وَالوَيلُ مَن لِحِمَى المَفاسد يَمَّما",81,"م",2,0],["فَأَلزَمَ الذَنبُ طَرفي","وَقالَ قَولاً ثَقيلا",82,"ل",2,0],["فالزم نصيحك واحذر كل غائلة","فغير ذلك معدود من الخبل",83,"ل",1,0],["فالزَنَقَاتِ المُشرِقاتِ المُجتَلى","المُورِقاتِ المُونِقاتِ المُجتَنى",84,"ا",1,0],["فالزم الصمت ودار مطلقاً","والعز اغنم يا له غنمٌ وفي",85,"ي",1,0],["فالزم الجنة تسلم","إنما الجنة جنه",86,"ن",2,0],["فالزعفرانُ حشيشُهَا وتُرَابُهَا","مسكٌ يفوحُ بها من الكثبانِ",87,"ن",1,0],["فالزمْ حدودَك يا طبيبُ أمَا ترى..؟","هذا المنوطُ بسطوةِ (المأمور)",88,"ر",1,0],["فالزم ذوي علمٍ ومعرفةٍ","تسلم من الزلات والعطب",89,"ب",1,0],["فالزحفُ آتٍ كالردى لوجاءَ أمرُ","الموتِ هل من مانعٍ أنْ يمنَعَهْ",90,"ع",2,0],["فالزَّنْدُ ..جارَ الزندِ ..يابنَ محمدٍ ..","يا جرجسٌ .. بنيانَ طيلةَ عمرِها",91,"ر",3,0],["فالزّيْغُ عندَهمُ نهارٌ مُبْصِرٌ","والحقُّ ليلٌ طَرْفُهُ مَسْمُولُ",92,"ل",1,0],["فالزاد قربك واللطافة مشربي","و(حلاي) أنت..ملامح الوجه الحسن",93,"ن",1,0],["فالزم - رعاك الله - سنة أحمد","فبها وفي كل المواقف يُكتفى",94,"ف",2,0],["فَالزَّهْرُ يَرْقُصُ وَالطُّيورُ تَنَاغَمَتْ","والكونُ فِي عِشْقِ الَملِيحَةِ يُسْرِفُ",95,"ف",1,0],["فالزهر يحكي في اللفائف كاعباً","والطرس قلباً ضم تلك الكاعبا",96,"ب",2,0],["فالزمْ طريقَ الرُشْدِ يا صاحِ وقُلْ","قولاً تُثَابُ عَلَيْه في يومِ اللقا",97,"ق",2,0],["فالزهر بين تلاثم وتراشف","والغصن بين ترنح وتأود",98,"د",1,0],["فالزم الحق علي دائماً","تغدُ في الناس عليّ القدر",99,"ر",1,0],["فألزم الصدق إذا حدثته","والنصح إن أرشدته فيما دها",100,"ا",1,0],["فالزهر يذبله الجفاف ونى","وقوى الفضا لا تذبل الزهرا",101,"ر",2,0],["فالزمْ أخي هذا الدُعا","عند الصباحِ إلى الغروبْ",102,"ب",1,0],["فالزمْ أخي غرزَ النبيَّ وكن","عبداً سليمَ العقلِ مُتَّزنَا",103,"ن",2,0],["فالزَّايُ قبلَ الرّاءِ والطّاءِ مَعًا","واللامُ قبلَ الهاءِ لا تَتَشَدَّقِ",104,"ق",1,0],["فاَلَّزاهدُ: \"البَرمَاوِى\" نجم حقيقة","فِى الأف