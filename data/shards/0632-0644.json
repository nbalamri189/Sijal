3535",""],[5111,"سَفَرُ الْهَزِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=212112",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5277,"المزّمّلة","https://www.poetsgate.com/ViewPoem.aspx?id=191649",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5327,"زَلزِلِ الطُّغيان","https://www.poetsgate.com/ViewPoem.aspx?id=151528",""],[5419,"قرأت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=32231",""],[5431,"شفاه ثائرة ...","https://www.poetsgate.com/ViewPoem.aspx?id=210289",""],[5433,"كبوة حصان","https://www.poetsgate.com/ViewPoem.aspx?id=36765",""],[5461,"لا تملين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=5023",""],[5525,"زل الطرب","https://www.poetsgate.com/ViewPoem.aspx?id=911",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5593,"زلت في سكري ألمع كفها","https://www.poetsgate.com/ViewPoem.aspx?id=181059",""],[2110,"زر دار مي وقف بالباب إن جازا","https://www.poetsgate.com/ViewPoem.aspx?id=156273",""],[5672,"عطر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206437",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5725,"دهم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=177935",""],[5730,"لا يستوي بالليث يوما قردُ","https://www.poetsgate.com/ViewPoem.aspx?id=211449",""],[5902,"جوى يتلظى فِي الْفُؤَاد استعاره","https://www.poetsgate.com/ViewPoem.aspx?id=189170",""],[5939,"اخضعي","https://www.poetsgate.com/ViewPoem.aspx?id=195299",""],[6008,"زواج الأمير فهد نواف الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60993",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6143,"حسبنا أن نتفق","https://www.poetsgate.com/ViewPoem.aspx?id=34953",""],[6147,"أشْرَاكُ الرُّتَيْلاء.","https://www.poetsgate.com/ViewPoem.aspx?id=151599",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[523,"طبق الأصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1723&r=&rc=86",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["زَلَلتُ في وَقفَتي عَلى طَلَلٍ","بالٍ فَمَن عاذِري مِنَ الزَلَلِ",0,"ل",1,1],["زَلِقَ المَرقى بَعيدَ المُنتَمى","في قِنانٍ لِلمَساعي وَقِلالِ",1,"ل",1,0],["زَلَّ الزَمانُ بِوَطءِ أَخمَصِهِ","وَمَواطِىُ الأَزمانِ لِلعَثرِ",2,"ر",1,0],["زَلزَلَت في أَرضِ مِصرٍ أَنفُساً","لَم يُزَلزِلها قَرارُ المُؤتَمَر",3,"ر",1,0],["زَلزِل بِها في الغَربِ كُلَّ مُكابِرٍ","لِيَرى وَيَعلَمَ ما حَواهُ الغيلُ",4,"ل",1,0],["زلَت إلى العار بهازلّةٌ","شنعاء لا تمحَى ولا تغتفر",5,"ر",1,0],["زَلَلٌ مِنَ الأَيّامِ فيكَ يُقيلُهُ","مَلِكٌ إِذا عَثَرَ الزَمانُ أَقالا",6,"ل",2,0],["زَلِقَتْ رجلُ شنطفٍ في خرَاها","فاستغاثتْ بصفعةٍ في قَفاها",7,"ا",3,1],["زلازلُ موجٍ في غمارٍ زواخرٍ","وهدَّاتُ خَسْفٍ في شطوطٍ خواربِ",8,"ب",1,0],["زلّال بَرٍّ يظلّ يسكنه","بحر بحورٍ يُهلُّ من عَبره",9,"ر",2,0],["زلزلتْ ضرطته بالصَيْمرَهْ","فأعادت كل دار مقبرَهْ",10,"ر",2,1],["زلَّ عن نيَّة فساعد فيه","حسنَ معناه حسنُ لفظ ورصف",11,"ف",1,0],["زلقت في سُلاحها","بالبطبطين شنطُفُ",12,"ف",1,1],["زلَّ الحِمارُ وكانت تيكَ مُنْيَتُه","إن الحمارَ حمارُ السوءِ مَوْحُول",13,"ل",1,0],["زِلتَ عَنها وَهيَ باقَِةٌ","عِظَةً لِلخَلقِ كُلِّهِمِ",14,"م",1,0],["زُلزِلَت زِلزالَها هَذي السَماء","أَم تَرى فُضَّت عَنِ المَوتى الرَجام",15,"م",1,0],["زلت به رجل تخو","ر عن الطريق الامثل",16,"ل",1,0],["زلزل البحر على راكبه","مثلما زلزل قلبٌ ضجرُ",17,"ر",1,0],["زلزلةٌ قدْ وقعتْ في العقبهْ","ترضى من اللحمِ بعظمِ الرقبهْ",18,"ه",1,1],["زُلْفَى المُقرّبِ في أثيمِ كِتابِه","أُمَمٌ تُقَتَّلُ أو شعوبٌ تُنْحَرُ",19,"ر",1,0],["زَلزَلوا الدُّنيا فَرِيَعتْ وانْقَضَى","صَلَفُ الدَهرِ وَطُغيانُ الغِيَرْ",20,"ر",1,0],["زَلَّت بِأَفهامِ الثِقاتِ قَضِيَّةٌ","الحُكمُ فيها حائِرٌ مَذعورُ",21,"ر",1,1],["زَلزَلتَ أَقطارَ البِلادِ فَلَم تَبِت","إِلّا عَلى خَطَرٍ مِنَ الزَلزالِ",22,"ل",1,0],["زلْزِلْ جُنودَ الرُّومِ وَاهْدِمْ مُلكَهُمْ","في عزّهِ العالي فنِعمَ الهادِمُ",23,"م",1,0],["زُلزِلُوا من أبي بَصيرٍ بخطبٍ","بالغٍ صَدْعُهُ أبَى أن يُرَمّا",24,"م",2,0],["زلزل الرَوض عند ذَلِكَ بِالأَل","حان فاِسمَع رِوايَتي عَن صداها",25,"ه",2,0],["زُلتُ عَنها إِلى صُقورِ بَني عَم","روٍ وَلاقى آسادَ تِلكَ الصُقورِ",26,"ر",1,0],["زلزلَ العالَم من أقطاره","بقُوى الرُّوح على القوم الطغامِ",27,"م",1,0],["زلَّةٌ تورِثُ الحِجى","وتُرِي اللَّهَ من كفَرْ",28,"ر",1,0],["زَلَّتْ بِهِ قَدَمٌ إلى مُتَحَدَّرٍ","لِلْمَاءِ مُبْيَضِّ الجَوَانِبِ صَاخِبِ",29,"ب",1,0],["زُلتُ فَسَيفي بِلا غِرارٍ","وَثَوبُ مَجدي بِلا طرازِ",30,"ز",1,0],["زلّاتُهُ أَثقَلَتهُ ظَهراً","وَأَنتَ خفٌّ فَما يُوازي",30,"ز",2,0],["زُلزِلَت الأَرضُ بي لِما بي","وَاِهتَزَّتِ الشُمُّ لِاِهتِزازي",30,"ز",2,0],["زِلتَ عَنِ الدُنيا وَما","قَضيت مِنها وَطَرَك",31,"ك",1,0],["زلت عنها وهي باقية","عظة للخلق كلّهم",32,"م",1,0],["زلزلت الأمواج زلزالها","واحتضنتها دجنة من دخان",33,"ن",1,0],["زليخاء روحي اقعد الوجد عزمها","وراحت باذيال الهوى تتعلق",34,"ق",1,0],["زَلزَلتَ أَرضَ الرومِ بِالفِتَنِ الَّتي","ظَلّوا يَرَونَ اليَومَ مِنها عاما",35,"م",2,0],["زَلِقتُ بِحُبِّ الحِبِّ ثمَّ اختَبرتُهُ","فأعوزَ فيهِ الصَّبرُ والوَصلُ أعوَزُ",36,"ز",1,0],["زلة جاءت ولكن من فتى","قلبه بالحب للدين عجن",37,"ن",1,0],["زِلتُ في أَمرِهِ أَكَفكِفُ دَمعاً","ساقَهُ لِلجُفونِ شَوقٌ حَميزُ",38,"ز",1,0],["زلزلَ الخطبُ عندَها الأرواحا","جُنَّ بعضُ الأصحابِ والبعضُ ناحا",39,"ح",2,0],["زَلزلوهم وَالريحُ هاجت فكلٌّ","كُفِئَت قدرهُ وخرّ الخباءُ",40,"ا",2,0],["زلزلت قلبي وأودت","برؤاه الذهبيّه",41,"ه",1,0],["زلازل البركان لما دعت","أن سئمت بركانها المحتدم",42,"م",1,0],["زلازلُ ويلٍ ما تني الأرضُ تحتها","تهزهزُ حتى أوشكتْ تتصدَّعُ",43,"ع",1,0],["زُلاليَ مَعقودٌ بِسُكَّرِ لَفظِهِ","وَطيبيَ مَعجونٌ عَلَيهِ مُخَمَّرُ",44,"ر",1,0],["زُلالُه في السِلمِ رَقراقَةٌ","وَصَخرُهُ في الحَربِ جُلمودُ",45,"د",1,0],["زللتُ ولكنِّي رجعتُ إلى الهُدى","وقد وَضَحت لقلبِ منهُ رُموزُ",46,"ز",1,0],["زُلزلت مِن صواعقٍ ورعودٍ","أَرضهُ بالخسوفِ والرجفانِ",47,"ن",1,0],["زلّاته جزئيةٌ لا تَختشي","تُمحَى بأدنى فعل برٍّ مُنعِم",48,"م",1,0],["زلَّت فضلت عن هداه فكفَّها","نقصٌ عن الأوج الفسيح الأربُع",49,"ع",1,0],["زلَّت بجَذب زمامها حتى انحنى","منها وفيها أرؤسٌ ورقاب",50,"ب",1,0],["زلزلتَ بالسيف أركاناً مشيدة","تكاد تلحق بعد العين بالأثر",51,"ر",1,0],["زلت بي النعل فيما أنت ساخطه","وقد سألتك أرجو ستر زلاتي",52,"ت",2,0],["زليق اللِّبْدِ مقطوع الأواخِي","غضيض السرج مخلوعَ العنانِ",53,"ن",1,0],["زلَّ الزمانُ غداةَ يومك زَلَّةً","لا تُتَّقَى خجلاتُها بلثامِ",54,"م",1,0],["زَلاَلةٌ طيِّبةٌ ريحُها","ما قيل للساقي بها رقِّقِ",55,"ق",1,0],["زليقاً ترى حائماتِ العُيوب","ولو طرن ما شئن عنه وقوعا",56,"ع",2,0],["زلزلتها بحروبهم فتحركت","منّي التحرك لا من الأشياء",57,"ا",2,0],["زلَّت بهِ قدَمٌ في الأرضِ فامتَلَكتْ","أقدامُهُ في الأعالي كلَّ تَوطيدِ",58,"د",1,0],["زَلَّت به قَدَمٌ جاءَت بهِ مَرَحاً","فرَدّها عن يدٍ والنَّصرُ تاليها",59,"ي",3,0],["زلزلتها إِذ كُنْت في منزلٍ","بالجفن في زلْزلة دائمه",60,"ه",1,0],["زَلَّت بِكَ القَدَمُ العَثُورُ وَهذِهِ","لَيسَت بِأوَّلِ زَلَّةٍ مِن حازِم",61,"م",1,0],["زَلَّةٌ تَشهَدُ القَوافي بِها قَط","عاً إذا استُشهِدَت بُيُوتُ القوافي",62,"ف",2,0],["زلزَل الأرضَ مُصابُ العَرَبِ","وتلاقَى شرقُها بالمغرِبِ",63,"ب",1,1],["زلازل من أيديهمُ وصواعق","بها اليوم صار الضرب في الأرض والطعن",64,"ن",1,0],["زلفي إلى اللّه انتهت وهدية","عظمى تناولها النبي محمد",65,"د",1,0],["زلزلت أرضه فغنّى على زل","زالها ناعم الفؤاد طروبا",66,"ب",2,0],["زلفى يقر بها العباد وموسم","عال تقدمه الربيع جزيلا",67,"ل",2,0],["زلَّ ابنُ مروانَ زلَّةً علنت","فأعلنَ الرمزَ فيه منْ أرمز",68,"ز",1,0],["زَلزلَ الأرضَ فَمارت","إِذ مَذاكيهِ اِستَطارت",69,"ت",1,0],["زلزلة الساعة مولاي عليّ","ومن به للدين برهان جلى",70,"ل",2,0],["زلازل أرواح العدى وسكينة","يَخُصُّ بها أهل الهُدى والأطايبا",71,"ب",2,0],["زلزلت بابن عمك البطل ، الأر","ض فأرغى مزمجراً مزبئرا",72,"ر",2,0],["زَلَّ وَأَقْعَت بِالحَضِيضِ رُوَّمُهْ","عَنْ آبِدٍ مِنْ عِزِّكُمْ لا يَغْسِمُهْ",73,"م",2,0],["زلت به قدمٌ في سيره فهو","إذ كان يمشي مجداًّ مشيَ مرتعد",74,"د",1,0],["زلّت به إلى الحضيض قدمه","يريد أن يعريه فيعجمه",75,"ه",1,0],["زلَّ لكنَّه تراجع لمَّا","ملأت هيبةً حشاه صدوعا",76,"ع",2,0],["زلت الأقدام يا شانئيها","ومواليها حبوراً وعزا",77,"ز",2,0],["زللنا فزلزلنا الجبال بجرمنا","ولولاه وافانا العذاب منجز",78,"ز",1,0],["زَلزل أَزِل أَرعِد ابرِق استَهِلّ صُبِ","لعلّ ما سَرّ هذا الحائن البَطِرا",79,"ر",2,0],["زُلتَ فَلا القَصرُ بِهِيُّ وَلا","بابُكَ مَعمُورٌ كَثِيرُ الزِحام",80,"م",1,0],["زَلَفتُ إِلَيهِم بِالصَفائِحِ وَالقَنا","عَلى كُلِّ لَيثٍ مِن بَني غَطَفانِ",81,"ن",1,0],["زلّومة الفيل منه خلقة الباري","ونابه العاج مع تعويجه عاري",82,"ر",2,1],["زللت بأعين الأغيار لكن","تألق في صراطكمُ جوازي",83,"ز",2,0],["زلّت به قدم احتمالي إنما","مازال إيماني بفضل آلهي",84,"ي",1,0],["زلزالة اهدت قوارعها","إلى الكون اصطلامه",85,"م",2,0],["زل ترى ذاك الذي تطلبه","من وجودي بك مرأى حسنا",86,"ن",2,0],["زلنا عن الأمثالِ لا بل ضربها","لله إذ كنا من الجهلاء",87,"ا",2,0],["زلَّت لآدم قدماً أيُّما قدمٍ","لكن عفا بهم الباري عن الزَلل",88,"ل",1,0],["زَلّ مُخَطِى دِيارِنا لعراقٍ","نَوبةُ الكُردِىّ أرسلَتها الحِجازُ",89,"ز",1,0],["زل عنها متن مصقول القرا","يرتمي في مائها بالحرق",90,"ق",1,0],["زل يخطر لابس أطلس","زركشه من خالص العين",91,"ن",1,0],["زلال الريق في برد الثَنايا","ينز رضابه الشهرى نزّا",92,"ز",2,0],["زلازل سيفه هدمت بنآء","من الأَعدآء حين أَتوه غزّى",92,"ز",2,0],["زِلَّ عليهِ ثُمَّ حَاذِ البَر","إن كُنتَ ذا عِلمٍ بِهَذا البَحَر",93,"ر",1,0],["زَلَّوا بِهَا الإفرَنجُ غَلقَ المَوسمِ","في عِيدِ مِيكَالَ بِالتَّوَهُمِ",94,"م",1,0],["زَلَّت بِكَ القدمُ الخَسرى وَزالَ بِها","عَنِ الهُدى قَدَم بِالضدِّ يَتَّصِلُ",95,"ل",1,0],["زلزلتُ أورشليم حين دخلتها","فتركت فيها الظلم يصرخ نائحا",96,"ح",2,1],["زلقت برجسه شيئاً فشيئ