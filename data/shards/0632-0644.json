{"poems":[[53,"زللت في وقفتي على طلل","https://www.aldiwan.net/poem29858.html","المنسرح"],[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[88,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[47,"أبا العشائر إن أسرت فطالما","https://www.aldiwan.net/poem25183.html","الكامل"],[51,"زلقت رجل شنطف في خراها","https://www.aldiwan.net/poem7993.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"زلزلت ضرطته بالصيمره","https://www.aldiwan.net/poem64012.html","الرمل"],[51,"حاجتي أيها الأمير كتاب","https://www.aldiwan.net/poem65437.html","الخفيف"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[89,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[97,"صورة للبحر أم صورة نفس","https://www.aldiwan.net/poem24941.html","الرمل"],[69,"زلزلة قد وقعت في العقبه","https://www.aldiwan.net/poem29211.html","الرجز"],[105,"ناج الممالك وهي حيرى تنظر","https://www.aldiwan.net/poem42046.html","الكامل"],[105,"اذكرونا في الملمات الكبر","https://www.aldiwan.net/poem42099.html","الرمل"],[105,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[105,"عرف الزمان مصارع الأبطال","https://www.aldiwan.net/poem43391.html","الكامل"],[105,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[94,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[115,"فؤادي بالركب اليماني مقيد","https://www.aldiwan.net/poem40873.html","عموديه"],[143,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[150,"زرعت بماء الدمع في القلب روضة","https://www.aldiwan.net/poem68566.html","الطويل"],[160,"أاتى الإسلام من حيث أمن","https://www.aldiwan.net/poem59195.html","الرمل"],[164,"زفرات للقلب فيها إذا ما","https://www.aldiwan.net/poem67867.html","الخفيف"],[189,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[197,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[199,"يدمدم الحب على قلبه","https://www.aldiwan.net/poem45149.html","السريع"],[199,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[223,"عذيرك من مستلهمين تصدروا","https://www.aldiwan.net/poem39687.html","الطويل"],[235,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[250,"زيارة قبر المصطفى غاية المنى","https://www.aldiwan.net/poem15064.html","الطويل"],[305,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[377,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[377,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[377,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[416,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[441,"حتام طول الأماني والتعلات","https://www.aldiwan.net/poem14355.html","البسيط"],[458,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[458,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[458,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[458,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[562,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[575,"يا ساكن القلي الذي زلزل الدنيا","https://www.aldiwan.net/poem2862.html","السريع"]],"verses":[["زَلَلتُ في وَقفَتي عَلى طَلَلٍ","بالٍ فَمَن عاذِري مِنَ الزَلَلِ",0,"ل",1,1],["زَلِقَ المَرقى بَعيدَ المُنتَمى","في قِنانٍ لِلمَساعي وَقِلالِ",1,"ل",1,0],["زَلَّ الزَمانُ بِوَطءِ أَخمَصِهِ","وَمَواطِىُ الأَزمانِ لِلعَثرِ",2,"ر",1,0],["زَلزَلَت في أَرضِ مِصرٍ أَنفُساً","لَم يُزَلزِلها قَرارُ المُؤتَمَر",3,"ر",1,0],["زَلزِل بِها في الغَربِ كُلَّ مُكابِرٍ","لِيَرى وَيَعلَمَ ما حَواهُ الغيلُ",4,"ل",1,0],["زلَت إلى العار بهازلّةٌ","شنعاء لا تمحَى ولا تغتفر",5,"ر",1,0],["زَلَلٌ مِنَ الأَيّامِ فيكَ يُقيلُهُ","مَلِكٌ إِذا عَثَرَ الزَمانُ أَقالا",6,"ل",2,0],["زَلِقَتْ رجلُ شنطفٍ في خرَاها","فاستغاثتْ بصفعةٍ في قَفاها",7,"ا",3,1],["زلازلُ موجٍ في غمارٍ زواخرٍ","وهدَّاتُ خَسْفٍ في شطوطٍ خواربِ",8,"ب",1,0],["زلّال بَرٍّ يظلّ يسكنه","بحر بحورٍ يُهلُّ من عَبره",9,"ر",2,0],["زلزلتْ ضرطته بالصَيْمرَهْ","فأعادت كل دار مقبرَهْ",10,"ر",2,1],["زلَّ عن نيَّة فساعد فيه","حسنَ معناه حسنُ لفظ ورصف",11,"ف",1,0],["زلقت في سُلاحها","بالبطبطين شنطُفُ",12,"ف",1,1],["زلَّ الحِمارُ وكانت تيكَ مُنْيَتُه","إن الحمارَ حمارُ السوءِ مَوْحُول",13,"ل",1,0],["زِلتَ عَنها وَهيَ باقَِةٌ","عِظَةً لِلخَلقِ كُلِّهِمِ",14,"م",1,0],["زُلزِلَت زِلزالَها هَذي السَماء","أَم تَرى فُضَّت عَنِ المَوتى الرَجام",15,"م",1,0],["زلت به رجل تخو","ر عن الطريق الامثل",16,"ل",1,0],["زلزل البحر على راكبه","مثلما زلزل قلبٌ ضجرُ",17,"ر",1,0],["زلزلةٌ قدْ وقعتْ في العقبهْ","ترضى من اللحمِ بعظمِ الرقبهْ",18,"ه",1,1],["زُلْفَى المُقرّبِ في أثيمِ كِتابِه","أُمَمٌ تُقَتَّلُ أو شعوبٌ تُنْحَرُ",19,"ر",1,0],["زَلزَلوا الدُّنيا فَرِيَعتْ وانْقَضَى","صَلَفُ الدَهرِ وَطُغيانُ الغِيَرْ",20,"ر",1,0],["زَلَّت بِأَفهامِ الثِقاتِ قَضِيَّةٌ","الحُكمُ فيها حائِرٌ مَذعورُ",21,"ر",1,1],["زَلزَلتَ أَقطارَ البِلادِ فَلَم تَبِت","إِلّا عَلى خَطَرٍ مِنَ الزَلزالِ",22,"ل",1,0],["زلْزِلْ جُنودَ الرُّومِ وَاهْدِمْ مُلكَهُمْ","في عزّهِ العالي فنِعمَ الهادِمُ",23,"م",1,0],["زُلزِلُوا من أبي بَصيرٍ بخطبٍ","بالغٍ صَدْعُهُ أبَى أن يُرَمّا",24,"م",2,0],["زلزل الرَوض عند ذَلِكَ بِالأَل","حان فاِسمَع رِوايَتي عَن صداها",25,"ه",2,0],["زُلتُ عَنها إِلى صُقورِ بَني عَم","روٍ وَلاقى آسادَ تِلكَ الصُقورِ",26,"ر",1,0],["زلزلَ العالَم من أقطاره","بقُوى الرُّوح على القوم الطغامِ",27,"م",1,0],["زلَّةٌ تورِثُ الحِجى","وتُرِي اللَّهَ من كفَرْ",28,"ر",1,0],["زَلَّتْ بِهِ قَدَمٌ إلى مُتَحَدَّرٍ","لِلْمَاءِ مُبْيَضِّ الجَوَانِبِ صَاخِبِ",29,"ب",1,0],["زُلتُ فَسَيفي بِلا غِرارٍ","وَثَوبُ مَجدي بِلا طرازِ",30,"ز",1,0],["زلّاتُهُ أَثقَلَتهُ ظَهراً","وَأَنتَ خفٌّ فَما يُوازي",30,"ي",1,0],["زُلزِلَت الأَرضُ بي لِما بي","وَاِهتَزَّتِ الشُمُّ لِاِهتِزازي",30,"ي",1,0],["زِلتَ عَنِ الدُنيا وَما","قَضيت مِنها وَطَرَك",31,"ك",1,0],["زلت عنها وهي باقية","عظة للخلق كلّهم",32,"م",1,0],["زلزلت الأمواج زلزالها","واحتضنتها دجنة من دخان",33,"ن",1,0],["زليخاء روحي اقعد الوجد عزمها","وراحت باذيال الهوى تتعلق",34,"ق",1,0],["زَلزَلتَ أَرضَ الرومِ بِالفِتَنِ الَّتي","ظَلّوا يَرَونَ اليَومَ مِنها عاما",35,"م",2,0],["زَلِقتُ بِحُبِّ الحِبِّ ثمَّ اختَبرتُهُ","فأعوزَ فيهِ الصَّبرُ والوَصلُ أعوَزُ",36,"ز",1,0],["زلة جاءت ولكن من فتى","قلبه بالحب للدين عجن",37,"ن",1,0],["زِلتُ في أَمرِهِ أَكَفكِفُ دَمعاً","ساقَهُ لِلجُفونِ شَوقٌ حَميزُ",38,"ز",1,0],["زلزلَ الخطبُ عندَها الأرواحا","جُنَّ بعضُ الأصحابِ والبعضُ ناحا",39,"ح",2,0],["زَلزلوهم وَالريحُ هاجت فكلٌّ","كُفِئَت قدرهُ وخرّ الخباءُ",40,"ا",2,0],["زلزلت قلبي وأودت","برؤاه الذهبيّه",41,"ه",1,0],["زلازل البركان لما دعت","أن سئمت بركانها المحتدم",42,"م",1,0],["زلازلُ ويلٍ ما تني الأرضُ تحتها","تهزهزُ حتى أوشكتْ تتصدَّعُ",43,"ع",1,0],["زُلاليَ مَعقودٌ بِسُكَّرِ لَفظِهِ","وَطيبيَ مَعجونٌ عَلَيهِ مُخَمَّرُ",44,"ر",1,0],["زُلالُه في السِلمِ رَقراقَةٌ","وَصَخرُهُ في الحَربِ جُلمودُ",45,"د",1,0],["زللتُ ولكنِّي رجعتُ إلى الهُدى","وقد وَضَحت لقلبِ منهُ رُموزُ",46,"ز",1,0],["زُلزلت مِن صواعقٍ ورعودٍ","أَرضهُ بالخسوفِ والرجفانِ",47,"ن",1,0],["زلّاته جزئيةٌ لا تَختشي","تُمحَى بأدنى فعل برٍّ مُنعِم",48,"م",1,0],["زلَّت فضلت عن هداه فكفَّها","نقصٌ عن الأوج الفسيح الأربُع",49,"ع",1,0],["زلَّت بجَذب زمامها حتى انحنى","منها وفيها أرؤسٌ ورقاب",50,"ب",1,0],["زلزلتَ بالسيف أركاناً مشيدة","تكاد تلحق بعد العين بالأثر",51,"ر",1,0],["زلت بي النعل فيما أنت ساخطه","وقد سألتك أرجو ستر زلاتي",52,"ي",1,0],["زليق اللِّبْدِ مقطوع الأواخِي","غضيض السرج مخلوعَ العنانِ",53,"ن",1,0],["زلَّ الزمانُ غداةَ يومك زَلَّةً","لا تُتَّقَى خجلاتُها بلثامِ",54,"م",1,0],["زَلاَلةٌ طيِّبةٌ ريحُها","ما قيل للساقي بها رقِّقِ",55,"ق",1,0],["زليقاً ترى حائماتِ العُيوب","ولو طرن ما شئن عنه وقوعا",56,"ع",2,0],["زلزلتها بحروبهم فتحركت","منّي التحرك لا من الأشياء",57,"ا",2,0],["زلَّت بهِ قدَمٌ في الأرضِ فامتَلَكتْ","أقدامُهُ في الأعالي كلَّ تَوطيدِ",58,"د",1,0],["زَلَّت به قَدَمٌ جاءَت بهِ مَرَحاً","فرَدّها عن يدٍ والنَّصرُ تاليها",59,"ي",3,0],["زلزلتها إِذ كُنْت في منزلٍ","بالجفن في زلْزلة دائمه",60,"ه",1,0]]}