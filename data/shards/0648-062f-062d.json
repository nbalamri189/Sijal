{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[53,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[94,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[71,"إن كنت ناصحي فحسن صبري","https://www.aldiwan.net/poem28764.html","الرجز"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[98,"عدلي يكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66356&r=&rc=32",""],[276,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[276,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[473,"سروري عتاب الفتى","https://www.aldiwan.net/poem59740.html","مجزوء المتقارب"],[473,"ألم بي في ليلة بدرها","https://www.aldiwan.net/poem60173.html","السريع"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126701","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35363","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124045","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86372","الكامل"],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5845,"قفْ بالخضوعِ ونادِ ربكَ يا هو","https://www.poetsgate.com/ViewPoem.aspx?id=15455",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""]],"verses":[["ودَحا البَسيطَةَ فوْقَ لُجٍّ مُزْبِدٍ","ما إنْ يَزالُ علَى القَرارِ حَبيسا",0,"س",2,0],["وَدَّ حُسّادُ عليٍّ","أنهم حَشْوٌ لرمسه",1,"س",2,0],["ودَحَوْتُ الفؤادْ","واحةً للنَّشيدْ",2,"د",1,0],["وَدَّ حسودي فتحَ بابِ الشرِّ","ليستوي زجاجُهُ ودرِّي",3,"ر",2,0],["ودحرجتَهُ عن \" مِصْرَ \" وهوَ مُعرِّسٌ","بأحلامهِ ، يُحصي الخراجَ الذي يُجْبى",4,"ب",2,0],["ودّ حوّلوا إلى السّين مجرا","ه وبثّوا على الطّريق غيونه",5,"ن",2,0],["وَدحا يبسط الأَرض فَرشا مثبتا","بالراسيات وَبالنبات حلاه",6,"ا",2,0],["وَدَحا الأَرض فَهي بحر وَبر","وَوعور مَجهولة وَسهول",7,"ل",1,0],["وَدَحوا فُوَيقَ الأَرض أَرضاً مِن دَمٍ","ثُمَّ اِنثَنوا فَبَنوا سَماءَ غبارِ",8,"ر",1,0],["ود حسادك الملومين لو كا","نوا لديها حجارةً أو حديدا",9,"د",2,0],["وُدٌّ حَلا طَعمُهُ فَذائِقُهُ","لا يَتَشَكّى مَرارَةَ المَلَلِ",10,"ل",1,0],["وَدَحرَجَ السُكرُ بِنا فَاِنثَنى","مِن فَوقِ خَدّي واضِعاً خَدّا",11,"د",2,0],["وَدحرتَ حزب الخائنين وردّهم","وما حَصلوا غير العنا والمتاعبِ",12,"ب",1,0],["ودحا الأرض والسماء بناها","ومن الصخر فجر الأنهارا",13,"ر",2,0],["وَدَحَت مِنَ الأَنهارِ أَرضَ زُجاجَةٍ","وَأَظَلَّها فَلَكٌ يُضيءُ مُنيرُ",14,"ر",1,0],["ودحى بابها لأعلى السموا","ت بعزم كعزمه إذ دحاها",15,"ا",3,0],["ودحاها من بعد ذلك دَحياً","وَهَبَ الأرضَ سرعةَ الدورانِ",16,"ن",1,0],["ودحا الأرض والجبال عليها","بعد تمهيد صنعها أرساها",17,"ا",3,0],["ودحرج للأرض خوذته","أمام خطى الخيل فوق الثرى",18,"ر",2,0],["ودحا البسيط صحارياً وصحاصحا","وسباسباً وفدافداً ووهادا",19,"د",2,0],["ودحر أبرهة من سوء نيته","بالقتل رميا بأحجار من الإرم",20,"م",1,0],["وَدَحَانَا مِنْ شَوْقِنَاْ إِعْتِنَاْءٌ","يَسْتَبِدُّ عَنَادُهُ فِيْ رِدَاْئِيْ",21,"ا",3,0],["ودحرت العدوان براً وبحراً","وقهرت العدوَّ سيفاً صقيلا",22,"ل",2,0],["ودحا بساطَ الأرضِ فرشاً مثبتاً","بالراسياتِ وبالنباتِ حلاهُ",23,"ا",2,0],["ودحرت فكراً أسوداً متربصاً","كَادَ البِّلادَ وحاول التَّضليلا",24,"ل",2,0]]}