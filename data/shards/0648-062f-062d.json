{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[51,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[69,"إن كنت ناصحي فحسن صبري","https://www.aldiwan.net/poem28764.html","الرجز"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[96,"عدلي يكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66356&r=&rc=32",""],[271,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[271,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[406,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[468,"سروري عتاب الفتى","https://www.aldiwan.net/poem59740.html","مجزوء المتقارب"],[468,"ألم بي في ليلة بدرها","https://www.aldiwan.net/poem60173.html","السريع"]],"verses":[["ودَحا البَسيطَةَ فوْقَ لُجٍّ مُزْبِدٍ","ما إنْ يَزالُ علَى القَرارِ حَبيسا",0,"س",2,0],["وَدَّ حُسّادُ عليٍّ","أنهم حَشْوٌ لرمسه",1,"س",2,0],["ودَحَوْتُ الفؤادْ","واحةً للنَّشيدْ",2,"د",1,0],["وَدَّ حسودي فتحَ بابِ الشرِّ","ليستوي زجاجُهُ ودرِّي",3,"ي",1,0],["ودحرجتَهُ عن \" مِصْرَ \" وهوَ مُعرِّسٌ","بأحلامهِ ، يُحصي الخراجَ الذي يُجْبى",4,"ب",2,0],["ودّ حوّلوا إلى السّين مجرا","ه وبثّوا على الطّريق غيونه",5,"ن",2,0],["وَدحا يبسط الأَرض فَرشا مثبتا","بالراسيات وَبالنبات حلاه",6,"ا",2,0],["وَدَحا الأَرض فَهي بحر وَبر","وَوعور مَجهولة وَسهول",7,"ل",1,0],["وَدَحوا فُوَيقَ الأَرض أَرضاً مِن دَمٍ","ثُمَّ اِنثَنوا فَبَنوا سَماءَ غبارِ",8,"ر",1,0],["ود حسادك الملومين لو كا","نوا لديها حجارةً أو حديدا",9,"د",2,0],["وُدٌّ حَلا طَعمُهُ فَذائِقُهُ","لا يَتَشَكّى مَرارَةَ المَلَلِ",10,"ل",1,0],["وَدَحرَجَ السُكرُ بِنا فَاِنثَنى","مِن فَوقِ خَدّي واضِعاً خَدّا",11,"د",2,0]]}