{"poems":[[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[73,"أنت المسبب للولوع","https://www.aldiwan.net/poem11960.html","مجزوء الكامل"],[51,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[29,"ما زال فينا رباط الخيل معلمة","https://www.aldiwan.net/poem6162.html","البسيط"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[70,"طلع العذار عليه حارس","https://www.aldiwan.net/poem42861.html","مجزوء الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[61,"خير أوقاتك في اللذات","https://www.aldiwan.net/poem51639.html","مجزوء الرمل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[69,"كسرت يد من نافر","https://www.aldiwan.net/poem28243.html","مجزوء الكامل"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[46,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"الدين هجر الفتى اللذات عن يسر","https://www.aldiwan.net/poem22620.html","البسيط"],[46,"العدل صعب وكلما عدل ال","https://www.aldiwan.net/poem23185.html","المنسرح"],[46,"علمي بأني جاهل متمكن","https://www.aldiwan.net/poem23410.html","الكامل"],[46,"رب اكفني حسرة الندامة في ال","https://www.aldiwan.net/poem23420.html","المنسرح"],[1,"ما تنظرون بحق وردة فيكم","https://www.aldiwan.net/poem20966.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140932",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[100,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[100,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[50,"عاد الغداة َ الصبَّ عيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21697",""],[1,"ما تَنظُرونَ بِحَقّ وَردَة َ فيكُمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13177&r=&rc=1",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[116,"قلبي اللديغ وانت انت الراقي","https://www.aldiwan.net/poem40879.html","عموديه"],[116,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[144,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[200,"شكوت ما بالقلب من لوعة","https://www.aldiwan.net/poem45204.html","السريع"],[224,"تذكري حين يزف الضحى","https://www.aldiwan.net/poem41618.html","السريع"],[230,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[238,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[272,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[272,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[304,"بي غادة لم ترض بدر الدجا","https://www.aldiwan.net/poem58088.html","السريع"],[306,"زار الوزير مقام غوث صرفا","https://www.aldiwan.net/poem56472.html","الكامل"],[344,"إنا على ما كان من حادث","https://www.aldiwan.net/poem24183.html","السريع"],[353,"فرض الحبيب","https://www.aldiwan.net/poem948.html",""],[354,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[367,"أهل الهوى وذوو العمى شغلوا","https://www.aldiwan.net/poem17325.html","أحذ الكامل"],[381,"منع القرار متيم","https://www.aldiwan.net/poem49236.html","مجزوء الكامل"],[392,"الحذر كل الحذر كل الحذر من","https://www.aldiwan.net/poem54520.html","عموديه"],[392,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[392,"خل المقادير تمضي لا تغالبها","https://www.aldiwan.net/poem54612.html","عموديه"],[394,"العيد زارك نازلا برواقكا","https://www.aldiwan.net/poem53473.html","الكامل"],[410,"ونافستني صروف دهري في","https://www.aldiwan.net/poem31631.html","عموديه"],[417,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[442,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[454,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[459,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[515,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[530,"أنا المفرط حقا","https://www.aldiwan.net/poem37292.html","مجزوء الكامل"],[559,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[559,"قد جاء ربنا لنا","https://www.aldiwan.net/poem33876.html","مجزوء الرجز"],[559,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[559,"هذا الوجود وهذا الواحد الأحد","https://www.aldiwan.net/poem34575.html","البسيط"],[559,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[568,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[568,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"],[577,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"]],"verses":[["وَالظُبى تَقذِفُ الغُمودَ وَماءُ ال","نَقعِ جارٍ عَلى الرُبى وَالوِهادِ",0,"د",1,0],["وَالظَّبيَ وَالضبَّ جَاءَا يَشْهَدَانِ بِأَنْ","لاَ شَيْءَ أَعْظَمُ مِنْ طَهٍ وَيَاسِينِ",1,"ن",1,0],["وَالظُلمُ مِن طَبعِ النِظا","مِ فَإِن ظُلِمتَ فَلا تُمار",2,"ر",1,0],["وَالظافِرُ المَلِكُ المُؤَيَّ","دُ واحِدٌ عَدلُ الجُموع",3,"ع",1,0],["والظلم مخذولة كتائبُهُ","تضرب أدبارها وتكتسع",4,"ع",1,0],["وَالظاعِنينَ عَلى أَهواءِ نِسوَتِهِم","وَما لَهُم مِن قَديمٍ غَيرُ أَعيارِ",5,"ر",1,0],["وَالظِلُّ مَمدودٌ عَلى جَنَباتِها","وَالماءُ مَغمورٌ بِهِ المُخضَوضِلُ",6,"ل",1,0],["وَالظَبيُ فَرَّ مِنَ الحَيا","إِ إِلى المَهامِهِ وَالبَسابِس",7,"س",1,0],["وَالظَنُّ يَأخُذُ في ضَميرِكَ مَأخَذاً","حَتّى يُريكَ المُستَقيمَ مُحالا",8,"ل",2,0],["وَالظَبيِ وَالخَنساءِ وَالذَيّالِ","يَسمَعنَ مِن أَخبارِهِ الأَزوالِ",9,"ل",1,0],["وَالظُلمُ أَن يَبتَغي الفَتى سَبَباً","يَجعَلُهُ وَصلَةً إِلى سَبَبِه",10,"ب",2,0],["وَالظُلمُ أَن تَلحى عَلى عَبرَةٍ","مُظهِرَةٍ ما أَضمَرَتهُ الضُلوع",11,"ع",1,0],["والظَّريفُ الحُرُّ عن إخ","وانِه غيرُ صَبورِ",12,"ر",1,0],["وَالظِلُّ يَسرِقُ في الخَمائِلِ خَطوَهُ","وَالغُصنُ يَخطِرُ خِطرَةَ النَشوانِ",13,"ن",1,0],["وَالظِلُّ يَسرِقُ بَينَ الدَوحِ خُطوَتَهُ","وَلِلمِياهِ دَبيبٌ غَيرُ مُستَرَقِ",14,"ق",1,0],["وَالظَّنُّ أَنَّا لِتَكْرَارِ اْسْتِغَاثَتِنَا","بِهِ تَكَرَّرَ فِينَا الاسْمُ وَاْطَّرَدَا",15,"د",2,0],["والظباءُ الحُورُ إِمّا قَتَلَتْ","لَحَظاتُ العَينِ مِنها لا تَدِي",16,"د",2,0],["والظبيُ مهما عاقَهُ","شيءٌ تيسَّرَ صيدُهُ",17,"ه",1,0],["والظّلمُ مركبُه الهوى وسبيلُه","طُغيانُ جبّارٍ وضعفُ جَهولِ",18,"ل",1,0],["وَالظُلمُ لِلضَعفِ جارٌ لا يُفارِقُهُ","فَإِن رَأى قُوَّةً وَلَّى يُجافيها",19,"ي",3,0],["والظَّنُّ تغريرٌ فكيف إذا التقَى","في الظَّنّ رأيٌ كاذبٌ وجَهول",20,"ل",1,0],["وَالظَبيُ مَسكَنُهُ الفَلا","ةُ مُطَرَّدٌ فيها شَريدُ",21,"د",1,0],["وَالظَبيُ تَصرَعُهُ الحَبا","إِلُ وَهوَ عَن شَرَكٍ يَحيدُ",21,"د",1,0],["وَالظُلمُ أَن تَلزَمَ ما قَد جَنى","عَلَيكَ بَهرامُ وَبَيدَختُ",22,"ت",1,0],["وَالظُلمُ عِندي قَبيحٌ لا أُجَوِّزُهُ","وَلَو أُطِعتُ لَما فاؤُوا بِأَجلابِ",23,"ب",1,0],["وَالظَبيُ أَشجَعُ مِن لَيثٍ وَمِن نَمِرٍ","إِذا أَلَمَّ يُضاهي اللَيثَ وَالنَمِرا",24,"ر",2,0],["وَالظُلمُ يَشقى بِهِ الظُلومُ وَيَر","عاهُ كَرَعيِ الظِباءِ مُبتَقَلَه",25,"ل",2,0],["وَالظُلمُ يُمهِلُ بَعضَ مَن يَسعى لَهُ","وَمَحَلُّ نَقمَتِهِ بِنَفسِ الظالِمِ",26,"م",1,0],["وَالظُلمُ في وَقدَةٍ فَلَو عَرَضَت","شُربَةُ ماءٍ لَما غَلَت بِدَمي",27,"م",2,0],["وَالظُلمُ فَرَّقَ بَينَ حَيَّي وائِلٍ","بَكرٌ تُساقيها المَنايا تَغلِبُ",28,"ب",1,0],["والظلم مفسدة ماحل في بلدٍ","إلا وأزعج فيه أي إزعاج",29,"ج",1,0],["والظم في خلق النفوس فإن تجد","ذا عفةٍ فلعلةٍ لا يظلم",30,"م",1,0],["وَالظُّلْمُ رِقُّ عَشِيرَةٍ لِعَشِيرَةٍ","بِقَضَاءِ جُنْدٍ عِنْدُهُا وَجَوَارِي",31,"ر",2,0],["والظلّ ، يلمحه ، وفي ..","عينيه ، تحترق الهواتف",32,"ف",1,0],["والظلمة الخرسا تلعثم بالرؤى","كتلعثم المخنوق بالكلمات",33,"ت",1,0],["والظلم مهما احتمت بالبطش عصبته","فلم تطق وقفة في وجه تيّار",34,"ر",1,0],["وَالظَّبْيُ تَصْرعُهُ الْحَبَا","ئلُ وهو عن شركٍ يحيدُ",35,"د",1,0],["والظُّلْمُ فَرّقَ بينَ حَبّيْ وَائِلٍ:","بَكرٌ تُساقيها المَنايا تَغلبُ",36,"ب",1,0],["وَالظُّلْمُ باقٍ لَنْ يُحَطِّمَ قَيْدَهُ","مَوْتي وَلَنْ يُودِي بِهِ قُرْباني",37,"ن",2,0],["والظاعنون سروا ويحمل ركبهم","بمهامه البيداء زهر نياق",38,"ق",1,0],["والظن تنعشني روحي ينعشي لو","على اسمه الطيب المبرور نوديت",39,"ت",1,0],["وَالظاعِنونَ مُواصِلوكَ يَدَ النَدى","حَتّى كَأَنَّهُمُ لَدَيكَ نُزولُ",40,"ل",1,0],["والظبي إما كَسَلَتْ عينهُ","تشبهُ الجيدَ بها فالتوى",41,"و",2,0],["وَالظِلُّ يَدعوكِ إِلى لَذَّةِ","الأَحلامِ في لَيلَتِهِ الهاجِدَه",42,"ه",1,0],["والظُّلمُ من لُؤْمِ الطِّبا","عِ وعادَة النفسِ الردِيّه",43,"ي",2,0],["وَالظَّنُّ أَوْ هُوَ الْمُحَقَّقُ أَنَّهُ","مَا إِنْ لَهُ فِي صَبْرِهِ مِنْ ثَانِ",44,"ن",1,0],["وَالظل فيها سموم","وَالحلى فيها حديد",45,"د",1,0],["وَالظَبي حَياه بأحسن منطق","وَالعضو خاطبه وكان مسمما",46,"م",2,0],["والظبي لما لفتت جيدها","هج على الوجه إلى القفر",47,"ر",1,0],["وَالظنّ أنّك لا تزالُ ضمينهُ","في نفسهِ وَالأهل حيثّ تصرّفا",48,"ف",2,0],["وَالظُلمُ حَوضٌ لَيسَ يُسقى بِهِ","ذو مَنعَةٍ في كُلِّ أَمرٍ يُطيق",49,"ق",1,0],["والظلمُ في شَرْعِ الحبيبِ عدالةٌ","مهما جَفَا كنتَ المُحِبَّ المُُولَعَا",50,"ع",2,0],["وَالظبا تيهاً تُعاقبه","وَعَيائي داؤُهُ صَعبا",51,"ب",2,0],["وَالظِلُّ ذو شُعَبٍ وَذو عُشُبٍ","وَكِلاهُما نُسميهِ بِالظِلِّ",52,"ل",1,0],["وَالظَرف فيكَ مَجمَع","وَالحُسن مِنكَ مقسم",53,"م",1,0],["والظفر كل الظفر كل الظفر","في اتباعك للنبي الهادي الرسول",54,"ل",1,0],["والظلم للناس واعرف نحوها في المثال","يا رب يارب يا معطي العطايا الجزال",55,"ل",1,0],["والظلم فاش بلا لوم ولانكر","وللمساكين تخويف وترهيب",56,"ب",1,0],["وَالظَرفُ يوجب أَخذَهُ مَع ظَرفِهِ","فَأَضِف بِهِ طَبَقاً إِلى أَطباقِكا",57,"ك",2,0],["والظلم في الأرض مانعي كل ما","أبغيه حتى زيارة الرمم",58,"م",1,0],["والظِّباء العُفْرُ من آرامها","ما بعينها بجسمي من سقام",59,"م",1,0],["والظلم واللؤم طباع بالفتى","يكتمه العجز ويفشيه القوى",60,"ا",1,0],["والظبي حياه والعود المسن وتل","ك الشاة قد حذرته السم منتقعا",61,"ع",2,0],["والظلم ليس يحد بين خطوبه","من لم يصد خطوبه فمعينها",62,"ن",3,0],["والظَّفَر الحلو له إن عفا","عمداً وإن نَيَّبَ أو ظَفَّرا",63,"ر",2,0],["والظلُّ تقصرُه الصَّبا وتمدُّهُ","والطيرُ يعرِبُ فيه لحن غِنائِهِ",64,"ا",3,0],["والظَّنُّ منّي جَمِيلٌ","وَمَنْ رَجا الْفَضْلَ يَلْقَى",65,"ق",2,0],["والظاهر الإيمان في","ه تقيّةٌ للسامعين",66,"ن",1,0],["والظلل التي أتى","بها ذواتُنا الجسام",67,"م",1,0],["والظاهر الله والأغيار باطلة","والباطن الله لا يدرَى له خبر",68,"ر",1,0],["والظاهر الحق لا شيءٌ بدا معه","والباطن الحق فِقْ يا من له رشد",69,"د",1,0],["والظل أنت وعلمه","في نور طلعته العمود",70,"د",1,0],["وَالظَّرْفُ يَأْبَى لِلظَّرِيْفِ قَطِيْعَتِي","وَالمَجْدُ لاَ يَرْضَى بَهَا وَالخِيْمُ",71,"م",1,0],["والظرف في الآلات شئ يستحبْ","لا سيَّما ما كان منها للأدبْ",72,"ب",1,0],["وَالظُلمُ مَربوطٌ بِأَف","نِيَةِ البُيوتِ أَغَرُّ أَبلَق",73,"ق",1,0]]}