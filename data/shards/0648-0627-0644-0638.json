{"poems":[[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[73,"أنت المسبب للولوع","https://www.aldiwan.net/poem11960.html","مجزوء الكامل"],[51,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[29,"ما زال فينا رباط الخيل معلمة","https://www.aldiwan.net/poem6162.html","البسيط"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[70,"طلع العذار عليه حارس","https://www.aldiwan.net/poem42861.html","مجزوء الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[61,"خير أوقاتك في اللذات","https://www.aldiwan.net/poem51639.html","مجزوء الرمل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[69,"كسرت يد من نافر","https://www.aldiwan.net/poem28243.html","مجزوء الكامل"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[46,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"الدين هجر الفتى اللذات عن يسر","https://www.aldiwan.net/poem22620.html","البسيط"],[46,"العدل صعب وكلما عدل ال","https://www.aldiwan.net/poem23185.html","المنسرح"],[46,"علمي بأني جاهل متمكن","https://www.aldiwan.net/poem23410.html","الكامل"],[46,"رب اكفني حسرة الندامة في ال","https://www.aldiwan.net/poem23420.html","المنسرح"],[1,"ما تنظرون بحق وردة فيكم","https://www.aldiwan.net/poem20966.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140932",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[50,"عاد الغداة َ الصبَّ عيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21697",""],[1,"ما تَنظُرونَ بِحَقّ وَردَة َ فيكُمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13177&r=&rc=1",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَالظُبى تَقذِفُ الغُمودَ وَماءُ ال","نَقعِ جارٍ عَلى الرُبى وَالوِهادِ",0,"د",1,0],["وَالظَّبيَ وَالضبَّ جَاءَا يَشْهَدَانِ بِأَنْ","لاَ شَيْءَ أَعْظَمُ مِنْ طَهٍ وَيَاسِينِ",1,"ن",1,0],["وَالظُلمُ مِن طَبعِ النِظا","مِ فَإِن ظُلِمتَ فَلا تُمار",2,"ر",1,0],["وَالظافِرُ المَلِكُ المُؤَيَّ","دُ واحِدٌ عَدلُ الجُموع",3,"ع",1,0],["والظلم مخذولة كتائبُهُ","تضرب أدبارها وتكتسع",4,"ع",1,0],["وَالظاعِنينَ عَلى أَهواءِ نِسوَتِهِم","وَما لَهُم مِن قَديمٍ غَيرُ أَعيارِ",5,"ر",1,0],["وَالظِلُّ مَمدودٌ عَلى جَنَباتِها","وَالماءُ مَغمورٌ بِهِ المُخضَوضِلُ",6,"ل",1,0],["وَالظَبيُ فَرَّ مِنَ الحَيا","إِ إِلى المَهامِهِ وَالبَسابِس",7,"س",1,0],["وَالظَنُّ يَأخُذُ في ضَميرِكَ مَأخَذاً","حَتّى يُريكَ المُستَقيمَ مُحالا",8,"ل",2,0],["وَالظَبيِ وَالخَنساءِ وَالذَيّالِ","يَسمَعنَ مِن أَخبارِهِ الأَزوالِ",9,"ل",1,0],["وَالظُلمُ أَن يَبتَغي الفَتى سَبَباً","يَجعَلُهُ وَصلَةً إِلى سَبَبِه",10,"ب",2,0],["وَالظُلمُ أَن تَلحى عَلى عَبرَةٍ","مُظهِرَةٍ ما أَضمَرَتهُ الضُلوع",11,"ع",1,0],["والظَّريفُ الحُرُّ عن إخ","وانِه غيرُ صَبورِ",12,"ر",1,0],["وَالظِلُّ يَسرِقُ في الخَمائِلِ خَطوَهُ","وَالغُصنُ يَخطِرُ خِطرَةَ النَشوانِ",13,"ن",1,0],["وَالظِلُّ يَسرِقُ بَينَ الدَوحِ خُطوَتَهُ","وَلِلمِياهِ دَبيبٌ غَيرُ مُستَرَقِ",14,"ق",1,0],["والظباءُ الحُورُ إِمّا قَتَلَتْ","لَحَظاتُ العَينِ مِنها لا تَدِي",15,"د",2,0],["والظبيُ مهما عاقَهُ","شيءٌ تيسَّرَ صيدُهُ",16,"ه",1,0],["والظّلمُ مركبُه الهوى وسبيلُه","طُغيانُ جبّارٍ وضعفُ جَهولِ",17,"ل",1,0],["وَالظُلمُ لِلضَعفِ جارٌ لا يُفارِقُهُ","فَإِن رَأى قُوَّةً وَلَّى يُجافيها",18,"ي",3,0],["والظَّنُّ تغريرٌ فكيف إذا التقَى","في الظَّنّ رأيٌ كاذبٌ وجَهول",19,"ل",1,0],["وَالظَبيُ مَسكَنُهُ الفَلا","ةُ مُطَرَّدٌ فيها شَريدُ",20,"د",1,0],["وَالظَبيُ تَصرَعُهُ الحَبا","إِلُ وَهوَ عَن شَرَكٍ يَحيدُ",20,"د",1,0],["وَالظُلمُ أَن تَلزَمَ ما قَد جَنى","عَلَيكَ بَهرامُ وَبَيدَختُ",21,"ت",1,0],["وَالظُلمُ عِندي قَبيحٌ لا أُجَوِّزُهُ","وَلَو أُطِعتُ لَما فاؤُوا بِأَجلابِ",22,"ب",1,0],["وَالظَبيُ أَشجَعُ مِن لَيثٍ وَمِن نَمِرٍ","إِذا أَلَمَّ يُضاهي اللَيثَ وَالنَمِرا",23,"ر",2,0],["وَالظُلمُ يَشقى بِهِ الظُلومُ وَيَر","عاهُ كَرَعيِ الظِباءِ مُبتَقَلَه",24,"ل",2,0],["وَالظُلمُ يُمهِلُ بَعضَ مَن يَسعى لَهُ","وَمَحَلُّ نَقمَتِهِ بِنَفسِ الظالِمِ",25,"م",1,0],["وَالظُلمُ في وَقدَةٍ فَلَو عَرَضَت","شُربَةُ ماءٍ لَما غَلَت بِدَمي",26,"م",2,0],["وَالظُلمُ فَرَّقَ بَينَ حَيَّي وائِلٍ","بَكرٌ تُساقيها المَنايا تَغلِبُ",27,"ب",1,0],["والظلم مفسدة ماحل في بلدٍ","إلا وأزعج فيه أي إزعاج",28,"ج",1,0],["والظم في خلق النفوس فإن تجد","ذا عفةٍ فلعلةٍ لا يظلم",29,"م",1,0],["وَالظُّلْمُ رِقُّ عَشِيرَةٍ لِعَشِيرَةٍ","بِقَضَاءِ جُنْدٍ عِنْدُهُا وَجَوَارِي",30,"ر",2,0],["والظلّ ، يلمحه ، وفي ..","عينيه ، تحترق الهواتف",31,"ف",1,0],["وَالظَّبْيُ تَصْرعُهُ الْحَبَا","ئلُ وهو عن شركٍ يحيدُ",32,"د",1,0],["والظُّلْمُ فَرّقَ بينَ حَبّيْ وَائِلٍ:","بَكرٌ تُساقيها المَنايا تَغلبُ",33,"ب",1,0],["وَالظُّلْمُ باقٍ لَنْ يُحَطِّمَ قَيْدَهُ","مَوْتي وَلَنْ يُودِي بِهِ قُرْباني",34,"ن",2,0]]}