 كَما تَبْ","دُو حِسانًا فِي مُقلَةِ الصَّيَّادِ !",214,"د",1,0],["والظلم من يمشي طريقه يندم","ولافيه ظالم يعتبر ربحان",215,"ن",1,0],["والظِّنُونُ العُمْرَ تَمْضِيْ مُهْجَةً","مِنْ لَهِيْبِ الشَّوْقِ دَوْمًا تُحْرَقُ",216,"ق",1,0],["والظِلْف في عنُق المَغاورِ راجمٌ","متعجْعجٌ كدَمِي مُدَجًّى مختنق",217,"ق",1,0],["والظلم شيء في الحقيقة واحد","إن كان ظلما أبيضا أو أحمرا",218,"ر",2,0],["والظامئ الولهان يربض واجماً","والمارد الجبار يزبد ، يزعق",219,"ق",1,0],["وَالْظِّلُ يَلْقَىْ أَنَّهُ قَدْ خَلاَ","مِنَّا فَيُلْقِيْ رُوْحَهُ فِيْ سَقَرْ",220,"ر",1,0],["وألَظتْ أعيُنهم غُرّة ً","تفارقُ منها الجسومُ الطُّلى",221,"ا",1,0],["والظَرْفُ في الآدابِ شيءٌ يُحْتَسَبْ","لا سيّما ما كانَ منها للأدَبْ",222,"ب",1,0]]}