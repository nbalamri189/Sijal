sgate.com/ViewPoem.aspx?id=204933",""],[6093,"فالسر في ذات وفي طاقاتها","https://www.poetsgate.com/ViewPoem.aspx?id=215221",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6124,"علمتني كيف أجفو","https://www.poetsgate.com/ViewPoem.aspx?id=125190",""],[6147,"لو سجّلوني ..ميّتا..","https://www.poetsgate.com/ViewPoem.aspx?id=151486",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6213,"هدوء الموج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85502&r=&rc=105",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""],[556,"لقد ضلَّ مَن يسترقُّ الهوَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24263&r=&rc=2",""],[572,"حَسْبِي مِنَ اللهوِ وآلاَتِ الطَّرَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9168&r=&rc=25",""]],"verses":[["وَالظُبى تَقذِفُ الغُمودَ وَماءُ ال","نَقعِ جارٍ عَلى الرُبى وَالوِهادِ",0,"د",1,0],["وَالظَّبيَ وَالضبَّ جَاءَا يَشْهَدَانِ بِأَنْ","لاَ شَيْءَ أَعْظَمُ مِنْ طَهٍ وَيَاسِينِ",1,"ن",1,0],["وَالظُلمُ مِن طَبعِ النِظا","مِ فَإِن ظُلِمتَ فَلا تُمار",2,"ر",1,0],["وَالظافِرُ المَلِكُ المُؤَيَّ","دُ واحِدٌ عَدلُ الجُموع",3,"ع",1,0],["والظلم مخذولة كتائبُهُ","تضرب أدبارها وتكتسع",4,"ع",1,0],["وَالظاعِنينَ عَلى أَهواءِ نِسوَتِهِم","وَما لَهُم مِن قَديمٍ غَيرُ أَعيارِ",5,"ر",1,0],["وَالظِلُّ مَمدودٌ عَلى جَنَباتِها","وَالماءُ مَغمورٌ بِهِ المُخضَوضِلُ",6,"ل",1,0],["وَالظَبيُ فَرَّ مِنَ الحَيا","إِ إِلى المَهامِهِ وَالبَسابِس",7,"س",1,0],["وَالظَنُّ يَأخُذُ في ضَميرِكَ مَأخَذاً","حَتّى يُريكَ المُستَقيمَ مُحالا",8,"ل",2,0],["وَالظَبيِ وَالخَنساءِ وَالذَيّالِ","يَسمَعنَ مِن أَخبارِهِ الأَزوالِ",9,"ل",1,0],["وَالظُلمُ أَن يَبتَغي الفَتى سَبَباً","يَجعَلُهُ وَصلَةً إِلى سَبَبِه",10,"ب",2,0],["وَالظُلمُ أَن تَلحى عَلى عَبرَةٍ","مُظهِرَةٍ ما أَضمَرَتهُ الضُلوع",11,"ع",1,0],["والظَّريفُ الحُرُّ عن إخ","وانِه غيرُ صَبورِ",12,"ر",1,0],["وَالظِلُّ يَسرِقُ في الخَمائِلِ خَطوَهُ","وَالغُصنُ يَخطِرُ خِطرَةَ النَشوانِ",13,"ن",1,0],["وَالظِلُّ يَسرِقُ بَينَ الدَوحِ خُطوَتَهُ","وَلِلمِياهِ دَبيبٌ غَيرُ مُستَرَقِ",14,"ق",1,0],["وَالظَّنُّ أَنَّا لِتَكْرَارِ اْسْتِغَاثَتِنَا","بِهِ تَكَرَّرَ فِينَا الاسْمُ وَاْطَّرَدَا",15,"د",2,0],["والظباءُ الحُورُ إِمّا قَتَلَتْ","لَحَظاتُ العَينِ مِنها لا تَدِي",16,"د",2,0],["والظبيُ مهما عاقَهُ","شيءٌ تيسَّرَ صيدُهُ",17,"ه",1,0],["والظّلمُ مركبُه الهوى وسبيلُه","طُغيانُ جبّارٍ وضعفُ جَهولِ",18,"ل",1,0],["وَالظُلمُ لِلضَعفِ جارٌ لا يُفارِقُهُ","فَإِن رَأى قُوَّةً وَلَّى يُجافيها",19,"ي",3,0],["والظَّنُّ تغريرٌ فكيف إذا التقَى","في الظَّنّ رأيٌ كاذبٌ وجَهول",20,"ل",1,0],["وَالظَبيُ مَسكَنُهُ الفَلا","ةُ مُطَرَّدٌ فيها شَريدُ",21,"د",1,0],["وَالظَبيُ تَصرَعُهُ الحَبا","إِلُ وَهوَ عَن شَرَكٍ يَحيدُ",21,"د",1,0],["وَالظُلمُ أَن تَلزَمَ ما قَد جَنى","عَلَيكَ بَهرامُ وَبَيدَختُ",22,"ت",1,0],["وَالظُلمُ عِندي قَبيحٌ لا أُجَوِّزُهُ","وَلَو أُطِعتُ لَما فاؤُوا بِأَجلابِ",23,"ب",1,0],["وَالظَبيُ أَشجَعُ مِن لَيثٍ وَمِن نَمِرٍ","إِذا أَلَمَّ يُضاهي اللَيثَ وَالنَمِرا",24,"ر",2,0],["وَالظُلمُ يَشقى بِهِ الظُلومُ وَيَر","عاهُ كَرَعيِ الظِباءِ مُبتَقَلَه",25,"ل",2,0],["وَالظُلمُ يُمهِلُ بَعضَ مَن يَسعى لَهُ","وَمَحَلُّ نَقمَتِهِ بِنَفسِ الظالِمِ",26,"م",1,0],["وَالظُلمُ في وَقدَةٍ فَلَو عَرَضَت","شُربَةُ ماءٍ لَما غَلَت بِدَمي",27,"م",2,0],["وَالظُلمُ فَرَّقَ بَينَ حَيَّي وائِلٍ","بَكرٌ تُساقيها المَنايا تَغلِبُ",28,"ب",1,0],["والظلم مفسدة ماحل في بلدٍ","إلا وأزعج فيه أي إزعاج",29,"ج",1,0],["والظم في خلق النفوس فإن تجد","ذا عفةٍ فلعلةٍ لا يظلم",30,"م",1,0],["وَالظُّلْمُ رِقُّ عَشِيرَةٍ لِعَشِيرَةٍ","بِقَضَاءِ جُنْدٍ عِنْدُهُا وَجَوَارِي",31,"ر",2,0],["والظلّ ، يلمحه ، وفي ..","عينيه ، تحترق الهواتف",32,"ف",1,0],["والظلمة الخرسا تلعثم بالرؤى","كتلعثم المخنوق بالكلمات",33,"ت",1,0],["والظلم مهما احتمت بالبطش عصبته","فلم تطق وقفة في وجه تيّار",34,"ر",1,0],["وَالظَّبْيُ تَصْرعُهُ الْحَبَا","ئلُ وهو عن شركٍ يحيدُ",35,"د",1,0],["والظُّلْمُ فَرّقَ بينَ حَبّيْ وَائِلٍ:","بَكرٌ تُساقيها المَنايا تَغلبُ",36,"ب",1,0],["وَالظُّلْمُ باقٍ لَنْ يُحَطِّمَ قَيْدَهُ","مَوْتي وَلَنْ يُودِي بِهِ قُرْباني",37,"ن",2,0],["والظاعنون سروا ويحمل ركبهم","بمهامه البيداء زهر نياق",38,"ق",1,0],["والظن تنعشني روحي ينعشي لو","على اسمه الطيب المبرور نوديت",39,"ت",1,0],["وَالظاعِنونَ مُواصِلوكَ يَدَ النَدى","حَتّى كَأَنَّهُمُ لَدَيكَ نُزولُ",40,"ل",1,0],["والظبي إما كَسَلَتْ عينهُ","تشبهُ الجيدَ بها فالتوى",41,"و",2,0],["وَالظِلُّ يَدعوكِ إِلى لَذَّةِ","الأَحلامِ في لَيلَتِهِ الهاجِدَه",42,"ه",1,0],["والظُّلمُ من لُؤْمِ الطِّبا","عِ وعادَة النفسِ الردِيّه",43,"ي",2,0],["وَالظَّنُّ أَوْ هُوَ الْمُحَقَّقُ أَنَّهُ","مَا إِنْ لَهُ فِي صَبْرِهِ مِنْ ثَانِ",44,"ن",1,0],["وَالظل فيها سموم","وَالحلى فيها حديد",45,"د",1,0],["وَالظَبي حَياه بأحسن منطق","وَالعضو خاطبه وكان مسمما",46,"م",2,0],["والظبي لما لفتت جيدها","هج على الوجه إلى القفر",47,"ر",1,0],["وَالظنّ أنّك لا تزالُ ضمينهُ","في نفسهِ وَالأهل حيثّ تصرّفا",48,"ف",2,0],["وَالظُلمُ حَوضٌ لَيسَ يُسقى بِهِ","ذو مَنعَةٍ في كُلِّ أَمرٍ يُطيق",49,"ق",1,0],["والظلمُ في شَرْعِ الحبيبِ عدالةٌ","مهما جَفَا كنتَ المُحِبَّ المُُولَعَا",50,"ع",2,0],["وَالظبا تيهاً تُعاقبه","وَعَيائي داؤُهُ صَعبا",51,"ب",2,0],["وَالظِلُّ ذو شُعَبٍ وَذو عُشُبٍ","وَكِلاهُما نُسميهِ بِالظِلِّ",52,"ل",1,0],["وَالظَرف فيكَ مَجمَع","وَالحُسن مِنكَ مقسم",53,"م",1,0],["والظفر كل الظفر كل الظفر","في اتباعك للنبي الهادي الرسول",54,"ل",1,0],["والظلم للناس واعرف نحوها في المثال","يا رب يارب يا معطي العطايا الجزال",55,"ل",1,0],["والظلم فاش بلا لوم ولانكر","وللمساكين تخويف وترهيب",56,"ب",1,0],["وَالظَرفُ يوجب أَخذَهُ مَع ظَرفِهِ","فَأَضِف بِهِ طَبَقاً إِلى أَطباقِكا",57,"ك",2,0],["والظلم في الأرض مانعي كل ما","أبغيه حتى زيارة الرمم",58,"م",1,0],["والظِّباء العُفْرُ من آرامها","ما بعينها بجسمي من سقام",59,"م",1,0],["والظلم واللؤم طباع بالفتى","يكتمه العجز ويفشيه القوى",60,"ا",1,0],["والظبي حياه والعود المسن وتل","ك الشاة قد حذرته السم منتقعا",61,"ع",2,0],["والظلم ليس يحد بين خطوبه","من لم يصد خطوبه فمعينها",62,"ن",3,0],["والظَّفَر الحلو له إن عفا","عمداً وإن نَيَّبَ أو ظَفَّ