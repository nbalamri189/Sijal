0.html","المتقارب"],[51,"الحمد للَّه يا أبا حسنِ","https://www.aldiwan.net/poem66455.html","المنسرح"],[70,"وحقكم ما غير البعد عهدكم","https://www.aldiwan.net/poem42686.html","الطويل"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[62,"قال الحكيم مقالا أبان","https://www.aldiwan.net/poem52187.html","المتقارب"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[45,"أَكان الصبا إِلا خيالا مسلما","https://www.aldiwan.net/poem66638.html","البسيط"],[45,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[61,"أجانبها حذارا لا اجتنابا","https://www.aldiwan.net/poem51817.html","الوافر"],[49,"ألا إن ربي قوي مجيد","https://www.aldiwan.net/poem62037.html","المتقارب"],[66,"ألا يا ملك العصر","https://www.aldiwan.net/poem39072.html","الهزج"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[44,"سقت رفها وظاهرة وغبا","https://www.aldiwan.net/poem30347.html","الوافر"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[87,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[69,"باسم إله الخلق هذا ما اشترى","https://www.aldiwan.net/poem27989.html","الرجز"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[21,"إله العالمين وكل أرض","https://www.aldiwan.net/poem36168.html","الوافر"],[48,"وارفة للطير في أرجائها","https://www.aldiwan.net/poem10418.html","الرجز"],[48,"إذا عبا أبو الهيجاء","https://www.aldiwan.net/poem65307.html","الهزج"],[46,"غدوت مريض العقل والدين فالقني","https://www.aldiwan.net/poem22294.html","الطويل"],[46,"قد سائها العقم لا ضمت ولا ولدت","https://www.aldiwan.net/poem22428.html","البسيط"],[46,"هو البر في بحر وإن سكن البرا","https://www.aldiwan.net/poem22605.html","الطويل"],[46,"يسود الناس زيد بعد عمرو","https://www.aldiwan.net/poem23174.html","الوافر"],[46,"تمنيت أني من هضاب يلملم","https://www.aldiwan.net/poem23362.html","الطويل"],[46,"إذا بلغ الإنسان خمسين حجة","https://www.aldiwan.net/poem23372.html","الطويل"],[46,"عجبت لكهل قاعد بين نسوة","https://www.aldiwan.net/poem23442.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42717","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42655","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[77,"دعوتك للود الذي جنباته","https://www.poetsgate.com/ViewPoem.aspx?id=34182",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[51,"أبدرَ السماءِ وغيثَ السما","https://www.poetsgate.com/ViewPoem.aspx?id=30332",""],[53,"بَهَاءُ المُلْكِ مِنْ هذا البَهَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9804&r=&rc=1",""]],"verses":[["وَمَن شُرِعَت رِماحُ اللَهِ فيهِ","دَرى أَنَّ السَوابِغَ لا يَقينا",0,"ن",2,0],["وَمَنشَرَها عَلى هَضَباتِ بَمٍّ","رِياطاً لِلعَجاجَةِ ما طُوينا",0,"ن",2,0],["وَمِن شَغَفي بِالطَعنِ أَغدو وَذابِلي","إِذا قَلَّ جُرمٌ مالَ بي في التَجَرُّمِ",1,"م",1,0],["وَمِن شِيَمِ الفَتى العَرَبيِّ فينا","وِصالُ البيضِ وَالخَيلِ العِرابِ",2,"ب",1,0],["وَمِن شِيَمِ المُلوكِ عَلى اللَيالي","مُجازاةُ الوَليِّ عَلى الوَلاءِ",3,"ا",2,0],["وَمِن شَوقٍ بَكَينَ عَلى فَقيدٍ","فإِنَّ الشَّوقَ يَستَبكي الحَزينا",4,"ن",2,0],["وَمَنْ شَغَلَتْهُ بِالهَوى نَظَراتُها","فَلَيْسَ لَهُ حَتَّى المَمّاتِ فَراغُ",5,"غ",1,0],["ومِنْ شِيَمي أن أهْجُرَ الماءَ صادِياً","إذا كانَ طَرْقاً سُؤْرُهُ مُتَبَرَّضا",6,"ض",2,0],["ومِنْ شِيَمي أن أُبليَ العُذْرَ فاسْتَمِعْ","ثَناءً كما يُثْني على الوابِلِ الزَّهْرُ",7,"ر",1,0],["ومِنْ شُموسٍ وأقْمارٍ إذا طَلَعتْ","كانَتْ مَشارِقُها الأسْتارَ والكِلَلا",8,"ل",2,0],["ومَنْ شامَ في جوِّ الشّبيبةِ بارِقاً","ولمْ تنْهَهُ عنْهُ النُّهى كيفَ ينْتَهي",9,"ت",3,0],["وَمِنْ شِهَابٍ بَدَا مِنْ نُورِهِ رَجَعَت","شُهْبُ الدَّياجِي رُجُوماً لِلشَّيَاطينِ",10,"ن",1,0],["وَمَنْ شَأْنُهُ وَاللَّهُ يَرْفَعُ شَأْنَهُ","عَفَافٌ وَإِقْدَامٌ وَحَزْمٌ وَنَائِلُ",11,"ل",1,0],["وَمِن شانِئٍ كاسِفٍ وَجهُهُ","إِذا ما اِنتَسَبتُ لَهُ أَنكَرَن",12,"ن",1,0],["ومن شكا بأليم الوجد في بصر","فقد تعوّد غير السُّهد والسَّفر",13,"ر",1,0],["ومن شِيمَ الأيام في الناس انها","تجور عليهم باقتطاع العلائق",14,"ق",1,0],["ومن شك فلينظر بكلّ مدينة","تلاميذه من بعده فهم كثر",15,"ر",1,0],["ومن شذرات الشعر حوم فراشة","على الزهر في روض به ابتسم الزهر",16,"ر",1,0],["ومن شَرَطىَ مرثعن تحللت","غزال بها منه بثجاجه سجِلْ",17,"ل",1,1],["ومن شيبت عشاقه زمن الصبى","شوائبُ عشقٍ لا ينادى وليده",18,"د",2,0],["ومنشئ اللفظ نبعاً للقلاع فما","يرى كنبعك طلاّعاً على القلل",19,"ل",1,0],["ومن شَكَرَ النُّعمَى عُمُوماً فشْكرُهُ","إذا هيَ خَصَّتْهُ أجَمُّ وأحشَدُ",20,"د",1,0],["ومن شِيمِ الحجابِ أن قلوبهم","قلوب على الأحرار أقسى من الصخرِ",21,"ر",1,0],["ومن شيمة الأجواد بَسطُ وجوههم","إذا سُئلوا لا ينفَسونَ النفائسا",22,"س",2,0],["ومنْ شأنه أن إذا همَّ ثَم","مَ مستكثراً أن يُرى مستحيلا",23,"ل",2,0],["ومن شكا دهرَه شكاك وهل","تكنى عن الروح خارج البدن",24,"ن",1,0],["وَمِن شَغَفي فيكُم وَوَجدِيَ أَنَّني","أُهَوِّنُ ما أَلقاهُ وَهوَ هَوانُ",25,"ن",1,0],["ومن شر نفاث ومن شر غاسق","ومن شر خراص ومن شر حاسد",26,"د",1,0],["وَمَن شَكَرَ المَناجِمَ مُحسِناتٍ","إِذا التِبرُ اِنجَلى شَكَرَ التُرابا",27,"ب",2,0],["وَمِن شَرَفِ الأَوطانِ أَلّا يَفوتَها","حُسامٌ مُعِزٌّ أَو يَراعٌ مُهَذَّبُ",28,"ب",1,0],["وَمِن شَرَفِ الإِقدامِ أَنَّكَ فيهِمِ","عَلى القَتلِ مَوموقٌ كَأَنَّكَ شاكِدُ",29,"د",1,0],["ومن شأن أرواحهن الإباق","إذا وهج النار مسّ الجسد",30,"د",1,0],["ومن شِيَمي رَدُّ النصيحِ بغيظِهِ","وتركي وعورَ القولِ وهي سُهولُ",31,"ل",1,0],["ومن شِيحِ نجدٍ نفحةٌ سَحَريةٌ","تساهَمَ فيها شَمْأَلٌ وقَبُولُ",31,"ل",1,0],["وَمِن شُرُفاتٍ في السَماءِ كَأَنَّها","قَوادِمُ بيضانِ الحَمامِ المُحَلِّقِ",32,"ق",1,0],["وَمِن شَجَرٍ رَدَّ الرَبيعُ لِباسُهُ","عَلَيهِ كَما نَشَّرتَ وَشياً مُنَمنَما",33,"م",2,0],["وَمَن شادَ المَعالي غَيرَ آلٍ","وَأَوجَفَ في المَكارِمِ غَيرَ وانِ",34,"ن",1,0],["ومنشئُ عارضٍ يُذكي التهاباً","على الآماقِ أو يَهمي انسكابا",35,"ب",2,0],["وَمَن شَكَرَ اللَهَ لَم يَنسَهُ","وَلَم يَنقَطِع عَنهُ مِنهُ المَزيدُ",36,"د",1,0],["وَمَن شَرَّفَ قَدرَ الدَس","تِ وَالكُرسِيِّ وَالتَختِ",37,"ت",1,0],["ومنشآتٌ إذا ريحٌ لها نشأتْ","جرين في زاخرٍ بالموت ملتطمِ",38,"م",1,0],["وَمِن شَرِّ المِياهِ إِذا اِستُميحَت","أَواجِنُها عَلى طولِ المُقامِ",39,"م",1,0],["وَمَن شَكَّ أَنَّ الجودَ وَالبَأسَ فيهِمُ","كَمَن شَكَّ في أَنَّ الفَصاحَةَ في نَجدِ",40,"د",1,0],["وَمَنْ شَاغَبَ الأَيَّامَ لانَ مَرِيرُهُ","وَأَسْلَمَهُ طُولُ الْمِرَاسِ إِلَى الْوَهْنِ",41,"ن",1,0],["ومِنْ شمالٍ ملكُ أولادِ علي","والغَرْبُ مِلْكُ عامرِ بنِ جَهْبَلِ",42,"ل",1,0],["ومِن شَرَفِ المُجاهدِ أن تراه","يَجِلُّ عنِ المُعاقبِ والمُثيبِ",43,"ب",1,0],["وَمُنشِداً عِندهم علماً وَمَعرِفَةً","بِحالهم بَينَ إِدلاج وَتَأويبِ",44,"ب",1,0],["وَمِن شُهُبٍ تَلألأُ في دُجاها","مَراميها أَشَدُّ مِنَ النِصالِ",45,"ل",1,0],["وَمِن شُروقاها وَمِن صَبغائِها","كُلَّ حَبَنطاةٍ عَلى اِحبِنطائِها",46,"ا",3,0],["وَمَنشا حَربِنا ساقٍ","سَبا خَمراً فَسَقّانا",47,"ن",2,0],["وَمِن شَرِّ أَخلاقِ الأَنيسِ وَفِعلِهِم","خُوارُ النَواعي وَاِلتِدامُ النَوائِحِ",48,"ح",1,0],["وَمُنشِدُ الخَيرِ لا تُصغي لَهُ أُذُنٌ","قَد ضَلَّ مُذ كانَتِ الدُنِّيا فَما نُشِدا",49,"د",2,0],["وَمِن شِيَمِ الإِنسِ العُقوقُ وَجاهِلٌ","مُحاوِلُ بِرٍّ عِندَ مَن أَكَلَ البُرّا",50,"ر",2,0],["وَمِن شَرِّ البَرِيَّةِ رُبَّ مُلكٍ","يُريدُ رَعِيَّةً أَن يَسجُدوا لَه",51,"ل",2,0],["وَمِن شَأنِ هَذا الخَلقِ غِشٌّ وَظِنَّةٌ","وَمَن يَتَقَرَّب مِنهُمُ يَتَظَلَّمِ",52,"م",1,0],["وَمِن شِيَمِ الأَيّامِ وَهيَ كَثيرَةٌ","فَناءُ كَبيرٍ وَاِقتِبالُ غُلامِ",53,"م",1,0],["وَمِن شَرِّ أَخدانِ الفَتى أُمُّ زَنبَقٍ","وَتِلكَ عَجوزٌ أَهلَكَت مَن تُخادِنُ",54,"ن",1,0],["ومَنْ شَهِدَ الوَغى وعليه دِرْعٌ","تَلَقّاها بنَفْسٍ مُطْمَئِنّهْ",55,"ن",2,0],["وَمَنْ شَهِدَ الْهَيْجَاءَ مِنْ غَيْرِ آلَةٍ","يَذُودُ بِهَا عَنْ نَفْسِهِ فَهْوَ أَحْمَقُ",56,"ق",1,0],["وَمَنْ شِيَمِي حُبُّ الْوَفاءِ سَجِيَّةً","وَما خَيْرُ قَلْبٍ لا يَدُومُ لَهُ عَهْدُ",57,"د",1,0],["وَمِنْ شِيَمِي بَذْلُ الْوِدَادِ لأَهْلِهِ","كَذَلِكَ إِنِّي فِي الْوِدَادِ أُنَافِسُ",58,"س",1,0],["وَمِنْ شُيوخٍ وَنُوَّابٍ نِظَامُهُمْ","حَوْلَ الْمَلِيكِ نِظَامُ الشَّمْسِ وَالشُّهُبِ",59,"ب",1,0],["وَمِن شَرَفي أَن لايَزالُ يُعيبُني","حَسودٌ عَلى الأَمرِ الَّذي هُوَ عائِبُ",60,"ب",1,0],["ومن شَغَفِي بلون سَوَاد شَعْرِي","أَلِفْتُ السُّهد في الليل البهيم",61,"م",1,0],["ومن شام من جو الشبيبة بارقا","ولم تنهه عنه النهى كيف ينتهي",62,"ت",3,0],["ومن شعور الفراتِينَ قد نَهِلَت","أرضُ العراق وعبَّتْ أرضُ بَغدان",63,"ن",1,0],["ومنْ شأنه أن إذا همْ","مَ ثمَّ مستكثراً أن يُرى مستحيلا",64,"ل",2,0],["ومن شيم الملوك على الليالي","مجازات الولي على الولاءِ",65,"ا",2,0]]}