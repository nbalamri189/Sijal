.aldiwan.net/poem34861.html","المتقارب"],[436,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[436,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[438,"أيا ليلى الشريفة حن قلبي","https://www.aldiwan.net/poem14313.html","الوافر"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[438,"فدونك من جزء الضياء مسائلاً","https://www.aldiwan.net/poem14413.html","الطويل"],[438,"لنا من قسم حزنكم سهام","https://www.aldiwan.net/poem14477.html","الوافر"],[451,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[456,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[456,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[456,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[456,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[459,"جزى الله خيرا من امام تخيرت","https://www.aldiwan.net/poem15392.html","الطويل"],[459,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[459,"رويدكم فالفتح يصغره القدر","https://www.aldiwan.net/poem16340.html","الطويل"],[462,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[466,"جوامع أوهامي تقصر عن قدري","https://www.aldiwan.net/poem59974.html","الطويل"],[475,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[498,"تعلمنا الإشارة في طريق","https://www.aldiwan.net/poem37970.html","الوافر"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[513,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[513,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[536,"يوم بحلوان نقضيه على ظمإ","https://www.aldiwan.net/poem47598.html","عموديه"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[549,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[549,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[556,"ومن شدة القرب مني","https://www.aldiwan.net/poem33786.html","المجتث"],[565,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[565,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[573,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"]],"verses":[["وَمَن شُرِعَت رِماحُ اللَهِ فيهِ","دَرى أَنَّ السَوابِغَ لا يَقينا",0,"ن",2,0],["وَمَنشَرَها عَلى هَضَباتِ بَمٍّ","رِياطاً لِلعَجاجَةِ ما طُوينا",0,"ن",2,0],["وَمِن شَغَفي بِالطَعنِ أَغدو وَذابِلي","إِذا قَلَّ جُرمٌ مالَ بي في التَجَرُّمِ",1,"م",1,0],["وَمِن شِيَمِ الفَتى العَرَبيِّ فينا","وِصالُ البيضِ وَالخَيلِ العِرابِ",2,"ب",1,0],["وَمِن شِيَمِ المُلوكِ عَلى اللَيالي","مُجازاةُ الوَليِّ عَلى الوَلاءِ",3,"ا",2,0],["وَمِن شَوقٍ بَكَينَ عَلى فَقيدٍ","فإِنَّ الشَّوقَ يَستَبكي الحَزينا",4,"ن",2,0],["وَمَنْ شَغَلَتْهُ بِالهَوى نَظَراتُها","فَلَيْسَ لَهُ حَتَّى المَمّاتِ فَراغُ",5,"غ",1,0],["ومِنْ شِيَمي أن أهْجُرَ الماءَ صادِياً","إذا كانَ طَرْقاً سُؤْرُهُ مُتَبَرَّضا",6,"ض",2,0],["ومِنْ شِيَمي أن أُبليَ العُذْرَ فاسْتَمِعْ","ثَناءً كما يُثْني على الوابِلِ الزَّهْرُ",7,"ر",1,0],["ومِنْ شُموسٍ وأقْمارٍ إذا طَلَعتْ","كانَتْ مَشارِقُها الأسْتارَ والكِلَلا",8,"ل",2,0],["ومَنْ شامَ في جوِّ الشّبيبةِ بارِقاً","ولمْ تنْهَهُ عنْهُ النُّهى كيفَ ينْتَهي",9,"ت",3,0],["وَمِنْ شِهَابٍ بَدَا مِنْ نُورِهِ رَجَعَت","شُهْبُ الدَّياجِي رُجُوماً لِلشَّيَاطينِ",10,"ن",1,0],["وَمَنْ شَأْنُهُ وَاللَّهُ يَرْفَعُ شَأْنَهُ","عَفَافٌ وَإِقْدَامٌ وَحَزْمٌ وَنَائِلُ",11,"ل",1,0],["وَمِن شانِئٍ كاسِفٍ وَجهُهُ","إِذا ما اِنتَسَبتُ لَهُ أَنكَرَن",12,"ن",1,0],["ومن شكا بأليم الوجد في بصر","فقد تعوّد غير السُّهد والسَّفر",13,"ر",1,0],["ومن شِيمَ الأيام في الناس انها","تجور عليهم باقتطاع العلائق",14,"ق",1,0],["ومن شك فلينظر بكلّ مدينة","تلاميذه من بعده فهم كثر",15,"ر",1,0],["ومن شذرات الشعر حوم فراشة","على الزهر في روض به ابتسم الزهر",16,"ر",1,0],["ومن شَرَطىَ مرثعن تحللت","غزال بها منه بثجاجه سجِلْ",17,"ل",1,1],["ومن شيبت عشاقه زمن الصبى","شوائبُ عشقٍ لا ينادى وليده",18,"د",2,0],["ومنشئ اللفظ نبعاً للقلاع فما","يرى كنبعك طلاّعاً على القلل",19,"ل",1,0],["ومن شَكَرَ النُّعمَى عُمُوماً فشْكرُهُ","إذا هيَ خَصَّتْهُ أجَمُّ وأحشَدُ",20,"د",1,0],["ومن شِيمِ الحجابِ أن قلوبهم","قلوب على الأحرار أقسى من الصخرِ",21,"ر",1,0],["ومن شيمة الأجواد بَسطُ وجوههم","إذا سُئلوا لا ينفَسونَ النفائسا",22,"س",2,0],["ومنْ شأنه أن إذا همَّ ثَم","مَ مستكثراً أن يُرى مستحيلا",23,"ل",2,0],["ومن شكا دهرَه شكاك وهل","تكنى عن الروح خارج البدن",24,"ن",1,0],["وَمِن شَغَفي فيكُم وَوَجدِيَ أَنَّني","أُهَوِّنُ ما أَلقاهُ وَهوَ هَوانُ",25,"ن",1,0],["ومن شر نفاث ومن شر غاسق","ومن شر خراص ومن شر حاسد",26,"د",1,0],["وَمَن شَكَرَ المَناجِمَ مُحسِناتٍ","إِذا التِبرُ اِنجَلى شَكَرَ التُرابا",27,"ب",2,0],["وَمِن شَرَفِ الأَوطانِ أَلّا يَفوتَها","حُسامٌ مُعِزٌّ أَو يَراعٌ مُهَذَّبُ",28,"ب",1,0],["وَمِن شَرَفِ الإِقدامِ أَنَّكَ فيهِمِ","عَلى القَتلِ مَوموقٌ كَأَنَّكَ شاكِدُ",29,"د",1,0],["ومن شأن أرواحهن الإباق","إذا وهج النار مسّ الجسد",30,"د",1,0],["ومن شِيَمي رَدُّ النصيحِ بغيظِهِ","وتركي وعورَ القولِ وهي سُهولُ",31,"ل",1,0],["ومن شِيحِ نجدٍ نفحةٌ سَحَريةٌ","تساهَمَ فيها شَمْأَلٌ وقَبُولُ",31,"ل",1,0],["وَمِن شُرُفاتٍ في السَماءِ كَأَنَّها","قَوادِمُ بيضانِ الحَمامِ المُحَلِّقِ",32,"ق",1,0],["وَمِن شَجَرٍ رَدَّ الرَبيعُ لِباسُهُ","عَلَيهِ كَما نَشَّرتَ وَشياً مُنَمنَما",33,"م",2,0],["وَمَن شادَ المَعالي غَيرَ آلٍ","وَأَوجَفَ في المَكارِمِ غَيرَ وانِ",34,"ن",1,0],["ومنشئُ عارضٍ يُذكي التهاباً","على الآماقِ أو يَهمي انسكابا",35,"ب",2,0],["وَمَن شَكَرَ اللَهَ لَم يَنسَهُ","وَلَم يَنقَطِع عَنهُ مِنهُ المَزيدُ",36,"د",1,0],["وَمَن شَرَّفَ قَدرَ الدَس","تِ وَالكُرسِيِّ وَالتَختِ",37,"ت",1,0],["ومنشآتٌ إذا ريحٌ لها نشأتْ","جرين في زاخرٍ بالموت ملتطمِ",38,"م",1,0],["وَمِن شَرِّ المِياهِ إِذا اِستُميحَت","أَواجِنُها عَلى طولِ المُقامِ",39,"م",1,0],["وَمَن شَكَّ أَنَّ الجودَ وَالبَأسَ فيهِمُ","كَمَن شَكَّ في أَنَّ الفَصاحَةَ في نَجدِ",40,"د",1,0],["وَمَنْ شَاغَبَ الأَيَّامَ لانَ مَرِيرُهُ","وَأَسْلَمَهُ طُولُ الْمِرَاسِ إِلَى الْوَهْنِ",41,"ن",1,0],["ومِنْ شمالٍ ملكُ أولادِ علي","والغَرْبُ مِلْكُ عامرِ بنِ جَهْبَلِ",42,"ل",1,0],["ومِن شَرَفِ المُجاهدِ أن تراه","يَجِلُّ عنِ المُعاقبِ والمُثيبِ",43,"ب",1,0],["وَمُنشِداً عِندهم علماً وَمَعرِفَةً","بِحالهم بَينَ إِدلاج وَتَأويبِ",44,"ب",1,0],["وَمِن شُهُبٍ تَلألأُ في دُجاها","مَراميها أَشَدُّ مِنَ النِصالِ",45,"ل",1,0],["وَمِن شُروقاها وَمِن صَبغائِها","كُلَّ حَبَنطاةٍ عَلى اِحبِنطائِها",46,"ا",3,0],["وَمَنشا حَربِنا ساقٍ","سَبا خَمراً فَسَقّانا",47,"ن",2,0],["وَمِن شَرِّ أَخلاقِ الأَنيسِ وَفِعلِهِم","خُوارُ النَواعي وَاِلتِدامُ النَوائِحِ",48,"ح",1,0],["وَمُنشِدُ الخَيرِ لا تُصغي لَهُ أُذُنٌ","قَد ضَلَّ مُذ كانَتِ الدُنِّيا فَما نُشِدا",49,"د",2,0],["وَمِن شِيَمِ الإِنسِ العُقوقُ وَجاهِلٌ","مُحاوِلُ بِرٍّ عِندَ مَن أَكَلَ البُرّا",50,"ر",2,0],["وَمِن شَرِّ البَرِيَّةِ رُبَّ مُلكٍ","يُريدُ رَعِيَّةً أَن يَسجُدوا لَه",51,"ل",2,0],["وَمِن شَأنِ هَذا الخَلقِ غِشٌّ وَظِنَّةٌ","وَمَن يَتَقَرَّب مِنهُمُ يَتَظَلَّمِ",52,"م",1,0],["وَمِن شِيَمِ الأَيّامِ وَهيَ كَثيرَةٌ","فَناءُ كَبيرٍ وَاِقتِبالُ غُلامِ",53,"م",1,0],["وَمِن شَرِّ أَخدانِ الفَتى أُمُّ زَنبَقٍ","وَتِلكَ عَجوزٌ أَهلَكَت مَن تُخادِنُ",54,"ن",1,0],["ومَنْ شَهِدَ الوَغى وعليه دِرْعٌ","تَلَقّاها بنَفْسٍ مُطْمَئِنّهْ",55,"ن",2,0],["وَمَنْ شَهِدَ الْهَيْجَاءَ مِنْ غَيْرِ آلَةٍ","يَذُودُ بِهَا عَنْ نَفْسِهِ فَهْوَ أَحْمَقُ",56,"ق",1,0],["وَمَنْ شِيَمِي حُبُّ الْوَفاءِ سَجِيَّةً","وَما خَيْرُ قَلْبٍ لا يَدُومُ لَهُ عَهْدُ",57,"د",1,0],["وَمِنْ شِيَمِي بَذْلُ الْوِدَادِ لأَهْلِهِ","كَذَلِكَ إِنِّي فِي الْوِدَادِ أُنَافِسُ",58,"س",1,0],["وَمِنْ شُيوخٍ وَنُوَّابٍ نِظَامُهُمْ","حَوْلَ الْمَلِيكِ نِظَامُ الشَّمْسِ وَالشُّهُبِ",59,"ب",1,0],["وَمِن شَرَفي أَن لايَزالُ يُعيبُني","حَسودٌ عَلى الأَمرِ الَّذي هُوَ عائِبُ",60,"ب",1,0],["ومن شَغَفِي بلون سَوَاد شَعْرِي","أَلِفْتُ السُّهد في الليل البهيم",61,"م",1,0],["ومن شام من جو الشبيبة بارقا","ولم تنهه عنه النهى كيف ينتهي",62,"ت",3,0],["ومن شعور الفراتِينَ قد نَهِلَت","أرضُ العراق وعبَّتْ أرضُ بَغدان",63,"ن",1,0],["ومنْ شأنه أن إذا همْ","مَ ثمَّ مستكثراً أن يُرى مستحيلا",64,"ل",2,0],["ومن شيم الملوك على الليالي","مجازات الولي على الولاءِ",65,"ا",2,0],["ومن شرِّ وسواسٍ ألمِّ بخاطرِي","ومن همزاتِ للشياطينِ كلَّما",66,"م",2,0],["ومن شرى ما أنتَ تسقيه من","نخلٍ ومِن أرضٍ فلم تحسرِ",67,"ر",1,0],["ومَن شئتَ مِن خلٍّ قريبٍ وصاحبٍ","بعيدٍ ومِن جارٍ لنا وأقاربِ",68,"ب",1,0],["ومن شكرِ آلاء الخليفةِ صولةٌ","على الكفرِ تبقى غامِراً كلَّ عامِرِ",69,"ر",1,0],["ومن شطوا عن الحق اعتسافا","وهاموا في دياجير السفاسفْ",70,"ف",1,0],["ومن شرفِ الحبِّ أن الرجا","لَ تشرِى أذاه بألبابها",71,"ب",3,0],["ومن شكَّ في نور برهانه","علي أنَّ برهانه قد بهر",72,"ر",1,0],["ومن شهدت بريته","له بفعاله الحِسَنِ",73,"ن",1,0],["وَمِنْ شَقْوتي أَنِّي بُليتُ بِشَادِنٍ","يَتيهُ عَلى بَدْرِ الدُّجى بِضِيائِهِ",74,"ا",3,1],["ومن شك فيه شك في الشمس ضحوة","وفي كونكم في الملك من عهد آدم",75,"م",1,0],["ومن شك ممن ليس يعرف حجة","بها العلماء يقرى العلوم ويسنقرى",76,"ر",2,0],["ومن شؤم جدي أن نخلا يظلني","يسدّ به وجهي فقلبي مسدّد",77,"د",1,0],["ومن شغف قال الحلاوي ليتني","نسيت نسيبي في هواه واغزال",78,"ل",1,0],["ومن شأننا في الحرب آجامها القنا","نصول وفي سلم هم الانجم الزهر",79,"ر",1,0],["ومن شعري ؛ فقد نظّمت فيه","أهازيج الهوى لحنا فريدا",80,"د",2,0],["وَمَن شَهِدَت لَهُ بِالفَضلِ آيُ ال","كِتابِ فَما عَسى بَشَرٌ يَقولُ",81,"ل",1,0],["وَمَنْ شَامَ بَرْقَ الْعُلاَ مُسْتَطِيرًا","فَلاَ يَعْدَمَنَّ دَداً وَحُبُورَا",82,"ر",2,0],["وَمِنْ شَرِّ الذِي قَدْ بَ","زَّ مَكْراً نُهْيَةُ الْبَرْزِ",83,"ز",1,0],["وَمُنْشِئِي حَيْثُ خَالَفْتُ هَوَايَ وَلَمْ","أَكُنْ لِمَنْ قَدْ نَهَى عَنْهُ بِمِطْوَاعِ",84,"ع",1,0],["وَمِن شاهِقٍ أَيدي اِمتِحانِكَ بي رمت","لِأَدنى حَضيضٍ سافِلٍ مِن بَلائِيا",85,"ي",2,0],["ومن شام هذا الدهر شيمي وذافه","حلا صابه وانمج في فيه شهده",86,"د",2,0],["ومن شيمي حب المعالي وملتقى","صدور العوالي والمكارم خيمي",8