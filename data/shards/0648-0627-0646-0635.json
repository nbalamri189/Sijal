iwan.net/poem37117.html","مجزوء الرمل"],[539,"وأنصتوا لرأسه","https://www.aldiwan.net/poem48015.html","عموديه"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[552,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[559,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[563,"متى نرجو الثبات من الزمان","https://www.aldiwan.net/poem52921.html","الوافر"],[568,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[574,"حدثني الشوق عن تباريحي","https://www.aldiwan.net/poem3653.html","المنسرح"],[576,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَإِن صَدَقَت مِنهُ اللَيالي مَخيلَةً","تَكُن بِجَديدِ الماءِ أَوَّلَ مَن سَقى",0,"ق",2,0],["وَأَنْصُرُهُمْ وَالسَّيْفُ يَدْمَى غِرارُهُ","وَأُخْذَلُ فِيهمْ وَهْوَ يَعْتَنِقُ الغِمْدا",1,"د",2,0],["وانْصاعَ كالوَحْشيِّ سابَقَ ظِلَّهُ","وتقَعْقَعَتْ عَمَدُ الخِيامِ فقوّضا",2,"ض",2,0],["وأنْصَتَ القِرْنُ لِداعي الرّدى","حيثُ العَوالي جَهَرَتْ بالصِّياحْ",3,"ح",1,0],["وانْصاعَ بَأْسُكَ بابْنِ الغابِ تُجْشِمُهُ","أن يَستَجيرَ حِذاراً بِابْنَةِ الوَعِلِ",4,"ل",1,0],["وَأَنصَحُكِ المَوَدَّةَ مِن ضَميري","وَأَذخَرُ سِرَّ حُبِّكِ في فُؤادي",5,"د",2,0],["وَإِنَّ صَخراً لَوالِينا وَسَيِّدُنا","وَإِنَّ صَخراً إِذا نَشتو لَنَحّارُ",6,"ر",1,0],["وَإِنَّ صَخراً لَمِقدامٌ إِذا رَكِبوا","وَإِنَّ صَخراً إِذا جاعوا لَعَقّارُ",6,"ر",1,0],["وَإِنَّ صَخراً لَتَأتَمَّ الهُداةُ بِهِ","كَأَنَّهُ عَلَمٌ في رَأسِهِ نارُ",6,"ر",1,0],["وَأَنصِبُ وَجهي نَحوَ مَكَّةَ بِالضُحى","إِذا كانَ مِن فَرطِ اللَيالي بَدا ليا",7,"ي",2,0],["وَأَنَّ صَواحِبَ الأظعانِ جُمٌّ","وَأَنَّ لَهُنَّ أَعجازاً ثِقالا",8,"ل",2,0],["وإن صوح الروض الذي يثب الغنى","فقد أزهر الرّوض الذي هو يُخلِفُ",9,"ف",1,0],["وإنْ صدعَ الشملَ الجميعَ يدُ النوى","بيوسُفَ فخرِ المنتدى يتألفُ",9,"ف",1,0],["وأن صوّرت حقّاً هوى كل باطل","على رأسه حتى تجدّل مندقّا",10,"ق",2,0],["وأن صَفِرت يدٌ من رَيْع زرع","أعيد ثراؤها بيدٍ صَناع",11,"ع",1,0],["وَأَنصِبُ وَجهي لِلسَمومِ وَدونَها","شَماطيطُ عَرضِيٍّ تَطيرُ رَعابِلُه",12,"ل",2,0],["وَإِن صَدى المِقَرَّ بِهِ مُقيمٌ","يُنادي الذُلَّ بَعدَ كَرى النِيامِ",13,"م",1,0],["وَأُنصِفُها لا أَكذِبُ اللَهَ أَنَّني","رَشَفتُ بِها ريقاً أَلَذُّ مِنَ الخَمرِ",14,"ر",1,0],["وَأَنصِف فَتاكَ فَإِنصافُهُ","مِنَ الفَضلِ وَالشَرَفِ المُكتَسَب",15,"ب",1,0],["وأنصب طرفي نحو طرف يشوقني","إذا ما الْتقى في الحبِّ نصبي وكسره",16,"ر",2,0],["وانصاعت الدعوةُ تِلْقاءَهُم","وصابَ فيهم مُزنُها الصائبُ",17,"ب",1,0],["وانصاع إما إلى غَضارتِهِ","مسارعاً أو إلى زجاجتِهِ",18,"ت",2,0],["وأنْصِبُ للأيام فيك عداوة","ولِم لا أعاديها وأنت سعيدُها",19,"د",3,0],["وانصداعاً ليس فيه التئام","وافتراقاً ليس فيه اجتماع",20,"ع",1,0],["وأنصف الظالم المظلَّمَ فال","عصفور جار العقاب في لَجَف",21,"ف",1,0],["وأنصفَ الناسَ منه أنه رجلٌ","يُخيفهُ اللَّهُ إسلامٌ وإيمان",22,"ن",1,0],["وَأَنصَتُّ أَستَوحيهِ شَيئاً يَقولُهُ","كَما يَسكُتُ الزُوّارُ في مَعرِضِ التُحَف",23,"ف",1,0],["وَإِن صابَ غَيثٌ مِن وَراءِ تَنوفَةٍ","هَدى هَديَ سَبّارٍ بَعيدِ المَناقِلِ",24,"ل",1,0],["وَإِنَّ صَباباتي بِكُم لَكَثيرَةٌ","بُثَينَ وَنِسيانِكُمُ لَقَليلُ",25,"ل",1,0],["وإن صوّت أو رنّ","وجدت القاع آذانا",26,"ن",2,0],["وَأَنصَفَتنا فَظُلمٌ أَن تُجازِيَها","شَكوى مِنَ الطولِ أَو شَكوى مِنَ القِصَرِ",27,"ر",1,0],["وانْصَرَمَ اللّيلُ ولَمْ أُصَلِّهْ","والسُّكْرُ مفتاحٌ لهذا كُلِّهْ",28,"ه",1,0],["وأنصحُكمْ في حَلِّ كُلِّ مترجَمٍ","به يُضبطُ الأمرُ الشَّعاعُ ويُرْسَخُ",29,"خ",1,0],["وَإِن صُرِفتَ وَلَم تُصرَف لِبائِقَةٍ","عَنِ الخَراجِ فَلَم تُصرَف عَنِ الجودِ",30,"د",1,0],["وانصعن في المجهول والمعروف","لا يقف الإلف على المألوف",31,"ف",1,0],["وَإِن صَحَّ أَنَّكَ مِن نَسلِهِم","فَقَد يَنبُتُ الشَوكُ بَينَ الأَقاحِ",32,"ح",1,0],["وَإِن صارَعوا في مَفخَرٍ قامَ دونَهُم","وَخَلفَهُمُ بِالجَدِّ جَدٌّ مُصارِعُ",33,"ع",1,0],["وَاِنصاعَ عَن موقانَ وَهيَ لِجُندِهِ","وَلَهُ أَبٌ بَرٌّ وَأُمُّ عِيالِ",34,"ل",1,0],["وَإِنَّ صَريحَ الرَأيِ وَالحَزمِ لَاِمرُؤٌ","إِذا بَلَغَتهُ الشَمسُ أَن يَتَحَوَّلا",35,"ل",2,0],["وَإِنْ صَفَحْتَ فَلا تَعْرِضْ بِمَعْتَبَةٍ","فَالْعَتْبُ يُفْسِدُ مَا قَدَّمْتَ مِنْ حَسَنِ",36,"ن",1,0],["وَأَنُصُّ المَطِيَّ بِالرَكبِ يَطلِب","نَ سِراعاً بَواكِرَ الأَظعانِ",37,"ن",1,0],["وَإِن صَمَمتَ فَفي مَرآكَ لي عِظَةٌ","قَد أَفصَحَت لِيَ عَنها أَلسُنُ العِبَرِ",38,"ر",1,0],["وَإِنَّ صَفاءَ الوُدِّ وَالعَهدُ بَينَنا","لِيَكرَهُ لي أَن أَشرَبَ الماءَ صافِيا",39,"ي",2,0],["وَانْصاعَ بالسّودانِ في آثارِها","عَجِلُ الإغارةِ غيرُ ذي إمهالِ",40,"ل",1,0],["وَإِنَّ صَريحَ القَولِ تُخلصُهُ النُهى","فَيَنمى إِلى أَقصى البِقاعِ وَيَرتَمي",41,"م",2,0],["وَإِن صَغَتِ القُلوبُ إِلى شِقاقٍ","فَإِنَّ قُوى الشُعوبِ إِلى اِنحِلالِ",42,"ل",1,0],["وَإِن صَنيَّعَت ماءَ العُيونِ وَفاتُهُ","لَقَد حَفِظَت ماءَ الوُجوهِ نَوائِلُه",43,"ل",2,0],["وَاِنصاعَ يَتلوهُ عَلى قِطاطِهِ","أَغضَفُ لا يَيأَسُ مِن خِلاطِهِ",44,"ط",2,0],["وَاِنصَعنَ لِلمَخدوعِ عَن نَفسِهِ","يَذُقنَ ما ذاقَ فَلَم يُصلَبِ",45,"ب",1,0],["وَأُنصِفُهُم ما هابَتِ الوَحشُ سُبَّةً","وَلا وَقَعَت مِن خَشيَةِ اللَهِ سُجَّدا",46,"د",2,0],["وَإِنَّ صَوارِدَ الأَيّامِ تَأتي","عَلى عِقبانِها وَعَلى الصُرَيدِ",47,"د",1,0],["وَإِن صَحَّ أَنَّ النَيِّراتِ مُحِسَّةٌ","فَماذا نُكِرتُم مِن وِدادٍ وَمِن صِهرِ",48,"ر",1,0],["وَاِنصِف يَتيمَكَ في التُراثِ وَلا","تَأخُذُهُ بِالإِعناتِ وَالقَهرِ",49,"ر",1,0],["وَإِن صَدِئَت أَرواحُنا في جُسومِنا","فَيوشِكُ يَوماً أَن يُعاوِدَها الصَقلُ",50,"ل",1,0],["وَإِنَّ صَريعَ الخَيلِ غَيرُ مُرَوَّعٍ","إِذا الطَيرُ هَمَّت بِالقَتيلِ عَوافيها",51,"ي",3,0],["وانصَرفَ الناسُ إلى القُلَيعَه","فصبّحوا العَدوَّ يومَ الجُمعه",52,"ه",1,0],["وانصرفَ الإمامُ بالنَّجاحِ","والنصرِ والتّأييدِ والفَلاحِ",52,"ح",1,0],["وأنصف الدهر من حظوظٍ","تخطىء في الناس أو تصيب",53,"ب",1,0],["وَإِنَّ صَغيرَ القَومِ إِن كانَ عالِماً","كَبيرٌ إِذا رُدَّت إِلَيهِ المَحافِلُ",54,"ل",1,0],["وَإِن صَديتَ فَلا تَشرَب مُدامَهُمُ","فَ