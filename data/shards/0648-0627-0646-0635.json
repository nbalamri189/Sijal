{"poems":[[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[63,"ومشبلة شمطاء تبكي من النوى","https://www.aldiwan.net/poem46114.html","الطويل"],[63,"أذكى بقلبي لوعة إذ أومضا","https://www.aldiwan.net/poem46127.html","الكامل"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[63,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[55,"جعلت محلة البلوى فؤادي","https://www.aldiwan.net/poem26378.html","الوافر"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[30,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"ذهبت لحي في فروق تزاحمت","https://www.aldiwan.net/poem44452.html","الطويل"],[88,"يعيش الناس في حال أجتماع","https://www.aldiwan.net/poem44982.html","الوافر"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[47,"سأثني على تلك الثنايا لأنني","https://www.aldiwan.net/poem25281.html","الطويل"],[47,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[72,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[51,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"ألا أيها الإبريق ما لك والصلف","https://www.aldiwan.net/poem8983.html","عموديه"],[38,"تهانفت واستبكاك رسم المنازل","https://www.aldiwan.net/poem7740.html","الطويل"],[32,"ألا هل إلى إلمامة أن ألمها","https://www.aldiwan.net/poem27810.html","الطويل"],[85,"دع الأبرق والبانا","https://www.aldiwan.net/poem7053.html","مجزوء الوافر"],[85,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[56,"أستغفر الله لذنبي كله","https://www.aldiwan.net/poem58526.html","البسيط"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[61,"لما تنادى اليوم بالخفوف","https://www.aldiwan.net/poem51349.html","الرجز"],[66,"عزيت إلى آل بيت النبي","https://www.aldiwan.net/poem38628.html","المتقارب"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[87,"إذا أتاك خليل بعد مندمة","https://www.aldiwan.net/poem8222.html","البسيط"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[74,"لقد أصخت إلى نجواك من قمر","https://www.aldiwan.net/poem12951.html","البسيط"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[105,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"أرى حيوان الأرض غير أنيسها","https://www.aldiwan.net/poem22426.html","الطويل"],[46,"كأني كنت في أزمان عاد","https://www.aldiwan.net/poem22481.html","الوافر"],[46,"غدا رمضاني ليس عني بمنقض","https://www.aldiwan.net/poem22643.html","الطويل"],[46,"استحي من شمس النهار ومن","https://www.aldiwan.net/poem22726.html","الكامل"],[46,"أميتة شهب الدجى أم محسة","https://www.aldiwan.net/poem23122.html","الطويل"],[46,"إن كنت قد أوتيت لبا وحكمة","https://www.aldiwan.net/poem23568.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/8788","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/15639","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202547","الرجز"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142332","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[100,"مدرسة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=11248",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[32,"ألا هلْ إلى إلمامة ٍ، أن ألمها،","https://www.poetsgate.com/ViewPoem.aspx?id=15981",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18438&r=&rc=10",""]],"verses":[["وَإِن صَدَقَت مِنهُ اللَيالي مَخيلَةً","تَكُن بِجَديدِ الماءِ أَوَّلَ مَن سَقى",0,"ق",2,0],["وَأَنْصُرُهُمْ وَالسَّيْفُ يَدْمَى غِرارُهُ","وَأُخْذَلُ فِيهمْ وَهْوَ يَعْتَنِقُ الغِمْدا",1,"د",2,0],["وانْصاعَ كالوَحْشيِّ سابَقَ ظِلَّهُ","وتقَعْقَعَتْ عَمَدُ الخِيامِ فقوّضا",2,"ض",2,0],["وأنْصَتَ القِرْنُ لِداعي الرّدى","حيثُ العَوالي جَهَرَتْ بالصِّياحْ",3,"ح",1,0],["وانْصاعَ بَأْسُكَ بابْنِ الغابِ تُجْشِمُهُ","أن يَستَجيرَ حِذاراً بِابْنَةِ الوَعِلِ",4,"ل",1,0],["وَأَنصَحُكِ المَوَدَّةَ مِن ضَميري","وَأَذخَرُ سِرَّ حُبِّكِ في فُؤادي",5,"د",2,0],["وَإِنَّ صَخراً لَوالِينا وَسَيِّدُنا","وَإِنَّ صَخراً إِذا نَشتو لَنَحّارُ",6,"ر",1,0],["وَإِنَّ صَخراً لَمِقدامٌ إِذا رَكِبوا","وَإِنَّ صَخراً إِذا جاعوا لَعَقّارُ",6,"ر",1,0],["وَإِنَّ صَخراً لَتَأتَمَّ الهُداةُ بِهِ","كَأَنَّهُ عَلَمٌ في رَأسِهِ نارُ",6,"ر",1,0],["وَأَنصِبُ وَجهي نَحوَ مَكَّةَ بِالضُحى","إِذا كانَ مِن فَرطِ اللَيالي بَدا ليا",7,"ي",2,0],["وَأَنَّ صَواحِبَ الأظعانِ جُمٌّ","وَأَنَّ لَهُنَّ أَعجازاً ثِقالا",8,"ل",2,0],["وإن صوح الروض الذي يثب الغنى","فقد أزهر الرّوض الذي هو يُخلِفُ",9,"ف",1,0],["وإنْ صدعَ الشملَ الجميعَ يدُ النوى","بيوسُفَ فخرِ المنتدى يتألفُ",9,"ف",1,0],["وأن صوّرت حقّاً هوى كل باطل","على رأسه حتى تجدّل مندقّا",10,"ق",2,0],["وأن صَفِرت يدٌ من رَيْع زرع","أعيد ثراؤها بيدٍ صَناع",11,"ع",1,0],["وَأَنصِبُ وَجهي لِلسَمومِ وَدونَها","شَماطيطُ عَرضِيٍّ تَطيرُ رَعابِلُه",12,"ل",2,0],["وَإِن صَدى المِقَرَّ بِهِ مُقيمٌ","يُنادي الذُلَّ بَعدَ كَرى النِيامِ",13,"م",1,0],["وَأُنصِفُها لا أَكذِبُ اللَهَ أَنَّني","رَشَفتُ بِها ريقاً أَلَذُّ مِنَ الخَمرِ",14,"ر",1,0],["وَأَنصِف فَتاكَ فَإِنصافُهُ","مِنَ الفَضلِ وَالشَرَفِ المُكتَسَب",15,"ب",1,0],["وأنصب طرفي نحو طرف يشوقني","إذا ما الْتقى في الحبِّ نصبي وكسره",16,"ر",2,0],["وانصاعت الدعوةُ تِلْقاءَهُم","وصابَ فيهم مُزنُها الصائبُ",17,"ب",1,0],["وانصاع إما إلى غَضارتِهِ","مسارعاً أو إلى زجاجتِهِ",18,"ت",2,0],["وأنْصِبُ للأيام فيك عداوة","ولِم لا أعاديها وأنت سعيدُها",19,"د",3,0],["وانصداعاً ليس فيه التئام","وافتراقاً ليس فيه اجتماع",20,"ع",1,0],["وأنصف الظالم المظلَّمَ فال","عصفور جار العقاب في لَجَف",21,"ف",1,0],["وأنصفَ الناسَ منه أنه رجلٌ","يُخيفهُ اللَّهُ إسلامٌ وإيمان",22,"ن",1,0],["وَأَنصَتُّ أَستَوحيهِ شَيئاً يَقولُهُ","كَما يَسكُتُ الزُوّارُ في مَعرِضِ التُحَف",23,"ف",1,0],["وَإِن صابَ غَيثٌ مِن وَراءِ تَنوفَةٍ","هَدى هَديَ سَبّارٍ بَعيدِ المَناقِلِ",24,"ل",1,0],["وَإِنَّ صَباباتي بِكُم لَكَثيرَةٌ","بُثَينَ وَنِسيانِكُمُ لَقَليلُ",25,"ل",1,0],["وإن صوّت أو رنّ","وجدت القاع آذانا",26,"ن",2,0],["وَأَنصَفَتنا فَظُلمٌ أَن تُجازِيَها","شَكوى مِنَ الطولِ أَو شَكوى مِنَ القِصَرِ",27,"ر",1,0],["وانْصَرَمَ اللّيلُ ولَمْ أُصَلِّهْ","والسُّكْرُ مفتاحٌ لهذا كُلِّهْ",28,"ه",1,0],["وأنصحُكمْ في حَلِّ كُلِّ مترجَمٍ","به يُضبطُ الأمرُ الشَّعاعُ ويُرْسَخُ",29,"خ",1,0],["وَإِن صُرِفتَ وَلَم تُصرَف لِبائِقَةٍ","عَنِ الخَراجِ فَلَم تُصرَف عَنِ الجودِ",30,"د",1,0],["وانصعن في المجهول والمعروف","لا يقف الإلف على المألوف",31,"ف",1,0],["وَإِن صَحَّ أَنَّكَ مِن نَسلِهِم","فَقَد يَنبُتُ الشَوكُ بَينَ الأَقاحِ",32,"ح",1,0],["وَإِن صارَعوا في مَفخَرٍ قامَ دونَهُم","وَخَلفَهُمُ بِالجَدِّ جَدٌّ مُصارِعُ",33,"ع",1,0],["وَاِنصاعَ عَن موقانَ وَهيَ لِجُندِهِ","وَلَهُ أَبٌ بَرٌّ وَأُمُّ عِيالِ",34,"ل",1,0],["وَإِنَّ صَريحَ الرَأيِ وَالحَزمِ لَاِمرُؤٌ","إِذا بَلَغَتهُ الشَمسُ أَن يَتَحَوَّلا",35,"ل",2,0],["وَإِنْ صَفَحْتَ فَلا تَعْرِضْ بِمَعْتَبَةٍ","فَالْعَتْبُ يُفْسِدُ مَا قَدَّمْتَ مِنْ حَسَنِ",36,"ن",1,0],["وَأَنُصُّ المَطِيَّ بِالرَكبِ يَطلِب","نَ سِراعاً بَواكِرَ الأَظعانِ",37,"ن",1,0],["وَإِن صَمَمتَ فَفي مَرآكَ لي عِظَةٌ","قَد أَفصَحَت لِيَ عَنها أَلسُنُ العِبَرِ",38,"ر",1,0],["وَإِنَّ صَفاءَ الوُدِّ وَالعَهدُ بَينَنا","لِيَكرَهُ لي أَن أَشرَبَ الماءَ صافِيا",39,"ي",2,0],["وَانْصاعَ بالسّودانِ في آثارِها","عَجِلُ الإغارةِ غيرُ ذي إمهالِ",40,"ل",1,0],["وَإِنَّ صَريحَ القَولِ تُخلصُهُ النُهى","فَيَنمى إِلى أَقصى البِقاعِ وَيَرتَمي",41,"م",2,0],["وَإِن صَغَتِ القُلوبُ إِلى شِقاقٍ","فَإِنَّ قُوى الشُعوبِ إِلى اِنحِلالِ",42,"ل",1,0],["وَإِن صَنيَّعَت ماءَ العُيونِ وَفاتُهُ","لَقَد حَفِظَت ماءَ الوُجوهِ نَوائِلُه",43,"ل",2,0],["وَاِنصاعَ يَتلوهُ عَلى قِطاطِهِ","أَغضَفُ لا يَيأَسُ مِن خِلاطِهِ",44,"ط",2,0],["وَاِنصَعنَ لِلمَخدوعِ عَن نَفسِهِ","يَذُقنَ ما ذاقَ فَلَم يُصلَبِ",45,"ب",1,0],["وَأُنصِفُهُم ما هابَتِ الوَحشُ سُبَّةً","وَلا وَقَعَت مِن خَشيَةِ اللَهِ سُجَّدا",46,"د",2,0],["وَإِنَّ صَوارِدَ الأَيّامِ تَأتي","عَلى عِقبانِها وَعَلى الصُرَيدِ",47,"د",1,0],["وَإِن صَحَّ أَنَّ النَيِّراتِ مُحِسَّةٌ","فَماذا نُكِرتُم مِن وِدادٍ وَمِن صِهرِ",48,"ر",1,0],["وَاِنصِف يَتيمَكَ في التُراثِ وَلا","تَأخُذُهُ بِالإِعناتِ وَالقَهرِ",49,"ر",1,0],["وَإِن صَدِئَت أَرواحُنا في جُسومِنا","فَيوشِكُ يَوماً أَن يُعاوِدَها الصَقلُ",50,"ل",1,0],["وَإِنَّ صَريعَ الخَيلِ غَيرُ مُرَوَّعٍ","إِذا الطَيرُ هَمَّت بِالقَتيلِ عَوافيها",51,"ي",3,0],["وانصَرفَ الناسُ إلى القُلَيعَه","فصبّحوا العَدوَّ يومَ الجُمعه",52,"ه",1,0],["وانصرفَ الإمامُ بالنَّجاحِ","والنصرِ والتّأييدِ والفَلاحِ",52,"ح",1,0],["وأنصف الدهر من حظوظٍ","تخطىء في الناس أو تصيب",53,"ب",1,0],["وَإِنَّ صَغيرَ القَومِ إِن كانَ عالِماً","كَبيرٌ إِذا رُدَّت إِلَيهِ المَحافِلُ",54,"ل",1,0],["وَإِن صَديتَ فَلا تَشرَب مُدامَهُمُ","فَالعَقلُ يَرهَبُ مِنها غائِلَ السُكُرِ",55,"ر",1,0],["وانصرف الكُرّارُ والكماة","وانحرف الأنصار والحماة",56,"ه",1,0],["وَأَنّ صَلاحَ الدينِ ذا المَجدِ وَالعُلا","لِما أَفسَدَت مِنّي الحَوادِثُ يُصلِحُ",57,"ح",1,0],["وانصب فمدرسة الحياة بليغة","تملي الدروس وجلّ ما تمليه",58,"ي",2,0],["وإن صَدَعَتْ بالحُكْم يوماً شِفَاهُهُ","فلَيْس بغَيْرِ الْحَقِّ والعَدْلِ تَصْدَع",59,"ع",1,0],["وانصت فمدرسة الحياة بليغة","تملي الدروس وجُلّ ما تمليه",60,"ي",2,0],["وان صَدَقتُ فما للقوم من غَرَضٍ","إلا إماتةُ حِسٍ فيَّ يقظان",61,"ن",1,0],["وانصاعَ يغزُو اهلَه وديارَه","جيشٌ من المتعطلِّين لُهام",62,"م",1,0],["وإنْ صدقتُ فما في الناس مُرتكِباً","مثلُ الأديب أعان الجورَ فارتكبا",63,"ب",2,0],["وإنّ صباباتي بكم لكثيرة ٌ","، بثينَ، ونسيانيكمُ لقليلُ",64,"ل",1,0],["وإن صدورهُم لكُمُ براءُ","وإن سعاتُهمْ لكُمُ سُعاة ٌ",65,"ا",2,0]]}