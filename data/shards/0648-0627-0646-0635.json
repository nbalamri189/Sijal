صَبري طارَت بِآخره","بَلابل الشَوق مُذ قَضى السحر",131,"ر",1,0],["وانصح لكل العباد وارشدهم للرشاد","وإنه لكل فساد في الملة الحنفيه",132,"ه",1,0],["وأنصاره أيضا وأصهاره","وأصحابه والآل والأخذان",133,"ن",1,0],["وَاِنصَرِفوا لِلخَبالِ في أَسَفٍ","بِأَنفسٍ ما تَزالُ مَأفوفَه",134,"ف",2,0],["وأنصب نفسي في هواها وإنما","أجر بذاك انصب أنسى إلى الرفع",135,"ع",1,0],["وأنصف فدت ذاتك كل مهجة","وخذ من النظم الذي توجة",136,"ج",2,0],["وأنصبت الورق لما أتى","وكانت تغرد فوق العذب",137,"ب",1,0],["وَإِن صدعت أَنيابهن بِمُديةٍ","رَأَيتُ لَها شمل الحَديد مصدَّعا",138,"ع",2,0],["وَإِن صَفا لَكَ لَون الدهر فاصفِ لَهُ","وَإِن تلوَّن أَلواناً فَكُن نَمِرا",139,"ر",2,0],["وأَنّ صرْفَ الدَّهرِ يأتي بالّذي","ساء اعتماداً وبما سَرَّ غَلَطْ",140,"ط",1,0],["وانصفونا من خيالٍ طارقٍ","زارنا ليلاً فما أَغنى فتيلا",141,"ل",2,0],["وأنصفْتَ بين الناس بالحكم عادلاً","فلا ثَمَّ مظلوم ولا ثَمَّ ظالم",142,"م",1,0],["وانصر إمام المسلمين وجيشه","نعم الإِمام لما به نستنصر",143,"ر",1,0],["وانصاعَ فِي ذاتِ اليمينِ تَفَاؤُلاً","يَقْضِي له بالطَّائِرِ الميمونِ",144,"ن",1,0],["وإن صدحت ورقاء في غسق الدجى","غدا الدمع تذكاركم ي ترقرق",145,"ق",1,0],["وإن صديت نحو الندى نفس آملٍ","سقاها بكاس الجود غير مصرّد",146,"د",1,0],["وإن صلّ المهنّد في يديه","بها صلى لهيبته الكميّ",147,"ي",1,0],["وإِنْ صَبَرْتُمْ فمِنْ قومٍ إذَا بُعِثُوا","لَمْ يُوهِ عَزْمَهُمُ ذُعْرٌ ولا فَزَعُ",148,"ع",1,0],["وانْصُرْ وَمَنْ والاكَ حِلْفُ كَرَامَةٍ","واقْهَرْ ومَنْ عَادَاكَ رَهْنُ تَبابِ",149,"ب",1,0],["وانصِبْ مجانيقاً من النَّيَمِ الَّتِي","أَحجارُهُنَّ من الرَّواطِمِ وَالنَّخَبْ",150,"ب",1,0],["وإِن صحفت ذاك الأص","ل صبَّ الماء منسكبا",151,"ب",2,0],["وَاِنصِرافٍ عَن جَهلِ ذي الرَحمِ المف","رِطِ لَو شاءَ نالَهُ بَهوانِ",152,"ن",1,0],["وأنصفَ بين أيّامي وبيني","إذا المظلوم دِينَ من الظَّلومِ",153,"م",1,0],["وأنصفَ أحكام السيادةِ ناشئاً","وقد غدرتْ شِيبٌ بها وكهولُ",154,"ل",1,0],["وأنصفتموها إذ ظفرتم برِقِّها","فمالكُها منكم أخٌ وخليلُ",154,"ل",1,0],["وأنصعَ حين خاف الغِمرُ شرّاً","فلا ينفُقْ له ما عاش عِلقُ",155,"ق",1,0],["وإنّ صدقي فيك أعتد