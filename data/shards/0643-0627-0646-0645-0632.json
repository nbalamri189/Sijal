{"poems":[[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[78,"ورادعة بأنفاس العبير","https://www.aldiwan.net/poem39303.html","البسيط"],[480,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114032","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106825","السريع"],[2733,"","https://poetry.dctabudhabi.ae/diwan/poem/79741","الوافر"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"]],"verses":[["كانَ مِزمارَهُ فَأصبَحَ داوُ","دُ كَئيباً يَبكي عَلى مِزمارِهِ",0,"ر",2,0],["كأنَّ مزاجَها لمّا تجلَّتْ","بصحنِ زُجاجها نارٌ بنورِ",1,"ر",1,0],["كَأَنَّ مَزاحِفَ الحَيّاتِ فيهِ","قُبَيلَ الصُبحِ آثارُ السِياطِ",2,"ط",1,0],["كأنّ مِزاجَهُ مَمزوجُ راح","له يصبو أخو النُّسكِ الوَقُورُ",3,"ر",1,0],["كان مزيلَ الهم إيناسُه","واليومَ مغنى الإنس منه خلا",4,"ل",2,0],["كأنَّ مَزاحِفَ الهَزْلَي صَباحا","خُدودُ رَصائِعٍ جُدِلَتْ تُؤاما",5,"م",2,1],["كَأَنَّ مَزاحِفَهُ أَنسُعٌ","خُرِزنَ فُرادى وَمِنها ثُنا",6,"ا",1,0]]}