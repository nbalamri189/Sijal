{"poems":[[52,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[92,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[112,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=34733",""],[211,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[303,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[443,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[445,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[473,"يا طلعة القمر المنير","https://www.aldiwan.net/poem60107.html","مجزوء الكامل"],[520,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[556,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122612","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87097","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70807","المجتث"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138073",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131403","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83230","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129408","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2578","البسيط"],[4908,"دمعة حزن على جراح الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=207338",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5106,"مِنْ فَرْحَةِ الضَّوْءِ قَدْ ضَوَّأتُ أَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=137205",""],[5431,"للقدس...للحبيبة...","https://www.poetsgate.com/ViewPoem.aspx?id=194944",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6124,"رنات عود","https://www.poetsgate.com/ViewPoem.aspx?id=201238",""],[6127,"شاخت عروقك","https://www.poetsgate.com/ViewPoem.aspx?id=202361",""],[520,"بصفات مجدك يشرف التمجيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577470",""],[6344,"فلسفة الضّياع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87975&r=&rc=15",""]],"verses":[["حَتّى صَفَت لِمُحَمَّدٍ","ما دونَ ذا نُصحٌ لِزائِد",0,"د",1,0],["حتى صديقٌ عن التقليدِ أرفَعُهُ","مصاخبٌ إذ سوادُ الناسِ في صَخَب",1,"ب",1,0],["حتّى صرت آشوف جرحك في يديني","في يديني ل جور صدّاتك .. مواري",2,"ر",2,0],["حَتّى صَبَحنا أَهلَ مَكَّةَ فَيلَقاً","شَهباءَ يَقدُمُها الهُمامُ الأَشوَسُ",3,"س",1,0],["حتى صحوتُ قرعتُ من","ندمٍ عَلى الإِسرافِ سِنّي",4,"ن",2,0],["حتّى صفَتْ دَولةٌ كانتْ مكَدَّرةً","دَهْراً فقلتُ له خُذها ولا تَخَف",5,"ف",1,0],["حتى صدَرْتُ إليك يا صدْرَ الورى","بمَطالبي العُلْيا بك استِنْجاحا",6,"ح",2,0],["حتى صددت بلا جرم ولا سببٍ","صدّاً يحقّقُ عندي سرعة المللِ",7,"ل",1,0],["حَتَّى صَبَحْتَ بِلادَ مِيرُو وَقْعَةً","أَنْحى عَلَى الإِشراكِ سُوءُ صَباحِها",8,"ح",3,0],["حتى صبَحنا المجدَ في أبياته","والعزَّ في عاديّةِ المتقدِّمِ",9,"م",1,0],["حَتّى صَفا فَكَأَنَّهُ","دَمعُ الطَليقِ عَلى الأَسيرِ",10,"ر",1,0],["حتى صعدت على ذؤابة منبر","لو كان عوداً ماس ذاك العود",11,"د",1,0],["حتّى صحبتُكُمُ جهلاً بخيرِكُمُ","ثمَّ اِختبرتُ فَكنتمْ شَرَّ مُصْطَحَبِ",12,"ب",1,0],["حتَّى صَفَوا لَكَ عَيشاً والحياةُ بلا","أمنٍ ولا طيبٍ عيشٍ صَفوُها الكَدر",13,"ر",1,0],["حَتّى صَفا لبني الأَوطان مَوردُهم","بحزمِه وَذَكاء الوافر النامي",14,"م",2,0],["حتى صَلُوا بالخطايا","ناراً فبئس القرار",15,"ر",1,0],["حتى صدحتَ بأشعاري فواطربي","لو كنت تعلم ما بثي واحساسي",16,"س",2,0],["حَتَّى صَغَا نابِحُهُمْ فَوَقْوَقا","وَالكَلْبُ لا يَنْبِحُ إِلّا فَرَقا",17,"ق",2,0],["حتى صبحن الطالبيّ بعارض","فيه المنايا تغتدي وتئوب",18,"ب",1,0],["حَتّى صَعِدَت أَمامَ الكُلِّ مُرتَفِعاً","كَما تَعودُ وَنورٌ مِنكَ سِربالُ",19,"ل",1,0],["حتى صحبت منافقا","متلونا يبدي الصفا",20,"ف",2,0],["حتى صفت لهم الجزيرة واجتنبوا","للعز من ورق الحديد الأخضر",21,"ر",1,0],["حَتّى صَبَبنا عَلى هَمدانَ صَيَّقَةً","سُؤُرَ الكِلابِ وَما كانوا لَنا شانا",22,"ن",2,0],["حَتَّى صلبتُ على رصيفِ مَشَاعِرِي","وَتَوَتَّرَتْ فِي دَاخِلِي الأَعْصابُ",23,"ب",1,0],["حتى صرخت ُ  وأذن ُ الكون ِ تسمعُني - :","أهلا ً بذكراك َ لاحت ْ والهوى نسب ُ",24,"ب",1,0],["حَتَّىْ (صَفَاْطِيْ) بِ (كَمْفِيْ)لاْ شَبِيْهَ لَهُ","يَأَتِيْ بَشُوْشَاً بِتِحْنَاْنٍ وَإِشْفَاْقِ",25,"ق",1,0],["حتى صهاينة العروبة جئنها","مثل الكلاب تنابحت بسمائها",26,"ا",3,0],["حتى صُليت بناره","وأنا بها أتقلّب",27,"ب",1,0],["حَتَّى صَلَتهُمْ صَليَ مَنْ لَعِبَتْ بِهِ","سُودُ النَّوايا , وَ الشُّرُورُ الكامِدُ",28,"د",1,0],["حَتَّى صَحَوتَ بِراحَتَي","وَطَنٍ يَهُزُّكَ بِالمَباضِعْ",29,"ع",1,0],["حَتَّى صَفَتْ رَنَّاتُ عُوْدِ الشَّاعِرِ","كَاللَّيْلِ حَفَّ بِالنِّجُوْمِ مُوَدِّعَا",30,"ع",2,0],["حتى صحونا على صوتٍ، وسكرتها","تعوي كذئب، له في إثرها نَفَلُ",31,"ل",1,0],["حتى صعت على ذؤابة منبر","لو كان عود إياس ذاك العود",32,"د",1,0],["حَتَّى صَغِيرُ الحُلْمِ فِي دَاخِلِي","شَاخَ وَمَاتَ قَبْلَ أَنْ يُولَدَا!",33,"د",2,0]]}