{"poems":[[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[205,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[296,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[362,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[362,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[434,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[436,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[466,"يا طلعة القمر المنير","https://www.aldiwan.net/poem60107.html","مجزوء الكامل"],[513,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[549,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"]],"verses":[["حَتّى صَفَت لِمُحَمَّدٍ","ما دونَ ذا نُصحٌ لِزائِد",0,"د",1,0],["حتى صديقٌ عن التقليدِ أرفَعُهُ","مصاخبٌ إذ سوادُ الناسِ في صَخَب",1,"ب",1,0],["حَتّى صَبَحنا أَهلَ مَكَّةَ فَيلَقاً","شَهباءَ يَقدُمُها الهُمامُ الأَشوَسُ",2,"س",1,0],["حتى صحوتُ قرعتُ من","ندمٍ عَلى الإِسرافِ سِنّي",3,"ن",2,0],["حتّى صفَتْ دَولةٌ كانتْ مكَدَّرةً","دَهْراً فقلتُ له خُذها ولا تَخَف",4,"ف",1,0],["حتى صدَرْتُ إليك يا صدْرَ الورى","بمَطالبي العُلْيا بك استِنْجاحا",5,"ح",2,0],["حتى صددت بلا جرم ولا سببٍ","صدّاً يحقّقُ عندي سرعة المللِ",6,"ل",1,0],["حَتَّى صَبَحْتَ بِلادَ مِيرُو وَقْعَةً","أَنْحى عَلَى الإِشراكِ سُوءُ صَباحِها",7,"ح",3,0],["حتى صبَحنا المجدَ في أبياته","والعزَّ في عاديّةِ المتقدِّمِ",8,"م",1,0],["حَتّى صَفا فَكَأَنَّهُ","دَمعُ الطَليقِ عَلى الأَسيرِ",9,"ر",1,0],["حتى صعدت على ذؤابة منبر","لو كان عوداً ماس ذاك العود",10,"د",1,0],["حتّى صحبتُكُمُ جهلاً بخيرِكُمُ","ثمَّ اِختبرتُ فَكنتمْ شَرَّ مُصْطَحَبِ",11,"ب",1,0]]}