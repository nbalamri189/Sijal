/www.poetsgate.com/ViewPoem.aspx?id=206953",""],[5910,"وهمسةٌ أتبعتْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=207788",""],[5943,"أوجاعُ الكهولة","https://www.poetsgate.com/ViewPoem.aspx?id=36083",""],[5950,"كلمتين أبيك تسمعها","https://www.poetsgate.com/ViewPoem.aspx?id=128131",""],[5952,"لأنّا خارجون","https://www.poetsgate.com/ViewPoem.aspx?id=214450",""],[5977,"القلب المعنّى","https://www.poetsgate.com/ViewPoem.aspx?id=215894",""],[4442,"تطوي الذميل على الرسيم","https://www.poetsgate.com/ViewPoem.aspx?id=171227",""],[6078,"ماغادرتني الروح","https://www.poetsgate.com/ViewPoem.aspx?id=203268",""],[6082,"حالة ايثار","https://www.poetsgate.com/ViewPoem.aspx?id=59125",""],[6093,"كُنْه الحُبِّ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=180644",""],[6124,"دع عنك","https://www.poetsgate.com/ViewPoem.aspx?id=201260",""],[6125,"دَع عَنكَ أعباءَ الحَيَاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=210714",""],[6152,"حسن العهد من الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=203304",""],[6152,"احفظ غيابي ولا تسمح لعابرة","https://www.poetsgate.com/ViewPoem.aspx?id=213217",""],[5309,"دع عنك لومي ولا تسأل عن الخبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573960",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""]],"verses":[["دع عنكَ من علَّقوا أوزارَهُم بِعُرى","شَراذِمٍ ما لها في الناعقينَ صَدى",0,"د",2,0],["دَع عَنكَ مَن شَحَطَت نَواهِ وَلا تَكُن","تَبغي مِنَ الأَشياءِ ما لَم تُرزَقِ",1,"ق",1,0],["دَعْ عَنْكَ هِنْداً وَالدِّيَارَ وَمَنْ بِهَا","وَدَعِ الْغَرَامَ يَكُونُ بَعْضَ عُفَاتِهَا",2,"ت",3,0],["دَع عَنكَ سَلمى إِذ فاتَ مَطلَبُها","وَاِذكُر خَليلَيكَ مِن بَني الحَكمِ",3,"م",1,0],["دَع عَنكَ ذِكرَ زَمانٍ فاتَ مَطلَبُهُ","وَاِقذِف بِرِجلَيكَ عَن مَتنِ الجَهالاتِ",4,"ت",1,0],["دَع عَنكَ شَعثاءَ إِذ كانَت مَوَدَّتُها","نَزراً وَشَرُّ وِصالِ الواصِلِ النَزِرُ",5,"ر",1,0],["دَع عَنكَ داراً قَد عَفا رَسمُها","وَاِبكِ عَلى حَمزَةَ ذي النائِلِ",6,"ل",1,0],["دع عنك خبط الجور في أمرنا","فقد أضاء السّنَن اللَّاحب",7,"ب",1,0],["دع عنك ما تتمنى لن ترى أبداً","سِفلاً كعُلوٍ ولا خَلفاً كقُدَّامِ",8,"م",1,0],["دَع عَنكَ نُصحي بِالتَبَلُّدِ ساعَةً","يا صاحِ قَد ذَهَبَ الأَسى بِتَبَلُّدي",9,"د",2,0],["دَع عَنكَ روما وَآثينا وَما حَوَتا","كُلُّ اليَواقيتِ في بَغدادَ وَالتُوَمِ",10,"م",1,0],["دَع عَنكَ ما قَد فاتَ في زَمَنِ الصِبا","وَاُذكُر ذُنوبَكَ وَاِبكِها يا مُذنِبُ",11,"ب",1,0],["دَع عَنكَ تَقويمَ مَن تُقَوِّمُهُ","وَابدَأ فَقَوِّم ما فيكَ مِن أَوَدِ",12,"د",1,0],["دَع عَنكَ ما اِختَلَفَ الوَرى في نَقلِهِ","عَنّي وَخُذ مَدحاً بِغَيرِ خِلافِ",13,"ف",1,0],["دَع عَنكَ دَع ذا إِذا اِنتَقَلتَ إِلى ال","مَدحِ وَشُب سَهلَهُ بِمُقتَضَبِه",14,"ب",2,0],["دَع عَنكَ مِن لَومِ قَومٍ لَستَ تَخبُرُهُم","إِلّا تَكَشَّفَ سِترُ الغَيبِ عَن عَيبِ",15,"ب",1,1],["دَع عَنكَ ثَيِّبَ كُلِّ نُعمى وَاِلتَمِس","مِنَحاً لِإِبراهيمَ فَهيَ عَذاري",16,"ر",2,0],["دَعْ عُميراً لا تَهِجْهُ وَاتَّئِدْ","إنَّ للعاقلِ في الأمرِ اتّئادا",17,"د",2,0],["دَع عَنكَ لَومي فَإِنَّ اللَومَ إِغراءُ","وَداوِني بِالَّتي كانَت هِيَ الداءُ",18,"ا",2,1],["دَع عَنكَ يا صاحِ الفِكَر","فيمَن تَغَيَّرَ أَو هَجَر",19,"ر",1,1],["دَع عَنكَ ما جَدّوا بِهِ وَتَبَطَّلِ","وَإِذا مَرَرتَ بِرَبعِ قَصفٍ فَاِنزِلِ",20,"ل",1,1],["دَع عَنكَ حَمّاداً وَخُلقانَهُ","لا خَيرَ في خُلقانِ حَمّادِ",21,"د",1,0],["دَع عَنكَ سَلمى شَجىً لِطالِبَها","لا يَسبِقُ الرَأيُ دونَ ما كُتِبا",22,"ب",2,0],["دَعْ عنكَ تَعنيفي وذُقْ طعم الهَوَى","فإذا عشِقْتَ فبعدَ ذلكَ عَنّف",23,"ف",1,0],["دَعْ عَاذِلاً أَوْ سَائِلاُ مَا بَعْدُ","أَليَوْمَ ظُلْمَةٌ تَسِيلُ خَمْرَا",24,"ر",2,0],["دع عصبةً نَقَمت علي","ه؛ لأنها لم تَدرِه",25,"ر",2,0],["دع عنك من كعبٍ وحاتِم إنما","للّجود معنى عنده تحقيقه",26,"ق",2,0],["دَعْ عَنكَ نَهباً صِيحَ فيحَجَرَاتِهِ","ولكن حديثاً ما حديثُ الرواحلِ",27,"ل",1,1],["دَع عَنكَ قُرب مَعاشر آجالهم","مَقرونة بِتذكر الإِنفاقِ",28,"ق",1,1],["دع عنك من جهل المحبة او بغى","في دينها فكلاهما خسران",29,"ن",1,0],["دع عنك جورك وارحم","فللزمان انفتال",30,"ل",1,0],["دع عنك عذلي وطف بي بعض ثانية","بكعبة من طيوف الغادة الرود",31,"د",1,0],["دعْ عَنك لومِي واتئل","إنْ كنتَ ذَا عقل حليما",32,"م",2,0],["دع عنك هذا الجفا وأرحم فؤاد شجٍ","ولا تُطع مَن وشى يا أحسنُ الناسِ",33,"س",1,0],["دعْ عنكَ أمرَ غدٍ إذا ما خفتهُ","يوماً لعلكَ لا تعيش إلى غدِ",34,"د",1,0],["دع عنك يا عاذلي لومي وتعنيفي","وكف عما به تعني وتعني في",35,"ف",2,1],["دَع عَنكَ لَومَ عاشِقٍ تُطرِبُهُ","حَمائِمُ الباناتِ في غُصونِها",36,"ن",3,0],["دَع عَنكَ عَذلَ عاشِقٍ فُؤادُهُ","قَد سَدِكَ الوَجدُ بِهِ أَيَّ سَدَك",37,"ك",1,0],["دَع عَذلَهُ إِن كُنتَ ناصِحَهُ فَمِن","تَهذيبِهِ عِصيانُ ما تَهذي بِهِ",38,"ب",2,0],["دع عنك أيام السرور","بين الجنائن والغدير",39,"ر",1,1],["دَع عَنكَ ما راحَت الأَقلام تنقشُهُ","في صَفحةِ السيفِ ما يُغني عنِ القلمِ",40,"م",1,0],["دعْ عنك تمحيصَ الحقيقةِ إنها","تدعُ الفتى في كل شيءٍ زاهدا",41,"د",2,0],["دَعْ عَنْكَ هذا وَخذْ فيما شَرَعْتَ به","فربَّما قد سعى الواشي به خببا",42,"ب",2,0],["دَع عَنكَ لَومي عاذِلي في حُبِّهِ","فَاللَومُ إِغراءٌ وَأُذني صَمت",43,"ت",1,0],["دَعْ عنك قلبي فإنَّ الحُبَّ آمِرُه","أَضعافَ ما أَنت بالتّثْريبِ ناهيه",44,"ي",2,0],["دَعْ عنكَ يُمنَى ويُسرَى غيرَ مُجدِيةٍ","واقْصِدْ أَمامك فاطْلُبْ مُنتَهى السُّبُل",45,"ل",1,0],["دع عَينَهُ لِعَفائِها","فَشِفاؤُهُ في دائِها",46,"ه",2,1],["دع عنك لومي ثم كن","بي لا علي ولا ليه",47,"ي",2,0],["دع عنك لومي يا عذو","لُ ولا تَضع فينا الدسائس",48,"س",1,0],["دع عنك لومي إنني","أمسي بحزني واَصطبح",49,"ح",1,0],["دع عنك غيَّك واحتشم","ليس التبسم كالبكا",50,"ا",1,0],["دَع عَنكَ أَصنافَ الخَطل","وَلا سَقى الشَباب طَل",51,"ل",1,0],["دعْ عنكَ منْ يُبدي ابتسامَتَهُ على","دَخنٍ ، وسُمُّ لسانِهِ مسكوبُ",52,"ب",1,0],["دَع عَنكَ ذكر العامِريَّة إِنَّهُ","وَأَبيك مَغناطيس كل غَرامِ",53,"م",1,0],["دع عنك ذكرى من مضى قبله","كم ترك الأول للآخرين",54,"ن",1,0],["دع عنك جيرون لقد فاته","نزهة ذا الفوار والمنظرُ",55,"ر",1,1],["دع عنك يوم عو يرضٍ وانظر إلى","يومٍ بحواريت ذات الطائر",56,"ر",1,1],["دع عنك قول الحسادين ومكرهم","بين الوشاة وبين قلبي كم أمد",57,"د",1,0],["دع عنك عمروَ البأس أو كعبَ النّدى","لا يستوي المسموعِ والمرثيّ",58,"ي",1,0],["دع عنك صهباء الدساكر","وإلى بيوت الدرس بادر",59,"ر",1,1],["دعْ عنك لومي أنَّ عزمي والسرى","أخوا لِبانٍ كالنَّدى ومُظفَّر",60,"ر",1,0],["دعْ عنك مركوم السْحاب وودْقَه","وابْغِ النَّدى عند الإِمامِ المُفْضِل",61,"ل",1,0],["دَع عَنكَ ذا الأَلسِ ذَميماً إِذا","أَعرَضَ وَاِستَبدَلَ فَاِستَبدِلِ",62,"ل",1,0],["دعْ عنكَ ما زخرفَ الواشي وما زَعَما","لم يَصْحُ قلبي مِنَ البلوى ولا عَزَما",63,"م",2,1],["دع عنك ما اعترض الصداقة برهة","متناسيا له فالحبيب حبيب",64,"ب",1,0],["دع عنك دعوى الحب لست بعاشق","أترافق الخود الحسان وتدعي",65,"ع",2,0],["دع عنك من كثفت رقيقه قلبه","فعدا وزاد بغيه بهتانا",66,"ن",2,0],["دَعْ عنكَ جَلْجَلةَ الآثارِ مَلْتَفِتاً","عنها إليه وهذا القَصْدُ والطَّلبُ",67,"ب",1,0],["دعْ عنكَ من نَزَغَتْ بغيٍّ نفسُهُ","وعليه من شُقَقِ البِعادِ غِطاءُ",68,"ا",2,0],["دعْ عنك ما انْتحلوهُ من زَخارِفِهِمْ","وافْطنْ فسانِحَةُ التَّوفيقِ خلْصاءُ",69,"ا",2,0],["دعْ عنكَ خوفاً فإنّ القومَ قد فهِموا","قد جاء وقتُك وهيْهاتَ تنغلبُ",70,"ب",1,0],["دعْ عنكَ أخبارَ الكِرامِ فإنّه","هو زُبدةٌ يَكفيكَها ونَموذَجُ",71,"ج",1,0],["دَعْ عَنْكَ أَمْراً إنْ نَهَضْ","تَ لَهُ فَعُقْباهُ النَّدامَهْ",72,"ه",1,1],["دَعْ عَنْكَ تَذْكارَ الَهَوى فَعَنِ الَهَوى","إن كُنْتَ تَعْقِلُ قَدْ نَهَاكَ نُهاكا",73,"ك",2,0],["دَعْ عَنْكَ قَالَ وَقِيلَ والْ","زَمْ ما يَقِي لَفْحَ الحَرُورِ",74,"ر",1,0],["دَعْ عَنْكَ صَنْعا هذِهِ ال","أَحْبَابُ عَنْها أَتْهَمَتْ",75,"ت",1,1],["دع عَنك دَمعي فوقَ صدري إنَّه","لِقُلوبِنَا في سَكبِه أشفَى لَها",76,"ل",3,0],["دعْ عنك وَقّافاً على أرْبُعٍ","يسأل فيهنّ عن الرّاحلِ",77,"ل",1,0],["دعْ عنك عَذْلي فإنّ العذل منك وما","هذي الصّبابةُ من عندي ولا قِبَلي",78,"ل",2,0],["دَعْ عنكَ كلَّ لئيمِ الطّبعِ مُبتذَلٍ","أذلَّ في عَرَصاتِ الدار من وَتدِ",79,"د",1,0],["دعْ عَنْكَ مِلْكِي وعِتْقِي إِنَّني رجُلٌ","للفاضلِ بنِ عليٍّ صرتُ مملوكَا",80,"ك",2,0],["دَع عَنكَ ما قالَ العَذولُ وَلاكا","هَيهاتَ أَصبو عَن حَنيبٍ وَلاكا",81,"ك",2,1],["دع عنك لومي فإني غير منقاد","إلى الملام وإن أحببت إرشادي",82,"ي",1,1],["دع عنكَ أحمدَ لا تَعدِل بِه أحَدا","فَلَيسَ يَعدِلُه في فَضلِهِ أحَد",83,"د",1,0],["دَع عَنكَ يا جاهِلاً إِنكارَ مَعرفة","ما حازَها غَيرُه في الأَعصر الأُوَل",84,"ل",1,0],["دَع عَنكَ ما تَهذي بِهِ عِندي فما","كُلِّفتَ إِصلاحي وَلا تَهذيبي",85,"ب",2,0],["دع عنك تذكار أيام اللذاذات","وطيب عصر تقضى بالشبابات",86,"ت",1,1],["دَع عَذولي وَقَولَه لَو صَحيحاً","فَعَذولي مَقالُهُ بُهتانُ",87,"ن",1,0],["دع عنك ذكر الأهواء ناحيةً","فليس ممن شهدت ذو ورع",88,"ع",1,0],["دَع عَنكَ تَعنيفي لكُلٍّ عمر","اليَوم خَمرٌ وَالغَداةَ أَمرُ",89,"ر",1,0],["دع عنك ذا وانظر قتيل الهوى","واقتبس النيران مِن كبْدِه",90,"ه",1,0],["دَع عَنكَ رائِعَةَ الأَغاني","جَفَّت عَلى شَفَتِي الأَماني",91,"ن",2,1],["دع عنك أخبار الرواة وهاك ما","نصب العيان بمسمعٍ وبمنظر",92,"ر",1,0],["دعْ عنك هماً أتى أدراجَ أوّله","واكربْ لرحلك كالبيدانة الأُجدِ",93,"د",1,1],["دع عنك لومي فان اللوم اغراء","ودواني بالتي كانت هي الداء",94,"ا",2,0],["دَع عَنكَ تِذكار العَقيق وَقُم إِلى","بُرجٍ تَشَيَّدَ وَسَط مَرجِ زُمردِ",95,"د",1,0],["دع عنك ما قد كان في زمن الصبا","وخذ العبادة ديدناً وشعارا",96,"ر",2,0],["دع عنك عد جفانهم فلقد غدت","مثل الدراري لن تطيق حسابها",97,"ب",3,0],["دع عنك رسوم غواية من","أغراه الشك إلى الندمِ",98,"م",1,0],["دع عنك هذا الفن واقصد غيره","إذ لست للشعر النظيم بمتقنِ",99,"ن",1,0],["دَع عَنكَ قِسطاسَ اللِسانِ وَلا تَزن","مَن كُنت تَحسَبُ راجِحاً أَو ناقِصا",100,"ص",2,1],["دع عنك سُعدَى فسُعدى عنك نازحة","واكفُف هواكَ وعدِّ القولَ في لُطفِ",101,"ف",1,0],["دَع عنكَ جدوى كلِّ خلٍّ باخلٍ","ذوبساحِ سيحِ الشيخِ عرِّج وانزِلِ",102,"ل",1,0],["دع عنك تعنيفي وذق طعم الهوى","إن لم تكن تصغي لقول الألف",103,"ف",1,0],["دع عنك لومى في هواه واتئد","فنبال عذلك مالهن مرامى",104,"م",2,0],["دع عنك جمع الكتب بعد رجالها","وابك العلوم بمدمع مهراق",105,"ق",1,0],["دع عنك لومى وانظر حسن صورته","واعذل أوا عذرا فتى حمل الهوى جهظه",106,"ظ",2,0],["دع عبدَ