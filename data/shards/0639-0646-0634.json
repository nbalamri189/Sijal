رجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119443","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94440","الكامل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101293","الكامل"],[4791,"حبك سماها","https://www.poetsgate.com/ViewPoem.aspx?id=28418",""],[4883,"سجده في المسجد الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=48369",""],[4979,"قل ياعبير","https://www.poetsgate.com/ViewPoem.aspx?id=176536",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5444,"رُبَّ الادعاء","https://www.poetsgate.com/ViewPoem.aspx?id=205449",""],[5652,"بجروح صدر الشمري","https://www.poetsgate.com/ViewPoem.aspx?id=164386",""],[5652,"لك العذر ياهاجسي","https://www.poetsgate.com/ViewPoem.aspx?id=181801",""],[5732,"من يم خلي","https://www.poetsgate.com/ViewPoem.aspx?id=177891",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5809,"مراض","https://www.poetsgate.com/ViewPoem.aspx?id=205099",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["عَن شَقشَقٍ ثُمَّ هَدَر","ثُمَّ تَجافى فَخَطَر",0,"ر",1,0],["عن شمس النهار تطلع باليل","لِ وشمس القلوب ليس تغيب",1,"ب",1,0],["عن شيبة الحمد اذ تروى وعن اسد","تنهل بالمجد هل العارض العطل",2,"ل",1,0],["عن شُمُوسٍ سَطَعت أنوارُها","تَملأ الأرضَ سُروراً والبَشَر",3,"ر",1,0],["عن شَقيٍّ عن أبيٍّ عاثِرٍ","عن شَرِيدٍ عن نَبيٍّ مُحتَقَر",3,"ر",1,0],["عن شرِّ مُنقَلَبٍ تُجلى عواقِبُهُ","وقلَّما حُمِدَ المغرورُ مُنقلبا",4,"ب",2,0],["عَن شَبيهٍ له الزمان عقيمُ","فَعَليهِ الصلاةُ والتسليمُ",5,"م",1,0],["عن شقوتي في هيامي","روى ظلامُ الليالي",6,"ي",1,0],["عَن شَأوِهِ كُلُّ اِمرِئٍ مُتَأَخِّرٌ","وَبِهِ تَقَدَّمَ كُلُّ مَن يَتَقَدَّمُ",7,"م",1,0],["عَن شُربِ ساري يا إِلَهي جازِهِ","خَيرَ الجَزاءِ فَأَنتَ خَيرُ مُجازي",8,"ز",2,0],["عَن شَرَفيها الجِنانُ كاسِفَةً","راسِفَةً في قُيودِ تَقصيرِ",9,"ر",1,0],["عن شكرِ نجم الدين وال","قاضي الرشيدِ الأنْجَبِ",10,"ب",1,0],["عن شكوت الهوى رأيت من الع","ذال شأناً يشينُ شأني بيانه",11,"ن",2,0],["عن شاطحٍ مستحيلٍ","ويابسِ القِحْفِ ناشِفْ",12,"ف",1,0],["عن شيخه الحبر أبي حيان","إمام أهل النحو والقرآن",13,"ن",1,0],["عن شيخه المحتسب الشعباني","ابن ابي رقيبة المهراني",14,"ي",1,0],["عن شتيتٍ واضحٍ ملتمع","فدعي دمعي ولكن رخّما",15,"م",2,0],["عَن شيخِنا التازِ عبدِ العزيزِ ألا","تلكِ المكارِمُ لاقعبانِ من لَبَنِ",16,"ن",1,0],["عَنشنشاتٌ علَيها كلُّ مُدَّرِعٍ","عَنَشنَشٍ لَم يزَل بالسيفِ مُنتَطِقا",17,"ق",2,0],["عن شديد القوى تلقَّنَ علماً","أكبرتهُ مداركُ العِرفانِ",18,"ن",1,0],["عَن شاهِدٍ إِذا اِنفَجَر","يا مَن بِهِ شِعري اِفتَخَر",19,"ر",1,0],["عن شريكٍ غيرِ ما أثبته","حكمُ إمكانٍ لشخصٍ ذي جنان",20,"ن",1,0],["عن شؤون العمر طرّا","فهو في الحب استقرّا وأقاما",21,"م",2,0],["عن شاهدِ الحالِ غدت مصطلمة","لم تكُ بالآثارِ ذاتَ مَعلمة",22,"ه",1,0],["عَن شَيخنا الفَرد عَبد اللَه مَن ختمت","بِهِ المَعالي فَأَضحى نُقطة الخاء",23,"ا",2,0],["عَن شَيخه جمعة المولى الَّذي جمعَت","لَهُ الفَضائل في جهر وَإخفاء",23,"ا",2,0],["عن شمالي كلَّما ولَّى دُجى","وسرى فجر وحنت شفتان",24,"ن",1,0],["عن شيمتي وخَليقتي","إن كنتَ عن ذا الفخرِ سائلْ",25,"ل",1,0],["عن شلو فطرقل إلى الوراء","لا تلتووا يا معشر الأخاء",26,"ا",2,0],["عن شم طيب رياحين الربيع فقل","لا المسك مسك ولا الكافور كافور",27,"ر",1,0],["عن شهريار الملك حسن روايةٍ","تروى بنثرٍ بالحسان تجلبا",28,"ب",2,0],["عن شكل هندسة يقوس حاجباً","فبليت بين مهند ومهندس",29,"س",1,0],["عن شوف غيرك كن في ناظري قيد","أحسب بصرها غاطسٍ في عماها",30,"ا",3,0],["عن شَجر زيتون في يافا يمر البال: ريحه","عن حَجر فجّر طفل ف الصمْت : يارهبة سِلاحه!",31,"ح",2,0],["عن شعبا في فضلة","غن ذلك الشعب الاغر",32,"ر",1,0],["عن شهوةٍ للانتقامِ بنفسِها","من غادرٍ كانَ اسْتباحَ شعورَها",33,"ر",3,0],["عن شارعٍ نخطو به مُذْ أشرقت","شمسٌ به أو كان يومَ ضباب!",34,"ب",1,0],["عن شوفتك والله مازلت مضيوم","ولولا الغلا يمدي نسينا احترامك",35,"ك",1,0],["عن شي ماهو في خيالي لو كتبته يستزيد","الا شعورآ قوته يشبه شموخ معاويه",36,"و",3,0],["عن شوف وضاح الجبين محرومي","والقلب من بد المخاليق رامه",37,"م",2,0],["عن شاعرٍ ينمازُ عن غيرِهِ","بأنهُ المُفردُ وهو الفريقْ",38,"ق",1,0],["عن شفاهٍ مثل تينٍ ناضجٍ","رائعِ الشكلِ لذيذِ المُحتوى",39,"و",2,0],["عَنْ شَمْعَةٍ فِي الضَّمِيرِ مُوقَدَةٍ","وَشَمْعَةٍ فِيهِ غَيْرِ مُوقَدَةِ",40,"ه",1,0]]}