لكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111194","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136594",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83562","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28772","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66098","المتقارب"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99111","الوافر"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113828","الطويل"],[4767,"شباب الطف","https://www.poetsgate.com/ViewPoem.aspx?id=199910",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[5277,"جيرةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=192256",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5362,"بني الشعب ما هذا التخاذل بينكم","https://www.poetsgate.com/ViewPoem.aspx?id=170373",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[5472,"فهمت ما قلت فى برّي ومنزلتى","https://www.poetsgate.com/ViewPoem.aspx?id=200470",""],[5616,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=203324",""],[694,"ألا يا عين بكي لا تملي","https://www.poetsgate.com/ViewPoem.aspx?id=81338",""],[5952,"سيرٌ إلى اللا أمام","https://www.poetsgate.com/ViewPoem.aspx?id=212589",""],[5957,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=24468",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6093,"أسْتَغفرُ اللهً ممَّا","https://www.poetsgate.com/ViewPoem.aspx?id=176421",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""]],"verses":[["فَقَدْ بَسَطتْ باعي بِهِ خُنْزُوانَةٌ","تَضمَّنُ يَوْمَ الرَّوعِ رِيَّ المَناصِلِ",0,"ل",1,0],["فقد بلَغْتَ بِها ما عَزَّ مَطْلَبُهُ","على ظُبا الهِنْد وانِيّاتِ والأسَلِ",1,"ل",1,0],["فقدْ بلَغَتْ أقصى المُنى بكَ نفسُها","وكمْ فازَ بالوصْلِ المُهَنّأِ مُشْتاقُ",2,"ق",1,0],["فقد بحّ صوتي واستشاطت جوانحي","وقلّ أصطباري وأستطال بكائي",3,"ا",2,0],["فقد بثَّ عبدُ الله جندَ انْتقامه","على الليلِ حتَّى ما تدِبُّ عقاربه",4,"ه",1,0],["فَقَدٍ بتوبةٍ مخلصٍ","للواحد الأحد الصَمَدْ",5,"د",1,0],["فَقَد بَشَّرَتني بِالسَعادَةِ هِمَّتي","وَجاءَ مِنَ العَلياءِ نَحوي كِتابُها",6,"ب",3,0],["فقد بزّ أموالاً لسفيان واعتدى","على صادق واغتال من خبثه عمرا",7,"ر",2,0],["فَقَد بَرَدَت فَوقَ اللُقانِ دِماؤُهُم","وَنَحنُ أُناسٌ نُتبِعُ البارِدَ السُخنا",8,"ن",2,0],["فَقَد بَوَّأتَني أَعلى مَحَلٍّ","شَريفٍ في المَكانِ بِكَ المَكينِ",9,"ن",1,0],["فَقَد بَلَّغتِني مَن كُنتُ أَرجو","جَداهُ رَجاةَ هَطّالٍ سَجومِ",10,"م",1,1],["فقد بردَت تلك المضاجعُ منهم","فأشرقَ ذاك النُّورُ فيها فما يخبو",11,"ب",2,0],["فَقَد بَثَّ عَبدُ اللَهِ خَوفَ اِنتِقامِهِ","عَلى اللَيلِ حَتّى ما تَدِبُّ عَقارِبُه",12,"ب",2,0],["فَقَد باعَدَت نَفساً عَلَيها شَفيقَةً","وَقَلباً عَصى فيها المُحِبَّ المُقَرَّبا",13,"ب",2,0],["فَقَد بَكى جَفني دَماً سائِلاً","حَتّى لَقَد ساعَدَهُ سَعِدي",14,"ي",1,0],["فَقَد بِزِمامٍ بَظرَ أُمِّكَ وَاِحتَفِر","بِأَيرِ أَبيكَ الفَسلِ كُرّاثَ عاسِمِ",15,"م",1,0],["فَقَد باعَدَت نَفساً عَلَيها شَفِيقَةً","وَقَلباً عَصى فيها الحَبيبَ المُقَرَّبا",16,"ب",2,0],["فَقَد بَقوا في دينِهِم حَيارى","فَلا يَهودٌ هُم وَلا نَصارى",17,"ر",2,0],["فَقَد بُدِّلوا أَجداثَهُم مِن سُروجِهِم","فَأَنبَتَ رَوضاً طَلُّها وَسَقيطُها",18,"ط",3,0],["فَقَد بلغنا كلانا","من الحَياة عتيّا",19,"ي",2,0],["فَقَد بَكَيت من البؤ","س والشقاء سنينا",20,"ن",2,0],["فَقَد بُدِّلتُ ذاكَ بِنُعمِ بَالٍ","وأَيَّامٍ لَياليها قِصارُ",21,"ر",1,0],["فقد بدتِ النّياتُ لا سَتْردَونها","ولا حاجبٌ الا الكلامُ المرعبل",22,"ل",1,0],["فَقَدْ بَانَ أَيَّام الصِّبَا ثُمَّ لَمْ يَكَدْ،","مِنَ الدَّهْرِ، شَيْءٌ، بَعْدَهُنَّ، يَلينُ",23,"ن",1,0],["فقد بزت الأيام عني مطاريا","وقد هدمت أيدي الخطوب بنائيا",24,"ي",2,0],["فقد بنيته باسم ووصف","مبين في ابتدائي واختتامي",25,"م",2,0],["فَقَد باعَتِ الأَسباطُ قَبلي أَخاهُمُ","بِبَخسٍ وَكُلٌّ مِنهُمُ فيهِ زاهِدُ",26,"د",1,0],["فَقَد بُليتُ بعصرٍ كلّه فتنٌ","فيهِ أخو الحقّ مغلوبٌ ومغلولُ",27,"ل",1,0],["فَقَد بَرَّحَت بي وَكَوني خُصِصتُ","مِنَ الناسِ وَحدي بِها أَبرَحُ",28,"ح",1,0],["فقد بِتَّ جاراً للإمام وأنه","أعز بَنى الدنيا جِواراً وأمنَعُ",29,"ع",1,0],["فَقَد بَكَيتُ على رَسمٍ لِدَمنَتِها","فَالقَلبُ مِن ذِكرِها ما عِشتُ مُختَبَلُ",30,"ل",1,0],["فَقَد بَمادى هَجري وَقَصَّرَ بي","نَضوَ اِعتِمادي وَطالَ تَردادي",31,"د",2,0],["فقد بَلَغْتُ مِن زَم","ني كُلَّ ما أقتَرِح",32,"ح",1,0],["فقد بلغ الأَقصى الأسى وفني العزا","لموت العتيكي راشد بن سعيد",33,"د",1,0],["فقد بهرته هيبتنا","فامضى وهو شبه عم",34,"م",1,0],["فَقَد بَدا زَبَرجَدُ اللَبلابِ","مُرَصَّعاً بِلُؤلُؤِ السَحابِ",35,"ب",1,0],["فَقَدْ بَرحَ الْخَفاءُ فلا تُجِبْهُ","فإنَّ الْجَهْلَ كالدّاءِ الْعُضالِ",36,"ل",1,0],["فَقد بتتِّ فلا بذلٌ ولا عِدَةٌ","حبلاً لوصلِكِ لِي ما كان مبتوتا",37,"ت",2,0],["فقد بان منها للورى فَضْل آخرٍ","كما بان منها عندهم نَقْضُ أَوَّلِ",38,"ل",1,0],["فَقَدْ بَسَطْتُ لِذَاكَ الفَعْلِ مَعْذِرةً","لما تيقَّنتُ أَنَّ الرزقَ مَقْسُومُ",39,"م",1,0],["فَقَد بَلَغَت حَناجِرَها قُلُوبٌ","يُردِّدُها التَّنَهُّدُ في التَّراقي",40,"ق",2,0],["فقد بنا للحرب يا ربها","فقد عقدنا النصر في رايتك",41,"ك",1,0],["فَقَد بانُوا وَبانَ منِ اِقتَفاهم","خَفى نورٌ بَدا مِنهُم وَغابا",42,"ب",2,0],["فقد بدَا مِن حِرصِه على الشجر","ما كان شر ذاك طائرَ الشرر",43,"ر",1,0],["فَقَدْ بَدَا وَالقَصْدُ يَبْدُو لَقَمُهْ","لِلْحَقِّ نَجْدٌ مُسْتَبِينٌ مَحْزِمُهْ",44,"م",2,0],["فَقَد بَدَا عَطفُهُمَا وَقَد بَطَن","نَفسِي الفِداءُ لأميرَيَّ وَمَن",45,"ن",1,0],["فقد بات حب الله بالعصر زائلا","بحبك يا ليلى وحب الدراهم",46,"م",1,0],["فقد بدا الفجر ولّما نزل","في ليل شكٍّ للورى مُبتلي",47,"ل",2,0],["فقد بلغت المنى والسول فاجتهدي","هناك واستنجدي لي طرفك الباكي",48,"ك",2,0],["فقد باهت بك الأعيادَ نفسٌ","نَهاها عن سوى التقوى نُهاها",49,"ا",3,0],["فقد برعناء 