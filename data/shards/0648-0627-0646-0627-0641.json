poetsgate.com/ViewPoem.aspx?id=51292",""],[5843,"\" تيب \" اضحي بحرف \" الطاء\" علشانها واللغيه","https://www.poetsgate.com/ViewPoem.aspx?id=51301",""],[5862,"فلّسفة .. أفكار : عطّشانه .. !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31097",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[6102,"زِئبَق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184169",""],[6104,"أريج الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=25365",""],[6113,"لعبة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=120905",""],[6189,"وصية حرام بن ملحان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83557&r=&rc=24",""],[6189,"بيان للجماهير المحتشدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83593&r=&rc=60",""],[6189,"فواصل .. للصبح الجنوبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83603&r=&rc=70",""],[6247,"حروف مهاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80264&r=&rc=3",""],[6328,"تاء التأنيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84884&r=&rc=25",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""]],"verses":[["وَإِنَّ أَفَظَّ المالِكينَ خَريدَةٌ","وَإِنَّ أَضَنَّ الباذِلينَ كَعابُ",0,"ب",1,0],["وإنْ أفْرَطَ الشّيْءُ اسْتَحالَ لضِدّهِ","وكمْ طابِخٍ كشْحانَ رمّدَ ما شَوى",1,"و",2,0],["وَإِن أَفاضَ دُموعي نَوحُ باكِيَةٍ","فَكَم أَراهُ يُغَنّيني فَيُشجيني",2,"ن",2,0],["وأن أفسدتهم خُطّة قام مُصلِحاً","وأن لَدَغَتْهمِ فتنةٌ قام راقيا",3,"ي",2,0],["وَإِن أَفَلَت تِلكَ البُدورُ عَشِيَّةً","فَإِنَّ نُحوسي بِالفِراقِ طَوالِعُ",4,"ع",1,0],["وَأَنّا فَتَكنا بِالأَغَرِّ اِبنِ رائِقٍ","عَشِيَّةَ دَبَّت بِالفَسادِ عَقارِبُه",5,"ب",2,0],["وإن أفاض حديثاً أو نوال يدٍ","وردْت من حالتيه غير مورود",6,"د",1,0],["وإنَّ افْتقادي واحداً بعد واحد","دليل على أن لا يدوم خليل",7,"ل",1,0],["وأن إفضاله ونائله","لطالبي الفضل من مرافقها",8,"ق",3,0],["وإنا في صناعتنا لرهطٌ","ودولتُنا بدولتكم تدولُ",9,"ل",1,0],["وإن افتقدت الحُزن مفتقِداً","لُبِّي لفقدِك للحَرِي القَمِنُ",10,"ن",1,0],["وأن أفوز بالوجود","راجعاً من عدمي",11,"م",2,0],["وَإِن أَفَضنا في نَثاهُ فَقُل","في نَفَحاتِ المِسكِ غَضّا يَضوع",12,"ع",1,0],["وَأَنافَت بِهَوادٍ تُلُعٍ","كَجُذوعٍ شُذَّبَت عَنها القِشَر",13,"ر",1,0],["وإن أفاد سكوت","كانَ السكوت كلاما",14,"م",2,0],["وَأنَّ افْتِكاكاً مِن هَوىً مُتَمَكنٍ","عَنَاءٌ عَلَى مِقْدَارِهِ يَعْظُمُ الفَخْرُ",15,"ر",1,0],["وأناف بالعصفور في سَعَفٍ","هامٍ أشمّ مُوَثَّقُ الجِذر",16,"ر",1,0],["وإن افتقادي فاطما بعد أحمد","دليل على أن لايدوم خليل",17,"ل",1,0],["وأنا فيهم الغريب المعنى","والعنا طال بي لهم واستطالا",18,"ل",2,0],["وانافَ المجدُ على زُحلٍ","وأتى بغرائبهِ الكرمُ",19,"م",1,0],["وإنْ أفاضَ على العافينَ نائلُهُ","أَرواهُمُ بغمامٍ منهُ مُنْسفكِ",20,"ك",1,0],["وَأَن أُفارِقَكُم حَرّانَ قَد بَرَدَت","بِيَ المُعادُونَ أَحقاداً وَأَضغانا",21,"ن",2,0],["وأنا فديتكَ شاعرٌ حسبي من الدّ","نيا وما فيها فتىً يرعاني",22,"ن",2,0],["وأنا في وصفها غَرِدٌ","ترقصُ الدنيا على نغمي",23,"م",2,0],["وَأَنا فَتىً ما زِلتُ أَجمَعُ من","رَوضِ الصَبابَةِ وَالهَوى عَقدي",24,"د",2,0],["وَأَنا في مخدَعي لا تَنثَني","عن جُفوني مُردا الشَهد الطوال",25,"ل",1,0],["وأَنا في الجميلِ عنك لنفسِي","شاكرٌ حامدٌ وجازٍ مُكافِ",26,"ف",1,0],["وَإنّ اِفترار العضبِ مُبكي الطلى دماً","وَفي مائهِ برد يشبّ الحَشا لهبا",27,"ب",2,0],["وأنا في ذُرَى الغرامِ غَريقٌ","مِلأُ عيني دُجىً كساهُ الضَّباب",28,"ب",1,0],["وأنا فيه مثلما عهدتني","قبل بدء الوجود والأكوان",29,"ن",1,0],["وأنا في محيطه موجةٌ تف","نى فلا يحتفى بها شاطئاه",30,"ه",1,0],["وأنا فيه كما شا","ءت رياح الخالق",31,"ق",1,0],["وإنَّا في هواك كما ترانا","عطاشى لا تُؤَمِّلنا ببالك",32,"ك",1,0],["وأنا فداءُ مجبٍ لو أنّه","ملِكٌ لكان الجَورُ في أيامِه",33,"م",2,0],["وأنا في مفاهمة ولسنا","مع الأحرار منهم في خصام",34,"م",1,0],["وأنا في كثافة","مطري منك أثلجا",35,"ج",2,0],["وأنا فوق إشارا","تي وكل الشطحات",36,"ت",1,0],["وأنا في محض إيقا","ن وهم في الشبهات",36,"ت",1,0],["وَأَنافَت إِلى السَماء عَناناً","وَرمت بِالهَوان أَهل الخِيانَهْ",37,"ن",2,0],["وأنا في إخلافه بسواهُ","واثقُ القلب بالإلاه الرؤوفِ",38,"ف",1,0],["وأنا في طاعة الحب ومن","عشقت روحي بروحي يفتدى",39,"د",2,0],["وإن آفةً ما في البيت واقعة","به إذا أرضت السِّنورةُ الجُرُذا",40,"ذ",2,0],["وإن إفَنتَ الروم ينقادُ خاضعاً","كما إنقاد من بعد الإباء جَموح",41,"ح",1,0],["وَإِنِ افتَقَرتَ فَلاَ تَكُن مُتَخَشِّعاً","تَرجُو الفَوَاضِلَ عِندَ غَيرِ المُفضِلِ",42,"ل",1,0],["وَأَنَا فِي تَخْيُّرِي وَجَدِّي","إِذَا تَنَخَّلْتُ جِيادَ القَدِّ",43,"د",1,0],["وأنا فتاه اليوم فتح الله قد","وافيت الثم ذيل عفوك منشدا",44,"د",2,0],["وَإِن إِفسادي كَون صوره","لِشَهوة تعرض أَو ضَروره",45,"ه",1,0],["وإنّا فديةُ الأوطانِ نَمشي","جميعاً للعُلى بها متطوّعينا",46,"ن",2,0],["وإن أفلست لا يدخلن بيتي","أهذا الذوق ذوق بنات مصر",47,"ر",1,0],["وَإنْ أفْلَتَ الغُوَّارُ مِنْ بأس هَذهِ","فإمَّا لأخْرى أوْ لِنَوْحِ النَّوائِبِ",48,"ب",1,0],["وإن أفاءَ الله من فضله","غنيمةً من وقعةٍ توقع",49,"ع",1,0],["وان افوت درك كل طلب","وادرك المطلوب دون طلب",50,"ب",1,0],["وأَنافَ جَدُّك والإباء على الذي","شادت لك الأجداد والآباء",51,"ا",2,0],["وأنا في الأنام من فرط وجدي","طار قلبي والعود غنّى عليه",52,"ه",1,0],["وأنا فتيان وقطب عرودك","سقيت لأرباب المكارم صافي",53,"ف",2,0],["وأنا في الغرامِ أسحبُ ذَيلي","ثملاً من طلا مدامِ هوانِ",54,"ن",1,0],["وأن أفضل الأنام طرا","طه الذي عم البرايا برا",55,"ر",2,0],["وأنا في الحياة نضو تهاوي","نجمه بعد أن تعالى سعودا",56,"د",2,0],["وأنا في يَديهِ قِطعةُ لَحمٍ","فأنقِذوني مِن أبقة الأَكّال",57,"ل",1,0],["وأنا في النهر ترجي","ع لموسيقى الخرير",58,"ر",1,0],["وأنا في الشعر تحري","ك لأوتار الشعور",58,"ر",1,0],["وأنا فقير حصل لي","من كل أرض نصيب",59,"ب",1,0],["وأنا في القيود مثلُكِ حيرا","نُ أَخَيْرٌ سلاسلي أم شَرّ",60,"ر",1,0],["وانا في هذِهِ الدّنيَا غريب","خلياني",61,"ي",1,0],["وإنّ إفَنتَ الرّومِ يجهَدُ كلّما","أراهُ المقامُ اليوسُفِيُّ جِهادَهُ",62,"د",2,0],["وأنا في الحب صديان وما","لفؤادي في الهوى مصطبر",63,"ر",1,0],["وأنّا في زمانٍ هان فيه","خروج العاشقين عن الصوابِ",64,"ب",1,0],["وإن أفضل قرنٍ للذين رأوا","نبينا وبهم دين الهدى نصرا",65,"ر",2,0],["وأنا في الدجى حليف سهادٍ","واشتياق والنوم ليس ببالي",66,"ل",2,0],["وَأَنا فارِيسَ أَدعُو لِلِّقا","عَلَّهُ يَسمَعُ نُصحاً صَدَقا",67,"ق",2,0],["وإن أفرحت يوماً يأوب سرورها","شروراً بتصحيفٍ بتثليث نقطةِ",68,"ه",1,0],["وإن أفضل خلق الله سيدنا","محمد المصطفى المختار من مضر",69,"ر",1,0],["وأنافت على الشموس منارا","نوره في جفونها مذرور",70,"ر",1,0],["وإنا فقدنا الآن من كان سيداً","وكانت له في العالمين منافع",71,"ع",1,0],["وأنا فتى حُرُّ الفؤاد طليقُهُ","لو كان قلبي من هواك طليقا",72,"ق",2,0],["وأنا فَتَى لي في القريضِ سجيّةٌ","خالفتُ فيها البحترٍيْ وجَريرا",73,"ر",2,0],["وأنا في غياهب الليل أعدو","في دروب الضياع والتشريدِ",74,"د",1,0],["وأَنا فؤادٌ فارغٌ شَهَقَت","مِنهُ اليَدَانِ لِخَيرِ مَملوءِ",75,"و",2,0],["وإنَّا فَتَحنا لِ(صنعاءَ) بابًا","جَديدًا, ولكنْ إلى (قَندَهارْ)",76,"ر",1,0],["وانا في النور راح ابقى رموز الود معموره","اعيش الوقت ما آبه سوى بأحلام تِصفالي",77,"ل",2,0],["وان افلس من اللفو جات المشاري","فك العلومه تمسي وتصبح اتسير",78,"ر",1,0],["وانا فدى عينك فدى مدمعها","جمرن شرر احرق هكا لل لثامي",79,"م",2,0],["وانا فطين وقادر ألعب بحبلين","واعطي فؤادي مانقص من حنانه",80,"ن",2,0],["وأن أفوحَ هنا أو ها هناكَ صدىً","كأوَّل ِ الغيثِ آتٍ مِنْ حكاياكا",81,"ك",2,0],["وأنا فتاة القيروان وبكرها","وخريدةُ الأوطان... هل من فنّدا ؟",82,"د",2,0],["وإن أفادتك أخطاء إِذِ اقْتُرِفَت","وأرهق الفكرَ ما أسلفت من زلل",83,"ل",1,0],["وانا فاللي ورثته ورث لا بايع ولاشراي","ومثلي فالوصايه مايبي له هرج ووصايه",84,"ا",3,0],["وأَنا فِيهِ امْتِدادُُمِنْ جِرا","حٍ، ومِنْ خَطْوٍ ذَلِيلِ الإتّزان",85,"ن",1,0],["وأنا في بحرها .. أبحر","وموج البحر يازوفه",86,"ف",2,0],["وانا في دنيتي مابغا عمارات وغناء وقصور","لان ماحد بيبعث في وسط جيبه ريالاته",87,"ت",2,0],["وَإنَّا فِي الْحَضَارَةِ نُورُ فَجْرٍ","عَزِيْمَتُنَا مِنَ الْقُرْآنِ وُثْقَى",88,"ق",2,0],["وَأَنَا فُؤَادِي بِالْمَشَاعِرِ غَارِقٌ","وَكَأنَّ مَا فِي عُمْقِ رُوحِيَ قِرْشُ",89,"ش",1,0],["وأنا في خفوقي فاتح له منافيسه","هواجيس خلق الله هجوسي تريسها",90,"س",3,0],["وأنافس الملأين في ختم الرضا","كالمسك بين خمائل الأزهار",91,"ر",1,0],["وأنا فيك قصيدي ملؤُهُ","شوقُ وصلٍ لو بنا الوصلُ اتَّصلْ",92,"ل",1,0],["وإنا في انتفاضاتِ البواغي","لنا سلمٌ وللباغينَ حربُ",93,"ب",1,0],["وإنْ أفصحتْ عن مداهُ العيونُ","فليسَ لهُ أحرفٌ نافيه !!",94,"ف",3,0],["وأنا في عالم ٍ أزعَجْتُهُ","ببُكائي ورواياتِ الضَّجَرْ",95,"ر",1,0],["وأنا في المحراب ارجوه ربي","أن تخرّ النجوم لوما اتقيتُ",96,"ت",1,0],["وانا فاالبحر مبحر وتجري سفينتي","والافلاك ليل ابليل في ليل غايبه",97,"ب",2,0],["وَأَنَا فِي الْمَقْعَدِ أَرْمُقُهُ","كَيْ تَصْفَحَ عَنِّي مُقْلَتُهُ",98,"ت",2,0],["وأنا في صمْتي إذِ اعْترضتْني","ناطحاتٌ فوق السحاب ِارْتفاعا ...",99,"ع",2,0],["وانا فيك لا اخالف ظني","حيث سقْت الفؤاد طفلاً بليدا",100,"د",2,0],["وأنا في قيد ذنبي","لا أراني مستقيما",101,"م",2,0],["وانا في الجزائر خير شعب","عروبته مدى الاجيال وثقى",102,"ق",2,0],["وانا في وسط همي زارني ضحكٍ بلا عنوان","يداري خاطري المغبون يمحي قصه مكتوبه",103,"ب",2,0],["وانا فيك لافكرت فالشعر والاوزان","تفتق درابيل الخيالات بالمره",104,"ر",2,0],["وانا فاصل الريوس معاها على قدام","تعلمت منها الحب والورد والكبليه",105,"ي",2,0],["وأنا فبعض الكلام احسب كأنك يا الغلا ندمان","ولا ظنيت أبد في يوم ، تبيع ورود ذبلانه",106,"ن",2,0],["وأنا في زاويتي ظلٌ","يرقبُه يقرأ أخبارَهْ",107,"ر",2,0],["وَ أَنا فَتَىً ؛ بَينِي وَ بَينِي خافِقٌ","يَذوِي إِذا - مَعْ بَينِ بَينَيِّ - التَقَى",108,"ق",2,0],["وإنْ أفلتَ القلبُ من مُقلتيها","أصابْتهُ من أسهُم الأقحوان ِ",109,"ن",1,0],["وانا في داخلي جرحٍ كبير وكنّه البركان","وطابور الجروح يثور كلاً ينتظر دوره",110,"ر",2,0],["وأنا فوقها هلالٌ وشمسٌ","وغروبٌ عن وجهها وشروق",111,"ق",1,0],["وأنا فوقهم ألوبُ بجرحي","من يُجاري بما يدور المدارا",112,"ر",2,0],["وأنا في دمي أُغني لقومي","حافِظاً للزمان ما ليس ينسى",113,"س",2,0],["وإنّا في العقيدة قد غُرسنا","كما غُرستْ بطيبتنا النخيلُ",114,"ل",1,0],["وأنا فيكِ مَركبٌ وسْطَ بحْر","أتهَادى ومَا لدَيَّ دليلُ",115,"ل",1,0],["وأنا فصلٌ خامسٌ أين أمضي!","كيف تأتي في بعضهنَّ الفصول؟",116,"ل",1,0]]}