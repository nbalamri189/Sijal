/diwan/poem/205704","الهزج"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131232",""],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58098","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72433","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76706","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4858,"حبائلُ الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=35576",""],[5127,"عشقتُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=177306",""],[5213,"إذا ما جئت قبر أبي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=170401",""],[5338,"في رثاء محمد مهدي الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=187640",""],[3294,"أساءت لي المرآة صنعا وأذنبت","https://www.poetsgate.com/ViewPoem.aspx?id=173255",""],[470,"اللامبالاة","https://www.poetsgate.com/ViewPoem.aspx?id=178019",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5622,"مليون يتم","https://www.poetsgate.com/ViewPoem.aspx?id=210323",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5953,"يا مسبت السبت ومجمع الجمعة","https://www.poetsgate.com/ViewPoem.aspx?id=93832",""],[5956,"انسجام مع الفتون","https://www.poetsgate.com/ViewPoem.aspx?id=192080",""],[6102,"هاتِف","https://www.poetsgate.com/ViewPoem.aspx?id=185295",""],[5355,"أما آن الرجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87208&r=&rc=33",""],[463,"هبْ من زمانكَ بعضَ الجدّ للعبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59955&r=&rc=11",""]],"verses":[["تُريني الشَمسَ أَوَّلَ مَن يَراها","وَآخِرُ شَأوِها طَلَقُ الظَليمِ",0,"م",1,0],["تُريني الدَلَّ عَمداً وَهوَ فَركٌ","وَهَيهاتَ الفُروكُ مِنَ المُدِلِّ",1,"ل",1,0],["تُرينا في جِباهِ الأُسدِ ذُلّاً","وَفي حَدَقِ الأَراقِمِ كَالفُتورِ",2,"ر",1,0],["تُرى نُوَبُ الأَيّامِ تُرجي صِعابَها","وَتَسأَلُ عَن ذي لِمَّةٍ ما أَشابَها",3,"ب",3,1],["تَرى نِصفَها نِصفاً قَناةً قَويمَةً","وَنِصفاً نَقاً يَرتَجُّ أَو يَتَمَرمَرُ",4,"ر",1,0],["تَرى نَصرَ الإِمامِ عَلَيكَ حَقّاً","إِذا لَبَسوا بِدينِهِمِ اِرتِيابا",5,"ب",2,0],["تَرى نَفسَ المُنافِقِ في حَشاهُ","تُعارِضُ كُلَّ جائِفَةٍ عَنودِ",6,"د",1,0],["تَرى نَبلَ الرُماةِ تَطيشُ عَنها","وَإِن أَخَذَ الرُماةُ لَها سِهاما",7,"م",2,0],["ترى نَائلاً من نَائلٍ ثم ينتهي","إلى صَاعِدٍ إسنادُه حين يُسْنَدُ",8,"د",1,0],["تَرى نورَ العَقيدَةِ في ثَراهُ","وَتَنشَقُ في جَوانِبِهِ الخِلالا",9,"ل",2,0],["تُرينا صَناعُ الرومِ فيها مُلوكَها","وَتَجلو عَلَينا نَفسَها وَقِيانَها",10,"ن",3,0],["تُرينيكَ أَحلامُ النِيامُ وَبَينَنا","مَفاوِزُ يَستَفرِغنَ جُهدَ الرَكائِبِ",11,"ب",1,0],["ترينيَ الهاجر الشتيت","وقربه ليس لي ببال",12,"ل",1,0],["ترى نَضْرَةَ الحُسْنِ في خَدّها","تَمَيّعُ ماءً وتُذْكى ضِرَاما",13,"م",2,0],["ترى نرجسَ الأجفانِ منه كلاثمٍ","يشير إلى ما في أقاحِ المباسمِ",14,"م",1,0],["ترَى نجيعَ الزقّ منهُ راشحاً","كأنّهُ من وَدَجِ اللّيلِ رَشَح",15,"ح",1,0],["ترينَ ماذا فيَّ قالتْ أرى","أَنْ يخرجَ الميْتُ منَ الحيِّ",16,"ي",1,0],["تَرَيْنَ ماذا فيَّ قالت أرى","ما يخرجُ الميْتُ من الحيِّ",17,"ي",1,0],["تَرى نَظائِرَها يَخضَعنَ هَيبَتَها","فَقَد ثَمِلتُ لِما أَجلَلنَها تيها",18,"ي",3,0],["تُريني آيَةَ الإِعراضِ مِنها","وَفَظَّت في المَقالَةِ بَعدَ لينِ",19,"ن",1,0],["تريني الظلم عذلا","والظلم ليس بعدل",20,"ل",1,0],["تُرينا الوُدَّ وَهيَ بِنا","إِلى الآفاتِ تَندَرِجُ",21,"ج",1,0],["ترينني كهلا وفي داخلي","من التصابي صبية أربعة",22,"ع",2,0],["تُرينا صَناعُ الرومِ فينا مُلوكَها","وَتَجلو عَلَينا نَقْشها وَقِيانَها",23,"ن",3,0],["تُرى نُزهَةَ الأَبصارِ وَهيَ مَواكِبٌ","وَهادِمَةَ الأَعمارِ وَهيَ مَقانِبُ",24,"ب",1,0],["تريني الأماني بارقات بلا حيا","وأقطعُ أيّامي وأنتظر الدهرا",25,"ر",2,0],["ترى نِعماً مثمراتِ الغصونْ","إذا قَولةٌ في النَّدَى قالها",26,"ل",3,0],["تُريني البُطَينَ وَلَكِنَّني","أُقارِضُها فَأُريها الزُبانا",27,"ن",2,0],["تَريني غَداةَ البَذلِ أَهتَزُّ للنَدى","كَما جَرَّدَ السَيفَ اليَمانيَّ صيقَلُ",28,"ل",1,0],["ترينا لواحظه الفاتكات","كيف تصيد الأسود الظبا",29,"ب",2,0],["تُريني الأُفقَ يطلعُ من قناعٍ","وتخفي الأرضَ في درعٍ ومرط",30,"ط",1,0],["تريني الحسنَ أجمَعَ في محيَّاً","طلاقَتُهُ كأنوارِ الصباح",31,"ح",1,0],["ترينَ الهمَّةَ الشماءَ فيه","إذا طلعَ الكِرامُ مُجاهِدينا",32,"ن",2,0],["تَرى نُكَتَ الأَزْهارِ فِيه كأَنَّها","كَواكِبُ فِي أُفْقٍ تُنِيرُ وتُسْرَجُ",33,"ج",1,0],["تُرِيني وُجُوهاً لَمْ تَنلْهَا مَعَاوِلي","فَقَدْتُ وُجُوهاً أَسْتَلِينُ بِها الصَّخْرا",34,"ر",2,0],["تُرى نارُهُم لِحَريقِ القُلوبِ","فَقَد أَوقَدوها وَلَم يَصطَلوا",35,"ل",3,0],["ترينا الشمس في الآفاق نوراً","ويَحجبُه غَمامٌ فاختيُّ",36,"ي",1,0],["تُرينَ أخا الوجد لينَ الكلام","فيطمعُ منك بأمر محال",37,"ل",1,0],["ترى نفثات السّحر في كلماته","وتجني بأيدي السَّمع من لفظه شهدا",38,"د",2,0],["تريني لدى علياك ما قد يسرُّني","وترفع قدري فيك يا رفعت القدر",39,"ر",1,0],["ترى نطقه فصلا وروتبه منى","ومجلسه فضلا وشيمته عفوا",40,"و",2,0],["ترينا جبين الشمس من شرب وجهها","كما أنه يبدو على مرطها الغرب",41,"ب",1,0],["تُرَى ندامايَ ما بين الرُّصافةِ فال","بَيْضاءِ راوِين من خمرٍ ومن طربِ",42,"ب",1,0],["تُرِينا الشِّيحَ والْقَيْصُو","مَ والْيَرْبُوعَ والأَلَّهْ",43,"ل",2,0],["تَرَيْنَ منِّي وضوءُ الشيب يفضحني","ما زاغ عنه ورأْسي أسودُ البصرُ",44,"ر",1,0],["تُرينا الجمرَ في خدٍّ أسيلٍ","ومن لَحظاتها تُسبَى الجِمارُ",45,"ر",1,0],["تَرى نارَ القِرَى في الحيِّ تَعلُو","ونِيرانُ الهَوَى أعلَى وأغلَى",46,"ل",2,0],["تَرَى نَكِراتِ الحَيِّ أخبَثَ مَطعَمٍ","إليهِ فَما يَعتامُ غَيرَ المَعارِف",47,"ف",1,0],["ترى نجوماً لدى الأفاق سائرةً","غير التي عهدت بالسبعة الشهب",48,"ب",1,0],["ترى نورها من كُلّ بابٍ كأنّما","سنا الشمس من أبوابها يتقطعُ",49,"ع",1,0],["ترى نرجسةً ترنو","إلى نحوِ أختها شَزْرا",50,"ر",2,0],["تُريني بالرِضا والسخ","طِ جنّات ونيرانا",51,"ن",2,0],["تَرى نَبذَ الرَمادِ بِوَجنَتَيهِ","كَكافورٍ يُذَرُّ عَلى خَلوقِ",52,"ق",1,0],["ترى نبهت أجفانا سُكارى","صحون وذا فؤادي غير صاحِ",53,"ح",1,0],["ترى نعماً نالوا مراكب فضة","مراكب جهل تحتهن مراكب