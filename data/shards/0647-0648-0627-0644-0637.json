{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[53,"ألا يا أيها الشاكر والمطنب في المدح","https://www.aldiwan.net/poem9411.html","الهزج"],[53,"بدا الشيب في رأسي فجلى عمايتي","https://www.aldiwan.net/poem9435.html","الطويل"],[53,"إلهي أجرني من شنيف وزيرك","https://www.aldiwan.net/poem64922.html","الطويل"],[40,"هو الطرف لم تحشش مطي بمثله","https://www.aldiwan.net/poem7854.html","الطويل"],[64,"إليك أسري فلا تسبق بمكرمة","https://www.aldiwan.net/poem52366.html","البسيط"],[30,"وقائلة لي لم تصبني سهامها","https://www.aldiwan.net/poem5422.html","الطويل"],[82,"بلى جر أذيال الصبا فتصابى","https://www.aldiwan.net/poem31242.html","الطويل"],[108,"نذير الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179329",""],[101,"أفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=17704",""],[164,"عدوك مما عنك يسمع يا يحيى","https://www.aldiwan.net/poem58856.html","الطويل"],[164,"خذ الملك يا يحيى إليك بقوة","https://www.aldiwan.net/poem58881.html","الطويل"],[170,"عجبت لطيفها أنى تصدى","https://www.aldiwan.net/poem47096.html","الوافر"],[173,"بنانك من مغدودق المزن أهطل","https://www.aldiwan.net/poem1659.html",""],[173,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[215,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[255,"به ذلك الثغر المبارك لم يزل","https://www.aldiwan.net/poem15015.html","الطويل"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[412,"أتلك حدوج أم نجوم سوائر","https://www.aldiwan.net/poem50170.html","الطويل"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[466,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[466,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[466,"هو الطود المنيف وكل خطب","https://www.aldiwan.net/poem16431.html","الوافر"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[543,"هو الطيب الأخلاق والإسم والذكر","https://www.aldiwan.net/poem48174.html","عموديه"],[563,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126823","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110383","البسيط"],[713,"","https://poetry.dctabudhabi.ae/diwan/poem/104863","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87079","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65958","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200061","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74207","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126257","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67971","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126958","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86309","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132101","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117986","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117977","الوافر"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131230",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94408","الوافر"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5281,"تُسيئون للطُّهرِ!","https://www.poetsgate.com/ViewPoem.aspx?id=199660",""],[5512,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=204242",""],[5701,"عجبت لصورة فيها سعود","https://www.poetsgate.com/ViewPoem.aspx?id=164677",""],[6259,"أتلك حُدوجٌ أم نجوم سوائرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59384&r=&rc=32",""]],"verses":[["هُوَ الطَعنُ يَفتَرُّ مِنهُ الجَوادُ","وَلَو كانَ ذا مَرَحٍ لَاِبتَسَم",0,"م",1,0],["هوَ الطّيفُ تُهديهِ إِلى الصَّبِّ أشجانُ","ولَيسَ لسِرٍّ فيكَ يا لَيلُ كِتْمانُ",1,"ن",1,1],["هو الطَّوْدُ الذي أضحى","عَتَادَ النَّاس للبرْحِ",2,"ح",1,0],["هو الطِّرْفُ أجرتْه الملوك ومسَّحت","قديماً له وجهاً أغرَّ مُشَمْرَخَا",3,"خ",2,0],["هو الطَّاهر ابن الطَّاهرين الألى مَضَوْا","ولم يَلْبَسوا عرضاً مُذالاً مُطَيَّخا",3,"خ",2,0],["هو الطاحنُ الأزْوادَ في كل حالةٍ","من الدهر والوثَّابُ عنها إلى الحش",4,"ش",1,0],["هُوَ الطِرفُ لَم تُحشَش مَطِيٌّ بِمِثلِهِ","وَلا أَنَسٌ مُستَوبِدُ الدارِ خائِفُ",5,"ف",1,1],["هو الطريدةُ قد جاءتْكَ مُكتبةٌ","لكنها بحبالِ المجدِ تُقْتَنَصُ",6,"ص",1,0],["هُوَ الطاعِنُ النَجلاءَ تَهدِرُ فَرغُها","مِنَ العَلَقِ المُروي السِنانِ اِنبِلالُها",7,"ل",3,0],["هو الطِّرفُ فاركبْ منه في ظهرِ طائرٍ","تَنَلْ كلّ ما أعيا عليكَ طلابا",8,"ب",2,0],["هو الطب: أما في الجِرَاح؛ فَمَا رِدٌ","وأمَّا أمام الشَّيْب؛ فَهْو قمِيءُ",9,"ي",2,0],["هو الطينُ ليس لطينٍ بقاءٌ","ولذَّاتُهُ وَمْضةٌ زائلَهْ",10,"ل",2,0],["هو الطاهر ابن الأشرف الملك الذي","إذا فاض جودا والحيا قد هما استحيا",11,"ي",2,0],["هو الطاهر بن الأشرف الملك الذي","نمته الملوك الغر من آل جفنة",12,"ه",1,0],["هو الطاووسُ زيّاً واختيالاً","ولكنْ كالقَطا ليلاً تَهَدّى",13,"د",2,0],["هُوَ الطَودُ حِلماً وَالمُهَنَّدُ عَزمَةً","هُوَ البَحرُ جُوداً بَل عَطاياهُ أَجزَلُ",14,"ل",1,0],["هُوَ الطاهِرُ الأَخلاقِ لا دِينُهُ رِيا","وَلا مَجدُهُ دَعوى وَلا جُودُه لَفا",15,"ف",2,0],["هو الطوفان يرمى الناس رمياً","فلا نومٌ هناك ولا هبوب",16,"ب",1,0],["هو الطود عنه السيلُ زل بنطقه","ولا غَروَ في سيلٍ إذا جاء من عَلِ",17,"ل",1,0],["هُوَ الطيب ابن الطيبين وَعمدتي","عليه وَظبي فيه لَيسَ يخيب",18,"ب",1,0],["هو الطَّودُ حِلْماً ولكنْ تَرى","لنارِ الحفيظةِ فيه كُمونا",19,"ن",2,0],["هو الطَّودُ ما حَمَّلْتَه فهْو حامِلٌ","إذا العَوْدُ لم يَجْشَمْ سِوى الوُسْعِ مَجْشَما",20,"م",2,0],["هوَ الطاعِن النَجلاء لا يبلغ أَمر","مَداها وَلَو أَنَّ الرِماح مُسابِرُ",21,"ر",1,0],["هو الطِّرْفُ غرَّتْ رِحلتي خطواتُهُ","وزُمَّتْ فكان الليثَ صعباَ ركوبُهُ",22,"ب",2,0],["هو الطَّودِ اِن أحفظته كان راسياً","رزيناً واِنْ طاولْتَه كان ساميا",23,"ي",2,0],["هو الطَّوْدُ في النادي وقاراً وهيبةًذ","وفوق مُتون الجُرد ليثٌ وأجْدلُ",24,"ل",1,0],["هو الطَّوْدُ المُنيف وكلُّ خطْبٍ","يَروعُ سِواهُ ريحٌ بلْ نَسيمُ",25,"م",1,1],["هو الطود أعجز أن يزعجوهُ بأ","ن قعقعوا في ذراهُ بشنِ",26,"ن",1,0],["هو الطِّيِّبُ الأخلاقِ والإسمِ والذِّكرِ","أزُفُّ له ذَوبَ العَواطفِ في الشِّعرِ",27,"ر",1,1],["هو الطير الذي غنى","بلحن فوق أعواد",28,"د",1,0],["هو الطَّاهر الظاهرُ المْكرُما","تِ والأَروعُ العالِمُ الْعامِلُ",29,"ل",1,0],["هو الطبيبُ الذي ترجو البلادُ به","فوزاً وذاك لعمري خير تمثالِ",30,"ل",1,0],["هو الطيبُ الذي أحيت عنايتهُ","لنا الخليلَ الذي بالبُرءِ قد طفرا",31,"ر",2,0],["هو الطود حلماً والنسيم خلائقاً","هو البحر علماً ليس يلفى له شط",32,"ط",1,0],["هُوَ الطاهر البرّ الرؤف محمد","مجير الرَعايا مِن تجبّر غاشم",33,"م",1,0],["هو الطاهر البادي هو الباطن الذي","أبان لنا ما كان عنا مكتما",34,"م",2,0],["هو الطود إن أرسى هو النجم إن سرى","هو السبيل إن أجري هو البحر إن طما",34,"م",2,0],["هو الطيب الطب الرضي الطاهر الذي","يجلي دجاها أيها المتخير",35,"ر",1,0],["هو الطفل والأطفال تهوى اقترابه","أخٌ لهم لكن له سنّ أجداد",36,"د",1,0],["هو الطيف يدنو لستَ تسطيع مسكه","هو السر في قلب الدنا مختفٍ باد",36,"د",1,0],["هُوَ الطف فاجعل فضة الدَمع عسجدا","وَصغ لَكَ فُولاذ الغَرام مُهندا",37,"د",2,1],["هو الطود في الأفضال شيخى الذى له","محامد مجد طاب في نشرها الذكر",38,"ر",1,0],["هو الطود فاشدُد ساعِديْك بحبلِه","فقد خاب من كَانَ المليك يُجانبه",39,"ب",2,0],["هو الطب كان لداء النفوس","وإن فسد الدهر كان الصلاحا",40,"ح",2,1],["هو الطائِر المَأمون يَنحو بِنا الهدى","هو العِلم الهادي الى العز وَالفَخر",41,"ر",1,0],["هُوَ الطود لَولا أَن تدك رَواسخ","فَتهدم أَعلاها فعال الزلازل",42,"ل",1,0],["هو الطفل الذي ظهرت عليه","سماتٌ من ملائكة النعيم",43,"م",1,0],["هو الطود للدنيا وللدين ماع","ينال الأماني من بذروته اعتصم",44,"م",1,0],["هو الطود المنيع المرتقي في","حماه الجار يأمن أن يضاما",45,"م",2,0],["هوَ الطَاعِنُ النَجلاءَ مُنفِذُ نَصلِها","كَمبدَئِها مِنها مُرِشٌّ وَواكِفُ",46,"ف",1,0],["هو الطمع استقل به أناسٌ","حرام الفعل عندهم حلالُ",47,"ل",1,0],["هو الطيبُ الذي سرى طيبُ علمهِ","بغربٍ وشرقٍ عرفُهُ يتنسَّمُ",48,"م",1,0],["هو الطبيب الذى لاداء داخل من","به استطب بصدق لاباشراك",49,"ك",1,0],["هو الطيب ابن الطيبين وهكذا","سريرة سر الأصل في فرعها تسري",50,"ر",2,0],["هو الطودُ الأشم على الرواسي","فلا يَرتاع من كرّ الدهورِ",51,"ر",1,0],["هو الطهر أزكى الخلق نفساً نفيسة","وأكرمهم فرعاً وأشرفهم جسما",52,"م",2,0],["هُوَ الطُّهرُ والنُّورُ خَيرُ البَشَرْ","وَبِالحَقِّ وَالعَدلِ فِينَا أَمَرْ",53,"ا",3,0],["هوَ الطبيبُ هوَ التِّرياقُ نرشفهُ","بلا الدَّواءِ صميمُ القلبِ محمومُ",54,"م",1,0],["هو الطود الأشم سما ولاحت","عليه من الأزاهر زهرتان",55,"ن",1,0],["هو الطاعن النجلاء لا يبلغ امرؤٌ","مداها ولو أن الرماح مسابر",56,"ر",1,0]]}