6,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5150,"سناء","https://www.poetsgate.com/ViewPoem.aspx?id=202796",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5186,"إن في مشهد الطبيعة حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=156503",""],[5225,"يا نسناسْ الهبايبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27611",""],[5277,"ربيعُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=212980",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5638,"كاميليا والخائنون","https://www.poetsgate.com/ViewPoem.aspx?id=198249",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5829,"من نجيع المحبرة","https://www.poetsgate.com/ViewPoem.aspx?id=180636",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["وَمَفازَةٍ تَلِدُ الهَجيرَ خَرَقتُها","وَالأَرضُ مِن لَمعِ السَرابِ بُروقُ",0,"ق",1,0],["وَمُفِيقِينَ مِنَ اللَّهْ","وِ نَشاوَى مِنْ مِراحِ",1,"ح",1,1],["ومُفاضَةً زَغْفاً تضاعَفَ نَسْجُها","خَلْقاءَ قدَّرَ نَسْجَها داوُودُهُ",2,"د",2,0],["ومفصحٌ حين يروى الصاد من كرمٍ","فللمحاسن ترتيبٌ وترتيل",3,"ل",1,0],["ومفرد الحسن تعشقته","فكانَ حتَّى مفرد العين",4,"ن",1,1],["ومفاتيحُ للخصوص وكانت","بالمفاتيح تُفتح الأبوابُ",5,"ب",1,0],["وَمُفرِهَةٍ عَنسٍ قَدَرتُ لِرِجلِها","فَخَرَّت كَما تَتّابَعُ الريحُ بِالقَفلِ",6,"ل",1,0],["وَمُفيدُهُ نَصري وَإِن كانَ اِمرَأً","مُتَزَحزِحاً في أَرضِهِ وَسَمائِهِ",7,"ا",3,0],["وَمَفاتيحُها مَقاليدُ مُلكٍ","باعَها الوارِثُ المُضيعُ بِبَخسِ",8,"س",1,0],["ومفردٍ بالحُسْنِ أفردْتُهُ","بالحُبِّ لمَّا قَلَّ عُشَّاقُه",9,"ق",2,1],["ومُفتَقَر الدنيا إِلى رأيهِ الذي","يُرَدُّ إليه في الأمورِ المقالدُ",10,"د",1,0],["وَمُفاكِهٍ عَبِقُ الكَلامِ كَأَنَّما","يُفضي إِلَيكَ بِلَفظِ فيهِ النَرجِسُ",11,"س",1,0],["ومفيد آداب ومؤنس وحشة","وإذا انفردت فصاحب وسمير",12,"ر",1,0],["ومفاضل الأعداء يغرس نبله","بحدائق الوجنات والأحداق",13,"ق",1,0],["ومُفَهَّهَيْنِ تعرَّضا لِحرابَتي","فتعرَّضَتْ لهما صدورُ حِرابي",14,"ب",2,0],["وَمُفاضَةٍ كَالنَهيِ تَنسُجُهُ الصَبا","بَيضاءَ كَفَّت فَضلَها بِمُهَنَّدِ",15,"د",1,0],["وَمُفَرِّجَ الكُرَبِ الَّتي لَو صافَحَت","شُمَّ الجِبالِ لزَلزَلَت هَضباتِها",16,"ت",3,0],["وَمُفَنِّدٍ لَوّامَةٍ نَهنَهتُهُ","عَن مُغلِطٍ لِعَذولِهِ نَجّاهِ",17,"ه",1,0],["وَمَفاوِزُ الآمالِ يَبعُدُ شَأوُها","إِن لَم تَكُن جَدواكَ فيها زادي",18,"د",2,0],["وَمَفيضَ عَبرَتِها وَمَومى كَفِّها","وَرِداءُ عَصبٍ بَينَنا مَنشورُ",19,"ر",1,0],["وَمَفازَةٍ لانَجمُ في ظَلمائِها","يَسري وَلا فَلَكٌ بِها دَوّارُ",20,"ر",1,1],["وَمَفروشَةِ الخَدَّينِ وَرداً مُضَرَّجاً","إِذا جَمَشَتهُ العَينُ عادَ بَنَفسَجا",21,"ج",2,1],["ومُفاضَةٌ مسرودةٌ وكتيبةٌ","مَلمومَةٌ وعَجاجَةٌ شهباء",22,"ا",2,0],["وَمُفنٍ في طِلابِ المُر","دِ وَالخَمرِ مَعاً وَفري",23,"ر",2,0],["وَمُفتَصَلاً عَن ثَديِ أُمٍّ تُحبُّهُ","عَزِيزٌ عَلَيها أَن يُفارِقنَ مُفتَلى",24,"ل",2,0],["وَمَفجوعة أَودى أَخوها بعسفهم","ووالدة قد بانَ عنها وَحيدها",25,"د",3,0],["ومفتيها الأمينُ ومفتديها","وراءَ تخومها يشكو هيامهْ",26,"م",2,0],["ومفجر الفكر والاختراع","ومستقى اللهاة واليراع",27,"ع",1,0],["ومفاضة زغبا تضاعف نسجها","حلقاء قدر نسجها داوده",28,"د",2,0],["ومُفوَّهٍ كالفحل عند هديره","فَذِّ البيان يفيضُ من يُنبوع",29,"ع",1,0],["ومُفَرِّقين مذاهباً جُمِعَت","وحَنَا عليها الآيُ والذِكر",30,"ر",1,0],["ومفّرِقينَ مَذاهباً وعناصراً","مُتَكَفِّلينَ سياسةَ استعمار",31,"ر",1,0],["ومُفترِشاتٌ فضلةً في زرائبٍ","يُوَسّدُها ما حولَها مِن رَكائم",32,"م",1,0],["ومفرشة الخدين ورداُ مضرجا","إذا جَمَشَتْهُ الْعَيْنُ عاد بَنَفْسجَا",33,"ج",2,1],["ومُفاكِهٍ عبِقُ الكَلامِ كأّنَّما","يفضِي إِليكَ بِلفْظِ فيهِ تُقْبسُ",34,"س",1,0],["ومفردات الحسن فيه اجتمعت","باهرة سبحان من سواه",35,"ا",2,0],["ومفاخر تتلى فيروى نصها","عن باقر الاسرار والسجاد",36,"د",1,0],["ومفتاح القبول بلا نزاع","وعين الأنبيا حامي الدخيل",37,"ل",1,0],["وَمُفرِهَةِ تامِكٍ نَيُّها","إِذا ما تُساقُ تَزينُ العِشارا",38,"ر",2,0],["ومفاخرٌ مشهودةٌ يَقضِى لها","يومَ النفار سواجِعُ الكُهّانِ",39,"ن",1,0],["وَمُفرِدُكُم لِلا سَبَبٍ بِشُكرٍ","تَعالَمَهُ المُعادي وَالمُوالي",40,"ل",2,0],["وَمُفرَدَةٍ وَما وَضَعَت حَبيباً","كَما اِنفَرَدَت عَنِ السِربِ الخَواذِل",41,"ل",1,0],["وَمُفَلِّقُ الهاماتِ في ضَنكِ الوَغى","بِمُذَلَّقِ الحَدَّينِ صافي الجَوهَرِ",42,"ر",1,0],["ومفكر في الموت ما","هو قد جفاه له وساده",43,"د",2,0],["ومِفتانٍ قتولِ الدلِّ وَسْنَى","يجاذبُ خَصْرَها رِدْفٌُ رَدَاح",44,"ح",1,1],["ومفجوع على الاحباب باك","اضر به سقام واكتئاب",45,"ب",1,0],["وَمَفاخِرُ الآباءِ زِدتَ جَمالَها","كَالرَوضِ حيّاه الرَبيعُ فَنَوَّرا",46,"ر",2,0],["ومفاوضاتٌ جُلُّ مقصدهِم بها","فُرَصٌ تصيع ووقتهن يطول",47,"ل",1,0],["وَمُفتَرَّةٍ عَن كَالجُمانِ المُنَظَّمِ","مُسَلَّمَةً أَحسِن بِها مِن مُسَلِّمِ",48,"م",1,1],["ومفردٌ إن ألفٌ عوضت","أولاه يرجع بعد ذا ألفا",49,"ف",2,0],["ومفزعي وملاذي في الملمات","ضاقت بما حال حالاتي وأوقاتي",50,"ي",1,0],["وَمَفادُ الإِجراآتِ مُنصَرِفٌ إِلى","ما كانَ مِن شَكلٍ وَمِن أَركانِ",51,"ن",1,0],["وَمُفَوِّضٌ وَالجَبرُ غَيرَ مُجاحِدٍ","عِندي لِأَنَّ عَيانَهُ لا يُجحَدُ",52,"د",1,0],["وَمُفصِحاً بِنَعَم فِي كُلِّ مَسأَلَةٍ","إلا لِمَن لامَهُ فِي الجُودِ أَو عَتَبا",53,"ب",2,0],["وُمُفاضَةً كالنَّهيِ مُحكَمَةً","مِن صُنعِ داوُدِ أَبي سَلمِ",54,"م",1,0],["وَمُفارِقينَ مَعَ الصَبا","عَزماً فَهَل أَرجو الطُلوعا",55,"ع",2,0],["ومُفتقر له جاهٌ صغيرٌ","وقدرٌ عندَ خالِقهِ كبيرُ",56,"ر",1,0],["ومفسراً لكتاب ربي","من به البلغا تحدا",57,"د",2,0],["وَمفردةٍ تبكِي إذا جَنَّ ليلُها","خُفَاتاً وفي أحشائِها النّارُ واللّذْعُ",58,"ع",1,1],["ومفريَّة الفدافد والفيافي","لها في البيد إجفالُ الظَّليم",59,"م",1,0],["ومفيدٌ أموالَه للبَرايا","وهْو للحمدِ والثّنا يستفيدُ",60,"د",1,0],["ومفسدة لاخلاق","وتجرئة على الحرم",61,"م",1,0],["ومُفاضةُ الأذيالِ يُحسَب متنُها","أدراجَ ماء في الغديرِ منمنَمِ",62,"م",1,0],["ومفجوعين من أبناء سعدٍ","فروع علاً يبكُّون الأصولا",63,"ل",2,0],["ومفضَى الأمانة مني إلى","صفاةٍ من الحفظِ لم تُقرَعِ",64,"ع",1,0],["ومفارِقٍ لي كابن عيسى","غَمَّ أيّامي وأدجَى",65,"ج",2,0],["ومُفرش الناس لطفاً مِن تودُّدهِ","كأنَّ خادمهُ الأقصى مُعاقرهُ",66,"ر",2,0],["ومفاخراً ومآثرا مشهورة","ومنابراًَ تثني عليه علانيه",67,"ي",2,0],["ومُفرَدا حيناً يُبصَرُ","أَخا تَعَدُّدِ وذا لا يُنكَرُ",68,"ر",1,0],["ومَفرِقَ العَليَاء بل","تاجاً لِذاكَ المَفرِقِ",69,"ق",1,0],["ومفردَ الشَّيَمِ والبدرُ الذي","سناؤُه بين البُدور مُكتَمِل",70,"ل",1,0],["ومفقود عزيز الفقد تأتى","منيته ومأمول وليد",71,"د",1,0],["ومفاخرٍ ما شئتَ إن عدّدتَها","فالسّيلُ أطبق لا يعدّ زهامُهُ",72,"م",2,0],["وَمفترشٍ صَهَواتِ الجيادِ","إذا ما جرى لا يخاف العِثارا",73,"ر",2,0],["ومفاوزٌ مِنْ دونهنّ مفاوزٌ","وتهائِمٌ مِنْ فوقهنّ نُجودُ",74,"د",1,0],["ومفتاحُ سرٍّ للحروف ورمزهاَ","وفكّ مُعَمَّى العسرِ ينحلُّ باليسرِ",75,"ر",1,0],["ومفرِّقُ الخيراتِ وهي","الكنزُ لا يَخشى نفادَه",76,"د",2,0],["وَمُفارِقاً مِن لاقِلىً سَبَقَت بِهِ","نيَةُ الفِراقِ مُوَدِّعاً وَمُوَدَّعا",77,"ع",2,0],["ومفرداً معلماً في ضنك ملحمةٍ","بها تعادي عليها الشرك واجتمعا",78,"ع",2,0],["ومفخر وادآش على سواها","بنشر العلم من شتى النواحي",79,"ح",2,0],["ومفتاحه خص بالشرطي","فإن عظم الخطب للبوق أسرع",80,"ع",1,0],["ومفسراً للغرب كيف تملكتْ","في الشرق أهلَ النجدةِ الأشعارُ",81,"ر",1,0],["وَمفازة مجهولة ما أثّرت","فيها الرَواسمُ مسلكاً مَرسوما",82,"م",2,0],["وَمفازة عطشى الفلا مجهولة","جاوزتها بجلالةٍ شملالِ",83,"ل",1,0],["وَمفاكهات في الخلائقِ ترتضى","لكَ من أكيلٍ ماجد وشريبِ",84,"ب",1,0],["وَمفازةٍ قفرِ الفلا مجهولةٍ","بيداء نَفنفها يُواصلُ نَفنفا",85,"ف",2,0],["وَمُفرِجٍ مِن خَدِّهِ وَمُكفِرٍ","وَمُخَلَّقٍ مِن شَعرِهِ وَمُسَلسَلِ",86,"ل",1,0],["وَمُفتَنَةِ الأَلوانِ بيضٌ وُجوهُها","وَنُمرٌ تَراقيها وَصُفرٌ جُنوبُها",87,"ب",3,1],["ومفجرٌ ماء الحياة ولم يكن","من وقعِها الحيوان بالُمتَفَجِّر",88,"ر",1,0],["ومَفزَعها إذا ما هاج هيجٌ","بداهيةٍ خصيم المعضِلات",89,"ت",1,0],["ومفاوز ترك الجسو