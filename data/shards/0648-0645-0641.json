/www.aldiwan.net/poem21816.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[33,"ومفرشة الخدين ورداُ مضرجا","https://www.poetsgate.com/ViewPoem.aspx?id=2592",""],[45,"إنَّ الكُؤُوسَ بها يَطِيبُ المجْلِسُ","https://www.poetsgate.com/ViewPoem.aspx?id=31144",""],[115,"وريم روض لم ادم سواه","https://www.aldiwan.net/poem40435.html","عموديه"],[115,"احيا الطريق ونوبة الصياد","https://www.aldiwan.net/poem41147.html","عموديه"],[115,"نزلت بساح باب الله طه","https://www.aldiwan.net/poem41969.html","الوافر"],[127,"ألا تلك عرسي إذا أمعرت","https://www.aldiwan.net/poem24263.html","المتقارب"],[142,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[143,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[143,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[169,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[186,"حظ الفتى مما أتاه","https://www.aldiwan.net/poem43955.html","مجزوء الكامل"],[198,"ومفتان قتول الدل وسنى","https://www.aldiwan.net/poem51966.html","الوافر"],[210,"مصاب لا يشابهه مصاب","https://www.aldiwan.net/poem13510.html","الوافر"],[225,"بعلاك يختال الزمان تبخترا","https://www.aldiwan.net/poem55221.html","الخفيف"],[239,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[282,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[303,"يا سيدا ألسن أقلامه","https://www.aldiwan.net/poem57732.html","البسيط"],[304,"الشك والوهم رأس الشر والحذر","https://www.aldiwan.net/poem16792.html","البسيط"],[320,"جاز التماس إعادة الأنظار في","https://www.aldiwan.net/poem61665.html","الكامل"],[349,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[357,"أعرى من المدح الطرف الذي ركبا","https://www.aldiwan.net/poem4179.html","البسيط"],[365,"أعددت للحدثان مطردا","https://www.aldiwan.net/poem44479.html","أحذ الكامل"],[366,"لو تأخذون بساعة","https://www.aldiwan.net/poem17885.html","مجزوء الكامل"],[402,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[403,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[409,"ومفردة تبكي إذا جن ليلها","https://www.aldiwan.net/poem32242.html","الطويل"],[416,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[432,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[443,"صراع السيف والقلم","https://www.aldiwan.net/poem55927.html","عموديه"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[461,"يا خيرة الله حلي عند مجتهد","https://www.aldiwan.net/poem15394.html","البسيط"],[463,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[538,"شخص له عجائب لا تحصر","https://www.aldiwan.net/poem47444.html","عموديه"],[538,"يا سيدا في مغرب","https://www.aldiwan.net/poem47550.html","عموديه"],[538,"يا أيها القائد والشهم الذي","https://www.aldiwan.net/poem47990.html","عموديه"],[550,"لقد طوفت في الآفاق حتى","https://www.aldiwan.net/poem1885.html","عموديه"],[551,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[551,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[551,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["وَمَفازَةٍ تَلِدُ الهَجيرَ خَرَقتُها","وَالأَرضُ مِن لَمعِ السَرابِ بُروقُ",0,"ق",1,0],["وَمُفِيقِينَ مِنَ اللَّهْ","وِ نَشاوَى مِنْ مِراحِ",1,"ح",1,1],["ومُفاضَةً زَغْفاً تضاعَفَ نَسْجُها","خَلْقاءَ قدَّرَ نَسْجَها داوُودُهُ",2,"د",2,0],["ومفصحٌ حين يروى الصاد من كرمٍ","فللمحاسن ترتيبٌ وترتيل",3,"ل",1,0],["ومفرد الحسن تعشقته","فكانَ حتَّى مفرد العين",4,"ن",1,1],["ومفاتيحُ للخصوص وكانت","بالمفاتيح تُفتح الأبوابُ",5,"ب",1,0],["وَمُفرِهَةٍ عَنسٍ قَدَرتُ لِرِجلِها","فَخَرَّت كَما تَتّابَعُ الريحُ بِالقَفلِ",6,"ل",1,0],["وَمُفيدُهُ نَصري وَإِن كانَ اِمرَأً","مُتَزَحزِحاً في أَرضِهِ وَسَمائِهِ",7,"ا",3,0],["وَمَفاتيحُها مَقاليدُ مُلكٍ","باعَها الوارِثُ المُضيعُ بِبَخسِ",8,"س",1,0],["ومفردٍ بالحُسْنِ أفردْتُهُ","بالحُبِّ لمَّا قَلَّ عُشَّاقُه",9,"ق",2,1],["ومُفتَقَر الدنيا إِلى رأيهِ الذي","يُرَدُّ إليه في الأمورِ المقالدُ",10,"د",1,0],["وَمُفاكِهٍ عَبِقُ الكَلامِ كَأَنَّما","يُفضي إِلَيكَ بِلَفظِ فيهِ النَرجِسُ",11,"س",1,0],["ومفيد آداب ومؤنس وحشة","وإذا انفردت فصاحب وسمير",12,"ر",1,0],["ومفاضل الأعداء يغرس نبله","بحدائق الوجنات والأحداق",13,"ق",1,0],["ومُفَهَّهَيْنِ تعرَّضا لِحرابَتي","فتعرَّضَتْ لهما صدورُ حِرابي",14,"ب",2,0],["وَمُفاضَةٍ كَالنَهيِ تَنسُجُهُ الصَبا","بَيضاءَ كَفَّت فَضلَها بِمُهَنَّدِ",15,"د",1,0],["وَمُفَرِّجَ الكُرَبِ الَّتي لَو صافَحَت","شُمَّ الجِبالِ لزَلزَلَت هَضباتِها",16,"ت",3,0],["وَمُفَنِّدٍ لَوّامَةٍ نَهنَهتُهُ","عَن مُغلِطٍ لِعَذولِهِ نَجّاهِ",17,"ه",1,0],["وَمَفاوِزُ الآمالِ يَبعُدُ شَأوُها","إِن لَم تَكُن جَدواكَ فيها زادي",18,"ي",1,0],["وَمَفيضَ عَبرَتِها وَمَومى كَفِّها","وَرِداءُ عَصبٍ بَينَنا مَنشورُ",19,"ر",1,0],["وَمَفازَةٍ لانَجمُ في ظَلمائِها","يَسري وَلا فَلَكٌ بِها دَوّارُ",20,"ر",1,1],["وَمَفروشَةِ الخَدَّينِ وَرداً مُضَرَّجاً","إِذا جَمَشَتهُ العَينُ عادَ بَنَفسَجا",21,"ج",2,1],["ومُفاضَةٌ مسرودةٌ وكتيبةٌ","مَلمومَةٌ وعَجاجَةٌ شهباء",22,"ا",2,0],["وَمُفنٍ في طِلابِ المُر","دِ وَالخَمرِ مَعاً وَفري",23,"ر",2,0],["وَمُفتَصَلاً عَن ثَديِ أُمٍّ تُحبُّهُ","عَزِيزٌ عَلَيها أَن يُفارِقنَ مُفتَلى",24,"ل",2,0],["وَمَفجوعة أَودى أَخوها بعسفهم","ووالدة قد بانَ عنها وَحيدها",25,"د",3,0],["ومفتيها الأمينُ ومفتديها","وراءَ تخومها يشكو هيامهْ",26,"م",2,0],["ومفجر الفكر والاختراع","ومستقى اللهاة واليراع",27,"ع",1,0],["ومفاضة زغبا تضاعف نسجها","حلقاء قدر نسجها داوده",28,"د",2,0],["ومُفوَّهٍ كالفحل عند هديره","فَذِّ البيان يفيضُ من يُنبوع",29,"ع",1,0],["ومُفَرِّقين مذاهباً جُمِعَت","وحَنَا عليها الآيُ والذِكر",30,"ر",1,0],["ومفّرِقينَ مَذاهباً وعناصراً","مُتَكَفِّلينَ سياسةَ استعمار",31,"ر",1,0],["ومُفترِشاتٌ فضلةً في زرائبٍ","يُوَسّدُها ما حولَها مِن رَكائم",32,"م",1,0],["ومفرشة الخدين ورداُ مضرجا","إذا جَمَشَتْهُ الْعَيْنُ عاد بَنَفْسجَا",33,"ج",2,1],["ومُفاكِهٍ عبِقُ الكَلامِ كأّنَّما","يفضِي إِليكَ بِلفْظِ فيهِ تُقْبسُ",34,"س",1,0],["ومفردات الحسن فيه اجتمعت","باهرة سبحان من سواه",35,"ا",2,0],["ومفاخر تتلى فيروى نصها","عن باقر الاسرار والسجاد",36,"د",1,0],["ومفتاح القبول بلا نزاع","وعين الأنبيا حامي الدخيل",37,"ل",1,0],["وَمُفرِهَةِ تامِكٍ نَيُّها","إِذا ما تُساقُ تَزينُ العِشارا",38,"ر",2,0],["ومفاخرٌ مشهودةٌ يَقضِى لها","يومَ النفار سواجِعُ الكُهّانِ",39,"ن",1,0],["وَمُفرِدُكُم لِلا سَبَبٍ بِشُكرٍ","تَعالَمَهُ المُعادي وَالمُوالي",40,"ي",1,0],["وَمُفرَدَةٍ وَما وَضَعَت حَبيباً","كَما اِنفَرَدَت عَنِ السِربِ الخَواذِل",41,"ل",1,0],["وَمُفَلِّقُ الهاماتِ في ضَنكِ الوَغى","بِمُذَلَّقِ الحَدَّينِ صافي الجَوهَرِ",42,"ر",1,0],["ومفكر في الموت ما","هو قد جفاه له وساده",43,"د",2,0],["ومِفتانٍ قتولِ الدلِّ وَسْنَى","يجاذبُ خَصْرَها رِدْفٌُ رَدَاح",44,"ح",1,1],["ومفجوع على الاحباب باك","اضر به سقام واكتئاب",45,"ب",1,0],["وَمَفاخِرُ الآباءِ زِدتَ جَمالَها","كَالرَوضِ حيّاه الرَبيعُ فَنَوَّرا",46,"ر",2,0],["ومفاوضاتٌ جُلُّ مقصدهِم بها","فُرَصٌ تصيع ووقتهن يطول",47,"ل",1,0],["وَمُفتَرَّةٍ عَن كَالجُمانِ المُنَظَّمِ","مُسَلَّمَةً أَحسِن بِها مِن مُسَلِّمِ",48,"م",1,1],["ومفردٌ إن ألفٌ عوضت","أولاه يرجع بعد ذا ألفا",49,"ف",2,0],["ومفزعي وملاذي في الملمات","ضاقت بما حال حالاتي وأوقاتي",50,"ي",1,0],["وَمَفادُ الإِجراآتِ مُنصَرِفٌ إِلى","ما كانَ مِن شَكلٍ وَمِن أَركانِ",51,"ن",1,0],["وَمُفَوِّضٌ وَالجَبرُ غَيرَ مُجاحِدٍ","عِندي لِأَنَّ عَيانَهُ لا يُجحَدُ",52,"د",1,0],["وَمُفصِحاً بِنَعَم فِي كُلِّ مَسأَلَةٍ","إلا لِمَن لامَهُ فِي الجُودِ أَو عَتَبا",53,"ب",2,0],["وُمُفاضَةً كالنَّهيِ مُحكَمَةً","مِن صُنعِ داوُدِ أَبي سَلمِ",54,"م",1,0],["وَمُفارِقينَ مَعَ الصَبا","عَزماً فَهَل أَرجو الطُلوعا",55,"ع",2,0],["ومُفتقر له جاهٌ صغيرٌ","وقدرٌ عندَ خالِقهِ كبيرُ",56,"ر",1,0],["ومفسراً لكتاب ربي","من به البلغا تحدا",57,"د",2,0],["وَمفردةٍ تبكِي إذا جَنَّ ليلُها","خُفَاتاً وفي أحشائِها النّارُ واللّذْعُ",58,"ع",1,1],["ومفريَّة الفدافد والفيافي","لها في البيد إجفالُ الظَّليم",59,"م",1,0],["ومفيدٌ أموالَه للبَرايا","وهْو للحمدِ والثّنا يستفيدُ",60,"د",1,0],["ومفسدة لاخلاق","وتجرئة على الحرم",61,"م",1,0],["ومُفاضةُ الأذيالِ يُحسَب متنُها","أدراجَ ماء في الغديرِ منمنَمِ",62,"م",1,0],["ومفجوعين من أبناء سعدٍ","فروع علاً يبكُّون الأصولا",63,"ل",2,0],["ومفضَى الأمانة مني إلى","صفاةٍ من الحفظِ لم تُقرَعِ",64,"ع",1,0],["ومفارِقٍ لي كابن عيسى","غَمَّ أيّامي وأدجَى",65,"ج",2,0],["ومُفرش الناس لطفاً مِن تودُّدهِ","كأنَّ خادمهُ الأقصى مُعاقرهُ",66,"ر",2,0],["ومفاخراً ومآثرا مشهورة","ومنابراًَ تثني عليه علانيه",67,"ي",2,0],["ومُفرَدا حيناً يُبصَرُ","أَخا تَعَدُّدِ وذا لا يُنكَرُ",68,"ر",1,0],["ومَفرِقَ العَليَاء بل","تاجاً لِذاكَ المَفرِقِ",69,"ق",1,0],["ومفردَ الشَّيَمِ والبدرُ الذي","سناؤُه بين البُدور مُكتَمِل",70,"ل",1,0],["ومفقود عزيز الفقد تأتى","منيته ومأمول وليد",71,"د",1,0],["ومفاخرٍ ما شئتَ إن عدّدتَها","فالسّيلُ أطبق لا يعدّ زهامُهُ",72,"م",2,0],["وَمفترشٍ صَهَواتِ الجيادِ","إذا ما جرى لا يخاف العِثارا",73,"ر",2,0],["ومفاوزٌ مِنْ دونهنّ مفاوزٌ","وتهائِمٌ مِنْ فوقهنّ نُجودُ",74,"د",1,0],["ومفتاحُ سرٍّ للحروف ورمزهاَ","وفكّ مُعَمَّى العسرِ ينحلُّ باليسرِ",75,"ر",1,0],["ومفرِّقُ الخيراتِ وهي","الكنزُ لا يَخشى نفادَه",76,"د",2,0]]}