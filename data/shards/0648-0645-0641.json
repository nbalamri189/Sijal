{"poems":[[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[63,"ومفيقين من الله","https://www.aldiwan.net/poem46080.html","مجزوء الرمل"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[72,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[72,"ومفرد الحسن تعشقته","https://www.aldiwan.net/poem20328.html","السريع"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[38,"إني وإن كان ابن عمي كاشحا","https://www.aldiwan.net/poem7824.html","الكامل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[62,"ومفرد بالحسن أفردته","https://www.aldiwan.net/poem52330.html","السريع"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[45,"إن الكؤوس بها يطيب المجلس","https://www.aldiwan.net/poem64614.html","الكامل"],[61,"إجعل جليسك دفترا في نشره","https://www.aldiwan.net/poem51299.html","الكامل"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[44,"إحدى بني بكر بن عبد مناه","https://www.aldiwan.net/poem30327.html","الكامل"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[31,"نعم الفؤاد مزارها محظور","https://www.aldiwan.net/poem42536.html","الكامل"],[74,"ومفازة لانجم في ظلمائها","https://www.aldiwan.net/poem12914.html","الكامل"],[33,"ومفروشة الخدين وردا مضرجا","https://www.aldiwan.net/poem25976.html","الطويل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"أنا والله مشتاق","https://www.aldiwan.net/poem63294.html","الهزج"],[8,"جهلت علي ابن الحيا وظلمتني","https://www.aldiwan.net/poem21816.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[33,"ومفرشة الخدين ورداُ مضرجا","https://www.poetsgate.com/ViewPoem.aspx?id=2592",""],[45,"إنَّ الكُؤُوسَ بها يَطِيبُ المجْلِسُ","https://www.poetsgate.com/ViewPoem.aspx?id=31144",""]],"verses":[["وَمَفازَةٍ تَلِدُ الهَجيرَ خَرَقتُها","وَالأَرضُ مِن لَمعِ السَرابِ بُروقُ",0,"ق",1,0],["وَمُفِيقِينَ مِنَ اللَّهْ","وِ نَشاوَى مِنْ مِراحِ",1,"ح",1,1],["ومُفاضَةً زَغْفاً تضاعَفَ نَسْجُها","خَلْقاءَ قدَّرَ نَسْجَها داوُودُهُ",2,"د",2,0],["ومفصحٌ حين يروى الصاد من كرمٍ","فللمحاسن ترتيبٌ وترتيل",3,"ل",1,0],["ومفرد الحسن تعشقته","فكانَ حتَّى مفرد العين",4,"ن",1,1],["ومفاتيحُ للخصوص وكانت","بالمفاتيح تُفتح الأبوابُ",5,"ب",1,0],["وَمُفرِهَةٍ عَنسٍ قَدَرتُ لِرِجلِها","فَخَرَّت كَما تَتّابَعُ الريحُ بِالقَفلِ",6,"ل",1,0],["وَمُفيدُهُ نَصري وَإِن كانَ اِمرَأً","مُتَزَحزِحاً في أَرضِهِ وَسَمائِهِ",7,"ا",3,0],["وَمَفاتيحُها مَقاليدُ مُلكٍ","باعَها الوارِثُ المُضيعُ بِبَخسِ",8,"س",1,0],["ومفردٍ بالحُسْنِ أفردْتُهُ","بالحُبِّ لمَّا قَلَّ عُشَّاقُه",9,"ق",2,1],["ومُفتَقَر الدنيا إِلى رأيهِ الذي","يُرَدُّ إليه في الأمورِ المقالدُ",10,"د",1,0],["وَمُفاكِهٍ عَبِقُ الكَلامِ كَأَنَّما","يُفضي إِلَيكَ بِلَفظِ فيهِ النَرجِسُ",11,"س",1,0],["ومفيد آداب ومؤنس وحشة","وإذا انفردت فصاحب وسمير",12,"ر",1,0],["ومفاضل الأعداء يغرس نبله","بحدائق الوجنات والأحداق",13,"ق",1,0],["ومُفَهَّهَيْنِ تعرَّضا لِحرابَتي","فتعرَّضَتْ لهما صدورُ حِرابي",14,"ب",2,0],["وَمُفاضَةٍ كَالنَهيِ تَنسُجُهُ الصَبا","بَيضاءَ كَفَّت فَضلَها بِمُهَنَّدِ",15,"د",1,0],["وَمُفَرِّجَ الكُرَبِ الَّتي لَو صافَحَت","شُمَّ الجِبالِ لزَلزَلَت هَضباتِها",16,"ت",3,0],["وَمُفَنِّدٍ لَوّامَةٍ نَهنَهتُهُ","عَن مُغلِطٍ لِعَذولِهِ نَجّاهِ",17,"ه",1,0],["وَمَفاوِزُ الآمالِ يَبعُدُ شَأوُها","إِن لَم تَكُن جَدواكَ فيها زادي",18,"ي",1,0],["وَمَفيضَ عَبرَتِها وَمَومى كَفِّها","وَرِداءُ عَصبٍ بَينَنا مَنشورُ",19,"ر",1,0],["وَمَفازَةٍ لانَجمُ في ظَلمائِها","يَسري وَلا فَلَكٌ بِها دَوّارُ",20,"ر",1,1],["وَمَفروشَةِ الخَدَّينِ وَرداً مُضَرَّجاً","إِذا جَمَشَتهُ العَينُ عادَ بَنَفسَجا",21,"ج",2,1],["ومُفاضَةٌ مسرودةٌ وكتيبةٌ","مَلمومَةٌ وعَجاجَةٌ شهباء",22,"ا",2,0],["وَمُفنٍ في طِلابِ المُر","دِ وَالخَمرِ مَعاً وَفري",23,"ر",2,0],["وَمُفتَصَلاً عَن ثَديِ أُمٍّ تُحبُّهُ","عَزِيزٌ عَلَيها أَن يُفارِقنَ مُفتَلى",24,"ل",2,0],["وَمَفجوعة أَودى أَخوها بعسفهم","ووالدة قد بانَ عنها وَحيدها",25,"د",3,0],["ومفتيها الأمينُ ومفتديها","وراءَ تخومها يشكو هيامهْ",26,"م",2,0],["ومفجر الفكر والاختراع","ومستقى اللهاة واليراع",27,"ع",1,0],["ومفاضة زغبا تضاعف نسجها","حلقاء قدر نسجها داوده",28,"د",2,0],["ومُفوَّهٍ كالفحل عند هديره","فَذِّ البيان يفيضُ من يُنبوع",29,"ع",1,0],["ومُفَرِّقين مذاهباً جُمِعَت","وحَنَا عليها الآيُ والذِكر",30,"ر",1,0],["ومفّرِقينَ مَذاهباً وعناصراً","مُتَكَفِّلينَ سياسةَ استعمار",31,"ر",1,0],["ومُفترِشاتٌ فضلةً في زرائبٍ","يُوَسّدُها ما حولَها مِن رَكائم",32,"م",1,0],["ومفرشة الخدين ورداُ مضرجا","إذا جَمَشَتْهُ الْعَيْنُ عاد بَنَفْسجَا",33,"ج",2,1],["ومُفاكِهٍ عبِقُ الكَلامِ كأّنَّما","يفضِي إِليكَ بِلفْظِ فيهِ تُقْبسُ",34,"س",1,0]]}