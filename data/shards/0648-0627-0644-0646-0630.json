{"poems":[[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127849","المنسرح"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83015","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66154","الرجز"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67555","البسيط"],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5573,"ياهن وش فيهم علينا الموارد","https://www.poetsgate.com/ViewPoem.aspx?id=200453",""]],"verses":[["والنذل لا يهتدي لمكرمةٍ","لأن ذاكَ المزاج منحرف",0,"ف",1,0],["وَالنَّذلُ يوحِش أهله ويجيعُهم","ويحضُّ ناصِرَهم على الخِذلانِ",1,"ن",1,0],["والنَّذْلُ مَنْ هانَتْ عليهِ نَفْسُهُ","فَلَوْ هَوَى إلى الحَضيضِ ما شكا",2,"ا",1,0],["والنذل نذل وإن تكنّى","وصار ذا منطق وشان",3,"ن",1,0],["والنذل لا ينشد ولا عنه منشود","تلقاه في الحارة يلم الفساله",4,"ل",2,0],["والنذل خفاقه من الجوف شارد","قلبه ليامنه لقانا رعاعه",5,"ع",2,0]]}