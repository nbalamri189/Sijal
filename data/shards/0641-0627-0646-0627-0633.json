{"poems":[[55,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[3,"دع ما مضى لك في الزمان الأول","https://www.aldiwan.net/poem196.html",""],[10,"أيا عيني ويحكما استهلا","https://www.aldiwan.net/poem21121.html","الوافر"],[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[53,"لما تؤذن الدنيا به من شرورها","https://www.aldiwan.net/poem65430.html","الطويل"],[53,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[87,"رزقت صاحب عهده","https://www.aldiwan.net/poem8069.html","المجتث"],[45,"وجارية شعرها شطرها","https://www.aldiwan.net/poem9579.html","المتقارب"],[47,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[30,"نعائي ابن ليلى للسماح وللندى","https://www.aldiwan.net/poem5378.html","الطويل"],[63,"رأت شيئا يضاحكها فصدت","https://www.aldiwan.net/poem51592.html","الوافر"],[68,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62205","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9966","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[53,"نُبّئتُ أن ابن خنسا","https://www.poetsgate.com/ViewPoem.aspx?id=29371",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[90,"نهيتكِ عن هواكِ فما انتهيتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19573&r=&rc=76",""],[3,"دع ما مَضى لكَ في الزَّمان الأَوَّل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10742&r=&rc=96",""],[133,"علقت عودي على صفصافة اليأس","https://www.aldiwan.net/poem67430.html","البسيط"],[138,"ألا أبلغا عني لؤيا رسالة","https://www.aldiwan.net/poem21029.html","الطويل"],[146,"أبا الخير المفيد لكل خير","https://www.aldiwan.net/poem58356.html","الوافر"],[161,"شعبان","https://www.aldiwan.net/poem27827.html","الكامل"],[173,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[190,"يا غرفتي إن غرفة نطقت","https://www.aldiwan.net/poem43871.html","الكامل"],[203,"أبيت وجنبي ليس يحويه مضجع","https://www.aldiwan.net/poem45232.html","الطويل"],[208,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[260,"فدى لكُما رجلي أمي وخالتي","https://www.aldiwan.net/poem709.html",""],[290,"ماذا أقول وقد وقفت بموقف","https://www.aldiwan.net/poem39428.html","الكامل"],[385,"وأصل المحبوب والقدحا","https://www.aldiwan.net/poem49239.html","المديد"],[408,"لكم آل الرسول جعلت ودي","https://www.aldiwan.net/poem46969.html","المديد"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[438,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[469,"غصون الحمى شف المعنى قدودها","https://www.aldiwan.net/poem3618.html","عموديه"],[473,"أحسن المولى وقد كان أسا","https://www.aldiwan.net/poem59954.html","البسيط"],[473,"يا طلعة القمر المنير","https://www.aldiwan.net/poem60107.html","مجزوء الكامل"],[475,"والشيب يأمر بالعفاف وبالتقى","https://www.aldiwan.net/poem4788.html","الكامل"],[508,"لعمرك يا جرير لقول عمرو","https://www.aldiwan.net/poem21749.html","الوافر"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[511,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138435",""],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107252","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28271","الوافر"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82292","الرمل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11124","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46488","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89532","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53166","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27994","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115061","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137378",""],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58373","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203486","الوافر"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110803","الرجز"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121336","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45223","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108191","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66365","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46024","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91490","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21504","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59488","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40068","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111411","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106741","الوافر"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135110","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66145","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33614","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147260","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139474",""],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[5121,"رونق الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36282",""],[5150,"بوحي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=202786",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5512,"أنا السُّوري","https://www.poetsgate.com/ViewPoem.aspx?id=205024",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[5725,"يناوحني الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=208841",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5906,"سَمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188806",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5950,"مريم ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128336",""],[6023,"افعل جميلاً أنت تحصده","https://www.poetsgate.com/ViewPoem.aspx?id=123929",""],[6031,"بكيتُكِ لو أنّ الدموع تُديلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46287",""],[6128,"‏اركب مَعي","https://www.poetsgate.com/ViewPoem.aspx?id=212857",""]],"verses":[["فَإِن أَسرِ فَالعَلياءُ هَمّي وَإِن أُقِم","فَإِنّي عَلى بِكرِ المَكارِمِ باني",0,"ن",2,0],["فَأَنا سَرَيتُ مَعَ الثُرَيّا مُفرَد","لا مُؤنِسٌ لي غَيرَ حَدِّ المُنصُلِ",1,"ل",1,0],["فَإِن أَسعَفتُماني فَاِرفِداني","بِدَمعٍ يُخضِلُ الخَدَّينِ بَلّا",2,"ل",2,0],["فإن أسرَّ وأبدى","بغضي فحُقَّ ببغضي",3,"ض",2,0],["فإن استعصى عليه","فهو لا شك صريعه",4,"ع",2,0],["فإن استكثرتَ أو عا","قك عن ذاك احتشامُ",5,"م",1,0],["فَإِنّا سَنَجعَلُ مِن أَرضِها","لَنا وَطَناً وَلَكَم مَدفَنا",6,"ن",2,0],["فَإِن أَساءَكَ قَولي","كَذِّب أَباكَ بِوَعدِ",7,"د",1,0],["فَإِن أَسكَرَتنا فَفي جَهلِها","بِما فَعَلَتهُ بِنا عُذرُها",8,"ر",3,0],["فَإِن أَسلُ أُلّافَ الصِبا فَبِعَقبِ ما","غَنيتُ وَساحاتُ الصِبا مِن مَآلِفي",9,"ف",2,0],["فَإِنّا سَنَبكي غالِباً إِن بَكَيتُمُ","لِحاجَتِكُم لِلمُعضِلاتِ الأَثاقِلِ",10,"ل",1,0],["فإنْ أَسِيتْ لجُرْحِ الشَّيْبِ نَفْسي","فإنَّ الشَّيْبَ جُرْحٌ ليسَ يُوسى",11,"س",2,0],["فَأُناسٌ تَلومُ في نَقصِ كيسي","وَأُناسٌ تَلومُ في مَلءِ كاسي",12,"س",2,0],["فَأُناسٌ تَقولُ يا أَبا فِراسٍ","وَأُناسٌ تَقولُ يا أَبا نُواسِ",12,"س",1,0],["فَإِن أَسَرَّ ما بِهِ تَهَوُّسا","وَلَم يُطِق مِن ضُعفِهِ تَنَفُّسا",13,"س",2,0],["فإنِ استَغْنَيْتَ عن عِزّ البَقا","فإلى وَصلي ببذلِ النفسِ حَي",14,"ي",1,0],["فَإِنَّا سنَبْكِيهِ بِجُرْدٍ كَأَنَّهَا","ضِرَاءٌ دَعَاهَا مِنْ سَلُوقَ مُكَلِّبُ",15,"ب",1,0],["فإنْ أسْتَطِعْ في الحَشْرِ آتِكَ زائرا","وهَيْهاتَ لي يوْمَ القِيامَةِ أشْغال",16,"ل",1,0],["فَأَنا سَرَيتُ مَعَ الثُرَيّا مُفرَداً","لا مُؤنِسٌ لي غَيرَ حَدِّ المُنصُلِ",17,"ل",1,0],["فَإِنَّ أَسقَامَهُمْ فِي كُلِّ جَارِحَةٍ","مِنَّا وَآلاَمَهُمْ فِي كُلِّ إِحْسَاسِ",18,"س",1,0],["فإن أسرَّ وأبدا","بغضي فحُقَّ ببغضي",19,"ض",2,0],["فان استطعت حقوقها وشروطها","تربت يداك أغنم فنعم المدخر",20,"ر",1,0],["فان اسدى الآله عليك عفواً","والاّ يا فجار فقد هويت",21,"ت",1,0],["فأَنا سريتُ معَ الثُّريَّا مُفرداً","لا مؤنسٌ لي غيرَ جدّ المنصل",22,"ل",1,0],["فإِن أَسِر في ظَلام الليلِ مُستَتِراً","فالحُزن يَسطَعُ من عَيني كنِبراسِ",23,"س",1,0],["فَإِنّا سَنَحميهِ بِكُلِّ طمرَّةٍ","وَذي مَيعَةٍ نَهدِ المَراكِلِ هَيكَلِ",24,"ل",1,0],["فإن أسعفتَ بالأقلام مَنًّا","فما يغنى الطعامُ عن الشرابِ",25,"ب",1,0],["فِإِنِ اسْتَبَحْتَ حِمَى الإلهِ بِوَمْضَةٍ","شَطَحَتْ بِحَالٍ وَ انْطَوَتْ بِكَيَانِ",26,"ن",1,0],["فَإِنِ اِستَقَرَّ فَلُم أَخاكَ وَإِن نَبا","فَكُنِ النَّديمَ الفَردَ مِن نُدمائِهِ",27,"ا",3,0],["فإن استرابوا بي ولم تصفي","فاللّه ما من دونه وزرُ",28,"ر",1,0],["فإن أستبنْ ما أصنعُ اليومَ يأتني","غدٌ بالذي لم أستبنْ كيفَ أصنعُ",29,"ع",1,0],["فأناس رعوا لنا حين غابوا","وأناس جفوا وهم حضّارُ",30,"ر",1,0],["فَإِن أَستَطِع لا تَلتَبِسْ بي مُقاعِسٌ","وَلا يَرَنِي مَبدَاهُمُ وَالمَحاضِرُ",31,"ر",1,0],["فإن استقمت نجوت من لمزاتهم","وإن اضطربت خجلت حيث أسير",32,"ر",1,0],["فَإِن اِستَخبَرت عَنيَ قُل","شَبَحاً غادَرت مطرحا",33,"ح",2,0],["فإن أَسْلَم فَأجْرٌ لَمْ يَفتْنِي","وَإنْ أُقْتَلْ فتُهْنُيني الشَّهادَهْ",34,"د",2,0],["فأناسٌ بخمرِ عَينيك صَرعى","وأناسٌ بسَيْف جفنيكَ قتلى",35,"ل",2,0],["فإِنِ استَسلَمُوا فإِنَّ الرعايا","عِزُّها في انقيادِها للوالي",36,"ل",2,0],["فإنَّ أسانيدَ النسيمِ ضعيفةٌ","وإن صحَّ عن بانِ الكثيب ورودها",37,"د",3,0],["فَإِنِ اِستَغنَيتُ عَن إِنصافِهِ","فَمَتى لَم أَكُ مِنهُ مُفلِسا",38,"س",2,0],["فَإِن اِستَفَدتَ مَسَرَّةً","فَبِحُسنِ مَشوَرَةِ المُشيرِ",39,"ر",1,0],["فَإِنِ استَطَعتَ فَخُذ بِشَيبِكَ فَضلَةً","إِنَّ العُقولَ يُرى لَها تَفضيلُ",40,"ل",1,0],["فَإِنّ أسلَم أَعُمَّهُم بِحَربٍ","يَشِيبُ لهَولِهَا رَأسُ الغُلاَمِ",41,"م",1,0],["فإنِ اسْتلَّها وأنت تسيرُ","ذاك أنَّ العُقبى نعيمٌ مقيمُ",42,"م",1,0],["فإن اسلمتَ دِين الله فيها","على الدُّنيا وساكنها السّلام",43,"م",1,0],["فأناس لذة القرب لهم","وأناس عندهم بالبعد كيّْ",44,"ي",1,0],["فانا سكارى من كوارث دهرنا","وتذهل نفس بالهموم انتشت نشوا",45,"و",2,0],["فإِن أَسعَفتِ يا وُرقُ انتَزَحنا","حذار الكاشِحِينَ وَراءَ قافِ",46,"ف",1,0],["فَإنِ استَطَعتِ فَخَفِّفي مِن ثِقلِهِ","بِاللَهوِ في يَقَظاتِهِ وَمَنامِهِ",47,"م",2,0],["فإن استمرّ على الضلال مريدهم","لشقائه وسفاهة الألباب",48,"ب",1,0],["فَإِن أَسطَع أرح مِنهُ أناسي","بِضَربَةِ فاتِكٍ غَيرِ اِعتِذارِ",49,"ر",1,0],["فَإِن اِستغنى فَما يَعدِلُهُ","نَخوَة كِسرى عَلى بَعضِ السُّوَق",50,"ق",1,0],["فَإِن أَسَتَطِع أَغلِب وَإِن يَغلِبِ الهَوى","فَمِثلُ الَّذي لاقَيتُ يُغلَبُ صاحِبُه",51,"ب",2,0],["فأناسٌ أوجبوا الخلع ولم","يره قومٌ بخلعٍ وقعا",52,"ع",2,0],["فَإِن اِستَقَمت فَإِن دَهرك كُلَهُ","عِوَجٌ وَإِن أَخطَأت كُنتُ مُصيبا",53,"ب",2,0],["فَإِن أَسلُ لا أَسلو هَواهُم تَجَلُّداً","وَلكِنَّ يَأساً أَخلَفَتني أَوائِلُه",54,"ل",2,0],["فإن أساءت فلكم قد أحسنت","حين تلاقى ب