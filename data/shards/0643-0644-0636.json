{"poems":[[93,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[458,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[558,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"]],"verses":[["كُلُّ ضَرْبٍ شَبِيهُ سِرْبٍ جَمِيعٍ","مُفْرَدٍ عَنْ لِدَاتهِ فِي مَكَانِ",0,"ن",1,0],["كُلُّ ضَرْبٍ مِنَ الجَمِيلِ جَمِيلٌ","غَيْرَ أَنَّ الْعَزِيزَ فِيهِ التَّمَامُ",1,"م",1,0],["كل ضوء يريكه في صفاح","فمن الشمس مصدر الأضواء",2,"ا",2,0],["كلّ ضَمور كالحني","ي فوقها كالسهمِ",3,"م",1,0],["كل ضيق وإن تطاول دهراً","عن قريب لا بد يأتي انفراجه",4,"ج",2,0]]}