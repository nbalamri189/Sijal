{"poems":[[95,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[95,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[563,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74050","الخفيف"],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5376,"لا تكلُّوا يا صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188464",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""]],"verses":[["كُلُّ ضَرْبٍ شَبِيهُ سِرْبٍ جَمِيعٍ","مُفْرَدٍ عَنْ لِدَاتهِ فِي مَكَانِ",0,"ن",1,0],["كُلُّ ضَرْبٍ مِنَ الجَمِيلِ جَمِيلٌ","غَيْرَ أَنَّ الْعَزِيزَ فِيهِ التَّمَامُ",1,"م",1,0],["كل ضوء يريكه في صفاح","فمن الشمس مصدر الأضواء",2,"ا",2,0],["كلّ ضَمور كالحني","ي فوقها كالسهمِ",3,"م",1,0],["كل ضيق وإن تطاول دهراً","عن قريب لا بد يأتي انفراجه",4,"ج",2,0],["كل ضرب فمن طوال ومن حد","ب قصار والحول والعوران",5,"ن",1,0],["كلُّ ضَرَّاءَ تَرجُفُ النفسُ منها","هي بالصبر والتُّقى سَرَّاء",6,"ا",2,0],["كُلُّ ضارٍ عَلى نَوازٍ مِنَ السِر","ب نَجَت لَو يَكونُ أَغنى النَجاءُ",7,"ا",2,0],["كلّ ضرب لغشّنا جربوهُ","مِن ضروبِ التَغرير وَالتَضليلِ",8,"ل",1,0],["كل ضير في سنة الكون خير","تضحك الأرض حين تبكي السماء",9,"ا",2,0],["كلُّ ضعنٍ قد تنحَّى","ناله فَرْس الذئاب",10,"ب",1,0],["كُلُّ ضِلعٍ تَحَطَّمَتْ تَحتَ رَكلٍ","زَفَرَتْ بِالأَنِينِ وَ الإِعياءِ",11,"ا",2,0]]}