{"poems":[[45,"حيا وأيسر ما قاسيت ما قتلا","https://www.aldiwan.net/poem9983.html","البسيط"],[18,"أنكحها فقدها الأرقم في","https://www.aldiwan.net/poem23926.html","المنسرح"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[18,"أنكحها فقدها الأراقم في","https://www.poetsgate.com/ViewPoem.aspx?id=27769",""],[18,"أَنْكَحَهَا فَقْدُهَا الأَرَاقِمَ فِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26468&r=&rc=34",""],[170,"ومهمه يتراءى آله لججا","https://www.aldiwan.net/poem47131.html","البسيط"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[411,"أنكحوني أسماعكم إنني أم","https://www.aldiwan.net/poem49834.html","الخفيف"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[469,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[909,"","https://poetry.dctabudhabi.ae/diwan/poem/99817","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119247","الكامل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102372","البسيط"],[3502,"","https://poetry.dctabudhabi.ae/diwan/poem/147416","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69980","الرمل"],[4316,"","https://poetry.dctabudhabi.ae/diwan/poem/202450","الكامل"],[4316,"","https://poetry.dctabudhabi.ae/diwan/poem/144485","الكامل"]],"verses":[["أَنكَحتُ صُمَّ حَصاها خُفَّ يَعمَلَةٍ","تَغَشمَرَت بي إِلَيكَ السَهلَ وَالجَبَلا",0,"ل",2,0],["أَنكَحَها فَقدُها الأَرقِمَ في","جَنبٍ وَكانَ الخِباءُ مِن أَدَمِ",1,"م",1,1],["أنكِحوا عِندَ مَزجِها الماءَ ناراً","فَارتَمَت عِندَ لَمسِهِ بِالشرارِ",2,"ر",1,0],["أنكحها فقدها الأراقم في","جنب وكان الحباء من أدم",3,"م",1,1],["أَنْكَحَهَا فَقْدُهَا الأَرَاقِمَ فِي","جنبٍ وَ كانَ الخباءُ منْ أدمِ",4,"م",1,1],["أَنكَحتُه ذاتَ خلخالٍ مُقرَّطَةً","والركبُ كانوا شهوداً والصّدى خُطبا",5,"ب",2,0],["أَنكَحَتها بيضَ الصَوارِمِ غارا","تُكَ وَهيَ العَقيلَةُ العَذراءُ",6,"ا",2,0],["أنكِحوني أسماعَكمْ إنَّني أم","هرُها الصِّدقَ وهو خيرُ صداقِ",7,"ق",1,1],["أنكحتُها ساري البرو","ق ورَيْقَ أَغصان المُرُوَّهْ",8,"و",2,0],["أُنكحتها من بعد ما تعنَّستْ","ولجَّت الأيامُ في إعضالها",9,"ل",3,0],["أنكحته غيداً دليلُ جمالها","تفضيل أفواه وثنيُ خناصر",10,"ر",1,0],["أنكحتها بكرا وما أمهرتها","إلا قنا وصوارما وفوارسا",11,"س",2,0],["أنكحتها رشأ رشيقاً شادناً","يحكي الغزالة في السماء سناء",12,"ا",2,0],["أنكحتمُ يا بني نَصرٍ فتاتَكُمُ","وَجهاً يَشينُ وجوهَ الرَّبربِ العِينِ",13,"ن",1,0],["أنكحت حرتك الكري","مة عامداً إجلالها",14,"ل",3,1],["أنكحوه إلاهةً ذات شان","وعلى ذا منوه بالأشجان",15,"ن",1,0],["إِنكِ حَقاً بَهيَّه","لَيسَ فيكِ ما يَشين",16,"ن",1,0],["انكحت بيض الهند سمر رماحهم","فرؤسهم عوض النثار نثار",17,"ر",1,1],["أنكحت بيض الهند سمر رماحهم","فرؤوسهم عوض النثار نثار",18,"ر",1,1]]}