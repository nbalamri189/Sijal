ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=116388",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6052,"ضمير العالم","https://www.poetsgate.com/ViewPoem.aspx?id=34807",""],[6053,"تِلْكَ الرِّسَالَةُ ... !","https://www.poetsgate.com/ViewPoem.aspx?id=197035",""],[6069,"سرى موهناً واستكتمته المهالك","https://www.poetsgate.com/ViewPoem.aspx?id=105697",""],[6070,"رَكبتَ هواكَ ألوانَ الرُّكوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=189129",""],[6093,"ولا كل ّ طير ٍ بالجناحِ يَطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190513",""],[6093,"شفتان وقهوة","https://www.poetsgate.com/ViewPoem.aspx?id=204117",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6229,"ملاكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65181&r=&rc=8",""],[6237,"إغراء الحُب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77862&r=&rc=4",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""],[572,"أنا أفدِي التي تَبدُو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9394&r=&rc=251",""]],"verses":[["وَتَضحَكُ نارُهُ وَضَحاً إِذا ما","رَغَت نارُ القَبائِلِ بِالدُخانِ",0,"ن",1,0],["وَتَضحَكُ عَنكَ الأَرضُ أُنساً وَغَبطَةً","وَتَبكيكَ أَخدانُ العُلى وَالمَناقِبِ",1,"ب",1,0],["وتُضيءُ في هَبَواتِهِ صَفحاتُهُمْ","كالفَجْرِ يخْطِرُ في رِداءِ ظَلامِ",2,"م",1,0],["وتُضيءُ أحْوَرَ يَسْتَفِزُّ إِلى الصِّبا","نِضْوَ المَشيبِ مُحالِفَ الإرْعاشِ",3,"ش",1,0],["وتضيع الشهب في موكبه","كخيالات المريض الساهر",4,"ر",1,0],["وَتَضِجُّ النِساءُ مِن خَيفَةِ السَب","يِ وَتَبكي عَلى الصِغارِ اليَتامى",5,"م",2,0],["وتضطبنى الصواعق في غمود","وتقتص البوارق بالأهلهْ",6,"ل",2,0],["وَتَضْحَكُ مِنْ بَغْدَادَ بيضُ قِبَابها","إِذَا مَا تَرَاءَتْ بِالسَّوَادِ قِبَابِي",7,"ب",2,0],["وتضفو على أعطافه حُلَلُ الحُلي","مطهرة ما دَنَّسَتها المَعايِب",8,"ب",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ لَم يُفَلَّلِ",9,"ل",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ مُتَناعِمُ",10,"م",1,0],["وَتَضَنُّ دُهقانَ الكَلا","مِ كَضَنِّ دُهقانِ النُضارِ",11,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِه","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",12,"ل",1,0],["وتضتضي الخدمة أن أغدوا","جواده حيناً وأن أعدوا",13,"د",3,0],["وَتَضُجُّ أرْكَانْ المَحَطَّةِ كُلِّهَا","وَأُنَاسُهَا بِصِياحِ الاسْتِحْسَانِ",14,"ن",1,0],["وَتَضَعضَعَ الاِسلامُ يَومَ مُصابِهِ","فَالدينُ يَبكي فَقدَهُ وَالسُؤدُدُ",15,"د",1,0],["وتضمنت جزل الوقود حمولها","والنصر في التحقيق ما هي تحملُ",16,"ل",1,0],["وتضّوع النفحات منها مثله","تبينها للناس والتقرير",17,"ر",1,0],["وتضرب بالزعانف جانبَيْها","فتنقلب الظهور بها بطونا",18,"ن",2,0],["وَتُضيءُ في وَجهِ الظَلامُ مُنيرَةً","كَجُمانَةِ البَحرِيِّ سُلَّ نِظامُها",19,"م",3,0],["وَتَضَحْضَحَتْ حَوْلِي بحورٌ جَمَّةٌ","وأَبَى ابنُ إبراهيم أنْ يَتَضَحْضَحَا",20,"ح",2,0],["وتضاحك الروض الكئيب لصوبه","حتى تفتق نوره المرتوق",21,"ق",1,0],["وتَضييعَ مثليَ مالا يحلُّ","واللَّه يكره ما لا يَحلُّ",22,"ل",1,0],["وتضمنُ ذاك أعراقٌ كرامٌ","تهزُّك لي وأخلاقٌ سُهولُ",23,"ل",1,0],["وَتُضحي جِبالُ الرومِ غُبراً فِجاجُها","بِما أَشعَلَت غاراتُهُ وَمَقانِبُه",24,"ب",2,0],["وَتُضمِرُ حِقداً لِلمُحَدِّثِ لَو دَرى","بِهِ ذَلِكَ المِسكينُ ما كادَ يَهزُلُ",25,"ل",1,0],["وَتَضَعُ التاجَ عَلى رَأسِهِ","وَتَضَعُ الشَوكَ عَلى رَأسي",26,"ي",1,0],["وَتُضحي وَما ضَمَّت فُضولَ ثِيابِها","إِلى كَتِفَيها بِاِئتِزارٍ وَلا عَقدِ",27,"د",1,0],["وتُضاع البلاد بالنوم عنها","وتضاع الأمور بالإهمال",28,"ل",1,0],["وَتَضَوَّعَت مِنكَ الدُهورِ كَأَنَّما","في كُلِّ ناحِيَةٍ بَخورٌ يُحرَقُ",29,"ق",1,0],["وَتُضيءُ أَثناءَ الفَضاءِ بِغُرَّةٍ","لاحَت بِرَأسِ الطَودِ تاجاً أَزهَرا",30,"ر",2,0],["وَتُضاعُ البِلادُ بِالقَومِ عَنها","وَتُضاعُ الأُمورُ بِالإِهمالِ",31,"ل",1,0],["وتَضحكُ سِنُّ المرْءِ والقلبُ مُوجَعٌ","ويرضى الفَتَى عن دَهْرِهِ وهوَ عاتِبُ",32,"ب",1,0],["وَتَضرِبَهُم هَبراً وَقَد سَكَنوا الكُدى","كَما سَكَنَت بَطنَ التُرابِ الأَساوِدُ",33,"د",1,0],["وَتُضحي الحُصونُ المُشمَخِرّاتُ في الذُرى","وَخَيلُكَ في أَعناقِهِنَّ قَلائِدُ",33,"د",1,0],["وَتَضريبُ أَعناقِ المُلوكِ وَهامِها","لَكَ الهَبَواتُ السودُ وَالعَسكَرُ المَجرُ",34,"ر",1,0],["وَتَضرِطُ في لِحيَةِ الجاثِلي","قِ إِذا خارَ في سِفرِ شَعيا وَعَج",35,"ج",1,0],["وَتَضحَكُ عَن نَظمٍ مِنَ اللُؤلُؤِ الَّذي","أَراكَ دُموعَ الصَبِّ كَاللُؤلُؤِ النَثرِ",36,"ر",1,0],["وَتَضرِبُ أَقواماً صِحاحاً ظُهورُها","وَتَترُكُ حَقَّ اللَهِ في ظَهرِ مالِكِ",37,"ك",1,0],["وَتَضرِبُ حينَ تَضرِبُ لِلمَعالي","مَكانَ الجَوزِ مِن عَقدِ العِنانِ",38,"ن",1,0],["وَتُضرَبُ لي الأَمثالُ في كُلِّ نَظرَةٍ","وَقَد حَنَّكَتني الحادِثاتُ وَجَرَّبَت",39,"ت",1,0],["وَتَضعَفُ عَزمَةُ البيضِ المَواضي","وَتَقصُرُ هِمَّةُ الأَسَلِ الطِوالِ",40,"ل",1,0],["وَتُضحي بَينَهُم لَحماً عَبيطاً","يُقَسِّمُهُ المُقَسِّمُ بِالقِداحِ",41,"ح",1,0],["وَتَضَوَّرَ القَبرُ الَّذي أُسكِنتَهُ","حَتّى ظَنَنّا أَنَّهُ المَقبورُ",42,"ر",1,0],["وَتَضَوَّعَت مِسكاً وَسُرَّ فُؤادُها","فَسُرورُها بادٍ لِمَن يَتَوَسَّمُ",43,"م",1,0],["وَتَضَوَّعَ المِسكُ الذَكِيُّ وَعَنبَرٌ","مِن جَيبِها قَد شابَهُ كافورُ",44,"ر",1,0],["وتُضيمُ نفسَكَ وَهْيَ جِدُّ عزيزَةٍ","تحمي الحقيقة إن تحَفَّز واثبُ",45,"ب",1,0],["وَتُضحي غَضيضَ الطَرفِ دوني كَأَنَّما","تَضَمَّنَ عَينَيها قَذىً غَيرُ مُفسِدِ",46,"د",1,0],["وَتُضحي الجِبالُ الغُبرُ دوني كَأَنَّها","مِنَ الآلِ حُفَّت بِالمُلاءِ المُعَضَّدِ",46,"د",1,0],["وتضحكُ سِنُّ الحرْبِ وهي مَلِيّةٌ","لأبْطالها بالمأزِقِ المُتَجَهِّم",47,"م",1,0],["وتَضِجُّ أيْسارٌ ويَصْدَحُ شاربٌ","وتَرِنُّ سُمّارٌ ويَهْدِرُ جامل",48,"ل",1,0],["وتضوّعَ الكافورُ من أرْدانهمْ","عَبقاً فظنّوه عَجاجاً أشهبا",49,"ب",2,0],["وَتَضحَكينَ فَأَبكي","طَلاقَةً وَقُطوبا",50,"ب",2,0],["وَتَضحَكُ عَن بَرَدٍ بارِدٍ","تَلالى كَما لَمَعَ الوَحوحُ",51,"ح",1,0],["وَتُضِلُّ أَفعالُ الشُرورِ جُناتَها","وَتَفوزُ بِالخَيراتِ مُصطَنِعاتُها",52,"ت",3,0],["وَتَضِنُّ بِالشَيءِ القَليلِ وَكُلُّ ما","تُعطي وَتَملِكُ ما لَهُ مِقدارُ",53,"ر",1,0],["وَتَضؤُلُ فيهِ هَذي الشَمسُ حَتّى","تَعودَ كَأَنَّها دينارُ عَثرِ",54,"ر",1,0],["وَتَضرِبُ فِي الماءِ الَّذي كانَ آجِناً","إِذا أَورَدَ الرَاعِي النَضِيحَ المُجَيَّرا",55,"ر",2,0],["وَتضحك في الجلَّى وَتَبكي مصابها","بدمع كأمثال اللآلئ منهلِّ",56,"ل",1,0],["وتَضَاءَلَتْ أَجْرامُنا","فيها بمُوبِقةِ الجَرائِمْ",57,"م",1,0],["وَتَضَطَرِبُ السَّجيرَةُ بَيْنَ","أُنْمُلُتَيْكَ وَالثَّغْرِ",58,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِها","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",59,"ل",1,0],["وتضمّ أشباح الجياع كأنّها","سجن يضمّ جوانح السّجناء",60,"ا",2,0],["وتضْفُو على أعْطافِهِ حُللَ العُلا","مُطَهَّرة ٌ ما دَنَّستْها المعائب",61,"ب",1,0],["وَتَضْحَكُ عَنْ بَرَدٍ بَارِد","تَلاَلا كَمَا لَمَعَ الْوَحْوَحُ",62,"ح",1,0],["وتَضَوَّرتْ جُوعاً فلم تَرَ عنده","ما تأكُّلُ الأوغارُ والأوغام",63,"م",1,0],["وتضرط في لحية الجاثلي","يق إذا خار في سفر شعيا وعج",64,"ج",1,0],["وتضحي الجبال الحمر خلفي كأنها","من البعد حفت بالملاء المعضد",65,"د",1,0],["وتضوُّع النفحات منها مثله","تبيينها للناس والتقرير",66,"ر",1,0],["وتضييعك الحكم الإلهي بعد ما","نشأت به طفلاً وأرشدك المقري",67,"ر",2,0],["وتَضطَرِمُ جِذوَةُ الأحشَاءِ لَمَّا","أُذِنتَ بِقُربِ بَينِهِمُ أذَانَا",68,"ن",2,0],["وتَضحَكُ إعجَاباً بِمَن هِي مِنهُمُ","وَتَأنَفُ عَن نَظمِي وتَأنَفُ عَن نَثرِي",69,"ر",2,0],["وتضحضحت فرقاً بحورُ جيوشهم","لما أتاهم بحر جيشكَ مُزبدا",70,"د",2,0],["وتضلُ أمناً بالرباط خيولُه","ولها عجاجٌ بالحجازِ يُثارُ",71,"ر",1,0],["وتضحى حواليه المعالي ثباثباً","فهذى تناغيه وهذي تلاثمه",72,"م",2,0],["وَتُضحي بِحَيثُ العِزُّ عَودٌ لنابِه","صَريخٌ وَحَيثُ الجُودُ غَضٌّ غُرانِقُ",73,"ق",1,0],["وَتَضْيِيعُ رَأْيٍ فِي اصْطِنَاعٍ مَعَاشِرٍ","يُسَوِّدُ وَجْهَ الاِصْطِناع عُيُوبُهَا",74,"ب",3,0],["وتضايقت طرق المعا","ش فضاق ذرع فسيحه",75,"ح",2,0],["وتضعضعت أركانها لِحُلاحِلٍ","قد كان منها في ذُرى الأَهضاب",76,"ب",1,0],["وَتَضرِبُهُ الَوليدَةُ بِالهَراوى","فَلا غِيَرٌ لَدَيهِ وَلا نَكيرُ",77,"ر",1,0],["وتضاءل الأشخاص عنه ويستوي","في ظله الأقزام والجبار !",78,"ر",1,0],["وتضربُ مَن عاداك بالذّلِّ صاغراً","وتصحب من والاك بالعزّ والنصر",79,"ر",1,0],["وتضاءلت أحجارُه وأقلُّ ما","شكتِ الفِراقَ جنادل وصخو