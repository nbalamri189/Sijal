{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[3,"خُسف البدر حين كان تمام","https://www.aldiwan.net/poem209.html",""],[77,"لنا في الفخر أسنمة مطلة","https://www.aldiwan.net/poem36334.html","الوافر"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[9,"صحا القلب من ذكرى قتيلة بعدما","https://www.aldiwan.net/poem21967.html","الطويل"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[93,"جاءت صفيحتكم ولم أر شكلها","https://www.aldiwan.net/poem11241.html","الكامل"],[54,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[83,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[88,"كم قد لبست بها الضحا من روضة","https://www.aldiwan.net/poem44440.html","الكامل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"متهلل زجل تحن رواعد","https://www.aldiwan.net/poem65503.html","الكامل"],[51,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[29,"عفا واسط من أهله فمذانبه","https://www.aldiwan.net/poem6050.html","الطويل"],[91,"أقامت لدى مرآتها تتأمل","https://www.aldiwan.net/poem9057.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[38,"تذكر هذا القلب هند بني سعد","https://www.aldiwan.net/poem7703.html","الطويل"],[85,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[85,"غال في قيمة ابن بطرس غالي","https://www.aldiwan.net/poem63750.html","الخفيف"],[56,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[43,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[43,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[45,"تريك الذي حدثت عنه من السحر","https://www.aldiwan.net/poem63612.html","الطويل"],[28,"أهلكت مال الله في غير حقه","https://www.aldiwan.net/poem5374.html","الطويل"],[28,"أرى الزعل ابن عروة حين يجري","https://www.aldiwan.net/poem5622.html","الوافر"],[49,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[44,"إني على ما نالني لصبور","https://www.aldiwan.net/poem30044.html","الكامل"],[31,"يا صاح قل للربع هل يتكلم","https://www.aldiwan.net/poem41808.html","الكامل"],[31,"نعم الفؤاد مزارها محظور","https://www.aldiwan.net/poem42536.html","الكامل"],[105,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"ملأت قلبي ندوبا فصرت صبا كئيبا","https://www.aldiwan.net/poem10790.html","المجتث"],[50,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"اللب قطب والأمور له رحى","https://www.aldiwan.net/poem22570.html","الكامل"],[46,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1912","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[50,"تثاقل ليلي فما أبرح","https://www.poetsgate.com/ViewPoem.aspx?id=21636",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""]],"verses":[["وَتَضحَكُ نارُهُ وَضَحاً إِذا ما","رَغَت نارُ القَبائِلِ بِالدُخانِ",0,"ن",1,0],["وَتَضحَكُ عَنكَ الأَرضُ أُنساً وَغَبطَةً","وَتَبكيكَ أَخدانُ العُلى وَالمَناقِبِ",1,"ب",1,0],["وتُضيءُ في هَبَواتِهِ صَفحاتُهُمْ","كالفَجْرِ يخْطِرُ في رِداءِ ظَلامِ",2,"م",1,0],["وتُضيءُ أحْوَرَ يَسْتَفِزُّ إِلى الصِّبا","نِضْوَ المَشيبِ مُحالِفَ الإرْعاشِ",3,"ش",1,0],["وَتَضِجُّ النِساءُ مِن خَيفَةِ السَب","يِ وَتَبكي عَلى الصِغارِ اليَتامى",4,"م",2,0],["وتضطبنى الصواعق في غمود","وتقتص البوارق بالأهلهْ",5,"ل",2,0],["وَتَضْحَكُ مِنْ بَغْدَادَ بيضُ قِبَابها","إِذَا مَا تَرَاءَتْ بِالسَّوَادِ قِبَابِي",6,"ي",1,0],["وتضفو على أعطافه حُلَلُ الحُلي","مطهرة ما دَنَّسَتها المَعايِب",7,"ب",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ لَم يُفَلَّلِ",8,"ل",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ مُتَناعِمُ",9,"م",1,0],["وَتَضَنُّ دُهقانَ الكَلا","مِ كَضَنِّ دُهقانِ النُضارِ",10,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِه","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",11,"ل",1,0],["وتضتضي الخدمة أن أغدوا","جواده حيناً وأن أعدوا",12,"د",3,0],["وَتَضُجُّ أرْكَانْ المَحَطَّةِ كُلِّهَا","وَأُنَاسُهَا بِصِياحِ الاسْتِحْسَانِ",13,"ن",1,0],["وَتَضَعضَعَ الاِسلامُ يَومَ مُصابِهِ","فَالدينُ يَبكي فَقدَهُ وَالسُؤدُدُ",14,"د",1,0],["وتضمنت جزل الوقود حمولها","والنصر في التحقيق ما هي تحملُ",15,"ل",1,0],["وتضّوع النفحات منها مثله","تبينها للناس والتقرير",16,"ر",1,0],["وتضرب بالزعانف جانبَيْها","فتنقلب الظهور بها بطونا",17,"ن",2,0],["وَتُضيءُ في وَجهِ الظَلامُ مُنيرَةً","كَجُمانَةِ البَحرِيِّ سُلَّ نِظامُها",18,"م",3,0],["وَتَضَحْضَحَتْ حَوْلِي بحورٌ جَمَّةٌ","وأَبَى ابنُ إبراهيم أنْ يَتَضَحْضَحَا",19,"ح",2,0],["وتضاحك الروض الكئيب لصوبه","حتى تفتق نوره المرتوق",20,"ق",1,0],["وتَضييعَ مثليَ مالا يحلُّ","واللَّه يكره ما لا يَحلُّ",21,"ل",1,0],["وتضمنُ ذاك أعراقٌ كرامٌ","تهزُّك لي وأخلاقٌ سُهولُ",22,"ل",1,0],["وَتُضحي جِبالُ الرومِ غُبراً فِجاجُها","بِما أَشعَلَت غاراتُهُ وَمَقانِبُه",23,"ب",2,0],["وَتُضمِرُ حِقداً لِلمُحَدِّثِ لَو دَرى","بِهِ ذَلِكَ المِسكينُ ما كادَ يَهزُلُ",24,"ل",1,0],["وَتَضَعُ التاجَ عَلى رَأسِهِ","وَتَضَعُ الشَوكَ عَلى رَأسي",25,"ي",1,0],["وَتُضحي وَما ضَمَّت فُضولَ ثِيابِها","إِلى كَتِفَيها بِاِئتِزارٍ وَلا عَقدِ",26,"د",1,0],["وتُضاع البلاد بالنوم عنها","وتضاع الأمور بالإهمال",27,"ل",1,0],["وَتَضَوَّعَت مِنكَ الدُهورِ كَأَنَّما","في كُلِّ ناحِيَةٍ بَخورٌ يُحرَقُ",28,"ق",1,0],["وَتُضيءُ أَثناءَ الفَضاءِ بِغُرَّةٍ","لاحَت بِرَأسِ الطَودِ تاجاً أَزهَرا",29,"ر",2,0],["وَتُضاعُ البِلادُ بِالقَومِ عَنها","وَتُضاعُ الأُمورُ بِالإِهمالِ",30,"ل",1,0],["وتَضحكُ سِنُّ المرْءِ والقلبُ مُوجَعٌ","ويرضى الفَتَى عن دَهْرِهِ وهوَ عاتِبُ",31,"ب",1,0],["وَتَضرِبَهُم هَبراً وَقَد سَكَنوا الكُدى","كَما سَكَنَت بَطنَ التُرابِ الأَساوِدُ",32,"د",1,0],["وَتُضحي الحُصونُ المُشمَخِرّاتُ في الذُرى","وَخَيلُكَ في أَعناقِهِنَّ قَلائِدُ",32,"د",1,0],["وَتَضريبُ أَعناقِ المُلوكِ وَهامِها","لَكَ الهَبَواتُ السودُ وَالعَسكَرُ المَجرُ",33,"ر",1,0],["وَتَضرِطُ في لِحيَةِ الجاثِلي","قِ إِذا خارَ في سِفرِ شَعيا وَعَج",34,"ج",1,0],["وَتَضحَكُ عَن نَظمٍ مِنَ اللُؤلُؤِ الَّذي","أَراكَ دُموعَ الصَبِّ كَاللُؤلُؤِ النَثرِ",35,"ر",1,0],["وَتَضرِبُ أَقواماً صِحاحاً ظُهورُها","وَتَترُكُ حَقَّ اللَهِ في ظَهرِ مالِكِ",36,"ك",1,0],["وَتَضرِبُ حينَ تَضرِبُ لِلمَعالي","مَكانَ الجَوزِ مِن عَقدِ العِنانِ",37,"ن",1,0],["وَتُضرَبُ لي الأَمثالُ في كُلِّ نَظرَةٍ","وَقَد حَنَّكَتني الحادِثاتُ وَجَرَّبَت",38,"ت",1,0],["وَتَضعَفُ عَزمَةُ البيضِ المَواضي","وَتَقصُرُ هِمَّةُ الأَسَلِ الطِوالِ",39,"ل",1,0],["وَتَضَوَّرَ القَبرُ الَّذي أُسكِنتَهُ","حَتّى ظَنَنّا أَنَّهُ المَقبورُ",40,"ر",1,0],["وَتَضَوَّعَت مِسكاً وَسُرَّ فُؤادُها","فَسُرورُها بادٍ لِمَن يَتَوَسَّمُ",41,"م",1,0],["وَتَضَوَّعَ المِسكُ الذَكِيُّ وَعَنبَرٌ","مِن جَيبِها قَد شابَهُ كافورُ",42,"ر",1,0],["وتُضيمُ نفسَكَ وَهْيَ جِدُّ عزيزَةٍ","تحمي الحقيقة إن تحَفَّز واثبُ",43,"ب",1,0],["وَتُضحي غَضيضَ الطَرفِ دوني كَأَنَّما","تَضَمَّنَ عَينَيها قَذىً غَيرُ مُفسِدِ",44,"د",1,0],["وَتُضحي الجِبالُ الغُبرُ دوني كَأَنَّها","مِنَ الآلِ حُفَّت بِالمُلاءِ المُعَضَّدِ",44,"د",1,0],["وتضحكُ سِنُّ الحرْبِ وهي مَلِيّةٌ","لأبْطالها بالمأزِقِ المُتَجَهِّم",45,"م",1,0],["وتَضِجُّ أيْسارٌ ويَصْدَحُ شاربٌ","وتَرِنُّ سُمّارٌ ويَهْدِرُ جامل",46,"ل",1,0],["وتضوّعَ الكافورُ من أرْدانهمْ","عَبقاً فظنّوه عَجاجاً أشهبا",47,"ب",2,0],["وَتَضحَكينَ فَأَبكي","طَلاقَةً وَقُطوبا",48,"ب",2,0],["وَتَضحَكُ عَن بَرَدٍ بارِدٍ","تَلالى كَما لَمَعَ الوَحوحُ",49,"ح",1,0],["وَتُضِلُّ أَفعالُ الشُرورِ جُناتَها","وَتَفوزُ بِالخَيراتِ مُصطَنِعاتُها",50,"ت",3,0],["وَتَضِنُّ بِالشَيءِ القَليلِ وَكُلُّ ما","تُعطي وَتَملِكُ ما لَهُ مِقدارُ",51,"ر",1,0],["وَتَضؤُلُ فيهِ هَذي الشَمسُ حَتّى","تَعودَ كَأَنَّها دينارُ عَثرِ",52,"ر",1,0],["وَتَضرِبُ فِي الماءِ الَّذي كانَ آجِناً","إِذا أَورَدَ الرَاعِي النَضِيحَ المُجَيَّرا",53,"ر",2,0],["وَتضحك في الجلَّى وَتَبكي مصابها","بدمع كأمثال اللآلئ منهلِّ",54,"ل",1,0],["وتَضَاءَلَتْ أَجْرامُنا","فيها بمُوبِقةِ الجَرائِمْ",55,"م",1,0],["وَتَضَطَرِبُ السَّجيرَةُ بَيْنَ","أُنْمُلُتَيْكَ وَالثَّغْرِ",56,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِها","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",57,"ل",1,0],["وتضمّ أشباح الجياع كأنّها","سجن يضمّ جوانح السّجناء",58,"ا",2,0],["وتضْفُو على أعْطافِهِ حُللَ العُلا","مُطَهَّرة ٌ ما دَنَّستْها المعائب",59,"ب",1,0],["وَتَضْحَكُ عَنْ بَرَدٍ بَارِد","تَلاَلا كَمَا لَمَعَ الْوَحْوَحُ",60,"ح",1,0],["وتَضَوَّرتْ جُوعاً فلم تَرَ عنده","ما تأكُّلُ الأوغارُ والأوغام",61,"م",1,0],["وتضرط في لحية الجاثلي","يق إذا خار في سفر شعيا وعج",62,"ج",1,0],["وتضحي الجبال الحمر خلفي كأنها","من البعد حفت بالملاء المعضد",63,"د",1,0],["وتضوُّع النفحات منها مثله","تبيينها للناس والتقرير",64,"ر",1,0]]}