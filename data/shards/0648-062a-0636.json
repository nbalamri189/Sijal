رب"],[343,"فلسطين الشهيدة لن تضيعا","https://www.aldiwan.net/poem55388.html","الوافر"],[365,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[365,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[381,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[403,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[404,"محمد كم وعظت وما اتعظنا","https://www.aldiwan.net/poem33346.html","مجزوء الوافر"],[447,"سيعلم مرة حيث كانوا","https://www.aldiwan.net/poem23919.html","الوافر"],[459,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[462,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[462,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[466,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[480,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[501,"ولما أتينا أرض حيش وعندنا","https://www.aldiwan.net/poem37816.html","الطويل"],[501,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[516,"يا موقداً نار القرى للساري","https://www.aldiwan.net/poem12143.html","الكامل"],[539,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[539,"قد طال بي شوق إلى لقياكا","https://www.aldiwan.net/poem48000.html","عموديه"],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[552,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[559,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[568,"أنا أفدي التي تغدو","https://www.aldiwan.net/poem69590.html","مجزوء الوافر"],[568,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[570,"إن أبانا بكر آدم فاعلموا","https://www.aldiwan.net/poem52001.html","الطويل"],[576,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[576,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[576,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["وَتَضحَكُ نارُهُ وَضَحاً إِذا ما","رَغَت نارُ القَبائِلِ بِالدُخانِ",0,"ن",1,0],["وَتَضحَكُ عَنكَ الأَرضُ أُنساً وَغَبطَةً","وَتَبكيكَ أَخدانُ العُلى وَالمَناقِبِ",1,"ب",1,0],["وتُضيءُ في هَبَواتِهِ صَفحاتُهُمْ","كالفَجْرِ يخْطِرُ في رِداءِ ظَلامِ",2,"م",1,0],["وتُضيءُ أحْوَرَ يَسْتَفِزُّ إِلى الصِّبا","نِضْوَ المَشيبِ مُحالِفَ الإرْعاشِ",3,"ش",1,0],["وتضيع الشهب في موكبه","كخيالات المريض الساهر",4,"ر",1,0],["وَتَضِجُّ النِساءُ مِن خَيفَةِ السَب","يِ وَتَبكي عَلى الصِغارِ اليَتامى",5,"م",2,0],["وتضطبنى الصواعق في غمود","وتقتص البوارق بالأهلهْ",6,"ل",2,0],["وَتَضْحَكُ مِنْ بَغْدَادَ بيضُ قِبَابها","إِذَا مَا تَرَاءَتْ بِالسَّوَادِ قِبَابِي",7,"ب",2,0],["وتضفو على أعطافه حُلَلُ الحُلي","مطهرة ما دَنَّسَتها المَعايِب",8,"ب",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ لَم يُفَلَّلِ",9,"ل",1,0],["وَتَضحَكُ عَن غُرِّ الثَنايا كَأَنَّهُ","ذُرى أُقحُوانٍ نَبتُهُ مُتَناعِمُ",10,"م",1,0],["وَتَضَنُّ دُهقانَ الكَلا","مِ كَضَنِّ دُهقانِ النُضارِ",11,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِه","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",12,"ل",1,0],["وتضتضي الخدمة أن أغدوا","جواده حيناً وأن أعدوا",13,"د",3,0],["وَتَضُجُّ أرْكَانْ المَحَطَّةِ كُلِّهَا","وَأُنَاسُهَا بِصِياحِ الاسْتِحْسَانِ",14,"ن",1,0],["وَتَضَعضَعَ الاِسلامُ يَومَ مُصابِهِ","فَالدينُ يَبكي فَقدَهُ وَالسُؤدُدُ",15,"د",1,0],["وتضمنت جزل الوقود حمولها","والنصر في التحقيق ما هي تحملُ",16,"ل",1,0],["وتضّوع النفحات منها مثله","تبينها للناس والتقرير",17,"ر",1,0],["وتضرب بالزعانف جانبَيْها","فتنقلب الظهور بها بطونا",18,"ن",2,0],["وَتُضيءُ في وَجهِ الظَلامُ مُنيرَةً","كَجُمانَةِ البَحرِيِّ سُلَّ نِظامُها",19,"م",3,0],["وَتَضَحْضَحَتْ حَوْلِي بحورٌ جَمَّةٌ","وأَبَى ابنُ إبراهيم أنْ يَتَضَحْضَحَا",20,"ح",2,0],["وتضاحك الروض الكئيب لصوبه","حتى تفتق نوره المرتوق",21,"ق",1,0],["وتَضييعَ مثليَ مالا يحلُّ","واللَّه يكره ما لا يَحلُّ",22,"ل",1,0],["وتضمنُ ذاك أعراقٌ كرامٌ","تهزُّك لي وأخلاقٌ سُهولُ",23,"ل",1,0],["وَتُضحي جِبالُ الرومِ غُبراً فِجاجُها","بِما أَشعَلَت غاراتُهُ وَمَقانِبُه",24,"ب",2,0],["وَتُضمِرُ حِقداً لِلمُحَدِّثِ لَو دَرى","بِهِ ذَلِكَ المِسكينُ ما كادَ يَهزُلُ",25,"ل",1,0],["وَتَضَعُ التاجَ عَلى رَأسِهِ","وَتَضَعُ الشَوكَ عَلى رَأسي",26,"ي",1,0],["وَتُضحي وَما ضَمَّت فُضولَ ثِيابِها","إِلى كَتِفَيها بِاِئتِزارٍ وَلا عَقدِ",27,"د",1,0],["وتُضاع البلاد بالنوم عنها","وتضاع الأمور بالإهمال",28,"ل",1,0],["وَتَضَوَّعَت مِنكَ الدُهورِ كَأَنَّما","في كُلِّ ناحِيَةٍ بَخورٌ يُحرَقُ",29,"ق",1,0],["وَتُضيءُ أَثناءَ الفَضاءِ بِغُرَّةٍ","لاحَت بِرَأسِ الطَودِ تاجاً أَزهَرا",30,"ر",2,0],["وَتُضاعُ البِلادُ بِالقَومِ عَنها","وَتُضاعُ الأُمورُ بِالإِهمالِ",31,"ل",1,0],["وتَضحكُ سِنُّ المرْءِ والقلبُ مُوجَعٌ","ويرضى الفَتَى عن دَهْرِهِ وهوَ عاتِبُ",32,"ب",1,0],["وَتَضرِبَهُم هَبراً وَقَد سَكَنوا الكُدى","كَما سَكَنَت بَطنَ التُرابِ الأَساوِدُ",33,"د",1,0],["وَتُضحي الحُصونُ المُشمَخِرّاتُ في الذُرى","وَخَيلُكَ في أَعناقِهِنَّ قَلائِدُ",33,"د",1,0],["وَتَضريبُ أَعناقِ المُلوكِ وَهامِها","لَكَ الهَبَواتُ السودُ وَالعَسكَرُ المَجرُ",34,"ر",1,0],["وَتَضرِطُ في لِحيَةِ الجاثِلي","قِ إِذا خارَ في سِفرِ شَعيا وَعَج",35,"ج",1,0],["وَتَضحَكُ عَن نَظمٍ مِنَ اللُؤلُؤِ الَّذي","أَراكَ دُموعَ الصَبِّ كَاللُؤلُؤِ النَثرِ",36,"ر",1,0],["وَتَضرِبُ أَقواماً صِحاحاً ظُهورُها","وَتَترُكُ حَقَّ اللَهِ في ظَهرِ مالِكِ",37,"ك",1,0],["وَتَضرِبُ حينَ تَضرِبُ لِلمَعالي","مَكانَ الجَوزِ مِن عَقدِ العِنانِ",38,"ن",1,0],["وَتُضرَبُ لي الأَمثالُ في كُلِّ نَظرَةٍ","وَقَد حَنَّكَتني الحادِثاتُ وَجَرَّبَت",39,"ت",1,0],["وَتَضعَفُ عَزمَةُ البيضِ المَواضي","وَتَقصُرُ هِمَّةُ الأَسَلِ الطِوالِ",40,"ل",1,0],["وَتَضَوَّرَ القَبرُ الَّذي أُسكِنتَهُ","حَتّى ظَنَنّا أَنَّهُ المَقبورُ",41,"ر",1,0],["وَتَضَوَّعَت مِسكاً وَسُرَّ فُؤادُها","فَسُرورُها بادٍ لِمَن يَتَوَسَّمُ",42,"م",1,0],["وَتَضَوَّعَ المِسكُ الذَكِيُّ وَعَنبَرٌ","مِن جَيبِها قَد شابَهُ كافورُ",43,"ر",1,0],["وتُضيمُ نفسَكَ وَهْيَ جِدُّ عزيزَةٍ","تحمي الحقيقة إن تحَفَّز واثبُ",44,"ب",1,0],["وَتُضحي غَضيضَ الطَرفِ دوني كَأَنَّما","تَضَمَّنَ عَينَيها قَذىً غَيرُ مُفسِدِ",45,"د",1,0],["وَتُضحي الجِبالُ الغُبرُ دوني كَأَنَّها","مِنَ الآلِ حُفَّت بِالمُلاءِ المُعَضَّدِ",45,"د",1,0],["وتضحكُ سِنُّ الحرْبِ وهي مَلِيّةٌ","لأبْطالها بالمأزِقِ المُتَجَهِّم",46,"م",1,0],["وتَضِجُّ أيْسارٌ ويَصْدَحُ شاربٌ","وتَرِنُّ سُمّارٌ ويَهْدِرُ جامل",47,"ل",1,0],["وتضوّعَ الكافورُ من أرْدانهمْ","عَبقاً فظنّوه عَجاجاً أشهبا",48,"ب",2,0],["وَتَضحَكينَ فَأَبكي","طَلاقَةً وَقُطوبا",49,"ب",2,0],["وَتَضحَكُ عَن بَرَدٍ بارِدٍ","تَلالى كَما لَمَعَ الوَحوحُ",50,"ح",1,0],["وَتُضِلُّ أَفعالُ الشُرورِ جُناتَها","وَتَفوزُ بِالخَيراتِ مُصطَنِعاتُها",51,"ت",3,0],["وَتَضِنُّ بِالشَيءِ القَليلِ وَكُلُّ ما","تُعطي وَتَملِكُ ما لَهُ مِقدارُ",52,"ر",1,0],["وَتَضؤُلُ فيهِ هَذي الشَمسُ حَتّى","تَعودَ كَأَنَّها دينارُ عَثرِ",53,"ر",1,0],["وَتَضرِبُ فِي الماءِ الَّذي كانَ آجِناً","إِذا أَورَدَ الرَاعِي النَضِيحَ المُجَيَّرا",54,"ر",2,0],["وَتضحك في الجلَّى وَتَبكي مصابها","بدمع كأمثال اللآلئ منهلِّ",55,"ل",1,0],["وتَضَاءَلَتْ أَجْرامُنا","فيها بمُوبِقةِ الجَرائِمْ",56,"م",1,0],["وَتَضَطَرِبُ السَّجيرَةُ بَيْنَ","أُنْمُلُتَيْكَ وَالثَّغْرِ",57,"ر",1,0],["وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِها","نَؤومُ الضُحى لَم تَنتَطِق عَن تَفَضُّلِ",58,"ل",1,0],["وتضمّ أشباح الجياع كأنّها","سجن يضمّ جوانح السّجناء",59,"ا",2,0],["وتضْفُو على أعْطافِهِ حُللَ العُلا","مُطَهَّرة ٌ ما دَنَّستْها المعائب",60,"ب",1,0],["وَتَضْحَكُ عَنْ بَرَدٍ بَارِد","تَلاَلا كَمَا لَمَعَ الْوَحْوَحُ",61,"ح",1,0],["وتَضَوَّرتْ جُوعاً فلم تَرَ عنده","ما تأكُّلُ الأوغارُ والأوغام",62,"م",1,0],["وتضرط في لحية الجاثلي","يق إذا خار في سفر شعيا وعج",63,"ج",1,0],["وتضحي الجبال الحمر خلفي كأنها","من البعد حفت بالملاء المعضد",64,"د",1,0],["وتضوُّع النفحات منها مثله","تبيينها للناس والتقرير",65,"ر",1,0],["وتضييعك الحكم الإلهي بعد ما","نشأت به طفلاً وأرشدك المقري",66,"ر",2,0],["وتَضطَرِمُ جِذوَةُ الأحشَاءِ لَمَّا","أُذِنتَ بِقُربِ بَينِهِمُ أذَانَا",67,"ن",2,0],["وتَضحَكُ إعجَاباً بِمَن هِي مِنهُمُ","وَتَأنَفُ عَن نَظمِي وتَأنَفُ عَن نَثرِي",68,"ر",2,0],["وتضحضحت فرقاً بحورُ جيوشهم","لما أتاهم بحر جيشكَ مُزبدا",69,"د",2,0],["وتضلُ أمناً بالرباط خيولُه","ولها عجاجٌ بالحجازِ يُثارُ",70,"ر",1,0],["وتضحى حواليه المعالي ثباثباً","فهذى تناغيه وهذي تلاثمه",71,"م",2,0],["وَتُضحي بِحَيثُ العِزُّ عَودٌ لنابِه","صَريخٌ وَحَيثُ الجُودُ غَضٌّ غُرانِقُ",72,"ق",1,0],["وَتَضْيِيعُ رَأْيٍ فِي اصْطِنَاعٍ مَعَاشِرٍ","يُسَوِّدُ وَجْهَ الاِصْطِناع عُيُوبُهَا",73,"ب",3,0],["وتضايقت طرق المعا","ش فضاق ذرع فسيحه",74,"ح",2,0],["وتضعضعت أركانها لِحُلاحِلٍ","قد كان منها في ذُرى الأَهضاب",75,"ب",1,0],["وَتَضرِبُهُ الَوليدَةُ بِالهَراوى","فَلا غِيَرٌ لَدَيهِ وَلا نَكيرُ",76,"ر",1,0],["وتضاءل الأشخاص عنه ويستوي","في ظله الأقزام والجبار !",77,"ر",1,0],["وتضربُ مَن عاداك بالذّلِّ صاغراً","وتصحب من والاك بالعزّ والنصر",78,"ر",1,0],["وتضاءلت أحجارُه وأقلُّ ما","شكتِ الفِراقَ جنادل وصخور",79,"ر",1,0],["وتضوعت أردان بردته به","طيبا وطاب رداؤه وإزاره",80,"ر",2,0],["وَتَضاعَفَت بَرَكاتُها بِدُعائِهِ","فَلَها عَلى أُمِّ القُرى مثلانِ",81,"ن",1,0],["وَتَضُمُّنا بَعدَ النَوى","دارٌ لَهُم بِالرَقمَتَينِ",82,"ن",1,0],["وَتَضَاعَفَ الشَّوْقُ مِنَّا لِأَفْرَا","خٍٍ حِسَانٍٍ كَأَنْجُمِ الأَغْلاَسِ",83,"س",1,0],["وتضاحك القوم الطغاة لقوله","إني رسول الله جئت إليكم",84,"م",1,0],["وتضرعت للأله وطرفي","ساهر سامر الكواكب ساد",85,"د",1,0],["وتَضرطُ أربَعينَ إذا وَقَفنَا","على أهلِ المَجَالِسِ لِلسُّؤَالِ",86,"ل",1,0],["وَتضاحكت أَنواره وَتنوعت","أَزهاره حين ابتسمن كَمائمه",87,"م",2,0],["وَتَضَرَّمَتْ بَيْنَ الجَوَانِحِ لَوْعَةٌ","إِطْفاؤُها أَعْيَا عَلى الطُّوفانِ",88,"ن",1,0],["وَتَضَوَّعَتْ مِسْكِيَّةً فَكَأَنَّها","مِنْ نَشْرِ عِرْضِكَ أَوْ ثَنائِكَ تَنْفَحُ",89,"ح",1,0],["وَتَضحَكُ في حَدِّ أَسيافِهِ","ثُغورُ المَنونِ إِذا ما اِنتَضاها",90,"ا",3,0],["وَتَضَعضَعت أَركانُ كلِّ قبيلةٍ","وتشبَّه الأَذنابُ بالأَعرافِ",91,"ف",1,0],["وَتَضمّنت مِن نَسلهم نَسباً بهِ","عَبدُ السلامِ بن المشيشِ تَكنّفا",92,"ف",2,0],["وَتضلّعٌ بمواردِ الآراء بل","وَتشوّفٌ لِتصوّفٍ يتطلّعُ",93,"ع",1,0],["وتضرّع إليه في كل وقت","فإليه مصير كلّ مصير",94,"ر",1,0],["وتضاحكت مطرق الراس فكراً","في جمال عاف الحياة فناما",95,"م",2,0],["وتضيء أرجاء البسي","طة لا ذواء ولا شحوب",96,"ب",1,0],["وتضحكنا مبكيات الحياة","ونبكي على الضحكة الداوية",97,"ي",2,0],["وتضرب غير عابثة شهورا","وليس تود تشري أو تبيعا",98,"ع",2,0],["وتُضحي جِبالُ الثّلْجِ من دونِ عُشّه","وريحٌ كوقْعِ المَشْرفيِّ بَليل",99,"ل",1,0],["وتَضُمُّنا عرَبيّةٌ كرُمَتْ","أَعراقُها فَفُروعُها سُمُق",100,"ق",1,0],["وَتَضى بِراحَتِهِ الرِداء كَما","شَقَ الصَباح كَمائِم الزَهر",101,"ر",1,0],["وتَضحكْ مِلْءَ فيكَ ولَسْتَ تدري","بما يأتي به اليومُ العسيرُ",102,"ر",1,0],["وتضحك مِلْءَ فيك بلا احتشام","وهمك في شراب أو طعام",103,"م",1,0],["وَتُضحي بَينَهُم لَحماً عَبيطاً","يُقَسِّمُهُ المُقَسِّمُ بِالقِداحِ",104,"ح",1,0],["وتُضحي على الخِمْس لا تستري","بُ عَجرفَةً أن تَرى المَورِدا",105,"د",2,0],["وتضايقتْ خططٌ به فأباحها","خُدعاً قضيْنَ بمخلصٍ ونَجاءِ",106,"ا",2,0],["وتضمَّخوا دُفعَ الصَّديد وطالما","رَثَموا بكل لَطيمةٍ ذفْراءِ",106,"ا",2,0],["وتضعفُ عنه المرهفاتُ كأنما ال","صَوارم في الأيدي الشداد وشائعُ",107,"ع",1,0],["وتضمخ بالطيب المرفع قيمة","زباداً ومسكا تبتيا وعنبرا",108,"ر",2,0],["وتَضجُّ الأهوارُ غاباً من الموتِ","يُدَوِّي حتى يَضيقَ الخَناقُ",109,"ق",1,0],["وتضرم قلب حاسده احتفاظا","ويغبطه بها الخل الحميم",110,"م",1,0],["وتُضربُ أَكْبادُ النِّياقِ لبابِهِ","وتُجهدُ في المَسرى إليه جِمَالُهُ",111,"ل",2,0],["وتَضاعَفْ عند الضَّعيفِ حَناناً","فبهذا قد تُجْبَرُ الضُّعَفاءُ",112,"ا",2,0],["وتضمُّ منّي في القميص مهنّداً","وأضمّ منها بالنصيفِ السّمهري",113,"ر",2,0],["وتضرَعُنا بيضُ الظُّبا وهيَ أعينٌ","ونحطِمُها بالهامِ وهْي حَديدُ",114,"د",1,0],["وتضاعفت أبداً عليك ولا انقضت","بركات هذا الصوم والإفطار",115,"ر",1,0],["وتضيقُ بي الدنيا ورَحبُ فَضائِها","والنورُ في عَينىَّ منها يُظلِمُ",116,"م",1,0],["وتَضوَّعت مرَّاكشٌ مِسكاً بِكُم","لَو ضَاع مِن مِسكٍ شَذاً كشَذَاكا",117,"ك",2,0],["وتُضحِي رياضُ الحَزْنِ خُضْراً أريضةً","وَقد رويتْ كما اِشتهتْ مِن غمامِها",118,"م",3,0],["وَتَضاحكوا ولو اِنّهمْ علموا بما","تجني جهالتُهمْ عليهمْ أعْوَلوا",119,"ل",3,0],["وتضل الذي أرادت فسلم","أمرها فيك والزم التنزيها",120,"ي",3,0],["وَتُضْمِرُ وُدَّ عَاشِقَةٍ","وَتُظْهِرُ زُهْدَ مُنْحَرِفَهْ",121,"ف",2,0],["وَتَضَمَّنَتْ أَسْتَارُهَا لُعَبَاً","بِيْضَاً زُهَاءَ الحَلْقِ لاَ الخَرْطُ",122,"ط",1,0],["وَتضحك عرفان الدروع جلودنا","إِذا جاءَ يوم مظلم اللون كاسفُ",123,"ف",1,0],["وتُضمِرُ حُبِّي كلُّ ضامرةِ الحشَا","وتُنْعِمُ عيِشي كلُّ ناعمةِ الصَّبا",124,"ب",2,0],["وتَضحَكُ غِزْلانُ الفَلاةِ لأَنَّني","بعينيك لمَّا أَنْ نظرتُ فضحْتُها",125,"ت",3,0],["وتُضيءُ الطُّرقَ للسا","رينَ من ضوْءِ بهَائِكْ",126,"ك",1,0]]}