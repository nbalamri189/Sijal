{"poems":[[63,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[83,"فوق سهامك إن الله يهديها","https://www.aldiwan.net/poem61441.html","البسيط"],[137,"برء الإمام حياة الخلق كلهم","https://www.aldiwan.net/poem4214.html","البسيط"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79865","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118395","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129833","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137534",""],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45545","الكامل"],[123,"","https://poetry.dctabudhabi.ae/diwan/poem/73071","البسيط"]],"verses":[["بَرءٌ تدارَكَنا ونحنُ من الجوى","غَرقَى فأَوطأَنا رِقابَ السَّاحِلِ",0,"ل",1,0],["بُرءُ الوَزيرِ أَتى وَالفَتحُ يَعقُبُهُ","كَالشَمسِ جاءَت وَجاءَ الصُبحُ يَتلوها",1,"ه",2,0],["برءُ الإمامِ حياةُ الخلقِ كلهم","عمَّ السرورُ به وانثالتِ النعمُ",2,"م",1,1],["بُرءُ المشيرِ وفوزُ أرضٍ مسّها","بِشكاتهِ لا يشتكي المحضورُ",3,"ر",1,0],["بُرءٌ جلا ظُلَم الهموم كما بدا","وجهُ الضُّحى فجلا الدجى إسفاره",4,"ر",2,0],["برء السقيم إذا ما البرء أعضله","غوث الطريد إذا ما ريع أو وجما",5,"م",2,0],["بُرءٌ ولكنَّه منَّا لكل حشاً","حَوت على الودِّ قلباً غيرَ مُتّهمِ",6,"م",1,0],["برء لذي سقم سمع لذي صمم","نطق لذي بكم مرأى لكم عم",7,"م",1,0],["برءٌ كما آبَ الغمام الصيّبُ","فتراجعَ الروَضُ الهشيمُ المذنبُ",8,"ب",1,1],["برء أتى بخطابكم","فسرى إلى جسمي السقيم",9,"م",1,1],["بُرءٌ من السقم الطويل ضَمانُهُ","لا يستَوي سَقَمٌ بكم وصِحَاحُ",10,"ح",1,0],["بُرءُ الأَميرِ أَبي حَفصٍ تَداخَلَنا","سُرورُهُ فَرَأَينا النُّورَ أَنوارا",11,"ر",2,0]]}