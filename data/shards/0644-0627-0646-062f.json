{"poems":[[85,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[102,"الخضر المغمور","https://www.poetsgate.com/ViewPoem.aspx?id=50346",""],[102,"بلادي في المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=50369",""],[159,"يا ملبسي من ثياب صبري","https://www.aldiwan.net/poem55536.html","مخلع البسيط"],[202,"لأندب رسم دارهم المحيلا","https://www.aldiwan.net/poem51904.html","الوافر"],[234,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[234,"جارية مرهفة القد","https://www.aldiwan.net/poem51177.html","السريع"],[280,"لأندلس البشرى وحضرتها حمص","https://www.aldiwan.net/poem25492.html","الطويل"],[280,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[563,"لا ندرك الله دائما أبدا","https://www.aldiwan.net/poem34933.html","المنسرح"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64256","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71035","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76092","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4755,"مأساة سهيل اليماني كاملة","https://www.poetsgate.com/ViewPoem.aspx?id=211329",""],[4767,"خير الناس","https://www.poetsgate.com/ViewPoem.aspx?id=179651",""],[4985,"في فقد لؤي","https://www.poetsgate.com/ViewPoem.aspx?id=89206",""],[5431,"فلسطين-حق العودة","https://www.poetsgate.com/ViewPoem.aspx?id=197949",""],[5663,"نجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200904",""],[5694,"ياكاتب التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=132093",""],[5725,"كن في غيابة قلب من تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=212011",""],[5906,"أصالة","https://www.poetsgate.com/ViewPoem.aspx?id=188232",""],[6093,"سؤال يبحث عن جواب","https://www.poetsgate.com/ViewPoem.aspx?id=204280",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""]],"verses":[["لأندلسٍ ثكلٌ عليه مُرَدَّدٌ","له لبست سودَ المسوح نواحيها",0,"ي",3,0],["لا ندَّعي الفضلَ بل فينا لطائفةٍ","منهمْ أبو الصَّقر تسليمٌ وإذعان",1,"ن",1,0],["لا نَدِبُّ الضَراءَ يوماً ولا نط","لبُ سِلماً ونحن نبغي القتالا",2,"ل",2,0],["لأنّ دم ((الخضراء)) فيه معلّب","يذوب ندى ، يمشي حقولا إلى القرى",3,"ر",2,0],["لأن دار أبيها","لها مناف رهيبة",4,"ب",2,0],["لأنَّ دَمْعِي أَصابَ عَيْنِي","عَلَيْكَ لَمَّا بَكَتْ بِعَيْنِ",5,"ن",1,0],["لأندبُ رسم دارهم المحيلا","وأسالُ عنهم الريح البليلا",6,"ل",2,1],["لا ندَّعي ما ليس يَعْرِفه الورَى","منّا إذا كَذَبَ المُفاخرُ وادّعى",7,"ع",2,0],["لا نِدَّ في الحسن لها مثل ما","أّنّيّ في الحبِّ بلا نِدّ",8,"د",1,0],["لأنْدَلُسَ البُشْرَى وحَضْرَتِهَا حِمْص","فقَد كُسِيَتْ لِلأَمْنِ فَضْفاضَةُ القُمْصِ",9,"ص",1,1],["لأندَلُسَ البُشرى بِنَصْرِ خَليفَةٍ","ضَروبٍ بِنصْل السيف زاكي الضَرائِبِ",10,"ب",1,0],["لِأَنَّ داري لَم تَزَل دائِرَةً","تَجمَعُ مَن ضَلَّ السَبيلَ وَاِهتَدى",11,"د",2,0],["لا ندرك الله دائما أبدا","ولو جهدنا وكدنا التعبُ",12,"ب",1,1],["لا نِدَّ يَعدِلهُ وَكَم مِن مَجلِسٍ","أَشعارَ شَوقي النَدُّ في سَمَراتِهِ",13,"ت",2,0],["لأنَّ دخوله في النارِ أدنى","عذاباً من دخولِ النارِ فيه",14,"ه",1,0],["لا ندب فقديَ الكرامُ","تفديكِ روحي وانت روحي",15,"ي",1,0],["لا نَدَّعي أَنّها أَقصى نهاية ما","تُدْعى به عند أَهل العلم مذكورا",16,"ر",2,0],["لأَنَّ دائماً له انقضَا","ومثلُهُم ميخ الجُدَيِّ أَيضَا",17,"ض",2,0],["لانَ دَهراً ثُمَ اِغتَدى ذا اِنحِرافٍ","وَفشا السرُّ مُذ تَكرَّرتُ نَحوَه",18,"و",2,0],["لأنَّ دنياهم لآخرتهمْ","وذي لمولاهم وذي صفاتهمْ",19,"م",1,0],["لا نَدَّعِي الفَخرَ.. إِنَّا مَن إِذا ذُكِرُوا","رَنَا إِلى الأُفقِ مَزهُوًّا وحَيَّانا",20,"ن",2,0],["لإنْ دامَتْ سِهامُ القومِ تُرْمَى","نَدُمْ بين البلايا والثبورِ",21,"ر",1,0],["لإن دفنت جثمانه في ذرى الثرى","فروح لؤي في الجنان ترفرف",22,"ف",1,0],["لأنّ دموع الأنبياء صلاتها","على ذكرها ورْد الصلاة مهللُ",23,"ل",1,0],["لاَ نِدَّ في لغتي لهُ .. مُذْ لاحَ إِذْ","أتْلَفْتِني مَعْنايَ في أَنْ أُتْلَفَا",24,"ف",2,0],["لاندفع الجزيه ولاناخذ أحلاف","حليفنا اللي مايغطه منامه",25,"م",2,0],["لا ندري إن كنا له تبعا","للحب غاشية بنا أهوى",26,"و",2,0],["لا نُداري عَيبَها فينا وَندري","أنَّ بَعضَ العَيبِ لا نَقوى احتمالهْ",27,"ل",2,0],["لأنَّ دموعَهُ سالتْ فقالتْ :","فما بكَ يا خليليْ مثلُ ما بِي",28,"ب",2,0],["لأنَّ دماً يغلي تسيلُ قصائدي","سأُلبِسُ هذا الكونَ ثوب دمائيا",29,"ي",2,0]]}