{"poems":[[55,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[95,"هو يوم أغر مبتسم","https://www.aldiwan.net/poem11188.html","الخفيف"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[83,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199481","الخفيف"],[106,"يا أبا فيصل ( رثاء الملك فهد )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66479&r=&rc=27",""],[189,"نهاية ما سما لعلاك أرض","https://www.aldiwan.net/poem14562.html","الوافر"],[234,"ثلاثة أعياد تلاقين جمعة","https://www.aldiwan.net/poem51077.html","الطويل"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[353,"نصف شهبا قد أرسلتها أهلة","https://www.aldiwan.net/poem20225.html","الطويل"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[398,"علي الى أعلى الجمال تعالى","https://www.aldiwan.net/poem53456.html","الطويل"],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/31474","الوافر"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125398","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125427","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201560","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/58","الوافر"],[4613,"","https://poetry.dctabudhabi.ae/diwan/poem/101945","الطويل"],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""]],"verses":[["كَأَنَّ مُلوكَ الأَرضِ حَولَ سَريرِهِ","بُغاثٌ وُقوفٌ وَالقَطامِيُّ جالِسُ",0,"س",1,0],["كَانَ مِلْءَ العُيُونِ مَحْمَدَةً","فَهْوَ حَيٌّ بِكُلِّ إِنْسَانِ",1,"ن",1,0],["كَانَ مِلْءَ الحَيَاةِ فَهْيَ وَقَدْ وَلَّ","ى فَرَاغٌ تُحَسُّ فِيهِ المَنُونُ",2,"ن",1,0],["كأن مليكَ الفرسِ صوَّرَ نفسهُ","على جامها عمداً فمنْ يدنُ يسجُدِ",3,"د",1,0],["كَأَنَّ مُلِمَّ الرِزقِ طَيفٌ وَهِمَّتي","سُهادٌ وَلَيسَ الطَيفُ في السُهدِ يَطرُقُ",4,"ق",1,0],["كَأَنَّ مَلقى حَليِها فاثورُ","فيهِ اِبيِضاضٌ وَبِهِ تَحميرُ",5,"ر",1,0],["كانَ ملءَ العيون فهدٌ... فما","حِجّةُ عينٍ دُموعها لا تُراقُ؟!",6,"ق",1,0],["كانَ ملءَ العيون فهدٌ... فما","حِجّةُ عينٍ دُموعها لم تُراقُ؟!",7,"ق",1,0],["كأن ملوكَ أهلِ الأرض نَفْلٌ","إذا اعتمدوا الفَخار وأنت فَرْض",8,"ض",1,0],["كأن ملوك الأرض في الأرض ظلمةٌ","وأنت على الآفاق ضوءُ نهارِ",9,"ر",1,0],["كَأَنَّ مُلاءَ المَحضِ فَوقَ مُتونِها","تَرى الأُكمَ مِنهُ تَرتَدي وَتُنَطَّقُ",10,"ق",1,0],["كَأنَّ مَلِيكَ الأَرْضِ خَيَّمَ عِنْدَها","وَضَحَّى وَهَاتِيكَ البِقَاعُ مَجَازِرُ",11,"ر",1,0],["كأنّ ملائكةَ اللهِ فيه","رأوكَ فخَرُّوا له ساجِدينا",12,"ن",2,0],["كَأَنَّ ملاحَ الناسِ أَضحوا رَعِيَّةً","وَصارَ أَميرَ العالَمينَ جَمالا",13,"ل",2,0],["كَأَنَّ مُلاءَتَيَّ عَلى هِزَفٍّ","يَعُنُّ مَعَ العِشِيَّةِ لِلرِّئالِ",14,"ل",1,0],["كان ملء العين فى رونقه","والفؤادن الرحب فيما أضمَروا",15,"ر",3,0],["كأن مليك الفُرسِ صوَّرَ نفسَهُ","على هامهِ عمداً فمن يدنُ يسجدِ",16,"د",1,0],["كأن ملاك الحُسن أوقفَ ثَغرَها","عن النطقِ حتى لا تبوحَ فأهتدى",17,"د",2,0],["كأن ملاك وحيي َربُّ ذوق","فيهرب من مراسيم الحضور",18,"ر",1,0],["كانَ ملويّ السرى إلّا لَنا","فَلَوى عنّا اِلتفاتاً واِنثناءَ",19,"ا",2,0],["كأنَّ مُلأتُهُ مُدْبِراً","حريقُ الغَريفِ إذا ما استدارا",20,"ر",2,0],["كان ملوك الشرق إن حاولوا","ما يعجز الأنداد لم يخفقوا",21,"ق",3,0],["كَأَنَّ مِلاءَتي عَلى هِجَفٍّ","أَحَسَّ عَشِيَّةً ريحاً بَليلا",22,"ل",2,0],["كأن ملّت الدمع نائل احمد","وقد ملأ الآفاق غربا ومشرقا",23,"ق",2,0],["كأن ملتف الغصون عاشق","عانق معشوقا وراه الطلب",24,"ب",1,0]]}