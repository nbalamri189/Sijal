891","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91279","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95358","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133211","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72777","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72778","الكامل"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144245","الكامل"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140148",""],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4978,"رد على قصيدة فلسفتي والنسبية","https://www.poetsgate.com/ViewPoem.aspx?id=177283",""],[5111,"حُرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=212373",""],[5186,"محت الدهور الراسخات وقصرت","https://www.poetsgate.com/ViewPoem.aspx?id=156481",""],[5431,"أنين شوق....","https://www.poetsgate.com/ViewPoem.aspx?id=191398",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[402,"يا دار اهلك بالسلامة عادوا","https://www.poetsgate.com/ViewPoem.aspx?id=35471",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[242,"حبل الدنا يا مبتغيه رث","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563804",""],[147,"هَلْ لِلْخَلِيطِ الْمُسْتِقلِّ إِيَابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""]],"verses":[["فلحكمةٍ يخشى الجبابر بأسها","ويخاف لفتة عدلها الحساد",0,"د",1,0],["فلحظها فوق رأسها صُعُدٌ","ودمعها تحت رجلها صَبَب",1,"ب",1,0],["فَلَحِقنَ وَاِعتَكَرَت لَها مَدرِيَّةٌ","كَالسَمهَرِيَّةِ حَدُّها وَتَمامُها",2,"م",3,0],["فَلَحا الإِلَهُ أَبا خُزَيمَةَ وَاِبنَهُ","وَالخالِدينَ وَصاعِدَ بنَ عَقيلِ",3,"ل",1,0],["فلَحَوْه فيه فصار لجَاجاً","وهو شيخٌ يُراغِم الأعداءَ",4,"ا",2,0],["فلحاظٌ كوميض ال","برقِ في الأفق يُشامُ",5,"م",1,0],["فلحظات الريم","فقلق النسيم",6,"م",1,0],["فَلِحُسنِ وَجهِكَ في القُلوبِ مَحَلَّةٌ","خُصَّت إِلى جَذَلٍ بِها مُتَلَبِّسِ",7,"س",1,0],["فَلُحونُ العودِ والكاسُ لَنا","والندى وَالبَأسُ لِلمُعتَمَدِ",8,"د",1,0],["فَلَحِقنا نَفسَهُ","بِدَمٍ مُزَمَّلا",9,"ل",2,0],["فکلْحَقِ اليومَ بالكرام كريماً","والْقَهم بينَ جَنَّة ٍ وخُلود",10,"د",1,0],["فَلُحومُهُم لِلحائِماتِ مَطاعِمٌ","وَدِمائُهُم لِلمُرهَفاتِ شَرابُ",11,"ب",1,0],["فلحظك مظلوم بهذا وخدها","فلا تجزعن فاللحظ غير مكلم",12,"م",1,0],["فَلَحى اللَهُ مانِعَ الرَوعِ مِنّا","حَيثُ يَستَصحِبُ الضَئيلَ الضَئيلُ",13,"ل",1,0],["فلحميَ بفيها كل يوم معضّض","وصوفي بكفيها الغداة مزبّد",14,"د",1,0],["فلِحُسنِ حظي أنني لم أنصرف","حتى ظفرت بقبلةٍ وبموعد",15,"د",1,0],["فلحمي ليس تطبخه قدوري","وحوتي ليس تقليه المقالي",16,"ل",2,0],["فلحية التيس منه","وسلحة الفيل سني",17,"ن",2,0],["فَلَحاه اللَّه عنّي رجلاً","وَرَمى إبني بسهمٍ مِن وَتر",18,"ر",1,0],["فَلِحَضرَةِ الصِهرِ المَني","وَلِآلِهِ الحَظُّ الهَني",19,"ن",2,0],["فلَحى الله أنفُساً ترتضي العي","شَ إذا كان فيه ذُلُّ الرِّقابِ",20,"ب",1,0],["فلحظُك للديوانِ أيقِظْهُ يحترسْ","ولفظك للإيوان جرِّدهُ يقطعِ",21,"ع",1,0],["فلحاظُ عيني من دمٍ سَفكتْ","بعد النذير إليك في حِلِّ",22,"ل",1,0],["فلحاظه بين الجفون كأنَّها","قضب العزيز تشام بين صفوفه",23,"ف",2,0],["فلِحُسْنِ خطِّك قد رشق","ت لها على الخدين وسما",24,"م",2,0],["فلحاظها مكسورة لكنها","صرعت فؤاد المستهام العاني",25,"ن",2,0],["فلحرقة البين المشتت لوعة","والبين أعظم ما يكون وأصعب",26,"ب",1,0],["فلحظتُهُ أَمضى من السَّيف عندهم","وهيبتُهُ تُغني عن العُنفِ والزَّجرِ",27,"ر",1,0],["فلحى اللَه مستب","يحي حماهم وقد لحوا",28,"ح",3,0],["فلحظها مُطاعنٌ مُسايف","ولفظُها العيدانُ والمعازف",29,"ف",1,0],["فلحوزة الإسلام أحمى ناصر","ولنائب الرحمن أنصح نائبِ",30,"ب",1,0],["فَلحاظُ أَعيُنه الفواتر داؤهُ","وَرضابُ مبسمهِ اللذيذ دواؤهُ",31,"ا",3,0],["فلحظه لي صائد إذ ينتضى","بتاره هل في الجفون مشرفي",32,"ف",2,0],["فلحيدر ولأحمد نعم التقا","رن دام مشمولاً بسعدٍ خالدِ",33,"د",1,0],["فلحظ جفنيك قد تسنى","ورمح عطفيك قد تمرن",34,"ن",1,0],["فلحاظهن شرابهم وشرابهن","لحاظهم والأعين الأكواب",35,"ب",1,0],["فلحقتهُ وصديقَهُ مبتسِّماً","فَرِحاً لأنك قد طلبت الجَوهرا",36,"ر",2,0],["فَلَحا اللَهُ طالِبَ الصُلحِ مِنّا","ما أَطافَ المُبسِ بِالدَهناءِ",37,"ا",2,0],["فلحظت ما قد كنتُ قبل علمته","فعلمتُ أني لم أزل عن حالي",38,"ل",2,0],["فلحمد عدلك كل شخص شاكر","ولشكر فضلك كل شخص حامد",39,"د",1,0],["فلح في سماء العز بالسعد طالعاً","وقدرك سام افقه ليس يلحقُ",40,"ق",1,0],["فلحبك في قلبي وذكرك في فمي","وشخصك في عيني ومثاك في سري",41,"ر",2,0],["فلحضرة الباشا الهَنا بِشِفائه","وَبِهِ تَنال مَسَرة أَنجاله",42,"ل",2,0],["فلحقَّ أن أدمي الأكفَّ لفقده","أسفاً وأصفق باليمين يساري",43,"ر",2,0],["فلحظ هذا ولحظ ذاك وذا","لحظ محب بعين مكتسب",44,"ب",1,0],["فلحن ولكن لا يعيه سوى الحجا","وسكر ولكن لا كسكر ابنة الحان",45,"ن",1,0],["فلحن الطير وهو بلا انتظامٍ","يفوق نظام ألحان الأنام",46,"م",1,0],["فلحمي وما قد سيط باللحم من دمي","وجاهي وقدري من ثراك ومالي",47,"ل",2,1],["فَلُحتُ لَهُ خربت غفل وَمَجهَلٍ","يَضَلَّ لَدَيهِ النَّجمُ وَالقَشَمُ النَّكبُ",48,"ب",1,0],["فلحون عائشتي تبدد وحشتي","وتذود عن قلبي شجى أذواه",49,"ا",2,0],["فلحُبّكُمْ يا آل بيْتِ محمد","بيْنَ الجوانِحِ كُلّ قلْبٍ يجْنَحُ",50,"ح",1,0],["فلحْظُهُ يُزْري ببيضِ الظُّبا","وقدُّهُ يُزْري بسُمْرِ الرّماحْ",51,"ح",1,0],["فلُحْتُ كمِثْلِ الزُّهْرِ والزَّهْرُ في الرُبى","فمِنْ مُجْتنٍ يأتي على إثْرِ مُجْتَلِ",52,"ل",1,0],["فلُحُومُ ثِيرانٍ ونَضحُ دمٍ","وشحمُ الكَبشِ لم تَطلُبهُ من أَيدِي الوَرَى",53,"ا",1,0],["فَلحبّذا هِيَ غادة قَد آنست","وَلحبذا هَذا نَديم قَد سَقى",54,"ق",2,0],["فلحى الله الألى زعموا","أنك المعلوم بالنظر",55,"ر",1,0],["فَلَحاقَهُ الجَمُّ الغَفيرُ تَطَلَّبُوا","ذَاكَ الاَياسُ وَذا الأَياسُ كِلاهُما",56,"ا",1,0],["فَلَحِقنَهُ هُبّى وَقَد طَمِعَت","غَضبانُ ثاني الجيدِ أَخضَعُهُ",57,"ع",2,0],["فلحي ذو الهنات واحدٌ","وبهذا العصر هاك ألفٌ لحي",58,"ي",1,0],["فلحكمةِ فيها عليلاً ما ترى","غيرَ النسيمِ وغيرَ اجفانِ الظبا",59,"ا",1,0],["فلحكمة فيها عليلاً لا نرى","إلا النسيمَ وغيرَ أجفان الظِبا",60,"ا",1,0],["فلحوم أهل العلم سمت للجنة","عليهم فاحفظ لسانك وابعد",61,"د",1,0],["فلح في سماء الملك بدرا بنوره","يجدد من رسم الهداية ما اختلا",62,"ل",2,0],["فَلِحُلاَهُ بِحُلاَهُمْ غَلْثُ","وَلَهُ باِلْفُرُوثُ مِنْهُمْ غَبْثُ",63,"ث",1,0],["فلحكمة أمر الملائكَ ربُّهم","أن ينحنوا فلآدم منهم سجود",64,"د",1,0],["فَلُحْتِ كَمَا لاحَ فَجْرُ قَصِيدِيْ","فسَا حَ بِشَدْوِهِ نُوْرًا ترامى",65,"م",2,0],["فلحاتم الكرمآء ألف تحية","ولحافظ البؤسآء ألف سلام",66,"م",1,0],["فلحظة العشق عمر في حلاوتها","وضمة النار تنفي ربّ او لعسى",67,"س",2,0],["فَلَحِقْنا السَّرابَ حتّى مَلأنا","دونَ آفاقِنا الدُّروبَ عَجاجا !",68,"ج",2,0],["فلحكمة يخشى الجبابر بأسها","ويخاف لفتة عدلها الحسا",69,"س",2,0],["فَلَحِقتُ عُمْريْ أَستَفيئُ بِظلِّهِ","لِأَلوذ مِْنْ شَمسٍ لَهُ تَصلانيْ",70,"ن",2,0],["فَلِحُلاهُ بِحُلاهُم غَلثُ","وَلَهُ بِالفُروثِ مِنهُم غَيثُ",71,"ث",1,0],["فَلُحُومُهُمْ لِلْحَائِمَاتِ مَطَاعِمٌ","وَدِمَاؤُهَمْ لِلْمُرْهَفَاتِ شَرَابُ",72,"ب",1,0]]}