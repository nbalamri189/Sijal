{"poems":[[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[23,"جمحت بنو جمح لشقوة جدهم","https://www.aldiwan.net/poem21522.html","الكامل"],[51,"زعم الناس خالدا بغاء","https://www.aldiwan.net/poem7979.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[45,"هل فيكم من واقف متفرس","https://www.aldiwan.net/poem64600.html","الكامل"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[52,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[85,"سِرْ أَبا صالحٍ إلى الله واترك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9596&r=&rc=86",""],[144,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[161,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[165,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[187,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[198,"بأبي وأمي من مددت لها يدي","https://www.aldiwan.net/poem39903.html","الكامل"],[257,"فداؤك نفس عبد أنت مولى","https://www.aldiwan.net/poem48500.html","الوافر"],[257,"إذا تغني سليم","https://www.aldiwan.net/poem48545.html","المجتث"],[318,"بئسما ربيته من ولد","https://www.aldiwan.net/poem2033.html","الرمل"],[321,"ما لي أرى غصن الهنا","https://www.aldiwan.net/poem67127.html","مجزوء الكامل"],[410,"لو صبرنا على البلاء احتسابا","https://www.aldiwan.net/poem32055.html","الخفيف"],[433,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[465,"ما عند مهضوم الوشاح ضعيفه","https://www.aldiwan.net/poem3583.html","عموديه"],[576,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"]],"verses":[["فلحكمةٍ يخشى الجبابر بأسها","ويخاف لفتة عدلها الحساد",0,"د",1,0],["فلحظها فوق رأسها صُعُدٌ","ودمعها تحت رجلها صَبَب",1,"ب",1,0],["فَلَحِقنَ وَاِعتَكَرَت لَها مَدرِيَّةٌ","كَالسَمهَرِيَّةِ حَدُّها وَتَمامُها",2,"م",3,0],["فَلَحا الإِلَهُ أَبا خُزَيمَةَ وَاِبنَهُ","وَالخالِدينَ وَصاعِدَ بنَ عَقيلِ",3,"ل",1,0],["فلَحَوْه فيه فصار لجَاجاً","وهو شيخٌ يُراغِم الأعداءَ",4,"ا",2,0],["فلحاظٌ كوميض ال","برقِ في الأفق يُشامُ",5,"م",1,0],["فلحظات الريم","فقلق النسيم",6,"م",1,0],["فَلِحُسنِ وَجهِكَ في القُلوبِ مَحَلَّةٌ","خُصَّت إِلى جَذَلٍ بِها مُتَلَبِّسِ",7,"س",1,0],["فَلُحونُ العودِ والكاسُ لَنا","والندى وَالبَأسُ لِلمُعتَمَدِ",8,"د",1,0],["فَلَحِقنا نَفسَهُ","بِدَمٍ مُزَمَّلا",9,"ل",2,0],["فکلْحَقِ اليومَ بالكرام كريماً","والْقَهم بينَ جَنَّة ٍ وخُلود",10,"د",1,0],["فَلُحومُهُم لِلحائِماتِ مَطاعِمٌ","وَدِمائُهُم لِلمُرهَفاتِ شَرابُ",11,"ب",1,0],["فلحظك مظلوم بهذا وخدها","فلا تجزعن فاللحظ غير مكلم",12,"م",1,0],["فَلَحى اللَهُ مانِعَ الرَوعِ مِنّا","حَيثُ يَستَصحِبُ الضَئيلَ الضَئيلُ",13,"ل",1,0],["فلحميَ بفيها كل يوم معضّض","وصوفي بكفيها الغداة مزبّد",14,"د",1,0],["فلِحُسنِ حظي أنني لم أنصرف","حتى ظفرت بقبلةٍ وبموعد",15,"د",1,0],["فلحمي ليس تطبخه قدوري","وحوتي ليس تقليه المقالي",16,"ل",2,0],["فلحية التيس منه","وسلحة الفيل سني",17,"ن",2,0],["فَلَحاه اللَّه عنّي رجلاً","وَرَمى إبني بسهمٍ مِن وَتر",18,"ر",1,0],["فَلِحَضرَةِ الصِهرِ المَني","وَلِآلِهِ الحَظُّ الهَني",19,"ن",2,0],["فلَحى الله أنفُساً ترتضي العي","شَ إذا كان فيه ذُلُّ الرِّقابِ",20,"ب",1,0],["فلحظُك للديوانِ أيقِظْهُ يحترسْ","ولفظك للإيوان جرِّدهُ يقطعِ",21,"ع",1,0],["فلحاظُ عيني من دمٍ سَفكتْ","بعد النذير إليك في حِلِّ",22,"ل",1,0],["فلحاظه بين الجفون كأنَّها","قضب العزيز تشام بين صفوفه",23,"ف",2,0],["فلِحُسْنِ خطِّك قد رشق","ت لها على الخدين وسما",24,"م",2,0]]}