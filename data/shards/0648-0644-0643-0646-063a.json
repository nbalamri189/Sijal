{"poems":[[90,"بدا وجه العروبة في حلوك","https://www.aldiwan.net/poem45038.html","الوافر"],[72,"بروحي من أسميها بستي","https://www.aldiwan.net/poem42991.html","الوافر"],[30,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[52,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[52,"أخي أنت النصيح فلا تلمني","https://www.aldiwan.net/poem64798.html","الوافر"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[185,"ألا طرقت أميمة بعدض هدء","https://www.aldiwan.net/poem58888.html","الوافر"],[190,"يفوت العطاش المزن وهي حوافل","https://www.aldiwan.net/poem43873.html","الطويل"],[228,"رفينا تعالي كأس خمر ونارة","https://www.aldiwan.net/poem41628.html","الطويل"],[228,"ثملت بشدوك يا بلبل","https://www.aldiwan.net/poem41630.html","المتقارب"],[228,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[369,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[409,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[412,"وما عشقي له وحشا لأني","https://www.aldiwan.net/poem50191.html","البسيط"],[567,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110352","الوافر"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78006","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89547","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204477","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203009","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45232","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83467","الطويل"],[3591,"أنيخوا مطاياكم غداة نودع","https://www.poetsgate.com/ViewPoem.aspx?id=149422",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5187,"حوار مع القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29064",""]],"verses":[["ولكن غشّه الحلفاء حتّى","أتوه من الثعالب في مسوك",0,"ك",1,0],["وَلكِن غادَةٌ مَلَكَت جِهاتي","فَلا لَحنٌ إِذا ماقُلتُ سِتّي",1,"ت",2,0],["وَلَكِن غَلَبتَ الناسَ أَن تَتبَعَ الهَوى","وَفاءً يَروقُ العَينَ مِن كُلِّ رائِقِ",2,"ق",1,0],["وَلَكِن غَلَبَ الحُبُّ","عَزائي فَتَمادَيتُ",3,"ت",1,0],["وَلَكِن غِبتُ في بَلَدٍ بَعيدٍ","وَبَعدَ الجَهدِ ما كانَ الإِيابُ",4,"ب",1,0],["ولكنّ غدر الحاقدين رمى به","إلى السجن فهو اليوم في السجن مُودَع",5,"ع",1,0],["ولكن غَيرُ جَافيةٍ فَتُقلى","ثقالُ المَشىِ ذَاتُ حَشاً خَميصِ",6,"ص",1,0],["ولكن غنى نفس الكريم هو الغنى","عن الناس حتى ينقضي آخر الدهر",7,"ر",1,0],["وَلكِن غَداً لا تذكري الزَهر وَالرُبى","وَلا ياسمين الحَقلِ ما بَعدَ مَغربِ",8,"ب",1,0],["وَلكِن غَداً حينَ أُمسي رفاتاً","وَيَحجبُني قَبرِيَ المُقفَلُ",9,"ل",1,0],["وَلكِنَّ غيمَ الجَهلِ لاصِقَ نورَها","فَحَجَّبَها عن كُلِّ عينٍ لَصيقُها",10,"ق",3,0],["ولكنْ غَمامٌ جادَ عِطْفَكَ صَوْبُهُ","غَمامٌ بما يَأْتِي من الجودِ غانِم",11,"م",1,0],["ولكن غريب الدار من غاب شكله","وخلفه من بعده وتقدما",12,"م",2,0],["وَلَكِن غِرتُ أَن أَهوى مَليحاً","وَكُلُّ الناسِ يَهوونَ المَليحا",13,"ح",2,0],["ولكنْ غريمي يَقبلُ العُذرَ راثياً","لضُعفي فيأبى أن يُعامِلَ بالعُسْرِ",14,"ر",1,0],["ولكن غارتِ الأَقمارُ لمَّا","تجلَّى وجهُ روزا الصالحيَّه",15,"ي",2,0],["ولكن غِذاها رِسلُ عوذٍ بهازِر","مُوَرَّثَةٍ من كلِّ كوماءَ ضمعَجِ",16,"ج",1,0],["ولكن غفلة شملت وعمت","لها الإسلام أصبح كالغريب",17,"ب",1,0],["وَلكِن غَمامٌ مِن نَداكَ أَظَلَّني","فَأَخضَلتُ فيه وَالزمانُ مَحيلُ",18,"ل",1,0],["ولكن غادري الجسم اختلاساً","ولا تدعيه يعلم ما فعلت",19,"ت",1,0],["ولكنّ غوص البحر يبغي مغامراً","ولا يتقي غمر المياه سوى الغمر",20,"ر",1,0],["وَلكِن غَذاكَ المُشرِكونَ وَزاحَمَت","قَفاكَ وَخَدَّيكَ البُظورُ العَوارِدُ",21,"د",1,0],["ولكن غدت معذورة اذ تجاسرت","فيأخذها حسن الوجوه فتتبعُ",22,"ع",1,0],["ولكن غلوكس ثم انثنى","وعاد فأعمل شهب القنا",23,"ن",2,0],["وَلَكِن غَذَتها بأَلبانِها","ضُروعٌ يَحُفُّ بِها جَدوَلانِ",24,"ن",1,0],["وَلكن غَريب القَوم من لم يجد له","نَظيراً مثيلاً لا أَماماً وَلا خلفا",25,"ف",2,0],["ولكن غدت معذورة إذ تجاسرت","فيأخذها حسن الوجه فتتبعُ",26,"ع",1,0],["ولكن غوى فينا فأغوى نفوسنا","وللإبن من معنى أبيه نصيب",27,"ب",1,0],["ولكنْ غير واحدةٍ","بدنيا الحبِّ ما وَسِعا",28,"ع",2,0]]}