بسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42693","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54991","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54739","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55121","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54973","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141996","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43732","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[13,"أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","https://www.poetsgate.com/ViewPoem.aspx?id=180772",""],[13,"أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180813",""],[45,"كَيْفَ بِهِ، وَالزّمانُ يَهْرُبُ بِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31551",""],[45,"من قَضَاءِ الحُقوقِ فِي بَعضِ مَا عارَضَ","https://www.poetsgate.com/ViewPoem.aspx?id=31138",""],[45,"في الشَّيبِ زَجْرٌ لهُ، لوْ كانَ يَنزَجِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31278",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[85,"خُذوا القمَّة َ علماً وبيانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9587&r=&rc=77",""],[87,"أبعدَ ستينَّ لى حاجٌ فأطلبها ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23813&r=&rc=75",""]],"verses":[["أَبَعدَ القِبابِ اللاءِ زُلنَ عَنِ الحِمى","أُراعي الهَوى في أَربُعٍ وَمَغانِ",0,"ن",1,0],["أَبَعدَ الأَسى عادَ عيدُ الغَرامِ","وَقَرفٌ مِنَ الشَوقِ بَعدَ اِندِمالِ",1,"ل",1,0],["أَبعُدُ عَنهُ وَهوَ عَ","نّي في البِلادِ سائِلُ",2,"ل",1,0],["أَبَعدَ الطَوالِ الشُمِّ مِن آلِ عامِرٍ","إِلى البيضِ وَالأَدراعِ وَالخَيلِ وَالنَدي",3,"د",2,0],["أَبَعدَ النَبيِّ وَالوَصيِّ تَروقُني","مُناسِبُ مَن يُعزى لِمَجدٍ وَيُنسَبُ",4,"ب",1,0],["أَبَعدَ ما قَد صِرتَ أُحدوثَةً","بِالنُسكِ مِثلَ الحَسَنِ البَصري",5,"ر",2,0],["أبْعدَ سُرى الرّكْبِ الحِجازيّ موْهِناً","أمُدُّ لنَفْسي في تَعَلُّلِها مَدّا",6,"د",2,0],["أَبَعدَ عُثمانَ أَبغي مَأرَباً حَسَناً","مِنَ الحَياةِ وَحَظّاً غَيرَ مَنكودِ",7,"د",1,0],["أَبَعدَ حِيادٍ لا رَعى اللَهُ عَهدَهُ","وَبَعدَ الجُروحِ الناغِراتِ وِئامُ",8,"م",1,0],["أَبعَث إِلَيكَ بِلَفحَةٍ","حَرّى بِها تَجري السَمومُ",9,"م",1,0],["أَبعدَ مُقامي في دَباوَندِ أَبتَغي","دِمَشقَ لَقَد حاوَلتُ عَنقاءَ مُغرِبِ",10,"ب",1,1],["أَبَعدَ الحارِثِ المَلِكِ اِبنِ عَمروٍ","وَبَعدَ الخَيرِ حُجرٍ ذي القِبابِ",11,"ب",1,0],["أَبَعدَ الحارِثِ المَلِكِ بنِ عَمروٍ","لَهُ مُلكُ العِراقِ إِلى عُمانِ",12,"ن",1,1],["أَبعِد اِبنِ لَيلى يَأَمَلُ الخُلدَ واحِدٌ","مِنَ الناسِ أَو يَرجو الثَراءَ مُثمِرُ",13,"ر",1,0],["أَبَعدَ اِبنِ عَمروٍ مِن آلِ الشَريدِ","حَلَّت بِهِ الأَرضُ أَثقالَها",14,"ل",3,0],["أبعدني اليوم فهلا اقتضى","في غير هذا اليو أبعادي",15,"د",2,0],["أَبَعدَ مِصرِ وَبَعدَ مُطَّلِبِ","تَرجو الغِنى إِنَّ ذا مِنَ العَجَبِ",16,"ب",1,1],["أَبَعدُ الصَفاءِ وَمَحضِ الإِخاءِ","يُقيمُ الجَفاءُ بِنا يَحطُبُ",17,"ب",1,0],["أَبعَضتُ فيهِ أَحِبَّتي","وقَلَيتُ أهلي وَالوَطَن",18,"ن",1,0],["أَبَعدَ هُمَامِ قَومِكِ ذي الأَيَادي","أَبي الوَضَّاحِ رَتَّاقِ الفُتُوقِ",19,"ق",1,0],["أبعد الدهر في الفضاء مكرّه","عالقاً في مكرّه بالمجرةّ",20,"ر",2,1],["أَبَعدَ بَني بَدرٍ وَأَسلابِ جارِكُم","رَضيتُم بِضَيمٍ وَاِحتَبَيتُم عَلى وِترِ",21,"ر",1,0],["أَبِعتَ بَيتَكَ إِذ عَضَّتكَ مُجحِفَةٌ","مِنَ السِنينَ عَوانٌ ذاتُ أَضراسِ",22,"س",1,0],["أَبَعدَ تَرامينا ثَلاثينَ حِجَّةً","فَقَد صِرتَ يا اِبنَ القَينِ لا تُدرِكُ التَبلا",23,"ل",2,0],["أَبَعدَ اِبنِ ذَيّالٍ تَقولُ مُجاشِعاً","وَأَصحابَ عَوفٍ يُحسِنونَ التَكَلُّما",24,"م",2,0],["أَبَعدَ الأَربَعينَ مُجَرَّماتٌ","تَمادٍ في الصَبابَةِ وَاِغتِرارُ",25,"ر",1,0],["أَبَعدَ قَتيلٍ بِالمَدينَةِ أَظلَمَت","لَهُ الأَرضُ تَهتَزُّ العَضاهُ بِأَسوُقِ",26,"ق",1,1],["أبعد بني شادٍ وقد سكنوا الثرى","قريض لشادٍ أو سرور لفارح",27,"ح",1,0],["أبعد ملوك العلم والبأس والندى","تشب العلى نار القرى والقرائح",27,"ح",1,0],["أبعدَ إحرازِك أيمانَنا","هاربْتَنا واعتذر الحاجبُ",28,"ب",1,0],["أبعدَ المكنَّى بالحسين شهيدكم","تُضيء مصابيحُ السماء فَتُسْرَجُ",29,"ج",1,0],["أبعد ما كنتِ باب مبتهجٍ","للنفس أصبحتِ باب معتبرِ",30,"ر",1,0],["أبعْدَ ما اقتطعوا الأموال واتخذوا","حدائقاً وكروماً ذاتَ تعريش",31,"ش",1,0],["أبعد لقاي دونك كلَّ قفرٍ","يعزُّ الشخص فيه أن يُلاقى",32,"ق",2,1],["أبِعَقْل المُعلّمين يُعابُ ال","شعرُ أيري في القعر من بظر أمِّك",33,"ك",1,0],["أَبَعدَ اِبنِ عُجرَةَ لَيثِ الرِجا","لِ أَمسى كَأَن لَم يَكُن ذا نَفَر",34,"ر",1,0],["أَبعَثُ الشِعرَ إِلى الدُنيا هَوى","وَضِياءً وَغِناءً شَيِّقا",35,"ق",2,0],["أَبَعدَكَ يَعرِفُ الصَبرَ الحَزينُ","وَقَد طاحَت بِمُهجَتِهِ المُنونُ",36,"ن",1,1],["أَبَعدَكَ يا أَخي أَبغي عَزاءً","إِذا شُلَّت يَسارِيَ وَاليَمينُ",36,"ن",1,0],["ابعد دخيلا لم يكن من فعله","يوما اليه الشعب بالمرتاح",37,"ح",1,0],["ابعث لسلمان ومطرا","ن بها مشتركه",38,"ك",2,0],["أبعد شباب قد تجمّل بالهدى","يُلاح لشيبي بالضلال فيتبع",39,"ع",1,0],["اِبعَثوها سابِقاتٍ نُجُبا","تَملَأُ المِضمارَ مَعنىً وَعِيانا",40,"ن",2,0],["أَبَعدَ الساعونَ يَبغونَ المَدى","وَالمَدى في المَجدِ دانٍ لِنَفَر",41,"ر",1,0],["أَبَعدَ بَلائِهِم في كُلِّ حَربٍ","وَضَربٍ في المَمالِكِ أَيِّ ضَربِ",42,"ب",1,0],["أَبَعدَ العُروَةِ الوُثقى وَصَفٍّ","كَأَنيابِ الغِضَنفَرِ لَن يُراما",43,"م",2,0],["أَبعَدُ نَأيِ المَليحَةِ البَخَلُ","في البُعدِ ما لا تُكَلَّفُ الإِبلُ",44,"ل",1,1],["إِبعِد بَعِدتَ بَياضاً لا بَياضَ لَهُ","لَأَنتَ أَسوَدُ في عَيني مِنَ الظُلَمِ",45,"م",1,0],["أبعدي فالسلوُّ أجمل عندي","من حضور البكا على الغُيّاب",46,"ب",1,0],["أبعينِ مفتقرٍ إليكَ نظرَتَني","فأهنَتني وقذَفتني من حالِقِ",47,"ق",1,1],["أبعدَ وُضوح الحقِّ يرجونَ فسخَهُ","وللحقِّ عَقْدٌ مُبرَمٌ ليس يُفْسَخُ",48,"خ",1,0],["أَبَعدَ الشَبابِ المُنتَضى في الذَوائِبِ","أُحاوِلُ لُطفَ الوُدِّ عِندَ الكَواعِبِ",49,"ب",1,1],["أَبَعدَ إِعطائِكَ الجَزيلَ وَئيما","نِ مُرَجٍّ مِن سوءِ مُنقَلَبِه",50,"ب",2,0],["أَبَعدَ أَسبابٍ مِتانِ القُوى","مِن فَرطِ شُكرِ سائِرٍ وَاِمتِداح",51,"ح",1,0],["أَبَعدَ عِشرينَ شَهراً لا جَدىً فَيُرى","بِهِ اِنصِرافٌ وَلا وَعدٌ فَيُنتَظَرُ",52,"ر",1,0],["أَبعَدَتني مِن أَن أَجيأَكَ سَعياً","وَبِكُرهي أَلّا أَجيأَكَ رَكضا",53,"ض",2,0],["أَبَعدَ مَسرايَ إِن رُمتُ النُزولَ عَلى","حَيٍّ بِحَيثُ جِبالُ الثَلجِ تَأتَلِقُ",54,"ق",1,0],["أَبَعدَ مُبَشِّرٍ وَأَبي عُبَيدٍ","وَمَعيُوفِ المَكارِمِ وَالمَعالي",55,"ي",1,1],["أَبَعدَ ما أَعلَقَ الأَقوامُ مَيسَمَهُم","بِصَفحَتي وَقَتَلتُ الأَرضَ عِرفانا",56,"ن",2,0],["أَبَعدَ الَّذي حَطَّمتَ عَنّي وَبَعدَما","رَأَيتُ المَنايا فَوقَ عَينَيَّ تَلتَقي",57,"ق",2,0],["أَبَعدَ نَوارٍ آمَنَنَّ ظَعينَةً","عَلى الغَدرِ ما نادى الحَمامَ هَديلُها",58,"ل",3,0],["أَبَعْدَ ما انْهَدَّ عُمري في محاسِنه","حتى وَهَى بحُلولِ الشَّيْبِ جائبُه",59,"ب",2,0],["أَبعَدوهُ أَسحَقوهُ","أَوحَدوهُ أَفرَدوهُ",60,"و",2,0],["أَبعَدتُ عَن أَرضِ العِراقِ رَكائِبي","مُتَنَقِّلاً كَتَنَقُّلِ الأَفياءِ",61,"ا",2,0],["أَبَعدَ ما شاعَ أَنَّني لَكُمُ","عَبدٌ مُطيعٌ في القَولِ وَالفِعلِ",62,"ل",1,0],["أَبَعدَ غِياثِ الدينِ يَطمَعُ صَرفُهُ","بِصَرفِ خِطابِ الناسِ عَن ذَمِّ خَطبِهِ",63,"ب",2,0],["أَبعَدَ عَبدِ اللَهِ بَحرِ النَدى","لِزَلَّةِ الأَيّامِ مِن غافِرِ",64,"ر",1,0],["أَبعَدتُموني بِالنَوالِ فَاِغتَدى","شَوقي مُقيمي وَالحَياءُ مُقعِدي",65,"ي",1,0],["أَبعَدتُ عَن أَرضِ العِراقِ رَكائِبي","عِلماً بِأَنَّ الحَزمَ نِعمَ المُقتَنى",66,"ن",2,0],["أبعث الآن اعتذاري وأنا","حاضر بالقلب والروح معك",67,"ك",1,1],["أبعد جوار هندٍ والأماني","أُكابد جيرة النجم المُطِلّ",68,"ل",1,0],["أبعد أنسياتِ الهوى أقطعُ الفلا","ويسنحُ لي منْ وحشها الجأبُ والرّالُ",69,"ل",1,0],["أَبعَدَ مِن أَينٍ وَمِن لَغوبِ","مِنها غَداةَ الشارِقِ المَهضوبِ",70,"ب",1,0],["أَبَعدَ الَّذي ما بَعدَها مُتَلَوَّمٌ","عَلَيكَ لِحُرٍّ قُلتَ أَنتَ جَهولُ",71,"ل",1,0],["أَبَعدَني اللَهُ إِذ مَنَحتُكُمُ","وُدّي وَأَصفَيتُكُم وَأَسحَقَني",72,"ي",1,0],["أَبِعِلمٍ أَتَيتَ ما جِئتَ مِنّي","عَمرَكَ اللَهَ سادِراً أَم بِظَنِّ",73,"ن",1,0],["ابعثِ الطّرفَ في جنودك واسأل","أين حامي اللّواءِ في كلّ مأزِمْ",74,"م",1,0],["أَبعدَ الأربعين يُجيب ثاوٍ","فيحمل عاصفُ الرّيحِ الجوابا",75,"ب",2,0],["أبعدَ العِلم شَكٌّ بل ضللتم","على عِلْمٍ وذلكمُ الغُلولُ",76,"ل",1,0],["إبعثِ التمرَ على العيرِ لها","من سجاياك العُلَى حادٍ غَرِدْ",77,"د",1,0],["إبعثِ النُّورَ في الممالكِ يهدِي","كُلَّ شَعبٍ غَوَى ويمحو الظّلاما",78,"م",2,0],["أَبَعدَ غَداةِ الأَزدِ تَطمَعُ أَن تَرى","لِقَومِكَ يَوماً ثَمَّ غَيرَ ذِميمِ",79,"م",1,0],["أَبَعدَ قَتيلِ العَوصِ آسى عَلى فَتاً","وَصاحِبِهِ أَو يَأمَلُ الزادَ طارِقُ",80,"ق",1,1],["أَبَعدَ النُفاثيِّنَ أَزجُرُ طائِراً","وَآسى عَلى شَيءٍ إِذا هُوَ أَدبَرا",81,"ر",2,0],["أبَعْدَ التماحي التّاجَ مِلء محاجري","يَلوكُ أديمي من فم الدهر لائك",82,"ك",1,0],["أَبعَدَ اللَهُ يا سُلَيمانُ قَلبي","هُوَ أَيضاً يَهوى بِغَيرِ حِسابِ",83,"ب",1,0],["أَبَعدَ سِربالِ اِمرِئٍ عالِمٍ","أَصبَحتَ في سِربالِ مُرّاقِ",84,"ق",1,0],["أَبَعدَ خَمسينَ تَكَمَّلتَها","تَبكي عَلى اِستٍ المُسمِرِ العادي",85,"ي",1,0],["أَبَعدَ عُبَيدَةَ الحَوراءِ تَصبو","إِلى أُنثى فَقَدتُكَ مِن فُؤادِ",86,"د",1,0],["أُبعُد مِنَ الناسِ تَطرَح ثِقلَ أُلفَتِهِم","وَلا تُرِد لَكَ أَعواناً وَأَنصارا",87,"ر",2,1],["أبَعْدَ حَوْلٍ تُناجي الشّوْق نَاجيةٌ","هَلاّ ونحنُ على عَشْرٍ من العُشَرِ",88,"ر",1,0],["أَبَعدَ بَني عَمروٍ وَرَهطي وَإِخوَتي","أُرَجّي لَيانَ العَيشِ وَالعَيشُ ضَلّالُ",89,"ل",1,0],["أَبَعدَ فَوارسَ يَومَ الشُرَي","فِ آسَى وَبعدَ بَني الأَشهَبِ",90,"ب",1,0],["أَبِعيْنَيْهِ عَمىً عنكُمْ كَما","صَمَمٌ عن عَذْلِهِ في أُذُنَي",91,"ي",1,0],["أبعدما أنا تحت","التراب في القبر أبلى",92,"ل",2,0],["أبعد خراب الملك وا ذلّ أَهله","تُهيِّئ إصلاحاً له أَو تؤمل",93,"ل",1,0],["أَبعد بني قومي أنهنه عبرتي","وأَمنعها إني اذا لَبَخيل",94,"ل",1,0],["إبعدي من وراء نافذتي الآ","نَ ورفقاً إذا انثنيتِ ومهلا",95,"ل",2,0],["أَبَعْدَ عُثْمانَ تَرْجُو الخَيْرَ أُمَّتُهُ","وكانَ آمنَ مَنْ يَمْشِي على ساقِ",96,"ق",1,1],["أُبَعِّدُ عَنكِ النَفسَ وَالنَفسُ صَبَّةٌ","بِذِكرِكِ وَالمَمشى إِلَيكِ قَريبُ",97,"ب",1,0],["أَبَعْدَ سِتِّينَ لِي حَاجٌّ فَأَطْلُبهَا","هَيْهَ