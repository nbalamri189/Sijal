{"poems":[[396,"الحمدلله حمدا كل آن","https://www.aldiwan.net/poem54458.html","عموديه"],[396,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[396,"لأنها اوزار فيها الضرر والأضرار","https://www.aldiwan.net/poem54523.html","عموديه"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136246","الرجز"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108425","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100439","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67981","الكامل"],[5002,"قطرات النّدى","https://www.poetsgate.com/ViewPoem.aspx?id=202369",""],[5111,"مُدُنِ الأحْلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=212375",""],[520,"قدك مثل الغصن في اعتداله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577613",""]],"verses":[["ذا فصل والثاني اسمع يافلان","إن كنت تسمع لقول الناصحين",0,"ن",1,0],["ذا فضل والثاني اسمع يااللبيب النديم","تعلم العلم إن العلم نعم الحميم",1,"م",1,0],["ذا فصل والثان","بانطلب عظيم الشان",2,"ن",1,0],["ذا فيه يبدي شاهدا","وذاك يخفي ما معه",3,"ع",2,0],["ذا فؤاد على الولاء مقيم","وأبى الحب ان يكون خؤونا",4,"ن",2,0],["ذَا فِي كَثَافَةِ طَبعِهِ وَظَلاَمِهِ","وَبِظُلمَةِ التَّعطِيلِ هَذَا الثَّانِي",5,"ن",2,0],["ذا فعل ماضي لحظه في كدي","أمضى من العضب الجراز وأحد",6,"د",1,0],["ذا فيصلٌ كم فُصِّلت من حردِه","أعناقُ مالٍ مَا لَهَا عنه مَفَرّْ",7,"ر",1,0],["ذافؤادي حرَثَتهُ","يدْ أوهامٍ بحزْني",8,"ن",2,0],["ذَا فُؤادِي وَحنِينِي","ذابَ عِشقا فِي سَنَاهْ",9,"ا",2,0],["ذا في قليب المستقي قصيرةً","أرشية الحاجات من نواله",10,"ل",2,0]]}