لخيِّر","https://www.poetsgate.com/ViewPoem.aspx?id=194754",""],[5956,"أصدقاء خالدون","https://www.poetsgate.com/ViewPoem.aspx?id=194831",""],[5956,"بعد أن ولَّى الشبابْ","https://www.poetsgate.com/ViewPoem.aspx?id=204002",""],[5997,"اشتياقي والأرق","https://www.poetsgate.com/ViewPoem.aspx?id=214252",""],[6013,"يا نسيماً هب مسكاً عبقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181605",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6084,"يا نسيم الشمال بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170857",""],[6097,"يَقْظَة","https://www.poetsgate.com/ViewPoem.aspx?id=197426",""],[463,"اللَّيلُ فالأرضُ للِّيثِ الشَّرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60078&r=&rc=134",""],[6247,"يا ركب أحمد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80283&r=&rc=22",""],[454,"تتجاهلين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82644&r=&rc=8",""]],"verses":[["يا نِساءَ الحَيِّ ما في أُذُنِي","مَسْلَكٌ لِلَّوْمِ فَاتْرُكنَ خِلافي",0,"ف",2,0],["يا نَسيمَ الحِجازِ لَولاكِ تَطف","نارُ قَلبي أَذابَ جِسمي اللَهيبُ",1,"ب",1,0],["يا نَسيمَ الرّيحِ بلِّغْ خبَري","إنْ أتيْتَ الرّبْعَ أو جِئْتَ حِماهُ",2,"ا",2,0],["يا نَسيمَ الصَّبا عَلَى الأوْراقِ","لُدِغَتْ مُهْجَتي فهَلْ منْ رَاقِي",3,"ق",2,1],["يا نَسيمَ الرّيحِ إنْ جِئْتَ الحِمَى","بعدَما طبّقَ غيْمٌ وارتفَعْ",4,"ع",1,0],["يَا نَسْمَةَ الرِّيحِ كَيْفَ الدَّارُ هَلْ عَمَرَتْ","كَلاَّ وَهَلْ أَخْصَبَتْ مِنْ بَعْدِهاَ الدِّمَنُ",5,"ن",1,0],["يَا نَسْمَةَ الرِّيحِ مِنْ تِلْقَاءِْ أَرْضِهِمُ","جَرِّرْ عَلَى الطِّيبِ أَذْيَالاَ وَأَرْدَانَا",6,"ن",2,0],["يا نسبة الشمس في المعالي","ملتَ لرجواي كلّ ميل",7,"ل",1,1],["يا نَسيمَ الريح قولي لِلرَشا","لَم يَزِدني الوِردُ عَطشا",8,"ش",2,1],["يا نُسوراً هَبَطوا الوادي عَلى","سالِفِ الحُبِّ وَمَأثورِ الوَلاء",9,"ا",2,0],["يَأنَسنَ عِندَ بُعولِهِنَّ إِذا اِلتَقَوا","وَإِذا هُمُ بَرَزوا فَهُنَّ خِفارُ",10,"ر",1,0],["يا نَسيمَ الشَمالِ إِن جُزتَ بِالزَو","راءِ يَوماً مُعَطَّرَ الأَنفاسِ",11,"س",1,0],["يا نَسيمَ الشِمالِ إِن جُز