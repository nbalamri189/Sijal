etry.dctabudhabi.ae/diwan/poem/77141","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77154","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4935,"نقشت بصفحة الأداب بنداً","https://www.poetsgate.com/ViewPoem.aspx?id=129367",""],[5431,"جعلتَ القلبَ بكّاءً وليّا ولم يكُ قبْلَ أنْ يهواكَ شيّا","https://www.poetsgate.com/ViewPoem.aspx?id=189483",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""]],"verses":[["بِهِ شَرِكَاتُ البِرِّ عَادَتْ قَوِيَّةً","وَقُوَّتُهَا أَنْ تَصْدُقَ الشَّرِكَاتُ",0,"ت",1,0],["به شموسٌ عهدناهَا مُحَمَّلةً","أعناقُها الحُمر من دُرٍّ ومن ذَهَبِ",1,"ب",1,0],["بِهِ شُدَّ أَزْرُ الملكِ وابْتَهَجَ الهُدى","وفاضَ عَلَى الإسلامِ حسنٌ وإِحسانُ",2,"ن",1,0],["به شرابي كوثر عذبٌ","وشرْبُ أهل الجهل زقوم",3,"م",1,0],["به شُغلوا عنه وآثارُ صنعه","تقاديرُ حالت دونَه وظلال",4,"ل",1,0],["بهِ شرّف البيت الحرام وقد علا","فَمِن نشرهِ أركانهُ تتضوّعُ",5,"ع",1,0],["بِهِ شرفت منوفٌ حَيث أَضحى","لَها سنداً نَوالُ يَديه وَبْل",6,"ل",1,0],["بِهِ شَمسُ عَلياءٍ وَعِزٍّ وَسُؤددٍ","وَبَدرِ كَمالٍ لاحَ مِن جَبهَةِ السّعدِ",7,"د",1,0],["بِهِ شَرفي سامٍ بِه رِفعَتي نَمَت","بِهِ مَددي وافٍ بِهِ هِمّتي تَعلو",8,"ل",2,0],["بِهِ شَاعَ شِعْرِي فِي الْوَرى وَثَنَائي","يَبيتُ فُؤَادِي الْمُسْتَهَامُ بِهَمَّهِ",9,"ه",1,0],["بِهِ شرُفَتْ قَيْسٌ وَسَادَتْ بِهِ اليَمَنْ","سَبِيقُ نَجَاةٍ فِي الْمِعَادِ لِكُلِّ مَنْ",10,"ن",1,0],["بِهِ شَرُفَت تِلكَ العَمَارةُ واغتَدَت","مُكَرَّمَةً عِندَ المَلا والمَلائِكِ",11,"ك",1,0],["بهِ شُغِفَ الوَرى عُرباً وعجماً","وَهَل كلٌّ بِطِيبِ لِقاهُ نَالا",12,"ل",2,0],["به شرفت تلك الأماكن كلها","ولولاه ما كنا لهن نعظم",13,"م",1,0],["به شرفت مختارة العزّ في الورى","وبارو كها للفضل جاء دخيلا",14,"ل",2,0],["به شرُفت وعَزت أرض طاب","ومروتنا وزمزم والحطيم",15,"م",1,0],["به شرفت تلك الأماكن كلها","وربك قد خص الحبيب وأعطاه",16,"ه",1,0],["بِهِ شاطَرو الحَيَّ أَموالَهُم","هَوازِنَ ذا وَفرِها وَالعَديما",17,"م",2,0],["به شاهر من السلطان يُعْلِي","دعائم ملكه وبه يصول",18,"ل",1,0],["بِهِ شغفت وَكانَ بِها شغوفاً","وَواصلها فَلَيسَ بِهِ سقام",19,"م",1,0],["بِهِ شد مِن أزر الوزارة ساعد","فَما ضعفت رَأساً وَلا عدمت نَصرا",20,"ر",2,0],["به شحوب يكاد الصب يأكله","أكلا ويشربه دون اطلى كاسا",21,"س",2,0],["بِهِ شمس التضحى قُرِنت بهآءً","ببدر التيمِّ في سعد السعودِ",22,"د",1,0],["به شرَقَتْ من خشيَةِ الموتِ بالخُصى","صُدورٌ وفارت بالقُلوبِ حُلوقُ",23,"ق",1,0],["به شفع المشية ثم عنه","وعنها بثت الأكوان بثا",24,"ث",2,0],["بِهِ شُموسُ العُلوم قَد أَفلَت","وَأَنجُمُ الفَضلِ ما لَها طالِع",25,"ع",1,0],["بِهِ شَرَّفَ البَيتَ حَتَّى أطِيفَ","وَأعلَى المَنَاسِكَ وَالمَشعَرَا",26,"ر",2,0],["بِهِ شُغلُ قَلبِ المُستَهامِ وَلُبُّهُ","وَما اِنفَكَّ مَصروعُ الخَزاعِبِ مُغرَما",27,"م",2,0],["بِهِ شُدَّ أَزرُ الدينِ وَاِستَوثَقَت بِهِ","عَراهُ وَقامَ الحَقُّ في شِدَّةِ العَضد",28,"د",1,0],["بِهِ شادَ أَركانَ المَكارِم فَاِقتَنى","مَوَدّاتِ أَقوام بِعاد عَنِ الشُكرِ",29,"ر",1,0],["بهِ شَرَّفَ اللَهُ الوجودَ بعاقِبٍ","حمدنا بهِ في الهدي حسنَ العَواقِبِ",30,"ب",1,0],["به شان الصدارة زاد فرا","فينزل دون رتبتها كيان",31,"ن",1,0],["به شرعت لباب الله بابٌ","لجنات الخلود بلا مراء",32,"ا",2,0],["به شرعت لبابي كلّ خير","به بابُ التفضل والعطاء",32,"ا",2,0],["به شره عم الورى بفجائع","تركن فلاناً ثاكلا لفلان",33,"ن",1,0],["بهُ شيمٌ قد قصر الخلق دونها","وقدرٌ بما شاءت معاليه حلقا",34,"ق",2,0],["به شوهت وجه الذوق حتى","غدوت وعزة المولى مجرد",35,"د",1,0],["به شوق يقيم بنا عتيّا","وتقبيل غدا رطبا جنيّا",36,"ي",2,0],["به شارعي خافق بانتباه","وكنت التي زينت شارعه",37,"ع",2,0],["به شعوبٍ ضاع املها تكره الفعل المضارع","تلقى في الماضي عزاها اما حاضرها يلوع",38,"ع",1,0],["به شغفٌ.. ويُخجِلهُ","تصابي العاشقِ الهَرِم",39,"م",1,0],["بهش عثراتُ دهركَ أنْ تقالاَ","فلست بمالك عبرات عين",40,"ن",1,0]]}