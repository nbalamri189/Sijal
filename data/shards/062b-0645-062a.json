oetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58178","السريع"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120415","الخفيف"],[4680,"وانتهينا كطيف حلمٍ تلاشى","https://www.poetsgate.com/ViewPoem.aspx?id=192193",""],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4767,"المقام العالي","https://www.poetsgate.com/ViewPoem.aspx?id=179947",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4858,"طابتِ الأيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=138207",""],[4927,"ضياع الأمل في المعرة","https://www.poetsgate.com/ViewPoem.aspx?id=30182",""],[5061,"صدى الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=147426",""],[5136,"أول الحب في القلوب علوقا","https://www.poetsgate.com/ViewPoem.aspx?id=121626",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5302,"برزت بكل أناقة","https://www.poetsgate.com/ViewPoem.aspx?id=205143",""],[5409,"جمعوهم كحزمة من مفاتي","https://www.poetsgate.com/ViewPoem.aspx?id=155383",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5573,"كل ماقلت هانت واحتكمها حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=200089",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[4372,"ما أَعجَبَ الحُبَّ في مَذاهِبِه","https://www.poetsgate.com/ViewPoem.aspx?id=86430",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5795,"تبارك البارئ مبدع ألوى","https://www.poetsgate.com/ViewPoem.aspx?id=167913",""],[5823,"درب الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=59186",""],[5887,"طابا","https://www.poetsgate.com/ViewPoem.aspx?id=35263",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"إنَّ بي عيباً وحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=181894",""],[5956,"عقدة النقص لدى إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=192310",""],[5956,"يخفون عني نبأ ما","https://www.poetsgate.com/ViewPoem.aspx?id=193144",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6031,"نَصَحْتَ للَّهِ فلاَ تَتَّهِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46350",""],[6102,"جَنَّةُ الشِّعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183611",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[5309,"أصبح الحب بقلبي كالطلول","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573717",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["ثم تمادى غرداً صادحا","يعلن للوردة أشواقه",0,"ه",1,0],["ثمّ تدانى واضعاً كفّه","في كفّها يطلب أن يلثما",1,"م",2,0],["ثُمَّ تَقَدَّمتُ إِلى الفَهّادِ","وَالبازِيارينَ بِالاِستِعدادِ",2,"د",1,0],["ثُمَّ تَصايَحنا فَطارَت واحِدَه","شَيطانَةٌ مِنَ الطُيورِ مارِدَه",2,"ه",1,0],["ثَمَّتَ شَدّا فَأَصابا أَربَعا","ثَلاثَةً خُضراً وَطَيراً أَبقَعا",2,"ع",2,0],["ثُمَّ تَعَزَّيتُ مِنهُ غَيرَ مُختَشِعٍ","عَلى الحَوادِثِ في عُرفٍ وَإِجمالِ",3,"ل",1,0],["ثم تَلقى الحكيمَ فيه يُمالي","كلَّ وغدٍ على ذوي الآدابِ",4,"ب",1,0],["ثُمَّت يأوي إلى حليلته","كالديك يأوي إلى دجاجتِهِ",5,"ت",2,0],["ثم تجودي لكل ملتمسٍ","بفقحة لا تزال مختلِجَهْ",6,"ج",2,0],["ثم تبينتُ أنهم قُذُرٌ","ليست لدى فَقْدها بمفتقَدَهْ",7,"د",2,0],["ثم تغنَّتْ صوتاً شربت له","على اقتراحٍ رِطلين في نفَس",8,"س",1,0],["ثم تهدي إليك يا نَفْطويه","فرْخَها صاغراً بحُكم الفِراش",9,"ش",1,0],["ثم تخلَّصتُ ففاصلتُها","فَصَّلها الجزارُ تفصيلا",10,"ل",2,0],["ثمّ تحمّلْتِ وكلّلتِه","من فاخر الدُّرِّ أكاليلا",10,"ل",2,0],["ثم تأتيهِ بالحديثِ فتأتي","برحاه على سواءِ الثّفالِ",11,"ل",1,0],["ثم تلاهُ أبو محمدٍ ال","محمود في فعله فما سَئما",12,"م",2,0],["ثم تبيَّنْتُ أنه غرضٌ","ليسَ من اللائي يقْصِدُ الرامي",13,"م",2,0],["ثُمَّ تَرَبَّعَ أُبلِيّاً وَقَد حَمِيَت","مِنهُ الدَكادِكُ وَالأُكمُ القَراديدُ",14,"د",1,0],["ثمَّ تحتَ الصّنَوْبَر النَّاضر الحلو","تَخُطُّ السَّيولُ حُفْرَةَ رمسي",15,"س",2,0],["ثم تبدو وليدة من جديد","ثم تخفى على سبيل التوالي",16,"ل",2,0],["ثُمَّ تَلاهُ الثَعلَبُ السَفيرُ","يُنشِدُ حَتّى قيلَ ذا جَرير",17,"ر",1,0],["ثمَّ تَلاها قَصَبٌ مُجوَّفُ","مثلَ القَنا ثَقَّفَهُ المُثقِّفُ",18,"ف",1,0],["ثُمَ تُب وَاِسأَلِ الإِلَهَ تَجِدهُ","لِذُنوبِ الوَرى غَفوراً رَحيما",19,"م",2,0],["ثم تمضي مجاوزاً حجب الليل","وترمي بنورك الوقَّاد",20,"د",1,0],["ثُم تَعنانَقنا فلله ما","تذرف عَيناي وَعَيناها",21,"ا",3,0],["ثُمَّ تَأَدّى ما عَلَيهِ وَخَرَج","وَلَم يَكُن يَطمَعُ في قُربِ الفَرَج",22,"ج",1,0],["ثُمَّ تَوَجَّأتُ خَصرَها بِشَبا ال","إِشفى فَجاءَت كَأَنَّها لَهَبُ",23,"ب",1,0],["ثُمَّ تَذروهُ الرِياحُ كَما","طارَ قُطنُ النَدفِ عَن وَتَرِه",24,"ر",2,0],["ثُمَّ تَحَسَّت حَتّى إِذا شَرِبَت","نِصفاً كَما قيسَ لي بِمِقياسِ",25,"س",1,0],["ثُمَّ تَغَنّى طَرَباً عِندَهُم","وَهوَ مِنَ القَومِ عَلى خَوفِ",26,"ف",1,0],["ثُمَّ تَغَنّى وَقَد دارَت بِهامَتِهِ","فَما يَكادُ يُبينُ القَولَ إِذ نَطَقا",27,"ق",2,0],["ثُمَّتَ اِنصاتَ الشَبابُ لَها","بَعدَما جازَت مَدى الهَرَمِ",28,"م",1,0],["ثُمَّ تَغَنّى عَلَيهِ مِن طَرَبٍ","يا ريحُ ما تَصنَعينَ بِالدِمَنِ",29,"ن",1,0],["ثم ترقّى زائداً فزائدا","كأنّ كفّاً أخذت جلامدا",30,"د",2,0],["ثمّ تعشّقتُ وامقاً طرباً","يا ليتَ سلمى تفي بما تعدُ",31,"د",1,0],["ثُمَّتَ اِزدَدتُ بَعدَها مِن سُلُوٍّ","بَل أَراني مِن حُبِّها في اِزدِيادِ",32,"د",1,0],["ثُمَّ تَبَدَّلتُ عَلى حُبِّها","يا عَجَباً يَنقَلِبُ الذاهِبُ",33,"ب",1,0],["ثُمَّتَ آبوا أَكرَمَ المَآبِ","نِعمَ لِزازُ المُترَفِ المُرتابِ",34,"ب",1,0],["ثُمَّتَ لاَ بُدَّ أَن سَيَجمَعُكُم","وَاللَهِ جَهراً شَهادَةً قَسَما",35,"م",2,0],["ثُمَّتَ أغزى في الثلاثِ عَمَّهْ","وقد كساهُ عَزْمَه وحزْمهْ",36,"ه",1,0],["ثُمَّتَ شَدَّ أَزرَهُ ببَدْرِ","فكانَ كالشَّفعِ لهذا الوتْرِ",36,"ر",1,0],["ثمّ تلاهُمْ بعدُ ليثُ الغيلِ","عبدُ الحميد من بني بسيلِ",36,"ل",1,0],["ثمَّ تصحيفُها لثانيهِ مأوىً","ولنا مَركَبٌ وباقيهِ سُورَهْ",37,"ه",1,0],["ثم تلَّاني للجبين وقالا","ليَ ذق أنت الفيلسوف الكبير",38,"ر",1,0],["ثم توماسُ ثم فِخْتُ ومنهم","اسبِنوزا وهُلْبَكٌ وجيور",38,"ر",1,0],["ثم توالى الحيوان فيها","واختلف الشكل والبناء",39,"ا",2,0],["ثُمَّتَ أَورَثَهُ الفِردَوسَ يَعمُرُها","وزَوجُهُ صُنعَةً مِن ضِلعِهِ جَعَلا",40,"ل",2,0],["ثم تجثو أمامه وتنادي","رب صنه من ظلم عبد الحميد",41,"د",1,0],["ثم تُلْقي السلاحَ إلقاءَ ذلٍ","والجراثيمُ حولَها تتحدَّى",42,"د",2,0],["ثم تلته يدٌ \" كادحةٌ \"","تُحْسِنُ الصَّفعةَ للمغتصِب",43,"ب",1,0],["ثَمَّ تحتَ الستارِ ممتَلكٌ بالحبِّ","عفواً ومثلُه مغصوب",44,"ب",1,0],["ثُمَّ تَبَدَّتْ كأَنَّها حَدَقٌ","أَجْفانُها مِنْ دِمائِها حُمْرُ",45,"ر",1,0],["ثُمَّتَ طافَ وَاِنثَنى مُستَلِماً","ثُمَّتَ جاءَ المَروَتَينِ فَسَعى",46,"ا",1,0],["ثُمَّتَ راحَ في المُلَبّينَ إِلى","حَيثُ تَحَجّى المَأزمانِ وَمِنى",46,"ا",1,0],["ثُمَّ تَرضى بِذَلِكَ الأَزدُ إِن تَر","ضى فَلا ريشَ سَهمُها المَمروطُ",47,"ط",1,0],["ثَمَّتَ مالُوا لِلخيامِ مَيلَةً","قالَت لِرُكنِ الدِينِ إِيهاً فَقَعِ",48,"ع",1,0],["ثم تعجبت كيف أخمد بال","ترويح نارِى والنارُ تُشعَل به",49,"ب",2,0],["ثمّ تنصّفت وانتميت إلى","عبّاس في رهطه وفتيانه",50,"ن",2,0],["ثم تبلى بنان من يكتب","الخط ويبقى يباع في الأسواق",51,"ق",1,0],["ثم تيقظت له يقظة","لم أنج منها من شبا غدره",52,"ر",2,0],["ثُمَّتَ اِستَوسَقَت لَهُ وَرَمَتهُ","بِغُبارٍ عَلَيهِ مِنهُ رِداءُ",53,"ا",2,0],["ثم ترتاح من تذكرها البين","فتلقي بالنفس في أحضاني",54,"ن",2,0],["ثم تلقاه من مهارته ر","دلها روحها بغير تواني",55,"ن",2,0],["ثَمَّ تَلَقى أُسدَ العَرينِ عَلى الأَذ","قانِ صَرعى بِأَعيُنِ الآرامِ",56,"م",1,0],["ثُمَّتَ ناصِت فُلولاً مِن عَدُوِّكُمُ","قَد أَجحَرَت بَينَ مَقتولٍ وَمَجنوبِ",57,"ب",1,0],["ثم تمضى الأيام بي ظامىء القل","ب ولمّا أفن الطريق مضيا",58,"ي",2,0],["ثُمَّ تَنْهَدُّ عَلى أَنمَاطِها","مِثلَ ما مالَ كَثِيبٌ مُنقَعِرْ",59,"ر",1,0],