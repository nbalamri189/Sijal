{"poems":[[55,"فيا عجبا مما يظن محمد","https://www.aldiwan.net/poem30411.html","الطويل"],[88,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[53,"لا شب قرن أبي حفص ولا زرعا","https://www.aldiwan.net/poem65072.html","البسيط"],[87,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[68,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[82,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[107,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[83,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[50,"لئن هجرتك بعد الوصل أروى","https://www.aldiwan.net/poem63289.html","البسيط"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[122,"جرى ذكر هجرٍ في خروق المسامع","https://www.aldiwan.net/poem495.html",""],[543,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[572,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66653","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138110",""],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136784",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79956","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48925","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87847","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106710","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89550","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137317",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203471","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199962","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204635","الوافر"],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100607","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48325","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216834","الوافر"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66568","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94560","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136763",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139699",""],[4978,"تشطير لأبيات أستاذي محمد ذيب سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=211981",""],[585,"يا أرض حسبك إرعاداً وإبراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=161883",""],[5199,"ياْدمى ربك الى يقدر وينجزاء","https://www.poetsgate.com/ViewPoem.aspx?id=146096",""],[5409,"علاك يقصر عن إدراكه الكلم","https://www.poetsgate.com/ViewPoem.aspx?id=155497",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5992,"لَيِّنَةُ الأعطافِ لا","https://www.poetsgate.com/ViewPoem.aspx?id=41823",""],[6023,"لينهك مجد طارف وتليد","https://www.poetsgate.com/ViewPoem.aspx?id=123864",""],[6124,"لينة","https://www.poetsgate.com/ViewPoem.aspx?id=193274",""],[4115,"لينهك يا ذا الشمس ان نلت ذا البدرا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607524",""],[572,"أذَابَتْ قلبَهُ الزّفرهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9323&r=&rc=180",""]],"verses":[["لَئِن هُوَ أَعفى لِلذِلافَةِ لِمَّةً","لَها طُرَّرٌ فَوقَ الجَبينِ وَأَطرارُ",0,"ر",1,0],["لَئِن هَدَوكُم لَقَد كانَت أَوائِلُكُم","تَهدي أَوائِلَهُم أَزمانَ أَزمانِ",1,"ن",1,0],["لئن هجاني وفرطُ الجهِل أوقعه","لقد تزوَّج أيضاً بعدمَا صلعا",2,"ع",2,0],["لِيَنهَضَ ما بَينَهُم خاطِباً","عَلى العَرشِ نَصَّ لَهُ مِنبَرُ",3,"ر",1,0],["لَئِن هَمَمتُ كانَ لي هِمَمٌ","تَفتَحُ لي بِاِهتِمامِها سُبُلا",4,"ل",2,0],["لئن همى من راحتيه الحيا","فالبدرُ منه يحتَبي بالديم",5,"م",1,0],["لَئِن هِيَ أَهدَت لِلأَقارِبِ تَرحَةً","لَقَد جَلَّلَت تُرباً خُدودَ الأَباعِدِ",6,"د",1,0],["لَئِن هِمَمي أَوجَدنَني في تَقَلُّبي","مَآلا لَقَد أَفقَدنَني مِنكَ مَوئِلا",7,"ل",2,0],["لَئِن هُزَّ مِن أَرجاءِ حِمصَ مَسَرَّةً","حَديثٌ بِمَلقاهُ إِلَيها يُرَجَّعُ",8,"ع",1,0],["لَئِن هَزَّ أَعطافَنا حُسنُهُ","لَقَد بَزَّ أَنفُسَنا ظَرفُهُ",9,"ف",2,0],["لَئِن هَدَّ بَأسَ الباسِلينَ مِنَ العِدى","فَإِنَّ كَبيرَ الباسِلينَ لَقادِمُ",10,"م",1,0],["لَئِن هَزَزتُكَ لِلدَهرِ الخَؤونِ فَما","هَزَزتُ لِلحَربِ غَيرَ الصارِمِ الخَذِمِ",11,"م",1,0],["لَئِن هَجَرَتكَ بَعدَ الوَصلِ أَروى","فَلَم تَهجُركَ صافِيَةٌ عُقارُ",12,"ر",1,1],["لئن هدمت محياك قاصمة الردى","فمجدك يبقى شامخا لا يهدم",13,"م",1,0],["لئن هجرتني حين أن كنت غائبا","خيالي إذا يغزوهم في المضاجع",14,"ع",1,0],["لَئِن هُوَ أمسَى اليومَ عن مِصرَ غائبا","وقد جَدَّ مِن عيدِ السرور لها ثوبُ",15,"ب",1,0],["لئن هَزّ بِهَا الشَّوْقَ","لَقَدْ أفْزَعَهَا زَبْرَهْ",16,"ر",2,0],["لينهشَ خيرَ من ركب المطايا","أميرَ المؤمنينَ أبا تُرابِ",17,"ب",1,0],["لئن هجرت ملالا لا دلالا","وصدت صد مجتنب مصادي",18,"د",2,0],["لئن هويتَ الذي قد كنتُ أعشقه","فسوف أهجره جهدي وأنساه",19,"ا",2,0],["لينةُ الأعطافِ رعبوبةٌ","بديعةُ الأوصاف حسناء رود",20,"د",1,0],["لئن هي بالإشراق منها تزيَّنتْ","فما الفخر إلاَّ حيث حلَّ نقيبها",21,"ه",2,0],["لِئنْ هجرتني في القضاء قريحتي","فليس جمالُ الشعر يوماً بهاجري",22,"ر",2,0],["لَئِن هاجَ أَشواقي فَرُبَّ مُتَيَّمٍ","تَذَكَّرَ ماضيهِ فَأَبكاهُ حاضِرُه",23,"ر",2,0],["لئِن هَجرَ الجدُّ الحؤُونُ مآلها","بما أحكَمَ الحُجَّابُ مِن رَسَفَانِهَا",24,"ن",3,0],["لَئِن هُم أَبانوا في العُلا مَنهَجَ النَدى","لَكَم شِدتَ فيها مَعلَماً بَعدَ مَعلَمِ",25,"م",1,0],["لئن همت يا موسى بها فهي غادة","يطيب بها الانشاد والنظم والنثر",26,"ر",1,0],["لئن هوت بجراح الحرب مثخنة","فأي سيف ضراب غير منثلم",27,"م",1,0],["لئن هزّ غيري جميل الضياء","فإن الظلام هنا أجمل",28,"ل",1,0],["لئن هاج الدجاج لأكل حب","فلست الى سوى عز أهاج",29,"ج",1,0],["لئن هم أبعدوني عن حملهم","فلست ودارهم يوماً بسالي",30,"ل",2,0],["لئن هاجَها بُعْدُ المَزارِ تشوُّقاً","كما قد شَجى وُرْقَ الحَمامِ هَديلُها",31,"ل",3,0],["لئن هجعت بساحتك المآقي","لما هجعت بساحتك الخطوب",32,"ب",1,0],["لَئِنْ هَرَّقَتْ آلاتُ خَمْرِكَ ما حَوَتْ","فَلِلأَرْضِ فِي زادِ الكِرامِ نَصيبُ",33,"ب",1,0],["لينهك طالع لقحت سعوداً","به الدنياوكان بها محال",34,"ل",1,0],["لئن هزَّ صمصاماً فيصمي جحافلاً","يصول بعزمٍ فعلهُ ليس يجحدُ",35,"د",1,0],["لِينهل مِن نَبعها المُستَفيض","هُدى أَمماً وَيَقيناً أَمم",36,"م",1,0],["لئن هجاني فاني لا أفوهُ بما","قد فاهَ فيه ومن هَجوي أحاشيه",37,"ي",2,0],["لئن هامعُ الغيث كفَّت يداه","فجودك عنها لنا هامعُ",38,"ع",1,0],["(لينهل منهما نسغا ويبقى )","(يواصل ما استطاع له ارتشافا)",39,"ف",2,0],["لئن هجرتك لم أجنح إلى صلةٍ","ولا مددت إليك الطرف مشتاقا",40,"ق",2,0],["لينه ايس وعن باب السعاده عزاء","والعمر يمضى وهقوته ماتنفعه",41,"ع",2,0],["لئن هجرت لهم أم القرى زمناً","فكل وادٍ إذا يممته حرم",42,"م",1,0],["لئن هام في حب الحسان فإنني","بحب جمال الدين لا الجسم هائم",43,"م",1,0],["لَيِّنَةُ الأعطافِ لا","يُجهل حَقُّ قَدْرِها",44,"ر",3,1],["لينهك مجد طارف وتليد","يخصك به آباء وجدود",45,"د",1,1],["لِيْنَةٌ غَرَّتْ صَبَاحِي","وَانْتَقَتْ لِلْبَيْتِ حَوْضَا",46,"ض",2,1],["لينهك يا ذا الشمس أن نلت ذا البدرا","سينجم هذا الالتقا أنجما زهرا",47,"ر",2,1],["لئن هذّبَها الفِكرُ","لقد أَفرَغَهَا صَبرَهْ",48,"ر",2,0]]}