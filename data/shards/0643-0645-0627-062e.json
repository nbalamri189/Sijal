{"poems":[[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[39,"كما خامرت في حضنها أم عامر","https://www.aldiwan.net/poem7483.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[49,"وقوفك في الديار عليك عار","https://www.aldiwan.net/poem25290.html","الوافر"],[74,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[14,"إن تأخذوا أسماء موقف ساعة","https://www.aldiwan.net/poem38316.html","الطويل"],[47,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[30,"لعمري لقد سلمت لو أن جثوة","https://www.aldiwan.net/poem5504.html","الطويل"],[101,"إلى رجل","https://www.aldiwan.net/poem6618.html","عموديه"],[68,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[48,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[15,"وخيرني ذو البؤس في يوم بؤسه","https://www.aldiwan.net/poem45258.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55102","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54646","الكامل"],[101,"إلى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=565",""],[101,"إلى رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=389&r=&rc=74",""],[119,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[119,"بلذة العيش عش يا خالي البال","https://www.aldiwan.net/poem40629.html","عموديه"],[119,"آه على وقت مع الاحباب","https://www.aldiwan.net/poem41219.html","عموديه"],[123,"له حلبة الخيل العتاق كأنها","https://www.aldiwan.net/poem4343.html","الطويل"],[124,"أيا ساعة مليت فيها بحسنه","https://www.aldiwan.net/poem49302.html","الطويل"],[147,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[276,"أمن تذكر أهل البان والبان","https://www.aldiwan.net/poem52124.html","البسيط"],[287,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[342,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[443,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[445,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[445,"غدا غير مسعدنا ثم راحا","https://www.aldiwan.net/poem34902.html","المتقارب"],[463,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[463,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[545,"كم أخ صالح وعم وخال","https://www.aldiwan.net/poem56640.html","الطويل"],[556,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[556,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[556,"يا طلل الحي بذات النقا","https://www.aldiwan.net/poem47363.html","السريع"],[556,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[568,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138422",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104614","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63808","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59546","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120086","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73953","البسيط"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82652","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80023","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144617","المديد"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27673","المجتث"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47158","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137086",""],[2766,"","https://poetry.dctabudhabi.ae/diwan/poem/124308","الطويل"],[3164,"","https://poetry.dctabudhabi.ae/diwan/poem/146991","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48324","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102431","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141512","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111473","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91045","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94581","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94389","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94766","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33420","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72515","البسيط"],[4674,"منصور","https://www.poetsgate.com/ViewPoem.aspx?id=207086",""],[4767,"فقيد الولاية","https://www.poetsgate.com/ViewPoem.aspx?id=179271",""],[4782,"زهر البيد","https://www.poetsgate.com/ViewPoem.aspx?id=199229",""],[4968,"صولات الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=208105",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5717,"يا صانعا شيئا بديعا محكما","https://www.poetsgate.com/ViewPoem.aspx?id=170601",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5956,"إلى خادمي الله أحفادي الأكارم وأمهاتهم","https://www.poetsgate.com/ViewPoem.aspx?id=193148",""],[6093,"ماخض الماء","https://www.poetsgate.com/ViewPoem.aspx?id=201376",""],[6152,"مطل أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=203029",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""]],"verses":[["كَما خَرَقَ الرامي بِسَهمِ رَميِّهِ","وَأَعرَضَ عِلماً أَنَّهُ سَوفَ يَعطَبُ",0,"ب",1,0],["كما خامرت في حِضنها أمُّ عامر","لذي الحبل حتى عال أوس عيالَها",1,"ه",2,1],["كما خَطَرَت أَسِنَّتُنَا بِعمرو","أبِي الملكَينِ غَير مُدَعدِعِينَا",2,"ن",2,0],["كَما خَزِيَت بِراعيها نُمَيرٌ","وَجَرَّ عَلى بَني أَسَدٍ يَسارُ",3,"ر",1,0],["كما خاطبَ العذَّال جود محمدٍ","فأعرض عنهم واسْتهلَّ غماما",4,"م",2,0],["كم إخوةٍ وارت له","سوءاتِهِم تلك الغُرابهْ",5,"ب",2,0],["كم أخٍ قد رأى أخاهُ صريعاً","ترِبَ الخَدِّ بينَ صَرْعى كرامِ",6,"م",1,0],["كَمَأخَذِنا حَسناءَ كُرهاً وَدَمعُها","غَداةُ اللِوى مَغصوبَةً يَتَصَبَّبُ",7,"ب",1,0],["كَم أَخي عَيلَةٍ رَأى العُدمُ حَتماً","رامَ عَن فَضلِ سَيبِهِ وَهوَ مُثرِ",8,"ر",1,0],["كَما خانَ دَلوَ القَومِ إِذ يُستَقى بِها","مِنَ الماءِ مِن مَتنِ الرِشاءِ اِنجِذامُها",9,"م",3,0],["كم اخترعت مكاتيبا سترسله","وأسعدتني ورودا سوف تهديها",10,"ي",3,0],["كَما خَرَّ نَجمُ الدينِ مِن عَرشِ مُلكِهِ","وَلَم يُغنِ عَنهُ الباسُ وَالعَزمُ وَالحَزمُ",11,"م",1,0],["كم أخبرَ المصطفى المختارُ مِنْ رجلٍ","عنِ السماءِ بما يلقى مِنَ الغيرِ",12,"ر",1,0],["كَم أَخلَقَ العَصرانِ مُهجَةَ مُعصِرٍ","وَهُما عَلى أَمنٍ مِنَ الإِخلاقِ",13,"ق",1,0],["كَما خُلقا غَبَرا في العُصو","رِ لا يَرخُصانِ وَلا يَغلُوانِ",14,"ن",1,0],["كَما خُيِّرَت عادٌ مِنَ الدَهرِ مَرَّةً","سَحائِبَ ما فيها لِذي خيرَةٍ أَنَق",15,"ق",1,0],["كم أخواتٍ لكِ شاطرنني","فجرَ لقاءٍ رائعِ المطلعِ",16,"ع",1,0],["كَمْ أخَرَجَتْ لأُولى البَصَائِرِ حِكْمَةً","مِمَّا أَلَمَّ بِهِ مِنَ الأَرْزَاءِ",17,"ا",2,0],["كَمْ أَخِي علْمٍ وَفَضْلٍ مُكْبِرٌ","فِي مَجَالاَتِهَا قَدْرَ جِهَادِكْ",18,"ك",1,0],["كَمْ أَخْرَجَتْ حَكَماً","مِنَ اللَّهْوِ الْبَرِيءِ المُسْتَحَبِّ",19,"ب",1,0],["كم اخترعت مكاتيبا سترسلها","وأسعدتني ورودا سوف تهديها",20,"ي",3,0],["كم اخترعت مكاتيبا سترسلها","وأسعدتني ورودٌ سوف تهديها",21,"ي",3,0],["كم اخفق القلب الشج","ي دهش خلال",22,"ل",1,0],["كم اخفق القلب الشج","ي دهشا خلخاله",22,"ل",2,0],["كم اخدع الفكر خوفا ان يمر بهم","والصبر بالله ان مروا على بالي",23,"ل",2,0],["كم اخفقت قلبي خواطر عهدهم","وللوعتي لان الحديد لمابي",24,"ب",2,0],["كما خطط الزاهي بمهرق كاتبٍ","فجرَّ عليه ذيلَهُ وهو ما جفا",25,"ف",2,0],["كما خفقت يوماً على الزهر نحلةً","وظلت تشاكيه الهوى وتساور",26,"ر",1,0],["كَم أَخٍ في الزَمانِ فاقَ أَخاهُ","بِفَعالٍ بِهِ يَبينُ التَنافي",27,"ف",2,0],["كَم أخبر تنابه من قبل مبعثه","فينا بَشائر أَحبار وَرُهبان",28,"ن",1,0],["كَما خَضَعت كُلُّ المُلوكِ بِرَأيِهِ","لِمَخدومِهِ لا شَتَّتَ اللَهُ شَملَهُ",29,"ل",2,0],["كَما خَطَّ عِبرانِيَّةً بِيَمينِهِ","بِتَيماءَ حَبرٌ ثُمَّ عَرَّضَ أَسطُرا",30,"ر",2,0],["كما خالطت نعمى أبي اسحق والندى","بمعظمه روحي ولحمي وأعظمي",31,"م",2,0],["كما خَفَقَتْ عَلَيَّ قلوبُ غِيدٍ","أَمَرَّ لَهُنَّ دوني وَهوَ مُحلِ",32,"ل",1,0],["كما خَيَّرَ اللهُ عَبْدَ المَلِي","كِ فاخْتارَ فِي رَاحَتَيْهِ السَّمَاحا",33,"ح",2,0],["كم أخواتٍ لها زُفَّتْ وما خُطبتْ","كوني أباها ولم يُسمَعْ لها يُتُمُ",34,"م",1,0],["كم أخٍ حائم معي واصلٍ لي","فإذا خَلَّفتْ به الحالُ صدَّا",35,"د",2,0],["كَم أَخٍ صالِحٍ وَعَمٍّ وَخالٍ","وابنِ عَمًّ كالصارِمِ المَسنونِ",36,"ن",1,1],["كَم أَخرَجَتك عَن المضا","ئقِ منه أفعالٌ كرامُ",37,"م",1,0],["كم أخرجتْ كفّك مستعصماً","لا يحذر السّوءَ من المعقلِ",38,"ل",1,0],["كم أخْلَقَ الحبُّ وحبّي لكمْ","ما رثّ بالدَّهرِ وما أخلقا",39,"ق",2,0],["كَم أَخَذَ الدّهر لَنا صاحِباً","وَكَم طَوى في تُربِهِ ما طَوى",40,"ا",1,0],["كَما خَضَّ ماءَ الشَنِّ جَرّا إِتائِهِ","وَمُطَّلِبٌ عَنّاهُ أَبلَق ماخِضُ",41,"ض",1,0],["كم اخمد العسر في ذا الدهر من همم","وكم انام ذكاء كان يقظانا",42,"ن",2,0],["كم أخضعوا أمما تسامى عزها","فخضعن بعد العزة الشماء",43,"ا",2,0],["كما خسفَ البدرُ في تمِّهِ","وكُسّرَ بالطعنِ صدرُ الصِّعادِ",44,"د",1,0],["كم اختطفَ الردى مَنْ فَوْقَ حصنٍ","كم انتزعَ الردى مَنْ خَلْفَ سور",45,"ر",1,0],["كما خدع الآلُ الكذوبُ بخبرة","ولا غَروَ إن الآلَ أصل شكاتي",46,"ت",2,0],["كم آخر الإفلاس لي أملا","ونداك أقرنني بقارونِ",47,"ن",1,0],["كم أخلفاني فخلفاني","إذ كنت غراً على التراب",48,"ب",1,0],["كَم أَخ لي كانَ مِنّي فَلَمّا","أَن رَأى الدَّهرَ جَفاني جَفاني",49,"ن",2,0],["كم أخٍ شدَّ ساعدي بأخيه","بعده قد صحبتُ باعاً أشلاّ",50,"ل",2,0],["كما خان صبري يوم أصبح و\"اصطلى","لظى\" زاد ماءً من جفوني وقدُهُ",51,"د",2,0],["كم أخي نسك وذي ورع","جاء يبغي الحج فافتتنا",52,"ن",2,0],["كما خصصت بأمرٍ","عنه الملائك جنّت",53,"ت",1,0],["كما خلّدت نشرَ ذكرها","وإن أوحشت بالفقد منها منازل",54,"ل",1,0],["كما خفت بنو بيروت تبغي","رضاك فمد نحوهم اليمينا",55,"ن",2,0],["كم أخبرت واستغاثَ الأنبياء به","وبشرت رسلٌ انباؤه رسلا",56,"ل",2,0],["كم أخذ الدهر باغتصاب","قوت فقير وكنز وال",57,"ل",1,0],["كمْ أخفَقَتْ مَسْعى عِداكَ خوافِقٌ","في الحربِ قد نُشِرَتْ عليْكَ بُنودُها",58,"د",3,0],["كما خط الكتاب بكف يوما","يهودي يقارب أو يزيل",59,"ل",1,1],["كما خَرَّ في أيدي التلاميذ بينَهمْ","حصى جوهرٍ لاقَيْنَ بالأمسِ جالِيا",60,"ي",2,0],["كم أخلف الله مالاً أنت متلفه","وما عن النَّفس إن اتلفتها عوض",61,"ض",1,0],["كَم أَخٍ يَفتَدُونَ بِالمالِ وابنِ","ويَظَلُّ الجاني بِرَغدٍ وأَمنِ",62,"ن",1,0],["كم أخمص وطأتها وهي صاغرة","وأصبحت تختشي من فوقها الزلقا",63,"ق",2,0],["كم أخضعوا من ملوكٍ بالورى فتكوا","وبددوا الظلم مع قومٍ تباشرهُ",64,"ر",2,0],["كَما خجلت ذُكا الأنوار لمّا","تبدّى وجههُ الزاهي البَسيمُ",65,"م",1,0],["كما خُصَّ في أبهى المحاسن برءُها","ومن عادة الأوراد في الخدِّ بتأها",66,"ه",2,0],["كم أخو زفرةٍ يطو","لُ عليكَ التلهفُ",67,"ف",1,0],["كما خبا فيه زند فكري","وكان في وريه استعار",68,"ر",1,0],["كم أخطأت قلبَ الجبانِ سهامُه","وتصيبُ قرمًا فارسًا مغوارا",69,"ر",2,0],["كم أخجلَتْ كفاه راحةَ باذلٍ","لَم تعرفنْ من جودها الإمساكا",70,"ك",2,0],["كم أخلف الغيم للأزهار موعدهُ","وخلَّف الليلَ شاكٍ جفوة الدّيم",71,"م",1,0],["كمِ اختالَ هذا الوردُ في نبض خافقي","قد اجتاح لبّي والغرام قتيل",72,"ل",1,0],["كم اختفت دون طرفي وهي حاضرتي","فألمس الشوق في أحشايَ كالضرم",73,"م",1,0],["كما خص من بين الأنام بدفنه","بحجرته شرعاً وحساً وعن قصد",74,"د",1,0],["كم أخرج المشراط من بحارها","لئالئا ليس لها من قيم",75,"م",1,0],["كما ختمتُ يقيني والبصيرة في","هوى إمامٍ علا عمَّن يُساميهِ",76,"ي",2,0],["كما خدمَ الوالدين سيلقى","له خدماً منكمو وبنيكمْ",77,"م",1,0],["كمَاخِضِ الماءِ يَرجو مِنْهُ زِبْدَتَهُ","وليسَ للماءِ دِهْنٌ كيْ يُطاوِعَهُ",78,"ه",1,0],["كم أخلفت موعدي من غير معذرة","ولستُ أعلم كيف الصبر يأتيها",79,"ي",3,0],["كم اخترعْنا حدوداً بين وحدتنا","وكم حسبنا مرايا القلب تختلفُ",80,"ف",1,0]]}