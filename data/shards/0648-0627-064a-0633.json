{"poems":[[55,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[79,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[39,"وأيسار إذا الأبرام أمسوا","https://www.aldiwan.net/poem7627.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[87,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[64,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[47,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[47,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[47,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[47,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[50,"ألا حي المنازل بالعقيق","https://www.aldiwan.net/poem66579.html","الوافر"],[48,"ألا تتفقون الله رهط مسلم","https://www.aldiwan.net/poem22202.html","الطويل"],[48,"إذا قيل غال الدهر شيئا فإنما","https://www.aldiwan.net/poem23293.html","الطويل"],[48,"أجسما فيه هذي الروح هلا","https://www.aldiwan.net/poem23354.html","الوافر"],[19,"ألمً خيال موهِناً من تُماضرا","https://www.aldiwan.net/poem337.html",""],[78,"وا كبدا قد تقطعت كبدي","https://www.aldiwan.net/poem39438.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62221","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9905","الطويل"],[48,"ألا تتّقُونَ اللَّهَ رَهطَ مسلِّمٍ!","https://www.poetsgate.com/ViewPoem.aspx?id=18112",""],[113,"بذاتك طابت في الوجود العناصر","https://www.aldiwan.net/poem16331.html","الطويل"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[173,"ألا قل لمن أرهقته الذنوب","https://www.aldiwan.net/poem1681.html",""],[190,"سلوا عن مبيتي الليل كيف أبيته","https://www.aldiwan.net/poem43948.html","الطويل"],[253,"خلقت امرأ لا أخلط الجد بالهزل","https://www.aldiwan.net/poem1317.html",""],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[285,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[354,"أيا جيرة بلوى الأبرقين","https://www.aldiwan.net/poem15961.html","المتقارب"],[369,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[371,"وأيسر ما نال مني الغلي","https://www.aldiwan.net/poem17872.html","المتقارب"],[385,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[422,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[458,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[520,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[520,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[567,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[567,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[580,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138327",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[690,"","https://poetry.dctabudhabi.ae/diwan/poem/131375","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48881","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29611","البسيط"],[1504,"","https://poetry.dctabudhabi.ae/diwan/poem/143716","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102051","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105416","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114711","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110310","البسيط"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216446",""],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77292","الطويل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115246","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136977",""],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115426","الطويل"],[3046,"","https://poetry.dctabudhabi.ae/diwan/poem/143386","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134022","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33130","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131114",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131111",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40133","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4830,"وقالوا صِفْ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=203356",""],[5279,"الصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=215615",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5956,"الفخر الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=181850",""],[6093,"ألم تَرَ أن قلبيَ لا يتوبُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176027",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["وَأَيسَرُ ما أُلاقي أَنَّ هَمّاً","يُغَصِّصُني بِذا الماءِ الزُلالِ",0,"ل",1,0],["وَأَيسَرُ ما نالَ مِنّا الغَليلُ","أَن لا نُحِسُّ مِنَ الماءِ بَردا",1,"د",2,0],["وَأَيَّ سُرُورٍ لَمْ يَعُدْ بِمَسَاءَةٍ","وأي كمال لم يعاقب بنقصان",2,"ن",1,0],["وأيسار إذا الأبرام أمسوا","لغثيان الدواخن آلفينا",3,"ن",2,1],["وأَيسَارٌ إِذا الاَبرَامُ أَمسَوا","لِتَعثَانِ الدَّواخِنِ آلِفِينَا",4,"ن",2,0],["وأيسرُ حجةٍ للرأي مما","تكامل فيك يَعصِفُ باعتلالي",5,"ل",2,0],["وَأَيسَرُ مِن جُرحِ الصُدودِ فِعالُهُ","وَأَسهَلُ مِن سَيفِ اللِحاظِ مَضارِبُه",6,"ب",2,0],["وأيسرُ الأمر عندهم عملُ ال","فضة إذ يقلبونها ذهبا",7,"ب",2,0],["وَأَيسَرُ فائِتٍ خَلَفاً سَريعاً","رِقابُ المالِ يُرزَؤُها الكَسوبُ",8,"ب",1,0],["وَأَيسَرُ مِن بَذلِ الرَغائِبِ حَملُها","لِمُستَكثِرٍ أَعيا عَلَيهِ اِحتِمالُها",9,"ل",3,0],["وَأَيسَرُ ما قَدَّمتُ في مِثلِ شُكرِهِ","عَلى مِثلِها أَبياتُ شِعرٍ أَقولُها",10,"ل",3,0],["وَأَيسَرُ ما قَدَّمتَ لِلَّهِ طالِباً","لِمِرضاتِهِ أَيّامُ فَرضٍ تَصومُها",11,"م",3,0],["وأيسر من مباكرةِ الأعادي","مباكرةُ الحبيبِ لدى الشروقِ",12,"ق",1,0],["وَأَيسَرُ ما حَلَلتُمُ نَحرَ دارِعٍ","يَعُمُّكُمُ بِالسُكرِ وَالنَشَواتِ",13,"ت",1,0],["وَأَيسَرُ كَونٍ تَحتَهُ كُلُّ عالمٍَ","وَلا تُدرِكُ الأَكوانَ جُردٌ صَلادِمُ",14,"م",1,0],["وَأَيسَرُ مِن رُكوبِ الظُلمِ جَهلاً","رُكوبُكَ في مَآرِبِكَ الظَلاما",15,"م",2,0],["وَأَيسارَ لُقمانَ بنِ عادٍ سَماحَةً","وَجوداً إِذا ما الشَولُ أَمسَت جَرائِرا",16,"ر",2,0],["وَأَيَّ سَاقٍ قَطَعْتَ مِنْ قَدَمٍ","وأيَّ كفٍّ أَزَلتَ مِنْ عَضُدِ",17,"د",1,0],["وأَيْسَارِي إِذَا مَا الحَيُّ حَلَّتْ","بُيُوتُهُمُ بِكَادِي النَّبْتِ عَارِي",18,"ر",2,0],["وَأَيسَرُ مِن كَفّي إِذا ما مَدَدتُها","لِنَيلِ عَطاءٍ مَدُّ عُنقي لِذابِحِ",19,"ح",1,0],["وأيْسَرُ ما حلّلتُمُ نحرَ ذارعٍ،","يَعمُّكمُ بالسُّكرِ والنّشَوات",20,"ت",1,0],["وَأَيسَر وَصف مِن جَميلك دَوحة","يَجول بِها فكر وَيَرتَع ناظِرُ",21,"ر",1,0],["وَأَيسَرُ ما أَسعى لَهُ الفِقَرُ الَّتي","تُعَجِّزُ مَن قَبلي وَتُعجِزُ مَن بَعدي",22,"د",2,0],["وَأَيُّ سَعيِكَ لِلإِسلامِ ما حَمِدَت","لَكَ الخَلائِفُ فيهِ الوِردَ وَالصَدَرا",23,"ر",2,0],["وَأَيسَرُ شَيءٍ يَحُلُّ العُقودَ","وَيُصبِحُ مُهديهِ مُوسى الكَلِيما",24,"م",2,0],["وأيسرُ ما ألقاه في الحبّ أنّني","أتيه على المولى وأضخع للعبد",25,"د",1,0],["وايسر ما في حالة اليسر عندها","اهانة عزل الملك في طاعة البذل",26,"ل",1,0],["واي سبيل للسلو بحبها","إذا جبل الرحمن طيني بطينها",27,"ن",3,0],["وَأَيّ سَخاءٍ يُدَّعى كَسَخائِهِم","بِما مَلَكوا وَالجَوُّ أَغبَر عابِسُ",28,"س",1,0],["وَأَيْسَرُ حَقٍّ لِلْمكارِمِ عِنْدَهُ","إِذا هُوَ عَدَّ الْغُرْمَ فِيها مِنَ الْغُنْمِ",29,"م",1,0],["وَأَيْسَرُ ما كابَدَتْهُ النُّفُوسُ","مِنَ الأَمْرِ ما لَمْ تَجِدْ مِنْهُ بُدّا",30,"د",2,0],["وَأَيسَرُ ما حَلَّ بي بَعدَكُم","ضَنىً حالَ ما بَينَ روحي وَبَيني",31,"ن",2,0],["وَأَيُّ سِلكِ ثَناءٍ غَيرُ مُتَّصِلٍ","وَأَيُّ حَبلِ رِجاءٍ غَيرُ مَمدودِ",32,"د",1,0],["وَأَيسَرُ ما نالَ مِنّي الغَلي","لَ أَلّا أَحِسَّ مِنَ الماءِ بَردا",33,"د",2,1],["وَأيست مِن بَرئي كَما","يَئس الضَرير مِن الصَباح",34,"ح",1,0],["وأَيْسَرُ وَجْدي أنَّني في عراصها","أُذيبُ عليها القلبَ والقلبُ جامد",35,"د",1,0],["وايسرها خرير الماء حولي","وتغريد الطيور مع النسيم",36,"م",1,0],["وأيست من برء الطبيب لدائه","فاعتل قلبي للأياس بداء",37,"ا",2,0],["وأيست منه إذ رأت","عيناي نازلة البلا",38,"ا",1,0],["وأيسرُ كلِّ موتٍ موتُ عبدٍ","فقيرٍ زاهدٍ حَسَن السِّياقِ",39,"ق",1,0],["وأيسَرُ الجَهلِ ما يَرتَدُّ صاحِبُهُ","عنهُ كمن هَبَّ مُنتاشاً منَ العُمُقِ",40,"ق",1,0],["وأَيسرُ ما بي أَنَّني مِنْ تَدَلُّهِي","أَرُوحُ بِلاَ ذِهْن وأَغْدُو بلاَ لٌبِّ",41,"ب",1,0],["واى سلطان سن ظل ثابتةً","اركانه كجمال العلم دون عفا",42,"ف",2,0],["وأيسر ما يشجيك أن مجاوري","ضريح أبيك السبط عن قبره نفوا",43,"ف",3,0],["وأيسر للزرابي مدّمنه","قنان الاكم مترعة وهادا",44,"د",2,0],["وأيسر لي فقدي بقية صحتي","لدى القوم من فقدي الأمانة والعهدا",45,"د",2,0],["وَأَيسَرُ ما فِيها جِنانٌ تَنَظَّمَت","مِنَ النَّخلِ وَالأَشجارِ والنَّبتِ والزَّهرِ",46,"ر",1,0],["واي سيف حز منك منحراً","جرى به دم الهدى مندفقا",47,"ق",2,0],["وَأَيُّ سائِسِ مُلكٍ وَاِبنُ سائِسَةٍ","وَأَيُّ عُدَّةِ أَملاكٍ وَمُدَّخَرِ",48,"ر",1,0],["وأيسرُ خطْبٍ عاقَ عزمي عن الصِّبا","مَشيبٌ تداعتْ في العِذار وفودُهُ",49,"د",2,0],["وأيست إِلا منكم","غفراً لمن قد أفرطا",50,"ط",2,0],["وأيسر خطب في الهوى لوم لائم","ولا بد دون الشهد من أبر النحل",51,"ل",1,0],["وأَيسَرُ وَجدي في فِراقِكَ أَنَّهُ","سيبقى عليكَ الوَجدُ ما بقيَ الزَّمَن",52,"ن",1,0],["واي سيفٍ كسعدٍ انت واجده","كأنه من سيوف اللَه مسلول",53,"ل",1,0],["وَآيسْت من لي بْوَصله شْفيت","أبو ثمانٍ بيض وِضَّاح",54,"ح",1,0],["وَأَيسَرُ ما في خَطبِنا أَنَّ أُمَّةً","بِمِصرَ مِنَ القِبطِ الأَماثِلِ وَالعُربِ",55,"ب",1,0],["وأيسر ما عندي المواساة مسمحاً","إذا لم تجد يوماً صديقاً مواسيا",56,"ي",2,0],["وَأَيسارِ صِدقٍ قَد أَفَدتُ جَزورَهُم","بِذي أَوَدٍ خَبشِ المَذاقَةِ مُسبِلِ",57,"ل",1,0],["وأيسر خطبي والهموم فوادحٌ","يهدّم رضوى عنده وثبير",58,"ر",1,0],["وأيسر ما يدعوه أن فؤاده","به خفقان لا يقر وحيبه",59,"ب",2,0],["وأيسَرُنا هوىً من حازَ دَمعاً","يَفيضُ جَوىً وقلباً يُستطارُ",60,"ر",1,0],["واي سرور مثل عود رئاسة ال","وزارة إذ اضحى لأوجك يرفع",61,"ع",1,0],["وَأَيسوفِيّاً تَرجوكَ مِثلَ قِيامَةٍ","فَذا الفَتحُ يَعلو العالَمينَ جِهارُهُ",62,"ر",2,0],["وأيسر شيء في هواك لقيته","ضنى ما لهذا الجسم من دونه برد",63,"د",1,0],["وأيسر شيء أنت فيه سعادة","وأهون ما ألقاه منك شقاء",64,"ا",2,0],["وَأيّ سُيوفِكَ الحُمرِ الحَواشي","مَنزِلَة مَتى دُعِيَتْ نَزَالِ",65,"ل",1,0],["وأيسر حدٍ يلزم النازح الفتى","من الحقّ بسط العذر للدّالف اليفنْ",66,"ن",1,0],["وأيُّ سُلافةٍ أروى انتشاءً","فدونَكُمُ رِضابَ الغيدِ رَضْبا",67,"ب",2,0],["وَأَيُّ سِلْمٍ وَيَنْسَى الأَمْسَ ظُلْمَتَهُمْ","وَأَيُّ صَبْرٍ يَرَاهُ النَّاسُ قَدْ نَفَعَا",68,"ع",2,0],["وأيّ سلامٍ بعد مامات ظالما","وأيّ حليمٍ بعد ذلك يشفعُ ؟!!!",69,"ع",1,0],["وأيسَرُ فعلتي هي تَركُ طيفٍ","يشاركهنَّ في كل المسائلْ",70,"ل",1,0],["وَ آيَسْتُ العَذولَ فَقُلْتُ يَوْمَاً","سيَبْقَى الحُبُّ مَا بقيتْ قُلُوْبُ",71,"ب",1,0],["وأي سلم به نشدو بلا خجل","وأرضنا في دروب القمع تنتحب",72,"ب",1,0],["وأي سلم وللمأساة قافلة","تكاد من شاطيء التحرير تقترب",72,"ب",1,0]]}