{"poems":[[37,"رأيت غرابا ساقطا فوق بانة","https://www.aldiwan.net/poem39145.html","الطويل"],[29,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[12,"","https://poetry.dctabudhabi.ae/diwan/poem/11833","الطويل"],[190,"رأيت الخير في عيني صغيرا","https://www.aldiwan.net/poem43432.html","الطويل"],[216,"لقد لذ لي الظبي الأغن عتابه","https://www.aldiwan.net/poem37877.html","الطويل"],[239,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem4604.html","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130748","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[5790,"سألت من أمرضني","https://www.poetsgate.com/ViewPoem.aspx?id=112144",""]],"verses":[["فَقالَ غُرابٌ لِاِغتِرابٍ مِنَ النَوى","وَفي البانِ بَينٌ مِن حَبيبٍ تُجاوِرُه",0,"ر",2,0],["فَقالَ غَناءً عَنكَ في حَربِ جَعفَرٍ","تُغَنّيكَ زَرّاعاتُها وَقُصورُها",1,"ر",3,0],["فَقال غُرابٌ لا اغتِرابٌ مِنَ النَّوى","وبِالبانِ بَينٌ مِن حَبيبٍ تُعاشِرُه",2,"ه",1,1],["فقال غلبت والدنيا ضروبٌ","تقلب أهلها في كل حال",3,"ل",1,0],["فقال غداً لا عذرَ أنت تزورني","فقلت لعَمْرِي قطُّ ما كنت أعجزُ",4,"ز",1,0],["فَقالَ غُرابٌ بِاِغتِرابٍ مِنَ النَوى","وَبانٌ بِبَينٍ مِن حَبيبٍ تُحاذِرُه",5,"ر",2,0],["فقال غضوباً بل فكوني دليلتي","على خافيات الدار أو نالك الضر",6,"ر",1,0],["فقال غاديةٌ للفِكْرِ قد نشأتْ","فقلتُ ما أحْوجَ الظّامي لسُقْياها",7,"ا",3,0],["فقال غصبا قلت لا","إلا سماحا وكرم",8,"م",1,0]]}