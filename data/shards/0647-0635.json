{"poems":[[79,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[75,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[90,"يا من قضى بين المياة غريقا","https://www.aldiwan.net/poem45030.html","الكامل"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[76,"ألا دعاني اليوم داعي النهى","https://www.aldiwan.net/poem12862.html","السريع"],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[215,"أعود وحدي أعود","https://www.aldiwan.net/poem46767.html","المجتث"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[287,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[457,"وذي ترف رخيم الدل يرنو","https://www.aldiwan.net/poem13925.html","الوافر"],[463,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[578,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38380","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62575","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48946","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48988","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48989","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141320","الوافر"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76646","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76602","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48271","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77274","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76013","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100367","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126933","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92007","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216812","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131235",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103785","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86447","الخفيف"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106729","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117241","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[5431,"الريم ..لوحة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=206889",""]],"verses":[["هصَرْتَ منْ أغْصانِهِ ذُبُلا","وصُغْتَ منْ غُدْرانِه أذْرُعا",0,"ع",2,0],["هَصَرْتَ ثِمَارَ الْعِزِّ طَيِّبَةَ الْجَنَى","وَشَيَّدْتَ مَثْوَى الْفَخْر مُسْتَحْكم الْبنَا",1,"ن",2,0],["هُصِرَ النَعيمُ بِعَطفِ دَهرِكَ فَاِنثَنى","وَجَرى الفِرِندُ بِصَفحَتَي دُنياكا",2,"ك",2,0],["هَصَرتُ بِفَودي رَأسِها فَتَمايَلَت","عَلَيَّ هَضيمَ الكَشحِ رَيّا المُخَلخَلِ",3,"ل",1,0],["هصرتك أيدي الموت غصناً ناضراً","يهتز في روض العلاء وريقا",4,"ق",2,0],["هصرت بك الأيام دوحة سودد","مكتنة الأثمار في الأوراق",5,"ق",1,0],["هَصَرتُ فيهِ مِن غُضونِ الصِبا","وَبِتُّ أَجني مِن ثِمارِ الذُنوب",6,"ب",1,0],["هصرت به غصناً نضيراً تفتّحت","أزاهيرهُ في ظل خضراء لفّاء",7,"ا",2,0],["هصرتُ في الليل غصنَك","هصرتهُ وهصرتُه",8,"ه",1,0],["هَصَرتُ قوامَها بذؤابَتيها","فلامَسَ رأسُها حَبلَ الوريد",9,"د",1,0],["هَصورُ العِدا شاكي السِلاحِ فَقِرنُهُ","لَدى أَسَدٍ أَظفارُهُ لَم تُقَلَّمِ",10,"م",1,0],["هصرت به غصناً من البان يانعاً","وقلتُ لذات الخال روحي لك الفدا",11,"د",2,0],["هصرتُ به فسالَ به التَّثني","وعادَ كما بَدَا لدن القَوامِ",12,"م",1,0],["هصورٌ تقبض الأقدارُ عنه","حبائلَها إذا بسط الذراعا",13,"ع",2,0],["هَصَرَت مِنهُما المَنونُ قَضيبَينِ","فَمالا مَعاً إِلى التَصريحِ",14,"ح",1,0],["هَصور مهيب يَقصِمُ الظّهرَ صيتهُ","وَما كلُّ صيتٍ لِلظهورِ بِقاصِمِ",15,"م",1,0],["هصرتُ بها غصناً من الحَليْ مُثمِراً","يميل كغصن البانة المتأوّدِ",16,"د",1,0],["هصر الخريفُ غصونَها فتناوحت","شجناً على أفنانها الورقاءُ",17,"ا",2,0],["هصرته ريحُ المنيّةِ من أوراقِهِ","وَهْيَ صرَّةٌ نَكْباء",18,"ا",2,0],["هُصِرَ الغصنُ في الضُّحى رَطِبا","وهو جانٍ من النُّهى رُطَبا",19,"ب",2,1],["هصورٌ ما تلقى النور حتى","رأى لبنان في ذلٍ فثارا",20,"ر",2,0],["هصرت لي الآمال طيبة الجنى","وسوغتني الاحوال مقبلة الدنا",21,"ن",2,1],["هصرت يدي غصن الغنى من دوحه","وجنت به روض السرور منورا",22,"ر",2,0],["هَصَرَتْ يدى غُصْناً ولولا خشيةُ ال","باري العظيمِ مددْتُها لتقاهُ",23,"ا",2,0],["هَصَرَت بِأَعطافِ الشَمالِ وَنادَمَت","شادي الصبا فَاللَهوُ فيها تَوأَمُ",24,"م",1,0],["هَصَرتُ بِذيّاكَ القَوامِ أَراكَةً","وَأفنيتُ تلكَ الراحَ مِن ريقِه رَشفا",25,"ف",2,0],["هصرت الفود منه فخال أني","لثمت بخده الوريدّ خالا",26,"ل",2,0],["هصر الموت أي غصن رطيب","من أولي المكرمات آل شبيب",27,"ب",1,1],["هصر الزَمانُ قَوامَ غصنٍ يانعٍ","فَبكت عليه وَناحَت الوَرقاء",28,"ا",2,0],["هصرت على أصل الحياة فروعهم","وتناثرت بدداً عن الأغصان",29,"ن",1,0],["هصروك ريان الشباب مؤملاً","غمر الندى طلق الجبين نجيدا",30,"د",2,1],["هصرت يدي منه بغصن ناعم","لم أجن غير الحل من ثمراته",31,"ت",2,0],["هصرتني الأرزاء عوداً يبيسا","ولقد كنت قبل غصناً رطيبا",32,"ب",2,0],["هَصَرتُهُ وَجُفونُ الشُهبِ ساهِرَةٌ","وَأَشقَرُ البرقِ في نَقعِ الغَمامِ كَبا",33,"ب",2,0],["هصروا بروض الغرب أغصان الصفا","فسرَت شمالٌ بالمنى وجنوب",34,"ب",1,0],["هصرت الأرض كيناء","وثقفت الأطباء",35,"ا",2,0],["هصورٍ يبزُّ المعتدين ضراوة","ودودٍ كجسرّ للتلاقيَ يُنصّب",36,"ب",1,0]]}