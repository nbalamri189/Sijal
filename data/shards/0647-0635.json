{"poems":[[77,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[88,"يا من قضى بين المياة غريقا","https://www.aldiwan.net/poem45030.html","الكامل"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[74,"ألا دعاني اليوم داعي النهى","https://www.aldiwan.net/poem12862.html","السريع"],[209,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[209,"أعود وحدي أعود","https://www.aldiwan.net/poem46767.html","المجتث"],[268,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[280,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[413,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[450,"وذي ترف رخيم الدل يرنو","https://www.aldiwan.net/poem13925.html","الوافر"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[571,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"]],"verses":[["هصَرْتَ منْ أغْصانِهِ ذُبُلا","وصُغْتَ منْ غُدْرانِه أذْرُعا",0,"ع",2,0],["هَصَرْتَ ثِمَارَ الْعِزِّ طَيِّبَةَ الْجَنَى","وَشَيَّدْتَ مَثْوَى الْفَخْر مُسْتَحْكم الْبنَا",1,"ن",2,0],["هُصِرَ النَعيمُ بِعَطفِ دَهرِكَ فَاِنثَنى","وَجَرى الفِرِندُ بِصَفحَتَي دُنياكا",2,"ك",2,0],["هَصَرتُ بِفَودي رَأسِها فَتَمايَلَت","عَلَيَّ هَضيمَ الكَشحِ رَيّا المُخَلخَلِ",3,"ل",1,0],["هصرتك أيدي الموت غصناً ناضراً","يهتز في روض العلاء وريقا",4,"ق",2,0],["هصرت بك الأيام دوحة سودد","مكتنة الأثمار في الأوراق",5,"ق",1,0],["هَصَرتُ فيهِ مِن غُضونِ الصِبا","وَبِتُّ أَجني مِن ثِمارِ الذُنوب",6,"ب",1,0],["هصرت به غصناً نضيراً تفتّحت","أزاهيرهُ في ظل خضراء لفّاء",7,"ا",2,0],["هصرتُ في الليل غصنَك","هصرتهُ وهصرتُه",8,"ه",1,0],["هَصَرتُ قوامَها بذؤابَتيها","فلامَسَ رأسُها حَبلَ الوريد",9,"د",1,0],["هَصورُ العِدا شاكي السِلاحِ فَقِرنُهُ","لَدى أَسَدٍ أَظفارُهُ لَم تُقَلَّمِ",10,"م",1,0],["هصرت به غصناً من البان يانعاً","وقلتُ لذات الخال روحي لك الفدا",11,"د",2,0],["هصرتُ به فسالَ به التَّثني","وعادَ كما بَدَا لدن القَوامِ",12,"م",1,0],["هصورٌ تقبض الأقدارُ عنه","حبائلَها إذا بسط الذراعا",13,"ع",2,0],["هَصَرَت مِنهُما المَنونُ قَضيبَينِ","فَمالا مَعاً إِلى التَصريحِ",14,"ح",1,0]]}