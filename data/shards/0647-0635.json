{"poems":[[77,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[88,"يا من قضى بين المياة غريقا","https://www.aldiwan.net/poem45030.html","الكامل"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[74,"ألا دعاني اليوم داعي النهى","https://www.aldiwan.net/poem12862.html","السريع"]],"verses":[["هصَرْتَ منْ أغْصانِهِ ذُبُلا","وصُغْتَ منْ غُدْرانِه أذْرُعا",0,"ع",2,0],["هَصَرْتَ ثِمَارَ الْعِزِّ طَيِّبَةَ الْجَنَى","وَشَيَّدْتَ مَثْوَى الْفَخْر مُسْتَحْكم الْبنَا",1,"ن",2,0],["هُصِرَ النَعيمُ بِعَطفِ دَهرِكَ فَاِنثَنى","وَجَرى الفِرِندُ بِصَفحَتَي دُنياكا",2,"ك",2,0],["هَصَرتُ بِفَودي رَأسِها فَتَمايَلَت","عَلَيَّ هَضيمَ الكَشحِ رَيّا المُخَلخَلِ",3,"ل",1,0],["هصرتك أيدي الموت غصناً ناضراً","يهتز في روض العلاء وريقا",4,"ق",2,0],["هصرت بك الأيام دوحة سودد","مكتنة الأثمار في الأوراق",5,"ق",1,0],["هَصَرتُ فيهِ مِن غُضونِ الصِبا","وَبِتُّ أَجني مِن ثِمارِ الذُنوب",6,"ب",1,0]]}