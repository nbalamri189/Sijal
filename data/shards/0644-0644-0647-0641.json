/diwan/poem/106743","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97094","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90893","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90998","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111191","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83590","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83396","البسيط"],[4474,"","https://poetry.dctabudhabi.ae/diwan/poem/139827",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4929,"الحق ورايته (اكناف بيت المقدس)","https://www.poetsgate.com/ViewPoem.aspx?id=208723",""],[4935,"دع قول كل مكابر ومرائي","https://www.poetsgate.com/ViewPoem.aspx?id=129437",""],[4984,"قُرْبَان .","https://www.poetsgate.com/ViewPoem.aspx?id=191138",""],[5009,"مناجاة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=24372",""],[5075,"الله مولانا","https://www.poetsgate.com/ViewPoem.aspx?id=190435",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5212,"حِبالُ الموت","https://www.poetsgate.com/ViewPoem.aspx?id=212025",""],[5376,"يا ويل حالي قد بليت بداء","https://www.poetsgate.com/ViewPoem.aspx?id=188560",""],[5376,"على مشارفِ عيد اللهِ مبتسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205890",""],[5720,"جمعيةُ التحفيظِ","https://www.poetsgate.com/ViewPoem.aspx?id=199528",""],[402,"خفقت لطلعة وجهك الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=36313",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5853,"((رهطٌ من الجن))","https://www.poetsgate.com/ViewPoem.aspx?id=175656",""],[5922,"فلم الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=185134",""],[5997,"يا هاجري","https://www.poetsgate.com/ViewPoem.aspx?id=214976",""],[6069,"لله في زمن الربيع وصائفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=105651",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[520,"في مثل ذا الموقف المشهود تنتخب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577437",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""],[5355,"حبٌّ فرديٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87214&r=&rc=39",""]],"verses":[["للّهِ في إنْجازِ نصْرِكَ موْعِدٌ","قد آنَ منْ إصْباحِهِ إسْفارُهُ",0,"ر",2,0],["للهِ فِيكُمْ مَنْ دَعَا","لِلصَّالِحَاتِ وَمَنْ أَجَابَا",1,"ب",2,0],["للهِ فِيكَ وَلِلبِلادِ ولِلعُلَى","هَذَا الْوَلاءُ وَذَلِكَ الإكْرَامُ",2,"م",1,0],["لله في وجه ابن آدم حكمة","يعنو السفيه لها ومن يتحكّم",3,"م",1,0],["للهِ فضلُ محمدٍ ماذا على","أقلامِنا تملي علاهُ وتكتب",4,"ب",1,0],["لله فيهِ سريرةٌ مكنونةٌ","فصفاتها الإعياء دون صفاتها",5,"ت",3,0],["للَّهِ فتيانُ لهوٍ مالَ مائلُهُم","إلى التعاليلِ والعيشُ التعاليلُ",6,"ل",1,0],["لِلَّهِ في الغابَةِ أَيّامُنا","ما عابَها إِلّا تَلاشيها",7,"ي",3,0],["لله في نصرة اليابان حكمته","لا يُسأل الله عن فعل ولا شان",8,"ن",1,1],["لله في وادي العيون صبوحنا","والضد ينهل كل عين آنيه",9,"ن",3,1],["للهِ فيه يَدٌ يُضئُ شُعاعُها","سُبُلَ الحياةِ وللنبيِّ لِسانُ",10,"ن",1,0],["لِلّهِ فيما تَفعلون بِدينهِ","عَهدٌ أَبرُّ وَمَوعدٌ ما يُخلَفُ",11,"ف",1,0],["للّهِ فيكَ سريرَةٌ لوْ أُعلِنَتْ","أحيَا بذِكرِكَ قاتِلٌ مَقُتولا",12,"ل",2,0],["للهِ في لُبْنَانُ مَا أَبْهَاهُ مِنْ جَبَلٍ","يَمْشِي بِهِ الْحُسْنُ تَصْويْباً وَتَصْعِيدا",13,"د",2,0],["للهِ في الخَفِرَاتِ مَنْ آثَرْتَهَا","فَظَفِرْتَ بالأَسْنَى مِنَ الآرَابِ",14,"ب",1,0],["للهِ فِي حَفْلِ الزَّفَافِ","وَرَوْعَةِ الْيَوْمِ الأَغَرْ",15,"ر",1,0],["للهِ فِي الخَلْقِ آيَاتٌ وَأَعْجَبُهَا","تَجْدِيدُ رَوْعَتِهَا فِي كُلِّ تَجدِيدِ",16,"د",1,0],["لِلّهِ فِي نُوَبِ الْحَوَادِثِ حِكْمَةٌ","ليْسَتْ تُحِيطُ بِكُنْهِهَا الأَفْكَارُ",17,"ر",1,0],["لله فيه يد يضيء شعاعها","سبل الحياة وللنبي لسان",18,"ن",1,0],["لله في الغابة أيّمنا","ما عابها إلاّ تلاشيها",19,"ي",3,0],["لله في بطحاء ام عبيدة","بحر يموج بنائل زخار",20,"ر",1,1],["لله في طي هذا الكون آيات","له بتصريفها محو واثبات",21,"ت",1,1],["لله في الارض احكام يصرفها","تفيضها من خفاياها السموات",21,"ت",1,0],["للَه فيها قدرة مع ضعفها","تلقى صدور الناس من الأعتاب",22,"ب",1,0],["لِلهِ في الأرضِ أقوامٌ قد اشْتَملوا","بالعزّ واعتدلوا حقّاً وما عدلُوا",23,"ل",3,1],["لله في الخلق أسرار مخبأةٌ","من دونها رُتَّجُ الأبواب والغُلُقُ",24,"ق",1,0],["لله في كل ما يجري به القدرُ","في خلقه حكمةٌ مضمونها الخبرُ",25,"ر",1,1],["لله فيك عناية لا تقتضي","إلا القيام بِنصرك الإِيمانا",26,"ن",2,0],["للهِ فيكَ عنايةٌ تكفي بها","عن حسنِ تدبيرِ وكيدِ عُداةِ",27,"ه",1,0],["للهِ فيكَ ولم يدرِ الجهولَ بهِ","سرٌّ خفيٌّ ووعدٌ لم يكن كِذبا",28,"ب",2,0],["لله فيك عنايةٌ ولأَجلها","يلقاك بالذكرى لكي تتذكرا",29,"ر",2,0],["لله فيك على البرية حجةٌ","وعليه منك أدلةٌ لا تحصرُ",30,"ر",1,0],["لله في الخلق أقدار ينفّذها","لولا الجبان لما أثني على البطل",31,"ل",1,0],["لله فتى مزق ثوب السلوى","ثم ادرع الصبر لحمل البلوى",32,"ل",3,1],["للّه في النارِ التي وقَعَت به","سرٌّ عن العقلاء لا تُخفيه",33,"ه",1,1],["لله في خلقه حكمٌ بحكمته","تفرق الروح والجسمان وأتلفا",34,"ف",2,0],["لله فضلٌ في الوجود أفاضه","كم نعمةٍ وتفَضُّلٍ للّه",35,"ل",2,0],["لله في أيدي الأنام مواهب","فجميعُ ما ملك الورى للّه",35,"ل",2,0],["لله فينا رحمةٌ مبثوثةٌ","نحيي بها وبرَأفَةٍ لله",35,"ل",2,0],["لله في أحكامهِ وقضائهَ","حكمٌ فسلِّم أمرَها لله",35,"ل",2,0],["لِلَهِ في القاضي الوَزيرِ سَريرَةٌ","مِنها تَبَوَّأَ مِنهُ أَعلى مَنزِلَه",36,"ل",2,0],["للهِ فاتنة تملَّك قلبَ مَنْ","تُحنى لديه من الرجالِ رؤوسها",37,"س",3,0],["لله في خلقه سرائر لا","تحصى ولا تهتدي لها البصر",38,"ر",1,0],["للّه في خضراءِ تونس دولةٌ","رَفَعت بِمولانا المشير منارا",39,"ر",2,0],["لِلّه في خَلقِهِ لُطف وَتَجربةٌ","وَالمحسن البرُّ ما يَختاره حسنُ",40,"ن",1,0],["للهِ فتّانةٌ محاسِنُها","ضلَّ افْتِتاناً بحُسْنِها أُمَم",41,"م",1,0],["للهِ فَخْرُ الدِّينِ مثْل ماجدٍ","أَزْرَتْ يَداهُ بالغُيوثِ الوُكَّف",42,"ف",1,0],["لِلَهِ في الأَرضِ مِن ذا البَيتِ أَربَعَةٌ","سُحبٌ وَرَوضٌ وَأَقمارٌ وَأَطوادُ",43,"د",1,0],["للَه فعلكَ بي وما أُثني به","عنه وفِعلي أن جعلتُك مَقصِدا",44,"د",2,0],["للهِ فيكَ إراداتٌ حباكَ بها","ربُّ الأنام وسرٌّ فيك مكنونُ",45,"ن",1,0],["للهِ في خَلْقِه قَضايا","نافِذَةٌ ما لَها مَرَدُّ",46,"د",1,1],["لله فيه سريرةٌ نبويّةٌ","عَرَفَتْ جميعُ الخلق رفعة شانها",47,"ن",3,0],["لله فضلك في الوجود فإنَّه","تَركَ البريَّة كلّها حسادا",48,"د",2,0],["للَّه فوار ماءٍ كاللجين بدا","في حوضه لاعباً يهدي لنا دررا",49,"ر",2,1],["لله فواد هيجه","عهد الأحباب بذكرهم",50,"م",1,0],["للهِ فيه جامعاً","أحسنَ أوصافِ القلَمْ",51,"م",1,0],["للّه فضلك ما أدقّ فنونه","علما وقولك ما أحقّ وأصدقا",52,"ق",2,0],["للهِ فِي الإِشراكِ منك وقائعٌ","أَرْبَتْ عَلَى حَرْبِ الذَّنائِبِ مَشْهَدَا",53,"د",2,0],["لِلّه فينا جرت أحكامه فقضت","حرف المقادير دون الفعل أحزمنا",54,"ن",2,0],["لله في ذا الخلق أح","كام تجل عن الغلط",55,"ط",1,1],["لله في طُرْقِ المعالي فِتيةٌ","رفيقُهم على الزمان حاكمُ",56,"م",1,0],["لله فيه شؤون","وقد كساه الجلالا",57,"ل",2,0],["لله في الكون عهدٌ قد جرى ومضى","فانظر لعهدٍ بنسج الكون معهود",58,"د",1,1],["لله في كشف الكروب لطائفٌ","يعنز لها فكر اللبيب الحاذق",59,"ق",1,1],["لله في هذه الأكوان أفرادُ","لهم من المدد القدسي إسعادُ",60,"د",1,1],["لله في بَطْحاءِ أُمِّ عَبيدَةٍ","بَطَلٌ لنا في الحادِثاتِ أبِيُّ",61,"ي",1,0],["للهِ في حيشَ عبدٌ في حَظيرَتِهِ","طَوْرُ الجَمالِ تَجَلِّى غيرَ مَطْموسِ",62,"س",1,1],["للّهِ فيهِم أسرةٌ لا تُفتَدى","أسْرى الهَوى من سجنِهم بنُقودِ",63,"د",1,0],["للّهِ في تقسيمِ جوهرِ فردِه","حكَمٌ بدَتْ في هذه الأجزاءِ",64,"ا",2,0],["لله في أهل هذا القصر سابقة","من الإرادة من أسرارها عجب",65,"ب",1,0],["للهِ في خَلْقِهِ ما شَاءَ مِنْ نَظَرِ","فاصْبِر عَلَى الصَّفْوِ مِنْ دُنْياكَ والكَدَرِ",66,"ر",1,1],["لِلَّه فِي هَذا الوجُود بَدَائِعٌ","أسرَارُهَا جَلَّت عَنِ الإِدرَاك",67,"ك",1,0],["لِله في مُرَّاكُشٍ قبرٌ بِه","قد كُوِّرَت شمسُ العُلاَ والسُّؤدَدِ",68,"د",1,1],["لله في الكون تحريكٌ وتسكينُ","قل لي فما تفعل القوم المجانينُ",69,"ن",1,1],["لله في كل ما يبديه تعليلُ","والخلق تكثيرُه في الأمر تقليلُ",70,"ل",1,1],["للهِ في الخلَقِ سِرٌّ ليس نُدرِكُهُ","وحِكمةٌ بَطَلَتْ من دُونِها الحِكَمُ",71,"م",1,0],["للهِ في الخَلْقِ سِرٌّ ليسَ نُدرِكُهُ","وكيفَ يُدرِكُ عبدٌ سِرَّ مَوْلاهُ",72,"ا",2,0],["للهِ فِيها قَائِماً","وعَلَى سِوَاكَ الكَأْسُ دَائِر",73,"ر",1,0],["لله في ألمعي فاضل ورع","مهذب أريحي ذي تقى سام",74,"م",1,0],["لله فتنة ذاك الطرف منك لقد","سبى المحبين لحظ منه فتان",75,"ن",1,0],["للّه فيكَ سرائرٌ لا تُعْلَمُ","يَمْضي بها القَدَرُ المُتَاحُ ويَحْكُمُ",76,"م",1,1],["لِلَّهِ فيكُم سِرُّ غَيبٍ لَم يَزَل","مُتَبَلِّجاً في الوِردِ وَالإِصدارِ",77,"ر",1,0],["لله فقدُ الشيخ خطباً فادحاً","بنظيره ما سارت الأبناء",78,"ا",2,0],["لله فجعة بطرسٍ كم فتَّتت","كبدي والقت في فوادي اسهما",79,"م",2,0],["لله فرقة بطرس كم أوحشت","تلك الربوع وأظلمت ذاك الحما",79,"م",2,0],["لله فسحة دارٍ أشرقت وزهت","بحسن أفضل جلاَّس كأقمارِ",80,"ر",1,1],["لله في الكون تقدير وتدبير","وفلي البرية احكام وتصوير",81,"ر",1,1],["لله في الاكوان سر سرى","في الخلق بالمعنى الذي قد بهر",82,"ر",1,0],["لله فضل العلم من خطه","لا فخر إلا وهو ن فخره",83,"ر",2,0],["لِلَّهِ فِي يَوْمِ الحُرُوبِ مُحَمَّدٌ","وَالأَرْضُ تُشْرِقُ بِالقَنَا الْمُتَوَشّجِ",84,"ج",1,0],["لِلَّهِ فيمَن هُناكَ قَومٌ","هَمُّ تَنائيهمُ يهُمُّ",85,"م",1,0],["لله فى هذى العبا","د مشيئة ليست تبور",86,"ر",1,0],["لله في ثوبِ الزمانِ واحدٌ","منك بغير المدح ما تلذَّذا",87,"ذ",2,0],["للهِ في الأوطانِ مصرعُكَ الذي","صرعَ النفوسَ وفتَّ في الأَبدان",88,"ن",1,0],["للهِ في بيروتَ نعشُكَ عائماً","يُزجى ببحرِ المدمع الهتَّان",88,"ن",1,0],["لِلَهِ فُؤادٌ مُلتَهِبٌ","قَد كادَ يُضيءُ تَوَقُّدُهُ",89,"د",2,0],["لله فيه بكل عصرٍ آية","كبرى يبلغها نبي مرسل",90,"ل",1,0],["لله فرطُ جمالٍ بات يشغُلني","عن كل شيءٍ وللأحزان خَلاَّاني",91,"ن",2,0],["لِلَّهِ فارِسُهَا المِقدَامُ مُستَهِلاً","إذا بَنُو الحَرْبِ مِن راوُوقِهَا شَرِبُوا",92,"ب",3,0],["لِلّهِ فِعلُكَ في ابنِ عَمِّكَ إِنَّهُ","فِعلٌ عَلَيهِ مِنَ السُعُودِ أَمارُ",93,"ر",1,0],["للَّهِ فتحٌ شريفُ القدرِ قد جنحتْ","من طيبِ أخبارهِ الورقاءُ للطربِ",94,"ب",1,0],["لِلّه في ذمة الركب الشآ