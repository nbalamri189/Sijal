{"poems":[[53,"أرى الصبر محمودا وعنه مذاهب","https://www.aldiwan.net/poem8316.html","الطويل"],[48,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[164,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[287,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[408,"أتت تفتر عن زهر الأقاح","https://www.aldiwan.net/poem46912.html","الوافر"],[466,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34413","الطويل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82248","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132842","الوافر"],[2820,"","https://poetry.dctabudhabi.ae/diwan/poem/29514","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45971","الطويل"],[4978,"تشطير ضحكت دموعا","https://www.poetsgate.com/ViewPoem.aspx?id=177265",""],[5431,"فلا تشتكوا حزنا ولا تأبهوا خسفا","https://www.poetsgate.com/ViewPoem.aspx?id=197060",""]],"verses":[["ولكن ضروريان كالشيء يُبتلى","به المرءُ مَغْلوباً وكالشيء يذهبُ",0,"ب",1,0],["وَلَكِن ضِدُّهُ في الرَبعِ قَينٌ","أَطارَ إِلَيكَ مُفتَرِقَ الشَرارِ",1,"ر",1,0],["ولكن ضعف الحظ يفسد صالحي","ويجعل ملحا مائي البارد العذبا",2,"ب",2,0],["وَلَكِنَّ ضَعفَ الحالِ أَوهى عَزيمَتي","فَسُقتُ إِلَيهِ الشِّعرَ وَهوَ رَسولُ",3,"ل",1,0],["ولكِنْ ضمّنتْ منه عتاباً","بلا ذَنبٍ أتيتُ ولا اجتراحِ",4,"ح",1,0],["ولكِنْ ضارِبٌ بالصُّبْحِ","مَنْ أعْيَتْ مَقاتِلُهُ",5,"ل",2,0],["وَلَكِنَّ ضيقَ العَيشِ أَوجَبَ غُربَتي","وَسَعيي لَهُم في الأَرضِ كي يَتَوسَّعوا",6,"ع",3,0],["وَلَكِن ضَبَّ جَندَلَةٍ أتينا","مضّباً في مكامنه يفَسّي",7,"س",2,0],["ولكن ضاقَ صدري من أُنَاسٍ","أَخَفُّهم على قَلبي ثَبيرُ",8,"ر",1,0],["وَلكِنَّ ضُعفَ الأَمرِ أَلّا تُمَرَّهُ","وَلا خَيرَ في ذي مِرَّةٍ لا يُغيرُها",9,"ر",3,0],["ولكنَّ ضيرًا بنا أن نذوق","وإن كان لا بد أن نفعلا",10,"ل",2,0],["وَلكِن ضَرَواتُ الزَمانِ كَثيرَة","وَحَسبُكَ مِنها ما تَبَدّى حِسابُهُ",11,"ب",2,0],["(ولكن ضحكي كالبكاء بحسرةٍ )","فقد تدمع العينان ضحكا على البصل",12,"ل",1,0],["ولكنّ ضوء الفجر ضاعت شموسه","وقد أوغلتْ ريح الشتات بنا عصفا",13,"ف",2,0]]}