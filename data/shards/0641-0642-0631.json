{"poems":[[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[63,"كلماتي قلائد الأعناق","https://www.aldiwan.net/poem45891.html","الخفيف"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[55,"قد جمع الله لي شملي بقربكم","https://www.aldiwan.net/poem26397.html","البسيط"],[34,"لعمرك إني يوم جرعاء مالك","https://www.aldiwan.net/poem4907.html","الطويل"],[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.aldiwan.net/poem35977.html","الطويل"],[77,"تقهقه عند رؤيته الثكالى","https://www.aldiwan.net/poem35871.html","الوافر"],[9,"وقد أغلقت حلقات الشباب","https://www.aldiwan.net/poem21948.html","المتقارب"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[88,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[23,"لعمرة بالبطحاء بين معرف","https://www.aldiwan.net/poem21350.html","الطويل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"إذا ما شنطف نكهت أماتت","https://www.aldiwan.net/poem65079.html","الوافر"],[51,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[29,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[91,"إلى حيث ألقت يا زمان المظالم","https://www.aldiwan.net/poem62715.html","عموديه"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[85,"الدهر يقظان والأحداث لم تنم","https://www.aldiwan.net/poem63743.html","البسيط"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[45,"عجبا لطيف خيالك المتعاهد","https://www.aldiwan.net/poem62740.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[45,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[28,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[49,"الخلق مختلف جواهره","https://www.aldiwan.net/poem62115.html","الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"فقري غني وشبابي كهل","https://www.aldiwan.net/poem26758.html","الرجز"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[48,"ومشتعل الخدين يسحر طرفه","https://www.aldiwan.net/poem63311.html","الطويل"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[8,"تذكرت والذكرى تهيج للفتى","https://www.aldiwan.net/poem21786.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85766","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140895",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42643","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116962","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[59,"تنعَّمَ قومٌ بالعبادَة والتقَى","https://www.poetsgate.com/ViewPoem.aspx?id=17319",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""]],"verses":[["فِقَرٌ بِها تُمسي المُلوكُ فَقيرَةً","إِبَداً إِلى مَبدىً لَها وَمَعادِ",0,"د",1,0],["فَقُرٌّ لِنيرانِ البَوارِقِ مُصطَلٍ","وَظِمءٌ لِأَحواضِ الغَمائِمِ وَاِرِدُ",1,"د",1,0],["فَقَرَّبتُهُ مِنّي وَلَم يَدرِ أَنَّهُ","إِذا عُدَّ مَجدٌ لَيسَ مِمَّن أُقارِبُهْ",2,"ب",2,0],["فَقَريضِي يَراهُ مَنْ يَنْقُدُ الأَشْ","عارَ سَهْلَ المَرامِ صَعْبَ المَراقي",3,"ق",2,0],["فقَرِّبا يا صاحبَيَّ أيْنُقاً","كِدْنَ يُبارينَ الرِّياحَ في البُرى",4,"ا",1,0],["فَقَرَّتِ العَينُ يا نَفسي بِقُربِكُمُ","وَغابَ هَمّي وَوافَى روحِيَ الجَسَدا",5,"د",2,0],["فَقَرَّبتِ لي غَيرَ القَريبِ وَأَشرَفَت","هُناكَ ثَنايا ما لَهُنَّ طُلوعُ",6,"ع",1,0],["فقَرّ راجِفُها لمّا احْتَلَلْتَ بِها","ورُضْتَ بالعَدْلِ منْها المَيْلَ فاعْتَدَلا",7,"ل",2,0],["فقَرِّرْ حالَتي منْ غيْرِ لُبْثٍ","هَناءً واحْتِراماً وانْطِلاقا",8,"ق",2,0],["فقرّ بكَ الإسلامُ عيْناً ولمْ يزَلْ","يعدُّكَ للجُلّى ويسْعَى فتُسْعِفُ",9,"ف",1,0],["فقَرْنٌ منْ نُظارِ العاجِ سلْمٌ","ووجْهٌ منْ لُبابِ الأبُنوسِ",10,"س",1,0],["فَقَرِّب لِرَحلِكَ جُلذِيَّةً","هَبوبَ السُرى لا تَمَلُّ النَصيصا",11,"ص",2,0],["فَقَرَأناها سُطوراً مِن دَمٍ","أَقسَمَت تَلتَهِمُ الشَرقَ اِلتِهاما",12,"م",2,0],["فَقَرَأتُ فيهِ رِسالَةً","مُزِجَت بِذَوبِ السُكَّرِ",13,"ر",1,0],["فَقَرَأنا عَلى ضِيائِكَ فيهِ","كَلِماتِ المُهَيمِنِ الوَهّابِ",14,"ب",1,0],["فِقَرٌ تَسوغُ بِها المُدامُ","إِذا تَكَرَّرَها النَديم",15,"م",1,0],["فَقَرَّت بِها مِن أَولِيائِكِ أَعيُنٌ","وَذَلَّت لَها مِن حاسِديكَ رِقابُ",16,"ب",1,0],["فَقَرَّت عُيونٌ كانَ أَسخَنَها البُكا","وَقَرَّت قُلوبٌ كانَ زَلزَلَها الذُعرُ",17,"ر",1,0],["فقرّ عيناً وطِب نفساً وعش أبداً","وفُز بما شئت من حمد وطيب ثنا",18,"ن",2,0],["فَقَرِّب لِلفِياشِ مُجاشِعِيّاً","إِذا ما فاشَ وَاِنتَفَخَ الوَريدُ",19,"د",1,0],["فَقَرَّبتُها لِلرَحلِ وَهيَ كَأَنَّها","ظَليمُ نَعامٍ بِالسَماوَةِ نافِرُ",20,"ر",1,0],["فقربك والعليا وحلمك والسطا","وحزمك والجدوى وملكك والزهد",21,"د",1,0],["فقْرُ عيني إلى محاسن ذاك ال","وَجْهِ فقْرٌ لا ينْطَوِي في الجُحُودِ",22,"د",1,0],["فقرِّطها بعقرب شَهرَزورٍ","إذا غنَّت وطوِّقها بأفعى",23,"ع",2,0],["فقرنه الدهر مغلوب وهاربه","طِلبٌ ولو حملته الريح مثقوف",24,"ف",1,0],["فقِرىً لطارقةٍ يحل نطاقها","من بعد ما شُدَّت أشد نطاق",25,"ق",1,0],["فَقَرَّبنَ لِلبَينِ الجِمالَ وَزُيِّنَت","بِأَحمَرَ مِن لَكِّ العِراقِ وَأَسوَدا",26,"د",2,0],["فَقَرَّت عُيونٌ قَبلُ كانَت حَسيرَةً","وَجادَت سُروراً بِالدُموعِ السَواجِنِ",27,"ن",1,0],["فِقَرٌ لِكُلِّ الناسِ فَقرٌ عِندَها","أَبَداً تُباعُ بِها العُقولُ وَتُشتَرى",28,"ر",2,0],["فَقَريبُهُ لِلحاضِرينَ وَليمَةٌ","وَبَعيدُهُ لِلغابِرينَ طَعامُ",29,"م",1,0],["فَقَرَّ إِلى موعِدٍ صادِقٍ","مُعِزُّ اليَقينِ مُذِلُّ الجُحود",30,"د",1,0],["فَقَرِّبوا بَينَنا فيها وَبَينَكُمُ","فَإِنَّها أَوثَقُ الأَسبابِ وَالذِمَمِ",31,"م",1,0],["فَقَرِّطها الأَعِنَّةَ راجِعاتٍ","فَإِنَّ بَعيدَ ما طَلَبَت قَريبُ",32,"ب",1,0],["فَقَرَّحتِ المَقاوِدُ ذِفرَيَيها","وَصَعَّرَ خَدَّها هَذا العِذارُ",33,"ر",1,0],["فَقرُ الجَهولِ بِلا عَقلٍ إِلى أَدَبٍ","فَقرُ الحِمارِ بِلا رَأسٍ إِلى رَسَنِ",34,"ن",1,0],["فَقرٌ كَفَقرِ الأَنبِياءِ وَغُربَةٌ","وَصَبابَةٌ لَيسَ البَلاءُ بِواحِدِ",35,"د",1,0],["فَقَرى هامَهُم سُيوفَ المَنايا","فَجَريحٌ أَو مُرعَفٌ أَو مودِ",36,"د",1,0],["فَقَرَّبتَ مِن حَظِّهِم ما نَأى","وَصَفَّيتَ مِن شُربِهِم ما كَدِر",37,"ر",1,0],["فَقَرَّت قُلوبٌ كانَ جَمّاً وَجيبُها","وَنامَت عُيونٌ كانَ نَزراً هُجوعُها",38,"ع",3,0],["فَقَرِّب إِلى أَشياخِنا إِذ دَعَوتَهُم","أَباكَ وَدَعدِع بِالجِداءِ التَوائِمِ",39,"م",1,0],["فَقَرّي في بِلادِكَ إِنَّ قَوماً","مَتى يَدعوا بِلادُهُمُ يَهونوا",40,"ن",3,0],["فَقَريبُهُ الأَدنى مُجانِبُهُ","وَصَديقُهُ مِن بَعدِ هاجِرُهُ",41,"ر",2,0],["فَقُرّحُهَا يوْمَ الوغى وَمِهَارُهَا","فوارسُها منهم ليوثٌ وأشبالُ",42,"ل",1,0],["فِقَرٌ يَكَادُ السِّحْرُ يَبْلُغُ بَعْضَ مَا","فِي طَيِّهَا لَوْ كَانَ غَيْرَ مُحَرَّمِ",43,"م",1,0],["فَقَرَّ وَكانَ أَخفَقَ مِن جَناحٍ","وَنامَ وَكانَ أَرعى مِن رَقيبِ",44,"ب",1,0],["فَقَرَّبَني مِن بَعدِ بُعدٍ كَأَنَّما","يَرى الجَبَلَ الوَعرَ المُمَنَّعَ فَدفَدا",45,"د",2,0],["فَقَرَّبَ الزادَ إِلى نِيامِ","أَلسُنُهُم ثَقيلَةُ الكَلامِ",46,"م",1,0],["فَقري غَنيٌّ وَشَبابي كَهلُ","وَكُلُّ فَضلٍ لي عَلَيهِ فَضلُ",47,"ل",1,1],["فَقَرائحي فِيما أَتَتْ مِنْ مَدْحِهِ","كالنَّحْلِ يَأتِي الزَّهْرَ بالإلهامِ",48,"م",1,0],["فَقَرِّبي لِمُحِبٍّ","مَحضَ الوِدادِ وَجودي",49,"ي",1,0],["فَقَرَّبَ مِن نَحوِ الأَباريقِ خَدَّهُ","وَقَهقَهَ مَسروراً مِنَ القَرقَفِ الخَمرِ",50,"ر",1,0],["فَقَرَّبتُ حُرجوجاً وَمَجَّدتُ مَعشَراً","تَخَيَّرتُهُم فيما أَطوفُ وَأَسأَلُ",51,"ل",1,0],["فَقَرَّبتُ مِبراةً تَخالُ ضُلُوعَها","مِن الماسِخِيَّاتِ القِسيَّ المُوَتَّرا",52,"ر",2,0],["فقروا على أن يسكتوه بجرعة","تخدر أعصاب المريض ولا تشفي",53,"ي",1,0],["فقر الجهول بلا قلبٍ إلى أدب","فقر الحمار بلا رأسٍ إلى رسن",54,"ن",1,0],["فقرَّبتنا وشفَّتْ عن بشاشته","به قُرىً كربوع الخلد شجراءُ",55,"ا",2,0],["فَقَرِّبْ لِيَ الْخَيْرَ الَّذِي أَنَا رَاغِبٌ","وَبَاعِدْنِيَ الشَّرَّ الَّذِي أَنَا حَاذِرُ",56,"ر",1,0],["فَقُرَّا وَطِيبا فَالْمُنَى مَا رَضَيْتُمَا","وَدَهْرُكُمَا صَفْوٌ وَعَيْشُكُمَا رَغْدُ",57,"د",1,0],["فَقرٌ أَصابَ الغَنِيَّ فيهِ","فَلا تَليدٌ وَلا طَريفُ",58,"ف",1,0],["فقرّت به طول الحياة عيونُهم","وكانت لهُم واللَه زاداَ إلى القبر",59,"ر",1,0],["فقرِّبوا نهجَهم فالروحُ واحدةٌ","وكلُّهم في مجالِ السبقِ أقرانُ",60,"ن",1,0],["فقرَّت بهمْ طولَ الحياة ِ عيونهمْ","وكانتْ لهمْ والله زاداً إلى القبرِ",61,"ر",1,0],["فقرَّبتِ الأبعادَ عزماً وِهمّةً","وأبدلَتِ الدهرَ المطاولَ ساعا",62,"ع",2,0],["فقرت اعين الدستور امنا","وشاهدت أوجه المتمردينا",63,"ا",1,0],["فقرّت عيون قبل كانت حسيرة","وجادت سرورا بالدموع السواجم",64,"م",1,0]]}