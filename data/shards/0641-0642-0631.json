ُها لمّا احْتَلَلْتَ بِها","ورُضْتَ بالعَدْلِ منْها المَيْلَ فاعْتَدَلا",7,"ل",2,0],["فقَرِّرْ حالَتي منْ غيْرِ لُبْثٍ","هَناءً واحْتِراماً وانْطِلاقا",8,"ق",2,0],["فقرّ بكَ الإسلامُ عيْناً ولمْ يزَلْ","يعدُّكَ للجُلّى ويسْعَى فتُسْعِفُ",9,"ف",1,0],["فقَرْنٌ منْ نُظارِ العاجِ سلْمٌ","ووجْهٌ منْ لُبابِ الأبُنوسِ",10,"س",1,0],["فَقَرِّب لِرَحلِكَ جُلذِيَّةً","هَبوبَ السُرى لا تَمَلُّ النَصيصا",11,"ص",2,0],["فَقَرَأناها سُطوراً مِن دَمٍ","أَقسَمَت تَلتَهِمُ الشَرقَ اِلتِهاما",12,"م",2,0],["فَقَرَأتُ فيهِ رِسالَةً","مُزِجَت بِذَوبِ السُكَّرِ",13,"ر",1,0],["فَقَرَأنا عَلى ضِيائِكَ فيهِ","كَلِماتِ المُهَيمِنِ الوَهّابِ",14,"ب",1,0],["فِقَرٌ تَسوغُ بِها المُدامُ","إِذا تَكَرَّرَها النَديم",15,"م",1,0],["فَقَرَّت بِها مِن أَولِيائِكِ أَعيُنٌ","وَذَلَّت لَها مِن حاسِديكَ رِقابُ",16,"ب",1,0],["فَقَرَّت عُيونٌ كانَ أَسخَنَها البُكا","وَقَرَّت قُلوبٌ كانَ زَلزَلَها الذُعرُ",17,"ر",1,0],["فقرّ عيناً وطِب نفساً وعش أبداً","وفُز بما شئت من حمد وطيب ثنا",18,"ن",2,0],["فَقَرِّب لِلفِياشِ مُجاشِعِيّاً","إِذا ما فاشَ وَاِنتَفَخَ الوَريدُ",19,"د",1,0],["فَقَرَّبتُها لِلرَحلِ وَهيَ كَأَنَّها","ظَليمُ نَعامٍ بِالسَماوَةِ نافِرُ",20,"ر",1,0],["فقربك والعليا وحلمك والسطا","وحزمك والجدوى وملكك والزهد",21,"د",1,0],["فقْرُ عيني إلى محاسن ذاك ال","وَجْهِ فقْرٌ لا ينْطَوِي في الجُحُودِ",22,"د",1,0],["فقرِّطها بعقرب شَهرَزورٍ","إذا غنَّت وطوِّقها بأفعى",23,"ع",2,0],["فقرنه الدهر مغلوب وهاربه","طِلبٌ ولو حملته الريح مثقوف",24,"ف",1,0],["فقِرىً لطارقةٍ يحل نطاقها","من بعد ما شُدَّت أشد نطاق",25,"ق",1,0],["فَقَرَّبنَ لِلبَينِ الجِمالَ وَزُيِّنَت","بِأَحمَرَ مِن لَكِّ العِراقِ وَأَسوَدا",26,"د",2,0],["فَقَرَّت عُيونٌ قَبلُ كانَت حَسيرَةً","وَجادَت سُروراً بِالدُموعِ السَواجِنِ",27,"ن",1,0],["فِقَرٌ لِكُلِّ الناسِ فَقرٌ عِندَها","أَبَداً تُباعُ بِها العُقولُ وَتُشتَرى",28,"ر",2,0],["فَقَريبُهُ لِلحاضِرينَ وَليمَةٌ","وَبَعيدُهُ لِلغابِرينَ طَعامُ",29,"م",1,0],["فَقَرَّ إِلى موعِدٍ صادِقٍ","مُعِزُّ اليَقينِ مُذِلُّ الجُحود",30,"د",1,0],["فَقَرِّبوا بَينَنا فيها وَبَينَكُمُ","فَإِنَّها أَوثَقُ الأَسبابِ وَالذِمَمِ",31,"م",1,0],["فَقَرِّطها الأَعِنَّةَ راجِعاتٍ","فَإِنَّ بَعيدَ ما طَلَبَت قَريبُ",32,"ب",1,0],["فَقَرَّحتِ المَقاوِدُ ذِفرَيَيها","وَصَعَّرَ خَدَّها هَذا العِذارُ",33,"ر",1,0],["فَقرُ الجَهولِ بِلا عَقلٍ إِلى أَدَبٍ","فَقرُ الحِمارِ بِلا رَأسٍ إِلى رَسَنِ",34,"ن",1,0],["فَقرٌ كَفَقرِ الأَنبِياءِ وَغُربَةٌ","وَصَبابَةٌ لَيسَ البَلاءُ بِواحِدِ",35,"د",1,0],["فَقَرى هامَهُم سُيوفَ المَنايا","فَجَريحٌ أَو مُرعَفٌ أَو مودِ",36,"د",1,0],["فَقَرَّبتَ مِن حَظِّهِم ما نَأى","وَصَفَّيتَ مِن شُربِهِم ما كَدِر",37,"ر",1,0],["فَقَرَّت قُلوبٌ كانَ جَمّاً وَجيبُها","وَنامَت عُيونٌ كانَ نَزراً هُجوعُها",38,"ع",3,0],["فَقَرِّب إِلى أَشياخِنا إِذ دَعَوتَهُم","أَباكَ وَدَعدِع بِالجِداءِ التَوائِمِ",39,"م",1,0],["فَقَرّي في بِلادِكَ إِنَّ قَوماً","مَتى يَدعوا بِلادُهُمُ يَهونوا",40,"ن",3,0],["فَقَريبُهُ الأَدنى مُجانِبُهُ","وَصَديقُهُ مِن بَعدِ هاجِرُهُ",41,"ر",2,0],["فَقُرّحُهَا يوْمَ الوغى وَمِهَارُهَا","فوارسُها منهم ليوثٌ وأشبالُ",42,"ل",1,0],["فِقَرٌ يَكَادُ السِّحْرُ يَبْلُغُ بَعْضَ مَا","فِي طَيِّهَا لَوْ كَانَ غَيْرَ مُحَرَّمِ",43,"م",1,0],["فَقَرَّ وَكانَ أَخفَقَ مِن جَناحٍ","وَنامَ وَكانَ أَرعى مِن رَقيبِ",44,"ب",1,0],["فَقَرَّبَني مِن بَعدِ بُعدٍ كَأَنَّما","يَرى الجَبَلَ الوَعرَ المُمَنَّعَ فَدفَدا",45,"د",2,0],["فَقَرَّبَ الزادَ إِلى نِيامِ","أَلسُنُهُم ثَقيلَةُ الكَلامِ",46,"م",1,0],["فَقري غَنيٌّ وَشَبابي كَهلُ","وَكُلُّ فَضلٍ لي عَلَيهِ فَضلُ",47,"ل",1,1],["فَقَرائحي فِيما أَتَتْ مِنْ مَدْحِهِ","كالنَّحْلِ يَأتِي الزَّهْرَ بالإلهامِ",48,"م",1,0],["فَقَرِّبي لِمُحِبٍّ","مَحضَ الوِدادِ وَجودي",49,"د",2,0],["فَقَرَّبَ مِن نَحوِ الأَباريقِ خَدَّهُ","وَقَهقَهَ مَسروراً مِنَ القَرقَفِ الخَمرِ",50,"ر",1,0],["فَقَرَّبتُ حُرجوجاً وَمَجَّدتُ مَعشَراً","تَخَيَّرتُهُم فيما أَطوفُ وَأَسأَلُ",51,"ل",1,0],["فَقَرَّبتُ مِبراةً تَخالُ ضُلُوعَها","مِن الماسِخِيَّاتِ القِسيَّ المُوَتَّرا",52,"ر",2,0],["فقربت مبراة كأن ضلوعها","سقائف شيزى عاج منهن عاطف",53,"ف",1,0],["فقروا على أن يسكتوه بجرعة","تخدر أعصاب المريض ولا تشفي",54,"ي",1,0],["فقر الجهول بلا قلبٍ إلى أدب","فقر الحمار بلا رأسٍ إلى رسن",55,"ن",1,0],["فقرَّبتنا وشفَّتْ عن بشاشته","به قُرىً كربوع الخلد شجراءُ",56,"ا",2,0],["فَقَرِّبْ لِيَ الْخَيْرَ الَّذِي أَنَا رَاغِبٌ","وَبَاعِدْنِيَ الشَّرَّ الَّذِي أَنَا حَاذِرُ",57,"ر",1,0],["فَقُرَّا وَطِيبا فَالْمُنَى مَا رَضَيْتُمَا","وَدَهْرُكُمَا صَفْوٌ وَعَيْشُكُمَا رَغْدُ",58,"د",1,0],["فَقرٌ أَصابَ الغَنِيَّ فيهِ","فَلا تَليدٌ وَلا طَريفُ",59,"ف",1,0],["فقرّت به طول الحياة عيونُهم","وكانت لهُم واللَه زاداَ إلى القبر",60,"ر",1,0],["فقرِّبوا نهجَهم فالروحُ واحدةٌ","وكلُّهم في مجالِ السبقِ أقرانُ",61,"ن",1,0],["فقرَّت بهمْ طولَ الحياة ِ عيونهمْ","وكانتْ لهمْ والله زاداً إلى القبرِ",62,"ر",1,0],["فقرتنا لحما وحسنا شهيّا","وحديثا كأنّه ذوب سحر",63,"ر",1,0],["فقرَّبتِ الأبعادَ عزماً وِهمّةً","وأبدلَتِ الدهرَ المطاولَ ساعا",64,"ع",2,0],["فقرّت النفس لا شكوى ولا تعب","ولا لجاجة إيمان وكفران",65,"ن",1,0],["فقرّت بما تلقاه عيناك وانطوت","على النشوة الكبرى الجوانح والصّدر",66,"ر",1,0],["فقرت اعين الدستور امنا","وشاهدت أوجه المتمردينا",67,"ا",1,0],["فقرّت عيون قبل كانت حسيرة","وجادت سرورا بالدموع السواجم",68,"م",1,0],["فِقَرٌ بِها جَيد الزَمان مُقَلدٌ","وَفَرائِدٌ نَظمت بِلا تَكليف",69,"ف",1,0],["فقرت بها عين الضمير وأصبحت","تشاهدها بالطبع في البعد والقرب",70,"ب",1,0],["فَقُربُكَ أَنساني عَطايا بَلَوتُها","مِنَ المَطلِ تُجنى بَل مِنَ اللُؤمِ تُعصَرُ",71,"ر",1,0],["فِقَرٌ يَحُلُّ أَبو عُبا","دَةَ دونَها وَتَفوقُ قيلَه",72,"ل",2,0],["فقر ولا كسب غنى بذلة","وميتة ولا حياة تزرى",73,"ر",2,0],["فقررت لما ابيّضَ حولي الدجا","خوفَ الوشاةِ وليل غيري أسودُ",74,"د",1,0],["فقرأته فرأيت امراً راعني","ومآثما زادت على الآثام",75,"م",1,0],["فَقِرّي حَياءً وَاِطمَئِنّي جَلادَةً","فَأَيُّ كَريمٍ سالَمتهُ الغَوائِلُ",76,"ل",1,0],["فقرأتُ مُودَعه ففَتَّح لفظُه","معنىً كزَهْرِ الروضِ غِبَّ سَحابه",77,"ب",2,0],["فقرٌ وضيمٌ وإفرادٌ وبي حنف","وغربة حسرات كلها نسق",78,"ق",1,0],["فقر مقيم طارق","أصبحت أبكي من عذابه",79,"ب",2,0],["فقربك يضنيني وبعدك قاتلي","وأمري على الحالين فيك عجيب",80,"ب",1,0],["فَقرُ وَاِستَأنَسَ حَتّى إِذا","أَجابَنا حينَ دَعَوناهُ",81,"ن",3,0],["فقربي 