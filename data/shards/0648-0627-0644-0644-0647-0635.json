{"poems":[[48,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[48,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[48,"أركان دنيانا غرائر أربع","https://www.aldiwan.net/poem23489.html","الكامل"],[190,"وخلية مما خلوت به","https://www.aldiwan.net/poem44123.html","الكامل"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107331","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38412","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110232","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[5862,"سُ م ووم الأف..اعي !!","https://www.poetsgate.com/ViewPoem.aspx?id=31229",""]],"verses":[["وَاللَهُ صَغَّرَنا فَمَن","يَبغِ العُلا يُصرَف وَيُثبَر",0,"ر",1,0],["وَاللَهُ صَوَّرَ أَشباحاً لَها خَبَرٌ","وَالشَخصُ بَعدَ وُجودٍ يَقتَضي عَدَما",1,"م",2,0],["وَاللَهُ صَيَّرَ لِلبِلادِ وَأَهلِها","ظَرفَينِ وَقتاً ذاهِباً وَمَكانا",2,"ن",2,0],["والله صادفت لي سكنا","لجعلته في العين والقلب",3,"ب",1,0],["واللَه صلّى مع سلامِه على","محمدٍ مَن جاوزَ السبعَ العُلا",4,"ل",2,0],["وَاللَّهُ صَوَّرهُ لِلنّاسِ فِتنَتَهُم","نَعَم وَصَيَّرَهُ مِن أَكبَرِ الفِتَنِ",5,"ن",1,0],["واللَه صرتُ من الصبابة والهوى","بك آيةً من أغربِ الآياتِ",6,"ت",1,0],["وَاللَهُ صِدقٌ وَعدُهُ وَوَعيدُهُ","مِمّا يُعاينُ شَخصَهُ العَينانِ",7,"ن",1,0],["وَاللَهُ صَيَّرَها فِراشاً لِلوَرى","وَبَنى السَماءَ بِأَحسنَ البُنيانِ",7,"ن",1,0],["وَاللَهُ صَيَّرَني عَلَيكُم نِقمَةً","وَلِهتَكِ سِترِ جَميعِكُم أَبقاني",7,"ن",2,0],["والله صوبك ، أشهد الكون يزدان","وارسل مراسيل الغلا بيد ساعي",8,"ع",2,0]]}