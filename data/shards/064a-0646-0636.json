{"poems":[[55,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[65,"أردد الظن بين اليأس والأمل","https://www.aldiwan.net/poem46141.html","الطويل"],[9,"إن محلا وإن مرتحلا","https://www.aldiwan.net/poem21975.html","المنسرح"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[31,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[63,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[89,"واطول شوقي إليك يا وطن","https://www.aldiwan.net/poem8237.html","المنسرح"],[7,"إني كأني لدى النعمان خبره","https://www.aldiwan.net/poem2016.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[240,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[295,"بلبل في الرياض يلهمه الوحي","https://www.aldiwan.net/poem11715.html","الخفيف"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[458,"من مبلغ وطني الحبيب تلهفي","https://www.aldiwan.net/poem61734.html","الكامل"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[567,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122571","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122804","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96352","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48218","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103397","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103399","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132704","الكامل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105800","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94602","الوافر"],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5353,"بردة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=212465",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5648,"برهانه اليا حارت عقول الالباب","https://www.poetsgate.com/ViewPoem.aspx?id=164273",""],[5853,"(( لي حبيبٌ))","https://www.poetsgate.com/ViewPoem.aspx?id=175657",""],[5956,"الحب خير وسيلة للتوعية","https://www.poetsgate.com/ViewPoem.aspx?id=192244",""],[5975,"في ولاء آل بيت الرسول3","https://www.poetsgate.com/ViewPoem.aspx?id=53468",""],[463,"هلْ في الشُّموسِ التي تحدى بها العيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60092&r=&rc=148",""],[5567,"يانفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81771&r=&rc=39",""]],"verses":[["يَنضونَ بِاللَيلِ غُلالاتِ الكَسَل","وَيَستَسِلّونَ الكَرى مِنَ المُقَل",0,"ل",1,0],["يَنْضوهُ للأمْرِ قد سُدَّتْ مَطالِعُهُ","وضاقَ في طَرَفَيْهِ مَسْلَكُ الحِيَلِ",1,"ل",1,0],["يَنضَحُ بِالبَولِ وَالغُبارِ عَلى","فَخذَيهِ نَضحَ العَبدِيَّةِ الجُلَلا",2,"ل",2,0],["يُنضنِضُ منهُ مَنْ عاداه صِلّاً","من الأصلال مَخْشيَّ الوثابِ",3,"ب",1,0],["يَنضِحنَهُ بِصِلابٍ ما تُؤَيِّسُهُ","قَد كانَ في نَحرِهِ مِنهُنَّ تَفصيدُ",4,"د",1,0],["يَنضِحنَ بِالبَولِ أَولاداً مُغَرَّقَةً","لَم تَفتَحِ القُفلَ عَنهُنَّ الأَقاليدُ",4,"د",1,0],["ينضو الحَيِيُّ الوجهِ ثوبَ حيائِه","فيه فيخطِرُ كالحُسامِ العاري",5,"ر",2,0],["يَنْضَحُ شِدْقَاهُ بِالرُّؤَالِ كَمَا","عُلَّ بِنَضْحِ الْعَتِيرَةِ الْوَثَنُ",6,"ن",1,0],["يَنضَحنَ نَضحَ المَزادِ الوُفرِ أَتأَقَها","شَدُّ الرُواةِ بِماءٍ غَيرِ مَشروبِ",7,"ب",1,0],["يَنْضَمُّ تَحْتَ لِوَائِهِ","أَلْفٌ مِنَ الأُسْدِ الْقسَاوِرْ",8,"ر",1,0],["ينضُو مِنْ مُقْلتِه سيْفاً","وكأَنَّ نُعاساً يُغْمدُهُ",9,"د",2,0],["يُنضج الخبزَ للعقول نقيّاً","لم يُروَّع بالبخسِ في ميزانه",10,"ن",2,0],["ينضوي تحت ظلِّها العُرب طرًّا","ليس فيها من سيِّدٍ ومسُود",11,"د",1,0],["ينضمُّ يَأتي حرزها فيُصانُ","وَمِثالهُ بحديثهِ الثعبانُ",12,"ن",1,0],["يَنضو المَطِيَّ بِمنَكبَيهِ وَصُلبِهِ","تَعبٌ وَأَبطَأَ سَيرُهُنَّ ذَميلُ",13,"ل",1,0],["يُنضى عَنِ اللَيلِ البَهيمِ رِداؤُها","وَيُماطُ عَن فَلَقِ الصَباحِ لِثامُها",14,"م",3,0],["يُنْضُونَ في طَلَب النّفائِس أنْفُساً","حَبَسوا على إحرَازِها أنْضَاءَها",15,"ا",3,0],["ينضح القلب بالذي فيه من شتى","أحاسيسه ومن أشجانه",16,"ن",2,0],["يَنضاع مِنهُنَّ العَبير كَأَنَّما","يَحمِلنَ فأر المِسك في الأَردانِ",17,"ن",1,0],["ينضىِ الركائبَ في الطِّلاب لشهوةٍ","ولِضمِّ أهواءٍ إلى أهوائه",18,"ا",3,0],["ينضحنَ لا يَعْطُبْنَ في","ك وفي أبيك الدهرَ عُشْوَهْ",19,"و",2,0],["ينضحون الفتيقَ منّي بأيدٍ","ناعشاتٍ ويجبرون الكسيرا",20,"ر",2,0],["يُنضِي الجيادَ إلى إدراك حاجتهِ","والعيسَ حتى يضجَّ السرجُ والكورُ",21,"ر",1,0],["يَنِضُّ دماً ما اندقَّ منها فإنَّهُ","قتيلٌ بِثارات الضُلوعِ السواحقِ",22,"ق",1,0],["يُنضونَ كُلَّ نَجيبَةٍ أَن يُطلِعوا","جَبَلاً يَحِلُّ الرَأسَ مِن شَعَفاتِهِ",23,"ت",2,0],["يَنضَوي تَحتَها النُقّادُ مَعَ الأُس","دِ وَتَرعى الذِئابُ وَالآرامِ",24,"م",1,0],["يَنضَحُ المِسكُ مِن ذُراهُ ويَعلو","جَسَدي من غُلالتَيهِ جساد",25,"د",1,0],["يَنضانِ وَلها لِلعَقيقِ شَجيَّةً","عَواطِفَ مِن أعناقِها وَثَواني",26,"ن",2,0],["يُنضي الهِجانَ التي كانت تكونُ بها","عُرضيَّة وَهبابٌ حينَ تَرتحِلُ",27,"ل",1,0],["يَنْضُو السَرَى وَالسَفَرَ الدَعُوسا","أَلَا تَخافُ اللُّجَمَ العَطُوسا",28,"س",2,0],["ينضَاعُ عن مسكِ دارينٍ إِذا ابتدرتْ","أشجارُها لهواها الرطبِ تنتفِضُ",29,"ض",1,0],["يُنضى فيتَّقِدُ اتِّقادَ النارِ تُذ","كيها وَيطَّرِدُ اطِّرادَ الماءِ",30,"ا",2,0],["يُنضى فيختَلِسُ الطُلى مِن قَبل أَن","تُدنى ذُباباهُ إلى خَلسِ الطُلى",31,"ا",1,0],["ينضو به يوم الخصام عميده","سيفاً يصيب إذا استسل المقتلا",32,"ل",2,0],["ينضمّ ضمّ العاشقَينِ تلاقيا","من بعد طول تفرقٍ وتحسُّر",33,"ر",1,0],["ينضِّدُ في الطروس من الدراري","تجيءُ بشكل ولدانٍ وحورِ",34,"ر",1,0],["ينضي الهموم إذا ما حم حاينها","بعيسجور أمون ذات خطار",35,"ر",1,0],["يَنْضَوْنَ عن بردة ِ الأوجاع ِ كاهلَهم","والرُّوحُ كَلمى وهذا الليلُ ليس إلى",36,"ل",2,0],["يُنَضِّدُ الآهَ فيها شاعرٌ حَذِقٌ","حصاتُه بزَّت الأفذاذَ والفُطَنا",37,"ن",2,0],["ينضح البحر بالهوى قدميها","وعلى رأسها تُرى الأقمار",38,"ر",1,0],["ينضح وللمعنى هبايب ونسناس","شذى نسيم يسوقه الفال لاطاب",39,"ب",1,0],["ينضح الشعر قلبه كصباح","كسر القيد صمته وأنارا",40,"ر",2,0],["ينضمُّ للحكماءِ يدعم شملهم","وعن العداوةِ والأذى أن يقلعا",41,"ع",2,0],["ينضِّدُ من خلالِ السلكِ دراً","بعقدِ السرِّ والنعمى انسكابُ",42,"ب",1,0],["ينضي الحيادَ إلى أدراكَ حاجتهِ","والعيسَ حتى يضجَّ السِّرجُ والكورُ",43,"ر",1,0],["ينضُو عن جهل مسافتنا","ما لو أسرى في النفسِ صفَا",44,"ف",2,0]]}