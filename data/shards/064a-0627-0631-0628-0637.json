{"poems":[[74,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[74,"يا رب طرف يفوق الطرف من سبق","https://www.aldiwan.net/poem18776.html","البسيط"],[99,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[108,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[108,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38975","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95585","البسيط"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26958","الكامل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145316","المنسرح"],[4392,"","https://poetry.dctabudhabi.ae/diwan/poem/101564","الكامل"],[4858,"مكابدة النّوى","https://www.poetsgate.com/ViewPoem.aspx?id=138318",""]],"verses":[["يا ربَّ طرفٍ ضريرٍ عن محاسنها","وربَّ أذنٍ عن الفحشاء صمَّاء",0,"ا",2,0],["يا رب طرف يفوق الطرف من سبق","فغاية العين نوماً أن ترى أثره",1,"ر",2,1],["يا رُبَّ طودٍ بالثلوج متَوَّجٍ","ما مسَّت الدنيا جديد إهابِهِ",2,"ب",2,0],["يا رُبَّ طائرة سمعت أزيزها","فحسبته في مِسمعيَّ هديلا",3,"ل",2,0],["يا رُبَّ طفل تحته","نادى فلم يُسمع نداؤه",4,"ا",3,0],["يا رَبِّ طَيِّب عيشَهُ","بِالنّصرِ وَالفَتحِ القَريب",5,"ب",1,0],["ياربّ طفل أتاها بائسا تَعِساً","فصار يرفل فى النعماء إِعجابَا",6,"ب",2,0],["يا رب طهر بقاع الأرض من سفل","قد البسوا دينهم من كفرهم حللا",7,"ل",2,0],["يا رُبَّ طالِعَةِ العِشاءِ أَتَت","بِخِلافِ ذاكَ طَوالِعُ الصُبحِ",8,"ح",1,0],["يا رب طول يديه واعل بكع","بيه وشرف مقامه صلبا",9,"ب",2,0],["يا رب طه بالنبي وآله","نصراً لجند الحق عند لقاء",10,"ا",2,0],["يا ربِّ طال فراقُهم وعذابُهم","في سجن محتلٍّ ، وشرِّ وَثاقِ",11,"ق",1,0]]}