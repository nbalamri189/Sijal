.net/poem59813.html","المتقارب"],[475,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[475,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[480,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[498,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[498,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[498,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[512,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[513,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[513,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[513,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[522,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[527,"عجبا أين العقول","https://www.aldiwan.net/poem37269.html","مجزوء الرمل"],[536,"يا سيدي عشت لي وبعدي","https://www.aldiwan.net/poem48239.html","عموديه"],[538,"وفرحة من كلاب الحي يتبعها","https://www.aldiwan.net/poem56897.html","البسيط"],[549,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[549,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[549,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[556,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[560,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[560,"نار وما ادراك ناري ما هيا","https://www.aldiwan.net/poem52980.html","الكامل"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[573,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[573,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[574,"من مبلغ الشعراء عن أخويهم","https://www.aldiwan.net/poem1773.html","الكامل"],[585,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"]],"verses":[["وَفَرَيتَ وَفرَةَ لَيلِهِم بِصَوارِمِ","وَصَلَت عُرى الإِصباحِ بِاللَمَعانِ",0,"ن",1,0],["وَفَروا عَلى المَجدِ المُشيدِ هُمومَهُم","وَتَهاوَنوا بِالنائِلِ المُتَهَدِّمِ",1,"م",1,0],["وَفَرَعتُ رابِيَةَ العُلى مُتَمَهِّلاً","أَجري أَمامَ الطالِبِ المَجهودِ",2,"د",1,0],["وَفَرَرتُ مِن سِنِّ القُروحِ تَجارِباً","وَعَسا عَلى قَعَسِ السِنينَ عَمودي",2,"د",2,0],["وَفَرنا عَلَيهِم طَريقَ البَقاءِ","وَخَلّوا لَنا عَن طَريقِ العَطَب",3,"ب",1,0],["وَفُرَّ عَنْها بأطرافِ الرِّماحِ تَشُبْ","دِماءَهُمْ بدِماءِ الأيْنُقِ البُزُلِ",4,"ل",1,0],["وفَرْعُ بني دُودانَ سَعدُ بنُ مالِكٍ","وكَهْفُ بني سَعْدٍ سُواءَةُ أو نَصْرُ",5,"ر",1,0],["وَفَرَّقتُ جَيشاً كانَ في جَنَباتِهِ","دَمادِمُ رَعدٍ تَحتَ بَرقِ الصَوارِمِ",6,"م",1,0],["وَفَرَّقنا المَواكِبَ عَن نِساءٍ","يَزِدنَ عَلى نِساءِ الأَرضِ حُسنا",7,"ن",2,0],["وفرّقَ بيْنَ الحقِّ والشّكِّ إذْ جَرى","علَى سَنن الفاروقِ في هَدْيِهِ جَرْيا",8,"ي",2,0],["وَفَرَّقَ مَا بَيْنِي وَيْنَ أَحِبَّتِي","فَأَنْكَادُهُ تَنْتَابُنِي وَغُمُومُهُ",9,"م",2,0],["وَفُروضُ حَقّكَ لاَ تَفُوتُ فَوَقْتُهَا","بَاقٍ إِذَا اسْجْزَيْتَهُ يَجْزِيكَا",10,"ك",2,0],["وفرْعٍ زدكيٍّ منْ أصولٍ كريمَةٍ","حَباها كما قُدَّ الشِّراكُ منَ الِجلْدِ",11,"د",1,0],["وفُرْقانُ مَجْدٍ يَصْدَعُ الشّكَّ نورُهُ","حَبا اللهُ منْهُ كلَّ صَدْرٍ بِشارِحِ",12,"ح",1,0],["وَفَرِّج أَزمَةَ الأَموالِ عَنّا","بِما أوتيتَ مِن رَأيٍ سَديدِ",13,"د",1,0],["وَفَرَطتَ بَينَ سُطورِها","مَنظومَ تاجِ القَيصَرِ",14,"ر",1,0],["وَفَرعٍ يَزينُ المَتنَ أَسوَدَ فاحِمٍ","أَثيثٍ كَقِنوِ النَخلَةِ المُتَعَثكِلِ",15,"ل",1,0],["وفرت به عز الصفا فقصرت","كلم المؤبن إن توفي نعته",16,"ت",2,0],["وَفَرَتْ بِهِ غُرًُّ الخِلالِ فَقَصَّرَتْ","كَلِمُ المُؤْبِّنِ أَنْ تُوَفِي نَعْتَهُ",17,"ت",2,0],["وَفَردٍ يَطيرُ البَقُّ عِندَ خصيلِهِ","بِذَبٍّ كَنَفضِ الريحِ ذَيلَ السَرادِقِ",18,"ق",1,0],["وَفراءَ غَرفِيَّة أَثأى خَوارِزُها","مُشَلشِلٌ ضَيَّعَتهُ بَينَها الكُتَبُ",19,"ب",1,0],["وَفَرَّ الوَحيدُ بَعدَ حَرسٍ وَيَومِهِ","وَحَلَّ الضِبابُ في عَلِيِّ بنِ أَسلَما",20,"م",2,0],["وَفَرعي فَرعُكَ السامي المُعَلّى","وَأَصلي أَصلُكَ الزاكي وَحَسبُ",21,"ب",1,0],["وَفَرَّ بِها حَكيمٌ يَومَ جالَت","بَنو النَجّارِ تَخطِرُ كَالأُسودِ",22,"د",1,0],["وَفَرَّ حَكيمٌ خَشيَةً مِن رِماحِنا","عَلى سابِحٍ غَربٍ بَعيدِ التَرَدُّدِ",23,"د",1,0],["وفّرَ السمرَ عن خصام الأعادي","وكفى المرهفات طولَ الضرَاب",24,"ب",1,0],["وفرج غمِّي ذات يوم بِزَوْرةٍ","فقلت لعينيَّ انظرا وتفرَّجا",25,"ج",2,0],["وفريدة قد أقرحت عن مثلها","فطن الورى فلذاك قيل قرائح",26,"ح",1,0],["وفرَّق إلا مقلتي وسهادَها","وجمَّع إلا مهجتي وتجلّدي",27,"د",2,0],["وفرعُ علًى تهتزّ أعطافُ مجده","وينفحُ أبناءَ المحامد عودُه",28,"د",2,0],["وفرّجت بالنعماء حالي وفكرتي","وقد ضاقَ بالأنكادِ عني وسيعها",29,"ع",3,0],["وفرتْ مواهبه ورقّ مديحه","فتشابه المكيول والموزون",30,"ن",1,0],["وفرشت المنديل تحتي وصير","ت تُكايَى خفِّي مع الدُّرَّاعه",31,"ع",2,0],["وفرتُ عليه الماء عشرين حجة","ففرّق منه الحرص ما كنت أجمع",32,"ع",1,0],["وفرعْت من شيبانَ ذِروةَ هضَبةٍ","تعلو السحابَ فأي شأنك يضؤُلُ",33,"ل",1,0],["وَفَرَّ قائِدُهُم لَما عَرَضتَ لَهُ","كَما يَفِرُّ أَمامَ القَشعَمِ الحَجَلُ",34,"ل",1,0],["وَفَرَسٍ عَلى المَسا","وي كُلِّها مُحتَوِيَه",35,"ي",2,1],["وَفَرِحنا حينَ زالَت","جاءَنا أَنحَسُ مِنها",36,"ه",2,0],["وَفِرسالُ إِذ باتوا وَبِتنا أَعادِياً","عَلى السَهلِ لُدّاً يَرقُبونَ وَنَرقُبُ",37,"ب",1,0],["وفرّقتَ بيني وبين الرفاق","فالعقد مني ومنهم سحيل",38,"ل",1,0],["وَفَريضَةٌ أَنتَ اِستَنَنتَ بَديئَها","لَولاكَ ماكُتِبَت عَلى الكُتّابِ",39,"ب",1,0],["وَفَّرَ الفَيءَ وَهُوَ حُرُّ الصَفايا","وَحَبا ذا العَفافِ فيهِ خِيارُه",40,"ر",2,0],["وَفَرتُ عَلَيكَ مالَكَ وَهوَ عِلقٌ","مَرَزّاً لَيسَ عادَتَهُ الوُفورُ",41,"ر",1,0],["وَفَرتُكَ لا هَوىً بِكَ في وُفورٍ","إِذا ما حانَ مِن حَقٍّ نُزولُ",42,"ل",1,0],["وَفَرَّ الحائِنُ المَغرورُ يَرجو","أَماناً أَيَّ ساعَةِ ما أَمانِ",43,"ن",1,0],["وَفُرسانُ هَيجاءِ تَجيشُ صُدورُها","بِأَحقادِها حَتّى تَضيقَ دُروعُها",44,"ع",3,0],["وَفْرُ الأعادي لسيفِه نَفَلٌ","وهو لطُلاَّبِ رِفْدِهِ نَفَلُ",45,"ل",1,0],["وفِراقٌ جَنى عليَّ انتكاسَ ال","حُبَّ من بعدِ راحَةِ الأَفراقِ",46,"ق",1,0],["وَفَرَّ أَبو عَمروٍ هُبَيرَةَ لَم يَعُد","لَنا وَأَخو الحَربِ المُجَرِّبِ عائِدُ",47,"د",1,0],["وَفَّروا الدُنيا لِغَيرِهِمُ","وَابتَنَوا فيها وَما سَكَنوا",48,"ن",3,0],["وَفُرطُ التَقاضي يوهِمُ الناسَ أَنَّني","هَجَمتُ وَاِستَنزَعتُ ذَلِكَ بِالقَسرِ",49,"ر",1,0],["وفرخٍ صغيرٍ لا نهوضَ لمثله","يُراطنُ أشكالاً ملاقِطُها صُفْرُ",50,"ر",1,0],["وَفَرحَةَ الأَديبِ بِالأَديبِ","وَخَيَّمَت صادِقَةَ الشُؤبوبِ",51,"ب",1,0],["وَفِر جاهي عَلَيكَ فَإِنَّ جاهاً","إِذا ما غَبَّ يَوماً صارَ مالا",52,"ل",2,0],["وَفَرَعْتُ نَاصِيَةَ الْعُلا بِفَضَائِلٍ","هُنَّ الْكَوَاكِبُ فِي النَّهَارِ الْمُظْلِمِ",53,"م",1,0],["وَفِرقَةٌ مِنهُم وَقَد أُدخِلَت","النارَ فَساءَتهُم مَرافِقُها",54,"ق",3,0],["وَفَرَّ مِن قُدّامِهِ فِرارا","وَكانَ قِدماً بَطَلاً كَرّارا",55,"ر",2,0],["وَفَرَّتِ الأَعرابُ في البِلادِ","وَءُهلِكوا إِهلاكَ قَومِ عادِ",55,"د",1,0],["وَفَرَشَ الخَشخاشُ جَيباً وَفَتَق","كَأَنَّهُ مَصاحِفٌ بيضُ الوَرَق",56,"ق",1,0],["وَفَرَّغَ حُسنَهُ مِن كُلِّ عَيبٍ","وَجَلَّ عَنِ المُشاكِلِ وَالمُداني",57,"ي",1,0],["وَفَرَّ مِنَ الأَنامِ وَكانَ حيناً","يُقاسي بَينَهُم ضُرّاً وَضيقا",58,"ق",2,0],["وَفُرسانٍ يَرونَ القَتلَ غُنماً","فَما لَهُمُ لَدَيهِ مِن بَراحِ",59,"ح",1,0],["وَفُراقُ الخَليلِ قَرحٌ مُمِضٌّ","وَبِهِ يَعرِفونَ أَهلَ الوَفاءِ",60,"ا",2,0],["وفّرْتَ أموالَه إذ ضِعنَ فاجتُبِيَتْ","منها القناطِيرُ من بعدِ الأواقيّ",61,"ي",1,0],["وَفَرَّ مِن خَشيَةِ الطِعانِ وَأَن","يَلقى المَنايا بِكَفِّ جالِبِها",62,"ب",3,0],["وَفَرَّقَتهُم عَلى عِلّاتِها مِلَلٌ","وَعِندَ كُلِّ فَريقٍ أَنَّهُم ثَقِفوا",63,"ف",3,0],["وَفرُ هَذا الفَتى مَديدٌ بَسيطٌ","وافِرٌ كامِلٌ خَفيفٌ طَويلُ",64,"ل",1,1],["وَفَرتُ العارِضَينِ وَلَم يُعارِض","مَشيبي إِذ تَناثَرَ مَلقَطايا",65,"ا",3,1],["وَفَرَّقَ عَن بَيتَيكَ سَعدَ بنَ مالِكٍ","وَعَوفاً وَعَمرواً ما تَشي وَتَقولُ",66,"ل",1,0],["وَفَريدَ الحُسْنِ واحِدَهُ","مُنْتَهاهُ مُنْتَهى العَدَدِ",67,"د",1,0],["وَفرحنا ثم اِنتظرنا فَجاءَت","بعد تعداد أشهرٍ بغلام",68,"م",1,0],["وفرع غُدافيّ يزين سواده","جبين وقاه اللَه كالحق أبلج",69,"ج",1,0],["وفرتني الجهال حا","شدة علي وما فريت",70,"ت",1,0],["وفرقةٌ دهريةٌ جحاد","عن كل دينٍ لهمو إلحاد",71,"د",1,0],["وَفَرَّقتُ الكَتائِبَ عِندَ ضَربٍ","يَخِرُّ لَهُ صَناديدُ الرِجالِ",72,"ل",1,0],["وَفَرَ الإِلَهُ لَهَا الَعْطَاءَ فَلَمْ يَعُدْ","عَنْ بَابِهَا عَافٍ بِغَيْرِ عَطَاءِ",73,"ا",2,0],["وَفَرِيدَةٌ فِي الْعِقْدِ تَزْهُو بِالْحِلى","مِنْ خَيْرِ مَا تَزْهُو بِهِ الأبْكارُ",74,"ر",1,0],["وفرَّ، فلما رآني الدجى","حباني من شَعره خصلتينْ",75,"ن",1,0],["وَفُرِّقَ جَمعُ فِهرٍ وَهيَ شَتّى","وَأَوحَشَتِ المَنازِلُ وَهيَ سيحُ",76,"ح",1,0],["وفريقٌ للفتك يلقى فريقاً","وحُشودٌ للهَوْلِ تلقى حُشودا",77,"د",2,0],["وَفِرَاسَةٌ سَبَقَتْ حَوادِثَ دَهْرِهَا","حَتَّى كَأنَّ الغَيْبَ كالمَشْهُودِ",78,"د",1,0],["وفردٍ حل في شعب","وشعب حل في فرد",79,"د",1,0],["وفرع زكي من أصول كريمة","حكاها كما قد الشراك من الجلد",80,"د",1,0],["وفرّ سؤال خجول تلاه","سؤال ، على شفتيها تعايا",81,"ا",3,0],["وفرِاخ الطُيور في قُلَل الاجيال","تَهدي لها الظنونَ الرواجِم",82,"م",1,0],["وفرحةِ أقوام شجاهم تفوُّقي","بأني عنهم في الغنى متخلِّف",83,"ف",1,0],["و\"فرعونُ \" إذ ينطوي مُلْكُهُ","و\" فرعونُ \" في القبرِ إذ يَنْتَشِر",84,"ر",1,0],["وفرعٍ يُغشي المتنَ أسودَ فاحم","أثيث كقنو النخلة ِ المتعثكلِ",85,"ل",1,0],["وفرعي فرعكَ الزاكي المعلى","وَأصْلي أصْلُكَ الزّاكي وَحَسْبُ",86,"ب",1,0],["وفَرَّ وراءَ ردائكِ قلبي","ليلثمَ منكِ الذي يُلْثَمُ",8