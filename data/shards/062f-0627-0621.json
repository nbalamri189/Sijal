?id=186805",""],[5277,"مدينةُ الكحل","https://www.poetsgate.com/ViewPoem.aspx?id=193773",""],[5277,"وقفةٌ على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200038",""],[307,"بمن الوذ","https://www.poetsgate.com/ViewPoem.aspx?id=213702",""],[5376,"يا ويل حالي قد بليت بداء","https://www.poetsgate.com/ViewPoem.aspx?id=188560",""],[5431,"هو في النهاية واقعٌ لايملصُ","https://www.poetsgate.com/ViewPoem.aspx?id=198801",""],[5447,"ظبية وخواء","https://www.poetsgate.com/ViewPoem.aspx?id=208304",""],[5459,"ماذا ادّخرتَ..؟","https://www.poetsgate.com/ViewPoem.aspx?id=208843",""],[5497,"فروا إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=210920",""],[5574,"خُفُّ اليأْس","https://www.poetsgate.com/ViewPoem.aspx?id=206000",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5906,"في الحكمة / الغرور / داء الغرور","https://www.poetsgate.com/ViewPoem.aspx?id=189626",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5970,"داء بقلبي وداء القلب يضنيه","https://www.poetsgate.com/ViewPoem.aspx?id=130644",""],[6029,"داء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=188849",""],[6093,"وظواهرُ العُشاقِ سالمة تُرى ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181668",""],[6093,"الجذر ذاكرة النبات","https://www.poetsgate.com/ViewPoem.aspx?id=208005",""],[6144,"الواسطه لسه شغاله","https://www.poetsgate.com/ViewPoem.aspx?id=22536",""],[5309,"ويح النبوغ فما الفتى بالحاذق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573832",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""]],"verses":[["داءٌ وَصَلتُ بِها الهَوى","وَقَطَعتُ أَقرانَ المَلامِ",0,"م",1,0],["داءٌ طَلَبتُ لَهُ الأُساةَ فَلَم يَكُن","إِلّا التَعَلُّلُ بِالدُموعِ طَبيبُ",1,"ب",1,0],["داءٌ من اللْؤم يستشفي الهجاءَ لهُ","كَذَلِكَ الحَكُّ يَستَشفيه ذو الجَرَبِ",2,"ب",1,0],["داء تمكَّن في عجا","نِك قبل أن يشتدَّ نهضُك",3,"ك",1,0],["داءَ البقاءُ الرفءَ إمَّا عاجلاً","لا زلتَ تُوفاهُ وإما آينا",4,"ن",2,0],["داء عقام واوجاع مبرحة","وفوقهن من الاشرار تهديد",5,"د",1,0],["داءُ النُفوسِ وَكُلُّ داءٍ قَبلَهُ","هَمٌّ نَسينَ مَجيئَهُ بِذَهابِهِ",6,"ب",2,0],["داءٌ تَأَبَّدَ في الفُؤادِ مُخَيِّمٌ","أَعيا الأُساةَ وَمَلَّ عَنهُ القُوَّدُ",7,"د",1,0],["داءُ الشعوب الفردُ ليس يُضيرُه","شعبٌ يُضامُ وأُمةٌ تُجتاحُ",8,"ح",1,0],["داءُ الممالكِ أن تُصابَ بقادةٍ","تُزْجَى على حُكم الهوى وتُقادُ",9,"د",1,0],["داءُ المَمالِكِ أَن تُقضى زَعامَتُها","لِمَعشَرٍ مِن صِغارِ الناسِ جُهّالِ",10,"ل",1,0],["داءُ الحَضارَةِ في أَسمى مَراتِبِها","فَما عَلى الكَلبِ أَن يَعتادَهُ السُعُرُ",11,"ر",1,0],["داءُ أَهلِ الشَرقِ ضَعفُ الهِمَمِ","وَبِهَذا كانَ مَوتُ الأُمَمِ",12,"م",1,1],["دَاءُ الهَوَى بِفُؤَادِي لاَ دَوَاءَ لَهُ","إلاَّ شِفَاهُ اللَّمَا مِن ثَغرِكَ البَهِجِ",13,"ج",1,0],["داءُ عاصٍ وَمُداوي فِتنَةٍ","سَفَرَت حَرباً وَلاحَت تَستَعِر",14,"ر",1,0],["داءُ المُحِبِّ وَلَو يُشفى بِريقَتِها","كانَت لِأَدوائِهِ كَالنارِ لِلحَطَبِ",15,"ب",1,0],["داءُ الحَياةِ قَديمٌ لا دَواءَ لَهُ","لَم يَخلُ بُقراطُ مِن سُقمٍ وَأَوصابِ",16,"ب",1,0],["داءُ هَذا الأَنامِ لا يَقبَلُ الطِبَّ","وَقِدماً أَراهُ داءً نَجيسا",17,"س",2,1],["داءُ التَواكُلِ وَهوَ في ال","عُمرانِ داعِيَةُ الخَراب",18,"ب",1,0],["داءُ الجَماعَةِ مِن أَرِسطاليسَ لَم","يوصَف لَهُ حَتّى أَتَيتَ دَواءُ",19,"ا",2,0],["دَاءٌ عَرَا فَانْدَكَّ طَوْدٌ شَامِخٌ","بِأَخَفَّ وَقْعاً مِنْ دَبِيبِ نِمَالِ",20,"ل",1,0],["داءٌ عَثا فيكَ داءُ كُلٍّ","فَلا يَكُن مُشمت الحسودِ",21,"د",1,0],["داءٌ بقلبي لا يعود طبيبه","يَأساً إليّ، وَلا يُصَابُ دَوَاؤهُ",22,"ا",3,0],["داء سرَى فعضضتُ الكفَّ من ندمِ","مَنْ مرشدى ضَلَّ عقلي في ذرى الدِّمَنِ",23,"ن",1,0],["داءٌ خفى ليس يصحو القلبُ من شغلٍ","يا مهجتى ردّ عقل الصبّ والنفسَا",24,"س",2,0],["دآء الرياسة في متابعةِ الهوى","ودواؤها في الدفع بالوجه الحسن",25,"ن",1,0],["داءٌ يذودُ عن العينين نومَهُما","وعِلَّةٌ بِيَ قد زادَتْ على العِلل",26,"ل",1,0],["داءُ الشعوبِ تباغضٌ وتخاذلٌ","وشفاؤها بالحبِّ والإخلاص",27,"ص",1,0],["داءٌ ثَوى بِفُؤادِ شَفَّهُ سَقمُ","يا مَحنَتي مِن دَواعي الهَمِّ وَالنَكَدِ",28,"د",1,1],["داءٌ عضالٌ بِهِ تلقى الإِساة أَساً","وَعلّة قَلَّما يَبرى لَها زَمِنُ",29,"ن",1,0],["داءٌ وَلَكِنَّهُ داءٌ بِلا أَلَمِ","شَيبٌ أَلَمَّ بِرَغمِ العَينِ بِاللَمَمِ",30,"م",1,1],["داءٌ أظنُّك حِدتَ عن طُرُقاته","ونجوتَ من طَرَقاتِه يا جَعفرُ",31,"ر",1,0],["داء المنية ما له لو أَنها","وقعت بهرمس من علاج دواء",32,"ا",2,0],["داء من الأدواء كان هاجداً","فجاء مشتاقاً إليك نازعا",33,"ع",2,0],["داءً تَقومُ مَقامَ الأَسرِ سَورَتُهُ","دَواؤُهُ عَودُ ما قَد كانَ مِن طَرَبِ",34,"ب",1,0],["داءُ المنيّةِ معضلٌ","ماتتْ بحسرتِهِ القُرونُ",35,"ن",1,0],["داءٌ عرا آل قحطانٍ فزال بهمْ","وذاق منه نِزارٌ وَاِحتَسى مُضَرُ",36,"ر",1,0],["داءُ قلبِي يُدوى وفيهِ من الأشْ","جانِ ما فيه ما يقول الصَّحيحُ",37,"ح",1,0],["داء كوني من علتي ليس يبرا","والدواء الدواء فيض الجود",38,"د",1,0],["داءٌ قديمٌ كم لهُ من حسرةٍ","في كلِّ قلبٍ من خَوالي الأدهُرِ",39,"ر",1,0],["داءٌ دخيلٌ ليسَ يُرجَى بُرْؤُهُ","لو أنَّ إسماعيلَ قامَ بطبِّهِ",40,"ب",2,0],["داءٌ نُعالجُهُ بالصبرِ وَهْوَ لنا","داءٌ وكم عِلَلٍ قد أَبرأت أُخَرا",41,"ر",2,0],["داءٌ قديم في بني آدمٍ","أَن يَعْشِق الإِنسانُ إِنسانا",42,"ن",2,0],["داء سرى في جسمنا متأصلا","فمتى بربك منه نقطع دابرا",43,"ر",2,0],["داءٌ هُوَ الأخلاقُ في اِضمِحلالِها","فَلِذا تَرى الأَخلاقَ رَأسَ وَصاتِهِ",44,"ت",2,0],["داء الصبابةِ لا تشفيه راقيةٌ","ولا يداوى بإمراق الفراريج",45,"ج",1,0],["داءين بعدك عن عيني أشدّهما","ثانيهما السقم من داءيّ عوفيتا",46,"ت",2,0],["داء عسير البرء لا","تنفع فيه الأدويهْ",47,"ي",2,0],["داء إذا عالجته","بالرفض أذهبت الأثرْ",48,"ر",1,0],["داءٌ تنزَّل فيه لو يعالجهُ","عيسى ابن مريمة أعياهُ نازلهُ",49,"ل",2,0],["داء تقادم عندي، من يعالجه؟","ونفثه بلغت مني منى الراقي؟",50,"ق",2,0],["داءَ الحروب وأيُّ داءٍ أنت لم","يعلم أطباء السياسة ما هو",51,"ا",3,0],["داءُ الهوى ما إن أدين ببُرئِهِ","ما للطّيبِ ولي وما للراقي",52,"ق",2,0],["داء تمكن منه ليس له شفا","الا اقامته بمارستان",53,"ن",1,0],["داءُ القلوب جفونُهُ","وقضيبُ قدٍّ منه مايد",54,"د",1,0],["داءٌ قَديمٌ في بَني آدَمٍ","صَبوَة إِنسانٍ بِإِنسانِ",55,"ن",1,1],["داءٌ من الهجرِ لم أبرح أعالجُها","منهُ وبالبرءِ في عتبي أُمنِّيها",56,"ي",3,0],["داءٌ ترحَّل فيكَ عنِّي معقبٌ","في مهجتي للوجدِ أقتل داءِ",57,"ا",2,0],["داء يرى الاجماعُ أَن دواءَه","في وَحدةِ التعليم روحِ النهضة",58,"ه",1,0],["دَاءٌ دَفينٌ ظَلَّ فيهِ مُخَامراً","فَيخَالُ يَيرأُ وَالضَّنَى بِتَراكُمُ",59,"م",1,0],["دَاءٌ دَفِينٌ ظَلَّ فِيهِ مُخَامِراً","فَيَخالُ يَبرأُ وَالضَّنَى بِتَراكُم",60,"م",1,0],["داء التّعصّب داءٌ لا دواء له","في موطنٍ بحبال الجهل محبوك",61,"ك",1,0],["داء يداوي أهُله أهلَه","فيبرِىء الداءَ به والدَوي",62,"ي",1,0],["داءٌ الدنيا فهل يرجو أمرؤٌ","يجمع الداءَ شفاءً من ولق",63,"ق",1,0],["داءٌ تَضعضعَ بالحُمَّى وبالسَّهرِ","فانظر وفي الجسمِ مَدعاةٌ إلى النَّظَرِ",64,"ر",1,0],["داءٌ به تعرفونَ كُلّكم","يا آل عبدالحميد في الأُفقِ",65,"ق",1,0],["داءٌ تناصَرَ في الفؤادِ فلم تُفِدْ","عنه الأُسَاةُ ولا ارتيادُ العُوَّدِ",66,"د",1,0],["داء العدم أو اخترم","من اللمم لحما ودم",67,"م",1,0],["داء عماً هرم الزمان أصابني","أوهي قواي وشق بعض مراقي",68,"ق",2,0],["داءُ قومِ دَواءُ قَوم فاصغُوا","لإقتِباسٍ من الكلامِ المَجيدِ",69,"د",1,0],["داء إذا ما انتباني","الحس مني ينسحب",70,"ب",1,0],["داء من الأعصاب حل","فلا مناص ولا هرب",70,"ب",1,0],["داءُ البلاد على هنانو قد قضى","فقضى وخلَّف في البلاد الداء",71,"ا",2,0],["داء العليل غرور يستبد به","فيفقد النفس بالتفكير بالنفْس",72,"س",1,1],["داء المطامع أن تأصل لم يفد","فيه سوى فصد الوريد علاج",73,"ج",1,0],["داء اصاب المكرمات فغالها","واغتال روح مكارم الأخلاق",74,"ق",1,0],["داء تَعَوَّدَهُ فؤاد متيَّمٍ","لم يلتحِفْ غيرَ الأسَى ببُرودِ",75,"د",1,0],["داء كسى الجسم المنعم ثوبه","مثل الفرند علا عليه صداء",76,"ا",2,0],["داءٌ دفين داؤُهُ دودةٌ","دواءه دماغ دفع دخيل",77,"ل",1,0],["داءٌ سرى فينا الحياءُ بشرحه","ولذاك نكتمه ولسنا ننطق",78,"ق",1,0],["داءٌ إذا مادام مستتراً دنا","يوم الفراق وحبذا لو يطرق",78,"ق",1,0],["داءٌ عُقامٌ لا شِفاءَ لهُ أَبَى","طِبَّ الأُساةِ كأَنَّهُ داءُ الأَسَد",79,"د",1,0],["داءٌ يعز على الطبيب دواؤه","ويضيع خسرا فيه مال المنفق",80,"ق",1,0],["داء الحياة له النفوس فريسة","ودواؤه بين الورى الاحلام",81,"م",1,0],["داء التواكل شب في شبابنا","والعلم نشكو اليوم من إدباره",82,"ر",2,0],["داء الحياة قديم","مُعْيٍ على الإمكان",83,"ن",1,0],["داءٌ وَكلت غلى الأساة علاجه","وشقاء قلبٍ ما له من آسِ",84,"س",1,0],["داء الفراق أضر ما نكبت به","أهل الهوى وأشدّه إزعاجا",85,"ج",2,0],["دَاءٌ لِقَومٍ وَفِيهِ","للآخَرِينَ دَوَاءُ",86,"ا",2,0],["داء الصبابة والجوى","أوقدت يا وسنان جمره",87,"ر",2,0],["داء الحماقة في الرؤس دواءه","سيف الصقيل يقدها والجلمد",88,"د",1,0],["داءان قد جُمعا وكلٌ","منهما أعَيى الطَبيبا",89,"ب",2,0],["داءُ الجَهالَةِ لا دَواءَ لِدااهِ","الا المعارِفُ فَهْيَ خَيْرُ دَواءِ",90,"ا",2,0],["داءان لِلْمَرْءِ فَلْيَختَرْ اخْفَّهُما","الموتُ أَوْ عَيْشُهُ في الهُونِ يُهْتَضَمُ",91,"م",1,0],["داء الجنون برِأسِهِ متحكِّمٌ","وتراه يسعى كالبهيم السائِمِ",92,"م",1,0],["داءُ العضالِ وَحالَتي أَودى بِها","جَلَدي فَلَستُ عَلى الحَبيبِ بِصابِرِ",93,"ر",1,0],["دَاءُ الكُرُونَا أَعْجَزَ الآفَاقَا","وَغَدَا الجَمِيعُ يَخَافُهُ إِشْفَاقَا",94,"ق",2,1],["دَاءُ القُلُوبِ -وقد تقادمَ عهدُها-","نَفْخُ البَلِيدِ القِزْمِ حَتَّى الفَرْقَعَةْ",95,"ع",2,0],["دَاءُ القُلُوبِ -وإِنْ تَقَادَمَ عَهْدُها-","نَفْخُ البَلِيدِ القِزْمِ حَتَّى الفَرْقَعَةْ",96,"ع",2,0],["دَاءٌ وهل فِي الأرضِ مِن عِلَّةٍ","تَسْطُو كَدَاءِ العَقْلِ إنْ سَيْطَرَا",97,"ر",2,0],["دَاءُ الجهَالَةِ بالإذلالِ يَدفِنُنُا","والعِلمُ نُورٌ بهِ للمَجدِ إحياءُ",98,"ا",2,0],["داءُ الْعبيدِ علاجُهُ دُبُغٌ","إذْ نامَ في أجْفانِها الْحَلَمُ",99,"م",1,0],["داءي عزيز إسى طالت به عللٌ","لكنه يا حبيبي ليس يعييكا",100,"ك",2,0],["داء الحلم لا يحيط به","سده لا إله إلا الله",101,"ل",2,0],["داءنا معضل انحطاط عهيد","لا نرى برءه بغير العهيد",102,"د",1,0],["داء كنفث الصل آ","ذى حيث هب وحيث دب",103,"ب",1,0],["داء بقلبك ام فؤاد مدنف","أتكابر الأشواق أم لا تعرف ؟",104,"ف",1,1],["داء الزمان وأهله","داء يعز له العلاج",105,"ج",1,1],["داءٌ..فهل راقٍ يفكُّ طلاسمي","أم أنَّهُ ماضٍ عليَّ الداءُ",106,"ا",2,0],["داءٌ يمازجني ولا برءٌ لهُ","الا رجوعُ الدارِ... ذاكَ دواهُ",107,"ا",2,0],["داءٌ يجرّ إلى داءٍ إلى وصبٍ","حتّى تمكن من أعصابي الشللُ",108,"ل",1,0],["داء تملق في عرين مكابر","جظي الحياة كحظوة الجهلاء",1