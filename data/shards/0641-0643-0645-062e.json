{"poems":[[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[74,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[93,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[87,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[63,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[82,"أليس بنو الزمان بنو أبيكا","https://www.aldiwan.net/poem31346.html","الوافر"],[89,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[82,"أليس بنو الزّمان بنو أبيكا","https://www.poetsgate.com/ViewPoem.aspx?id=3495",""],[53,"للناس عيدٌ ولي عيدانِ في العيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27703",""],[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[170,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[254,"ألا يا عين ما فابكي سميراً","https://www.aldiwan.net/poem2104.html","الوافر"],[287,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[376,"فمن مبلغ عني المحسن ذا الندى","https://www.aldiwan.net/poem57096.html","الطويل"],[443,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[469,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[482,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[505,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123432","السريع"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124750","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46708",""],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104403","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80012","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48224","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89523","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137058",""],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136994",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202001","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133972","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87388","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121421","الطويل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105626","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112333","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89301","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66488","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92057","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101161","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94342","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4830,"لِعابُ العَذارى","https://www.poetsgate.com/ViewPoem.aspx?id=194071",""],[4927,"حَدِيْثُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=29724",""],[4984,"على ألمٍ في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=175529",""],[5237,"زيارة أرباب التقى مرهم يبري","https://www.poetsgate.com/ViewPoem.aspx?id=113107",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[5790,"أيا سيف لحظٍ من لواحظه مهلا","https://www.poetsgate.com/ViewPoem.aspx?id=112108",""]],"verses":[["فَكَم خاضَ المَطِيُّ إِلَيكَ بَحراً","يَموجُ عَلى الأَماعِزِ وَالضَواحي",0,"ح",2,0],["فكم خدمةٍ عجَّلتها ومحبَّةٍ","تمتَّعت من لهوٍ بها غير معجَّل",1,"ل",1,0],["فَكَم خَلُدَت أُمَّةٌ بِيَراعٍ","وَكَم نَشَأَت أُمَّةٌ في دَواة",2,"ه",1,0],["فكم خصم عطفت عليه حتى","تقدّم في ولايتك الوليا",3,"ي",2,0],["فكَمْ خَليجِ دمٍَ أجرَتْ أسِنَّتُه","وكم خَليجِ نَدٍ أجرَتْ أنامِلُه",4,"ل",2,0],["فَكَم خَرَقنا حِجاباً لِلعِتابِ بِها","وَلِلعَفافِ حِجابٌ غَيرُ مُنخَرِقِ",5,"ق",1,0],["فكم خيرٍ ظفرتَ به نضيجاً","وكنتَ حُرِمتَ رؤيتَهُ فريكا",6,"ك",2,0],["فَكَمْ خَانَ عَهْدَاً وَاسْتَبَاحَ أَمَانَةً","وَأَخْلَفَ وَعْدَاً وَاسْتَحَلَّ مُحَرَّمَا",7,"م",2,0],["فكم خيرٍ به نضيجاً","وكنتَ حُرمتَ رؤيتهُ فريكا",8,"ك",2,0],["فكم خَصَمْتُ بِحُكْم الحقِّ من مَثَلٍ","قدْ أبَّدَتْهُ الليالي أيَّ تأبيدِ",9,"د",1,0],["فَكَم خُضتَ أَهوالاً نَتيجَتُها عُلاً","وَلاقَيتَ أَوصاباً جَنى صابِها شَهدُ",10,"د",1,0],["فكم خَلستُ الجَنى منهُ على حَذَرٍ","من قَولِ واشٍ شديدِ اللّذعِ مُؤتفكِ",11,"ك",1,0],["فَكَم خُضتُ رَجوى اليَومِ مِن لُجِّ مُزبِدٍ","يُظنُّ اِصطِفاقُ المَوجِ فيهِ مَشاعِلا",12,"ل",2,0],["فَكَم خَفضوا بالكسرِ رأساً لمشركٍ","وَكَم لِلعدا جرّوا كتائبهم جرّا",13,"ر",2,0],["فَكَم خَلّى سُمَيرٌ مِن أُمورٍ","عَلَيَّ لَوَ اَنَّني جَلدٌ عَزوفُ",14,"ف",1,0],["فَكَم خَضَبَت مِن دِماءِ النّحورِ","غَداةَ الوَغى من عداهُ لحاها",15,"ا",3,0],["فكم خلوة قد فزت فيها بجلوة","خرجت بها عني إليك بفرحة",16,"ه",1,0],["فكم خَطّتْ بنانُكَ من خِطابٍ","تَضاءلَ عندَهُ خَطْبٌ جَسيم",17,"م",1,0],["فكَم خالَفت حالي مَقالي وإنَّه","ثَناءٌ عَليكم ليسَ يُثنَى فينثَني",18,"ن",2,0],["فكم خدلت فيها لدى الحرب أنفس","وكم قسمت إذ ذاك منها الغنائمُ",19,"م",1,0],["فكم خفقتْ فيها بنودُ سحابةٍ","تسحُّ سِهاماً والوميضُ مناضل",20,"ل",1,0],["فكم خناذيذِ أشعارٍ سبقتُهمُ","سبقَ الجوادِ بها في كلَّ مضمارِ",21,"ر",1,0],["فكم خِبٍّ سَقيمِ الرَّأْيِ خَبْلٍ","وعِيشَتُهُ بدُنْياهُ رَخِيَّهْ",22,"ي",2,0],["فكم خلَّط عيشي ثَمَّ","مَن أَهوى تخاليطه",23,"ط",2,0],["فكمْ خشِينا أَنْ نرى يومَه","لو أنَّ لِلْمَقدور تَحويلا",24,"ل",2,0],["فكم خبيئة فكر قد ظفرت بها","من كل زاوية بالفضل منفرجه",25,"ج",2,0],["فكَم خانَني خِلٌّ وثِقتُ بعهدِه","وكانَ صديقاً لِي زمانَ الدراهِمِ",26,"م",1,0],["فكم خلطوا حلو الكلام بمره","وكم عرضوا بي مرة بعد مرة",27,"ه",1,0],["فكم خلفكم لي أنَّةٌ ما لوت بكم","على أنَّها قد لانَ شجواً لها الصخرُ",28,"ر",1,0],["فكم خاضع كم خاشع متذلل","وكم سائل مدت إلى الله كفاه",29,"ه",1,0],["فكم خصرْت شماريخاً يُرنِّحُها","غصنٌ من البانةِ الأُملودِ مَيَّالُ",30,"ل",1,0],["فَكَم خُوِّفَ النَعماءَ قَومٌ تَرَبَّصوا","فَأَرداهُمُ خُبثُ الطَوِيَّةِ وَالغَدرُ",31,"ر",1,0],["فكم خطبة في الشرق سارت ولو لها","شبا السيف اصغى اصبح السيف مبردا",32,"د",2,0],["فكم خامل الآباء ماضي العزائم","تعالى على ان كان موطئه النجما",33,"ا",1,0],["فكم خلّصتُ من وهم قويٍّ","حقائقَ ثُمَّ عقلاً من جنون",34,"ن",1,0],["فكم خفف الأوزار حتى ازالها","عن القطر كي لا يعتري فيه تشديد",35,"د",1,0],["فكم خطَّ فيها من فصولٍ يراعُهُ","فَكانَت طِرازاً منهُ بالوَشي يُعلَمُ",36,"م",1,0],["فكم خلفوا محرابَ آيٍ معطلاً","وكم تركوا من ختمةٍ لم تتمم",37,"م",1,0],["فكم خالفت دين النبي وضيعت","حقوقاً رعاها الله في محكم الذكر",38,"ر",1,0],["فكم خِلّ أذكّرُهُ","عَساها تَنفعُ الذكرَى",39,"ر",2,0],["فكم خلفَ المزاج بها","حياة النفس بالقتل",40,"ل",1,0],["فكمْ خَلَلٍ سَدَّهُ في الثُّغورِ","وسهْمٍ لحرْبِ العِدَى سَدّدا",41,"د",2,0],["فكم خضت الزحام ولا أبالي","وكم فتشت في بيت زوايا",42,"ا",3,0],["فكم خطبت خطوب الدَهر مبتسماً","وَلم يَرُعني أَمرٌ لَو تغشّاني",43,"ن",2,0],["فكَم خَرَّ مِنها لِلبوارقِ مبرقٌ","وكم ذلَّ فيها للقنا السّلب مَسلوبُ",44,"ب",1,0],["فكم خدعتني بقول الكذوب","وكم زعمت باشتداد الخطوب",45,"ب",1,0],["فكم خلت أمراً كائناً ثم لم يكن","وكم خلت أمراً لا يكون فكانا",46,"ن",2,0],["فكم خاتلت ثم وخاتلتني","جآذر ما ظفرت بهن ختلا",47,"ل",2,0],["فكم خلعت وقاري للعقار وكم","حاك العناق لنا ثوباً من القبل",48,"ل",1,0],["فكم خلٍّ غدا صِلّا لسوعا","وإخوان تخذتهمُ دروعا",49,"ع",2,0],["فكم خَدَعَتْ وكم مَكَرتْ","وكم غَدَرَتْ بمن عبرا",50,"ر",2,0],["فكم خَبِِرْنَ ضروب العاشقين هوىً","وكم صَرَعْنَ صقيلَ العقلِ والخُلُقِ",51,"ق",1,0],["فَكَمْ خَاْبَ فَأْلِيْ بِالَّذِيْنَ أُحِبُّهُمْ","لِكَوْنِيَ فِيْهِمْ  مُحْسِنَ الظَّنِّ  مُنْصِفَاْ",52,"ف",2,0],["فكم خيِّرٍ يسعى بطيب مودة","يحاول إصلاح الأمور ولا جدوى",53,"و",2,0],["فكم خلصت من لجة الإثم فاتكا","فألقته في بر الإنابة والبر",54,"ر",1,0],["فكم خاطبت بنت النبي صحابه","وقد عرفت إجلالها ووقارها",55,"ر",3,0],["فكم خَشيتُ عُيونَ الناسِ تأكُلُهُ","حتّى كأنَّ عُيونَ الناسِ... أفواهُ",56,"ا",2,0],["فكم خفضت ألحاظه من متيم","وكم كسرت قلبا وكم حرمت فعلا",57,"ل",2,0]]}