{"poems":[[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[27,"إن الندى من بني ذبيان قد علموا","https://www.aldiwan.net/poem5741.html","البسيط"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[51,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[92,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[44,"ماذا بدا لك إذ نقضت هواكا","https://www.aldiwan.net/poem30014.html","الكامل"],[44,"قل للأمير الذي قد نال ما طلبا","https://www.aldiwan.net/poem30577.html","البسيط"],[105,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[46,"قد أشرعت سنبس ذوابلها","https://www.aldiwan.net/poem23187.html","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[143,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[160,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[189,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[204,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[235,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[271,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[364,"صيرت خوزستان حربا قائما","https://www.aldiwan.net/poem60610.html","الكامل"],[364,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[377,"قف نبك نفسا عجبها بمماتها","https://www.aldiwan.net/poem66907.html","الكامل"],[391,"يا من له الحول والقوه","https://www.aldiwan.net/poem54466.html","عموديه"],[406,"أذهبت رونق ماء النصح في العذل","https://www.aldiwan.net/poem50137.html","البسيط"],[441,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[458,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[461,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[468,"وصفراء ترقص إن قادها","https://www.aldiwan.net/poem60412.html","الكامل"],[470,"نزل المشيب فما له تحويل","https://www.aldiwan.net/poem4787.html","الكامل"],[515,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[515,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[558,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[562,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"]],"verses":[["تُرضيكَ مِن دَلٍّ وَمِن","حُسنٍ مُخالِطُهُ غَرارَه",0,"ر",2,0],["تَرضى قُرَيشٌ بِهِم صِهراً لَأَنفُسِهِم","وَهُم رِضىً لِبَني أُختٍ وَأَصهارِ",1,"ر",1,0],["تَرضى قُضاعَةُ ما قَضَيتَ وَسَلَّمَت","لِرِضىً بِحُكمِكَ حِميَرٌ وَنِزارُ",2,"ر",1,0],["ترضيك جملة أمرهِ في ودِّهِ","لكنها تُشجيك حين تُلَخَّصُ",3,"ص",1,0],["ترضى وتَسْكُتُ هذا غيرُ محتَمَلٍ","إِذاً فهل ترفُضُ الدُّنيا وتنتحرُ",4,"ر",1,0],["تَرضى بِهِ حينَ لا يُرضيكَ مُدبِرُهُم","مُبارَكاً صادِقَ الإِقبالِ مَيمونا",5,"ن",2,0],["تَرُضُّ الحَصى شَوقاً لِمَن سَبَّحَ الحَصى","لَدَيهِ وَحَيّا بِالسَلامِ بَعيرُها",6,"ر",3,0],["تَرضى العَجائِبَ ثُمَّ تَغضَبُ أَنَّني","ناظَرتُ في بَعضِ الأُمورِ أَخاكا",7,"ك",2,0],["تَرضى السُيوفُ بِهِ في الرَوعِ مُنتَصِراً","وَيَغضَبُ الدينَ وَالدُنيا إِذا غَضِبا",8,"ب",2,0],["تَرضى الشُعوبُ إِلى مَدىً فَإِذا أَبَت","رِضِيَ الأَبِيُّ وَطاوَعَ الغَضبانُ",9,"ن",1,0],["تَرضى نُفوسٌ أَن تَكونَ لَكِ الفِدا","فَتَذود عَنكِ وَإِنَّها لَكِرامُ",10,"م",1,0],["تُرْضِيكَ في اللَّهِ أَعْمالٌ وَتُغْضِبُهُ","وَمَا بَدا لِيَ أَمْرٌ مِنْكُمَا نُكرُ",11,"ر",1,0],["تُرضِعُني دَرَّها وَتَلحَفُني","بِظِلِّها وَالهَجيرُ يَلتَهِبُ",12,"ب",1,0],["تَرضى بِحُكمِ القَضاءِ في سَخَطٍ","وَهَل تُحِبُّ الظِباءُ حابِلَها",13,"ل",3,0],["تَرضى العلا عَنهُ وَالأَحسابُ إِن ذكرت","مَكاسِب المَجدِ مِن بَعدِ المَواريثِ",14,"ث",1,0],["تَرضى مِنَ الأَدهانِ بِالأَبوالِ","وَمِن ذَكِيِّ المِسكِ بِالدِّمالِ",15,"ل",1,0],["تُرضينَ مُقترباً ومُبتعِداً","وتُخادعِينَ الصفَّ فالصفّا",16,"ف",2,0],["تَرضى المُلوكُ بِأَن يُدعى لَها شَرَفاً","وَتَعتَلي بِاِسمِهِ الأَشعارُ وَالخُطَبُ",17,"ب",1,0],["ترضى الإِله وتستزيد بشكرهِ","من فضله المغني وموهاباتِهِ",18,"ت",2,0],["تُرضيه رَضوى ويَحلو بالعذيبِ له","نحوَ المدينة إرقالٌ وترسيلُ",19,"ل",1,0],["تُرضّي خيال الناس عند مغيبها","وتُبدي إشارات المنى في حضورِها",20,"ر",3,0],["تَرضى الحَفيظانِ بِإِنشادِها","وَفيكَ بَعضُ القَولِ تَوحيدُ",21,"د",1,0],["تَرضى بأن تنقضي الليالي","وَما اِنقضت حربك العوان",22,"ن",1,0],["ترُضي بها السُّلطَانَ والخاتونَ والْ","أُمراءَ والأجنادَ والأعوانا",23,"ن",2,0],["تَرْضَى بأنْ تَغْدو لها طَرِباً","وفؤادُ ناظِمها لكُمْ وَجِم",24,"م",1,0],["ترضي الأنام بعجبها لكنها","في ذاك تسجد نحو منحوتاتها",25,"ت",3,0],["ترضى بها يا علي عنا","رضا به نبلغ الإحسان",26,"ن",1,0],["تَرضى الدَراريعُ عنهم وَالدُروعُ","وَأَصدافُ القنا وَصُدور البيضِ والأُسُلِ",27,"ل",1,0],["ترض الحصى شوقاً لمن سبح الحصا له","سباع الحي حيته سيدها",28,"د",3,0],["ترضاه ما شهِد النديَّ وما خلا","ودّاً وحَمْدانيَّةً ولسانا",29,"ن",2,0],["ترضاك لو لامست سواك رجم","ناها فحدُّ الحواصنِ الرَّجْمُ",30,"م",1,0],["تُرضي ثراك بواكفٍ متدفِّقٍ","يُروِي صداك وقاطرٍ متسلسِلِ",31,"ل",1,0],["ترضَى بهنّ الدارُ سَقْياً وإن","قال لها نوءُ السِّماكِ اغضبي",32,"ب",2,0],["ترضُّ حَصى المِعْزاءِ حتى كأنهُ","قِلال القرى أو يبْس شرْيٍ يُهشَّم",33,"م",1,0],["تَرُضُّ مَناسِمُ أَنفاسِها","صُخورَ الصَبابَةِ وَالإِكتِئابِ",34,"ب",1,0],["تُرضيكَ هَيبَتُهُ إِذا استَقبَلتَهُ","وَتَقولُ حينَ تَراهُ فيهِ نُحُولُ",35,"ل",1,0],["ترضي رماح الخط بسطة باعه","ومضارب الهندي قوة زنده",36,"د",2,0],["ترضى بأن يقال ذا","من الرجال أشعر",37,"ر",1,0],["ترضون أن الخيال منه لكم","رب وما بالوجود جلمود",38,"د",1,0],["تَرضَى بمَيْسورِ المنافعِ قانعاً","لكنْ بميَسورِ العُلَى لا تَقنَعُ",39,"ع",1,0]]}