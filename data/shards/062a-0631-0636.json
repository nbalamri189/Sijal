{"poems":[[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[29,"إن الندى من بني ذبيان قد علموا","https://www.aldiwan.net/poem5741.html","البسيط"],[29,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[53,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[94,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[47,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[46,"ماذا بدا لك إذ نقضت هواكا","https://www.aldiwan.net/poem30014.html","الكامل"],[46,"قل للأمير الذي قد نال ما طلبا","https://www.aldiwan.net/poem30577.html","البسيط"],[107,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[83,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[48,"قد أشرعت سنبس ذوابلها","https://www.aldiwan.net/poem23187.html","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[45,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[92,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[164,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[208,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[276,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[369,"صيرت خوزستان حربا قائما","https://www.aldiwan.net/poem60610.html","الكامل"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[382,"قف نبك نفسا عجبها بمماتها","https://www.aldiwan.net/poem66907.html","الكامل"],[396,"يا من له الحول والقوه","https://www.aldiwan.net/poem54466.html","عموديه"],[412,"أذهبت رونق ماء النصح في العذل","https://www.aldiwan.net/poem50137.html","البسيط"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[463,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[463,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[463,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[473,"وصفراء ترقص إن قادها","https://www.aldiwan.net/poem60412.html","الكامل"],[475,"نزل المشيب فما له تحويل","https://www.aldiwan.net/poem4787.html","الكامل"],[520,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[563,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[567,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145910","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53878","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48768","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48841","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48846","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37998","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120042","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16809","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64697","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46546","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6759","السريع"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93107","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79947","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79797","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1866,"","https://poetry.dctabudhabi.ae/diwan/poem/200250","الرجز"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71085","الكامل"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100546","السريع"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141450","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109368","البسيط"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105649","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102513","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94068","المجتث"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100374","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202728","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100820","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112649","الرجز"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216548",""],[3654,"","https://poetry.dctabudhabi.ae/diwan/poem/27083","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123841","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111063","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119670","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91018","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62103","البسيط"],[1536,"تَعَزَّ يا خَيْرَ الْوَرَى عَنْ أخٍ","https://www.poetsgate.com/ViewPoem.aspx?id=85714",""],[5187,"عبق نسرين","https://www.poetsgate.com/ViewPoem.aspx?id=33006",""],[5370,"العنز","https://www.poetsgate.com/ViewPoem.aspx?id=81628",""],[5431,"زان العمرَ إيمانُ","https://www.poetsgate.com/ViewPoem.aspx?id=183237",""],[5431,"تغريبة الحضارة العربية ...","https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5493,"يا طائرًا بالنور","https://www.poetsgate.com/ViewPoem.aspx?id=197223",""],[5496,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=213695",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[5732,"يبعد هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177894",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"تتحدث الطرقات عن كلب الوفا","https://www.poetsgate.com/ViewPoem.aspx?id=193531",""],[6093,"حادٍ وليس له بعير","https://www.poetsgate.com/ViewPoem.aspx?id=176447",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""],[463,"من ناصري والزمانُ لي خصمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60190&r=&rc=246",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""]],"verses":[["تُرضيكَ مِن دَلٍّ وَمِن","حُسنٍ مُخالِطُهُ غَرارَه",0,"ر",2,0],["تَرضى قُرَيشٌ بِهِم صِهراً لَأَنفُسِهِم","وَهُم رِضىً لِبَني أُختٍ وَأَصهارِ",1,"ر",1,0],["تَرضى قُضاعَةُ ما قَضَيتَ وَسَلَّمَت","لِرِضىً بِحُكمِكَ حِميَرٌ وَنِزارُ",2,"ر",1,0],["ترضيك جملة أمرهِ في ودِّهِ","لكنها تُشجيك حين تُلَخَّصُ",3,"ص",1,0],["ترضى وتَسْكُتُ هذا غيرُ محتَمَلٍ","إِذاً فهل ترفُضُ الدُّنيا وتنتحرُ",4,"ر",1,0],["تَرضى بِهِ حينَ لا يُرضيكَ مُدبِرُهُم","مُبارَكاً صادِقَ الإِقبالِ مَيمونا",5,"ن",2,0],["تَرُضُّ الحَصى شَوقاً لِمَن سَبَّحَ الحَصى","لَدَيهِ وَحَيّا بِالسَلامِ بَعيرُها",6,"ر",3,0],["تَرضى العَجائِبَ ثُمَّ تَغضَبُ أَنَّني","ناظَرتُ في بَعضِ الأُمورِ أَخاكا",7,"ك",2,0],["تَرضى السُيوفُ بِهِ في الرَوعِ مُنتَصِراً","وَيَغضَبُ الدينَ وَالدُنيا إِذا غَضِبا",8,"ب",2,0],["تَرضى الشُعوبُ إِلى مَدىً فَإِذا أَبَت","رِضِيَ الأَبِيُّ وَطاوَعَ الغَضبانُ",9,"ن",1,0],["تَرضى نُفوسٌ أَن تَكونَ لَكِ الفِدا","فَتَذود عَنكِ وَإِنَّها لَكِرامُ",10,"م",1,0],["تُرْضِيكَ في اللَّهِ أَعْمالٌ وَتُغْضِبُهُ","وَمَا بَدا لِيَ أَمْرٌ مِنْكُمَا نُكرُ",11,"ر",1,0],["تُرضِعُني دَرَّها وَتَلحَفُني","بِظِلِّها وَالهَجيرُ يَلتَهِبُ",12,"ب",1,0],["تَرضى بِحُكمِ القَضاءِ في سَخَطٍ","وَهَل تُحِبُّ الظِباءُ حابِلَها",13,"ل",3,0],["تَرضى العلا عَنهُ وَالأَحسابُ إِن ذكرت","مَكاسِب المَجدِ مِن بَعدِ المَواريثِ",14,"ث",1,0],["ترضى بها سيدي عنى وتلهمني","رشدي وتغفر لي يا خير مغتفر",15,"ر",1,0],["تَرضى مِنَ الأَدهانِ بِالأَبوالِ","وَمِن ذَكِيِّ المِسكِ بِالدِّمالِ",16,"ل",1,0],["تُرضينَ مُقترباً ومُبتعِداً","وتُخادعِينَ الصفَّ فالصفّا",17,"ف",2,0],["تَرضى المُلوكُ بِأَن يُدعى لَها شَرَفاً","وَتَعتَلي بِاِسمِهِ الأَشعارُ وَالخُطَبُ",18,"ب",1,0],["ترضى الإِله وتستزيد بشكرهِ","من فضله المغني وموهاباتِهِ",19,"ت",2,0],["تُرضيه رَضوى ويَحلو بالعذيبِ له","نحوَ المدينة إرقالٌ وترسيلُ",20,"ل",1,0],["تُرضّي خيال الناس عند مغيبها","وتُبدي إشارات المنى في حضورِها",21,"ر",3,0],["تَرضى الحَفيظانِ بِإِنشادِها","وَفيكَ بَعضُ القَولِ تَوحيدُ",22,"د",1,0],["تَرضى بأن تنقضي الليالي","وَما اِنقضت حربك العوان",23,"ن",1,0],["ترُضي بها السُّلطَانَ والخاتونَ والْ","أُمراءَ والأجنادَ والأعوانا",24,"ن",2,0],["تَرْضَى بأنْ تَغْدو لها طَرِباً","وفؤادُ ناظِمها لكُمْ وَجِم",25,"م",1,0],["ترضي الأنام بعجبها لكنها","في ذاك تسجد نحو منحوتاتها",26,"ت",3,0],["ترضى بها يا علي عنا","رضا به نبلغ الإحسان",27,"ن",1,0],["تَرضى الدَراريعُ عنهم وَالدُروعُ","وَأَصدافُ القنا وَصُدور البيضِ والأُسُلِ",28,"ل",1,0],["ترض الحصى شوقاً لمن سبح الحصا له","سباع الحي حيته سيدها",29,"د",3,0],["ترضاه ما شهِد النديَّ وما خلا","ودّاً وحَمْدانيَّةً ولسانا",30,"ن",2,0],["ترضاك لو لامست سواك رجم","ناها فحدُّ الحواصنِ الرَّجْمُ",31,"م",1,0],["تُرضي ثراك بواكفٍ متدفِّقٍ","يُروِي صداك وقاطرٍ متسلسِلِ",32,"ل",1,0],["ترضَى بهنّ الدارُ سَقْياً وإن","قال لها نوءُ السِّماكِ اغضبي",33,"ب",2,0],["ترضُّ حَصى المِعْزاءِ حتى كأنهُ","قِلال القرى أو يبْس شرْيٍ يُهشَّم",34,"م",1,0],["تَرُضُّ مَناسِمُ أَنفاسِها","صُخورَ الصَبابَةِ وَالإِكتِئابِ",35,"ب",1,0],["تُرضيكَ هَيبَتُهُ إِذا استَقبَلتَهُ","وَتَقولُ حينَ تَراهُ فيهِ نُحُولُ",36,"ل",1,0],["ترضي رماح الخط بسطة باعه","ومضارب الهندي قوة زنده",37,"د",2,0],["ترضى بأن يقال ذا","من الرجال أشعر",38,"ر",1,0],["ترضون أن الخيال منه لكم","رب وما بالوجود جلمود",39,"د",1,0],["تَرضَى بمَيْسورِ المنافعِ قانعاً","لكنْ بميَسورِ العُلَى لا تَقنَعُ",40,"ع",1,0],["ترضوا عن القاضي الإمام خطيبكم","فقد رضي الرحمن عنه وأرضاه",41,"ا",2,0],["تُرضِعُه ثَدْيَها اعتناءً","به على أنّه فَطيمُ",42,"م",1,0],["تَرضى بِما يُنفِذُ فيكَ حُكمي","إِذا بِكَ اِشتَدَّ عَذابُ الحِرمِ",43,"م",1,0],["ترضيهم بعد ما أرضوك واحترموا","جميع حقك فيما كان من غضب",44,"ب",1,0],["تُرضي بني عثمانَ منهم ألفةٌ","أولى بأصدقِ من يفي ويغارُ",45,"ر",1,0],["ترضّاهمُ وتوقّاهمُ","فعادوا سلاماً مع العائد",46,"د",1,0],["تَرضى رِضاءَكَ وَالقَبولُ صِداقُها","حَيثُ الرِّضا مِن خَيرِ مَهرٍ فَاِمهَرِ",47,"ر",1,0],["تُرْضِعُ بالإِنْعَامِ ذَا عزَّةٍ","يُقْطَمُ بِالْبُؤْسِ وَبِالتَّعْسِ",48,"س",1,0],["ترضى الغداة عداته وعفاته","منه بأي مطاعن مطعام",49,"م",1,0],["تَرضى مِنَ الدُنيا بِظِلِّ صُخَيرَةٍ","وَمِنَ المَعايِشِ بِاِشتِمامِ رَوائِحِ",50,"ح",1,0],["تَرْضَى المعالي ما ارْتَضا","هُ فَهَلْ رَأَيْتَ أَخاً وأَخْتا",51,"ت",2,0],["ترضيه وَهوَ ساخِط","تُدنيه وَهوَ شاحِط",52,"ط",1,0],["تُرضي الفَتى في عاجِلٍ شَهوَةٌ","لَو خَسِرَ الجَنَّةَ في الآجِلِ",53,"ل",1,0],["تَرضَى الَّذِي يَرضَى وَتَأبَى ما أَبَى","أليَّةً بِرَبِّنا عَزَّ وَجَل",54,"ل",1,0],["ترضون حاشاكم أصلى بنار لظىً","ترمي أعاديكم بالشهب والشرر",55,"ر",1,0],["ترضى بأن تسترقها عُصبٌ","لم تلهُ عن نايها ومزمرها",56,"ر",3,0],["ترضى تعودُ نفوسُنا سَلباً","بيدِ الحمام ونحن في كَنفك",57,"ك",1,0],["ترضى بهِ طوعاً لعين حلي