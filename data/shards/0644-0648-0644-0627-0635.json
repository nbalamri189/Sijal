{"poems":[[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[68,"لا تأخذني بجرم من قد غلطا","https://www.aldiwan.net/poem38812.html","الدوبيت"],[46,"ذل السؤال شجى في الحلق معترض","https://www.aldiwan.net/poem29718.html","البسيط"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[53,"ياضارب المَثَلِ المزخرفِ مُطْرِياً","https://www.poetsgate.com/ViewPoem.aspx?id=28706",""],[469,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77443","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119989","الكامل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102284","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49967","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69401","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110341","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102696","المواليا"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83022","البسيط"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122447","البسيط"],[3683,"","https://poetry.dctabudhabi.ae/diwan/poem/203867","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125800","الكامل"],[4314,"","https://poetry.dctabudhabi.ae/diwan/poem/200330","الكامل"],[5026,"فيلسوف القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=210478",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5952,"لو فيه أفنيْ الحبرَ والقرطاسا","https://www.poetsgate.com/ViewPoem.aspx?id=202324",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""]],"verses":[["لولا صروف الاختيار لأعْنَقوا","لهوىً كما اتسقت جمال قِطارِ",0,"ر",1,0],["لَولا صَدَرَت مِنَ آدَمٍ هَفوَتُهُ","ما كانَ مِنَ الجَنَّةِ يَوماً هَبَطا",1,"ط",2,0],["لَولا صُبابَةُ عِرضي وَاِنتِظارُ غَدٍ","وَالكَظمُ حَتمٌ عَلَيَّ الدَهرَ مُفتَرِضُ",2,"ض",1,0],["لولا صَرامَتُه وقُوَّةُ بَطشِه","ما عَزَّ مَظهرُه وجَلّ الشَّانُ",3,"ن",1,0],["لولا صرامتُه وحِكمةُ رأيهِ","ما ذاق طعمَ الجِدّ شعبُ لاعبُ",4,"ب",1,0],["لَوْلا صِفَاتُكَ وَهْيَ الدُّرُّ مَا بَهرَتْ","أَبْيَاتُهَا الْغُرُّ مِنْ حُسْنٍ وَتَحْبِيرِ",5,"ر",1,0],["لولا صروف الإختيار لأعنَقُوا","لهوًى كما استقت جمال قِطار",6,"ر",1,0],["لولا صدودكِ يا أمامهْ","ما كنتُ أندبُ عهدَ رامهْ",7,"م",2,1],["لَولا صِيامٌ عاقَني عَن شُربِها","لَخَلَعتُ في هَذا النَهار عِذاري",8,"ر",2,0],["لولا صدود أظهرت لبنى","لم يحك جسمي خصرها المضنى",9,"ن",2,1],["لولا صروف الدهر ما خلتني","للبعد عن أوطانها مؤشرا",10,"ر",2,0],["لو لا صدودُ الغواني عن شعاريَ لم","أَشعر بأيّة حال أَصبح الشعرُ",11,"ر",1,0],["لَولا صَوارِمُنا لَكانَت تُبَّلٌ","دَهَمَتكُمُ بِأَشَدِّ خَطب يدهمُ",12,"م",1,0],["لولا صباك لما حزنت على صبا","يذوي ولا أرسلت دمعي صيبا",13,"ب",2,1],["لولا صلاح المكرمات عامر","لأطير اليها وأقطع العلائق",14,"ق",1,0],["لَولا صدودُ الصَّديقِ عَنّي","ما نال واشٍ مناه مني",15,"ن",2,1],["لَولاَ صِغَارٌ كَأفرَاخٍ عَلَى جَبَلٍ","مِن كُلِّ مُنقَطِعٍ بِالغَربِ مُغتَرِبِ",16,"ب",1,0],["لولا صعوبة أبواب وحراس","ومفضحات قيود ذات وسواس",17,"س",1,1],["لولا صدور العفو منك على العدى","بعد اقتدار قيل إنك جازع",18,"ع",1,0],["لولا صفية ما استقامت وائل","فجنود كسرى بالوثيج الأسمر",19,"ر",1,0],["لولا صليبُ الرومِ ما اتَدَتِ الدجى","آياتُ قسطَنْطِينَ وهْو الغادِرْ",20,"ر",1,0],["لولا صفيرُ الحاكمينَ وخوفُهُمْ","ما عَشْعَشَتْ في أرضِنا الغِربانُ",21,"ن",1,0],["لولا صُدودُكِ ماادَّنَتْ مِنّا النوى","جَلّابَةً بَلوى على بَلواكِ",22,"ك",1,0],["لولا صلاة قد بعثتُ بها له","تجلو الهمومَ . تُزكِّي الأنفاسا",23,"س",2,0],["لَولا صُروف الدَهر ما كانَ ضامني","وَلا كان في جوفي صَدى وَكدار",24,"ر",1,0]]}