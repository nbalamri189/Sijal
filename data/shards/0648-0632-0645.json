.aspx?id=36490",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""]],"verses":[["وَزَمانٌ شُرَّعٌ أَنيابُهُ","أَبَداً يَعرُقُنا عَرقَ السَلَم",0,"م",1,0],["وَزَماناً نائِمَ العُذ","ذالِ مَأمونَ الوُشاةِ",1,"ه",1,0],["وَزَماناً مَضى عَلى آبِل السو","قِ وَلَيلُ الشَبابِ وَحفٌ خُداري",2,"ر",2,0],["وَزَمانٌ كَأَنَّما دَبَّ فيهِ","وَسَنٌ أَو هَفا بِهِ فَرطُ سُكرِ",3,"ر",1,0],["وَزَمَاجِرُ الإيعَادِ فِي أسْمَاعِهِمْ","أشْبَاهُ مُطْرِبَةٍ مِنَ الأَلْحَانِ",4,"ن",1,0],["وَزَمزَمُ وَالحطِيمُ وَكُلُّ سَاق","يَرَى أهلَ الخِصَاصِ لَهُ قَطِينَا",5,"ن",2,0],["وزمزمُ والحطيمُ لديَّ منه","هنالك والمشاعرُ والمقامُ",6,"م",1,0],["وَزَمَّتِ الريحُ بِالبُهمى جَحافِلُهُ","وَاِجتَمَعَ الفَيضُ مِن نَعمانَ وَالخُضَرُ",7,"ر",1,0],["وَزَماناً أَحالَني","في أُموري عَلَيكُمُ",8,"م",1,0],["وزمانُ النَّاسِ شَيْخٌ","عابِسُ الوجهِ ثَقيلْ",9,"ل",1,0],["وزمجرت الطبيعة فهي غول","يريد بمن ترباهم نكالا",10,"ل",2,0],["وَزَمانٍ أَنتَ الرِضى مِن بَقايا","هُ وَأَنتَ العَزاءُ مِن آثارِهِ",11,"ر",2,0],["وَزِمامُ الرِكابِ مِن كُلِّ فَجٍّ","وَمَحَطُّ الرِحالِ مِن كُلِّ وادي",12,"د",2,0],["وَزَمزَمُ تَجري بَينَ عَينَيكَ أَعيُناً","مِنَ الكَوثَرِ المَعسولِ مُنفَجِراتِ",13,"ت",1,0],["وزمانُكَ العاصي لغيركَ طائعٌ","لَكَ طاعَةَ المُنقادِ لِلمُقتادِ",14,"د",1,0],["وَزَمزَمٍ وَالجِمارِ إِذ رُمِيَت","وَالجَمرَتَينِ اللَتَينِ بِالبَطنِ",15,"ن",1,0],["وزماناً في الحُسنِ وجْهَ عَلِيٍّ","ذا بَهاءٍ وبَهْجَةٍ وَنَضَارَهْ",16,"ر",2,0],["وَزَميلٍ إِذا رَأى نِقبَةَ اللَي","لِ تَثَنّى كَالشارِبِ المَخمورِ",17,"ر",1,0],["وَزَمَاجِرَ الخُرْسِ الضَّوَا","رِي مِنْ مُعِدَّاتِ الأُزُمْ",18,"م",1,0],["وزميل سمح الزمالة برّ","وأخ بالإخاء جد حفيّ",19,"ي",1,0],["وزمزمةٌ تُنسى الرعودَ هزيمَها","وتثقب آذانَ النجومِ الثواقبِ",20,"ب",1,0],["وزمانٍ حلوٍ كطلِّ ندّيٍ","لم يَشُبْهُ صفوُ السَّماء بشي",21,"ي",1,0],["وزُمرةُ الأدبِ الكابي بزُمرتهِ","تفرَّقَتْ في ضَلالاتِ الهوى عُصَبا",22,"ب",2,0],["وزماجرا قامت على غمّائها","من حكمك العاتي القويّ دليلا",23,"ل",2,0],["وَزَماناً ما زِلتُ أَسأَلُ عَنكُم","فَكَفَتني رُؤياكُمُ الإِسنادا",24,"د",2,0],["وَزَمَانِ آفاتٍ قَطَعنَ تمادِياً","وَخَبَبنَ فى الحزّانِ ذَاتَ هَزَائلِ",25,"ل",1,0],["وزمان به الكري","م كئيب محسّر",26,"ر",1,0],["وزمانه قد قصّرت","أملي فقصّر عن طلابه",27,"ب",2,0],["وزمامُ مَن أهواهُ في","اليُمنى وكاسي في يَساري",28,"ر",2,0],["وزمانُ الدروسِ أضيقُ من أن","يجد الخاملونَ فيه مجالا",29,"ل",2,0],["وَزَمانٌ كَأَنَّ أَي","يامَهُ الغُرَّ لَم تَكُن",30,"ن",1,0],["وَزَمانٍ أَنفَقتُهُ مِن شَبابٍ","غَيرَ مُستَرجَعٍ وَلا مُستَرَدِّ",31,"د",1,0],["وزمزم بكأس الشوق عند مقامها","فليس لصبٍّ واردٍ عنه مصدر",32,"ر",1,0],["وزمان إذا ذكرت أسى منه","تذكرت معضلا ليس يوسا",33,"س",2,0],["وَزَمان أنس بالوصال وَحيرة","كانوا فانوا منزلا وَصدودا",34,"د",2,0],["وَزَمانا يصافى","رامة وَلَواها",35,"ا",3,0],["وَزَمانُهُ طَلقُ المُحَيّا ضاحِكٌ","عَن ناجِذَي عَيشٍ هَنيءٍ ناضِرِ",36,"ر",1,0],["وَزَماني ذاك الزَمانُ المُهَنّى","وَحَبيبي ذاكَ الحَبيبُ المُفَدّى",37,"د",2,0],["وزمزمها راح الكرم ومرهم الس","قام به تبري كلوم الضمائر",38,"ر",1,0],["وزمان عكست أحواله","صار فيه الوجه في حد القفا",39,"ف",2,0],["وزمزم غوث للذبيح وأمه","وقد عطشا والغوث قد عمم الأملا",40,"ل",2,0],["وَزَمانُنا هَذا كَما تدرونهُ","ظَهرَ الفسادُ بِهِ بلا كتمانِ",41,"ن",1,0],["وَزَمانُ وَصلِكَ بِالتَعَلُّلِ فاتَني","أَو ما عَلِمتُ يَطولُ عُمرُكَ أَنَّني",42,"ي",1,0],["وزماني عليّ والعجز من","طبعي فإني على الحقيقة فان",43,"ن",1,0],["وزماني منى وإن كنت عنه","نائيا في الوجود والحسبان",43,"ن",1,0],["وَزَمزَمَهُ ميمٌ طَميسٌ بِمائِها","يَزيلُ الصَدى عَن كُلِّ نَفسٍ زَكِيَّةِ",44,"ه",1,0],["وَزَماناً بِهِ اِنتَهَزنا مِن اللَه","وِ فريصاتِ لذَّة لَيسَ إِلّا",45,"ل",2,0],["وزَمْزمٍ والمَرْوتَيْنِ ومِنَى","والجمْرَتَيْنِ والمَقامِ الأَشْرَف",46,"ف",1,0],["وزمانٌ ثنَى رجائيَ مَيْتاً","في مُلوكِ الوَرى وقَلبيَ قَبرا",47,"ر",2,0],["وَزَمانٍ مَضى فَما عُرِفَ الأَوَّ","لُ إِلّا بِما جَناهُ الأَخيرُ",48,"ر",1,1],["وزمرُ الزامرِ الأَص","فَر أيضاً خاثرٌ أصفَر",49,"ر",1,0],["وزمانٍ من جوهر الرُّوحِ أغلى","فالشبابُ الَّذي قَلَّص ظِلاّ",50,"ل",2,0],["وزمان مضى عيش تقضى","ما أرى عَوْده ولو في المنام",51,"م",1,0],["وزمانٍ قد نَهَبْنا شَطْرَه","ما حَسِبنا غَيره في الدهر عُمرا",52,"ر",2,0],["وزمانٍ منه حَظّي مثلما","كانَ حظّ الشّيب من وُدِّ الغواني",53,"ن",2,0],["وزمانٍ ساقَ لي مِحَناً","ظنّها الأقوامُ بي منَحا",54,"ح",2,0],["وزمت نياق الردى للنوى","جادها من الشيب عجلان حادي",55,"د",2,0],["وزماناً لبستُ فيه رداءً","سابغاً من غضارة العيش ضَافي",56,"ف",2,0],["وزمنٌ قاسٍ سيعطفونه","نحوي بما هم يملكون الأزمنا",57,"ن",2,0],["وزمزمٍ وما شفتْ","من كلّ داء زمزمُ",58,"م",1,0],["وزمَّلوه اليوم في","بجادِ شيخٍ هِمِّ",59,"م",1,0],["وزمانٍ أعاده الله بالجز","عِ تُبارِي أسحارُه آصالَهْ",60,"ل",2,0],["وزمّوها مسنَّمةً بِطاناً","تغصُّ بها النمارقُ والقُطوعُ",61,"ع",1,0],["وزُمَّا بالمطامع أنفَ غيري","فبي عنها وإن خَدعَتْ نفارُ",62,"ر",1,0],["وزماُ لهو بالشآم وموقفٍ","يشتاقُ قاتلهُ فوادُ قتيله",63,"ل",2,0],["وَزَمَّ الرَبيعُ قِبابَ الرُبى","وَأَذهَبَ مِنها الَّذي زَوَّقا",64,"ق",2,0],["وزمانٌ بالحمى قضَّيتُه","ليته كانَ على العلاّتِ داما",65,"م",2,0],["وزمرة دونهم بلها مكبّلة","فلا تميز بين الضرب والضرب",66,"ب",1,0],["وزماني إن سامني كلَّ ضَيمٍ","فهوَ مع مِثلي دائماً في قتالِ",67,"ل",1,0],["وزَمْزَمَ مَوْرِداً تُثْنِي عليه","إذا وردتْ شفاهُ الواردينا",68,"ن",2,0],["وزَمْزَمُ والرّكبُ الّذي يَمسحونه","وَأَيمانُهمْ مِن رَحمة اللَّه تَنطِفُ",69,"ف",1,0],["وزمزمٍ كلّما قسنا مواردَها","أوفى وأربى على كلِّ المواريدِ",70,"د",1,0],["وزمزم القرب منه القوم قد شربوا","وفيه دارت على الأكوان كاسات",71,"ت",1,0],["وزَمْزَمَ الرَّعدُ لكن لم نَجِد مطراً","من بعدهِ وانجلَتْ من حولهِ السُّحُبُ",72,"ب",1,0],["وَزَمانٌ يَظَلُّ يَنشُدُ عَنها","هَكَذا هَكَذا وَإِلّا فَلالا",73,"ل",2,0],["وَزَماني لَما صَفا قال أَرّخ","نَجم مَصر رقى بِعَصر السَعيد",74,"د",1,0],["وَزَماني أَتى بِما أَتمنى","وَصَفا لي وَثَغرُه قَد تبسم",75,"م",1,0],["وَزَماني بِمَولدي في التَهاني","غرّة في جِباه أَعوام دَهري",76,"ر",2,0],["وَزَمزمَ حاديهم بزمزمَ كَم صَدٍ","تَروّى وَذي صَدٍّ جَبتهُ وصالها",77,"ل",3,0],["وزمانُهُ يُبْدي له مأموله","في النفس والأموال والأحبابِ",78,"ب",1,0],["وزماني بما أُحبُّ ضَنينٌ","وعلى من أُحِبُّ فيه ضَنِينُ",79,"ن",1,0],["وزمانه وأمانه وحنانه","فينا وحكمة رأيه ومضائه",80,"ا",3,0],["وزمانٍ مثل ابنةِ الكرم حسناً","عاد عند العيون مثلَ الدَاذي",81,"ذ",2,0],["وَزَماناً مَضى حَميداً سَريعاً","وَشَباباً مِثلَ الرِداءِ المُعارِ",82,"ر",1,0],["وزمان ما طاب بالوصل حتى","قصرته أيام هجر طوال",83,"ل",1,0],["وزماني منية ورجا","ولقد زاد الفؤاد شجى",84,"ا",1,0],["وَزَمَان قَطَعْتُ فِيهِ وِصَالاً","بِحَبِيب حَلَلْتُ عُقْدَةَ بَنْدِهْ",85,"د",2,0],["وزمانٌ فقدتُهُ من زمانٍ","قد طوى خيرَه عن الأخيارِ",86,"ر",1,0],["وزمرة الأهل والاخوان اجمعهم","للبعث باكيةٌ في حالةٍ قلقَةْ",87,"ق",2,0],["وَزَماناً بذِي طَلوحٍ حَبانا","وارِفَ الظَّلِّ مِنْهُ ضَالٌ وطَلْحُ",88,"ح",1,0],["وزماني إذا رماني بسوء","اذهب الذكر في حبيبي ما بي",89,"ب",2,0],["وزمام المجد في حبيه فاحببه","ترقى قنة الفضل البديع",90,"ع",1,0],["وَزَمزَم الساقي","في رَوضة الأَزهار",91,"ر",1,0],["وزُمَّت إلى ضعف القوى عزمهُ النَّوى","ورضَّض أَفواه الحُداة بجَندلِ",92,"ل",1,0],["وزمزم حاد في صعيد نوىً لي ال","حجاز ومن عشّاقه السمع شنّفا",93,"ف",2,0],["وزمرةٌ في شباك البغي قد علقت","فساقها ولها في السوق أكبالُ",94,"ل",1,0],["وَزَمَانُهُ إنْ طَالَ كَانَ دَقِيقَةً","وَيَكَادُ يَبلُغُ فِي الخَيَالِ شُهُورَا",95,"ر",2,0],["وزمرة من رياض القدس زاهرة","من عرفها نال شذوي عرفه الزهر",96,"ر",1,0],["وَزَمانِ لَهوٍ بِالمَعَرَّةِ مُونَقٍ","بِسِيائِها وَبِجانِبَي هِرماسِها",97,"س",3,0],["وزمام الامور تسجد طوعا","لابن سلطان سجدة الأذهان",98,"ن",1,0],["وزمان الخير والخيرات آت","والمسرّات لها ال