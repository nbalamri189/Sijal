{"poems":[[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[92,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[556,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[556,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94022","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11247","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86279","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138654",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94466","الوافر"],[5582,"جَفا جَفْنَهُ يَوْمَ الفِراقِ رُقادُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186903",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""]],"verses":[["وَإِذ سُلَيما سَجِنٌ مَحصورُ","لَيسَ عَلينا في الهَوى نَغيرُ",0,"ر",1,0],["وإذ سيِّدُ العَرَبِ الأولينَ","يتمِّمُ بالسيف نُقصانه",1,"ن",2,0],["وَإذْ سِرِّي بِمَرأىً منك بادٍ","وما دوني لسرّك من سِجافِ",2,"ف",1,0],["وَإِذْ سالتْ إِلينا من هُذَيلٍ","شعابُ الواديين بغير بَخْسِ",3,"س",1,0],["وإذ سمعت أذني بذا وهو حرفتي","وعلمنيه الداوري بامتنانه",4,"ن",2,0],["وَإِذ سِهامي صِيابٌ","وَنَصلُ سَيفي عَضبُ",5,"ب",1,0],["وَاذ سَما في ذَرى الجنات مُرتَقِياً","حياة رِضوانِها عَن ثُغر مُبتَسِمِ",6,"م",1,0],["وإذ ساروا بحيدرة أسيراً","ونادتهم ألا خلوا ابن عمي",7,"م",2,0],["واذ سود البارود بيض ديارها","توهج منكم فوقه اصفر التبر",8,"ر",1,0],["وإذ سمحت وفيك ظني صادق","فلقد سلكت مناهج السعداء",9,"ا",2,0],["وإذ سَبَتِ العقول بسحر لحظٍ","فناداها النهى يا بابليَه",10,"ي",2,0],["وَإِذْ سارَ فِي سَوْدائِهِ حَكَمَ النَّوَى","جَوىً لَيْسَ يَخْبُو وَهْجُهُ وَاتِّقادُهُ",11,"د",2,0],["وإذ سَجَدْتُ ببابِ العشقِ مُحترقاً","أَوْمَتْ لي النارُ يا بَعضي من الشَّرَرِ",12,"ر",1,0]]}