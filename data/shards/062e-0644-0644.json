{"poems":[[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[68,"إنما الحيزبون والدردبيس","https://www.aldiwan.net/poem38647.html","الخفيف"],[54,"خل لنا دمنا على وصله","https://www.aldiwan.net/poem26834.html","السريع"],[50,"ضحك الشيب في نواحي الظلام","https://www.aldiwan.net/poem65114.html","الخفيف"],[50,"خل لغيلان نعته صيدح","https://www.aldiwan.net/poem66572.html","المنسرح"],[98,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""],[309,"يا نديمي فؤادي مرتهن","https://www.aldiwan.net/poem16783.html","الطويل"],[369,"أعزيز بغداد أعد نظرا لنا","https://www.aldiwan.net/poem60811.html","الكامل"],[463,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[505,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64307","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69205","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89087","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52989","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86270","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35506","المنسرح"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133076","المجتث"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5353,"لعنة قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=212463",""],[5790,"أخنساء ما قلب المتيم من صخرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111918",""],[4430,"خل لا تغالب فتغلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612819",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""]],"verses":[["خَلِّ لِلدَيّانِ فيهِم شانَهُ","إِنَّهُ أَولى بِهِم سُبحانَهُ",0,"ه",1,0],["خَلِّ لِلأَصمَعيِّ جَوبَ الفَيافي","في نَشافٍ تَخِفُّ فيهِ الرُؤوسُ",1,"س",1,0],["خِلٌّ لَنا دَمُّنا عَلى وَصلِهِ","وَنَفسُهُ لَيسَت لَنا مُنصِفَه",2,"ه",1,1],["خَلِّ لِلأَشقِياءِ وَصفَ الفَيافي","وَاِسقِنيها سُلافَةً بِسَلامِ",3,"م",1,0],["خل لغيلان نعتهُ صَيدَح","ودع جريراً بشعرهِ يمزح",4,"ح",1,1],["خلل من وشائع النّور زهر","يتماوجن في حواشي السّحاب",5,"ب",1,0],["خل لو أنها شك ولي","عن سبيل السلامة والرضا",6,"ض",2,0],["خَلَلاً إليك وخَلّةً نشكو فمُرْ","بسَدادِ خَلَّتِنا وتَسديدِ الخَلَل",7,"ل",1,0],["خلِّ له الناسَ وبِعْهم غانياً","به على كثرتهم وفادِ",8,"د",1,0],["خلِّ لله في فؤادك سرّاً","فبذا السرِّ يحصل المأمول",9,"ل",1,0],["خلِّ لأبناءِ الغِنى دُنياهمُ","فمنْ يُهِنْ هذا الثَّراءَ لم يَهُنْ",10,"ن",1,0],["خلل السحايبِ لَوْ يُعَمِّر حُسْنُها","لَغَلَتْ على مُبْتاعِها أثْمانُها",11,"ن",3,1],["خلّ لَحييك يَسكنان وَلا تض","رب عَلى تغلبٍ بلحييك طاقا",12,"ق",2,0],["خل للبعث ذلك البحث إني","ضلَّ عقلي فيه وزلَّ اجتهادي",13,"د",2,0],["خلِّ لغرام لصبٍّ دمعه دمُه","حيرانُ تُوجده الذكرى وتُعدمُه",14,"م",2,1],["خِلٌّ لِكل وَقد طابَت سَريرَتِهِ","بِطيبِ ذِكر شَذاه فاح مَنشورا",15,"ر",2,0],["خَلّ لَها في الزِمامِ تَنبَعث","وَاِرم بِها البيدَ غَيرَ مُكتَرِثِ",16,"ث",1,1],["خل لا تغالب فتغل","ولا تمار فتتعب",17,"ب",1,1],["خللها من اثنتي عشر إلى","سنة خمس مع عشرين ولا",18,"ل",2,0],["خل للحب موضعا من قلوب","شفها البؤس والشقاء ارتياعا",19,"ع",2,0],["خَلَلَ الرِّمال ِ مقاتلي موقوفة ٌ","ودمي رياحٌ عاقراتٌ شُكَّم ُ",20,"م",1,0],["خللي بالله أبلغاها رسالةً","أرق من الشكوى ومن غزل الشعر",21,"ر",1,0],["خل لا تغالب فتغلب","ولا تمار فتتعب",22,"ب",1,1],["خَلَلٌ أصابَ الحُبَّ في أوصالهِ","لمّا ارتمى وجهُ الخداعِ ببابهِ",23,"ب",2,0]]}