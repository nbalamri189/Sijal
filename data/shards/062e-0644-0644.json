{"poems":[[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[66,"إنما الحيزبون والدردبيس","https://www.aldiwan.net/poem38647.html","الخفيف"],[52,"خل لنا دمنا على وصله","https://www.aldiwan.net/poem26834.html","السريع"],[48,"ضحك الشيب في نواحي الظلام","https://www.aldiwan.net/poem65114.html","الخفيف"],[48,"خل لغيلان نعته صيدح","https://www.aldiwan.net/poem66572.html","المنسرح"],[96,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""],[304,"يا نديمي فؤادي مرتهن","https://www.aldiwan.net/poem16783.html","الطويل"],[364,"أعزيز بغداد أعد نظرا لنا","https://www.aldiwan.net/poem60811.html","الكامل"],[458,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"]],"verses":[["خَلِّ لِلدَيّانِ فيهِم شانَهُ","إِنَّهُ أَولى بِهِم سُبحانَهُ",0,"ه",1,0],["خَلِّ لِلأَصمَعيِّ جَوبَ الفَيافي","في نَشافٍ تَخِفُّ فيهِ الرُؤوسُ",1,"س",1,0],["خِلٌّ لَنا دَمُّنا عَلى وَصلِهِ","وَنَفسُهُ لَيسَت لَنا مُنصِفَه",2,"ه",1,1],["خَلِّ لِلأَشقِياءِ وَصفَ الفَيافي","وَاِسقِنيها سُلافَةً بِسَلامِ",3,"م",1,0],["خل لغيلان نعتهُ صَيدَح","ودع جريراً بشعرهِ يمزح",4,"ح",1,1],["خلل من وشائع النّور زهر","يتماوجن في حواشي السّحاب",5,"ب",1,0],["خل لو أنها شك ولي","عن سبيل السلامة والرضا",6,"ض",2,0],["خَلَلاً إليك وخَلّةً نشكو فمُرْ","بسَدادِ خَلَّتِنا وتَسديدِ الخَلَل",7,"ل",1,0],["خلِّ له الناسَ وبِعْهم غانياً","به على كثرتهم وفادِ",8,"د",1,0],["خلِّ لله في فؤادك سرّاً","فبذا السرِّ يحصل المأمول",9,"ل",1,0],["خلِّ لأبناءِ الغِنى دُنياهمُ","فمنْ يُهِنْ هذا الثَّراءَ لم يَهُنْ",10,"ن",1,0]]}