{"poems":[[63,"تراءت لنا والبدر وهنا على قدر","https://www.aldiwan.net/poem46189.html","الطويل"],[77,"يا ولي الإلاه أنت جواد","https://www.aldiwan.net/poem35987.html","الخفيف"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[88,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"كان هزلا فعاد جدا غرامي","https://www.aldiwan.net/poem66364.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[62,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[45,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"يا دار كم حلك أقمار","https://www.aldiwan.net/poem28820.html","السريع"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"أين الجواب وأين رد رسائلي","https://www.aldiwan.net/poem64956.html","الكامل"],[48,"لا أندب الربع قفرا غير مأنوس","https://www.aldiwan.net/poem66269.html","البسيط"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72251","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""]],"verses":[["فمَدَّت لنا الأعناقَ طَوعاً وما اتّقَتْ","بِلَيِّ خُدودٍ في أزِمَّتِها صُعْرِ",0,"ر",1,0],["فمدَدْنا لكَ الأكُفَّ نُرَجّي","عَوْدَةَ العِزِّ تحْتَ شمْلٍ جَميعِ",1,"ع",1,0],["فمدّ جَناحَ الأمْنِ فوقَ مَخافَتي","وقد فرّ عنْها الذُّعْرُ منْ شدّةِ الذّعْرِ",2,"ر",1,0],["فمدّ إليها معالي الوزي","ر يداً دأبها الغوث عند الكرب",3,"ب",1,0],["فَمَدافِعُ الرَيّانِ عُرِّيَ رَسمُها","خَلَقاً كَما ضَمِنَ الوُحِيَّ سِلامُها",4,"م",3,0],["فمُدام الكُرومِ غيرُ حلال","وهْيَ تَسقي المُدامَ غيرَ حرام",5,"م",1,0],["فمديحُ الملوكِ في آل نصرٍ","ومديحُ الملوك من غسان",6,"ن",1,0],["فَمَدَّ إِلى السِكّينِ كَفّاً نَقِيَّةً","أَبَت أَن يَراها تَستَغيثُ بَخيلُ",7,"ل",1,0],["فمدت يداً نحو الخيال مشيرة","إليه وقالت وهي في البين تسعل",8,"ل",1,0],["فَمَدرَسَةٌ لِحَربِ الجَهلِ تُبنى","وَمُستَشفى يُذادُ بِهِ السَقامُ",9,"م",1,0],["فم دواها وعقاقيرها","شرابك السائغ والأكلُ",10,"ل",1,0],["فَمَديحُ فَغورِها فَتِهامٍ","فَبِأَرضِ العِراقِ وَاليَرموكِ",11,"ك",1,0],["فَمدحُكَ في الإِحسانِ أطلقَ مِقوَلي","وعندكَ أُفْني ما تبقّى مِنَ العُمرِ",12,"ر",1,0],["فَمَدَّ عَلى الثَغرِ إِعصارَها","بِرَأيٍ حُسامٍ وَنَفسٍ فَضاءِ",13,"ا",2,0],["فَمَدَّ ثَوباً وَحَطَّ الرُّكنَ في وَسَطٍ","مِنهُ وَقالَ اِرفَعُوهُ جانِبَ الرَّضَمِ",14,"م",1,0],["فَمَدحُهُ رَأسُ مالي يَومَ مُفتَقَرِي","وَحُبُّهُ عِزُّ نَفسي عِندَ مُهتَضَمِي",14,"م",2,0],["فمدمعي مِنْ حين فارقتُهُمْ","جاري وقلبي لهمُ جارُ",15,"ر",1,0],["فَمُدافِعِ البَرقَينِ فَال","حَنّانِ مِن طَرفِ الأَواشِح",16,"ح",1,0],["فمدينَةٌ من بعد أُخرى تُستَبَى","وطريقَةٌ من بعدِ أُخرى تُقتَفى",17,"ف",2,0],["فمدحُك مفروضٌ وحكمُك مرتضىً","وهديُك مرغوبٌ وسخطُك مرهوب",18,"ب",1,0],["فَمَدَدتُ كَفّي ثُمَّ قُلتُ تَصَدَّقي","قالَت نَعَم بِحِجارَةٍ وَجَنادِلِ",19,"ل",1,0],["فمدّ راحته نحوي وأنشدَني","حيّ الهِدَملة من ذاتِ المواعيس",20,"س",1,0],["فمَدّتْ إلى مثْلِ السّماءِ رقابَها","وعَبّتْ قليلاً بينَ نَسْرٍ وفَرْقَدِ",21,"د",1,0],["فمدت يداً منها إليه مشيرة","وَقالَت بصوت راجف يتقطع",22,"ع",1,0],["فمُدَّ جَناحيكَ فوق الحياةِ","وأطلِقْ نشيدَك في فجرِها",23,"ر",3,0],["فمَدَّتْ ليَ الأسبابَ حتَّى بَلغْتُها","برِفْقي وقد كادَ ارْتِفاقي يَضيرُها",24,"ر",3,0],["فَمَدَّتْ بِهِ الأَعْنَاقَ تَعْطُو وَتَخْتَلِي","نِهاباً وَتُغْلي فِي النَّباتِ وَتُرْخِصُ",25,"ص",1,0],["فمدّ كفا خجولا ، وانحنى فرنا","من وجهها الموعد المجهول والصلّف",26,"ف",1,0],["فمُدّوا كفَّكَم هَوناً فهَوناً","وجُرّوا منه أنياباً شِناعا",27,"ع",2,0]]}