{"poems":[[63,"تراءت لنا والبدر وهنا على قدر","https://www.aldiwan.net/poem46189.html","الطويل"],[77,"يا ولي الإلاه أنت جواد","https://www.aldiwan.net/poem35987.html","الخفيف"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[88,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"كان هزلا فعاد جدا غرامي","https://www.aldiwan.net/poem66364.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[62,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[45,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"يا دار كم حلك أقمار","https://www.aldiwan.net/poem28820.html","السريع"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"أين الجواب وأين رد رسائلي","https://www.aldiwan.net/poem64956.html","الكامل"],[48,"لا أندب الربع قفرا غير مأنوس","https://www.aldiwan.net/poem66269.html","البسيط"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72251","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[113,"مرت مطيلسة بثوب أطلس","https://www.aldiwan.net/poem41686.html","الكامل"],[130,"إن كان ربي أخفى الشيخ عن زمر","https://www.aldiwan.net/poem54644.html","البسيط"],[130,"وأحوى في الملاحة ذي افتتان","https://www.aldiwan.net/poem54706.html","الوافر"],[133,"عرضت على ذات الدلال صبابتي","https://www.aldiwan.net/poem49193.html","الطويل"],[141,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[141,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[148,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[158,"أتتنا ما جردت صارمك البشرى","https://www.aldiwan.net/poem58956.html","الطويل"],[158,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[158,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[161,"أرسم ديار لإبنة القين تعرف","https://www.aldiwan.net/poem397.html",""],[183,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[184,"أبصرتها بيضاء ذات ذوائب","https://www.aldiwan.net/poem43701.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[233,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[239,"فديتك من جان تجور وتعتب","https://www.aldiwan.net/poem45750.html","الطويل"],[244,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[268,"ما كان أظرف من نظرت إليه","https://www.aldiwan.net/poem35286.html","الكامل"],[269,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[269,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[273,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[283,"ما الفخر بالأهرام عندي حجة","https://www.aldiwan.net/poem39424.html","الكامل"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[318,"يا آل قليوب بخير أبشروا","https://www.aldiwan.net/poem67222.html","الكامل"],[366,"خليلي عوجا بارك الله فيكما","https://www.aldiwan.net/poem1870.html","الطويل"],[369,"بينته يهوى الطيور ويو","https://www.aldiwan.net/poem57209.html","أحذ الكامل"],[374,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[400,"ما ضاع ما ضاع ما أهداه لومه","https://www.aldiwan.net/poem33418.html","البسيط"],[413,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[434,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[436,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[436,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[441,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[456,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[459,"يسح نواله من غير شيم","https://www.aldiwan.net/poem16159.html","الوافر"],[459,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[462,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[462,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[477,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[527,"مسائل من يحررها نهارا","https://www.aldiwan.net/poem37083.html","الوافر"],[549,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[549,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[549,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[556,"أيا ساكنين الشرق قد شرقت بكم","https://www.aldiwan.net/poem34313.html","الطويل"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"]],"verses":[["فمَدَّت لنا الأعناقَ طَوعاً وما اتّقَتْ","بِلَيِّ خُدودٍ في أزِمَّتِها صُعْرِ",0,"ر",1,0],["فمدَدْنا لكَ الأكُفَّ نُرَجّي","عَوْدَةَ العِزِّ تحْتَ شمْلٍ جَميعِ",1,"ع",1,0],["فمدّ جَناحَ الأمْنِ فوقَ مَخافَتي","وقد فرّ عنْها الذُّعْرُ منْ شدّةِ الذّعْرِ",2,"ر",1,0],["فمدّ إليها معالي الوزي","ر يداً دأبها الغوث عند الكرب",3,"ب",1,0],["فَمَدافِعُ الرَيّانِ عُرِّيَ رَسمُها","خَلَقاً كَما ضَمِنَ الوُحِيَّ سِلامُها",4,"م",3,0],["فمُدام الكُرومِ غيرُ حلال","وهْيَ تَسقي المُدامَ غيرَ حرام",5,"م",1,0],["فمديحُ الملوكِ في آل نصرٍ","ومديحُ الملوك من غسان",6,"ن",1,0],["فَمَدَّ إِلى السِكّينِ كَفّاً نَقِيَّةً","أَبَت أَن يَراها تَستَغيثُ بَخيلُ",7,"ل",1,0],["فمدت يداً نحو الخيال مشيرة","إليه وقالت وهي في البين تسعل",8,"ل",1,0],["فَمَدرَسَةٌ لِحَربِ الجَهلِ تُبنى","وَمُستَشفى يُذادُ بِهِ السَقامُ",9,"م",1,0],["فم دواها وعقاقيرها","شرابك السائغ والأكلُ",10,"ل",1,0],["فَمَديحُ فَغورِها فَتِهامٍ","فَبِأَرضِ العِراقِ وَاليَرموكِ",11,"ك",1,0],["فَمدحُكَ في الإِحسانِ أطلقَ مِقوَلي","وعندكَ أُفْني ما تبقّى مِنَ العُمرِ",12,"ر",1,0],["فَمَدَّ عَلى الثَغرِ إِعصارَها","بِرَأيٍ حُسامٍ وَنَفسٍ فَضاءِ",13,"ا",2,0],["فَمَدَّ ثَوباً وَحَطَّ الرُّكنَ في وَسَطٍ","مِنهُ وَقالَ اِرفَعُوهُ جانِبَ الرَّضَمِ",14,"م",1,0],["فَمَدحُهُ رَأسُ مالي يَومَ مُفتَقَرِي","وَحُبُّهُ عِزُّ نَفسي عِندَ مُهتَضَمِي",14,"م",2,0],["فمدمعي مِنْ حين فارقتُهُمْ","جاري وقلبي لهمُ جارُ",15,"ر",1,0],["فَمُدافِعِ البَرقَينِ فَال","حَنّانِ مِن طَرفِ الأَواشِح",16,"ح",1,0],["فمدينَةٌ من بعد أُخرى تُستَبَى","وطريقَةٌ من بعدِ أُخرى تُقتَفى",17,"ف",2,0],["فمدحُك مفروضٌ وحكمُك مرتضىً","وهديُك مرغوبٌ وسخطُك مرهوب",18,"ب",1,0],["فَمَدَدتُ كَفّي ثُمَّ قُلتُ تَصَدَّقي","قالَت نَعَم بِحِجارَةٍ وَجَنادِلِ",19,"ل",1,0],["فمدّ راحته نحوي وأنشدَني","حيّ الهِدَملة من ذاتِ المواعيس",20,"س",1,0],["فمَدّتْ إلى مثْلِ السّماءِ رقابَها","وعَبّتْ قليلاً بينَ نَسْرٍ وفَرْقَدِ",21,"د",1,0],["فمدت يداً منها إليه مشيرة","وَقالَت بصوت راجف يتقطع",22,"ع",1,0],["فمُدَّ جَناحيكَ فوق الحياةِ","وأطلِقْ نشيدَك في فجرِها",23,"ر",3,0],["فمَدَّتْ ليَ الأسبابَ حتَّى بَلغْتُها","برِفْقي وقد كادَ ارْتِفاقي يَضيرُها",24,"ر",3,0],["فَمَدَّتْ بِهِ الأَعْنَاقَ تَعْطُو وَتَخْتَلِي","نِهاباً وَتُغْلي فِي النَّباتِ وَتُرْخِصُ",25,"ص",1,0],["فمدّ كفا خجولا ، وانحنى فرنا","من وجهها الموعد المجهول والصلّف",26,"ف",1,0],["فمُدّوا كفَّكَم هَوناً فهَوناً","وجُرّوا منه أنياباً شِناعا",27,"ع",2,0],["فمددت كف السول أطلب وصلها","والقلب بين مصدقٍ وموسوس",28,"س",1,0],["فمدحهم إن أتَانا فهو مدحتنا","وسبهم إن أتَانَا آخرَ الخبرِ",29,"ر",1,0],["فَمَدَّ بَنَانَهُ وَبِهِ بَنَانٌ","فَأمسَكتُ البَنَانَ مع البنان",30,"ن",1,0],["فمدّت إليهم هذه الحرب بأسها","وسدّت عليهم مهيعَ البرّ والبحرِ",31,"ر",1,0],["فَمُدَّت لَكَ الأَيدي وَلَو أَنَّها أَبَت","لَمُدَّت رِقابٌ لِلصَوارِمِ خُضَّعا",32,"ع",2,0],["فَمُدَّةُ عَصرِكَ الماضي حَميداً","تُرى ساعاً وَإِن كانَت سِنينا",33,"ن",2,0],["فَمَدحُ رَسولِ اللَهِ مِن أَوكَدِ الفَرضِ","تَوَجَّهُ بِهِ اللَه أَفضَلَ وِجهَةٍ",34,"ه",1,0],["فمد على شرق البلاد وغربها","جيوشك واملا السهل منهن والوعرا",35,"ر",2,0],["فمد على الدنيا ظلالك واطوها","بسيفك طي الطرس واستفتح المدنا",36,"ن",2,0],["فمدوا بالدعا الأيدي إليه","لدولته السعيدة بالدوام",37,"م",1,0],["فَمَدَّ يَدَيهِ من قَريبٍ وَصدرُه","بمَعبَلَةٍ مِمّا يَريشُ وَيَرصُفُ",38,"ف",1,0],["فمدحُك ما يجري به كل مَنْطق","وحبُّك ما تُحْنَى عليه لأَ اضالع",39,"ع",1,0],["فمدحتها بقصيدة وسألتُها","وصلا لتضرب هامة القياس",40,"س",1,0],["فَمديحُ الأنامِ مِن بعدِ هذا","خَبرٌ صحّ مُنتهاه اِبتداءُ",41,"ا",2,0],["فَمُدامَةٌ سِحرِيَّةٌ","تَرمي العُقولَ بِسَكرَتَينِ",42,"ن",1,0],["فَمُدَّ يداً بيضاءَ مِنك تُنيلُها","مِنَ الخير ما تَرجو وما تَتَطلَّب",43,"ب",1,0],["فمدتْ ليَ الأسبابَ حتى بلغتُها","برِفقي وقد كادَ ارتقائي يَصورُها",44,"ر",3,0],["فمَددتُ كاسي نحوَهُ ليصبَّ لي","وأعزُّ شيءٍ ما طَلبتُ إليه",45,"ي",2,0],["فمد عليهم منه ظل هداية","وأرشد منهم للهدى كل حائِر",46,"ر",1,0],["فمدح محمد شرفي وَعزى","وَجاهى في العَشائِر واِفتِخاري",47,"ي",1,0],["فَمُدَّ إلَيْهَا رافِعاً يَد قابِلٍ","أكَبَّ عَلَيها خَافِضاً فَمَ لاثِمِ",48,"م",1,0],["فمدار عمران البلاد وفخرها","وصلاحها عدل عليه تدار",49,"ر",1,0],["فَمدارُ إِحسانِ العبادةِ منهمُ","رُقبى ورُهبى مِن تجلٍّ يصدعُ",50,"ع",1,0],["فَمُديرُكُم جَمَعَ المَحاسِنِ كُلَّها","كَالبَدرِ يَمحو نورُهُ ظُلمَ الدُجا",51,"ج",2,0],["فمدَّت يداً في حُسنِ كلٍّ تناولاً","إليه وقالت ما أرى مثل ذا يُهْدى",52,"د",2,0],["فَمدحتُهُ أحكي فَواختَهُ","وكتبتُ وهيَ كأنَّها تُملي",53,"ي",1,0],["فمددتُ نحوهمهمُ يدي","فكأنها أيدي سبا",54,"ب",2,0],["فمدحه شرف للنظم ليس له","فقدره جل عن نظم يعظمه",55,"م",2,0],["فمدحٌ لم يكن فيك","فتزويرٌ وبهتان",56,"ن",1,0],["فمدارِ ظهرَيْهَا فرأْسِ سَرُوجِها","فراقُ رأْسِ سَرُوجها من مُنْيَتي",57,"ي",1,0],["فمدلي لتحيا الروح منك بنظرة","عسى أنني من نظرة أتمتّع",58,"ع",1,0],["فَمُدِيّ طرفَ ناظرةٍ تَرَيْني","تَمَكَّنَ مَغَرِسي فِيهِ وأصْلي",59,"ي",1,0],["فَمَدُّوا حبالَهُمُ طامعينَ","وأَلْقَوْا عِصِيَّهُمُ واثِقِينا",60,"ن",2,0],["فمدونا بأعتدة","وامداد كذي رحم",61,"م",1,0],["فمِدَحي عليكُمُ","دون الأنام تعكُفُ",62,"ف",1,0],["فمُدَّتْ إليها بالردى يَدُ كاسرٍ","وكان يقيها المجدُ من يد ثاقبِ",63,"ب",1,0],["فمَدْحي لا يلُمُّ بهِ مَعابٌ","ووُدِّي لا يَدِبُّ إليهِ ذامُ",64,"م",1,0],["فمَدائحي والمَجْدُ ينظمُ دُرَّها","في سِلْكِهِ كَصبابَةِ المُتَغزِّلِ",65,"ل",1,0],["فمدح فصيح لا يدين بعجة","صليب القوافي لا يلين على العجم",66,"م",1,0],["فمدامعي أنصارُ قلبٍ مرسلٍ","في الحيِّ ينذر بالمنام الآبق",67,"ق",1,0],["فمد لمديتي عنق التجري","فكم جزيت بالشعر الرقابا",68,"ب",2,0],["فَمُدَّ على المعائِبِ مِنْكَ سِتْراً","فَسَتْرُ العَيْبِ أَخْلاقُ الكِرامِ",69,"م",1,0],["فمدحُك دون كلِّ النّاسِ حِلٌّ","وفي باقي الورى كلُّ الحرامِ",70,"م",1,0],["فمدائحي مشفوعةٌ بمدائحي","ومفاخري مجموعة بمفاخري",71,"ر",2,0],["فَمدحُك قد كَساني الفخرَ بُرداً","وأسكنني من العَلْياءِ دارا",72,"ر",2,0],["فمدت يد شرقية قادرية","بها نشأتي خضراء طيبة العرق",73,"ق",1,0],["فَمَدَّ أَعرافَ العَجاجِ وَاِنتَشَر","وَاِنفَرَجَت 