iewPoem.aspx?id=142622",""],[5704,"لاح الحياء","https://www.poetsgate.com/ViewPoem.aspx?id=195151",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[5771,"ليسَ إلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=189110",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5943,"صلاة الشكر","https://www.poetsgate.com/ViewPoem.aspx?id=62007",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""]],"verses":[["فمَدَّت لنا الأعناقَ طَوعاً وما اتّقَتْ","بِلَيِّ خُدودٍ في أزِمَّتِها صُعْرِ",0,"ر",1,0],["فمدَدْنا لكَ الأكُفَّ نُرَجّي","عَوْدَةَ العِزِّ تحْتَ شمْلٍ جَميعِ",1,"ع",1,0],["فمدّ جَناحَ الأمْنِ فوقَ مَخافَتي","وقد فرّ عنْها الذُّعْرُ منْ شدّةِ الذّعْرِ",2,"ر",1,0],["فمدّ إليها معالي الوزي","ر يداً دأبها الغوث عند الكرب",3,"ب",1,0],["فَمَدافِعُ الرَيّانِ عُرِّيَ رَسمُها","خَلَقاً كَما ضَمِنَ الوُحِيَّ سِلامُها",4,"م",3,0],["فمُدام الكُرومِ غيرُ حلال","وهْيَ تَسقي المُدامَ غيرَ حرام",5,"م",1,0],["فمديحُ الملوكِ في آل نصرٍ","ومديحُ الملوك من غسان",6,"ن",1,0],["فَمَدَّ إِلى السِكّينِ كَفّاً نَقِيَّةً","أَبَت أَن يَراها تَستَغيثُ بَخيلُ",7,"ل",1,0],["فمدت يداً نحو الخيال مشيرة","إليه وقالت وهي في البين تسعل",8,"ل",1,0],["فَمَدرَسَةٌ لِحَربِ الجَهلِ تُبنى","وَمُستَشفى يُذادُ بِهِ السَقامُ",9,"م",1,0],["فم دواها وعقاقيرها","شرابك السائغ والأكلُ",10,"ل",1,0],["فَمَديحُ فَغورِها فَتِهامٍ","فَبِأَرضِ العِراقِ وَاليَرموكِ",11,"ك",1,0],["فَمدحُكَ في الإِحسانِ أطلقَ مِقوَلي","وعندكَ أُفْني ما تبقّى مِنَ العُمرِ",12,"ر",1,0],["فَمَدَّ عَلى الثَغرِ إِعصارَها","بِرَأيٍ حُسامٍ وَنَفسٍ فَضاءِ",13,"ا",2,0],["فَمَدَّ ثَوباً وَحَطَّ الرُّكنَ في وَسَطٍ","مِنهُ وَقالَ اِرفَعُوهُ جانِبَ الرَّضَمِ",14,"م",1,0],["فَمَدحُهُ رَأسُ مالي يَومَ مُفتَقَرِي","وَحُبُّهُ عِزُّ نَفسي عِندَ مُهتَضَمِي",14,"م",2,0],["فمدمعي مِنْ حين فارقتُهُمْ","جاري وقلبي لهمُ جارُ",15,"ر",1,0],["فَمُدافِعِ البَرقَينِ فَال","حَنّانِ مِن طَرفِ الأَواشِح",16,"ح",1,0],["فمدينَةٌ من بعد أُخرى تُستَبَى","وطريقَةٌ من بعدِ أُخرى تُقتَفى",17,"ف",2,0],["فمدحُك مفروضٌ وحكمُك مرتضىً","وهديُك مرغوبٌ وسخطُك مرهوب",18,"ب",1,0],["فَمَدَدتُ كَفّي ثُمَّ قُلتُ تَصَدَّقي","قالَت نَعَم بِحِجارَةٍ وَجَنادِلِ",19,"ل",1,0],["فمدّ راحته نحوي وأنشدَني","حيّ الهِدَملة من ذاتِ المواعيس",20,"س",1,0],["فمَدّتْ إلى مثْلِ السّماءِ رقابَها","وعَبّتْ قليلاً بينَ نَسْرٍ وفَرْقَدِ",21,"د",1,0],["فمدت يداً منها إليه مشيرة","وَقالَت بصوت راجف يتقطع",22,"ع",1,0],["فمُدَّ جَناحيكَ فوق الحياةِ","وأطلِقْ نشيدَك في فجرِها",23,"ر",3,0],["فمَدَّتْ ليَ الأسبابَ حتَّى بَلغْتُها","برِفْقي وقد كادَ ارْتِفاقي يَضيرُها",24,"ر",3,0],["فَمَدَّتْ بِهِ الأَعْنَاقَ تَعْطُو وَتَخْتَلِي","نِهاباً وَتُغْلي فِي النَّباتِ وَتُرْخِصُ",25,"ص",1,0],["فمدّ كفا خجولا ، وانحنى فرنا","من وجهها الموعد المجهول والصلّف",26,"ف",1,0],["فمُدّوا كفَّكَم هَوناً فهَوناً","وجُرّوا منه أنياباً شِناعا",27,"ع",2,0],["فمددت كف السول أطلب وصلها","والقلب بين مصدقٍ وموسوس",28,"س",1,0],["فمدحهم إن أتَانا فهو مدحتنا","وسبهم إن أتَانَا آخرَ الخبرِ",29,"ر",1,0],["فَمَدَّ بَنَانَهُ وَبِهِ بَنَانٌ","فَأمسَكتُ البَنَانَ مع البنان",30,"ن",1,0],["فمدّت إليهم هذه الحرب بأسها","وسدّت عليهم مهيعَ البرّ والبحرِ",31,"ر",1,0],["فَمُدَّت لَكَ الأَيدي وَلَو أَنَّها أَبَت","لَمُدَّت رِقابٌ لِلصَوارِمِ خُضَّعا",32,"ع",2,0],["فَمُدَّةُ عَصرِكَ الماضي حَميداً","تُرى ساعاً وَإِن كانَت سِنينا",33,"ن",2,0],["فَمَدحُ رَسولِ اللَهِ مِن أَوكَدِ الفَرضِ","تَوَجَّهُ بِهِ اللَه أَفضَلَ وِجهَةٍ",34,"ه",1,0],["فمد على شرق البلاد وغربها","جيوشك واملا السهل منهن والوعرا",35,"ر",2,0],["فمد على الدنيا ظلالك واطوها","بسيفك طي الطرس واستفتح المدنا",36,"ن",2,0],["فمدوا بالدعا الأيدي إليه","لدولته السعيدة بالدوام",37,"م",1,0],["فَمَدَّ يَدَيهِ من قَريبٍ وَصدرُه","بمَعبَلَةٍ مِمّا يَريشُ وَيَرصُفُ",38,"ف",1,0],["فمدحُك ما يجري به كل مَنْطق","وحبُّك ما تُحْنَى عليه لأَ اضالع",39,"ع",1,0],["فمدحتها بقصيدة وسألتُها","وصلا لتضرب هامة القياس",40,"س",1,0],["فَمديحُ الأنامِ مِن بعدِ هذا","خَبرٌ صحّ مُنتهاه اِبتداءُ",41,"ا",2,0],["فَمُدامَةٌ سِحرِيَّةٌ","تَرمي العُقولَ بِسَكرَتَينِ",42,"ن",1,0],["فَمُدَّ يداً بيضاءَ مِنك تُنيلُها","مِنَ الخير ما تَرجو وما تَتَطلَّب",43,"ب",1,0],["فمدتْ ليَ الأسبابَ حتى بلغتُها","برِفقي وقد كادَ ارتقائي يَصورُها",44,"ر",3,0],["فمَددتُ كاسي نحوَهُ ليصبَّ لي","وأعزُّ شيءٍ ما طَلبتُ إليه",45,"ي",2,0],["فمد عليهم منه ظل هداية","وأرشد منهم للهدى كل حائِر",46,"ر",1,0],["فمدح محمد شرفي وَعزى","وَجاهى في العَشائِر واِفتِخاري",47,"ر",2,0],["فَمُدَّ إلَيْهَا رافِعاً يَد قابِلٍ","أكَبَّ عَلَيها خَافِضاً فَمَ لاثِمِ",48,"م",1,0],["فمدار عمران البلاد وفخرها","وصلاحها عدل عليه تدار",49,"ر",1,0],["فَمدارُ إِحسانِ العبادةِ منهمُ","رُقبى ورُهبى مِن تجلٍّ يصدعُ",50,"ع",1,0],["فَمُديرُكُم جَمَعَ المَحاسِنِ كُلَّها","كَالبَدرِ يَمحو نورُهُ ظُلمَ الدُجا",51,"ج",2,0],["فمدَّت يداً في حُسنِ كلٍّ تناولاً","إليه وقالت ما أرى مثل ذا يُهْدى",52,"د",2,0],["فَمدحتُهُ أحكي فَواختَهُ","وكتبتُ وهيَ كأنَّها تُملي",53,"ل",2,0],["فمددتُ نحوهمهمُ يدي","فكأنها أيدي سبا",54,"ب",2,0],["فمدحه شرف للنظم ليس له","فقدره جل عن نظم يعظمه",55,"م",2,0],["فمدحٌ لم يكن فيك","فتزويرٌ وبهتان",56,"ن",1,0],["فمدارِ ظهرَيْهَا فرأْسِ سَرُوجِها","فراقُ رأْسِ سَرُوجها من مُنْيَتي",57,"ي",1,0],["فمدلي لتحيا الروح منك بنظرة","عسى أنني من نظرة أتمتّع",58,"ع",1,0],["فَمُدِيّ طرفَ ناظرةٍ تَرَيْني","تَمَكَّنَ مَغَرِسي فِيهِ وأصْلي",59,"ل",2,0],["فَمَدُّوا حبالَهُمُ طامعينَ","وأَلْقَوْا عِصِيَّهُمُ واثِقِينا",60,"ن",2,0],["فمدونا بأعتدة","وامداد كذي رحم",61,"م",1,0],["فمِدَحي عليكُمُ","دون الأنام تعكُفُ",62,"ف",1,0],["فمُ