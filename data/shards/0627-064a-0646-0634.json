{"poems":[[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[47,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[99,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[99,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[71,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[47,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[88,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[189,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[190,"أيهذا الرحل الأحنف","https://www.aldiwan.net/poem43984.html","مجزوء الرمل"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[230,"أين شكور هل العلياء","https://www.aldiwan.net/poem55118.html","مجزوء الرمل"],[295,"لا تلم أن هجرت أيام أنسى","https://www.aldiwan.net/poem11670.html","الخفيف"],[415,"لما رأوا وجدي بهم تجرموا","https://www.aldiwan.net/poem32531.html","الرجز"],[469,"ما بأراك الحمى إلى سلمه","https://www.aldiwan.net/poem3415.html","عموديه"],[469,"سفرت والليل داج فأنارا","https://www.aldiwan.net/poem3476.html","عموديه"],[556,"صد عني وأعرضا","https://www.aldiwan.net/poem47733.html","مجزوء الخفيف"],[556,"لا تطلبي مني الشباب فما","https://www.aldiwan.net/poem47858.html","أحذ الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132845","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77397","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201365","المنسرح"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205967","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111459","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83519","الخفيف"],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5213,"صنت سمعي عن عاذل فيك لاحي","https://www.poetsgate.com/ViewPoem.aspx?id=170433",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[186,"بعزمك لذ إذا عز النصير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55762&r=&rc=25",""]],"verses":[["أَيْنَ شُغْلُ الدِّيوَانِ مِمَّا أَفَادَ الشَّ","رْقَ ذَاكَ التَّحْبِيرُ وَالتَّدْوِينُ",0,"ن",1,0],["أين شأوُ البِطان لا أين منه","فات شأوُ الخِماص شأوَ البطان",1,"ن",1,0],["أَينَ شَمّاخُ وَالكُمَيتُ وَذو الرُم","مَةِ وَصّافُ مَهمَهٍ وَنَبيكِ",2,"ك",1,0],["أينَ شقاءٌ صاخبٌ في دمي","جَرَّعَني الضنكُ إلى منتهاه",3,"ا",2,0],["أين شط الرجاء","يا عُباب الهموم",4,"م",1,1],["أين شيخي وقدوتي وصديقي","وحبيبي وكلُّ ما أتمنى",5,"ن",2,0],["أين شعري وفُنوني مِنْ مدىً","لو مضَى حَسّانُ فيه أُفحِمَا",6,"م",2,0],["أين شموس الأرض أنى أفلت","وأبقت الناس على مثل الدجى",7,"ا",1,0],["أَيْنَ شَمَّاخُ والكُمَيْتُ وذُو الرُّمَّةِ","وَصَّافُ مَهْمهٍ ونَبِيكِ",8,"ك",1,0],["أين شعرٌ منكَ نَضرٌ","فَلَنَا فيه مَسِيسُ",9,"س",1,0],["أينشُدُ رُعيانُهم أن أضلّوا","بعيرا ولا أنشُد الظاعنينا",10,"ن",2,0],["أَيَنشئُ مِن تَقدُّمِنا المَعالي","فَإِن بِلَغَتْ أَيادينا تَبورُ",11,"ر",1,0],["أين شهيقُ الباكي وعَبْرتُه","إذا بدتْ من جفونِه تسبق",12,"ق",1,0],["أين شدّاد وعاد","أين قبيس وسطيح",13,"ح",1,0],["أَينَ شَمشونُ يا صَحارى يَهوذا","أَينَ حامي ضَعيفِك المُستَجيرِ",14,"ر",1,0],["أين شَكّورٌ هل العَل","ياءُ في جُبٍّ نَفَتهُ",15,"ه",1,1],["أين شم الأنوف من كل قوم","أخضعوا الخافقين أول أمس",16,"س",1,0],["أَينَ شهودُ ما أدَّعَى مِن حُبِّنا","أَينَ السّهادُ والجَوى والسّقَمُ",17,"م",1,0],["أين شموسُ الضحى إذا متع الصب","ح وتلك البدور في ظلمه",18,"م",2,0],["أين شامٌ من حجازٍ موهناً","إنَّ عيسَ الفكر يدنين المزارا",19,"ر",2,0],["أَينَ شَرخُ الشّباب قُلْ","تُ خِباءٌ تَقَوَّضا",20,"ض",2,0],["أَينَ شَبابي وَقد أنَفْتُ على ال","ستّينَ ستّاً وجُزتُها عدَدا",21,"د",2,0],["أين شقٌ وداحسٌ وضبيبٌ","غَمَزتها حوادتُ الدَّهرِ غَمزا",22,"ز",2,0],["أين شيخُ الطُّوفانِ من بعدِ يأسٍ","صَنَعَ الفُلكَ حينَ حلَّ البَلاءُ",23,"ا",2,0],["أَيَنشرُنا وَقَد صِرنا رُفاتا","وَكَيفَ يَقومُ سُكّان الرِجامِ",24,"م",1,0],["أينشىء للإِنسان خمس جوارح","تحسُّ وفيها تُدرَكُ العين والأثر",25,"ر",1,0],["أين شبابي وأين بهجته","أدعوه لكن لم يستمع صوتي",26,"ي",1,1],["أين شيطاني وأينت ربحه","كان يهفو في الدجى روحا عتيا",27,"ي",2,0],["أين شأن الزجاج من ذاك لولا","نور علم يضيء في الخافقين",28,"ن",1,0],["أَينَ شَتَّانَ أَنتَ وَالحَتفُ أَفنى","مِنكَ قَوماً وَأَنتَ بادِي الشُّجُونِ",29,"ن",1,0],["أين شداد ذي العتو الذي قد","كان عن جيشه يضيق الفضاء",30,"ا",2,0],["أَين شَأو الإِسلامُ في نَهضاتِه","أَينَ شَأنُ الإِسلامُ في ساداته",31,"ت",2,0],["\"أين \"\"شم الهوا\"\"؟ عفك كف\"","فيه خنق للروح والأرواح",32,"ح",1,0],["أين شملي أم أين مجمع انسي","فكأني قد كنت في ضحضاح",33,"ح",1,0],["أَينَ شَرُّ الحيتانِ مِن نَهَمِ الإِنسانِ","أَينَ الإِنصافُ بَينَ العِبادِ",34,"د",1,0],["أينشيء من تقدمنا المعالي","فإن بلغت أيادينا تبور",35,"ر",1,0]]}