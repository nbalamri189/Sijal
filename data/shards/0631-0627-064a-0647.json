ctabudhabi.ae/diwan/poem/133987","الخفيف"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145543","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62926","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127816","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138664",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117956","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117929","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36799","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59454","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107494","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107492","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83537","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66094","الخفيف"],[4767,"صادق","https://www.poetsgate.com/ViewPoem.aspx?id=178879",""],[4935,"وقائلة أرك مع العذارا","https://www.poetsgate.com/ViewPoem.aspx?id=129279",""],[5160,"يا شباب الجيل","https://www.poetsgate.com/ViewPoem.aspx?id=175135",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5883,"جند حماس","https://www.poetsgate.com/ViewPoem.aspx?id=23878",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[520,"أعرب اذا ما الخطب لم يعرب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577440",""],[5724,"راية المصطفى اخفقى في السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55158&r=&rc=25",""]],"verses":[["رأى هُناكَ أميرَ المُؤمنين على","حالٍ تَرُوعُ لَعَمرُ اللهِ رائيها",0,"ي",3,0],["رَأْيُهُ فِي كُلِّ مُعْضِلَةٍ","قَاطِعٌ كَالصَّارِمِ العَضْبِ",1,"ب",1,0],["رَايَةَ اليُسْرِ فِي صَفَاءِ اللَّيَالِي","رَايَةَ النَّصْرِ فِي اعْتِكَارِ الصِّدَامِ",2,"م",1,0],["رأيُهُ مصباحُ نورٍ جَليٍّ","ويداهُ للحيا الثَّرِّ بَابُ",3,"ب",1,0],["رأيه مثل سيفه قاطع عند","التلاحي ومثله مصقول",4,"ل",1,0],["راية الموت فوق هام العباد","نشرتها كتائب الآباد",5,"د",1,1],["رايَةٌ صَرَّفَها الفَردُ العَلَم","عَن وُجوهِ النَصرِ تَصريفَ النِقاب",6,"ب",1,0],["رَأْيٌ هَفَا هَفْوَةً زَلَّتْ لها قَدَمي","وما هَفا الرأيُ إلاّ زَلَّتِ القَدَمُ",7,"م",1,0],["رَأْيُ هَذَا الوَزِيرِ أَعْلَى وَفِي حَضْ","رَتِهِ شَاهِدٌ جَلِيُّ الإِيَاةِ",8,"ه",1,0],["رأيُه مِجْهَرٌ فما غابَ أمرٌ","كيفما دقَّ عن مدَى نَظَراته",9,"ت",2,0],["رأيُهُ مصباحُ نورٍ جَليٍّ","ويداهُ للحياءِ الثَّرِّ بابُ",10,"ب",1,0],["رَأى هِجرَتي في الزَمانِ البَهيمِ","وَواصَلَني في الزَمانِ الأَغَرّ",11,"ر",1,0],["رأَى هَجري وَلَم يَعلم لجهلٍ","بأَنَّ الهَجرَ عُقباهُ الزِيارَه",12,"ر",2,0],["رأى هَناتٍ فنهى","غيرَ مطاع وأمرْ",13,"ر",1,0],["رأيهُ واليراعُ في الطِّرْس فاقا","قُضُبَ الهِندِ والقنا في المضاءِ",14,"ا",2,0],["رايةٌ منصوبةٌ في رفعِها","تنصبُ الأعداءُ في كيِّ جَواها",15,"ا",3,0],["راية العز شأنها الإرتفاع","تتسامى منصورة إذ تطاع",16,"ع",1,1],["راية يقرأ المفكر فيها","ما روى مجدنا القديم المضاع",16,"ع",1,0],["رَأَيُه رَأيٌ سَديدٌ","وَلَهُ خَيرُ الفِعال",17,"ل",1,0],["رَأى هَيبَةَ اللّيثِ الهَصورِ فَهابَهُ","فَخَرَّ سُجوداً بَينَ أَيديهِ خاضِعا",18,"ع",2,0],["رأيه أعظم أَن يذ","خر إلا للعظيمِ",19,"م",1,0],["رايةٌ من ثورة الحق سناها","شعلة حمراء تسمو في علاها",20,"ه",2,0],["راية الأحرار، إناّ أمةٌ","لا تُطيق الذل يسري في حماها",20,"ه",2,0],["رأيه حكمة الإله فما قدّ","ر شيئاً إلاَّ على مقتضاها",21,"ا",3,0],["راية المكرمات قد حاز لا الصلت","حواها ولا يمينُ عرابة",22,"ب",2,0],["راية النصر نراها خفقت","ونراها ترهب الأعدا اللئام",23,"م",1,0],["راية أفراحه اجتماعاً","ليس لأحيانها طريق",24,"ق",1,0],["رايه الثاقب المسدّد أضحى","في العويصات مثل وقع السهام",25,"م",1,0],["رأيه مدرك لكل صواب","فبتدبيره النجاح يدوم",26,"م",1,0],["رأي هداه إلى التوفيق مودعه","والرأي مختلف والقول منشعب",27,"ب",1,0],["رأى هِمةً فوقَ النجوم فقاسها","بهمته اِنَّ الأُمورَ مَقايسُ",28,"س",1,0],["رأى هذي الرعيَّة دون راعٍ","وشاهد جسمَها من غير هامِ",29,"م",1,0],["رأى هناك واحدٌ اباهما","قتيل كوفان وأصحاب العبا",30,"ب",2,0],["رايةً قد قرن النصر بها","حيث ما سارت وراها النصر سارا",31,"ر",2,0],["رأيه الرأي الذي مهما شرى","برقه جلى ظلام الحلك",32,"ك",1,0],["رأيه في العذل عنها فاسد","إنما العاذل كذاب أشر",33,"ر",1,0],["راية العدل بها منصوبة","ولواء الحق فيها مستقر",33,"ر",1,0],["رَأى هَرَماها فَضلَهُ فَتَقاعَسا","وَكادا لَهُ مِن بَعدِ رامَة يَنحَطّا",34,"ط",2,0],["رَايةُ يا ذاتَ الخبا والهَودَج","ورَبةَ الطَّوقِ وذاتَ الدُّملجِ",35,"ج",1,1],["رايةَ السلمِ أم تُرى","رايةَ الحربِ والحرَب",36,"ب",1,0],["رأيهُ الشركُ ولكن هاهنا","فضلَ الأُثرةَ دون الشركه",37,"ك",2,0],["رايَة العُربِ رايَة الإِسلام","رفرفي في رُبوعِنا بِسَلامِ",38,"م",1,1],["رايةَ العُرْبِ رايةَ المَدنِيَّهْ","رايةَ المجدِ رايةَ الحُرِّيَّهْ",39,"ه",1,1],["رأيه فيما ارتضاه","من سلوكٍ رأيُ واثق",40,"ق",1,0],["رأى هذا الوجود ومن عليه","يصير إلى الفنا يا من تمارى",41,"ر",2,0],["راية الحق لنُعْلي","ننشرُ الدينَ الزكيّا",42,"ي",2,0],["راية دكت العروش على الأر","ض وشادت عرشاً لها من جديد",43,"د",1,0],["راية التوحيد إعلان صريح","وجواب عندما يسأل سائل",44,"ل",1,0],["راية الحق روينا بالدما","وبعمواس غرسنا الزيزفون",45,"ن",1,0],["رَايَةُ النُّورِ الذِي أَعْشَقُهُ","رَايَةُ «الفَاتِح ِ» أَوْ «عَبْدِ الْحَمِيدْ»",46,"د",1,0],["راية نجم الدين منصوبةً","لقومه في كرم المنصب",47,"ب",1,0],["راية المصطفى اخفقى في السماء","أنت رمز الخلود رمز العلاء",48,"ا",2,1]]}