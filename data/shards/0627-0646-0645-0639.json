{"poems":[[50,"إن مع اليوم فاعلمن غدا","https://www.aldiwan.net/poem63249.html","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[333,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[416,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[422,"نبهت للنأي عيون الرفاق","https://www.aldiwan.net/poem53892.html","السريع"],[487,"حدثني صبح دياجي الخندس","https://www.aldiwan.net/poem24431.html","عموديه"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202080","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127370","الخفيف"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126079","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118755","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117919","المجتث"],[4668,"","https://poetry.dctabudhabi.ae/diwan/poem/199420","المنسرح"],[4691,"عذبة الروح والأحاديث هند","https://www.poetsgate.com/ViewPoem.aspx?id=154941",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[6280,"لاَمَ في أُمِّ مَالِكٍ عاذِلاكَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27897&r=&rc=52",""]],"verses":[["إِنَّ مَعَ اليَومِ فَاِعلَمَنَّ غَداً","فَاِنظُر بِما يَنقَضي مَجيءُ غَدِه",0,"ه",1,1],["إنَّ مَعْنَى الْحَيَاةِ فِيهِ مِنَ الْمَوْ","تِ مَعَأنٍ لَوْ يَفْهَمُ الْمَرءُ شانهْ",1,"ن",2,0],["إنّ معنى الإبليس من جعل اليأ","س من اللَه حظّه في الأُمور",2,"ر",1,0],["إِنَّ مَعناً يَحمي الثُغورَ وَيُعطي","مالَهُ في العُلا تَقومُهُ قَدَماكا",3,"ك",2,0],["إِنَّ مَعناً كَما كَساهُ أَبوهُ","عِزَّةَ السابِقِ الجَوادِ كَساكا",3,"ك",2,0],["إنَّ معاصاة الكرى للعلى","أَلذَّ من طوع الهوى للعناق",4,"ق",1,0],["أن معنى الحسن لم يودع لمن","لم يصل صلصلة من جرس",5,"س",1,0],["إنَّ معنى الهُيامُ بالأَولِياءِ","لهُيامٌ بخالقِ الأَشياءِ",6,"ا",2,1],["إنَّ معناها ما صَبت أنفسٌ منا","إلَيهِ ولم يَعُد أَوهاما",7,"م",2,0],["إن معنى مواقع الأَنْجُم الزُّهرِ","هُمُ العِتْرَةُ الهُداةُ الكرَام",8,"م",1,0],["إن معنى الحياة قول وفعل","وهي رمز مقدس للجهاد",9,"د",1,0],["ان معمع الرعد فيه قلت منخرق","او لألأ البرق فيه قلت يحترق",10,"ق",1,0],["إن مع العسر على شؤمه","يُسُراً وعنه أنسنا ينجم",11,"م",1,0],["إن مع العسر يسراً","إن مع العسر يسرا",12,"ر",2,0],["إن معاذ بن مسلم رجل","ليس لميقات عمره أمد",13,"د",1,1],["إنّ معنى القصيد ِفي لفتاتٍ","من غزال ٍ دلالُهُ يستبدُّ",14,"د",1,0],["إن معنى حياتنا من معانٍ","عسر فهمها على الشراح",15,"ح",1,0],["إنَّ مَعْناً يَحْمي الثُّغُورَ ويُعْطي","رِ وعَبْدِ الإلهِ كُلٌّ نَمَاكَا",16,"ك",2,0],["إنَّ مَعْنَاً كما كَسَاهُ أبُوهُ","عزة السابق الجواد إياكا",16,"ك",2,0]]}