لرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[4699,"عذبة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=154301",""],[4764,"ما يهمنّي تكدر ولا يهمنّي ازعله","https://www.poetsgate.com/ViewPoem.aspx?id=37125",""],[4813,"جسدي واه ودمعي مرسل","https://www.poetsgate.com/ViewPoem.aspx?id=133403",""],[4916,"ياعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=135388",""],[5135,"يا عذولي","https://www.poetsgate.com/ViewPoem.aspx?id=202020",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5376,"يا جلق المجد والعلياء من زمن","https://www.poetsgate.com/ViewPoem.aspx?id=188535",""],[5431,"يالقلبي واأساه ...","https://www.poetsgate.com/ViewPoem.aspx?id=191671",""],[5470,"عنوَانُهَا أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=12170",""],[5525,"الروح الجريحة","https://www.poetsgate.com/ViewPoem.aspx?id=922",""],[482,"بسوى قربِكَ لا يُشْفَى الغليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5626,"أفصحي","https://www.poetsgate.com/ViewPoem.aspx?id=189717",""],[5674,"روائع ساحره","https://www.poetsgate.com/ViewPoem.aspx?id=197551",""],[5690,"سر أريحَّ الشمال سرْ بسلام","https://www.poetsgate.com/ViewPoem.aspx?id=172187",""],[5725,"شعر كالليل","https://www.poetsgate.com/ViewPoem.aspx?id=177518",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5747,"براق العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61663",""],[5781,"أُمُّ الشَّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=198835",""],[5853,"((أنتِ الخلود ))","https://www.poetsgate.com/ViewPoem.aspx?id=175663",""],[5853,"شموخ","https://www.poetsgate.com/ViewPoem.aspx?id=175689",""],[5877,"يا وجودي ..","https://www.poetsgate.com/ViewPoem.aspx?id=37475",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[5956,"فَرْقُ العمر فرّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=182148",""],[5970,"داء بقلبي وداء القلب يضنيه","https://www.poetsgate.com/ViewPoem.aspx?id=130644",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6056,"لمسة حنان","https://www.poetsgate.com/ViewPoem.aspx?id=130348",""],[6082,"عبير","https://www.poetsgate.com/ViewPoem.aspx?id=58838",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[5001,"ياعذبة الريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80712&r=&rc=2",""]],"verses":[["يا عَذولَيَّ قَد غَضَضتُ جِماحي","فَاِذهَبا حَيثُ شِئتُما بِزِمامي",0,"م",2,1],["يا عَذبَةَ المَبسِمِ بُلّي الجَوى","بِنَهلَةٍ مِن ريقِكِ الصارِدِ",1,"د",1,0],["يا عَذولي إليْكَ عنّي فإنّي","لسْتُ بالنُّصْحِ منْكَ بالمُحْتاجِ",2,"ج",1,0],["يا عذولي خلني أغنم عمري","إن أعمار الورى كالسحب تسري",3,"ر",2,1],["يا عذار المليح دعني فإني","لست في ذا الزمان من خل بقلك",4,"ك",1,0],["يا عذاب المجتديه","وغرور المتعفف",5,"ف",1,0],["يا عَذارى الجمال والحُبِّ والأحلامِ","بَلْ يا بَهاءَ هذا الوُجودِ",6,"د",1,1],["يا عذارى الحسن في ظل الصبا","كل حسن بعد ليلاي دميم",7,"م",1,0],["يا عذبة العينين والمبسم","وغضة الحسن الشهي الفريد",8,"د",1,0],["يا عَذارى الكَلامِ صِرتُنَّ مِن بَع","دي سَبايا تُبَعنَ في الأَعرابِ",9,"ب",1,0],["يا عذَّلي أنتمْ عدى","وللملمّاتِ عددْ",10,"د",1,0],["يا عذارى القبيل أنتنَّ للْ","مَجدِ على عِفَّةٍ صواحبُ بَذْلِ",11,"ل",1,0],["يا عُذولي إليك عني فإني","لست للنُّصح منك بالمُحتاج",12,"ج",1,0],["يا عَذبَةَ الرُوح يا فتّانَة الجَسدِ","يا بنتَ \" بيروتَ \" يا أنشودةَ البَلدِ",13,"د",1,1],["يا عذبة الثغر .. لو طاف الخيال به","قرأت في وجهك الإشفاق والغضبا",14,"ب",2,0],["يا عذب الله قلبي كم أجاذبه","إلى النجاة ويدعوني إلى العطب",15,"ب",1,0],["يا عذولي عليهِ جَهْلاً اتَسْتح","سِنُ عَدْلَ الهَوِىِّ في قَمَرَيْهِ",16,"ي",2,0],["يا عَذبةَ الوَصْلِ والصدودِ ويا","أَعْبَقَ ثَغْراً مِن ابنةِ الدَّنِّ",17,"ن",1,1],["يا عذابَ الصَّدِّ والهج","ر ويا ثِقْلَ الغَرامة",18,"م",2,0],["يا عَذْبَةَ الرشفِ هل لمكتئبٍ","صبٍّ سبيلٌ لفوز لقياكِ",19,"ك",1,1],["يا عذولَ المحبِّ قَصِّر من العَذ","لِ فإني أراه مما يَزيدُه",20,"د",2,0],["يا عذولي دعني من العَذلِ إن النُّ","صحَ في مذهب الهوى تحريضُ",21,"ض",1,0],["يا عَذولي فيمَن يَقومُ بِعُذري","كُلَّما لاحَ لِلعُيونِ عِذارُه",22,"ر",2,0],["يا عذولي أَسرفتَ في عَذلي","كفَّ عنّي فَما جرى يكفيك",23,"ك",1,0],["يا عذولي إذا بدا وتثنى","لا تقل لي غير الصحيح اليقين",24,"ن",1,1],["يا عذيب اللفظ والشنب","أنت ما ترثي لمكتئب",25,"ب",1,0],["يا عَذولي كُفَّ عَن عَذَلي","لَيسَ لي بِالعَذلِ إيثارُ",26,"ر",1,0],["يا عَذولي دَعني فَلَيسَ بِجِسمي","مَوضِع قابِل الحُبّ سَواه",27,"ا",2,0],["يا عَذولِيَّ عَلَيهِ","رُمتُما مِنّي سَفاها",28,"ا",3,0],["يا عذولي في الحُبّ دعني فإنّي","فيه راضٍ بذلِّتي وهواني",29,"ن",2,0],["يا عذُولي إليكَ عنّي فما أن","تَ كما تدَّعِي الصَديقُ الصَّدُوقُ",30,"ق",1,0],["يا عَذولاً يَظُنُّ أنَّ صلاحي","في سُلُوِّي وذاك عينُ فَسادي",31,"د",2,0],["يا عذولي لو أن قلبك يدري","من غرامي دقيقة لرثالي",32,"ل",2,0],["يا عَذولي إليكَ عنّي فإنّي","قلّ ما استحوذَتْ عليّ الملامَهْ",33,"م",2,0],["يا عذولي مهلا فأين محبّ","مذنف ذو صبابة والملام",34,"م",1,0],["يا عذولي خل عنيّ وأعد","منعماً اخبار نجد يا سميري",35,"ر",2,0],["يا عذولي أن سفَّ","جفنيَّ دمعي وسهده",36,"د",2,0],["يا عذَّبَ اللهُ قلبي كم أجاذبهُ","إلى النجاةِ ويعدوها إلى العطب",37,"ب",1,0],["يا عَذولي إِن كُنتَ تَرجو سُلُوّي","فَالَّذي تَرتَجيهِ نَفسُ المُحالِ",38,"ل",1,1],["يا عَذولي في اِكتِئابي","أَلهوى عَذبُ العَذابِ",39,"ب",1,1],["يا عذولاً لامني سفهاً","أنا لا أصغي إلى العَذَل",40,"ل",1,0],["يا عذولي كُفَّ عن عذلي","إن هذا اللوم محضُ شقا",41,"ق",2,0],["يا عَذولي مَهلاً فَدَمعيَ قَد با","حَ بِما قَد أَخفَيتُ مِن أَسراري",42,"ي",1,1],["يا عَذُولي عَلى تَجَنِّيهِ مَهْلا","لا تَلُمْني فَقَدْ بَدا العُذْرُ مَهْ لا",43,"ل",2,0],["يا عَذُولي عَلى الغَرامِ ومَنْ لي","بِفؤادٍ حتَّى يَكونَ الغَرامُ",44,"م",1,0],["يا عَذولي زَعَمتَ صَبري صَواباً","وَطَريقَ الصَوابِ غَيرَ مُخيلِ",45,"ل",1,0],["يا عَذولاً لامني","خَلِّ عَن هَذا المَلام",46,"م",1,0],["يا عَذولي دَعِ المَلامَةَ وَاِعذُر","إِنَّ عُذرَ المُحبِّ شَأنُ الرؤوفِ",47,"ف",1,0],["يا عَذولي لا تَلُمني في الهَوى","إِنّ لَومي في الهَوى وَاللَّه قُبحُ",48,"ح",1,0],["يا عَذولي كُفَّ لَومي وَاِتّئِدْ","أَنتَ غَمْرٌ لَم تَذُق طَعمَ الغَرامْ",49,"م",1,0],["يا عَذولي عَلى الهَوى لا تَلُمني","إِنَّ لَومي عَلى الهَوى يُؤذيني",50,"ن",2,0],["يا عَذولي كَيفَ تَلحو أَبكماً","ذا عَمىً مَع صَممٍ مع خرسِ",51,"س",1,0],["يا عَذولي كُفَّ عن عَذَلِي","إنَّ قلبي عنك في شُغُل",52,"ل",1,1],["يا عذوليَّ قصِّرا العذلَ عني","خلِّياني أمدحْ خيارَ العبادِ",53,"د",1,1],["يا عَذُولاً حُسنُ صَبرِي غَرَّهُ","في حَبيبٍ لَستُ أُفشِي سِرَّهُ",54,"ه",1,0],["يا عذولي وهل يبل غليل","من جوى الحب أو يبل عليلُ",55,"ل",1,0],["يا عذولي خل عذل شج","دمعه في السفح منفسحُ",56,"ح",1,0],["يا عذاب الثغور رفقا بصب","سمتموه حمل العذاب المذابِ",57,"ب",1,0],["يَا عَذُولاً أطَالَ شَرْحَ عِتَابِي","أقْصِرِ العَذْلَ فَهْوَ غَيْرُ حَمِيدِ",58,"د",1,0],["يا عذولي في الحب لست رشيدا","لا ولا العذل في الهوى بالهادي",59,"د",2,0],["يا عذولي ما رأيت في الحب جهلا","وأرى حاكم الهوى لا يمارى",60,"ر",2,0],["يَا عُذَّلِي فِيهِ كُفُّوا عَنْ ملاَمكمُ","فَلَيْسَ لوْمكمُ في حُبِّهِ دِينِي",61,"ن",2,0],["يا عَذولي في اِتّباعي للهوى","وَخُضوعي واِنقِيادي في الودادِ",62,"د",1,0],["يا عذَّلي في حبِّه ما الفكر في","عينٍ مسهّدةٍ وقلب والهِ",63,"ل",2,0],["ياعذ يرى من العذارى دعتني","عمّها قد سمعت شيئا عجيبا",64,"ب",2,0],["يا عذب كوثر جودٍ","إليه تنحو العبادُ",65,"د",1,0],["يا عذولي كف الملامة واقصر","والهو عني وخلني وشجوني",66,"ن",2,0],["يا عذولي إليك عني فإني","منك أدرى بوجهِ ضُرّي ونفعي",67,"ع",2,0],["يا عَذولى فى حُبِّهِ كُفَّ عَذلى","أنا ما للعَذُولِ فيه ومالى",68,"ل",2,0],["يا عذوليَ صبابتي علّماني","كيف تسلي الهموم لا كيف تسلى",69,"ل",2,0],["يا عذولا جد فى عذلى","لا تلم في حبه غزلى",70,"ل",2,1],["يا عذولي تشمتنَّ بهجري","فعسى ان يعود ما كان قبل",71,"ل",1,0],["يا عذولي على تصابيَّ دعني","والتصابي ان التصابي شعاري",72,"ر",2,0],["يا عذولي إليك لو كنت تدرى","ما بقلبي أو ليتني منك عذرا",73,"ر",2,0],["يَا عَذُولِي لاَ يَضَعُ وَقْتُكَ فِي","مَا تُعَانِي إننِي فِي شُغُلِ",74,"ل",1,0],["يا عذولي على غرامٍ مَليحٍ","كامل الظرف من حسان الجِنانِ",75,"ن",1,0],["يا عذَّب الله قلبي كم يُجِنُّ هوى","يجني عليه ويرعى من يُرَوِّعُه",76,"ع",2,0],["يا عَذارى الوَحيِ مِن فِردَوسِها","لِسماءِ النيلِ تَهتَزُّ اِنزِلي",77,"ل",2,0],["يا عذولي كرر ملامك حتى","يتسلى بذكره مفتونه",78,"ن",2,0],["يا عذولُ تقولُ يزولُ","نحول ضنى أعظمي الرِّمَمِ",79,"م",1,0],["يا عَذِلي قَد كُنتُ قَبلَكَ عاذِلاً","حَتّى اِبتُليتُ فَصِرتُ صَبّاً ذاهِلا",80,"ل",2,1],["يا عَذولي على الصبابةِ فيه","كفَّ عَذلي عن طَرفهِ الوَسنانِ",81,"ن",1,0],["يا عذولي في مغن مطرب","حرك الأوتار لما سفرا",82,"ر",2,1],["يا عذولي دعني ووجدي عليه","واكفف العذل والملامة عنا",83,"ن",2,0],["يا عذولاً في شأن دمعي عليه","عد عما جرى ودعني وشأني",84,"ن",2,0],["يا عذولي باللَه دعني ووجدي","عل في حبها لقلبي نجحا",85,"ح",2,0],["يا عذولا لم تذق أفكاره","من أليم الوجد لي ما ذوقا",86,"ق",2,0],["يا عذبة الريق بجنب الحمى","تمزج لي الريق بجريالها",87,"ل",3,0],["يا عذولي لا تلمني في هوى","رشأ حارت عقول الناس فيه",88,"ه",1,1],["يا عذبة المبسمِ بلّي الجوى","بنهلة فَهيَ الشفا والدوا",89,"و",2,1],["يا عذولي لمتماً أريحيا","بهوى الغيد يحسب الرشد غيا",90,"ي",2,0],["يا عذولي خوزْ عَنْ قربي","خوزْ عَنْ بلْواي تِبْلَى بْها",91,"ب",3,0],["يا عَذولي دعِ الملامَ وَدعني","ما الَّذي تَستَفيدُهُ من ملامي",92,"م",2,0],["يَا عُذرَ دَهرِيَ مِن مَاضِي إسَاءَتِهِ","وَمِن تَسَاوِي وَلِيِّي فِيهِ وَالشَّانِي",93,"ن",2,0],["يا عَذولي دَعني فَلَيسَت ذُنوبي","لَكَ تَعزى حاشاكَ مِمّا اِعتَدَيتُ",94,"ت",1,0],["يا عذبة الريقة ما","انصفت صباً مغرما",95,"م",2,0],["يا عذوليَّ إن تروعا فؤادي","ببعاد الحبيب عني فروعا",96,"ع",2,0],["يا عذولي لا تلمني","إن لي في الحُبِّ داعِ",97,"ع",1,1],["يا عذيب الشنب","من لا يحبك تعذب",98,"ب",1,0],["يا عَذولي وَلَستُ أَصغي لِعَذلِ","خَلِّني وَإِلّا",99,"ل",2,0],["يا عَذولي لا تَلُم","هَكَذا خَطَّ القَلَم",100,"م",1,0],["يا عذولي لا تلمني في حَزن","ليس ينسينيهِ موتي والكَفَن",101,"ن",1,0],["يا عذولي لا تلمني في ولا","ملكِ روحي ووحيدي في الملا",101,"ل",2,0],["يا عذولي دَع ملامي واعذُرِ","قلب عانٍ بالنوى لم يَصبِر",101,"ر",1,0],["يا عَذولي لَيسَ بالأشعار عار","كَم جَلى الشِعرُ من البلبال بال",102,"ل",1,0],["يا عَذولي في حبِّه ومتى تر","جُو صَلاحاً من مثلهِ العُذَّالُ",103,"ل",1,0],["يا عَذابي وما ألذَّ ندائي","إي وعينيكَ والثنَايا العِذاب",104,"ب",1,0],["يا عُذرُ زُيِّنَ بِاِسمِكَ العُذرُ","وَأَساءَ وَلَم يُحسِن بِكَ الدَّهرُ",105,"ر",1,1],["يا عذولي فنيَ الصب","رُ إلى كم وإلى ما",106,"م",2,0],["يا عذولي لا تُلمني","فيه ان بحتُ غراما",107,"م",2,0],["يا عذولي كرر علي السمع واملي","من أمالي القالي صحائف عذلي",108,"ي",1,1],["يا عذولا في الهوى دع فتيةً","تندبُ الأيامَ أيامَ صباها",109,"ا",3,0],["يا عَذبَةَ الماءِ وَالظِلِّ اِنعَمي طَفَلاً","حُيّيتِ مُمسِيَةً مَيّادَةَ القُضُبِ",110,"ب",1,0],["يا عذبةَ الأشواق قلبي مفعمٌ","باعشق يستجدي رضى عيناكِ",111,"ك",1,1],["يا عذابي الي هويته ما قوى قلبي الصمود","بعد ما حبل الموده كم يفله ويفتله",112,"ل",2,0],["يا عذولي في الهوى لي مذهب","فانفصل عني وخذ في مذهبك",113,"ك",1,0],["ياعذابي ... كيف انا يرتاح بالي ؟!",".سامح الله .. كل نبض ..وكل بوح",114,"ح",1,0],["يا عذولي لا تَلُمْني","‏إنه وقتُ الظَهِيْرَةْ",115,"ر",2,1],["يا عذبةَ الرّيقِ لولا أنني رجلٌ","من أورَ ما متُّ في لاهاي أشواقا",116,"ق",2,0],["يا عذبة الريق كالأنفاس في جسدي","كأنني بك قد القيت أحمالا",117,"ل",2,0],["ياعذابا لست أشكو","ياانتشاء في حلاه",118,"ا",2,0],["يَاعَذبةَ الرُّوحِ في عَينَيكِ إبحَارِي","نَوَارِسُ القَلبِ تَهوَى سِحرَهَا الضَّارِي",119,"ر",2,1],["يا عذولي .. وش تفيد به النصيحه","لا تعذل القلب .. وجروحه طريّه",120,"ي",2,1],["يا عذولي وعجيبٌ في الهوى","أنْ يُنادَى في الملماتِ العذولُ",121,"ل",1,0],["يا عذْبةَ الصوتِ يا لحناً نردّده","يا خمرةً بهدوءِ الليلِ نحسيها",122,"ي",3,0],["يا عذبة الألحان يا نبضي أنا","من أول التكوين حتى الآخره",123,"ر",2,0],["يا عذولي دع عنك لومي ودعني","لا أرى اللوم غير ضرب الحسامِ",124,"م",1,0],["ياعذب الشعر ببحر هوى","جذلى تتغازل أضربهُ",125,"ب",2,0],["ياعذبة الروحِ حتّى الآنٓ يجْذبني","منْكِ ابتهالات تأتيني بمبتهلي",126,"ل",2,0],["ياعذابي يوم صدك بي سطا","ماكفاك اني على وصلك بقيت",127,"ت",1,0],["يا عَذْبَةَ الوَجَعِ المَنْطوقِ نَهْنَهَها","هشُّ العُروقِ وَقَدْ ضاقَتْ مَسارِبُهُ",128,"ب",2,0],["يا