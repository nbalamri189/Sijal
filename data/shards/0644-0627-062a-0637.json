{"poems":[[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[53,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem29822.html","البسيط"],[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[55,"يا أبا الفضل هيجتك الرسوم","https://www.aldiwan.net/poem26139.html","الخفيف"],[86,"ماذا أصبت من الأسفار والنصب","https://www.aldiwan.net/poem10508.html","البسيط"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"لك في ارتجال جلائل الهمم","https://www.aldiwan.net/poem11336.html","أحذ الكامل"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[27,"ما ينسني الدهر لا يبرح لنا شجنا","https://www.aldiwan.net/poem5933.html","البسيط"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[11,"ولقد بغى بجلاد أوس قومه","https://www.aldiwan.net/poem256.html",""],[47,"لا تطلبن دنو دار","https://www.aldiwan.net/poem25256.html","مجزوء الكامل"],[72,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"يا وهب يا صاحب البريد ألا تكتب","https://www.aldiwan.net/poem9231.html","المنسرح"],[51,"وقائل كيف تهجو","https://www.aldiwan.net/poem61920.html","المجتث"],[51,"ذلي لزهوك أرض","https://www.aldiwan.net/poem64957.html","المجتث"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أيها السيد الجليل أدام الله","https://www.aldiwan.net/poem65813.html","الخفيف"],[51,"الخير مصنوع بصانعه","https://www.aldiwan.net/poem65816.html","أحذ الكامل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لا تصنعن صنيعة مبتورة","https://www.aldiwan.net/poem66069.html","الكامل"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"كم قبل هذا الجل ولى جيل","https://www.aldiwan.net/poem9063.html","عموديه"],[91,"كن بلسما إن صار دهرك أرقما","https://www.aldiwan.net/poem62736.html","عموديه"],[70,"ومهفهف كالغصن في حركاته","https://www.aldiwan.net/poem42969.html","الكامل"],[70,"لاتطرح خامل الرجال فقد","https://www.aldiwan.net/poem42987.html","المنسرح"],[70,"قل للألى جعلوا الدستور مهزلة","https://www.aldiwan.net/poem43046.html","البسيط"],[85,"العلم والبر هذا مهرجانهما","https://www.aldiwan.net/poem7124.html","البسيط"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[62,"لا تطمحن إلى المراتب قبل أن","https://www.aldiwan.net/poem52485.html","الكامل"],[45,"ترى زعيم الجبال منقينا","https://www.aldiwan.net/poem62646.html","المنسرح"],[45,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[28,"إن التي نظرت إليك بفادر","https://www.aldiwan.net/poem5215.html","الكامل"],[58,"لا تطلبن معيشة بمذلة","https://www.aldiwan.net/poem31132.html","الكامل"],[58,"لا تطلبن معيشة بمذلة واربأ","https://www.aldiwan.net/poem31182.html","الكامل"],[66,"قلت للكلبتين إذ عجزت عن","https://www.aldiwan.net/poem38598.html","الخفيف"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[69,"إن جزت سلعا فسل عن","https://www.aldiwan.net/poem28795.html","المجتث"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[31,"عاود القلب بعض ما قد شجاه","https://www.aldiwan.net/poem41263.html","الخفيف"],[31,"حدثيني وأنت غير كذوب","https://www.aldiwan.net/poem42033.html","الخفيف"],[31,"كتبت تعتب الرباب وقالت","https://www.aldiwan.net/poem42531.html","الخفيف"],[31,"شاق قلبي تذكر الأحباب","https://www.aldiwan.net/poem42632.html","الخفيف"],[105,"يا قوم ما ذنب الرئيس","https://www.aldiwan.net/poem42136.html","مجزوء الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[81,"أرسل اللحظ للقتال نذيرا","https://www.aldiwan.net/poem61361.html","الخفيف"],[81,"لا تطلبوا ثأري فلا حق لي","https://www.aldiwan.net/poem61502.html","السريع"],[40,"يا عين مهلا ألم تنهى عن النظر","https://www.aldiwan.net/poem42295.html","البسيط"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[67,"يا أيها السيد الذي شهدت","https://www.aldiwan.net/poem18094.html","المنسرح"],[48,"ترك الصبوح علامة الإدبار","https://www.aldiwan.net/poem63306.html","الكامل"],[48,"لا تبك للذاهبين في الظعن","https://www.aldiwan.net/poem65299.html","المنسرح"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[46,"لا تطيعي هواك أيتها النف","https://www.aldiwan.net/poem22141.html","الخفيف"],[46,"لا خير في المال أعطاه وأجمعه","https://www.aldiwan.net/poem22149.html","البسيط"],[46,"إن شربوا الراح فما شربنا","https://www.aldiwan.net/poem22420.html","السريع"],[46,"لا تطلب الغرض البعيد وتسهر","https://www.aldiwan.net/poem22697.html","الكامل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85671","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85344","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147556","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[95,"النسر","https://www.poetsgate.com/ViewPoem.aspx?id=706",""],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[70,"وَمُهَفهَفٍ كَالغُصنِ في حَرَكاتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=116362",""],[46,"إنْ شرِبوا الرّاحَ، فما شُرْبُنا،","https://www.poetsgate.com/ViewPoem.aspx?id=18523",""],[31,"شاقَ قلبي تذكرُ الأحبابِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18771&r=&rc=34",""]],"verses":[["لا تَطلُبِ الغايَةَ القُصوى فَتُحرَمَها","فَإِنَّ بَعضَ طِلابِ الرِبحِ خُسرانُ",0,"ن",1,0],["لا تَطلُبَنَّ لِيَ الأَبدالَ بَعدَهُمُ","فَإِنَّ قَلبِيَ لا يَرضى بِغَيرِهِمِ",1,"م",1,0],["لا تَطلُبي يانَفسِ خِلّاً بَعدَهُ","فَلَمِثلُهُ أَعيا عَلى المُرتادِ",2,"د",1,0],["لا تَطْلُبوهُ فشَرُّ ما لَقيَ امْرُؤٌ","في السَّعْي خَيْبَةُ طالِبٍ مَكْدودِ",3,"د",1,0],["لا تُطيقُ الجِبالُ يا مَعشَرَ النا","سِ مِنَ الحُبِّ ما تُطيقُ الجُسومُ",4,"م",1,0],["لا تُطعِمانِيَ أَنيابَ المَلامِ عَلى","هَذا العِثارِ فَإِنّي مَهبِطُ العَجَبِ",5,"ب",1,0],["لا تَطهُرُ الأَرضَ مِن رِجسٍ وَمِن دَرَنٍ","حَتّى يُعاوِدَها نوحٌ بِطوفانِ",6,"ن",1,0],["لا تَطْرُقُ الإصْلاحَ عَنْ عَرَضٍ","بَلْ تَطْرُقُ الإصْلاحَ مِنْ أَمَمِ",7,"م",1,0],["لا تَطلُبنّ من الزمان حقيقةً","ما للحقيقة في الزمان وميض",8,"ض",1,0],["لا تَطلُعُ الشَمسُ إِلّا وَهوَ في تَعَبٍ","وَلا تَغَيَّبُ إِلّا وَهوَ مَسبوقُ",9,"ق",1,0],["لا تَطلُبَنَّ خُؤولَةً في تَغلِبٍ","فَالزَنجُ أَكرَمُ مِنهُمُ أَخوالا",10,"ل",2,0],["لا تَطعَمَنَّ الماءَ إِن أَورَدتَهُم","لِتَمامِ طَميِكُمُ فَفوزوا وَاِحبُسوا",11,"س",3,0],["لا تَطلُبَنَّ دُنُوَّ دار","من حَبيبٍ أَو مُعاشِر",12,"ر",1,1],["لا تطلبنَّ من القرائح حصرَ ما","أفضى إليه وَعدِّ عن إعناتِها",13,"ت",3,0],["لا تطلبنَّ من الأيَّامِ مشبهَهُ","ففي طِلابك للأيَّامِ إعنات",14,"ت",1,0],["لا تَطاوَلْ بحسنِ وجهِك والدو","لةِ واذكر من شانِئيك الفناءَ",15,"ا",2,0],["لا تُطعمنَّا لحمك المتَّقَى","فليس مما يأكل الساغبُ",16,"ب",1,0],["لا تَطأُ الأسدُ ما حماهُ ولا","تلقاهُ إلا مُوَطَّأً عَقِبُهْ",17,"ب",2,0],["لا تُطِلْ رهبتي بإرجاءِ أمري","فكفاني فراقُك المرهوبُ",18,"ب",1,0],["لا تطوِ عنه الحديثَ مُحتشِماً","فالاستُ في الحين تنطق الرفثا",19,"ث",2,0],["لا تُطْمِعَنْ فيَّ عَمْراً","فإنه ليَ ضِدُّ",20,"د",1,0],["لا تُطمِعَنَّ حليماً","في زُبدةِ الماءِ مخْضُ",21,"ض",1,0],["لا تطفئنَّ جوى بلوم إنه","كالريح تغري النار بالإحراق",22,"ق",1,0],["لا تُطاوِلْ بأنْ حباك وأن زا","دك لا أحسن الإلهُ مزيدَك",23,"ك",1,0],["لا تُطمِعَنَّك فيه رأفتُهُ","إنَّ المطامع تنصِبُ الشَّبَكا",24,"ك",2,0],["لا تُطلُّ الدماءُ إن طلبوها","وعطايا أكُفّهم مطلولهْ",25,"ل",2,0],["لا تطَّرحني فإني غير مطَّرحٍ","ولا تُذِلْني فإني العِلقُ لم يُذلِ",26,"ل",1,0],["لا تطالبهُ بالثوابِ فما ردْ","دُ ثوابٍ من مثلهِ بحلالِ",27,"ل",1,0],["لا تطعمنَّهمُ وتقطعَ طعمةً","أشبِعْ إذا أطعمْتَ أولا تُطْعمِ",28,"م",1,0],["لا تطيلوا المقام عن جنَّة الخل","دِ فأنتمْ في غير دار مُقام",29,"م",1,0],["لا تُطَيِّرْ وَسناً عن مُقْلةٍ","أنت أهديتَ لها حُلْو الوَسَن",30,"ن",1,0],["لا تَطيقُ الأَرضُ تَخفي شَوكَها أَو زَهرَها","لا تَسَل أَيَّهُما أَشهى وَأَبهى لَستُ أَدري",31,"ي",1,0],["لا تَطلُبَنَّ مِنَ السِياسَةِ رَحمَةً","هِيَ حَيثُ طُلَّ دَم وَحَلَّ دَمارُ",32,"ر",1,0],["لا تَطلُبوا بِالمُرهَفاتِ ذُحولُكُم","في نَيلِها بِالمُرهَفاتِ ذُحولُ",33,"ل",1,0],["لا تَطلِبَنَّ مَحَبَّةً مِن جاهِلٍ","المَرءُ لَيسَ يُحَبُّ حَتّى يُفهَما",34,"م",2,0],["لا تَطلُبَن هَيهاتِ مِنهُ صَلاحَهُ","إِن كانَ رَبُّكَ قَد قَضى بِفسادِهِ",35,"د",2,0],["لاتَطَّرِح خامِل الرِجالِ فَقَد","تَحتاجُ يَوماً إِلى كِفايَتِهِ",36,"ه",1,1],["لا تطمعوا أن يُعزَّ اللهُ دَولتَكم","وإنْ تجاوزَ أدنى شأوِها الشُّهُبا",37,"ب",2,0],["لا تُطر حيا ولا ميتا وإن كرما","حتى ترى لهما بالخلق إحسانا",38,"ن",2,0],["لا تَطلُبوا حَقَّكُم بَغياً وَلا ضَلَفاً","ما أَبعَدَ الحَقَّ عَن باغٍ وَمُختالِ",39,"ل",1,0],["لا تَطلُبَنَّ كَريماً بَعدَ رُؤيَتِهِ","إِنَّ الكِرامَ بِأَسخاهُم يَداً خُتِموا",40,"م",3,0],["لا تَطْمحنَّ إِلى المراتب قبلَ أنْ","تتكاملَ الأدواتُ والأسبابُ",41,"ب",1,1],["لا تَطلُبِ القُبحَ في سَريرَتِهِ","وَاُنظُر إِلى القُبحِ في عَلانِيَتِه",42,"ت",2,0],["لا تَطلُبَنَّ لَهُ الشَبيهَ فَإِنَّهُ","قَمَرُ التَأَمُّلِ مُزنَةُ التَأميلِ",43,"ل",1,0],["لا تَطلُبي بي غَيرَهُ مِمَّن مَشى","إِن أَنتِ ناقَ لَقيتِهِ بِالقَرقَرِ",44,"ر",1,0],["لا تَطلُبَنَّ مَعيشَةً بِمَذَلَّةٍ","وَاِرفَع بِنَفسِكَ عَن دَنِيِّ المَطلَبِ",45,"ب",1,1],["لا تَطلُبَّنَ مَعيشَةً بِمَذَلَةٍ","وَاِربَأ بِنَفسِكَ عَن دَنِيِّ المُطلَبِ",46,"ب",1,1],["لا تُطيقُ الكِلابُ تَنزِعُ عِظماً","موثَقَ السُمرِ في قَرارِ كَنيفِ",47,"ف",1,0],["لا تُطمِعَنَّ ذَوي الفَسادِ بِتَركِهِم","فَالنَذلُ تَطغى نَفسُهُ إِذ تُكرَمُ",48,"م",1,0],["لا تُطْمِعِ الأنضاءَ في راحةٍ","وإن وصلنا بغدوٍّ رواح",49,"ح",1,0],["لا تَطلُبنَّ الرِزقَ بَعدَ شِماسِهِ","فَتَروضَهُ سَبُعاً إِذا ما غَيَّضا",50,"ض",2,0],["لا تطلبوا عنهُ صبري","فالصبرُ أوهى وأوهنْ",51,"ن",1,0],["لا تطلبوا لحسنِهِ مضاهي","اللّهَ اللّهَ عبادَ اللَّهِ",52,"ه",1,0],["لا تُطِع بي فَدَتكَ نَفسي عَدوّاً","لِحَديثٍ عَلى هَواهُ اِفتَراهُ",53,"ا",2,0],["لا تُطِع بي مَن لَو رَآني وَإِيّا","كَ أَسيرَي ضَرورَةٍ ما عَناهُ",53,"ا",2,0],["لا تُطيعي الوشاةَ فيما أَرادوا","يا ثُرَيّا وَلا الَّذي يَنهاكِ",54,"ك",1,0],["لا تُطيعي فَإِنَّني لَم أُطِعهُ","أَنتِ أَهوى الأَحبابِ وَالأَجوارِ",55,"ر",1,0],["لا تُطِع في قَطيعَةِ اِبنَةِ بِشرٍ","ماجِدَ الخيمِ طاهِرِ الأَثوابِ",56,"ب",1,0],["لا تطمعوا في شعبِ مص","رَ فليس بالشّعبِ الجَهولْ",57,"ل",1,0],["لا تطِعْ صَفوانَ وانبذ رأيه","لا تُطِعْهُ مُرشداً يأبى الرَشَدْ",58,"د",1,0],["لاَ تُطع من عَوَاذِلِ وَوُشَاةٍ","آثِماً فِي مَلاَمِهِ أو كَفُورَا",59,"ر",2,0],["لا تَطلُبوا ثَأري فَلا حَقَّ لي","عَلى لِحاظِ الرِئمِ مِن مَقتَلِ",60,"ل",1,1],["لا تَطرَحِي القَلبَ عَيني في مُهَوَّلَةٍ","فَتُوردِيهِ وَتَعيى بَعدُ بِالصَدرَ",61,"ر",1,0],["لا تَطعَمُ الزادَ إِلّا أَن تُهَبَّ لَهُ","كَما يُصادى عَلَيهِ الطاعِمُ السَنِقُ",62,"ق",1,0],["لا تُطاوِلْهُ في الفخارِ فما غا","دَرَ في الفَخْرِ مُرْتَقَىً لِفَخُورِ",63,"ر",1,0],["لا تَطْمَعُوا أنْ أَكونَ عِنْدَكُمْ","فذاكَ ما لا يَرُومُهُ العاقِلْ",64,"ل",1,0],["لا تُطلِعُ الشَمسُ المُنيرَةُ ضَوءَها","إِلّا وَأَنتَ فَضيحَةٌ في الدارِ",65,"ر",1,0],["لا تَطلُبَنَّ اللَذّاتِ مُكتَتِماً","وَاِغدُ إِلَيها كَخالِعِ الرَسَنِ",66,"ن",1,0],["لا تُطاعُ الدَهرَ فيما","قَد عَناني بِقُرابِ",67,"ب",1,0],["لا تُطيعي هَواكِ أَيَّتُها النَف","سُ فَنُعمى المَليكِ فينا رَبيبَه",68,"ب",2,1],["لا تَطرِيَنّي فَلي نَفسٌ مُجَرَّبَةٌ","تُسِرُّ وَجداً إِذا بِالمَينِ أُطريتُ",69,"ت",1,0],["لا تَطرُدِ الوَحشَ فَما يَلبَثُ الصارِدِ","مَطرودُ في الدُنيا وَلا الطارِدُ",70,"د",1,0],["لا تَطلُبِ الغَرضَ البَعيدَ وَتَسهَرِ","ما يُقضَ يَأتِ وَطالِبٌ لَم يُبهَرِ",71,"ر",1,1],["لا تَطْوِيا السّرّ عنّي يَومَ نائبةٍ","فإنّ ذلك ذَنْبٌ غيرُ مُغْتَفَرِ",72,"ر",1,0],["لا تطل شعرك وابذل","كل جهد ان تجيده",73,"ه",1,1],["لا تَطمَئِن بكون لَيلك هادِئاً","فَلَسوف يأَتي السيل ملء الوادي",74,"د",2,0],["لا تُطرِقي وابتهجي وابسِمي","عمّا قليل يُقبِلُ الزائرُ",75,"ر",1,0],["لا تُطيلي الوقوفَ تحتَ سياجي","لنْ تَرَي فيه للثَّواءِ محلا",76,"ل",2,0],["لا تُطيلي الوقوفَ أيتها الأشبا","حُ فامضي فما رأيتكِ قبلا",76,"ل",2,0],["لا تطلبن بآلة لك رتبة","قلم البليغ بغير حظ مغزل",77,"ل",1,1],["لا تُطْلِقُ الشُّذَّاذَ إلاَّ على","تزْكِيةِ الْمَخْبَرِ لِلْمُخَبِرِ",78,"ر",1,0],["لا تُطِع زَنادِقَةً","ساءَ عَقدُ مضمَرِها",79,"ر",3,0],["لا تطيري جوابة السفح فالنسر","إذا ما خبرته لم تطيري",80,"ر",2,0],["لا تطرُقُ السمعَ إلا خلفت أثرًا","كالنقش في الصخر؛ لا يمحوه ماحيه",81,"ي",2,0],["لا تطلبوا الإنصافَ مِنْ","قاضٍ بواشنْطونَ جائر",82,"ر",1,0],["لا تطلُبي من يد الجبار مرحمةً","ضعي على هامةٍ جبارةٍ قدما",83,"م",2,0],["لا تَطلُبَن هَيهاتِ مِنهُ صَلاحَهُ",