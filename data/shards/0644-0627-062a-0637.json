670.html","الطويل"],[468,"يا آمري بالذل للمرتمي","https://www.aldiwan.net/poem59733.html","الوافر"],[468,"يا أيها الغر الجهول الذي","https://www.aldiwan.net/poem59779.html","السريع"],[503,"أظن جهلكم هذا وبطشكم","https://www.aldiwan.net/poem21716.html","البسيط"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[541,"لم يبق يا ويحكُم إلا تلاقيها","https://www.aldiwan.net/poem676.html",""],[551,"لا تطمعي في سلو قلب","https://www.aldiwan.net/poem47147.html","مخلع البسيط"],[551,"لا تطلب الرزق في الدنيا بمنقصة","https://www.aldiwan.net/poem47187.html","البسيط"],[551,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[551,"ما كان عندي والركاب مناخة","https://www.aldiwan.net/poem47380.html","الكامل"],[551,"كم ذا تذل بهذا الأمر أرؤسنا","https://www.aldiwan.net/poem47717.html","البسيط"],[551,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[551,"تقول لي وأماقيها مطفحة","https://www.aldiwan.net/poem47751.html","البسيط"],[551,"لا تطلبي مني الشباب فما","https://www.aldiwan.net/poem47858.html","أحذ الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[551,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[558,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[558,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[562,"باب تزاحم فيه الوفد وازدحمت","https://www.aldiwan.net/poem52706.html","البسيط"],[567,"ليس خلق إلا وفيه إذا ما","https://www.aldiwan.net/poem69684.html","الخفيف"],[586,"لا تطلبن القوت من معشر","https://www.aldiwan.net/poem17751.html","السريع"]],"verses":[["لا تَطلُبِ الغايَةَ القُصوى فَتُحرَمَها","فَإِنَّ بَعضَ طِلابِ الرِبحِ خُسرانُ",0,"ن",1,0],["لا تَطلُبَنَّ لِيَ الأَبدالَ بَعدَهُمُ","فَإِنَّ قَلبِيَ لا يَرضى بِغَيرِهِمِ",1,"م",1,0],["لا تَطلُبي يانَفسِ خِلّاً بَعدَهُ","فَلَمِثلُهُ أَعيا عَلى المُرتادِ",2,"د",1,0],["لا تَطْلُبوهُ فشَرُّ ما لَقيَ امْرُؤٌ","في السَّعْي خَيْبَةُ طالِبٍ مَكْدودِ",3,"د",1,0],["لا تُطيقُ الجِبالُ يا مَعشَرَ النا","سِ مِنَ الحُبِّ ما تُطيقُ الجُسومُ",4,"م",1,0],["لا تُطعِمانِيَ أَنيابَ المَلامِ عَلى","هَذا العِثارِ فَإِنّي مَهبِطُ العَجَبِ",5,"ب",1,0],["لا تَطهُرُ الأَرضَ مِن رِجسٍ وَمِن دَرَنٍ","حَتّى يُعاوِدَها نوحٌ بِطوفانِ",6,"ن",1,0],["لا تَطْرُقُ الإصْلاحَ عَنْ عَرَضٍ","بَلْ تَطْرُقُ الإصْلاحَ مِنْ أَمَمِ",7,"م",1,0],["لا تَطلُبنّ من الزمان حقيقةً","ما للحقيقة في الزمان وميض",8,"ض",1,0],["لا تَطلُعُ الشَمسُ إِلّا وَهوَ في تَعَبٍ","وَلا تَغَيَّبُ إِلّا وَهوَ مَسبوقُ",9,"ق",1,0],["لا تَطلُبَنَّ خُؤولَةً في تَغلِبٍ","فَالزَنجُ أَكرَمُ مِنهُمُ أَخوالا",10,"ل",2,0],["لا تَطعَمَنَّ الماءَ إِن أَورَدتَهُم","لِتَمامِ طَميِكُمُ فَفوزوا وَاِحبُسوا",11,"س",3,0],["لا تَطلُبَنَّ دُنُوَّ دار","من حَبيبٍ أَو مُعاشِر",12,"ر",1,1],["لا تطلبنَّ من القرائح حصرَ ما","أفضى إليه وَعدِّ عن إعناتِها",13,"ت",3,0],["لا تطلبنَّ من الأيَّامِ مشبهَهُ","ففي طِلابك للأيَّامِ إعنات",14,"ت",1,0],["لا تَطاوَلْ بحسنِ وجهِك والدو","لةِ واذكر من شانِئيك الفناءَ",15,"ا",2,0],["لا تُطعمنَّا لحمك المتَّقَى","فليس مما يأكل الساغبُ",16,"ب",1,0],["لا تَطأُ الأسدُ ما حماهُ ولا","تلقاهُ إلا مُوَطَّأً عَقِبُهْ",17,"ب",2,0],["لا تُطِلْ رهبتي بإرجاءِ أمري","فكفاني فراقُك المرهوبُ",18,"ب",1,0],["لا تطوِ عنه الحديثَ مُحتشِماً","فالاستُ في الحين تنطق الرفثا",19,"ث",2,0],["لا تُطْمِعَنْ فيَّ عَمْراً","فإنه ليَ ضِدُّ",20,"د",1,0],["لا تُطمِعَنَّ حليماً","في زُبدةِ الماءِ مخْضُ",21,"ض",1,0],["لا تطفئنَّ جوى بلوم إنه","كالريح تغري النار بالإحراق",22,"ق",1,0],["لا تُطاوِلْ بأنْ حباك وأن زا","دك لا أحسن الإلهُ مزيدَك",23,"ك",1,0],["لا تُطمِعَنَّك فيه رأفتُهُ","إنَّ المطامع تنصِبُ الشَّبَكا",24,"ك",2,0],["لا تُطلُّ الدماءُ إن طلبوها","وعطايا أكُفّهم مطلولهْ",25,"ل",2,0],["لا تطَّرحني فإني غير مطَّرحٍ","ولا تُذِلْني فإني العِلقُ لم يُذلِ",26,"ل",1,0],["لا تطالبهُ بالثوابِ فما ردْ","دُ ثوابٍ من مثلهِ بحلالِ",27,"ل",1,0],["لا تطعمنَّهمُ وتقطعَ طعمةً","أشبِعْ إذا أطعمْتَ أولا تُطْعمِ",28,"م",1,0],["لا تطيلوا المقام عن جنَّة الخل","دِ فأنتمْ في غير دار مُقام",29,"م",1,0],["لا تُطَيِّرْ وَسناً عن مُقْلةٍ","أنت أهديتَ لها حُلْو الوَسَن",30,"ن",1,0],["لا تَطيقُ الأَرضُ تَخفي شَوكَها أَو زَهرَها","لا تَسَل أَيَّهُما أَشهى وَأَبهى لَستُ أَدري",31,"ي",1,0],["لا تَطلُبَنَّ مِنَ السِياسَةِ رَحمَةً","هِيَ حَيثُ طُلَّ دَم وَحَلَّ دَمارُ",32,"ر",1,0],["لا تَطلُبوا بِالمُرهَفاتِ ذُحولُكُم","في نَيلِها بِالمُرهَفاتِ ذُحولُ",33,"ل",1,0],["لا تَطلِبَنَّ مَحَبَّةً مِن جاهِلٍ","المَرءُ لَيسَ يُحَبُّ حَتّى يُفهَما",34,"م",2,0],["لا تَطلُبَن هَيهاتِ مِنهُ صَلاحَهُ","إِن كانَ رَبُّكَ قَد قَضى بِفسادِهِ",35,"د",2,0],["لاتَطَّرِح خامِل الرِجالِ فَقَد","تَحتاجُ يَوماً إِلى كِفايَتِهِ",36,"ه",1,1],["لا تطمعوا أن يُعزَّ اللهُ دَولتَكم","وإنْ تجاوزَ أدنى شأوِها الشُّهُبا",37,"ب",2,0],["لا تُطر حيا ولا ميتا وإن كرما","حتى ترى لهما بالخلق إحسانا",38,"ن",2,0],["لا تَطلُبوا حَقَّكُم بَغياً وَلا ضَلَفاً","ما أَبعَدَ الحَقَّ عَن باغٍ وَمُختالِ",39,"ل",1,0],["لا تَطلُبَنَّ كَريماً بَعدَ رُؤيَتِهِ","إِنَّ الكِرامَ بِأَسخاهُم يَداً خُتِموا",40,"م",3,0],["لا تَطْمحنَّ إِلى المراتب قبلَ أنْ","تتكاملَ الأدواتُ والأسبابُ",41,"ب",1,1],["لا تَطلُبِ القُبحَ في سَريرَتِهِ","وَاُنظُر إِلى القُبحِ في عَلانِيَتِه",42,"ت",2,0],["لا تَطلُبَنَّ لَهُ الشَبيهَ فَإِنَّهُ","قَمَرُ التَأَمُّلِ مُزنَةُ التَأميلِ",43,"ل",1,0],["لا تَطلُبي بي غَيرَهُ مِمَّن مَشى","إِن أَنتِ ناقَ لَقيتِهِ بِالقَرقَرِ",44,"ر",1,0],["لا تَطلُبَنَّ مَعيشَةً بِمَذَلَّةٍ","وَاِرفَع بِنَفسِكَ عَن دَنِيِّ المَطلَبِ",45,"ب",1,1],["لا تَطلُبَّنَ مَعيشَةً بِمَذَلَةٍ","وَاِربَأ بِنَفسِكَ عَن دَنِيِّ المُطلَبِ",46,"ب",1,1],["لا تُطيقُ الكِلابُ تَنزِعُ عِظماً","موثَقَ السُمرِ في قَرارِ كَنيفِ",47,"ف",1,0],["لا تُطمِعَنَّ ذَوي الفَسادِ بِتَركِهِم","فَالنَذلُ تَطغى نَفسُهُ إِذ تُكرَمُ",48,"م",1,0],["لا تُطْمِعِ الأنضاءَ في راحةٍ","وإن وصلنا بغدوٍّ رواح",49,"ح",