{"poems":[[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[23,"ألا أبلغ أبا سفيان عني","https://www.aldiwan.net/poem21517.html","الوافر"],[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[107,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[22,"لنعم الحي حي بني كليب","https://www.aldiwan.net/poem21707.html","الوافر"],[77,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[22,"لَنِعْمَ الحَيُّ حّيُّ بني كُلَيْب","https://www.poetsgate.com/ViewPoem.aspx?id=19780",""],[112,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[148,"أبدا إليك تولع الأحباب","https://www.aldiwan.net/poem4461.html","الكامل"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[395,"ألم تر أن جيرتنا استقلوا","https://www.aldiwan.net/poem1927.html","الرمل"],[495,"أبي فارسُ الصرماء عمرُو بنُ مالكٍ","https://www.aldiwan.net/poem656.html",""],[567,"رسالة ليس قاريها بذي ملل","https://www.aldiwan.net/poem52729.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138227",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126677","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64250","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70725","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70742","السريع"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205355","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35736","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[1727,"","https://poetry.dctabudhabi.ae/diwan/poem/118042","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89536","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53119","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67933","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202578","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112649","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123917","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138691",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129354","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131011",""],[3842,"","https://poetry.dctabudhabi.ae/diwan/poem/20039","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139626",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[4914,"لك الهنا ولي الأفراح والطرب","https://www.poetsgate.com/ViewPoem.aspx?id=170938",""],[5064,"فانُوسُ اللَّيَالِي","https://www.poetsgate.com/ViewPoem.aspx?id=199168",""],[5351,"صرخة الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202459",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[514,"إِلَّا إِلَيكَ تَسَابَقنَا إِلَى الغَرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=155918",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[6070,"تراتيل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=188420",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6225,"أبنائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80989&r=&rc=258",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""]],"verses":[["هم صفوة اللهِ الخيارُ وفيهم","تأرَّثُ نيران الهُدى وثقوبُها",0,"ب",3,0],["هُمُ صَدَقوا بِبَطنِ الشِعبِ ضَرباً","وَطَعناً في نُحورِكُمُ دِراكا",1,"ك",2,0],["هُمُ صَرَموا حبلَ الهَوى فَتصَرَّما","وهُمْ أَمَرُوا الأَحشاءَ أن تتضرَّما",2,"م",2,1],["هُم صَيَّروا تِلكَ البُروقَ صَواعِقاً","فيهِم وَذاكَ العَفوَ سَوطَ عَذابِ",3,"ب",1,0],["هُمُ صَبَرُوا فانثنوا ظافرين","وما الصّبرُ إلا بَشِيرُ الظَّفَرْ",4,"ر",1,0],["هُمُ صَنَعوا لِجارِهِمُ وَلَيسَت","يَدُ الخَرقاءِ مِثلَ يَدِ الصَناعِ",5,"ع",1,0],["هم صَيّرُوا خَدَماً تَسوسُ أمورَهم","يا للزّمانِ السِّوءِ كيْف تصرّفَا",6,"ف",2,0],["هُمْ صفْوَةُ الدُّنْيَا وَكَانوا صفْوَهَا","وأَحَقُّ حيٍ بِالأَسى أَمْثَالِي",7,"ل",2,0],["هُمُ صَنَعٌ لِجَارِهِمُ وليست","يَدُ الخَرْقَاءِ مِثْلَ يَدِ الصَّنَاعِ",8,"ع",1,0],["هم صفوة المقفين .. ذخر المقبلين","رعّاية الذيدان .. قانية الحرار",9,"ر",1,0],["هم صفوة الرحمن جل جلاله","ولهم به منة نمو ثواب",10,"ب",1,0],["هم صدور دروعها غانيات","ورؤوس خوذاتها اقداح",11,"ح",1,0],["هُمُ صَبَروا وَصَبرُهُم تَليدٌ","عَلى العَزّاءِ إِذ بَلَغَ المَضيقُ",12,"ق",1,0],["هُمُ صَبَّحوا أَهلَ الطِفافِ وَسِربَةٍ","بِشُعثٍ عَلَيها المُصلِتونَ المَغاوِرُ",13,"ر",1,0],["هم صُورةُ الحُسن لا تحسينَ يدخلُها","والحُسنُ في غيرِهم يأتي بِتَحسين",14,"ن",1,0],["هم صفوة الخلق هم أقطاب طائفة","بهم إلى قمة العلياء قد طمحت",15,"ت",1,0],["هُم صفوةُ الباري وأكرم سادةٍ","فَرَضَ الإله على الأنام وَلاءها",16,"ا",3,0],["هُمْ صفوةُ الكرم الذي أصفيتهم","ودّي وأصفيتُ الذي يصفيها",17,"ي",3,0],["هُمُ صناديقُ سِرِّى لا يُباح به","منهمْ ولو فُتشَتْ جمعُ الصناديق",18,"ق",1,0],["همْ صيروا الأرضَ لنا جنَّةً","دانيةً منها علينا الظِّلالْ",19,"ل",1,0],["هم صيروني خيالا غير منتعش","لا أستبين من الأسقام في فرش",20,"ش",1,1],["هم صفوة الأيام والغرر التي","سطعت بناصية الزمان سعودا",21,"د",2,0],["هم صدقوه وهو أصدق واعد","وأوفى في ذمام حبله ليس أفصما",22,"م",2,0],["هُم صَدَعوا بِالحَقِّ حَتّى تَنَفَّسَت","أُنوفُ المُلوكِ وَهيَ خَشمُ المَناخِرِ",23,"ر",1,0],["هم صفوةُ المجدِ من هاشمٍ","وخالصة الحسب الفاخرِ",24,"ر",1,0],["هم صدعوا الفؤاد وأوجعتني","مصائبهمُ غداةَ لقَوا الحِماما",25,"م",2,0],["هُمُ صَدَقا اللَه الذي عاهَدوا بِهِ","إِمامَهُمُ فِعلَ التَقِيِّ المُلازِمِ",26,"م",1,0],["هم صَبَّحوا لخْماً بشهب كتائب","أَوْدَى بها قابوسهم والمنذر",27,"ر",1,0],["هُمُ صفوةُ الله التي ليسَ مثلها","وما مثلهم في العالمينَ بَديلُ",28,"ل",1,1],["هم صفّفوا أشعارهم وشعورهم","وعرضتُ شعري مثل شعري أشيبا",29,"ب",2,0],["هُم صفوةُ الباري منَ الأنامِ","طهّرَهُم من دَنَسِ الآثامِ",30,"م",1,0],["هم صفوتي ان رضوا في الحب أو سخطوا","ومنيتي إن نأوا عني وان قربوا",31,"ب",3,0],["هم صفوة الرحمن من","كل الخليقة والبشر",32,"ر",1,0],["هم صفوة لقديم ليس يدركهم","وصف ويغشاه تكييف وتحديد",33,"د",1,0],["هم صدموكم صدمة فانثنيتم","وبعضكم قتلى وبعضكم اسرى",34,"ر",2,0],["هُم صَلَبوا العَبدِيَّ في جَذعِ نَخلَةٍ","فَلا عَطَسَت شَيبانُ إِلّا بِأَجدَعا",35,"ع",2,0],["هم صحف الله العظيم وعلمها","لديهم ومنهم للنبيين ابجد",36,"د",1,0],["هم صدقوه وهو أصدق وعده","واوفى ذمام حبله ليس أفصما",37,"م",2,0],["هم صفوتي بخلوا في الحب أو سمحوا","ومنيتي بعدوا عني وإن قربوا",38,"ب",3,0],["هُمْ صادِقُونَ كمَا تقُولُ رِياحُهُمْ","\"لكنَّ فانُوسَ اللّيالِي يكذِبُ\"",39,"ب",1,0],["همُ صرخة الأرض داست بها","الطواغيتَ أرجلُ من يصرخونْ",40,"ن",1,0],["هُم صحبة لما نزلنا بينهم","معروفهم شدّ النفوس وأوثقا",41,"ق",2,0],["هم صفوة المجد المؤثل والألى","شرعوا حراما للورى وحلالا",42,"ل",2,0],["ِهُمْ صَوَّرُوكَ بَأَذهَانٍ يُوَسوِسُهَا","إِبلِيسُهُمْ فِي رِوَايَاتٍ مِنَ الحَنَق",43,"ق",1,0],["هم صغارٌ لجواسيسَ كبارٍ","صفعوا الصالح، باسوا المُذنبا",44,"ب",2,0],["همْ صفوةُ الأخلاقِ بينَ ربوعنا","قدْ علموا الأحياءَ درساً في الوفاءْ",45,"ا",2,0],["هُم صِغارٌ عَلَى حُمُولَةِ شِعرِي","فَيَقُولُونَ, بَينَما أَنا أَفعَلْ",46,"ل",1,0],["هم صورة ٌ أثرَى بذاكرتي","أطيافها : روحٌ بلا ظلِّ",47,"ل",1,0],["هم صدَّقوكَ -وأنتَ الشمسُ ساطعةً-","فصدّقَ الله ُما قالوا وما كتبوا",48,"ب",3,0]]}