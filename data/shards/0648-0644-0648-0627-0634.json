{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[93,"سكت خوفا وقلت الصفح من خلقي","https://www.aldiwan.net/poem62725.html","عموديه"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[50,"أمات الله من جوع رقاشا","https://www.aldiwan.net/poem64354.html","الوافر"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[276,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[310,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[350,"أمولى بني تيم ألست مؤديا","https://www.aldiwan.net/poem4476.html","الطويل"],[473,"إذا تثاقل عتب","https://www.aldiwan.net/poem59976.html","المجتث"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[572,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122656","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48707","الكامل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10501","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81923","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58166","الكامل"],[3986,"لا تحبسيني في الهوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502414",""],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["وَلَو أَشا قُلتُ في المُخَلَّعِ ما","فيهِ وَما عفتُ ذاكَ مِن رُعبِ",0,"ب",1,0],["وَلَو أَشاءُ مَلَأتُ الأَرضَ قاطِبَةً","قَوافِياً وَأَفضاءَ الرَحبِ بِالحَكَمِ",1,"م",1,0],["ولو أشرْتَ إلى مصْرٍ بسَوطك لمْ","تُحوِجك مِصرٌ إلى ركض ولا خبَبِ",2,"ب",1,0],["وَلَو أَشمَمتَ مَوتاهُم رَغيفاً","وَقَد سَكَنوا القُبورَ إِذاً لَعاشوا",3,"ش",3,0],["ولو أشربت منا النفوس تبصرا","لما كان منها للشرارة ناقع",4,"ع",1,0],["وَلَو أَشاءُ ضَمَّ قُطرَيهِ الصِبا","عَلَيَّ في ظِلّي نَعيمٍ وَغِنى",5,"ا",1,0],["وَلَو أَشاءُ لَما ضاقَت مَذاهِبُها","عَنّي وَلا كانَ لِي الإِيرادُ وَالصَدَرُ",6,"ر",1,0],["وَلَو أَشارَ إِلى نار السَعير خبت","اذ ذاكَ وانطفأت من نوره النار",7,"ر",1,0],["وَلو أشرفتِ في جنحٍ عليهِ","وَقَد لاقى الهزبرُ أخاكِ بِشرا",8,"ر",2,0],["وَلَو أُشلِيَت في لَيلَةٍ رَجَبِيَّةٍ","بِأَرواقِها هَطلٌ مِنَ الماءِ سافِحُ",9,"ح",1,0],["وَلَو أَشاءُ لَطالَت","يَدي إِلى الإِنتِصارِ",10,"ر",1,0],["ولو أشعرته يوما","بفضل العلم إلماما",11,"م",2,0],["وَلَوْ أَشَاءُ اعْتَضْتُ لَكِنَّ مَنْ","يُعْتَاضُ إِمَّا عَاجِزٌ أَوْ خَؤُونْ",12,"ن",1,0],["ولو أشاءُ جَزَيتُ اليَأس صاحبَه","رَمياً بِرمي وأنباضاً بأنباض",13,"ض",1,0],["ولو اشتملت على غنى قارون ما","أبرأت في صدري جوى يتغلغل",14,"ل",1,0],["وَلَّوا شِلالا وَعُظمُ الخَيلِ لاحِقَةٌ","كَما تَخُبُّ إِلى أَوطانِها النِعَمُ",15,"م",1,0],["ولو أشار إلى السحب الجهام بها","ما كف واكف غاديها وساريها",16,"ي",3,0],["ولو أشار إلى النار التي سعرت","للحرب نبذ الحصى قرت لصاليها",16,"ي",3,0],["ولو أشار إلى الأفلاك منتدباً","لفارقت جزعاً من بأسه الأفقا",17,"ق",2,0],["ولو اشتغلتم بالصلاح لدينكمْ","بُلِّغْتُمُ الحاليْنِ في إمكان",18,"ن",1,0],["وَلَو أَشاءُ لَقُلتُ ما","عِندي مَفاتِحُهُ وَبابُه",19,"ب",2,0],["ولو أشا اعتضْتُ ولكنَّ ما","يعتاضُ إلاّ تاجرٌ أو خَؤُونْ",20,"ن",1,0]]}