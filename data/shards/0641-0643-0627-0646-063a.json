{"poems":[[228,"أسيلة الفحشاء نارك في دمي","https://www.aldiwan.net/poem41597.html","الكامل"],[358,"صل ما استطعت على أغر محجل","https://www.aldiwan.net/poem39794.html","الكامل"],[469,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126724","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104252","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4927,"فرحة الاعياد","https://www.poetsgate.com/ViewPoem.aspx?id=4589",""],[4984,"ما تخبئه النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""]],"verses":[["فَكَأَنَّ غَضبَةَ أَنبيِيائِكِ عِندَما","أُحرِقَتِ عاشَت في اللَظى المُتَكَلِّمِ",0,"م",1,0],["فَكَأَنّ غُرّته الثُريّا أَشرَقَت","وَكَأَنَّما فَلق الصَباح أَديمُهُ",1,"ه",1,0],["فكأنَّ غصنَ البانِ يكسرُ","في يدي نشوانَ صاح",2,"ح",1,0],["فكأنَّ غرّته المنيرة بيننا","شمس وفيها لا يضلّ من اِهتدى",3,"د",2,0],["فكأن غصنا من غصون أراكة","تهز مافوق اللِّوى المترجرج",4,"ج",1,0],["فكأن غرة وجهه شمس الضحى","وكان حاجبه هلال العيد",5,"د",1,0],["فكان غريبا بينهم في سخائه","وفي حبه من اهلهم والاقارب",6,"ب",1,0],["فَكَأَنَّ غُرْبَتَنَاْ جَحِيْمٌ مُطْلَقٌ","شَبَّتْ بِهَا النِّيْرَاْنُ دُوْنَ زِنَاْدِ",7,"د",1,0],["فكأن غيث عيونها وتوهجي","لهب على جبل تلقحه الغيوم",8,"م",1,0]]}