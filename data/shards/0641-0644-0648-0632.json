{"poems":[[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[35,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[48,"عظيم لعمري أن يلم عظيم","https://www.aldiwan.net/poem23645.html","الطويل"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[227,"أغرك صبري وفرط ودادي","https://www.aldiwan.net/poem55464.html","المتقارب"],[287,"عجبت ولكن لات حين تعجب","https://www.aldiwan.net/poem32883.html","الطويل"],[422,"إذا كان خصمي حاكمي كيف أصنع","https://www.aldiwan.net/poem53945.html","الطويل"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[471,"سخطت ولم أذنب وترضى مخالفا","https://www.aldiwan.net/poem50476.html","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53823","المتقارب"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19958","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67824","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117645","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27458","الوافر"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141183","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201780","الوافر"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91285","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3749,"فأبخس شيء حكمة عند جاهل","https://www.poetsgate.com/ViewPoem.aspx?id=134958",""],[5704,"على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=194468",""],[6068,"يودّ القلب لقياكم فلمّا -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175887",""],[2220,"حروفُ أوائلِ السورِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11798&r=&rc=668",""]],"verses":[["فَلَوْ زَمَنُ ابْنِ الْجَهْمِ أَشْرَقَ بِشْرُهُ","لَمَا سُرَّ بِ ابْنِ الْجَهْمِ وَالِدُهُ الْجَهْمُ",0,"م",1,0],["فَلَو زُرتُ بَيتَ اللَهَ ثُمَّ رَأَيتُها","بِأَبوابِهِ حَيثُ اِستَجارَت حَمامُها",1,"م",3,1],["فلو زارَ أهلَ الخُلْدِ عتْبُكَ زوْرَةً","لأوْهَمَهُمْ أنّ الجِنانَ جَحيمُ",2,"م",1,0],["فَلَوْ زُرْتَهَا مَمْلُوءَةَ النَّهْدِ مُعْصِرَا","لأَبْكَاكَ مَا سَاءَتْ خِصَالاً وَمخْبَرَا",3,"ر",2,0],["فلو زار طيفك باب الجفون","لصادف فيه رقيب السهاد",4,"د",1,0],["فَلَو زارَها قَبلُ اِمرؤُ القَيسِ لَم يَقُل","خَليلَيَّ مرّا بي عَلى أُمِّ جُندُبِ",5,"ب",1,0],["فلو زارني بالنَّوْم طيف خياله","لكنتُ بطيفٍ منه أرضى وأقنع",6,"ع",1,0],["فلو زالتْ جبال الله عنها","لكانَ وقاره فيها جبالا",7,"ل",2,0],["فَلَو زُرتَ مَلكاً كُنتَ غَيرَ مُخاطِرٍ","وَإِن كُنتَ أَدنى واصِلاً وَأَقرَبُ",8,"ب",1,0],["فلو زيَّنَ الحسن من وجهه","بهجرْ الصدود ووصل الوصالِ",9,"ل",1,1],["فلو زال هضب النير عن سكناته","ليممت من وجدٍ به حيث يمما",10,"م",2,0],["فَلَوْ زَارَ شَخْصٌ كَانَ بَخَّاً عَلى بَجِّ","يَلُومُنَنِي فِي حُبِّ بَدْرٍ تَحَجَّبَا",11,"ب",2,0],["فلو زرتهم لم تعرفِ الراحَ منهمُ","ثيابهم من مثلها والعمائمُ",12,"م",1,0],["فَلَوْ زَارَهُ الْبَدْرُ بَانَ لَهُ","مِنَ الشَّمْسِ عَنْهُ القُصُورُ اضْطِرَارَا",13,"ر",2,0],["فلو زادت على خمسٍ","فمن عندي بنائنها",14,"ن",3,0],["فلو زار أفلاطون أعتاب قدسه","ولم يشعه عنها سواطع أنوار",15,"ر",1,0],["فلو زكّي حجاه هنا ليسمو","سما من دون تزكية وطهر",16,"ر",1,0],["فلو زال وصفها لزالت حجوبها","ولبدت شمسها بنور مضيئة",17,"ه",1,0],["فَلو زار طَيفُ القَوم جسمي لَقال لي","أَلا عِم صَباحاً أَيُّها الطلل البالي",18,"ل",2,0],["فلو زفس لي بقواك حكم","لأوليتك الآن مر الندم",19,"م",1,0],["فلو زفت الحسناء للذئب لم يكن","يرى قربها إلا لأكل المعاصم",20,"م",1,0],["فَلَو زاد في هجري أزيد تقربًا","وإن زاد في عتبي فلست أعاتبُهْ",21,"ب",2,0],["فلو زرعوا القنابل كل درب","وزادوا الراجمات لها دحيس",22,"س",1,0],["فلوْ زداتْ على خمسٍ","فمن عندي بنائنها",23,"ن",3,0]]}