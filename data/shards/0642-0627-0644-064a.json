{"poems":[[93,"زارني صبحاً وحيى","https://www.aldiwan.net/poem11100.html","مجزوء الرمل"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"رب عرض منزه عن قبيح","https://www.aldiwan.net/poem8143.html","الخفيف"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[91,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[85,"كان ذئب يتغذى","https://www.aldiwan.net/poem8000.html","مجزوء الرمل"],[85,"وقف الهدهد في باب","https://www.aldiwan.net/poem8030.html","مجزوء الرمل"],[85,"كان فيما مضى من الدهر بيت","https://www.aldiwan.net/poem8034.html","الخفيف"],[85,"كان للغربان في العصر مليك","https://www.aldiwan.net/poem8044.html","الرمل"],[69,"سألته عن يده","https://www.aldiwan.net/poem28242.html","مجزوء الرجز"],[105,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[105,"وفد الفارس الذي تفرق الأب","https://www.aldiwan.net/poem44008.html","الخفيف"],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49190","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24684","البسيط"],[95,"هكذا تقتحم القدس","https://www.poetsgate.com/ViewPoem.aspx?id=710",""],[85,"كان ذئبٌ يتغدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9723&r=&rc=213",""],[85,"وقفَ الهُدْهُدُ في با","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9694&r=&rc=184",""],[161,"قال يحيى لما هجونا اباه","https://www.aldiwan.net/poem58676.html","الخفيف"],[211,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[224,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[242,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[329,"مزجت مصر دمعها بدمائه","https://www.aldiwan.net/poem55012.html","الخفيف"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[329,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[343,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[454,"إرفيني إلى سمائك حتى","https://www.aldiwan.net/poem61563.html","الخفيف"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[454,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[462,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[539,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"]],"verses":[["قَالَ يَا بُشْراً فَقلْتَ البِشْ","رُ أَنْ جِئْتَ إِلَيَّا",0,"ي",2,0],["قال : يا خاتم النبيين أمست","مكة دار طغمة سفهاء",1,"ا",2,0],["قال يا بدرُ أنت تغدِرُ بالسا","ري وتُزري بزَوْرة الحسناءِ",2,"ا",2,0],["قال يوماً كُنّا بِطُوْسُ فنادَو","هُ ألا اخفض فقال كنا بطِيس",3,"س",1,0],["قالَ يا اِبنَ اللَيلِ مَهما","أَشتَهي لا أَشتَهيكا",4,"ك",2,0],["قالَ يا أُمَّ صَديقي","بِيَ مِمّا بِكِ غُمَّه",5,"م",2,0],["قالَ يا مَولايَ كُن لي","عيشَتي صارَت مُمِلَّه",6,"ل",2,0],["قالَ يا صاحِبَ الأَمانَةِ قُل لي","كَيفَ حالُ الوَرى وَكَيفَ الرِجالُ",7,"ل",1,0],["قالَ يا فَرعَ المُلوكِ الصالِحين","أَنتَ ما زِلتَ تُحِبُّ الناصِحين",8,"ن",1,0],["قالَ يا مَولايَ لا تَسأَل نُدور","أَنا لا أَنظُرُ في هَذي الأُمور",8,"ر",1,0],["قالَ يدي مكسورةٌ","قلتُ وقلبي معها",9,"ه",2,0],["قال يا قومُ ليسَ بي من جُحودٍ","إنّه مَالُكُم إليكم يَعودُ",10,"د",1,0],["قال يا قيسُ أنتَ سيّدُ قومٍ","ليس فيهم لغيرِكَ اليومَ شَانُ",11,"ن",1,0],["قال يا عمروُ هل أصابكَ مَسٌّ","فتمادَى الهُراءُ والهَذيانُ",11,"ن",1,0],["قال يا ويحَهُ أ آمره أم","رِي فَمِنْهُ الإباءُ والعِصْيانُ",11,"ن",1,0],["قال يا ويلتا أأهدمُ مَجدِي","وأُعادِي أبُوَّتي الأَوَّلينا",12,"ن",2,0],["قال يا عمِّ ما بُعثتُ لدنيا","أبتغيها وما خُلِقتُ حَصورا",13,"ر",2,0],["قالَ ئذَنوا لي أَسأَلِ التُجّارا","قَرضاً وَإِلّا بِعتُهُم عَقارا",14,"ر",2,0],["قال يا قوم إنّه يتلظَّى","في إباءٍ ما ينقضِي منه وَقْدُ",15,"د",1,0],["قال يا قومنا جهنمُ غصت","بالألى يظلمون منكم فثوروا",16,"ر",3,0],["قال يا قومنا أرى الأمر من سو","ءٍ إلى الأسوأ الأمضِّ يسير",16,"ر",1,0],["قال يا قومنا احتملتم من الحي","فِ ثقالاً يعيا بهنَّ البعير",16,"ر",1,0],["قال يا قوم إن هذا الذي أن","تُمْ تقاسونه لشيءٌ كثير",16,"ر",1,0],["قال يا قوم إننا قد ظُلمنا","شرَّ ظلم فما لنا لا نثور",16,"ر",1,0],["قال يا قوم لا تخافوا فما فو","ق شرور تكابدونَ شرور",16,"ر",1,0],["قال يوما لأسود","ناكه وسط ممرغَهْ",17,"غ",2,1],["قال يا حسناء ما شئت اطلبي","فكلانا بالغوالي مولع",18,"ع",1,0],["قال : يا أمَّ صديقي","بيَ مما بكِ عمَّهْ",19,"م",2,0],["قال: يا مولايَ، كن لي","عشتي صارت مملَّه",20,"ل",2,0],["قال يحيى لما هجونا اباه","ورأى من هجانا فيه أشيا",21,"ي",2,1],["قال يا اديب صف واضجي","وقامتي يا فصح مقال",22,"ل",1,0],["قالَ يا أُمِّ أَيُّ شَيءٍ معيبٌ","في غَرامي وَأَيُّ شَيءٍ أَضَرّا",23,"ر",2,0],["قال يا أُمٍّ قد عييتُ بأمري","بين أسرٍ مُرٍّ وقتلٍ فظيع",24,"ع",1,0],["قالَ يَرقى مكانةً بعد حينٍ","قلتُ مَن لي بيومها الأصحيانِ",25,"ن",1,0],["قال يُغنيك عن لقاهُ كتابٌ","قلتٌ إن يغنِ مسمعٌ عن عيانِ",25,"ن",1,0],["قال يا ربّ هذه مصر تشكو","ظلم هذا الدخيل في غاوائه",26,"ا",3,0],["قال يا صاحبي معانيك مثلي","قلت لا قال فالمُنى كالمعاني",27,"ي",1,0],["قال يا ريح كن بساطى إليها","ففؤادي أضناه طول اللواب",28,"ب",1,0],["قال يا شيخ قد أتيتك أدعو","ك إلى عالم رفيع الجناب",28,"ب",1,0],["قال يكفي قلت ماذا","قال ست قبلات",29,"ت",1,0],["قال ي الدهر سوف تأتي بإعجا","ز فصبرا وسوف تحيا مثالا",30,"ل",2,0],["قال ياقوم ما القنوطِ بمجدٍ","للعزيزِ النهُّىَ ولا النسيانُ",31,"ن",1,0],["قال يا أمي كفاني أنني","لك أحيا ثم أفنى مُستهاما",32,"م",2,0],["قالي الدَّنايا وصَبْوانُ العُلى كَلِفٌ","فالعارُ والمَجْدُ مَقْطوعٌ ومَوْصولُ",33,"ل",1,0],["قال يا خَيرَ أديبٍ","دَعكَ مِن ذا الهَذَيانِ",34,"ن",1,0]]}