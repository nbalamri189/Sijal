{"poems":[[95,"زارني صبحاً وحيى","https://www.aldiwan.net/poem11100.html","مجزوء الرمل"],[97,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[53,"رب عرض منزه عن قبيح","https://www.aldiwan.net/poem8143.html","الخفيف"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[93,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[87,"كان ذئب يتغذى","https://www.aldiwan.net/poem8000.html","مجزوء الرمل"],[87,"وقف الهدهد في باب","https://www.aldiwan.net/poem8030.html","مجزوء الرمل"],[87,"كان فيما مضى من الدهر بيت","https://www.aldiwan.net/poem8034.html","الخفيف"],[87,"كان للغربان في العصر مليك","https://www.aldiwan.net/poem8044.html","الرمل"],[71,"سألته عن يده","https://www.aldiwan.net/poem28242.html","مجزوء الرجز"],[107,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[107,"وفد الفارس الذي تفرق الأب","https://www.aldiwan.net/poem44008.html","الخفيف"],[107,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49190","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24684","البسيط"],[97,"هكذا تقتحم القدس","https://www.poetsgate.com/ViewPoem.aspx?id=710",""],[87,"كان ذئبٌ يتغدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9723&r=&rc=213",""],[87,"وقفَ الهُدْهُدُ في با","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9694&r=&rc=184",""],[164,"قال يحيى لما هجونا اباه","https://www.aldiwan.net/poem58676.html","الخفيف"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[246,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[333,"مزجت مصر دمعها بدمائه","https://www.aldiwan.net/poem55012.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[333,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[347,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[458,"إرفيني إلى سمائك حتى","https://www.aldiwan.net/poem61563.html","الخفيف"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[458,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[466,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2465","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77523","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77568","المتدارك"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77514","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27233","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47186","الخفيف"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113033","الرمل"],[2497,"","https://poetry.dctabudhabi.ae/diwan/poem/143745","الخفيف"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141210","السريع"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201866","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204659","الرمل"],[3233,"","https://poetry.dctabudhabi.ae/diwan/poem/146168","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121788","الخفيف"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99331","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114166","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111390","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136822",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66212","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66152","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72975","السريع"],[4830,"سقيفةُ بني سام","https://www.poetsgate.com/ViewPoem.aspx?id=202263",""],[5135,"الهجرُ صِبْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=201960",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[333,"من وحي الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=105874",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5411,"سَبَّحَ الشِّعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190638",""],[5431,"قال يوما أحبها للرياح....","https://www.poetsgate.com/ViewPoem.aspx?id=199598",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5463,"سلوى عنوان المودّه","https://www.poetsgate.com/ViewPoem.aspx?id=30881",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[5660,"كان قلبي يوم مجروح * موال*","https://www.poetsgate.com/ViewPoem.aspx?id=24828",""],[5848,"سوق الفيصلية","https://www.poetsgate.com/ViewPoem.aspx?id=49228",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""]],"verses":[["قَالَ يَا بُشْراً فَقلْتَ البِشْ","رُ أَنْ جِئْتَ إِلَيَّا",0,"ي",2,0],["قال : يا خاتم النبيين أمست","مكة دار طغمة سفهاء",1,"ا",2,0],["قال يا بدرُ أنت تغدِرُ بالسا","ري وتُزري بزَوْرة الحسناءِ",2,"ا",2,0],["قال يوماً كُنّا بِطُوْسُ فنادَو","هُ ألا اخفض فقال كنا بطِيس",3,"س",1,0],["قالَ يا اِبنَ اللَيلِ مَهما","أَشتَهي لا أَشتَهيكا",4,"ك",2,0],["قالَ يا أُمَّ صَديقي","بِيَ مِمّا بِكِ غُمَّه",5,"م",2,0],["قالَ يا مَولايَ كُن لي","عيشَتي صارَت مُمِلَّه",6,"ل",2,0],["قالَ يا صاحِبَ الأَمانَةِ قُل لي","كَيفَ حالُ الوَرى وَكَيفَ الرِجالُ",7,"ل",1,0],["قالَ يا فَرعَ المُلوكِ الصالِحين","أَنتَ ما زِلتَ تُحِبُّ الناصِحين",8,"ن",1,0],["قالَ يا مَولايَ لا تَسأَل نُدور","أَنا لا أَنظُرُ في هَذي الأُمور",8,"ر",1,0],["قالَ يدي مكسورةٌ","قلتُ وقلبي معها",9,"ه",2,0],["قال يا قومُ ليسَ بي من جُحودٍ","إنّه مَالُكُم إليكم يَعودُ",10,"د",1,0],["قال يا قيسُ أنتَ سيّدُ قومٍ","ليس فيهم لغيرِكَ اليومَ شَانُ",11,"ن",1,0],["قال يا عمروُ هل أصابكَ مَسٌّ","فتمادَى الهُراءُ والهَذيانُ",11,"ن",1,0],["قال يا ويحَهُ أ آمره أم","رِي فَمِنْهُ الإباءُ والعِصْيانُ",11,"ن",1,0],["قال يا ويلتا أأهدمُ مَجدِي","وأُعادِي أبُوَّتي الأَوَّلينا",12,"ن",2,0],["قال يا عمِّ ما بُعثتُ لدنيا","أبتغيها وما خُلِقتُ حَصورا",13,"ر",2,0],["قالَ ئذَنوا لي أَسأَلِ التُجّارا","قَرضاً وَإِلّا بِعتُهُم عَقارا",14,"ر",2,0],["قال يا قوم إنّه يتلظَّى","في إباءٍ ما ينقضِي منه وَقْدُ",15,"د",1,0],["قال يا قومنا جهنمُ غصت","بالألى يظلمون منكم فثوروا",16,"ر",3,0],["قال يا قومنا أرى الأمر من سو","ءٍ إلى الأسوأ الأمضِّ يسير",16,"ر",1,0],["قال يا قومنا احتملتم من الحي","فِ ثقالاً يعيا بهنَّ البعير",16,"ر",1,0],["قال يا قوم إن هذا الذي أن","تُمْ تقاسونه لشيءٌ كثير",16,"ر",1,0],["قال يا قوم إننا قد ظُلمنا","شرَّ ظلم فما لنا لا نثور",16,"ر",1,0],["قال يا قوم لا تخافوا فما فو","ق شرور تكابدونَ شرور",16,"ر",1,0],["قال يوما لأسود","ناكه وسط ممرغَهْ",17,"غ",2,1],["قال يا حسناء ما شئت اطلبي","فكلانا بالغوالي مولع",18,"ع",1,0],["قال : يا أمَّ صديقي","بيَ مما بكِ عمَّهْ",19,"م",2,0],["قال: يا مولايَ، كن لي","عشتي صارت مملَّه",20,"ل",2,0],["قال يحيى لما هجونا اباه","ورأى من هجانا فيه أشيا",21,"ي",2,1],["قال يا اديب صف واضجي","وقامتي يا فصح مقال",22,"ل",1,0],["قالَ يا أُمِّ أَيُّ شَيءٍ معيبٌ","في غَرامي وَأَيُّ شَيءٍ أَضَرّا",23,"ر",2,0],["قال يا أُمٍّ قد عييتُ بأمري","بين أسرٍ مُرٍّ وقتلٍ فظيع",24,"ع",1,0],["قالَ يَرقى مكانةً بعد حينٍ","قلتُ مَن لي بيومها الأصحيانِ",25,"ن",1,0],["قال يُغنيك عن لقاهُ كتابٌ","قلتٌ إن يغنِ مسمعٌ عن عيانِ",25,"ن",1,0],["قال يا ربّ هذه مصر تشكو","ظلم هذا الدخيل في غاوائه",26,"ا",3,0],["قال يا صاحبي معانيك مثلي","قلت لا قال فالمُنى كالمعاني",27,"ي",1,0],["قال يا ريح كن بساطى إليها","ففؤادي أضناه طول اللواب",28,"ب",1,0],["قال يا شيخ قد أتيتك أدعو","ك إلى عالم رفيع الجناب",28,"ب",1,0],["قال يكفي قلت ماذا","قال ست قبلات",29,"ت",1,0],["قال ي الدهر سوف تأتي بإعجا","ز فصبرا وسوف تحيا مثالا",30,"ل",2,0],["قال ياقوم ما القنوطِ بمجدٍ","للعزيزِ النهُّىَ ولا النسيانُ",31,"ن",1,0],["قال يا أمي كفاني أنني","لك أحيا ثم أفنى مُستهاما",32,"م",2,0],["قالي الدَّنايا وصَبْوانُ العُلى كَلِفٌ","فالعارُ والمَجْدُ مَقْطوعٌ ومَوْصولُ",33,"ل",1,0],["قال يا خَيرَ أديبٍ","دَعكَ مِن ذا الهَذَيانِ",34,"ن",1,0],["قالَ يَشكو الصُداعَ وَهوَ سَقيمٌ","بِكَ لا بِالَّذي عَنيتَ الصُداعُ",35,"ع",1,0],["قالَ يا ثَعلَبُ قُل لي ما تَرى","ريح غاري قالَ عَنها لا تَسَل",36,"ل",1,0],["قال يا رَب تبدَّلها لي","جارية مِن نسوان الحَبشي",37,"ش",2,0],["قال يا رب اسخطها قطه","دا اللي فهشي ما يخلِّهشي",37,"ش",2,0],["قالَ يا إِله العالمين","وَيا رَحيم الرحما",38,"م",2,0],["قال يا سائلَ الكريم علوماً","ما على عالمٍ بها من جُناح",39,"ح",1,0],["قال يا ظالماً بواديك هذا","رأسُك المجتري أريك قصاصَه",40,"ص",2,0],["قال يستطرد بي ما حاله","صار للعشَّاق فينا مثلا",41,"ل",2,0],["قال يا بدر أنت تغدر بالسا","ري وتغري بزورة الحسناء",42,"ا",2,0],["قال يا شمر هل علمت بأني","ابن بنت الرسول بدر التمام",43,"م",1,0],["قال يا شمر خل قتلي لتحظى","يوم حشر الورى بدار السلام",43,"م",1,0],["قال يراعي حين كلفته","تحرير هذا الهذر ماذا الخبال",44,"ل",1,0],["قال يا قوم اتركوا هذا العتاب","إن قتل الأم أولى بالصواب",45,"ب",1,0],["قال يبدو في الرسم وسمٌ بخدي","قلت دعه تُغطّه شفتايا",46,"ي",2,0],["قال يدعوه بقلب ناقم","ان يكن في فمه لم يقل",47,"ل",1,0],["قال يا رب نجني من هواه","أو فرد الذي يحب عليه",48,"ه",1,0],["قال يَأْسِي له اسْتَرِحْ فهْي طُرْقٌ","ما على المُحْسِنين فيها سَبِيلُ",49,"ل",1,0],["قال يوماً لنا أبو دلف أب","رد من تطرق الهموم فؤاده",50,"د",2,1],["قال يا عم لست أترك أمرا","جئت فيه بأمر رب الانام",51,"م",1,0],["قَالَ يَا هَذَا فَلاَ عَجَب","قَمَرٌ قَد حَلَّ فِي أسَدِ",52,"د",1,0],["قالَ يَهتَزُّ حُبورا أَقسمي","لي بِإِستِكسَ الرَهيبِ الأَعظَمِ",53,"م",1,0],["قال يا فَندَرُوسُ حَتَّى مَ قَوساً","وسِهاماً قَدِ ادَّخَرتَ ادِّخارا",54,"ر",2,0],["قالَ يا فَندَرُوسُ مَهلاً وهَيَّا","بِعِجالي لِكَبحِهِ نَتَهَيَّا",54,"ي",2,0],["قالَ يا آنِياسُ عِندِيَ أَحرى","أَن تَسُوقَ الجِيادَ مُذ كُنتَ أَدرى",54,"ر",2,0],["قالَ يَا شَيخُ فَاحذَرِ القُربَ مِن فُد","كِي سَوَاءٌ رَجعتَ أَم أَنتَ باقِي",55,"ق",2,1],["قالَ يا أُمَّاهُ تَنحَطُّ القُوَى","بارتِشَافي الآنَ شَهدَ السَّلسَبِيل",56,"ل",1,0],["قالً يَكفي مُنيَةَ النَّفسِ فَقَد","هِضتِ نَفسي بِعَنيفِ العَتَبِ",57,"ب",1,0],["قال يرميه بالملام العنيف","أثوى الجبن في حشا ميلنيف",58,"ف",1,0],["قال يا هذا إِنَّ حقَّك عندي","واجبٌ بعدَ هذهِ الآلاءِ",59,"ا",2,0],["قال يا مرهف الحدين حدك حديده","قل له أعذرك وألق العذر ختم القصيده",60,"د",2,0],["قالَ يَكْفِيكَ ما نَصِبْتَ فَأَقْصِرْ","عَنْ لِحاقي اخْطاكَ نَيلُ المُرادِ",61,"د",1,0],["قالَ يا أُمِّ قَدْ رَأَيْتُ المَنايا","في طَرِيقُي رِواقُها مَمْدُودُ",62,"د",1,0],["قال يهنّيني بريد الحمى","حيّاهُ مولاهُ بلفظٍ وجيز",63,"ز",1,1],["قالَ ياقومُ هلمّوا قد دعانا","داعيَ الحُكْمِ ولاتخشوا رديفَهْ",64,"ف",2,0],["قال : يا صاحِ تصبر","قلت : إن الهجرَ صِبْرُ",65,"ر",1,0],["قال يا إسحاق ليلتنا","ليلة الأفراح فاغتنم",66,"م",1,0],["قال يا مولاي عندي ما","لو فشا لشفى من السقم",66,"م",1,0],["قال يا حسن اغتنم ختني","قال يا مولا