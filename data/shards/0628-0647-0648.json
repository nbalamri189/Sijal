{"poems":[[75,"يا غزالا جمعت فيه","https://www.aldiwan.net/poem11901.html","مجزوء الرمل"],[95,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[45,"به وبمثله شق الصفوف","https://www.aldiwan.net/poem9729.html","الوافر"],[82,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[52,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140946",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[119,"لأعتاب غوث الشرق صاحب بصرة ال","https://www.aldiwan.net/poem41772.html","الطويل"],[119,"فككت بجاه خير الخلق عقدا","https://www.aldiwan.net/poem42153.html","الوافر"],[119,"تدارك أجل المرسلين بإحسان","https://www.aldiwan.net/poem42178.html","الطويل"],[139,"أهدي إلى السامي المقام سلاميه","https://www.aldiwan.net/poem48994.html","الكامل"],[151,"أما آن للخل المريض بأن يبرا","https://www.aldiwan.net/poem47655.html","الطويل"],[159,"بهواك إذ قال الهوى","https://www.aldiwan.net/poem55763.html","مجزوء الكامل"],[164,"بالسعد دار نجم هذا الدار","https://www.aldiwan.net/poem58972.html","الرجز"],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[286,"إلى أحمد المختار نهدي تحية","https://www.aldiwan.net/poem1393.html","الطويل"],[287,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[333,"أخطأت ميعادك","https://www.aldiwan.net/poem54978.html","مجزوء الرجز"],[354,"كسرت بالوقت سيفي","https://www.aldiwan.net/poem15783.html","الهزج"],[376,"بهواك هنت على الذي","https://www.aldiwan.net/poem56976.html","مجزوء الكامل"],[438,"ألم به طيف الخيال مسلما","https://www.aldiwan.net/poem12475.html","الطويل"],[443,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[520,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[563,"بتجلى محاسن المحبوب","https://www.aldiwan.net/poem33558.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126842","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66848","الوافر"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110423","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96996","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88618","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87032","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64295","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96666","الوافر"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101337","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64918","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112868","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112780","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80445","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102137","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102129","الرجز"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102111","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27975","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27432","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109435","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109758","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67280","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105675","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76143","الطويل"],[2759,"","https://poetry.dctabudhabi.ae/diwan/poem/145655","الوافر"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204768","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103496","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126284","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126297","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103854","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48303","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118759","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117955","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85027","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131204",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133286","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135773","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119410","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90900","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94670","الكامل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28752","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104540","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35415","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139575",""],[4691,"بماذا يكنّي والكنايات محرقة","https://www.poetsgate.com/ViewPoem.aspx?id=215324",""],[4767,"فاطمة (ابنتي)","https://www.poetsgate.com/ViewPoem.aspx?id=129784",""],[4767,"أرجوحة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215109",""],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[4843,"يا أمةَ العربِ الأمجادِ في القدمِ","https://www.poetsgate.com/ViewPoem.aspx?id=142690",""],[4859,"خذني إليك","https://www.poetsgate.com/ViewPoem.aspx?id=186972",""],[4896,"الفجر المرتقب","https://www.poetsgate.com/ViewPoem.aspx?id=180878",""],[5072,"لن أشتري الأحلامَ من أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=53684",""],[5136,"من في الملوك يقاس بالشمس","https://www.poetsgate.com/ViewPoem.aspx?id=121607",""],[5184,"صبرُ الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=189879",""],[5194,"عفة الزين","https://www.poetsgate.com/ViewPoem.aspx?id=32718",""],[5219,"الرحمة المزجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194855",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[4442,"ذهب الورق وانطوى سلطانه","https://www.poetsgate.com/ViewPoem.aspx?id=170989",""],[6127,"إلى الأم في يومها","https://www.poetsgate.com/ViewPoem.aspx?id=203599",""],[6189,"بهو الفيروز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83569&r=&rc=36",""],[2599,"وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85628&r=&rc=24",""]],"verses":[["بِهَواكَ الدَهرَ أَلهو","وَبِحُبَّيكَ أَدينُ",0,"ن",1,0],["بِهِ وَبِالرَّهْطِ مِنْ أَنْدَادِهِ شَرَفٌ","لِمِصْرَ تَزْهَى بِهِ فِي السِّرِّ وَالعَلَنِ",1,"ن",1,0],["بهوٌ ترى ما خلفه إلى الحنكْ","كالبحر إلا الفلكُ فيه والسمكْ",2,"ك",1,0],["بِهِ وَبِمِثلِهِ شُقَّ الصُفوفُ","وَزَلَّت عَن مُباشِرِهِ الحُتوفُ",3,"ف",1,1],["بهوىً أشابَ مفارقي ولوَ انّه","يُلْقى على شرخ الشبابِ لَشابا",4,"ب",2,0],["بِهِ وهو يَدعو بِصدقِ الحَديثِ","إِلى اللَهِ مِن قَبل زيغِ القَدَمِ",5,"م",1,0],["بِهَواها طالَ لَيلي","وَبِها طالَت شَكاتي",6,"ت",2,0],["به وبمثله شق الصفوف","وزلت عن مباشرها الحتوف",7,"ف",1,0],["بهؤلاءِ السُّمْرِ جُبْتَ الثرى","ودِنتَ في سلطانك العالمينْ",8,"ن",1,0],["به وجدت كفُّ المظالم مَكْمَناً","تحوم عليه أنَّةُ المتظلِّم",9,"م",1,0],["به وبهم أرجو النجاة مدى المدى","وأرجو أعاناتي بكل قضيه",10,"ي",2,0],["به وبهم أروم وصول حبلي","بمقصودي وأطلب نجح أمري",11,"ر",2,0],["به وبباز اللَه ذي الباس والعلا","سراج ربا بغداد كوكب جيلان",12,"ن",1,0],["بهواكمو وبسكّريّ حديثكم","ما زال قلبي مغرماً ولسانيهْ",13,"ي",2,0],["به وكل الجوع المعطل للقوى","فللّه ما أنكاه فينا وما أجرا",14,"ر",2,0],["بهواكَ إِذ قالَ الهوى","لجوارحي بِهَواهُ ذوبي",15,"ب",2,1],["بهو بهي ورواق رائق","ومجلس كالفلك الدوار",16,"ر",1,0],["بهو بهى ورواق رائق","ومجلس كبالبحر يحوى البحرا",17,"ر",2,0],["بهِ وَرَدت كتبُ المليكِ لرسلهِ","عَلامةُ صدقِ المُصطَفى فوقَها طرّا",18,"ر",2,0],["بهِ وبِهم أرجو السماحَ من الباري","وَإِن عظُمت في سالف العمر أوزاري",19,"ي",1,0],["به وثقتْ نفسي الضعيفة بعدما","أضرَّ بها من ضعف قوتها الوهن",20,"ن",1,0],["بِهِ وافَت تُهَنِّئُني ثقاتي","وعِندي الهَمُّ لَم يَجِدِ اِنفِراجا",21,"ج",2,0],["بهواك أو تهواه","أو لا فما أدري",22,"ي",1,0],["بِهِ وَلِيُّ زَماني","عَنّي يَذودُ الحَيفا",23,"ف",2,0],["بهواكَ هُنتُ على الَّذي","قَد كنتُ ذا عزٍّ عَليهِ",24,"ي",2,1],["به وبها لم يترُكِ الله كافراً","الى أن غدا فضلاً من الله مُسلِما",25,"م",2,0],["به وضحت طرق المكارم والعلى","فما أن له في الناس شبه ولاشك",26,"ك",1,0],["بهِ وطّدت أركانها بعد وهيها","فقامت ولولاهُ لعزَّ قيامها",27,"م",3,0],["به وبهم لا فرق الله شملهم","أنافت أعاليه وأرست أسافله",28,"ل",2,0],["بهواها تعبّد القوم قبلي","وهو ديني به انجلاء كروبي",29,"ب",2,0],["به وقد أقرّ من خالفنا","بأن إبراهيم لما ظعنا",30,"ن",2,0],["به وتابعته فيه فرقة","فأصبحت باللعن مستحقّة",30,"ه",1,0],["بهِ وُلِدَ النبيّ الطهر من قد","تردّى بالثنا قبل الفطامِ",31,"م",1,0],["به وصَّى النبيُّ غداة خمٌّ","جميعَ الناسِ لو حَفظوا النبيّا",32,"ي",2,1],["بهِ وشمٌ كخطّ السِحر وافَى","لديهِ الخال بالتنقيط يسبي",33,"ب",2,0],["به وأخيه وابنه وشبولهم","سماهم المعالي أزهر اللَه نجمها",34,"م",3,0],["به وسدّوا تحت الثرى حلم احنف","وَمنطق قس بل وحبوة هاشم",35,"م",1,0],["بِهِ وبعباسٍ زَهَت وَتَفاخرت","عَشيرةُ مَجدٍ تُوّجت بِجَلاله",36,"ل",2,0],["بِهَواهُمْ يَزْهُو وَيَشْمَخُ مَنْ قَدْ","كانَ في النَّاسِ زَاهِياً شَمَّاخا",37,"خ",2,0],["بهِ وَجدت زُمرَةً من ناسِ","تونس مَع جَزائِر وَفاسِ",38,"س",1,0],["بِهِ وَهْوَ يُغْني الطَّرْفَ عَنْ إثْمِدِ الْكُحْلِ","تَزَايَدَ شَوْقِي نَحْوَهُ فَتَحَدَّرَتْ",39,"ت",1,0],["بِهِ وَهْوَ لَمْ يَحْصُرْهُ لَفْظٌ وَلاَ خَطُّ","بِهِ أَمِنَتْ أَهْلُ الْمَدَائِنِ وَالْقُرى",40,"ر",2,0],["بهِ وَبِملكهِ اِفتخرَت عمان","فعقّب شاؤها شاماً ومصرا",41,"ر",2,0],["به وقف الحسين ربيط جأش","وشوس الحرب تضطرب اضطرابا",42,"ب",2,0],["بِهَوْلِ سُطاً يَسْلُبْنَ لُقْمانَ حِلْمِهِ","ورُبَّتَما أَذْهَبْنَ جهلَ أَبي جَهْلِ",43,"ل",1,0],["به وبهم بانت شريعة ربنا","وكان بهم بعد الشتات التجمع",44,"ع",1,0],["به وبهم أرجو الحماية والرضى","لنفسي وأهلي مع اهيل مودتي",45,"ي",1,0],["بهولك مرآها إذا اصطخبت بهم","مواخير تجلو فاسقات لفسق",46,"ق",1,0],["بِهِ وَبهم علت رتبى لانى","طويت عَلى ودادهم الضلوعا",47,"ع",2,0],["بهِ وَبما في بُردِهِ مِن أَمانَةٍ","حَمَى اللّهُ ذاكَ البَيتَ مِن كُلِّ مُرهِبِ",48,"ب",1,0],["به وهذا حال المُتَيّم","سكَت تكلّم سكَت تكلّم",49,"م",1,0],["به ومن يرهَق","سبحانكَ اللَهُ",50,"ه",1,0],["به ولا ندَع لطه الكريم","صلوا عليه",51,"ل",3,0],["به وقاك الشرّ فاشكر له","فالشمسُ والأزمم والأنجم",52,"م",1,0],["به وإن شئت بأعياننا","لتشهد الأسماء والمحضرا",53,"ر",2,0],["به وظيفتهُ العليا لقد سعدت","وغيره ربما التوظيف يسعده",54,"د",2,0],["به وأبيك لم يرحم محب","وهل في الحب يا أمي ارحميني",55,"ن",2,0],["بهوى كل غرير أهيف","عصر لهو طالما رق وراق",56,"ق",1,0],["بهِ وعادتْ طباقُ الأرضِ ساكنةً","من كانَ عن رضعه الهادي مُدامنةً",57,"ه",1,0],["به وطليته بأصول دفلى","وشيء من جنى لصف ورند",58,"د",1,0],["به وشجت م