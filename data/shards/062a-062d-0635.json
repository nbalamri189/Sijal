{"poems":[[57,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem26545.html","الطويل"],[93,"قل للذي أحصى السنين مفاخرا","https://www.aldiwan.net/poem8781.html","عموديه"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[193,"ولما رأيت الدهر قد حارب الورى","https://www.aldiwan.net/poem35113.html","الطويل"],[280,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[447,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[463,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[505,"يا عليل القلب ما أغفلكا","https://www.aldiwan.net/poem37931.html","الرمل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124589",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122011","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118405","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53220","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27328","المنسرح"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99073","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129993","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200415","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65122","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121356","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35663","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72604","الرجز"],[4984,"ارتقاء *جدارية 03 *","https://www.poetsgate.com/ViewPoem.aspx?id=186719",""],[5092,"... هُم ....","https://www.poetsgate.com/ViewPoem.aspx?id=213363",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5277,"من دفتر الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=195432",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[463,"بدينكَ بعدما انفرقَ الجميعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60138&r=&rc=194",""]],"verses":[["تَحَصَّنتِ بِالهِجرانِ حِصناً مِنَ الهَوى","أَلا كانَ ذا مِن قَبلِ أَن تُمرِضي القَلبا",0,"ب",2,0],["تُحصى عَلى أَهلِ الحَياةِ دَقائِقٌ","وَالدَهرُ لا يُحصى عَلى الأَمواتِ",1,"ت",1,0],["تحصيلها سهل مع القرصات والر","كيات والجلدات والشنقات",2,"ت",1,0],["تحصَّنوا إِذ عايَنوا الأَهْوالا","لمَعقلٍ كان لهم عِقالا",3,"ل",2,0],["تُحصي حَراكيَ إن مشيتُ لشرفتي","وتَعدُّ خطوي إن رجعتُ لموضعي",4,"ع",2,0],["تحصّنتُ منهُ في بديع مثالها","بسورٍ منيعٍ نلت في ظلّه الأمنا",5,"ن",2,0],["تَحَصَّل هَذا إذْ تَأصَّلَ لِلنُهَى","وَهَلْ يُبتَغَى بالبَحثِ ما هُوَ حاصِلُ",6,"ل",1,0],["تَحصنوا بِجِبال الشامِخات فَما","أَغنَت مَعاقلهم عَنهُم وَلا الحَذَرُ",7,"ر",1,0],["تحصل إذا أسلموك","أهلك إلى الحادثات",8,"ت",1,0],["تحصى الرمال ولا تحصى ممادحه","وجل عن مثل في المدح أو سلب",9,"ب",1,0],["تحُصُّه الأيّام وهو طائرٌ","يزاحم الحظَّ به تهجُّمُهْ",10,"م",2,0],["تحصبُ يا راميَ الجِمارِ بها ال","أرضَ فقلبي لم يشتكِ الألما",11,"م",2,0],["تحصُدُ الشَّرَّ وتَبغي طَيِّباً","يا أَخا الخِسَّةِ لُمْ مِنْجَلَكَا",12,"ك",2,0],["تحَصَّلَ أَنَّ ذا وُدٌّ ثَمينٌ","وهَل شَيءٌ سوى الوُدِّ الثَّمِين",13,"ن",1,0],["تَحَصَّنَتِ الْكُفَّارُ فِيهِ وَمَا دَرَوْا","بِفَتْحٍ لأَبْوَابِ السُّعُودِ بِهِ فَتْحُ",14,"ح",1,0],["تحصيل شيء حاصل لا يعتني","ابدا به من الفوائد يعتنى",15,"ن",2,0],["تحصنت في ظله من أذاك","فسني وفاءك لي أو فشني",16,"ن",2,0],["تحصَّنوا بالعليِّ حين علوا","وخصهم بالشهودِ إذ عَرَجوا",17,"ج",3,0],["تحصى النجوم ولا تحصى فضائله","ولا يحيط بها وصف وتكييف",18,"ف",1,0],["تحصيلُ جاهٍ وكفُّ باغٍ","والأمرُ للّه في القبولِ",19,"ل",1,0],["تحصّن قلبي من جروحٍ إذا أتت","فليست ترى قلباً ولكن ترى جرحا",20,"ح",2,0],["تحصّن من ربّ العلى فوثُوقهُ","به من عدوّ كيدُهُ مُتعاظمُ",21,"م",1,0],["تحصنوا منك في الأجبال من حذر","ولا يُلامُ امرُؤٌ من ضغيم حذرا",22,"ر",2,0],["تحصنت من كيد العدوّ وآلهِ","بمجنبةٍ من حبِّ آل محمدِ",23,"د",1,1],["تحصد فينا وَلَم تَدَع أَبَداً","من نثرة تتقيك حصداءِ",24,"ا",2,0],["تُحصي الأَصابِعُ جودَهُ لِحسابها","لَكن حِسابُ نَداكَ لَيسَ يُحقَّقُ",25,"ق",1,0],["تُحصي الحَصا مُستَوفِياً عَدّهُ","مِن قَبل أَن تُحصي مساويها",26,"ي",3,0],["تحصد من زرع المعاني ما دنا","حصاده وتقطف السنابلا",27,"ل",2,0],["تَحَصَّنْتَ حَتَّى عَلاَ طَالِعٌ","مِنْ الْسَّعْدِ ثُمَّ ارْتَقَى عَاجِلا",28,"ل",2,0],["تحصّنَ بعضهم في قول فحشٍ","وقد نصب الحياءُ ليَّ القلاعا",29,"ع",2,0],["تحصن فيها من هلال ابن عامر","أهلة أفقٍ لا ترى وبدور",30,"ر",1,0],["تحصن فيها إن أردن تحصناً","فهن لها دون الخدور خدور",30,"ر",1,0],["تحصَّنَ فيهِ كلُّ عديمِ بأْسٍ","فقدْ أَمِنوابِجَهْلِهِمُ الحصونا",31,"ن",2,0],["تحصَّنَ الغيُّ بالسُلَّاكِ منهجُهُ","وحصنُهُمْ منْ جميعِ الكونِ قرآنُ",32,"ن",1,0],["تَحَصَّنَ بالجنونِ لدرءِ نصحٍ","يقولُ بهِ المُجرّبُ والحكيمُ",33,"م",1,0],["تحصنت بالأسما من الدهر لائذا","بأنوار كرس ثم عرش المشيئتي",34,"ت",2,0],["تحصِّنهمْ حواضنُ مكرماتٌ","ففاتَ الكهلَ طفلهمُ الرضيعُ",35,"ع",1,0]]}