{"poems":[[29,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[64,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[580,"بدا له في غدانا","https://www.aldiwan.net/poem2697.html","المجتث"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83333","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86738","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145812","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96739","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96677","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72306","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125374","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27476","البسيط"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82136","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137380",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109802","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202911","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133982","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36752","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4727,"ماذا أقول ولا جديد يُقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=208820",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5152,"لا تقرؤوني","https://www.poetsgate.com/ViewPoem.aspx?id=185342",""],[5277,"حتّامَ تقلقُ القصائد؟","https://www.poetsgate.com/ViewPoem.aspx?id=190201",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5582,"أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5736,"هدية","https://www.poetsgate.com/ViewPoem.aspx?id=211830",""],[5758,"مجنونة","https://www.poetsgate.com/ViewPoem.aspx?id=211576",""]],"verses":[["حَتّى اِكتَسَت عَرَقاً جَوناً عَلى عَرَقٍ","يُضحي بِأَعطافِها مِنهُ جَلابيبُ",0,"ب",1,0],["حتى اكتسى من مديحي فيه أوشِيةً","شتَّى فرُحْنا جميعاً نسحبُ الحُلَلا",1,"ل",2,0],["حتى أكونَ بشكرِ بِرِّك كافلاً","ويكون بِرُّك كافلاً بنجاحي",2,"ح",2,0],["حَتّى اِكتَسى مِثلَ عُيونِ البُردِ","رَوضاً بِمَغنى واهِبِ بنِ فِندِ",3,"د",1,0],["حتّى أُكدِّر عيشَ تِل","ك الأنفسِ الصُّغْرى الغَبِيّه",4,"ي",2,0],["حتّى اكتحَلْتُ بنُورِ غرّةِ قادمِ","عَزَمتْ به عنّي الهمومُ رحيلا",5,"ل",2,0],["حتى أَكلْنا يَدَيْنا","جوعاً فتبَّتْ يَداه",6,"ا",2,0],["حَتّى اِكتَسَت ثَوبَ السَوادِ لِفَقدِهِ","وَتَناوَحَت بِالنَدبِ نوحاً ثَكلا",7,"ل",2,0],["حَتّى أَكُون كَمَن ردّت بِضاعته","إِلَيهِ مِن بَعد يَأس مالهُ أَمَد",8,"د",1,0],["حتى اكتشفنا في أواخِرِ موتِنا","من بعدِ طول ِأسَىً وطول ِعناءِ",9,"ا",2,0],["حتّى أكونَ لما فوّقت من حكمي","في حمير والفتى كهلان ديوانُ",10,"ن",1,0],["حتّى أكادُ لِما قَضى أدري بما","هوَ قبل أَن يبدو الحقيقة واقعُ",11,"ع",1,0],["حتى أكون إذا اسودت وجوههم","ألقى الهي بوجه في المعاد جلي",12,"ل",2,0],["حتى اكتفى وأعادَ كأسَ شرابهِ","مملوءةً بعد المياهِ من الثَّنا",13,"ا",1,0],["حتى أكون على النهج القويم به","خلقاً كريماً بإسعادٍ وإيناس",14,"س",1,0],["حتى اكتسيت من المشيب عمامة","غثراء أعفر لونها بخضاب",15,"ب",1,1],["حتى اكتسبت من القلوب مكانة","عزت فكان لها المقام الأفسح",16,"ح",1,0],["حتى اكتفى فاعاد كاس شرابه","مملوءة بعد المياه من الثنا",17,"ا",1,0],["حتى أكيّف روحي كيفما رغبت","وكي أكيّفَ جسمي كيفما رغبا",18,"ب",2,0],["حتى اكتسبت على المعارف خبرة","صدقت بها عن حالتي اخباري",19,"ر",2,0],["حَتّى اِكتَسَت أَغصانُها","وَاِعتَمَّ هامُ القُضُبِ",20,"ب",1,0],["حتى اكتست من عدله سندسا","ماست به كل الربى والوهاد",21,"د",1,0],["حتّى اكْتَشْفْتُ بها ولمْ أَكُ عالِمًا","أنَّ العَدَالَةَ فِي الجَحِيمِ خَيَالُ",22,"ل",1,0],["حتى اكتسى الروض من تهتانها حللاً","وجلل القوز من تهطالها نمطا",23,"ط",2,0],["حتى اكتوى بِلَهِيْبِ المُبْكِيَاتِ دَمِي","وَغَالَنِي الهمُّ واستشرى بِجَانِحَتِي",24,"ت",2,0],["حتَّى أُكِلْنا بالهوانِ جميعُنا","وغدا الأكولُ بلحمِنا يتجشَّأُ",25,"ا",1,0],["حتى أكاد ومن بؤس يخيل لي","بأن وجها بوجه راح يستتر",26,"ر",1,0],["حَتَّى أَكادَ لِما قَضَى أَدْرِي بِما","هُوَ قَبْلَ أَنْ تَبْدُو الحَقِيقَةُ واقِعُ",27,"ع",1,0],["حتى اكتسى حُلّةً بالنور هيّبةً","كأنه البدر يجلو حالك الظُلَم",28,"م",1,0],["حتّى أكاد أرى الأحداثَ كاذبة ً","وليس إلا خيالا كلُّ ما أجدُ",29,"د",1,0],["حتى اكتملنا بالشعورِ قصائدًا","عصماءَ ترخي شالها المتعطرا",30,"ر",2,0],["حَتَّى أكُونَ صَرِيحًا، الذّكْرَيَاتُ مَعِي","وَتَمْتَماتُ دمِي أَرْسَلْتها نزَفَا",31,"ف",2,0]]}