{"poems":[[65,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[147,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[147,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[457,"ما آل برمك في ذرى بغداد","https://www.aldiwan.net/poem13714.html","الكامل"],[466,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[466,"وصل الجواد من الجواد","https://www.aldiwan.net/poem16175.html","مجزوء الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72295","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141313","الرمل"],[1717,"","https://poetry.dctabudhabi.ae/diwan/poem/147219","الكامل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103221","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28062","الطويل"],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178030","الكامل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2528","الخفيف"],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""]],"verses":[["بِمَضاجِعٍ أًلِفَ العَفافَ بها","كَرَمٌ بِأَذْيالِ التُّقَى عَلِقُ",0,"ق",1,0],["بِمُضمَحِّلٍ مُؤَمِلٍ خَادِعٍ","لأَركُبٍ عَمَّا تَضَمَّنَ القِرَبُ",1,"ب",1,0],["بِمُضَمَّرٍ أَرِنٍ كَأَنَّ سَرَاتَهُ","بَعْدَ الْحَمِيمِ سَبِيكَةٌ مِنْ عَسْجَدِ",2,"د",1,0],["بِمَضائِكَ المُجتاحِ أَم بِقَضائِكَ ال","مُنتاشِ أَم بِعَطائِكَ المُنتابِ",3,"ب",1,0],["بِمَضاءِ عَزمِكَ أَدرَكَ العِزَّ الَّذي","لا يُدَّعى وَبِيُمنِ جَدِّكَ أُيِّدا",4,"د",2,0],["بِمَضائِهِ وَقَضائِهِ وَعَطائِهِ","أَمِنوا الرَدى وَالجَورَ وَالإِمحالا",5,"ل",2,0],["بِمَضائِهِ وَقَضائِهِ وَنَوالِهِ","عَدِموا الرَدى وَالجَورَ وَالإِعداما",6,"م",2,0],["بمضارب كانت لدى افنائها","غيل القَنا ومرابض الآساد",7,"د",1,0],["بمضطرب يُخشى الردى من كسوره","ويَخشى به قلبُ الردى أن يُروعا",8,"ع",2,0],["بمَضاءِ إِقْدامٍ تُظاهِرُهُ","أناةٌ مِنْ سَدادِ",9,"د",1,0],["بمضجع في جنبه","جعلوه في لحد ضجيعه",10,"ع",2,0],["بمضمرة تَفِلُّ ليوثَ هَيجٍ","على صهواتها مُستلمميتا",11,"ت",2,0],["بمضاء دونه حدّ الظّبى","وخلال عطّر الرّبع شذاها",12,"ا",3,0],["بمضيق مُعتركِ الأسا","ور والدمالج والخلاخلْ",13,"ل",1,0],["بِمُضطَمِرٍ قد قطَّعَ السَير صدرهُ","وَفي العَجزِ مِنه والعَلا بيِّ مَمتَعُ",14,"ع",1,0],["بِمُضطَرِبِ الضَفرَينِ مُطَّرِدِ القَرا","طَويلِ الزَمامِ ذي ذِفَرِّ عُراهِمِ",15,"م",1,0],["بمضلة لب الحليم إذا رمت","بالمقلتين كأنها سحار",16,"ر",1,0],["بِمَضيقٍ تَطيرُ فيهِ العَوالي","حينَ هَرَّت كُماتُها وَاِستَحَرَّت",17,"ت",1,0],["بمضاريب لها في وقعها","ما لنبل اللحظ من تحت القسي",18,"س",2,0]]}