{"poems":[[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[74,"قولا لنور الدين عن خله","https://www.aldiwan.net/poem19332.html","السريع"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[53,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[93,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[189,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[196,"فتقت بالهجر دروز الهوى","https://www.aldiwan.net/poem27549.html","السريع"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[234,"شهر الصيام أجل شهر مقبل","https://www.aldiwan.net/poem50852.html","الكامل"],[234,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[286,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[443,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[469,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[520,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[556,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122800","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122561","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66781","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96980","الكامل"],[908,"","https://poetry.dctabudhabi.ae/diwan/poem/199305","السريع"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72276","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77753","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141358","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131591",""],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100467","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53212","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53160","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143109","البسيط"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120161","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100202","السريع"],[3407,"","https://poetry.dctabudhabi.ae/diwan/poem/105102","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48439","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91085","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91074","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67541","البسيط"],[4767,"فعل الضباع","https://www.poetsgate.com/ViewPoem.aspx?id=178912",""],[4767,"الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=180021",""],[4781,"يا حُجَّةً مشهورة في الورى","https://www.poetsgate.com/ViewPoem.aspx?id=107200",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5843,"عذاب في عذاب","https://www.poetsgate.com/ViewPoem.aspx?id=51288",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5963,"آخر ُ الأَلحان","https://www.poetsgate.com/ViewPoem.aspx?id=187414",""],[6142,"يا حجة الله وابن السادة الحجج","https://www.poetsgate.com/ViewPoem.aspx?id=155767",""]],"verses":[["يا حجَةَ الله التي برهانها","عز المحقُّ به وذَلَّ المبطلُ",0,"ل",1,0],["يا حجة الله التي برهانها","ما كان يوماً صدقه مجهولا",1,"ل",2,0],["يا حجريِّ الوصف من نسبة","حقًّا لقد عاملتني بالصفا",2,"ف",2,0],["يا حجة اللَّه التي","لخصيمها السعيُ الأضلُّ",3,"ل",1,0],["يا حجةَ اللَّه والمس","لمينَ والإسلامِ",4,"م",1,0],["يا حِجَّةَ الفُصحى وَدُهقانَها","وَبَحرِها الطامي وَشَيخَ الثُقات",5,"ت",1,0],["يا حِجَّةً وَقَفَت مِصرٌ تُوَدِّعُها","خُذي مَكانَكِ خَلفَ الدَهرِ أَو زولى",6,"ل",2,0],["يا حجة الله على خلقه","يا من هو المصدر والمورد",7,"د",1,0],["يا حجةَ الله التي وجبَتْ على","أهلِ الزمانِ بفَرْعِها وبأصلها",8,"ل",3,0],["يا حجةَ اللهِ التي أبدتْ لنا","بكمالها الآياتِ والبرهانا",9,"ن",2,0],["يا حَجزَةَ النَفسِ وَيا ذيلُها","ما لي مِن وَصلِكَ مِن بد",10,"د",1,0],["يا حُجّةً فلَجَتْ لِلّه واتّضحَتْ","حتى اهتدي بسَنَا برهانِها الأمم",11,"م",1,0],["يا حُجّة الرحمانِ عند عباده","وشِهابَهُ في كلّ أمرٍ مُشْكِلِ",12,"ل",1,0],["يا حجّة الله التي أشرقتْ","فينا ويا صاحبَ كَنْز الجِدار",13,"ر",1,0],["يا حجةَ الإسلام فيما أظهرتْ","أحكامُه أو بيَّنت فتواه",14,"ا",2,0],["يا حجّة الدين يا قاضي القضاة ويا","باني المعالي بتاسيس وتشييد",15,"د",1,0],["يا حجة العرب الذين تخرّموا","يا فهمها إمّا يغصُّ المجمع",16,"ع",1,0],["يا حجة الله التي بضيائها","هديت بصيرة حائر عن قصده",17,"د",2,0],["يا حججَ اللَّهِ عَلى خلقهِ","ومَن بهم أبصَرَ من أبصَرا",18,"ر",2,0],["يا حُجَةَ اللهِ والشَّمسَ الَّتي طَلَعَت","عَلَى البَريَّةِ مِن مُسوَدّةِ العَينِ",19,"ن",1,0],["يا حُجَّةَ اللهِ على خَلقِه","إن جَنحَ الخَلقُ إلى الاحتجاج",20,"ج",1,0],["يا حجةَ اللهِ الجليل","لِ وعينَه وزعيمَ آلِهْ",21,"ل",2,0],["يا حجة اللَه التي بلغت إلى ال","أقصى وحكمته التي لا تقعل",22,"ل",1,0],["يا حجة الله أبا جعفر","وابن البشير المصطفى المنذر",23,"ر",1,1],["يا حجة اللّه يا من يستضاء به","إلى الهداية يا من طاب مولده",24,"د",2,0],["يا حجراً تقبيلها بالسِّر","يا عرفات يا منى للنحر",25,"ر",1,0],["يا حجةّ القانون يا ابن الألى","في كلّ صقعٍ منهم فرقد",26,"د",1,0],["يا حجاب هيبة الله ظل الخارقون","تلك بالراي والرأي أسفاه",27,"ه",1,0],["يا حجة الرحمن هل من وثبةٍ","تقتادني فيها وهل لي موسم",28,"م",1,0],["يا حجة الله الذي طاعته","وحبه فرض على كلِّ الأمم",29,"م",1,0],["يا حجة الله التي برهانها","بادٍ لعين الناظر المتوسم",30,"م",1,0],["يا حجة الله الذي برهانها","كالصبح يعرفها الذي يتأمل",31,"ل",1,0],["يا حُجَّةَ الله التي وَضُحَتْ","آياتها وأتت بها النذر",32,"ر",1,0],["يا حجة الدين سر باللّه معتصماً","ولا تكن لفراق حم ذا أسف",33,"ف",1,1],["يا حجة الدين من يبنى دعائمه","للمسلمين إذا بنيانه انهدمَ",34,"م",1,0],["يا حجة اللَّه على خلقه","وصاحب القدر الرفيع العلي",35,"ي",1,1],["يا حجة فينا وكم من حجة","قامت به يهدي الأنام منارها",36,"ر",3,0],["يا حُجّةً قامَتِ الدنيا بصحَّتِها","في طيّها حُجَجُ الأمْلاكِ تندرِجُ",37,"ج",1,0],["يا حجةَ اللَه إِني جئت ملتجئاً","عَسى يَصحُّ فُؤاد بِالهَوى مرضا",38,"ض",2,0],["يا حجة الديان ما لي حجةٌ","إلا الوقوف بذلةٍ وتأدّب",39,"ب",1,0],["يا حجة الله في الأرزاق والقسم","وعبرة لأولى الألباب والهممِ",40,"م",1,1],["يا حِجر لا تحفل بِما جاؤوا فقد","جاؤوا على ظهرٍ من الأوهام",41,"م",1,0],["يا حجة اللهِ يكفي الناسَ داهيةً","فمِدية الحقدِ في الأحشاء لم تَلِنِ",42,"ن",1,0],["يا حُجَّةً مشهورة في الورى","وطودَ عِلم أعجز المرْتَقى",43,"ق",2,1],["يا حجة الله بين السيف والقلم","أدرك يراعك بين الشوط واللجم",44,"م",1,0],["يا حجة الله بين العلم والحكم","أدرك طروسك بين الظلم والظلم",44,"م",1,0],["يا حجة الله بين الرعب والعلم","أدرك لواءك بين الحرب والسلم",44,"م",1,0],["ياحجاب لمني فالهوى والحب تكفى ياحجاب","عشان اطيعك واحتسب لومك ولونه شحوب",45,"ب",1,0],["يا حجة الله على عباده","من بعد آل المصطفى أهل الكسا",46,"ا",1,0],["يَا حُجَّةَ الأَنْوَارِ .. لَمَّا يَدَّعِيْ","كَسْبَ الجِدَال ِ ، ظَلامُهَا المُتَطَرِّفُ !",47,"ف",1,0],["يا حجة الله وابن السادة الحجج","عطفاً على أممٍ مذعورة المهج",48,"ج",1,1]]}