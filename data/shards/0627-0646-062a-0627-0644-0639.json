","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[5694,"تريحي","https://www.poetsgate.com/ViewPoem.aspx?id=132099",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5720,"مَاذَا يُرِيْدُ الحَاقِدُونَ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=200254",""],[5720,"أنتَ الإِلٰهُ","https://www.poetsgate.com/ViewPoem.aspx?id=201610",""],[5732,"يا سيفنا القطاع","https://www.poetsgate.com/ViewPoem.aspx?id=177833",""],[5829,"يا ضيعة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=152676",""],[5843,"طيحة عزيز .! ولا وقوف إمتمايل.!","https://www.poetsgate.com/ViewPoem.aspx?id=51298",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5943,"حاورتُها","https://www.poetsgate.com/ViewPoem.aspx?id=41600",""],[5956,"أرجوك يا أرتين تحقيق المنى","https://www.poetsgate.com/ViewPoem.aspx?id=202208",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[5956,"أ نَسِيتَ يا قيسٌ مُحِبك خالدا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215382",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6093,"أنت العميد ولا عميد سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=209054",""],[6125,"في ضَيِّ عينيكِ القصيدُ تَبَعثَرا","https://www.poetsgate.com/ViewPoem.aspx?id=210971",""],[6125,"يَغْفو على راحِ القَصِيدِ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=212868",""],[6147,"أنا ودليلتي.. والطريق..","https://www.poetsgate.com/ViewPoem.aspx?id=151496",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""]],"verses":[["أَنتَ العُلى فَلِقَصدِها ما أَقتَني","مِن جَوهَرٍ وَلِمَدحِها ما أَنظِمُ",0,"م",1,0],["أَنتَ العَليلُ فَلُذ بِهِ","مُستَشفِياً وَاِغنَم نَوالَه",1,"ل",2,0],["أنتَ العليمُ بِما أُريدُ وأَبْتَغي","وَبِما أكابِدُ مِن أذىً وَعِنادِ",2,"د",1,0],["أنت العليمُ فَصِفْ لنا حُكمَ الهَوى","وتَوجُّعَ الوِجدانِ كيفَ يُطاقُ",3,"ق",1,0],["أَنتِ العَروس دنا زَمانُ زفافها","لِلَّه ذلك مِن زَفاف داني",4,"ن",2,0],["أَنْتْ الْعَزِيزَةُ فِي الْقُلُوبِ مَكَانُكِ","لاَ عُزَّ يَا حَسْنَاءُ مَنْ يَشْنُوكِ",5,"ك",1,0],["أَنْتَ الْعَزَاءُ وَجلَّ مَا تُرجى لهُ","فِي نَفْعِ قَوْمِكَ وَالْبَقَاءُ مَدِيدُ",6,"د",1,0],["أَنتَ العِمادُ لِأَقوامٍ بِكَ اِعتَصَموا","تَيَمُّناً وَحَوالي عَرشِكَ اِعتَصَبوا",7,"ب",3,0],["أنْتَ العَطُوفُ إذا ما ضاقَ مُنْكَسِرٌ","أنت الدَّواءُ إذا ما شَاعَتِ العِلَلُ",8,"ل",1,0],["أنت العليم بكلّ ما","تعيا به فِطَن العليم",9,"م",1,0],["أنت العزيزُ الذي عَزّتْ بدَولتِه","معالِمُ الدينِ واستعلَى به الأملُ",10,"ل",1,0],["أنت العزيزُ الذي لو لا خلاَفَتُهُ","ما أصبحَ العدلُ منشوراً على البشر",11,"ر",1,0],["أنتِ العظيمةُ فوقَ الرملِ نائمةً","أنتِ الكريمةُ في أيام بؤساك",12,"ك",1,0],["أنتِ العفيفةُ واللذاتُ سائحَةٌ","أنتِ الظريفةُ والزهراءُ مغناك",12,"ك",1,0],["أنت العماد الذي ما زال معتلياً","بحيث للنجم في مرقاه تأميل",13,"ل",1,0],["أنت العزيزُ فَمُرِ الدَّهْرَ إذنْ","يُوفِ لنا الكَيلَ ولا يُطَفِّف",14,"ف",1,0],["أَنتَ العَدُوُّ لِأَمرٍ أَنتَ جاهِلُهُ","فَلِم يَقالُ صَديقُ المَرءِ عاذِلُهُ",15,"ل",2,1],["أنت العَيِيُّ على مَا فيكَ من لَسَنٍ","عَن لاَ وأفصحُ خلقِ اللهِ في نَعَمِ",16,"م",1,0],["أنت العليم بما يأتي الزمان به","وأنت بالدهر والأيام معترف",17,"ف",1,0],["أنت العلي بل العظيم الواحد ال","أحد الكبير الماجد الباقي الثنا",18,"ن",2,0],["أنت العليم بحالي إنني رجل","من خوفك اللَه في حزن وفي وصب",19,"ب",1,0],["أنت العلي كبدر","في الأفق تسمو سموه",20,"و",2,0],["أنت العدم في وجودُهْ يا أسير البينْ","وجود واحدْ أحدْ يمكنْ يكون اثنينْ",21,"ن",1,0],["أنت العليم بحالي والبصير به","يا مالك الملك يا رب السلاطين",22,"ن",1,0],["أنتَ العِمادُ لأرضِنا ولمُلكِها","من بعدِ ربِّ المُلكِ منكَ دعائِمُ",23,"م",1,0],["أَنت العزيزُ على العُيو","نِ ودَمْعُها الماءُ المَهِينُ",24,"ن",1,0],["أَنت العظيمُ ولَيْسَ تَمْ","لأُ صدْرَك النُّوَبُ العِظامُ",25,"م",1,0],["أنتَ العظيمُ لدى الإلاهِ شَفاعةً","وأجلُّ مَخلوقٍ عَلاَ مِقْدَارَا",26,"ر",2,0],["أنت العظيمُ وإن همْ","نادوك باسمٍ مُصغر",27,"ر",1,0],["أنت العزيز القدير المستعد إلى","حلّ الخطوب إذا ما عقدها اشتكلا",28,"ل",2,0],["أَنتَ العَزيز فَما لمالك في الهَوا","ن يظل مَلقى وَالعَطايا تنهب",29,"ب",1,0],["أنت العظيم القدر إذ جاء الثنا","ينلا ينص في الكتاب مردد",30,"د",1,0],["انت العليم بما جرى يا قابض","قأقبض اكف المعتدى بنكال",31,"ل",1,0],["انت العلى كذا الكبير فعاملن","بالفضل واحفظ يا حفيظ ووال",31,"ل",1,0],["أنت العفو انت الرؤف ومالك الملك","ارحمن واعطف بحسن نوال",31,"ل",1,0],["أنت العزيز على التداني والنوى","وبنوك في كل الأمور كرام",32,"م",1,0],["أنت العميدُ وحبَّذا","بدمي النقا ولعُ العميدِ",33,"د",1,0],["أنتَ العليمُ الذي قسمت اقفزة","حبّ العقولِ فمن مُدٍّ ومن صاعٍ",34,"ع",1,0],["انت العليم بذا الضريح ومن به","فارحمه يا من للخلائق يرحم",35,"م",1,0],["أنتَ العَلَيمُ بِهِ وَقَد أنشَأتَهُ","مِن تُربَةٍ هِيَ أضعَفُ الأركَانِ",36,"ن",1,0],["أنت العزاء لنا والحرز إن نزلت","بنا الخطوب ولم نأمن بوائقها",37,"ق",3,0],["أنت العصاميُّ الذي ضمنت له","عزماتُه في العمر كل منال",38,"ل",1,0],["أنت العليم بما ينا","وبني به الداءُ الدفين",39,"ن",1,0],["أَنتَ العِماد لَها فَلا عَجب إِذا","سَأَلت يَديك شَرابَها وَطَعامَها",40,"م",3,0],["أَنتَ العَزيز فَمَن يقاومكَ اغتدى","وهو الذَليلُ الهَيِّنُ المَخروقُ",41,"ق",1,0],["أَنتَ العَظيم همامَةً","أَنتَ الهمامُ المصمئلُّ",42,"ل",1,0],["أنت العماد لكل عا","ئدةٍ ترجى والملاك",43,"ك",1,0],["أَنتَ العَروسُ لَها جَمالٌ فائِقٌ","لكِنَّها في كُلِّ يَومٍ تُصدَعُ",44,"ع",1,0],["أنت العماد لفهر والدعام لها","لولاك ما كان سمك المجد مدعوما",45,"م",2,0],["أنت العياذ الملاذ المستجار به","عند الكروب اذا ما ريحها عصفا",46,"ف",2,0],["أنت العياذ اذا ما بالعباد احا","ط الخطب والكرب بالبأسا لهم لأظا",47,"ظ",2,0],["أنت العليُّ الَّذي قد جلَّ وصفك عن","مدحي وَلَم تجزهِ بالكون أَسفارُ",48,"ر",1,1],["أَنتَ العَزيزُ الأَعزُّ","وَأَنتَ نعم الكنزُ",49,"ز",1,0],["أَنتَ العَفيفُ الحَنيفُ","وَالعارِفُ المَعروفُ",49,"ف",1,0],["أ