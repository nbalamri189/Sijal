955,"لما دعته أبى وقال دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=187723",""],[5092,"مجدُ العراقِ صدّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=179338",""],[5127,"هلاّ بعثتِ إلى الفؤادِ رسوﻻ؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=177331",""],[5136,"رق قلبي ومدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121941",""],[5190,"يا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=123994",""],[119,"أواه من ألم الفراق لأنه","https://www.poetsgate.com/ViewPoem.aspx?id=26001",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[5343,"عجزت عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=132536",""],[5533,"ظُلْمُ الإخْوَة","https://www.poetsgate.com/ViewPoem.aspx?id=176386",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5593,"لك وجه كأن يمناي خط","https://www.poetsgate.com/ViewPoem.aspx?id=181035",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5757,"برقيّةٌ إلى المتنبّي","https://www.poetsgate.com/ViewPoem.aspx?id=59801",""],[5952,"ولّاعتان","https://www.poetsgate.com/ViewPoem.aspx?id=210376",""],[5956,"الذكرى الخالدة لوحدة الجمهورية العربية المتحدة","https://www.poetsgate.com/ViewPoem.aspx?id=193991",""],[5956,"نُواح الكون على محمد عبده يماني","https://www.poetsgate.com/ViewPoem.aspx?id=194549",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[5977,"أجمل صحبة","https://www.poetsgate.com/ViewPoem.aspx?id=213063",""],[469,"ولا يصدنك عن شيء ترفعه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574825",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["لَم يَشفَعِ الدَهرُ الخَؤونُ لِمُهجَةٍ","في العُمرِ إِلّا عادَ وَهوَ خَصيمُها",0,"م",3,0],["لَم يَشتَمِل قَلبي الرَجاءَ وَلَم يَكُن","طَرفي جَنيبَةَ كُلِّ بَرقٍ نائِرِ",1,"ر",1,0],["لَمْ يَشِنْهُ المَعْنى العَويصُ وَلا لَفْ","ظٌ يَكِدُّ الأَسْماعَ مُرُّ المَذاقِ",2,"ق",1,0],["لَمْ يَشِنْها إِجازَةٌ وَسِنادٌ","وَحَلَتْ إِذْ خَلَتْ مِنَ الإصرافِ",3,"ف",1,0],["لَم يَشرَبوا غَيرَ الهَوى فَكَأَنَّهُم","بِهِمُ لِشِّدَةِ ما لَقوا سُكرُ",4,"ر",1,0],["لَم يَشفِ مِنكَ العَينَ أَوَّلُ نَظرَةٍ","لَولا المَهابَةُ راجَعَت تَزدادُ",5,"د",1,0],["لَمْ يَشْهَدِ النُّدْمَانُ عَدْلِيَّا إذَا","رُفِعَ الوَقَارُ بمَجْلِسِ النُّدَمانِ",6,"ن",1,0],["لِمَيّ شَكَوتُ الحُبَّ كَيما تُثيبُني","بِوُدّي فَقالَت إِنَّما أَنتَ تَمزَحُ",7,"ح",1,0],["لم يَشْفِهِمْ كدُّ الطبي","بِ ولا عنايتُهُ المُكِبَّهْ",8,"ب",2,0],["لم يشهد الفتحَ ولا سيَّلتْ","طعنتُهُ من دمها قطرهْ",9,"ر",2,0],["لم يُشمتِ اللَّهُ فيه","لئامَهم بالكرامِ",10,"م",1,0],["لَم يَشعُرِ اللَيثُ إِلّا","وَمُلكُهُ في دَمارِ",11,"ر",1,0],["لَم يَشُب مُهَذَّبَها","باطِلٌ وَلا فَنَدُ",12,"د",1,0],["لم يَشهَدِ البَينُ تُبدي ما يغيِّبُه","إلا وإشهادُنا من خيره غَيَبُ",13,"ب",1,0],["لَم يُشغَلِ المَوتُ عَنّا مُذأُعِدَّ لَنا","وَكُلُّنا عَنهُ بِاللَذاتِ مَشغولُ",14,"ل",1,0],["لَم يَشقَ يَوماً بِكَ الجَليسُ وَلا","مَسَّ نَداماكَ عِندَكَ النَدَمُ",15,"م",1,0],["لَم يَشهَدا نَجوى وَلا حَشّا لَظى","حَربٍ تُسَعَّرُ بِالقَنا المتَقَصِّدِ",16,"د",1,0],["لَم يَشعُروا حَتّى طَلَعتَ عَلَيهِم","بَدراً يَشُقُّ الظُلمَةَ الحِنديسا",17,"س",2,0],["لم يَشْفِ جَهْدُ القولِ منْهُ وإنّني","رَهْنٌ بهِ وكفيلُهُ كرهِينِهِ",18,"ن",2,0],["لم يُشرِكوا في أنّهُ خَيرُ الوَرَى","ولِذي البَريّةِ عندهُمْ شُركاء",19,"ا",2,0],["لَم يَشعُروا بِرَسولِ اللَهِ بَل شَعَروا","ثُمَّ اِستَحالوا ضَلالاً بَعدَ إِرشادِ",20,"د",1,0],["لَم يَشفِ قَلبَكَ فُرقانٌ وَلا عِظَّةٌ","وَآيَةٌ لَو أَطَعتَ اللَهَ تَشفيكا",21,"ك",2,0],["لَم يشجني في كل ما","شاهدت شيء في حَياتي",22,"ي",1,0],["لَمْ يَشْغَلِ الْخَطْبُ فِكْرَ أَدْمَا","وَسْنَى وَلَمْ يَعْرُهَا الحِذَارْ",23,"ر",1,0],["لَمْ يُشَفِّعْهُمْ لَديْهِ أَنَّهُمْ","أَعلَقُ النَّاسِ بِهِ قُرْبَى وَصِهْرَا",24,"ر",2,0],["لَمْ يَشُقْني يَوْمُالقِيامَةِ، لَوْلا","أمَلي أنّنيهُنَاكَ أرَاهَا",25,"ا",3,0],["لَمى شَفَةِ المَحبوبِ أَو وَردُ خَدِّهِ","مَدى أَمَلى لَو تَمَّ لي ما أَؤمّلُ",26,"ل",1,0],["لم يُشْبِهُوا الإِنسانَ في خَلَّةٍ","وأَشْبَهُوا الْحَيَّاتِ والأَسْبُعا",27,"ع",2,0],["لَمْ يُشاهِدْ سِواهُ بَعْدَ ابْنِ دَا","وُدَ سَناً مُشْرِقاً وَمُلْكاً عَتِيدا",28,"د",2,0],["لم يُشْفَ بالدَّمْعِ عليلُ الفِراقُ","إذ شَيَّعَ الظَّعْنِ بِدَمْعٍ مُراقْ",29,"ق",1,1],["لم يَشِنْهَا على المتاع صِرَاعٌ","أو تُشَوِّهُ جمالَها الشحناءُ",30,"ا",2,0],["لم يشهد الله قلب لا لهيب به","ويشرق الله في القلب الذي التهبا",31,"ب",2,0],["لم يشنه في ناظري أن عداه","زخرف في بنائه ورواء",32,"ا",2,0],["لَم يشن جِسمي النَحول وَلَكن","زادَني الحُب رفعة بِاِنتِحالي",33,"ل",2,0],["لم يشتغل فكري","واللب لولاه",34,"ا",2,0],["لم يشفه إلا اللقا لكنه","يخفيه خوف شماتة الأعداء",35,"ا",2,0],["لم يُشبهوا الإنسانَ إلا أنهم","متكوّنون من الحَما المسنونِ",36,"ن",1,0],["لم يَشربِ المحزونُ منها قَطرةً","إلاّ تدرّعَ هزّةَ المُرتاحِ",37,"ح",1,0],["لَم يُشوِ رامي البَينِ حَبَّةِ قَلبِهِ","لَمّا رَمى عَمداً بِقَوسِ عِدائِهِ",38,"ا",3,0],["لَم يَشكُلِ الخَيلَ مُذ جالَت بِشَكلَتِهِ","إِلّا بِشَعرِ لِحى الأَبطالِ وَاللِّمَمِ",39,"م",1,0],["لم يَشدُ إلّا باسعِها وجمالِها","وبغير وحيِ ضميره لم يَصدَعِ",40,"ع",1,0],["لم يَشْفِني غير مَلْقى السَيّدِ الفَهِمِ","ابنِ السَيدِ الفهمِ ابنِ السَيّدِ الفَهمِ",41,"م",1,0],["لم يشتغل بعلوم عن فرائضه","بل أتعبت كاتب اليمنى نوافله",42,"ل",2,0],["لَم يُشَب وَعدُهُ بِمَط","لٍ وَلا جودُهُ بِمَن",43,"ن",1,0],["لم يَشِن بَيتَهُ زحافٌ ولا بَس","طُ يديهِ يومَ النَّدى مَقبُوضُ",44,"ض",1,0],["لم يشهدوا في هواه الصرف إلّا هو","قامت بهم حيث قاموا حين قالوا هو",45,"و",1,0],["لَمْ يَشْرُف الشِّعر إِلا حِينَ شَرَّفَهُ","نَظْماً لِعَالِيهِ أَوْ سَمعْاً لِغَالِيهِ",46,"ي",2,0],["لَم يَشكُ عُدوانَ صَرفِ الدَهرِ مِن أَحَدٍ","إِلّا إِلَيهِ وَأَشكاهُ وَأَعداهُ",47,"ا",2,0],["لم يشعروا بوجودي","ولم يحسوا بيأسي",48,"س",2,0],["لم يَشْعروا حتّى طرَقْتَ كأنّما","حَوَّلْتَ في الحَدَقِ الخَيال خُيولا",49,"ل",2,0],["لم يَشْدُدِ الفَلَكُ المُدارُ نِطاقَه","إلاّ ليَسْمعَ طائعاً وتَقولا",49,"ل",2,0],["لم يُشْجِ قَلبِي مِلْحوادِثِ إِل","لاَ صاحِبي المَتْرُوكُ في تَغْلَمْ",50,"م",1,0],["لَم يَشتَرِ الناسُ وَلا باعوا","خَيراً من الخُبزِ إذا جاعوا",51,"ع",3,1],["لم يُشبِعوه ولم يُرْووه من ظمأٍ","ولم يعينوه حتى يبْتني دارا",52,"ر",2,0],["لَمْ يَشْفِ طيفُكَ لما زارني أَلَمَا","وإِنما زادَني إِلْمَامُهُ لمَمَا",53,"م",2,1],["لم يَشْدُ في العشاق حادي شوقهم","إلا وحثّهم الحطيم وزمزمُ",54,"م",1,0],["لم يشكها شجر أو طائر غرد","ولا أزاهير من ميراث نيسان",55,"ن",1,0],["لم يشرفِ الدرُّ لولا هجرُ موطنهِ","والبدرُ ما تمَّ حتى جدَّ في الطلب",56,"ب",1,0],["لم يشف إسقاط قسطنطين غلتها","ولا اشتهار فنيزيلوس بالخطب",57,"ب",1,0],["لم يشرب العشاق من بحر الهوى","إلا بغية مقلتي من عطفتي",58,"ت",2,0],["لم يشرب الماء من حقد ومن حسد","إلا الأخلا وهو مبتسم",59,"م",1,0],["لم يشربوا إلّا كؤوسَ قِسِيّهِمْ","أَو يَطعموا إلّا لحومَ المأْزقِ",60,"ق",1,0],["لم يشتغل عن بعضها بالبعض بل","في كل شيء لم يزل متمكنا",61,"ن",2,0],["لم يُشاهِد حسْنَه غيري ولم","يبْقَ في الدَّير سِوى المشهودِ فيّ",62,"ي",1,0],["لَمْ يَشْعُرُوا بِغُرُوبِ الشَّمْسِ إِذْ سَفَرَتْ","عَنْ وَجْهِهَا فَأَضَاءَ السَّهْلُ وَالجَبَلُ",63,"ل",1,0],["لم يشهدوا ذلك ولم يشاوروا","وكيف قاموا دونهم فاستاثروا",64,"ر",3,0],["لم يُشد في العِراقِ كسرى مَعالي","كَ ولا شادَ في عُمانَ الجَلَندا",65,"د",2,0],["لم يشكروا لمحمدٍ إنعامَهُ","أفيشكرونَ لغيرِهِ إن أنعما",66,"م",2,0],["لم يشد مقوله ما شاد لو","لم يكن في حده السر المطلسم",67,"م",1,0],["لم يَشْقَ في سَنَنِ التُّراب وإنّما","يَستنُّ بين أناملٍ أتْرابِ",68,"ب",1,0],["لم يَشْتَمِلْ بِدَمٍ غِرارُ مُهَنَدٍ","إلاَّ وقد أَهْدَى النُفُوسَ إلى الرَّدَى",69,"د",2,0],["لم يشترط في الجود غير قبوله","ورضا بلاد برة وعباد",70,"د",1,0],["لم يشفع الشفعاء فيكم مثلما","عذل الظلوم الحاسبون ولاموا",71,"م",3,0],["لم يشك جدباً ولا فقراً فتعوزه","من غير خالقه الأنواء والسحب",72,"ب",1,0],["لم يُشْفِقِ الله على بَدْرِهِ","حينَ بَرَاهُ لا ولا شَمْسِه",73,"س",2,0],["لَم يُشبِهُوهُ وَإِنّه لَرئِيسُهم","لَيسَ الرّئيس كَمِثل مَن لَم يَرئسِ",74,"س",1,0],["لم يَشِنْهُ ذكُر السَّبَاسِبِ والوَصْ","فُ لعيسِ تَحْتَ الرِّحال جَمُوز",75,"ز",1,0],["لم يشفه غيرُ مِصْداقٍ يبشره","بساعةِ الوصلِ من ذاتِ الدماليج",76,"ج",1,0],["لم يشفِه غيرُ محبوبٍ أخي حسَبٍ","صافى الوداد صدوق غير مذّاقِ",77,"ق",1,0],["لم يشنف سمعي سوى صوت داع","طبقت دعوة له الآفاقا",78,"ق",2,0],["لَم يَشعروا قطّ إلّا بالصواعقِ من","وقعِ الصوارم بالهاماتِ والقممِ",79,"م",1,0],["لَم يشعروا قط إِلّا وهيَ مقبلةٌ","تهوي بكلّ فتىً بالدرع مدّججِ",80,"ج",1,0],["لَم يشم غيث ندىً مِن جودِكم","مُسبلاً إلّا أَتى مُنتَجعا",81,"ع",2,0],["لَم يَشعُروا إِلّا وَأَسدادُ الرَدى","ضُرِبَت عَلَيهِم مِن قَناكَ وَخَندَقُ",82,"ق",1,0],["لَم يَشتمل غَير ثَوب السقم بعد حلى","مِما يشاكله فيها نَما وَنشا",83,"ش",2,0],["لَم يَشرَبِ الماءَ ولَم يَخشَ الظَّمَا","يَكفِيهِ مِن قَارِصَةٍ مَا يَمَّمَا",84,"م",2,0],["لم يشجني ذكر أحباب بذي سلم","ولا جرى مدمعي شوقاً إلى أضم",85,"م",1,1],["لم يشترك غير عاقل خبلك","وعاجز لم تنل بهِ املك",86,"ك",1,0],["لَم يُشبِ الدَهرُ لَها مَفرِقاً","أَخرَجَها مِن دَنِّها بِنتَ عامِ",87,"م",1,0],["لم يُشف من هذه الصدور سوى","كسركَ صدر القنا بمُوغرها",88,"ر",3,0],["لم يشف أعداه مثل القتل فابتدرت","تجري على جسمه الجرد المحاضيرا",89,"ر",2,0],["لم يُشَبَّه نعيمهُ بنعيمٍ","كان أشهى أُمنيةَ الإنسانِ",90,"ن",1,0],["لم يشبه ولم يماثله شيء","مالكُ الملك لم يشاركه ثانِ",90,"ن",1,0],["لم يشاركه تعالى في الذي","كان فيهِ وهوَ فيه مستتر",91,"ر",1,0],["لم يشجني طلل الديار الأبكم","كلا ولا رسماً بها أتوسم",92,"م",1,1],["لم يشب عزمك المشيب فأنت ال","نسر ما زلت تستجدُّ الشبابا",93,"ب",2,0],["لم يشم إلا بروقاً أشرقت","في بروق أو بحور في أضا",94,"ض",2,0],["لم يشعرنَّ في الهوى","وقاتِلي إذا شَعَر",95,"ر",1,0],["لم يشك هواه لغير ذاتك دوماً","إذ انك ادرى بحاله وبما ذاق",96,"ق",1,0],["لَم يُشبِهِ العُلَمَاءَ إلاَّ أنتُمُ","أشبَهتُمُ العُلَمَاءَ فِي الأذقَانِ",97,"ن",1,0],["لم يشكروا نعماك إذ غمطوا","نعماك