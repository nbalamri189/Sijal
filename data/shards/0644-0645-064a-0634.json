{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[63,"كلماتي قلائد الأعناق","https://www.aldiwan.net/poem45891.html","الخفيف"],[63,"وقواف ملس المتون شداد","https://www.aldiwan.net/poem46093.html","الخفيف"],[55,"يا هجر كف عن الهوى ودع الهوى","https://www.aldiwan.net/poem26307.html","الكامل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[30,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[51,"يا لهف نفسي للأحبه","https://www.aldiwan.net/poem8185.html","مجزوء الكامل"],[51,"أبو علي ابن أبي قره","https://www.aldiwan.net/poem62911.html","السريع"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[85,"الليث ملك القفار","https://www.aldiwan.net/poem8036.html","المجتث"],[85,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[61,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[49,"طول التعاشر بين الناس مملول","https://www.aldiwan.net/poem63048.html","البسيط"],[66,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[44,"يا دهر قدك وقلما يغني قدي","https://www.aldiwan.net/poem30317.html","الكامل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[46,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43652","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[107,"أسقمتني جفونه ومكاني","https://www.aldiwan.net/poem16557.html","الخفيف"],[113,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[113,"أواه من ألم الفراق لأنه","https://www.aldiwan.net/poem42152.html","الكامل"],[140,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[164,"ارغب بسمعك عن مقال اللاحى","https://www.aldiwan.net/poem47103.html","الكامل"],[167,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[167,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[195,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[210,"يا حادي العيس قف بالجزع والعلم","https://www.aldiwan.net/poem37834.html","البسيط"],[220,"يهيم قلبي بمن رقت شمائله","https://www.aldiwan.net/poem55412.html","البسيط"],[233,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[248,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[257,"أهل المحبه بمجلى اسمه تاهوا","https://www.aldiwan.net/poem34873.html","المواليا"],[273,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[280,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[340,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[362,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[366,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[390,"لم يشتر الناس ولا باعوا","https://www.aldiwan.net/poem53506.html","الوافر"],[397,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[429,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[443,"كل بأودية المدينة مغرم","https://www.aldiwan.net/poem23813.html","الكامل"],[451,"دور من القدم الغالي مجللة","https://www.aldiwan.net/poem61368.html","البسيط"],[462,"أركض جياد الصبي في حلبة اللعب","https://www.aldiwan.net/poem3615.html","عموديه"],[477,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[480,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[480,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[549,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[556,"مالي لقد أصبحت من نيل المنى","https://www.aldiwan.net/poem33789.html","الكامل"],[557,"كشف المحبوب عن قلبي الغطا","https://www.aldiwan.net/poem69334.html","الرمل"],[565,"لما رأيت مطاياهم معقلة","https://www.aldiwan.net/poem69541.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَم يَشفَعِ الدَهرُ الخَؤونُ لِمُهجَةٍ","في العُمرِ إِلّا عادَ وَهوَ خَصيمُها",0,"م",3,0],["لَم يَشتَمِل قَلبي الرَجاءَ وَلَم يَكُن","طَرفي جَنيبَةَ كُلِّ بَرقٍ نائِرِ",1,"ر",1,0],["لَمْ يَشِنْهُ المَعْنى العَويصُ وَلا لَفْ","ظٌ يَكِدُّ الأَسْماعَ مُرُّ المَذاقِ",2,"ق",1,0],["لَمْ يَشِنْها إِجازَةٌ وَسِنادٌ","وَحَلَتْ إِذْ خَلَتْ مِنَ الإصرافِ",3,"ف",1,0],["لَم يَشرَبوا غَيرَ الهَوى فَكَأَنَّهُم","بِهِمُ لِشِّدَةِ ما لَقوا سُكرُ",4,"ر",1,0],["لَم يَشفِ مِنكَ العَينَ أَوَّلُ نَظرَةٍ","لَولا المَهابَةُ راجَعَت تَزدادُ",5,"د",1,0],["لَمْ يَشْهَدِ النُّدْمَانُ عَدْلِيَّا إذَا","رُفِعَ الوَقَارُ بمَجْلِسِ النُّدَمانِ",6,"ن",1,0],["لِمَيّ شَكَوتُ الحُبَّ كَيما تُثيبُني","بِوُدّي فَقالَت إِنَّما أَنتَ تَمزَحُ",7,"ح",1,0],["لم يَشْفِهِمْ كدُّ الطبي","بِ ولا عنايتُهُ المُكِبَّهْ",8,"ب",2,0],["لم يشهد الفتحَ ولا سيَّلتْ","طعنتُهُ من دمها قطرهْ",9,"ر",2,0],["لم يُشمتِ اللَّهُ فيه","لئامَهم بالكرامِ",10,"م",1,0],["لَم يَشعُرِ اللَيثُ إِلّا","وَمُلكُهُ في دَمارِ",11,"ر",1,0],["لَم يَشُب مُهَذَّبَها","باطِلٌ وَلا فَنَدُ",12,"د",1,0],["لم يَشهَدِ البَينُ تُبدي ما يغيِّبُه","إلا وإشهادُنا من خيره غَيَبُ",13,"ب",1,0],["لَم يُشغَلِ المَوتُ عَنّا مُذأُعِدَّ لَنا","وَكُلُّنا عَنهُ بِاللَذاتِ مَشغولُ",14,"ل",1,0],["لَم يَشقَ يَوماً بِكَ الجَليسُ وَلا","مَسَّ نَداماكَ عِندَكَ النَدَمُ",15,"م",1,0],["لَم يَشهَدا نَجوى وَلا حَشّا لَظى","حَربٍ تُسَعَّرُ بِالقَنا المتَقَصِّدِ",16,"د",1,0],["لَم يَشعُروا حَتّى طَلَعتَ عَلَيهِم","بَدراً يَشُقُّ الظُلمَةَ الحِنديسا",17,"س",2,0],["لم يَشْفِ جَهْدُ القولِ منْهُ وإنّني","رَهْنٌ بهِ وكفيلُهُ كرهِينِهِ",18,"ن",2,0],["لم يُشرِكوا في أنّهُ خَيرُ الوَرَى","ولِذي البَريّةِ عندهُمْ شُركاء",19,"ا",2,0],["لَم يَشعُروا بِرَسولِ اللَهِ بَل شَعَروا","ثُمَّ اِستَحالوا ضَلالاً بَعدَ إِرشادِ",20,"د",1,0],["لَم يَشفِ قَلبَكَ فُرقانٌ وَلا عِظَّةٌ","وَآيَةٌ لَو أَطَعتَ اللَهَ تَشفيكا",21,"ك",2,0],["لَم يشجني في كل ما","شاهدت شيء في حَياتي",22,"ي",1,0],["لَمْ يَشْغَلِ الْخَطْبُ فِكْرَ أَدْمَا","وَسْنَى وَلَمْ يَعْرُهَا الحِذَارْ",23,"ر",1,0],["لَمْ يُشَفِّعْهُمْ لَديْهِ أَنَّهُمْ","أَعلَقُ النَّاسِ بِهِ قُرْبَى وَصِهْرَا",24,"ر",2,0],["لَمْ يَشُقْني يَوْمُالقِيامَةِ، لَوْلا","أمَلي أنّنيهُنَاكَ أرَاهَا",25,"ا",3,0],["لَمى شَفَةِ المَحبوبِ أَو وَردُ خَدِّهِ","مَدى أَمَلى لَو تَمَّ لي ما أَؤمّلُ",26,"ل",1,0],["لم يُشْبِهُوا الإِنسانَ في خَلَّةٍ","وأَشْبَهُوا الْحَيَّاتِ والأَسْبُعا",27,"ع",2,0],["لَمْ يُشاهِدْ سِواهُ بَعْدَ ابْنِ دَا","وُدَ سَناً مُشْرِقاً وَمُلْكاً عَتِيدا",28,"د",2,0],["لم يُشْفَ بالدَّمْعِ عليلُ الفِراقُ","إذ شَيَّعَ الظَّعْنِ بِدَمْعٍ مُراقْ",29,"ق",1,1],["لَم يشن جِسمي النَحول وَلَكن","زادَني الحُب رفعة بِاِنتِحالي",30,"ي",1,0],["لم يشتغل فكري","واللب لولاه",31,"ا",2,0],["لم يشفه إلا اللقا لكنه","يخفيه خوف شماتة الأعداء",32,"ا",2,0],["لم يُشبهوا الإنسانَ إلا أنهم","متكوّنون من الحَما المسنونِ",33,"ن",1,0],["لم يَشربِ المحزونُ منها قَطرةً","إلاّ تدرّعَ هزّةَ المُرتاحِ",34,"ح",1,0],["لَم يُشوِ رامي البَينِ حَبَّةِ قَلبِهِ","لَمّا رَمى عَمداً بِقَوسِ عِدائِهِ",35,"ا",3,0],["لَم يَشكُلِ الخَيلَ مُذ جالَت بِشَكلَتِهِ","إِلّا بِشَعرِ لِحى الأَبطالِ وَاللِّمَمِ",36,"م",1,0],["لم يَشدُ إلّا باسعِها وجمالِها","وبغير وحيِ ضميره لم يَصدَعِ",37,"ع",1,0],["لم يَشْفِني غير مَلْقى السَيّدِ الفَهِمِ","ابنِ السَيدِ الفهمِ ابنِ السَيّدِ الفَهمِ",38,"م",1,0],["لم يشتغل بعلوم عن فرائضه","بل أتعبت كاتب اليمنى نوافله",39,"ل",2,0],["لَم يُشَب وَعدُهُ بِمَط","لٍ وَلا جودُهُ بِمَن",40,"ن",1,0],["لم يَشِن بَيتَهُ زحافٌ ولا بَس","طُ يديهِ يومَ النَّدى مَقبُوضُ",41,"ض",1,0],["لم يشهدوا في هواه الصرف إلّا هو","قامت بهم حيث قاموا حين قالوا هو",42,"و",1,0],["لَمْ يَشْرُف الشِّعر إِلا حِينَ شَرَّفَهُ","نَظْماً لِعَالِيهِ أَوْ سَمعْاً لِغَالِيهِ",43,"ي",2,0],["لَم يَشكُ عُدوانَ صَرفِ الدَهرِ مِن أَحَدٍ","إِلّا إِلَيهِ وَأَشكاهُ وَأَعداهُ",44,"ا",2,0],["لم يشعروا بوجودي","ولم يحسوا بيأسي",45,"ي",1,0],["لم يَشْعروا حتّى طرَقْتَ كأنّما","حَوَّلْتَ في الحَدَقِ الخَيال خُيولا",46,"ل",2,0],["لم يَشْدُدِ الفَلَكُ المُدارُ نِطاقَه","إلاّ ليَسْمعَ طائعاً وتَقولا",46,"ل",2,0],["لم يُشْجِ قَلبِي مِلْحوادِثِ إِل","لاَ صاحِبي المَتْرُوكُ في تَغْلَمْ",47,"م",1,0],["لَم يَشتَرِ الناسُ وَلا باعوا","خَيراً من الخُبزِ إذا جاعوا",48,"ع",3,1],["لم يُشبِعوه ولم يُرْووه من ظمأٍ","ولم يعينوه حتى يبْتني دارا",49,"ر",2,0],["لَمْ يَشْفِ طيفُكَ لما زارني أَلَمَا","وإِنما زادَني إِلْمَامُهُ لمَمَا",50,"م",2,1],["لم يَشْدُ في العشاق حادي شوقهم","إلا وحثّهم الحطيم وزمزمُ",51,"م",1,0],["لم يشكها شجر أو طائر غرد","ولا أزاهير من ميراث نيسان",52,"ن",1,0],["لم يشرفِ الدرُّ لولا هجرُ موطنهِ","والبدرُ ما تمَّ حتى جدَّ في الطلب",53,"ب",1,0],["لم يشف إسقاط قسطنطين غلتها","ولا اشتهار فنيزيلوس بالخطب",54,"ب",1,0],["لم يشرب العشاق من بحر الهوى","إلا بغية مقلتي من عطفتي",55,"ت",2,0],["لم يشرب الماء من حقد ومن حسد","إلا الأخلا وهو مبتسم",56,"م",1,0],["لم يشربوا إلّا كؤوسَ قِسِيّهِمْ","أَو يَطعموا إلّا لحومَ المأْزقِ",57,"ق",1,0],["لم يشتغل عن بعضها بالبعض بل","في كل شيء لم يزل متمكنا",58,"ن",2,0],["لم يُشاهِد حسْنَه غيري ولم","يبْقَ في الدَّير سِوى المشهودِ فيّ",59,"ي",1,0],["لَمْ يَشْعُرُوا بِغُرُوبِ الشَّمْسِ إِذْ سَفَرَتْ","عَنْ وَجْهِهَا فَأَضَاءَ السَّهْلُ وَالجَبَلُ",60,"ل",1,0],["لم يشهدوا ذلك ولم يشاوروا","وكيف قاموا دونهم فاستاثروا",61,"ر",3,0]]}