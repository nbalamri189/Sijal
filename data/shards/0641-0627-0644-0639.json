et/poem61766.html","الكامل"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[461,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[461,"العين تبدي الذي في قلب صاحبها","https://www.aldiwan.net/poem16446.html","البسيط"],[464,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[464,"مولاي قد جاءت إلي الخلعة المقدسة","https://www.aldiwan.net/poem3302.html","عموديه"],[468,"قم نصطبح قهوة رقت فلم تبن","https://www.aldiwan.net/poem59609.html","البسيط"],[468,"غيطاننا قد جوشنت","https://www.aldiwan.net/poem59688.html","مجزوء الكامل"],[468,"يا خائض البحر الذي قد طمت","https://www.aldiwan.net/poem60307.html","السريع"],[468,"أقبل بوجه الإصطباح على الربى","https://www.aldiwan.net/poem60358.html","الكامل"],[468,"الصبح ينثر فوق مسك","https://www.aldiwan.net/poem60535.html","مجزوء الكامل"],[477,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[479,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[500,"رف الغرام بقلبي","https://www.aldiwan.net/poem37960.html","المجتث"],[500,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[500,"ماذا يقول عليل شفه وله","https://www.aldiwan.net/poem38085.html","البسيط"],[500,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[529,"بدر بأفلاك البلاغة طالع","https://www.aldiwan.net/poem37341.html","الكامل"],[529,"فالعطف لم يأت في إضمار تابعه","https://www.aldiwan.net/poem37369.html","البسيط"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[529,"لعل ما حل من عقد الملمات","https://www.aldiwan.net/poem37496.html","البسيط"],[538,"حدثوا عن خائن","https://www.aldiwan.net/poem48300.html","عموديه"],[551,"صبرا ففي الصبر الجميل","https://www.aldiwan.net/poem47185.html","مجزوء الكامل"],[551,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[553,"قد كنت قبلك خلوا فابتليت بمن","https://www.aldiwan.net/poem68377.html","البسيط"],[558,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[558,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[558,"العلم والمال عدوان لم","https://www.aldiwan.net/poem34251.html","السريع"],[558,"إن هذا زمن الأمر العسير","https://www.aldiwan.net/poem34490.html","الرمل"],[558,"أصابع الغيب فينا حركت عوده","https://www.aldiwan.net/poem34566.html","البسيط"],[575,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[576,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"],[587,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["فَالعَبدُ أَصبَرُ جِسماً","وَالحُرُّ أَصبَرُ قَلبا",0,"ب",2,0],["فالعَذولُ مُنتَظِرٌ","أَن تُخَيِّبي أَمَلي",1,"ل",2,0],["فَالعَبْدُ رَيّانُ مِنْ نُعْمى يَجودُ بِها","وَالحُرُّ مُلْتَهِبُ الأَحْشاءِ مِنْ ظَمإِ",2,"ا",1,0],["فَالعُودُ مِنْ حَطَبٍ لولا رَوائِحُهُ","وَالنَّخْلُ تُكْرَمُ لِلأَثْمار لا العُسُبِ",3,"ب",1,0],["فالعمُّ أبْلَجُ منْ كِنانَةَ في الذّرا","والخالُ أرْوَعُ منْ بَني همّامِ",4,"م",1,0],["فالعِزُّ بالبَطْحاءِ بينَ مُغَرِّرٍ","شَرِسٍ وأبْلَجَ شامِخِ العِرْنينِ",5,"ن",1,0],["فالعَدْلُ مُنتَشِرٌ والعَزْمُ مُجْتَمِعٌ","والعُمْرُ مُقْتَبَلٌ والرأيُ مُكْتَهِلُ",6,"ل",1,0],["فالعَرْصَةُ الفَيحاءُ مَسرَحُ أيْنُقٍ","لمْ يَنْبُ عَنْ عَطَنٍ بهِنَّ الضِّيقُ",7,"ق",1,0],["فَالعُميُ لَو كانَ في أَجفانِهِم نَظَرو","وَالخُرسُ لَو كانَ في أَفواهِهِم خَطَبوا",8,"ب",3,0],["فَالعَنبَرُ الخامُ رَوثٌ في مَواطِنِهِ","وَفي التَغَرُّبِ مَحمولٌ عَلى العُنُقِ",9,"ق",1,0],["فَالْعَيْنُ عَن قُرَّةٍ والكَفُّ عَنْ صِلَةٍ","وَالْقَلْبُ عَنْ جابِر والأُذْنُ عَنْ حَسَنِ",10,"ن",1,0],["فَالْعِلْمُ بِالأَدْيَانِ عِلْمٌ أَوَّلٌ","وَالْعِلْمُ بِالأَبدَانِ عِلْمٌ ثَانِي",11,"ي",1,0],["فَالْعَدْلُ يُحْكِمُ فِي الْوَرَى قِسْطَاسَهُ","وَالأَمْنُ ظِلٌّ وَافِرُ الإِطْنَابِ",12,"ب",1,0],["فَالعَيشُ في بِنتِ فِكرٍ","تُجلى وَفي بِنتِ دَنِّ",13,"ن",1,0],["فَالعَرشُ في فَرَحٍ وَالمُلكُ في مَرَحٍ","وَالخَلقُ في مِنَحٍ وَالدَهرُ في رَهَبِ",14,"ب",1,0],["فَالعِقْدُ مِنْ ثُلْثِ قَرْنٍ غَيْرُ مُنْتَثِرٍ","وَالسِّمْطُ شِبْهُ سِمَاطٍ غَيْرُ مُنْفَصِمِ",15,"م",1,0],["فالعدوتان وما قد ضمَّ ملكُهما","أنصار ملكك صان الله علياهُ",16,"ا",2,0],["فالعيش عندي فوق الغصون","لا في قصور ولا حصون",17,"ن",1,0],["فالعيش تستبشع الأذواق مطعمه","إذا تسرّب في أثنائه السأم",18,"م",1,0],["فالعقل يتهم الدهر المسيء بذا","وما يعيبك أن الدهر متهم",18,"م",1,0],["فالعِلم في أمة ليس بحاكمةٍ","كالسيف",19,"ف",1,0],["فالعيش وهو منّعم","كالعيش وهو مذمَّم",20,"م",1,0],["فالعلم ما قارنَتْه البيض مفخرةٌ","والحق ما وازرته السمر محترم",21,"م",1,0],["فالعين ما يورث حزناً ترى","والاذن ما يزعجها تسمع",22,"ع",1,0],["فالعقل فيها عالم متجاهل","طوراً وطوراً جاهل متعلّم",23,"م",1,0],["فَالعَينُ تَرتَعُ فيما خَطَّ كاتِبُهُ","وَالسَمعُ يَنعَمُ فيما قالَ شاعِرُهُ",24,"ر",2,0],["فَالعَينُ عانِيَةٌ تَفيضُ دُموعُها","لِمَنازِلٍ دَرَسَت كَأَن لَم تُؤهَلِ",25,"ل",1,0],["فالعفو منك لقد سد الصدود على","ذهني مذاهب ينحو مثلها الناحي",26,"ح",2,0],["فالعزُّ في العتبات من أبوابهِ","ما العزّ في صهوات خيل الأجبهِ",27,"ه",1,0],["فالعِزُّ عِزُّكما والمجْدُ مَجْدُكما","ومَنْ أبَى ذاك مَوْطُوءُ اللَّغَاديدِ",28,"د",1,0],["فالعدل منها عليه جَور","قاتلها الله أيُّ جور",29,"ر",1,0],["فالعيونُ المراض يصْدفن طوراً","ويُلاحظن عن قلوبِ مِراض",30,"ض",1,0],["فَالعَينُ بَعدَهُمُ كَأَنَّ حِداقَها","سُمِلَت بشَوكٍ فَهِيَ عورٌ تَدمَعُ",31,"ع",1,0],["فَالعَينُ عانِيَةٌ بِالماءِ تَسفَحُهُ","مِن نِيَّةٍ في تَلاقي أَهلِها ضَرَرُ",32,"ر",1,0],["فَالعَينُ مِنّي كَأَن غَربٌ تَحُطُّ بِهِ","دَهماءُ حارِكُها بِالقِتبِ مَخزومُ",33,"م",1,0],["فَالعَيشُ إِلّا في ذَراهُ مُنَكَّدٌ","وَالرِزقُ إِلّا مِن يَدَيهِ مُضَيَّقُ",34,"ق",1,0],["فَالعَبدُ قَد أَعنَتنَ أَسفَلَ ساقِهِ","وَعَدَلنَ رُكبَتَهُ سِواها مَعدِلا",35,"ل",2,0],["فَالعِلمُ يَفعَلُ في الأَرواحِ فاسِدُهُ","ما لَيسَ يَفعَلُ فيها طِبُّ دَجّالِ",36,"ل",1,0],["فالعُمْرُ أَقْصَرُ مُدَّةً","مِنْ أَنْ يُمَحّقَ بالغِيَرْ",37,"ر",1,0],["فَالعُربُ مِنهُ مَعَ الكُدرِيِّ طائِرَةٌ","وَالرومُ طائِرَةٌ مِنهُ مَعَ الحَجَلِ",38,"ل",1,0],["فَالعيسُ أَعقَلُ مِن قَومٍ رَأَيتُهُمُ","عَمّا يَراهُ مِنَ الإِحسانِ عُميانا",39,"ن",2,0],["فالعزُّ أقعسُ والجنابُ ممنَّعٌ","والمجدُ أتلعُ والفِناءُ حصينُ",40,"ن",1,0],["فالعودُ يُنْبِيكَ عن مكنونِ باطنهِ","دُخَانُهُ حين تُلْقِيهِ على النَّارِ",41,"ر",1,0],["فَالعَزمُ يَقتُلُ كُلَّ سُقمٍ قاتِلٍ","وَالبُعدُ يَغلِبُ كُلَّ وَجدٍ غالِبِ",42,"ب",1,0],["فَالعَيشُ يَسمُجُ فينا حينَ تَهجُرُنا","وَحينَ تَزدارُنا ما فيهِ تَسميجُ",43,"ج",1,0],["فَالعَدلُ وَالدينُ يَقصِدانِ إِلى","غايَةِ مَجدٍ لِلدينِ مَفخَرُها",44,"ر",3,0],["فالعَيْشُ غَضٌّ نَسيمُه أرِجٌ","والدَّهْرُ غِرٌّ رداؤُهُ جَذِلُ",45,"ل",1,0],["فالعينُ تَحسِرُ إن رأَتْ إشراقَها","والنَّفسُ تَنْعَمُ إن بَلَتْ أخبارَها",46,"ر",3,0],["فَالعَبدُ يَرجو ما لَيسَ يَدرِكَهُ","وَالمَوتُ أَدنى إِلَيهِ مِن نَفسِه",47,"س",2,0],["فَالعَبدُ في هَذا النَهارِ بِخَلوَةٍ","مَحجوبَةٍ وَبِها ثَلاثٌ تُحمَدُ",48,"د",1,0],["فَالعيدُ مُنتَظِرٌ في العامِ واحِدَةً","وَجودُ كَفِّكَ عيدٌ لَيسَ يُنتَظَرُ",49,"ر",1,0],["فَالعُميُ لا تَعلَمُ إِرزامَ الحَيا","حَتّى يَكونَ الرَعدُ في سَحابِهِ",50,"ب",2,0],["فالعيشُ في شربها مُعَتَّقةٌ","بسكرها في العقول محتكمه",51,"م",2,0],["فَالعَذْبُ يَجِلّ بِقِلَّتِهِ","وعَلَيهِ عِمادُ المُعتَمدِ",52,"د",1,0],["فَالْعَيْشُ لَيْسَ يَدُومُ فِي أَلْوَانِهِ","إِلَّا إِذَا دَارَتْ عَلَيْهِ الْجَامُ",53,"م",1,0],["فالعدلُ والتعريفُ عندي ولي","منزلةٌ في النحوِ لن تُجهلا",54,"ل",2,0],["فالعينُ يسلم منها ما رأت فَنَبَتْ","عَنْهُ وتلحقُ ما تهوى من الصورِ",55,"ر",1,0],["فَالعَهدُ أَكرَمُ مَنوِيٍّ وَأَوثَقُهُ","وَالدارُ أَسعَدُ مَبنِيٍّ وَأَرفَعُهُ",56,"ع",2,0],["فَالعَيشُ في مَجلِسٍ حُفَّت جَوانِبُهُ","بِالنَرجِسِ الغَضِّ وَالنِسرينِ وَالآسِ",57,"س",1,0],["فَالعَينُ مِنّي عَنِ النِسوانِ صائِمَةٌ","حَتّى يَكونَ عَلى الحَوراءِ إِفطاري",58,"ر",2,0],["فَالعَينُ حينَ أَرومُ هَجرَكِ طُرفَةٌ","وَعَلى فُؤادي مِن هَواكِ أَميرُ",59,"ر",1,0],["فَالعَينُ تَبكي في المَنامِ فَتَجتَني","فَرَحاً وَتَضحَكُ في الرُقادِ فَتَعبَرُ",60,"ر",1,0],["فالعِراقيُّ بَعْدَهُ للحِجازِىْ","يِ قليلُ الخِلافِ سَهْلُ القِيادِ",61,"د",1,0],["فالعينُ تهوى صورةَ الحُسْنِ التي","روحي بها تَصبو إلى مَغْنىً خَفي",62,"ي",1,0],["فالعدل إن يحسن الإنسان سلطته","كن في سلوكك يا إنسان معتدلا",63,"ل",2,0],["فالعُودُ يَخْفُقُ والمِزْمَارُ يَتْبَعُهُ","وهاجِرُ الرّاحِ قد هاجَتْ بَلابِلُهُ",64,"ل",2,0],["فَالعُميُ لَو كانَ في أَجفانِهِم نَظَروا","وَالخُرسُ لَو كانَ في أَفواهِهِم خَطَبوا",65,"ب",3,0],["فَالْعَدْلُ مُنْبَسِطٌ وَالْجَوْرُ مُنْقَبِضٌ","وَالأَمْنُ مُنْسَدِلٌ وَالْخَوْفُ مُنْشَمِرُ",66,"ر",1,0],["فَالْعَدْلُ يَرْعَاهَا بِرَأْفَةِ وَالِدٍ","والْبَأْسُ يَحْمِيهَا بِصَوْلَةِ أَصْيَدِ",67,"د",1,0],["فَالعَقْلُ كَالْمِنْظَارِ يُبْصِرُ مَا نَأَى","عَنْهُ قَريباً دُونَ لَمْسٍ بِالْيَدِ",67,"د",1,0],["فَالْعَيْنُ لَيْسَ لَهَا مِنْ دَمْعِهَا وَزَرٌ","والْقَلْبُ لَيْسَ لَهُ مِنْ حُزْنِهِ فَادِي",68,"ي",1,0],["فَالْعَتْبُ إِنْ جَازَ حَدَّ الْعَدْلِ مَقْطَعَةٌ","وَالنُّصْحُ مَا لَمْ يَكُنْ فِي السِّرِّ تَقْرِيعُ",69,"ع",1,0],["فالْعَينُ وَهْيَ صَغِيرَةٌ في حَجْمِها","تَسَعُ الفَضَاءَ بِأَرْضِهِ وسَمائِهِ",70,"ا",3,0],["فَالْعُفْرُ تَحْتَ الظِّلالِ رَاتِعَةٌ","وَالطَّيْرُ فَوْقَ الْغُصُونِ مُنْتَشِرَهْ",71,"ر",2,0],["فَالْعَيْنُ نَرْجِسَةٌ والشَّعْرُ سَوْسَنَةٌ","والنَّهْدُ رُمَّانَةٌ والْخَدُّ تُفَّاحُ",72,"ح",1,0],["فالعامُ لم يَكمل لعزلَتِهِ بها","حتَّى علَتْ يَدهُ وطالَ الباعُ",73,"ع",1,0],["فالعنبر الخام روث في موطونه","وفي التغرب محمولُ على العنق",74,"ق",1,0],["فالعَرشُ والفَرشُ والمَلَكُ الذي حملوا","له الذي منهُمُ سرّاً وما جَهَرا",75,"ر",2,0],["فالعقلُ مركزُ كلِّ شيءٍ صائبٍ","والحبُّ وجهُ المشهدِ الفتَّانِ",76,"ن",1,0],["فالعبد يقرع بالعصا","والحر تكفيه القرينة",77,"ن",2,0],["فالعلم سهلٌ إذا ما كنتَ في صِغَرِ","وغيرُ سَهْلٍ إذا ما كنت في الكِبَرِ",78,"ر",1,0],["فالعِرْقُ دَسَّاسٌ لقول نبيِّنا","لا تغتَرَّ بالغادةِ الحسناءِ",79,"ا",2,0],["فالعُمْرُ ظلٌّ زائلٌ","لا زالَ يطلُبُهُ الفَنَاءُ",80,"ا",2,0],["فالعلم يرشدهم والخلق يسعدهم","والدين يقصي عن النفس الشياطينا",81,"ن",2,0],["فَالعِزُّ أَقعَسُ وَالمَجازُ مُساهِمٌ","وَالرَوضُ أَحوى وَالح