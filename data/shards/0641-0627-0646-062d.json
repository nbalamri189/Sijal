ل"],[162,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[167,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[167,"ألم يأن أن تنسى عسى ولعلما","https://www.aldiwan.net/poem1665.html",""],[184,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[202,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[202,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[210,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[220,"وكم سائل عن وصف من أسس العلا","https://www.aldiwan.net/poem55398.html","الطويل"],[229,"يا سائق الركب لا تعجل فلي إرب","https://www.aldiwan.net/poem44599.html","البسيط"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[259,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[266,"إذا سألوا عن مذهبي لم أبح به","https://www.aldiwan.net/poem69126.html","عموديه"],[268,"رأيت الناس في السير الحثيث","https://www.aldiwan.net/poem35177.html","الوافر"],[268,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[273,"إن سعيد بن حكم","https://www.aldiwan.net/poem25418.html","مجزوء الرجز"],[273,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[278,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[320,"الدهر حالان هم بعده فرج","https://www.aldiwan.net/poem56337.html","البسيط"],[335,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[335,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[340,"فانحنى نحوه قليلاً فالفى","https://www.aldiwan.net/poem55368.html","الخفيف"],[344,"وشمسة كرم برجها قعر دنها","https://www.aldiwan.net/poem24121.html","الطويل"],[351,"أرى ما كل من يدعى حبيبا","https://www.aldiwan.net/poem40550.html","الوافر"],[362,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[374,"عفت نفسي أمانيها","https://www.aldiwan.net/poem59166.html","مجزوء الوافر"],[388,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[400,"لك البشارة هذا منتهى أربي","https://www.aldiwan.net/poem34150.html","البسيط"],[402,"أراح الله من زمان","https://www.aldiwan.net/poem49652.html","الوافر"],[402,"إذا كنت متخذا صاحبا","https://www.aldiwan.net/poem49883.html","المتقارب"],[403,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[413,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[434,"ترفّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[434,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[438,"وأما الصلاة والصيام ومثله","https://www.aldiwan.net/poem14403.html","الطويل"],[447,"اكسير الحياة","https://www.aldiwan.net/poem1020.html","عموديه"],[459,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[459,"قل للمجاهد لا زالت عوارفه","https://www.aldiwan.net/poem15157.html","البسيط"],[462,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[477,"الحقائق هبها اليوم تمثيلا","https://www.aldiwan.net/poem36953.html","البسيط"],[513,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[525,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[556,"أنا كتاب الله في الناس","https://www.aldiwan.net/poem34436.html","السريع"],[556,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"]],"verses":[["فَإِنَّ حَمِيَّةَ القُرَناءِ تَطغى","فَتَثلِمُ جانِبَ النَسَبِ القُرابِ",0,"ب",1,0],["فانْحَرْ ذوي إحَنٍ تَشْجى أضالِعُهُمْ","بهِنَّ نَحْرَ هَدايا مَكَّةَ الهَمَلِ",1,"ل",1,0],["فَإِنَّ حُبَّكِ قُربانٌ وَنافِلَةٌ","وَحُبَّ غَيرِكِ ذَنبٌ غَيرُ مَغفورِ",2,"ر",1,0],["فإنْ حمَلوا أفْنَوْا أو استُصْرِخوا حمَوْا","وإنْ بذَلُوا أغْنَوا عنِ الدِّيمِ الوَطْفِ",3,"ف",1,0],["فَإِن حَدِبوا فاقعَس وَإِن هُم تَقاعَسوا","ليَستَمكِنوا مِمّا وَراءَكَ فاحدَبِ",4,"ب",1,0],["فَإِن حِميَرٌ أَصلَحَت أَمرَها","وَمَلَّت تَساقِيَ أَولادِها",5,"د",3,0],["فَاِنحَلَّ ما كانَ مَعقوداً بِأَنفُسِنا","وَاِنبَتَّ ما كانَ مَوصولاً بِأَيدينا",6,"ن",2,0],["فَإِن حارَدَ المَعطونَ أَلفَيتَ كَفَّهُ","هَضوماً تَسُحُّ الخَيرَ مِن خُلُقٍ بَحرِ",7,"ر",1,0],["فإن حمراءها والله يكلؤُها","ياقوتةٌ فوق ذاك التاج يُعليها",8,"ي",3,0],["فإن حشا الإسلام أصبح دامياً","إلى الله يَشكو قلبه شدة الكرب",9,"ب",1,0],["فإنْ حموا بيضةَ الإسلام إنهمُ","من سادةٍ في صميم العرب أمحاح",10,"ح",1,0],["فانْحرْهما في يوم عيدك وابقَ ذا","مجدٍ تضيءُ بذكره الآفاق",11,"ق",1,0],["فإن حَقَّ ظني فاستقِلْني بمُتْرَصٍ","يقيني إذا ما القُرُّ أبدى المخالبا",12,"ب",2,0],["فإن حشدوا لأخ مرةً","أدلُّوا عليه دلالاً ثقيلا",13,"ل",2,0],["فأنحى على فضل الثراء بجوده","وما زال للأدواء أحسم حاسمِ",14,"م",1,0],["فَإِنَّ حَراما أَن أَخونَ أَمانَةً","وَآمَنَ نَفساً لَيسَ عِندي ضَميرُها",15,"ر",3,0],["فَاِنحَنى فَوقَها كَمُستَرِقِ الهَم","سِ يُطيلُ السُكوتَ وَالإِصغاءَ",16,"ا",2,0],["فَإِنَّ حَمِيتَنا أَبَداً حَرامٌ","وَلَيسَ لِجارِ مَنزِلِنا حَمِيتُ",17,"ت",1,0],["فَإِن حَسُنَت لَفظاً فَمِن رَوضِكَ اِجتَنى","وَإِن عَذُبَت شُرباً فَمِن بَحرِكَ اِستَقى",18,"ق",2,0],["فإن حقائق الأشياء سرُّ","خفي ما لغامضه انجلاء",19,"ا",2,0],["فَإِنَّ حَظَّكَ مِن تَكرارِها شَرَفٌ","وَحَظَّ غَيرِكَ مِنها الشَيبُ وَالكيرَ",20,"ر",1,0],["فَإِن حَلُموا فَإِنَّ الخَيلَ فيهِم","خِفافٌ وَالرِماحُ بِها عُرامُ",21,"م",1,0],["فَإِن حَسَرَت عَن فَضلِ نُعمى فَإِنَّها","مَطايا يُوَفّيكَ البَلاغَ حَسيرُها",22,"ر",3,0],["فإن حليت بالصهباء كأسي","كسوت علاك من حلي المقال",23,"ل",1,0],["فَإِن حالَ ذاكَ الرَأيُ فِيَّ فَطالَماٍ","أَحَلتَ صُروفَ الدَهرِ مُجتَهِداً عَنّي",24,"ي",1,0],["فَإِن حَسَدوا فَضلي وَعابوا مَحاسِني","وَذَلِكَ لِلتَقصيرِ عَنها وَلِلضِغنِ",25,"ن",1,0],["فإنْ حمانا اللهُ من شرِّهِ","وعدْتُ للعلمِ رجونا التئامْ",26,"م",1,0],["فإنْ حضرتُمْ كانَ من فضلِكُمْ","لا بدَّ للناسِ منَ الناسِ",27,"س",1,0],["فإنَّ حبرَ كاتبٍ","ربحٌ إذا هو انقلبْ",28,"ب",1,0],["فإنْ حَدَثَتْ مِنْ بَعْدِهَا نارُ فِرْيَةٍ","فما ذلك الشيءُ الفَرِيُّ وَلا الإِدُّ",29,"د",1,0],["فَأَنحى لَهُ في صَميمِ القَذالِ","فَشَكَّ المُزَمِّرَ أَو قَدَّه",30,"د",2,0],["فَإِنَّ حُدَيجاً لَهُ هِجرَةٌ","وَلَكِنَّها زَمَنَ الرِدَّه",30,"د",2,0],["فَإِنَّ حُدِّثتِ يَوماً عَن","فَتىً ماتَ مِنَ الحُبِّ",31,"ب",1,0],["فَإِنَّ حِبالَ الشَمسِ لَسنَ ثَوابِتاً","لِشَدِّ رِحالٍ أَو قَوابِضَ جُذَّبِ",32,"ب",1,0],["فَأَنحى عَلَيها ذاتَ حَدٍّ دَعا لَها","رَفيقاً بِأَخذٍ بِالمَداوِسِ صَيقَلا",33,"ل",2,0],["فإنّ حظّك من تكرارها شرفٌ","وحظّ غيرك منه الشّيب والكبر",34,"ر",1,0],["فَاِنحَدَرَت عُصفورَةٌ مِنَ الشَجَر","لَم يَنهَها النَهيُ وَلا الحَزمُ زَجَر",35,"ر",1,0],["فَإِنْ حَلَّ مَا أَعْطَاكَ رَبُّكَ مِن جَنىً","جَزَاءً لِمَا أَنْفَقْتَ فِيه مِن العُمْرِ",36,"ر",1,0],["فَإِن حُرِمَ العاصي أَبوكَ شَفاعَةً","تَكونُ لَهُ عِزّاً هَوى لِهَوانِ",37,"ن",1,0],["فإن حملوا أقنوا أو استصرخوا حموا","وإن بذلوا أغنوا عن الديم الوطف",38,"ف",1,0],["فإنّ حروفي اختلاج السهول","وشوق السواقي ، وخفق الهضاب",39,"ب",1,0],["فإن حظك من تكرارها شرف","وحظ غيرك منها الشيب والكبر",40,"ر",1,0],["فإنْ حِيزَتِ الدُّنيا إِليهم فإنَّ مَنْ","نَفَى زَيْفَهَا سَلْماً إِليهم لناقِدُ",41,"د",1,0],["فانحلَّ عقد نظامهم","مِن قبلُ بالموتِ الزؤامِ",42,"م",1,0],["فَإِنَّ حِزاماً لَدى مَعرَكٍ","وَإِخوَتَهُم حَولَهُم أَنسُرُ",43,"ر",1,0],["فَإِن حُصِّلَت أَشرافُ عَبدِ مَنافِها","فَفي هاشِمٍ أَشرافُها وَقَديمُها",44,"م",3,0],["فإن حكمتَ فحقٌ ما تسطره","ولا تنال به في الحي إنكارا",45,"ر",2,0],["فإن حزَّ الفَوارِى في أديمى","فلا عيبٌ إذا ما السيفُ فُلاَّ",46,"ل",2,0],["فإن حسدت امرأً فيما يخصُّ له","فاذهب فمالك إلاَّ الإِثمُ والكمد",47,"د",1,0],["فإن حاولت نعماء هذا أو انها","وإن أملت علياً فذا الحين حينها",48,"ن",3,0],["فإِن حالَ نَأيٌ دونَكُم وَتَعَرَّضَت","غُروبُ خُطوبٍ لِلقُلوبِ نَواقِثِ",49,"ث",1,0],["فَأَنحَت عَلى أَرحامِها بِشِفارِها","وَأَوهَنَ عَظمَ الأَقرَبينَ اِصطِلابُها",50,"ب",3,0],["فَإِن حَنَّ قَلبي نَحوَكُم أَو شَكا جَوىً","فَصادَفَ مِن زُرقِ الأَسِنَّةِ لَهذَما",51,"م",2,0],["فإن حصل التجمّل فيه يوما","وجدت مضيعا لأدا الحقوق",52,"ق",1,0],["فإن حببي مَن يحبُّ تَنَعُّمي","وليس حبيبي مَن يحبُّ شقائي",53,"ا",2,0],["فإنَّ حراماً أن تُعَرَّض مهجة","لموتٍ ولم يُعلَم مكانُ مصيرِها",54,"ر",3,0],["فإن حلَّ أرضاً حلَّها كلُّ منكَرٍ","وَقَلَّتْ بها الأرزاق والخيرُ راحِلُ",55,"ل",1,0],["فإن حمدته الناس فهو محمد","وإن عجبوا من حسنه فهو يوسف",56,"ف",1,0],["فإن حبكم وسط الحشاشة لا","تناله غير الأيام والنوب",57,"ب",1,0],["فَاِنحَطَّ حينَئِذٍ وَأَخبرَ جَدَّهُ","بِنُبُوَّةِ الوَلَدِ العَظيمِ الشّانِ",58,"ن",1,0],["فَأَنحوا بِالصَوارِمِ مُسرِعاتٍ","عَلى البَرِّ النَقِيِّ اِبنِ النَقِيِّ",59,"ي",1,0],["فأن حال جدى دون جدى عن المنى","فكم من فتى بالسعي لا يبلغ المدى",60,"د",2,0],["فإن حنفيا قلت قالوا بأنني","ابيح الطلا وهو الشراب المحرم",61,"م",1,0],["فإن حادَثتَهم بالخيرِ ملُّوا","فأقصِر ما استطعتَ عن الحديث",62,"ث",1,0],["فإنّ حِجابَ عفّتها رَقيقٌ","يُحاولُ كلّ يومٍ أن يَطيرا",63,"ر",2,0],["فَأَنحَنِي مُمَهِّدا","إِلَى جَوابِهِ القَلَمْ",64,"م",1,0],["فَإنْ حَانَ مَنْكُوباً ونَكَّبَ حَائِناً","لَقَدْ حَصَّ مُنْفَلاً وَأفْلَتَ مَنْحَصَّا",65,"ص",2,0],["فإِنْ حُطِمَ اللَّدْنُ فَالْعَضْبُ باقٍ","وَإِنْ أَقْلَعَ الْغَيْثُ فَالْبَحْرُ طامِ",66,"م",1,0],["فإنَّ حسنَ العِشرَة","ما حازَ قَومٌ عُشرَه",67,"ه",1,0],["فَإِنَّ حَمدكَ مَن لَم تَبلُهُ صَلَفٌ","وَإِنَّ ذَمَّكَ بَعدَ الحَمد تَكذيبُ",68,"ب",1,0],["فَأَنحى إِلَيها ذاتَ حَدٍّ غُرابُها","عَدُوٌّ لِأَوساطِ العِضاهِ مُشارِزُ",69,"ز",1,0],["فَإِن حَلَّتِ المَيلاءُ عُسفانَ أَو دَنَت","لِحَرَّةِ لَيلى أَو لِبَدرٍ مَصيرُها",70,"ر",3,0],["فانحنى نحوه قليلاً فالفى","شبح الموت فوقه في خفوقِ",71,"ق",1,1],["فَإِن حُرِّمَت يَوماً عَلى دينِ أَحمَدٍ","فَخُذها عَلى دينِ المَسيحِ بنِ مَريَمِ",72,"م",1,0],["فَإِنّ حَبيب في بَعض الأَسامي","تَراهُ إِذا تصحّفه خَبيثا",73,"ث",2,0],["فإن حُمدَتْ طَرائقُه فنَلْقَى","من الحمدِ اسْمَه الأعلَى اشْتِقاقا",74,"ق",2,0],["فإن حزت القُوى فيها","فغرِّد في قوافيها",75,"ي",3,0],["فإن حصلتم وصفا فنوا","والا فامنحوني بالدعاء",76,"ا",2,0],["فإن حقك عندي لا يفي به","نظمي ولو كان معدوداً من النخب",77,"ب",1,0],["فإن حَمِدَ الكَريمُ صباحَ يَومٍ","وأنَّى ذاكَ لم يَحْمَدْ مساءَهْ",78,"ه",1,0],["فإنْ حلَّ أرضاً نوى غيرَها","وانْ سَرّ يوماً بوَصل فَجَعْ",79,"ع",1,0],["فانحَلَّ سِلكَ الدَمعِ في ثَغرِها","فَشَجَّت الخَمرُ بِماءٍ قراح",80,"ح",1,0],["فإنْ حضر الفساد وغبتَ عنه","ولم تكُ من يُعَدُّ من الحضور",81,"ر",1,0],["فإن حفاظا إن وقفت بدارهم","لتبكي خليطا بأن أو منزلا أقوى",82,"و",2,0],["فانحروا ولا تنحر عداك فإنما","بعداوة لهم العيوب تعدّد",83,"د",1,0],["فإنْ حَمَلَتْ من بعدِها سَيْفَ فِتْنَةٍ","يَدٌ فَتَخَلَّتْ من أنامِلِهَا الخَمْسِ",84,"س",1,0],["فإِن حان وقت الفرض ليس موسَّعا","له الجَهل إِلا أَن يؤدي ويذهبا",85,"ب",2,0],["فإن حلقت ألفاظه وتألقت","معانيه فالحب الجميل أميره",86,"ر",2,0],["فإن حربٌ فعمروٌ في زُبيدٍ","وإنْ نُطْقٌ فقُسٌّ في إيادٍ",87,"د",1,0],["فإنْ حَصرتُ فقلبي أفوهٌ ذربٌ","وفي الضمائر ما يغني عن اللَّسنِ",88,"ن",1,0],["فإن حضر النعمى فلست بغائبٍ","وإن وجد الحسنى فلست بعادمِ",89,"م",1,0],["فانحي يا تونس الخضرا بهمة من","يستسهل الصعب في إرضاك تسهيلا",90,"ل",2,0],["فإن حياته أسنى العطايا","إذا عدنا لتحقيق الكلام",91,"م",1,0],["فأنحوا لزرعي بالحصاد وأنضبوا","مياهاً لها أيدي سواهم مذانبُ",92,"ب",1,0],["فأنْحَى جازِرّ يَوْماً عَلَيْها","وضرج قاديهما بالدماء",93,"ا",2,0],["فَإِنْ حَملوا صَعْباً عَليك فَطالما","تَحمّلْتَ عَنهم مُضْلِعاتِ الصّعائبِ",94,"ب",1,0],["فَإِنْ حَجّبوكَ عَن لِقائِيَ بالثّرى","فَما حَجَبوا حزني عَليك بحاجِبِ",94,"ب",1,0],["فإن حققته وتركت حكماً","عليك له دفعت إلى الدواهي",95,"ي",1,0],["فإن حساها فبصدقٍ له","وإن تقايَى فبوسواس",96,"س",1,0],["فإن حانات دواويننا","خمارها يولي الغبوق الصبوح",97,"ح",1,0]]}