119,"ألا لله درك أي در","https://www.poetsgate.com/ViewPoem.aspx?id=16109",""],[3591,"أحنُّ على شطِ المزار إلى مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=149379",""],[3591,"أشد عوادي الدهر خلق لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=149432",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5190,"بيضة السندباد","https://www.poetsgate.com/ViewPoem.aspx?id=9666",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5688,"وقائلة لي","https://www.poetsgate.com/ViewPoem.aspx?id=204215",""],[5691,"الردح المعاكس","https://www.poetsgate.com/ViewPoem.aspx?id=206213",""],[5720,"منازل الخُلَّان","https://www.poetsgate.com/ViewPoem.aspx?id=206596",""],[5781,"حينَ يصيرُ الغيمُ أبيضَ","https://www.poetsgate.com/ViewPoem.aspx?id=202845",""],[402,"كساؤك ما يكسوك أهلك في مصر","https://www.poetsgate.com/ViewPoem.aspx?id=35731",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5791,"يا ضم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=209034",""],[5850,"عفتْ ذروة ٌ من أهلها فجفيرها","https://www.poetsgate.com/ViewPoem.aspx?id=19707",""],[5906,"أصالة","https://www.poetsgate.com/ViewPoem.aspx?id=188232",""],[5956,"أبي والغيد","https://www.poetsgate.com/ViewPoem.aspx?id=184883",""],[6120,"الحجاز","https://www.poetsgate.com/ViewPoem.aspx?id=213484",""],[6125,"كأنِّي غَدَاةَ البَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210565",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[5781,"أغرقتني بالحبِّ فذَبُلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87233&r=&rc=0",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["فإن حتفَ الفتى في العزِّ مَوْلِدُهُ","وإن خوفَ الردى في الذل مِنكَ رَدى",0,"د",2,0],["فَإِنَّ حَمِيَّةَ القُرَناءِ تَطغى","فَتَثلِمُ جانِبَ النَسَبِ القُرابِ",1,"ب",1,0],["فانْحَرْ ذوي إحَنٍ تَشْجى أضالِعُهُمْ","بهِنَّ نَحْرَ هَدايا مَكَّةَ الهَمَلِ",2,"ل",1,0],["فَإِنَّ حُبَّكِ قُربانٌ وَنافِلَةٌ","وَحُبَّ غَيرِكِ ذَنبٌ غَيرُ مَغفورِ",3,"ر",1,0],["فإنْ حمَلوا أفْنَوْا أو استُصْرِخوا حمَوْا","وإنْ بذَلُوا أغْنَوا عنِ الدِّيمِ الوَطْفِ",4,"ف",1,0],["فَإِن حَدِبوا فاقعَس وَإِن هُم تَقاعَسوا","ليَستَمكِنوا مِمّا وَراءَكَ فاحدَبِ",5,"ب",1,0],["فَإِن حِميَرٌ أَصلَحَت أَمرَها","وَمَلَّت تَساقِيَ أَولادِها",6,"د",3,0],["فَاِنحَلَّ ما كانَ مَعقوداً بِأَنفُسِنا","وَاِنبَتَّ ما كانَ مَوصولاً بِأَيدينا",7,"ن",2,0],["فَإِن حارَدَ المَعطونَ أَلفَيتَ كَفَّهُ","هَضوماً تَسُحُّ الخَيرَ مِن خُلُقٍ بَحرِ",8,"ر",1,0],["فإن حمراءها والله يكلؤُها","ياقوتةٌ فوق ذاك التاج يُعليها",9,"ي",3,0],["فإن حشا الإسلام أصبح دامياً","إلى الله يَشكو قلبه شدة الكرب",10,"ب",1,0],["فإنْ حموا بيضةَ الإسلام إنهمُ","من سادةٍ في صميم العرب أمحاح",11,"ح",1,0],["فانْحرْهما في يوم عيدك وابقَ ذا","مجدٍ تضيءُ بذكره الآفاق",12,"ق",1,0],["فإن حَقَّ ظني فاستقِلْني بمُتْرَصٍ","يقيني إذا ما القُرُّ أبدى المخالبا",13,"ب",2,0],["فإن حشدوا لأخ مرةً","أدلُّوا عليه دلالاً ثقيلا",14,"ل",2,0],["فأنحى على فضل الثراء بجوده","وما زال للأدواء أحسم حاسمِ",15,"م",1,0],["فَإِنَّ حَراما أَن أَخونَ أَمانَةً","وَآمَنَ نَفساً لَيسَ عِندي ضَميرُها",16,"ر",3,0],["فَاِنحَنى فَوقَها كَمُستَرِقِ الهَم","سِ يُطيلُ السُكوتَ وَالإِصغاءَ",17,"ا",2,0],["فَإِنَّ حَمِيتَنا أَبَداً حَرامٌ","وَلَيسَ لِجارِ مَنزِلِنا حَمِيتُ",18,"ت",1,0],["فَإِن حَسُنَت لَفظاً فَمِن رَوضِكَ اِجتَنى","وَإِن عَذُبَت شُرباً فَمِن بَحرِكَ اِستَقى",19,"ق",2,0],["فإن حقائق الأشياء سرُّ","خفي ما لغامضه انجلاء",20,"ا",2,0],["فَإِنَّ حَظَّكَ مِن تَكرارِها شَرَفٌ","وَحَظَّ غَيرِكَ مِنها الشَيبُ وَالكيرَ",21,"ر",1,0],["فَإِن حَلُموا فَإِنَّ الخَيلَ فيهِم","خِفافٌ وَالرِماحُ بِها عُرامُ",22,"م",1,0],["فَإِن حَسَرَت عَن فَضلِ نُعمى فَإِنَّها","مَطايا يُوَفّيكَ البَلاغَ حَسيرُها",23,"ر",3,0],["فإن حليت بالصهباء كأسي","كسوت علاك من حلي المقال",24,"ل",1,0],["فَإِن حالَ ذاكَ الرَأيُ فِيَّ فَطالَماٍ","أَحَلتَ صُروفَ الدَهرِ مُجتَهِداً عَنّي",25,"ن",2,0],["فَإِن حَسَدوا فَضلي وَعابوا مَحاسِني","وَذَلِكَ لِلتَقصيرِ عَنها وَلِلضِغنِ",26,"ن",1,0],["فإنْ حمانا اللهُ من شرِّهِ","وعدْتُ للعلمِ رجونا التئامْ",27,"م",1,0],["فإنْ حضرتُمْ كانَ من فضلِكُمْ","لا بدَّ للناسِ منَ الناسِ",28,"س",1,0],["فإنَّ حبرَ كاتبٍ","ربحٌ إذا هو انقلبْ",29,"ب",1,0],["فإنْ حَدَثَتْ مِنْ بَعْدِهَا نارُ فِرْيَةٍ","فما ذلك الشيءُ الفَرِيُّ وَلا الإِدُّ",30,"د",1,0],["فَأَنحى لَهُ في صَميمِ القَذالِ","فَشَكَّ المُزَمِّرَ أَو قَدَّه",31,"د",2,0],["فَإِنَّ حُدَيجاً لَهُ هِجرَةٌ","وَلَكِنَّها زَمَنَ الرِدَّه",31,"د",2,0],["فَإِنَّ حُدِّثتِ يَوماً عَن","فَتىً ماتَ مِنَ الحُبِّ",32,"ب",1,0],["فَإِنَّ حِبالَ الشَمسِ لَسنَ ثَوابِتاً","لِشَدِّ رِحالٍ أَو قَوابِضَ جُذَّبِ",33,"ب",1,0],["فَأَنحى عَلَيها ذاتَ حَدٍّ دَعا لَها","رَفيقاً بِأَخذٍ بِالمَداوِسِ صَيقَلا",34,"ل",2,0],["فإنّ حظّك من تكرارها شرفٌ","وحظّ غيرك منه الشّيب والكبر",35,"ر",1,0],["فَاِنحَدَرَت عُصفورَةٌ مِنَ الشَجَر","لَم يَنهَها النَهيُ وَلا الحَزمُ زَجَر",36,"ر",1,0],["فَإِنْ حَلَّ مَا أَعْطَاكَ رَبُّكَ مِن جَنىً","جَزَاءً لِمَا أَنْفَقْتَ فِيه مِن العُمْرِ",37,"ر",1,0],["فَإِن حُرِمَ العاصي أَبوكَ شَفاعَةً","تَكونُ لَهُ عِزّاً هَوى لِهَوانِ",38,"ن",1,0],["فإن حملوا أقنوا أو استصرخوا حموا","وإن بذلوا أغنوا عن الديم الوطف",39,"ف",1,0],["فانحنى (عمرو) وقال : اذكر لنا","يا (علي) الأمس واترك ما اجترح",40,"ح",1,0],["فانحنى جاره وقال : أجنبي","هل ترى صحبتي شنارا وعارا",41,"ر",2,0],["فإنّ حروفي اختلاج السهول","وشوق السواقي ، وخفق الهضاب",42,"ب",1,0],["فإن حظك من تكرارها شرف","وحظ غيرك منها الشيب والكبر",43,"ر",1,0],["فإن حلّت قواك جيوش ضعف","وهالك عبء همّ مسبطر",44,"ر",1,0],["فإنْ حِيزَتِ الدُّنيا إِليهم فإنَّ مَنْ","