{"poems":[[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[63,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[55,"ما كان في الدور من أنس بغيركم","https://www.aldiwan.net/poem26293.html","البسيط"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[42,"إذا كنت مظلوما فلا تلف راضيا","https://www.aldiwan.net/poem50218.html","الطويل"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"تشبيب مدحك مطرب لكنه","https://www.aldiwan.net/poem19357.html","الكامل"],[51,"أبا جعفر لا زلت معطى وواهبا","https://www.aldiwan.net/poem8161.html","الطويل"],[51,"رأيت الأخلاء في دهرنا","https://www.aldiwan.net/poem65957.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[26,"وما حمل البختي عام غياره","https://www.aldiwan.net/poem24080.html","الطويل"],[91,"سمع الليل ذو النجوم أنينا","https://www.aldiwan.net/poem8731.html","عموديه"],[14,"أفي ناب منحناها فقيرا","https://www.aldiwan.net/poem38314.html","الوافر"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[43,"الصوم والفطر والأعياد والعصر","https://www.aldiwan.net/poem9566.html","البسيط"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[61,"أفق من سكرة الأمل المحال","https://www.aldiwan.net/poem51465.html","الوافر"],[66,"عهدتك بي دهرا ضنينا على العدى","https://www.aldiwan.net/poem38662.html","الطويل"],[66,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[69,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[69,"حضوركم غاية إيناسي","https://www.aldiwan.net/poem28622.html","السريع"],[69,"انقلب الحبر على","https://www.aldiwan.net/poem29055.html","مجزوء الرجز"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[46,"أرى اللب مرآة اللبيب ومن يكن","https://www.aldiwan.net/poem22163.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141000",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19310","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[77,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""],[43,"الصوم والفطر والأعياد والعصر","https://www.poetsgate.com/ViewPoem.aspx?id=208",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["فَإِنَّ حَمِيَّةَ القُرَناءِ تَطغى","فَتَثلِمُ جانِبَ النَسَبِ القُرابِ",0,"ب",1,0],["فانْحَرْ ذوي إحَنٍ تَشْجى أضالِعُهُمْ","بهِنَّ نَحْرَ هَدايا مَكَّةَ الهَمَلِ",1,"ل",1,0],["فَإِنَّ حُبَّكِ قُربانٌ وَنافِلَةٌ","وَحُبَّ غَيرِكِ ذَنبٌ غَيرُ مَغفورِ",2,"ر",1,0],["فإنْ حمَلوا أفْنَوْا أو استُصْرِخوا حمَوْا","وإنْ بذَلُوا أغْنَوا عنِ الدِّيمِ الوَطْفِ",3,"ف",1,0],["فَإِن حَدِبوا فاقعَس وَإِن هُم تَقاعَسوا","ليَستَمكِنوا مِمّا وَراءَكَ فاحدَبِ",4,"ب",1,0],["فَإِن حِميَرٌ أَصلَحَت أَمرَها","وَمَلَّت تَساقِيَ أَولادِها",5,"د",3,0],["فَاِنحَلَّ ما كانَ مَعقوداً بِأَنفُسِنا","وَاِنبَتَّ ما كانَ مَوصولاً بِأَيدينا",6,"ن",2,0],["فَإِن حارَدَ المَعطونَ أَلفَيتَ كَفَّهُ","هَضوماً تَسُحُّ الخَيرَ مِن خُلُقٍ بَحرِ",7,"ر",1,0],["فإن حمراءها والله يكلؤُها","ياقوتةٌ فوق ذاك التاج يُعليها",8,"ي",3,0],["فإن حشا الإسلام أصبح دامياً","إلى الله يَشكو قلبه شدة الكرب",9,"ب",1,0],["فإنْ حموا بيضةَ الإسلام إنهمُ","من سادةٍ في صميم العرب أمحاح",10,"ح",1,0],["فانْحرْهما في يوم عيدك وابقَ ذا","مجدٍ تضيءُ بذكره الآفاق",11,"ق",1,0],["فإن حَقَّ ظني فاستقِلْني بمُتْرَصٍ","يقيني إذا ما القُرُّ أبدى المخالبا",12,"ب",2,0],["فإن حشدوا لأخ مرةً","أدلُّوا عليه دلالاً ثقيلا",13,"ل",2,0],["فأنحى على فضل الثراء بجوده","وما زال للأدواء أحسم حاسمِ",14,"م",1,0],["فَإِنَّ حَراما أَن أَخونَ أَمانَةً","وَآمَنَ نَفساً لَيسَ عِندي ضَميرُها",15,"ر",3,0],["فَاِنحَنى فَوقَها كَمُستَرِقِ الهَم","سِ يُطيلُ السُكوتَ وَالإِصغاءَ",16,"ا",2,0],["فَإِنَّ حَمِيتَنا أَبَداً حَرامٌ","وَلَيسَ لِجارِ مَنزِلِنا حَمِيتُ",17,"ت",1,0],["فَإِن حَسُنَت لَفظاً فَمِن رَوضِكَ اِجتَنى","وَإِن عَذُبَت شُرباً فَمِن بَحرِكَ اِستَقى",18,"ق",2,0],["فإن حقائق الأشياء سرُّ","خفي ما لغامضه انجلاء",19,"ا",2,0],["فَإِنَّ حَظَّكَ مِن تَكرارِها شَرَفٌ","وَحَظَّ غَيرِكَ مِنها الشَيبُ وَالكيرَ",20,"ر",1,0],["فَإِن حَلُموا فَإِنَّ الخَيلَ فيهِم","خِفافٌ وَالرِماحُ بِها عُرامُ",21,"م",1,0],["فَإِن حَسَرَت عَن فَضلِ نُعمى فَإِنَّها","مَطايا يُوَفّيكَ البَلاغَ حَسيرُها",22,"ر",3,0],["فإن حليت بالصهباء كأسي","كسوت علاك من حلي المقال",23,"ل",1,0],["فَإِن حالَ ذاكَ الرَأيُ فِيَّ فَطالَماٍ","أَحَلتَ صُروفَ الدَهرِ مُجتَهِداً عَنّي",24,"ي",1,0],["فَإِن حَسَدوا فَضلي وَعابوا مَحاسِني","وَذَلِكَ لِلتَقصيرِ عَنها وَلِلضِغنِ",25,"ن",1,0],["فإنْ حمانا اللهُ من شرِّهِ","وعدْتُ للعلمِ رجونا التئامْ",26,"م",1,0],["فإنْ حضرتُمْ كانَ من فضلِكُمْ","لا بدَّ للناسِ منَ الناسِ",27,"س",1,0],["فإنَّ حبرَ كاتبٍ","ربحٌ إذا هو انقلبْ",28,"ب",1,0],["فإنْ حَدَثَتْ مِنْ بَعْدِهَا نارُ فِرْيَةٍ","فما ذلك الشيءُ الفَرِيُّ وَلا الإِدُّ",29,"د",1,0],["فَأَنحى لَهُ في صَميمِ القَذالِ","فَشَكَّ المُزَمِّرَ أَو قَدَّه",30,"د",2,0],["فَإِنَّ حُدَيجاً لَهُ هِجرَةٌ","وَلَكِنَّها زَمَنَ الرِدَّه",30,"د",2,0],["فَإِنَّ حُدِّثتِ يَوماً عَن","فَتىً ماتَ مِنَ الحُبِّ",31,"ب",1,0],["فَإِنَّ حِبالَ الشَمسِ لَسنَ ثَوابِتاً","لِشَدِّ رِحالٍ أَو قَوابِضَ جُذَّبِ",32,"ب",1,0],["فَأَنحى عَلَيها ذاتَ حَدٍّ دَعا لَها","رَفيقاً بِأَخذٍ بِالمَداوِسِ صَيقَلا",33,"ل",2,0],["فإنّ حظّك من تكرارها شرفٌ","وحظّ غيرك منه الشّيب والكبر",34,"ر",1,0],["فَاِنحَدَرَت عُصفورَةٌ مِنَ الشَجَر","لَم يَنهَها النَهيُ وَلا الحَزمُ زَجَر",35,"ر",1,0],["فَإِنْ حَلَّ مَا أَعْطَاكَ رَبُّكَ مِن جَنىً","جَزَاءً لِمَا أَنْفَقْتَ فِيه مِن العُمْرِ",36,"ر",1,0],["فَإِن حُرِمَ العاصي أَبوكَ شَفاعَةً","تَكونُ لَهُ عِزّاً هَوى لِهَوانِ",37,"ن",1,0],["فإن حملوا أقنوا أو استصرخوا حموا","وإن بذلوا أغنوا عن الديم الوطف",38,"ف",1,0],["فإنّ حروفي اختلاج السهول","وشوق السواقي ، وخفق الهضاب",39,"ب",1,0],["فإن حظك من تكرارها شرف","وحظ غيرك منها الشيب والكبر",40,"ر",1,0],["فإنْ حِيزَتِ الدُّنيا إِليهم فإنَّ مَنْ","نَفَى زَيْفَهَا سَلْماً إِليهم لناقِدُ",41,"د",1,0]]}