//www.aldiwan.net/poem45428.html","الطويل"],[341,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[346,"فانحنى نحوه قليلاً فالفى","https://www.aldiwan.net/poem55368.html","الخفيف"],[350,"وشمسة كرم برجها قعر دنها","https://www.aldiwan.net/poem24121.html","الطويل"],[357,"أرى ما كل من يدعى حبيبا","https://www.aldiwan.net/poem40550.html","الوافر"],[368,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[381,"عفت نفسي أمانيها","https://www.aldiwan.net/poem59166.html","مجزوء الوافر"],[395,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[407,"لك البشارة هذا منتهى أربي","https://www.aldiwan.net/poem34150.html","البسيط"],[409,"أراح الله من زمان","https://www.aldiwan.net/poem49652.html","الوافر"],[409,"إذا كنت متخذا صاحبا","https://www.aldiwan.net/poem49883.html","المتقارب"],[410,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[420,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[441,"ترفّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[441,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[443,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[445,"وأما الصلاة والصيام ومثله","https://www.aldiwan.net/poem14403.html","الطويل"],[452,"اكسير الحياة","https://www.aldiwan.net/poem1020.html","عموديه"],[464,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[464,"قل للمجاهد لا زالت عوارفه","https://www.aldiwan.net/poem15157.html","البسيط"],[467,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[482,"الحقائق هبها اليوم تمثيلا","https://www.aldiwan.net/poem36953.html","البسيط"],[518,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[530,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[532,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[554,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[561,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[561,"أنا كتاب الله في الناس","https://www.aldiwan.net/poem34436.html","السريع"],[561,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[671,"","https://poetry.dctabudhabi.ae/diwan/poem/124791","البسيط"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/17737","البسيط"]],"verses":[["فإن حتفَ الفتى في العزِّ مَوْلِدُهُ","وإن خوفَ الردى في الذل مِنكَ رَدى",0,"د",2,0],["فَإِنَّ حَمِيَّةَ القُرَناءِ تَطغى","فَتَثلِمُ جانِبَ النَسَبِ القُرابِ",1,"ب",1,0],["فانْحَرْ ذوي إحَنٍ تَشْجى أضالِعُهُمْ","بهِنَّ نَحْرَ هَدايا مَكَّةَ الهَمَلِ",2,"ل",1,0],["فَإِنَّ حُبَّكِ قُربانٌ وَنافِلَةٌ","وَحُبَّ غَيرِكِ ذَنبٌ غَيرُ مَغفورِ",3,"ر",1,0],["فإنْ حمَلوا أفْنَوْا أو استُصْرِخوا حمَوْا","وإنْ بذَلُوا أغْنَوا عنِ الدِّيمِ الوَطْفِ",4,"ف",1,0],["فَإِن حَدِبوا فاقعَس وَإِن هُم تَقاعَسوا","ليَستَمكِنوا مِمّا وَراءَكَ فاحدَبِ",5,"ب",1,0],["فَإِن حِميَرٌ أَصلَحَت أَمرَها","وَمَلَّت تَساقِيَ أَولادِها",6,"د",3,0],["فَاِنحَلَّ ما كانَ مَعقوداً بِأَنفُسِنا","وَاِنبَتَّ ما كانَ مَوصولاً بِأَيدينا",7,"ن",2,0],["فَإِن حارَدَ المَعطونَ أَلفَيتَ كَفَّهُ","هَضوماً تَسُحُّ الخَيرَ مِن خُلُقٍ بَحرِ",8,"ر",1,0],["فإن حمراءها والله يكلؤُها","ياقوتةٌ فوق ذاك التاج يُعليها",9,"ي",3,0],["فإن حشا الإسلام أصبح دامياً","إلى الله يَشكو قلبه شدة الكرب",10,"ب",1,0],["فإنْ حموا بيضةَ الإسلام إنهمُ","من سادةٍ في صميم العرب أمحاح",11,"ح",1,0],["فانْحرْهما في يوم عيدك وابقَ ذا","مجدٍ تضيءُ بذكره الآفاق",12,"ق",1,0],["فإن حَقَّ ظني فاستقِلْني بمُتْرَصٍ","يقيني إذا ما القُرُّ أبدى المخالبا",13,"ب",2,0],["فإن حشدوا لأخ مرةً","أدلُّوا عليه دلالاً ثقيلا",14,"ل",2,0],["فأنحى على فضل الثراء بجوده","وما زال للأدواء أحسم حاسمِ",15,"م",1,0],["فَإِنَّ حَراما أَن أَخونَ أَمانَةً","وَآمَنَ نَفساً لَيسَ عِندي ضَميرُها",16,"ر",3,0],["فَاِنحَنى فَوقَها كَمُستَرِقِ الهَم","سِ يُطيلُ السُكوتَ وَالإِصغاءَ",17,"ا",2,0],["فَإِنَّ حَمِيتَنا أَبَداً حَرامٌ","وَلَيسَ لِجارِ مَنزِلِنا حَمِيتُ",18,"ت",1,0],["فَإِن حَسُنَت لَفظاً فَمِن رَوضِكَ اِجتَنى","وَإِن عَذُبَت شُرباً فَمِن بَحرِكَ اِستَقى",19,"ق",2,0],["فإن حقائق الأشياء سرُّ","خفي ما لغامضه انجلاء",20,"ا",2,0],["فَإِنَّ حَظَّكَ مِن تَكرارِها شَرَفٌ","وَحَظَّ غَيرِكَ مِنها الشَيبُ وَالكيرَ",21,"ر",1,0],["فَإِن حَلُموا فَإِنَّ الخَيلَ فيهِم","خِفافٌ وَالرِماحُ بِها عُرامُ",22,"م",1,0],["فَإِن حَسَرَت عَن فَضلِ نُعمى فَإِنَّها","مَطايا يُوَفّيكَ البَلاغَ حَسيرُها",23,"ر",3,0],["فإن حليت بالصهباء كأسي","كسوت علاك من حلي المقال",24,"ل",1,0],["فَإِن حالَ ذاكَ الرَأيُ فِيَّ فَطالَماٍ","أَحَلتَ صُروفَ الدَهرِ مُجتَهِداً عَنّي",25,"ن",2,0],["فَإِن حَسَدوا فَضلي وَعابوا مَحاسِني","وَذَلِكَ لِلتَقصيرِ عَنها وَلِلضِغنِ",26,"ن",1,0],["فإنْ حمانا اللهُ من شرِّهِ","وعدْتُ للعلمِ رجونا التئامْ",27,"م",1,0],["فإنْ حضرتُمْ كانَ من فضلِكُمْ","لا بدَّ للناسِ منَ الناسِ",28,"س",1,0],["فإنَّ حبرَ كاتبٍ","ربحٌ إذا هو انقلبْ",29,"ب",1,0],["فإنْ حَدَثَتْ مِنْ بَعْدِهَا نارُ فِرْيَةٍ","فما ذلك الشيءُ الفَرِيُّ وَلا الإِدُّ",30,"د",1,0],["فَأَنحى لَهُ في صَميمِ القَذالِ","فَشَكَّ المُزَمِّرَ أَو قَدَّه",31,"د",2,0],["فَإِنَّ حُدَيجاً لَهُ هِجرَةٌ","وَلَكِنَّها زَمَنَ الرِدَّه",31,"د",2,0],["فَإِنَّ حُدِّثتِ يَوماً عَن","فَتىً ماتَ مِنَ الحُبِّ",32,"ب",1,0],["فَإِنَّ حِبالَ الشَمسِ لَسنَ ثَوابِتاً","لِشَدِّ رِحالٍ أَو قَوابِضَ جُذَّبِ",33,"ب",1,0],["فَأَنحى عَلَيها ذاتَ حَدٍّ دَعا لَها","رَفيقاً بِأَخذٍ بِالمَداوِسِ صَيقَلا",34,"ل",2,0],["فإنّ حظّك من تكرارها شرفٌ","وحظّ غيرك منه الشّيب والكبر",35,"ر",1,0],["فَاِنحَدَرَت عُصفورَةٌ مِنَ الشَجَر","لَم يَنهَها النَهيُ وَلا الحَزمُ زَجَر",36,"ر",1,0],["فَإِنْ حَلَّ مَا أَعْطَاكَ رَبُّكَ مِن جَنىً","جَزَاءً لِمَا أَنْفَقْتَ فِيه مِن العُمْرِ",37,"ر",1,0],["فَإِن حُرِمَ العاصي أَبوكَ شَفاعَةً","تَكونُ لَهُ عِزّاً هَوى لِهَوانِ",38,"ن",1,0],["فإن حملوا أقنوا أو استصرخوا حموا","وإن بذلوا أغنوا عن الديم الوطف",39,"ف",1,0],["فانحنى (عمرو) وقال : اذكر لنا","يا (علي) الأمس واترك ما اجترح",40,"ح",1,0],["فانحنى جاره وقال : أجنبي","هل ترى صحبتي شنارا وعارا",41,"ر",2,0],["فإنّ حروفي اختلاج السهول","وشوق السواقي ، وخفق الهضاب",42,"ب",1,0],["فإن حظك من تكرارها شرف","وحظ غيرك منها الشيب والكبر",43,"ر",1,0],["فإن حلّت قواك جيوش ضعف","وهالك عبء همّ مسبطر",44,"ر",1,0],["فإنْ حِيزَتِ الدُّنيا إِليهم فإنَّ مَنْ","نَفَى زَيْفَهَا سَلْماً إِليهم لناقِدُ",45,"د",1,0],["فانحلَّ عقد نظامهم","مِن قبلُ بالموتِ الزؤامِ",46,"م",1,0],["فَإِنَّ حِزاماً لَدى مَعرَكٍ","وَإِخوَتَهُم حَولَهُم أَنسُرُ",47,"ر",1,0],["فَإِن حُصِّلَت أَشرافُ عَبدِ مَنافِها","فَفي هاشِمٍ أَشرافُها وَقَديمُها",48,"م",3,0],["فإن حكمتَ فحقٌ ما تسطره","ولا تنال به في الحي إنكارا",49,"ر",2,0],["فإن حزَّ الفَوارِى في أديمى","فلا عيبٌ إذا ما السيفُ فُلاَّ",50,"ل",2,0],["فإن حسدت امرأً فيما يخصُّ له","فاذهب فمالك إلاَّ الإِثمُ والكمد",51,"د",1,0],["فإن حاولت نعماء هذا أو انها","وإن أملت علياً فذا الحين حينها",52,"ن",3,0],["فإِن حالَ نَأيٌ دونَكُم وَتَعَرَّضَت","غُروبُ خُطوبٍ لِلقُلوبِ نَواقِثِ",53,"ث",1,0],["فَأَنحَت عَلى أَرحامِها بِشِفارِها","وَأَوهَنَ عَظمَ الأَقرَبينَ اِصطِلابُها",54,"ب",3,0],["فَإِن حَنَّ قَلبي نَحوَكُم أَو شَكا جَوىً","فَصادَفَ مِن زُرقِ الأَسِنَّةِ لَهذَما",55,"م",2,0],["فإن حصل التجمّل فيه يوما","وجدت مضيعا لأدا الحقوق",56,"ق",1,0],["فإن حببي مَن يحبُّ تَنَعُّمي","وليس حبيبي مَن يحبُّ شقائي",57,"ا",2,0],["فإنَّ حراماً أن تُعَرَّض مهجة","لموتٍ ولم يُعلَم مكانُ مصيرِها",58,"ر",3,0],["فإن حلَّ أرضاً حلَّها كلُّ منكَرٍ","وَقَلَّتْ بها الأرزاق والخيرُ راحِلُ",59,"ل",1,0],["فإن حمدته الناس فهو محمد","وإن عجبوا من حسنه فهو يوسف",60,"ف",1,0],["فإن حبكم وسط الحشاشة لا","تناله غير الأيام والنوب",61,"ب",1,0],["فَاِنحَطَّ حينَئِذٍ وَأَخبرَ جَدَّهُ","بِنُبُوَّةِ الوَلَدِ العَظيمِ الشّانِ",62,"ن",1,0],["فَأَنحوا بِالصَوارِمِ مُسرِعاتٍ","عَلى البَرِّ النَقِيِّ اِبنِ النَقِيِّ",63,"ي",1,0],["فأن حال جدى دون جدى عن المنى","فكم من فتى بالسعي لا يبلغ المدى",64,"د",2,0],["فإن حنفيا قلت قالوا بأنني","ابيح الطلا وهو الشراب المحرم",65,"م",1,0],["فإن حادَثتَهم بالخيرِ ملُّوا","فأقصِر ما استطعتَ عن الحديث",66,"ث",1,0],["فإنّ حِجابَ عفّتها رَقيقٌ","يُحاولُ كلّ يومٍ أن يَطيرا",67,"ر",2,0],["فَأَنحَنِي مُمَهِّدا","إِلَى جَوابِهِ القَلَمْ",68,"م",1,0],["فَإنْ حَانَ مَنْكُوباً ونَكَّبَ حَائِناً","لَقَدْ حَصَّ مُنْفَلاً وَأفْلَتَ مَنْحَصَّا",69,"ص",2,0],["فإِنْ حُطِمَ اللَّدْنُ فَالْعَضْبُ باقٍ","وَإِنْ أَقْلَعَ الْغَيْثُ فَالْبَحْرُ طامِ",70,"م",1,0],["فإنَّ حسنَ العِشرَة","ما حازَ قَومٌ عُشرَه",71,"ه",1,0],["فَإِنَّ حَمدكَ مَن لَم تَبلُهُ صَلَفٌ","وَإِنَّ ذَمَّكَ بَعدَ الحَمد تَكذيبُ",72,"ب",1,0],["فَأَنحى إِلَيها ذاتَ حَدٍّ غُرابُها","عَدُوٌّ لِأَوساطِ العِضاهِ مُشارِزُ",73,"ز",1,0],["فَإِن حَلَّتِ المَيلاءُ عُسفانَ أَو دَنَت","لِحَرَّةِ لَيلى أَو لِبَدرٍ مَصيرُها",74,"ر",3,0],["فانحنى نحوه قليلاً فالفى","شبح الموت فوقه في خفوقِ",75,"ق",1,1],["فَإِن حُرِّمَت يَوماً عَلى دينِ أَحمَدٍ","فَخُذها عَلى دينِ المَسيحِ بنِ مَريَمِ",76,"م",1,0],["فَإِنّ حَبيب في بَعض الأَسامي","تَراهُ إِذا تصحّفه خَبيثا",77,"ث",2,0],["فإن حُمدَتْ طَرائقُه فنَلْقَى","من الحمدِ اسْمَه الأعلَى اشْتِقاقا",78,"ق",2,0],["فإن حزت القُوى فيها","فغرِّد في قوافيها",79,"ي",3,0],["فإن حصلتم وصفا فنوا","والا فامنحوني بالدعاء",80,"ا",2,0],["فإن حقك عندي لا يفي به","نظمي ولو كان معدوداً من النخب",81,"ب",1,0],["فإن حَمِدَ الكَريمُ صباحَ يَومٍ","وأنَّى ذاكَ لم يَحْمَدْ مساءَهْ",82,"ه",1,0],["فإنْ حلَّ أرضاً نوى غيرَها","وانْ سَرّ يوماً بوَصل فَجَعْ",83,"ع",1,0],["فانحَلَّ سِلكَ الدَمعِ في ثَغرِها","فَشَجَّت الخَمرُ بِماءٍ قراح",84,"ح",1,0],["فإنْ حضر الفساد وغبتَ عنه","ولم تكُ من يُعَدُّ من الحضور",85,"ر",1,0],["فإن حفاظا إن وقفت بدارهم","لتبكي خليطا بأن أو منزلا أقوى",86,"و",2,0],["فانحروا ولا تنحر عداك فإنما","بعداوة لهم العيوب تعدّد",87,"د",1,0],["فإنْ حَمَلَتْ من بعدِها سَيْفَ فِتْنَةٍ","يَدٌ فَتَخَلَّتْ من أنامِلِهَا الخَمْسِ",88,"س",1,0],["فإِن حان وقت الفرض ليس موسَّعا","له الجَهل إِلا أَن يؤدي ويذهبا",89,"ب",2,0],["فإن حلقت ألفاظه وتألقت","معانيه فالحب الجميل أميره",90,"ر",2,0],["فإن حربٌ فعمروٌ في زُبيدٍ","وإنْ نُطْقٌ فقُسٌّ في إيادٍ",91,"د",1,0],["فإنْ حَصرتُ فقلبي أفوهٌ ذربٌ","وفي الضمائر ما يغني عن اللَّسنِ",92,"ن",1,0],["فإن حضر النعمى فلست بغائبٍ","وإن وجد الحسنى فلست بعادمِ",93,"م",1,0],["فانحي يا تونس الخضرا بهمة من","يستسهل الصعب في إرضاك تسهيلا",94,"ل",2,0],["فإن حياته أسنى العطايا","إذا عدنا لتحقيق الكلام",95,"م",1,0],["فأنحوا لزرعي بالحصاد وأنضبوا","مياهاً لها أيدي سواهم مذانبُ",96,"ب",1,0],["فأنْحَى جازِرّ يَوْماً عَلَيْها","وضرج قاديهما بالدماء",97,"ا",2,0],["فَإِنْ حَملوا صَعْباً عَليك فَطالما","تَحمّلْتَ عَنهم مُضْلِعاتِ الصّعائبِ",98,"ب",1,0],["فَإِنْ حَجّبوكَ عَن لِقائِيَ بالثّرى","فَما حَجَبوا حزني عَليك بحاجِبِ",98,"ب",1,0],["فإن حققته وتركت حكماً","عليك له دفعت إلى الدواهي",99,"ي",1,0],["فإن حساها فبصدقٍ له","وإن تقايَى فبوسواس",100,"س",1,0],["فإن حانات دواويننا","خمارها يولي الغبوق الصبوح",101,"ح",1,0],["فإن حراً من الأنساب ألبسه","ريش الندى والندى من خير أكفان",102,"ن",1,0],["فَاِنحازَ لا آمِناً مِن شَرِّ نَبأَتِهِم","يَعلو العَدابَ وَلا مُستَمعِناً هَرَبا",103,"ب",2,0]]}