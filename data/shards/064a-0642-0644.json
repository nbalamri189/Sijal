,""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5829,"حبل الله المتين","https://www.poetsgate.com/ViewPoem.aspx?id=202151",""],[5952,"وحْدي","https://www.poetsgate.com/ViewPoem.aspx?id=196822",""],[6026,"مرآة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=214648",""],[6068,"الجامعي -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175916",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[5781,"مَرايا الوَقْت في قُشورِ الرُّوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87239&r=&rc=6",""]],"verses":[["يُقَلَّبُ لي في مِحجَرَي أُمَّ شادِنٍ","تَجَفَّلُ أَو يَدنو دُنوّاً عَلى ذُعرِ",0,"ر",1,0],["يَقُل إِنَّ ذاكَ اللَيثَ في كُلِّ مَعرَكٍ","وَهَذا الحُسامُ العَضبُ في كُلِّ مَضرِبِ",1,"ب",1,0],["يُقَلِّبُ عَيْناً لا يزالُ لدى الوَغى","يَذُرُّ عليها منْ خَبيئَتِهِ الزَّنْدُ",2,"د",1,0],["يُقلِقُني الشَوقُ فَآتيكُمُ","وَالقَلبُ مَملوءٌ مِنَ الياسِ",3,"س",1,0],["يُقلِّبُ تحْتَ النّقْعِ مُقلَةَ ضاحِكٍ","إذا التَفَتَ الأبْطالُ عنْ مُقَلٍ شُوسِ",4,"س",1,0],["يُقَلِّبُ سَمحَجاً فيها إِباءٌ","عَلى أَن سَوفَ تَأتي ما يَكيدُ",5,"د",1,0],["يَقُلنَ حَياةٌ بَعدَ مَوتِكَ مُرَّةٌ","وَهُنَّ إِذا قَفَّينَ عَنكَ ذَواهِلُ",6,"ل",1,0],["يَقُلنَ حَرامٌ ما أُحِلَّ بِرَبِّنا","وَتَترُكُ أَموالاً عَلَيها الخَواتِمُ",7,"م",1,0],["يُقَلِّبُ لِلأَصواتِ وَالريحِ هادِياً","تَميمَ النَضِيِّ بَرَّصَتهُ المَكادِمُ",8,"م",1,0],["يُقَلِّبُ حَشَراتٍ وَيَختارُ نابِلٌ","مِنَ الريشِ ما اِلتَفَّت عَلَيهِ القَوادِمُ",8,"م",1,0],["يُقَلِّبُ حُقباً تَرى كُلَّهُنَّ","قَد حَمَلَت وَأَسَرَّت جَنينا",9,"ن",2,0],["يُقَلِّبُ عَيني حَيَّةٍ بِمَحارَةٍ","أَضافَ إِلَيها السَارِياتِ سَبيلُها",10,"ل",3,0],["يقلِّبُ عَينَي أزرَقٍ فوقَ مَرقَبٍ","يَفاعٍ لَهُ دونَ السَماءِ لُصوبُ",11,"ب",1,0],["يقلب في ألحاظاً","جوائل كل تجوال",12,"ل",1,0],["يُقَلِّبنَ مِن شُعَراءِ صَيفٍ كَأَنَّها","مَوارِقَ لِلَدغِ اِنخِزامُ مَرامِ",13,"م",1,0],["يُقَلَّبُ أَشباهاً كَأَنَّ مُتونَها","بِمُستَرشَحِ البُهمى مِنَ الصَخرِ صَردَحُ",14,"ح",1,0],["يُقَلِّبُ بِالصِمّانِ قوداً جَريَدة","تَرامى بِهِ قيعانُهُ وَأَخاشِبُه",15,"ب",2,0],["يقلّ كروباً بعضها فوق بعضها","إذا ما رمى كرباً رأى تحته كربا",16,"ب",2,0],["يَقُلنَ وَقَد تَلاحَقَتِ المَطايا","كَذاكَ القَولُ إِنَّ عَلَيكَ عَينا",17,"ن",2,0],["يُقَلِّصُ بِالفَضلَينِ فَضلِ مُفاضَةٍ","وَفَضلِ نِجادٍ لَم تُقَطَّع حَمائِلُه",18,"ل",2,0],["يَقُلنَ إِذا ما حَلَّ دَينُكَ عِندَنا","وَخَيرُ الَّذي يُقضى مِنَ الدينِ عاجِلُه",19,"ل",2,0],["يُقَلِّبُ أَطرافَ الأُمورِ تَخالُهُ","بِأَحناءِ ساقٍ آخَرَ اللَيلِ ماثِلا",20,"ل",2,0],["يَقُلنَ لَهُ السَلامَةُ خَيرُ غُنمٍ","وَإِنَّ الذُلَّ في ذاكَ المَقالِ",21,"ل",1,0],["يقلِّب لي وجدِي به سوط سائق","وإرخاء سرحانٍ وتقريب تتفل",22,"ل",1,0],["يقلّ لذكره الإقبال قدماً","وكيف يقاس ذو زين بشين",23,"ن",1,0],["يقلق من حسن ما يجيء به ال","زمِّيت بل يطمئن ذو القلق",24,"ق",1,0],["يُقلِّبهُ برأيٍ لا تجزَّا","ولا يخبو لقدحته ضرامُ",25,"م",1,0],["يُقلِّبُ جُثماناً عظيماً مُوَثَّقاً","يهدُّ برُكنَيْهِ الجبالَ إذا زحمْ",26,"م",1,0],["يقلقِل أحشاءه باركاً","بعَرْد طويلٍ غليظٍ متين",27,"ن",1,0],["يَقُلنَ لا أَنتَ بَعلٌ يُستَقادُ لَهُ","وَلا الشَبابُ الَّذي قَد فاتَ مَردودُ",28,"د",1,0],["يُقَلِّصُ عَن زُغبٍ صِغارٍ كَأَنَّها","إِذا دَرَجَت تَحتَ الظِلالِ أَفاني",29,"ن",2,0],["يَقِلنَ إِذا ما اِستَقبَلَ الصَيفُ وَقدَةً","وَحَرَّ عَلى الجُدِّ الظَنونِ فَأَنفَدا",30,"د",2,0],["يُقَلِّصُ بِالسَيفِ الطَويلِ نِجادُهُ","خَميصٌ إِذا السِربالُ عَنهُ تَقَدَّدا",30,"د",2,0],["يُقَلِّبُ زَرقاوَينِ في مُجرَهِدَّةٍ","فَلا هُوَ مَسبوقٌ وَلا الطَرفُ كاذِبُ",31,"ب",1,0],["يُقَلِّبُ في الأَرضِ الفَضاءِ بِطَرفِهِ","وَهُنَّ مُناخاتٌ وَمِرجَلُنا يَغلي",32,"ل",2,0],["يَقِلُّ بِها بَذلُ النُفوسِ بِشارَةً","وَيَصغُرُ فيها كُلُّ شَيءٍ مِنَ النَذرِ",33,"ر",1,0],["يُقَلِّبُ عَينَي فَرقَدٍ بِخَميلَةٍ","كَساها نَصِيُّ الخِلفَةِ المُتَرَوِّحُ",34,"ح",1,0],["يُقَلِّبُ سَمحَجاً قَوداءَ كانَت","حَليلَتَهُ فَشَدَّ بِها غِيارا",35,"ر",2,0],["يُقَلِّبُ بِالأَنامِلِ مُرهَفاتٍ","كَساهُنَّ المَناكِبَ وَالظُهارا",35,"ر",2,0],["يَقِلنَ بِعاسِمَينِ وَذاتِ رُمحٍ","إِذا حانَ المَقيلُ وَيَرتَعينا",36,"ن",2,0],["يَقِلُّ لعينيك أَن يَجعَلوا","سَوادَ العيونِ عَلَيكُم شِعارا",37,"ر",2,0],["يُقِلُّ مِنَ الفِتيانِ أَشبالَ غابَةٍ","غُداةً عَلى الأَخطارِ رُكّابَ أَهوالِ",38,"ل",1,0],["يَقِلُّ لِلعِلمِ عِندَ العارِفينَ بِهِ","ما تَقدِرُ النَفسُ مِن حُبٍّ وَإِجلالِ",39,"ل",1,0],["يَقُلنَ لِمَن أَهوى وَآنَسنَ ريبَةً","نَرى حالَةً بَينَ الصَبابَةِ وَالسِحرِ",40,"ر",1,0],["يَقِلُّ أَبو المِسكِ عَبداً لَهُ","وَإِن صاغَ أَحمَدُ فيهِ الدُرَر",41,"ر",1,0],["يُقلِقُهُ الصُبحُ لا يَرى مَعَهُ","بُشرى بِفَتحٍ كَأَنَّهُ فاقِد",42,"د",1,0],["يَقِلُّ لَهُ القِيامُ عَلى الرُؤوسِ","وَبَذلُ المُكرَماتِ مِنَ النُفوسِ",43,"س",1,1],["يَقلي مُفارَقَةَ الأَكُفِّ قَذالُهُ","حَتّى يَكادَ عَلى يَدٍ يَتَعَمَّمُ",44,"م",1,0],["يُقَلِّلُها بِالشُكرِ إِن هِيَ كَثَّرَت","وَيُكثِرُها بِالعُذرِ إِن هِيَ قَلَّتِ",45,"ت",1,0],["يَقِلُّ غَناءُ القَوسِ نَبعٌ نِجارُها","وَساعِدُ مَن يَرمي عَنِ القَوسِ خِروَعُ",46,"ع",1,0],["يُقَلِّبُ عَينَيهِ وَيوحي بِطَرفِهِ","إِلَيَّ بِلَحنٍ يَترُكُ القَلبَ موجَعا",47,"ع",2,0],["يَقِلُّ الناسُ أَن يَتَقَيَّلوهُ","وَأَن يَدنوا إِلَيهِ مُشاكِلينا",48,"ن",2,0],["يُقَلِّبُ الرَأيَ دَهرَهُ فِرَقاً","لا خَفضُهُ دائِمٌ وَلا حَزَنُه",49,"ن",2,0],["يُقَلِّبُ عَيناً لَم تَكُن لِخَليفَةٍ","مُشَوَّهَةً حَولاءَ بادٍ عُيوبُها",50,"ه",2,0],["يَقِلُّ جسوماً بعضُها من مُورَّدٍ","وسائُرها في مثلِ صِبْغِ الدَّياجرِ",51,"ر",1,0],["يُقَلِّبُني رأساً على عَقِبٍ بها","كما أَمْسَكَتْ سَاقَ الوَلِيدِ قَوَابِلُهْ..",52,"ل",2,0],["يقلل في الجفن عنه اللحاظَ","ويبعثُ بالوزن فيه الكلاما",53,"م",2,0],["يقلّبُ أجفاناً وِراداً كأنّما","تَوَارَدَ يومَ الطعن مُشْرَعُ عامِلِه",54,"ل",2,0],["يَقُلنَ إِذا ما كَوكَبٌ غارَ لَيتَهُ","بِحَيثُ رَأَيناهُ عِشاءً يُخالِفُ",55,"ف",1,0],["يُقَلِّبُ مِنّي العَزمُ إِنسانَ مُقلَةٍ","لَها الأُفقُ جَفنٌ وَالظَلامُ سَوادُ",56,"د",1,0],["يُقَلِّبُ عَيناً لِلحَياءِ مَريضَةً","تَغُضُّ وَأُخرى لِلذَكاءِ تُحَدِّقُ",57,"ق",1,0],["يُقَلِّبُ طَرفاً في الكَواكِبِ سامِياً","كَأَنَّ بِهِ تَحتَ الظَلامِ مُنَجِّما",58,"م",2,0],["يَقُلْنَ لها حَنانَكِ أدركينا","فقد أزرى بنا ما تعلمينا",59,"ن",2,0],["يُقِلُّ الكِنانَةَ في عِزِّها","وَأُبَّهَةِ الفاتِحينَ الأُوَلْ",60,"ل",1,0],["يُقَلِّبُ عَينَيهِ مُستَوفِزاً","إِذا صيحَ بِالرِمَمِ البالِياتِ",61,"ت",1,0],["يُقلِّبُ بين الأوسِ والخزرجِ الثَّرى","وقد وَشجتْ فيه العُروقُ العواطِفُ",62,"ف",1,0],["يُقَلِّدُ الماءُ جيدَها دُرَراً","يَنهَبُها الشَربُ بَينَهُم نَقَلا",63,"ل",2,0],["يَقلونَ قَلواً وَهوَ يَز","مُلُ مِراخاءً مُواغِل",64,"ل",1,0],["يَقُلنَ أَلا تُبدى الهَوى سَتَزِدَنني","وَقَد يُستَزادُ ذُو الهَوى وَهوَ جاهِدُ",65,"د",1,0],["يَقُلنَ لَها لا تَجزَعي أَن تَبَدَّلي","بِبَعلِكِ بَعلاً وَالخُطوبُ كَذَلِكِ",66,"ك",1,0],["يُقَلِّبنَ إِلى الذُعرِ","عُيوناً كَالقَواريرِ",67,"ر",1,0],["يَقُلنَ لَنا يا لَيتَ ذا اللَيلَ سَرمَداً","عَلَينا وَلا نَخشى عِيونَ أَعادِ",68,"د",1,0],["يُقَلِّبُ في فَمِهِ مِقوَلاً","كَشِقشِقَةِ الجَمَلِ المُصعَبِ",69,"ب",1,0],["يُقَلِّبُ طَرفاً طُحورَ القَذى","يُضيءُ بِمُقلَتِهِ خَدَّه",70,"د",2,0],["يقُلنَ وقد صرفتُ هواي عنها","فهنّ لنبوَتي عنها حيارى",71,"ر",2,0],["يقلّدُ في ترائبهِ صليباً","ومستلب الذوائبِ بالشعار",72,"ر",1,0],["يُقَلِّبُني الهَوى ظَهراً لِبَطنٍ","فَما أَخفى عَلى أَحَدٍ يَراني",73,"ن",2,0],["يُقِلُّ الأَذى وَالعَيبَ في ساحَةِ الفَتى","وَإِن هُوَ أَكدى قِلَّةُ الجُلَساءِ",74,"س",3,0],["يَقُلنَ نُهَيَّجُ الغُيّابَ حَتّى","يَجيؤوا بِالرُكابِ مُزَمَّماتِ",75,"ت",1,0],["يُقِلُّ العَصا مُستَثقِلَ الطِمرِ بَعدَما","عَلا فَرَساً وَاِجتابَ ماذيَّةً سَردا",76,"د",2,0],["يَقُلُ الحِجى هَل لي إِذ مُتُّ راحَةٌ","فَإِنَّ عَذابي في الحَياةِ أَليمُ",77,"م",1,0],["يُقَلِّبُ قَيدوداً كَأَنَّ سَراتَها","صَفا مُدهُنٍ قَد زَحلَفَتهُ الزَحالِفُ",78,"ف",1,0],["يُقَلِّبُ حَقباءَ العَجيزَةِ سَمحَجاً","بِها نَدَبٌ مِن زَرَهِ وَمَناسِفُ",78,"ف",1,0],["يُقَلْقِلُ ما بَيْنَ الضُّلوعِ نَشيجُها","لها شافِعٌ مِنْ عَبرَةٍ وَتَضَرُّعِ",79,"ع",1,0],["يقلد الإفرنج في مشيه","كأَنَّه من أَهل باريسا",80,"س",2,0],["يُقَلِّبُ سَمْحَجاً قَبَّاءَ تُضْحِي","كَقَوْسِ الشَّوْحَطِ العُطُلِ الصَّنِيعِ",81,"ع",1,0],["يَقُلْنَ فُلانَةُ ابْنَةُ خَيرِ قوْمٍ","شِفاءُ للعُيونِ إذا شَفَنّه",82,"ن",2,0],["يُقَلِّبُ ن