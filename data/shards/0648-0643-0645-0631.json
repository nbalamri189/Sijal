ب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5145,"تولّى الظلم وإنجاب الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=108226",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5216,"أبو الهول","https://www.poetsgate.com/ViewPoem.aspx?id=186993",""],[5219,"وذات خال ...","https://www.poetsgate.com/ViewPoem.aspx?id=198233",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5431,"لعشتُ في الحوت لمْ تنفك أطواقي","https://www.poetsgate.com/ViewPoem.aspx?id=185286",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5616,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=205245",""],[5689,"انا عربي لا جنس أمجد من جنسي","https://www.poetsgate.com/ViewPoem.aspx?id=143432",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5956,"ما بين سماحٍ ونطاحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=212486",""],[6082,"كنّا صغارا","https://www.poetsgate.com/ViewPoem.aspx?id=61277",""],[5309,"غني ولكن ليس لي من اشاركه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573805",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6239,"نُور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75986&r=&rc=37",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""],[5126,"المشيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87786&r=&rc=1",""]],"verses":[["وَكَم رَمَتني مِنَ الأَقدارِ مُنبِضَةٌ","لَم تَثنِ باعي وَلَم يَحرَج لَها عَطني",0,"ن",2,0],["وَكَم رَحِمٍ أَطَّت بِهِ وَهوَ مُغضَبٌ","فَعادَ إِلى الإِحسانِ غَيرَ مَطولِ",1,"ل",1,0],["وَكَم رُفِعَت لي نارُ حَيٍّ فَجُزتُها","وَما نارُ مَمنونِ القِرى مِن مَقابِسي",2,"س",2,0],["وَكَم رَشأٍ عاطِلٍ شاقَني","إِلى رَشأٍ في مَغانيه حالِ",3,"ل",1,0],["وكمْ رُمْتُ أنْ يُجْدي البُكاءُ فلَمْ يكُنْ","ليُجْدي ورجّعْتُ الحَنينَ فلَمْ يشْفِ",4,"ف",1,0],["وكمْ رِيءَ منْ نَجْلٍ أبَرَّ بفَضْلِهِ","علَى الوالِدِ المَشْهورِ بالفَضْلِ والجَدِّ",5,"د",1,0],["وكمْ رصَدَتْ منّا العُيونُ طُلوعَها","فحُقِّقَ نصْرُ اللهِ في ذلِكَ الرّصْدِ",6,"د",1,0],["وكمْ رامِحٍ للفُرْسِ فيها ونابِلٍ","وراحٍ نُعاطِيها مُهَفْهَفَةَ القَدِّ",7,"د",1,0],["وكم رَمَت قَسماتُ الحُسنِ صاحِبَها","وأتعَبَتْ قَصَبَاتُ السَّبقِ حاويها",8,"ي",3,0],["وَكَم راضَ صَعباً جامِحاً مُتَمَنِّعاً","يُلايِنُهُ طَوراً وَطَوراً يُصاعِبُه",9,"ب",2,0],["وَكَم رَدَدتَ العِدى عَنها بِغَيظِهِمُ","وَأَكبُدُ القَومِ لِلأَحقادِ تَلتَهِبُ",10,"ب",1,0],["وَكَم راسَلَ الغَيرانُ يُهدي وَعيدَهُ","فَما راعَهُ إِلّا الطُروقَ جَوابُ",11,"ب",1,0],["وَكَمْ رَبِيبةِ خِدْرٍ","صَاغَتْهُ صَوْغاً سوِيَّا",12,"ي",2,0],["وكم راقٍ بها في جوّ علم","ليستهدي بأنجمه ويهدي",13,"ي",1,0],["وكم رام اسكاتي أناس أبى لهم","خَنى الطبع إلاّ أن يروا لي حُسّدا",14,"د",2,0],["وكمُ رمتُ أيقاظاً فأعيا هُبُوبُهم","وكيف وعزم القوم شارب مُرقِد",15,"د",1,0],["وَكَم رَدَدنا بِبَدرٍ دونَ ما طَلَبوا","أَهلَ النِفاقِ وَفينا أُنزِلَ الظَفَرُ",16,"ر",1,0],["وكم رأيناك لمربى الثنا","أباً فجئناك بدرٍّ يتيم",17,"م",1,0],["وكم رأينا بَرْقَهُ ضاحكاً","فيها إلى ذي مَضْحكٍ أَشْنَبِ",18,"ب",1,0],["وكم رُمتُ صبراً إذا جُفيتُ وما أرى","إليه سبيلاً أو يُفاضحني الجهر",19,"ر",1,0],["وكم رماني العدى بداهيةٍ","كاستْ على رأسها ولم أكُس",20,"س",1,0],["وكم رمتُ حدّ السيف منك تسلُّطاً","عليك فلم تَنقُضْ بيَ الكفُّ مَنْقضا",21,"ض",2,0],["وكم راقع حسباً واهياً","بمدح وإن كان لا يرتقع",22,"ع",1,0],["وَكَم رَكَضتِ فَأَغرَيتِ الصِغارَ ضُحىً","بِالرَكضِ في الحَقلِ مَلهاهُم وَمَلهاكِ",23,"ك",1,0],["وَكَم رُمتُ أَنّي لا أَقولُ فَخِفتُ أَن","يَقولَ لِسانُ الحالِ وَهوَ فَصيحُ",24,"ح",1,0],["وكم رأى ليلُكَ الأَشباحَ هائمةً","مَذْعورةً تتهاوَى حَوْلَها الرُّجمُ",25,"م",1,0],["وَكَمْ رسمتَ رسوماً لا تُشابِهُها","هذي العَوالِمُ والأَحلامُ والنُّظُمُ",25,"م",1,0],["وَكَم رَعَتها العَينُ في","السُكونِ وَالتَحَرُّكِ",26,"ك",1,0],["وَكَم رِجالٍ بِلا أَرضٍ لِكَثرَتِهِم","تَرَكتَ جَمعَهُمُ أَرضاً بِلا رَجُلِ",27,"ل",1,0],["وَكَم رُمتُ أَن أَسلو الصَبابَةَ نازِعاً","وَكَيفَ اِرتِجاعي فائِتاً قَد تَقَدَّما",28,"م",2,0],["وكم رسمت على جدرانها صور","وكم كسرت على أدراجها لعبا",29,"ب",2,0],["وكم ريع صرف الدهر منه بأروع","يلاقي جبين الخطب غير جبان",30,"ن",1,0],["وَكَم رَأَينا مِن ذَوي ثَروَةٍ","لَم يَقبَلوا بِالشُّكرِ إِقبالَها",31,"ل",3,0],["وكم ردّها مَفْلُولَةً حدُّ صبرِهِ","إذا جَزعُ الهيجاءِ فلّ شَبَا الصَّبرِ",32,"ر",1,0],["وكَمْ رَاعَت لِبغْلَتِهِ شِمالاً","وكَمْ رَاعَتْ لِبَغْلَتِهِ يَمِينا",33,"ن",2,0],["وَكَم رائِشٍ بارٍ وَلَولا مُحَمَّدٌ","طَوَتهُ اللَيالي ما يَريشُ وَلا يَبري",34,"ر",2,0],["وَكَم رَأَتِ الفَراقِدُ وَالثُرَيّا","قَبائِلَ ثُمَّ أَضحَت في ثَراها",35,"ا",3,0],["وكم رِياضٍ بحَزْنٍ لا يَرودُ بها","ليْثُ الشَرى وهيَ مَرْعَى الشادنِ الخَرِقِ",36,"ق",1,0],["وَكَمْ رَفَعْتَ لِقَوْمٍ","ذِكْراً وقَوَّضْتَ ذِكرَا",37,"ر",2,0],["وكم رأيتُ يراعًا خاض معركةً","ثم انثنى بدم الأعداء مُختَضَبا",38,"ب",2,0],["وكم رُمِيَّ الحرُّ الكريم لديهمو","بغلظة ساعٍ، أو فظاظة حاجب",39,"ب",1,0],["وكم رسالةِ حبٍ جاءَ يحملها","كالبرق وهْوَ حثيثُ الخَطْو عجلان",40,"ن",1,0],["وكم رىء من نجل أبر بفضله","على الوالد المشهور بالفضل والحمد",41,"د",1,0],["وكم رامح للفرس فيها ونابل","وراح تعاطيها مهفهفة القد",42,"د",1,0],["وكم راغ ما بين المسيح وأحمد","وحارب \" بالسوري \" أخاه \" اليمانيا \"",43,"ي",2,0],["وكم رسمتُ على جدرانِها صوراً","وكم كسرتُ على أدراجها لُعبا",44,"ب",2,0],["وكم رأينا اسآات الغرام به","ولطف معناه معروفا واحسانا",45,"ن",2,0],["وكم رام الحسود لي احتقاراً","ومنك حمى حماي الاحتشام",46,"م",1,0],["وَكَم راقَ شِعرٌ ما حَبيبٌ أَتى بِهِ","وَقَدَّ الطُلى سَيفٌ وَما عَرَفَ الهِندا",47,"د",2,0],["وكم رائمٍ رام الجمال الذي ترى","فأرداه منها لحظها ومناها",48,"ا",3,0],["وَكَم رُمتُ تَرحالاً أَفوزُ بِبِرِّهِ","وَذَنبيَ أَقصاني فَبُؤتُ بِخُسرِهِ",49,"ه",1,0],["وكم رأوا مثله قدما وكم سمعوا","وعظا فصموا لأحكام القضا وعموا",50,"م",3,0],["وَكَم راجِلٍ أَمسى بِنُعماهُ فارِساً","وَكانَت صَفايا مالِهِ المَعزُ وَالضانُ",51,"ن",1,0],["وكَمْ رَيْبَ لِصَرْفِ الدهرِ هَابٍ","جَلاَهُ النَّصْرُ مِنْ رَبٍّ مَهُوبِ",52,"ب",1,0],["وكم رُمت عَوْدا مرةً بعد مرةٍ","إليها فيَثْنِى من عنانىّ حابس",53,"س",1,0],["وكم رمّدت من حدث طريف","له في حال منطقه اتساع",54,"ع",1,0],["وكم رقبة لي والرقى تدفع الأذى","إذا لم يكن فيه حمام بغاتها",55,"ت",3,0],["وَكَم رحلتَ إلى أمرٍ بهِ أربٌ","مِن أمردين ودُنيا قد عنيت بهِ",56,"ب",2,0],["وَكَم رَحلوا لِلشركِ في دار رجسهِ","وَجابوا إلى أَوطانهِ البرَّ وَالبَحرا",57,"ر",2,0],["وَكَم رمضانٍ جاءَهم ما تسحّروا","وَقَد أطعموا سمرَ القَنا النحرَ والسحرا",58,"ر",2,0],["وَكَم رَفعوا رُمحاً وضمّوا مهنّداً","وَكَم نَصبوا حَرباً وكَم فَتحوا ثَغرا",58,"ر",2,0],["وكم رأيتُ ظباء الكرخ سارحة","بالسكر ما بين أورادٍ وغدران",59,"ن",1,0],["وكم رسائلَ تلقيها السمالء به","للعاشقين فيأتيهم ويُلقيها",60,"ي",3,0],["وكم رد من عين وجاد بها وكم","اصابعه فاضت وللجيش روّت",61,"ت",1,0],["وكم راح غر بألقابه","ضميرا بجوف الثرى مضمرا",62,"ر",2,0],["وكم رَصَدته آمالُ البرايا","حوافلَ قبلَ يُظْهِره الوجودُ",63,"د",1,0],["وكم رَجَتِ الخلافةُ أن تراه","كما يرجو أحِبَّتَه العمِيد",63,"د",1,0],["وَكَمْ رَبَّتْ بِأَنْعُمِهَا يَتِيماً","قَلَتْهُ أُمُّهُ حَتَّى سَلاَهَا",64,"ا",3,0],["وَكَم رجالكَثير كنت آملهم","وَلَم يَزل لابس الآمال عريانا",65,"ن",2,0],["وَكَم رَعى بالتَعنى حق حرمتهم","مبالغا فيهم التَحذير وَالنذر",66,"ر",1,0],["وَكَمْ رُمْتُ في دارِ الخِلافَةِ أُيِّدَتْ","قَرَاراً فَأعْيَا والْمَوَاهِبُ أسْهُمُ",67,"م",1,0],["وَكَمْ راوٍ كَأَنَّ بِفِيهِ مِنْها","مُجاجَ النَّحْلِ حُبَّ بِهِ مُجاجا",68,"ج",2,0],["وَكَم رَدَّ عُقبانَهُ وَهيَ حُمرٌ","وَقَد كُنَّ بيضاً كَلَونِ الحَمامَه",69,"م",2,0],["وَكَم رؤوسٍ وأَجسامٍ هنالِك قَد","أَصبَحنَ ما بين مَرفوعٍ وَمَجرورِ",70,"ر",1,0],["وكم راح يستجلي عذار بنفسجٍ","سقته الغوادي صوبها فتنمنما",71,"م",2,0],["وكم رأينا سميناً","لأنفس الناس غثى",72,"ث",2,0],["وكم رمت أن أخفى هوى ظبية الحمى","فلم أستطع واللائحات شهود",73,"د",1,0],["وَكَم رامَ العَذولُ عَلَيكَ مِن","نا اِنثِناءً عَن هَواكِ وَما اِنثَنَينا",74,"ن",2,0],["وَكَم رامَ الوُشاةُ بِنا اِنثَناءً","عَنِ الظَبيِ الأَغَنِّ فَما اِنثَنَينا",75,"ن",2,0],["وَكَم رَئيس عَزيز قَد تحكم في","جُثمانِه بَعد ذاكَ العِز ما كانوا",76,"ن",3,0],["وكم رَضَعَ الرَّجاءُ نَداكَ قِدْماً","رَضاعاً لم يُعقِّبْهُ فِصالا",77,"ل",2,0],["وكم راحَ عانٍ للصّبابةِ حائرٌ","وكم لاحَ عِينٌ للنّواظِرِ حُور",78,"ر",1,0],["وَكَم رَسائِلِ تَسليمٍ مُحَمَّلَةٍ","لِلطَيفِ وَالبَرقِ وَالأَرواحِ وَالسُحُبِ",79,"ب",1,0],["وكم رأيت لغيري غيره عضُداً","لكن أولئك مرعى وهو سعدان",80,"ن",1,0],["وكم رياض قد نزلنا بها","ساجلنا في دوحها البلبل",81,"ل",1,0],["وكم روضة قد أنزلونا كأنها","رياض جنان الخلد شكلاً على شكل",82,"ل",1,0],["وكم رسالات له حبرت","ترشف بالأسماع كالقرقف",83,"ف",1,0],["وكم رام أقوام وهموا بسفكهم","دمي فأبى الرحمن نَيْلي بالضر",84,"ر",1,0],["وكمْ روضةٍ تَستفيدُ الريا","ض مِنهُنَّ نوراً ونَبْتاً عَميما",85,"م",2,0],["وكم رعى بعضُنا بَعضاً وكانَ لهُ","مزاوِجاً كازدِواجِ الرُّوحِ والبَدَنِ",86,"ن",1,0],["وَكَم رام ثَوبَ العِزِّ إِنَّ سَتيرَهُ","بِذُلِّ وَأَن تَلقى له الدَهرَ مالِكا",87,"ك",2,0],["وَكَم رَجُلٍ أَثوابُهُ دونَ قَدرِهِ","وَقَد يَلبِس السلك الجمان الفَرائِدا",88,"د",2,0],["وكم رَماني العِدا بَغياً بِإفكِهِمُ","فلَمْ أَرقَّ ولم أفرَقْ لبَغْيِهِمُ",89,"م",1,0],["وكم راح يغنيني عن الزهر أغيدٌ","بنرجس عينيه وآس عذاره",90,"ر",2,0],["وكم رفع الزَّمان وضيع نفس","فنال الحظَّ بالباعِ القصير",91,"ر",1,0],["وكم رُزِقَ المكانَةَ من أُناسٍ","لَوِ اختيروا لما وَجَدوا مكانا",92,"ن",2,0],["وكم رامَني والرّحْبُ بيني وبينَه","فقلتُ له لا زِلتَ في المنزلِ الضّنْكِ",93,"ك",1,0],["وكم ركَزوا رماحَهُمُ كِناساً","وسمّوها وما صدَقوا غيابا",94,"ب",2,0],["وكم رامَ مجدَك من حاسدٍ","فجُرِّدَ من حُلّةِ السّالِمِ",95,"م",1,1],["وكم راقَ طرفي من رائعٍ","يقول وقد غرّني غَرري",96,"ر",2,0],["وكم رُعْتَها بالسَّيْفِ فِي كُلِّ بَلْدَةٍ","فإِنْ أَقْدَمَتْ يَوْماً ففِي بَسْطِكَ السَّلْما",97,"م",2,0],["وكم رأَينا وجوهَ الروضِ ضاحِكَةً","فِي رائِحٍ راحَ أَوْ فِي بارِقٍ بَرَقا",98,"ق",2,0],["وكمَ رَدَّ عَنْ نَفْسِ ابْنِ شَنْجٍ سِهامُها","وَقَدْ أَغرقتْ نَزْعاً وأَمكَنَها رَمْيا",99,"ي",2,0],["وكم رأى من عجيبات الغيوب بها","وكم أفادته من فضل غيابته",100,"ت",2,0],["وكم رائدٍ منهم إلى الحشر قد مضى","ولم يبق منه أجساد",101,"د",1,0],["وكمروان وابنه حين واسى","بلذاذات عيشه سُمّاره",102,"ر",2,0],["وكمروان ذي الفتوة إِذ كا","ن يوالي في غبطة أسفاره",102,"ر",2,0],["وكم ريع بالبطحاء من متودِّع","وقُلقِلَ ركب للنوى وهو وادعُ",103,"ع",1,0],["وكم رافعٍ لي بالعداوةِ صوتَهُ","يُهبهِبُ في إيعادِهِ ويُهيبُ",104,"ب",1,0],["وكم رقدوا وأنت من التَّروي","لكسبِ المجد ممتنعُ الرُّقادِ",105,"د",1,0],["وكم رحت مهزوز الجوانح والحشى","بزينبه ذات الجمال وجُملهِ",106,"ل",2,0],["وكم رجمتْ فيَّ الظنون وما دروا","لمن أنا باكٍ أو بمن أنا مغرم",107,"م",1,0],["وكم ركبتُ بهيم الليل في غرضٍ","وبدره غرةٌ والصبح تحجيل",108,"ل",1,0],["وكم رممته بيتا خرابا","وكم لي في قريضك من شهود",109,"د",1,0],["وكم رضعت لبانه من شعوب","صغار فارتقت به للكبار",110,"ر",1,0],["وكم رفعوا به للحق صوتا","فأصبح لابسا تاج الوقار",110,"ر",1,0],["وكم رمتني بسهم الدهر عن بعد","وما أحول عن التهيام أنتشق",111,"ق",1,0],["وكم رعفت لذاذات المنى ولكم","جارت علينا وكم للقلب ينفهق",111,"ق",1,0],["وكم رتقت ميادين المعاطب لا","يألوني جهدا هيامي ما أرى أفق",111,"ق",1,0],["وَكَم رامُوا الفرار مِن الرَزايا","وَلَكن أَين مِن أَجلٍ فِرارُ",112,"ر",1,0],["وكمْ رجوتُ الفراقَ علِّيْ","بهدْي أهل السّما أثوبُ",113,"ب",1,0],["وكم رام هضمي فما هاض لي","جناحا ولا فل للصبر نابا",114,"ب",2,0],["وكم رقصت جبال مرّ فيها","حليف الحود تيمور الكريمُ",115,"م",1,0],["وكم رمانا الرّدى عن قوسِ مَعْطَبَةٍ","فَصدّه اللَّهُ أن يُصمي فَأَشوانا",116,"ن",2,0],["وَكَم رُمناكَ لِلجَدوى علينا","فَما رُمناك ممتنع المرامِ",117,"م",1,0],["وكم رام اِمرؤٌ بهمُ لُحوقاً","بطرقِ المأثُراتِ فما اِستوى لَهْ",118,"ل",2,0],["وكم رامه منّي الرّجالُ وإنّما","يرومون نجماً غارباً ليس يطلعُ",119,"ع",1,0],["وكم رَمْيَةٍ لم تُصْمِ ممَّن رمى بها","وكم قولةٍ من قائلٍ ليس تُسمَعُ",120,"ع",1,0],["وَكَمْ رَضيتُ ولكنْ زدتُكمْ سَخَطاً","وَلَيسَ بعدَ الرّضا شيءٌ سوى الغَضَبِ",121,"ب",1,0],["وكم رحمة منه وافت لنا","وكم نقمة قد تولت وكم",122,"م",1,0],["وكم رفعت بلاً عنّا ونائبة","والنفس من ذنبها جاءتك تائبة",123,"ه",1,0],["وكم رَجُلٍ يقومُ مَقامَ جيشٍ","ويَسقُطُ دونَهُ الجيشُ العظيمُ",124,"م",1,0],["وكم رَجلٍ دَعَوتُ فلم يُجِبْني","ويَدعُوني سِواهُ فلا يُجَابُ",125,"ب",1,0],["وكم رمتُ قَتْلَ النَّفس فيكم فَصدَّني","وصبَّرني عن قتلِ نفسِيَ إِيماني",126,"ن",2,0],["وكم رام مِنَّا قوْمُها أُنفساً لنا","وقد طلبُوا بَعض الذي أَخذَتْ منَّا",127,"ن",2,0],["وكم روض سقاه الغيث وافى","باثمار تلذ لنا شهيه",128,"ي",2,0],["وكم رحمت الليالي وهي ظالمةٌ","وما شكوت لها فعلا وإن فضعا",129,"ع",2,0],["وكم ركضنا المطايا كي نفوز بما","نلهو به غير سماعين للعتب",130,"ب",1,0],["وكم رُمتُ أنْ أُخْفِي الّذي بي مِنَ النَّوَى","ولي أدْمُعٌ تأْبى فأُضْحِي كما أُمْسِي",131,"س",2,0],["وكم رجل قد علا مركبه","وقد كان مسكنه مطلبه",132,"ب",2,1],["وكم راض عاصيَكم إلْفكم","كما ألف الرائضَ الأرقم",133,"م",1,0],["وكم ردفٍ بليلٍ شُ","قَّ عن رجراجِهِ المِئْزَر",134,"ر",1,0],["وكم رابِط الجأشِ غادرتُهُ","وقد خانه جأشُهُ الرابط",135,"ط",1,0],["وَكَم رَأَيت مثلَها في العالم","مِن نَسل حَواء وَنسل آدم",136,"م",1,0],["وكم رَمَتْ رامته يوم النوى","بأسْهمٍ مِنِ التفات النظر",137,"ر",1,0],["وَكَمْ رَدَّ مَطْرُوداً عَنِ الْبَابِ شَارِدَا","نبيِّ سَمَا فَوْقَ السَّموَاتِ صَاعِدَا",138,"د",2,0],["وكم رؤيا لنا دلَّت عليهَا","وعقلٍ ناظر فيها بحدسِ",139,"س",1,0],["وكم رام قوم ختله فتعاكست","أمورهم فيهم فألقوا له السلَمْ",140,"م",1,0],["وكم رشقت من برى","رب الورى بأسمهمي",141,"ي",1,0],["وكم رددت غارة","روم الثنا بمخذمي",141,"ي",1,0],["وكم رحلت مركبا","وكم أسلمت منكبا",141,"ب",2,0],["وكم رب بخل حام في حومة الشقا","وكم رب ظل في ناضر الظل",142,"ل",1,0],["وكم ركبت إليه","كواهل الأخطارِ",143,"ر",1,0],["وكم روى الألوف بفضل ماء","كما كف الألوف بفضل زاد",144,"د",1,0],["وكم رعيت به مرعى أبر وما","حسبت أن ارتعائي يعقب العجفا",145,"ف",2,0],["وكم رغبت عن الآمال أنشُدها","فكان يوقظ آمالي محياه",146,"ا",2,0],["وَكَم رأينا من قبل في ملّة الهوى","زيارتها فرضاً عليه وأديانا",147,"ن",2,0],["وكم رمَّ منه فَسَاداً صَلاحٌ","وكم منه شكوى وكم منه شكر",148,"ر",1,0],["وكم ربيعٍ راحَ من فيضهِ","يرفلُ في أوراقِهِ النُضر",149,"ر",1,0],["وكم رفعنا قِباباً لا انتهاء لها","فكان لبنانُ للعلياء لبنانا",150,"ن",2,0],["وكم رأينا من ضعيف أعرجا","وفي مدارج المعالي أعرجا",151,"ج",2,0],["وكم رأينا من صحيح للقدم","ليس له في حلبة الخير قدم",151,"م",1,0],["وكم رزء تهون له الرزايا","ألمّ فألبس الدنيا مصابا",152,"ب",2,0],["وكم رنَّت مسامعها ارتعاشاً","إذا ما رنَّ في يده الهضابُ",153,"ب",1,0],["وكمْ رآهُ كَفُورٌ","برَبِّهِ فتَشهَّدْ",154,"د",1,0],["وكم رُمتُ أن أرقى فألثم جيدَهُ","غراماً ولكن أثقلتني العلائقُ",155,"ق",1,0],["وكم رب نسك مهتدٍ قد أضله","بمرسلِ صدغ فاتنٍ طالما أغوى",156,"و",2,0],["وكم راح دل في الهوى لي شافعاً","فعوضت عما أرتجي ما أحاذر",157,"ر",1,0],["وكم رجال للقريض يكسرون","ويدعونه وهم لا يشعرون",158,"ن",1,0],["وكم رُمتُ دهري فتحَ باب عبادةٍ","يكون بها في الفائزين مَساغُ",159,"غ",1,0],["وكم رجل بالقول في الناس سيد","ولكنه بالفعل دون البهائم",160,"م",1,0],["وكم رفع الادنى من الناس منصب","على سيد كالفعل تحت الجوازم",160,"م",1,0],["وكم رضينا ولم ترض الفداء به","كي لا تنال بعقد البين خسرانا",161,"ن",2,0],["وكم رأينا غداة الجمع سار به","الجمع يذرف دمعا ظل هتانا",161,"ن",2,0],["وكم راحة نالها جازم","على ما تألم من سعطه",162,"ط",2,0],["وكم رام ذو ملل حاشم","ليغضب حلمى فلم أعطه",162,"ط",2,0],["وكم رشأ اخوى أغنَّ مهفهفٍ","إذا ما تصدى لي ثنيتُ إلى الْصَدِّ",163,"د",1,0],["وَكَم رُمتُ أَلا يَشعَبَ الدَّهرُ شَملَنَا","وَلَكِنَّ سِحرَ الدَّهرِ أَنفَذُ مِن سِحري",164,"ر",2,0],["وكم رقصت تلك الخيول بهم وما","بأيديهم غير السيوف منادل",165,"ل",1,0],["وكم رفع مضافا للهوان كما","خفضت كل رفيع مفرد علم",166,"م",1,0],["وكم رجل شاد مجد الحياة","وفجَّر أنوارها الناصعه",167,"ع",2,0],["وكم رعرع الأحشاء منه بمنجع","يقصر عنه في المنائح حاتمه",168,"م",2,0],["وكم رفعتْ في الدهرِ قوماً على الهَبا","وكم نصبَتْ قوماً ولكن على الإغرا",169,"ر",2,0],["وكمْ رُمْتُ أخفي الحبَّ عنكَ صيانةً","وفيضُ دموعي عن غرامي يُعربُ",170,"ب",1,0],["وكم رسمت لأخلاق الورى صوَراً","مزجتَ ألوانها بالماء والضرم",171,"م",1,0],["وكم رغيف كَسْرُهُ مجبورُ","وعند من يَعْرِفه مَخْبُورُ",172,"ر",1,0],["وكم راح من سَقَمٍ بلمسَةِ راحةٍ","وكم كفَّ ذاك الكفُّ باللَمس من صرعِ",173,"ع",1,0],["وكم رد للنهج القويم عصابة","ولولاه مازالوا من الجهل في مهوى",174,"و",2,0],["وكم روائع اجرى العرب سلسلها","ينبتن في الجلمد الريحان والآسا",175,"س",2,0],["وَكَم رامَهُ مِنّي مُلوكٌ تَقَدَّموا","وَقَبلَكَ ما عَرَّضتُ وَجهي لِمُنعِمِ",176,"م",1,0],["وكم رماها السير بابن همّةٍ","كظُبَةِ السيف إذا همّ عزم",177,"م",1,0],["وكم رآها يوم إسداء الندى","فهاج من خجلته ثم التطم",177,"م",1,0],["وكم روضة تخضرّ بعد اصفرارها","فتصبح مبثوثا عليها رضابها",178,"ب",3,0],["وكم روضت يوم العجاجة فارساً","يذل لديه كل أروع ضيغم",179,"م",1,0],["وكم رياض أزهرت فلم يزل","ذوو العلوم ورّداً وروّدا",180,"د",2,0],["وكم رموز للعلوم قد غدا","كشف الغطا عنها لها مستندا",180,"د",2,0],["وكم رجال قصدوا غيرَه","فقلت لا أعبدُ مَا تَعبدُون",181,"ن",1,0],["وَكَم رفّت حشاً حَرى عَلَيهِ","وَكَم جسم عَلَيهِ هَوى صَريعا",182,"ع",2,0],["وكم رفعت فيك المساواة راية","تفيأ دهراً ظلها الحر والعبد",183,"د",1,0],["وكم رئيس وكم شيخ ومنتدب","وكم وزير وكم قاضٍ وكم حكم",184,"م",1,0],["وكم رأيتُ في قطوطِ الشولِ","ونظمه والنثر والفصولِِ",185,"ل",1,0],["وكم رجال افاض الدهر شهرتهم","براية المجد في مضمارها جالوا",186,"ل",3,0],["وكم رأَسِ جَبّارٍ كَوَهّاس أَصْبحتْ","لها بَدَنٌ فينا من القَصَب الْمُلْدِ",187,"د",1,0],["وكم رمت تنزيهاً لشعريَ في الهجا","عن اسمك كي لا تغتدي خالد الذكر",188,"ر",1,0],["وكم رفست برجلي ارؤساً غمرت","لما سبحت فصاحوا صيحة الضجر",189,"ر",1,0],["وكم رمت افهاماً له دون طائل","وهل يفهم القول الجماد فيقنع",190,"ع",1,0],["وكم رفعت بثوبي","بالين ثوبا وسترا",191,"ر",2,0],["وكم رأيت سكوناً منه آونةً","فرحت أوثقه بالعقل والحكم",192,"م",1,0],["وكم رمت تقييداً له بعقائدٍ","وأغللته قدماً فثار على الغِل",193,"ل",1,0],["وكم رجوم فيها أسلّطها","على شياطيني العتيّات",194,"ت",1,0],["وكم رمتُ اقفو الآخرين فلم أطق","وأدركني لما اقتفيت التجمد",195,"د",1,0],["وَكَم رياح بأَرواح الوَرى عصفت","وَبعد تَكديرها بالقاصِفات صَفت",196,"ت",1,0],["وَكَم راوَدَتهُ الشم عَن نَفسه فَما","رَأَت قَلبه إِلا غَنياً مُكرما",197,"م",2,0],["وَكَم رَوَت عَسكراً مِن فَيض راحتها","وَأطلقت أرباً مِن ربقة اللمم",198,"م",1,0],["وكم رُمتُ صدقا من تصوّر سلوة","فيكذبُ في التّصديق ذلك التّصّوُرُ",199,"ر",1,0],["وكم رمت العلاء لقوم مصر","وكنت أشد من فيها حنانا",200,"ن",2,0],["وكم رعى الطرف بين الطرق بدر دجى","شوقاً إلى منيتي والناس قد هجعوا",201,"ع",3,0],["وكم رأوا فيه الامام الغالب","على امام الشرق والمغارب",202,"ب",1,0],["وكم رقَصن الخِفاف اليَعْمَلات بِهَا","وكم نَصَبن خيامَ المجد بالعُمُد",203,"د",1,0],["وَكَم رَوضةٍ غَنّاءَ هَبّ نَسِيمُها","فَأحيَا فُؤاداً كانَ ظُلمَةِ القَبرِ",204,"ر",1,0],["وكم رنّ صوتي لهُ رنّةٌ","وكم رنّ صوتي بأذن السماء",205,"ا",2,0],["وكم راحت لراحته هبات","زهيّاتٌ على السحب الدلاح",206,"ح",1,0],["وكم راودته في حياة حلومهم","فعف وألوى أن يطاع سؤالها",207,"ل",3,0],["وَكَم رمتُ إِصلاحاً لإفساد دهرنا","وَهَل كَيفَ إِصلاح ودهرك فاسدُ",208,"د",1,0],["وكم راقدٍ في غفلةٍ عن منيةٍ","مشمرةٍ في القصد وهو سعارها",209,"ر",3,0],["وَكَم رمت أَسباب العُلا لالتقاطها","فَتقعد بي عَما أَروم القَوائم",210,"م",1,0],["وكم رَدَّ بالرَدِّ الخطيرِ نُهىً لها","جَماحٌ إلى مَهوَى الرَدَى ومَطامِحُ",211,"ح",1,0],["وَكَم رَوضة كان الشَباب بهارَها","وَكنا بها أَغصانَ صفوٍ وَصفوة",212,"ه",1,0],["وَكَم راشفٍ سمّاً من الكَأس لَمحةً","فَناح عَلى ما مرّ دَهراً طَويلا",213,"ل",2,0],["وكم راح تعنيف الشجي بروحه","ألا إن بعض العذل يضني ولا يثني",214,"ن",2,0],["وكم ربع حليف الجدب لما","مررت به استحال الجدب خصبا",215,"ب",2,0],["وَكَم رُمتَ كِتمانَ الهَوى عَن عَواذِلي","فَنِمتُ عَلى دَمعَةٍ تَتَحَدَّرُ",216,"ر",1,0],["وكم راحة في راحه جاد لي بها","وقد أودعتها أنشر مسك أنامله",217,"ل",2,0],["وَكَم رامَ صَعباً جاءَ فيهِ بِمُعجِزٍ","يَقومُ لِثاءٍ في الشُؤونِ اِنتِشارُهُ",218,"ر",2,0],["وكم روت الأدهار يسراً لعسرة","سمعنا وأبصرنا وصح دليل",219,"ل",1,0],["وكمران كان فيه مَرسَى","في سوحه أدرك كلٌّ أنسَا",220,"س",2,0],["وكم رحت تستقري الدقائق باحثاً","وجهدك في استقرائهن جهيد",221,"د",1,0],["وَكَم راكِبٍ ظَهرَ الظَلامِ مُغَلَّسٍ","إِلى قَهوَةٍ صَفراءَ مَعدومَةِ المِثلِ",222,"ل",1,0],["وَكَم رَآكَ أَخٌ لي ثُمَّ أَنشَدَني","وَدِّع هُرَيرَةَ إِنَّ الرَكبَ مُرتَحِلُ",223,"ل",1,0],["وكم رددت يدا بالسوء تقصدني","فطاب قلبي كما قد خاب مرماها",224,"ا",3,0],["وكم رأيت بأرض السام من عجب","فكم بها نفق تتلوه تيهاء",225,"ا",2,0],["وكم رجال لهذا الحبر قد خدموا","وأخصلوا القصد والنيات فاتصلوا",226,"ل",3,0],["وكم روض الآمال موطن ريفه","وحسب الحشا الحرانة المورد الصرد",227,"د",1,0],["وَكَم رَدَّدت نَحوي المُلوك خِطابَها","فَما حَظيَت مِنّي بردّ جَوابِ",228,"ب",1,0],["وكم رأينا وأكبرنا ومانعنا","آخيل غيظاً على أتريذ نقتتل",229,"ل",1,0],["وكم رماهم بسهام النوى","كأنّما يأخذ منهم بثار",230,"ر",1,0],["وكمْ رامِها ساعٍ وعاد بحسرةٍ","ولم يعطَ منها في المنامِ خَيالا",231,"ل",2,0],["وكم رعى في مهمةٍ كوكباً","حتى اهتدى السارون بالانجمِ",232,"م",1,0],["وكم رميت بقوسى حاجبيك الى","صب سهاما بها ألقته عيناك",233,"ك",1,0],["وكم راش اسهاماً اصابت حشا رشى","حليفٍ على عَهدٍ وحفظ المودَّةِ",234,"ه",1,0],["وَكَم رَقيقٍ رَشيقٍ مائسٍ هَيَفاً","يضارع البان ليناً وهو خطّارُ",235,"ر",1,0],["وكم رشقت فؤادي من رشيقٍ","سما لَدن الرماح السمهريَّه",236,"ي",2,0],["وكم رَبيت طفلا أرتَجيهِ","وأنكر حسن تَربيَتي كَبيرا",237,"ر",2,0],["وكم رَدَعْتُ فؤادي عن تَهافُتِه","إِلى الصَّبابة رَدْعَ الحازِم البَطَل",238,"ل",1,0],["وكم ركزوا رمحاً بدعصٍ كأَنَّه","من السَّيْلِ والغُثَاء فَلْكَةُ مِغْزل",239,"ل",1,0],["وكم رُمْت أعصي في هواكم فلم أطقْ","خطوباً خطايا الدَّهر فيهنَّ لا أُحصي",240,"ص",2,0],["وكم رأَت عيني نَقيضَ ما رَأَت","مِن اطلاعِ نُورِها تحتَ الدُّجى",241,"ا",1,0],["وكم راحَ يَشكوه إلى لين قده","غداة قسا قلبُ الحبيب بشكواه",242,"ا",2,0],["وكم رام أن يسلو فيقصر هيبة","مضى العمر عنه وهو لم ينو توبة",243,"ه",1,0],["وكم رام أن يدنو فيُنقضُ عزمهُ","ومن ذا لأمر اللَه يغدو مغالبا",244,"ب",2,0],["وَكَم رَوى دَمعَةً عَن عَينِ والِهَةٍ","وَكَم حَوى زَفرَةً عَن قَلب مُحتَرق",245,"ق",1,0],["وكَمْ رَدَّ عنهمْ غارَةً بعدَ غارةٍ","لها عِنْدَهُمْ لولا بَسالَتُهُ رِزْقُ",246,"ق",1,0],["وكم ريعت لفاطمة بنات","كأن وجوهها التبر المذاب",247,"ب",1,0],["وكم ركبتُ جواداً لا تهيئهُ","طعنُ الرماح ولا هنديةٌ البُتُر",248,"ر",1,0],["وكم رأيتُ من الأحزان طارقةً","وكم رأيتُ من الأفراح والبُسرُ",248,"ر",1,0],["وكم رأيتُ أماناً في الزمانِ وكم","خوفاً رأيتُ بأسفاري وفي الحَضَر",248,"ر",1,0],["وكم رقدتُ بأفراحٍ وعافيةٍ","وكم سهرتُ من الأسقام والضررِ",248,"ر",1,0],["وكم رأيتُ سنين الجدب عابسة","وكم سنونٌ أتت بالرونقِ الخضرِ",248,"ر",1,0],["وكم رأيتُ غلاءَ السعر في بلدي","وكم رأيتُ رخيصَ السعر في عُمُري",248,"ر",2,0],["وكم رأيتُ سلاطيناً متوَّجةً","فالدهرُ صيرها من سوقة البشرِ",248,"ر",1,0],["وكم رجس تدنس فيه قوم","يزيد على يزيد فيه ضحكي",249,"ك",2,0],["وكم رزء كسا الدنيا سوادا","أحال نهارها ليلا بهيما",250,"م",2,0],["وكم رمت أمراً خرت لي في انصرافه","فلا زلت بي مني أبر وأرحما",251,"م",2,1],["وكم رامت الحسادُ كمَ فضائلٍ","له فأبى إلا انتشاراً شيوعها",252,"ع",3,0],["وَكَم رامِحٍ مُذ رَامَهُ صارَ أَعزَلاً","وَفي قَلبِهِ مِن عَقرَبِ العقرِ لاذِعُ",253,"ع",1,0],["وَكَم رَكِبَت نَفسي مِنَ الهَولِ مَركَباً","فَيا درّها لِلَّهِ كَيفَ تُصارِعُ",253,"ع",1,0],["وكم ركبوا البحار فما ثنتهم","ولا راع الزمان لهم فؤادا",254,"د",2,0],["وكم روى خندق الأحزاب حنكته","كأنه عالم بالحفْر والرّدَم",255,"م",1,0],["وكم راحت تعاني من شقاء","وقيدت مثل قودٍ للذلول",256,"ل",1,0],["وكم رام قطب الجو تهنئة له","ولكن رأى ما قد رآه فأحجما",257,"م",2,0],["وكم رجوتُ لنا عيداً يجمّعنا","بعدَ الشّتات وما في القلب أشجانُ",258,"ن",1,0],["وكم رغّدت خدك عْيون الفقيرين؟","وكم في عيونك سَرح طرقي وهجّان!",259,"ن",1,0],["وكم رفعوا بؤْساً، وصانوا محارماً","وبالسِّرِّ والصَّمْتِ المهيبِ لكم شادوا",260,"د",3,0],["وكم رقعتُ فؤادي إذ غدا مِزقا","حتى اشتكى جسدي من كثرة الرُّقع",261,"ع",1,1],["وكم رمقتَ شتاتي من خطوطِ يدي","وجال حزنك في وجهي الذي ابتدعكْ",262,"ك",1,0],["وكم رددت على الأعداء حملتهم","بصدمةٍ منك جلت سدفة الريب",263,"ب",1,0],["وكم رأيت رقيع القوم سيدهم","وقد تبوأ منهم مقعد الوثن",264,"ن",1,0],["وكم راموا كما رام المعالي","ولكن كلّهم راموا فناموا",265,"م",3,0],["وكم رام صرف الدهر شق عصيهم","فخاب ولم يفلح بحال رجاؤه",266,"ا",3,0],["وكم رمت الدنيا على المرء غشها","فسمّنه التوفيق لحظة مبصر",267,"ر",1,0],["وكم رامنى هذا الزمان واننى","بآل معز الدين رحت ادافعه",268,"ع",2,0],["وكم رأيتَ عروشَ الظالِمينَ هوتْ","وكم رأيتَ جمالَ العدلِ يسْتَلِمُ",269,"م",1,0],["وكمْ رَأَيْتَ غُزاةً لاقلوبَ لهمْ","جاءوا لِشَهدٍ وراحوا والشِّفاهُ دَمُ",269,"م",1,0],["وكم ركبت بحار العشق كنت بها","ربَّان صحبٍ بنوءٍ عاصف اللججِ !",270,"ج",1,0],["وكمْ رأيتك في بوْحٍ يبوح بِه","منْ قلْبك الشِّعر لكن بعضه سَجفُ",271,"ف",1,0],["وكم رجفت أمام الغيب يقهرني","ويجلد النفس في أسواط إخفاقي",272,"ق",2,0],["وَكَمْ رَبْرَبٍ فِي الظَّاعِنِينَ غَدِيَّةً","يَجِلُّ بِأَنْ يُحْكَى بِأَوْصافِ رَبْرَبِ",273,"ب",1,0],["وكم ركبْتُ صهيلَ البرقِ منطلِقاً","يقودُني خَطَرٌ بِكْرٌ إلى خَطَرِ",274,"ر",1,0],["وكم ردد الأطواد باسم لوائنا","صدى الحمد والتجميد في أذن الشمس",275,"س",1,0],["وكم رَجُلٍ خدعتهُ المُنى","وسلطانُهُ والورى والنَّشَبْ",276,"ب",1,0],["وَ كَمْ رَكِبْنَا خُيُولَ الْعِِزِّ ضَابِحَةً","فَالشَّرْقُ وَ الْغَرْبُ فِي أَفْرَاحِنَا اِرْتَاحُوا",277,"ح",3,0],["وكم رجلِ كبير العقل واعٍ","وكم رجلٍ صغيرِ العقلِ تاها..",278,"ا",3,0],["وكم رسمنا على الجدران ايديَنا","وكم صنعنا برمل البحر تمثالا",279,"ل",2,0],["وَكَم راوَدَتني المُغرِياتُ عَلى الغِنى","وَأَوحَت بِأَنَّ المالَ يَنحَطُّ تارِكُه",280,"ك",2,0],["وَكَم رَأيٍ تَأَصَّلَ كَاعتِقادٍ","يُبَدِّلُهُ روحَهُ مِثلَ الشِّراعِ",281,"ع",1,0],["وكم رُحْتُ أَهْذي بالقصائد حُرَّةً","فألفيتُني أَبْني لحرّيتي سِجْنا",282,"ن",2,0],["وكم رافعٍ لي بالعداوة ِ صوتهُ","يهبهبُ في إبعادهِ ويهيبُ",283,"ب",1,0],["وكم رفيق أتى بعدي فعاجله","فَرْطُ الأذى فمضى يَسْتَنُّ في أثري",284,"ر",2,0]]}