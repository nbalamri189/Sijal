oem34792.html","الطويل"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[438,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[438,"إذا كان أولادي وأولاد أولادي","https://www.aldiwan.net/poem14362.html","الطويل"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[456,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[456,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[459,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[462,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[462,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[477,"بعثتك يا جرير من اللحود","https://www.aldiwan.net/poem37033.html","الوافر"],[477,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[480,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[496,"أطاعتك الذوابل والشفار","https://www.aldiwan.net/poem3696.html","الوافر"],[503,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[504,"صحبت الزمان وقابلته","https://www.aldiwan.net/poem2387.html","المتقارب"],[518,"لسعد قدومكم هبّ النسيم","https://www.aldiwan.net/poem815.html",""],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[549,"عليك ولي نعمتنا سلامي","https://www.aldiwan.net/poem47215.html","الوافر"],[549,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[549,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[549,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[549,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[556,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"],[560,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"],[560,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[573,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[573,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"]],"verses":[["وَكَم رَمَتني مِنَ الأَقدارِ مُنبِضَةٌ","لَم تَثنِ باعي وَلَم يَحرَج لَها عَطني",0,"ن",2,0],["وَكَم رَحِمٍ أَطَّت بِهِ وَهوَ مُغضَبٌ","فَعادَ إِلى الإِحسانِ غَيرَ مَطولِ",1,"ل",1,0],["وَكَم رُفِعَت لي نارُ حَيٍّ فَجُزتُها","وَما نارُ مَمنونِ القِرى مِن مَقابِسي",2,"ي",1,0],["وَكَم رَشأٍ عاطِلٍ شاقَني","إِلى رَشأٍ في مَغانيه حالِ",3,"ل",1,0],["وكمْ رُمْتُ أنْ يُجْدي البُكاءُ فلَمْ يكُنْ","ليُجْدي ورجّعْتُ الحَنينَ فلَمْ يشْفِ",4,"ف",1,0],["وكمْ رِيءَ منْ نَجْلٍ أبَرَّ بفَضْلِهِ","علَى الوالِدِ المَشْهورِ بالفَضْلِ والجَدِّ",5,"د",1,0],["وكمْ رصَدَتْ منّا العُيونُ طُلوعَها","فحُقِّقَ نصْرُ اللهِ في ذلِكَ الرّصْدِ",6,"د",1,0],["وكمْ رامِحٍ للفُرْسِ فيها ونابِلٍ","وراحٍ نُعاطِيها مُهَفْهَفَةَ القَدِّ",7,"د",1,0],["وكم رَمَت قَسماتُ الحُسنِ صاحِبَها","وأتعَبَتْ قَصَبَاتُ السَّبقِ حاويها",8,"ي",3,0],["وَكَم راضَ صَعباً جامِحاً مُتَمَنِّعاً","يُلايِنُهُ طَوراً وَطَوراً يُصاعِبُه",9,"ب",2,0],["وَكَم رَدَدتَ العِدى عَنها بِغَيظِهِمُ","وَأَكبُدُ القَومِ لِلأَحقادِ تَلتَهِبُ",10,"ب",1,0],["وَكَم راسَلَ الغَيرانُ يُهدي وَعيدَهُ","فَما راعَهُ إِلّا الطُروقَ جَوابُ",11,"ب",1,0],["وَكَمْ رَبِيبةِ خِدْرٍ","صَاغَتْهُ صَوْغاً سوِيَّا",12,"ي",2,0],["وكم راقٍ بها في جوّ علم","ليستهدي بأنجمه ويهدي",13,"ي",1,0],["وكم رام اسكاتي أناس أبى لهم","خَنى الطبع إلاّ أن يروا لي حُسّدا",14,"د",2,0],["وكمُ رمتُ أيقاظاً فأعيا هُبُوبُهم","وكيف وعزم القوم شارب مُرقِد",15,"د",1,0],["وَكَم رَدَدنا بِبَدرٍ دونَ ما طَلَبوا","أَهلَ النِفاقِ وَفينا أُنزِلَ الظَفَرُ",16,"ر",1,0],["وكم رأيناك لمربى الثنا","أباً فجئناك بدرٍّ يتيم",17,"م",1,0],["وكم رأينا بَرْقَهُ ضاحكاً","فيها إلى ذي مَضْحكٍ أَشْنَبِ",18,"ب",1,0],["وكم رُمتُ صبراً إذا جُفيتُ وما أرى","إليه سبيلاً أو يُفاضحني الجهر",19,"ر",1,0],["وكم رماني العدى بداهيةٍ","كاستْ على رأسها ولم أكُس",20,"س",1,0],["وكم رمتُ حدّ السيف منك تسلُّطاً","عليك فلم تَنقُضْ بيَ الكفُّ مَنْقضا",21,"ض",2,0],["وكم راقع حسباً واهياً","بمدح وإن كان لا يرتقع",22,"ع",1,0],["وَكَم رَكَضتِ فَأَغرَيتِ الصِغارَ ضُحىً","بِالرَكضِ في الحَقلِ مَلهاهُم وَمَلهاكِ",23,"ك",1,0],["وَكَم رُمتُ أَنّي لا أَقولُ فَخِفتُ أَن","يَقولَ لِسانُ الحالِ وَهوَ فَصيحُ",24,"ح",1,0],["وكم رأى ليلُكَ الأَشباحَ هائمةً","مَذْعورةً تتهاوَى حَوْلَها الرُّجمُ",25,"م",1,0],["وَكَمْ رسمتَ رسوماً لا تُشابِهُها","هذي العَوالِمُ والأَحلامُ والنُّظُمُ",25,"م",1,0],["وَكَم رَعَتها العَينُ في","السُكونِ وَالتَحَرُّكِ",26,"ك",1,0],["وَكَم رِجالٍ بِلا أَرضٍ لِكَثرَتِهِم","تَرَكتَ جَمعَهُمُ أَرضاً بِلا رَجُلِ",27,"ل",1,0],["وَكَم رُمتُ أَن أَسلو الصَبابَةَ نازِعاً","وَكَيفَ اِرتِجاعي فائِتاً قَد تَقَدَّما",28,"م",2,0],["وكم رسمت على جدرانها صور","وكم كسرت على أدراجها لعبا",29,"ب",2,0],["وكم ريع صرف الدهر منه بأروع","يلاقي جبين الخطب غير جبان",30,"ن",1,0],["وَكَم رَأَينا مِن ذَوي ثَروَةٍ","لَم يَقبَلوا بِالشُّكرِ إِقبالَها",31,"ل",3,0],["وكم ردّها مَفْلُولَةً حدُّ صبرِهِ","إذا جَزعُ الهيجاءِ فلّ شَبَا الصَّبرِ",32,"ر",1,0],["وكَمْ رَاعَت لِبغْلَتِهِ شِمالاً","وكَمْ رَاعَتْ لِبَغْلَتِهِ يَمِينا",33,"ن",2,0],["وَكَم رائِشٍ بارٍ وَلَولا مُحَمَّدٌ","طَوَتهُ اللَيالي ما يَريشُ وَلا يَبري",34,"ي",1,0],["وَكَم رَأَتِ الفَراقِدُ وَالثُرَيّا","قَبائِلَ ثُمَّ أَضحَت في ثَراها",35,"ا",3,0],["وكم رِياضٍ بحَزْنٍ لا يَرودُ بها","ليْثُ الشَرى وهيَ مَرْعَى الشادنِ الخَرِقِ",36,"ق",1,0],["وَكَمْ رَفَعْتَ لِقَوْمٍ","ذِكْراً وقَوَّضْتَ ذِكرَا",37,"ر",2,0],["وكم رأيتُ يراعًا خاض معركةً","ثم انثنى بدم الأعداء مُختَضَبا",38,"ب",2,0],["وكم رُمِيَّ الحرُّ الكريم لديهمو","بغلظة ساعٍ، أو فظاظة حاجب",39,"ب",1,0],["وكم رسالةِ حبٍ جاءَ يحملها","كالبرق وهْوَ حثيثُ الخَطْو عجلان",40,"ن",1,0],["وكم رىء من نجل أبر بفضله","على الوالد المشهور بالفضل والحمد",41,"د",1,0],["وكم رامح للفرس فيها ونابل","وراح تعاطيها مهفهفة القد",42,"د",1,0],["وكم رسمتُ على جدرانِها صوراً","وكم كسرتُ على أدراجها لُعبا",43,"ب",2,0],["وكم رأينا اسآات الغرام به","ولطف معناه معروفا واحسانا",44,"ن",2,0],["وكم رام الحسود لي احتقاراً","ومنك حمى حماي الاحتشام",45,"م",1,0],["وَكَم راقَ شِعرٌ ما حَبيبٌ أَتى بِهِ","وَقَدَّ الطُلى سَيفٌ وَما عَرَفَ الهِندا",46,"د",2,0],["وكم رائمٍ رام الجمال الذي ترى","فأرداه منها لحظها ومناها",47,"ا",3,0],["وَكَم رُمتُ تَرحالاً أَفوزُ بِبِرِّهِ","وَذَنبيَ أَقصاني فَبُؤتُ بِخُسرِهِ",48,"ه",1,0],["وكم رأوا مثله قدما وكم سمعوا","وعظا فصموا لأحكام القضا وعموا",49,"م",3,0],["وَكَم راجِلٍ أَمسى بِنُعماهُ فارِساً","وَكانَت صَفايا مالِهِ المَعزُ وَالضانُ",50,"ن",1,0],["وكَمْ رَيْبَ لِصَرْفِ الدهرِ هَابٍ","جَلاَهُ النَّصْرُ مِنْ رَبٍّ مَهُوبِ",51,"ب",1,0],["وكم رُمت عَوْدا مرةً بعد مرةٍ","إليها فيَثْنِى من عنانىّ حابس",52,"س",1,0],["وكم رمّدت من حدث طريف","له في حال منطقه اتساع",53,"ع",1,0],["وكم رقبة لي والرقى تدفع الأذى","إذا لم يكن فيه حمام بغاتها",54,"ت",3,0],["وَكَم رحلتَ إلى أمرٍ بهِ أربٌ","مِن أمردين ودُنيا قد عنيت بهِ",55,"ب",2,0],["وَكَم رَحلوا لِلشركِ في دار رجسهِ","وَجابوا إلى أَوطانهِ البرَّ وَالبَحرا",56,"ر",2,0],["وَكَم رمضانٍ جاءَهم ما تسحّروا","وَقَد أطعموا سمرَ القَنا النحرَ والسحرا",57,"ر",2,0],["وَكَم رَفعوا رُمحاً وضمّوا مهنّداً","وَكَم نَصبوا حَرباً وكَم فَتحوا ثَغرا",57,"ر",2,0],["وكم رأيتُ ظباء الكرخ سارحة","بالسكر ما بين أورادٍ وغدران",58,"ن",1,0],["وكم رسائلَ تلقيها السمالء به","للعاشقين فيأتيهم ويُلقيها",59,"ي",3,0],["وكم رد من عين وجاد بها وكم","اصابعه فاضت وللجيش روّت",60,"ت",1,0],["وكم راح غر بألقابه","ضميرا بجوف الثرى مضمرا",61,"ر",2,0],["وكم رَصَدته آمالُ البرايا","حوافلَ قبلَ يُظْهِره الوجودُ",62,"د",1,0],["وكم رَجَتِ الخلافةُ أن تراه","كما يرجو أحِبَّتَه العمِيد",62,"د",1,0],["وَكَمْ رَبَّتْ بِأَنْعُمِهَا يَتِيماً","قَلَتْهُ أُمُّهُ حَتَّى سَلاَهَا",63,"ا",3,0],["وَكَم رجالكَثير كنت آملهم","وَلَم يَزل لابس الآمال عريانا",64,"ن",2,0],["وَكَم رَعى بالتَعنى حق حرمتهم","مبالغا فيهم التَحذير وَالنذر",65,"ر",1,0],["وَكَمْ رُمْتُ في دارِ الخِلافَةِ أُيِّدَتْ","قَرَاراً فَأعْيَا والْمَوَاهِبُ أسْهُمُ",66,"م",1,0],["وَكَمْ راوٍ كَأَنَّ بِفِيهِ مِنْها","مُجاجَ النَّحْلِ حُبَّ بِهِ مُجاجا",67,"ج",2,0],["وَكَم رَدَّ عُقبانَهُ وَهيَ حُمرٌ","وَقَد كُنَّ بيضاً كَلَونِ الحَمامَه",68,"م",2,0],["وَكَم رؤوسٍ وأَجسامٍ هنالِك قَد","أَصبَحنَ ما بين مَرفوعٍ وَمَجرورِ",69,"ر",1,0],["وكم راح يستجلي عذار بنفسجٍ","سقته الغوادي صوبها فتنمنما",70,"م",2,0],["وكم رأينا سميناً","لأنفس الناس غثى",71,"ث",2,0],["وكم رمت أن أخفى هوى ظبية الحمى","فلم أستطع واللائحات شهود",72,"د",1,0],["وَكَم رامَ العَذولُ عَلَيكَ مِن","نا اِنثِناءً عَن هَواكِ وَما اِنثَنَينا",73,"ن",2,0],["وَكَم رامَ الوُشاةُ بِنا اِنثَناءً","عَنِ الظَبيِ الأَغَنِّ فَما اِنثَنَينا",74,"ن",2,0],["وَكَم رَئيس عَزيز قَد تحكم في","جُثمانِه بَعد ذاكَ العِز ما كانوا",75,"ن",3,0],["وكم رَضَعَ الرَّجاءُ نَداكَ قِدْماً","رَضاعاً لم يُعقِّبْهُ فِصالا",76,"ل",2,0],["وكم راحَ عانٍ للصّبابةِ حائرٌ","وكم لاحَ عِينٌ للنّواظِرِ حُور",77,"ر",1,0],["وَكَم رَسائِلِ تَسليمٍ مُحَمَّلَةٍ","لِلطَيفِ وَالبَرقِ وَالأَرواحِ وَالسُحُبِ",78,"ب",1,0],["وكم رأيت لغيري غيره عضُداً","لكن أولئك مرعى وهو سعدان",79,"ن",1,0],["وكم رياض قد نزلنا بها","ساجلنا في دوحها البلبل",80,"ل",1,0],["وكم روضة قد أنزلونا كأنها","رياض جنان الخلد شكلاً على شكل",81,"ل",1,0],["وكم رسالات له حبرت","ترشف بالأسماع كالقرقف",82,"ف",1,0],["وكم رام أقوام وهموا بسفكهم","دمي فأبى الرحمن نَيْلي بالضر",83,"ر",1,0],["وكمْ روضةٍ تَستفيدُ الريا","ض مِنهُنَّ نوراً ونَبْتاً عَميما",84,"م",2,0],["وكم رعى بعضُنا بَعضاً وكانَ لهُ","مزاوِجاً كازدِواجِ الرُّوحِ والبَدَنِ",85,"ن",1,0],["وَكَم رام ثَوبَ العِزِّ إِنَّ سَتيرَهُ","بِذُلِّ وَأَن تَلقى له الدَهرَ مالِكا",86,"ك",2,0],["وَكَم رَجُلٍ أَثوابُهُ دونَ قَدرِهِ","وَقَد يَلبِس السلك الجمان الفَرائِدا",87,"د",2,0],["وكم رَماني العِدا بَغياً بِإفكِهِمُ","فلَمْ أَرقَّ ولم أفرَقْ لبَغْيِهِمُ",88,"م",1,0],["وكم راح يغنيني عن الزهر أغيدٌ","بنرجس عينيه وآس عذاره",89,"ر",2,0],["وكم رفع الزَّمان وضيع نفس","فنال الحظَّ بالباعِ القصير",90,"ر",1,0],["وكم رُزِقَ المكانَةَ من أُناسٍ","لَوِ اختيروا لما وَجَدوا مكانا",91,"ن",2,0],["وكم رامَني والرّحْبُ بيني وبينَه","فقلتُ له لا زِلتَ في المنزلِ الضّنْكِ",92,"ك",1,0],["وكم ركَزوا رماحَهُمُ كِناساً","وسمّوها وما صدَقوا غيابا",93,"ب",2,0],["وكم رامَ مجدَك من حاسدٍ","فجُرِّدَ من حُلّةِ السّالِمِ",94,"م",1,1],["وكم راقَ طرفي من رائعٍ","يقول وقد غرّني غَرري",95,"ر",2,0],["وكم رُعْتَها بالسَّيْفِ فِي كُلِّ بَلْدَةٍ","فإِنْ أَقْدَمَتْ يَوْماً ففِي بَسْطِكَ السَّلْما",96,"م",2,0],["وكم رأَينا وجوهَ الروضِ ضاحِكَةً","فِي رائِحٍ راحَ أَوْ فِي بارِقٍ بَرَقا",97,"ق",2,0],["وكمَ رَدَّ عَنْ نَفْسِ ابْنِ شَنْجٍ سِهامُها","وَقَدْ أَغرقتْ نَزْعاً وأَمكَنَها رَمْيا",98,"ي",2,0],["وكم رأى من عجيبات الغيوب بها","وكم أفادته من فضل غيابته",99,"ت",2,0],["وكم رائدٍ منهم إلى الحشر قد مضى","ولم يبق منه أجساد",100,"د",1,0],["وكمروان وابنه حين واسى","بلذاذات عيشه سُمّاره",101,"ر",2,0],["وكمروان ذي الفتوة إِذ كا","ن يوالي في غبطة أسفاره",101,"ر",2,0],["وكم ريع بالبطحاء من متودِّع","وقُلقِلَ ركب للنوى وهو وادعُ",102,"ع",1,0],["وكم رافعٍ لي بالعداوةِ صوتَهُ","يُهبهِبُ في إيعادِهِ ويُهيبُ",103,"ب",1,0],["وكم رقدوا وأنت من التَّروي","لكسبِ المجد ممتنعُ الرُّقادِ",104,"د",1,0],["وكم رحت مهزوز الجوانح والحشى","بزينبه ذات الجمال وجُملهِ",105,"ل",2,0],["وكم رجمتْ فيَّ الظنون وما دروا","لمن أنا باكٍ أو بمن أنا مغرم",106,"م",1,0],["وكم ركبتُ بهيم الليل في غرضٍ","وبدره غرةٌ والصبح تحجيل",107,"ل",1,0],["وكم رممته بيتا خرابا","وكم لي في قريضك من شهود",108,"د",1,0],["وكم رضعت لبانه من شعوب","صغار فارتقت به للكبار",109,"ر",1,0],["وكم رفعوا به للحق صوتا","فأصبح لابسا تاج الوقار",109,"ر",1,0],["وكم رمتني بسهم الدهر عن بعد","وما أحول عن التهيام أنتشق",110,"ق",1,0],["وكم رعفت لذاذات المنى ولكم","جارت علينا وكم للقلب ينفهق",110,"ق",1,0],["وكم رتقت ميادين المعاطب لا","يألوني جهدا هيامي ما أرى أفق",110,"ق",1,0],["وَكَم رامُوا الفرار مِن الرَزايا","وَلَكن أَين مِن أَجلٍ فِرارُ",111,"ر",1,0],["وكمْ رجوتُ الفراقَ علِّيْ","بهدْي أهل السّما أثوبُ",112,"ب",1,0],["وكم رام هضمي فما هاض لي","جناحا ولا فل للصبر نابا",113,"ب",2,0],["وكم رقصت جبال مرّ فيها","حليف الحود تيمور الكريمُ",114,"م",1,0],["وكم رمانا الرّدى عن قوسِ مَعْطَبَةٍ","فَصدّه اللَّهُ أن يُصمي فَأَشوانا",115,"ن",2,0],["وَكَم رُمناكَ لِلجَدوى علينا","فَما رُمناك ممتنع المرامِ",116,"م",1,0],["وكم رام اِمرؤٌ بهمُ لُحوقاً","بطرقِ المأثُراتِ فما اِستوى لَهْ",117,"ل",2,0],["وكم رامه منّي الرّجالُ وإنّما","يرومون نجماً غارباً ليس يطلعُ",118,"ع",1,0],["وكم رَمْيَةٍ لم تُصْمِ ممَّن رمى بها","وكم قولةٍ من قائلٍ ليس تُسمَعُ",119,"ع",1,0],["وَكَمْ رَضيتُ ولكنْ زدتُكمْ سَخَطاً","وَلَيسَ بعدَ الرّضا شيءٌ سوى الغَضَبِ",120,"ب",1,0],["وكم رحمة منه وافت لنا","وكم نقمة قد تولت وكم",121,"م",1,0],["وكم رفعت بلاً عنّا ونائبة","والنفس من ذنبها جاءتك تائبة",122,"ه",1,0],["وكم رَجُلٍ يقومُ مَقامَ جيشٍ","ويَسقُطُ دونَهُ الجيشُ العظيمُ",123,"م",1,0],["وكم رَجلٍ دَعَوتُ فلم يُجِبْني","ويَدعُوني سِواهُ فلا يُجَابُ",124,"ب",1,0],["وكم رمتُ قَتْلَ النَّفس فيكم فَصدَّني","وصبَّرني عن قتلِ نفسِيَ إِيماني",125,"ي",1,0],["وكم رام مِنَّا قوْمُها أُنفساً لنا","وقد طلبُوا بَعض الذي أَخذَتْ منَّا",126,"ن",2,0]]}