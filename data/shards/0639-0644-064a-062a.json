{"poems":[[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[49,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[53,"كم قرون في رؤوس","https://www.aldiwan.net/poem66757.html","مجزوء الرمل"],[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[64,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[50,"نزوج الخمر من الماء في","https://www.aldiwan.net/poem64425.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85453","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62216","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[38,"علي تقاهادائماً وفجورها","https://www.poetsgate.com/ViewPoem.aspx?id=15873",""],[108,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[186,"لقد سار جبريل الكريم مهاجرا","https://www.aldiwan.net/poem61076.html","الطويل"],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[203,"زمان عيشنا فيه اضطرار","https://www.aldiwan.net/poem45408.html","الوافر"],[275,"رأيت الناس في السير الحثيث","https://www.aldiwan.net/poem35177.html","الوافر"],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[287,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[287,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32759.html","البسيط"],[287,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[303,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[310,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[409,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[447,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[447,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[447,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[567,"متى نرجو الثبات من الزمان","https://www.aldiwan.net/poem52921.html","الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107246","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66779","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56206","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112938","الوافر"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198192","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144096","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113939","البسيط"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96345","المتقارب"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138026","الوافر"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118428","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123051","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60844","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60842","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93685","الطويل"],[2487,"","https://poetry.dctabudhabi.ae/diwan/poem/205114","البسيط"],[2487,"","https://poetry.dctabudhabi.ae/diwan/poem/205112","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87347","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105666","الوافر"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141194","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100295","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204438","الطويل"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130613","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138486",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138451",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117948","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135350","الوافر"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17777","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107527","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72433","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72522","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139751",""],[4680,"ترنيمة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=185758",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4733,"إيلانُ عينُ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=188652",""],[4733,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=197875",""],[4869,"ياملهمي","https://www.poetsgate.com/ViewPoem.aspx?id=151530",""],[4869,"تويتر","https://www.poetsgate.com/ViewPoem.aspx?id=151685",""],[5002,"أقبل أيها العيد","https://www.poetsgate.com/ViewPoem.aspx?id=202376",""],[5111,"حَسْنَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212126",""],[5138,"عايش مع الاحزان","https://www.poetsgate.com/ViewPoem.aspx?id=184843",""],[5183,"من وحي تونس","https://www.poetsgate.com/ViewPoem.aspx?id=180207",""],[5273,"وساوس شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=180052",""],[5277,"سيدةُ المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=200484",""],[5335,"الموعد الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=35186",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5725,"عراق شعلان وضاري","https://www.poetsgate.com/ViewPoem.aspx?id=177471",""],[5781,"كمشةُ أحزانٍ بيدي...","https://www.poetsgate.com/ViewPoem.aspx?id=208992",""],[5806,"في شوفتك أعظم جروحي تشآفت","https://www.poetsgate.com/ViewPoem.aspx?id=176649",""],[5973,"تعجلت الرحيل إلي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22123",""],[6128,"تصرَّف","https://www.poetsgate.com/ViewPoem.aspx?id=212858",""]],"verses":[["عَلَّيتَني حَتّى تَحَقَّقَتِ العِدى","أَنّي حَميمٌ لِّلعُلى وَعَقيدُ",0,"د",1,0],["عَلى تِلكَ الحُدوجِ إِذِ اِحزَأَلَّت","وَأَنتَ بِهِم غَداةَ إِذٍ مَجودُ",1,"د",1,0],["عَلى تَيماً فَدَقَّ رِقابَ تَيمٍ","ثَقيلُ الوَطءِ ذو جَرَزٍ نَبيلِ",2,"ل",1,0],["عُلىً تُستَفادُ وَمالٌ يُفادُ","وَعِزٌّ يُشادُ وَنُعمى تُرَب",3,"ب",1,0],["عُلِّيَتْ فيها قِبابٌ","قبل عبدِ الصَّمَديَّهْ",4,"ه",1,0],["عَلى تَرائِبِ غِزلانٍ مُفاجَأَةٍ","ريعَت فَأَقبَلنَ بِالأَعناقِ وَالعُذَرِ",5,"ر",1,0],["عُلىً تستقِلُّ ولا يَسْتَقرّ","بها دونَ بابِكُمُ مضجَعُ",6,"ع",1,0],["عَلى تَماثيلِ بَني بابِكٍ","مُحتَفَرٌ ما بَينَهُم خَندَقُ",7,"ق",1,0],["عَلى تَبجيله قد كا","ن كل الناس متفقا",8,"ق",2,0],["عَلَى تَبَاعُدِهِمْ يَنْزلْ ثَوَابُكُمَا","والدَّهْرُ بِالنَّاسِ ذُو نَقْصٍ وإِمْرَارِ",9,"ر",1,0],["على تونس وبمرّاكشٍ","تروح السيوفُ وتغدو اختيالا",10,"ل",2,0],["عَلِيُّ تَرْعَاكَ عُيُونُ العَلِي","أَنْتَ رَجَاءُ الزَّمَنِ المُقْبِلِ",11,"ل",1,1],["عَلى تَعميرِ نوحٍ ماتَ نوحُ","فَنائِحَةٌ لِأَمرٍ ما تَنوحُ",12,"ح",1,1],["علي تقاهادائماً وفجورها","ائما وفُجُورُها",13,"ه",2,1],["على تُخومِكُمُو، يا قوم، عن كثب","خَصْمٌ أَلدُّ خَئُونُ العهد، تحاذِرُه",14,"ر",2,0],["عَلى تُربةٍ أَرِّخ رَسَمنا بِصَفحها","أَيا حامِلاً بُشرى السَلامِ لَكَ البُشرى",15,"ر",2,0],["على تلك الدِّيارِ ومَنْ حَوَتّها","سلامٌ كالسلامةِ يُسْتَطاب",16,"ب",1,0],["على تلكَ القصورِ أرى دخاناً","أخفَ عليكَ منهُ ذا الغبارُ",17,"ر",1,0],["على تفاحةٍ أُكِلت فسوقاً","وفحشاً لعنةُ الولدِ الوريث",18,"ث",1,0],["عُلىً تُقْذِي الْعُيُونَ مِنَ الأَعادِي","وَتُنْبِتُ فِي قُلُوبِهِمُ الْحَزازا",19,"ز",2,0],["عَلى تَرائِبِ كافور تُزَيِّنُها","حِقاقُ عاجٍ عَلَيها عاجَتِ الفِكرُ",20,"ر",1,0],["عَلى تَقبيلِهِ لَهُمُ اِزدِحامٌ","كَما لَهُمُ عَلى الرُكنِ اِزدِحامُ",21,"م",1,0],["عَلى تَرائِبِ كافورٍ تُزَيِّنُهُ","حقاقُ عاجٍ عَلَيها عاجَتِ الفِكَرُ",22,"ر",1,0],["عَلى تَسويدِ وَجهِكَ لَستُ ألحى","وَلَو سَوَّدتُهُ بِخَرا الكلابِ",23,"ب",1,0],["على تقاسِمهمْ مِنْ دون غيرهمُ","يبيتُ مختلفُ الأقوامِ مصطلحا",24,"ح",2,0],["عَلى تقى اللّه قَد أَضحت مؤسّسةً","في منعةٍ وجباياتٍ وتجنيدِ",25,"د",1,0],["على توبة باللّه هل أنت عازم","فكل الذي أسلفت عندي جرائم",26,"م",1,1],["على تالد الأَيام لي طارف الأَسى","وفي كل حين مفجع وشتات",27,"ت",1,0],["على تالد الأيام لي طارف الأَسى","وفي كل يوم لي من الحزن مشهد",28,"د",1,0],["على تالد الأيام لي طارف الحزن","فقدني بما أُبليت من حزن قدني",29,"ن",2,1],["على تَرْباء أرض لم تَلِقْها","مدارجُها الخِباتُ ولم تَلِقْني",30,"ن",2,0],["على تلكَ الدِيارِ لَنا سَلامٌ","نُرَدِدُهُ مع البَرقِ اليماني",31,"ن",2,0],["عَلى تِلكَ الملاهِي فاسقِنِيها","إِذا ما الكأسُ أَشهى ما اشتَهَيتُ",32,"ت",1,0],["على تحكيمِهِ فَعَموا وصمُّوا","كتابَ اللهِ في فمِ جُبْرَئيلِ",33,"ل",1,0],["على تَحَرُّق القلب","على تَحدُّر الدَّمع",34,"ع",1,0],["عليتِ بهم متن العلا وازدهى بها","زهيّ زهاكِ بالشيوخ المقادمِ",35,"م",1,0],["على ترادفت زمر الخطايا","ونفسي قد رمتني بالصدود",36,"د",1,0],["على تلك الشَّمائل والسَّجايا","وحسن العهد والخُلُق السَّجيح",37,"ح",1,0],["على تُيوسٍ ما لهم","في المكرُماتِ بازغهْ",38,"غ",2,0],["على تَنِجِّن ألِمّا تبكيان بِها","صنديدَ مجدٍ لأشياخٍ صناديدا",39,"د",2,0],["علي تعطف من وائل","اذا قمت كل جواد خضم",40,"م",1,0],["عَليُّ تارِكٌ عَمْراً كَجِذْعٍ","لقىً بَيْنَ الدَّكادِكِ وَالرَوابي",41,"ب",2,0],["عُلىً تنتمي أعراقُها أوَّلِيَّةٌ","تَعَرَّقَ في خيرِ الأنامِ لها نَجرُ",42,"ر",1,0],["على تفنن اهل الوصف بلغوا","من حد اوصافه تسعا ولا عشرا",43,"ر",2,0],["على تلافي مولى مال واقتدرا","وما درى فتلافى ذاك وقت درى",44,"ر",2,1],["على تعهن أرسلتها في عواهن","تجد فلا تألو ولا تأتلي جدا",45,"د",2,0],["عَلِيتْ مناكِبه وطال سَنامُه","فتراه مثلَ الناقةِ العُشراء",46,"ا",2,0],["عليَّ تعْتَبُ سُعْدى في تَنآئيها","فاسمع شكيتها وانظر تجنّيها",47,"ي",3,1],["علي تَصدق يا علي بِنَظرة","فَقَلبي مَحروم وَدَمعي سائل",48,"ل",1,0],["على تقادمِ ما قد مرّ من زمنٍ","مع الذي مرَّ من ريحٍ وأمطارِ",49,"ر",1,0],["على تقادم ما قد مر من عصر","مع الذي مر من ريح وأمطار",50,"ر",1,0],["على تسعِ مَايةٍ وستةِ مُقدَمِ","تُعَدُّ مِنَ الهُجراتِ للمتقدِّمِ",51,"م",1,0],["على تلك الوداعة عش كريما","بجعلك ساحبا ذيل العفيف",52,"ف",1,0],["على تحصيل دنياك الدنيه","مجداً في الصباح وفي العشيه",53,"ه",1,0],["علىً تلوى لها الأعناق حفظا","فتخضع خشَّعا طوعا وقرا",54,"ر",2,0],["عليَّ تمرّدْ بل على النفس والورى","لتبقى على طول المدى تتجدد",55,"د",1,0],["علي تبدى وهو بدر الغياهبِ","فاضحى العلى في أنفه أيَّ ثاقبِ",56,"ب",1,1],["علي تعاليت عن ان تحاط","صفاتك بالعقل فلييأس",57,"س",1,1],["علي تردى ببرد الجلا","ل وثوب الجمال به مكتسي",57,"س",2,0],["علي تفضل بالمنى متطولاً","فلا ذل يعرو من حبوت ولا وهن",58,"ن",1,0],["عَلى تلكَ الوجوه وَإِن تفانَت","سَلامُ اللَه ما طلعَت بدور",59,"ر",1,0],["على تناول شيء من خصائصه","سلب النهى إن سرى فيها معتقه",60,"ق",2,0],["على توافق أو اختلاف","ولا أرى في الحكم من خلاف",61,"ف",1,0],["على تسخيرك الظُّلاَّم فضلاً","وليس سواك للظُّلاَّمِ قاهرْ",62,"ر",1,0],["عَلى تُربِكَ الغالي نَثَرتُ قَلائِدي","وَسَيَّرتُ أَمثالي مَسيرَ الكَواكبِ",63,"ب",1,0],["عَلى تُكُآتٍ مِن وَسائِدَ تَحتَها","سَريرٌ كَأَنقاءِ النَعامَةِ يَرجُفُ",64,"ف",1,0],["على تلك الرُبى أُمٌّ جَزوعٌ","تناديك الغداةَ ولا تُجابُ",65,"ب",1,0],["على تقوى الإله أتيت سؤلاً","لجمع شمولنا كرَّ الدهورِ",66,"ر",1,0],["علي تجنى قبل ما ناظري جنى","ورود خدود في يد الفكر لا تجنى",67,"ن",2,0],["على تبحره في العلم شاهدة","كفى بها شاهدا في حق مشهود",68,"د",1,0],["على تربِهِ غيثان من واكف الحيا","مُلِثٌّ 