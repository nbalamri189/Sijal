{"poems":[[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[49,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[53,"كم قرون في رؤوس","https://www.aldiwan.net/poem66757.html","مجزوء الرمل"],[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[64,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[50,"نزوج الخمر من الماء في","https://www.aldiwan.net/poem64425.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85453","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62216","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[38,"علي تقاهادائماً وفجورها","https://www.poetsgate.com/ViewPoem.aspx?id=15873",""],[108,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[185,"لقد سار جبريل الكريم مهاجرا","https://www.aldiwan.net/poem61076.html","الطويل"],[188,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[202,"زمان عيشنا فيه اضطرار","https://www.aldiwan.net/poem45408.html","الوافر"],[273,"رأيت الناس في السير الحثيث","https://www.aldiwan.net/poem35177.html","الوافر"],[283,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[285,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[285,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[285,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32759.html","البسيط"],[285,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[301,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[308,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[406,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[444,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[444,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[444,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[460,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[564,"متى نرجو الثبات من الزمان","https://www.aldiwan.net/poem52921.html","الوافر"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17777","الطويل"]],"verses":[["عَلَّيتَني حَتّى تَحَقَّقَتِ العِدى","أَنّي حَميمٌ لِّلعُلى وَعَقيدُ",0,"د",1,0],["عَلى تِلكَ الحُدوجِ إِذِ اِحزَأَلَّت","وَأَنتَ بِهِم غَداةَ إِذٍ مَجودُ",1,"د",1,0],["عَلى تَيماً فَدَقَّ رِقابَ تَيمٍ","ثَقيلُ الوَطءِ ذو جَرَزٍ نَبيلِ",2,"ل",1,0],["عُلىً تُستَفادُ وَمالٌ يُفادُ","وَعِزٌّ يُشادُ وَنُعمى تُرَب",3,"ب",1,0],["عُلِّيَتْ فيها قِبابٌ","قبل عبدِ الصَّمَديَّهْ",4,"ه",1,0],["عَلى تَرائِبِ غِزلانٍ مُفاجَأَةٍ","ريعَت فَأَقبَلنَ بِالأَعناقِ وَالعُذَرِ",5,"ر",1,0],["عُلىً تستقِلُّ ولا يَسْتَقرّ","بها دونَ بابِكُمُ مضجَعُ",6,"ع",1,0],["عَلى تَماثيلِ بَني بابِكٍ","مُحتَفَرٌ ما بَينَهُم خَندَقُ",7,"ق",1,0],["عَلى تَبجيله قد كا","ن كل الناس متفقا",8,"ق",2,0],["عَلَى تَبَاعُدِهِمْ يَنْزلْ ثَوَابُكُمَا","والدَّهْرُ بِالنَّاسِ ذُو نَقْصٍ وإِمْرَارِ",9,"ر",1,0],["على تونس وبمرّاكشٍ","تروح السيوفُ وتغدو اختيالا",10,"ل",2,0],["عَلِيُّ تَرْعَاكَ عُيُونُ العَلِي","أَنْتَ رَجَاءُ الزَّمَنِ المُقْبِلِ",11,"ل",1,1],["عَلى تَعميرِ نوحٍ ماتَ نوحُ","فَنائِحَةٌ لِأَمرٍ ما تَنوحُ",12,"ح",1,1],["علي تقاهادائماً وفجورها","ائما وفُجُورُها",13,"ه",2,1],["على تُخومِكُمُو، يا قوم، عن كثب","خَصْمٌ أَلدُّ خَئُونُ العهد، تحاذِرُه",14,"ر",2,0],["عَلى تُربةٍ أَرِّخ رَسَمنا بِصَفحها","أَيا حامِلاً بُشرى السَلامِ لَكَ البُشرى",15,"ر",2,0],["على تلك الدِّيارِ ومَنْ حَوَتّها","سلامٌ كالسلامةِ يُسْتَطاب",16,"ب",1,0],["على تلكَ القصورِ أرى دخاناً","أخفَ عليكَ منهُ ذا الغبارُ",17,"ر",1,0],["على تفاحةٍ أُكِلت فسوقاً","وفحشاً لعنةُ الولدِ الوريث",18,"ث",1,0],["عُلىً تُقْذِي الْعُيُونَ مِنَ الأَعادِي","وَتُنْبِتُ فِي قُلُوبِهِمُ الْحَزازا",19,"ز",2,0],["عَلى تَرائِبِ كافور تُزَيِّنُها","حِقاقُ عاجٍ عَلَيها عاجَتِ الفِكرُ",20,"ر",1,0],["عَلى تَقبيلِهِ لَهُمُ اِزدِحامٌ","كَما لَهُمُ عَلى الرُكنِ اِزدِحامُ",21,"م",1,0],["عَلى تَرائِبِ كافورٍ تُزَيِّنُهُ","حقاقُ عاجٍ عَلَيها عاجَتِ الفِكَرُ",22,"ر",1,0],["عَلى تَسويدِ وَجهِكَ لَستُ ألحى","وَلَو سَوَّدتُهُ بِخَرا الكلابِ",23,"ب",1,0],["على تقاسِمهمْ مِنْ دون غيرهمُ","يبيتُ مختلفُ الأقوامِ مصطلحا",24,"ح",2,0],["عَلى تقى اللّه قَد أَضحت مؤسّسةً","في منعةٍ وجباياتٍ وتجنيدِ",25,"د",1,0],["على توبة باللّه هل أنت عازم","فكل الذي أسلفت عندي جرائم",26,"م",1,1],["على تالد الأَيام لي طارف الأَسى","وفي كل حين مفجع وشتات",27,"ت",1,0],["على تالد الأيام لي طارف الأَسى","وفي كل يوم لي من الحزن مشهد",28,"د",1,0],["على تالد الأيام لي طارف الحزن","فقدني بما أُبليت من حزن قدني",29,"ن",2,1],["على تَرْباء أرض لم تَلِقْها","مدارجُها الخِباتُ ولم تَلِقْني",30,"ن",2,0],["على تلكَ الدِيارِ لَنا سَلامٌ","نُرَدِدُهُ مع البَرقِ اليماني",31,"ن",2,0],["عَلى تُكُآتٍ مِن وَسائِدَ تَحتَها","سَريرٌ كَأَنقاءِ النَعامَةِ يَرجُفُ",32,"ف",1,0]]}