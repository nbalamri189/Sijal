{"poems":[[6,"طرق الخيال ولا كليلة مدلج","https://www.aldiwan.net/poem384.html",""],[93,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[94,"أقبل الصبح يغني","https://www.aldiwan.net/poem38893.html","مجزوء الرمل"],[87,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[45,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[64,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[47,"مهرج صبوحك سعده لم ينحس","https://www.aldiwan.net/poem64611.html","الكامل"],[46,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[47,"مَهْرِجْ صَبُوحَك سَعْدُه ُلم يُنْحَسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31143",""],[132,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[141,"خبروني أن سلمى","https://www.aldiwan.net/poem67964.html","مجزوء البسيط"],[146,"لو يهتدى وصفى إلى شغفى","https://www.aldiwan.net/poem58374.html","أحذ الكامل"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[246,"العيد أقبل باسم الثغر","https://www.aldiwan.net/poem45767.html","الكامل"],[261,"اسمع المدح الذي لو قيل في","https://www.aldiwan.net/poem48346.html","الرمل"],[275,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[369,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[396,"أيها الوفد إلى البيت الحرام","https://www.aldiwan.net/poem54495.html","عموديه"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[466,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[505,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[567,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[572,"عندي معتقة تودك صافيه","https://www.aldiwan.net/poem69467.html","الكامل"],[578,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[590,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48595","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38896","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62576","الكامل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204064","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109103","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20030","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79978","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48960","الكامل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89656","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203568","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27686","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205792","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100213","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204666","الخفيف"],[3059,"","https://poetry.dctabudhabi.ae/diwan/poem/203797","الكامل"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143687","الهزج"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74077","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45790","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86377","الكامل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67625","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33578","الرمل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104875","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120441","الكامل"],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5409,"صدق الهوى ما كل ود صادق","https://www.poetsgate.com/ViewPoem.aspx?id=155297",""],[5661,"اسمع المدح الذي لو قيل في","https://www.poetsgate.com/ViewPoem.aspx?id=181398",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6322,"احتِرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82626&r=&rc=7",""],[572,"عِنْدِي معتّقَة ٌ كودّكَ صافِيهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9502&r=&rc=359",""]],"verses":[["فَإِذا طَبَختَ بِنارِهِ نَضَّجتَهُ","وَإِذا طَبَختَ بِغَيرِها لَم يَنضَجِ",0,"ج",1,0],["فَإِذا طَوَتنا الأَرضُ عَن أَزهارِها","وَخَلا الدُجى مِنّا وَفيهِ بُدورُ",1,"ر",1,0],["فإذا طالتْ ظِلالُ الكَلإِ","الغضِّ الضَّئيلْ",2,"ل",1,0],["فَإِذا طَلَعتَ عَلى جَلالَةِ رُكنِها","قُل تِلكَ إِحدى مُعجِزاتِ مُحَمَّدِ",3,"د",1,0],["فَإِذا طَوى اللَهُ النَهارَ تَراجَعَت","شَتّى الأَشِعَّةِ فَاِلتَقَت في المَرجِعِ",4,"ع",1,0],["فَإِذا طَلَبتَ فَريسَةً فارَقتَهُ","وَإِذا خَدَرتَ تَخِذتَهُ عِرّيسا",5,"س",2,0],["فإذا طائر ترفِّى إليها","ردّ من قبة إلى التقعيرِ",6,"ر",1,0],["فَإِذا طَرِبتَ إِلى العُيونِ وَغُنجِها","فَأَجِل لِحاظَكَ في عُيونِ النَرجِسِ",7,"س",1,0],["فَإِذا طَلَبتُ لَدَيهِمُ ما لَم أَنَل","أَدرَكتُ مِن جَدواهُ ما لا أَطلُبُ",8,"ب",1,0],["فَإِذا طَفا كَيدٌ رَسا","وَإِذا رَسا كَيدٌ طَفا",9,"ف",2,0],["فإذا طلبتَ الحقَّ منه وجدتَهُ","سهل الرحابِ مُوَطّأ الأكنافِ",10,"ف",1,0],["فأذا طَرِبتَ العُيُونِ وغُنجِها","فأَجَل لِحاظَكَ في عُيونِ النَّرجسِ",11,"س",1,0],["فإذا طلبتُ من الزمانِ مآرباً","خلْى مآرب نفسه وسَعَى لِي",12,"ل",2,0],["فَإِذا طَيرٌ مَليحٌ","فَوقَ غُضنٍ يَتَفَلّى",13,"ل",2,0],["فإذا طمحتُ لوَى الهوى عُنُقى","وإذا جمحتُ فسائقى كلَفى",14,"ف",2,0],["فَإِذا طولِبوا بِما يوجِبُ الحَم","دَ أَحالوا عَلى العِظامِ البَوالي",15,"ل",2,0],["فإذا طلعتَ وضاءَ بدرُك في","أُفقِ الأَريكةِ وافِرَ البِشر",16,"ر",1,0],["فإذا طار به المشي مضى","وهو كالريح يشق الطرقا",17,"ق",2,0],["فإذا طلبنا الحقَّ قال عميدُهم","إني أرى أحلامَكُمُ أضغاثا",18,"ث",2,0],["فإذا طُلِبْتَ منَ امرئٍ لم يَصْطَنعْ","وإذا اصطَنَعْتَ معَ امرئٍ لم يَشْكُر",19,"ر",1,0],["فإذا طاب اللقا والملتقى","فاذكر والصب البعيد المستهام",20,"م",1,0],["فإِذا طابَ نظمُ شعرِي أَو طا","لَ فمن راحَتَيْكَ طابَ وطالا",21,"ل",2,0],["فإذا طرَقْت فليلُ ضيفٍ شاكرٍ","وإذا استجرت فيومُ أمنٍ شاملِ",22,"ل",1,0],["فإذا طَغى الأعداء كَفَّ جيوشَهُ","مع بأسهمْ وغَزا بجيشِ تَوكلِ",23,"ل",1,0],["فإذا طُويتُ بمَرْقَدي فلِفَرْقَدي","يبدو الظُّهورُ البَحْتُ في الأَكوَانِ",24,"ن",1,0],["فإذا طلَبناها فقد رُمْنا السُّهَى","وإذا ذَكرناها فَتقْنا العَنْبَرا",25,"ر",2,0],["فَإِذَا طَرِبْتَ إِلَى السَّمَاعِ تَرَنَّمَتْ","بِيْضَاءُ ذَاهِبَةٌ بِعَقْلِكَ دَاهِيَهْ",26,"ي",2,0],["فَإِذا طَرِبتَ إِلى النَسيبِ فَنَفتَةٌ","بَعدَ الصَلاةِ عَلى ذَوي المَعصومِ",27,"م",1,0],["فإِذا طلبت صفاءه","فابشُر بأنواع العذاب",28,"ب",1,0],["فإذا طربت حفظت منزلتي","من كل غيٍّ خالي الذهن",29,"ن",1,0],["فَإِذا طَلعت فَكلُّ قَلبٍ في الهَوى","وَجْداً يُصفّق بِالغَرامِ وَيَرقصُ",30,"ص",1,0],["فإذا طويتُ شبعتُ من تذكارهَا","وإذا ظمئتُ شربت من عبراتي",31,"ت",2,0],["فإذا طردت الطرف فيهم ثانياً","حالت عهود وجوههم في الحال",32,"ل",1,0],["فإذا طويت فلا ترى وإذا نشرت","نشرت رايات بظلك تخفق",33,"ق",1,0],["فَإِذا طَعَنتَ طَعَنتَ في لَبدٍ","وَإِذا سَلَلتَ يَكادُ يَنسَدُّ",34,"د",1,0],["فإذا طعنتَ بها العدى وصلتْ","منهم لحيث السمرُ لا تصلُ",35,"ل",1,0],["فإذا طغى ويلُ التقهقرِ","جاء في مجراهُ سَدّا",36,"د",2,0],["فَإِذا طَمعت كَسيت ثَوب مَذَلَّة","فَلَقَد كَسي ثَوبَ المَذَلَّةِ اِشعَبُ",37,"ب",1,0],["فإذا طلقها قيل لها","استعدي لا تزيدي في العدد",38,"د",1,0],["فإذا طلبت البرء من دار الضنى","أعطتك حظ الوعد في الأعشار",39,"ر",1,0],["فإذا طلبتُ بحارَ معرفتي بها","جاءتْ بحارٌ ما لهن سواحلُ",40,"ل",1,0],["فَإِذا طرفها رَنى فَهُوَ ريم","وَإِذ عَطفها اِنثَنى فقَناة",41,"ه",1,0],["فَإِذا طَرَحتَ لَهُ الحَصاةَ رَأَيتَهُ","يَنزو لِوَقعَتِها طُمورَ الأَخيَلِ",42,"ل",1,0],["فإذا طال طال بي اليأس واليأ","س سبيل تُفضي إلى النسيان",43,"ن",1,0],["فإذا طلعت فكل شيءٍ طلع","وغذا غربت فكل شيءٍ مغرب",44,"ب",1,0],["فاذا طرت طار في الجو خلفي","واذا ما حططت حط أمامي",45,"م",2,0],["فإذا طبخْتَ بنارِهِ أنْضَجْتَها","وإذا طَبَخْتَ بغيرها لم تَنْضَجِ",46,"ج",1,0],["فإذا طلبت من العلوم أجلَّها","فأجلُّها منها مقيمُ الألْسُنِ",47,"ن",1,0],["فَإِذا طلبت فَلَيسَ أَطلب صاحِباً","أَرعى العهود له وَلا يَرعاني",48,"ن",2,0],["فَإِذا طَغى بِهُم الوَغى وَتَجَرَدَت","بيض الظِبا احمرّ الحَديد الأَزرَق",49,"ق",1,0],["فإذا طلعت طلعت شمس ضحى","وإذا انثنيت فبانة الجرعا",50,"ع",2,0],["فإذا طاولته أر","بى على بُغْض الخُمار",51,"ر",1,0],["فإذا طالت بهِ أنفاسُهُ","صَدَعت ما لم يَزَل مُلتئِما",52,"م",2,0],["فإذا طرفها رنا فهو ريم","وإذا عطفها إنثنى فقنات",53,"ت",1,0],["فاذا طلبت ودادها","صدت باقصى جهدها",54,"ه",2,0],["فإذا طابت الهيولا وكانت","عملا في شريعة مقبولا",55,"ل",2,0],["فإذا طلبت من الحياة حقيقةً","فتتبع الآثار فهي حقائق",56,"ق",1,0],["فإذا طاب به المشي مضى","وهو كالريح يشق الطرقا",57,"ق",2,0],["فإذا طفحتَ بكيلها عن حده","فالموت ثَم وليس ثَم سواه",58,"ا",2,0],["فإذا طغى موج الكرامة مدّه","ُ بحر ُ العقيدة بالشهادة يزبدُ",59,"د",1,0],["فَإذِا طَرقنَا البَابَ أضمَرَ قتلنَا","وإذا رَحلنَا هَزَّنا التودِيعُ",60,"ع",1,0],["فإذا طربْتَ إلى السّماعِ ترنّمَتْ","بيضاءُ ذاهبة ٌ تُسمّى دَاهيَهْ",61,"ي",2,0]]}