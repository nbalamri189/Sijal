{"poems":[[95,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[68,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[42,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54862","المنسرح"],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[136,"إلى ابن أما إمام البدو والحضر","https://www.aldiwan.net/poem54830.html","الطويل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[543,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44785","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96650","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108495","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106840","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136965",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132157","البسيط"],[4360,"","https://poetry.dctabudhabi.ae/diwan/poem/122179","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104533","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141634","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139787",""],[4853,"سنا جبينك مهما لاح في الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=181772",""],[5277,"من أوراقِ عاشقٍ كرخيّ","https://www.poetsgate.com/ViewPoem.aspx?id=186552",""],[5388,"أفديك لولا الرّدى","https://www.poetsgate.com/ViewPoem.aspx?id=206907",""],[5431,"نسيم روحك مثل الفجر تعشقها","https://www.poetsgate.com/ViewPoem.aspx?id=189650",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5956,"محبة جُمِّدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=182037",""],[5956,"إشعاع الإنسانية في الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=204680",""],[5974,"الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=215159",""]],"verses":[["أن يزدهوا اليوم فأجدر بهم","أن أباهم لأبو العصر",0,"ر",1,0],["إِن يَزهُ خَصرُكَ بِالوِشاحِ فَقَد زَهَت","بِفَنى وِشاحٍ سائِرُ الأَطرافِ",1,"ف",1,0],["إِنّي زَعيمٌ لَئِن لَم تَترُكي عِذَلي","أَن يَسأَلَ الحَيَّ عَنّي أَهلَ آفاقِ",2,"ق",1,0],["إِنّي زائِرٌ ظَبياً","بِخَوعي فَمُحَيِّيهِ",3,"ي",2,1],["إِنَّ يَزيداً فَاِدنُ مِن بابِهِ","في الضيقِ إِن كانَ أَوِ المَرحَبِ",4,"ب",1,0],["إِنْ يَزْدَرُوا قَدْركَ الرَّفِيعَ فَلاَ","تَنْظُرْهُمْ رَفْعَهُ وَلاَ تدْرِي",5,"ر",2,0],["إن يُزهَ بغير العُرْب من","أجداده الأتراك، والأروام",6,"م",1,0],["إنِّي زَعِيمٌ لَئِنْ لَمْ تَتْركُوا عَذَلِي","أَنْ يَسْأَلَ الْحَيُّ عَنِّي أَهْلَ آفَاقِ",7,"ق",1,0],["إن يَزدَجِر عَن هَوَاهُ ذُو هُوىً فَأَنَا","عن حُبِّكُم طُولَ غَيرُ مُزدجِرِ",8,"ر",1,0],["أن يزور الخيالُ منكم مناما","لستُ أدري ولا المفنّد يدري",9,"ي",1,0],["إِني زرعت وإِن سعدت فحاصد","وإِذا تجحَّفُ فهو حظ الناصح",10,"ح",1,0],["إن يَزُرني يَزورُ صَبّاً قَنوعاً","رَشفةٌ مِن رُضَا بِهِ تَكفِيني",11,"ن",2,0],["إِن يَزهُ شَرقِيٌّ بِغَيرِ العُربِ مِن","أَجدادِهِ الأَتراكِ وَالأَروامِ",12,"م",1,0],["إنّي زرعتُ وما من زارعٍ زرع ال","مَعروف في كنههِ إلّا وَقَد حصدا",13,"د",2,0],["اني زرعت الوفا في ارض غالية","فما جنيت سوى ظلمي ومنفاي",14,"ا",2,0],["إني زهدتُ فلا رجاءَ","فهل أَعودُ ولا دوام",15,"م",1,0],["إن يزعموا اننا لسنا نماثلهم","في كل مكرمة يا كذب ما زعموا",16,"م",3,0],["إِن يَزمع الهمّ الكفا","ح فكلّ همّ أَزمعا",17,"ع",2,0],["أن يزرع النبل يحصد من لذائذه","أو يزرع اللؤم يحصد بعد الندما",18,"م",2,0],["إني زعيمٌ لئن لم يُجتَنَب سَخَطي","أن تزهَقَ الساقُ يوماً نَعلَها زَلَلا",19,"ل",2,1],["ان يزهو روفائيل في رياضه","فهي شذا أخلاقه الزواهر",20,"ر",1,0],["إن يزرني يوما فتى ذو صلاح","أفسدته زوجي فراح خليعا",21,"ع",2,1],["إنِّي زففتُ اليكما من فكرتي","عذراء تلعب في القلوب بدَلها",22,"ل",3,0],["إن يزرع الناس في أخلافهم كرماً","فالبذر من جودك الطنان بالديم",23,"م",1,0],["أنَّى زليخةُ أنْ تجئَ بمكرِها","واليوسفيُّ لمكرِها متعوِّدُ",24,"د",1,0],["إِنِّي زَهدتُ الحرفَ يُشْبهَهُ العَمَى","لولاهُ ما انتفضتْ يَدي لولاهُ",25,"ا",2,0],["إني زرعت محباتي بواحتكم","أرجو الخلود وماكالصدق ان زرعا",26,"ع",2,0],["إني زرعتك في روحي بَنفسجةً","أبيتُ منها إذا طارحتها جَذِلا",27,"ل",2,0],["إني زرعت وحلوتي بنَدورةً","أشياءَ شتّى للتمازج مَهَّدَتْ",28,"ت",1,0],["أن يزيل الشرَّ من عُمْقِ السَّجايا","أن يكون الشهمَ في سَتْرِ العرايا",29,"ا",3,0],["إني زرعت الياسمين بداخلي","وسقيته خمرا عَلاهُ جلال",30,"ل",1,0]]}