{"poems":[[93,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54862","المنسرح"],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[132,"إلى ابن أما إمام البدو والحضر","https://www.aldiwan.net/poem54830.html","الطويل"],[416,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[441,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[538,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"]],"verses":[["أن يزدهوا اليوم فأجدر بهم","أن أباهم لأبو العصر",0,"ر",1,0],["إِن يَزهُ خَصرُكَ بِالوِشاحِ فَقَد زَهَت","بِفَنى وِشاحٍ سائِرُ الأَطرافِ",1,"ف",1,0],["إِنّي زَعيمٌ لَئِن لَم تَترُكي عِذَلي","أَن يَسأَلَ الحَيَّ عَنّي أَهلَ آفاقِ",2,"ق",1,0],["إِنّي زائِرٌ ظَبياً","بِخَوعي فَمُحَيِّيهِ",3,"ي",2,1],["إِنَّ يَزيداً فَاِدنُ مِن بابِهِ","في الضيقِ إِن كانَ أَوِ المَرحَبِ",4,"ب",1,0],["إِنْ يَزْدَرُوا قَدْركَ الرَّفِيعَ فَلاَ","تَنْظُرْهُمْ رَفْعَهُ وَلاَ تدْرِي",5,"ر",2,0],["إن يُزهَ بغير العُرْب من","أجداده الأتراك، والأروام",6,"م",1,0],["إنِّي زَعِيمٌ لَئِنْ لَمْ تَتْركُوا عَذَلِي","أَنْ يَسْأَلَ الْحَيُّ عَنِّي أَهْلَ آفَاقِ",7,"ق",1,0],["إن يَزدَجِر عَن هَوَاهُ ذُو هُوىً فَأَنَا","عن حُبِّكُم طُولَ غَيرُ مُزدجِرِ",8,"ر",1,0],["أن يزور الخيالُ منكم مناما","لستُ أدري ولا المفنّد يدري",9,"ي",1,0],["إِني زرعت وإِن سعدت فحاصد","وإِذا تجحَّفُ فهو حظ الناصح",10,"ح",1,0],["إن يَزُرني يَزورُ صَبّاً قَنوعاً","رَشفةٌ مِن رُضَا بِهِ تَكفِيني",11,"ي",1,0]]}