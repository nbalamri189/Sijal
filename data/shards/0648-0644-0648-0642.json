ضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5582,"لِمَنْ مَرْبَعٌ للبُقْعِ فِيهِ نَعِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[5628,"الى قريتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=178470",""],[5688,"ظاهرة الغش في المدارس","https://www.poetsgate.com/ViewPoem.aspx?id=200922",""],[5776,"الشّاعِرُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206108",""],[5939,"حبيبتي تغارُ من نفسها!","https://www.poetsgate.com/ViewPoem.aspx?id=178581",""],[5956,"خشيت من الخروج إلى المروج","https://www.poetsgate.com/ViewPoem.aspx?id=201543",""],[5970,"وزاعمة أني سلوت غرامها","https://www.poetsgate.com/ViewPoem.aspx?id=130648",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[285,"عَتادُكَ أنْ تشنَّ بها مغارا","https://www.poetsgate.com/ViewPoem.aspx?id=15447",""],[6068,"فلسفة الغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178196",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""],[5355,"أما آن الرجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87208&r=&rc=33",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[6320,"نِدَاءُ اسْتِغَاثَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84333&r=&rc=30",""]],"verses":[["وَلَو قَنِعَت بِالحُظوظِ لَم أُبَل","إِبطاءَها بِالرِزقِ أَم إِسراعَها",0,"ع",3,0],["وَلَو قالَ لي الغادونَ ما أَنتَ مُشتَهٍ","غَداةَ جَزَعنا الرَملَ قُلتُ أَعودُ",1,"د",1,0],["وَلَو قَدَرَتْ أَترابُها لَخَبَأْنَنِي","عَلى شَغَفٍ بَينَ الطُّلَى وَالمَخانِقِ",2,"ق",1,0],["وَلَو قَضى بِالَّذي نادَى الأَنامُ بِهِ","لَم يُلْفَ بَعديَ شَملُ المَجدِ مُجتَمِعا",3,"ع",2,0],["ولو قابَلَتْهُ بالذّوائِبِ راجَعَتْ","بِها اللّيلَ مُلْتَفَّ الغَدائِرِ أسْحَما",4,"م",2,0],["وَلَوْ قَهَرْتَ الْمَوْتَ أَمَّنْتَني","مِنْهُ وَأَدْخًلْتَنِي الْجِنَّهْ",5,"ن",2,0],["وَلَو قَبَضَت كَفّي عَلى كَفِّ دِرهَمٍ","لَأُبتُ إِلى رَحلي وَفي الكَفِّ عَقرَبُ",6,"ب",1,0],["وَلَو قُمتُ مُذ قاَم اِبنُ لَيلى لَقَد هَوَت","رِكابي بِأَفواهِ السَماوَةَ وَالرِجلِ",7,"ل",1,0],["وَلَو قَد بايَعوكَ وَلِيَّ عَهدٍ","لَقامَ القِسطُ وَاِعتَدَلَ البِناءُ",8,"ا",2,0],["وَلَو قَد رَجَوتُ اللَهَ لاشَيءَ غَيرَهُ","رَجَعتُ إِلى أَعلى وَأَمَّلتُ أَوسَعا",9,"ع",2,0],["ولو قصدته الوحشُ والطيرُ لم تُرَعْ","بمفترسٍ يوماً ولا متصيِّد",10,"د",1,0],["وَلَو قَدَرتُ عَلى الإِتيانِ جِئتُكُم","سَعياً عَلى الوَجهِ أَو مَشياً عَلى الرَأسِ",11,"س",1,0],["ولو قد ألحَّ عليه الهجا","ءُ جَرْجرَ من عضِّ كلُّوبِهِ",12,"ب",2,0],["وَلَوْ قَاسَ باسْتِيجَابِكُمْ ما مُنِحْتُمُ","لأطْفَأ ناراً في حَشَاه تَوَقَّدُ",13,"د",1,0],["ولو قَعَدْتُ بلا عذْرٍ لَمَهَّدَ لي","جَميلُ رَأيك عُذْري أيَّ تَمْهِيدِ",14,"د",1,0],["ولو قيل شبِّهْ ريق ظبي تُحبهُ","لشبّهه المخبول بالسمن والتمر",15,"ر",1,0],["ولو قدرتَ من اللين اللطيف بهم","أحللتَهم بين أجفان وأشفار",16,"ر",1,0],["ولو قبلوا نصحي لهم بقبوله","لواروْك حياً فالثرى لك أسترُ",17,"ر",1,0],["ولو قبِلتْ مني الليالي فداءهُ","لفَاديتُها من تالدي بخياره",18,"ر",2,0],["ولو قَبِلَ الموتُ الفداء بذلتُهُ","ولكنما يَعْتامُ رائدُهُ العِيَمْ",19,"م",1,0],["وَلَو قَصَدَت بِالذَمِّ شانيكَ لَاِغتَدى","وَحاشاكَ مِنهُ قَلبُهُ يَتَنَظَّفُ",20,"ف",1,0],["وَلَو قَدَرَت زارَت عَلى حال يَقظَةٍ","وَلَكِن حِجابُ البَينِ ما بَينَنا مُدّا",21,"د",2,0],["ولَوْ قِيلَ لي قُمْ فادْعُ أَحْسَنَ مَنْ تَرى","لَصِحْتُ بَأعلى الصَّوْتِ يا بَكْرُ يا بَكْرُ",22,"ر",1,0],["وَلَو قَلَمٌ أُلقيتُ في شَقِّ رَأسِهِ","مِنَ السُقمِ ما غَيَّرتُ مِن خَطِّ كاتِبِ",23,"ب",1,0],["وَلَو قُلنا فِداً لَكَ مَن يُساوي","دَعَونا بِالبَقاءِ لِمَن قَلاكا",24,"ك",2,0],["وَلَو قالَ هاتوا دِرهَماً لَم أَجُد بِهِ","عَلى سائِلٍ أَعيا عَلى الناسِ دِرهَمُ",25,"م",1,0],["وَلَو قَتَلَ الهَجرُ المُحِبّينَ كُلَّهُم","مَضى بَلَدٌ باقٍ أَجَدَّت لَهُ صَرما",26,"م",2,0],["ولو قُصِدَ الطفلُ من طَيّئٍ","لشاركَ قاصِدُهُ في اللبَن",27,"ن",1,0],["ولو قايَسُوا بالمُزْنِ عيني لصادفوا","دُموعيَ أندى العارضين سَحابَا",28,"ب",2,0],["وَلَو قَطَعوا يُمنى يَدَيَّ غَفَرتُها","لَهُم وَالَّذي يُحصي السَرائِرَ كاتِبُه",29,"ب",2,0],["وَلَو قَبِلوا مِنّي عَطِيَّةَ سُقتُهُ","إِلى آلِ زيقٍ مِن وَصيفٍ مُقارِبِ",30,"ب",1,0],["وَلَو قَدَّمَ الخَيلَ اِبنُ موسى أَمامَهُ","لَماتَ وَلَكِنَّ اِبنَ موسى تَأَخَّرا",31,"ر",2,0],["وَلَو قَبِلوا العَقلَ مِن ثَأرِهِم","أَنَخنا لَهُم شَدقَمِيّاً ذَلولا",32,"ل",2,0],["وَلَو قَبِلَت سَيدانُ مِنّي حَليفَتي","شَفَيتُ بِها ما يَدَّعي آلُ ضَمضَمِ",33,"م",1,0],["وَلَو قَدَّمَ الحَزمَ في نَفسِهِ","لَعَلَّمَهُ الصَّبرَ عِندَ البَلا",34,"ل",2,0],["وَلَو قَد تَوَسَّدتَ الثَرى وَافتَرَشتَهُ","لَقَد صِرتَ لايَلوي عَلَيكَ حَميمُ",35,"م",1,0],["وَلَو قَنِعتُ أَتاني الرِزقُ في مَهلٍ","إِنَّ القُنوعَ الغِنى لا كُثرَةُ المالِ",36,"ل",1,0],["وَلَو قَطَرَت مِنها عَلى الصَخرِ قَطرَةٌ","رَأَيتَ صَفاةَ الصَخرِ قَد أَنبَتَت عُشبا",37,"ب",2,0],["وَلو قَصَدتُ بِهِ تَجديدَ وَصفِكُمُ","لَكانَ ذَلِكَ مَنسوباً إِلى الحُمُقِ",38,"ق",1,0],["وَلَو قَصَّرَت أَموالُهُ عَن سَماحِهِ","لَقاسَمَ مَن يَرجوهُ شَطرَ حَياتِهِ",39,"ت",2,0],["ولو قلتُ في حقهِ بعضَها","لزلزلتِ الأرضُ زلزالها",40,"ل",3,0],["ولو قلتُ ما سرُّ ذا أنشدوا","جماجمُنَا تحتَ أقدامِنا",41,"ن",2,0],["وَلَو قَعَدَت وَلَم تَكَلَف بِوُدٍّ","سِوى ما قَد كَلِفتُ بِهِ كَفاها",42,"ا",3,0],["وَلو قيلَ رَبٌّ سِوى رَبِّنا","لَقالَ العِبادُ جَميعاً كَذِب",43,"ب",1,0],["ولو قد حططتَ الغيثَ في عُقرِ دارهمْ","كشَفتَ ظلامَ المَحْلِ عنهم فأمرعوا",44,"ع",3,0],["ولو قيل لي مَنْ في البرِيّةِ كلِّها","سِواكَ على علمي بها قلتُ لا أدري",45,"ر",2,0],["وَلَو قَدِرنا عَلى الإِتيانِ جِئتُكُمُ","سَعياً عَلى الوَجهِ أَو مَشياً عَلى الراسِ",46,"س",1,0],["وَلَو قَد يَئِسَت نَفسي","مِنَ البَذلِ لَأَودَيتُ",47,"ت",1,0],["وَلَو قَبِلَت أَمرَ المَليكِ جُنوبُنا","لَما قَبِلَتها في الظَلامِ المَراقِدِ",48,"د",1,0],["وَلَو قَرَّرتَ فِكرَكَ في المَنايا","إِذاً لَبَكَيتَ بِالعَينِ القَريرَه",49,"ر",2,0],["وَلَو قَدَرتُ لَعاقَبتُ الَّذينَ طَغوا","حَتّى يَعودَ حَليفُ الغَيِّ مَرموسا",50,"س",2,0],["وَلَو قَدِروا عَلى الطَيرِ الغَوادي","لَما نَهَضَت إِلى وِكرٍ بِريشِ",51,"ش",1,0],["وَلَو قَدِرَ العَبيدُ عَلى إِباقٍ","لَبادَرَ عَبدُ سوءٍ أَوبَقَتهُ",52,"ت",2,0],["وَلَو قَدَروا عَلى إيوانِ كِسرى","لَساموهُ الرَدى وَتَعَقَّبوهُ",53,"ب",3,0],["ولو قِيل اسْألوا شَرَفاً لقُلْنا","يَعيشُ لنا الأميرُ ولا نُزادُ",54,"د",1,0],["ولو قَرّبُوا من حانِها مُقْعَداً مشَى","وتنطِقُ من ذِكْرَى مذاقتِها البُكْم",55,"م",1,0],["وَلَوْ قَضى الدَّهْرُ لَهُ مَا اشْتَهَى","لَسَامَ مَا تَشْكُوهُ أَنْ يَشْكِيكَ",56,"ك",1,0],["وَلَوْ قَذَفْتُمْ بِسَلْعٍ عَنْ ظهورِكُمُ","وللحَيَاةِ وَدَفْعِ المَوْتِ تَأْجِيلُ",57,"ل",1,0],["ولو قتلت اللحن في المزمار","ولو وأدت الحب في الأفكار",58,"ر",1,0],["وَلَو قَضى اللَهُ لي بِسُؤلٍ","فيهِ شَفى دائي العُضالا",59,"ل",2,1],["ولو قد توسّدتَ الثرى وافترشتَهُ","صُرِعت ولا يلوى عليك حميم",60,"م",1,0],["ولو قعد العافون عنك لَزارهم","نوالُك من تِلقاءِ خَيرِ مُزيرِ",61,"ر",1,0],["وَلَو قَلَّدوا الموصى إِلَيهِ زِمامَها","لَزُمَّت بِمَأمونٍ مِنَ العَثَراتِ",62,"ت",1,0],["ولو قصدت هفوة بحبهم","أو كنت من عاهدهم فما وفى",63,"ا",1,0],["ولو قلدوا الاسلام ضاق عليهم","سبيل الى ما تشتهي النفس واسع",64,"ع",1,0],["وَلَو قُلنا فِدًى لَكَ مَن يُساوي","دَعَونا بِالبَقاءِ لِمَن قَلاكا",65,"ك",2,0],["ولو قد أمدته السيوف بحدها","لغص بموار من الدم كارع",66,"ع",1,0],["ولو قدرت صانته عيني كرامة","كما صين في أغلى خزائنه الدرّ",67,"ر",1,0],["ولوْ قرَّبوا منْ حلها مقعداً مشى","وتنطقُ منْ ذكري مذاقتها البكمُ",68,"م",1,0],["ولو قدْ بايعوكَ وليَّ عهدٍ","لَقامَ القِسْطُ وَاعتَدَالَ البِنَاءُ",69,"ا",2,0],["ولو قد رِشتهُ طارَ انتهاضا","فما هو بالمهيضِ ولا الكسيرِ",70,"ر",1,0],["ولو قسَّمَ الأكوانُ ما فيَّ من هوى","لأُفْعِمَتِ الأكوانُ في العلو والأرض",71,"ض",1,0],["ولو قَصَّ مني الدهر ريشَ قوادِمي","فلا أتشكَّى للعدوِّ فيبسَما",72,"م",2,0],["ولو قاسيتَ يوماً ما يقاسى","غراما ما أطقْتَ لذاك دَفْعَا",73,"ع",2,0],["ولو قضيتُ زماني في مدائحهِ","وكان سيريَ سيرَ الشمسِ لم أصِلِ",74,"ل",1,0],["ولو قضى في هواه صبُّه شغفاً","ومرّ يوماً وحيّاه لأحياه",75,"ا",2,0],["وَلَو قَصَدَت ذي البيضُ بَيضَةَ مُلكِهِ","لَأَسلَمَ إِعظاماً لَها وَلَسَلَّما",76,"م",2,0],["ولو قلت دمعي قد ملكت فكاذبٌ","بدعواي بل ذا غرّةٌ وضلال",77,"ل",1,0],["وَلَو قَد قَضَينا حَقَّ حُبٍّ مُؤَكَّدٍ","لَسِرنا مَسيرَ العازِمِ المُتَجَرِّدِ",78,"د",1,0],["وَلَو قَد وَجَدنا نَحوَهُ بَعدُ مَذهَبا","حَثَثنا إِلَيهِ العيسَ شَرقاً وَمَغرِباً",79,"ب",2,0],["وَلَوْ قَضى حَزَناً مُسْتَهْتَرٌ دَنِفٌ","لَكُنْتُ أَوَّلَ مَحْزُونٍ قَضى حَزَنا",80,"ن",2,0],["وَلَوْ قَدَرْتُ عَلَى جَفْني لأَجْعَلَهُ","طِرْسِي وَأبْرِي عِظامِي مَوْضِعَ القَلَمِ",81,"م",1,0],["وَلَوْ قَبِلَ المَحْبوبُ في الحُبِّ فِدْيَةً","وَهَبْتُ له رُوحي وقاسَمْتُهُ عُمْري",82,"ر",2,0],["ولو قطعوني في الهوى كنت راضيا","أذا قطعوا إربا مددت لهم إربا",83,"ب",2,0],["ولو قيل قوم أى ملك تريده","بظفر ابن إسمعيل ما خلته يسوى",84,"و",2,0],["وَلَو قَبِلَت نُصحي وَأَصغَت لِدَعوَتي","وَأَنجَحُ فاشي دَعوَةٍ مُستَجابُها",85,"ب",3,0],["وَلَو قَبِلُوا مِن ذَلِكَ الذَنبِ تَوبَةً","لآلَيتُ أَلفاً أَنَّني لا أُعاوِدُ",86,"د",1,0],["وَلو قالَ لِلأَفلاكِ في سَيرِها قِفي","لَباتَت رُكوداً لا تَدورُ وَلا تَجري",87,"ر",2,0],["وَلَو قُلتِ طَأ في النَّارِ أَعلَمُ أَنَّهُ","هُدًى مِنكِ أَو مُدنٍ لَنَا مِن وِصَالِكِ",88,"ك",1,0],["ولو قلت حقا قلت شيب فقصّرت","لحاظي وحكم الشيب أوّله الغضّ",89,"ض",1,0],["ولو قيل للمجد اقترع خير صاحب","للاذ به مستعصم وهو راغب",90,"ب",1,0],["وَلَو قَصَدت كلُّ الخلائقِ فَهمهُ","لَما فَهِموا مِن عُشرِ أَسرارهِ العُشرا",91,"ر",2,0],["ولو قيل للأُفْقِ احتكِمْ قال دونَكم","هلالي وشمسي واتركا لي محمدا",92,"د",2,0],["ولو قضى الحب أن نستاف في غدنا","أزهار خديك لحظا في البساتين",93,"ن",1,0],["ولو قد علمِتُنّ الّذي أنا عالمٌ","لما ناح منكْم هاتِفٌ لا ولا غَنىَّ",94,"ن",2,0],["ولو قد رأى إسرافَ جُودِك حاتمٌ","للاَمَكَ في الإعطاء كعبٌ وحاتم",95,"م",1,0],["وَلَو قورِعَت حُمرُ المَنايا وَسودُها","بِمُرهَفَةٍ بيضٍ وَخَطِّيَةٍ سُمرِ",96,"ر",1,0],["ولو قوبلوا وجهاً لوجه لبرهنوا","على أنهم نعم الكماة وأعربوا",97,"ب",3,0],["وَلَو قابلت لفظة لن تَراني","بما كذب الفؤاد فهمت معنى",98,"ن",2,0],["وَلَوْ قَنَأَ النارنجُ أبْصَرْتَ أغصُناً","بِها مَاؤُها تُبدِي جِماراً لَها وَقْدُ",99,"د",1,0],["وَلَوْ قَدْ ذَكَرْتُكَ فِي مَحْفِلٍ","غَنِيتُ بِذِكْرِكَ عَنْ طِيبِهِ",100,"ب",2,0],["وَلَوْ قُلْتُ ابْنُ مَحْمُودٍ كَفَتْنِي","صِفَاتُ عُلاَكَ فَضْلاً وَاشْتِهار",101,"ر",1,0],["ولو قفلت إليكم","فتحتُ بابَ الهناءِ",102,"ا",2,0],["وَلَو قَذفت في البحرِ لجّة عزمهِ","لَما وَسِعته الأرضُ مُصطفقاً رحبا",103,"ب",2,0],["ولو قايسوا بالحسن بيني وبينها","لكانت لديهم لا تسام بحبة",104,"ه",1,0],["وَلَو قَدَّمَ الحَزمَ في أَمرِهِ","لَعَلَّمَهُ الصَبرَ عِندَ البَلا",105,"ل",2,0],["وَلَو قَبلَ مَبكاها بَكَيتُ صَبابَةً","بِسُعدى شَفَيتُ النَفسَ قَبلَ التَنَدُّمِ",106,"م",1,0],["ولو قضَيْتِ دُيونَ النّاس قاطبةً","ولو أبَيْتِ سوى مَطْلي لَيّاني",107,"ن",2,0],["وَلَو قَضَت ما عَلَيها لَاِكتَسى وَرَقاً","مِن فَيضِ كَفَّيهِ مِنها كُلُّ جُلمودِ",108,"د",1,0],["ولو قد أعارَتْ حين شاقَتْ إليكمُ","جناحاً به تُطْوَى على النّأْيِ بِيدها",109,"د",3,0],["ولو قَلَستْ سُمْرُه ما احتسَتْ","بَلغْنَ سُيولُ الدماء الزُّبى",110,"ا",1,0],["وَلَو قَنِعَ الشُجعانُ بِالمَوتِ بَينَهُم","لأَعوَزَ في يَومِ الوَغى مَن يُقاتِلُ",111,"ل",1,0],["وَلَو قلتُ اِنَّ اللَهَ لَم يَخلِق الوَرى","لِغَيرِكَ لم احرج وَلم أَتَأَثَّمِ",112,"م",1,0],["وَلَو قيلَ لِلغَيثِ اسقِها ما اِهتَدى لَها","وَلو ظَلَّ مِلءُ الأَرضِ وَهو جزورُ",113,"ر",1,0],["وَلَو قَدرتُ زرتُهُ","وَلَو عَلى جَمرِ الغَضا",114,"ض",2,0],["ولو قبل الحمام لنا فداءً","فديناه بمن نهوى جميعاً",115,"ع",2,0],["ولو قدِرت رُكوبَ الرِّيحِ زرتُكُمُ","لأنَّ بُعدي مِنكُمْ قَد جَنى حَيْني",116,"ي",1,0],["وَلَو قدرت وَثوب اللَيلِ مُنخَرِقٌ","بِالصُبحِ رَقَّعته مِنهُنَّ بِالشَعَرِ",117,"ر",1,0],["ولو قلتُ إني عاشقٌ فطَنوا به","لعلمهُم أن ليس يُعشَقُ إلاّ هو",118,"و",1,0],["ولَوْ قِيلَ زِدْها فِي هِباتِكَ واسْتَزِدْ","بِهَا الحَمْدَ من هَذَا الوَرى لاسْتَقَلَّها",119,"ل",3,0],["ولو قَبِلَ الموْتُ منها الفِدَاءَ","لضاقَ الأنامُ لَهَا عن فداءِ",120,"ا",2,0],["ولو قبل الردى فيك الأفادي","فدتك جميع سام ثم حام",121,"م",1,0],["ولو قيلَ لي ثلثاه من فعلِ صاحب","تجافيتُه من بعد ما كنت أهواهُ",122,"ا",2,0],["ولو قيل في أخرَى سمعتَ بصيحةٍ","لساهرِ ليلٍ بالهموم تغشَّاهُ",122,"ا",2,0],["ولو قد لاكه غيري لأعيا","عليه فمات وهو به شريقُ",123,"ق",1,0],["ولو قد وفت لعميد الكفا","ةِ أيّامُه لم أنل منك غدرا",124,"ر",2,0],["ولو قيل غيرُ الشمس سيقت هديّةً","إلى البدر لم أفرح له بِنكاحِ",125,"ح",1,0],["وَلَو قُبِلَ الفِدا لَكانَ يُفدى","وَإِن جَلَّ المُصابُ عَنِ التَفادي",126,"د",2,1],["ولوْ قامَ أبو بكرٍ أو ابنُ","الوليدِ لثبّتوا لكمُ اليقينا",127,"ن",2,0],["ولو قيل لي اختر نيله أو صلاحه","لآثرت أن يعصى هواي ويسلما",128,"م",2,0],["ولو قبِلَ الموتُ الفِداءَ فديتُه","ولكنّهُ لن يُعطيَ الحُرَّ بالعَبْدِ",129,"د",1,0],["ولو قدحت شهاب العزم معتزماً","حرب الكواكب خافت أنفس الشهب",130,"ب",1,0],["ولو قدرت لأسلاني عقوقهم","وكم عقوق سلت أم به وأب",131,"ب",1,0],["ولو قدرت أفعاله حق قدرها","مدحناه بالقرآن في النظم والنثر",132,"ر",1,0],["ولَوْ قُلْنَا لَهُ هَلْ ذاكَ رَبٌّ","تُنادِيه لَظَلَّ بِذَا يَمودُ",133,"د",1,0],["وَلَو قِنٌّ مِنَ العُبدا","نِ يَرعى دَهرَهُ الثِلَلا",134,"ل",2,0],["وَلَو قد غِبتَ عَنِّي نِصفَ يَوم","لَطِرتُ إلَيكَ أسألُ مَادَاهَاكا",135,"ك",2,0],["ولو قلتُ حُبِّي مَوطنِي فَوقَ حُبِّها","لَكُنتُ أخا جَهرٍ يُخَالِفُه سِرِّي",136,"ر",2,0],["ولَو قلتُ مدحا فيهِمُ ماتَ حِينهُ","وإن قلتُ هجواً ردَّدَ الشرقُ والغربُ",137,"ب",1,0],["وَلَو قَبل النّاسُ عُذر اِمرئٍ","لأوسعتُهم عَن سِواي اِعتِذارا",138,"ر",2,0],["ولو قتْلي أراد قتلتُ نَفْسي","له عمداً ليبلُغَ من مرادِهْ",139,"د",2,0],["ولو قَبِلَتْ فيك الكواكُب فِدْيةً","بَذَلْتُ لها رُوحي وأَهْلي ومَالِيا",140,"ي",2,0],["وَلَو قُمتَ تأمُرُهُم بالصَّلاةِ","فَقامُوا إليها لَقامُوا كُسالى",141,"ل",2,0],["وَلَو قَسَّمتَ رُوحَكَ كانَ مِنها","لِرُوحي يا أبا المَعرُوفِ قِسمُ",142,"م",1,0],["ولو قصد الوحش إدراكها","لما مسه من طوىً ما حجب",143,"ب",1,0],["ولو قَدرتُ على دُرٍّ أتيتُ به","إلى حِماهُ وما يَمّمتُ بالحَصَبِ",144,"ب",1,0],["ولو قضيتَ الفرضَ منْ دعوتي","مغالِطاً ألفيتني صائمَا",145,"م",2,0],["ولو قدرت على الإحسان قدرة من","يسيء بت وثأري غير مطلوب",146,"ب",1,0],["ولو قلته جهلا لنعماك كافراً","عصتني القوافي والقريض المهذب",147,"ب",1,0],["ولو قتلَ الهوى أهلَ التصابي","لما تابوا، ولو رُدّوا لعادوا",14