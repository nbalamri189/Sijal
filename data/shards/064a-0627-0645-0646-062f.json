{"poems":[[57,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[79,"يا من دعاني إلى رفد يجود به","https://www.aldiwan.net/poem36734.html","البسيط"],[95,"بالعلم يدرك أقصى المجد من أمم","https://www.aldiwan.net/poem11392.html","البسيط"],[53,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[99,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[50,"أوعدتني بالقتل من غير ما","https://www.aldiwan.net/poem64470.html","البسيط"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39408","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[197,"يا من دهاه شعره","https://www.aldiwan.net/poem13017.html","مجزوء الرجز"],[197,"يا من دعانا دعوة لم تتم","https://www.aldiwan.net/poem13134.html","الكامل"],[453,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[567,"من كان كاتب نون هذا الحاجب","https://www.aldiwan.net/poem52841.html","الكامل"],[567,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[591,"يا من دعوت له غداة دعوته","https://www.aldiwan.net/poem17708.html","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35383","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61079","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126150","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84478","البسيط"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206189",""],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87899","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87900","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131527",""],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177833","البسيط"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216397",""],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101709","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45684","البسيط"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82859","المجتث"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65271","الكامل"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99287","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36758","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32946","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91007","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90844","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117241","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33448","الكامل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99121","البسيط"],[5183,"حروف الصحيفة","https://www.poetsgate.com/ViewPoem.aspx?id=185691",""],[5232,"جنون","https://www.poetsgate.com/ViewPoem.aspx?id=213461",""],[5461,"حنا العرب","https://www.poetsgate.com/ViewPoem.aspx?id=22531",""],[5497,"لا تستبيحوا بالجفاء مدامعي","https://www.poetsgate.com/ViewPoem.aspx?id=206088",""],[5561,"صوت وصدى","https://www.poetsgate.com/ViewPoem.aspx?id=205623",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[6106,"سيدنا الإمام الحسين ، سيد الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=6313",""],[6106,"السُكْرُ المباح","https://www.poetsgate.com/ViewPoem.aspx?id=208851",""]],"verses":[["يا مَن دَعاني ثُمَّ أَدبَرَ ظالِماً","إِرجِع وَأَنتَ مُواصِلٌ مَحمودُ",0,"د",1,0],["يَا مَنْ دَعَانِي إِلَى رَفْدٍ يَجُودُ بِهِ الْ","غَنِيُّ باللهِ مُؤْتَمّاً بِمَذْهَبِهِ",1,"ه",1,1],["يَا مَنْ دَعَاهُمْ فَلَبَّتْهُ عَوَارِفُهُمْ","لِجُودِكُمْ مِنْهُ شُكْرُ الرَّوْضِ لِلدِّيَمِ",2,"م",1,0],["يا من دعاني إلى الغنى أثرٌ","لطابع الجود فيه منطبع",3,"ع",1,0],["يا مَن دعا للحق في أوطانه","ومضى ليهتف في ديار الجارِ",4,"ر",1,0],["يا مَن دَعا قَلبي إِلى حُبِّهِ","فَقُلتُ لَبَّيكَ وَسَعدَيكا",5,"ك",2,0],["يا مَن دَمي دونَهُ مَسفوكُ","وكُلُّ حرٍّ لهُ مَملوكُ",6,"ك",1,1],["يَا مَنْ دَعَانِي أَنَا مَنْ","إِنْ يُدْعَ لِلخَيْرِ ابْتَدَرْ",7,"ر",1,0],["يا مَن دَهاهُ شَعرُه","وَكانَ غَضّاً أَمرَدا",8,"د",2,1],["يا مَن دَعانا دَعوةً لَم تُتم","أَبدَعتَ جِدّاً في الفَعالِ الألأمِ",9,"م",1,1],["يا من دعانى قبل أوجد حسنه","فقضى جمال وجوده بوجودى",10,"د",2,0],["يامن دعا فأجاب قلبي طائعاً","لبَّيكَ من داعٍ عزيزِ الجانبِ",11,"ب",1,0],["يا مَنْ دَعاني إلى صَوْغِ الثناءِ لها","من صِيتها قد دَعَتْني قَبْلَكَ الرُسُلُ",12,"ل",1,0],["يَا مَنْ دَعَوْتَ لَهُ غَداةَ دَعَوْتُهُ","فَأَبى يُجيبُ ولِلصُّدودِ عَلائِمُ",13,"م",1,1],["يا مَن دَنا فَتَدَلّى لِلعُلا صُعُداً","كَقابِ قَوسَينِ أَو أَدنى لِإِدراكِ",14,"ك",1,0],["يا مَن دَرى مِن أَجل من حله","أَمكنس صَدري أَم مطلع",15,"ع",1,0],["يامن دعاني أن أزور جنابه","لأنال تشريفاً به وفخارا",16,"ر",2,0],["يا من دعاني في المحبة أوحداً","لم لا ينال رضاك هذا الأوحد",17,"د",1,0],["يا مَن دنى فَتَدَلّى رِفعَةً وَعُلا","كَقابَ قَوسَينِ أَو أَدنى إِلى النِّعَمِ",18,"م",1,0],["يا من دعَى هَمّ العسر دوم مطرود","عن من تعلَّق به على وقت لَكْساد",19,"د",1,0],["يا من درى ما لِطَيفِ العِشقِ من قِصَرِ","قَصَّرَت إِن لم تجسمهُ بِأَولادِ",20,"د",1,1],["يا من درى ما لسامي العشق من نُعُمٍ","باللَه لا تجعلنَّ الوصلَ مغناهُ",21,"ه",1,1],["يا من دهش حسن وجهك من دهش","ومن جميع القلوب به لاويه",22,"ي",2,1],["يا من دعاني إلى أبوابه كرماً","إني إلى باب بيت الله أدعوكا",23,"ك",2,1],["يا من دِيار عْماني","ومكَمَّل التاديب",24,"ب",1,0],["يا مَن دعتهُ لِعلا همَّتُه","واتّخذَ الجِدَّ إماماً ودعا",25,"ا",1,0],["يا من دعائي له ومدحي","نفلى مدى مدّني وفرضي",26,"ض",2,1],["يا مَن دَعاني أَطالَ اللَهُ عُمرَك لي","وَلا عدمتك من داع وَمُحتَفل",27,"ل",1,1],["يا مَن دَعَتهُ الغَواني","عَما وَقَد كان شَبّا",28,"ب",2,1],["يا من دواعي الحبّ في ألحاظه","مهما رنت تحت الجبين السّاطع",29,"ع",1,1],["يا من دعا أرواحنا فتبادرت","سبقاً وحن إلى النفيس نفيس",30,"س",1,0],["يا مَن دَقيقُ صِفات مِدحَتِه","جَلَّت عَنِ الأَفكارِ وَالحَدسِ",31,"س",1,0],["يا مَن دَعاني وَفَرَّ مِنّي","أَخلَفتَ وَاللَهِ حُسنَ ظَنّي",32,"ن",2,1],["يا من دمشق الشام لا برحت به","يعلو محاسنها سنا وسناء",33,"ا",2,0],["يا من دمشق توالهت شوقا له","حتى يئوب لها بحسن مآب",34,"ب",1,0],["يا من دعوناه وليس يجيب","أقبل فنادى المكرمات رحيب",35,"ب",1,1],["يا من دعته مقلتا","هُ بما رأى في مقلتيكا",36,"ك",2,0],["يا من دعته ملوك الأرض راعيها","حاشا لما أنت راعيه من الخلل",37,"ل",1,0],["يا من دعاه الحسن وهو ضَنين","ورماه وهو الخاسر المغبون",38,"ن",1,0],["يا من دقيت ِ مساميري","مصلوب ٌ والله أكبر ْ",39,"ر",1,0],["يا من دعا للحرب ما درك خطوبه","لا تحسب أن الحرب تهديد وخطاب",40,"ب",1,0],["يامن دموعي تستجير بوصلكمْ","\" عندي لأجل فراقكم آلامُ \"",41,"م",1,0],["يا مَن دُنياهُ لهُ أملٌ","فالدُّنيا لا تُنجي أحدا",42,"د",2,0],["يا من دعوت فلبتني شمائلهُ","لك البشارة هذا خير مقصودِ",43,"د",1,0],["يامن دعاه ايوب من جورمافيه","ونجا الخليل وذل عباد الاصنام",44,"م",1,0],["يا من دفعتَ لِيَ السلامَ بعيشتي","لكن بموتك قد سلبتَ سلامي",45,"م",2,0],["يا من درجت بخير روض لاعقاً","خير الرحيق لأطيب الأزهار",46,"ر",1,0],["يا من دخلتِ القلبَ بعد تلهفٍ","أسكرتِهِ أنت الهوى والراحُ",47,"ح",1,0]]}