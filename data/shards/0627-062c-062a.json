{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[73,"كم أوري عن لوعتي وأواري","https://www.aldiwan.net/poem4006.html","الخفيف"],[75,"لست بالجاحد آلاء العلل","https://www.aldiwan.net/poem11941.html","الرمل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[91,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[87,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[87,"بيت على أرض الهدى وسمائه","https://www.aldiwan.net/poem62935.html","الكامل"],[51,"خفض هداك الله من بالكا","https://www.aldiwan.net/poem62212.html","السريع"],[99,"نزل الظلام فلات حين مقامي","https://www.aldiwan.net/poem24397.html","الكامل"],[33,"أصبح القلب بالقتول حزينا","https://www.aldiwan.net/poem41279.html","الخفيف"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[42,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[48,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[48,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21032","الرمل"],[108,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[102,"أخر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=50333",""],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[98,"من وحي الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=17474",""],[113,"كلما رحت ذاكرا ذكريا","https://www.aldiwan.net/poem16458.html","الخفيف"],[214,"عاطنيها ذوب تبر","https://www.aldiwan.net/poem13366.html","مجزوء الرمل"],[227,"رق لما هواك عقلي فما يقدر","https://www.aldiwan.net/poem55469.html","الخفيف"],[234,"رب ليل أنرته بثغور","https://www.aldiwan.net/poem51022.html","الخفيف"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[415,"من عذيري من شادن لم أطق عن","https://www.aldiwan.net/poem32582.html","الخفيف"],[422,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[438,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[463,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[469,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[484,"بعد أحبابي كساني الأرقا","https://www.aldiwan.net/poem36922.html","الرمل"],[505,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[543,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[543,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[563,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[580,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82799","الكامل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145564","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104591","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37882","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77508","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77553","الرجز"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51575","السريع"],[1144,"","https://poetry.dctabudhabi.ae/diwan/poem/199146","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46543","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84502","المجتث"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125482","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125448","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110332","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77211","الخفيف"],[2400,"","https://poetry.dctabudhabi.ae/diwan/poem/205106","السريع"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113866","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62953","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91083","الكامل"],[3725,"","https://poetry.dctabudhabi.ae/diwan/poem/216330","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54480","الرمل"],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[4968,"تغريدة الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=208101",""],[5087,"أجتاز بي اليوم في الطريق فتى","https://www.poetsgate.com/ViewPoem.aspx?id=96361",""],[5198,"سلة اوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=134769",""],[5277,"طيرُ الثماد","https://www.poetsgate.com/ViewPoem.aspx?id=191142",""],[5387,"وحدة","https://www.poetsgate.com/ViewPoem.aspx?id=53940",""],[5431,"القصيدة المقعده!...","https://www.poetsgate.com/ViewPoem.aspx?id=200042",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5943,"ريحانُ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=36081",""],[6006,"مكناس","https://www.poetsgate.com/ViewPoem.aspx?id=214149",""],[6019,"فهويتي (هجرية)","https://www.poetsgate.com/ViewPoem.aspx?id=53062",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6056,"وردتين ٍ على تل","https://www.poetsgate.com/ViewPoem.aspx?id=130333",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["أَجتابُ عارِضَها وَقَد","رَحَلَ المَنونُ بِهِ هَمولا",0,"ل",2,0],["أَجتَلي بِنتَ كُرمَةٍ خَزنتها ال","رومُ دَهراً ما بَينَ طينٍ وَقارِ",1,"ر",1,0],["أَجتَلي مِن أَجلِها بَدرَ العُلا","مُشرِقاً في مَنزِلي حينَ كَمَل",2,"ل",1,0],["أجتني الأقحوانَ والوردَ والنر","جسَ عفواً من الغُصونِ الغِضاض",3,"ض",1,0],["اجتمعوا البا يريدون ان","يحاربوا الالباب بالدس",4,"س",1,0],["اِجتَمِعوا فَالاِجتِماعُ قُوَّه","ثُمَّ احفِروا عَلى الطَريقِ هُوَّه",5,"ه",1,0],["اِجتَزتَهُ فَحواكَ في أَطرافِهِ","وَلَوِ اِنتَظَرتَ حَواكَ في أَحشائِهِ",6,"ا",3,0],["إِجتَمَعَ الناسُ عَلى ذَمِّها","وَلا أَرى مِنهُم لَها تارِكا",7,"ك",2,0],["أجتاز أيَّ كتائبٍ مرصوصةٍ","وأشقُّ نحو حماكِ أيَّ زحامِ",8,"م",1,0],["إِجتَنَبنا في الأَرضِ إِن كُنتَ تَخشى","إِن لَقَيناكَ مَرَّةً أَن تَخونا",9,"ن",2,0],["أَجتابُ ظُلمَتَهُ بِضَخ","مِ مَجامِعِ الدَأَياتِ بازِل",10,"ل",1,0],["أَجتازُ قَفراً بَعِيدَ القَعرِ لَيسِ مَعي","إِلّا الإِلهُ وَإِلّا السَيفُ وَالفَرَسُ",11,"س",1,0],["أَجتابُ شَهراً أَوَّلاً فَأُبيدُهُ","وَيَجيءُ ثانٍ بَعدَهُ فَأُهِلُّهُ",12,"ل",2,0],["إِجتَنِبِ الناسَ وَعِش واحِداً","لا تَظلِمِ القَومَ وَلا تُظلَمِ",13,"م",1,1],["أجتاحُها وأضجُّ من لذعاتها","فكأنها بدمي نقيعُ سمامِ",14,"م",1,0],["اجَتنِب أَخلاقَ مَن لَم تَرضَهُ","لا تَعِبهُ ثُمَّ تَقفُو في الأَثَر",15,"ر",1,1],["اجْتَحْتُم المتهجمي","ن على الحِمَى أيَّ اجتياح",16,"ح",1,0],["أجتر الطين ، وأعزفه","وأغنّي ، للريح الشكلى",17,"ل",2,0],["أجتدي رأياً سديداً، لا تقل:","مثلما مِتُّ أنا أودى سدادي",18,"د",2,0],["أجتاحها ة أضجّ من لذعاتها","فكأنّها بدمي نقيع سمام",19,"م",1,0],["إِجتَني ما اِستَطَعت مِن وَرد خَديهِ","بِأَيدي اللحاظ وَرداً جَنيّا",20,"ي",2,0],["اجتلي شمسا وطوراً","اجتلي طلعة بدر",21,"ر",1,0],["أجتلي يقظةً خيالك هل تعلم","طيفاً ألمّ باليقظان",22,"ن",1,0],["أجتني البرقَ من لآلي ثغور الصْ","صفْرِ والورد في صحون البدور",23,"ر",1,0],["أَجتلي نفر المنى آنساتٍ","سافراتٍ عن أوجه غرّانِ",24,"ن",1,0],["أَجتَلِي منهُ في ضُحى اليومِ شمساً","وأرى منه في دُجى الليلِ بَدْرَا",25,"ر",2,0],["أجْتلي الكاساتِ تَهوي أنجما","ولها فينا طلوعٌ ومغيبْ",26,"ب",1,0],["اجتَلِ اللهوَ حُمرةً في بياضِ","بين آتٍ من السرور وماضِ",27,"ض",1,1],["أجتدِي المزن وما ذا أرَبي","أن تجودَ المزنُ أطلالاً رِماما",28,"م",2,0],["أجتني ريحانةَ الحب بها","غَضّةً ما بين غصنٍ وهلالِ",29,"ل",1,0],["أجتدي النومَ وهل في ال","نوم إلاّ أن أراكِ",30,"ك",1,0],["اِجتماعاً في اللّه يُعطي به الل","ه أماناً شمليكما من فراقِ",31,"ق",1,0],["أجتني حيث اجتنَى الظبيُ العِرا","قيّ أو أعطى المنى حيثُ عَطا",32,"ط",2,0],["أجتنيها رَيْحانةَ العيشِ خضرا","ءَ وتُمسى فيها المُنَى لِيَ خُضْرا",33,"ر",2,0],["أَجتلى البدرَ فلا أنساكِ وجهاً","وأرى الغصنَ فلا أسلاكِ قدّا",34,"د",2,0],["أجتلي منهُ قضيبً في كثيب","وأرى صدغيه صبحاً في ظلامِ",35,"م",1,0],["اجتمعنا فارتبطنا بالهوى","وافترقنا والهوى ما افترقا",36,"ق",2,0],["أجتلى نور وجهه فأذب","وأرى الغير طرفةً فأتوبُ",37,"ب",1,1],["إجتناءُ العلمِ في هذا الزمانِ","واجبُ العينِ وعينُ الواجبِ",38,"ب",1,0],["اجتمعنا على لقاءِ وُعودٍ","وافترقَنا على وعُودِ لقَاء",39,"ا",2,0],["اجتمعوا يا إخوتي واحشدوا","فإن لي مسألةً تُجهدُ",40,"د",1,1],["اجتمع الضِّدان فيه","مِقةً واصْطَحَبَا",41,"ب",2,0],["أَجتالا في وادي المُنون مطهرا","لِلنَفس فيهِ أَيما تَطهير",42,"ر",1,0],["اجتمعنا بعد التفرق دهراً","فظللنا نقطع العمر سكرا",43,"ر",2,1],["أجتلي الشّمسَ من يدي بدرِ تمٍّ","رصّعوها بأنجُمِ الجوزاءِ",44,"ا",2,0],["أَجتَني الأُنسَ مِن وُرودِ سُرورٍ","بِيَدِ الصَّفْوِ بِالهنا والسُّعودِ",45,"د",1,0],["اِجتَمَع الفيرانُ في جَمعيّه","وَاتَحَدوا مَع بَعضِهم سَويَّه",46,"ه",1,1],["اِجتَمع الشَمسُ مَعاً وَالريحُ","وَشاهَدا شَخصاً مَشى يَسيحُ",47,"ح",1,1],["اجتمعت فيك ومِن بعدِ ذا","أنَّك رازيٌّ كثيرُ الغَلَطْ",48,"ط",1,0],["اجتنب مطعوم عدس وبصل","في عشاء فهو للعقل خبل",49,"ل",1,1],["اجتنب الأَناما","عدّ الوَرى سواما",50,"م",2,0],["اجتث من خير أصلٍ","خير الأنام محمد",51,"د",1,1],["أجتنى أشهى الزهور","من بساتين الأدَب",52,"ب",1,0],["أجتاح صَعبَ هَواكِ مهما راعني","كأسُ المنيةِ فيه عذبُ المنهل",53,"ل",1,0],["اجتذب عرنةً فعرنة تلوى","عرفاتٍ جبالها والرمالا",54,"ل",2,0],["اجتلي سيداً له فخره بالع","لم والحزم والعلى والجدود",55,"د",1,0],["أَجتَليها وَوَجهُها خَجَلاً","يَرتَدي وَردَهُ وَيَلتَحِفُ",56,"ف",1,0],["اجتمع الناس وصاحوا: الحريق","بباب عثمان وسوق الرقيق",57,"ق",1,1],["أجتث من راح يسعى","بالعذل بين الأخلا",58,"ل",2,0],["أجتث في الحب عني","من لم أجد منه رفقا",58,"ق",2,0],["أَجتنى شهدَها بظنى ولكنْ","نَ فمى من مذاقِها في خَيالِ",59,"ل",1,0],["أَجتابها وَأَجوز كُل تنوفةٍ","شَوقي نَديمي وَالخَيال مسامري",60,"ر",2,0],["أجْتلي نَرْجِساً وأَلْثِمُ رَيْحا","ناً وأَجني وَرْداً وأَرشُف خمرا",61,"ر",2,0],["أجتدي الغيث وقد عز المغيث","لجوى يا سلم بالقلب يعيث",62,"ث",1,0],["إجتلَى من مَشرِق المجدِ السّنا","وامتطى من بازلِ المُلك السَّناما",63,"م",2,0],["أجتهد في كل علم نافع","يهب الإنسان من خير النقل",64,"ل",1,0],["أجتهد في كل فن واتحد","مع ذوي العرفان بلفت الأمل",64,"ل",1,0],["اجتاح حنجرةً وأسكت داخلي","صوتًا بكى من قسوة الحرمان",65,"ن",1,0],["أجتاز بي اليوم في الطريق فتى","يختال في مورق من البان",66,"ن",1,1],["اجتاز هقوات البشر حد الاقناع","ثم اتعثر بين نفسي وبيني",67,"ن",2,0],["أجتليها مثلَ بدرٍ طالعٍ","قد أضاء العينَ من بعدِ السوادْ",68,"د",1,0],["أجترُّ في ليل الشجونِ هواجسي","ماذا بكل هواجسي أنا صانعُ",69,"ع",1,0],["أجتاح حلما تائها","أجتاح نزف الأورده!!",70,"د",2,0],["إجت ابمهب الهبايب تدرك اصمودي","ولاتحتمي في مصالح حالة ارصادي",71,"د",2,0],["أجتلي روعة اللقاء ختاماً","فوداعا فملتقى فسلاما",72,"م",2,0],["اجتمع حب امرئ وسلوه","يقلب ولا صبر دعاني من الدعوى",73,"و",2,0],["أجتازُ عبرَ أريجه حزنَ الدنى","أطوي نحيبي في هدى آياتي",74,"ي",1,0],["أجتاحها متلهفا تجتاحني","وعلى امتداد سمائنا يطفو سؤال",75,"ل",1,0],["أجتازُ بالوسواسِ بحرَ تغرُّبٍ","وأعودُ يا أُمَّي بلا وسواسي",76,"س",2,0],["اجتمع بمستشاره لتحديد المصير","وعقب اجتماعه مو فاضي لاشكالك",77,"ك",1,0],["إجتاح قلبي ،، معلن ٍ احتلالا","ومشاعري ما قاومت يومه احتل",78,"ل",1,0],["أجتازُ خلجاناً به... ومرافئاً","\"حيث البحار\"... يمدّهنّ بحار\"",79,"ر",1,0],["أَجْتَرِحُ الْخَطْوَ لَا إِلَى جِهَةِ","وَأَمْنَحُ الْحَدْسَ رُوحَ بُوصَلَةِ",80,"ه",1,1]]}