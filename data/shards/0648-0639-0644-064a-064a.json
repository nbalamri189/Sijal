{"poems":[[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[108,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[139,"أقبل البشر والسرور تجلى","https://www.aldiwan.net/poem49086.html","الخفيف"],[396,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101029","الكامل"],[2645,"","https://poetry.dctabudhabi.ae/diwan/poem/130236","الخفيف"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46733","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135479","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93256","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4755,"عُقبَى الحائِرِين","https://www.poetsgate.com/ViewPoem.aspx?id=183683",""],[4767,"سهم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=180942",""],[1901,"يا سعدُ قد عادَ الكنانةَ عِيدُها","https://www.poetsgate.com/ViewPoem.aspx?id=160407",""],[4876,"مسٌ بشعرك","https://www.poetsgate.com/ViewPoem.aspx?id=207498",""],[4961,"الكهف الذي لم تدخله الظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=33328",""],[5150,"شهادة الدم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204039",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5351,"عشر همسات وهمسة","https://www.poetsgate.com/ViewPoem.aspx?id=202051",""],[5542,"من أعماق القلب","https://www.poetsgate.com/ViewPoem.aspx?id=10052",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""]],"verses":[["وعلى يديه جرى صلاح شؤونكُمْ","ورجوعُ إرثِ أبيكُمُ المنزوع",0,"ع",1,0],["وعلى يَدَيْ مسمورةٍ مخمورةٍ","ألتذُّ كالمقرورِ حرَّ ضرامِ",1,"م",1,0],["وعلى يديك إذا شكا شاكي الحمى","برءُ السقيم به من الأوجاع",2,"ع",1,0],["وعلى يَدَيْكم سوفَ يَنْتَصِر الحِمَى","وتَعُودُ أمجادٌ لمِصْرَ خَوالِي",3,"ل",2,0],["وعلى يمين الدرب كوخ تلتقي","في صدره النكبات بالنكبات",4,"ت",1,0],["وعليٌّ يدعوكمو لاشتراك","في التهاني بالمولدِ الزينبيِّ",5,"ي",1,0],["وعلى ىل وأصحاب له","ما ترنم حادا ورعد هناك",6,"ك",1,0],["وَعَلى يَديه يَعضُّ مِن أَسَفٍ عَلى","غَدر اللَيالي بَعد حُسن وَفاء",7,"ا",2,0],["وعلى يمينك بالمنيرة حلةٌ","للعمل فيها جمة وحفيل",8,"ل",1,0],["وعُلًى يَفْرَعُ النجومَ ذُرَاها","وندًى في المُعَصِّبينَ وفِعْلِ",9,"ل",1,0],["وَعَلى يَمينِكَ سَوسَناتٌ أَطلَعَت","زَهرَ الرَبيعِ فَهُنَّ حُسناً تُشرِقُ",10,"ق",1,0],["وعلي يقينٍ أنني يا سيدي","أن لا أرى همّاً وأنت جلائي",11,"ا",2,0],["وعليّ يظهر فضله لا عدله","ويكمل الفن الجميل فنونِ",12,"ن",1,0],["وعُلىً يجوز بها المدى حَسَدُ العِدى","إِن العُلى مَنصورةٌ بالحاسدِ",13,"د",1,0],["وعلى يمين الحي من وادي الغضا","ورقاء تهتف في ذرى الأفنان",14,"ن",1,0],["وعلى يومِ النهروانِ عَدَتْ على","الأخيارِ منهُ سطوة وفَقَارُ",15,"ر",1,0],["وعَلَى يَدَيَّ قَصِيدَةٌ أَركَانُهَا","(طه), و(نُونٌ), و(الضُّحَى), و(النُّورُ)",16,"ر",1,0],["وعلىينا إلهيَ اخلُف بخيرٍ","وجزاءٍ بحق خير العباد",17,"د",1,0],["وعلى يديكَ نجتْ من استعبادها","وغداً تُفكُّ على يديكِ قيودُها",18,"د",3,0],["وعلى يديها حين تصحو أمةٌ","وجه المَدى والعالمينَ سرابُ",19,"ب",1,0],["وعلى يديكِ حجارةٌ لمعتْ ومِنْ","معراج ِ روحكِ ذلكَ اللَّمعانُ",20,"ن",1,0],["وعليُّ يتلو مريماً","ويقولُ يا عمارُ صبرا",21,"ر",2,0],["وعلى (يس) في أفلاكها","لمع من (زمر) و(الحجرات )",22,"ت",1,0],["وعلى يمناي يمن وعلى","كفي اليسر يسار وثبات",22,"ت",1,0],["وعلى يديك ِ أخط ألف َ قصيدةٍ","تلتفُ حولك ِ أدهرا ً وعواصما",23,"م",2,0],["وعلى يديه تشاع كل رذيلة","وعلى يديه تشوه الأفكار",24,"ر",1,0],["وعلى يديه جرت لديه مواهب","لهم بها مترادف النعمات",25,"ت",1,0],["وعلى يديه جرت لهم آلاؤه","في عالم الأرواح والجثمان",26,"ن",1,0],["وَعَلَى يَدَيْكِ تَبَسَّمَتْ","فِي رِقَّةٍ كُلُّ الْمُنَى",27,"ن",2,0],["وعليُّ ينهضُ والرسولُ يردّهُ","عند البلاء تُمحّص الأقران",28,"ن",1,0]]}