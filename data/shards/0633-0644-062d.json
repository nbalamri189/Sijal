{"poems":[[86,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[51,"يا أبا المستهل حالفت جوعا","https://www.aldiwan.net/poem65043.html","الخفيف"],[51,"يا أبا المستهل ماذا تقول","https://www.aldiwan.net/poem65846.html","الخفيف"],[87,"سل حمام الأيك عني","https://www.aldiwan.net/poem8211.html","مجزوء الرمل"],[48,"يا قمر الليل إذا أظلما","https://www.aldiwan.net/poem65261.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[51,"يا أبا المستهلِّ حالفتَ جوعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29328",""],[113,"للّه اشكو ما اصاب فؤادي","https://www.aldiwan.net/poem41135.html","عموديه"],[227,"مهفهف القد ينثني لينا","https://www.aldiwan.net/poem50744.html","المنسرح"],[252,"قلب معذب","https://www.aldiwan.net/poem36216.html","مجزوء الرمل"],[254,"سلحة بعد قرقره","https://www.aldiwan.net/poem48557.html","مجزوء الخفيف"],[362,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"]],"verses":[["سَل حِشمَتاً عَنهُ فَهَ","ذا حِشمَتٌ في الجَمعِ حاضِر",0,"ر",1,0],["سلحةٌ في قفاك تنْشقُّ عنه","ثم تبتذُّ عارضيكَ جميعا",1,"ع",2,0],["سلحةٌ في قفاك تنشقُّ عنه","ثم تَبتَدُّ عارضيْك تسِيلُ",2,"ل",1,0],["سَلْ حَمَامَ الأَيْكِ عَنِّي","إِنَّهُ أَدْرَى بِحُزْنِي",3,"ن",2,1],["سَل حَسَناً تَسأَل بِهِ ماجِداً","يَرى الَّذي تَسأَلُهُ مَغنَما",4,"م",2,0],["سَل حَمام الأَيكِ هَل أَبكى الحِمى","وَبَروق الغَورِ هَل أَبكى البَرق",5,"ق",1,0],["سلحة ٌ في قفاك تنْشقُّ عنه","ثم تبتدُّ عارضيكَ جميعا",6,"ع",2,0],["سل حب عن مرضبي لاجلك واكفني","بحياة عينك رقة العواد",7,"د",1,0],["سَلَّ حُساما مِن لحظَه فبه","يقتُلنا تارةً ويُحيينا",8,"ن",2,0],["سَلْ حبيبي كم طبيبٍ","حاذقٍ بالجهل باء",9,"ا",2,0],["سلحةٌ بعد قرقره","من سلاح المزوره",10,"ر",2,1],["سَلْ حَيَّهمْ عنّي وعن نفَري","كم صُبِّحوا منّا وكم طُرِقوا",11,"ق",3,0],["سُلَّ حُسامَ المَشرفّي ثمَّ سَلْ","وأبْدأ بتَقديمِ الخُطا قبلَ الخُطَب",12,"ب",1,0]]}