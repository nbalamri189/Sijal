{"poems":[[88,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[53,"يا أبا المستهل حالفت جوعا","https://www.aldiwan.net/poem65043.html","الخفيف"],[53,"يا أبا المستهل ماذا تقول","https://www.aldiwan.net/poem65846.html","الخفيف"],[89,"سل حمام الأيك عني","https://www.aldiwan.net/poem8211.html","مجزوء الرمل"],[50,"يا قمر الليل إذا أظلما","https://www.aldiwan.net/poem65261.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[102,"ثرثرات محموم","https://www.poetsgate.com/ViewPoem.aspx?id=50376",""],[53,"يا أبا المستهلِّ حالفتَ جوعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29328",""],[119,"للّه اشكو ما اصاب فؤادي","https://www.aldiwan.net/poem41135.html","عموديه"],[234,"مهفهف القد ينثني لينا","https://www.aldiwan.net/poem50744.html","المنسرح"],[259,"قلب معذب","https://www.aldiwan.net/poem36216.html","مجزوء الرمل"],[261,"سلحة بعد قرقره","https://www.aldiwan.net/poem48557.html","مجزوء الخفيف"],[369,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138281",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109060","الرمل"],[514,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53173","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53049","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53064","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77201","الخفيف"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101887","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100294","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132615","الرجز"],[3449,"","https://poetry.dctabudhabi.ae/diwan/poem/205401",""],[4261,"","https://poetry.dctabudhabi.ae/diwan/poem/124289","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136555",""],[5007,"سهم الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=142374",""],[5038,"بنت الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=189983",""],[5150,"نشيد المقاومة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202934",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""]],"verses":[["سَل حِشمَتاً عَنهُ فَهَ","ذا حِشمَتٌ في الجَمعِ حاضِر",0,"ر",1,0],["سلحةٌ في قفاك تنْشقُّ عنه","ثم تبتذُّ عارضيكَ جميعا",1,"ع",2,0],["سلحةٌ في قفاك تنشقُّ عنه","ثم تَبتَدُّ عارضيْك تسِيلُ",2,"ل",1,0],["سَلْ حَمَامَ الأَيْكِ عَنِّي","إِنَّهُ أَدْرَى بِحُزْنِي",3,"ن",2,1],["سَل حَسَناً تَسأَل بِهِ ماجِداً","يَرى الَّذي تَسأَلُهُ مَغنَما",4,"م",2,0],["سَل حَمام الأَيكِ هَل أَبكى الحِمى","وَبَروق الغَورِ هَل أَبكى البَرق",5,"ق",1,0],["سلّحونا (شيكي) وقالوا عليكم","وعليكم .. حسب القرار القيادي",6,"د",2,0],["سلحة ٌ في قفاك تنْشقُّ عنه","ثم تبتدُّ عارضيكَ جميعا",7,"ع",2,0],["سل حب عن مرضبي لاجلك واكفني","بحياة عينك رقة العواد",8,"د",1,0],["سَلَّ حُساما مِن لحظَه فبه","يقتُلنا تارةً ويُحيينا",9,"ن",2,0],["سَلْ حبيبي كم طبيبٍ","حاذقٍ بالجهل باء",10,"ا",2,0],["سلحةٌ بعد قرقره","من سلاح المزوره",11,"ر",2,1],["سَلْ حَيَّهمْ عنّي وعن نفَري","كم صُبِّحوا منّا وكم طُرِقوا",12,"ق",3,0],["سُلَّ حُسامَ المَشرفّي ثمَّ سَلْ","وأبْدأ بتَقديمِ الخُطا قبلَ الخُطَب",13,"ب",1,0],["سل حمص عنه ففيها شيِّدت يده","معاهد فاخرت في مصر آثارا",14,"ر",2,0],["سلح الضيغم بالبرثن والعزمِ","والعزمُ سلاح الأقويا",15,"ا",1,0],["سلح القشعم بالمخلب ينقضُّ","فيه مثلما انقضَّ القضاء",15,"ا",2,0],["سلح النون بما يحمي به","نفسه من كل كيد واعتداء",15,"ا",2,0],["سَلْ حيَّ تَغْلِبَ عن بَكْرٍ ووَقْعَتِهِمْ","بالحِنْوِ إذْ خَسِرُوا جَهْراً وما رَشَدُوا",16,"د",3,0],["سل حلمه إن لججت راحته","في كرم يعصمك من بحر جبل",17,"ل",1,0],["سل حلمه يوم الندى","يَعْصِمْك من بحر جبل",18,"ل",1,0],["سل حلمه إن فاض في كرم تَلُذْ","بالطَّوْدِ من آذيِّهِ وعبابه",19,"ب",2,0],["سل حلمه إن فاض في كرم تلذ","بالطود من آذِيِّ بحر طافح",20,"ح",1,0],["سَلِّحوا قَومَكُم تَرَوهُم فُحولاً","كُلُّ فَحلٍ شَقاشِقٌ وَهَديرُ",21,"ر",1,0],["سل حبس عيسى ومالاقاه من محن","فيه وقاساه من جور وعدوان",22,"ن",1,0],["سل حامليه على الأعناق هل حملوا","على العواتق جسم الروح والزبرا",23,"ر",2,0],["سل حاجراً ان جئت أرض حاجر","عن الظباء الغيد والجآذر",24,"ر",1,1],["سلحتْ أمُّ رزينِ","ذاتَ يومٍ في طحِين",25,"ن",1,1],["سل حرث أحمد نجل سيد لمين عن","هندي وهندك فهو اصدق مخبر",26,"ر",1,0],["سل حاجراً وأين من حاجر","غداةَ روتّ روضةُ المحاجر",27,"ر",1,1],["سَلْ حُزْمَة الآلام رَغْمَ عَذَابهَا","وَالنَّوْرُ في الوَجْهِ البَشُوش غِطاءُ",28,"ا",2,0],["سَلْ حَرْبَ تَمّوزٍ وَسَلْ مَنْ ذا الَّذي","سَكَنَ الدَّياجِرَ خِشْيَةَ الْأَنْباءِ",29,"ا",2,0],["سلّحْ أخاك من الحجارةِ وارميا","بحجارة السجيلِ أعداء السماءْ",30,"ا",2,0],["سلّحتهُ بسلاحِ غربٍ لا يُرى","وجَعلتهُ أضحوكةً شعبيَّةْ",31,"ي",2,0]]}