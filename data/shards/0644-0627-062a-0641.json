لارض امرا","https://www.aldiwan.net/poem44651.html","المجتث"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[85,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"أمرر على حلب ذات البساتين","https://www.aldiwan.net/poem66809.html","البسيط"],[61,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[58,"قدم لنفسك في الحياة تزودا","https://www.aldiwan.net/poem30966.html","الكامل"],[58,"لا تفسدن سابق إحسان مضى","https://www.aldiwan.net/poem30987.html","الرجز"],[49,"لا تفرحن بما ظفرت به","https://www.aldiwan.net/poem62048.html","الكامل"],[49,"لا تفخرن بلحية","https://www.aldiwan.net/poem64288.html","مجزوء الكامل"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[44,"متخمط في غمرة متهتك","https://www.aldiwan.net/poem30013.html","الكامل"],[69,"لا تفرحوا بحقير","https://www.aldiwan.net/poem28837.html","المجتث"],[105,"أتحاربون الله في جبروته","https://www.aldiwan.net/poem43130.html","الكامل"],[102,"وجه القضية من جهادك مشرق","https://www.aldiwan.net/poem32989.html","الكامل"],[48,"اسمي لوجهك يا منى صفة","https://www.aldiwan.net/poem65236.html","الكامل"],[48,"لا تفرغ النفس من شغل بدنياها","https://www.aldiwan.net/poem66198.html","البسيط"],[48,"نادم العز الكراما","https://www.aldiwan.net/poem66609.html","مجزوء الرمل"],[50,"يا صاح قم فاسقني بالكأس إعرابا","https://www.aldiwan.net/poem64847.html","البسيط"],[46,"لا تفرحن بفأل إن سمعت به","https://www.aldiwan.net/poem22121.html","البسيط"],[46,"لا تفخرن معاشر بقديمها","https://www.aldiwan.net/poem22247.html","الكامل"],[46,"كأنما الأرض شاع فيها","https://www.aldiwan.net/poem22554.html","مجزوء البسيط"],[46,"لا خير للفم في بسط الحياة له","https://www.aldiwan.net/poem22800.html","البسيط"],[46,"الدهر يزبق من حواه كأنهم","https://www.aldiwan.net/poem23024.html","الكامل"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[46,"رب اكفني حسرة الندامة في ال","https://www.aldiwan.net/poem23420.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85844","المجتث"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10325","الكامل"],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[58,"قدم لنفسك في الحياة تزوداً","https://www.poetsgate.com/ViewPoem.aspx?id=10878",""],[54,"أ خزاعَ ! إنْ ذكرَ الفخارُ فأمسكوا","https://www.poetsgate.com/ViewPoem.aspx?id=14249",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[85,"أَمسِ انقضى ، واليومُ مِرْقاة ُ الغدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9642&r=&rc=132",""]],"verses":[["لا تَفتُرُنَّ عَلى الزَمانِ وَإِن","عَثَرَ الزَمانُ بِعِزِّكُم تَعِسا",0,"س",2,0],["لا تُفشِ سِرَّك إِلّا عِندَ ذي ثِقَةٍ","أَو لا فَأَفضَلُ ما اِستَودَعتَ أَسرارا",1,"ر",2,1],["لا تَفرَحوا بفُتوحِكُم","هَذا فَإِنَّ الدَهرَ راقِد",2,"د",1,0],["لا تُفسِدَن ما قَد تَأَكَّدَ بَينَنا","مِن صالِحٍ خَطَراتُ ظَنٍّ فاسِدِ",3,"د",1,0],["لا تَفسَحَن لِلنَفسِ في شَأوِ المُنى","إِنَّ اِغتِرارَكَ بِالمُنى لَضَلالُ",4,"ل",1,0],["لا تَفْتَأُ الخِدْعَة فِي إِثْرِهَا","سَاعِيَةً أَوْ حَوْلَهَا دَائِرَهْ",5,"ر",2,0],["لا تفرحا بالوسامَين اللذين هما","طَوقا إسارة مصر فيكما اقترنا",6,"ن",2,0],["لا تفخروا أن كسرتم غرب شوكتنا","لا فخر للصقر في أن يقتل النغرا",7,"ر",2,0],["لا تَفخَرَنَّ وَفي أَديمِ مُجاشِعٍ","حَلَمٌ فَلَيسَ سُيورُهُ بِسُيورِ",8,"ر",1,0],["لا تَفخَرُنَّ فَإِنَّ اللَهَ أَنزَلَكُم","يا خُزرَ تَغلِبَ دارَ الذُلِّ وَالعارِ",9,"ر",1,0],["لا تَفخَرَنَّ إِذا سَمِعتَ مُجاشِعاً","يَتَخاوَرونَ تَخاوُرَ الأَثوارِ",10,"ر",1,0],["لا تَفخَرَنَّ فَإِنَّ دينَ مُجاشِعٍ","دينُ المَجوسِ تَطوفُ حَولَ دُوارِ",10,"ر",1,0],["لا تَفخَرَنَّ عَلى قَومٍ عَرَفتَ لَهُم","نورَ الهُدى وَعَرينَ العِزِّ ذي الخيسِ",11,"س",1,0],["لا تَفرَحَنَّ فَكُلُّ والٍ يُعزَلُ","وَكَما عُزِلتَ فَعَن قَريبٍ تُقتَلُ",12,"ل",1,1],["لا تَفرَحي يا هِندُ وَاِستَحلِبي","دَمعاً وَأَذري عَبرَةَ الثاكِلِ",13,"ل",1,0],["لا تُفْلِتَنْ منكُم شَبَابيطُهُ","لا أفلتَ الطَّامي ولا الراسبُ",14,"ب",1,0],["لا تُفَرِّطْ في نعيمٍ","بعد تكميل أَداتِهْ",15,"ت",2,0],["لا تُفْسِدَنِّي بالتَّعسُّفِ بعدما","بلَغَ التَّألُّفُ غَايَةَ المُسْتَصْلِحِ",16,"ح",1,0],["لا تفرحنَّ بحسنها وجمالها","فليرحمنك فيهما الحسَّادُ",17,"د",1,0],["لا تَفرَّدْ بأكل مالٍ ولا تَمْ","نُنْ بعُرْفٍ فَشَرُّهُ مَمْنونه",18,"ن",2,0],["لا تُفْرطُ الجدوى أنامل كفّهِ","حتى يهشَّ إلى فَعَالٍ ثاني",19,"ن",2,0],["لا تُفاخِر بِالواخِداتِ وَلا بِال","خَيلِ مِن أَدهَمٍ وَمِن شَهباءِ",20,"ا",2,0],["لا تَفخَروا بِعُقولِكُم وَنِتاجِها","كنَت لَكُم قَبلَ القِتالِ عُقولُ",21,"ل",1,0],["لا تَفَعَنَّ تِلكَ النُفوسِ إِلى الرَدى","إِنَّ النُفوسَ وَإِن صَغُرنَ غَوالي",22,"ل",2,0],["لا تفيد الاكفان بيضا عليهم","ولعل البياض مثل السواد",23,"د",1,0],["لا تفعل الارض الا","كما تشاء السماء",24,"ا",2,0],["لا تفزع الكاعب العذراء من كلمي","فان نصل سهامي غير مسموم",25,"م",1,0],["لا تفزعني بالمنية موعدا","فالحر ليس من المنية يفزع",26,"ع",1,0],["لا تَفتِنَنكِ حَضارَةٌ مَجلوبَةٌ","لَم يُبنَ حائِطُها بِمالِكِ وَاليَدِ",27,"د",1,0],["لا تُفقَدَنَّ فَلَولا ما تُراحُ لَهُ","مِنَ السَماحَةِ كانَ الجودُ قَد فُقِدا",28,"د",2,0],["لاتَفخَرَنَّ فَلَم يُنسَب أَبوكَ إِلى","بَهرامِ جورٍ وَلا بَهرامِ شوبينِ",29,"ن",1,0],["لا تَفْصِمُ الأيامُ طوقي إنني","أصبحتُ بالإحسانِ منكَ مُطوَّقا",30,"ق",2,0],["لا تَفشِ سِرّاً ما اِستَطَعتَ إِلى اِمرئٍ","يَفشي إِلَيكَ سَرائراً يُستَودَعُ",31,"ع",1,0],["لا تُفسِدَن سابِقَ إِحسانٍ مَضى","وَاللَهُ لا يُغلَبُ فيما قَد مَضى",32,"ض",2,1],["لا تَفرَحَنَّ بِما ظَفِرتَ بِهِ","وَإِذا نُكِبتَ فَأَظهِرِ الجَلَدا",33,"د",2,1],["لا تَفخَرَنَّ بِلِحيَةٍ","كَثُرَت مَنابِتُها طَويلَة",34,"ل",2,1],["لا تَفخَرُ الشَمسُ إِلّا أَنَّها لَقَبٌ","لَهُ وَشِبهٌ لَهُ في العِزِّ وَالنورِ",35,"ر",1,0],["لا تَفتِكَنَّ عَلى الكُؤوسِ بِشُربِها","فَهِيَ الَّتي إِن مُتَّ قَبلَكَ تَفتِكُ",36,"ك",1,0],["لا تفرحوا بحقيرٍ","يصيرُ فيكم مهيبا",37,"ب",2,1],["لا تَفزَعَنَّ إِذا تَطَلَّعَ حادِثٌ","هِمَمُ الرِجالِ عَلى الحَوادِثِ طُلَّعُ",38,"ع",1,0],["لا تَفتَحوا بابَ الشقاق فَإِنَّهُ","باب عَلى سود العَواقب مُغلَقُ",39,"ق",1,0],["لا تَفجَعي أُمّي بِواحِدِها","لَن تُخلِفي مِثلي عَلى أُمّي",40,"ي",1,0],["لا تَفرُغُ النَفسُ مِن شُغلٍ بِدُنياها","رَأَيتُها لَم يَنَلها مَن تَمَنّاها",41,"ا",3,1],["لا تفيدنّ صلاةً","لا ولا تبغ صياما",42,"م",2,0],["لا تُفشِ سِرَّ فَتاةٍ كُنتَ تَألَفُها","إِنَّ الكَريمَ لَها راعٍ وَإِن تابا",43,"ب",2,0],["لا تَفرَحَنَّ بِفَألٍ إِن سَمِعتَ بِهِ","وَلا تَطَيَّر إِذا ما ناعِبٌ نَعَبا",44,"ب",2,1],["لا تَفخَرَنَّ مَعاشِرٌ بِقَديمِها","فَليَنسِبَنَّ كُلابُها وَنُباجُها",45,"ج",3,1],["لا تَفتَخِر إِنَّ كُلَّ فَخرٍ","لِلَّهِ وَاِستَعجَمَ الفَخورُ",46,"ر",1,0],["لا تَفرَقُ النَفسَ مِن حَتفٍ يَحُلُّ بِها","فَالنَفسُ أُنثى لَها بِالمَوتِ إِعراسُ",47,"س",1,0],["لا تَفرَحَنَّ بِما بَلَغتَ مِنَ العُلا","وَإِذا سَبَقتَ فَعَن قَليلٍ تُسبَقُ",48,"ق",1,0],["لا تَفرَحَنَّ بِدَولَةٍ أوتَيَها","إِنَّ المُدالَ عَلَيهِ مِثلُ الدائِل",49,"ل",1,0],["لا تَفرُقُ العَينُ حينَ تُبصِرُهُ","ما بَينَ كَفٍّ تَبينُ مِن قَدَمِ",50,"م",1,0],["لا تفرحن بوعد","ولا تخافن وعيدا",51,"د",2,0],["لا تَفتَ تُزجي فَتِيَّ العيسِ سَاهِمِةً","إِلى فَتى سِنِّها مِنها وَقارِحِها",52,"ح",3,0],["لا تفزعي يا أرضُ لا تفرَقي","من شَبَحٍ تحت الدُّجى عابرِ",53,"ر",1,1],["لا تَفرقي مني ولا تَفزعي","من شاعرٍ شاكٍ إلى ربِّكِ",53,"ك",1,0],["لاَ تُفْصِحُ الْقَوْلَ إِلاَّ","شَدْواً كَكَيْرِ الْحِرَاجِ",54,"ج",1,0],["لاَ تَفْتَأُ الدَّهْرَ فِي حُلُولٍ","لِسَدِّ ثَغْرٍ أَوْ فِي نُزُوحِ",55,"ح",1,0],["لا تَفخَروا بِسِوى اللِوطِ فَإِنَّما","عِندَ المَفاخِرِ فَخرُكُم بِسِتاهِ",56,"ا",2,0],["لا تفتنَنكَّم المظاهر؛ إنها","مثلُ السراب الخادع اللمَّاحِ",57,"ح",1,0],["لا تُفْشِ سِرّا ما اسْتَطَعْتَ إلى امرىء","ٍ يفشي إليك سرائراً سيتودعُ",58,"ع",1,0],["لا تَفْخَروا بِسوَى اللّواطِ، فإِنَّما","عَنْدَ المفاخِرِ فَخْرُكمْ بِستاهِ",59,"ه",1,0],["لا تفخروا بعقولكم ونتاجها","كانت لكم، قبل القتال ، عقول",60,"ل",1,0],["لا تفْتَتِنْكِ حضارة ٌ مَجلوبة ٌ","لم يبنَ حائطها بمالكِ واليدِ",61,"د",1,0]]}