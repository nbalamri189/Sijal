 مَنْجُورِهِ","نَغَمَ الرَّبَابِ وضَجَّةَ النَّايَاتِ",235,"ت",1,0],["لا تفيضوا دما على غير حق","أرخصوه وقد غلت أثمانه",236,"ن",2,0],["لا تفشين له سرا فسوف ترى","منه الندامة إذ للناس يبديه",237,"ه",1,0],["لاتفقئي عينَ السراج فبيننا","فجرٌ ،يمرّغ أنفَه التوقيتُ",238,"ت",1,0],["لا تفتحْ موضوعَ المنزلِ","أوْ نَفْتَحَ في رأسِكَ غارْ",239,"ر",1,0],["لاتفق نومي طويل","طار حتى في عناء",240,"ا",2,0],["لا تَفي سرد عدها موجزات","وأمور كَهذه جائِزات",241,"ت",1,0],["لا تفرحي فيما مضى","لا تحزني وقت الأجل",242,"ل",1,0],["لا تفتخرْ ، ولّى زمانُ مفاخر","فالفخرُ في زمن ِالحداثةِ ثرثرة",243,"ر",2,0]]}