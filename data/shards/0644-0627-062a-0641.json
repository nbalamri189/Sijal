ate.com/ViewPoem.aspx?id=188500",""],[5376,"كيما تشاءُ عشِ الأهواءَ في رَغَدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193188",""],[5376,"لا تسلْ عني فأنِّي عاشقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197711",""],[5409,"لفظةُ الموت لن تعبر عنه","https://www.poetsgate.com/ViewPoem.aspx?id=155408",""],[5458,"كان جدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5461,"اجمل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=5035",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5488,"تجنّب رذال الناس يا نسل الأجواد","https://www.poetsgate.com/ViewPoem.aspx?id=100729",""],[5490,"يادار غزة","https://www.poetsgate.com/ViewPoem.aspx?id=176357",""],[5533,"الصَّمْتُ مَلاذٌ وسِتَار","https://www.poetsgate.com/ViewPoem.aspx?id=177099",""],[5660,"فَالوَصلُ وَ الصَّدُ في أَيامِنا دُوَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23914",""],[5718,"داو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214404",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5818,"إذرفْ دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=193230",""],[5818,"لم يُعرَف الطيْبُ إلّا بالمَنَاتينِ","https://www.poetsgate.com/ViewPoem.aspx?id=186542",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[5906,"لا تفزعن","https://www.poetsgate.com/ViewPoem.aspx?id=188237",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5937,"غيمتان","https://www.poetsgate.com/ViewPoem.aspx?id=211886",""],[5939,"طوفان لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=178596",""],[5943,"يافؤادي إن تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=34279",""],[1920,"لا تكتبي","https://www.poetsgate.com/ViewPoem.aspx?id=191478",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[5956,"نصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=193564",""],[5969,"لا تفتحي الباب الذي أوصدته","https://www.poetsgate.com/ViewPoem.aspx?id=198679",""],[6031,"يا غَادِياتِ السُّحْبِ لا تتَجاوزِي","https://www.poetsgate.com/ViewPoem.aspx?id=46319",""],[4442,"ذهب الورق وانطوى سلطانه","https://www.poetsgate.com/ViewPoem.aspx?id=170989",""],[6084,"إحذر صديقك لا تأمنه إن له","https://www.poetsgate.com/ViewPoem.aspx?id=170885",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6143,"ربما كنت هباء","https://www.poetsgate.com/ViewPoem.aspx?id=33256",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6213,"يا أمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76311&r=&rc=59",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""]],"verses":[["لا تَفتُرُنَّ عَلى الزَمانِ وَإِن","عَثَرَ الزَمانُ بِعِزِّكُم تَعِسا",0,"س",2,0],["لا تُفشِ سِرَّك إِلّا عِندَ ذي ثِقَةٍ","أَو لا فَأَفضَلُ ما اِستَودَعتَ أَسرارا",1,"ر",2,1],["لا تَفرَحوا بفُتوحِكُم","هَذا فَإِنَّ الدَهرَ راقِد",2,"د",1,0],["لا تُفسِدَن ما قَد تَأَكَّدَ بَينَنا","مِن صالِحٍ خَطَراتُ ظَنٍّ فاسِدِ",3,"د",1,0],["لا تَفسَحَن لِلنَفسِ في شَأوِ المُنى","إِنَّ اِغتِرارَكَ بِالمُنى لَضَلالُ",4,"ل",1,0],["لا تَفْتَأُ الخِدْعَة فِي إِثْرِهَا","سَاعِيَةً أَوْ حَوْلَهَا دَائِرَهْ",5,"ر",2,0],["لا تفرحا بالوسامَين اللذين هما","طَوقا إسارة مصر فيكما اقترنا",6,"ن",2,0],["لا تفخروا أن كسرتم غرب شوكتنا","لا فخر للصقر في أن يقتل النغرا",7,"ر",2,0],["لا تَفخَرَنَّ وَفي أَديمِ مُجاشِعٍ","حَلَمٌ فَلَيسَ سُيورُهُ بِسُيورِ",8,"ر",1,0],["لا تَفخَرُنَّ فَإِنَّ اللَهَ أَنزَلَكُم","يا خُزرَ تَغلِبَ دارَ الذُلِّ وَالعارِ",9,"ر",1,0],["لا تَفخَرَنَّ إِذا سَمِعتَ مُجاشِعاً","يَتَخاوَرونَ تَخاوُرَ الأَثوارِ",10,"ر",1,0],["لا تَفخَرَنَّ فَإِنَّ دينَ مُجاشِعٍ","دينُ المَجوسِ تَطوفُ حَولَ دُوارِ",10,"ر",1,0],["لا تَفخَرَنَّ عَلى قَومٍ عَرَفتَ لَهُم","نورَ الهُدى وَعَرينَ العِزِّ ذي الخيسِ",11,"س",1,0],["لا تَفرَحَنَّ فَكُلُّ والٍ يُعزَلُ","وَكَما عُزِلتَ فَعَن قَريبٍ تُقتَلُ",12,"ل",1,1],["لا تَفرَحي يا هِندُ وَاِستَحلِبي","دَمعاً وَأَذري عَبرَةَ الثاكِلِ",13,"ل",1,0],["لا تُفْلِتَنْ منكُم شَبَابيطُهُ","لا أفلتَ الطَّامي ولا الراسبُ",14,"ب",1,0],["لا تُفَرِّطْ في نعيمٍ","بعد تكميل أَداتِهْ",15,"ت",2,0],["لا تُفْسِدَنِّي بالتَّعسُّفِ بعدما","بلَغَ التَّألُّفُ غَايَةَ المُسْتَصْلِحِ",16,"ح",1,0],["لا تفرحنَّ بحسنها وجمالها","فليرحمنك فيهما الحسَّادُ",17,"د",1,0],["لا تَفرَّدْ بأكل مالٍ ولا تَمْ","نُنْ بعُرْفٍ فَشَرُّهُ مَمْنونه",18,"ن",2,0],["لا تُفْرطُ الجدوى أنامل كفّهِ","حتى يهشَّ إلى فَعَالٍ ثاني",19,"ن",2,0],["لا تُفاخِر بِالواخِداتِ وَلا بِال","خَيلِ مِن أَدهَمٍ وَمِن شَهباءِ",20,"ا",2,0],["لا تَفخَروا بِعُقولِكُم وَنِتاجِها","كنَت لَكُم قَبلَ القِتالِ عُقولُ",21,"ل",1,0],["لا تَفَعَنَّ تِلكَ النُفوسِ إِلى الرَدى","إِنَّ النُفوسَ وَإِن صَغُرنَ غَوالي",22,"ل",2,0],["لا تفيد الاكفان بيضا عليهم","ولعل البياض مثل السواد",23,"د",1,0],["لا تفعل الارض الا","كما تشاء السماء",24,"ا",2,0],["لا تفزع الكاعب العذراء من كلمي","فان نصل سهامي غير مسموم",25,"م",1,0],["لا تفزعني بالمنية موعدا","فالحر ليس من المنية يفزع",26,"ع",1,0],["لا تَفتِنَنكِ حَضارَةٌ مَجلوبَةٌ","لَم يُبنَ حائِطُها بِمالِكِ وَاليَدِ",27,"د",1,0],["لا تُفقَدَنَّ فَلَولا ما تُراحُ لَهُ","مِنَ السَماحَةِ كانَ الجودُ قَد فُقِدا",28,"د",2,0],["لاتَفخَرَنَّ فَلَم يُنسَب أَبوكَ إِلى","بَهرامِ جورٍ وَلا بَهرامِ شوبينِ",29,"ن",1,0],["لا تَفْصِمُ الأيامُ طوقي إنني","أصبحتُ بالإحسانِ منكَ مُطوَّقا",30,"ق",2,0],["لا تَفشِ سِرّاً ما اِستَطَعتَ إِلى اِمرئٍ","يَفشي إِلَيكَ سَرائراً يُستَودَعُ",31,"ع",1,0],["لا تُفسِدَن سابِقَ إِحسانٍ مَضى","وَاللَهُ لا يُغلَبُ فيما قَد مَضى",32,"ض",2,1],["لا تَفرَحَنَّ بِما ظَفِرتَ بِهِ","وَإِذا نُكِبتَ فَأَظهِرِ الجَلَدا",33,"د",2,1],["لا تَفخَرَنَّ بِلِحيَةٍ","كَثُرَت مَنابِتُها طَويلَة",34,"ل",2,1],["لا تَفخَرُ الشَمسُ إِلّا أَنَّها لَقَبٌ","لَهُ وَشِبهٌ لَهُ في العِزِّ وَالنورِ",35,"ر",1,0],["لا تَفتِكَنَّ عَلى الكُؤوسِ بِشُربِها","فَهِيَ الَّتي إِن مُتَّ قَبلَكَ تَفتِكُ",36,"ك",1,0],["لا تفرحوا بحقيرٍ","يصيرُ فيكم مهيبا",37,"ب",2,1],["لا تَفزَعَنَّ إِذا تَطَلَّعَ حادِثٌ","هِمَمُ الرِجالِ عَلى الحَوادِثِ طُلَّعُ",38,"ع",1,0],["لا تَفتَحوا بابَ الشقاق فَإِنَّهُ","باب عَلى سود العَواقب مُغلَقُ",39,"ق",1,0],["لا تَفجَعي أُمّي بِواحِدِها","لَن تُخلِفي مِثلي عَلى أُمّي",40,"م",2,0],["لا تَفرُغُ النَفسُ مِن شُغلٍ بِدُنياها","رَأَيتُها لَم يَنَلها مَن تَمَنّاها",41,"ا",3,1],["لا تفيدنّ صلاةً","لا ولا تبغ صياما",42,"م",2,0],["لا تُفشِ سِرَّ فَتاةٍ كُنتَ تَألَفُها","إِنَّ الكَريمَ لَها راعٍ وَإِن تابا",43,"ب",2,0],["لا تَفرَحَنَّ بِفَألٍ إِن سَمِعتَ بِهِ","وَلا تَطَيَّر إِذا ما ناعِبٌ نَعَبا",44,"ب",2,1],["لا تَفخَرَنَّ مَعاشِرٌ بِقَديمِها","فَليَنسِبَنَّ كُلابُها وَنُباجُها",45,"ج",3,1],["لا تَفتَخِر إِنَّ كُلَّ فَخرٍ","لِلَّهِ وَاِستَعجَمَ الفَخورُ",46,"ر",1,0],["لا تَفرَقُ النَفسَ مِن حَتفٍ يَحُلُّ بِها","فَالنَفسُ أُنثى لَها بِالمَوتِ إِعراسُ",47,"س",1,0],["لا تَفرَحَنَّ بِما بَلَغتَ مِنَ العُلا","وَإِذا سَبَقتَ فَعَن قَليلٍ تُسبَقُ",48,"ق",1,0],["لا تَفرَحَنَّ بِدَولَةٍ أوتَيَها","إِنَّ المُدالَ عَلَيهِ مِثلُ الدائِل",49,"ل",1,0],["لا تَفرُقُ العَينُ حينَ تُبصِرُهُ","ما بَينَ كَفٍّ تَبينُ مِن قَدَمِ",50,"م",1,0],["لا تفرحن بوعد","ولا تخافن وعيدا",51,"د",2,0],["لا تَفتَ تُزجي فَتِيَّ العيسِ سَاهِمِةً","إِلى فَتى سِنِّها مِنها وَقارِحِها",52,"ح",3,0],["لا تفزعي يا أرضُ لا تفرَقي","من شَبَحٍ تحت الدُّجى عابرِ",53,"ر",1,1],["لا تَفرقي مني ولا تَفزعي","من شاعرٍ شاكٍ إلى ربِّكِ",53,"ك",1,0],["لاَ تُفْصِحُ الْقَوْلَ إِلاَّ","شَدْواً كَكَيْرِ الْحِرَاجِ",54,"ج",1,0],["لاَ تَفْتَأُ الدَّهْرَ فِي حُلُولٍ","لِسَدِّ ثَغْرٍ أَوْ فِي نُزُوحِ",55,"ح",1,0],["لا تَفخَروا بِسِوى اللِوطِ فَإِنَّما","عِندَ المَفاخِرِ فَخرُكُم بِسِتاهِ",56,"ا",2,0],["لا تفتنَنكَّم المظاهر؛ إنها","مثلُ السراب الخادع اللمَّاحِ",57,"ح",1,0],["لا تُفْشِ سِرّا ما اسْتَطَعْتَ إلى امرىء","ٍ يفشي إليك سرائراً سيتودعُ",58,"ع",1,0],["لا تَفْخَروا بِسوَى اللّواطِ، فإِنَّما","عَنْدَ المفاخِرِ فَخْرُكمْ بِستاهِ",59,"ه",1,0],["لاتفكّر في مسائل نتايجها .. أثام","يكفي أن الوقت ملبسني من الأثم .. كوت",60,"ت",1,0],["لاتفرح اليا زمرولك.. يالثعل..","الثعل..؟ مايتبعه كون جراوته.....",61,"ت",2,0],["لا تفخروا بعقولكم ونتاجها","كانت لكم، قبل القتال ، عقول",62,"ل",1,0],["لا تفنطوا فلقد غرستم جنّة","تجني أكفّكم إذا أثمارها",63,"ر",3,0],["لا تفْتَتِنْكِ حضارة ٌ مَجلوبة ٌ","لم يبنَ حائطها بمالكِ واليدِ",64,"د",1,0],["لا تفاجئنا بكبر","قد عرفناك صغيرا",65,"ر",2,0],["لا تَفْخَرَنَّ فإن عودِيَ نَبْعَةٌ","أعْيَتْ أبا كَرِبٍ وعودُكَ خَرْوَعُ",66,"ع",1,0],["لا تفترْ على عِيالِك إن كنت","غنيّاً واجمل والبَسْطَ فيهَا",67,"ي",3,0],["لا تفكرْ ولا تذكر طباعا","سلفتْ من مصاحبٍ لن يقيما",68,"م",2,0],["لا تفرقْه عليهم كلّهُ","تَنْدَمَنْ فالناسُ أعداءُ المُقِلْ",69,"ل",1,0],["لا تفقدنّ فتىً بنزوى فاضلاً","ذَا قاعدٌ يرجو وهذا مَاثِلُ",70,"ل",1,0],["لا تفتحن بغير الجدِّ مشكلةً","فليس يبقى على مفتاحه غلق",71,"ق",1,0],["لا تفلح الأَشيا بغيرِ مدبّرٍ","عدم البقا قوم عدوا امدادا",72,"د",2,0],["لا تفرحن بسقطات الرجال ولا","تهزأ بغيرك واحذر صولة الدول",73,"ل",1,0],["لا تَفْرَحنَّ إذا أعطاكَ من عُرُضٍ","فإن بعض عَطاياهُ له سَبَب",74,"ب",1,0],["لا تَفْرحنَّ برتبةٍ","أَعطاكَها في الناسِ جَدُّكْ",75,"ك",1,1],["لا تفرضوا بجفاكم تعذيبي","وترفقوا في الحب بالمندوب",76,"ب",1,1],["لا تُفَكِّري بَغد","قَد يَجي وَلا نَفيق",77,"ق",1,0],["لا تفقدنَّ صداقةً بل كن لها","مُتفقِّداً فلكَم بَكاها الفاقد",78,"د",1,0],["لا تفضَحنَّ العاشقين فَحَولَهم","كَثرت عيونُ الحُسَّدِ الرُّقَباء",79,"ا",2,0],["لا تفترانِ تغزلانِ السِحْرا","حبائلاً تكثرُ فيها الأسرى",80,"ر",2,0],["لا تُفزِعُ الأَرنَبَ أَهوالُها","وَلا تَرى الضَبَّ بِها يَنجَحِر",81,"ر",1,0],["لا تَفخرَنَّ بألقابٍ تُدِلُّ بها","فإنّ ذلك لم يُكسبْكَ تَفْخيما",82,"م",2,1],["لا تَفتَحَن بابَ العِتابِ فَإِنَّني","أَخشى عَلَيهِ أَن يُفَتِّحَ وَردَهُ",83,"د",2,0],["لا تفعَلي إن حانَ صَد","دُكَ أو فِراقُكِ حان حَيني",84,"ن",2,0],["لا تَفزَعنَّ إلى غَير النَّوى أَبداً","فَما لِداءِ الهَوى غَيرُ النوى راقِ",85