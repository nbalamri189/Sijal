"],[513,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[540,"لا تفخرن عليك بعد بقية","https://www.aldiwan.net/poem34043.html","الكامل"],[549,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[549,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"],[549,"قولوا لمن غلط الزمان به","https://www.aldiwan.net/poem48069.html","أحذ الكامل"],[556,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[560,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[560,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[560,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[565,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"]],"verses":[["لا تَفتُرُنَّ عَلى الزَمانِ وَإِن","عَثَرَ الزَمانُ بِعِزِّكُم تَعِسا",0,"س",2,0],["لا تُفشِ سِرَّك إِلّا عِندَ ذي ثِقَةٍ","أَو لا فَأَفضَلُ ما اِستَودَعتَ أَسرارا",1,"ر",2,1],["لا تَفرَحوا بفُتوحِكُم","هَذا فَإِنَّ الدَهرَ راقِد",2,"د",1,0],["لا تُفسِدَن ما قَد تَأَكَّدَ بَينَنا","مِن صالِحٍ خَطَراتُ ظَنٍّ فاسِدِ",3,"د",1,0],["لا تَفسَحَن لِلنَفسِ في شَأوِ المُنى","إِنَّ اِغتِرارَكَ بِالمُنى لَضَلالُ",4,"ل",1,0],["لا تَفْتَأُ الخِدْعَة فِي إِثْرِهَا","سَاعِيَةً أَوْ حَوْلَهَا دَائِرَهْ",5,"ر",2,0],["لا تفرحا بالوسامَين اللذين هما","طَوقا إسارة مصر فيكما اقترنا",6,"ن",2,0],["لا تفخروا أن كسرتم غرب شوكتنا","لا فخر للصقر في أن يقتل النغرا",7,"ر",2,0],["لا تَفخَرَنَّ وَفي أَديمِ مُجاشِعٍ","حَلَمٌ فَلَيسَ سُيورُهُ بِسُيورِ",8,"ر",1,0],["لا تَفخَرُنَّ فَإِنَّ اللَهَ أَنزَلَكُم","يا خُزرَ تَغلِبَ دارَ الذُلِّ وَالعارِ",9,"ر",1,0],["لا تَفخَرَنَّ إِذا سَمِعتَ مُجاشِعاً","يَتَخاوَرونَ تَخاوُرَ الأَثوارِ",10,"ر",1,0],["لا تَفخَرَنَّ فَإِنَّ دينَ مُجاشِعٍ","دينُ المَجوسِ تَطوفُ حَولَ دُوارِ",10,"ر",1,0],["لا تَفخَرَنَّ عَلى قَومٍ عَرَفتَ لَهُم","نورَ الهُدى وَعَرينَ العِزِّ ذي الخيسِ",11,"س",1,0],["لا تَفرَحَنَّ فَكُلُّ والٍ يُعزَلُ","وَكَما عُزِلتَ فَعَن قَريبٍ تُقتَلُ",12,"ل",1,1],["لا تَفرَحي يا هِندُ وَاِستَحلِبي","دَمعاً وَأَذري عَبرَةَ الثاكِلِ",13,"ل",1,0],["لا تُفْلِتَنْ منكُم شَبَابيطُهُ","لا أفلتَ الطَّامي ولا الراسبُ",14,"ب",1,0],["لا تُفَرِّطْ في نعيمٍ","بعد تكميل أَداتِهْ",15,"ت",2,0],["لا تُفْسِدَنِّي بالتَّعسُّفِ بعدما","بلَغَ التَّألُّفُ غَايَةَ المُسْتَصْلِحِ",16,"ح",1,0],["لا تفرحنَّ بحسنها وجمالها","فليرحمنك فيهما الحسَّادُ",17,"د",1,0],["لا تَفرَّدْ بأكل مالٍ ولا تَمْ","نُنْ بعُرْفٍ فَشَرُّهُ مَمْنونه",18,"ن",2,0],["لا تُفْرطُ الجدوى أنامل كفّهِ","حتى يهشَّ إلى فَعَالٍ ثاني",19,"ن",2,0],["لا تُفاخِر بِالواخِداتِ وَلا بِال","خَيلِ مِن أَدهَمٍ وَمِن شَهباءِ",20,"ا",2,0],["لا تَفخَروا بِعُقولِكُم وَنِتاجِها","كنَت لَكُم قَبلَ القِتالِ عُقولُ",21,"ل",1,0],["لا تَفَعَنَّ تِلكَ النُفوسِ إِلى الرَدى","إِنَّ النُفوسَ وَإِن صَغُرنَ غَوالي",22,"ل",2,0],["لا تفيد الاكفان بيضا عليهم","ولعل البياض مثل السواد",23,"د",1,0],["لا تفعل الارض الا","كما تشاء السماء",24,"ا",2,0],["لا تفزع الكاعب العذراء من كلمي","فان نصل سهامي غير مسموم",25,"م",1,0],["لا تفزعني بالمنية موعدا","فالحر ليس من المنية يفزع",26,"ع",1,0],["لا تَفتِنَنكِ حَضارَةٌ مَجلوبَةٌ","لَم يُبنَ حائِطُها بِمالِكِ وَاليَدِ",27,"د",1,0],["لا تُفقَدَنَّ فَلَولا ما تُراحُ لَهُ","مِنَ السَماحَةِ كانَ الجودُ قَد فُقِدا",28,"د",2,0],["لاتَفخَرَنَّ فَلَم يُنسَب أَبوكَ إِلى","بَهرامِ جورٍ وَلا بَهرامِ شوبينِ",29,"ن",1,0],["لا تَفْصِمُ الأيامُ طوقي إنني","أصبحتُ بالإحسانِ منكَ مُطوَّقا",30,"ق",2,0],["لا تَفشِ سِرّاً ما اِستَطَعتَ إِلى اِمرئٍ","يَفشي إِلَيكَ سَرائراً يُستَودَعُ",31,"ع",1,0],["لا تُفسِدَن سابِقَ إِحسانٍ مَضى","وَاللَهُ لا يُغلَبُ فيما قَد مَضى",32,"ض",2,1],["لا تَفرَحَنَّ بِما ظَفِرتَ بِهِ","وَإِذا نُكِبتَ فَأَظهِرِ الجَلَدا",33,"د",2,1],["لا تَفخَرَنَّ بِلِحيَةٍ","كَثُرَت مَنابِتُها طَويلَة",34,"ل",2,1],["لا تَفخَرُ الشَمسُ إِلّا أَنَّها لَقَبٌ","لَهُ وَشِبهٌ لَهُ في العِزِّ وَالنورِ",35,"ر",1,0],["لا تَفتِكَنَّ عَلى الكُؤوسِ بِشُربِها","فَهِيَ الَّتي إِن مُتَّ قَبلَكَ تَفتِكُ",36,"ك",1,0],["لا تفرحوا بحقيرٍ","يصيرُ فيكم مهيبا",37,"ب",2,1],["لا تَفزَعَنَّ إِذا تَطَلَّعَ حادِثٌ","هِمَمُ الرِجالِ عَلى الحَوادِثِ طُلَّعُ",38,"ع",1,0],["لا تَفتَحوا بابَ الشقاق فَإِنَّهُ","باب عَلى سود العَواقب مُغلَقُ",39,"ق",1,0],["لا تَفجَعي أُمّي بِواحِدِها","لَن تُخلِفي مِثلي عَلى أُمّي",40,"ي",1,0],["لا تَفرُغُ النَفسُ مِن شُغلٍ بِدُنياها","رَأَيتُها لَم يَنَلها مَن تَمَنّاها",41,"ا",3,1],["لا تفيدنّ صلاةً","لا ولا تبغ صياما",42,"م",2,0],["لا تُفشِ سِرَّ فَتاةٍ كُنتَ تَألَفُها","إِنَّ الكَريمَ لَها راعٍ وَإِن تابا",43,"ب",2,0],["لا تَفرَحَنَّ بِفَألٍ إِن سَمِعتَ بِهِ","وَلا تَطَيَّر إِذا ما ناعِبٌ نَعَبا",44,"ب",2,1],["لا تَفخَرَنَّ مَعاشِرٌ بِقَديمِها","فَليَنسِبَنَّ كُلابُها وَنُباجُها",45,"ج",3,1],["لا تَفتَخِر إِنَّ كُلَّ فَخرٍ","لِلَّهِ وَاِستَعجَمَ الفَخورُ",46,"ر",1,0],["لا تَفرَقُ النَفسَ مِن حَتفٍ يَحُلُّ بِها","فَالنَفسُ أُنثى لَها بِالمَوتِ إِعراسُ",47,"س",1,0],["لا تَفرَحَنَّ بِما بَلَغتَ مِنَ العُلا","وَإِذا سَبَقتَ فَعَن قَليلٍ تُسبَقُ",48,"ق",1,0],["لا تَفرَحَنَّ بِدَولَةٍ أوتَيَها","إِنَّ المُدالَ عَلَيهِ مِثلُ الدائِل",49,"ل",1,0],["لا تَفرُقُ العَينُ حينَ تُبصِرُهُ","ما بَينَ كَفٍّ تَبينُ مِن قَدَمِ",50,"م",1,0],["لا تفرحن بوعد","ولا تخافن وعيدا",51,"د",2,0],["لا تَفتَ تُزجي فَتِيَّ العيسِ سَاهِمِةً","إِلى فَتى سِنِّها مِنها وَقارِحِها",52,"ح",3,0],["لا تفزعي يا أرضُ لا تفرَقي","من شَبَحٍ تحت الدُّجى عابرِ",53,"ر",1,1],["لا تَفرقي مني ولا تَفزعي","من شاعرٍ شاكٍ إلى ربِّكِ",53,"ك",1,0],["لاَ تُفْصِحُ الْقَوْلَ إِلاَّ","شَدْواً كَكَيْرِ الْحِرَاجِ",54,"ج",1,0],["لاَ تَفْتَأُ الدَّهْرَ فِي حُلُولٍ","لِسَدِّ ثَغْرٍ أَوْ فِي نُزُوحِ",55,"ح",1,0],["لا تَفخَروا بِسِوى اللِوطِ فَإِنَّما","عِندَ المَفاخِرِ فَخرُكُم بِسِتاهِ",56,"ا",2,0],["لا تفتنَنكَّم المظاهر؛ إنها","مثلُ السراب الخادع اللمَّاحِ",57,"ح",1,0],["لا تُفْشِ سِرّا ما اسْتَطَعْتَ إلى امرىء","ٍ يفشي إليك سرائراً سيتودعُ",58,"ع",1,0],["لا تَفْخَروا بِسوَى اللّواطِ، فإِنَّما","عَنْدَ المفاخِرِ فَخْرُكمْ بِستاهِ",59,"ه",1,0],["لا تفخروا بعقولكم ونتاجها","كانت لكم، قبل القتال ، عقول",60,"ل",1,0],["لا تفْتَتِنْكِ حضارة ٌ مَجلوبة ٌ","لم يبنَ حائطها بمالكِ واليدِ",61,"د",1,0],["لا تفاجئنا بكبر","قد عرفناك صغيرا",62,"ر",2,0],["لا تَفْخَرَنَّ فإن عودِيَ نَبْعَةٌ","أعْيَتْ أبا كَرِبٍ وعودُكَ خَرْوَعُ",63,"ع",1,0],["لا تفترْ على عِيالِك إن كنت","غنيّاً واجمل والبَسْطَ فيهَا",64,"ي",3,0],["لا تفكرْ ولا تذكر طباعا","سلفتْ من مصاحبٍ لن يقيما",65,"م",2,0],["لا تفرقْه عليهم كلّهُ","تَنْدَمَنْ فالناسُ أعداءُ المُقِلْ",66,"ل",1,0],["لا تفقدنّ فتىً بنزوى فاضلاً","ذَا قاعدٌ يرجو وهذا مَاثِلُ",67,"ل",1,0],["لا تفتحن بغير الجدِّ مشكلةً","فليس يبقى على مفتاحه غلق",68,"ق",1,0],["لا تفلح الأَشيا بغيرِ مدبّرٍ","عدم البقا قوم عدوا امدادا",69,"د",2,0],["لا تفرحن بسقطات الرجال ولا","تهزأ بغيرك واحذر صولة الدول",70,"ل",1,0],["لا تَفْرَحنَّ إذا أعطاكَ من عُرُضٍ","فإن بعض عَطاياهُ له سَبَب",71,"ب",1,0],["لا تَفْرحنَّ برتبةٍ","أَعطاكَها في الناسِ جَدُّكْ",72,"ك",1,1],["لا تفرضوا بجفاكم تعذيبي","وترفقوا في الحب بالمندوب",73,"ب",1,1],["لا تُفَكِّري بَغد","قَد يَجي وَلا نَفيق",74,"ق",1,0],["لا تفقدنَّ صداقةً بل كن لها","مُتفقِّداً فلكَم بَكاها الفاقد",75,"د",1,0],["لا تفضَحنَّ العاشقين فَحَولَهم","كَثرت عيونُ الحُسَّدِ الرُّقَباء",76,"ا",2,0],["لا تفترانِ تغزلانِ السِحْرا","حبائلاً تكثرُ فيها الأسرى",77,"ر",2,0],["لا تُفزِعُ الأَرنَبَ أَهوالُها","وَلا تَرى الضَبَّ بِها يَنجَحِر",78,"ر",1,0],["لا تَفخرَنَّ بألقابٍ تُدِلُّ بها","فإنّ ذلك لم يُكسبْكَ تَفْخيما",79,"م",2,1],["لا تَفتَحَن بابَ العِتابِ فَإِنَّني","أَخشى عَلَيهِ أَن يُفَتِّحَ وَردَهُ",80,"د",2,0],["لا تفعَلي إن حانَ صَد","دُكَ أو فِراقُكِ حان حَيني",81,"ن",2,0],["لا تَفزَعنَّ إلى غَير النَّوى أَبداً","فَما لِداءِ الهَوى غَيرُ النوى راقِ",82,"ق",1,0],["لا تفخروا بأصولكم وفروعُكم","معتلَّةُ الإيمان بالبِرسام",83,"م",1,0],["لا تفرقي مما يجيب بزعمه","رَجعُ الصدى أن لا سبيل إلى اللقا",84,"ق",2,0],["لا تفه في خَطَّه","تحد عن خِطَّه",85,"ه",1,0],["لا تَفزعَنْ مِن كُلِّ شَيءٍ مُفزِعٍ","ما كُلُّ تَدبير البُروجِ بضائرِ",86,"ر",1,1],["لا تفتخِرْ بغنى أُمطيِتَ كاهلَهُ","فإنَّ أصلَكَ يا فخَّارُ فَخّارُ",87,"ر",1,0],["لا تُفسِدَنَّ نَصيحتِي بشِقَاقِ","وأبيكَ ما السُّلوانُ من أخْلاقي",88,"ي",1,1],["لا تَفْلُلِ الأَيَّامُ سيفاً ماضياً","فضَّ الإِلهُ بشفرتيه فاكا",89,"ك",2,0],["لا تفرّي منّي فما ذاك يرضيني","وروحي بك الحفيّ المتيّم",90,"م",1,0],["لا تفخرنَّ أمامه بفضيلةٍ","فهو الحقيقُ بكلِ فضلٍ فاخر",91,"ر",1,0],["لا تُفَرِّط في ساعَةٍ لَستَ فيها","آمِناً مِن مُغافَصاتِ المَنونِ",92,"ن",1,0],["لا تُفسِدَنَّ جَميلاً بِالقَبيحِ وَكُن","مِمَّن رِضاهُ قَريبٌ مِن تَغَضُّبِهِ",93,"ه",1,1],["لا تَفتَأُ الدَهرَ مِن سَحٍّ بِأَربَعَةٍ","كَأَنَّ إِنسانَها بِالصابِ مُكتَحِلُ",94,"ل",1,0],["لا تفكر في طارف وتليد","فأنا لمالي بت طي لحودي",95,"ي",1,1],["لا تُفارِقْهُمْ فَما فا","رَقَ أهلَ الحَقِّ عاقلْ",96,"ل",1,0],["لا تُفَضِّلْ أهلَ المَقالِ على أهْ","لِ قُلوبٍ للحالِ فيها رُغاءُ",97,"ا",2,0],["لا تفتل الأيام حبل مكيدة","إلا وفيه لأمركم تأكيد",98,"د",1,0],["لا تَفخرَنَّ عَليكَ بعدُ بَقِيَّةٌ","والفخرُ يَكمُلُ لِلفَتى المتكاملِ",99,"ل",1,1],["لا تَفخروا قطُّ بِشيءٍ فما","تَركتُمُ فينا لَكم مفخرا",100,"ر",2,0],["لا تفخرن إلا بنفْ","سِكَ يوم فخرٍ إن فَخَرْتا",101,"ت",2,1],["لا تَفرحنَّ بِما أَتاكَ بِهِ","فَالدّهرُ يَسلُبُ كلَّ مَا وَهَبَهْ",102,"ب",2,0],["لا تفارق تقليد شرعك محضاً","خالصاً عن شوائب الإنبهام",103,"م",1,0],["لا تَفْهمُ الأشواقُ أحرُفَنا","الشوقُ ليس يشدّه الطرحُ",104,"ح",1,0],["لا تُفقَدُ الدُّنيا لفَقْدِ عزيزِها","ما دامَ يخلُفُ مَيْتها المَولودُ",105,"د",1,0],["لا تفتحِ البابَ للضِّرغامِ محترزاً","من البعوض فهذا أعظمُ الحُمٌقِ",106,"ق",1,0],["لا تَفتَخِر عَيناكِ في سَفكِ الدِّما","فَلَنا عُيونٌ سافكاتُ دِماءِ",107,"ا",2,0],["لاَ تُفْنِ عُمْرَ الزَّمَانِ إِلاَّ","مَا بَيْنَ قَلاَّيَةٍ وَعُمْرِ",108,"ر",1,0]]}