ُ حربٍ ولا دربُ المُنخّلِ أو","دَفائنُ الجِنِّ شيئاً عند أرماسي",117,"ي",1,0],["ما قَفوُ ذِى العِلمِ لِلقَدِم الغبي سوى","عَينِ الضلال أفِيكُم عَينُ مُزدجِرِ",118,"ر",1,0],["ما قال إبرَاهِيمُ إِنَّ لِشِعرِهِ","لَطَلاَوةً لَم تُلفَ في الأَشعَارِ",119,"ر",1,0],["ما قلدوك بها إلاّ لتُورِثها","من شيمةِ الفضلِ إحساناً ومقدارا",120,"ر",2,0],["ما قلت فيكَ بديهةً","بشرى فقد ختمَ الكتابْ",121,"ب",1,0],["ما قيلَ أَصبَحَ مُفرِقاً مِن دائِهِ","ذا اللَيثُ حَتّى قيلَ أَصبَحَ مُتبَعا",122,"ع",2,0],["ما قَصَّرَ الشُعَراءُ فيكَ تَعَمُّداً","بَل دَقَّ عَن أَفكارِهِم مَعناكا",123,"ك",2,0],["ما قَد أَنَلتَ مُطاعِناً وَعَطِيَّةً","يُدني شَبيباً رَغبَةً وَثِمالا",124,"ل",2,0],["ما قيل ذاك أسيرنا وقتيلنا","بين العوادي والأعادي مثقفا",125,"ف",2,0],["ما قلت قط الشعر لكن يمنكم","في كل صعب آخذ بيميني",126,"ن",2,0],["ما قاله في ربنا قالا به","فعليه من رب السماء اللعنة",127,"ه",1,0],["ما قالها عقل ولكن القضا","يجري فيستلب الحجا والحجة",127,"ه",1,0],["ما قد رأى رمضان يوماً سره","في دار ملك مثل دارك حالا",128,"ل",2,0],["ما قلتُ إلا واثقاً أن الورى","بجميع ما أثنى به أشهادُ",129,"د",1,0],["ما قد سمعنا ولا من قبله سمعوا","جودا كجودك يا يحيى وإن فشروا",130,"ر",3,0],["ما قربَ المركوب إِلا خلتُهم","سلبوا العقولُ لشدةِالتهتامِ",131,"م",1,0],["ما قولي ارقد طالباً لك نومة","عند الخطوب فلست بالنوّامِ",132,"م",1,0],["ما قلل العدلُ مالاً في أوائلهِ","إِلا وعاد كثيراً حين يمهلُه",133,"ل",2,0],["ما قدر عباسٍ لهذا كلهِ","هوأَوهم والله ما هم هاهنا",134,"ن",2,0],["ما قد مهصور رجاه فتى","الا اعتراه شوم ما قدمه",135,"م",2,0],["ما قضاه الإِله لا بد منه","فعلام هذا العريض الطويل",136,"ل",1,0],["ما قربة عند الإله ادخرت","مثل دم الكرماني حين يسفك",137,"ك",1,0],["ما قمت فيه ولا قعدت مطالبا","لكن أتتك ولست بالوسنان",138,"ن",1,0],["ما قال ربك صيحوا وارقصوا ابداً","بل قال صلوا وصوموا واحذروا غضبي",139,"ب",2,0],["ما قَولُهُ في خادمٍ كًهلٍ الحجى","يلفيهِ في عددِ السِّنينَ مُراهقا",140,"ق",2,0],["ما قرطت أذْنَ زنبيلٍ بنانُ يَدي","لو كنتُ أملكُ للدهرِ الظّلومِ يَدا",141,"د",2,0],["ما قلتُ والله يا أمي بقافيةٍ","إلا وكان مقاما