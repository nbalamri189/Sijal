ةَ عَرْضَها والطُّولا",271,"ل",2,0],["ما قامَ رَبُّ عُلومٍ في دِيارِكُمُ","إلاّ وَجَرَّعْتُموهُ أَكْؤُسَ الكَرَبِ",272,"ب",1,0],["ما قالَ أَفعلُ أَمضاهُ لوِجهَتِهِ","وَما أَبى لُجَّ ما يأبى فَلَم يكنِ",273,"ن",1,0],["ما قالَ أوفَت بِهِ مقالتَهُ","عَفواً وَلَم تَعتَرِض لَهُ العِلَلُ",274,"ل",1,0],["ما قومُنا منصفينا أو نفارقهم","على اجتماع لإصلاحٍ بإفسادِ",275,"د",1,0],["ما قرّبوا إِلّا لبينٍ نوقا","فاِحبِسْ دموعاً قد أصَبْنَ طريقا",276,"ق",2,1],["ما قدّم الأصلُ اِمرءاً في الورى","أخّره في الفرع ما أخَّرا",277,"ر",2,0],["ما قيلَ نالوا فوقَ ما","يَهوون حتّى قيل فاتوا",278,"ت",3,0],["ما قنعتْ إلّا بِهِ همّتي","وَلَم أَقلْ إِلّا بهِ حَسبي",279,"ب",2,0],["ما قَصَّرَ السَعيُ وَلا عَلَّلَت","عَن مَطلَبٍ نَفسي أَمانيها",280,"ه",2,1],["ما قَصّرَت بِكَ غايَةٌ عَن غايَةٍ","فَاليَومَ مَجدُكَ مِثلُ مَجدِكَ في غَدِ",281,"د",1,0],["ما قُلتُ في أَحَدٍ سِواكَ عَلِمتُهُ","إِلّا رَأَيتُ القَولَ فيهِ مُحالا",282,"ل",2,0],["ما قيدته عن مدى إطلاقه","إذ لا وجود لها سواه مبينا",283,"ن",2,0],["ما قال إني رأيت أو ما","رأيت إذ كان في عيان",284,"ن",1,0],["ما قلت ذلك من نفسي ولا جهلت","حقيقتي فادعت ما قلته شمما",285,"م",2,0],["ما قصدنا الشيء الذي هو هالك","بل قصدنا وجه الوجود القاصد",286,"د",1,0],["ما قُلْتُ للقلْب أين حِبيِّ","إِلاَّ وقال الضَّميرُ ها هُو",287,"و",1,0],["ما قبرُ انطونَ في الدُّنيا سِوَى صدَفٍ","فقد حوَى في ثَراهُ أفضلَ الدُّرَرِ",288,"ر",1,1],["ما قامَ في أرضناِ من قَبلهِ مَلكٌ","يَرْضَى بهِ اللهُ والأملاكُ والبَشَرُ",289,"ر",1,0],["ما قمتُ حتى دعاني صوتُها الغَرِدُ","قُمُ فالصباحُ عليه الغيمُ يَطَّرِدُ",290,"د",1,1],["ما قد يكون بعده في أمته","فقاله إن قال في وصيته",291,"ه",1,0],["ما قد يطول ذكره لوق دذ كر","وذاك في الأخبار عنهم مشتهر",291,"ر",1,0],["ما قد فشى من قوله إليه","مفارقا ومنكرا عليه",291,"ه",1,0],["ما قَصُرتْ إِلاَّ لأَنَّ الذي","أَهواه قد أَسْعَفَ بالنَّيْلِ",292,"ل",1,0],["ما قُلتُ أَجْرى ماءَه","أَو قُلتُ قَدْ أَوْرَى زِنَاده",293,"د",2,0],["ما قالَ هاتِ له عَلى عِلاَّته","مُسترفدٌ فأَجابَه إِلاَّ بِها",294,"ب",3,0],["ما قُلْتُ يَوْماً قَدْ انْقَضَى عَدَدٌ","مِنَ الأَعادي إِلا أَتَى عَدَدُ",295,"د",1,0],["ما قامَ هذا الكَوْنُ إلّا بِكُمْ","وَلا الوُجودُ المَحْضُ إلَّاكُمْ",296,"م",1,0],["ما قَصْدِيَ لَثْمَهُ وَلكِنْ غَرضِي","إبلاغُ حُوَيْجَةٍ لَهُ في فَمِهْ",297,"ه",1,0],["ما قَيسُ قيَسٌ في الغرامِ بهِ وَلا","عَبرتْ بِطَرْفِ كُثيِّرٍ عَبراتهُ",298,"ت",2,0]]}