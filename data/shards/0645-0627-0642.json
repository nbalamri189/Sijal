ا وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[584,"كيف خلاصي من الذي أجد","https://www.aldiwan.net/poem17479.html","المنسرح"],[584,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"],[584,"لو رق فؤاده على مغرمه","https://www.aldiwan.net/poem17768.html","الدوبيت"],[584,"قلق يحن إلى الأجيرع قلبه","https://www.aldiwan.net/poem17977.html","الكامل"]],"verses":[["ما قَدرُ فَضلِكَ ما أَصبَحتَ تُرزَقُهُ","لَيسَ الحُظوظُ عَلى الأَقدارِ وَالمِهَنِ",0,"ن",1,0],["ما قَدَروا لا عَلَت جُدودُهُمُ","وَلا نَجَوا بَعدَها وَلا وَأَلوا",1,"ل",3,0],["ما قُلتَ ما كانَ صَرفُ الدَهرِ أَدَّبَهُ","بَلى قَديماً وَهَذا فَضلُ تَأديبِ",2,"ب",1,0],["ما قَوَّمَتكِ مُلوكُ أَرضٍ قيمَةً","إِلّا اِرتَفَعتِ وَقَصَّرَ التَقويمُ",3,"م",1,0],["ما قُلتِ إِلا الحَقَّ أَعرِفُهُ","أَجِدُ الدَليلَ عَلَيهِ مِن قَلبي",4,"ب",2,0],["مَا قُرصةُ الشَّمْسِ وَالشَّمْسِ المُنِيَرةِ إِنْ","قِيسَتْ بِهِنَّ سِوَى مِنْ جُمْلَةِ الْقُرصِ",5,"ص",1,0],["ما قَصَّرَ المصرِيُّ في فِعلِهِ","إِذ جَعلَ الحُفرَةِ في دارِهِ",6,"ه",1,1],["ما قامَ لَولا هَواكَ المُدنَفُ الوَصِبُ","يَبكي الطلولَ وَأَهلُ المُنحَنى غَيَبُ",7,"ب",1,1],["ما قَطَّبَت لي حاجِباكَ فَلَيتَني","أَدري وُقيتَ الذَمَّ لم عَبساهُما",8,"م",2,0],["ما قر من شوق إليه قلبه","وعن الكنانة لم يكن بالصابر",9,"ر",1,0],["مَا قِيمَةُ القَوْلِ الجُزَافِ فَإِنَّهُ","مَهْمَا يَخَلْهُ مُجْدِياً لَمْ يُجْدِهِ",10,"د",2,0],["مَا قَصَّرَتْ عَنْ وَاجِبٍ تَقْضِي بِهِ","لَكُمُ الكَرَامَةُ وَهْوَ فِي الإِمْكَانِ",11,"ن",1,0],["مَا قَدَّمَتْ رَجُلاً فِي قَوْمِهِ ثِقَةٌ","بِهِ كَمَا قَدَّمَتْ سَعْداً وَلا جَرَمُ",12,"م",1,0],["مَا قِيمَة الحَيِّ نِصْفُهُ تَعِبٌ","وَنِصْفُهُ فِي الوُجُودِ كَالعَدَمِ",13,"م",1,0],["ما قصَدْنا بسَلِّنا السيف إلاّ","رَدَّ ليل الجهل المُمِيت نهارا",14,"ر",2,0],["ما قادَ مِن عَرَبٍ إِلَيَّ جَوادَهُم","إِلّا تَرَكتُ جَوادَهُم مَحسورا",15,"ر",2,0],["ما قَتَلوهُ عَلى ذَنبٍ أَلَمَّ بِهِ","إِلّا الَّذي نَطَقوا زوراً وَلَم يَكُنِ",16,"ن",1,0],["ما قال إلاَّ في مبادرَة العطا","وتناولِ الأمداح هاكَ وهاتها",17,"ت",3,0],["ما قصر القصاص في فعله","بصاحبٍ كان به ذا خصوص",18,"ص",1,1],["ما قالَ مذ ملَّك قلبي واسترقّ","كقولهم ربَّ غلامٍ لي أبق",19,"ق",1,0],["ما قُدَّ لي عُضوٌ وَلا مِفصَلٌ","إِلّا وَفيهِ لَكُم ذِكرُ",20,"ر",1,0],["ما قلت قافيةً تخبِّر أنهُ","فيما يُثيب أثابني بثوابِ",21,"ب",1,0],["ما قُوبلَتْ رِجَلُ الملوك بمثلهِ","إلا ليملك مشرقاً أو مغربا",22,"ب",2,0],["ما قِسْتُ بَيْنَكمَا هنَاكَ ولم أكن","لأقِيسَ بين مُحمَّدٍ وسَجَاحِ",23,"ح",1,0],["ما قال شعراً ولا رواه فلا","ثَعْلَبَه كان لا ولا أسدَهْ",24,"د",2,0],["ما قُمنَ عندي مَقامَ ذكرك إي","يَايَ إذا ما خَلوتَ للأُنس",25,"س",1,0],["ما قلتُ إلا بعض ما فيكُمُ","فليقُمْ الحاسد وليجْلس",26,"س",1,0],["ما قصر العسر بازدلافيَ لل","مجد مشيحاً في كل مزدلف",27,"ف",1,0],["ما قلت فيه كأنَّ إلا أعوزت","أشباهه فعجزت عن تكييفه",28,"ف",2,0],["ما قَدرُ ما تجدي عليك بطالتي","قَدْرٌ تبيع به لساناً ناطقا",29,"ق",2,0],["ما قيل في القاسم مدح له","إلا وفي القاسم مصداقه",30,"ق",2,0],["ما قلت فيك هجاء خلته كذباً","إلا بدت منك سوءات تحققه",31,"ق",2,0],["ما قدرُ ليلٍ أن تكونَ لبستَهُ","فاخْتِينَ نُوركَ تحتَه واغتيلا",32,"ل",2,0],["ما قرّظوك محبّةً لكنهم","لهمُ بذاك تتوُّجٌ وتكللُ",33,"ل",1,0],["ما قد كستْك يداك مما أسدتا","كافٍ ومدْحُ المادحين تأكُّلُ",33,"ل",1,0],["ما قال أنْ قد عقني","بالصدِّ إلا بَرَّني",34,"ن",2,0],["ما قيل إن مع السمَّاك فضيلةٌ","إلا تناولها عُبَيْدُ اللَّهِ",35,"ه",1,0],["ما قيمَةَ الإِنسانِ مُعتقِداً","إِن لَم يَقُل لِلناسِ ما اِعتَقَدا",36,"د",2,0],["ما قامَ فيهِم أَخو وَفاءِ","يَحفَظُ عَهداً وَلا رَحيمُ",37,"م",1,0],["ما قامَ في آذانِهِم صَمَمٌ","وَكَأَنَّ في آذانِهِم صَمَما",38,"م",2,0],["ما قُلتَ أَنتَ وَلا سَمِعتُ أَنا","هَذا حَديثٌ لا يَليقُ بِنا",39,"ن",2,1],["مَا قَدَّْسَ المثلَ الأَعلى وجمَّلَهُ","في أَعيُنِ النَّاسِ إلاَّ أنَّهُ حُلُمُ",40,"م",1,1],["ما قلت شيئاً بفمي","إلا وعقلي ملهمي",41,"ي",1,1],["ما قوتي ما قيمتي من أنا","بالله قم عني بردّ الجواب",42,"ب",1,0],["ما قَبَّحوا بِالصُبحِ مِن أَشباحِها","راحوا إِلَيكَ فَحَسَّنوهُ مَساءَ",43,"ا",2,0],["ما قَصَّرَ الرُؤَساءُ عَنهُ سَعى لَهُ","سَعدٌ فَكانَ مُوَفَّقاً وَرَشيدا",44,"د",2,0],["ما قوبِلَت عَيناهُ إِلّا ظُنَّتا","تَحتَ الدُجى نارَ الفَريقِ حُلولا",45,"ل",2,0],["ما قَصَدناهُ لِلتَفَضُّلِ إِلّا","أَعشَبَت أَرضُهُ وَصابَت سَماؤُه",46,"ا",3,0],["ما قامَ لَكي لِعِجلٍ حينَ زاحَفَها","وَلَم تَقُم ما دَرايا بَعدُ لِلكَرَجِ",47,"ج",1,1],["ما قُلتُ إِلّا ما عَلِمتُ وَإِنَّما","كُنتُ اِبنَ جَوبَ الأَرضِ سيلَ فَخَبَّرا",48,"ر",2,0],["ما قُلِّدَ السَيفَينِ إِلّا نَجدَةً","وَالحَربُ توجِبُ أَن يُقَلَّدَ آخَرا",48,"ر",2,0],["ما قُلتُ لِلطَيفِ المُسَلِّمِ لا تَعُد","تَغشى وَلا كَفكَفتُ حامِلَ كاسِ",49,"س",1,0],["ماقَضى اللَهُ لِلجَهولِ بِسِترٍ","يَتَلافاهُ مِثلَ حَتفٍ قاضِ",50,"ض",1,0],["ما قَصَّرَت بِكَ هِمَّةٌ عَن هاشِمِ","لَولا اتِّقاءُ عُقوبَةِ الأَشرافِ",51,"ف",1,0],["ما قالَ مُعتَمِداً إِنَّ الغَمامَ حَكى","نَداهُ إِلّا غَبِيُّ الظَنِّ قَد وَهِما",52,"م",2,0],["ما قُلتُ إِلّا الحَقَّ تَعرِفُهُ","في القَولِ مُرتَجِلاً وَفي الشِعرِ",53,"ر",1,0],["ما قُلتُ إِلّا الحَقَّ أُخبِرُهُ","عَن أَهلِ بادِيَةٍ وَلا مِصرِ",54,"ر",1,0],["ما قالَ لا قَطُّ إِلّا في تَشَهُّدِهِ","لَولا التَشَهُّدُ كانَت لاءَهُ نَعَمُ",55,"م",1,0],["مَا قَالَ: لاَ قَطُّ، إلاَّ فِي‌ تَشَهُّدِهِ","لَوْلاَ التَّشَهُّدُ كَانَتْ لاَؤهُ نَعَمُ",56,"م",1,0],["ما قلتُ قَوَّاداً يِرُبُّ مِعِيشَه","لكنْ مساعدُ خِلِّهِ وأخيهِ",57,"ي",2,0],["ما قَدَّرَ اللَهُ لِي فَلَيسَ لَهُ","عَنّي إِلى سِوايَ مُنصَرِفُ",58,"ف",1,0],["ما قُلتُ في فَضلِهِ شَيئاً لِأَمدَحَهُ","إِلّا وَفَضلُ يَزيدٍ فَوقَ ما قُلتُ",59,"ت",1,0],["ما قُلتُ هَذا فيكَ إِلّا وَقَد","جَفَّت بِهِ الأَقلامُ مِن قَبلي",60,"ل",2,0],["ما قالَ ذو العَرشِ لَنا إِخزُنوا","بَل أَنفِقوا مِمّا رَزَقناكُمُ",61,"م",1,0],["ما قضينا ساعة في عرسه","وقضينا العمر في مأتمه",62,"ه",1,0],["ما قستُ نجدتَهُ بحدّةِ مِحْرَبٍ","إلا قضيتُ له بفضلٍ قاهِرِ",63,"ر",1,0],["ما قرّ بي السيرُ في سهلٍ ولا جبلٍ","إلّا كما قرّ جاري الماء في صَبَبِ",64,"ب",1,0],["ما قَبِلَت شِركَكَ يَوماً وَلا","كُفرَكَ إِلّا أَنَّها كافِرَه",65,"ر",2,0],["ما قاسَيا في المَجدِ إِلّا دونَ ما","قاسَيتَهُ في العَدلِ وَالتَوحيدِ",66,"د",1,0],["ما قضاءُ الشامِ إلا شرفٌ","ولمنْ يتركُهُ أعلى شرف