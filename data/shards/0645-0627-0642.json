/poem27233.html","السريع"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"لا تصحبن أخا نسك وإن نسكا","https://www.aldiwan.net/poem64465.html","البسيط"],[50,"ما قام أير حمار فامتلا شبقا","https://www.aldiwan.net/poem62246.html","البسيط"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[46,"ما قر طاسك في كف المدير له","https://www.aldiwan.net/poem22089.html","البسيط"],[46,"أسيت إذا غابت الأحجال والغرر","https://www.aldiwan.net/poem22533.html","البسيط"],[46,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[46,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[46,"قومي إلى ربك مختارة","https://www.aldiwan.net/poem22728.html","السريع"],[76,"ما قدر الله هو الغالب","https://www.aldiwan.net/poem39492.html","البسيط"],[68,"عوذت حبيبي بربِ الطور","https://www.aldiwan.net/poem1501.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85376","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54914","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67353","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116988","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"المحراث","https://www.poetsgate.com/ViewPoem.aspx?id=179461",""],[50,"ما قَام أَيْرُ حمار فامْتَلاَ شَبقاً","https://www.poetsgate.com/ViewPoem.aspx?id=31006",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"بِالله أَولَى يَمِيناً بَرّةً، قَسَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32080",""],[91,"وقال","https://www.poetsgate.com/ViewPoem.aspx?id=52961",""],[51,"يا طول غلَّة نفسِي المبلاهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30801",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[71,"يا مخجلَ الغيثِ المُلِثّ إِذا همى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28027&r=&rc=14",""]],"verses":[["ما قَدرُ فَضلِكَ ما أَصبَحتَ تُرزَقُهُ","لَيسَ الحُظوظُ عَلى الأَقدارِ وَالمِهَنِ",0,"ن",1,0],["ما قَدَروا لا عَلَت جُدودُهُمُ","وَلا نَجَوا بَعدَها وَلا وَأَلوا",1,"ل",3,0],["ما قُلتَ ما كانَ صَرفُ الدَهرِ أَدَّبَهُ","بَلى قَديماً وَهَذا فَضلُ تَأديبِ",2,"ب",1,0],["ما قَوَّمَتكِ مُلوكُ أَرضٍ قيمَةً","إِلّا اِرتَفَعتِ وَقَصَّرَ التَقويمُ",3,"م",1,0],["ما قُلتِ إِلا الحَقَّ أَعرِفُهُ","أَجِدُ الدَليلَ عَلَيهِ مِن قَلبي",4,"ب",2,0],["مَا قُرصةُ الشَّمْسِ وَالشَّمْسِ المُنِيَرةِ إِنْ","قِيسَتْ بِهِنَّ سِوَى مِنْ جُمْلَةِ الْقُرصِ",5,"ص",1,0],["ما قَصَّرَ المصرِيُّ في فِعلِهِ","إِذ جَعلَ الحُفرَةِ في دارِهِ",6,"ه",1,1],["ما قامَ لَولا هَواكَ المُدنَفُ الوَصِبُ","يَبكي الطلولَ وَأَهلُ المُنحَنى غَيَبُ",7,"ب",1,1],["ما قَطَّبَت لي حاجِباكَ فَلَيتَني","أَدري وُقيتَ الذَمَّ لم عَبساهُما",8,"م",2,0],["ما قر من شوق إليه قلبه","وعن الكنانة لم يكن بالصابر",9,"ر",1,0],["مَا قِيمَةُ القَوْلِ الجُزَافِ فَإِنَّهُ","مَهْمَا يَخَلْهُ مُجْدِياً لَمْ يُجْدِهِ",10,"د",2,0],["مَا قَصَّرَتْ عَنْ وَاجِبٍ تَقْضِي بِهِ","لَكُمُ الكَرَامَةُ وَهْوَ فِي الإِمْكَانِ",11,"ن",1,0],["مَا قَدَّمَتْ رَجُلاً فِي قَوْمِهِ ثِقَةٌ","بِهِ كَمَا قَدَّمَتْ سَعْداً وَلا جَرَمُ",12,"م",1,0],["مَا قِيمَة الحَيِّ نِصْفُهُ تَعِبٌ","وَنِصْفُهُ فِي الوُجُودِ كَالعَدَمِ",13,"م",1,0],["ما قصَدْنا بسَلِّنا السيف إلاّ","رَدَّ ليل الجهل المُمِيت نهارا",14,"ر",2,0],["ما قادَ مِن عَرَبٍ إِلَيَّ جَوادَهُم","إِلّا تَرَكتُ جَوادَهُم مَحسورا",15,"ر",2,0],["ما قَتَلوهُ عَلى ذَنبٍ أَلَمَّ بِهِ","إِلّا الَّذي نَطَقوا زوراً وَلَم يَكُنِ",16,"ن",1,0],["ما قال إلاَّ في مبادرَة العطا","وتناولِ الأمداح هاكَ وهاتها",17,"ت",3,0],["ما قصر القصاص في فعله","بصاحبٍ كان به ذا خصوص",18,"ص",1,1],["ما قالَ مذ ملَّك قلبي واسترقّ","كقولهم ربَّ غلامٍ لي أبق",19,"ق",1,0],["ما قُدَّ لي عُضوٌ وَلا مِفصَلٌ","إِلّا وَفيهِ لَكُم ذِكرُ",20,"ر",1,0],["ما قلت قافيةً تخبِّر أنهُ","فيما يُثيب أثابني بثوابِ",21,"ب",1,0],["ما قُوبلَتْ رِجَلُ الملوك بمثلهِ","إلا ليملك مشرقاً أو مغربا",22,"ب",2,0],["ما قِسْتُ بَيْنَكمَا هنَاكَ ولم أكن","لأقِيسَ بين مُحمَّدٍ وسَجَاحِ",23,"ح",1,0],["ما قال شعراً ولا رواه فلا","ثَعْلَبَه كان لا ولا أسدَهْ",24,"د",2,0],["ما قُمنَ عندي مَقامَ ذكرك إي","يَايَ إذا ما خَلوتَ للأُنس",25,"س",1,0],["ما قلتُ إلا بعض ما فيكُمُ","فليقُمْ الحاسد وليجْلس",26,"س",1,0],["ما قصر العسر بازدلافيَ لل","مجد مشيحاً في كل مزدلف",27,"ف",1,0],["ما قلت فيه كأنَّ إلا أعوزت","أشباهه فعجزت عن تكييفه",28,"ف",2,0],["ما قَدرُ ما تجدي عليك بطالتي","قَدْرٌ تبيع به لساناً ناطقا",29,"ق",2,0],["ما قيل في القاسم مدح له","إلا وفي القاسم مصداقه",30,"ق",2,0],["ما قلت فيك هجاء خلته كذباً","إلا بدت منك سوءات تحققه",31,"ق",2,0],["ما قدرُ ليلٍ أن تكونَ لبستَهُ","فاخْتِينَ نُوركَ تحتَه واغتيلا",32,"ل",2,0],["ما قرّظوك محبّةً لكنهم","لهمُ بذاك تتوُّجٌ وتكللُ",33,"ل",1,0],["ما قد كستْك يداك مما أسدتا","كافٍ ومدْحُ المادحين تأكُّلُ",33,"ل",1,0],["ما قال أنْ قد عقني","بالصدِّ إلا بَرَّني",34,"ن",2,0],["ما قيل إن مع السمَّاك فضيلةٌ","إلا تناولها عُبَيْدُ اللَّهِ",35,"ه",1,0],["ما قيمَةَ الإِنسانِ مُعتقِداً","إِن لَم يَقُل لِلناسِ ما اِعتَقَدا",36,"د",2,0],["ما قامَ فيهِم أَخو وَفاءِ","يَحفَظُ عَهداً وَلا رَحيمُ",37,"م",1,0],["ما قامَ في آذانِهِم صَمَمٌ","وَكَأَنَّ في آذانِهِم صَمَما",38,"م",2,0],["ما قُلتَ أَنتَ وَلا سَمِعتُ أَنا","هَذا حَديثٌ لا يَليقُ بِنا",39,"ن",2,1],["مَا قَدَّْسَ المثلَ الأَعلى وجمَّلَهُ","في أَعيُنِ النَّاسِ إلاَّ أنَّهُ حُلُمُ",40,"م",1,1],["ما قلت شيئاً بفمي","إلا وعقلي ملهمي",41,"ي",1,1],["ما قوتي ما قيمتي من أنا","بالله قم عني بردّ الجواب",42,"ب",1,0],["ما قَبَّحوا بِالصُبحِ مِن أَشباحِها","راحوا إِلَيكَ فَحَسَّنوهُ مَساءَ",43,"ا",2,0],["ما قَصَّرَ الرُؤَساءُ عَنهُ سَعى لَهُ","سَعدٌ فَكانَ مُوَفَّقاً وَرَشيدا",44,"د",2,0],["ما قوبِلَت عَيناهُ إِلّا ظُنَّتا","تَحتَ الدُجى نارَ الفَريقِ حُلولا",45,"ل",2,0],["ما قَصَدناهُ لِلتَفَضُّلِ إِلّا","أَعشَبَت أَرضُهُ وَصابَت سَماؤُه",46,"ا",3,0],["ما قامَ لَكي لِعِجلٍ حينَ زاحَفَها","وَلَم تَقُم ما دَرايا بَعدُ لِلكَرَجِ",47,"ج",1,1],["ما قُلتُ إِلّا ما عَلِمتُ وَإِنَّما","كُنتُ اِبنَ جَوبَ الأَرضِ سيلَ فَخَبَّرا",48,"ر",2,0],["ما قُلِّدَ السَيفَينِ إِلّا نَجدَةً","وَالحَربُ توجِبُ أَن يُقَلَّدَ آخَرا",48,"ر",2,0],["ما قُلتُ لِلطَيفِ المُسَلِّمِ لا تَعُد","تَغشى وَلا كَفكَفتُ حامِلَ كاسِ",49,"س",1,0],["ماقَضى اللَهُ لِلجَهولِ بِسِترٍ","يَتَلافاهُ مِثلَ حَتفٍ قاضِ",50,"ض",1,0],["ما قَصَّرَت بِكَ هِمَّةٌ عَن هاشِمِ","لَولا اتِّقاءُ عُقوبَةِ الأَشرافِ",51,"ف",1,0],["ما قالَ مُعتَمِداً إِنَّ الغَمامَ حَكى","نَداهُ إِلّا غَبِيُّ الظَنِّ قَد وَهِما",52,"م",2,0],["ما قُلتُ إِلّا الحَقَّ تَعرِفُهُ","في القَولِ مُرتَجِلاً وَفي الشِعرِ",53,"ر",1,0],["ما قُلتُ إِلّا الحَقَّ أُخبِرُهُ","عَن أَهلِ بادِيَةٍ وَلا مِصرِ",54,"ر",1,0],["ما قالَ لا قَطُّ إِلّا في تَشَهُّدِهِ","لَولا التَشَهُّدُ كانَت لاءَهُ نَعَمُ",55,"م",1,0],["مَا قَالَ: لاَ قَطُّ، إلاَّ فِي‌ تَشَهُّدِهِ","لَوْلاَ التَّشَهُّدُ كَانَتْ لاَؤهُ نَعَمُ",56,"م",1,0],["ما قلتُ قَوَّاداً يِرُبُّ مِعِيشَه","لكنْ مساعدُ خِلِّهِ وأخيهِ",57,"ي",2,0],["ما قَدَّرَ اللَهُ لِي فَلَيسَ لَهُ","عَنّي إِلى سِوايَ مُنصَرِفُ",58,"ف",1,0],["ما قُلتُ في فَضلِهِ شَيئاً لِأَمدَحَهُ","إِلّا وَفَضلُ يَزيدٍ فَوقَ ما قُلتُ",59,"ت",1,0],["ما قُلتُ هَذا فيكَ إِلّا وَقَد","جَفَّت بِهِ الأَقلامُ مِن قَبلي",60,"ل",2,0],["ما قالَ ذو العَرشِ لَنا إِخزُنوا","بَل أَنفِقوا مِمّا رَزَقناكُمُ",61,"م",1,0],["ما قضينا ساعة في عرسه","وقضينا العمر في مأتمه",62,"ه",1,0],["ما قستُ نجدتَهُ بحدّةِ مِحْرَبٍ","إلا قضيتُ له بفضلٍ قاهِرِ",63,"ر",1,0],["ما قرّ بي السيرُ في سهلٍ ولا جبلٍ","إلّا كما قرّ جاري الماء في صَبَبِ",64,"ب",1,0],["ما قَبِلَت شِركَكَ يَوماً وَلا","كُفرَكَ إِلّا أَنَّها كافِرَه",65,"ر",2,0],["ما قاسَيا في المَجدِ إِلّا دونَ ما","قاسَيتَهُ في العَدلِ وَالتَوحيدِ",66,"د",1,0],["ما قضاءُ الشامِ إلا شرفٌ","ولمنْ يتركُهُ أعلى شرفْ",67,"ف",1,1],["ما قيِّمُ الحمَّامِ إلاّ فتنةٌ","للناسِ عاملةٌ على الأرواحِ",68,"ح",1,1],["ما قَالَ حِينَ صبا بلادي يَشتكي","أَلَم الهَوَى ويَضِجُّ من بُرحَائهِ",69,"ا",3,0],["ما قامَ شَعبٌ نامَ عَنهُ وُلاتُهُ","وَاِستَشعَروا التَفريطَ وَالإِهمالا",70,"ل",2,0],["ما قَدَّمَ الأَنواءَ فيما قَبلَهُ","إِلّا لِكَي يَلقاكَ وَهُوَ جَديدُ",71,"د",1,0],["ما قَليلٌ مِنكَ لي بِقَليلِ","يا مُنى نَفسي وَغايَةَ سُؤلي",72,"ي",1,1],["ما قَرَّ لي في لَيلَتي مَضجَعٌ","كَأَنَّني في كَفِّ طَبطابِ",73,"ب",1,0],["ما قَرّ أعيُنُ آلِ قُرّةَ مُذ سُقُوا","بكَ ما سُقُوهُ منَ الحَميمِ الآني",74,"ن",2,0],["ما قُلتِ ما قُلتُهُ إِلّا لِأُخجِلَهُ","وَلَو أَعَدتُ عَلَيهِ مِثلَهُ لَبَكى",75,"ك",2,0],["ما قامَ أَيرُ حِمارٍ فَاِمتَلا شَبَقاً","إِلاّ تَحَرَّكَ عِرقٌ في اِستِ تَنسيمِ",76,"م",1,1],["ما قُلتُ مِن سَيِّئٍ مِمّا أَتَيتَ بِهِ","إِذاً فَلا رَفَعَت سَوطي إِلَيَّ يَدي",77,"د",2,0],["ما قَرَّ طاسُكَ في كَفِّ المُديرِ لَهُ","إِلّا وَقُرطاسُكَ المَرعوبُ مَرعوبُ",78,"ب",1,1],["ما قُرَّةُ العَينِ ذاتُ الوِردِ مَعوِزَةٌ","وَغُيِّبَت عَن بَواكي الأَعيُنِ القُرَرُ",79,"ر",1,0],["ما قيلَ في عِظَمِ المَليكِ وَعِزِّهِ","فَاللَهُ أَعظَمُ في القِياسِ وَأَكبَرُ",80,"ر",1,0],["ما قُلتُ أُسرِيَ في لَيلٍ عَلى عَمَلٍ","أَدارَهُ اللَهُ وَالأَفلاكُ لَم تَدُرِ",81,"ر",1,0],["ما قيمَتي فَلسٌ وَفي حِكمِ","هِ أَنِيَ أودى أَلفَ دينارِ",82,"ر",1,0],["ما قدَّرَ اللَّهُ هو الغالبُ","ليس الَّذي يحسُبُهُ الحاسِبُ",83,"ب",1,1],["ما قلتُ حُبَيِّبي منَ التحقيرِ","بل يَعْذُبُ اسمُ الشيء بالتصغيرِ",84,"ر",1,0],["ما قامَ فينا حَكيم","يحل بعض القَضايا",85,"ي",2,0],["ما قامَ حتىّ أَثقلت","هُ من قوافيه القيود",86,"د",1,0],["ما قالَ كانَ إِذا ما القَومُ أَكذَبَ ما","أَطالَ مِن قَولِهِم تَقصيرُ ما فَعَلوا",87,"ل",3,0],["مَا قَالَ فَاحِشَةٌ وَلَمْ يَهْمُمْ بِهَا","يَوْمَاً وَلَم يُلْمِمْ بِأَمْرٍ رَابَا",88,"ب",2,0],["ما قَرَّ مِن شَوقٍ إِلَيهِمْ قَلْبُهُ","وَعَنِ الكِنَانَة لَم يَكُنْ بِالصَّابِرِ",89,"ر",1,0],["ما قَوْمُهُ القوْمُ الحُمَا","ةُ وَجِنْدُهُ الجُنْدُ الكثِيرْ",90,"ر",1,0],["ما قَاتَلُوه على ذَنْبٍ ألمَّ بِهِ","إلاّ الذي نَطَقُوا زُوراً وَلضمْ يَكُنِ",91,"ن",1,0],["ماقلب أمك إن تفارقها","ولم تبلغ أشدك",92,"ك",1,0],["ما قيلَ عَبدُ الغَنِيِّ إِلّا","ذُقتُ بِهِ غُصَّةَ الحِمامِ",93,"م",1,0],["ماقُكَ دامَ بِلا بُكاء","وَالثَغرُ بادٍ بِلا اِبتِسامِ",93,"م",1,0],["ما قُلتَ لِلشَّخصَينِ إِذ","سالاكَ عَمَّن فَطَرَك",94,"ك",1,0],["ما قالَ فرعونُ هذا في تجبُّرهِ","فرعونُ موسى ولا هامانُ طغيانا",95,"ن",2,0],["ما قيمةُ النَّفسِ إن هانَتْ لطائفةٍ","اللّه صَوَّرَ فيها الذُّلَّ والهُونَا",96,"ن",2,0],["ما قمت تعلن عن جهادك مرةً","أو تبتغي نظارةً وشهودا",97,"د",2,0],["ما قلدوهم مبصرين؛ وإنما","تَبِعُوا نظامَهمو بغير نظام",98,"م",1,0],["ما قال ربك: بالقبور تَمَسَّحُوا","بل قال -جلَّ جلالهُ-: «وقل اعملوا»",99,"ل",3,0],["ما قَذَفْنَا في البحر ماءك عذبًا","بل قذفنا في البحر بالأقوات",100,"ت",1,0],["ما قلقل الأرض إلا زاد غَلَّتها","ضعفين، فاعجب لهذا الهادم الباني!",101,"ن",2,0],["ما قَام أَيْرُ حمار فامْتَلاَ شَبقاً","إِلا تَحَرَّكَ عِرْقٌ في است تَسْنِيم",102,"م",1,1],["ما قامروا بالدين في سبل الهوى","كلا ولا تَخِذوا الشريعة متجرا",103,"ر",2,0],["ما قدرُ هذا الاحتفالِ وإنما","كلُ الزمان محافلٌ ونوادي",104,"د",2,0],["ما قالَ مُعتَمِداً إنّ الغَمَامَ حكَى","نَداهُ، إلاّ غَبيُّ الظّنّ، أوْ وَهَمَا",105,"م",2,0],["ما قاتل البطل النجيد غضنفر","إن الغضنفر من عصى شهواته",106,"ت",2,0],["ما قيل إن مع السمَّاك فضيلة ٌ","إلى تناولها عُبَيْدُ اللَّهِ",107,"ه",1,0],["ما قلتُ من سيءٍ مما أتيتَ به ،","إذاً فلا رفعتْ سوطي إليّ يدي",108,"د",2,0],["ما قطَّبتْ لي لي حاجباكَ فليتني","أدري وقيتُ الذمَّ لم عبساها",109,"ه",2,0]]}