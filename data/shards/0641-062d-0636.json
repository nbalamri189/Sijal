{"poems":[[90,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[264,"حمى السيد البكري حمى من به احتمى","https://www.aldiwan.net/poem35957.html","الطويل"],[469,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109856","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83356","الخفيف"],[4929,"مليكة اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=201110",""],[5410,"فحضارة الإسلام حصن صامد","https://www.poetsgate.com/ViewPoem.aspx?id=73563",""],[5550,"رجوع حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=215208",""],[5842,"سورية ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=66279",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5309,"هي الأخلاق تنبت كالنبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573769",""]],"verses":[["فحضن الأم مدرسة تسامت","بتربية البنين أو البنات",0,"ت",1,0],["فحضرته العليا ومجلس ذكره","يخلّص قلب الصبّ من ربقة العمى",1,"م",2,0],["فحضَّنتَ منهُ بالرَّدى ذلك الحمى","وحسَّنتَ منهُ بالندى منظراً جهما",2,"م",2,0],["فَحضر العدول دار القاضي","وَشَرَحوا فَكانَ ذا اِمتِعاض",3,"ض",1,0],["فحضرت تكريماً لناظم عقدها","وجعلت عنوان الجواب لها انا",4,"ن",2,0],["فحضوري وَغيبَتي مِن شُهودي","لحَبيبي إِذا اِنجَلى مجلاهُ",5,"ا",2,0],["فحضَنْتِ قرآناً قوارعُ آيِهِ","تَهوِي لرهبَتِها ذُرا الأَعلامِ*",6,"م",1,0],["فحضارةُ الإسلامِ حُصْنٌٌ صامِدٌ","ومَنَارةٌ يرجو الورى إِلهامَها",7,"م",3,0],["فحضنُ حبيبي كثيرُ العطاء","ووجْهُ حبيبي كثير البهاء",8,"ا",2,0],["فَحَضّرْ كِذْبَكَ الواهي لِرَبٍّ","وموعِدُنا غداً يومَ اللقاءِ",9,"ا",2,0],["فحضنكِ يا مصر نهر الأمان","تصب عذوبتها الفاخرة",10,"ر",2,0],["فَحِضنُ الاُمِّ مَدرَسَةٌ تَسامَت","بِتَخريجِ الأَساتِذَةِ الثِّقاتِ",11,"ت",1,0]]}