10,"في جزيرة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=132534",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5431,"ياقلبُ هل نسيَ الورى؟","https://www.poetsgate.com/ViewPoem.aspx?id=193974",""],[5470,"كتبتُ عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=10983",""],[5510,"مرايا الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=206318",""],[5612,"ماذا جَرى لكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179543",""],[5674,"خذلان عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=189081",""],[5674,"الحزن حبر دواتي","https://www.poetsgate.com/ViewPoem.aspx?id=189930",""],[5736,"ماذا جنينا","https://www.poetsgate.com/ViewPoem.aspx?id=208202",""],[5737,"ثائر أمام البحر!","https://www.poetsgate.com/ViewPoem.aspx?id=198442",""],[5742,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=206974",""],[5758,"أحلام مؤجلة","https://www.poetsgate.com/ViewPoem.aspx?id=200524",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5861,"أكان بوذيا قاتلي يا ترى ..أم انه قد كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=191503",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5943,"غمد الحريق","https://www.poetsgate.com/ViewPoem.aspx?id=41601",""],[5956,"من أعاجيب السنين","https://www.poetsgate.com/ViewPoem.aspx?id=194807",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6005,"إصطفي خلف الأخريات","https://www.poetsgate.com/ViewPoem.aspx?id=161459",""],[6070,"ماذا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=187868",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6093,"موؤودة","https://www.poetsgate.com/ViewPoem.aspx?id=190794",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[6152,"المساء الخصيب","https://www.poetsgate.com/ViewPoem.aspx?id=203034",""],[6152,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=203967",""],[6152,"يا ليل أوقد ماتشاء بخافقي","https://www.poetsgate.com/ViewPoem.aspx?id=203990",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[6203,"نصائح عاشق عتيق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88023&r=&rc=1",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[5355,"وجع الخيانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87231&r=&rc=56",""],[6211,"أوّاهُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78539&r=&rc=0",""],[6248,"ندامى الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86022&r=&rc=3",""]],"verses":[["ماذا جرى... يا أبا تمام تسألني؟","عفواً سأروي.. ولا تسأل.. وما السبب",0,"ب",1,0],["ماذا جَنَيْتَ عليّ منْ مَضَضِ الهَوى","اللهُ يُنْصِفُ منْكَ يا قَوّادي",1,"ي",1,0],["مَاذَا جَنَيْتُمْ عَلَى نَفْسِي بِبُعْدِكُمُ","وَأَنْتُمُ الأَهْلُ وَالأَحْبَابُ وَالْعَصَبَهْ",2,"ه",1,0],["ماذا جنى بعدكَ من صرفهِ","لنازح أوحشَ من فقده",3,"د",2,0],["ماذا جرى للخلقِ خوفاً على","مهجته من أدمعٍ طافيه",4,"ف",3,0],["ماذا جنى البينُ لنا ساقَهُ","سَمِيُّهُ البينُ إلى المَعْطبِ",5,"ب",1,0],["ماذا جَنَيتَ عَليهِم أَيُّها القَلَمُ","وَاللَهِ ما فيكَ إِلّا النُصحُ وَالحِكَمُ",6,"م",1,1],["ماذا جَنَينا كَي تُفارِقَنا","أَملَلتَنا وَسَإِمتَ صُحبَتَنا",7,"ن",2,0],["ماذا جنيتُ من الحَيَاةِ","ومن تجاريبِ الدُّهُورْ",8,"ر",1,0],["ماذا جرى حتى تهيّج","هكذا البلد الوديع",9,"ع",1,0],["ماذا جنيت على أب","شيخ بدمع ليس يرقا",10,"ق",2,0],["ماذا جَنى الوَفدُ إِلّا ما يُقالُ لَكُم","اللَهُ أَكبَرُ جَدَّ الأَمرُ فَاِستَبِقوا",11,"ق",3,0],["ماذا جَزَاكَ اللَّهُ من رِضوانِه","وحَبَاكَ في الفردوسِ من نُعماهُ",12,"ا",2,0],["مَاذَا جَنَيْتُ عَلَى الْعُلَى","فيَنَالَنِي هَذَا الْعِقَابُ",13,"ب",1,0],["مَاذَا جَنَاهُ وَلَمْ يَكُن مُتَوَقَّعاً","قَدَرٌ تَغَيَّرَ فِي قِصَارِ دَقَائِقِ",14,"ق",1,0],["مَاذَا جَمَعْتَ مِن البَدَا","ئِعِ وَالرَّوَائِعِ فِي سُطُورِ",15,"ر",1,0],["ماذا جرى لممالكي وبيارقي","أدعو رباب فلا تجيب رباب",16,"ب",1,0],["ماذا جنيتِ سِوَى الدِّفَا","ع عن الحَلائل والحَصيد؟",17,"د",1,0],["ماذَا جنيتَ من الدُّنُو","بِ سِوى الدِّفاع عن الحريم؟",18,"م",1,0],["ماذا جرى ..؟ لم يجر شيء هنا","صنعاء لا فرحى ولا آسفه",19,"ف",2,0],["ماذا جرى ..؟ لا حسّ عما جرى","ولا لديه ومضة هادفه",19,"ف",2,0],["ماذا جنيت عليهم ، أّها القلم","والله ما فيك إلاّ النّصح والحكم",20,"م",1,1],["ماذا جنينا كي تفارقنا","أمللتنا وسئمت صحبتنا",21,"ن",2,0],["ماذا جَنَيْتُ لأسْتحق جَفاءكُمْ","مَنْ دا من الواشين غيَّرَ عهدَنَا",22,"ن",2,0],["ماذا جَنى الحسونُ في جُنحِ الدُجى","حَتّى أُصيبَ بِسَهمِ ذلِكَ الأَسفَعِ",23,"ع",1,0],["ماذا جنيتم سوى أعراض امتكم","عنكم وغير شماتات الحكومات",24,"ت",1,0],["ماذا جَناهُ كِتابي فاستَحقَّ به","سِجناً طَويلاً وتَغييباً عَنِ الناسِ",25,"س",1,1],["ماذا جزاؤهمُ منّي اعاينهمْ","صَرْعَى ولم أقضِ اِشفاقاً ولا جَزَعا",26,"ع",2,0],["ماذا جَنَتْه ليلةُ التّعريفِ","شغفتْ فؤاداً ليس بالمشغوفِ",27,"ف",1,1],["ماذا جَلَبتِ لنا يا ليلةَ العيدِ","غيرَ البُكاءِ لأمرٍ غيرِ مردودِ",28,"د",1,1],["ماذا جنيت ليضرم النيران في","كبدي وشر النار في الأكباد",29,"د",1,0],["ماذا جنيتِ على قلبي من التّرَحِ","ومن غُموم الهوى يا ليْلةَ الفَرَحِ",30,"ح",1,1],["ماذا جنى جار عليهم مشفق","كم بات وهو العائل المفدوح",31,"ح",1,0],["ماذا جرى هل أرهبوا أحداً","منا فأدبر منهمُ ذعرا",32,"ر",2,0],["ماذا جناه المسلمون وهذه","يدهم على الأمم المسيحيّات",33,"ت",1,0],["ماذا جناه المسلمون عليكمُ","وهمُ على الأمصار غلّابونا",34,"ن",2,0],["ماذا جنيت من الشبابِ","حاشا التمرس بالعذابِ",35,"ب",1,1],["ماذا جرى يا جيرتي حتى غدا","حبل المودة المودة بيننا متقطعا",36,"ع",2,0],["ماذا جنيت وقلبي طاهرٌ ويدي","نقيّة وحديثي جدّ موزون",37,"ن",1,0],["ماذا جرى لك والأيام باسمةٌ","والله أعطاك فضل النّور نورين",38,"ن",1,0],["ماذا جرى بعد الفراق تذكّريال","ماضي يلوح لنا قريب المخبر",39,"ر",1,0],["ماذا جرى لأبي إلى الأرض ائتوى","وأخي المفدّى قرب والده ثوى",39,"ث",3,0],["ماذا جرى؟ والكَوْنُ مُؤتَلِقُ السنَّى","بمشاعِرٍ تَقْوى على كِتْمَانِهِ",40,"ن",2,0],["ماذا جمالٌ هذه فتنةٌ","ماذا هوى يا قومُ هذا جنون",41,"ن",1,0],["ماذا جنتهُ اللَّيالي","فيما جلبنَ إِلينا",42,"ن",2,1],["ماذا جرى بيني وبينك ودار","والله بذا عالم وداري",43,"ي",1,0],["ماذا جنى الشرقي من بعد ما","سقاه عذب العلم من نهره",44,"ر",2,0],["ماذا جنيت? وماذا يا ترى اقترفت","يداي في الحب من ذنب وأوزار?",45,"ر",1,0],["ماذا جرى لحليف الدار يهجرها","حتى غدا اليوم ديّاراً بلا دار?",45,"ر",1,0],["ماذا جنيت لكي تعذبني الظبا","وتذيبني بالهجر والتسهيد",46,"د",1,0],["ماذا جرى غير أني","عفت القبيح وعبت؟",47,"ت",1,0],["ماذا جناه فيؤوى","سجنا ويترك داره",48,"ر",2,0],["ماذا جرى هل زفير العاشقين له","في ورد خديك فعل الريح في الزهر",49,"ر",1,0],["ماذا جرى لي حتى الدهر غيرني","وكان لي جرُّ ذيل في مغانيها",50,"ه",2,0],["ماذا جنينا عليكم يا أحبَّتنا","حتى تكون جزاء منكم النقم",51,"م",1,0],["ماذا جنى أبناء رومة بعدما","شالت نعائمهم بكل مكان",52,"ن",1,0],["ماذا جرى حتى تركت أحبة","حفظوك في سر الفؤاد وفي العلن",53,"ن",1,0],["ماذا جَنيتَ مِن الحَياة","فَالوقت فات",54,"ت",1,1],["ماذا جوابي إن رجعت إلى حما","ة بزوجتي من بعد غربة عام",55,"م",1,0],["ماذا جنتْ قلوبنا حتى غدا","في النار من شوقكم خلودها",56,"د",3,0],["ماذا جَرى لَيْسَ يَدْرِي ما جَرَى احَدٌ","مِمَّنْ تَفِيضُ عَلَى أَبْوابِهِ النِّعَمُ",57,"م",1,0],["ماذا جَنى لحظي على واحِدي","بلحظةٍ من واحدِ الحُسنِ",58,"ن",1,0],["ماذا جنت عينٌ بلحظتها","ويدي فلا بقيت عليَّ يدي",59,"د",2,0],["ماذا جرى والقلب ذو شجن","أجعلت لي في دربنا ندا",60,"د",2,0],["ماذا جَرى يا صُبْحَ أَحلامِنَا","ماذا جَرَى باللهِ ماذا جَرَى!",61,"ر",2,0],["ماذا جَرَى؟! أَنَمُوتُ ثانِيَةً","لِنَصُدَّ بالعَبَرَاتِ قَذَّاذا؟!",62,"ذ",2,0],["ماذا جَرَى؟ وارْتَدَّ صَوتِي عَلى","أعقَابهِ كالسَّهْمِ.. ماذا جَرَى؟!",63,"ر",2,0],["ماذا جَنَيتُ مِن الحُرُوبِ وأَهلِها","غَيرَ التِهَابِ القَلبِ والقُولُونِ!",64,"ن",1,0],["ما ذا جرى في (الحيدرية) يا تُرى","قالوا: استبيحت بالدما (سيهاتُ)",65,"ت",1,1],["ماذا جرى يا أيها القلمُ","قد كنتَ في الأفراح تبتسمُ",66,"م",1,1],["ما ذا جنَوا من غيرها إذ أبحروا","والشَّملُ منهم تائهٌ ومُبدد",67,"د",1,0],["ماذا جنى هذا الوليد لكي يرى","منكِ الجفاءَ ويُحرمَ الإحسانا؟",68,"ن",2,0],["ماذا جَنَيتُ لكي تُحطمَّ خافقًا","بين الضلوعِ يجاورُ الأتراحا؟!!",69,"ح",2,0],["ماذا جرى؟غادرتَني فجأةً","ما فهْتَ لي حتى 