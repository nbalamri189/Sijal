{"poems":[[73,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[107,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[107,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[83,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[50,"يا ربة الوجه الجميل","https://www.aldiwan.net/poem65029.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[92,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[189,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[366,"أبدا تحن اليكم الارواح","https://www.aldiwan.net/poem68126.html","الكامل"],[495,"الخل راضٍ شاكرٌ في عهده","https://www.aldiwan.net/poem653.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138247",""],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/199302","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56599","السريع"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202167","الكامل"],[4797,"العام اخذت البيرق","https://www.poetsgate.com/ViewPoem.aspx?id=78478",""],[5453,"أنتي خيال","https://www.poetsgate.com/ViewPoem.aspx?id=28018",""],[5525,"رسالة من بدوي","https://www.poetsgate.com/ViewPoem.aspx?id=906",""],[5525,"عض النواجذ","https://www.poetsgate.com/ViewPoem.aspx?id=950",""],[5732,"يبعد هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177894",""],[5756,"أول الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=5365",""],[5756,"كلمة حق","https://www.poetsgate.com/ViewPoem.aspx?id=5380",""],[5756,"الدعاء المستجاب","https://www.poetsgate.com/ViewPoem.aspx?id=5381",""],[5956,"إلى الله تعالى كل فعل يصعد","https://www.poetsgate.com/ViewPoem.aspx?id=192595",""],[5956,"إخلاصُك المعروفُ عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194138",""],[5956,"أشرف النافع للناس","https://www.poetsgate.com/ViewPoem.aspx?id=194177",""],[5956,"الخير أجمعُه صديقي المنتظِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=194286",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[6115,"رجل كما الصقر يطلع فوق","https://www.poetsgate.com/ViewPoem.aspx?id=181733",""],[6115,"أذا نظمت القصيد ابدع بيوت جزال","https://www.poetsgate.com/ViewPoem.aspx?id=196456",""],[402,"يا من بكى والخطب جد أليم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54088&r=&rc=940",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["اللَهُ خَصَّكَ بِالمَمالِكِ وَاِجتَبى","لَمّا رَآكَ لَها الصَلاح الأَكبَرا",0,"ر",2,0],["الله خَصمُكَ والرّسولُ فَزِدْهُما","حرباً ولا تُؤذِنْهما بِسلامِ",1,"م",1,0],["اللَهُ خَوَّلَكِ النُعمى الَّتي عَظُمَت","هَل يَسلُبُ اللَهُ نُعمى بَعدَ تَخويلِ",2,"ل",1,0],["اللَّهُ خَصْمُكَ يا ابن قيسٍ إنّه","سَهْمٌ أُصيبَ به التَقِّيُّ الأروَعُ",3,"ع",1,0],["اللَهُ خَوَّلَ مِنهُ آجامَ العُلى","لَيثاً وَآفاقَ الرِئاسَةِ كَوكَبا",4,"ب",2,0],["اللَهُ خَلَّصَني وَرَأ","يُ الفَضلِ مِن حَلَقِ الكُبولِ",5,"ل",1,0],["الله خير خلقه أعطاها","وحمل الأمر العظيم طه",6,"ه",1,0],["اللهُ خَلقَ الشُّعوب سواسيًا","لا رَبَّ بينهمو ولا مربوبا",7,"ب",2,0],["ألله خلفك والجدود كلاهما","وكفاك عون الله والأجداد",8,"د",1,0],["الله خَصَّك في الكمال برتبةٍ","لم ينفتح لسواك مُغْلَقُ قُفْلِها",9,"ل",3,0],["اللَهُ خَصَّكُم بِأَشرَفِ رُتبَة","العَجز عَن عقد لَكم وُشاح",10,"ح",1,0],["اللَهُ خَوَّلَهُ حَياةً ما لَها","كَدَرٌ وَعَيشاً طابَ في الأَلواذِ",11,"ذ",1,0],["الله خصك بالصلاح وسابقا","خص الإله به أبا وخلودا",12,"د",2,0],["الله خلّصني منهم وفلسفتي","حتى تخلّصت مخضوب السراويل",13,"ل",1,0],["الله خصهم بها واختارها","لهم وقد أبدت لنا أسرارها",14,"ه",2,0],["الله خلاق الورى عادلٌ","فلا يلومَنْ غيره من ظلم",15,"م",1,0],["اللهُ خَصَّك بالثَّناءِ فثَوْبُه","لك مَلْبَسٌ لا المُعْلَم المَلْبوسُ",16,"س",1,0],["الله خلقنا سيلٍ متونه هضاب","كل السدود يحطها حبٍ دقيق .!",17,"ق",1,0],["الله خلقنا وان وجد بيننا فروق","فعلك بهالدنيا يرجح حسابك",18,"ك",1,0],["الله خلقني وكلمة الحق بوفوق","وملكت الأرض .. ( وراس مالي .. عاصاتي )",19,"ت",2,0],["الله خلقنا .. تلفح وجيهينا لفح","حر السمايم في عزيز المطالب",20,"ب",1,0],["الله خلق صافي جبينه وسواه","ومكمله بالزين والملح والتيه",21,"ي",2,0],["الله خلقنا للعداوات عدوان","وصدورنا تبرى بطعن السكاكين",22,"ن",1,0],["الله خلق صرح البطوله للابطال","وماللرياده عرش من غير رايد",23,"د",1,0],["الله خلق للضيق باب وللفرج مليون باب","ينزل بلاءه لو يشاء ولو يشاء بيرفعه",24,"ع",2,0],["الله خلقنا للظروف المفزعه خوّة ذياب","ولا تبان الخوّة إلا بالظروف المفزعه",24,"ع",2,0],["الله خيرٌ حافظاً لمجاهدٍ","بسبيلِ عرشك يا إله مجنَّدُ",25,"د",1,0],["الله خصصكم لأجل هنائنا","لنظلَّ نشهدُ من يديك فوائدا",26,"د",2,0],["الله خصصه لنفع شاملِ","كالنيل للأجيال في المتناوَلِ",27,"ل",1,1],["الله خصَّص لي أعزَّ صداقةٍ","هي خيرُ رزقٍ من كريمٍ منتصِرْ",28,"ر",1,0],["الله خصصكم للناس قاطبة","لاسيَّما لشريدٍ عن ثراه جََلا",29,"ل",2,0],["اللهُ خصَّص ذِهْنَه مَوسوعةً","حضريةً منها التقدُّمُ دائبُ",30,"ب",1,0],["الله خصص حبها وحنانها","لي والبنين بكل طهر نوايا",31,"ا",3,0],["الله خلق بالعباد فروق","ورجال في كل وقت رجال",32,"ل",1,0],["الله خلقني كذا ماحب كثر الجدال","والكاذب اشرشحه والصادق اقدرْه",33,"ر",2,0],["الله خير للوديعة حافظا","هل من أب كأبي الوجود رحيم",34,"م",1,0],["اللهُ خصَّك في الكتابِ مُبشِّراً","إذ أنزلَ التّوراةَ والإنجيلا",35,"ل",2,0]]}