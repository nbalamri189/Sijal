{"poems":[[55,"هل كان يومك إلا بعد أيام","https://www.aldiwan.net/poem29754.html","البسيط"],[29,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[29,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[47,"بسماحك المستقبل المستدبر","https://www.aldiwan.net/poem63568.html","الكامل"],[47,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[99,"قدر أراد شقاءنا","https://www.aldiwan.net/poem24939.html","مجزوء الكامل"],[99,"أبي أخي كعبة آمالنا","https://www.aldiwan.net/poem24966.html","السريع"],[46,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[46,"رأيت في النوم أن الصلح قد فسدا","https://www.aldiwan.net/poem30264.html","البسيط"],[83,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[42,"يا ليت شعري هل يخبر الطلل","https://www.aldiwan.net/poem42321.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[108,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[164,"أعلي ترجف بالوعيد وتوجف","https://www.aldiwan.net/poem58672.html","الكامل"],[234,"بك من بعادك أستجير","https://www.aldiwan.net/poem51063.html","مجزوء الكامل"],[240,"مولاي فخر الدين أنت إلى الندى","https://www.aldiwan.net/poem31588.html","الكامل"],[353,"قد كدت أقطع يوم عيدى طاويا","https://www.aldiwan.net/poem20012.html","الكامل"],[369,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[415,"أنظر إلى صرف دهري كيف عودني","https://www.aldiwan.net/poem32020.html","البسيط"],[469,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[473,"يا أيها الرشا الريب الذي","https://www.aldiwan.net/poem59717.html","السريع"],[572,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122766","الكامل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138980",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110403","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97047","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96979","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48533","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38208","البسيط"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90552","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56333","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109274","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79791","الكامل"],[1658,"","https://poetry.dctabudhabi.ae/diwan/poem/198495",""],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48224","البسيط"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69470","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67216","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67242","الكامل"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95998","الرجز"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131727",""],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105325","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109857","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204653","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115803","الكامل"],[3071,"","https://poetry.dctabudhabi.ae/diwan/poem/34876","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62975","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48331","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108105","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91867","البسيط"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142882","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111435","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36472","الدوبيت"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123489","الكامل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45926","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111197","الكامل"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103308","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117283","الكامل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105166","البسيط"],[4767,"غارة الذئاب","https://www.poetsgate.com/ViewPoem.aspx?id=178790",""],[5155,"يا دنيا ..!","https://www.poetsgate.com/ViewPoem.aspx?id=176238",""],[2365,"وحارس غفلة حرّاسه","https://www.poetsgate.com/ViewPoem.aspx?id=200644",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5689,"باتت تناجيك خلف اليم في الغمم","https://www.poetsgate.com/ViewPoem.aspx?id=143421",""],[5703,"جاءتْكَ زائرةً","https://www.poetsgate.com/ViewPoem.aspx?id=207960",""],[5355,"حبٌّ فرديٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87214&r=&rc=39",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[6336,"العابسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73550&r=&rc=11",""],[572,"نَفْسِي الفداءُ لِمَنْ يُخَالفُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9424&r=&rc=281",""],[572,"أطْلْق عِقَاَل الرُّوحِ بالرّاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9219&r=&rc=76",""]],"verses":[["قَد كِدتُ أَعقِلُها لَولا مُحافَظَةً","عَلى يَدٍ سَلَفَت مِنهُ وَإِنعامِ",0,"م",1,0],["قَد كُدتُ إِنَّ فُراقَ الحَيِّ يَشعَفُني","أَنسى عَزايَ وَأُبدي اليَومَ أَسراري",1,"ر",2,0],["قَد كِدتَ يَومَ قُشاوَتَينِ مِنَ الهَوى","تُبدي شَواكِلَ سِرِّكَ المَكتومِ",2,"م",1,0],["قَد كُدتُ أَغرَقُ تَحتَهُ لَولا الصَبا","شالَت بِجانِبِهِ وَرَكضُ الأَشقَرِ",3,"ر",1,0],["قَد كِدتُ أُخرِجُهُ عَن مُنتَهى عَدَدي","يَأساً وَأُسقِطُهُ إِذ فاتَ مِن بالي",4,"ل",2,0],["قد كدت أكفر بالهوى","لو لم أكن بك مؤمنا",5,"ن",2,0],["قد كدت لولا ثقة لا تهي","وخشية الله وتقواه",6,"ا",2,0],["قَد كِدتُ أَن أَنسى ظِماءَ جَوانِحي","مِن بُعدِ شُقَّةِ مَورِدي عَن مَصدَري",7,"ر",2,0],["قَد كِدتُ أَحلِفُ إِلّا أَنَّ ذا سَرَفٌ","أَلّا أَذوقَ مَناماً بَعدَها أَبَدا",8,"د",2,0],["قَد كُدتُ أَن أَعشَقَ التَجَنّي","لِأَنَّهُ عِندَهُ صَلاح",9,"ح",1,0],["قَد كِدتُ أَقضي غَداةَ بَينِهِمِ","لَمّا تَنادوا في الصُبح وَاِحتَمَلُوا",10,"ل",3,0],["قَدْ كِدْتُ أُتْهِمُ ظَنِّي فِي فِرَاسَتِهِ","مِنْ طُولِ مَا اشْتَبَهَتْ عَيْنَايَ فِي الصُّوَرِ",11,"ر",1,0],["قَدْ كِدْتُ أَقْضِي حَسْرَةً لَوْ لَمْ أَكُنْ","مُتَوَقِّعَاً لُقْيَاكِ يَوْمَ مَعَادِي",12,"د",2,0],["قد كدتُّ أخلَعُ -إذ نَزَلْ","تُ بِقُدْسِ واديها - نِعَالي",13,"ل",2,0],["قد كدتُ أُنهِكهُ معاقَبةً","لولا ادّكارى حُرمَة الرُّسْلِ",14,"ل",1,0],["قد كدت لولا الحلم راجع صولتي","أجزيك والخلق الكريمة تعطف",15,"ف",1,0],["قد كِدتُ لَمَّا أن رحل","تُ إليك من شوقي أطير",16,"ر",1,0],["قَد كَدَّرَت حِسّي المُضيءَ وَغَيَّرَت","طَبعي السَليمَ وَعَفَّنَت أَخلاطي",17,"ط",2,0],["قَدْ كِدْتُ أَقْطَعُ يَومَ عِيدِى طَاوِياً","وأَعِيشُ دُونَ النَّاسِ بالتَّسبيحِ",18,"ح",1,1],["قد كِدْتُ أخْتِمُ طَرْفي وَحْشةً لكُمُ","عن كلِّ خَلْقٍ من الدُّنْيا أُلاقيه",19,"ي",2,0],["قد كِدتُ أعْفَنُ من طُولِ الثَّواء كما","يُصدي المهنَّدَ طولُ المَكثِ في الخِلَلِ",20,"ل",1,0],["قد كدت أغرق في بحار مدامعي","لولا التمسك فيك بالآمال",21,"ل",1,0],["قَد كَدَّرَ العَيشَ ثَمودُ القِلى","فَاِبعَث عَلَيهِ صالَحَ الوَصلِ",22,"ل",1,0],["قد كَدَّتِ الحِكْمَةُ رُوحي فَرَوْ","وِحْهَا بِأوْتَارٍ وأقداحِ",23,"ح",1,0],["قَد كِدتُ أَقضي مِنكِ مَأرَبَةً","لَولا العَفافُ وَآيَةُ الرَّجمِ",24,"م",1,0],["قد كدت أنك لا تسميك الورى","قلبا لكونك عنه لا تتقلب",25,"ب",1,0],["قد كدَّرت غِيَرُ الأَيَّام مَورِدَنا","وبدّل الدهر مانرجوهُ من أمَلِ",26,"ل",1,0],["قد كدت أهلك في غرامك قانطاً","لولا رجائي بعض ما أوليته",27,"ت",2,0],["قد كدت لولا الحلم من جزعي لما","ألقاه اصفق بالشمال يمين",28,"ن",1,0],["قد كدر الدهر بعد الصفو مورده","فالكل ما بين ظمآن وغصّان",29,"ن",1,0],["قَد كِدتُ أَهلكُ مِن خَوفٍ وَمِن رعب","مِنَ الوَقارِ الَّذي يَعلوكَ زاهيهِ",30,"ي",2,0],["قد كِدتُ لولا وصفُ إسلامِه","ألعنُه لعناً يَسومُ البَوار",31,"ر",1,0],["قد كدت أن أقضى أسىً","من هول هذا المصرعِ",32,"ع",1,0],["قد كدت أكسرُ بنكهم وأعود","غانمة ولكن آه لو تركوني",33,"ن",2,0],["قد كدَّرت منها المشاربَ عُصبةٌ","جعل الإِلهُ من السرابِ شرابها",34,"ب",3,0],["قد كدت أحسبه من حرّه سقراً","لو لم يطف بي من الوِلدان من طافا",35,"ف",2,0],["قد كدتُ لم أسْلُها ما عشتُ من شغفٍ","لولا هِزَبْرٌ منَ الساداتِ مِفْضالُ",36,"ل",1,0],["قَد كِدتَ تَقضي عَلى فَوتِ الشَبابِ أَسىً","لَولا تَعَزيِّكَ أَنَّ العَيشَ مُنقَطِعُ",37,"ع",1,0],["قد كدتُ أخفي في هواه من الضنا","لولا لظى نفسي بفرط هواه",38,"ا",2,0],["قد كدتُ أشرقُ بالمعين صبابةً","لو لم يكنْ فيه جمالك يُشرق",39,"ق",1,0],["قد كدمَ الشيبُ قفاه فكدم","شيخ لنا معاودٍ ضَربَ البُهَم",40,"م",1,0],["قدك داري بصنع احمد إذا قد","معه شي في الخراطه ما بوده",41,"د",2,0],["قد كدت من جزع أقضي لرحلتهم","وزاد فرط عنائي عند هجرتهم",42,"م",1,0],["قد كدت من عظم وخمي","ارى الرسول جميلا",43,"ل",2,0],["قد كدت أحسب الطلا نبية","لما رأيتها تربي الهمجا",44,"ج",2,0],["قد كدتُ أقضى حسرة وصبابة","لما رأيتُ تعانقَ الأغصان",45,"ن",1,0],["قد كدت مما نالني في الهوى","أخفى على أعين عُوّادي",46,"د",2,0],["قد كدت من شُغلي بكم وفَيكري","أَنساكم من كَثرة التذكرِ",47,"ر",1,0],["قد كِدتُ أذْهَبُ لوعةً لو لمْ تَجُدْ","بالوَعْدِ أنّا عن قَريبٍ نَلْتَقي",48,"ق",2,0],["قد كدتُ أحرز ضمة من خصره","وأروح بين نهوده والمعطف",49,"ف",1,0],["قَد كدتُ وَاللَهِ أَن أَشكو الزَمان بِما","أَبداه من جهله إِذ كانَ يعلمني",50,"ن",2,0],["قد كدتُ أصبو لهنْ لولا عهودُ هوى","قطعتُهن لإلفٍ حلَّ في (العَينِ)",51,"ن",1,0],["قد كِدتُ أَفتُكَ ظافراً بأَخِي الخَنا","فإذا بِعَضبي طارَ في كَسَراتِهِ",52,"ت",2,0],["قَد كِدتُ من الوصال أَقضي وطَراً","لكن شَقي الجدُّ وَحال الواشي",53,"ي",1,0],["قد كدت لولا رجاك أنى","أيأس اذ بالخطا أصر",54,"ر",1,0],["قد كدت أيأس من دوا دائى بها","لو لم أجد في وفر فضلك لى رجا",55,"ج",2,0],["قد كِدتُ أَجزَعُ لَو يُفيدُ وَإِنَّما","الصَبرُ أَحسَنُ ما إِلَيهِ يُرجَعُ",56,"ع",1,0],["قد كدت أسرق وردها من خدها","لو كنت أأمن في الحراسة خالها",57,"ل",3,0],["قد كدتُ أن أقضي من هجره","وحُقَّ للمهجور أن يقضي",58,"ض",2,0],["قد كدت يوم فراقهم أفنى اسى","لولا التأسى منهم برجوع",59,"ع",1,0],["قد كدت أقضي أسى لما نظرت إلى","حمولكم تقرن الأعناق بالخبب",60,"ب",1,0],["قد كدَّرت صفوَ باغٍ","فانهار يهوي اختلاجا",61,"ج",2,0],["قد كدت أيأس من وصالك","وأذيب عمري في سؤالك",62,"ك",1,1],["قد كدّر اللهو وأيامه","حلم على جهلك مردود",63,"د",1,0],["[ قَدْ كِدْتُ أُصْعَقُ يَوْمَ آنَ رَحِيلُها","فَرَقاً وَكادَتْ فِيهِ رُوحِي تَتْلَفُ ]",64,"ف",1,0],["قد كدت أقضي أسى لولا غطارفة","هبو أمامي في أنجالك البهم",65,"م",1,0],["قد كُدْتُ منْ كَتمِ آهاتي أمُوتُ هوىً","لولا رأيتُ حَمامَ الدوحِ يَرويها",66,"ي",3,0],["قدْ كدَّسَ كلَّ دفاترَهُ","بقصائدِ عشقٍ منثورةْ",67,"ر",2,0],["قد كدتُ أنكرُ شعري حين حاولهُ","مني وحاشاك أملاكٌ بلا همم",68,"م",1,0],["قد كدَّر الغيظُ فواً من محاسنها","وأطفأ النورَ من لحظٍ لها ألِق",69,"ق",1,0],["قد كدتُ أجفوه لأَغْرِيَهُ","بخلافِ ما اختارَ فيصِلْ",70,"ل",1,0],["قَدْ كَدَّتِ الحكمَة ُ روحِي فَرَوْ","وَحْهَا بآثارٍ وأَقدَاحِ",71,"ح",1,0]]}