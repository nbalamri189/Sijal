{"poems":[[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[53,"سئل الأير ما تريد إلى الكعثب","https://www.aldiwan.net/poem65932.html","الخفيف"],[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[406,"تونس الخضراء","https://www.aldiwan.net/poem10308.html","عموديه"],[408,"بحب المصطفى المختار","https://www.aldiwan.net/poem46953.html","مجزوء الوافر"],[447,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70798","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78172","الكامل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130590","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202146","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94309","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203052","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143038","المتقارب"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35416","الطويل"],[4912,"جزى الله خيراً والجزاء بكفه","https://www.poetsgate.com/ViewPoem.aspx?id=181786",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""]],"verses":[["هُمُ ذَخَروا أَعمارَهُم لِسُيوفِهِ","فَأولى لَها وَالحَربُ عَذراءُ ناهِدُ",0,"د",1,0],["هَمُّ ذاك العِناقُ والنيكُ هَمّي","وكلانا في شأنه ليس يَغفُلْ",1,"ل",1,0],["هُمُ ذخَرُوا الأعمارَ والمالُ عندَهمْ","لكفِّك تُفنِي ذخرَهمْ وتُنيلُ",2,"ل",1,0],["هُمُ ذَبَّبوا عَن عَظمِ دينِ مُحَمَّدٍ","بِأَسيافِهِم إِذ لَيسَ فينا مُذَبِّبُ",3,"ب",1,0],["همْ ذئابٌ وضباعٌ ، كيف يصفو","عيشُ منْ ولَّى ذئاباً وضباعا",4,"ع",2,0],["هُمُ ذخري إذا مسَّتْني","البأساءُ والضَرّا",5,"ر",2,0],["هم ذروة الخلق فمن آدم","حتى انقضى عمر بني آدم",6,"م",1,0],["هم ذللوا عاصيات البلا","د وحلوا ذوائبها والنجودا",7,"د",2,0],["همْ ذوو المجد والمكارم والمع","روف والحمد والعقولِ الكبار",8,"ر",1,0],["هُم ذُروة العَلياء إِلا إِنَّهُم","بِهِمِ الإِمامِ الشَهم قُرة ناظِري",9,"ر",2,0],["هم ذوو النور والهدى ومدى","الأمر وأهل البرهان والعرفانِ",10,"ن",1,0],["هم ذئاب بخراف عبثوا","وخراف بذئاب يفخرون",11,"ن",1,0],["هم ذو والهمة هم حرب الهدى","أيد الله تعالى خربه",12,"ب",2,0],["هم ذووها إن أطعمتهم وإلا","قطعوها فعذبت بالنار",13,"ر",1,0],["هم ذَيَّلوني بخيرٍ مُلحَقٍ بنَدىً","يُروِي الصَدَى وَهوَ وافٍ وافرُ القِسمِ",14,"م",1,0],["هم ذللوني لريب الخطوب","وكنت عليهن أستصعب",15,"ب",1,0],["هُم ذَكَّروني فَاِشتَغَلتُ بِذِكرِهِم","وَهِمتُ بِهِم وَجداً بِغَيرِ تَصَنُّعِ",16,"ع",1,0],["هم ذكروني والمهامه بيننا","كما ارفض غيث في تهامة من نجد",17,"د",1,0],["هم ذللوا الدنيا ومن في ربوعها","على طاعة الرحمن تحت السنوَّر",18,"ر",1,0],["هم ذاتهم ما زال ينحر لؤمهم","شيمَ الوفاء ويحرق اليخضورا",19,"ر",2,0]]}