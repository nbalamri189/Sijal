{"poems":[[104,"ديننا حبك يا هذا الوطن","https://www.aldiwan.net/poem32909.html","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141919","المقتضب"],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[215,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[259,"جنون","https://www.aldiwan.net/poem24955.html","مجزوء الرمل"],[266,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[333,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[563,"نحن إخوان النبي المصطفى","https://www.aldiwan.net/poem34355.html","الرمل"],[564,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142203","الرمل"],[2955,"","https://poetry.dctabudhabi.ae/diwan/poem/198732","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29312","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125887","الرمل"],[4691,"هذهِ الدنيا ( ضحك الشاعر )","https://www.poetsgate.com/ViewPoem.aspx?id=92558",""],[4750,"السيف الشقير","https://www.poetsgate.com/ViewPoem.aspx?id=180405",""],[4788,"حبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132249",""],[4791,"ودعيها ياعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=28437",""],[5122,"أحبهاااا","https://www.poetsgate.com/ViewPoem.aspx?id=20463",""],[5187,"نغم عذري","https://www.poetsgate.com/ViewPoem.aspx?id=33002",""],[5219,"تشطير أبيات الأخطل الصغير ... قد أتاك يعتذر","https://www.poetsgate.com/ViewPoem.aspx?id=197681",""],[5277,"ويْ حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=203366",""],[5304,"الخيل والصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=155914",""],[5344,"إلتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=180697",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5410,"حُبُّنا مَوئلٌ للسَلام","https://www.poetsgate.com/ViewPoem.aspx?id=151392",""],[5525,"دروبي رمل","https://www.poetsgate.com/ViewPoem.aspx?id=924",""],[5606,"لوتسلى قلب عيسى مهو سالي","https://www.poetsgate.com/ViewPoem.aspx?id=197495",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5956,"نحن أرواح","https://www.poetsgate.com/ViewPoem.aspx?id=182625",""],[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5997,"يا أبا منصور","https://www.poetsgate.com/ViewPoem.aspx?id=214240",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6056,"مثل الجبل رآسي","https://www.poetsgate.com/ViewPoem.aspx?id=130339",""]],"verses":[["حبنا حُبٌّ أَبى أَن يُنكرا","ديننا حُبك يا هَذا الوَطَن",0,"ن",1,0],["حبّنا الذي نشروا","من شذاه ما نشروا",1,"ر",3,0],["حبّنا مات فليبلغ عذولي","موت هذا الهوى لعين الرقيب",2,"ب",1,0],["حبّنا مات فابك أنت عليه","فهلاك الهوى هلاك الحبيب",2,"ب",1,0],["حبنا مات لا تكذّب حبيباً","يصطلى وحده بنار الحريق",2,"ق",1,0],["حبّنا مات فابك أنت عليه","يا صريع الفتون بعد الفتون",2,"ن",1,0],["حبّنا مات فابك أنت عليه","غاض دمعي وغاب عني أنيني",3,"ي",1,0],["حبنا وهْمٌ غَيومٌ","لم يملْ نحو الوضوحِ",4,"ح",1,0],["حبنا من اب قديم وللآباء","ارث تخص منه البنينا",5,"ن",2,0],["حبّ نبعِ الأسرار مشكاة نور","السحق مفتاح رحمة الوهّاب",6,"ب",1,0],["حبنا من حبه مكتسب","ومع البعد به البعد انتفى",7,"ف",2,0],["حُبُّنَا لِلْشَيْء يُعْمِى","ويصمُ قُلْتُ حَقَّا",8,"ق",2,0],["حبنا ما زال طفلا بيننا","كم كما كنت لهذا الطفل حضنه",9,"ن",2,0],["حُبنا باق ويجري في دمانا","ما حيينا لك لن ننسى الجميلا",10,"ل",2,0],["حُبُّنا كانَ قَبلَ خَلقِ اللَيالي","وَسَيَبقى بَعدَ اِنقِضاءِ الزَمانِ",11,"ن",1,0],["حُبُّنا حبُّ صفاءٍ","لا عتابٌ لا تجني",12,"ن",2,0],["حبنا المال والبنون قديم","ليس يبلى وإن عبرنا الدهورا",13,"ر",2,0],["حبنا آل سعود قاد المجد في ابن سعودي","وأنت يا هداج تيماء بهجة للضامي",14,"م",2,0],["((حبنا يانور عيني لايضيع","إحفظه حتى يلمبنا إجتماع))",15,"ع",1,0],["حبنا ما صار مخلوف السعي","والرجاء بك طيف حلمٍ مرّنا",16,"ن",2,0],["حب(ن) مشيد له باللباب مّركز","من شان ماياتيه برد(ن) وشمسي",17,"س",2,0],["حبنا رمزٌ وتضحية","أيُّ حبٍ مثلَهُ حملا",18,"ل",2,0],["(حبنا الذي نشروا)ماانقضى به الوطر","ليتهم له انتظروا(من شذاه ما نشروا)",19,"ر",3,0],["حبُّنا نبعٌ ..ودنيانا هوىً","قد كبُرنا فيه مذْ كنّا صغارا",20,"ر",2,0],["حبّن على وضح النقا والمشاهير","منقوش باسمك بالضلوع الغذيّه",21,"ي",2,0],["حبنا لو غاب محفوظن دفين،","حالفن له مثل ماهو لي حلَف",22,"ف",1,0],["حبُّنا للإمامِ ليسَ سوى","وسيلةٍ والمُصَوِّرُ الهَدَفُ",23,"ف",1,0],["حُبُّنا ليس مُحْرِقاُ يتلظّى","أو جحيماً يُدَمّرُ الأفنانا",24,"ن",2,0],["حُبُّنا موئل للسلام ونُورٌ","ومِنَ العَدل ِ أن نصونَ رُؤانا",24,"ن",2,0],["حبّني كثر اللذي نلقى بوعدنا","من ظلال وريح ونجوم وغداري",25,"ر",2,0],["حبنا عهد من الله ما خونه","وإن يبقى طول عمري على بالي",26,"ل",2,1],["حبنا ليس ما يريد الأعادي","إنما الحب ما يريد النقاء",27,"ا",2,0],["حبنا رحمة.. وصدقٌ.. وطهرٌ","وعفافٌ.. ولهفةٌ.. ورضاء",27,"ا",2,0],["حبّنا يشفي دمانا","إنه خيرُ العلاجْ",28,"ج",1,0],["حبُّنا هذا تَسامَى","أشبعِ الروحَ تماما",29,"م",2,0],["حبٌّ نما فوق التلال كدوحةٍ","قُطِعتْ فصرتُ بدون أيِّ مواسمِ",30,"م",1,0],["ٍحُبُّنا المصلوب تغشاه المآسي","لا يرى للودِّ إشراقاً ونورا",31,"ر",2,0],["حبنااللي من قديم العهد أنا وأنتي دفناّ","إكتشفت إنه هواللي في غرامك قد دفنيّ",32,"ن",2,0],["حب ٍ نشأ ،، من موجعات التباريح","مدعوم بأركانه ، ومبني على ساس",33,"س",1,0]]}