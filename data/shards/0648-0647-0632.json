{"poems":[[53,"إن لم أطع همما وأعص عواذلا","https://www.aldiwan.net/poem29863.html","الكامل"],[63,"ومشتمل على كرم وحزم","https://www.aldiwan.net/poem46115.html","الوافر"],[63,"أما وتجني طيفها المتأوب","https://www.aldiwan.net/poem46154.html","الطويل"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[63,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[63,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[77,"سقى علم الحنان فالجزع فالبانا","https://www.aldiwan.net/poem36077.html","الطويل"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[24,"ما برح الرسم الذي بين حنجر","https://www.aldiwan.net/poem21860.html","الطويل"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[51,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[38,"وما مزنة جادت فأسبل ودقها","https://www.aldiwan.net/poem7709.html","الطويل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[92,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[85,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[85,"جئننا بالشعور والأحداق","https://www.aldiwan.net/poem63027.html","الخفيف"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[45,"أيها الطالب الطويل عناؤه","https://www.aldiwan.net/poem10201.html","الخفيف"],[45,"أبعد الشباب المنتضى في الذوائب","https://www.aldiwan.net/poem10652.html","الطويل"],[45,"على أي أمر مشكل أتلوم","https://www.aldiwan.net/poem65664.html","الطويل"],[28,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[61,"تأبى المنازل أن تجيب مسائلا","https://www.aldiwan.net/poem51474.html","البسيط"],[61,"هذه الشمس أوشكت أن تغيبا","https://www.aldiwan.net/poem51805.html","الخفيف"],[66,"إني لفضلك بالمديح أجازي","https://www.aldiwan.net/poem38510.html","الكامل"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[74,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[13,"ألا تلكما عرسي منيعة ضمنت","https://www.aldiwan.net/poem2198.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[77,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""],[77,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[51,"لهفَ نفسي على رَصاصٍ مُذاب","https://www.poetsgate.com/ViewPoem.aspx?id=27019",""]],"verses":[["وَهَزَزتُ أَغصانَ المَخاوِفِ دونَهُ","فَاِجتازَ يَحسَبُها ظُبىً وَذَوابِلا",0,"ل",2,0],["وَهَزَّتْهُ المَكارِمُ لابْنِ أَرْضٍ","نَزيعِ الدَّارِ مِنْ نَفَرٍ كِرامِ",1,"م",1,0],["وهزَّ الفَيافي عُودَهُ إذْ تَشَبّثَتْ","يَدُ الدّهْرِ منهُ باللّحاءِ المُشَذَّبِ",2,"ب",1,0],["وهزّكَ مَدْحٌ كادَ يُصْبيكَ حُسْنُهُ","وفي الشِّعرِ ما هزَّ الكَريمَ وما أصْبى",3,"ب",2,0],["وهَزَزْتُ أطرافَ السّياطِ فأرْقَلَتْ","وبِها مَراحُ الطّارِقِ المُتنَوِّر",4,"ر",1,0],["وهزَّةُ السّيرِ أنْسَتْهُمْ مَعاطِفَهُمْ","من كُلِّ زَيّافَةٍ كالفَحْلِ هِمْلاجِ",5,"ج",1,0],["وهزَزْنَ مِن أعطافِهنَّ كأنَّما","مُلِئَتْ مَسامِعُهُنَّ رَجْعَ غِناءِ",6,"ا",2,0],["وَهَزَّتْ وَُقورَ الرَّوْضِ نَغْمَةُ قَيْنَةٍ","مِنَ الْوُرْقِ إِذْ بَاتَتْ تُرَجِّعُ أَلْحَانَا",7,"ن",2,0],["وَهَزَزْتُ دَوْحَ بَدَائِهِي فَتَساَقَطَتْ","رُطَبُ الْمَعَانِي تَسْتفَزُِّالْجَانِي",8,"ن",2,0],["وَهَزَزْتَ دَوْحَ الْعَزْمِ فِي رَوْضِ الرَّجَا","فَجَنَيْتَ غَضَّ النَّفْسِ فِي مَرْضَاتِهَا",9,"ت",3,0],["وَهَزُّوا فُرُوعَ الْعِلْمِ وَهْيَ بَوَاسِقٌ","فَلِلهِ مَا حَازُوهُ مِنْ رُطَبٍ رَطْبِ",10,"ب",1,0],["وَهَزَزْتُ فِيهَا كُلَّ أَسْمَرَ ذَابِلٍ","يَشْقَى بِطَعْنَتِهِ الْعَدُوُّ الأَصْهَبُ",11,"ب",1,0],["وَهَزَّةِ أَظعانٍ عَلَيهِنَّ بَهجَةٌ","طَلَبتُ وَرَيعانُ الصِبا بِيَ جامِحُ",12,"ح",1,0],["وَهَزَزتُهُ بِقَصيدَةٍ لَو أَنَّها","تُلِيَت عَلى الصَخرِ الأَصَمِّ لَأَغدَقا",13,"ق",2,0],["وهُزَّتْ مُحلاَةً يدُ الشوق في الدُّجى","فحُلَّ الَّذي أبرمتُ للصبر من عَقدِ",14,"د",1,0],["وهزاره ترك الصداح وليثه","أمنت أعاديه سماع زئيره",15,"ر",2,0],["وَهِزَّةِ أَظعانٍ كَأَنَّ حُمولَها","غَداةَ اِستَقَلَّت بِالفَروقِ ذُرى النَخلِ",16,"ل",1,0],["وَهَزَلتُمُ لَجَأ وَأَنتَ تَصُرُّها","غِبّاً تُقَلِّدُ دُهمَها بِرِمامِ",17,"م",1,0],["وهزَّك غصناً في مهمات ملكه","فصان بمسلول وزانَ بمعمد",18,"د",1,0],["وهِزَبْرٍ غضنفر في كِتافٍ","فاغرٍ فاهُ كالحِ الأنيابِ",19,"ب",1,0],["وَهَزَزتُ أَوتارَ القُلوبِ بِصامِتٍ","يَشتاقُ كُلُّ مُهَذَّبٍ أَن يَنطُقا",20,"ق",2,0],["وَهِزَّةَ أَظعانٍ عَلَيهِنَّ بَهجَةٌ","طَلَبتُ وَرَيعانُ الصِبى فِيَّ جامِحُ",21,"ح",1,0],["وَهَزَّ جَناحَيهِ فَساقَطَ نَفضُهُ","فَراشَ النَدى عَن مَتنِهِ فَتَبَدَّدا",22,"د",2,0],["وَهِزَّةِ نِسوَةٍ مِن حَيِّ صِدقٍ","يُزَجِّجنَ الحَواجِبَ وَالعُيونا",23,"ن",2,0],["وهزيمِ الرِّياح في كلِّ فَجٍّ","ورُسُومِ الحَيَاةِ من أمس أمْسِ",24,"س",1,0],["وهز المنكبين لمهرجان","زها كالباقة الحسنى وضاعا",25,"ع",2,0],["وَهُزِمَ الطاهِرُ يَومَ النَهرِ","وَعرف القاهِرُ طَعمَ القَهرِ",26,"ر",1,0],["وَهَزَّ النَدِيُّ لَكَ المَنكِبَينِ","وَراحَ الثَرى مِن زِحامٍ يَميد",27,"د",1,0],["وَهَزَزنَ القَنا قُدوداً فَأَبلى","كُلَّ قَلبٍ مُستَضعَفٍ خَفّاقِ",28,"ق",1,0],["وَهَزَزتُ قَوامَكَ أَعطِفُهُ","فَنَبا وَتَمَنَّعَ أَملَدُهُ",29,"د",2,0],["وَهَزيماً كَما عَوى الذِئبُ في كُل","لِ مَكانٍ وَزَمجَرَ الضِرغامَه",30,"م",2,0],["وَهَزٌّ أَطارَ النَومَ حَتّى كَأَنَّني","مِنَ السُكرِ في الغَرزَينِ ثَوبٌ شُبارِقُ",31,"ق",1,0],["وَهَزَزناهُ لِلفَعالِ فَأَبدى","جَوهَرَ الصارِمِ الحُسامِ اِنتِضاؤُه",32,"ا",3,0],["وَهَزّوكَ لِلأَمرِ الجَليلِ فَلَم تَكُن","ضَعيفَ القُوى فيهِ كَليلَ المَضارِبِ",33,"ب",1,0],["وَهِزَّتُهُ لِلمَجدِ حَتّى كَأَنَّما","تَثَنّى بِهِ الخَطِّيُّ فيها المُقَوَّمُ",34,"م",1,0],["وَهَزَزنَ مِن جَزَعٍ أَسِنَّةَ صُلَّبٍ","كَجُزوعِ خَيبَرَ أَو جُزوعِ أَوالِ",35,"ل",1,0],["وهَزَزْتُ إبراهيمَ فيه وإنَّما","أعملتُ فيه مُهَنَّداً أو عَامِلا",36,"ل",2,0],["وهززت إبراهيم فيه وإنما","أعملت منه مهندا أو عاملا",37,"ل",2,0],["وهَزَزنْاه للمكارمِ فاهْتَزْ","زَ كما هَزَّتِ الرِّياحُ القَضيبا",38,"ب",2,0],["وَهَزَزتَ أَغصانَ الكَلامِ فَساقَطَت","دُرَراً فَلا عَدِمَتكَ مِن هَزّازِ",39,"ز",1,0],["وَهِزّي ذابِلاً لِلخَيلِ مارٍ","يُلينُ بِبَزِّهِ صَدراً وَمارِن",40,"ن",1,0],["وهِزبرَ غابٍ يحتمي بمخالبٍ","يُرْهَفْنَ من غيرِ الحديدِ حِدادِ",41,"د",1,0],["وهزّ قناةً تحت برديْه لدنةً","تلينُ وتندى نضرةً وشبابا",42,"ب",2,0],["وَهُزَّ مِن عِطفَيكَ عَن نَشوَةٍ","غُصناً إِذا مانَفَّسَ الصُبحُ هَب",43,"ب",1,0],["وَهَزَّت مِن مَعاطِفِيَ القَوافي","كَما هَفَتِ النُعامى بِالقَضيبِ",44,"ب",1,0],["وَهَزَّت مَعاطِفَهُ وَاِلتَوى","بِمَسرى النَسيمِ اِلتِواءُ الجِذَل",45,"ل",1,0],["وهزّ الشِّعبَ صوتٌ من بِلالِ","بلالُ الخيرِ أذَّنَ في الرجالِ",46,"ل",1,0],["وَهَزَّ الرِياحُ مِنَ القُضُبِ فيهِ","قَناً لَم يُثَقَّف وَلا نُصِّلا",47,"ل",2,0],["وَهَزَّ السُرى كُلَّ ذي حاجَةٍ","وَقَرقَرَتِ البومَةُ الصائِحَه",48,"ح",2,0],["وَهَزَثتُ مَشغوفَ النَجاءِ وَراعَني","أَناسٌ بِفَيفانٍ فَمِزتُ القَرائِنا",49,"ن",2,0],["وَهَزَمَ العَساكِرَ الجَليلَه","بِشِدَّةِ البَأسِ وَلُطفِ الحيلَه",50,"ه",1,0],["وهَزَّ ثَبِير عِطْفَيْهِ سُروراً","به كالغُصْنِ هَبَّتْهُ الجَنُوبُ",51,"ب",1,0],["وهزَّتَه للمجد حتى كأنما","جرت في سجاياهُ العِذابِ رحيق",52,"ق",1,0],["وهُزِّي النجمَ إشفاقاً","لنجمٍ غيرِ وقَّادِ",53,"د",1,0],["وهزَّني ما فاضَ من خاطرِ","كان ينابيعَ البيانِ العذابْ",54,"ب",1,0],["وهززتما بالشوقِ كفّ مُسَلِّمٍ","وهَفَتْ إلى تقبيله الشَّفتانِ",55,"ن",1,0],["وهزَزْتَ أعْطافَ المُلوكِ بمَنْطِقٍ","رَدَّ المُسِنَّ إلى اقْتِبالِ شبابهِ",56,"ب",2,0],["وَهَزَّتْكَ هِزَّةُ تِلْكَ الجَوَا","نِحِ إِذْ تَتَوَلَّى وَإِذْ تُقْسِمُ",57,"م",1,0],["وَهَزِيمٍ وَثبَتْ أَعْينُهُ","وَضرِيرٍ مُتلَوٍّ حَيْثُ قرَّا",58,"ر",2,0],["وهزَزنَ النهودَ من خلَلِ الوشيِ","ولَملمن ما أحاط الساقا",59,"ق",2,0],["وَهُزَّتِ الرَّاسِيَاتُ الشمُّ وَارْتَعَدَتْ","لِهَوْلِهِ البَاتِرَاتُ البِيضُ في القُرُبِ",60,"ب",1,0],["وهززتُ الشبابَ للسبقِ فانث","الوا سِراعاً على هدَى مِشْكَاتِهْ",61,"ت",2,0],["وهزَّ أبا الهول في خِدْرِهِ","فأرهَفَ أُذْنَيْه، ثم ابَتَسَمْ",62,"م",1,0],["وهزَّ ربُوعَ الشَّرق، حتى تساءلَت","مِن الهَول: هل يومُ الإمام تجدَّدَا؟",63,"د",2,0],["وهزَزْتَ دوْحَ العزْمِ في روْضِ الرَّجا","فجنَيْتَ غضَّ النّصْرِ مِن ثمراتِها",64,"ت",3,0],["وهَزُّوا فُروعَ العلْمِ وهي بواسِقٌ","فلله ما جازُوهُ من رُطَبِ رَطب",65,"ب",1,0],["وهزَزْتُ فيه كلّ أسمَرَ ذابلٍ","يشْقَى بطَعْنتِه العدُوُّ الأصهَبُ",66,"ب",1,0],["وهززت دوح بدائهي فتساقطت","رطب المعاني تستفز الجان",67,"ن",1,0],["وهززنا في الأريحية غُصناً","ورأينا في الدست رضوى وقُدْسا",68,"س",2,0],["وهِزَبْرٍ عَضنفر في كِتافٍ","فاغرٍ فاهُ كالحِ الأنيابِ",69,"ب",1,0]]}