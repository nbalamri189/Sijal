ي","https://www.aldiwan.net/poem50144.html","المتقارب"],[417,"سلمه الرب من الأسواء","https://www.aldiwan.net/poem53860.html","الرجز"],[417,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[417,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[430,"لاح للأفراح بدر","https://www.aldiwan.net/poem40994.html","مجزوء الرمل"],[430,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[433,"أومض برق الخجل","https://www.aldiwan.net/poem12371.html","مجزوء الرجز"],[433,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[438,"صبح الجبين وليل شعرك قد غدا","https://www.aldiwan.net/poem2499.html","الكامل"],[440,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[442,"الحمد لله القريب النائي","https://www.aldiwan.net/poem14286.html","الرجز"],[442,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[462,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[465,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[465,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[465,"ليلة خففت من الهم عنا","https://www.aldiwan.net/poem3550.html","عموديه"],[465,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[515,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[516,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[552,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[587,"حموا بكعوب السمر بيض الكواعب","https://www.aldiwan.net/poem17441.html","الطويل"]],"verses":[["وَهَزَزتُ أَغصانَ المَخاوِفِ دونَهُ","فَاِجتازَ يَحسَبُها ظُبىً وَذَوابِلا",0,"ل",2,0],["وَهَزَّتْهُ المَكارِمُ لابْنِ أَرْضٍ","نَزيعِ الدَّارِ مِنْ نَفَرٍ كِرامِ",1,"م",1,0],["وهزَّ الفَيافي عُودَهُ إذْ تَشَبّثَتْ","يَدُ الدّهْرِ منهُ باللّحاءِ المُشَذَّبِ",2,"ب",1,0],["وهزّكَ مَدْحٌ كادَ يُصْبيكَ حُسْنُهُ","وفي الشِّعرِ ما هزَّ الكَريمَ وما أصْبى",3,"ب",2,0],["وهَزَزْتُ أطرافَ السّياطِ فأرْقَلَتْ","وبِها مَراحُ الطّارِقِ المُتنَوِّر",4,"ر",1,0],["وهزَّةُ السّيرِ أنْسَتْهُمْ مَعاطِفَهُمْ","من كُلِّ زَيّافَةٍ كالفَحْلِ هِمْلاجِ",5,"ج",1,0],["وهزَزْنَ مِن أعطافِهنَّ كأنَّما","مُلِئَتْ مَسامِعُهُنَّ رَجْعَ غِناءِ",6,"ا",2,0],["وَهَزَّتْ وَُقورَ الرَّوْضِ نَغْمَةُ قَيْنَةٍ","مِنَ الْوُرْقِ إِذْ بَاتَتْ تُرَجِّعُ أَلْحَانَا",7,"ن",2,0],["وَهَزَزْتُ دَوْحَ بَدَائِهِي فَتَساَقَطَتْ","رُطَبُ الْمَعَانِي تَسْتفَزُِّالْجَانِي",8,"ن",2,0],["وَهَزَزْتَ دَوْحَ الْعَزْمِ فِي رَوْضِ الرَّجَا","فَجَنَيْتَ غَضَّ النَّفْسِ فِي مَرْضَاتِهَا",9,"ت",3,0],["وَهَزُّوا فُرُوعَ الْعِلْمِ وَهْيَ بَوَاسِقٌ","فَلِلهِ مَا حَازُوهُ مِنْ رُطَبٍ رَطْبِ",10,"ب",1,0],["وَهَزَزْتُ فِيهَا كُلَّ أَسْمَرَ ذَابِلٍ","يَشْقَى بِطَعْنَتِهِ الْعَدُوُّ الأَصْهَبُ",11,"ب",1,0],["وَهَزَّةِ أَظعانٍ عَلَيهِنَّ بَهجَةٌ","طَلَبتُ وَرَيعانُ الصِبا بِيَ جامِحُ",12,"ح",1,0],["وَهَزَزتُهُ بِقَصيدَةٍ لَو أَنَّها","تُلِيَت عَلى الصَخرِ الأَصَمِّ لَأَغدَقا",13,"ق",2,0],["وهُزَّتْ مُحلاَةً يدُ الشوق في الدُّجى","فحُلَّ الَّذي أبرمتُ للصبر من عَقدِ",14,"د",1,0],["وهزاره ترك الصداح وليثه","أمنت أعاديه سماع زئيره",15,"ر",2,0],["وَهِزَّةِ أَظعانٍ كَأَنَّ حُمولَها","غَداةَ اِستَقَلَّت بِالفَروقِ ذُرى النَخلِ",16,"ل",1,0],["وَهَزَلتُمُ لَجَأ وَأَنتَ تَصُرُّها","غِبّاً تُقَلِّدُ دُهمَها بِرِمامِ",17,"م",1,0],["وهزَّك غصناً في مهمات ملكه","فصان بمسلول وزانَ بمعمد",18,"د",1,0],["وهِزَبْرٍ غضنفر في كِتافٍ","فاغرٍ فاهُ كالحِ الأنيابِ",19,"ب",1,0],["وَهَزَزتُ أَوتارَ القُلوبِ بِصامِتٍ","يَشتاقُ كُلُّ مُهَذَّبٍ أَن يَنطُقا",20,"ق",2,0],["وَهِزَّةَ أَظعانٍ عَلَيهِنَّ بَهجَةٌ","طَلَبتُ وَرَيعانُ الصِبى فِيَّ جامِحُ",21,"ح",1,0],["وَهَزَّ جَناحَيهِ فَساقَطَ نَفضُهُ","فَراشَ النَدى عَن مَتنِهِ فَتَبَدَّدا",22,"د",2,0],["وَهِزَّةِ نِسوَةٍ مِن حَيِّ صِدقٍ","يُزَجِّجنَ الحَواجِبَ وَالعُيونا",23,"ن",2,0],["وهزيمِ الرِّياح في كلِّ فَجٍّ","ورُسُومِ الحَيَاةِ من أمس أمْسِ",24,"س",1,0],["وهز المنكبين لمهرجان","زها كالباقة الحسنى وضاعا",25,"ع",2,0],["وَهُزِمَ الطاهِرُ يَومَ النَهرِ","وَعرف القاهِرُ طَعمَ القَهرِ",26,"ر",1,0],["وَهَزَّ النَدِيُّ لَكَ المَنكِبَينِ","وَراحَ الثَرى مِن زِحامٍ يَميد",27,"د",1,0],["وَهَزَزنَ القَنا قُدوداً فَأَبلى","كُلَّ قَلبٍ مُستَضعَفٍ خَفّاقِ",28,"ق",1,0],["وَهَزَزتُ قَوامَكَ أَعطِفُهُ","فَنَبا وَتَمَنَّعَ أَملَدُهُ",29,"د",2,0],["وَهَزيماً كَما عَوى الذِئبُ في كُل","لِ مَكانٍ وَزَمجَرَ الضِرغامَه",30,"م",2,0],["وَهَزٌّ أَطارَ النَومَ حَتّى كَأَنَّني","مِنَ السُكرِ في الغَرزَينِ ثَوبٌ شُبارِقُ",31,"ق",1,0],["وَهَزَزناهُ لِلفَعالِ فَأَبدى","جَوهَرَ الصارِمِ الحُسامِ اِنتِضاؤُه",32,"ا",3,0],["وَهَزّوكَ لِلأَمرِ الجَليلِ فَلَم تَكُن","ضَعيفَ القُوى فيهِ كَليلَ المَضارِبِ",33,"ب",1,0],["وَهِزَّتُهُ لِلمَجدِ حَتّى كَأَنَّما","تَثَنّى بِهِ الخَطِّيُّ فيها المُقَوَّمُ",34,"م",1,0],["وَهَزَزنَ مِن جَزَعٍ أَسِنَّةَ صُلَّبٍ","كَجُزوعِ خَيبَرَ أَو جُزوعِ أَوالِ",35,"ل",1,0],["وهَزَزْتُ إبراهيمَ فيه وإنَّما","أعملتُ فيه مُهَنَّداً أو عَامِلا",36,"ل",2,0],["وهززت إبراهيم فيه وإنما","أعملت منه مهندا أو عاملا",37,"ل",2,0],["وهَزَزنْاه للمكارمِ فاهْتَزْ","زَ كما هَزَّتِ الرِّياحُ القَضيبا",38,"ب",2,0],["وَهَزَزتَ أَغصانَ الكَلامِ فَساقَطَت","دُرَراً فَلا عَدِمَتكَ مِن هَزّازِ",39,"ز",1,0],["وَهِزّي ذابِلاً لِلخَيلِ مارٍ","يُلينُ بِبَزِّهِ صَدراً وَمارِن",40,"ن",1,0],["وهِزبرَ غابٍ يحتمي بمخالبٍ","يُرْهَفْنَ من غيرِ الحديدِ حِدادِ",41,"د",1,0],["وهزّ قناةً تحت برديْه لدنةً","تلينُ وتندى نضرةً وشبابا",42,"ب",2,0],["وَهُزَّ مِن عِطفَيكَ عَن نَشوَةٍ","غُصناً إِذا مانَفَّسَ الصُبحُ هَب",43,"ب",1,0],["وَهَزَّت مِن مَعاطِفِيَ القَوافي","كَما هَفَتِ النُعامى بِالقَضيبِ",44,"ب",1,0],["وَهَزَّت مَعاطِفَهُ وَاِلتَوى","بِمَسرى النَسيمِ اِلتِواءُ الجِذَل",45,"ل",1,0],["وهزّ الشِّعبَ صوتٌ من بِلالِ","بلالُ الخيرِ أذَّنَ في الرجالِ",46,"ل",1,0],["وَهَزَّ الرِياحُ مِنَ القُضُبِ فيهِ","قَناً لَم يُثَقَّف وَلا نُصِّلا",47,"ل",2,0],["وَهَزَّ السُرى كُلَّ ذي حاجَةٍ","وَقَرقَرَتِ البومَةُ الصائِحَه",48,"ح",2,0],["وَهَزَثتُ مَشغوفَ النَجاءِ وَراعَني","أَناسٌ بِفَيفانٍ فَمِزتُ القَرائِنا",49,"ن",2,0],["وَهَزَمَ العَساكِرَ الجَليلَه","بِشِدَّةِ البَأسِ وَلُطفِ الحيلَه",50,"ه",1,0],["وهَزَّ ثَبِير عِطْفَيْهِ سُروراً","به كالغُصْنِ هَبَّتْهُ الجَنُوبُ",51,"ب",1,0],["وهزَّتَه للمجد حتى كأنما","جرت في سجاياهُ العِذابِ رحيق",52,"ق",1,0],["وهُزِّي النجمَ إشفاقاً","لنجمٍ غيرِ وقَّادِ",53,"د",1,0],["وهزَّني ما فاضَ من خاطرِ","كان ينابيعَ البيانِ العذابْ",54,"ب",1,0],["وهززتما بالشوقِ كفّ مُسَلِّمٍ","وهَفَتْ إلى تقبيله الشَّفتانِ",55,"ن",1,0],["وهزَزْتَ أعْطافَ المُلوكِ بمَنْطِقٍ","رَدَّ المُسِنَّ إلى اقْتِبالِ شبابهِ",56,"ب",2,0],["وَهَزَّتْكَ هِزَّةُ تِلْكَ الجَوَا","نِحِ إِذْ تَتَوَلَّى وَإِذْ تُقْسِمُ",57,"م",1,0],["وَهَزِيمٍ وَثبَتْ أَعْينُهُ","وَضرِيرٍ مُتلَوٍّ حَيْثُ قرَّا",58,"ر",2,0],["وهزَزنَ النهودَ من خلَلِ الوشيِ","ولَملمن ما أحاط الساقا",59,"ق",2,0],["وَهُزَّتِ الرَّاسِيَاتُ الشمُّ وَارْتَعَدَتْ","لِهَوْلِهِ البَاتِرَاتُ البِيضُ في القُرُبِ",60,"ب",1,0],["وهززتُ الشبابَ للسبقِ فانث","الوا سِراعاً على هدَى مِشْكَاتِهْ",61,"ت",2,0],["وهزَّ أبا الهول في خِدْرِهِ","فأرهَفَ أُذْنَيْه، ثم ابَتَسَمْ",62,"م",1,0],["وهزَّ ربُوعَ الشَّرق، حتى تساءلَت","مِن الهَول: هل يومُ الإمام تجدَّدَا؟",63,"د",2,0],["وهزَزْتَ دوْحَ العزْمِ في روْضِ الرَّجا","فجنَيْتَ غضَّ النّصْرِ مِن ثمراتِها",64,"ت",3,0],["وهَزُّوا فُروعَ العلْمِ وهي بواسِقٌ","فلله ما جازُوهُ من رُطَبِ رَطب",65,"ب",1,0],["وهزَزْتُ فيه كلّ أسمَرَ ذابلٍ","يشْقَى بطَعْنتِه العدُوُّ الأصهَبُ",66,"ب",1,0],["وهززت دوح بدائهي فتساقطت","رطب المعاني تستفز الجان",67,"ن",1,0],["وهزّ القصور فمادت بنا","وأشغل من تحتنا المرقدا",68,"د",2,0],["وهززت \" الخصيب \" فاهتزّ جن","باه وذوّبت مقلتيك فلانا",69,"ن",2,0],["وهززنا في الأريحية غُصناً","ورأينا في الدست رضوى وقُدْسا",70,"س",2,0],["وهِزَبْرٍ عَضنفر في كِتافٍ","فاغرٍ فاهُ كالحِ الأنيابِ",71,"ب",1,0],["وهزنا الشوق لريم الحمى","الله ما اطول ليل الفراق",72,"ق",1,0],["وهز الباب الرجال النوى","وكم مكين للنوى صاح صاح",73,"ح",1,0],["وهزّوا على الأعداء سيفاً وذابلا","ولا بمتكيكم رُذَّلٌ ولئِامُ",74,"م",1,0],["وهزت صدور السمر للطعن في الكلا","وقلنا لبيض الهند قابلت موسما",75,"م",2,0],["وهزت لطعن الصب لدن قوامها","وما هو إلا عاشق لا محارب",76,"ب",1,0],["وهز الملك عطفيه اختيالا","كما هز النسيم الرطب غضنا",77,"ن",2,0],["وهزِّي العطفَ في غَفَلاتِ عيشٍ","وريقِ الأيكِ مَمْطورِ الظِّلالِ",78,"ل",1,0],["وَهَزّانَ المقامر قَد قَتلَنا","وَغادَرنا ابنَ هُوذَةَ مُستَكِينَا",79,"ن",2,0],["وهِزبرٍ بهِ الملوك بنو الأص","فرِ بادوا وفارسُ الحمراءُ",80,"ا",2,0],["وهزار الدوح غنّى","فإذا لاح الصباح",81,"ح",1,0],["وَهَزَّ هُبوبُ الريح عِطفَ أَراكَةٍ","فَمالَت كَما مالَ النَزيفُ مَع السكرِ",82,"ر",1,0],["وهزتَ ستارتها باليدينِ","تعلمني كيفَ خفقُ الفؤادْ",83,"د",1,0],["وهزل الهوى جدّ صراح فلا تكن","بهزلك معواناً عليّ مع الدهر",84,"ر",1,0],["وَهزمتَ النَسناسَ وَالضَبُ","عَ الحَزراءَ فيها وَالأَرقمَ النَشّابا",85,"ب",2,0],["وَهَزَّتهُ المَكارِمُ لِإِصطِناعي","كَما اِهتَزَّ السُريجِيُّ الصَقيلُ",86,"ل",1,0],["وهزارُ الحال يجاوبُها","والغصن تثنّى بالهيف",87,"ف",1,0],["وهزَّهُ الطربُ الأعلى فأسمعني","ألحانَ مجدٍ وحبٍّ من غنائهم",88,"م",1,0],["وهزّ لفرطِ الإرتياح جوانحاً","تشايعها منّي الجوارح بالهبِّ",89,"ب",1,0],["وهزّك بينَ البيض والسمر عطفه","وَبينَ جَناحي جحفَلين به قلبا",90,"ب",2,0],["وَهزَّكَ مَدْحُنا من جَانِبيهِ","فَلَمْ تَكُ عَن جَوارِحِنا بِنائِمْ",91,"م",1,0],["وَهزار السَعد في دَوح الهَنا","صَدع الحاسد لَمّا صَدَحا",92,"ح",2,0],["وَهَزَّ قامة عَسّالٍ يَذود بِهِ","عَن رَشف مَعسوله إِن جَدَّ أَو مَزَحا",93,"ح",2,0],["وهَززْتُ أعطافَ الصَّباحِ إليهمُ","في مَتْنِ لَيلٍ بالنّهارِ مُخَلْخَل",94,"ل",1,0],["وَهُزَّ السَّمهريُّ على المَذاكي","مُجَنِّبَتَينِ بالأبطال تُردي",95,"د",2,0],["وهزَّ ثيابَ غيم الشعر حتى","جرى ما تبصرين من السَّواقي",96,"ق",2,0],["وهزته نار الاشتياق فقلبه","لشدتها كالْقِدْرِ كان على الجمر",97,"ر",1,0],["وَهَزَّ اليَراع أَنابيبه","وَهُنّىءَ بِالكاتِبِ المُفلِقِ",98,"ق",1,0],["وهزَّ كلّ سامعٍ من طرب","فكان عندي من أجلّ الكتب",99,"ب",1,0],["وهزبر باسل برثنه الأسم","رُ العسَّال والعَضْبُ المجرَّد",100,"د",1,0],["وهزَّتهُمُ يوم الندى أريحيَّة","كأنْ شربوا من كأس صهباء صرخد",101,"د",1,0],["وهزار الانس غنى","بالصفا يعلوه بشر",102,"ر",1,0],["وهزار الدوح يردده","شوق يزداد مع الأدب",103,"ب",1,0],["وهَزَّ أَغصانَ القُدو","دِ سَجْعُ أَطيارِ الحُلِي",104,"ل",2,0],["وهزّ الملكُ عطفَيهِ بمَلْك","تقلّد أمره وكفى ونابا",105,"ب",2,0],["وهزَزتَ الدنا بالقوام لمهجتي","فتيقّنت أن قد أتيح لها الردى",106,"د",2,0],["وهُزَّتْ مضاربُهُ عن حُسامٍ","وَفُرَّتْ نواجِذُهُ عن ذَكاءِ",107,"ا",2,0],["وهزها بالغد الزهراء","يا إلهي أشتكي من دائي",108,"ا",2,0],["وهزني ادكارك في خلاء","وفي حشد الملا أي اهتزاز",109,"ز",1,0],["وهزَّ العِدا من حسنِ صبرِك صعدةً","فقد عَلِموا بالهزِّ كيفَ ثباتُها",110,"ت",3,0],["وهُزِلتُ أن سَمِنَ اللئامُ وإنما","ذلُّ المطامع حزَّ عزَّةَ جَوْعتي",111,"ي",1,0],["وهزّوا القنا الخطّار والبيضَ دونها","فمَن طالبٌ والمانع الطعنُ والضربُ",112,"ب",1,0],["وهززن غُلْباً في السُّروج كأنما","أغمادهمْ شُعَلُ الحريقِ المُضْرمِ",113,"م",1,0],["وهزَّ مطاردَ أغصانِه","وجعَّد من مائه ما اطرَّد",114,"د",1,0],["وهز قدود البان ناشئة الصبا","كما هز عطف الشرب قهوة بابل",115,"ل",1,0],["وهزمنا بها الألوف كما في ا","مال من شأنهنَّ هزم الألوف",116,"ف",1,0],["وهزَّ الصّبي منهنَّ في معرك النّوى","قدودَ قناً قلبي بهنَّ طعين",117,"ن",1,0],["وهزّتِ الخُرَّدُ الهيفُ الحِسانُ لَنا","قاماتهِنّ فخِفنا دولةَ الأسَلِ",118,"ل",1,0],["وهزّ قَوامَهُ فثَنى قضيباً","إليهِ تنقّلتْ دولُ العوالي",119,"ل",2,0],["وهزَزتُم على الخُطوبِ رِماحاً","فشكَكْتُم صُدورَها في شَباها",120,"ا",3,0],["وهزّ على الكُماةِ قُطوفَ لُدْنٍ","فدلّتْ من جَماجِمهم ثِمارا",121,"ر",2,0],["وهزوا أنابيب القنا حول ضيغم","يرشحهم للكر في ساعة الفر",122,"ر",1,0],["وَهزّوك مسنونَ الغِرارين أُخلصتْ","نَواحيهِ وَاِجتاحَتْ قَذاه الوقائعُ",123,"ع",1,0],["وَهَزُّوا العَوالي مِنْ أَكفٍّ قَوابِضٍ","رِقابَ المعالي بالسُّيوفِ القَواضِبِ",124,"ب",1,0]]}