{"poems":[[85,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[54,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[102,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[112,"قلاده وخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=8424",""],[173,"أأسكت عن مولى الورى أم أعاتبه","https://www.aldiwan.net/poem1603.html",""],[308,"يقولون إذ أنشدت شعر معذبي","https://www.aldiwan.net/poem57572.html","الطويل"],[385,"لقد علمت يقينا بعدما رحلوا","https://www.aldiwan.net/poem49251.html","البسيط"],[567,"الحمد لله حل العقدة الزمن","https://www.aldiwan.net/poem52766.html","البسيط"],[5050,"أللمجد بالناس ينتظر السعدد","https://www.poetsgate.com/ViewPoem.aspx?id=38202",""],[5956,"الحواسّ النامية","https://www.poetsgate.com/ViewPoem.aspx?id=182664",""]],"verses":[["أللمحةٍ من بارقٍ مُتَبَسِّمِ","أرسلتَهُ دمعاً تضرَّجَ بالدمِ",0,"م",1,1],["أَلِلمَنزِلِ بِالحَنوِ","وَمَغنى الطَلَلِ النَضوِ",1,"و",1,1],["اللموت أولاد وعم وأخوة","-وأم بسن العشق زرقاء ناهد",2,"د",1,0],["اللّمّه اللي نصفها.؟ نسل جدّي","كنها على جرحي تعزم وتعاتم..",3,"م",1,0],["أَلِلمدحِ أَم لِلبَيتِ أَم لِسوالِفٍ","عَلَت أَم لِوُدٍّ لَم يحُل عَنهُ صاحِبُهْ",4,"ب",2,0],["أللمتنبي ما تقول فقلت لا","ولكنه والله شعرُ حبيبي",5,"ي",1,0],["اللمحب فُؤاد غَير ما حَرقت","نار الصُدود وَدينار البين تَشتَعل",6,"ل",1,0],["اللَّمْعُ فرعُ الشِّهابِ المُستضاءِ بهِ","والفرعُ يَبطُلُ حينَ الأصلُ يَعتلِنُ",7,"ن",1,0],["أللمجد بالناس ينتظر السعدد","وعن منزل العلياء يقعدنا البعد",8,"د",1,1],["اللمس يمدُّ أناملَهُ","يلتذُّ بلحم النِّسوانِ",9,"ن",1,0]]}