{"poems":[[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[567,"أغر له خلق تهلل بالبها","https://www.aldiwan.net/poem52709.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72499","الطويل"]],"verses":[["فكَّاهُ كالعصرين من دهره","كلاهما في شأنه دائبُ",0,"ب",1,0],["فَكّاهُ طَرف لِمَن يُشافِهُهُ","كَأَنَّما الجَنَّتانِ فَكّاهُ",1,"ا",2,0],["فُكاهةٌ من لَدُنْه","ونكتةٌ من لدُنّي",2,"ن",2,0],["فكاهةُ خُلقٍ مذْ تبدَّى جَمالُها","أضاءتْ بآلاءٍ غَوادٍ رَوائحِ",3,"ح",1,0],["فكاهنهم ذكرى حبيب ومنزل","وراحهم دمع به الوجد يضرم",4,"م",1,0],["فكاهته منها العقول كم اجتنت","ثمارا بأيدي الفكر طابت مجانيها",5,"ي",3,0]]}