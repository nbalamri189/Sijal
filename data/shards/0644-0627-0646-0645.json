{"poems":[[68,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[102,"يوم 13 حزيران 1974م","https://www.poetsgate.com/ViewPoem.aspx?id=50461",""],[113,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[125,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[234,"للعيد في كل عام","https://www.aldiwan.net/poem51272.html","المجتث"],[242,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[354,"إذا كان الخلا منه محالا","https://www.aldiwan.net/poem15824.html","الوافر"],[376,"سهرت اهتماما بالعيون السواهر","https://www.aldiwan.net/poem57388.html","الطويل"],[385,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[409,"مذ سمعوا مدحي لدهر أهله","https://www.aldiwan.net/poem33988.html","الرجز"],[423,"ليت رقيبي لم يكن أحولا","https://www.aldiwan.net/poem4103.html","السريع"],[469,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[470,"سلام على بغداد مرة أخرى","https://www.aldiwan.net/poem61435.html","عموديه"],[487,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[505,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87058","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77673","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202079","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74329","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145879","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135942","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135975","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127285","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54445","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35423","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35459","المجتث"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120507","الطويل"],[4767,"نور الكون","https://www.poetsgate.com/ViewPoem.aspx?id=179802",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5129,"إلى أمي ... عيونك إرهاص لقافيتي","https://www.poetsgate.com/ViewPoem.aspx?id=120506",""],[5168,"ضيعته الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=33609",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5281,"قانون الصُّحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199349",""],[5389,"رواية الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=213987",""],[5736,"لا نمت","https://www.poetsgate.com/ViewPoem.aspx?id=208261",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["لا نَملِكُ الدَمعَ وَالأَحزانُ تَملِكُنا","إِنَّ الزَمانَ الَّذي قَد كانَ يُضحِكُنا",0,"ن",2,0],["لأن من كانوا مضوا وانثنوا ،","طائفة ولّت بدت طائفه",1,"ف",2,0],["لَأَن مَنَحنا يَلحَظ مِن مَواهبهِ","نِلنا الثُريا وَكانَ الخَير عُقبانا",2,"ن",2,0],["لأنَّ ما عاينوا بعض الذي بهم","من سِرِّهِ وهم لم يأتهم عشُرُ",3,"ر",1,0],["لِأَنَّ مَن قَد رَأَينا مِن أَماجِدِكُم","بِبَعضِهِم يَكتَفي السامي عَلى الأُوَلِ",4,"ل",1,0],["لِأَنَّ مَن يَتَوَلّى الأَمرَ بَعدَهُمُ","لَيسُوا بِمَأمُونِ شَرٍّ في نَواحينا",5,"ن",2,0],["لأنّ منك استعار الزْ","زَمانُ حُسْنَ حُلاَه",6,"ا",2,0],["لأَِنَّ مُجْتَثَّشِعْرِي","يُدْلِي بِعَيِّي وَضَعْفِي",7,"ف",2,0],["لِأَنَّ مِن مالِيَ ما بِالرُبى","إِخراجُهُ في شَعبِهِ يَربو",8,"ب",2,0],["لِأَنَّ مُفيدَ أَنفُسِنا هُداها","مُجانِبُ ذاتِهِ عَنّا الضَلالُ",9,"ل",1,0],["لأَنمُلِهِ لا لِلِّقا طاعَةُ الرَّدى","وللسَّاعِدِ المَعروفُ لا للبَواتِرِ",10,"ر",1,0],["لِأَن مَع المَحبة كُل شَيء","حَقير إِن فَكرت لَهُ جَزيل",11,"ل",1,0],["لأن من يحقر فهو ظافر","عما قريب ظافر بنجحه",12,"ح",2,0],["لِأَنَّ مَن يُبصر من واحدٍ","شَيئين أولى الناس أن يُحذَرا",13,"ر",2,0],["لأنملهِ ضرب العروض وقبضها","وللنحو من أفعالها الضمُّ والجزمُ",14,"م",1,0],["لأنَّ مَسارَ الأرض ِ..اللهُ وَحدَهُ","كفيلٌ بهِ..يُعْلي ، وَيُخْلي ، ويَملأ ُ",15,"ا",1,0],["لأن ما سمعنا أن داع صفت له","محاسنه من دون لمز مخاتل",16,"ل",1,0],["لأنَّ مِثلي وعَزيزِ قَدْرِهم","لِرُتبةِ الحُبِّ لهُمْ لم يَصْلُحِ",17,"ح",1,0],["لأن من أقام في جماعته","من بعده طاعته كطاعته",18,"ه",1,0],["لأن من قد خالف الرسولا","خالف فيما أجمعوا التنزيلا",18,"ل",2,0],["لأن من قد جاء بالفرضين","كلاهما يستوجب الأجرين",18,"ن",1,0],["لأن منهم في الذي قد نشهده","من ليس يدري علم شيء يقصده",18,"ه",1,0],["لأن من يعتقد الضلالة","لا يثبت الناس له مقاله",18,"ه",1,0],["لِأَنَّ مدحك يا نعم الوَزير غَدا","فرضا عَلى كُل مَولى ناطق بِفَم",19,"م",1,0],["لِأَن مَن مِن دَأبِه الخِيانَه","لا يَستَحِقّ الحفظ وَالصِيانَه",20,"ه",1,0],["لأن مَعَالمَ دِينِ الهُدى","لدَيْهِ وأعلامَ طُرْقِ الصَّواب",21,"ب",1,0],["لأن ما كانَ مِن الأَمر عَجَب","لا يَقتَضي في حكمة العَقل الغَضب",22,"ب",1,0],["لأن من الأنثى له نصف مالها","ومن ذكرٍ نصفٌ مع النصفِ تجمعُ",23,"ع",1,0],["لأَنَّ مَركَبَك قَطَع ثمانيه","أزوامِ لَم تَنقُصَ بل هي وافية",24,"ه",1,0],["لأَنَّ مَا هُم يَنقَسِم أقسَام","فَالنِيّلُ مِنهَا جَاذِبٌ لِلشَّام",25,"م",1,0],["لأن من زَفرتي الحَديد وَأَما","عاذِلي بِالَّذي أَروم فلالا",26,"ل",2,0],["لأَن ما نالَها قَد كانَ مِن أَسَف","حُزناً وَبِالماء ما بِالنار مِن ضرم",27,"م",1,0],["لا نماء لا حياة","في بلاد المعجزات",28,"ت",1,0],["لأنَّ ما أردت أن يعمَّرا","أعمرتَ إذْ أنت الذي تُعَمِّرا",29,"ر",2,0],["لأن ما أعطيته لا يُمنَعُ","وأنت تخفضُ وأنت ترفعُ",30,"ع",1,0],["لأنّ محمداً فينا فلسنا","وإن جلّت مصيبتنا نُبالي",31,"ل",2,0],["لأَنَّ مِثلَ الشَّىء دُونَ لَبسٍ","لَهُ مُسَاوٍ فى صِفَاتِ النّفسِ",32,"س",1,0],["لأن مُعجِزَاتِ غَيرِهِ انقَضَت","بِعَصرِهِم كمَا مَشِيئَةق قَضَت",32,"ت",1,0],["لأَنَّ مَن أحَاطَ بِالخَبِىِّ","عِلماً حَبَاهُم صُحبَةَ النَّبِىِّ",32,"ب",2,0],["لأن مذاقه وشذاه يزري","بشهد رضابهن ونشرهن",33,"ن",1,0],["لأَنَّ مذابَ الشَّهدِ فيه مجسّدٌ","أَجدّ له عهدُ الرَّحيقِ المعتَّقِ",34,"ق",1,0],["لِأَنَّ مَوتَ الكَئيب الصَبّ في كَبِدٍ","عَن صِدقِهِ في الهَوى مِن أَوضَحِ الحُجَجُ",35,"ج",1,0],["لِأَنَّ ما قَد رَآهُ","مِن أَوَّلٍ هُوَ آخِر",36,"ر",1,0],["لِأَنَّ ما كانَ مِنهُ","عَن رُتبَةِ العَبدِ قاصِر",36,"ر",1,0],["لِأَنَّ مُدرِكَ الأَنوارِ مِن عَينِ نورِهِ","عَلى قَدرِهِ يَبدو لَهُ في الحَقيقَةِ",37,"ه",1,0],["لان مناها ان يزيد نموه","نماء بها يؤتى جنى المغانم",38,"م",1,0],["لأَن مَن يَجْهلِ الإيمانَ حاربَهُ","وفي طريقِ الهُدَى أفْخاخَه نَصَبا",39,"ب",2,0],["لاَنِمَالُ الشقوق تُعصَمُ منها","لا ولا في البروج صيدُ القياصر",40,"ر",1,0],["لَا نِمْتُ لَا صَالَحَتْ نَفْسِي مَضَاجِعُهَا","وَجَفْنُ غَالِيَتِي الْمَقْرُوحُ لَمْ يَنَمِ",41,"م",1,0],["لان مرة عليه سنين وعوام","متوسد الصبر وبأيدي جمره",42,"ر",2,0],["لا نماري ولا نداجي كبيرا،","أو صغيرا، والحق فينا منار",43,"ر",1,0],["لأنّ ما يغليكْ إلا شَنَب","عزيزْ في فعله مراقب",44,"ب",1,0],["لان من المشاعر تنبع الدمعات","وهيه الخلت لسان الدمع ناطق",45,"ق",1,0],["لا نمتُ ملءَ العينِ أكتحلُ السنا","إن بتَّ يوما بالتأرقِ تصطلي",46,"ي",1,1],["لأنَّ مَجدَكَ أعلى مِن تَهافُتِهمْ","وكونِ صرحِكَ للأكوانِ ميزانا",47,"ن",2,0],["لأنّ ما فيهِ نداءٌ سما","وأنّ ما فيكَ ثَمالٌ يليقْ",48,"ق",1,0],["لأن مقام الرسل دق عن الإدرا","ك ليس لكل الخلق ذوق الرسالتي",49,"ت",2,0],["لِأَن مراد النَفس من أَعظَم البَلا","إِذا سَولت للمرء مال هيام",50,"م",1,0],["لِأَن مراد النَفس من أَعظَم البَلا","إِذا سَولت لِلمَرء شَيء صَغي لَها",51,"ل",3,0]]}