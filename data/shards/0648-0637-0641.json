5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5596,"رد على قصيدة حمزة بن عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=206717",""],[5638,"رثاء البطل عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203607",""],[5701,"قلت يوما لامرئٍ رحّالة","https://www.poetsgate.com/ViewPoem.aspx?id=164631",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5818,"أنتِ السعد والبلوى","https://www.poetsgate.com/ViewPoem.aspx?id=193229",""],[5830,"وَ كُنْتُ السَّمَاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=200774",""],[5853,"(((((هل تذكرين)))))","https://www.poetsgate.com/ViewPoem.aspx?id=175684",""],[5893,"جدة مآآآآسي غير","https://www.poetsgate.com/ViewPoem.aspx?id=141386",""],[5943,"ليت الذي خطف المنام يعيدُه","https://www.poetsgate.com/ViewPoem.aspx?id=11709",""],[5956,"التفرد","https://www.poetsgate.com/ViewPoem.aspx?id=185591",""],[5956,"لم ألقَ حسناءً عليّ تجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=182620",""],[6019,"الأَربَعُونَ ... رِوَايَةٌ أُخرَى","https://www.poetsgate.com/ViewPoem.aspx?id=71121",""],[6031,"عَزيزٌ أَمرُنا لَكَ بالتعزِّي","https://www.poetsgate.com/ViewPoem.aspx?id=46290",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6106,"طيفها الساحر !","https://www.poetsgate.com/ViewPoem.aspx?id=6312",""],[6127,"النذير","https://www.poetsgate.com/ViewPoem.aspx?id=215049",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""],[5190,"فلسطين الحبيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78341&r=&rc=54",""],[6346,"لك الله ياغزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83385&r=&rc=1",""]],"verses":[["وَطِفلَ الدُجى في حُجورِ البِلا","دِ يَطعَمُ بِالفَجرِ مُرَّ الفِطامِ",0,"م",1,0],["وَطُفنا بِعادِيِّ البِناءِ مُحَجَّبٍ","نَرى عِندَهُ أَعمالَنا وَثَوابَها",1,"ب",3,0],["وطَفِقْتُ أفْرُقُ وهْيَ طائِشةُ الخُطا","لِمَمَ الدُّجى بِيَدِ الصّباحِ الموفي",2,"ف",2,0],["وَطَفِقتُ أَنتَهِبُ الخُطا مُتَيَمِّماً","بِاللَيلِ دارَ رِعايَةِ الأَطفالِ",3,"ل",1,0],["وَطُفتَ وَكَم طافَت بِسُدَّتِكَ المُنى","وَكَم أَمسَكَ الراجي بِها وَتَحَرَّما",4,"م",2,0],["وَطفلَة مِثلَ حُسنِ الشَمسِ إِذ برزت","كَأَنَّما هيَ ياقُوتٌ وَمُرجانُ",5,"ن",1,0],["وطفقت أستقري المنازلَ بعدهم","يمحو البكاءُ مواقع الأثارِ",6,"ر",1,0],["وطفقت أدّكر العرا","ق فعاد صفوي ذا كدور",7,"ر",1,0],["وطفقت أرشف ريقه عن ثغره","حتى شفيت جوى الهوى برشيفه",8,"ف",2,0],["وطفقتَ تُوعدُهُ بكلِّ عظيمةٍ","لنميمةٍ جاءتْ مجيءَ ظَنين",9,"ن",1,0],["وطفقت أسال كل ذى ثقة","حتى نظرت بصدغك القلما",10,"م",2,0],["وَطَفِقتُ كَالظَمآنِ مُلتَمِساً","لِلآلِ في الدَيمومَةِ القَفرِ",11,"ر",1,0],["وطفقت أنظر في خلال سطوره","نظر المريض إلى وجوه العود",12,"د",1,0],["وَطُفْنا في البلاد طوافَ قَوْمٍ","يريح نفوسهمْ تَعَبُ الجسومِ",13,"م",1,0],["وطُفْتُ بقبرِكَ طَوْفَ الخَيَالِ","بصومعةِ المُلْهَمِ المُبْدِعِ",14,"ع",1,0],["وَطَفِقتُ أُذكيها وَأَذكُرُ ذِهنَهُ","فَإِخالُ ذاكَ وَهَذِهِ مِن عُنصُرِ",15,"ر",1,0],["وَطَفِقتَ تَهذي بِالعُهودِ وَقَد أَبى","عَهدُ السِياسَةِ أَن يَكونَ مَصونا",16,"ن",2,0],["وَطَفقت أَسأل يَومه فَإِذا بِهِ","يَومٌ لَعمر المَوت أَبكم أَسوَد",17,"د",1,0],["وَطَفِقتَ يَلقاكَ الصَّدِيقُ مُعادِياً","والسِّلْمُ حَرْباً والنَّصِيرُ خَذُولا",18,"ل",2,0],["وطفِقْتُ أسألُ عن أغرَّ محَجَّلٍ","فإذا الأنامُ جِبِلّةٌ دَهماء",19,"ا",2,0],["وَطِفلُ الحُبِّ أَضناني","فَوَيلٌ لي إِذا شَبّا",20,"ب",2,0],["وَطِفلُ الفارِسِيِّ لَهُ وُلاةٌ","بِأَفعالِ التَمَجُّسِ دَرَّبوهُ",21,"ب",3,0],["وطف ببغداد وابحث في مقابرها","عل امرءاً من بني العباس تلقاه",22,"ا",2,0],["وطَفْلَةٍ غَبيْر جُبَّاءٍ ولاَ نَصَفٍ","مِنْ سِرِّ أَمْثَالِهَا بَادٍ ومَكْتُومُ",23,"م",1,0],["وطَفَا فَوقَها فَقاقِيعُ كَال","ياقُوتِ حُمرٌ يَزينُها التَّصفيقُ",24,"ق",1,0],["وطُفِ المَنَاجِمَ كَمْ أسىً","مِنْهَا وَكَمْ خَطْبٍ نَجَمْ",25,"م",1,0],["وَطِفْتُمْ فِي خَمَائِلِهِ","فَسَادَتْ نَفْحَةُ الْعِطْرِ",26,"ر",1,0],["وَطفْلُهُمْ ضَارِعٌ إِلَى مَنْ","إِذَا بَرِيءٌ دَعَا أَجَارْ",27,"ر",1,0],["وَطِفْلَةٍ مَا عَربَدَتْ عَيْنُهَا","لَكِنَّ سُقْماً لَوْنُهَا الأَحْمَرُ",28,"ر",1,0],["وَطَفا السرورُ على الْوُجُو","هِ ودَبَّ ما بَيْنَ السرائِرْ",29,"ر",1,0],["وطفتم حوْلَ شيخٍ عبقريٍّ","فألقيتم بكفْيِّهِ الزِماما",30,"م",2,0],["وطف ببغداد وابحث في مقابرها","علّ امرأً من بني العباس تلقاه",31,"ا",2,0],["وطُفْ دَهْراً فقد كرَّتْ دهورٌ","على الدُّنيا ، وأحرارٌ تطوف",32,"ف",1,0],["وطف أبي الجيش الجواد يكره","مدافعه عن دير مران أو مقرى",33,"ر",2,0],["وطفقتَ تُوعدُهُ بكلِ عظمة ٍ","لنميمة ٍ جاءتْ مجيءَ ظَنين",34,"ن",1,0],["وطفلةً مثل حسنِ الشمسِ إذ طلعت","كأنما هي ياقوتٌ ومرجانُ",35,"ن",1,0],["وطُفِّفَ يومَ الطَّفِّ كَيْلُ دِمائكم","إذ الدم جار فيه والدمع جامدُ",36,"د",1,0],["وَطفل وَهُوَ أَكبَر مَن نَراهُ","رَفيع الشَأن مَعروفاً مَقامُهُ",37,"م",2,0],["وَطَفَقت أَسأَل عَن كَريم قيلَ لي","اليَوم غَير أَشحة لا يُخلَقُ",38,"ق",1,0],["وطفقت ارفل بالمسرة منشدا","بيتا افاض الى الفؤاد صفاء",39,"ا",2,0],["وطفقت أقطف من شقائق خدّها","ولكم رشفت رضابها المعسولا",40,"ل",2,0],["وَطَفْلَةٍ أَشرقت شمساً فما سفرت","إلاَّ أعارت رداءَ الجونة الطفلا",41,"ل",2,0],["وطفقت اكتمه الهوى فوشى به","سقمي ودمعي قد غدا يتبرد",42,"د",1,0],["وطفلة في المنظر","وغادةً في المخبر",43,"ر",1,0],["وَطَفَت مُقلَتاه فَوق مِياه ال","نَهرِ وَالنَهرُ سائِرٌ في أَمانِه",44,"ن",2,0],["وطف حيث بيت الربّ معمور فيضه","به واستلم ركن التجلّي بصورة",45,"ه",1,0],["وطف بركن الحيّ وانزل به","فكلّ من قد حلّه في أمان",46,"ن",1,0],["وَطف القدوم هناك واسع مهرولا","في المروتين وَلب وادع معظما",47,"م",2,0],["وَطُفْتَ بِدَوْحَةِ الْعَلْياءِ حَتّى","خَلَسْتَ بِكَيْدِكَ الْغُصْنَ النَّضِيرا",48,"ر",2,0],["وطفنا بها مستأنسين بقربها","وتقبيل خال الخد يا سعد من دنا",49,"ن",2,0],["وطفلٍ يباركُ ميلادَهُ","حنانٌ من الأمِّ والوالد",50,"د",1,0],["وطفل كريحانةٍ في علاه","بناه وهدّمَه والداه",50,"ه",1,0],["وطفلٍ تخِفُّ لدى ذكرهِ","قلوبُ المساكين من شعبِه",50,"ه",1,0],["وطفلٍ تموتُ على مهده","منى الأمس والغدِ والحاضر",50,"ر",1,0],["وطفل يفىءُ بآماله","إلى ظلّ والده الباسِق",50,"ق",1,0],["وطفلٍ يسير إلى قبره","ولمّا يزل في ضمير الغيوب",50,"ب",1,0],["وَطُف بِها سَبعاً وَقِف مُستَكنِفاً","لَهيبَةَ العِزِّ بِها وَاِخضَع وَذُل",51,"ل",1,0],["وَطُف بِكؤوسها فَلَقد تَجلّت","نُجوماً لَيسَ يحجبهن رانُ",52,"ن",1,0],["وَطُفت بِبَيت اللَه يا بَيت سرِّهِ","وَأَوسَع فَضلٍ نالَ مَن طافَ أَو سَعى",53,"ع",2,0],["وطفنا سبوعاً كل ركن تحية","ونمسحه قدرائن أو ثنا",54,"ن",2,0],["وطفنا بها والطيب رائد أمرنا","فمن عنبر ذاك ومسك ومن ند",55,"د",1,0],["وَطَفتْ فوقَه بطونُ حَبابٍ","أْطبَقَتْ حملها على الرضراض",56,"ض",1,0],["وطفقْتُ أُعلي بالبيان إلى مدىً","جاري الفصيحُ إليه مثلُ الأعْجمِ",57,"م",1,0],["وطِفقتُ أحتثُّ النياقَ طلائحاً","تَطوي البلادَ مشارقاً ومغاربا",58,"ب",2,0],["وطفلة كقضيب البان منعطفاً","إذا مشت وهلال الشهر منتقبا",59,"ب",2,0],["وطفلٍ يتّقيْ بردَ الشتاءِ","بثوبٍ خيطَ من دفءِ المشاعرْ",60,"ر",1,0],["وطفت سبعاً حولها لاثماً","يمين ربي هيئة المستبيح",61,"ح",1,0],["وطفنا ببيت العز في ذلة الهوى","وقمنا بفرض في المحبة واجب",62,"ب",1,0],["وطَفِقْت أَجْرِي خَلفَه","من ساعَتي وهلُمَّ جرًّا",63,"ر",2,0],["وطَفَّ غَيرِي وما لَحِقْتُ به","لا يَسْتوي الأَشقياء والسُّعدا",64,"د",2,0],["وطُف بقبرٍ بِه صنو النبيّ ثوى","طوعاً لتدرك فيه غاية الأملِ",65,"ل",1,0],["وَطُف حولَ قبرٍ بهِ المُرتضى","وصيّ النبيّ البشير النذيرِ",66,"ر",1,0],["وَطِفلُكُمُ عَلَيهِ الجُودُ حَتمٌ","وَكَهلُكُمُ عَلَيهش الجُودُ حَتمُ",67,"م",1,0],["وطفل على الغبراء تنظر وجيه","كشقة بدر بأثريا مقرطق",68,"ق",1,0],["وَطفقت أَخترقُ الصُفوف وَأَصطَلي","نار الجَوى في حَومة الجوَلان",69,"ن",1,0],["وَطف بجاماتها وَالليل منسدلٌ","فَما عَلَيك إِذا ما طفت مِن باس",70,"س",1,0],["وَطفيلة تَبكي بِدَمع هاطل","فَوقَ الخُدود لِقَطع حَبل غِذاء",71,"ا",2,0],["وَطَفَْرةُ الحبِّ لا يَخ