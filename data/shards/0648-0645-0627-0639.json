مجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[48,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[58,"أُغَمِّضُ عَيْنِي فيْ أُمُوْرٍ كَثِيْرَة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22705",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[45,"تُرَى اللّيلُ يَقضِي عُقبَةً من هَزِيعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31215",""],[46,"إذا قيل لك: اخشَ اللَّه","https://www.poetsgate.com/ViewPoem.aspx?id=16597",""],[28,"وما عن قلى عاتبت بكر بن وائل","https://www.poetsgate.com/ViewPoem.aspx?id=22042",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[85,"عظيمُ الناسِ من يبكي العظاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9653&r=&rc=143",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""],[103,"ملكنا هذه الدنيا قرونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74369&r=&rc=2",""]],"verses":[["وَما عَدِمَ العُلى كَهلاً وَطِفلاً","وَفي خِرَقِ الوَليدِ وَلا جَنينا",0,"ن",2,0],["وَما عَطَلَ المَرءِ يُزري بِهِ","إِذا كانَ طَوقُ وَريدَيهِ صِل",1,"ل",1,0],["وَما عَلى الأَكعُبِ أَن","تَنحَطِمُ العَوامِلُ",2,"ل",1,0],["وَما عاقَني رَبعٌ فَبِتُّ وَلَم تَبِت","يُوَقِّعُني مِن غَيرِ ذاكَ المَطامِعُ",3,"ع",1,0],["وَماعِندَ أَملاكِ الطَوائِفِ حاجَتي","إِذا ما أَبَت أَن تَقتَضيها القَواطِعُ",3,"ع",1,0],["وَما عَلَيكَ وَنَفسي فيكَ واحِدَةٌ","إِذا تَلَوَّنَ في أَلوانِهِ الشَعَرُ",4,"ر",1,0],["وَما عَدِمَ المَجدَ مُستَأسِدٌ","يَبُلُّ القَنا بِالدَمِ المائِرِ",5,"ر",1,0],["وَما عَلِموا أَنّا إِلى غَيرِ ريبَةٍ","بَقاءَ اللَيالي نَغتَدي وَنَؤوبُ",6,"ب",1,0],["وَما عِفَّةُ الإِنسانِ إِلّا غَباوَةٌ","إِذا لَم يُكافِح داءَ وَجدٍ مُغالِبِ",7,"ب",1,0],["وَما عَلِمتْ أَنَّ العَفافَ سَجيَّتي","وَصَبْري على رَيْبِ الزَّمانِ جَميلُ",8,"ل",1,0],["وَمَا عَلِمَتْ أَنَّ السُّيوفَ تَشَبَّثَتْ","بِأَذْيالِ شَمْطاءِ القُرونِ عَوانِ",9,"ن",1,0],["وما عَلِمَتْ أَنِّي لأَمْرٍ أَرُومُهُ","أَطوفُ وَراجِي اللهِ ليسَ يَخيبُ",10,"ب",1,0],["وما عَلِقَتْ حَربٌ تُلَقَّحُ للرَّدى","بأصْبَرَ منْهُ في اللِّقاءِ وأشجَعا",11,"ع",2,0],["وَما عابَ الزَمانُ عَلَيَّ لَوني","وَلا حَطَّ السَوادُ رَفيعُ قَدري",12,"ر",2,0],["وَما عَن قِلىً مِنّي وَلا عَن مَلالَةٍ","وَلَكِنَّني أُبقي عَليكِ وَأُشفِقُ",13,"ق",1,0],["وَما عَرَضَت لي نَظرَةٌ مُذ عَرَفتُها","فَأَنظُرُ إِلاّ مُثِّلَت حَيثُ أَنظُرُ",14,"ر",1,0],["وَمَا عَرَفَتْ نَفْسِي آَلَذَّ مِنَ اللِّقَا","وَأنْدَى عَلَى الأَكْبَادِ مِنْ سَاعَةِ الْقُرْبِ",15,"ب",1,0],["وَما عِندَهُ مَجدٌ تَليدٌ وَلا لَهُ","مِنَ الريحِ فَضلٌ لا الجَنوبُ وَلا الصَبا",16,"ب",2,0],["وما عَرَتْه شَكوكٌ في خَليفَتِه","ولا ارتَضَى إمَرةَ الجَرّاحِ تَمويها",17,"ي",3,0],["وَما عَجولٌ عَلى بَوٍّ تُطيفُ بِهِ","لَها حَنينانِ إِعلانٌ وَإِسرارُ",18,"ر",1,0],["وَمَا عَنَيْتُ حَبِيباً","حَاشَا وَفَاءِ حَبِيبِ",19,"ب",1,0],["وَمَا عدِمَتْ مُوَاسَاةْ","مَفَاخِرُهَا تُواسِيهَا",20,"ي",3,0],["وَمَا عَلَى النورِ إِذَا سَطَّرُو","عَلَيْهِ عَيّباً بِمِدَادِ الظُّلَمْ",21,"م",1,0],["وَمَا عَرِفْتِ بِغَيْرِ","التَّقْوَى وَحُسْنِ الخِلاَلِ",22,"ل",1,0],["وما عشتُ بعد البين إلا لأنني","أرجّي بفضل الله منه التلاقيا",23,"ق",3,0],["وما عِشت أني قد تناسَيت عهده","ولكنَ صبري في الخطوب جميل",24,"ل",1,0],["وما عجبي في الدهر إلاّ لواحد","وأن كثرت في كل يوم عجائبه",25,"ب",2,0],["وما عاب الفتى جسمٌ هزيل","إذا ما كان ذا شرفٍ وديك",26,"ك",1,0],["وما علموا أن المباني كلّها","وإن قويت تفنى وذكرك لا يفنى",27,"ن",2,0],["وما عسى تغني وقد حشرجت","ندامةٌ ليست إذاً تنفع",28,"ع",1,0],["وَماعَدَلَت ذاتُ الصَليبِ ظَعينَةً","عُتَيبَةُ وَالرِدفانِ مِنها وَحاجِبُ",29,"ب",1,0],["وَما عابَ الجِلاءَ ظُهورُ عِرقٍ","إِذا اِجتُلِيَت وَلا قَلَقُ السِوارِ",30,"ر",1,0],["وَما عابَكَ اِبنَ السابِقينَ إِلى العُلا","تَأَخَّرُ أَقوامٍ وَأَنتَ مُقَدَّمُ",31,"م",1,0],["وما عجبتُ لدهرٍ ذبتُ منه أسىً","لكن عجبتُ لضدٍّ ذاب من حسد",32,"د",1,0],["وما عرفتْ يومي ندًى وشجاعة","بأخلاقِ موعودٍ ولا متوَعد",33,"د",1,0],["وما عجيب لشخصٍ ذاب أكثره","وإنما عجبي للبعض كيفَ بقي",34,"ي",1,0],["وما عن رضىً خفَّ القطين ثنيَّة","فأثبت في جسمي الضنا ومحاكا",35,"ك",2,0],["وما على ظاهريٍّ من محاسنها","إني على الصبرِ فيها أيّ معتزل",36,"ل",1,0],["وما عسى ذوي المديح تحمل من","طيبه في الثنا وتمامه",37,"م",2,0],["وما عَجِبنا وإن أصبحتَ تُعجبنا","أن يُجتبى ذهبٌ من مَعْدِنِ الذهبِ",38,"ب",1,0],["وما عدوتَ من الآراء أصوبَها","عند امرئٍ كان ذا عقلٍ وذا أدبِ",38,"ب",1,0],["وما عقربٌ أدهَى من البين إنه","له لَسْعةٌ بين الحشا والترائبِ",39,"ب",1,0],["وما عنْدَ الرَّحَى بُقْيَا","إذا دَارتْ على القَمْحِ",40,"ح",1,0],["وما عَجَبٌ أن كان ذاك فإنه","إذا المرء أشْوَتْهُ الحوادثُ شَيَّخَا",41,"خ",2,0],["وما علا شأنه لِجُودٍ","كلّا ولكن علا فجادا",42,"د",2,0],["وما عذر من ضلَّ الهدى وأمامَهُ","ضياءُ شهاب في دُجى الليل واقِدِ",43,"د",1,0],["وما على من يراك في زمنٍ","أن لا يرى نوْره ولا زَهره",44,"ر",2,0],["وما على المُقرض القر","ضَ لومةٌ حين يقضي",45,"ض",2,0],["وما عذرُ ذي شيبٍ يلوحُ سِراجُه","إذا هو أمسى وهو في الإثم وارطُ",46,"ط",1,0],["وما على عبد أخي طاعة","ضيعه مولى ولم يرعه",47,"ع",2,0],["وما عطرت أثوابها إذ علتكمُ","ولا حسنت في عين راء دروعها",48,"ع",3,0],["وما عدمت وجعاءُ عبدون سلحةً","ولا طهرت إلا وفحل يقوعها",48,"ع",3,0],["وما علي بن عبد الله إن وُرِدت","جَمّاتُه بثماد الضحل تُنتزفُ",49,"ف",1,0],["وما عِيبَ شعرٌ بعيبٍ له","كأن يُبتَلى برجال السّفالِ",50,"ل",1,0],["وما عجبٌ أن خانتِ الماء رَملةٌ","ولا مُنكَرٌ أن ضَيّع الماءَ غِربالُ",51,"ل",1,0],["وما عليَّ ملامٌ إنني رجلٌ","ظمئْتُ خمساً ولم أشرعْ على وَشَلِ",52,"ل",1,0],["وما عذرُ عافٍ لا يؤمُّكَ زائراً","ولو لم يجد إلا ظهور الشياهمِ",53,"م",1,0],["وما عَفْوي لشيْء غيرَ أنِّي","أرى لحمَ اللئيمِ أغثَّ لحم",54,"م",1,0],["وما عند أربعةٍ منهمُ","أبى اللَّه عدة أركانها",55,"ن",3,0],["وَما عَلَقَت نَفسي بِأُمِّ مُحَلِّمٍ","وَدَهماءَ إِلّا أَن أَهيمَ وَأَكمَدا",56,"د",2,0],["وَما عَجَبتُ أَن لَيسَ في القَومِ نادِبٌ","وَلَكِن عَجيبٌ أَن أَرى غَيرَ باسِمِ",57,"م",1,0],["وَما عُدتَ حَتّى كافدَ يَشتَجِرُ القَنا","لِأَجلِكَ وَالخَطي أَعدَلُ حاكِمِ",57,"م",1,0],["وَما عَزَّ قَدرُ الأَديبِ الحُرِّ بَينَهُمُ","إِلّا كَما عَزَّ قَدرُ الحَيِّ في الرِمَمِ",58,"م",1,0],["وَما عِفتَ الوَداعَ قِلىً وَلَكِن","أَرَدتَ وَلَم يُرِد دَهرٌ ضَنينُ",59,"ن",1,0],["وَما عادَةٌ خَفضُ الرِجالِ رُؤوسَها","وَلَكِنَّما في الأَرضِ كَنزُ الجَواهِرِ",60,"ر",1,0],["وَما عَيشُ الغَريبِ بِلا عِيالِ","كَعَيشِ القاطِنينَ ذَوي العِيالِ",61,"ل",1,0],["وَما عَلى البَدرِ إِذا","أَسرَعَ إِن أَبطا زُحَل",62,"ل",1,0],["وَما عَهِدتُكَ إِلّا","مِن أَكرَمِ الناسِ خُلقا",63,"ق",2,0],["وَماعاقَني عَنكُم سِوى السَبتِ عائِقٌ","فَفي السَبتِ قالوا ما يُعادُ مَريضُ",64,"ض",1,0],["وَما عابَها القَدُّ الطَويلُ وَإِنَّهُ","لَأَوَّلُ حُسنٍ في المَليحَةِ بادي",65,"د",2,0],["وما عن قلى رفضي الغلاة وانما","هنالك اميال تخالف اميالي",66,"ي",1,0],["وما عاش مجهول المكان محقر","وما مات مرفوع المنار معظم",67,"م",1,0],["وما عرفتم لغير مصر","وغير أحبابها ولاء",68,"ا",2,0],["وما عضضت بحار","ولا هممت بجاره",69,"ر",2,0],["وَما عَلوا لَهُ مِن المُهمَّة","وَبَذَلوا مِن مُدهِشات الهمّه",70,"ه",1,0],["وَما عُذرُ المُقَصِّرِ عَن جَزاءٍ","وَما يَجزيهُمو إِلى كَلاما",71,"م",2,0],["وَما عَلِمتُ رَفيقاً غَيرَ مُؤتَمَنٍ","كَالمَوتِ لِلمَرءِ في حِلٍّ وَتِرحالِ",72,"ل",1,0],["وَما عَرَضتَ عَلى الأَلبابِ فاكِهَةً","كَالعِلمِ تُبرِزُهُ في أَحسَنِ القالِ",72,"ل",1,0],["وَما عاقَني غَيرُ خَوفِ الوُشاةِ","وَإِنَّ الوِشاياتِ طُرقُ الكَذِب",73,"ب",1,0],["وَما عَدِمَ اللاقوكَ بَأساً وَشِدَّةً","وَلَكِنَّ مَن لاقَوا أَشَدُّ وَأَنجَبُ",74,"ب",1,0],["وَما عَلَيكَ مِنَ القَت","لِ إِنَّما هِيَ ضَربَه",75,"ب",2,0],["وَما عَلَيكَ مِنَ الغَد","رِ إِنَّما هُوَ سُبَّه",75,"ب",2,0],["وَما عَلَيكَ مِنَ العا","رِ إِنَّ أُمَّكَ قَحبَه",75,"ب",2,0],["وَما عَلى مَن بِهِ الدا","ءُ مِن لِقاءِ الأَطِبَّه",75,"ب",2,0],["وَما عِشتُ ما ماتوا وَلا أَبَواهُمُ","تَميمُ بنُ مُرٍّ وَاِبنُ طابِخَةٍ أُدُّ",76,"د",1,0],["وَما عَفَتِ الرِياحُ لَهُ مَحَلّاً","عَفاهُ مَن حَدا بِهِمِ وَساقا",77,"ق",2,0],["وَمَا عِشْتُ مِنْ بَعدِ الأحِبّةِ سَلوَةً","وَلَكِنّني للنّائِبَاتِ حَمُولُ",78,"ل",1,0],["وَما عَزَّهُ فيها مُرادٌ أَرادَهُ","وَإِن عَزَّ إِلّا أَن يَكونَ لَهُ مِثلُ",79,"ل",1,0],["وَما عاقَهُ أَن يَطعُنَ الخَيلَ مُقدِماً","عَلى الهَولِ فيها أَنَّهُ باتَ يَكتُبُ",80,"ب",1,0],["وَما عَدَلَت عَنكَ القَصائِدُ مَعدِلاً","وَلا تَرَكَت فَضلاً لِغَيرِكَ يُحسَبُ",80,"ب",1,0],["وَما عَزَّيتُ إِلّا بَحرَ عِلمٍ","نُطيفُ بِفَيضِهِ عَن بَحرِ جودِ",81,"د",1,0],["وَما عارَضَتني كُديَةٌ دونَ مَدحِهِم","فَكَيفَ أَراني دونَ مَعروفِهِم أُكدي",82,"ي",1,0],["وَما عَن أَبي الصَقرِ اِرتِيادٌ لِموجَعٍ","مِنَ الكَلمِ لا يَأسوهُ غَيرُ أَبي الصَقرِ",83,"ر",1,0],["وَما عَلِيُّ بنُ عَبدِ اللَهِ إِن وُرِدَت","جَمّاتُهُ بِثِمادِ الضَحلِ مُنتَزَفُ",84,"ف",1,0],["وَما عايَنوا شَمسَينِ قَبلَهُما التَقى","ضِياؤُهُما وَفقاً مِنَ الغَربِ وَالشَرقِ",85,"ق",1,0],["وَما عَشِقَ الناسُ الأَحِبَّةَ عِشقَهُم","لِكِثرٍ جَديدٍ مِن جَداكُم وَمُخلِقِ",86,"ق",1,0],["وَماعَداكَ فَشَيءٌ لَستَ تَعدَمُهُ","وَسَوفَ تَقبِضُهُ مِن عاجِلٍ نَفَقَه",87,"ق",2,0],["وَما عَمَّهُم عَمرُو بنُ غَنمٍ بِنِسبَةٍ","كَما عَمَّهُم بِالأَمسِ نائِلُكَ الجَزلُ",88,"ل",1,0],["وَما عامُكَ الماضي وَإِن أَفرَطَت بِهِ","عَجائِبُهُ إِلّا أَخو عامِ قابِلِ",89,"ل",1,0],["وَما عوقِبَت عُصبَةٌ آمَنَت","عَلى كُفرِها بَعدَ إيمانِها",90,"ن",3,0],["وَما عُذرُهُم في أَن تَغِلَّ صُدورُهُم","عَلى ناشِرِ الإِحسانِ فيهِم مُشيعِهِ",91,"ع",2,0],["وَما عَدَّ مِن نُعمى اِمرُؤٌ مِن عَشيرَةٍ","لِوالِدِهِ عَن قَومِهِ كَبَلائِها",92,"ا",3,0],["وَما عَدَّ ذو فَضلٍ عَلى أَهلِ نِعمَةٍ","كَفَضلُكَ عِندي حينَ عَبَّت عَواقِبُه",93,"ب",2,0],["وَما عامِرٌ مِن دارِمٍ غَيرَ أَنَّها","قَشائِرُ أَعيا نَوؤُها وَهوَ ثائِرُ",94,"ر",1,0],["وَما عِندَ عَبّادٍ لَهُم مِن كَريهَتي","رَواحٌ إِذا ما الشَرُّ عَضَّت رَجائِلُه",95,"ل",2,0],["وَما عَن قِلىً عاتَبتُ بَكرَ اِبنَ وائِلٍ","وَلا عَن تَجَنّي الصارِمِ المُتَجَرِّمِ",96,"م",1,1],["وَما عَلِمَ الرَقوامُ مِثلَ أَسيرِنا","أَسيرَن وَلا إِجدافِنا بِالكَواظِمِ",97,"م",1,0],["وما على عرضك مما","ينظمون واقيه",98,"ي",2,0],["وما عَدَمي لِفَقْدِ الما","لِ لَكِنْ فَقْدُهُ عَدَمي",99,"ي",1,0],["وما عَدِمَتْ مُغيراً منكَ يَرمي","رقيقَ طباعِها بطباعِ جَافي",100,"ي",1,0],["وما عاقَني يومَ العقيقِ عن الجَوى","سُفورُ دُمىً أبدَتْ لبَيْنٍ سُفورَها",101,"ر",3,0],["وَما عَيشُها إِلّا لَيالٍ قَلائِلُ","سِراعٌ وَأَيّامٌ تَمُرُّ قِصارُ",102,"ر",1,0],["وَما عَلَّمَتني حِكمَةً غَيرَ أَنَّني","أُديمُ مَطالَ الجوعِ حَتّى أُميتَهُ",103,"ت",2,0],["وَما عَيشي بِها جَهماً وَلَكِن","رَأَيتُ الزَينَ بَعدَكَ غَيرَ زَينِ",104,"ن",1,0],["وَما عَلِموا أَنّي حَمَيتُ ذِمارَهُ","عَنِ العارِ لَم أَذهَب بِهِ كُلَّ مَذهَبِ",105,"ب",1,0],["وَما عابَني نَظمُ القَريضِ وَمَذهَبي","رَفيعٌ وَقَلبي في الوَغى غَيرُ قُلَّبِ",105,"ب",1,0],["وَما عابَني جاري سِوى أَنَّ حاجَتي","أُكَلِّفُها مِن دونِهِ لِلأَجانِبِ",106,"ب",1,0],["وَما عابَني أَن كَلَّمَتني سُيوفُهُم","إِذا ما نَبَت عَنّي سُيوفُ المَثالِبِ",106,"ب",1,0],["وما عتبنَا على حبيبٍ","لكن عتبنَا على القضاء",107,"ا",2,0],["وما عتبت ولا خانت","ولكن خانك الحظّ",108,"ظ",1,0],["وما عقَدَ الرايات إلّا تَحلّلَتْ","به عُقَدُ الآراءِ بين القبائِلِ",109,"ل",1,0],["وما علمتُ بجهلٍ أنَّ ريقتها","تُعْطي السلامةَ ريَّ المندل العبقِ",110,"ق",1,0],["وما على النَّاسِ في إِحسانِ مملكةٍ","إذا تشاجرَ فيه المدّ والحَسَرُ",111,"ر",1,0],["وَما عَلى الأَرضِ وَالمَأمونُ يَملِكُها","أَن لا تُضيءَ لَنا شَمسٌ وَلا قَمَرُ",112,"ر",1,0],["وَما عارِضٌ عُنوانُهُ البيضُ وَالقَنا","أَخو عارِضٍ عُنوانُهُ البَرقُ وَالرَعدُ",113,"د",1,0],["وَمَا عَهْدِي بِهِ غِرّاً وَلَكِنْ","تَوَلَّتْ أَمْرَ فِطْنَتِهِ الْحُمَيَّا",114,"ي",2,0],["وما عنْ رضى كانتْ سواها بديلةً","لها غيرَ أنَّ الدهرَ ما زالَ مدحِضا",115,"ض",2,0],["وما عَرفَ الأقوامُ باباً يَسُرُّهم","من الخير إلا في يَدَيْكَ مَفاتِحُهْ",116,"ح",2,0],["وما عبدُ المجيدِ بذي خَفَاءٍ","ولا هو ريبةُ المتوهِّمينا",117,"ن",2,0],["وَما عابَ عَهدَ العُربِ في الناسِ عائِبٌ","وَلا لامَهُم يَوماً عَلى الغَدرِ لائِمُ",118,"م",1,0],["وَما عاهَدتُ مَن أَهواهُ حَتّى","وَفَيتُ بِعَهدِهِ وَقَضيتُ نَذري",119,"ر",2,0],["وما على الحقِّ من بأسٍ ولا حَرَجٍ","إن هَوَّمَ العقلُ عنه مَرَّةً فَغَفَا",120,"ف",2,0],["وما عانيت من قتلٍ وأسرِ","وَراءَك إنّها الأقدارُ تجري",121,"ي",1,0],["وَمَا عَن قِلىً فَارَقتُ ذَاك وَإنَّمَا","شَرِيعَةُ مُوسَى عُطِّلَت بِمُحَمَّدِ",122,"د",1,0],["وَما عَرَضَت لي خَطرَةٌ مُذ بَعُدتُم","فَلَم يَكُ إِلّا نَحوَكُم عَفوَ خاطِري",123,"ي",1,0],["وَما عِشتُ حَتّى الآنَ إِلّا لِأَنَّني","خَفيتُ فَلَم يَدرِ الحِمامُ مَكاني",124,"ي",1,0],["وَما عَلى الشَمسِ في أَن لاحَ رَونَقُها","فَأَنكَرَتهُ العُيونُ الرُمدُ نُقصانُ",125,"ن",1,0],["وَما عُذرُ أَرضٍ أُشرِبَتهُ فَأَنبَتَت","نَباتاً وَلَم تُنبِت ذَكاءً وَلا حَزما",126,"م",2,0],["وَما عَن قِلىً قَد كانَ ذاكَ وَإِنَّما","شَريعَةُ موسى عُطِّلَت بِمُحَمَّدِ",127,"د",1,0],["وَما عَتبت عَلى هَجر تدلُّ بِهِ","إِن الد لال يمنيني وَيغريني",128,"ي",1,0],["وما عُلَماؤُنا إلا سُيوفٌ","مَواضٍ لا تُفَلُّ لها غُروبُ",129,"ب",1,0],["وما عادَ يُبلِي بعدَ ذلك مَيِّتاً","ضَرِيحٌ وَلا يَشْكُو المَرِيضَ سَرِيرُ",130,"ر",1,0],["وَما على قَوْلِ كَعْبِ أَنْ تُوازِنَهُ","فَرُبَّمَا وَازَنَ الدُّرَّ المَثاقِيلُ",131,"ل",1,0],["وما عابَها من نائبات وعُود","سوى انني في بحرهنّ غريق",132,"ق",1,0],["وما عَذُبَ المِسواكُ إلاّ لأنّهُ","يُقبّلُهَا دُوني وإنّي لَراغِم",133,"م",1,0],["وما عاثَ فيهِمْ مِقْوَلٌ مثلُ مِقوَلي","ولا لاحَ فيهم مِيسَمٌ مثلُ مِيسَمي",134,"م",2,0],["وما عَرَفَتْ كَرَّ الجِيادِ أُمَيّةٌ","ولا حملَتْ بَزَّ القَنا وهو شابك",135,"ك",1,0],["وما عبِتُهُ إلاّ بأني وصَفتُهُ","وشبّهْتُهُ يوماً من الدهرِ بالقَطر",136,"ر",1,0],["وما عنْ أمانٍ يومَ ذاكَ تَنَزَّلوا","ولكنْ أمانُ العفوِ أدركهُم بَعْد",137,"د",1,0],["وَما عَلِمَت بِأَنّي أَريَحِيٌّ","أُحِبُّ مِنَ النَدامى ذا اِرتِياحِ",138,"ح",1,0],["وَما عَرَفَت ناراً وَلا قِدرَ طابِخٍ","سِوى حَرَّ شَمسٍ إِذ تَهيجُ سَمومُ",139,"م",1,0],["وَما عَن نائِلٍ كَلَفي وَلَكِن","شَقيتُ بِها وَمُزنَتُها جَمادُ",140,"د",1,0],["وَما عِرسِيَ حَوراءُ","وَلا خُبزِيَ حَوّارى",141,"ر",2,0],["وَما عَلِمَت رَوحٌ بِجِسمي دُخولَها","إِلَيهِ فَهَل يُخفى عَلَيهِ خُروجُها",142,"ج",3,0],["وَما عَفَتِ الحَوادِثُ عَن شُجاعٍ","فَتَعفو عَن عُتَيبَةَ أَو دُرَيدِ",143,"د",1,0],["وَما عَلِمَ الأَغراضَ خاطِرُ حِندِسٍ","يُعِدُّ لَهُ غاوٍ يُعانِدُهُ الخِطرا",144,"ر",2,0],["وَما عاشَرتَ في الدُنِّيا خَليلاً","يُريكَ مَوَدَّةً إِلّا لِقَمَرِ",145,"ر",1,0],["وَما عَتَّرَت رِماحُ الدَهرِ إِلّا","لَعَترِ سِوايَ دائِبَةً وَعَتري",146,"ر",2,0],["وَما عِندَ خِلِّكَ غَيرُ النِفاقِ","وَما خِلتُهُ ناسِياً فَاِدَّكَر",147,"ر",1,0],["وَما عالَمي إِن عِشتُ فيهِ بِزائِدٍ","وَلا هُوَ إِن أُلقيتُ مِنهُ بِناقِصِ",148,"ص",1,0],["وَما عاقَ لِبَّ الفيلِ عَن ذِكرِ اهلِه","وَمَغناهُ إِلّا ضَربُهُ بِالمَطارِقِ",149,"ق",1,0],["وَما عَزَفَت مِزهَراً في الحَيا","ةِ وَلا الدَنُّ يُفتَحُ أَو يُبزَلُ",150,"ل",1,0],["وَما عِندَهُ عِلمٌ فَيُخبِرها بِهِ","وَلا هُوَ مِن أَهلِ الحِجى فَيُرَجِّما",151,"م",2,0],["وَما عِندَهُم مِن خيرَةٍ لِمَعاشِرٍ","وَكَم مِن مُدامٍ بَرَحَت بِمُديمِ",152,"م",1,0],["وَما عُيونُ الناسِ فيما أَرى","مُنتَبِهاتٍ مِن طَويلِ السِنَه",153,"ن",2,0],["وَما عَنَيتُ سِوى تُربٍ تُغَيِّرُني","فيهِ أُفارِقُ تَحريكي وَتَسكيني",154,"ن",2,0],["وَما عافَتهُ لَكِن عَيَّفَتهُ","وَماِنتَقَت عُلاهُ بَلِ اِنتَقَتهُ",155,"ت",2,0],["وَما عَلافِيُّها إِلّا يُجِدُّ لَها","ذَمّاً عَلى فَيَّ أَو ذَمّاً عَلى فيها",156,"ي",3,0],["وَما عِندي بِما لَم يَأتِ عِلمٌ","وَقَد أَلوى بِأُنمُلِهِ الرَبِيُّ",157,"ب",2,0],["وَما عَدَلَت نَفسي بِنَفسِكَ سَيِّداً","سَمِعتُ بِهِ بَينَ الدَراهِمِ وَالأَدَم",158,"م",1,1],["وَمَا عُمُري إِلاَّ كَدَعوَةِ فارِطٍ","دَعا راعِياً ثمَّ اِستمرَّ فأَدبَرا",159,"ر",2,0],["وَما عُلِمَت مِن عُصبَةٍ عَرَبِيَّهٍ","كَمِيلادِنَا مِنّا أَعَزَّ وَأَكبَرا",159,"ر",2,0],["وَما عَصَيتُ أَمِيراً غَيرَ مُتَّهَمٍ","عِندي وَلكِنَّ أَمرَ المَرءِ ما ارتَجَلا",160,"ل",2,0],["وما عاقَهُ عنها عوائقُ ملكهِ","وأمثالُه عن مِثلهنَّ تَعوقُ",161,"ق",1,0],["وَما علموا أنا أناس نمتهمُ","إلى العز أنسابٌ لهم لا تُضيَّع",162,"ع",1,0],["وما عرفوا عنك نقصَ التمام","وبيعَ الصحيحة بالزائفَه",163,"ف",2,0],["وَما عَرَّ جَوّاسُ اِستَها إِذ يَسُبُّهُم","بِصَقرَي بَني سُفيانَ قَيسٍ وَعاصِمِ",164,"م",1,1],["وَمَا عَقَدَ الرِّجَالُ الْوُدَّ إِلَّا","لِنَفْعٍ أَوْ لِمَنْعٍ مِنْ تَعَادِي",165,"د",2,0],["وما عَلَيْكِ وفي الأَسْمَاءِ مُشْتَرَكٌ","إِنْ قالَ في الشِّعْرِ يا لَيْلَى وَلَمْ يَعِبِ",166,"ب",1,0],["وَمَا عَهْدُهُ إِنْ مَحَّصَتْهُ حَقِيقَةٌ","بِزَيْفٍ وَمَا مِيْثَاقُهُ بِكِذَابِ",167,"ب",1,0],["وَمَا عَتَّمَ الكوْنُ حَتَّى سَجَا","سِوَى خَطَرَاتِ النَّسِيمِ العَلِيلْ",168,"ل",1,0],["وَمَا عَيْنُ شَمْسٍ غَيْرُ مَا ارْتَجَلَ النُّهَى","بِقَفْرِ جَدِيبٍ مِنْ مَبَانٍ وَأَغْرَاسِ",169,"س",1,0],["وَمَا عَصى فِي سَبيلِ","الْحصَافَةِ الأَهْوَاءَ",170,"ا",2,0],["وَما عَلى الدَهرِ ذَنبٌ","فَيُلزَمُ الإِعتِذارُ",171,"ر",1,0],["وما عَقِمَتْ أُمُّ اللُّغَاتِ ولا خَلَتْ","خَمائِلُها منْ سَجْعِ كلِّ مُطَوَّقِ",172,"ق",1,0],["وما عالَمٌ لم يصقل الشعر ذوقه؟","وما أُمَّةٌ لم تعلُ فيها منابره",173,"ر",2,0],["وما عرفت ناراً ولا قدر طابخٍ","سوى حر شمس أو نهب سموم",174,"م",1,0],["وَمَا عَنْ عَمًى أُغُضِي وَلَكِنْ لَرُبَّمَا","تَعَامَى وَأَغْضَى المَرْءُ وَهْوَ بَصِيْرُ",175,"ر",1,0],["وما عُدِم الهناءُ بها . ولكنْ","تُنوزِعَ فيه فاحتُكِر الهناء",176,"ا",2,0],["وَمَا عُذْرُهُمْ في أنْ تُعَلّ صُدُورُهمْ","على ناشرِ الإحْسانِ فيهِمْ، مُشيعِهِ",177,"ع",2,0],["وما عِرسيَ حوراءُ،","ولا خُبزيَ حُوّارا",178,"ر",2,0],["وَمَا عَنْ قِلىً عاتَبْتُ بكَر بنَ وَائِلٍ،","وَلا عَنْ تَجَنّي الصّارِمِ المُتَجَرِّمِ",179,"م",1,1],["وما عجِبنا وإن أصبحتَ تُعجبنا","أن يُجتنى ذهبٌ من مَعْدِنِ الذهب",180,"ب",1,0],["وما عدوتَ من الآراء أصوبَها","عند امرىء كان ذا عقلٍ وذا أدبِ",180,"ب",1,0],["وما عُذرُ المقصِّر عن جزاءٍ","وما يَجزِيهُمُ إلا كلاما؟!",181,"م",2,0],["وما عدت حتىّ كاد يشتجر القنا","لأجلك والخطى أعدل حاكم",182,"م",1,0],["وما عرفوا الأغاني مائعات","ولكن العلا صنعت لحونا",183,"ن",2,0]]}