{"poems":[[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[53,"نزا بعض المجانين","https://www.aldiwan.net/poem65865.html","الهزج"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[47,"حلي سعاد غروض العيس أو سيري","https://www.aldiwan.net/poem63624.html","البسيط"],[69,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[8,"زمير الهبانيق في زمخر","https://www.aldiwan.net/poem21798.html","المتقارب"],[22,"ألا أبلغَ بني عوف بن كعبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18927",""],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[242,"يا أيها البحر مهلا","https://www.aldiwan.net/poem18847.html","المجتث"],[275,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[331,"تبدت فقلت الشمس عند طلوعها","https://www.aldiwan.net/poem44265.html","الطويل"],[376,"من أنت من مضر الحمراء واليمن","https://www.aldiwan.net/poem57065.html","البسيط"],[422,"إلى شعبان مولاي المفدى","https://www.aldiwan.net/poem54139.html","الوافر"],[457,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[566,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96981","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70679","المجتث"],[1350,"","https://poetry.dctabudhabi.ae/diwan/poem/202214","الوافر"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110674","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11957","المتقارب"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45365","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26426","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87760","الطويل"],[3448,"","https://poetry.dctabudhabi.ae/diwan/poem/76773","المتقارب"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200313","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91839","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117878","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33470","المتقارب"],[4620,"","https://poetry.dctabudhabi.ae/diwan/poem/199979","الطويل"],[4767,"مجنون العرب","https://www.poetsgate.com/ViewPoem.aspx?id=178506",""],[4785,"الفتنة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=129733",""],[4958,"الشيءْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53952",""],[4966,"الأصلُ والفرعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196675",""],[5010,"معزوفة الريح","https://www.poetsgate.com/ViewPoem.aspx?id=189856",""],[5030,"سهر","https://www.poetsgate.com/ViewPoem.aspx?id=215698",""],[4119,"إن الألى جمعتهم والنوى دار","https://www.poetsgate.com/ViewPoem.aspx?id=16140",""],[5725,"ادمنت حبك","https://www.poetsgate.com/ViewPoem.aspx?id=190606",""],[6125,"فُؤادِي جَذوَةٌ وَهَوَاكِ زَيتُ","https://www.poetsgate.com/ViewPoem.aspx?id=207909",""]],"verses":[["فَلَما كَسا اللَيلُ الشُخوصَ تَحَلَّبَت","عَلى ظَهرِهِ إِحدى اللَيالي المَواطِرِ",0,"ر",1,0],["فلما كثُر القيل","على المجنونِ والقالُ",1,"ل",1,0],["فلم أكُ ممنْ حاصَ عن غمراتِه","ولا غاصَ فيها حيث غاصَ المغمَّمُ",2,"م",1,0],["فَلِم أُكَلِّفُ نَفسي ما أُكَلِّفُها","مِنِ اِتِّصالاتِ تَغليسي وَتَهجيري",3,"ر",2,0],["فَلَمْ أَكُنْ أَتْبَعُ العَذُولَ إلَى","عَقْدٍ إذا ما دُعَاؤُهُ خُطْبَهْ",4,"ب",2,0],["فلَمّا كَسَعتُهُمُ بالرِماحٍ","أَخلَّوا إِليهِنَّ حوماً دِحاسا",5,"س",2,0],["فلما كنتُ جَارَكُمُ أَبَيْتُمْ","وشَرُّ مَواطِنِ الحَسَبِ الإِبَاء",6,"ا",2,0],["فَلَم أكُ لِلخُطُوبِ ِإذَا أدلَهَمَّت","كَئِيبَ البَالِ عَضَّاضَ البَنَانِ",7,"ن",1,0],["فَلَمَاكَ يَمْتَهِنُ السِّوَاكَ وَلاَ رَشاً","يُغْنِي لَمَاهُ عَنِ السِّوَاكِ سِوَاكَا",8,"ك",2,0],["فلم أك مثلَ الرّكبِ يوماً صريعَها","ولكنّني ثبَّتُ عَزمي بإقدامي",9,"م",2,0],["فَلَمّا كَرَرتُ الطَرفَ قُلتُ لِصاحِبي","عَلى مِريَةٍ ما ها هُنا مَطلَعُ الشَمسِ",10,"س",1,0],["فلَم أكُن أرهبُ الحيَّينِ قاطِبةً","وقَد رأيتُكَ تَلقاني وترهَبُني",11,"ن",2,0],["فلم أكْشِفْ لهم عن كُنْهِ أمري","وأطْلِعْهم على ما في ضميري",12,"ر",2,0],["فلم أَكُ أن أرى من بعدها في","نساء الحيّ أحسنَ من حُلاها",13,"ا",3,0],["فلماكِ يُبرِدُ صدرَه","ولحاظُ عينكِ تُحرِقُهْ",14,"ق",2,0],["فلم أكنْ شحمةً لمُزْدَرِدٍ","كلّا ولا مضغةً لمن ضغما",15,"م",2,0],["فلم أكُ إلّا موقداً في ظهيرةٍ","بلا صَرَدٍ أو هاتفاً في تنائفِ",16,"ف",1,0],["فَلَم أَكُن أَستَنطِقُ العُذّالا","مِن أَن يَرَوني لِلخَنا قَوّالا",17,"ل",2,0],["فلماك عندي والطلى","كلتاهما حلب العصير",18,"ر",1,0],["فلم أكنْ داخلاً في","غير الْهَنِيِّ المرِيِّ",19,"ي",1,0],["فلم أك نأنأ يا أم عمرو","إذا نزلت بساحتي الأمور",20,"ر",1,0],["فلم أك أحظى بالذي قد طلبته","وقصر بي حظي كقصر صلاتي",21,"ي",1,0],["فَلَمّا كَبِرتُ نَتَفتُ البَياضَ","وَقَد صارَ بَعدَ الجَنى الغَضِّ ليفا",22,"ف",2,0],["فَلَم أَكُن وَسِوى بَغدادَ لي أَمَلٌ","فيها كَما كُنتُ في أَهلي بِمُغتَربِ",23,"ب",1,0],["فلما كاد حكم السيف يمضي","وولى الجمع واستبقوا الخياما",24,"م",2,0],["فَلَمّا كَمَلتَ لِميقاتِهِ","وَقَلَّدَكَ الأَمرَ إِذ قَلَّدا",25,"د",2,0],["فلم أكن بدعائي","إيّاك ربِّ شقيّا",26,"ي",2,0],["فَلَمّا كَشَفنَ اللِّبسَ عَنهُ مَسحنَهُ","بِأَطرافِ طفلٍ زانَ غَيلاً موشَّما",27,"م",2,0],["فَلم أَكُ مزداداً رُسوخَ عَقيدة","بِأَنَّ المَنايا لا يُراع لَها لُبُّ",28,"ب",1,0],["فَلَمّا كثرنَ وَعَنَّينَهُ","تَخَيرَّ مِنهُنَّ سِتا جِيادا",29,"د",2,0],["فلم أك في الوغى زندي بكاب","وقد نادى الطميح بلا براح",30,"ح",1,0],["فلما كذَّب التجريبُ ظَني","وَعلّمني الهُدى علم الضَلال",31,"ل",1,0],["فلم أكُ إن نظمت الدر بدعا","ولست إذا مدحتهم كذوبا",32,"ب",2,0],["فلم أكن عنه ذا سلوّ","ولو بدا منه ما يضر",33,"ر",1,0],["فلم أكتئِب عندَ وَعثائهِ","ولم أمرحِ العيشَ في سهلهِ",34,"ل",2,0],["فلما كتمت الحب قالت: لشد ما","صبرت وما هذا بفعل الشجي القلب",35,"ب",1,0],["فلما كاد يهوي من أمورٍ","أتاها بان منه الارتداد",36,"د",1,0],["فلما كنتُ منجذباً إليها","ومِلْتِ إلي ّ بالقدِّ الرشيق",37,"ق",1,0],["فَلَمْ أَكُ في النّدى لِتَقول:ماءٌ","وَلَمْ أَكُ في اللّظى لِتَقول:نارُ",38,"ر",1,0],["فلما كدتُ ... أيقنتُ !","هشيمًا كنتَ يا زرعُ",39,"ع",1,0],["فَلَمَّا كَبُرْنَا وَقَالُوْا لَنَا","فِرَاقٌ جَمِيْلٌ ، بَدَتْ نَكْسَتِيْ",40,"ت",2,0],["فلم أكنْ ذاكرًا ما كان من سهري","ولم أكنْ ناسيا ما صار من ناسي",41,"س",2,0],["فلم أكن أستثير الدهر غضبته","غلا ولي من أبي المنصور أنصار",42,"ر",1,0],["فلماك شهد مايحرّق خافقي","غير الذي ماقد اصاب من المقلْ",43,"ل",1,0],["فَلَمْ أَكُ صَابِرًا في البُعِدِ يَومًا","وكانَ هَوَاكِ أصدَقُ مَا جَنَيتُ",44,"ت",1,0]]}