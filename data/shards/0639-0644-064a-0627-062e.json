{"poems":[[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[53,"لا تغش إلا ملكا في منزلِه","https://www.aldiwan.net/poem65968.html","الرجز"],[199,"فسل هوى من لا يؤاتيك وده","https://www.aldiwan.net/poem54396.html","الطويل"],[398,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[463,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[498,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117180","الطويل"],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5648,"انا احترم بالخلا ماطاك","https://www.poetsgate.com/ViewPoem.aspx?id=164274",""],[5848,"طير في قفص","https://www.poetsgate.com/ViewPoem.aspx?id=51962",""]],"verses":[["على أخ حرٍّ كريم المنْتَجَى","لم يَنْتَقِدْهُ العلماء بَهْرَجا",0,"ج",2,0],["على أخٍ يأوي إلى تطوُّلِهْ","عن أمِّهِ وعرسه وعُدَّلِهْ",1,"ل",2,0],["عَلى أَخدَرِيٍّ لَحمُهُ بِسَراتِهِ","مُذَكّى فَتاءٍ مِن ثَلاثٍ لَهُ شُربُ",2,"ب",1,0],["عَلي أَخو خَير النَبِيّينَ فَاِخرسَوا","أَو اِستَبصروا فَالرُشدُ أَدنى وَأَقصَدُ",3,"د",1,0],["علَيَّ اختيار اختيارُ الحبيبِ","وإن خانني فإليَّ الخِيارُ",4,"ر",1,0],["عَلى اِختِلاطِ الرَوضِ بِالشَقيقِ","وَأَخضَرَ الميناءِ بِالعقيقِ",5,"ق",1,0],["عَلَى اخْتِفاءِ الْجَهَرِ","عَلَى ذَوِي التَّأَخُّرِ",6,"ر",1,0],["عَلَى أَخِلّاءِ الصَفاءِ الوُتَّنِ","بَوَّاعَ سَوارتٍ كِرِيمَ المُرْسِنِ",7,"ن",1,0],["على اختصاص أو بايّ قد يرد","ومنه ذو إضافة ايضا عهد",8,"د",1,0],["على آخرِ البشكَالِ تَلقَى قياسَهُم","إذا سَافَرَ الهندي لهُرموزَ والشّحرِ",9,"ر",1,0],["على آخَاتِ ثُمَّ فوقَ المَسكَنِ","فَآحذَرَ مِنهُنَّ هُنَا يا سَكَني",10,"ي",1,0],["علي أخي المختار ناصر دينه","وملّته يعسوبها وإمامها",11,"م",3,0],["عَلى أَخيهِ خَرَّ مِيِّتاً فَضَرَب","عُنُقَهُ بِالسَيفِ وَالرَأسِ اِقتَضَب",12,"ب",1,0],["على إخوتي منّي السلامُ تحيَّةً","تحِيَّةَ مُثنٍ بالأُخوَّةِ حامدِ",13,"د",1,1],["على أخ المختار يتلى الثنا","ما غردت قمرية تسجع",14,"ع",1,0],["على اختلاف الفكر قامت قيامه","وعلى انتهاك الدين ماحينا قام",15,"م",1,0],["على اختلاف البشر ينصاك","واحيان مكتوب ويحيني",16,"ن",2,0],["على آخر رمق ف العام جا صوتك يهنيّني","بمولد عام .. أو يمكن يواسيني على احزاني",17,"ن",2,1]]}