,[5582,"أَشَجاكَ لِعاتِكَةٍ طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=63553",""],[5609,"مملكة السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=215574",""],[5626,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=189593",""],[5736,"رسائل الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=208459",""],[5751,"قُبْلةٌ بَينَ عَينَيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214767",""],[5751,"يا أجمل الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=215022",""],[5751,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=215023",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5781,"قولي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=176234",""],[5848,"مع الإعتذار للجنة التحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=48960",""],[5848,"مترين !!","https://www.poetsgate.com/ViewPoem.aspx?id=50607",""],[5848,"جوالي وسماعته","https://www.poetsgate.com/ViewPoem.aspx?id=52030",""],[5848,"1000 تنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=53172",""],[5956,"يا شقرائي المحترمة","https://www.poetsgate.com/ViewPoem.aspx?id=182086",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[6038,"مجرد أوهام 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25701",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6221,"على ضفاف القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64920&r=&rc=0",""],[6228,"الكون لا يعنيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85981&r=&rc=18",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""]],"verses":[["يا أجلبَ الناسِ حمداً","لبابه وثوابا",0,"ب",2,0],["يا أجلَّ الذين ناديتُ في الجم","لة منْ أمره ومَن لم أُنادِهْ",1,"د",2,0],["يا أجبن الناس من ذم وأجرأهم","والجيش بالجيش في الهيجاء ملفوف",2,"ف",1,0],["يا أجرة البيت قضاء وسلف","يا ليلة الخان ذا الخان وكف",3,"ف",1,0],["يا أَجَلَّ جَوهَرَةٍ","مِن نَفيسِ جَوهَرِها",4,"ر",3,0],["يا أجبنَ الجبناء.. إقتربي","فبرقُكِ دون رعدِ",5,"د",1,0],["يا أجرة البيت قضاءً وسَلَف","يا ليلة الخانِ إذا الخانُ وكف",6,"ف",1,0],["يا أجل الأقطاب شأناً وقدراً","ومقاماً ومن علا مرقاه",7,"ا",2,0],["يا أجل العالمين أغث","بلطيف الحل للعقد",8,"د",1,0],["يا اجل الورى واوسع فضلا","بك ارجو النجاة عند المضيق",9,"ق",1,0],["يا أجمل الناس أين الناس قد تعبت","روحي من البحث عن مغناك في الناس",10,"س",1,0],["يا أجهل الأقوام خلوا","عنكمُ دعوى الفهامه",11,"م",2,0],["يا أجل القواد في الحرب شرف","فوق عين من البلاد ورأس",12,"س",1,0],["يا أَجَلَّ الناسِ قَدراً","وَاِبنَ خَيرِ الوُزَراءِ",13,"ا",2,0],["يا أَجلَّ الوَرى لديَّ ثَناءً","وأَعزَّ الأَصحاب والأَحبابِ",14,"ب",1,0],["يا أجمل الأرض .. يا من في شواطئه","تغفو وتستيقظ الآباد والأزل",15,"ل",1,0],["يا أَجودَ العالَمَ يا موجَد","الموجد بل يا مُعدِم المُعدِم",16,"م",1,0],["يا أَجمَلَ النّاس وَجهاً","بَل أَحسَنَ النّاس كُلّا",17,"ل",2,0],["يا أَجلَّ المُلوك عَقْلاً وعلْماً","مفَرَدَ السبق غَيْرَما مَلْزُوز",18,"ز",1,0],["يا أجل الأنام قدرا لقد","جل مديح نظمت فيك ودقا",19,"ق",2,0],["يا أجود الأجواد يا مولى علا","في مجده عن مشبه ونظيرِ",20,"ر",1,0],["يا أجمل خلق بدا وأحسن خلق","يا أصبح وجه أضا وافضح قوّال",21,"ل",1,0],["يا أجود من سامة الوجود غناء","يا أعبد من صام في الهجير ومن صال",21,"ل",1,0],["يا أجود كفّ ويما أجدّ جهاد","يا أفتك عضب لذي الجلاد وعسال",21,"ل",1,0],["يا أجود الناس كفا جد علي فلي","على شفاعتك العظما اعتمادات",22,"ت",1,0],["يا أجلَّ الوَرى ما ترى ما ترى الن","ناس عمّا ترى وجدي خذلُ",23,"ل",1,0],["يا اجم هدبيه ويا عقاصه","كم فيك من اسد ومن اساود",24,"د",1,0],["يا أجمل الناس في خلقٍ وأخلاق","عليك معتمدي من بعد خلاقي",25,"ي",1,1],["يا أجود الناس بما عنده","إلا إذا استعمل مرقاسا",26,"س",2,1],["يا أجل المرسلين ويا","خير من صلى ومن ركعا",27,"ع",2,0],["يا أجل الأنام شرقاً وغرباً","وكفى الله شاهداً في مقالي",28,"ل",2,0],["يا أجلَّ الورى علاءً وقدراً","وأعزّ الأنام نفساً وجارا",29,"ر",2,0],["يا أجودَ الناسِ مَن كانوا وأشجعَهُم","وأكرمَ الناسِ خلقاً بَذَّهُم خُلُقا",30,"ق",2,0],["يا أجمل الناس إلاّ حين تهجرني","إن لم تعُد لي فإنّ الموتَ أولى بي",31,"ب",2,0],["يا أَجَلَّ المُلوكِ عَمّاً وَخالاً","عِندَ ذِكرِ الأَعمامِ وَالأَخوالِ",32,"ل",1,0],["يا أجود الناس ألا في مسامحتي","البخل أجود مما ضيَّع الجود",33,"د",1,0],["يا أجل الورى وخيرَ نبيٍّ","قام فينا بِالأَمرِ خيرَ قِيام",34,"م",1,0],["يا أجل الناس عندي","لا تخيب فيك قصدي",35,"ي",1,1],["يا أجل الأنام قدرا وعلما","وكريما وفي بوعد نجاز",36,"ز",1,0],["يا أَجوَدَ الناسِ جُد لي جاءَ رَمَضانُ","وَالجودُ جودُكَ وَالإِحسانُ إِحسانُ",37,"ن",1,1],["يا أَجوَدُ الناسَ هَل من نَظرَةٍ كَرماً","تحيي مواتي بِها إِذ جاءَ رَمَضانُ",37,"ن",1,0],["يا أجوَدُ الناسَ يا سرّ الوجود أَما","من عَطفَة لِمُحبٍّ فيكَ وَلهانُ",37,"ن",1,0],["يا أجمل الناس لك بين الملا هيمنه","كثير غيرك لكن مين مثلك ووين",38,"ن",1,0],["يا أجمل الكلمات حين أقولها","يرتاح من ألم الرحيل فؤاد",39,"د",1,0],["يا أَجْمَلَ الْأَزْهارِ مِنْكِ حَدائِقي","ما أَشْرَقَتْ شَمْسي بِها لَولاكِ",40,"ك",1,0],["يا أجمل الارض ضمي ثغرها ترفا","مفهرسا بالتماع الضوء يتقدُ",41,"د",1,0],["يا أجمل الأطيار هل ذقت الضنى","أم أنت من أرض تغاير أرضنا",42,"ن",2,0],["يا أجملَ النخلِ ضُمّي بُلْبُلاً غَرِداً","فلسْتُ مِمَّنْ عليهِ يَصْعُبُ السَّعَفُ",43,"ف",1,0],["يا أجمَلَ المُدُنِ التي في ذِكرِها","يتسابقُ التُفّاحُ والرّيْحانُ",44,"ن",1,0],["ياأجمل اللعنات سحرك نافذٌ","بين الضلوع يزيدُ فيّ تحيّرا !!",45,"ر",2,0],["ياأجبن الشعراء هيتَ لنا!","واغسل أزيز الصمت والحَزَنا",46,"ن",2,1],["يا أجمل الأوتارِ في عودي ومَن","دندنتُ فيكِ، ومنكِ لحني الأمجدا",47,"د",2,0],["يا أجملَ الناسِ في عيني ويا أملي","كيفَ اللقاءُ وحبلُ الوصلِ مفقودُ ؟!",48,"د",1,0],["يا اجمل الحزن .. لدموعك سلام","من حبيبٍ ... بقى منه الكلام",49,"م",1,1],["يا أجملَ الملكاتِ في خطواتها","أسرَت بإشعاعِ الأنوثةِ مولعا",50,"ع",2,0],["يا أَجْملَ ما جادَتْ أمٌّ","مَنْ مِثْلُكَ في الخَلْقِ نَظيرُ",51,"ر",1,0],["يا أَجْملَ أُغْنِيَةٍ سُمِعَتْ","يا أَحْلَى من أَحْلَى كَلِمَة",52,"م",2,0],["يا أَجَلَّ الوَرَى ما تَرَى ما يَرَى ال","ناسُ عَمَّا تَرَى مِنْ مَدَىً خُذُلُ",53,"ل",1,0],["‏‎يَا أَجملَ الشعرِ البديعِ ورُوحِهِ","يَا خَيْرَ مَنْ حَفِظَ الْوِدَادَ وَأكْرَمَا",54,"م",2,0],["يا أجملَ امرأةٍ ماسَتْ بشاطئها","حتى غَدَتْ دجلتي للأرضِ عُنوانا",55,"ن",2,0],["يا أجملَ الشعرِ .. بل في الشعرِ أجملهُ","هلْ يستوي ملكٌ مع سائرِ البشرِ",56,"ر",1,0],["يا أجملَ البُلدانِ يا الْ تَبقى ضِياءَ","اللهِ مَهما أَوْهَنوكَ وَضَلَّلُوا",57,"ل",3,0],["يا أجمل الألوان تصنع أحرفي","أمواجهُ سبحان من سَوّاكا",58,"ك",2,0],["يا أجملَ الألحانِ في رئتي","يا مَن بها روحي ستكتملُ",59,"ل",1,0],["يا اجل الورى وملجأهم دنيا","وأخرى في سائر المعضلات",60,"ت",1,0],["يا أجْمَلَ الوَشْيِ بِالياقوتِ يا دُرَراً","قَدْ تَسْتَفيقُ على شُطآنِكِ الأُمَمُ",61,"م",1,0],["يا اجمل قصيدة شعر ما قالها انسان","ولااحتواها فكر عاقل ومجنون",62,"ن",1,1],["يا اجمل من الحلم وصروحه","واغلى من عيوني الثنتين",63,"ن",1,0],["يا اجمل ايام عمري عاشقك يفتديك","يشتري كل دمعة حزن ما باعته",64,"ت",2,0],["يا اجمل أغاني زماني / فرحته / عيده","نبضه / سكونه / جنونه / عشقي السامي",65,"م",2,0],["يا أجملَ حبٍّ ومُحَيّا","أنت الزهر يحبُّ الرِّيَّا",66,"ي",2,0],["يا أجمل الأكوان روحاً.. منظراً","وحقيقةَ وتخيلاً وعهودا...",67,"د",2,0],["يا أجمل جسمٍ وفؤادٍ","وحنانٍ يقتاد خدينكْ",68,"ك",1,0],["يا أجمل قصائد الشعر في دواويني","وأجمل من البدر في ليل التمام",69,"م",1,0],["يَا أَجْمَلَ الْمَلِكَاتِ لَنْ","يَرْوِي صَحَارِينَا السَّرَابْ",70,"ب",1,0],["يا أجمَلَ الخَلقِ سيماءً وأَظرفَهُم","طَبعاً وَأَوفاهُمُ بالعَهدِ والذِّمَمِ",71,"م",1,0],["يا أجمل إمرأة في الكون ترقبها","عيني وتلبسها من شعري الحللا",72,"ل",2,0],["يا أجمل امرأة قد سافرت بدمي","شوقي بساحرتي ما عاد محتملا",72,"ل",2,0],["يا أجمل الدنيا : إذا كنا معاً","فالكونُ كلّ الكونِ لا يعنيني !",73,"ن",2,0],["يا أجملَ الأسماءِ لو تدرينَ كيفَ..","تحيَّرت في وصفِكِ الأسماءُ",74,"ا",2,0]]}