{"poems":[[72,"يا سائلي عن أموري","https://www.aldiwan.net/poem18280.html","المجتث"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[51,"يا ابن أبي الجهم احتقب هذا اللطف","https://www.aldiwan.net/poem65467.html","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[51,"يا ابن أبي الجهم احتقبْ هذا اللَّطفْ","https://www.poetsgate.com/ViewPoem.aspx?id=29582",""],[113,"سيد الأولياء يا جداه","https://www.aldiwan.net/poem41776.html","الخفيف"],[113,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[208,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[209,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[219,"ذهب الوفاء فلا ندامه","https://www.aldiwan.net/poem55272.html","مجزوء الكامل"],[219,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[233,"يا عماد الدين يا أك","https://www.aldiwan.net/poem32195.html","مجزوء الرمل"],[295,"نفحتنا بنشرها المستطاب","https://www.aldiwan.net/poem33332.html","الخفيف"],[463,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[573,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"]],"verses":[["يا أجلبَ الناسِ حمداً","لبابه وثوابا",0,"ب",2,0],["يا أجلَّ الذين ناديتُ في الجم","لة منْ أمره ومَن لم أُنادِهْ",1,"د",2,0],["يا أجبن الناس من ذم وأجرأهم","والجيش بالجيش في الهيجاء ملفوف",2,"ف",1,0],["يا أجرة البيت قضاء وسلف","يا ليلة الخان ذا الخان وكف",3,"ف",1,0],["يا أَجَلَّ جَوهَرَةٍ","مِن نَفيسِ جَوهَرِها",4,"ر",3,0],["يا أجرة البيت قضاءً وسَلَف","يا ليلة الخانِ إذا الخانُ وكف",5,"ف",1,0],["يا أجل الأقطاب شأناً وقدراً","ومقاماً ومن علا مرقاه",6,"ا",2,0],["يا أجل العالمين أغث","بلطيف الحل للعقد",7,"د",1,0],["يا اجل الورى واوسع فضلا","بك ارجو النجاة عند المضيق",8,"ق",1,0],["يا أجمل الناس أين الناس قد تعبت","روحي من البحث عن مغناك في الناس",9,"س",1,0],["يا أجهل الأقوام خلوا","عنكمُ دعوى الفهامه",10,"م",2,0],["يا أجل القواد في الحرب شرف","فوق عين من البلاد ورأس",11,"س",1,0],["يا أَجَلَّ الناسِ قَدراً","وَاِبنَ خَيرِ الوُزَراءِ",12,"ا",2,0],["يا أَجلَّ الوَرى لديَّ ثَناءً","وأَعزَّ الأَصحاب والأَحبابِ",13,"ب",1,0],["يا أجمل الأرض .. يا من في شواطئه","تغفو وتستيقظ الآباد والأزل",14,"ل",1,0],["يا أَجودَ العالَمَ يا موجَد","الموجد بل يا مُعدِم المُعدِم",15,"م",1,0]]}