{"poems":[[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[3,"لغير العلا مني القلى والتجنب","https://www.aldiwan.net/poem127.html",""],[3,"خُسف البدر حين كان تمام","https://www.aldiwan.net/poem209.html",""],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[51,"خسأت كلبا مر بي مرة","https://www.aldiwan.net/poem11444.html","السريع"],[51,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[51,"يا ذا الذي قد حال عن عهدي","https://www.aldiwan.net/poem61903.html","السريع"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[70,"أيا باكيا لزمان الصبا","https://www.aldiwan.net/poem42382.html","المتقارب"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[45,"سل الحلبي عن حلب","https://www.aldiwan.net/poem11047.html","مجزوء الوافر"],[58,"يهددني بالعظيم الوليد","https://www.aldiwan.net/poem31163.html","المتقارب"],[49,"وكأن من دفنته أيد في الثرى","https://www.aldiwan.net/poem65328.html","الرمل"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[46,"يأتي على الخلق إصباح وإمساء","https://www.aldiwan.net/poem21995.html","البسيط"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9979","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""]],"verses":[["خَسَأَت عُيونُهُمُ وَقَد طَمَحَت لَهُ","عُدَدٌ عِراضٌ في العُلى وَعَديدُ",0,"د",1,0],["خُسِفتُم جَميعاً في بُروجِ هُبوطِكُم","جَهاراً كَما كُلُّ الكَواكِبُ تُنكَبُ",1,"ب",1,0],["خُسِفَ البَدرُ حينَ كانَ تَمام","وَخَفي نورُهُ فَعادَ ظَلاما",2,"م",2,1],["خُسِفَت ثُمَّ أُغرِقَت ثُمَّ بادَت","قُضِيَ الأَمرُ كُلُّهُ في ثَواني",3,"ن",2,0],["خَسِرَ الأُخَيطِلُ وَالصَليبُ وَتَغلِبٌ","وَيُكالُ ما جَمَعوا بِمُدٍّ خاسِرِ",4,"ر",1,0],["خَسَأْتُ كلباً مرَّ بي مرةً","فقال مهلاً يا أخا خالدِ",5,"د",1,1],["خسرتَ الدين والدنيا جميعاً","كذاك تكونُ مَنْحَسةُ الجدودِ",6,"د",1,0],["خَسَسْتُمُ القِيمَةَ يا سادتي","كأنَّما قَوَّمْتُمُ عبْدي",7,"د",2,0],["خسراً لقوم أقاموا دينهم سفهاً","فيمن يزيد بوَكْس البيع محتقر",8,"ر",1,0],["خساسةُ البيهقيِّ والبينِ","لم تُر في واحدٍ ولا اثنيْنِ",9,"ن",1,1],["خَسِرتَ الصِبا وَخَسِرتَ الشَبابَ","فَلا شَيءَ أَخسَرُ مِن صَفقَتَيك",10,"ك",1,0],["خُسِفَت بِالمَساكِنِ الأَرضُ خَسفاً","وَطَوى أَهلُها بِساطَ الإِقامَه",11,"م",2,0],["خَسَفنا بِالحُصونِ الأَرضَ خَسفاً","تَزيدُ تَأَبِّياً فَنَزيدُ قَذفا",12,"ا",1,0],["خَساراً مِنكَ لا عَقلاً","أَتَيتَ بِهِ وَلا أَدَبا",13,"ب",2,0],["خَسِرتُم بِتَكذيبِكُم لِلرَسولِ","تُعيبونَ ما لَيسَ بِالعائِبِ",14,"ب",1,0],["خَسَدٌ سَيَخرَبُ حينَ تَخرُجُ روحُهُ","كَالبيتِ يَخرَبُ حينَ يَخرُجُ ساكِنُه",15,"ه",1,0],["خَسِرتَ وَلَم تَعلَم بِأَنَّ عَزائِمي","لِأَشباحِ هَمّي بِالسُرورِ نَواسِخُ",16,"خ",1,0],["خَسِرَ الذي آذَى النَّبيَّ بِقولِهِ","ظَلَم الرجالَ ولجَّ في الإيذاءِ",17,"ا",2,0],["خُسِفَ البيتُ بالمريض ومَنْ عا","د وبالمحْصنات والأَطفال",18,"ل",1,0],["خَسِستِ يا أُمَّنا الدُنيا فَأُفِّ لَنا","بَنو الخَسيسَةِأَوباشٌ أَخِسّاءُ",19,"س",3,0],["خَسِرَ الَّذي باعَ الخُلودَ وَعَيشَهُ","بِنَعيمِ أَيّامٍ تُعَدُّ قَلائِلِ",20,"ل",1,0],["خسرت بما قد جئت داريك فاسقاً","فَليسَ لك الدنيا وليس لك العُقبى",21,"ب",2,0],["خَسِئتِ فردِّيهِ ماذا يرومُ","ألم يَبْقَ يا نارُ ما يُطعمُ",22,"م",1,0],["خَسِئتَ ولو لم يَعصِمِ الحقَّ ربُّه","طوى الأرض ليل ما تزول غياهبُهْ",23,"ب",2,0],["خُسِفَ البَدرُ حينَ كانَ تَماما","وَخَفي نورُهُ فَعادَ ظَلاما",24,"م",2,1],["خَسِرَ القضيةَ صاحبُ ال","فوزِ، المبينِ وفاز خاسر",25,"ر",1,0],["خسرناكَ كنزاً إلى مثلِهِ","إذا أحْوَجَتْ أزمةٌ يفتقر",26,"ر",1,0],["خسئوا : فَلْمْ تَزَلِ الرّجولةُ حُرَّةً","تأبى لها غيرَ الأمائِلِ خاطبا",27,"ب",2,0]]}