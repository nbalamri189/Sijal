 الجدودِ",6,"د",1,0],["خَسَسْتُمُ القِيمَةَ يا سادتي","كأنَّما قَوَّمْتُمُ عبْدي",7,"د",2,0],["خسراً لقوم أقاموا دينهم سفهاً","فيمن يزيد بوَكْس البيع محتقر",8,"ر",1,0],["خساسةُ البيهقيِّ والبينِ","لم تُر في واحدٍ ولا اثنيْنِ",9,"ن",1,1],["خَسِرتَ الصِبا وَخَسِرتَ الشَبابَ","فَلا شَيءَ أَخسَرُ مِن صَفقَتَيك",10,"ك",1,0],["خُسِفَت بِالمَساكِنِ الأَرضُ خَسفاً","وَطَوى أَهلُها بِساطَ الإِقامَه",11,"م",2,0],["خَسَفنا بِالحُصونِ الأَرضَ خَسفاً","تَزيدُ تَأَبِّياً فَنَزيدُ قَذفا",12,"ا",1,0],["خَساراً مِنكَ لا عَقلاً","أَتَيتَ بِهِ وَلا أَدَبا",13,"ب",2,0],["خَسِرتُم بِتَكذيبِكُم لِلرَسولِ","تُعيبونَ ما لَيسَ بِالعائِبِ",14,"ب",1,0],["خَسَدٌ سَيَخرَبُ حينَ تَخرُجُ روحُهُ","كَالبيتِ يَخرَبُ حينَ يَخرُجُ ساكِنُه",15,"ه",1,0],["خَسِرتَ وَلَم تَعلَم بِأَنَّ عَزائِمي","لِأَشباحِ هَمّي بِالسُرورِ نَواسِخُ",16,"خ",1,0],["خَسِرَ الذي آذَى النَّبيَّ بِقولِهِ","ظَلَم الرجالَ ولجَّ في الإيذاءِ",17,"ا",2,0],["خُسِفَ البيتُ بالمريض ومَنْ عا","د وبالمحْصنات والأَطفال",18,"ل",1,0],["خَسِستِ يا أُمَّنا الدُنيا فَأُفِّ لَنا","بَنو الخَسيسَةِأَوباشٌ أَخِسّاءُ",19,"س",3,0],["خَسِرَ الَّذي باعَ الخُلودَ وَعَيشَهُ","بِنَعيمِ أَيّامٍ تُعَدُّ قَلائِلِ",20,"ل",1,0],["خسرت بما قد جئت داريك فاسقاً","فَليسَ لك الدنيا وليس لك العُقبى",21,"ب",2,0],["خَسِئتِ فردِّيهِ ماذا يرومُ","ألم يَبْقَ يا نارُ ما يُطعمُ",22,"م",1,0],["خَسِئتَ ولو لم يَعصِمِ الحقَّ ربُّه","طوى الأرض ليل ما تزول غياهبُهْ",23,"ب",2,0],["خُسِفَ البَدرُ حينَ كانَ تَماما","وَخَفي نورُهُ فَعادَ ظَلاما",24,"م",2,1],["خَسِرَ القضيةَ صاحبُ ال","فوزِ، المبينِ وفاز خاسر",25,"ر",1,0],["خسيسة الطبع بالأكدار طافحة","ختالة تخلب الألباب بالحيل",26,"ل",1,0],["خسرناكَ كنزاً إلى مثلِهِ","إذا أحْوَجَتْ أزمةٌ يفتقر",27,"ر",1,0],["خسئوا : فَلْمْ تَزَلِ الرّجولةُ حُرَّةً","تأبى لها غيرَ الأمائِلِ خاطبا",28,"ب",2,0],["خسّرت شعر الخلق يا ابن الحلال","واللي عمل له بيت هدّمتُه عليه",29,"ه",1,0],["خسروا ولكن خالدٌ في صنِعه","عن هؤلاءِ وهؤلاءِ الأخْسرُ",30,"ر",1,0],["خسروا فلا سلمت حصونهم لهم","منكم ولا حصلوا على دبسان",31,"ن",1,0],["خسرت خالدا رفيق صباها","وع