{"poems":[[95,"وحبك يا سيدتي أمينه","https://www.aldiwan.net/poem11115.html","الرجز"],[53,"يا ذائق الموتى لتعلم هل بقوا","https://www.aldiwan.net/poem7959.html","الكامل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[71,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[193,"صلوات الثناء فيها شفاء","https://www.aldiwan.net/poem35136.html","الخفيف"],[275,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[309,"يا نديمي فؤادي مرتهن","https://www.aldiwan.net/poem16783.html","الطويل"],[376,"بينته يهوى الطيور ويو","https://www.aldiwan.net/poem57209.html","أحذ الكامل"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[385,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[473,"يا من به عاش ميت ذكرى","https://www.aldiwan.net/poem60089.html","مخلع البسيط"],[556,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[563,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95530","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94251","الكامل"],[2825,"","https://poetry.dctabudhabi.ae/diwan/poem/130730","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127376","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103432","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88930","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108259","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44680","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86378","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136875",""],[4682,"هدى غالية","https://www.poetsgate.com/ViewPoem.aspx?id=66202",""],[4702,"الشعب في غلاف الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=155323",""],[4728,"الأمل قبلة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176950",""],[4119,"أنتم كالشمس لولا خدرها","https://www.poetsgate.com/ViewPoem.aspx?id=16224",""],[572,"منْ يَتُبْ خشية َ العقابِ فإنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=25008",""],[5434,"حج الجمل","https://www.poetsgate.com/ViewPoem.aspx?id=37619",""],[5461,"ميلت نجمة حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=504",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5606,"يامرحبا ترحيبة دايم الدوم","https://www.poetsgate.com/ViewPoem.aspx?id=195279",""],[5747,"طاري الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=61613",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""],[6124,"علمتني كيف أجفو","https://www.poetsgate.com/ViewPoem.aspx?id=125190",""]],"verses":[["بَيَّنْت لِلْقَرْية وَالمَدِينَهْ","مَا بِهِمَا من قدره كَمِينَهْ",0,"ن",2,0],["بَيَّنتَ عن رِعةٍ وصدقِ أمانةٍ","لولا اتهامُك خالقَ الأشياءِ",1,"ا",2,0],["بيَّنْتِ لي الحزم في البدار إلى","كل مخُوفٍ عليه مبتدَرِ",2,"ر",1,0],["بين تلك الثيابِ أرواحُ نورٍ","علقت منهمُ بأشبال آلِ",3,"ل",1,0],["بين تقبيل وعُرْف","أوْرَقَتْ منه السِّلامُ",4,"م",1,0],["بينَ تبذيرٍ وبخلٍ رتبةً","فكلا هذينِ إنْ زادَ قتلْ",5,"ل",1,0],["بَيَّنَتْهُ تَوْراتُهُمْ وَالأَناجِي","لُ وَهم في جُحُودِهِ شُرَكاءُ",6,"ا",2,0],["بَيِّنٌ تَثْبُتُ الحَقَائِقُ فِيهِ","نَاصِعَاتٍ وَتَنْتَفِي الأَوْهَامُ",7,"م",1,0],["بيّنت فضلهُ ودلّت عليه","كم بها من مواهبٍ ودلائلُ",8,"ل",1,0],["بينَ تصويرٍ وتنغيمٍ أرى","بَهجةَ الخلد ولذَّاتِ الهوَي",9,"ي",1,0],["بين تلك المرابع والدمن","والمنازل ديار أحبابنا",10,"ن",2,0],["بيَّنتهُ يهوى الطيورَ ويُو","فيهنَّ من جَبلٍ ومِن سَهلِ",11,"ل",1,1],["بَينَ تيهٍ وَملال وَغَضَب","لي رَقيب مُنكر مَهما بَدا",12,"د",2,0],["بَين تَغير حَماما","ت وَإِنشاد رُوات",13,"ت",1,0],["بَينَ تَحايا مِنَ المَعاني","قَد أَشرَقَت في صُدورِ شِعري",14,"ر",2,0],["بين ترى في ملأٍ دارَه","حتّى تراه في صَعيدِ المَلا",15,"ل",2,0],["بين تنزيه وتشبيه له","حضرة حيرت المطَّلعا",16,"ع",2,0],["بين تلك الجموع نَدبٌ كريمٌ","حسنُ الخلق طيّبُ التّذكارِ",17,"ر",1,0],["بَينت مُعتقدي وَلَم أَكُ أَنثَني","عَنهُ وَعَن عَبد الحَميد أَنا غَني",18,"ي",1,0],["بين تبذير وبخل رتبة","هي خير للفتى حيث اعتدل",19,"ل",1,0],["بينت فيها أهل بيت نبيا","ونظمت دراً في سلوك نضار",20,"ر",1,0],["بين تمزّق من تبريحه كبدي","وسوء حال التنائي فتّ في كبدي",21,"د",2,1],["بين تهليل وتكبي","ر وتصفيق شديد",22,"د",1,0],["بين تلك الرُبى وقد نسج الوبل","بكفِّ الربيعِ رَيطَ البرود",23,"د",1,0],["بينت بالقاضي ومفتيه الهدى","يفتيه شيخ المسلمين بجهله",24,"ل",2,0],["بينٌ توقعه المحب وشد ما","هال المحبَ توقع التوديع",25,"ع",1,0],["بَينَ تَيْسَيْن مِن قبيلين قد أل","لَف رأيَيْهما إلى الدّامانِ",26,"ن",1,0],["بَينَ تِلكَ الغُصونِ تاهَت بِقَدٍ","فيهِ ميلٌ وَرقةٌ وَاِنثِناءُ",27,"ا",2,1],["بين تلك التلول ضيعت قلبا","فاقر عن نازخ الفؤاد السلاما",28,"م",2,0],["بين تؤيين خلت ظمياء ألقت","من حلي لها سواراً ووقفا",29,"ف",2,0],["بينت يا منى قلبي لعيني المثاوي","ذيك ذي ألبستني إياها هواي المهاوي",30,"ا",3,0],["بين توحيد العقيدة واختلاف الاعتقاد","دلس الكافر ودس هموم حقد دايمة",31,"م",2,0],["بين ( تمسك وانا اقطع ) فيه تاجر خشير","يرفع السعر مستامن بحضرة جناب",32,"ب",1,0],["بين تكبير ألف بائي وتهليل قلمي","اقبلت يمّي أمل والأمل قبلة أمل",33,"ل",1,1],["بين تاج لاح في وقد السنا","وكمال راح في عقد التمام",34,"م",1,0],["بينَ تلكَ الأضعافِ والاثناءِ","كِ وَمَا خِلْتُنِي مِنَ القُرَّاءِ",35,"ا",2,0],["بينت راسي للمغني وغنيت","وين انت ياللي مرمسات ديونه",36,"ن",2,0],["بينت فيني تجاريب الحياة","كل سيل حط في دربه شعيب",37,"ب",1,0],["بين تلك النجوم والشمس والبد","ر وبين الرُبا ونفح شذاها",38,"ا",3,0],["بينت شيء وشيء مخبى ومكتوم","وأقول لك رائي لو أعلنت وأبديت",39,"ت",1,0],["بين تكوين الوصال وبين همي والنضال","بين دورات الليال وبين تحقيق المصير",40,"ر",1,1],["بين تثبت الحقائق فيه","ناصعات وتنتفي الوهام",41,"م",1,0],["بَيْنَ تَجْدِيْفٍ وَ مَوْجٍ هَائِجٍ","نَالَ مِنِّيْ هُدْبُ خِلٍّ أَيْنَقُ",42,"ق",1,0]]}