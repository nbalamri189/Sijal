56,"طوبَى للمحامية هالة خضر المحمد","https://www.poetsgate.com/ViewPoem.aspx?id=214190",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[6008,"شفت الخبل","https://www.poetsgate.com/ViewPoem.aspx?id=59161",""],[6056,"موت اإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=130361",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[6106,"سقوط العاهر : امريكا","https://www.poetsgate.com/ViewPoem.aspx?id=6848",""],[6115,"الحق مايزعل يكون الهلامه","https://www.poetsgate.com/ViewPoem.aspx?id=180472",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6225,"محاسبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80910&r=&rc=179",""],[2220,"الحقُّ يعلمُ والحقائقُ تجهلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11634&r=&rc=508",""],[5190,"الحق يسطع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85053&r=&rc=128",""]],"verses":[["أُلحِقَت شَعّاعَةُ الريحِ كَما","جَرَّتِ الخَيلُ رَعابيبَ الحِلالِ",0,"ل",1,0],["أَلحَقتَ ريشَكَ في قَوادِمِهِم","عَجلانَ تُلصِقُهُ وَيَنحَصُّ",1,"ص",1,0],["الْحَقُّ يَعْلُو وَالأَبَاطِلُ تَسْفُلُ","وَاللهُ عَنْ أَحْكَامِهِ لاَ يُسْأَلُ",2,"ل",1,1],["ألحَقَكَ اللهُ بالهَوانِ ولا","رَعاكَ فيمَنْ تركْتَ منْ عُرَرِ",3,"ر",1,0],["الحَقُّ فيهِ زَيتُهُ وَفَتيلُهُ","صِدقُ الحَديثِ وَنورُهُ الإِصلاحُ",4,"ح",1,0],["الحقُّ أبلَجُ والمنجاة عن كثبِ","والأمر للهِ والعُقبى لمن صَلَحا",5,"ح",2,0],["أَلحَقنَنا بِأَبي قَبيصَةَ بَعدَما","دَمِيَ الشَكيمُ وَماجَ كُلُّ حِزامِ",6,"م",1,0],["الحقدُ داءٌ دويٌّ لا دواءَ لهُ","يَرِي الصُّدورَ إذا ما جمره حُرثا",7,"ث",2,0],["أَلحَقتَ زَيداً غَداةَ المَرجِ بِاِبنَتِهِ","إِنَّ اللَئيمَ عَلى مِقدارِهِ جاري",8,"ر",2,0],["الحَقُّ ما رَفَعَت بِهِ جُدرانُها","وَالخَيرُ ما زانَت بِهِ الأَبوابا",9,"ب",2,0],["الحقلُ يَمْلِكُهُ جَبابِرَةُ الدُّجى","والرَّوضُ يسكُنُهُ بنو الأربابِ",10,"ب",1,0],["الحق يوطأ بالاقدام منسحقا","وما هنالك يحمى الحق صنديد",11,"د",1,0],["الحق ابلج وضاح تليح به","والسيف احمر بتار يمجّ دما",12,"م",2,0],["الحق دين ولكن قل ناصره","والدين حق ولكن اهله جنفوا",12,"ف",3,0],["الحق حقك فانشديه","في محاولة طلابا",13,"ب",2,0],["الحق قد قتلوه فيه","وقد جرى دمع جبارا",14,"ر",2,0],["الحق يكسبني اليقين وضوحه","ويريبني في الباطل الابهام",15,"م",1,0],["الحق صعب طعمه","مرّ كطعم العلقم",16,"م",1,0],["ألحقوا الروس به والانكليز","واحفظوا الملك على شنك المكين",17,"ن",1,0],["إِلحَق بِأَحرارٍ مَضوا قَد أَحسَنوا","فَالمَوت مِن ذلِّ الحَياة أَحسَنُ",18,"ن",1,0],["الحَقُّ كُلُّ سِلاحِهِم وَكِفاحِهِم","وَالحَقُّ نِعمَ مُثَبِّتُ الأَقدامِ",19,"م",1,0],["الحَقُّ عالي الرُكنِ فيهِ مُظَفَّرٌ","في المُلكِ لا يَعلو عَلَيهِ لِواءُ",20,"ا",2,0],["الحَقُّ أَولى مِن وَلِيِّكَ حُرمَةً","وَأَحَقُّ مِنكَ بِنُصرَةٍ وَكِفاحِ",21,"ح",1,0],["الحَقُّ أَبلَجُ كَالصَباحِ لِناظِرٍ","لَو أَنَّ قَوماً حَكَّموا الأَحلاما",22,"م",2,0],["الحَقُّ وَالقُوَّةُ اِرتَدّا إِلى حَكَمٍ","مِنَ الفَياصِلِ ما في دينِهِ أَوَدُ",23,"د",1,0],["الحَقُّ نادى فَاِستَجَبتَ وَلَم تَزَل","بِالحَقِّ تَحفِلُ عِندَ كُلِّ نِداءِ",24,"ا",2,0],["الحَقُّ أَبلَجُ وَالكِنانَةُ حُرَّةٌ","وَالعِزُّ لِلدُستورِ وَالإِكبارُ",25,"ر",1,0],["الحَقُّ خَلفَ جَناحٍ اِستَذرى بِهِ","وَمَراشِدُ السُلطانِ خَلفَ جَناحِ",26,"ح",1,0],["الحَقُّ سَهمٌ لا تَرِشهُ بِباطِلٍ","ما كانَ سَهمُ المُبطِلينَ سَديدا",27,"د",2,0],["الحقُّ أَبْلَجُ والأَعْلامُ واضِحَةٌ","لَوْ آمنَتْ أَنْفُسُ الشّانينَ أَوْ نَظَرُوا",28,"ر",3,0],["أَلحَقتَني بِرِجالٍ كُنتُ أَتبَعُهُم","وَأَطلُبُ الرِفدَ مِنهُم إِن هُمُ رَفَدوا",29,"د",3,0],["أَلحِقهُ يا خَيرَ الوَرى بِمَسيلِهِ","وَاِمدُد فُضولَ عُبابِهِ المُتَدَفِّقِ",30,"ق",1,0],["أَلحَقَ المُقطِعَ الرَجاءَ وَأَدَّت","يَدُهُ آمِلاً إِلى آمالِه",31,"ل",2,0],["ألحقْتَ بي في الشِّعْرِ خِدْنَيْ لُكْنَةٍ","بَكَرا ورَاحا في البَلادَةِ تَوأَما",32,"م",2,0],["أَلحقتَ شاهقَها المُنِيفَ بأرضِها","فكأنَّما صَبَّحْتَها بزَلازِلِ",33,"ل",1,0],["أَلحَقنَ بِالجُمَّيزِ أَصلَكَ صاغِراً","وَالشيحُ يَضحَكُ مِنكَ وَالقَيصومُ",34,"م",1,0],["الحَقُّ أَبلَجُ وَالسُيوفُ عَوارِ","فَحَذارِ مِن أَسَدِ العَرينِ حَذارِ",35,"ر",1,1],["أَلحِق جَبيناً دامِياً رَمَّلتَهُ","بِقَفاً وَصَدراً خائِناً بِصِدارِ",35,"ر",1,0],["الحقُّ أقبلَ في لواءِ إمامهِ","والحقُّ أوْلىَ أن يسودَ وأَخْلَقُ",36,"ق",1,0],["الحقُّ معروفُ المعالم ساطعٌ","والنُّجْحُ وضّاحُ البشائرِ بادِ",37,"د",1,0],["الحقُّ يُؤلمُ لا القطيعُ مُعذَّبٌ","يَرْعَى الهوانَ ولا الذّئابُ رُعاةُ",38,"ه",1,0],["الحقُّ أُسطولُ الضَّعيفِ وجيشُه","إن شنَّ حرباً أو أرادَ مَغارا",39,"ر",2,0],["الحقُّ عِصمتُنا نَصونُ سِياجَهُ","بالعلمِ يَمنعُ أن نُضامَ ونُخْذَلا",40,"ل",2,0],["الحقُّ بعدك مأتمٌ يُطوَى به","عِلمُ الشرّيعةِ والقضاءُ حِدادُ",41,"د",1,0],["الحقُّ أنّ سَبيلَنا","خَطِرُ المطامعِ والدُّروبْ",42,"ب",1,0],["الحقُّ يصرعُ كل أشوس باسلٍ","ويَفُلُّ كلَّ مُذرَّبٍ مسلولِ",43,"ل",1,0],["الحقُّ أضيعُ ما يكون إذا الهوى","ملكَ النُّفوسَ وصرَّفَ الأعناقا",44,"ق",2,0],["الحقُّ من تُرَّهَاتِ الصائحين بهِ","والعدلُ فيما ترى آمالُ مقهورِ",45,"ر",1,0],["الحَقُّ حِصنٌ يَتَّقيهِ وَيَحتَمي","فيهِ الأَشَمُّ مِنَ الحُصونِ الأَهيَبُ",46,"ب",1,0],["الحَقُّ مَذهَبُهُ وَمَطلَبُ نَفسِهِ","يَرضى لَهُ في الكاتِبينَ وَيَغضَبُ",46,"ب",1,0],["الحَقُّ مُنتَهَكُ المَحارِمِ بَينَهُم","وَالعَدلُ وَهمٌ وَالوَفاءُ هَباءُ",47,"ا",2,0],["الحقُّ جَنْبٌ بالجراحةِ مُثْخَنٌ","وَحُشَاشَةٌ تهفو وقلبٌ يَفزَعُ",48,"ع",1,0],["الحقُّ ما شَرَعَ النبيُّ وباطلٌ","ما يدَّعِي المرتابُ والمتأوّلُ",49,"ل",1,0],["الحقُّ بابُ اللَّهِ هل من داخلٍ","طُوبَى لمن يَبغِي الفَلاحَ فيدخلُ",49,"ل",1,0],["أَلحَقَت ما اِستَلعَبَت بِالَّذي","قَد أَنى إِذ حانَ حينُ الصِرام",50,"م",1,0],["الحقُّ أبلجُ واضحُ المنهاجِ","والبدرُ يُشرِقُ في الظلامِ الداجي",51,"ج",2,1],["الحق ماتَ فبوَّؤ","ه بعد أَن حملوه لحدا",52,"د",2,0],["الحق يندبني فيها فأنصره","وَالعقل يأَمرني فيها فأَمتثل",53,"ل",1,0],["الحق فيها للتعاسة ضائع","وَالصدق معدود من الآثام",54,"م",1,0],["الحَقُّ فيهِ هُوَ الأَساسُ وَكَيفَ لا","وَاللَهُ جَلَّ جَلالُهُ البَنّاءُ",55,"ا",2,0],["الحَقُّ عِرضُ اللَهِ كلُّ أَبِيَّةٍ","بَينَ النُفوسِ حِمىً لَهُ وَوِقارُ",55,"ا",2,0],["الحق حجته هي الغرّاء","هيهات في فلق الصباح مراء",56,"ا",2,1],["أَلْحِقْ به إخْوانَهُ فحَيَاتُهُمْ","نَكَدٌ وقد أَوْدَى أَخُو السُّفَهاءِ",57,"ا",2,0],["إِلحَقِ اليَوْمَ فَيْصَلاً فَلَقَدْ كُنْتَ","لِخَيْرِ المُلُوكِ خَيْرَ الرِّفَاقِ",58,"ق",1,0],["الحَقُّ أَبيَضُ أَبلَجٌ","وَالحَقُّ أَولى ما اِتُّبِع",59,"ع",1,0],["الحَقُّ مَنْطِقُهُ والعَدْل سِيرَتُهُ","فَمَنْ يُجبْهُ إليهِ يَنْجُ مِنْ تَبَبِ",60,"ب",1,0],["الْحَقُّ والإِيمانُ مِلْءُ فُؤَادِه","وبَلاَغةُ الأَعْرابِ مِلءُ لَهاتِه",61,"ت",2,0],["الحقُّ يُعوِزُهُ مُحقٌّ ساهرٌ","كالسيف تُعْوِزُهُ يدُ السَّيَّاف",62,"ف",1,0],["الحقُّ عند قُضاتها يُقْضَى به","للدرهم المضروب والدينار",63,"ر",1,0],["الحق لؤلؤةٌ غاصت ببحر دمٍ","لها شِراكان: أسطولٌ وفُرسان",64,"ن",1,0],["الحقُّ فيه للقويِّ بجيشه","ولمن يطيرُ إلى السُّها بجَناحِ",65,"ح",1,0],["الحقُّ للصاروخ يعصِفُ بالورى","عصْفَ الرياحِ الهُوج بالأدواحِ",65,"ح",1,0],["الحقُّ يؤخذ بالخنا","جرِ، لا هتافاتِ الحناجر",66,"ر",1,0],["الحقّ والإبداع من نفحاتها","والهير من أسمائها والسؤدد",67,"د",1,0],["الحقُّ والقوة ُ ارتدّا إلى حكمٍ","من القياصل ، ما في دينه أود",68,"د",1,0],["الحق عدل والحقيقة شمسها","يجلو قتام تباين الاقوال",69,"ل",1,0],["ألحَقتَ أفقَرَنَا نَدىً بِغَنِيِّنَا","وَجَعلَت كالبَرَمِ السَّخِىَّ الباذِلا",70,"ل",2,0],["الحق إن بلادْكم عالْ","فيها الأدب واخد حَدُّه",71,"ه",1,0],["أَلحقَ الفخرَ بنا بعْ","دَ احْتكامِ العارِ فينا",72,"ن",2,0],["الحَقُّ جَفَّ وهُدّلَتْ أغْصانُهُ","ثوْبُ الفضيلة قدَّهُ الإزْراءُ",73,"ا",2,0],["أَلحَق اللَّه بالقليبِ وأهلي","هِ عتاةً منهم عناها اللواءُ",74,"ا",2,0],["الحق ما بينتَ غير ملجلج","من يمض في حق فلا يترددُ",75,"د",1,0],["الحقُّ أَبلَجُ سُلّوا دونَ بَيضَتِه","قبل السُيوفِ سُيوفا مِن بَراهينِ",76,"ن",1,0],["الحقُّ أكبَرُ من أَن تَستَبدَّ بهِ","يدٌ وَإن طالَ في بُطلٍ تماديها",77,"ي",3,0],["الحِقدُ يُلهِبُ قَلبَهُ وحسامَهُ","حتى يُخلِّفَ سافلاً عاليك",78,"ك",1,0],["الحقدُ زالَ على الشقاوةِ والأسى","فجميعُنا عربٌ كرامُ أُصول",79,"ل",1,0],["الحق يَقضى والاعضا","منهم عليهم شهود",80,"د",1,0],["الحق يعلو والموسو","س لا يزال في كدر",81,"ر",1,0],["أَلحِق بحسن اِبتدائي ما أَنالُ به","حسنَ التخلُّص يَتلو حُسنَ مُختَتَمِ",82,"م",1,0],["الحقُّ فيها لا يُغالب إِنّه","بظبى السيوفِ إذا استبيح مؤيد",83,"د",1,0],["الحقُّ كالصبحِ تمتازُ الرجالُ بهِ","لا بِالرجالِ يكونُ الميزُ للحقِّ",84,"ق",1,1],["الحَقُّ في الخَلقِ خَلقُ","وَالخَلقُ في الحَقِّ حَقُّ",85,"ق",1,1],["إلحَق سَرائركَ التي أركَبتها","نُجُب الدُّموع فإنَّها لا تُلحَقُ",86,"ق",1,0],["ألحقني الناسَ عَلى قارحٍ","صَفراءَ لا تَعرفُ تَقصيرا",87,"ر",2,0],["الحقُّ هذا كتابُ الله تَلحقُه","يهديك ثم ترانا فيه نَتْكَنَّى",88,"ن",2,0],["الحقُّ في القُدسِ محْفوظٌ وإنْ كذبو","وأطْلقوا لاختلاسِ الوعْيِ أبواقا",89,"ق",2,0],["الحقُّ في القُدْسِ محفوظٌ لأمَّتن","ديناً ، وعقْلاً وتاريخاً ، وأعرَاقَا",89,"ق",2,0],["الحقّ مُتّضحٌ ولكنّ الشّقا","أَعْمَى بصائِرَ منكُم وقلوبا",90,"ب",2,0],["ألْحِقْ بَنَفْسِجَ فَجْرِي وَرْدَتَيْ شَفَقِي","كافُورَةُ الصُّبْحِ فَتَّتْ مِسْكَةَ الغَسَقِ",91,"ق",1,1],["ألحقّ في آرائه والصدق في","أقواله والجود في أفعاله",92,"ل",2,0],["الحق أبلج لا تحميه ذبذبة","ومن تخافون إلا العميَ والعورا",93,"ر",2,0],["الحقدُ والحسدُ البغيضُ وكل ما","جعلَ الشعوبَ النابهاتِ عبيدا",94,"د",2,0],["الحقّ لي والحظّ عندهُمُ","أظما ويُروَى معشرٌ باسمي",95,"م",2,0],["ألحقتَهم بشذوذِ قومهمُ","يتساهمون مطارحَ الذلِّ",96,"ل",1,0],["ألحِقْهُمُ في المجدِ واحفظْهم وزد","ولقد فعلتَ وزدتَ حدّ الفاعلِ",97,"ل",1,0],["ألحَقَتْني به غريباً من الآ","مال قُربَى تُعَدُّ صِنْواً وصِهرا",98,"ر",2,0],["الحقائق هبها اليوم تمثيلا","للّه مجملة كانت وتفصيلا",99,"ل",2,1],["الحق حق بأن يعطى لطالبه","وإن تعلى به الباغي كمنطاد",100,"د",1,0],["الحق درعه وهو وحده قوّة","لا يستهان بها وليست توهن",101,"ن",1,0],["الحق حقك فاطلبه على شمم","كيلا يمنوك بالتسويف والمطل",102,"ل",1,0],["الحق فيكم جنايه","شأن الغريم التلدد",103,"د",1,0],["الحقُّ بادٍ لم يزلْ","لا يعتَريهِ الباطِلُ",104,"ل",1,0],["الحقُّ يُعْرَفُ أهلُهُ","والكاذِبونَ خَوامِلُ",104,"ل",1,0],["الحقُّ يُجلى من خلالِ حُروفِهِ","نورٌ تُضيءُ بشَعِّهِ الأَر