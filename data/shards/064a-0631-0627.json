لسَلُوَّ","قَليلاً وَتَجذَبُ أَشطانُهُ",0,"ن",2,0],["يَراهُ المُستَغِرُّ عَلَيَّ طَوقاً","فَيَغبِطُني بِهِ وَأَراهُ غُلّا",1,"ل",2,0],["يُرامونَهُ بِاللَحظِ كَي يَعصِفوا بِهِ","وَأَبصارُهُم صورٌ لَدَيهِ خَواشِعُ",2,"ع",1,0],["يُراعونَ إِسفارَ الصَباحِ وَإِنَّما","وَراءَ لِثامِ اللَيلِ يَومٌ عَصَبصَبُ",3,"ب",1,0],["يُراعي أساريبَ القَطا عَصفَتْ بها","منَ الريحِ هَوْجاءُ الهُبوبِ بَليلُ",4,"ل",1,0],["يُراقِبُ أفْراطَ الصّباحِ بناظِرٍ","يُساهِرُ في المَسْرى جُدَيّاً وفَرْقَدا",5,"د",2,0],["يُراقِبُ أسرابَ النّجومِ بمُقْلَةٍ","تُقَسِّمُ لحْظاً بينَ نَسْرٍ وفَرْقَدِ",6,"د",1,0],["يُراعُ العِدا مِنهُمْ إذا ما تحدَّبُوا","على كُلِّ رَقّاصِ الأنابيبِ خَطّارِ",7,"ر",1,0],["يَراني الذي عاداكَ مِلْءَ جُفونِهِ","قَذًى وقَتاداً لا يُشذِّبُهُ الخَرْطُ",8,"ط",1,0],["يُراميهِمْ أراذِلُ كُلِّ حَيٍّ","وهُمْ نَفَرٌ يُجيدونَ النِّضالا",9,"ل",2,0],["يَراني فيَعلَمُ حُبّي لَهُ","وَيَكتُمُني أَنَّهُ قَد عَلِم",10,"م",1,0],["يُراوِحُ مِن صَلَواتِ المَلي","كِ طَوراً سُجوداً وَطَوراً جُؤارا",11,"ر",2,0],["يُراقِبنَ مِن جوعٍ خِلالَ مَخافَةٍ","نُجومَ السَماءِ العاتِماتِ الغَوامِصا",12,"ص",2,0],["يَراكَ الأَعادي عَلى رَغمِهِم","تَحُلُّ عَلَيهِم مَحَلّاً عَويصا",13,"ص",2,0],["يُراقِبُ مِنهُ اللَهَ مُعتَضِدٌ بِهِ","يَدَ الدَهرِ يَقسو في رِضاهُ وَيَرأَفُ",14,"ف",1,0],["يُراجِمُ مِن صِنهاجَةٍ وَزَناتَةٍ","بِمِثلِ نُجومِ القَذفِ مَثنىً وَموحَدا",15,"د",2,0],["يَرَاعَةٌ حُرَّةٌ","لَمْ تَدْنُ مِنْهَا الرِّيَبْ",16,"ب",1,0],["يُرَادُ مِنَ الشَّبَابِ اليَوْمَ جُهْدٌ","لأُمَّتِهِمْ بِهِ أَمَلٌ عَظِيمُ",17,"م",1,1],["يُراعينَ ثيرانَ الفَلاةِ بَأَعيُنٍ","صَوافي سَوادِ المَأقِ غَيرِ ضِخامِ",18,"م",1,0],["يُراصِدُها في جَوفِ حَدباءَ ضَيِّقٍ","عَلى المَرءِ إِلّا ما تَحَرَّفَ جالُها",19,"ل",3,0],["يُراعينَ مِثلَ الدِعصِ يَبرُقُ مَتنُهُ","بَياضاً وَأَعلى سائِرِ اللَونِ وارِسُ",20,"س",1,0],["يُراعي حماة الدين فيه بمقلة","يُراعي بها الإسلامَ كافٍ وكافلُ",21,"ل",1,0],["يَراها قَليلاً لا تَسُدَّ فُقورَهُ","عَلى كُلِّ بَثٍّ حاضِرٍ يَتَتَرَّحُ",22,"ح",1,0],["يراني في الطعام له صديقاً","وشادنةُ العسابر رعْبليبُ",23,"ب",1,0],["يَراها الَّذي لا يَنطِقُ الشِعرَ عِندَهُ","وَيَعجِزُ عَن أَمثالِها أَن يَقولَها",24,"ل",3,0],["يرامُ تأخيرُ جدواه وهمتهُ","تقول إيهاً فللتأخير آفات",25,"ت",1,0],["يراع يربَى في سيول دوافق","وأغيال أسدٍ لا تفرّ تحمطا",26,"ط",2,0],["يراعي نجوم الليل تبراً ودأبه","أمانيّ من عهد الوصال تصاغ",27,"غ",1,0],["يراعك يوم السلم ينهل ديمة","وسيفك يوم الحرب ينهل في الدّما",28,"م",2,0],["يراعٌ له في كلِّ معضلةٍ سطاً","تعلمها في الغاب من أسد خفَّان",29,"ن",1,0],["يراعاً إذا مدَّته يمناه بالندى","رأيت عباب البحر قد مدَّ جدولا",30,"ل",2,0],["يراع بتأثير الحروف حمى الحمى","فكان ابتداء النصر من إلفيّه",31,"ي",2,0],["يُراعون أمثالي فيستنقذونهم","وهم في كروبٍ جمّةٍ وذَباذبِ",32,"ب",1,0],["يراكَ بمثْلِ تلكَ العيْنِ أعْشَى","وحَاشَا منْ لهُ بَصَرٌ حديدُ",33,"د",1,0],["يراه سُراة الليل والدّوُّ دونه","قريباً بأدنى مَسْمع حين يزأر",34,"ر",1,0],["يراك إذا نال النظيرُ نظيرَهُ","نَظيرك مثلُ النجم عَزّت مَلامسه",35,"س",2,0],["يراني بعينٍ من غرورٍ وباطلٍ","مُنىً من ضلال والمنايا تشاوسه",35,"س",2,0],["يراعينها صوْراً إليها روانياً","ويلحظن ألحاظاً من الشجو خشَّعا",36,"ع",2,0],["يراجع بعض رَوِيّاته","قد وقعت صفقة البائع",37,"ع",1,0],["يُراودُ عن جَداهُ نَفسَ سوءٍ","ترى أن الجَدا رُزءٌ جليلُ",38,"ل",1,0],["يُراوغ منقاشي نجومُ مَسائحي","وهُنَّ لعيني طالعاتٌ نَواجمُ",39,"م",1,0],["يراه أبو الحسين وإن تَوارى","بعينٍ لا تَكِلُّ ولا تنامُ",40,"م",1,0],["يراه الورى ضيفاً ببابك صائماً","وهَلْ حسنٌ ضيفٌ ببابك صائمُ",41,"م",1,0],["يُراعي حِمى الإِسلامِ لازَمَنَ الحِمى","وَيَحلو لَهُ ثَغرُ المَخافَةِ لا الثَغرُ",42,"ر",1,0],["يراع صنانيد الكتابة كالعضب","يدور عليه ما على الارض من حرب",43,"ب",1,1],["يُراحُ وَيُغدى بِهِم كَالقَطي","عِ عَلى مَشرِقِ الشَمسِ وَالمَغرِبِ",44,"ب",1,0],["يَراهُ الناسُ حَيثُ رَأَتهُ كَعبٌ","بِأَرضٍ ما لِنازِلِها اِستِتارُ",45,"ر",1,0],["يُرادُ مِنَ القَلبِ نِسيانُكُم","وَتَأبى الطِباعُ عَلى الناقِلِ",46,"ل",1,0],["يُراقِبُ صَولُ الوَغدِ حينَ يَهُزُّهُ اِق","تِدارٌ وَصَولُ الحُرِّ حينَ يُضامُ",47,"م",1,0],["يُراقِبنَ فَيّاضاً كَأَنَّ جِفانَهُ","جَوابي زَرودَ المُترَعاتِ العَدامِلِ",48,"ل",1,0],["يراد من العيادة بسط أنس","وليس الأنس إلا بالعيان",49,"ن",1,0],["يَراعٌ راعَ بِالخُطَبِ الزَواهي","جَسيمَ الخَطبِ وَهوَ نَحيفُ جِسمِ",50,"م",1,0],["يَراعٌ يَروعُ الخَطبَ في حالَةِ الرِضى","وَيُضرِمُ نارَ الحَربِ في حالَةِ السِلمِ",51,"م",1,0],["يراك الناس حيث ترى عظيما","كريماً في تسامحه وديعا",52,"ع",2,0],["يَرَاكَ صَحْبُكَ فِي الرَّمْضَاءِ مُدَّرِعَاً","فَيَحْسَبُونَكَ لا تَسْتَشْعِرُ الصَّهَدَا",53,"د",2,0],["يَراكَ ذو العَرشِ إِذا","نادَيْتَهُ وَيَسْمَعُك",54,"ك",1,0],["يَراهُ الشَفيفُ المُرثَعِنُّ فَيَنثَني","حَسيراً وَتَغشاهُ الصَبا فَتَنَكَّبُ",55,"ب",1,0],["يُراعي نُجومَ اللَيلِ وَالهَمَّ كُلَّما","مَضى صادِرٌ عُنّي بِآخَرَ وارِدِ",56,"د",1,0],["يَراعٌ يهزُّ المُسلمِينَ صَريرُهُ","وسيفٌ لأعناقِ المُغيرينَ قاطعُ",57,"ع",1,0],["يَراهُ سَراةُ مَكّةَ فوق رَأْسِ","لِميمونِ النَّقيبةِ غيرِ نِكْسِ",58,"س",1,0],["يُراقِبنَ أَبصارَ الغبارى بِأَعيُنٍ","غَوارِزَ ما تَجري لَهُنَّ دُموعُ",59,"ع",1,0],["يُراعي النِعاجَ وَتَحنو لَهُ","كَما حَنَتِ الهَجمَةُ اللاقحَه",60,"ح",2,0],["يُراقِبُ منه ما كَسَبَتْ يَداه","فيَبْكيه كما يَبْكي الرَّقوبُ",61,"ب",1,0],["يراك أمام الجيش حتى كأنه","حُذياكَ ثاوٍ أو إليكَ لصيق",62,"ق",1,0],["يُراقِبُ الصُبحَ أَن يَبينَ لَهُ","فَيَغتَدي سالِماً وَلَم يَهِنِ",63,"ن",1,0],["يَرأَمنَ ذا غُرَّةٍ غَريراً","تَكفُرُ في مِثلِهِ الظُنونُ",64,"ن",1,0],["يَراكَ بَنو المَنصورِ أَولاهُمُ بِها","وَما أَضمَروا غَيرَ الَّتي يُظهِرونَها",65,"ن",3,0],["يَراني الَّذي لَم يُحِط عِلمُهُ","رِدائي فَيَحسَبُني عابِدا",66,"د",2,0],["يَرأَمنَ سَقباً في الرَواحِ وَإِنَّما","تَبني عَلى حَوَرٍ وَحُسنُ حِوارِ",67,"ر",1,0],["يُرادُ بِكَ الجَميلُ عَلى اِقتِسارٍ","وَتُذكَرُ بِالوَفاءِ وَأَنتَ ناسي",68,"س",2,0],["يُرادُ بِنا المَجدُ الرَفيعُ بِزَعمِنا","وَنَختارُ لَبثاً في وَبيلَةِ أَوطانِ",69,"ن",1,0],["يُراقبُ ضَوْءَ الصّبْحِ من كلّ مَطلَعٍ","ولا ضَوْء إلاّ ما بدا مِن لُغامهِ",70,"م",2,0],["يَراهُ بَنو الدهرِ الأخيرِ بِحالِهِ","كما أبصرتْهُ جُرْهُمٌ وأَمِيمُ",71,"م",1,0],["يراعةٌ غَرَّنِي مِنها وَمِيضُ سَنىً","حتَّى مَدَدتُ إِليها الكفَّ مُقْتبِسا",72,"