{"poems":[[79,"صاب مزن الدموع من جفن صبك","https://www.aldiwan.net/poem36705.html","الخفيف"],[90,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[53,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[93,"ما لهند وكل حسناء هند","https://www.aldiwan.net/poem8807.html","عموديه"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[63,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[46,"أول عدل منك فيما أرى","https://www.aldiwan.net/poem30061.html","السريع"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[104,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/66077","الرمل"],[93,"الموده","https://www.poetsgate.com/ViewPoem.aspx?id=53023",""],[228,"أطفىء ضياك وأظلم مثل إظلامي","https://www.aldiwan.net/poem41594.html","البسيط"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[276,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[295,"جاء مع الفجر وفي طرفه","https://www.aldiwan.net/poem11673.html","السريع"],[411,"الدهر يلعب بالفتى","https://www.aldiwan.net/poem49574.html","مجزوء الكامل"],[591,"فضحت جيد الغزال بالجيد","https://www.aldiwan.net/poem17492.html","المنسرح"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104043","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86878","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107306","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109324","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115549","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132776","السريع"],[4012,"","https://poetry.dctabudhabi.ae/diwan/poem/145252","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28728","الرجز"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[5055,"غارة الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=103656",""],[5263,"خصلة سوء في أبى جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=200437",""],[5536,"صرح فرعون!!","https://www.poetsgate.com/ViewPoem.aspx?id=27509",""],[5309,"أولعت بالعدل لا الأحداث تلهيني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573551",""],[5309,"قالوا اترجو من الهك نصرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573557",""]],"verses":[["أَوْلِ عُذْرِي الرِّضَا فَمَا جِئْتُ بِدْعاً","دُمْتَ وَالْفَضْلُ وَالرِّضَا مِنْ دَأبِكْ",0,"ك",1,0],["أولعت بالعلم تنميه وتجمعه","منذ الشباب وما أولعت بالنشب",1,"ب",1,0],["أولعْ بِيَ العارفاتِ في يدك ال","سمحة إن الزمان بي ولِع",2,"ع",1,0],["أَولَعَت نَفسَها بِكُلِّ طَريفٍ","لَيتَها أَولَعَت بِبَعضِ التَليدِ",3,"د",1,0],["أَولَعتَ بِالغَدرِ النُفوسَ وَغَرَّها","أَمَلٌ يُخادِعُها وَبَرقٌ خُلَّبُ",4,"ب",1,0],["أَولعَ جَفْنَيْه بي ليقتُلَني","سَهْماهُما واقِعاً ومُنتَزَعا",5,"ع",2,0],["أَوَّلُ عَدلٍ مِنكَ فيما أَرى","أَنَّكَ لا تَقبَلُ قَولَ الكَذِب",6,"ب",1,1],["أولِعنَ بِالمُردِ الغَطارِفِ بُدَّنا","غيداً أَلِفنَهُمُ لِداناً غيدا",7,"د",2,0],["أُولعوا بالأذى فألفوا رسولَ ال","لَهِ جَلْداً على البلاءِ صبورا",8,"ر",2,0],["أوَّلُ عهدي بفنونِ الهوى","بيروتُ أْنعِمْ بالهوى الأولِ",9,"ل",1,0],["أولِعَ الناسُ بِالمَلامَةِ وَالمَر","ءُ عَلى خُطَّةٍ مِن التقديرِ",10,"ر",1,0],["أَو لعُمْرٍ بَلَغَتْ منهُ","اللَّيالي مُنْتهَاهْ",11,"ا",2,0],["أولعت نفسها بكل طرف","ليتها أولعت ببعض التليد",12,"د",1,0],["أَو لَعَلَّ الآثامَ تشرَبُ مِنّا","ما تَبَقّى مِن طهرِ ماءِ العمادِ",13,"د",1,0],["أُولِعَت بِالغَدرِ في أَيمانِها","وَوَفَت بِالوَعدِ في هِجرانِها",14,"ن",3,1],["أولع الحب بدمعي وَدمي","فَعلام اللوم في الحب علاما",15,"م",2,0],["أولعتُ بالحسن فتياً وإن","شبت فلن أنجو من ريقته",16,"ت",2,0],["أو لعبَ ريحٍ عاصِفٍ","عصفَتْ بكَفٍّ من ذُرَهْ",17,"ر",2,0],["أَوَّلُ عَهْدِي بِالحُبِّ فِيكَ غَدَا","آخِرَ عَهْدِي بالصَّبْرِ والجَلَدِ",18,"د",1,0],["أو لعظيمةٍ يُثني لها","من نَفسهِ العصيانَ ثمَّ يُخالفُ",19,"ف",1,0],["أَو لعيد الولاد أَرخ مَجدي","أَشرَق المَولد السَعيد بِمصر",20,"ر",1,0],["أَوْ لَعِبَ الآلُ عَلَيْها لِعْبا","تَراهُ مَرَّاتٍ وَمَرّاً ذَهْبا",21,"ب",2,0],["أولَعَ الحب بِقَلبي","فَعلَى ماذَا عَلاما",22,"م",2,0],["أولعت منك وحقّ لي","بمصيف حصرون الشهير",23,"ر",1,0],["أولع الحب بدمعي ودمي","لم يدع تبريحه منى سلاما",24,"م",2,0],["أول عشقي فتور عينيك","ومالهُ في الغرام آخِر",25,"ر",1,1],["أولع بالمعروف إذا لم يجد","مالم يجد طعماً لدنياه",26,"ا",2,0],["أولعت فيه لسوء بخت مشفقاً","من خصمه العادي أليم عذابه",27,"ب",2,0],["أَولَعَها اللَّهُ بِهِ وَأَولَعَه","فَلَيسَ يَجفوها وَلَيسَت تَقطَعُه",28,"ع",2,0],["أول عام ست وأربعين","ثم العبيد ملكوا المسكينا",29,"ن",2,0],["اولِعَ القَلْبُ بِرَيا الزَّنْبَقِ","مُذْ رَأَى زَنْبَقةَ الرَّوْضِ النَّدِيَّهْ",30,"ه",1,0],["أول على المقناص والذيب له طيب","يصطاد راس الذيب عمّه وخاله",31,"ل",2,0],["أولع بالنوم فما ينف","كّ متهم نائم يصرخ",32,"خ",1,0],["اولع با القلم جمرة واصمم با الورق غليون","واكن الشعر تبغ وجمرة الغليون وقاده",33,"د",2,0],["أُولِعتُ بِالعَدلِ لا الأحداثُ تُلهيني","عَن حُبِّهِ وَالمَنايا لَيسَ تَثنيني",34,"ن",2,1],["أُولِعتُ بِالخَطِّ القَويمِ فَعابَني","قَومٌ يُحِبّونَ الخُطوطَ المائِلَه",35,"ل",2,0]]}