px?id=198815",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5652,"كثير احظوظ ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=190145",""],[5688,"إذا ما القلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208900",""],[5749,"كلها يقرا كتوبو","https://www.poetsgate.com/ViewPoem.aspx?id=177041",""],[2546,"شَرَيْتُ نوماً بِسَهَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=17186",""],[5785,"متى متى يا قرة النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=131564",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5862,"فلّسفة .. أفكار : عطّشانه .. !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31097",""],[5894,"شقيقة بدر لا جحود ولا غش","https://www.poetsgate.com/ViewPoem.aspx?id=131422",""],[5906,"سَماحة","https://www.poetsgate.com/ViewPoem.aspx?id=188070",""],[5950,"سكّر","https://www.poetsgate.com/ViewPoem.aspx?id=128151",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[242,"لي الله كم قلبي يذوب من الذكرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563698",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6228,"أمّة المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6343,"تهويمات في وجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1971&r=&rc=1",""],[6346,"مشنقة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83387&r=&rc=3",""]],"verses":[["شَريفَةٌ رَشَّحَت مِنها مَناسِبُها","لَحِليَةِ العِزِّ مَجرى اللَيتِ وَالجيدِ",0,"د",1,0],["شَرَيتُ القَنا مِن قَبلِ أَن يُشتَرى القَن","وَنِلتُ المُنى مِن كُلِّ أَشوَسَ عابِسِ",1,"س",1,1],["شَريعَةُ الآدابِ لمّا أتَتْ","قامَتْ علَى أنْمُلِكَ الخَمْسِ",2,"س",1,0],["شَرِيفٌ ثَقِيلٌ لِلْوَصِيّ انْتِسَابُهُ","عَلِيٍّ أَتَى الْمَثْوَى فَنَاءَ بِكَلْكَلِ",3,"ل",1,1],["شُرَيحُ لا تَترُكَنّي بَعدَما عَلِقَت","حِبالَكَ اليَومَ بَعدَ القِدِّ أَظفاري",4,"ر",2,1],["شَريكانِ فيما بَينَنا مِن هَوادَةٍ","صَفِيّانِ جِنِّيٌّ وَإِنسٌ مُوَفَّقُ",5,"ق",1,0],["شَريجٍ كَحُمّاضِ الثَماني عَمَت بِهِ","عَلى راجِفِ اللَحيَينِ كَالمِعوَلِ النَصلِ",6,"ل",1,0],["شَرى وُدّي وَتَكرِمَتي جَميع","لِآخِرِ غالِبٍ أَبَداً رَبيعُ",7,"ع",1,0],["شَرَيتُ ثَنائَهُنَّ بِبَذلِ نَفسي","وَنارُ الحَربِ تَضطَرِمُ اِضطِراما",8,"م",2,0],["شَرَيتُكَ مِن دَهري بِذي الناسِ كُلِّهُم","فَلا أَنا مَبخوسٌ وَلا الدَهرُ باخِسُ",9,"س",1,0],["شَرَينا وَبِعنا بِالسُيوفِ نُفوسَهُم","وَنَحنُ أُناسٌ بِالسُيوفِ نُتاجِرُ",10,"ر",1,0],["شريف مسماه الممدّح واسمه","وشائدُ بيت المدح والمنح سائد",11,"د",1,0],["شريفاً في مناسبه عريقاً","خفيفاً في ملاعبه ذفيفا",12,"ف",2,0],["شرى دمَهُ ليحويَهُ فلمّا","حواهُ حوى به حمدَ الرجال",13,"ل",1,0],["شريعة من بيان الغرب صافية","وإن يك الشرق أحيانا بها شربا",14,"ب",2,0],["شَريعَةٌ لَكَ فَجَّرتَ العُقولَ بِها","عَن زاخِرٍ بِصُنوفِ العِلمِ مُلتَطِمِ",15,"م",1,0],["شَريفُ مَكَّةَ حُرٌّ في مَمالِكِهِ","فَهَل تُرى القَومُ بِالحُرِيَّةِ اِنتَفَعوا",16,"ع",3,0],["شَريكُ المَنَايَا وَالنّفُوسُ غَنيمَةٌ","فَكُلُّ مَمَاتٍ لم يُمِتْهُ غُلُولُ",17,"ل",1,0],["شريفٌ زُغاوِيٌّ وزانٍ مُذَكَّرٌ","وأعمَشُ كحّالٌ وأعمى مُنَجِّمُ",18,"م",1,0],["شَرى بارِعَ المَجدِ مُستَظهِراً","عَلى القَومِ في رَفعِ أَثمانِهِ",19,"ن",2,0],["شَريجانِ بِكرٌ لَم تُدَيَّث وَمُرضِعٌ","تَرَكنا لَها لُبّاً كَلِبِّ المَعالِقِ",20,"ق",1,0],["شَرَيكَةِ خوصٍ في النَجاءِ قَدِ اِلتَقَت","عُراها وَأَجهَضنَ الجَنينَ المُسَربَلا",21,"ل",2,0],["شَريفٌ لَهُ نارانِ لِلحَربِ وَالقِرى","تَلوحُ بِها في اللَيلِ أَلوِيَةٌ رُعشُ",22,"ش",1,0],["شريكُ شرورٍ لا سرورٍ نسيتُ ما","حفظْتُ ومما كنتُ حصَّلْتُ أجترُّ",23,"ر",1,0],["شَريفٌ لِآباءٍ نَمَتهُ شَريفَةٍ","يَطولُ العَوالي بَسطَةً وَالمَعالِيا",24,"ي",2,0],["شَرَيتُ بِشاتي شِبهَ لَيلى وَلَو أَبوا","لَأَعطَيتُ مِن مالي طَريفي وَتالِدي",25,"د",2,1],["شريعةُ ظالمينَ تَسيلُ آناً","دماً وتفيضُ آونةً ضراما",26,"م",2,0],["شريعة السّيفِ يُمضيها جَبابرةٌ","من كلِّ مُستهزِئٍ بالله مغرورِ",27,"ر",1,0],["شريعةُ الإسلامِ في أهلهِ","أهلِ الحجا والشرفِ الأطولِ",28,"ل",1,0],["شُرَيرَ فَإِنَّ الدَهرَ هَدَّمَ قوَّتي","وَلَم يُغنِ عَنّي حيلَتي وَدِفاعي",29,"ع",2,0],["شريعتُهُ صراطٌ مُستقيمٌ","فليسَ يَمَسُّنَا فيها لُغوبُ",30,"ب",1,0],["شَرَيتُ الفَتكَ بِالثَمَنِ الرَبيحِ","وَبِعتُ النُسكَ بِالقَصفِ النَجيحِ",31,"ح",1,1],["شَريفٌ اِبنُ شَريفٍ","جَوادٌ اِبنُ جَوادِ",32,"د",1,0],["شريف النجر من رهطِ الكنوس","تناءى في المناصب عن لعوسِ",33,"س",1,0],["شَريكُ روحِكَ يَأوي مِنكَ في جَسَدٍ","ما دامَ يُرزَقُ مِنهُ الروحُ وَالجَسَدُ",34,"د",1,0],["شريكان فيها لا يموتان إنما","يموت الذي قد كان في الأصل حيوانا",35,"ن",2,0],["شريف ينحَّى عن مواطن عزه","وآخر حر بالحديد يكبل",36,"ل",1,0],["شريعة الغاب ما أراها","دما ولا ميتةً ذريعَه",37,"ع",2,0],["شّريعَةُ خُرْصانٍ وَبيلَةُ مَوْرِدٍ","أبَتْ شُرْبَها سُمْرُ الوَشيجِ الخَوامِس",38,"س",1,0],["شريعة فجرها بحران","بالعلم والحكمة يزخران",39,"ن",1,0],["شَرَيتُ القَنا مِن قَبلِ أَن يُشتَرى القَنا","وَنِلتُ المُنى مِن كُلِّ أَشوَسَ عابِسِ",40,"س",1,1],["شَرى وُدّي وَتَكرِمَتي جَميعاً","لِآخِرِ غالِبٍ أَبَداً رَبيعُ",41,"ع",1,0],["شريفاً تشير إليك الأكفُّ","وتُنْعَتُ بالعَلَمِ المُفْرَد",42,"د",1,0],["شريكُكَ في مزاجك من تُصافي","له شِقٌ وطوعُ يديك شِقُ",43,"ق",1,0],["شَرَى البينُ مني ما أراد وباعا","وإني جَبان في فِراق أحبتي",44,"ي",1,0],["شريفة الطبع ومن لطفها","ترغب في خدمة خدامها",45,"م",3,0],["شَرَى البَرْقُ عِندَ الفَجْرِ فاسْتَمْطَرَ الدَّمْعا","وهَيَّجَ مَجْرُوحَ الفُؤادِ إلى صَنْعا",46,"ع",2,1],["شريعةٌ في النّدَى ضلوا فدلّهُمُ","على مناهجها خِرّيتُها الهادي",47,"د",2,0],["شريتُ بالشكر نُعماه يداً بيد","فاعجب لمنتثر يُشري بمنتظم",48,"م",1,0],["شريعتك انثالت عليها عصابة","تناولن أشلاها وتاكلها أكلا",49,"ل",2,0],["شَريساً أَعارَتهُ اللَيالي جَهالَةً","جَلالاً وَمالاً