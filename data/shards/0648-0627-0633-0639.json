له الخلق الحسن والخلق والعقل ومن","https://www.aldiwan.net/poem54485.html","عموديه"],[406,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[413,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[413,"سأنفق وفرى في اكتساب مكارم","https://www.aldiwan.net/poem32080.html","الطويل"],[420,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[436,"يا أيها الثقة الذي وثقت به","https://www.aldiwan.net/poem12351.html","الكامل"],[436,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[443,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[443,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[456,"قالوا لنا فرحات سوف يتركنا","https://www.aldiwan.net/poem61254.html","البسيط"],[456,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[456,"يا نجمة في الأفق","https://www.aldiwan.net/poem61564.html","مجزوء الرجز"],[461,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[461,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[461,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[461,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[461,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[517,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[517,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[517,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[517,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[518,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[518,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[527,"الصلاة عليك يا شمس الكمال","https://www.aldiwan.net/poem13293.html","الوافر"],[532,"وأسعفني دهري بكل مطالبي","https://www.aldiwan.net/poem37459.html","الطويل"],[554,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[554,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[554,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[554,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[556,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[561,"أنا النور المبين ولا أكني","https://www.aldiwan.net/poem33817.html","الوافر"],[561,"نحن علم الله في الله وما","https://www.aldiwan.net/poem34569.html","الرمل"],[562,"أنخ الركائب في فناء الدار","https://www.aldiwan.net/poem69364.html","الكامل"],[570,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[578,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[583,"وأسعد خلق الله من قال عن رضى","https://www.aldiwan.net/poem25190.html","عموديه"],[607,"","https://poetry.dctabudhabi.ae/diwan/poem/202245","البسيط"]],"verses":[["واسِعُ خَرقِ الضَميرِ حَيثُ سَرى","تَبَحبَحَت في مُرادِهِ الهِمَمُ",0,"م",1,0],["وَاِسعَد بِها وَاِشكُرِ الأَقدارَ أَن حَمَلَت","إِلَيكَ قُرَّةَ عَينِ العُجمِ وَالعَرَبِ",1,"ب",1,0],["وَأَسعَدَني عَلَيهِ مِن قُرَيشٍ","طَويلُ الباعِ أَبيَضُ عَبشَمِيُّ",2,"ي",1,0],["وَأَسْعى فَقَدْ أَيْقَنْتُ أَنَّ مَآربي","إِذَا سَاعَدَ المِقْدارُ بِالسَّعْي تُدْرَكُ",3,"ك",1,0],["واسْعَدْ بيومِكَ فالإقبالُ مُؤْتَنَفٌ","والشّمْلُ مُجتمِعٌ والشّعبُ مُلْتَئِمُ",4,"م",1,0],["وأسْعَدَها سَعْدٌ على ما تُجِنِّهُ","من الوَجْدِ لا أدمى جَوانِحَهُ الوَجْدُ",5,"د",1,0],["وَأَسعَدَني الزَمانُ فَصارَ سَعدي","يَشُقُّ الحُجبَ وَالسَبعَ الطِباقا",6,"ق",2,0],["وَأَسعَدَها بِالبُكا نِسوَةٌ","جَعَلنَ مَغيضَ الدُموعِ الجُيوبا",7,"ب",2,0],["واسْعَدْ بعِيدٍ أعادَ الدّهْرَ مُبتَهِجاً","في ظِلِّ رَيْعانِهِ والسّعْدَ مُقْتَبِلا",8,"ل",2,0],["وأسْعَدَ اللهُ بيْتاً أنتَ عامرُهُ","وشيّدَ العِزُّ عُلْيا أنْتَ بانِيها",9,"ي",3,0],["وَأَسعِدنا بِجامِعَةٍ وَشَيِّد","لَنا مِن مَجدِ دَولَتِكَ المَشيدِ",10,"د",1,0],["وَأَسعِدنا بِعَهدِكَ خَيرَ عَهدٍ","بِهِ أَيّامُنا تَصفو وَتَحلو",11,"ل",2,0],["وَأَسعى لِأَمرٍ عُدَّتي لِمَنالِهِ","أَواخَيَّ مِن آرائِهِ وَأَواصِرُ",12,"ر",1,0],["وَأَسعَدَ كانَ الناسُ تَحتَ سِيوفِهِ","حَواهُم بِمُلكٍ شامِخٍ لَيسَ يُقهَرُ",13,"ر",1,0],["واسعد بمن حاطت الإسلام همته","حتَّى تغاير فيها العلم والعلَم",14,"م",1,0],["واسعدْ أبا العباس مُستوهِباً","من ملكٍ أعطاهُ ما استوهبا",15,"ب",2,0],["واسعدْ ببيت بنيتَهُ أفِدٍ","أُسِّس بنيانُهُ على الخِيَره",16,"ر",2,0],["واسعةُ الثقبين بغَّاءةٌ","قد أقطعت بيعتَها القَسّا",17,"س",2,0],["واسعة الثُّقبين بغَّاءةٌ","تُعجبها الدّسَّة والخَرْطَه",18,"ط",2,0],["واسعد أبا سهل بعيدك نازلاً","فوق الحوادث منزلاً مرفوعا",19,"ع",2,0],["واسعد به أيها الوزير فقد","أعطيته طاهراً من النطف",20,"ف",1,0],["واسعُ العفوِ للمُنيبِ وعندي","نقماتٌ تدومُ للمستديم",21,"م",1,0],["وأسعدُ الناسِ سلطانٌ له وَرَعٌ","عليه منهُ لأهلِ الحقِّ سلطان",22,"ن",1,0],["واسعدْ بمرضاةِ الملوكِ فلم تكن","وسْنانَ دونَهُمُ ولا مُتواسِنا",23,"ن",2,0],["وأَسعدُ النَّاس فيه أَعمى","لا يُبْصِرُ الهول والمُصَابْ",24,"ب",1,0],["واسع النقل غزير ال","عقل مبسوط اليدين",25,"ن",1,0],["واسع الساح يرسل الفكر فيها","كل من شك ساعة أو تظنى",26,"ن",2,0],["وأسعدت مشرفاتٌ من مكامنها","حمر المناقير في لباتها ذهب",27,"ب",1,0],["وَأَسعَدُ مُشتاقٍ وَأَظفَرُ طالِبٍ","هُمامٌ إِلى تَقبيلِ كُمِّكَ واصِلُ",28,"ل",1,0],["وَأَسعَدُ مَن رَأَينا مُستَميحٌ","يُنيلُ المُستَماحَ بِأَن يَنالا",29,"ل",2,0],["واسعَ لعقباك ولا تغترر","بهذه الغادرة الساحره",30,"ر",2,0],["واسْعد بعيد العُجْمِ مغتبطاً","من شأنك الإِعطاءُ والسلبُ",31,"ب",1,0],["وَأَسعَدَهُ بِالصَومِ وَالفِطرِ تالِياً","وَكُلِّ زَمانٍ بَعدُ جاءٍ وَذاهِبِ",32,"ب",1,0],["واسعَدْ بقادِمَةٍ كالحَلْيِ حامِلَةٍ","شُكْراً تُهنِّيكَ بالعيدِ الذي قَدِما",33,"م",2,0],["وَاِسعَ لِليَومِ وَدَع هَمَّ غَدٍ","كُلُّ يَومٍ لَكَ فيهِ مُصطَرَب",34,"ب",1,0],["وَأَسعى لِما فَوقَ الكَفافِ وَكُلَّما","تَرَفَّعتُ فيهِ ازدَدتُ في الحَسَراتِ",35,"ت",1,0],["وَأَسعى إِلى مَغناكِ إِن شَطَّ أَو دَنا","وَأَلقى المَنايا كَي أَنالَ بِها المُنى",36,"ن",2,0],["وَأَسعَدَت إِذ وَفَت فيكُم بِما وَعَدَت","فَاليَومَ إِذ غِبتُمُ وَالدارُ قَد بَعُدَت",37,"ت",1,0],["وَاِسعَد بِعيدِكَ ذا الأَضحى وَضَحِّ بِهِ","وَصِل وَصَلِّ لِرَبِّ العَرشِ مُؤتَمِرا",38,"ر",2,0],["وَأَسْعَدُ النَّاسِ مَنْ أَفْضَى إِلَى أَمَدٍ","فِي الْفَضْلِ وَامْتَازَ بِالْعَالِي مِنَ الشِّيَمِ",39,"م",1,0],["وأسْعَدَني مُرْفَضُّ دمعي كأنها","تَساقَطُ رأدَ اليْومِ دُرّاً مُدَحْرَجا",40,"ج",2,0],["وَاِسعَد بِما قالَ في الحِلمِ اِبنُ ذي يَزَنٍ","يَلهو الكِرامُ وَلا يَنسَونَ أَحسابا",41,"ب",2,0],["وَأَسعَدُ الناسِ بِالدُنيا أَخو زُهدٍ","نافى بَنيها وَنادوا إِذ مَضى دَرَجا",42,"ج",2,0],["وأسعد الناس من قد كان معتزلاً","يلازم الظل في اليوم الَّذي صخدا",43,"د",2,0],["وَاسْعَ لِمَا أَنْتَ لَهُ فَالْفَتَى","إِنْ هَجَرَ الرَّاحَةَ حَازَ الْمَدَى",44,"د",2,0],["وَاسْعَ لِلْعُلا","مَنْ سَعَى نَجَحْ",45,"ح",1,0],["وَاسْعَ تَبْلُغْ مَا رُمْتَهُ مِنْ نَفِيسٍ","فَالْمَسَاعِي مَدَارِجُ الأَحْرَارِ",46,"ر",1,0],["وَاسْعَدْ بِهِ وَأَخِيهِ يا ابْنَ مَحَمَّدٍ","في ظِلِّ مُلْكٍ وارِفِ الأَفْيَاءِ",47,"ا",2,0],["وَاسِعُ الصَّدْرِ وَالحَوَادثُ قَد","تَشْتدّ حَتَّى بِهَا تَضِيقُ الصُّدُورُ",48,"ر",1,0],["وَاسِعَ المَنْكِبَيْنِ مُنْفَرِجَ الحُ","قْوَيْنِ يَخْطُو خُطَاهُ كَالمُتَهَادِي",49,"د",2,0],["وَاسِعُ الجُود لاَيَضَنُّ بِمَالٍ","فِي سَبِيلِ الحِمَى وَلاَ مَجْهُود",50,"د",1,0],["واسعة ُ الخرق على رُقَّاعها","فالأرضُ كالبقعة من بقاعها",51,"ع",3,0],["وأسعد الناس حظا من فضيلته","ذو الانتقاد الى التفضيل يهديها",52,"ي",3,0],["واسعَ تَيلُغ ما رُمتَهُ مِن نفيسٍ","فالمَساعى مدارِجُ الأحرارِ",53,"ر",1,0],["واسعوا لأحمد إنه","عن شكركم لا ينصرفْ",54,"ف",1,0],["وأَسعَفَها خَفضُ المُقامِ وَخِصبُهُ","بِأَضعافِ ما بَزَّ السُرى وَالسَباسِبُ",55,"ب",1,0],["وَاِسعَد بِتَشريفِ الإِمامِ فَإِنَّ أَد","ناهُ إِلى أَعلى المَراتِبِ بابُ",56,"ب",1,0],["وَاِسعَد بِمَولودٍ سَما لِمَحَلَّةٍ","أَمسى لَها بَدرُ السَماءِ حَسودا",57,"د",2,0],["وَاِسعَد بِهِ عاماً سَحائِبُ يُمنِهِ","هُطُلٌ وَكَوكَبُ سَعدِهِ وَقّادُ",58,"د",1,0],["وأَسعد جند ذى ملك جنودٌ","كفاهم منهُ أمرُ الحربِ سعدُ",59,"د",1,0],["واسعة لا يبرح الطرف بها","مسافرا يسرح فيها سرا",60,"ر",2,0],["وَاِسعَد بِذا الشَهرِ الأَصَبِّ سَعادَةً","تَبقى وَتُبلِغُكَ المُنى وَالسُولا",61,"ل",2,0],["واسِعُ الصدرِ فيه شعرٌ دقيقٌ","معهُ البطنُ في اِرتقاعٍ سواءُ",62,"ا",2,0],["وأسعفتِني فيما مضى وغررتِني","ولم تسعفي من قبل إلا لتُخلفي",63,"ف",2,0],["وَاسعَد بعيدٍ سَعدهُ","في كلّ عامٍ أَن يَراك",64,"ك",1,0],["وَاِسعَد فَقد قالَ الزَمان مُؤرِّخا","قد تاهَ يا تَوفيقُ عيدُ فِداكا",65,"ك",2,0],["وأسعِدِ اللهوَ فقد","أفلح من قد أسعَدَه",66,"د",2,0],["واسعي إلى البر والتقوى مسارعة","فربما شكرت يوما مساعيك",67,"ك",1,0],["وَاِسعَد بِما أوتيتَهُ مِن رُتبَةٍ","خَصَّتكَ بِالتَشريفِ وَالإِكرامِ",68,"م",1,0],["وَاِسعَد بِها خِلافَةً","لِغَيرِكُم لَم تُخلَقِ",69,"ق",1,0],["وَأَسْعِدْ خُطَانَا إِنَّها أَشْقَتِ الْفَلاَ","وَحَاشَاكَ أَنْ تَشْقَى لَدَيْكَ وَأَنْ تُشْقِي",70,"ق",2,0],["وَأَسْعِدْهُ بِالْخُلْدِ فِي جَنَّةٍ","فَقَدْ كَانَ يُسْعِدُ أَهْلَ النُّحُوسْ",71,"س",1,0],["وأسعد بشهر الصيام وابق إلى","أمثال أمثاله إلى الأبد",72,"د",1,0],["وأسْعَدَتِ البِيضُ الصَّوارِمُ بَأسَهُ","فمِنْ فالِقٍ رَأساً ومِنْ قَاصِمٍ مَتْنا",73,"ن",2,0],["وأَسْعَفتَ أَهل العَقْد والحلِّ في التي","تَقَلّدَها أبْهَى نِظَاماً مِن العِقْدِ",74,"د",1,0],["وَأَسْعَدَكَ اللهَ بِالْوِرْدِ مِنْهُ","وأَحْمَدَ بِالْيُمْنِ مِنْكَ الصَّدَرْ",75,"ر",1,0],["واِسعَ لكشف كُربتِه","واِحفَظ عهودَ صُحبتِه",76,"ه",1,0],["وأَسعفَ الحَميما","وَحَمَل العَظيما",76,"م",2,0],["واسعوا إلى اللَه ولا تكسوا","بالقلب والعينين والقدم",77,"م",1,0],["واسع الجود والمعروف يعطي ويقهر","نحمده نشكره فيما قضى به وقدر",78,"ر",1,0],["وَأَسعَروا لِلحَربِ ثيرانَها","لِلظُلمِ فينا بادِياً وَالفُسوق",79,"ق",1,0],["وَاِسعَ إِلى أَبوابِهِ","وَقَصدِ داعيهِ خُذِ",80,"ذ",1,0],["وَأَسعَدت بِكَ دَهراً أَنتَ زينتهُ","حَتّى تَباهَت بِبَدر مِنكَ أَعصرهُ",81,"ر",2,0],["واْسَعْد بصَوْمٍ مَرَّ مُفْتَتَحٌ","منْه وأَقبلَ منه مُخْتَتَم",82,"م",1,0],["وأَسعَدَ قُربُ أَسعدَ آمِليه","فكبَّرْنا وأَلقيْنَا الرِّحالا",83,"ل",2,0],["وأسْعدَهُ أيّامُ شَرْخِ شَبيبةٍ","صَقيلةِ أطرافِ الضُّحَى والأصائل",84,"ل",1,0],["واسعَدْ بإظْلالِ عيدِ الفُرسِ واحْوِ بهِ","منَ العُلا زُلفاً زُيدَتْ إلى زُلَف",85,"ف",1,0],["واسْعَدْ بصَومِكَ واصلاً ومُفارِقاً","ومُعاوِداً عَوْدَ المَشوقِ المُسْرِع",86,"ع",1,0],["واسْعَدْ بدَهْرٍ قد عَلِمتَ بأنّه","ما الحُرُّ فيه إذا سَلِمْتَ بضائع",87,"ع",1,0],["واسْعَدْ بنَصْبِ وَليّ عَهْدٍ للورى","فالبيتُ يُدعَمُ لم يَزَلْ بأواس",88,"س",1,0],["واسعاتٌ معَ اتّساعِ العطايا","فهْي بِيدٌ تُطوَى إليها البِيد",89,"د",1,0],["واسعَدْ بزَوْرٍ دنا","إليك بعد البِعاد",90,"د",1,0],["واسَعدْ كذاكَ بِعيدهِ وبِعوْدِه","في العِز ما غَنَّى الحَمامُ وصَوّتا",91,"ت",2,0],["واسْعَدْ بشَهْرِ الصومِ أولى وافد","منك الغداةَ وقد أتى بتَقَرُّب",92,"ب",1,0],["واسْعَدْ به وافِدَ يُمْنٍ يُجتَلى","ومِثْلُه في العِزّ أَلفْاً يُرتَقَب",93,"ب",1,0],["وأسعَدُ عند العقلِ شَخْصٌ مُمَثّلٌ","وكُلٌّ إلى عُقْبَى الفَناء يَؤوب",94,"ب",1,0],["وَأَسعَفَها بِاللُؤلُؤِ النَثرِ جَفنُهُ","وَيُسعِفُها مِن بَعدِهِ اللُؤلُؤُ النَظمُ",95,"م",1,0],["وأسعَدَها مُسعِدٌ","مِن المَدمَع السَّاجِمِ",96,"م",1,0],["واسعد بموتٍ صالحٍ في توبةٍ","مرضيةٍ تكسو الخُطاةَ جُذاذا",97,"ذ",2,0],["واسع كما من قد سعى ودع الخلائق أجمعا","واغنم زمانك مسرعا",98,"ع",2,0],["واسْعدْ بمأجورِ ما قدَّمتَ مِن قُربٍ","وما دعا لكَ فيه العربُ والعجمُ",99,"م",1,0],["واسعد بشهر الصوم فهو مبشر","لعلاك بالتأييد والغفران",100,"ن",1,0],["وأسعى إلى الهجاءِ لا أرهبُ الرّدى","ولا أتَخَشّى عامِلاً ومهَنّدَا",101,"د",2,0],["وأسعد الله مولانا الفريق به","فكان ثابت سعد غير منقلب",102,"ب",1,0],["واسعَدْ وأَسعَدْ صاحباً لم تُخْلِهِ","والدَّهر أَخْرَقُ من صَنيعَةِ صانِعِ",103,"ع",1,0],["وأسعدَ بالندبِ السعيدِ فللعُلى","تجمُّع شملٍ لا دنا منهُ فُرقانُ",104,"ن",1,0],["واسعَدْ بعيدٍ طالما أَعْدَيْتَهُ","عَوْداً بإِحسانٍ فعادَ فأَحسنا",105,"ن",2,0],["واسْعَدْ لِعِزِّ الدِّينِ والدُّنيا مَعاً","واسلَمْ لنَصْرِ اللهِ والإِسلامِ",106,"م",1,0],["واسعد بدنياك في بحث وفي كتب","إن كان يسعد من لم ترضه الهذر",107,"ر",1,0],["واسعذبوا النفي رغم البؤس يرهقهم","حتى يؤدوا أمانات لأوطان",108,"ن",1,0],["واسعفي من سناك","بنشوة لي تعيد",109,"د",1,0],["واسعةُ الفرج أعضلتْ زمناً","على الأواسي والداءُ ماحُسما",110,"م",2,0],["واسعد بعيدين جديد العلى","ومُخلقِ في مُذهَبٍ مخلقِ",111,"ق",1,0],["وأسعدَ بغداداً على ما أظلَّها","من الشوق جفنٌ كلّما جفَّ يدمعُ",112,"ع",1,0],["وأسعد الناس ربُّ مُلكٍ له","منكم ظهيرٌ وعاضدٌ وازرْ",113,"ر",1,0],["واسعَ لمنتظرٍ آياتِ عَودِك لم","يغنم سوى الصبر من غَمٍّ وإنظارِ",114,"ر",1,0],["واِسْعَدْ بعِيدٍ أنت فينا مِثلُه","واِفْطُرْ قُلوبَ المعتَدين بفِطرِهِ",115,"ر",2,0],["واِسعَد بعيدٍ مثلِ وجهِك بهجةً","تروى برؤيتِه القُلوحُ اللُّوَّحُ",116,"ح",1,0],["واِسعَدْ بعيدٍ بنَحْسِ المُعتدينَ أتى","مبشّراً أرسلَتْهُ نحوَكَ الحِقَبُ",117,"ب",1,0],["واِسعَد بعودةِ عيدٍ عاد فيه لَنا","فيكَ السّرورُ وزال الهمّ والوجَلُ",118,"ل",1,0],["وأسعد خلق الله من مات بعدما","رأى في بني أبنائه ما يسره",119,"ر",2,0],["وأسعد بعيد لم يزرني به","جودك في طل ولا وابل",120,"ل",1,0],["وَأسعفت المَكارم بِالمَغانم","وَلاحَ تَجلياً لِلوَهم جالي",121,"ل",2,0],["وأَسْعَفَني دَهْرِي بِكُلِّ مَطالِبي","وصَيَّرَني في النَّاس حَيْثُ أريدُ",122,"د",1,1],["واِسعَد بيوم المِهْرَجانِ وخذْ","منه طويلَ العمرِ مُقتبلا",123,"ل",2,0],["وَاِسعَدْ بِذا العيد والتّحويلِ إنّهما","توافقا والسّعودُ الغُرُّ تتَّفقُ",124,"ق",1,0],["وأسعدك الإلهُ بكلِّ يومٍ","سعوداً لا تُحطّ له مَنارا",125,"ر",2,0],["وَاِسعَدْ بِنيروزٍ أَتاك مُبشِّراً","ببلوغِ كلِّ محبّةٍ ومُرادِ",126,"د",1,0],["وَأَسعَدَها المِزمارُ يَشدو كَأَنَّهُ","حَكى نائِحاتٍ بِتنَ يَبكينَ مِن ثُكَلِ",127,"ل",1,0],["وأسعدُ باللقا قوماً وأُشقي","بهجري آخرين وبالتجني",128,"ن",2,0],["واسع قال عليم ربنا","وسعت رحمته كل الجنود",129,"د",1,0],["واسع إِلى ألا كان واخلع غيرها","تَهْتَزَّ مِن طربٍ إلى الأوتارِ",130,"ر",1,0],["وَأُسْعِدُهُ فَأَقْبَلُ مَا دَعَانِي","إِلَيْهِ غَيُّهِ أَوْ مِنْ رَشَادِهْ",131,"د",2,0],["وأَسعدُ الناسِ من لاقى بلا تَعَبٍ","مَبْدا السعادةِ في مَبْدا شِبيبَتِه",132,"ت",2,0],["وأسعد خلق الله من قال عن رضى","لقد عشتُ هذا اليوم غير منغص",133,"ص",1,1],["وأسعدتها أكف غير مقرفة","بح الحناجر تثنيها المعاصير",134,"ر",1,0]]}