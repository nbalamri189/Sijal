ْ عَلٍ","وَالصَّوْغُ تُغْلِي فِي الحِلَى مَعْدَنَهْ",1,"ن",2,0],["بِالْفِدَى ثُمَّ بِالفِدَى","بَدَأَ الْعُمْرَ واخْتَتَمْ",2,"م",1,0],["بِالْفِعْلِ نَكْمِلُهُ لاَ الْقَوْلِ نُجْمِلُهُ","وهَلْ غَنَاءٌ عَنْ الأَفْعَالِ بِالْكَلِمِ",3,"م",1,0],["بِالفَنِّ عالَجتِ الحَياةَ طَبيعَةٌ","قَد عالَجَت بِالواحَةِ الصَحراءَ",4,"ا",2,0],["بِالفِعلِ وَالأَثَرِ المَحمودِ تَعرِفُها","وَلَستَ تَعرِفُها بِاِسمٍ وَلا لَقَبِ",5,"ب",1,0],["بألفاظٍ يراها القلبُ بيضاً","إذا ما عايَنَتْها العينُ سُودا",6,"د",2,0],["بألفاظٍ عَذُبْنَ فهنَّ أشهى","إلى الصَّادي من العَذْبِ البُرادِ",7,"د",1,0],["بِالفَجِّ مِن نَحوِ دارِ عُقبَةَ وَال","حَجُّ سَريعُ الطَوافِ وَالصَدَرِ",8,"ر",1,0],["بالفتى المستجار من نوَب الدّه","ر به والسميدَعِ القمقام",9,"م",1,0],["بالفاتحين بشّر الإسلام","واستقبلت آمالها الأعلام",10,"م",1,0],["بِالفاتِحِ البَانِي لِمِصْرَ مِنَ العُلَى","صَرْحاً يُزَكِّي شَاهِدَ الآثَارِ",11,"ر",1,0],["بالفطر، والأضحى الكنانةُ تحتفي","فيهِ، وبالنيروز، والميلاد",12,"د",1,0],["بالفضل كنتم سابقين، ومَنْ لَهُ","تاريخكُمْ أجْدرْ به أن يَسْبِقَا!",13,"ق",2,0],["بألفاظه وهي غرُّ رِقاقٌ","ومعناه وهو الغريب الدقيق",14,"ق",1,0],["بألف زِق وبزقٍّ زائِد","أصبحْت كالخنزير في الطرائِد",15,"د",1,0],["بالفرع في المكرمات واصل","علوي عال متين الاساس",16,"س",1,0],["بالفعل زاهي طبعها","بدا بأسمي حرفِ",17,"ف",1,0],["بالفضل والعدل الزيارة والجفا","فعلى كلا الحالين فعلُكَ يحمدُ",18,"د",1,0],["بالفتحِ فتّحَ بابَه ذو عزَّةٍ","وَعَد الإِجابة حين قال ادعوني",19,"ن",2,0],["بالفجر اقسم انه في عصره","وتر الزمان وفرده وامامه",20,"م",2,0],["بِالْفِلاَلِي شَيْخِهِ سَيِّدِي مَسْ","عُودِ مَنْ أُسْعِدَتْ بِهِ سُعَدَاءُ",21,"ا",2,0],["بالفَسَادِ اعْتَمَدُوا كُلّ صُنْعٍ","وعَلى الهادِي مَعَادُ الصّلاح",22,"ح",1,0],["بِأَلفِ ذِراعٍ عَلى أَلفِ ذِمرٍ","طِمِرٍّ مُسَربَلَةٍ أَلفُ لامَه",23,"م",2,0],["بالفَتح والنَصر هَذا السَيرُ وَالسفرُ","وَسرتَ يصحبُك الإقبالُ والظَفرُ",24,"ر",1,1],["بألف قناع نغطي الوجوه","فخبرتنا في التخفي عريقة",25,"ق",2,0],["بِالفَقر لا تَك بِالجِناية مُبعدي","سامح قُصوري إِذ رضاؤك مَقصدي",26,"ي",1,0],["بِالفَتح لاحَ لَنا الهَناء مُبَشِّرا","وَالسَعد قامَ مُهلّلاً وَمُكَبِّرا",27,"ر",2,1],["بالفِكر في سِيَر الماضينَ تَحْسَبه","كأنّما عاش فيهم تِلكُم المُدَدا",28,"د",2,0],["بالفرحتين يفوز صائمُه","وهما «لقاءُ اللهِ» و»الفِطْرُ»",29,"ر",1,0],["بالفضل أنت عرفت الفضل ممتدحاً","لي فانشرحت بما أهديت مبتهجا",30,"ج",2,0],["بالفرض قد حاز القداسة والتقى","وقد استحق الفضل بالتعصيبِ",31,"ب",1,0],["بالفارس العَلَوي شقَّ غبارَها","والناطق العربيِّ شقَّ كلامَها",32,"م",3,0],["بألفٍ من الأصْنامِ قرْنُ كبيرِها","يبوحُ بأنّ اللّاتَ عادَ وشُيِّدا",33,"د",2,0],["بالفخرِ ساد أبوكَ سادات الورى","وأبوك لولاكَ ابنُه لم يفخَرِ",34,"ر",1,0],["بالفضلِ قلّد فيه جِيدَ متوّجٍ","تُمسي الثُريّا وهْي قُرطُ علائهِ",35,"ا",3,0],["بالفرق والجمع اللذين هما لنا","لا زلت أفرق في الوجود وأجمع",36,"ع",1,0],["بالفقر قمنا على أبواب عزة من","عنه صدرنا بتقدير وإفراز",37,"ز",1,0],["بِأَلْفَاظٍ تَخِرُّ لَهَا القَوافِي","وَيَنْقَادُ القَريضُ لَهَا ذَلُولا",38,"ل",2,0],["بالفانيات الباقياتُ نقيمها","فتدوم ذكرانا بها لا تندثر",39,"ر",1,0],["بالفضل حقا والحصافة والنهي","أصبحت متصفا وذلك يندر",40,"ر",1,0],["بالفضل والنبل قد نال العلا وبه","شرق البلاد على الافاق قد فخرا",41,"ر",2,0],["بالفاضِلِ المُتَفَضِّلِ المُتَطَوّلِ ال","مُتَجَمِّلِ المُتَحَمِّلِ المُتَعَطِفِ",42,"ف",1,0],["بِالفَخرِ قيل وَبالمَجدِ اِعتَلوا رتباً","لَم يرقهنَّ ابنُ عبّادِ بنِ عباسِ",43,"س",1,0],["بالفَرْمَسونَ تَسمَّوا بِئسَ ما اِبتَدعوا","فَإِنَّهُ بِعَظيمِ الجهلِ مَشمولُ",44,"ل",1,0],["بالفأس ترتد الذئاب وما لدى","راعي الخراف هنا سوى قيثاره",45,"ر",2,0],["بالفرعة الخضراء بات ورحّبت","حُبرى به وأتى الجميل محمدُ",46,"د",1,0],["بالفقر يرميني وطو","راً للبعاد يسدِّدُ",47,"د",1,0],["بالفَضْلِ يُعْطى مَلَكاً تَهَمُّمُهْ","وَالمَكْرُماتُ وَالمَعَالِي هِمَمُهْ",48,"م",2,0],["بألفٍ أشد مايتين وأربعٍ","وعشرين دور أحمد الدهر والمددْ",49,"د",1,0],["بالفضل لا بالكسب كان الاهتدا","للاطلاع على المقام العالي",50,"ل",2,0],["بالفتح والارشاد والامداد","ثبتت قواعد شيخنا الحداد",51,"د",1,1],["بِالفرس الأَشقَر في نَكيره","إِن السَّعيد من كفى بِغيره",52,"ه",1,0],["بالفتح و