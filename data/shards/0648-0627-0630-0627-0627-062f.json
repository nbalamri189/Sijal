{"poems":[[88,"أخرق الدف لو رأيت شكيبا","https://www.aldiwan.net/poem68871.html","الخفيف"],[49,"أقناعة من بعد طول جفاء","https://www.aldiwan.net/poem25382.html","الكامل"],[52,"إن سلمى خلقت من قصب","https://www.aldiwan.net/poem62290.html","الكامل"],[108,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[203,"إن كنت قاتلها فبالأنداء","https://www.aldiwan.net/poem45355.html","الكامل"],[255,"ما عوضتك بهجرها عن وصلها","https://www.aldiwan.net/poem15017.html","الكامل"],[409,"قد شف جسمي طول ما أتشوف","https://www.aldiwan.net/poem33640.html","الكامل"],[438,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[567,"غضي جفونك يا عيون النرجس","https://www.aldiwan.net/poem52891.html","الكامل"],[572,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[591,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112435","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100132","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133808","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118325","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53083","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27221","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109397","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93570","الكامل"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/141054","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121146","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136971",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89295","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/27004","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117980","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131260",""],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35616","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125876","الخفيف"],[4033,"","https://poetry.dctabudhabi.ae/diwan/poem/101191","الكامل"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140144",""],[4830,"روايةُ عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=206086",""],[5205,"كتب الجمال بطرس خذك أسطراً","https://www.poetsgate.com/ViewPoem.aspx?id=120995",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[572,"هذا الصَّباحُ فما الّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9283&r=&rc=140",""]],"verses":[["وَإِذا أَدنَفَ الشُيوخَ غَرامٌ","كُنتُ في حَلبَةِ الشُيوخِ نَقيبا",0,"ب",2,0],["وَإِذا أَدَرنَ عَلى النَدامى كَأسَها","غَنَّينَنا شِعرَ اِبنِ أَوسِ الطائي",1,"ي",1,0],["وَإِذا أَدنَيتَ مِنها بَصَلاً","غَلَبَ المِسكُ عَلى ريحِ البَصَل",2,"ل",1,0],["وإذا ادلَهَمَّ الليل، والْ","تَقَتِ المضاجع والجنوب",3,"ب",1,0],["وإذا أدرتَ صحونها نظروا لها","فكأنَّها في دعوةِ البخلاءِ",4,"ا",2,0],["وإذا ادَّعَت حُسنَ الحسانِ بأسره","سَلم فقد دلَّت عليه بدَلَّها",5,"ل",3,0],["وإذا أديرت للعلوم مسائل","وغدت سيوف البحث منها ترهف",6,"ف",1,0],["وإذا ادلهمّ الخطبُ يوماً في الورى","لا تعدلَنْ عن رأيه المتوقّد",7,"د",1,0],["وإذا ادَّعَتْ سُمرُ الرِّماحِ قَوامَهُ","صَدَقَتْ ولكن أينَ لِينُ المَلمَسِ",8,"س",1,0],["وَإِذَا أُدِيْرَتْ نُخْبَةٌ","وَمَضَى السُّرُورُ بِمَنْ تُسَرْ",9,"ر",1,0],["وَإِذَا ادَّخَرْتُكَ لِلشَّدائِدِ لَمْ تَكُنْ","يَوْماً لِغَمْزِ الحادِثاتِ قَنَاتي",10,"ت",2,0],["وإذا أدلهمت حادثات وأنطفا","أملي فمنكم استمد رجائي",11,"ا",2,0],["وإذا ادعيت لكم مقاماً دونه","زحل فأقلام الفضا لي تشهد",12,"د",1,0],["وإذا آدم يراقب حيرانَ","اندفاعَ القُوى وبعثَ الوجود",13,"د",1,0],["واذا ادلهم ظلام ليل جهالة","لا حوا ففاقوا النيرات توقدا",14,"د",2,0],["وإذا ادّعى جسمي السقام لحبه","زكاه بالعبرات قذف شهوده",15,"د",2,0],["وإذا أدبرا بقيتُ وحيداً","ساهراً لا أذوق طعمَ المنام",16,"م",1,0],["وإذا ادعاها في سواه فقل لهُ","ان كنتُ بالدعوى صدقت فاتها",17,"ت",3,0],["وَإِذا اِدّعى شَرَفاً تَكُن هِيَ شاهِداً","وَالعَجز يحوج أَهله لِشهود",18,"د",1,0],["وإذا ادّعى بدر التمام بهاءه","وأنار للسّارى قلا زعماته",19,"ت",2,0],["وإذا ادار أمور دنيا","فمن رشد وهاد",20,"د",1,0],["وإذا ادلهم الكون من نقع الوغى","بهر الورى من غمدنا مصباح",21,"ح",1,0],["وإذا ادعيت سيادةً بين الورى","فلقد كذبت وفي ضلالك لم تزل",22,"ل",1,0],["وَإِذا أَدركتَ ساحتهُ","وَشهدت الدار من صقبِ",23,"ب",1,0],["وَإِذا اِدَّعَينَ هَوِيَّ الكَبيرِ فَإِنَّما","هُوَ لِلكَبيرِ خَديعَةٌ وَقُرونُ",24,"ن",1,0],["وإذا ادَّعَى قُزلُ النواهقِ غِرَّةً","سَبقَ الخيولِ فبينَنا المِضمارُ",25,"ر",1,0],["وإذا أديرت كأس ود بينهم","في الرأي كان مزاجها تنسيما",26,"م",2,0],["وإذا ادعى المغرور أن لمثله","خطراً له تعنو الجباه جسيما",27,"م",2,0],["وإذا ادعى تقوى الإله منافقٌ","ملأت مفاسده النفوس سموما",27,"م",2,0],["وإذا ادعى الحكم المحابي أنه","ما كان إلا العادل المعصوما",27,"م",2,0],["وإذا ادعى حريةً بعض الورى","وهم العبيد غرائزاً وحلوما",27,"م",2,0],["وَإِذا أَدارَ بِكَ الغَمامُ كُؤوسَهُ","شَرب النّبات عَلى غِناء البلبلِ",28,"ل",1,0],["وإذا أَدبرت تقول قصورٌ","من سماهيجَ حولها آطام",29,"م",1,0],["واذا ادلهم على الخلائق مشكل","يجلو دجاه بنوره المتوقد",30,"د",1,0],["وإذا أدار المادحون الكاس من","مدح النبي فقد بدا السعد",31,"د",1,0],["واذا أديمُكَ يقشعرُّ بليلةِ","برداً فهذي أذرُعي لكَ مِئزَرُ",32,"ر",1,0],["وإذا أدعى منها الطفيلي لذة","سفها فكل الصيد في جوف الفرا",33,"ر",2,0],["وإذا أدبَرْتُ عن ميسورةٍ","جلسَتْ مِن عُسْرِها فوقَ الحَصِيرْ",34,"ر",1,0],["وإذا أَدِيرَتْ نُخبة ٌ","وَمَضَى السّرورُ بِمَنْ يَسُرْ",35,"ر",1,0]]}