{"poems":[[53,"قل خالد وخلاك ذم","https://www.aldiwan.net/poem66331.html","مجزوء الكامل"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17062","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82332","الخفيف"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[5837,"زمل التخوت","https://www.poetsgate.com/ViewPoem.aspx?id=189995",""]],"verses":[["قُلْ خالدٌ وخلاك ذمُّ","والصبح أجلح لا أغَمُّ",0,"م",1,1],["قَلَّ خَيرُ الإِخوانِ إِلّا مُعَزٍّ","عَن تَناءٍ أَو عائِدٌ مِن صَبابَه",1,"ب",2,0],["قَلَّ خَيرُ اِبنِ قاسِمٍ","فَغِناهُ كَعُدمِهِ",2,"م",2,1],["قل خرمهم بالقبض ثرم وهو في","طويلها ومتقارب يفي",3,"ي",1,0],["قُل خَليلي لِلمُفَضَّلِ بنِ بِلال","ما لَهُ يا أَبا الزُّبَيرِ وَمالي",4,"ي",1,1],["قُل خَيرَ قَولٍ في صَحابَةِ أَحمَدٍ","وامدَح جَميعَ الآلِ وَالنِسوانِ",5,"ن",1,0],["قل خالدي يفتح لك المجد صفحات","والعز والنوماس دايم شعارة",6,"ر",2,0]]}