 دوماً بحرنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=192186",""],[5956,"تواصل الفتن فيما بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=202522",""],[5956,"لقد سكنتَ حبيباً في ضمائرنا","https://www.poetsgate.com/ViewPoem.aspx?id=204483",""],[6019,"شيٌ من الحرمان","https://www.poetsgate.com/ViewPoem.aspx?id=204932",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6225,"غزة ليستْ أوّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80805&r=&rc=160",""],[572,"يا مُعرِضاً عنّي بوجهٍ مدبرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9432&r=&rc=289",""]],"verses":[["لَسَنَنتَ في الأَقوامِ غَيرَ مُلَوَّمٍ","ما سَنَّ يَومَ اِبنِ الزُبَيرِ يَزيدُ",0,"د",1,0],["لَسنا نُصَدِّقُكُم وَلَو أَخبرتُمُ","حَتّى نَرى فِعلاً يُصَدِّقُ قيلا",1,"ل",2,0],["لَسنا وَإِن كُنتَ تَجفونا وَتَقطَعُنا","بِتارِكيكَ عَلى حالٍ مِنَ الحالِ",2,"ل",1,0],["لَسنا نَلومُ عَلى قَطيعَتِنا","مَن لا يَدومُ لَنا عَلى عَهدِ",3,"د",1,0],["لَسنا كَمَن جَعَلَت إِيادٌ دارَها","تَكريتَ تَمنَعُ حَبَّها أَن يُحصَدا",4,"د",2,0],["لَسنا نُقاتِلُ بِالعِصي","يِ وَلا نُرامي بِالحِجارَه",5,"ر",2,0],["لَسنا بِعيرٍ وَبَيتِ اللَهِ مائِرَةٍ","إِلّا عَلَيها دُروعُ القَومِ وَالزَغَفُ",6,"ف",1,0],["لَسنا نُسَمّيكِ إِجلالاً وَتَكرِمَةً","وَقَدرُكِ المُعتَلي عَن ذاكَ يُغنينا",7,"ن",2,0],["لسن للهوى عللاً","بل به لها علل",8,"ل",1,0],["لَسْنَا مِنَ الْجُبَنَاءِ الْحَاسِبِينَ إِذَا","نَجَوْا نَجَاةَ العِبِدَّى أَنَّهُمْ سَلِمُوا",9,"م",3,0],["لسنا بقوم إذا ما عاهدوا نكثوا","ولو جرى الدم حتى أشبه النهرا",10,"ر",2,0],["لَسنا بِشَربٍ فَوقَهُم ظِلُّ بُردَةٍ","يُعِدّونَ لِلحانوتِ تَيساً وَمِفصَدا",11,"د",2,1],["لَسنا بِحَمتٍ وَلا زيمٍ وَلا صَوَرى","لَكِن بِمَرجٍ مِنَ الجَولانِ مَغروسِ",12,"س",1,1],["لسنيَ بالفم كم قارعٍ","ولحميَ بالهمّ كم عارق",13,"ق",1,0],["لسنا نسميه إجلالاً وتكرمةً","وقدره المعتلي عن ذاك يغنينا",14,"ن",2,0],["لسنا نراها حقَّ رُؤيتها","إلّا زمانَ الشيبِ والهرمِ",15,"م",1,0],["لَسنا بِإِخوانِ أُلّافٍ يُزيلُهُمُ","قَولُ العَدُوِّ وَلا ذو النَملَةِ المَحِلُ",16,"ل",1,0],["لَسِنٌ إذا صعد المنابر أو نضا","قلما شأى الخطباء والكتابا",17,"ب",2,0],["لَسنَ مِن زينَةِ الحَياةِ كَعَدِّ ال","لاهِ مِنها الأَموالَ وَالأَبناءَ",18,"ا",2,0],["لسنا نَذُمُّ أوائلَ النُّوبِ التي","جاءت أواخرُها بحَمْدِ عواقبِ",19,"ب",1,0],["لَسنا مُريدي حُجَّةٍ نَشفي بِها","مِن ريبَةٍ سَقَماً مِنَ الأَسقامِ",20,"م",1,0],["لَسنا نُبالي حينَ تُدرِكَ حاجَةً","ما باتَ أَو ظَلَّ المَطِيُّ مُعَقَّلا",21,"ل",2,0],["لَسنا وَإِن حَدَّثتَنا","يَغُرُّنا ما تَحلِفُ",22,"ف",1,0],["لسنا وُلاةَ الحقِّ إن لم يَنْدَمُوا","ولأنتَ أَوْلَىَ أن تَتُوبَ وتَنْدَمَا",23,"م",2,0],["لَسْنَا مِن الضّأنِ الذّليلِ فَترتوي","مِنّا المُدَى ويُبِيدُنا الذّبَّاحُ",24,"ح",1,0],["لسنا حُماةَ النّيلِ إن ظفروا بهِ","حتّى يَسيلَ دَمُ الرجالِ كمائِهِ",25,"ا",3,0],["لسنا مَطايا الأَذى إن حَاجةٌ عَرَضتْ","للِغاصِبينَ وما كُنّا بِأحْلاسِ",26,"س",1,0],["لسنا بني الخُلفاءِ إن لم نَبْنِه","مجداً على هامِ النُّجوم مُؤثَّلا",27,"ل",2,0],["لسنا إذا رَدَّ حقَّ النّيلِ غاصِبُه","نَظنُّه جادَ بعد الضَّنِّ أو سمحا",28,"ح",2,0],["لَسنا كَمَن جَهِلَ الحَياةَ رِوايَةً","تُعيي العُقولَ مَناظِراً وَفُصولا",29,"ل",2,0],["لَسنا إِذا أَخَذَت يَمينُكَ بِالعَصا","مِمَّن تَهُشُّ بِها عَلَيهِ فَيَجفَلُ",30,"ل",1,0],["لَسنا وَإِن عَزَبَت أَحلامُنا وَخَوَت","مِنّا الرُؤوسُ بِقَولِ الزورِ نَنبَهِرُ",31,"ر",1,0],["لسنا نُقاتِلُ بالآلافِ نَحشُدها","ألفاً لألفٍ من الأبطالِ مُكتملِ",32,"ل",1,0],["لسنا نُقاتِلُ أو تُؤدُّوا رَهْنَكم","إنّا نرى الدّاءَ المُكتَّمَ باديا",33,"ي",2,0],["لسنا كمثلِكَ في علمٍ ومعرفةٍ","أنت الإمامُ وهذا النهجُ والأثر",34,"ر",1,0],["لَسِنانُ إذ تُؤذيهِ منكَ بضربةٍ","أولى وأخلقُ من تحبُّ وتألفُ",35,"ف",1,0],["لسنا كقومك إذ يلقون مَهلكَهم","على يديك وإذ يُعطونكَ النَّفلا",36,"ل",2,0],["لسنا بأبنائهم إن كان ما رفعوا","من باذخ المجد يُمسِي وهو منهدمُ",37,"م",1,0],["لسنا بقومِ أخيكَ مُوسى إذ أبَوْا","إلا القُعودَ وسُبَّةً ما تُضرَحُ",38,"ح",1,0],["لَسنَ حُوراً عَقائِلاً هُنَّ مِنها","إِنَّ في الناسِ فَاعلَمُوا أَشباها",39,"ا",3,0],["لسنا نضنُّ على الحمى بدمائنا","فلنا أوائلُ علَّمونا الجودا",40,"د",2,0],["لسْنَا إلى «المأمون» يو","مَ الفخر نُنْسَبُ، «والأمين»",41,"ن",1,0],["لسنا بأحرارٍ -لعمري- ما بدا","لوجوههم طيفٌ من الأطياف",42,"ف",1,0],["لَسنَ بحاجة إلى اغتصاب","يا بحر، أين شُرْطَةُ الآداب؟",43,"ب",1,0],["لسْنَا بأمجادِ الأوائل نَكتفي","لكنْ كما فعل الأوائلُ نفعل",44,"ل",1,0],["لسن من زينة الحياة كعد ال","له منها الأموال والأبناء",45,"ا",2,0],["لسنا كمن جعل الحياة رواية ً","تعيي العقول مناظراً وفصولا",46,"ل",2,0],["لسنا وإن عزبت أحلامنا وخوت","منا الرؤوس بقول الزور تنبهر",47,"ر",1,0],["لِسِنانِهِ مِن كُلِّ فارِسِ بَهمَةٍ","ما بَينَ وَجَنَةِ خَدِّهِ وَالمحجِرِ",48,"ر",1,0],["لسنا نشكّ بأن الرزق مقتسمٌ","كل امرىء آخذٌ منه بحصّته",49,"ت",2,1],["لَسنا نَفيهِ المدحَ بالأشعارِ","مِن بعدِ ما أَثنى عليه الباري",50,"ر",2,0],["لسنا نشكُّ ولا يشك أخو حجىً","في أنَّ يوسف لم يكن بنظيرِهِ",51,"ر",2,0],["لسنا نهمُّ بما تأباهُ عفَّتُنا","لكنّنا نختشي ريباً من النظر",52,"ر",1,0],["لسنا إذا جارت دواعي الهوى","واستمعَ المنصِتُ للقائِل",53,"ل",1,0],["لَسنا بِأَجسادِ عادٍ في طَبائِعِنا","لا نَألَمُ الشَرَّ حَتّى يَألَمَ الحَجَرُ",54,"ر",1,0],["لسنا نبالي ولا ندري بنائلة","تنوب من حادثات الدهر والعلل",55,"ل",1,0],["لَسنا الحالُ يَشكُرُ خَيرَ وَقتٍ","بِهِ خَبَرُ السُرورِ أَنّي البَريدُ",56,"د",1,1],["لَسنا نَرى سَرَفاً في صَبوَةٍ سَرَفاً","لا بَل نَراهُ عَلى مَن لامَنا شَرَفا",57,"ف",2,0],["لِسُنَّةِ ذاكَ الوَجهِ دَمعِيَ شيعَةٌ","تُعَفِّرُ خَدَّيها كَما يُعلَمُ التُربُ",58,"ب",1,0],["لَسْنا كأَقْوامٍ مَطاعِمُهُمْ","كَسْبُ الخَنا ونَهْكةُ المَحْرَمْ",59,"م",1,0],["لسنا نرى شِبهاً يوازي حسنَها","إلّا ابنَها ذاك الإلهُ الأعظم",60,"م",1,0],["لسنا بمظلومين فيه وإنما","من طبعنا ننحو إلى هذا الجلل",61,"ل",1,0],["لَسنا نُحاوِل دَعوَةً","فَاِسمَح عَلَينا بِالسَلامِ",62,"م",1,0],["لَسنا كقومٍ ولا نُزري 