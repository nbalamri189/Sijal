{"poems":[[3,"طربت وهاجتك الظباء السوارح","https://www.aldiwan.net/poem91.html",""],[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[32,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[66,"كتبت ولم أكتب إليك وإنما","https://www.aldiwan.net/poem67666.html","الطويل"],[53,"يا ابن الوزيرين وابن السادة الصيد","https://www.aldiwan.net/poem10866.html","البسيط"],[53,"كأسك قد آذنك العود","https://www.aldiwan.net/poem61888.html","السريع"],[53,"جزى الله عني قبح وجهي سعادة","https://www.aldiwan.net/poem64029.html","الطويل"],[45,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[46,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[50,"يا هاشم ابن حديج ليس فخركم","https://www.aldiwan.net/poem62612.html","البسيط"],[48,"بني آدم بئس المعاشر أنتم","https://www.aldiwan.net/poem22161.html","الطويل"],[48,"أمل حبيب أدل","https://www.aldiwan.net/poem23279.html","مجزوء المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/29868","الطويل"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[3,"طربتَ وهاجتكَ الظباءُ السوانح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10667&r=&rc=21",""],[132,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[164,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[164,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[234,"إذا هب سلطان المريسي نافحا","https://www.aldiwan.net/poem51244.html","الطويل"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[261,"قام فلما دنوت منها","https://www.aldiwan.net/poem48320.html","مخلع البسيط"],[274,"أبا الأطول طولت","https://www.aldiwan.net/poem26458.html","الهزج"],[308,"يا عجبا من معشر سكرهم","https://www.aldiwan.net/poem57790.html","السريع"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[353,"وكل كتاب لي إلى من بأرضها","https://www.aldiwan.net/poem19879.html","الطويل"],[358,"قضت ببعادي ربة التيه والعجب","https://www.aldiwan.net/poem40586.html","الطويل"],[369,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[409,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[447,"من الحلم أن لا تطرق الناس بالأذى","https://www.aldiwan.net/poem14366.html","الطويل"],[447,"هو الرزء حتى كل قلب به جمر","https://www.aldiwan.net/poem14426.html","الطويل"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[505,"آل النبي الطاهر المصطفى","https://www.aldiwan.net/poem37678.html","السريع"],[505,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[529,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[529,"وماذا عسى أحصيه من اختصاصه","https://www.aldiwan.net/poem13290.html","الطويل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[563,"صريح كلامي في الوجود وإيمائي","https://www.aldiwan.net/poem35088.html","الطويل"],[567,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[591,"دعاه ورقم الليل بالبرق مذهب","https://www.aldiwan.net/poem17416.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107277","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112439","البسيط"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206071","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48823","المتقارب"],[833,"","https://poetry.dctabudhabi.ae/diwan/poem/198795","المتقارب"],[929,"","https://poetry.dctabudhabi.ae/diwan/poem/147644","الطويل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82249","البسيط"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124609","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112783","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6758","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109104","السريع"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124733","الوافر"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34946","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27613","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93711","السريع"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20692","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62824","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62745","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123939","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103617","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48301","السريع"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138655",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138453",""],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145184","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18728","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111391","الخفيف"],[4081,"","https://poetry.dctabudhabi.ae/diwan/poem/67680","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138733",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81695","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4679,"لعمرك ما السعادة للشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=142729",""],[4749,"أقوال شعري بها أتعثر","https://www.poetsgate.com/ViewPoem.aspx?id=155993",""],[4978,"عين سارة","https://www.poetsgate.com/ViewPoem.aspx?id=177199",""],[4978,"تشطير عين سارة لغالية أبو ستة","https://www.poetsgate.com/ViewPoem.aspx?id=177201",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5809,"ذهول","https://www.poetsgate.com/ViewPoem.aspx?id=205301",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5956,"أ أنتِ بقربي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183476",""],[5970,"بني مصر هبوا وأجهدوا ما استطعتمو","https://www.poetsgate.com/ViewPoem.aspx?id=130665",""]],"verses":[["وَكُلَّ كَعابٍ خَذلَةِ الساقِ فَخمَةٍ","لَها مَنصِبٌ في آلِ ضَبَّةَ طامِحُ",0,"ح",1,0],["وَكُلَّ كُمَيتٍ كَالقَناةِ مَحالُهُ","وَكُلَّ طِمِرٍّ كَالهِراوَةِ أَدهَما",1,"م",2,0],["وَكُلَّ كُمَيتٍ كَجِذعِ الطَري","قِ يَردي عَلى سَلِطاتٍ لُثُم",2,"م",1,0],["وَكُلَّ كُمَيتٍ كَجِذعِ الخِصا","بِ يَرنو القِناءَ إِذا ما صَفَن",3,"ن",1,0],["وَكُلُّ كَريمٍ مِن أُناسٍ سَوائِنا","إِذا ما التَقَينا خَلفَنا يَتأَخَّرُ",4,"ر",1,0],["وَكُلِّ كُمَيتٍ مُطارِ الفُؤادِ","أَمينِ الفُصوصِ كَمِثلِ الزُلَم",5,"م",1,0],["وكلّ كركيّ عجيب السير","كأنَّه طيف خيال الطير",6,"ر",1,0],["وَكُلُّ كِتابٍ صادِرٍ مِنكَ وارِدٌ","إِلَيكَ بِلا رَدِّ الجَوابِ جَوابي",7,"ب",2,0],["وكلُّكُمْ فأدام اللّه نِعْمَتَهُ","إدامَةً بين إعْزاز وتأيِيدِ",8,"د",1,0],["وكل كيدٍ كِدْتَه راجعٌ","عليك والمحدود محدودُ",9,"د",1,0],["وكلُّ كثيرٍ تافهٌ عند وجهِهِ","وكلّ كبيرٍ غيرَه فصغير",10,"ر",1,0],["وَكُلُّكُمُ أَتى مَأتى أَبيهِ","فَكُلُّ فَعالِ كُلِّكُمُ عُجابُ",11,"ب",1,0],["وَكُلُّ كُسوفٍ في الدَرارِيِّ شُنعَةٌ","وَلَكِنَّهُ في الشَمسِ وَالبَدرُ أَشنَعُ",12,"ع",1,0],["وَكُلُّ كِندِيَّةٍ قالَت لِجارَتِها","وَالدَمعُ يَنهَلُّ مِن مَثنى وَمِن وَحِدِ",13,"د",1,0],["وَكُلُّكُمُ يُبدي لِدُنياهُ نَغصَةً","عَلى أَنَّهُ يُخفي بِها كَمَدَ الصَبِّ",14,"ب",1,0],["وَكُلُّكُمُ ظالِمٌ","فَهَل مِن تَقِيٍّ عَدَل",15,"ل",1,0],["وكلكم عن حمى أوطانه بطلٌ","مستقتلٌ قرشيُّ الرُّوح فدَّاءُ",16,"ا",2,0],["وكُلُّ كَريمٍ أَنْتَ آخِرُ رِزْقِهِ","على عُقَبٍ الحِرْمانِ أَوَّلُ ناكِصِ",17,"ص",1,0],["وكلَّ كريمِ الثَّنا أصيدٍ","تَقلَّص في كِنِّهِ وانزوى",18,"ا",1,0],["وكلَّ كعوبٍ خدلة السَّاق فخمة ٍ","لها مَنْبتٌ في آلِ ضَبَّة طامحُ",19,"ح",1,0],["وكلُّ كُسوف في الدرارى شنيعةٌ","ولكنه في الشمس والبدرُ أشْنَعُ",20,"ع",1,0],["وكلك احسان إلى الناس كلهم","عممتهم بالعدل في الحكم والنصف",21,"ف",1,0],["وكل كعب كحق العاج تحسبهم","من عنبر خرطوا ذا الغطا بفمه",22,"م",2,0],["وَكلُّ كَمالٍ في الوجودِ كمالهُ","أَفاضَ على الدارينِ مِن بحرهِ قَطرا",23,"ر",2,0],["وَكلُّ كَمالٍ في الخلائقِ كلّهم","فَأنتَ لهُ أصلٌ وأنت به أحرى",23,"ر",2,0],["وَكُلُّ كَبيرٍ حينَ أَلقاكَ يَصغُرُ","أُحِبُّك ما أَشهى صَداها بِمَسمَعي",24,"ي",1,0],["وكلِّ كساء أدْكنٍ ومُضَرّجٍ","كما ضَرّج الخدّين ماءُ شباب",25,"ب",1,0],["وكلك آمال وكلك عزمة","وغيرك من ذكر اسمها يتهيب",26,"ب",1,0],["وكلَّ كفِّي لفرطِ جَذْبِي","لهُ وما للجبانِ حملهْ",27,"ل",2,0],["وَكُلٌّ كانَ ذا جَمعٍ","لَهُ هَمٌّ وَتَأميلُ",28,"ل",1,0],["وكل كأس شمسها أشرقت","ويومهم عارٍ من الصحو",29,"و",1,0],["وَكَلُّكُم شاهِدوا مِصداقَ رُؤيَتِهِ","وَذاكَ حينَ بُلوغٌ مِن نَوبَتِهِ",30,"ه",1,0],["وكل كفور مشرك بالهه","وآخر طاغ كافر بنبوة",31,"ه",1,0],["وَكُلُّ كِتابٍ لي إلى مَن بِأَرْضِها","سَلامي عَلَيْكُمْ فِيهِ قَبْلَ خِطابهِ",32,"ه",1,1],["وَكُلّ كَميٍّ فَوقَ كُلّ طمرَّةٍ","مِن النجبِ الجرد المطهّمة القُبِّ",33,"ب",1,0],["وكُلُّ كَمِيٍّ دِرْعُهُ الدّهرَ سَيْفُه","كَذيِ لِبْدةٍ من دُونِ شِبْليْهِ ناهت",34,"ت",1,0],["وكلكم قد رقى في ظلم قطعته","مراقياً ما رقاها قبل خوان",35,"ن",1,0],["وكُلُّ كَسْرٍ فإنَّ الله يَجبُرُهُ","وما لِكَسرِ قَناةِ الدِّينِ جُبْرانُ",36,"ن",1,0],["وكُلِّ كَمِيٍّ فِي مَنَاطِ نِجادِهِ","دواءٌ لِدَاءِ النَّاكِثِينَ إِذَا أَعْيا",37,"ي",2,0],["وكل كلامٍ لا يرى الفعل عنده","هذا وبئس المرء ما قاله هذي",38,"ذ",2,0],["وكلكمو إِلا له فهو والد","بكم عامهم يوم وأَعوامهم شهر",39,"ر",1,0],["وَكَّلَكَ الفضلُ على الأيام في","نصري فكنتَ الثقةَ الأمينا",40,"ن",2,0],["وكلُّكم نال العلاء ناهضاً","بنفسه طفلاً وساد يافعا",41,"ع",2,0],["وكلُّ كربٍ مزعجٍ مسَّهُم","بشارةٌ تعلى معاليهمُ",42,"م",1,0],["وكَلْكلي الأسْتارَ في رِحابِهِ","عندَ جَليلِ حِصْنهِ المَنيعِ",43,"ع",1,0],["وَكُل كِتاب منزل فيهِ ذكره","وَكُل نَبي بِالمَديح فَصيحُ",44,"ح",1,0],["وَكُلُّ كَمال دُونَ رُتبة مجده","وَكُلُّ عَطاء فَهوَ مِن فَيضِهِ مدُّ",45,"د",1,0],["وكلُّ كريمٍ لا يلمّ برِيبةٍ","فإنْ سِيم قولَ الفحش قال جميلا",46,"ل",2,0],["وكل كلام قد أتى متكلم","به فهو منه عنه في رمز أسماء",47,"ا",2,0],["وكلُّ كريمُ النَّفسِ من مالِ غيرهِ","وقلَّ كريمُ النَّفسِ من نفسِ مالهِ",48,"ل",2,0],["وكلكم مجتمع ومعتقد","أن عليا لم يكن فيمنشهد",49,"د",1,0],["وكل كتابٍ لي يَفُضُّ كتيبةً","ويهزِمُها من قبل فضٍّ لعُنْوَان",50,"ن",1,0],["وَكُلّ كَلامٍ فيه ذِكْرَايَ طَيّبٌ","وَكُلْ مكانٍ فيه شَخْصِي أَطْيَبُ",51,"ب",1,0],["وَكلُّكُم فِي طِلاب المَجدِ مُنبَعِثٌ","وَكلُّكُم لذُيُولِ الفَضلِ جَرّارُ",52,"ر",1,0],["وكلكم شاعر فذ القريض له","في حلبة الشعر ما للراح من عجب",53,"ب",1,0],["وكل كليبي صحيفة وجهه","أذل لأقدام الرجال من النعل",54,"ل",1,0],["وكل كليبي يسوق أتانه","له حاجة من حيث تثفر بالحبل",54,"ل",1,0],["وكلكمُ بطلٌ فاتحٌ","وعُدَّتُهُ قلبه والفم",55,"م",1,0],["وكلكم وكلاء الشعوب","ومصرُ الحديثةُ من كلَّموا",55,"م",3,0],["وكل كبير لها يستكين","وكل شجاع بها يجبن",56,"ن",1,0],["وكلُّ كثيرٍ من عدوٍّ ونائل","إذا صُلْتَ فيه أو وصلْتَ قليلُ",57,"ل",1,0],["وكلكم بنفسه مغرور","وواجب في حقه التعزير",58,"ر",1,0],["وَكُلُّ كَربٍ وَإِن طالَت بَليتُهُ","يَوماً تُفَرَّجُ غماهُ وَتَنكَشِفُ",59,"ف",1,0],["وكل كمال حيز من سيد الورى","فجامعه عن درعه ليس يبرَحُ",60,"ح",1,0],["وكلك مجبول على الخير والهدى","وفضلك مأمول فعجل إغاثتي",61,"ي",1,0],["وَكُلُّ كَبيرٍ لا يَكونُ لِوَجهِهِ","فَمِثلُ رَمادٍ طارَ في الهَبَواتِ",62,"ت",1,0],["وكلكم أدرى بحاجاتها","وكلكم يعشق بلدانه",63,"ن",2,0],["وَكُلُّ كُمَيْتٍ جَاءَنَا كَسَمِيِّهِ","فَأَطْرَبَ لَكِنْ لَمْ يَكُنْ ثَمَّ مِنْ وِزْرِ",64,"ر",1,0],["وكل كناية التطليق تغني","ولا تغني الكناية في العتاقِ",65,"ق",1,0],["وَكُلُّ كَربٍ أَمامَ المَوتِ مُتَّضعٌ","لِلمَوتِ وَالمَوتُ فيما بَعدَهُ جَلَلُ",66,"ل",1,0],["وكلُّ كلامٍ من حروفٍ تعينتْ","مخارجُها يدريه عُربٌ وأعجمُ",67,"م",1,0],["وَكلَّك السُلطانُ في مُلكه","وَهوَ الإمام وَالهمام الراحم",68,"م",1,0],["وَكُلُّ كَريمٍ يَتَّقي الذَمَّ بِالقِرى","وَلِلخَيرِ بَينَ الصالِحينَ طَريقُ",69,"ق",1,0],["وكلكم هداية وفضلٌ","لرفع غيم ولدفع غي",70,"ي",1,0],["وكل كنانةٍ حَضَنت بَنيها","ليومِ الرّوعِ أو يوم النّضالِ",71,"ل",1,0],["وكلُّ كَميٍّ للطِّعانِ بصدرهِ","طريقٌ تخطّاهُ الأسنة واسِعُ",72,"ع",1,0],["وكلكم يا قوم في القول فارس","ولا رجل إلا وفي الفعل راجل",73,"ل",1,0],["وكلكم سيّد ينمي إلى نفر","شمّ الأنوف كفاةٍ غير أكفال",74,"ل",1,0],["وكُلّ كَفّارٍ عنيدٍ لَدى","مَغنى الجهادِ قد غَدا مغْنَما",75,"م",2,0],["وَكُل كَسر فَاِن اللَهَ يُجبِرُهُ","كَما يُجبِر ذو العاهاتِ لُقمان",76,"ن",1,0],["وكل كمال مقتضى ذاته اغتدى","وما شابه نقص يغير ما هيا",77,"ي",2,0],["وكل كريمٍ حبه نفسه إذا","بحب حبيب الله قايست قاصر",78,"ر",1,0],["وكِلْ كل الأمور إليه منهم","وعند الله تلفي في ثوابك",79,"ك",1,0],["وَكُلٌّ كان يَملكُه شَبابي","وَكُلٌّ حَيثُ آمره يَسير",80,"ر",1,0],["وَكُلَّ كُمَيتٍ كَالقَناةِ طِمَرَّةٍ","وَكُلَّ طِمر يَحسَبُ الغوطَ حاجِرا",81,"ر",2,0],["وكُلُّكُما باسِلٌ وَأُذِيع","فَخارُكُما بِلسانِ الجَمِيع",82,"ع",1,0],["وكُلُّكُمُ فينا شُهُودٌ بأَنَّني","حُرِمتُ نَصيبي والقَضاءُ تَقَدَّرا",83,"ر",2,0],["وَكُلّ كِتاب قَد حَويت فَمُذكِر","وَآثاره كُلّ إِلَيك تَوائقُ",84,"ق",1,0],["وكل كف أبت نداه","فلؤها ذلة وفقر",85,"ر",1,0],["وكل كبير منهم شمس منبر","وكل صغير منهم شمس مهده",86,"د",2,0],["وكل كمي منهم ليث حربه","وكل كريم منهم غيث وهده",86,"د",2,0],["وكلّ كميّ كلَّما خطَّ صفحةً","بسيفٍ غدا بالرُّمح ينقطُ ما خطَّا",87,"ط",2,0],["وكلّ كمي لم تزل ذُبّلُ القنا","إلى قلبه أشهى من القضب الملد",88,"د",1,0],["وَكُلُّ كَحيلِ الطَرفِ يَقتُلُ صَبَّهُ","بِماضٍ كَسَيفِ الهِندِ مُضارِعُ",89,"ع",1,0],["وكل كلامه للناس حيث","على حب المهيمن والقريبِ",90,"ب",1,0],["وكلَّ كلامي تناسيتُ عمداً","وكان برودي كثلجٍ تكسرْ",91,"ر",1,0],["وكل كارثة في العُرْبِ قد نزلتْ","بقلبها فهمُ في قلبها نزلوا",92,"ل",3,0],["وكل كارثة في العرب قد نزلت","( أحزانها من شعاب القلب تُنتَسلُ",93,"ل",1,0],["وَكُلٌّ كَانَ فِي الأُولَى صَغِيرًا","حَقِيرًا نَاقِصًا نَزْرًا كَمِيَّا",94,"ي",2,0],["وكل كفور من ذوي الشرك والردى","فتكفيرهم عنا صحيح بلا رد",95,"د",1,0],["وكل كرامة تثبت بحق","فحق للولي بلا اختلال",96,"ل",1,0],["وكلٌّ كانَ يطمعُ في لِقاها","سوى مَن خيفةً في القلبِ أوجَسْ",97,"س",1,0],["وكل كلام جاء قبلي عرفته","وبعدي فإبداع اللغات الكثيرة",98,"ه",1,0],["وكل كتاب جا حكته حقيقتي","وأسراره مني وعني استقلت",98,"ت",1,0],["وكلُّ كيانٍ لكلِّ كيانٍ","عمادٌ لنفسه يستخدمُ",99,"م",1,0],["وكلكم ساع لرفعة نفسه","وما فيكم ساع إلي استقلال",100,"ل",1,0]]}