{"poems":[[87,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[68,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[70,"هل نار ليلى بدت ليلا بذي سلم","https://www.aldiwan.net/poem1526.html",""],[119,"بدا للنصر صبح مستنير","https://www.aldiwan.net/poem41089.html","عموديه"],[119,"لواء المجد والتعظيم يعقد","https://www.aldiwan.net/poem41775.html","الخفيف"],[132,"سلام وتسليم وألف مسرة","https://www.aldiwan.net/poem50503.html","الطويل"],[139,"صفا الدهر وابتسم الأنس لي","https://www.aldiwan.net/poem49081.html","المتقارب"],[164,"كفاك سرورا بالحسين قدومه","https://www.aldiwan.net/poem59062.html","الطويل"],[190,"هجرت المساوئ والمنكرات","https://www.aldiwan.net/poem43240.html","المتقارب"],[190,"نفوس الناس بالشح","https://www.aldiwan.net/poem43661.html","الهزج"],[202,"هو البين لا تعصي الدموع له أمرا","https://www.aldiwan.net/poem51842.html","الطويل"],[257,"لنا التهنئات وفرط الجذل","https://www.aldiwan.net/poem1435.html",""],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[354,"مرابع سعدى للعيون مراتع","https://www.aldiwan.net/poem15780.html","الطويل"],[364,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[422,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[422,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[422,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[454,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[505,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[564,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[580,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96752","المتقارب"],[1257,"","https://poetry.dctabudhabi.ae/diwan/poem/132796","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134231","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79891","المتقارب"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144585","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81900","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81897","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53043","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27741","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27265","الوافر"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101697","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2818,"","https://poetry.dctabudhabi.ae/diwan/poem/101869","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100262","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112492","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107061","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132599","الرجز"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145056","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89155","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48319","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138554",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133258","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45928","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94450","الطويل"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114012","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117223","الطويل"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131911","الوافر"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105176","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120553","الطويل"],[4852,"صباحك سكر","https://www.poetsgate.com/ViewPoem.aspx?id=214435",""],[5411,"نواعير الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=192851",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5550,"يكون الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=211259",""],[5563,"أزفُّ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215132",""],[5823,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=59133",""],[6142,"مولاي إن ذنوبي أوهنت كتفي","https://www.poetsgate.com/ViewPoem.aspx?id=155680",""],[2220,"فمن شرفِ النبيِّ على الوجودِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11309&r=&rc=183",""]],"verses":[["فمن فؤادي إلى لبي إلى كبدي","إلى رشادي فإغفائي فلذاتي",0,"ت",2,0],["فَمُنَّ فَدَتكَ النَفسُ بِالعُذرِ مُنعِماً","عَلَيَّ وَشاوِر حُسنَ رَأيِكَ في الأَمرِ",1,"ر",1,0],["فَمِنْ فؤادي لَهيبٌ ناب عن قَبَسٍ","ومِن جفونيَ دَمْعٌ فاض كالدّيَم",2,"م",1,0],["فمنفلت من الموت ارتعاشاً","يفر وراس مقدام يطير",3,"ر",1,0],["فمن فيض الرسول بكل آن","رفيع رحابه المعمور يقصد",4,"د",1,0],["فمن فضِلك الأسنى فجُودوا لنا بها","سريعاً كما نُسْدِى إليك مكارِمَا",5,"م",2,0],["فمن فضلكم شرّفوا بالحضور","لدينا وعندكمو العقابه",6,"ه",1,0],["فمن فاته مما يسر خصوصه","فما فاته مما يسر عمومه",7,"م",2,0],["فمن فطنتي وذكا همّتي","أكلت الهزيل وعفت السمينا",8,"ن",2,0],["فمن فرّط أو خلّ","ط يهوى الناس تخليطه",9,"ط",2,0],["فَمِن فُرقَةٍ قاسَيتُها بَعدَ فُرقَةٍ","وَمِن لَوَعَةٍ في إِثرِها لَوعَةٌ أُخرى",10,"ر",2,0],["فَمِن فَيلَقٍ سائِرٍ نَحوَهُم","لِغُنمٍ وَمِن غانِمٍ قَد قَفَل",11,"ل",1,0],["فمن فضل كاسي شرب غيري ولم يكن","يقاس بسكري سكر شارب فضلتي",12,"ي",1,0],["فَمِن فَرعِها لَيلُ الضَلالَةِ مُسبِلٌ","وَمِن فَرقِها صُبحُ الهِدايَةِ طالِعُ",13,"ع",1,0],["فمن فتى لااير لا شك أن له","مناقب المجد مهما أشهرت عَلَما",14,"م",2,0],["فمن فضّةٍ طُولَ الزّمانِ فَضيضةٍ","ومن ذَهَبٍ يَنهَلُّ منه ذِهاب",15,"ب",1,0],["فمن فضله أنِّي أبوء بفضله","وأَفخر ما بين الورى بافتخاره",16,"ر",2,0],["فمن فوقه الغبرا ومن تحته الخضرا","أحاطَ بنا علماً فليت سليقة",17,"ه",1,0],["فمن فضله والله يجزي بفضله","علينا أميرَ المؤمنين تفضّلا",18,"ل",2,0],["فمن فخر دولتنا نامق","بحسن المزايا وإحسانها",19,"ن",3,0],["فمن في اسرهم عان","ومن واسوا من الهلكى",20,"ا",1,0],["فمن فؤاد مليء بالولاء لكم","أهديك شعراً نظير الدر معطارا",21,"ر",2,0],["فمن فَيْضِكُمْ فَيْضي وأُنْمى لِبابِكُمْ","ومن موجِ إحْساناتِكُمْ غَسْلُ أَوْحَالِي",22,"ل",2,0],["فَمَن فَهِم الإشارةَ فلْيَصُنْهَا","وإِلاَّ سوفَ يُقْتَلْ بالسِّنانِ",23,"ن",1,0],["فَمِن فُؤَادي لَمْ يَدَع حبَّةً","ومن رقادي لم يَذَرْ ذَرّه",24,"ر",2,0],["فمن فيض أجفاني لهم مورد ومن","حشاشة قلبي مرتع ومخيم",25,"م",1,0],["فمن في الأنامِ اِصطفى غيرَهُ","فلا غرو فيمن عن الرُّشدِ ضلَّا",26,"ل",2,0],["فمن فتى عامر لا شك ان له","مناقب المجد مهما أشهرت عَلَما",27,"م",2,0],["فَمِنْ فُرُوضٍ يُمِيتُ العَائِقَاتِ لَهَا","وَسُنَّةٍ لِرَسُولِ اللَّهِ يُحْيِيهَا",28,"ي",3,0],["فمن فريد نقيّ البرد راق له","معنى يشع بأبهى منظر نضر",29,"ر",1,0],["فمِن فضلِ ضوئك كانَ الضياء","لقد رَمَقت بك عينُ العماء",30,"ا",2,0],["فمن فَتَياتٍ نُطِّقت بذوائبٍ","ومن فتيةٍ مسَّ الثَّرى وَفَراتُها",31,"ت",3,0],["فَمَنْ فِي رِجَالِ اللهِ نَالَ مَكَانَتِي","وَجَدِّي رَسُولُ اللَّهِ فِي الأَصْلِ رَبَّانِي",32,"ن",2,0],["فَمَنْ فِي أَولَياءِ اللهِ مِثْلِي","وَمَنْ فِي الْحُكْمِ وَالْتَصْرِيفِ خَالِي",33,"ل",2,0],["فمن في ملوك الأرض غيرك يرتجى","لإحراز ملك أو لنيل مراتب",34,"ب",1,0],["فمن فهم الأمر الذي قد ذكرته","فذاك إمام في الحكومة عادل",35,"ل",1,0],["فمن فهم الإشارة فليصنها","وإلا سوف يلحقُ بالصَّعيد",36,"د",1,0],["فمن فقد ألفيت موضع منة","وربك لا ينسى لذي منة أجرا",37,"ر",2,0],["فمن فعولن ومفاعيلن معه","أجزاؤها في كل شطر اربعه",38,"ه",1,0],["فمن فيضه هذي العلوم ترونها","لدى الخلق في هذي المدارس تنشر",39,"ر",1,0],["فمن فارسٍ في المأزق الضنك فارس","يردّ صدور الخيل بالفرس النهد",40,"د",1,0],["فمن فقد عقل كان مبعث حكمة","إلى البؤس في ذل السؤال أو القرض",41,"ض",1,0],["فمن فكره يملي يراعة فضله","على أخرس تجني الفصاحة من فيه",42,"ي",2,1],["فمن فتوح كتب النصر بها","تاريخ مجد بيمين النصر",43,"ر",1,0],["فمن في الوحش عندك من يلبي","ومن في الطير عندك من يجيب",44,"ب",1,0],["فمن فهمه بدرٌ ومن حكمه هدى","وفي علمه بحرٌ وفي حلمه بر",45,"ر",1,0],["فمِن فرَقٍ عنْ حرْبِه كفَّ إذ رأى","يَدَ اللهِ تعْلو منهُ بالسّيفِ مَفْرِقا",46,"ق",2,0],["فمن فر لم يلحقه صفحاً بأسمرٍ","ومن كر يستقبله فتكا بمخدم",47,"م",1,0],["فمن فرقة من حبّه بالهدى نجت","وأخرى تمادى في الجحيم أثامها",48,"م",3,0],["فمن فَمِهِ الناموس يُسمَع هكذا","قضى اللَه فاسمَع يا أَصمَّ بهِ ذَهلُ",49,"ل",1,0],["فمن فاز بالإسلام عز بعزه","وإلا فأبطال الجلاد تجادله",50,"ل",2,0],["فمن فكرة في العلم ما إن أجالها","تجلت غريبات حساناً خوافيه",51,"ي",2,0],["فَمِن فِيهِ ياقوتُ العُلومِ تَساقَطَت","وَمِن كَفِّهِ بَحرٌ مِنَ الجودِ تَيّارُ",52,"ر",1,0],["فمن فضل آل البرِّ والخير أُسَّست","مُوطدة البنيان لا زالَ مَن بَنى",53,"ن",2,0],["فمن فقد ذي الأشياء ضاقت مذاهبي","وجدت هذا الخليل للهم دافع",54,"ع",1,0],["فمن في انسكاب الدمع والحزن والأسى","وبثّ شكايات التباريح مسعدى",55,"د",2,0],["فمن في الدار تعهده فقيها","نُؤهّلُه القضا وهو النجيب",56,"ب",1,0],["فمن فرط الحيا منها المحيا","بشدة حمرة يحكي النضارا",57,"ر",2,0],["فمنفق در البحر في اليوم خاسر","ومنفق در الحبر في الدهر كاسب",58,"ب",1,0],["فَمَن في دمايا .. تدانَى لسمعي","وأهدى رموشي .. \"صباحكِ سكرْ\"",59,"ر",1,0],[".فمَنْ في نَبْعِهِ دفْقٌ زلالٌ","وَمَنْ في سَعْفه شَهْدُ العِذاقِ",60,"ق",1,0],["فمن فحل علم نوّر الأرض علمه","إلى فحل حرب بأسه أصعق الأعدا",61,"د",2,0],["فمَنْ فاز عاشَ حليفَ النّعيم","ومنْ خابَ كان من الأشقياء",62,"ا",2,0],["فمَنْ في الجود مثلُ أبي زكيٍّ","بهِ الجودُ ارتقى أفُقًا عليَّا",63,"ي",2,0],["فمن فيكِ دُرٌ وشهدٌ لذيذ","كروضة عطرٍ شذاها غناءُ",64,"ا",2,0],["فمن في وضعها عني لأكتب في","وفد المخفين أثقالاً وأعباء",65,"ا",2,0],["فمن فهم الإشارة فليصنها","وإلا سوفَ يحلقُ بالصعيدِ",66,"د",1,0]]}