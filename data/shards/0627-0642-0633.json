6,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[545,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[552,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[552,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[552,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[554,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[554,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[559,"أقسمت عليك أيها المحبوب","https://www.aldiwan.net/poem34970.html","الدوبيت"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[576,"لم يبق للنصف سوى ساعة","https://www.aldiwan.net/poem2714.html","السريع"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["أَقسَمتُ بِالمَحجوجِ مَر","فوعِ العِمادِ وَالبُنى",0,"ن",2,0],["أَقسَمتُ لا أَنساهُم ما طَلَعَت","حَمراءُ مِن خِدرِ ظَلامٍ وَدَجَن",1,"ن",1,0],["أَقسَمتُ بِالأَطلاحِ قَد","أَدمَجَ مِنهُنَّ الضَمَر",2,"ر",1,0],["أُقْسِمُ بِالجُرْدِ السَّراحِيبِ","وَالرُّمْحِ رَعّافَ الأَنابِيبِ",3,"ب",1,1],["أُقسِمُ ما أَدري أَمُستَيقِظاً","أَبصَرتُ ما أَبصَرتُ أَم في رُقاد",4,"د",1,0],["أُقْسِمُ بِالذِّكْرِ وَالْمَثَانِي","مَا لَكَ فِيمَا سَمِعْتُ ثَانِي",5,"ن",2,0],["أقْسَمْتُ لوْ طلَبَتْ سُعُو","دُكَ صَلْدَ صخْرٍ لانْفَطَرْ",6,"ر",1,0],["أقْسَمْتُ بالنّورِ الذي سَبَحاتُهُ","أضْحى لها الطّورُ المُنيفُ هَديدا",7,"د",2,0],["أَقسَمتُمُ لا نُعَطِّيَنكُم","إِلّا عِراراً فَذا عِرارُ",8,"ر",1,0],["أُقسِمُ بِاللَهِ وَآلائِهِ","بِعَرشِهِ بِاللَوحِ بِالكُرسِي",9,"س",2,0],["أَقسَمتُ بِالعَبّاسِ إِنّي صادِقٌ","فَمُريهِمُ بِجَلالِهِ أَن يُقسِموا",10,"م",3,0],["أَقسَمتُ بِاللَهِ إِن كانَت مَوَدَّتُنا","كَصاحِبِ الكَلبِ ساءَ الأَمرُ مُنقَلَبا",11,"ب",2,0],["أَقسَمتُ لا أَنفَكُّ أُهدي قَصيدَةً","لِصَخرٍ أَخي المِفضالِ في كُلِّ مَجمَعِ",12,"ع",1,1],["أُقسِمُ لا يَقعُدُ في بَلدَةٍ","نائِيَةٍ عَن أَهلِهِ قاصِيَه",13,"ي",2,0],["أَقْسَى وَأَغْلَظُ مَا تُرَى","الضَّرْبَاتِ مِنْ أَيْدِي النَّوَاعِمْ",14,"م",1,0],["أَقْسَى مَعَارِفَنَا الحَقَائِقُ بَعْدَمَا","يَذْوِي الخَيَالُ وَتَنْصُبُ الأوْهَامُ",15,"م",1,0],["أقسمتُ بالحرم الأمين ومكةٍ","والركنِ والبيتِ العتيقِ وزمزمِ",16,"م",1,0],["أَقسَمتُ لَو لَم يَحكِهِ ذِكرُهُ","رَجَعنَ عَنهُ بِشَبّاً ثاكِلِ",17,"ل",1,0],["أَقسَمتُ أَنساها وَأَترُكُ ذِكرَها","حَتّى تُغَيَّبَ في الضَريحِ عِظامي",18,"م",2,0],["أقسم ما أهرب إلاّ حياً","من سحب نعمى ذيلها ساحب",19,"ب",1,0],["أقسمت ما الحجر المكرَّم للغنى","إلاَّ الذي تغشون من أعتابه",20,"ه",1,0],["أقسم الحبّ لا يغيِّر قلبي","من شجونٍ ولا يُصحُّ مزاجي",21,"ج",2,0],["أقسمت من فرعها المسبول بالداجي","كالآبنوس بمشط الرجل في العاج",22,"ج",1,1],["أقسمت لو وازنت الشمس في الم","يزان دينار سناها رجح",23,"ح",1,0],["أقسمت يا موسى الزمانِ لقد وفا","بالصدقِ من أثنى عليك بصالح",24,"ح",1,0],["أقسم أنَّ الوقتَ وقتٌ صفا","وإنَّ هذا النشوَ نشوٌ سعيد",25,"د",1,0],["أقسمت بالعارض المسكيّ إن به","للمقسمين كتابَ الحسن مسطور",26,"ر",1,0],["أقسمتُ لولا أياديكَ التي اشْتهرتْ","ناداني الزمن المودي بأشعاري",27,"ر",2,0],["أقسم من ذا وذا بأنَّكم","وجدتُم من أكابر العشره",28,"ه",1,0],["أقسمت ما الملك المؤيد في الورى","إلا الحقيقة والكرام مجاز",29,"ز",1,1],["أقسمت لو عدت نعماؤه زحلاً","ما عاد بين نجوم الليل ينتحس",30,"س",1,0],["أقسم في الأنفال من برّه","وكثرة الطلاب كالنمل",31,"ل",1,0],["أقسمت ما عثرت بالفقر لي قدمٌ","إلا وصاحَ رجائي فيك يا لعلي",32,"ي",1,0],["أقسمت بالمرسلات السمر في يده","لقد تهيّب منها الأبيض الخدِم",33,"م",1,0],["أقسمت لولا جاهكم ونوالكم","أصبحت لا خلفي ولا قدَّامي",34,"م",2,0],["أقسمت ما رزءك مما يهون","يا غارقاً حتى بدمعِ العيون",35,"ن",1,1],["أقسمت لولا نداك المستهلّ لما","كانت عقيقتنا إلا مدامعنا",36,"ن",2,0],["أقسم لا ينسى الندَى","إلا إذا ما فعلا",37,"ل",2,0],["أقسمتُ ما استنجدَ عُثْنونَهُ","حتى غدا لي خائفاً هائبا",38,"ب",2,0],["أقسمتُ بالمَلِكِ الذي","لم يستطِعْ مَلِكٌ غِلابهْ",39,"ب",2,0],["أقسمتُ لو أنك لاقيتَهُم","نابَك من أضراسهم نائبُ",40,"ب",1,0],["أقسمتُ والحق له فضلُهُ","إذا الْتَقَى المحتجُّ والشاغبُ",40,"ب",1,0],["أقسمت حقاً لئن طابت ثمارهُمُ","لقد سرى عِرقُهم في أكرم التُّربِ",41,"ب",1,0],["أقسمت بالمانِحِي وجهاً أضنُّ به","عن السؤال وعِرضاً غيرَ مُنتهَبِ",42,"ب",1,0],["أقسمتُ باللَّه لمَّا قمتُ محتجِزاً","أنّي انبعَثْتُ بقلبٍ غيرِ منبعثِ",43,"ث",1,0],["أقسمتُ لا زلتُ هاجياً لهمُ","ما التطم البحر قاذفاً زَبَدَهْ",44,"د",2,0],["أقسمتُ لو أُولدَ الرجال لقد","أُولد أَلفاً وحقَّ أن يلدَهْ",44,"د",2,0],["أقسمت بالهدْي النحي","ر ومن له الهدْيُ النحيرُ",45,"ر",1,0],["أقسمتُ بالغُنجِ من مَلاحظِها","وسحر ذاك السُّجوِّ والفَتَرِ",46,"ر",1,0],["أقسم المُلك يميناً إنهُ","بعضُ أعلام الإله الباهره",47,"ر",2,0],["أقسمت بالكأس إذا أعملت","واصطخب المزمار والمِزْهر",48,"ر",1,0],["أقسمت لو لم تحصِّنا حرارتُهُ","من برد عمرو لقد أودتْ بنا القِرر",49,"ر",1,0],["أقسمتُ بالفعلاتِ الغُرّ تفعلها","في الناس أنك من غَرّاء مِذْكارِ",50,"ر",1,0],["أقسمت بالمقسمِ في وحيهِ","وآيِهِ بالشفع والوتر",51,"ر",1,0],["أقسمتُ باللَه أنْ لو كنتَ لي ولداً","لما جعلتك إلا في المطاميرِ",52,"ر",1,0],["أقسمت بالعطف منك حين ترى","مِني شماسَ الخلائِق الشُمُس",53,"س",1,0],["أقسمتُ بالمجد وأسبابه","إنك منه غير ما مُفْلس",54,"س",1,0],["أقسمتُ باللَهِ لا غفرْتُ له","إن واحدٌ من عُروقهِ نبضا",55,"ض",2,0],["أقسمت أن لو كان لي أنفُها","قططتُ من خُرطُومِه قطّه",56,"ط",2,0],["أقسمت بالشهر الذي أخضلته","بالجود والتقوى ندىً ودموعا",57,"ع",2,0],["أقسمت ما لقّيت ذلَّ مطالبٍ","كبراً ولا عز الزمان خضوعا",57,"ع",2,0],["أقسمت لو مكنت من شدوها","وكان وتراً لا أرى شَفعه",58,"ع",2,0],["أقسمتُ ما في الذي تسوس به ال","دين وملك الملوك من وكف",59,"ف",1,0],["أقسمتُ باللَّهِ والنبيِّ لقد","قضتْ مساعيك حقَّ من وَلدكْ",60,"ك",1,0],["أقسمتُ أن أخاً نفاكا","قد برَّ مجتهداً أباكا",61,"ك",2,1],["أقسمتُ لو ألبستِه جمّةً","يوسعُها كفُّك ترجيلا",62,"ل",2,0],["أقسمتُ أنك جاهلٌ","والمُمتري في ذاك جاهلْ",63,"ل",1,0],["أقسمَ المجدُ أنه لا يجلِّي","وعده عن ضوىً ولا عن حِيالِ",64,"ل",1,0],["أقسمتُ لولا قضاءٌ","من حاكم الحكّامِ",65,"م",1,0],["أقسمتُ بالله ما استيقظتُمُ لِخناً","ولا وُجدتم عن العليا بنوّامِ",66,"م",1,0],["أقسمتُ تنفك من مطالبتي","ما دام منك اللسانُ مرهونا",67,"ن",2,0],["أقسمتُ ما وعد الرجاء بحاصل","إلا وجودُك بالوفاء ضمين",68,"ن",1,0],["أقسمتُ لو تَرمي العيالَ بأَسهمٍ","ترمي بهنَّ الناس كَفُّوا أو ونَوا",69,"ن",3,0],["أَقسَمتُ ما اِهتَزَّ فَوقَ الطَرسِ لي قَلَمٌ","إِلّا جَعَلتُ لَهُ دَمعي البَتيتُ مَدَدا",70,"د",2,0],["أُقَسِّمُ جِسمي في جُسومٍ كَثيرَةٍ","وَأَحسو قَراحَ الماءِ وَالماءُ بارِدُ",71,"د",1,0],["أَقسَمتُ ما الصُنعُ الجَميلُ تَصَنُّعٌ","فيهِ وَلا الخُلُقُ الكَريمُ تَخَلُّقُ",72,"ق",1,0],["اقسمت ان لا اورد اسمك في فمي","لكنني قد كنت باسمك اقسم",73,"م",1,0],["أَقسَمتُ لَو أَمَرَ الزَمانُ سَماءَهُ","فَسَعَت لِصَدرِكَ شَمسُها وَنُجومُها",74,"ه",2,1],["أَقسَمتُ أَنَّكَ في التُرابِ طَهارَةٌ","مَلَكٌ يَهابُ سُؤالَهُ المَلَكانِ",75,"ن",1,0],["أَقسَموا لا رَؤوكَ إِلّا بِقَلبٍ","طالَما غَرَّتِ العُيونُ الرِجالا",76,"ل",2,0],["أقسَمتُ ما قبَّلَ الحُمّى سوى ملِكٍ","قبلَ الأميرِ ولا اشتاقَت إلى أحَدِ",77,"د",1,0],["أقسمتُ بالبُزْلِ النوافحِ في البُرَى","قُوداً وقُبَّا",78,"ب",2,0],["أُقسِمُ بِالقُربِ بَعدَما بُعدٍ","وَكَفِّ لاحٍ مِن بَعدِ تَثريبِ",79,"ب",1,0],["أَقِسمُ الظَنَّ فيهِ أَنّى تَخَطّى ال","رَملَ مِن عالِجِ وَأَنّى تَهَدّى",80,"د",2,0],["أَقسَمتُ بِالشَرَفِ الَّذي شَهِدَت لَهُ","أُدَدٌ وِراثَةَ يوسُفٍ عَن يوسُفِ",81,"ف",1,0],["أُقَسِّمُ فيهِ الظَنَّ طَوراً مُكَذِّباً","بِهِ أَنَّهُ حَقٌّ وَطَوراً أُصَدِّقُ",82,"ق",1,0],["أَقسَمتُ لَولا بَداهاتي وَمَعرِفَتي","بِسُخفِ قَدرِكَ يا اِبنَ الجيفَةِ الوَدِقَه",83,"ق",2,0],["أَقسَمتُ بِالبَيتِ الحَرا","مِ وَحُرمَةِ الشَهرِ الأَصَمّ",84,"م",1,0],["أَقسَمتُ بِاللَهِ ذي الجَلالَةِ وَالعِز","زِ وَمِثلِيَ مَن بَرَّ في قَسَمِه",85,"م",2,0],["أَقسَمتُ لا يَخشى الحَوادِثَ جارُهُ","وَيَمينُهُ قَمِنٌ بِبِرِّ يَميني",86,"ن",2