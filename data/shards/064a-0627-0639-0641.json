{"poems":[[181,"يا عفر إن الحي قد نقضوا","https://www.aldiwan.net/poem4493.html","أحذ الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135249","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66146","البسيط"],[4927,"اِنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=29834",""],[5277,"مريمُ..عليها السلام..القطوفُ القُدْسيّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=199954",""]],"verses":[["يا عفْرُ إِنَّ الحيَّ قد نقضوا","عهدَ الإِلهِ وحاولوا الغدْرا",0,"ر",2,1],["يا عفوا عن العصا إذا ما","حسنوا الظن بالحليم القدير",1,"ر",1,0],["يا عفاء الأنام شرقاً وغرباً","دونكم فاحتبوا بثوب العفاء",2,"ا",2,0],["يا عفوُّ توّابُ مقتدرٌ تُبْ","واعف عنا بالعفو يا غفّارُ",3,"ر",1,0],["يا عَفيفَ الدّينِ الَّذي يَدُه صر","فٌ بِهِ أَسْتَكفُّ صَرْفَ الزَّمانِ",4,"ن",1,1],["يا عَفَّةً لَمْ يَمَسَّ الدَّهْرُ رَوْنَقَها","ورأْسُ مَنْ يَبْتَغِي سُوءاً بها قَدَمُ",5,"م",1,0],["يَاْ عَفْرَاْ إِنِّيْ أَنْتَظِرُ","فَمَتَىْ يَأْتِيْ مِنْكِ الْخَبَرُ",6,"ر",1,1],["يا عفةً وطهارةً قدسيةً","لنداءِ صوتِ الحقِّ إذْ تستسلمُ",7,"م",1,0]]}