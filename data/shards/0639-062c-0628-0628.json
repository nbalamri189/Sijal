{"poems":[[82,"أجلو عروسا بخدها خجل","https://www.aldiwan.net/poem31369.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127969","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"]],"verses":[["عَجِببُ من مُحْرِقٍ ومحترِقٍ","لا فحمةٌ منهما ولا حرقُ",0,"ق",1,0],["عجبٌ بَقَائِي بعْدَ أَكْرمِ رُفْقَةٍ","زَالُوا ولَم يَشَإِ القَضَاءُ زَوَالِي",1,"ل",2,0],["عُجْ ببيت الشرقيّ تلقَ نزاعاً","وأتِ بيتَ الغربيّ تلقَ حبُورا",2,"ر",2,0],["عج ببان اللوى وسفح العقيق","فبحصائه بهيج العقيق",3,"ق",1,1],["عجب بعدهم بقائي وما قد","حل بي لو عرا الأصم لذابا",4,"ب",2,0]]}