{"poems":[[55,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[79,"مهما جرت في أذني لفظة","https://www.aldiwan.net/poem35716.html","السريع"],[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[11,"ولقد بغى بجلاد أوس قومه","https://www.aldiwan.net/poem256.html",""],[93,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[68,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[50,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16700","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[105,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[87,"أنا من بدل بالكتب الصحابا","https://www.poetsgate.com/ViewPoem.aspx?id=488",""],[69,"لاتظلموني وتظلموا الحسبه","https://www.poetsgate.com/ViewPoem.aspx?id=3145",""],[7,"بانَتْ سُعادُ، وأمْسَى حَبلُها انجذما،","https://www.poetsgate.com/ViewPoem.aspx?id=17587",""],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[173,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[274,"غضب الأحمق إذ مازحته","https://www.aldiwan.net/poem26459.html","الرمل"],[357,"أشعلت عمري شمعة !","https://www.aldiwan.net/poem959.html",""],[369,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[382,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[409,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[409,"كان السفائن سابقا","https://www.aldiwan.net/poem34136.html","مجزوء الكامل"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[520,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126823","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66800","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48541","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104568","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107306","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20400","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77312","البسيط"],[2766,"","https://poetry.dctabudhabi.ae/diwan/poem/124308","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105598","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100279","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138532",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85220","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111399","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73407","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83499","الخفيف"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127935","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33339","البسيط"],[4852,"مهيرة","https://www.poetsgate.com/ViewPoem.aspx?id=214385",""],[5136,"أما ترى القمري غنى وصاح","https://www.poetsgate.com/ViewPoem.aspx?id=121546",""],[5183,"الدعاء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=185885",""],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[5307,"حيّ ابجوابٍ ياني","https://www.poetsgate.com/ViewPoem.aspx?id=10380",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5376,"أوَذاك سرٌ في هواك أذيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=214189",""],[5612,"يا صَبُّ مالَكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179668",""],[5842,"استغفرُ الله / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=135811",""],[5864,"تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=190339",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[6029,"داء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=188849",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6102,"مَرارَةُ الحَقِيقَة","https://www.poetsgate.com/ViewPoem.aspx?id=182766",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""]],"verses":[["أَو ذاتُ نَهدٍ بَينَ سارِيَةٍ","تَتَلَوَّيانِ تَلَوِّيَ القِدِّ",0,"د",1,0],["أو ذُكِرَتْ عنْ شَفَةٍ قُبْلَةٌ","لمْ أرْضَها يوْماً سِوى في يَدَيْكْ",1,"ك",1,0],["أَوْ ذَائِدٍ عَنْ مَجْدِ أُمَّتِهِ إِذَا","عَزَّ النَّصِيرُ وَصَالَ كُلُّ مُخَاصِمِ",2,"م",1,0],["أَو ذو زَوائِدَ لا يُطافُ بِأَرضِهِ","يَغشى المُهَجهَجَ كَالذَنوبِ المُرسَلِ",3,"ل",1,0],["أَو ذو الحُصَينِ وَفارِسٌ ذو مِرَّةٍ","بِكَتيبَةٍ مَن يُدرِكوهُ يَغرِسُ",4,"س",1,0],["أوذي فَلَم يَجزَع وَضيمَ فَلَم يَهِن","إِنَّ الكَريمَ عَلى الأَذى صَبّارُ",5,"ر",1,0],["أوذِيَت هَيبَتُهُ مِن عَجزِهِ","وَقُصارى عاجِزٍ أَن لا يُهابا",6,"ب",2,0],["أوذيتَ مِن دُستورِهِم","وَحَنَنتَ لِلحُكمِ العَسير",7,"ر",1,0],["أَو ذُرى نَيلوفَرٍ رُفِعَت","فَوقَ قُضبانٍ مِنَ الغَرَبِ",8,"ب",1,0],["أُوذِيَ الدّينُ في الشِّعابِ وَردّتْ","يَدُ سعدٍ عَدوَّه مدحورا",9,"ر",2,0],["أو ذُقتُ بَعدَكَ مُرَّا كَالعِتَابِ وَقَد","جَنَيتُ مِنكَ لَهُ أحلَى مِنَ القُبَلُ",10,"ل",1,0],["أو ذي كُعوبٍ من المُرّان مُعتدِلٍ","أو ذي فِرندٍ من القُضْبان حاريّ",11,"ي",1,0],["أَو ذو شِياهٍ أَغَنِّ الصَوتِ أَرَّقَهُ","وَبلٌ سَرى ماخِضَ الوَدقَينِ غَيداقا",12,"ق",2,0],["أَو ذو نَحائِصَ أَشباهٍ إِذا نَسَقَت","مَناسِجاً وَثَنَت مَلطاً وَأَطباقا",12,"ق",2,0],["أو ذا الذي قد أرى بنا عرَقٌ","قالوا نراهُ كأنّه زبَدُ",13,"د",1,0],["أَو ذو وُشومٍ بِحَوضى باتَ مُنكَرِساً","في لَيلَةٍ مِن جُمادى أَخصَلَت دِيَما",14,"م",2,0],["أو ذاك الدهر الذي افتنَّ في صو","غِ صباها هو الذي قد محاها",15,"ه",2,0],["أو ذاتَ أيْلَةَ أعْطَتها مَلابِسَها","لِحَوْلِها وإناءُ الشّرّ قَرْبانُ",16,"ن",1,0],["أو ذي شباب ترتضى حكومته","لا فضله خاف ولا أرومته",17,"ه",1,0],["أو ذكر الحنين والحفاظ","لم تجر إلا باسمة الألفاظ",18,"ظ",1,0],["أو ذادةُ البَيعةِ والذمامِ","وقادةُ الفتنة والزمام",19,"م",1,0],["أَوْ ذلِكَ الخَلْقُ الْخَيَا","لِيُّ الْحَقِيقِيُّ الْقِوَامِ",20,"م",1,0],["أَوْ ذلِكَ التَّوْفِيقُ فِي","قَدْرِ المَقَالِ عَلَى المَقَامِ",20,"م",1,0],["أَوْ ذلِكَ اللَّفْظُ الرَّقِي","قُ مَعَ الْجَلاَءِ وَالاِنْسِجَامِ",20,"م",1,0],["أَوْ ذَلِكَ الفَادِي أَباهُ بِحُبِّهِ","لذْريِقُ خيْرُ ابْنٍ وَخيْرُ شُجَاعِ",21,"ع",1,0],["أوذوا فما فتنوا والصبر رائدهم","والمجد للدين بالأرواح قد كتبوا",22,"ب",3,0],["أوذِيَت هَيبَتُهُ مِن عَجزِهِ","وَقُصارى عاجِزٍ أَلا يُهابا",23,"ب",2,0],["أوذ بالله أن أكون كمن","تغلبه في الرقاعة ِ الرغبه",24,"ب",2,0],["أو ذو وشومٍ بحوضي باتَ منكرساً","، في ليلة ٍ من جُمادى أخضَلتْ دِيَمَا",25,"م",2,0],["أوذُ بواديك المقدِّسِ أن أُرى","فريسةَ قنّاصٍ من الدهر نهَّاسِ",26,"س",1,0],["أَو ذاتُ قِلعٍ مِنَ العَيناءِ ما عُرِفَت","في زَجرِها بخَلٍ يَوماً وَلا هِدَعِ",27,"ع",1,0],["أَو ذاقَها المَنزُوفُ ضَرطاً لَما","هابَ اِبنَ ذي الجَدَّينِ يَومَ الزِحام",28,"م",1,0],["أو ذاقها موسى لكا","نَ من الفصحاة في الصميم",29,"م",1,0],["أوْ ذَا الفَقَّارِيَقُدُّ مِنْ","جَمْعِ الْخَوَارِجِ مَا تَمَرَّدْ",30,"د",1,0],["أَو ذَكَرنا أَنَّهُ لاعَبَها","لُعبَةَ الجِدِّ بِمَزحِ الدَّغدَغَه",31,"غ",2,0],["أو ذوَّبته امن الولعه","لي به اوصابه مُوع",32,"ع",1,0],["أو ذاهبٍ في الهَزْلِ أبعدَ مَذْهبٍ","أو حائرٍ في الجهلِ شَرَّ تَحَيُّر",33,"ر",1,0],["أو ذائباً أو نادباً أو آئبا","أو راكباً أو راغباً أو طالبا",34,"ب",2,0],["أو ذكرنا جنات عدن وما","في النار من هول لمن يجتري",35,"ر",2,0],["أو ذكرنا أحمد خير الورى","ساقيهُم من حوضه الكوثري",35,"ر",2,0],["أو ذكرنا بدراً وأُحْداً وما","جاء في الأخبار عن خيبر",35,"ر",1,0],["أو ذكرنا إثم الربا والزنا","والضرب بالأوتار والمسكر",35,"ر",1,0],["أو ذكر أهل البيت أهل التقى","سلسلة تُنْمَى إلى حيدر",35,"ر",1,0],["أو ذكر أيام الوصا","ل مع الأحبة والشباب",36,"ب",1,0],["أو ذكرنا تفُّوقاً للدعى","في شعوبٍ علت جواءً وُسحبا",37,"ب",2,0],["أو ذكر الإسلام لم يفتخر","غيرهم حي بنصر النبي",38,"ب",2,0],["أو ذُكر الجود فمن طيء","أبو عدي نجعه المجدب",38,"ب",1,0],["أو ذات طفل صغير غاب قيّمُها","عنها فباتَت على شجو وإعوالِ",39,"ل",1,0],["أوذى وأُشتمُ فيكم ويُصيبني","من ذي القَرابة جَفوةٌ ومَلامُ",40,"م",1,0],["أَو ذي لغمٍ بِالصلقومِ","لا يُطعمُ غَيرَ الزقُّومِ",41,"م",1,0],["أَو ذي علمٍ عِندَ الخطبِ","بِدقائق هَندسة الحَربِ",41,"ب",1,0],["أو ذات وهمٍ في سوى ال","غيرة لا تُفَكِّرُ",42,"ر",1,0],["أو ذَوبَ جمرٍ حلّ في جامِد ال","ماءِ فأبدى فوقهُ دُرّا",43,"ر",2,0],["أَوْ ذِكْرُ ذاتِ الرَبَذِ المُعَهَّنِ","في خِدْرِ مَيّاسِ الدُمَى مُعَرْجنِ",44,"ن",1,0],["أوْ ذا خَبالٍ للخنا تَحَمَّسا","أو ذا سُعارٍ بالزِّنَى تَمرَّسا",45,"س",2,0],["أو ذَكرتُ الوصلَ إِلّا","وغَدا الدَمعُ انسِجاما",46,"م",2,0],["أو ذلك الأدب الذي شهدت به","في كل شعب بالجمال عدول",47,"ل",1,0],["أَو ذا شَصائِبٍ في أَحنائِهِ شَمَمٌ","رخو المَلاط غَبيطاً فَوقَ صُرصورِ",48,"ر",1,0],["أو ذَلِكَ المَخدُوعُ حَامِلُ رَايَةِ ال","الحَادِ ذَاكَ خَلِيفَةُ الشَّيطَانِ",49,"ن",1,0],["أو ذَا الذِي قَامَت بِهِ الأوصَافُ أو","صَافُ الكَمَالِ عَدِيمَةٌ النُّقصَانِ",49,"ن",1,0],["أو ذا بحسب تفاوت في الأغنيا","ء كلاهما لا شك موجودان",49,"ن",1,0],["أَو ذُقتَ بَردَ ثَناياهُ وَريقَتَهُ","زَهِدتَ ما عِشتَ في خَمرٍ وَفي حَبَبِ",50,"ب",1,0],["أو ذاريات من أنفاس الصبا عصفاً","أو عائداتٌ لها من نكبها مهلا",51,"ل",2,0],["أو ذكرت الهنى من عيشنا الغض","ض على شط جدول منساب",52,"ب",1,0],["أو ذقت بعض صبابتي لرحمتني","وعلمت أنك ظالم مظلوما",53,"م",2,0],["أو ذرتي صدف تعلقتا حلىً","من جيد عاطلة السوالف رود",54,"د",1,0],["أوذيت صغرت مقاماً أريعت","ضربت جهرةً ولا من مجير",55,"ر",1,0],["أوذاك قلب شقيق خير ربى","أم تلك قطعة عنبر الشحر",56,"ر",1,0],["أوذيس ينقادون أي انقياد","عادوا بما أتريذ فيها ادخر",57,"ر",1,0],["أو ذِرِيَسٍ راعي الورَى والمُجتَبِى","فُوليفِمٍ قَومٍ خَلَوا صَلدِينا",58,"ن",2,0],["أَو ذاتُ دَلِّ كالغَزالةِ إِن بَدَت","وجهاً وَجِيداً كالغَزَالِ إِذا سَنَح",59,"ح",1,0],["أَو ذكرت الجوار خيرَ جوار","لِلحَبيب المُختارِ خيرِ الأَحِبَّه",60,"ب",2,0],["أو ذا اعدّد في محاسنها التي","فاقت محاسن سائر الانحاءِ",61,"ا",2,0],["أو ذاقَ من صَدَّ عنه مثل ليلتهِ","أو بعضَ ما كانَ يلقى منه ما صبرا",62,"ر",2,0],["أوَ ذي أنا تلك التي في لمحةٍ","أضحتْ سماها واحةً مخضلهْ؟!",63,"ل",2,0],["أو ذوب ياقوت أسالوه في","أهلة الأفق وسموه راح",64,"ح",1,0],["أو ذبت فيك إليك شوقا عارما","إلا لمست القدس في ريحانه",65,"ن",2,0],["أو ذهبنا إلى الزهوب لنأتي","بخضير من دون أي جناح",66,"ح",1,0],["أو ذكراهم من زماني","معروف مع لعباد",67,"د",1,0],["او ذاهب العقل والنشوان من سكر","أو كالحمار الذي يعدو بلا رسن",68,"ن",1,0],["أوَذاك سرٌ في هواك أذيعُ","والنفسُ خاشعةٌ إليك تَطيعُ",69,"ع",1,1],["أوَ ذُبْتَ وَجْداً واحْترَقْتَ صَبابةً ؟؟","وبَراكَ جُرْحٌ واسْتبَدَّ وَجيبُ ؟؟",70,"ب",1,0],["أو ذا يُكَبِّر فوق المالِ يَسرِقُهُ","ظَنّ الغَنيِمَة في زَيْغٍ عَنِ الرَشَدِ",71,"د",1,0],["أو ذاقَ ذُلَّ الخوفِ مَن","أمسى كتابُ اللهِ وِردَه",72,"د",2,0],["أو ذكريات مرارة علقت","بفمي من التنهيد والزجل",73,"ل",1,0],["أو ذكرياتٍ إذا هبَّتْ عواصِفُها","أرْخَتْ بِكَلْكَلِها في القَلبِ بأساءُ",74,"ا",2,0],["أَوْ ذُبَابٍ أَزْعَجَ الدُّنْيَا مَدى","كَفَّنَتْهُ عَنْكَبُوتٌ يَوْمَ عِيدْ",75,"د",1,0],["أُوذِيتَ مِنهُم مِرارًا, فالتَجَأتَ إِلَى","سُهدٍ تُطارِدُهُ فِي اللَّيلِ أَشباحُ",76,"ح",1,0],["أؤذِّن في شرق البلاد، أعيدُها","إلى ملكوتٍ أسودٍ من عهودها",77,"د",3,0]]}