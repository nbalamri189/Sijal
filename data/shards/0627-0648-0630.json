{"poems":[[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[77,"مهما جرت في أذني لفظة","https://www.aldiwan.net/poem35716.html","السريع"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[11,"ولقد بغى بجلاد أوس قومه","https://www.aldiwan.net/poem256.html",""],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[48,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16700","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[85,"أنا من بدل بالكتب الصحابا","https://www.poetsgate.com/ViewPoem.aspx?id=488",""],[67,"لاتظلموني وتظلموا الحسبه","https://www.poetsgate.com/ViewPoem.aspx?id=3145",""],[7,"بانَتْ سُعادُ، وأمْسَى حَبلُها انجذما،","https://www.poetsgate.com/ViewPoem.aspx?id=17587",""],[140,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[167,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[167,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[195,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[235,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[267,"غضب الأحمق إذ مازحته","https://www.aldiwan.net/poem26459.html","الرمل"],[350,"أشعلت عمري شمعة !","https://www.aldiwan.net/poem959.html",""],[362,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[374,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[400,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[400,"كان السفائن سابقا","https://www.aldiwan.net/poem34136.html","مجزوء الكامل"],[451,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"]],"verses":[["أَو ذاتُ نَهدٍ بَينَ سارِيَةٍ","تَتَلَوَّيانِ تَلَوِّيَ القِدِّ",0,"د",1,0],["أو ذُكِرَتْ عنْ شَفَةٍ قُبْلَةٌ","لمْ أرْضَها يوْماً سِوى في يَدَيْكْ",1,"ك",1,0],["أَوْ ذَائِدٍ عَنْ مَجْدِ أُمَّتِهِ إِذَا","عَزَّ النَّصِيرُ وَصَالَ كُلُّ مُخَاصِمِ",2,"م",1,0],["أَو ذو زَوائِدَ لا يُطافُ بِأَرضِهِ","يَغشى المُهَجهَجَ كَالذَنوبِ المُرسَلِ",3,"ل",1,0],["أَو ذو الحُصَينِ وَفارِسٌ ذو مِرَّةٍ","بِكَتيبَةٍ مَن يُدرِكوهُ يَغرِسُ",4,"س",1,0],["أوذي فَلَم يَجزَع وَضيمَ فَلَم يَهِن","إِنَّ الكَريمَ عَلى الأَذى صَبّارُ",5,"ر",1,0],["أوذِيَت هَيبَتُهُ مِن عَجزِهِ","وَقُصارى عاجِزٍ أَن لا يُهابا",6,"ب",2,0],["أوذيتَ مِن دُستورِهِم","وَحَنَنتَ لِلحُكمِ العَسير",7,"ر",1,0],["أَو ذُرى نَيلوفَرٍ رُفِعَت","فَوقَ قُضبانٍ مِنَ الغَرَبِ",8,"ب",1,0],["أُوذِيَ الدّينُ في الشِّعابِ وَردّتْ","يَدُ سعدٍ عَدوَّه مدحورا",9,"ر",2,0],["أو ذُقتُ بَعدَكَ مُرَّا كَالعِتَابِ وَقَد","جَنَيتُ مِنكَ لَهُ أحلَى مِنَ القُبَلُ",10,"ل",1,0],["أو ذي كُعوبٍ من المُرّان مُعتدِلٍ","أو ذي فِرندٍ من القُضْبان حاريّ",11,"ي",1,0],["أَو ذو شِياهٍ أَغَنِّ الصَوتِ أَرَّقَهُ","وَبلٌ سَرى ماخِضَ الوَدقَينِ غَيداقا",12,"ق",2,0],["أَو ذو نَحائِصَ أَشباهٍ إِذا نَسَقَت","مَناسِجاً وَثَنَت مَلطاً وَأَطباقا",12,"ق",2,0],["أو ذا الذي قد أرى بنا عرَقٌ","قالوا نراهُ كأنّه زبَدُ",13,"د",1,0],["أَو ذو وُشومٍ بِحَوضى باتَ مُنكَرِساً","في لَيلَةٍ مِن جُمادى أَخصَلَت دِيَما",14,"م",2,0],["أو ذاك الدهر الذي افتنَّ في صو","غِ صباها هو الذي قد محاها",15,"ه",2,0],["أو ذاتَ أيْلَةَ أعْطَتها مَلابِسَها","لِحَوْلِها وإناءُ الشّرّ قَرْبانُ",16,"ن",1,0],["أو ذي شباب ترتضى حكومته","لا فضله خاف ولا أرومته",17,"ه",1,0],["أو ذكر الحنين والحفاظ","لم تجر إلا باسمة الألفاظ",18,"ظ",1,0],["أو ذادةُ البَيعةِ والذمامِ","وقادةُ الفتنة والزمام",19,"م",1,0],["أَوْ ذلِكَ الخَلْقُ الْخَيَا","لِيُّ الْحَقِيقِيُّ الْقِوَامِ",20,"م",1,0],["أَوْ ذلِكَ التَّوْفِيقُ فِي","قَدْرِ المَقَالِ عَلَى المَقَامِ",20,"م",1,0],["أَوْ ذلِكَ اللَّفْظُ الرَّقِي","قُ مَعَ الْجَلاَءِ وَالاِنْسِجَامِ",20,"م",1,0],["أَوْ ذَلِكَ الفَادِي أَباهُ بِحُبِّهِ","لذْريِقُ خيْرُ ابْنٍ وَخيْرُ شُجَاعِ",21,"ع",1,0],["أوذوا فما فتنوا والصبر رائدهم","والمجد للدين بالأرواح قد كتبوا",22,"ب",3,0],["أوذِيَت هَيبَتُهُ مِن عَجزِهِ","وَقُصارى عاجِزٍ أَلا يُهابا",23,"ب",2,0],["أوذ بالله أن أكون كمن","تغلبه في الرقاعة ِ الرغبه",24,"ب",2,0],["أو ذو وشومٍ بحوضي باتَ منكرساً","، في ليلة ٍ من جُمادى أخضَلتْ دِيَمَا",25,"م",2,0],["أوذُ بواديك المقدِّسِ أن أُرى","فريسةَ قنّاصٍ من الدهر نهَّاسِ",26,"س",1,0],["أَو ذاتُ قِلعٍ مِنَ العَيناءِ ما عُرِفَت","في زَجرِها بخَلٍ يَوماً وَلا هِدَعِ",27,"ع",1,0],["أَو ذاقَها المَنزُوفُ ضَرطاً لَما","هابَ اِبنَ ذي الجَدَّينِ يَومَ الزِحام",28,"م",1,0],["أو ذاقها موسى لكا","نَ من الفصحاة في الصميم",29,"م",1,0],["أوْ ذَا الفَقَّارِيَقُدُّ مِنْ","جَمْعِ الْخَوَارِجِ مَا تَمَرَّدْ",30,"د",1,0],["أَو ذَكَرنا أَنَّهُ لاعَبَها","لُعبَةَ الجِدِّ بِمَزحِ الدَّغدَغَه",31,"غ",2,0],["أو ذوَّبته امن الولعه","لي به اوصابه مُوع",32,"ع",1,0],["أو ذاهبٍ في الهَزْلِ أبعدَ مَذْهبٍ","أو حائرٍ في الجهلِ شَرَّ تَحَيُّر",33,"ر",1,0],["أو ذائباً أو نادباً أو آئبا","أو راكباً أو راغباً أو طالبا",34,"ب",2,0],["أو ذكرنا جنات عدن وما","في النار من هول لمن يجتري",35,"ي",1,0],["أو ذكرنا أحمد خير الورى","ساقيهُم من حوضه الكوثري",35,"ي",1,0],["أو ذكرنا بدراً وأُحْداً وما","جاء في الأخبار عن خيبر",35,"ر",1,0],["أو ذكرنا إثم الربا والزنا","والضرب بالأوتار والمسكر",35,"ر",1,0],["أو ذكر أهل البيت أهل التقى","سلسلة تُنْمَى إلى حيدر",35,"ر",1,0],["أو ذكر أيام الوصا","ل مع الأحبة والشباب",36,"ب",1,0],["أو ذكرنا تفُّوقاً للدعى","في شعوبٍ علت جواءً وُسحبا",37,"ب",2,0],["أو ذكر الإسلام لم يفتخر","غيرهم حي بنصر النبي",38,"ب",2,0],["أو ذُكر الجود فمن طيء","أبو عدي نجعه المجدب",38,"ب",1,0]]}