{"poems":[[55,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[93,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[47,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[82,"يا ليل هل لصباحي فيك إشراق","https://www.aldiwan.net/poem31360.html","البسيط"],[82,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[76,"جفن تجافى للخلي عن الكرى","https://www.aldiwan.net/poem12960.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[93,"لمن الديار؟","https://www.poetsgate.com/ViewPoem.aspx?id=53211",""],[240,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[240,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[289,"رحل المطي إليك طلاب الندى","https://www.aldiwan.net/poem44335.html","الكامل"],[302,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[369,"هو الغرام أقام الحي أم ظعنوا","https://www.aldiwan.net/poem60629.html","البسيط"],[369,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[438,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[473,"أحسن بداري إذا لاحت مجالسها","https://www.aldiwan.net/poem59949.html","البسيط"],[556,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[572,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70844","المجتث"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100361","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121560","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45754","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132117","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117855","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36759","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131288",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66630","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116059","البسيط"],[5102,"المجلس الملكي لشؤون الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=14096",""],[5111,"النورُ المقدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=212081",""]],"verses":[["مِن كُلِّ طَلقِ الوَجهِ سَهلِ الحَيا","يَبسُمُ عَن أَخلاقِهِ الغُرِّ",0,"ر",1,0],["منْ كُلِّ طِرْفٍ يَبُذُّ الطّرْفَ مُلتَهِباً","في حُضْرِهِ ولِشَأْوِ الرّيحِ مُلْتَهِما",1,"م",2,0],["مِنْ كُلِّ طَائِرَةٍ كَأَنَّ جَنَاحَهَا","وَهُوَ الشِّرَاعُ بِهِ الْفَرَاخُ تُظَلَّلُ",2,"ل",1,0],["من كُلّ طُولٍ وطَوْلٍ في شمائله","وكلّ جودٍ وجَوْدٍ في أناملِهِ",3,"ل",2,0],["مِن كُلِّ طَيّارٍ أَرَقَّ جَناحَهُ","لَفحُ الحَرورِ وَطولُ ما يَتَنَقَّلُ",4,"ل",1,0],["مِن كُلِّ طائِرَةٍ بِخَمسِ خَوافِقٍ","دُعجٍ كَما ذُعِرَ الظَليمُ المُهذِبُ",5,"ب",1,0],["مِن كُلِّ طاعِنَةِ الخُرطومِ ساريةٍ","كَأَنَّ لَسعَتَها بالنارِ إِحراقُ",6,"ق",1,0],["من كلّ طِرْفٍ يستطيرُ كَطَرْفِهِ","جَرْياً فوثبَتُه غِلابُ السابِقِ",7,"ق",1,0],["مِن كُلِّ طَلقِ الوَجهِ تاهَ جَوادُهُ","زَهواً بِعِزَّةِ رَبِّهِ فَتَبَختَرا",8,"ر",2,0],["مِنْ كُلِّ طَاوِيَةِ الحَشَى مَمْشُوقَةٍ","رَيَّا الخُدُودِ كَحَبَّةِ العُنْقُودِ",9,"د",1,0],["من كلّ طيّار أرقّ جناحه","لفح الحرور وطول ما ينتقل",10,"ل",1,0],["مِن كُلِّ طَلقِ الوَجهِ بَسّامٍ إِلى ال","عافينَ فَيّاضِ اليَدينِ حُلاحِلِ",11,"ل",1,0],["مِن كُلِّ طَلقِ الجَبينِ مُبتَسِمٍ","بِالتاجِ يَومَ السَلامِ مَعصوبِ",12,"ب",1,0],["مِن كُلِّ طاوِيَةِ الحَشى مَزورَةٌ","قَطَعاً لِكُلِّ تَنوفَةٍ دَوِيَّة",13,"ي",2,0],["من كُلِّ طاهرة الأَذيال ظاهرةٍ","تَرمي العِدى بعيونٍ نَحوها صورِ",14,"ر",1,0],["من كل طود في العلوم وفي الحجا","متبحر متفنن متوسع",15,"ع",1,0],["من كلِّ طائرةٍ بالرَّحْلِ أربَعُها","كأنّما هي في جَوْز الفلا فَدَن",16,"ن",1,0],["من كلِّ طَودٍ في العنان وَمَرُّهُ","كالبَرقِ تحت الفارسِ المتُلبِّب",17,"ب",1,0],["مِن كُل طَرف إِذا ما الطَرف عايَنهُ","تَقَسمَت لُبهُ الأَوضاح وَالغُرُرُ",18,"ر",1,0],["من كلِّ طائرةٍ تشفُّ فتغتدي","في اليمّ ظاميةً بعبِّ قَراحه",19,"ح",2,0],["من كلّ طائرةِ الشُّعا","عِ إذا استطار شَرارُها",20,"ر",3,0],["مِن كُلِّ طِنفِسَةٍ زَهراءَ مُشرِقَةٍ","كَأَنَّها نُسِجَت مِن ريشِ طاووسِ",21,"س",1,0],["مِن كُلّ طيّانِ الحشا ضامرٍ","يَركَبُ في يومِ الوغى ضُمَّرا",22,"ر",2,0],["من كل طِرْفٍ سَابحٍ طمَّاحِ","مُنَاسِبٍ للبَرْقِ والرِّيَاحِ",23,"ح",1,0],["من كل طَبٍّ عليمٍ","بما توارى النبائث",24,"ث",1,0],["من كل طيار كأن له دماً","عند الرماةِ فثار يبغي الثارا",25,"ر",2,0],["مِنْ كُلِّ طَالِعَةٍ فِي البِيدِ تُبْعِدُهَا","أَيْدِي النَّوَى وَأَمَانُ الصَّبِّ يُدْنِيهَا",26,"ي",3,0],["من كل طِرْفٍ أجردٍ لو جرى","وراءه البارقُ لم يُلْحق",27,"ق",1,0],["مِنْ كُلِّ طارِقِ لَيلِ همِّي ينتحي","وَجْهي بوجهٍ من لقائِكَ أَزْهَرَا",28,"ر",2,0],["من كل طود شامخ عطودٍ","خوى على العيوق بالكلاكل",29,"ل",1,0],["من كل طود شامخ","متسربل برداه مجدا",30,"د",2,0],["من كلِّ طاوي المصير تحسِبُه","يضمر من طيّ كشحِه ألمَا",31,"م",2,0],["مِن كُلِ طلاع أَنجاد تَقاد لَهُم","القَوم المَناجيد وَالقود الجَلاعيد",32,"د",1,0],["من كل طاهرة الشعور كأنها","نور الصباح أو النسيم الساري",33,"ر",2,0],["من كل طود أو خضم زاخر","أو كوكب في الأفق سام ساري",34,"ر",2,0],["مِن كُلِّ طِرفٍ تَفوقُ الطَرفَ سُرعَتُهُ","وَسابِحٍ مِثلَ سِيدِ الرَملِ ما عَسَلا",35,"ل",2,0],["من كل طائشةٍ وقاحٍ وجهها","أبداً تزور مدلةً وتزار",36,"ر",1,0],["مِنْ كُلِّ طائِلَةِ القِوامِ تَغُضُّ مِنْ","فَرْطِ الحَيَا وَالتِّيهِ طَرْفاً قاصِرَا",37,"ر",2,0],["من كلِّ طرفٍ مريضِ الجفنِ تُنشدُنا","ألحاظُهُ رُبَّ رامٍ من بنى ثُعَلِ",38,"ل",1,0],["من كل طيف شكله متآلفٌ","شيوخُهم ،وشبابهُم ،ونساءُ",39,"ا",2,0],["مِنْ كُلِّ طِفْلٍ فِيْ سِمَاكَ تَعَلُّقٌ","هَامَتْ بِهِ إليَاذَةٌ وَدِمَاءُ",40,"ا",2,0]]}