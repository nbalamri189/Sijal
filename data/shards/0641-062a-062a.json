0794","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89109","المتدارك"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/28","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62897","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131982","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118014","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117952","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85232","الطويل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139836",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105559","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66101","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204321","البسيط"],[4830,"همسات الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=193596",""],[4927,"حَيَاْتُكَ تَمْثِيْلٌ، وَوَهْمٌ، وَمَسْرَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=4578",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5431,"ويشرق دربنا نورا ورفْقا/يوم اللجوء","https://www.poetsgate.com/ViewPoem.aspx?id=189597",""],[5653,"لَعَلَّكَ بالوادي المُقَدَّسِ شاطىء ُ","https://www.poetsgate.com/ViewPoem.aspx?id=26369",""],[402,"يا حسنها حين تجلت على","https://www.poetsgate.com/ViewPoem.aspx?id=36426",""],[402,"لتاج تاج مملكين عظام","https://www.poetsgate.com/ViewPoem.aspx?id=36335",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6032,"غرام وشجون","https://www.poetsgate.com/ViewPoem.aspx?id=181505",""]],"verses":[["فَتُتلِفُ بالأولى إِذا ابتدأَت بِها","نفوساً وبالأُخرى إلينا تعيدها",0,"د",3,0],["فَتُتْلَى سُطُورُ الْكَتْبِ فَوْقِيَ دَائِماً","وَتُعْرَضُ مِنْ تَحْتِي سُطُورُ الْكَتَائِبِ",1,"ب",1,0],["فَتَترُكُها قَدِ اِضطَرَمَت بِطَعنٍ","تَضَمَّنَهُ إِذا اِختَلَفَت كُلاها",2,"ا",3,0],["فَتَتَرَاءى بَشَراً مِثْلَنَا","وَتَتَوَلَّى مُلْكَهَا فِي الأَنَامْ",3,"م",1,0],["فَتَتَابَعَتْ أَعْيَادُهَا وَكَأَنَّهَا","يَقَظَاتُهَا خُلَسٌ مِنَ الأَحْلامِ",4,"م",1,0],["فتُتلى على الأسماع منها بدائع","وتُجلى على الأبصار منها عقائلُ",5,"ل",1,0],["فتَتوّجْه هنيئاً إنه","خير تيجانك تلك الفاخره",6,"ر",2,0],["فَتَتَوَّجَت بِجِنانِها وَزَهَت عَلى","تِلكَ الرِياضِ بِبَهجَةِ التيجانِ",7,"ن",1,0],["فَتَتَوَّجَ الزَرعُ السَنِيُّ بِسُنبُلٍ","غَضِّ الكَمائِمِ أَخضَرِ الشَعراتِ",8,"ت",1,0],["فَتَتابَعوا أَضَماً وَكانَ خَطيبَهُم","حَسبُ اِبنِ نِهيا ما بِهِ مَوقورُ",9,"ر",1,0],["فتُتلى سُطورُ الكتْبِ فوْقيَى دائما","وتُعْرضُ من تحتي سطورُ الكتائِب",10,"ب",1,0],["فتتابعت نِعَمُ الأمير سوابغاً","عند الأمير تجرِّر الأذيالا",11,"ل",2,0],["فَتََتَّقَتْ أَزْهَارُهَا","وَتَأَرَّجَتْ فيِ كُلِّ مَعْهَدْ",12,"د",1,0],["فتتلو عليها ررياح المساء","قصيدة يأسي وأحزانيه",13,"ه",1,0],["فتتناكبود الحاسدين بمجدنا","فعضّوا على أستاههم في الورى رغما",14,"م",2,0],["فتَّتَّ منها قواصي بَنباويَتِهِ","بالهَدْمِ والنَّارِ فَتّاً فتّ فِي عضدِهْ",15,"د",2,0],["فَتَتْبَعُهُ الأنصارُ وهي خواسِرٌ","وتنقلبُ الأبصارُ وهو خواسئُ",16,"ا",1,0],["فَتتركان النَوم وَالتَوريكا","في الفَرش ثُم تلعنان الدِيكا",17,"ك",2,0],["فتتوا الأكباد تأويهاّ على","تحفة الأمصار ذياك العلم",18,"م",1,0],["فتترست من يقيني بدرع","هو لي معقل من الآفات",19,"ت",1,0],["فتتوا لي من السفرجل والت","فاح والرازقي والرمان",20,"ن",1,0],["فتتت حزناً ووهناً كبدي","يجيش من شؤني همعا",21,"ع",2,0],["فتتحفونه بكل ارب","تأسيا بالخفي العربي",22,"ب",2,0],["فَتَتََرَّسُوا بِالوَحيِ وَالسُّنَنِ الَّتِي","تَتلُوهُ نِعمَ التُّرسُ لِلشُّجعَانِ",23,"ن",1,0],["فَتَتَبَّعتَ السّواقي","وَتَسَلّقتَ الصُّخور",24,"ر",1,0],["فتتوج من العباد بحمد","هو خير من اللآلي وادوم",25,"م",1,0],["فتتبعهم ومضى موسى","هرباً لليم المعبور",26,"ر",1,0],["فَتَتَوَّجوا مُلكاً لَهُم هِمَمٌ","فَفَنوا فِناءَ أَوائِلِ الأُمَمِ",27,"م",1,0],["فَتَتَبَّعَ الادواءَ يحْسِمُهَا","وبالكيِّ حتى ماتَتِ العِلَلُ",28,"ل",1,0],["فتت قلب القيروان فأصبحت","ثكلى تنوح عليك من آلام",29,"م",1,0],["فتتعب العفيفة المراقبة","في دفع ذاك الميل خوف العاقبة",30,"ه",1,0],["فتتبع العورات أخبث خلّة","تهوي بمن يعتادها من حالق",31,"ق",1,0],["فَتَترُكُ يَوماً صَريعاً بِقَبرِهِ","رَهيناً أَسيراً أَيساً مِن وَرائِهِ",32,"ا",3,0],["فتت بأعضاء دين الله واقتدحت","وجداً بأفئدة الإسلام معتلجا",33,"ج",2,0],["فَتُتبِعُ خُبرَكَ بِالخَبَرِ","عَلِمتُكَ خَيرَ بَني البَشَرِ",34,"ر",1,0],["فتت الوجد مهجتي وبراني","وجرى الدمع من عيوني انسكابا",35,"ب",2,0],["فَتَتعدّضى أَنفُسٌ وأَنفُسٌ","بِأَعينِ العِينِ عَلَيها يُعتَدَى",36,"ا",1,0],["فَتَّتْ وانتمْ رُقُودٌ في مَضاجِعِكُمْ","في ساعدِ الشِّيبِ والشُّبانِ والفُطُمِ",37,"م",1,0],["فتت في عضدي يا من غنيت به","أفت في عضد الباغي وأنتصف",38,"ف",1,0],["فتتلونَّ بآي العُشقِ ما طلعتْ","شمسٌ وما بانَ بدرٌ في ذُرى الظُلَمِ",39,"م",1,0],["فَتَتْرُكُ فِي الأَوْطَاْنِ طِرْحاً(5) مُنَاْفِقاً","وَتَطْرَحُ مِنْهَاْ كُلَّ مَنْ كَاْنَ يَكْدَحُ",40,"ح",1,0],["فتتابعت قفزاتك الكبرى مع ال","بذل السخي بدون أي حدود",41,"د",1,0],["فتتبعنا المحبة مثل نحلٍ","لتنشر عطره غرباً وشرقا",42,"ق",2,0],["فَتَتْبَعُهُ الأنصارُ وهي خواسِرٌ","وتنقلبُ الأبصارُ وهي خواسىء ُ",43,"ا",1,0],["فتتراءى بشرا مثلنا","وتتولى ملكها في النام",44,"م",1,0],["فتتابعت أعيادها وكأنها","يقظاتها خلس من الحلام",45,"م",1,0],["فتتركُ من تَرَاهُ النَّاسُ كَلاَّ","على المولَى وتذْهبُ بالمَوَالِي",46,"ل",2,0],["فتتيه في دنيا الهيام دروبنا","حتى كأن الكون لا يعنينا",47,"ن",2,0]]}