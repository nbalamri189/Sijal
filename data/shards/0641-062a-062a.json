{"poems":[[63,"وحاكية للريم جيدا ومقلة","https://www.aldiwan.net/poem45692.html","الطويل"],[77,"أأبصرت مني في المصانع قبة","https://www.aldiwan.net/poem36774.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[93,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[51,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[77,"أأبْصرتَ مني في المصانع قُبَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=33305",""],[204,"سنة يزاد بها الأمير جمالا","https://www.aldiwan.net/poem53156.html","الكامل"],[237,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[328,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[437,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[439,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"]],"verses":[["فَتُتلِفُ بالأولى إِذا ابتدأَت بِها","نفوساً وبالأُخرى إلينا تعيدها",0,"د",3,0],["فَتُتْلَى سُطُورُ الْكَتْبِ فَوْقِيَ دَائِماً","وَتُعْرَضُ مِنْ تَحْتِي سُطُورُ الْكَتَائِبِ",1,"ب",1,0],["فَتَترُكُها قَدِ اِضطَرَمَت بِطَعنٍ","تَضَمَّنَهُ إِذا اِختَلَفَت كُلاها",2,"ا",3,0],["فَتَتَرَاءى بَشَراً مِثْلَنَا","وَتَتَوَلَّى مُلْكَهَا فِي الأَنَامْ",3,"م",1,0],["فَتَتَابَعَتْ أَعْيَادُهَا وَكَأَنَّهَا","يَقَظَاتُهَا خُلَسٌ مِنَ الأَحْلامِ",4,"م",1,0],["فتُتلى على الأسماع منها بدائع","وتُجلى على الأبصار منها عقائلُ",5,"ل",1,0],["فتَتوّجْه هنيئاً إنه","خير تيجانك تلك الفاخره",6,"ر",2,0],["فَتَتَوَّجَت بِجِنانِها وَزَهَت عَلى","تِلكَ الرِياضِ بِبَهجَةِ التيجانِ",7,"ن",1,0],["فَتَتَوَّجَ الزَرعُ السَنِيُّ بِسُنبُلٍ","غَضِّ الكَمائِمِ أَخضَرِ الشَعراتِ",8,"ت",1,0],["فَتَتابَعوا أَضَماً وَكانَ خَطيبَهُم","حَسبُ اِبنِ نِهيا ما بِهِ مَوقورُ",9,"ر",1,0],["فتُتلى سُطورُ الكتْبِ فوْقيَى دائما","وتُعْرضُ من تحتي سطورُ الكتائِب",10,"ب",1,0],["فتتابعت نِعَمُ الأمير سوابغاً","عند الأمير تجرِّر الأذيالا",11,"ل",2,0],["فَتََتَّقَتْ أَزْهَارُهَا","وَتَأَرَّجَتْ فيِ كُلِّ مَعْهَدْ",12,"د",1,0],["فتتلو عليها ررياح المساء","قصيدة يأسي وأحزانيه",13,"ه",1,0],["فتتناكبود الحاسدين بمجدنا","فعضّوا على أستاههم في الورى رغما",14,"م",2,0],["فتَّتَّ منها قواصي بَنباويَتِهِ","بالهَدْمِ والنَّارِ فَتّاً فتّ فِي عضدِهْ",15,"د",2,0]]}