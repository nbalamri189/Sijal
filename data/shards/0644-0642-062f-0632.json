{"poems":[[53,"خذي حديثك من نفسي عن النفس","https://www.aldiwan.net/poem30189.html","البسيط"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[63,"أما وتجني طيفها المتأوب","https://www.aldiwan.net/poem46154.html","الطويل"],[57,"لقد زان البلاد ومن عليها","https://www.aldiwan.net/poem24668.html","الوافر"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"لقد زار الجزيرة منك بحر","https://www.aldiwan.net/poem36484.html","الوافر"],[77,"لقد زالت اللأواء وارتفع الجهد","https://www.aldiwan.net/poem36547.html","الطويل"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[83,"لقد زادني وجدا وأغرى بي الجوى","https://www.aldiwan.net/poem54273.html","الطويل"],[88,"أتى من مصر طلعتها بن حرب","https://www.aldiwan.net/poem44397.html","الوافر"],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[27,"إذا أعرضوا ألفين منها تعرضت","https://www.aldiwan.net/poem4429.html","الطويل"],[47,"أراني وقومي فرقتنا مذاهب","https://www.aldiwan.net/poem25377.html","الطويل"],[72,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[72,"على حركات اليمن والأمن والهنا","https://www.aldiwan.net/poem18726.html","الطويل"],[72,"فديت مؤذنا تصبو إليه","https://www.aldiwan.net/poem19023.html","الوافر"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[70,"بربك أيها العام الجديد","https://www.aldiwan.net/poem43106.html","الوافر"],[85,"أحيث تلوح المنى تأفل","https://www.aldiwan.net/poem62838.html","المتقارب"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[45,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[45,"تريك الذي حدثت عنه من السحر","https://www.aldiwan.net/poem63612.html","الطويل"],[28,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[28,"ألكني إلى راعي الخليفة والذي","https://www.aldiwan.net/poem5167.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"شجا في الحشى ترداده ليس يفتر","https://www.aldiwan.net/poem30502.html","الطويل"],[74,"أما واعتزاز السيف والضيف والندى","https://www.aldiwan.net/poem12964.html","الطويل"],[74,"لقد زار من أهوى على غير موعد","https://www.aldiwan.net/poem13274.html","الطويل"],[33,"لقد طفت سبعا قلت لما قضيتها","https://www.aldiwan.net/poem25744.html","الطويل"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[52,"تبدى فأين الغصن من ذلك الغصن","https://www.aldiwan.net/poem26624.html","الطويل"],[48,"ومستعبد إخوانه بثرائه","https://www.aldiwan.net/poem63397.html","الطويل"],[50,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[50,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[50,"أعاتك بعض الود مر ممزج","https://www.aldiwan.net/poem63986.html","الطويل"],[50,"ألا ما لقلبي لا يزول عن الهوى","https://www.aldiwan.net/poem64833.html","الطويل"],[50,"لقد زادني ما تعلمين صبابة","https://www.aldiwan.net/poem64860.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[100,"صبوة","https://www.poetsgate.com/ViewPoem.aspx?id=50402",""],[50,"أَلاَ مَنْ لِصَبٍّ عَازِبِ النَّوْم سَاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21701",""],[45,"تُرِيكَ الذي حُدّثتَ عَنهُ منَ السِّحْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31341",""],[94,"تعالوا نعدّ الصّيد","https://www.poetsgate.com/ViewPoem.aspx?id=15668",""],[35,"لقد زعمَتْ أنّي تغيَّرتُ بعدها","https://www.poetsgate.com/ViewPoem.aspx?id=22025",""],[39,"نبيتُ تميماً تجتدي حربَ طيِّىء ٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=4266",""],[105,"بربك أيها العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54955&r=&rc=125",""],[100,"صبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67680&r=&rc=167",""],[109,"لقد زارني من بعد حول مودعا","https://www.aldiwan.net/poem16567.html","الطويل"],[137,"وجدت العيش يا سلمى","https://www.aldiwan.net/poem67983.html","مجزوء الوافر"],[160,"أيملك طرفي دمع عينيه قانيا","https://www.aldiwan.net/poem58942.html","الطويل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[169,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[181,"متى الدين يا أم العلاء فقد أنى","https://www.aldiwan.net/poem59081.html","الطويل"],[185,"إذا كان عقبى ما يسوء التصبر","https://www.aldiwan.net/poem14545.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[204,"بدت لوداع والتجمل سترها","https://www.aldiwan.net/poem53273.html","الطويل"],[210,"يا واحد العلياء يا أحمد الورى","https://www.aldiwan.net/poem13421.html","الطويل"],[249,"لو خفت هذا منك يوما لم أنم","https://www.aldiwan.net/poem2091.html","الرجز"],[270,"تحاول إنكارا ودمعك موضح","https://www.aldiwan.net/poem35613.html","الطويل"],[270,"تصباك ما في النجم من لمعات","https://www.aldiwan.net/poem35636.html","الطويل"],[275,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[364,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[377,"كأن دموع النفس في نحرها سلك","https://www.aldiwan.net/poem59304.html","الطويل"],[377,"لك الله من علم إلى الحق رافع","https://www.aldiwan.net/poem59347.html","الطويل"],[393,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[403,"أبرق بدا أم زحزح اليوم برقع","https://www.aldiwan.net/poem33677.html","الطويل"],[403,"دع اللوم إن سالت دموعي على خدي","https://www.aldiwan.net/poem33938.html","الطويل"],[406,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[416,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[416,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[416,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[416,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[416,"تذكر في ربوع الضال عهدا","https://www.aldiwan.net/poem54117.html","الوافر"],[429,"لقد زرت من أهوى وقد زار آخر","https://www.aldiwan.net/poem40254.html","الطويل"],[429,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[437,"سعاد اسعدي بالطيف بعد التفرق","https://www.aldiwan.net/poem2554.html","الطويل"],[439,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[464,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[515,"فدى لبني رزيك قوم رفعتهم","https://www.aldiwan.net/poem12149.html","الطويل"],[516,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem48672.html","الطويل"],[538,"أشمس الغرب حقا ما سمعنا","https://www.aldiwan.net/poem47957.html","عموديه"],[538,"أتاك كما تأتي اللآلئ في العقد","https://www.aldiwan.net/poem48213.html","عموديه"],[587,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["لَقَد زَلَلتُ وَكانَتَ هَفوَةٌ أَمَماً","أَيّامَ أَرجو النَدى الجاري مِنَ اليَبسِ",0,"س",1,0],["لَقَد زَجَرَ المَجدَ حَتّى أَصابَ","بِنا مَطلَعَ النَجمِ لا بَل تَعَدّى",1,"د",2,0],["لقد زارَني والعَتْبُ يَقْصُرُ خَطْوَهُ","وأحْبِبْ بهِ منْ زائِرٍ مُتعتِّبِ",2,"ب",1,0],["لَقَد زانَ البِلادَ وَمَن عَلَيها","إِمامُ المُسلِمينَ أَبو حَنيفَه",3,"ف",2,1],["لَقَدْ زَلْزَلَتْ مِنْكَ الْعَزَائِمُ دَوْلَةً","أَنَاخَتْ عَلَى الإِسْلاَمِ تَجنِي وَتَشْتَطُّ",4,"ط",1,0],["لقدْ زارَ الجَزيرَةَ منْكَ بحْرٌ","يُمِدُّ فليْسَ نَعْرِفُ منْهُ جَزْرا",5,"ر",2,1],["لقدْ زالَتْ اللأواءُ وارْتَفَعَ الجَهْدُ","وأطْنَبَ في شُكْرِ الحَيا الغَوْرُ والنّجْدُ",6,"د",1,1],["لَقَد زادَ هوجو فيهِ خِصبَ قَريحَةٍ","وَآبَ إِلى أَوطانِهِ جِدَّ مُمرِعِ",7,"ع",1,0],["لقد زادني وجداً وأغرى بيَ الجوى","ذُبالٌ بأذيال الظلام قد الْتفَّا",8,"ف",2,1],["لقد زرناكم قبلاً فكنُا","على نشز التجلّة والكرامه",9,"ه",1,0],["لقد زُرت نجداً يا أمين فقل لنا","أتذكر من أخبار نجد جوائبا",10,"ب",2,0],["لَقَد زِدتِ أَهلَ الرِيِّ عِندي مَلاحَةً","وَحَبَّبتِ أَضعافاً إِلَيَّ المَوالِيا",11,"ي",2,0],["لَقَد زِدتُ بِالأَيّامِ وَالناسِ خِبرَةً","وَجَرَّبتُ حَتّى هَذَّبَتني التَجارِبُ",12,"ب",1,0],["لقد زيَّن قلبي المستهام بحبِّه","كما بشهاب الدِّين قد زيّن دهره",13,"ر",2,0],["لقد زادها في الحمد يوسف فاغْتدت","تباع بمرآها القلوب وتشترى",14,"ر",2,0],["لقد زفَّ الزمان به مليحاً","تكاد بأن تعانقه العروس",15,"س",1,0],["لقد زهت العواصم يوم وافى","وأمست عصمة وغدت ثمالا",16,"ل",2,0],["لَقَد زَهدوا الحَياةَ وَأَبغَضوا","وَلَم يَرحَمهُمُ الخَصمُ العَنيدُ",17,"د",1,0],["لَقَد زُدتَ مِن رِقَّةٍ كَالصِراطِ","وَدونَ صَلابَتِكَ الجَندَلُ",18,"ل",1,0],["لَقَد زَيَّنَ الأَرضَ بِالعَبقَرِيِّ","مُحَلّي السَماواتِ بِالكَوكَبِ",19,"ب",1,0],["لَقَد زُلزِلَت أَرضُ الجِبالِ بِوَقعَةٍ","أَسالَت دَماً في كُلِّ نَشزٍ وَأَبطَحِ",20,"ح",1,0],["لَقَد زَلزَلَ الشامَ العَريضَةَ ذِكرُهُ","وَأَقلَقَ صُكّانَ الجَزيرَةِ بِالذُعرِ",21,"ر",1,0],["لَقَد زادَني وُدّاً لِبَكرِ بنِ وائِلٍ","إِلى وُدَّها الماضي وَحُسنِ ثَنائِها",22,"ا",3,0],["لَقَد زَعَموا أَنّي هَجَوتُ لِخالِدٍ","لَهُ كُلَّ نَهرٍ لِلمُبارَكِ أَكدَرا",23,"ر",2,0],["لَقَد زارَت بُيوتَ بَني عُلَيمٍ","مِنَ الكَلِماتِ آنِيَةٌ مِلاءُ",24,"ا",2,0],["لَقَد زِدتَ أَوضاحي اِمتِداداً وَلَم أَكُن","بَهيماً وَلا أَرضى مِنَ الأَرضِ مَجهَلا",25,"ل",2,0],["لَقَد زينَتِ الدُنيا بِأَيّامِ ماجِدٍ","بِهِ المُلكُ يَبهى وَالمَفاخِرُ تَفخَرُ",26,"ر",1,0],["لَقَد زَفَّ بِنتاً لِلخَميلَةِ طَلقَةً","يَهُزُّ إِلَيها الدَستُ أَعطافَ مَغرِسِ",27,"س",1,0],["لَقَد زارَ مَن أَهوى عَلى غَيرِ مَوعِدٍ","فَعايَنتُ بَدرَ التَمِّ ذاكَ التَلاقِيا",28,"ق",3,1],["لَقَد زادَني الحُجّاجُ شَوقاً إِلَيكُمُ","وَقَد كُنتُ قَبلَ اليَومِ لِلحَجِّ قالِيا",29,"ي",2,0],["لَقَد زادَني حُبّاً لِنَفسي أَنَّني","بَغيضٌ إِلى كُلِّ اِمرِئٍ غَيرِ طائِلِ",30,"ل",1,0],["لَقَد زَفَّها في حَليِها رَأيُ قاسِمٍ","إِلى مَلِكٍ كَالبَدرِ مُقتَبِلِ السِنِّ",31,"ن",1,0],["لَقَد زادَني تيهاً عَلى الناسِ أَنَّني","أَرانِيَ أَغناهُم وَإِن كُنتُ ذا فَقرِ",32,"ر",1,0],["لَقَد زادَني شَوقاً خَيالٌ يَزورُني","وَصَوتُ غِناءٍ مِن نَديمٍ مُغَرِّدِ",33,"د",1,0],["لَقَد زادَني وَجداً بِكُم وَصَبابَةً","إِشارَةُ أَقوامٍ أَكُفَّ السَواعِدِ",34,"د",1,0],["لَقَد زَيَّنَ الإِسلامَ مُلكُ مُحَمَّدٍ","وَفي الحَربِ لِلأَعداءِ نارٌ تَأَجَّجُ",35,"ج",1,0],["لَقَد زادَ أَشرافَ العِراقِ اِبنُ حاتِمٍ","كَما سادَ أَهلَ المَشرِقَينِ المُهَلَّبُ",36,"ب",1,0],["لَقَد زادَني ما تَعلَمينَ صَبابَةً","إِلَيكِ فَلِلقَلبِ الحَزينِ وَجيبُ",37,"ب",1,1],["لقد زارني طَيْفُ الخَيالِ فَهاجَني","فهل زارَ هذي الإبلَ طَيْفُ خَيال",38,"ل",1,0],["لقد زُهيت مصر بباعثِ شعبِها","لكسب المعَالي واقتناءِ الرغائبِ",39,"ب",1,0],["لقد زُرْنا حِماك ونحن نَدْري","لعمرُك أنْ زَوْرتَك انتحار",40,"ر",1,0],["لقد زرعت الحب لكنني","ما ذقت إلاحنضل المزرعة",41,"ع",2,0],["لقد زادني وجداً لكم وصبابة","ً إشارة أقوام أكف السواعد",42,"د",1,0],["لَقَدْ زَلزَلَ الشّامَ العَرِيضَةَ ذِكرُهُ،","وَأقْلَقَ سُكّانَ الجَزِيرَةِ بالذّعرِ",43,"ر",1,0],["لقد زعموا أني بجلّق هائم","أجل والهوى إنّي بجلّق هائم",44,"م",1,0],["لقد زعمَتْ أنّي تغيَّرتُ بعدها","ومَنْ ذا الذي يا عزَّ لا يتغيَّرُ",45,"ر",1,1],["لقدْ زادني حبّاً لنفسيَ أنَّني","بِغِيضٌ إِلَى كُلِّ امْرِىء ٍ غَيْرِ طائِلِ",46,"ل",1,0],["لقد زهدوا الحياة وأبغضوها","ولم يرحمهم الخصم العنيد",47,"د",1,0],["لقد زرعت الحب … لكني","ما ذقت إلاّ حنظل المزرعه",48,"ع",2,0],["لقَد زارَني مِن بَعد حَول مُودِعاً","وَطَوق الدُجا قَد صارَ في قَبضة الفَجر",49,"ر",1,1],["لَقَد زُرتُكِ يا سَلمى","عَلى خَوفٍ وَإيجاسِ",50,"س",1,0],["لقد زارني مشياً على بعد داره","فكيف تراني كنت لو كان جارياً",51,"ي",2,0],["لقد زين الشيطان أعمالهم لهم","بوسوسهم في العقل ما ليس يحسب",52,"ب",1,0],["لَقَد زَهَت خُطَطُ البَحرَينِ وَاِفتَخَرَت","بِهِ عَلى مَأرِبٍ في الأَعصُرِ القِدَمِ",53,"م",1,0],["لقد زَعَم الواشونَ أَنِّى صَرَمتُهَا","وكلُّ الذى عدُّوا مَقالةُ كاذبِ",54,"ب",1,0],["لقد زَعْزعتْ شُمَّ الجبال رزيةٌ","أَلمَّتْ ولكنْ طودُ حلمِك أَوْقَر",55,"ر",1,0],["لَقَد زَعَموا إِصلاحهُ بفسادِهم","وَكَم حمّلوهُ مِن ضَلالاتِهم إِصرا",56,"ر",2,0],["لقد زال طيبُ العيش عنّي لفقدها","كما زال عنها للتفجُّع كِبرُها",57,"ر",3,0],["لقد زاد قلبي بالوعود تعللا","ولا مسعف في الدهر لي ومساعد",58,"د",1,0],["لَقَد زَجَرتُ الطَيرَ زَجراً لَم أُلِم","تَقولُ قَولاً غَيرَ أَقوالِ الحُلُم",59,"م",1,0],["لقد زالَ ذياكَ النَّعيمُ ولم أزَل","أرى الحسنَ يَفنى والحبيبةَ تَنزَح",60,"ح",1,0],["لقد زرتُ فيها جامعاً صارَ بيعة","جَثت أُمهَّاتٌ فيهِ مع أخوات",61,"ت",1,0],["لقَد زُرْتَ أرض الشّركِ وهيَ مَعالِم","فَقَوَّض عَنْها الجَيْشُ وهيَ مَحَامِلُ",62,"ل",1,0],["لَقد زهِيَت منها بغرّة عزّةٍ","نواصٍ لِغيرِ الصادقِ العزمِ لا تُعطى",63,"ط",2,0],["لقد زَيَّنْتَ عَصْركَ بالمعالي","كما زَيّنْتَ شِعريَ بالمعاني",64,"ي",1,0],["لقد زال ما أهواه مذ زُلْتُ قبله","وأعلمني موتي به أنه إفك",65,"ك",1,0],["لقد زانت الأعمالُ منكم علومَكم","كما زُيِّنَ الخدُّ الأسيل بشافع",66,"ع",1,0],["لَقَد زَعَموا ما لَيسَ يَعدوهُ مُشرِك","وَقد أَثبَتوا ما لَيسَ يَخطوهُ ملحِدُ",67,"د",1,0],["لقد زادني حباً لكم وصل غيركم","خلاف الذي كنا له نتوقع",68,"ع",1,0],["لقد زدت فخراً فوق فخر حويته","قديماً بيحياك العماد وبالمهدي",69,"د",2,0],["لَقَد زدتَ هَذا الدَهر حُسناً وَهيبَةً","كَأَنَّكَ في صَدرِ الزَمانِ نِجادُ",70,"د",1,0],["لقد زالت الشّمُّ الرَّواسي فلم نبلّ","إذا زلزلتْ بعد الجبال الرَّواسيا",71,"ي",2,0],["لقد زرع المعروف في كل موطنٍ","وزارعه للحمد والشكر حاصد",72,"د",1,0],["لقد زُرْتَ مَنْ لو شكَّ أنْ لا تَزورَهُ","رأى عزَّه الموجودَ أضغاثَ حالم",73,"م",1,0],["لقد زهتْ بك دار العلم حيث غدت","داراً تفاخر في سكَّانها دورا",74,"ر",2,0],["لقد زرع الجميل لكل قلب","فكلٌّ فاه في علياه حمدا",75,"د",2,0],["لقد زرت من أهوى وقد زار آخر","به مهجتي مفتونة وأنا حبّ",76,"ب",1,1],["لقد زانت محامدهُ","قوافي النثر والشعرِ",77,"ر",1,0],["لقد زلزلت أرض الأعادي جياده","وراح الكماة بين مردى ومصعق",78,"ق",1,0],["لقد زَجَرَ الهُدى يومَ استطارا","إِلَى الأَعداءِ أَيْمَنَ سانِحَيْنِ",79,"ن",1,0],["لقد زار ليلاً بالنجوم مقلداً","خيالٌ بأثواب الظلامٍ موشحُ",80,"ح",1,0],["لَقَد زَهِدْنا فَيا أحشاءَنا انخَسِفي","حَدَّ الظهورِ، وَيا أشباحَ ماضينا",81,"ن",2,0],["لقد زادَتِ الأيّامُ فيكَ مسرّةً","وفاقَ على وجهِ العُلا رونقُ البِشْرِ",82,"ر",1,0],["لقد زهدتني في رجال صلاتكم","ومن شام نور الشمس لم يحمد الفجرا",83,"ر",2,0],["لَقَد زادَني لِلغَمرِ حُبّا وَاهلِهِ","لَيال اِقامَتهُن لَيلى عَلى الغَمر",84,"ر",1,0],["لقد زَلزَلتَ مِنا كلَّ رُكنٍ","بحَقِّ اللهِ لا تُقِمِ القِيامَه",85,"م",2,0],["لَقد زُرتمونَا والرَّوابِطُ جَمَّةٌ","وجئتم كمَا جاءَ النَّسيمُ مِن الوَرد",86,"د",1,0],["لقد زادت البلوى اضطراماً وحرقة","فحق لنا إهراق دمع المآقيا",87,"ي",2,0]]}