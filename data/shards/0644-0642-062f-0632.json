.poetsgate.com/ViewPoem.aspx?id=59823",""],[4691,"لقد زارها شعري براحلة الجوى !!","https://www.poetsgate.com/ViewPoem.aspx?id=60592",""],[416,"كفى لكَ فخراً أنَّ أكرمَ حرة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22339",""],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[4884,"لقاضٍ مهاب","https://www.poetsgate.com/ViewPoem.aspx?id=212244",""],[3591,"أيا ميةً في الحسن صيتك أعجبا","https://www.poetsgate.com/ViewPoem.aspx?id=149387",""],[5143,"لَقَدَ زَعَمُوا أني سَكِرْتُ ورُبَّما","https://www.poetsgate.com/ViewPoem.aspx?id=186630",""],[5183,"تحية الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180205",""],[5216,"قناة السويس","https://www.poetsgate.com/ViewPoem.aspx?id=187002",""],[5284,"مُرَادُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[5431,"كربُ الشام","https://www.poetsgate.com/ViewPoem.aspx?id=183134",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[243,"رثاء القطيع","https://www.poetsgate.com/ViewPoem.aspx?id=50482",""],[5804,"الجليس السيّء","https://www.poetsgate.com/ViewPoem.aspx?id=180100",""],[5956,"لقد زارنا الحظُّ في ذات يوم","https://www.poetsgate.com/ViewPoem.aspx?id=193869",""],[5957,"أمد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=204477",""]],"verses":[["لَقَد زَلَلتُ وَكانَتَ هَفوَةٌ أَمَماً","أَيّامَ أَرجو النَدى الجاري مِنَ اليَبسِ",0,"س",1,0],["لَقَد زَجَرَ المَجدَ حَتّى أَصابَ","بِنا مَطلَعَ النَجمِ لا بَل تَعَدّى",1,"د",2,0],["لقد زارَني والعَتْبُ يَقْصُرُ خَطْوَهُ","وأحْبِبْ بهِ منْ زائِرٍ مُتعتِّبِ",2,"ب",1,0],["لَقَد زانَ البِلادَ وَمَن عَلَيها","إِمامُ المُسلِمينَ أَبو حَنيفَه",3,"ف",2,1],["لَقَدْ زَلْزَلَتْ مِنْكَ الْعَزَائِمُ دَوْلَةً","أَنَاخَتْ عَلَى الإِسْلاَمِ تَجنِي وَتَشْتَطُّ",4,"ط",1,0],["لقدْ زارَ الجَزيرَةَ منْكَ بحْرٌ","يُمِدُّ فليْسَ نَعْرِفُ منْهُ جَزْرا",5,"ر",2,1],["لقدْ زالَتْ اللأواءُ وارْتَفَعَ الجَهْدُ","وأطْنَبَ في شُكْرِ الحَيا الغَوْرُ والنّجْدُ",6,"د",1,1],["لَقَد زادَ هوجو فيهِ خِصبَ قَريحَةٍ","وَآبَ إِلى أَوطانِهِ جِدَّ مُمرِعِ",7,"ع",1,0],["لقد زادني وجداً وأغرى بيَ الجوى","ذُبالٌ بأذيال الظلام قد الْتفَّا",8,"ف",2,1],["لقد زرناكم قبلاً فكنُا","على نشز التجلّة والكرامه",9,"ه",1,0],["لقد زُرت نجداً يا أمين فقل لنا","أتذكر من أخبار نجد جوائبا",10,"ب",2,0],["لَقَد زِدتِ أَهلَ الرِيِّ عِندي مَلاحَةً","وَحَبَّبتِ أَضعافاً إِلَيَّ المَوالِيا",11,"ي",2,0],["لَقَد زِدتُ بِالأَيّامِ وَالناسِ خِبرَةً","وَجَرَّبتُ حَتّى هَذَّبَتني التَجارِبُ",12,"ب",1,0],["لقد زيَّن قلبي المستهام بحبِّه","كما بشهاب الدِّين قد زيّن دهره",13,"ر",2,0],["لقد زادها في الحمد يوسف فاغْتدت","تباع بمرآها القلوب وتشترى",14,"ر",2,0],["لقد زفَّ الزمان به مليحاً","تكاد بأن تعانقه العروس",15,"س",1,0],["لقد زهت العواصم يوم وافى","وأمست عصمة وغدت ثمالا",16,"ل",2,0],["لَقَد زَهدوا الحَياةَ وَأَبغَضوا","وَلَم يَرحَمهُمُ الخَصمُ العَنيدُ",17,"د",1,0],["لَقَد زُدتَ مِن رِقَّةٍ كَالصِراطِ","وَدونَ صَلابَتِكَ الجَندَلُ",18,"ل",1,0],["لَقَد زَيَّنَ الأَرضَ بِالعَبقَرِيِّ","مُحَلّي السَماواتِ بِالكَوكَبِ",19,"ب",1,0],["لَقَد زُلزِلَت أَرضُ الجِبالِ بِوَقعَةٍ","أَسالَت دَماً في كُلِّ نَشزٍ وَأَبطَحِ",20,"ح",1,0],["لَقَد زَلزَلَ الشامَ العَريضَةَ ذِكرُهُ","وَأَقلَقَ صُكّانَ الجَزيرَةِ بِالذُعرِ",21,"ر",1,0],["لَقَد زادَني وُدّاً لِبَكرِ بنِ وائِلٍ","إِلى وُدَّها الماضي وَحُسنِ ثَنائِها",22,"ا",3,0],["لَقَد زَعَموا أَنّي هَجَوتُ لِخالِدٍ","لَهُ كُلَّ نَهرٍ لِلمُبارَكِ أَكدَرا",23,"ر",2,0],["لَقَد زارَت بُيوتَ بَني عُلَيمٍ","مِنَ الكَلِماتِ آنِيَةٌ مِلاءُ",24,"ا",2,0],["لَقَد زِدتَ أَوضاحي اِمتِداداً وَلَم أَكُن","بَهيماً وَلا أَرضى مِنَ الأَرضِ مَجهَلا",25,"ل",2,0],["لَقَد زينَتِ الدُنيا بِأَيّامِ ماجِدٍ","بِهِ المُلكُ يَبهى وَالمَفاخِرُ تَفخَرُ",26,"ر",1,0],["لَقَد زَفَّ بِنتاً لِلخَميلَةِ طَلقَةً","يَهُزُّ إِلَيها الدَستُ أَعطافَ مَغرِسِ",27,"س",1,0],["لَقَد زارَ مَن أَهوى عَلى غَيرِ مَوعِدٍ","فَعايَنتُ بَدرَ التَمِّ ذاكَ التَلاقِيا",28,"ق",3,1],["لَقَد زادَني الحُجّاجُ شَوقاً إِلَيكُمُ","وَقَد كُنتُ قَبلَ اليَومِ لِلحَجِّ قالِيا",29,"ي",2,0],["لَقَد زادَني حُبّاً لِنَفسي أَنَّني","بَغيضٌ إِلى كُلِّ اِمرِئٍ غَيرِ طائِلِ",30,"ل",1,0],["لَقَد زَفَّها في حَليِها رَأيُ قاسِمٍ","إِلى مَلِكٍ كَالبَدرِ مُقتَبِلِ السِنِّ",31,"ن",1,0],["لَقَد زادَني تيهاً عَلى الناسِ أَنَّني","أَرانِيَ أَغناهُم وَإِن كُنتُ ذا فَقرِ",32,"ر",1,0],["لَقَد زادَني شَوقاً خَيالٌ يَزورُني","وَصَوتُ غِناءٍ مِن نَديمٍ مُغَرِّدِ",33,"د",1,0],["لَقَد زادَني وَجداً بِكُم وَصَبابَةً","إِشارَةُ أَقوامٍ أَكُفَّ السَواعِدِ",34,"د",1,0],["لَقَد زَيَّنَ الإِسلامَ مُلكُ مُحَمَّدٍ","وَفي الحَربِ لِلأَعداءِ نارٌ تَأَجَّجُ",35,"ج",1,0],["لَقَد زادَ أَشرافَ العِراقِ اِبنُ حاتِمٍ","كَما سادَ أَهلَ المَشرِقَينِ المُهَلَّبُ",36,"ب",1,0],["لَقَد زادَني ما تَعلَمينَ صَبابَةً","إِلَيكِ فَلِلقَلبِ الحَزينِ وَجيبُ",37,"ب",1,1],["لقد زارني طَيْفُ الخَيالِ فَهاجَني","فهل زارَ هذي الإبلَ طَيْفُ خَيال",38,"ل",1,0],["لقد زُهيت مصر بباعثِ شعبِها","لكسب المعَالي واقتناءِ الرغائبِ",39,"ب",1,0],["لقد زُرْنا حِماك ونحن نَدْري","لعمرُك أنْ زَوْرتَك انتحار",40,"ر",1,0],["لقد زهدت نفسه في الوجو","د فهل للحياة معا زاهدة",41,"د",2,0],["لقد زرعت الحب لكنني","ما ذقت إلاحنضل المزرعة",42,"ع",2,0],["لقد زادني وجداً لكم وصبابة","ً إشارة أقوام أكف السواعد",43,"د",1,0],["لَقَدْ زَلزَلَ الشّامَ العَرِيضَةَ ذِكرُهُ،","وَأقْلَقَ سُكّانَ الجَزِيرَةِ بالذّعرِ",44,"ر",1,0],["لقد زعموا أني بجلّق هائم","أجل والهوى إنّي بجلّق هائم",45,"م",1,0],["لقد زعمَتْ أنّي تغيَّرتُ بعدها","ومَنْ ذا الذي يا عزَّ لا يتغيَّرُ",46,"ر",1,1],["لقدْ زادني حبّاً لنفسيَ أنَّني","بِغِيضٌ إِلَى كُلِّ امْرِىء ٍ غَيْرِ طائِلِ",47,"ل",1,0],["لقد زهدوا الحياة وأبغضوها","ولم يرحمهم الخصم العنيد",48,"د",1,0],["لقد زرعت الحب … لكني","ما ذقت إلاّ حنظل المزرعه",49,"ع",2,0],["لقَد زارَني مِن بَعد حَول مُودِعاً","وَطَوق الدُجا قَد صارَ في قَبضة الفَجر",50,"ر",1,1],["لَقَد زُرتُكِ يا سَلمى","عَلى خ