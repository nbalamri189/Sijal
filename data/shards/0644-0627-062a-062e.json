udhabi.ae/diwan/poem/54243","الرمل"],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[106,"الكادر","https://www.poetsgate.com/ViewPoem.aspx?id=179520",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[50,"يا مالكَ النَّاسِ في مسيرهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=16881",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[45,"إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[45,"كم من أخ لك لست تنكره","https://www.poetsgate.com/ViewPoem.aspx?id=31244",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[105,"إملإِ الأرضَ يا مُحمّدُ نُورا","https://diwany.org/%D8%A5%D9%85%D9%84%D8%A5%D9%90-%D8%A7%D9%84%D8%A3%D8%B1%D8%B6%D9%8E-%D9%8A%D8%A7-%D9%85%D9%8F%D8%AD%D9%85%D9%91%D8%AF%D9%8F-%D9%86%D9%8F%D9%88%D8%B1%D8%A7/%D8%A3%D8%AD%D9%85%D8%AF-%D9%85%D8%AD%D8%B1%D9%85/","الخفيف"],[10,"لا تَخَلْ أنّني لقيتُ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10487&r=&rc=12",""]],"verses":[["لا تَخلُدَنَّ إِلى أَرضِ تَهونُ بِها","بِالدارِ دارٌ وَبِالجيرانِ جيرانُ",0,"ن",1,0],["لا تَخدَعَن عَنهُ فَرُبَّ ضَريبَةٍ","يَنبو الحُسامُ بِها وَيَمضي الدِرهَمُ",1,"م",1,0],["لا تُخدَعَنَّ عَلى رُقاهُ وَلَو","أَرضاكَ مِنهُ القَولُ وَالعَمَلُ",2,"ل",1,0],["لا تُخدَعَنَّ فَما عُقوبَةُ قادِرٍ","إِلّا بِأَحسَنَ مِن تَجاوُزِ قادِرِ",3,"ر",1,0],["لا تُخْلِدَنَّ إِلى الصّديقِ فإنّهُ","بِكَ مِنْ عَدوِّكَ في المَضَرَّةِ أعْلَمُ",4,"م",1,0],["لا تَخَلنا عَلى غَرائِكَ إِنّا","قَبلُ ما قَد وَشى بِنا الأَعداءُ",5,"ا",2,0],["لا تُخْدَعَنّ بزينَةٍ منْ زُخْرُفٍ","عمّا قَليلٍ يُسْتردُّ مُعارُهُ",6,"ر",2,0],["لا تُخْدَعَنّ فإنّني إنْسيّةٌ","والحُسْنُ يلعَبُ بالنُّهى غَرّارُهُ",7,"ر",2,0],["لا تَخَف عَثرَةَ الزَمانِ عَلَيهِم","لا وَلا صَولَةَ اللَيالي العَواتي",8,"ي",1,0],["لا تَخَف مِن وَحشَةِ القَبرِ وَلا","تَبتَئِس إِنّي مُوافٍ عَن قَريبِ",9,"ب",1,0],["لا تَخافوا أَذاهُ فَالشَيخُ هاوٍ","لَيسَ فيهِ بَقِيَّةٌ لِلصُعودِ",10,"د",1,0],["لا تَخشَ جائِزَةً قَد جِئتُ أَطلُبُها","إِنّي شَريفٌ وَلِلأَشرافِ أَحسابُ",11,"ب",1,0],["لا تَخشَ طالِعَ سوءٍ","فَكَوكَبُ الشَرقِ سَعدُ",12,"د",1,0],["لا تَخدَعَنَّكَ مِن مَودودَ دَولَتُهُ","وَإِن تَعَلَّقتَ مِن أَسبابِها سَبَبا",13,"ب",2,0],["لا تَخَلني مِمَّن يُجاريكَ في اللُغ","زِ وَقَد فَرَّ مِنكَ كُلُّ مُجاري",14,"ي",1,0],["لا تَخشَ في حَقّي بِما أَمضَيتَهُ","مِن ذاكَ فِيَّ وَلا تَوَقَّ عِتابي",15,"ي",1,0],["لا تَخَل أَنَّني لَقيتُ رَواحا","بَعدَ صَخرٍ حَتّى أَثَبنَ نُواحا",16,"ح",2,1],["لا تَخَلني أَنّي نَسيتُ وَلا بُل","لَ فُؤادي وَلَو شَرِبتُ القَراحا",16,"ح",2,0],["لا تَخذُلاني فَإِنّي غَيرُ ناسِيَةٍ","لِذِكرِ صَخرٍ حَليفِ المَجدِ وَالخَيرِ",17,"ر",1,0],["لا تَخذُليني عِندَ جَدِّ البُكا","فَلَيسَ ذا ياعَينِ وَقتَ الخَذول",18,"ل",1,0],["لا تَخطُبُنَّ إِلى عَدِيٍّ إِنَّكُم","شَرُّ الفُحولِ وَأَلأَمُ الخُطّابِ",19,"ب",1,0],["لا تخلف الوعد إن وعدت ولا","خلفك للراغبين منقلب",20,"ب",1,0],["لا تَخَطّى إِلى المَظالِمِ كَفّي","حَذَراً مِن أَصابِعِ الأَيتامِ",21,"م",1,0],["لا تخدعنَّ بشهدِ العيش ترشفه","فأيُّ سمٍّ ثوى في ذلك الشهدِ",22,"د",1,0],["لا تخش من غمِّ كغيم عارض","فلسوفَ يسفر عن إضاءة بدرِه",23,"ر",2,1],["لا تخف عيلة ولا تخشَ فقراً","يا كثير المحاسن المختاله",24,"ه",1,1],["لا تخش من عاذلٍ قد جا يحاورني","يا سالبي في الهوى حلمي وأحلامي",25,"م",2,0],["لا تخف نبوة الحوادث فالله","كريمٌ يحب كل كريم",26,"م",1,0],["لا تخشَ بيتكَ أن يلوِي الزمان بهِ","فإنَّ للبيتِ ربًّا سوفَ يحميه",27,"ي",2,0],["لا تُخطئَنّي منك في موقفي","سماءُ معروف توكّفْتُها",28,"ت",3,0],["لا تُخْطِئنَّ أبا عليٍّ إنه","بابُ الغنى وسؤاله مفْتاحُه",29,"ح",2,0],["لا تَخش من لا يقتنيك الأسى","ولا تخف من يقتنيك الحسدْ",30,"د",1,1],["لا تُخادعْ بلون خِطْرِك ظَبْياً","فهو أقْذى للظبي من تَسْهادِهْ",31,"د",2,0],["لا تخْلُ عن أمثاله حُفْرةٌ","ولا تَقُمْ عن مثله والدهْ",32,"د",2,0],["لا تُخطِئُ الرأي المُوَفْ","فَق حين تُسدي أو تُنيرُ",33,"ر",1,0],["لا تَخش من بدئه قَطْعاً لعودته","فإن إقدامه إقدام كرّار",34,"ر",1,0],["لا تخف أن تُبَزَّ سربالَ خزيٍ","أنت فيه فلستَ بالمبزوز",35,"ز",1,0],["لا تخطىء المكنونَ وهي حادسه","يا لكِ نفساً ما لها مجانسَه",36,"س",2,0],["لا تخفْ مأثماً بشتمك إيّا","ه ولو جِئت غاية الإفحاش",37,"ش",1,0],["لا تخلطنَّ حلاوةً بمرارةٍ","إن المخلِّط في الإخاء منغّصُ",38,"ص",1,0],["لا تخادع في متاع زائل","فكأن قد طار منه ما وقع",39,"ع",1,0],["لا تُخْجِلنِّي بالردّ حسْبُك ما","ترى بخدي من حُمرةِ الخجلِ",40,"ل",1,0],["لا تَخْلونَ بشاغلٍ","حتى تُعِدَّ لها قوابلْ",41,"ل",1,0],["لا تَخف بخلَه وبادِر نَداه","فهو للفال أغولُ الأغوالِ",42,"ل",1,0],["لا تَخَلْ أوجَبَ الحقوق على المر","ء حقوقاً قضى بها الحُكَّامُ",43,"م",1,0],["لا تخلني قرعتُ سِنّاً بظُفْرٍ","من ندام عليك أو تنديم",44,"م",1,0],["لا تخافُوا وأيقنوا أيها القو","م بِبَيْعِي خسيسَكُمْ بِثَمينه",45,"ن",2,0],["لا تخلط الحبَّ بالتقوى فتعطفَنا","على المُقاسي عذابَ الهجر والبين",46,"ن",1,0],["لا تُخادَع فإنما يومُ نُعْمٍ","يومُ نُعْم الأمير لا النعمان",47,"ن",1,0],["لا تَخدَعَنَّكُمُ السِياسَةُ إِنَّها","شَتّى الوُجوهِ كَثيرَةُ الأَلوانِ",48,"ن",1,0],["لا تَخَف إِثماً وَلا حَرَجاً","فَدَمُ العُشّاقِ مَطلولُ",49,"ل",1,0],["لا تخف من نكث له واتبعني","فاتباعي بالشيخ أولى وأجمل",50,"ل",1,0],["لا تخشين من ابد","سوف يلاقي ازلك",51,"ك",1,0],["لا تخافي علي فالموت سهل","لا كما ينعتونه بشديد",52,"د",1,0],["لا تخافي فالموت ليس على الار","ض ولا في سمائها بجديد",52,"د",1,0],["لا تخافي هلكا من الضرب فيها","انت روح والروح ليس بمود",52,"د",1,0],["لا تخري وان قضى ان تخري","سبب قاهر من الاسباب",53,"ب",1,0],["لا تَخَف بَعدَكَ حُزناً أَو بُكاً","جَمَدَت مِنّي وَمِنكَ اليَومَ عَين",54,"ن",1,0],["لا تَخشَ مِمّا أَلحَقوا بِكِتابِهِ","يَبقى الكِتابُ وَلَيسَ يَبقى المُلحَقُ",55,"ق",1,0],["لا تَخرُجُ النَعماءُ مِن","هُ وَلا يُزايِلهُ اليَسار",56,"ر",1,0],["لا تَخلُ مِن أَمَلٍ إِذا","ذَهَب الزَمانُ فَكَم رَجَع",57,"ع",1,0],["لا تُخْدَعَنْ عنه فبائعُ ساعةٍ","منهُ بدنيانا جميعاً يخسرُ",58,"ر",1,0],["لا تَخَف عَيلَتي وَتِلكَ القَوافي","بَيتُ مالٍ ما إِن أَخافُ ذَهابَه",59,"ب",2,0],["لا تَخيبُ البِلادُ تَخطِرُ فيها","رُسُلُ الشَوقِ مِن خَيالاتِ سُعدى",60,"د",2,0],["لا تَخلُ مِن عَيشٍ يَكُرُّ سُرورُهُ","أَبَداً وَنَيروزٍ عَلَيكَ مُعادِ",61,"د",1,0],["لا تُخَوِّفنيَ الزَمانَ وَما يَأ","تي بِهِ مِن صُروفِ هَذي الدُهورِ",62,"ر",1,0],["لا تَخلِطَنَّهُم بِغَبرِهِم","مَن يَخلُطُ العِقيانَ بِالصُفرِ",63,"ر",1,0],["لا تَخطُبي دَمعي إِلَيَّ فَلَم يَدَع","في مُقلَتَيَّ جَوى الفِراقِ دُموعا",64,"ع",2,0],["لا تَخلُوَنَّ أَبا العَبّاسِ مِن نِعَمٍ","مَوصولَةٍ أَبَدَ الدُنيا وَإِنعامِ",65,"م",1,0],["لا تُخلَعُ العُذْرُ عنها عندَ أَوْبَتِها","ولا تُنَفَّسُ عن أَوساطِها الحُزُمُ",66,"م",1,0],["لا تخلُ مني راحتاهُ لدى الوغى","أَرْمِ العدا بشهابِ قَدْحٍ مضرم",67,"م",1,0],["لا تَخضَعَنَّ لِمَخلوقٍ عَلى طَمَعٍ","فَإِنَّ ذَلِكَ وَهنٌ مِنكَ في الدينِ",68,"ن",1,1],["لا تَخلُطَن ما يَقبَلُ اللَهُ مِن","فِعلٍ بِقَولٍ مِنكَ لا يَقبَلُ",69,"ل",1,0],["لا تَخضَعَنَّ لِمَخلوقٍ عَلى طَمَعٍ","فَإِنَّ ذاكَ مُضِرٌّ مِنكَ بِالدينِ",70,"ن",1,1],["لا تَخشَ يا اِبنَ الكِرامِ مِن زَمَنٍ","أَمَرتَهُ بِالصَلاحِ فَاِمتَثَلا",71,"ل",2,0],["لا تَخَف مَع رَجاءِ رَبِّكَ ذَنباً","إِنَّهُ يَغفِرُ الذُنوبَ جَميعا",72,"ع",2,0],["لا تَخزُنوا المالَ لِقَصدِ الغِنى","وَتَطلُبوا اليُسرى بِعُسراكُم",73,"م",1,1],["لا تَخشَ مِن رَدِّ الجَوا","بِ وَقَد بَدَأتُكَ بِالكِتابِ",74,"ب",1,1],["لا تَخَف إِن أَضاعَتِ المالَ كَفّا","كَ فَفيهِنَّ لِلعَلاءِ اِتِّفاقُ",75,"ق",1,0],["لا تَخشَ يارَبعَ الحَبيبِ هُمودا","فَلَقَد أَخَذتَ عَلى العِهادِ عُهودا",76,"د",2,1],["لا تخشَ من كيد عدوّ الهدى","إنّ عليّاً لَعَلَيْهِ مُعَان",77,"ن",1,0],["لا تُخْرِجِ الشيءَ عن شيءٍ يوافقهُ","واقصدْ بأمركَ في التدبير مَقْصِدَهُ",78,"ه",1,1],["لا تُخلِقَن خُلُقي فيهِم وَقَد سَطَعَت","ناري وَجَدَّدَ مِن حالي الجَديدانِ",79,"ن",1,0],["لا تَخْشَ بُؤْسَاً مِنْ عَدُوٍّ ظَاهِرٍ","وَاخْشَ الْمَكِيدَةَ مِنْ عَدوٍّ بَاطِنِ",80,"ن",1,1],["لا تخضْ في سبِّ ساداتٍ مضَوا","إنهمْ ليسوا بأهلٍ للزللْ",81,"ل",1,0],["لا تُخْلِني مِنْ لحظاتٍ فلي","أعداءُ سوءٍ يكرهون ا