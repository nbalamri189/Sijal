أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[513,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[513,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[534,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[536,"كل هذا خوف فقر ولقد","https://www.aldiwan.net/poem48196.html","عموديه"],[536,"آه إذ تعلو على متن جوا","https://www.aldiwan.net/poem48197.html","عموديه"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[549,"لا تخش من غائلة فوضت","https://www.aldiwan.net/poem47195.html","السريع"],[549,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[549,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[549,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[549,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[556,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[556,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[558,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[560,"ذهب الحبيب فيا حشاشة ذوبي","https://www.aldiwan.net/poem52735.html","الكامل"],[560,"جاد الزمان بنعمة متصدقا","https://www.aldiwan.net/poem52797.html","الكامل"],[560,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[565,"أما ترى مصر كيف قد جمعت","https://www.aldiwan.net/poem69634.html","المنسرح"],[573,"يا عاطل الجيد إلا من محاسنه","https://www.aldiwan.net/poem2854.html","البسيط"],[573,"يا ساقي الراح بل يا ساقي الفرح","https://www.aldiwan.net/poem2974.html","البسيط"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[584,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"],[584,"أهلا بوجهك لا حجبت عن نظري","https://www.aldiwan.net/poem17534.html","البسيط"],[584,"يا من بفؤادي نار وجدي غادر","https://www.aldiwan.net/poem17550.html","الدوبيت"],[584,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem17611.html","الكامل"],[584,"حتى متى أنا صابر يا هاجر","https://www.aldiwan.net/poem17991.html","الكامل"]],"verses":[["لا تَخلُدَنَّ إِلى أَرضِ تَهونُ بِها","بِالدارِ دارٌ وَبِالجيرانِ جيرانُ",0,"ن",1,0],["لا تَخدَعَن عَنهُ فَرُبَّ ضَريبَةٍ","يَنبو الحُسامُ بِها وَيَمضي الدِرهَمُ",1,"م",1,0],["لا تُخدَعَنَّ عَلى رُقاهُ وَلَو","أَرضاكَ مِنهُ القَولُ وَالعَمَلُ",2,"ل",1,0],["لا تُخدَعَنَّ فَما عُقوبَةُ قادِرٍ","إِلّا بِأَحسَنَ مِن تَجاوُزِ قادِرِ",3,"ر",1,0],["لا تُخْلِدَنَّ إِلى الصّديقِ فإنّهُ","بِكَ مِنْ عَدوِّكَ في المَضَرَّةِ أعْلَمُ",4,"م",1,0],["لا تَخَلنا عَلى غَرائِكَ إِنّا","قَبلُ ما قَد وَشى بِنا الأَعداءُ",5,"ا",2,0],["لا تُخْدَعَنّ بزينَةٍ منْ زُخْرُفٍ","عمّا قَليلٍ يُسْتردُّ مُعارُهُ",6,"ر",2,0],["لا تُخْدَعَنّ فإنّني إنْسيّةٌ","والحُسْنُ يلعَبُ بالنُّهى غَرّارُهُ",7,"ر",2,0],["لا تَخَف عَثرَةَ الزَمانِ عَلَيهِم","لا وَلا صَولَةَ اللَيالي العَواتي",8,"ي",1,0],["لا تَخَف مِن وَحشَةِ القَبرِ وَلا","تَبتَئِس إِنّي مُوافٍ عَن قَريبِ",9,"ب",1,0],["لا تَخافوا أَذاهُ فَالشَيخُ هاوٍ","لَيسَ فيهِ بَقِيَّةٌ لِلصُعودِ",10,"د",1,0],["لا تَخشَ جائِزَةً قَد جِئتُ أَطلُبُها","إِنّي شَريفٌ وَلِلأَشرافِ أَحسابُ",11,"ب",1,0],["لا تَخشَ طالِعَ سوءٍ","فَكَوكَبُ الشَرقِ سَعدُ",12,"د",1,0],["لا تَخدَعَنَّكَ مِن مَودودَ دَولَتُهُ","وَإِن تَعَلَّقتَ مِن أَسبابِها سَبَبا",13,"ب",2,0],["لا تَخَلني مِمَّن يُجاريكَ في اللُغ","زِ وَقَد فَرَّ مِنكَ كُلُّ مُجاري",14,"ي",1,0],["لا تَخشَ في حَقّي بِما أَمضَيتَهُ","مِن ذاكَ فِيَّ وَلا تَوَقَّ عِتابي",15,"ي",1,0],["لا تَخَل أَنَّني لَقيتُ رَواحا","بَعدَ صَخرٍ حَتّى أَثَبنَ نُواحا",16,"ح",2,1],["لا تَخَلني أَنّي نَسيتُ وَلا بُل","لَ فُؤادي وَلَو شَرِبتُ القَراحا",16,"ح",2,0],["لا تَخذُلاني فَإِنّي غَيرُ ناسِيَةٍ","لِذِكرِ صَخرٍ حَليفِ المَجدِ وَالخَيرِ",17,"ر",1,0],["لا تَخذُليني عِندَ جَدِّ البُكا","فَلَيسَ ذا ياعَينِ وَقتَ الخَذول",18,"ل",1,0],["لا تَخطُبُنَّ إِلى عَدِيٍّ إِنَّكُم","شَرُّ الفُحولِ وَأَلأَمُ الخُطّابِ",19,"ب",1,0],["لا تخلف الوعد إن وعدت ولا","خلفك للراغبين منقلب",20,"ب",1,0],["لا تَخَطّى إِلى المَظالِمِ كَفّي","حَذَراً مِن أَصابِعِ الأَيتامِ",21,"م",1,0],["لا تخدعنَّ بشهدِ العيش ترشفه","فأيُّ سمٍّ ثوى في ذلك الشهدِ",22,"د",1,0],["لا تخش من غمِّ كغيم عارض","فلسوفَ يسفر عن إضاءة بدرِه",23,"ر",2,1],["لا تخف عيلة ولا تخشَ فقراً","يا كثير المحاسن المختاله",24,"ه",1,1],["لا تخش من عاذلٍ قد جا يحاورني","يا سالبي في الهوى حلمي وأحلامي",25,"م",2,0],["لا تخف نبوة الحوادث فالله","كريمٌ يحب كل كريم",26,"م",1,0],["لا تخشَ بيتكَ أن يلوِي الزمان بهِ","فإنَّ للبيتِ ربًّا سوفَ يحميه",27,"ي",2,0],["لا تُخطئَنّي منك في موقفي","سماءُ معروف توكّفْتُها",28,"ت",3,0],["لا تُخْطِئنَّ أبا عليٍّ إنه","بابُ الغنى وسؤاله مفْتاحُه",29,"ح",2,0],["لا تَخش من لا يقتنيك الأسى","ولا تخف من يقتنيك الحسدْ",30,"د",1,1],["لا تُخادعْ بلون خِطْرِك ظَبْياً","فهو أقْذى للظبي من تَسْهادِهْ",31,"د",2,0],["لا تخْلُ عن أمثاله حُفْرةٌ","ولا تَقُمْ عن مثله والدهْ",32,"د",2,0],["لا تُخطِئُ الرأي المُوَفْ","فَق حين تُسدي أو تُنيرُ",33,"ر",1,0],["لا تَخش من بدئه قَطْعاً لعودته","فإن إقدامه إقدام كرّار",34,"ر",1,0],["لا تخف أن تُبَزَّ سربالَ خزيٍ","أنت فيه فلستَ بالمبزوز",35,"ز",1,0],["لا تخطىء المكنونَ وهي حادسه","يا لكِ نفساً ما لها مجانسَه",36,"س",2,0],["لا تخفْ مأثماً بشتمك إيّا","ه ولو جِئت غاية الإفحاش",37,"ش",1,0],["لا تخلطنَّ حلاوةً بمرارةٍ","إن المخلِّط في الإخاء منغّصُ",38,"ص",1,0],["لا تخادع في متاع زائل","فكأن قد طار منه ما وقع",39,"ع",1,0],["لا تُخْجِلنِّي بالردّ حسْبُك ما","ترى بخدي من حُمرةِ الخجلِ",40,"ل",1,0],["لا تَخْلونَ بشاغلٍ","حتى تُعِدَّ لها قوابلْ",41,"ل",1,0],["لا تَخف بخلَه وبادِر نَداه","فهو للفال أغولُ الأغوالِ",42,"ل",1,0],["لا تَخَلْ أوجَبَ الحقوق على المر","ء حقوقاً قضى بها الحُكَّامُ",43,"م",1,0],["لا تخلني قرعتُ سِنّاً بظُفْرٍ","من ندام عليك أو تنديم",44,"م",1,0],["لا تخافُوا وأيقنوا أيها القو","م بِبَيْعِي خسيسَكُمْ بِثَمينه",45,"ن",2,0],["لا تخلط الحبَّ بالتقوى فتعطفَنا","على المُقاسي عذابَ الهجر والبين",46,"ن",1,0],["لا تُخادَع فإنما يومُ نُعْمٍ","يومُ نُعْم الأمير لا النعمان",47,"ن",1,0],["لا تَخدَعَنَّكُمُ السِياسَةُ إِنَّها","شَتّى الوُجوهِ كَثيرَةُ الأَلوانِ",48,"ن",1,0],["لا تَخَف إِثماً وَلا حَرَجاً","فَدَمُ العُشّاقِ مَطلولُ",49,"ل",1,0],["لا تخف من نكث له واتبعني","فاتباعي بالشيخ أولى وأجمل",50,"ل",1,0],["لا تخشين من ابد","سوف يلاقي ازلك",51,"ك",1,0],["لا تخافي علي فالموت سهل","لا كما ينعتونه بشديد",52,"د",1,0],["لا تخافي فالموت ليس على الار","ض ولا في سمائها بجديد",52,"د",1,0],["لا تخافي هلكا من الضرب فيها","انت روح والروح ليس بمود",52,"د",1,0],["لا تخري وان قضى ان تخري","سبب قاهر من الاسباب",53,"ب",1,0],["لا تَخَف بَعدَكَ حُزناً أَو بُكاً","جَمَدَت مِنّي وَمِنكَ اليَومَ عَين",54,"ن",1,0],["لا تَخشَ مِمّا أَلحَقوا بِكِتابِهِ","يَبقى الكِتابُ وَلَيسَ يَبقى المُلحَقُ",55,"ق",1,0],["لا تَخرُجُ النَعماءُ مِن","هُ وَلا يُزايِلهُ اليَسار",56,"ر",1,0],["لا تَخلُ مِن أَمَلٍ إِذا","ذَهَب الزَمانُ فَكَم رَجَع",57,"ع",1,0],["لا تُخْدَعَنْ عنه فبائعُ ساعةٍ","منهُ بدنيانا جميعاً يخسرُ",58,"ر",1,0],["لا تَخَف عَيلَتي وَتِلكَ القَوافي","بَيتُ مالٍ ما إِن أَخافُ ذَهابَه",59,"ب",2,0],["لا تَخيبُ البِلادُ تَخطِرُ فيها","رُسُلُ الشَوقِ مِن خَيالاتِ سُعدى",60,"د",2,0],["لا تَخلُ مِن عَيشٍ يَكُرُّ سُرورُهُ","أَبَداً وَنَيروزٍ عَلَيكَ مُعادِ",61,"د",1,0],["لا تُخَوِّفنيَ الزَمانَ وَما يَأ","تي بِهِ مِن صُروفِ هَذي الدُهورِ",62,"ر",1,0],["لا تَخلِطَنَّهُم بِغَبرِهِم","مَن يَخلُطُ العِقيانَ بِالصُفرِ",63,"ر",1,0],["لا تَخطُبي دَمعي إِلَيَّ فَلَم يَدَع","في مُقلَتَيَّ جَوى الفِراقِ دُموعا",64,"ع",2,0],["لا تَخلُوَنَّ أَبا العَبّاسِ مِن نِعَمٍ","مَوصولَةٍ أَبَدَ الدُنيا وَإِنعامِ",65,"م",1,0],["لا تُخلَعُ العُذْرُ عنها عندَ أَوْبَتِها","ولا تُنَفَّسُ عن أَوساطِها الحُزُمُ",66,"م",1,0],["لا تخلُ مني راحتاهُ لدى الوغى","أَرْمِ العدا بشهابِ قَدْحٍ مضرم",67,"م",1,0],["لا تَخضَعَنَّ لِمَخلوقٍ عَلى طَمَعٍ","فَإِنَّ ذَلِكَ وَهنٌ مِنكَ في الدينِ",68,"ن",1,1],["لا تَخلُطَن ما يَقبَلُ اللَهُ مِن","فِعلٍ بِقَولٍ مِنكَ لا يَقبَلُ",69,"ل",1,0],["لا تَخضَعَنَّ لِمَخلوقٍ عَلى طَمَعٍ","فَإِنَّ ذاكَ مُضِرٌّ مِنكَ بِالدينِ",70,"ن",1,1],["لا تَخشَ يا اِبنَ الكِرامِ مِن زَمَنٍ","أَمَرتَهُ بِالصَلاحِ فَاِمتَثَلا",71,"ل",2,0],["لا تَخَف مَع رَجاءِ رَبِّكَ ذَنباً","إِنَّهُ يَغفِرُ الذُنوبَ جَميعا",72,"ع",2,0],["لا تَخزُنوا المالَ لِقَصدِ الغِنى","وَتَطلُبوا اليُسرى بِعُسراكُم",73,"م",1,1],["لا تَخشَ مِن رَدِّ الجَوا","بِ وَقَد بَدَأتُكَ بِالكِتابِ",74,"ب",1,1],["لا تَخَف إِن أَضاعَتِ المالَ كَفّا","كَ فَفيهِنَّ لِلعَلاءِ اِتِّفاقُ",75,"ق",1,0],["لا تَخشَ يارَبعَ الحَبيبِ هُمودا","فَلَقَد أَخَذتَ عَلى العِهادِ عُهودا",76,"د",2,1],["لا تخشَ من كيد عدوّ الهدى","إنّ عليّاً لَعَلَيْهِ مُعَان",77,"ن",1,0],["لا تُخْرِجِ الشيءَ عن شيءٍ يوافقهُ","واقصدْ بأمركَ في التدبير مَقْصِدَهُ",78,"ه",1,1],["لا تُخلِقَن خُلُقي فيهِم وَقَد سَطَعَت","ناري وَجَدَّدَ مِن حالي الجَديدانِ",79,"ن",1,0],["لا تَخْشَ بُؤْسَاً مِنْ عَدُوٍّ ظَاهِرٍ","وَاخْشَ الْمَكِيدَةَ مِنْ عَدوٍّ بَاطِنِ",80,"ن",1,1],["لا تخضْ في سبِّ ساداتٍ مضَوا","إنهمْ ليسوا بأهلٍ للزللْ",81,"ل",1,0],["لا تُخْلِني مِنْ لحظاتٍ فلي","أعداءُ سوءٍ يكرهون اسمي",82,"ي",1,0],["لا تَخدَعَنّي بِالمُنى باطِلاً","وَأَنتَ بي تَلعَبُ كَالعابِثِ",83,"ث",1,0],["لا تَخونُ الرَبابَ ما دُمتَ حَيّاً","يا اِبنَ عَمّي فَقَد غَدَرتَ وَخُنتا",84,"ت",2,0],["لاتَختَشوا بَعدَ ذا أَن تَدخُلوا سَقراً","فَلَيسَ تُدخَلُ بَعدَ الجَنَّةِ النارُ",85,"ر",1,0],["لا تَخافي وَلَن تُراعي بِسوءٍ","ما تَغَنّى الحَمامُ في الأَغصانِ",86,"ن",1,0],["لا تَخَافي أَنْ تَزُوليِ أو تَبِيدي","أنتِ أُمُّ الدّهرِ أو أُخْتُ القضاءْ",87,"ا",2,0],["لا تَخْذُلُوهم والملائكُ شُهَّدٌ","بالمَسْجِدَيْنِ كَفَى بذلكَ مأثما",88,"م",2,0],["لا تَخافيِ اللَّيثَ في إقدامِهِ","واذْكُرِي مَجْدَكِ في مَاضِي العُصُرْ",89,"ر",1,0],["لا تَخدَعَنَّكَ فِيَّ نَظرَةُ كاذِبٍ","وانظُر إِلَيَّ بِعَينِ مَن لا يَكذِبُ",90,"ب",1,0],["لا تَخْشَ يا ابنَ أَنيسٍ","فليس سُفيانُ نِدَّكْ",91,"ك",1,0],["لا تخافي فتلك دولته العُظ","مَى تناديك أن أعد