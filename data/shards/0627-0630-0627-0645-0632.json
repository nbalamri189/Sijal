{"poems":[[63,"أيا من رأى البدر بدر السماء","https://www.aldiwan.net/poem51500.html","المتقارب"],[82,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[82,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[83,"موسى ترفق ولا تضعني","https://www.aldiwan.net/poem61338.html","مخلع البسيط"],[371,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[422,"جميل الصنيع بأهل الأدب","https://www.aldiwan.net/poem53855.html","المتقارب"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[473,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[572,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[580,"وصهباء رقت فاسترقت عقولنا","https://www.aldiwan.net/poem2731.html","الطويل"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105200","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100449","الوافر"],[2512,"","https://poetry.dctabudhabi.ae/diwan/poem/203820","المتقارب"],[2790,"","https://poetry.dctabudhabi.ae/diwan/poem/143384","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68116","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103964","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45745","الطويل"],[3632,"","https://poetry.dctabudhabi.ae/diwan/poem/146003","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114466","الوافر"],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""]],"verses":[["إذا مَزَّقَ الثَّوبَ مِقراضُه","تمزَّقَ قلبي كتَمزيقِه",0,"ق",2,0],["إذا مُزِجتْ لِتَعْدلَ في الندامى","تَطَايَرَ عن جوانِبِها الشرارُ",1,"ر",1,0],["إذا مُزِجَتْ لانَتْ لنا وتَحَوّلَتْ","بأخلاقِها عن قَسْوَةِ الجامحِ الصعبِ",2,"ب",1,0],["إذَا مَزَايَا الجَمَالِ عُدَّت","لَم يُحسَب البَدرُ من رَجَالِك",3,"ك",1,0],["إِذا مَزَجَ الماءُ مِنها الكُئوس","مَزَجنا أَسِنَّتَها بِالنِصالِ",4,"ل",1,0],["إذا مُزِجَتْ بابن ماء السَّماء","تولَّدَ منها لآلي الحبب",5,"ب",1,0],["إذا مزّقَتْ منها الصوارمُ جانباً","ببرقٍ سَناها رقّعَتْهُ السنابكُ",6,"ك",1,0],["إِذا مُزِجَت أَبدَت حَباباً كَأَنَّهُ","مِنَ الدَرِّ طَوقٌ في غِلالَةِ عَسجَدِ",7,"د",1,0],["إِذَا مُزْنَةٌ سَكَبَتْ مَاءَهَا","عَلَى بُقْعَةِ أَشْعَلَتْ نَارَهَا",8,"ر",3,0],["إِذا مُزِجَت كَانَ المزَاجُ فِدىً لها","ولو أَن ذاك المزْجَ أَخْفَى مِنَ الوَهْمِ",9,"م",1,0],["إذا مزجت بالماء وهي سخينة","سخينا وهل فينا يعدّ بخيل",10,"ل",1,0],["إذا مزجت بدت فيها حباب","تلون فوقها زرقاً وسودا",11,"د",2,0],["إذا مُزجتْ خلت في كاسها","تحلل ياقوتة جامده",12,"د",2,0],["إذا مُزجتْ خِلتَها زُوِّجتْ","صفاءً اللُّجين بذَوبِ الذهبْ",13,"ب",1,0],["إِذَا مُزعِجاتُ الدهرِ يوماً أَصبْننِي","وليلاتُ سوءٍ للبَلايا نَصَبنني",14,"ي",1,1],["إذا مزجت الحق بالباطل","جوزت ما شئت على الغافل",15,"ل",1,1],["إِذا مَزَجَت بابن السَحاب تَقَلَدَت","بَدرّ مَديح أَفردتهُ المَناقب",16,"ب",1,0],["إذا مزجت فاحت فخلت نسيمها","بأخلاق مولانا الوزير تعبقا",17,"ق",2,0],["إذا مزجت بماء الشوقِ مزجاً","وأطلعت الكواكب في الأواني",18,"ن",2,0],["إذا مزعت في الدو خلت خواطفا","من الشهب تقفو إثر كل مخاتل",19,"ل",1,0]]}