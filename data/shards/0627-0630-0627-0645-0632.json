{"poems":[[61,"أيا من رأى البدر بدر السماء","https://www.aldiwan.net/poem51500.html","المتقارب"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[80,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[81,"موسى ترفق ولا تضعني","https://www.aldiwan.net/poem61338.html","مخلع البسيط"],[367,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[417,"جميل الصنيع بأهل الأدب","https://www.aldiwan.net/poem53855.html","المتقارب"],[433,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[469,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[568,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[576,"وصهباء رقت فاسترقت عقولنا","https://www.aldiwan.net/poem2731.html","الطويل"]],"verses":[["إذا مَزَّقَ الثَّوبَ مِقراضُه","تمزَّقَ قلبي كتَمزيقِه",0,"ق",2,0],["إذا مُزِجتْ لِتَعْدلَ في الندامى","تَطَايَرَ عن جوانِبِها الشرارُ",1,"ر",1,0],["إذا مُزِجَتْ لانَتْ لنا وتَحَوّلَتْ","بأخلاقِها عن قَسْوَةِ الجامحِ الصعبِ",2,"ب",1,0],["إذَا مَزَايَا الجَمَالِ عُدَّت","لَم يُحسَب البَدرُ من رَجَالِك",3,"ك",1,0],["إِذا مَزَجَ الماءُ مِنها الكُئوس","مَزَجنا أَسِنَّتَها بِالنِصالِ",4,"ل",1,0],["إذا مُزِجَتْ بابن ماء السَّماء","تولَّدَ منها لآلي الحبب",5,"ب",1,0],["إذا مزّقَتْ منها الصوارمُ جانباً","ببرقٍ سَناها رقّعَتْهُ السنابكُ",6,"ك",1,0],["إِذا مُزِجَت أَبدَت حَباباً كَأَنَّهُ","مِنَ الدَرِّ طَوقٌ في غِلالَةِ عَسجَدِ",7,"د",1,0],["إِذَا مُزْنَةٌ سَكَبَتْ مَاءَهَا","عَلَى بُقْعَةِ أَشْعَلَتْ نَارَهَا",8,"ر",3,0],["إِذا مُزِجَت كَانَ المزَاجُ فِدىً لها","ولو أَن ذاك المزْجَ أَخْفَى مِنَ الوَهْمِ",9,"م",1,0]]}