{"poems":[[53,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[119,"لك عند عبدك موطن في قلبه","https://www.aldiwan.net/poem40937.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126821","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126746","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80192","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136313","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87754","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137090",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135618","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"]],"verses":[["بكَ حلَّ الملامُ لا بي بل النَّفْ","سُ التي أمَّلتكَ عين الملومه",0,"م",2,0],["بك حاضر في بعده وبقربه","يا ابن الرفاعي الذي حفلت به",1,"ه",1,0],["بكَ حفّت فما أُحيلى اِجتماع","مع قومٍ أنوارهم تَتلالا",2,"ل",2,0],["بكَ حفّ أرباب الولاء ببهجةٍ","والكلُّ مِنهم ضاحك مستبشرُ",3,"ر",1,0],["بِكِ حُرقَتي وَلهي وَحرّ صَبابَتي","لَكِ مُهجَتي في مُهجَتي أَفديكِ",4,"ك",1,0],["بك حالي يا سيدي مستقيم","والرضى منك لي نعيم مقيم",5,"م",1,1],["بِكَ حارَبت مَعشري وَأَقامَت","صَبوَتي فيكَ للملاحة سوقا",6,"ق",2,0],["بِكِ حُقّقت آمال كُل مُؤَمّل","وَإِلَيك يَهوي قَلب كُل هُمام",7,"م",1,0],["بك حقق الزهر الضنين ظنوني","وبجوده بك كان غير ضنين",8,"ن",1,1],["بك حولي واعتصامي","في قعودي وقيامي",9,"م",2,1],["بك حتى الأسطول جاء فغابا","أي مرءٍ ولو بشرخ الشباب",10,"ب",1,0]]}