,"ع",1,0],["يَتَمَلَّى النُّعْمَى تُشَارِكُهُ فِي","هَا الَّتِي شَارَكَتْهُ فِي الآلامِ",2,"م",1,0],["يتم كلاهما هذا بهذا","كذلك تمّ أمرهما القويم",3,"م",1,0],["يَتَمارى في الَّذي قُلتُ لَهُ","وَلَقَد يَسمَعُ قَولي حَيَّهَل",4,"ل",1,0],["يتمنى حسودُكَ العيشَ حتَّى","أتمنَّى له امتدادَ البقاء",5,"ا",2,0],["يتمنى القضا فلا تعطينهُ","واجعلِ الموتَ سابقاً للقضاء",6,"ا",2,0],["يتمسك الروض النضير بذيلها","متأرّجاً والزّهر بالأكمام",7,"م",1,0],["يتمنى السَّميعُ حين يُغنّي","أنه قبلَ ذاك صُمَّ صداهُ",8,"ا",2,0],["يتمتَّعُونَ بما جمعْ","تَ ولا يَرَوْن عليه حمدَك",9,"ك",1,0],["يَتَمَنّى يا بُعدَ ما يَتَمَنّى","لَو جَرى ذِكرُهُ عَلى الأَقدامِ",10,"م",1,0],["يَتَمَنّونَ أَنَّهُم لا يَعونا","هَمُّكُم في الكُؤوسِ وَالأَكوابِ",11,"ب",1,0],["يَتَمَايلُ الحُلُمُ الجميلُ","كنَسْمَةِ القَلْبِ الثَّمِلْ",12,"ل",1,0],["يتمشَّى في مَلالٍ","فَوْقَ هاتيكَ السُّهولْ",13,"ل",1,0],["يَتَمَنّى أَخو الهَوى مِنهُ آهاً","حينَ يُلحى تَكونُ مِن أَعذارِهِ",14,"ر",2,0],["يَتَمَنّى الشَيخُ مِنهُ ساعَةً","بِحِجابِ السَمعِ أَو نورِ البَصَر",15,"ر",1,0],["يَتَمَنّى مُنيَّتي","وَهوَ لِلقَلبِ مَطلَبُ",16,"ب",1,0],["يتمشى السقم في قلب الأجل","وأراني لك ما وفّيتُ دَيني",17,"ي",1,0],["يتمنى الشعر فيه غاية","وهو عنها عاجز الباع ضعيف",18,"ف",1,0],["يتمنّى لي وفائي عودة","والهوى المجروح يأبى أن نعودا",19,"د",2,0],["يتمنى كُفْرَ شخصٍ","والرضى بالكفرِ كفرُ",20,"ر",1,0],["يَتملّقُ المولى المعظَّم عَبْدَهُ","فيهِ ويَخْشَى الحاكمُ المحكوما",21,"م",2,0],["يَتَمَشّى عَلى حَصىً سَلَبَ الري","حُ قَذاهُ فَمَتنُهُ مَجلِيُّ",22,"ي",1,0],["يَتَمَنّاني وَإِن لاقَيتُهُ","خافَ إِقدامي عَلَيهِ فَاِنكَسَر",23,"ر",1,0],["يَتَمَنّى مَشيَ البَلاطِ وَأُلهي","هِ بِشعري وَكيفَ لَهوُ الحَسيرِ",24,"ر",1,0],["يتمنَّى فيكَ لو يَفْنى كما","يتفانى الغيمُ في البحرِ العُبابْ",25,"ب",1,0],["يَتَمَشَّى دُونَهُ حَتَّى إِذَا","لَحِقَتْهُ نَبْأَةٌ مِنِّي اسْتَقَرْ",26,"ر",1,0],["يَتَمَنَّوْنَ لِي الْعِثَارَ ويَلْقَوْ","نِي بِوَجْهٍ إِلَى الْمَوَدَّةِ صَادِي",27,"د",2,0],["يِتَمَكُّنِ الأرْكَانِ وَالأسُسِ الَّتِي","حَملَتْكَ زُكِّيَ رَأْيُ مِصْر الع