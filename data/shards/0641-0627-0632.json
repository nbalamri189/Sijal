0],["فازْوَرَّ عنْ كُلِّ نِكْسٍ لا يُهابُ بهِ","إِلى الثّناءِ عنِ العَلْياءِ مُنْحَرِفِ",3,"ف",1,0],["فَاِزوَرَّ مِن وَقعِ القَنا بِلَبانِهِ","وَشَكا إِلَيَّ بِعَبرَةٍ وَتَحَمحُمِ",4,"م",1,0],["فَازَ عَبْدٌ أَقْرَضَ الل","هَ بِرُجْحَانِ القِرَاضِ",5,"ض",1,0],["فأزِلْ خَجْلَتي بإغْضائِكَ المَأ","مُولِ واسْتُرْ بِهِ عُوّارَ افْتِضاحِ",6,"ح",1,0],["فَازَ قِدْماً مَنْ لَهُ نَظَرٌ","قَبْلَ بَدْءِ الأَمْرِ فِي الغِبِّ",7,"ب",1,0],["فَازَ القَوِيُّ عَلَيْنَا فِي تَضَاؤُلِنَا","وَالحَقُّ أَعْلَى وَلَكِنْ لَيْسَ يُغْنِينَا",8,"ن",2,0],["فَأَزَلتَ كُرْبَةَ كُلِّ ذِي شَجَنٍ","بِالرَّائِقِ الشَّافِي مِنَ الكَلِمِ",9,"م",1,0],["فَأَزعَجَها رامٍ بِسَهمٍ فَأَدبَرَت","لَها رَوعَةٌ يَنفي السِلامَ حَفيلُها",10,"ل",3,0],["فاز الذي كان في أحواله وسطاً","فالمُرّ يُعقَى وإن الحُلو يُستَرَط",11,"ط",1,0],["فَازُوا بهِ لا مُشَارَكِينَ كَمَا","أحرَزَ صَفوَ النِّهَابِ مُنتَهِبُ",12,"ب",1,0],["فاز الذي شغل الأسى أوقاته","لو كان أشبعه الأسى أوقاته",13,"ت",2,1],["فاز امرؤٌ ألقى يمين رجائه","لمقام إسماعيل يوماً واعتلق",14,"ق",1,0],["فاز حرٌّ أمسيت مغزَى رجاه","وزمان أصبحت صدر منامهْ",15,"م",2,0],["فأزداد في الحبِّ انْتساباً لعامرٍ","إلى أن أزيد العاذلين ملاما",16,"م",2,0],["فازت يدا من بعلي الندى","تعلق يمناه وأيمانه",17,"ن",2,0],["فَازرَعِ الكُلَّ بِأَرضٍ","تُربُها تُربُ مَواتِ",18,"ت",1,0],["فاز الورى من ريحكم بسحائبٍ","هطلت وفزتُ بسافياتِ ترابِ",19,"ب",1,0],["فَازَ مَنْ عَاطَتْ يَداها يَدَهُ","عَاتقَ الرَّاح بكَأسٍ وقَدَحْ",20,"ح",1,0],["فازجره ناكسَ داءٍ هَدَّ قوَّتَه","لك المليكُ الذي ما زال مولاكا",21,"ك",2,0],["فازجُر النفسَ عن توعُّدِ مثلي","قبلَ أن يأخُذ الحُسامُ وريدَك",22,"ك",1,0],["فأزِح عِلَّتي فإن كفافي","يمنعُ العذرَ مَنْ أرادَ اعتلالا",23,"ل",2,0],["فأزهق مكرُ اللَّهِ ذي الحَوْلِ مكرَهُ","عقاباً ومكرُ اللَّهِ للمكر قتّالُ",24,"ل",1,0],["فاز الغواني بما أمَّلنَ من أملٍ","فما يبالينَ ما لاقينَ من أجلِ",25,"ل",1,0],["فأزِرْني لُها يديك فما زِل","نَ نِشاطاً للهمةِ المِكسالِ",26,"ل",1,0],["فَاِزجِرِ الريحَ أَن تَهُز وَتَلوي","شَجَرَ الرَوضِ إِنَهُ يَتَأَوَّد",27,"د",1,0],["فَأَزعَجَني مَرآهُ حَتّى كَأَنَّما","رَسولُ الرَدى قَد جاءَ يَنعى لِيَ نَفسي",28,"س",2,0],["فَاِزرَع طَريقَكَ بِالورودِ وَبِالسَنا","لا يَحصُدُ الإِنسانُ إِن لَم يَزرُعِ",29,"ع",1,0],["فاز مَن شيّدوه بالحمد وأسوَدّ","ت وجوهاً بخزيها البخلاء",30,"ا",2,0],["فَأَزعَجَ الصَوتُ وَلِيَّ العَهدِ","فَماتَ مِن رَعدَتِهِ في المَهدِ",31,"د",1,0],["فَاِزوَرَّ غَضباناً وَأَعرَضَ نافِراً","حالٌ مِنَ الغيدِ المِلاحِ عَرَفتُهُ",32,"ت",2,0],["فَأُزعِجَ مَغبوطٌ وَرُوِّعَ آمِنٌ","وَغالَ سَلامَ العالَمينَ التَعَصُّبُ",33,"ب",1,0],["فازوا بِأَرحَبِ دارٍ مِنهُ أَفنِيَةً","فيحاً وَأَقدَمَ مُلكٍ مِنهُ ميلادا",34,"د",2,0],["فازَ مِن حارِثٍ وَخَسرو وَمِن هُر","مُزَ بِالمَجدِ وَالفَخارِ التَليدِ",35,"د",1,0],["فازَ بِالروحِ وَالسَلامَةَ مَن كا","نَت فُضولُ الدُنيا عَلَيهِ تَهونُ",36,"ن",1,0],["فَأَزالَهُ عَن رُشدِهِ","فَابتاعَ دُنياهُ بِدينِه",37,"ن",2,0],["فَاِزدادَ يُبساً وَقامَ مُمتَعِضاً","وَلاحَ فيهِ النَفارُ وَالغَضبُ",38,"ب",1,0],["فَأَزمَعَ نِيَّةً هَرَباً فَحامَت","حُشاشَتُهُ عَلى أَجَلٍ بَليدِ",39,"د",1,0],["فازَ حسينٌ بالثنا والهنا","بصبرِهِ عنْ قدحِ الخمرِ",40,"ر",1,1],["فَاِزدَد سَنا بَهجَةٍ بِدُهمَتِهِ","فَاللَيلُ أَذكى لِغُرَّةِ القَمَرِ",41,"ر",1,0],["فاز الأجانبُ واسْتبدَّ غُلاتُهم","أفما يسرُّكِ أَن يفوزَ الآلُ",42,"ل",1,0],["فاز بالرضوانِ إذ خلَّفني","في قواريرَ كثيراتِ العَدَدْ",43,"د",1,0],["فازَت مُنايَ بِهِ وَقَرَّت أَضلُعي","هاتيكَ لَم تُخفَق وَذي لَم تَخفِقِ",44,"ق",1,0],["فَأَزَلَّ السَهمَ عَنها كَما","زَلَّ بِالساقي وَشيعُ المَقام",45,"م",1,0],["فَأَزجا فَأَنبا بِالَّذي كُنتُ أَهلَهُ","سُرِرتُ بِهِ مِنهُ وَلاقَيتُ أَسعُدا",46,"د",2,0],["فَازددتُ أَحزاناً عَلى حَزنٍ","مِنكُم مُنِيتُ بِهِ عَلى ضَعفي",47,"ي",1,0],["فَاِزدادَ سَهواً وَضَنىً وَسُقما","وَلا تَراهُ الدَهرَ إِلّا فَدَما",48,"م",2,0],["فَاِزجُر فُؤادَكَ أَو سَنَزجُرُهُ","قَسَماً لِيَنتَهِيَنَّ أَو حَلَفا",49,"ف",2,0],["فَأَزقاقُهُ سودٌ وَحُمرٌ دِنانُهُ","فَفي البَيتِ حُبشانٌ لَدَيهِ وَرومُ",50,"م",1,0],["فَاِزجُر هَواكَ وَحاذِر أَن تُطاوِعَهُ","فَإِنَّهُ لَغَويٌّ طالَما عُبِدا",51,"د",2,0],["فَاِزجُر عَزيزَتَكَ المُسيئَةَ جاهِداً","وَاِستَكفِ أَن تُتَخَيَّرَ الأَصهارُ",52,"ر",1,0],["فَاِزجُر خَواطِرَ نَفسٍ غَيرِ مُحسِنَةٍ","فَقَد تُجَشِّمُ في دُنياكَ أَخطارا",53,"ر",2,0],["فازَ اِمرُؤٌ باتَت الأَقدارُ تَحرُسُهُ","وَّإِن مَدَدتَ إِلَيهِ كَفَّ مُحتَرِسِ",54,"س",1,0],["فَاِزجِرِ النَفسَ إِذا ما أَسرَفَت","فَمَتى لَم يُقصِصِ الظُفرُ كَلَم",55,"م",1,0],["فَأَزمِع مِن بَني الدُنيا نِفاراً","فَإِنَّهُمُ لَفي لَعِبٍ وَلَهوِ",56,"ه",2,0],["فازورّ من غضب وأوقف طرفه","في القرب يَزفر زفرة الغيران",57,"ن",1,0],["فاز امرؤٌ أنصف في دهره","وخاب من مال إلى الحيف",58,"ف",1,0],["فازْدَهَتْنى أَرْيَحِيّاتُ الصِّبا","واسْتَخَفَّتْنِي دواعِي طَرَبي",59,"ي",1,0],["فَازَ فِيهَا بِمَا تُرَجِّيهِ نَفْسٌ","مِنْ عُلُوٍّ فَلَمْ يَفْتْهُ سَنَامُ",60,"م",1,0],["فَازَ الْحَنَانُ وَكَمْ لَهُ مِنْ آيَةٍ","غَرَّاءَ أَسْطَعَ مَا تَجَلَّتْ فِيكٍ",61,"ك",1,0],["فازَ نَيْرُونُ بِأَقْصى مَا اشْتهَى","مُحْرِقاً رُومَا لِيَسْتَبْدِعَ فِكْرَا",62,"ر",2,0],["فاز بِالأُولى عَليْها وَلَهُ","دُونَهَا مَعْذَرَةُ التَّارِيخِ أُخْرُى",62,"ر",2,0],["فَازَالَ عَصْراً سامَ أُمَّتَهُ","خَسفاً وجدَّدَ لِلْعُلى عَصْرَا",63,"ر",2,0],["فَازَ شَرْقُ الأُرْدُنِّ مِنْهُ بِعَودٍ","مُسْتَطَابٍ كَأنَّهُ كَانَ وَعْدَا",64,"د",2,0],["فازَ ثَواباً بِما تَشَكّى","وَلا ثَوابٌ بِغَيرِ شقِّ",65,"ق",1,0],["فازَ المُخِفّونَ بِالحُسنى وَقَيّدَني","وَراءَهُم ثِقلُ أَوزارٍ وَآثامِ",66,"م",1,0],["فازَ مَن لَم يَستَقِرَّ هَوىً","فَخَلا مِنها وَلا خَلَلا",67,"ل",2,0],["فازَ مَن ماتَ صَغيراً مِثلَهُ","لَم يُقَل عَفَّ وَلا قيلَ فَسَق",68,"ق",1,0],["فأزاله عن رأيه","فابتاع دنياه بدينه",69,"ن",2,0],["فَازَتْ برُكْنٍ شَديدٍ غَيْرِ مُنْصَدِعٍ","مِن البَيَانِ وَحَبْلٍ غَيْرِ مُضْطَرِبِ",70,"ب",1,0],["فَأَزَاحَ الغِطاءَ عنهم فقاموا","في ذُهُولٍ وأقْبَلُوا في سُمُودِ",71,"د",1,0],["فازتْ به مِصْرٌ بخَيْرِ مُتَوَّجٍ","يَنْهَى كما يرضَى الإِلهُ ويأمر",72,"ر",1,0],["فازَ بالمال كلُّ هتَّافِ حزبٍ","فاحمِهِ من لصُوصه الشُّرفاء",73,"ا",2,0],["فأزمعَ عنكَ السّير لا عن ملالة ٍ","وقد كمُلت بالبر منه المآرِب",74,"ب",1,0],["فأزالهم عنا كليب بطعنة","في عمر بابل من بني قحطان",75,