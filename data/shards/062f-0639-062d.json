{"poems":[[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[53,"نزهة عندي كاسمها نزهه","https://www.aldiwan.net/poem66719.html","السريع"],[82,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[89,"دع حبيب القلب يا سقم","https://www.aldiwan.net/poem8281.html","المديد"],[33,"يا صاحبي أقلا اللوم واحتسبا","https://www.aldiwan.net/poem42544.html","البسيط"],[82,"إلى متى منكمُ هجري وإقصائي","https://www.poetsgate.com/ViewPoem.aspx?id=2931",""],[119,"دع حب من ترك الوفا","https://www.aldiwan.net/poem41494.html","مجزوء الكامل"],[563,"دب سر الوجود بالمفقود","https://www.aldiwan.net/poem33552.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122738","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122712","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64414","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53116","الرمل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45622","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146349","الخفيف"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103596","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138442",""],[4859,"فاعلاتن مستفعلن فاعلاتن","https://www.poetsgate.com/ViewPoem.aspx?id=190559",""],[6089,"هبْ لي جمارك","https://www.poetsgate.com/ViewPoem.aspx?id=213860",""]],"verses":[["دع حاتماً يفخر في قومه","بنحره البكرة لا البدره",0,"ر",2,0],["دعْ حبها يحكُم في مُهْجتي","وأْمُرْهُ بالجَوْر ولا تَنْهَهْ",1,"ه",2,0],["دعْ حيلةَ البُرْءِ في تبريح ذي سَقَم","إنّ المشارَ إليه ريقُ لمياءِ",2,"ا",2,0],["دَعْ حَبِيبَ الْقَلْبِ يَا سَقَمُ","فَبِنَفْسِي لا بِهِ الأَلَمُ",3,"م",1,1],["دَع حُبَّها وَتَناسَ الحُبَّ تُلقَ بِهِ","وَاِصبِر وَكُن كَصَريعِ قامَ مِن سَكَرِ",4,"ر",1,0],["دع حيلة البرءِ في تبريج ذي سَقَمٍ","إن المشارَ إليه ريقٌ لمياءِ",5,"ا",2,0],["دع حب من ترك الوفا","وتدللا أجرى الجفا",6,"ف",2,1],["دع حديث الحدوث واذكر قديم ال","ذكر عندي وهنّني بشهود",7,"د",1,0],["دَع حَسُودي والَّذي يُضمِرُهُ","فَرياحُ الوَردِ داءُ الجُعَلِ",8,"ل",1,0],["دَع حاسِدي والَّذي تُخفيهِ أضلُعُه","فالوَردُ أقتَلُ شَيءٍ شَمَّهُ الجُعَلُ",9,"ل",1,0],["دع حبيبي يسوق لي من بلايا","ه فما ضاق علمه بانكساري",10,"ر",2,0],["دع حبيبي يموه الحب بالص","د ويخفي الصفاء في الاكدار",10,"ر",1,0],["دع حديث الملوك عنك وما مهد","كسرى في العدل أو أزدشير",11,"ر",1,0],["دَع حُب أَول مِن كَلَفت بِحُبه","ما الحُب إِلّا لِلحَبيب الآخر",12,"ر",1,1],["دعْ حديثَ الهوى فقد وثب العَقْ","لُ على الجهلِ وِثبة السِّرحان",13,"ن",1,0],["دع حاتما يشجي بكفكم","وأفخر بدعمي على عمر",14,"ر",1,0],["دع حديث المكان واذكر حدي","ث القرب من ربه بذاك النادي",15,"د",2,0],["دع حروف الخفيف تنسيك هماً","وجراحا بنت بقلبك دارا",16,"ر",2,1],["دع حبلنا بالغرام العذب متصلا","وازرع بكفيك في أعماقيَ الأملا",17,"ل",2,1]]}