{"poems":[[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[32,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[32,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[93,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[34,"وما بكت النساء على قتيل","https://www.aldiwan.net/poem27759.html","الوافر"],[47,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[63,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[46,"ألا يا أيها الملك المعلى","https://www.aldiwan.net/poem30561.html","الوافر"],[33,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[35,"وإني وإن لم آت ليلى وأهلها","https://www.aldiwan.net/poem25828.html","الطويل"],[107,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[48,"تغيبت في منزلي برهة","https://www.aldiwan.net/poem22500.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85301","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[234,"شكوت إليها لا شكوت صبابتي","https://www.aldiwan.net/poem50726.html","الطويل"],[234,"ولى صاحب لا يمرض العقل جهله","https://www.aldiwan.net/poem51253.html","الطويل"],[369,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[487,"لقد كنا رنقا قبل فتق وجودنا","https://www.aldiwan.net/poem24464.html","عموديه"],[556,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77487","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56710","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80035","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113976","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108735","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1668,"","https://poetry.dctabudhabi.ae/diwan/poem/31382","السريع"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101712","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21619","الوافر"],[3038,"","https://poetry.dctabudhabi.ae/diwan/poem/124276","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46914","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85243","الطويل"],[4076,"","https://poetry.dctabudhabi.ae/diwan/poem/28241","المتقارب"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141695","الوافر"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103327","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""],[5906,"عزيمة هائمة","https://www.poetsgate.com/ViewPoem.aspx?id=188521",""]],"verses":[["فَلَم أَملِك غَداةَ نَعِيِّ صَخرٍ","سَوابِقَ عَبرَةٍ حَلَبَت صَراها",0,"ا",3,0],["فَلَمّا مَضَت بَعدَ المُثَنّينَ لَيلَةٌ","وَزادَت عَلى عَشرٍ مِنَ الشَهرِ أَربَعُ",1,"ع",1,0],["فَلَمّا مَضَى نَوءُ الزُبانَى وَأَخلَفَت","هَوادٍ مِن الجَوزآءِ وَاِنغَمَسَ الغَفرُ",2,"ر",1,0],["فَلَمّا مَضى عَصرُ الشَبيبَةِ كُلَّهُ","وَفارَقَني شَرخُ الشَبابِ مُوَدَّعا",3,"ع",2,0],["فَلَمّا مَضى نورُ الرَبيعِ عَنِ الرُبى","وَدَبَّ إِلى أَزهارِها المَوتُ مُنسَلّا",4,"ل",2,0],["فَلَمّا ماتَ مِن طَرَبٍ وَسُكرٍ","رَدَدنَ حَياتَهُ بِالمُسمِعاتِ",5,"ت",1,0],["فَلَم أَملَ إِلّا مِن مَوَدَّتِهِ يَدي","وَلا قُلتُ إِلّا مِن مَواهِبِهِ حَسبي",6,"ب",2,0],["فلما مَضى المِقدارُ قلَّ غناؤها","فلم يمضِ حَدٌّ من ظُباها ولا غَرْبُ",7,"ب",1,0],["فَلَم أَمدَحكَ تَفخيماً بِشِعري","وَلَكِنّي مَدَحتُ بِكَ المَديحا",8,"ح",2,0],["فَلَمّا مَضَت مِن أَوَّلِ اللَيلِ هَجعَةٌ","وَأَيقَنتُ مِن حَسِّ العُيونِ غُفولا",9,"ل",2,0],["فَلَمّا مَضَت أَيّامُ ذي الغَمرِ وَاِرتَمى","بِيَ الهَجرُ لامَتني عَلَيكِ اللَوائِمُ",10,"م",1,0],["فلمّا مَسَّ صاحبهم عذابٌ","بَدا الشَّرُّ المغيَّبُ في الصُّدورِ",11,"ر",1,0],["فَلَمّا مَضى العُمرُ إِلّا الأَقَلَّ","وَحُمَّ لِروحي فُراقُ الجَسَد",12,"د",1,0],["فَلَمّا مَضَت عني إلى غير عودة","ظللت رِدائي فوق رأَسي قاعِداً",13,"د",2,0],["فَلَم أُمسِك بِسَمعي إِذ دَعاني","وَلَكِن قَد أَبانَ لَهُ لِساني",14,"ن",2,0],["فَلَمّا ماتَ مُتُّ أَسىً عَلَيهِ","كَأَنّي كُنتُ جِسماً وَهوَ روحُ",15,"ح",1,0],["فلما مسحت النوم قمت مهنئاً","يلاقيك من وجه الصباح بشيرُ",16,"ر",1,0],["فلمّا منعت الشَّكْوَ مِنّي تَجلُّداً","وأدْمَنْتُه حتّى غدا القلبُ سالِيا",17,"ي",2,0],["فلمّا مزَجناها بدا فوق رأسها","حَبابٌ كما يَنْسابُ من سِلْكه الحَبُّ",18,"ب",1,0],["فلمّا مدَحْتُ الماجِدَ ابنَ مُحّمدٍ","وفَيتُ لِذي العلياء أيَّ وفاء",19,"ا",2,0],["فلما محا لي آية الليل شاهدت","بأنك مفعول وفعل وفاعل",20,"ل",1,0],["فَلمّا مَضى مَن كان أمَّرنا لَكمْ","أَتَتْنا كَما شاء العقوقُ العجائبُ",21,"ب",1,0],["فَلَما مر ذكر الزَوج راقَت","وَجَفَ الدَمع وَاِنقَطَع الزَفير",22,"ر",1,0],["فلما مشى من قلبه نحو قلبها","رسول الهوى خابت لديه وسائلهْ",23,"ل",2,0],["فلما مخائله بشَّرتْ","بتحقيق ما أرتجي أن يكونا",24,"ن",2,0],["فَلّمّا مَحَضتُ النصحَ صمّوا وأعرَضوا","فَما مِنهُم للنُصحِ منّيَ قابِلُ",25,"ل",1,0],["فلما ملت عن داري لغيري","وظلت بها لعذالي تواسي",26,"س",2,0],["فلما مات لم يندبه خلق","سواهم بالقصيد موتبنينا",27,"ن",2,0],["فلما مر مالي باعدوني","ولما عاد مالي عاودوني",28,"ن",2,0],["فلما مضى قال الثناء مؤرخاً","قضى عمره دور بطيب المعارف",29,"ف",1,0],["فَلَم أَملِك دُموعَ العَينِ مِنّي","وَلا النَفسَ الَّتي جاشَت مِرارا",30,"ر",2,0],["فلما مضى ذهل من الليل اقبلت","أهازيج سقبان وهزم فحول",31,"ل",1,0],["فَلَمْ أمْلِكِ الدَّمْعَ المُوَرَّد أنْ جَرَى","ولَمْ أمَلِكِ القَلْبَ المُعَذَّبَ أنْ حَنَّا",32,"ن",2,0],["فلما مضت تلك العصابة لم يقم","بعد لهم من ضمه الشام والسند",33,"د",1,0],["فَلَمّا مَرَرنَ عَلى عَسجَدٍ","وَأَشهَلنَ مِن مُستَناخٍ سَبيلا",34,"ل",2,0],["فلم أملك لدمعي رد غرب","وعند الشوق تعصيك الدموع",35,"ع",1,0],["فلما ملَّ من جهد اصطباري","رميتُ به على وجه الغواني",36,"ي",1,0],["فَلَمّا مَضى لَيلي وَوَلَّت نُجومُهُ","وَأَشرَقَ شَمسي في الألوهَةِ ساطِعُ",37,"ع",1,0],["فلم أمدّ لمنديل الجبين يداً","أد خفت إشراق صبح منهُ هتاكِ",38,"ك",1,0],["فَلِمَ امتَحنتَ عَزيمَتي بِعيونها","وأنا الّذي فيمَ امْتُحنْتُ أراكَ",39,"ك",1,0]]}