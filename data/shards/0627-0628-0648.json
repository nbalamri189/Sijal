iwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[106,"أنا وابناي","https://www.poetsgate.com/ViewPoem.aspx?id=179447",""],[22,"أَلاَ كُلُّ أَرْمَاحٍ قِصَارٍ أَذِلَّة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19753",""],[22,"أَبُوكَ رَبيعَة ُ الخَيْرِ بنُ قُرْطٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19816",""],[50,"تَنَحَّ لَحَاكَ اللّه لَسْتَ مِنَ العَدَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=21821",""],[45,"ألبَيْتُ مَبْنيٌّ على أرْكَانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31723",""],[45,"اسْتَوقِفا الرَّكبَ في أَطْلالِهم، وقِفا","https://www.poetsgate.com/ViewPoem.aspx?id=32848",""],[51,"أبو علي بن أبي قره","https://www.poetsgate.com/ViewPoem.aspx?id=29045",""],[51,"بدا الشيبُ في رأسي فَجَلَّى عَمَايتي","https://www.poetsgate.com/ViewPoem.aspx?id=27410",""],[50,"أفَرخ الزِّنجِ طَالَ بِك البَلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8361&r=&rc=3",""],[105,"أعيدوا الحق واتخذوه عهدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55055&r=&rc=225",""]],"verses":[["أَبَوا إِباءَ البُزلِ فَاِقتادَتهُمُ","مِنَ المَقاديرِ مُطاعاتُ الشَطَن",0,"ن",1,0],["أَبِوِردِها المَطروقِ أَو بِنَعيمِها ال","مَمذوقِ أَم ميعادِها المَمطولِ",1,"ل",1,0],["أَبَوا أَن يُخِلّوا بِنارِ القِرى","وَلَو وَقَدوا نارَهُم بِالعَوالي",2,"ل",2,0],["أَبونا الَّذي أَبدى بِصِفّينَ سَيفَهُ","ضُغاءَ اِبنِ هِندٍ وَالقَنا يَتَقَصَّفُ",3,"ف",1,0],["أَبوهُ أَبوهُ المُستَطيلُ بِنَفسِهِ","عَلى العِزِّ مَصروفاً بِهِ وَمُقَلَّدا",4,"د",2,0],["أَبوا أَن يُلِمَّ الذُلُّ مِنهُم بِجانِبٍ","وَما العِزِّ إِلّا لِلنُفوسِ الأَبِيَةِ",5,"ه",1,0],["أَبوه عُلَيمِيُّ النِّجارِ وَأُمُّهُ","أَبوها زُهَيريٌّ نَماهُ عَرينُ",6,"ن",1,0],["أَبُوهُمْ مُعاويُّ النِّجارِ وَأُمُّهُمْ","مُقابَلَةُ الأَعْراقِ في آلِ غامِدِ",7,"د",1,0],["أبو عَليٍّ لهُ في خِندِفٍ شَرَفٌ","لَفَّ العُلا منهُ مَوْروثاً بمَكْسوبِ",8,"ب",1,0],["أبوكَ وأنتَ السّابِقانِ إِلى العُلا","على شِيَمٍ منْهُنَّ حَزْمٌ ونائِلُ",9,"ل",1,0],["أبَوْا غَيرَ طَعْنٍ يَخْطِرُ الموتُ دونَهُ","ويَشفي غَليلَ المَشْرَفيِّ بِها الضَّرْبُ",10,"ب",1,0],["أبوكَ وَليُّ العَهْدِ لوْ سالَمَ الرّدَى","وجَدُّكَ قد فاقَ المُلوكَ وإنْ فاقُوا",11,"ق",3,0],["أبوحُ بما أُخْفي وليْسَ بنافِعي","ولكِنّها شَكْوَى الى اللّهِ تُرْفَعُ",12,"ع",1,0],["أَبُو يَحْيَى وَحَسْبُكَ مِنْ حَيِيٍّ","وَفِيٍّ بِالْعُهُودِ عَلَى التَّمَامِ",13,"م",1,0],["أَبُو يُوسُفٍ مُفْنِي الْعِدَى نَاصِرُ الْهُدَى","وَيُوسُفُ مِطْعَانُ الْهِيَاجِ زَعِيمُهُ",14,"م",2,0],["أَبُو تَاشَفِينٍ حَدُّهَا وَحُسَامُهَا","فَقَدْ صَحَّ مِنْهَا الْحَدُّ فِي الْمَجْدِ وَالرَّسْمُ",15,"م",1,0],["أبو عِنانِ خيْرُ مُسْتخلَفٍ","أصْلَحَ منْ أمْر الوَرى ما فَسَدْ",16,"د",1,1],["أَبو بَحرٍ أَشدُّ الناسِ مَنّاً","عَلَينا بَعدَ حَيِّ أَبي المُغيرَه",17,"ر",2,1],["أَبو مالِكٍ خَيرُ أَشياعِنا","إِذا عَدَّتِ النَفسُ أَقتارَها",18,"ر",3,0],["أَبو الفَضلِ وَاِبنُ الفَضلِ أَنتَ وَتُربُهُ","فَغَيرُ بَديعٍ أَن يَكونَ لَكَ الفَضلُ",19,"ل",1,1],["أَبوهُ الَّذي فَلَّ غَربَ الضَلالِ","وَلاءَمَ شَعبَ الهُدى فَاِلتَأَم",20,"م",1,0],["أَبو الوَليدِ قَدِ اِستَوفى مَناقِبَهُم","فَلِلتَفاريقِ مِنها فيهِ مُجتَمَعُ",21,"ع",1,0],["أَبوكُم تَلافى يَومَ نَقعاءَ راهِطٍ","بَني عَبدِ شَمسٍ وَهيَ تُنفى وَتُقتَلُ",22,"ل",1,0],["أَبوكُم تَلافى قُبَّةَ المُلكِ بِعدَما","هَوى سَمكَها وَغَيَّرَ الناسُ حالَها",23,"ل",3,0],["أَبوكَ حَمى أُمَيَّةَ حِينَ زالَت","دَعائِمُها وَأَصحَرَ لِلضِّرابِ",24,"ب",1,0],["أَبوكَ أَبو العاصي فَمَن أَنتَ جاعِلٌ","إِلَيهِ وَبَعضُ الوَالِدَينِ نَجيبُ",25,"ب",1,0],["أَبوكَ الذِي لَمّا أَتى مَرجَ راهِطٍ","وَقَد أَلَّبوا لِلشَّرِّ فيمَن تَأَلَّبا",26,"ب",2,0],["أَبو حَسّانَ كانَ ثِمالَ قَومي","فَأَصبَحَ ثاوِياً بَينَ اللَحودِ",27,"د",1,0],["أَبُوكِ سُلْطَانٌ وَمَنْ فِي عَصْرِهِ","ضَارِعَ ذَاكَ المُحْسِنِ السَّرِيا",28,"ي",2,0],["أَبُو حَسَنٍ أَصْفَى الرِّفَاقِ سرِيرَةً","وَأَوْفَاهُمُ عَهْداً عَلَى القُرْبِ وَالنَّأْيِ",29,"ي",1,1],["أَبو تُرابٍ حَيدَرَه","ذاكَ الاِمامُ القَسوَرَه",30,"ه",1,1],["أَبوهُمُ أَسمَرُ في لَونِهِ","وَالقَومُ في أَلوانِهِم شُقرَه",31,"ر",2,0],["أَبوكَ الَّذي كانَ اِقشَعَرَّ لِفَقدِهِ","ثَرى أَبطَحٍ سادَ البِلادَ حَرامِ",32,"م",1,0],["أَبو موسى فَحَسبُكَ نِعمَ جَدا","وَشَيخُ الرَكبِ خَالُكَ نِعمَ خالا",33,"ل",2,0],["أَبوكَ تَلافى الدَين وَالناسَ بَعدَما","تَشاءَوا وَبَيتُ الدينِ مُنقَطِعُ الكَسرِ",34,"ر",1,0],["أَبونا إِياسٌ قَدَّنا مِن أَديمِهِ","لِوالِدةٍ تُدهي البَنينَ وَتُذكِرُ",35,"ر",1,0],["أَبو شَعل وَمَسعودٌ وَسَعدٌ","يُروَوَّنَ المُذَرَّبَةَ الجِزارا",36,"ر",2,0],["أبوك ترامت فيه سفرة راحل","إلى الموت لا يرجى له يومُ مَقْدَم",37,"م",1,0],["أبو غازي قضى فاقيم غازي","فأنطَقنا التهاني والتعازي",38,"ي",1,1],["أبوه جبران أفناه الردى فغدا","من بعده رهن يتم حلف أشجان",39,"ن",1,0],["أبو علي قويّ في عزائمه","لو رام بالعزم دحر الجيش لا ندحرا",40,"ر",2,0],["أبو أن يحيدوا ضلّة عن طريقها","وإن مسّهم من أجلهن لغوب",41,"ب",1,0],["أَبوكَ التَيمُ لَيسَ بِخِندِفِيٍّ","أَرابَ سَوادُ لَونِكُمُ أَرابا",42,"ب",2,0],["أَبونا مالِكٌ وَأَبوكَ تَيمٌ","فَهَل تَيمٌ لِذي حَسَبٍ نَديدُ",43,"د",1,0],["أَبونا أَبو إِسحاقَ يَجمَعُ بَينَنا","أَبٌ كانَ مَهدِيّاً نَبِيّاً مُطَهَّرا",44,"ر",2,0],["أَبونا خَليلُ اللَهِ وَاللَهُ رَبُّنا","رَضينا بِما أَعطى الإِلاهُ وَقَدَّرا",44,"ر",2,0],["أَبو مَنزِلِ الأَضيافِ يَغشَونَ نارَهُ","وَيَعرِفُ حَقَّ النازِلينَ جَريرُ",45,"ر",1,0],["أَبونا مالِكٌ وَأَبوكَ تَيمٌ","فَقَد عُرِفَ الأَغَرُّ مِنَ البَهيمِ",46,"م",1,0],["أَبونا أَبوكُم وَالأَواصِرُ بَينَنا","قَريبٌ وَلَم نَأمُر مَنيعاً لِيَأثَما",47,"م",2,0],["أَبوهُ أَبي وَالأُمَّهاتُ اُمَّهاتُنا","فَأَنعِم فَدَتكَ النَفسُ قَومي وَمَعشَري",48,"ي",1,0],["أبونا الذي سَنَّ المئين لقومه","ديات وعدَّاها سلوفاً منيبها",49,"ب",3,0],["أبوها أبي الأدنى وأمِّي أمتُها","فمن أين رابتني وكيف أريبها",49,"ب",3,0],["أبوك أبو الخير ابن عائشة التي","دعت عمها من آل برة خالها",50,"ه",2,1],["أَبو الفَيضِ مارى الناسَ حَولاً مُجَرَّماً","وَكانَ لَهُ جَدٌّ مِنَ القَومِ مائِرُ",51,"ر",1,0],["أَبوكُم أَلأَمُ الآباءِ قِدماً","وَأَولادُ الخَبيثِ عَلى مِثالِ",52,"ل",1,0],["أَبوكَ مُذَمَّمٌ وَخُلِقتَ مِنهُ","عَلى قَدَرٍ كَما قُدَّ الشِراكَ",53,"ك",1,0],["أَبوكَ أَبو الفَعالِ أَبو بَراءٍ","وَخالُكَ ماجِدٌ حَكَمُ بنُ سَعدِ",54,"د",1,0],["أَبوكَ أَبوكَ وَأَنتَ اِبنُهُ","فَبِئسَ البُنَيُّ وَبِئسَ الأَبُ",55,"ب",1,1],["أَبو صَيفي الَّذي قَد كانَ مِنها","وَمَخرَمَةُ الدَعِيُّ المُستَهامُ",56,"م",1,0],["أَبوكَ لَقيطٌ أَلأَمُ الناسِ مَوضِعاً","تَبَنّى عَلَيكَ اللُؤمَ في كُلِّ مَشهَدِ",57,"د",1,0],["أَبوهُ حينَ يُنسَبُ أَو يُحامي","فَلَيسَ لَدى المَكارِمِ بِالمُسامي",58,"م",2,0],["أَبو أَمِّها أَوفى قُرَيشٍ بِذِمَّةٍ","وَأَعمامُها إِمّا سَأَلتَ ثَقيفُ",59,"ف",1,0],["أَبوكَ أَبو سوءٍ وَخالُكَ مِثلُهُ","وَلَستَ بِخَيرٍ مِن أَبيكَ وَخالِكا",60,"ك",2,1],["أبواب سلطاننا خصت بأربعة","تفرَّدوا في صفاتٍ وفق مذهبه",61,"ه",1,1],["أبواب خير الملوك لا برحت","أركان حجّ وحطّ أحلاس",62,"س",1,0],["أبوك بأرضِ الشام أصل إقامتي","فأكرم مقاماً كانَ أصلك أصله",63,"ه",1,0],["أبوك سقى الغمام أباك حتَّى","دعيت إذاً علياً في الغمام",64,"م",1,0],["أبوجه ذاك ووجه تلكَ تُقيسه","قسماً لقد أخطأت من وجهين",65,"ن",1,0],["أبو الحسين معجب برائِهِ","لا يقبل الشُّورى منَ اَصْدقائِهِ",66,"ا",3,1],["أبو حسنٍ وأبو مثلهِ","كَنِيَّا أبي حسنٍ ثالثِ",67,"ث",1,0],["أبو عيسى العلاءُ فتى المعالي","فداهُ كلُّ من ولدَ الإناثُ",68,"ث",1,0],["أبوَجْهٍ كأنه وجهُ قردٍ","حائلُ اللون خامدُ المصباحِ",69,"ح",1,0],["أبو أحمدٍ ليثُ البلاد وغيثها","إذا حطْمَةٌ لم تُبق في العظم منقخا",70,"خ",2,0],["أبو عليِّ ابنُ أبي قرَّهْ","أبو عييّ ابنُ أبي عُرَّهْ",71,"ر",2,1],["أبو عثمان والرومي","يُ من غاشِيَة القصْرِ",72,"ر",1,1],["أبو بكرٍ أبو بكرٍ","أبو بكرٍ أبو بكرِ",72,"ر",1,0],["أبو البرق أبو الرعدِ","أبو الريح أبو القطر",72,"ر",1,0],["أبو الحَزم أو العَزم","أبو الدَّهْي أبو المكر",72,"ر",1,0],["أبوْا عيبَ من لا عيبَ فيه وإنهم","على عيبها عندي لجِدُّ حِراص",73,"ص",1,0],["أبو سليمان ذو الإصابة وال","إحسان وابن الملوك لا السوَق",74,"ق",1,0],["أبوكَ المُقعَدُ المعتوهُ أدنى","إليك اللُّؤمَ والعقلَ الركيكا",75,"ك",2,0],["أبو القاسم المقسومُ في الناس عَوْنُهُ","إذا اقتسم الآفاقَ خوفٌ وإمحالُ",76,"ل",1,0],["أبوه بلبلٌ ضاوٍ ويُكْنى","أبا صقرٍ فكنيتهُ مُحالَهْ",77,"ل",2,1],["أبو حسن ذو الحسنِ والخيرِ منظراً","ومُختبراً أعلى وأسنى وأجْملُ",78,"ل",1,0],["آبوا بحظٍّ بلا إثم وكم صدروا","عن آخرين بحرمان وآثامِ",79,"م",1,0],["أُبوَّة آباء إذا قِيسَ مجدُهُمْ","بشعرِكَ عفَّى منه تلك المحاسنا",80,"ن",2,0],["أبٌ وأمٌّ لهذا الخلقِ كلهمُ","كلاهُمَا شَرُّ مَقْرونٍ بمقرون",81,"ن",1,0],["أبُونا عندَ نِسْبتِنا أبوهم","عطاردٌ السماويُّ المكان",82,"ن",1,0],["أبو سليمان لا تُرضَى طريقتُهُ","لا في غناء ولا تعليم صبيانِ",83,"ن",1,1],["أبو سليمان شيطانٌ وكنيته","أبو سليمان أَمْناً من سليمان",83,"ن",1,0],["أَبوكَ أَبو العاصي عَلَيكُم تَعَطَّفَت","قُرَيشٌ لَكُم عِرنينُها وَصَميمُها",84,"م",3,0],["أَبو جَعدَةَ الذِئبُ الخَبيثُ طَعامُهُ","وَعَوفُ بنُ كَعبٍ كانَ أَكرَمَ أَوَّلا",85,"ل",2,0],["أَبوا أَن يَقيلوا إِذ تَوَقَّدَ يَومُهُم","وَقَد جَعَلَت عُفرُ الظِباءِ تَقيلُ",86,"ل",1,0],["آبو وَما آبَ العَزاءُ إِلَيهِمُ","وَالحُزنُ يُنظَم وَالمَدامِعُ يَنشُرُ",87,"ر",1,0],["أَبو غازي السَلامُ عَلَيكَ مِنّا","وَعَفواً أَيُّها المَلِكُ الهُمامُ",88,"م",1,1],["أَبوكَ الَّذي نَجّى بِيَثرِبَ قَومَهُ","وَأَنتَ المُفَدّى مِن بَنيهِ المَمَدَّحُ",89,"ح",1,0],["أَبوكَ الَّذي أَجدى عَلَيَّ بِنَصرِهِ","فَأَسكَتَ عَنّي بَعدَهُ كُلَّ قائِلِ",90,"ل",1,0],["أَبوكَ الَّذي آسى الخَليفَةَ بَعدَما","رَأى المَوتَ مِنهُ بِالمَدينَةِ وانِيا",91,"ي",2,0],["أَبوكَ حُبابٌ سارِقُ الضَيفِ بُردَهُ","وَجَدِّيَ يا شَمّاخُ فارِسُ شَمَّرا",92,"ر",2,1],["أَبوءُ بِذَنبي أَنَّني قَد ظَلَمتُها","وَإِنّي بِباقي سِرِّها غَيرُ بائِحِ",93,"ح",1,0],["ابو الشعب اما سار سار وراءه","كظل له ما ان يحيد عن القصد",94,"د",1,0],["أبوك قد كان ليثاً","وأنت لليث شبل",95,"ل",1,0],["أبوا في محنة الأخلاق إلا","لياذا في العقيدة وأمتناعا",96,"ع",2,0],["أبوّة سؤدد أخذت","بقرن الشمس تزحمه",97,"م",2,0],["أبوك في مكة دار لهم","وأنت في المجلس للدار باب",98,"ب",1,0],["أبوك زاد الله في قدره","قد جاءني بالأمس منه كتاب",98,"ب",1,0],["أبوّة المصطفى ما زال يلبسها","حر قشيب شباب الفخر ضافيها",99,"ي",3,0],["أَبوهُ هَضبةُ العُلا الشَماء","وَأُمُّهُ في الشرف السماء",100,"ا",2,0],["أَبو الحُصَينِ جالَ في السَفينَه","فَعَرَفَ السَمينَ وَالسَمينَه",101,"ه",1,1],["أَبولّو مَرحَباً بِكِ يا أَبولّو","فَإِنَّكِ مِن عُكاظِ الشِعرِ ظِلُّ",102,"ل",1,1],["أَبو الفاروقِ نَرجوهُ لِفَضلٍ","وَلا نَخشى لِما وَهَبَ اِرتِدادا",103,"د",2,0],["أَبَوا حَسَداً أَن أَجعَلَ الحَيَّ أُسوَةً","لَهُم وَمِثالاً قَد يُصادِفُ حاذِيا",104,"ي",2,0],["أَبوابُكَ اللاتي قَصَدنا قَصدَها","كارتِرُ في وَجهِ الوُفودِ رَدَّها",105,"د",3,0],["أُبُوَّةٌ لَو سَكَتنا عَن مَفاخِرِهِم","تَواضُعاً نَطَقَت صَخراً وَصَوّانا",106,"ن",2,0],["أُبُوَّتُنا وَأَعظَمُهُم تُراثٌ","نُحاذِرُ أَن يَؤولَ لِآخَرينا",107,"ن",2,0],["أَبو المِسكِ لا يَفنى بِذَنبِكَ عَفوُهُ","وَلَكِنَّهُ يَفنى بِعُذرِكَ حِقدُهُ",108,"د",2,0],["أَبو شُجاعٍ أَبو الشُجعانِ قاطِبَةً","هَولٌ نَمَتهُ مِنَ الهَيجاءِ أَهوالُ",109,"ل",1,0],["أَبوكُم آدَمٌ سَنَّ المَعاصي","وَعَلَّمَكُم مُفارَقَةَ الجِنانِ",110,"ن",1,0],["أَبو بَكرٍ فَكَم آسى جَريحاً","وَكَم عَمَّ الأَعِلّا بِالشِفاءِ",111,"ا",2,0],["أَبوكَ أَطفَأَ نارَ الحَربِ إِذ كَشَرَت","شَنعاءَ مَذروبَةً أَنيابُها غَضَفا",112,"ف",2,0],["أَبو العَبّاسِ أَخلَقُ لِلمَساعي","بِحَقِّ الطولِ وَالباعِ الطَويلِ",113,"ل",1,0],["أَبوهُ البَحرُ ساحَ لَنا نَداهُ","فَفاضَ وَأُمُّهُ ماءُ الغَمامِ",114,"م",1,0],["أَبَوا أَن يَذوقوا العَيشَ وَالذَمُّ واقِعٌ","عَلَيهِ وَماتوا مَيتَةً لَم تُذَمَّمِ",115,"م",1,0],["أَبوكَ الَّذي غالى عَلِيّاً مُساوِماً","بِسامَةَ لَمّا رَدَّ سامَةَ في جَرمِ",116,"م",1,0],["أُبُوَّتُهُ مِنها خَلائِفُها الأُلى","لَها فَضلُها في النائِباتِ وَخيمُها",117,"م",3,0],["أَبو حَسَنٍ وَما لِلدَهرِ حَليٌ","سِوى آثارِهِ الحَسَناتِ فينا",118,"ن",2,0],["أَبو العَطّافِ عِندَكَ حَيثُ يُرضى","لَهُ شَرَفُ المَحَلَّةِ وَالمَكانِ",119,"ن",1,0],["أَبِوَهبِهِ وَسَعيدِهِ أَم قَيسِهِ","وَحُصَينِهِ أَم عَمرِهِ وَقَنانِهِ",120,"ن",2,0],["أَبو عَلِيٍّ خَيرُ مَن يُرتَجى","في شِدَّةِ الدَهرِ وَفي لينِهِ",121,"ن",2,0],["أَبو غالِبٍ بِالجودِ يَذكُرُ واجِبي","إِذا ما غَبِيُّ الباخِلينَ نَسيهِ",122,"ي",2,0],["أَبوكَ الَّذي جاءَ ما قَد عَلِم","تَ فَصارَت لَهُ سُنَّةٌ جارِيَه",123,"ي",2,0],["أَبوهُ أَبوهُم في ذَراهُم وَأُمُّهُ","إِذا اِنتَسَبَت مِن ماجِداتِ نِسائِها",124,"ا",3,0],["أَبوهُ الَّذي قالَ اِقتُلوهُ فَإِنَّني","سَأَمنَعُ عِرضي أَن يُسَبَّ بِهِ أَبي",125,"ب",2,0],["أَبوكَ وَعَمّي يا مُعاوِيَ أَورَثا","تُراثاً فَيَحتازُ التُراثَ أَقارِبُه",126,"ب",2,0],["أَبوكَ وَعَمّي يا مُعاوِيَ أَورَثا","تُراثاً فَأَولى بِالتُراثِ أَقارِبُه",127,"ب",2,1],["أَبوهُ أَبو موسى خَليلُ مُحَمَّدٍ","وَكَفّاهُ غَيثٌ مُستَهِلُّ الأَهاضِبِ",128,"ب",1,0],["أَبوكَ الَّذي كانَت لُؤَيُّ بنُ غالِبٍ","لَهُ مِن نَواصيها الصَريحُ المَهَذَّبُ",129,"ب",1,0],["أَبوها الَّذي أَدنى النَعامُةَ بَعدَما","أَبَت وائِلٌ في الحَربِ غَيرَ تَمادِ",130,"د",1,0],["أَبوكَ الَّذي تُستَهزَمُ الخَيلَ بِاِسمِهِ","وَإِن كانَ مِنها سَيرُ شَهرٍ مُطَرَّدِ",131,"د",1,0],["أَبوهُ اِبنُ أَوتادِ الخِلافَةِ وَالَّذي","بِهِ لِقُرَيشٍ كانَ تَجري سُعودُها",132,"د",3,0],["أَبوكَ جُنوداً بَعدَما مَرَّ مُصعَبٌ","تَفَلَّذَ عَنهُ وَهوَ يَدعو كَثيرُها",133,"ر",3,0],["أَبَوا أَن يَفِرّوا يَومَ كُرَّ عَلَيهِمُ","وَلا يَقتُلَ الأَبطالَ إِلّا كَرورُها",134,"ر",3,0],["أَبوا أَن يَغدِروا وَأبى أَبوهُم","حَنيفَةَ أَن يُوازَنَ يَومَ فَخرِ",135,"ر",1,0],["أَبوكُم أَبو العاصي الَّذي كانَ جارُهُ","أَعَزَّ مِنَ العَصماءِ فَوقَ النَفانِفِ",136,"ف",1,0],["أَبوهُ أَبو العاصي وَحَربٌ تَلاقَيا","إِلَيهِ بِمَجدِ الأَكرَمينَ الغَطارِفِ",137,"ف",1,0],["أَبوكَ أَميرُ المُؤمِنينَ الَّذي بِهِ","رَحىً ثَبَتَت ما يُستَطاعُ زِيالُها",138,"ل",3,0],["أَبوكَ الَّذي تَدعو الفَوارِسُ بِاِسمِهِ","إِذا خَطَرَت يَوماً أَسِنَّتُها بَسلا",139,"ل",2,0],["أَبوكُم أَبو العاصي الَّذي كانَ يَنجَلي","بِهِ الضَوءُ عَمَّن كانَ بِاللَيلِ أَظلَما",140,"م",2,0],["أَبَوا أَن أَسومَ الناسَ إِلّا ظُلامَةً","وَكُنتُ اِبنَ مِرغامِ العَدُوِّ ظَلومِ",141,"م",1,0],["أَبوكَ الَّذي ما كانَ في الناسِ مِثلُهُ","إِذا نَزَلَت بِالمِصرِ إِحدى الصَيالِمِ",142,"م",1,0],["أَبونا خَليلُ اللَهِ وَاِبنُ خَليلِهِ","أَبونا أَبو المُستَخلَفينَ الأَكارِمِ",143,"م",1,0],["أَبوكَ أَبو العاصي وَحَربٌ كِلاهُما","أَبو الخُلَفاءِ المُصطَفَينَ الأَكارِمِ",144,"م",1,0],["أَبَوا أَن أَسومَ الناسَ إِلّا ظُلامَةً","وَكُنتُ اِبنَ ضِرغامِ العَدُوِّ ظَلومِ",145,"م",1,0],["أبونا أبو اللَّفظِ البديعِ عُطارِدٌ","تَجيشُ له بالمُعجِزاتِ الخَواطِرُ",146,"ر",1,0],["أبوك الذي سقَّى الحَجِيجَ ولم يَزَلْ","بمكَّةَ يَروي رَكْبَها ورِكابَها",147,"ب",3,0],["أَبو الحُسَين فَاِعلَمَن أَبو الحَسَن","قَد جاكَ تَقتادُ العَنانَ وَالرَسَن",148,"ن",1,0],["أَبوكَ مَدَّتْ عليهم كفُّ رأفتِهِ","منها جناحاً مديداً ظلّه خَصِرُ",149,"ر",1,0],["أَبوكَ أَصابَ الرُشدَ فيها بِرَأيِهِ","وهَدَّ بِها رُكْنَ العِدَى أَيَّما هَدِّ",150,"د",1,0],["أبوكِ الذي من غرسه طالتِ العُلى","وأُسْنِدَ عامُ المحْل فيِه إِلى الخِصبِ",151,"ب",1,0],["أَبو مَنزِلِ الهَمِّ الَّذي لَو بَغى القِرى","لَدى حاتِمٍ لَم يُقرِهِ وَهوَ طائِعُ",152,"ع",1,0],["أَبِوَجهٍ لَهُ طَلاقَةُ ذي الإِح","سانِ أَم وَجهِ غَيرِ ذي إِحسانِ",153,"ن",1,0],["أَبو الحُسَينِ ضِياءٌ لامِعٌ وَهُدىً","ما خامَ في مَشهَدٍ يَوماً وَلا سَئِما",154,"م",2,0],["أَبوكَ شَقيقٌ لَم يَزَل وَهوَ لِلنَدى","شَقيقٌ وَلِلمَلهوفِ حِرزٌ وَمَعقِلُ",155,"ل",1,0],["أَبو النُجومِ الَّتي ما ضَنَّ ثاقِبُها","أَن لَم يَكُن بُرجُهُ ثَورٌ وَلا حَمَلُ",156,"ل",1,0],["أَبو عَلِيٍّ وَسمِيُّ مُنتَجِعِه","فَاِحلِل بِأَعلى واديهِ أَو جَرَعِه",157,"ع",2,1],["أَبو عَلِيٍّ أَخلاقُهُ زَهَرٌ","غِبَّ سَماءٍ وَروحُهُ قُدسُ",158,"س",1,0],["أَبُو الْمَجْدِ نَجْلُ الْجَوْدِ خَالُ زَمَانِهِ","أَخُو الْفَخْرِ إِسْمَاعِيلُ خِدْنُ الْمَكَارِمِ",159,"م",1,0],["أبوظبيٍ بما أخذت وأعطت","عروسٌ مهرُها نارٌ وقود",160,"د",1,0],["أَبو أُمِّها أَوفى قُرَيشٍ بِذِمَّةٍ","وَأَعمامُها إِما نَسَبتَ ثَقيفُ",161,"ف",1,0],["أَبوءُ بِعِبءِ السُقمِ بَينَ حُشاشَةٍ","تَجودُ وَجِسمٍ قَد تَفَرَّقَ ناحِلِ",162,"ل",1,0],["أَبوسُ تُرابَ رِجلَكِ يا لِوَيلي","وَلَولا ذاكَ لا أُدعى مُصابا",163,"ب",2,1],["أبَوْا لِبلادِهم إلا حياةً","تَشُقُّ على القَويِّ إذا استبدّا",164,"د",2,0],["أبَوْا في غيرِ ما أشَرِ","سوى الأملاكِ خُدّاما",165,"ا",1,0],["أبَوْا أن يُعبَدَ الطّاغوتُ فيه","وأن يتخطّفَ الأرضَ اغتصابا",166,"ب",2,0],["أبَوْا أن يكونَ الملكُ نِحلةَ مُفْسِدٍ","تُساقُ عَطاياهُ وتُزْجَى القطائعُ",167,"ع",1,0],["أَبوثبةِ البَقّالِ بَينَ سلالِهِ","أَم نَزوَةِ الخَمّارِ ساعَةَ يَشرَبُ",168,"ب",1,0],["أَبَوا أَن يَكُفَّ المَشرَفِيّاتِ حِلمُها","أَفالآنَ لَمّا اِستَجهَلَتها المَلاحِمُ",169,"م",1,0],["أَبو الخَلائِفِ ذو النورَينِ مورِثُنا","مُلكَ الهِلالِ وَهَذا المَجدَ وَالحَسَبا",170,"ب",2,0],["أَبَوا إِلّا النُفوسَ فَما اِستَطَعنا","سِوى شَكوى الضِعافِ العاجِزينا",171,"ن",2,0],["أبَوْا أن يُؤدُّوا الحقَّ واهْتاجَ جَمعُهُم","فَعَبَّ عُبابُ البغيِ وَاحْتَدَمَ الشّرُّ",172,"ر",1,0],["آبوا بخيرٍ وآبتْ كلُّ طائفةٍ","من الأُلى كَرِهوا الحُسْنَى بِخُسرانِ",173,"ن",1,0],["أبَوْا فأذاقَهم منه عَذاباً","غَراماً ما لدائِبهِ انْصِرامُ",174,"م",1,0],["أَبَوْا أن يقعدوا والجيشُ يُزجَى","فَيُوشِكُ أن يكونَ له انْطِلاقُ",175,"ق",1,1],["آبوا إلى خيرِ دارٍ ما لِنازِلِها","من أوْبَةٍ تبعثُ الأشجانَ أو قَفَلِ",176,"ل",1,0],["أَبَوْا وَتَولَّوا يَشترُونَ نُفُوسَهم","بأموالِهِم هذا هو الغَبْنُ والخُسْرُ",177,"ر",1,0],["أبَوْا أن يَذوقَ القتلَ إلا بمكةٍ","وإنّ له عمّا قريبٍ لَمَوْعِدَا",178,"د",2,0],["أَبَوْا أن يُجِيبوا دَاعِيَ اللَّهِ وَابْتَغُوا","سَبِيْلَ الألى أعماهُمُ الحِقْدُ والغِلُّ",179,"ل",1,0],["أَبَوْها جِزيةً ثَقُلَتْ عليهم","وقالوا بئسما يرضى الذّليلُ",180,"ل",1,0],["أَبو طالِبٍ في كَفِّهِ وَبِخَدِّهِ","أَبو لَهَبٍ وَالقَلبُ مِنهُ أَبو جَهلِ",181,"ل",1,1],["أَبوكَ بَني العَليا وَأَنتَ شَدَدتَها","بِمَجدٍ يُقَوّي ما بَنى وَيُشاكِلُه",182,"ل",2,0],["أَبوكَ رَبيعَةَ الخَيرِ بنِ قُرطٍ","وَأَنتَ المَرءُ تَفعَلُ ما تَقولُ",183,"ل",1,1],["أَبَوا لِشَقائِهِم إِلّا اِبتِعاثي","وَمِثلي ذو العُلالَةِ وَالمَتانِ",184,"ن",1,0],["أَبوهُم وَدى عَقلَ المُلوكِ تَكَلُّفاً","وَما لَهُمُ مِمّا تَكَلَّفَهُ بُدُّ",185,"د",1,0],["أَبَوا غَيرَ ضَربٍ يَجثُمُ الهامُ وَسطَهُ","وَطَعنٍ كَأَفواهِ المُزَقَّقَةِ الحُمرِ",186,"ر",1,0],["أَبَوا أَن يُقيموا لِلرِماحِ وَشَمَّرَت","شَغارِ وَأَعطَوا مُنيَةً كُلَّ ذي رَجلِ",187,"ل",1,0],["أَبوكَ رَبيعَةُ الخَيرِ اِبنِ قُرطٍ","وَأَنتَ المَرءُ تَفعَلُ ما تَقولُ",188,"ل",1,1],["أَبو الفَضلِ أَولى الناسِ بِالفَضلِ كُلَّهُم","تَعالَوا نُحاكِمكُم إِلى البَيتِ وَالحَجرِ",189,"ر",1,0],["أَبوكَ بَدرٌ تَلوحُ غُرَّتُهُ","وَأُمُّكَ الشَمسُ أَنتَجا قَمَرا",190,"ر",2,0],["أَبوكَ الَّذي لَم يَملِكِ الأَرضَ مِثلَهُ","وَعَمُّكَ موسى صِنوُهُ المُتَحَيِّرُ",191,"ر",1,0],["أَبٌ وَخالٌ لَم يَزَل مُرَأَّسا","تَخالُهُ العَينُ لِمَن تَفَرَّسا",192,"س",2,0],["أَبوهُ مِن أَكابِرِ قِبطِ مِصرٍ","تَسامى عَن مُناسَبَةِ النَبيطِ",193,"ط",1,0],["أَبوكَ شَبيرٌ فَأَكرِم بِهِ","وَفي اِستِكَ وِردٌ لِمَن تورِدُ",194,"د",1,0],["أَبوكَ الَّذي يُعطى عَلى ثَمَنِ اِستِهِ","وَأَنتَ المُرَجّى غَيرَ صافٍ لِمُنتَقَد",195,"د",1,0],["أَبوكَ أَبو العَبّاسِ جَلّى بِسَيفِهِ","وَأَنتَ المُرَجّى في قَرابَةِ أَحمَدا",196,"د",2,0],["أَبوكَ يَهودِيٌّ وَأُمُّكَ عِلجَةٌ","وَأَشبَهتَ خِنزيرَ السَوادِ المُسَيَّبا",197,"ب",2,0],["أَبوكَ إِذا غَدا خِنزيرُ حَشٍّ","وَأُمُّكَ كَلبَةٌ فيها بَذاءُ",198,"ا",2,0],["أَبوهُ قَبلَهُ وَأَبو أَبيهِ","بَنَوا مَجدَ الحَياةِ عَلى إِمامِ",199,"م",1,0],["أَبوَتُكَ يا إِثمي وَمَن لي بِأَنَّني","أَتَيتُكَ فَاِشكُر لا شَكَرتَ أُبُوَّتي",200,"ت",2,0],["أَبو نَعامَة بِالأَعدانِ مَولِدُهُ","فَكَيفَ أَصبَحَ مَعزوّاً إِلى قَطَرِ",201,"ر",1,0],["أَبوكَ جَنى شَرّاً عَلَيكَ وَإِنَّما","هُوَ الضَبُّ إِذ يُسدي العُقوقَ إِلى الحِسلِ",202,"ل",1,0],["أَبَوا دينَ المُلوكِ فَهُم لِقاحٌ","إِذا نُدِبوا إِلى حَربٍ أَجابوا",203,"ب",3,0],["أبوزع مُنّي عمركِ الله بالذي","سألتُ فقد كادت حشاي تَمَزَّع",204,"ع",1,0],["أبوكَ والطبعُ لا يحولُ","وَرِثْتَهُ خِلْقةً وخَلْقا",205,"ق",2,0],["أبوهم كما زعموا آدمٌ","وحواءُ أُمُّهمُ المُعْصِرُ",206,"ر",1,0],["أبوه ذو النور الجميل الجعدُ","ومرضعوه الفصحاء سعدُ",207,"د",1,0],["أَبَوا الخُروجَ إِلَيكَ مِن أَوهامِهِم","وَالناسُ في أَوهامِهِم سُجَناءُ",208,"ا",2,0],["أبو الشهابين وهل يخفى القمر","والثاقب الرأي اللعوب بالزّمر",209,"ر",1,0],["أَبُو جَعْفَرٍ رَجُلٌ كاتِبٌ","مَلِيح شَبا الخَطِّ حُلْوُ الخَطابَهْ",210,"ب",2,1],["أَبُو المَسِيحِ أَأَدْنَى مِنْ مَكَانتِهِ","فِي المَجْدِ إِنْ كَانَ نَجَّاراً وَمُحْتَرِفَا",211,"ف",2,0],["أَبُوكَ وَالنَّابِهُونَ المُقْتَدُونَ بِهِ","رَدُّوا إِلَى مِصْرَ ذَاكَ الفَتْحَ مُؤتَنَفَا",211,"ف",2,0],["أَبُوهُ جَلَّى قَدِيماً أَيَّ تَجْلِيَةٍ","وَعَادَ فَتَاهُ الْيَوْمَ بِالْقَصَبِ",212,"ب",1,0],["أَبُوكَ أَسْرَى الرِّجَالِ فِي بَلَدٍ","مَا زَالَ فِيهِ مَقَامُهُ الأَعْلَى",213,"ل",2,0],["أَبُوهُ عَالِي الْجَدِّ سَامِي الْحِجَا","وَأُمُّهُ الْجَوْزَاءُ أَوْ أَزْهَرُ",214,"ر",1,0],["أَبوكَ بَنَى صَرحاً عَلاَ فَاقْتَفَيْتَهُ","وَأَعْلَيْتَ مَا تَبْنِي عَلَى الْعَلَمِ الْفَرْدِ",215,"د",1,0],["أَبٌ وَلَكِنْ بِأَسْمَى مَا يُرَادُ بِهِ","وَلَوْ دَعَتْكَ رَسُولاً لَمْ يَكُنْ عَجَبُ",216,"ب",1,0],["أَبُوكَ غَداةَ الجِزعِ مِن أَرضِ مَسكَنٍ","يَؤُمُّ العِدا بِالجَمعِ بَعدَ المَقَانِبِ",217,"ب",1,0],["أَبُو هَيْثَمٍ أيضاً وَفيٌّ بمثلِهَا","وفاءً بمَا أَعْطَى مِنَ العَهْدِ خَانِعُ",218,"ع",1,0],["أَبوكَ بِالعَيشِ غَيرُ مُكتَرِثٍ","لَيسَ يُبالي أَعاشَ أَم هَلَكا",219,"ك",2,1],["أَبوكَ الَّذي حاكَ طَرزَ القَريض","وَلَو عِشتَ كُنتَ لَها أَحوَكا",220,"ك",2,0],["أَبوكَ يَدعوكَ غَداً","فَاِبرُز مِنَ الخُلدِ يَرَك",221,"ك",1,0],["أَبُو بَصيرٍ لَهُ نَبْرٌ لَوْ اتُّخِذَتْ","مِنْهُ السِّهَامُ لَكَانَتْ أَسْهُمَ النُّوَبِ",222,"ب",1,0],["أبو الحسنِ الْجَرّاحُ فخرُ بلادِهِ","وأكرمُ مَنْ يُرْجَى وأشرفُ من يُسْمَى",223,"م",2,0],["أَبَوْا على القسر أن يرضَوْا معاهدةً","بكل حرفٍ بها قيدٌ وسَجَانُ",224,"ن",1,0],["أَبُوكَ راشَ جَناحِي","حَتَّى لَمَسْتُ السحابا",225,"ب",2,0],["أبوك امرؤ من رجال الكلام","فكن أنت، يا ابني، امرأً عمليا",226,"ي",2,0],["أَبوا غير ضربٍ يحطمُ الهامُ وسطهُ","وطعنٍ كأفواه المرقَّعة ِ الحمر",227,"ر",1,0],["أَبُوكَ رَبيعَة ُ الخَيْرِ بنُ قُرْطٍ","وأ،ت المرءُ تفعلُ ما تقولُ",228,"ل",1,1],["أبُوكَ الذي يُعْطَى على ثَمَنِ اسْتِهِ","فَمَا نَفَعَ الخِنْزِيرَ مَا قَالَ كَاذِباً",229,"ب",2,0],["أبِوَهْبِهِ، وَسَعيدِهِ، أوْ قَيْسِهِ،","وَحُصَيْنِهِ، أَمْْ عَمرِهِ، وَقَنانِهِ",230,"ن",2,0],["أَبوك أَطْفَا نارَ الحربِ إِذْ كَشَرتْ","شَنْعاءَ مَذْرُوبةً أَنيابُها عَضََفَا",231,"ف",2,0],["أبو علي بن أبي قره","أبو عييّ بن أبي عُرَّهْ",232,"ر",2,1],["أبو أحمد ليثُ البلاد وغيثها","إذا حطْمَة ٌ لم تُبق في العظم منقما",233,"م",2,0],["أبُوك إِذا غدَا خِنْزيرُ وَحْشٍ","وأمُّكَ كلْبَة ٌ فِيهَا بَذاءُ",234,"ا",2,0],["أبوا ليلادهم إلا حياة","تشق على القوي إذا استبدا",235,"د",2,0]]}