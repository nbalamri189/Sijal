4%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""]],"verses":[["باقٍ بِها حَظُّ العُيونِ وَإِنَّما","لا حَظَّ فيها اليَومَ لِلآذانِ",0,"ن",1,0],["باقٍ تَخَطّاكَ كُلُّ نائِبَةٍ","إِلى العِدا وَالنَوازِلُ العُضُلُ",1,"ل",1,0],["باقِياً ما اِختَلَفَ النو","رُ عَلى الغُصنِ الرَطيبِ",2,"ب",1,0],["بأقْنى على أرْجائِهِ الدّمُ مائِرٌ","وحُجْنٍ حَكَتْ أطْرافَهنَّ نُصولُ",3,"ل",1,0],["بأقْدَمِ مَنْ يَمْضي إذا الخَيْلُ أحْجَمَتْ","وأحْلَمِ مَنْ يُغْضي وأكْرَمِ منْ يَقْري",4,"ر",2,0],["باقْتِرَابِ الْمَوْتِ عَلَّلْتُ نَفْسِي","بَعْدَ إِلْفِي كُلُّ آتٍ قَرِيبُ",5,"ب",1,0],["باقي الذَماءِ إِذا مَلَكتَ مُنافِلٌ","وَإِذا جَمَعتَ بِهِ أَجَشٌّ هَزيمُ",6,"م",1,0],["بَاقٍ بِهِ شَطْرُ رُوحٍ","يَبْكِي عَلَى شَطْرِ رُوحِهْ",7,"ح",2,0],["بِإِقْبَالِهِ بَهْجَةٌ لِلنُّفُوسِ","كَبَهْجَتِهَا وَالمُنَى تَبَسِمُ",8,"م",1,0],["باقٍ عَلى الأَين يُعطي إِن رَفَقتَ بِهِ","مَعجا رُقاقا وَإِن تَخرُق بِهِ يَخِدِ",9,"د",1,0],["بِأَقوالٍ يُجانِبنَ المَعاني","وَأَلسِنَةٍ يُخالِفنَ القُلوبا",10,"ب",2,0],["بِأَقلامِنا أُجحِرتَ أَم بِسُيوفِنا","وَأُسدَ الشَرى قُدنا إِلَيكَ أَمِ الكُتبا",11,"ب",2,0],["بأقلامهِ تُحمى البلادُ وتحتوى","فيا حبَّذا من تاجها ورتاجها",12,"ج",3,0],["باقِعَةً إن أنت خاطبتَهُ","أَعرَبَ أو فاكهتَهُ أغربا",13,"ب",2,0],["باقي كتابي بيدي","بان لمن سيفُ عَدِي",14,"ي",1,1],["بأقرب دارٍ لا أرى الدهرَ وجهَهُ","فيا بُعدَ مرآه ويا قُرْبَ داره",15,"ر",2,0],["باقٍ عَلى مَرِّ العُصورِ بَقائَها","وَكَذاكَ ذِكرُ ذَوي النُفوسِ السامِيَه",16,"ي",2,0],["باقٍ كَثَأرِ القُدسِ مِن قَبلِهِ","لا نَنتَهي مِنهُ وَلا يَبتَدي",17,"د",2,0],["بِأَقصى رِضانا أَن يَعَضَّ حَسودُهُ","عَلى رَغَمٍ في كَفِّ غَضبانَ آسِفِ",18,"ف",1,0],["بَأَقَبَّ يَعصي الكَفَّ ثُمَّ يُطيعُهُ","فَتَراهُ بَينَ تَسَرُّعٍ وَتَوانِ",19,"ن",1,0],["باقٍ على الدَّهرِ لا يخشَى غَوائلَهُ","ولا يخافُ من البَّاغين عُدوانا",20,"ن",2,0],["بأقَبَّ لا يَدَعُ الصّهيلَ إلى القَنا","حتى يلوكَ خِطامَها المتقصِّفا",21,"ف",2,0],["بَاقٍ عَلَى العَهْدِ","مَدَى الدَّهْرِ بِلاَ تَحَوُّلِ",22,"ل",1,0],["بَاقٍ وإِنْ هُوَ غَابَ سَاطِعُ نُورِهِ","حَتَّى يُكَادَ يَخَالُ لَيْسَ بِغَائِبِ",23,"ب",1,0],["باق على مرّ العصور بقاءها","وكذاك ذكر ذوي النفوس السامية",24,"ي",2,0],["باقي الذَّماءِ إذا ملكتَ مناقلٌ","وإذا جمعتَ بهِ أجَشُّ هزيمُ",25,"م",1,0],["بِإِقدامِكَ الإِسلامُ بِالعِزِّ مُرتَدٍ","وَجاحِدُ ما أَولَيتَهُ عَنهُ مُرتَدُّ",26,"د",1,0],["باقٍ عَلى الأَيّامِ يُخلِفُ ما تَوى","فيهِ إِذا وَعدُ الأَماني أَخلَفا",27,"ف",2,0],["بِأَقَلِّ حَظٍّ غادَرَت أَرحامَنا","جَذّاءَ بادِيَةَ الضَنا لِشكاتِها",28,"ت",3,0],["بإِقرارهِ كم صغتُ فيه قصيدةً","وَنوّعتُ في أمداحه النظم والنثرا",29,"ر",2,0],["بِأقربِ وَقتٍ أصبحت خير أُمّةٍ","فَضائلَ واِستَولت على غيرها قَهرا",30,"ر",2,0],["بأقبَّ ما طارتْ قوائمُهُ به","إلا اشتهى طَيَرانهنَّ التُّدْرج",31,"ج",1,0],["باق على عنت الخطوب وعسفها","مجد تقاصر دونه الأنظار",32,"ر",1,0],["بِإِقبالٍ تُجَدِّدُهُ اللَيالي","لِدَولَتِها وَتَخدِمُهُ الكَواكِب",33,"ب",1,0],["باقِياتٍ لَمْ تَخْلُ ما قَدُمَ الْعَهْ","دُ عَلَيْها مِنْ مَفْخَرٍ مُسْتَجَدِّ",34,"د",1,0],["باقة من زهرِ (الغو","طةِ) طلَّتها غمامه",35,"م",2,0],["باقٍ على حالِ العَطايا وقد","غَيَّرتِ الأيّامُ أحْوالها",36,"ل",3,0],["بأقضَى قضاةِ الدَّهرِ أَعزَزْتُ جانبي","فأحجَم عنّي صَرْفُه وهْو صاغر",37,"ر",1,0],["بأقلامٍ من الخَطِّيِّ خَطَّت","صحائِفَ ما فُهمنَ ولا قُرِينا",38,"ن",2,0],["بأقطاعهم ما حرم اللّه أخذه","فسحقاً وبعداً بعد ذا للأكابر",39,"ر",1,0],["بِأَقيال قَحطان وَأساد عامِر","وَفُرسان كَلب كالوَشيج الموشَّجا",40,"ج",2,0],["باقاتلي وجداً ومانح مقلتي","سهداً وأصبح نازلاً بجناني",41,"ن",2,0],["باق على الآياد مثل بقائه","قبلا وتلك حياته كحياتي",42,"ت",2,0],["باق نعم أنا في ولائي الباقي","أحيا بوحي جنانيَ الخلاق",43,"ق",1,1],["بأقوالكم وبأفعالكم","وما كلّ من قال بالفاعلِ",44,"ل",1,0],["باقياتٍ وقد جررنَ عليهن","نَ الليالي معدودةً والشهورا",45,"ر",2,0],["باقيات في الدهر ما بقيَ الده","رُ وناصى رضوَى أخاه ثبيرا",45,"ر",2,0],["باقٍ يخافُ الحتفَ وهو متى يَمُتْ","فله مَعادٌ عاجلٌ ونشورُ",46,"ر",1,0],["بأقمار ليلٍ والترائك هالها","أسود أقلّتها من 