{"poems":[[53,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[63,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[77,"صحت بالربع فلم يستجيبوا","https://www.aldiwan.net/poem36717.html","المديد"],[35,"أمن آل قيلة بالدخول رسوم","https://www.aldiwan.net/poem39086.html","الكامل"],[93,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[93,"ترى تعرف الشمس من ذا تشبه","https://www.aldiwan.net/poem11385.html","المتقارب"],[30,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[47,"ندل على موالينا ونجفو","https://www.aldiwan.net/poem25363.html","الوافر"],[47,"أتزعم ياضخم اللغاديد أننا","https://www.aldiwan.net/poem25367.html","الطويل"],[72,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"باقي كتابي بيدي","https://www.aldiwan.net/poem11451.html","مجزوء الرجز"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[85,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[45,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[105,"صونوا الذمام فإن الحر من صانا","https://www.aldiwan.net/poem42047.html","البسيط"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[91,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[35,"أمِنَ آلِ قَيلَة َ بالدَّخُولِ رُسُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=22153",""],[144,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[144,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[170,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[199,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[227,"ذكرى سعد","https://www.aldiwan.net/poem24223.html","عموديه"],[236,"سحاب الجود هامي الودق ساكب","https://www.aldiwan.net/poem32185.html","الوافر"],[281,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[299,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[365,"قل لأمين الملك عن عبده","https://www.aldiwan.net/poem60799.html","السريع"],[365,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[372,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[404,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[407,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[430,"يا صاحبي من الملام دعاني","https://www.aldiwan.net/poem40502.html","الكامل"],[454,"هذا الوجود كما تراه فلم يكن","https://www.aldiwan.net/poem61321.html","الكامل"],[454,"باق نعم أنا في ولائي الباقي","https://www.aldiwan.net/poem61566.html","الكامل"],[459,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"ومؤمر بين الرجال مقدم","https://www.aldiwan.net/poem56167.html","الكامل"],[465,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[552,"عليك ولي نعمتنا سلامي","https://www.aldiwan.net/poem47215.html","الوافر"],[554,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[576,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["باقٍ بِها حَظُّ العُيونِ وَإِنَّما","لا حَظَّ فيها اليَومَ لِلآذانِ",0,"ن",1,0],["باقٍ تَخَطّاكَ كُلُّ نائِبَةٍ","إِلى العِدا وَالنَوازِلُ العُضُلُ",1,"ل",1,0],["باقِياً ما اِختَلَفَ النو","رُ عَلى الغُصنِ الرَطيبِ",2,"ب",1,0],["بأقْنى على أرْجائِهِ الدّمُ مائِرٌ","وحُجْنٍ حَكَتْ أطْرافَهنَّ نُصولُ",3,"ل",1,0],["بأقْدَمِ مَنْ يَمْضي إذا الخَيْلُ أحْجَمَتْ","وأحْلَمِ مَنْ يُغْضي وأكْرَمِ منْ يَقْري",4,"ر",2,0],["باقْتِرَابِ الْمَوْتِ عَلَّلْتُ نَفْسِي","بَعْدَ إِلْفِي كُلُّ آتٍ قَرِيبُ",5,"ب",1,0],["باقي الذَماءِ إِذا مَلَكتَ مُنافِلٌ","وَإِذا جَمَعتَ بِهِ أَجَشٌّ هَزيمُ",6,"م",1,0],["بَاقٍ بِهِ شَطْرُ رُوحٍ","يَبْكِي عَلَى شَطْرِ رُوحِهْ",7,"ح",2,0],["بِإِقْبَالِهِ بَهْجَةٌ لِلنُّفُوسِ","كَبَهْجَتِهَا وَالمُنَى تَبَسِمُ",8,"م",1,0],["باقٍ عَلى الأَين يُعطي إِن رَفَقتَ بِهِ","مَعجا رُقاقا وَإِن تَخرُق بِهِ يَخِدِ",9,"د",1,0],["بِأَقوالٍ يُجانِبنَ المَعاني","وَأَلسِنَةٍ يُخالِفنَ القُلوبا",10,"ب",2,0],["بِأَقلامِنا أُجحِرتَ أَم بِسُيوفِنا","وَأُسدَ الشَرى قُدنا إِلَيكَ أَمِ الكُتبا",11,"ب",2,0],["بأقلامهِ تُحمى البلادُ وتحتوى","فيا حبَّذا من تاجها ورتاجها",12,"ج",3,0],["باقِعَةً إن أنت خاطبتَهُ","أَعرَبَ أو فاكهتَهُ أغربا",13,"ب",2,0],["باقي كتابي بيدي","بان لمن سيفُ عَدِي",14,"ي",1,1],["بأقرب دارٍ لا أرى الدهرَ وجهَهُ","فيا بُعدَ مرآه ويا قُرْبَ داره",15,"ر",2,0],["باقٍ عَلى مَرِّ العُصورِ بَقائَها","وَكَذاكَ ذِكرُ ذَوي النُفوسِ السامِيَه",16,"ي",2,0],["باقٍ كَثَأرِ القُدسِ مِن قَبلِهِ","لا نَنتَهي مِنهُ وَلا يَبتَدي",17,"د",2,0],["بِأَقصى رِضانا أَن يَعَضَّ حَسودُهُ","عَلى رَغَمٍ في كَفِّ غَضبانَ آسِفِ",18,"ف",1,0],["بَأَقَبَّ يَعصي الكَفَّ ثُمَّ يُطيعُهُ","فَتَراهُ بَينَ تَسَرُّعٍ وَتَوانِ",19,"ن",1,0],["باقٍ على الدَّهرِ لا يخشَى غَوائلَهُ","ولا يخافُ من البَّاغين عُدوانا",20,"ن",2,0],["بأقَبَّ لا يَدَعُ الصّهيلَ إلى القَنا","حتى يلوكَ خِطامَها المتقصِّفا",21,"ف",2,0],["بَاقٍ عَلَى العَهْدِ","مَدَى الدَّهْرِ بِلاَ تَحَوُّلِ",22,"ل",1,0],["بَاقٍ وإِنْ هُوَ غَابَ سَاطِعُ نُورِهِ","حَتَّى يُكَادَ يَخَالُ لَيْسَ بِغَائِبِ",23,"ب",1,0],["باق على مرّ العصور بقاءها","وكذاك ذكر ذوي النفوس السامية",24,"ي",2,0],["باقي الذَّماءِ إذا ملكتَ مناقلٌ","وإذا جمعتَ بهِ أجَشُّ هزيمُ",25,"م",1,0],["بِإِقدامِكَ الإِسلامُ بِالعِزِّ مُرتَدٍ","وَجاحِدُ ما أَولَيتَهُ عَنهُ مُرتَدُّ",26,"د",1,0],["باقٍ عَلى الأَيّامِ يُخلِفُ ما تَوى","فيهِ إِذا وَعدُ الأَماني أَخلَفا",27,"ف",2,0],["بِأَقَلِّ حَظٍّ غادَرَت أَرحامَنا","جَذّاءَ بادِيَةَ الضَنا لِشكاتِها",28,"ت",3,0],["بإِقرارهِ كم صغتُ فيه قصيدةً","وَنوّعتُ في أمداحه النظم والنثرا",29,"ر",2,0],["بِأقربِ وَقتٍ أصبحت خير أُمّةٍ","فَضائلَ واِستَولت على غيرها قَهرا",30,"ر",2,0],["بأقبَّ ما طارتْ قوائمُهُ به","إلا اشتهى طَيَرانهنَّ التُّدْرج",31,"ج",1,0],["باق على عنت الخطوب وعسفها","مجد تقاصر دونه الأنظار",32,"ر",1,0],["بِإِقبالٍ تُجَدِّدُهُ اللَيالي","لِدَولَتِها وَتَخدِمُهُ الكَواكِب",33,"ب",1,0],["باقِياتٍ لَمْ تَخْلُ ما قَدُمَ الْعَهْ","دُ عَلَيْها مِنْ مَفْخَرٍ مُسْتَجَدِّ",34,"د",1,0],["باقة من زهرِ (الغو","طةِ) طلَّتها غمامه",35,"م",2,0],["باقٍ على حالِ العَطايا وقد","غَيَّرتِ الأيّامُ أحْوالها",36,"ل",3,0],["بأقضَى قضاةِ الدَّهرِ أَعزَزْتُ جانبي","فأحجَم عنّي صَرْفُه وهْو صاغر",37,"ر",1,0],["بأقلامٍ من الخَطِّيِّ خَطَّت","صحائِفَ ما فُهمنَ ولا قُرِينا",38,"ن",2,0],["بأقطاعهم ما حرم اللّه أخذه","فسحقاً وبعداً بعد ذا للأكابر",39,"ر",1,0],["بِأَقيال قَحطان وَأساد عامِر","وَفُرسان كَلب كالوَشيج الموشَّجا",40,"ج",2,0],["باقاتلي وجداً ومانح مقلتي","سهداً وأصبح نازلاً بجناني",41,"ن",2,0],["باق على الآياد مثل بقائه","قبلا وتلك حياته كحياتي",42,"ت",2,0],["باق نعم أنا في ولائي الباقي","أحيا بوحي جنانيَ الخلاق",43,"ق",1,1],["بأقوالكم وبأفعالكم","وما كلّ من قال بالفاعلِ",44,"ل",1,0],["باقياتٍ وقد جررنَ عليهن","نَ الليالي معدودةً والشهورا",45,"ر",2,0],["باقيات في الدهر ما بقيَ الده","رُ وناصى رضوَى أخاه ثبيرا",45,"ر",2,0],["باقٍ يخافُ الحتفَ وهو متى يَمُتْ","فله مَعادٌ عاجلٌ ونشورُ",46,"ر",1,0],["بأقمار ليلٍ والترائك هالها","أسود أقلّتها من الخيل عقبان",47,"ن",1,0],["بِإِقدامٍ يهابُ اللّيثُ منهُ","وَإنعامٍ يبرِّحُ بِالكرامِ",48,"م",1,0],["باقٍ عَلى حَدَثِ الزَمانِ كَأَنَّهُ","ذو رَونَقٍ عَضبٌ أَجيدَ صِقالا",49,"ل",2,0],["بإِقدامِهم نالوا الحياةَ ورُبَّمَا","يُؤخِّرُ آجالَ الرِّجَالِ التَّقَدُّمُ",50,"م",1,0]]}