{"poems":[[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[90,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[90,"خرج الناس يهرعون احتفاء","https://www.aldiwan.net/poem44795.html","الخفيف"],[90,"هم يعدون بالمئات ذكورا","https://www.aldiwan.net/poem44829.html","الخفيف"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[91,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[124,"إيه عبد الرحمن أذكيت جمرا","https://www.aldiwan.net/poem49274.html","الخفيف"],[136,"لعبت بعد ما انقضى الريعان","https://www.aldiwan.net/poem54719.html","الخفيف"],[197,"هل إلى سلوة وصبر سبيل","https://www.aldiwan.net/poem13106.html","الخفيف"],[203,"لا تلم ذا الهوى على أن يبوحا","https://www.aldiwan.net/poem45621.html","الخفيف"],[214,"عاطنيها ذوب تبر","https://www.aldiwan.net/poem13366.html","مجزوء الرمل"],[264,"في المقادير تحكم الأقدار","https://www.aldiwan.net/poem35947.html","الخفيف"],[275,"هبط الليل ولما أن دجا","https://www.aldiwan.net/poem35240.html","الرمل"],[309,"ليس هذا بعجيب","https://www.aldiwan.net/poem16890.html","مجزوء الرمل"],[396,"هل ترى يا كاحل المقل","https://www.aldiwan.net/poem54513.html","عموديه"],[409,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[458,"أربعاء الرماد يا عيد أحزا","https://www.aldiwan.net/poem61392.html","الخفيف"],[458,"هيا إلى السماء هيا","https://www.aldiwan.net/poem61573.html","مجزوء الخفيف"],[458,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[469,"وما كنت لولا صبوتي يوم ودعوا","https://www.aldiwan.net/poem3438.html","عموديه"],[563,"أيها الشخص الذي قال أنا","https://www.aldiwan.net/poem33808.html","الرمل"],[563,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[563,"نحن أهل الشام سوط الله في","https://www.aldiwan.net/poem34357.html","الرمل"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[591,"لا ولين المعاطف المياله","https://www.aldiwan.net/poem18012.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110380","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63899","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99983","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136366","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109001","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108452","الرمل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144619","المقتضب"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34887","الخفيف"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82991","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146355","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203007","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204450","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67584","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108323","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125963","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125941","الرمل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2562","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29284","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77059","الخفيف"],[4767,"سوء العاقبة","https://www.poetsgate.com/ViewPoem.aspx?id=179822",""],[1901,"من مجيري من الهوى أَو معيني","https://www.poetsgate.com/ViewPoem.aspx?id=160400",""],[3591,"يعبس الدهر ثم يبسم حيناً","https://www.poetsgate.com/ViewPoem.aspx?id=149406",""],[5150,"مقدمة للحب","https://www.poetsgate.com/ViewPoem.aspx?id=202787",""],[5307,"","https://www.poetsgate.com/ViewPoem.aspx?id=10549",""],[5409,"ليس هذي الحياة إلا كلغز","https://www.poetsgate.com/ViewPoem.aspx?id=155368",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5542,"ليس هذا عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=10193",""],[5720,"رُبَّما","https://www.poetsgate.com/ViewPoem.aspx?id=207343",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"نوع حزني","https://www.poetsgate.com/ViewPoem.aspx?id=192398",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[5309,"عزلوا الكفء من الحصن الحصين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573825",""],[4890,"أغنية إلى المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75271&r=&rc=383",""]],"verses":[["لَيسَ هَذا لِرَسولِ اللَهِ يا","أُمَّةَ الطُغيانِ وَالبَغيِ جَزا",0,"ا",1,0],["لَيسَ هَذا سُبحانَ رَبّي وَلا ذا","كَ وَلَكِن طَبيعَةُ الأَكوانِ",1,"ن",1,0],["ليس هذا الزيديّ إلا ابن آوى","جاء يغتال منك ليثاً هزبرا",2,"ر",2,0],["ليس هذا الضجيج في الطُرق إلاّ","قهقهات التقدير للتدبير",3,"ر",1,0],["ليس هذا السواد إلاّ سواداً","في رجاء اللبيب ذي التفكير",3,"ر",1,0],["ليس هذا في مذهب الاش","تراكية إلا من الأمور المحاله",4,"ل",2,0],["ليس هذا عهدي بصبرك للهو","ن علىسالف الزمان القديم",5,"م",1,0],["ليس هذا الإنسان إلا حبابا","يختفي بعد الطفو في القمقام",6,"م",1,0],["ليس هول المنون شيئا","اذا قيس بما للحياة من اهوال",7,"ل",1,0],["ليس هذا القتير في مفرقي ال","لا سحاباً ما ان يريد انقشاعا",8,"ع",2,0],["ليس هذا المريضُ أوّلَ من عُولِجَ","من دائِهِ العُضالِ فَعُوفي",9,"ف",2,0],["ليس هيناً علي أن فئت قردا","أشتكي وحشة وآلم بترا",10,"ر",2,0],["لَيسَ هُوناً أن تُنضِىَّ العِيسَ في ال","بيدِ إِلى البِيضِ الخُرَّدِ الفُتيَانُ",11,"ن",1,0],["لَيسَ هَيهاتَ لي إِلَيهِ سَبيل","إِنَّ دَهري بِمثلِهِ لَبَخيلُ",12,"ل",1,0],["ليسَ هذا الهوى سوى سكرةُ المو","تِ فهيِّءْ للعاشقينَ الضريحا",13,"ح",2,0],["ليس هذا يوم صحو","ان هذا يوم سكر",14,"ر",1,0],["ليس هذا قد كان بالقصد منّي","لكنِ الله فاعلٌ مختار",15,"ر",1,0],["ليسَ هذا اللَّيلُ إلا شَفَقاً","من مُحيّاكِ الذي يجلو الدُّجى",16,"ج",2,0],["ليس هذا بعجيب","منك يا ظبي الكثيب",17,"ب",1,1],["ليس هذا بالعجيب ولا","بغريب من كريم ملي",18,"ل",2,0],["ليس هذا الذي به وقع الإِش","كال مثل التعليق بالإِكرام",19,"م",1,0],["ليس هذا الرماد من سعف الن","نخل رمادا وإنما وجداني",20,"ن",2,0],["ليس هذا الجثوم أهلا","لك في عزة وحسن",21,"ن",1,0],["ليس هذا وغيره","من حطامي الذي انتثر",22,"ر",1,0],["ليسهرني من بينهم طرفُ راقدٍ","خليٍ ويبكيني الخليُّ ويضحكُ",23,"ك",1,0],["ليس هذا الأمر بالقول ولا","بالتمني يدرك المرء المنى",24,"ن",2,0],["ليس هذا دين ربي","هو من قبح الخصال",25,"ل",1,0],["ليس هذا عبثاً قف واستمع","حكمة مني بها الجهل نفي",26,"ف",2,0],["ليس هذا حَقًّا يضيعُ وَرَبُّ ال","خلقِ قاضٍ به ونَحْن شُهودُه",27,"د",2,0],["لَيْسَ هَتْكُ المُحبِّ في الحُبّ عاراً","حِينَ تَرْنُو اللَّواحِظُ القَتَّالَهْ",28,"ل",2,0],["لَيسَ هَمّي في نِحلَة المُسرَجِ المُل","جَمِ مِنكُم لَو أنَّه ذُو الخِمار",29,"ر",1,0],["ليسَ هذي الدنيا بدارِ قرارٍ","إنها دارُ وقفةٍ وارتحالِ",30,"ل",1,0],["ليس هذا إذا تأملتِ شيباً","إنما الشيبُ ما أَشابَ النفوسا",31,"س",2,0],["لَيْسَ هذا إِلاَّ لتَأْخِيرِ حَظٍّ","حَقُّه حينَ يُنْصَفُ التَّقْدِيمُ",32,"م",1,0],["ليس هم مطلبي ولكن اوري","خوف ان تظهر المعاني السنيه",33,"ي",2,0],["ليس هذا من شهوة الأكل هذا","من طريق البغضاء والشنآن",34,"ن",1,0],["ليس هذا الضريح إلّا جنان","للكمال اصطفاه مولى جليلُ",35,"ل",1,1],["ليس هذا بشراً بل ملكاً","قد وجدنا كلما فيه عجيب",36,"ب",1,0],["ليس هجرنا عجب","بل رضاه أعجبه",37,"ب",2,0],["ليس هذا علامة الخير يا قو","م فعودوا إلى الطريق الأحب",38,"ب",1,0],["لَيسَ هَذا زَمانُ حُرٍّ كَريمٍ","ذا زَمانُ الأَنذالِ أَهلِ الزَعارَه",39,"ر",2,0],["ليسَ هذا زَمانُ قولِكَ ما الحك","مُ على من يقولُ أَنت حرامُ",40,"م",1,1],["ليسهلَ التسديدَ من مرامي","في نظم دُرِّ قبلةِ الإسلامِ",41,"م",1,0],["ليس هذا بِمدْحَةٍ إِنَّما نك","تُب أَمثال ذا إِليه اعتذارا",42,"ر",2,0],["ليس هذا بكلام مغلق","إنه حق غرام وفتون",43,"ن",1,0],["ليس هذي الحياة غير ستار","فامض فينا لما وراء الستار",44,"ر",1,0],["ليسَ هذا أوانَ ذاتِ الحِجالِ","فاصرِمي قد صرمتُ منكِ حبالي",45,"ل",2,1],["ليس هارون كالوصي ابتلاءً","بعد موسى إذ لم يجد من نصير",46,"ر",1,0],["ليس هذي الصهباءُ غير سبيل","لتصيدوا منا به الأموالا",47,"ل",2,0],["ليس هذا الا طلاء تولى","مسحه للعيون طول ملالك",48,"ك",1,0],["ليس هجر الناس في الحب حرام","فاحتمل بلواك إن عز المرام",49,"م",1,0],["لَيسَ هَذا القَتيلُ مِن سَلَفِ الحَي","يَ كَلاعٍ وَيَحصُبٍ وَكُلالِ",50,"ل",1,0],["لَيسَ هذا النَعيمُ غَيرَ شَقاءٍ","فَحَذارِ حَذارِ مِن أُمِّ دَفرِ",51,"ر",1,0],["لَيسَ هَذا سَببا في كل ما","حل بالشرقي من هَذا القَبيل",52,"ل",1,0],["لَيسَ هَدُّ الوِفقِ أَمراً عَسِراً","ولَكِ البَلوَى وضِيقُ المَذهَبِ",53,"ب",1,0],["لَيسَ هذا مِن شَأن أَهلِ وُدادي","إِنَّني لَم أُؤاخِ إِلّا ثمالا",54,"ل",2,0],["ليس هذا وعد ربى..وعد ربى ليس ينكر","فبه الظالمُ يهوِي وبه المؤمن ينصر",55,"ر",1,0],["ليس هذا الغرامُ غير جنونِ","وإذا شِئْتَ فهو شبهَ جنونِ",56,"ن",1,0],["ليس هذه الحياة إلا رجالاًُ","ونساء يقتلنهم قاتلينا",57,"ن",2,0],["ليس هذا الحبُّ وهماً","بل يقيناً.. بل وأوضحْ",58,"ح",1,0],["لي سهيت أتم اهاذيبك","ولا غفت عيني تسادابك",59,"ك",1,0],["ليس هذي الحياة إلا كلغز","فلذاك استهوى النفوس الخفاء",60,"ا",2,1],["ليس هذا الزمان الا كتابا","أنت منه الصحيفة السوداء",61,"ا",2,0],["ليس هذا عيدي ، فإن جراحي","لم تزل يا حبيبة القلب حيَّه",62,"ي",2,0],["ليس هذا عيدي ولكنَّ عيدي","أن أرى أمتي تعود أبيَّه",62,"ي",2,0],["ليسَ هذا بعيداً علىٰ الله ربيْ","السميعِ المجيبِ الغفورِ الرحيمِ",63,"م",1,0],["ليس هذا النهجُ في رأيي سليماً","لِنُمُوِّ الخير فينا واليقينْ",64,"ن",1,0],["ليس هذا الشعر إلّا","خطوةً في حقلِ طينْ",65,"ن",1,0],["ليس هذا العيش إلا ضحكة","كل فرد ضاحك ممن عداه",66,"ا",2,0],["لَيسَ هَذا أَنا ! وَلَيسَ لِسانِي","عَجَبًا !! كَيفَ لا أَنا !؟ لا اللِّسانُ !؟",67,"ن",1,0],["لَيسَ هذا العَهدُ كَالماضي الَّذي","خَضَعَ الفِكرُ بِهِ لِلمُعتَدين",68,"ن",1,0],["ليس هذا زمانَ البدَاءِ ولا آخرَ الأزمنهْ","إنّه نَهَرُ الجرحِ يدفقُ من صدر آدَمَ،-",69,"م",1,1]]}