ي على شي","https://www.poetsgate.com/ViewPoem.aspx?id=151531",""],[4877,"لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=29455",""],[4935,"ببسم الله قم واقراً","https://www.poetsgate.com/ViewPoem.aspx?id=129447",""],[4987,"خيل القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=49577",""],[5101,"القارات الخمس","https://www.poetsgate.com/ViewPoem.aspx?id=212670",""],[5225,"عليهم صابر","https://www.poetsgate.com/ViewPoem.aspx?id=25795",""],[5277,"قلبٌ على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=200768",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5370,"لعيونه","https://www.poetsgate.com/ViewPoem.aspx?id=85510",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5431,"فمكر الله خيرٌ إنْ أمدّه","https://www.poetsgate.com/ViewPoem.aspx?id=213977",""],[5431,"الحسين...","https://www.poetsgate.com/ViewPoem.aspx?id=215715",""],[5433,"رماد الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=36236",""],[5455,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=213951",""],[5499,"شوفك مطر","https://www.poetsgate.com/ViewPoem.aspx?id=177879",""],[5525,"أبي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=855",""],[5582,"أَلا هَلْ نَفَتْ عَنْكَ طِيبَ الرُّقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=186965",""],[5648,"احساس مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=154543",""],[5736,"حسين","https://www.poetsgate.com/ViewPoem.aspx?id=203809",""],[5776,"حضوركَ أنتَ يكمنُ في الغيابِ","https://www.poetsgate.com/ViewPoem.aspx?id=199436",""],[5841,"سافرت في فكري وْ هجيت","https://www.poetsgate.com/ViewPoem.aspx?id=37007",""],[192,"ما يقول الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=26783",""],[5956,"أهاجر أين؟","https://www.poetsgate.com/ViewPoem.aspx?id=194385",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[2220,"حسٌّ يفرقُ والأرواحُ تتحدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11285&r=&rc=159",""],[4228,"ملاحن فيها الهوى والألم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69246&r=&rc=4",""]],"verses":[["حُسَينُ حُسَينُ أَنتَ لَها فَنَبِّه","رِجالاً عَن طِلابِ الحَقِّ ناموا",0,"م",3,0],["حَسيبٌ لَبيبٌ مُتلِفٌ ما أَفادَهُ","مُبيحُ تِلادِ المُستَغِشِّ المُكاشِحِ",1,"ح",1,0],["حَسيبٌ يُنالُ المَجدُ مِنهُ بِبَسطَةٍ","وَيَعجُزُ عَن إِفضالِهِ كُلُّ شَيظَمِ",2,"م",1,0],["حُسَينُ إِذا كُنتَ في بَلدَةٍ","غَريباً فِعاشِر بِآدابِها",3,"ب",3,1],["حَسيبَةٌ في صَميمِ المَدحِ مَنصِبُها","إِذ أَكثَرُ الشِعرِ مُلقىً مالَهُ حَسَبُ",4,"ب",1,0],["حَسيبُهُ اللَهُ الَّذي فَوقَهُ","لَن تُعجِزَ اللَهَ مُكافاتُه",5,"ت",2,0],["حسيبُك مَن له نقدٌ","لفوتِ مذاهبِ النقَمِ",6,"م",1,0],["\"حسين \" و\" قبرصُه \" يعرفانِ","و\" عبد الاله \" و\"عَمّانه \"",7,"ن",2,0],["حَسِيبُنَا الله، لا تُقْذِي عُيُونَكُمُ","رُوحٌ يَمَانيةٌ، أنْتُمْ لَهَا بَدَنُ",8,"ن",1,0],["حَسيفَ يَزيفُ كَزَيفِ الكَسيرِ","يَنهَمِرُ الماءُ مِنهُ اِنهِمارا",9,"ر",2,0],["حسين كدا يكون السلطان","اللَهُ يبارك في عمرك",10,"ك",1,0],["حسيبٌ نسيبٌ سيّدٌ متواضعٌ","أديبٌ أريبٌ فاضلٌ كاملٌ مهدي",11,"د",2,0],["حَسى من الوجد أَني ما ذكرتهم","الا تكفكف ماء العين واِنحدرا",12,"ر",2,0],["حَسيمٍ نَفاهُ العَبدُ حَتّى أَفَزَّهُ","عَنِ الضَرعِ إِلّا حَكَّهُ بِالمُشافِرِ",13,"ر",1,0],["حسين إعلم أن الشيطنه قد لها ناس","قد لها ناس قاموا في بناها على ساس",14,"س",1,1],["حسينٌ تَوَسَّل لي إِلى اللَهِ اِنَّني","بُليتُ بِهِم فَاِدفَع عَظيمَ بَلائِهِم",15,"م",1,0],["حسين مُجاورهُ آمن","وَزائرهُ ذنبهُ مُغتَفَر",16,"ر",1,0],["حسينُ يا عمَّ عباسٍ وتاليَهُ","على الرعية تنفي عنهم التهما",17,"م",2,0],["حسين وصوف مطلوق الزلوف","زريف الطول مهضوم الحزامي",18,"م",2,0],["حُسين خَليلُ الحِذقِ وَالفهمِ والحِجى","خَليٌّ عَنِ الأَشباهِ أنّى النّظائرُ",19,"ر",1,0],["حُسَين حَباهُ إِلهُ السّما","وَمَنَّ عَليهِ بِنَجلٍ حَميدْ",20,"د",1,1],["حَسِيُبكَ الله لقد هيجْتَنِى","بَعْدَ مِشيبٍ فَوْق رَأسِى قد نَزَلْ",21,"ل",1,0],["حُسينٌ حينَ يَطلُبُ بَذلَ نَصري","عَلى أَهلِ العَداوَةِ وَالشَقاقِ",22,"ق",1,0],["حسيننا ذو الكمالات الحسان ومن","في فضله قد رقي قدراً على الفضلا",23,"ل",2,0],["حسيبُنا اللهُ من قومٍ كأنهمُ","على المحبينَ حسَّادٌ وأعيانُ",24,"ن",1,0],["حسين ما سرت فيك المنايا","على عجل ولا كابدت حينا",25,"ن",2,0],["حَسيرُ دَهرٍ لَحِيّاً مِن مُروءَتِهِ","كابَرتُهُ وَعَلَيهِ صَولَةُ الزَمَنِ",26,"ن",1,0],["حسين أمير المسلمين ابن هاشم","به قام دين اللَه للبطل قاهر",27,"ر",1,0],["حسين الحسيني الفتى من مقوطر","نمته إلى العليا بدور زواهر",27,"ر",1,0],["حسين الذي يهواه قلبي ومن غدا","لسيف الهدى والدين باد وشاهر",27,"ر",1,0],["حسين الذي في سيفه الدين قائم","مطيع له فينا ضمير وظاهر",27,"ر",1,0],["حسين الذي في وسط قلبي خله","وقد حسنت أخلاقه والسراير",27,"ر",1,0],["حُسين سَباني حُسنُهُ ولِحاظُهُ","وقامتُهُ كالخيزُرَانَةِ تَنثَني",28,"ي",1,1],["حسٌّ يفرِّق والرواح تتحد","أنا الفقير وأنت السيد الصمدُ",29,"د",1,1],["حسيبة أصل من كرام تفز إذن","بولد كرام والبكارة فاقصد",30,"د",1,0],["حسين ودونك يا ليتني","أكون المجدل من جدلك",31,"ك",1,0],["حسين سليل المصطفى وابن حيدر","وأفضل موتور له شر واتر",32,"ر",1,0],["حسين اِبن خَير الخَلق بَعد محمد","وَمُردي الكماة الصيد في كُل مَشهَد",33,"د",1,0],["حَسيب تَرى الوفاد تَسعى لداره","صنوفاً فمن غاد هناك وَرائح",34,"ح",1,0],["حسيبٌ ماجدٌ شهم حديد","أريب مِدرَهٌ لَبِقٌ قويم",35,"م",1,0],["حسين طفيل في رسوم ربوعكم","فقير ولكن لا يميل لغيركم",36,"م",1,1],["حسين يا حسين اتى اليكم","صريخاً وانتحى الحسن الحسينا",37,"ن",2,0],["حسيب نسيب كثير العطايا","لدى فضله تستقل البحور",38,"ر",1,0],["حسين ابن بنت الهاشمي محمد","نبي الهدى من شرع العج والشجا",39,"ج",2,0],["حسي صحيح ولكن","هواي يوهن حسي",40,"ي",1,1],["حُسين أَقلني مِن زَمان شَرابه","حَميم وَغسلين إِذا ما صفا صدا",41,"د",2,0],["حُسين حسين جاءَ يَرجوك ضارعاً","لدَهر بِهِ مِن فتكه الناب وَالظفر",42,"ر",1,0],["حسين حسين من يُدانيك في العُلى","وَفَضلك يا سَبط النَبي شَهير",43,"ر",1,0],["حسينا أبا هاشم من غدت","فضائله قط لا تنكر",44,"ر",1,0],["حسين واسماعيل نجلا اخي العلا","حسين سجايا المجد رمزي له انتمى",45,"م",2,0],["حسير اللحظ همته","لدى الأرزاء وثابه",46,"ب",2,0],["حسيبك الل