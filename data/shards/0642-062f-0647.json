m.aspx?id=130349",""],[6124,"قدمت للأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=174878",""],[6152,"يا غائبا عن عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=213146",""],[313,"نهاية حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66488&r=&rc=13",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6349,"من قبو ذاكرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85446&r=&rc=0",""]],"verses":[["قُدها فَغُرَّتُها مِنَ الكَلِمِ الجَني","وَحُجولُها مِن صَنعَةٍ وَمَعانِ",0,"ن",1,0],["قَد هَدَلَت شِفاهَها","عَلى القِنانِ وَالأَكَم",1,"م",1,0],["قَد هادَنَ الدَهرُ حَتّى لا قِراعَ لَهُ","وَأَطرَقَ الخَطبُ حَتّى ما بِهِ حَرَكُ",2,"ك",1,0],["قَد هَزَزناكَ لِلنَدى فَوَجَدنا","وَرَقاً ناضِراً وَعوداً نُضارا",3,"ر",2,0],["قّدْ هَزَّ عَزْمُكَ كُلَّ قُطْرٍ نَازِحٍ","وَأَخَافَ مَمْلُوكاً بِهِ وَمَلِيكَا",4,"ك",2,0],["قَد هَوى مِنكُمُ ثَلاثَةُ أَقما","رٍ خَلَت مِنهُمُ بُروجُ المَعالي",5,"ل",2,0],["قَد هِجتِ يَومَ الِلوى شَوقاً طَرَفتِ بِهِ","عَيني فَلا تُعِجمي مِن دُونِيَ الخَبَرا",6,"ر",2,0],["قَد هاجَ عَيني عَلى عِلّاتِ عَبرَتِها","إِذ قيلَ نُصَّ إِلى جَذعٍ مِنَ الخَشَبِ",7,"ب",1,0],["قد هام وجْداً باكْتراثِي له","وقد أبتْ نفسيَ ما يهوى",8,"و",2,0],["قَد هاجَ ما نَقَلَ الراوُنَ بي طَرَباً","ما أَجمَلَ الرُسلَ في عَيني وَما نَقَلوا",9,"ل",3,0],["قَدُّهُ فَوْقَ رِدْفِه","غُصْنُ بانِ على نَقا",10,"ق",2,0],["قَد هَوى ظُلماً بِمَن عاداتُه","أَن يُنادي كُلَّ مَن يَهوى لَعا",11,"ع",2,0],["قد هوى للجبين شاعر مصر","من علو فمصر ثكلى جزوع",12,"ع",1,0],["قد هزه صوتك الموار يطربه","فهاج كالبحر ذي الامواج يلتطم",13,"م",1,0],["قد هزّ مغربها النعيّ بليله","فاهتز عند الصبح منه المشرق",14,"ق",1,0],["قَد هَيئت فَتحاً لَهُ لَم يدّعِم","عَلى دَم الفِتيان أَو دَمع الأَسى",15,"ا",1,0],["قَدَّها النيلُ فَاِستَحَت فَتَوارَت","مِنهُ بِالجِسرِ بَينَ عُريٍ وَلُبسِ",16,"س",1,0],["قَد هَذَّبَت فَهمَهُ الفَقاهَةُ لي","وَهَذَّبَت شِعرِيَ الفَصاحَةَ لَه",17,"ل",2,0],["قَد هَوَّنَ الصَبرُ عِندي كُلَّ نازِلَةٍ","وَلَيَّنَ العَزمُ حَدَّ المَركَبِ الخَشِنِ",18,"ن",1,0],["قَد هَزَزناكَ بِالقَواقي وَفيها","دَرَجاتٌ إِلى العُلا وَمَراقِ",19,"ق",1,0],["قَد هَتَكَ الدَمعُ مِنهُ ما سَتَرا","وَإِن تُرِد خُبرَ حالِهِ سَتَرى",20,"ر",2,1],["قد هَدَأ الليلُ وران الكرى","إِلا أخَا سهدٍ يغني شجاه",21,"ا",2,0],["قد هنأوك بمجدك الإسباني","فمتى تكون مصارع الثيران",22,"ن",1,1],["قد هدَّني جزعي عليك وأدّعي","أني غداةَ البَينِ غيرُ جَزوع",23,"ع",1,0],["قُدْها تخب بكلّ ذِمْرٍ أبلهٍ","بخداعِ أبطال الوقائِعِ حاذِقِ",24,"ق",1,0],["قدُّهُ والذؤابتانِ رمتني","منْ طعينِ القنا وخفقِ البنودِ",25,"د",1,0],["قدُّهُ جار اعتدالاً","فَلَهُ فَتْكٌ ونُسْكُ",26,"ك",1,1],["قَد هاجَ قَلبَكَ بَعدَ السُلوَةِ الوَطَنُ","وَالشَوقُ يُحدِثُهُ لِلنازِحِ الشَجَنُ",27,"ن",1,1],["قَد هاجَ أَحزانَ قَلبِكَ الذِكَرُ","وَاِشتاقَ وَالشَوقُ لِلفَتى عَبِرُ",28,"ر",1,1],["قَد هاجَ قَلبي مَحضَرُ","أَقوى وَرَبعٌ مُقفِرُ",29,"ر",1,1],["قَد هاجَ حُزني وَعادَني ذِكري","يَومَ اِلتَقَينا عَشِيَّةَ النَفَرِ",30,"ر",1,1],["قَد هَزَّنا قِتالٌ","ما إِن بِهِ جُناحُ",31,"ح",1,0],["قَد هَتَكَ الصُبحُ سَدولِ الدُجى","فَانحَسَرَت أَثوابُهُ الجونُ",32,"ن",1,1],["قَد هَجَرتُ النَديمَ وَالنُدمانا","وَتَمَتَّعتُ ما كَفاني زَمانا",33,"ن",2,1],["قَدُّها أَحسَنُ قَدٍّ","فَاِسأَلوا مَن قَد رَآها",34,"ا",3,0],["قَد هَرَّ قَبلَكَ كَلبٌ دونَ حُجرَتِها","فَهَل فَزِعتُ لِكَلبٍ مَرَّ نَبّاحِ",35,"ح",1,0],["قَد هانَ مينٌ عَلى أَفواهِنا فَغَدا","ذو النُسكِ غَيرَ مُبالٍ أَن يَكونَ لَغا",36,"غ",2,0],["قَد هبَّ يقلع دوحة","من أَصلها ريح عصوف",37,"ف",1,0],["قَد هاجَ قَلبيَ لَيلاً","وَميض برقٍ لَموع",38,"ع",1,0],["قَد هانَ الماجد لَيسَ لَه","سيفٌ للذب يجرده",39,"د",2,0],["قَد هاجَ شجوك شجوي","كأَنَّ روحك روحي",40,"ح",2,0],["قد هجروا الشمس الى الأياة","وجاوزوا المحيي الى الحياة",41,"ه",1,0],["قَد هَراقَ الماءَ في أَجوافِها","وتَطَايَرنَ بأَشتاتٍ شِقَق",42,"ق",1,1],["قَد هَوَى مِنْ حَيْثُ لا","تُقْتَحَمُ الأَبْصَارُ نَجْمُ",43,"م",1,0],["قَدْ هَلَّ مِنْ عَزْمِكَ مَا يَرْتَجَى","وَلاَحَ مِنْ فَضْلِكَ مَا يُرْتَقَبْ",44,"ب",1,0],["قَدْ هَيَّأَتْ آيَاتُهُ لِوُفُودِهَا","فِي مِصْرَ عَنْ أُمَمٍ أَحَبَّ لِقَاءِ",45,"ا",2,0],["قَدْ هَزَّهَا الشَوْقُ حَتَّى","كادَت تُجَارِي الركابَا",46,"ب",2,0],["قَد هَزَزْناكَ بالقَوافِي وَفِيهَا","دَرَجاتٌ إِلى العُلا ومَرَاقِ",47,"ق",1,0],["قدْ هانَ من عهدِها ما كنتُ أحسَبُهُ","هَوى الأحبًّةِ في بغدادَ لا هَانا",48,"ن",2,0],["قد هان حتّى سمت عنه ضغينتنا","فما حقدنا عليه بل رحمناه",49,"ا",2,0],["قد هاجَ قلبكَ بعد السوة ِ الوطن،","وَکلشَّوْقُ يُحْدِثُهُ لِلنَّازِحِ الشَّجَنُ",50,"ن",1,1],["قد هاجَ حزني، وعادني ذكري،","يَوْمَ کلْتَقَيْنَا عَشِيَّة َ النَّفَر",51,"ر",1,1],["قد هاج قلبي محضرُ،","بذي عكاظٍ، مقفرُ",52,"ر",1,1],["قَد هَززناكَ في المَكارم عَضباً","وَاِستَلمناكَ في النَوائب رُكنا",53,"ن",2,0],["قد هون الادمان صعب تولهي","فليتركن دلاله المعشوق",54,"ق",1,0],["قَد هَذَّبَتهُم لَكَ الخُطوبُ وَلو","لا النارُ ما كانَ يَخلُصُ الذَهبُ",55,"ب",1,0],["قَد هَمَّ أَن يَرقى مَحَلَّكَ بَل رَقا","وَسَعى لِيُحرِزَ مَأثُراتِكَ بَل جَرى",56,"ر",2,0],["قد هويتُ السَقامَ في الحبِّ لما","حُزْتَ منهُ في مقلتيكَ نصيبا",57,"ب",2,0],["قد هم بالثغر من نادى مؤذنه","بأن يصلى عيد الفطر في رجب",58,"ب",1,0],["قد هممنا بقتله وبرزنا","فلقيناه ذا سلاح كميا",59,"ي",2,0],["قد همتُ بالرقباء لا من حُبِّهم","وصددتُ عنها ليس من بغضائها",60,"ا",3,0],["قد هذَّبَته بتقويمٍ صرامَتُه","وزاده النصح تهذيباً وتصريما",61,"م",2,0],["قد هزّ لي من قده اسمرا","وسل من لحظه لي حسام",62,"م",1,0],["قده بالشعر معتنق","كاعتناق اللام بالالف",63,"ف",1,0],["قد هاجَهُ دهرٌ مضى بلذاذةٍ","ورغيد عيش قد مضى بِهَناءِ",64,"ا",2,0],["قد هوى من فوره معتذرا","يلثم الاقدام طورا والحذاء",65,"ا",2,0],["قَد هَذَّبتَبي لِلزَمانِ تَجارِبٌ","فَأَقادَ صَعبي وَاِستَلانَ حَروني",66,"ن",2,0],["قَد هَذَّبَتني أَيدي الخُطوبِ عَلى","شَماسِ عِطفَيَّ أَيَّ تَهذيبِ",67,"ب",1,0],["قَدْ هَاجَ هَمِّي يَا بْنَ عَمِّي","شَكْوُكَ صَارَ لِحِلْفِ شَرْءِ",68,"ا",1,0],["قد هشمت رأسي بأحجارها","ألفاظك الهاشمة الدامغة",69,"غ",2,0],["قد هجم الصيف وولى الشتا","منهز ما متبع آثاره",70,"ه",1,1],["قد هززناه بالقريض فشمنا","ه حساما من غمده مهزوزا",71,"ز",2,0],["قد هبَّ يجمعُ شملَكم في دولةٍ","قرشيّةٍ واليسرُ بعدَ تعسُّر",72,"ر",1,0],["قَدْ هَجَرْتُ الْوَرى إِلَيْكَ وَلمْ أَظ","لِمْ وَمَدْحِي سِواكَ لِلْمَدْحِ وَهْزُ",73,"ز",1,0],["قد هيضَ جناحُ النَّسْرِ وَلَمْ","يسقطْ فتحاملَ مكسورا",74,"ر",2,0],["قد هوَّن الناسَ عندي أَنَّ شأْنهمُ","من عهد (آدم) خداعٌ وَمنخدع",75,"ع",1,0],["قَد هنّأتكَ فَهنّأت كلّ الورى","بأعزّ أَبلجَ لم تقله ضؤورُ",76,"ر",1,0],["قد هامت به الكرمه","سقاها الحب من كفيه",77,"ه",1,0],["قدها أملس المعاطف نشوا","ن جميل قد طهرته السماء",78,"ا",2,0],["قد هدمتم معاقلا وحصوناً","وأتحتم للخصم ما لا يتاح",79,"ح",1,0],["قَد هَزَّ مِن أَغصانِهِ ذَوابِلاً","وَسَلَّ من غُدرانِهُ مَناصِلا",80,"ل",2,0],["قد هَزِئَتْ جارتي لما نَكرَتْ","فزادَ ما في الفؤادِ مَهْزؤها",81,"ا",3,0],["قَد هدمَ الناسُ ما بنَوهُ","من مَجدِها وهو بعدُ بانِ",82,"ن",1,0],["قَد هَذَّبَت إِقليمه أَقلامِهِ","وانقاد سيده انقياد مسودِهِ",83,"د",2,0],["قد هتكت الغصون عطفاً وليناً","بقوام يهتز تحت بنودك",84,"ك",1,0],["قد همت وجدا مذ رايت سناءها","بالكاس يحكي شعلة النبراس",85,"س",1,0],["قد هيجت وجدي لبسط العتاب","صحيفة جاءت بفصل الخطاب",86,"ب",1,1],["قد هام في أسرارها","من بعد جابر الف جابر",87,"ر",1,0],["قد هندسوا وبنوا بنا","يات لهم شادت مفاخر",87,"ر",1,0],["قد هوّنتْ عنديَ التوالي","من شَرِّك السُّبَّقُ الأَوالي",88,"ل",2,0],["قد هان عندي وهو ليس بهيّنٍ","ذنبُ الليالي وهو من حسناتها",89,"ت",3,0],["قدها معتدلٌ يظلمني","حربي من قدّها المعتدل",90,"ل",1,0],["قَد هَجَونا وَكانَ غَيرَ صَوابِ","وَرَمَينا لِعَنبَرٍ في تُرابِ",91,"ب",1,0],["قد هدى الأولياء نور هدانا","وبنا حرا فكرها الأعداءُ",92,"ا",2,0],["قد هاجَ حُزني حُزنُ والدَيَّا","لِذا رفَعتُ طالباً يَدَيَّ",93,"ي",1,0],["قد هالَهُم من بعد حَبسي صولةٌ","يَقوى زئيرُ اللَّيثِ إن هو أخدَر",94,"ر",1,0],["قَد هَوَيناهُ ناقِضاً للعُهودِ","وَضَنيناً بِالوعدِ والموعودِ",95,"د",1,1],["قد هدينا بالخاطر المستقيمِ","لحديث عن الحبيب قديمِ",96,"م",1,1],["قد هاجتِ الشَوقَ مني نحو مُرسِلِها","فأَصبَحَ السَمْعُ محسوداً من البَصَرِ",97,"ر",1,0],["قد هاجَ إلاَّ علي