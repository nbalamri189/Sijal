{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"أما تحرك للأقدار نابضة","https://www.aldiwan.net/poem29916.html","البسيط"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[77,"مولاي ها أنا في جوار أبيكا","https://www.aldiwan.net/poem36382.html","الكامل"],[86,"ثمن المجد والمحامد غالي","https://www.aldiwan.net/poem10352.html","الخفيف"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[23,"يا عين جودي بدمع منك منسكب","https://www.aldiwan.net/poem21464.html","البسيط"],[51,"وجاهل أعرضت عن جهله","https://www.aldiwan.net/poem7937.html","السريع"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[78,"قبح الدهر فماذا صنعا","https://www.aldiwan.net/poem14203.html","الرمل"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[45,"حاطك الله يا أبا أسحاق","https://www.aldiwan.net/poem65202.html","الخفيف"],[66,"قد هتك الدمع منه ما سترا","https://www.aldiwan.net/poem39648.html","المنسرح"],[97,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[97,"قد هنأوك بمجدك الإسباني","https://www.aldiwan.net/poem24585.html","الكامل"],[97,"يا ساعة الحسرات والعبرات","https://www.aldiwan.net/poem24911.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[69,"رب أعمى أصمني عن عذولي","https://www.aldiwan.net/poem28235.html","الخفيف"],[69,"قده جار اعتدالا","https://www.aldiwan.net/poem29066.html","مجزوء الرمل"],[31,"قد هاج قلبك بعد السلوة الوطن","https://www.aldiwan.net/poem41294.html","البسيط"],[31,"قد هاج أحزان قلبك الذكر","https://www.aldiwan.net/poem42493.html","المنسرح"],[31,"قد هاج قلبي محضر","https://www.aldiwan.net/poem42502.html","مجزوء الرجز"],[31,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[48,"بزاتنا الأقداح","https://www.aldiwan.net/poem62536.html","المجتث"],[48,"قد هتك الصبح سدول الدجى","https://www.aldiwan.net/poem65308.html","السريع"],[48,"قد هجرت النديم والندمانا","https://www.aldiwan.net/poem65311.html","الخفيف"],[48,"طفلة خود رداح","https://www.aldiwan.net/poem66180.html","مجزوء الرمل"],[50,"دعني أمت بالهوى لا يلحني لاح","https://www.aldiwan.net/poem63970.html","البسيط"],[46,"من عثرة القوم أن كنوا وليدهم","https://www.aldiwan.net/poem22971.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85307","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85560","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85296","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[45,"حاطَكَ اللهُ يا أَبا إِسحَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32172",""],[31,"قد هاجَ قلبكَ بعد السوة ِ الوطن،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19107&r=&rc=369",""],[31,"قد هاجَ حزني، وعادني ذكري،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18878&r=&rc=141",""],[31,"قد هاج قلبي محضرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18898&r=&rc=161",""]],"verses":[["قُدها فَغُرَّتُها مِنَ الكَلِمِ الجَني","وَحُجولُها مِن صَنعَةٍ وَمَعانِ",0,"ن",1,0],["قَد هَدَلَت شِفاهَها","عَلى القِنانِ وَالأَكَم",1,"م",1,0],["قَد هادَنَ الدَهرُ حَتّى لا قِراعَ لَهُ","وَأَطرَقَ الخَطبُ حَتّى ما بِهِ حَرَكُ",2,"ك",1,0],["قَد هَزَزناكَ لِلنَدى فَوَجَدنا","وَرَقاً ناضِراً وَعوداً نُضارا",3,"ر",2,0],["قّدْ هَزَّ عَزْمُكَ كُلَّ قُطْرٍ نَازِحٍ","وَأَخَافَ مَمْلُوكاً بِهِ وَمَلِيكَا",4,"ك",2,0],["قَد هَوى مِنكُمُ ثَلاثَةُ أَقما","رٍ خَلَت مِنهُمُ بُروجُ المَعالي",5,"ل",2,0],["قَد هِجتِ يَومَ الِلوى شَوقاً طَرَفتِ بِهِ","عَيني فَلا تُعِجمي مِن دُونِيَ الخَبَرا",6,"ر",2,0],["قَد هاجَ عَيني عَلى عِلّاتِ عَبرَتِها","إِذ قيلَ نُصَّ إِلى جَذعٍ مِنَ الخَشَبِ",7,"ب",1,0],["قد هام وجْداً باكْتراثِي له","وقد أبتْ نفسيَ ما يهوى",8,"و",2,0],["قَد هاجَ ما نَقَلَ الراوُنَ بي طَرَباً","ما أَجمَلَ الرُسلَ في عَيني وَما نَقَلوا",9,"ل",3,0],["قَدُّهُ فَوْقَ رِدْفِه","غُصْنُ بانِ على نَقا",10,"ق",2,0],["قَد هَوى ظُلماً بِمَن عاداتُه","أَن يُنادي كُلَّ مَن يَهوى لَعا",11,"ع",2,0],["قد هوى للجبين شاعر مصر","من علو فمصر ثكلى جزوع",12,"ع",1,0],["قد هزه صوتك الموار يطربه","فهاج كالبحر ذي الامواج يلتطم",13,"م",1,0],["قد هزّ مغربها النعيّ بليله","فاهتز عند الصبح منه المشرق",14,"ق",1,0],["قَد هَيئت فَتحاً لَهُ لَم يدّعِم","عَلى دَم الفِتيان أَو دَمع الأَسى",15,"ا",1,0],["قَدَّها النيلُ فَاِستَحَت فَتَوارَت","مِنهُ بِالجِسرِ بَينَ عُريٍ وَلُبسِ",16,"س",1,0],["قَد هَذَّبَت فَهمَهُ الفَقاهَةُ لي","وَهَذَّبَت شِعرِيَ الفَصاحَةَ لَه",17,"ل",2,0],["قَد هَوَّنَ الصَبرُ عِندي كُلَّ نازِلَةٍ","وَلَيَّنَ العَزمُ حَدَّ المَركَبِ الخَشِنِ",18,"ن",1,0],["قَد هَزَزناكَ بِالقَواقي وَفيها","دَرَجاتٌ إِلى العُلا وَمَراقِ",19,"ق",1,0],["قَد هَتَكَ الدَمعُ مِنهُ ما سَتَرا","وَإِن تُرِد خُبرَ حالِهِ سَتَرى",20,"ر",2,1],["قد هَدَأ الليلُ وران الكرى","إِلا أخَا سهدٍ يغني شجاه",21,"ا",2,0],["قد هنأوك بمجدك الإسباني","فمتى تكون مصارع الثيران",22,"ن",1,1],["قد هدَّني جزعي عليك وأدّعي","أني غداةَ البَينِ غيرُ جَزوع",23,"ع",1,0],["قُدْها تخب بكلّ ذِمْرٍ أبلهٍ","بخداعِ أبطال الوقائِعِ حاذِقِ",24,"ق",1,0],["قدُّهُ والذؤابتانِ رمتني","منْ طعينِ القنا وخفقِ البنودِ",25,"د",1,0],["قدُّهُ جار اعتدالاً","فَلَهُ فَتْكٌ ونُسْكُ",26,"ك",1,1],["قَد هاجَ قَلبَكَ بَعدَ السُلوَةِ الوَطَنُ","وَالشَوقُ يُحدِثُهُ لِلنازِحِ الشَجَنُ",27,"ن",1,1],["قَد هاجَ أَحزانَ قَلبِكَ الذِكَرُ","وَاِشتاقَ وَالشَوقُ لِلفَتى عَبِرُ",28,"ر",1,1],["قَد هاجَ قَلبي مَحضَرُ","أَقوى وَرَبعٌ مُقفِرُ",29,"ر",1,1],["قَد هاجَ حُزني وَعادَني ذِكري","يَومَ اِلتَقَينا عَشِيَّةَ النَفَرِ",30,"ر",1,1],["قَد هَزَّنا قِتالٌ","ما إِن بِهِ جُناحُ",31,"ح",1,0],["قَد هَتَكَ الصُبحُ سَدولِ الدُجى","فَانحَسَرَت أَثوابُهُ الجونُ",32,"ن",1,1],["قَد هَجَرتُ النَديمَ وَالنُدمانا","وَتَمَتَّعتُ ما كَفاني زَمانا",33,"ن",2,1],["قَدُّها أَحسَنُ قَدٍّ","فَاِسأَلوا مَن قَد رَآها",34,"ا",3,0],["قَد هَرَّ قَبلَكَ كَلبٌ دونَ حُجرَتِها","فَهَل فَزِعتُ لِكَلبٍ مَرَّ نَبّاحِ",35,"ح",1,0],["قَد هانَ مينٌ عَلى أَفواهِنا فَغَدا","ذو النُسكِ غَيرَ مُبالٍ أَن يَكونَ لَغا",36,"غ",2,0],["قَد هبَّ يقلع دوحة","من أَصلها ريح عصوف",37,"ف",1,0],["قَد هاجَ قَلبيَ لَيلاً","وَميض برقٍ لَموع",38,"ع",1,0],["قَد هانَ الماجد لَيسَ لَه","سيفٌ للذب يجرده",39,"د",2,0],["قَد هاجَ شجوك شجوي","كأَنَّ روحك روحي",40,"ح",2,0],["قد هجروا الشمس الى الأياة","وجاوزوا المحيي الى الحياة",41,"ه",1,0],["قَد هَراقَ الماءَ في أَجوافِها","وتَطَايَرنَ بأَشتاتٍ شِقَق",42,"ق",1,1],["قَد هَوَى مِنْ حَيْثُ لا","تُقْتَحَمُ الأَبْصَارُ نَجْمُ",43,"م",1,0],["قَدْ هَلَّ مِنْ عَزْمِكَ مَا يَرْتَجَى","وَلاَحَ مِنْ فَضْلِكَ مَا يُرْتَقَبْ",44,"ب",1,0],["قَدْ هَيَّأَتْ آيَاتُهُ لِوُفُودِهَا","فِي مِصْرَ عَنْ أُمَمٍ أَحَبَّ لِقَاءِ",45,"ا",2,0],["قَدْ هَزَّهَا الشَوْقُ حَتَّى","كادَت تُجَارِي الركابَا",46,"ب",2,0],["قَد هَزَزْناكَ بالقَوافِي وَفِيهَا","دَرَجاتٌ إِلى العُلا ومَرَاقِ",47,"ق",1,0],["قد هاجَ قلبكَ بعد السوة ِ الوطن،","وَکلشَّوْقُ يُحْدِثُهُ لِلنَّازِحِ الشَّجَنُ",48,"ن",1,1],["قد هاجَ حزني، وعادني ذكري،","يَوْمَ کلْتَقَيْنَا عَشِيَّة َ النَّفَر",49,"ر",1,1],["قد هاج قلبي محضرُ،","بذي عكاظٍ، مقفرُ",50,"ر",1,1]]}