{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"أما تحرك للأقدار نابضة","https://www.aldiwan.net/poem29916.html","البسيط"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[77,"مولاي ها أنا في جوار أبيكا","https://www.aldiwan.net/poem36382.html","الكامل"],[86,"ثمن المجد والمحامد غالي","https://www.aldiwan.net/poem10352.html","الخفيف"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[23,"يا عين جودي بدمع منك منسكب","https://www.aldiwan.net/poem21464.html","البسيط"],[51,"وجاهل أعرضت عن جهله","https://www.aldiwan.net/poem7937.html","السريع"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[78,"قبح الدهر فماذا صنعا","https://www.aldiwan.net/poem14203.html","الرمل"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[45,"حاطك الله يا أبا أسحاق","https://www.aldiwan.net/poem65202.html","الخفيف"],[66,"قد هتك الدمع منه ما سترا","https://www.aldiwan.net/poem39648.html","المنسرح"],[97,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[97,"قد هنأوك بمجدك الإسباني","https://www.aldiwan.net/poem24585.html","الكامل"],[97,"يا ساعة الحسرات والعبرات","https://www.aldiwan.net/poem24911.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[69,"رب أعمى أصمني عن عذولي","https://www.aldiwan.net/poem28235.html","الخفيف"],[69,"قده جار اعتدالا","https://www.aldiwan.net/poem29066.html","مجزوء الرمل"],[31,"قد هاج قلبك بعد السلوة الوطن","https://www.aldiwan.net/poem41294.html","البسيط"],[31,"قد هاج أحزان قلبك الذكر","https://www.aldiwan.net/poem42493.html","المنسرح"],[31,"قد هاج قلبي محضر","https://www.aldiwan.net/poem42502.html","مجزوء الرجز"],[31,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[48,"بزاتنا الأقداح","https://www.aldiwan.net/poem62536.html","المجتث"],[48,"قد هتك الصبح سدول الدجى","https://www.aldiwan.net/poem65308.html","السريع"],[48,"قد هجرت النديم والندمانا","https://www.aldiwan.net/poem65311.html","الخفيف"],[48,"طفلة خود رداح","https://www.aldiwan.net/poem66180.html","مجزوء الرمل"],[50,"دعني أمت بالهوى لا يلحني لاح","https://www.aldiwan.net/poem63970.html","البسيط"],[46,"من عثرة القوم أن كنوا وليدهم","https://www.aldiwan.net/poem22971.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85307","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85560","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85296","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[45,"حاطَكَ اللهُ يا أَبا إِسحَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32172",""],[94,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[94,"اللهب القدسي","https://www.poetsgate.com/ViewPoem.aspx?id=15627",""],[31,"قد هاجَ قلبكَ بعد السوة ِ الوطن،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19107&r=&rc=369",""],[31,"قد هاجَ حزني، وعادني ذكري،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18878&r=&rc=141",""],[31,"قد هاج قلبي محضرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18898&r=&rc=161",""],[109,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[115,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[143,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[143,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[155,"كن بعيدا إن شئت أو كن قريبا","https://www.aldiwan.net/poem55765.html","الخفيف"],[160,"رقص جياد الظبا في حلبة اللعب","https://www.aldiwan.net/poem59045.html","البسيط"],[165,"اعزفا لي بلذة قينتيا","https://www.aldiwan.net/poem721.html",""],[204,"نفس المحب دواؤها في دائها","https://www.aldiwan.net/poem53154.html","الكامل"],[204,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[210,"علقت اهيف لدن القوام","https://www.aldiwan.net/poem13353.html","السريع"],[210,"لذ لي في حبكم كلفي","https://www.aldiwan.net/poem13357.html","المديد"],[212,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[221,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[235,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[235,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[237,"ألبسك الله برد برء","https://www.aldiwan.net/poem18035.html","مخلع البسيط"],[256,"يا من يدي من خيره فارغه","https://www.aldiwan.net/poem48543.html","السريع"],[261,"قد هجم الصيف وولى الشتا","https://www.aldiwan.net/poem38110.html","السريع"],[261,"أظهر الروض حلاه كنوزا","https://www.aldiwan.net/poem38260.html","الخفيف"],[270,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[280,"أنت للمسلمين حصن وحرز","https://www.aldiwan.net/poem60691.html","الخفيف"],[298,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[298,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[305,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[328,"تعالي يابنة الأحلام","https://www.aldiwan.net/poem54976.html","الهزج"],[328,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[342,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[364,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[371,"بيني وكوني على بيان","https://www.aldiwan.net/poem57036.html","مخلع البسيط"],[406,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[429,"لا وعينيك والجبين وجيدك","https://www.aldiwan.net/poem40281.html","الخفيف"],[429,"طاف الحباب على حميا الكاس","https://www.aldiwan.net/poem41066.html","الكامل"],[443,"قد هيجت وجدي لبسط العتاب","https://www.aldiwan.net/poem56017.html","عموديه"],[443,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[464,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[468,"أما ترى الزهرة والهلال","https://www.aldiwan.net/poem60467.html","مجزوء الرجز"],[500,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[538,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[538,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[558,"قد هدينا بالخاطر المستقيم","https://www.aldiwan.net/poem34080.html","الخفيف"],[562,"ربيبة من ذوات الغنج والحور","https://www.aldiwan.net/poem52918.html","البسيط"],[562,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[562,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[567,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[575,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"]],"verses":[["قُدها فَغُرَّتُها مِنَ الكَلِمِ الجَني","وَحُجولُها مِن صَنعَةٍ وَمَعانِ",0,"ن",1,0],["قَد هَدَلَت شِفاهَها","عَلى القِنانِ وَالأَكَم",1,"م",1,0],["قَد هادَنَ الدَهرُ حَتّى لا قِراعَ لَهُ","وَأَطرَقَ الخَطبُ حَتّى ما بِهِ حَرَكُ",2,"ك",1,0],["قَد هَزَزناكَ لِلنَدى فَوَجَدنا","وَرَقاً ناضِراً وَعوداً نُضارا",3,"ر",2,0],["قّدْ هَزَّ عَزْمُكَ كُلَّ قُطْرٍ نَازِحٍ","وَأَخَافَ مَمْلُوكاً بِهِ وَمَلِيكَا",4,"ك",2,0],["قَد هَوى مِنكُمُ ثَلاثَةُ أَقما","رٍ خَلَت مِنهُمُ بُروجُ المَعالي",5,"ل",2,0],["قَد هِجتِ يَومَ الِلوى شَوقاً طَرَفتِ بِهِ","عَيني فَلا تُعِجمي مِن دُونِيَ الخَبَرا",6,"ر",2,0],["قَد هاجَ عَيني عَلى عِلّاتِ عَبرَتِها","إِذ قيلَ نُصَّ إِلى جَذعٍ مِنَ الخَشَبِ",7,"ب",1,0],["قد هام وجْداً باكْتراثِي له","وقد أبتْ نفسيَ ما يهوى",8,"و",2,0],["قَد هاجَ ما نَقَلَ الراوُنَ بي طَرَباً","ما أَجمَلَ الرُسلَ في عَيني وَما نَقَلوا",9,"ل",3,0],["قَدُّهُ فَوْقَ رِدْفِه","غُصْنُ بانِ على نَقا",10,"ق",2,0],["قَد هَوى ظُلماً بِمَن عاداتُه","أَن يُنادي كُلَّ مَن يَهوى لَعا",11,"ع",2,0],["قد هوى للجبين شاعر مصر","من علو فمصر ثكلى جزوع",12,"ع",1,0],["قد هزه صوتك الموار يطربه","فهاج كالبحر ذي الامواج يلتطم",13,"م",1,0],["قد هزّ مغربها النعيّ بليله","فاهتز عند الصبح منه المشرق",14,"ق",1,0],["قَد هَيئت فَتحاً لَهُ لَم يدّعِم","عَلى دَم الفِتيان أَو دَمع الأَسى",15,"ا",1,0],["قَدَّها النيلُ فَاِستَحَت فَتَوارَت","مِنهُ بِالجِسرِ بَينَ عُريٍ وَلُبسِ",16,"س",1,0],["قَد هَذَّبَت فَهمَهُ الفَقاهَةُ لي","وَهَذَّبَت شِعرِيَ الفَصاحَةَ لَه",17,"ل",2,0],["قَد هَوَّنَ الصَبرُ عِندي كُلَّ نازِلَةٍ","وَلَيَّنَ العَزمُ حَدَّ المَركَبِ الخَشِنِ",18,"ن",1,0],["قَد هَزَزناكَ بِالقَواقي وَفيها","دَرَجاتٌ إِلى العُلا وَمَراقِ",19,"ق",1,0],["قَد هَتَكَ الدَمعُ مِنهُ ما سَتَرا","وَإِن تُرِد خُبرَ حالِهِ سَتَرى",20,"ر",2,1],["قد هَدَأ الليلُ وران الكرى","إِلا أخَا سهدٍ يغني شجاه",21,"ا",2,0],["قد هنأوك بمجدك الإسباني","فمتى تكون مصارع الثيران",22,"ن",1,1],["قد هدَّني جزعي عليك وأدّعي","أني غداةَ البَينِ غيرُ جَزوع",23,"ع",1,0],["قُدْها تخب بكلّ ذِمْرٍ أبلهٍ","بخداعِ أبطال الوقائِعِ حاذِقِ",24,"ق",1,0],["قدُّهُ والذؤابتانِ رمتني","منْ طعينِ القنا وخفقِ البنودِ",25,"د",1,0],["قدُّهُ جار اعتدالاً","فَلَهُ فَتْكٌ ونُسْكُ",26,"ك",1,1],["قَد هاجَ قَلبَكَ بَعدَ السُلوَةِ الوَطَنُ","وَالشَوقُ يُحدِثُهُ لِلنازِحِ الشَجَنُ",27,"ن",1,1],["قَد هاجَ أَحزانَ قَلبِكَ الذِكَرُ","وَاِشتاقَ وَالشَوقُ لِلفَتى عَبِرُ",28,"ر",1,1],["قَد هاجَ قَلبي مَحضَرُ","أَقوى وَرَبعٌ مُقفِرُ",29,"ر",1,1],["قَد هاجَ حُزني وَعادَني ذِكري","يَومَ اِلتَقَينا عَشِيَّةَ النَفَرِ",30,"ر",1,1],["قَد هَزَّنا قِتالٌ","ما إِن بِهِ جُناحُ",31,"ح",1,0],["قَد هَتَكَ الصُبحُ سَدولِ الدُجى","فَانحَسَرَت أَثوابُهُ الجونُ",32,"ن",1,1],["قَد هَجَرتُ النَديمَ وَالنُدمانا","وَتَمَتَّعتُ ما كَفاني زَمانا",33,"ن",2,1],["قَدُّها أَحسَنُ قَدٍّ","فَاِسأَلوا مَن قَد رَآها",34,"ا",3,0],["قَد هَرَّ قَبلَكَ كَلبٌ دونَ حُجرَتِها","فَهَل فَزِعتُ لِكَلبٍ مَرَّ نَبّاحِ",35,"ح",1,0],["قَد هانَ مينٌ عَلى أَفواهِنا فَغَدا","ذو النُسكِ غَيرَ مُبالٍ أَن يَكونَ لَغا",36,"غ",2,0],["قَد هبَّ يقلع دوحة","من أَصلها ريح عصوف",37,"ف",1,0],["قَد هاجَ قَلبيَ لَيلاً","وَميض برقٍ لَموع",38,"ع",1,0],["قَد هانَ الماجد لَيسَ لَه","سيفٌ للذب يجرده",39,"د",2,0],["قَد هاجَ شجوك شجوي","كأَنَّ روحك روحي",40,"ح",2,0],["قد هجروا الشمس الى الأياة","وجاوزوا المحيي الى الحياة",41,"ه",1,0],["قَد هَراقَ الماءَ في أَجوافِها","وتَطَايَرنَ بأَشتاتٍ شِقَق",42,"ق",1,1],["قَد هَوَى مِنْ حَيْثُ لا","تُقْتَحَمُ الأَبْصَارُ نَجْمُ",43,"م",1,0],["قَدْ هَلَّ مِنْ عَزْمِكَ مَا يَرْتَجَى","وَلاَحَ مِنْ فَضْلِكَ مَا يُرْتَقَبْ",44,"ب",1,0],["قَدْ هَيَّأَتْ آيَاتُهُ لِوُفُودِهَا","فِي مِصْرَ عَنْ أُمَمٍ أَحَبَّ لِقَاءِ",45,"ا",2,0],["قَدْ هَزَّهَا الشَوْقُ حَتَّى","كادَت تُجَارِي الركابَا",46,"ب",2,0],["قَد هَزَزْناكَ بالقَوافِي وَفِيهَا","دَرَجاتٌ إِلى العُلا ومَرَاقِ",47,"ق",1,0],["قدْ هانَ من عهدِها ما كنتُ أحسَبُهُ","هَوى الأحبًّةِ في بغدادَ لا هَانا",48,"ن",2,0],["قد هان حتّى سمت عنه ضغينتنا","فما حقدنا عليه بل رحمناه",49,"ا",2,0],["قد هاجَ قلبكَ بعد السوة ِ الوطن،","وَکلشَّوْقُ يُحْدِثُهُ لِلنَّازِحِ الشَّجَنُ",50,"ن",1,1],["قد هاجَ حزني، وعادني ذكري،","يَوْمَ کلْتَقَيْنَا عَشِيَّة َ النَّفَر",51,"ر",1,1],["قد هاج قلبي محضرُ،","بذي عكاظٍ، مقفرُ",52,"ر",1,1],["قَد هَززناكَ في المَكارم عَضباً","وَاِستَلمناكَ في النَوائب رُكنا",53,"ن",2,0],["قد هون الادمان صعب تولهي","فليتركن دلاله المعشوق",54,"ق",1,0],["قَد هَذَّبَتهُم لَكَ الخُطوبُ وَلو","لا النارُ ما كانَ يَخلُصُ الذَهبُ",55,"ب",1,0],["قَد هَمَّ أَن يَرقى مَحَلَّكَ بَل رَقا","وَسَعى لِيُحرِزَ مَأثُراتِكَ بَل جَرى",56,"ر",2,0],["قد هويتُ السَقامَ في الحبِّ لما","حُزْتَ منهُ في مقلتيكَ نصيبا",57,"ب",2,0],["قد هم بالثغر من نادى مؤذنه","بأن يصلى عيد الفطر في رجب",58,"ب",1,0],["قد هممنا بقتله وبرزنا","فلقيناه ذا سلاح كميا",59,"ي",2,0],["قد همتُ بالرقباء لا من حُبِّهم","وصددتُ عنها ليس من بغضائها",60,"ا",3,0],["قد هذَّبَته بتقويمٍ صرامَتُه","وزاده النصح تهذيباً وتصريما",61,"م",2,0],["قد هزّ لي من قده اسمرا","وسل من لحظه لي حسام",62,"م",1,0],["قده بالشعر معتنق","كاعتناق اللام بالالف",63,"ف",1,0],["قد هاجَهُ دهرٌ مضى بلذاذةٍ","ورغيد عيش قد مضى بِهَناءِ",64,"ا",2,0],["قد هوى من فوره معتذرا","يلثم الاقدام طورا والحذاء",65,"ا",2,0],["قَد هَذَّبتَبي لِلزَمانِ تَجارِبٌ","فَأَقادَ صَعبي وَاِستَلانَ حَروني",66,"ن",2,0],["قَد هَذَّبَتني أَيدي الخُطوبِ عَلى","شَماسِ عِطفَيَّ أَيَّ تَهذيبِ",67,"ب",1,0],["قَدْ هَاجَ هَمِّي يَا بْنَ عَمِّي","شَكْوُكَ صَارَ لِحِلْفِ شَرْءِ",68,"ا",1,0],["قد هشمت رأسي بأحجارها","ألفاظك الهاشمة الدامغة",69,"غ",2,0],["قد هجم الصيف وولى الشتا","منهز ما متبع آثاره",70,"ه",1,1],["قد هززناه بالقريض فشمنا","ه حساما من غمده مهزوزا",71,"ز",2,0],["قد هبَّ يجمعُ شملَكم في دولةٍ","قرشيّةٍ واليسرُ بعدَ تعسُّر",72,"ر",1,0],["قَدْ هَجَرْتُ الْوَرى إِلَيْكَ وَلمْ أَظ","لِمْ وَمَدْحِي سِواكَ لِلْمَدْحِ وَهْزُ",73,"ز",1,0],["قد هيضَ جناحُ النَّسْرِ وَلَمْ","يسقطْ فتحاملَ مكسورا",74,"ر",2,0],["قد هوَّن الناسَ عندي أَنَّ شأْنهمُ","من عهد (آدم) خداعٌ وَمنخدع",75,"ع",1,0],["قَد هنّأتكَ فَهنّأت كلّ الورى","بأعزّ أَبلجَ لم تقله ضؤورُ",76,"ر",1,0],["قد هامت به الكرمه","سقاها الحب من كفيه",77,"ه",1,0],["قدها أملس المعاطف نشوا","ن جميل قد طهرته السماء",78,"ا",2,0],["قد هدمتم معاقلا وحصوناً","وأتحتم للخصم ما لا يتاح",79,"ح",1,0],["قَد هَزَّ مِن أَغصانِهِ ذَوابِلاً","وَسَلَّ من غُدرانِهُ مَناصِلا",80,"ل",2,0],["قد هَزِئَتْ جارتي لما نَكرَتْ","فزادَ ما في الفؤادِ مَهْزؤها",81,"ا",3,0],["قَد هدمَ الناسُ ما بنَوهُ","من مَجدِها وهو بعدُ بانِ",82,"ن",1,0],["قَد هَذَّبَت إِقليمه أَقلامِهِ","وانقاد سيده انقياد مسودِهِ",83,"د",2,0],["قد هتكت الغصون عطفاً وليناً","بقوام يهتز تحت بنودك",84,"ك",1,0],["قد همت وجدا مذ رايت سناءها","بالكاس يحكي شعلة النبراس",85,"س",1,0],["قد هيجت وجدي لبسط العتاب","صحيفة جاءت بفصل الخطاب",86,"ب",1,1],["قد هام في أسرارها","من بعد جابر الف جابر",87,"ر",1,0],["قد هندسوا وبنوا بنا","يات لهم شادت مفاخر",87,"ر",1,0],["قد هوّنتْ عنديَ التوالي","من شَرِّك السُّبَّقُ الأَوالي",88,"ي",1,0],["قد هان عندي وهو ليس بهيّنٍ","ذنبُ الليالي وهو من حسناتها",89,"ت",3,0],["قدها معتدلٌ يظلمني","حربي من قدّها المعتدل",90,"ل",1,0],["قَد هَجَونا وَكانَ غَيرَ صَوابِ","وَرَمَينا لِعَنبَرٍ في تُرابِ",91,"ب",1,0],["قد هدى الأولياء نور هدانا","وبنا حرا فكرها الأعداءُ",92,"ا",2,0],["قد هاجَ حُزني حُزنُ والدَيَّا","لِذا رفَعتُ طالباً يَدَيَّ",93,"ي",1,0],["قد هالَهُم من بعد حَبسي صولةٌ","يَقوى زئيرُ اللَّيثِ إن هو أخدَر",94,"ر",1,0],["قَد هَوَيناهُ ناقِضاً للعُهودِ","وَضَنيناً بِالوعدِ والموعودِ",95,"د",1,1],["قد هدينا بالخاطر المستقيمِ","لحديث عن الحبيب قديمِ",96,"م",1,1],["قد هاجتِ الشَوقَ مني نحو مُرسِلِها","فأَصبَحَ السَمْعُ محسوداً من البَصَرِ",97,"ر",1,0],["قد هاجَ إلاَّ عليها الخُلفُ غارقةً","فيهِ المُلوكُ ولم يَلحَقْ بها بَلَلُ",98,"ل",1,0],["قد هجونا بني الزَمانِ فنِلنا","حَظَّ هجوٍ لأنّنا مِن بنيهِ",99,"ي",2,0],["قَدْ هِمْتُ شَوْقَاً إِلَى وُجُوهِهِمْ","تِلْكَ الوُجُوهُ البَهِيَّةُ النَّضِرَهْ",100,"ر",2,0],["قد هِمْتُ بالبدوَيِّ في الحُللِ","وكَلِفْتُ بالحَضَرِيِّ في الكِلل",101,"ل",1,1]]}