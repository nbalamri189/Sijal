{"poems":[[88,"ردا كؤوسكما عن شبه مفؤود","https://www.aldiwan.net/poem10500.html","البسيط"],[56,"سألوني اليمين فارتعت منهم","https://www.aldiwan.net/poem27390.html","الخفيف"],[99,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[99,"جئتُ أشكو لكِ روحي وجواها","https://www.aldiwan.net/poem24757.html","الرمل"],[33,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[107,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[54,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85369","الخفيف"],[53,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[33,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[382,"إني ودينك يا من جاد بالبعث","https://www.aldiwan.net/poem66896.html","البسيط"],[396,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[445,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[520,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[563,"صبغة الله وجود الله","https://www.aldiwan.net/poem33628.html","الرمل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130201","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76672","الكامل"],[1985,"","https://poetry.dctabudhabi.ae/diwan/poem/132437","الرمل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136898","الرمل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47157","الكامل"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143052","الرمل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106980","الرجز"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84514","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130774","الخفيف"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121374","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97913","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139985","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205952","الرمل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199021","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133242","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136607",""],[5216,"النّيل","https://www.poetsgate.com/ViewPoem.aspx?id=186992",""],[5190,"نامي بظلِّ قصائدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78344&r=&rc=57",""]],"verses":[["ثُمَّ اِمضِيا وَدَعاني إِنَّني رَجُلٌ","قَد آلَ أَمري إِلى هَمٍّ وَتَسهيدِ",0,"د",1,0],["ثُمَّ أَمرَرتُها كَمُنحَدَرِ السَي","لِ تَهاوى مِنَ المَكانِ اليَفاعِ",1,"ع",1,0],["ثم أمسى مطربشاً واكتسى البذ","لة ما بين ليلةٍ ونهارِ",2,"ر",1,0],["ثم أمسى مبرنطاً يقصد السي","ن ويغزو مدينة الأنوارِ",2,"ر",1,0],["ثم أمضي لحياةٍ مرَّةٍ","صبحُها عندي سواءٌ ومَسَاهَا",3,"ا",3,0],["ثُمَّ إِمّا يَسرونَ مِن آخِرِ اللَي","لِ وَإِمّا يُعَجِّلونَ اِبتِكارا",4,"ر",2,0],["ثُمامةُ كيفَ أنتَ وأيُّ نُعْمَى","ظَفِرْتَ بها فأعْوَزَها التَّمامُ",5,"م",1,0],["ثُمامَةُ لا تَخَفْ ما عِشْتَ شَرّاً","تَجلَّى النُّورُ وانْقَشَعَ الظّلامُ",5,"م",1,0],["ثُمامةُ خُنْتنا وَصَبأْتَ عنّا","فليس لِصَدْعِ أنفُسِنا الْتِئَامُ",5,"م",1,0],["ثُمَّ أَمسَوا وَفدَ القُبورِ وَسُكّا","نَ الثَرى تَحتَ جَندَلٍ مَنصوبِ",6,"ب",1,0],["ثمَّ أمالَ نحوَ بَنْبلونَه","واقتحمَ العسكرُ في المدينَهْ",7,"ه",1,0],["ثم آمنت ثم ألحدتُ حتى","قيل هذا مذبذب ممرور",8,"ر",1,0],["ثُمَّ آمالا قد حرصت عليهن","نَ وَلَمّا أَحقق الآمالا",9,"ل",2,0],["ثمَّامة ُ المِسْكِ تُلقى وهي نائية","فنأيُها بنميم المسكِ لقيان",10,"ن",1,0],["ثُمَّ إمّا يَسْرُونَ مِنْ آخِرِ اللَّيْ","لِ وإمّا يُعَجِّلُونَ کبْتِكَارا",11,"ر",2,0],["ثمَّ أَمالَت عَينها الساهِيَه","عن عَينه الكَئيبَة الباكِيَه",12,"ه",1,0],["ثم أمسَت ذكرى شباب وحسنٍ","تلهم الدمع أن يذلّ فيسجم",13,"م",1,0],["ثم امتلكتم لهم أرضاً وملكهم","به وملكتموه مربع الجدث",14,"ث",1,0],["ثم امسح الرأس أو بعضه ولو ما يزال","واغسل لرجليك والترتيب ختم الخلال",15,"ل",1,0],["ثُمَّ أَمُّوا الراحَةَ العُلْيا الَّتِي","عَمَّتِ الدُّنيا أَماناً وَصَفَدْ",16,"د",1,0],["ثم امتطى ثبج المنايا طالباً","جدثاً يناط بصخرة صماء",17,"ا",2,0],["ثم أمر الله قل واحدة","مثل لمح البصر الأوّاه",18,"ه",1,0],["ثم امتطى طرف المفاخر ملجماً","واستل رأياً في الوقائع مسرجا",19,"ج",2,0],["ثم أمسى يزف تذكار فخر","لأبى طارق زكى الرضاع",20,"ع",1,0],["ثم امض في على اختيا","رك من فناء او بقاء",21,"ا",2,0],["ثم أمسيت مطيعا أمره","لست أعصي إن نهاني أو أمر",22,"ر",1,0],["ثم أمسوا عبرا مبثوثة","في حواشي الأرض للمعتبرين",23,"ن",1,0],["ثمّ امتطت متن المحدّب بعدما","لبّى بقيّةَ عمرها التّرحالُ",24,"ل",1,0],["ثمّ أمتصّ رحيقاً منْ شفاهٍ قبّلتني","لا تعاتبني! تمهّل! لستُ من قوم التّأنّي",25,"ن",2,0],["ثم امتطينا للسويد ركائباً","لا الركض يجهدها ولا التسيار",26,"ر",1,0],["ثم إملئي حضني به","يموج مثل الزبد",27,"د",1,0],["ثمام الحنا سهل لَدى كل قاطِف","وَزهر العلا يحمي بأيد عوابث",28,"ث",1,0],["ثم أمسى وما ارتوى بورودٍ","وسواه بريّه منشَرح",29,"ح",1,0],["ثم امتياز الضاد سهلٌ عند من","عاناه بالتلقين والإلقاء",30,"ا",2,0],["ثم امتطاها عبدُ شمس فاغتدت","هزؤاً وبدل ربحها بخسار",31,"ر",1,0],["ثم أمضى كأنني","عنهُ في غفلةٍ حجر",32,"ر",1,0],["ثمامةُ جسمي أرتجي أن يغيثها","إلهي بقرب منه للشوق غائث",33,"ث",1,0],["ثم أمت قبر النبي لتشكو","قومه وهي نفثة المصدور",34,"ر",1,0],["ثم أمسينا وبي من طعنه","حرقات داميات وسمام",35,"م",1,0],["ثم أمام سادس الجهات","وهكذا مقترن الصفات",36,"ت",1,0],["ثم امتطيت سفينة البر التي","كانت بسرعتها تحاكى المفتخر",37,"ر",1,0],["ثُمَّ أَمَّت غُرفَةض شادَ لَها","نَجلَها الصانِعُ هيفَستُ النَبيل",38,"ل",1,0],["ثم امض وانحر كل خوفٍ ينزوي","بالنفسِ فالجبنُ البغيضُ قلاكَ",39,"ك",1,0],["ثُمَ أَما عَرَف الأُفق وَدَبا","سَوفَ لا يَبحَث إِلّا عَن حَبيب",40,"ب",1,0],["ثُمَ أَما عَرف الأُفق وَشَبا","سَوفَ لا يَبحَث إِلّا عَن حَبيب",40,"ب",1,0],["ثُمَّ امرُؤُ القَيسِ بنُ حُجرٍ بَعدَهُ","قد خلعَ العَيشَ بِسمٍّ مُكتَسى",41,"ا",1,0],["ثم أمسكت مُهجة جرَّد الوَجد","عليها حسامَه الَمصقولا",42,"ل",2,0],["ثمَّ امتَثلْتَ لِأمرِ ربِّكِ طائعًا","وَرضيتَ بالهادي الأمينِ رَسولا",43,"ل",2,0],["ثمَّ امتطيتُ جوادَ عِزٍّ جامحٍ","وكتابُ ربِّي منهجي وإمامي",44,"م",2,0]]}