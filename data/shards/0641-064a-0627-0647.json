{"poems":[[110,"أذن بمن في السرى","https://www.shoaraa.com/p11793",""],[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[95,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[53,"أتاني مقال من أخ فاغتفرته","https://www.aldiwan.net/poem8311.html","الطويل"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[94,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[45,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[63,"ذكرناه فانهلت مدامعنا تترى","https://www.aldiwan.net/poem51643.html","الطويل"],[60,"حقيق بالتواضع من يموت","https://www.aldiwan.net/poem31127.html","الوافر"],[51,"تمسكت بآمال","https://www.aldiwan.net/poem63070.html","الهزج"],[68,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[119,"الى البدوي خطاف الاسير","https://www.aldiwan.net/poem41093.html","عموديه"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[164,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[308,"في أهل مصرٍ معان","https://www.aldiwan.net/poem58239.html","المجتث"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[382,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[398,"أسد ولكن الكلاب","https://www.aldiwan.net/poem53595.html","مجزوء الكامل"],[402,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11010.html","عموديه"],[443,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[473,"أجود فلا أبقي ورائي ذخيرة","https://www.aldiwan.net/poem59649.html","الطويل"],[543,"هنيئا بأمس الأمس إذ ضاع لي حقي","https://www.aldiwan.net/poem47546.html","عموديه"],[556,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[748,"","https://poetry.dctabudhabi.ae/diwan/poem/131362","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38016","السلسلة"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59682","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107197","الوافر"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133786","المتقارب"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101107","السريع"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121920","الطويل"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105650","الكامل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140204",""],[2499,"","https://poetry.dctabudhabi.ae/diwan/poem/96093","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130771","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130798",""],[2783,"","https://poetry.dctabudhabi.ae/diwan/poem/35030","الطويل"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105594","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100343","الهزج"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147354","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100174","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91765","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91445","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133075","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133078","الطويل"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[1703,"مضى طاهر البردين جذلان هانياً","https://www.poetsgate.com/ViewPoem.aspx?id=49924",""],[4884,"مشاعر أب","https://www.poetsgate.com/ViewPoem.aspx?id=212243",""],[5000,"تَعالَي! أنيري سماءَ الحياةِ","https://www.poetsgate.com/ViewPoem.aspx?id=5073",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5703,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=207240",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5997,"عسى يا ليالي","https://www.poetsgate.com/ViewPoem.aspx?id=214241",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6093,"إِنَّ السُّمَاةَ إِلى مَدِيْحِ مُحَمَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=186686",""]],"verses":[["فيا هداةً أبى المولى بغائبهم","أن يُخلي الأرض منهم حجة فينا",0,"ن",2,0],["فَيا هَضْبَةَ العُلْيا ويا مُزْنَةَ النّدى","ويا مَفْخَرَ الدُّنْيا ويا قَمَرَ النّدي",1,"د",2,0],["فَيا هادِيَ المِنهاجِ جُرتَ فَإِنَّما","هُوَ الفَجرُ يَهديكَ الصِراطَ أَوِ البَجرُ",2,"ر",1,0],["فَيَا هِنْدُ مُنَى مُهْجَتِي","ونَاهِية القَلْبِ والآمِرَهْ",3,"ر",2,0],["فَيَا هَذِهِ الْجَنَّاتُ بَيْنَ مِهَادِهَا","وَبَيْنَ الثَّنِيَّاتِ الْجَمَالُ المُتَمِّمُ",4,"م",1,0],["فيا هارباً من سُخطنا مُتنصلاً","هربتَ إلى أنجى مَفرٍّ ومَهربِ",5,"ب",1,0],["في اِهتِزازِ الغُصنِ في نَفحِ الصَبا","في اِنسِجامِ الغَيثِ في لَمحِ البُروق",6,"ق",1,0],["في آهةِ الشَّاكي","وضوضاءِ الجموع الصَّاخبهْ",7,"ه",1,0],["فيا هِرمَلَ الدنيا ويا عبرَة الورى","ويا أيُّها المخصِيُّ مَن أُمُّكَ البظرا",8,"ر",2,0],["فيا هالكاً أعرى الصديقَ بهُلْكِه","وعَزَّ على تلكَ الأناملِ أن تَعرى",9,"ر",2,0],["فَيا هَذا سَتَرحَلُ عَن قَريبٍ","إِلى قَومٍ كَلامُهُمُ سُكوُتُ",10,"ت",1,0],["فَيا هَذا تَجَهَّز لِ","فِراقِ الأَهلِ وَالمالِ",11,"ل",1,0],["فَيا هالِكاً قَد أَطمَعَ الخَطبَ هُلكُهُ","وَكانَ بِهِ طَرفُ النَوائِبِ يُطرَفُ",12,"ف",1,0],["فَيا هِندُ وانٍ عَنِ المَكرُما","تِ مَن لا يُساوِرُ بِالهُندُواني",13,"ن",2,0],["في أَهاوٍ مِنَ الهَوانِ وَقَد كُن","ت مِنَ العِزِّ في غزار ونَشزِ",14,"ز",1,0],["فيا هذا الملثم جد حنانا","فانك صاحب الفضل الوفير",15,"ر",1,0],["فَيا هَمُّ دُم وَاِنفِ الرُقادَ فَإِنَّني","وَجَدتُكَ مِنهُ الآنَ أَحفى وَأَرأَفا",16,"ف",2,0],["فيا هاربا عنه رويدا فعزمه","كظلك أني سرت سار متابعا",17,"ع",2,0],["فيا هنايَ اذا نلت القلوب بها","وقيل يا ابن مليك انت مقبول",18,"ل",1,0],["فَيا هَلْ يَلذُّ العَيشُ مِن بَعدِهم وَهَل","تَعودُ الليالِي بِالقَديمِ مِنَ الودِّ",19,"د",1,0],["في أهل مصرٍ معانٍ","من لطفهم تستفاد",20,"د",1,1],["فَيا هَمُّ حَربٌ ثمَّ لا صُلحَ بَعدَها","وَيادَهرُ صُلحٌ ما لَنا بَعدَهُ عَتبُ",21,"ب",1,0],["فَيا هاشِمِيّاً أَعقَبوهُ بِهاشِمٍ","وَيا عَرَبِيّاً عاقَبوهُ بِأَعجَما",22,"م",2,0],["فيا هيكلاً في الحسن جاءَ كصورةٍ","مشيَّدةٍ في هيكل بِدَرانك",23,"ك",1,0],["في أَهلِ حيَّ على الصلا","ةِ وَأَهلِ حَيَّ عَلى الفَلاحِ",24,"ح",1,0],["فيا هند أنت منى مهجتي","وناهية القلب والآخره",25,"ر",2,0],["فيا هاجري من غير ذنب جنتيه","أيجمل أن أرضاك خبا وأن تأبى",26,"ب",2,0],["في أَهْلِ دَارٍ كالكَوَاكِبِ والنَّوى","بَعْدَ النَّوى فَلَكٌ بِهِمْ دَوَّارُ",27,"ر",1,0],["فَيا هَذِهِ لا تَعجَبي لِتَكُرُّمي","فَمَن كانَ مِثلي كَيفَ لا يَتَكَرَّمُ",28,"م",1,0],["فيا هِرّةً ترنُو إلىَّ بنظرَةٍ","ونظرَتُها والهِ أغنَت عنِ النُّطقِ",29,"ق",1,0],["فَيا هبةَ اللَّهِ اِرتُجعتَ إلى الرّدى","وقد كنت في فضلٍ ذُبالةَ نادِ",30,"د",1,0],["في أهل حصن قد رضوا بحكمه","لعلمهم بفضله وعلمه",31,"ه",1,0],["فيا هول ذا المشروط أول وهلة","أعيد وأبدى من بعودي أعادني",32,"ي",1,0],["فيا هالكاً هلك المكارم فقده","وأنفع حي هو أفقد هالك",33,"ك",1,0],["في أهيَبِ ليثٍ وفي أجلِّ مهيبٍ","مَن مِنهُ تَوَلَّت مِنَ المَهابَةِ أَبطالْ",34,"ل",1,0],["فيا هل يرتوي منها صدايا","ويا هل ينطفي هذا الأوام",35,"م",1,0],["فيَا هَذا رَعاكَ اللَّه زِدنِي","فَهَذا الخَمرُ لا كاسُ المُدامَه",36,"م",2,0],["فيا هاتفاً واعداً بالصباح","مضى العمر والصبح لم يطلع",37,"ع",1,0],["فيا هداة ان دجت في الورى","غياهب الغي بهم يهتدى",38,"د",2,0],["فيا هاجري \"والصد\" للصبِّ قاتل","وروض \"نعيمي\" في رضاك وخلدُه",39,"د",2,0],["فيا هل أتى ابن النيل ما حل بعده","بمصر وما أدراه بالنيل ما لقى",40,"ق",2,0],["فيا هل إلى ربع الأعاريب عودة","فذاك وحق الله ربع حببناه",41,"ن",3,0],["فيا هل ترى هل للحبيب تشوق","اليّ كأشواقى له وغرامي",42,"م",2,0],["في آهة الشاكي شعورك ثائراً","وعلى السوائل من دموع الباكي",43,"ك",2,0],["فيا هل ترى أني أتم دراستي","لها أو أخلي الدهر يهذي ويصخب",44,"ب",1,0],["فيا هجرَ ليلي قد بلغتَ بِيَ المَدى","وزِدتّ على ما لم يكن بَلَغ الهجر",45,"ر",1,0],["فيا هند مرحى بالمودة بيننا","وبالحب والاخلاص في موطن الطهر",46,"ر",1,0],["في اهبة العدوان لم يبرحا","يهدد ان السلم في وكره",47,"ر",2,0],["فَيا هَدبُ لِلهيجا وَيا هَدبُ لِلنَّدى","وَيا هَدبُ لِلخَصمِ الأَلَدِّ يُحارِبُهُ",48,"ب",2,0],["فيا هل إلى ذاك الحمى عن قبيلة","عسى حر قلب الصب يطفى ببرده",49,"د",2,0],["فيا هزهازة الكشحِ","ويا جراجة الردف",50,"ف",1,0],["فَيَا هطَلاتِ الغَيْثِ رُحْمَاكِ أنْبِتِيْ","وُرُودَ التُّقَى مَا بَيْنَ دَمْعِيْ ومَبْسَمِيْ",51,"م",2,0],["فيا هاجراً حاشاه لا عن ملالةٍ","وتراك وجد لا يبارح لاهبه",52,"ب",2,0],["فياهل ترى لم بدّلوا دين اهلهم","وعرفاً به امتازوا على الناس بالنكر",53,"ر",1,0],["فَيا هَل تَرى عَيني لبعدك غاية","وَهَل تبدء الأَيام يَوماً بِما نَهوى",54,"و",2,0],["فَيا هاجِراً أَبكَى الخَليلَ وَإِنَّما","غُروبُ ذُكاء الأُفق قَد أَوجب النوءا",55,"ا",2,0],["فيا هل لأيام الوصالِ بعودةٍ","وهل يرجع المعهود يا أم عامر",56,"ر",1,0],["فيا هل لذاك الوقت يا سعد عودةٌ","وشيبي على الجسم الضعيف مسيح",57,"ح",1,0],["فيا (هنداً) وَ يَا (ميسا) .. بُلِيتمْ","ب (كنتاكي) كسالِفه .. ولا (فَرْ..)",58,"ر",1,0],["فيا هول تلك السّاعة اهتزّ خاطري","لها وكما أحسست صغت القوافيا",59,"ي",2,0],["فيا هازمُ الأحزابِ بالبطشِ وحده","أيا ربِّ قد طالَ الفراقُ ومرُّهُ",60,"ر",2,0],["فيا هاجري بالحَشا جَمرةٌ !","وجفني حَريقٌ ودمعي مُراقْ",61,"ق",1,0],["فيا هو بالله سبحان وجهك ال","مقدس يا رحمن يا هو أجب يا هو",62,"ا",3,0],["فيا هَجْرَ الذي تفديهِ رُوحي","سَلاماً كُنْ على قَلبي وبَرْدا",63,"د",2,0],["فيا هذه الجنابت بين مهادها","وبين الثنيات الجمال المتمم",64,"م",1,0],["فيا هاجراً يكفي من البعد والنوى","فعدْ إنّ عيني تذرفُ الدمع ماطرا",65,"ر",2,0],["فَيَا هَلْ عَلِمتُمْ وأنتُمْ هُنَا","كَ مَا عِنْدَنَا مِنْكُمُ هَا هُنَا",66,"ن",2,0],["في أهْلِه في آلِه في صَحْبِهِ","في وَصْفِهِ واللهُ قَدْ حَلَّاهُ *",67,"ا",2,0]]}