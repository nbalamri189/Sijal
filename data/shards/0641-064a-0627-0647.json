{"poems":[[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[93,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[51,"أتاني مقال من أخ فاغتفرته","https://www.aldiwan.net/poem8311.html","الطويل"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[61,"ذكرناه فانهلت مدامعنا تترى","https://www.aldiwan.net/poem51643.html","الطويل"],[58,"حقيق بالتواضع من يموت","https://www.aldiwan.net/poem31127.html","الوافر"],[49,"تمسكت بآمال","https://www.aldiwan.net/poem63070.html","الهزج"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[113,"الى البدوي خطاف الاسير","https://www.aldiwan.net/poem41093.html","عموديه"],[141,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[158,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[273,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[301,"في أهل مصرٍ معان","https://www.aldiwan.net/poem58239.html","المجتث"],[364,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[364,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[374,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[390,"أسد ولكن الكلاب","https://www.aldiwan.net/poem53595.html","مجزوء الكامل"],[394,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11010.html","عموديه"],[434,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[436,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[466,"أجود فلا أبقي ورائي ذخيرة","https://www.aldiwan.net/poem59649.html","الطويل"],[536,"هنيئا بأمس الأمس إذ ضاع لي حقي","https://www.aldiwan.net/poem47546.html","عموديه"],[549,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَيا هَضْبَةَ العُلْيا ويا مُزْنَةَ النّدى","ويا مَفْخَرَ الدُّنْيا ويا قَمَرَ النّدي",0,"د",2,0],["فَيا هادِيَ المِنهاجِ جُرتَ فَإِنَّما","هُوَ الفَجرُ يَهديكَ الصِراطَ أَوِ البَجرُ",1,"ر",1,0],["فَيَا هِنْدُ مُنَى مُهْجَتِي","ونَاهِية القَلْبِ والآمِرَهْ",2,"ر",2,0],["فَيَا هَذِهِ الْجَنَّاتُ بَيْنَ مِهَادِهَا","وَبَيْنَ الثَّنِيَّاتِ الْجَمَالُ المُتَمِّمُ",3,"م",1,0],["فيا هارباً من سُخطنا مُتنصلاً","هربتَ إلى أنجى مَفرٍّ ومَهربِ",4,"ب",1,0],["في اِهتِزازِ الغُصنِ في نَفحِ الصَبا","في اِنسِجامِ الغَيثِ في لَمحِ البُروق",5,"ق",1,0],["في آهةِ الشَّاكي","وضوضاءِ الجموع الصَّاخبهْ",6,"ه",1,0],["فيا هِرمَلَ الدنيا ويا عبرَة الورى","ويا أيُّها المخصِيُّ مَن أُمُّكَ البظرا",7,"ر",2,0],["فيا هالكاً أعرى الصديقَ بهُلْكِه","وعَزَّ على تلكَ الأناملِ أن تَعرى",8,"ر",2,0],["فَيا هَذا سَتَرحَلُ عَن قَريبٍ","إِلى قَومٍ كَلامُهُمُ سُكوُتُ",9,"ت",1,0],["فَيا هَذا تَجَهَّز لِ","فِراقِ الأَهلِ وَالمالِ",10,"ل",1,0],["فَيا هالِكاً قَد أَطمَعَ الخَطبَ هُلكُهُ","وَكانَ بِهِ طَرفُ النَوائِبِ يُطرَفُ",11,"ف",1,0],["فَيا هِندُ وانٍ عَنِ المَكرُما","تِ مَن لا يُساوِرُ بِالهُندُواني",12,"ن",2,0],["في أَهاوٍ مِنَ الهَوانِ وَقَد كُن","ت مِنَ العِزِّ في غزار ونَشزِ",13,"ز",1,0],["فيا هذا الملثم جد حنانا","فانك صاحب الفضل الوفير",14,"ر",1,0],["فَيا هَمُّ دُم وَاِنفِ الرُقادَ فَإِنَّني","وَجَدتُكَ مِنهُ الآنَ أَحفى وَأَرأَفا",15,"ف",2,0],["فيا هاربا عنه رويدا فعزمه","كظلك أني سرت سار متابعا",16,"ع",2,0],["فيا هنايَ اذا نلت القلوب بها","وقيل يا ابن مليك انت مقبول",17,"ل",1,0],["فَيا هَلْ يَلذُّ العَيشُ مِن بَعدِهم وَهَل","تَعودُ الليالِي بِالقَديمِ مِنَ الودِّ",18,"د",1,0],["في أهل مصرٍ معانٍ","من لطفهم تستفاد",19,"د",1,1],["فَيا هَمُّ حَربٌ ثمَّ لا صُلحَ بَعدَها","وَيادَهرُ صُلحٌ ما لَنا بَعدَهُ عَتبُ",20,"ب",1,0],["فَيا هاشِمِيّاً أَعقَبوهُ بِهاشِمٍ","وَيا عَرَبِيّاً عاقَبوهُ بِأَعجَما",21,"م",2,0],["فيا هيكلاً في الحسن جاءَ كصورةٍ","مشيَّدةٍ في هيكل بِدَرانك",22,"ك",1,0],["في أَهلِ حيَّ على الصلا","ةِ وَأَهلِ حَيَّ عَلى الفَلاحِ",23,"ح",1,0],["فيا هند أنت منى مهجتي","وناهية القلب والآخره",24,"ر",2,0],["فيا هاجري من غير ذنب جنتيه","أيجمل أن أرضاك خبا وأن تأبى",25,"ب",2,0],["في أَهْلِ دَارٍ كالكَوَاكِبِ والنَّوى","بَعْدَ النَّوى فَلَكٌ بِهِمْ دَوَّارُ",26,"ر",1,0],["فَيا هَذِهِ لا تَعجَبي لِتَكُرُّمي","فَمَن كانَ مِثلي كَيفَ لا يَتَكَرَّمُ",27,"م",1,0],["فيا هِرّةً ترنُو إلىَّ بنظرَةٍ","ونظرَتُها والهِ أغنَت عنِ النُّطقِ",28,"ق",1,0],["فَيا هبةَ اللَّهِ اِرتُجعتَ إلى الرّدى","وقد كنت في فضلٍ ذُبالةَ نادِ",29,"د",1,0],["في أهل حصن قد رضوا بحكمه","لعلمهم بفضله وعلمه",30,"ه",1,0]]}