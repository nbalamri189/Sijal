{"poems":[[23,"وممسك بصداع الرأس من سكر","https://www.aldiwan.net/poem21307.html","البسيط"],[91,"عجبا لمن أمسى وكل فخاره","https://www.aldiwan.net/poem8987.html","عموديه"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[62,"إن الألى أرضاك قولهم","https://www.aldiwan.net/poem52360.html","أحذ الكامل"],[50,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[46,"قل للمشيب يد الأيام دائبة","https://www.aldiwan.net/poem23090.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42616","السريع"],[110,"لما صفت مرآة وجهك أيقنت","https://www.aldiwan.net/poem16568.html","الكامل"],[116,"لنا من الوجد في معنى حبائبنا","https://www.aldiwan.net/poem41768.html","البسيط"],[129,"مهما جرى حين مل الوصل مت هوى","https://www.aldiwan.net/poem50590.html","البسيط"],[151,"صرحت بالحب إذ لم يجد تلميح","https://www.aldiwan.net/poem68455.html","البسيط"],[151,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[238,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[262,"لما صفت مرآة حسنك للورى","https://www.aldiwan.net/poem38111.html","الكامل"],[298,"أرأيت بين المأزمين كواعبا","https://www.aldiwan.net/poem33329.html","الكامل"],[299,"ورقاء ذات تفجع","https://www.aldiwan.net/poem36852.html","عموديه"],[310,"إذا ما عضك الدهر","https://www.aldiwan.net/poem50269.html","الهزج"],[321,"كان التنقل في الغرام يلذ لي","https://www.aldiwan.net/poem61736.html","الكامل"],[350,"أويت ربعا لا المقيم بظله","https://www.aldiwan.net/poem15607.html","الكامل"],[407,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[478,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[554,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[560,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[576,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["لَمّا صَحا وَتَراخى العَيشُ قُلتُ لَهُ","إِنَّ الحَياةَ وَإِنَّ المَوتَ مِثلانِ",0,"ن",1,0],["لَمّا صَديقي صارَ مِن أَهلِ الغِنى","أَيقَنتُ أَنّي قَد أَضَعتُ صَديقي",1,"ق",2,0],["لَمّا صَدَعتَ جَناحَيهِم وَقَلبَهُمُ","طاروا بِأَجنِحَةٍ شَتّى مِنَ الرُعبِ",2,"ب",1,0],["لما صفَا ملكُ الجمالِ لهمْ","تاهوا على العُشَّاقِ واشتطُّوا",3,"ط",3,0],["لَم أُصِب شافياً لِما بِيَ مِنها","غَيرَ شيءٍ ذَكَرتُهُ في القَصيدِ",4,"د",1,0],["لَمّا صَبِبتَ سُقيتَ الوَجدَ مُنحَنِياً","مِنَ الصَبيبِ أَو الحِنّاءِ يَسقيكا",5,"ك",2,0],["لَمْ أَصْطَبِرْ بَعْدَكَ مِنْ سَلْوَةٍ","لَكِنْ تَصَبَّرْتُ عَلَى جَمْرِ",6,"ر",1,1],["لَما صفت مِرآة وَجهك أَيقَنَت","عَينايَ إِني عُدتُ فيكَ خَيالا",7,"ل",2,1],["لما صفا في هواهم كأس شربنا","قد سحب الناس أذيال الظنون بنا",8,"ن",2,0],["لما صَفَا لم يزل قلبي على وَجلى","مُعَذِّبى مهجتى ثوبُ الشقا مَنْ كَسَا",9,"س",2,0],["لم أصغ فيكم غلى لوم ولا عذل","سيّان عندي ذاك العذلُ والريح",10,"ح",1,0],["لما صَوَّحَ المَرعى وَلا ذَبَلَ البَقلُ","خَرَجنا بِهِ مِن كُلِّ ضيقٍ وَغُمَّةٍ",11,"ه",1,0],["لَما صحّتِ الدَعوى بإسلام بعضهم","لديَّ وما اِستبعدتُ عَن بَعضِهم كفرا",12,"ر",2,0],["لَمْ أَصْحُ مِنْ سُكْرِي بِتَعْنِيقِهِ","إِلاَّ بِتَقْطِيعِي عَلَى فُرْقَتِهِ",13,"ت",2,0],["لما صفت مرآة حسنك للورى","ورأى بذاتك من يراك خياله",14,"ه",1,1],["لَم أَصحُ قطُّ وَكَيفَ يَصحو في الهَوى","مَن راحَ مِن راحِ المحبَّة شارِبا",15,"ب",2,0],["لم أَصح مذ جفناك دا","فا في الغرامَ بمترع",16,"ع",1,0],["لَما صادَفتَ مَن يَقدِ","ر أَن يسعد أَو يشقي",17,"ق",2,0],["لِمَ أَصبَحَت لِلَومٍ فيكَ مُجيزَة","إِنّي وَحُبُّكَ قَد غَدَوتِ غَريزَةً",18,"ه",1,0],["لَم أَصِف فيهِ مَوَدَّتي لِمَعاشِرِ","إِلّا وَأَضفاني كَدَورَةِ وِدِّهِ",19,"د",2,0],["لَمّا صَفا قلبه شَفَّت سَرائره","وَالشَيء في كل صافٍ غير مُكتتمِ",20,"م",1,0],["لم أُصغِ فيهِ إلى مقالةِ عاذلٍ","يَلْحى عليهِ ولا نميمةِ كاشحِ",21,"ح",1,0],["لِمَ أصبحتِ لي ثماداً وقد كن","تِ لمن يبتغي نَداكِ بحارا",22,"ر",2,0],["لَم أَصحُ مِن لَذَّةٍ لا لا وَلا طَرَبٍ","وَكَيفَ يَصحُ قَرينُ اللَهوِ وَاللَعِبِ",23,"ب",1,1],["لَمَّا صَفا لِلْهَوَى بِجدِ","أسْلمَهُ الخِلُّ والحميمُ",24,"م",1,0],["لما صديتُ لها ركبتُ على الصَّبا","حتى وصلتُ إِلى الغمامِ المسْبل",25,"ل",1,0]]}