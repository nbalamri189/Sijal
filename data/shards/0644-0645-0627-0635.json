{"poems":[[23,"وممسك بصداع الرأس من سكر","https://www.aldiwan.net/poem21307.html","البسيط"],[93,"عجبا لمن أمسى وكل فخاره","https://www.aldiwan.net/poem8987.html","عموديه"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[64,"إن الألى أرضاك قولهم","https://www.aldiwan.net/poem52360.html","أحذ الكامل"],[52,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[48,"قل للمشيب يد الأيام دائبة","https://www.aldiwan.net/poem23090.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42616","السريع"],[111,"يا أخا عبس الحماة الأنوف","https://www.poetsgate.com/ViewPoem.aspx?id=529",""],[113,"لما صفت مرآة وجهك أيقنت","https://www.aldiwan.net/poem16568.html","الكامل"],[119,"لنا من الوجد في معنى حبائبنا","https://www.aldiwan.net/poem41768.html","البسيط"],[132,"مهما جرى حين مل الوصل مت هوى","https://www.aldiwan.net/poem50590.html","البسيط"],[154,"صرحت بالحب إذ لم يجد تلميح","https://www.aldiwan.net/poem68455.html","البسيط"],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[242,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[266,"لما صفت مرآة حسنك للورى","https://www.aldiwan.net/poem38111.html","الكامل"],[302,"أرأيت بين المأزمين كواعبا","https://www.aldiwan.net/poem33329.html","الكامل"],[303,"ورقاء ذات تفجع","https://www.aldiwan.net/poem36852.html","عموديه"],[314,"إذا ما عضك الدهر","https://www.aldiwan.net/poem50269.html","الهزج"],[325,"كان التنقل في الغرام يلذ لي","https://www.aldiwan.net/poem61736.html","الكامل"],[354,"أويت ربعا لا المقيم بظله","https://www.aldiwan.net/poem15607.html","الكامل"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[482,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[558,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[564,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[580,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86969","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86829","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63917","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145812","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119898","الكامل"],[2094,"","https://poetry.dctabudhabi.ae/diwan/poem/202651","الكامل"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124034","الطويل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33978","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137090",""],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48099","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146339","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100250","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105110","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124043","البسيط"],[4691,"كان حبّا عربيا","https://www.poetsgate.com/ViewPoem.aspx?id=216058",""],[1901,"خدعتك من سودِ العيونِ نواظرُ","https://www.poetsgate.com/ViewPoem.aspx?id=160381",""],[4929,"ازهر الرأس","https://www.poetsgate.com/ViewPoem.aspx?id=199507",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[2546,"أما والله لو جوزيت","https://www.poetsgate.com/ViewPoem.aspx?id=201440",""],[5956,"في القناعة سعادة","https://www.poetsgate.com/ViewPoem.aspx?id=184034",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6339,"نون النسوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87889&r=&rc=1",""]],"verses":[["لَمّا صَحا وَتَراخى العَيشُ قُلتُ لَهُ","إِنَّ الحَياةَ وَإِنَّ المَوتَ مِثلانِ",0,"ن",1,0],["لَمّا صَديقي صارَ مِن أَهلِ الغِنى","أَيقَنتُ أَنّي قَد أَضَعتُ صَديقي",1,"ق",2,0],["لَمّا صَدَعتَ جَناحَيهِم وَقَلبَهُمُ","طاروا بِأَجنِحَةٍ شَتّى مِنَ الرُعبِ",2,"ب",1,0],["لما صفَا ملكُ الجمالِ لهمْ","تاهوا على العُشَّاقِ واشتطُّوا",3,"ط",3,0],["لَم أُصِب شافياً لِما بِيَ مِنها","غَيرَ شيءٍ ذَكَرتُهُ في القَصيدِ",4,"د",1,0],["لَمّا صَبِبتَ سُقيتَ الوَجدَ مُنحَنِياً","مِنَ الصَبيبِ أَو الحِنّاءِ يَسقيكا",5,"ك",2,0],["لَمْ أَصْطَبِرْ بَعْدَكَ مِنْ سَلْوَةٍ","لَكِنْ تَصَبَّرْتُ عَلَى جَمْرِ",6,"ر",1,1],["لم أصارفك بالرجال وقد أيقن","ت منهم ببهرج وزيوف",7,"ف",1,0],["لَما صفت مِرآة وَجهك أَيقَنَت","عَينايَ إِني عُدتُ فيكَ خَيالا",8,"ل",2,1],["لما صفا في هواهم كأس شربنا","قد سحب الناس أذيال الظنون بنا",9,"ن",2,0],["لما صَفَا لم يزل قلبي على وَجلى","مُعَذِّبى مهجتى ثوبُ الشقا مَنْ كَسَا",10,"س",2,0],["لم أصغ فيكم غلى لوم ولا عذل","سيّان عندي ذاك العذلُ والريح",11,"ح",1,0],["لما صَوَّحَ المَرعى وَلا ذَبَلَ البَقلُ","خَرَجنا بِهِ مِن كُلِّ ضيقٍ وَغُمَّةٍ",12,"ه",1,0],["لَما صحّتِ الدَعوى بإسلام بعضهم","لديَّ وما اِستبعدتُ عَن بَعضِهم كفرا",13,"ر",2,0],["لَمْ أَصْحُ مِنْ سُكْرِي بِتَعْنِيقِهِ","إِلاَّ بِتَقْطِيعِي عَلَى فُرْقَتِهِ",14,"ت",2,0],["لما صفت مرآة حسنك للورى","ورأى بذاتك من يراك خياله",15,"ه",1,1],["لَم أَصحُ قطُّ وَكَيفَ يَصحو في الهَوى","مَن راحَ مِن راحِ المحبَّة شارِبا",16,"ب",2,0],["لم أَصح مذ جفناك دا","فا في الغرامَ بمترع",17,"ع",1,0],["لَما صادَفتَ مَن يَقدِ","ر أَن يسعد أَو يشقي",18,"ق",2,0],["لِمَ أَصبَحَت لِلَومٍ فيكَ مُجيزَة","إِنّي وَحُبُّكَ قَد غَدَوتِ غَريزَةً",19,"ه",1,0],["لَم أَصِف فيهِ مَوَدَّتي لِمَعاشِرِ","إِلّا وَأَضفاني كَدَورَةِ وِدِّهِ",20,"د",2,0],["لَمّا صَفا قلبه شَفَّت سَرائره","وَالشَيء في كل صافٍ غير مُكتتمِ",21,"م",1,0],["لم أُصغِ فيهِ إلى مقالةِ عاذلٍ","يَلْحى عليهِ ولا نميمةِ كاشحِ",22,"ح",1,0],["لِمَ أصبحتِ لي ثماداً وقد كن","تِ لمن يبتغي نَداكِ بحارا",23,"ر",2,0],["لَم أَصحُ مِن لَذَّةٍ لا لا وَلا طَرَبٍ","وَكَيفَ يَصحُ قَرينُ اللَهوِ وَاللَعِبِ",24,"ب",1,1],["لَمَّا صَفا لِلْهَوَى بِجدِ","أسْلمَهُ الخِلُّ والحميمُ",25,"م",1,0],["لما صديتُ لها ركبتُ على الصَّبا","حتى وصلتُ إِلى الغمامِ المسْبل",26,"ل",1,0],["لَما صَفا زَمَن الهَنا","وَعَلى خَليل قَد عطفْ",27,"ف",1,1],["لَما صارَ بِالتَحقيق فيما حَبا به","مِن الحَظ إِلّا دُون مِعشار عُشره",28,"ر",2,0],["لمَ أَصطفي قَذَراً من الأقذار بل","لمَ أرتضي رجساً من الأرجاس",29,"س",1,0],["لمْ أصطحِبْ غيرَ العراقِ بغربَتي","فأنا جلِيسُ أَسَاه ُفي الأرزاءِ",30,"ا",2,0],["لما صنعت له المديح رأى","حسنا فأحسن عنده الصنعا",31,"ع",2,0],["لِمَ أصبحتْ في الحكم أجْوَر جائرٍ","فَغَدَتْ بها الألبابُ طُرّاً تَذْهبُ",32,"ب",1,0],["لما صح من نهى النبي عن الذي","يترجم عن أهل الكتاب ذوي الكفر",33,"ر",1,0],["لَمّا صَدَّ الَّذي أَهوى","وَلا وَلا مَلَّ وَلا خانا",34,"ن",2,0],["لما صعدت الى اريكة مجدها","ظفرت بفال الطائر الميمون",35,"ن",1,0],["لما صَبَوْتُ قضى عَلَيَّ بظَنِّهِ","فأَجازَ فِي خَصْمٍ شهادَةَ خَصْمِهِ",36,"م",2,0],["لمّا صفا أَدبي تبيّن مجدُكم","لون المُدامة في الزجاج تبيّنا",37,"ن",2,0],["لم أصغ عذل عذول في علاك هذي","او تصغينَّ للاح ي نداك لحا",38,"ح",2,0],["لم أصخ للنصاح سمعاً ومثلي","لم يصخ سمعه إلى النصاح",39,"ح",1,0],["لَم أُصَدِّق فيه الحَديثَ وَإِن صح","حَ وَأَنّي بعد الرَدى مَبعوثُ",40,"ث",1,0],["لم أصب ويحكم لكن ذا بلد","لم ينسنيه تراخى العهد",41,"د",1,0],["لم أصبْ منها حرامًا","أو حلالا وهْي خلّة",42,"ل",2,0],["لم أًصبُ من تلقاءِ نفسي للهوى","لكنَّما إنسان عينكِ ساحرُ",43,"ر",1,0],["لم أصدق بفعلهنَّ إلى أن","نال قلبي من فعلهنَّ نصيبُ",44,"ب",1,0],["[ لَمَّا صَدَدْتِ ضُحَى جُبارِ فَمُهْجَتِي","لَكِ بِالصُّدُودِ ضُحَى جُبارِ جُبارُ ]",45,"ر",1,0],["لما صدّ الّذي أهوى","ولا ملّ ولا خانا",46,"ن",2,0],["لم أصطنعْ صنماً مثاليّاً بنى","معنى السعادة كي أتوق لِلَمْسِهِ",47,"ه",1,0],["لم أصدق كيف أنجو","أنا منه للكواكبْ",48,"ب",1,0],["لما صفوتم لنا غارت معادنهم","إذ كنتم الماسَ والياقوتَ والذهبا",49,"ب",2,0],["لَمْ أَصْبُ - يَومًا - لَنْ أَخُونَ أَمَانَتِي","\" زِيفَا \" , لِأَنِّيَ بِالقَضِيَّةِ مَعْقُودُ",50,"د",1,0],["‏لم أصحُ من شوق.. ينبّه مسمعي","‏عذلٌ.. ولكنّي أحب الغفوه",51,"و",2,0]]}