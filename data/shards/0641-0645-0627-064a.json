s://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[458,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[461,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[461,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[461,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[461,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[461,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[461,"يجلو الهموم إذا تدجو مذاهبها","https://www.aldiwan.net/poem16362.html","البسيط"],[464,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[464,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[470,"ليس بسعد النار من تذكرونه","https://www.aldiwan.net/poem4641.html","الطويل"],[493,"فما يقدح الفقر في حاله","https://www.aldiwan.net/poem67383.html","المتقارب"],[493,"وأحدقنا بأزهر خافقات","https://www.aldiwan.net/poem67419.html","مجزوء الوافر"],[506,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[515,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[515,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[515,"قبولاً وإن بان عجز الخواطر","https://www.aldiwan.net/poem12122.html","الطويل"],[515,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[515,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[515,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[527,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[529,"من دونها يا عمر وخز الرماح","https://www.aldiwan.net/poem37480.html","السريع"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[575,"حمزة كلب يعوي","https://www.aldiwan.net/poem2795.html","مجزوء الرجز"],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[586,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"]],"verses":[["فَما يَقولُ الأَعداءُ لا بَلَغوا ال","سُؤلَ وَلا أَدرَكوا الَّذي أَمِلوا",0,"ل",3,0],["فَما يَنسابُ لَحظُ الشَم","سِ أَو يَنسابُ طائِرُه",1,"ر",2,0],["فَما يَقرَعُ الجَهلُ إِلّا الحَليمَ","وَلا يَنكُثُ الخُرقُ إِلّا الوَقارا",2,"ر",2,0],["فَما يَتَهَدّى إِلَيهِ المُلو","كُ إِلّا مِنَ المَثَلِ السائِرِ",3,"ر",1,0],["فَما يَنفَعُ المَرءَ بَعدَ المَنونِ","قَولُ النَوادِبِ لا تَبعَدِ",4,"د",1,0],["فما يَبْتَغي فينا الهَوادَةَ كاشِحٌ","ولا نَعرِفُ الإخْوانَ إلا تَماريا",5,"ي",2,0],["فَما يُنجيكُمُ مِنّا شِبامٌ","وَلا قَطَنٌ وَلا أَهلُ الحَجونِ",6,"ن",1,1],["فَما يَنهَضُ البازي بِغَيرِ جَناحِهِ","وَما تَحمِلُ الساقَينِ إِلّا الحَوامِلُ",7,"ل",1,0],["فما يُعالِجُ من قَولٍ ولا عَمَلٍ","إلاّ أرادَ به للنّاسِ تَرفيها",8,"ي",3,0],["فَمَا ينْثنِي عَنْ قَصْدِهِ لِعَوائِقٍ","تَعوقُ وَلا يَلْوِي بِأَمْرٍ وَلا نَهْيِ",9,"ي",1,0],["فَمَا يُرَى نَقْعُهُ وَهْوَ الضَّبَابُ عَلا","تِلْكَ الرُّبَى فَدَحَاهَا دَحْوَ قِيعَانِ",10,"ن",1,0],["فَمَا يُحِيرُ جَوَاباً","يُزِيلُ حَيْرَةَ وَاجِمْ",11,"م",1,0],["فَمَا يُغْنِيهِ مِنْ حُسْنٍ طِلاءٌ","وَمَا يَبْغِيهِ إلاّ فِي الصَّمِيمِ",12,"م",1,0],["فَمَا يُغْنِي عَلَى التَّكْرَارِ قَوْلٌ","وَإنْ هُوَ غَيْرُ تَرْدِيدٍ عَقِيمِ",12,"م",1,0],["فَما يَنالُ بِها الهَيمانُ مَورَدَهُ","إِلّا بِنَصٍّ وَجَذبِ العيسِ بِالبُرَةِ",13,"ه",1,0],["فما يأملون العيش إلاّ تعلُّلاً","ولا يعرفون الأمن إلاّ أمانيا",14,"ي",2,0],["فَما يَستَوي داعي الضَلالَةِ وَالهُدى","وَلا حُجَّةُ الخَصمَينِ حَقٌّ وَباطِلُ",15,"ل",1,0],["فَما يَصبو إِلى أَرضٍ","سِوى أَرضي وَرُوّادي",16,"ي",1,0],["فَما يَجيءُ الدَهرَ مُعتَمِراً","إِلّا وَمِرجَلُ جَهلِهِ يَغلي",17,"ل",2,0],["فَما يَغلِبكَ أَو لا تَستَطِعهُ","مِنَ الأَشياءِ لا يَغلِب عِداءُ",18,"ا",2,0],["فما يصدكما والحالُ داعيةٌ","عن شربِ فاقعةٍ للهمِّ صفراء",19,"ا",2,0],["فما يبلى جوايَ ولا أنادي","عليّ لي ولا طوق الحمامَهْ",20,"م",2,0],["فما يشكو سوى لحظ الغواني","ونشر الروض سقماً واعْتدالا",21,"ل",2,0],["فما يُجلِّي الذي تكنى به قنصاً","كما تُجَلِّي ابنَ حاجات إذا سنحا",22,"ح",2,0],["فما يُضْرَمُ بالنَّفْخِ","ولا يُطْفَأُ بالنَّضْحِ",23,"ح",1,0],["فما يضرُّك ما دار الزمانُ به","وأنت حَالَيْكَ في سِرْبالِ مَحْسُودِ",24,"د",1,0],["فما يَنْقِمون الآن لا درَّ دَرُّهم","وقد قام بالعدل الرضيُّ المحمَّدُ",25,"د",1,0],["فما يزال الدهر مستوفياً","للحمد في صورة مُسْتَبْخِس",26,"س",1,0],["فما يتقيه العيرُ إلا بفأله","إذا اعتامه للطعن دون النحائِص",27,"ص",1,0],["فما يبالي بعدما ناله","مما وصفنا ما دهى سمعه",28,"ع",2,0],["فما يبلغ الراضي رضاه ببلغة","ولا ينقع الصادي صداه بريق",29,"ق",1,0],["فما يرتاحُ للمدحِ","ولا يرتاعُ للشَّتمِ",30,"م",1,0],["فَما يَزالُ جَدا نُعماكَ يَمطُرُني","وَإِن نَأَيتُ وَسَيبٌ مِنكَ مَرفودُ",31,"د",1,0],["فَما يُلِمُّ بِمَن صافاهُمُ أَلَمٌ","وَلا يَدومُ لِمَن عاداهُمُ أَمَلُ",32,"ل",1,0],["فَما يُضَرَّ اِمرَأً أَمسى وَأَنتِ لَهُ","أَن لا يَكونَ مِنَ الدُنيا لَهُ سَنَدُ",33,"د",1,0],["فما يصنع العبد الذي ليس شائياً","إذا شاء رب العبد أن يكفر العبد",34,"د",1,0],["فَما يَبكونُ مِن ثُكلٍ وَلَكِن","كَما تَصِفُ المُعَدِّدَةُ المُصابا",35,"ب",2,0],["فَما يَدومُ سُرورُ ما سُرِرتَ بِهِ","وَلا يَرُدُّ عَلَيكَ الفائِتَ الحَزَنُ",36,"ن",1,0],["فَما يُسمي كَفَنّا خُسرَ مُسمٍ","وَلا يُكَني كَفَنّا خُسرَ كاني",37,"ن",2,0],["فَما يَنفَعُ الأُسدَ الحَياءُ مِنَ الطَوى","وَلا تُتَّقى حَتّى تَكونَ ضَوارِيا",38,"ي",2,0],["فما يَشْغَلُ الأبصارَ إلّا بهاؤُهُ","ولا ترعوي إلّا إليه المسامعُ",39,"ع",1,0],["فَما يُهَيِّجُهُ نَوحُ الحَمامِ إِذا","ناحَ الحَمامُ عَلى الأَغصانِ أَو صَدَحا",40,"ح",2,0],["فَما يَزالُ جَوىً في الصَدرِ يُضرِمُهُ","وَشكُ النَوى وَصُدودُ الأُنَّسِ الخُرُدِ",41,"د",1,0],["فَما يُقَرِّبُ تَقريبي شَواسِعَها","وَلا يُباعِدُ ما أَدنَينَ تَأخيري",42,"ر",2,0],["فَما يَحبِسُ الراحَ الَّتي أَنتَ خِلُّها","وَما يَمنَعُ الأَوتارَ أَن تَتَرَنَّما",43,"م",2,0],["فَما يَهتَدي بِالعَينِ مِن ناظِرٍ بِها","وَلَكِنَّما تَهدي العُيونَ قُلوبُها",44,"ب",3,0],["فَما يَحيَ لا أَخشَ العَدُوَّ وَلا أَزَل","عَلى الناسِ أَعلو مِن ذُرى المَجدِ مَفرَعا",45,"ع",2,0],["فما يَخْشى سَطاه الدهرَ جانٍ","ولا يَرجو نَداه الدهرَ جارُ",46,"ر",1,0],["فما يبالي إذا ما الدَّهرُ أسعَدَه","ضَنَّ الخَلِيُّ بدَمْعِ العَينِ أو جادَا",47,"د",2,1],["فما يُطيلُ مُقامي في ديارِهُم","إلا انتظارُ طواميرٍ وأدراجِ",48,"ج",1,0],["فما يَنفكُّ من سَبَجٍ","يعودُ كأنه ذَهَبُ",49,"ب",1,0],["فَما يَكُ مِن خَيرٍ أَتَوهُ فَإِنَّما","تَوارَثَهُ آباءُ آبائِهِم قَبلُ",50,"ل",1,0],["فَما يَحرِمُ العَجزُ أَصحابَهُ","وَلا يُرزَقُ المالَ مَن يَجهَدُ",51,"د",1,0],["فَما يَعرِفُ العَطشانُ مَن طالَ رِيُّهُ","وَما يَعرِفُ الشَبعانُ مَن هُوَ جائِعُ",52,"ع",1,0],["فَما يمُرُّ عَلى صَخرٍ وَلا شَجَرٍ","إِلّا وَحَيّاهُ بِالتَّسليمِ مِن أَمَمِ",53,"م",1,0],["فما يزالُ الجوى بهْ","إلى وصولِ جوابِهْ",54,"ب",2,0],["فَما يَدري المُخَبِّرُ أَيَّ جِزعٍ","مِنَ الأَجزاعِ يَمَّمَتِ الحُدوجُ",55,"ج",1,0],["فَما يَستَقيمُ الأَمرُ وَالمَلكُ جائِرٌ","وَهَل يَستَقيمُ الظِلُّ وَالعودُ مُعوَجُّ",56,"ج",1,0],["فَما يَطرُقُ الطَيفُ غاباً لَهُ","وَلَو كانَ أَغفى بِهِ أَو غَفَل",57,"ل",1,0],["فَما يَرضى إِلَهُ الناسِ عَنها","وَلا يَرضى يَغوثُ وَلا يَعوقُ",58,"ق",1,0],["فَما يَذكُرُ الأَبناءَ إِلّا بَكى لَها","وَلا يَبعَثُ الأَنفاسَ إِلّا تَأَلَّما",59,"م",2,0],["فما يُغني فتاك وما يُفيدُ","تباركَ ربُّنا رباً جليلا",60,"ل",2,0],["فَما يَتَّقي الدينُ أَن يَعتَدي","وَما يَتَّقي المالُ أَن يَعدِلا",61,"ل",2,0],["فَما يَنظُرُ الحُكّامُ بِالفَضلِ بَعدَما","بَدا واضِحٌ ذو غُرَّةٍ وَحُجولِ",62,"ل",1,0],["فَما يَأتي عَلى طَلَبٍ","وَلا يَعصي مِنَ الحَصَرِ",63,"ر",1,0],["فَما يُخلِقُ الثَوبَ الجَديدَ اِبتِذالُهُ","كَما يُخلِقُ المَرءَ العُيونُ اللَوامِحُ",64,"ح",1,0],["فما يُبالي بأَعْداءٍ قُلوبُهُمُ","فيها تَمَكَّنَ منهُ الخوفُ والذُّعُرُ",65,"ر",1,0],["فما يشهَدُونَ الحربَ غيرَ تَغَطْرسٍ","ولا يَضرِبونَ الهامَ غير تَجَهضُم",66,"م",1,0],["فما يقولُ لنا القرطاسُ ويلكُمُ","إنّا نَرَى عِظَةً فيكُم ومُعتَبَرا",67,"ر",2,0],["فَما يَفوزُ الَّذي أَحيَت بِمَنفَعَةٍ","وَلا لِمَن قَتَلَت عَقلٌ وَلا قَوَدُ",68,"د",1,0],["فَما يَأتيكَ مِن هَذا وَهَذا","إِذا اِجتَمَعا وَضَمَّهُما الفَضاءُ",69,"ا",2,0],["فَما يُراعونَ ما قالوا وَما سَمِعوا","وَلا يُبالونَ مِن غِيٍّ لِمَن سَجَدوا",70,"د",3,0],["فَما يَبرَقنَ مِن زَولٍ عَجيبٍ","وَلا يَفرَقنَ مِن صُبحٍ وَنفرِ",71,"ر",1,0],["فَما يُبالي أَديمٌ وَهيَ جانِبُهُ","وَلا يُراعُ إِذا حُدَّت أَشافيهِ",72,"ف",3,0],["فما يَرْمِينَ بالآجالِ إجْلاً","وَيَرمِينَ المَقَانِبَ والرِّعَالا",73,"ل",2,0],["فَما يُعدِمكِ لا يُعدِمكِ مِنهُ","طَبانِيَةٌ فَيَحظُلُ أَو يَغارُ",74,"ر",1,1],["فما يسمى كفنّا خسر مسمٍ","ولا يكنى كفنّا خسر كان",75,"ن",1,0],["فما يَنْفَكُّ ذا مالٍ عَتِيدٍ","فتىً جَعَلَ القُنوعَ له عَتادا",76,"د",2,0],["فَما يَتَمادى العَهدُ إِلّا تَجَدَّدَت","مَوَدَّتُها عِندي وَإِن زَعَمَت أَن لا",77,"ل",2,0],["فَمَا يَمُرُّ خَيَالُ الْغَدْرِ فِي خَلَدِي","وَلا تَلُوحُ سِمَاتُ الشَّرِّ فِي خَالِي",78,"ي",1,0],["فَمَا يَبْعَثُ الْغَارَاتِ إِلَّا مُهَنَّدِي","وَلا يَرْكَبُ الأَخْطَارَ إِلَّا فَتىً مِثْلِي",79,"ي",1,0],["فَمَا يَغْرِيهِ يُخْرِجُهُ فَريّاً","وَمَا يَرْمِيهِ مِنْ غَرَضٍ يُصِيبُ",80,"ب",1,0],["فَمَا يَرْتَاضُ إِلاَّ مُسْتَثِيراً","كَوَامِنَهَا عَلَى قَدَمٍ وَسَاقِ",81,"ق",1,0],["فَمَا يُحَاكِي جَمَالٌ فَضْلَ نِسْبَتِهَا","وَلاَ سَذَاجَتَهَا نَقْشٌ وَتَرْصِيعُ",82,"ع",1,0],["فَما يُوسُفٌ يَقري بِنابٍ مُسِنَّةٍ","وَلا العِرقُ مَفصودٌ وَلا الشاةُ تُذبَحُ",83,"ح",1,0],["فَمَا يَنْفَلِلْنَ وما يَنْحَنِينَ","وما يَنْتَهِينَ إِذَا ما نُهِينَا",84,"ن",2,0],["فما يشتهى خدّاك إلا لأنّني","تركت على خدّيك إثمي وأوزاري",85,"ر",2,0],["فَما يَستَقيمُ الأمرُ، والمَلْكُ جائرٌ،","وهل سيتقيمُ الظلُّ والعودُ معوجُّ؟",86,"ج",1,0],["فما يرضع الشوكُ من صدرهِ","ول