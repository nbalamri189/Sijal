wan.net/poem23223.html","البسيط"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"يضحي الفتى المرؤوس بالسيد ال","https://www.aldiwan.net/poem23415.html","السريع"],[46,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[8,"لبست أناسا فأفنيتهم","https://www.aldiwan.net/poem21797.html","المتقارب"],[76,"وشادن ذي دلال","https://www.aldiwan.net/poem39017.html","المجتث"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55175","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116969","المنسرح"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[59,"لله دَرُّ القُنُوعِ مِن خُلُقِ !","https://www.poetsgate.com/ViewPoem.aspx?id=20444",""],[43,"فراق ومن فارقت غير مذمم","https://www.poetsgate.com/ViewPoem.aspx?id=392",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[45,"سرَى من خَيالِ المالكِيّةِ ما سَرَى،","https://www.poetsgate.com/ViewPoem.aspx?id=31270",""],[91,"كلوا واشربوا","https://www.poetsgate.com/ViewPoem.aspx?id=53344",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[51,"قالوا ابنُ يوسفَ مستوهٌ فقلتُ لهم","https://www.poetsgate.com/ViewPoem.aspx?id=27038",""],[105,"اذهبْ حُيَيُّ مُذمماً مشؤوما","https://diwany.org/%D8%A7%D8%B0%D9%87%D8%A8%D9%92-%D8%AD%D9%8F%D9%8A%D9%8E%D9%8A%D9%91%D9%8F-%D9%85%D9%8F%D8%B0%D9%85%D9%85%D8%A7%D9%8B-%D9%85%D8%B4%D8%A4%D9%88%D9%85%D8%A7/","الكامل"],[78,"الأَكثَرين مُسَوَّدًا وَمُملَّكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86645&r=&rc=140",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[87,"لعزة ِ هذي اللاهياتِ النواعمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23774&r=&rc=36",""]],"verses":[["يَضُمُّ عَليها جانِبَ النَقعِ بِالقَنا","يُبادِرنَ قُدّامَ السُيوفِ التَراقِيا",0,"ي",2,0],["يَضُمُّ حَشى البَغضاءِ عِندَ تَغَيُّبي","وَيَجلو جَبينَ الوُدِّ حينَ يَراني",1,"ن",2,0],["يَضُمُّ الخائِفَ الظَمآنَ مِنهُ","حِمىً يَفتَرُّ مِن بَردِ الأَماني",2,"ي",1,0],["يُضيءُ إِلى الرَبعِ الَّذي كُنتُ آلِفاً","بِهِ بُرءَ أَسقامي وَبَلَّ أُوامي",3,"ي",1,0],["يُضِلُّ نُفوسَنا داءٌ عُقامٌ","فَيُسلِمُنا إِلى أَرضٍ عَقيمِ",4,"م",1,0],["يَضمَنَّ أَمراً ما تَضَمَّنَ مِثلَهُ","أَيّامَ أَيّامَ الجَديلُ وَشَدقَمُ",5,"م",1,0],["يُضامُ العَدَدُ الكُثرُ","وَيَأبى العَدَدُ القُلُّ",6,"ل",1,0],["يَضَنّونَ أَن نُعطى نَصيباً مِنَ العُلا","وَقَد عالَجوا دَينَ العُلى وَتَسَلَّفوا",7,"ف",3,0],["يُضيفُ فَلا يُمَيَّزُ مَن يَراهُ","أَماراتِ المُضيفِ مِنَ المُضافِ",8,"ف",1,0],["يُضاعُ فَيُنشَدُ قَعبُ الغَبوقِ","وَقَلبي يُضاعُ وَلا يُنشَدُ",9,"د",1,0],["يَضُمُّ شَعاعَهُ قَلِبٌ وَلَكِن","تَضيقُ بِهِ حَيازيمُ البِلادِ",10,"د",1,0],["يَضُمُّها اللَيلُ في أَثناءِ غَيهَبِهِ","وَالقَطرُ يَلمَسُ أَطرافَ الجَلاميدِ",11,"د",1,0],["يَضِنَّ عَلَيَّ اليَومَ مِنهُ بِنَهلَةٍ","وَتُبذَلُ دوني لِلنَقا وَالكَثاكِثِ",12,"ث",1,0],["يَضوعُ هَجيرُ السَيرِ بَينَ رِحالِهِم","إِذا ما نَسيمُ اللَيلِ في ثَوبِهِ هَبّا",13,"ب",2,0],["يُضيءُ بِالطَفِّ قَبراً","فيهِ الأَعَزُّ الأَحَبُّ",14,"ب",1,0],["يضيءُ لها وَجْهٌ يرِقُّ أديمُهُ","فما ضَرّها لو رَقَّ لي قَلْبُها القاسي",15,"س",2,0],["يَضِجُّ الدّسْتُ منْ حَنَقٍ عليهِ","ويَبْصُقُ في مُحيّاهُ الوِسادُ",16,"د",1,0],["يَضيقُ على قُصّادِهِ كُلُّ مَنهَجٍ","فَقد مَلأَتْ أقطارَهُ عَنه قُفَّالُ",17,"ل",1,0],["يَضحَكُ السَيفُ في يَدي وَيُنادي","وَلَهُ في بَنانِ غَيري نَحيبُ",18,"ب",1,0],["يُضَحّي فُؤادي بِهَذا الحُبِّ مُلتَحِماً","وَقفاً وَيُمسي عَلَيَّ الحُبُّ مُلتَحِفا",19,"ف",2,0],["يَضرِبُ الأَدنى إِلَيهِم وَجهَهُ","لا يُبالي أَيَّ عَينَيهِ كَفَح",20,"ح",1,0],["يُضاحِكُ الشَمسَ مِنها كَوكَبٌ شَرِقٌ","مُؤَزَّرٌ بِعَميمِ النَبتِ مُكتَهِلُ",21,"ل",1,0],["يُضيءُ سَناهُ أَو مَصابيحَ راهِبٍ","أَهانَ السَليطَ في الذَبالِ المُفَتَّلِ",22,"ل",1,0],["يُضيءُ الفِراشُ وَجهَها لِضَجيعِه","كَمِصباحِ زَيتٍ في قَناديلِ ذَبّالِ",23,"ل",1,0],["يُضْحِكُهُ مِنْ طَرَبٍ جَأْرُهَا","وَرُبَّمَا أَبْكَاهُ سَجَعُ الحَمَامْ",24,"م",1,0],["يَضيقُ بِأَولادِهِ بَطنُهُ","فَيَخراهُمُ واحِداً واحِدا",25,"د",2,0],["يُضحي بِها الأَرقَشُ الجَونُ القَرا غَرِدا","كَأَنَّهُ زَجِلُ الأَوتارِ مَخطومُ",26,"م",1,0],["يُضَمِّنُ سِرَّهُ الأَحشاءَ إِلّا","وَثوبَ اللَيثِ أَخدَرَ ثُمَّ صالا",27,"ل",2,0],["يضيء ظلامَ الليل ما بين أضلعي","إذا البارق النجديُّ وهُناً بدا ليا",28,"ي",2,0],["يضمّ كفّيه للإبطَين منبهراً","مقلّباً في الأعالي منه أجفانا",29,"ن",2,0],["يضيء به ثغر الحضارة باسماً","بلامع نور علّم السحب البرقا",30,"ق",2,0],["يُضيء دُجُنّات الحياة جبينها","وتبدو المعالي حيث أتْلِع جيدها",31,"د",3,0],["يَضرَحنَ كُلَّ حَصى مَعزاءَ هاجِرَةٍ","كَأَنَّهُنَّ نَعامٌ راحَ نُدّادُ",32,"د",1,0],["يَضرَحنَ ضَرحاً حَصى المَعزاءَ إِذ وَقَدَت","شَمسُ النَهارِ وَعادَ الظُلُّ لِلقِصَرِ",33,"ر",1,0],["يَضِجُّ إِذا ظِلُّ الغُرابِ دَنا لَهُ","حِذاراً عَلى باقي السَناسِنِ وَالعَصَب",34,"ب",1,0],["يُضيءُ رَبابُهُ في المُزنِ حُبشاً","قِياماً بِالحِرابِ وَبِالإِلالِ",35,"ل",1,0],["يُضيءُ لَنا البَيتُ الظَليلُ خَصاصَةً","إِذا هِيَ لَيلاً حاوَلَت أَن تَبَسَّما",36,"م",2,0],["يضج رواغي أقرانهم","لهُلاَّكها ويكيس العقيرا",37,"ر",2,0],["يَضِنُّ زَماني بِالثِقاتِ وَإِنَّني","بِسِرّي عَلى غَيرِ الثُقاتِ ضَنينُ",38,"ن",1,0],["يَضِلُّ عَليَّ القَولُ إِن زُرتُ دارَها","وَيَعزُبُ عَنّي وَجهُ ما أَنا فاعِلُ",39,"ل",1,0],["يَضيقُ مَكاني عَن سِوايَ لِأَنَّني","عَلى قِمَّةِ المَجدِ المُؤَثَّلِ جالِسُ",40,"س",1,0],["يضنُّ بأحمال من التبن معشرٌ","إذا اتصلت أحمال جودك من تبر",41,"ر",1,0],["يضوع قريضي في الورى بامْتداحه","وما جوده لي في الورى بمضيع",42,"ع",1,0],["يضنّ بأسطارٍ كأنَّ يراعها","أساريع ظبي أو مساويك أسحل",43,"ل",1,0],["يضمن لي رفده المهنا","يا لكَ من ضامنٍ كفيل",44,"ل",1,0],["يُضيء شهابُهُ في كلِّ ليلٍ","فتنجابُ الدجى أيَّ انجيابِ",45,"ب",1,0],["يُضحي ويمسي قراعاً من قَوارعه","كأنه بترات الخلق مطلوبُ",46,"ب",1,0],["يُضحي غريباً ولو ببلدتِهِ","فرداً وإن أحدقَتْ به عُصَبُهْ",47,"ب",2,0],["يضمُّنا حجْرُ أُمٍّ في رضاعتنا","وملعبٌ حيث نأتي بيننا اللَّعبا",48,"ب",2,0],["يضْربُ بالحُوقِ إذا","أنْعَظ أعْلَى كَبِدهْ",49,"د",2