{"poems":[[23,"لقد لعن الرحمن جمعا يقودهم","https://www.aldiwan.net/poem21309.html","الطويل"],[53,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[30,"لعمري لقد كان ابن ثور لنهشل","https://www.aldiwan.net/poem5520.html","الطويل"],[33,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[76,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[48,"حياتي بعد الأربعين منية","https://www.aldiwan.net/poem22323.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62234","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30465","الطويل"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[342,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[369,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[466,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2409","المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138281",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122666","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66243","الرجز"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10453","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89220","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66594","المتقارب"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111049","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86498","الكامل"],[4421,"","https://poetry.dctabudhabi.ae/diwan/poem/143425","السريع"],[4691,"أحبّكِ فوق ما أحببتُ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=188065",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5212,"نِداءُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212030",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5550,"أقبلتْ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=213634",""],[5602,"سحر دلالها","https://www.poetsgate.com/ViewPoem.aspx?id=204944",""],[5691,"باب الخليفة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207262",""],[5899,"طفل","https://www.poetsgate.com/ViewPoem.aspx?id=31950",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""]],"verses":[["فَدَلّاهُمُ في الغَيِّ حَتّى تَهافَتوا","وَكانَ مُضِلّاً أَمرُهُ غَيرَ مُرشِدِ",0,"د",1,0],["فدلّانا على عملٍ ذكيٍّ","بعقباهُ نعيمك في الجنان",1,"ن",1,0],["فَدَلّاهُمُ حَتّى إِذا ما تَذَبذَبوا","بِمَهواةِ نيقٍ أَسلَمَتهُم سَلالِمُه",2,"م",2,0],["فَدَلَّ عَلَيها القَلبُ رَيّا عَرَفتُها","لَها وَهَوى النَفسِ الَّذي كادَ يَظهَرُ",3,"ر",1,0],["فَدَلَفتُ يَقدُمُ بي هُناكَ ضُبارِمٌ","ضارٍ لَهُ بِعَمايَةٍ أَشبالُ",4,"ل",1,0],["فَدُلَّ هَجيرٌ في زَمانِكَ أَنَّهُ","سَخائِمُ في أَحشائِهِ وَحُقودُ",5,"د",1,0],["فَدَلَّيْتُ نَهَّاماً كَأَنَّ هُوِيُّ","هُويُّ قُطَامِيٍّ تَلَتْهُ أَجَادِلُهْ",6,"ل",2,0],["فَدَلَّ علَيْهِ لَحْظُ خِبٍّ مُخادِعٍ","تَرى نارَهُ مِن ماءِ عَيْنَيْهِ تُقْبَسُ",7,"س",1,0],["فدلَفْتَ كالسِّرحان تنهَلُ","من دم الشعب الشهيد",8,"د",1,0],["فَدُلَّني أَيَّما الثِقلَينِ أَحمِلُهُ","ثِقلِ اِصطِناعِكَ لي أَم ثِقلِ صُنعِكَ بي",9,"ب",2,0],["فَدَلَّتْ بما فيها على عُظم مُلْكه","وأَبقتْ له ذِكْرا مع الدهر خالدا",10,"د",2,0],["فَدَلَّت يَدَيها وَاِستَغاثَت بِبَردِهِ","عَلى ظَمَإٍ مِنها وَفيهِ جُمومُ",11,"م",1,0],["فدلَّسَ بي حتّى طَرقْتُ مكانَهُ","وأَوهَمْتُ إلْفي أَنّه بيَ حالِم",12,"م",1,0],["فدلَّتْ على المعروف منه طَلاقَةٌ","كما دلَّ أعْناق العِطاش سنى الفجر",13,"ر",1,0],["فدلّوا عبادالله للخير واعملوا","به واحذروا الاطماع والكبر والمرا",14,"ر",2,0],["فَدَلَّها الحُبُّ فَاِشتَفَيتَ كَما","تَشفي دِماءُ المُلوكِ مِن كَلَبِه",15,"ب",2,0],["فد لنا مادعا داعي الصلاح على","منابر الحق أعواما وأدهارا",16,"ر",2,0],["فَدلَفتَ مِن صَنعاء نَحو سياعِهِم","فمَحَوتَ آياتٍ بها ومَصانِعا",17,"ع",2,0],["فدل بإنكم لمَّا تكونوا","بكف للملوك مصافحينا",18,"ن",2,0],["فدلني ممن أنال مقصدي","ما خلق الله مُنيل المجتدي",19,"د",2,0],["فَدَلّى يَدَيهِ بَينَ ضَحلٍ وَغَمرَةٍ","تُخالِجُ مِن هَولِ الجِنانِ بَوادِرُه",20,"ر",2,0],["فدلهم على طريق الحق","واطلقوا لحاهم من حلق",21,"ق",1,0],["فدليل إثبات الكمال لذاتهم","ما قيل من نقص اللئيم الأنقص",22,"ص",1,0],["فدل ذاك أن رباً فوقه","باين بالذات والاسم خلقه",23,"ه",1,0],["فَدَلَّتْ ذَوائِبُ نِيرَانِهِمْ","عَلى أَنَّها شُهُبٌ تَحْرِقُ",24,"ق",1,0],["فدليل على كمالك عندي","ود من وده بقلبي يسري",25,"ر",2,0],["فدلائل الأعجاز أسطره","وقلائد العقيان أحرفه",26,"ف",2,0],["فدلّني ذاكَ على أنّه","ذو خَبَل في عقله أوْ وَلَهْ",27,"ل",2,0],["فدلّيني بعينكِ نحو أرضٍ","يكون بها انطلاقي نحو أنسي",28,"س",2,0],["فدلنا عرفة عن طيب معدنه","مجوهر الحسن فيه غير منقسم",29,"م",1,0],["فَدَليلُهُمْ قالَ النَّبيُّ بِفاطِمٍ","الحرفُ يُحذَفُ لِلسّهولَةِ لا لِشَينْ",30,"ن",1,0],["فدلت على تركٍ لمن كان مظهراً","من الدين أركاناً فتدرأ عن حد",31,"د",1,0],["فدلالُ الحسان يشْفي فؤادًا","هدَّهُ الدَّهرُ بالأسى والرُّكود",32,"د",1,0],["فدلالها سحرٌ إذا عرضت بهِ","شغفت بإضلاعي الفؤادَ فهاما",33,"م",2,0],["فدلَفْنا إلى الحَدائقِ تنْداحُ","زُهوراً مُنَضَّداتٍ وَريفَهْ",34,"ف",2,0],["فدلليني يا أميرة النساء","كي لا أضج بالبكاء",35,"ا",2,0],["فَدَلَفتُ إِليهِ؛ فالتَمَعَتْ","عَيناهُ كَسَيفٍ مَسلولِ",36,"ل",1,0]]}