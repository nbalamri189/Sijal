{"poems":[[29,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[87,"سعي الفتى في عيشه عباده","https://www.aldiwan.net/poem8014.html","الرجز"],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46515","الرجز"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143011","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113690","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4755,"بين الخوف والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=183541",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""]],"verses":[["وَالنَمرُ حَيٌّ ما يُنالُ قَديمُهُم","سَبَقوكَ حينَ تَخاطَرَ الحَيّانِ",0,"ن",1,0],["وَالنَملُ لا يَسعى إِلَيهِ الحَبُّ","وَنَملَتي شَقَّ عَلَيها الدَأبُ",1,"ب",1,0],["والنَّمُومَ الشَّتِيمَ والفَاسِقَ الخِب","بَ الجَبَانَ الجَمَّ العُيُوبَ الاَثِيمَا",2,"م",2,0],["والنمم والتغاري والنفاق","ما لهم قط في الخير امتعان",3,"ن",1,0],["وَالنمر المسكين ثاوٍ جائع","وَكُل سادات السباع ضائِع",4,"ع",1,0],["والنمير الذي سقى الناس أضحى","بعد أن جف في الينابيع آلا",5,"ل",2,0],["والنمل قل جبل وقالوا نمله","مثل العصافير الكبار بصحة",6,"ه",1,0],["والنَّمل عظمٌ واحدٌ","منها يفي برضائها",7,"ا",3,0],["والنمل حيران أم بعارضه","ريحان شعر يحير الشعرا",8,"ر",2,0],["والنمل إذ دخلت خوفاً إلى الخرب","بان الشباب ولم أقضِ بهم وطري",9,"ي",1,0],["والنَّملُ يَبنِي بيوتًا مِن رَمَادِ أَبي","والعِجلُ يَرمِي جدارًا بالغُبَارِ بُنِي",10,"ن",2,0],["والنمل حاذر أن تنمل حولها","فتصيح فيك بجندها وقيانه",11,"ن",2,0],["والنمر مخلد عقب ما هوب فراس","والبوم عقب الذل صبح عديمي",12,"م",2,0]]}