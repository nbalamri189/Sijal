{"poems":[[110,"هوينك بالغيور من الرجال","https://www.shoaraa.com/p13817",""],[95,"يا آل برنوطي تحية صاحب","https://www.aldiwan.net/poem11425.html","الكامل"],[139,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[264,"سائل الفيض من بحور المسائل","https://www.aldiwan.net/poem35940.html","الخفيف"],[353,"الأمن في العرفات حطك الذي","https://www.aldiwan.net/poem19918.html","الكامل"],[422,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[422,"حييت من قادم حل السرور به","https://www.aldiwan.net/poem54138.html","البسيط"],[445,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[445,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[484,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[563,"روح تغذت بتقوى الله طيبة","https://www.aldiwan.net/poem34449.html","البسيط"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[567,"يستجمع الشمل في الدنيا وينصدع","https://www.aldiwan.net/poem52812.html","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145841","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112828","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112833","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112842","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94063","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94112","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74259","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74227","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65172","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65116","الكامل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138745",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86275","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92029","السريع"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132125","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85245","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135711","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127200","الرجز"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140148",""],[4797,"لا ضاقت الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=29429",""],[4858,"هنيئاً ذا التّخرّجُ يا صُهيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=156818",""],[4929,"ساعة سجال","https://www.poetsgate.com/ViewPoem.aspx?id=199430",""],[4929,"السر عند المرأة","https://www.poetsgate.com/ViewPoem.aspx?id=199569",""],[5061,"الديه","https://www.poetsgate.com/ViewPoem.aspx?id=147168",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5183,"نبأة الهناء","https://www.poetsgate.com/ViewPoem.aspx?id=180228",""],[5525,"مداوي الجرح بجراح","https://www.poetsgate.com/ViewPoem.aspx?id=7268",""],[5563,"ما للهوى دكتور","https://www.poetsgate.com/ViewPoem.aspx?id=213090",""],[5606,"القلوب تطير لكن من دون أجنحه","https://www.poetsgate.com/ViewPoem.aspx?id=194769",""],[5606,"من يوصل علمي الشيخ ويقله","https://www.poetsgate.com/ViewPoem.aspx?id=197889",""],[5629,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=184506",""],[5747,"منار","https://www.poetsgate.com/ViewPoem.aspx?id=61607",""],[5756,"لا قبلك ولا بعدك سعد","https://www.poetsgate.com/ViewPoem.aspx?id=5368",""],[5790,"ما معدن الدر والياقوت غير فمك","https://www.poetsgate.com/ViewPoem.aspx?id=111899",""],[5848,"جرحي المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=53379",""],[5956,"دعاء في موضوع النساء","https://www.poetsgate.com/ViewPoem.aspx?id=181866",""],[5976,"قمراي","https://www.poetsgate.com/ViewPoem.aspx?id=30350",""],[6251,"الأرقم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76494&r=&rc=34",""]],"verses":[["وأبشر بالذي لباك إني","لأطلع من يمينك والشمال",0,"ل",1,0],["وابْشِرِ البِكْرَ الَّتِي صَارَتْ لَهُ","أَهْلاً بِعَيْشِ رَفَاهَةٍ وَكَمَالِ",1,"ل",1,0],["وأبشر بعيدٍ عاد بالبشر والصفا","وكبتِ العدا واشكر لربكَ وأحمدِ",2,"د",1,0],["وابشر ابشر وارقب شوارقَ أنوا","ر المنى حيث أظهرتها الدلائل",3,"ل",1,0],["وابشِرْ فإنَّكَ في الدَّارينِ في","ما تَشتهي من أَرفعِ الدَّرَجاتِ",4,"ت",1,0],["وابشِرْ بمترعة الغدير بمائها","إنْ شِمْتَ بارق ثغره البسَّام",5,"م",1,0],["وابشِرْ بما سوف تحظى من عنايته","وأنتَ منه بما يُرضيك مسرور",6,"ر",1,0],["وابْشِرْ بِأُخْرى وأُخرى واعَدَتْ فَوَفَتْ","بوعدِ ذي العرشِ فِي نعماءِ من شَكَرَهْ",7,"ر",2,0],["وابْشِرْ فإنكَ رُوحُ الحقِّ لَيْسَ لَهُ","إِلّا مِنَ النصرِ أَعضاءٌ وأَوصالُ",8,"ل",1,0],["وابشروا بطلعتها","فهي للصفا سبب",9,"ب",1,0],["وابشر فإنك إن تحيا مناك تنل","وإن تمت لك من مولاك إيناس",10,"س",1,0],["وابشر فهو المقضيُّ ولا","تضجر منه أو تختلج",11,"ج",1,0],["وابشِرْ بخيرٍ إذا التقيتَ بها","بِشارَةَ الخيرِ مَن للخير يَصطَنِعُ",12,"ع",1,0],["وابشِرْ فأبنَاءُ العُمُو","مةِ ساعدٌ في سَاعِدَيكْ",13,"ك",1,0],["وأبشع ُما في المواجع ِشعبٌ","دِماه ُوماء ُالمجاري سَوَاءُ",14,"ا",2,0],["وابشر آبشر فقد غدوت نجيا","وحبيبا وصفوة وخليلا",15,"ل",2,0],["وابشرن أن أنت تطلبه","بجميل الغوث من ألم",16,"م",1,0],["وابشر بكل كريمة ولك الرضا","ان أنت تسلك نهجه والمربح",17,"ح",1,0],["وابشر بسعد وود من جنابهم","وابشر بقرب أخا التقوى وخير غنا",18,"ن",2,0],["وابشر بحسن ختام فزت يقدمه","روح القدوم ودم في رحمة وهنا",18,"ن",2,0],["وابشر حسن أخلاق وعلم","على قدم تكمل بالدلائل",19,"ل",1,0],["وأبشر بقادم نجل أتى","تقربه العين عما قريب",20,"ب",1,0],["وابشر فهذا السعد قال مؤرخا","بمحمود أفراح المسرة إقبال",21,"ل",1,0],["وابشر بنيل القصد والمآرب","مذ فزت بالمقصود والمطالب",22,"ب",1,0],["وَابشر بِطول سَلامة فلأنتم","بِقدومكم فاقَ الزَمان وَرَاقا",23,"ق",2,0],["وَابشر بِطول سَلامة وَكَرامة","في سُؤدد لا تَنقَضي آباده",24,"د",2,0],["وابشر بنجل به كدت الحواسد إذ","جاء بخلف كما قد جئت بالخلف",25,"ف",1,0],["وابشر بهلك المفسدين جميعهم","عمّا قريب إنّهُ لن يُبعدا",26,"د",2,0],["وأبشر بجام مترع تروى به","من كفه إذا وردت كوثره",27,"ر",2,0],["وَأَبشِر بِنَيل الفَخر فَالسَعدُ مُقبِلٌ","بِعَيش صَفِيٍّ فيهِ يَحلو لَكَ الوَرد",28,"د",1,0],["وابشِر بما قد نِلتَ من نَيلِ الهُدى","بِشرَ الوَرى بالنِيل ذي المِقياسِ",29,"س",1,0],["وابشروا فاللَه أَولى به","وَهوَ رب راحم يغفر",30,"ر",1,0],["وابشر حين أذكر أن عمري","رهين الموت ليس له دوام",31,"م",1,0],["وأبشروا أو اشكروا للَه أنعمه","لما جلى الظلم والظلما بأنوار",32,"ر",1,0],["وأبشروا بالذي ترجو قلوبكم","من الإمام السخي الناسك القاري",32,"ر",2,0],["وابشِرْ بنيلك ما تريد بأخذه","ويدرأ ما تخشاه عنك مسلقيا",33,"ق",3,0],["وابشر فقد نلت الذي أملته","أعني به حجك واعتمارك",34,"ك",1,0],["وأبشر بنصر يملأ الكون فتحه","كما تشتهي فالحق يعلو ولا يعلى",35,"ل",2,0],["وأبشر بفزعة حامي الدين والبيت ..",". إليا هجدك من الهواجيس هاجد",36,"د",1,0],["وأبْشر يا صهيبُ , فإنّ يُسْرَاً","سَيَعْقُبُ عُسْرةً , وعد الحميدِ",37,"د",1,0],["وأبشع الشعرَ تمجيدًا لطاغيةٍ","لم يتق الله في أحوال من حكما",38,"م",2,0],["وَابْشِرْ سَيُصْبِح ُ فِيْ غَدٍ مَوْضُوْعُهُ","خَبَراً بِأَقْلَامِ الصَّحَافَةِ قَدْ سُطِرْ",39,"ر",1,0],["وابشرك قلبي من الهم محزون","معرف انا هذا وﻻ اعرف ذيه",40,"ي",2,0],["وأبشرت الدنيا ولم تك قبله","لها مثله في العالمين وزير",41,"ر",1,0],["وأبشر وباشر نعمة الله حامداً","فلله تحت الحمد من فضله بحر",42,"ر",1,0],["وابشر ترى روحي نست كل الأفراح","وتهدّمت تبكي عذابي معايه",43,"ا",3,0],["وابشر بطبّك يابعد كلّ مجروح","مانيب أناني لا ولا نيب نقّّاد",44,"د",1,0],["وأبشري قدام لا يبتدي فصل الخطاب","قبلما أنثر كل خافي بصدري وأشرحه",45,"ح",2,0],["وأبشر إنه يخد مك لابرد غله","لاتضيع فرصتك وأكسب أعجابه",46,"ب",2,0],["وابشرح لك عن النومة بلا سجاد","عن الأوطان والمنفى وعن غمي",47,"م",2,0],["وابشّر حدود النظر مابقي لي","من ضيقة التعتيم في خاطري شيّ",48,"ي",1,0],["وأبشروا واستبشروا واستمروا بالصعود","وابتدوا مرة جديدة على نفس العهد",49,"د",1,0],["وابشر فإنك قد أصبحت منفردا","وكل حسن غدا يعزى إلى شيمك",50,"ك",1,0],["وابشعل في ظلامي جرحي المصباح","واعلّق دمعتي في ليلي المذبوح",51,"ح",1,0],["وأبشع أنثى برأيي تضاهي","جمال الزهور وسحرَ المساءِ",52,"ا",2,0],["وأبشَعهنّ لديَّ تضاهي","قواريرَ عدْن ذواتِ البهاءِ",52,"ا",2,0],["وآبشّر بْحبك جميع اشياي","وآضم طيفك لا طرا بحْلوم",53,"م",1,0],["وأبشع ما في كرههم أن كرههم","لئيمٌ فلم يحدث له أن تلوما",54,"م",2,0]]}