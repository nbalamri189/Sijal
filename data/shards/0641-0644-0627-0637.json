{"poems":[[53,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[72,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[21,"والأرض سوى بساطا ثم قدرها","https://www.aldiwan.net/poem36172.html","البسيط"],[75,"أبلغ ربيعة عن ذي الحي من يمن","https://www.aldiwan.net/poem69056.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21082","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[20,"إسمع حديثا كما يوما تحدثه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502565",""],[143,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[160,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[166,"فلان بغضه فرض","https://www.aldiwan.net/poem47038.html","مجزوء الرمل"],[204,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[235,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[280,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[364,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[403,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[416,"قبر به سيد شريف","https://www.aldiwan.net/poem53910.html","مخلع البسيط"],[416,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[437,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[456,"يا لها نفساً يا لها","https://www.aldiwan.net/poem2173.html","مخلع البسيط"],[461,"سهرت ونام عن سهري رجال","https://www.aldiwan.net/poem15455.html","الوافر"],[506,"أقول وقد دعا للخير داع","https://www.aldiwan.net/poem2398.html","الوافر"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"عليك ولي نعمتنا سلامي","https://www.aldiwan.net/poem47215.html","الوافر"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[575,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"]],"verses":[["فَلا طَرَبٌ إِن زِدتُ قُرباً إِلَيهِمُ","وَلا أَسَفٌ إِن زادَ ما بَينَنا بُعدا",0,"د",2,0],["فلاطفته في الحالتين ولم أقل","فسلي ثيابي من ثيابك تنسل",1,"ل",1,0],["فلا طرقت أيدي الخطوب لكم حمى","ولا فرَّقت عين الزمان لكم شملا",2,"ل",2,0],["فَلا طابَ لي عَنكُم مَقامٌ وَمَوطِنٌ","وَلَو ضَمَّني فيهِ المَقامُ وَزَمزَمُ",3,"م",1,0],["فلا طيبَ إلاّ أن يَفوحَ نَسيمُها","ولا فجرَ إلا أن يَلوحَ صَديعُها",4,"ع",3,0],["فَلاطَها اللَهُ إِذ أَغوت خَليقَتَهُ","طولَ اللَيالي وَلَم يَجعل لَها أَجَلا",5,"ل",2,0],["فلا طرائقُنا يوم الوغى قِدَدٌ","شَتّى النِّجارِ ولا أهواؤنَا فِرَق",6,"ق",1,0],["فَلاَطَها اللهُ إذ أَغوَت خَليفتهُ","طُول اللّيالي ولم يجعل لها أجلا",7,"ل",2,0],["فَلا طيشَ فيهِ وَاِبن عِشرينَ طائِش","وَلا عجل وَالآدَمي عَجولُ",8,"ل",1,0],["فلا طيف حبّ يشقّ اليها","سعال الكوى أو فحيح الزّوايا",9,"ا",3,0],["فَلاَطَها اللهُ إذ أَغوَت خَلِفيتهُ","طُول اللّيالي ولم يجعل لها أجلا",10,"ل",2,0],["فَلا طَوَتِ الأَقدارُ أَياّمَكَ الَّتي","تُذَكِّرُ أَيّامَ الصَبا كُلَّ أَشيبا",11,"ب",2,0],["فلا طرف إلا امتد مرتقبا له","ولا ثغر إلا افتر من طرب ضحكا",12,"ك",2,0],["فلا طُولٌ ولا طَوْلٌ","ولا عَرْضٌ ولا عرْضُ",13,"ض",1,0],["فلا طلائع جيش القيظ طالعة","كذاك سابق جيش القرِّ مغلولُ",14,"ل",1,0],["فَلا طَمِعَت ما دُمتُمُ مِن حُماتِها","يَدُ الدَهرِ في طَردٍ لَهُنَّ وَلا وَشلِ",15,"ل",1,0],["فَلا طُلَّ إلاّ منْ حبائِكَ رَوْضُهُ","وَلا باتَ إلاّ فِي فِنائِكَ مَأْواهُ",16,"ا",2,0],["فلا طلبْتَ سواه بعدَ رُؤْيته","لا يَحْسُنُ العَبْدُ إلاّ عند مَوْلاه",17,"ا",2,0],["فلاطفه براً واعفه عن لطائف","تنل خير لطف من لطيف مؤيد",18,"د",1,0],["فلا طبيبٌ ولا حبيبٌ","ولا بعيدٌ ولا قريبُ",19,"ب",1,0],["فلا طابتْ أُوَيقات لصاحٍ","رمى أُمَّ الخبائث بالعقوق",20,"ق",1,0],["فلا طاب لي من بعد فقدك مطعم","ولا لذلي من بعد موتك مضجع",21,"ع",1,0],["فَلَأَطرُقَن قَوماً وَهُم نِيامُ","وَلَأَبرُكَن بِركَةَ النَعامَه",22,"م",2,0],["فلا طاشتْ لرائعةٍ حُباهُ","ولا زالتْ معاجِمُه صِلابا",23,"ب",2,0],["فلا طَافَت بي الآمال ان لم","أطف مابينَ زَمزَم والمقامَ",24,"م",1,0],["فلا طَرَقتْها للحوادثِ طَرْقةٌ","ولا عبثتْ أيدي الرّدى باِنثلامها",25,"م",3,0],["فَلا طَرَقت بِما تَخشى اللّيالي","وَلا همّت عُهودك بِاِنصِرامِ",26,"م",1,0],["فَلا طَلاقَ لَها إِذ لَيسَ طَلَّقَها","فَأَظلَمَ اللَيلُ فيها كُن لَها قَمَرا",27,"ر",2,0],["فلا طلعت من بعد وجهك أَنجم","ولا هَطَلت من بَعدِ كفِّك أَمطَارُ",28,"ر",1,0]]}