{"poems":[[55,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[74,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[74,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[72,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[63,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[21,"والأرض سوى بساطا ثم قدرها","https://www.aldiwan.net/poem36172.html","البسيط"],[77,"أبلغ ربيعة عن ذي الحي من يمن","https://www.aldiwan.net/poem69056.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62258","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21082","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[102,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[20,"إسمع حديثا كما يوما تحدثه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502565",""],[147,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[164,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[170,"فلان بغضه فرض","https://www.aldiwan.net/poem47038.html","مجزوء الرمل"],[208,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[240,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[285,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[369,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[409,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[422,"قبر به سيد شريف","https://www.aldiwan.net/poem53910.html","مخلع البسيط"],[422,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[443,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[461,"يا لها نفساً يا لها","https://www.aldiwan.net/poem2173.html","مخلع البسيط"],[466,"سهرت ونام عن سهري رجال","https://www.aldiwan.net/poem15455.html","الوافر"],[511,"أقول وقد دعا للخير داع","https://www.aldiwan.net/poem2398.html","الوافر"],[556,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[556,"عليك ولي نعمتنا سلامي","https://www.aldiwan.net/poem47215.html","الوافر"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[580,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88615","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48591","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64167","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62512","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79990","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[2035,"","https://poetry.dctabudhabi.ae/diwan/poem/198280","الكامل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144614","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75899","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130760","الطويل"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71360","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91269","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101356","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73092","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72823","الطويل"],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5186,"يوم كأسبوع وشهر كعام","https://www.poetsgate.com/ViewPoem.aspx?id=156514",""],[5190,"إن تُتهمي أو تُنجدي","https://www.poetsgate.com/ViewPoem.aspx?id=153359",""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5431,"وحبي مثل البدر وجدا له انشقا","https://www.poetsgate.com/ViewPoem.aspx?id=190580",""],[5431,"حديث بيني وبين قيس ابن الملوح","https://www.poetsgate.com/ViewPoem.aspx?id=191885",""],[5651,"إنْ حالَ في الحبِّ عما كنتُ أعهدُه","https://www.poetsgate.com/ViewPoem.aspx?id=107000",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[5309,"تراه رقيقا كالنسيم عواطفه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573828",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["فَلا طَرَبٌ إِن زِدتُ قُرباً إِلَيهِمُ","وَلا أَسَفٌ إِن زادَ ما بَينَنا بُعدا",0,"د",2,0],["فلاطفته في الحالتين ولم أقل","فسلي ثيابي من ثيابك تنسل",1,"ل",1,0],["فلا طرقت أيدي الخطوب لكم حمى","ولا فرَّقت عين الزمان لكم شملا",2,"ل",2,0],["فَلا طابَ لي عَنكُم مَقامٌ وَمَوطِنٌ","وَلَو ضَمَّني فيهِ المَقامُ وَزَمزَمُ",3,"م",1,0],["فلا طيبَ إلاّ أن يَفوحَ نَسيمُها","ولا فجرَ إلا أن يَلوحَ صَديعُها",4,"ع",3,0],["فَلاطَها اللَهُ إِذ أَغوت خَليقَتَهُ","طولَ اللَيالي وَلَم يَجعل لَها أَجَلا",5,"ل",2,0],["فلا طرائقُنا يوم الوغى قِدَدٌ","شَتّى النِّجارِ ولا أهواؤنَا فِرَق",6,"ق",1,0],["فَلاَ طُولُ ما جَاوَرْتُ دَهْمَاءَ نَافِعٌ","ولاَ دَاءُ مَا كُلِّفْتُ دَهْمَاءَ بَارِحُ",7,"ح",1,0],["فَلاَطَها اللهُ إذ أَغوَت خَليفتهُ","طُول اللّيالي ولم يجعل لها أجلا",8,"ل",2,0],["فَلا طيشَ فيهِ وَاِبن عِشرينَ طائِش","وَلا عجل وَالآدَمي عَجولُ",9,"ل",1,0],["فلا طيف حبّ يشقّ اليها","سعال الكوى أو فحيح الزّوايا",10,"ا",3,0],["فَلاَطَها اللهُ إذ أَغوَت خَلِفيتهُ","طُول اللّيالي ولم يجعل لها أجلا",11,"ل",2,0],["فَلا طَوَتِ الأَقدارُ أَياّمَكَ الَّتي","تُذَكِّرُ أَيّامَ الصَبا كُلَّ أَشيبا",12,"ب",2,0],["فلا طرف إلا امتد مرتقبا له","ولا ثغر إلا افتر من طرب ضحكا",13,"ك",2,0],["فلا طُولٌ ولا طَوْلٌ","ولا عَرْضٌ ولا عرْضُ",14,"ض",1,0],["فلا طلائع جيش القيظ طالعة","كذاك سابق جيش القرِّ مغلولُ",15,"ل",1,0],["فَلا طَمِعَت ما دُمتُمُ مِن حُماتِها","يَدُ الدَهرِ في طَردٍ لَهُنَّ وَلا وَشلِ",16,"ل",1,0],["فَلا طُلَّ إلاّ منْ حبائِكَ رَوْضُهُ","وَلا باتَ إلاّ فِي فِنائِكَ مَأْواهُ",17,"ا",2,0],["فلا طلبْتَ سواه بعدَ رُؤْيته","لا يَحْسُنُ العَبْدُ إلاّ عند مَوْلاه",18,"ا",2,0],["فلاطفه براً واعفه عن لطائف","تنل خير لطف من لطيف مؤيد",19,"د",1,0],["فلا طبيبٌ ولا حبيبٌ","ولا بعيدٌ ولا قريبُ",20,"ب",1,0],["فلا طابتْ أُوَيقات لصاحٍ","رمى أُمَّ الخبائث بالعقوق",21,"ق",1,0],["فلا طاب لي من بعد فقدك مطعم","ولا لذلي من بعد موتك مضجع",22,"ع",1,0],["فَلَأَطرُقَن قَوماً وَهُم نِيامُ","وَلَأَبرُكَن بِركَةَ النَعامَه",23,"م",2,0],["فلا طاشتْ لرائعةٍ حُباهُ","ولا زالتْ معاجِمُه صِلابا",24,"ب",2,0],["فلا طَافَت بي الآمال ان لم","أطف مابينَ زَمزَم والمقامَ",25,"م",1,0],["فلا طَرَقتْها للحوادثِ طَرْقةٌ","ولا عبثتْ أيدي الرّدى باِنثلامها",26,"م",3,0],["فَلا طَرَقت بِما تَخشى اللّيالي","وَلا همّت عُهودك بِاِنصِرامِ",27,"م",1,0],["فَلا طَلاقَ لَها إِذ لَيسَ طَلَّقَها","فَأَظلَمَ اللَيلُ فيها كُن لَها قَمَرا",28,"ر",2,0],["فلا طلعت من بعد وجهك أَنجم","ولا هَطَلت من بَعدِ كفِّك أَمطَارُ",29,"ر",1,0],["فَلا طاشَت بنازلة حلوم","لكم في الخطب ارسى من ثبير",30,"ر",1,0],["فلأطلبن المال أو","أقضي الحياة بلا قرارْ",31,"ر",1,0],["فلا طاعة في الأرض إلا لشرِّ ما","قضتْ بينهم نارٌ به وحديد",32,"د",1,0],["فلأطلبنَّ مسرتي","ما دام لي جسدٌ وروح",33,"ح",1,0],["فلأطفئنَّ لظى حشاي بمدحةٍ","أعنى بها ذاك الكريم محمدا",34,"د",2,0],["فلا طرقتكم نكبةٌ بعد هذه","ولا ساور التبريحُ يوماً لكم قلبا",35,"ب",2,0],["فَلا طولُ الثَواءِ يَرُدُّ رِزقاً","وَلا يَأتي بِهِ طولُ البَقاءِ",36,"ا",2,0],["فَلا طالِبٌ لِلثَّأرِ مِن بِعدِ مَوتِهِ","وَلا دافِعٌ عَن نَفسِهِ مَن يُريدُها",37,"د",3,0],["فَلاطَفوهُ بِأنْ يُحيي سَليبَهُمُ","إنْ كَانَ يُرضِيهِ فِي مَطلُوبِهِ السَّلَبُ",38,"ب",1,0],["فلأطلبن المجد غير مقصر","إن مت مت وإن حييت حييت",39,"ت",1,0],["فلا طرف إلاّ نحو نعماه طامح","ولا قلب إلاّ كامن فيه وده",40,"د",2,0],["فَلأَطرُقَنَّ بِما صَنَعتَ مُكابِراً","وَأَبُثُّ ما لاقَيتُ مِنكَ لِنُكتَةِ",41,"ه",1,0],["فَلاطَفتُهُ حَتّى اِستَكانَ وَما دَرى","بِأَنَّ الدَنايا لا تَحُلُّ بِمعقَدِ",42,"د",1,0],["فلا طربُ الالحان ينفي وساوسي","ولا نشوة الصهباء تشفي مصارعي",43,"ع",2,0],["فلا طيب أطيب من ريح ورد","إذا بات يعلوه طل الضباب",44,"ب",1,0],["فَلاَ طَرْفَ إِلاَّ تَحْتَ رَايةِ شَعْرِهِ","وَلاَ قَلْبَ إِلاَّ تَحْتَ مَعْقُودِ بَنْدِهِ",45,"د",2,0],["فَلا طالَ بَينٌ قَد أَطال جَفاكُمُ","وَلا كانَ تَفريقٌ رَمَى النَفعَ بالضرّ",46,"ر",1,0],["فَلا طمع في جانب العَيش بعدهم","فسيان في الأَيام أُنسي ووحشتي",47,"ي",1,0],["فلا طرقت نواعي","الخطب آه وآه آذاني",48,"ي",1,0],["فلا طرقت هذي النوازل مسمعي","ولكن علمي ذا وإن ساءكم جدا",49,"د",2,0],["فلا طفلاً تركت ولا فتاةً","ولا اللآئي يئسن من المحيض",50,"ض",1,0],["فلا طَرفَ إلاَّ في نعيمٍ وجنَّةٍ","ولا قلبَ إلاَّ في لظىً وجهنَّمِ",51,"م",1,0],["فلا طَمَعٌ بالخلْدِ إنَّ نبيَّنَا","لِكَأْسِ المنايا قبلَنا مُتَجَرِّعُ",52,"ع",1,0],["فلا طيفَ إلا بالأماني يرتجى","ولا وصلَ إلا بالتوهم واصلُ",53,"ل",1,0],["فلا طنب إلا توثب مقدم","ولا وتد إلا تجلد عارم",54,"م",1,0],["فلا طعامي من صحاف الصفا","ولا شرابي من كؤوس المدام",55,"م",1,0],["فَلا طُيُوفُكِ إِن مَرَّت سَتُسعِدُنِي","ولا رَسَائِلُكِ الحَمقَاءُ لِي سَعدُ",56,"د",1,0],["فلا طويت يمينك في ثراها","من الإيمان كم نشرت بنودا",57,"د",2,0],["فلا طعم للأشياء من دون وجدها","وحبي مثل البدر وجدا له انشقا",58,"ق",2,0],["فلا طيرك المسكين والطفلُ لاعبا","ولادمعةٌ حيرى تُثارُ فتُسكبُ",59,"ب",1,0],["فلا طويتُ الحشا إلا على حرَقٍ","يبلى من الصّبرِ عنهُ ما أجدّدُهُ",60,"د",2,0],["فلا طلعتْ شمسٌ وقد مسّني النوى","وكل ضياءٍ دونها القلب يَنْطِفُ",61,"ف",1,0],["فَلَاْ طَيْرُ فِيْ غَاْبٍ وَلَاْ وَحْشُ فِيْ فَلَاْ","سَيَجْمَعُ جَمْعِيْ فِيْ شَتَاْتِ الْمَنَاْفِيَا",62,"ف",3,0],["فَلا طاعَةُ الرَّحمنِ تَبرَحُ قَلبَهُ","وَلا الحَقُّ يَرضى صاحِباً مَن يُخالِفُه",63,"ف",2,0],["فَلا طَعامٌ مِنَ البأساءِ يُنقِذُنا","وَلا لِباسٌ يَقينا شِرَّةَ الضَّرَمِ",64,"م",1,0]]}