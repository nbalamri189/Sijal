"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5401,"كتاب حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=142372",""],[5431,"على سدرة الأكوان ...","https://www.poetsgate.com/ViewPoem.aspx?id=190642",""],[5431,"احرق بربك قد جُعِلْتُ لتحْرقا","https://www.poetsgate.com/ViewPoem.aspx?id=195162",""],[5431,"للدار أنت مودِعٌ وموَدّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196999",""],[5431,"ومناها سماحةٌ والقبولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197474",""],[5431,"عجبتُ لمن يرى في الجوع ربّا !!....","https://www.poetsgate.com/ViewPoem.aspx?id=202210",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5433,"ياللي تموت ببردها","https://www.poetsgate.com/ViewPoem.aspx?id=36113",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[402,"بسم الثغر في محيا الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=35363",""],[5861,"إغلقِ الباب وغادر","https://www.poetsgate.com/ViewPoem.aspx?id=191351",""],[5923,"هاك شعري","https://www.poetsgate.com/ViewPoem.aspx?id=147703",""],[5956,"حبٌ وصد","https://www.poetsgate.com/ViewPoem.aspx?id=182213",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"من أي نجم جئتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194561",""],[5970,"طلبت العلا حتى استلان لي الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=130656",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6102,"الوطن المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=182760",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[6134,"هذي الرواية قد أتت بنفائس","https://www.poetsgate.com/ViewPoem.aspx?id=169552",""],[6192,"نقاط استفهام إلى شاعر صهيوني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63735&r=&rc=5",""],[6277,"كلاج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64478&r=&rc=41",""]],"verses":[["اِتَّقِ ما بي تَتَقّي","وَلَو أَنابيبَ القَنا",0,"ن",2,0],["إِتَّقوا بَذلَةَ العُيونِ فَغابوا","وَبِآرائِهِم يُرَبُّ الأَنامُ",1,"م",1,1],["أَتَقتَصُّ مِن جَسَدي بِالبِعادِ","وَما زُوِّدَ الباعُ مِنكَ العِناقا",2,"ق",2,0],["أَتَقنَعُ أَن تُضامَ وَأَنتَ حامٍ","وَتُهمِلُنا البِقاعُ وَأَنتَ راعِ",3,"ع",1,0],["أَتَّقى الرَميَ وَلَو شِئتُ مَضى","كُلُّ مَطرورٍ إِذا صَمَّمَ عَطّ",4,"ط",1,0],["أَتَقَرّى هَذا الأَنامَ فَيَغدو","عَجَبي مِنهُمُ طَريقاً لِعُجبي",5,"ب",2,0],["أَتَّقي سُخطَها فِراراً مِن الهَج","رِ وَإِن أَذنَبَت طَلَبتُ رِضاها",6,"ا",3,0],["أتَقْعُدُ عنْ قاضِي القُضاةِ ابْنِ أكْتَمٍ","وعنْ حسَنٍ منْ بعْدِ ما نشَرَ اللِّوا",7,"و",2,0],["أَتَقَرّى التُجارَ في سائِرِ الخا","ناتِ ظُهراً عِندَ استِواءِ القُدورِ",8,"ر",1,0],["أتقاضى مَراضعي من صَبابا","تِ صديقي وذكْرِهِ وافتقادِهْ",9,"د",2,0],["أتقبل دعوى الظن وهي مُخيلةٌ","وتتركُ مثلي وهْي غيرُ مُخيلِ",10,"ل",1,0],["اتَّقِ الله ففي قوْ","لِكَ عُدوانٌ وإثمُ",11,"م",1,0],["أتقْلِبُ ذا مُحافظةٍ عَدُوّاً","لعمرُو أبيك ما هذا بحزْمِ",12,"م",1,0],["أتَّقِي غصةَ اسمِه علمَ اللَّ","هُ فأكنِي عن ذكره بالمعاني",13,"ن",2,0],["أتقي الشرَّ جاهداً فإذا ما","حُمَّ حَمِّي تركتُهُ يتقيني",14,"ن",2,0],["أَتَقولونَ إِنَّهُ مَجنونُ","أَتَقولونَ إِنَّهُ مَفتونُ",15,"ن",1,0],["أَتَقولونَ شاعِرٌ مِسكينُ","كَم مَليكٍ كَم قائِدٍ كَم وَزيرِ",15,"ر",1,0],["أَتَقدَحُ فيمَن شَرَّفَ اللَهُ قَدرَهُ","وَمازالَ مَخصوصاً بِهِ طَيِّبُ الثَنا",16,"ن",2,1],["أتقوا الأيام في أعقابكم","أأخذتم لهمُ عهد السنين",17,"ن",1,0],["أتقن الصنعة تُفلح","وتُوفَّق للكمال",18,"ل",1,0],["أَتقَنوا الصَنعَةَ حَتّى","أَخَذوا الخُلدَ اِغتِصابا",19,"ب",2,0],["أَتقِنوا يُحبِبكُمُ اللَ","هُ وَيَرفَعكُم جَنابا",19,"ب",2,0],["إِتَّقِ اللَهَ أَنتَ شاعِرُ قَيسٍ","لا تَكُن وَصمَةً عَلى الشُعَراءِ",20,"ا",2,0],["أَتَقتُلُكُم في غَيرِ جُرمٍ عَبيدُكُم","وَفيكُم رَوابي عامِرٍ وَفُضولُها",21,"ل",3,0],["اِتَّقِ اللَهَ بِجُهدِك","قاصِداً أَو بَعضَ جَهدِك",22,"ك",1,1],["أَتَقتَصُّ مِنّي إِن جَنى الغَيرُ زَلَّةً","كَكاسِرِ دَنِّ الخَلِّ إِن جَنَتِ الخَمرُ",23,"ر",1,1],["أتقولانِ قد تسليتُ عنها","ومسحتُ الدموعَ من أجفاني",24,"ن",2,0],["أتقول أعمارٌ مضيعة","ماذا صنعت بعمرك الغالي",25,"ي",1,0],["أتقنتَ في أيامِكَ البيعَ وال","صرفَ وما دافعَ بابَ الولا",26,"ل",2,0],["إِتَّقي اللَهَ في فَتىً","ماجِدٍ أُختَ هاشِمِ",27,"م",1,0],["اتَّقِ اللَهَ وَعَظِّم حَقَّهُ","وَتَأَمَّل كَيفَ تَفنى الدُوَلُ",28,"ل",1,0],["أَتَقذِفُهُم إِلى لَهَواتِ ضارٍ","مَلِيٍّ أَن يَغولَهُمُ اِزدِرادا",29,"د",2,0],["اتَّقِ اللّهَ ولا تَبْغِ الأَذَى","وَاتَّبِعْ ما قال خيرُ الرُّحَمَاءْ",30,"ا",2,0],["أَتَقدَحُ يا حُويطبُ زَنْدَ سُوءٍ","دَعِ الرأيَ الرشيدَ وَزِدْهُ قَدْحا",31,"ح",2,0],["اتَّقِ اللهَ يا سراقةُ وانظر","هل ترى الأمر هيّناً ميسورا",32,"ر",2,0],["أَتَّقي أَعيُنَ الظِباءِ وَلَكِ","نَّ قُلوبَ الآسادِ قَد تَتَّقيني",33,"ن",2,0],["أتَقَرَّى جمالَ ذاتكِ في ما","أبدعتْهُ يَمينُها من فنون",34,"ن",1,0],["أتقدُّماً فيهمْ وأنتَ مؤخَّرٌ","وتشبّهاً بهِمُ وأنْتَ دَخيل",35,"ل",1,0],["أَتَقتُلُني إِن قُلتُ إِنّي أُحِبُّكُم","وَلا ذَنبَ لي إِن كانَ في الناسِ قَد فَشا",36,"ش",2,0],["أَتَقَضّى مَعَ الصَباحِ فَلا أَط","لُبُ رِزقاً وَبي مِنَ السُهدِ سُكرُ",37,"ر",1,0],["أَتَقبَلُ النُصحَ مِنّي أَم تُضَيِّعُهُ","وَرُبَّ مِثلِكَ أَلغاهُ فَما قَبِلا",38,"ل",2,0],["أَتَقتُلني ظُلماً وتجحَدُني قَتلي","وقد قامَ مِن عينيكَ لي شاهِدا عَدْلِ",39,"ل",1,1],["أَتَقَرَّى الشَّيءَ أَبْغِيهِ فَلا","أَجِدُ الشَّيءَ وَلا نَفْسِي تَقَرْ",40,"ر",1,0],["أَتْقَنَتَهَا أَيْدِي الصِّنَاعَاتِ حَتى","لَيْسَ فِيهَا الإِتْقَانُ بِالمُسْتَزَادِ",41,"د",1,0],["أَتُقفِلُ مَطبَخاً لا شَيءَ فيهِ","مِنَ الدُنيا يُخافُ عَلَيهِ أَكلُ",42,"ل",1,1],["أتَقَرَّى الطّريقَ فيه بِكَفِّي","بين شَكٍ وحَيْرَةٍ وضَلال",43,"ل",1,0],["أَتَقَاسَما فيها الوَدَاعَ بلَفْظَةٍ","أَمْ لَمْ تدَعْ لَهُمَا المَنُونُ كلاَما",44,"م",2,0],["أتقنتَ فنَّكَ لم تطلب به عرضًا","ولم تُتاجر به في السُّوق مُكتسبا",45,"ب",2,0],["أتقيّ وهو ينفي كلّ ما","لم يؤيّد بيقين أو بحسّ",46,"س",1,0],["أتقرح أكباد المحبين كالذي","أرى كبدي من حب بثنة يقرح",47,"ح",1,0],["أتقرَّى الشَئَ أبغيهِ ، فلا","أجِدُ الشئَ ، ولا نفسى تقَر",48,"ر",1,0],["أتقيها والكرى يقذف بي","وأغض الطرف والقلب يرى",49,"ا",1,0],["أتَقصِدُ أن تَطولَ الأوجَ","قُربَ العَرشِ أو أدنى",50,"ن",2,0],["أتقضي معي إن حان حَيْني تجاربي","وما نلتها إلاّ بطول عناءِ",51,"ا",2,1],["أَتَقعُدُ عَن مُرتَقاهُ النُجو","مُ عَجزاً وَيَطمَعُ فيهِ البَخَر",52,"ر",1,0],["أَتقاهُ لِلّهِ أَم عِلمُهُ البَا","هِرُ أَم حُسنُ حِفظِهِ لِلوِدادِ",53,"د",1,0],["أَتَقنَعُ بِالعَلاةِ مِنَ العَلالي","بَديلاً وَالمُثارِ مِن الوِثارِ",54,"ر",1,0],["أَتَقنَعُونَ بِأَن أَطوي رَجاءَكُمُ","يَأساً وَأَن أَتَرَجّى الحَيَّ قَحطانا",55,"ن",2,0],["أَتَقرِبَةً لِلصَّرمِ أَم دَفعَ حاجةٍ","أَرَادَت بِهِ أَم ذاتَ بَينِكَ تَقرُبُ",56,"ب",1,0],["أَتَقولُ الضلّالُ ما هم عدولٌ","مَن تُرى ثابتٌ به الإدّعاءُ",57,"ا",2,0],["اتقّي اللهَ إني رأيتُ الجفون","تعلمُ نفسي لديكِ انكسارا",58,"ر",2,0],["أتقبلين وما لي فيك من أمل","غير اللياذ بأطياف المواعيد",59,"د",1,0],["أتقبلون عابد العزيز","وليس بالمترو ولا الوزيزي",60,"ي",1,0],["أَتقَنَ اللَهُ فَنَّه فيهِ","وَأَجادَ التَنسيقَ في الحاجِب",61,"ب",1,0],["أَتَقطَعُ فيكَ الأَرضَ غُرُّ مَدائِحي","وَيَقرَعُ أَبوابَ السَماءِ دُعائي",62,"ي",1,0],["اِتَّقِ اللهَ مَا اسْتَطَعْتَ فَإِنَّ ال","لَّهَ رَبِّي مَعَ الذِينَ اتَّقَوْهُ",63,"و",2,0],["أَتَّقي هجراً مهيناً","ساعياً بي نحو حتفي",64,"ف",2,0],["أَتَقبل يا محمد عذر عبد","يحن اليك من برع اِشتياقا",65,"ق",2,0],["أَتَقاضاهُ فَيُماطِلُني","ظُلماً بِذُنوبي وَهوَ مَلي",66,"ل",2,0],["أتقولين إنني لست إنسا","نا لما شمته من استحيائي",67,"ي",1,0],["اِتَّقوا اللَهِ ذاكَ أَمرٌ مُحالٌ","أَن يَرى ساخِطَ رِضاهُ رِضاهُ",68,"ا",2,0],["أتَّقِي أَن يَذُوبَ من جَانِبَيهِ","حِينَ يَمشي تَثَاقُلاً بِالب