{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"إتقوا بذلة العيون فغابوا","https://www.aldiwan.net/poem29777.html","الخفيف"],[53,"لقاؤك جر علي الفراقا","https://www.aldiwan.net/poem29933.html","المتقارب"],[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[55,"إن نفسي مطيعة لهواها","https://www.aldiwan.net/poem26035.html","الخفيف"],[77,"يمينا بنور الفجر يوما إذا بدا","https://www.aldiwan.net/poem35834.html","الطويل"],[71,"لا رعى الله ليلتي في بخارى","https://www.aldiwan.net/poem3902.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"أقاسم لا تسدد سبيلي إلى الرضا","https://www.aldiwan.net/poem65997.html","الطويل"],[51,"أيها القائل بالجسم","https://www.aldiwan.net/poem66327.html","مجزوء الرمل"],[51,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[51,"كان للأرض مرة ثقلان","https://www.aldiwan.net/poem66418.html","الخفيف"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[91,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[70,"أتقدح فيمن شرف الله قدره","https://www.aldiwan.net/poem42455.html","الطويل"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[85,"يا مريضا بالمناصب","https://www.aldiwan.net/poem7766.html","مجزوء الرمل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[45,"ياعلي بل يا أبا الحسن المالك","https://www.aldiwan.net/poem10199.html","الخفيف"],[28,"أجيبوا صدى جلد إذا ما دعاكم","https://www.aldiwan.net/poem5439.html","الطويل"],[49,"اتق الله بجهدك","https://www.aldiwan.net/poem62061.html","مجزوء الرمل"],[66,"أتقتص مني إن جنى الغير زلة","https://www.aldiwan.net/poem38785.html","الطويل"],[97,"هذه دارها فلا تدعاني","https://www.aldiwan.net/poem24383.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[69,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[31,"قلت بالخيف مرة","https://www.aldiwan.net/poem41328.html","مجزوء الخفيف"],[105,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[105,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"رع بجيش اللذات سرب الشجون","https://www.aldiwan.net/poem61479.html","الخفيف"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"غزال به فتر وفيه تأنث","https://www.aldiwan.net/poem64352.html","الطويل"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[46,"من عير الخيل إنسانا فقد خبلا","https://www.aldiwan.net/poem23161.html","البسيط"],[76,"أتقتلني ظلما وتجحدني قتلي","https://www.aldiwan.net/poem39013.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42625","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10160","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[106,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[94,"وانجلت نفسي في النور","https://www.poetsgate.com/ViewPoem.aspx?id=15612",""],[32,"بثينة قد قالت","https://www.poetsgate.com/ViewPoem.aspx?id=109",""],[87,"شفَّنى وجدى ، وأبلانِى السهَر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23954&r=&rc=216",""],[120,"قد وجدت السهد أهدى للأسى","https://www.aldiwan.net/poem49278.html","الرمل"],[129,"ترى ما انت ماذا فيك","https://www.aldiwan.net/poem67445.html","مجزوء الوافر"],[135,"أتقضي معي إن حان حيني تجاربي","https://www.aldiwan.net/poem49194.html","الطويل"],[143,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[169,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[169,"صبا شوقاً فحن إلى الديار","https://www.aldiwan.net/poem1627.html",""],[169,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[181,"ألا هل لأيام تولين مطلب","https://www.aldiwan.net/poem58840.html","الطويل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[211,"يا ليلة العيد ماذا أنت صانعة","https://www.aldiwan.net/poem46320.html","البسيط"],[211,"يا قوم ما هذي شريعة الأدب","https://www.aldiwan.net/poem46325.html","الرجز"],[223,"ومليح أخذته صاحب","https://www.aldiwan.net/poem41889.html","الخفيف"],[235,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[237,"لله يوم شربنا فيه كأس منى","https://www.aldiwan.net/poem19743.html","البسيط"],[254,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[271,"أراني ما ذكرت لك الفراقا","https://www.aldiwan.net/poem52101.html","الوافر"],[282,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[349,"قل لمن قال إن باري البرايا","https://www.aldiwan.net/poem16017.html","الخفيف"],[357,"أولوع وغربة وسقام","https://www.aldiwan.net/poem4172.html","الخفيف"],[366,"أتقبل نحوي يا مشيب مخاطبا","https://www.aldiwan.net/poem17710.html","المديد"],[371,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[391,"يا خليلي إن شئت كل السرور","https://www.aldiwan.net/poem54568.html","عموديه"],[416,"قد ركبنا بمركب الدخان","https://www.aldiwan.net/poem53823.html","الخفيف"],[416,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[429,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[458,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[464,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[468,"يا من يقدر أنه مثلي","https://www.aldiwan.net/poem59762.html","أحذ الكامل"],[538,"أيها الثقلاء بالله فينا","https://www.aldiwan.net/poem48314.html","عموديه"],[569,"اتق الأحمق أَن تصحبه","https://www.aldiwan.net/poem51998.html","الرمل"],[575,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"],[576,"أبلغ ضبيعة كهلها ووليدها","https://www.aldiwan.net/poem1779.html","الكامل"]],"verses":[["اِتَّقِ ما بي تَتَقّي","وَلَو أَنابيبَ القَنا",0,"ن",2,0],["إِتَّقوا بَذلَةَ العُيونِ فَغابوا","وَبِآرائِهِم يُرَبُّ الأَنامُ",1,"م",1,1],["أَتَقتَصُّ مِن جَسَدي بِالبِعادِ","وَما زُوِّدَ الباعُ مِنكَ العِناقا",2,"ق",2,0],["أَتَقنَعُ أَن تُضامَ وَأَنتَ حامٍ","وَتُهمِلُنا البِقاعُ وَأَنتَ راعِ",3,"ع",1,0],["أَتَّقى الرَميَ وَلَو شِئتُ مَضى","كُلُّ مَطرورٍ إِذا صَمَّمَ عَطّ",4,"ط",1,0],["أَتَقَرّى هَذا الأَنامَ فَيَغدو","عَجَبي مِنهُمُ طَريقاً لِعُجبي",5,"ي",1,0],["أَتَّقي سُخطَها فِراراً مِن الهَج","رِ وَإِن أَذنَبَت طَلَبتُ رِضاها",6,"ا",3,0],["أتَقْعُدُ عنْ قاضِي القُضاةِ ابْنِ أكْتَمٍ","وعنْ حسَنٍ منْ بعْدِ ما نشَرَ اللِّوا",7,"و",2,0],["أَتَقَرّى التُجارَ في سائِرِ الخا","ناتِ ظُهراً عِندَ استِواءِ القُدورِ",8,"ر",1,0],["أتقاضى مَراضعي من صَبابا","تِ صديقي وذكْرِهِ وافتقادِهْ",9,"د",2,0],["أتقبل دعوى الظن وهي مُخيلةٌ","وتتركُ مثلي وهْي غيرُ مُخيلِ",10,"ل",1,0],["اتَّقِ الله ففي قوْ","لِكَ عُدوانٌ وإثمُ",11,"م",1,0],["أتقْلِبُ ذا مُحافظةٍ عَدُوّاً","لعمرُو أبيك ما هذا بحزْمِ",12,"م",1,0],["أتَّقِي غصةَ اسمِه علمَ اللَّ","هُ فأكنِي عن ذكره بالمعاني",13,"ن",2,0],["أتقي الشرَّ جاهداً فإذا ما","حُمَّ حَمِّي تركتُهُ يتقيني",14,"ن",2,0],["أَتَقولونَ إِنَّهُ مَجنونُ","أَتَقولونَ إِنَّهُ مَفتونُ",15,"ن",1,0],["أَتَقولونَ شاعِرٌ مِسكينُ","كَم مَليكٍ كَم قائِدٍ كَم وَزيرِ",15,"ر",1,0],["أَتَقدَحُ فيمَن شَرَّفَ اللَهُ قَدرَهُ","وَمازالَ مَخصوصاً بِهِ طَيِّبُ الثَنا",16,"ن",2,1],["أتقوا الأيام في أعقابكم","أأخذتم لهمُ عهد السنين",17,"ن",1,0],["أتقن الصنعة تُفلح","وتُوفَّق للكمال",18,"ل",1,0],["أَتقَنوا الصَنعَةَ حَتّى","أَخَذوا الخُلدَ اِغتِصابا",19,"ب",2,0],["أَتقِنوا يُحبِبكُمُ اللَ","هُ وَيَرفَعكُم جَنابا",19,"ب",2,0],["إِتَّقِ اللَهَ أَنتَ شاعِرُ قَيسٍ","لا تَكُن وَصمَةً عَلى الشُعَراءِ",20,"ا",2,0],["أَتَقتُلُكُم في غَيرِ جُرمٍ عَبيدُكُم","وَفيكُم رَوابي عامِرٍ وَفُضولُها",21,"ل",3,0],["اِتَّقِ اللَهَ بِجُهدِك","قاصِداً أَو بَعضَ جَهدِك",22,"ك",1,1],["أَتَقتَصُّ مِنّي إِن جَنى الغَيرُ زَلَّةً","كَكاسِرِ دَنِّ الخَلِّ إِن جَنَتِ الخَمرُ",23,"ر",1,1],["أتقولانِ قد تسليتُ عنها","ومسحتُ الدموعَ من أجفاني",24,"ي",1,0],["أتقول أعمارٌ مضيعة","ماذا صنعت بعمرك الغالي",25,"ي",1,0],["أتقنتَ في أيامِكَ البيعَ وال","صرفَ وما دافعَ بابَ الولا",26,"ل",2,0],["إِتَّقي اللَهَ في فَتىً","ماجِدٍ أُختَ هاشِمِ",27,"م",1,0],["اتَّقِ اللَهَ وَعَظِّم حَقَّهُ","وَتَأَمَّل كَيفَ تَفنى الدُوَلُ",28,"ل",1,0],["أَتَقذِفُهُم إِلى لَهَواتِ ضارٍ","مَلِيٍّ أَن يَغولَهُمُ اِزدِرادا",29,"د",2,0],["اتَّقِ اللّهَ ولا تَبْغِ الأَذَى","وَاتَّبِعْ ما قال خيرُ الرُّحَمَاءْ",30,"ا",2,0],["أَتَقدَحُ يا حُويطبُ زَنْدَ سُوءٍ","دَعِ الرأيَ الرشيدَ وَزِدْهُ قَدْحا",31,"ح",2,0],["اتَّقِ اللهَ يا سراقةُ وانظر","هل ترى الأمر هيّناً ميسورا",32,"ر",2,0],["أَتَّقي أَعيُنَ الظِباءِ وَلَكِ","نَّ قُلوبَ الآسادِ قَد تَتَّقيني",33,"ن",2,0],["أتَقَرَّى جمالَ ذاتكِ في ما","أبدعتْهُ يَمينُها من فنون",34,"ن",1,0],["أتقدُّماً فيهمْ وأنتَ مؤخَّرٌ","وتشبّهاً بهِمُ وأنْتَ دَخيل",35,"ل",1,0],["أَتَقتُلُني إِن قُلتُ إِنّي أُحِبُّكُم","وَلا ذَنبَ لي إِن كانَ في الناسِ قَد فَشا",36,"ش",2,0],["أَتَقَضّى مَعَ الصَباحِ فَلا أَط","لُبُ رِزقاً وَبي مِنَ السُهدِ سُكرُ",37,"ر",1,0],["أَتَقبَلُ النُصحَ مِنّي أَم تُضَيِّعُهُ","وَرُبَّ مِثلِكَ أَلغاهُ فَما قَبِلا",38,"ل",2,0],["أَتَقتُلني ظُلماً وتجحَدُني قَتلي","وقد قامَ مِن عينيكَ لي شاهِدا عَدْلِ",39,"ل",1,1],["أَتَقَرَّى الشَّيءَ أَبْغِيهِ فَلا","أَجِدُ الشَّيءَ وَلا نَفْسِي تَقَرْ",40,"ر",1,0],["أَتْقَنَتَهَا أَيْدِي الصِّنَاعَاتِ حَتى","لَيْسَ فِيهَا الإِتْقَانُ بِالمُسْتَزَادِ",41,"د",1,0],["أَتُقفِلُ مَطبَخاً لا شَيءَ فيهِ","مِنَ الدُنيا يُخافُ عَلَيهِ أَكلُ",42,"ل",1,1],["أتَقَرَّى الطّريقَ فيه بِكَفِّي","بين شَكٍ وحَيْرَةٍ وضَلال",43,"ل",1,0],["أَتَقَاسَما فيها الوَدَاعَ بلَفْظَةٍ","أَمْ لَمْ تدَعْ لَهُمَا المَنُونُ كلاَما",44,"م",2,0],["أتقنتَ فنَّكَ لم تطلب به عرضًا","ولم تُتاجر به في السُّوق مُكتسبا",45,"ب",2,0],["أتقيّ وهو ينفي كلّ ما","لم يؤيّد بيقين أو بحسّ",46,"س",1,0],["أتقرح أكباد المحبين كالذي","أرى كبدي من حب بثنة يقرح",47,"ح",1,0],["أتقرَّى الشَئَ أبغيهِ ، فلا","أجِدُ الشئَ ، ولا نفسى تقَر",48,"ر",1,0],["أتقيها والكرى يقذف بي","وأغض الطرف والقلب يرى",49,"ا",1,0],["أتَقصِدُ أن تَطولَ الأوجَ","قُربَ العَرشِ أو أدنى",50,"ن",2,0],["أتقضي معي إن حان حَيْني تجاربي","وما نلتها إلاّ بطول عناءِ",51,"ا",2,1],["أَتَقعُدُ عَن مُرتَقاهُ النُجو","مُ عَجزاً وَيَطمَعُ فيهِ البَخَر",52,"ر",1,0],["أَتقاهُ لِلّهِ أَم عِلمُهُ البَا","هِرُ أَم حُسنُ حِفظِهِ لِلوِدادِ",53,"د",1,0],["أَتَقنَعُ بِالعَلاةِ مِنَ العَلالي","بَديلاً وَالمُثارِ مِن الوِثارِ",54,"ر",1,0],["أَتَقنَعُونَ بِأَن أَطوي رَجاءَكُمُ","يَأساً وَأَن أَتَرَجّى الحَيَّ قَحطانا",55,"ن",2,0],["أَتَقرِبَةً لِلصَّرمِ أَم دَفعَ حاجةٍ","أَرَادَت بِهِ أَم ذاتَ بَينِكَ تَقرُبُ",56,"ب",1,0],["أَتَقولُ الضلّالُ ما هم عدولٌ","مَن تُرى ثابتٌ به الإدّعاءُ",57,"ا",2,0],["اتقّي اللهَ إني رأيتُ الجفون","تعلمُ نفسي لديكِ انكسارا",58,"ر",2,0],["أتقبلين وما لي فيك من أمل","غير اللياذ بأطياف المواعيد",59,"د",1,0],["أتقبلون عابد العزيز","وليس بالمترو ولا الوزيزي",60,"ي",1,0],["أَتقَنَ اللَهُ فَنَّه فيهِ","وَأَجادَ التَنسيقَ في الحاجِب",61,"ب",1,0],["أَتَقطَعُ فيكَ الأَرضَ غُرُّ مَدائِحي","وَيَقرَعُ أَبوابَ السَماءِ دُعائي",62,"ي",1,0],["اِتَّقِ اللهَ مَا اسْتَطَعْتَ فَإِنَّ ال","لَّهَ رَبِّي مَعَ الذِينَ اتَّقَوْهُ",63,"و",2,0],["أَتَّقي هجراً مهيناً","ساعياً بي نحو حتفي",64,"ف",2,0],["أَتَقبل يا محمد عذر عبد","يحن اليك من برع اِشتياقا",65,"ق",2,0],["أَتَقاضاهُ ف