{"poems":[[136,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120082","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117309","البسيط"]],"verses":[["فَقَاصِيهِ دَانٍ لِي وعَاصِيهِ دائنٌ","وأعينُهُ شَوقاً ِإليَّ رَوَانِ",0,"ن",1,0],["فقاصده بالغنى ظافر","وحاسده بالردى مقصدُ",1,"د",1,0],["فقاصِ أو دانِ ما تهوى وتحذره","فالأرض سيان قاصيها ودانيها",2,"ي",3,0],["فقاصدُ اللَه لا يخيب","بطيب ذكراكمُ التذاذى",3,"ذ",2,0]]}