{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[53,"لها ناظر بالسحر في القلب نافث","https://www.aldiwan.net/poem9234.html","الطويل"],[53,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[72,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[91,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[91,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[87,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[45,"كدعواك كل يدعي صحة العقل","https://www.aldiwan.net/poem10137.html","الطويل"],[30,"إليك ابن سيار فتى الجود واعست","https://www.aldiwan.net/poem5297.html","الطويل"],[60,"تغيرت المودة والإخاء","https://www.aldiwan.net/poem31208.html","الوافر"],[99,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[82,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202701","المجتث"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[102,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[53,"يا مَنْ جلا دهْرُنا دُجاهُ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30095",""],[138,"ألا أبلغا عني لؤيا رسالة","https://www.aldiwan.net/poem21029.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[189,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[190,"وما هذه الأيام إلا معارة","https://www.aldiwan.net/poem43949.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[214,"أبشراي عادت للديار الحبائب","https://www.aldiwan.net/poem13467.html","الطويل"],[216,"ألا كل ليل زار فيه خليل","https://www.aldiwan.net/poem37840.html","الطويل"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[412,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[422,"عفا الله عن ذاك الحبيب وإن جنى","https://www.aldiwan.net/poem54002.html","الطويل"],[445,"بفتح الفتوح وسعد السعود","https://www.aldiwan.net/poem34864.html","المتقارب"],[457,"وظبي غرير أودع الله ثغره","https://www.aldiwan.net/poem13774.html","الطويل"],[458,"يا حامل الثمر الرفاف من جذل","https://www.aldiwan.net/poem61313.html","البسيط"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[473,"أفضى إلى ذكري شيطان","https://www.aldiwan.net/poem59570.html","السريع"],[487,"سرى بفؤادي الوجد نحوك هائم","https://www.aldiwan.net/poem24474.html","عموديه"],[514,"سا ئل سدوس التي أفنى كتائبها","https://www.aldiwan.net/poem747.html",""],[556,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37865","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37883","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96373","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119956","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35383","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56187","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64770","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[1722,"","https://poetry.dctabudhabi.ae/diwan/poem/177989","الطويل"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116940","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108496","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124767","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60845","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2480,"","https://poetry.dctabudhabi.ae/diwan/poem/138769",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45340","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132650","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103378","المتقارب"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202342","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131246",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114490","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119655","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4448,"","https://poetry.dctabudhabi.ae/diwan/poem/31418","البسيط"],[4859,"ونسيت نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=211153",""],[5237,"مرادي من المولى وغاية آمال","https://www.poetsgate.com/ViewPoem.aspx?id=113106",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5616,"كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=203426",""],[5626,"أفصحي","https://www.poetsgate.com/ViewPoem.aspx?id=189717",""],[5818,"وصاحبْ حكيماً حليماً","https://www.poetsgate.com/ViewPoem.aspx?id=199614",""],[5829,"فتاة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=210632",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5974,"إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=215788",""],[6125,"سَحيقٌ في حناياهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210596",""]],"verses":[["وَكُلِّ جَوبٍ مُترَصٍ صُنعُهُ","وَصارِمٍ ذي رَونَقٍ باتِرِ",0,"ر",1,0],["وكلُّ جديدٍ لا مَحالةَ مُخلِقٌ","وباعثُ هذا الخَلْقِ للخلقِ وارثُ",1,"ث",1,0],["وكلُّ جارٍ غدوتَ تَعْصِمُه","فليس ذاكَ الحريمُ منتهكا",2,"ك",2,0],["وَكُلِّ جَوادٍ لَم يَكُن قَطُّ مِثلُهُ","لَآلِ زُهَيرٍ لا وَلا لِبَني بَدرِ",3,"ر",1,0],["وكل جنس له نقص بمفرده","اما الحياة فبالجنسين تكتمل",4,"ل",1,0],["وكل جديدٍ سوف يرجع للبِلى","إذا لم يكن منه له اللَه واقيا",5,"ي",2,0],["وَكُلّ جُرمٍ واقِعُ العِقاب","وَلَو عَلى الأَنسالِ وَالأَعقابِ",6,"ب",1,0],["وَكُلَّ جَوادٍ تَلطِمُ الأَرضَ كَفُّهُ","بِأَغنى عَنِ النَعلِ الحَديدِ مِنَ النَعلِ",7,"ل",1,0],["وَكُلُّ جَسورٍ بِالمِئينَ وَمُطعِمٍ","إِذا اِغبَرَّ آفاقُ الرِياحِ الزَعازِعِ",8,"ع",1,0],["وَكُلُّ جِراحَةٍ فَلَها دَواءٌ","وَسوءُ الخُلقِ لَيسَ لَهُ دَواءُ",9,"ا",2,0],["وكلُّ جمالٍ في الوجودِ حيالَه","به ذلةُ الشاكي ومرحمةُ العبدِ",10,"د",1,0],["وكلّ جبّارٍ أتى أرْضَهُ","مُقَبّل بالرّغمِ منه الرّغام",11,"م",1,0],["وَكُلُّ جَدْبٍ لَه الأنوَاءُ ماحِيةٌ","وَجَدْبُ جسميَ لا تمحوهُ أنْوَائي",12,"ا",2,0],["وَكلُّ جُرْحٍ بِجِسْمٍ يَسْتَهِلُّ دُماً","كأَنَّهُ مَبْسَمٌ بالرَّاحِ مَعْلُولُ",13,"ل",1,0],["وَكُلِّ جَيّاشِ العَشايا نَهدِ","في لِبدِهِ وَالمَوتُ فَوقَ اللِبدِ",14,"د",1,0],["وكلُّ جَوادٍ شَفَّهُ الركْضُ فيهِمُ","وَجٍ يتَمنّى أنّ فارسَه سِقْطُ",15,"ط",1,0],["وكل جرح وسعته","وكل جرح بميعاد",16,"د",1,0],["وكل جزءٍ في الكتابِ يدركُ","يسكن منه الخامسُ المحركُ",17,"ك",1,0],["وكُلُّ جُزءٍ في الضُّروبِ كائنِ","أُسقطَ منهُ آخرُ السَّواكنِ",17,"ن",1,0],["وكلُّ جمعٍ إلى بَيْنٍ وتفرقةٍ","وكلُّ شملٍ إلى نأْيٍ وتبديد",18,"د",1,0],["وكلّ جبان شجاع الفؤاد º","عليك º إذا أنت مستسلمُ",19,"م",1,0],["وكلُّ جارٍ غدوتَ تَعْصِمُه","فليس ذاكَ الحريمُ منهكا",20,"ك",2,0],["وَكُلِّ جَرورِ الذَيلِ زَعفٍ مُفاضَةٍ","دِلاصٍ كَهَزهازِ الغَديرِ المُسَلسَلِ",21,"ل",1,0],["وكل جراح غير حرج عداوة","نهضت بها في الله يبرى ويندب",22,"ب",1,0],["وكلٌّ جَلَّ عن شَبَهٍ ومِثْلٍ","وفاق عن المُطاوِل والمُسامِى",23,"م",2,0],["وكل جديد أخلقته يد البلى","فرتّ لقوم قادمين جديد",24,"د",1,0],["وَكلُّ جَوابٍ فيه غير مطابقٍ","لِمعني كَلامي عندَ مَن يفهمُ الأمرا",25,"ر",2,0],["وَكلُّ جَمالٍ أنتِ في الكون أصلهُ","وَأصلُ جميعِ القبحِ ضرّاتك الأخرى",26,"ر",2,0],["وَكلِّ جمعٍ في الوَرى وفردِ","لخّصتُ فيهِ مولدَ الدرديرِ",27,"ر",1,0],["وكلٌّ جرى فيهِ دمٌ غيرَ أنني","أرى الحرص طفلاً من دمِ الناسِ يرضعُ",28,"ع",1,0],["وكل جموح بالسلاسل قدته","إليك كما يوما تقاد الجنائب",29,"ب",1,0],["وكل جليس رام تفنيد عاشق","فذاك على قلب المحب ثقيلُ",30,"ل",1,0],["وكلُّ جمالِ الشّرقِ في فتياتنا","فإن تُبصري أجفانهنَّ تذوبي",31,"ب",2,0],["وَكُلُّ جِراحَةٍ تُوسى فَتَبرا","وَلا يَبرا إِذا جرَحَ الهَجاءُ",32,"ا",2,0],["وكل جنايتها أنها","تريد الحياة فيأبى الزمن",33,"ن",1,0],["وَكُلُّ جُزئِيٍّ فَكُلِيُّهُ","جَزءٌ لَما خَوَّلَهُ الحُبُّ",34,"ب",1,0],["وكل جَموحِ الشَدِّ فوق سَراته","غلامٌ لأطرافِ الرّماح مُلاعِب",35,"ب",1,0],["وَكُلُّ جَوادٍ سَيدٍ غَيرَ أَنَّهُ","يُقَصِّرُ عَن بَحرِ العَطايا غَزيرُها",36,"ر",3,0],["وكلّ جواد يقتني المال للندى","وينفق يوم الجود أنفس ما اقتنى",37,"ن",2,0],["وكُلِّ جَوَادٍ نَمَتْهُ يَدَاكَ","فأَعْرَقَ فِي سَرْوِ بَأْسٍ وَجُودِ",38,"د",1,0],["وكلُّ جمالٍ مشرقٍ يملك الحشا","هواه ولكنَّ الحَريري بنا أحرى",39,"ر",2,0],["وكل جوهرة عصماء ضاحكة","بالنور والنور أفراح وأعراس",40,"س",1,0],["وكلّ جسم لا مجدَ فيه","فأنت في صدره غليلُ",41,"ل",1,0],["وكلُّ جِبْسٍ يدُه ووجهُهُ","من حَجرٍ يُلقَمُ منّي حَجَرا",42,"ر",2,0],["وكل جوادٍ سابحٍ تحت راية","وليس هما إلاَّ عقابٌ على صقر",43,"ر",1,0],["وَكُلُّ جُزءٍ مِنهُ كُرّاسَةٌ","وَرُبَّ بَيتٍ مِنهُ ديوانُ",44,"ن",1,0],["وكل جمال في البرية أصله","جمال له كل القلوب تراجم",45,"م",1,0],["وَكُلِّ جَرداءَ مِثلِ السَهمِ يَكنُفُها","مِن كُلِّ ناحِيَةٍ لَيثٌ لَهُ حَسَبُ",46,"ب",1,0],["وكلّ جريء البأس مثل حياته","إِذا خاف ذلّاً أنْ يموت قتيلا",47,"ل",2,0],["وَكُلُّ جاهِل عِلم لا يَحُلُّ لَهُ","أَن يَفعَلَ الفِعلَ حَتّى يَعلَمَ الخَبَرا",48,"ر",2,0],["وَكُلُّ جَمعٍ ناواهُم اِنقَلَبَت","فُرسانُهُ وَهيَ لِلظَبيِ جُزُرُ",49,"ر",1,0],["وَكُلُّ جَميلٍ في الأَماسي هوَ اِسمُها","وَتَحوي مِن الأَوصافِ ما هوَ أَطيبُ",50,"ب",1,0],["وَكُلُّ جَميلٍ ما حَوى الحُسنَ كلّهَ","وَلَكِنَّ كُلَّ الحسنِ يَحويه يوسُفُ",51,"ف",1,0],["وكلِّ جَذَمِّهِ خَرِبٍ محيلٍ","كأنّ بقيةً منه جدارُ",52,"ر",1,0],["وكل جيل لجب أرعن","كأنه السيل يطول الرعان",53,"ن",1,0],["وَكُلُّ جيلٍ يَؤُمّونَ إِلَيكَ فَمِن","عُربٍ وَعُجمٍ وَأَروامٍ وَأَتراكِ",54,"ك",1,0],["وكل جارحةٍ مني ونابضةٍ","ما دمت حياً تناديّ للدعاء فما",55,"م",2,0],["وَكلُّ جَوادٍ فاقَ طَلُّكَ وَبْلَهُ","سَماحاً وإِنْ كانَتْ أَياديهِ أَبْحُرا",56,"ر",2,0],["وكل جزء حله تغيير","يأتيك في باب له تفسير",57,"ر",1,0],["وكل جرَّةٍ رددتها الى","خطِّ اليمينِ مثل جيمٍ جملا",58,"ل",2,0],["وكلِّ جَفْنٍ بالنّدَى مُكْتَحِلِ","يبيتُ من حَوْكِ الحيا في حُلَلِ",59,"ل",1,0],["وَكُلُّ جَوَادٍ عن مَدَاكَ مُقَصِّرٌ","وكلُّ كبيرٍ عن نَدَاكُ صغير",60,"ر",1,0],["وكلُّ جديدٍ يا أُمَيْمَ إلى بِلًى","وكلُّ امرئٍ يوماً يَصير إلى كانْ",61,"ن",1,0],["وكل جنس فله قالبٌ","وعنصرٌ أعراقهُ تسرى",62,"ر",2,0],["وكل جنس فله مدةٌ","تعاقب الأنواء في الشهر",62,"ر",1,0],["وكل جرحٍ لم يقر قطرهُ","صلى به والقلبُ في حذر",63,"ر",1,0],["وكل جانحة في الصدر خافقة","شوقاً إلى ساعة اللقيا التي ازفت",64,"ت",1,0],["وكل جالسا فوق اليسار وناصب ال","يمين وبسمل ثم في الإنتها احمد",65,"د",1,0],["وكل جهول بالقضاء فإنّه","حرام عليه فليحذّر ويوعد",66,"د",1,0],["وكل جَردآء عَيْطلٍ","كلّ كميتٍ مُقْربِ",67,"ب",1,0],["وكل جزء خصصوا محله","بالضرب من زحاف أو من عله",68,"ه",1,0],["وكل جواد سابح بدمائهم","كما سبحت أهلا لمكارم في الثرى",69,"ر",2,0],["وكلُّ جُزرِ جا إليهنَّ رما","رجالَهُ فيها وفيها حَكَمَا",70,"م",2,0],["وَكُلُّ جَديدٍ سَوفَ يَخلُقُ حُسنهُ","وَما لَم يُوَدَّع مِثلَ ما كانَ وَدَّعا",71,"ع",2,0],["وكلّ جَلاَد على خَلوةٍ","عميرةً هاجَتْ بهِ عُمره",72,"ر",2,0],["وكل جواد يستماح بشافع","ونفسك في المعروف للناس تشفع",73,"ع",1,0],["وكل جبار الوقت اقطع عروقه","وأوراقه وأغصانه الممدة",74,"ه",1,0],["وكُل جَوَادٍ له مَيعَةٌ","يَخُبُّ بسرجك بَعد الكلالِ",75,"ل",1,0],["وكل جياد لم تقدها عواثر","وكل نصال لم ترشها نواصل",76,"ل",1,0],["وكل جعد القفا لولا تبختره","لخلته جلمداً أوخلته صنما",77,"م",2,0],["وكل جميلٍ منهُ نالَ جمالهُ","وكلُّ بديعٍ منهُ نالَ بدائعَه",78,"ع",2,0],["وَكُل جَرجور طَويلِ السَيفِ","فَأَكثِروا مِنهُ بَغَيرِ حَيفِ",79,"ف",1,0],["وكل جماعة والتلك صارت","ولو كانوا زعانف خير عين",80,"ن",1,0],["وكل جود لدى نداه","محتقر في العيون نزر",81,"ر",1,0],["وكلّ جوادٍ خفَّ سنْبكه فما","يمسّ الثرى إلاَّ مخالسةً فرطا",82,"ط",2,0],["وَكُلُّ جَمعٍ بِرَزذابارَ كانَ لَهُم","قَد فَضَّ بِالطَعنِ بَينَ النَخلِ وَالبيدِ",83,"د",1,0],["وكل جريمتي أنّي بحبي","بنيت نعيمكم ونسيت نفسي!",84,"س",2,0],["وكل جبان قل أن يبلغ المنى","وما عامل في فوزه مثل بطال",85,"ل",1,0],["وكل جميع الأنبياء فثابت","لهم إله في كل ما خط أو سطر",86,"ر",1,0],["وكل جواب فيه معنى مطابق","لمعنى حرامٍ رام الأحمق المغرى",87,"ر",2,0],["وكل جميع المنكرات فسايغ","لديهم وما منكم لذلك منكسر",88,"ر",1,0],["وكلّ جنائز الدنيا أمامي","فلا دمعٌ يسيل ولا حِدادُ!",89,"د",1,0],["وكلُّ جرحٍ نما ،، فالحبُّ يُبرئُهُ","إنَّ الجِراحَ ،،لقاءُ الخلِّ يُبريها",90,"ي",3,0],["وكلّ جوابٍ بهِ ثغرة ٌ","يناقض آخره أوّلهْ",91,"ل",2,0],["وكلّ جوارحي تهتم حتى","تقول أيا صاح الهوى تدبّر",92,"ر",1,0],["وكل جِنانٍ لم يجد خطوها بها","يرى كل غصنٍ باسقٍ ، غيرَ باسقِ",93,"ق",1,0],["وكل جاري بلطيف معنى","على التقدير والمعنى لطيف",94,"ف",1,0],["وكلُّ جديدٍ أراه شبيهاً","أميل إليه بحبٍّ لصيقْ",95,"ق",1,0],["وكل جوارحي يا ربّ تهفو","إليك ، وليس لي ربّ سواكا",96,"ك",2,0],["وكلُّ جراحيَ التأمتْ","متى أيقنتُ رؤياهُ",97,"ا",2,0]]}