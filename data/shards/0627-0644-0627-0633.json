{"poems":[[53,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"أفل الألى كانوا نجو","https://www.aldiwan.net/poem36114.html","مجزوء الكامل"],[71,"ألا سقياني فالظلام قد انجلى","https://www.aldiwan.net/poem3842.html","الطويل"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[11,"ألا سبيل إلى مال يعارضني","https://www.aldiwan.net/poem252.html",""],[47,"أي اصطبار ليس بالزائل","https://www.aldiwan.net/poem25210.html","السريع"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8687.html","البسيط"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[29,"ألا سائل الجحاف هل هو ثائر","https://www.aldiwan.net/poem6101.html","الطويل"],[85,"اللى يحب الجمال","https://www.aldiwan.net/poem6807.html","عموديه"],[85,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[28,"ألا سلت الله ابن سلتى كما نعى","https://www.aldiwan.net/poem5280.html","الطويل"],[61,"ألا سقني الصهباء صرفا فإنني","https://www.aldiwan.net/poem51540.html","الطويل"],[61,"خليلي إن الغيث أوله قطر","https://www.aldiwan.net/poem51606.html","الطويل"],[31,"يا صاح لا تلحني وقل سددا","https://www.aldiwan.net/poem42564.html","المنسرح"],[74,"ألا ساجل دموعي ياغمام","https://www.aldiwan.net/poem13249.html","الوافر"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[105,"ولقد عجبت من الغواة وقولهم","https://www.aldiwan.net/poem43117.html","الكامل"],[105,"هي الأواصر أدناها الدم الجاري","https://www.aldiwan.net/poem44225.html","البسيط"],[52,"سقيا لدار بنهر الكرخ من دار","https://www.aldiwan.net/poem26978.html","البسيط"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"إني امرؤ أبغض النعاج وقد","https://www.aldiwan.net/poem66552.html","المنسرح"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85842","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55028","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[95,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=659",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[90,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[120,"ألا ليت شعري هل لمافات مرجع","https://www.aldiwan.net/poem49309.html","الطويل"],[131,"ألا سائل هوازن هل أتاها","https://www.aldiwan.net/poem23964.html","الوافر"],[143,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[147,"أيا سيدا فاق الكرام بمجده","https://www.aldiwan.net/poem47670.html","الطويل"],[160,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[165,"ألا سائل النعمان إن كنت سائلا","https://www.aldiwan.net/poem725.html",""],[166,"ألا سقيت أطلال ليلى وإن عفت","https://www.aldiwan.net/poem46849.html","الطويل"],[176,"ألا سائل الركبان هل طل لعلع","https://www.aldiwan.net/poem2691.html","الطويل"],[197,"حالي كحالك أيها الشحرور","https://www.aldiwan.net/poem39802.html","الكامل"],[207,"مابال عينك فيها عائر سهر","https://www.aldiwan.net/poem27960.html","البسيط"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[223,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[223,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[229,"ألا سقني بالملا الصحصح","https://www.aldiwan.net/poem51188.html","المتقارب"],[229,"ألا سقياني قهوة ذهبية","https://www.aldiwan.net/poem51198.html","الطويل"],[237,"بسبب الوجود","https://www.aldiwan.net/poem18183.html","مجزوء الرجز"],[237,"عين الوزارة ذا المقام السامك","https://www.aldiwan.net/poem18849.html","الكامل"],[262,"أدعوك بالرحم التي هي جمعت","https://www.aldiwan.net/poem68215.html","الكامل"],[275,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[298,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[298,"أعن اللهم من صورته من حزن","https://www.aldiwan.net/poem36850.html","عموديه"],[328,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[349,"الاسم للوصف غدا باطنا","https://www.aldiwan.net/poem15700.html","السريع"],[364,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[366,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[376,"حبيبتي دبي","https://www.aldiwan.net/poem965.html","عموديه"],[377,"عجيب أنك العذراء حبلى","https://www.aldiwan.net/poem66912.html","الوافر"],[393,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[429,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[429,"أبرق نراه أم سنا الصبح حاضر","https://www.aldiwan.net/poem41427.html","الطويل"],[434,"ألا ساعة يمحو بها الدهر ذنبه","https://www.aldiwan.net/poem25698.html","الطويل"],[458,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[458,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[465,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[500,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[537,"ألا سقني يا صاح خمرافإنني","https://www.aldiwan.net/poem69409.html","الطويل"],[538,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[551,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"]],"verses":[["أَلا سَلوَةٌ تَنهى الدُموعَ فَتَنتَهي","أَلا مَورِدٌ يَروي الغَليلَ فَيُنقَعُ",0,"ع",1,0],["أَلاَ سَقِّنِي مِنْهَا دِرَاكاً وَغَنَّنِي","عَلَى نَغَمَاتِ الْمِزْهَرِ الْمُتَرَنِّمِ",1,"م",1,0],["إِلاَّ سُخَاماً قَادِحاً","فِي الدِّينِ وَاللَّهُ الْمُسَلِّمُ",2,"م",1,0],["أَلا سَقِّياني فَالظَلامُ قَدِ انجَلى","وَأَبدَت تَباشيرُ الصَباحِ عَمودَها",3,"ه",2,1],["الأُسْرَةُ الأُمَّةُ الصَّغِيرَةُ إِنْ","تَنْهَضْ فَكِلْتَاهُمَا عَلَى قَدَمِ",4,"م",1,0],["الأسْمَرُ الحَالِي بِأَسْمَحِ مَا جَلاَ","لِلْعَيْنِ مِنْ شَمْسِ البِلاَدِ أدِيمُ",5,"م",1,0],["أَلا ساءَ ما تُبلي سَليطٌ إِذا رَبَت","جَواشِنُها وَاِزدادَ عَرضاً ظُهورُها",6,"ر",3,0],["أَلا سَبيلٌ إِلى مالٍ يُعارِضُني","كَما يُعارِضُ ماءُ الأَبطَحِ الجاري",7,"ي",1,1],["الأَسَدُ الباسِلُ وَالعارِضُ ال","هاطِلُ عِندَ الزَمَنِ الماحِلِ",8,"ل",1,0],["ألاسرائيل ….. تعلو ….. راية","في حمى المهد وظل الحرم !؟",9,"م",1,0],["الإست دارُ خراجٍ إن هي اجتُبِيتْ","خَرْجاً ولا دخل يأتيها فقد عطِبَتْ",10,"ت",1,0],["الأسدَ المستعدَّ منذ دَرَى","أن الزُّبَى للأسود محتَفره",11,"ر",2,0],["أَلا سائِلِ الجَحّافَ هَل هُوَ ثائِرٌ","بِقَتلى أُصيبَت مِن سُلَيمٍ وَعامِرِ",12,"ر",1,1],["الاسم عين وتلاقيها","قدح وخمره وساقى",13,"ق",2,0],["الأُسدُ تَزأَرُ في الحَديدِ وَلَن تَرى","في السِجنِ ضِرغاماً بَكى اِستِخذاءَ",14,"ا",2,0],["الأُسى واجِبٌ عَلى الحُرِّ إِمّا","نِيَّةً حُرَّةً وَإِمّا رِياءَ",15,"ا",2,0],["أَلا سَلَتَ اللَهُ اِبنَ سَلتى كَما نَعى","رَبيعاً تَجَلّى غَيمُهُ حينَ أَقلَعا",16,"ع",2,1],["ألا سَقِّني الصَّهباءَ صِرْفاً فإنَّني","لِمَنْ لامَ فيها ما حَييتُ مُخالِفُ",17,"ف",1,1],["ألا سَقِّياني من سلافَةِ خَمرةٍ","يجانبُها المَحمودُ والأبلَهُ الغَمْرُ",18,"ر",1,0],["إِلّا سَفاهاً وَإِنَّني كَلِفٌ","أَحسَبُ غَيِّي مِن حُبِّها رَشَدا",19,"د",2,0],["أَلا ساجِل دُموعي ياغَمامُ","وَطارِحني بِشَجوِكَ ياحَمامُ",20,"م",1,1],["أَلا سَرَتِ القَبولُ وَلَو نَسيما","وَجاذَبَني الشَبابُ وَلَو قَسيما",21,"م",2,1],["الأُسدُ رابِضَةٌ عَلى أَسوارِها","وَالبَأسُ يَهدِرُ وَالرَدى يَتَوَثَّبُ",22,"ب",1,0],["الأسرةُ اجتمعتْ في الدّارِ واحدةً","حُيّيتِ من أسرةٍ بُوركتِ من دَارِ",23,"ر",1,0],["أَلا سَبيلٌ إِلى وافٍ أُواصِلُهُ","فَقَد تَجَنَّبَ وَدّي كُلَّ غَدّارِ",24,"ر",1,0],["ألا سائِلُوا عنهُ البَتْولَ فتُخبَرُوا","أكانَتْ لهُ أُمّاً وكان لها ابنَم",25,"م",1,0],["إلّا سليمان إنّهُ رجلٌ","يحلُّ بيني وبينه القُبَلُ",26,"ل",1,0],["إِلّا سُلَيمانُ إِذ قالَ الإِلَهُ لَهُ","قُم في البَرِيَّةِ فَاِحدُدها عَنِ الفَنَدِ",27,"د",1,0],["أَلا سَفينَةَ أَو عِبراً أَمُدُّ لَهُ","كَفّي فَأَنجُوَ مِن شَرٍّ لَها غَمَرا",28,"ر",2,0],["إِلّا سَجِيّاتِ ما القُلوبِ","وَكَم يَصيرَنَّ شانِئاً حَبيبُ",29,"ب",1,0],["إلا سؤالاً","عندي وقصدي اكتناه",30,"ا",2,0],["ألا سَلهُ ماذا بعد سبعين حِجةً","أأنجز من وعدٍ أفكَّ قيودي",31,"ي",1,0],["أَلأُسْرَتانِ كمَا توَدُّهُمَا العُلَى","وَالنَّبَعانِ مِنَ النَّجَادِ الأَشْرَفِ",32,"ف",1,1],["ألا سيفٌ من الإيمانِ","يبري السيف مسنونا",33,"ن",2,0],["أَلا سَقَى اللهُ أرضَ القيروان حَياً","كأنَّه عَبَراتِي المُستهلّاتُ",34,"ت",1,0],["الأسرائيل تعلو راية","فيحمى المهد وضل الهرم",35,"م",1,0],["إلاَّ سَجِيَّاتُ ما القُلُو","بُ وكمْ يُصَيِّرْنَ شائنًا حَبِيبُ",36,"ب",1,0],["ألا ساعٍ ولو بخيال طيفٍ","يبشّر أنَّ عصَ الظلم بادا",37,"د",2,0],["ألا سلوة تشفي الفؤاد من الجوى","وتبرئه إني من الوجد موجع",38,"ع",1,0],["أَلا سائِل هَوازِنَ هَل أَتاها","بِما فَعَلَت بِيَ الجَعراءُ وَحدي",39,"ي",1,1],["الأَسَدُّ الأَشَدُّ إِن كانَ سِلمٌ","أَو وَغىً وَالأَلَدُّ عِندَ الجِدالِ",40,"ل",1,0],["ألا سمرٌ منكم بذا الليل عندنا","فألفاظكم أشهى إليّ من القطر",41,"ر",1,0],["الأسْدَ لم تكُ ارحياء من سطاً","والبحر من غيض يكاد يغيضُ",42,"ض",1,0],["ألا سائل النعمان إن كنت سائلا","وحي كلاب هل فتكت بخالد",43,"د",1,1],["ألا سُقيتْ أَطلالُ ليلى وإنْ عَفَتْ","مَغاني غَوانيها وولّى زَمانُها",44,"ن",3,1],["أَلا سائِلِ الرُّكبانَ هَل طَلَّ لَعلَعٌ","كَما كانَ مَطلولَ الأَصائِل سَجسَجا",45,"ج",2,1],["الأسد تؤسرُ والنعاج طليقةٌ","والصقر يهوي والغراب يطيرُ",46,"ر",1,0],["إِلّا سَوابِحَ كَالعِقبانِ مُقرَبَةً","في دارَةٍ حَولَها الأَخطارُ وَالعَكَرُ",47,"ر",1,0],["ألا سيف أجرّدهُ وأمضى","لأدفع عنك عادية الذئاب",48,"ب",1,0],["أَلإستِقلالُ يَنمو بِالتَآخي","وَيَضمر بِالشقاقِ وَيستدقُّ",49,"ق",1,0],["الأَسودُ الحالِكُ في لَونِهِ","إِذا مَشى أَمامَها يَفخَرُ",50,"ر",1,0],["ألاَ سَقِّني بالمَلا الصَّحْصَحِ","ونجمُ دجى الليل لم يَجْنَحِ",51,"ح",1,1],["ألا سَقِّياني قهوةً ذهبيَّة","وقد أَلبْسَ الآفاقَ جُنْحَ الدجى دَعَجْ",52,"ج",1,1],["أَلاَ سَتَرْتَ عِرْضَنَا","أَرَبِّ رَبَّ الْجُودِ",53,"د",1,0],["أَلاَ سَمِعْتُمْ قَوْلَنَا وَنَظَرْتُمُ","فِي شَأْنِ أَيْتَامٍ سُلاَلَةِ هَالِكِ",54,"ك",1,0],["إلَّا سَمِعتَ وَأَنتَ أكرَمُ مَن مَشَى","مِن مُنشِدٍ يَرجو جَزَاءَ المُنشِدِ",55,"د",1,0],["أَلا سِرُّ الهِدَايَةِ فيهِ بادٍ","لسَبَّاقِ العِنَايَةِ في البَدِيِّ",56,"ي",1,0],["الأسى والسهد والدم","ع عَلَى الوامقِ ألبُ",57,"ب",1,0],["الأَسى في مقلتيهِ قَدْ مَحا كلَّ ضياءِ","جاعلٌ في مسمعيه كلَّ صوتٍ كالبكاءِ",58,"ا",2,0],["الأساطين عنده كالصعا","ليك ونجم السما كصخر الفلاة",59,"ه",1,0],["الاِسمُ لِلوَصفِ غَدا باطِناً","وَهوَ لِمَعنى كَونِهِ ظاهِرُ",60,"ر",1,1],["إلاّ سديدَ الحضرة النَّدْبَ الذي","يُبدِي فعالَ الماجدِ ابنِ الماجد",61,"د",1,0],["أَلا سُقِيَت تِلكَ المَعالِمُ دَعوَةً","عَنَتني فَإِنّي بَعضُ تِلكَ المَعالِمِ",62,"م",1,0],["إلا سِهَامُكِ مُنْذ ُاسْتَوْطَنتْ جَسَدي","حتى أثارتْ جُنُوْنًا صَارَ مَوْهِبتي",63,"ت",2,0],["ألا سروا بمريم مذ حبتكم","حياةً ما لمشرقها مغارب",64,"ب",1,0],["أَلا ساءَ ذا عاراً عَلى الدينِ ظاهِراً","يُشيرُ إِلَيهِ الأَجنَبِيُّ المُحارِبُ",65,"ب",1,0],["ألا سُقِيَتْ منازلُ آل سلمى","بذي سَلمَ ورامة والغميم",66,"م",1,0],["الأسعد قوما ان نسبَت","أمرا الافاق له العظمى",67,"م",2,0],["الأسائل الفرسان عن فتكه وسل","صوارمه يخبرك عضبٌ وضامر",68,"ر",1,0],["أَلا ساعَةٌ يَمْحو بِها الدَّهْرُ ذَنْبِهُ","فَقَدْ طالَ ما أَشْكُو وَما أَتَبَرَّمُ",69,"م",1,1],["إلاّ سؤالَ الباخلين فإنه","غُمَّى عليَّ سبيلُها مغمومُ",70,"م",1,0],["ألا سَلْ قريشاً ولُمْ منهُمُ","من استوجبَ اللومَ أو فنِّدِ",71,"د",1,0],["إلاّ سَمِعنا سَلاماً مِنكَ تُرسِلُهُ","عَبْرَ البُحورِ ، وَتَرجيعاً لَهُ طَرِبا !",72,"ب",2,0],["الأُسْدُ ترهَبُنا في كلِّ نازِلَةٍ","تَرى لها في قُوى الميدانِ إطْراقَا",73,"ق",2,0],["ألا سَقِّني يا صاحِ خمراًفإنّني","بما أنزلَ الرحمنُ في الخمرِ عالمُ",74,"م",1,1],["ألاَ سُبَّةً للجاهلين وضِلَّةً","لِسَعيهُمُ يرجونَ منه ابتِعَاديَا",75,"ي",2,0],["ألأسرَ والتَّقتيلَ كان نَصيبُه","ولِشَعبِه التَّخريبُ والتَّدميرُ",76,"ر",1,0],["ألا سقّياني دمعَ عينِيَ بعدَه","ولا تُسمعاني غيرَ صوتِ النّوادبِ",77,"ب",1,0],["الأَسَدُ المُسْتَفِيْضُ إِنْ الأُ","سُودَ فِي عَيْنِهِ ضِبَاعُ",78,"ع",1,0]]}