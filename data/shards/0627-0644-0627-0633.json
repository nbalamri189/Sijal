َلاَ سَقِّنِي مِنْهَا دِرَاكاً وَغَنَّنِي","عَلَى نَغَمَاتِ الْمِزْهَرِ الْمُتَرَنِّمِ",1,"م",1,0],["إِلاَّ سُخَاماً قَادِحاً","فِي الدِّينِ وَاللَّهُ الْمُسَلِّمُ",2,"م",1,0],["أَلا سَقِّياني فَالظَلامُ قَدِ انجَلى","وَأَبدَت تَباشيرُ الصَباحِ عَمودَها",3,"ه",2,1],["الأُسْرَةُ الأُمَّةُ الصَّغِيرَةُ إِنْ","تَنْهَضْ فَكِلْتَاهُمَا عَلَى قَدَمِ",4,"م",1,0],["الأسْمَرُ الحَالِي بِأَسْمَحِ مَا جَلاَ","لِلْعَيْنِ مِنْ شَمْسِ البِلاَدِ أدِيمُ",5,"م",1,0],["أَلا ساءَ ما تُبلي سَليطٌ إِذا رَبَت","جَواشِنُها وَاِزدادَ عَرضاً ظُهورُها",6,"ر",3,0],["أَلا سَبيلٌ إِلى مالٍ يُعارِضُني","كَما يُعارِضُ ماءُ الأَبطَحِ الجاري",7,"ي",1,1],["الأَسَدُ الباسِلُ وَالعارِضُ ال","هاطِلُ عِندَ الزَمَنِ الماحِلِ",8,"ل",1,0],["ألاسرائيل ….. تعلو ….. راية","في حمى المهد وظل الحرم !؟",9,"م",1,0],["الإست دارُ خراجٍ إن هي اجتُبِيتْ","خَرْجاً ولا دخل يأتيها فقد عطِبَتْ",10,"ت",1,0],["الأسدَ المستعدَّ منذ دَرَى","أن الزُّبَى للأسود محتَفره",11,"ر",2,0],["أَلا سائِلِ الجَحّافَ هَل هُوَ ثائِرٌ","بِقَتلى أُصيبَت مِن سُلَيمٍ وَعامِرِ",12,"ر",1,1],["الاسم عين وتلاقيها","قدح وخمره وساقى",13,"ق",2,0],["الأُسدُ تَزأَرُ في الحَديدِ وَلَن تَرى","في السِجنِ ضِرغاماً بَكى اِستِخذاءَ",14,"ا",2,0],["الأُسى واجِبٌ عَلى الحُرِّ إِمّا","نِيَّةً حُرَّةً وَإِمّا رِياءَ",15,"ا",2,0],["أَلا سَلَتَ اللَهُ اِبنَ سَلتى كَما نَعى","رَبيعاً تَجَلّى غَيمُهُ حينَ أَقلَعا",16,"ع",2,1],["ألا سَقِّني الصَّهباءَ صِرْفاً فإنَّني","لِمَنْ لامَ فيها ما حَييتُ مُخالِفُ",17,"ف",1,1],["ألا سَقِّياني من سلافَةِ خَمرةٍ","يجانبُها المَحمودُ والأبلَهُ الغَمْرُ",18,"ر",1,0],["إِلّا سَفاهاً وَإِنَّني كَلِفٌ","أَحسَبُ غَيِّي مِن حُبِّها رَشَدا",19,"د",2,0],["أَلا ساجِل دُموعي ياغَمامُ","وَطارِحني بِشَجوِكَ ياحَمامُ",20,"م",1,1],["أَلا سَرَتِ القَبولُ وَلَو نَسيما","وَجاذَبَني الشَبابُ وَلَو قَسيما",21,"م",2,1],["الأُسدُ رابِضَةٌ عَلى أَسوارِها","وَالبَأسُ يَهدِرُ وَالرَدى يَتَوَثَّبُ",22,"ب",1,0],["الأسرةُ اجتمعتْ في الدّارِ واحدةً","حُيّيتِ من أسرةٍ بُوركتِ من دَارِ",23,"ر",1,0],["أَلا سَبيلٌ إِلى وافٍ أُواصِلُهُ","فَقَد تَجَنَّبَ وَدّي كُلَّ غَدّارِ",24,"ر",1,0],["ألا سائِلُوا عنهُ البَتْولَ فتُخبَرُوا","أكانَتْ لهُ أُمّاً وكان لها ابنَم",25,"م",1,0],["إلّا سليمان إنّهُ رجلٌ","يحلُّ بيني وبينه القُبَلُ",26,"ل",1,0],["إِلّا سُلَيمانُ إِذ قالَ الإِلَهُ لَهُ","قُم في البَرِيَّةِ فَاِحدُدها عَنِ الفَنَدِ",27,"د",1,0],["أَلا سَفينَةَ أَو عِبراً أَمُدُّ لَهُ","كَفّي فَأَنجُوَ مِن شَرٍّ لَها غَمَرا",28,"ر",2,0],["إِلّا سَجِيّاتِ ما القُلوبِ","وَكَم يَصيرَنَّ شانِئاً حَبيبُ",29,"ب",1,0],["إلا سؤالاً","عندي وقصدي اكتناه",30,"ا",2,0],["ألا سَلهُ ماذا بعد سبعين حِجةً","أأنجز من وعدٍ أفكَّ قيودي",31,"د",2,0],["أَلأُسْرَتانِ كمَا توَدُّهُمَا العُلَى","وَالنَّبَعانِ مِنَ النَّجَادِ الأَشْرَفِ",32,"ف",1,1],["ألا سيفٌ من الإيمانِ","يبري السيف مسنونا",33,"ن",2,0],["أَلا سَقَى اللهُ أرضَ القيروان حَياً","كأنَّه عَبَراتِي المُستهلّاتُ",34,"ت",1,0],["الأسرائيل تعلو راية","فيحمى المهد وضل الهرم",35,"م",1,0],["إلاَّ سَجِيَّاتُ ما القُلُو","بُ وكمْ يُصَيِّرْنَ شائنًا حَبِيبُ",36,"ب",1,0],["ألا ساعٍ ولو بخيال طيفٍ","يبشّر أنَّ عصَ الظلم بادا",37,"د",2,0],["ألا سلوة تشفي الفؤاد من الجوى","وتبرئه إني من الوجد موجع",38,"ع",1,0],["أَلا سائِل هَوازِنَ هَل أَتاها","بِما فَعَلَت بِيَ الجَعراءُ وَحدي",39,"ي",1,1],["الأَسَدُّ الأَشَدُّ إِن كانَ سِلمٌ","أَو وَغىً وَالأَلَدُّ عِندَ الجِدالِ",40,"ل",1,0],["ألا سمرٌ منكم بذا الليل عندنا","فألفاظكم أشهى إليّ من القطر",41,"ر",1,0],["الأسْدَ لم تكُ ارحياء من سطاً","والبحر من غيض يكاد يغيضُ",42,"ض",1,0],["ألا سائل النعمان إن كنت سائلا","وحي كلاب هل فتكت بخالد",43,"د",1,1],["ألا سُقيتْ أَطلالُ ليلى وإنْ عَفَتْ","مَغاني غَوانيها وولّى زَمانُها",44,"ن",3,1],["أَلا سائِلِ الرُّكبانَ هَل طَلَّ لَعلَعٌ","كَما كانَ مَطلولَ الأَصائِل سَجسَجا",45,"ج",2,1],["الأسد تؤسرُ والنعاج طليقةٌ","والصقر يهوي والغراب يطيرُ",46,"ر",1,0],["إِلّا سَوابِحَ كَالعِقبانِ مُقرَبَةً","في دارَةٍ حَولَها الأَخطارُ وَالعَكَرُ",47,"ر",1,0],["ألا سيف أجرّدهُ وأمضى","لأدفع عنك عادية الذئاب",48,"ب",1,0],["أَلإستِقلالُ يَنمو بِالتَآخي","وَيَضمر بِالشقاقِ وَيستدقُّ",49,"ق",1,0],["الأَسودُ الحالِكُ في لَونِهِ","إِذا مَشى أَمامَها يَفخَرُ",50,"ر",1,0],["ألاَ سَقِّني بالمَلا الصَّحْصَحِ","ونجمُ دجى الليل لم يَجْنَحِ",51,"ح",1,1],["ألا سَقِّياني قهوةً ذهبيَّة","وقد أَلبْسَ الآفاقَ جُنْحَ الدجى دَعَجْ",52,"ج",1,1],["أَلاَ سَتَرْتَ عِرْضَنَا","أَرَبِّ رَبَّ الْجُودِ",53,"د",1,0],["أَلاَ سَمِعْتُمْ قَوْلَنَا وَنَظَرْتُمُ","فِي شَأْنِ أَيْتَامٍ سُلاَلَةِ هَالِكِ",54,"ك",1,0],["إلَّا سَمِعتَ وَأَنتَ أكرَمُ مَن مَشَى","مِن مُنشِدٍ يَرجو جَزَاءَ المُنشِدِ",55,"د",1,0],["أَلا سِرُّ الهِدَايَةِ فيهِ بادٍ","لسَبَّاقِ العِنَايَةِ في البَدِيِّ",56,"ي",1,0],["الأسى والسهد والدم","ع عَلَى الوامقِ ألبُ",57,"ب",1,0],["الأَسى في مقلتيهِ قَدْ مَحا كلَّ ضياءِ","جاعلٌ في مسمعيه كلَّ صوتٍ كالبكاءِ",58,"ا",2,0],["الأساطين عنده كالصعا","ليك ونجم السما كصخر الفلاة",59,"ه",1,0],["الاِسمُ لِلوَصفِ غَدا باطِناً","وَهوَ لِمَعنى كَونِهِ ظاهِرُ",60,"ر",1,1],["إلاّ سديدَ الحضرة النَّدْبَ الذي","يُبدِي فعالَ الماجدِ ابنِ الماجد",61,"د",1,0],["أَلا سُقِيَت تِلكَ المَعالِمُ دَعوَةً","عَنَتني فَإِنّي بَعضُ تِلكَ المَعالِمِ",62,"م",1,0],["إلا سِهَامُكِ مُنْذ ُاسْتَوْطَنتْ جَسَدي","حتى أثارتْ جُنُوْنًا صَارَ مَوْهِبتي",63,"ت",2,0],["ألا سروا بمريم مذ حبتكم","حياةً ما لمشرقها مغارب",64,"ب",1,0],["أَلا ساءَ ذا عاراً عَلى الدينِ ظاهِراً","يُشيرُ إِلَيهِ الأَجنَبِيُّ المُحارِبُ",65,"ب",1,0],["ألا سُقِيَتْ منازلُ آل سلمى","بذي سَلمَ ورامة والغميم",66,"م",1,0],["الأسعد قوما ان نسبَت","أمرا الافاق له العظمى",67,"م",2,0],["الأسائل الفرسان عن فتكه وسل","صوارمه يخبرك عضبٌ وضامر",68,"ر",1,0],["أَلا ساعَةٌ يَمْحو بِها الدَّهْرُ ذَنْبِهُ","فَقَدْ طالَ ما أَشْكُو وَما أَتَبَرَّمُ",69,"م",1,1],["إلاّ سؤالَ الباخلين فإنه","غُمَّى عليَّ سبيلُها مغمومُ",70,"م",1,0],["ألا سَلْ قريشاً ولُمْ منهُمُ","من استوجبَ اللومَ أو فنِّدِ",71,"د",1,0],["إلاّ سَمِعنا سَلاماً مِنكَ تُرسِلُهُ","عَبْرَ البُحورِ ، وَتَرجيعاً لَهُ طَرِبا !",72,"ب",2,0],["الأُسْدُ ترهَبُنا في كلِّ نازِلَةٍ","تَرى لها في قُوى الميدانِ إطْراقَا",73,"ق",2,0],["ألا سَقِّني يا صاحِ خمراًفإنّني","بما أنزلَ الرحمنُ في الخمرِ عالمُ",74,"م",1,1],["ألاَ سُبَّةً للجاهلين وضِلَّةً","لِسَعيهُمُ يرج