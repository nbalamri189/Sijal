{"poems":[[53,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[77,"أفل الألى كانوا نجو","https://www.aldiwan.net/poem36114.html","مجزوء الكامل"],[71,"ألا سقياني فالظلام قد انجلى","https://www.aldiwan.net/poem3842.html","الطويل"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[11,"ألا سبيل إلى مال يعارضني","https://www.aldiwan.net/poem252.html",""],[47,"أي اصطبار ليس بالزائل","https://www.aldiwan.net/poem25210.html","السريع"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8687.html","البسيط"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[29,"ألا سائل الجحاف هل هو ثائر","https://www.aldiwan.net/poem6101.html","الطويل"],[85,"اللى يحب الجمال","https://www.aldiwan.net/poem6807.html","عموديه"],[85,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[28,"ألا سلت الله ابن سلتى كما نعى","https://www.aldiwan.net/poem5280.html","الطويل"],[61,"ألا سقني الصهباء صرفا فإنني","https://www.aldiwan.net/poem51540.html","الطويل"],[61,"خليلي إن الغيث أوله قطر","https://www.aldiwan.net/poem51606.html","الطويل"],[31,"يا صاح لا تلحني وقل سددا","https://www.aldiwan.net/poem42564.html","المنسرح"],[74,"ألا ساجل دموعي ياغمام","https://www.aldiwan.net/poem13249.html","الوافر"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[105,"ولقد عجبت من الغواة وقولهم","https://www.aldiwan.net/poem43117.html","الكامل"],[105,"هي الأواصر أدناها الدم الجاري","https://www.aldiwan.net/poem44225.html","البسيط"],[52,"سقيا لدار بنهر الكرخ من دار","https://www.aldiwan.net/poem26978.html","البسيط"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"إني امرؤ أبغض النعاج وقد","https://www.aldiwan.net/poem66552.html","المنسرح"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85842","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55028","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[95,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=659",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[90,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""]],"verses":[["أَلا سَلوَةٌ تَنهى الدُموعَ فَتَنتَهي","أَلا مَورِدٌ يَروي الغَليلَ فَيُنقَعُ",0,"ع",1,0],["أَلاَ سَقِّنِي مِنْهَا دِرَاكاً وَغَنَّنِي","عَلَى نَغَمَاتِ الْمِزْهَرِ الْمُتَرَنِّمِ",1,"م",1,0],["إِلاَّ سُخَاماً قَادِحاً","فِي الدِّينِ وَاللَّهُ الْمُسَلِّمُ",2,"م",1,0],["أَلا سَقِّياني فَالظَلامُ قَدِ انجَلى","وَأَبدَت تَباشيرُ الصَباحِ عَمودَها",3,"ه",2,1],["الأُسْرَةُ الأُمَّةُ الصَّغِيرَةُ إِنْ","تَنْهَضْ فَكِلْتَاهُمَا عَلَى قَدَمِ",4,"م",1,0],["الأسْمَرُ الحَالِي بِأَسْمَحِ مَا جَلاَ","لِلْعَيْنِ مِنْ شَمْسِ البِلاَدِ أدِيمُ",5,"م",1,0],["أَلا ساءَ ما تُبلي سَليطٌ إِذا رَبَت","جَواشِنُها وَاِزدادَ عَرضاً ظُهورُها",6,"ر",3,0],["أَلا سَبيلٌ إِلى مالٍ يُعارِضُني","كَما يُعارِضُ ماءُ الأَبطَحِ الجاري",7,"ي",1,1],["الأَسَدُ الباسِلُ وَالعارِضُ ال","هاطِلُ عِندَ الزَمَنِ الماحِلِ",8,"ل",1,0],["ألاسرائيل ….. تعلو ….. راية","في حمى المهد وظل الحرم !؟",9,"م",1,0],["الإست دارُ خراجٍ إن هي اجتُبِيتْ","خَرْجاً ولا دخل يأتيها فقد عطِبَتْ",10,"ت",1,0],["الأسدَ المستعدَّ منذ دَرَى","أن الزُّبَى للأسود محتَفره",11,"ر",2,0],["أَلا سائِلِ الجَحّافَ هَل هُوَ ثائِرٌ","بِقَتلى أُصيبَت مِن سُلَيمٍ وَعامِرِ",12,"ر",1,1],["الاسم عين وتلاقيها","قدح وخمره وساقى",13,"ق",2,0],["الأُسدُ تَزأَرُ في الحَديدِ وَلَن تَرى","في السِجنِ ضِرغاماً بَكى اِستِخذاءَ",14,"ا",2,0],["الأُسى واجِبٌ عَلى الحُرِّ إِمّا","نِيَّةً حُرَّةً وَإِمّا رِياءَ",15,"ا",2,0],["أَلا سَلَتَ اللَهُ اِبنَ سَلتى كَما نَعى","رَبيعاً تَجَلّى غَيمُهُ حينَ أَقلَعا",16,"ع",2,1],["ألا سَقِّني الصَّهباءَ صِرْفاً فإنَّني","لِمَنْ لامَ فيها ما حَييتُ مُخالِفُ",17,"ف",1,1],["ألا سَقِّياني من سلافَةِ خَمرةٍ","يجانبُها المَحمودُ والأبلَهُ الغَمْرُ",18,"ر",1,0],["إِلّا سَفاهاً وَإِنَّني كَلِفٌ","أَحسَبُ غَيِّي مِن حُبِّها رَشَدا",19,"د",2,0],["أَلا ساجِل دُموعي ياغَمامُ","وَطارِحني بِشَجوِكَ ياحَمامُ",20,"م",1,1],["أَلا سَرَتِ القَبولُ وَلَو نَسيما","وَجاذَبَني الشَبابُ وَلَو قَسيما",21,"م",2,1],["الأُسدُ رابِضَةٌ عَلى أَسوارِها","وَالبَأسُ يَهدِرُ وَالرَدى يَتَوَثَّبُ",22,"ب",1,0],["الأسرةُ اجتمعتْ في الدّارِ واحدةً","حُيّيتِ من أسرةٍ بُوركتِ من دَارِ",23,"ر",1,0],["أَلا سَبيلٌ إِلى وافٍ أُواصِلُهُ","فَقَد تَجَنَّبَ وَدّي كُلَّ غَدّارِ",24,"ر",1,0],["ألا سائِلُوا عنهُ البَتْولَ فتُخبَرُوا","أكانَتْ لهُ أُمّاً وكان لها ابنَم",25,"م",1,0],["إلّا سليمان إنّهُ رجلٌ","يحلُّ بيني وبينه القُبَلُ",26,"ل",1,0],["إِلّا سُلَيمانُ إِذ قالَ الإِلَهُ لَهُ","قُم في البَرِيَّةِ فَاِحدُدها عَنِ الفَنَدِ",27,"د",1,0],["أَلا سَفينَةَ أَو عِبراً أَمُدُّ لَهُ","كَفّي فَأَنجُوَ مِن شَرٍّ لَها غَمَرا",28,"ر",2,0],["إِلّا سَجِيّاتِ ما القُلوبِ","وَكَم يَصيرَنَّ شانِئاً حَبيبُ",29,"ب",1,0],["إلا سؤالاً","عندي وقصدي اكتناه",30,"ا",2,0],["ألا سَلهُ ماذا بعد سبعين حِجةً","أأنجز من وعدٍ أفكَّ قيودي",31,"ي",1,0],["أَلأُسْرَتانِ كمَا توَدُّهُمَا العُلَى","وَالنَّبَعانِ مِنَ النَّجَادِ الأَشْرَفِ",32,"ف",1,1],["ألا سيفٌ من الإيمانِ","يبري السيف مسنونا",33,"ن",2,0],["أَلا سَقَى اللهُ أرضَ القيروان حَياً","كأنَّه عَبَراتِي المُستهلّاتُ",34,"ت",1,0],["الأسرائيل تعلو راية","فيحمى المهد وضل الهرم",35,"م",1,0],["إلاَّ سَجِيَّاتُ ما القُلُو","بُ وكمْ يُصَيِّرْنَ شائنًا حَبِيبُ",36,"ب",1,0],["ألا ساعٍ ولو بخيال طيفٍ","يبشّر أنَّ عصَ الظلم بادا",37,"د",2,0]]}