gate.com/ViewPoem.aspx?id=187103",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5616,"شيخوخة","https://www.poetsgate.com/ViewPoem.aspx?id=203235",""],[5626,"ردّي إليّ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=189696",""],[5652,"شيخ فلس","https://www.poetsgate.com/ViewPoem.aspx?id=179839",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5720,"المتْرفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205536",""],[5809,"زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=205403",""],[5813,"كان الغرام احيان يطري وتنسين","https://www.poetsgate.com/ViewPoem.aspx?id=176825",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6031,"إنِّي لأَعْجَبُ من هَوَايَ وجَعلِكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46309",""],[6185,"أحلى مهاة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86942&r=&rc=2",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""],[6237,"أمامك دنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77858&r=&rc=0",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""]],"verses":[["وَكانَ كَفَحلِ البَيتِ يَطمَحُ رَأسَه","فَأَلقى عَلى حُكمِ الرَدى بِجِرانِ",0,"ن",1,0],["وَكَأَنَّ كَفَّ الجَوِّ مِن طَرَبٍ","نَثَرَت عَلَيها أَنجُمَ الحَمَلِ",1,"ل",1,0],["وَكَانَ كُلُّ اْبتِسَامٍ","مِنْهَا عَطَاءً ثَمِينَا",2,"ن",2,0],["وَكانَ كِتابٌ فيهِمُ وَنُبُوَّةٌ","وَكانوا بِإِصطَخرَ المُلوكَ وَتُستَرا",3,"ر",2,0],["وكان كالأروَقِ الأَكَسُّ من ال","نَّجدَةِ والكَربُ بَعدَهُ الكَرَبُ",4,"ب",1,0],["وكان كالأورق الاكس من النجدة","والكرب بعده الكرب",5,"ب",1,0],["وكأنكَ الدجَّالُ من","عورٍ وإعوارٍ هناكا",6,"ك",2,0],["وكان كرامي الليلِ يَرْمي ولا يرى","فلما أضاء الشيبُ شَخْصِي رآنيا",7,"ي",2,0],["وَكانَ كَالغَيثِ إِذا ما هَمى","أَصابَ في الأَرضِ الحَصى وَالنَبات",8,"ت",1,0],["وَكانَ كَاليَنبوعِ يَرتادُهُ","ذو الشِيَمِ الحُسنى وَذو السَيِّئات",8,"ت",1,0],["وكان كحدِّ السيف غَربُ لسانهِ","مَضاءً ففل الموت من ذلك الغرب",9,"ب",1,0],["وكأن كلتا صفحتيه من السنا","ومن التلبس بالشموس نهار",10,"ر",1,0],["وكأَنَّ كلَّ ذُؤابةٍ من شاهِقٍ","كنُ المجرَّةِ أَو جدارُ سِماكِ",11,"ك",1,0],["وَكَأَنَّ كُلَّ ذُؤابَةٍ مِن شاهِقٍ","رُكنُ المَجرَّةِ أَو جِدارُ سِماكِ",12,"ك",1,0],["وَكَأَنَّكَ العَبّاسُ نُبلَ خَليقَةٍ","وَعُلُوَّ هَمٍّ في بَني العَبّاسِ",13,"س",1,0],["وَكَأَنَّ كُلَّ عَجيبَةٍ مَوصولَةٌ","بِتَقَسُّمِ اللَحَظاتِ في أَقسامِهِ",14,"م",2,0],["وكأن كاس مدامها","لما ارتدت بحبابها",15,"ب",3,0],["وكانَ كالثَّمَرِ استقصَيْتُ غايَته","خُبْراً فما يبدي إلا أطايبُه",16,"ب",2,0],["وكَأَنَّ كَليمَ اللَّه بَدا","منه في الأفْقِ بياضُ يَدِ",17,"د",1,0],["وكأنّ كلّ ذُبابَةٍ غرقَتْ به","رَفَعَتْ مكانَ الأثْرِ منهُ جَنَاحا",18,"ح",2,0],["وَكَأَنَّ كافوراً وَمِسكاً خالِصاً","عَبِقا بِها بِالجَيبِ وَالأَردانِ",19,"ن",1,0],["وَكَأَنَّ كَلكَلَها إِذا وَخَدَت","فُتلُ المَرافِقِ عَن رَحى طَحنِ",20,"ن",1,0],["وكَأنَّكُمْ في فَضْلِكُمْ رَكَعاتُها","مَخْتُومَةً بِتَحِيَّةٍ وَسَلامِ",21,"م",1,0],["وَكانَ كَالعِجلِ غُرَّ الجاهِلونَ بِهِ","وَكُنتَ موسى هَدى القَومَ الأُلى جَهِلوا",22,"ل",3,0],["وَكانَ كَالجَسَدِ المُلقى فَجِئتَ كَما","جاءَ سُلَيمانَ يَتلو قَولَكَ العَمَلُ",22,"ل",1,0],["وَكانَ كَرَيحانِ العَروسِ بَقاؤُهُ","ذَوى بَعدَ إِشراقِ الغُصونِ وَطيبِ",23,"ب",1,0],["وكأنَّ كفَّ مُديرِها ومُديرِهِ","فَلكٌ يدورُ بشمسهِ وهلالهِ",24,"ه",1,0],["وكأنَّ كلَّ سحابةٍ أُفقها","شَبَحُ الخطيئةِ فوق عِرْضٍ دامي",25,"م",2,0],["وكانَ كليثِ الغابِ يَحْمي عَرِينَهُ","وتَرْضَى بِهِ أَشْبالُهُ وحَلائِلُهْ",26,"ل",2,0],["وكان كذاتِ البَوِّ تَضْرِبُ عِنْدَهُ","سِباعاً وقد أَلْقَيْنَهُ في الجراجِرِ",27,"ر",1,0],["وكَانَ كَفِيّاً بِمَنْظُومِهِ","وَمَنْثُورِهِ لِفُحولِ الأَدَبْ",28,"ب",1,0],["وَكَانَ كَمَا يَهْوَى الثِّقَاتُ وَدَادُهُ","وَلَيْسَ بِنَمَّامٍ وَلَيْسَ بِفَضَّاحِ",29,"ح",1,0],["وكان كشمعةٍ .. أعطت .. وأعطت","إلى أن ضمّه قدر الشموعِ",30,"ع",1,0],["وكأنَّ كلَّ مدرَّعٍ","من فوقها عبدُ الكريمِ",31,"م",1,0],["وكأنّ كلّ سحابة في أفقها","شبح الخطيئة فوق عرض دامي",32,"م",2,0],["وكَانَ كأنَّهُ عَدلٌ لَديكُم","فألفَيتُم لِجَرحَتِهِ عُدُولا",33,"ل",2,0],["وَكأَنَّ كافورَ الدُّموعِ وَقَدْ جَرى","بِخلوقِهِ مِنْها عَلَى الخَدِّ",34,"د",1,1],["وكان كنت ممن يطيع الهوى","ويعرف ما الحب لولاكم",35,"م",1,0],["وكان كمن شكا ضربات ضرس","فداواه الطبيب من الطحال",36,"ل",1,0],["وكان كتابي بالدموع مخبّرا","بشدّة ما ألقاه من لوعة الوجد",37,"د",1,0],["وكأنّ كل الفاضِلي","نَ لديَّ أجمعَهم حُضُور",38,"ر",1,0],["وكأن كل الأنبيان لسره","تاجٌ وأحمد درة للتاج",39,"ج",1,0],["وَكَأَنَّ كَفَّكَ ديمَةٌ مِدرارَةٌ","وَضِياءُ وَجهِكَ بَرقُها المُتَأَلِّقُ",40,"ق",1,0],["وكأن كلي في الثنا","عليك مولانا لسان",41,"ن",1,0],["وكأنَّ كفّاً في الظَّلامِ خَفيّةً","جاءت على جُدرانِ قلبكَ تكتُب",42,"ب",1,0],["وكأنّ كافوراً ومِسكاً لَيْلُها","ونهارُها ممّا يَروق وَيُعْجِبُ",43,"ب",1,0],["وَكأَنَّ كُلَّ حَبابَةٍ","تَرنو إليَّ بِعَينِها",44,"ن",3,0],["وَكان كَأَنَّهُ قَمَر مُنيرُ","فَلمّا لَم يَكُن أَسف عَلَيهِ",45,"ه",1,0],["وكان كالمُنتضي للحَرْبِ صارِمَه","فإذْ تقَضَّتْ رأى إغْمادَ ماضيه",46,"ي",2,0],["وكأنّ كُلَّ شَقيقةٍ مكْحولةٍ","شَرِقَتْ مَحاجِرُها بأحمرَ قان",47,"ن",1,0],["وكأنَّك الوِلدانُ طُفتَ به","وكأنَّه بكَ جَنَّةٌ عَدنُ",48,"ن",1,0],["وَكانَ كَقائِدٍ جيش الضَلالِ","عاين جَبريلُ في صَفِّهِ",49,"ف",2,0],["وَكانَ كَمِثلِ العَنبَرِ الجونِ لبثِّهِ","فَبانَ وَأَبقى في يدي عبق العِطرِ",50,"ر",1,0],["وَكَأَنَّ كَفَّكَ وَهْيَ غَيْثٌ هاطِلٌ","لَمَسَتْ حَوَافِي جانِبَيْهِ فَنَوَّرا",51,"ر",2,0],["وكأنّ كلّ أراكة من دوحه","قدّ عليه غلالة خضراء",52,"ا",2,0],["وكان كتوم السر قبل وداعهغا","فذاع مع التوديع مع من أذاعه",53,"ع",2,0],["وكأن كل الأرض أضحت عليةً","فعمت وسال بقرطها أوشالها",54,"ل",3,0],["وكأن كل سحابةٍ وقفت بها","ثكلاء أورثها الحنين فصالها",54,"ل",3,0],["وكأنّ كفّك لم تَبِنْ في ظهرها","قُبَلُ الملوكِ وتشهدُ الآثارُ",55,"ر",1,0],["وكأن كل غدير ماء رايقٍ","لبسوهُ وهو مضافُ التجعيدِ",56,"د",1,0],["وكأن كل شهاب رجم ثاقب","سهم أصاب وربه لم ينبض",57,"ض",1,0],["وكان كمهبط للوعي فاضت","عليّ به غوادق كالجهام",58,"م",1,0],["وكأنكم بظهور راية ملكه","وظنونكم يخبطن في عشواء",59,"ا",2,0],["وكأنك عزمك قال حين تقدمت","بك همة لم ترض أن تتأخرا",60,"ر",2,0],["وكانَ كالثَّغَامَهْ","مُذْ لَمْ يَجِدْ عَلامَهْ",61,"ه",1,0],["وَكانَ كَحَيَّةٍ رُقيَت فَصَمَّت","عَلى الصادي برُقيَتِهِ المُعيدِ",62,"د",1,0],["وكانَ كَهْفَ العُفاةِ اللائذينَ بهِ","تُثنَى يدُ الدَّهرِ إذ تَمتَدُّ منهُ يَدُ",63,"د",1,0],["وكان كل الناس في العبارة","يستوجب القيام بالإمارة",64,"ه",1,0],["وكان كيسان على ما خبروا","قد صحب المختار فيما ذكروا",64,"ر",3,0],["وكانَ كالمثلوبِ لو","لاَه وكالْمثلُوم",65,"م",1,0],["وَكانَ كِتابُ العَينِ قَد غابَ جُملَةً","عَنِ العَينِ لَو أَنَّ الخَليلَ مُعاصِرُه",66,"ر",2,0],["وَكأنَّ كَفَّكَ تَحمِلُ القَدَحَ الَّذي","طَلَبت طَهارَتُه طِلاً وخَلُوقا",67,"ق",2,0],["وكان كهارونَ بن عمرانَ عندَهُ","من المصطفى موسى النجيبِ المكلُّمِ",68,"م",1,0],["وَكانَ كَالدُرّ في الأَصداف مُختَفِياً","فَلاحَ كَالبَدر بِالأَنوار مُشتَمِلا",69,"ل",2,0],["وكان كأن البدر تحت لوائه","اذا راح في جيش وراحت عصائبه",70,"ب",2,0],["وكأن كل مشاهد مما رأى","ظفرت يداه بمطلب ومراد",71,"د",1,0],["وَكانَ كُلَّما يَزور الزاهِدا","يُلفيهِ في تَمليقِه مُجتهِدا",72,"د",2,0],["وَكانَ كُلّ مِنهُما لوَحدِه","يَأكُل مِن يَمينه وَكَدِّه",73,"ه",1,0],["وَكَانَ كُلّ عَزَائِي في مُغَادَرَتي","لأرضهِ أنني مَا قلتُ وَاندَمي",74,"م",2,0],["وكان كفانا للمكارم ناظماً","فأصبح عقد المكرمات مبددا",75,"د",2,0],["وكان كقاب أو أدنى اقترابا","على غيظ المغاشي والمعادي",76,"د",2,0],["وكان كالقاب بل وأدنى","ممن له خص بالأيادي",77,"د",2,0],["وكأنّ كفَّ مديرِها","من لونيَ القاني معَصْفَرْ",78,"ر",1,0],["وكان كتوما لسرّ الهوى","ولكن جرى دمعه فافتضح",79,"ح",1,1],["وكان كفى بي يا عظيم معظما","إذا تاه عقلي في مجاهل حيرتي",80,"ي",1,0],["وكأَنَّ كلّ الناس منطق واحدٍ","يشدو ليُهن الفخر مولدُ فرده",81,"د",2,0],["وكَأَنَّ كشحَيها إذا لَفَّت بِها","ريحُ الشتاءِ مروطها كشحاها",82,"ا",3,0],["وكأن كاليبو تغارُ لأنها","ملكُ الجمالِ إلهةُ الأغصانِ",83,"ن",1,0],["وكان كلم بعضاً أو يعمهم","كلامه إن يكن أوما إلى الجمل",84,"ل",1,0],["وكأنكم بنجومه ورجومه","تهوى اليكم من سماء غبار",85,"ر",1,0],["وكأنك استعبدت من عبدوا فلم","يأبق آلهٌ عن نطاق رضاكا",86,"ك",2,0],["وكان كمالي فيه بالصورة التي","خُصصت بها فانظره في باطن الردا",87,"د",2,0],["وكان كوني لأنَّ عيني","عينَ شهودي بلا مزيدِ",88,"د",1,0],["وكان كداوود فسل هيثميكم","أهل بعد هذا في امامته نكر",89,"ر",1,0],["وَكانَ كميت الغَيٍّ مُرْخ عَنانه","فَأَصبَح في يمناك وَهوَ اِبن ملجم",90,"م",1,0],["وكان كنصف المبطلين عديدهم","فإن قعدوا مع ذاك باؤا بسخطة",91,"ه",1,0],["وكان كما عَلِمنا منه شهماً","قويَّ الجأش مِقداماً جليدا",92,"د",2,0],["وَكان كيوم الحشر يوم وفاتهِ","شَهِدتُ به من حول مَدفنهِ الهولا",93,"ل",2,0],["وكانَ كأَنَّهُ في كُلِّ وَقتٍ","يُراقبُ قولَ حَيَّ على الرَحيلِ",94,"ل",1,0],["وكان كل قبلها محتقرا","وظن نفسه إذاً معتبرا",95,"ر",2,0],["وكان كما تهْوَى المكارمُ قد بدَتْ","مخائِلُ من قيْسٍ عليهِ ومن سعْدِ",96,"د",1,0],["وكان كما تبْغي الخلافةُ قد غدَتْ","على وجهِه سيمَا من الأبِ والجَدِّ",96,"د",1,0],["وَكَأَنَك البَدر المُنير وَحَولَهُ","زَهر الدراري وَالسَفين سَماءُ",97,"ا",2,0],["وَكَأنّ كَأسَك والمدامَ وَمَن سَقى","شَمسٌ وَدارتُها وَنجمُ الفَرقد",98,"د",1,0],["وَكَأَنكم خفتم عليه حَرارةً","مِن نار قَلبي أَن يؤمَّ فِنائي",99,"ا",2,0],["وكأن كل الطيبات يردها","فيه إلى شر الأمور مدبّر",100,"ر",1,0],["وكأنك المرآة لاح خياله","فيها فكدر ذاك بعض صفاكا",101,"ك",2,0],["وكأنك الحسن بن سهلٍ مهدياً","بوران من منظومكَ الموضونِ",102,"ن",1,0],["وكانَ كثيرٌ منهمُ يُرسلُونَ في","حديثِهِم أي يقطعُونَ فيوهِمُ",103,"م",1,0],["وكان كثير لي يقولون ذاك هو","بعربٍ من الأسما وبعض معجما",104,"م",2,0],["وكان كل ذا على إفادة","نلنا به الحسنى مع الزيادة",105,"ه",1,0],["وَكانَ كَهفاً مَنيعَ المُستَجيرِ بِهِ","غوثٌ وَغيثٌ لَهُ الحاجاتُ مَسئولُ",106,"ل",1,0],["وكان كتابُ الفضلِ باسمي مُعنوناً","فحاولَ حَظي مَحوَهُ من سطورِهِ",107,"ر",2,0],["وَكانَ كلُّ كتابٍ عِنْدَ مَوْرِدِهِ",