{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[73,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[95,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[29,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[53,"أقسمت أن أخا نفاكا","https://www.aldiwan.net/poem65775.html","مجزوء الكامل"],[53,"كفى بسراج الشيب في الرأس هاديا","https://www.aldiwan.net/poem66770.html","الطويل"],[93,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[87,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[87,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[87,"شيعت أحلامي بقلب باك","https://www.aldiwan.net/poem62958.html","الكامل"],[47,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[47,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[63,"قامت وغصن البانة المياس","https://www.aldiwan.net/poem51386.html","مجزوء الكامل"],[63,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[82,"ومهند عجن الحديد لقينه","https://www.aldiwan.net/poem31516.html","الكامل"],[33,"ألمم بجور في الصفاح حسان","https://www.aldiwan.net/poem41303.html","الكامل"],[54,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"لله ما تصنع الأجياد والمقل","https://www.aldiwan.net/poem65573.html","البسيط"],[52,"أجارتنا لا تجزعي وأنيبي","https://www.aldiwan.net/poem64831.html","الطويل"],[78,"بل رب مذهبة المزاج ومذهب","https://www.aldiwan.net/poem39005.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72218","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54604","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199492","الوافر"],[108,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[98,"من وحي الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=17474",""],[136,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[159,"وكأن كافور الدموع وقد جرى","https://www.aldiwan.net/poem55727.html","الكامل"],[164,"إذا اومض البرق من أرضها","https://www.aldiwan.net/poem58689.html","المتقارب"],[190,"أحق الناس بالصفع الجلال","https://www.aldiwan.net/poem43353.html","الوافر"],[190,"كتبت إليه بالدموع على الخد","https://www.aldiwan.net/poem43935.html","الطويل"],[233,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[235,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[239,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[265,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[274,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[279,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[301,"يا قهوة قشرية","https://www.aldiwan.net/poem32926.html","مجزوء الكامل"],[357,"وأغيد كنت أعشقه قديما","https://www.aldiwan.net/poem40186.html","الوافر"],[368,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[368,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[375,"ما السجن يوم حللته سجن","https://www.aldiwan.net/poem57000.html","أحذ الكامل"],[410,"أيا من نعاه لسان القريض","https://www.aldiwan.net/poem50146.html","المتقارب"],[410,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[436,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[441,"الحسن حيث المقلة الكحلاء","https://www.aldiwan.net/poem2578.html","الكامل"],[445,"أودع من لا أستطيع وداعه","https://www.aldiwan.net/poem14325.html","الطويل"],[445,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[467,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[467,"يا صاحبي قد لبس الدجى","https://www.aldiwan.net/poem3259.html","عموديه"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[518,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[518,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[532,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[543,"دع البخلاء إذا شحوا وضنوا","https://www.aldiwan.net/poem56854.html","الكامل"],[565,"يا أيها القبر فيك الناس قد رقدوا","https://www.aldiwan.net/poem52822.html","البسيط"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["وَكانَ كَفَحلِ البَيتِ يَطمَحُ رَأسَه","فَأَلقى عَلى حُكمِ الرَدى بِجِرانِ",0,"ن",1,0],["وَكَأَنَّ كَفَّ الجَوِّ مِن طَرَبٍ","نَثَرَت عَلَيها أَنجُمَ الحَمَلِ",1,"ل",1,0],["وَكَانَ كُلُّ اْبتِسَامٍ","مِنْهَا عَطَاءً ثَمِينَا",2,"ن",2,0],["وَكانَ كِتابٌ فيهِمُ وَنُبُوَّةٌ","وَكانوا بِإِصطَخرَ المُلوكَ وَتُستَرا",3,"ر",2,0],["وكان كالأروَقِ الأَكَسُّ من ال","نَّجدَةِ والكَربُ بَعدَهُ الكَرَبُ",4,"ب",1,0],["وكان كالأورق الاكس من النجدة","والكرب بعده الكرب",5,"ب",1,0],["وكأنكَ الدجَّالُ من","عورٍ وإعوارٍ هناكا",6,"ك",2,0],["وكان كرامي الليلِ يَرْمي ولا يرى","فلما أضاء الشيبُ شَخْصِي رآنيا",7,"ي",2,0],["وَكانَ كَالغَيثِ إِذا ما هَمى","أَصابَ في الأَرضِ الحَصى وَالنَبات",8,"ت",1,0],["وَكانَ كَاليَنبوعِ يَرتادُهُ","ذو الشِيَمِ الحُسنى وَذو السَيِّئات",8,"ت",1,0],["وكان كحدِّ السيف غَربُ لسانهِ","مَضاءً ففل الموت من ذلك الغرب",9,"ب",1,0],["وكأن كلتا صفحتيه من السنا","ومن التلبس بالشموس نهار",10,"ر",1,0],["وكأَنَّ كلَّ ذُؤابةٍ من شاهِقٍ","كنُ المجرَّةِ أَو جدارُ سِماكِ",11,"ك",1,0],["وَكَأَنَّ كُلَّ ذُؤابَةٍ مِن شاهِقٍ","رُكنُ المَجرَّةِ أَو جِدارُ سِماكِ",12,"ك",1,0],["وَكَأَنَّكَ العَبّاسُ نُبلَ خَليقَةٍ","وَعُلُوَّ هَمٍّ في بَني العَبّاسِ",13,"س",1,0],["وَكَأَنَّ كُلَّ عَجيبَةٍ مَوصولَةٌ","بِتَقَسُّمِ اللَحَظاتِ في أَقسامِهِ",14,"م",2,0],["وكأن كاس مدامها","لما ارتدت بحبابها",15,"ب",3,0],["وكانَ كالثَّمَرِ استقصَيْتُ غايَته","خُبْراً فما يبدي إلا أطايبُه",16,"ب",2,0],["وكَأَنَّ كَليمَ اللَّه بَدا","منه في الأفْقِ بياضُ يَدِ",17,"د",1,0],["وكأنّ كلّ ذُبابَةٍ غرقَتْ به","رَفَعَتْ مكانَ الأثْرِ منهُ جَنَاحا",18,"ح",2,0],["وَكَأَنَّ كافوراً وَمِسكاً خالِصاً","عَبِقا بِها بِالجَيبِ وَالأَردانِ",19,"ن",1,0],["وَكَأَنَّ كَلكَلَها إِذا وَخَدَت","فُتلُ المَرافِقِ عَن رَحى طَحنِ",20,"ن",1,0],["وكَأنَّكُمْ في فَضْلِكُمْ رَكَعاتُها","مَخْتُومَةً بِتَحِيَّةٍ وَسَلامِ",21,"م",1,0],["وَكانَ كَالعِجلِ غُرَّ الجاهِلونَ بِهِ","وَكُنتَ موسى هَدى القَومَ الأُلى جَهِلوا",22,"ل",3,0],["وَكانَ كَالجَسَدِ المُلقى فَجِئتَ كَما","جاءَ سُلَيمانَ يَتلو قَولَكَ العَمَلُ",22,"ل",1,0],["وَكانَ كَرَيحانِ العَروسِ بَقاؤُهُ","ذَوى بَعدَ إِشراقِ الغُصونِ وَطيبِ",23,"ب",1,0],["وكأنَّ كفَّ مُديرِها ومُديرِهِ","فَلكٌ يدورُ بشمسهِ وهلالهِ",24,"ه",1,0],["وكأنَّ كلَّ سحابةٍ أُفقها","شَبَحُ الخطيئةِ فوق عِرْضٍ دامي",25,"م",2,0],["وكانَ كليثِ الغابِ يَحْمي عَرِينَهُ","وتَرْضَى بِهِ أَشْبالُهُ وحَلائِلُهْ",26,"ل",2,0],["وكان كذاتِ البَوِّ تَضْرِبُ عِنْدَهُ","سِباعاً وقد أَلْقَيْنَهُ في الجراجِرِ",27,"ر",1,0],["وكَانَ كَفِيّاً بِمَنْظُومِهِ","وَمَنْثُورِهِ لِفُحولِ الأَدَبْ",28,"ب",1,0],["وَكَانَ كَمَا يَهْوَى الثِّقَاتُ وَدَادُهُ","وَلَيْسَ بِنَمَّامٍ وَلَيْسَ بِفَضَّاحِ",29,"ح",1,0],["وكان كشمعةٍ .. أعطت .. وأعطت","إلى أن ضمّه قدر الشموعِ",30,"ع",1,0],["وكأنَّ كلَّ مدرَّعٍ","من فوقها عبدُ الكريمِ",31,"م",1,0],["وكأنّ كلّ سحابة في أفقها","شبح الخطيئة فوق عرض دامي",32,"م",2,0],["وكَانَ كأنَّهُ عَدلٌ لَديكُم","فألفَيتُم لِجَرحَتِهِ عُدُولا",33,"ل",2,0],["وَكأَنَّ كافورَ الدُّموعِ وَقَدْ جَرى","بِخلوقِهِ مِنْها عَلَى الخَدِّ",34,"د",1,1],["وكان كنت ممن يطيع الهوى","ويعرف ما الحب لولاكم",35,"م",1,0],["وكان كمن شكا ضربات ضرس","فداواه الطبيب من الطحال",36,"ل",1,0],["وكان كتابي بالدموع مخبّرا","بشدّة ما ألقاه من لوعة الوجد",37,"د",1,0],["وكأنّ كل الفاضِلي","نَ لديَّ أجمعَهم حُضُور",38,"ر",1,0],["وكأن كل الأنبيان لسره","تاجٌ وأحمد درة للتاج",39,"ج",1,0],["وَكَأَنَّ كَفَّكَ ديمَةٌ مِدرارَةٌ","وَضِياءُ وَجهِكَ بَرقُها المُتَأَلِّقُ",40,"ق",1,0],["وكأن كلي في الثنا","عليك مولانا لسان",41,"ن",1,0],["وكأنَّ كفّاً في الظَّلامِ خَفيّةً","جاءت على جُدرانِ قلبكَ تكتُب",42,"ب",1,0],["وكأنّ كافوراً ومِسكاً لَيْلُها","ونهارُها ممّا يَروق وَيُعْجِبُ",43,"ب",1,0],["وَكأَنَّ كُلَّ حَبابَةٍ","تَرنو إليَّ بِعَينِها",44,"ن",3,0],["وَكان كَأَنَّهُ قَمَر مُنيرُ","فَلمّا لَم يَكُن أَسف عَلَيهِ",45,"ه",1,0],["وكان كالمُنتضي للحَرْبِ صارِمَه","فإذْ تقَضَّتْ رأى إغْمادَ ماضيه",46,"ي",2,0],["وكأنّ كُلَّ شَقيقةٍ مكْحولةٍ","شَرِقَتْ مَحاجِرُها بأحمرَ قان",47,"ن",1,0],["وكأنَّك الوِلدانُ طُفتَ به","وكأنَّه بكَ جَنَّةٌ عَدنُ",48,"ن",1,0],["وَكانَ كَقائِدٍ جيش الضَلالِ","عاين جَبريلُ في صَفِّهِ",49,"ف",2,0],["وَكانَ كَمِثلِ العَنبَرِ الجونِ لبثِّهِ","فَبانَ وَأَبقى في يدي عبق العِطرِ",50,"ر",1,0],["وَكَأَنَّ كَفَّكَ وَهْيَ غَيْثٌ هاطِلٌ","لَمَسَتْ حَوَافِي جانِبَيْهِ فَنَوَّرا",51,"ر",2,0],["وكأنّ كلّ أراكة من دوحه","قدّ عليه غلالة خضراء",52,"ا",2,0],["وكان كتوم السر قبل وداعهغا","فذاع مع التوديع مع من أذاعه",53,"ع",2,0],["وكأن كل الأرض أضحت عليةً","فعمت وسال بقرطها أوشالها",54,"ل",3,0],["وكأن كل سحابةٍ وقفت بها","ثكلاء أورثها الحنين فصالها",54,"ل",3,0],["وكأنّ كفّك لم تَبِنْ في ظهرها","قُبَلُ الملوكِ وتشهدُ الآثارُ",55,"ر",1,0],["وكأن كل غدير ماء رايقٍ","لبسوهُ وهو مضافُ التجعيدِ",56,"د",1,0],["وكأن كل شهاب رجم ثاقب","سهم أصاب وربه لم ينبض",57,"ض",1,0],["وكان كمهبط للوعي فاضت","عليّ به غوادق كالجهام",58,"م",1,0],["وكأنكم بظهور راية ملكه","وظنونكم يخبطن في عشواء",59,"ا",2,0],["وكأنك عزمك قال حين تقدمت","بك همة لم ترض أن تتأخرا",60,"ر",2,0],["وكانَ كالثَّغَامَهْ","مُذْ لَمْ يَجِدْ عَلامَهْ",61,"ه",1,0],["وَكانَ كَحَيَّةٍ رُقيَت فَصَمَّت","عَلى الصادي برُقيَتِهِ المُعيدِ",62,"د",1,0],["وكانَ كَهْفَ العُفاةِ اللائذينَ بهِ","تُثنَى يدُ الدَّهرِ إذ تَمتَدُّ منهُ يَدُ",63,"د",1,0],["وكان كل الناس في العبارة","يستوجب القيام بالإمارة",64,"ه",1,0],["وكان كيسان على ما خبروا","قد صحب المختار فيما ذكروا",64,"ر",3,0],["وكانَ كالمثلوبِ لو","لاَه وكالْمثلُوم",65,"م",1,0]]}