{"poems":[[29,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[29,"ويلكم يا قصبات الجوفان","https://www.aldiwan.net/poem4444.html","الرجز"],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[228,"قص لي سيرة الذين أحبوا","https://www.aldiwan.net/poem39720.html","الخفيف"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[367,"حب جديد","https://www.aldiwan.net/poem11635.html","عموديه"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54038","الكامل"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116673","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45863","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[5121,"صَبَاحُ الْهَمْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=214145",""]],"verses":[["وَالحَنتَفَينِ يَومَ شَلِّ الأَظعان","وَما اِبنُ حِناءَةَ الرَتِّ الوان",0,"ن",1,0],["وَالحَنتَفَينِ عِندَ شَلِّ الأَظعان","أَو كَأَبي حَزرَةَ سَمِّ الفُرسان",1,"ن",1,0],["و\" الحنظلُّي \" بحِلْفِهِ ووعُودهِ","ما زالَ كاذبُ وعدِه ممطولا",2,"ل",2,0],["وَالحَنانُ الَّذي يُخَدِّرُ عَينَي","كِ أَفي الأَرضِ لِلسَّما مِنهُ أَدنى",3,"ن",2,0],["وَالحَنينُ يَجذُبُهُم","وَالمَشوقُ يَنجَذِب",4,"ب",1,0],["وَالحُنَفاءُ تابَعوني إِذ رَأَو","ني في اِتِّباعِ رِسلِها مُجتَهِدا",5,"د",2,0],["والحنينْ","عمِلَتْ بهِ الأيامُ",6,"م",1,0],["والحنشُ محكومٌ عليه بأنّه","لسواه مبتلعٌ إذا ما يلمعُ",7,"ع",1,0],["وَألحَنُ النَّاسِ كُلِّ النَّاسِ قَاطِبَةً","وكان يُؤلعُ بِالتَّشدِيقِ فِي الخُطَبِ",8,"ب",1,0],["والحنبليّ العبد للرحمن","في قبّة رفيعة الاركان",9,"ن",1,0],["والحن فديتك لِلضَرورة مَرة","وَلَئن أَسَأت بِها عَدَدتك محسنا",10,"ن",2,0],["وَالحَنان المُشرق الوَضّ","اح مِن فَيض حَياتك",11,"ك",1,0],["وَالْحَنَايَا يُغَرِّدُ الطَّيْرُ فِيهَا","بِصَفِيرٍ مَعَ التَّثَاؤُبِ يُمْسِي",12,"س",2,0]]}