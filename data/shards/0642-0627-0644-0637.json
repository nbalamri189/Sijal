{"poems":[[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[228,"أمن العدل خالق الأرواح","https://www.aldiwan.net/poem39713.html","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64879","الخفيف"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131069",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33368","الخفيف"],[5258,"قَالَ ثقلت إِذْ أتيت مرَارًا","https://www.poetsgate.com/ViewPoem.aspx?id=189566",""],[5376,"طار صقر في السما ثم وقعْ","https://www.poetsgate.com/ViewPoem.aspx?id=191734",""],[5573,"ايام الدراسه","https://www.poetsgate.com/ViewPoem.aspx?id=200337",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5732,"ونات الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=177861",""]],"verses":[["قال طَهورُ الدُّبرِ من داخلٍ","لمن بهِ مسٌّ من المَذْهَبِ",0,"ب",1,0],["قالَ طوبى لَه وَطوبى لِنَفسِه","ما أَلَذَّ الصَفاءَ في ماءِ كَأسِه",1,"ه",1,0],["قالَ طُوبَى لمُنْصِفٍ","عرفَ الحقَّ فاعترفْ",2,"ف",1,0],["قالَ طَردنا ذا رَسول الشاه","فَإِنَّهُ آتٍ بِلا اِشتِباهِ",3,"ه",1,0],["قال طيبي يا بهجة الغيد نفسا","لا تخافي وقوع شر المذنب",4,"ب",1,0],["قال طب نفساً فقد نالت المنى","ما على أهل الهوى من حرج",5,"ج",1,0],["قالَ طرفي للدَمعِ يسعفُ قلبي","أيها الدمع لم رقأتَ سريعا",6,"ع",2,0],["قَالَ طولت قلت لَا بل تطولت","وأبرمت قلت حَبل الوداد",7,"د",1,0],["قال طير بعدما منه دنى","وعلا منه أنين وارتفع",8,"ع",1,0],["قال طالب للمدرس عارف الدرس وحلوله","عارفه واعرف جوابه قبل ماعيني تنام",9,"م",1,0],["قال طبع في دمي من صغري","هل تُرى أنزفه أو يستقرّ",10,"ر",1,0],["قال طامع قلت لا لا لا حشا","بس ابي من فاك يالغالي صبوح",11,"ح",1,0]]}