","https://www.poetsgate.com/ViewPoem.aspx?id=179548",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[49,"إنّ السّلامَة َ أنْ نَرْضَى بمَا قُضِيَا،","https://www.poetsgate.com/ViewPoem.aspx?id=2742",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[67,"لاتظلموني وتظلموا الحسبه","https://www.poetsgate.com/ViewPoem.aspx?id=3145",""],[4,"معلقة لبيد بن ربيعة العامري","https://www.poetsgate.com/ViewPoem.aspx?id=30298",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[45,"رُدّي، على المُشتاقِ، بَعضَ رُقادِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31610",""],[45,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[45,"صُنْتُ نَفْسِي عَمّا يُدَنّس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=31225",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""],[18,"منْ مبلغٌ بكراً وَ آلَ أبيهمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26449&r=&rc=15",""]],"verses":[["مَن مُبلِغٌ لي أَبا إِسحَقَ مَألُكَةً","عَن حِنوِ قَلبٍ سَليمِ السِرِّ وَالعَلَنِ",0,"ن",1,0],["مِن مَعشَرٍ أَظهَروا الشَجاعَةَ في ال","بُخلِ وَعِندَ المَكارِمِ الجُبُنا",1,"ن",2,0],["مَن مَدَّ مِعصَمَهُ مُستَعصِماً بِيَدي","عَصَمتُهُ بِإِخاءٍ غَيرِ مُنجَذِمِ",2,"م",1,0],["مِن مَعشَرٍ ما فيهِمُ إِلّا فَتىً","أَو جائِدٍ أَو ذائِدٍ أَو حامِ",3,"م",1,0],["مِن مَعشَرٍ شَبّوا عَلى إِحنَتي","وَأوجِروا بُغضِيَ عِندَ الفِطام",4,"م",1,0],["مِن مَقبِسِ المَجدِ لَهُم ضِراما","جاءَ بِهِ يَضطَرِمُ اِضطِراما",5,"م",2,0],["مِن مَعشَرٍ تَخِذوا المَكارِمَ طُعمَةً","وَرَوُوا مِنَ الشَرَفِ الأَعَزِّ الأَقدَمِ",6,"م",1,0],["مَن ماتَ لَم يَلقَ مَن يَحيا يُلائِمُهُ","فَكُن بِكُلِّ مُصابٍ غَيرَ مُحتَفِلِ",7,"ل",1,0],["مِن مَعشَرٍ وَرَدوا المَنونَ وَمَعشَرٍ","سَلَبوا الحِجالَ وَأَلبَسوا الأَحجالا",8,"ل",2,0],["مِن مَعشَرٍ رَكِبوا العُلى","وَأَبَوا عَنِ الكَرَمِ النُزولا",9,"ل",2,0],["مِن مَقيلٍ بَينَ الضُلوعِ إِلى طو","لِ عَناءٍ وَفي التُرابِ مَقيلُ",10,"ل",1,0],["مِن مَعشَرٍ وَرَدوا العَلياءَ جُمعَتَها","وَسابَقوا عَجَلَ الجارينَ بِالمَهَلِ",11,"ل",1,0],["مِن مَعشَرٍ كانَت سُيوفُهُمُ","حَلياً لِمَن ضَرَبوا وَمَن عَطِلوا",12,"ل",3,0],["مِن مَعشَرٍ أَخَذوا الفُضلى فَما تَرَكوا","مِنها لِمَن يَطلُبُ العَلياءَ مُتَّرَكا",13,"ك",2,0],["مِن مَنظَرٍ حَسَنٍ وَمِن نَغَمٍ","نَدعوهُ قَيدَ العَينِ وَالسَمعِ",14,"ع",1,0],["مَن مُعيدٌ أَيّامَ سَلعٍ عَلى ما","كانَ مِنها وَأَينَ أَيّامُ سَلعِ",15,"ع",1,0],["مِن مُضمَرٍ يَخشى الهَوى لا يَنثَني","أَو صافِقٍ بِيَدِ الرِدى لا يَرجِعُ",16,"ع",1,0],["مَن مُعيدٌ أَيّامَ ذي الأَثلِ أَو ما","قَلَّ مِنها دَيناً عَليَّ وَقَرضا",17,"ض",2,0],["مِن مَعشَرٍ رَكِبَت أَوائِلُهُم","أولى العُلى وَجِيادُها شُمصُ",18,"ص",1,0],["مِن مَعشَرٍ مُطَيَّبِ الأَعياصِ","بَينَ لُبابِ المَجدِ وَالمُصاصِ",19,"ص",1,0],["مِن مَعشَرٍ رَكِبوا المَكارِمَ في","أَولى الزَمانِ مَصاعِباً شُمُسا",20,"س",2,0],["مِن مَعشَرٍ وَسَموا الزَمانَ مَناقِباً","تَبقى بَقاءَ الوَحيِ في الأَطراسِ",21,"س",1,0],["مَن مُؤَدٍّ إِلى عَلىٍّ أَلوكاً","أَبِجِدٍّ عَصيتَ لِلصَبرِ أَمرا",22,"ر",2,0],["مِن مَعشَرٍ غُلبِ الرِقابِ جَحاجَحٍ","غَلَبوا عَلى الأَقدارِ وَالأَخطارِ",23,"ر",1,0],["مَن مُبلِغٌ عَنّي القَبائِلَ أَنَّني","مُتَوَطِّنٌ عُنقَ العَلاءِ بِمَفخَرِ",24,"ر",1,0],["مِن مَعشَرٍ لَم يُخلَقوا","إِلّا لِنَفعٍ أَو ضَرَر",25,"ر",1,0],["مِن مُصعَبٍ لَو لَم يَقُدهُ إِلَهُهُ","بِقَضائِهِ ما كانَ بِالمُنقادِ",26,"د",1,0],["مِن مَرامِ بِعادُهُ لِتَدانٍ","وَمُرادٍ نُقصانُهُ لَاِزدِيادِ",27,"د",1,0],["مِن مَطايا الذِكرِ لا يَحسُرُها","أَبَداً وَعثُ بِلادٍ وَجَدَد",28,"د",1,0],["مَن مُعيدٌ لِيَ أَيّا","مي بِجَزعِ السَمُراتِ",29,"ت",1,1],["منْ مَعْشَرٍ يَحْمَدُ العافي لِقاحَهُمُ","إذا امْتُدِرَّتْ أفاويقُ الأحاليبِ",30,"ب",1,0],["منْ مَعْشَرٍ لهُمُ السّماحَةُ شيمَةٌ","والمَجْدُ تِرْبٌ والنّجومُ قَبيلُ",31,"ل",1,0],["مَنْ مُبْلِغٌ بَطْحاءَ مكّةَ أنّني","لمْ أرْعَ بالجَرْعاءِ رَوْضَ هُدونِ",32,"ن",1,0],["منْ مَعْشَرٍ شُمِّ الأنوفِ ذادَةٍ","بَيضِ الوجوهِ سادَةٍ أماثِلِ",33,"ل",1,0],["منْ مَعشَرٍ لا يُناجي الضّيمُ جارَهُمُ","نِضْوَ الهُمومِ غَضيضَ الطّرْفِ مُهْتَضَما",34,"م",2,0],["مِنْ مَعشَرٍ فرَعوا ذَوائِبَ سُؤْدَدٍ","أغصانُ دَوحَتِهِ الكَميُّ الباسِلُ",35,"ل",1,0],["مِن مَعْشَرٍ بيضِ الوُجوهِ توشّحوا","شِيَماً خُلِقْنَ منَ العُلا وحُلوما",36,"م",2,0],["منْ مَعْشَرٍ يُلْبِسونَ الجارَ فَضْلَهُمُ","ويُحْسِنونَ على اللأواءِ إسْعادا",37,"د",2,0],["مِن مُنادٍ وَمِن مُجيبٍ وَمِن تَص","هالِ خَيلٍ خِلالَ ذاكَ رُغاءُ",38,"ا",2,0],["مَن مِثلُ قَومي حينَ يَختَلِفُ القَن","وَإِذا تَزِلُّ قَوائِمُ الأَبطالِ",39,"ل",1,0],["مَنْ مَاتَ مِنْهُمْ مَاتَ مِيتَةَ فِتْنَةٍ","أَوْ عَاشَ فَهْوَ مُفَسَّقٌ وَمُضَلَّلُ",40,"ل",1,0],["مَنْ مِثْلُ يُوسُفَ فِي الْمُلُوكِ إِذَا غَدَتْ","تُزْهَى بِفَضْلِ قَدِيمِهَا وَتَصُولُ",41,"ل",1,0],["منْ مَماليكٍ كالسِّباعِ ووُصْفا","نِ وغُزٍّ وديْلَمِ وتَتارِ",42,"ر",1,0],["مَنْ مُجيري مَنْ نَصيري في الهَوى","ضاعَ بيْنَ الغُنْجِ ثأري والحَوَرْ",43,"ر",1,0],["مَن مُنْصِفٌ بيْنَ آمالي وغايَتِها","فقدْ تجاوزْنَ في مَطْلي على الأمَدِ",44,"د",1,0],["مَنْ مُنْصِفي منْ جِيرَةٍ لمْ يَرْحَموا","دَمْعاً على عَرَصاتِهِمْ أجْرَيْتُهُ",45,"ت",2,0],["مَن مُبلِغٌ كِسرى إِذا ما جاءَهُ","عَنّي مَآلِكَ مُخمِشاتٍ شُرَّدا",46,"د",2,0],["مِن مَعشَرٍ فيهِم قُرومٌ سادَةٌ","وَلِيوثُ غابٍ حينَ تَضطَرِمُ الوَغى",47,"ا",1,0],["مِن مَراميها بِأَنكى مَوقِعاً","لا وَلا أَقوى مِراساً وَعُراما",48,"م",2,0],["مَن مِنهُمُ كَفّاهُ يَو","مَ البَذلِ مِن كَفَّيكَ أَندى",49,"د",2,0],["مِن مِنهُمُ نامَت رَعِي","يَتُهُ وَقامَ اللَيلَ سُهدا",49,"د",2,0],["مَن مِنهُمُ ساماكَ أَو","سامى جَلالَكَ أَو تَحَدّى",49,"د",2,0],["مَن مِنهُمُ أَوفى حِجاً","وَحَصافَةً وَأَبَرُّ وَعدا",49,"د",2,0],["مِن مَعشَرٍ شَرَعوا السَماحَ وَأَرشَدوا","فيهِ العُفاةَ إِلى طَريقٍ مهَيعِ",50,"ع",1,0],["مَن مُبلِغُ المُلبِسينا بِاِنتِزاحِهِمُ","حُزناً مَعَ الدَهرِ لا يَبلى وَيُبلينا",51,"ن",2,0],["مَن مُبلِغٌ عَنِيَ البَدرَ الَّذي كَمُلا","في مَطلَعِ الحُسنَ وَالغُصنَ الَّذي اِعتَدَلا",52,"ل",2,1],["مَن مُبلِغٌ عَنّي البِلادَ إِذا نَبَت","أَن لَستُ لِلنَفسِ الأَلوفِ بِباخِعِ",53,"ع",1,0],["مَن مِثلُهُ لا مِثلَ يُلفى لَهُ","إِن فَسَدَت حالٌ فَعَزَّ الصَلاح",54,"ح",1,0],["مَن مُبلِغٌ عَنّي الأَحِبَّةَ إِذ أَبَت","ذِكراهُمُ أَن يَطمَئِنَّ مِهادُ",55,"د",1,0],["مَنْ مِثْلُهُ وَلِيَ الأُمُورَ فَسَاسَهَا","بِالحَزْمِ وَالإِقْدَامِ وَالعِرْفَانِ",56,"ن",1,0],["مِنْ مُنْتَهَى النِّيلِ فِي أَيَّامِهِ اتَّسَعَتْ","إِلَى أَعَالِيهِ فِي نُوبٍ وَ سُودَانِ",57,"ن",1,0],["مَنْ مُبْلِغُ السُّلْوَانِ مَقْرُوحَ الحَشَى","سُدَّتْ عَلَيْهِ مَسَالِكُ السُّلْوَانِ",58,"ن",1,0],["مَنْ مُبْلغُ النَّائِي أَلُوكَ حَزِينَةٍ","لِنَوَاهُ وَالأَخَوَانِ يَنْتَحِرَانِ",59,"ن",1,0],["مِنْ مَهْبِطٍ لِلْوَحْيِ أَدْ","نَى مِنْ ثَرَاهُ النَّيِّرَانِ",60,"ن",1,0],["مَنْ مِثْلُهُ فِي كُلِّ نَازِلَةٍ لَهُ","تَقْوَى صَبْورٍ وَامْتِثَالِ حَكِيمِ",61,"م",1,0],["مِن مُرْصِدٍ وَقْفاً أُعِدَّ بِهِ حِمًى","وَمَبَاءةٌ لِلْمُعْتَفِي وَالمُحْتَمِي",62,"م",2,0],["مَنْ مِثْلُ مَكْرَمَ فِي تَفَوُّقِهِ إِذَا","رَجَحَ الكَلامَ لَدَى العُقُولِ كَلامُ",63,"م",1,0],["مَنْ مِثْلُ وَاصِفَ وَالبَيَانُ بَيَانُهُ","إِنْ لُوحِظَ الإِبْدَاعُ وَالإِحْكَامُ",63,"م",1,0],["مِنْ مَرْفَأِ الثَّغْرِ الأَغَرِّ إِلَى حِمَى","مِصْرَ الأبَرِّ تَحِيَّةٌ وَسَلامُ",64,"م",1,0],["مُنَمَّقَةٍ رَنَّانَةٍ عَرَبِيَّةٍ","لَهَا كَاتِبٌ مِنْهَا وَتَالٍ مُرَنِّمُ",65,"م",1,0],["مَنْ مُبْلِغٌ عَلْيَاءَ إِبرَا","هيمَ تَهْنِئَةَ الخَلِيلِ",66,"ل",1,1],["مُنَمَّقَةٌ بَينَ أَثنائِها","مَخازٍ تَحُطُّ فَما تَرحَلُ",67,"ل",1,0],["مَن مُبلِغٌ عَنّي إِمامُ الهُدى","قافِيَةً لِلعِرضِ هَتّاكَه",68,"ك",2,1],["مِن مَعشَرٍ إِن تَدعُهُم لِمُلِمَّةٍ","وَصَلوا الحَياةَ إِلى العُلا بِحَديدِ",69,"د",1,1],["من مصر هيّ","ومن النيل",70,"ل",1,0],["من مبلغ الأنصار منه بشارة","غرُّ البشائر بعدها تسترسلُ",71,"ل",1,0],["من مبلغ الأذواء من يمن وهُمْ","قد تُوِّجوا وتملّكوا وتَقَيَّلوا",71,"ل",3,0],["من مبلغٌ قحطان آساد الشرى","ما غابُها إلا الوشيح الذُبَّلُ",71,"ل",1,0],["من مثل طلعتهم نشاطاً","في فعائله الحريزه",72,"ز",2,0],["من مبسم الغازي إلى الفاروق","بَسَمات مَومُوق إلى موموق",73,"ق",1,1],["من مجلس للشعب ين","ظر بالتأمّل في مآبه",74,"ب",2,0],["مَن مُبلغ