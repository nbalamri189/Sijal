ِي آيَةً","رُسُلاً تَقُصُّ عَلَيْهِمُ التّبْيَانَا",258,"ن",2,1],["مِنْ مَعْشَرٍ لا يغدُرُونَ بِجَارِهِمْ","كَانُوا بمكَّةَ يَرْتَعُونَ زَمَانَا",258,"ن",2,0],["من مبلغ مصر عنا ما نكابده","إن العروبة فيما بيننا ذمم",259,"م",1,0],["من معصم النبع الدفي","ق لمعطف الغصن الرطيب",260,"ب",1,0],["من ملاكٌ في بردَتَيها مقيم","جسدٌ طاهرٌ وروحٌ كريم",261,"م",1,0],["من معيدٌ إليّ ذاك الزمانا","ومعيدٌ سلمى إليّ الآنا",262,"ا",1,0],["من مطلع الشمس حتى قابِ مغربها","عبدٌ كسا الشرقَ تعظيماً وتنويها",263,"ي",3,0],["مَن مُبلِغُ الشُعَراءِ عَنّي أَنَّ لي","قَولَ الفُحولِ وَنَجدَةَ الأَنجادِ",264,"د",1,0],["من مسرح محنط الفنون","مشاهد باهتة التلوين",265,"ن",1,0],["مَن مُجيري وَمُصرِخي","قَد هَوى كُلُّ أبلَخ",266,"خ",1,1],["مِن مَواتِ الأَرضِ أَنتَ فَأَنّى","لَكَ نُطقٌ في المَواتي لرَضِيِّ",267,"ي",1,0],["من مُسعِدي بِالبُكا عَلَيهِ","فَيَقضِيَ الكلَّ مِن ذِمامي",268,"م",2,0],["منْ منكُما وهب الأمانْ","لأخيه، أنتَ أم الزمانْ؟",269,"ن",1,1],["مِن ماءِ كَرمٍ قَد عُتِّقَت حِقَباً","في بَطنِ أَحوى الضَميرِ مُختَزَنِ",270,"ن",1,0],["من معين الفنّ أروي","ك ولم ينضب معيني",271,"ي",1,0],["مَنْ مُبْلِغُ العُرْبِ أَنَّ الضَّادَ قَدْ بَلَغتْ","بِقُرْبِ صَاحِبِ مِصْرٍ أَرْفَعَ الرُّتَبِ",272,"ب",1,0],["مَنْ مُجيرِي مِنْ حالِكات اللّيالي","نُوَبَ الدَّهْرِ مالكُن وماليِ",273,"ل",2,1],["مِنْ مِهَادِ النُّبْلِ السَّنيِّ أَضَاءتْ","فَعَلتْ كَوْكَباً وعَزَّت مُهُودا",274,"د",2,0],["مِن معجزاتك -يا زمانَ النسور-: أَنْ","نال الملوكُ جوائز العلماء",275,"ا",2,0],["مَنْ مسعدي إن أكن على سفر","ومن يفي لي بالوعد إن أعِد؟",276,"د",1,0],["منْ ماتَ ماتَ رجاءُ الناسِ منهُ فوَ","لّوْهُ الجَفَاءَ، وَمَن لا يُرْتجى جُفيَا",277,"ي",2,0],["من مقلتيك يفيض اللؤلؤ الرطب","يا قائم الليل ما للدمع ينسكب",278,"ب",1,1],["مِنْ مَلِيكٍ ما فَوْقَ رُتْبَتِه","على عظيم اتِّضاعِهِ رُتْبَه",279,"ب",2,0],["من معشر سنت لهم آباؤهم","ولكل قوم سنة وإمامها",280,"م",3,0],["من مُبلغُ الجاعلين اللهَو مركبَهُمْ","أنا ركبنا بحارَ الهمِّ طوفانا",281,"ن",2,0],["مَنْ مُبلِغُ المُشتفينَ أنَّا","صِرنا لمِا يَطمحُ الحسودُ ؟",282,"د",1,0],["مَنْ مُنْص