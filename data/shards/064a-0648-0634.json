{"poems":[[102,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[57,"أيا غزال الذهب","https://www.aldiwan.net/poem26521.html","مجزوء الرجز"],[21,"اقترب الوعد والقلوب إلى","https://www.aldiwan.net/poem36191.html","المنسرح"],[108,"يا ابن عيسى","https://www.poetsgate.com/ViewPoem.aspx?id=179381",""],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[482,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[574,"ما أَحسن الغيرة في حينها","https://www.aldiwan.net/poem51992.html","السريع"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203796","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82686","الرمل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34972","المنسرح"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67254","السريع"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115082","الرمل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128635","المتقارب"],[3487,"","https://poetry.dctabudhabi.ae/diwan/poem/111546","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131018",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136746",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[4927,"أنوار العدالة","https://www.poetsgate.com/ViewPoem.aspx?id=80804",""],[4968,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208077",""],[5284,"حكايةُ عاشقَين","https://www.poetsgate.com/ViewPoem.aspx?id=190603",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""]],"verses":[["يوشّي غناء الحقول","وأنشودة المصنع",0,"ع",1,0],["يوشِكُ أَن يَقتُلَني ال","حُبُّ وَلا يُشعَرُ بي",1,"ب",2,0],["يوشِكُ مَن فَرَّ مِن مَنيَتِهِ","في بَعضِ غِرّاتِهِ يواقِفُها",2,"ه",2,0],["يوشك الحقُّ -إذْ تدافع عنهُ-","أن يمُدَّ اليَدَيْنِ بالتصفيق",3,"ق",1,0],["يُوشِّحُ دارَ الملكِ صفّانِ منهمُ","كَما زرّت الحسناءُ أَزرارها رَبطا",4,"ط",2,0],["يوشَّعُ أقطارَ الخمائِل ماؤها","اِذا ما مضى سَجْلٌ تلا اِثْرَهُ سَجْلُ",5,"ل",1,0],["يوشك ان يغريها بالَّذي","يَخاف أَو ينصبها للعيون",6,"ن",1,0],["يوّشي بالكرامة ذكرياتي","ويأسو بابتسامته جروحي",7,"ح",2,0],["يوشك المُرسِل أَن","تَأتِيَ من بَعد الرَّسول",8,"ل",1,0],["يوشونَهُنَّ إِذا ما نابَهُم فَزَعٌ","تَحتَ السَنَوَّرَ بِالأَعقابِ وَالجِذَمِ",9,"م",1,0],["يوشِكُ مَن فَرَّ مِن مَنيَّته","في بَعضِ غرّاتِهِ يُوافِقُها",10,"ق",3,0],["يوشكُ في جمرة أنفاسه","يُحرق ما أعشبَ من شعبه",11,"ب",2,0],["يُوشِكُ المُرسِلُ أَن يَل","قاكَ مِن بَعدِ الرسُولِ",12,"ل",1,0],["يُوشحُ حكمتهُ من يشا","فسبحانَهُ من حكيمٍ عليم",13,"م",1,0],["يوشح ديباج البلاغة أحرفا","يكاد يرى روضاً يوشحه الزهر",14,"ر",1,0],["يوشح مما تنسج المزن حلة","توشى ببرق مثلما ترقم البردا",15,"د",2,0],["يوشك اليوم أن تهب جيادي","حاملاتٍ للأسد والأغوال",16,"ل",1,0],["يوشَك اليوم أن تَرى بعد خَفق","القَلب مني عليك خفقَ البنُود",17,"د",1,0],["يُوَشْوِشُهَا الشَّيْطَاْنُ خُبْثاً وَخِسَّةً","وَيُقْسِمُ أَنَّ السَّيْفَ لِلْخَرْقِ رَاْقِعُ",18,"ع",1,0],["يوشِّح ذكراكَ ياقوتُ شِعرٍ","سناهُ كنُور الرُّؤى في المَنام",19,"م",1,0],["يُوَشْوِشُهَا ، تُوَشْوِشُهُ فَأُصْغِي","وأُنْصِتُ في ذُهُولٍ وََارْتِيَاعِ ..",20,"ع",1,1],["يوشك السكران من نشوته","يشتري كسرى بسيف الأرطبون",21,"ن",1,0],["يُوشِكُ السِّرُّ أَنْ يُمَزِّقَ صَدرِي","وَ ضُلُوعِي يَشُجَّها الإِفصَاحُ",22,"ح",1,0]]}