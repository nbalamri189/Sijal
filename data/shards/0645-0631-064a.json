5328,"لغة الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=211991",""],[5335,"غطرسه","https://www.poetsgate.com/ViewPoem.aspx?id=35191",""],[5365,"عيونُها","https://www.poetsgate.com/ViewPoem.aspx?id=190816",""],[5387,"أين كنتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=46528",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[5461,"نعم شاعرك","https://www.poetsgate.com/ViewPoem.aspx?id=5032",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[5488,"يابارق من جدا الشرق سناي","https://www.poetsgate.com/ViewPoem.aspx?id=100728",""],[5525,"لا تقول","https://www.poetsgate.com/ViewPoem.aspx?id=7189",""],[5536,"وش سوى الغياب؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=22593",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5690,"مريمٌ زفت إلى اسكندرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=172284",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5867,"مَرِيضَة كرّ الطّرف مجدولة الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=189666",""],[5874,"طللية","https://www.poetsgate.com/ViewPoem.aspx?id=201851",""],[5874,"ذئبةُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202082",""],[5956,"توديع الابن","https://www.poetsgate.com/ViewPoem.aspx?id=192523",""],[5961,"مريد الحق","https://www.poetsgate.com/ViewPoem.aspx?id=199770",""],[5976,"أنشودة التيه","https://www.poetsgate.com/ViewPoem.aspx?id=30346",""],[6125,"لَهَاهُ العِزُّ والمرتعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210905",""],[6152,"أماني العمر","https://www.poetsgate.com/ViewPoem.aspx?id=204432",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[6259,"أسيلة خدٍّ دونهُ الأسلُ السمرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59375&r=&rc=23",""],[6302,"يُحيطونَ.. لكنْ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86233&r=&rc=31",""],[6302,"هنيئاً للشَّمالِ .. هُناك عيدُ!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86213&r=&rc=11",""],[572,"غَادِيَة ٌ والشّمسُ في طِرَادِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9256&r=&rc=113",""]],"verses":[["مَريرُ القُوى نالَ المَعالِيَ واثِباً","إِذا غَيرُهُ نالَ المَعالِيَ حابِيا",0,"ي",2,0],["مَريضِ المَشارِعِ مِمّا تُريقُ","عَلَيهِ الرِياحُ دُموعَ الغَمامِ",1,"م",1,0],["مَريرُ القُوى لا يَرأَمُ الضَيمُ أَنفَهُ","وَأَيدي العِدى إِلّا عَلَيهِ تَصولُ",2,"ل",1,0],["مَريضَةُ أرْجاءِ الجُفونِ وإنما","أصَحُّ عُيونِ الغانِياتِ عَليلُها",3,"ل",3,0],["مَريضٌ إِن أَتاهُ لَنا رَسولٌ","لِيُبلِغَ حاجَةً مُنِعَ الرَسولُ",4,"ل",1,1],["مَرينِيُّ النِّجارِ فَلا ادِّعاءً","تَقولُ إذا مدَحْتَ ولا اخْتِلاقا",5,"ق",2,0],["مَرْيَمُ يَا غَرْسَ خَيْرِ كَرْمٍ","مِنْ أُسْرَةٍ كُلُّهَا كِرَامُ",6,"م",1,1],["مَرَيتُم حَربَنا لَكُمُ فَدَرَّت","بِذي عَلَقٍ فَأَبطَأَتِ الغِرارا",7,"ر",2,0],["مُرِّيَّةٌ حَلَّت بِفَيدِ وَجاوَرَت","أَهلَ الحِجازِ فَأَينَ مِنكَ مَرامُها",8,"م",3,0],["مَريرٌ عَلى الأَعداءِ لَكِنَّ جارَهُ","إِلى خَصِبِ الأَكنافِ عَذبِ المَوارِدِ",9,"د",1,0],["مريح منتن أبداً","على جنباته لثقُ",10,"ق",1,0],["مريضاتُ الجفونِ لغير داءٍ","لمن لا بسْنَه الداءُ العُقامُ",11,"م",1,0],["مَرَّ يَوماً فَرَأى أَشيُخاً","جَلَسوا يَبكونَ عِندَ المَقبَرَه",12,"ر",2,0],["مُر يَنفَتِح بابُ اجَحيمِ فَإِنَّني","قَد كادَ يَجمُدُ لِلصَقيعِ لِساني",13,"ن",2,0],["مُرى عصىّ الكرى يغشى مجاملة","وسامحي في عناق الطيف أجفاني",14,"ن",2,0],["مُري عَصِيَّ الكَرى يَغشى مُجامَلَةً","وَسامِحي في عِناقِ الطَيفِ أَجفانِ",15,"ن",1,0],["مريضٌ بأرض الرَّيِّ أعياهُ داؤُهُ","وليس له إلا بِجَيَّ طبيبُ",16,"ب",1,1],["مُريبٌ في هَواكِ رَأَوا سَبيلاً","عَلَيهِ وَالسَبيلُ عَلى المُريبِ",17,"ب",1,0],["مَرَينا لَهُم بِالقَضبِ مِن قَمَعِ الذُرى","إِذا الشَولُ لَم تُرزِم لِدَرٍّ فِصالُها",18,"ل",3,0],["مَرَيتَ بِسَيفِكَ المَسلولِ فيهِم","مَواطِنَ كُلِّ مُبدِيَةِ الغُمومِ",19,"م",1,0],["مريض العين ليس يعاد لكن","أوان البرء يقصد للتهاني",20,"ن",2,1],["مرَّ يومي فارغاً منك ومن","أمل اللقيا فما أتعس يومي",21,"ي",1,0],["مرّ يومي كأمسه مسرحاً تعرض فيه الحياة والأحياء","آدم كالقديم قلباً وتفكيراً ولكن تبدل الأزياء",22,"ا",2,0],["مرّ يومي كأمسه وأتى لَيلٌ بهيج تزف فيه السماء","قد جلت فيه عرسها كل نجم",22,"م",1,0],["مَرَى مِن عُيونٍ سَاهِراتٍ مَدامِعاً","وكحّلَها بالنُّورِ والليلُ مظلمُ",23,"م",1,0],["مريدُ القضا بالقرى","لهُ حلبٌ قاعدَهْ",24,"ه",1,1],["مَريضَةُ أَثناءَ التَعَطُّفِ إِنَّها","تَخافُ عَلى الأَردافِ يَثلُمُها الخَصرُ",25,"ر",1,0],["مُرْ يا محمدُ وَاقْضِ مالَك عَائِبٌ","في كلِّ أمرٍ ترتضي وقضاءِ",26,"ا",2,0],["مَريضِ الخَوفِ تَخفُقُ رايَتاهُ","عَلى أَهلِ الضَغائِنِ وَالتُبولِ",27,"ل",1,0],["مَرَيْتَ سِجالاً من عِقابٍ ونائلٍ","كأنّكَ للأعمارِ والرّزقِ قاسم",28,"م",1,0],["مَريضِ جُفونِ المُقلَتَينِ مُزَنَّرٍ","لَهُ شَفَةٌ مِن مَصِّها مَصَّ سُكَّرا",29,"ر",2,0],["مرّي فكَم مثلكِ من حرّةٍ","رائعةٍ لم تكُ من مَطلبي",30,"ب",2,0],["مَريضَةُ ما بَينَ الجَوانِحَ بِالصِبا","وَفيها دَواءٌ لِلقُلوبِ وَداءُ",31,"ا",2,0],["مُريدي بَقائي طالَما لَقِيَ الفَتى","عَناءً بِطولِ العَيشِ وَاللَهُ يَعلَمُ",32,"م",1,1],["مَرى لَهُمُ المَرّانُ رِسلَ حَياتِهِم","فَأَعجِب بِرِسلٍ مِن مَوارٍ مَوارِنِ",33,"ن",1,0],["مَريَ العَسيفِ عِشارَهُ","حَتّى إِذا دَرَّت عُروقُه",34,"ق",2,0],["مريض من الآلام يشكو وحوله","أطباء موصوفون بالحذق والنصْفِ",35,"ف",1,1],["مريضاً من الآلام يشكو أَمرَّها","فَلا الموت أَنجاني ولا الصبر أنجدا",36,"د",2,0],["مريضُ الغريزةِ فتَّاكُها","حَبَتْهُ الطبيعةُ أمضَى سلاحْ",37,"ح",1,0],["مَرَّ يَومٌ وَبَعضُ يَومٍ عَلَينا","وَالمَنايا إِلى النُفوسِ تُشيرُ",38,"ر",1,0],["مُرَيَّشَةً بِالهُدبِ مِن كُلِّ ساهِرِ","مُنهَلَّةً أَطرافُها بِدُموعِ",39,"ع",1,0],["مري بكفيك على جبيني","وقبل أن أرقد حدثيني",40,"ن",2,0],["مريضة هي في الأجفان أم مرضت","قلوبكم أم نأى عنهن وجدان",41,"ن",1,0],["مَريعاً من الحُسن الطبيعيِّ لو سَعتْ","بنوه إلى إنعاشه كان أمرعا",42,"ع",2,0],["مريب في هواك، رأوا سبيلاً","عليه، والسيبل على المريب",43,"ب",1,0],["مر ينفتح باب الجحيم فإنّني","قد كاد يجمد للصقيع لساني",44,"ن",2,0],["مرّ يوما فرأى أشباحا","جلسوا يبكون عند المقبرة",45,"ر",2,0],["مريدٌ عنيد فَاحِشٌ مَاكِرٌ دوي","مناكره رانت على قلبه الدوي",46,"و",2,0],["مَرَى ابنُ فَسنجُسَ من خِلْفها","زُعافا وما كلُّ خِلْف لَبونا",47,"ن",2,0],["مَرى سَدادُكَ خِلفَ الرَأيِ مُجتَهِداً","حَتّى لَقَد قَلَّ خُلفٌ وَاِستَقَلَّ مِرا",48,"ر",2,0],["مَرِيضُ كَرِّ الطَّرْفِ مِنْ غَيْرِ مَرَضْ","كأَنَّما قَتْلي عَلَيْهِ مُفْتَرَضْ",49,"ض",1,1],["مَرَى الدَّمعَ مِن عَينَيكَ دارٌ مُحِيلَةٌ","بِفَيضِ الحَشا تَسفِى عَلَيها دَبُورُها",50,"ر",3,1],["مريض جُفونِ الطَّرْفِ من غيرِ علةٍ","فهنّ سقيماتٌ بغير سَقام",51,"م",1,0],["مريضُ جُفونِ الطَّرْفِ لولا جفونُه","لما كنتُ أدري السُّقْم كيف يكون",52,"ن",1,0],["مري علينا يا صبا نجدٍ","تشكو إليكِ مدامعي وجدي",53,"د",2,1],["مريض الطرفِ منخنِثِ السجايا","يكاد يذوب من ترفٍ ولِينِ",54,"ن",1,0],["مر يحمى بصارم اللحظ ثغراً","كلما شم نوره زاد نوره",55,"ر",2,0],["مريضات أجفان العيون فواتك","وأقتلها ما كن مرضى فواتكا",56,"ك",2,0],["مري به وتعلقي بردائه","ليكون فيك من الحبيب نسيم",57,"م",1,0],["مرّي وتَثنّي وابتسِمي","لأشمَّ شذاً وأرى قلقا",58,"ق",2,0],["مَريضَةُ الأَجفانِ فَتّانَةٌ","وَطَرفُها الوَسنانُ ما أَقتَلَه",59,"ل",2,0],["مُري الطَّيفَ أَن يَغشى فَإِن زارَ مَضجَعي","وَلَم أَكُ يَقظاناً بِهِ فَلَكِ العُذرُ",60,"ر",1,0],["مَرَيتِ الجفونَ وَهجتِ الشجون","فَحَسبُكِ أَلَّفتِ ماءً وَنارا",61,"ر",2,0],["مُريدُ الذَمّ مَذمومٌ بَخيلٌ","وَمُعطي المال مُنتَجَبٌ حَميدُ",62,"د",1,0],["مَريضانِ من حُزْنٍ وحُسْنٍ وثالثٌ","على النّأْيِ يَسْعَى بَيْنَنا بالرَّسائل",63,"ل",1,0],["مَريضِيَ بي إِن عُدتُهُ لِيَ عائِدٌ","وَعائِدُهُ خَوفاً عَلَيهِ مَريضُ",64,"ض",1,1],["مريمْ مدينةُ مولاها معظَّمَةٌ","في بِيعة اللَه من ساعٍ على القدمِ",65,"م",1,1],["مريمْ ملكتِ علينا فاضرعي أبداً","ثم اَبْدِلي حُزنَنا في فرحةٍ وس