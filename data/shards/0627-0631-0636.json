ه حين مضى","https://www.aldiwan.net/poem52549.html","البسيط"],[560,"تشكو الكنيسة فقد خوريها الذي","https://www.aldiwan.net/poem52608.html","الكامل"],[560,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[560,"سل ابنة القوم هل تدري بما صنعت","https://www.aldiwan.net/poem52879.html","البسيط"],[560,"إلى المغارب تسعى الشمس والقمر","https://www.aldiwan.net/poem52883.html","البسيط"],[560,"هجرت فبت بمقلة لم ترقد","https://www.aldiwan.net/poem52915.html","الكامل"],[573,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[573,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[584,"لا غرو إن هز عطفي نحوك الطرب","https://www.aldiwan.net/poem17413.html","البسيط"],[584,"أرض الأحبة من سفح ومن كثب","https://www.aldiwan.net/poem17436.html","البسيط"],[584,"قاسيت بك الغرام والوجد سنين","https://www.aldiwan.net/poem17825.html","الدوبيت"]],"verses":[["أَرضٌ حَصانٌ مِن مُلامَسَةِ الحَيا","وَالأَرضُ تَحمَدُ مِنهُ غَيرَ حَصانِ",0,"ن",1,0],["أَرضى وَأَغضَبُ في حَبابِكُمُ","وَرِقابُ وُدّي لا أُصَرِّفُها",1,"ف",3,0],["أَرضى البَطالَةَ أَن تَكونَ قَلائِدي","أَبَداً وَلَومَ اللائِمينَ شُنوفي",2,"ي",1,0],["أَرضٌ أَقولُ بِها لِسانِحَةِ المَها","أَنا إِن عَثَرنَ لَعاً وَقَلبي العاثِرُ",3,"ر",1,0],["أَرِضاً وَذُؤبانُ الخُطوبِ تَنوشُني","وَالعَزمُ ماضٍ وَالرِماحُ سَوالِبُ",4,"ب",1,0],["أَرضَ العُذَيبِ أَما تَنفَكُّ بارِقَةٌ","تَسمو بِطَرفي إِلى الرَيّانِ أَو حَضَنِ",5,"ن",1,1],["أَرَضِيتَ أَمْراً لا يَزالُّ بِهِ","في الذُّلِ عِرْضُ أَخِيكَ يُنْتَهَكُ",6,"ك",1,0],["أرضٌ تَجُرُّ بِها الخِلافَةُ ذَيْلَها","وبها الجِباهُ منَ المُلوكِ تُعَفَّرُ",7,"ر",1,0],["أَرضُ الشَرَبَّةِ كَم قَضَّيتُ مُبتَهِج","فيها مَعَ الغيدِ وَالأَترابِ مِن وَطَرِ",8,"ر",1,0],["أَرضُ الشَرَبَّةِ تُربُها كَالعَنبَرِ","وَنَسيمُها يَسري بِمِسكٍ أَذفَرِ",9,"ر",1,1],["إِرضَ بِنَفسي أَنتَ عَنّي فَقَد","قَتَلتَني بِالصَدِّ وَاللِعبِ",10,"ب",1,0],["أَرْضَيْتَ دِينَ اللهِ مَقْتَدِياً بِمَا","نَطَقَ الْكِتَابُ بِهِ وَسَنَّ رَسُولُهُ",11,"ل",2,0],["أرِضْوانُ لا توحِشْكَ فَتْكَةُ ظالِمٍ","فلا مُوْرِدٌ إلا سيَتْلوهُ مُصْدِرُ",12,"ر",1,1],["أَرضُ كولُمبَ أَيُّ نَبتَيكِ أَغلى","قيمَةً في المَلا وَأَبقى مَتاعا",13,"ع",2,0],["أَرضَيتَ رَبَّكَ إِذ جَعَلتَ طَريقَهُ","أَمناً وَفُزتَ بِنِعمَةِ الرِضوانِ",14,"ن",1,0],["أَرضى الإِلهَ بِفِعلِهِ وَدِفاعِهِ","عَن دينِهِ وَأَقَرَّ عَينَ المُرسَلِ",15,"ل",1,0],["أَرضٌ إِذا مَرَّت بِها ريحُ الصَبا","حَملَت عَلى الأَغصانِ مسكاً أَذفرا",16,"ر",2,0],["أَرْضَى بِأَنْ تُقْضَى مُنىً","لِلآخَرينَ وَإِنْ عَدَتْنِي",17,"ن",2,0],["أَرْضَى الإِلَهَ وَنَفْسَهُ وَمَضَى إِلَى","غَايَاتِ دُنْيَاهُ سَلِيمَ الدِّينِ",18,"ن",1,0],["أَرضُ التَبابِعِ وَالأَقيالِ مِن يَمَنٍ","أَهلِ الجِيادِ وَأَهلِ البَيضِ وَالزَرَدِ",19,"د",1,0],["أَرضاً مَعانا مِنَ الحَيِّ الِّذينَ هُمُ","أَهلُ الجِيادِ وَأَهلُ العَدو وَالعَدَدِ",20,"د",1,0],["أَرضَيتَنا وَخُلِقتَ نوراً عالِياً","بِالسَعدِ بَينَ أَهِلَّةٍ وَنُجومِ",21,"م",1,0],["أرضى بها الله والسلطان ذو قلم","بالخير أعيى ابن سهل أن يحابره",22,"ر",2,0],["أرضى لمن غابَ عنكَ غيبتهُ","فذاكَ ذنبٌ عقابه فيه",23,"ف",3,0],["أرض السناء والهناء والمرح","والأمن واليُمن ورايات الفرح",24,"ح",1,0],["أرْضَى بصورتهِ وصَدَّ فأغضَبَا","فغدا المحبُّ منعَّماً ومعذَّبا",25,"ب",2,1],["ارْضَ عَنِّي فلستُ أنكر أنِّي","لك عبد أذلُّ من كل عَبْدِ",26,"د",1,0],["أرضِ فيه الندى وزِدْه فإنّ تا","بع قولاً حسبي فتابعْ مزيدَكْ",27,"ك",1,0],["أرضيننا حسن قدٍّ زانه بشر","صاف وأسخطننا مطلاً وإخلافا",28,"ف",2,0],["أَرضعَ فيها الغيثُ شتّى ونظمْ","بكى على عابسها حتى ابتسمْ",29,"م",1,0],["أرض عمران تُزرَعُ العُصْيَانا","كلَّ حولٍ فتُخرِج الحُملانا",30,"ن",2,1],["أَرضَ آبائِنا عَلَيكِ سَلامٌ","وَسَقى اللَهُ أَنفُسَ الآباءِ",31,"ا",2,0],["أَرضٌ إِذا زارَها غَريبٌ","أَصبَحَ عَن أَرضِهِ غَريبا",32,"ب",2,0],["أَرضَ الجَزيرَةِ كَيفَ حا","لُكِ بَعدَ وَقعِ الزَمهَريرِ",33,"ر",1,0],["أَرضٌ خَلاءٌ وَجَوٌّ غَيرُ ذي أَلَقٍ","بَلى هُناكَ ضَبابٌ فَوقَ أَشواكِ",34,"ك",1,0],["أَرَضيتَ موسى وَالمَسيحَ وَأَحمَداً","وَالناسَ أَجمَعَ وَالإِلَهَ تَعالى",35,"ل",2,0],["أَرضُن سَماءٌ سِواها دونَها شَرَفاً","فَلا سَماءٌ وَلا أَرضٌ تُحاكيها",36,"ي",3,0],["إِرضَ عَنّي لَيسَ إِلّا","ذاكَ مَطلوبي وَقَصدي",37,"د",2,0],["أرضَعَتْهُ الشَّمسُ بالضَّوءِ","وغذَّاهُ القَمَرْ",38,"ر",1,0],["أرضاك أنا سكتنا عن مطالبنا","يا مالك الأمر ما أرضاك يؤذينا",39,"ن",2,0],["أَرضُ الأُبُوَّةِ وَالميلادِ طَيَّبَها","مَرُّ الصِبا في ذُيولٍ مِن تَصابينا",40,"ن",2,0],["أَرضٌ تَموجُ بِها المَناظِرُ جَمَّةٌ","وَعَوالِمٌ نِعمَ الكِتابُ لِمَن قَرا",41,"ر",2,0],["أَرضٌ تَرَعرَعَ لَم يَصحَب بِساحَتِها","إِلّا نَبِيّينَ قَد طابوا وَكُهّانا",42,"ن",2,0],["أَرَضيتُم أَن تُرى مِص","رُ مِنَ الفَنِّ خَرابا",43,"ب",2,0],["أَرضٌ لَها شَرَفٌ سِواها مِثلُها","لَو كانَ مِثلُكَ في سِواها يُوجَدُ",44,"د",1,0],["أَرَضيتَ وَهشُوَذانُ ما حَكَمَت","أَم تَستَزيدُ لِأُمِّكَ الهَبَلُ",45,"ل",1,0],["أرض لنا أنبت ذهبا","في رغوة يدعونها لهبا",46,"ب",2,1],["أرضٌ إِذا ولعَ النسيمُ بها","مَرِضَ الصَّبَا وتماثَلَ الترْبُ",47,"ب",1,0],["أَرضى الزَمانُ نُفوساً طالَ ما سَخِطَت","وَأَعتَبَ الدَهرُ قَوماً طالَ ما عَتِبوا",48,"ب",3,0],["أُرضيهُمُ قَولاً وَلا يُرضونَني","فِعلاً وَتِلكَ قَضِيَّةٌ لاتَقصِدُ",49,"د",1,0],["أَرضى المَوالي نُصحٌ يَظَلُّ عُبَيدُ ال","لَهِ يَغلو فيهِم وَيَجتَهِدُه",50,"د",2,0],["أَرضاهُ مَوفوداً إِلَيهِ وَحَسبُهُ","بي حينَ أَتبَعتُ القَوافي وافِدا",51,"د",2,0],["أَرضٌ إِذا اِستَوحَشتُ ثُمَّ أَتَيتُها","حَشَدَت عَلَيَّ فَأَكثَرَت إيناسي",52,"س",2,0],["أَرضاهُ لِلمُعتَمِدِ المُشتَري","حَظّاً وَلِلمُختَبِطِ المُعتَفي",53,"ف",2,0],["أَرضٌ تَتيهِ عَلى السَحابِ إِذا اِلتَقى","سَيهانُ في حَجَراتِها وَنَداكا",54,"ك",2,0],["أَرضاهُ كُفؤُ مُلِمَّةٍ تَعطو لَها","يَدُهُ وَيَهتِكُ هَولَها إِقدامُهُ",55,"م",2,0],["أَرضى خُراسانَ حَتّى ما تَرى عَرَباً","تَنبو عَلى حُكمِهِ فيها وَلا عَجَما",56,"م",2,0],["أَرضٌ عَذاةٌ وَمَشرَفٌ أَرِجٌ","وَماءُ مُزنِ يَفيضُ مِن شَبَمِه",57,"م",2,0],["أَرضاهُمُ لِلحَقِّ أَغشاهُم بِهِ","وَأَقَلُّ مَن تَغشاهُ مَن تَرضاهُ",58,"ا",2,0],["أَرضٌ رَمَيتَ إِلَيها وَهيَ فاسِدَةٌ","بِصارِمٍ مِن سُيوفِ اللَهِ مَشبوبِ",59,"ب",1,0],["أرضٌ يَحِنُّ إليها من يُفارقُها","ويَحمَدُ العيشَ فيها من يُدانِيها",60,"ي",3,0],["أرضٌ إذا نُسِجَتْ فيها مَطارِفُها","زادَتْ لطيبِ الثَّرى أطرافُها طِيبا",61,"ب",2,0],["اِرضِ الزَمانَ لِكُلِّ ذي","مَرَحٍ وَمُختالٍ فَخورِ",62,"ر",1,0],["اِرضَ المَنايا لِكُلِّ طاغٍ","وَاِرضَ المَنايا لِمَن تَجَبَّر",63,"ر",1,0],["إِرضَ بِالعَيشِ عَلى كُلِّ حالٍ","تَتَّسِع فيهِ وَإِن كانَ ضَنكا",64,"ك",2,1],["أَرضٌ تَضاعَفَ حَرُّها وَبَعوضُها","في مَرجِها لَمّا حَلَلتُ بِقاعِهِ",65,"ع",2,0],["أَرضاً حَلَلتُ مُمَتَّعاً في أَهلِها","فَكَأَنَّهُم إِلفايَ أَو إِحلافي",66,"ف",2,0],["أَرضٌ يُنَمِّقُ زَهرَها","ما فاضَ مِن نَهرٍ وَعَينِ",67,"ن",1,0],["أَرضَعَتنا ثَديَ أُنسٍ مِنكَ تَألَفُهُ","فَاليَومَ مِنكَ رَضيعُ الأُنسِ قَد قُطِما",68,"م",2,0],["أَرضٌ بِها سائِرُ الأَهوالِ قَد جُمِعَت","كَما تَجَمَّعَ فيها الضَبُّ وَالنونُ",69,"ن",1,0],["أَرضٌ نَدى الصالِحِ السُلطانِ وابلُها","وَرَأيُهُ لِرَحى أَحوالِها قُطُبُ",70,"ب",1,0],["أَرضٌ تَحِلُّ بِرَبعِها فَلِباسُنا","مِن سُندُسٍ وَفِراشُنا الإِستَبرَقُ",71,"ق",1,0],["أَرضٌ بِها يَسطو عَلى اللَيثِ الطَلا","وَيَعوثُ في غابِ الهِزَبرِ الأَرقَمُ",72,"م",1,0],["أرُضَابُ فيكِ سلافةٌ نَشَوَاتُهَا","يَمشينَ مِن طَرَبٍ بِقَدّكِ راقصا",73,"ص",2,0],["أَرضُهُ مِن سَنابِكٍ قادِحاتٍ","شَرَرَ النّقْعِ والسماءُ نسورُ",74,"ر",1,0],["أرْضَعَ الغَيمُ لباناً بانَهُ","فَتَربّتْ فيه قاماتُ المِلاح",75,"ح",1,0],["أَرضٌ مُصَرَّدَةٌ وَأُخرى تُثجَمُ مِنها","الَّتي رُزِقَت وَأُخرى تُحرَمُ",76,"م",1,1],["أَرضَعتَهُم خِلفَ مَكروهٍ فَطَمتَ بِهِ","مَن كانَ بِالحَربِ مِنهُم قَبلَهُ لَهِجا",77,"ج",2,0],["أَرضٌ خَلَعتُ اللَهوَ خَلعي خاتَمي","فيها وَطَلَّقتُ السُرورَ ثَلاثا",78,"ث",2,0],["أَرضٌ بِها عُشُبٌ جَرفٌ وَلَيسَ بِها","ماءٌ وَأُخرى بِها ماءٌ وَلا عُشُبُ",79,"ب",1,0],["أَرضٌ هَبَطَت بِها سَماءً طَلقَةً","وَخَبَطتُ مِن سَدَفٍ بِها أَنوارا",80,"ر",2,0],["أَرْضَيْتَ قَومَكَ بالفعالِ كريمةً","تَرجو بها مِن رَبّكَ الرّضوانا",81,"ن",2,0],["أرضٌ مُطهَّرةٌ وجوٌّ مُشرِقٌ","صَافٍ ومَاءٌ سَائغٌ وَظِلالُ",82,"ل",1,0],["أَرَضيتَ إِلّا بِالعُيونِ رَكائِباً","وَقَنِعتَ إِلّا بِالقُلوبِ سَبيلا",83,"ل",2,