لُجّةٌ تتسعَّرُ",22,"ر",1,0],["ذَبَحنا فَسَمَّينا فَحَلَّ ذَبيحُنا","وَما ذَبَحَت يَوماً تَميمٌ فَسَمَّتِ",23,"ت",1,0],["ذَبَّ عَنها قُصَيٌّ كُلَّ عَدُوٍّ","فَنَفاهُ وَجُرهُماً أَجلاها",24,"ا",3,0],["ذُبابُهُ إِن يَشدُ يَحدُث لَهُ","جِدٌّ يُوازي لَعِبَ الغاوِيَه",25,"و",3,0],["ذبائحُ راحتْ يوَم عيدِ لحومِها","وما ازدانَ عيدٌ لا يكونُ بهِ ذبحُ",26,"ح",1,0],["ذبوا عَن الأوطان يا أبناءها","لتسرَّ في أجداثها الأجداد",27,"د",1,0],["ذببت عَن العراق وَعن بنيه","وَلَم يكُ لي سوى الإصلاح داب",28,"ب",1,0],["ذببت عَن الآداب في يوم عسرها","فما نفع الآداب في عسرها ذبِّي",29,"ب",2,0],["ذبلت للهموم منها خدود","أَشبهت قبل ذلك الجلنارا",30,"ر",2,0],["ذَبُلَ الرَّيْحَانُ حُزْناً وَبَدَتْ","سَنَةٌ فِي أَعْيُنِ النَّرْجِسِ رَانَتْ",31,"ت",1,0],["ذُبُلٌ يُهَذِّبُها الطِعانُ وَإِنَّها","تَزدادُ جَهلاً كُلَّ يَومِ جِلادِ",32,"د",1,0],["ذَبيحٌ طَلَّ مِنهُ دَمٌ","وَلَم يُقطَعُ لَهُ وَدجُ",33,"ج",1,0],["ذَبلُ النِسرينُ وَالوَردُ النَدي","وَاِستحالَ النَرجسُ الساجي الحَدق",34,"ق",1,0],["ذبُل الوردُ وانقضى مَوْسِمُ الريح","انِ واحسرتا على الريحان",35,"ن",1,0],["ذبح الشعر والقصيدة صارت","قينة تشترى ككل القيان",36,"ن",1,0],["ذبحلها جفني مسامات خدّي ...","أزوالها..؟ ضيفان والجفن.؟ حاتم..",37,"م",1,0],["ذبَّ الغوالي حتّى ما يطفنَ بهِ","جَأْبُ الْمَفَارِقِ عَنْ ذِي بَنَّة ٍ تَفِلِ",38,"ل",1,0],["ذبحتنا الفسيفساء عصورا",". والدمى والزخارف البلهاء",39,"ا",2,0],["ذبلتْ في ثراهُ ريحانة ُ الف","نِّ، وجفَّتْ ريحانة ُ التمثيل",40,"ل",1,0],["ذبحت أفراح في لمحة","قوّة تجني ولا تعتذر",41,"ر",1,0],["ذبنا فمتنا غراما في محبته","يا ليت لو بحنان القرب احيانا",42,"ن",2,0],["ذبت من لهفة الغرام ولوعا","وكوتني لواعج الهجران",43,"ن",1,0],["ذبلت ذبول الزهر أخطأه الحيا","وقد ذبت مثل الشمع وهو لهيب",44,"ب",1,0],["ذبلت وأخلق حسنها","يا ليت شعري ما دهاها",45,"ا",3,0],["ذَبَحتم فِلَسطينَ يا وَيحَنا","أَبَحتم حماها لمُسترزِقة",46,"ق",2,0],["ذُبابُ الأسَى بَينَ الجَوانحِ لامِعٌ","وَلَيسَ لِقَلبِي مِن عِذارَيهِ مَنفَذُ",47,"ذ",1,0],["ذبل الغصن وهو غصن رطيب","وذوى الزهر وهو بالأكمام",48,"م",1,0],["ذبحنا هدينا أيضاً جميعاً","وأ