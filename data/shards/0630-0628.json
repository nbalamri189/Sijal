{"poems":[[77,"يا من به للملة استبشار","https://www.aldiwan.net/poem36429.html","الكامل"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[83,"اسقني بنت الدوالي","https://www.aldiwan.net/poem54197.html","مجزوء الرمل"],[51,"عيبك الصلع ليس مما يغبي","https://www.aldiwan.net/poem61863.html","البسيط"],[29,"ذببت عن أعراضكم آل وائل","https://www.aldiwan.net/poem6177.html","الطويل"],[91,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[38,"من كل أشمط مذبوح بلحيته","https://www.aldiwan.net/poem7739.html","البسيط"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[89,"حبذا تمثال أمامي تعالى","https://www.aldiwan.net/poem44741.html","الخفيف"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[28,"ولست بنائل قمر الثريا","https://www.aldiwan.net/poem4950.html","الوافر"],[28,"أقول لمنحوض أعالي عظامها","https://www.aldiwan.net/poem5461.html","الطويل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[66,"ذكر العهود فأسهر الطرف القذي","https://www.aldiwan.net/poem38493.html","الكامل"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"بؤس قلبي كيف ذلا","https://www.aldiwan.net/poem30125.html","مجزوء الرمل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[46,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[76,"هو الفتح منظوما على إثره الفتح","https://www.aldiwan.net/poem39462.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85497","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[109,"قلاده وخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=8424",""],[38,"مِنْ كُلِّ أشْمَطَ مَذْبُوحٍ بِلِحْيَتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=21220",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[85,"يا ثَرَى النيلِ، في نَواحيكَ طيرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9621&r=&rc=111",""],[91,"فلنعش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67817&r=&rc=100",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[116,"ان الحبيب الذي باللطف افنانا","https://www.aldiwan.net/poem40461.html","عموديه"],[116,"يا غزال الشعب الجفول كفاني","https://www.aldiwan.net/poem41687.html","الخفيف"],[121,"ألا ليت شعري فيك هل أنت ذاكري","https://www.aldiwan.net/poem49323.html","الطويل"],[121,"أرج كأنفاس الحبي","https://www.aldiwan.net/poem49362.html","مجزوء الكامل"],[130,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[151,"ذكرتك فارتاح الفؤاد صبابة","https://www.aldiwan.net/poem68568.html","الطويل"],[198,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[207,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[222,"ذكريني يا نجمتي ذكريني","https://www.aldiwan.net/poem55266.html","الخفيف"],[236,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[272,"يا راحلين إلى منى بقيادي","https://www.aldiwan.net/poem52045.html","الكامل"],[283,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[298,"آه يا حبل النوى ما أطولك","https://www.aldiwan.net/poem33204.html","الرمل"],[394,"عين جودي على الشهيد القتيل","https://www.aldiwan.net/poem53467.html","الكامل"],[404,"ذبحت نفسك لكن لا بسكين","https://www.aldiwan.net/poem33379.html","البسيط"],[417,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"],[438,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[459,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[459,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[459,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[501,"أصاحب بيتي كل ما قام في الورى","https://www.aldiwan.net/poem37812.html","الطويل"],[539,"هل من اذن في كلمة بالتحية","https://www.aldiwan.net/poem47488.html","عموديه"],[559,"يا طالب الكيمياء علمي","https://www.aldiwan.net/poem34354.html","مخلع البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[565,"في فؤادي من الغرام لهيب","https://www.aldiwan.net/poem885.html",""]],"verses":[["ذبُلَتْ بهِ زُهْرُ النّجومِ وطالَما","أرِجَتْ بحَضْرَتِهِ لَها أزْهارُ",0,"ر",1,0],["ذَبَحوا الأَشياخَ وَالزَمنى وَلَم","يَرحَموا طِفلاً وَلَم يُبقوا غُلاما",1,"م",2,0],["ذَبَّ عَنْ حَقِّ البِلاَدِ بِمَا","في حُدُودِ العِلْمِ مِنْ ذَبِّ",2,"ب",1,0],["ذب نبيع جديد وبالي","وننال أشما في بالي",3,"ي",1,0],["ذُبْتَ من شدَّة التفكُّك إلا","كُوَّةً فيك ذاتَ أسْرٍ شديدِ",4,"د",1,0],["ذَبَبتُ عَن أَعراضِكُم آلَ وائِلٍ","وَناضَلتُ حَتّى لَم أَجِد مَن أُناضِلُه",5,"ه",1,1],["ذَبَحَت أَفراحَهُم في لَمحَةٍ","قُوَّةٌ تَجني وَلا تَعتَذِرُ",6,"ر",1,0],["ذَبَّ الغَوالِيَ حَتّى ما يُطِفنَ بِهِ","صابُ المَفارِقِ عَن ذي بَنَّةٍ تَفِلِ",7,"ل",1,0],["ذَبُلَتْ مَرَاشِفُهُ فأَصبحَ","ذَوياً نِضْوَ الكُلُومْ",8,"م",1,0],["ذب عن حق الشعب ذب قدير","يوم لا تنصر اليمين الشمالا",9,"ل",2,0],["ذبيجون كلهم","أمير البيت قيَّمه",10,"م",2,0],["ذُبحت بالسكين","من غادر مهين",11,"ن",1,0],["ذَبُلَت في ثَراهُ رَيحانَةُ الفَن","نِ وَجَفَّت رَيحانَةُ التَمثيلِ",12,"ل",1,0],["ذُبابُ حُسامٍ مِنهُ أَنجى ضَريبَةً","وَأَعصى لِمَولاهُ وَذا مِنهُ أَطوَعُ",13,"ع",1,0],["ذُبابٌ طارَ في لَهَواتِ لَيثٍ","كَذاكَ اللَيثُ يَلتَهِمُ الذُبابا",14,"ب",2,0],["ذُباباً حُساماً أَو جَناحَي مُقَطِّعٍ","ظُهورَ المَطايا يَترُكُ الصُلبَ أَجزَلا",15,"ل",2,0],["ذبحتنا الفسيفساء عصور","والدمى والزخارف البلهاء",16,"ا",2,0],["ذَبُلَت غُصونُ الوُدِّ فيما بَينَنا","وَجَرى الَّذي قَد كانَ مِنهُ تَعَوُّذي",17,"ذ",2,0],["ذَبوبٌ عن الإسلام مَدّ لجيشِهِ","جناحاً عليه بالأسِنّةِ رفرفا",18,"ف",2,0],["ذَبُلت منَ الآدابِ روضتيَ الَّتي","جُلِيَت نَضَارتها على الرُوَّادِ",19,"د",1,0],["ذُبتُ حَتّى ما أَرى لي","في مِراةِ الشَمسِ ظِلّا",20,"ل",2,0],["ذَبَحُوا السَّلامَ فَمِنْ دِماءِ ذَبِيحهِم","في كلِّ أرضٍ لُجّةٌ تتسعَّرُ",21,"ر",1,0],["ذَبَحنا فَسَمَّينا فَحَلَّ ذَبيحُنا","وَما ذَبَحَت يَوماً تَميمٌ فَسَمَّتِ",22,"ت",1,0],["ذَبَّ عَنها قُصَيٌّ كُلَّ عَدُوٍّ","فَنَفاهُ وَجُرهُماً أَجلاها",23,"ا",3,0],["ذُبابُهُ إِن يَشدُ يَحدُث لَهُ","جِدٌّ يُوازي لَعِبَ الغاوِيَه",24,"و",3,0],["ذبائحُ راحتْ يوَم عيدِ لحومِها","وما ازدانَ عيدٌ لا يكونُ بهِ ذبحُ",25,"ح",1,0],["ذبوا عَن الأوطان يا أبناءها","لتسرَّ في أجداثها الأجداد",26,"د",1,0],["ذببت عَن العراق وَعن بنيه","وَلَم يكُ لي سوى الإصلاح داب",27,"ب",1,0],["ذببت عَن الآداب في يوم عسرها","فما نفع الآداب في عسرها ذبِّي",28,"ب",2,0],["ذبلت للهموم منها خدود","أَشبهت قبل ذلك الجلنارا",29,"ر",2,0],["ذَبُلَ الرَّيْحَانُ حُزْناً وَبَدَتْ","سَنَةٌ فِي أَعْيُنِ النَّرْجِسِ رَانَتْ",30,"ت",1,0],["ذُبُلٌ يُهَذِّبُها الطِعانُ وَإِنَّها","تَزدادُ جَهلاً كُلَّ يَومِ جِلادِ",31,"د",1,0],["ذَبيحٌ طَلَّ مِنهُ دَمٌ","وَلَم يُقطَعُ لَهُ وَدجُ",32,"ج",1,0],["ذَبلُ النِسرينُ وَالوَردُ النَدي","وَاِستحالَ النَرجسُ الساجي الحَدق",33,"ق",1,0],["ذبُل الوردُ وانقضى مَوْسِمُ الريح","انِ واحسرتا على الريحان",34,"ن",1,0],["ذبح الشعر والقصيدة صارت","قينة تشترى ككل القيان",35,"ن",1,0],["ذبحلها جفني مسامات خدّي ...","أزوالها..؟ ضيفان والجفن.؟ حاتم..",36,"م",1,0],["ذبَّ الغوالي حتّى ما يطفنَ بهِ","جَأْبُ الْمَفَارِقِ عَنْ ذِي بَنَّة ٍ تَفِلِ",37,"ل",1,0],["ذبحتنا الفسيفساء عصورا",". والدمى والزخارف البلهاء",38,"ا",2,0],["ذبلتْ في ثراهُ ريحانة ُ الف","نِّ، وجفَّتْ ريحانة ُ التمثيل",39,"ل",1,0],["ذبحت أفراح في لمحة","قوّة تجني ولا تعتذر",40,"ر",1,0],["ذبحاً كذبحِ الشاة ِ لا تتقي","ذابحها إلاَّ بشخبِ العروقْ",41,"ق",1,0],["ذبنا فمتنا غراما في محبته","يا ليت لو بحنان القرب احيانا",42,"ن",2,0],["ذبت من لهفة الغرام ولوعا","وكوتني لواعج الهجران",43,"ن",1,0],["ذبلت ذبول الزهر أخطأه الحيا","وقد ذبت مثل الشمع وهو لهيب",44,"ب",1,0],["ذبلت وأخلق حسنها","يا ليت شعري ما دهاها",45,"ا",3,0],["ذَبَحتم فِلَسطينَ يا وَيحَنا","أَبَحتم حماها لمُسترزِقة",46,"ق",2,0],["ذُبابُ الأسَى بَينَ الجَوانحِ لامِعٌ","وَلَيسَ لِقَلبِي مِن عِذارَيهِ مَنفَذُ",47,"ذ",1,0],["ذبل الغصن وهو غصن رطيب","وذوى الزهر وهو بالأكمام",48,"م",1,0],["ذبحنا هدينا أيضاً جميعاً","وأتممنا المناسك خاضعينا",49,"ن",2,0],["ذبلت روضتي فمن لي أن تو","رق من بعد ذا الذبول غصوني",50,"ن",2,0],["ذَبَّ عَوادي الزَمانِ عَنّا","ذُبابُهُ الباتِرُ القَطوعُ",51,"ع",1,0],["ذبّلتَ زهراً ومن ريّاك نشوتُنا","وإِن ذكراك في البلوى تسلينا",52,"ن",2,0],["ذبحوا ضحاياهُم وسال دماؤُها","وأنا المتَيَّمُ قد نحرتُ فؤادي",53,"د",2,0],["ذُبابُها هَزِجٌ نُوّارُها أَرِجٌ","نَباتُها بَهِجٌ مُستَحسَنٌ عَطِرُ",54,"ر",1,0],["ذُبتُ وَاللَهِ غَراماً وأَسىً","من فراق لاكَ قَلبي وَعَلَك",55,"ك",1,0],["ذبتَ يا قَلبُ غَليلاً بعدهم","وَبهم ما كانَ أَروى غَلَلَك",55,"ك",1,0],["ذَبَحوهُ ذَبحَ الأَضاحي فَيا قَل","بُ تَصدَّع عَلى العَزيزِ الذَليل",56,"ل",1,0],["ذبحت نفسك لكن لا بِسِكِّينِ","كما رويناه عن طه ويسن",57,"ن",1,1],["ذبحت نفسك والستون قد وردت","عليك ماذا ترجي بعد ستين",57,"ن",1,0],["ذبحت نفسك يا لهفي عليك لقد","كنا نعدك للتقوى وللدين",57,"ن",1,0],["ذباب حسام البأس جوهر عضبه","وما الصارم الهندي لولا ذبابه",58,"ب",2,0],["ذبتَ حتى درسَ ال","حبّ حقّا طللك",59,"ك",1,0],["ذبَّ عن الدين بآرائه","فالدينُ من تدبيره في حريمْ",60,"م",1,0],["ذبَّ عن الخليفتين رأيُه ال","منصورُ ذؤبانَ الخلافِ الطُّلُسا",61,"س",2,0],["ذُبالُها تحت الدجى عيونُها","لا تستشير النجمَ في رَشادِها",62,"د",3,0],["ذبَّ عنها ذباب ماضيهِ بأساً","أيُّ مردٍ لها وأيُّ مردِّ",63,"د",1,0],["ذُبابٌ رَأَوْا فوقَ الجِبالِ وُجودَهُمْ","ألا هُمْ ذُبابٌ والجِبالُ جِبَالُ",64,"ل",1,0],["ذُبتُ شَوقاً وما بلغتُ مُنَائي","هَكَذا قدَّرَ الإِلهُ عليَّه",65,"ي",2,0],["ذب والْقِ منه عليك جزءاً","يصبغ في الحال منك ألفا",66,"ف",2,0],["ذبيحة نفس قطعُ عرقِ فسادِها","إلى أن يفي منها خؤونٌ مخادع",67,"ع",1,0],["ذبت وجداً ونحت شجوى وهلت","سحب دمعي لها وزاد العويل",68,"ل",1,0]]}