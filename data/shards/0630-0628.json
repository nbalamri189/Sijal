wPoem.aspx?id=34957",""],[5848,"طير في قفص","https://www.poetsgate.com/ViewPoem.aspx?id=51962",""],[5848,"ياضياع الحال","https://www.poetsgate.com/ViewPoem.aspx?id=50623",""],[5873,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215307",""],[5880,"عاد الشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=208585",""],[5899,"عارية","https://www.poetsgate.com/ViewPoem.aspx?id=31764",""],[5931,"جرح الجفا !","https://www.poetsgate.com/ViewPoem.aspx?id=175396",""],[5952,"من للمعركةْ؟","https://www.poetsgate.com/ViewPoem.aspx?id=207805",""],[5956,"ذَبُلَ الحب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=182133",""],[5956,"ذبْحُ الصهاين للشعب الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=192288",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[5975,"مدينة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=33750",""],[5975,"معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53260",""],[5976,"قصّة غَرَق .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30528",""],[6019,"وقوفاً على باب قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=174231",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6213,"أنت في قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85490&r=&rc=93",""],[463,"سلْ بالغويرِ السائقَ المغلِّسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60106&r=&rc=162",""],[6256,"هاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65914&r=&rc=2",""],[6261,"الهجرة الخامسة","//adab