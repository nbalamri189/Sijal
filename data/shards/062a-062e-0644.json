بات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5219,"نصيحتي","https://www.poetsgate.com/ViewPoem.aspx?id=194910",""],[5225,"عنيد تفكير","https://www.poetsgate.com/ViewPoem.aspx?id=36890",""],[5277,"أحدَ عشرَ حسرةً","https://www.poetsgate.com/ViewPoem.aspx?id=200167",""],[5277,"رحيلُ \"الثريّا\"","https://www.poetsgate.com/ViewPoem.aspx?id=201276",""],[5282,"العيدُ ملحَمةٌ للحب","https://www.poetsgate.com/ViewPoem.aspx?id=215234",""],[5358,"نعم يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=27116",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5720,"أبنائي الطلاب","https://www.poetsgate.com/ViewPoem.aspx?id=202125",""],[5818,"وإن باعوك","https://www.poetsgate.com/ViewPoem.aspx?id=186921",""],[5897,"رمضان يستعيد الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=156849",""],[5956,"يستشرف ابني بالحِجى المستقبَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193298",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[5956,"نايُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206677",""],[6102,"مُراوَحَةٌ بِانتِظارِ المَوتِ...","https://www.poetsgate.com/ViewPoem.aspx?id=186294",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[6184,"أمام مصحف عثمان في استنبول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78621&r=&rc=13",""]],"verses":[["تَخلِقُ أَجفانُها وَيَعرِضُها","دَمُ الطُلى في غَلائِلٍ جُدَدِ",0,"د",1,0],["تَخَلَّصتُ مِمَّن لَم يَكُن ذا حَفيظَةٍ","وَصِرتُ إِلى مَن لا يُغَيِّرُهُ حالُ",1,"ل",1,1],["تخلّفَ منّي ركْبُ طَيْبَةَ عانِيا","أمَا آنَ للعاني المُعَنّى بأنْ يُفْدَى",2,"د",2,0],["تَخَلَّقُ أَحياناً إِذا ما أَرَدتَها","وَخُلقُكَ مِن دونِ التَخَلُّقِ غالِبُ",3,"ب",1,0],["تَخَلهُ فِلَسطِيّاً إِذا ذُقتَ طَعمَهُ","عَلى رَبِذاتِ النَيِّ حُمشٍ لِثاتُها",4,"ت",3,0],["تَخَلَّلنَ أَجزاعَ الضَئيدِ غُدَيَّةً","وَرُعنَ اِمرِءاً بِالحاجِبِيَّةِ هائِما",5,"م",2,0],["تَخَلَّلُ أَحوازَ الخُبيبِ كَأَنَّها","قَطاً قارِبٌ أَعدادَ حُلوانَ ناهِلُ",6,"ل",1,0],["تخللتها من خليعاتها","صواحب شقت جيوب الحيا",7,"ا",1,0],["تَخَلَّلنَ أَبوابَ الخُدورِ بِأَعيُنٍ","غَرابيبَ وَالأَلوانُ بيضٌ نَواصِعُ",8,"ع",1,0],["تَخْلُقُ الأرضُ وهو غضٌّ جديدٌ","فَلكيٌّ من عنصر الجوزاءِ",9,"ا",2,0],["تخلّلُ الفيشةُ هُلْباً له","قد عمَّ منه شَرَج الدُّبر",10,"ر",1,0],["تخلَّفتْ شنطفٌ فقلنا","ما فعلتْ أختُنا الضريرَهْ",11,"ر",2,1],["تَخَلَّوا في الحَوادِثِ عَن أَبيهِم","وَنادَوا خُفرَةً دَعوى ضَلالِ",12,"ل",1,0],["تَخْلُبُ اللُّبَّ بأَلْحانٍ عِذابْ","وأَغَارِيدَ كأَمْلاكِ السَّمَا",13,"م",2,0],["تَخَلَّصتُمُ مِن سجنِ أَغماتَ وَالتَوَت","عَلَيَّ قُيودٌ لَم يَحِن فَكَّها بَعدُ",14,"د",1,0],["تَخلَّقوا نَبذَ المَشورات فَلا","يَنزِلُ مِنهُم أَحَدٌ عَما يَرى",15,"ا",1,0],["تَخلِطُ العُمرَينِ شيباً وَصِباً","وَالحَياتَينِ شَقاءً وَرَفاها",16,"ا",3,0],["تُخَلِّيهِمِ النِسوانُ غَيرَ فَوارِكٍ","وَهُم خَلَّوِ النِسوانَ غَيرَ طَوالِقِ",17,"ق",1,0],["تَخَلّى مِنَ الدُنيا لِيُنسى فَما خَلَت","مَغارِبُها مِن ذِكرِهِ وَالمَشارِقُ",18,"ق",1,0],["تَخلو الدِيارُ مِنَ الظِباءِ وَعِندَهُ","مِن كُلِّ تابِعَةٍ خَيالٌ خاذِلُ",19,"ل",1,0],["تخللها الرياحُ فسرَّحَتْها","صنيعَ المُشْطِ باللِّمَمِ الجِعَادِ",20,"د",1,0],["تَخَلَّ مِنَ الأَطماعِ إِمّا تَخَلَّتِ","وَوَلِّ صُروفَ الدَهرِ ما قَد تَوَلَّتِ",21,"ت",1,1],["تَخَلَّفَ شَيئاً في رَوِيَّةِ حِلمِهِ","وَحَنَّ إِلَينا بَذلُهُ فَتَسَرَّعا",22,"ع",2,0],["تَخَلَّيتُ عَن سَيرِ المَواكِبِ صاغِراً","وَما كُنتُ فيما قَد مَضى أَتَخَلَّفُ",23,"ف",1,1],["تَخَلّى عَنِ الدُنيا قُتَيبَةُ إِذ رَأى","تَميماً عَلَيها البيضُ تَحتَ العَمائِمِ",24,"م",1,0],["تَخلَّصْتَني من يَدِ النَّائباتِ","وأحلَلْتَني منك رَبعاً خَصيبا",25,"ب",2,0],["تَخَلَّيتُ مِمّا فيكِ جُهدي وَطاقَتي","كَما يَتَخَلّى القَومُ مِن عَرَّةِ الجَرَب",26,"ب",1,0],["تَخَلَّى عَنِ الدُّنْيَا وَأَبْقَى مَآثِرَاً","يُقِرُّ لَهَا بِالْفَضْلِ كُلُّ لِسَانِ",27,"ن",1,0],["تَخلِسُ مَن يَهواهُ ماءَ حَياتِهِ","فَلا الشُربُ مَبذولٌ وَلا هُوَ ناقِعُ",28,"ع",1,0],["تَخَلَّ عَنِ الدَنِيَّةِ وَاِجتَنِبها","وَلا تُؤثِر سِوى شَرَفِ الفِعالِ",29,"ل",1,0],["تَخَلَّوْا عن حَلائِلهم فَرُدَّت","عليهم تِلكُمُ المِنَنُ الجِسامُ",30,"م",1,0],["تُخَلِّدُها مصوناتٌ حِسانٌ","حرائِرُ مالَها أبداً مُذِيلُ",31,"ل",1,0],["تَخَلَّصَ أَقوامٌ وَأَسلَمَني الهَوى","إِلى عُلَقٍ سَدَّت عَلَيَّ المَطامِعا",32,"ع",2,0],["تُخَلِّفُ في وُجوهِ الأَرضِ رَسماً","كَأُفحوصِ القَطا أَو كَالأَداحي",33,"ح",2,0],["تخلَّقَ النّاسُ بتلكَ الّتي","أراكَ تَجْنيهَا مِنَ الخُلْق",34,"ق",1,0],["تَخَلّلَ سِجْفَ الليلِ للّيلِ كالِئاً","يُراعِيهِ بالصُّبْحِ الجَلِيِّ ويَرمُقُه",35,"ق",2,0],["تخلّلْتَها في المَعرَكِ الضَّنكِ مُقدِماً","وخُضْتَ غِمارَ الموت فيها مُلجِّجا",36,"ج",2,0],["تَخَلَّيتُ مِن صَفراءَ لا بَل تَخَلَّتِ","وَكُنّا حَليفَي خُلَّةٍ فَاِضمَحَلَّتِ",37,"ت",1,1],["تَخَلَّفَ بَعدَنا جيلٌ وَنَجمٌ","فَأَزهَرُ شائِمٌ وَأَشَمُّ راسي",38,"س",2,0],["تَخَلَّفتَ بَعدَ الظاعِنينَ كَأَنَّهُم","رَأوكَ أَخا وَهنٍ فَما حَمَلوكَ",39,"ك",1,0],["تَخَلَّ مِن أُمِّ دَفرٍ فَهيَ مُؤذِيَةٌ","وَهَوِّنِ الأَمرَ في غَرّائِهِ يَهَنُ",40,"ن",1,0],["تَخلِسُ الطَرفَ بِعَينَي بَرغَزٍ","وَبِخَدَّي رَشَإٍ آدَمَ غِر",41,"ر",1,0],["تخلى عن الدنيا لينسى فما خلت","مغاربها من ذكره والمشارق",42,"ق",1,0],["تخلَّى عن أبي حَرْبٍ فَوَلَّى","بِهَيْدَةَ قابِضٌ قَبْلَ القتالِ",43,"ل",1,1],["تخلف مالك للوارثين","وكانوا بعلمك بئس الخلف",44,"ف",1,0],["تَخَلَّقِ الصَفحَ تَسعَد في الحَياةِ بِهِ","فَالنَفسُ يُسعِدُها خُلقٌ وَيُشقيها",45,"ي",3,0],["تخلف دعس الحي عنهم فأخلدوا","لغبراء يعلوهم صفيح مردم",46,"م",1,0],["تخلف الريح تكوس خلفها","كأنها أعارت الريح الحفا",47,"ا",1,0],["تَخَلَّفْتُ عن سَيْرِ المواكِبِ صاغِراً","وما كُنتُ فيما قَدْ مَضى أَتَخلَّفُ",48,"ف",1,1],["تخلص للعقبى واعقب