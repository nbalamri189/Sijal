","https://www.poetsgate.com/ViewPoem.aspx?id=175318",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[4775,"ظلال شاردة","https://www.poetsgate.com/ViewPoem.aspx?id=175261",""],[4858,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=139695",""],[4862,"حالي وحالكِ ياحبيبةُ متعبُ","https://www.poetsgate.com/ViewPoem.aspx?id=157796",""],[4981,"وقفة مع الآخرة","https://www.poetsgate.com/ViewPoem.aspx?id=190507",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[5219,"رفقا معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=194913",""],[5219,"ما حيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=194917",""],[5246,"إني لفي أسف مما له انقلبوا","https://www.poetsgate.com/ViewPoem.aspx?id=187030",""],[5370,"هذاك اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=85957",""],[5370,"أثر يديني ماسكات كمومه","https://www.poetsgate.com/ViewPoem.aspx?id=81639",""],[5431,"حان الفطام فلستِ القلبَ تُعطيه","https://www.poetsgate.com/ViewPoem.aspx?id=191978",""],[5431,"قال يوما أحبها للرياح....","https://www.poetsgate.com/ViewPoem.aspx?id=199598",""],[5574,"صهيل الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=206031",""],[5628,"اجمل الاغنيات","https://www.poetsgate.com/ViewPoem.aspx?id=178476",""],[5628,"حديث مع الطير","https://www.poetsgate.com/ViewPoem.aspx?id=178516",""],[5628,"حديث مع القمر","https://www.poetsgate.com/ViewPoem.aspx?id=178551",""],[2110,"حسبي من الوجد ما بي أيها اللاحي","https://www.poetsgate.com/ViewPoem.aspx?id=156268",""],[5648,"حكم القدر","https://www.poetsgate.com/ViewPoem.aspx?id=154432",""],[5704,"على موانىء الرحيل ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204262",""],[5725,"ساقي الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=186810",""],[402,"سنحت في الطريق مغضوضة","https://www.poetsgate.com/ViewPoem.aspx?id=35503",""],[5897,"همسة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=156356",""],[5957,"زارني حرفٌ جميلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=37427",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[5974,"وداعا رحيمة","https://www.poetsgate.com/ViewPoem.aspx?id=206700",""],[2096,"ذكر الأحباب والوطنا","https://www.poetsgate.com/ViewPoem.aspx?id=106662",""],[6118,"عودة الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=12625",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""]],"verses":[["حانوتُ بَزٍّ يمْشي على فَرَسٍ","وثَوْرُ عُرْسٍ يخْتالُ في حِبَرِ",0,"ر",1,0],["حانَت لِيَفجَعَها بِاِبنٍ وَتُطعِمَهُ","لَحماً فَقَد أَطعَمَت لَحماً وَقَد فَجَعا",1,"ع",2,0],["حان كلامُ المُعاتب الخُرُسِ","في ردّ تلك المعاهدِ الدُّرُسِ",2,"س",1,1],["حان رحيلي إلى أبي حسنٍ","مُبرم إقليمه ونقّاضه",3,"ض",2,0],["حانٍ على الناس حامٍ عُقرَ بيضتهم","لا تعدم الطَّول من حانٍ ومن حامِ",4,"م",1,0],["حان أن تضلّ العِدات عن النج","حِ وأن تُطلِع الجنا الأكمامُ",5,"م",1,0],["حان انتجاعُكَ خِرقاً لا يكونُ له","في البَذْلِ والمَنْعِ أحيانٌ وأحيان",6,"ن",1,0],["حان أن يستريحَ عَودُ المعالي","ويُرى وهو ضاربٌ بالجِران",7,"ن",1,0],["حان أن يدعوني المنون إليه","وسأعصي المنون لو أستطيع",8,"ع",1,0],["حانٍ على الوجدِ أضلاعاً تُثَقِّفُها","أنفاسُهُ إنْ علتْ تثقيفَ مُرَّانِ",9,"ن",1,0],["حانَ وَداعٌ مِنّا تَشيدُ بِهِ","نُعمى مُقيمٍ وَحَمدُ مُرتَحِلِ",10,"ل",1,0],["حان الأمان ووافَى السربُ فافتقدوا","نسرين ظنوهما قد أبطآ حينا",11,"ن",2,0],["حان حرماني وناداني النذير","ما الذي أعدَدت لي قبل المسير",12,"ر",1,1],["حانَ حرماني فدعني يا حبيبي","هذه الجنة ليست من نصيبي",12,"ي",1,0],["حان اللقاء بغادتي وأنا","أخشى سراباً خادعاً منها",13,"ه",2,0],["حان الشفاء فودع الألما","واستقبل الأيام مبتسما",14,"م",2,1],["حان الفرار وآن لل","مسجون أن يتنسما",15,"م",2,0],["حان الحساب وآن لل","موتور أن يتكلما",15,"م",2,0],["حان الجلاءُ عن البلاد لمعشرٍ","نكبوا البلادَ بأربعين طِوالِ",16,"ل",1,0],["حانَ عَلَينا شافِعٌ إِحسانَهُ","فينا فَمِنهُ العَطفُ وَالتَوكيدُ",17,"د",1,0],["حانَ الرَحيلُ وَلَم تُوَدِّع مَهدَداً","وَالصُبحُ وَالإِمساءُ مِنها مَوعِدي",18,"د",2,0],["حانَ رَحيلُ النَفسِ عَن عالَمٍ","ما هُوَ إِلّا الغَدرُ وَالجَهلُ",19,"ل",1,0],["حان أن ننشر خفّاق الشراعِ","يا سفيني ويكِ هيَّا لا تُراعي",20,"ي",1,0],["حان اللقاءُ فما أعددتِ من كَلِمٍ","وما ادخرتِ من الأشواقِ والقُبَلِ",21,"ل",1,0],["حانَ فِراقي فَأَبكِني","لَكِن بِدَمعٍ وَكَفا",22,"ف",2,0],["حانِيَاتٍ عَلَى الْكُؤُوسِ مِنَ الرَّأْ","فَةِ يُرْضِعْنَهُنَّ كَالأُمَّهاتِ",23,"ت",1,0],["حَانَ مِنْهَا نَحْوِي الْتِفَاتٌ فَيَا لَلْ","بِدْعَ مِثْلُهُ فِي الْوُجُودِ",24,"د",1,0],["حان اقترابي منك أين أنا ؟","الشوق أقصاني وأدناني",25,"ن",2,0],["حان لي أن أطيق عنك ابتعادا","والتهابي سيستحيل رمادا",26,"د",2,1],["حانياتٌ على \" الدوالي \" تُحَلِّينَ","عناقيدَ زينةً للكعاب",27,"ب",1,0],["حَانَ أَن تَنْصُلَ العِدَاتُ عن النُّجْحِ","، وأَن يَقطَعَ الحَيَا الإِكْرَامُ",28,"م",1,1],["حان انتجاعُكَ خِرقاً لا يكونُ له","في البَدْلِ والمَنْعِ أحيانٌ وأحيانُ",29,"ن",1,0],["حان لي أن أردى فتحمل نفسي","معها أسراراً ثبتن ثبوتا",30,"ت",2,0],["حان أن يقلع الجناحان … طرنا","حفنة من حصى على صدر قلعه",31,"ع",2,0],["حانَ حانَ الرُّجوعُ يا قلبُ والعَوْ","دُ بِنَفْسٍ جَفُولَةٍ وَثَّابَةْ",32,"ب",2,0],["حان وقت الطلا فقم يا نديم","نجتليها من العقار القديمِ",33,"م",1,1],["حانت منيته فاسودَّ عارضه","كما يُسوَّدُ بعد الميت الدارُ",34,"ر",1,0],["حانَ إِسفارُ الصَباحِ","وَدَعا داعي الفَلاحِ",35,"ح",1,1],["حانَت له نَظرةٌ مِنها فَأَبصَرَهَا","مُطِلَّةً بين سِجفَيها مِنَ الغُرَفِ",36,"ف",1,0],["حان التيقظ فانهضي","واستنهضي فالسعد هب",37,"ب",1,0],["حان التيقظ والطبيعة ساعدت","والعود أحمد للنجاح العاجل",38,"ل",1,0],["حانتي عالمُ الخواطر في نفسي","ودنيا الآمال والآلام",39,"م",1,0],["حان مَسيري راحلاً عنكمُ","ودونَ أوطانيَ بِيدٌ فِساح",40,"ح",1,0],["حانثاً ناكثَ الوفا","مائقَ الرأي أحمقا",41,"ق",2,0],["حانوت شيطانها الساعي بمهنتها","فمٌ طليقٌ يذيب القلب الرُّعُبِ",42,"ب",1,0],["حانَ حَيني يا رفيقيَّ","وأبناءَ ودادي",43,"د",2,0],["حانٍ عَلَى كَرِشٍ منثورةٍ سُلُبٍ","يكادُ من شَجْوِهِنَّ النَّجْمُ يَنْتَثِرُ",44,"ر",1,0],["حانماً لقد رام إعجازاً فأبكته","ولك يزل معجزاً في القول والعمل",45,"ل",1,0],["حان عليك وإن كرمت أبوة","في كل نائبة حنو الوالد",46,"د",1,0],["حَانَ الفِرَاقُ أَبا الحُسينِ فَأسعَدت","جَفني الدُّمُوعُ وَخانَني السُّلوَانُ",47,"ن",1,0],["حَانَ أَنْ تَسْتَحِيَ الأَسْ","قَامُ مِنْ جِسْمِي وَتَخْزَى",48,"ز",2,1],["حانت مَنّيتُه فاسودَّ عارضُهُ","كما تسوّد بعد المّيت الدار",49,"ر",1,0],["حان الفراقُ أيا رفاق قفوا","لوداع شِعر متيَّم الشعرِ",50,"ر",1,1],["حانت محاسبة الرجال من الحمى","وكفى به من حاسبٍ ديّان",51,"ن",1,0],["حانَةٌ حَشوُها ظِباءٌ مِلاحٌ","هَيَّجو بِالدَلالِ قَلباً سَقيما",52,"م",2,0],["حانَةِ ناحومَ الَّتي صَيَّرَت","مِن حُبُّها في القَلبِ نيرانا",53,"ن",2,0],["حان الحميا أقفرا","كأس الشراب تكسرا",54,"ر",2,1],["حانات خمر شراب القوم سادتنا","أهل المروءة أرباب الكمالات",55,"ت",1,0],["حان العِشاءُ فأقبلت هندٌ إلى","مأوى البنين وزوجها المسكينِ",56,"ن",1,1],["حان الرحيل فودّع الدار التي","ما كان ساكنها بها بمخلّد",57,"د",1,1],["حانَ يَومُ المُنى","فَلنَثِب كُلُّنا",58,"ا",1,0],["حانٍ عَلى كُلِّ جانٍ حابٍ إن قَصَدوا","حامٍ شَفى مِن شَقا جَهلٍ وَمِن عَدَمِ",59,"م",1,0],["حان أن تسترد ذاك الشبابا","لا تظنن نجم سعدك غابا",60,"ب",2,1],["حان الرحيلُ وقد أوليتنا حسناً","والآنَ أحوجُ ما كنا إلى زادِ",61,"د",1,1],["حان القيام بما يبكيك لادمعت","عيناك من جزع يا ربة الشنف",62,"ف",1,0],["حان الحنان وآن الرفق بي كرماً","كرامة للنبي المحرز الشرفا",63,"ف",2,0],["حانيات عليه كالغيد تحنو","باكيات على سرير صغير",64,"ر",1,0],["حان اتحادكم حان ائتلافكم","حان اتفاقكم يا معشر العرب",65,"ب",1,0],["حانت مساواتكم حانت إخوتكم","حانت مواساتكم في البعد والقرب",65,"ب",1,0],["حانَ المَنِيَّةُ يا أَبا العَبّاسِ","فَدَعِ المِكاسَ فَلاتَ حينَ مِكاسِ",66,"س",1,1],["حانت منيَّتُهُ حيناً بمُنيتهِ لما","مَنَتهُ مُناهُ بالمَنَا البَئِسِ",67,"س",1,0],["حان الأوان فإن زرعت فلم يكن","يمضي الزمان بغير يوم حصاد",68,"د",1,0],["حَانِقاً كُلَّمَا خَطَا ارتَجَّتِ النَّب","لُ عَلَيهِ كَاللَّيلِ بِالهَولِ مَالاَ",69,"ل",2,0],["حانقاً مِيلَيَغرُ مِن ثَم ظَلاَّ","عِندَها نارَ سُخطهِ يَتَصَلَّى",70,"ا",1,0],["حانوا بِطالِعِ سَعدِ مَولانا الَّذي","أَزرى بِكُلِّ مَتوجٍ وَمَسود",71,"د",1,0],["حان الطعان وصدر الرمح منحطم","والضرب آن وحد السيف منثلم",72,"م",1,1],["حان حين كاسه يا طالما","ساقه من دنها الساقي وصب",73,"ب",1,0],["حان الوداع فضجت كل صارخة","وصارخ من مفداة ومن فاد",74,"د",1,0],["حانت وفاتك يا أبا العباس","فدع المكاس فلات حين مكاسِ",75,"س",1,1],["حان الرحيل وحان وقت الفجوعي","واقفت وأنا عيني عليها تراعي",76,"ع",2,0],["حانتْ لظهورك ساعته","واشتاق ليومك مرتقب",77,"ب",1,0],["حان اللقا والإتحاد لِلَمِّ شَم","لٍ طالما أودى به الإقصاء",78,"ا",2,0],["حان الرحيل وقد تأوه دربنا","خلف الدموع أتى يمشط جسرها",79,"ه",2,0],["حان الوداع ،فهل تطيق لهيبا ؟","يا ويح قلبك  إن حُرمت حبيبا",80,"ب",2,1],["حان الرحيل فلن أودع صامتاً","لا يرتجى منه العتاب فأعتبُ",81,"ب",1,0],["حانَ العبورُ على الصّراطِ وعندهُ","يتساقطُ الكفّارُ في النّيرانِ",82,"ن",1,0],["حَانِيَاتٌ تَشِفُّ وَجْدِي السَّوَاري","صَافِيَاتٌ كَأَنَّهَا الْبِّلُّورُ",83,"ر",1,0],["حانيك مجد الدين لا تهملّنها","فليس لها يوماً سواك بديل",84,"ل",1,0],["حانيا منه على بعيض له","جنحة المنقضَّ خلف الغزوات",85,"ت",1,0],["حَانَ اللِّقَاءُ ، مَتَى يَا بَحرُ تَجمَعُنَا","فَيَشهَدَ الرَّملُ والأَطيَارُ لُقيَانَا",86,"ن",2,0],["حان الرحيل وشمس الحب قد أفلت ..","فهل أرى في غد للشمس إشراقا ؟",87,"ق",2,0],["حان الرحيل وشمس الحب قد أفلت","ناديتها فأجاب الرسم والطلل",88,"ل",1,0],["حان البكور فقامت مثل عادتها","عن الصغار وفي آمالها العجب",89,"ب",1,0],["حان الموادع وحان اليوم تلويعه","يا كثر عقبه اوراقٍ فوق مكتبتي",90,"ت",2,0],["حان الفراق وتم توديع غالين","قسوة زمن وظروف ماهي رحومه",91,"م",2,1],["حان الفطام فلستِ القلبَ تُعطيه","إنْ جاء يبكي أزيحي عنه صدّيه!",92,"ي",2,1],["حانيَ الصوت مشرقا كضياء","ينسج النورَ معطفا للجراحِ",93,"ح",1,0],["٨- حان الوداعُ إلى فراقٍ ربّما","لم يُبْقِ في بيدائه غيرَ الصدى",94,"د",2,0],["حان الرحيل حبيبتي لا تقلقي","الحب ما أُ ُسقى وما أقتات ُ",95,"ت",1,0],["حانَ الرحيلُ فهلْ تُرافقني","يا طيْرُ إنَّ الموعدَ الفجْرُ",96,"ر",1,0],["حانَ الرحيلُ ولنْ أعودَ إلى هنا","فلقدْ سئمتُ وكادَ يقتُلني الضَجَرْ",97,"ر",1,0],["حان الوفاء فداركني بمرحمة","يا ذا الضمين بإنجائي وإنجاحي",98,"ح",2,0],["حان الوداع اللي مقدر ومكتوب","حكم القدر فينا حكم بالوداعي",99,"ع",2,1],["حان الرحيل وها قد حل موعده","ما كنت أحسبُ يوماً فيه أسلاكِ",100,"ك",1,0],["حان منا يامعنّى مذ دنا","اول الشيب فحنّى مفرقي",101,"ق",2,0],["حان منها نحوي التفات فيا","للبدع لا بدع مثله في الوجود",102,"د",1,0],["حان الحصاد أيا كريمة فاهنئي","فالبذل زرعك والوفاء جناكِ",103,"ك",1,0],["حانيات النبض حرفي","من دم القلب تسيلْ",104,"ل",1,0],["حانية والايام قاسيةُ","ضاحكة والايام تبكيها",105,"ي",3,0],["حان الوداع فَهَلَّتْ مقلتيَّ دما","وجاوز الشوق مني أنجما وسما",106,"م",2,1],["حان يوم النفر وهو معي","فأبي ان يصحب البدنا",107,"ن",2,0],["حان أن يخنقوا الشراع ويطووا","علمَ الفتح بعد طولِ الجهادِ",108,"د",1,0],["حان الكفاح فأنزلتها طعنة","حمراء في صدر الحليف الصاري",109,"ر",2,0]]}