َأتي أَخيراً مِثلَ ما","أَجناكَ يَنعُ النَخلَةِ الميخارِ",143,"ر",1,0],["وَالخَيرُ يُهمَسُ بَينَهُم","وَيُقامُ لِلسَوآتِ مِنبَر",144,"ر",1,0],["وَالخَلقُ شَتّى وَلَكِن ضَمَّهُم خُلُقٌ","لِلشَرِّ لَم يُلقِ بَينَ الناسِ إِفرازا",145,"ز",2,0],["وَالخُنَّسِ الخَمسِ مايَخلو فَتىً وَرِعٌ","مِن مارِدٍ في ضَميرِ الصَدرِ خَنّاسِ",146,"س",1,1],["وَالخَلقُ غَيرُ الخُلُق كَم أَنِفَ اللاءَى","مِن صَيدِ ضارِيَةٍ بِأَنفٍ أَخنَسِ",147,"س",1,0],["وَالخَيرُ يَفعَلُهُ الكَريمُ بِطَبعِهِ","وَإِذا اللَئيمُ سَخا فَذاكَ تَكَلُّفُ",148,"ف",1,0],["وَالخَيرُ مَحبوبٌ وَلَكِنَّهُ","يَعجِزُ عَنهُ الحَيُّ أَو يَكسَلُ",149,"ل",1,0],["وَالخَودُ كَالنَخلَةِ مَجنِيَّةٌ","وَزَوجُها البائِسُ فُحّالُها",150,"ل",3,0],["وَالخَيرُ يُعدي كَغادي مُزنَةٍ هَطَلَت","أَرضاً فَلَمّا رَآها رائِحٌ هَطَلا",151,"ل",2,0],["وَالخِلُّ في لَفظِهِ ذَليلٌ","بِأَنَّ في وِدِّهِ اِختِلالا",152,"ل",2,0],["وَالخَيرُ أَزهَرُ ما إِلَيهِ مُسارِعٌ","وَالشَرُّ أَكدَرُ لَيسَ عَنهُ مُحجِمُ",153,"م",1,0],["وَالخَيرُ بَينَ الناسِ رَسمٌ دائِرٌ","وَالشَرُّ نَهجٌ وَالبَرِيَّةُ مَعلَمُ",154,"م",1,0],["وَالخَيرُ أَجمَعُ في غَبراءَ تَأدُمُ بي","هَذا التُرابَ وَيَفري الجِسمَ وَالأُدُما",155,"م",2,0],["وَالخَيرُ أَفضَلُ ما اِعتَقَدتَ فَلا تَكُن","هَمَلاً وَصَلِّ بِقُبلَةٍ أَو زَمزِمِ",156,"م",1,0],["وَالخَدَمُ الأَحجالُ في اللَفظِ وَال","مَقصَدِ كَالقَومِ دُعوا بِالخَدَم",157,"م",1,0],["والخِلُّ كالماء يُبْدي لي ضمائرَه","مع الصّفاء ويُخْفيها مع الكَدَرِ",158,"ر",1,0],["وَالخَيلُ عاكِفَةٌ عَلَيهِ كَأَنَّها","سُحُقُ النَخيلِ نَأَت عَنِ الجُرّامِ",159,"م",1,0],["وَالخالِطو مُعسِرٍ مِنهُم بِموسِرِهِم","وَأَكرَمُ الناسِ مَطروقاً إِذا اِختُبِطوا",160,"ط",3,0],["وَالخطى للكلال تقصر حيناً","وَلِحثِّ الرجال حيناً تَطول",161,"ل",1,0],["والخفيفُ الخطى إلى كل نفسٍ","مال عنها نصرُها وتنكَّبْ",162,"ب",1,0],["وَالخَيلُ ساطِعَةُ الغُبارِ كَأَنَّهُ","أَجَمٌ يُحَرَّقُ أَو رَعيلُ جَرادِ",163,"د",1,0],["والخيرُ مَسْدودةٌ أبوابُهُ","ولا طَريقٌ لهُ مَسلوكُ",164,"ك",1,0],["والخَرمُ في أَوائلِ الأَبياتِ","يُعرفُ بالأسماء والصِّفاتِ",165,"ت",1,0],["وَالخَيلُ تَقتَحِمُ الخَبارَ عَوابِساً","مِن بَينِ شَيظَمَةٍ وَآخَرَ شَيظَمِ",166,"م",1,0],["وَالخَيلُ تَشهَدُ لي أَنّي أُكَفكِفُها","وَالطَعنُ مِثلُ شَرارِ النارِ يَلتَهِبُ",167,"ب",1,0],["وَالخَيلُ ساهِمَةُ الوُجوهِ كَأَنَّما","تُسقى فَوارِسُها نَقيعَ الحَنظَلِ",168,"ل",1,0],["والخُنسُ يُزجِينَ غُنّاً في طَوائفِهِ","يَضرِسنَ مِن خِروِعٍ رَيَّانَ أَثمارا",169,"ر",2,0],["والخِدَبُّ العاري الزَّوائدِ ملِ","حَفَّانِ داني الدِّماغِ لِلآماقِ",170,"ق",1,0],["وَالْخَالُ ضَوْءُ الْخَيْرِ نَوْءُ النَّدَى","فِي فَلَكِ الِعزَّةِ وَالفَخْرِ",171,"ر",1,0],["وَالخَلْقُ جِسْمٌ إِنْ أَلَمِّ بِبَعْضِهِ","سَقَمٌ وَلَمْ يُتَلاَفَ عَمَّ وَأَتْلفا",172,"ف",2,0],["وَالخُلُقُ الحُرُّ فِي نِظَامٍ","مِنَ الكَرِيمَاتِ فِي الخِصَالِ",173,"ل",1,0],["واَلخَيْرُ أَنْ تَتَوَاشَجَ","الأَعْرَاقُ فِي خَيْرِ الْعَشَائِرْ",174,"ر",1,0],["والخيل تلهث في الميدان كالحةً","حمر الحمالق تطويه ويطويها",175,"ي",3,0],["وَالخَيرُ في ما اِختارَ خالِقه فَقَد","آلَت بِهِ الضَرّاء لِلسَّرّاءِ",176,"ا",2,0],["والخَمْرُ فلَيْسَتْ مِنْهُ ولا","لعبُ الشَّيْطانِ ولا دَدُهُ",177,"د",2,0],["والخَطْوُ فوقَ قِمَمٍ جُذاذِ","يا بنَ الإمامِ دَعْوَةَ العُوّاذِ",178,"ذ",1,0],["والخيام الشم مالت وهوت","وعوت فيها الرياح الأربع",179,"ع",1,0],["والخيل تبدأ من دمشق مسارها","وتشد للفتح الكبير ركاب",180,"ب",1,0],["والخارجون على أحكامها صَبَأُوا","مِثْلَ الخوارج في عهد الإمام علي",181,"ل",2,0],["والخَيلُ تَعْلَمُ أنّا، في تجاوُلِها","عندَ الطعانِ ، أولو بؤسى وإنعامِ",182,"م",1,0],["والخيلِ تَزحفُ لم تَدَعْ لمُغيِرها","جثثٌ تُغَطي الأرضَ أيَّ مُغار!",183,"ر",1,0],["والخافقاتِ ظلالُها عن سَجسَجٍ","يَشفى الغَليل ويُثلجُ الظمأنا",184,"ن",2,0],["والخَناسبَّةٌ علينا ولكن","في القُرى كلُّ ناقصٍ مسبوب",185,"ب",1,0],["والخزي في شهوات منكم ارتفعت","عن كشج كل لطيف كشحه غنج",186,"ج",1,0],["والخمر فاتكة بناعم","ترف يكاد من النّسائم يسقم",187,"م",1,0],["والخدّ أبهج ما يكون موردا","والطرف أفتن ما يكون كحيلا",188,"ل",2,0],["والخيرُ لا يُكفَرُ، فليُحسنِ المس","لمُ، والصَابىءُ، والهائد",189,"د",1,0],["وَالخَيْلُ تَنْحَطُ بِالكُمَاةِ تَرَى لهَا","رَهَجاً بكُلّ مُجَرَّبٍ مِقْدَامِ",190,"م",1,0],["والخَيلَ تَمزَغُ غرباً في أعِنّتها،","كالطيرِ تنجو من الشؤبوبِ ذي البردِ",191,"د",1,0],["والخيلُ تقْتَحِمُ الخَبَارَ عوابساً","ما بين شيْظمة ِ وآخر شيْظم",192,"م",1,0],["وَالْخَيْلَ تَقْتَحِمُ الْغُبَارَ عَوَابِساً","يومَ الكريهة ِ ما يردنَ رجوعا",193,"ع",2,0]]}