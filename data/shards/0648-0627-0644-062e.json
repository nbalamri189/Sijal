ae/diwan/poem/54930","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142336","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[7,"قالتْ بنو عامرٍ : خالوا بني اسدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17588",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[45,"ما قام لكي لعجل حين زاحفها","https://www.poetsgate.com/ViewPoem.aspx?id=33059",""],[91,"الى الشبان المتفرّجين","https://www.poetsgate.com/ViewPoem.aspx?id=53238",""],[91,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[46,"يا سابحاً يَصْهَلُ في غِرّةٍ!","https://www.poetsgate.com/ViewPoem.aspx?id=18522",""],[28,"عفى المنازل آخر الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=20966",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[3,"هلْ غادرَ الشُّعراءُ منْ متردَّم ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10745&r=&rc=99",""],[18,"لما نعى الناعي كليباً أظلمتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26450&r=&rc=16",""]],"verses":[["وَالخَوفُ يُغري طَلَبي فَخَفني","يا لَيتَ مَقدورَكَ لَم يُؤمِنّي",0,"ي",1,0],["وَالخَيلُ تَعثُرُبَينَ أَطرافِ القَنا","مَصبوغَةً بِدَمِ القُلوبِ الآني",1,"ن",2,0],["وَالخَيلُ مُخطَفَةُ الأَوساطِ ضامِرَةٌ","كَأَنَّهُنَّ عَلى الأَطوادِ ذُؤبانُ",2,"ن",1,0],["وَالخَيلُ تُستَلدَغُ شَوكَ القَنا","في يَومِ لا ظِلٌّ بِغَيرِ القَتام",3,"م",1,0],["وَالخَيلُ عابِسَةٌ تَجُر","رُ مِنَ العَجاجِ بِها ذُيولا",4,"ل",2,0],["وَالخَيلُ عالِمَةٌ ما فَوقَ أَظهُرِها","مِنَ الرِجالِ جَبانٌ كانَ أَو بَطَلُ",5,"ل",1,0],["وَالخَيلُ تَطبَعُ في حَوافِرِها","وَشماً تُداوِلُهُ وَتُخلِقُهُ",6,"ق",2,0],["وَالخَيلُ تَعلَمُ أَنَّ حَشوَ ظُهورِها","مِنهُ نُهىً يَنجابُ عَنها الموقُ",7,"ق",1,0],["وَالخَيلُ تَقدَحُ مِن أَرساغِها شَرَراً","أَمسى يُعَثَّنُ مِنهُ التُربُ وَالمَدَرُ",8,"ر",1,0],["والخَدُّ مِنْ عَرَقٍ يَفيضُ جُمانُهُ","كَالوَرْدِ قَرَّطَهُ الغَمامُ بِقَطْرِهِ",9,"ر",2,0],["والخُلفاءُ الراشِدونَ وبهمْ","أوضِحَ للدّينِ مَنارٌ وصُوَى",10,"ا",1,0],["والخَصْرُ خَفَّ فلا يَزالُ وِشاحُهُ","قَلِقاً وما وارى الإزارُ ثَقيلُ",11,"ل",1,0],["والخَيْلُ عابِسَةٌ يَعْتادُها مَرَحٌ","إذا امتَطاها نِظامُ الدّينِ مُبْتَسِما",12,"م",2,0],["والخيلُ تَمْرَحُ منْ عُجْبٍ بِفارِسِها","والبيضُ تَبْسِمُ في الأغْمادِ والأسَلُ",13,"ل",1,0],["والخَيْلُ عابِسَةُ الوُجوهِ كأنّها","تَحْتَ الكُماةِ إذا انْجَرَدْنَ ضِراءُ",14,"ا",2,0],["والخَيْلُ شُعْثٌ والرِّماحُ شوارِعٌ","والنّقْعُ أكْدَرُ والخَميسُ عَرَمْرَمُ",15,"م",1,0],["والخَطْوُ أَطويهِ أحياناً وأنشُرُهُ","والرُعْبُ يَنشُرني طَوْراً ويَطْويني",16,"ي",1,0],["وَالخَيلُ تَقتَحِمُ الخَبارَ عَوابِس","مِن بَينِ شَيظَمَةٍ وَآخَرَ شَيظَمِ",17,"م",1,0],["وَالخَيلُ تَعلَمُ وَالفَوارِسُ أَنَّني","فَرَّقتُ جَمعَهُمُ بِطَعنَةِ فَيصَلِ",18,"ل",1,0],["وَالخَيلُ ساهِمَةُ الوُجوهِ كَأَنَّم","تُسقى فَوارِسُها نَقيعَ الحَنظَلِ",18,"ل",1,0],["وَالخَيلُ تَشهَدُ لي أَنّي أُكَفكِفُه","وَالطَعنُ مِثلُ شَرارِ النارِ يَلتَهِبُ",19,"ب",1,0],["وَالخَيلُ في وَسطِ المَضيقِ تَبادَرَت","نَحوي كَمِثلِ العارِضِ المُتَفَجِّرِ",20,"ر",1,0],["وَالخَيلُ سودُ الوُجوهِ كالِحَةٌ","تَخوضُ بَحرَ الهَلاكِ وَالخَطَرِ",21,"ر",1,0],["وَالخَيلُ تَعثُرُ بِالقَنا في جاحِمٍ","تَهفو بِهِ وَيَجُلنَ كُلَّ مَجالِ",22,"ل",1,0],["وَالخَيلُ تَعلَمُ وَالفَوارِسُ أَنَّني","شَيخُ الحُروبِ وَكَهلُها وَفَتاها",23,"ا",3,0],["والخيْلُ تهُدّ مرابِطها","وتَقُدّ أعنّتَها حنَقا",24,"ق",2,0],["والْخَيْلُ لَمَّا ضَاقَ رَحْبُ مَجَالِهَا","لَمْ تَسْتَطِعْ خَلْفاً وَلاَ قُدَّامَا",25,"م",2,0],["وَالْخَيْلُ خَطٌّ وَالْمَجَالُ صَحِيفَةٌ","وَالسُّمْرُ تَنْقُطُ وَالصَّوَارِمُ تَشْكُلُ",26,"ل",1,0],["والخَلْقُ زرْعٌ للحَصادِ مآلُهُ","وإذا استَحقّ فَما عسى إنْظارُهُ",27,"ر",2,0],["وَالخَيلُ وَالفُرسانُ قَد","ضَرَبَت نِطاقاً حَولَهُنَّه",28,"ن",2,0],["وَالخَيلُ تَعثُرُ بِالأَبطالِ عابِسَةً","مِثلَ السَراحينَ مِن كابٍ وَمَعفورِ",29,"ر",1,0],["وَالخُلْقِ أَثْبَتَ مَا تَقُو","مُ عَلَيْهِ فِي الأُسِّ المَبَانِي",30,"ي",1,0],["وَالخُشُبُ المُضْرَمَاتُ أَجْلَتْ","عَنْ فَحَمٍ مُبْطِنٍ ضِرَامَا",31,"م",2,0],["والخَلْقُ تعلم أنك الغوث الذي","يُضفي عليها وافيَ الأستارِ",32,"ر",1,0],["والخير قد ضاع حتى أنّ طالبه","لم يلق منه سوى المسطور في الكتب",33,"ب",1,0],["وَالخِندِفِيّونَ بِغَدرِ الأَقيان","إِذ كَذَّبَ الأَقرَعُ دَعوى الفُرسان",34,"ن",1,0],["وَالخَيلَ إِذ حَمَلَت عَلَيكُم جَعفَرٌ","كُنتُم لَهُنَّ بِرَحرَحانَ دُوارا",35,"ر",2,0],["وَالخَيلُ تَنحِطُ بِالكُماةِ وَقَد رَأوا","لَمعَ الرَّبيئَةِ في النِيافِ العَيطَلِ",36,"ل",1,0],["وَالخَيلُ تُخبِرُ عَن رِياحٍ أَنَّهُم","نِعمَ الفَوارِسُ في الغُبارِ الأَقتَمِ",37,"م",1,0],["وَالخاذِلاتُ مَعَ الجَآذِرِ خِلفَةً","وَالأُدمُ حانِيَةٌ مَعَ الغِزلانِ",38,"ن",1,0],["وَالخالِطينَ نَحيتَهُم بِنُضارِهِم","وَذوي الغِنى مِنهُم بِذي الفَقرِ",39,"ر",1,0],["وَالخالِطونَ فَقيرَهُم بِغَنِيِّهِم","وَالمُنعِمونَ عَلى الضَعيفِ المُرمِلِ",40,"ل",1,0],["والخمسة الأشباح نورا قبل ما","رَقمَ السماكُ من الدجى جلبابا",41,"ب",2,0],["والخلق شاخصة لجاهِ مشفع","فرد الجلال لشأنهِ التعظيم",42,"م",1,0],["والخيل والليل والبيداء شاهدة","والضرب والطعن والقرطاس والقلم",43,"م",1,0],["والخَلْق منه العمَمَ الخَدَلَّجا","والخَلُقَ القيِّمَ لا المعوَّجا",44,"ج",2,0],["والخلدُ أن تُلْفَى تجودُ وتعتلي","والموت أن تلْفى وأنت جمادُ",45,"د",1,0],["والخسْفُ دونَ قبوله","طرفاً من الخَسْفِ المشوم",46,"م",1,0],["وَالخَيلُ تَعدو بِالكُماةِ كَأَنَّها","أُسدُ الغَياطِلِ مِن فَوارِسِ تَغلِبِ",47,"ب",1,0],["وَالخَيلُ عابِسَةٌ كَأَنَّ فُروجَها","وَنُحورَها يَنضَحنَ بِالجِريالِ",48,"ل",1,0],["وَالخَيلُ يُتعِبُها عَلى عِلّاتِها","لِلَّهِ مُنتَصِبُ الفُؤادِ شَكورُ",49,"ر",1,0],["وَالخَيلُ تَمشُقُ عَنهُمُ أَسلابَهُم","في كُلِّ مُعتَرَكٍ وَكُلِّ مُغارِ",50,"ر",1,0],["وَالخَيلُ تَشتَدُّ مَعقوداً قَوادِمُها","تَعدو وَتَمتَخِضُ الأَكفالُ وَالسُرَرُ",51,"ر",1,0],["وَالخَمرُ خَمرٌ في إِنا","ءٍ مِن لُجَينٍ أَو تُراب",52,"ب",1,0],["وَالخَصرُ عَفواً وَ","صَفحاً لَهُنَّ خُصورُ",53,"ر",1,0],["وَالخَدُّ أَبهَجُ ما يَكونُ مَورِداً","وَالطَرفُ أَفتَنُ ا يَكونُ كَحيلا",54,"ل",2,0],["وَالخَمرُ فاتِكَةٌ فَكَيفَ بِناعِمٍ","تَرَِفٍ يَكادُ مِنَ النَسائِمِ يُسقَمُ",55,"م",1,0],["وَالخَيلُ طائِرَةً عَلى أَرسانِها","تَهوى لَوِ اِنعَتَقَت مِنَ الأَرسانِ",56,"ن",1,0],["وَالخَمرَ وَالحَسناءَ وَالوَترَ","المُرَنَّحَ وَالغِنا",57,"ن",2,0],["وَالخَوفُ مِن كارِثَةٍ لَم تَقَع","رَمَصُّ مِن كارِثَةٍ حَلَّتِ",58,"ت",1,0],["والخير ان تجهل في","ملحودة مستقبلك",59,"ك",1,0],["والخدّ من دمعي ومن فيضه","يشرب من عين ومن جدول",60,"ل",1,0],["وَالخَيلُ في الحَيِّ عِراقِيَّةٌ","تَحمي وَتُحمى في بُيوتاتِهِ",61,"ت",2,0],["وَالخُلدُ في الدُنيا وَلَيسَ بِهَيِّنٍ","عُليا المَراتِبِ لَم تُتَح لِجَبانِ",62,"ن",1,0],["وَالخَلقُ حَولَكَ خاشِعونَ كَعَهدِهِم","إِذ يُنصِتونَ لِخُطبَةٍ وَبَيانِ",62,"ن",1,0],["وَالخَلقُ يَفتِكُ أَقواهُم بِأَضعَفِهِم","كَاللَيثِ بِالبَهمِ أَو كَالحوتِ بِالبَلَمِ",63,"م",1,0],["وَالخُصورُ واهِيَةٌ","بِالبَنانِ تَنجَذِبُ",64,"ب",1,0],["والخالِ في الخَدِّ إِذْ أُشَبِّهُهُ","وَرْدَةَ مِسْكٍ على ثَرَى تِبْرِ",65,"ر",1,0],["والخَمْسَةِ الغُرِّ أصحابِ الكِسَاءِ مَعاً","خَيْرِ البَرِيّةِ مِنْ عُجْمٍ ومِنْ عَرَبِ",66,"ب",1,0],["وَالخَيلُ تَبكي جُلودُها عَرَقاً","بِأَدمُعٍ ما تَسُحُّها مُقَلُ",67,"ل",1,0],["وَالخَيلَ قَد فَصَّلَ الضِياعَ بِها","وَالنِعَمُ السابِغاتِ وَالنِقَما",68,"م",2,0],["وَالخَيلُ مَطرودَةٌ وَطارِدَةٌ","تَجُرُّ طولى القَنا وَقُصراها",69,"ا",3,0],["وَالخُرَّمِيَّةُ إِذ تَجَمَّعَ مِنهُمُ","بجِبالِ قُرّانَ الحَصى وَالأَثلَبُ",70,"ب",1,0],["وَالخِزيُ في شَهَواتٍ مِنكُمُ اِرتَفَعَت","عَن كَشحِ كُلِّ لَطيفٍ كَشحُهُ غَنِجِ",71,"ج",1,0],["وَالخُدودِ الحِسانِ يَبهى عَلَيها","جُلَنّارُ الرَبيعِ طَلقاً وَوَردُه",72,"د",2,0],["وَالخَيلُ تُجمِرُ بِالفَوارِسِ وَالقَنا","يَخلُجنَ خَلجَ البِئرِ بِالأَمراسِ",73,"س",1,0],["وَالخَيبُ فيهِ عَلى نَقيضَتِهِ","مَسلى أَخي بَثٍّ وَمُرتَدَعُه",74,"ع",2,0],["وَالخِضرُ مِلءُ يَدَيكَ مِن كَرَمٍ","يُبديهِ إِفضالاً وَيَبتَدِعُه",74,"ع",2,0],["وَالخَيرُ يُجمَعُ وَالنَشاطُ لِمَجلِسٍ","قَمَنِ المَحَلِّ مِنَ السَماحَةِ آهِلِ",75,"ل",1,0],["وَالخَيلُ تُلقي عِتاقَ السَخلِ مُعجَلَةً","لَأياً تُبينُ بِها التَحجيلَ وَالغُرَرا",76,"ر",2,0],["وَالخَيلُ عابِسَةٌ عَلى أَكتافِها","دُفَعٌ تَبُلُّ صُدورَها وَغُبارُ",77,"ر",1,0],["وَالخَيلُ تَعرِفُ مِن جَذيمَةَ أَنَّها","تَعدو بِكُلِّ سَمَيدَعٍ بُهلولِ",78,"ل",1,0],["وَالخَيلُ تَعلَمُ أَنَّنا فُرسانُها","وَالعاطِفونَ بِها وَراءَ المُسلَمِ",79,"م",1,0],["وَالخَيلُ تَنحَطُ بِالكُماةِ تَرى لَها","رَهَجَن بِكُلِّ مُجَرَّبٍ مِقدامِ",80,"م",1,0],["والخَصمُ يعجَزُ عن جِدالِك هيبةً","حتى يَنوبَ الشعرُ عنه مُجادِلا",81,"ل",2,0],["والخدودُ التي نُقِلْنَ من الوَر","دِ إلى عُصْفُريَّةِ التُّفَّاحِ",82,"ح",1,0],["والخيامَ المُسْتَقِلاَّتِ ضُحىً","بِظِباءٍ نزَحَتْ فيمن نزَح",83,"ح",1,0],["وَالخَيرُ أَمنَعُ جانِباً","مِن قِمَّةِ الجَبَلِ المَنيعَة",84,"ع",2,0],["وَالخَيرُ ما لَيسَ بِخافٍ هُوَ ال","مَعروفُ وَالشَرُّ هُوَ المُنكَرُ",85,"ر",1,0],["وَالخَيرُ مالٍ أَنتَ كاسِبُهُ","ما كانَ عِندَ اللَهِ مِن ذُخرِ",86,"ر",1,0],["وَالخَيرُ أَجمَعُ إِن صَحَّ الرِضى لَكَ في","ما يَصنَعُ اللَهُ لا ما يَصنَعُ الناسُ",87,"س",1,0],["وَالخَيرُ وَالشَرُّ في التَصويرُ بَينَهُما","لَو صُوِّرا لَكَ بَونٌ غَيرُ مُؤتَلِفِ",88,"ف",1,0],["وَالخَيرُ مَوعِدُهُ الجِنا","نُ وَظِلُّها وَرَحيقُها",89,"ق",3,0],["وَالخَلقُ كُلُّهُمُ كَذاكَ فَكُلُّ مَن","قَد ماتَ لَيسَ لَهُ عَلى حَيٍّ ذِمام",90,"م",1,0],["وَالخَلقُ يَقدُمُ بَعضُهُ بَعضاً يَقو","دُ الخَلفَ مِنهُ إِلى البِلى القُدّامُ",91,"م",1,0],["وَالخَلقُ مِن خَلقِ رَبّي قَد يُدَبِّرُهُ","كُلٌّ فَمُستَعبَدٌ وَاللَهُ مَولاهُ",92,"ا",2,0],["وَالخُطوبُ غافِلَةٌ","وَالرِفاقُ قَد حَضَروا",93,"ر",3,0],["والخَيالُ الذي تراءى وولَّى","غيرَ وانٍ كأنه ما تراءى",94,"ا",2,0],["والخير مدرار عليه وربه","جوعان محروم الرعاية صادِ",95,"د",1,0],["والخيال المطرق الرأس أنا","شدَّ ما بتنا على الضنك وبِت",96,"ت",1,0],["والخطّ مثل الرسم إن يوماً نأى","رسمي فللأثر العزيز تلفّتي",97,"ي",1,0],["والخطى المثقلات باليأس أغلا","ل لساقيك والمشيب عثار",98,"ر",1,0],["وَالخَيلُ سانِحَةٌ وَبارِحَةٌ","وَالمَوتُ يَغشى الشَرقَ وَالغَربا",99,"ب",2,0],["وَالخَطبُ أُمَّت مِنكَ أُمُّ دِماغِهِ","بِالقُلَّبِ الماضي الجَنانِ الحُوَّلِ",100,"ل",1,0],["وَالخَيلُ تَستَسقي الرِماحُ نُحورَها","مُستَكرَهاً كَعُصارَةِ الفِرصادِ",101,"د",1,0],["وَالخِصبِ مِن نَداهُ","وَالخِصبِ مِن جَنابِه",102,"ب",2,0],["وَالخَيرُ وَالشَّرُّ في الدُّنيا مُكافَأَةٌ","وَالنَّفسُ مَسؤولَةٌ عَن كُلِّ مُجتَرَمِ",103,"م",1,0],["وَالْخَيْلُ أَكْرَمُ صَاحِبٍ يَوْمَ الْوَغَى","وَالسِّلْم تَبْعَثُ غَارَةً وَرِهَانَا",104,"ن",2,0],["وَالْخَيْلُ وَاقِفَةٌ عَلَى أَرْسَانِهَا","لِطِرَادِ يَوْمِ كَرِيهَةٍ وَرِهَانِ",105,"ن",1,0],["والخضرُ قدْ كادَ يخافُ الردى","منهُ وأن يسكنَهُ قبرَهُ",106,"ر",2,0],["والخائفينَ اجتداعَ الفقرِ ما لَهُم","والمُفضلِينَ عليه جَدْعَ عِرنين",107,"ن",1,0],["وَالخَيلُ تَعثُرُ في شَبا شَوكِ القَنا","وَتَظَلُّ تَسبَحُ في الدَمِ المَوّارِ",108,"ر",1,0],["وَالخَيلُ تَفري جُيوبَ النَقعِ مِن حَرَبٍ","تَحتَ الكُماةِ وَتُذري أَدمُعَ الفَرَقِ",109,"ق",1,0],["وَالخَيلُ سَطرٌ بِالأَسِنَّةِ مُعجَمٌ","وَبِحَدِّ أَلسِنَةِ الظُبى مَشكولُ",110,"ل",1,0],["والخَصمُ لا يُعطيكَ مِن مَنزورِه","إلا إذا أَخذَ العَطاءَ جزيلا",111,"ل",2,0],["والخَلقُ ليس يَهابُهم في حرمةٍ","من لا يهابُ الواحدَ الخلّاقا",112,"ق",2,0],["وَالخالُ يَعبَقُ في صَحيفَةِ خَدِّهِ","مِسكاً خَلَعتُ النُسكَ عَن عَطّارِهِ",113,"ر",2,0],["وَالخَيلُ تَضجَرُ في المَرابِطِ حَسرَةً","أَلّا تَجوسُ خِلالَ رَهطِ الأَصفَرِ",114,"ر",1,0],["والخيلُ طَوْعُ كماتِها","في النَّقْعِ مُرْخاة العِنان",115,"ن",1,0],["وَالخِضرِمينَ المُخصِمي","نَ الأَطوَلينَ لَدى التَطاوُل",116,"ل",1,0],["وَالخَرُّ بَعدَ وُقوعِهِ","في الناسِ ذو وَثَباتِ",117,"ت",1,0],["والخَيْلُ تَسْبَحُ فِي الدِّماءِ وَتَتَّقِي","أَيْدِي الكُمَاة مِنَ النَّجِيعِ وُحُولا",118,"ل",2,0],["والخَيْلُ تَرْقُصُ زَهْواً بالكُماةِ وما","غيرَ السيوفِ بأيْديِهِمْ منادِيلُ",119,"ل",1,0],["والخيل لا تعتزى إلى بطل","سواه في ملت