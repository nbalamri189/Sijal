{"poems":[[95,"أمات أولئك الجند الكرام","https://www.aldiwan.net/poem11420.html","الوافر"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[276,"لي في نوالك يا مولاي آمال","https://www.aldiwan.net/poem52046.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48756","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49975","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128056","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204630",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100771","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5790,"كل كليل الذهن إن قدته","https://www.poetsgate.com/ViewPoem.aspx?id=111938",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""]],"verses":[["يُسَخِّرُ رَبُّكَ الدُّنْيَا لِفَانٍ","وَفِي الدُّنْيَا وَفِيهِ لَهُ مَرَامُ",0,"م",1,0],["يَسخَرُ قَلبي بِلَياليهِم","وَيَسخَرُ الدَهرُ بِأَيّامي",1,"ي",1,0],["يَسخو وَصَوبُ المُزنِ يَحبِسُ قَطرَهُ","عَنّا وَيَعدِلُ وَالزَمانُ يَجورُ",2,"ر",1,0],["يسخر من مبتئس قد ثوى","يرنو إلى الدنيا بعين الغروب",3,"ب",1,0],["يسخرُ من مبتسمات الشفاهْ","وجامدِ الدمع وسيَّالهِ",4,"ه",1,0],["يَسْخُو لَهَا بِكَثِيرِهِ وَقَلِيلِهِ","جَذِلاً وَلاَ يَشْكُو مِنَ الإِقْلاَلِ",5,"ل",1,0],["يُسَخِّرُ لِلَّخِلِّ المُدَاجِي أَمَانَهُ","فَإِذْ يَرْعَوِي المُغْرَى وَيَلْوِي عِنَانَهُ",6,"ه",1,0],["يس خاتم رسل اللَه كلهم","وَالصحب والآل ثم الصحب والآل",7,"ل",1,0],["يسخرن بالغر الذي يحكيك ما","دامت له بين الجيوب نقود",8,"د",1,0],["يسخرنا الباغي ويقذف بعضنا","ببعض ونعطيه السلاح ولا ندري",9,"ر",2,0],["يَسخو بمهجته ويُنفقُ مالَه","ويكون عن فعل العيوب فرارُهُ",10,"ر",2,0],["يسخو بما ملكت ندى نبي زانه","كرما ويرضى باليسير ويقنع",11,"ع",1,0],["يسخر من مكثى على بابه","وكمى المهدول مما به",12,"ه",1,0],["يسخو لها إن طاوعته وإن","سألته قوتاً ردها حسرى",13,"ر",2,0],["يسخر الغرُّ بالمليك ويزرى","جاهلُ القوم بالحكيم الامام",14,"م",1,0],["يَسْخُو فيَفْضح من بالجود مُتَّصفاً","فلو رأتْ كفَّه الأنواءُ لَمْ تكِف",15,"ف",1,0],["يسخِّر هذا ثم يسحب هذه","ويهرب منه البعض والبعض كفران",16,"ن",1,0],["يسخر بالعلم وأبنائه","وليس يستثنيك من سخره",17,"ر",2,0],["يسخو بما لم يسخ ذو كرم به","ابداً ويعتذر اعتذار المذنب",18,"ب",1,0],["يسخو ولم يفتح له راجٍ فَمًا","ويُرى إذا هو ما سخا جودًا كَمَن",19,"ن",1,0],["يسخو بكفك للهناءة مرفأ","والبِشرُ فى عينيكَ لا يتكنفُ",20,"ف",1,0],["يسخو البخيل عليها وهو مبتسمٌ","وليس يبكي كما تدري وينفطر",21,"ر",1,0],["يسخو الفتى في الوغى منهم ببهجتهِ","وما لأوطانه في السلم بذالُ",22,"ل",1,0],["يسخر بالسمر وما فعله","من فعلهم عندي بمستبعد",23,"د",1,0],["يسخو على أولاده كسحائبٍ","لا تنتهي يا رب منك منابعُهْ",24,"ع",2,0]]}