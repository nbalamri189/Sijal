,"البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136816",""],[4196,"","https://poetry.dctabudhabi.ae/diwan/poem/147617","السريع"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45110","المجتث"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83571","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28644","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4693,"نداء الى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=34476",""],[4693,"الشوق عند تمام الود قتال","https://www.poetsgate.com/ViewPoem.aspx?id=53309",""],[4755,"مُسافِرٌ قَلبي.. وجسمِي مُقِيمْ","https://www.poetsgate.com/ViewPoem.aspx?id=189737",""],[4927,"إياكِ أعني","https://www.poetsgate.com/ViewPoem.aspx?id=29616",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[4929,"لا تحسبِ الشعرَ نظماً أنت كاتبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203667",""],[4984,"لمن تُعزف النجوى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175545",""],[5138,"في شارع الحب سرت اسئل 2018","https://www.poetsgate.com/ViewPoem.aspx?id=195373",""],[5204,"لم تخل زرقاء من العيب","https://www.poetsgate.com/ViewPoem.aspx?id=200365",""],[5277,"الليلة الأولى قبل الألف","https://www.poetsgate.com/ViewPoem.aspx?id=186699",""],[5277,"المغاضبة","https://www.poetsgate.com/ViewPoem.aspx?id=191930",""],[5323,"حديث نفس","https://www.poetsgate.com/ViewPoem.aspx?id=207287",""],[5376,"مال الغبيط من الأهواء في المهج","https://www.poetsgate.com/ViewPoem.aspx?id=188318",""],[5376,"اتفنى بلادٌ وتحيا بلادُ","https://www.poetsgate.com/ViewPoem.aspx?id=200209",""],[5542,"مادلين اولبرايت","https://www.poetsgate.com/ViewPoem.aspx?id=10194",""],[5720,"ريمُ البَان ..","https://www.poetsgate.com/ViewPoem.aspx?id=199060",""],[5751,"لوزيّة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=214778",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[6070,"كَتبتُ قافيتي والسَّعدُ في حَدقي","https://www.poetsgate.com/ViewPoem.aspx?id=189053",""],[6142,"أنائحة مثلي على العرصة القفرا","https://www.poetsgate.com/ViewPoem.aspx?id=155746",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[6336,"العابسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73550&r=&rc=11",""],[6355,"واستنوق الجمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66559&r=&rc=19",""],[6355,"إرثُ والدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66638&r=&rc=98",""]],"verses":[["فَقُلتُ يا لَيتَهُ دامَت صَرامَتُهُ","ما كانَ أَرفَقُهُ عِندي وَأَحناهُ",0,"ا",2,0],["فَقُلتُ يا قَومُ هَذا","صُنعُ العَقوقِ الخَسيسِ",1,"س",1,0],["فَقُلتُ يا قَومُ إِنَّ في عمرٍ","مَعذِرَةً إِن سَمِعتُمُ عُذري",2,"ر",2,0],["فَقُلتُ يَمينَ اللَهِ أَبرَحُ قاعِد","وَلَو قَطَعوا رَأسي لَدَيكِ وَأَوصالي",3,"ل",2,0],["فقلت يا نيل حمل غير مطردٍ","ويا غمامُ تفضّل غير مطرود",4,"د",1,0],["فَقُلتُ يا رَبِّ فَصلَ صَيفٍ","في أَرضِ لُبنانَ أَو شِتاء",5,"ا",2,0],["فَقُلتُ يا ماجِدَها وَجَعدَها","لَو لَم تَكُ اِبنَ الشَمسِ كُنتَ رِئدَها",6,"د",3,0],["فقلتُ يا طولَ سروري به","قدْ صارَ أهلَ العقدِ والحلِّ",7,"ل",1,0],["فقلتُ يا قومُ انظروا واعجبوا","من أعورينِ اكتنفا أعمى",8,"م",2,0],["فَقُلت يا طَير كَذا عاجِلاً","قُمت عَلى اللذات تَنعاها",9,"ا",3,0],["فَقُلتُ يَسِيرٌ بَعضُ يَومٍ أَغيبُهُ","وَما بَعضُ يَومٍ غِبتِه بِيَسِيرِ",10,"ر",1,0],["فَقُلتُ يا نورَ عَيني","خَلَستَ عَقلِيَ خَلسا",11,"س",2,0],["فقلتُ يا من زها بلحيتهِ","الآن واللَهِ طبتَ للعمل",12,"ل",1,0],["فَقُلتُ يا صاحِ بِها حَيِّني","كِلني لِما بي لَستُ بِالمُرشَدِ",13,"د",1,0],["فَقُلتُ يا مُنيَتي وَيا سَكَني","ما في عِناقٍ وَقُبلَةٍ حَرَجُ",14,"ج",1,0],["فَقُلْتُ يا نُورَ عَيْنِي","مَا لِي عَلَى الصَّبْرِ قُدْرَهْ",15,"ر",2,0],["فَقُلتُ يا وَيحَكَ وَالوَيحُ لي","كَيفَ هَوى الكَوكَبُ وَاِنحَطّا",16,"ط",2,0],["فَقُلتُ يَمينَ اللَهِ أَبرَحُ قاعِداً","وَلَو قَطَعوا رَأسي لَدَيكِ وَأَوصالي",17,"ل",2,0],["فَقُلتُ يا شَيخُ أَما تَستَحي","تَسيكُ مَولاكَ بِلا حاجِبِ",18,"ب",1,0],["فقلتُ : يا منيتي ويا سكني","ما في عنا وقبلة ٍ حرج!",19,"ج",1,0],["فقُلْتُ يا لَيْتَه دامَتْ صَرامَتُه","ما كان أَرْفَقه عندي وأَحْتاهُ",20,"ا",2,0],["فقلتُ يا صاحِ جَفَّ زَيتي","فَباطلاً تجبُرُ السِّراج",21,"ج",1,0],["فقلت يا غصن دعني","بالله أقطف ورده",22,"ه",1,0],["فقلت يمنعني من أن أبوح به","قول المنزه قدوس وسبوح",23,"ح",1,0],["فَقُلْتُ يا مَنْ خَسِرْتُ آخِرَتي","فيهِ وَلَمْ يُغْنِ عَنِّيَ الْلَّوْمُ",24,"م",1,0],["فقلت يحظره معناه يمنعه","في عرف أهل الذكا والمنطق العربي",25,"ب",2,0],["فقلت يا شيخ أما تستحي","تنكر ما تأتي بمقار",26,"ر",1,0],["فَقلُتُ يَومٌ بِأَيّامٍ وَمَعرَكَةٌ","تُنبي لِما خَلفَها ما هَزهَزَ الوَرَقُ",27,"ق",1,0],["فقلت يا منتهى مناي","ومَن به كان إلتماسي",28,"س",2,0],["فَقُلتُ يا نَفسُ إِن تَهوي السُكونَ فَما","في الكَونِ حَزازاتٍ وَشحناءِ",29,"ا",2,0],["فقلتُ يا قَلبُ شمَّ هذا","لا بدَّ يوماً مِن أن تَطيرا",30,"ر",2,0],["فَقُلتُ يا قَوم انظُروا يوسُفَ ال","صِدِّيقَ لَمّا قُدَّ عَنهُ القَميص",31,"ص",1,0],["فَقُلتُ يا قَومُ عَلى رِسلِكُم","ما يَعِظُ الجاموسُ إِلّا البَقَر",32,"ر",1,0],["فَقُلتُ يا غايَةَ الآمالِ يَأموني","بِالسَعي نَحوَكَ لَاِستَبشَرتَ بِالظَفَرِ",33,"ر",1,0],["فقلتُ يا رُبّ بطءٍ خلفهُ ظفرٌ","وَالسحبُ أبطؤها في السيرِ أملؤها",34,"ا",3,0],["فقلت يا نفسي","لا قلب في صدري",35,"ي",1,0],["فَقُلتُ يا أَعوَرُ قَد","غَيَّبَني عَنكَ العَوَر",36,"ر",1,0],["فقلتُ يا بدرُ ما هذا الطُّروقُ لنا","ولا طريقَ أرى إلاّ وقد رُصِدا",37,"د",2,0],["فقلت يا نفس اثبتي تجلداً","ولا تبيني جزعاً عن جلدي",38,"د",2,0],["فقلتُ يا قومُ عنهُ معتذراً","لكي أقيمَ المعوجّ من أوَدِهْ",39,"د",2,0],["فقلت يا ليتني في نعش والدتي","حملت فهو عزيز القدر كالحمل",40,"ل",1,0],["فقلت يا حبذا فالنار في لهفي","فما أبالي إذا شبت بجثماني",41,"ن",2,0],["فقلت يا ليت عيسى كان ناظرها","قربي وكان لساني اليوم أو وتري",42,"ر",2,0],["فَقُلتُ يا مَولى العَقيلِيِّ أَجِب","عَبدَكَ في يَومِكَ ذا لَمّا طَلَب",43,"ب",1,0],["فقلت يكفي فهمنا","وأهل مكة أدرى",44,"ر",2,0],["فقلتُ يا نظرَتي بالحضرَةِ ابْتَهِجي","ويا زُلَيْخاءَ نفسي باللِّقا طِيبي",45,"ب",2,0],["فقلت يا بدر هذا","حقا خيال لحيني",46,"ي",1,0],["فَقُلت يَهنيك يا عَبد الرَحيم فعش","منعّماً في بَنيك السادة النُجُبا",47,"ب",2,0],["فَقُلت يا فَوز أَرّخ","خُورشيد دامَ مُناهُ",48,"ه",1,0],["فَقُلتُ يُعافيرَ الظِباءِ تَناوَلَت","نِياعَ غُصونِ الوَردِ مُهتَصِراتِ",49,"ت",1,0],["فقلتُ يا منتهى سؤلي ويا أملي","ومن رضاها إليّ القصْدُ والطّلبُ",50,"ب",1,0],["فقلت يا سيد السادات أجمعهم","ومن غدا راقياً مستقصي الرتب",51,"ب",1,0],["فقلت يكفيك فقد فاح من","شمامة العنبر ريح الشذا",52,"ذ",2,0],["فقلتُ يا عاذِلاً عن نورِ طلعتهِ","أما تَرى البدرَ يبدو في عقاربهِ",53,"ب",2,0],["فقلتُ يا غرُّ فهو من عملي","ما لكَ يا غرُّ مِنْ يدي مخلص",54,"ص",1,0],["فَقلت يا رب إني","لو اعتذرتُ مُعذرْ",55,"ر",1,0],["فقلتُ يا هذه زورى منزَّهةً","والسرُّ ما بيننا حتى الحسابِ خفي",56,"ف",2,0],["فَقلتُ يا صاحبي والسرب يَرشُقني","بِأسهمِ اللحظِ سربي نحو سربهمِ",57,"م",1,0],["فقُلْتُ يا طيبَ عيشِ صَبٍّ","جَنى الأقاحي مِنَ الأَقاحي",58,"ي",1,0],["فقلت يكفيك زرعاً","لا ترتجي فيه خَصبَا",59,"ب",2,0],["فقلت يا هندُ ليس العجز منقصة","وإن بالعجز قد قامت معاذيري",60,"ر",2,0],["فقلتُ يكفي مكانُ اللومِ مُطَّرِدٌ","فيه القَتيرُ بسَمرِ القَينِ مَشدودُ",61,"د",1,0],["فقلت يا سيدي ويا أملي","أظن ذا السرم منبني ثعل",62,"ل",1,0],["فقلت يا زهر يا طلاء خمر","يا ذكي نشر دست عطر",63,"ر",1,0],["فقلت يا منيتي الحمام أنبت في","جنان خدك ورداً يفتن الأمما",64,"م",2,0],["فقلت يا منيتي الأموال فانيةٌ","تزول والشعر باقٍ في القراطيس",65,"س",1,0],["فقلت يا روحي اسمحي بالتي","يطلبها الشيخ من الأمرد",66,"د",1,0],["فقلت يمين الله لم أذكر السوى","وحسبك تبريراً شواهد أفعالي",67,"ل",2,0],["فقلت يا سعد خبّر","عمّا وراءك ماذا",68,"ذ",2,0],["فقلت يسوق الشيب من قبل وقته","زوال نعيم أو فراق حبيبِ",69,"ب",1,0],["فقلت يا ولدي ابكي على رجل","كما أربيك للأيام رباني",70,"ن",2,0],["فقلتُ يا هندُ متى نلتقي","أعوذُ باللهِ من الصَّدّ",71,"د",1,0],["فقلت يا زمني إني به زَمِنٌ","وأنتَ والله لا تدري وأدريه",72,"ي",2,0],["فقلتُ يا رب أعني على","ما قلت لي فقال بالنصر",73,"ر",1,0],["فقلت يا ربّ أمّا العلمُ أقبله","والملك لستُ أراه فهو يخدعني",74,"ن",2,0],["فقلت يراه الختم فاشتّد قائلاً","إذا ما رآه الختم ليس يدوم",75,"م",1,0],["فقلت يا بدرِ إن الروح أبذلها","بغير من وان قاسيت اهوالا",76,"ل",2,0],["فقلت يا هذي كذا شأن الهوى","قالت كذا وما في منه أدق",77,"ق",1,0],["فقلت: يا غايتي ويا أملي","بل أنتم المؤمنون أخيار",78,"ر",1,0],["فقلت يا كاس أين سكرك","سكرى بمن قد هويت أغلب",79,"ب",1,0],["فقلت يا بدر لا تبتاس","من صبك الهائم الحيران",80,"ن",1,0],["فقلت: يا سيدي ويا سندي","ويا رجائي ومنتهى أملي",81,"ل",2,0],["فقلت يمين الله يا جارة الحمى","أنابك أمر في الحياة خطير",82,"ر",1,0],["فقلت يا شيخ لمن هذه","قال لابرهيم ذي الخله",83,"ل",2,0],["فقلت يداوى كل شيء بضده","وهذا التصابي للمشيب طبيب",84,"ب",1,0],["فَقُلتُ يا إبليسُ ماذا الذي","أسالَ من مُقْلَتِكَ العَبرَه",85,"ر",2,0],["فقُلتُ يا إبليسُ سافرْ بنا","وَطَوِّل الغَيبَةَ والسّفْرَه",85,"ر",2,0],["فقلت يا روحَ شعري","النظم للروح يعيي",86,"ي",1,0],["فقلت: يا زهرا ألا فارجعي","قالت: وهل يرجع من ماتا؟",87,"ت",2,0],["فقلت يا نور عيني","هواك أعظم علَّه",88,"ل",2,0],["فَقُلْتُ يا مَنْ بِكَفَّي","هِ عِيَشِتي وَمَماِتي",89,"ت",2,0],["فَقُلتُ يا ذا الغُمرِ","أَقصَرُ عَنِ التَعَتُّبِ",90,"ب",1,0],["فقلت يا ابن الحُره","إرث لما قد جل بي",90,"ي",1,0],["فقلت يا نفس ارجعي عنهم عسى","يصبح فينا فنفارق الأسى",91,"س",2,0],["فقلت يَا ناقتي والرَّحْلُ مُختضِب","من أَدمُعي مَا لهذا الحيِّ تِبيان",92,"ن",1,0],["فقلتُ يا نّفسي قفي وانظري","أعمى يُرينَا كيف تحلو الحياة",93,"ه",1,0],["فقلتُ يا مسكين ماذا جرَى","من أين هذي النار بعد الخمود",94,"د",1,0],["فَقُلتُ يا نِعَم رَأيٌ","لَو اِنَّهُ كانَ قابِل",95,"ل",1,0],["فقلت يا نور عيني","وكلّ ما أتمنى",96,"ن",2,0],["فقلت يا دار الرضى أَرّخي","فَرحمة اللَه عَلى عائشه",97,"ش",2,0],["فَقُلت يَعيش شبلاً في عَرينٍ","بعزِّ أَبيه في العليا يفاخر",98,"ر",1,0],["فقلت يا قوم خلّوا","فللكلام مواردْ",99,"د",1,0],["فقلت يا من أطال النصحَ وامتحضا","للعاشقين بأحكام الغرام رِضى",100,"ض",2,0],["فَقُلت يَكون من آسٍ عذارٌ","فَقال وَغرّةٌ من ياسمين",101,"ن",1,0],["فَقُلت يجود هذا الحُسنُ فينا","فَقال رَجَوتَ لَكُن مِن ضَنين",101,"ن",1,0],["فَقُلت يا قَوم ها نطقي وَها قَلَمي","كِلاهُما شاهِدي