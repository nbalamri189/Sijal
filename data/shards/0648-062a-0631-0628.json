{"poems":[[79,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[75,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[49,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[74,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[53,"يا سائلي عن مجمع اللذات","https://www.aldiwan.net/poem66780.html","الرجز"],[94,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[87,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[30,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[46,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[54,"يا رب جاري نهر فضي","https://www.aldiwan.net/poem26566.html","الرجز"],[54,"ولما دفنا جسمه في ترابه","https://www.aldiwan.net/poem26968.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[94,"أَتَفنى ابتساماتُ تَلك الجفونِ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14571&r=&rc=16",""],[147,"وتربة المرحوم والحاء جيم","https://www.aldiwan.net/poem11814.html","السريع"],[189,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[242,"لمطة فيها ما تحب النفوس","https://www.aldiwan.net/poem19714.html","السريع"],[276,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48698","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38268","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107203","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96724","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112780","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79456","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137867",""],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104964","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28598","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93946","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94275","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133227","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111442","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93753","الوافر"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35052","الوافر"],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5206,"لَمَّا طَمَى قامُوسُ سِحرِكَ فَايِرًا","https://www.poetsgate.com/ViewPoem.aspx?id=187423",""],[5273,"باب الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=59634",""],[5279,"مَاتَ الضَّمِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=184134",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[404,"دُمُوْعُ امرأةٍ من ميانْمارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191589",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[5776,"سرةٌ تبلعُ ذقنَ المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=199337",""],[5885,"البئر قد جف","https://www.poetsgate.com/ViewPoem.aspx?id=203025",""],[5943,"ويلاهُ يامسرى الرسول من الخنا","https://www.poetsgate.com/ViewPoem.aspx?id=45264",""],[5956,"‏ عصفور وعُشُّ الإلهام ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182118",""],[5956,"أتَى الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=183181",""],[5956,"العدل نِسْبيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=184126",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5997,"الليلة الدلماء","https://www.poetsgate.com/ViewPoem.aspx?id=214293",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[242,"لمطلة فيها ما تحب النفوس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563760",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[6213,"عودة النوارس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79432&r=&rc=71",""],[6320,"عَوْدَةُ الجَوَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84341&r=&rc=38",""]],"verses":[["وتَرْبِطُ بالأجْسامِ نفْساً حياتُها","مُبايِعَةُ الأجْسامِ بالجَوْهَرِ الرّاقِي",0,"ق",2,0],["وَتُربُكِ مَصبوحٌ وَغُصنُكِ نَشوانُ","وَأَرضُكِ تُكسى حينَ جَوُّكِ عُريانُ",1,"ن",1,0],["وَتُربَطُ في مَجالِسِنا المَذاكي","وَتَبرُكُ بَينَ أَرجُلِنا الرِكابُ",2,"ب",1,0],["وتربة يتلقَّى الحزن زائرها","كأنَّها تنبت التبريح والوَجلاَ",3,"ل",2,0],["وترِّب الأسطرَ بالملح ولا","تُكثر ولكن قَدَراً معدَّلا",4,"ل",2,0],["وتربَدُّ تِلْكََ الوُجوهُ الصِّباحُ","وفتنةُ ذاكَ الجمال الفَريدْ",5,"د",1,0],["وتربته وكل الخير فيها","ونسبته الشريفة للبراق",6,"ق",1,0],["وَتَربُقُ بِاللُؤمِ أَعناقَها","بِأَرباقِ لُؤمِهِمِ الأَتلَدِ",7,"د",1,0],["وَتَربُطُ جَأشاً وَالكُماةُ قُلوبُهُم","تَزَعزَعُ خَوفاً مِن سُيوفٍ تَتَزَعزَعُ",8,"ع",1,0],["وَتُربَةٍ ذاتِ ثَرىً وَضِيِّ","وَزَهَرٍ مُبتَسِمٍ رِبعِيِّ",9,"ي",1,0],["وَتُربَتَهُ سِرَّ الفُؤادِ وَكُلَّما","هَمَمتُ بِأَن أَنساهُ جَدَّدَ لي ذِكرا",10,"ر",2,0],["وتربي الطفل كي تقتله","ليت أحشاء النسا لم تحمل",11,"ل",1,0],["وتربدُّ تلكَ الوحوهُ الصًّباحُ","وكلٌّ إذا ما سألنا الحياة",12,"ه",1,0],["وَتُربَةِ المَرحومِ وَالحاءُ جيم","لَقَد ثَوى في النارِ مِنهُ رَجيم",13,"م",1,1],["وتُرْبٍ فيه من بِرَكٍ بقارٍ","سُبِكْنَ فسِلْنَ قُضْبا في المَجاري",14,"ر",2,0],["وتربّصوا فرص الزما","ن وقلة الجيش المكين",15,"ن",1,0],["وَتُرْبَتُهَا تُنْبِتُ مُجْلِي الضَّنَا","وَجَوُّهَا يُطْلِعُ مُسْلِي النُّفُوسْ",16,"س",1,0],["وَترب واديكم بنجد","مسك وَحصباؤه جمان",17,"ن",1,0],["وتربة لم يعد لها جلد","عليك أهبطتها إلى سحق",18,"ق",1,0],["وتربة أرضِك لا تسمحنَّ","بحمرائها للثرى الأسفعِ",19,"ع",1,0],["وتربصوا حتى يشد قناتكم","بعد العلوم من التجارب قيِّمُ",20,"م",1,0],["وَتُربَتُه مِسكٌ شَذيٌّ وَفَرشُهُ","سُرورٌ وَأَفراحٌ يُسالِمُها الدّهرُ",21,"ر",1,0],["وَتِربَيكَ مَن لَو لَم يَكُونا بِسَيِّدٍ","قدِ امتَزَجا لَم يُذكَرا حِينَ تُذكَرُ",22,"ر",1,0],["وَتربُ نعليهِ للأملاك منتشقٌ","وَبسطُ معناه للأملاك مُلتثمُ",23,"م",1,0],["وتربته الغرا فروضة جَنة","وملته الزهرا فاحصن جُنة",24,"ه",1,0],["وتُربُها قد ثار عن غلال","وعن جنى غض وعن ظلال",25,"ل",1,0],["وتربٌ بأنفاسِ الربيعِ معنبرٌ","فيا لكَ من طيبٍ ويا لكَ من نشْرِ",26,"ر",1,0],["وتربته في الربع ارخت نحوها","تذكره ساقي المنون فناداه",27,"ا",2,0],["وتربتها من طيبها إن شممتها","عبيرا وندا خالطا عنبرا وردا",28,"د",2,0],["وِترٌ به أدركت أوتار ما فعلت","بدرٌ ولم تكفهم ثأراً لها أُحُدٌ",29,"د",1,0],["وَتربٍ يَدَّعيهِ المِسكُ طِيباً","إِذا وَسَمَتهُ أَندِيَةُ الحَميمِ",30,"م",1,0],["وتربص بنا عواقب خير","وسل الصبر واطلب أفراغه",31,"غ",2,0],["وتربص بمن يعاديك هلكا","فبهلك العدى تنال انتصارك",32,"ك",1,0],["وتربة الكوردي جبريل الهمام","عند الخراسان وذا حبرٌ إمام",33,"م",1,0],["وتربة العلواني اورطه تبه","الحسن الفاضل طابت تربه",33,"ه",1,0],["وتربة الجبيل مثوى الساده","وروضة الانوار والشهاده",33,"ه",1,0],["وتربةٍ لك بالأوطان قائمةٍ","في ظل كل رطيب العود ميالِ",34,"ل",1,0],["وترب طيبة للمجدوم عافية","وكم به العين صحت وهى رمداء",35,"ا",2,0],["وتَرِب المرءُ تريد افتقرا","وأَترب استغنى وصار مكثِرا",36,"ر",2,0],["وتَرَبَّصا حتَّى عَلى الأَعدا يَكُرُّ","سِوَاهُما بِسَرِيَّةٍ خَرساءِ",37,"ا",2,0],["وَتربية البلاد دليل فضل","وَعُنوان على شَرف الخلال",38,"ل",1,0],["وَتَربطها بِها مِن غيرِ سلكٍ","وَتنطقها عَلى رَغمِ الجمودِ",39,"د",1,0],["وتربصتْ كل المزالق حولنا","هوجاءَ جُنَّ سعيرُها المتعجرفُ",40,"ف",1,0],["وَتَرَبَّعَتْ فَوقَ السّماءِ فَريدةً","بيدٍ تُشيرُ ولا قَرارَ لِثانِ",41,"ن",1,0],["وتربعتْ فوقَ القريضِ جماعةٌ","ولدى الخليلِ عن السواعدِ شمروا",42,"ر",3,0],["وَتَرَبَّلَت فَتبَسَّمَت أشجَارُهَا","وَتَحَدَّرَت أغصَانُهُنَّ تَحْدُّرا",43,"ر",2,0],["وتَرَبّعَ الصَّمتُ البليغُ","على ثوانٍ مِتْنَ نَزْفا",44,"ف",2,0],["وَتَرَبَّعَتْ وَسَطَ الضِّعَافِ كَسِيرةً","وَتَرَقَّبَتْ نَصْرًا مِنَ الجَبَّارِ",45,"ر",1,0],["وتربو به أكناف نفسي وتنتشي","فينداح من بين التخوم سبيل",46,"ل",1,0],["وتربصُوا حتى المساجدُ أحرقتْ","نسْلٌ ل(بوذا) قتلَ الأحلاما",47,"م",2,0],["( وَ ) تُرْبُ نَعْلَيْهِ لِلأَمْلاكِ مُنْتَشَقٌ","وَبُسْطُ مَغْناهُ لِلأَمْلاكِ مُلْتَثَمُ",48,"م",1,0],["وَتَربطُ نَحرَ السّماءِ برمشٍ","لِخَنْقِ الضّياءِ يُطِيلُ التذاذا",49,"ذ",2,0],["وتربح البيع وتحيي الغنى","والسوق كانت قلبها كاسدة",50,"د",2,0],["وتربَّعَ الأسيادُ فوقَ عروشِهمْ","واستَبدلوا الكفرانَ بالإيمانِ",51,"ن",1,0],["وتربَّعتْ في العُشّ تسكن في العُلا","يأتي لها العصفور حاملُ ريشِهِ",52,"ش",2,0],["وتربّصتْ جهمُ الجَهام على الفضا","مثل القضا متربِّصاً يختارُ",53,"ر",1,0],["وتربية الصحابة مثل بِذْرٍ","بِتُرْبِ القلب بالإيمان شبّا",54,"ب",2,0],["وتربيةُ البنين بدون حقد","ولا حسدٍ سلامٌ للقلوبِ",55,"ب",1,0],["وتربصَ السِفرُ الموشى دمعةّ","ذرفتْ بجوفِ الليلةِ الدلماءِ",56,"م",3,0],["وترْبٌ كأن الله علّمهُ الْوَفَا","فما شحّ في مصرٍٍ مدى الدهر مسْرب",57,"ب",1,0],["وَتُربِها يُنبِتُ مُجلى الضَنا","وَجَوُّها يُطلِعُ مُسلى النُفوسِ",58,"س",1,0],["وتربّعتْ فوق الغصون بلابلٌ","سالتْ على أكمامها الألحان",59,"ن",1,0],["وتربعي فوق العروش وغردي","واستلهبي الإحساسَ والإدراكا",60,"ك",2,0],["وَتَرَبَّصَ الأَوْغَادُ قُرْبَ عَرِينِهِ","لِلسَّمْعِ مُسْتَرِقِينَ يَخْنُقُهُمْ صَدَاهْ",61,"ا",2,0]]}