{"poems":[[95,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[90,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[53,"برضاب ثغرك يستغيث","https://www.aldiwan.net/poem9236.html","مجزوء الكامل"],[93,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[107,"مدوا السواعد وارفعوا الأبصارا","https://www.aldiwan.net/poem43075.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[93,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[232,"يا من هواه أعزه وأذلني","https://www.aldiwan.net/poem34055.html","عموديه"],[242,"عاهدونا على الوفاء فخانوا","https://www.aldiwan.net/poem19099.html","الخفيف"],[276,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[341,"بنيت طاعتي باتباع","https://www.aldiwan.net/poem67803.html","عموديه"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[371,"يا من سفكت دمائي في الدموع له","https://www.aldiwan.net/poem17015.html","البسيط"],[376,"أخفيت عزمك للفراق فما خفي","https://www.aldiwan.net/poem57294.html","الكامل"],[382,"من مشرق العين أو من مغرب الدمع","https://www.aldiwan.net/poem59339.html","البسيط"],[382,"حي الديار ديار جلق واستزِد","https://www.aldiwan.net/poem66875.html","الكامل"],[415,"يا ثانيا للنفس وهو","https://www.aldiwan.net/poem32283.html","مجزوء الكامل"],[435,"من الصبابة تثني القد نيروز","https://www.aldiwan.net/poem40501.html","البسيط"],[438,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[449,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[457,"مالي أطارح نحو أسود صادح","https://www.aldiwan.net/poem13692.html","الكامل"],[484,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[591,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101540","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86981","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48745","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64073","الخفيف"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111289","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109185","الكامل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205467","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108595","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125458","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108430","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17422","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202712","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204954","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112359","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126982","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61275","السريع"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202260","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91766","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91459","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91136","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205658","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133308","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102933","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69972","البسيط"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22100","الخفيف"],[4209,"","https://poetry.dctabudhabi.ae/diwan/poem/105541","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136596",""],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198227","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133133","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120233","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120343","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120268","البسيط"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4858,"في ذكرى الإسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=29825",""],[4908,"همس المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=207332",""],[3271,"زفرة على فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=131018",""],[5092,"لا لون يجمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=177261",""],[5205,"ملك محاسنه جنوده","https://www.poetsgate.com/ViewPoem.aspx?id=121000",""],[5281,"موكب العظماء","https://www.poetsgate.com/ViewPoem.aspx?id=199663",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5409,"أرسلوها في الفضا قبا مهارا","https://www.poetsgate.com/ViewPoem.aspx?id=155278",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5431,"نظرةٌ تُحيي تُذيب","https://www.poetsgate.com/ViewPoem.aspx?id=183475",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5628,"ماذا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=178673",""],[5725,"قولي لعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=190886",""],[5732,"ينام منهو مايعرف الهمومي","https://www.poetsgate.com/ViewPoem.aspx?id=177856",""],[402,"ما سنى شعلة إلى الشمس تهدى","https://www.poetsgate.com/ViewPoem.aspx?id=35416",""],[5937,"بريئة","https://www.poetsgate.com/ViewPoem.aspx?id=211895",""],[5956,"لله درُّك يا ابنَ الفيصل الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=204197",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6093,"نجوى","https://www.poetsgate.com/ViewPoem.aspx?id=180396",""],[6102,"مُراوَحَةٌ بِانتِظارِ المَوتِ...","https://www.poetsgate.com/ViewPoem.aspx?id=186294",""],[6152,"ليل حزين بدونكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203134",""],[6152,"عيونكِ ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=203709",""],[6213,"عهدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76274&r=&rc=31",""]],"verses":[["عَاهَدَتْهُ فَوَائِحُ المَجْدِ هْداً","وَعَلَى الإِثْرِ أَخْلَفَتْهُ الْخَوَاتِمْ",0,"م",1,0],["عاهدت نفسيَ والأيام شاهدة","أن لا أقِرَّ على جَوْر السلاطين",1,"ن",1,0],["عاهدتَهُ أن لا تخو","نَ فما لعهدِك قد نكثتَهْ",2,"ه",1,0],["عاهَدتُهُ أَن لا أُثيرَ شُجونُهُ","أَو يَستَثيرَ كَوامِنَ الأَشجانِ",3,"ن",1,0],["عاهدوه على الوفاء فما كا","ن هناك العهد البريم وثيقا",4,"ق",2,0],["عاهَدتَ مِصرَ عَلى الوَفاءِ فَكَبَّرَت","لَمّا رَأَت أَبناءَها الأَبرارا",5,"ر",2,0],["عاهدهم فأخلفوه الموثقا","وركبوا الغدر الوبيل الموبقا",6,"ق",2,0],["عَاهِلٌ مُفْرَدٌ صَلاَحاً وَإِصْ","لاَحاً وَعَدْلاً وَصِدقَ عَزْمٍ وَرِفْدَا",7,"د",2,0],["عَاهدَ فِيهِ الصَّفَاءُ ذَا كَلَفٍ","جَارَى مُنَاهُ وَشَاوَرَ النُّبْلاَ",8,"ل",2,0],["عاهَدتِني أَن تَحفَظي لِيَ الهَوى","فَقَد بَدا لي مِنكِ تَضييعُ",9,"ع",1,0],["عاهدته أن لا أثير شجونه","أو يستير كوامن الأشجان",10,"ن",1,0],["عا هدتهم ألاَّ فراق وإنما","عاهدت كالحرباء في التلوين",11,"ن",1,0],["عاهدوهُ فَما رَأَينا وَلَم نَس","مَع بِقومٍ هم مثلهم أوفياءُ",12,"ا",2,0],["عاهدَ القومَ صابِراً لشروطٍ","هيَ صَبرٌ والصبرُ فيه الشفاءُ",12,"ا",2,0],["عاهدته على الزواج فلم تهو","سواه وما أحبّ سواها",13,"ا",3,0],["عاهدتني أن لا تميل عن الهوى","وحلفت لي يا غصن أن لا تنثني",14,"ن",2,0],["عَاهَدُونَا عَلَى الْوَفَاءِ فَخَانُوا","فَكَأنَّا عَلَى الْخِلاَفِ اصْطَحَبْنَا",15,"ن",2,1],["عاهدوا الربع وَلوعا وَغَراما","فَوفوا للربع بالدَمع ذماما",16,"م",2,1],["عاهدتُ نفسيَ مذْ صعَّرتُ خديَ أَنْ","لا يستبينَ به نحو امرئٍ ضرع",17,"ع",1,0],["عاهدت ربي على العباده","بسنة المختارخيرالساده",18,"ه",1,0],["عاهدته أيضاعلى ترك ابتداع","مستهترًالوجهه قصد اتباع",18,"ع",1,0],["عاهدْتَ أنَّك يا فُؤا","دي في الجوانحِ تَستَقِرّ",19,"ر",1,0],["عاهَدتُمُ وَتَناسَيتُم عُهودَكُمُ","فَاللَهُ عاهَدَ قِدماً آدَماً فَنَسي",20,"س",2,0],["عاهَدتَني لا خنتَني فكأنَّما","عاهَدتَني في العَهدِ إِنَّكَ لا تَفِي",21,"ف",2,0],["عاهدت ربي بها والعهد صيرني","بالصبر والنسك والأحزان ذا سمع",22,"ع",1,0],["عاهدت أنواءَ العهاد بربعها","أن لا يحول عن العهود عِهادي",23,"د",2,0],["عاهدتُه ألاّ تُضَع","ضِعَه النّوى وأَراهُ ناكِثْ",24,"ث",1,0],["عاهدتها لا أرى عن حبها بدلاً","وذلك العهد بالأحشاءِ مكنوزُ",25,"ز",1,0],["عاهَدْتُ فيكَ ضَمِيرِي عَهْدَ ذِي ثِقَةٍ","لو نازَعَتْهُ المَنَايَا فيهِ لم يَخُنِ",26,"ن",1,0],["عاهدتني على الوفا بعض عام","بعدما عمت في بحار هواها",27,"ا",3,0],["عاهدته أن لا يزال مساجلي","شكوى عقابيل الجوى ومناوحي",28,"ح",2,0],["عاهدتني أن لا تصد وإن بدت","مني على عمد إليك ذنوب",29,"ب",1,0],["عاهدت دمعي أن يقر فخانني","قلب لسائله الهموم قرار",30,"ر",1,0],["عَاهَدْتني أَنْ لا تَخُونَ وَلُمْتَ في","طَلبي وَفاءَكَ بالعُهُودِ وَلَمْ تَفِ",31,"ف",1,0],["عاهدِتِني ونكثتِ عهدكِ اربعاً","ويل الفؤاد من الحبيب وكذبهِ",32,"ب",2,0],["عاهَدتها بَعد الجَفا بمودّة","فَدَفعت عَنها بِالوَفاء صُروفا",33,"ف",2,0],["عاهد اللّه أن يعود إليها","ولقد كان وافيا بالعهود",34,"د",1,0],["عاهدتم القوم أحراراً ومثلهم","منزه العهد عن عقد وتقييد",35,"د",1,0],["عاهدَ المجدُ منك إذ عاهدَ المج","دُ وفياً بالعهدِ والميثاق",36,"ق",1,0],["عاهدتنا ولم تزل موفياً","حاشا وكلا منك نقض العهود",37,"د",1,0],["عاهدتها إن استهيم بها","ومثلي من يفي",38,"ف",2,0],["عاهد الدّهر على أن لم يزل","مذكيا في مصر للحزن أوارا",39,"ر",2,0],["عاهلٌ شيَّد الممالك بالعد","ل وبالصارم السنين المؤيد",40,"د",1,0],["عاهِدَاها على يمينِ وفائي","يا نسيمَ الصَّبا وطيفَ الأماني",41,"ن",2,0],["عاهدتموني على حفظ الوداد فما","طال الوداد كأن العهد ما كانا",42,"ن",2,0],["عاهِدوهُ وَوَحِّدوهُ وَلا تَس","تَقبِلوا غَيرَ وَجهِهِ بِالسُجودِ",43,"د",1,0],["عاهَدتُهُ لَدَى الرَّوَاحِ عُهُوداً","وَعُهُودُ المِلاحِ نَارُ الحُباحِ",44,"ح",1,0],["عَاهَدَت زَوجَها وَقَد قالَ إِنّي","سَوفَ أَغدو لِحاجَتي وَلِدَيني",45,"ن",2,1],["عاهدوا الربع ولوعاً وغراما","وهواناً في هواهم وهياما",46,"م",2,1],["عاهدني على الوفا وأخلفا","لكنْ له قلبي بلا عهد وفى",47,"ف",2,0],["عاهدتني أن يكون الوصل متصلاً","طال البعاد فهل تأتي بأعذار",48,"ر",1,0],["عاهدتني يا قلبُ تسلو الهوى","يا كارهَ السلوانِ أين العهود",49,"د",1,0],["عاهَدونا عَلى الجَلاء وَآلوا","أن يراعوا اليَهود آناً فآنا",50,"ن",2,0],["عاهدتني ان لا تخون","فخنتني ونقضت عهدي",51,"د",2,0],["عاهدنا أَنهُ يوافي","وافي لِعَهدِهِ",52,"ه",1,0],["عاهدت ربي وأنا موف عهده","أيام أحفر وبني وحده",53,"د",2,1],["عاهدتهم أَرجو الوَفا","وَضمنت ذاكَ فَما وَفوا",54,"ف",3,0],["عاهدت نَفسي عَلى صَبري فَما حفظت","عَهدي فحلّ بِها تنكيلُ من نكثا",55,"ث",2,0],["عاهَدت أخلاقي عَلى حفظِ الوَفا","حَتّى حَفظت وَداد غَير الحافظِ",56,"ظ",1,1],["عاهدت هذا الصيف لستُ بواهبٍ","سمعي سواك، فهل تراك معاهدي",57,"د",2,0],["عاهدتنا تحرير مصر وأهلها","هلا وفيت فإن شيمتك الوفا",58,"ف",2,0],["عاهدتني وأخال عهدك صادقا","ما في خلال الروض لمع سراب",59,"ب",1,0],["عاهدت جزين عَهداً لَيسَ تفسخهُ","وَلا اللَيالي وَلا الأَيام تنسخهُ",60,"ه",1,0],["عاهدتَها بالعَودِ إن شاء الذي","بسخائه في منحه أعطاكَ",61,"ك",1,0],["عَاهَد اللَهَ إِن نَجا مِلمَنايا","ليَعودَنَّ بَعدَها حُرميّا",62,