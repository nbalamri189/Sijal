{"poems":[[4,"عفا الرسم أم لا بعد حول تجرما","https://www.aldiwan.net/poem21202.html","الطويل"],[23,"ما سارق الدرعين إن كنت ذاكرا","https://www.aldiwan.net/poem21267.html","الطويل"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[31,"ألا يا اسلمي يا أم بشر على الهجر","https://www.aldiwan.net/poem6070.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[164,"في الله سبحانه عمن مضى خلف","https://www.aldiwan.net/poem58711.html","البسيط"],[186,"هذا الغريب الذي أبكى دمشق وقد","https://www.aldiwan.net/poem66972.html","البسيط"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[266,"حلا بك الدهر وازدانت علا حلب","https://www.aldiwan.net/poem38367.html","البسيط"],[309,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[376,"بعين الله هجرك لا بعيني","https://www.aldiwan.net/poem57100.html","الوافر"],[416,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143283","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63722","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108842","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49612","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53047","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27664","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121192","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100897","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107513","الطويل"],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""]],"verses":[["فَإِن تَذكُروا حُسنَ الفُروضِ فَإِنَّنا","أَبَأنا بِأَنواحِ القُرَيطَينِ مَأتَما",0,"م",2,0],["فَإِن تَذكُروا كَعباً إِذا ما نُسيتُمُ","فَهَل مِن أَديمٍ لَيسَ فيهِ أَكارِعُه",1,"ع",2,0],["فَإِن تَذكَروا قَتلى وَحَمزَةُ فيهِمُ","قَتيلٌ ثَوى لِلَّهِ وَهوَ مُطيعُ",2,"ع",1,0],["فأنتَ ذو النورين من ذا وذا","عليّه أم أنتَ عثمانه",3,"ن",2,0],["فَإِن تَذكُروها في مَعَدٍّ فَإِنَّما","أَصابَكَ بِالثَرثارِ راغِيَةُ البَكرِ",4,"ر",1,0],["فإِن تذكر الأوطانَ والأهلَ عندها","فما مصرُ إلَّا موطنٌ لكَ ثاني",5,"ن",2,0],["فإن تذركت أياما مضين فقلْ","في الله سبحانه عمن مضى خلفُ",6,"ف",1,0],["فَإِن تَذر تِربَهُ يا مَن يُؤرِّخُهُ","أَكتب دَعا اللَهُ إِبراهيمَ فَاِمتَثَلا",7,"ل",2,0],["فَأَنتَ ذُخري وَأَرى أَنَّني","أَحوَجُ ما كُنتُ إِلى ذُخرُ",8,"ر",1,0],["فأنت ذو همة تعلو وتدأب في","علو من حطه من دهر الأدب",9,"ب",1,0],["فأنت ذو الوجه والجاه الوسيع لدى ال","رب الكريم عظيم الجواد والقدر",10,"ر",1,0],["فإن تَذهَب فأنتَ إذاً طَليقٌ","لطَلقِ الوَجهِ طَلقِ الرَّاحتَينِ",11,"ن",1,0],["فَإِن تَذهَب فَرُبَّ رِعالِ خَيلٍ","عَوابِسَ قَد كَفَفتَ بِها رِعالا",12,"ل",2,0],["فإنّ تذاهيبَهُ تذهبُ","وشيطانَ وجهكَ لا يذهبُ",13,"ب",1,0],["فأنت ذُخريَ في عُسْرِي وَمَيْسَرتي","وذخرُ مَنْ له مِنَ دَهْرِهِ ذُخْرُ",14,"ر",1,0],["فأنت ذو الفضل والعدل الذي افتخرت","به الولاة ووالت شكره العلما",15,"م",2,0],["فإن تذهبِ الشّعْرى العبورُ لشانها","فإن الغُميصا في بَقِيّةِ شان",16,"ن",1,0],["فأنت ذاك الذي تسري عزائمه","إلى أعاديه مسرى الأنجم الشهب",17,"ب",1,0],["فأنتَ ذو لؤم طبع لستَ ذا كرمٍ","لو كنت ذا كرمٍ ما كنت ذا فَرَق",18,"ق",1,0],["فأنت ذو عرجاء ان سابقت","خيل تلاميذ لنا تسبق",19,"ق",1,0],["فإِن تذكَّرتُ أيامى التي سلفت","كادت دموعَى فى الأشعارِ تنتظم",20,"م",1,0],["فان تذكريني بعد موتي فصورتي","تلبي كما شاءَ الوفا وتعبرُ",21,"ر",1,0],["فإنْ تذبح الحلاج فارفق بقلبه","توضأ بماء الروح والنفس متلفة",22,"ف",2,0],["فَإِن تَذكُرِي- يَومًا - فَقُولِي: ( ظَلَمتُهُ )","فَقَد بِعتِنِي- ظُلمًا - مَبِيعَ القَوالِيا",23,"ل",3,0]]}