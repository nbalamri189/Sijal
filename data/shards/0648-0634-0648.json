ها الغادي على ظهر ضامر","https://www.poetsgate.com/ViewPoem.aspx?id=128842",""],[5344,"حٌب وطيش ..","https://www.poetsgate.com/ViewPoem.aspx?id=155073",""],[5376,"لنا في الخنا طَرْفٌ من الذلِّ مرتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199640",""],[5431,"وعند الوصل..ترويني","https://www.poetsgate.com/ViewPoem.aspx?id=183131",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"أحبك....أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=199836",""],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5431,"خيانة الأوراق...","https://www.poetsgate.com/ViewPoem.aspx?id=202740",""],[5436,"غزل عراقي (محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=61666",""],[5461,"أنا والصحاري","https://www.poetsgate.com/ViewPoem.aspx?id=8534",""],[5463,"آمر تبي إثبات خذ هذي تنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=32377",""],[5463,"وينك عذولي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=34271",""],[5463,"جيتي فجأة تتركيني","https://www.poetsgate.com/ViewPoem.aspx?id=35642",""],[5545,"أهواكَ مُلهَمةً","https://www.poetsgate.com/ViewPoem.aspx?id=185001",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5791,"حيود في نسق المحبرة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208644",""],[5848,"أنا اقصد حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=52026",""],[5875,"شيّب المهاريف","https://www.poetsgate.com/ViewPoem.aspx?id=187017",""],[5881,"يا طارق الباب","https://www.poetsgate.com/ViewPoem.aspx?id=183866",""],[5909,"إليك قراري","https://www.poetsgate.com/ViewPoem.aspx?id=210234",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""],[5957,"فطيفك دوما لقلبي الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=176810",""],[6008,"يراعي الجمس","https://www.poetsgate.com/ViewPoem.aspx?id=60994",""],[6031,"سَلاَمٌ يُغَادِي جَوَّكُمْ ويُرَاوحُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46306",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6056,"غريزة غلاك","https://www.poetsgate.com/ViewPoem.aspx?id=130521",""],[6070,"ماذا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=187868",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6125,"سَحيقٌ في حناياهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210596",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6166,"رسالة من المدينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7281&r=&rc=1",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6225,"تلعثم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80962&r=&rc=231",""],[6225,"الحج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81096&r=&rc=290",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""]],"verses":[["وَشَوكَةِ ضِغنٍ ما اِنتَقَشتُ شَباتَها","ذَهاباً بِنَفسي أَن يُقالَ عَجولُ",0,"ل",1,0],["وشَوقي حَليمٌ غَيْرَ أنّ صَبابَةً","تُسَفِّهُ حِلْمَ الوامِقِ المُتَحرِّجِ",1,"ج",1,0],["وَشُوسٌ في الذّوائِبِ مِنْ قُرَيْشٍ","ذوو النّخَواتِ والغُرَرِ الحِسانِ",2,"ن",1,0],["وَشَوقِ عَلوقٍ تَناسَيتُهُ","بِجَوّالَةٍ تَستَخِفُّ الضِفارا",3,"ر",2,0],["وَشَوقي إِذا اِستَيقَنتُ أَن قَد تَخَيَّلَت","لِبَينِ نَوى أَسماءُ بَعضَ اِختِيالِها",4,"ل",3,0],["وَشَوهاءَ تَعدو بي إِلى صارِخِ الوَغى","بِمُستَلئِمٍ مِثلِ البَعيرِ المُدَجَّلِ",5,"ل",1,0],["وشويرب أخضر رقيق","ووره ربط من شقيق",6,"ق",1,0],["وشِواءً تتغدّى","وهو من غير غداء",7,"ا",2,0],["وَشَوْا فعرَفنا للتجافي مرارةً","وهبنا لها مهما أتيناه من ذنبِ",8,"ب",1,0],["وَشَوقٍ كَالتَوَقُّدِ في فُؤادِ","كَجَمرٍ في جَوانِحَ كَالمِحاشِ",9,"ش",1,0],["وشوقاً أكافحُهُ باللَّوى","مكافحةَ القِرنِ تحتَ اللِّواءِ",10,"ا",2,0],["وشَوادٍ شَدَت فَلَولا اشتِهاري","نُحْتُ من شدوها بِكُلِّ شَهيقِ",11,"ق",1,0],["وشوقي إلى أنوارِ مشهدِ يوشعٍ","تشوُّقُ مَنْ ضاقَتْ بهِ سعةُ الفضا",12,"ض",2,0],["وَشوسٌ شِدادُ البَأسِ مِن آلِ يافِثٍ","تَخوضُ دَمَ الأَبطالِ وَالبَأسُ جاحِمُ",13,"م",1,0],["وَشَوَّذَت شَمسُهُم إِذا طَلَعَت","بِالجِلبِ هِفَّاً كَأَنَّهُ الكَتَمُ",14,"م",1,0],["وَشَوكَتانِ خُصَّتا بِالحَدِّ","كَأَنَّما كَفّاهُ عِندَ الوَخدِ",15,"د",1,0],["وَشَوقي في الصَباحِ إِلى سُلَيمى","أَتاني حُبُّها مِن كُلِّ بابِ",16,"ب",1,0],["وشواطئٌ محجوبةٌ شارفتَها","فوق العواصف والخضمِّ الهادرِ",17,"ر",1,0],["وشواردٌ هزَّ النجومَ رويُّها","والكونُ مصغٍ والشعاعُ يُصفِّقُ",18,"ق",1,0],["وَشَوْقٌ كَنَصْلِ السَّيْفِ لَوْ شِمْتُ حَدَّهُ","عَلَى بَطَلٍ لانْقَدَّ مِنْهُ الْمُقَنَّعُ",19,"ع",1,0],["وشواظُها قَبَسٌ يُضِ","ئُ لنا المسالِكَ في الدَّيَاجر",20,"ر",1,0],["وشوق مفتون إلى فتنه","ووجد مسحور إلى ساحر",21,"ر",1,0],["وشوق الرحيق بصدر الكروم","إلى الكأس والثلج في كلّ باب",22,"ب",1,0],["وَشْوَشة ُ البَحْراتِ.. مسموعة ٌ","من مقعدي، وضجَّة ُ الأنهُر ِ",23,"ر",1,0],["وشوشنا تلويح برق أهاجنا","وولّى ولا ندري الى أين لوّحا",24,"ح",2,0],["وَشَوق كَمين في الجَوانح هاجهُ","بَعيدَ التَنائي الظاعِنون وَساروا",25,"ر",3,0],["وشؤون الأيام والطي والنش","ر ودور الإيراد والإصدار",26,"ر",1,0],["وشوقي للهوى العذري","واريناه في هوة",27,"و",2,0],["وشوقٌ وبَلْبالٌ وفِكْرٌ ولوعةٌ","ونارٌ من الهجران في القلبِ تقدح",28,"ح",1,0],["وشولةُ قد تبدو برابع عشرِه","بِسَبع وعشرين النعائمُ تُبصَرُ",29,"ر",1,0],["وشواردٌ في القول قد","قُرِنتْ بها السَّبْع الشِّدادُ",30,"د",1,0],["وَشَوهاءَ لَم توشَم يَداها وَلَم تُذَل","فَقاظَت وَفيها بِالوَليدِ تَقاذُفُ",31,"ف",1,0],["وَشَوقي إِلَيهِ ما بَقيتُ مؤرّثُ","لَقَد نالَ ما يَبغي وَفازَت قِداحُهُ",32,"ه",1,0],["وشؤون الأنام مذ خلقوا","بين أخذ القضاء والرد",33,"د",1,0],["وشوقي عظيم ولكن نفسي","تسوم بكل عظيم رضاك",34,"ك",1,0],["وَشَوقي إِلى وعد وان لَم يُجد بِهِ","وان كانَ لا يَشتاق شيءٌ مِن الكذبِ",35,"ب",1,0],["وَشَوَّسَ طُرَّةَ حَوذانِها","نَسيمُ النُعامى فَأَبدى شَذاها",36,"ا",3,0],["وَشَوقٌ كَأَطرافِ الأَسِنَّةِ في الحَشا","لَهُنَّ كُلومٌ لَم تُعالَج بِمَرهَمِ",37,"م",1,0],["وشوامخ وبواذخ ورواسخ","في العلم والتقوى بأفضل موضع",38,"ع",1,0],["وشوش العين والوسن","وكدر الشرب والورود",39,"د",1,0],["وَشوساً ذاتَ ألحاظٍ تلظّى","مُحددةً وَوجهاً مكفهرّا",40,"ر",2,0],["وَشوهٌ كَأَمثالِ السَبائِجِ أُبَّدٌ","لَها مِن نِتاجِ البيضِ في الرَوضِ دَردَقُ",41,"ق",1,0],["وشؤون وشجون","ويقين وارتياب",42,"ب",1,0],["وَشَوَّقه سَجع الحَمائم لِلحِمى","فَأَوصى بِهِ أَوصابه في الهَوى العذري",43,"ر",2,0],["وشَوْقٌ نحَرتُ له مُقْلتي","بُكاءً لأنْ عادَني منه عِيد",44,"د",1,0],["وَشَوارد مثل الزُلال سلاسةً","تَأبى بِأَن تَنقاد لِلنُقادِ",45,"د",1,0],["وشوقٍ أَضرَّ القلب لا صبر عنده","ويَعْلَم أنَّ الصَّبرَ أجلبُ للنفع",46,"ع",1,0],["وشوَّقني لِظِباءِ الحمى","فأَسْقَمَني والهوى يُسْقِمُ",47,"م",1,0],["وشوَّشني لما بدا بقدومِه","ولم أرَ لي أمراً لذاك مرتّبا",48,"ب",2,0],["وشوَّقني معالم كنتُ فيها","بأنعم طيبِ عيشٍ مستطاب",49,"ب",1,0],["وشوّقه البرق جنح الدُّجى","وندب الحمامة ليلاً هديلا",50,"ل",2,0],["وشوَّقني ثغراً ظمئتُ لوردِه","وهل أَشتكي إلاَّ إلى ورده الظما",51,"م",2,0],["وشوق إليكم من فوادٍ أذابهُ","بعادٌ ويهواكم على البعد والقرب",52,"ب",1,0],["وشَوَيْتُ للأَضْيافِ لَحْمَ رَكائِبي","فِي نارِ أَحْلاسِي وَفِي أَقْتابي",53,"ب",2,0],["وشوقي على ليلى أثار بمهجتي","من الوجد والتذكار جمرة واقد",54,"د",1,0],["وشوقٌ يبيح الدمع ذكرى غصونه","ويسطو على هزل الغرام بجدِّه",55,"د",2,0],["وَشواشَةٌ سَوطُها النَقرُ الخَفيُّ بِها","وَوَقعُها الأَرضَ تَحليلٌ إِذا تَخِدُ",56,"د",1,0],["وَشَّوا زهرَ الأشعارِ فقد","كَرَبتْ تختالُ على الزُّهُرِ",57,"ر",1,0],["وشوقاً إلى أهلِ العقيقِ كثيرُه","يذودُ الكرى عن مقلتيِه وأدناهُ",58,"ا",2,0],["وشُؤُني آياتُها بيِّناتٌ","أحكَمَتْها الشَّريعةُ الغرَّاءُ",59,"ا",2,0],["وشُوِّهَتْ مواضينا","فخُنّا لا مُبالينا",60,"ن",2,0],["وشوَتْ نارُها اللّحومَ فأمْسى","يُكرِمُ اللُّدْنَ في ضَعيفِ شَواها",61,"ا",3,0],["وشوفِيَت أَلسُنُ الأقلامِ مِن خَرَسٍ","فالقولُ ماب ينَ منثورٍ ومُنتَظِمِ",62,"م",1,0],["وشوّقنِي إيماضُه نحو أوجهٍ","لهنّ سناءٌ والمشوقُ مشوقُ",63,"ق",1,0],["وَشُؤونٌ تَبيضّ مِنها شؤونٌ","وَاِنقِلابٌ تَسودُّ منهُ قُلوبُ",64,"ب",1,0],["وشؤون ومالها من وجود","وهي بالقلب للوجود المواتي",65,"ت",2,0],["وشو