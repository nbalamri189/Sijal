{"poems":[[99,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[99,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9510","المديد"],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[164,"خاطر بنفسك في رضى الرحمن","https://www.aldiwan.net/poem59197.html","الكامل"],[240,"يا من رأى حد الحسام مضاءه","https://www.aldiwan.net/poem31747.html","الكامل"],[264,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[409,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122094","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101025","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45893","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"]],"verses":[["فأذقنيه فإني ذاهِبٌ","لا غدي يُرجَى ولا يُرجَى غدُك",0,"ك",1,0],["فأذقتني ما لم يذقه فمٌ","من أي كاس كنت ساقيتي",1,"ي",1,0],["فَأَذِقتُ الأَرضَ مُهجَتَهُ","دينُهُ مِنهُ كَأَديانِ",2,"ن",1,0],["فَأَذِقْ فُؤادِيَ فَرْحَةً بِالْبَحْثِ عَنْ","بِنْتِ الحَلالِ وَدَعْكَ مِنْ عِصْياني",3,"ن",2,0],["فأذقه طعم رضاك بالطبع الذي","شهدت برقته لك الملوان",4,"ن",1,0],["فَأَذِقهُ مِن بَردِ النَدى نَهَلاً فَقَد","جَرَّعتَهُ بِلسُخطِ كَأساً عَلقَما",5,"م",2,0],["فَأَذِقنا خَمرَ الشُهودِ لِتُجلَى","بِالتَجَلّي لَنا بَراقِعُ سِترِك",6,"ك",1,0],["فأذقهم كأس المنون وزدهم","ذلة بعد هذه في نكال",7,"ل",1,0],["فَأَذِقْهُمُ جُوعاً وَعَفْواً وَانْتَظِرْ","تَهْوِينَ أَمْرِهِمْ وَعُقْبَى المُتْرفِ",8,"ف",1,0],["فأذق عدوك سوء ما مكروا به","واجعل عواقبه عليه وبالا",9,"ل",2,0],["فَأَذقه لبان يوَماً","إِن هَذي عَسيلة الأَبكار",10,"ر",1,0],["فأذقت العدى المنايا وفجرت","عليهم أنهارها تفجيرا",11,"ر",2,0]]}