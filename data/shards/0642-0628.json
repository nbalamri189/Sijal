رٍ نُغَرُّ بِها","فَأَنتِ أَغدَرُ مِظعانٍ وَمِحلالِ",2,"ل",1,0],["قَبرٌ بِأَعلى الرَيِّ شُقَّ ضَريحُهُ","لِأَعَزَّ حَقَّرَهُ الرَدى إِعجالا",3,"ل",2,0],["قَبَّلَتهُ الرِماحُ وَاِنتَضَلَت في","هِ المَنايا وَعانَقَتهُ النُصولُ",4,"ل",1,0],["قَبلي سَقاكَ أَبي كُؤوسَ مَذَلَّةٍ","وَلَتَشرَبَن بِيَدي كُؤوسَ حُتوفِ",5,"ف",1,0],["قَبيلَةٌ أَغلَطَها نَهجَ العُلى","لُؤمُ عُروقٍ جَرَّتِ اِتَّضاعَها",6,"ع",3,0],["قِبابٌ مِنَ العَلياءِ أَعلى عِمادَها","فُحولُ الوَغى بَينَ الزَماجِرِ وَالخَطرِ",7,"ر",1,0],["قَبَضتُ يَدَ السَحابِ بِفَيضِ دَمعي","وَأَسكَتُّ الحَمايِمَ بِالزَفيرِ",8,"ر",1,0],["قِبابٌ يُطاطي اللُؤمُ مِنها كَأَنَّها","وَلَو رُفِعَت فَوقَ الجِبالِ وِهادُ",9,"د",1,0],["قُبورٌ تَنطُفُ العَبَراتُ فيها","كَما نَطَفَ الصَبيرُ عَلى الرَوابي",10,"ب",2,0],["قَبرٌ تَخَبَّثَ بِالنَسيمِ تُرابُهُ","دونَ القُبورِ وَعَقَّلَ الأَنواءَ",11,"ا",2,0],["قبل: انتظار قطاف الكرم ما انتظروا","نضج العناقيد لكن قبلها التهبوا",12,"ب",3,0],["قبري ومأساة ميلادي على كتفي","وحولي العدم المنفوخ والصخب",12,"ب",1,0],["قَبلَ ما اليَومِ بَيَّضَت بِعُيونِ ال","ناسِ فيها تَعَيُّطٌ وَإِباءُ",13,"ا",2,0],["قَبولُكُمُ وُدّي مِن اللَهِ نِعمَةٌ","تَتِمُّ إِذا كافأتُمُ الودَّ بالودِّ",14,"د",1,1],["قبّحَها اللهُ منْ وُجوهٍ","أدْحَضَها اللهُ منْ دَعاوِي",15,"ا",3,0],["قَبائِلُ أدْواها السُّرَى فتنكّرَتْ","ولكنّها عندَ الكَريهةِ تُعرَفُ",16,"ف",1,0],["قبلَ أن يوجِدَ الوجودَ وأن يُتْ","حِفَ بالنّورِ ظُلْمَةَ الأشْباح",17,"ح",1,0],["قَبّلْتُهُ حُلْوَ المَراشِفِ أسْمَرا","وأجَبْتُهُمْ إذْ عاتَبوني لَيْلَتَهْ",18,"ه",1,1],["قِبَلَ اِمرِئٍ طَلقِ اليَدَينِ مُبارَكٍ","أَلفى أَباهُ بِنَجوَةٍ فَسَما لَها",19,"ل",3,0],["قَبلَ أُسطولِ نِلسُنٍ كانَ أُسطو","لي سَرِيّاً وَطالِعي غَيرَ نَكدِ",20,"د",1,0],["قَبَّلَت راحَتَيهِ شُكراً وَصاحَت","قَد نَجا صاحِبُ الأَيادي العِظامِ",21,"م",1,0],["قَبلَ الثَلاثينَ إِذ عَهدُ الصِبا كَثَبٌ","وَلِلشَبيبَةِ غُصنٌ غَيرُ مُهتَصِرِ",22,"ر",1,0],["قَبولُكَها نِعمَةٌ غَضَّةٌ","وَفَضلٌ بِما قَبلَهُ مُتَّصِل",23,"ل",1,0],["قَبِلنَ غُروباً مِن سُمَيحَةَ أَنزَعَت","بِهِنَّ السَواني وَاِستَدارَ مَحالُها",24,"ل",3,0],["قَبائِلَ مِن كَعبِ بنِ عَمروٍ كَأَنَّهُم","إِذا اِجتَمَعوا يومًا هِضابُ المُضَيَّحِ",25,"ح",1,0],["قَبرانِ في طوسَ خَيرُ الخَلقِ كُلِّهِمُ","وَقَبرُ شَرِّهِمُ هَذا مِنَ العِبَرِ",26,"ر",1,0],["قَبائِلَ جُذَّ أَصلُهُمُ فَبادوا","وَأَودى ذِكرُهُم زَمَناً فَعادوا",27,"د",3,0],["قُبورٌ بِكوفانٍ وَأُخرى بِطَيبَةٍ","وَأُخرى بِفَخٍّ نالَها صَلَواتي",28,"ت",2,0],["قَبَّلتُها فَوَجدتُ لَدغَةَ ريقِها","فَوقَ اللِسانِ كَلَسعَةِ الزَنبورِ",29,"ر",1,0],["قَبلَ تَقَضّي عِدَّةِ السِخالِ","طولُ السُرى وَجِريَةُ الحِبالِ",30,"ل",1,0],["قَبلَ اِنصِداعِ الفَجرِ وَالتَهَجُّرُ","وَخَوضُهُنَّ اللَيلَ حينَ يَسكُرُ",31,"ر",1,0],["قَبَضتُ عَلَيهِ الخَمسِ ثُمَّ تَرَكتُهُ","وَلَم أَتَّخِذ إِرسالَهُ عِندَهُ ذُخرا",32,"ر",2,0],["قَبّلتُها ألْفاً وبتُّ لربِّها","أدعو له حتّى الصباح وأضْرَعُ",33,"ع",1,0],["قَبِّلْ بثغر الزهر كفَّ خليفة","يُغنيك صوبُ الجود منه عن المطرْ",34,"ر",1,0],["قبيح وداع قد جلا لعيوننا","محاسنَ من روض الجمال بلا عَدِّ",35,"د",1,0],["قبّة زخرفت لكم بالأماني","هم بَنوْها لكم وهم قوّضوها",36,"و",3,0],["قبر بتربتها قد ضمَ جوهرةً","من معدن الله لا من معدن التُرَب",37,"ب",1,0],["قُبَيَّلَةٌ أَناخَ اللُؤمُ فيها","فَلَيسَ اللُؤمُ تارِكَهُم لِحينِ",38,"ن",1,0],["قَبَحَ الإِلَهُ سِبالَ تَغلِبَ إِنَّها","ضُرِبَت بِكُلِّ مُخَفخِفٍ خَنّانِ",39,"ن",1,0],["قَبَحَ الإِلاهُ مُجاشِعاً وَقُراهُمُ","وَالموجِفاتِ إِذا وَرَدنَ زَرودا",40,"د",2,0],["قَبَحَ الإِلَهُ وُجوهَ تَغلِبَ إِنَّها","هانَت عَلَيَّ مَراسِناً وَسِبالا",41,"ل",2,0],["قَبَحَ الإِلَهُ وُجوهَ تَغلِبَ كُلَّما","شَبَحَ الحَجيجُ وَكَبَّروا إِهلالا",41,"ل",2,0],["قَبَحَ الإِلَهُ بَني خَضافَ وَنِسوَةً","باتَ الخَزيرُ لَهُنَّ كَالأَحقالِ",42,"ل",1,0],["قُبِّحتَ مَوتوراً وَطالِبَ دِمنَةٍ","بِالحَضرِ تَشرَبُ تارَةً وَتَبولُ",43,"ل",1,0],["قُبِّحتِ مِن إِبِلٍ وَقُبِّحَ رَبُّها","كومِ الفِصالِ قَليلَةِ الغُرّامِ",44,"م",1,0],["قَبَحَ الإِلَهُ عَلى المُرَيرَةِ أَقبُراً","أَصدائُهُنَّ يَصِحنَ كُلَّ ظَلامِ",44,"م",1,0],["قَبَحَ الإِلَهُ عَلى المُرَيرَةِ نِسوَةً","خُضرَ الجُلودِ يَبِتنَ غَيرَ نِيامِ",44,"م",1,0],["قَبائِلُ جُعفِيِّ بنِ سَعدٍ كَأَنَّما","سَقى جَمعَهُم ماءَ الزُعافِ مُنيمُ",45,"م",1,0],["قبيح بمثلي نعت الفتا","ة إِما ابتهاراً وإِما ابتيارا",46,"ر",2,1],["قُبَيِّلَةٌ تَذَبذَبُ في مَعَدٍّ","أُنوفُهُمُ أَذَلُّ مِنَ السَبيلِ",47,"ل",1,0],["قَبيلَةٌ أَلأَمُ الأَحياءِ أَكرَمُها","وَأَغدَرُ الناسِ بِالجيرانِ وافيها",48,"ي",3,0],["قُبَيِّلَةٌ بِالغَدرِ وَاللُؤمِ تَعتَزي","فَلَم تُمسِ يَخفى لُؤمُهُم بِخَفاءِ",49,"ا",2,0],["قَبيلٌ وَقوا شُحَّ النُفوسِ فَأَفلَحوا","وَطابَت لَهُم مُستَخفَياتُ السَرائِرِ",50,"ر",1,0],["قُبَيِّلَةٌ لَيسَ الوَفاءُ يُهِمُّهُم","وَإِن ظُلِموا لَم يَدفَعوا كَفَّ ظالِمِ",51,"م",1,0],["قبضت بأنعامهِ البندقي","فقلتُ نعم ثمَّ فصَّلته",52,"ه",1,0],["قبضت كفّ مرادِي","فاقدحْ بقلبيَ زندَك",53,"ك",1,0],["قبرٌ يُشاد وآجالٌ محكمةٌ","وا قلةَ الحول في حجرٍ وأحجار",54,"ر",1,0],["قبح الذين عن الجنوك تغافلوا","وتشاغلوا بالكسبِ في الأسفار",55,"ر",1,1],["قبّلتها فاحمرّ نقش حروفها","فكأنني رمّلتها بدموعي",56,"ي",1,0],["قبضت من الكمال نداك صفواً","بريئاً من سؤال أو مطال",57,"ل",1,0],["قبلة ذاك الوجه في مثلها","صلاة أشجاني وتسليمي",58,"م",2,0],["قبّلته عند النوى فتمرّرت","تلك الحلاوة بالتّفرق والجوى",59,"و",2,1],["قبلتَ مديحي وأَنشدتَهُ","أُناساً وأمسكت عني الثوابا",60,"ب",2,0],["قُبّةٌ أصبحت نجومُ المعالي","لأعالي سمائها تذهيبا",61,"ب",2,0],["قُبْحاً لأشياءَ يأتي البحتريُّ بها","من شعره الغَثِّ بعد الكدّ والتَعَبِ",62,"ب",1,0],["قُبحاً وإن حَدَّثَ ظَلَّ الورى","من هاربٍ أو صابرٍ مُتعبِ",63,"ب",1,0],["قُبحاً لها قبحاً على أنَّهَا","أقبحُ شيءٍ حين كشَّفْتُها",64,"ت",3,0],["قُبِّح البينُ إنه غَيرَ شكٍّ","شرُّ من أودع الذكورُ الإناثا",65,"ث",2,0],["قبيلةُ سوءٍ رماها الإلهُ","بصاعقة تركتهمْ هُمودا",66,"د",2,0],["قَبَّح اللَّهُ كلَّ قائلِ شعرٍ","شعرُهُ عيِّلٌ على إنشادِهْ",67,"د",2,0],["قبحاً لمختاره وصاحبه","ومجتبيه فما رأى رَشَدَهْ",68,"د",2,0],["قبح اللَّه وجهه","فهو ضد لبدرهِ",69,"ر",2,0],["قبيحٌ أن تعاقب مستكيناً","وليس عليك غيرك من مُجير",70,"ر",1,0],["قبُحت فجاوزت المدى قبح منظرٍ","ويا حسنَهُ من منظرٍ حين تُخبَر",71,"ر",1,0],["قُبْحُها سُتْرة لها","فهي للشَرب بارزه",72,"ز