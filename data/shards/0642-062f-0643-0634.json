{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[54,"قد كشف الدهر عن يقيني","https://www.aldiwan.net/poem26562.html","مجزوء البسيط"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[505,"قد كشف السر عن الرمز الخبا","https://www.aldiwan.net/poem38092.html","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47095","الخفيف"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143082","الخفيف"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36087","الخفيف"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198224","الخفيف"]],"verses":[["قَد كَشَفنا بِهَديِهِ كُلَّ خافٍ","وَحَسِبنا لِكُلِّ شَيءٍ حِسابا",0,"ب",2,0],["قَد كَشَّفَ الحِلمُ عَنّي الجَهلَ فَاِنقَشَعَت","عَنّي الضَبابَةُ لا نِكسٌ وَلا وَرَعُ",1,"ع",1,1],["قَد كَشَفَ الدَهرُ عَن يَقيني","قِناعَ شَكّي في كُلِّ شَيِّ",2,"ي",1,1],["قد كشفْتُم عن العيون غطاها","وحميْتُم ممَّا يروع سطاها",3,"ه",2,0],["قد كشفَ السِّرُّ عن الرَّمزِ الخِبا","وقد رأَيتُ للتَّجلِّي مَشْعَبا",4,"ب",2,1],["قد كشفتَ العذاب عنهمَ لِحينٍ","ثمّ ماتوا وما لِخَلْقٍ بقاء",5,"ا",2,0],["قد كشفت الأشياء بالفعل حتى","ظهرت لي وليس فيها التباس",6,"س",1,0],["قد كَشَفنا كُلَّ خافى","فَاِستَحال السِرُّ جَهرا",7,"ر",2,0],["قَد كَشَفناكَ يا سَعيدُ فَما كُن","تَ عَلى الكَشفِ بِالصَديقِ الصَدوقِ",8,"ق",1,1],["قَدْ كَشَفْتَ الخُطوبَ عنْها وكانَت","طاهِراتٍ منْها ذُيولُ ردِاكَا",9,"ك",2,0]]}