{"poems":[[79,"أمستخرجا كنز العقيق بآماقي","https://www.aldiwan.net/poem35917.html","الطويل"],[79,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[34,"أفق قد أفاق العاشقون وفارقوا","https://www.aldiwan.net/poem27784.html","الطويل"],[87,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[45,"أيدري الربع أي دم أراقا","https://www.aldiwan.net/poem9732.html","الوافر"],[51,"كأن قد عجل الأقوام غسلك","https://www.aldiwan.net/poem63040.html","الوافر"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[68,"فضحت بدور التم إذ فقتها حسنا","https://www.aldiwan.net/poem39933.html","الطويل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[147,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[164,"عدوك مما عنك يسمع يا يحيى","https://www.aldiwan.net/poem58856.html","الطويل"],[164,"شهود الهوى منى علي عذول","https://www.aldiwan.net/poem58955.html","الطويل"],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[203,"أبت عيناك إلا أن تصوبا","https://www.aldiwan.net/poem45562.html","الوافر"],[214,"أكاتب خط الوصل حرر لي الضبطا","https://www.aldiwan.net/poem13302.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[396,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[409,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[438,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[447,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[534,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[580,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54161","الوافر"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/34699","الوافر"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6773","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53139","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53043","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34889","الطويل"],[2935,"","https://poetry.dctabudhabi.ae/diwan/poem/130240","الطويل"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131979","المتقارب"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140290",""],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45931","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81699","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204360",""],[4727,"خيبات","https://www.poetsgate.com/ViewPoem.aspx?id=210587",""],[4858,"أنين القيد","https://www.poetsgate.com/ViewPoem.aspx?id=152051",""],[4978,"تشطير بلقيسيات 1","https://www.poetsgate.com/ViewPoem.aspx?id=177256",""],[5185,"نبوءة الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=72852",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5493,"بحرُ العبور","https://www.poetsgate.com/ViewPoem.aspx?id=198115",""],[5309,"إذا سايرت اوهامك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573872",""],[2220,"جمعتُ همي عليا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11907&r=&rc=776",""]],"verses":[["فقَدْ ضعُفَتْ عنْ حمْلِ صبْري طاقَتي","علَيْكَ وضاقَتْ عنْ زَفِيريَ أطْواقي",0,"ق",2,0],["فقد ضاقَ ميْدانُ الشّبابِ عنِ الهَوى","فآثَرتِ النّفْسُ الرّجوعَ الى الحَقِّ",1,"ق",1,0],["فَقَد ضَلَّ إِلّا أَن تُقَضِّيَ حاجَةً","بِبُرقِ حَفيرٍ دَمعُكَ المُتَبادِرُ",2,"ر",1,0],["فقد ضاقت بي الدنيا فسعني","فقد تسمع المنافق والتقيا",3,"ي",2,0],["فَقَد ضَمِنَت لَهُ المُهَجَ العَوالي","وَحَمَّلَ هَمَّهُ الخَيلَ العِتاقا",4,"ق",2,0],["فَقَد ضَيَّعتَ حَظَّكَ يَومَ تُدعى","وَأَصلَكَ حينَ تَنسُبُهُ وَفَضلَك",5,"ك",1,0],["فَقَد ضَمِنتُ وُجودَ الدَمعِ مِن عَدَمِ","لَهُم وَلَم أَستَطِع مَع ذاكَ مَنعَ دَمي",6,"م",2,0],["فَقَد ضاقَ بي مِن بَعدِ بُعدِكُمُ الفَضا","وَلا تَهجُروا فَالعُمرُ قَد فاتَ وَاِنقَضى",7,"ض",2,0],["فقد ضَرِعَتْ منْه الرّواسي لما رأتْ","فكيف قلوب الإنس والإنس أضرع",8,"ع",1,0],["فَقَد ضَعُفَت زُنودٌ عَن قِسِيٍّ","رَمَت عَنها العِدى وَكَبَت زُنودُ",9,"د",1,0],["فَقَد ضَحِكَ الدَهرُ عُجباً بِها","وَما كانَ مِن قَبلِها يَبتَسِم",10,"م",1,0],["فقد ضجت الأموال مما يبيدها","ومما ترى بين الورى نفسها فيا",11,"ي",2,0],["فقد ضم نحو الملك ملكا وقد سطا","ودانت حزون جمة وسهول",12,"ل",1,0],["فَقَد ضَيَّعَت قَبلي رِبابٌ بَنِيَّها","وَما كُنتُ أَدري لِاِبنِ أَفصى مُساويا",13,"ي",2,0],["فقد ضاقتْ بي الدنيا وهبتْ","فجائعها على قلبي هبوبا",14,"ب",2,0],["فقد ضاع عمري وانقضى زمن الصبا","ولم اتعظ جهلا بلمتي الشمطا",15,"ط",2,0],["فَقد ضَمنت لي عن نوالك فيضه","وَلم تُبعد المرمى إذا اِستمطرت سكبا",16,"ب",2,0],["فقد ضاق الخناق وضقت ذرعا","ومالي غير جودك من طبيب",17,"ب",1,0],["فقد ضل بالتأويل قوم جهالة","ويعرف ذا النقاد من غير تنبيه",18,"ي",2,0],["فقد ضاقتْ بيَ الأرضُ","كأني صرْتُ في سِجْنِ",19,"ن",1,0],["فقد ضاق بي الذرع الرحيب لأنني","بليت بذنب لا يطاق رحيب",20,"ب",1,0],["فقد ضمنت للعذول عنكما","أمراً علي في الهوى إمراره",21,"ر",2,0],["فَقَدْ ضاقتْ عَليْكَ الأَرْضُ طُرّاً","ودافَعْتَ الْحَقِقَةَ بالخَيالِ",22,"ل",1,0],["فقد ضجُّوا من الغَيْظ","وقد شَدُّوا الزنانيرْ",23,"ر",1,0],["فقد ضاق الفضاء عليّ مما","دهيتُ بحمله وهو الرحيبُ",24,"ب",1,0],["فَقَد ضاقَت عَلَيَّ وُجوهُ أَمري","وَأَنتَ المُستَجارُ مِنَ المَضيقِ",25,"ق",1,0],["فَقَد ضَجَّتِ الأَرضُ مِن فِسقِهِم","وَكادَت تَميدُ بِنا أَجمَعين",26,"ن",1,0],["فقد ضجت الأموال مما تهينها","وملت سيوف الهند مما تقارع",27,"ع",1,0],["فقد ضمنت جرد المذاكي وقوفها","على مثلها من أربع وملاعب",28,"ب",1,0],["فقد ضعفت لما بي","وذبتُ شيّاً فشيا",29,"ي",2,0],["فَقَد ضَيَّقوا مِن أَرضِنا كُلَّ واسِعٍ","وَصارَ لَهُم أَهلٌ بِها وَتَعَرَّضوا",30,"ض",3,0],["فقَدْ ضَلَّ مَجْرَى سَعْيِه فارْمِ دُونه","بما هُو أنْأَى في المحَلِّ وأنْزَحُ",31,"ح",1,0],["فقد ضمنت لهم في الخلد منزلة","عليا ولو خالفوا ما جئت راويها",32,"ي",3,0],["فقد ضم هذا الثرى زهرة","تفوح بعرف شذى عطر",33,"ر",1,0],["فقد ضاق وقت الجد والعود قد ذوى","ونادت بنا للحافرين الهواتف",34,"ف",1,0],["فَقَد ضاقَ صَدري عَن أُمورٍ مَريرَةٍ","وَضِقتُ بِها ذَرعاً وَأَنتَ وَسيلَتي",35,"ي",1,0],["فقد ضمنت تمكينَ ما اللهُ مرتضٍ","من الدِّين باستخلافكم عدة الذكر",36,"ر",1,0],["فقد ضمنت له الذي","قد نال من راع كفيل",37,"ل",1,0],["فقد ضحكت نفسي وهان مُصابها","ومن كثرة الخيبات قد يضحك المرؤ",38,"ا",1,0],["فقد ضلّوا السّبيلَ , وقد أضلّوا","أراذلَ , همُّهم عيشُ غريرُ",39,"ر",1,0],["(فقد ضنيت اشتياقا)","هيا انقل ِالشّوق عنّي",40,"ن",2,0],["فقد ضاع عمرٌ حسبتك عمري","وكنت حضوراً .. فصرت الغياب",41,"ب",1,0],["فقد ضل مسعاه وخاب رجاؤه","وأصبح في جهل وفي الجهل لم يزل",42,"ل",1,0],["فقد ضل مسعاه وخاب رجاؤه","وقد باء بالسوء الذي هو قائله",43,"ل",2,0],["فقد ضعنا وما زلنا حيارى","وأمضينا الحياة بلا عثور",44,"ر",1,0],["فَقَد ضَيَّعتَ أَيّامَك","كَما ضَيَّعتُ أَيَّامي",45,"م",2,0],["فقدْ ضعفتُ لما بي","وذبتُ شيئاً فشيئا",46,"ي",3,0]]}