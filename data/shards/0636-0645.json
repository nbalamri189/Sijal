َماحَةِ في مَلاثِ إِزارِهِ","وَالمَجدُ في نُوّارِهِ المُتَكَمِّمِ",3,"م",1,0],["ضَمِنَت مِنهُم قَراراتُهُمُ","عَمَدَ المَجدِ وَأَركانَ المَعالي",4,"ي",1,0],["ضَمَمتُ يَدي مِنهُ وَكانَت غَباوَةً","عَلى ضَربِ مَردودٍ مِنَ الوَرقِ زائِفِ",5,"ف",1,0],["ضَمومٌ عَلى الهَمِّ الَّذي باتَ ضَيفَهُ","جَموحٌ عَلى الأَمرِ الَّذي كانَ أَزمَعا",6,"ع",2,0],["ضَمَّ الوِعا وَبَزَّ بِالعِقاصِ","سُقيتَ مِن داني الحَيا وَالقاصي",7,"ي",1,0],["ضَمُرَت بِجِرَّتِها عَليكَ وَفي","أَحشائِها كَلَواعِجِ الجَمرِ",8,"ر",1,0],["ضَمَّختَ بِالراحِ أَثوابَ الكِؤوسِ كَما","فَضَّ النَسيمَ عَلى أَعطافِهِ السَحَرُ",9,"ر",1,0],["ضُمرٌ كَأَمثالِ القَنا","لَولا السَبيبُ وَالعُذَر",10,"ر",1,0],["ضُمّوا قَواصِيَ كُلِّ سَرحٍ سارِبِ","وَقِفوا السَوائِمَ بِالنَدى المُتَقارِبِ",11,"ب",1,1],["ضمِنَ الحَياةَ لمُعْتَفيهِ يَراعُهُ","ورَمى العُداةَ حُسامُهُ بحُتوفِ",12,"ف",1,0],["ضمنت لها حفظ العهود وإنما","ضمنت لها أن لا أزال أهيم",13,"م",1,0],["ضَمِنَتْ رَجَاءُ اللهِ مِنْكَ مَطَالِبِي","لَمَّا جَعَلْتُكَ فِي الثَّوابِ شَرِيكَا",14,"ك",2,0],["ضَمِنَتْ علَى مرّ الزّمانِ مَكارِمي","رِيَّ الأُوامِ وحاجَةَ المُحْتاجِ",15,"ج",1,0],["ضَمِنَت لَنا أَعجازُهُنَّ قُدورَنا","وَضُروعُهُنَّ لَنا الصَريحَ الأَجرَدا",16,"د",2,0],["ضَمَّت إِلى التاريخِ بِضعَ صَحائِفٍ","بَيضاءَ مِثلَ صَحائِفِ الأَبرارِ",17,"ر",1,0],["ضَمَّ مِقراضَهُ إِلَيهِ وَنادى","دونَ ذُلِّ الحَياةِ قَطعُ الوَريدِ",18,"د",1,0],["ضَمانٌ على عَينَيهِ إِن طاشَ سَهمُهُ","إِذا ما رَمى أَن لا يَطيشَ اِحوِرارُهُ",19,"ر",2,0],["ضَمانٌ عَلَينا أَن تُزارَ وَدونَها","رِقاقُ الظُبى وَالسَمهَرِيُّ المُثَقَّفُ",20,"ف",1,0],["ضَمانٌ عَلَيهِم أَن سَيُؤثَرُ عَنهُمُ","عَلَيكَ ثَناءٌ في المَحافِلِ حافِلُ",21,"ل",1,0],["ضمنا ضمة الوشاح عناق","بيمين معقودة بشمال",22,"ل",1,0],["ضَمَّكَ لُبْنَانُ إِلَى صَدْرِهِ","وَقَدْ يَجِد الحِسُّ بِالأَمْكَنَهْ",23,"ن",2,0],["ضَمَّ مِنْ شَمْلِهِمْ أَسَاهُمْ عَلَيْهِ","وَإِلَى الرُّشْدِ يَرْجِعُ المَحْزُونُ",24,"ن",1,0],["ضَمَّ الظَلامُ عَلى الوَحشِيِّ شَملَتَهُ","وَرائحٌ مِن نَشاصِ الدَلوِ مُنسَكِبُ",25,"ب",1,0],["ضمنت لأيتام الأرامل طبّهم","وغذاءهم وبشائر الأبلال",26,"ل",1,0],["ضَمِنتِ لهم رغيد العيش حتى","أخذت على الزمان لهمِ ذماما",27,"م",2,0],["ضممتُ الخصرَ ثمَّ نحوت أمراً","فيا لك ضمة كانت وفتحه",28,"ه",1,0],["ضمنت قلبي الوفا مع حسنها فوفى","مع أنَّه ضامنٌ بالصدّ مكسور",29,"ر",1,0],["ضمن النجابة عنه يومَ وِلادِهِ","قمرٌ وشمسٌ أدَّياهُ وكوكبَا",30,"ب",2,0],["ضُمي وإلا حبلت من سعة","فأنت طول النهار منفرِجَهْ",31,"ج",2,0],["ضَمِنٌ إذا حصل الوفاءُ بما وَأَى","عنْه الرجاءُ ثَنَاهُ بالإِرْجَاحِ",32,"ح",1,0],["ضمنتُ له أن لا أخون فظنني","ضمنتُ له أن لا يخوننيَ الدهرُ",33,"ر",1,0],["ضمّنت سِكْري وحريقي الألى","هُم للحريق الدهر أو للسكورْ",34,"ر",1,0],["ضُمَّ إلى خير والد ولدٌ","حل محلَّ الفؤاد في الصدر",35,"ر",1,0],["ضمَنت كل مُسمهِرٍّ له وق","عٌ كوقع المحدرَج المجلوز",36,"ز",1,0],["ضَّم صدريهما اتفاقٌ ينادي","يا له مُسعِفاً برأب الصُدوع",37,"ع",1,0],["ضمنتُ لك احتباسَ الحلمِ حتى","أطيل على الهوان مدى احتباسك",38,"ك",1,0],["ضَمومٌ كلما انفرجتْ صدوعٌ","صَدوعٌ كلما التبست شكولُ",39,"ل",1,0],["ضَمن التنزُّه كفَّ غر","بي والوفاء أخو ضماني",40,"ن",2,0],["ضَمَّنتُها حَمداً وَشُكراً","وَأَتَتكَ تَطلُبُ مِنكَ عُذرا",41,"ر",2,1],["ضَمِنتُ لَها أَن لا أُهيمَ بِغَيرِها","وَقَد وَثِقَت مِنّي بِغَيرِ ضَمانِ",42,"ن",1,0],["ضم ديوانك الذي هو فردو","س من الشعر البكر حوراً عيهنا",43,"ن",2,0],["ضمت غداة تعلقت في نهجها","بالمجد احرازا الى احراز",44,"ز",1,0],["ضمتها وتواصت راحتاك بها","ضم الوليدة إشفاقا وإحسانا",45,"ن",2,0],["ضَمَّتِ الصَدرَ الَّذي قَد ضَمَّها","وَتَلَقّى السَهمَ عَنها فَوَقاها",46,"ا",3,0],["ضَمَّتْ ذراعيْها الطبيعةُ رِقَّةً","صِنِّينَ والحَرَمُونَ فاحتضناكِ",47,"ك",1,0],["ضُمّي قِناعَكِ يا سُعادُ أَو اِرفَعي","هَذي المَحاسِنُ ما خُلِقنَ لِبُرقُعِ",48,"ع",1,1],["ضُمِدَت بِأَهدابِ الجُفونِ وَطالَما","ضُمِدَت بِأَعرافِ الجِيادِ الضُمَّرِ",49,"ر",1,0],["ضَمّوا الجُهودَ وَخَلوُها مُنَكَّرَةً","لا تَملَئوا الشَدقَ مِن تَعريفِها عَجَبا",50,"ب",2,0],["ضَمَمتَ جَناحَيهِم عَلى القَلبِ ضَمَّةً","تَموتُ الخَوافي تَحتَها وَالقَوادِمُ",51,"م",1,0],["ضمّ إليها نفسها المبيّضة","نفسا غدت مذهبة منضَّضة",52,"ه",1,0],["ضمِنتُ لصحبي الصبر عنها وقد أبتْ","ضمانةُ قلبي أن أفي بضماني",53,"ي",1,0],["ضمنتُ لصحبي أن أُفيقَ وقد أبتْ","ضمانةُ قلبي أن أفي بضماني",54,"ي",1,0],["ضمانٌ من الإقبال عندك لم تَزَلْ","عواقبُهُ عما تُسَرُّ به تُجْلي",55,"ل",2,0],["ضمومٌ على الهَمِّ البعيد جَنَانَهُ","وقورٌ إِذا القومُ استطيروا من الجهلِ",55,"ل",1,0],["ضمَّتْ عليهِ الريحُ فضلَ ردائِه","وبهِ من الشَّفَّانِ ندبُ عِضَاضِ",56,"ض",1,0],["ضُمِّي حقائِبَهُ إلينا واحضَأي","قلقَ السَّنَا كالحيَّةِ النَضْنَاضِ",56,"ض",1,0],["ضَمِنٌ إِذا خبطتْ غريبةُ بأسهِ","بعزائمٍ خُضُعِ الرِقابِ مِراضِ",56,"ض",1,0],["ضَمِنَّ القِرى للوحشِ والطيرِ فارتوتْ","وكظَّتْ جِراءٌ من قِراها وأفرخُ",57,"خ",1,0],["ضَمِنتُ أَن يَشغَلَ سَيفَيهِ ذو ال","سَيفَينِ إِسحاقُ بنُ كُنداجِ",58,"ج",1,0],["ضَمِنتُ عَنِ الساعينَ أَن يَلحَقوا بِهِ","إِذا ذُكِرَت آلاؤُهُ وَفَواضِلُه",59,"ل",2,0],["ضَمانٌ عَلى عَينَيكِ أَنِّيَ لا أَسلو","وَأَنَّ فُؤادي مِن جَوىً بِكِ لا يَخلو",60,"ل",2,1],["ضَمِنتَ رَدى عَدُوِّكَ وَالمَوالي","تُدافِعُ دونَ مُلكِكَ أَو تُحامي",61,"م",2,0],["ضَمِنَ البِشرَ فَلَم يَلطِط بِهِ","كَزَعيمِ الدَينِ أَدى ما ضَمِن",62,"ن",1,0],["ضَمَّنا الحِلفُ فَإِتَّصَلنا دِياراً","في المَقاماتِ وَإِلتَفَفنا غُصونا",63,"ن",2,0],["ضَمَّرَه في مُبتَدى أعوامِه","وصانَه عن عابِه وذامِه",64,"م",2,0],["ضَمِنتُم مالَهُ وَغَدا جَميعاً","عَلَيكُم نَقصُهُ وَلَهُ النَماءُ",65,"ا",2,0],["ضَمِنتُ لِلطالِبِ الدُنيا وَزينَتَها","أَلّا يَزالَ بِها ما عاشَ مَشغولا",66,"ل",2,0],["ضَمِنَ الشَبيبَةِ وَالرَبيعِ حَلا","رَشفي الطَلا وَلِغَيرِها رَفضي",67,"ي",1,0],["ضَمِنَت سَماحَةُ راحَتَيهِ لَنا","بِرَّ البِلادِ بِجودِهِ المَحضِ",67,"ض",1,0],["ضَمِنَ اليَراعُ وَحَدُّ صارِمِهِ","عِزَّ الوَلِيَّ وَذَلَّ ذي البُغضِ",67,"ض",1,0],["ضَمِنوا قِرى أَسماعِنا وَعُيونِنا","لِلعَينِ رَقصُهُمُ وَلِلسَمعِ الغِنا",68,"ن",2,0],["ضَمِنتَ لِلصَحبِ إِقبالَ السُرورِ كَما","ضَمَّنتَ نايَكَ نَأيَ الهَمِّ وَالكَدَرِ",69,"ر",1,0],["ضَمِنَت بِها قوتَ الوُحوشِ فَأَصبَحَت","عِندَ العَريكَةِ وَهيَ مِن أَقواتِها",70,"ت",3,0],["ضَمَّ الأُسودَ فَما زالَ الزَمانُ لَهُ","يَنوي المُكافاةَ حَتّى ضَمَّهُ الأَسَدُ",7