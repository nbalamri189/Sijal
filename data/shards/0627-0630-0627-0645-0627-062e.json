{"poems":[[55,"لأمر يا بني جشم","https://www.aldiwan.net/poem29770.html","مجزوء الوافر"],[24,"أمن أم شداد رسوم المنازل","https://www.aldiwan.net/poem21878.html","الطويل"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[32,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[29,"أراح الحي من إرم الطراد","https://www.aldiwan.net/poem5709.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[51,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[51,"إذا ما خلوت الدهر يوما فلا تقل","https://www.aldiwan.net/poem10328.html","الطويل"],[68,"خليلي ما أغبى المغالين في الهوى","https://www.aldiwan.net/poem40098.html","الطويل"],[35,"ألا يا حمامات الحمى عدن عودة","https://www.aldiwan.net/poem25791.html","الطويل"],[107,"بني الإسلام إقداما","https://www.aldiwan.net/poem42106.html","مجزوء الوافر"],[54,"ألا أيها الخمار هات بما ترى","https://www.aldiwan.net/poem26912.html","الطويل"],[52,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[48,"ألو الفضل في أوطانهم غرباء","https://www.aldiwan.net/poem21990.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67317","الطويل"],[51,"لعَمْرُكَ، ما الدّنيا بدارِ بَقَاءِº","https://www.poetsgate.com/ViewPoem.aspx?id=13166",""],[92,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[154,"لعزك ذلت الأمم","https://www.aldiwan.net/poem68499.html","مجزوء الوافر"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[285,"لعمر أبي العطاء لئن تولى","https://www.aldiwan.net/poem60756.html","الوافر"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[369,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[371,"سقى الله تلك الدار عودة أهلها","https://www.aldiwan.net/poem17876.html","الطويل"],[440,"إذا ما خففت كعهد الصبا","https://www.aldiwan.net/poem25695.html","المتقارب"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[463,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[466,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16179.html","الطويل"],[469,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[482,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[556,"إذا ما خطاني الدهر يوما فلم يصب","https://www.aldiwan.net/poem47283.html","الطويل"],[569,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[574,"إِذا ما خليلي خانني وائتمنته","https://www.aldiwan.net/poem52003.html","الطويل"],[580,"سمعت بأمر ليتني لا سمعته","https://www.aldiwan.net/poem2732.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82802","الوافر"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90554","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96666","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72308","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126175","الوافر"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28343","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56092","الوافر"],[1273,"","https://poetry.dctabudhabi.ae/diwan/poem/199223","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109173","الوافر"],[1495,"","https://poetry.dctabudhabi.ae/diwan/poem/178081","الوافر"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144585","الطويل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96330","الطويل"],[1891,"","https://poetry.dctabudhabi.ae/diwan/poem/27051","الطويل"],[2219,"","https://poetry.dctabudhabi.ae/diwan/poem/103396","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27994","الوافر"],[2253,"","https://poetry.dctabudhabi.ae/diwan/poem/115137","المتقارب"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106978","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83057","المتقارب"],[2971,"","https://poetry.dctabudhabi.ae/diwan/poem/199865","الوافر"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121646","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89433","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205714",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102949","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40116","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77063","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77050","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93315","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120393","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120355","الوافر"],[2052,"جواد جدد المعروف فينا","https://www.poetsgate.com/ViewPoem.aspx?id=189621",""],[185,"أميم منك الدار غيرها البلى","https://www.poetsgate.com/ViewPoem.aspx?id=186042",""],[4955,"إذا ما خدعت ببعض البشر","https://www.poetsgate.com/ViewPoem.aspx?id=187748",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5690,"إذا ما المجد داريهِ الكلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172178",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[5956,"مجاميع قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=182583",""],[463,"بدينكَ بعدما انفرقَ الجميعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60138&r=&rc=194",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["إِذا ما خائِفٌ غَلَبَت","عَلَيهِ سَطوَةُ العَدَمِ",0,"م",1,0],["إِذا ما خَليلٌ لَم يَصِلكَ فَلا تُقِم","بِتَلعَتِهِ وَاِعمَد لِآخِرَ واصِلِ",1,"ل",1,0],["إِذا ما خَبَت مِن آخِرِ اللَيلِ خَبوَةً","أُعِيدَ لها بِالمَندَلِّي فَتُثقَبُ",2,"ب",1,0],["إِذا ما خَفَّضَ الأَقوامَ يَوماً","عَلى المَوضوعِ وَاِطَّرَدَ الجَديلا",3,"ل",2,0],["إِذا ما خِفتُ رَدَّ إِلَيَّ نَفسي","وَصارَ إِلى مَساكِنِهِ فُؤادي",4,"د",2,0],["إِذا ما خِندِفٌ زَخَرَت وَقَيسٌ","فَإِنَّ جِبالَ عِزِّيَ لا تُرامُ",5,"م",1,0],["إِذا ما خَليلٌ حَلَّ في بَرزَخِ البِلى","فَحَسبي بِهِ نَأياً وَبُعدَ لِقاءِ",6,"ا",2,0],["إِذا ما خَلَوتَ الدَهرَ يَوماً فَلا تَقُل","خَلَوتُ وَلَكِن قُل عَلَيَّ رَقيبُ",7,"ب",1,1],["إِذا ما خَلا القَلبُ الصَحيحُ مِنَ الهَوى","عَلِمتُ بِأَنَّ العَقلَ غَيرُ صَحيحِ",8,"ح",1,0],["إِذا ما خَلا لِلنَومِ أَرَّقَ عَينَهُ","نَوائِحُ وُرقٍ فَرشُهُنَّ غُصونُ",9,"ن",1,0],["إذا ما خَاصَمَ الأُمَما","مَضَى نَقْضاً وإبراما",10,"ا",1,0],["إِذا ما خُمارُ السُكرِ يُذكِرُني غَداً","فَلا حَبَذا يَومي وَلَهفي عَلى أَمسي",11,"ي",1,0],["إِذا ما خَشينا شَوكَةً مِن مُنافِقٍ","عَلى الناسِ أَو حَيرانَ لَيسَ بِقاصِدِ",12,"د",1,0],["إِذا ما خَبَت نارُ الشَبيبَةِ ساءَني","وَلَو نُصَّ لي بَينَ النُجومِ خِباءُ",13,"ب",3,0],["إِذا ما خَلا شَبَحي مِنهُما","فَما يُقفِرانِ وَلا يَخلُوانِ",14,"ن",1,0],["إذا مَا خَرَجْتُمْ فاكتُمُوا مَنْ لَقِتُمُ","ولا تكتُمُوا أخبارَكُمْ ي المَجَالِسِ",15,"س",1,0],["إذا ما خَليلي حَلّ في بَرْزَخِ البِلى","، فَحَسْبِي بهِ نأْياً وبُعْدَ لِقَاءِ",16,"ا",2,0],["اذا ما خَصَصْتُ فتى مازنٍ","بضربٍ من الكَلِمِ الفاتِن",17,"ن",1,0],["إذا ما خلَّفت عَلَماً","بدا من خلفها علم",18,"م",1,0],["إذا ما خلّفت عجباً","بدا من بعده عجب",19,"ب",1,0],["إذا ما خانَنِي دَمْعٌ بَلِيدٌ","بَكَيْتُ بأَدْمُعِ الشِّعْرِ الْفِصاحِ",20,"ح",1,0],["إذا ما خطَتْ خَطّتْ يداها بجَمْرةٍ","لِما طالعَتْ من كُلّ مُشْكلةٍ شَكْلا",21,"ل",2,0],["إذا ما خَصْلةٌ كَمُلَتْ وعُدَّتْ","لذي كَرَمٍ كَمُلْتَ لنا خِصالا",22,"ل",2,0],["إِذا ما خُيولُ النائِباتِ تَراكَضَت","فَهَيهاتَ أَن يُغنى الفَتى الفَوتُ بِالفَرِّ",23,"ر",1,0],["إِذا ما خَلَت مِنكُم مَجالِسُ وُدِّهِ","فَقَد عَمَرَت مِنكُم مَجالِسُ شُكرِهِ",24,"ر",2,0],["إذا ما خَفَفْتُ كَعَهْدِ الصِّبا","أَبَتْ ذَلِكَ الْخَمْسُ والأَرْبَعونا",25,"ن",2,1],["إذا ما خافَ من قِدْرٍ عليها","مماطلةً تعجَّلَ فاشتواها",26,"ا",3,0],["إذا ما خلوتم أنستم بها","وإن ضامها الدهر عاذت بكمْ",27,"م",1,0],["إذا ما خفَّ أو نهض النواجي","مشت منها الحسيرةُ والظليعُ",28,"ع",1,0],["إذا ما خطرن على روضةٍ","بعرضك زِدنَ عليها رُداعا",29,"ع",2,0],["إذا ما خَبَتْ نارُ اليَفاعِ لِرِهْمةٍ","هداهمْ إلى نعْمائهِ وضَحُ البِشْرِ",30,"ر",1,0],["إذا ما خلت منك البلاد وأهلها","فمن يرتجى فيها لدفع العظائمِ",31,"م",1,0],["إذا ما خلتْ منك البلاد وأهلها","فلا بشّرت أمَّ المعالي بباسل",32,"ل",1,0],["اِذا ما خَلَونا شكونا الهوى","وفاضَتْ مدامِعُنا الهُمَّعُ",33,"ع",1,0],["إذا ما خطاني الدّهرُ يوماً فلم يُصِبْ","صميمي فما يرضيه غير خليلي",34,"ل",2,1],["اذا ما خامل بالخود يلهو","فملهاه الأسنة واليراع",35,"ع",1,0],["إِذا ما خليلي خانَني وائتمنته","فَذاكَ وداعيه وذاكَ وداعها",36,"ع",3,1],["إِذا ما خَبا وهْجُ المَصيِف فإنَّني","بتحليلِ ناموسِ الحكيمِ زَعيمُ",37,"م",1,0],["إذا ما خاطبتنا فهي بحر","تدفق بالنصائح والعظات",38,"ت",1,0],["إِذا ما خَف بَشَراً وَاِغتِباطا","حَسبت الكَون طراً في يَديهِ",39,"ي",2,0],["إذا ما خلَوتُ بِكُتبي","فحسبي منَ الخلقِ حسبي",40,"ب",2,1],["إِذا ما خلتُ حادثةً تقضّت","أتَت مِن بعدها أُخرى وأُخرى",41,"ر",2,0],["إذا ما خلى قصر النوم ليله","فليلي برعيي للنجوم طويلُ",42,"ل",1,0],["إذا ما خفت كاسرة السباع","وحرق النار أو سم الأفاعي",43,"ي",1,1],["إِذا ما خَشينا بَلدَةً قَرَّبَت بِنا","طَوالُ مُتونٍ مُشرِفاتُ الحَواجِبِ",44,"ب",1,0],["إذا ما خاض ساحات المنايا","به أنساك صولة كل ضيغَمْ",45,"م",1,0],["إِذا ما خَبَتْ فيه المشاعلُ عاضَها","من ايدي الجيادِ المُنْعَلاتِ مشاعل",46,"ل",1,0],["إذا ما خفت من غضب سريع","فاسرع بالعلاج وعدَّ عشره",47,"ه",1,1],["إذا ما خطةٌ ضاقت عليه","أشرت لها فأمعنت اتساعا",48,"ع",2,0],["إذا ما خلا الميدانُ عن قُرح الوَغى","أُقيمتْ على مضمارها مُهراتُها",49,"ت",3,0],["اذا ما خشينا من أمير ظلامة","دعود ابا غسان يوما مفكرا",50,"ر",2,0],["إِذا ما خَرَجنا خَرَّتِ الأَكمُ سُجَّداً","لِعِزٍّ عَلا حَيزمُهُ وَعَلاجِمُه",51,"م",2,0],["إذا ما خرجنا خَرَّت الأكم سُجّداً","لُغرَّ علا حَيزومُه وعلاجُمه",52,"م",2,0],["إذا ما خضت في الآيات تشقى","وتحرم أن تكون لها شهيدا",53,"د",2,0],["إِذا ما خَلَوتُ مِن المُؤنِسينَ","جَعلتُ المُحدِّثَ لي دَفتَري",54,"ر",2,1],["اذا ما خبت نار الوغى شعشعوا لها","سيوفهم جمراً وقالوا توقدي",55,"د",2,0],["إِذا ما خَليلي أَسا مَرَّة","وَقد كانَ من قبلِها مجمَلا",56,"ل",2,1],["إذا ما خانَنِي يَوْماً جَوِادي","جَعَلْتُ اْلأَرْضَ لِي فَرَساً وثِيقا",57,"ق",2,1],["إذا ما خَبَّ خِلْتَ الطَّيْفَ وَافَى","لِجُنْحِ الليلِ مِن خَوْفِ المُراقِبْ",58,"ب",1,0],["إِذا ما خَشينَ البَينَ وَالبينُ رائِعٌ","تَواعَدنَ بَينَ الحَيِ والحيِ مَلعَبا",59,"ب",2,0],["إذا ما خبروني وقت بولي","بشاربك الكريه وما يليه",60,"ي",2,0],["إذا ما خاف ذو شغف","فذاك المارد انطلقا",61,"ق",2,0],["إذا ما خطيب من مطول فضله","تلا لم يطق من شرح تبيانه بعد",62,"د",1,0],["إِذا ما خدمتَ فَمولىً كَريماً","وَإِمّا عَبدْتَ فَعبداً شَكورا",63,"ر",2,0],["إِذا ما خَلِيُّ البالِ لَذَّ لَهُ الكَرى","أَبيتُ كَأَنّي مُثخَن بِجِراح",64,"ح",1,0],["إِذا ما خَلا مِن قَلب ذا خاطر اِمرىءٍ","فَذلِك من جنس البَهائِم فادره",65,"ر",2,0],["إِذا ما خدمتَ كبار الملوك","فأَولُّ ما تخدُمِ الحاشيه",66,"ه",1,1],["اذا ما خط في طرس سطورا","فذلك للعديم مغاص در",67,"ر",1,0],["اذا ما خط في ورق تبدى","لنا ورقا وفاق على الجمان",68,"ن",1,0],["إذا ما خط طرسا خلت درا","يفصّل بين هاتيك الفضول",69,"ل",1,0],["إذا ما خبت وهنا من الليل شبها","من المندلي المستجاد ثقوب",70,"ب",1,0],["إذا ما خُدعتَ ببعضِ البشرْ","وكنتَ تراهم بأبهى الصورْ",71,"ر",1,1],["إذا ما خصَّ قوماً دون قومٍ","فخارٌ..فالندى فينا أعمُّ",72,"م",1,0],["إذا ما خاض بحر الحرب يوماً","بهِ غرقت أعاديهِ الطعامُ",73,"م",1,0],["إذاما خالطت بشرا","فليست منهما أبدا",74,"د",2,0],["إذا ما خزنتُ اشتياقي إليك","تضيء عيوني على منكبيكِ",75,"ك",1,0],["إذا ما خفَّ أو نهضَ النواجي","مشتْ منها الحصيرة َ والظليعُ",76,"ع",1,0],["إِذَا مَاخُضْتُ في المَيْدَانِ حَرْباً",