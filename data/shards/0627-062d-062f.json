ز السبق مولانا الحريزي","https://www.aldiwan.net/poem38108.html","البسيط"],[272,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[276,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[283,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[306,"الصبح باد بأفلاك السياسات","https://www.aldiwan.net/poem56587.html","الطويل"],[339,"مني السلام على الدنيا وبهجتها","https://www.aldiwan.net/poem68660.html","السريع"],[347,"لم تنم مقلتي لطول بكاها","https://www.aldiwan.net/poem24117.html","الخفيف"],[354,"أحدوثة أحدثت بين الورى عجبا","https://www.aldiwan.net/poem40549.html","البسيط"],[357,"زارت وليل غطمطم الظلما دجا","https://www.aldiwan.net/poem24535.html","الكامل"],[364,"لحافي لحاف الضيف والبيت بيته","https://www.aldiwan.net/poem1739.html","الطويل"],[365,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[365,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[365,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[365,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[372,"أحديث نفسي أم سمر","https://www.aldiwan.net/poem57452.html","مجزوء الكامل"],[403,"وسارق لمعاني الشعر من لي لو","https://www.aldiwan.net/poem46472.html","البسيط"],[410,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[433,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[442,"لما أتى الزير موسى يسأل الباري","https://www.aldiwan.net/poem14407.html","البسيط"],[453,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[459,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[459,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[459,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[459,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[471,"يرى حسرة أن تصقب الدار مرة","https://www.aldiwan.net/poem4846.html","الطويل"],[478,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[483,"أحديقة رقّمت بوشي أزاهر","https://www.aldiwan.net/poem24435.html","عموديه"],[539,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"أرى كل ريح سوف تسكن مرة","https://www.aldiwan.net/poem52004.html","الطويل"],[576,"حكاك الطيف حتى في السوار","https://www.aldiwan.net/poem2945.html","الوافر"],[576,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[587,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["أحدق بالخطوب ولي جفونٌ","متى انطبقت كشفت بها الحجابا",0,"ب",2,0],["أَحَدُّ مِنَ العَذلِ المُطِلِّ عَلى الهَوى","وَأَرهَفُ مِن غَربِ النَوى في المَقاطِعِ",1,"ع",1,0],["أَحَدَّ عَلى الطَعنِ مِن صارِمِ","وَأَصفَحَ عَن زَلَّةِ العاثِرِ",2,"ر",1,0],["إِحدى أَخامِصِهِ رِقابُ عُداتِهِ","مِن سَيِّدِ بَلَغَ العُلى وَمَسودِ",3,"د",1,0],["أُحَدِّثُهُ سِرَّاً وَلِلْبَدْرِ نَحْوَنا","تَلَفُّتُ واشٍ وَالنُّجومُ تُصيخُ",4,"خ",1,0],["إحدى كِنانَةَ حلّتْ سَفْحَ كاظِمةٍ","غَداةَ سالَ بظُعْنِ الحيِّ واديها",5,"ي",3,0],["أُحَدِّثُكُمْ وهْوَ عنْ طُرْفَةِ","حَديثاً يَجُرُّ الى الحِرْفَةِ",6,"ه",1,1],["أَحدِث لَها تُحدِث لِوَصلِكَ إِنَّها","كُندٌ لِوَصلِ الزائِرِ المُعتادِ",7,"د",1,0],["أَحْدَثْتَ أُسْلُوباً وَكَنْتَ إِمَامَهُ","وَبَقِيتَ فَذّاً فِيهِ مَا لَكَ ثَانِ",8,"ن",1,0],["إِحدى بَني جَعفَرٍ بِأَرضِهِم","لَم تُمسِ مِنّي نَوباً وَلا قُرُبا",9,"ب",2,0],["إحدى محابسكَ القديمةِ فاحبسِ","واسأل معاهدها وإن لم تنبس",10,"س",1,0],["أحْدثَ الصَفع في دِماغ أبي أح","مَق لا شكَّ خفَّةً واختلاطا",11,"ط",2,1],["إحدى المصائب فاصبرْ يا ابنَ أمِّ لها","وهل على حدثان الدهر تعويلُ",12,"ل",1,0],["أحَدُّكَ عند لائمتي حديدٌ","وحدُّكَ عند منفعتي كليل",13,"ل",1,0],["إِحداهُما ظَفِرَت بِها مَقذوفَةٌ","فَكَأَنَّ صاعِقَةً أَصابَت دارا",14,"ر",2,0],["أُحَدِّثُهُ إِنَّ الحَديثَ مِنَ القِرى","وَتَعلَمُ نَفسي أَنَّهُ سَوفَ يَهجَعُ",15,"ع",1,0],["أُحَدِّثَكُم بِأَعجَبَ ماجَرى لي","وَأَصعَبَ مالَقيتُ مِنَ الفِراقِ",16,"ق",1,0],["أُحَدِّثُهُ إِذا غَفَلَ الرَقيبُ","وَأَسأَلُهُ الجَوابَ فَلا يُجيبُ",17,"ب",1,1],["إِحداهُما سَمينَةٌ وَالثانِيَه","عِظامُها مِنَ الهُزالِ بادِيَه",18,"ه",1,0],["أَحدَقتُمُ بِمَقَرِّهِ","فَتَرَكتُموهُ بِلا قَرار",19,"ر",1,0],["أَحَدُّ عَلى العَدُوِّ غِرارَ سَيفٍ","وَأَكرَمُ في الخُطوبِ نِجارَ عودِ",20,"د",1,0],["إِحدى النَوادِرِ مِن قِردٍ تَعَرُّضُهُ","مِن غَيرِ مَقدِرَةٍ لِلقَسوَرِ الضاري",21,"ر",2,0],["أُحدوثَةٌ عَجَبٌ أُنبيكَ عَن خَبَري","فيها وَعَن خَبَرِ الشاهِ بنِ ميكالِ",22,"ل",1,0],["إِحدى الحَوادِثِ شارَفَتكَ فَرَدَّها","دَفعُ الإِلَهِ وَصُنعُهُ المُتَتابِعُ",23,"ع",1,0],["إِحدى اللَواتي إِذا الحادي تَناوَلَها","مَدَّت لَها شَطَنَ القودِ العَياهيمِ",24,"م",1,0],["أحَدَّ الطيرَ شِلْوُكَ وهو بادٍ","لمُخترِقِ الجنائبِ والشَّمال",25,"ل",1,0],["أَحَداً وَفى لَكَ في الشَدا","ئِدِ إِن لَجَأتَ بِمَوثِقِ",26,"ق",1,0],["أَحدِث لِرَبِّكَ تَوبَةً","فَسَبيلُها لَكَ مُمكِنُ",27,"ن",1,0],["أُحدِثَت لَكِنَّني لَم أَرَها","مِثلَ ما كُنتُ أَرى كُلَّ سَنَه",28,"ه",1,0],["أُحَدَّثُهُم عَن بِرِّهِ دونَ سِرِّهِ","وَأُلحِفُ في تَعديدِ ما لِيَ يُتحِفُ",29,"ف",1,0],["أحْدَقَ الوَجْدُ بهِ مِنْ حَدَقٍ","كَحَلَتْ بالحسنِ مرضاها الصّحاح",30,"ح",1,0],["إِحدى بَني بَكرِ بنِ عَبدِ مَناهِ","بَينَ الكَثيبِ الفَردِ فَالأَمواهِ",31,"ه",1,1],["أحدِّثُ عنْ أهلِ التزهدِ والتقى","وأجلو معانيهم وما أنا منهمُ",32,"م",1,1],["أَحدَثَ الصَرمَ بَينَنا","إِذ بَدا قَولُ قائِلِ",33,"ل",1,0],["إِحدى بَني أَودٍ كَلِفتُ بِها","حَمَلَت بِلا تِرَةٍ لَنا وِترا",34,"ر",2,0],["إِحدى بُنَيّاتِ عَمّى دونَ مَنزِلِها","أَرضٌ بِقيعانِها القَيصومُ وَالشيحُ",35,"ح",1,0],["أَحدَثَت رَدعاً وَرَجعاً بَعدَما","طَمِعَ العائِدُ مِنّا بِالسَراح",36,"ح",1,0],["أُحَدِّثُ نَفسي وَالأَحاديثُ جَمَّةٌ","وَأَكبَرُ هَمّي وَالأَحاديثِ زَينَبُ",37,"ب",1,0],["أُحَدِّثُ عَنكِ النَفسَ إِذ لَستُ راجِعاً","إِلَيكَ فَحُزني في الفُؤادِ دَخيلُ",38,"ل",1,0],["أُحُدٌ وبَدْرٌ شاهِدانِ فما عَلى","مَنْ يَسْفَحُ الدَّمَ في الحقوقِ مَلامُ",39,"م",1,0],["أحداثُ دَهرٍ مَن يَسُسْها تَستقِمْ","بَعدَ الجُنوحِ ومَن يَرُضْها تَخْضَعِ",40,"ع",1,0],["أَحَدٌ إلهُكَ ما كَذبتَ وما لمن","يرجو النّجاةَ على سواهُ مُعَوَّلُ",41,"ل",1,0],["إِحداهُما صارِمٌ مِن فَوقَ عاتِقِهِ","وَأُختُها عَلَمٌ في الكَفِّ يَرفَعُهُ",42,"ع",2,0],["إحدى الثنايا النِّيرا","تِ بَدَتْ وليس لها شَبه",43,"ب",2,0],["أُحَدِّثُ المَوْلَى الحَدِيثَ الّذي","جَرَى عليهم بالخيطِ وَالإِبْرَهْ",44,"ر",2,0],["أُحَدِّثُ الناسَ أَنّي قَد وَقَعتُ لَهُم","مِن وَجهِ حُسنٍ عَلى الأَمرِ الَّذي جَهِلوا",45,"ل",3,0],["أَحَديثٌ مِنها رَماهُ بِطَبٍّ","لَيتَهُ ماتَ قَبلَها فَاِستَراحا",46,"ح",2,0],["إِحدى بَلِيٍّ وَما هامَ الفُؤادُ بِها","إِلّا السَفاهَ وَإِلّا ذِكرَةً حُلُما",47,"م",2,0],["أحدِ الخَمْسَةِ الذينَ هُمُ الأغْ","راضُ في كلّ مَنْطِقٍ والمَعاني",48,"ن",2,0],["أَحدثتني الأيام عَن غير قصد","فَهي مدفوعة إلى إحداثي",49,"ث",2,0],["أَحدثتني وبعد ما أَحدثتني","أَلبثتني فَلَم تطل إِلباثي",49,"ث",2,0],["إِحدى المَصائِبِ حَلَّت في دِيارِ بَني","عِمرانَ لَيسَت لَها أُختٌ وَلا مَثَلُ",50,"ل",1,0],["أَحَدُ الفَرْقَدَيْنِ مِنْ آلِ زَغْلُو","لَ وَحَسْبُ الفَخَارِ مَجْدٌ تُؤَامُ",51,"م",1,0],["أَحْدَثْتَ فِيهَا أُمةً أَنْدَى يَداً","لِلصَّالِحَاتِ وَبِالعَظائِمِ أَكْلفَا",52,"ف",2,0],["أَحْدَثُ مَا جَاءَتْ بِهِ طُرفَة","بَدِيعَةٌ فِي أَدَبِ العَصْرِ",53,"ر",1,0],["أَحْدَثُوا فِي البِلاَدِ عَهْدَ لَجَاجٍ","فِي تَقَاضِي حُقُوقِهَا وَعِنَادِ",54,"د",1,0],["إحْدَى ثَلاَثٍ نَرجُو مَزِيداً","لَهُنَّ يَأْتِي عَلَى الوَلاَءِ",55,"ا",2,0],["أَحْدَثَ لِلْضَّادِ وَتَارِيخِهَا","فَتْحاً وَلَمْ يُبْقِ عَلَى مُغْلقِ",56,"ق",1,0],["إِحْدَى الْعَجَائِبِ فِي بِلاَدٍ لَمْ تَزَلْ","مِنْ مَبْدَإِ الدُّنْيَا بِلاَدَ عَجَائِبِ",57,"ب",1,0],["إِحْدَى الْقُوَى الأَرْبَعِ اللَّوَاتِي","فِي الخَلْقِ سُلْطَانُهَا تَغَلَّبْ",58,"ب",1,0],["إحدى الشموع الذائبا","ت أمام هيكلك الرهيب",59,"ب",1,0],["أَحدَثَ الأُمور لِما","شاءَ مِن تَغَيُّرِها",60,"ر",3,0],["اِحدُ يا بَرقَ السَحابِ لَهُ","مِن جُفوني ما رَسا أَحُدُ",61,"د",1,0],["أحدُّ من الظبا وقعًا، وأندَى","على الأكباد من ماء بَرود",62,"د",1,0],["أحْدثَ الصَّفع في دِماغِ أبي أحْ","مَق لا شكَّ خف واختلاطا",63,"ط",2,1],["أحدثتْ ردعاً ورجعاً، بعدما","طَمِعَ العَائِدُ مِنَّا بِکلسَّرَاحْ",64,"ح",1,0],["أحدثتَ في اللغة الفصحى حوادث لم","تعهد وشر لغى الانسان ما جُهِلا",65,"ل",2,0],["إحَدى الكواعب من بنى نصِر","شهِد الظلامُ لها على البدرِ",66,"ر",1,1],["إِحدى وَعِشرينَ لا تَذكيرَ يَدخُلُها","طُرّاً وَتَأنيثُها في النَحوِ يُعتَقَدُ",67,"د",1,0],["إحدى النّوائبِ في الصّبابةِ أنّني","كنتُ الأمينَ فصرتُ فيها سارِقا",68,"ق",2,0],["أَحدُّ رِجالِ العِقد ذِهناً وَنَظرةً","وَأَصَدَقُهُم في الأَمرِ رَأَياً وَمَشهَدا",69,"د",2,0],["أُحداً خَندقاً وفتحاً حُنينا","وَأَذاق اليهودَ والعربَ هونا",70,"ن",2,0],["أُحُدٌ شاقَهُم وَأَكنافُ سَلعٍ","لا رَوابي نَجدٍ وَلا الدَهناءُ",71,"ا",2,0],["أُحدٌ لا يلام فهو مُحبٌّ","وَلَكم أطربَ المحبّ لقاءُ",71,"ا",2,0],["أحدّث النفس عنك خاليةً","بالوصل كيما أسّرها خدعا",72,"ع",2,0],["أَحَدُّ مِنَ البيضِ الرِقاقِ عَزائِماً","وَأَمضى جَناناً مِن أُسودِ الشَرى السودِ",73,"د",1,0],["أُحَدِّثُكُمْ بِأَنِّي مُسْتَهَامٌ","وَكَائِنْ مِنْ حَدِيثٍ ذُو شُجُونِ",74,"ن",1,0],["إحدى مصائب أيامي لواحظه","كأنما هي سيفي وهو سيفي",75,"ي",1,0],["أَحدث الخلق بين كاف وَنون","مَن يَكون المراد حين يَقول",76,"ل",1,0],["أَحَدّ لِسَانَ الشُّكْرِ جلْبُ المنائِح","فَلا غرْوَ أنْ غارَتْ عيون المَدَائِح",77,"ح",1,1],["أَحداقُ نَرجِسِها تَرنو فَأَدمُعُها","فيها تَرَقرَقُ أَحياناً وَتَنحَدِرُ",78,"ر",1,0],["أَحدّ من أعين خفشٍ لَواحظها","حتّى نَبت عن حناديسِ الجهالاتِ",79,"ت",1,0],["إِحدى وَسَبعونَ لَو مَرَّت عَلى حَجر","لَكانَ مِن حُكمِهِ يُفلِقَ الحَجَرُ",80,"ر",1,0],["أَحدَثَت مُقلَتي بِإِدمانِها الدَم","عَ وَهِجرانِها الكَرى مُقلَتاها",81,"ا",3,0],["أحدوثة أَحدثت بَينَ الوَرى عَجَبا","فَما لَها مِن نَظير في الحَداديثِ",82,"ث",1,1],["احدى الدراري درة وجبينها","مثل الغزالة لوبدا وتبرجا",83,"ج",2,0],["أُحَدِّثُهُ إِنَّ الحَديثَ مِن القِرى","وَتَكلَأُ عَيني عَينَهُ حينَ يَهجَعُ",84,"ع",1,0],["إحدى ثلاثينَ مِثْلِ العِقْدِ قد نُظِمَتْ","غُرّاً تبارى بأنوار تُجَليِّها",85,"ي",3,0],["أَحْدَبُ القَدِّ مُحكَمُ الشَّدِّ في حلْ","قهِ شَطْرُ الحَنِيَّةِ المِرْنان",86,"ن",1,0],["إحدى عظيماتِ الزّمانِ مُلِمّةٌ","ذِيدَتْ عنِ الإسلام بعدَ تَوَرُّد",87,"د",1,0],["إحدى كراماتي بمَدحِك أنني","نَظّمْتُ دُرا وهْو غيرُ مُثقَّب",88,"ب",1,0],["أحديثُ نَفسي أم سَمَر","أم بعضُ وسوسَةِ الفِكَر",89,"ر",1,1],["أَحدو إليهِ القَوافي العُونَ وهيَ إذاً","ما بَيْنَ مُقْتربٍ منّي ومُبْتعدِ",90,"د",1,0],["أُحدِّثُ عنكَ بالسُّلوانِ نَفسي","وهَل تَسلو مُوَلَّهَةٌ ثَكولُ",91,"ل",1,0],["أحدقتِ الشمسُ بها مثلَ ما","تحدِقُ بالمُقلةِ أشْفارُ",92,"ر",1,0],["أَحد وَرضوى وورقان فقد نزلت","حول المدينة عنها لمح أَبصار",93,"ر",1,0],["أحدق الروضُ به واطردتْ","حوله الغدرُ وفاحَ الأرَجُ",94,"ج",1,0],["أُحدوثة تنسَخ الغليلَ فيل","تام من القلب غيرُ ملتئمِ",95,"م",1,0],["أحدّوا أظافيري فلم أحتلبهمُ","ولا لحمَ إلا ما أرى فيه مَعرَقا",96,"ق",2,0],["أحدَّ بنصره نابَيَّ حتّى","فَرَسْتُ به الخطوبَ وهنُّ أُسْدُ",97,"د",1,0],["أُحدّثُ نفسي خالياً بخلودها","فأين أبي الأدنىَ وأين أقاربي",98,"ب",2,0],["أُحَدِّثُ أني قَد سَلَوتُ وَكُلَّما","تَذَكَّرتُها كَانَ الفُؤادُ يَطيرُ",99,"ر",1,0],["أحدو لها بقريضي وهي جانحةٌ","تؤمُّ مِن هضباتِ المنحنى حَضَنا",100,"ن",2,0],["أحديقة رقّمت بوشي أزاهر","من لؤلؤ كقطائف بياض",101,"ض",1,1],["أحدَقوا بِهِم ونادَوا هلُمُّوا","واعلَموا مِن هَلاَكِكُم لا مَفَرَّا",102,"ر",2,0],["أَحداجُ تِلكَ الجِمالِ","مَشحونَةٌ بِالجَمالِ",103,"ل",1,1],["أحدهم يعلم فيمن ملكه","أفضل منه فيهم فتركه",104,"ه",1,0],["أَحدثه إِن الحَديثَ من القرى","وَتعرف نفسي انه سوف يهجَعُ",105,"ع",1,0],["أَحَدْتُكِ فيكِ واصفرَّت سَقَامَا","ديارُكِ بالبنفسجِ والبَهَارِ",106,"ر",1,0],["أُحَدِّثُ عنكمْ أَنَّ بُعْدكُمُ دنا","فلا أَنتُم إِن صَحَّ هذا ولا أَنا",107,"ن",2,1],["إِحْدَى الأَعاجيبِ عِنْدِي مِنْهُ لو وُصِفَتْ","لَكَانَ وَصْفي لَهَا إِحْدى الأَعاجِيبِ",108,"ب",1,0]]}