7864",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5837,"ياناقد الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=181442",""],[5837,"كسر الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=191880",""],[5848,"ضحكة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=49221",""],[5848,"أحد ينام وحط راسه","https://www.poetsgate.com/ViewPoem.aspx?id=48835",""],[5851,"ضوء قراح","https://www.poetsgate.com/ViewPoem.aspx?id=175304",""],[5853,"(( ورثتُ الحسنَ))","https://www.poetsgate.com/ViewPoem.aspx?id=175666",""],[5936,"هذاك إبن ناشي","https://www.poetsgate.com/ViewPoem.aspx?id=184773",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"إنكم خيرُ المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=194379",""],[5956,"متأكدٌ أنا من مروءة حاتم","https://www.poetsgate.com/ViewPoem.aspx?id=194658",""],[5976,"الحب بقلوب المخاليق","https://www.poetsgate.com/ViewPoem.aspx?id=30822",""],[5997,"براءة","https://www.poetsgate.com/ViewPoem.aspx?id=214220",""],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""],[6056,"عكّر الله مزاجه","https://www.poetsgate.com/ViewPoem.aspx?id=130324",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6056,"صديق اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=156695",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""],[6093,"نخلة النقد","https://www.poetsgate.com/ViewPoem.aspx?id=200148",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6115,"نوادر الشعر تشبه جمّ عذبٍ زلال","https://www.poetsgate.com/ViewPoem.aspx?id=186438",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""],[5555,"مَلاعِبُنَا الأُولَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87420&r=&rc=15",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[6291,"رحلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87674&r=&rc=8",""]],"verses":[["أحدق بالخطوب ولي جفونٌ","متى انطبقت كشفت بها الحجابا",0,"ب",2,0],["أَحَدُّ مِنَ العَذلِ المُطِلِّ عَلى الهَوى","وَأَرهَفُ مِن غَربِ النَوى في المَقاطِعِ",1,"ع",1,0],["أَحَدَّ عَلى الطَعنِ مِن صارِمِ","وَأَصفَحَ عَن زَلَّةِ العاثِرِ",2,"ر",1,0],["إِحدى أَخامِصِهِ رِقابُ عُداتِهِ","مِن سَيِّدِ بَلَغَ العُلى وَمَسودِ",3,"د",1,0],["أُحَدِّثُهُ سِرَّاً وَلِلْبَدْرِ نَحْوَنا","تَلَفُّتُ واشٍ وَالنُّجومُ تُصيخُ",4,"خ",1,0],["إحدى كِنانَةَ حلّتْ سَفْحَ كاظِمةٍ","غَداةَ سالَ بظُعْنِ الحيِّ واديها",5,"ي",3,0],["أُحَدِّثُكُمْ وهْوَ عنْ طُرْفَةِ","حَديثاً يَجُرُّ الى الحِرْفَةِ",6,"ه",1,1],["أَحدِث لَها تُحدِث لِوَصلِكَ إِنَّها","كُندٌ لِوَصلِ الزائِرِ المُعتادِ",7,"د",1,0],["أَحْدَثْتَ أُسْلُوباً وَكَنْتَ إِمَامَهُ","وَبَقِيتَ فَذّاً فِيهِ مَا لَكَ ثَانِ",8,"ن",1,0],["إِحدى بَني جَعفَرٍ بِأَرضِهِم","لَم تُمسِ مِنّي نَوباً وَلا قُرُبا",9,"ب",2,0],["إحدى محابسكَ القديمةِ فاحبسِ","واسأل معاهدها وإن لم تنبس",10,"س",1,0],["أحْدثَ الصَفع في دِماغ أبي أح","مَق لا شكَّ خفَّةً واختلاطا",11,"ط",2,1],["إحدى المصائب فاصبرْ يا ابنَ أمِّ لها","وهل على حدثان الدهر تعويلُ",12,"ل",1,0],["أحَدُّكَ عند لائمتي حديدٌ","وحدُّكَ عند منفعتي كليل",13,"ل",1,0],["إِحداهُما ظَفِرَت بِها مَقذوفَةٌ","فَكَأَنَّ صاعِقَةً أَصابَت دارا",14,"ر",2,0],["أُحَدِّثُهُ إِنَّ الحَديثَ مِنَ القِرى","وَتَعلَمُ نَفسي أَنَّهُ سَوفَ يَهجَعُ",15,"ع",1,0],["أُحَدِّثَكُم بِأَعجَبَ ماجَرى لي","وَأَصعَبَ مالَقيتُ مِنَ الفِراقِ",16,"ق",1,0],["أُحَدِّثُهُ إِذا غَفَلَ الرَقيبُ","وَأَسأَلُهُ الجَوابَ فَلا يُجيبُ",17,"ب",1,1],["إِحداهُما سَمينَةٌ وَالثانِيَه","عِظامُها مِنَ الهُزالِ بادِيَه",18,"ه",1,0],["أَحدَقتُمُ بِمَقَرِّهِ","فَتَرَكتُموهُ بِلا قَرار",19,"ر",1,0],["أَحَدُّ عَلى العَدُوِّ غِرارَ سَيفٍ","وَأَكرَمُ في الخُطوبِ نِجارَ عودِ",20,"د",1,0],["إِحدى النَوادِرِ مِن قِردٍ تَعَرُّضُهُ","مِن غَيرِ مَقدِرَةٍ لِلقَسوَرِ الضاري",21,"ر",2,0],["أُحدوثَةٌ عَجَبٌ أُنبيكَ عَن خَبَري","فيها وَعَن خَبَرِ الشاهِ بنِ ميكالِ",22,"ل",1,0],["إِحدى الحَوادِثِ شارَفَتكَ فَرَدَّها","دَفعُ الإِلَهِ وَصُنعُهُ المُتَتابِعُ",23,"ع",1,0],["إِحدى اللَواتي إِذا الحادي تَناوَلَها","مَدَّت لَها شَطَنَ القودِ العَياهيمِ",24,"م",1,0],["أحَدَّ الطيرَ شِلْوُكَ وهو بادٍ","لمُخترِقِ الجنائبِ والشَّمال",25,"ل",1,0],["أَحَداً وَفى لَكَ في الشَدا","ئِدِ إِن لَجَأتَ بِمَوثِقِ",26,"ق",1,0],["أَحدِث لِرَبِّكَ تَوبَةً","فَسَبيلُها لَكَ مُمكِنُ",27,"ن",1,0],["أُحدِثَت لَكِنَّني لَم أَرَها","مِثلَ ما كُنتُ أَرى كُلَّ سَنَه",28,"ه",1,0],["أُحَدَّثُهُم عَن بِرِّهِ دونَ سِرِّهِ","وَأُلحِفُ في تَعديدِ ما لِيَ يُتحِفُ",29,"ف",1,0],["أحْدَقَ الوَجْدُ بهِ مِنْ حَدَقٍ","كَحَلَتْ بالحسنِ مرضاها الصّحاح",30,"ح",1,0],["إِحدى بَني بَكرِ بنِ عَبدِ مَناهِ","بَينَ الكَثيبِ الفَردِ فَالأَمواهِ",31,"ه",1,1],["أحدِّثُ عنْ أهلِ التزهدِ والتقى","وأجلو معانيهم وما أنا منهمُ",32,"م",1,1],["أَحدَثَ الصَرمَ بَينَنا","إِذ بَدا قَولُ قائِلِ",33,"ل",1,0],["إِحدى بَني أَودٍ كَلِفتُ بِها","حَمَلَت بِلا تِرَةٍ لَنا وِترا",34,"ر",2,0],["إِحدى بُنَيّاتِ عَمّى دونَ مَنزِلِها","أَرضٌ بِقيعانِها القَيصومُ وَالشيحُ",35,"ح",1,0],["أَحدَثَت رَدعاً وَرَجعاً بَعدَما","طَمِعَ العائِدُ مِنّا بِالسَراح",36,"ح",1,0],["أُحَدِّثُ نَفسي وَالأَحاديثُ جَمَّةٌ","وَأَكبَرُ هَمّي وَالأَحاديثِ زَينَبُ",37,"ب",1,0],["أُحَدِّثُ عَنكِ النَفسَ إِذ لَستُ راجِعاً","إِلَيكَ فَحُزني في الفُؤادِ دَخيلُ",38,"ل",1,0],["أُحُدٌ وبَدْرٌ شاهِدانِ فما عَلى","مَنْ يَسْفَحُ الدَّمَ في الحقوقِ مَلامُ",39,"م",1,0],["أحداثُ دَهرٍ مَن يَسُسْها تَستقِمْ","بَعدَ الجُنوحِ ومَن يَرُضْها تَخْضَعِ",40,"ع",1,0],["أَحَدٌ إلهُكَ ما كَذبتَ وما لمن","يرجو النّجاةَ على سواهُ مُعَوَّلُ",41,"ل",1,0],["إِحداهُما صارِمٌ مِن فَوقَ عاتِقِهِ","وَأُختُها عَلَمٌ في الكَفِّ يَرفَعُهُ",42,"ع",2,0],["إحدى الثنايا النِّيرا","تِ بَدَتْ وليس لها شَبه",43,"ب",2,0],["أُحَدِّثُ المَوْلَى الحَدِيثَ الّذي","جَرَى عليهم بالخيطِ وَالإِبْرَهْ",44,"ر",2,0],["أُحَدِّثُ الناسَ أَنّي قَد وَقَعتُ لَهُم","مِن وَجهِ حُسنٍ عَلى الأَمرِ الَّذي جَهِلوا",45,"ل",3,0],["أَحَديثٌ مِنها رَماهُ بِطَبٍّ","لَيتَهُ ماتَ قَبلَها فَاِستَراحا",46,"ح",2,0],["إِحدى بَلِيٍّ وَما هامَ الفُؤادُ بِها","إِلّا السَفاهَ وَإِلّا ذِكرَةً حُلُما",47,"م",2,0],["أحدِ الخَمْسَةِ الذينَ هُمُ الأغْ","راضُ في كلّ مَنْطِقٍ والمَعاني",48,"ن",2,0],["أَحدثتني الأيام عَن غير قصد","فَهي مدفوعة إلى إحداثي",49,"ث",2,0],["أَحدثتني وبعد ما أَحدثتني","أَلبثتني فَلَم تطل إِلباثي",49,"ث",2,0],["إِحدى المَصائِبِ حَلَّت في دِيارِ بَني","عِمرانَ لَيسَت لَها أُختٌ وَلا مَثَلُ",50,"ل",1,0],["أَحَدُ الفَرْقَدَيْنِ مِنْ آلِ زَغْلُو","لَ وَحَسْبُ الفَخَارِ مَجْدٌ تُؤَامُ",51,"م",1,0],["أَحْدَثْتَ فِيهَا أُمةً أَنْدَى يَداً","لِلصَّالِحَاتِ وَبِالعَظائِمِ أَكْلفَا",52,"ف",2,0],["أَحْدَثُ مَا جَاءَتْ بِهِ طُرفَة","بَدِيعَةٌ فِي أَدَبِ العَصْرِ",53,"ر",1,0],["أَحْدَثُوا فِي البِلاَدِ عَهْدَ لَجَاجٍ","فِي تَقَاضِي حُقُوقِهَا وَعِنَادِ",54,"د",1,0],["إحْدَى ثَلاَثٍ نَرجُو مَزِيداً","لَهُنَّ يَأْتِي عَلَى الوَلاَءِ",55,"ا",2,0],["أَحْدَثَ لِلْضَّادِ وَتَارِيخِهَا","فَتْحاً وَلَمْ يُبْقِ عَلَى مُغْلقِ",56,"ق",1,0],["إِحْدَى الْعَجَائِبِ فِي بِلاَدٍ لَمْ تَزَلْ","مِنْ مَبْدَإِ الدُّنْيَا بِلاَدَ عَجَائِبِ",57,"ب",1,0],["إِحْدَى الْقُوَى الأَرْبَعِ اللَّوَاتِي","فِي الخَلْقِ سُلْطَانُهَا تَغَلَّبْ",58,"ب",1,0],["إحدى الشموع الذائبا","ت أمام هيكلك الرهيب",59,"ب",1,0],["أَحدَثَ الأُمور لِما","شاءَ مِن تَغَيُّرِها",60,"ر",3,0],["اِحدُ يا بَرقَ السَحابِ لَهُ","مِن جُفوني ما رَسا أَحُدُ",61,"د",1,0],["أحدُّ من الظبا وقعًا، وأندَى","على الأكباد من ماء بَرود",62,"د",1,0],["أحْدثَ الصَّفع في دِماغِ أبي أحْ","مَق لا شكَّ خف واختلاطا",63,"ط",2,1],["أحدثتْ ردعاً ورجعاً، بعدما","طَمِعَ العَائِدُ مِنَّا بِکلسَّرَاحْ",64,"ح",1,0],["أحدثتَ في اللغة الفصحى حوادث لم","تعهد وشر لغى الانسان ما جُهِلا",65,"ل",2,0],["إحَدى الكواعب من بنى نصِر","شهِد الظلامُ لها على البدرِ",66,"ر",1,1],["إِحدى وَعِشرينَ لا تَذكيرَ يَدخُلُها","طُرّاً وَتَأنيثُها في النَحوِ يُعتَقَدُ",67,"د",1,0],["إحدى النّوائبِ في الصّبابةِ أنّني","كنتُ الأمينَ فصرتُ فيها سارِقا",68,"ق",2,0],["أَحدُّ رِجالِ العِقد ذِهناً وَنَظرةً","وَأَصَدَقُهُم في الأَمرِ رَأَياً وَمَشهَدا",69,"د",2,0],["أُحداً خَندقاً وفتحاً حُنينا","وَأَذاق اليهودَ والعربَ هونا",70,"ن",2,0],["أُحُدٌ شاقَهُم وَأَكنافُ سَلعٍ","لا رَوابي نَجدٍ وَلا الدَهناءُ",71,"ا",2,0],["أُحدٌ لا يلام فهو مُحبٌّ","وَلَكم أطربَ المحبّ لقاءُ",71,"ا",2,0],["أحدّث النفس عنك خاليةً","بالوصل كيما أسّرها خدعا",72,"ع",2,0],["أَحَدُّ مِنَ البيضِ الرِقاقِ عَزائِماً","وَأَمضى جَناناً مِن أُسودِ الشَرى السودِ",73,"د",1,0],["أُحَدِّثُكُمْ بِأَنِّي مُسْتَهَامٌ","وَكَائِنْ مِنْ حَدِيثٍ ذُو شُجُونِ",74,"ن",1,0],["إحدى مصائب أيامي لواحظه","كأنما هي سيفي وهو سيفي",75,"ي",1,0],["أَحدث الخلق بين كاف وَنون","مَن يَكون المراد حين يَقول",76,"ل",1,0],["أَحَدّ لِسَانَ الشُّكْرِ جلْبُ المنائِح","فَلا غرْوَ أنْ غارَتْ عيون المَدَائِح",77,"ح",1,1],["أَحداقُ نَرجِسِها تَرنو فَأَدمُعُها","فيها تَرَقرَقُ أَحياناً وَتَنحَدِرُ",78,"ر",1,0],["أَحدّ من أعين خفشٍ لَواحظها","حتّى نَبت عن حناديسِ الجهالاتِ",79,"ت",1,0],["إِحدى وَسَبعونَ لَو مَرَّت عَلى حَجر","لَكانَ مِن حُكمِهِ يُفلِقَ الحَجَرُ",80,"ر",1,0],["أَحدَثَت مُقلَتي بِإِدمانِها الدَم","عَ وَهِجرانِها الكَرى مُقلَتاها",81,"ا",3,0],["أحدوثة أَحدثت بَينَ الوَرى عَجَبا","فَما لَها مِن نَظير في الحَداديثِ",82,"ث",1,1],["احدى الدراري درة وجبينها","مثل الغزالة لوبدا وتبرجا",83,"ج",2,0],["أُحَدِّثُهُ إِنَّ الحَديثَ مِن القِرى","وَتَكلَأُ عَيني عَينَهُ حينَ يَهجَعُ",84,"ع",1,0],["إحدى ثلاثينَ مِثْلِ العِقْدِ قد نُظِمَتْ","غُرّاً تبارى بأنوار تُجَليِّها",85,"ي",3,0],["أَحْدَبُ القَدِّ مُحكَمُ الشَّدِّ في حلْ","قهِ شَطْرُ الحَنِيَّةِ المِرْنان",86,"ن",1,0],["إحدى عظيماتِ الزّمانِ مُلِمّةٌ","ذِيدَتْ عنِ الإسلام بعدَ تَوَرُّد",87,"د",1,0],["إحدى كراماتي بمَدحِك أنني","نَظّمْتُ دُرا وهْو غيرُ مُثقَّب",88,"ب",1,0],["أحديثُ نَفسي أم سَمَر","أم بعضُ وسوسَةِ الفِكَر",89,"ر",1,1],["أَحدو إليهِ ا