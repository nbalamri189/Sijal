{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[3,"فخر الرجال سلاسل وقيود","https://www.aldiwan.net/poem149.html",""],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[35,"ولقد لقيت على الدريجة ليلة","https://www.aldiwan.net/poem39168.html","الكامل"],[27,"طاف الخيال وأين منك لماما","https://www.aldiwan.net/poem6018.html","الكامل"],[23,"أمسى الفتى عمرو بن عبد ثاويا","https://www.aldiwan.net/poem21359.html","الكامل"],[72,"نقلوا أنني سلوت هواك","https://www.aldiwan.net/poem19445.html","الخفيف"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[62,"تصعيد هذا الدهر والتصويب","https://www.aldiwan.net/poem52503.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[17,"أصبحت أفني عاديا وبقيت","https://www.aldiwan.net/poem1195.html",""],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[50,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[46,"أيا والي المصر لا تظلمن","https://www.aldiwan.net/poem23005.html","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9977","الكامل"],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[141,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[184,"لله ما أنا فيه أين تصرفي","https://www.aldiwan.net/poem43477.html","الكامل"],[193,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[259,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[268,"سيفي عشقت كما عشقت الحاجبا","https://www.aldiwan.net/poem35456.html","الكامل"],[278,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[369,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[399,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[429,"زادكَ الله جلالا","https://www.aldiwan.net/poem12536.html","مجزوء الرمل"],[429,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[436,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[462,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[462,"أو ما ترى حسن الغدير وقد جلا","https://www.aldiwan.net/poem3616.html","عموديه"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[567,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[573,"رقدت ولواحظ مسهري","https://www.aldiwan.net/poem2946.html","مجزوء الكامل"]],"verses":[["وَلَقَد لَبِستُ مِنَ القَناعَةِ جُبَّةً","تَضفو عَلَيَّ وَلا تَبينُ لِذامِ",0,"م",1,0],["وَلَقَد لَقيتُ المَوتَ يَومَ لَقيتُهُ","مُتَسَربِلاً وَالسَيفُ لَم يَتَسَربَلِ",1,"ل",1,0],["وَلَقَد لَقيتُ الفُرسَ يا اِبنَةَ مالِكٍ","وَجُيوشُها قَد ضاقَ عَنها البيدُ",2,"د",1,0],["وَلَقَد لَبِستُ العَيشَ أَج","مَعَ وَاِرتَدَيتُ مِنَ الإِبارَه",3,"ر",2,0],["وَلَقَد لَقيتَ عَلى الدُريجَةِ لَيلَةً","كانَت عَليكَ أَيامِنًا وَسُعودا",4,"د",2,1],["وَلَقَد لَقيتَ مَؤونَةً مِن حَربِنا","نَزَلَت عَلَيكَ وَأَلقَتِ الأَجراما",5,"م",2,0],["وَلَقَد لَقيتَ غَداةَ بَدرٍ عُصبَةً","ضَرَبوكَ ضَرباً غَيرَ ضَربِ الحُسَّرِ",6,"ر",1,0],["ولقد لام في ضنا الجسم لاهٍ","ما قضى ما قضيته في حماك",7,"ك",1,0],["ولقد لامها فأربت عليه","ورُقاهُ في مثلها لا تُحيك",8,"ك",1,0],["وَلَقَد لَجَأتُ إِلى الرَجاءِ فَعَقَّني","أَمّا الخَيالُ فَخائِبٌ مَدحورُ",9,"ر",1,0],["وَلَقَد لَبِستُ مِنَ السَوادِ شَعائِراً","حَتّى خَضِبتُ مِنَ الحِدادِ المَفرِقا",10,"ق",2,0],["ولقد لبستُ رداءَها فنزعتُه","عن عاتقَيَّ وهل يدومُ قَشيبُ",11,"ب",1,0],["وَلَقَد لَحِقتَ وَلَم تُقَصِّر دونَهُم","بَل قَد عَلِقتَ بِثُغرَةِ الأَضراسِ",12,"س",1,0],["وَلَقَد لَبِستَ عَساكِراً بِعَساكِرٍ","بِالغورِ فيها سادَةُ الوَسواسِ",12,"س",1,0],["وَلَقَد لَقيتُ فَما اِنتَفَعتُ ضَحِيَّةً","بِلِقاءِ مَن لا يُستَطاعُ كَلامُهُ",13,"م",2,0],["وَلَقَد لَبِستُ عَلى الزَمانِ جَديدَهُ","وَلَبِستُ إِخوانَ الصَبى فَبَليتُ",14,"ت",1,0],["وَلَقَد لَقَيتُ عَظيمَةً","مَحذورَةً وَحَمَلتُ عَبوا",15,"و",2,0],["وَلَقَد لَطَفتُ لَها بِجارِيَةٍ","رَوَتِ القَريضَ وَخالَطَت أَدَبا",16,"ب",2,0],["وَلَقَد لُمتُ أَن جَمَدَت أَدمُعي","وَما لُمتُ جَفنِيَ لَمّا ذَرَف",17,"ف",1,0],["وَلَقَد لَقيتُ شَدائِداً وَأَوابِداً","حَتّى اِرتَقَيتُ إِلى أَعَزَّ مَقامِ",18,"م",1,0],["ولقد لا تسر شيخاً حياة","هو منها ذاك القريب البعيد",19,"د",1,0],["وَلَقَد لَقيتَ جَمائِعاً فَشَلَلتَها","فَرداً كَما شَلَّ الخَميسُ نَعاما",20,"م",2,0],["ولقد لقيت من الزمان عجائبا","ولبست ثوب مفارق ومواصل",21,"ل",1,0],["وَلَقَد لَجَأتُ مِنَ الوَليدِ إِلى اِمرِئٍ","أَغنى وَلَيسَ مَن اِصطِفاهُ بِنادِمِ",22,"م",1,0],["ولقد لقيت هواك","أعظم ما لقيت وما ألاقي",23,"ق",2,0],["ولقد لهَوتُ بعقدها فكأنني","نلتُ الثريَّا والشهابَ الثاقبا",24,"ب",2,0],["وَلَقَدْ لَقِيتَ الْمَوْتَ يَوْمَ لَقِيتَهُ","كَرَماً بِأَنْجَدَ مِنْهُ ثَمَّ وَأَشْجَعِ",25,"ع",1,0],["ولقد لَبستُ ثيابَ نَف","سِكَ مالِكاً أو مُستَعيرا",26,"ر",2,0],["ولقد لجأتُ إليك مِنْ","دونِ الأَعاجِم والأعاربْ",27,"ب",1,0],["ولقد لُحْتَ لنا في","أفقِ المجدِ هِلالا",28,"ل",2,0],["ولقد لذتُ بالسلوّ ولكنْ","لم يساعدْ عليهِ قلبٌ خَفوقُ",29,"ق",1,0],["ولقد لَبِسْتَ إِلَيْهِ من حُللِ الهُدى","نوراً ثَنى نارَ الضَّلالَةِ خامِدَهْ",30,"د",2,0],["ولقد لحقتُ الأوّلين صبابة","من دمعي الجاري بأيّ سوابق",31,"ق",1,0],["ولقد لعمري جعّدتهُ يدُ الصّبا","لو كان يثبتُ في يمينِ اللامس",32,"س",1,0],["ولقد لبستُ بها الغَضا","رَةَ والنَّضارةَ في دُماها",33,"ا",3,0],["ولقد لبستَ من الزّمان جلالَه","وجلستَ منه في أعزّ مجالسِ",34,"س",1,0],["ولقد لَفَفْتَهُمُ بهمْ فكأنّما","حَضَّضْتَ بين ضراغمٍ في غابِ",35,"ب",1,0],["ولقد لبست جديده","حينا فلا يبعد مزاره",36,"ر",2,0],["ولقد لهوت كما أرد","ت بعبلة وبعنتر",37,"ر",1,0]]}