{"poems":[[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[64,"طلعت شمس من أحب بليل","https://www.aldiwan.net/poem67664.html","الخفيف"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"لأبي بكر كلام واحد لا يتعدى","https://www.aldiwan.net/poem11466.html","مجزوء الرمل"],[49,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[49,"من أحب الدنيا تحير فيها","https://www.aldiwan.net/poem63186.html","الخفيف"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[52,"من أحب البقاء دام عليه","https://www.aldiwan.net/poem26714.html","الخفيف"],[46,"من أحسن الدهر وقتا ساعة سلمت","https://www.aldiwan.net/poem22225.html","البسيط"],[46,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[4,"طلل لخولة بالرسيس قديم","https://www.poetsgate.com/ViewPoem.aspx?id=682",""],[46,"أنا، باللّيالي والحوادثِ، أخبرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20108",""],[51,"لأبي بكر كلامٌ","https://www.poetsgate.com/ViewPoem.aspx?id=27691",""],[116,"من أحرقت قلبه الدنيا بنائبة","https://www.aldiwan.net/poem41702.html","البسيط"],[161,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[183,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[186,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[232,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[260,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[283,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[299,"كم في أزاهير الرياض لناظر","https://www.aldiwan.net/poem36839.html","عموديه"],[321,"من أحرز الفضل الجليل بجده","https://www.aldiwan.net/poem67156.html","الكامل"],[392,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[404,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[440,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[459,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[464,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[469,"عندي من المدعون صينية","https://www.aldiwan.net/poem60312.html","السريع"],[501,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[563,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[563,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"]],"verses":[["مَنْ أحَبَّ الإحْسَانَ لَمْ يُرِهِ","دَهْرُهُ غَيْرَ وَجْهِهِ الحَسَنِ",0,"ن",1,0],["مِنّا حُماةُ الشَعبِ حينَ تَواكَلَت","أَسَدٌ وَذُبيانُ الصَفا وَتَميمُ",1,"م",1,0],["من أحمر للبرق عنه خبر","يشهدُ أن الحسن حقًّا أحمرُ",2,"ر",1,0],["مَن أَحَبَّ الحَبيب طارَ إِلَيهِ","اِشتِياقاً إِلى لِقاءِ الحَبيبِ",3,"ب",1,0],["من احتسبَ الأقدار أيقن فاستوتْ","لديه منيخات ومنتظَراتِ",4,"ت",1,0],["من أحدِّ الناس طرّاً","وأفلِّ الناس حدَّا",5,"د",2,0],["مَنَ اَحَسَّ لي أَهلَ القُبورِ وَمَن رَأى","مَنَ اَحَسُّهُم لي بَينَ أَطباقِ الثَرى",6,"ا",1,1],["مَنَ اَحَسَّ لي مَن كُنتُ آلَفُهُ وَيَأ","لَفُني فَقَد أَنكَرتُ بُعدَ المُلتَقى",6,"ا",1,0],["مَنَ اَحَسَّهُ لي إِذ يُعالِجُ غُصَّةً","مُتَشاغِلاً بِعِلاجِها عَمَّن دَعا",6,"ا",1,0],["مَنَ اَحَسَّهُ لي فَوقَ ظَهرِ سَريرِهِ","يَمشي بِهِ نَفَرٌ إِلى بَيتِ البِلى",6,"ا",1,0],["مَن أَحَبَّ الدُنيا تَحَيَّرَ فيها","وَاِكتَسى عَقلُهُ اِلتِباساً وَتيها",7,"ي",3,1],["مَن أَحمَرٍ وَأَصفَرٍ","وَأَخضَرٍ وَأَزرَقِ",8,"ق",1,0],["مِن أَحمَرٍ ساطِعٍ أَو أَخضَرٍ نَضِرٍ","أَو أَصفَرٍ فاقِعٍ أَو أَبيَضٍ يَقَقِ",9,"ق",1,0],["مِن أَحاديثَ حينَ دَوَّختَها بِالرَأ","يِ كانَت ضَعيفَةَ الإِسنادِ",10,"د",1,0],["مَن أَحَبَّ البَقاءَ دامَ عَلَيهِ","مَعَ طولِ البَقاءِ هَمٌّ طَويلُ",11,"ل",1,1],["مِن أَحسَنِ الدَهرِ وَقتاً ساعَةٌ سَلِمَت","مِنَ الشُرورِ وَفيها صاحِبٌ حَدَثُ",12,"ث",1,1],["مِن أَحسَنِ الأَحداثِ وَضعُكَ غابِراً","في التُربِ يَأكُلُهُ تُرابٌ أَغبَرُ",13,"ر",1,0],["من أحسن الأمثال فيما أحسبُ","الخبز لا يعطى ولكن يكسبُ",14,"ب",1,0],["مَنَّاحِ أَقْصَى العُذْرِ","مَنَّاعٍ لأَدْنَى العَذَلِ",15,"ل",1,0],["من أحرفٍ سوداء إلا أنه","نقشٌ يُريك الطيفَ في ألوانه",16,"ن",2,0],["من أحلَّ القريضَ من وزنه أو","من قوافيه، فَهْوَ شخصٌ إبَاحي",17,"ح",2,0],["مِنَّا حُماةُ الشِّعْبِ يوْمَ تَوَاكلتْ","أسَدٌ وّذُبْيانُ الصَّفا وتَمِيمُ",18,"م",1,0],["من أحسنِ الأحداثِ وضعُك غابراً","في التُّربِ، يأكلُهُ تُرابٌ أغير",19,"ر",1,0],["من أحدِّ الناس طراً","وأقلِّ الناس حدّا",20,"د",2,0],["من أحرقت قلبه الدنيا بنائبةٍ","من فقد أعيان خلان وأحباب",21,"ب",1,1],["من أحمر قانى أو اخضر نضر","وأصفر فاقع أو أبيض يقق",22,"ق",1,0],["مَناحَةٌ تَحتَ جنحِ اللَّيلِ قائمة","بِها الأَصيلُ خَضيب الذَّيلِ وَالسَّحرُ",23,"ر",1,0],["مَن أَحْنَفٌ من حاتم من يَعْرُب","من عنتر من قُسُّ من سَحْبان",24,"ن",1,0],["من أحمر قانٍ وأصفر فاقعٍ","نضرٍ وأبيض ناصع كالعاج",25,"ج",1,0],["من أحكموا في حبّه وثقى العُرى","علماً بأنّ الصيد في جوف الفرا",26,"ر",2,0],["منّاحُنا وَسواهُ منّاعٌ لَنا","هَل يَستَوي المَنّاعُ وَالمَنّاحُ",27,"ح",1,0],["من أَحمرِ الياقوتِ","بل من حَلالِ القوتِ",28,"ت",1,0],["من أحمر قانٍ وأصفر فاقِعٍ","أو أزرق زاهٍ وأبيض سافر",29,"ر",1,0],["مَن أَحرَزَ الفَضلَ الجَليلَ بِجِدِّهِ","وَاِمتازَ فينا بِالمَقامِ العالي",30,"ل",2,1],["من أحكم العادات قالوا ذا بلغ أعلى مقام","لو يترك الواجب ولو كان الملابس للحرام",31,"م",1,0],["من إحسان وبر","وتعليم ونفقات",32,"ت",1,0],["من أحاديث لنا رويت","ما بها نقد كمنتقده",33,"د",2,0],["من أَحرَزَ الغاياتِ أَدْنى شأْوِهِ","حَتَّى تقاصَرَ عن مساعِيهِ المَدى",34,"د",2,0],["من أحدثَ الغدرَ دِيناً فاستننت به","ومن أباحتك تعذيبي شرائعُهُ",35,"ع",2,0],["من احمد الحساد لما ساد وان","سد الفساد وقاد روساً عاتيه",36,"ي",2,0],["مِن أَحمَرٍ يَلمَعُ في أَبيَضٍ","كَأَنَّهُ البَقَّمُ في العاجِ",37,"ج",1,0],["مَنْ أحْكَمَ السَّيرَ بها على هُدًى","ومن عَداها ضَلَّ بالغَيِّ وَزَلْ",38,"ل",1,0],["مَناحةٌ عندنا في الأرضِ حافلةٌ","وعندهُ في الأعالي بَهجةُ العيدِ",39,"د",1,0],["مَناحةٌ في دِيارِ المَيْتِ قائِمةٌ","ودُعوةٌ في دِيارِ القبرِ تَحتَشِدُ",40,"د",1,0]]}