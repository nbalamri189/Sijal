{"poems":[[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[66,"طلعت شمس من أحب بليل","https://www.aldiwan.net/poem67664.html","الخفيف"],[53,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[53,"لأبي بكر كلام واحد لا يتعدى","https://www.aldiwan.net/poem11466.html","مجزوء الرمل"],[51,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[51,"من أحب الدنيا تحير فيها","https://www.aldiwan.net/poem63186.html","الخفيف"],[68,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[68,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[46,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[54,"من أحب البقاء دام عليه","https://www.aldiwan.net/poem26714.html","الخفيف"],[48,"من أحسن الدهر وقتا ساعة سلمت","https://www.aldiwan.net/poem22225.html","البسيط"],[48,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[108,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[4,"طلل لخولة بالرسيس قديم","https://www.poetsgate.com/ViewPoem.aspx?id=682",""],[48,"أنا، باللّيالي والحوادثِ، أخبرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20108",""],[53,"لأبي بكر كلامٌ","https://www.poetsgate.com/ViewPoem.aspx?id=27691",""],[119,"من أحرقت قلبه الدنيا بنائبة","https://www.aldiwan.net/poem41702.html","البسيط"],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[186,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[189,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[287,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"كم في أزاهير الرياض لناظر","https://www.aldiwan.net/poem36839.html","عموديه"],[325,"من أحرز الفضل الجليل بجده","https://www.aldiwan.net/poem67156.html","الكامل"],[396,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[409,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[445,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[468,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[473,"عندي من المدعون صينية","https://www.aldiwan.net/poem60312.html","السريع"],[505,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[567,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[567,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126672","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53889","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38242","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38170","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73978","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46551","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137870",""],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90719","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80024","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77856","الخفيف"],[1785,"","https://poetry.dctabudhabi.ae/diwan/poem/198827","المنسرح"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2426,"","https://poetry.dctabudhabi.ae/diwan/poem/138831",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140094",""],[2895,"","https://poetry.dctabudhabi.ae/diwan/poem/143704","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62869","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117964","السريع"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[1623,"","https://poetry.dctabudhabi.ae/diwan/poem/147579","المنسرح"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133285","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133277","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77080","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119670","الكامل"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4778,"شعب العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=198847",""],[4968,"معراج الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206757",""],[4988,"من احمد الرطبي تحيه والسلام","https://www.poetsgate.com/ViewPoem.aspx?id=174933",""],[5162,"ضاد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=196715",""],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[5277,"مريمُ..عليها السلام..القطوفُ القُدْسيّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=199954",""],[5277,"أبوابُ الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=212908",""],[5351,"غريبها","https://www.poetsgate.com/ViewPoem.aspx?id=202067",""],[5409,"قل لمن عاش كما عا","https://www.poetsgate.com/ViewPoem.aspx?id=155319",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5461,"فدوة عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=6232",""],[5561,"صوت وصدى","https://www.poetsgate.com/ViewPoem.aspx?id=205623",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5759,"كيف الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=213994",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[6152,"أحتاج قلبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203286",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["مَنْ أحَبَّ الإحْسَانَ لَمْ يُرِهِ","دَهْرُهُ غَيْرَ وَجْهِهِ الحَسَنِ",0,"ن",1,0],["مِنّا حُماةُ الشَعبِ حينَ تَواكَلَت","أَسَدٌ وَذُبيانُ الصَفا وَتَميمُ",1,"م",1,0],["من أحمر للبرق عنه خبر","يشهدُ أن الحسن حقًّا أحمرُ",2,"ر",1,0],["مَن أَحَبَّ الحَبيب طارَ إِلَيهِ","اِشتِياقاً إِلى لِقاءِ الحَبيبِ",3,"ب",1,0],["من احتسبَ الأقدار أيقن فاستوتْ","لديه منيخات ومنتظَراتِ",4,"ت",1,0],["من أحدِّ الناس طرّاً","وأفلِّ الناس حدَّا",5,"د",2,0],["مَنَ اَحَسَّ لي أَهلَ القُبورِ وَمَن رَأى","مَنَ اَحَسُّهُم لي بَينَ أَطباقِ الثَرى",6,"ا",1,1],["مَنَ اَحَسَّ لي مَن كُنتُ آلَفُهُ وَيَأ","لَفُني فَقَد أَنكَرتُ بُعدَ المُلتَقى",6,"ا",1,0],["مَنَ اَحَسَّهُ لي إِذ يُعالِجُ غُصَّةً","مُتَشاغِلاً بِعِلاجِها عَمَّن دَعا",6,"ا",1,0],["مَنَ اَحَسَّهُ لي فَوقَ ظَهرِ سَريرِهِ","يَمشي بِهِ نَفَرٌ إِلى بَيتِ البِلى",6,"ا",1,0],["مَن أَحَبَّ الدُنيا تَحَيَّرَ فيها","وَاِكتَسى عَقلُهُ اِلتِباساً وَتيها",7,"ي",3,1],["مَن أَحمَرٍ وَأَصفَرٍ","وَأَخضَرٍ وَأَزرَقِ",8,"ق",1,0],["مِن أَحمَرٍ ساطِعٍ أَو أَخضَرٍ نَضِرٍ","أَو أَصفَرٍ فاقِعٍ أَو أَبيَضٍ يَقَقِ",9,"ق",1,0],["مِن أَحاديثَ حينَ دَوَّختَها بِالرَأ","يِ كانَت ضَعيفَةَ الإِسنادِ",10,"د",1,0],["مَن أَحَبَّ البَقاءَ دامَ عَلَيهِ","مَعَ طولِ البَقاءِ هَمٌّ طَويلُ",11,"ل",1,1],["مِن أَحسَنِ الدَهرِ وَقتاً ساعَةٌ سَلِمَت","مِنَ الشُرورِ وَفيها صاحِبٌ حَدَثُ",12,"ث",1,1],["مِن أَحسَنِ الأَحداثِ وَضعُكَ غابِراً","في التُربِ يَأكُلُهُ تُرابٌ أَغبَرُ",13,"ر",1,0],["من أحسن الأمثال فيما أحسبُ","الخبز لا يعطى ولكن يكسبُ",14,"ب",1,0],["مَنَّاحِ أَقْصَى العُذْرِ","مَنَّاعٍ لأَدْنَى العَذَلِ",15,"ل",1,0],["من أحرفٍ سوداء إلا أنه","نقشٌ يُريك الطيفَ في ألوانه",16,"ن",2,0],["من أحلَّ القريضَ من وزنه أو","من قوافيه، فَهْوَ شخصٌ إبَاحي",17,"ح",2,0],["مِنَّا حُماةُ الشِّعْبِ يوْمَ تَوَاكلتْ","أسَدٌ وّذُبْيانُ الصَّفا وتَمِيمُ",18,"م",1,0],["من أحسنِ الأحداثِ وضعُك غابراً","في التُّربِ، يأكلُهُ تُرابٌ أغير",19,"ر",1,0],["من أحدِّ الناس طراً","وأقلِّ الناس حدّا",20,"د",2,0],["من أحرقت قلبه الدنيا بنائبةٍ","من فقد أعيان خلان وأحباب",21,"ب",1,1],["من أحمر قانى أو اخضر نضر","وأصفر فاقع أو أبيض يقق",22,"ق",1,0],["مَناحَةٌ تَحتَ جنحِ اللَّيلِ قائمة","بِها الأَصيلُ خَضيب الذَّيلِ وَالسَّحرُ",23,"ر",1,0],["مَن أَحْنَفٌ من حاتم من يَعْرُب","من عنتر من قُسُّ من سَحْبان",24,"ن",1,0],["من أحمر قانٍ وأصفر فاقعٍ","نضرٍ وأبيض ناصع كالعاج",25,"ج",1,0],["من أحكموا في حبّه وثقى العُرى","علماً بأنّ الصيد في جوف الفرا",26,"ر",2,0],["منّاحُنا وَسواهُ منّاعٌ لَنا","هَل يَستَوي المَنّاعُ وَالمَنّاحُ",27,"ح",1,0],["من أَحمرِ الياقوتِ","بل من حَلالِ القوتِ",28,"ت",1,0],["من أحمر قانٍ وأصفر فاقِعٍ","أو أزرق زاهٍ وأبيض سافر",29,"ر",1,0],["مَن أَحرَزَ الفَضلَ الجَليلَ بِجِدِّهِ","وَاِمتازَ فينا بِالمَقامِ العالي",30,"ل",2,1],["من أحكم العادات قالوا ذا بلغ أعلى مقام","لو يترك الواجب ولو كان الملابس للحرام",31,"م",1,0],["من إحسان وبر","وتعليم ونفقات",32,"ت",1,0],["من أحاديث لنا رويت","ما بها نقد كمنتقده",33,"د",2,0],["من أَحرَزَ الغاياتِ أَدْنى شأْوِهِ","حَتَّى تقاصَرَ عن مساعِيهِ المَدى",34,"د",2,0],["من أحدثَ الغدرَ دِيناً فاستننت به","ومن أباحتك تعذيبي شرائعُهُ",35,"ع",2,0],["من احمد الحساد لما ساد وان","سد الفساد وقاد روساً عاتيه",36,"ي",2,0],["مِن أَحمَرٍ يَلمَعُ في أَبيَضٍ","كَأَنَّهُ البَقَّمُ في العاجِ",37,"ج",1,0],["مَنْ أحْكَمَ السَّيرَ بها على هُدًى","ومن عَداها ضَلَّ بالغَيِّ وَزَلْ",38,"ل",1,0],["مَناحةٌ عندنا في الأرضِ حافلةٌ","وعندهُ في الأعالي بَهجةُ العيدِ",39,"د",1,0],["مَناحةٌ في دِيارِ المَيْتِ قائِمةٌ","ودُعوةٌ في دِيارِ القبرِ تَحتَشِدُ",40,"د",1,0],["مِن أحمد المختار طه أصله","مُتفرّع من فاطم الزهراءِ",41,"ا",2,0],["مَن أحنَفٌ في حِلمِهِ مَن حاتِمٌ في","جُودِهِ مَن عَمرُو في إقدامشهِ",42,"م",3,0],["مَنْ أَحبَّ المصطفى مَعْ آلِهِ","ليس نُكْراً أَن يُحبَّ ابنَ الحَسَنْ",43,"ن",1,0],["مِن أَحمرٍ فاخرٍ أَو أَبيَضٍ يَقق","قَد راقَ مَنظَرُهُ لِلنّفسِ وَالنّظرِ",44,"ر",1,0],["مَنْ أحقرُ الرّأي مِنهُ ثمَّ أَهونهُ","عَن شدَّةِ الحزمِ لَم يَبرحْ ولم يَحُلِ",45,"ل",1,0],["مِن أَحمرٍ زاهٍ وَأَصفَرَ فاقِعٍ","مِن أَخضرٍ غَضٍّ وَأَبيَض يحمدُ",46,"د",1,0],["من أحمد بن سعيد الأصل الذي","نارت عمان بعدله المتطاولِ",47,"ل",1,0],["من أحلّت له الغنائم لما","بحماة الهدى سبى الكفارا",48,"ر",2,0],["من أحكم التقوى أساساً وأتم","تفجرت فيه ينابيع الحكم",49,"م",1,0],["من أحمر باك وأبيض باسم","أو أصفر شاكٍ وأخضر شاكرٍ",50,"ر",1,0],["من أَحسن السياسه","دامَت لهُ الرِّئاسه",51,"ه",1,0],["مناحة انطون الذي كان بيننا","شهيرا كنار قد بدت فوق رابيه",52,"ي",2,0],["من أحسنِ الناسِ وَجهاً حينَ تُبصرُها","وأحذقِ الناسِ إن غنَّت بِطنبورِ",53,"ر",1,0],["من أحمدٍ قدرُه عليٌّ","ومن أخٍ للنهى خليل",54,"ل",1,0],["من أَحبائنا الَّذين بطا","سين أَقاموا كأنجم وَبدور",55,"ر",1,0],["من أحمر كالعقيق منظره","وأصفر كالفريد لم يثقبْ",56,"ب",1,0],["من احمد المختار منصبه","وحيدرة الشهامه",57,"م",2,0],["من أحمدٍ نجل زين الدين عبدكمُ","تقَبَّلوا يا بني طه وياسينا",58,"ن",2,0],["مِن أَحرُفِ الهِجَاءِ وهيَ الَّلام","معطفها القُطبُ فَكُن عَلاَّم",59,"م",1,0],["من أحمر مثل العقيق حسبته","أو أبيض مثل اللالي صفت",60,"ت",1,0],["من أحرق الجن برجم شهبه","أشوظة يقدمها نحاسه",61,"س",2,0],["من احمرٍ او اصفرٍ او ابيضٍ","كجوارِن الحَيّات في أَنحاهُ",62,"ا",2,0],["مَنْ أَحسنَ السعيَ فيما شاءَ فهو لهُ","الرزقُ بالسعي ثم الرزق بالقَسَمِ",63,"م",1,0],["من أَحاديثِ معشرٍ قَمَروا العزْ","زَ ويم يشعروا بجدعِ الأُنوفِ",64,"ف",1,0],["مَن أَحسَنَ استنقاذَ آل جهنَّمٍ","بالغِشِّ عمداً فَهوَ شَرُّ مُؤاسِ",65,"س",1,0],["من أحسن الظن بمحجوبة","من غير أن يسبر أحوالها",66,"ل",3,1],["من أحكم اللَه فيه عقد بيعته","والدين معتصم فيه ومنتصر",67,"ر",1,0],["من أحل ذا تحرمون رزقكم","لأنكم تكذبون في المدح",68,"ح",1,0],["من احتمى بحماه الرحب فهو له","غوث وغيث ومعوان ومتكل",69,"ل",1,0],["من احتمى بحماه الرحب كان له","عز وسعد وإقبال وتمحيد",70,"د",1,0],["مِنّا حَجابَة بَيت رَبِّ العَرشِ قَد","خَلَدَت لَهُم وَبَينَهُم الأَكياسِ",71,"س",1,0],["من أحسن الأتراك أضحى وجهها","والشَعر أمسى من بني السودان",72,"ن",1,0],["من أحمدِ المختارِ والمختارُ من","هُ انظرْ بأحداث الزمان وقائعه",73,"ع",2,0],["من أحسن الظن لأياً في عروبته","عانى العذاب وألقى السمع ما نبسا",74,"س",2,0],["مِن أَحْرُفِي يَتَهَاوَى التِّبْرُ مُنْتَشِرَا","يَغْزُو مَعَارِيجَ كُلِّ الشِّعْرِ مَثْمُولاَ",75,"ل",2,0],["من أحمد الرطبي تحيه .. والسلآم","حق آلخوآآلد من جنوب ا ليا شمآل",76,"ل",1,1],["مِنْ أحرفِي لو شئتُ أنسجُ سندساً","ضمختُهُ ألقاً بسحرِ بنانِي",77,"ن",2,0],["من أحمر مثل العقيق وأصفر","ومورّد زاهٍ كوجنة حاس",78,"س",1,0],["منْ أحصنتْ فرجاً، بهنَّ تُكرَّم","معنى الحياةِ، طهارةٌ لا تُكْلَمُ",79,"م",1,0],["منْ أحسنَ الظنَّ بربِّ الورى","قدْ فازَ في مسيرِهِ إنْ قصدْ",80,"د",1,0],["من أحرق العطر في أنفاس دندنتي","إلاك ِ من باعني للنار؟ إلاكِ",81,"ك",1,0],["من أحل السحت جهراً","وتلقاه كنعمه",82,"م",2,0],["مَنْ أحدقت باللبِّ صبوته","فليُلْتَمَسْ في خَطْبِهِ العُذرُُ",83,"ر",1,0],["من احتوته ليال لابزوغ بها","من مسّه غاز ذاك الوحش فاختنقا",84,"ق",2,0],["من أحبك ومن روحي أفديك","يامن غرامه والحسن فيه ثاير",85,"ر",1,0],["مَن أحسنَ في دُنياهُ تُقًى","أو زادَ صلاحًا نالَ هُدى",86,"د",2,0],["من (أحمد بن هلال) طار طائره","باليُمن من أفق بالنور مُتّسِمِ",87,"م",1,0],["مِن أحورِ الطرفِ مَن في وَجنتَيهِ دَمي","وفي الشِفاهِ وفي الخدّينِ والجيدِ",88,"د",1,0],["من أحمد في قتل آل المعيط","وسلعٍ وخيبر يوم وهام",89,"م",1,0],["من أحرقوا قلبي بنار غيابهم","كم يكسبون على الغياب ذنوبا!؟",90,"ب",2,0],["مَنْ أَحَبَّ الأرضَ حُبًّا صادقًا","كأَبي، لم يُطِلِ اللهُ احْتِضَارَهْ!",91,"ر",2,0]]}