{"poems":[[95,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[382,"دع راهبا لا يخدم الله ربه","https://www.aldiwan.net/poem59165.html","الطويل"],[438,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[556,"دع رجالا ينازعون على المال","https://www.aldiwan.net/poem47281.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63845","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101589","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36260","الدوبيت"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83193","الرجز"],[5038,"جمرة الخدين","https://www.poetsgate.com/ViewPoem.aspx?id=197669",""]],"verses":[["دَعْ رَاحَةً لا يَشْتَهِي مَنْ ذَاقَهَا","رُجْعَى إِلَى تَعَبِ الْحَيَاةِ المُؤْلِمِ",0,"م",1,0],["دع راهباً لا يخدمُ اللَه ربَّه","بحرصٍ ويمسي بالبطالة راضيا",1,"ي",2,1],["دعْ رماحَ الشَذا تمنّعَ عنها","فرضي أنّني بها مَكلومُ",2,"م",1,0],["دعْ رجالاً ينازعون على الما","ل ولا تحفِلَنْ بجمع المالِ",3,"ل",1,1],["دَعْ رفعَ زيدٍ في الكلامِ ونصبَهُ","ما النحوُ عندك أنت مما يُذْكَرُ",4,"ر",1,0],["دع رُبى نجدٍ وزينات العربْ","في خيام الشعر أو فوق القببْ",5,"ب",1,0],["دع رونق الخلق وانظر رونق الخلق","حسن بلا أدب زهر بلا عبق",6,"ق",1,1],["دَع رَشفَ فَمي ولا تَكُن في ضيقٍ","دَع رِد في ذا قَد عَظُمَ المَطلوبُ",7,"ب",1,0],["دَع رَأيَه لا تَنبِس","لا سيَّما في المَجلسِ",8,"س",1,0],["دَعْ رَحيقَ الْوَرْدِ يَظْمَا","وَاسْقِني بَعْضَ نَميرِكْ",9,"ك",1,0]]}