{"poems":[[88,"وما وقى ابنك عبد الله أينقه","https://www.aldiwan.net/poem68916.html","البسيط"],[45,"حيا وأيسر ما قاسيت ما قتلا","https://www.aldiwan.net/poem9983.html","البسيط"],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[234,"مانعتي لذة التداني","https://www.aldiwan.net/poem51249.html","مخلع البسيط"],[234,"لا والمضرج ثوبه","https://www.aldiwan.net/poem51271.html","مجزوء الكامل"],[438,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[556,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[572,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118799","المديد"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97913","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91514","الكامل"],[4232,"","https://poetry.dctabudhabi.ae/diwan/poem/203390","الكامل"],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5939,"ثورة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=178590",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""]],"verses":[["ها في حِماهُ وَهيَ سارِحَةٌ","مِثلَ القُصورِ قَدِ اِهتَزَّت أَعاليها",0,"ي",3,0],["ها فَاِنظُري أَو فَظُنّي بي تَرى حُرَقاً","مَن لَم يَذُق طَرَفاً مِنها فَقَد وَأَلا",1,"ل",2,0],["ها فانظرُوا يوماً علقت بحبكم","حالي من الأشواق كيف تكونَا",2,"ن",2,0],["ها فانظُرُوا إن كنتم في مِرْيةٍ","ما قدَّمَ الآباءُ والأبناءُ",3,"ا",2,0],["ها فانظري هل تَرَيْنَ إلاّ","قلبيَ يَبْكي لفقد قلبي",4,"ب",2,0],["ها فانظُريني سابحاً","في الدَّمْع من طول البُكاء",5,"ا",2,0],["ها فانْظُري وجهَ هلا","لِ الفطرِ فوقَ الأفُقِ",6,"ق",1,0],["ها فَاِنظُرا منِّي الدّموعَ غزيرةً","وتعجّبا لخشوعِ قلبٍ قاسِ",7,"س",1,0],["ها فما عندنا لضيف رحيل","حبنا العز والعلى من لدنْهُ",8,"ه",1,0],["ها فَهوَ ذا فَقَد رَجا الناسُ الغِيَر","مِن أَمرِهِم عَلى يَدَيكَ وَالثُؤَر",9,"ر",1,0],["ها فاسْقِنيها صِرْفاً فإن سَفَكَتْ","دَمي فما لي عَلَيْكَ مِنْ قَوَدِ",10,"د",1,0],["ها فؤادي فَارمِ حَبَّتهُ","كيف لي بالرمي في هدفي",11,"ف",2,0],["ها فؤادي فراشةٌ","أبصر النارَ فاستعر",12,"ر",1,0],["ها فانشروا عني أَحاديثَ الهَوى","وَاتلوا المآلَ عَلى بني الآفاق",13,"ق",1,0],["ها فاختضب بسواد حظي مرةً","ولك الأمانُ بأنه لا ينصل",14,"ل",1,0],["هَا فَاتْرُكُونِي فِي حَيَاتِي إِنَّنِي","سَأُعِيِدُ تَارِيِخِي وِصَالاً مُتْقَنَا",15,"ن",2,0],["ها فَلْتَذُقْ غَضَبي مِقدارَ قَسْوتِها","وَلْتجْتهدْ أَدْهُرًا في نَيْلِ غُفراني",16,"ن",2,0],["ها فمي يشتُمُ الطُّغاةَ صَراحاً","مِثْلَ موجِ البِحارِ أَرغَى وأَزْبَدْ",17,"د",1,0]]}