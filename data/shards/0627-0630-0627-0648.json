=36",""],[85,"سقى اللهُ بالكفر الأباظيِّ مضجعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9636&r=&rc=126",""],[3,"تركتُ بني الهجيمْ لهمْ دوارٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10670&r=&rc=24",""],[66,"تَوِسّدَ في الفَلا أيدي المَطايا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19705&r=&rc=10",""]],"verses":[["إِذا وَعاها ضاحِكُ القَومِ وَجَم","يَخافُها وَما جَنى وَلا جَرَم",0,"م",1,0],["إِذا وَرَدَت أَنقاعَ ماءٍ وَقيعَةٍ","أَنَشَّت عَلى أُخراهُ بِالماءِ أَجمَعا",1,"ع",2,0],["إِذا وَضَعوا فيهِ أَجازوا إِلى العُلى","وَإِن سارَ فيهِ الناسُ أَرذى وَأَظلَعا",1,"ع",2,0],["إِذا وَلَجَ الرِواقَ رَأَيتَ مِنهُ","طَويلَ الباعِ قَد غَمزَ السِماطا",2,"ط",2,0],["إِذا وَقَفَت قَناهُم عَن طِعانٍ","فَلَيسَ لَها سِوى المَوتِ اِنتِظارُ",3,"ر",1,0],["إِذا وَقَفوا في المَجدِ خافوا نَقَيضَهُ","فَتَمّوا عَلى عُنفِ السِياقِ وَزادوا",4,"د",3,0],["إِذا وُسِمَت بِالنارِ خَيلٌ فَعِندَها","كَرائِمُ آثارُ الطِعانِ سِماتُها",5,"ت",3,0],["إِذا وَلَّيتَني ظِفراً وَناباً","فَدونَكَ فَاِخِشَ مِن شَفَري وَنابي",6,"ي",1,0],["إِذا وَقَعوا بَعدَ طولِ الكَلالِ","لَم يَغمِزوا قَدَماً مِن تَعَب",7,"ب",1,0],["إِذا وُلِدَ المَوْلود مِنّا تَهَلَّلَتْ","لَهُ الأَرْضُ وَاهْتَزَّتْ إِلَيْهِ المَنابرُ",8,"ر",1,0],["إذا وَسَمْتُ بكَ الأشْعارَ أَصْحَبَ لي","أبِيُّها فيكَ وانْثالَتْ قَوافيها",9,"ي",3,0],["إذا ورَدَتْها البِيضُ يَلْهَثْنَ مِنْ صدًى","رَجَعْنَ رِواءً وهْيَ قانِيَةٌ حُمْرُ",10,"ر",1,0],["إذا وسِعَ التُّقى كَرَمي فأهْوِنْ","بِخَوْدٍ ضاقَ قُلْباها مَجالا",11,"ل",2,0],["إذا وكَفَتْ كَفُّ موسى بِها","غَماماً يَعودُ الجَنابُ الخَضِرْ",12,"ر",1,0],["إِذا وَرَدَت ماءً بِلَيلٍ تَعَرَّضَت","مَخافَةَ رامٍ أَو مَخَافَةَ حابِلِ",13,"ل",1,0],["إِذا وُضِعَت عَلى الأَبطالِ يَوم","رَأَيتَ لَها جُلودَ القَومِ جونا",14,"ن",2,0],["إِذا وَفَدَت رُكبانُ كَعبٍ وَعامِرٍ","عَلَيكَ وَأَردوا كُلَّ هَوجاءَ عَيهَلِ",15,"ل",1,0],["إِذا وَرَدَت رَغباءَ في يَومِ وِردِها","قَلوصي دَعا إِعطاشَهُ وَتَبَلَّدا",16,"د",2,0],["إِذَا وهَى الحُبُّ فَالهِجْرَانُ يَقْتلهُ","وَإِنْ تَمكَّنَ فَالهِجْرَانُ يُحْيِيهِ",17,"ه",1,1],["إِذَا وَلَّى فَتَاكَ وَأَنْتَ حَيُّ","فَإِنَّ أَشَدَّ مَوْتٍ مَا تُعَانِي",18,"ي",1,1],["إِذَا وَفَرَتْ فِيكِ المَنَافِعُ وَالمُنَى","عَجِبْتُ لِمَنْ يَشْكُو وَمَنْ يَتَألَّمُ",19,"م",1,0],["إِذا وَقَّعوا وَهناً كَسَوا حيَثُ مَوتَّتَ","مِنَ الجَهدِ أَنفاسُ الِرياِحِ الحَواشِكِ",20,"ك",1,0],["إِذا واضَحَ التَقريبُ واضَخنَ مِثلَهُ","وَإِن سَحَّ سَحّاً خَذرَفَت بِالأَكارِعِ",21,"ع",1,0],["إذا وقعت فوق الجبين أذبّها","فيزعجني نحو الجبين رجوعها",22,"ع",3,0],["إذا وعتها إذن واعيه","فقد وعت خير كتاب كريم",23,"م",1,0],["إذا وُلَيِت أمر العباد طُغاتُها","وساد على القوم السَراةِ مَسُودها",24,"د",3,0],["إِذا وَضَعَ السِربالَ قالَت مُجاشِعٌ","لَهُ مَنكِبا حَوضِ الحِمارِ وَكاهِلُه",25,"ل",2,0],["إِذا وَكَفَ الغُصونُ عَلى قَراهُ","أَدارَ الرَوقَ حالاً بَعدَ حالِ",26,"ل",1,0],["إِذا وَضَعوا أَلبادَها عَن مُتونِها","وَقَد نَضَحَت أَعطافُها وَالكَواهِلُ",27,"ل",1,0],["إذا واضعته مصون الحديث","ولاقى من الدجن يوماً مطيرا",28,"ر",2,1],["إِذا وُلِدَ المَولودُ مِنّا فَإِنَّما ال","أَسِنَّةُ وَالبيضُ الرِقاقُ تَمائِمُه",29,"م",2,0],["إِذا وَصَلتَ فَعَرِّض بي وَقُل لَهُمُ","هَل واعِدُ الوَعدِ يَومَ البَينِ ذاكِرُهُ",30,"ر",2,0],["إِذاً وَاللَهِ نَرميهِم بِحَربٍ","تُشيبُ الطِفلَ مِن قَبلِ المَشيبِ",31,"ب",1,1],["إِذا وَرَدَ الناسُ حَوضَ الرَسولِ","ذَيدَت هُذَيلُ عَنِ المَشرَعِ",32,"ع",1,0],["إذا وصف المداح بعض صفاته","فماذا بأكباد الأعادي من الشرح",33,"ح",1,0],["إذا وصف الإنسان بالبرِّ والتقى","يقولون هذا من عديد الملائكه",34,"ك",2,1],["إذا وسَّع الأطراس حكت سطورها","كواعب في الأوراق تحت حجال",35,"ل",1,0],["إذا وصفنا مذاق أنعمه","حلّته أمداحنا وحلاَّها",36,"ا",3,0],["إذاً ولراعَت الصيرانَ عَنْسي","بحيث تُشَقُّ عنهن السوابي",37,"ب",2,0],["إذا وَعَدَ اهْتزت له الأرض نَضْرَةً","وأنبت منها كلُّ ما كان أسْبَخا",38,"خ",2,0],["إذا ورد المالُ الذي كنت أرتجي","أُتيحت له تلقاءَ غيري مصادر",39,"ر",1,0],["إذاً ولَعاق العاملين عن الحيا","عوائقُ بالسلطان ذات ضرير",40,"ر",1,0],["إذا ولدت كانت كمرسلِ فسوةٍ","على رسلهِ انسلت وما كاد يشعر",41,"ر",1,0],["إذا وصفتْ ما فوق مجرى وشاحِها","غلائلُها رَدَّتْ شهادتَها الأزْرُ",42,"ر",1,1],["إذا وجهُهُ أو رأيُهُ أو فَعالُهُ","تبلَّجن فيِ ليلٍ تجلّتْ حَنادِسه",43,"س",2,0],["إذا وُضعتْ أكوارُنا بفنائهِ","فقد رُفعتْ عنا السنونَ القواحِطُ",44,"ط",1,0],["إذا ولما جشمت ولا ركابي","رجاء الخير تجوالاً وطوفا",45,"ف",2,0],["إِذا وُزِنَ الأَقوامُ لَم يُلفَ فيهِمِ","كَبِشرِ وَلا ميزانُ بِشرٍ يُعادِلُه",46,"ل",2,0],["إِذا وَضَعوا بَعدَ الضَريحِ جَنادِلاً","عَلَيَّ وَخَلَّيتُ المَطِيَّةَ وَالرَحلا",47,"ل",2,0],["إِذا وَرَدت أَصدَرتُها ثُمَّ إِنَّها","تَثوبُ فَتَأتي مِن تُحَيتٍ وَمِن عَلُ",48,"ل",1,0],["إِذا وُضِعَت عَنها بِظَهرِ مَفازَةٍ","حَقائِبُ عَن أَصلابِها وَسُروجُ",49,"ج",1,0],["إِذا وُرِّعَت أَن تَركَبَ الحَوضَ كَسَّرَت","بِأَركانِ هَضبٍ كُلَّ رَطبٍ وَذابِلِ",50,"ل",1,0],["إذا وقفت بأبواب الملوك ضحى","أيقنت أن قد بنى للخلد بانيها",51,"ي",3,0],["إِذا وَضَعَ الأَحياءُ تاريخَ جيلِهِم","عَرَفتَ المُلاحي مِنهُمو وَالمُحابِيا",52,"ي",2,0],["إِذا وَرِمَت مِن لَسعَةٍ مَرِحَت لَها","كَأَنَّ نَوالاً صَرَّ في جِلدِها النِبرُ",53,"ر",1,0],["إِذا وَصَفوا لَهُ داءً بِثَغرٍ","سَقاهُ أَسِنَّةَ الأَسلِ الطِوالِ",54,"ل",1,0],["إِذا وَصِأَت بِأَيدِيَها صُخوراً","يَفِئنَ لِوَطءِ أَرجُلِها رِمالا",55,"ل",2,0],["إِذا وضعوا ذَرَّ الدِلاص عليهِمُ","ويعتقلون الرمحَ قبلَ التمائمِ",56,"م",1,0],["إِذا ونتْ عِشارُها صاحَ بها","قاصفُ رعدٍ وحَدَتْها الشمألُ",57,"ل",1,0],["إِذا وَهَبَ الأولى مِنَ النَيلِ لَم يَدَع","مُتابَعَةَ الإِفضالِ أَو يَهَبَ الأُخرى",58,"ر",2,0],["إِذا وَتَّدَ العَبدُ في ظَهرِهِ","تَسامى بِخُرطومِهِ أَو شَمَخ",59,"خ",1,0],["إِذا وَصَلتُ بِهِ في مَطلَبٍ أَمَلاً","رَأَيتُ مَصدَرَ أَمري قَبلَ مَورِدِهِ",60,"د",2,0],["إِذا وَصَلَتنا لَم تَصِل عَن تَعَمُّدٍ","وَإِن هَجَرَت أَبدَت لَنا هَجرَ عامِدِ",61,"د",1,0],["إِذا وَقَعَت بِالقُربِ مِنهُ مُلِمَّةٌ","ثَنى طَرفَهُ نَحوَ الحُسامِ يُشاوِرُه",62,"ر",2,0],["إِذا وُتِروا خَلَّوا جُفونَ سُيوفِهِم","خَلاءً وَلا يُغضونَ جَفناً عَلى وَترِ",63,"ر",1,0],["إِذا وَعَدتُ التَجافي عَن مَواهِبِهِ","دافَعتُ بِالنُجحِ أَو أَخلَفتُ إِخلافا",64,"ف",2,0],["إِذا وَهَبَ البُدورَ رَأَيتَ وَجهاً","تَخالُ بِحُسنِهِ البَدرَ التَماما",65,"م",2,0],["إِذا وَعَدَ اِرفَضَّت عَطاءً عِداتُهُ","وَأَعرِفُ مِنهُم مَن يَحُزُّ وَلا يُدمي",66,"ي",1,0],["إِذا وَعَدَ اِتَّسَعَت كَفُّهُ","لِإِنجاحِهِ دونَ حِرمانِهِ",67,"ن",2,0],["إِذا وَرَدوا الماءَ الرَواءَ تَظامَأَت","أَوائِلُهُم أَو يَحفِروا ثُمَّ يَشرَبوا",68,"ب",3,0],["إِذا وَضَعَ السِياطَ لَنا نَهاراً","أَخَذنا بِالرِبا سَرَقَ الحَريرِ",69,"ر",1,0],["إِذا وَعَدَ الحَجّاجُ أَو هَمَّ أَسقَطَت","مَخافَتُهُ ما في بُطونِ الحَوامِلِ",70,"ل",1,1],["إِذا واضَحوهُ المَجدَ جاءَت دِلاؤُهُ","مُلاءً إِذا سَجلٌ مِنَ المَجدِ شَوَّلا",71,"ل",2,0],["إِذا وَرَدَ الماءَ الرَواءَ تَظامَأَت","أَوائِلُهُ حَتّى يُماحَ عَيالِمُه",72,"م",2,0],["إِذا وَقَعَت فَوقَ الجَماجِمِ لَم يَقُم","إِلى يَومِ بَعثِ الأَوَّلينَ أَميمُها",73,"م",3,0],["إِذا وَلَجَت قَيسٌ تِهامَةَ قُرِّروا","بِها وَبِنَجدٍ هُم عَبيدُ هَوانِ",74,"ن",1,0],["إذا وسموا بطيئات القوافي","بسيف الدولة ابتدرت عجالا",75,"ل",2,0],["إذا وَعدَ السَّرَّاءَ أنجَزَ وعدَه","وإن أوعَدَ الضَّرَّاءَ فالعَفوُ مانِعُه",76,"ع",2,0],["إذا وصَلوا أضحى الخِوانُ مُدَبَّجاً","وإن وصَلوا أمسى الخِوانُ مُجرَّدا",77,"د",2,0],["إذا وعَى المدحَ لم يطرَبْ لبهجتِه","وإن تصافَعَ قَومٌ عندَه طَرِبا",78,"ب",2,0],["إِذا وَصَفتُ لَهُم دُنياهُمُ ضَحِكوا","وَإِن وَصَفتُ لَهُم أُخراهُمُ عَبَسوا",79,"س",3,0],["إِذا واحِدٌ مِنها اِستَعانَ بِصَحبِهِ","دَعا فَأَجابَتهُ نَظائِرُ نُحَّلُ",80,"ل",1,0],["إِذا وَرَدتَ بِها شاطي الفُراتِ وَقَد","نَكَّبتَ عَن ماءِ حَورانٍ وَقَيّاصِ",81,"ص",1,0],["إِذا وَنَت رُعودُهُ","عَنَّت لَهُ ريحُ الصَبا",82,"ا",1,0],["إِذا وَطِئَتها الشَمسُ سالَ لُعابُها","وَإِن سَلَكَتها الريحُ طالَ هَديرُها",83,"ر",3,0],["إِذا وافَيتُ يَوماً رَيعَ مُلكٍ","لِيَ المِرباعُ فيهِ وَالصَفايا",84,"ا",3,0],["إذا واجهتْ كاساتُها الليلَ خلتَها","تهتّكُ من ظلمائه حُجُباً كُحْلا",85,"ل",2,0],["إذا وطئت شمَّ الجبال نَسَفْنَها","وغادَرنَها قاعاً لعينيك صفصفا",86,"ف",2,0],["إذا وَتَرٌ هَزّتْهُ بالنقر خِلْتَهُ","يئنُّ من الآلام أو يَتَضَرّعُ",87,"ع",1,0],["إذا وُزِنَ الموتُ الزّؤامُ عليهمُ","بكفّة وَزّانٍ مَثاقيلُهُ الصخرُ",88,"ر",1,0],["إِذا وَقَف الأبطالُ عن غَمرَةِ الرَّدى","مشى بأسُهُم نحو الحتوفِ بهم أُسْدا",89,"د",2,0],["إذا ورث المولودُ عِلّةَ والدٍ","فعدِّ بهِ عنْ حيلةِ البرءِ والطبِّ",90,"ب",1,0],["إذا وَرَدَتْ من زرقة الماءِ أَعيُناً","وقَفْنَ على أرجائها كالحواجِبِ",91,"ب",1,0],["إِذا وَعَدَ اِنهَلَّت يَداهُ فَأَهدَتا","لَكَ النُجحَ مَحمولاً عَلى كاهِلِ الوَعدِ",92,"د",1,0],["إذا وَهَبْا اليومَ فلساً واحداً","يقصرُ عنا في السخاءِ جعفرُ",93,"ر",1,1],["إذا ولّى لبيتكمُ إمامٌ","عديمُ المثلِ يخلفُه إمامُ",94,"م",1,0],["إِذا وَعَدَت زادَ الهَوى لِاِنتِظارِها","وَإِن بَخِلَت بِالوَعدِ مِتُّ عَلى الوَعدِ",95,"د",1,0],["إذا وردوا الممالكَ أنكرتهم","وكانوا للممالكِ مُنكِرينا",96,"ن",2,0],["إذا وَجدتْ شِفاءَ الغيظِ فينا","فزادُ اللهِ غيظُ المُحنَقِينا",97,"ن",2,0],["إِذا وَصَفوا حُمَيّاها لِقَومٍ","تَخاذَلَتِ المَفاصِلُ وَالعُروقُ",98,"ق",1,0],["إذا وَرَدوا الهيجاءَ فالنّقعُ قاتمٌ","وإن صَدَرُوا بالخيلِ فالنّصرُ لامِعُ",99,"ع",1,0],["إِذا وَرَدَت حَفلاً تَغامَزَ أَهلُهُ","صَحائِفُ فُضَّت أَم نَوافِجُ تُفتَقُ",100,"ق",1,0],["إِذا وَجَرٌ عَظيمٌ فيهِ شَيخٌ","مِنَ السودانِ يُدعى الشَرَّتَينِ",101,"ن",1,1],["إِذا وَقَعَت بِكَعبٍ أَو قُرَيمٍ","وَسَيّارٍ فَقَد ساغَ الشَرابُ",102,"ب",1,0],["إِذا واضَحوهُ المَجدَ أَربى عَلَيهِمُ","بِمُستَفرِغٍ ماءَ الذِنابِ سَجيلِ",103,"ل",1,0],["إِذا وَرَدَت مِن آخِرِ اللَيلِ لَم تَعَف","حِياضَ الأَضا المَطروقَةِ الكَدِراتِ",104,"ت",1,0],["إِذا وَشى بِاللَيلِ صُبحٌ فَاِفتَضَح","وَذَكَّرَ الطائِرَ شَجوٌ فَصَدَح",105,"ح",1,0],["إذْ أوْصَلَ القَوْلَ الصَّريحَ بذِكْرِهِ","للسَّامِعِينَ فأَحْسَنَ التَّوصِيلا",106,"ل",2,0],["إذا ولجَ البعيرُ فروغ صبري","عن الصهباء في سُمّ الخياط",107,"ط",1,1],["إِذا وُلِدَ المَولودُ أَعمى وَجَدتَهُ","وَجَدِّكَ أَهدَى مِن بَصيرٍ وَأَجوَلا",108,"ل",2,1],["إِذا وَضَعَت في مَجلِسِ القَومِ نَعلَها","تَضَوَّعَ مِسكاً ما أَصابَت وَعَنبَرا",109,"ر",2,1],["إِذا واجَهتَها يَوماً","تَجُرُّ القَرقَرَ الحَبرا",110,"ر",2,0],["إِذا وُدٌّ جَفا وَأَرَبَّ وُدٌّ","فَجانِب مَن جَفاكَ لِمَن أَرَبّا",111,"ب",2,0],["إِذا وُقِيَ الإِنسانُ لَم يَخشَ حادِثاً","وَإِن قيلَ هَجّامٌ عَلى الحَربِ أَهوَجُ",112,"ج",1,0],["إِذا وَهَبَ اللَهُ لي نِعمَةً","أَفَدتُ المَساكينَ مِمّا وَهَب",113,"ب",1,1],["أَِذا وَعَدَتكَ خَيراً ما طَلَتهُ","وَهَل يُرجى لَها إِنجازُ وَعدِ",114,"د",1,0],["إِذا وُصِلَت بِالجِسمِ روحٌ فَإِنَّها","وَجُثمانُها تَصلى الشَدائِدَ وَالضَرّا",115,"ر",2,0],["إِذا وَدَّكَ الإِنسانُ يَوماً لِخِلَّةٍ","فغَيَّرَها مَرُّ الزَّمانِ تَنَكَّرا",116,"ر",2,1],["إِذا وَفَت لِتِجارِ الهِندِ فائِدَةٌ","فَاِجعَل مَعَ اللَهِ في دُنياكَ مُتَّجَرا",117,"ر",2,1],["إِذا وَرَدَ الفَقيرُ عَلى اِحتِياجي","أَغَثتُ لَهيفَهُ بِالمُستَدَفِّ",118,"ف",1,0],["إِذا وَقتُ السَعادَةِ زالَ عَنّي","فَكِلني إِن أَرَدتَ وَلا تُكَنّي",119,"ي",1,1],["إذا وعى الناس ما تبديه من حكم","آبوا إليك زرافات ووحدانا",120,"ن",2,0],["إِذا وَصَفتُ لِنَفسي هَجرَها جَمَحَت","وَدائِعُ الشَوقِ في أَقصى جَوانِحِها",121,"ح",3,0],["\"إذا وطئت بأيديها صخوراً","بقين لوطء أرجلها، رمالا\"",122,"ل",2,0],["إِذا وُضِعَت عَلى الأَبطالِ يَوماً","رَأَيتَ لَها جُلودَ القَومِ جونا",123,"ن",2,0],["إذا وَقَعَتْ مَدَارِيها عليه","سُتِرْنَ بجُنْحِ ليْلٍ أو دُفِنّه",124,"ن",2,0],["إذا وَصَفَ الطائيَّ بالبُخْلِ مادِرٌ","وعَيّرَ قُسّاًً بالفَهاهةِ باقِل",125,"ل",1,0],["إذا وَطِئَتْ عوداً برِجْلٍ حسِبْتَها","ثقيلةَ حِجْلٍ تَلمِسُ العودَ ذا الشِّرْع",126,"ع",1,0],["إِذا وَنى ثَغر الخطِّيُّ ثُغرتَهُ","أَوْ عاذَ بالنَّهْرِ مَسْلُوبَ القُوَى غَرِقَا",127,"ق",2,0],["إِذَا وَلَجَتْ بَيْتَ الضَّمِيرِ رَأَيْتَهَا","وَرَاءَ بَنَاتِ الصَّدْرِ تَسْفُلُ أَوْ تَعْلُو",128,"ل",2,0],["إِذَا وُلِدَ الْمَوْلُودُ مِنَّا فَدَرُّهُ","دَمُ الصِّيدِ والْجُرْدُ الْعَنَاجِيجُ مَهْدُهُ",129,"د",2,0],["إِذَا وَالِدِي قَدْ طَوَّقَتْنِي يَمِينُهُ","وَفِي وَجْهِهِ دَمْعٌ مِنَ العَيْنِ مُرْسَلُ",130,"ل",1,0],["إِذْ أَوْهَنَ الأَحْزَابَ خُلْفٌ أَفْرَزَتْ","فِيهَا ضَغَائِنَهُ سُمُومَ صِلاَلِ",131,"ل",1,0],["إِذَا وَسْوَسَتْ فِي صَدْرِ حَسْنَاءَ هِمةٌ","فَأَحْلَى سَمَاعٍ صَوْتُ حَلْيٍ مُوَسْوَسِ",132,"س",1,0],["إِذَا وَصَفَتْ وَجْداً تَخَيَّلْتَهَا جَرَتْ","بِمَا اكْتَنَّ فِي جَفْنِ المُحِبِّ المُسْهَّدِ",133,"د",1,0],["إِذَا وَسِع الكَوْنَ فِكْرُ امْرِيءٍ","فَلاَ بأْسَ بِالطَّرْفِ أَنْ يُحْسرَا",134,"ر",2,0],["إذا وطنٌ أهابَ بنابغيه","سبقتَ السابقين وقلت هاكا",135,"ك",2,0],["إِذا وَسَمتني يا بنيّ خَطيئَتي","فَلا تَنكِرَن وَجهي هُنالِكَ وَاِعرِفِ",136,"ف",1,0],["إِذا وَشَتِ المَدامِعُ لَم","يَكُفَّ الحِلمُ أَلسُنها",137,"ن",3,0],["إِذا وَرَدوا خَيلاً تَسَعَّرُ بِالقَنا","مَساعِرُ جَمرِ المَوتِ وَالغَمَراتِ",138,"ت",1,0],["إِذا وُتِروا مَدّوا إِلى واتِريهِم","أَكُفاً عَنِ الأَوتارِ مُنقَبِضاتِ",138,"ت",1,0],["إذَا وَفَّقَ اللّهُ امْرأً في طِلاَبِه","دَنَا الصَّعْبُ وانْقَاد العَسِير المُمَنَّع",139,"ع",1,0],["إذا وَهَنَتْ أذكى لَظَى رَغَباتِها","همامٌ له عند النجومِ رِغابُ",140,"ب",1,0],["إِذا وَهَنتْ فِيهِ الْقِلاصُ وَأدْبَرَتْ","فَذاكَ شَديدُ الْحَوْلِ مُحْتَمِلٌ جَلْدُ",141,"د",1,0],["إذا ودّ إنسانًا فليس لوده","حدودٌ، وإن عاداه فهْو مجاهره",142,"ر",2,0],["إذَا وَقَعْتُ لِكَعْبٍ أوْ خُثْيم","وَسَيَّارٍ يَسُوغُ لَهَا شَرَابِي",143,"ب",2,0],["إِذا وَطِئتْ بِأَيدِيَها صُخورًا","يَفِئنَ لِوَطءِ أَرجُلِها رِمالا",144,"ل",2,0],["إذا وُضعت عن الأبطال يوماً","رأيت لها جلود القوم جُونا",145,"ن",2,0],["إذا وقَعَتْ فَوْقَ الجَماجِمِ لمْ يَقُمْ","إلى يَوْمِ بَعْثِ الأوجلِينَ أمِيمُهَا",146,"م",3,0],["إذا وصفتَ امرءاً لامرئ","فلا تَغْلُ في وصفه واقصد",147,"د",1,0],["اذا ولجت في جوفه النفق الرحبا","لها صيحة عند الولوج كأنها",148,"ا",1,0],["إذا وضعَ الأحياءُ تاريخَ جيلهم","عَرفتَ المُلاحي مِنهمُ، والمُحابيا",149,"ي",2,0],["إذا وَقَعَ الرِّماحُ بمَنْكِبَيْه","تولَّى قابعاً فيهِ صدودُ",150,"د",1,0],["إذا وافَيتُ يَوماً رَيعَ مُلكٍ","ليَ المرباغُ فيهِ والصّفايا",151,"ا",3,0]]}