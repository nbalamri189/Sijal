ت عليه ضلة تعذلينه","https://www.aldiwan.net/poem55848.html","الطويل"],[458,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[458,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[458,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[458,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[458,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[458,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"وأم يفوز بإعلانها","https://www.aldiwan.net/poem56174.html","المتقارب"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[458,"أشوقا ومن تهوى خلي الجوانح","https://www.aldiwan.net/poem56258.html","الطويل"],[458,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[458,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[458,"ما مكرم هين الآباء يكرهه","https://www.aldiwan.net/poem56310.html","البسيط"],[461,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[461,"كفي مقالك عن لومي وتفنيدي","https://www.aldiwan.net/poem15135.html","البسيط"],[461,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[461,"هو الطود المنيف وكل خطب","https://www.aldiwan.net/poem16431.html","الوافر"],[463,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[464,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[466,"سقى دمنتين ليس لي بهم عهد","https://www.aldiwan.net/poem50453.html","الطويل"],[468,"كتبت إلى بعض الأخلاء رقعة","https://www.aldiwan.net/poem59863.html","الطويل"],[468,"إذا وصف المرء شيئا ولم","https://www.aldiwan.net/poem59865.html","المتقارب"],[468,"وخمار دخلت عليه ليلا","https://www.aldiwan.net/poem60297.html","الوافر"],[468,"خمر بدار الفناء","https://www.aldiwan.net/poem60493.html","المجتث"],[477,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[477,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[477,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[495,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[514,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[529,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[551,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[558,"أنا معنى عناني الحق فيه","https://www.aldiwan.net/poem33592.html","الوافر"],[562,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[562,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[586,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"]],"verses":[["إِذا وَعاها ضاحِكُ القَومِ وَجَم","يَخافُها وَما جَنى وَلا جَرَم",0,"م",1,0],["إِذا وَرَدَت أَنقاعَ ماءٍ وَقيعَةٍ","أَنَشَّت عَلى أُخراهُ بِالماءِ أَجمَعا",1,"ع",2,0],["إِذا وَضَعوا فيهِ أَجازوا إِلى العُلى","وَإِن سارَ فيهِ الناسُ أَرذى وَأَظلَعا",1,"ع",2,0],["إِذا وَلَجَ الرِواقَ رَأَيتَ مِنهُ","طَويلَ الباعِ قَد غَمزَ السِماطا",2,"ط",2,0],["إِذا وَقَفَت قَناهُم عَن طِعانٍ","فَلَيسَ لَها سِوى المَوتِ اِنتِظارُ",3,"ر",1,0],["إِذا وَقَفوا في المَجدِ خافوا نَقَيضَهُ","فَتَمّوا عَلى عُنفِ السِياقِ وَزادوا",4,"د",3,0],["إِذا وُسِمَت بِالنارِ خَيلٌ فَعِندَها","كَرائِمُ آثارُ الطِعانِ سِماتُها",5,"ت",3,0],["إِذا وَلَّيتَني ظِفراً وَناباً","فَدونَكَ فَاِخِشَ مِن شَفَري وَنابي",6,"ي",1,0],["إِذا وَقَعوا بَعدَ طولِ الكَلالِ","لَم يَغمِزوا قَدَماً مِن تَعَب",7,"ب",1,0],["إِذا وُلِدَ المَوْلود مِنّا تَهَلَّلَتْ","لَهُ الأَرْضُ وَاهْتَزَّتْ إِلَيْهِ المَنابرُ",8,"ر",1,0],["إذا وَسَمْتُ بكَ الأشْعارَ أَصْحَبَ لي","أبِيُّها فيكَ وانْثالَتْ قَوافيها",9,"ي",3,0],["إذا ورَدَتْها البِيضُ يَلْهَثْنَ مِنْ صدًى","رَجَعْنَ رِواءً وهْيَ قانِيَةٌ حُمْرُ",10,"ر",1,0],["إذا وسِعَ التُّقى كَرَمي فأهْوِنْ","بِخَوْدٍ ضاقَ قُلْباها مَجالا",11,"ل",2,0],["إذا وكَفَتْ كَفُّ موسى بِها","غَماماً يَعودُ الجَنابُ الخَضِرْ",12,"ر",1,0],["إِذا وَرَدَت ماءً بِلَيلٍ تَعَرَّضَت","مَخافَةَ رامٍ أَو مَخَافَةَ حابِلِ",13,"ل",1,0],["إِذا وُضِعَت عَلى الأَبطالِ يَوم","رَأَيتَ لَها جُلودَ القَومِ جونا",14,"ن",2,0],["إِذا وَفَدَت رُكبانُ كَعبٍ وَعامِرٍ","عَلَيكَ وَأَردوا كُلَّ هَوجاءَ عَيهَلِ",15,"ل",1,0],["إِذا وَرَدَت رَغباءَ في يَومِ وِردِها","قَلوصي دَعا إِعطاشَهُ وَتَبَلَّدا",16,"د",2,0],["إِذَا وهَى الحُبُّ فَالهِجْرَانُ يَقْتلهُ","وَإِنْ تَمكَّنَ فَالهِجْرَانُ يُحْيِيهِ",17,"ه",1,1],["إِذَا وَلَّى فَتَاكَ وَأَنْتَ حَيُّ","فَإِنَّ أَشَدَّ مَوْتٍ مَا تُعَانِي",18,"ي",1,1],["إِذَا وَفَرَتْ فِيكِ المَنَافِعُ وَالمُنَى","عَجِبْتُ لِمَنْ يَشْكُو وَمَنْ يَتَألَّمُ",19,"م",1,0],["إِذا وَقَّعوا وَهناً كَسَوا حيَثُ مَوتَّتَ","مِنَ الجَهدِ أَنفاسُ الِرياِحِ الحَواشِكِ",20,"ك",1,0],["إِذا واضَحَ التَقريبُ واضَخنَ مِثلَهُ","وَإِن سَحَّ سَحّاً خَذرَفَت بِالأَكارِعِ",21,"ع",1,0],["إذا وقعت فوق الجبين أذبّها","فيزعجني نحو الجبين رجوعها",22,"ع",3,0],["إذا وعتها إذن واعيه","فقد وعت خير كتاب كريم",23,"م",1,0],["إذا وُلَيِت أمر العباد طُغاتُها","وساد على القوم السَراةِ مَسُودها",24,"د",3,0],["إِذا وَضَعَ السِربالَ قالَت مُجاشِعٌ","لَهُ مَنكِبا حَوضِ الحِمارِ وَكاهِلُه",25,"ل",2,0],["إِذا وَكَفَ الغُصونُ عَلى قَراهُ","أَدارَ الرَوقَ حالاً بَعدَ حالِ",26,"ل",1,0],["إِذا وَضَعوا أَلبادَها عَن مُتونِها","وَقَد نَضَحَت أَعطافُها وَالكَواهِلُ",27,"ل",1,0],["إذا واضعته مصون الحديث","ولاقى من الدجن يوماً مطيرا",28,"ر",2,1],["إِذا وُلِدَ المَولودُ مِنّا فَإِنَّما ال","أَسِنَّةُ وَالبيضُ الرِقاقُ تَمائِمُه",29,"م",2,0],["إِذا وَصَلتَ فَعَرِّض بي وَقُل لَهُمُ","هَل واعِدُ الوَعدِ يَومَ البَينِ ذاكِرُهُ",30,"ر",2,0],["إِذاً وَاللَهِ نَرميهِم بِحَربٍ","تُشيبُ الطِفلَ مِن قَبلِ المَشيبِ",31,"ب",1,1],["إِذا وَرَدَ الناسُ حَوضَ الرَسولِ","ذَيدَت هُذَيلُ عَنِ المَشرَعِ",32,"ع",1,0],["إذا وصف المداح بعض صفاته","فماذا بأكباد الأعادي من الشرح",33,"ح",1,0],["إذا وصف الإنسان بالبرِّ والتقى","يقولون هذا من عديد الملائكه",34,"ك",2,1],["إذا وسَّع الأطراس حكت سطورها","كواعب في الأوراق تحت حجال",35,"ل",1,0],["إذا وصفنا مذاق أنعمه","حلّته أمداحنا وحلاَّها",36,"ا",3,0],["إذاً ولراعَت الصيرانَ عَنْسي","بحيث تُشَقُّ عنهن السوابي",37,"ب",2,0],["إذا وَعَدَ اهْتزت له الأرض نَضْرَةً","وأنبت منها كلُّ ما كان أسْبَخا",38,"خ",2,0],["إذا ورد المالُ الذي كنت أرتجي","أُتيحت له تلقاءَ غيري مصادر",39,"ر",1,0],["إذاً ولَعاق العاملين عن الحيا","عوائقُ بالسلطان ذات ضرير",40,"ر",1,0],["إذا ولدت كانت كمرسلِ فسوةٍ","على رسلهِ انسلت وما كاد يشعر",41,"ر",1,0],["إذا وصفتْ ما فوق مجرى وشاحِها","غلائلُها رَدَّتْ شهادتَها الأزْرُ",42,"ر",1,1],["إذا وجهُهُ أو رأيُهُ أو فَعالُهُ","تبلَّجن فيِ ليلٍ تجلّتْ حَنادِسه",43,"س",2,0],["إذا وُضعتْ أكوارُنا بفنائهِ","فقد رُفعتْ عنا السنونَ القواحِطُ",44,"ط",1,0],["إذا ولما جشمت ولا ركابي","رجاء الخير تجوالاً وطوفا",45,"ف",2,0],["إِذا وُزِنَ الأَقوامُ لَم يُلفَ فيهِمِ","كَبِشرِ وَلا ميزانُ بِشرٍ يُعادِلُه",46,"ل",2,0],["إِذا وَضَعوا بَعدَ الضَريحِ جَنادِلاً","عَلَيَّ وَخَلَّيتُ المَطِيَّةَ وَالرَحلا",47,"ل",2,0],["إِذا وَرَدت أَصدَرتُها ثُمَّ إِنَّها","تَثوبُ فَتَأتي مِن تُحَيتٍ وَمِن عَلُ",48,"ل",1,0],["إِذا وُضِعَت عَنها بِظَهرِ مَفازَةٍ","حَقائِبُ عَن أَصلابِها وَسُروجُ",49,"ج",1,0],["إِذا وُرِّعَت أَن تَركَبَ الحَوضَ كَسَّرَت","بِأَركانِ هَضبٍ كُلَّ رَطبٍ وَذابِلِ",50,"ل",1,0],["إذا وقفت بأبواب الملوك ضحى","أيقنت أن قد بنى للخلد بانيها",51,"ي",3,0],["إِذا وَضَعَ الأَحياءُ تاريخَ جيلِهِم","عَرَفتَ المُلاحي مِنهُمو وَالمُحابِيا",52,"ي",2,0],["إِذا وَرِمَت مِن لَسعَةٍ مَرِحَت لَها","كَأَنَّ نَوالاً صَرَّ في جِلدِها النِبرُ",53,"ر",1,0],["إِذا وَصَفوا لَهُ داءً بِثَغرٍ","سَقاهُ أَسِنَّةَ الأَسلِ الطِوالِ",54,"ل",1,0],["إِذا وَصِأَت بِأَيدِيَها صُخوراً","يَفِئنَ لِوَطءِ أَرجُلِها رِمالا",55,"ل",2,0],["إِذا وضعوا ذَرَّ الدِلاص عليهِمُ","ويعتقلون الرمحَ قبلَ التمائمِ",56,"م",1,0],["إِذا ونتْ عِشارُها صاحَ بها","قاصفُ رعدٍ وحَدَتْها الشمألُ",57,"ل",1,0],["إِذا وَهَبَ الأولى مِنَ النَيلِ لَم يَدَع","مُتابَعَةَ الإِفضالِ أَو يَهَبَ الأُخرى",58,"ر",2,0],["إِذا وَتَّدَ العَبدُ في ظَهرِهِ","تَسامى بِخُرطومِهِ أَو شَمَخ",59,"خ",1,0],["إِذا وَصَلتُ بِهِ في مَطلَبٍ أَمَلاً","رَأَيتُ مَصدَرَ أَمري قَبلَ مَورِدِهِ",60,"د",2,0],["إِذا وَصَلَتنا لَم تَصِل عَن تَعَمُّدٍ","وَإِن هَجَرَت أَبدَت لَنا هَجرَ عامِدِ",61,"د",1,0],["إِذا وَقَعَت بِالقُربِ مِنهُ مُلِمَّةٌ","ثَنى طَرفَهُ نَحوَ الحُسامِ يُشاوِرُه",62,"ر",2,0],["إِذا وُتِروا خَلَّوا جُفونَ سُيوفِهِم","خَلاءً وَلا يُغضونَ جَفناً عَلى وَترِ",63,"ر",1,0],["إِذا وَعَدتُ التَجافي عَن مَواهِبِهِ","دافَعتُ بِالنُجحِ أَو أَخلَفتُ إِخلافا",64,"ف",2,0],["إِذا وَهَبَ البُدورَ رَأَيتَ وَجهاً","تَخالُ بِحُسنِهِ البَدرَ التَماما",65,"م",2,0],["إِذا وَعَدَ اِرفَضَّت عَطاءً عِداتُهُ","وَأَعرِفُ مِنهُم مَن يَحُزُّ وَلا يُدمي",66,"ي",1,0],["إِذا وَعَدَ اِتَّسَعَت كَفُّهُ","لِإِنجاحِهِ دونَ حِرمانِهِ",67,"ن",2,0],["إِذا وَرَدوا الماءَ الرَواءَ تَظامَأَت","أَوائِلُهُم أَو يَحفِروا ثُمَّ يَشرَبوا",68,"ب",3,0],["إِذا وَضَعَ السِياطَ لَنا نَهاراً","أَخَذنا بِالرِبا سَرَقَ الحَريرِ",69,"ر",1,0],["إِذا وَعَدَ الحَجّاجُ أَو هَمَّ أَسقَطَت","مَخافَتُهُ ما في بُطونِ الحَوامِلِ",70,"ل",1,1],["إِذا واضَحوهُ المَجدَ جاءَت دِلاؤُهُ","مُلاءً إِذا سَجلٌ مِنَ المَجدِ شَوَّلا",71,"ل",2,0],["إِذا وَرَدَ الماءَ الرَواءَ تَظامَأَت","أَوائِلُهُ حَتّى يُماحَ عَيالِمُه",72,"م",2,0],["إِذا وَقَعَت فَوقَ الجَماجِمِ لَم يَقُم","إِلى يَومِ بَعثِ الأَوَّلينَ أَميمُها",73,"م",3,0],["إِذا وَلَجَت قَيسٌ تِهامَةَ قُرِّروا","بِها وَبِنَجدٍ هُم عَبيدُ هَوانِ",74,"ن",1,0],["إذا وسموا بطيئات القوافي","بسيف الدولة ابتدرت عجالا",75,"ل",2,0],["إذا وَعدَ السَّرَّاءَ أنجَزَ وعدَه","وإن أوعَدَ الضَّرَّاءَ فالعَفوُ مانِعُه",76,"ع",2,0],["إذا وصَلوا أضحى الخِوانُ مُدَبَّجاً","وإن وصَلوا أمسى الخِوانُ مُجرَّدا",77,"د",2,0],["إذا وعَى المدحَ لم يطرَبْ لبهجتِه","وإن تصافَعَ قَومٌ عندَه طَرِبا",78,"ب",2,0],["إِذا وَصَفتُ لَهُم دُنياهُمُ ضَحِكوا","وَإِن وَصَفتُ لَهُم أُخراهُمُ عَبَسوا",79,"س",3,0],["إِذا واحِدٌ مِنها اِستَعانَ بِصَحبِهِ","دَعا فَأَجابَتهُ نَظائِرُ نُحَّلُ",80,"ل",1,0],["إِذا وَرَدتَ بِها شاطي الفُراتِ وَقَد","نَكَّبتَ عَن ماءِ حَورانٍ وَقَيّاصِ",81,"ص",1,0],["إِذا وَنَت رُعودُهُ","عَنَّت لَهُ ريحُ الصَبا",82,"ا",1,0],["إِذا وَطِئَتها الشَمسُ سالَ لُعابُها","وَإِن سَلَكَتها الريحُ طالَ هَديرُها",83,"ر",3,0],["إِذا وافَيتُ يَوماً رَيعَ مُلكٍ","لِيَ المِرباعُ فيهِ وَالصَفايا",84,"ا",3,0],["إذا واجهتْ كاساتُها الليلَ خلتَها","تهتّكُ من ظلمائه حُجُباً كُحْلا",85,"ل",2,0],["إذا وطئت شمَّ الجبال نَسَفْنَها","وغادَرنَها قاعاً لعينيك صفصفا",86,"ف",2,0],["إذا وَتَرٌ هَزّتْهُ بالنقر خِلْتَهُ","يئنُّ من الآلام أو يَتَضَرّعُ",87,"ع",1,0],["إذا وُزِنَ الموتُ الزّؤامُ عليهمُ","بكفّة وَزّانٍ مَثاقيلُهُ الصخرُ",88,"ر",1,0],["إِذا وَقَف الأبطالُ عن غَمرَةِ الرَّدى","مشى بأسُهُم نحو الحتوفِ بهم أُسْدا",89,"د",2,0],["إذا ورث المولودُ عِلّةَ والدٍ","فعدِّ بهِ عنْ حيلةِ البرءِ والطبِّ",90,"ب",1,0],["إذا وَرَدَتْ من زرقة الماءِ أَعيُناً","وقَفْنَ على أرجائها كالحواجِبِ",91,"ب",1,0],["إِذا وَعَدَ اِنهَلَّت يَداهُ فَأَهدَتا","لَكَ النُجحَ مَحمولاً عَلى كاهِلِ الوَعدِ",92,"د",1,0],["إذا وَهَبْا اليومَ فلساً واحداً","يقصرُ عنا في السخاءِ جعفرُ",93,"ر",1,1],["إذا ولّى لبيتكمُ إمامٌ","عديمُ المثلِ يخلفُه إمامُ",94,"م",1,0],["إِذا وَعَدَت زادَ الهَوى لِاِنتِظارِها","وَإِن بَخِلَت بِالوَعدِ مِتُّ عَلى الوَعدِ",95,"د",1,0],["إذا وردوا الممالكَ أنكرتهم","وكانوا للممالكِ مُنكِرينا",96,"ن",2,0],["إذا وَجدتْ شِفاءَ الغيظِ فينا","فزادُ اللهِ غيظُ المُحنَقِينا",97,"ن",2,0],["إِذا وَصَفوا حُمَيّاها لِقَومٍ","تَخاذَلَتِ المَفاصِلُ وَالعُروقُ",98,"ق",1,0],["إذا وَرَدوا الهيجاءَ فالنّقعُ قاتمٌ","وإن صَدَرُوا بالخيلِ فالنّصرُ لامِعُ",99,"ع",1,0],["إِذا وَرَدَت حَفلاً تَغامَزَ أَهلُهُ","صَحائِفُ فُضَّت أَم نَوافِجُ تُفتَقُ",100,"ق",1,0],["إِذا وَجَرٌ عَظيمٌ فيهِ شَيخٌ","مِنَ السودانِ يُدعى الشَرَّتَينِ",101,"ن",1,1],["إِذا وَقَعَت بِكَعبٍ أَو قُرَيمٍ","وَسَيّارٍ فَقَد ساغَ الشَرابُ",102,"ب",1,0],["إِذا واضَحوهُ المَجدَ أَربى عَلَيهِمُ","بِمُستَفرِغٍ ماءَ الذِنابِ سَجيلِ",103,"ل",1,0],["إِذا وَرَدَت مِن آخِرِ اللَيلِ لَم تَعَف","حِياضَ الأَضا المَطروقَةِ الكَدِراتِ",104,"ت",1,0],["إِذا وَشى بِاللَيلِ صُبحٌ فَاِفتَضَح","وَذَكَّرَ الطائِرَ شَجوٌ فَصَدَح",105,"ح",1,0],["إذْ أوْصَلَ القَوْلَ الصَّريحَ بذِكْرِهِ","للسَّامِعِينَ فأَحْسَنَ التَّوصِيلا",106,"ل",2,0],["إذا ولجَ البعيرُ فروغ صبري","عن الصهباء في سُمّ الخياط",107,"ط",1,1],["إِذا وُلِدَ المَولودُ أَعمى وَجَدتَهُ","وَجَدِّكَ أَهدَى مِن بَصيرٍ وَأَجوَلا",108,"ل",2,1],["إِذا وَضَعَت في مَجلِسِ القَومِ نَعلَها","تَضَوَّعَ مِسكاً ما أَصابَت وَعَنبَرا",109,"ر",2,1],["إِذا واجَهتَها يَوماً","تَجُرُّ القَرقَرَ الحَبرا",110,"ر",2,0],["إِذا وُدٌّ جَفا وَأَرَبَّ وُدٌّ","فَجانِب مَن جَفاكَ لِمَن أَرَبّا",111,"ب",2,0],["إِذا وُقِيَ الإِنسانُ لَم يَخشَ حادِثاً","وَإِن قيلَ هَجّامٌ عَلى الحَربِ أَهوَجُ",112,"ج",1,0],["إِذا وَهَبَ اللَهُ لي نِعمَةً","أَفَدتُ المَساكينَ مِمّا وَهَب",113,"ب",1,1],["أَِذا وَعَدَتكَ خَيراً ما طَلَتهُ","وَهَل يُرجى لَها إِنجازُ وَعدِ",114,"د",1,0],["إِذا وُصِلَت بِالجِسمِ روحٌ فَإِنَّها","وَجُثمانُها تَصلى الشَدائِدَ وَالضَرّا",115,"ر",2,0],["إِذا وَدَّكَ الإِنسانُ يَوماً لِخِلَّةٍ","فغَيَّرَها مَرُّ الزَّمانِ تَنَكَّرا",116,"ر",2,1],["إِذا وَفَت لِتِجارِ الهِندِ فائِدَةٌ","فَاِجعَل مَعَ اللَهِ في دُنياكَ مُتَّجَرا",117,"ر",2,1],["إِذا وَرَدَ الفَقيرُ عَلى اِحتِياجي","أَغَثتُ لَهيفَهُ بِالمُستَدَفِّ",118,"ف",1,0],["إِذا وَقتُ السَعادَةِ زالَ عَنّي","فَكِلني إِن أَرَدتَ وَلا تُكَنّي",119,"ي",1,1],["إذا وعى الناس ما تبديه من حكم","آبوا إليك زرافات ووحدانا",120,"ن",2,0],["إِذا وَصَفتُ لِنَفسي هَجرَها جَمَحَت","وَدائِعُ الشَوقِ في أَقصى جَوانِحِها",121,"ح",3,0],["\"إذا وطئت بأيديها صخوراً","بقين لوطء أرجلها، رمالا\"",122,"ل",2,0],["إِذا وُضِعَت عَلى الأَبطالِ يَوماً","رَأَيتَ لَها جُلودَ القَومِ جونا",123,"ن",2,0],["إذا وَقَعَتْ مَدَارِيها عليه","سُتِرْنَ بجُنْحِ ليْلٍ أو دُفِنّه",124,"ن",2,0],["إذا وَصَفَ الطائيَّ بالبُخْلِ مادِرٌ","وعَيّرَ قُسّاًً بالفَهاهةِ باقِل",125,"ل",1,0],["إذا وَطِئَتْ عوداً برِجْلٍ حسِبْتَها","ثقيلةَ حِجْلٍ تَلمِسُ العودَ ذا الشِّرْع",126,"ع",1,0],["إِذا وَنى ثَغر الخطِّيُّ ثُغرتَهُ","أَوْ عاذَ بالنَّهْرِ مَسْلُوبَ القُوَى غَرِقَا",127,"ق",2,0],["إِذَا وَلَجَتْ بَيْتَ الضَّمِيرِ رَأَيْتَهَا","وَرَاءَ بَنَاتِ الصَّدْرِ تَسْفُلُ أَوْ تَعْلُو",128,"ل",2,0],["إِذَا وُلِدَ الْمَوْلُودُ مِنَّا فَدَرُّهُ","دَمُ الصِّيدِ والْجُرْدُ الْعَنَاجِيجُ مَهْدُهُ",129,"د",2,0],["إِذَا وَالِدِي قَدْ طَوَّقَتْنِي يَمِينُهُ","وَفِي وَجْهِهِ دَمْعٌ مِنَ العَيْنِ مُرْسَلُ",130,"ل",1,0],["إِذْ أَوْهَنَ الأَحْزَابَ خُلْفٌ أَفْرَزَتْ","فِيهَا ضَغَائِنَهُ سُمُومَ صِلاَلِ",131,"ل",1,0],["إِذَا وَسْوَسَتْ فِي صَدْرِ حَسْنَاءَ هِمةٌ","فَأَحْلَى سَمَاعٍ صَوْتُ حَلْيٍ مُوَسْوَسِ",132,"س",1,0],["إِذَا وَصَفَتْ وَجْداً تَخَيَّلْتَهَا جَرَتْ","بِمَا اكْتَنَّ فِي جَفْنِ المُحِبِّ المُسْهَّدِ",133,"د",1,0],["إِذَا وَسِع الكَوْنَ فِكْرُ امْرِيءٍ","فَلاَ بأْسَ بِالطَّرْفِ أَنْ يُحْسرَا",134,"ر",2,0],["إذا وطنٌ أهابَ بنابغيه","سبقتَ السابقين وقلت هاكا",135,"ك",2,0],["إِذا وَسَمتني يا بنيّ خَطيئَتي","فَلا تَنكِرَن وَجهي هُنالِكَ وَاِعرِفِ",136,"ف",1,0],["إِذا وَشَتِ المَدامِعُ لَم","يَكُفَّ الحِلمُ أَلسُنها",137,"ن",3,0],["إِذا وَرَدوا خَيلاً تَسَعَّرُ بِالقَنا","مَساعِرُ جَمرِ المَوتِ وَالغَمَراتِ",138,"ت",1,0],["إِذا وُتِروا مَدّوا إِلى واتِريهِم","أَكُفاً عَنِ الأَوتارِ مُنقَبِضاتِ",138,"ت",1,0],["إذَا وَفَّقَ اللّهُ امْرأً في طِلاَبِه","دَنَا الصَّعْبُ وانْقَاد العَسِير المُمَنَّع",139,"ع",1,0],["إذا وَهَنَتْ أذكى لَظَى رَغَباتِها","همامٌ له عند النجومِ رِغابُ",140,"ب",1,0],["إِذا وَهَنتْ فِيهِ الْقِلاصُ وَأدْبَرَتْ","فَذاكَ شَديدُ الْحَوْلِ مُحْتَمِلٌ جَلْدُ",141,"د",1,0],["إذا ودّ إنسانًا فليس لوده","حدودٌ، وإن عاداه فهْو مجاهره",142,"ر",2,0],["إذَا وَقَعْتُ لِكَعْبٍ أوْ خُثْيم","وَسَيَّارٍ يَسُوغُ لَهَا شَرَابِي",143,"ب",2,0],["إِذا وَطِئتْ بِأَيدِيَها صُخورًا","يَفِئنَ لِوَطءِ أَرجُلِها رِمالا",144,"ل",2,0],["إذا وُضعت عن الأبطال يوماً","رأيت لها جلود القوم جُونا",145,"ن",2,0],["إذا وقَعَتْ فَوْقَ الجَماجِمِ لمْ يَقُمْ","إلى يَوْمِ بَعْثِ الأوجلِينَ أمِيمُهَا",146,"م",3,0],["إذا وصفتَ امرءاً لامرئ","فلا تَغْلُ في وصفه واقصد",147,"د",1,0],["اذا ولجت في جوفه النفق الرحبا","لها صيحة عند الولوج كأنها",148,"ا",1,0],["إذا وضعَ الأحياءُ تاريخَ جيلهم","عَرفتَ المُلاحي مِنهمُ، والمُحابيا",149,"ي",2,0],["إذا وَقَعَ الرِّماحُ بمَنْكِبَيْه","تولَّى قابعاً فيهِ صدودُ",150,"د",1,0],["إذا وافَيتُ يَوماً رَيعَ مُلكٍ","ليَ المرباغُ فيهِ والصّفايا",151,"ا",3,0],["إذا وزنت بالشعر معنى ودقةً","يخفُّ لها كل القَرِيضِ وترجحُ",152,"ح",1,0],["إذا ورّث المُثرون أبناءَهم غنىً","وجاهاً فما أشقى بني الحكماءُ",153,"ا",2,0],["إذا وطِئت شُوشُ الملوك بساطَه","تضاءل منها كلُّ أغلبَ هِرماسِ",154,"س",1,0],["إِذا وَجوهُهُمُ بِالعِثيَرِ اِنتَقَبَت","بَدا المَضاءُ الَّذي ما دونَهُ نُقُبُ",155,"ب",1,0],["إِذا وَحى الحِقدُ وَالشَحناءُ ما اِجتَرَموا","مَحا تَجاوُزُهُ وَالصَفحُ ما كَتَبا",156,"ب",2,0],["إذا وعد تنا عنه وعدا نفوسنا","قبضنا بأيدينا على ذلك الأمر",157,"ر",1,0],["إِذَا وَثِقتُ بِرَبِّي","وَكَانَ باللهِ أُنسِي",158,"ي",1,1],["إذا وهب الدنيا لسائِله غَدَا","له سائلا ألا يَعِى ذاك سامع",159,"ع",1,0],["إذا وفت الحسناء للشيخ في الهوى","فعن عوض لا حبّ شوق مرتّب",160,"ب",1,0],["إذا وسعتْ في قفصٍ لطيرٍ","فكيفَ يفرُّ والقفصُ المطارُ",161,"ر",1,0],["اذا وفد الوفود عليه يوما","يقول لوفده حييت وفدا",162,"د",2,0],["إذا وعدت هندٌ ثَنى جودَها الوعد","وإن سَمحت يوما فنائِلُهَا ثَمْد",163,"د",1,0],["إذا وجدوا في الوقت كانوا طرازه","وقد طرزوا من قبل ذاك التصانيفا",164,"ف",2,0],["إذا وصلت حمى سلع وطاب به","لك المقيل وزال الأين والعند",165,"د",1,0],["إِذا وَصَلَت فَلَيسَ لَها وَفاءٌ","وَإِن عَهِدَت فَلَيسَ لَها ذِمامُ",166,"م",1,0],["إِذا وَرِثوا في غَيرِ دينٍ تَعَرَّضوا","عَنِ الذاهِبِ الماضي بِمُستَقبِلِ الأَجرِ",167,"ر",1,0],["إِذا وُزِنَ الناسُ طُرّاً بِهِم","فَكَفَّةُ ميزانِهِم تَرحَجُ",168,"ح",2,0],["إِذا وَضَعَتهُ بِالجُبوبِ رَأَيتَهُ","كَشاةِ الكِناسِ الأَعفَرِ المُتَجَرثِمِ",169,"م",1,0],["إذا وافَيتَها لم تُبقِ هَمّا","بِقَلبِكَ مُذ تَراها من بَعيد",170,"د",1,0],["إذا وردت ماء الوريد ونحوه","يعود لها عيد فما تسأم النحرا",171,"ر",2,0],["إذا وقفنا وأسمَعنا بلا وَجلٍ","زئيرنا أسمعوا صَيحاتِ يأسِهم",172,"م",1,0],["اذا وَصلوا طاب الزَمان بوصلهم","وان هجَروا فالهَجر عِندي أَطيَب",173,"ب",1,0],["إِذا وَقَفُوا قُلْتَ الهِضَابُ الفَوارِعُ","وإِنْ زَحَفُوا قُلْتَ الرِّياحُ الزّعازِعُ",174,"ع",1,0],["إِذا وَصَفْناهُ وَلَمْ نُسْمِهِ","قَالَ الْوَرى ذاكَ أَبُو الْيُمْنِ",175,"ن",1,0],["إِذا وُقِّيتُما مِنْ كُلِّ خَطْبٍ","فَما نَبْغِي عَلَى زَمَنٍ ظَهِيرا",176,"ر",2,0],["إِذا واحدٌ مِنْهُمْ جَلَتْهُ مَخِيلَةٌ","تَبَيَّنْتَ فِي أَعْطافِهِ الْعَسْكَرَ الْمَجْرا",177,"ر",2,0],["إِذا وَهَبُوا جادَ الْغَمامُ بِصَوْبِهِ","وَإِن غَضِبُوا جاءَ الْعَرِينُ بِغُلْبِهِ",178,"ب",2,0],["إِذا وَجهُهُ لاحَ بَينَ المِلاحِ","أَقَرَّ الجَميعُ لَهُ بِالزَّعامَه",179,"م",2,0],["إِذا وادي النسيمِ جَرى عليهِ","تَرى لُججاً لها حبب نضيدُ",180,"د",1,0],["إذا ولد المولودُ سروا بفرحةٍ","ومن حقهِ أن يبدلوها بترحةِ",181,"ه",1,1],["إِذا وَردنا آجِناً جَهَرناه","وَلا يَطاعُ وِردُ ما مَنَعناه",182,"ه",1,1],["إِذا وَرَدَت ماءً هُدوءاً جِمامُهُ","أَصاتَ سَديساها بِهِ فَتَشَوَّرا",183,"ر",2,0],["إذا وَعَدُوا فَلا سَلِمُوا فَكُلٌّ","مُسَيْلَمَةٌ يُحَدِّثُ عَن سَجَاحِ",184,"ح",1,0],["إِذا وَصَفَ العُشّاقُ مَعنى جَمالِكُم","فَتَجُرُّ يَدُهُ عَن كُلِّ وَصفٍ لَهُ وَصفي",185,"ي",1,1],["إذا وعدت أشار الحال منها","إلى خلفِ المواعدِ بالبنان",186,"ن",1,0],["إِذا وَرَدَت ماءً بِلَيلٍ كَأَنَّها","سَحابٌ أَطاعَ الريحَ مِن كُلِّ مَخرِمِ",187,"م",1,0],["إِذا وَرَدَت تَسقي بِحِسيٍ رِعاؤها","قَصيرِ الرِشاءِ قَعرُهُ غَيرُ مُحبِلِ",188,"ل",1,0],["إذا وَجْهُها والبَدْرُ لاحا بلَلْيةٍ","فما أَحَدٌ يَدْري مَنِ البَدْرُ مِنْهما",189,"م",2,0],["إذا وَردوا بها الهَيْجاءَ ظَمْأَى","صدَرْنَ من الكُلَى صَدَرَ النِّهال",190,"ل",1,0],["إذا وعَد الّراجينَ في كَلماتِه","حكَتْ لك رَوضاً في جوانبِه إضا",191,"ض",2,0],["إذا وَرَّعتَ من لَحيَيهِ شيئاً","سَمَا مُتَقاذِف التقريبِ طاحي",192,"ح",2,0],["إذا وطىء الضرغام أرضاً تضايقت","خطا وحشها عنه فيوسعُها هَزما",193,"م",2,0],["إذا وجَدتُكِ أبهَى ما ابتُليتُ بِه","مَلولةً كنتُ أولَى منكِ بالمَلَلِ",194,"ل",1,0],["إذا وصلَت منَّت وملَّت كأنَّما","يواصِلُ عنها منُّها ومَلالُها",195,"ل",3,0],["اِذا وَلّاكَ سُلطانٌ فَزِدهُ","من التَعظيمِ وَاِحذَرهُ وَراقِب",196,"ب",1,1],["إذا وهى الحب فالهجران يقتله","إن تمكن فالهجران يحييه",197,"ه",1,1],["إذا وافى كتابك قبلوه","وعجوا بالدعاء لكل عاني",198,"ي",1,0],["إذا ورد الحجيج إلى رباهم","تلقوهم ببشر وابتسام",199,"م",1,0],["إذا ورَدَ الحُجَّاجُ وافى رِكابَهُمْ","بفوَّارَتَيْ دَمْعٍ هما الثَّجْلُ والسَّجْلُ",200,"ل",1,0],["إذا وُلِّيتَ فاعُمرْ ما تَليهِ","بعَدلِكَ فالإمارَةُ بالعمارَهْ",201,"ه",1,1],["إِذا وَرَدَ القَرارَة بَعدَ أَينٍ","حَشا فاهُ عَلى فاس اللِجامِ",202,"م",1,0],["إِذا وازَنتُهُ بِالناسِ طُراً","رأَيت البَعض يَعدل بِالجَميعِ",203,"ع",1,0],["إِذا وَقَعوا في وَقعَةٍ أَوقَعوا بِها","وَبالاً فَهُم أَشبالِها وَأسودُها",204,"د",3,0],["إِذا واجه الشَمسُ رد الشعاع","أَو اعترَض الريحُ سَد المهب",205,"ب",1,0],["إذا وَجدتُ كثيبا","غَرست فيه قَضيبا",206,"ب",2,0],["إذا وصلتَ وقاكَ اللهُ مَهلكَةً","وذادَ عنكَ الرَّدى إن خُضتَ مَعركةً",207,"ه",1,0],["إذا وَرَدَت آمالُنا بَحرَ جُودِه","صَدَرنَ روَاءً ما بِهنِّ غَليلُ",208,"ل",1,0],["إذا وُصِفوا بالعلم والحلم والتقى","فبالعلم أعلام وبالحلم أجبال",209,"ل",1,0],["إذا وَعَدوا بالندى أنجزوا","وإنْ أوْعَدوا بالرَّدى أَذعروا",210,"ر",3,0],["إذا وُلدَ المولود منهم لوالدٍ","فللمجد مولودٌ وللمجد يولد",211,"د",1,0],["إذا وافَت إلى مغناك فازت","ذوو الحاجات واتَّصل الحباء",212,"ا",2,0],["إذا وضعت الشعر في أهله","فلي بزند الافتخار اقتراح",213,"ح",1,0],["إذا وطئ التراب بأخمصيه","تمنَّى أن يكون له ترابا",214,"ب",2,0],["إِذَا وَظِيفُ الثناءِ مُرْتَبَطٌ تَحْ","تَ رِواقِ العُلاَ بِقَيْدِ النَّوَالِ",215,"ل",1,0],["إِذَا وَنَتْ بِخطاهُ هَيْبَةٌ حَكَمَتْ","عَلَيْهِ ثارَ بِهِ مُسْتَعْذَبُ الأَمَلِ",216,"ل",1,0],["إذا ونت الرعود بها حدتها","جنابيها فزادت في بكاها",217,"ا",3,0],["إذا ورَدَ الغرائبُ أقحمتها","على الإقراب خيفتُها العِصيَّا",218,"ي",2,0],["إذا وسم التعريفُ فوق جباهها","أبا حَسنٍ عادت بذكرك أحسنا",219,"ن",2,0],["إذا وَسَمتْ بالعزِّ عِرضَك أَلبستْ","عدوَّك ذلَّاً عمَّ وسماً جبينَهُ",220,"ن",2,0],["إذا وقفن صفوفا للدجى ثبتتْ","أقدامهنَّ له والهامُ تنهزمُ",221,"م",1,0],["إذا وعدَتْه رؤيَتِك الليالي","سرى مستصحبا بكِ في الظلامِ",222,"م",1,0],["إذا ولَّيتَه كتمانَ سرٍّ","أمنتَ إذاعةَ الرجُل النمومِ",223,"م",1,0],["إذا وخزتك أنفاسُ الخُزامَى","فهبَّ لنا ابنُ ليلٍ كان نامَهْ",224,"م",2,0],["إذا وسَمتْ عِرضَ اللئيم بِميسَمٍ","من الذمِّ باقٍ ودَّ لو كان أُغفِلا",225,"ل",2,0],["إذا وَكَّلتْ طَرفها بالسما","ء خِيل بإدراكها وُكِّلا",226,"ل",2,0],["إذا ولِيتْ كفُّ الشَّمال التئامَه","فليس لكفّ الشمس منه مفرّقُ",227,"ق",1,0],["إذا وُزِنوا به رجَحتْ عليهم","موازينٌ بسودَدِهِ وصوعُ",228,"ع",1,0],["إذا ولدت بطنُها للتمامِ","فتىً شَهَرتْه على ظهرِها",229,"ر",3,0],["إذا وَلدوا فتىً سعت المعالي","تَباشَرُ بينها بالازديادِ",230,"د",1,0],["إذا وجه يومٍ غيره كان عابساً","تبسّم عن ساعاتِ أبلجَ واضح",231,"ح",1,0],["إذا وَلَدَ استَذكرنَ حزماً إناثُهُ","كما ذُكِّرتْ أخلاقُهُ وضرائبُهْ",232,"ب",2,0],["إذا وَطنٌ عن الأحبابِ عَزَّى","فلا دارٌ بنجدَ ولا حبيب",233,"ب",1,0],["إذا وصَفَ الحُسْنَ البياضُ تطلَّعَتْ","سَوَاهِمُ يُفْدَى بالبياضِ شُحوبُها",234,"ب",3,0],["إذا وسَمتُ حَيَاها باسمك أنحدرتْ","له الزُّبَى وأطاعته المصاعيبُ",235,"ب",1,0],["إذا وسمتَ علاماتٍ به فبدت","تلوح فهي له سِتْرٌ وإخفاءُ",236,"ا",2,0],["إذا وهموا في نقل ما يدرسونه","شآهم فصيحٌ قائلٌ قبل ناقلِ",237,"ل",1,0],["إذا ونين من الأرقال واضْطمرتْ","من اللُّغوب خلطْن البيدَ بالبيدِ",238,"د",1,0],["إذا وكفةٌ من بغيةٍ نضحَتْ له","غدا حمده في إثرها وهو ساجمُ",239,"م",1,0],["إذا وخَدَتْ بمِدْحَته المَطايا","طَوَتْ عنها المَوارِدَ وهي هيمُ",240,"م",1,0],["إذا وَرَدَ المريدُ يريد شربا","وَرُدَ وقلبه ضام لهيف",241,"ف",1,0],["إذا وهبوا فالغيث تهمي مياههُ","وإن غضبوا فالنار تذكو ضرامها",242,"م",3,0],["إذا وشجت أيدي الكماة متونه","فالله كم صدرٍ يحطم في صدر",243,"ر",1,0],["إِذا وَرَدَ المِسواكُ رَيّانَ بِالضُحى","عَوارِضَ مِنها ظَلَّ يَخصُرُهُ البَردُ",244,"د",1,0],["إِذا وَجَّهَهُ لَم يضندَ مِن زَهَراتِهِ","سِوى طُرفَةً لَم يَعتَرِض غَيرَها طَرفُ",245,"ف",1,0],["إِذا وَصَفَ المَرءُ شَيئاً وَلَم","يَكُن مُستَحِقّاً لِتِلكَ الصِفَه",246,"ه",1,1],["إِذا وَخَدَت تَخالُ الريحَ تَحتي","وَإِن كانَت تُخالُ مِنَ الرِياحِ",247,"ح",1,0],["إِذا وَجَدتَ نَعيماً","تَبيعُهُ بِشَقاءِ",248,"ا",2,0],["اِذا ونتْ أو كَرَبتْ عيسُكم","تلغبُ اهوى وهو بي يُسئدُ",249,"د",1,0],["اِذا وقفتَ بها بكّاكَ ما حلُها","وآيةُ الشوقِ أن تبكي لكَ الدارُ",250,"ر",1,0],["اِذا وصفتُ له وجدي على ثقةٍ","بأنْ يُريحَ فؤادي زادَهُ تَعَبا",251,"ب",2,0],["اِذا وقفتُ بها والدمعُ منهملٌ","فاِنَّني بدمِ الأجفانِ أقطبُه",252,"ب",2,0],["إذا ورد الحجاج لاقى رفاقَهم","بفوَّارتي دمع هما السجل والنجل",253,"ل",1,0],["إذا وَلَجوا في مَعرَكٍ كادَ نَقعُه","لِطيبِهمِ يُربي على طَيِّبِ العِطْرِ",254,"ر",1,0],["إذا وَرَدَ العِدا منه كتابٌ","توعّدَهُم به طلَبوا الفِرارا",255,"ر",2,0],["إذَا وَرَدَتْهُ أَعْلامُ البَرايا","عَلَى ظَمَأٍ يَطيبُ لَها الوُرودُ",256,"د",1,0],["إذا وَطَرٌ لم أنْضُ فيه عزيمةً","فسِيّانِ عندي صحّتاه وسُقمُهُ",257,"م",2,0],["إذا وقع الجهول بنا دحاه","وأعرض عن مقالات السفيه",258,"ي",2,0],["إذا ولَّى سوادُ الرَّأسِ يوماً","يصيرُ هوَى سوادِ العينِ ظُلما",259,"م",2,0],["إذا وَرَدْنا حِياضَ العَيْشِ صافيةً","فأقَصرُ الوَقتِ بينَ الوِرْدِ والصَدَرِ",260,"ر",1,0],["إِذا وَصْلُ من أَهْوَاهُ لم يَكُ مُسْعدِي","فليت عَذُولي كَانَ بالصمت مسعدا",261,"د",2,0],["إِذَا وَهَبَ الإلهُ لنا عُقُولاً","وَهَبْتَ لِما وُهِبْنَاهُ عُقُولا",262,"ل",2,0]]}