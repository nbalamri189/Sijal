poem/85643","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39645","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16698","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30487","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42574","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42569","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55079","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12699","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43701","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9557","المتقارب"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50052","الرجز"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[77,"بُشرى يقومُ لها الزّمانُ خطيبا","https://www.poetsgate.com/ViewPoem.aspx?id=33311",""],[50,"أَظَلَّتْ علينا منك يوماً سحابَة","https://www.poetsgate.com/ViewPoem.aspx?id=30950",""],[13,"وَحَرَّمْتُ النِّسَاءَ وَإنْ أُحِلَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180831",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[28,"رأيت جريرا لم يضع عن حماره","https://www.poetsgate.com/ViewPoem.aspx?id=21986",""],[51,"مطايبُ عيشٍ زايلتْهُ مخابِثُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27263",""],[51,"تحلَّبتِ الأنواءُ بعد جمودها","https://www.poetsgate.com/ViewPoem.aspx?id=27438",""],[51,"الدينُ والعلمُ والنَّعماءُ والشرفُ","https://www.poetsgate.com/ViewPoem.aspx?id=29594",""],[51,"أسالمُ قد سلمتَ من العيوب","https://www.poetsgate.com/ViewPoem.aspx?id=27041",""]],"verses":[["أَظُنُّ شَخصَ الرَدى فَرداً فَأَحذَرُهُ","وَالمَوتُ أَكبَرُ مِن ظَنّي وَأَوهامي",0,"م",2,0],["أَظُنُّ اللَيالي بَعدَكُم سَتَريعُ","فَمَن يُبقي لي مِن رائِعٍ فَتَروعُ",1,"ع",1,1],["أَظَنَنتُموهُ عَلى الأَذى","في دارِكُم أَبَداً حَبيسا",2,"س",2,0],["أَظُنُّ رَأسَكَ قَد أَعياكَ مَحمَلُهُ","وَرُبَّ ثِقلٍ تَمَنّاهُ الَّذي طُرِحاً",3,"ح",2,0],["أَظَلُّ وَحيداً لا أَرى مَن أُحِبُّهُ","وَهَل بِالحِمى لي مِن خَليلٍ سِواكُما",4,"م",2,0],["أَظُنُّ الخَمرَ ريقَتَها وَظَنِّي","تُحَقِّقُهُ إِذا قَبَّلتُ فاها",5,"ا",3,0],["أَظُنُّ مَهاةَ الرَّمْلِ عن لَحَظاتِهِ","إِذَا نَظَرَتْ تَحْكي مِنَ السِحْرِ ما تَحْكي",6,"ي",1,0],["أَظُنُّ الفَتى مِنْ عَبْدِ شَمْسٍ فَإِنْ يَكُنْ","أَبُوهُ أَبَا سُفْيانَ فَهْوَ نَجيبُ",7,"ب",1,0],["أظلَّتْ مُحِلَّيْ طيّءٍ منهُ وقْعَةٌ","فكادوا يُبارونَ النّعامَ المُطَرّدا",8,"د",2,0],["أظُنُّ مِراحَها راحاً فمِنْهُ","بِها ثَمَلٌ وما شَرِبَتْ شَمولا",9,"ل",2,0],["أَظَلومُ لَمّا أَن مَلِلتِ وَحُلتِ عَن","عَهدِ المَوَدَّةِ قُلتِ كانَ وَكانا",10,"ن",2,1],["أَظاعِنونَ فَنَبكي أَم مُقيمونا","إِنّا لَفي غَفلَةٍ عَمّا تُريدونا",11,"ن",2,1],["أَظُنُّني عوقِبتُ إِذ لَم أَكُن","قَبِلتُ مِنكِ اليُسرَ في يُسري",12,"ي",1,0],["أَظَلومُ نَفسي في يَدَي","كِ حَياتُها وَمَماتُها",13,"ت",3,0],["أَظَلومُ حانَ إِلى القُبورِ ذَهابي","وَبَليتُ قَبلَ المَوتِ في أَثوابي",14,"ب",2,1],["أظنّكَ منْ ليْلِ الوِصالِ انْتَخَبْتَهُ","إلَيْنا وذاك اللّيلُ يوصَفُ بالقِصَرْ",15,"ر",1,0],["أظنُّ ديارَ الحَيِّ منّا قَريبةً","وظمْآنُ هَذا البُعْدِ حانَ وُرودُهُ",16,"د",2,0],["أظُنّها قد سحَقَتْ فُلْفاً","فذلِكَ السّحْقُ هوَ المُنْجي",17,"ج",2,0],["أَظْهَرْتَ دِينَ اللهِ فِي ثَغْرِ العِدَى","وَقَهَرْتَ تِمْثالاً بِهِ وَصَلِيْبَا",18,"ب",2,0],["أَظَلُّ كَئيباً لَو تَشوكُكَ شَوكَةٌ","وَتَفرَحُ لَو دُهدِهتُ مِن رأسِ حالِقِ",19,"ق",1,1],["أَظُنُّ هَذا جَريحاً","يَشكو الأَسى أَو طَعينا",20,"ن",2,0],["أَظُنُّ لَيلَكَ مُذ طالَ المُقامُ بِهِ","كَالقَومِ في مِصرَ لا يَنوي عَلى سَفَرِ",21,"ر",1,0],["أَظَلَّت جَلائِلَ أَعمالِهِ","ظِلالُ حُسَينٍ حَليفِ النَدى",22,"ا",1,0],["أَظَلُّ كَمُرتَدّ عَنِ الدينِ عاكِفاً","أُلازِمُهُ مالي سِوى شُغلِهِ شُغلُ",23,"ل",1,0],["أَظهَرتَ فَضلَ تُقىً وَفَضلَ تَعَفُّفٍ","وَاللَهُ يَعلَمُ أَنَّهُ بُهتانُ",24,"ن",1,0],["أَظَنَّ الأَعادي أَنَّ حَزمَكَ نائِمٌ","لَقَد تَعِدُ الفَسلَ الظُنونُ فَتُخلِفُ",25,"ف",1,0],["أَظَنينَةً دَعوى البَراءَةِ شَأنُها","أَنتِ العَدُوُّ فَلِم دُعيتِ حَبيبا",26,"ب",2,0],["أَظُنُّهُ حينَ أَتى أُمَّهُم","صَيَّرَ في نُطفَتِهِ مَغرَه",27,"ر",2,0],["أَظُنُّ الَّذي يُجدي عَلَيكِ سُؤالُها","دُموعاً كَتَبذيرِ الجُمانِ المُفَصَّلِ",28,"ل",1,0],["أظهرت في المجال من كل عضو","لعباً كان بالقلوب لعوبا",29,"ب",2,0],["أَظُنُّ اِنهِلالَ الدَمعِ لَيسَ بِمُنتَهٍ","عَنِ العَينِ حَتّى يَضمَحِلَّ سَوادُها",30,"د",3,0],["أَظاعِنَةٌ جُعادَةُ لَم تُوَدِّع","أُحِبُّ الظاعِنينَ وَمَن أَقاما",31,"م",2,0],["أَظَنَّ عُيَينَةُ إِذ زارَها","بِأَن سَوفَ يَهدِمُ فيها قُصورا",32,"ر",2,1],["أَظلَمَتِ الأَرضُ لِفِقدانِهِ","وَاِسوَدَّ نورُ القَمَرِ الناصِلِ",33,"ل",1,0],["أَظَنَّت بَنو بَكرٍ كِتابَ مُحَمَّدٍ","كَإِرمائِها مِن أَوفَضٍ وَرَصافِ",34,"ف",1,1],["أظلّ رأيك حتَّى صانَ نادِيها","ولو تأخَّر نادى رسمَ إطلال",35,"ل",1,0],["أظهرت إذ أذنبت فضل حلومكم","فأنا أمرؤ بذنوبِهِ يتوسَّل",36,"ل",1,0],["أظلّ إذا نظرت لوجنتيه","أنزّه في النقا والرقمتين",37,"ن",1,0],["أظهروا للوزير جهلاً وغدراً","وعماهُم يُراهُمُ أُدباءَ",38,"ا",2,0],["أظنُّك خُبِّرتَ أنّي امرؤٌ","أبَرُّ الرجالَ بشعري احتسابا",39,"ب",2,0],["أظلُّ إذا هزتهُ ريحٌ ولألأتْ","له الشمسُ أمواجاً طِوالَ الغواربِ",40,"ب",1,0],["أظل إذا اصطفقتُ على ذُراها","أهلِّلُ من محاذرة الرسوبِ",41,"ب",1,0],["أظهرَ ما تُضمِرُ لي كلَّهُ","حَملُكَ إيّايَ على الأجربِ",42,"ب",1,0],["أظلَّ سحابُ عُرفِك كل شيءٍ","ودرَّ على البلادِ بلا عصابِ",43,"ب",1,0],["أظلُّ إذا لاقيتُ غُرَّةَ وجههِ","ولَيلي نهارٌ ساكنُ الظلِّ ماكِثُهْ",44,"ث",2,0],["أظنُّ أبا حفص سيَحْسَبُ أنه","هو الرجل المعْنيُّ والحق أبلجُ",45,"ج",1,0],["أظلَّتْ سيوفُ الموت أهلَ بِلادِهِ","فَكَشَّفْتُمُ أظْلالَها وَهْيَ رُكّدُ",46,"د",1,0],["أظلَّتْ فقال الحرثُ والنَّسْل هذه","فُتُوح سماءٍ أقبلت في سُدودها",47,"د",3,0],["أظنَّ أميرَ المؤمنين كغيره","من الناس تَبَّاً للغَويِّ المعانِدِ",48,"د",1,0],["أظنك مما قد مَطلت مَثوبتي","يسرُّك لو دارتْ عليّ الدوائرُ",49,"ر",1,1],["أظللتُمُ بشكير نبتُهُ ثمر","للمجتبين وحييتم بنُوار",50,"ر",1,0],["أظْلمَ ليلي وأنت لي قمرٌ","فَنَوِّرِ الليلَ أيها القمر",51,"ر",1,0],["أظلني سوءُ رأي منه متصلٌ","وليس لي من بلاء سيِّئٍ سلف",52,"ف",1,0],["أظلُّ إذا شاهَدْتُ يومَ نعيمِهِ","كأنّي في الفردوسِ فوقَ الأرائك",53,"ك",1,0],["أظنُّك حين تقدُر لي نَوالاً","يقلُّ لديك لي منه الجزيل",54,"ل",1,0],["أظنُّ الرأيَ ساء ولِمْ وأنَّى","وذاك النُّور ليس له أفولُ",55,"ل",1,0],["أظلّ إذا كافحتها وكأنني","بوهَّاجها دونَ اللثام مُلثَّمُ",56,"م",1,0],["أظلَّتْ غواشي رحمةِ الله قبرَها","فأضحى جناباهُ من النارِ في حرمْ",57,"م",1,0],["أظنُّ اليومَ قد غابتْه شهراً","وشهراً لا أراها فيه عاما",58,"م",2,0],["أَظُنُّ القراطيسَ في مِصْرِكُمْ","تخوَّنها ريبُ دَهْر خئون",59,"ن",1,0],["أظَلَّتْهُ السلامةُ ما تَغَنَّتْ","مطوَّقةٌ تَرنَّم فوق غصن",60,"ن",1,0],["أظهِرْ من المنعِ ما تجمجِمُه","فشرُّه ما يكون مكنونا",61,"ن",2,0],["أظهرتُ في شعره من ضعف مُنته","خِزياً أعضَّ له من هتكِ بوران",62,"ن",1,0],["أظهرت في شعره من ضعف مُنَّتهِ","خِزياً أعضَّ له من خِزي بورانا",63,"ن",2,0],["أَظلالُها في ناظِرَيكِ","تَنِمُّ يا سَلمى عَلَيكِ",64,"ك",1,0],["أَظمَأتُهُ لَمّا جَفَوتَ وَطالَما","أَسقَتهُ مِن نُعمى يَدَيكَ سُيولُ",65,"ل",1,0],["أَظُنُّ حَبيبي حالَ عَمّا عَهِدتُهُ","وَإِلّا فَما عُذرٌ عَنِ الوَصلِ مانِعُ",66,"ع",1,0],["أَظَلُّ نَهاري كُلَّهُ مُتَشَوِّقاً","لَعَلَّ رَسولاً مِنكَ يُقبِلُ بِالرِضا",67,"ض",2,0],["أَظَنَنتِ لي قَلباً عَلى","هَذي الحَماقَةِ مِنكِ صابِر",68,"ر",1,0],["أَظُنُّ فُؤادي شَوقُهُ غَيرُ زائِدٍ","وَأَحسَبُ جَفني نَومُهُ غَيرُ عائِدِ",69,"د",1,0],["أَظَلَّ الوُجُودَ المساءُ الحزينُ","وفي كفِّهِ معْزَفٌ لا يُبينْ",70,"ن",1,1],["أَظَلَّ الفضاءَ جناحُ الغروبِ","فأَلقى عليهِ جمالاً كَئيبْ",70,"ب",1,0],["أَظمأَتْ مُهجَتي الحَيَاةُ فهل","يوماً تُبلُّ الحَيَاةُ بعضَ أَوامي",71,"ي",1,0],["أَظنُّ هَواها تارِكي بِمضلةٍ","مِن الأَرضِ لا مالٌ لديَّ ولا أَهلُ",72,"ل",1,1],["أَظَلُّ نَهاري مُستَهاماً وَيَلتَقي","مَعَ اللَيلِ روحي في المَنامِ وَروحُها",73,"ح",3,0],["اظافر الدهر غاصت فيه عابثة","ففيه من كل ظفر منه اخدود",74,"د",1,0],["اظهر الشعب ماله من ولاء","بهتاف من قلبه يتعالى",75,"ل",2,0],["أظنه باكياً خفيا","فانه يمسح الدموعا",76,"ع",2,0],["أظن نبيلا مات من داء سُله","فقد قال بعض إنه لثقيل",77,"ل",1,0],["أظلتك الخلافة في ذراها","وبرت سوحها بك والرحاب",78,"ب",1,0],["أَظَلَّتنا عَنِ الإِصلاحِ حَتّى","عَجَزنا أَن نُناقِشها الفَسادا",79,"د",2,0],["أَظَلَّ جَلالُ العِلمِ وَالمَوتِ وَفدَها","فَلَم تُلقَ إِلّا في خُشوعٍ وَإِجلالِ",80,"ل",1,0],["أَظمَتكُموُ الأَيّامُ ثُمَّ سَقَتكُمو","رَنَقاً مِنَ الإِحسانِ غَيرَ قَراحِ",81,"ح",1,0],["أَظلَمَ الشَرقُ بَعدَ قَيصَرَ وَالغَر","بُ وَعَمَّ البَرِيَّةَ الإِدجاءُ",82,"ا",2,0],["أَظمَتنِيَ الدُنيا فَلَمّا جِئتُها","مُستَسقِياً مَطَرَت عَلَيَّ مَصائِبا",83,"ب",2,0],["أَظَبيَةَ الوَحشِ لَولا ظَبيَةُ الأَنَسِ","لَما غَدَوتُ بِجَدٍّ في الهَوى تَعِسِ",84,"س",1,1],["أظلَّهمُ منه سَحابٌ تَفَرَّقَتْ","صواعقُه فيه وفيهم مواطِرُهْ",85,"ر",2,0],["أَظُنُّهُ أُنسِيَ الَّذي وُهِبَت","يَداهُ نِسيانَهُ الَّذي يَهَبُ",86,"ب",1,0],["أَظهَرَ العَدلُ فَاِستَنارَت بِهِ الأَر","ضُ وَعَمَّ البِلادَ غَوراً وَنَجدا",87,"د",2,0],["أَظهَرتَ عِزَّ المُلكِ فيهِ بِجَحفَلٍ","لَجِبٍ يُحاطُ الدينُ فيهِ وَيُنصَرُ",88,"ر",1,0],["أَظالِمَةَ العَينَينِ مَظلومَةَ الحَشا","ضَعيفَتَهُ كُفى الخَيالِ المُؤَرِّقا",89,"ق",2,0],["أَظَلَّهُم مِنكَ جودٌ لَو وَسَمتَ بِهِ","مَنابِتَ الأَرضِ لَاِستَغنَت عَنِ الدِيَمِ",90,"م",1,0],["أَظَنَنتُمُ أَن قَد عُتِقتُم بَعدَما","كُنتُم عَبيدَ إِتاوَةٍ في تَغلِبِ",91,"ب",1,0],["أَظُنُّ اِبنَ عيسى لاقِياً مِثلَ وَقعَةً","بِعَمروِ بنِ عِفرى وَهيَ قاصِمَةُ الظَهرِ",92,"ر",1,1],["أَظُنُّكَ مَفجوعاً بِرُبعِ مُنافِقٍ","تَلَبَّسَ أَثوابَ الخِيانَةِ وَالغَدرِ",93,"ر",1,0],["أَظُنُّ رِجالَ الدِرهَمَينِ تَسوقُهُم","إِلى قَدَرٍ آجالُهُم وَمَصارِعُ",94,"ع",1,1],["أَظَنَّ بِنا زَوجُ المَراغَةِ أَنَّهُ","مِنَ الفَقرِ لاقيهِ الهُزالُ فَقاتِلُه",95,"ل",2,0],["أَظُنُّ بَناتِ القَومِ كُلَّ حَبِيَّةٍ","سَيَمنَعنَ مِنهُم كُلَّ وِدٍّ وَنائِلِ",96,"ل",1,0],["أَظَنَّت كِلابُ اللُؤمِ أَن لَستُ شاتِماً","قَبائِلَ إِلّا اِبنَي دُخانٍ بِدارِمِ",97,"م",1,0],["أَظَنَّت كِلابُ اللُؤمِ أَن لَستُ خابِطاً","قَبائِلَ غَيرَ اِبنَي دُخانٍ بِدارِمِ",98,"م",1,0],["أظنه عاقبني","بما جناه أيري",99,"ي",1,0],["أَظَلَّ دِجلةَ فانحَطَّتْ غَوارِبُها","واصفرَّ من جانِبَيْها مُورِقُ السَّلَمِ",100,"م",1,0],["أَظِباءُ وَجْرَةَ أَقصَدَتْ","كَ بسِحرِ أجفانٍ فَواتِر",101,"ر",1,0],["أَظُنُّ نُجْلَ العيونِ تَحسُدُه","فَهْيَ مِراضٌ من شِدَّةِ الحَسَدِ",102,"د",1,0],["أَظَلُّ إِذا رَأَيتُكَ مُستَكيناً","كَأَنَّكَ قَد بَعَثتِ عَلَيَّ آفَه",103,"ف",2,0],["أَظُنُّ الغَيثَ يَحسُدُنا عَليهِ","فَيَمنَعُ مِن زِيارَتِكَ العِبادا",104,"د",2,0],["أَظُنُّ السُحبَ تَحسُدُنا عَليهِ","فَتَمنَعُ مِن زِيارَتِكَ العِبادَ",105,"د",1,0],["أَظَنَنتَ كُلَّ الرَدِّ يَقبُحُ فِعلُهُ","رَدُّ الجَوابِ خِلافُ رَدِّ السائِلِ",106,"ل",1,0],["أَظُنُّهُم ما دَرَوا ما بي وَقَد رَحَلوا","تَاللَهِ لَو عَلِموا حالي بِهِم رَحِموا",107,"م",3,0],["أَظُنُّكَ إِذ حَوَيتَ الحُسنَ طُرّاً","وَإِذ وَفَّيتَ أَقسامَ الجَمالِ",108,"ل",1,0],["أَظلَمَت بَعدَهُ الدِيارُ وَقَد كا","نَ سِراجاً بِها وَبَدراً مُنيرا",109,"ر",2,0],["أَظهَروا لي تَمَلُّقاً وَاِكتِئاباً","هُوَ عِندي تَهَكُّمٌ وشَماتَه",110,"ت",2,0],["أَظهَرتَ عَلَينا مِنَ السَماحِ سِماتٍ","إِن قَصَّرَ نُطقي بِوَصفِها نَطَقَ الحال",111,"ل",1,0],["أَظَلُ وَأُمسي راقِدَ الجارِ ساهِراً","سَوامِيَ في خَوفٍ وَجارِيَ في أَمنِ",112,"ن",1,0],["أظلامٌ لضياءٍ طَبَقٌ","أم على الكافور بالمسكِ خُتِم",113,"م",1,0],["أظلومُ منكِ تعلّمت ظلمي","حرباً وكانت قبل ذا سَلْمي",114,"ي",1,1],["أظنّك لم تُفْتَحْ عليك نواظِرٌ","إذا هي أعْطتْ صبوةً أخذَتْ عقلا",115,"ل",2,0],["أَظُنُّ عِندَكَ أَقواماً وَأَحسَبُهُم","لَم يَأتَلوا فِيَّ ما أَعدَوا وَما رَكَضوا",116,"ض",3,0],["أَظمى الفُصوصِ وَلَم تَظمَأ قَوائِمُهُ","فَخَلِّ عَينَيكَ في ظَمآنَ رَيّانِ",117,"ن",1,0],["أَظُنُّ البَينَ كانَ يُريدُ فَجعي","بِهِ إِذ صارَ يَحسُدُني عَلَيهِ",118,"ي",2,0],["أَظهَرتُ مِن لَوعَةِ الهَوى جَزَعاً","وَالصَبرُ إِلّا عَنِ الهَوى كَرَمُ",119,"م",1,0],["أَظلَمَتِ الآمالُ مِن بَعدِهِ","وَعُرِّيَت مِن كُلِّ حُسنٍ وَطيبِ",120,"ب",1,0],["أَظَلَّهُ البَينُ حَتّى إِنَّهُ رَجُلٌ","لَو ماتَ مِن شُغلِهِ بِالبَينِ ما عَلِما",121,"م",2,0],["أَظُنُّ الدَمعَ في خَدّي سَيَبقى","رُسوماً مِن بُكائي في الرُسومِ",122,"م",1,0],["أَظَلَّتكَ آمالي وَفي البَطشِ قُوَّةٌ","وَفي السَهمِ تَسديدٌ وَفي القَوسِ مَنزَعُ",123,"ع",1,0],["أَظُنُّ دُموعَها سَنَنَ الفَريدِ","وَهى سِلكاهُ مِن نَحرٍ وَجيدِ",124,"د",1,1],["أَظَنَنْتَ لَوْعَتَهُ فُكَاهَةَ مَازِحٍ","فَطَفِقْتَ تَعْذِلُهُ عَلَى تَهْيَامِهِ",125,"م",2,0],["أظلمَتْ بعدَهُ البلاد وقالتْ","ما بَقِيْ مَنْ يقيم للزهدِ وزنا",126,"ن",2,0],["أَظَلُّ إِذا أُكَلِّمُها كَأَنّي","أُكَلِّمُ حَيَّةً غَلَبَت رُقاها",127,"ا",3,0],["أَظُنُّكَ تَحسَبُها في الوِدادِ","مُراجِعَةً بَعدَ عِهدانِكا",128,"ك",2,0],["أَظَلُّ بِهِ أُنادي مِن بَعيدٍ","وَأَلتَمِسُ المَطالِبَ مِن قَريبِ",129,"ب",1,0],["أَظُنُّكُما لا تَعلَمانِ مُصيبَتي","لَقَد حَلَّ بَينُ الوَصلِ فيما أَراكُما",130,"م",2,0],["أَظَلُّ بِحُزنٍ دائِمٍ وَتَحَسُّرٍ","وَأَشرَبُ كَأساً فيهِ سُمٌّ وَعَلقَمُ",131,"م",1,0],["أَظَلُّ أُمَنّي النَفسَ إِيّاكِ خالِياً","كَما يَتَمَنّى بارِدَ الماءِ صائِمُ",132,"م",1,0],["أَظَلُّ رَزيحَ العَقلِ ما أُطعَمُ الكَرى","وَلِلقَلبِ مِنّي أَنَّةٌ وَخُفوقُ",133,"ق",1,0],["أَظَلُّ بِحُزنٍ إِن تَغَنَّت حَمامَةٌ","مِنَ الوُرقِ مِطرابُ العَشِيِّ بَكورُ",134,"ر",1,0],["أَظَلُّ غَريبَ الدارِ في أَرضِ عامِرٍ","أَلا كُلَّ مَهجورٍ هُناكَ غَريبُ",135,"ب",1,0],["أظلَّها الفاتِحُ الغازي وشَارَفها","عَهْدٌ مِن الخيرِ مَيْمونُ التّباشيرِ",136,"ر",1,0],["أَظُنُّ القَومَ لا يَرجونَ أُخرى","وَلا يَخشَونَ عاقِبَةَ الغِوايَهْ",137,"ا",3,0],["أَظَلَّ جُموعَهُم حَدَثٌ مَهولٌ","لِيَكشِفَ عَنهُمُ الحَدَثَ المَهولا",138,"ل",2,0],["أظَلَّكُمْ خالدٌ لا شيءَ يَبعثُه","إلا الجهادُ يراه أعظمَ القُرَبِ",139,"ب",1,0],["أَظُنُّ وِشاحَهُ يَهذي خَبالاً","وَما تَدري الخَلاخِلُ ما يَقولُ",140,"ل",1,0],["أَظَلُّ وَيَومي فيكَ هَجرٌ وَوَحشَةٌ","وَيَومي بِحَمدِ اللَهِ أَحسَنُ مِن غَدي",141,"ي",1,0],["أظنُّه مَلاَّ","منِّي الجوارْ",142,"ر",1,0],["أَظُنّي مَيِّتٌ كَمَداً وَلَمّا","أُطالِع طَلعَةً أَهلَ الكِرابِ",143,"ب",1,0],["أَظُلَيمُ إِنَّ مُصابَكُم رَجُلاً","أَهدى السَلامَ تَحِيَّةً ظُلمُ",144,"م",1,0],["أَظَلُّ نَهاري مِن هَواها كَأَنَّني","مِنَ الوَجدِ في داد مِنَ اللَيلِ مُظلِمِ",145,"م",1,0],["أَظهَرَ ما في قَلبِهِ المَقبولِ","فَجائَهُ بِرَأسِهِ المَقتولِ",146,"ل",1,0],["أَظُنُّكُمُ مِن حاطِبِ اللَيلِ جَمَّعَت","حَبائِلُهُ عَقارِباً وَأَفاعِيا",147,"ي",2,0],["أَظُنُّني ذائِقاً حِمامي","وَأَنَّ إِلمامَهُ قَريبُ",148,"ب",1,0],["أَظَلَّت عَطاياهُ نِزاراً وَأَشرَفَت","عَلى حِميَرٍ في دارِها وَمُرادِ",149,"د",1,0],["أَظهَرتُ نُسكاً وَقُلتُ الخَمرُ أَشرَبُها","وَاللَهُ يَعلَمُ أَنَّ الخَمرَ إِضماري",150,"ر",2,0],["أَظَلُّ يَقظانَ مِن تَذَكُّرِهِ","حَتّى إِذا نِمتُ كانَ لي حُلُما",151,"م",2,0],["أَظَلَّ مِنها عَلى شَفا خَدَرٍ","يَأخُذُ مِن مَفرِقي إِلى القَدَمِ",152,"م",1,0],["أَظرِف بِقِدرِكَ لَولا أَنَّها غَبَرَت","وَما تَطورُ بِها نارٌ وَلا رَسَمُ",153,"م",1,1],["أَظُنُّكِ مِن بَقِيَّةِ قَومِ موسى","فَهُم لا يَصبِرونَ عَلى طَعامِ",154,"م",1,0],["أَظهَرَ بَعدَ الوَصلِ هِجرانا","وَصَيَّرَ العِلّاتِ أَعوانا",155,"ن",2,1],["أَظُنُّ كِرياساً طَما قُربَنا","أَو ذَكَرَ اليُؤيُؤَ إِنسانُ",156,"ن",1,0],["أظهِر هواكَ مُعلناً","في السرّ والإعلانِ",157,"ن",1,1],["أَظَلَّت عَلَينا مِنكَ يَوماً سَحابَةٌ","أَضاءَت لَنا بَرقاً وَأَبطى رَشاشُها",158,"ه",2,1],["أَظَلتَ تُغَنّي سادِراً في مَساءَتي","وَأُمُّكَ بِالمَصرَينِ تُعطي وَتَأخُذُ",159,"ذ",1,0],["أَظُنُّ سَعيداً كائِناً لِصَديقِهِ","كَداحِسِ عَبسٍ أَو كَبَكرِ ثَمودِ",160,"د",1,1],["أَظَلُّ كَأَنّي شارِبٌ سُمَّ حَيَّةٍ","وَيَعتادُني الوَسواسُ حينَ أَبيتُ",161,"ت",1,0],["أَظَلُّ لِأَحداثِ المَنونِ مُرَوَّعاً","كَأَنَّ فُؤادي في جَناحِ طَلوبِ",162,"ب",1,0],["أَظُنُّكَ مِن حِذارِ البَينِ يَوماً","بِداءِ الحُبِّ سَوفَ تَموتُ رُعبا",163,"ب",2,0],["أَظُنُّ زَماني كَونَهُ وَفَسادَهُ","وَليداً بِتُربِ الأَرضِ يَلهو وَيَعبَثُ",164,"ث",1,0],["أَظَنَنتَ دَهرَكَ عَن خِطابِكَ صامِتاً","وَإِذا أَبَهتَ فَإِنَّهُ مِكثارُ",165,"ر",1,0],["أَظاعِنٌ أَنتَ أَم راسٍ عَلى مَضَضٍ","حَتّى تَخونَكَ مِن دُنياكَ أَمراسُ",166,"س",1,0],["أَظَلَمتَ فَاِهتَجتَ تَبغي في جَميعِهِمُ","نِبراسَ لَيلٍ وَما في القَومِ نِبراسُ",166,"س",1,0],["أَظُنُّكَ غَيرَ مُبالي الضَميرِ","بِخَصبِكَ يَوماً وَإِمحالِكا",167,"ك",2,0],["أَظُنُّكَ مِن ضُعفٍ بِلُبِّكَ غادِياً","يَحُلُّكَ مِن عِقدِ الزَواجِ المُعَزِّمُ",168,"م",1,0],["أَظفارُكَ اِستَعلَت إِلى أَظفارِهِ","بَأساً وَتِلكَ وَقتُ وَهذي تُقلَمُ",169,"م",1,0],["أَظهر بمعترك الحياة شجاعة","وتقلدنَّ العلم فهو سلاح",170,"ح",1,0],["أظن فيك اقتداراً","جماً فكن عند ظني",171,"ي",1,0],["أظنها رقّ منها القلب فانعطفت","لما رأَت ما لدمعي أمسِ من صبب",172,"ب",1,0],["أظلُّ أرنو نحوه مُرهِفاً","سمعي وما يكذبني ناظري",173,"ي",1,0],["أظلُّ أُصغِي وما من شُرْفةٍ فُتِحت","ولا أراح رِتاجَ الباب ديَّارُ",174,"ر",1,0],["أظُنّ سُلَيْمَى أَنْعَمَ اللهُ بالَها","حَدا حادِياها للوَميضِ جِمالَها",175,"ل",3,1],["أظُنّ الليالي وهْيَ خُونٌ غَوَادِرٌ","بِرَدّي إلى بَغدادَ ضَيّقَةَ الذَّرْع",176,"ع",1,0],["أَظلُّ قَعيد الدّارِ تجنُبُني العصا","على ضَعْفِ ساقٍ أَوْهَن السُّقْمُ رِجلَهَا",177,"ل",3,0],["أَظُلماً وَرُمحي ناصِري وَحُسامي","وَذُلّاً وَعِزّي قائِدٌ بِزِمامي",178,"ي",1,1],["أَظَلُّ فِيها أَنُوحُ فَرْدَاً","وَكُلُّ نَائِي الدِّيَارِ فَرْدُ",179,"د",1,0],["أَظْهَرُوا زُخْرُفَ الْخِدَاعِ وأَخْفَوْا","ذَاتَ نَفْسٍ كَالْجَمْرِ تَحْتَ الرَّمَادِ",180,"د",1,0],["أَظَلُّ فِيهَا غَرِيبَ الدَّارِ مُبْتَئِساً","نَابِي الْمَضَاجِعِ مِنْ هَمٍّ وَأَوْجَاعِ",181,"ع",1,0],["إِظْلمِينِي مَا شَاءَ ظُلْمُكِ وَانْهِي","آمِر الحُسْنِ أَنْ يَكُونَ شَفِيقَا",182,"ق",2,0],["أَظْهِرْ عَلى مَا فِي الضَّمَائِرِ كُلَّ ذِي","شَأْنٍ بِه فَالخَيْرُ فِي الإِظْهَارِ",183,"ر",1,0],["أَظَلَّتْهُ فِي ذاك الزَّمَانِ شُجَيْرَةٌ","هِيَ الآن أَضْحَتْ جدَّةَ الشَّجَرِ النَّضْرِ",184,"ر",1,0],["أَظَنّاً إِنَّ بَعضِ الظَنِّ إِثمٌ","أَمَزحاً رُبَّ جِدٍّ في مُزاحِ",185,"ح",1,0],["أَظُنُّ وَما جَرَّبتُ مِثلَكِ أَنَّما","قُلوبُ نِساءِ العالَمينَ صُخورُ",186,"ر",1,1],["أَظَلَّ الطَيرُ نَعشَكَ غَيرَ صَقرٍ","أَبى إِلّا عَلى القَنصِ اِنقِضاضا",187,"ض",2,0],["أَظلَمَ دَهرٌ أَنارَ مِنهُ","هَل بَعدَ إِظلامِهِ ضِياءُ",188,"ا",2,0],["أَظُنُّ زَماني كانَ بِاِبني يَهابُني","فَأَوحى إِلى جلّى رَزاياهُ أَن قَذي",189,"ي",1,0],["أَظَلُّ نَهارِيَ في شَمسِها","شَقِيّاً مُعَنّى بِبُنيانِها",190,"ن",3,0],["أَظَلَّه منها رِداءٌ أَم رَدى","فذلك اللذاتُ لا صيدَ الطَّلا",191,"ا",1,0],["أُظُمٌ عَزَزْنَ على الحنيفةِ حقبَةً","ثم استجَبْنَ على مَدَى الأيام",192,"م",1,0],["أظهرْتَ دينَ الله في ثُغْر العِدا","وقَهَرْت تمثالاً به وصليبا",193,"ب",2,0],["أَظَلَّتْ علينا منك يوماً سحابَة ٌ","أضاءت لنا برقاً وأبطا رشاشُها",194,"ه",2,1],["أَظُنِّي مَيِّتاً كَمَداً وَلَمَّا","أُطَالِعُ طَلْعَةً أهْلَ الكِرَابِ",195,"ب",1,0],["أظنك ما رنمت إلا تجلداً","وإن قال أقوام سلا فترنما",196,"م",2,0],["أظَنّ بِنَا زَوْجُ المَرَاغَةِ أنّهُ","مِنَ الفَقْرِ لاقِيهِ الخِزَالُ فَقاتِلُهْ",197,"ل",2,0],["أظلُّ إذ لاقيتُ غُرَّة َ وجههِ","ولَيلي نهارٌ ساكنُ الظل ماكِثُهْ",198,"ث",2,0],["أظلَّت فقل الحرثُ والنَّسْلُهذه","فُتُوح سماءٍ أقبلت في سدودها",199,"د",3,0],["أظلّني سوءُ رأيٍ منه متَّصِلٌ","وليس لي من بلاءٍ سيِّءٍ سلفُ",200,"ف",1,0],["أظل إذا طغوتُ على ذُراها","أهلِّل من محاذرة الرسوبِ",201,"ب",1,0]]}