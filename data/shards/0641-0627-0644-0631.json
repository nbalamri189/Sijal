{"poems":[[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[86,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[93,"إهنأ بما أهدى المليك","https://www.aldiwan.net/poem9675.html","عموديه"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"لا تنكر المعشوق في خده","https://www.aldiwan.net/poem20079.html","السريع"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[91,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"أما ترى العارض المنهل دانيه","https://www.aldiwan.net/poem66863.html","البسيط"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[66,"لا تخش من رد الجواب","https://www.aldiwan.net/poem38711.html","مجزوء الكامل"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[74,"أحس المدامة والنسيم عليل","https://www.aldiwan.net/poem13217.html","الكامل"],[81,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[52,"ضحك الورد في قفا المنثور","https://www.aldiwan.net/poem26980.html","الخفيف"],[48,"لولا الأمير وأن العذر منقصة","https://www.aldiwan.net/poem63308.html","البسيط"],[48,"كيف النزوع عن الصبا والكاس","https://www.aldiwan.net/poem63424.html","الطويل"],[7,"واستبق ودك للصديق ولا تكن","https://www.aldiwan.net/poem2005.html","الكامل"],[46,"إن جاد بالمال سمح يبتغي شرفا","https://www.aldiwan.net/poem22390.html","البسيط"],[46,"سبحان ربك هل يزول كغيره","https://www.aldiwan.net/poem22706.html","الكامل"],[46,"أعرض عن الثور مصبوغا أطايبه","https://www.aldiwan.net/poem22915.html","البسيط"],[46,"أنسل أو اعقم فالتوحد راحة","https://www.aldiwan.net/poem23146.html","الكامل"],[46,"قرنت جيشين فكم من دم","https://www.aldiwan.net/poem23535.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141915","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10035","الطويل"],[45,"أَما تَرَى العَارِضَ الْمُنهَلَّ دَانِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31682",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[116,"ها أنت نصرة عاجز مثلي أتاك","https://www.aldiwan.net/poem42182.html","الكامل"],[151,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[167,"ولست أستبدع ما نابني","https://www.aldiwan.net/poem47032.html","السريع"],[167,"يا أهل جرجان عفاء على","https://www.aldiwan.net/poem47043.html","السريع"],[167,"ومهمه يتراءى آله لججا","https://www.aldiwan.net/poem47131.html","البسيط"],[186,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[194,"ومهفهف تهفو بلبب","https://www.aldiwan.net/poem13104.html","مجزوء الكامل"],[211,"بدر توارى في من رقبائه","https://www.aldiwan.net/poem13380.html","الكامل"],[212,"الشمس تشرق من صباك","https://www.aldiwan.net/poem46562.html","مجزوء الكامل"],[222,"ذهبالشباب فأطرقت","https://www.aldiwan.net/poem55286.html","مجزوء الكامل"],[231,"نمت على نفس الشمال شمول","https://www.aldiwan.net/poem4042.html","الكامل"],[236,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[238,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[252,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[260,"لي منكم ورد الكتاب وضمنه","https://www.aldiwan.net/poem35789.html","الكامل"],[271,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[272,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[283,"حلفت لي هند فخانت يميني","https://www.aldiwan.net/poem32333.html","الخفيف"],[283,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[286,"ما بالها تلك الظباء نراها","https://www.aldiwan.net/poem39421.html","الكامل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"أدر المدامة بالكبير","https://www.aldiwan.net/poem33264.html","مجزوء الكامل"],[299,"صنع الجميل وفعل الخير إن أثرا","https://www.aldiwan.net/poem36309.html","عموديه"],[299,"حي الشآم وربعها","https://www.aldiwan.net/poem36827.html","عموديه"],[299,"قد صفت الحقب","https://www.aldiwan.net/poem36828.html","عموديه"],[304,"قلت له زرني فلا بد أن","https://www.aldiwan.net/poem58179.html","السريع"],[305,"الشك والوهم رأس الشر والحذر","https://www.aldiwan.net/poem16792.html","البسيط"],[306,"تونس الأنس بلدة ميمونه","https://www.aldiwan.net/poem56392.html","الخفيف"],[323,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[350,"يا ولي الخير لا تبخ","https://www.aldiwan.net/poem15709.html","مجزوء الرمل"],[365,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[365,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[365,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[367,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[378,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[378,"سقياك سقياك ربعا ظل مبتهجا","https://www.aldiwan.net/poem66893.html","البسيط"],[378,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[381,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[392,"ذه عرشه مامثلها عرشه","https://www.aldiwan.net/poem54470.html","عموديه"],[394,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[404,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[404,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[404,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[406,"ذكر أخاك إذا تناسى واجبا","https://www.aldiwan.net/poem49590.html","الكامل"],[406,"إن كنت تطلب ثروة وغنى","https://www.aldiwan.net/poem49642.html","أحذ الكامل"],[410,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[430,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[438,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[438,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[440,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[442,"رفقا عليك وصبرا فهو محمود","https://www.aldiwan.net/poem14451.html","البسيط"],[442,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[453,"إليك نزعة آداب يرن بها","https://www.aldiwan.net/poem13632.html","البسيط"],[459,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[462,"ان شارك الأدوان أهل العلى","https://www.aldiwan.net/poem16007.html","السريع"],[469,"يومنا يوم مجون","https://www.aldiwan.net/poem59622.html","مجزوء الرمل"],[469,"برك ممنطقة الخصور","https://www.aldiwan.net/poem60092.html","مجزوء الكامل"],[469,"قم يا صديقي نصطبح مشمولة","https://www.aldiwan.net/poem60309.html","الكامل"],[494,"بالقفص للقصف منزل كثب","https://www.aldiwan.net/poem67420.html","المنسرح"],[501,"تهادت العيس ليلا","https://www.aldiwan.net/poem37778.html","المجتث"],[505,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[511,"لا تخدعنك سمرة غرارة","https://www.aldiwan.net/poem1574.html",""],[559,"لا تأخذ الخلاق يا قوم","https://www.aldiwan.net/poem34085.html","أحذ الكامل"],[559,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"]],"verses":[["فالرّأيُ يُدْرِكُ ما يَعْيَى الحُسامُ بهِ","إذا الزّمانُ بِذَيلِ الفِتْنَةِ الْتَثَما",0,"م",2,0],["فالرُّمْحُ يُنَضْنِضُ منْ شَرَهٍ","لهُمُ والصّارِمُ قدْ دَلَقا",1,"ق",2,0],["فَالرَأيُ كُلُّ الرَأيِ أَن تُجمِعوا","فَإِنَّما إِجماعُكُم أَرجَحُ",2,"ح",1,0],["فَالرَّأْيُ إِجْمَاعٌ عَلَى","شُكْرِ المَلِيكِ لِمَا وَهَبْ",3,"ب",1,0],["فالروض ليس يَضيره","ما قد يطنطن من ذبابه",4,"ب",2,0],["فالرأس مشتعلٌ بشيبٍ أبيضٍ","والقلب مشتعلٌ بشيبٍ أسفع",5,"ع",1,0],["فالريح ريح المسك من خده","كما ترى والَّلون لون الدَّم",6,"م",1,0],["فالرعايا محميَّة في حماها","والمراعي مطلولةٌ مَوْبولهْ",7,"ل",2,0],["فَالرَوابي حِلَلٌ مِن سُندُسٍ","وَالسَواقي ثَرثَراتٌ وَغِناء",8,"ا",2,0],["فَالروحُ قيثارٌ وَهَت وَتَقَطَّعَت","أَوتارُهُ وَالقَلبُ قَفرٌ مُمحِلُ",9,"ل",1,0],["فالرزق لا الحذق هوال","أصل فباللله ثقِ",10,"ق",1,0],["فالرأيُ مثلَ القول مبتدَهٌ","والقولُ مثلَ الطعنِ مرتَجَلُ",11,"ل",1,0],["فَالريحُ تُزجيهِ تاراتٍ وَتَحدُرُهُ","وَالرَعدُ يُنجيهِ طَوراً أَو يُناجيهِ",12,"ي",2,0],["فالرَّوْضُ بينَ مُزَنَّرٍ ومُدَنَّرٍ","فيها وبينَ مُسيَّرٍ ومُحبَّرِ",13,"ر",1,0],["فَالرَدُّ يَجمُلُ في الأَما","نَةِ وَالتَحيَّةِ وَالجَوابِ",14,"ب",1,0],["فالرّمحُ قدٌّ والخداعُ تَدَلّلٌ","والسيفُ لحظ والنجادُ وشاحُ",15,"ح",1,0],["فالربعُ رحبٌ والندى ساكبٌ","والعيشُ رغدٌ والأماني قماح",16,"ح",1,0],["فَالرَبعُ قَد عَزَّني عَلى جَلَدي","ما مَحَّ مِن سَهلِهِ وَمِن جَلَدِه",17,"د",2,0],["فَالرَّوْضُ بَيْنَ مُوَشَّحٍ وَمُؤَزَّرٍ","وَالزَّهْرُ بَيْنَ مُدَنَّرٍ وَمُدَرْهَمِ",18,"م",1,0],["فَالرَوضُ مُهتَزُّ المَعاطِفِ نَغمَةً","نَشوانُ يَعطِفُهُ الصَبا فَيَميلُ",19,"ل",1,0],["فَالرَأيُ عَن إِسعادِهِ مُتَسَدِّدٌ","وَالثَغرُ عَن تَحصينِهِ مَسدودُ",20,"د",1,0],["فَالرَحيلَ الرَحيلَ يا عَسكَرَ اللَذ","ذاتِ في كُلِّ رَوضَةٍ وَغَديرِ",21,"ر",1,0],["فَالريحُ ريحُ ذَكِيِّ الأَذفَرِ الداري","وَالبَردُ بَردُ النَدى وَاللَونُ لِلنارِ",22,"ر",1,0],["فَالراحُ طَيِّبَةٌ وَلَيسَ تَمامُها","إِلّا بِطيبِ خَلائِقِ الجُلّاسِ",23,"س",1,0],["فَالرُفقُ يُمنٌ وَالأَناةُ سَعادَةٌ","فَتَأَنَّ في رِفقٍ تَنالُ نَجاحا",24,"ح",2,0],["فَالرَأيُ هِجرانُكَ الدُنِّيا وَساكِنَها","فَأَنتَ مِن جَودِ هَذي النَفسِ مَنجودُ",25,"د",1,0],["فَالرُزءُ يَبعَثُهُ القَريبُ وَما دَرى","مُضَرٌّ بِما تَجني يَدا أَنمارِ",26,"ر",1,0],["فَالرِزقُ يَهتِفُ يا إِنسُ اِعمَلوا وَكُلوا","يا أَيُها الظَبِيُ رِد ياطائِرُ اِلتَقِطِ",27,"ط",1,0],["فَالرَوضُ مَجنونٌ وَما حَمَلَ الثَرى","غِلّاً وَلَكِن لِلوَميضِ سَلاسِلُ",28,"ل",1,0],["فَالرَجُلُ لِلرَجلَةِ وَالكَفُّ لِل","كَفَّةِ وَالعِرنينُ لِلعارِنِ",29,"ن",1,0],["فالرفقُ من نبل النفوسِ وربما","يُلحَى النبيلُ بفعله ويُذمّمُ",30,"م",1,0],["فالروح في التاريخ الاعتبارُ","وحكمة تودَعُها الأخبارُ",31,"ر",1,0],["فَالرِّيحُ تكتبُ وَالْغَدِيرُ صَحِيفَةٌ","وَالسُحْبُ تَنْقُطُ وَالحَمائِمُ تَقْرَأُ",32,"ر",2,0],["فَالرَّيْثُ يُحْمَدُ فِي بَعْضِ الأُمُورِ كَمَا","فِي بَعْضِ حَالاتِهِ يُسْتَحْسَنُ الْعَجَلُ",33,"ل",1,0],["فالروضُ مهما زهتْ قفرٌ اذا حرمت","من جانحٍ رفَّ أو من صادحٍ صدحا",34,"ح",2,0],["فَآلُ رَسولِ اللَهِ نُحفٌ جُسومُهُم","وَآلُ زِيادٍ غُلَّظَ القَصَراتِ",35,"ت",1,0],["فالرِّيحُ تُزْحِيهِ تَارَاتٍ وتَحْدُرُهُ","والرَّعْدُ يُنْجِيهِ طَوْراً أَو يُنَاجِيهِ",36,"ي",2,0],["فالرأيُ أن تلتمس المُحائدا","عن مطْلنا لُقِّيتَ عيشاً راغدا",37,"د",2,0],["فالرب بفضلك واكفني هم الزما","ن ففيك فيه على بنيه أصول",38,"ل",1,0],["فالروم قد ألقت إليك قيادها","إلقاء إسلام أو استسلام",39,"م",1,0],["فالرفقُ والقارظُ غابا معاً","كِلاهُما لم يَكُ بالرّاجِعْ",40,"ع",1,0],["فالرِّجْلُ من أوحالكم رَطبةٌ","واليدُ عن أَموالكم يابسَةْ",41,"س",2,0],["فالريحُ ترضعُ دُرَّ الغيمِ إنْ عطشَتْ","والغَيمُ يركبُ ظهرَ الرِّيح إن لَغِبا",42,"ب",2,0],["فالرمحُ يهتزُّ تِيها حينَ يَرْكُزه","ويزدَهي الطِّرْفُ عُجبا حينَ يَرْكبه",43,"ب",2,0],["فَالرِدفُ دِعصٌ هائِلٌ","وَالقَدُّ غُصنٌ مائِلُ",44,"ل",1,0],["فالروض منه قد تضوع نشره","لما عليه جر فضل ردائه",45,"ا",3,0],["فالروح مرجعها إلي","ك فهل يظللها رضاك",46,"ك",1,0],["فالريح إن هبت تم","ر بها كمر الهاجس",47,"س",1,0],["فالروْضُ مِسْكي النسيمِ مُدَبجٌ","والماءُ فضيُ الأدِيمِ صَقيلُ",48,"ل",1,0],["فَالرِفدُ تَبسُطُهُ يَدٌ مَبسوطَةٌ","وَالجَورُ يَحسِمُهُ حُسامٌ مِحذَمُ",49,"م",1,0],["فَالرَّوْضُ قَدْ فَاحَتْ بِهِ أَزْهَارُهُ","وَالْغُصْنُ قَدْ غَنَّى بِهِ بَلَصُوصُهُ",50,"ص",2,0],["فَالرُّشْدُ مِنْ جَرَّاهُمُ سَامِي الطُّلَى","وَالْغَيُّ أَوْقَصُ جِيدِهِ مَوْقُوصُهُ",50,"ص",2,0],["فالرمل بحر والبحار خميلة","والروض أقلام على أوراق",51,"ق",1,0],["فالروح أمرٌ وهو واحدةٌ كَلَمْ","حٍ لاح من بصرٍ بطرف باسر",52,"ر",1,0],["فالرّيحُ إن زَفَرت في رَوضةٍ نضرت","ومالَ بالقصَبِ الشّاكي تلوُّعه",53,"ع",2,0],["فالرسل تحشر تحت ظل لوائه","يوم المعاد وَيستَجير المجرم",54,"م",1,0],["فَالرَعايا وَاللَهُ وَاللَهِ وَالسُّل","طانُ راضونَ عَنهُ في كُلِّ حينِ",55,"ن",1,0],["فَالراحُ ياقوتَةٌ بِراحَتِهِ","حَمراءُ نيطَت بِقُضبِ بَلُّورِ",56,"ر",1,0],["فالرعد من صدماتنا عند الوغى","والبرق من لمع السيوف نراها",57,"ا",3,0],["فالروح إِن أَمرٌ عَنا","تَقولُ للجسم أَنا",58,"ن",2,0],["فالراحُ في لهَواتِهِ","كالشَمسِ تَغربُ في ثَبيرِ",59,"ر",1,0],["فالرودُ تحنو عَلَى الأَيتام ماسحةً","من أَدمعِ اليتمِ ما قدْ حار أَو قطرا",60,"ر",2,0],["فالربوةُ الغناءُ ما","أحلى بها سجع الطيورِ",61,"ر",1,0],["فالرياضُ باسمةٌ","إنَّ ثوبَها قُشب",62,"ب",1,0],["فالريح ما تكتم سرا وما","يزال رياك يعاني الفضول",63,"ل",1,0],["فالرب عند ظنون العبد فلتدر","جاء الحديث بذا فاصغ إلى الذكرى",64,"ر",2,0],["فَالرساتينُ وَالبساتينُ منها","مُفعماتٌ من سيبِهِ مسنونَه",65,"ن",2,0],["فَالرَبعُ عافٍ وَدَمعُ العَينِ مُنسَكِبٌ","أَبكي الرُسومَ بِها طوراً وَأَعتَرِفُ",66,"ف",1,0],["فَالرَدى خَوَّلَكَ الما","لَ الِّذي كانَ لِغَيرِك",67,"ك",1,0],["فالرِّجْلُ تُبصَرُ مَرْفوعاً أَخامِصُها","والرّأسُ يُوجَدُ مَنْكوساً نَواصيه",68,"ي",2,0],["فالرّيحُ أيضاً إنْ أُتيحَ لها","هَزُّ الغصونِ تَناثَر الوَرَق",69,"ق",1,0],["فالروضُ مُفتَرُّ المباسمِ ما بِه","شَكْوى سوى نَفَسِ الصَّبا المُتَردِّد",70,"د",1,0],["فَالراكِبُ الأَشواقِ لَي","سَ يُصيبُهُ مَسُّ الكَلالِ",71,"ل",1,0],["فالروض يُهجا نَورُه إن لم ينر","وثراه ممطورٌ وهوْ ممطول",72,"ل",1,0],["فالرسل والأنبيا الأخيار والشهدا","من غير إذنٍ على مثواك لن تلجا",73,"ج",2,0],["فالروح روح القدس جاء بفيضها","ورسوله يُملي عليه ويكتب",74,"ب",1,0],["فَالرَأي عِندي أَن يَمُرّ","بِها الغُموض وَلَو تَلوم",75,"م",1,0],["فالراضي شف قلبه ياضي","والساخط ملان بالأحزان",76,"ن",1,0],["فَالرَوضُ بَينَ مُسَهَّمِ وَمُدَّبَّجٍ","وَمُفَوَّفٍ وَمُجَزَّعٍ وَمُهَلَّل",77,"ل",1,0],["فالرب ذات العبد عندهم","فهو الوجود الدق والجل",78,"ل",1,0],["فالرأي للرجل الذي يرجو بأن","يلقى الإِله كمثل بشر الحافي",79,"ف",2,0],["فالريح قد وافت إلى يعقوب من","قبَلِ البشير بوصل حب هاجر",80,"ر",1,0],["فالرَّأيُ يَصْدَأُ كالحُسامِ لعارضِ","يطرا عَليهِ وَصْقلُهُ التَّذكيرُ",81,"ر",1,0],["فالرِّسْلُ ليسَ يدِرُّ في العُلَبِ","مِن غَيرِ إبساسٍ ولا حَلَبِ",82,"ب",1,0],["فالرُّبى عِندَه جيوشٌ وموجُ ال","بحرِ في كلِّ لُجّةٍ أسطولُ",83,"ل",1,0],["فالردف منه مثل وجدي راجحٌ","والخصر منه مثل صبري واه",84,"ا",2,0],["فالرزقُ والأجل المحتوم قد كفلت","كفاك إعطاءها بالمال والقضب",85,"ب",1,0],["فالروض يضحك إذ يبكي السحاب به","حسنا ويفترّ ثغر النبت مبتسما",86,"م",2,0],["فالرَّوْعُ مُنقطعٌ إليهم وَاصِلٌ","ليلَ البَيَاتِ لهم بيومِ عِراكِ",87,"ك",1,0],["فالرابط الجأش لا يبكي سواه ولا","يلهيه مال ولا يزهيه مولود",88,"د",1,0],["فالرزء أعظم من جيب نشققه","ولطم خد وسح الأدمع الغيض",89,"ض",1,0],["فالروض روض السجايا طاب منبتها","والزهر زهر الثنا تهديه مرغوبا",90,"ب",2,0],["فالرمح منه ما استقا","م واللواءُ ما خفَقْ",91,"ق",1,0],["فالرُّمْحُ لا يُرْهبُ اُنْبوبُهُ","اِلاَّ اذا رُكِّبَ فيه السِّنانْ",92,"ن",1,0],["فَالرَوابي سافِراتٌ","عَن خُدودٍ وَعُيونِ",93,"ن",1,0],["فَالرَوضُ قَد أَفشى لَنا","سِرّاً يَحُثُّ عَلى السُرورِ",94,"ر",1,0],["فَالرَوضُ مِن أَنهارِهِ وَبِهارِهِ","في المُصمَتِ الفَضِيِّ وَالديباجِ",95,"ج",1,0],["فَالراحُ بَدرٌ وَالجامُ هالَتُهُ","وَالأُفُقُ كَفي وَالأَنجمُ الحَبَبُ",96,"ب",1,0],["فالرَّكْبُ يطرُقُ خطفاً","كالبرقِ ضمنَ غمَامَهْ",97,"م",2,0],["فالروح منتسب الى اعقابه","والقلب مصطبر على اهواله",98,"ل",2,0],["فالرمحُ يقتل بعضُه من غيره","والسيفُ يقتلُ كُلُّه من نَفسِهِ",99,"ه",1,0],["فالروح تأخذها به سنةٌ","والجسم نوم فيه مرغومُ",100,"م",1,0],["فالروح في الرفعة والنفس في","سفالة تبقى إلى الرمس",101,"س",1,0]]}