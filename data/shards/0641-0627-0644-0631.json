"أليس من بات في الحانات مطروحا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573887",""],[5309,"ليس الثواب ولا العقاب جنانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573818",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6277,"بوركت الأعمال والجهود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64483&r=&rc=46",""]],"verses":[["فالرّأيُ يُدْرِكُ ما يَعْيَى الحُسامُ بهِ","إذا الزّمانُ بِذَيلِ الفِتْنَةِ الْتَثَما",0,"م",2,0],["فالرُّمْحُ يُنَضْنِضُ منْ شَرَهٍ","لهُمُ والصّارِمُ قدْ دَلَقا",1,"ق",2,0],["فَالرَأيُ كُلُّ الرَأيِ أَن تُجمِعوا","فَإِنَّما إِجماعُكُم أَرجَحُ",2,"ح",1,0],["فَالرَّأْيُ إِجْمَاعٌ عَلَى","شُكْرِ المَلِيكِ لِمَا وَهَبْ",3,"ب",1,0],["فالروض ليس يَضيره","ما قد يطنطن من ذبابه",4,"ب",2,0],["فالرأس مشتعلٌ بشيبٍ أبيضٍ","والقلب مشتعلٌ بشيبٍ أسفع",5,"ع",1,0],["فالريح ريح المسك من خده","كما ترى والَّلون لون الدَّم",6,"م",1,0],["فالرعايا محميَّة في حماها","والمراعي مطلولةٌ مَوْبولهْ",7,"ل",2,0],["فَالرَوابي حِلَلٌ مِن سُندُسٍ","وَالسَواقي ثَرثَراتٌ وَغِناء",8,"ا",2,0],["فَالروحُ قيثارٌ وَهَت وَتَقَطَّعَت","أَوتارُهُ وَالقَلبُ قَفرٌ مُمحِلُ",9,"ل",1,0],["فالرزق لا الحذق هوال","أصل فباللله ثقِ",10,"ق",1,0],["فالرأيُ مثلَ القول مبتدَهٌ","والقولُ مثلَ الطعنِ مرتَجَلُ",11,"ل",1,0],["فَالريحُ تُزجيهِ تاراتٍ وَتَحدُرُهُ","وَالرَعدُ يُنجيهِ طَوراً أَو يُناجيهِ",12,"ي",2,0],["فالرَّوْضُ بينَ مُزَنَّرٍ ومُدَنَّرٍ","فيها وبينَ مُسيَّرٍ ومُحبَّرِ",13,"ر",1,0],["فَالرَدُّ يَجمُلُ في الأَما","نَةِ وَالتَحيَّةِ وَالجَوابِ",14,"ب",1,0],["فالرّمحُ قدٌّ والخداعُ تَدَلّلٌ","والسيفُ لحظ والنجادُ وشاحُ",15,"ح",1,0],["فالربعُ رحبٌ والندى ساكبٌ","والعيشُ رغدٌ والأماني قماح",16,"ح",1,0],["فَالرَبعُ قَد عَزَّني عَلى جَلَدي","ما مَحَّ مِن سَهلِهِ وَمِن جَلَدِه",17,"د",2,0],["فَالرَّوْضُ بَيْنَ مُوَشَّحٍ وَمُؤَزَّرٍ","وَالزَّهْرُ بَيْنَ مُدَنَّرٍ وَمُدَرْهَمِ",18,"م",1,0],["فَالرَوضُ مُهتَزُّ المَعاطِفِ نَغمَةً","نَشوانُ يَعطِفُهُ الصَبا فَيَميلُ",19,"ل",1,0],["فَالرَأيُ عَن إِسعادِهِ مُتَسَدِّدٌ","وَالثَغرُ عَن تَحصينِهِ مَسدودُ",20,"د",1,0],["فَالرَحيلَ الرَحيلَ يا عَسكَرَ اللَذ","ذاتِ في كُلِّ رَوضَةٍ وَغَديرِ",21,"ر",1,0],["فَالريحُ ريحُ ذَكِيِّ الأَذفَرِ الداري","وَالبَردُ بَردُ النَدى وَاللَونُ لِلنارِ",22,"ر",1,0],["فَالراحُ طَيِّبَةٌ وَلَيسَ تَمامُها","إِلّا بِطيبِ خَلائِقِ الجُلّاسِ",23,"س",1,0],["فَالرُفقُ يُمنٌ وَالأَناةُ سَعادَةٌ","فَتَأَنَّ في رِفقٍ تَنالُ نَجاحا",24,"ح",2,0],["فَالرَأيُ هِجرانُكَ الدُنِّيا وَساكِنَها","فَأَنتَ مِن جَودِ هَذي النَفسِ مَنجودُ",25,"د",1,0],["فَالرُزءُ يَبعَثُهُ القَريبُ وَما دَرى","مُضَرٌّ بِما تَجني يَدا أَنمارِ",26,"ر",1,0],["فَالرِزقُ يَهتِفُ يا إِنسُ اِعمَلوا وَكُلوا","يا أَيُها الظَبِيُ رِد ياطائِرُ اِلتَقِطِ",27,"ط",1,0],["فَالرَوضُ مَجنونٌ وَما حَمَلَ الثَرى","غِلّاً وَلَكِن لِلوَميضِ سَلاسِلُ",28,"ل",1,0],["فَالرَجُلُ لِلرَجلَةِ وَالكَفُّ لِل","كَفَّةِ وَالعِرنينُ لِلعارِنِ",29,"ن",1,0],["فالرفقُ من نبل النفوسِ وربما","يُلحَى النبيلُ بفعله ويُذمّمُ",30,"م",1,0],["فالروح في التاريخ الاعتبارُ","وحكمة تودَعُها الأخبارُ",31,"ر",1,0],["فَالرِّيحُ تكتبُ وَالْغَدِيرُ صَحِيفَةٌ","وَالسُحْبُ تَنْقُطُ وَالحَمائِمُ تَقْرَأُ",32,"ر",2,0],["فَالرَّيْثُ يُحْمَدُ فِي بَعْضِ الأُمُورِ كَمَا","فِي بَعْضِ حَالاتِهِ يُسْتَحْسَنُ الْعَجَلُ",33,"ل",1,0],["فالروضُ مهما زهتْ قفرٌ اذا حرمت","من جانحٍ رفَّ أو من صادحٍ صدحا",34,"ح",2,0],["فَآلُ رَسولِ اللَهِ نُحفٌ جُسومُهُم","وَآلُ زِيادٍ غُلَّظَ القَصَراتِ",35,"ت",1,0],["فالرِّيحُ تُزْحِيهِ تَارَاتٍ وتَحْدُرُهُ","والرَّعْدُ يُنْجِيهِ طَوْراً أَو يُنَاجِيهِ",36,"ي",2,0],["فالرأيُ أن تلتمس المُحائدا","عن مطْلنا لُقِّيتَ عيشاً راغدا",37,"د",2,0],["فالرب بفضلك واكفني هم الزما","ن ففيك فيه على بنيه أصول",38,"ل",1,0],["فالروم قد ألقت إليك قيادها","إلقاء إسلام أو استسلام",39,"م",1,0],["فالرفقُ والقارظُ غابا معاً","كِلاهُما لم يَكُ بالرّاجِعْ",40,"ع",1,0],["فالرِّجْلُ من أوحالكم رَطبةٌ","واليدُ عن أَموالكم يابسَةْ",41,"س",2,0],["فالريحُ ترضعُ دُرَّ الغيمِ إنْ عطشَتْ","والغَيمُ يركبُ ظهرَ الرِّيح إن لَغِبا",42,"ب",2,0],["فالرمحُ يهتزُّ تِيها حينَ يَرْكُزه","ويزدَهي الطِّرْفُ عُجبا حينَ يَرْكبه",43,"ب",2,0],["فَالرِدفُ دِعصٌ هائِلٌ","وَالقَدُّ غُصنٌ مائِلُ",44,"ل",1,0],["فالروض منه قد تضوع نشره","لما عليه جر فضل ردائه",45,"ا",3,0],["فالروح مرجعها إلي","ك فهل يظللها رضاك",46,"ك",1,0],["فالريح إن هبت تم","ر بها كمر الهاجس",47,"س",1,0],["فالروْضُ مِسْكي النسيمِ مُدَبجٌ","والماءُ فضيُ الأدِيمِ صَقيلُ",48,"ل",1,0],["فَالرِفدُ تَبسُطُهُ يَدٌ مَبسوطَةٌ","وَالجَورُ يَحسِمُهُ حُسامٌ مِحذَمُ",49,"م",1,0],["فَالرَّوْضُ قَدْ فَاحَتْ بِهِ أَزْهَارُهُ","وَالْغُصْنُ قَدْ غَنَّى بِهِ بَلَصُوصُهُ",50,"ص",2,0],["فَالرُّشْدُ مِنْ جَرَّاهُمُ سَامِي الطُّلَى","وَالْغَيُّ أَوْقَصُ جِيدِهِ مَوْقُوصُهُ",50,"ص",2,0],["فالرمل بحر والبحار خميلة","والروض أقلام على أوراق",51,"ق",1,0],["فالروح أمرٌ وهو واحدةٌ كَلَمْ","حٍ لاح من بصرٍ بطرف باسر",52,"ر",1,0],["فالرّيحُ إن زَفَرت في رَوضةٍ نضرت","ومالَ بالقصَبِ الشّاكي تلوُّعه",53,"ع",2,0],["فالرسل تحشر تحت ظل لوائه","يوم المعاد وَيستَجير المجرم",54,"م",1,0],["فَالرَعايا وَاللَهُ وَاللَهِ وَالسُّل","طانُ راضونَ عَنهُ في كُلِّ حينِ",55,"ن",1,0],["فَالراحُ ياقوتَةٌ بِراحَتِهِ","حَمراءُ نيطَت بِقُضبِ بَلُّورِ",56,"ر",1,0],["فالرعد من صدماتنا عند الوغى","والبرق من لمع السيوف نراها",57,"ا",3,0],["فالروح إِن أَمرٌ عَنا","تَقولُ للجسم أَنا",58,"ن",2,0],["فالراحُ في لهَواتِهِ","كالشَمسِ تَغربُ في ثَبيرِ",59,"ر",1,0],["فالرودُ تحنو عَلَى الأَيتام ماسحةً","من أَدمعِ اليتمِ ما قدْ حار أَو قطرا",60,"ر",2,0],["فالربوةُ الغناءُ ما","أحلى بها سجع الطيورِ",61,"ر",1,0],["فالرياضُ باسمةٌ","إنَّ ثوبَها قُشب",62,"ب",1,0],["فالريح ما تكتم سرا وما","يزال رياك يعاني الفضول",63,"ل",1,0],["فالرب عند ظنون العبد فلتدر","جاء الحديث بذا فاصغ إلى الذكرى",64,"ر",2,0],["فَالرساتينُ وَالبساتينُ منها","مُفعماتٌ من سيبِهِ مسنونَه",65,"ن",2,0],["فَالرَبعُ عافٍ وَدَمعُ العَينِ مُنسَكِبٌ","أَبكي الرُسومَ بِها طوراً وَأَعتَرِفُ",66,"ف",1,0],["فَالرَدى خَوَّلَكَ الما","لَ الِّذي كانَ لِغَيرِك",67,"ك",1,0],["فالرِّجْلُ تُبصَرُ مَرْفوعاً أَخامِصُها","والرّأسُ يُوجَدُ مَنْكوساً نَواصيه",68,"ي",2,0],["فالرّيحُ أيضاً إنْ أُتيحَ لها","هَزُّ الغصونِ تَناثَر الوَرَق",69,"ق",1,0],["فالروضُ مُفتَرُّ المباسمِ ما بِه","شَكْوى سوى نَفَسِ الصَّبا المُتَردِّد",70,"د",1,0],["فَالراكِبُ الأَشواقِ لَي","سَ يُصيبُهُ مَسُّ الكَلالِ",71,"ل",1,0],["فالروض يُهجا نَورُه إن لم ينر","وثراه ممطورٌ وهوْ ممطول",72,"ل",1,0],["فالرسل والأنبيا الأخيار والشهدا","من غير إذنٍ على مثواك لن تلجا",73,"ج",2,0],["فالروح روح القدس جاء بفيضها","ورسوله يُملي عليه ويكتب",74,"ب",1,0],["فَالرَأي عِندي أَن يَمُرّ","بِها الغُموض وَلَو تَلوم",75,"م",1,0],["فالراضي شف قلبه ياضي","والساخط ملان بالأحزان",76,"ن",1,0],["فَالرَوضُ بَينَ مُسَهَّمِ وَمُدَّبَّجٍ","وَمُفَوَّفٍ وَمُجَزَّعٍ وَمُهَلَّل",77,"ل",1,0],["فالرب ذات العبد عندهم","فهو الوجود الدق والجل",78,"ل",1,0],["فالرأي للرجل الذي يرجو بأن","يلقى الإِله كمثل بشر الحافي",79,"ف",2,0],["فالريح قد وافت إلى يعقوب من","قبَلِ البشير بوصل حب هاجر",80,"ر",1,0],["فالرَّأيُ يَصْدَأُ كالحُسامِ لعارضِ","يطرا عَليهِ وَصْقلُهُ التَّذكيرُ",81,"ر",1,0],["فالرِّسْلُ ليسَ يدِرُّ في العُلَبِ","مِن غَيرِ إبساسٍ ولا حَلَبِ",82,"ب",1,0],["فالرُّبى عِندَه جيوشٌ وموجُ ال","بحرِ في كلِّ لُجّةٍ أسطولُ",83,"ل",1,0],["فالردف منه مثل وجدي راجحٌ","والخصر منه مثل صبري واه",84,"ا",2,0],["فالرزقُ والأجل المحتوم قد كفلت","كفاك إعطاءها بالمال والقضب",85,"ب",1,0],["فالروض يضحك إذ يبكي السحاب به","حسنا ويفترّ ثغر النبت مبتسما",86,"م",2,0],["فالرَّوْعُ مُنقطعٌ إليهم وَاصِلٌ","ليلَ البَيَاتِ لهم بيومِ عِراكِ",87,"ك",1,0],["فالرابط الجأش لا يبكي سواه ولا","يلهيه مال ولا يزهيه مولود",88,"د",1,0],["فالرزء أعظم من جيب نشققه","ولطم خد وسح الأدمع الغيض",89,"ض",1,0],["فالروض روض السجايا طاب منبتها","والزهر زهر الثنا تهديه مرغوبا",90,"ب",2,0],["فالرمح منه ما استقا","م واللواءُ ما خفَقْ",91,"ق",1,0],["فالرُّمْحُ لا يُرْهبُ اُنْبوبُهُ","اِلاَّ اذا رُكِّبَ فيه السِّنانْ",92,"ن",1,0],["فَالرَوابي سافِراتٌ","عَن خُدودٍ وَعُيونِ",93,"ن",1,0],["فَالرَوضُ قَد أَفشى لَنا","سِرّاً يَحُثُّ عَلى السُرورِ",94