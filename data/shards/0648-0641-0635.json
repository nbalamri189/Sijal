{"poems":[[55,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[90,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[74,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[164,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[210,"دهش الفؤاد فكان أن يتفطّرا","https://www.aldiwan.net/poem918.html",""],[234,"إمام الهدى سعد وفأل مبارك","https://www.aldiwan.net/poem50894.html","الطويل"],[242,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[369,"زف المنام إلي طيف خياله","https://www.aldiwan.net/poem60669.html","الكامل"],[409,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[438,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[438,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[457,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[487,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[505,"رف الغرام بقلبي","https://www.aldiwan.net/poem37960.html","المجتث"],[543,"سلام على الأدب المنتقى","https://www.aldiwan.net/poem47538.html","عموديه"],[563,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103064","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86858","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87040","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48829","الطويل"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38107","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120024","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118161","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49975","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108773","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199847","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137423",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100485","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52993","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101346","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90867","الكامل"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120184","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4702,"مديت كفي وكفيت مدي","https://www.poetsgate.com/ViewPoem.aspx?id=155466",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5129,"حكايتنا","https://www.poetsgate.com/ViewPoem.aspx?id=122674",""],[5277,"طائفُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=208587",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5880,"عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=210779",""],[6093,"بلاغة جمال","https://www.poetsgate.com/ViewPoem.aspx?id=206682",""]],"verses":[["وَفَصاحَةٌ لَولا الحَياءُ لَهَجَّنَت","أَعلامَ ما قالَ الوَليدُ وَمُسلِمُ",0,"م",1,0],["وفصيحاً إن أنشد القوم شعراً","كان في الشعر مفلقاً ومجيدا",1,"د",2,0],["وفصل قول يلذّ الخصم موقعهُ","حتَّى يودّ قضاءً غير منفصل",2,"ل",1,0],["وفصاحةٍ لو أنَّه ناجَى بها","سَحبانَ أو قُسَّ الفَصاحةِ أفحَما",3,"م",2,0],["وفُصِّلَتْ أعضاؤها من بَعْدِ","مع لُبِّ أُتْرُجٍّ كلونِ الشَّهْدِ",4,"د",1,0],["وفصل حلم إِذا ضاقت بما رحبت","الأرض بالخطب ذراعاً زاد واتسعا",5,"ع",2,0],["وفصاحة وبراعة وبلاغة","خصّت به والغير عنها تأخّرا",6,"ر",2,0],["وفَصْدٌ لماءِ الجود في الناس فاصدٌ","وبُرْءٌ لك الأعداءُ فيه تُتاركُ",7,"ك",1,0],["وَفَصَّلَ مِنْ أَحْكَامِهِ كُلَّ مُجْمَلٍ","فَأَصْبَحَ يَشْدُو بِالذِي قَالَ قَائِلُ",8,"ل",1,0],["وَفصّلت سورةُ الأحزابِ من عظم ال","مختار ما أجملته النون والقلمُ",9,"م",1,0],["وَفصاحةٌ علميّةٌ وفراسةٌ","حكميّةٌ ونفوذُ رأي يقطعُ",10,"ع",1,0],["وفُصولُ قَوْلٍ هُنّ أعذَبُ مَسمَعاً","من راحةِ المَشْغولِ عن أشغاله",11,"ل",2,0],["وفصلتني عن جملتي غلطاً","أجهلت باب الفصل والوصل",12,"ل",1,0],["وفصاحةٌ دعْ عنك ذكرَك من مضى","إنّ المبرِّدَ عندَها لمُبرَّدُ",13,"د",1,0],["وفصلُ خطابٍ لوَتْ جيدَها","الى درِّه لُبّةُ المنبر",14,"ر",1,0],["وفصاحة مقرونة بحصافة","وحماسة موصولة بسماح",15,"ح",1,0],["وفصوص النصوص تقضي بأن لا","أثرا لاقتدارنا في الكيان",16,"ن",1,0],["وفَصْلُ عَيْنَيَّ شاتٍ","وفَصلُ قلبيَ صائِفْ",17,"ف",1,0],["وفصلُ الرَّبيعِ علَى خلقِهِ","زُهُور الريَاضِ شذاً فَتَقَا",18,"ق",2,0],["وفصل الأمر الإلهيْ عندكم","ذوقاً بلا رمز ولا إيماء",19,"ا",2,0],["وفصيح قولك أو بليغ مقالة","لجميعنا مثل اللآلىء تنثر",20,"ر",1,0],["وفصل في التنزيل آيات خلقه","وأثبت خوف المحق في أُمه معنى",21,"ن",2,0],["وَفَصل خطاب في القَضايا دَليله","بِشارح قَول لَم يُقَس بِنَظير",22,"ر",1,0],["وَفَصلُ خِطابٍ صادر عَن رِياسة","بِها وَردت آيات صدق وَأَمثال",23,"ل",1,0],["وَفَصلِ حُكمٍ وَصِدقٍ في الوعودِ فَهَل","عَلِمتم أَنَّ إِسمعيل داودُ",24,"د",1,0],["وفصِّل لهم في عيدهم بك أمرهم","ودعه حديثاً في محافلهم عذبا",25,"ب",2,0],["وَفصل الوقعة بالوجه الحسن","ابن أَخي المَرحوم داعيكم حسن",26,"ن",1,0],["وَفَصَّلتها بِقَدرِ الرّوضِ وَاِحتَجَبَت","عَنّا وَلَم تَنحُ غيرَ الرّوضِ بِالرهَقِ",27,"ق",1,0],["وفصيح أقوال فتس عنده","حصر اللسان مجمجم تمامُ",28,"م",1,0],["وفصلهم بالأجنبي قد اغتفر","رفعا ونصبا ولجر قد ذكر",29,"ر",1,0],["وفصله البارد قد جاءني","منه بكانون بلا فحم",30,"م",1,0],["وفَصيحةُ النّغمات ينطق صوتها","كجنىَ الدَّبور بلذَّة مشتارُهُ",31,"ر",2,0],["وفصيحاً بنطقه يخرس الده","رَ فما قدرُ سائر الفصحاء",32,"ا",2,0],["وفصيحٌ سما الصفيَّ وغازٍ","ساد ممدوحَه الكميَّ ابنَ أرتق",33,"ق",1,0],["وفصيحة عربية مأنوسة","لم تألف الوحشي والتعقيدا",34,"د",2,0],["وفصد العرق نكب عنه إلا","لذي مرض رطيب الطبع حامي",35,"م",2,0],["وفصلُها الثاني ستّينَ أتى","ثالثُ فَصلٍ أربعينَ يا فتى",36,"ت",2,0],["وفصلها الآخِر هو الحادي عَشَر","مائه وعَشرَه ثمَّ خَمسَه في القَدَر",36,"ر",1,0],["وفصاحة بين الورى لوشامها","قوم الفرزدق ما دعوه بشاعر",37,"ر",1,0],["وَفَصَّلَ في الثَناءِ عَليهِ حَقّاً","تَبارَكَ وَالضُحى وَالإِنشِقاقا",38,"ق",2,0],["وفصاحة قسٍّ لديها باقل","سحبان وائل عندها فأفاه",39,"ا",2,0],["وفصاحةٌ عربيةٌ هو ربها","وبراعةٌ منتهى نبراسها",40,"س",3,0],["وفصائم الجَدْعَاءِ يومَ حُمولِهَا","كالدَّوم أَو سُحقِ الفَسيلِ المُوقِرِ",41,"ر",1,0],["وَفَصلُ مَشغُول بِحَرفِ جَرِّ","أو بِإضَافةٍ كَوَصلٍ يَجرِى",42,"ر",2,0],["وَفصلُهُ بِظَرفٍ أو بِحَرفِ جَرّ","مُستَعملٌ وَالخلفُ فِى ذَاكَ استَقَر",42,"ر",1,0],["وَفَصلُ ذا قَد اِنتَهى مِن أَمسِ","فَلَم يَرُد بَعدَ غَد في حَدسي",43,"ي",1,0],["وفصلت فيه عقد مدحي مجملا","فأغربت في تفصيل عقدي واجمالي",44,"ل",2,0],["وفصيح المقال ان عظم الامر","فصاخت فصاحة الفصحاء",45,"ا",2,0],["وفصاحة عند النبيه مذاقها","شهد وعند ذوي الغباوة علقم",46,"م",1,0],["وفصاحة فى منطق تنسيك ما","يروون عن قس وعن سحبان",47,"ن",1,0],["وفصل خطاب لست أحصر فضله","لك المجد أعيى حصره المدح كله",48,"ه",1,0],["وْفصل الربيع اللي لي الوقت زفه","خصٍ ليا لاحت بروق الغطاليس",49,"س",1,0],["وفصادٌ بزقٌ في ضحوة النو","ر فيُحي الربيع في خطراته",50,"ت",2,0],["وفُصولُها انْسابتْ بغَيرِ تَكلُّفٍ","وحروفُها في النَّفسِ وحْيُ سُرُورْ",51,"ر",1,0],["وفصلُ القولِ أنّي ذبتُ وجداً","بفحواهُ الصريحُ مع الصحيحِ",52,"ح",1,0],["وفصاحة فيما يقول كبيرهم","تبقيهم في زائف التيجان",53,"ن",1,0],["وفصمت عقدة من تدخل عامدا","في أمرنا ببيانك المشهود",54,"د",1,0],["وفصل للأرسال ما كان مجملا","من الفتح واقتادوا كشوف معيتي",55,"ت",2,0],["وفصولٌ فيه أربعةٌ","ومساءٌ من بعد نهارِ",56,"ر",1,0],["وفصاحة القسمات تأسر ناظري","ليرى الحقيقة والمجاز رفاقا",57,"ق",2,0]]}