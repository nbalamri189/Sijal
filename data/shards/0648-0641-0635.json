{"poems":[[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[88,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[61,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[160,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[206,"دهش الفؤاد فكان أن يتفطّرا","https://www.aldiwan.net/poem918.html",""],[229,"إمام الهدى سعد وفأل مبارك","https://www.aldiwan.net/poem50894.html","الطويل"],[237,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[305,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[364,"زف المنام إلي طيف خياله","https://www.aldiwan.net/poem60669.html","الكامل"],[403,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[432,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[432,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[452,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[482,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[500,"رف الغرام بقلبي","https://www.aldiwan.net/poem37960.html","المجتث"],[538,"سلام على الأدب المنتقى","https://www.aldiwan.net/poem47538.html","عموديه"],[558,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"]],"verses":[["وَفَصاحَةٌ لَولا الحَياءُ لَهَجَّنَت","أَعلامَ ما قالَ الوَليدُ وَمُسلِمُ",0,"م",1,0],["وفصيحاً إن أنشد القوم شعراً","كان في الشعر مفلقاً ومجيدا",1,"د",2,0],["وفصل قول يلذّ الخصم موقعهُ","حتَّى يودّ قضاءً غير منفصل",2,"ل",1,0],["وفصاحةٍ لو أنَّه ناجَى بها","سَحبانَ أو قُسَّ الفَصاحةِ أفحَما",3,"م",2,0],["وفُصِّلَتْ أعضاؤها من بَعْدِ","مع لُبِّ أُتْرُجٍّ كلونِ الشَّهْدِ",4,"د",1,0],["وفصل حلم إِذا ضاقت بما رحبت","الأرض بالخطب ذراعاً زاد واتسعا",5,"ع",2,0],["وفصاحة وبراعة وبلاغة","خصّت به والغير عنها تأخّرا",6,"ر",2,0],["وفَصْدٌ لماءِ الجود في الناس فاصدٌ","وبُرْءٌ لك الأعداءُ فيه تُتاركُ",7,"ك",1,0],["وَفَصَّلَ مِنْ أَحْكَامِهِ كُلَّ مُجْمَلٍ","فَأَصْبَحَ يَشْدُو بِالذِي قَالَ قَائِلُ",8,"ل",1,0],["وَفصّلت سورةُ الأحزابِ من عظم ال","مختار ما أجملته النون والقلمُ",9,"م",1,0],["وَفصاحةٌ علميّةٌ وفراسةٌ","حكميّةٌ ونفوذُ رأي يقطعُ",10,"ع",1,0],["وفُصولُ قَوْلٍ هُنّ أعذَبُ مَسمَعاً","من راحةِ المَشْغولِ عن أشغاله",11,"ل",2,0],["وفصلتني عن جملتي غلطاً","أجهلت باب الفصل والوصل",12,"ل",1,0],["وفصاحةٌ دعْ عنك ذكرَك من مضى","إنّ المبرِّدَ عندَها لمُبرَّدُ",13,"د",1,0],["وفصلُ خطابٍ لوَتْ جيدَها","الى درِّه لُبّةُ المنبر",14,"ر",1,0],["وفصاحة مقرونة بحصافة","وحماسة موصولة بسماح",15,"ح",1,0],["وفصوص النصوص تقضي بأن لا","أثرا لاقتدارنا في الكيان",16,"ن",1,0],["وفَصْلُ عَيْنَيَّ شاتٍ","وفَصلُ قلبيَ صائِفْ",17,"ف",1,0],["وفصلُ الرَّبيعِ علَى خلقِهِ","زُهُور الريَاضِ شذاً فَتَقَا",18,"ق",2,0],["وفصل الأمر الإلهيْ عندكم","ذوقاً بلا رمز ولا إيماء",19,"ا",2,0]]}