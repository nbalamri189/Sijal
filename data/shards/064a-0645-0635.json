{"poems":[[23,"إذا عضل سيقت إلينا كأنهم","https://www.aldiwan.net/poem21265.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[2652,"","https://poetry.dctabudhabi.ae/diwan/poem/198382","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[6290,"فِرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85171&r=&rc=0",""]],"verses":[["يَمُصّونَ أَرصافَ السِهامِ كَأَنَّهُم","إِذا هَبَطوا سَهلاً وِبارٌ شَوازِبُ",0,"ب",1,0],["يمص دخاناً فيه نار وحرقة","ورائحة شبهتها ريح خافرا",1,"ر",2,0],["يَمُص رِيقَةَ ثغر النّونِ من ظمإٍ","كَأنَّمَا هُوَ مَوْسُومٌ بحلواءِ",2,"ا",2,0],["يمص بثديها فرخ لئيم","سلالة أعبد ورضيع آم",3,"م",1,0],["يمص أنقى دمها المنتقى","بضحكة درداء في ثغره",4,"ر",2,0],["يمص رحيقنا عيشٌ زؤومٌ","ويتركنا بلا عبقٍ مذاعِ",5,"ع",1,0],["يَمُصُّ دَمِي طَوَالَ الْيَوْمِ مَصًّا","ويَصْرِفُ لِي مُكَافَأةً هَزِيلَهْ",6,"ل",2,0]]}