{"poems":[[56,"لم آت مطلبا إلا بمطلب","https://www.aldiwan.net/poem27360.html","البسيط"],[30,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[82,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[107,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[82,"أرأيتَ لنَا ولهم ظُعُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=3765",""],[121,"عسل","https://www.aldiwan.net/poem24056.html","الكامل"],[130,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[164,"والله ما صدق الواشي الذي نقلا","https://www.aldiwan.net/poem58999.html","البسيط"],[228,"من أنت يا بنت الألى وجدوك","https://www.aldiwan.net/poem41640.html","الكامل"],[266,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[267,"إني استجرتك أن أقدم في الوغى","https://www.aldiwan.net/poem68228.html","الكامل"],[275,"هلا ثناك إلي قلب راض","https://www.aldiwan.net/poem35207.html","الكامل"],[406,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[412,"سلا أحبته من لم يذق كمدا","https://www.aldiwan.net/poem50103.html","البسيط"],[435,"يا رب عفوا فإني","https://www.aldiwan.net/poem39827.html","المجتث"],[443,"أزال لقياك ما ألقى من الحزن","https://www.aldiwan.net/poem2603.html","البسيط"],[469,"ما عند مهضوم الوشاح ضعيفه","https://www.aldiwan.net/poem3583.html","عموديه"],[545,"إني استحيتك أن أفوه بحاجتي","https://www.aldiwan.net/poem56655.html","الطويل"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126700","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34408","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56263","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[1615,"","https://poetry.dctabudhabi.ae/diwan/poem/73666","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49607","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132275","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27609","البسيط"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137350",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137380",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75866","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103617","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205591","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216464",""],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124274","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77106","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77078","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94627","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66160","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120307","البسيط"],[4858,"صوتٌ حبيبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34141",""],[4908,"طائر الغربات","https://www.poetsgate.com/ViewPoem.aspx?id=207531",""],[4955,"لما دعته أبى وقال دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=187723",""],[5010,"أستجرت بنور وجهك خالقي","https://www.poetsgate.com/ViewPoem.aspx?id=189900",""],[5092,"حبلٌ من الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=178350",""],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[5121,"ريّان","https://www.poetsgate.com/ViewPoem.aspx?id=33582",""],[5121,"أُنْشُودَةُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=33583",""],[5147,"خطب كما تعلمونه صعب","https://www.poetsgate.com/ViewPoem.aspx?id=166695",""],[5411,"خلف الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=195063",""],[5674,"انكسار الأشرعة","https://www.poetsgate.com/ViewPoem.aspx?id=197724",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5956,"الحب العاقرُ","https://www.poetsgate.com/ViewPoem.aspx?id=182020",""],[5956,"إنْ تَرجعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183700",""],[5956,"لقبٌ أحبُّه","https://www.poetsgate.com/ViewPoem.aspx?id=185626",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5956,"أ عَلِمتَ كم أفراحنا تنتابُنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193350",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[5956,"الشعر بحرٌ هائجٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201545",""],[6019,"موج قصيدة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53046",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["إِنّي اِستَجَرتُ بِاِستارَينِ مُستَلِماً","رُكنَينِ مُطَّلِباً وَالبَيتَ ذا الحُجُبِ",0,"ب",1,0],["إِنّي أَسُبُّ قَبيلَةً لَم يَمنَعوا","حَوضاً وَلا شَرِبوا بِصافي المَشرَبِ",1,"ب",1,0],["إنّي استوليتُ على أمدي","ووطئتُ بفطنتيَ الفِطَنَا",2,"ن",2,0],["إنّي استفدتُ على يدِ الفُضْلىَ هُدَى","أَغْلىَ العِظاتِ وأبلغَ الأمثالِ",3,"ل",1,0],["إِنِّي أَسِيتُ عَلَى الغُلاَمِ وَأُمِّهِ","لَكِنْ أَسَى مُتَبَرِّمٍ أَوْ غَاضِبِ",4,"ب",1,0],["إني أُسِئُ إلى الأوغاد قاطبةً","إن قلت عن عصبة الصِّهْيوْن: أوغاد",5,"د",1,0],["إني استوليتُ على أمدي","ووطئت بفطني الفطنا",6,"ن",2,0],["إنِّي أَسِيرُكِ صائِمًا أو مُفْطِرًا","حَدَّثْتُ أهلي والأَواخرَ والأُوَلْ",7,"ل",1,0],["إن يأسُ شعرهما قلبي فلا عجب","صدق المواساة من خير المواسينا",8,"ن",2,0],["إني أسير هواكم فاقتضوا كرما","ممن أساراه ممن أكرموا نزلا",9,"ل",2,0],["إِنّي اِستعدتُ لَدُن رَأَيتُكِ صَبوَتي","فَوَجدتها أَشهى وَأَعذَبَ فيكِ",10,"ك",1,0],["إني أسير أسير دهر يشتكي","شد العقال وشدة العقلاء",11,"ا",2,0],["إنّي استَجَرتُكَ أن أُقَدَّمَ في الوَغَى","لِتَطَاعُنٍ وتَنَازُلٍ وَضِرابِ",12,"ب",1,1],["إني أسيرُ على السفينةِ باكياً","وعليَّ دهري بالتغرُّبِ قاض",13,"ض",1,0],["أنَّى أسير وراءها وهي التي","ما زال يقطع دوحتي منشارُها ؟!",14,"ر",3,0],["إِنّي أَسأتُ إِلى سَمعي بفرقتهم","أَنا ظَلمتُ ومن أَهواهُ ما ظَلما",15,"م",2,0],["إني أسير ذنوبٍ","فاطلق بعفوك أسري",16,"ر",2,0],["إني استنترت بظل من جناحكمُ","فناظر الخطب في الحالات لم يرني",17,"ن",2,0],["إنّي استراب وطالما حمد السّرى","بلقاء مأمون اللقاء عفيفه",18,"ف",2,0],["إِنّي استَحَيتُكَ أَن أَفوهَ بحاجَتي","فَإِذا قَرأتَ صَحيفَتي فَتَفَهَّمِ",19,"م",1,1],["إِنّي اِستَنَبتُ سوايَ يُنشدها","وَأَنا الجديرُ بِذلك القسمِ",20,"م",1,0],["إِنّي أُسائِلُكُم يا أَهلَ زاوِيَةٍ","إِلّا الوَلِيَّ الوَجيهَ نَسل مَن نَصَرا",21,"ر",2,0],["إنّي أسِفت على قوم بيوتهم","خَلت وطافَ عليها الحزن والوصبُ",22,"ب",1,0],["إِنّي أُسِرُّ الهَوى من لائمي ليرى","أَنّي سلَوتُ فَلا يُغرى بتعذالي",23,"ل",2,0],["إني أسير إلى حمى ذاك الذي","فاق الورى طرّاً بعظم الفخرةِ",24,"ه",1,0],["إِني أَسير لا أَرى نَصيراً","وَذو العلا لا يقتل الأَسيرا",25,"ر",2,0],["أَنَّى اِستَقَلَّ بِهِ أَنَّى اِستَقَرَّ لَهُ","أَنَّى رَأَى شَخصَهُ العالي فَلَم يَزُلِ",26,"ل",1,0],["إني استجرتُ على ريبِ الزمان فتًى","إلا يكنْ ليثَ غابٍ فهو إنسان",27,"ن",1,0],["إني أسير الحجا لدى الحجازفيا","ليتي أسير إليه سير إرقال",28,"ل",1,0],["إني أسير إليه وهو يطلبني","في كلِّ حالٍ بسرٍّ غيرِ منزعج",29,"ج",1,0],["إني استجرت بأحمد وبصحبه","وجعلتهم دون الأذى أسواري",30,"ر",2,0],["إني استجرت من الهوى بمحمد","ومن استجار به ينال المأمنا",31,"ن",2,0],["اني استجرت من الزمان وجوره","بحمى تقرّبه العيون وتفرح",32,"ح",1,0],["إِني أُسَرُّ بِحالٍ سَوفَ أُسلبها","عَمّا قَريبٍ وَأَبقى رِمّةَ التُربِ",33,"ب",1,0],["اني استجرت بميمون نقيبته","ماضي العزيم كريم العمّ والخال",34,"ل",1,0],["أَنّي استحقَّت كلَّ ذا وعلى مَ","خُصَّت من تُراثِ وَليدِها في سُدسهِ",35,"س",2,0],["أنى استقر وحيث سار هفا به","همس من الجيل الأشم العالي",36,"ل",2,0],["إني استعرت بيانه","فعليَّ إن قصرت عتبى",37,"ب",2,0],["إني استغثت بكم دراك لمجدكم","ما من علاكم صار مربعه خلا",38,"ل",2,0],["آنياسٌ وغلوكوس الجنان","ثم سرفيدون قوام بني",39,"ي",1,0],["آنياسَ بنَ عفرُذِيتَ وأَنخِي","سَ كَذا فَندَرُوساً المِغوَارا",40,"ر",2,0],["أنياس رام أخيل مدرعاً","بأساً على فيبوس معتمدا",41,"د",2,0],["أنياس رب البأس قابله","آخيل رب البيض والأسل",41,"ل",1,0],["أنياس آخيلٌ سيقتله","أسفاً ونحو أذيس يرسله",41,"ه",1,0],["إِنّي اِستَجَرتُ بِكَهف عِزِّكَ فَاِحمِني","مِن شَرِّ نَفسي وَالعَدُوِّ الجافي",42,"ف",2,0],["إِنّي أَسيرُ هَواكُم مُغرَم بِكُم","إِنّي أَسيرٌ وَمالي عَنكَ مُنقَلِبُ",43,"ب",1,0],["إني أسيرٌ إلى ألطافكم برضىً","ولست أكره أسراً فيه رضواني",44,"ن",2,0],["إني أَسِيرُ هَواها لا تَلُمْ كَبِدِي","انْ كُنْتَ لَمْ تَدْرِ مَعْنَى الحُبِّ يا قاسي",45,"س",2,0],["اني استرحت به من سمع ذي خطل","وذاك من محن الدنيا على الفهم",46,"م",1,0],["إنّي استمعتُ لهُ في مثل حالمةٍ","طاف الحبيبُ بها روحاً بلا جسَدِ",47,"د",1,0],["إنِّي أسير الحب منذُ طفولتي","فالحب أشقاني كما أشقاكا",48,"ك",2,0],["إنِّي استعنتُ بهِ ولن يرضى بما","تبغينَ والرحمنُ خيرُ معينِ",49,"ن",1,0],["إنّي استجرتُ بنورِ وجهكَ خالقِي","منْ كلِّ همّ ضَرَّ بي وَبَرَانِي",50,"ي",1,1],["إني أسيرُ إلى الوراءِ غدًا !","قلبي إليكِ اليوم مدفوعُ",51,"ع",1,0],["إني أسائلكم بنصفِ إجابةٍ","عن شرعةٍ فيها الهدى أبديلُ ؟",52,"ل",1,0],["إنِّي أسيرٌ بمغْناكَ الذي شَرِبتْ","منهُ ابتساماتُ قلبي رونقًا عِنَبا",53,"ب",2,0],["إِنِّي أَسِيِرُ الْمَعَانِي فِي مُنَاظَرَةٍ","رَنَّتْ قَصِيِدًا كَسِحْرٍ ذَابَ فِي الْوَتَرِ",54,"ر",1,0],["أني أسرت كما ترون وما","لي غير دين محمد ذنب",55,"ب",1,0],["إنّي اسْتَخَرْتُ وَما انْشَقَّتْ رُؤى قَمَري","فانْعَمْ بِسِحْرٍ عَليَّ ارْتّدَّ وَانْقَلَبا",56,"ب",2,0],["أنَّى أسافرُ والمسالكُ مُفجِعَة","والحُزنُ في قلبي سهامٌ موجِعَه",57,"ع",2,1],["إني أسير بلا هدى .. فتسائلي","ماوجهتي؟ .. حتى نسير سوية!",58,"ي",2,0],["إني أسالمُ كلَّ حبٍّ عاقرٍ","مهما أكنْ معَ لوعتي أتشاجرُ",59,"ر",1,0],["أنى أسير أرى إلفا عليّ قسا","أنى أسير أرى إلفا بيَ احتفلا",60,"ل",2,0],["إني أساعد أمَّتي مستقبلا","باسمٍ يليق بما الفؤاد يَميلُ..",61,"ل",1,0],["إني أُسَرُّ بقربِ الأمّ معتكفاً","كما أُسَرُّ ببيتِ اللهِ أعتكفُ",62,"ف",1,0],["أنَّى أسيرُ أراك أنت أسَرْتني","وحنانك الجاري يديم سقاءنا",63,"ن",2,0],["إني أسترحمك الحُسْنى","أن لا تُوقفَ تحسينكْ",64,"ك",1,0],["إني استحلْتُ إلَى محيطٍ هادئٍ","فَلِأحمرٍ فيه الدماء خضارمُ",65,"م",1,0],["إِنِّي اسْتَعَرتُ مِنَ الصِّفَاتِ جَمَالَهَا","كَي مَا أَصُوغَ مِنَ الجَمَالِ جَوَابَا",66,"ب",2,0],["إِنِّي اسْتَفَقْتُ وفي كَفَّيَّ مَدْرَسَةٌ","مَبْنِيَّةٌ بِعُيُونِ النُّوْرِ تَنْتَظِرُ",67,"ر",1,0],["إِنِّي اسْتَفَقْتُ وما أَلْقَى أَخِيْ وأَخِيْ","خَصْمَيْنِ في رَحِمٍ .. واللَّيْلُ مُعْتَكِرُ",67,"ر",1,0],["إنى أسحب أقدامى","من تحت بساطك أرتحلُ ..",68,"ل",1,1]]}