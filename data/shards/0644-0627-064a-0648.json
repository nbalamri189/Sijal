{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[71,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[88,"وأن أصدق برق أنت شائمه","https://www.aldiwan.net/poem44810.html","البسيط"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"إلف لنا بارع الصفات غراب بين المغنيات","https://www.aldiwan.net/poem8702.html","مخلع البسيط"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[56,"لا يوحشنك ما استحملت من سقم","https://www.aldiwan.net/poem58566.html","الوافر"],[45,"طيف ألم فحيا عند مشهده","https://www.aldiwan.net/poem62737.html","البسيط"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[66,"لا يوخذ الجار في الأعراض بالجار","https://www.aldiwan.net/poem38786.html","البسيط"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[44,"دعني وشرب الهوى يا شارب الكاس","https://www.aldiwan.net/poem30238.html","البسيط"],[44,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[50,"يا أيها الراكب الغادي لطيته","https://www.aldiwan.net/poem64732.html","البسيط"],[46,"لا يوقد النار ذاك الحي في أثري","https://www.aldiwan.net/poem22622.html","البسيط"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[109,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[115,"يا بني الزهراء والنور الذي","https://www.aldiwan.net/poem41961.html","الرمل"],[135,"إزي حال صدقي وحال بور سعيد","https://www.aldiwan.net/poem48845.html","المواليا"],[142,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[143,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[160,"ما لي وقد شبت في داعي الصبا أرب","https://www.aldiwan.net/poem58671.html","البسيط"],[160,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[160,"من قوم المرء بالمكروه تثقيفا","https://www.aldiwan.net/poem59015.html","البسيط"],[164,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[186,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[195,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[225,"يا مصر سيري على آثارهم وقفي","https://www.aldiwan.net/poem55115.html","البسيط"],[235,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[271,"ما ضر وجد الهوى العذرى لوهانا","https://www.aldiwan.net/poem52061.html","البسيط"],[320,"لا يؤيسنك من مخبأة","https://www.aldiwan.net/poem61756.html","أحذ الكامل"],[349,"لا يوحشنك في طري","https://www.aldiwan.net/poem15848.html","مجزوء الكامل"],[353,"صبرا وإلا فماذا ينفع الحزن","https://www.aldiwan.net/poem39757.html","البسيط"],[364,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[409,"لا تعتبن من مل إن عتابه","https://www.aldiwan.net/poem32013.html","الكامل"],[429,"لا يوم طي ولا يوم البسوس ولا","https://www.aldiwan.net/poem40754.html","البسيط"],[432,"قالوا احتجبت ولا عجب","https://www.aldiwan.net/poem12569.html","مجزوء الكامل"],[437,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[453,"أنا الجنين وهذى الأرض من قدم","https://www.aldiwan.net/poem61768.html","البسيط"],[458,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[504,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[551,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[567,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"]],"verses":[["لا يُؤمَنَن بَعدَ كَلالِ الشَبا","كَم صائِلٍ بِالساعِدِ الأَجذَمِ",0,"م",1,0],["لا يُوَقِّعَنَّكَ عَذبُ ريقَتِها","أَنا مَن سُقيتُ السُمَّ في العَسَلِ",1,"ل",1,0],["لا يوسَمُ الرَأيُ الفَطيرُ بِهِ وَلا","يَعتادُ إِرسالَ الكَلامِ قَضيبا",2,"ب",2,0],["لا يُؤسنَّك إن الحرّ محتقَر","عند اللئام وإن الوَغد محتَرَم",3,"م",1,0],["لا يُؤاتي على اقْتسَارٍ وَلا ين","هَضُ إلا بالعزة القعساءِ",4,"ا",2,0],["لا يؤمنُ الناسُ من غُدُوٍّ","ولا رواحٍ ولا بياتِ",5,"ت",1,0],["لا يورد الأمر أو تبدو مصادرهُ","ولا يرى الوردَ ما لم يمكن الصَّدَر",6,"ر",1,0],["لا يُوهنِ الله بطشاً منه تعرفه","مزلزلاً بأعادي الله خَسَّافا",7,"ف",2,0],["لا يؤيسنَّك غَدقٌ من جُرامته","وإن سما واستحد الشوك والتافا",7,"ف",2,0],["لا يَومَ لِلأَقوامِ حَتّى يَنهَضوا","بِقَوادِمٍ مِن أَمسِهِم وَخَوافي",8,"ي",1,0],["لا يوحِشَنّكَ ما اسْتَحْمَلْتُ مِنْ سَقَمٍ","فإنَّ مُنْزِلَهُ بي أَحْسَنُ النّاسِ",9,"س",1,1],["لا يَومَ نَشكُرُ إِلّا يَومَ نائِلِهِ","فينا وَلا غَدَ نَرجوهُ سِوى غَدِهِ",10,"د",2,0],["لا يُوسِعُ الأَسَدَ الضِّرغامَ خَطرَتُه","مَخايِلُ الأُسْدِ قد تَبَّتْ حَبائِلُه",11,"ل",2,0],["لا يوخَذُ الجارُ في الأَعراضِ بِالجارِ","إِن دامَ وَهوَ عَلى رِسلِ الوَفا جاري",12,"ي",1,1],["لا يُؤيِسَنَّكَ بَأسُهُ مِن جودِهِ","دونَ السَحابِ بَوارِقٌ وَرَواعِدُ",13,"د",1,0],["لا يوحِشَنَّكَ ما اِستَسمَجتَ مِن سِقَمي","فَإِنَّ مُنزِلَهُ بي أَحسَنُ الناسِ",14,"س",1,0],["لا يَومَ أَكثَرُ مِنهُ مَنظَراً حَسَناً","وَالمَشرَفِيَّةُ في هاماتِهِم تَخِدُ",15,"د",1,0],["لا يُوحشِ اللهُ رَبعاً تَنزِلينَ بهِ","أظُنُ قبرَكِ رَوضاً نورُه يَقِد",16,"د",1,0],["لا يُولَدُ المَرءُ لاهِرَّاً ولا سَبُعاً","لكن عصارةَ تجريبٍ وتلقين",17,"ن",1,0],["لا يُوازيهِ في العُلا","وَبِهِ القَضِيَّتَين",18,"ن",1,0],["لا يورِدونَ الماءَ سُنْبُكَ سابحٍ","أو يَكتسي بدم الفوارِسِ طُحلُبا",19,"ب",2,0],["لا يُؤيِسَنَّكَ مِن مُخَدَّرَةٍ","قَولٌ تُغَلِّظُهُ وَإِن جَرَحا",20,"ح",2,0],["لا يوجَدانِ وَلا يُرجى لِقاؤُهُما","كَما سَمِعتَ بِهاروتٍ وَماروتِ",21,"ت",1,0],["لا يوقِدِ النارَ ذاكَ الحَيُّ في أَثَري","فَلَستُ أوقِدُ في آثارِهِم نارا",22,"ر",2,1],["لا يُؤثّرْنَ في الوَلِيّ ولا الحا","سِدِ حتى تُشِيرَ بالتّأثيرِ",23,"ر",1,0],["لا يوم إلا وَفيه ال","إنسان يَبكي فَقيدا",24,"د",2,0],["لا يوهِمَنَّكَ أنّ الشِّعرَ لي خُلُقٌ","وأنّني بالقَوافي دائِمُ الأنَسِ",25,"س",1,0],["لاَ يَوْمَ يَسْكُنُ فِيهِ مِنْ وََْثبٍ وَمَنْ","بِسَكِينَةٍ لِلْكَوْكبِ السَّيَّارِ",26,"ر",1,0],["لاَ يَوْمَ كَالْيَوْمِ الَّذِي فُجِعَتْ بِهِ","مِصْرٌ وَقَدْ فُجِئَتْ بِصْرعَةِ غَالِي",27,"ل",2,0],["لاَ يُوقِظَ الأَقْوَامَ إِلاَّ مُنْشِدٌ","غَردٌ يُنَبِّهُ نَائِمَ الأَصْدَاءِ",28,"ا",2,0],["لاَ يُوْقِعُ الأَحْكَامَ إِلاَّ صَادِراً","عَنْ حِكْمَةٍ تَسْتَبْطِنُ الأَسْرَارَا",29,"ر",2,0],["لا يؤمَنون على الأذى","والكلب مأمونٌ أذاه",30,"ا",2,0],["لِأَي وَرد نولي اليَوم وَجهِتنا","وَقَد غَدا بَحرِهِ الطاميُّ مُرجانا",31,"ن",2,0],["لا يوالي الدهر من عاد أكمو","لا ولا يعطي من الحق نفس",32,"س",1,0],["لا يوم يفوت طيب ولا نهار سعيد","ولا أمور تفرِح ولا شيء مفيدْ",33,"د",1,0],["لا يوثِق الأُسراءَ بينهُمُ","إلا رِشاءُ الفاحِم الرَّجْلِ",34,"ل",1,0],["لا يُوازي مِعشار ماكانَ يولي","قَطعِيَ العُمرَ حَسرَةً وَاِكتِئابا",35,"ب",2,0],["لا يؤ يسنك بعد الشيء تطلبه","فالدهر يسعف والحالات تنقلبُ",36,"ب",1,0],["لا يوثرن عجزا على الحزن وطا","ولا على الغربة إن هم وطن",37,"ن",1,0],["لا يوحشنك اعراض تخال به","من أنت تهوى لما يشجيك مشغوفا",38,"ف",2,0],["لا يولَجُ اللَغوُ وَالعَوراءُ مَسمَعَهُ","وَلا يُقارِفُ ما يُغشيهِ تَأنيبا",39,"ب",2,0],["لا يؤيسنّك لفظ من أخي ملق","أرضاك حاضره وازور غائبه",40,"ب",2,0],["لا يَومَ إِلّا سَوفَ يورِثُهُ غَدٌ","وَالعامُ تارِكُهُ لِآخرَ مُقبِلِ",41,"ل",1,0],["لا يُؤيسَنَّكِ ما قالوا وما كتَبوا","بين البَرِيَّةِ تَضليلاً وَتَمويها",42,"ي",3,0],["لا يُؤنِسَنَّكَ مِن رِضا","هُ جَريمَةٌ فَلَهُ عَواطِف",43,"ف",1,0],["لا يورق العود من رعد بلا مطر","اذا يَروي سراب القاع ظمآنا",44,"ن",2,0],["لا يُؤيسَنَّكَ مِن مَخبَأَةٍ","مَنَعَ تَدُلُّ بِهِ وَلَو فَدَحا",45,"ح",2,1],["لا يوحِشَنَّكَ في طَري","قِ الحَقِّ قِلَّةُ أَهلِهِ",46,"ل",2,1],["لا يُؤسينَّكَ ضيق السجن مِن فَرَج","تَلقاهُ فَالعُسر بِاليسرين مُقترنُ",47,"ن",1,0],["لأيِّ ومَيضِ بارقةٍ أَشيمُ","وَمرْعَى الفَضْلِ في زَمني هَشيمُ",48,"م",1,1],["لا يُؤسِفَنَّكَ ما غالَ الزَّمانُ فَما","يَرضى بما غَال من وَفرٍ ومِن مَالِ",49,"ل",1,0],["لا يوم طي ولا يوم البسوس ولا","يوم السباق كيومٍ كان في الشيح",50,"ح",1,1],["لا يوحشنّكَ إن عُجِرْ","تَ فرُبّ محبوسٍ مُحَبْ",51,"ب",1,0],["لا يوم أحسن منه منظراً وبهِ","سمر القنا وسيف الهند تشجر",52,"ر",1,0],["لا يولد المرءُ إلاّ حيثما يَنعت","آثارهُ مثل نُوَّار البساتينِ",53,"ن",1,0],["لأيّوبٍ مخايلُ فيه دلّت","كما دلّت على الغيث البروقُ",54,"ق",1,0],["لا يوفب الفحشاء محترق الحشا","حرز من الفحشاء حرقة ماله",55,"ل",2,0],["لا يُولِجُ الهَزْلَ على جِدِّه","يوماً ولا الحقَّ على الباطِلِ",56,"ل",1,0],["لا يومَ كاليومِ أبرزَتْهُ لَنَا","رياضُهُ في مُشَهَّرِ الحِبَرِ",57,"ر",1,0]]}