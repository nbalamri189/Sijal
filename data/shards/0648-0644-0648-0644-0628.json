{"poems":[[36,"تعلق روحي روحها قبل خلقنا","https://www.aldiwan.net/poem4884.html","الطويل"],[30,"أقول لصاحبي من التعزي","https://www.aldiwan.net/poem5236.html","الوافر"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[447,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138717",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"]],"verses":[["وَلَو لَبِسَت ثَوباً مِنَ الوَردِ خالِصاً","لَخَدَّشَ مِنها جِلدَها وَرَقُ الوَردِ",0,"د",1,0],["وَلَو لَبِسَ النَهارَ بَنو كُلَيبٍ","لَدَنَّسَ لُؤمُهُم وَضَحَ النَهارِ",1,"ر",1,0],["ولو لبثوا في ضيقِ حصرهمُ ولمْ","يَطِرْ مِنهُمُ شَوقاً إلى أَجلٍ عُمْرُ",2,"ر",1,0],["ولول بصفات أهل الفض","ل استشفى لتشفيني",3,"ن",2,0],["ولو لبثت بشتى البيد عاماً","لماجت كالبحار الزاخرات",4,"ت",1,0],["ولولبه في طى صخر كأنني","براقيه أدراجا إلى الجو يطلع",5,"ع",1,0],["ولو لبُّوا نداءَ الحزمِ دَرَّتْ","عليهم لِقْحمةُ النّصر اللّبونِ",6,"ن",1,0]]}