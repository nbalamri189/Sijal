َ العينِ إلا كونها","بعد الجميع معالماً وطلولا",84,"ل",2,0],["ما طَفْلة ليس سوى إهابها","يفرشها المرء ولا يحظى بها",85,"ب",3,1],["ما طوَى الرَّكبُ شُقَّةَ الأَرضِ يوماً","لنواحي البِطاحِ إِلاَّ وذْبْنَا",86,"ن",2,1],["ما طِقْتُ في أمرِها ندًّا ولا عضُدا","فكانَ غيري الّذي بحُسنِها انفرَدا",87,"د",2,0],["مَا طالَ مَا حَرَّرْتُهُ","بَلْ طَابَ يا فَرْدَ الزَّمَنْ",88,"ن",1,1],["ما طالَ نَزعُ الموتِ فيك ثَلاثَةً","إلاَّ لِتَخرُجَ طاهِرَ الجُثمانِ",89,"ن",1,0],["ما طالَ لَيلٌ بِهِ ذِكراكِ أَرَّقَني","هَواكِ أَطوَلُ مِن لَيلي وَإِن طالا",90,"ل",2,0],["ما طافَ أَبخَلُ مِنها","حَتّى بِطَيفِ الخَيالِ",91,"ل",1,0],["ما طوله عن كِبرٍ إِنَّما","طَوَّلَهُ فَرْطُ عِناقِي لَهُ",92,"ه",1,0]]}