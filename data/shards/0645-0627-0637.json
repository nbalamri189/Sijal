=177865",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5739,"يشربه سمعي","https://www.poetsgate.com/ViewPoem.aspx?id=152740",""],[5747,"طاري الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=61613",""],[5747,"الرجم","https://www.poetsgate.com/ViewPoem.aspx?id=61672",""],[5754,"مَا طبعوا سيوفهم من الحدق","https://www.poetsgate.com/ViewPoem.aspx?id=191643",""],[5785,"يا ربّ يا مسبل علينا الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131575",""],[5794,"قلب جدا ..","https://www.poetsgate.com/ViewPoem.aspx?id=80286",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5847,"عاشق العلم","https://www.poetsgate.com/ViewPoem.aspx?id=45480",""],[5848,"الخطا شين","https://www.poetsgate.com/ViewPoem.aspx?id=53176",""],[5848,"الله لا يهينك","https://www.poetsgate.com/ViewPoem.aspx?id=53368",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[5943,"الله أكبر بالمآذن كبِّروا","https://www.poetsgate.com/ViewPoem.aspx?id=11710",""],[5956,"حبي الحلال","https://www.poetsgate.com/ViewPoem.aspx?id=181977",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"الطيبة الفلتة","https://www.poetsgate.com/ViewPoem.aspx?id=192376",""],[5956,"لله درك يا أحنَّ حبيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=193815",""],[5956,"أرثي لمنآنا","https://www.poetsgate.com/ViewPoem.aspx?id=194495",""],[5956,"لا أصدّقُ وصلكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194749",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[5991,"بكماله ما في الوجو مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=116384",""],[5997,"لا تسألي","https://www.poetsgate.com/ViewPoem.aspx?id=214211",""],[6033,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215798",""],[6056,"راسي يافهد شابي","https://www.poetsgate.com/ViewPoem.aspx?id=130323",""],[6093,"ساهرٌ والفجرُ لاحا ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=175989",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[6152,"كعبة شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=203423",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6184,"أعيدي اسمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78615&r=&rc=7",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[6259,"الليل حيثُ حللن فيه نهارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59377&r=&rc=25",""]],"verses":[["ماطَلَها الماءَ فَلَمّا سَلَت","عَنِ الرَوى ماطَلَها بِالعَليق",0,"ق",1,0],["ما طالَ يَومُ مُلَثَّمٍ","إِلّا اِستَراحَ إِلى السُفورِ",1,"ر",1,0],["ما طالَ في اللَيلِ البَهيمِ سُجودُهُ","إِلّا لِيَركَعَ فَوقَهُ السودانُ",2,"ن",1,0],["ما طولُ عَذلِكِ لِلمَحِبُّ بِنافِعِ","ذَهَبَ الفُؤادُ فَلَيسَ فيهِ بِراجِعِ",3,"ع",1,1],["مَا طَوَى اللَّحْدُ عِزَّةً تَتَجَلَّى","مِنْ بَنِيهِ فِي أَرْفَعِ الأَعْلامِ",4,"م",1,0],["ما طالبتُ همّتي دهري بمَعُلُوَةٍ","إلاّ بلغتُ من الأيّام مُقْتَرحا",5,"ح",2,0],["ما طَلَعَت شَمسُ النَهارِ وَلا بَدَت","عَلَيكَ بِمَجدٍ يا اِبنَ مَقطوعَةِ اليَدِ",6,"د",1,1],["ما طابق اللَّهُ نيروزَ الأمير به","إلّا لتلقاهُ فيه كلُّ سَرّاءِ",7,"ا",2,0],["ما طَائرٌ ذو بيضةٍ ضخمةٍ","لكنَّه ليس بِمُستَفْرِخِ",8,"خ",1,0],["ما طَلتَ باللهو والأيامُ تنتجزُ","فنلْ من اللهو حظاً قبلَ تُحتجَزُ",9,"ز",1,1],["ما طَوَت كارِثاً يَدُ الصُبحِ إِلّا","نَشَرَتهُ لَنا يَدُ الإِمساءِ",10,"ا",2,0],["ما طائِرٌ كانَ فيبَيداءَ موحِشَةٍ","فَساقَهُ قَدَرٌ نَحوَ البَساتينِ",11,"ن",1,1],["ماطلهم دَهرهمو بِحَقِّهم","حَتّى إِذا ما قيل لَن يَفي وَفى",12,"ا",1,0],["ما طابَ عنكم فؤادٌ طاب قبلكُمُ","عن الرَّضاعِ تقضَّى والشبابُ مضَى",13,"ض",2,0],["ما طاهِرٌ إِلّا أَبوهُ وَجَدُّهُ","بَرَعوا ثَلاثَتُهُم عَلى ذا الناسِ",14,"س",1,0],["ما طارَ في آثارِها شَرارُها","طاعتُه لفِتيَةٍ تختارُها",15,"ر",3,0],["ما طابَ عَيشُ الحَريصُ قَطُّ وَلا","فارَقَهُ التَعسُ مِنهُ وَالنَصَبُ",16,"ب",1,0],["ما طَيِّبُ القَولِ عِندَ سامِعِهِ ال","مُنصِتِ إِلّا كَطَيِّبِ الثَمَرِ",17,"ر",1,0],["ما طارَ طَيرٌ فَاِرتَفَع","إِلّا كَما طارَ وَقَع",18,"ع",1,1],["ما طالَ في الدُنيا تَنَعُّمَ راحَتي","إِلّا وَقَد قَصُرَت بِها آمالي",19,"ل",2,0],["ما طالَ بَغيٌ قَطُّ إِلّا غادَرَت","غُلَواؤُهُ الأَعمارَ غَيرَ طِوالِ",20,"ل",1,0],["ما طَلَبي لِلإِذنِ أَن شاقَني","شَمسٌ مِنَ الإِنسِ وَلا بَدرُ",21,"ر",1,0],["ما طلبْنا الخمولَ جهلاً ولكنْ","ذاكَ عن خبرةٍ وعنْ تجريبِ",22,"ب",1,1],["ماطالَعَتهُ بَرقَةٌ نَجدِيَّةٌ","إِلّا اِجتَلَتها نِظرَةُ اِستِعبارِ",23,"ر",1,0],["ما طَيَّرَ البَرقُ عَنهُم حادِثاً جَلَلاً","نَخشاهُ إِلّا تَلاهُ حادِثٌ جَلَلُ",24,"ل",1,0],["ما طالَ لَيلي بَعدَهُ بَل ناظِري","يَأتي الصَباحُ فَلا يَراهُ أَبيَضا",25,"ض",2,0],["ما طارَ إِلّا لِدَمٍ مَصبوبِ","يَنفُذُ في الشَمالِ وَالجَنوبِ",26,"ب",1,0],["ما طالَ صَمْتُ مَدائِحِي عَنْ مَجْدِهِ","إِلاَّ لأَنَّ صِلاتِهِ مُسْتَرْسِلَهْ",27,"ل",2,0],["ما طارَ طَرفي إِلى تَحصيلِ صورَتِهِ","إِلّا تَداخَلَني مِن حُسنِها عَلَبُ",28,"ب",1,0],["ماطَلتُهُ دَيناً وَطالَ طِلابُهُ","وَالدَينُ مُنسَرِحٌ وَغَيرُ سَراحِ",29,"ح",1,0],["ما طَهَّرَت بَل دَنَّسَت وَاِرتَمَت","بِالسَيِّدِ الوَهّابِ وَالباخِلِ",30,"ل",1,0],["ما طابَ عيشٌ لم يذُقْ","طعمَ الوِصالِ ولا يَطيبْ",31,"ب",1,0],["ما طالَ عهد اليأس في قلب امرىءٍ","إلا اِستَبان عَلى الجَبين خطوط",32,"ط",1,0],["مَا طَالَ عُمْرِي فِي مَدَاهُ وَإِنَّنِي","لأَخَالُهُ يَعْدُو مَدى الأَعْمَارِ",33,"ر",1,0],["مَا طالَ بِي أَجَلِي سُيوحِشُنِي","أُنْسُ الْمَعَاهِدِ بَعْدَ نَادِيكا",34,"ك",2,0],["ما طمعَت نفسُ عابدٍ فنوى","سؤال قومٍ إلا لهُم خضَعا",35,"ع",2,0],["ما طلبنا نواطحَ السُّحبِ دُورًا","لا، ولا الرَّوضَ وارفات الظِّلال",36,"ل",1,0],["ما طالَ حبلُ حياتِهَ","بل طال في الدنيا شقاؤه",37,"ا",3,0],["ما طاف طائِفُ الانْحِلالِ بأُمَّةٍ","إلا وآذَنَ نَجْمُها بِزَوالِ",38,"ل",1,0],["ما طار طائرها لله محتسبا","له جناحان ايقان وعرفان",39,"ن",1,0],["ما طَيّبُ القَوْلَ عندَ سامِعِهِ ال","مُنْصِتِ، إلاّ لطيْبِ الثّمَرِ",40,"ر",1,0],["ما طار طير وارتفع","إلا كما طار وقع",41,"ع",1,0],["ما طاب من ذكريه قلب متيم","قلق كوته محبة الأوطان",42,"ن",1,0],["ما طال عمري ولكن طال ما حملت","نفسي فسنى وإن لم تعل أسنان",43,"ن",1,0],["ما طوى الروضُ سِرَّهُ جنح ليل","فأذاعته للصباح صباه",44,"ا",2,0],["ما طولوا في الرشا إلا لما حسبوا","لو قدروا فيه قرب المستقى قصروا",45,"ر",3,0],["ما طال غَربٌ جُمانَ الضَّادِ في لُغَةٍ","إنَّ الجُمانَ لها يسعى ويَعْتمِرُ",46,"ر",1,0],["ما طالَعَتْهُ في الدجى لك لمحةٌ","إلا وقال لدمعِ مقلته اسْجم",47,"م",1,0],["ما طالَ عمركَ يا دجى أبداً","غلا ليقصرَ دونهُ عمري",48,"ر",2,0],["ما طاب نشر الثنا يوما لمنتشق","وفاح عطر وهبت في الصباح صبا",49,"ب",2,0],["ما طاب حسن ابتدائي بالمديح وما","لي في ختام حلت تلك الأناشيد",50,"د",1,0],["ما طفرك النعسانُ","وخدك الفتان",51,"ن",1,0],["ما طاوَلَتكُم في الفِخارِ قَبيلَةٌ","إِلّا وَمَجدُكُمُ أَتَمُّ وَأَطوَلُ",52,"ل",1,0],["ما طَرَحَت عَلى دَنِي","يٍ نَفسَها فَتُطَّرَح",53,"ح",1,0],["ما طالَ لَيلى وَلَيلى في الغوير وَلا","أَو هي فؤادي هوى نعم وَنعمان",54,"ن",1,0],["ما طَلَعَتْ شَمْسٌ مِنَ الْمَغْرِبِ","قَبْلَكَ فِي أُفْقٍ وَلا مَوْكِبِ",55,"ب",1,1],["ما طارَ طَيرٌ وَشَدا","ولاح فجرٌ وَبَدا",56,"د",2,0],["ما طابَ بعد اِستماع منطقِه","لِمَسمَعي من مُحاوِرٍ كَلِمَه",57,"م",2,0],["ما طابَ تَعليلُ نشرِ الريح إذ نسمت","إلّا لإلمامها يوماً بأَرضِهمِ",58,"م",1,0],["ما طابَ لَيلُ الوصل إلّا واِنبرى","يُهدي لنا مِسكاً وَيوقِدُ عَنبرا",59,"ر",2,1],["ما طاب قلبي ولا فؤادي","من بعد ما غبت عن بلادي",60,"د",2,1],["ما طوا في اليوم في الدمن","واغتراب النفس في الوطن",61,"ن",1,0],["ما طابَ لي في العُمرِ عُد أَصابِعي","أَيّامَ صَفوٍ عَن هُمومٍ خالِيَةِ",62,"ه",1,0],["ما طَنَّبَتْ قَطُّ في أرضٍ مُخَيِّمةً","إلاّ وأقمرَ للأبصارِ داجيها",63,"ي",3,0],["ما طاف بالبيتِ زُوّارٌ وما رُفعَتْ","فيه الأكُفُّ وما سِيقَتْ له بُدُن",64,"ن",1,0],["ما طَوَّل الليل القَصيرا","ونَهى الكواكبَ أن تَغورا",65,"ر",2,1],["ما طاف بي يأس ، ولا","غطَّى على أملي الألمْ",66,"م",1,0],["ما طنبت أوتادها","فوق الرياض سحاب مزن",67,"ن",1,0],["ما طرق الطرفَ سوى سُهْدِه","مذ غاب من يفدي بمسوده",68,"د",2,1],["ما طلق الدنيا اختياراً إنما","هي طلقته ومتعته بدائه",69,"ا",3,0],["ما طَرَّزَ القرطاس إِلّا أَقلامه","أَيدي العدى مهجاً عَلَيهِ تُمارُ",70,"ر",1,0],["ما طلَبوا مِن غيرِ مُعْطٍ ولا","دَعَوْا إذا اضْطُرُّوا سوى السامِعِ",71,"ع",1,0],["ما طار فوادي من ولهٍ","إلّا لمرابعها الضرج",72,"ج",1,0],["ما طالَ خطبي مع خَطْبٍ يحاولُني","إلا استثارَتْكَ لي الأشعارُ والخُطَبُ",73,"ب",1,0],["ما طرْنَ في جوّها عقبانَ ألويةٍ","صاغ النجيعُ لها تصْحيفَ عُقبانِ",74,"ن",1,0],["ما طرزت مفردات اللفظ قافية","إلا وحف بها حب وإيثار",75,"ر",1,0],["ما طولُ هزّي من عطائك عادةٌ","لي في ابتذال الشعر أو تهوينهِ",76,"ن",2,0],["ما طرَقَتها شفةٌ ولا يدٌ","ما ودَعَ السحابُ فيها ما خزَنْ",77,"ن",1,0],["ما طرَّقَتْ بك وهي راجيةٌ","جَرَيَانَ مثلكِ في مطا فحلِ",78,"ل",1,0],["ما طرقَتْ في حاجةٍ","باباً لكم إلا غُلِقْ",79,"ق",1,0],["ماطلةٌ غريمها لا يَقتضي","ديونَه ودَينَها لا يُنسِي",80,"س",2,0],["ما طاف بالبيت ماحِي زَلّةٍ وسعى","شُعْثٌ أمامَ الصفا أنضاءُ أسفارِ",81,"ر",1,0],["ما طِيفَ بالأستار في مثلِهِ","ودامتِ المَروةُ أختَ الصَّفا",82,"ا",1,0],["ما طابَ شيءٌ في الزمانِ لِسامِعٍ","أو ناشِقٍ اِلاَّ وعِرْضُك أطيبُ",83,"ب",1,1],["ما طال ليلي بعد كاظمةِ","بل طال بعد فراقها خبلي",84,"ل",2,0],["ما طلَّ دمعَ العينِ إلا كونها","بعد الجميع معالماً وطلولا",85,"ل",2,0],["ما طَفْلة ليس سوى إهابها","يفرشها المرء ولا يحظى بها",86,"ب",3,1],["ما طوَى الرَّكبُ شُقَّةَ الأَرضِ يوماً","لنواحي البِطاحِ إِلاَّ وذْبْنَا",87,"ن",2,1],["ما طِقْتُ في أمرِها ندًّا ولا عضُدا","فكانَ غيري الّذي بحُسنِها انفرَدا",88,"د",2,0],["مَا طالَ مَا حَرَّرْتُهُ","بَلْ طَابَ يا فَرْدَ الزَّمَنْ",89,"ن",1,1],["ما طالَ نَزعُ الموتِ فيك ثَلاثَةً","إلاَّ لِتَخرُجَ طاهِرَ الجُثمانِ",90,"ن",1,0],["ما طالَ لَيلٌ بِهِ ذِكراكِ أَرَّقَني","هَواكِ أَطوَلُ مِن لَيلي وَإِن طالا",91,"ل",2,0],["ما طافَ أَبخَلُ مِنها","حَتّى بِطَيفِ الخَيالِ",92,"ل",1,0],["ما طوله عن كِبرٍ إِنَّما","طَوَّلَهُ فَرْطُ عِناقِي لَهُ",93,"ه",1,0],["ما طابَ لي في سِواكم","نونٌ وعينٌ وتاءُ",94,"ا",2,0],["ما طابَ فيهِ ثَن