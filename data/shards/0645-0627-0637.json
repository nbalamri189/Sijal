{"poems":[[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[71,"كم ذا التبظرم زائدا عن حده","https://www.aldiwan.net/poem3822.html","الكامل"],[73,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[23,"ما طلعت شمس النهار ولا بدت","https://www.aldiwan.net/poem21474.html","الطويل"],[51,"يوم الثلاثاء ما يوم الثلاثاء","https://www.aldiwan.net/poem7953.html","البسيط"],[51,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[51,"ما طلت باللهو والأيام تنتجز","https://www.aldiwan.net/poem64547.html","البسيط"],[91,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[91,"ما طائر كان فيبيداء موحشة","https://www.aldiwan.net/poem62778.html","عموديه"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[62,"يا صاحبي أعيناني على سكن","https://www.aldiwan.net/poem52364.html","البسيط"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[61,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[49,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[49,"ما للفتى مانع من القدر","https://www.aldiwan.net/poem62070.html","الكامل"],[49,"ما طار طير فارتفع","https://www.aldiwan.net/poem64242.html","مجزوء الرجز"],[66,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"يا من به يفتخر الفخر","https://www.aldiwan.net/poem30514.html","السريع"],[69,"ما طلبنا الخمول جهلا ولكن","https://www.aldiwan.net/poem28707.html","الخفيف"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"طالت أناتك في القوم الألى جهلوا","https://www.aldiwan.net/poem43393.html","البسيط"],[81,"صرح بما عندي ولو ملأ الفضا","https://www.aldiwan.net/poem61466.html","الطويل"],[52,"قد أغتدي والصبح كالمشيب","https://www.aldiwan.net/poem27238.html","الرجز"],[67,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[48,"فديت من تم فيه الظرف والأدب","https://www.aldiwan.net/poem10814.html","البسيط"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[46,"دنياك والحمام في رتبة","https://www.aldiwan.net/poem23259.html","السريع"],[76,"لا واستراق اللحظ من","https://www.aldiwan.net/poem39500.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85342","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55096","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116968","المنسرح"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[49,"مَا للْفَتَى مانِعٌ منَ القَدَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=25221",""],[57,"حسبي بعلمي إن نفع","https://www.poetsgate.com/ViewPoem.aspx?id=3310",""],[113,"للغوث عبد القادر الجيلاني","https://www.aldiwan.net/poem41764.html","الكامل"],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[148,"يا أبا الفضل وابنه وأخاه","https://www.aldiwan.net/poem68472.html","الخفيف"],[158,"دمعي على الخد مثل الدر ينتثر","https://www.aldiwan.net/poem58847.html","الكامل"],[176,"ضاد النفائس","https://www.aldiwan.net/poem50709.html","البسيط"],[196,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[197,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[208,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[208,"لطائر البشر بالأفراح تغريد","https://www.aldiwan.net/poem13312.html","البسيط"],[209,"والدرة العصماء","https://www.aldiwan.net/poem46810.html","المجتث"],[233,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[233,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[269,"أمن تذكر أهل البان والبان","https://www.aldiwan.net/poem52124.html","البسيط"],[278,"ما طلعت شمس من المغرب","https://www.aldiwan.net/poem60771.html","الطويل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[295,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[295,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[295,"ما طاب ليل الوصل إلا وانبرى","https://www.aldiwan.net/poem33251.html","الكامل"],[302,"ما طاب قلبي ولا فؤادي","https://www.aldiwan.net/poem16779.html","مخلع البسيط"],[302,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[318,"والله ذي القدر العظيم ومن به","https://www.aldiwan.net/poem61776.html","الطويل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[362,"هو الغرام أقام الحي أم ظعنوا","https://www.aldiwan.net/poem60629.html","البسيط"],[369,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[397,"وأضأت ليلي","https://www.aldiwan.net/poem6707.html","عموديه"],[400,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[400,"ما طرق الطرف سوى سهده","https://www.aldiwan.net/poem33971.html","السريع"],[400,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[403,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[406,"من مبلغ المعتر والقانع","https://www.aldiwan.net/poem31879.html","السريع"],[426,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[429,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[447,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[456,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[456,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[456,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[456,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[456,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[459,"ما طاب شيء في الزمان لسامع","https://www.aldiwan.net/poem15678.html","الكامل"],[462,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[462,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[493,"ما طفلة ليس سوى إهابها","https://www.aldiwan.net/poem9773.html","مشطور الرجز"],[498,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[503,"حبّ الدّنيا","https://www.aldiwan.net/poem61089.html","البسيط"],[527,"ما طال ما حررته","https://www.aldiwan.net/poem37120.html","مجزوء الرجز"],[536,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[551,"قد كنت قبلك خلوا فابتليت بمن","https://www.aldiwan.net/poem68377.html","البسيط"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[573,"أهوى طويل القد كم عاذل","https://www.aldiwan.net/poem2889.html","السريع"]],"verses":[["ماطَلَها الماءَ فَلَمّا سَلَت","عَنِ الرَوى ماطَلَها بِالعَليق",0,"ق",1,0],["ما طالَ يَومُ مُلَثَّمٍ","إِلّا اِستَراحَ إِلى السُفورِ",1,"ر",1,0],["ما طالَ في اللَيلِ البَهيمِ سُجودُهُ","إِلّا لِيَركَعَ فَوقَهُ السودانُ",2,"ن",1,0],["ما طولُ عَذلِكِ لِلمَحِبُّ بِنافِعِ","ذَهَبَ الفُؤادُ فَلَيسَ فيهِ بِراجِعِ",3,"ع",1,1],["مَا طَوَى اللَّحْدُ عِزَّةً تَتَجَلَّى","مِنْ بَنِيهِ فِي أَرْفَعِ الأَعْلامِ",4,"م",1,0],["ما طالبتُ همّتي دهري بمَعُلُوَةٍ","إلاّ بلغتُ من الأيّام مُقْتَرحا",5,"ح",2,0],["ما طَلَعَت شَمسُ النَهارِ وَلا بَدَت","عَلَيكَ بِمَجدٍ يا اِبنَ مَقطوعَةِ اليَدِ",6,"د",1,1],["ما طابق اللَّهُ نيروزَ الأمير به","إلّا لتلقاهُ فيه كلُّ سَرّاءِ",7,"ا",2,0],["ما طَائرٌ ذو بيضةٍ ضخمةٍ","لكنَّه ليس بِمُستَفْرِخِ",8,"خ",1,0],["ما طَلتَ باللهو والأيامُ تنتجزُ","فنلْ من اللهو حظاً قبلَ تُحتجَزُ",9,"ز",1,1],["ما طَوَت كارِثاً يَدُ الصُبحِ إِلّا","نَشَرَتهُ لَنا يَدُ الإِمساءِ",10,"ا",2,0],["ما طائِرٌ كانَ فيبَيداءَ موحِشَةٍ","فَساقَهُ قَدَرٌ نَحوَ البَساتينِ",11,"ن",1,1],["ماطلهم دَهرهمو بِحَقِّهم","حَتّى إِذا ما قيل لَن يَفي وَفى",12,"ا",1,0],["ما طابَ عنكم فؤادٌ طاب قبلكُمُ","عن الرَّضاعِ تقضَّى والشبابُ مضَى",13,"ض",2,0],["ما طاهِرٌ إِلّا أَبوهُ وَجَدُّهُ","بَرَعوا ثَلاثَتُهُم عَلى ذا الناسِ",14,"س",1,0],["ما طارَ في آثارِها شَرارُها","طاعتُه لفِتيَةٍ تختارُها",15,"ر",3,0],["ما طابَ عَيشُ الحَريصُ قَطُّ وَلا","فارَقَهُ التَعسُ مِنهُ وَالنَصَبُ",16,"ب",1,0],["ما طَيِّبُ القَولِ عِندَ سامِعِهِ ال","مُنصِتِ إِلّا كَطَيِّبِ الثَمَرِ",17,"ر",1,0],["ما طارَ طَيرٌ فَاِرتَفَع","إِلّا كَما طارَ وَقَع",18,"ع",1,1],["ما طالَ في الدُنيا تَنَعُّمَ راحَتي","إِلّا وَقَد قَصُرَت بِها آمالي",19,"ي",1,0],["ما طالَ بَغيٌ قَطُّ إِلّا غادَرَت","غُلَواؤُهُ الأَعمارَ غَيرَ طِوالِ",20,"ل",1,0],["ما طَلَبي لِلإِذنِ أَن شاقَني","شَمسٌ مِنَ الإِنسِ وَلا بَدرُ",21,"ر",1,0],["ما طلبْنا الخمولَ جهلاً ولكنْ","ذاكَ عن خبرةٍ وعنْ تجريبِ",22,"ب",1,1],["ماطالَعَتهُ بَرقَةٌ نَجدِيَّةٌ","إِلّا اِجتَلَتها نِظرَةُ اِستِعبارِ",23,"ر",1,0],["ما طَيَّرَ البَرقُ عَنهُم حادِثاً جَلَلاً","نَخشاهُ إِلّا تَلاهُ حادِثٌ جَلَلُ",24,"ل",1,0],["ما طالَ لَيلي بَعدَهُ بَل ناظِري","يَأتي الصَباحُ فَلا يَراهُ أَبيَضا",25,"ض",2,0],["ما طارَ إِلّا لِدَمٍ مَصبوبِ","يَنفُذُ في الشَمالِ وَالجَنوبِ",26,"ب",1,0],["ما طالَ صَمْتُ مَدائِحِي عَنْ مَجْدِهِ","إِلاَّ لأَنَّ صِلاتِهِ مُسْتَرْسِلَهْ",27,"ل",2,0],["ما طارَ طَرفي إِلى تَحصيلِ صورَتِهِ","إِلّا تَداخَلَني مِن حُسنِها عَلَبُ",28,"ب",1,0],["ماطَلتُهُ دَيناً وَطالَ طِلابُهُ","وَالدَينُ مُنسَرِحٌ وَغَيرُ سَراحِ",29,"ح",1,0],["ما طَهَّرَت بَل دَنَّسَت وَاِرتَمَت","بِالسَيِّدِ الوَهّابِ وَالباخِلِ",30,"ل",1,0],["ما طابَ عيشٌ لم يذُقْ","طعمَ الوِصالِ ولا يَطيبْ",31,"ب",1,0],["ما طالَ عهد اليأس في قلب امرىءٍ","إلا اِستَبان عَلى الجَبين خطوط",32,"ط",1,0],["مَا طَالَ عُمْرِي فِي مَدَاهُ وَإِنَّنِي","لأَخَالُهُ يَعْدُو مَدى الأَعْمَارِ",33,"ر",1,0],["مَا طالَ بِي أَجَلِي سُيوحِشُنِي","أُنْسُ الْمَعَاهِدِ بَعْدَ نَادِيكا",34,"ك",2,0],["ما طمعَت نفسُ عابدٍ فنوى","سؤال قومٍ إلا لهُم خضَعا",35,"ع",2,0],["ما طلبنا نواطحَ السُّحبِ دُورًا","لا، ولا الرَّوضَ وارفات الظِّلال",36,"ل",1,0],["ما طالَ حبلُ حياتِهَ","بل طال في الدنيا شقاؤه",37,"ا",3,0],["ما طاف طائِفُ الانْحِلالِ بأُمَّةٍ","إلا وآذَنَ نَجْمُها بِزَوالِ",38,"ل",1,0],["ما طَيّبُ القَوْلَ عندَ سامِعِهِ ال","مُنْصِتِ، إلاّ لطيْبِ الثّمَرِ",39,"ر",1,0],["ما طار طير وارتفع","إلا كما طار وقع",40,"ع",1,0],["ما طاب من ذكريه قلب متيم","قلق كوته محبة الأوطان",41,"ن",1,0],["ما طال عمري ولكن طال ما حملت","نفسي فسنى وإن لم تعل أسنان",42,"ن",1,0],["ما طوى الروضُ سِرَّهُ جنح ليل","فأذاعته للصباح صباه",43,"ا",2,0],["ما طولوا في الرشا إلا لما حسبوا","لو قدروا فيه قرب المستقى قصروا",44,"ر",3,0],["ما طال غَربٌ جُمانَ الضَّادِ في لُغَةٍ","إنَّ الجُمانَ لها يسعى ويَعْتمِرُ",45,"ر",1,0],["ما طالَعَتْهُ في الدجى لك لمحةٌ","إلا وقال لدمعِ مقلته اسْجم",46,"م",1,0],["ما طالَ عمركَ يا دجى أبداً","غلا ليقصرَ دونهُ عمري",47,"ر",2,0],["ما طاب نشر الثنا يوما لمنتشق","وفاح عطر وهبت في الصباح صبا",48,"ب",2,0],["ما طاب حسن ابتدائي بالمديح وما","لي في ختام حلت تلك الأناشيد",49,"د",1,0],["ما طفرك النعسانُ","وخدك الفتان",50,"ن",1,0],["ما طاوَلَتكُم في الفِخارِ قَبيلَةٌ","إِلّا وَمَجدُكُمُ أَتَمُّ وَأَطوَلُ",51,"ل",1,0],["ما طَرَحَت عَلى دَنِي","يٍ نَفسَها فَتُطَّرَح",52,"ح",1,0],["ما طالَ لَيلى وَلَيلى في الغوير وَلا","أَو هي فؤادي هوى نعم وَنعمان",53,"ن",1,0],["ما طَلَعَتْ شَمْسٌ مِنَ الْمَغْرِبِ","قَبْلَكَ فِي أُفْقٍ وَلا مَوْكِبِ",54,"ب",1,1],["ما طارَ طَيرٌ وَشَدا","ولاح فجرٌ وَبَدا",55,"د",2,0],["ما طابَ بعد اِستماع منطقِه","لِمَسمَعي من مُح