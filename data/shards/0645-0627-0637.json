{"poems":[[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[71,"كم ذا التبظرم زائدا عن حده","https://www.aldiwan.net/poem3822.html","الكامل"],[73,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[23,"ما طلعت شمس النهار ولا بدت","https://www.aldiwan.net/poem21474.html","الطويل"],[51,"يوم الثلاثاء ما يوم الثلاثاء","https://www.aldiwan.net/poem7953.html","البسيط"],[51,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[51,"ما طلت باللهو والأيام تنتجز","https://www.aldiwan.net/poem64547.html","البسيط"],[91,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[91,"ما طائر كان فيبيداء موحشة","https://www.aldiwan.net/poem62778.html","عموديه"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[62,"يا صاحبي أعيناني على سكن","https://www.aldiwan.net/poem52364.html","البسيط"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[61,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[49,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[49,"ما للفتى مانع من القدر","https://www.aldiwan.net/poem62070.html","الكامل"],[49,"ما طار طير فارتفع","https://www.aldiwan.net/poem64242.html","مجزوء الرجز"],[66,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"يا من به يفتخر الفخر","https://www.aldiwan.net/poem30514.html","السريع"],[69,"ما طلبنا الخمول جهلا ولكن","https://www.aldiwan.net/poem28707.html","الخفيف"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"طالت أناتك في القوم الألى جهلوا","https://www.aldiwan.net/poem43393.html","البسيط"],[81,"صرح بما عندي ولو ملأ الفضا","https://www.aldiwan.net/poem61466.html","الطويل"],[52,"قد أغتدي والصبح كالمشيب","https://www.aldiwan.net/poem27238.html","الرجز"],[67,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[48,"فديت من تم فيه الظرف والأدب","https://www.aldiwan.net/poem10814.html","البسيط"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[46,"دنياك والحمام في رتبة","https://www.aldiwan.net/poem23259.html","السريع"],[76,"لا واستراق اللحظ من","https://www.aldiwan.net/poem39500.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85342","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55096","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116968","المنسرح"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[49,"مَا للْفَتَى مانِعٌ منَ القَدَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=25221",""],[57,"حسبي بعلمي إن نفع","https://www.poetsgate.com/ViewPoem.aspx?id=3310",""]],"verses":[["ماطَلَها الماءَ فَلَمّا سَلَت","عَنِ الرَوى ماطَلَها بِالعَليق",0,"ق",1,0],["ما طالَ يَومُ مُلَثَّمٍ","إِلّا اِستَراحَ إِلى السُفورِ",1,"ر",1,0],["ما طالَ في اللَيلِ البَهيمِ سُجودُهُ","إِلّا لِيَركَعَ فَوقَهُ السودانُ",2,"ن",1,0],["ما طولُ عَذلِكِ لِلمَحِبُّ بِنافِعِ","ذَهَبَ الفُؤادُ فَلَيسَ فيهِ بِراجِعِ",3,"ع",1,1],["مَا طَوَى اللَّحْدُ عِزَّةً تَتَجَلَّى","مِنْ بَنِيهِ فِي أَرْفَعِ الأَعْلامِ",4,"م",1,0],["ما طالبتُ همّتي دهري بمَعُلُوَةٍ","إلاّ بلغتُ من الأيّام مُقْتَرحا",5,"ح",2,0],["ما طَلَعَت شَمسُ النَهارِ وَلا بَدَت","عَلَيكَ بِمَجدٍ يا اِبنَ مَقطوعَةِ اليَدِ",6,"د",1,1],["ما طابق اللَّهُ نيروزَ الأمير به","إلّا لتلقاهُ فيه كلُّ سَرّاءِ",7,"ا",2,0],["ما طَائرٌ ذو بيضةٍ ضخمةٍ","لكنَّه ليس بِمُستَفْرِخِ",8,"خ",1,0],["ما طَلتَ باللهو والأيامُ تنتجزُ","فنلْ من اللهو حظاً قبلَ تُحتجَزُ",9,"ز",1,1],["ما طَوَت كارِثاً يَدُ الصُبحِ إِلّا","نَشَرَتهُ لَنا يَدُ الإِمساءِ",10,"ا",2,0],["ما طائِرٌ كانَ فيبَيداءَ موحِشَةٍ","فَساقَهُ قَدَرٌ نَحوَ البَساتينِ",11,"ن",1,1],["ماطلهم دَهرهمو بِحَقِّهم","حَتّى إِذا ما قيل لَن يَفي وَفى",12,"ا",1,0],["ما طابَ عنكم فؤادٌ طاب قبلكُمُ","عن الرَّضاعِ تقضَّى والشبابُ مضَى",13,"ض",2,0],["ما طاهِرٌ إِلّا أَبوهُ وَجَدُّهُ","بَرَعوا ثَلاثَتُهُم عَلى ذا الناسِ",14,"س",1,0],["ما طارَ في آثارِها شَرارُها","طاعتُه لفِتيَةٍ تختارُها",15,"ر",3,0],["ما طابَ عَيشُ الحَريصُ قَطُّ وَلا","فارَقَهُ التَعسُ مِنهُ وَالنَصَبُ",16,"ب",1,0],["ما طَيِّبُ القَولِ عِندَ سامِعِهِ ال","مُنصِتِ إِلّا كَطَيِّبِ الثَمَرِ",17,"ر",1,0],["ما طارَ طَيرٌ فَاِرتَفَع","إِلّا كَما طارَ وَقَع",18,"ع",1,1],["ما طالَ في الدُنيا تَنَعُّمَ راحَتي","إِلّا وَقَد قَصُرَت بِها آمالي",19,"ي",1,0],["ما طالَ بَغيٌ قَطُّ إِلّا غادَرَت","غُلَواؤُهُ الأَعمارَ غَيرَ طِوالِ",20,"ل",1,0],["ما طَلَبي لِلإِذنِ أَن شاقَني","شَمسٌ مِنَ الإِنسِ وَلا بَدرُ",21,"ر",1,0],["ما طلبْنا الخمولَ جهلاً ولكنْ","ذاكَ عن خبرةٍ وعنْ تجريبِ",22,"ب",1,1],["ماطالَعَتهُ بَرقَةٌ نَجدِيَّةٌ","إِلّا اِجتَلَتها نِظرَةُ اِستِعبارِ",23,"ر",1,0],["ما طَيَّرَ البَرقُ عَنهُم حادِثاً جَلَلاً","نَخشاهُ إِلّا تَلاهُ حادِثٌ جَلَلُ",24,"ل",1,0],["ما طالَ لَيلي بَعدَهُ بَل ناظِري","يَأتي الصَباحُ فَلا يَراهُ أَبيَضا",25,"ض",2,0],["ما طارَ إِلّا لِدَمٍ مَصبوبِ","يَنفُذُ في الشَمالِ وَالجَنوبِ",26,"ب",1,0],["ما طالَ صَمْتُ مَدائِحِي عَنْ مَجْدِهِ","إِلاَّ لأَنَّ صِلاتِهِ مُسْتَرْسِلَهْ",27,"ل",2,0],["ما طارَ طَرفي إِلى تَحصيلِ صورَتِهِ","إِلّا تَداخَلَني مِن حُسنِها عَلَبُ",28,"ب",1,0],["ماطَلتُهُ دَيناً وَطالَ طِلابُهُ","وَالدَينُ مُنسَرِحٌ وَغَيرُ سَراحِ",29,"ح",1,0],["ما طَهَّرَت بَل دَنَّسَت وَاِرتَمَت","بِالسَيِّدِ الوَهّابِ وَالباخِلِ",30,"ل",1,0],["ما طابَ عيشٌ لم يذُقْ","طعمَ الوِصالِ ولا يَطيبْ",31,"ب",1,0],["ما طالَ عهد اليأس في قلب امرىءٍ","إلا اِستَبان عَلى الجَبين خطوط",32,"ط",1,0],["مَا طَالَ عُمْرِي فِي مَدَاهُ وَإِنَّنِي","لأَخَالُهُ يَعْدُو مَدى الأَعْمَارِ",33,"ر",1,0],["مَا طالَ بِي أَجَلِي سُيوحِشُنِي","أُنْسُ الْمَعَاهِدِ بَعْدَ نَادِيكا",34,"ك",2,0],["ما طمعَت نفسُ عابدٍ فنوى","سؤال قومٍ إلا لهُم خضَعا",35,"ع",2,0],["ما طلبنا نواطحَ السُّحبِ دُورًا","لا، ولا الرَّوضَ وارفات الظِّلال",36,"ل",1,0],["ما طالَ حبلُ حياتِهَ","بل طال في الدنيا شقاؤه",37,"ا",3,0],["ما طاف طائِفُ الانْحِلالِ بأُمَّةٍ","إلا وآذَنَ نَجْمُها بِزَوالِ",38,"ل",1,0],["ما طَيّبُ القَوْلَ عندَ سامِعِهِ ال","مُنْصِتِ، إلاّ لطيْبِ الثّمَرِ",39,"ر",1,0],["ما طار طير وارتفع","إلا كما طار وقع",40,"ع",1,0]]}