{"poems":[[55,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[3,"إذا كانَ أمر الله أمراً يقدر","https://www.aldiwan.net/poem160.html",""],[93,"يا ليتني لص لأسرق في الضحى","https://www.aldiwan.net/poem8846.html","عموديه"],[30,"أوصي تميماً إن قضاعة ساقها","https://www.aldiwan.net/poem1237.html",""],[82,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[50,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[48,"رأيتك في لج من البحر سابحا","https://www.aldiwan.net/poem23299.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9928","الطويل"],[30,"أوصي تميما إن قضاعة ساقها","https://www.poetsgate.com/ViewPoem.aspx?id=21300",""],[139,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[164,"اضرب بسيف العزم أَعناق الكرى","https://www.aldiwan.net/poem58719.html","الكامل"],[214,"تهللت الأفراح وابتسم الدهر","https://www.aldiwan.net/poem13466.html","الطويل"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[463,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[487,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[556,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202091","المتقارب"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132852","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128045","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105425","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109354","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127401","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87363","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145048","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127021","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26977","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5829,"اختال عجبا","https://www.poetsgate.com/ViewPoem.aspx?id=192271",""]],"verses":[["وَأَجسادٍ تُشاطِرُها المَنايا","نُفوساً في ضِرابٍ أَو طِعانِ",0,"ن",1,0],["وَأَجسادَ قَومٍ يَسكُنُ الطَيرُ حَولَه","إِلى أَن يَرى وَحشَ الفَلاةِ فَيَنفِرُ",1,"ر",1,0],["وَأَجُسَّ مُؤتَلَقَ الجَمالِ بِإِصبَعي","في زُرقَةِ الأُفقِ الجَميلِ العاري",2,"ر",2,0],["وَأَجسَمُ مِن عادٍ جُسومُ رِجالُهُم","وَأَكثَرُ إِن عُدّوا عَديدَ مِنَ التُربِ",3,"ب",1,0],["وأجسامُ أحيائهمْ في النّعيمِ","وأرواحُ أمواتِهِمْ في الخُلودِ",4,"د",1,0],["واجسر فما نالَ الذي","يهواهُ إلّا مَن جسَر",5,"ر",1,0],["وَأَجسامُنا مِثلُ الدِيارِ لِأَنفُسٍ","جَوائِرَ مِنها جاهِلٌ وَحَليمُ",6,"م",1,0],["وَأَجسادَ قَومٍ يَسكُنُ الطَيرُ حَولَها","إِلى أَن يَرى وَحشَ الفَلاةِ فَيَنفِرُ",7,"ر",1,0],["وَأجْسَمُ مِنْ عادٍ جُسُومُ رِجالِهمْ","، وأَكثرُ إنْ عُدّوا عديداً مِنَ التُّرْبِ",8,"ب",1,0],["واجسر على اللذات وانتهز الصبا","يا صاح وامتطِ صهوة الأهواءِ",9,"ا",2,0],["واجسر على فَقدِ الأَحِبّةِ إِنه","من خافَ من مرَصين داوى الأَخطرا",10,"ر",2,0],["واجسامهم للطير والوحش خلفوا","يسامرها العوا ويرقبها النسر",11,"ر",1,0],["وَأجْسَادَ إيمانٍ كَساها نَجيعُهَا","مَجاسِدَ منْ نَسْجِ الظُّبَى واللهاذِمِ",12,"م",1,0],["وأجسامَ نور لهم في الصعي","د تملؤه فيضيء الملا",13,"ل",2,0],["وأجسامهم أخشاب جهل مؤسس","مسندة لا يقمعوا بالمعاول",14,"ل",1,0],["وأجسادٍ عُرِين من المخازي","ومن كرمٍ وخيرٍ ما عُرينا",15,"ن",2,0],["وأَجسَادُهم في الفلا طُعْمَةٌ","تقاسمها وَحْشُها والطُيُور",16,"ر",1,0],["وأجسامٍ مُسَمَّنةٍ شباعٍ","وأَحسَابٍ مُضَمَّرةٍ جِياعِ",17,"ع",1,0],["واجسر على فرض اللذات محتقرا","من ادعى أن حكم العقل زاجره",18,"ر",2,0],["وأجسادهم في كربلاء تكفلت","بتكفنيهن الساقيات النوافخ",19,"خ",1,0],["واجسامنا تهوى المعاد لأصلها","ومهما تزكّت فالتراب طهورها",20,"ر",3,0],["وأجس قلبك عند ذاك","وإذ بقلبك يضطرب",21,"ب",1,0],["واجسامُنا اللآئي لنا سَلَكَت بِهِ","قَديماً فَكَيفَ اليوم لا تَتعوَّدُ",22,"د",1,0],["وأجساد ممزقة الحشايا","تكاد لها النواصي أن تشيبا",23,"ب",2,0],["وأجسامهم فوق الصعيد رهائن","وأرؤسهم فيها الصماد تميل",24,"ل",1,0],["وَأَجسادُهُم لا يَأكُلُ التُربُ لَحمَها","هُنالِكَ لا تَبلى إِلى آخِرِ الدَهرِ",25,"ر",1,0],["وَاجْسُرْ عَلى فُرَصِ اللَّذاتِ مُحْتَقِراً","عَظِيمَ ذَنْبِكَ إنَّ اللَّه غافِرُهُ",26,"ر",2,0],["وأجسام تكاد تذوب لطفا","بأكباد تقد من الصخور",27,"ر",1,0],["واجسامي يوم الوغى ويميني","من لرجم العداة كان شهابا",28,"ب",2,0],["وأجسام الطغاة حجين عنا","ضياء لا نريد له احتجابا",29,"ب",2,0],["وأجساد الرجال لها بناء","فلا ضيم يدوم وإن تناهى",30,"ا",3,0]]}