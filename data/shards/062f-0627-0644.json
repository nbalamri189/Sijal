{"poems":[[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[266,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103082","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96711","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136938",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120468","الكامل"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[4831,"الشيطان الأكبر","https://www.poetsgate.com/ViewPoem.aspx?id=208041",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4955,"قالوا تصبر فقلت الصبر من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=198919",""],[5282,"لؤلؤةٌ... وحروف زمرد (٢)","https://www.poetsgate.com/ViewPoem.aspx?id=214080",""],[5419,"باحس إني باضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[5464,"سيدة النساء","https://www.poetsgate.com/ViewPoem.aspx?id=53584",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5736,"محمود","https://www.poetsgate.com/ViewPoem.aspx?id=203821",""],[5736,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208186",""],[5464,"يا أخت هارون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66201&r=&rc=20",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""]],"verses":[["دَالَ السُّكُونُ مِنَ الحَرَاكِ الدَّائِمِ","وَأَقَرَّ بَعْدَ السُّهْدِ عَيْنَ النَّائِمِ",0,"م",1,1],["دَالَتْ بِهَا دُوَلٌ وَلاَقَيْتَ الَّذِي","لاَقَيْتَ مِنْ غِيَرٍ ومِنْ أَهْوَالِ",1,"ل",1,0],["دالَ الزمانُ وبُدلتْ نُظُمٌ به","ولكل عصرٍ دولةٌ ونِظام",2,"م",1,0],["دال دنت بي منه رحما زورة","فظننتها مما ازدهيت خيالا",3,"ل",2,0],["دالي بدابل مقلتو","ودابل القد استطال",4,"ل",1,0],["دال صد المحب من صدغك الأعوج","امضى ومن لحاظك صاده",5,"د",2,0],["دِ الذي فاقَ عَدُّهُ الأَرقاما","أيُّها الناصِري دُم رَمزَ نَصرٍ",6,"ر",1,0],["دالٌّ ولكنه في تيه حيرته","ما بين وصفين مدني ومبعود",7,"د",1,0],["دالَت بهِ دولة الإسلامِ واِفتخَرت","بهِ وَطالت مياديناً على الدولِ",8,"ل",1,0],["دال الدنو وَذال ذهن نير","راء الرِياسة زاي خَير جَزاء",9,"ا",2,0],["دالَت لَهُ دولةٌ فيها الصفاءُ نما","لمثلهِ شبهها في القوم لم يَدُلِ",10,"ل",1,0],["دالت أويقات الصفا وغشت","وجه الوجود غمائم غبر",11,"ر",1,0],["دالية كانت فدالت بيننا","رأية فالدر من ادوارها",12,"ر",3,0],["دالٌ در المنظوم حصا","والدر قليلٌ أن يذكر",13,"ر",1,0],["دالَ الزَّمانُ بِنا والدَّهْرُ مُضْطَرِبٌ","فالشرُّ ذئْبٌ على الأحْراِر مُقْتَحِمُ",14,"م",1,0],["دَاْلَتْ(5)، وَمَاْ نَهَضَتْº لَمَّاْ تَسَلَّمَهَاْ","قِرْدٌ، وَدُبٌّ بِنَاْرِ الشَّرِّ يُصْلِيْهَاْ",15,"ي",3,0],["(دالٌ) دعوتُ إلهَ الكونِ صحبَتَهُ","في جنَّةِ الخلدِ كم تحلو به الدارُ",16,"ر",1,0],["دَالٌ دَلالٌ في الرُدُودِ وفي الرِداءْ","لِتَكون بَدراً سَاطِعاً عنْدَ الدُعَاءْ",17,"ا",2,1],["دا لو كان البعاد قدرى","وأكون وحدى أنا بكره",18,"ه",1,0],["دال بنا الدهرُ .. فأغصانُنا","عن جذرِها كبُعدِ نجم ٍ وثانْ",19,"ن",1,0],["دالية صاغها ذاك ( المحقق ) مَن","دانت له الضاد في علم وفي حِكَم",20,"م",1,0],["دال ملك الجنان فيها إليهم","بعدما باعها ( الرئيس ) بماها",21,"ا",3,0],["دالٌ: دنتْ مني الحروفُ قصائداً","يا ليتَ شعري هلْ حروفي تُجزلُ",22,"ل",1,0],["دالٌ / دماءُ القلبِ تجري كلما","ذُكِرَ الحبيبُ ودمعُ عيني أجهشا",23,"ش",2,0],["دالَتْ علينا صروفُ الدَّهْرِ وأنْقَلَبتْ","صروحُنا فإذا راياتُنا الدُّونى!",24,"ن",2,0],["دَالت ، فلا فِرعَونُ خلَّد نفسَهُ","كلا ولا قَارُونُ في الأحياءِ",25,"ا",2,0]]}