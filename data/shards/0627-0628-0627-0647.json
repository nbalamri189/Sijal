{"poems":[[55,"أبا هرم أنحها إنني","https://www.aldiwan.net/poem29792.html","المتقارب"],[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[9,"يظن الناس بالملكي","https://www.aldiwan.net/poem21983.html","مجزوء الوافر"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[95,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[4,"أعاذل قومي فاعذلي الآن أو ذري","https://www.aldiwan.net/poem21164.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[80,"أبا هاشم هضمتني الشفار","https://www.aldiwan.net/poem14156.html","المتقارب"],[30,"أكان الباهلي يظن أني","https://www.aldiwan.net/poem1248.html",""],[30,"إن هجاء الباهلين دارماً","https://www.aldiwan.net/poem1280.html",""],[30,"أباهل لو أن الأنام تنافروا","https://www.aldiwan.net/poem5529.html","الطويل"],[30,"أباهل هل أنتم مغير لونكم","https://www.aldiwan.net/poem5559.html","الطويل"],[82,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[107,"ألا إن هذا وفد كندة قد أتى","https://www.aldiwan.net/poem44007.html","الطويل"],[52,"دعيني يا أميرة من سرار","https://www.aldiwan.net/poem63804.html","الوافر"],[52,"أباهل إني حين لاح قتيري","https://www.aldiwan.net/poem63805.html","الطويل"],[52,"أباهل إني للحروب عواد","https://www.aldiwan.net/poem63892.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85487","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67318","الطويل"],[190,"أبا هاشم بن المرزبان ومن دعى","https://www.aldiwan.net/poem43961.html","الطويل"],[254,"أي المنازل بعد الحي تعترف","https://www.aldiwan.net/poem2106.html","البسيط"],[302,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[398,"ابا هاشم مالي أراك عليلا","https://www.aldiwan.net/poem53465.html","الطويل"],[422,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[509,"أباهي بوجد قد تمكن في الحشا","https://www.aldiwan.net/poem38408.html","الطويل"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145642","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145166","المتقارب"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93096","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48951","المتقارب"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115022","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74991","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109739","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136964",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124294","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138602",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129442","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129389","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132165","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103279","المتقارب"],[4750,"كرمة ودمت","https://www.poetsgate.com/ViewPoem.aspx?id=180404",""],[185,"أَلاَ يا حِمَى وادِى المِيَاهِ قَتلَتنى","https://www.poetsgate.com/ViewPoem.aspx?id=4469",""],[4929,"لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=199215",""],[5277,"رجعُ الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=210288",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[6031,"أبا هاشمٍ إنّ الذي كُنتَ واصِفاً","https://www.poetsgate.com/ViewPoem.aspx?id=46400",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[4442,"أرهقتني بين المقابر جلبه","https://www.poetsgate.com/ViewPoem.aspx?id=171231",""],[831,"ذكرى جلوسك مظهرُ الأوطانِ","https://diwany.org/%D8%B0%D9%83%D8%B1%D9%89-%D8%AC%D9%84%D9%88%D8%B3%D9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"]],"verses":[["أَبا هَرِمٍ أُنحُها إِنَّني","سَأُمطِرُها عَن قَليلٍ دَما",0,"م",2,1],["أَبا هَرِمٍ وَأَنتَ تُريدُ ضَيمي","بِأَيِّ يَدٍ تُطامِنُ مِن طَماحي",1,"ح",2,0],["أُباةَ الضَيمِ لا يُعطو","نَ مَن عادَوهُ ما حَكَما",2,"م",2,0],["أَبا هِندٍ فَلا تَعَجَل عَلَين","وَأَنظِرنا نُخَبِّركَ اليَقينا",3,"ن",2,0],["أُبَاةَ الضَّيمِ مِنْ عَرَبٍ وَتُركٍ","نُسُورَ الشُّمِّ أسَادَ المَوَامِي",4,"م",2,0],["أَباهِلَ ما أَحبَبتُ قَتلَ اِبنِ مُسلِمٍ","وَلا أَن تَروعوا قَومَكُم بِالمَظالِمِ",5,"م",1,0],["أَباهِلَ قَد أَوفَيتُمُ مِن دِمائِكُم","إِذا ما قَتَلتُم رَهطَ قَيسِ بنِ عاصِمِ",5,"م",1,0],["أُباهي بِهِ الأَكفاءَ في كُلِّ مَوطِنٍ","وَأَقضي فُروضَ الصالِحينَ وَأَقتَري",6,"ر",2,0],["أبَاهَا وقد عَنَّتْ له من بَنَاتِهَا","كَوَاعِبُ يُصْبينَ الحلِيمَ ونُهَّدُ",7,"د",1,0],["أَبا هاشِمٍ هَضَّمتَني الشِفارُ","فَلِلَّهِ صَبري لِذاكَ الأوارْ",8,"ر",1,1],["أَباهِلَ أَينَ مَنجاكُم إِذا ما","مَلَأنا بِالمُلوكِ وَبِالقِبابِ",9,"ب",1,0],["أَباهِلَ هَل في دَلوِكُم إِذ نَهَزتُمُ","بِها كَرِشاءِ اِبنَي عِقالٍ وَحاجِبِ",10,"ب",1,0],["أَباهِلَ إِنَّ الماءَ لَيسَ بِغاسِلٍ","مَخازِيَ عَنكُم عارُها غَيرُ ذاهِبِ",10,"ب",1,0],["أَباهِلَ لَو أَنَّ الأَنامَ تَنافَروا","عَلى أَيِّهِم شَرٌّ قَديماً وَأَلأَمُ",11,"م",1,1],["أَباهِلُ هَل أَنتُم مُغَيِّرُ لَونِكُم","وَمانِعَكُم أَن تُجعَلوا في المَقاسِمِ",12,"م",1,1],["أَباهِلَ إِنَّ الذُلَّ بِاللُؤمِ قَد بَنى","عَلَيكُم خِباءَ اللُؤمِ ضَربَةَ لازِمِ",12,"م",1,0],["أَباهِلَ هَل مِن دونِكُم إِن رُدِدتُمُ","عَبيداً إِلى أَربابِكُم مِن مُخاصِمِ",12,"م",1,0],["أَباهِلَ ما أَنتُم بِأَوَّلِ مَن رَمى","إِلَيَّ وَإِن كُنتُم لِئامَ الأَلائِمِ",12,"م",1,0],["أبا هاشم هشّمتني الشفار","فَللَّه صبري لذاك الأوار",13,"ر",1,1],["أباها رَسولُ اللهِ منهم تحيّةً","رآها من اللَّغوِ المُذَمَّمِ والهَذَرْ",14,"ر",1,0],["أَباهِلَ راجِعي مَولاكِ صَغراً","وَلا تَجري عَلى ضَوءِ النَهارِ",15,"ر",1,0],["أَباهِلَ لَيسَ شَأنُكُمُ كَشَأني","إِذا لَم تُقصِروا وَالحَقُّ عارِ",15,"ر",1,0],["أَباهِلَ ما وَهَبتُكُمُ فَتَنأوا","وَلا مَولايَ بِالعِلقِ المُعارِ",15,"ر",1,0],["أَباهِلَ إِنّي حينَ لاحَ قَتيري","وَما أَنا بِالفاني وَلا بِصَغيرِ",16,"ر",1,1],["أَباهِلَ قَد غَيَّبتُ عَنكُم لِتَشكُروا","وَما كُلُّ مَولى نِعمَةٍ بِشَكورِ",16,"ر",1,0],["أَباهِلَ إِنّي لِلحُروبِ عِوادُ","وَإِنَّ رِدائي مُنصُلٌ وَنِجادُ",17,"د",1,1],["أَباهِلَ هُزّوا لي فَتىً غَيرَ مُدخَلٍ","فَإِنَّ سَماءَ الباهِلِيِّ جَمادُ",17,"د",1,0],["أَباهِلَ فيكُم عُصبَةٌ مُستَفادَةٌ","لِئامُ القِرى فُطسُ الأُنوفِ جِعادُ",17,"د",1,0],["أَباهِلَ رُدّوا أَعبُدَ الحَيِّ إِنَّهُم","جِعادٌ وَمِن مالِ الكِرامِ تِلادُ",17,"د",1,0],["أباة ترى أَنَّ الحَياة حَقيرة","وَما حب نفس لا يَجوز خلودها",18,"د",3,0],["أَبا هِندٍ فَلا تَعَجَل عَلَينا","وَأَنظِرنا نُخَبِّركَ اليَقينا",19,"ن",2,0],["أَبَاهُ البَرَاءُ وابنُ عمرٍو كِلاهُمَا","واسْعَدُ يأْبَاهُ عَلَيْكَ وَرَافعُ",20,"ع",1,0],["أبا هاشم بن المرزبان ومن دعى","أجاب وإلا أقلقته الشوارد",21,"د",1,1],["أَباهُمُ ثُمَّ ما زالوا عَلى مُثُلٍ","لا يَنكُلونَ وَلا هُم في الوَغى كُشُفُ",22,"ف",1,0],["أَبا هاشِمٍ أَشرقتَ كوكب سُحرَةٍ","فَلا عَجَبٌ إِن غبتَ عنّا على وَشكِ",23,"ك",1,0],["اَبا هاشِمٍ مالي أَراكَ عَليلا","ترفَّق بِنَفس المُكرَمات قَليلا",24,"ل",2,1],["أَبا هاشِمٍ لَم أَرضَ هاتيكَ دَعوَةً","وَاِن صَدَرت عَن مُخلِصٍ مُتَطَوِّلِ",24,"ل",1,0],["أباهي بك السادات شرقاً ومغرباً","وأرْفُلُ في بُرد النعيم وأختال",25,"ل",1,0],["أباةُ الضَّيْم أشراف","لغير الله ما دانوا",26,"ن",3,0],["أباةٌ لا يطوف الضَّيم فيهم","ولا جار لهم بالمستباحِ",27,"ح",1,0],["أباهي بوجدٍ قد تمكن في الحشا","وذلك فضل الله يؤتيه من يشا",28,"ش",2,1],["أُباةٌ يَفوزُ مَن تَقَدَّمَ مِنهُمُ","وَسَوفَ يَنالُ الفَوزَ مَن قَد تَأَخَّرا",29,"ر",2,0],["أبا هاشمٍ كنية ضُيِّعتْ","وهل يفهمُ الكنيةَ الخائط",30,"ط",1,0],["أباة رأوا أن الحياة كريهة","ومستامها بعد الحسين مذمم",31,"م",1,0],["أُبَاهي وأَزْهو بالرِّجالِ وها أَنا","نَدِمْتُ لأنِّي كنتُ بالجَهلِ زَاهيا",32,"ي",2,0],["أباهي الأئمة في زيّهم","بشدّ النطاق على المئزر",33,"ر",1,0],["أباه لما كدَّرت صفوه","معاشرٌ باءت بسوء العذاب",34,"ب",1,0],["أُباةَ الهوان حُماةَ الذّمار","حُماةَ الحفائظ بالشُرَّع",35,"ع",1,0],["أبا هاشمٍ لستَ الحليمَ فتُرتجى","ولستَ أبيّاً صابراً حين تُجهلُ",36,"ل",1,1],["أبأهل الزَمان في السمع وقر","أَم غَدا الطرف بالرَدى مكحولا",37,"ل",2,0],["أباها عليَّ الناس لا يشترونها","لعيبٍ بها عند الملاح قبيح",38,"ح",1,0],["أباة الأذى ثم الأنوف نفوسهم","معززة لا تستكين لظالم",39,"م",1,0],["أباة ضَيم فَلا يَخشون ظالمهم","وَالوَيل يَوماً لمن يرمي محارمهم",40,"م",1,0],["أباةُ مضام لا يضام أمينها","إذا ما دعاها للمراس الممارس",41,"س",1,0],["أباةٌ سماة العز لائحةٌ على","جباههم بين الورى ليس تجهل",42,"ل",1,0],["أبا هاتف إني أتيتك شاكيا","وتستعذب الشكوى لمثلك من مثلي",43,"ل",2,0],["أبا هاتف طال انتظاري لوعدكم","وطول انتظار الوعد ضرب من القتل",43,"ل",1,0],["أبا هاتف ان قيل في خطة العلى","أمير بعمر الله أنت أميرها",44,"ر",3,0],["أباه الشيخ عن بعد المرامي","أشاطرك المضاضة والعذابا",45,"ب",2,0],["أباةٌ حماةق لأوطانهم","وأولادهم ولسنوانهم",46,"م",1,0],["أباه ربي كي يلم","على الممالك ثم أخرى",47,"ر",2,0],["أباهلَ ينجني كلبكم","وأسدُكُمُ ككلاب العرب",48,"ب",1,1],["اباهي لا ابالي واتبيسط كل ماقدمت","اشب النار قدام العرب واشيد اخيامي",49,"م",2,0],["أباها علي الناس لا يشترونها","وَمَن يَشتَرِى ذَا عِلَّة بِصَحيحِ",50,"ح",1,0],["أباهي بكِ الدنيا لسانًا وأفخرُ","وأكسب مضمارَ التحدي وأظفرُ",51,"ر",1,1],["أباهي بالهوى العذريّ قيساً","وليلى لا تجيبُ على السؤالِ",52,"ل",1,0],["أبا هاشم يكنى ومن خيم هاشم","على منكبيه المجد أرخى الذوائبا",53,"ب",2,0],["أبا هاشمٍ إنّ الذي كُنتَ واصِفاً","لها أمس والأحوالُ سوف تَحُولُ",54,"ل",1,1],["أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","بَنُو الوُدِّ مِثْلِي من نَدَاكَ فَقِيرُ",55,"ر",1,1],["أَبا هَاشمٍ أُنهِي إليكَ تحيةً","يُجيبكَ رَيَّاها برائحةِ العِطْرِ",56,"ر",1,1],["أبا (هاتف) أعيذك أن ترتاع","يوما بصدمة أو بنكيه",57,"ه",1,0],["آباه في لون النجيع القاني","أو كلما سمعوا بمصر منادياً",58,"ي",2,0]]}