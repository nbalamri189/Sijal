ps://www.poetsgate.com/ViewPoem.aspx?id=41592",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6056,"علوم الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=130329",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6225,"احتضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81123&r=&rc=317",""],[463,"أولى لها أن يرعوي نفارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60088&r=&rc=144",""],[6259,"صددت إذ عادَ روضُ الرأس ذا زهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59373&r=&rc=21",""],[5126,"فكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87793&r=&rc=8",""]],"verses":[["وللمقتول بين يديه لما","تحرف بي زمانٌ عن قتال",0,"ل",1,0],["وَلِلمَباتيرِ في وَغىً وَقِرىً","يولِغُها الهامَ وَالعَراقيبا",1,"ب",2,0],["وَلَلمَوتُ خَيرٌ لِلفَتى مِن حَياتِهِ","إِذا لَم يَثِب لِلأَمرِ إِلّا بِقائِدِ",2,"د",1,1],["وَلِلمَوتِ خَيرٌ لِمَن نالَهُ","إِذا المَرءُ أُمَّتُهُ لَم تَدُم",3,"م",1,0],["وَلِلمُسَمّى بِأُمِّهِ لَقَبٌ","مِثلُ أَبيهِ المَنعوتِ مِن كَذِبِ",4,"ب",1,0],["وللمحة تهفو ببانات اللوىَ","يهفو فؤادك عن جوانح مغرمِ",5,"م",1,0],["ولَلموت خير من حياة تَشوبها","شوائب منها الظلم والذُل والمقت",6,"ت",1,0],["وللمشورة في أوطاننا شبحٌ","تخيف صورته الأشباح والصورا",7,"ر",2,0],["وللموت كسر ليس يمكن جبره","بلفّ ضمادِ أو بشدّ الجبائر",8,"ر",1,0],["وللمدارس همٌّ كاد يدرسها","لولا تدارك أبناءٍ له نُجب",9,"ب",1,0],["وللمدائحِ يا من شفَّ جوهره","في المكرمات فما تشكو من العرض",10,"ض",1,0],["وللمنيَّة فخّ من هلال دجى","شهب البزاة سواء فيه والرخم",11,"م",1,0],["وللمجد قومٌ ساوروهُ بأنفسٍ","كرامٍ ولم يرضَوْا بأمٍّ ولاَ بأبْ",12,"ب",1,0],["وللموت خير لامرئٍ من نشوره","إذا كان للتخليد في النار يُنشر",13,"ر",1,0],["وللمنافِع إن عُدْ","دَتِ المنافعُ أخْيَلْ",14,"ل",1,0],["وللموفَّقِ تبصيرٌ يُبصِّرهُ","بالحظِّ والناسُ طُرّاً عنهُ عميان",15,"ن",1,0],["وَلِلمَوجِ حَوالَيها","زَئيرُ اللَيثِ ذي الشِبلِ",16,"ل",1,0],["وَلِلمَنِيَّةِ أَسبابٌ تُقَرُّبُها","كَما تَقَرَّبَ لِلوَحشِيَّةِ الذُرُعُ",17,"ع",1,0],["وللمالك حظ في مفاخرها","وللملوك نصيب من معانيها",18,"ي",3,0],["وَلِلمَحرومِ وَالعافي","حَوالَي زادِهِ كُرسي",19,"س",2,0],["وَلِلمُستَعمِرينَ وَإِن أَلانوا","قُلوبٌ كَالحِجارَةِ لا تَرِقُّ",20,"ق",1,0],["وَلِلمُستَعمِرينَ وَإِن أَلانو","قُلوبٌ كَالحِجارَةِ لا تَرِقُّ",21,"ق",1,0],["وَلِلمُهتَدي بِاللَهِ مَجدٌ لَوِ اِرتَقَت","إِلَيهِ النُجومُ رِفعَةً ما تَهَدَّتِ",22,"ت",1,0],["وَلِلمَرءِ يَومُ لا مَحالَةَ مالَهُ","غَدٌ وَسطَ عامٍ ما لَهُ الدَهرَ قابِلُ",23,"ل",1,0],["وللماءِ من حولِنا ضَجَّةٌ","إنِ الماءُ كافحَ تلك العُروبا",24,"ب",2,0],["وَلِلمُهَيمِنِ في حالاتِنا نَظَرٌ","وَفَوقَ تَقديرِنا لِلّهِ تَقديرُ",25,"ر",1,0],["وَلِلمَوتِ داعٍ مُسمِعٌ غَيرَ أَنَّني","أَرى الناسَ عَن داعيهِ في غَفَلاتِ",26,"ت",1,0],["وَلِلمَوتِ عِلّاتٌ تَجَلّى وَتَختَفي","وَلِلدَهرِ وَعدٌ مَرَّةً وَوَعيدُ",27,"د",1,0],["وَلِلمَرءِ عِندَ المَوتِ كَربٌ وَغُصَّةٌ","إِذا مَرَّتِ الساعاتُ قَرَّبنَ بُعدَها",28,"د",3,0],["وَلِلمُعتادِ ما يَجري عَلَيهِ","وَلِلعاداتِ يا هَذا لُزومُ",29,"م",1,0],["وَلِلمُلكِ ميزانٍ يَداكَ طُقيمُهُ","يَزولُ مَعَ الإِحسانِ حَيثُ يَزولُ",30,"ل",1,0],["وَلِلمَنِيَّةِ أَظفارٌ إِذا ظَفِرَت","رَأَيتَ كُلَّ عَميدٍ وَهوَ مَعمودُ",31,"د",1,0],["وللمتنبي غضبةٌ مُضَرِيَّةٌ","وثورةُ مظلومٍ وصيحةُ مستعدي",32,"د",2,0],["وَلِلمُدامِ مُديرٌ","يَشُبُّ جَمرَةَ خَمرَه",33,"ر",2,0],["وَلِلمَدحِ أَلحانٌ تَهُزُّ شَجِيَّةٌ","تُنَسّي بِها المُكّاءَ كُلَّ صَفيرِ",34,"ر",1,0],["وَلِلمُكوسِ تِباعاً لا مَرَدَّ لَها","إِن خابَ مُزدَرعٌ أَو جَفَّ مُرتَزقُ",35,"ق",1,0],["وَلِلمُغَنّي عارِضٌ في حَلقِهِ","وَنَفسُهُ قَد قَدَحَت في حِذقِهِ",36,"ه",1,0],["وَلِلْمَنَادِيلِ فِي أَوْساطِ مَنْ مَلَكُوا","وَلِلْمَنَاطِقِ فيها وَالهمايِينِ",37,"ن",1,0],["وَلِلْمَجَالِسِ في أوْسَاطِها خَرَكٌ","وَلِلطَّنافِسِ في أيَّامِ كانُونِ",37,"ن",1,0],["وَلِلْمَلاَبِسِ كَمْ ثَوْبٍ مُلَوَّنَةٍ","فِيهَا العِرَاقِي مَعَ الهِنْدِيِّ وَالْبَوْني",37,"ن",2,0],["وللمُلْكِ في بغدادَ أن رُدّ حُكمُهُ","إلى عَضُدٍ في غَيرِ كَفٍّ ومِعْصَم",38,"م",1,0],["وَلَلمَوتُ خَيرٌ مِن حَياةٍ عَلى أَذىً","يَضيمُكَ فيهِ صاحِبٌ وَتُراقِبُه",39,"ب",2,1],["وَلِلمَوتِ كَأسٌ تَكرَهُ النَفسُ شُربَها","وَلابُدَّ يَوماً أَن نَكونَ لَها شَربا",40,"ب",2,0],["وَلِلمَقاديرِ أَحكامٌ إِذا وَقَعَت","بِالهَضبِ مارَ أَو اللُجِّيِّ لَم يَمُرِ",41,"ر",1,0],["وَلِلمَنايا سَعى الساعونَ مُذ خُلِقوا","فَلا تُبالي أَنَصَّ الرَكبُ أَم أَركا",42,"ك",2,0],["وَلِلمَرءِ أَيّامٌ تُعَدُّ وَقَد رَعَت","حِبالُ المَنايا لِلفَتى كُلَّ مَرصَدِ",43,"د",1,0],["وَللموت خير من حياة مهانة","يَرى الحر وجه السوء فيها ويسمع",44,"ع",1,0],["وَللمعيشة أنماطٌ قد اِختلفت","وكل قطر يراعى أهلُه نمطا",45,"ط",2,0],["وللماء الفضيلةُ كلَّ حينٍ","ولا سِيَما إذا اشْتَدّ الأُوَارُ",46,"ر",1,0],["وَلِلْمَحَبَّةِ قَبْلِي سُنَّةٌ سَلَفَتْ","فِي الذَّاهِبِينَ وَلِي فِيمَنْ مَضَى مَثَلُ",47,"ل",1,0],["وَلِلْمَوْتِ أَسْبَابٌ يَنَالُ بِهَا الْفَتَى","فَمَنْ بَاتَ في نَجْدٍ كَمَنْ بَاتَ فِي وَهْدِ",48,"د",1,0],["وَلِلمِياِه أَنِينٌ","تَذُوبُ مِنْهُ الصُّخُورُ",49,"ر",1,0],["وَلِلْمقِيمِينَ حَظُّ النَّازحِينَ فَهُمْ","بَنُوكَ إِنْ قَرُبُوا دَاراً وَإِنْ بَعدوا",50,"د",3,0],["وَلِلْمُنى مِنْ رَاحِهِ مَوْرِدٌ","وَلِلْغِنَى عنْ سَاحِهِ مَصْدَرُ",51,"ر",1,0],["وللمآذن في الفيحاء كاسفة","كخاشع السرو في داجي مقابره",52,"ر",2,0],["وللموفين في الإيمان متجه","ما جاء من مدحهم في محكم السور",53,"ر",1,0],["وللمنحى كي يمدّ يديه","ويعلي ذوائبه لليمام",54,"م",1,0],["وللموفَّقِ تبصيرٌ يُبصّرهُ","بالخطِّ والناسُ طُرٍّا عنهُ عميان",55,"ن",1,0],["وَلِلمَرءِ ذي المَيسورِ خَيرُ مَغَبَّةٍ","مِنَ المَرءِ ذي المَعسورَةِ المُتَرَدِّدِ",56,"د",1,0],["وللمجد أعباء ولكنّها منى","وللمكرمات الغاليات هموم",57,"م",1,0],["وللمكارم اعداء وعنصرهم","للدين ذل وللدنيا مضرات",58,"ت",1,0],["ولِلمَرءِ أيَّامٌ تُعَدُّ وإِنَّهُ","إٍِذَا مَا انقَضَت أَيَامُه انقَضَّ وانقَضَ",59,"ض",1,0],["وللمحابر مما تشتكي لبست","ثوب الحداد وما في نهرها نضبا",60,"ب",2,0],["وللمرء عنوان على ما بقلبهِ","ووَسْمٌ على ما في الضمير يكونُ",61,"ن",1,0],["وللمرء لو كان يُنجى الفر","ر في الأرض مضطرَبٌ واسعُ",62,"ع",1,0],["وللمكايد سيفٌ غيرُ منثلمٍ","وللخدائع رمحٌ غيرُ منادِ",63,"د",1,0],["وَلِلمَجدِ راحاتُهُ وَاللُغوبُ","وَلِلحَمدِ رَوحاتُ