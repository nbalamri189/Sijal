{"poems":[[63,"يوم رذاذ ممسك الحجب","https://www.aldiwan.net/poem51772.html","المنسرح"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54786","الكامل"],[202,"يا رب يوم واضح نضرته","https://www.aldiwan.net/poem51970.html","الكامل"],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[422,"علموا يا سعد جيران الغضا","https://www.aldiwan.net/poem53837.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48505","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203784","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100954","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89525","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201187","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109952","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91351","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205754",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198224","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76696","السريع"],[4728,"الأمل قبلة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176950",""],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[5055,"ضرب الجوازي","https://www.poetsgate.com/ViewPoem.aspx?id=110085",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5455,"الوصية","https://www.poetsgate.com/ViewPoem.aspx?id=213961",""],[5461,"الله اكبر كيف يجرحن العيون","https://www.poetsgate.com/ViewPoem.aspx?id=21939",""],[5512,"عيد الثامن من آذار","https://www.poetsgate.com/ViewPoem.aspx?id=204502",""],[5670,"الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=215243",""],[5848,"لا تخلين زايد","https://www.poetsgate.com/ViewPoem.aspx?id=50593",""]],"verses":[["يومُ رَذاذٍ مُمسَّكُ الحُجُبِ","يَضحَكُ فيه السُّرورُ من كَثَبِ",0,"ب",1,1],["يومَ راهنْتُ في البكاءِ عُيُوناً","فتقَدّمْتُ في عِنانِ السَّباقِ",1,"ق",1,0],["يَوْمٌ رَأَى الرَّاؤُوْنَ مِنْ آيَاتِهِ","بِدْعاً يَرِيبُ السَّمْعُ فِي الإِخْبَارِ",2,"ر",1,0],["يَوْمُ رُزِقْتَ بِهِ حُسَيْناً حَقَّقَتْ","فِيهِ أَمَانِيَّ النَّدَى وَالسُّؤْدَدِ",3,"د",1,0],["يومٌ رشَفْتُ فيه الحمَيّا واللمى","فشربتُ خمرَ زجاجةٍ وأقاح",4,"ح",1,0],["يَؤُمّ رَعِيلَ الغَيْم عَمْدًا وإنّما","يؤمّ خيالاً من سُلَيْمَى ويَجْنُب",5,"ب",1,0],["يَوْمَ راحوا يشتكيهم حُرَقاً","خِضل الأجفان تَحتَ ضُلوعي",6,"ع",2,0],["يومَ رأسِ الحسينِ في الرمحِ والرأ","سُ في الرُّمح بينهم منصوبُ",7,"ب",1,0],["يوم رأى فيه الرعية رحمة ال","باري تجلت في جميل فضائه",8,"ا",3,0],["يوم رامَ الطغاةُ لبنان داراً","ومقراً لكيدهم وممرّا",9,"ر",2,0],["يوم راحت من مصر شمساً ولكن","لمت تغب كالشموس خلفَ الحجاب",10,"ب",1,0],["يَؤُمُّ رِعاناً جارَ وَبرٍ إِذا دَعا","يُجاوِبُهُ فيها ضُباحُ الثَعالِبِ",11,"ب",1,0],["يؤمُّ ربعي جاسوسٌ يلاطفني","وقلبه من فؤاد الصخر منحوت",12,"ت",1,1],["يَومٌ رِكابُ القَيلِ حَلَّ","بربعنا يُثنَى ويُحمَد",13,"د",1,0],["يَومٌ رَأَيت الثريّا في يَدي نَزلت","وَالعَزمَ في وَجلٍ وَالحَزمَ في حذر",14,"ر",1,0],["يوم رضاعي خدعوني","بالبيلا لم يرووني",15,"ي",1,0],["يوم روح البشر بالبشر سرى","وانتحت شمس المعالي حيدرا",16,"ر",2,0],["يومَ رامَ الإلهُ تَلبسُ ثَوباً","لِلعُلا فَحَمِدنَاهُ إذْ ولاكَا",17,"ك",2,0],["يوم رقيق ناثر ناظم","كافوره فوق الربى والبطاح",18,"ح",1,0],["يوم رامت هامتي وامسكت في معصمي","ما حسب قلبي ولو جرحه الدامي دمل !!",19,"ل",1,0],["يوم ربي قد كساك بريش وش لك في ...مكاني","ماتخاف من العقوبه يوم تاتيه ...وتحله",20,"ل",2,0],["يوم ردَّت عينها فيك سبرت","كل ما يخفى على سمع الكشوف",21,"ف",1,0],["يوم رأيتك أزمعت الرحيل به","نفضت فيه من الخل الوفي يدا",22,"د",2,0],["يوم راح وهرجته فيّه تناما","يوم مات وذمته كانت بريّه",23,"ي",2,0],["يوم روّح لي نظر بعينه بهون \"","\" فز له قلبي وصفق وارتعد",24,"د",1,0],["يومٌ ركِبْنا خيلَهُ ، رُمْنَا الوصولَ","إلى الصَّباحِ وقادنا أحرارُ",25,"ر",1,0],["يؤمُّ ربَّ البرايا","بشجوهِ وهْو قائلْ:",26,"ل",1,0],["يوم راحوا وشفت الكون حولي سراب","لا تخلين زايد .... يجلس لحيّله",27,"ل",2,0]]}