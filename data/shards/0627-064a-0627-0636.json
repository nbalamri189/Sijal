{"poems":[[136,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[203,"أيا ضيفا أطال المك","https://www.aldiwan.net/poem45506.html","الهزج"],[203,"أيا ضلوعا قلبها وامق","https://www.aldiwan.net/poem45557.html","السريع"],[347,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[382,"أيا ضابطي شرعِ الكنيسة عنوة","https://www.aldiwan.net/poem59172.html","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122052","الوافر"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76726","الطويل"],[6070,"كَتَبْتُ إليكِ ياعمري","https://www.poetsgate.com/ViewPoem.aspx?id=189820",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""]],"verses":[["أيا ضيغمَ الهيجا وياعيلم الندى","خُلقتَ كريمَ النفس لست ضنينَها",0,"ه",2,0],["أيا ضيفاً أطالَ المك","ثَ حتى قَبُحَ الضيفُ",1,"ف",1,1],["أيا ضلوعاً قلبها وامقُ","ويا عيوناً طرفها رامقُ",2,"ق",1,1],["أيا ضباب حياتي","ألا تحولُ هواءَ",3,"ا",2,1],["أيا ضباب حياتي","لقد أطلت عذابي",3,"ي",1,0],["ايا ضباب حياتي","حقيقتي في خيالي",3,"ي",1,0],["أيا ضابطي شرعِ الكنيسة عَنوةً","فلم حُزتمُ عدلاً وحزتم به عدلا",4,"ل",2,1],["أَيَا ضَوْءَ الصَّبَاحِ أَرْفِقْ بِصَبٍّ","تَسيلُ دُمُوعُهُ في الخَدِّ سَيْلاَ",5,"ل",2,1],["أي اضطرارٍ موجبٌ لعدولنا","عن ظاهرٍ بمحجةٍ بيضاء",6,"ا",2,0],["أيا ضيف لم تنزل فنائي وحده","بَلَى قد نزلت العين والقلب والسمعا",7,"ع",2,0],["أيا ضادُ الهوى همسي","وَدِفءُ الحرفِ أغناني",8,"ن",2,0],["أَيا ضَمِيري.. إنَّني نادِمٌ","فيا لِعِزٍّ يَشْتَهِيهِ الذَّلِيلْ!",9,"ل",1,0]]}