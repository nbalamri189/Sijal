{"poems":[[45,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem9442.html","الكامل"],[102,"بعد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=50191",""],[242,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[276,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[409,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[469,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[473,"يا عذولي في اكتئابي","https://www.aldiwan.net/poem60422.html","مجزوء الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91994","الكامل"],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5431,"جوارح معتلة...","https://www.poetsgate.com/ViewPoem.aspx?id=208901",""]],"verses":[["فَوَمَن أُحِبُّ لَأَعصِيَنَّكَ في الهَوى","قَسَماً بِهِ وَبِحُسنِهِ وَبَهائِهِ",0,"ا",3,0],["فومض السعادة من حوله","كومض الأشعّة حول الضرير",1,"ر",1,0],["فَوَمَا أَسْأَرْتُمُ فِي الْحَشَا","إِذْ سَقَانَا الوُدُّ رَاحاً بِراحْ",2,"ح",1,0],["فومن أَحن الى زيارة سوحه","لا كفرن خَطيئَتي بمديحه",3,"ه",1,0],["فَوَمَنْ أَحب لأعصيَّن عواذلي","قسماً به في أرضه وسمائه",4,"ا",3,0],["فومضانِ من قرطٍ وبرق غمامةٍ","وصوبان من سحبٍ بها ودموع",5,"ع",1,0],["فَوَ مَن رَدّاهُ بِالحُس","نِ عَلى ثَوبِ الشَبابِ",6,"ب",1,0],["فَوميضُ بارقِ جوِّها زفراتها","لهفاً وَصَوتُ الراعدات أَنين",7,"ن",1,0],["فومن حباني الفصل من أنفاله","فذهلت بالإكرام عن شكرانه",8,"ن",2,0],["فوميضُ برق يديك خزّنه","كي يحرقَ الآهات بالجملة",9,"ل",2,0]]}