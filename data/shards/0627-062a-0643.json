{"poems":[[29,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[63,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[68,"أتكرمني سرا وتثلمني جهرا","https://www.aldiwan.net/poem38753.html","الطويل"],[107,"وزير الأمن مات الناس خوفا","https://www.aldiwan.net/poem43064.html","الوافر"],[48,"غبقنا الأذى والجاشرية همنا","https://www.aldiwan.net/poem22647.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2126","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[108,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[29,"أهَاج البَرْقُ لَيْلَة أذْرِعاتٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16344&r=&rc=8",""],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[237,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[302,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[333,"ذهبت عنك يا حزين الهموم","https://www.aldiwan.net/poem54936.html","الخفيف"],[406,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[422,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[458,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[463,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[510,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[534,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2431","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96990","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100581","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119920","الكامل"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116652","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124618","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20537","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131208",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136949",""],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21528","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67653","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72483","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72482","الكامل"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114612","الكامل"],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[4858,"إلى فتى برقين","https://www.poetsgate.com/ViewPoem.aspx?id=158440",""],[4869,"اللي يشوفك يحبك","https://www.poetsgate.com/ViewPoem.aspx?id=151629",""],[585,"هي رحلةُ قد أرهقتك ذميلا","https://www.poetsgate.com/ViewPoem.aspx?id=161880",""],[5106,"في روحه قمر تناثر من قمر","https://www.poetsgate.com/ViewPoem.aspx?id=150037",""],[5121,"غَرَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=94049",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5296,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=155187",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5616,"سَلِّمْ عَلَيْهَا","https://www.poetsgate.com/ViewPoem.aspx?id=204587",""],[5628,"الوثنيون المتوحشون","https://www.poetsgate.com/ViewPoem.aspx?id=178537",""],[5703,"ياشاهر السيف","https://www.poetsgate.com/ViewPoem.aspx?id=206123",""],[5725,"كبائر عينيها","https://www.poetsgate.com/ViewPoem.aspx?id=210282",""],[5736,"صباحي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203894",""],[5906,"مَشَقة نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=188069",""],[5956,"أ تكون لي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=181996",""],[5956,"أقضي الحياة بدون زوجي تاعسا","https://www.poetsgate.com/ViewPoem.aspx?id=182409",""],[5956,"الموج يعزف لحنه ويجيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183296",""],[6314,"المهدية المنتظِرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88075&r=&rc=10",""],[5126,"روض وشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87814&r=&rc=29",""]],"verses":[["أَتَكفُرُ مَن يُجيرُكَ يا اِبنَ تَيمٍ","وَمَن تَرعى بِقَودِهُمُ السَحابا",0,"ب",2,0],["أَتكتُمُ أسرارَ الهَوى أَم تُذيعُها","وتَحفَظُها بعدَ النَّوى أَم تُضيعُها",1,"ع",3,1],["أَتُكَرِّمُني سِرّاً وَتَثلِمُني جَهراً","لَعَمرُكَ هَذا حالُ مَن أَضمَرَ الغَدرَ",2,"ر",1,1],["أَتَكرَهُ أَن تَسودَ وَأَن تَراها","بِمَنزِلَةِ الطَليقِ مِنَ الوِصايَهْ",3,"ا",3,0],["أَتَكتُبُ سَطراً لَيسَ فيهِ تَخَوُّفٌ","لِرَبِّكَ ما أَولى بَنانَكَ بِالأَشرِ",4,"ر",1,0],["أَتَكْبُرُ الصُّغْرَى لَدَيْهِ وَفِي","سَاحَاِتِه يُغْتَفَرُ الْوِزْرُ",5,"ر",1,0],["أَتُكرِهُني هُبِلتَ عَلى دُرَيدٍ","وَقَد أُحرِمتُ سَيِّدَ آلِ بَدرِ",6,"ر",1,0],["أتكلم الفصحى أمام عشيرتي","وأعيد لكن ما هناك جواب",7,"ب",1,0],["أتكلِّفون الأسْدَ غَيْرَ طباعها","وتروَّضون جماحها لتلينا؟",8,"ن",2,0],["أَتَكُفُّ غَدَاً؟ مَنْ يُدْرِيْنِيْ","مَاذَا سَأَبِيْعُ وَمَا أَشْرِيْ",9,"ر",2,0],["أتكفرُ منْ يجيركَ يا بن تيمٍ","وَمَنْ تَرْعى بقَوْدهمُ السّحابَا",10,"ب",2,0],["أَتَكونينَ ذلكَ المَلَكَ البا","قي وَلَو جاءَ مِن جَهَنَّمَ خَطبُ",11,"ب",1,0],["أَتَكونينَ فيهِ ما لَم تَكُن أُن","ثى وَما لَم يَكُن مِن الناسِ حُبُّ",11,"ب",1,0],["أَتَكَلَّفُ الإِعراضَ عَنكَ مَخافَةَ ال","واشي إِلى كَم جَهدَ ما أَتَكَلَّفُ",12,"ف",1,0],["أَتَكتَحل الأَجفانُ بعدَك بالكرى","سلوّاً وتفترُّ الثغورُ من الضِحكِ",13,"ك",1,0],["أت كالناس ما وصلت حبا","لك إن قائدا لهم أو مقودا",14,"د",2,0],["أتكون جدَّةُ غيرَ كلِّ مدينةٍ","والمسكُ فيها يقتل الأزهارا؟!",15,"ر",2,0],["أتكتم فضلك الحسَّاد جهلاً","وما اسطاع الدُّجى للنور كتما",16,"م",2,0],["أتكرمون صغارا كل قيمتهم","زيف وليس لهم صدق وغيمان",17,"ن",1,0],["أتكتُمُ يومَ بانةَ أم تبوحُ","وأجدرُ لو تبوحُ فتستريحُ",18,"ح",1,1],["أتكنزها بيضا وصفرا ولم تزل","تصوغ حليا مسرفاً فيه جايرا",19,"ر",2,0],["أتكونُ الارضُ ارتقتْ ام تراهُ","صِبغةً أخرى من صِبَغِ الفسادِ",20,"د",1,0],["أَتَكْذِبُ جَهْراً لا أبالَكَ عامِداً","وتَأْكُلُ سُحْتاً بئْس طُعْمَةُ طاعِمِ",21,"م",1,0],["أَتَكني عَن رُقَيَّةَ أَم تَبوحُ","وَمِن تَبَعِ الهَوى حَيناً فُضوحُ",22,"ح",1,1],["اتكون في ذى الحال نوتكم وهن","سمون أخلاقا وطبن عناصرا",23,"ر",2,0],["أتكثر في الأبصار هذي الثواقب","وتعظم للوراد هذي المشارب",24,"ب",1,1],["أتكحل عين من أمية في الكرى","ولم تكتحل بالطعن في السمر والقصف",25,"ف",1,0],["أتكلف السلوان مجتهدا","عنهم وأنساه إذا ذكروا",26,"ر",3,0],["اتكذب العين والرايات خافقة","ام تكذب الاذن والدنيا اغاريد",27,"د",1,0],["أتكلم وجهي لا أباً لأبيكُمُ","مطامِعُ عنها للكرامِ مَحِيصُ",28,"ص",1,0],["أتَكُونُ خَردَلَةٌ تُسَاوِي الطَّودَ فِي ال","أجزَاء فِي شَيءٍ مِنَ الأذهَانِ",29,"ن",1,0],["أتَكُونُ أوصَافُ الكَمَالِ نَقِيصَةً","فِي أيِّ عَقلٍ ذَاكَ أم قُرآنِ",29,"ن",1,0],["إتَّكِ إذ قَابَلتَهَا قَلِيلاً","حَتَّى تَجيءَ التِّيرَ والإِكلِيلا",30,"ل",2,0],["أتكره ان تلقى الذي قط لم تنَل","إلىً دونه بل لست عوضُ بنائل",31,"ل",1,0],["أَتكلَّف السُّلوانَ وهو يَعُزُّنِي","إن السلوَّ عن الأحبة يَعْزُب",32,"ب",1,0],["أَتُكتَمُ حُيِّيتُم عَلى النَأي تُكتَما","تَحيَّةَ مَن أَمسى بِحُبِّكِ مُغرَما",33,"م",2,1],["اتكون فاتحها ووارد نيلها","وهي العرينة قد حماها الضيغم",34,"م",1,0],["أتكون رباً واحداً صمداً","وتعدد الأديان في البشر",35,"ر",1,0],["أَتَكذِبُ في البُكاء وأَنت خِلوٌ","قَديماً ما جَسَرتَ عَلى الذُنوبِ",36,"ب",1,0],["أتكرَهُ جنّاتٍ وتهوى جهنَّماً","وتمقت رضواناً وترضى بسخطةِ",37,"ه",1,0],["أتكون في القومِ الذين تأخَّروا","عن حظهم أم في الذين تقدّموا",38,"م",3,0],["أتكمل الفاني وتترك باقيا","هملا وأنت بأمره لم تحفل",39,"ل",1,0],["اتكمل الفاني وتترك باقيا","تكميله أولى بحق الاكمل",40,"ل",1,0],["اتكون اسماعيل انت ويغتذي","بالصيد ابراهيم فيك ذبيحا",41,"ح",2,0],["أتكونُ الرّحمةُ في قلبٍ","إلاّ والطّفْلُ لها شَطْرُ؟!",42,"ر",1,0],["أتكونُ نارُ الكافرينَ لنا هُدىً","والنورُ في القرآنِ جِدُّ مُبينِ",43,"ن",1,0],["اتكلم وخل المشاعر تهبك","ابسمعك واشوف حبك بنونك",44,"ك",1,0],["أتكون دنيا الخلق ما زعموا لها","آليةً فتبذهم تضليلا",45,"ل",2,0],["آتٍ كَمَاْ تَأْتِيْ السَّحَاْبَةُ عَنْ رِضَىْ","فِيْهِ صَفَاْءُ الْماْءِ جُمِّعَ مِنْ قُطَرْ",46,"ر",1,0],["أَتَكُرُّ لِوَحْدِكَ يَاغَرَرُ ؟","وَالْخَيْلُ بِشِعْرِي تَسْتَتِرُ !!",47,"ر",1,1],["أتكسرها فتخرقك العجوز1","وتحرثها فتدفنك العجوز2",48,"ز",1,1],["أتكون صاحب مَبْدإٍ","وأراك فيه جبانا",49,"ن",2,0],["أتكون صاحب صولةٍ","وتصيرُ ... ما أدرانا",49,"ن",2,0],["أتكسر كف البغي أضلع فاطم","وما أصلح الإسلام منها انجبارها",50,"ر",3,0],["اتَكْسَرُ قَلْبِي ثُمَّ تَعْبرُ فَوْقَهُ","وَكَانَتْ عَلَى الأَشْهَادِ تُوسِعُنِي لَثْمَا؟!",51,"م",2,0],["أتكبّرون وتدّعون بأنّكمْ","عرب .. متى العربيُّ كان زنيما",52,"م",2,0],["أتكتبُ الشِّعرَ أمْ سحراً تُسطّرهُ","في قلبِ عاشقةٍ تشتاقُ رؤياكا",53,"ك",2,0],["أتكظم كالأشجار ما كنت شاكيا","وتفضح مأساة الغرام النواظرُ",54,"ر",1,0],["أتكفيكَ السنينُ إليكَ تهدى؟","سنينُ العمرِ للغالِي وشاحُ",55,"ح",1,0],["أَتَكْفي نَظْرَةٌ وَ عُيونُ قَلْبي","تَهيمُ ، وَ لَيلُها مَلََّ انْشِغالي",56,"ل",2,0],["أ تكون لي لأكون أسعدَ كائن؟","أم سوف أبقى في جحيم جفائها؟",57,"ا",3,1],["أتكبد المنأى بدون إرادة","منِّي فهل جئتُ الحياة لأتعسا؟",58,"س",2,0],["أ تَكوَّنَ البحرُ الجميل من الغنا","فيكاد لا يهْدا لديه نشيدُ؟",59,"د",1,0],["أتكهَّن المعنى بعينكِ نشوةً","حتى أكاد لهوله أتصوَّفُ",60,"ف",1,0],["أتكسِفُ شمسٌ أنت ترعى طلوعَها؟","إذاً خان مظلومُ الدعاوى وظالمُهْ",61,"م",2,0]]}