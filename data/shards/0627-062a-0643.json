{"poems":[[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[66,"أتكرمني سرا وتثلمني جهرا","https://www.aldiwan.net/poem38753.html","الطويل"],[105,"وزير الأمن مات الناس خوفا","https://www.aldiwan.net/poem43064.html","الوافر"],[46,"غبقنا الأذى والجاشرية همنا","https://www.aldiwan.net/poem22647.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2126","الوافر"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[27,"أهَاج البَرْقُ لَيْلَة أذْرِعاتٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16344&r=&rc=8",""],[223,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[232,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[297,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[328,"ذهبت عنك يا حزين الهموم","https://www.aldiwan.net/poem54936.html","الخفيف"],[400,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[416,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[453,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[458,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[463,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[505,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[529,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"]],"verses":[["أَتَكفُرُ مَن يُجيرُكَ يا اِبنَ تَيمٍ","وَمَن تَرعى بِقَودِهُمُ السَحابا",0,"ب",2,0],["أَتكتُمُ أسرارَ الهَوى أَم تُذيعُها","وتَحفَظُها بعدَ النَّوى أَم تُضيعُها",1,"ع",3,1],["أَتُكَرِّمُني سِرّاً وَتَثلِمُني جَهراً","لَعَمرُكَ هَذا حالُ مَن أَضمَرَ الغَدرَ",2,"ر",1,1],["أَتَكرَهُ أَن تَسودَ وَأَن تَراها","بِمَنزِلَةِ الطَليقِ مِنَ الوِصايَهْ",3,"ا",3,0],["أَتَكتُبُ سَطراً لَيسَ فيهِ تَخَوُّفٌ","لِرَبِّكَ ما أَولى بَنانَكَ بِالأَشرِ",4,"ر",1,0],["أَتَكْبُرُ الصُّغْرَى لَدَيْهِ وَفِي","سَاحَاِتِه يُغْتَفَرُ الْوِزْرُ",5,"ر",1,0],["أَتُكرِهُني هُبِلتَ عَلى دُرَيدٍ","وَقَد أُحرِمتُ سَيِّدَ آلِ بَدرِ",6,"ر",1,0],["أتكلم الفصحى أمام عشيرتي","وأعيد لكن ما هناك جواب",7,"ب",1,0],["أتكلِّفون الأسْدَ غَيْرَ طباعها","وتروَّضون جماحها لتلينا؟",8,"ن",2,0],["أَتَكُفُّ غَدَاً؟ مَنْ يُدْرِيْنِيْ","مَاذَا سَأَبِيْعُ وَمَا أَشْرِيْ",9,"ر",2,0],["أتكفرُ منْ يجيركَ يا بن تيمٍ","وَمَنْ تَرْعى بقَوْدهمُ السّحابَا",10,"ب",2,0],["أَتَكونينَ ذلكَ المَلَكَ البا","قي وَلَو جاءَ مِن جَهَنَّمَ خَطبُ",11,"ب",1,0],["أَتَكونينَ فيهِ ما لَم تَكُن أُن","ثى وَما لَم يَكُن مِن الناسِ حُبُّ",11,"ب",1,0],["أَتَكَلَّفُ الإِعراضَ عَنكَ مَخافَةَ ال","واشي إِلى كَم جَهدَ ما أَتَكَلَّفُ",12,"ف",1,0],["أَتَكتَحل الأَجفانُ بعدَك بالكرى","سلوّاً وتفترُّ الثغورُ من الضِحكِ",13,"ك",1,0],["أت كالناس ما وصلت حبا","لك إن قائدا لهم أو مقودا",14,"د",2,0],["أتكون جدَّةُ غيرَ كلِّ مدينةٍ","والمسكُ فيها يقتل الأزهارا؟!",15,"ر",2,0],["أتكتم فضلك الحسَّاد جهلاً","وما اسطاع الدُّجى للنور كتما",16,"م",2,0],["أتكرمون صغارا كل قيمتهم","زيف وليس لهم صدق وغيمان",17,"ن",1,0],["أتكتُمُ يومَ بانةَ أم تبوحُ","وأجدرُ لو تبوحُ فتستريحُ",18,"ح",1,1],["أتكنزها بيضا وصفرا ولم تزل","تصوغ حليا مسرفاً فيه جايرا",19,"ر",2,0],["أتكونُ الارضُ ارتقتْ ام تراهُ","صِبغةً أخرى من صِبَغِ الفسادِ",20,"د",1,0],["أَتَكْذِبُ جَهْراً لا أبالَكَ عامِداً","وتَأْكُلُ سُحْتاً بئْس طُعْمَةُ طاعِمِ",21,"م",1,0]]}