سِ وَجَوٍّ حَكى بُطونَ البُزاةِ",4,"ه",1,0],["بَينَ رِماحٍ وَسُيوفٍ جَمَّه","يَسوقُ بِالنَبِيِّ هادي الأُمَّة",5,"م",2,0],["بَينَ راحٍ وَمِزهَرٍ","وَغِناءٍ شَفا الصَدا",6,"د",2,0],["بَينَ رِواقِ المُلكِ وَالحِجابِ","مِثلَ الهُمامِ في ظِلالِ الغابِ",7,"ب",1,0],["بين راحٍ وروضةٍ وغدير","وحِسانٍ مضَى زمانُ الْحِسان",8,"ن",1,0],["بين رجلي وطريقي ، جثتي","بين كّفي وفمي ، عنف المسافه",9,"ف",2,0],["بين رياض أقلعتْ عنها دَيمْ","وأعقبتْها بعدها عُقبى وَهَم",10,"م",1,0],["بين رهط شمَّ العرانين ينفي ال","عنى حديثهم والكروبا",11,"ب",2,0],["بين رياض يشكر الصاحي بها","ظل مديد وهواء مستمر",12,"ر",1,0],["بين رعدٍ قاصفٍ","في إثرِ برقٍ مستطير",13,"ر",1,0],["بين ركب المنون عشت وما زل","ت ترينَ السموم كالترياق",14,"ق",1,0],["بين رياضٍ وغُدُر","أَوديةً حُوَّ السُّرَر",15,"ر",1,0],["بين روضٍ آخذٍ زينَته","ولسانِ البَمِّ والزِّير فصيحْ",16,"ح",1,0],["بَيْنَ ريحٍ من المزَامِيرِ أَسْرَى","بَيْنَ أَجسامِنا مع الأَرْواح",17,"ح",1,0],["بينَ رجال كمَنتْ فضائلي","عنهم كُمون النار في زنادِها",18,"د",3,0],["بَينَ رُبىً تَنفَحُنا النَدَّ مِن","مَجمَرَةٍ مِنها وَكِمِّيَّه",19,"ي",2,0],["بَينَ رِياضِ مُزَخرَفاتٍ","لِلماءِ في خُلجِها اِختِلاجُ",20,"ج",1,0],["بين ربي وبينه فارفعوها","بعلوم السما يكون الوصول",21,"ل",1,0],["بين رِئم الحِمَى وآرامِ رامَهْ","حَربُ بدرٍ فهل علينا مَلامَهْ",22,"م",2,1],["بِيْنَ رَئِيْسٍ إِلَى نَفِيْسٍ","قَدْ أَكْمَلَ الظَّرْفَ وَاسْتَتَمَّهْ",23,"م",2,0],["بين ركنَيه تبدَّت ساعةٌ","سوف تحصي كلَّ أعمارِ الامم",24,"م",1,0],["بين رياضٍ كلّها","في حُللٍ مُكتَّبه",25,"ب",2,0],["بينَ ربْداءَ كالمِظلّةِ أُفقٍ","وظليمٍ معَ الظَّليمِ حمارُ",26,"ر",1,0],["بين رامٍ ورامح وأخا درْ","ع وحر وطامع في نهاب",27,"ب",1,0],["بَينَ رِماحَي مالِكٍ وَنَهشَلِ","يَدفَعُ عَنها العِزُّ جَهلَ الجُهَّلِ",28,"ل",1,0],["بين روَضٍ من الجمال أنيق","تحتَ غيث من السَّماحِ سَكوبِ",29,"ب",1,0],["بين رضيع ورضيع آخر","قد زيد شرط للرضاع الناشر",30,"ر",1,0],["بَينَ رذيِّ الرَهَبِ المُقصَدِ ال","مُخَّ المُباري خَدَمَ المُنعَلِ",31,"ل",1,0],["بين رهبٍ وذلةٍ وخشوعٍ","خفَقَ القلبُ خفقةَ الحيرانِ",32,"ن",1,0],["بين روض مدبج وغصون","تتثنى كشاربات المدام",33,"م",1,0],["بَينَ رُؤيا تَجيءُ مثلَ سَنا الصُبحِ","وَرُؤيا أُخرى تَجيء خَيالا",34,"ل",2,0],["بينَ رَدفي وبينَ خَصرِيَ فَرقٌ","مثلَ فَرْق لِرِقّةٍ لا يَبينُ",35,"ن",1,0],["بَينَ رَوض يَخاله الطرف تبراً","قائِماً في سبيكة خضراء",36,"ا",2,0],["بين روحي وبين جسمي الأسيرِ","كان بُعدٌّ ذقتُ مُرّه",37,"ر",2,1],["بَينَ رُحماهُ وَسَطوَتِهِ","نِقَمُ الدُنيا وَأَنعُمُها",38,"م",3,0],["بَيْنَ ركب ورفقةٍ تَتعاطَى","كأسَ صفوٍ لا كؤوسَ المُخامر",39,"ر",1,0],["بَينَ رَوضٍ كُلَّ غُصنٍ اَلف","مِنهُ وَالوَرقاءُ فَوقَ الغُصنِ هَمزَه",40,"ز",2,0],["بين رياض","للماء في خُلجِها اختلاجُ",41,"ج",1,0],["بين رحمة اليهود وعذاب من المجوس","ليت للمعتصم اليوم صوتٍ يسمعه",42,"ع",2,0],["بين روع القلب أو رُوع اللقا","خلف مسرى آيه في الساديات",43,"ت",1,0],["بين رعديد قبيح قد غدونا","وحقير حامل سيف انتقام",44,"م",1,0],["بين رجوى الغريب وبين ضغط الأهل","لا حصل لي صعود ولا حصل لي نزول",45,"ل",1,1],["بَينَ رِمشَيكِ مُقلَةٌ مَا استَدارَتْ","وَمَضَ الضَّوءُ فِي الفَضاءِ فَأَبرَقْ",46,"ق",1,0],["بينَ رئيسٍ إلى أديبٍ","قد أكملَ الظَّرفَ واستَتَمَّهْ",47,"م",2,0]]}