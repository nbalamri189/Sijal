{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[88,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[51,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[92,"عجبا لي أود أن أفهم الكون","https://www.aldiwan.net/poem38932.html","الخفيف"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[21,"إن آيات ربنا باقيات","https://www.aldiwan.net/poem36199.html","الخفيف"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[45,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[155,"لست أنسى مقالها لي ودمعي","https://www.aldiwan.net/poem55687.html","الخفيف"],[174,"كل داع سواي غير مجاب","https://www.aldiwan.net/poem46060.html","الخفيف"],[185,"يا بنى الهالكين هل من وقاء","https://www.aldiwan.net/poem14082.html","الخفيف"],[199,"كوكب أبدلته ايديي الليالي","https://www.aldiwan.net/poem45366.html","الخفيف"],[328,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[416,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[443,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[458,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[551,"لا تسلني عما أراه فإني","https://www.aldiwan.net/poem48071.html","الخفيف"],[558,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"]],"verses":[["كُلُّ دَهماءَ تَرى القَطرَ بِها","مِن لُجَينٍ وَتَرى البَرقَ نُضارا",0,"ر",2,0],["كل دنياً وآخره","ونفت كل ما استقر",1,"ر",1,0],["كل داع لعليٍّ","إنما يدعو لنفسِهْ",2,"س",2,1],["كُلُّ دَهْرٍ يَمُرُّ يفجعُ قلبي","ليتَ شعري أَيْنَ الزَّمان المؤَسِّي",3,"س",2,0],["كل داء فانه لاصطياد الروح منا","ضرب من الاوها",4,"ه",2,0],["كُلُّ دارٍ أَحَقُّ بِالأَهلِ إِلّا","في خَبيثٍ مِنَ المَذاهِبِ رِجسِ",5,"س",1,0],["كُلِّ دَمعٍ يَسيلُ مِنها عَلَيها","وَبِفَكِّ اليَدَينِ عَنها تُخَلّى",6,"ل",2,0],["كُلُّ دَهرٍ نُنبى بِهِ أَو نَراهُ","مُخبِرٌ مِن سَراتِكُم عَن عَميدِه",7,"د",2,0],["كُلُّ داءٍ يُرجى الدَواءُ لَهُ إِل","لا الفَظيعَينِ ميتَةً وَمَشيبا",8,"ب",2,0],["كُلُ دينٍَ يَومَ القيامَةَ عِندَ","اللَهِ إِلاّ دينٍ الحَنيفَةِ زورُ",9,"ر",1,0],["كُلُّ دارٍ لَها وَظيفَةُ دَمعٍ","مِن جُفوني حَتّى تَكِلَّ المَطِيُّ",10,"ي",1,0],["كُلُّ داءٍ لهُ دواءٌ فَعَجِّلْ","بَمُداوَاةِ داءِ عُضْوٍ خَطِيرِ",11,"ر",1,0],["كُلُّ دِينٍ قِوَامُهُ بِرَسُولٍ","وَلِكُلٍ مِنَ السَّجَايَا رَسُولُ",12,"ل",1,0],["كُلٌّ دَعَاهُ الشَّوْقُ فانْتَهَبَ الْخُطَا","في نَظْرَةٍ تَشْفِيه مِنْ بُرَحَائه",13,"ا",3,0],["كُلُّ دَهْرٍ قَدْ ننبا به، أوْ نَرَاهُ،","مُخبرٌ مِنْ سَراتِكْمْ عن عَميدِهْ",14,"د",2,0],["كُلُّ دَمْعٍ فَبِالتَّكَلُّفِ يجري","غيرَ دَمْعِ الغَريبِ وَالمَهْجورِ",15,"ر",1,0],["كُلُّ دَاعٍ سِوَاي غَيْرُ مُجَابِ","وَعَذَابُ الْهَوى أَشَدُّ عَذابِ",16,"ب",1,1],["كلُّ داءٍ له دَواءٌ وقد أَعْ","جَز داءُ المَنونِ كلَّ دواء",17,"ا",2,0],["كلُّ دارٍ تدورُ فيها أراها","غضةً ذاتَ بهجةٍ وجمالِ",18,"ل",1,0],["كلّ دنياي لذّةٌ وجمالٌ","وانبعاثٌ إلى الهوى والمتاع",19,"ع",1,0],["كلّ دارٍ حلَّ فيها ابتهجتْ","وحَلَتْ حينئذٍ دار السَّلام",20,"م",1,0],["كل دن يصب فيه حتيت ال","در حتى يظن في غليان",21,"ن",1,0],["كلُّ دعاءٍ يرفعون فله","ما كان منه بالقبول مرتهَنْ",22,"ن",1,0],["كلُّ دَلْو ٍ بها لَه ُ رِئَة ٌ","وَحْدَها بالدّموع ِتَنفَرِد ُ",23,"د",1,0],["كُلّ داءٍ في القَلبِ منّي وَفي الجِس","مِ عَلى أَنَّني عَدِمتُ الطَّبيبا",24,"ب",2,0],["كل دينٍ إن فاتك الإسلامُ","فمحالٌ لأنه أوهامُ",25,"م",1,1]]}