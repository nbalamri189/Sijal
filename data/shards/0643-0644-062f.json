{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[90,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[53,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[94,"عجبا لي أود أن أفهم الكون","https://www.aldiwan.net/poem38932.html","الخفيف"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[45,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[47,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[21,"إن آيات ربنا باقيات","https://www.aldiwan.net/poem36199.html","الخفيف"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[69,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[47,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[159,"لست أنسى مقالها لي ودمعي","https://www.aldiwan.net/poem55687.html","الخفيف"],[178,"كل داع سواي غير مجاب","https://www.aldiwan.net/poem46060.html","الخفيف"],[189,"يا بنى الهالكين هل من وقاء","https://www.aldiwan.net/poem14082.html","الخفيف"],[203,"كوكب أبدلته ايديي الليالي","https://www.aldiwan.net/poem45366.html","الخفيف"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[449,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[463,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[556,"لا تسلني عما أراه فإني","https://www.aldiwan.net/poem48071.html","الخفيف"],[563,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37882","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95534","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105664","الخفيف"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137445",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204664","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139901","الكامل"],[3533,"","https://poetry.dctabudhabi.ae/diwan/poem/145896","المديد"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108140","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93278","الخفيف"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124303","الخفيف"],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4750,"كل دار أرجعت وأنا سناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180447",""],[5002,"بلسم الأرواح....","https://www.poetsgate.com/ViewPoem.aspx?id=214825",""],[5012,"تدري إنك غير كل الناس والله","https://www.poetsgate.com/ViewPoem.aspx?id=24308",""],[5038,"كم قريب","https://www.poetsgate.com/ViewPoem.aspx?id=189379",""],[3591,"يعبس الدهر ثم يبسم حيناً","https://www.poetsgate.com/ViewPoem.aspx?id=149406",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5409,"يا شبابي لم يصبني لك ذكر","https://www.poetsgate.com/ViewPoem.aspx?id=155268",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5848,"جوالي وسماعته","https://www.poetsgate.com/ViewPoem.aspx?id=52030",""],[5956,"الأديان والمذاهب والطوائف","https://www.poetsgate.com/ViewPoem.aspx?id=192181",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6004,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=33679",""],[6124,"خانت غنائي","https://www.poetsgate.com/ViewPoem.aspx?id=194521",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6251,"الهديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76469&r=&rc=9",""],[6273,"دانة النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78508&r=&rc=6",""]],"verses":[["كُلُّ دَهماءَ تَرى القَطرَ بِها","مِن لُجَينٍ وَتَرى البَرقَ نُضارا",0,"ر",2,0],["كل دنياً وآخره","ونفت كل ما استقر",1,"ر",1,0],["كل داع لعليٍّ","إنما يدعو لنفسِهْ",2,"س",2,1],["كُلُّ دَهْرٍ يَمُرُّ يفجعُ قلبي","ليتَ شعري أَيْنَ الزَّمان المؤَسِّي",3,"س",2,0],["كل داء فانه لاصطياد الروح منا","ضرب من الاوها",4,"ه",2,0],["كُلُّ دارٍ أَحَقُّ بِالأَهلِ إِلّا","في خَبيثٍ مِنَ المَذاهِبِ رِجسِ",5,"س",1,0],["كُلِّ دَمعٍ يَسيلُ مِنها عَلَيها","وَبِفَكِّ اليَدَينِ عَنها تُخَلّى",6,"ل",2,0],["كُلُّ دَهرٍ نُنبى بِهِ أَو نَراهُ","مُخبِرٌ مِن سَراتِكُم عَن عَميدِه",7,"د",2,0],["كُلُّ داءٍ يُرجى الدَواءُ لَهُ إِل","لا الفَظيعَينِ ميتَةً وَمَشيبا",8,"ب",2,0],["كُلُ دينٍَ يَومَ القيامَةَ عِندَ","اللَهِ إِلاّ دينٍ الحَنيفَةِ زورُ",9,"ر",1,0],["كُلُّ دارٍ لَها وَظيفَةُ دَمعٍ","مِن جُفوني حَتّى تَكِلَّ المَطِيُّ",10,"ي",1,0],["كُلُّ داءٍ لهُ دواءٌ فَعَجِّلْ","بَمُداوَاةِ داءِ عُضْوٍ خَطِيرِ",11,"ر",1,0],["كُلُّ دِينٍ قِوَامُهُ بِرَسُولٍ","وَلِكُلٍ مِنَ السَّجَايَا رَسُولُ",12,"ل",1,0],["كُلٌّ دَعَاهُ الشَّوْقُ فانْتَهَبَ الْخُطَا","في نَظْرَةٍ تَشْفِيه مِنْ بُرَحَائه",13,"ا",3,0],["كل دور رقص الدهر له","ضايق العالم وارتاد القمر",14,"ر",1,0],["كُلُّ دَهْرٍ قَدْ ننبا به، أوْ نَرَاهُ،","مُخبرٌ مِنْ سَراتِكْمْ عن عَميدِهْ",15,"د",2,0],["كُلُّ دَمْعٍ فَبِالتَّكَلُّفِ يجري","غيرَ دَمْعِ الغَريبِ وَالمَهْجورِ",16,"ر",1,0],["كُلُّ دَاعٍ سِوَاي غَيْرُ مُجَابِ","وَعَذَابُ الْهَوى أَشَدُّ عَذابِ",17,"ب",1,1],["كلُّ داءٍ له دَواءٌ وقد أَعْ","جَز داءُ المَنونِ كلَّ دواء",18,"ا",2,0],["كلُّ دارٍ تدورُ فيها أراها","غضةً ذاتَ بهجةٍ وجمالِ",19,"ل",1,0],["كلّ دنياي لذّةٌ وجمالٌ","وانبعاثٌ إلى الهوى والمتاع",20,"ع",1,0],["كلّ دارٍ حلَّ فيها ابتهجتْ","وحَلَتْ حينئذٍ دار السَّلام",21,"م",1,0],["كل دن يصب فيه حتيت ال","در حتى يظن في غليان",22,"ن",1,0],["كلُّ دعاءٍ يرفعون فله","ما كان منه بالقبول مرتهَنْ",23,"ن",1,0],["كلُّ دَلْو ٍ بها لَه ُ رِئَة ٌ","وَحْدَها بالدّموع ِتَنفَرِد ُ",24,"د",1,0],["كُلّ داءٍ في القَلبِ منّي وَفي الجِس","مِ عَلى أَنَّني عَدِمتُ الطَّبيبا",25,"ب",2,0],["كل دينٍ إن فاتك الإسلامُ","فمحالٌ لأنه أوهامُ",26,"م",1,1],["كُلُّ دَعْوى مِنَ الفَخارِ اِدّعاها","فَعَلَيها العَلياءُ خيرُ شُهودِ",27,"د",1,0],["كل دور دار لا بدّ لهُ","من عزيزٍ والفتى الحرّ عزيزْ",28,"ز",1,0],["كل داء فى الورى يأسوهُ طبِّ","غير داء الموت يأبى السَّلما",29,"م",2,0],["كلُّ داء يفرُّ منك مَهيضاً","راعَه منك حكمةٌ قمساٌ",30,"ا",1,0],["كل دهر تعي البرية منه","تلك آيات فضلة وتراها",31,"ا",3,0],["كلُّ دمعٍ منها يسيلُ عليها","وتولى إذا تصعد الحوباء",32,"ا",2,0],["كل دار قد أصبحت من أذاهم","كربلا فهي في بلاء وكرب",33,"ب",1,0],["كل درس يفنى ودرس المغنى","أتقنته أهل السماء خير درس",34,"س",1,0],["كل دهانا به الدهر الخؤون وقد","أضحت غصون المعالي بعد لم تمد",35,"د",1,0],["كل داع حية ذات التقام","فل مع الحيات كم هذا المقام",36,"م",1,0],["كل داء له دوا جعل الله","وأبقى دائي بدون دواء",37,"ا",2,0],["كلُّ دار بلى تمرُّ برسمها","دار خولةَ فاندبنّ ولا تسلْ",38,"ل",1,0],["كل دمع صانه كلف","فهو يوم البين مبتذل",39,"ل",1,0],["كل دار يبين عنها الفتى تص","بح أغلى في عينه وأحبَّا",40,"ب",2,1],["كلُّ داءٍ لهُ دواءٌ ولكن","داءُ حُبّ النفوس داءٌ عُضَالُ",41,"ل",1,0],["كلُّ دعوى شجاعةٍ لم تؤيّدْ","بِكلامِ الكِلامِ دعوى مُحالُ",42,"ل",1,1],["كلّ در في قعرِ بحرٍ عميقٍ","عرضيّ والماء هو الهواءُ",43,"ا",2,0],["كل ديدب له من القبة الزرقاء مكان","ترقبه عين البسيطة وعين الفرقدين",44,"ن",1,0],["كل دار أرجعت وأنا سناوي","عزتي للي سواتي عزتي له",45,"ل",2,1],["كل داعٍ إيمانُه ذاكَ نبعٌ","منه يُسقى لا ظامئٌ منه فِينا",46,"ن",2,0],["كل دربٍ في معاليقي تدله","في خفوقٍ قد حلف ما يوم خانك",47,"ك",1,0],["كلّ داءٍ طبّهُ معهُ","ما حسودٌ صحّ من لممِ",48,"م",2,0],["كل دار يحلها المرءُ أن كا","ن غنياً أنسا يرى وخدينا",49,"ن",2,0],["كل دنياك ضحوة فاغنميها","فوشيكا يغشاك ليل دجون",50,"ن",1,0],["كل دين وإن تقادم عهداً","ليس ينساه دائن أو مدين",50,"ن",1,0],["كل دورٍ للظلم في هذه الدن","يا سيتلوه للعقوبة دور",51,"ر",1,0],["كل دمع ٍ ما يساقل ابغزاره","والله انه ما يساق الموت غيره",52,"ر",2,0],["كل دقة تدق ف قلب زايد تبيك","وكل دمعة معلقها ف شمّاعته",53,"ت",2,0],["كل دينٍ وردة تأرج حُسْناً","من بحُسْن الزهرِ ليس المعجبا؟",54,"ب",2,0],["كل دينٍ قصةٌ جذابةٌ","روعة الأديان أن تنشعِبا",54,"ب",2,0],["كُلُّ دَمْعٍ سَاْلَ يَذْرِفُ دَمْعَتَيْ","كُلُّ جَرْحٍ فِيْ فُؤَاْدِيْ وَالْبَدَنْ",55,"ن",1,0],["كُلُّ دَارٍ لِلّقَى أَضْحَتْ قِفَاراً","حَفّهَا صَمْتٌ ، تُنَاجِينَا كَفَانَا",56,"ن",2,0],["كُلُّ دَرْبٍ إِلَيْكِ كَانَ عَلَيْنَا","كَالكِتَابِ المُبِيْنِ حَتَّى رَضِيْتِ",57,"ت",1,0],["كلّ دعوى لها لديك بيان","ودليل ، وشاهدٌ منك زُورُ",58,"ر",1,0],["كُلُّ دَرْبٍ مَشَيْتُ فِيهِ تَوَحَّشْتُ","إذا لَمْ يَكُنْ إلى الحُبِّ دَرْبِي",59,"ب",2,0],["كل درب به حنين ادّكار","كل بيت بأرضها ليَ بيتُ",60,"ت",1,0]]}