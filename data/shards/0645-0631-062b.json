{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83322","البسيط"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5525,"جفن الليل","https://www.poetsgate.com/ViewPoem.aspx?id=859",""],[5890,"رقّ لي عسيب","https://www.poetsgate.com/ViewPoem.aspx?id=192061",""],[6102,"مرثية كل يوم","https://www.poetsgate.com/ViewPoem.aspx?id=185050",""]],"verses":[["مرثية عرضت قح الدموع بها","ما أرتد طرفٌ لها إلا وسال دمُ",0,"م",1,0],["مرثية صديق كان يضحك كثيرا","كان صديقي",1,"ي",1,0],["مَرثومَةٌ بِالبَرى خَلَت مَخاطِمَها","جَذباً كَما غودِرَ الثَوبُ الرَعابيلُ",2,"ل",1,0],["مرثومة الأيدي شكت فرط الوجا","لكنها تشكو لغير مشفق",3,"ق",1,0],["مرثيةٌ لي وليت الغيب يبلغها","أحبةً لديار الخلد قد ظعنوا",4,"ن",3,0],["مر ثمر هالليل وأمر قطفه","يالحنظل اللي قمت اذوقه بكفي",5,"ف",2,0],["مرْثيَّةُ الآمال ِآخرُ نوْرسٍ","يرنو لها في النائبات غريبُ",6,"ب",1,0],["مَرثِيَّةٍ - كُلَّ يَومٍ - لِي يُجَدِّدُها","حَنِينُ قَلبٍ ؛ بِمَن خَلَّتهُ ما لَحِقا",7,"ق",2,0]]}