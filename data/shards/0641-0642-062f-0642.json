,"الوافر"],[3507,"","https://poetry.dctabudhabi.ae/diwan/poem/145423","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48281","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86260","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110045","الوافر"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140272",""],[3806,"","https://poetry.dctabudhabi.ae/diwan/poem/146230","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119432","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119676","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97066","الطويل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103254","الطويل"],[4767,"على ضفة الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=178413",""],[4767,"باب فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=180034",""],[4862,"سلامٌ ألا أيها الشاعرا ن","https://www.poetsgate.com/ViewPoem.aspx?id=55631",""],[4984,"على ألمٍ في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=175529",""],[5237,"مرادي من المولى وغاية آمال","https://www.poetsgate.com/ViewPoem.aspx?id=113106",""],[592,"وليس بكفء أن يجاب وإنه","https://www.poetsgate.com/ViewPoem.aspx?id=128794",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"اختلف الأئمةُ","https://www.poetsgate.com/ViewPoem.aspx?id=182982",""],[5725,"احقا امام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=201575",""],[5858,"الشعر كذبه","https://www.poetsgate.com/ViewPoem.aspx?id=188075",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["فَقَد قَدُمَت آياتُها وَتَنَكَّرَت","لِما مَرَّ مِن ريحٍ وَأَوطَفَ مُرهِمِ",0,"م",1,0],["فَقَد قَضى دُيوانَهُ","وَلَم يَكُن يُماطِلُ",1,"ل",1,0],["فقد قمتم للحرب دون بلادكم","تذودون عن أحواضها البغي والنُكرا",2,"ر",2,0],["فقد قادت الأعراب نحو عدوّكم","خُيولاً لها في حَومة الحرب تجوال",3,"ل",1,0],["فَقَد قَذَفَت مِن حَربِ قَيسٍ نِساؤُكُم","بِأَولادِها مِنها تَمامٌ وَمُعجَلُ",4,"ل",1,0],["فَقَد قَتَلَت لِحيانُ أَكرَمَ مِنهُمُ","وَباعوا خُبَيباً بَعدَهُ بِلَفاءِ",5,"ا",2,0],["فقدْ قُيِّدَتْ عنَّا المخاوفُ كلُّها","وقد أُطْلِقَتْ آمالُنا مِنْ قُيودها",6,"د",3,0],["فقد قضى حقَّهُم فَعالُكُمُ ال","آن بمَحياهُ تلكُمُ الرِّمَما",7,"م",2,0],["فَقد قيلَ لَنا عَنكُم","كَما قيلَ لَكُم عَنّا",8,"ن",2,0],["فَقَد قَنَعّوا المَجدَ إِن كانَ ذاك","وَحاشاهمُ منك خِزيا وَعارا",9,"ر",2,0],["فَقَد قيلَ إِنَّ عُقولَ الرِجال","لِ تَحتَ أَلسِنَةِ أَقلامِها",10,"م",3,0],["فَقَد قَصَّرتَ بِالإِحسانِ لَفظي","كَما طَوَّلتَ بِالإِنعامِ باعي",11,"ع",2,0],["فقد قُلِبَ التّأسِّي بالرّزايا","أسىً ملأ التراقِيَ بالجريضِ",12,"ض",1,0],["فقد قَهَرَ السُّلْطَانُ كلَّ معانِدٍ","وما أَحَدٌ لِلقِبطِ في الأرضِ يَقْهَرُ",13,"ر",1,0],["فقد قيَّدَ الجُرْدَ السوابقَ بالرُّبَى","وقطَّعَ أنفاسَ العناجيج بالبُهْر",14,"ر",1,0],["فَقَد قلعتنا رفقة من بيوتنا","كَما تقلع الأشجار نكباءُ زعزع",15,"ع",1,0],["فقد قال في الامثال في البين قائل","أضربه يوم الفراق رحيل",16,"ل",1,0],["فقد قيل أوساط الأمور خيارها","هي الرشد عدوها وأطرفها غيا",17,"ي",2,0],["فقد قالوا يطيرَ به فؤادي","وعندي أنني كلي اطيرُ",18,"ر",1,0],["فقد قبل الله الجميع لأجله","وحط من الخلق العظيم من الوزر",19,"ر",1,0],["فقد قلد الناس رهبانهم","فكلّ يجاهد عن مذهبه",20,"ب",2,0],["فَقَد قلّدوا أهلَ المجامعِ منهمُ","بِمُؤتمرٍ للبحثِ في الدينِ في مصرا",21,"ر",2,0],["فَقَدَّ قَميصَهُ عَنهُ وَأَملى","عَلَيهِ بِالدَمِ المَطولِ شِعرا",22,"ر",2,0],["فَقَد قَذَفَتنا مِصرُ مِنها بِواحِدٍ","يُرى أَلفَ فِرعَونٍ وَلَيسَ لَنا موسى",23,"س",2,0],["فقدْ قَسَّمْتَ قلباً في رُباها","لقد كادتْ تغصُّ به الحلوق",24,"ق",1,0],["فَقَد قَتَلنا كُلَيباً لَم نُبالِ بِهِ","بِنابِ جارٍ وَدونَ القَتلِ يَكفيها",25,"ي",3,0],["فَقَد قَعَدتَ لِلهَمِّ وَالفَقرِ وَالدُجى","وَأَموالِها وَالناكِثينَ بِمَرصَدِ",26,"د",1,0],["فقد قسمت فيه الحظوظ موارثاً","كما قسم الأرْضون في عهدِ فالغا",27,"غ",2,0],["فقد قال سيون الشقي وحزبه","أولوا السحر والكذب الردي والفرية",28,"ه",1,0],["فَقَد قَرَأتُ بِخَدَّيهِ","وَالمرسلات عَلَيهِ",29,"ه",1,0],["فقدْ قوّضَتْ أيدي المعالي خيامَها","وعَادتْ ربوعُ المكرماتِ دَواثِرا",30,"ر",2,0],["فقد قام ناعي الدين فيكم منادياً","بأرقع صوت فوق أعلى المنابر",31,"ر",1,0],["فَقَد قَصَّرَ المَدحُ عَن شُكرِ مَن","أَطاعَ لَهُ الدَهر قَسراً أَبيّ",32,"ي",1,0],["فَقَد قُطِعَت رُؤوسٌ مِن قُعَينٍ","وَقَد نُقِعَت صُدورٌ مِن شَرابِ",33,"ب",1,0],["فقد قسّم العمر للجود وال","نزال كأنّ عليه قسم",34,"م",1,0],["فقد قبِلتُ العذرَ أو قتلتُه","عِلماً وقد عاتبتُه فأَعتبَا",35,"ب",2,0],["فقد قطعتني من كلّ حبٍّ","كما أفردتني من كلّ خدن",36,"ن",1,0],["فَقَد قامَ طَبّاخُنا فائِقٌ","بِلَيلٍ أَعَدَّ لَنا الفُيَّقا",37,"ق",2,0],["فَقَد قَتَلنَا مِنكُمُ","سَبعِينَ رَأساً مُجرِمَا",38,"م",2,0],["فَقَدْ قالَ أَهْلُ الكُوفَةِ الكُلُّ رُتْبَةُ ال","حَزاءُ قبيل الشرط في كل ما تروي",39,"و",2,0],["فقد قيلَ إن العِلمَ يُعطيكَ بَعضَهُ","إذا اعطَيتَه كُلا ولِلعَكسِ تَعلَمُ",40,"م",1,0],["فقد قالوا عدُوُّ الحَقِّ كلبُ ال","ولائِم بيننا رجَلٌ دَخيلُ",41,"ل",1,0],["فَقد قَالُوا الهوى عنا حرامٌ","ولو هُم أنصفُوا قَالوا مُبَاح",42,"ح",1,0],["فقد قضّيتُ بالهفواتِ عمري","ونلتُ من الخطايا ما كفاني",43,"ن",2,0],["فقد قصدتم وهي لما تجتمع","على الضلال في الذي كان صنع",44,"ع",1,0],["فَقَد قامَ بِالتَوحيدِ وَالخَمسُ عُمرُهُ","وَصَلّى عَلى المُختارِ وَاِتَّبَعَ السُنَن",45,"ن",1,0],["فقد قرأ الأعراف فيها نبينا","وبالنور احياناً ولما يقيد",46,"د",1,0],["فَقَد قَيَّضَ الرَحمَنُ فينا ذَرائِعاً","وَقامَت لِهَذا الفَضلَ فينا دَعائِمُ",47,"م",1,0],["فقد قُتِلَ ابنُ ملجمَ في علي","وما يُوفي ابنُ مَلجَم في ذُباب",48,"ب",1,0],["فَقَد قَدَّمَ المِقدارُ غيرَ مُقَدِّمٍ","وقد أخَّرَ المِقدارُ غَيرَ مُؤخَّر",49,"ر",1,0],["فقد قال النبيُّ وكان طَبّاً","بما يأتي وأَزكى القائِلينا",50,"ن",2,0],["فَقَد قُلِّدتَ من ربّي بِسَيفٍ","لِنَصرِكَ لَن يُفلَّ وَلَن يمينا",51,"ن",2,0],["فَقَد قامَ بَينَ الوجهِ وَالجيدِ حاجزاً","لِيَفرق بَينَ الشّمسِ يا صاحِ والصبحِ",52,"ح",1,0],["فقد قلتُ يا قلبُ كُن بَعْدَهم","جَليداً فقال ألا خَلِّ عنّي",53,"ي",1,1],["فَقَدْ قَالَ لي مَنْ زَارَهُ عِنْدَ قَبْرِهِ","شَمَمْتُ فَتِيقَ الْمِسْكِ مِنْ نَشْرِ تُرْبِهِ",54,"ه",1,0],["فَقَد قَرَبتَ وَقَرَّبنا حَشاشَتنا","إِلَيكَ تَقدِمَةً لَم يَثنِها بُخُلُ",55,"ل",1,0],["فقد قرَّ عَيْناً في ممالككَ التي","تَزَحْزَحَ عنها ظُلْمُها وفُسوقُها",56,"ق",3,0],["فقد قرَّبت من قلبي لأهلي","جزاك الله خيراً ما سعيت",57,"ت",1,0],["فَقَد قُلتُ في حُسنِ الأَداءِ قصيدةً","رَجَوتُ إِلهي أَن يَحُطَّ بها وِزري",58,"ر",2,0],["فَقَد قَدُمَت عبودَتكُم وَدُمتم","عَلى الفَحشاءِ وَالطَّبعِ اللَّئيم",59,"م",1,0],["فقد قتلنا شقاء النفس لو قنعت","وما قتلنا به إلا إمرئ دونه",60,"ن",2,0],["فقد قبرت في اللحد واحد عصرها","وأقسم ما المقبورُ إلاَّ قبيلها",61,"ل",3,0],["فقد قال لي يوم الفراق مودعاً","على رحمة الباري توكلتُ يا أبي",62,"ب",2,0],["فقد قرّحن جفني السهاد وخالني","عذولي من ضعفي كشنّ غدا بال",63,"ل",1,0],["فقد قال سل تعطه مفضله كما","أتى في الحديث القدسي عنه وفي الأثر",64,"ر",1,0],["فقد قَلَي الدنيا وأَضحى إِلى","فِراقها ذا طَرَبٍ شَيِّقا",65,"ق",2,0],["فقد قام فوق العرش غيرك وامتطى","الخلافة من تكسى به حلة الفخر",66,"ر",1,0],["فقد قضى الله بالميراثِ سيّدنا","لكلِّ عبدٍ صدوق ذي تقيات",67,"ت",1,0],["فقد قال عبد الله فيها مؤولا","بنفي متاب القاتل المتعمّد",68,"د",1,0],["فقد قرن الله الزنا بالدعا الفتى","مع الله ربا في عذاب مخلد",69,"د",1,0],["فَقد قسم الآله لِكُل غاز","بِأَن يَطأ البَنات بلا زَواج",70,"ج",1,0],["فقد قرروا أنها عاريه","ومن عاش فيها مات",71,"ت",1,0],["فَقَد قالوا بَعيدٌ عَن عُيونٍ","بَعيدٌ عَن قُلوبٍ آلِفاتِ",72,"ت",1,0],["فقد قال فيهم جلا لو أن فعلتم","إذاً لهديناكم لرشد الطرائق",73,"ق",1,0],["فقد قال أهوى فيك طفلا محببا","وان كنت في السبعين أو زدتها عمرا",74,"ر",2,0],["فقد قال يوما على رغمه","أخي أحمد في الحياة انتصر",75,"ر",1,0],["فقد قاموا مع النمسا","بحرب الدّول التسعه",76,"ع",2,0],["فقد قاموا اعتضاداً وانتصارا","لدين محمد الهادي البشير",77,"ر",1,0],["فقد قيل في مثل: لن يعود","عدو قديم صديقاً حديثا",78,"ث",2,0],["فقد قامَت الدنيا على قدَمِ الرّضَى","تهنّئُ موْلانا بأسْعَدِ مَقْدَمِ",79,"م",1,0],["فَقَد قيلَ ان الأَذن في مَعرض الهَوى","عَلى الذِكر قَبل العين تَهوى بِاحيان",80,"ن",1,0],["فقد قال النُهى لفظيَّ نُصحٍ","إذا ما لم تَزِلَّ فما تَذِلُّ",81,"ل",1,0],["فقد قرب المدى إن شئت فاعجل","ولا تكسل كفيت أذى البليه",82,"ي",2,0],["فقد قام في أبواب فرعون قبله","على كفره، في مصر موسى بن عمران",83,"ن",1,0],["فقد قيلَ لي بنومٍ البكرُ سورةٌ","لربٍّ وسورةُ القديمِ تقدمُ",84,"م",1,0],["فقد قضي الله على مسقط","وأُسقِطَ السَّيدُ من ذَروتِه",85,"ت",2,0],["فقد قنعت والحمد لله همتي","وفزت وما أبغي بمدحكم أجرا",86,"ر",2,0],["فقد قبح الصبر والإتّساء","ومن ذا يطيق لأن يصبرا",87,"ر",2,0],["فقد قلّ الظهير ولا نصير","لنا من صرف هذا الدهر واقِ",88,"ق",1,0],["فقد قوضت أبناء حربٍ قبابكم","وفي حيكم بالرغم أرست قبابها",89,"ب",3,0],["فقد قيض الرحمن للشرق قادة","هداة إذا بات النجاد شطونا",90,"ن",2,0],["فقد قام يدعو لإصلاح ما","تناهى إلى العاهر الفاجر",91,"ر",1,0],["فقد قال ارجعوا أزكى إليكم","وأمر الله في هذا جلي",92,"ي",1,0],["فقد قال فيه رسول الهدى","حديثاً صحيحاً بغير علل",93,"ل",1,0],["فقد قُلِّدوا منذ القديم شهادة","وساما علا فوق الصدور لهم زهوا",94,"و",2,0],["فقد قال لي لم يبق شيخ بغربنا","وذا منذ أعوام خلون وأحوال",95,"ل",1,0],["فقد قيل في الأمثال بيت وإنه","لأصدق قيل في اللئام وأصرح",96,"ح",1,0],["فقد قال في شأن الزيارة أنها","لبالنص والإجماع جهلا بما يبد",97,"د",1,0],["فقد قال أهل العلم في كل بدعةٍ","وسائلها حتماً محرمةَ القصد",97,"د",1,0],["فقد قال إسحاق بن منصور إنني","لأشهد عند الله بالكذب المردي",97,"د",2,0],["فقد قال قم فادع الإله وهذه","فلم يبدها هذا الغبي على عمد",97,"د",1,0],["فقد قال في الشيخ الإمام محمد","وأرسل نظماً نائباً عنه في الوفد",97,"د",1,0],["فقد قال هذا قبله لابن حاتم","عدى رسول الله لما توهما",98,"م",2,0],["فقد قال ما قد قاله كل مبطل","كداود إذ أبدى مقالاً يماثله",99,"ل",2,0],["فقد قال داود بن جرجيس ناقلاً","عن الشيخ ما قال الكويتي ناقله",99,"ل",2,0