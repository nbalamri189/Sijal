{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[242,"ما ينقضي لي منهما عجب","https://www.aldiwan.net/poem18057.html","السريع"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[566,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""]],"verses":[["يُوعِي مَعَارِفَ أَلْوَاناً وَيُخْرِجُهَا","لَفْظاً وَمَعْنىً بِإِتْقَانٍ وَتَجْوِيدِ",0,"د",1,0],["يُوعِدُ أَنْ لَيْسَتْ بِقَانِعَةٍ","إلا بِأَكْلٍ فَوْقَ مَا يجِبُ",1,"ب",1,0],["يوعدُني الدهرُ بغَدارتهِ","قعقِعْ لغير الليثِ أو هَبهِبِ",2,"ب",1,0],["يوعدُني الوصلَ ولكنَّهُ","يُخِلفُني بالمَطْلِ ما يوعدُ",3,"د",1,0],["يُوعِدُني وَلَو رَآني طَرسَما","وَشَدَّ لَحيَيهِ لِجاماً مُلجَماً",4,"م",2,0],["يوعدني الدهرُ بغدراتهِ","قعقعْ لغير الليثِ أو هبهبِ",5,"ب",1,0]]}