{"poems":[[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[47,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[190,"ولي مذهب في الهجو أرض بفحشه","https://www.aldiwan.net/poem43695.html","الطويل"],[240,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[406,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216852","الهزج"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4717,"أنوء بقلبٍ أثقلته المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=199866",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5956,"رذاذ وبصاق","https://www.poetsgate.com/ViewPoem.aspx?id=183216",""]],"verses":[["رَذايا هَوىً إِن عَنَّ بَرقٌ تَطاوَلوا","وَإِن عارَضوا الطَيرَ الغَوادي تَعَيَّفوا",0,"ف",3,0],["رَذُلتَ في هَذِهِ الصِناعَةِ أَم","أَكدَيتَ أَم رُمتَها مَعَ الخَرَفِ",1,"ف",1,0],["رذال أبى المقدار إلا الغنى لهم","فظنّهم ناسا وليسوا من الإنس",2,"س",1,0],["رُذُمٌ إِذا قَحِطَ الزَمانُ جِفانُهُ","جَمٌّ إِذا قَلَّ الرَمادُ رَمادُهُ",3,"د",2,0],["رذاذٌ خفيفٌ ، أحسبُ الغيمَ صاغَهُ","حديثَ مُحِبٍّ مُدْنفٍ فأصابا",4,"ب",2,0],["رذاذٌ كأنفاسِ الأزاهيرِ حينما","تمُدُّ إلى نورِ الصَّباحِ رقابا",4,"ب",2,0],["رذاذٌ كأنِّي بالسَّحابِ يزفٌّهُ","حنيناً إلى أرضٍ تُحِبُّ سحابا",4,"ب",2,0],["رذاذٌ حَبَا وجهَ الرِّياضِ نضارةً","وزادَ شبابَ الباسِقاتِ شبابا",4,"ب",2,0],["رذاذُ دجلة في عينيكَ متقدٌ","وقد عَهِدتَ رذاذَ الماءِ مبتردا",5,"د",2,0],["رذايا كالبلايا أو","كعيدانٍ من القضبِ",6,"ب",1,0],["رذ بحر جَدواه يُنلك جَواهِراً","وَدَع السُيول فَاِنَهُنَّ غَثاءُ",7,"ا",2,0],["رَذايا بَغايا مُقشَعِرّاً جُنوبُها","يَغُضّونَ مِن أَجراسِها أَن تَزَغَّما",8,"م",2,0],["رذائلُ شتَّى جمَّعَتْها كَسُبْحَةٍ","فتحْصَى كوِرْدٍ قد حوتْه الأضالعُ",9,"ع",1,0],["رذيلة لليهود البهت تعرف لا","للمسلمين الكرام الأنفس السعدا",10,"د",2,0],["رذاذٌ رائعٌ من ثغر بحرٍ","يغايرُ بَصْقَ والدِنا علينا",11,"ن",2,1],["رذاذُ البحر أجمل من رذاذٍ","لوالدنا يُبَكِّي مقلتينا",11,"ن",2,0]]}