{"poems":[[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[47,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[189,"ولي مذهب في الهجو أرض بفحشه","https://www.aldiwan.net/poem43695.html","الطويل"],[238,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[403,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216852","الهزج"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"]],"verses":[["رَذايا هَوىً إِن عَنَّ بَرقٌ تَطاوَلوا","وَإِن عارَضوا الطَيرَ الغَوادي تَعَيَّفوا",0,"ف",3,0],["رَذُلتَ في هَذِهِ الصِناعَةِ أَم","أَكدَيتَ أَم رُمتَها مَعَ الخَرَفِ",1,"ف",1,0],["رذال أبى المقدار إلا الغنى لهم","فظنّهم ناسا وليسوا من الإنس",2,"س",1,0],["رُذُمٌ إِذا قَحِطَ الزَمانُ جِفانُهُ","جَمٌّ إِذا قَلَّ الرَمادُ رَمادُهُ",3,"د",2,0],["رذاذٌ خفيفٌ ، أحسبُ الغيمَ صاغَهُ","حديثَ مُحِبٍّ مُدْنفٍ فأصابا",4,"ب",2,0],["رذاذٌ كأنفاسِ الأزاهيرِ حينما","تمُدُّ إلى نورِ الصَّباحِ رقابا",4,"ب",2,0],["رذاذٌ كأنِّي بالسَّحابِ يزفٌّهُ","حنيناً إلى أرضٍ تُحِبُّ سحابا",4,"ب",2,0],["رذاذٌ حَبَا وجهَ الرِّياضِ نضارةً","وزادَ شبابَ الباسِقاتِ شبابا",4,"ب",2,0],["رذايا كالبلايا أو","كعيدانٍ من القضبِ",5,"ب",1,0],["رَذايا بَغايا مُقشَعِرّاً جُنوبُها","يَغُضّونَ مِن أَجراسِها أَن تَزَغَّما",6,"م",2,0]]}