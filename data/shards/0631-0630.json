{"poems":[[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[186,"ولي مذهب في الهجو أرض بفحشه","https://www.aldiwan.net/poem43695.html","الطويل"],[235,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[400,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"]],"verses":[["رَذايا هَوىً إِن عَنَّ بَرقٌ تَطاوَلوا","وَإِن عارَضوا الطَيرَ الغَوادي تَعَيَّفوا",0,"ف",3,0],["رَذُلتَ في هَذِهِ الصِناعَةِ أَم","أَكدَيتَ أَم رُمتَها مَعَ الخَرَفِ",1,"ف",1,0],["رذال أبى المقدار إلا الغنى لهم","فظنّهم ناسا وليسوا من الإنس",2,"س",1,0],["رُذُمٌ إِذا قَحِطَ الزَمانُ جِفانُهُ","جَمٌّ إِذا قَلَّ الرَمادُ رَمادُهُ",3,"د",2,0],["رذاذٌ خفيفٌ ، أحسبُ الغيمَ صاغَهُ","حديثَ مُحِبٍّ مُدْنفٍ فأصابا",4,"ب",2,0],["رذاذٌ كأنفاسِ الأزاهيرِ حينما","تمُدُّ إلى نورِ الصَّباحِ رقابا",4,"ب",2,0],["رذاذٌ كأنِّي بالسَّحابِ يزفٌّهُ","حنيناً إلى أرضٍ تُحِبُّ سحابا",4,"ب",2,0],["رذاذٌ حَبَا وجهَ الرِّياضِ نضارةً","وزادَ شبابَ الباسِقاتِ شبابا",4,"ب",2,0]]}