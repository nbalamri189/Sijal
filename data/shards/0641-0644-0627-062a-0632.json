{"poems":[[37,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[47,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[71,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[50,"الحمد لله هذا أعجب العجب","https://www.aldiwan.net/poem62431.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[186,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[285,"أبا أحمد كيف استجزت جفائي","https://www.aldiwan.net/poem60753.html","الطويل"],[285,"أمني النفس وصلا من سعاد","https://www.aldiwan.net/poem60785.html","الوافر"],[382,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[382,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[415,"أقصر فلومي في حبهم لمم","https://www.aldiwan.net/poem32542.html","المنسرح"],[422,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[435,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[435,"بمشرق القاعة الغراء قد طلعت","https://www.aldiwan.net/poem40528.html","البسيط"],[445,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[463,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[469,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[487,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[567,"بشراك بالخير يا لبنان بشراكا","https://www.aldiwan.net/poem52738.html","البسيط"],[567,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138358",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138403",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138437",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110448","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138128",""],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101998","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79895","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128044","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110826","المجتث"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87641","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89323","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91984","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131252",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120455","المجتث"],[4831,"عاليه تنهض من كبوتها","https://www.poetsgate.com/ViewPoem.aspx?id=208037",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""]],"verses":[["فَلا تَزجِرِ الغاوينَ عَن تَبَعِ الصِبا","وَأَنتَ غَوِيُّ النَفسِ قِدماً سَقيمُها",0,"م",3,0],["فَلا تَزَيُّدُهُ في مَشيِهِ نَفِقٌ","وَلا الزَفيفُ دُوَينَ الشَدِّ مَسؤومُ",1,"م",1,0],["فَلا تَزَل مُرصِداً لِلخَيرِ تَفعَلُهُ","وَثابِتاً دونَ ما تَخشاهُ وَقّافا",2,"ف",2,0],["فلا تُزاحمْ على الدنيا الكلابَ فَمَنْ","يزاحمِ الكلبَ فيما نالَهُ يُهِجِ",3,"ج",1,0],["فَلا تَزالُ أَخا حِلٍّ وَمُرتَحَلٍ","إِلى المَوالي وَأَحياناً إِلى العَرَبِ",4,"ب",1,0],["فَلا تَزيدي اِبتساما","نامي فَديتك نامي",5,"ي",1,0],["فَلا تَزل لِلعُلى بَدراً تَضيء بِهِ","دُهم اللَيالي وَتَخفَى عِندَهُ الشُّهُبُ",6,"ب",1,0],["فَلا تَزْهَدَنْ في صالِحِ الذِّكْرِ إِنَّما","يَلِيقُ رِداءُ الْفَضْلِ بِالْفُضَلاءِ",7,"ا",2,0],["فَلاَ تَزَلِ اللَّيَالِي ضَامِنَاتٍ","بَقَاءَكَ مَا حَدَا الأَظْعَانَ حَادِ",8,"د",1,0],["فلا تزكو الرعية في سراها","ومرعاها وراعيها صبي",9,"ي",1,0],["فلا تُزعَجنْ من برقه ورعوده","ولا تَهلعنْ إذ كنتَ عبداً ومأنوسا",10,"س",2,0],["فلا تزل صاح ذاكر لله حامد وشاكر","في كل لحظه وخاطر تنال للأمنيه",11,"ه",1,0],["فَلا تَزِدني جوىً بلومِكَ إِن","نَ الحبَّ نارٌ بالعذلِ تَضطَرِمُ",12,"م",1,0],["فلا تزال مدى الأيام في طربٍ","مُنَعَّم البال في رَوحٍ وريحان",13,"ن",1,0],["فلا تزال مدى الأيام ذا فرحٍ","فيه وعزك مشهورٌ ومقصود",14,"د",1,0],["فلا تزال مدى الأيام باسمةً","تفيض راحتها للساكنين هنا",15,"ن",2,0],["فلا تَزَلْ وفق مَا كُنْ","تَ لي مَعَ العُسرِ يُسْرا",16,"ر",2,0],["فلا تزعزعْكم الخطوب ولا","تدخُلْ عليكم صوارفُ النِّعمِ",17,"م",1,0],["فلا تَزَلْ عندك من طَوْلِهِ","ما عنده من رأيك الصائبِ",18,"ب",1,0],["فلا تَزَلْ نوافذٌ صوائبٌ","يُصمَى بها الحاسدُ أو يَرضَى المحبُّ",19,"ب",1,0],["فلا تزهدن في كسب حمدٍ فإنهُ","لصيقل عرضِ الأريحي الحلاحل",20,"ل",1,0],["فلا تزال شعاعات المطارح في","وصل التضايق في شكل له طرق",21,"ق",1,0],["فلا تزَلْ في حِمانا غَيثَ مَعدِلةٍ","تُحيي البِلادَ بما أَجرَتهُ كفاَّكا",22,"ك",2,0],["فلا تَزَلْ غالباً باللهِ مُنتَصِراً","تُولِي الجميلَ وتَستولي الثَّنا خَلَفا",23,"ف",2,0],["فلا تزل راقيا في المجد وانه ومر","وهب وعش رغدا يا أفضل الفضلا",24,"ل",2,0],["فلا تزل راقيا اوج الفخار ولا","زالت بكم تعتلى بين الورى شانا",25,"ن",2,0],["فلا تزال بلطف الله ثابتة","ولا تزال بعين الله مرعيه",26,"ي",2,0],["فَلا تزال بأهنا العيش رافلةً","بينَ العذَارَى كَبدرِ التمّ في الأُفُقِ",27,"ق",1,0],["فلا تزدري حبي فقد قام للهوى","على كل شئ في الحياة دليل",28,"ل",1,0],["فلا تزال التهاني في محافلكم","ما غرّد الورق في طلح وفي بان",29,"ن",1,0],["فَلا تَزالُ مِن الأَنواءِ صادِقَةٌ","بَحرِيَّةُ الخالِ تَعفوها بِأَمطارِ",30,"ر",1,0],["فلا تزالُ يدُ الأفراحِ تُلبِسكم","طولَ المدى من ثيابِ البشرِ قمصانا",31,"ن",2,0],["فلا تزدني فإني قد فنيت أسى","لولا مخاطبتي إياك لم ترني",32,"ن",2,0],["فلا تزال الدهر في صوفيا","مآتم تندب فيها الحسان",33,"ن",1,0],["فلا تزال عليه","تهمى السحابُ الثقال",34,"ل",1,0],["فَلا تزال غيوث العفو ماطرةً","ارّخ عليكِ بِهِ يا تربة الحَسنِ",35,"ن",1,0],["فلا تزال بنو العباس مالكةً","مفاتح الملك في عزٍّ وإعظام",36,"م",1,0],["فلا تزدني عَلى ما بي بمعتبةٍ","فَقَد كَفى ما أَصاب الهمُّ وَالهمم",37,"م",1,0],["فلا تزر القصور ولا تسلم","وزر تلك الرموس وقل سلام",38,"م",1,0],["فلا تزال تنادي","ردوا على فقيدي",39,"ي",1,0],["فلا تزالُ عروسُ الصيفِ تُؤْرِقُكُمْ","حتّى تعافَتْ وعادَتْ رُوحُها تَثِبُ",40,"ب",1,0],["فلا تزمعي أوتضمري صد عاشق","كريم عفيف النفس لايحسن الصدا",41,"د",2,0],["فلا تزال على هجر قبائلنا","وقد تناست غباء حرمة الرحم",42,"م",1,0]]}