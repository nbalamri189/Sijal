,1,0],["أحلّ لهم ما طاب من كل مطعم","وخص بتحريم جميع الخبائث",146,"ث",1,0],["أَحلى مِنَ العَسَلِ المُصَفّى ماؤُهُ","وَبَياضُهُ أَنقى مِنَ الأَلبانِ",147,"ن",1,0],["أَحَلَّني مِن جَميلِ الرَأيِ مَنزِلَةً","غَدَوتُ مِنها لِظَهرِ النَجمِ مُرتَدِفا",148,"ف",2,0],["أُحلُل بِهِ وَاِسرَح مَطاياكَ في","مَنبِتِ رَوضِ المَجدِ وَالفَخرِ",149,"ر",1,0],["أَحِلُّ مَحَلّي مِن أَهلِها","بِفَضلٍ فيها وَلا يُجحَدُ",150,"د",1,0],["أَحْلاَهُمُ ذِكْراً وَأَذْكَرُهُمْ","لِشَجٍ عَدِيمِ الذِّكْرِ ذِي بُوسِ",151,"س",1,0],["احلى من الراح في راحات مصطبح","ومن سرى لاطيف في اجفان مغتبق",152,"ق",1,0],["أحلاسُ خَيلِ اللهِ وَهيَ مُغِيرَةٌ","يَخرُجنَ مِن خَلَلِ الغُبَارِ الأكهَبِ",153,"ب",1,0],["أَحلَّهُمْ رُتَبَ الأَمْلاكِ جَدُّهُمُ","في خِدْمةِ القائِمِ الحَفْصِيِّ عُبْدانا",154,"ن",2,0],["أحَلَّتْهُ أعلَى تُرْعَةٍ بِاضْطِرابِهِ","وَعَلَّتْهُ أحْلَى شِرْعَةٍ في اضْطِرَامِهِ",155,"م",2,0],["أُحِلَّ ثَراكَ مِنْ كَرَمٍ غَمامٌ","وأُودِعَ فِيكَ مِنْ بَأْسٍ قَبِيلُ",156,"ل",1,0],["أَحُلُّ بِحَيْثُ لا غَوْثٌ لِعافٍ","وَأَطَّرِحُ الْمَغاوِثَ وَالْمَلاجِي",157,"ج",2,0],["أُحلَّأُ عَنها ظامِياً غَيرَ أَنَّني","وَإِن لَم أَذُقها لَلصَريعُ بِها سُكرا",158,"ر",2,0],["أَحلَلتَ بَيتَكَ بِالجَميعِ وَبَعضُهُم","مُتَفَرِّقٌ لِيَحُلَّ بِالأَوزاعِ",159,"ع",1,0],["أحلى المنى كفّنتُهُ","بالياس بين أضالعي",160,"ع",2,0],["أحلى من الورد الجني","ومن تهاويل الفنون",161,"ن",1,0],["أَحلا لِنفسِكَ أَن يُقالَ لَها","هَذا عليٌّ حَطَّه الزَمَنُ",162,"ن",1,0],["أُحِلْت ذراهم واستبيح حماهمُ","وَسيموا هواناً سادةً ومواليا",163,"ي",2,0],["أحلى عنادك لو يكون لمتعةٍ","بيني وبينك فعْلها لا يُخجلُ",164,"ل",1,0],["أَحَلَّأتِ النُفوسَ لِتَقتُليها","وَهُنَّ إِلى مَناهِلُكُم ظِماءُ",165,"ا",2,0],["أُحلّقُ فوق مراقي العقولِ","وأزحم في الطين دودَ البشر",166,"ر",1,0],["احللتِ قتلي واستهنت بصبوتي","لِلّه هل صار الحرامُ حلالا",167,"ل",2,0],["أحل شقائي هناء","وليل بؤسي نهارا",168,"ر",2,0],["أحل جواي حنيناً","ولا تسد الفضاء",168,"ا",2,0],["أَحلى مِنَ الإِنجازِ وَعدُ مُماطِلٍ","عُقِلَت بِحُسنِ وِصالِهِ آمالي",169,"ي",1,1],["أحْلَلْتُ منه سِناني حيث