l","الكامل"],[459,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[459,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[459,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[459,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[459,"رضيت وما من طاعة كل من رضي","https://www.aldiwan.net/poem56148.html","الطويل"],[459,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[459,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[462,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[471,"أإن نادى هديلا ذات فلج","https://www.aldiwan.net/poem4817.html","الوافر"],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[506,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[541,"أرسم سودة محل دارس الطلل","https://www.aldiwan.net/poem56707.html","البسيط"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[563,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[563,"لك الهناء بما أوتيت معتذرا","https://www.aldiwan.net/poem52962.html","البسيط"],[570,"أتتني هنات من رجال كأنها","https://www.aldiwan.net/poem52039.html","الطويل"],[576,"أحل الخمر بعدكم","https://www.aldiwan.net/poem2743.html","مجزوء الوافر"],[576,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[587,"أحلى من الشهد من هويت وكم","https://www.aldiwan.net/poem17453.html","المنسرح"],[587,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[587,"يا ذا الذي يروي الحدي","https://www.aldiwan.net/poem17753.html","مجزوء الكامل"],[587,"لعبت بالشطرنج مع شادن","https://www.aldiwan.net/poem17983.html","السريع"]],"verses":[["أَحُلُّ عُقودَ النائِباتِ وَأَنثَني","وَخَلفي يَدٌ لِلدَهرِ تُحكِمُها عَقدا",0,"د",2,0],["أحلن رمادي حريقا صموتا","وأورقن في شفتيه فباح",1,"ح",1,0],["أَحَلتِ عَلَيَّ الذَنبَ لَما مَلَلتِني","وَغَيرِيَ لَو أَنصَفتِ قَد رَكِبَ الذَنبا",2,"ب",2,1],["أحُلْماً تَرى عيْنايَ أمْ هيَ يَقظَةٌ","أعِنْدَكُما في مُشْكِلِ الأمْرِ مِصْداقُ",3,"ق",1,0],["أَحَلَّ بِهِ الشَيبُ أَثقالَهُ","وَما اِعتَرَّهُ الشَيبُ إِلّا اِعتِرارا",4,"ر",2,0],["أُحْلُلْ بِحَيْثُ حَلَلْتَ مِنْ","هَذِي الْبِلادِ رَفِيعَ شَانِ",5,"ن",1,0],["أَحَلَّهُ اللهُ فِي مَوَاسِمِهِ","وَلَيْسَ كُلُّ الشُّهُورِ بِالحُرُمِ",6,"م",1,0],["أحُلوم كفرَاش","وقلوب كحجاره",7,"ر",2,0],["أُحَلأُ عَن بَردِ الشَرابِ وَقَد نَرى","مَشارِعَ لِلظَمآنِ يَجري حَبابُها",8,"ب",3,0],["أَحُلُّ إِذا شِئتُ الإِيادَ وَحَزنَهُ","وَإِن شِئتُ أَجزاعَ العَقيقِ فَجَلعَدا",9,"د",2,0],["أَحلامُنا تَزِنُ الجِبالَ رَزانَةً","وَيَفوقُ جاهِلُنا فَعالَ الجُهَّلِ",10,"ل",1,0],["أُحِلَّ بِهِ وَلَو أَمسى شَطيراً","وَراءَ الرَدمِ داهِيَةً عَقاما",11,"م",2,0],["أحلامُكم لسَقام الجهل شافيةً","كما دماؤكم يُشفى بها الكَلَبُ",12,"ب",1,1],["أحلامهم أم أحدث الدهر نوبة","لمرهفة الا تُجدَّوا صقالها",13,"ه",2,1],["أحلّ واصدر عن غيرهم","بريّ المحلاء والمؤدب",14,"ب",1,0],["أَحَلَّكُمُ بِدارِ الضَيمِ قَسراً","هُمامٌ لايُضامُ وَلا يُرامُ",15,"م",1,0],["أَحِلُّ بِالأَرضِ يَخشى الناسُ جانِبَها","وَلا أُسائِلُ أَنّى يَسرَحُ المالُ",16,"ل",1,1],["أَحَلَّهُمُ الجَزيرَةَ بَعدَ يَأسٍ","أَخو حِلمٍ إِذا مَلَكَ العِقابا",17,"ب",2,0],["أحلتموني بمعلومي على أمدٍ","يوم القيامة أدنى منه للفكر",18,"ر",1,1],["أحلامكم قد زكت وحاسدكم","بين كرى همِّه وأوهامه",19,"م",2,0],["أحلَّتْنِيهِ آباءٌ كرامٌ","بتيجانِ الملوكِ ذوو اعتصابِ",20,"ب",1,0],["أحلِفُ باللَّه لقد أصْبَحتْ","في الرزق آفتي وما إفْتُها",21,"ت",3,0],["أحلَّ العراقيُّ النبيذَ وشربَهُ","وقال الحرامان المدامةُ والسُّكرُ",22,"ر",1,1],["أحلَّكِ ربي شبهَ أنفِكِ عاجلاً","فما شِبهُهُ شيْءٌ لَدَيَّ سوى القبر",23,"ر",1,0],["أحِلٌّ أن تنامي عن سهادي","ولي مذ بانَ عني النومُ خمس",24,"س",1,0],["أحلّكم ورهاء يُرذمُ أنفُها","فيمخطها من شدة الموق كوعها",25,"ع",3,0],["أحلى مذاقاً على اللسان من ال","شهد بماء الغمام في الرصف",26,"ف",1,0],["أحلال أن يحزق الصيد صبراً","من رأى في حباله محزوقا",27,"ق",2,0],["أحل حرام المدح في غير أهله","فجوزي حرماناً فلم يؤت من حذق",28,"ق",1,0],["أحللْتَني قُلل الآمال في دَعَةٍ","أحلَّك اللَّه من آمالِك القُللا",29,"ل",2,0],["أحللتُ تنكيلي بباب استها","فكانَ للتنكيلِ تنكيلا",30,"ل",2,0],["أحلفُ باللَّهِ لا شريكَ له","فإنها غايةٌ من القسمِ",31,"م",1,0],["أحلف بالله وآلائه","ما فهم الزاري على فهمي",32,"م",2,0],["أحليمٌ أصابَ منه سفيهٌ","فاستردَّ الحليمُ منه الظُّلامَهْ",33,"م",2,0],["أَحلامِيَ تَطمُرُ أَحلامي","بَعضي مَدفونٌ في بَعضي",34,"ي",1,0],["أَحَلَّ قَتلَ نُفوسِ السائِماتِ لَهُ","وَالطَيرُ وَالقَتلُ قَتلٌ حَيثَما كانا",35,"ن",2,0],["أَحلامُهُ وَرَغائِبُه","وَسَمائُهُ وَكَواكِبُه",36,"ه",1,0],["أَحلامَهُ في رقَّةٍ وسَلامِ","ورأى الفَراديسَ الأَنيقَةَ تنثني",37,"ي",1,0],["أَحِلماً فَقَبلَ اليَوم كانَ أَوانُهُ","أَم اَخشى فَقَبلَ اليَومِ أوعِدتُ بِالقَتلِ",38,"ل",1,0],["أحليلتي لا تجزعي من رحلتي","إني إليكم عن قريب أرجع",39,"ع",1,0],["أحلام عيش لا يدو","م طويلهن ولا القصير",40,"ر",1,0],["أحللتم في سواد عيني","تالله نوّرتم المحلا",41,"ل",2,0],["أَحْلَلْتِ شعري منكِ فِي عُليا الذُّرا","وجَمعْتِه برواية الأَملاكِ",42,"ك",1,0],["أُحِلَّ لَنا الصَيدانِ يَومَ الهَوى مَهاً","وَيَومَ تُسَلُّ المُرهَفاتُ أُسودُ",43,"د",1,0],["أَحلاسُ خَيلٍ بَيدَ أَنَّ حُسامَهُم","في السِلمِ مِن حِذرِ الحَوادِثِ مُقلَقُ",44,"ق",1,0],["اُحْلُ وامْرُرْ مَعاً ولِنْ تارةً واخْ","شُنْ وَرِشْ أَنْتَ وانْتَدِبْ للمَعالي",45,"ل",2,1],["أَحُلماً نَرى أَم زَماناً جَديداً","أَمِ الخَلقُ في شَخصِ حَيٍّ أُعيدا",46,"د",2,1],["أحلف بالله ما رمزت ولا","كتمت شيئا من سر أسراري",47,"ر",2,1],["أَحَلَّهُمُ بَيتُ النُبُوَّةِ مَنزِلاً","خِلافَتُهُ بَينَ النُجومِ الثَواقِبِ",48,"ب",1,0],["أَحلامُهُم قُلَلُ الجِبالِ رَسا بِها","وَزنٌ وَأَيديهِم غِمارُ الأَبحُرِ",49,"ر",1,0],["أَحلامُ عادٍ في النَدى إِذا اِحتَبَوا","وَالجِنُّ يَصطَرِمونَ نَومَ حِماسِ",50,"س",1,0],["أَحلِفُ بِاللَهِ وَلَولا الَّذي","يَعرِضُ مِن شَكِّكَ لَم أَحلِفِ",51,"ف",1,0],["أَحلى وَأَشهى مِن مَعبِدٍ نَغَماً","وَإِبنُ سُرَيجٍ وَنازِلِ النَجَفِ",52,"ف",1,0],["أَحَلَّهُ مَخلَدٌ ذُرى شَرَفٍ","لَهُ عَلى الشِعرَيَينِ إِطلالُ",53,"ل",1,0],["أَحَلَّت دَمي مِن غَيرِ جُرمٍ وَحَرَّمَت","بِلا سَبَبٍ يَومَ اللِقاءِ كَلامي",54,"م",2,0],["أَحلى مُعاطيكَ كَأساً أَو مُناوَلَةً","مُعطيكَ خَدّاً نَقِيّاً صَحنُهُ وَفَما",55,"م",2,0],["أَحَلَّ فَأَبدى لِلعُيونِ بَشاشَةً","وَكانَ قَذىً لِلعَينِ إِذ كانَ مُحرَما",56,"م",2,0],["أَحَلَّ هُرَيمٌ يَومَ بابِلَ بِالقَنا","نُذورَ نِساءٍ مِن تَميمٍ فَحَلَّتِ",57,"ت",1,1],["أَحلامُنا تَزِنُ الجِبالَ رَزانَةً","وَتَخالُنا جِنّاً إِذا ما نَجهَلُ",58,"ل",1,0],["أحللتني شماء لم تعرف لها","إلا الكواكب أو علاك مراقي",59,"ق",2,0],["أحلك الشعر محل القلى","وفل من جفنيك سيف الفنا",60,"ا",1,0],["أحَلَّها منه مَحَلاً صَدَداً","لا الرِّيحُ تَعفوهُ ولا صَوبُ الدِّيَمْ",61,"م",1,0],["أَحلَّكَ من أَعلى الهَواءِ مَحَلَّةً","نأَتْ بك عن ضَنْكِ الثَّرى والجنادلِ",62,"ل",1,0],["أحَللْتَها للجُودِ رَوْضاً مُعْشِباً","سَهْلاً وطَوْداً للفَخارِ مُنيفا",63,"ف",2,0],["أحلَّ لي عذابَهُنَّ المُصحَفُ","وليس عن صَرْفِ الحِمامِ مصرَفُ",64,"ف",1,0],["أَحُلُّ بعَقوةِ الشَّرفِ التَّليدِ","وَأَلْبَسُ جُنَّةَ الفَخْرِ العَتيدِ",65,"د",1,1],["أحلَّ وَداعُنا عَطْفاً جديداً","وأدنى بينُنا وَصْلاً بعيدا",66,"د",2,0],["أحلّ منك ركوباً ذلُّ شِرّتِهِ","وكلُّ مَلْكٍ عليه ظهرُهُ حَرَمُ",67,"م",1,0],["أحْلَمُ الأملاكِ عن ذي زَلّةٍ","سَبَقَ السيفَ له عَذْلُ الحليم",68,"م",1,0],["أحَلْتُ عزمي على همّي فقَطّعَهُ","كأنّ عزميَ من صَمصَامتي الذّربِ",69,"ب",1,0],["أَحلى وَأَعذَبُ مِن سَيبٍ تَجودُ بِهِ","وَلَن تَجودَ بِهِ يا كَلبُ يا كَلِبُ",70,"ب",1,0],["أَحلى وَأَحسَنُ ما كانَت شَمائِلُهُ","إِذ لاحَ عارِضُهُ وَاِخضَرَّ شارِبُهُ",71,"ب",2,0],["أَحَلَّهُمُ النَدى سِطَةَ المَعالي","إِذا نَزَلَ البَخيلُ عَلى التُخومِ",72,"م",1,0],["أَحلى الرِجالِ مِنَ النِساءِ مَواقِعاً","مَن كانَ أَشبَهَهُم بِهِنَّ خُدودا",73,"د",2,0],["أحلَّ الضيوفَ على سطحه","وفرَّجهم في نجومِ السما",74,"م",2,1],["أَحَلَّ بِهِ العودَ السَليبَ سَماحَةً","وَأَحرَمَ مَطرورَ الظِبا لا تَوَرُّعا",75,"ع",2,0],["أَحَلُّوا الرّبا فالأرضُ غُبْرٌ وُجوهُها","تُرينا الصّباحَ الطّلقَ أَقْتَمَ أَرْبَدا",76,"د",2,0],["أَحَلتِ سُرورَ ذاكَ القَلبِ حُزناً","وَهِجتِ لَهُ أَفانينَ الخَبالِ",77,"ل",1,0],["أحلَّ لهم صُلحاً وإنّ دِماءَهم","وَأمْوَالَهم إن رَدَّهُمْ خُيَّباً حِلُّ",78,"ل",1,0],["أحلّ قَيدَ عَن جَنَابِكُمُ","لَكِن رَجَائِي بهِ فِي أوثَقِ العُقُل",79,"ل",1,0],["أحَلَّتهُ بِالأزدِ أقلاَمُهُ","مَحَلَّةَ سَحبَانَ فِي وَائِلِ",80,"ل",1,0],["أَحلَلتَ مِن قَلبِكَ حُبَّ البَقا","مَنزِلَةَ المالِ بِأَيدي الشِحاح",81,"ح",1,0],["أَحَلتُ أَشواقي عَلى ذِكرِهِ","أُسَلِّطُ النارَ عَلى المَندَلِ",82,"ل",1,0],["أَحلى مِن الأَمنِ لا يَأوي لِذي كَمَدِ","فيهِ اِنتَهى الحُسنُ مَجموعاً وَمِنهُ بُدي",83,"د",2,1],["أَحلامُ صِبيانٍ إِذا ما","قُلِدوا سُخُباً فَهُم يَتَعَلَقونَ بِمَضغِها",84,"ه",2,1],["أَحلِفُ بِاللَهِ أَيماناً مُضاعَفَةً","في كُلِّ يَومٍ مِن الأَيامِ مَشهُودِ",85,"د",1,0],["أَحَلَّ بِجِسمِهِ الزَفَراتِ حَتّى","بَلي كَبلى العَسِيبِ مِنَ الهَشيمِ",86,"م",1,0],["أَحَلّوا حِياضَ المَوتِ فَوقَ جِباهِهِم","مَكانَ النَواصي مِن وُجوهِ السَوابِقِ",87,"ق",1,0],["أَحُلَّ بِدارِ اللَهوِ حَيثُ لَقيتُها","وَأَهزِلُ بِاللَذاتِ وَالدَهرُ في جِدِّ",88,"د",1,0],["أحَلَّ أُمَّتَهُ في حِرزِ مِلَّتِهِ","كاللَّيْثِ حَلَّ مَعَ الأشبالِ في أُجَمِ",89,"م",1,0],["أحلافُنَا فكأنّنَا منْ نِسْبَةٍ","ولِداتُنا فكأنّنَا منْ عُنصُر",90,"ر",1,0],["أحلافُنا حتى كأنّ ربيعةً","من قبل يعرُبَ كان عاقدَ يَشجُبا",91,"ب",2,0],["أَحَلَّ بِالفُرقَةِ لَومي وَما","بانَ الأُلى أَهوى وَلا ساروا",92,"ر",3,0],["أَحلَلتُ مِن قَلبي هَواكِ مَحَلَّةً","ما حَلَّها المَشروبُ وَالمَأكولُ",93,"ل",1,0],["أَحلِفُ بِاللَهِ لَو سَأَلتُكَ ما","تَملِكُ أَعطَيتَني إِلى الجَندَل",94,"ل",1,0],["أَحَلَّت لَهُ أُمُّ المَنايا بَناتِها","بِأَسيافِنا إِنّا رَدى مَن نُحارِبُه",95,"ه",1,1],["أَحَلَّت بِهِ أُمُّ المَنايا بَناتِها","بِأَسيافِنا إِنّا رَدى مَن نُحارِبُه",96,"ب",2,0],["أَحلامُ عادٍ وَأَجسادٌ مُطَهَّرَةٌ","مِنَ المَعَقَّةِ وَالآفاتِ وَالإِثَمِ",97,"م",1,0],["أَحلِل بِمَن شِئتَ لا يَعدِمكَ نائِبَةً","خانَ اليَمانونَ طُرّاً وَالشَآمونا",98,"ن",2,0],["أَحَلتُ عَلَيها بِالقَطيعِ فَأَجذَمَت","وَقَد خَبَّ آلُ الأَمعَزِ المُتَوَقِّدِ",99,"د",1,0],["أَحلك لي رب السَموات إنه","حَكيمٌ وإن الحق ما هو يشرع",100,"ع",1,0],["أَحَلَّنا الدَهرُ في بَطحاءَ مُسهِلَةٍ","لَمّا تَقَوَّضتَ عَنها أَيُّها الجَبَلُ",101,"ل",1,0],["أحلُّوا قتله وتطلّبوهُ","دماً حراً وروحاً مستهامهْ",102,"م",2,0],["أحَلَّها ذَهَبُ الشَّاري وحرَّمَها","عصرٌ به حُرِّرَ القومُ الأذلَّاَءُ",103,"ا",2,0],["أحلّ منها ما صفا مشارعا","وحرّم الآيات والمصارعا",104,"ع",2,0],["أَحَلُّوا مَلامِي لا أَبَا لأَبِيهِم","وإِنِّي ورَبِّ المَجْدِ غَيْر مَلُومِ",105,"م",1,0],["أَحْلَلْتَنِي بمَحَلَّةِ الجَوْزاءِ","ورَويتُ عِنْدَكَ مِن دَمِ الأَعْدَاءِ",106,"ا",2,1],["أَحَلَّتْكَ مِنْهُ اللَّوْذَعِيَّةُ مَنْصِباً","عَلَى سَنَمٍ تَنْحَطُّ عَنْهُ المَنَاصِبُ",107,"ب",1,0],["أَحْلَلْتَ نَفْسَكَ عِنْدَ نَفْسَكَ ذُرْوَةً","تَأْبَى عَلَيْهَا الخَسْفَ كُلَّ إِبَاءِ",108,"ا",2,0],["أحْلَمُ النَّاسِ عَنْ هُدىً","مَا الَّذِي يُصْلِحُ الْغَضَبْ",109,"ب",1,0],["أَحْلاَسُ حَرْبٍ حُلَفَاءُ حِكْمَةٍ","فِي السِّلْمِ غُرٌّ هِمَّةٌ وَرَفْدَا",110,"د",2,0],["احلمْ كأنكَ جاهلٌ ، وَ اذكرْ كأنكَ","ذَاهِلٌ، وَافْطُنْ كَأَنَّكَ غَافِلُ",111,"ل",1,0],["أحلى الأماني موقعًا","ما ساقه الزمنُ العصيب",112,"ب",1,0],["احَلَّ لهم دماءكمُ مَخاضا","وبؤَّأهم \" حقوقَكمُ \" رباعا",113,"ع",2,0],["أحلَّتْهُ وداعته محيطاً","حمته جوارحٌ للصيد زُرقُ",114,"ق",1,0],["أحلام جبّار السماوات العلى","نزلت عليّ وضمّها جلبابي",115,"ب",2,0],["أحلفُ باللَّهِ لا شريكَ له","فأنها غاية في القسم",116,"م",1,0],["احلهم المقابر والسجونا","وحطوا قصر يلدز عن سماء",117,"ا",1,0],["احلمْ كأنكَ جاهلٌ ، وَ اذكرْ كأن","نَكَ ذَاهِلٌ، وَافْطُنْ كَأَنَّكَ غَافِلُ",118,"ل",1,0],["أحلى وأطيبُ من مسكٍ ومن عَسَلٍ","يُنسي الغواني على الفتيان لو حضرا",119,"ر",2,0],["أحلام وادي السير كان يحدها","حبيك من خلفي ومن قدامي",120,"م",2,1],["أَحلَيتَ لي ا