 ما وهب الربيع عواري",195,"ر",2,0],["أُحِلَّ حرامُها فقد استبيحت","وكانت من جِوارِك في حريمِ",196,"م",1,0],["أحللتُمُ بغير مهرٍ بُضْعَها","ظلماً وإصراراً على حرامِها",197,"م",3,0],["أحلامُهم رُزَّنٌ ثِقالٌ","ومالهُم طائشٌ جهولُ",198,"ل",1,0],["أحلتَ القرائحَ تحت القلوب","سوى أنني القُلَّب الحُوَّلُ",199,"ل",1,0],["أحلَّ بكم في الصوم للفطر حاجةً","وقد عَبَر الأضحى به وهو يقتضي",200,"ض",2,0],["أحلَى على القربِ وقد تملَّأت","عيني بها من نظرة المختلسِ",201,"س",1,0],["أُحِلُّك بعدها من كلّ ذنبٍ","أناخَ بساحتي ثِقَلاً وأرسَى",202,"س",2,0],["أحلَى القديم حديثاً جاهليَّتُكُمْ","وقَصُّ أسلافِكم من رتبة الكتُبِ",203,"ب",1,0],["أحلَّهمُ منك الرضا في رفاغةٍ","وعزٍّ قُناني المحَلَّةِ سامقِ",204,"ق",1,0],["أَحُلُّ النَعفَ مِن أُحُدٍ وَأَدنى","مَساكِنِها الشُبَيكَةُ أَو سَنامُ",205,"م",1,0],["أَحْلامُهُمْ سَفِهَتْ من سوءِ سيرَتِهِمْ","لها بمضْمونِها المَرْدودِ تَعْبيرُ",206,"ر",1,0],["احل مقادير النفوس محبّة","ولو انها عند الليام معايب",207,"ب",1,0],["أحَلناهُم لأفئدةِ الثّكالىْ","فبيتُ الدّمعِ حتْماً لنْ يَمينا",208,"ن",2,0],["أحللت دار كرامة لا تنقضي","أبداً وحل بقاتليك بوار",209,"ر",1,0],["أَحَلَّكَ اللَهُ أَعلى كُلِّ مَكرُمَةٍ","وَاللَهُ أَعطاكَ أَعلى صالحِ العَمَلِ",210,"ل",1,0],["أحللْ به عُقَدَ الرّحا","لِ فليس بعد اليومِ حَلُّ",211,"ل",1,0],["أَحلى لِقَلبِيَ مِن قَلبي وأعذبُ في","مَذاقِهِ لِيَ من سمعي ومن بَصرِي",212,"ر",2,0],["أَحلَى الليالي الَّتي بالوَصْلِ نَقطَعُها","وأفضَلُ الوَصلِ ما يخلو منَ الدَّنَسِ",213,"س",1,0],["أحلَّها الأسَدُ الميمونُ طالعهُ","بُرجاً لهُ فاكتَسَتْ من سَعدِهِ حِبَرا",214,"ر",2,0],["أَحلوا على عرضي فأَحرمتُ عنهم","وفي اللَه جار لا يَنام وطالبُ",215,"ب",1,0],["أَحَلَّ الخمرَ بُعدُكُمُ","سأَشْرَبُ غَيْرَ مُكْتَرِثٍ",216,"ث",1,1],["أَحْلَى بقلْبي من حبا","ك ومن حُلاكَ ومِنْ دَلاَلِكْ",217,"ك",1,0],["أَحْلى مِنَ الشَّهْدِ مَنْ هَويْتُ وكَمْ","شُقَّتْ بِهِ في الهَوى مَراراتُ",218,"ت",1,1],["أَحْلى الهَوى أَنْ يَطُولَ الوَجْدُ والسَّقَمُ","وأَصْدَقُ الحُبِّ ما جَلَّتْ بِهِ التُّهَمُ",219,"م",1,1],["أَحلى مُدامٍ قَدْ طلبْ","تُ لِشُرْبها أَحْلى نَديمِ",220,"م",1,0],["أَحُلُّ عَقْدَ البَنْدِ مِنْ خَصْرهِ","وَأَلثُمُ الشّاماتِ مِنْ خَدّهِ",221,"ه",1,0]]}