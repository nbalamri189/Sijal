{"poems":[[74,"لنجم هلال الدولة الحسن عسكر","https://www.aldiwan.net/poem20190.html","الطويل"],[64,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[113,"لنجل أبي المعالي حسن فهم","https://www.aldiwan.net/poem16336.html","الوافر"],[124,"لنجي الهم يجتاب الكرى","https://www.aldiwan.net/poem49291.html","الرمل"],[164,"من عوض الصبر عما فاته ربحا","https://www.aldiwan.net/poem58909.html","البسيط"],[215,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[242,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[276,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[445,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[469,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[469,"أوجداً وذياك الحمى ومنازله","https://www.aldiwan.net/poem3610.html","عموديه"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[569,"لو سلمنا من العمائم طراً","https://www.aldiwan.net/poem870.html",""],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70757","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70701","الطويل"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140222",""],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90646","المتقارب"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84861","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112558","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89371","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138488",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138489",""],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21395","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85274","الوافر"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89994","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120334","الخفيف"],[4816,"السيف والضيف والكيف","https://www.poetsgate.com/ViewPoem.aspx?id=199477",""],[4578,"قد زف كأس التهاني بالصفا وسعى","https://www.poetsgate.com/ViewPoem.aspx?id=49470",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[5431,"طبيب الفقراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=215177",""],[5783,"حنين إلى \"نجد\"","https://www.poetsgate.com/ViewPoem.aspx?id=34823",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""],[5943,"أمير الشِّعر قد تاقتْ قلوبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34483",""],[6209,"نجلاء أيضاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82538&r=&rc=7",""]],"verses":[["لنجم هلال الدَّولة الحسن عسكر","حوى كلّ قاصٍ في الجمال وداني",0,"ن",2,1],["لنجمكَ في أفقِ المكارم رفعةٌ","وللريح في جوّ العلاءِ هُبوبُ",1,"ب",1,0],["لِنجُومِهَا خَلَجٌ يُحَبِّ","بُ أَنْ يَكُونَ العَيْشُ سُهْدَا",2,"د",2,0],["لنجل أَبي المَعالي حسن فهمٍ","وَطَبع كَالزلال العَذب صافي",3,"ي",1,1],["لنجي الهم يجتاب الكرى","ملك ما طف حتى نزحا",4,"ح",2,1],["لنجل أَحمدَ عبداللهِ وأدّرعوا","ثوبَ الخمولِ اضطراراً واهجروا المرحا",5,"ح",2,0],["لنجواك أستبقى شبابي فعاطني","كؤوس الهوى قبل ابيضاض المفارق",6,"ق",1,0],["لََنَجَّذَنِي مَكْرُ اللِّئَامِ وَكَيْدُهُمْ","وَمَا الْكَيْدُ إِلاَّ مَا أَخَا الْعِلْمِ نَجَّذَا",7,"ذ",2,0],["لنجاره تعنوا لمفاخر مثل ما","يَعنوا السها لِلشَمس في الاشراق",8,"ق",1,0],["لنجيبٍ في دَهْرِه ابنِ نجيبٍ","وبلوغُ الغاياتِ للنُّجباء",9,"ا",2,0],["لِنَجْمٍ تَلألأَ للآمِلينَ","فَغُوِّرَ عنَّا بُعَيْدَ الطُلوعِ",10,"ع",1,0],["لن جانباً للكريم وأصفُ لهُ","وأغلظ على من جفاك أو جهلك",11,"ك",1,0],["لنجدّيةٌ أفياؤهُ وظلالهُ","وسحرّيةٌ أسحاره وأصائله",12,"ل",2,0],["لنجا المنونَ مغامرٌ في حومةٍ","وخطا المنيّةَ في العرين القَسْوَرُ",13,"ر",1,0],["لنجحنا بأمرنا وربحنا","ونجينا من السيول الجوارف",14,"ف",1,0],["لنجلِهِ البرِ يعقوبِ الشريف وقَد","لُقِّبَ مُستَمسِكاً باللَهِ في صفرا",15,"ر",2,0],["لنجلِ سليمانَ المهذّبِ ناصرٍ","أخي الشرفِ العالي وفعلِ المحامد",16,"د",1,0],["لنجل ابن سلطانَ بن سيفٍ مكارمٌ","يقصِّرُ عنها الوصف من كلِّ مادحِ",17,"ح",1,1],["لنجتلي الآداب ما بيننا","ونصطفي للأفضل الفائق",18,"ق",1,0],["لِنَجلُسَ في خلوةٍ مجلساً","ونُحدِثَ قبلَ الفراقِ اجتماعا",19,"ع",2,0],["لِنَجله بِهجة العَليا مُؤرخة","عَبد اللَطيف بِفَضل عادَ وَلَده",20,"د",2,0],["لنجدة أوطاني أخف إلى الوغى","فما راعني هول ولا ردني دم",21,"م",1,0],["لنجلك في التشريف قال مؤرخاً","جلال جمال الحج حييت عثمان",22,"ن",1,0],["لنجا بالحب إذ في حبه","سيئات الخلق صارت حسنات",23,"ت",1,0],["لنجا في الحب إذ في حبه","يغفر الله الذنوب الموبقات",24,"ت",1,0],["لَنَجدَعَنَّ بِأَيدينا أَنوفَكُمُ","وَيَذهَبُ القَتلُ فيما بَينَنا هَدَرا",25,"ر",2,1],["لنجمع لأمة للحرب كنا","نداولها لذلك من قديم",26,"م",1,0],["لنجني من رياض الأنس زهراً","ونطفي من لهيب الشوق جمرا",27,"ر",2,0],["لنجار الفاروق يعزى فنعم الفخر","عم الورى وزان المحافل",28,"ل",1,0],["لن جات في صيت الكرم والمعاميل","تنحر ابلها قبل تذبح غنمها",29,"م",3,0],["لنجله زف شمس المجد فابتهجت","به عيون المنى مرآي ومستمعا",30,"ع",2,0],["لنجعل من نضال العيش ذُخراً","ثرياً في تبسُّمِهِ اقتداءُ",31,"ا",2,0],["لنجعل من تراحمنا كتابا","به تُمحى معاناة الجروح",32,"ح",1,0],["\"لنجد\" الهوى شوقٌ من الشوق أكبرُ","يتوق \"لنجدٍ\" خافقي المتحيرُ",33,"ر",1,1],["لنجلس مُنْعَمينَ بحبّ أرضٍ","ملأناها حروباً مستطيرة",34,"ر",2,0],["لنجارهِتعنو المفاخرُ مثلُ ما","يعنو السها للشمسِ في الإشراقِ",35,"ق",1,0],["لنجمعَ من ضياءِ الكونِ شمساً","تعيدُ النُورَ للشِّعرِ الجديدِ",36,"د",1,0],["لنجلاءَ أسقي الجنَّ خمري وكوثري","وأدعو شياطيني على زادِ أسطري",37,"ر",2,1]]}