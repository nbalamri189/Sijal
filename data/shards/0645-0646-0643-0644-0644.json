{"poems":[[84,"وكتيبة بالدارعين كثيفة","https://www.aldiwan.net/poem29400.html","الكامل"],[43,"يا مرحبا ألفا وألفا","https://www.aldiwan.net/poem42252.html","مجزوء الكامل"],[87,"حلو الوعود متى وفاك","https://www.aldiwan.net/poem7885.html","مجزوء الكامل"],[87,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[78,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[87,"مضنى وليس به حراكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9560&r=&rc=50",""],[141,"يا ويح جندي الألى خاروا وما نظروا","https://www.aldiwan.net/poem67979.html","البسيط"],[203,"يوم بهذي الليالي يشبه القمرا","https://www.aldiwan.net/poem45350.html","البسيط"],[214,"ذكر الغنا فحنت عليه أضلعي","https://www.aldiwan.net/poem13297.html","الكامل"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[369,"ليس التعجب إلا من بني زمن","https://www.aldiwan.net/poem60664.html","البسيط"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[469,"وأنلته عزاً بغير مذلة","https://www.aldiwan.net/poem3180.html","عموديه"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[469,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[473,"قد قلت إذ عاتبني جليسي","https://www.aldiwan.net/poem59947.html","الطويل"],[482,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[505,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86983","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143286","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37989","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38162","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47390","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26679","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126659","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110338","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77205","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100334","الرمل"],[3502,"","https://poetry.dctabudhabi.ae/diwan/poem/147415","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45911","البسيط"],[3825,"","https://poetry.dctabudhabi.ae/diwan/poem/206308","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103010","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35643","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119650","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102730","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90865","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120488","الكامل"],[4929,"الموت القادم من الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=199561",""],[5213,"بلغت بك الروحاء في ذملانها","https://www.poetsgate.com/ViewPoem.aspx?id=170567",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""]],"verses":[["من كل ليث فوق برق خاطف","بيمينه قدر من الأقدار",0,"ر",1,0],["مِن كُلِّ لَذَّاتِ الفَتَى","قَد نِلتُ نَائِلَةً وَعُرفَا",1,"ف",2,0],["من كل لفظ لو أذن","ت لأجله قبلت فاك",2,"ك",1,0],["مِن كُلِّ لَمّاحِ النَعيمِ تَقَلَّبَت","ديباجَتاهُ عَلى بِلىً وَجَفافِ",3,"ف",1,0],["مِن كُلِّ لائِقَةٍ لِباذِخِ قَدرِهِ","عَصماءَ بَينَ قَلائِدِ الأَشعارِ",4,"ر",1,0],["مِن كُلِّ لَهفانَ زِدتَ في أَوَدِ ال","أَموالِ حَتّى أَقَمتَ مِن أَوَدِه",5,"د",2,0],["مِنْ كلِّ لَفْظٍ بَلِيغٍ راقَ جَوْهَرَهُ","كأنَّهُ السَّيْفُ ماضٍ وَهْوَ مَصْقُولُ",6,"ل",1,0],["من كلِّ لاحقةِ الأياطلِ شُدَّفٍ","رحبِ الصدورِ أمينةِ الأثباجِ",7,"ج",1,0],["من كلِّ لفَّاء المعاطفِ طَفلْةٍ","جِيدٌ كما يهَوى الهوَى وقَوام",8,"م",1,0],["من كلِّ لفظٍ لو أَذِن","تَ لجله قبلتُ فاك",9,"ك",1,0],["مِن كُلِّ لَيثٍ شَتيمِ الوَجهِ ذي زَبَدٍ","ضَرغامَةٍ يَحذَرُ الآسادُ ما صَنَعا",10,"ع",2,0],["من كلِّ ليثٍ إذا حفزتهُ قطرتْ","أنيابهُ واستطارتْ عينهُ شررا",11,"ر",2,0],["من كل ليث في الحروب مقنع","ومقلد شاكي السلاح مدرع",12,"ع",1,0],["مِن كُلِّ لَيثٍ أَهرَتٍ","يَومَ الجِدالِ أَشدَقِ",13,"ق",1,0],["مِن كُلِّ لا راحِمٍ إِن كانَ ذا قُدَرٍ","وَلا إِذا نابَهُم خَطبٌ بِمَرحومِ",14,"م",1,0],["من كلّ لدن ليس يجنى غصنهُ","الخطيّ إلاَّ بالسنان منورا",15,"ر",2,0],["من كلّ لفظٍ بت ُّ أُسِكن بيتَهُ","معنىَ يكاد فصاحةً أن يخطبا",16,"ب",2,0],["من كلّ لدنِ القدّ لولا عجزها","ألقت عليه قلادةً في جيدها",17,"د",3,0],["من كل لدنٍ كالفوام يميل من","مرح الشباب إلى الدلال فينثني",18,"ن",2,0],["مِن كِلَلٍ تَصلُحُ لِلعَروسِ","قَد قَنَعَ اللَيثُ بِهَذا الخيسِ",19,"س",1,0],["مِن كلِّ لاغبةٍ تقَاصرَ خطوهُا","في البيدِ تحمِلُ مستهاماً لاغِبا",20,"ب",2,0],["من كل ليثٍ يرعدُ الموتُ الخطي","رُ بحومَةِ الميدان إِن لاقاهُ",21,"ا",2,0],["مِن كُل لَيث بِالوِزارة قائم","تَدبيرُه يُنسي وَقائعَ طارق",22,"ق",1,0],["من كلّ لفظ كنظم الدرّ مخترع","وكلّ معنى كنفث السّحر مبتكر",23,"ر",1,0],["مِن كلِّ ليمونةٍ قد خِلتُها كرةً","من عسجَدٍ لم يكن يُحصيه تثمينُ",24,"ن",1,0],["مِن كلِّ لَيثٍ في الكَريهَةِ صائلٍ","يَهوى المنيّةَ لَيسَ مِنها يَحتَمي",25,"م",2,0],["مِنْ كلِّ لينة القوام متى يُعا","ينْ مشْيَها عودُ البَشَامةِ يخجلِ",26,"ل",1,0],["مِن كلّ لسعاء المرا","شف بضّة المتجرّدِ",27,"د",1,0],["مِنْ كُلِّ لافِظَةٍ بالدُّرِّ باسِمَةٍ","عَنْهُ مُحَلاَّةِ نَوْعٍ مِنْهُ مَثْقوبِ",28,"ب",1,0],["من كلِّ لابسةِ الشباب ملاءة","حَسبَ اقتدارِ الصَّانع المتأنّق",29,"ق",1,0],["من كل ليث صارخ","شربى دماء عدائيه",30,"ي",2,0],["من كل ليثٍ في بشر","ري لا يُضارعه قرين",31,"ن",1,0],["من كُلِّ لونٍ حاز حُسْناً وصَفا","يحيرُ في مديحِه مَنْ وصَفا",32,"ف",2,0],["من كلّ لونٍ فاقَ في الأَلوانِ","إليه داعي صَبْوَتي أَلواني",33,"ي",1,0],["مِن كُلِّ لاحِقِ روحٍ راحَ يَطلُبُها","بِسَيفِهِ غَيرَ مَلحوقٍ إِذا طُلِبا",34,"ب",2,0],["من كلّ لبَّاسٍ قميصَ الضحى","ببأس ليثٍ وقِلاَ أرقم",35,"م",1,0],["منك للانفاس تصعيد وللدّ","مع تصويبٌ وللقلب ولوع",36,"ع",1,0],["من كل لفظ سيء حساده","به ومعنىً سر سراقه",37,"ق",2,0],["مِن كُلِ لَفظ بِهِ وَعظ لمعتبر","يَبكيك مَضمونه مِن مقلتيك دَما",38,"م",2,0],["من كلِّ لونٍ حدثت أَنفاسه","في الطيب عن شيح به وثمامِ",39,"م",1,0],["من كل لدّاغ بفرع ذؤابة","كالأفعوان مضيضة آلامها",40,"م",3,0],["مِن كُلِّ لَفظٍ كَماءِ المُزنِ يوسِعُني","ما شِئت ريّا وَلا أَنفكُّ ضَمآنا",41,"ن",2,0],["من كُلِّ لَيثٍ للوغى مُندَفِقِ","قد قُسِمُوا إِلى ثَلاثِ فِرَقِ",42,"ق",1,0],["من كل ليث عرينٍ فوق سابحةٍ","كأنه في الوغى من بأسه حجَرُ",43,"ر",1,0],["مِنْ كلّ لاهي القلب من ذاهلٍ","به فسلْ أَيُّهما الذاهلُ",44,"ل",1,0],["من كل ليث فوق أجرد سابح","متسربل بالنثرة الحصداء",45,"ا",2,0],["من كل ليث حديد الناب مفترس","له ثبات وفي الهيجاء وثبات",46,"ت",1,0],["من كل ليث باسل بطل لدى","الأقدام طود ثابت الأقدام",47,"م",1,0],["من كلِّ لافظةٍ بما في صدرها","تمسي وتصبحُ للردى كالقوّم",48,"م",1,0],["من كل لفظ لا يكاد يقله","ظهر البعير مقعر متشاكس",49,"س",1,0],["من كل لص فاحشٍ بك محتمي","خَنَقَت مفاسدُه البلاد وتخنُقُ",50,"ق",1,0],["من كل لعساء اللمى فكأنما","بنت الحميا ضمنت بدنانها",51,"ن",3,0],["مِنْ كُلِّ لَونٍ قَدْ حَبَتْكِ طَبْيعَةٌ","أيٌّ يُضيفُ إلى جَمالِكِ أَسطُرا",52,"ر",2,0]]}