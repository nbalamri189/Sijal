{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[55,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[65,"ومشبوح الأشاجع ناشري","https://www.aldiwan.net/poem46111.html","الوافر"],[65,"ومشتمل على كرم وحزم","https://www.aldiwan.net/poem46115.html","الوافر"],[65,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[79,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[32,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[85,"أعلامك الحمر فوق السفن خافقة","https://www.aldiwan.net/poem54302.html","البسيط"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[53,"ومونقة الرواد مهتزة الربا","https://www.aldiwan.net/poem9395.html","الطويل"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[93,"عيناك والسحر الذي فيهما","https://www.aldiwan.net/poem8855.html","عموديه"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[87,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[45,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[64,"إن الجزيرة في البحر المحيط لها","https://www.aldiwan.net/poem52154.html","البسيط"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[68,"زجرتني عن التشفع نفس","https://www.aldiwan.net/poem38665.html","الخفيف"],[68,"زجرت مرور طيركم بسعد","https://www.aldiwan.net/poem38758.html","الوافر"],[99,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[82,"وصفراء كالشمس تبدو لنا","https://www.aldiwan.net/poem31464.html","المتقارب"],[71,"إن كنت ناصحي فحسن صبري","https://www.aldiwan.net/poem28764.html","الرجز"],[76,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[107,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[83,"جاهدت في تمهيد حمص راحلا","https://www.aldiwan.net/poem61476.html","الكامل"],[104,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[54,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[54,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"زجرت كتابكم لما أتاني","https://www.aldiwan.net/poem63321.html","الوافر"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[48,"ألم ترني مع الأيام أمسي","https://www.aldiwan.net/poem22684.html","الوافر"],[48,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[48,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[48,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67322","الطويل"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[77,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[107,"يا غاديا ببريد الشام ينتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54966&r=&rc=136",""],[101,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[87,"إلى الله أَشكو مِن عَوادِي النَّوَى سهما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9625&r=&rc=115",""],[124,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[216,"زجرت عذولا رام صدي بعذله","https://www.aldiwan.net/poem37842.html","الطويل"],[241,"بث بثي شجني","https://www.aldiwan.net/poem18100.html","مجزوء الرمل"],[302,"تركت هوى بيض الطلى والترائب","https://www.aldiwan.net/poem36291.html","عموديه"],[309,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[322,"زجيت دهراً طويلاً في التماس أخ","https://www.aldiwan.net/poem62618.html","البسيط"],[357,"زجرت بحرا طمى عزا بساحة من","https://www.aldiwan.net/poem40010.html","البسيط"],[368,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[368,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[368,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[384,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[384,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[420,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[420,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[433,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[436,"وغادة عادت الدنيا ببهجتها","https://www.aldiwan.net/poem12436.html","البسيط"],[461,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[461,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[461,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[464,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[464,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[464,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[464,"أحببته غمر الرداء والشيم","https://www.aldiwan.net/poem16104.html","الرجز"],[464,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[467,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[485,"زجاج القلب كأس في زمان","https://www.aldiwan.net/poem24487.html","عموديه"],[554,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[556,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[561,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[561,"زجاجتك أشرقت في وسط مشكاتك","https://www.aldiwan.net/poem34281.html","المواليا"],[565,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10421","الوافر"]],"verses":[["زَجَرتُ السُرورَ فَما يُجتَنى","بِغَيرِ العُلى طَلَبي وَاِرتِياحي",0,"ح",2,0],["زَجَرتَ عَنّا اللَيالي وَهيَ رابِضَةٌ","تَقرو بِأَنيابِها عَقرَ المَخاليبِ",1,"ب",1,0],["زَجَرْتُ إليهِ نَاجِيَةً ذَمولاً","تُحاذِرُ أَنْ يُلِمَّ بِهِ القَطيعُ",2,"ع",1,0],["زَجَرْتُ إِليهِ أَصْهَبَ داعِرِيَّاً","مُرَاحَاً سَوْطُهُ تَعِبَ الخِطامِ",3,"م",1,0],["زَجَرْتُ إليكمْ كلَّ وَجْناءَ حُرّةٍ","وأدْهَمَ محْجولَ القوائِمِ أجْرَدا",4,"د",2,0],["زجَرْتُ القَوافي والمَطايا شَوارِداً","الى واحِدٍ في الرّوعِ يُغْني عنِ الألْفِ",5,"ف",1,0],["زَجِلُ الْجَنَاحِ إِذَا أَجَدَّ لِغَايَةٍ","وَإِذَا تَغَنَّى بِالصَّهِيلِ فَبُلُبُلُ",6,"ل",1,0],["زَجَرْتَ بِهَا الأسْطُولَ يَبْتَدِرُ الْعِدَى","وَيَمْضِي إِلَى مَا اعْتَادَهُ مِنْ فَعَالِهِ",7,"ل",2,0],["زجَرْنا بإبْراهيمَ بُرْءَ هُمومِنا","فلمّا رأينا وجْهَهُ صدَقَ الزّجْرُ",8,"ر",1,0],["زَجَرتُ عَلَيهِ حُرَّةَ اللَيطِ رَفَّعَت","عَلى رَبِذٍ كَأَنَّهُنَّ دَعائِمُ",9,"م",1,0],["زَجَرتُ عَلى ما لَدَيَّ القَلو","صَ مِن حَزَنٍ وَعَصَيتُ الشُؤونا",10,"ن",2,0],["زَجولٌ بِرِجلَيها نَهوزٌ بِرَأسِها","إِذا اِئتَزَرَ الحادي اِئتِزارَ المُصارِعِ",11,"ع",1,0],["زَجولٌ بِرِجلَيها نَغوضٌ بِرأسِها","إِذا أَفسَدَ الإِدلاجُ لَوثَ العَصآئِبِ",12,"ب",1,0],["زجِلُ الجناح مصفق كمن الردى","في مخلب منه وفي منقارِ",13,"ر",1,0],["زجرتُه بشفاء قد أتاك كما","يُرضي علاك جميل الخُبر والخَبر",14,"ر",1,0],["زُجَلٌ وَرُفِّعَ في ظِلالِ حُدوجِها","بيضُ الخُدودِ حَديثُهُنَّ رَخيمُ",15,"م",1,0],["زُجَلاً كَأَنَّ نِعاجَ توضِحَ فَوقَها","وَظِباءَ وَجرَةَ عُطَّفاً آرامُها",16,"م",3,0],["زجرتُ ثناء الناس ثم انتجعته","ولم يتخالجني سَنيح وبارحُ",17,"ح",1,0],["زجرتْ بني وهبٍ عقولُهُمُ","أنْ يعْرِضوا لمغصَّة اللُّقَمِ",18,"م",1,0],["زَجَرتَ لَها طَيرَ السَنيحِ فَإِن تُصِب","هَواكَ الَّذي تَهوى يُصِبكَ اِجتِنابُها",19,"ب",3,0],["زَجَرتُ حَتّى النَومَ عَن مُقلَتي","وَلَم أُبالِ اللائِمَ الزاجِرا",20,"ر",2,0],["زَجِلَ الحُداءِ كَأَنَّ في حَيزومِهِ","قَصَباً وَمُقنِعَةَ الحَنينِ عَجولا",21,"ل",2,0],["زَجَرتُ تَصاريفَ الزَمانِ فَما يَقَع","لِيَ اليَومَ مِنها كانَ بِالأَمسِ لي وَهما",22,"م",2,0],["زَجَلٌ يُريكِ الجَوَّ ناراً وَالمَلا","كَالبَحرِ وَالتَلَعاتِ رَوضاً مُمرِعا",23,"ع",2,0],["زجاجة جوف مشكاة تضيء بها","مصباح زيت تجلي ظلمة الحلكِ",24,"ك",1,0],["زَجَرتُ عَلَيهِ وَالحَيّاتُ مَذلى","نَبيلَ الجَوزِ أَتلَعَ تَيَّحانِ",25,"ن",1,0],["زَجَرتُ عَلَيهِ حُرَّةً أَرحَبِيَّةً","وَقَد كانَ لَونُ اللَيلِ مِثلَ اليَرَندَجِ",26,"ج",1,0],["زَجَرَتني عَنِ التَشَفُّعِ نَفسٌ","مِنَنُ الناسِ عِندَها كَالمَنونِ",27,"ن",1,1],["زَجَرتُ مُرورَ طَيرِكُم بِسَعدٍ","فَهَلّا قَد زَجَرتَ بِذاكَ طَيري",28,"ر",2,1],["زجَرته أو نهرته أو","كفَّت على جُرمٍ يده",29,"ه",1,0],["زُجاجٌ وخَمرٌ وماءٌ كَما","تَقولُ هَيُولى وَنَفْسٌ وصُورَه",30,"ر",2,0],["زجاجُهُ يُسبك بعدَ الكسر","والدرُّ ما لكسرِهِ مِنْ جبرِ",31,"ر",1,0],["زَجِلِ الرُعودِ كَأَنَّما مَسَحَت بِهِ","كَفُّ الصَبا عَن ناقَةٍ عُشَراءِ",32,"ا",2,0],["زَجّوا المَلايينَ في أَعماقِها أُمَماً","يوفونَ بِالنذرِ إِن عُدّوا وَإِن حُسِبوا",33,"ب",3,0],["زَجّوا الجُيوشَ إِلى الوَغى فَأَبادَها","قَدَرٌ أَشَدُّ مِنَ الجُيوشِ وَأَفتَكُ",34,"ك",1,0],["زُجُّ القَناةِ مُشابِهٌ لِسِنانِها","حَتّى يَهُمَّ مُحارِبٌ أَن يُطعَنا",35,"ن",2,0],["زَجراً وَهَيهات لاتَ مُزدجِرٍ","أَيّة نَفس هَوجاء ازجرها",36,"ر",3,0],["زَجَرتُ بِهِ سِيّاحَ قَفرٍ كَأَنَّهُ","يَخافُ لَجاقاً أَو يُبادِرُ آفِلا",37,"ل",2,0],["زَجَرَ البِقاعَ بِرَعدِهِ","فَأَجَبنَهُ بِنَباتِ",38,"ت",1,0],["زَجَرْتَهُمْ بعقوباتٍ مُنَوَّعَةٍ","وفي العقوباتِ لِلطاغينَ مُزْدَجَرُ",39,"ر",1,0],["زَجِلٌ يُبِرِّحُ بالفضاءِ مَضِيقُهُ","فالسهْلُ يَمٌّ والجبِالُ بحار",40,"ر",1,0],["زَجَرتُ كِتابَكُم لَمّا أَتاني","بِزَجرِ سَوانِحِ الطَيرِ الجَواري",41,"ر",2,1],["زُجاجٌ إِن رَفِقتَ بِهِ وَإِلّا","رَأَيتَ ضُروبَه مُتَقَصِّماتِ",42,"ت",1,0],["زَجَرتُ لَكَ الزَمانَ فَلا تُضَيِّع","يَقينَ عِيافَتي وَصَحيحَ زَجري",43,"ر",2,0],["زَجَرَت قَواريها الزَواجِرُ بِالضُحى","وَالحادِثاتُ مِنَ الحِمامِ قَواري",44,"ر",2,0],["زُجِرَ الغُرابُ تَطَيُّراً وَنَقيضُهُ","ديكٌ لِأَهلِ الدارِ أَبيَضُ أَفرَقُ",45,"ق",1,0],["زَجَرتُهُما زَجرَ اِبنِ سَبعٍ سِباعَهُ","وَلَو فَهِما زَجري لَما قَبِلاهُ",46,"ل",3,0],["زَجرَ أَبِي عُروَةَ السِباعَ إِذا","أَشفَقَ أَن يلتَبِسنَ بِالغَنَمِ",47,"م",1,0],["زَجَرْنَا بَنِي كَعْبٍ فَأَمَّا خِ