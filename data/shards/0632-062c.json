{"poems":[[53,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[63,"ومشبوح الأشاجع ناشري","https://www.aldiwan.net/poem46111.html","الوافر"],[63,"ومشتمل على كرم وحزم","https://www.aldiwan.net/poem46115.html","الوافر"],[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[30,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[83,"أعلامك الحمر فوق السفن خافقة","https://www.aldiwan.net/poem54302.html","البسيط"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"ومونقة الرواد مهتزة الربا","https://www.aldiwan.net/poem9395.html","الطويل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[91,"عيناك والسحر الذي فيهما","https://www.aldiwan.net/poem8855.html","عموديه"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[62,"إن الجزيرة في البحر المحيط لها","https://www.aldiwan.net/poem52154.html","البسيط"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[66,"زجرتني عن التشفع نفس","https://www.aldiwan.net/poem38665.html","الخفيف"],[66,"زجرت مرور طيركم بسعد","https://www.aldiwan.net/poem38758.html","الوافر"],[97,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[80,"وصفراء كالشمس تبدو لنا","https://www.aldiwan.net/poem31464.html","المتقارب"],[69,"إن كنت ناصحي فحسن صبري","https://www.aldiwan.net/poem28764.html","الرجز"],[74,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[105,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[81,"جاهدت في تمهيد حمص راحلا","https://www.aldiwan.net/poem61476.html","الكامل"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[52,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"زجرت كتابكم لما أتاني","https://www.aldiwan.net/poem63321.html","الوافر"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"ألم ترني مع الأيام أمسي","https://www.aldiwan.net/poem22684.html","الوافر"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67322","الطويل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[105,"يا غاديا ببريد الشام ينتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54966&r=&rc=136",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[85,"إلى الله أَشكو مِن عَوادِي النَّوَى سهما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9625&r=&rc=115",""]],"verses":[["زَجَرتُ السُرورَ فَما يُجتَنى","بِغَيرِ العُلى طَلَبي وَاِرتِياحي",0,"ح",2,0],["زَجَرتَ عَنّا اللَيالي وَهيَ رابِضَةٌ","تَقرو بِأَنيابِها عَقرَ المَخاليبِ",1,"ب",1,0],["زَجَرْتُ إليهِ نَاجِيَةً ذَمولاً","تُحاذِرُ أَنْ يُلِمَّ بِهِ القَطيعُ",2,"ع",1,0],["زَجَرْتُ إِليهِ أَصْهَبَ داعِرِيَّاً","مُرَاحَاً سَوْطُهُ تَعِبَ الخِطامِ",3,"م",1,0],["زَجَرْتُ إليكمْ كلَّ وَجْناءَ حُرّةٍ","وأدْهَمَ محْجولَ القوائِمِ أجْرَدا",4,"د",2,0],["زجَرْتُ القَوافي والمَطايا شَوارِداً","الى واحِدٍ في الرّوعِ يُغْني عنِ الألْفِ",5,"ف",1,0],["زَجِلُ الْجَنَاحِ إِذَا أَجَدَّ لِغَايَةٍ","وَإِذَا تَغَنَّى بِالصَّهِيلِ فَبُلُبُلُ",6,"ل",1,0],["زَجَرْتَ بِهَا الأسْطُولَ يَبْتَدِرُ الْعِدَى","وَيَمْضِي إِلَى مَا اعْتَادَهُ مِنْ فَعَالِهِ",7,"ل",2,0],["زجَرْنا بإبْراهيمَ بُرْءَ هُمومِنا","فلمّا رأينا وجْهَهُ صدَقَ الزّجْرُ",8,"ر",1,0],["زَجَرتُ عَلَيهِ حُرَّةَ اللَيطِ رَفَّعَت","عَلى رَبِذٍ كَأَنَّهُنَّ دَعائِمُ",9,"م",1,0],["زَجَرتُ عَلى ما لَدَيَّ القَلو","صَ مِن حَزَنٍ وَعَصَيتُ الشُؤونا",10,"ن",2,0],["زَجولٌ بِرِجلَيها نَهوزٌ بِرَأسِها","إِذا اِئتَزَرَ الحادي اِئتِزارَ المُصارِعِ",11,"ع",1,0],["زَجولٌ بِرِجلَيها نَغوضٌ بِرأسِها","إِذا أَفسَدَ الإِدلاجُ لَوثَ العَصآئِبِ",12,"ب",1,0],["زجِلُ الجناح مصفق كمن الردى","في مخلب منه وفي منقارِ",13,"ر",1,0],["زجرتُه بشفاء قد أتاك كما","يُرضي علاك جميل الخُبر والخَبر",14,"ر",1,0],["زُجَلٌ وَرُفِّعَ في ظِلالِ حُدوجِها","بيضُ الخُدودِ حَديثُهُنَّ رَخيمُ",15,"م",1,0],["زُجَلاً كَأَنَّ نِعاجَ توضِحَ فَوقَها","وَظِباءَ وَجرَةَ عُطَّفاً آرامُها",16,"م",3,0],["زجرتُ ثناء الناس ثم انتجعته","ولم يتخالجني سَنيح وبارحُ",17,"ح",1,0],["زجرتْ بني وهبٍ عقولُهُمُ","أنْ يعْرِضوا لمغصَّة اللُّقَمِ",18,"م",1,0],["زَجَرتَ لَها طَيرَ السَنيحِ فَإِن تُصِب","هَواكَ الَّذي تَهوى يُصِبكَ اِجتِنابُها",19,"ب",3,0],["زَجَرتُ حَتّى النَومَ عَن مُقلَتي","وَلَم أُبالِ اللائِمَ الزاجِرا",20,"ر",2,0],["زَجِلَ الحُداءِ كَأَنَّ في حَيزومِهِ","قَصَباً وَمُقنِعَةَ الحَنينِ عَجولا",21,"ل",2,0],["زَجَرتُ تَصاريفَ الزَمانِ فَما يَقَع","لِيَ اليَومَ مِنها كانَ بِالأَمسِ لي وَهما",22,"م",2,0],["زَجَلٌ يُريكِ الجَوَّ ناراً وَالمَلا","كَالبَحرِ وَالتَلَعاتِ رَوضاً مُمرِعا",23,"ع",2,0],["زجاجة جوف مشكاة تضيء بها","مصباح زيت تجلي ظلمة الحلكِ",24,"ك",1,0],["زَجَرتُ عَلَيهِ وَالحَيّاتُ مَذلى","نَبيلَ الجَوزِ أَتلَعَ تَيَّحانِ",25,"ن",1,0],["زَجَرتُ عَلَيهِ حُرَّةً أَرحَبِيَّةً","وَقَد كانَ لَونُ اللَيلِ مِثلَ اليَرَندَجِ",26,"ج",1,0],["زَجَرَتني عَنِ التَشَفُّعِ نَفسٌ","مِنَنُ الناسِ عِندَها كَالمَنونِ",27,"ن",1,1],["زَجَرتُ مُرورَ طَيرِكُم بِسَعدٍ","فَهَلّا قَد زَجَرتَ بِذاكَ طَيري",28,"ر",2,1],["زجَرته أو نهرته أو","كفَّت على جُرمٍ يده",29,"ه",1,0],["زُجاجٌ وخَمرٌ وماءٌ كَما","تَقولُ هَيُولى وَنَفْسٌ وصُورَه",30,"ر",2,0],["زجاجُهُ يُسبك بعدَ الكسر","والدرُّ ما لكسرِهِ مِنْ جبرِ",31,"ر",1,0],["زَجِلِ الرُعودِ كَأَنَّما مَسَحَت بِهِ","كَفُّ الصَبا عَن ناقَةٍ عُشَراءِ",32,"ا",2,0],["زَجّوا المَلايينَ في أَعماقِها أُمَماً","يوفونَ بِالنذرِ إِن عُدّوا وَإِن حُسِبوا",33,"ب",3,0],["زَجّوا الجُيوشَ إِلى الوَغى فَأَبادَها","قَدَرٌ أَشَدُّ مِنَ الجُيوشِ وَأَفتَكُ",34,"ك",1,0],["زُجُّ القَناةِ مُشابِهٌ لِسِنانِها","حَتّى يَهُمَّ مُحارِبٌ أَن يُطعَنا",35,"ن",2,0],["زَجراً وَهَيهات لاتَ مُزدجِرٍ","أَيّة نَفس هَوجاء ازجرها",36,"ر",3,0],["زَجَرتُ بِهِ سِيّاحَ قَفرٍ كَأَنَّهُ","يَخافُ لَجاقاً أَو يُبادِرُ آفِلا",37,"ل",2,0],["زَجَرَ البِقاعَ بِرَعدِهِ","فَأَجَبنَهُ بِنَباتِ",38,"ت",1,0],["زَجَرْتَهُمْ بعقوباتٍ مُنَوَّعَةٍ","وفي العقوباتِ لِلطاغينَ مُزْدَجَرُ",39,"ر",1,0],["زَجِلٌ يُبِرِّحُ بالفضاءِ مَضِيقُهُ","فالسهْلُ يَمٌّ والجبِالُ بحار",40,"ر",1,0],["زَجَرتُ كِتابَكُم لَمّا أَتاني","بِزَجرِ سَوانِحِ الطَيرِ الجَواري",41,"ي",1,1],["زُجاجٌ إِن رَفِقتَ بِهِ وَإِلّا","رَأَيتَ ضُروبَه مُتَقَصِّماتِ",42,"ت",1,0],["زَجَرتُ لَكَ الزَمانَ فَلا تُضَيِّع","يَقينَ عِيافَتي وَصَحيحَ زَجري",43,"ي",1,0],["زَجَرَت قَواريها الزَواجِرُ بِالضُحى","وَالحادِثاتُ مِنَ الحِمامِ قَواري",44,"ي",1,0],["زُجِرَ الغُرابُ تَطَيُّراً وَنَقيضُهُ","ديكٌ لِأَهلِ الدارِ أَبيَضُ أَفرَقُ",45,"ق",1,0],["زَجَرتُهُما زَجرَ اِبنِ سَبعٍ سِباعَهُ","وَلَو فَهِما زَجري لَما قَبِلاهُ",46,"ل",3,0],["زَجرَ أَبِي عُروَةَ السِباعَ إِذا","أَشفَقَ أَن يلتَبِسنَ بِالغَنَمِ",47,"م",1,0],["زَجَرُوا اغْتِراباً مِن نَعِيبِ غُرابِهِمْ","وقَضَوا ببَيْنٍ مِن مُغرِّدِ بانِهَا",48,"ن",3,0],["زَجِلٌ يُرَدِّدُ فِي اللَّهَاةِ صَهِيلَهُ","رَفْعاً كَزَمْزَمَةِ الْحَبِيِّ الْمُرْعِدِ",49,"د",1,0],["زَجَرْتُ فؤَادِي أَنْ يَبوحَ بِحُزْنِهِ","فَبَاحَتْ بِهِ عَيْنِي وَلَم يَنْفَع الزَّجْرُ",50,"ر",1,0],["زَجَرْتُ الهَوَى إنّي أمرؤٌ لا يقودُني","هَوَايَ ولا رأيٌ إلى غَيْرِ مَطمَعِ",51,"ع",1,0],["زُجُّوا بهم في البحر زا","دًا، منه يشبَعُ كلُّ نُون",52,"ن",1,0],["زُجُّوا بقانونكم في البحر، والتمسوا","سواه حتى تنالوا عَطْفَ «مائيرا»",53,"ر",2,0],["زجلا ظلام الدين والدنيا به ... ملك لما قال الكرام فعول","فلو ان سفناً لم تحمل جيشه ... حملت عزائمه صباً وقبول",54,"ل",1,0],["زجوا الملايين في أعماقها أمماً","يوفون بالذر إن عدوا وإن حسبوا",55,"ب",3,0],["زجاجة للطيب مختومة","ليت أواني الطيب لم تختم",56,"م",1,0],["زَجَلٌ عَجزُهُ يُجاوِبُهُ دُف","ف لِخُوانٍ مَأدوبَةٍ وَزَميرُ",57,"ر",1,0],["زجرتُ تصاؤيفَ الزمانِ ، فما يقعْ","ليَ اليومَ منها كان بالأمس لي وهما",58,"م",2,0]]}