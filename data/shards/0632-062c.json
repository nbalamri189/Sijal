30500","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67322","الطويل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[105,"يا غاديا ببريد الشام ينتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54966&r=&rc=136",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[85,"إلى الله أَشكو مِن عَوادِي النَّوَى سهما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9625&r=&rc=115",""],[121,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[136,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[143,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[196,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[198,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[213,"زجرت عذولا رام صدي بعذله","https://www.aldiwan.net/poem37842.html","الطويل"],[238,"بث بثي شجني","https://www.aldiwan.net/poem18100.html","مجزوء الرمل"],[299,"تركت هوى بيض الطلى والترائب","https://www.aldiwan.net/poem36291.html","عموديه"],[306,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[319,"زجيت دهراً طويلاً في التماس أخ","https://www.aldiwan.net/poem62618.html","البسيط"],[354,"زجرت بحرا طمى عزا بساحة من","https://www.aldiwan.net/poem40010.html","البسيط"],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[365,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[365,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[381,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[381,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[417,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[417,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[433,"وغادة عادت الدنيا ببهجتها","https://www.aldiwan.net/poem12436.html","البسيط"],[459,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[459,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[462,"أحببته غمر الرداء والشيم","https://www.aldiwan.net/poem16104.html","الرجز"],[462,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[465,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[483,"زجاج القلب كأس في زمان","https://www.aldiwan.net/poem24487.html","عموديه"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[554,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[559,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[559,"زجاجتك أشرقت في وسط مشكاتك","https://www.aldiwan.net/poem34281.html","المواليا"],[563,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"]],"verses":[["زَجَرتُ السُرورَ فَما يُجتَنى","بِغَيرِ العُلى طَلَبي وَاِرتِياحي",0,"ح",2,0],["زَجَرتَ عَنّا اللَيالي وَهيَ رابِضَةٌ","تَقرو بِأَنيابِها عَقرَ المَخاليبِ",1,"ب",1,0],["زَجَرْتُ إليهِ نَاجِيَةً ذَمولاً","تُحاذِرُ أَنْ يُلِمَّ بِهِ القَطيعُ",2,"ع",1,0],["زَجَرْتُ إِليهِ أَصْهَبَ داعِرِيَّاً","مُرَاحَاً سَوْطُهُ تَعِبَ الخِطامِ",3,"م",1,0],["زَجَرْتُ إليكمْ كلَّ وَجْناءَ حُرّةٍ","وأدْهَمَ محْجولَ القوائِمِ أجْرَدا",4,"د",2,0],["زجَرْتُ القَوافي والمَطايا شَوارِداً","الى واحِدٍ في الرّوعِ يُغْني عنِ الألْفِ",5,"ف",1,0],["زَجِلُ الْجَنَاحِ إِذَا أَجَدَّ لِغَايَةٍ","وَإِذَا تَغَنَّى بِالصَّهِيلِ فَبُلُبُلُ",6,"ل",1,0],["زَجَرْتَ بِهَا الأسْطُولَ يَبْتَدِرُ الْعِدَى","وَيَمْضِي إِلَى مَا اعْتَادَهُ مِنْ فَعَالِهِ",7,"ل",2,0],["زجَرْنا بإبْراهيمَ بُرْءَ هُمومِنا","فلمّا رأينا وجْهَهُ صدَقَ الزّجْرُ",8,"ر",1,0],["زَجَرتُ عَلَيهِ حُرَّةَ اللَيطِ رَفَّعَت","عَلى رَبِذٍ كَأَنَّهُنَّ دَعائِمُ",9,"م",1,0],["زَجَرتُ عَلى ما لَدَيَّ القَلو","صَ مِن حَزَنٍ وَعَصَيتُ الشُؤونا",10,"ن",2,0],["زَجولٌ بِرِجلَيها نَهوزٌ بِرَأسِها","إِذا اِئتَزَرَ الحادي اِئتِزارَ المُصارِعِ",11,"ع",1,0],["زَجولٌ بِرِجلَيها نَغوضٌ بِرأسِها","إِذا أَفسَدَ الإِدلاجُ لَوثَ العَصآئِبِ",12,"ب",1,0],["زجِلُ الجناح مصفق كمن الردى","في مخلب منه وفي منقارِ",13,"ر",1,0],["زجرتُه بشفاء قد أتاك كما","يُرضي علاك جميل الخُبر والخَبر",14,"ر",1,0],["زُجَلٌ وَرُفِّعَ في ظِلالِ حُدوجِها","بيضُ الخُدودِ حَديثُهُنَّ رَخيمُ",15,"م",1,0],["زُجَلاً كَأَنَّ نِعاجَ توضِحَ فَوقَها","وَظِباءَ وَجرَةَ عُطَّفاً آرامُها",16,"م",3,0],["زجرتُ ثناء الناس ثم انتجعته","ولم يتخالجني سَنيح وبارحُ",17,"ح",1,0],["زجرتْ بني وهبٍ عقولُهُمُ","أنْ يعْرِضوا لمغصَّة اللُّقَمِ",18,"م",1,0],["زَجَرتَ لَها طَيرَ السَنيحِ فَإِن تُصِب","هَواكَ الَّذي تَهوى يُصِبكَ اِجتِنابُها",19,"ب",3,0],["زَجَرتُ حَتّى النَومَ عَن مُقلَتي","وَلَم أُبالِ اللائِمَ الزاجِرا",20,"ر",2,0],["زَجِلَ الحُداءِ كَأَنَّ في حَيزومِهِ","قَصَباً وَمُقنِعَةَ الحَنينِ عَجولا",21,"ل",2,0],["زَجَرتُ تَصاريفَ الزَمانِ فَما يَقَع","لِيَ اليَومَ مِنها كانَ بِالأَمسِ لي وَهما",22,"م",2,0],["زَجَلٌ يُريكِ الجَوَّ ناراً وَالمَلا","كَالبَحرِ وَالتَلَعاتِ رَوضاً مُمرِعا",23,"ع",2,0],["زجاجة جوف مشكاة تضيء بها","مصباح زيت تجلي ظلمة الحلكِ",24,"ك",1,0],["زَجَرتُ عَلَيهِ وَالحَيّاتُ مَذلى","نَبيلَ الجَوزِ أَتلَعَ تَيَّحانِ",25,"ن",1,0],["زَجَرتُ عَلَيهِ حُرَّةً أَرحَبِيَّةً","وَقَد كانَ لَونُ اللَيلِ مِثلَ اليَرَندَجِ",26,"ج",1,0],["زَجَرَتني عَنِ التَشَفُّعِ نَفسٌ","مِنَنُ الناسِ عِندَها كَالمَنونِ",27,"ن",1,1],["زَجَرتُ مُرورَ طَيرِكُم بِسَعدٍ","فَهَلّا قَد زَجَرتَ بِذاكَ طَيري",28,"ر",2,1],["زجَرته أو نهرته أو","كفَّت على جُرمٍ يده",29,"ه",1,0],["زُجاجٌ وخَمرٌ وماءٌ كَما","تَقولُ هَيُولى وَنَفْسٌ وصُورَه",30,"ر",2,0],["زجاجُهُ يُسبك بعدَ الكسر","والدرُّ ما لكسرِهِ مِنْ جبرِ",31,"ر",1,0],["زَجِلِ الرُعودِ كَأَنَّما مَسَحَت بِهِ","كَفُّ الصَبا عَن ناقَةٍ عُشَراءِ",32,"ا",2,0],["زَجّوا المَلايينَ في أَعماقِها أُمَماً","يوفونَ بِالنذرِ إِن عُدّوا وَإِن حُسِبوا",33,"ب",3,0],["زَجّوا الجُيوشَ إِلى الوَغى فَأَبادَها","قَدَرٌ أَشَدُّ مِنَ الجُيوشِ وَأَفتَكُ",34,"ك",1,0],["زُجُّ القَناةِ مُشابِهٌ لِسِنانِها","حَتّى يَهُمَّ مُحارِبٌ أَن يُطعَنا",35,"ن",2,0],["زَجراً وَهَيهات لاتَ مُزدجِرٍ","أَيّة نَفس هَوجاء ازجرها",36,"ر",3,0],["زَجَرتُ بِهِ سِيّاحَ قَفرٍ كَأَنَّهُ","يَخافُ لَجاقاً أَو يُبادِرُ آفِلا",37,"ل",2,0],["زَجَرَ البِقاعَ بِرَعدِهِ","فَأَجَبنَهُ بِنَباتِ",38,"ت",1,0],["زَجَرْتَهُمْ بعقوباتٍ مُنَوَّعَةٍ","وفي العقوباتِ لِلطاغينَ مُزْدَجَرُ",39,"ر",1,0],["زَجِلٌ يُبِرِّحُ بالفضاءِ مَضِيقُهُ","فالسهْلُ يَمٌّ والجبِالُ بحار",40,"ر",1,0],["زَجَرتُ كِتابَكُم لَمّا أَتاني","بِزَجرِ سَوانِحِ الطَيرِ الجَواري",41,"ر",2,1],["زُجاجٌ إِن رَفِقتَ بِهِ وَإِلّا","رَأَيتَ ضُروبَه مُتَقَصِّماتِ",42,"ت",1,0],["زَجَرتُ لَكَ الزَمانَ فَلا تُضَيِّع","يَقينَ عِيافَتي وَصَحيحَ زَجري",43,"ر",2,0],["زَجَرَت قَواريها الزَواجِرُ بِالضُحى","وَالحادِثاتُ مِنَ الحِمامِ قَواري",44,"ر",2,0],["زُجِرَ الغُرابُ تَطَيُّراً وَنَقيضُهُ","ديكٌ لِأَهلِ الدارِ أَبيَضُ أَفرَقُ",45,"ق",1,0],["زَجَرتُهُما زَجرَ اِبنِ سَبعٍ سِباعَهُ","وَلَو فَهِما زَجري لَما قَبِلاهُ",46,"ل",3,0],["زَجرَ أَبِي عُروَةَ السِباعَ إِذا","أَشفَقَ أَن يلتَبِسنَ بِالغَنَمِ",47,"م",1,0],["زَجَرُوا اغْتِراباً مِن نَعِيبِ غُرابِهِمْ","وقَضَوا ببَيْنٍ مِن مُغرِّدِ بانِهَا",48,"ن",3,0],["زَجِلٌ يُرَدِّدُ فِي اللَّهَاةِ صَهِيلَهُ","رَفْعاً كَزَمْزَمَةِ الْحَب