abudhabi.ae/diwan/poem/52131","الرمل"],[4754,"أعن العذول يطيق يكتم ما به","https://www.poetsgate.com/ViewPoem.aspx?id=162519",""],[5136,"حبه بالروح ممتزج","https://www.poetsgate.com/ViewPoem.aspx?id=121535",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5183,"الخد النضر","https://www.poetsgate.com/ViewPoem.aspx?id=186378",""],[5273,"عانس","https://www.poetsgate.com/ViewPoem.aspx?id=180576",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[2110,"زر دار مي وقف بالباب إن جازا","https://www.poetsgate.com/ViewPoem.aspx?id=156273",""],[5693,"فمشكاتي ومصباحي .","https://www.poetsgate.com/ViewPoem.aspx?id=34850",""],[5910,"لقد طال هذا اللَّيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=206275",""],[6024,"زجر الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=186348",""],[572,"صِينَتْ بمرفَعها الدواة ُ فَأصبَحَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9469&r=&rc=326",""]],"verses":[["زَجَرتُ السُرورَ فَما يُجتَنى","بِغَيرِ العُلى طَلَبي وَاِرتِياحي",0,"ح",2,0],["زَجَرتَ عَنّا اللَيالي وَهيَ رابِضَةٌ","تَقرو بِأَنيابِها عَقرَ المَخاليبِ",1,"ب",1,0],["زَجَرْتُ إليهِ نَاجِيَةً ذَمولاً","تُحاذِرُ أَنْ يُلِمَّ بِهِ القَطيعُ",2,"ع",1,0],["زَجَرْتُ إِليهِ أَصْهَبَ داعِرِيَّاً","مُرَاحَاً سَوْطُهُ تَعِبَ الخِطامِ",3,"م",1,0],["زَجَرْتُ إليكمْ كلَّ وَجْناءَ حُرّةٍ","وأدْهَمَ محْجولَ القوائِمِ أجْرَدا",4,"د",2,0],["زجَرْتُ القَوافي والمَطايا شَوارِداً","الى واحِدٍ في الرّوعِ يُغْني عنِ الألْفِ",5,"ف",1,0],["زَجِلُ الْجَنَاحِ إِذَا أَجَدَّ لِغَايَةٍ","وَإِذَا تَغَنَّى بِالصَّهِيلِ فَبُلُبُلُ",6,"ل",1,0],["زَجَرْتَ بِهَا الأسْطُولَ يَبْتَدِرُ الْعِدَى","وَيَمْضِي إِلَى مَا اعْتَادَهُ مِنْ فَعَالِهِ",7,"ل",2,0],["زجَرْنا بإبْراهيمَ بُرْءَ هُمومِنا","فلمّا رأينا وجْهَهُ صدَقَ الزّجْرُ",8,"ر",1,0],["زَجَرتُ عَلَيهِ حُرَّةَ اللَيطِ رَفَّعَت","عَلى رَبِذٍ كَأَنَّهُنَّ دَعائِمُ",9,"م",1,0],["زَجَرتُ عَلى ما لَدَيَّ القَلو","صَ مِن حَزَنٍ وَعَصَيتُ الشُؤونا",10,"ن",2,0],["زَجولٌ بِرِجلَيها نَهوزٌ بِرَأسِها","إِذا اِئتَزَرَ الحادي اِئتِزارَ المُصارِعِ",11,"ع",1,0],["زَجولٌ بِرِجلَيها نَغوضٌ بِرأسِها","إِذا أَفسَدَ الإِدلاجُ لَوثَ العَصآئِبِ",12,"ب",1,0],["زجِلُ الجناح مصفق كمن الردى","في مخلب منه وفي منقارِ",13,"ر",1,0],["زجرتُه بشفاء قد أتاك كما","يُرضي علاك جميل الخُبر والخَبر",14,"ر",1,0],["زُجَلٌ وَرُفِّعَ في ظِلالِ حُدوجِها","بيضُ الخُدودِ حَديثُهُنَّ رَخيمُ",15,"م",1,0],["زُجَلاً كَأَنَّ نِعاجَ توضِحَ فَوقَها","وَظِباءَ وَجرَةَ عُطَّفاً آرامُها",16,"م",3,0],["زجرتُ ثناء الناس ثم انتجعته","ولم يتخالجني سَنيح وبارحُ",17,"ح",1,0],["زجرتْ بني وهبٍ عقولُهُمُ","أنْ يعْرِضوا لمغصَّة اللُّقَمِ",18,"م",1,0],["زَجَرتَ لَها طَيرَ السَنيحِ فَإِن تُصِب","هَواكَ الَّذي تَهوى يُصِبكَ اِجتِنابُها",19,"ب",3,0],["زَجَرتُ حَتّى النَومَ عَن مُقلَتي","وَلَم أُبالِ اللائِمَ الزاجِرا",20,"ر",2,0],["زَجِلَ الحُداءِ كَأَنَّ في حَيزومِهِ","قَصَباً وَمُقنِعَةَ الحَنينِ عَجولا",21,"ل",2,0],["زَجَرتُ تَصاريفَ الزَمانِ فَما يَقَع","لِيَ اليَومَ مِنها كانَ بِالأَمسِ لي وَهما",22,"م",2,0],["زَجَلٌ يُريكِ الجَوَّ ناراً وَالمَلا","كَالبَحرِ وَالتَلَعاتِ رَوضاً مُمرِعا",23,"ع",2,0],["زجاجة جوف مشكاة تضيء بها","مصباح زيت تجلي ظلمة الحلكِ",24,"ك",1,0],["زَجَرتُ عَلَيهِ وَالحَيّاتُ مَذلى","نَبيلَ الجَوزِ أَتلَعَ تَيَّحانِ",25,"ن",1,0],["زَجَرتُ عَلَيهِ حُرَّةً أَرحَبِيَّةً","وَقَد كانَ لَونُ اللَيلِ مِثلَ اليَرَندَجِ",26,"ج",1,0],["زَجَرَتني عَنِ التَشَفُّعِ نَفسٌ","مِنَنُ الناسِ عِندَها كَالمَنونِ",27,"ن",1,1],["زَجَرتُ مُرورَ طَيرِكُم بِسَعدٍ","فَهَلّا قَد زَجَرتَ بِذاكَ طَيري",28,"ر",2,1],["زجَرته أو نهرته أو","كفَّت على جُرمٍ يده",29,"ه",1,0],["زُجاجٌ وخَمرٌ وماءٌ كَما","تَقولُ هَيُولى وَنَفْسٌ وصُورَه",30,"ر",2,0],["زجاجُهُ يُسبك بعدَ الكسر","والدرُّ ما لكسرِهِ مِنْ جبرِ",31,"ر",1,0],["زَجِلِ الرُعودِ كَأَنَّما مَسَحَت بِهِ","كَفُّ الصَبا عَن ناقَةٍ عُشَراءِ",32,"ا",2,0],["زَجّوا المَلايينَ في أَعماقِها أُمَماً","يوفونَ بِالنذرِ إِن عُدّوا وَإِن حُسِبوا",33,"ب",3,0],["زَجّوا الجُيوشَ إِلى الوَغى فَأَبادَها","قَدَرٌ أَشَدُّ مِنَ الجُيوشِ وَأَفتَكُ",34,"ك",1,0],["زُجُّ القَناةِ مُشابِهٌ لِسِنانِها","حَتّى يَهُمَّ مُحارِبٌ أَن يُطعَنا",35,"ن",2,0],["زَجراً وَهَيهات لاتَ مُزدجِرٍ","أَيّة نَفس هَوجاء ازجرها",36,"ر",3,0],["زَجَرتُ بِهِ سِيّاحَ قَفرٍ كَأَنَّهُ","يَخافُ لَجاقاً أَو يُبادِرُ آفِلا",37,"ل",2,0],["زَجَرَ البِقاعَ بِرَعدِهِ","فَأَجَبنَهُ بِنَباتِ",38,"ت",1,0],["زَجَرْتَهُمْ بعقوباتٍ مُنَوَّعَةٍ","وفي العقوباتِ لِلطاغينَ مُزْدَجَرُ",39,"ر",1,0],["زَجِلٌ يُبِرِّحُ بالفضاءِ مَضِيقُهُ","فالسهْلُ يَمٌّ والجبِالُ بحار",40,"ر",1,0],["زَجَرتُ كِتابَكُم لَمّا أَتاني","بِزَجرِ سَوانِحِ الطَيرِ الجَواري",41,"ر",2,1],["زُجاجٌ إِن رَفِقتَ بِهِ وَإِلّا","رَأَيتَ ضُروبَه مُتَقَصِّماتِ",42,"ت",1,0],["زَجَرتُ لَكَ الزَمانَ فَلا تُضَيِّع","يَقينَ عِيافَتي وَصَحيحَ زَجري",43,"ر",2,0],["زَجَرَت قَواريها الزَواجِرُ بِالضُحى","وَالحادِثاتُ مِنَ الحِمامِ قَواري",44,"ر",2,0],["زُجِرَ الغُرابُ تَطَيُّراً وَنَقيضُهُ","ديكٌ لِأَهلِ الدارِ أَبيَضُ أَفرَقُ",45,"ق",1,0],["زَجَرتُهُما زَجرَ اِبنِ سَبعٍ سِباعَهُ","وَلَو فَهِما زَجري لَما قَبِلاهُ",46,"ل",3,0],["زَجرَ أَبِي عُروَةَ السِباعَ إِذا","أَشفَقَ أَن يلتَبِسنَ بِالغَنَمِ",47,"م",1,0],["زَجَرْنَا بَنِي كَعْبٍ فَأَمَّا خِيَارُهُمْ","فَصَدُّوا ولَلْمَعْرُوفُ في النَّاسِ أَعْرَفُ",48,"ف",1,0],["زَجَرُوا اغْتِراباً مِن نَعِيبِ غُرابِهِمْ","وقَضَوا ببَيْنٍ مِن مُغرِّدِ بانِهَا",49,"ن",3,0],["زَجِلٌ يُرَدِّدُ فِي اللَّهَاةِ صَهِيلَهُ","رَفْعاً كَزَمْزَمَةِ الْحَبِيِّ الْمُرْعِدِ",50,"د",1,0],["زَجَرْتُ فؤَادِي أَنْ يَبوحَ بِحُزْنِهِ","فَبَاحَتْ بِهِ عَيْنِي وَلَم يَنْفَع الزَّجْرُ",51,"ر",1,0],["زَجَرْتُ الهَوَى إنّي أمرؤٌ لا يقودُني","هَوَايَ ولا رأيٌ إلى غَيْرِ مَطمَعِ",52,"ع",1,0],["زُجُّوا بهم في البحر زا","دًا، منه يشبَعُ كلُّ نُون",53,"ن",1,0],["زُجُّوا بقانونكم في البحر، والتمسوا","سواه حتى تنالوا عَطْفَ «مائيرا»",54,"ر",2,0],["زجلا ظلام الدين والدنيا به ... ملك لما قال الكرام فعول","فلو ان سفناً لم تحمل جيشه ... حملت عزائمه صباً وقبول",55,"ل",1,0],["زجوا الملايين في أعماقها أمماً","يوفون بالذر إن عدوا وإن حسبوا",56,"ب",3,0],["زجاجة للطيب مختومة","ليت أواني الطيب لم تختم",57,"م",1,0],["زَجَلٌ عَجزُهُ يُجاوِبُهُ دُف","ف لِخُوانٍ مَأدوبَةٍ وَزَميرُ",58,"ر",1,0],["زجرتُ تصاؤيفَ الزمانِ ، فما يقعْ","ليَ اليومَ منها كان بالأمس لي وهما",59,"م",2,0],["زجل له لحن يذكرنا","همس المنى في رونق العمر",60,"ر",1,0],["زجالْ جلالتنا المحبوبْ","حاملْ لوا جُند الشّعرا",61,"ر",2,0],["زجَتْه إليك أكفُّ القضاءِ","وتأتي بأقدامها الحائنونا",62,"ن",2,0],["زُجلاً تَراوَحَها الحُداةُ فَحَبسُها","وَضَحَ النَهارِ إِلى العَشِيِّ قَليلُ",63,"ل",1,0],["زجوكِ واأسفاهُ في","سجنِ التقاليد القديمه",64,"ه",1,0],["زَجَرْتُ عَذُولاً رامَ صَدّي بعَذْله","عن السُود هذا منه من بعض جهلِه",65,"ل",2,1],["زَجَّ بِي فِي فِتَنٍ","جَفْنُ ظَبْيٍ خَيْبَتِي",66,"ي",1,0],["زجرتُ فؤادي عن هوى الغيدِ فارعوى","وَقرَّ وَقبلاً كان قلْقَ الجوانب",67,"ب",1,0],["زَجراً لمن لَم يَنهه اِستحياؤه","عن أن يشافِه مثلكم بمريبِ",68,"ب",1,0],["زجيت دهراً طويلاً في التماس أخ","يرعى ودادي إذا ذو خلةٍ خانا",69,"ن",2,1],["زَجرت بَحراً طَمى عزّاً بِساحة من","فاق البِحار فَقال البَحر هيت لَكا",70,"ك",2,1],["زجَرْتُ بأرضِ خُوزِسْتانَ عَنْسي","مُروقَ السّهمِ أَسْلَمَه الحَنيّ",71,"ي",1,0],["زَجَرتُ إليه اليَعْمَلاتِ فَخوَّدَتْ","بصَحْبيَ أمثالَ النَّعامِ الجَوافل",72,"ل",1,0],["زجْرْتُ بالسّعدِ طَيْري منكَ مُغْتبِطاً","لمّا زَجرْتُ إلى ناديك أعياسي",73,"س",2,0],["زَجر الرَعد مُثقَلات الغَمامِ","وَحدتها السمال جَنح الظَلام",74,"م",1,1],["زجَ بي في لَجج الحُب","أَزج الحاجبين",75,"ن",1,0],["زجرت المطايا غير وانٍ فسرْ بها","على ضعفها لا بالذميل ولا الوخد",76,"د",1,0],["زجر العيس صاحبي يوم أقبل","نَ عليها فقلت مهلاً رويدا",77,"د",2,0],["زججت حاجباً فأصبح قوساً","فأراشت للعاشقين سهامه",78,"م",2,0],["زَجَرْتُ في شأْنِها الأَطيارَ ساجِعَةً","ولم يَخِبْ قَطُّ عندي زَجْرُ أَطيارِ",79,"ر",1,0],["زُجِرت باسمك أو طارت لها","يَمَنٌ قد عدِمت ميمونَها",80,"ن",3,0],["زجرتُ لكم طيرَ الميامن قبلها","وأعلمتكم أني بذاك عليمُ",81,"م",1,0],["زجرتُ باسمك دهري أو تمهَّدَ لي","والدهر باسم الكريم الحرِّ مزجورُ",82,"ر",1,0],["زجلِ الرُّعود يكاد يخْدج عنده","شاءُ المَلا ويموتُ سخْلُ المُرضِعِ",83,"ع",1,0],["زَجِلٌ كأنَّ الرَّعدَ فيه اِشارةٌ","يخشى الرَّقيب لها مُسِرٌّ مُدْ