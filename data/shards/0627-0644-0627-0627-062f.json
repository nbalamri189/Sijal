{"poems":[[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[50,"أدرها على الندمان نوحية العهد","https://www.aldiwan.net/poem62562.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[202,"ألا ادن وإن ضاق الندي فإنه","https://www.aldiwan.net/poem51851.html","الطويل"],[342,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48920","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4733,"إيلانُ عينُ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=188652",""],[4858,"دعاءٌ ورجاء","https://www.poetsgate.com/ViewPoem.aspx?id=139713",""],[5277,"كل فطر، تُقُبِّلَ منا ومنكم...","https://www.poetsgate.com/ViewPoem.aspx?id=213006",""]],"verses":[["ألا أدبِرْ جزاك اللهَ شرّا","ظَفِرتَ بصابرٍ وأبيت صبرا",0,"ر",2,0],["أَلا أَدنِها تَنأَ الهُمومُ لِقُربِها","فَتَنقُلَها مِن دارِ قُربٍ إِلى بُعدِ",1,"د",1,0],["ألا ادفعنَ هذا الرَّدى المشرئبَّ","وأمسِكنَ هذي اليدَ المُضعفَهْ",2,"ه",1,0],["ألا ادنُ وإن ضاق النَّديّ فإنه","رحيبٌ بودٍّ ضُمِّنَتْهُ الأضالعُ",3,"ع",1,1],["أَلا أَدلَجَت لَيلاكَ مِن غَيرِ مُدلِجٍ","هَوى نَفسَها إِذ أَدلَجَت لَم تُعَرِّجِ",4,"ج",1,0],["أّلا ادّرِعي الصبرَ لا كنفوس","حواسرَ في يأسها دُرّعِ",5,"ع",1,0],["ألا أدكري تلك الشؤون وجانبي","مخاتلتي فيما ابتغيت بجانبي",6,"ي",1,0],["ألا أدرَكتَ فِي الأموَاجِ صَمتا","وَرَملًا رضّهُ الجِسمُ الطَهورُ",7,"ر",1,0],["ألا ادعوا اللهَ يجمعُنا بخيرٍ","بأرض \" جنينَ \" لا نخشى أذيّة",8,"ي",2,1],["ألا ادعوا الذي لا يمنعُ الخيرَ عبدَهُ","ومَنْ مثلُهُ ذا واهبُ الخيرِ يمدحُ",9,"ح",1,0]]}