s://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[5829,"ارادة السمو","https://www.poetsgate.com/ViewPoem.aspx?id=156011",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5999,"إذا أنت جاوزت أمرأ السّوء لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=200860",""],[6124,"وريد","https://www.poetsgate.com/ViewPoem.aspx?id=120026",""],[6167,"جمهورية الخلفاء الراشدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85473&r=&rc=2",""],[6179,"يصيخُ للنبأة ِ أسماعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7623&r=&rc=6",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["وَفي نَظَري عُنوانُ ما بَينَ أَضلُعي","وَرُبَّ لَحاظٍ نائِبٍ عَن تَكَلُّمِ",0,"م",1,0],["وَفينا شَآبيبُ صَرفِ الزَمانِ","تَروى مِراراً وَتَظما مِرارا",1,"ر",2,0],["وَفي نَظَرِ الصادي إِلى الماءِ حَسرَةٌ","إِذا كانَ مَمنوعاً سَبِيلَ المَوارِدِ",2,"د",1,0],["وفِينا سَليلُ النّصْرِ يحْفَظُ منْكَ ما","أُضيعَ ويَلْقى فيكَ بالبَدرِ الوَفْدا",3,"د",2,0],["وفي نِسْبَةِ الأشْياءِ يظْهَرُ حُسْنُها","موحَّدَةٌ زفّتْ لخَيْرِ موَحِّدِ",4,"د",1,0],["وَفَينا إِلى قَومٍ عَلَيهِم مَهابَةٌ","إِذا ما مَعَدٌّ أَحلَبَت حَلَباتُها",5,"ت",3,0],["وَفي نَسجِ صَدّاحٍ أَتَيتَ بِآيَةٍ","مِنَ السَهلِ لا تَنقادُ لِاِبنِ المُقَفَّعِ",6,"ع",1,0],["وَفي نَفسِهِ العَلياءَ لي مُتَبَوَّأٌ","يُنافِسُني فيهِ السِماكانِ وَالنَسرُ",7,"ر",1,0],["وَفَينا كَما أَدَّت رَبيعَةُ خالِداً","إِلى قَومِهِ حَرباً وَإِن لَم يُسالِمِ",8,"م",1,0],["وفي نهاوند قد حلونُّا بمغتفر","زجر البوارح بالايمان والنعبِ",9,"ب",1,1],["وَفينا إِذا ما شُبَّتِ الحَربُ سادَةٌ","كُهولٌ وَفِتيانٌ طِوالُ الحَمائِلِ",10,"ل",1,0],["وفي نارِ المجوسِ لنا دليل","لأنفسهم بها ولها انطفاء",11,"ا",2,0],["وَفينا رَبُّ مِحرابٍ","وَفينا رَبُّ ماخورِ",12,"ر",1,0],["وَفي ناتِقٍ كانَ اِصطِلامُ سَراتِهِم","لَيالِيَ أَفنى القَرحُ جُلَّ إِيادِ",13,"د",1,1],["وَفينا السَيفُ حَملَتُهُ صَدوقٌ","إِذا لاقى وَغارَتُهُ لَجوجُ",14,"ج",1,0],["وَفينا مِنَ المِعزى تِلادٌ كَأَنَّها","ظَفارِيَّةُ الجَزعِ الَّذي في التَرائِبِ",15,"ب",1,0],["وَفَيْنا بميثاقِ العُهُود لربعها","كأنّ عهودَ الرّبْع كانت شرائعا",16,"ع",2,0],["وَفينا إِذا ما حادِثُ الدَهرِ أَجحَفَت","نَوائِبُهُ وَالدَهرُ جَمُّ التَنَقُّلِ",17,"ل",1,0],["وَفَيْنَا بالعُهودِ فضجَّ قومٌ","يَعُدّونَ الوفاءَ من الخطايا",18,"ا",3,0],["وَفَينا لِمِصرَ عَلى حالَةٍ","مِنَ الهَولِ قَذّافَةٍ بِالوُفاةِ",19,"ه",1,0],["وَفي نافِعٍ عَنّي جَفاءٌ وَإِنَّني","لأُطرِقُ أَحياناً وَذو اللُبِّ يُطرِقُ",20,"ق",1,0],["وفي نهديكِ طِلسما","نِ في حَلِّهما افتنَّا",21,"ن",2,0],["وَفِي نفسِهِ لِلأَرِيحِيَّةِ هِزَّةٌ","تَرَى إِثْرَهَا فِي وَجْهِهِ حِينَ تَسْتَجْلي",22,"ل",2,0],["وَفِينَا رسولُ اللهِ نَتْبَعُ أمْرَهُ","إذا قالَ فِينَا القولَ لا نَتَطَلَّعُ",23,"ع",1,0],["وَفِينَا رَسُولُ اللهِ والأوسُ حَوْلَهُ","لَهُ معقلٌ منهُمْ غَزِيرٌ وَنَاصِرُ",24,"ر",1,0],["وفي نَجِيّ القوافي هل وفيتَ له","ربّ الأريكة إذ وافى يُناجيها",25,"ي",3,0],["وفي نهايته ، جاءت تسائله","عن هرّها لم يزرنا ، فاتنا الشرف",26,"ف",1,0],["وفينا بمثياقِ العهود لربعها","كأنَّ عهودَ الرّبْع كانت شرائعا",27,"ع",2,0],["وفي نهدي منعّمة لعوب","وفي ماء الخدود وفي لظاها",28,"ا",3,0],["وفي نفسي السماء وفرقداها","ومن سمك السماء ومن رقاها",28,"ا",3,0],["وفينا الخير موجودٌ","ومنا الشر مجلوب",29,"ب",1,0],["وفي نَسبي وفي حَسبي ونَفسِى","مَقَامٌ لاَ يُقَصِّرُ عَن مَقَامِ",30,"م",1,0],["وفي نَسَيجِ القَوَافي","وفي فُنُونِ اللُّغَاتِ",31,"ت",1,0],["وَفَينا وَلَم نَسمَع مَقالَةَ قائِلٍ","إِذا ظَلَمَ المَفقودُ لَم يُؤلِمِ الفَقدُ",32,"د",1,0],["وَفي نَبَهٍ لَم يَختَلِط بِسِناتِهِ","شَهِدتُ بِهَذا مُرغِماً لِشُناتِهِ",33,"ه",1,0],["وفي نفسي جذب إذا انهمر الحيا","ومن مدمعي خصب إذا أمسك القطر",34,"ر",1,0],["وفي نزول الخانِ عارٌ وفي","أمثالِكُم نارٌ ولا عارُ",35,"ر",1,0],["وَفي نُصرةِ الإسلامِ لمّا تَصدّروا","تَبوّأ كلٌّ من محافلهِ الصدرا",36,"ر",2,0],["وَفي نَشرها بالسيفِ نالت جزاءَها","فَما حَمِدت مِن كُفرها الحشرَ والنشرا",36,"ر",2,0],["وفينا نشرت العدل من بعد طيه","فوافى ومنه نشره يتضوع",37,"ع",1,0],["وفي نحره عتب وخمسون آهة","فيا ويلتي من فاتن الروح بالنحر",38,"ر",1,0],["وَفينا حَزازاتٌ إِلى البَغي تَنتَمي","وَفينا شفاهٌ من طِلى الحِقدِ ريقُها",39,"ق",3,0],["وفينا الإمامة لا فيكمُ","ونحن أحقُّ بجِلْبابها",40,"ب",3,0],["وَفِي نَجْمٍ يُرَى فَتَغِيبُ شَمْسٌ","بِإِثْرِ طُلُوعِهِ فَإِذَا الْبَيَاتُ",41,"ت",1,0],["وَفِي نَاعُورَةٍ أَبْدَتْ حَنِيناً","كَمُعْوِلَةٍ أُصِيبَ لَهَا بَنَاتُ",41,"ت",1,0],["وَفِئنَ غَداةَ زُرنَ بَني عُقَيلٍ","وَقَد هَدَّمنَ أَبياتاً وَدورا",42,"ر",2,0],["وفي نصب محرابٍ بجامع صولةٍ","تصلّي سيوفُ الهند وهو إمام",43,"م",1,0],["وفي نظمِ المدائحِ والمراثي","رأيتُ الشعرَ مرآةَ الرياء",44,"ا",2,0],["وفي نورِهِ ما في اللِّحاظِ من الهوى","وفي غَزلي قلبي عليكِ يذوب",45,"ب",1,0],["وفي نسيمٍ لهُ في الدَّوحِ هَينمةٌ","كأنها لحنُ تَطريبٍ نُوقِّعه",46,"ع",2,0],["وفينا صِراعُ الخيرِ والشرِّ دائمٌ","وما زالَ فكرُ الخيرِ من ضِعفِنا يَخسر",47,"ر",1,0],["وَفي نومي المشرَّدِ لا","تَزالُ النفسُ تحلم بكْ",48,"ك",1,0],["وفي نعم تترى وعز ورفعةً","تدوم على رغم الحسود المجانب",49,"ب",1,0],["وَفينا كِتابُ اللَهِ يَنزِلُ صادِقاً","وَفينا الهُدى وَالوَحيُ وَالخَيرُ يُذكَرُ",50,"ر",1,0],["وَفي نَطقِ كُلِّ لِسانٍ لَهُ","لِسانٌ مُخاطِبُهُ يُخبِرُ",51,"ر",1,0],["وَفي نَواحي السَنَد وَالنُ","وَبِ وَفي أَرضِ الخَذَر",52,"ر",1,0],["وَفينا تَرى الطولى وَكُلَّ سَمَيدَعٍ","مُدَرَّبِ حَربٍ وَاِبنِ كُلِّ مُدَرَّبِ",53,"ب",1,0],["وَفينا رِباطُ الخَيلِ كُلَّ مُطَهَّمٍ","رَجيلٍ كَسِرحانِ الغَضا المُتَأَوِّبِ",53,"ب",1,0],["وفي نَسْخِ ما يُمليهِ ما يَغلطُ الحَيا","فَيعرِضُ في بَعْضِ البلادِ مُحول",54,"ل",1,0],["وَفينا وَإِن هُنا عَلَيكُم تَجلدٌ","وَلَكن عَلى الأَعراض لَيسَ لَنا صَبرُ",55,"ر",1,0],["وفي نفاق وفي كبره وفي طمع","وفي الريا والتفاخر والمباهات",56,"ت",1,0],["وفي نكوث وفي غد واصرار","وفي الخيانة مع مكر وروغات",56,"ت",1,0],["وفي نفسك تفكر","ففيك أشيا عجيبات",57,"ت",1,0],["وفي نسيان للمولى تعالى","وللاخرى وللموت المهيب",58,"ب",1,0],["وفي نظرٍ من عين لطفك ش