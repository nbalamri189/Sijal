{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[55,"ومختلس بالطرف ما لا يناله","https://www.aldiwan.net/poem26401.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[9,"أجد بتيا هجرها وشتاتها","https://www.aldiwan.net/poem21916.html","الطويل"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[37,"وفي نهاوند قد حلونا بمغتفر","https://www.aldiwan.net/poem6508.html","البسيط"],[23,"أهاجك بالبيداء رسم المنازل","https://www.aldiwan.net/poem21249.html","الطويل"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[38,"وفي ناتق كان اصطلام سراتهم","https://www.aldiwan.net/poem7704.html","الطويل"],[43,"لهذا اليوم بعد غد أريج","https://www.aldiwan.net/poem9519.html","الوافر"],[28,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[80,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[105,"لئن ظهرت لنا رغبات قوم","https://www.aldiwan.net/poem42137.html","الوافر"],[105,"أما والليالي وأحداثها","https://www.aldiwan.net/poem43141.html","المتقارب"],[50,"مواعيد حماد سماء مخيلة","https://www.aldiwan.net/poem62311.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[80,"مرابعهم للوحش أضحتْ مراتعا","https://www.poetsgate.com/ViewPoem.aspx?id=3351",""],[94,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[121,"بأيدينا قلوبكم","https://www.aldiwan.net/poem49311.html","مجزوء الوافر"],[133,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[133,"يا عاليا كل عال","https://www.aldiwan.net/poem54869.html","المجتث"],[144,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[151,"أنفت لقول حاد عن سمت قصده","https://www.aldiwan.net/poem68593.html","الطويل"],[161,"عيون مها يجلو ظبا لحظها السحر","https://www.aldiwan.net/poem58953.html","الطويل"],[167,"غريبكم ليس له دار","https://www.aldiwan.net/poem47069.html","السريع"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"طلائعنا بالبشر والسعد تطلع","https://www.aldiwan.net/poem13455.html","الطويل"],[212,"سلام على البحر الخضم وموجه","https://www.aldiwan.net/poem46233.html","الطويل"],[224,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[230,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[238,"ألا اسمع قد أجابتك الهداة","https://www.aldiwan.net/poem18096.html","الوافر"],[250,"ألا بلحت خفارة آل لأم","https://www.aldiwan.net/poem2117.html","الوافر"],[260,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[271,"أهذا الشعر يصلح للبقاء","https://www.aldiwan.net/poem35074.html","الوافر"],[271,"حذار فأحداق الملاح حبوب","https://www.aldiwan.net/poem35457.html","الطويل"],[271,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[271,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[299,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[305,"جزى الله خيرا سيدا وابن سيد","https://www.aldiwan.net/poem16831.html","الطويل"],[310,"أنا ابن علي الحبر من آل هاشم","https://www.aldiwan.net/poem50308.html","الطويل"],[350,"على كل عين من الخلق عين","https://www.aldiwan.net/poem15702.html","المتقارب"],[350,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[364,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[365,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[381,"نسبتم إلى المقهور ما اقترف الدهر","https://www.aldiwan.net/poem48761.html","الطويل"],[392,"يا حسرتي ضاع عمري في البطالات","https://www.aldiwan.net/poem54608.html","عموديه"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[392,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[417,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[417,"أحبتنا أنتم على السخط والرضا","https://www.aldiwan.net/poem53975.html","الطويل"],[417,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[433,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[438,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[438,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[442,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[459,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[516,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[552,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"]],"verses":[["وَفي نَظَري عُنوانُ ما بَينَ أَضلُعي","وَرُبَّ لَحاظٍ نائِبٍ عَن تَكَلُّمِ",0,"م",1,0],["وَفينا شَآبيبُ صَرفِ الزَمانِ","تَروى مِراراً وَتَظما مِرارا",1,"ر",2,0],["وَفي نَظَرِ الصادي إِلى الماءِ حَسرَةٌ","إِذا كانَ مَمنوعاً سَبِيلَ المَوارِدِ",2,"د",1,0],["وفِينا سَليلُ النّصْرِ يحْفَظُ منْكَ ما","أُضيعَ ويَلْقى فيكَ بالبَدرِ الوَفْدا",3,"د",2,0],["وفي نِسْبَةِ الأشْياءِ يظْهَرُ حُسْنُها","موحَّدَةٌ زفّتْ لخَيْرِ موَحِّدِ",4,"د",1,0],["وَفَينا إِلى قَومٍ عَلَيهِم مَهابَةٌ","إِذا ما مَعَدٌّ أَحلَبَت حَلَباتُها",5,"ت",3,0],["وَفي نَسجِ صَدّاحٍ أَتَيتَ بِآيَةٍ","مِنَ السَهلِ لا تَنقادُ لِاِبنِ المُقَفَّعِ",6,"ع",1,0],["وَفي نَفسِهِ العَلياءَ لي مُتَبَوَّأٌ","يُنافِسُني فيهِ السِماكانِ وَالنَسرُ",7,"ر",1,0],["وَفَينا كَما أَدَّت رَبيعَةُ خالِداً","إِلى قَومِهِ حَرباً وَإِن لَم يُسالِمِ",8,"م",1,0],["وفي نهاوند قد حلونُّا بمغتفر","زجر البوارح بالايمان والنعبِ",9,"ب",1,1],["وَفينا إِذا ما شُبَّتِ الحَربُ سادَةٌ","كُهولٌ وَفِتيانٌ طِوالُ الحَمائِلِ",10,"ل",1,0],["وفي نارِ المجوسِ لنا دليل","لأنفسهم بها ولها انطفاء",11,"ا",2,0],["وَفينا رَبُّ مِحرابٍ","وَفينا رَبُّ ماخورِ",12,"ر",1,0],["وَفي ناتِقٍ كانَ اِصطِلامُ سَراتِهِم","لَيالِيَ أَفنى القَرحُ جُلَّ إِيادِ",13,"د",1,1],["وَفينا السَيفُ حَملَتُهُ صَدوقٌ","إِذا لاقى وَغارَتُهُ لَجوجُ",14,"ج",1,0],["وَفينا مِنَ المِعزى تِلادٌ كَأَنَّها","ظَفارِيَّةُ الجَزعِ الَّذي في التَرائِبِ",15,"ب",1,0],["وَفَيْنا بميثاقِ العُهُود لربعها","كأنّ عهودَ الرّبْع كانت شرائعا",16,"ع",2,0],["وَفينا إِذا ما حادِثُ الدَهرِ أَجحَفَت","نَوائِبُهُ وَالدَهرُ جَمُّ التَنَقُّلِ",17,"ل",1,0],["وَفَيْنَا بالعُهودِ فضجَّ قومٌ","يَعُدّونَ الوفاءَ من الخطايا",18,"ا",3,0],["وَفَينا لِمِصرَ عَلى حالَةٍ","مِنَ الهَولِ قَذّافَةٍ بِالوُفاةِ",19,"ه",1,0],["وَفي نافِعٍ عَنّي جَفاءٌ وَإِنَّني","لأُطرِقُ أَحياناً وَذو اللُبِّ يُطرِقُ",20,"ق",1,0],["وفي نهديكِ طِلسما","نِ في حَلِّهما افتنَّا",21,"ن",2,0],["وَفِي نفسِهِ لِلأَرِيحِيَّةِ هِزَّةٌ","تَرَى إِثْرَهَا فِي وَجْهِهِ حِينَ تَسْتَجْلي",22,"ل",2,0],["وَفِينَا رسولُ اللهِ نَتْبَعُ أمْرَهُ","إذا قالَ فِينَا القولَ لا نَتَطَلَّعُ",23,"ع",1,0],["وَفِينَا رَسُولُ اللهِ والأوسُ حَوْلَهُ","لَهُ معقلٌ منهُمْ غَزِيرٌ وَنَاصِرُ",24,"ر",1,0],["وفي نَجِيّ القوافي هل وفيتَ له","ربّ الأريكة إذ وافى يُناجيها",25,"ي",3,0],["وفي نهايته ، جاءت تسائله","عن هرّها لم يزرنا ، فاتنا الشرف",26,"ف",1,0],["وفينا بمثياقِ العهود لربعها","كأنَّ عهودَ الرّبْع كانت شرائعا",27,"ع",2,0],["وفي نهدي منعّمة لعوب","وفي ماء الخدود وفي لظاها",28,"ا",3,0],["وفي نفسي السماء وفرقداها","ومن سمك السماء ومن رقاها",28,"ا",3,0],["وفينا الخير موجودٌ","ومنا الشر مجلوب",29,"ب",1,0],["وفي نَسبي وفي حَسبي ونَفسِى","مَقَامٌ لاَ يُقَصِّرُ عَن مَقَامِ",30,"م",1,0],["وفي نَسَيجِ القَوَافي","وفي فُنُونِ اللُّغَاتِ",31,"ت",1,0],["وَفَينا وَلَم نَسمَع مَقالَةَ قائِلٍ","إِذا ظَلَمَ المَفقودُ لَم يُؤلِمِ الفَقدُ",32,"د",1,0],["وَفي نَبَهٍ لَم يَختَلِط بِسِناتِهِ","شَهِدتُ بِهَذا مُرغِماً لِشُناتِهِ",33,"ه",1,0],["وفي نفسي جذب إذا انهمر الحيا","ومن مدمعي خصب إذا أمسك القطر",34,"ر",1,0],["وفي نزول الخانِ عارٌ وفي","أمثالِكُم نارٌ ولا عارُ",35,"ر",1,0],["وَفي نُصرةِ الإسلامِ لمّا تَصدّروا","تَبوّأ كلٌّ من محافلهِ الصدرا",36,"ر",2,0],["وَفي نَشرها بالسيفِ نالت جزاءَها","فَما حَمِدت مِن كُفرها الحشرَ والنشرا",36,"ر",2,0],["وفينا نشرت العدل من بعد طيه","فوافى ومنه نشره يتضوع",37,"ع",1,0],["وفي نحره عتب وخمسون آهة","فيا ويلتي من فاتن الروح بالنحر",38,"ر",1,0],["وَفينا حَزازاتٌ إِلى البَغي تَنتَمي","وَفينا شفاهٌ من طِلى الحِقدِ ريقُها",39,"ق",3,0],["وفينا الإمامة لا فيكمُ","ونحن أحقُّ بجِلْبابها",40,"ب",3,0],["وَفِي نَجْمٍ يُرَى فَتَغِيبُ شَمْسٌ","بِإِثْرِ طُلُوعِهِ فَإِذَا الْبَيَاتُ",41,"ت",1,0],["وَفِي نَاعُورَةٍ أَبْدَتْ حَنِيناً","كَمُعْوِلَةٍ أُصِيبَ لَهَا بَنَاتُ",41,"ت",1,0],["وَفِئنَ غَداةَ زُرنَ بَني عُقَيلٍ","وَقَد هَدَّمنَ أَبياتاً وَدورا",42,"ر",2,0],["وفي نصب محرابٍ بجامع صولةٍ","تصلّي سيوفُ الهند وهو إمام",43,"م",1,0],["وفي نظمِ المدائحِ والمراثي","رأيتُ الشعرَ مرآةَ الرياء",44,"ا",2,0],["وفي نورِهِ ما في اللِّحاظِ من الهوى","وفي غَزلي قلبي عليكِ يذوب",45,"ب",1,0],["وفي نسيمٍ لهُ في الدَّوحِ هَينمةٌ","كأنها لحنُ تَطريبٍ نُوقِّعه",46,"ع",2,0],["وفينا صِراعُ الخيرِ والشرِّ دائمٌ","وما زالَ فكرُ الخيرِ من ضِعفِنا يَخسر",47,"ر",1,0],["وَفي نومي المشرَّدِ لا","تَزالُ النفسُ تحلم بكْ",48,"ك",1,0],["وفي نعم تترى وعز ورفعةً","تدوم على رغم الحسود المجانب",49,"ب",1,0],["وَفينا كِتابُ اللَهِ يَنزِلُ صادِقاً","وَفينا الهُدى وَالوَحيُ وَالخَيرُ يُذكَرُ",50,"ر",1,0],["وَفي نَطقِ كُلِّ لِسانٍ لَهُ","لِسانٌ مُخاطِبُهُ يُخبِرُ",51,"ر",1,0],["وَفي نَواحي السَنَد وَالنُ","وَبِ وَفي أَرضِ الخَذَر",52,"ر",1,0],["وَفينا تَرى الطولى وَكُلَّ سَمَيدَعٍ","مُدَرَّبِ حَربٍ وَاِبنِ كُلِّ مُدَرَّبِ",53,"ب",1,0],["وَفينا رِباطُ الخَيلِ كُلَّ مُطَهَّمٍ","رَجيلٍ كَسِرحانِ الغَضا المُتَأَوِّبِ",53,"ب",1,0],["وفي نَسْخِ ما يُمليهِ ما يَغلطُ الحَيا","فَيعرِضُ في بَعْضِ البلادِ مُحول",54,"ل",1,0],["وَفينا وَإِن هُنا عَلَيكُم تَجلدٌ","وَلَكن عَلى الأَعراض لَيسَ لَنا صَبرُ",55,"ر",1,0],["وفي نفاق وفي كبره وفي طمع","وفي الريا والتفاخر والمباهات",56,"ت",1,0],["وفي نكوث وفي غد واصرار","وفي الخيانة مع مكر وروغات",56,"ت",1,0],["وفي نفسك تفكر","ففيك أشيا عجيبات",57,"ت",1,0],["وفي نسيان للمولى تعالى","وللاخرى وللموت المهيب",58,"ب",1,0],["وفي نظرٍ من عين لطفك شاملي","لقد كنتُ مرعِيًّا وقد كنتَ راعيا",59,"ي",2,0],["وَفَيْنا على صدق الهوى وغدرتمُ","وفزتُمْ لدينا بالجوى ونخيب",60,"ب",1,0],["وفينا كلُّ مبتهج خليعٍ","طروب شبَّ عارضه وشابا",61,"ب",2,0],["وفي نظمِ القريضِ فمَنْ حبيبٌ","وبشارُ بنُ بردٍ وابنُ هاني",62,"ن",2,0],["وفينا العلوم وفينا الحكوم","تليد وطار فيها المكتسب",63,"ب",1,0],["وفي نوال صلاح الدين غزُر غنىً","منه الأمان لوقع الحادثِ الجلَلِ",64,"ل",1,0],["وفي نِجادِي جريُّ الإِلفِ مُقْدِمُهُ","وَفِي عِناني مُشيحُ الجذْلِ دارِعُهُ",65,"ع",2,0],["وفي نخيلة وقد الجن وافقه","لما من الطائف الأعلى رأى الحنقا",66,"ق",2,0],["وَفَى ناهضاً بك حتى رددتَ","صروفَك عنه رَذايا وحَسرَى",67,"ر",2,0],["وفي نُوامِ هذا الليل شمسٌ","وَفَى سهري لها وجَفَا وسادي",68,"د",2,0],["وفي نُكَتِ البيانِ أبانَ فضلاً","بمُختَصرٍ حوى حِكَما غِزارا",69,"ر",2,0],["وف ينصرهم سارت بنوك مواكباً","إلى عرب الريفين فوق عراب",70,"ب",1,0],["وَفَيْنا على تلك الهَناتِ وأعرضَتْ","طرائقنا عن بعض تلك الطّرائقِ",71,"ق",1,0],["وفي ناعورةٍ بتنا","بأعلى ذلك المقسمْ",72,"م",1,0],["وفي نابُلْسَ قد حطَّت","بنا الخيلُ التي تُكرمْ",72,"م",1,0],["وفينا الهاشمية من قريش","مناسبة نفت سحر النوافث",73,"ث",1,0],["وفي نعم في الحسن كالبدر يجتلي","وإِنْ شِئْتَ طَعماً فهو كالشُّهِدِ يُشَتَارُ",74,"ر",1,0]]}