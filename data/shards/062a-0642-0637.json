,""]],"verses":[["تَقَطَّعَت بَينَهُما","بِالقُضُبِ الوَسائِلُ",0,"ل",1,0],["تَقَطَّعَتِ الأَطماعُ فيكُم وَلَم يَدَع","لَكُم أَمَلاً لُؤمُ الطِباعِ الحَوابِثِ",1,"ث",1,0],["تَقَطَّعَتِ الأَسبابُ بَيني وَبَينَهُ","فَلَم تَبقَ إِلّا عُلقَةٌ لِلمَناسِبِ",2,"ب",1,0],["تَقَطَّعُ حَسرَةً نَفسي عَلَيهِ","وَلَيسَ إِلى عِيادَتِهِ سَبيلُ",3,"ل",1,0],["تَقطَعُ الخَرقَ إِذا ما هَجَّرَت","بِهِبابٍ وَإِرانٍ وَمَرَح",4,"ح",1,0],["تَقطَعُ الأَمعَزَ المُكَوكِبَ وَخداً","بِنَواجٍ سَريعَةِ الإيغالِ",5,"ل",1,0],["تَقَطَّعُ أَسبابُ اللُبانَةِ وَالهَوى","عَشِيَّةَ جاوَزنا حَماةَ وَشَيزَرا",6,"ر",2,0],["تُقَطِّعُ غيطاناً كَأَنَّ مُتونَه","إِذا أَظهَرَت تُكسي مُلاءً مُنَشَّرا",6,"ر",2,0],["تَقَطَّعَ مِن ظَلّامَةَ الوَصلُ أَجمَعُ","أَخيراً عَلى أَن لَم يَكُن يَتَقَطَّعُ",7,"ع",1,1],["تُقَطِّعُ أَعناقَ الرِكابِ وَلا تَرى","عَلى السَيرِ إِلاّ صِلدِماً ما تُزَيِّلُ",8,"ل",1,0],["تقطع في الليل الأنين كأنّها","تقطّع أحشائي بسيف مُثَلَّم",9,"م",1,0],["تَقَطَّعَ فيهِ مُنزَلُ الوَحيِ عَنهُمُ","وَقَد كانَ ذا نورٍ يَغورُ وَيُنجِدُ",10,"د",1,0],["تقطع الليل ومَن تأ","وي إليه في هَزاهز",11,"ز",1,0],["تَقطَعُ الدَرَبَ عَلى الفَلاح وَالمَولى المَهابِ","صُنتُ عَنها حُرَّ وَجهي فَتَصَدَّت لِثِيابي",12,"ب",2,0],["تَقَطَّعَتِ الأَسبابُ بَيني وَبَينَهُم","فَلَيسَ لَهُم نَحوي وُصولٌ وَلا لِيا",13,"ي",2,0],["تَقْطيعُ أَنْفاسِكَ في أًثْرِهِمْ","ومَلْكِهِمْ قَطّعَ أَنْفاسِي",14,"س",2,0],["تَقَطَّعَ مالا يَقطَعُ الدِرعَ وَالقَنا","وَفَرَّ مِنَ الأَبطالِ مَن لا يُصادِمُ",15,"م",1,0],["تَقَطَّعَتِ الأَسبابُ بِالقَومِ وَاِنتَهَوا","إِلى حَدَثٍ مِن نَبوَةِ الدَهرِ فادِحِ",16,"ح",1,0],["تُقَطِّعُ لِلَّهوِ أَعناقَها","إِذا ما تَسَمَّعنَ لِلمُنشِدِ",17,"د",1,0],["تَقَطَّعَ مِنهُمُ سَبَبَ الرَ","جاءِ فَضُيِّعوا وَجُفوا",18,"ف",3,0],["تَقْطفُ من هامتها فَضْلَةً","قطفكَ بالمقراض رأسَ القلم",19,"م",1,0],["تَقَطَّعَتِ الأَسبابُ إِن لَم تُغرِ لَها","قُوىً وَيَصِلها مِن يَمينِكَ واصِلُ",20,"ل",1,0],["تُقَطِّعُ آفاقَ البِلادِ سَوابِقاً","وَما اِبتَلَّ مِنها لا عِذارٌ وَلا خَدُّ",21,"د",1,0],["تَقَطَّعَ إِلّا بِالكِتابِ عِتابُكُم","سِوى ذِكرٍ لا أَستَطيعُ لَها رَدّا",22,"د",2,0],["تَقَطَّعُ نَفسي حَسرَةً بَعدَ حَسرَةٍ","إِذا قيلَ تَغدو مِن غَدٍ لا تُعَرِّجُ",23,"ج",1,0],["تَقَطَّعَ قَلبي زَفرَةً بَعدَ زَفرَةٍ","عَلَيها وَما صَبري عَلى الزَفَراتِ",24,"ت",1,0],["تَقطَعونَ البِلادَ بَطناً وَظَهراً","إِنَما سَعيُكُم لِفَرجٍ وَبَطنِ",25,"ن",1,0],["تقطع منه كل يوم مدينة","وَما الكف إلا أصبع ثم أصبع",26,"ع",1,0],["تَقَطَّعُ من وقع الهموم قلوبُها","وتنضج من نار العذاب جلودها",27,"د",3,0],["تقطع الإفريز من ناحيتي","كأسيرٍ هاربٍ من آسرِ",28,"ر",1,0],["تقْطَعُ في لُقْياكَ دَوّيّةً","يَذُمّها الحافِرُ والمَنْسِمُ",29,"م",1,0],["تُقَطِّعُ غيطاناً كَأَنَّ مُتونَها","إِذا أَظهَرَت تُكسي مُلاءً مُنَشَّرا",30,"ر",2,0],["تَقطَّعُ نفْسِي كُلَّ يوم وليْلة","ٍإليكِ منوطاً بالأمانيِّ خلَّبا",31,"ب",2,0],["تقطع الإفريز من ناحيتي","كأسير هارب آسر",32,"ر",1,0],["تقطن لها في شعرها فهي شاعر","لها في أساليب النصيح قصيد",33,"د",1,0],["تقطع أحشائي إذا ما افتقدتها","ويصرم أنفاسي الحنين المخامر",34,"ر",1,0],["تَقطَعُ البِيدَ كَالجَهَامِ إنسِلاَلاً","وَزَفِيفاً وَغلوَةً ورَسِيمَا",35,"م",2,0],["تَقطَعُ الأَهوالَ نَحوي وَكانَت","عِندَنا سَلمى أُلوفَ الحِجالِ",36,"ل",1,0],["تَقَطَّعَت أَنفُسُ الأَعداءِ مِن صِلَةٍ","يَظَلُّ يَحسُدُ عَدنانَ بِها أُدَدا",37,"د",2,0],["تقطعه عمرا بعيش منكد","تحكم فيه مسرف في ابتلائها",38,"ا",3,0],["تَقطع شكلها في الصل ظفراً","فما تلقى لها في الجَرد شَكلا",39,"ل",2,0],["تقطَّعَ حَبلُ الوَصلِ مِنَّا وَمِنهُمُ","سِوى شَجنِ الذِّكرى أَقام وَأَقعَدا",40,"د",2,0],["تَقَطَّع في فيّ اسمُهُ إذ ذكرتُه","بتقطيع أنفاسي له الصُّعَداءِ",41,"ا",2,0],["تَقَطَّعَ باقي وَصلِ أُمِّ مُؤَمَّلٍ","بِعاقِبَةٍ وَاِستَبدَلَت نِيَّةً خُلفا",42,"ف",2,1],["تقطع الدهر كله في غناء","دونه الخندريس والأكواب",43,"ب",1,0],["تَقطر الحمّة المسعّرة الشَهّ","اءُ مِنهُ كَأَنَّهُ في هَجيرِ",44,"ر",1,0],["تقطع بالأشواق أرواحُنا","إليه ما لا تقطع السبّق",45,"ق",1,0],["تَقَطَّعَ جِلدُهَا جَرَباً وحَكّاً","إذا هُزِلَت وفي غَيرِ الهُزالِ",46,"ل",1,0],["تَقَطَّعَ بَيْنَ حَبْلِكَ وَاللَّيالِي","كَذاكَ الدَّهْرُ لَيْسَ لَهُ خَلِيلُ",47,"ل",1,0],["تقطعُ الأَرضَ وِهاداً ورُبى","وَلَها في لجِّ بَحر الآلِ سَبحُ",48,"ح",1,0],["تقطَّعتْ كلُّ أسبابِ الرجاءِ بنا","هَيِّيءْ لنا ربَّنا من أمرِنا رشدا",49,"د",2,0],["تُقَطَّعُ غيطاناً كَأَنَ مُتونَها","إِذا ظَهَرَت تُكسى مُلاءً مُنَشَّرا",50,"ر",2,0],["تقطر لما أن جرى في سحابه","وأصبح في السلسال يمشي مكسرا",51,"ر",2,0],["تَقَطَّعُ بَينَنا الحاجاتُ إِلّا","حَوائِجَ يَعتَسِفنَ مَعَ الجَرِيِّ",52,"ي",1,0],["تَقطّعتِ الأَسباب مِنهُ وَأَصبَحَت","لَهُ أَلسُن الذَمّ الذَميم قَوافيا",53,"ي",2,0],["تَقطَّعُ آمالٌ لنا فيك أُمِّلَتْ","وأعرضَ خَطْبٌ ما حَسبِنا وما خِلْنا",54,"ن",2,0],["تَقطَّعُ أثناءَ الحبالِ تَعجْرفاً","إذا ما بدا في الصُّبْحِ لاحَ قطيعها",55,"ع",3,0],["تَقطيب حاجبِهِ بسرّ","رُضاهُ عَن عَين الرَقيب",56,"ب",1,0],["تقطَعُ البيدَ حاملاتٍ شُموساً","ما لَها في سِوَى الخُدورِ أُفولُ",57,"ل",1,0],["تقطّمت الآمال لما تواصلت","بمصرعة في الشامتين قوى البشر",58,"ر",1,0],["تُقَطِّعُ بالأَمْسِ الرِّقابِ وَوُصِّلَتْ","بِهَا اليَوْمَ أَرْحَامٌ لَهُمْ ومَحَارِمُ",59,"م",1,0],["تقطَّرَ فِرسانُ الكفاية وارتدوْا","ومرّ على سِيسائها متمرِّنا",60,"ن",2,0],["تُقَطِّر غيرِيَ أصلابُها","وتَزلَقُ أكفالُها بالرديفِ",61,"ف",1,0],["تقطع البرَّ بالمهارى الجديلي","يات والبحرَ بالسفين القُلْعِ",62,"ع",1,0],["تقَطَّع منها فلا تَرعوِي","وتُعدَى بها وهي عُوّادُها",63,"د",3,0],["تُقطِّرُ الفارس المشهور فتكتُهُ","فيه ويصطلم الأحبارَ في النَّظرِ",64,"ر",1,0],["تَقَطَّرتُ عَن ظَهرِ الرِضا وَلَطالَما","بَلَغتُ عَلَيهِ الوَصلَ وَهوَ بَعيدُ",65,"د",1,1],["تقطَّعتْ لبعدِهِ","لمّا تنامَى كَبِدُه",66,"د",2,0],["تَقطَعُ اللَيلَةُ مِنهُ قُوَّةً","وَكَما كَرَّت عَلَيهِ لا تُغارُ",67,"ر",1,0],["تَقَطَّعَتْ الآمالُ منهُ عنِ السِّوى","ووافاكَ مِسْكيناً على ساحةِ الفَقْرِ",68,"ر",1,0],["تقطعت الأسباب لي بين شيعتي","وقرب بلادي قرب أهلي وذي ود",69,"د",1,0],["تَقطّع ما بيني وبينك والتّقى","عليك على كرهي ترابٌ وجَنْدَلُ",70,"ل",1,0],["تقطّع وصلٌ كان منّا ومنكمُ","ودانٍ من الأرحامِ يَثنِي ويَسطُرُ",71,"ر",1,0],["تَقَطَّع وُدٌّ كانَ بَيني وَبينكمْ","وطاحتْ بهِ في الأرضِ إحدى الطَّوائِحِ",72,"ح",1,0],["تَقطَّعَتِ الزِّيارةُ منكَ عنَّا","إلى أن كادَ ينقَطِعُ الرَّجاءُ",73,"ا",2,0],["تَقَطَّعُ أَنفاسي فَأَقطَعُ لَيلَتي","حَنيناً كَما حَنَّت رَوائِمٌ نيبُ",74,"ب",1,0],["تَقطِفُ الخَطوَةَ في مَشيَتِها","خَطرَةَ الرُّمحِ وَمَشيَ الوَحِلِ",75,"ل",1,0],["تقطعت الأسباب والسبل بينهم","فما النقل إلا للدمار ولا الشحن",76,"ن",1,0],["تقطع العيش والحجياة بآما","لٍ بها تقصر الحياةُ طوالِ",77,"ل",1,0],["تَقُطُّ رُؤُوسَ البَغْيِ أسْيَافُ عَزْمِهِ","وَقَدْ يُصْلِحُ الأقْلاَمَ لِلْكَاتِبِ القَطُّ",78,"ط",1,0],["تقطع قلبي حسرةًوتلهفاً","ولم ابكه لكن بكيت شبابه",79,"ب",2,0],["تقطّعت الغزلان يانعَ مردةٍ","بِأفواهها مِن حيثُ قَد أينعَ المردُ",80,"د",1,0],["تَقطع نَفسي إِلَيها اِشتِياقا","وِيذهب قَلبي إلَيها حَنينا",81,"ن",2,0],["تُقَطِّعُ الجُونِيَّ بِالخَرْقِ البَتِكْ","وَإِن أُنِيخَتْ رَهْب أَنْضاءٍ عُرُكْ",82,"ك",1,0],["تقطع قلبي خشية من فراقكم","وعاد سروري من رحيلكم وجدا",83,"د",2,1],["تُقَطِّعُني عَلى التَفريطِ لَوماً","وَبِالتَفريطِ دَهرَكَ قَد قَطَعتا",84,"ت",2,0],["تقطعت الأسباب عني فكان لي","نوالك يا منان أوفى وأكملا",85,"ل",2,0],["تَقَطَّعُ نفسي كُلَّ يومٍ ولَيلَةٍ","إليهِنّ بالأَهواءِ مُبتَدِراتِ",86,"ت",1,0],["تقطع أرحاماً وتهلك أمةً","وتبرى السديف من سنام وغارب",87,"ب",1,0],["تُقَطِّعُ من عَزفِ الفلا جِرراً لها","حِذاراً فمَهما يعزِفِ الدَوُّ تَمجُجِ",88,"ج",1,0],["تقطب منى حين ألقاك حاجبا","وتوسعنى بعد او تعرض عن ذكرى",89,"ر",2,0],["تَقَطعُ دونيَ ألحاظُهُمْ","فما تستطيعُ رياحُ السَّبَل",90,"ل",1,0],["تقطع الأفقَ في سلامٍ وأمنٍ","لاحظتها عنايةُ الرحمنِ",91,"ن",1,0],["تقطر الحكمة من جدرانه","وسداد الرأي والأرزاء جون",92,"ن",1,0],["تقطع أكباد عليكم صبابة","فأصبر إن الخير أجمع في الصبر",93,"ر",1,0],["تقطع قلبي حين اعرضن قسوة","ولم يستطع صبرا ولا كان ساليا",94,"ي",2,0],["تَقطَّعت الحِبال مَع العراوي","وَقَد طارَت مَع الريح الطَزالق",95,"ق",1,0],["تَقَطَّعُ دونَهُ البَيضُ المَواضي","وَتَجفَلُ عَنهُ إِجفالَ الظَليمِ",96,"م",1,0],["تقط رقاب الكافرين بربهم","وتغني فقيراً قد أضرّ به الفقر",97,"ر",1,0],["تَقطّع الرُّؤوس وَالكُفوف","تَثَلَّمَت لِأَجلِ ذا السُيوف",98,"ف",1,0],["تقطيع منك اعناق الليا