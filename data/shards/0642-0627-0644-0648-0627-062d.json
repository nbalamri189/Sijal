an/poem/216671",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115957","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11999","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108769","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108870","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118419","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123289","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60866","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131722",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137363",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118749","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92261","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91465","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76511","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127223","البسيط"],[4356,"","https://poetry.dctabudhabi.ae/diwan/poem/143367","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28771","الكامل"],[4519,"","https://poetry.dctabudhabi.ae/diwan/poem/198924","المنسرح"],[4767,"ما زلتُ","https://www.poetsgate.com/ViewPoem.aspx?id=210931",""],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[4987,"قالو حبيبك","https://www.poetsgate.com/ViewPoem.aspx?id=49556",""],[5138,"في شارع الحب سرت اسئل 2018","https://www.poetsgate.com/ViewPoem.aspx?id=195373",""],[5431,"بانيو وكأس ...وبرد الخيام!","https://www.poetsgate.com/ViewPoem.aspx?id=201925",""],[5525,"أقول احبك","https://www.poetsgate.com/ViewPoem.aspx?id=871",""],[5573,"ياحاتم","https://www.poetsgate.com/ViewPoem.aspx?id=200215",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5790,"قالوا حبيبك ملسوعٌ فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=111933",""],[4228,"المعهد العلمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69258&r=&rc=12",""]],"verses":[["قالوا حَجَرتَ عَلى نَداكَ وَطالَما","أَرغَمتَ فيهِ مَعاطِسَ العُذّالِ",0,"ل",1,0],["قالوا حَكَمتَ بِما لا تَستَطيعُ لَهُ","حَملاً نَكادُ نَرى ما قُلتَهُ لَعِبا",1,"ب",2,0],["قالوا حكى القمر التميّ طلعتها","قلنا صدقتم ولكن فيه تكليف",2,"ف",1,0],["قالوا حكى الليل ما ضمته خمرهمُ","حتَّى نضوا فإذا بالفرقِ قد بانا",3,"ن",2,0],["قالوا حقيق في دَمعِكَ مُقنِعٌ","لَكِنَّها مَمزوجَةٌ بِدماءِ",4,"ا",2,0],["قالوا حبيب أنت تطرى شعره","من ذا الذي لم يطر شعر حبيب",5,"ب",1,1],["قالَوا حَكَيتِ البَدرَ وَهيَ نَقيصَةٌ","البَدرُ لَو يُعطى المُنى لَحَكاكِ",6,"ك",1,0],["قالوا حبيبُكَ غصنُ با","نٍ قلتُ صُغراً للغُصَيْنِ",7,"ن",1,1],["قالوا حلاوةُ روحه رقصتْ به","فأجبتهم ما كلَّ رقصٍ يُطرب",8,"ب",1,0],["قالوا حَرامٌ تَلاقينا فَقَد كَذَبوا","ما في اِلتِزامٍ وَلا في قُبلَةٍ حَرَجُ",9,"ج",1,0],["قالوا حضارةُ «روما»، قلت:«قرطُبَةٌ»","للغربِ أجمعَ كانت مفرِقَ السُّبُلِ",10,"ل",1,0],["قالوا حلَلنا عنهُ رِبقَتَهُ","صدقَوا وشَدّوا العينَ والقلبا",11,"ب",2,0],["قالوا حبيبك قد تضوع نشره","حتى غدا منه الفضاء معطرا",12,"ر",2,1],["قالوا حَكى فرقَك الصَباحُ وَلَو","حُكِّمتُ فيهِ أَوطأتُه قَدَمَك",13,"ك",1,0],["قالوا حكمت وما أبصرت قامته","فقلت إني عرفت الغصن بالثمره",14,"ه",1,0],["قالوا حلا وصف العذار من الورى","في كل ما نلقاه من أبياته",15,"ه",1,1],["قالوا حكى بدر الدجا وجه الذي","أحببته قلت امهلوه وتربصوا",16,"ص",3,1],["قالوا حبيبك محصوبٌ فقلتُ لهم","لا لا فقولكم زورٌ وبهتانُ",17,"ن",1,1],["قالوا حياتك أتعاب فقلت لهم","يا ليت شعري أينفي فقدها التعبا",18,"ب",2,0],["قالوا حبستَ فقلت ليس بضائري","حبسي وفوق الرأس تاج مفاخر",19,"ر",1,1],["قَالُوا حَبِيبُكَ فيهِ","حَبٌّ يَلُوحُ بِخَدِّ",20,"د",1,1],["قالوا حمدت السرى فامدحه قلت لهم","تحصى النجوم ولا تحصى مدائحه",21,"ح",2,0],["قالوا حَدا بِهِم رَيبُ الزَمانِ فَعَل","أَحادثِهِ عَنهُم تُخبِرُك عَن رِمَم",22,"م",1,0],["قالُوا حَكاها القَضيبُ قُلتُ لهم","لا جَمْعَ بَينَ المَحْكِيِّ والحاكي",23,"ك",2,0],["قالوا حَلَاة الحب صدٍّ وحرمانْ","قلْت ارحمونا من نفاق السخافِ",24,"ف",1,0],["قالوا حبيبُكَ ليِّنُ العِطفِ","فأجبتُهُم إِلاّ على ضَعفي",25,"ف",2,1],["قالوا حَبيبُكَ مَبذولٌ فَقُلتُ لَهُم","وَقَد تَرَقرَقَ دَمعُ العَينِ وَاِنسَجَما",26,"م",2,1],["قالوا حبيبك محسنٌ فأجبتهم","واللَه ما أعطى المحب سوى الأرقْ",27,"ق",1,1],["قالوا حُرمتَ من الرحيق بشربها","وهي الرحيق وشهوة المحروم",28,"م",1,0],["قالوا حوا الفا ونا ومد","فاناله منها امتناعا ما حوى",29,"و",2,0],["قالوا حبيبك وارى ثغره صلفاً","فما تحاول إن أبداه قلت أبو",30,"و",1,1],["قالوا حللت بذاتِ القُراط قلت لهم","طعْنُ القدودِ والرَديَنياتِ يُرديني",31,"ن",2,0],["قالوا حكومة بلاد مسور","تصلح لكونك من الجناب",32,"ب",1,1],["قالوا حوى عزا فقلت وعزة","قالوا حوى مجدا فقلت ممجدا",33,"د",2,0],["قالوا حوى قدرا فقلت وقدرة","قالوا حوى رفدا فقلت تفردا",33,"د",2,0],["قالوا حوى سعدا فقلت باسمه","قالوا حوى عز ما فقلت مؤيدا",33,"د",2,0],["قالوا حوى فضلا فقلت مفضلا","قالوا حوى فكرا فقلت توقدا",33,"د",2,0],["قالوا حوى شرف الطباع وحسنها","فأجبتهم ما جار قط وما اعتدى",33,"د",2,0],["قالوا حوى الأدب الجميل وحازه","فأجبتهم وعلى الجميل تعودا",33,"د",2,0],["قالوا حنيفةُ شُجْعانٌ فقلتُ لهم","كلُّ الشّجاعةِ والإقدامِ في الدُّوَلِ",34,"ل",1,0],["قالوا حبست وأنت شهم مفردُ","وعلاك ما بين الأنام مؤكد",35,"د",1,1],["قالوا حبيبُك عَنكَ مال مع الهَوى","فأجبتهم كُلُّ الغُصون تَميلُ",36,"ل",1,0],["قالوا حفظتَ وداداً ضاع عندهمُ","قلتُ المحبُّ وَمن يَهوى له مُلَح",37,"ح",1,0],["قالوا حللنا نَبتَغي تمدينكم","قبل اِنتقام الحية الرَقطاء",38,"ا",2,1],["قالوا حبيبك مصفر أضر به","سقم فدع حبه واركن إلى الملل",39,"ل",1,1],["قالوا: حُجبتَ عنِ العميد فقلت ما","في ذاكمُ عارٌ عليَّ وعابُ",40,"ب",1,1],["قالوا حَبيب قَد ثَوى فَأَجَبتهُم","ناشَدتُكُم لا تَجعَلوهُ الطّائي",41,"ي",1,0],["قالوا حبيبي أصابه رمَد","جفا الكرى جفنَه لِما وجَدا",42,"د",2,1],["قالوا: حداثيون نحن، فقلتُ: صه","إنَّ الحداثةَ مثلُ ماءٍ راكد",43,"د",1,0],["قال واحد يوم عني اني مااملك حضور","قلت شعري من مشاعر هب تودد واقتصاد",44,"د",1,0],["قالوا حبيبك يسمع الشعر قلت أيه","يقراه بعيوني قبل تسمعونه",45,"ن",2,1],["قالوا حبيبك قد اتبدل","وحب واحد قدو شيبه",46,"ب",2,0],["قالوا :حكومته للذل تتركه!","لأجل ماذا؟؟؟ وهل كانت..(...) لتدميه؟؟",47,"ي",2,0],["قالوا حروفي عمي وعيونك بروق","مافي قصيدي جنح ليلٍ وبارق",48,"ق",1,1],["قالواحبال المنايا طوقت مثل القلايد","للبرايا والنصايب بالمدافن لك شهيده",49,"د",2,0],["قالوا حيالك للئام جهنم","فيها ضرام هائل وظلام",50,"م",1,0],["قالوا حبيبك ملسوعٌ فقلت لهم","من عقرب الصدغ أو من حية الشعر",51,"ر",1,1],["قالو احرقُوه بل اصلبوه بل انسفو","للريح ناجس عظمه وإهابه",52,"ب",2,0]]}