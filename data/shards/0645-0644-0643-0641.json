{"poems":[[73,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[74,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[82,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[82,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[82,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[83,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[108,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[234,"مرض الجود والتوى الإكرام","https://www.aldiwan.net/poem50821.html","الخفيف"],[280,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[382,"وقبيلة جهلاؤها عقلاؤها","https://www.aldiwan.net/poem66981.html","الكامل"],[422,"يا قدوة العلماء يا من علمه","https://www.aldiwan.net/poem53857.html","الكامل"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[543,"قد بدا لما بدا","https://www.aldiwan.net/poem47448.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122789","المديد"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62525","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62478","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96700","المتدارك"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122086","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12026","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131319","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53110","المديد"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137371",""],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128658","المتدارك"],[2950,"","https://poetry.dctabudhabi.ae/diwan/poem/141819","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130608","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52980","المتدارك"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85009","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32896","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101389","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72956","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52141","الرمل"],[5413,"الفراعينُ الجددُ","https://www.poetsgate.com/ViewPoem.aspx?id=201418",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5956,"مجدها الفطريُّ هدية من الله","https://www.poetsgate.com/ViewPoem.aspx?id=193345",""]],"verses":[["مَلِكٌ فَواضِلُ جودِهِ مَبثوثَةٌ","في الأَرضِ تَسأَلُ عَن ذَوي الإِدقاعِ",0,"ع",1,0],["ملكٌ في حمى الشبيبة والم","لك له في دُنياه زادُ الغريب",1,"ب",1,0],["ملكٌ في الملك له هِمَمٌ","نَالَتْ بيمينيه المنَنا",2,"ن",2,0],["مَلِكٌ في الملكِ يُبْدي فَخْرُهُ","جَوْهَراً في حَسَبِ المجد الصّميم",3,"م",1,0],["مَلِكٌ في حمايَةِ المُلْكِ منهُ","دَخَلَ النَّاسِ في حَديثِ البحارِ",4,"ر",1,0],["مَلكٌ في حِمايَة المَلكِ مِنهُ","قَسْوَرٌ شائكُ البراثِنِ ضارِ",4,"ر",1,0],["مَلكٌ في البَهو منه أسَدٌ","يضعُ التّاجَ على البدر اللّياح",5,"ح",1,0],["مَلِكٌ فَتى البَأسِ كَهلُ الرَأيِ مُتَّضِحٌ","عالي الذُؤابَةِ رَحبُ الباعِ يَقظانُ",6,"ن",1,0],["مَلِكٌ فَضْلُهُ تَرَاهُ قَرِيباً","وَمَدَى رَأْيِهِ تَرَاهُ بَعِيدَا",7,"د",2,0],["ملك في السلام حتى إذا ما","خاض نار الحروب، كان شهابا",8,"ب",2,0],["مَلَكٌ في جُجُنَّتي يَتَمَنّى","مَبسِمُ الفَجرِ لَو يَكونُ سَفيري",9,"ر",2,0],["مَلِكٌ فيه جَوهرُ النورِ والقُدْ","سِ وإن ظَلَّ تدّعيه الأنام",10,"م",1,0],["مَلِكٌ فاتَ المُلوكَ مَدىً","نَحْوَ تَحْميدٍ وَتَحْميلِ",11,"ل",1,0],["مَلِكٌ في العِلمِ لَهُ قَدَمٌ","رَسَخَت لَم يَخشَ مِنَ الذَّلَلِ",12,"ل",1,0],["مَلِكٌ فضائِلُهُ تقودُ جَنائِباً","لِسواهُ حتى عَمَّهم آلاؤُها",13,"ا",3,0],["ملكٌ فأمَّا حِلْمُه فموقّرٌ","ضافٍ وأمَّا بطشه فشديد",14,"د",1,0],["ملكٌ في الدنوِّ وابعد تلقا","هُ جسيمَ النَّدى كريم العهد",15,"د",1,0],["مَلِكٌ فاوحَ ذِكرَا","عَنبَراً عَرفاً ونَشرا",16,"ر",2,0],["مَلِكٌ في الحُسنِ لا بَشَرٌ","هُوَ لا إنسٌ وَلا جانُ",17,"ن",1,0],["ملك فائض الأنامل يعطي","كل خير وإنَّه يستقل",18,"ل",1,0],["ملك فرع المعالي","من ملوكٍ عظماءَ",19,"ا",2,0],["ملكٌ في العُلا قد سما وعلا","رُتَباً في العلا دونها زحلُ",20,"ل",1,0],["ملكٌ فَرّق في نيلِ العُلا","وَالثنا مِن مالهِ ما اِجتَمعا",21,"ع",2,0],["مَلِكٌ فِي المُلُوكِ حَازَ مَزَايَا","وَاعْتِلاَءً لِطِيبِ أَصْلٍ وَفَرْعِ",22,"ع",1,0],["ملكٌ في يديه عشرُ بنانٍ","نشأت للورى سحائبَ عشرا",23,"ر",2,0],["مَلَكَ فِعلَهُ بِدَلجَةَ وَالبابِ","فَعالُ الإِمامِ في صِفَّينِ",24,"ن",1,0],["ملك فوق السّماكين سَما","وله في هامة الجوزاء مَقْعَدْ",25,"د",1,0],["ملك في عصر دولته","كَفَّ كَفَّ الدهر عن غيره",26,"ر",2,0],["ملك في القلوب عرش استواه","عز نصر او جل جاها وقدرا",27,"ر",2,0],["مَلكٌ فضلُهُ في الوَرى واضِحٌ","بَذلُهُ وافِرٌ كامِلٌ وَمديد",28,"د",1,0],["ملك في جبينه كسنا البر","ق ونور يعلو على الأنوار",29,"ر",1,0],["ملك في ممالك النفس يجري","بصلاح قانونه المسنون",30,"ن",1,0],["ملك في حمى ابيه علي","كم غدا الملك لائذاً مستجيرا",31,"ر",2,0],["ملكٌ في عشقِ المجد شجى","والمجدُ طراز للحَسن",32,"ن",1,0],["مَلِكٌ في الجَمالِ حَسا وَمَعنى","وَجَميعُ المِلاحِ في الحُسنِ جُندَه",33,"د",2,0],["مَلَكٌ في عَينِه الدُن","يا لِراجيهِ قَليلَه",34,"ه",1,0],["ملكٌ فما احلى مواكب حسنه","ان حفَّ من سرب الظبا بجنود",35,"د",1,0],["مَلِكٌ فاتكٌ جوادٌ لِمَن زَا","غَ ومَن زارَ بأَسُهُ وسَماحُه",36,"ح",2,0],["ملكٌ فيه صلاحٌ للعلا","قامعٌ في حكمه عرقَ الفساد",37,"د",1,0],["مَلِكٌ في طَيّ يروي مُلكه","شاعرٌ أبدعَ حتى لن يُراما",38,"م",2,0],["مُلْكُ فرعونَ زائلٌ يوم يَسْري","نورُهُ في الكهولِ والشبان",39,"ن",1,0],["ملكٌ في حسامهِ النفع والض","رُّ وماءُ المنى ونارُ الحتوف",40,"ف",1,0],["ملَكٌ في جسْم بنت آلّفتْ شملَ الصبايا","عندما نرجو سُميّه يغفرُ الله الخطايا..",41,"ا",3,0]]}