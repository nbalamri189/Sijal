{"poems":[[50,"أية نار قدح القادح","https://www.aldiwan.net/poem62540.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[92,"الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=179088",""],[458,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[463,"ضمانة يصدق وعد الضنا","https://www.aldiwan.net/poem56285.html","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133838","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53102","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53079","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77198","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77201","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205855","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112493","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67591","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68083","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136548",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133168","الطويل"],[4699,"ويبقى الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193392",""],[463,"ضمانة ٌ يصدق وعدُ الضنا","https://www.poetsgate.com/ViewPoem.aspx?id=17993",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[192,"فهد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=16371",""]],"verses":[["أَيَّةُ نارٍ قَدَحَ القادِحُ","وَأَيُّ جِدٍّ بَلَغَ المازِحُ",0,"ح",1,1],["أَيَهْنِئُنَا لِلشَّمْسِ وَجْهٌ وَدُونَهُ","دُخَانٌ مَثَارٌ لِلأَذَى وَحُرُوبُ",1,"ب",1,0],["إيهٍ نديمي قد جمعتَ لناظري","أمرين كلُّ لا يَبين غموضه",2,"ض",2,0],["إيه نفسي اليوم ذكرى نزوحي","عن رباها وعن بوار وعار",3,"ر",1,0],["أيّة نارٍ قَدَحتْ في الحشا","عينُ مَهاةٍ نَندُها ثاقبُ",4,"ب",1,0],["أيهنيك انّا في البلية واجد","وشاك طويل الليل بعد عان",5,"ن",1,0],["إيه نظام الدين عطفة راحمٍ","فلقد عهدتك في الحوادث منجدي",6,"د",2,0],["إيه نديمي عاطنيها قهوة","تدني إليَّ من السرور بعيدا",7,"د",2,0],["إيهِ نُوّابنا وَكُلٌّ أَبِيٌّ","قَد وَثِقنا بِهِ وَكُلٌّ غَيورُ",8,"ر",1,0],["إيهِ نُوّابَنا سَلامٌ عَلَينا","وَعَلَيكُم وَغِبطَةٌ وَحبورُ",9,"ر",1,1],["إيه ناجي لّما نعاك لى النا","عي أفاض الدموع مني سجاما",10,"م",2,0],["أيهنيك أن أبكى وعيشك يبسمُ","ويرضيك تبريحي وأنت منّعم",11,"م",1,1],["أيَّةُ نفسٍ ناهزَت رُتبةً","إلا ونَفسُ القربِ من باليه",12,"ل",3,0],["ايهنأ النوم لأجفاننا","والرّوس قد عاثت بأوطاننا",13,"ن",2,0],["أيَهْنأ عيشٌ لحُرٍّ أَسِف","عدمتُ حياتي إِذَا لَمْ أقف",14,"ف",1,0],["إيه نفس اقصري فَقَد بَعُد العَه","دُ وَأَسمت رقيَّها العَنقاء",15,"ا",2,0],["ايهنُك خفقُ القلب مني إذا سرى","النَسيم خُفوق البَرق والجفنُ ماطر",16,"ر",1,0],["أيهنا امرؤٌ عيشاً ولم يدر أنه","يكون له في دارٍ رجوع",17,"ع",1,0],["أيهنيكِ العذابُ؟ فدتكِ عيني","لِأجلكِ تَسْكُبُ الأوجاع قطرا",18,"ر",2,0],["أية نارٍ قدحتْ في الحشا","عينُ مهاة ٍ زندها ثاقبُ",19,"ب",1,0],["أيهنأ عيشي أو يطيب لي الهوى","وأنت عفير للثرى متوسد",20,"د",1,0],["إيه ندري من فقدنا .. من فقدنا عارفينه","شخص أبد ماكان عادي .. كان دنيا من رحابة",21,"ب",2,0]]}