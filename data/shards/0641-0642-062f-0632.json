{"poems":[[55,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[55,"إساءته شهوة ثرة","https://www.aldiwan.net/poem30684.html","المتقارب"],[10,"لا شيء يبقى غير وجه مليكنا","https://www.aldiwan.net/poem21070.html","الطويل"],[68,"أيا ملك العصر الذي شاع فضله","https://www.aldiwan.net/poem41353.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[164,"هلالك شبهناه وهو ابن ليلة","https://www.aldiwan.net/poem58904.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[287,"أحبابنا مذ بانوا","https://www.aldiwan.net/poem32393.html","مجزوء الرجز"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[385,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[415,"علقت هواكم في بلهنية الصبا","https://www.aldiwan.net/poem31655.html","عموديه"],[447,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[592,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202085","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112796","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127961","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127953","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28478","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137268",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132609","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89066","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86300","الطويل"],[4104,"","https://poetry.dctabudhabi.ae/diwan/poem/125317","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133097","الوافر"],[4830,"حُلْمُ الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=212911",""]],"verses":[["فَقَد زالَ مَن كانَت طَلائِعُ خَوفِهِ","تُعارِضُكُم في كُلِّ مَرعىً وَمَورِدِ",0,"د",1,0],["فَقَد زيدَ شَرّاً إِلى شَرِّهِ","كَما اِستُنفِرَ الضَبُّ بِالعَقرَبِ",1,"ب",1,0],["فَقَد زاحَ عَنّا اللَومُ إِذ تَرَكوا لَنا","أَروماً فَآراماً فَماءً بِوارِدا",2,"د",2,0],["فَقَد زِدتُ مَع وَقعِ الحَوادِثِ رَغبَةً","كَما زادَ فَرطُ السَحقِ في أَرجِ المِسكِ",3,"ك",1,0],["فَقَد زالَ عَقلي لِاِختِبالِ لِسانِهِ","وَخُيِّلَ لي أَنَّ الجِبالَ تَزولُ",4,"ل",1,0],["فقد زادها بالشكر عنكم وزادكم","على الشكر منها كل أعظم نعمة",5,"ه",1,0],["فَقَد زَعَموا أنّ الفرنجَ نجاحُهم","بِدُنياهمُ يُعطي إلى دينهم فَخرا",6,"ر",2,0],["فَقَد زَهَت بِخَيرِ ما","يَزهو بِهِ بُستانُ",7,"ن",1,0],["فَقد زَاحت به فتنٌ غواشٍ","لَها ظللٌ مِنَ الأهواء سودُ",8,"د",1,0],["فقد زَيَّن الدّنيا بآثارِ كَفِّه","سَماحاً وخلاها لأبنائها زُهدا",9,"د",2,0],["فَقَد زانَ أُفق المَجد مِن رَدِ شَمسُهُ","وَلَولا مَضاءُ السَيف ما زَيَّنوا الجِفنا",10,"ن",2,0],["فقد زارني شيبي وتسعون حجة","وست مضت لي صبوة وتتيما",11,"م",2,0],["فقد زلّت قريحتنا","بلا عذر ولا سبب",12,"ب",1,0],["فقد زاح عني الهم والغم والأسى","بإقبال سلمى بالرضى والتحبب",13,"ب",1,0],["فقد زُرتُ في كوفان للمجْدِ قبَّة","هي الدين والدنيا بِحَقٍّ كما هِيَا",14,"ي",2,0],["فقد زاد القليل وزاد سقمي","واعدائي لقد قصدت حصوني",15,"ن",2,0],["فقد زار خير المرسلين محمدا","وادرك مايرجوه منه بلاكد",16,"د",1,0],["فقد زينت أقطار مصر وشرفت","بصدر رحيب الصدر خير همام",17,"م",1,0],["فَقَد زالَ داء كُنتَ فيما أَماطَهُ","كَما ثُقِّفَ الخَطِيُّ وَهوَ صَليبُ",18,"ب",1,0],["فقد زفت اليك فتاة قومٍ","يخيم في ربوعهم العلاء",19,"ا",2,0],["فقد زحمت من الغرب الدياجي","لتذهب بالضياء المستنير",20,"ر",1,0],["فقد زيد نجمٌ في سماء بني العلا","وجدد اسمٌ في صفاءٍ مجدد",21,"د",1,0],["فَقَد زادَني فَرطُ الهِيامِ كَآبَة","وَاِوسَعَني الواشونَ مِنهُم مَلامَةً",22,"ه",1,0],["فقد زاحمونا واستبدوا بخيرهم","وشحوا علينا في موارد جمة",23,"ه",1,0],["فقد زل عن التوحيد قومٌ","طغام الناس عميانٌ وصم",24,"م",1,0],["فقد زرعَ الأبا فيها سنيناً","لِيَجنيَ أهلُها نصراً حَصادَهْ",25,"د",2,0]]}