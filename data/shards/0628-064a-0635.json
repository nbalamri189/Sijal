{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[119,"سر الهدى بابن الرفاعي","https://www.aldiwan.net/poem40413.html","عموديه"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199573","المسحوب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199568","المسحوب"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95232","السريع"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79726","الخفيف"],[4018,"","https://poetry.dctabudhabi.ae/diwan/poem/203339","الكامل"],[4908,"كومة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=207314",""]],"verses":[["بِي صَبْوَةٌ وَالعُقُوقُ شِيمَتُهَا","وَيْحَ قُلُوبٍ مِنْ شَرِّ مَا تَلِدُ",0,"د",1,0],["بي صدور مثل جيليهم","والمنبجي النير الزي",1,"ي",1,0],["بي صاحبٍ قفّى ولا سال عنّي","ولا ينلحق ساعة جزى من دياره",2,"ر",2,0],["بي صاحبٍ هو لى وأنا في رضى له","ما تسمع اذنيّه ودونه معاذي",3,"ي",1,0],["بِي صَيرَفيّ خَدُّهُ مُشرِقٌ","فَهوَ كَدِينَارٍ وَذي نَارِ",4,"ر",1,1],["بي صوت المظلوم في كل وقت","وأنين الثكلي وصمت الكثيب",5,"ب",1,0],["بي صول الضمير يفتك بال","مرء ويرمي فؤاده باللهيب",5,"ب",1,0],["بي صَيْرَفيٌ لا يَرِقُّ لِحالَتِي","قد مُتُّ مِن جَورِ الزمانِ وَصَرْفِهِ",6,"ه",1,0],["بِي صَبْرُ أَيُّوب ..لِي نَفْسٌ مسهدةٌ","مِن شدةِ الخَوْفِ تَتْلُو سُورَةَ الفلَقِ",7,"ق",1,0]]}