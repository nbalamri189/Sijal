د يأبى التهضما","https://www.aldiwan.net/poem16036.html","الطويل"],[511,"تأن في الأمر لا تكن عجلا","https://www.aldiwan.net/poem2445.html","المنسرح"],[556,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[591,"أما ولآل من شتيت ابتسامه","https://www.aldiwan.net/poem17501.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/103989","الطويل"],[993,"","https://poetry.dctabudhabi.ae/diwan/poem/130365","الوافر"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44947","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61192","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46549","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64518","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64451","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82636","الرجز"],[1757,"","https://poetry.dctabudhabi.ae/diwan/poem/203602","البسيط"],[1865,"","https://poetry.dctabudhabi.ae/diwan/poem/198934","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198858","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121235","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83039","السريع"],[2927,"","https://poetry.dctabudhabi.ae/diwan/poem/33034","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107070","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133048","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61271","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131266",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34581","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111061","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199101","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119682","الوافر"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90760","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73295","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136523",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83408","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115304","الطويل"],[4755,"كَأَنَّ لَيلًا ما بِصَدري أَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=197465",""],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[4119,"تأنق في وضعها ماهر","https://www.poetsgate.com/ViewPoem.aspx?id=16150",""],[5101,"أنثى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=199686",""],[5121,"دَوْلَةُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=59598",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[2365,"قفا صاحبيّ نحىّ الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=200654",""],[5247,"تاني حذيفة ما مثله","https://www.poetsgate.com/ViewPoem.aspx?id=52906",""],[5353,"بردة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=212465",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5725,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=186383",""],[5751,"أحزان أرضية لطفلٍ سماوي","https://www.poetsgate.com/ViewPoem.aspx?id=214761",""],[5781,"جنونٌ على مراشِفِ الضَّوء","https://www.poetsgate.com/ViewPoem.aspx?id=198553",""],[5790,"تأنوا ففي طي النسيم رسائل","https://www.poetsgate.com/ViewPoem.aspx?id=112102",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[6031,"ولَيلٍ أشَبْنَا طُرَّتَيْهِ بِأَوجُهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46305",""],[6088,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=207606",""],[308,"تأنق الحسن حين صوره م","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613950",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["تَأَنَّيتُهُ حيناً فَلَمّا رَأَيتُهُ","إِذا اِزدادَ ليناً جانِبي عَزَّ جانِبُه",0,"ب",2,0],["تَأَنَّوا فَبَكّوني صُراحاً بِنِسبَتي","لِيَعلَمَ ما تَعنونَ كُلُّ غَريبِ",1,"ب",1,0],["تَأَنّيكُمُ أَحلامَ مَن لَيسَ عِندَهُ","عَلى الرَهطِ مَغنىً لَو تَنالونَ مَوثِقا",2,"ق",2,0],["تَأَنَّسُ بِالنَباتِ إِذا أَتاها","لِرُؤيَةِ وَجهِهِ الأَرضُ المَحولُ",3,"ل",1,0],["تَأْنَسُ النَّفْسُ فِيهِ بِالنَّفْسِ فِي","مَنْزِلَةٍ مِنْ مَنَازِلِ الإِلْهَامِ",4,"م",1,0],["تَأَنَّ وَلا تَعجَل بِلَومِكَ صاحِباً","لَعَلَّ لَهُ عُذراً وَأَنتَ تَلومُ",5,"م",1,1],["تأَنَّ في الظلم تخفيفاً وتهوينا","فالظلم يقتلنا والعدل يحيينا",6,"ن",2,1],["تَأَنّى حينَ أَسَّسَكِ اِبنُ حَربٍ","وَحينَ بَنى دَعائِمَكِ الشِدادا",7,"د",2,0],["تَأنّقَ فيهِ كيفَ شاءَ وإنّما","مقالَتُهُ للشّيءِ كُنْ فيَكُونُ",8,"ن",1,0],["تَأَنَّيتُ وَاِستَسمَعتُ حَتّى فَهِمتُها","وَقَد قَفَّعَت نَكباءَ مَن كانَ سارِيا",9,"ي",2,0],["تأنَّ ابنَ حربٍ لستَ في مثلها جَلْدا","قصاراك أن ترتدَّ حرّانَ أو تَرْدَى",10,"د",2,1],["تَأَنَّيتُهُ كَيما يُفيقُ وَلَم يُفِق","إِلى أَن رَأَيتُ الشَمسَ قَد حازَها الغَربُ",11,"ب",1,0],["تَأَنَّقَ اللَهُ حينَ صاغَكُما","فَفُقتُما الناسَ أَيَّ تَأنيقِ",12,"ق",1,0],["تَأَنَّ مَواعيدَ الكِرامِ فَرُبَّما","حَمَلتَ مِنَ الإِلحاحِ سَمحاً عَلى البُخلِ",13,"ل",1,0],["تَأَنّى نَظَري فيها","مَلِيّاً وَتَأَنَّيتُ",14,"ت",1,0],["تأنقت يد الوليد فيها","واستبقت أكفُّ مترفيها",15,"ه",2,0],["تَأَنَّقَ فِيهِ الْحُسْنُ فَامْتَدَّ فَرْعُهُ","إِلَى قَدَمَيْهِ واسْتَدَارَتْ نُهُودُهُ",16,"د",2,0],["تَأَنَّقَتِ الطَّبِيعَةُ فِيهِ حَتَّى","لَيَعْدُو كُلَّ وَصْفٍ أَوْ يَكَادُ",17,"د",1,0],["تأنَّق فيها فلمَّا انتهى","وقد أخذته حُمَيَّا النَّجاح",18,"ح",1,0],["تأنَّى لها طَبٌّ بإخلاصِ طيبِها","فأفرغ فيها رُوحَ رَيحانةِ الزَّهْرِ",19,"ر",1,0],["تانف الوادى المقدس رعيا","ورعت حيث الاسد تفري فراها",20,"ا",3,0],["تأنف العرب أن تدوس حماها","الحرّ شرّ العبيد أدنى العبيد",21,"د",1,0],["تأنف القدرةُ في ذِرْوَتِها","وإلهٌ في السما أن تُغْلَبي",22,"ب",2,0],["تأنّيْتَهُ حتّى تَبَيّنَ رُشْدَهُ،","وَحَتّى اكتَفَى بالكُتبِ دونَ الكَتَائِبِ",23,"ب",1,0],["تأنّق الدوح يرضر بلبلا غردا","من جنّة الله قلبانا جناحاه",24,"ا",2,1],["تأنّق الشعر للأعياد حالية","وقطّف الورد من عدن وحيّانا",25,"ن",2,0],["تا نهر طابق لا عدمتك منهلاً","اين الصراة تحفها الروضات",26,"ت",1,0],["تأنفُ الأوراقُ من سيرته","ويعاديها مدادُ المحبرة",27,"ر",2,0],["تأنق رب الخلق في صنع أعين","بهن إلى قتل المحبين غرام",28,"م",1,1],["تأنقت في الأذى الليالي","والدهر قاسى الأذى عنيد",29,"د",1,0],["تأنَّقتِ الأرضُ في نَبْتهِ","تأنُّقَ مقتدِرٍ صانع",30,"ع",1,0],["تأنَّيتُه شهراً أرجِّي قضاءه","وشهرٌ رهين الانتظار شهور",31,"ر",1,0],["تَأنَفُ مِن مَدحِ اللِئا","مِ نَفسُهُ وَتَعزِفُ",32,"ف",1,0],["تأنّثَ في أرضِ الشآمِ رِجالُها","وفي غَيرها الأُنثى تَسلُّ المُذكّرا",33,"ر",2,0],["تأن وَلا تضق بالامر ذرعا","فَكَم بالنجح يظفر من تأني",34,"ن",2,0],["تَأَنَّقَ السَّعْدُ في إِهْدائِهِ فَبَدَتْ","حُلاهُ تبْهرُ أَلْبَاباً وأَذهانَا",35,"ن",2,0],["تأنق في شكلي ونفسي صانعي","فريقي بتطعيمي غدا طيب الطعم",36,"م",1,1],["تأنق الحسن حين صوره ال","له فجاءَ الجمال فيه نسق",37,"ق",1,1],["تأن على الحاجات تظفر بخيرها","وأشأمهم من كان يدعى بعجلان",38,"ن",1,0],["تأنّقَ فيهما عربٌ وعجمٌ","وَدونَهما لَه شأوٌ بعيدُ",39,"د",1,0],["تَأنّ للظَّالِمِ واصْبِرْ لهُ","وَدَعْهُ فالدَّهْرُ لَهُ ثَايُرُه",40,"ه",1,1],["تأنَّ فإنَّهنَّ غُصونُ بانٍ","مَنابتُ غَرسِهنَّ رِكابُ بَينِ",41,"ن",1,0],["تأنَّّ في إقراره مستمهِلا","ولا تكن في سمعه مستعجلا",42,"ل",2,0],["تَأَنَّ فَلا شَكَ المُقدَّر كائِنٌ","وَرَبك كافٍ وَالشَقيّ المُشكك",43,"ك",1,0],["تَأَنف صحبة النَفسِ","سُرور المبعد المَنسي",44,"س",2,1],["تَأَنَّقَ فيهِ عَبدُهُ وَاِبنُ عَبدِهِ","وَغَرسُ أَياديهِ وَكافي كِفاتِهِ",45,"ت",2,0],["تأنَّ في الشَّيء إذا رُمتَهُ","لِتعرفَ الرُّشْدَ مِنَ الغيِّ",46,"ي",1,1],["تأنّقَ في صنعتي راقِمي","فصوّرَني نُزهةَ العالَمِ",47,"م",1,1],["تأنس إن قيل غرسُ نعمتهم","وأنت منها في غيرهم نافرْ",48,"ر",1,0],["تأنَّيتَ حتى قيل راضي خَسيفةٍ","وحاشاكَ لكن كنت بالرأي أعْلما",49,"م",2,0],["تَأَنَّ في الأَمر لا تكن عَجِلا","فمن تأنَى أصاب او كَادَا",50,"د",2,1],["تأنّيتَهمْ موهناً كي يروا","صباحبهمُ مقبلاً والخيولا",51,"ل",2,0],["تَأَنّ فَلَوْ أَرْسَلْتَ سَهْمَكَ في الصَفا","غَدا مارِقاً مِنْ كُل صَمَّاء جلْمَدِ",52,"د",1,0],["تأنّق منها الضّدُ بالضدِّ جامدُ","لناظرها من مُشكلاتِ العجائبِ",53,"ب",1,0],["تأني يا حمامة لا تثنى","ففرط النوح لا يجدي الشجيّا",54,"ي",2,0],["تَأَنَّيتُ مِن سُكرِهِ كَي يَفيقُ","فَلَم يَصِح مِنهُ وَنامَ النَهارا",55,"ر",2,0],["تَأَنق فيها صانِعوها بِجهدهم","وَصاغوا لَها ثَوباً مِن الذهَب التبر",56,"ر",1,0],["تَأن في الأُمور","لا سيما السُّرور",57,"ر",1,0],["تَأنيسُهَا حتَّى تَراهُ قَد صَبا","يَرَى لَها البَدرَ المُنيرَ مُشبِها",58,"ه",2,0],["تأنيت حلماً يا صبور وإنما","إلى أجْلِ تأخير عدل العقوبة",59,"ه",1,1],["تأنيت في أخذ العصاة تلطفاً","ورفقاً ولم تأخذ عصياً بعجلة",59,"ه",1,0],["تأنيت بي في موضع العدل حالما","وأعظم جرم يا حليم جريمتي",60,"ي",1,1],["تأنيت امهالاً بعاصيك ربما","يتوب وإلا فهو ليس بمفلت",60,"ت",1,0],["تَأَنُّساً مِنهُ بِما","قَد ضَمِنَت من ذِكر لا",61,"ل",2,0],["تأنيثه صفة محمودة عهدت","كم نفّست قبض طبع لم يجد نفسا",62,"س",2,0],["تأنس بالوحوش ومن يراه","يخال به خلال الوحش سيدا",63,"د",2,0],["تآنسْ بنا هذا الوصالُ وذا اللقا","محِبٌّ ومحبوبٌ وساعة خلوتي",64,"ت",2,0],["تَأَنَّقَ اللَهُ حَتّى باتَ مُجتَمِعاً","هَذا الجَميلُ وَهَذا المَنظَرُ الأَنِقُ",65,"ق",1,0],["تأنف الطير إذا هددها","أجدل بالذل من سكنى الوكون",66,"ن",1,0],["تاني ولا تزد حزني وكربي","اتزعم صبوتي لديار صحبي",67,"ي",1,0],["تَأنس الناس بِالمَلاهي وَأَنتُم","ما رَضيتُم سِوى الكِتاب أَنيسا",68,"س",2,0],["تَأَنَّ في الأَمرِ إِذا رُمتَه","تَبَيَّن الرشد من الغَيِّ",69,"ي",1,1],["تَأَنَّ وَلا تَعجَل عَلَينا اِبنَ مَعمَرٍ","فَلَستَ وَإِن أَكثَرتَ مِثلَ المُهَلَّبِ",70,"ب",1,1],["تأنق بانيها بجنبيه فازدهت","كما ابدعت في الماء صنعة مجريه",71,"ي",2,0],["تأنفُ الوِرْدَ والفُرات بِفيها","وتَحُزُّ المقالَ تبغِي جَهاما",72,"م",2,0],["تأَن فالمرءُ إن تَأَنَّى","أَدركَ لا شكَّ ما تَمَنَّى",73,"ن",2,1],["تأنفْتُ لذّاتِهِ باكراً","بَرَهْرهةً طَفلةً أو عُقارا",74,"ر",2,0],["تَأَنّق الطابع فيهِ فَأنِق","أَقطَعُ مِن عَزمته لَما لَحق",75,"ق",1,0],["تأنث إذ قالوا الفتاة تذكرت","ولم يثنه عن مبتغاه نكير",76,"ر",1,0],["تأنيتكم بقيا الصديق لتقصدوا","وتأبون إلا أن تجوروا عن القصد",77,"د",1,0],["تأنّ على الأمور تنل مداها","فإن البدر أوّله هلال",78,"ل",1,0],["تأنى عن دعاة العذل فيه","وعن داعي المكارام ما تأبى",79,"ب",2,0],["تأن الدهر لا تعجل علينا","وحبك في الأحبة قد تعامى",80,"م",2,0],["تأنّ بمُدنَفٍ كمدٍ معنّى","لأسكبَ عبرة وأبثَّ حزنا",81,"ن",2,1],["تانك الآيتان خصصتا في","فئة ما وذا لكل الورى عم",82,"م",1,0],["تأني يا حمامة لا تئني","ففرط النوح لا يجدى الشجيا",83,"ي",2,0],["تأني يا حمامة لا تئني","ففرط النوح لا يجدي شجيا",84,"ي",2,0],["تأنَّوا ففي طَيِّ النَّسيمَ رَسائِلُ","وَمِيلُوا فَإنَّ البانَ في السَّفحِ مائِلُ",85,"ل",1,1],["تانُّ وما راع الفراقُ فؤادَها","ولا الجفنُ منها بالسَهاد قَريح",86,"ح",1,0],["تَأَنَّ أَناةَ الدَهرِ في كلّ حادِث","وَسر لِلعُلى لا تكتَرِث بِالكَوارِثِ",87,"ث",1,1],["تأنيتُ حتّى أوضحَ العلمُ أنني","مع الدهر يَوماً مُصعِدٌ ومُصَوّبُ",88,"ب",1,0],["تَأَنْسَنِي يا أَرضُ كي تَشعُرِي","بِمن بِنارِ الحَربِ مِثلِي اكتَوَى",89,"و",2,0],["تانيتك تمر وعگدلك الخطوات","وطلگلك ادية والنفس مچتوف",90,"ف",1,0],["تأنق في وضعها ماهر","تفيت البصائر أنوارها",91,"ه",2,1],["تَأنق يوسف كيما أرَضّى","وهيهات .. هيهات مثلي يلين",92,"ن",1,0],["تَأَنَّ فَإِنَّ الْمَرْءَ لَيْسَ مُسَيَّراً","لِتَمْتَلِكَ الأَخْيَارَ فِي صِحَّةِ الرَّوْدِ",93,"د",1,0],["تأن ناعيه على القوم قد كذبوا","فمن نعاك تكاد الأرض تنقلب",94,"ب",1,1],["تأنّ ولا تعجلن فى الخطى","فان العجول كثير الزلل",95,"ل",1,0],["تاني حذيفة ما مثله","يحط الرئيس ولا يرفع",96,"ع",1,1],["تأنّقَ الذّلُ في أعناقِهم حُلَلاً","حتى غدا الذُّلُ يأبى ذلّهمْ خَجَلا",97,"ل",2,0],["تأنق فيهما ليل جريءٌ","وسحرٌ في كواكبه بديعُ",98,"ع",1,0],["تأنف المنة نفس","لي ما عشت أبيه",99,"ي",2,0],["تأنّى فالنوى المُ","فمتْ بالشوق ياشبمُ",100,"م",1,1],["تأنَّثَ كلُّ المَدى حَولَهُ","وفيهِ تَكامَلَ أقرانُهُ",101,"ن",2,0],["تأنَّقَ العِشْقُ في رَوْضي فَآنَسَهُ","وفي المَباهِجِ أهْداني أَساياهُ",102,"ي",3,0],["تأنوا ففي طي النسيم رسائل","وميلوا فإن البان بالسفح مائلُ",103,"ل",1,1],["تأنّقَ والقشور بلا خَلاقٍ","ويحسبُ أنْ س يسمو ب الثراءِ",104,"ا",2,0],["تأنَّقَ ربُّ الحُسْنِ فيهَا فَلَمْ يَكُنْ","لِيَتركَ منْها ما يزيدُ مَزيدا",105,"د",2,0],["تأنّقت فبدت يا سرّ جوهرها","تاجا من الفلّ فوق الرأس مشكولا",106,"ل",2,0],["تأنق الحسن حين صوره م","الله فجاءَ الجمال فيه نسق",107,"ق",1,1],["تأنَفُ الذلَّ طينةٌ أنا منها","وتُنافي رُغامَهُ أعراقي",108,"ق",2,0]]}