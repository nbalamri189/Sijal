{"poems":[[73,"هذا الغزال الذي بعثت به","https://www.aldiwan.net/poem3953.html","المنسرح"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[409,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[563,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[566,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66782","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87003","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96703","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27724","البسيط"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143172","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95337","الرجز"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"]],"verses":[["وَهوَ صَبورٌ عَلى الأَذى وَمَتى اِس","تَشاطَ غَيظاً بِحلمِهِ كَظَما",0,"م",2,0],["وَهو صحيحُ الدين والإسلامِ","للَّه درّ دينه ما أقوَما",1,"م",2,0],["وهو صعب الورود عنها فهل عن","دك حل لعقدة الإِبهام",2,"م",1,0],["وهو صريح عندهم ظاهر","من ألف الخط إلى يائه",3,"ا",3,0],["وَهوَ صَحيحٌ لَم يُدافِع عَن حَشَم","صَمّاءُ لا يُبرِئُها مِنِ السَقَم",4,"م",1,0],["وهو صِنوي وصفييّ والذي","حبُّه في الحشرِ خيرُ العَمَلِ",5,"ل",1,0],["وَهوَ صَرفٌ لسبعة مِن شهور","مَع يَومين أَو ثلاث لَيال",6,"ل",1,0],["وهْو صديقٌ ناصحٌ مُعينُ","لكنْ إذا عاديتَه مهُينُ",7,"ن",1,0],["وَهو صبٌّ مُستهام","شاحب الأعضاء بالِ",8,"ل",1,0],["وهو صريح مذهب القطاع","لخلو بيته من المصراع",9,"ع",1,0],["وَهوَ صَغيرٌ فَاِشتَكى الظَماءَ","فَخَرَجَت هاجَرُ تَبغي الماءَ",10,"ا",2,0],["وهو صخر لدى العصاة وأمّا","للمساكين الدمعة الخنياء",11,"ا",2,0],["وهو صحيح بكلِّ وجهٍ","أثبتَه الشارع ابتلاء",12,"ا",2,0],["وهو صعيد قد تيمته","إذ ليس يجري الماء في النهر",13,"ر",1,0],["وهو صديق لمن عصمته","نزهت عن شائبات المين",14,"ن",1,0],["وهو صِداق ثابت وصدَقه","وأسفر الصُّبح وأبدى فلقه",15,"ه",1,0],["وهو صنو السكوت قال وقد دل","وصنو الكلام قل ودلا",16,"ل",2,0],["وهو صنو ل في الحسن فما","لك من شبه سواه دون ذين",17,"ن",1,0]]}