{"poems":[[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[3,"أطوي فيافي الفلا والليلُ مُعتَكِرُ","https://www.aldiwan.net/poem156.html",""],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[64,"ورافل في صوان الحسن مشتمل","https://www.aldiwan.net/poem52300.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39669","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[92,"الخريف في فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179054",""],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[240,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[242,"حاولت صبرا على ما ناب من نوب","https://www.aldiwan.net/poem18065.html","البسيط"],[266,"حلا بك الدهر وازدانت علا حلب","https://www.aldiwan.net/poem38367.html","البسيط"],[280,"ورافضة من مائها في هوائها","https://www.aldiwan.net/poem25634.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[385,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[408,"وبي معذر خد ورد وجنته","https://www.aldiwan.net/poem46748.html","البسيط"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[443,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[445,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[505,"أرح فؤادك من هم الوجودات","https://www.aldiwan.net/poem37713.html","البسيط"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[572,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86753","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[2141,"","https://poetry.dctabudhabi.ae/diwan/poem/100877","الوافر"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137355",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83244","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133972","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117950","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114147","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135889","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77069","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83124","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[5005,"حرفٌ في مهبِّ الريح..","https://www.poetsgate.com/ViewPoem.aspx?id=189357",""],[5087,"يا خالق الخلق اجمعينا","https://www.poetsgate.com/ViewPoem.aspx?id=96360",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[5781,"لا سيّداتي نحنُ لسنا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=202846",""],[6070,"رَأيتُ العُمرَتبكيهِ الورودُ*","https://www.poetsgate.com/ViewPoem.aspx?id=189502",""],[6142,"هلم نرق ماء العيون لمن أحيا","https://www.poetsgate.com/ViewPoem.aspx?id=155751",""]],"verses":[["ورأفَةُ القائِمِ المَرجوّ نائِلُهُ","والسُّحْبُ تعْتَلُّ والأنواءُ تَعْتَذِرُ",0,"ر",1,0],["وَرافِقيني تَري هاماً مُفَلَّقَةً","وَالطَيرَ عاكِفَةً تُمسي وَتَبتَكِرُ",1,"ر",1,0],["وَرَافَقْتَ وِلْدَانَ الْجِنَانِ وَحُورَهُ","وَمَنْ قَدَّمَ الْخَيْرَ اسْتَطابَ وجُورهُ",2,"ه",1,0],["ورافلٍ في صوانِ الحُسنِ مشتملِ","بمبذلٍ وهو فيهِ غيرُ مبتذلِ",3,"ل",1,1],["ورافعُ الصّرح لاستقلاله عَجَباً","صُنعُ السماء تُرَى أم صُنعُ إِنسانِ",4,"ن",1,0],["ورافِدُ الرَبِّ مَغبوطاً بِصُحبِتَه","وطالبُ الوجَهِ يَرضَى الحالَ مُختارا",5,"ر",2,0],["وَرافِلٍ في جَديدٍ كانَ يَرفلُ في","مِثالِهِ اِبني غُداةَ العيدِ مُذ عامِ",6,"م",1,0],["ورافق دليل العلم يهدك انه","طريق يحار العقل فيه وعير",7,"ر",1,0],["ورافقَها نورٌ من الوعيِ مُسْفِرٌ","كأنوارِ أسحارٍ ترقرقها سكبا",8,"ب",2,0],["ورافعينَ طُنُباً تدعَمه","قدودُهم دامَ لكم رفيعه",9,"ع",2,0],["ورافع الغُفل شرَّاب بأنقصه","خرِّيتُ مشتبه فياده غَرِد",10,"د",1,0],["وَرَأفَةٌ لَو غَدَت مُقَسَّمَةً","في الناسِ ما عَقَّ والِداً وَلَدُ",11,"د",1,0],["وَرَأْفَةٌ مِنْ رَؤُوفٍ جَلَّ مِنْ صَمَدٍ","وَرَحْمَةٌ مِنْ رَحِيمٍ مُنْتَهَى الأَرَبِ",12,"ب",1,0],["ورافعاً بيت مجد قد سما وتداً","على السماك وطال المرزم السبب",13,"ب",1,0],["ورافضةٍ من مائها في هوائِها","نَثاراً يُريها في عدادِ النَواصبِ",14,"ب",1,1],["ورافع أطباق السموات عبرة","مزينها بالنيرات الزواهر",15,"ر",1,0],["وَرافِضٍ لِسِنَّتي بِجَهلِهِ","يَذُمُّ مِن لِسَعيِهِ اللَهُ شَكَر",16,"ر",1,0],["وَرَأفتهُ لَنا غَوث مُغيث","وَيُمناهُ لَنا غَيث هَطول",17,"ل",1,0],["ورافعي فوق أهلِ الحُب مرتبةً","ما كان قطّ إليها قبل ذاك رُقي",18,"ق",2,0],["ورافِقِ الرَّفْقَ في كُلَّ الأمورِ فلَمْ","يندّمْ رَفيقٌ ولم يذمُمْهُ إنسانُ",19,"ن",1,0],["ورأفيك في ملمات الرزايا","إذا ما أعضلت رأيٌ رصين",20,"ن",1,0],["ورافعٌ لَكَ من إِذْعانِهِ عَلَماً","كَمُوقِد النارِ فِي علياءِ مَوْقِدِهِ",21,"د",2,0],["ورافدْني بكفّك فوق قلبي","ببُرقة عاقلٍ إن عنَّ برقُ",22,"ق",1,0],["ورافق الرجل الشهم الكريم فلن","يخامر السوء أصحاب المروآت",23,"ت",1,0],["ورافِقِ التَّقيَّ واغْنَمْ وقتَهُ","فلذَّةُ العيشِ بأَصحابِ التَّقَى",24,"ا",1,0],["ورافِعِ الصَّوْتِ بالغِنَاءِ فَهَلْ","يُؤْنِسُ دون البَلْقَاءِ من أحَدٍ",25,"د",1,0],["وَرَأفته بِالعالَمين سَجيةٌ","بِها كُل فَرد في المَحافل يَشهَد",26,"د",1,0],["وَرافِضَةٍ تَقولُ بِشِعبِ رَضوى","إِمامٌ خابَ ذلِكَ مِن إِمامِ",27,"م",1,0],["ورافقني خليل كان قبلا","يوافي حين كنا ظاهرينا",28,"ن",2,0],["ورأفة بعباد اللَه كافلة","بخير ما حدّثت نفساً أمانيا",29,"ي",2,0],["ورأفة كللت بالنجح قاصدها","حتى يعود نجيا بعد إهلاك",30,"ك",1,0],["وَرافَقَ خِدناً هَمَّ يَبغي سَماوَةً","مِنَ العِزِّ يَأتي دونَها كُلُّ قائِمِ",31,"م",1,0],["ورافع رايات العدالة فوق ما","له من بناه في المكارم تشييد",32,"د",1,0],["ورافع راية الأداب في الهن","د لم ترفع بمصر ولا العراق",33,"ق",1,0],["وَرَافِق لِذي عَلَمٍ لَكَ لاَ","تُفَارِقهُ فِي السَّيرِ حَرّا وَبَردَا",34,"د",2,0],["ورافعٌ لها إذا أراهُ","بقولِ لا إله إلا اللهُ",35,"ه",1,0],["ورافعٌ لولا الذي من خفضهِ","لم يظهرنّ في السما وأرضهِ",36,"ه",1,0],["ورافقي الرفق لنيل الارب","لو لم يكن الا انتقاص التعب",37,"ب",1,0],["وَرافَعَ الَّذي لَهُ قَد صَحَّحا","نِياتِهِ وَبَرِّهِ كَم مَنحا",38,"ح",2,0],["ورافعُ الاسمِ إن حققتَ أضْرُبَهُ","لمعنويٍّ ولفظيٍّ قد انقسما",39,"م",2,0],["ورافعُ اللفظِ فعلٌ أو مشابِهُهُ","وما غدا مَعَهُ في الحُكمْ مُستَهِما",39,"م",2,0],["وَرافِعين مِن البُنيان شاهِقَه","فيهِ الذَخائِرُ قَد صُفَّت لِرائِيها",40,"ي",3,0],["ورافقهم ذاك المحكم وابنه","وحلوا بمتز كلهم ناعمي البال",41,"ل",1,0],["ورافقَ الصَّمتَ في ترحاله غلسٌ","والفجرُ أذَّن بالإشراقِ مولدُه",42,"د",2,0],["ورافع السبع فوق سبع","لم يستعن فيهما معينا",43,"ن",2,0],["ورافق أصحاب النبي محمد","وخالف ما قد قاله كل مازق",44,"ق",1,0],["وَرافِعَةً صَوْتي بِكُلِّ شُجونِها","لَعَلَّ سَماواتِ الحَرائِرِ تُمْطِرُ",45,"ر",1,0],["ورافقْ كلَّ ذي عَقلٍ لبيبٍ","هو المعروفُ تعرفُهُ العهودُ",46,"د",1,0],["ورافده العداء واللامع الشبا","فلا ذا كبا جريا ولا ذا نبا فريا",47,"ي",2,0]]}