 سَخَطِ اللَهِ عَلى الخَلقِ",4,"ق",1,0],["موتوا مِنَ الغَيظِ غَمّاً في جَزيرَتِكُم","لَم يَقطَعوا بَطنَ وادٍ دونَهُ مُضَرُ",5,"ر",1,0],["موتهن انتباشهن من القب","ر ويحيَيْنَ ما سكن القبورا",6,"ر",2,0],["مَوْتُ السَّلامة للإنسان نَعْلَمُهُ","وإنَّما القِتْلةُ الشَّنْعاءُ للأَسَدِ",7,"د",1,0],["مَوتُ الطَوى شَرٌّ وَلَكِنَّما","رَفظَعُ مِنهُ المَوتُ بِالتُخمَةِ",8,"ه",1,0],["مَوْتى نَسُوا شَوْقَ الحياةِ وعزمها","وتحرّكوا كَتَحرُّكِ الأنْصابِ",9,"ب",1,0],["موت كما أخذ الكرى","لا نزع فيه ولا حضور",10,"ر",1,0],["مُؤتَلِفٌ سِربُها","حَيثُ تَلاقى اِلتَأَم",11,"م",1,0],["مَوْتاً وقَتْلاً بهاماتٍ مُفَلَّقَةٍ","مِنْ هاشِمٍ غابَ عنها النّصرُ والظّفَرُ",12,"ر",1,0],["مَوْتٌ تَنَافَسُهُ الملوكُ ويُشْتَرَى","بِعَقَائِلٍ تُلْدٍ ومُطّرَفَاتِ",13,"ت",1,0],["مَوْتٌ أَعَزُّ مِنَ الحَياةِ عَلَيهمُ","وأَلَذُّ في الأَفْوَاهِ واللّهَواتِ",13,"ت",1,0],["موتُها من نفوسِها وعجيبٌ","من جسومٍ بُدنُهُنَّ النّفوسُ",14,"س",1,0],["مَوتورَةٌ بِشَبا الأسِنَّةِ لو بَغَتْ","وِتْراً إليكَ تضاعَفَتْ أوتارُها",15,"ر",3,0],["مَوتُ بَعضِ الناسِ في الأَر","ضِ عَلى بَعضٍ فُتوحُ",16,"ح",1,0],["مَوتورَةٌ طَلَبَ الإِلَهُ بِثَأرِها","وَكَفى بِرَبِّ الثَأرِ مُدرِكَ ثارِ",17,"ر",1,0],["موتي حسينيٌّ بها ومَلامُكُمْ","فيها يزيدٌ وقدرُها عندي علي",18,"ل",2,0],["موتى الضمائرِ تُعطي المَيْتَ دمعتَها","وتستعينُ على حيٍّ بسكِّين",19,"ن",1,0],["موتي فَما مَوتُ العَليلِ بِضائِرٍ","وَكَفى بِآلامِ الحَياةِ حِماما",20,"م",2,0],["مَوتي كَذا أَلَمُ الهَوى","لَكِنَّ صَبري لا يَكونُ",21,"ن",1,0],["مَوْتاتُ سَوْءٍ تَلَقَّوْها بما صَنَعُوا","وَمِنْ وَراءِ تَلَقِّيهِمْ لها سَقَرُ",22,"ر",1,0],["مُوتوا بغَيظٍ كما قَدْ ماتَ قَبلَكُمُ","قابِيلُ إِذْ قَرَّب القُرْبانَ هابيلُ",23,"ل",1,0],["مَوتٌ يَسيرٌ مَعهُ رَحمَةٌ","خَيرٌ مِنَ اليُسرِ وَطولِ البَقاءِ",24,"ق",3,0],["مَوتانِ هَذا بِوَرسٍ عُلَّ مَيِّتُهُ","وَآخَرَ زادَ عَن وَرسٍ بِفِرصادِ",25,"د",1,0],["مَوتُهُ أَجرٌ وَمَحياهُ غِنىً","وَإِليِه عَن أَذاةٍ مُعتَزَل",26,"ل",1,0],["مَوتاً وَقَتلاً كَأَنَّ الدَهرَ يَظمَأُ ما","عاشوا وَيَنقَعُ ما ماتوا وَما قُتِلوا",27,"ل",3,0],["مَوْتٌ كَمَوْتِ الطَّاعِنِينَ وَقَدْ","مَضَتِ السِّنُونَ بِهِمْ إِلَى الْحَدِّ",28,"د",1,0],["مَوْتُ المُجَاهِدِ لاَ بِه","كَسِوَاهُ بَلْ هُوَ وَاجِبٌ أُدِّي",28,"د",2,0],["مؤتمر الجماد","أدوات الحرب عنها أضربت",29,"ت",1,0],["موتوا كراماً، أو فعيشوا أمة","تهوي على يدها العلى وتبوسها",30,"س",3,0],["موتُ الكرامِ حيَاةٌ فِي مواطنِهمْ","فإِنْ هُم اِغتربوا ماتوا وما ماتُوا",31,"ت",3,1],["مَوتُ الكرامِ البيضِ فوقَ جيادِهم","لا فَوقَ نُمرقَةٍ وتحتَ طِرافِ",32,"ف",1,0],["موت بعض الشّعب يحيي كلّه","إنّ بعض النقص روح الاكتمال",33,"ل",1,0],["موّتني أكثر .. موتتي من بين يدّينك...؟ أمان","لانّي أنا لارحت.؟؟. يامنجن , والاّ منتحر",34,"ر",1,0],["موت الجبان يشابه لموت الشجاع","الموت واحد..لكن الفارق ذكر",35,"ر",1,0],["موت الحمير فرج للكلاب","مسبة الدين بمطرحها حلال",36,"ل",1,0],["موت الحمير على علاته فرج","يشفي كلابك من جوع تعانيه",36,"ه",1,0],["موتٌ ترى الموتَ ينْبُو من مخافته","مَلْكٌ له هِمَّةٌ في الملكِ قَعساءُ",37,"ا",2,0],["مَوتورُها لا يَشتَفي وَطَريدُها","لا يَنكَفي وَقَتيلُها لَن يُعقَلا",38,"ل",2,0],["موتًا كثيرًا قد سُقيتَ مِنَ الرّدى","ومحت ظِلالَ كيانِكَ الظّلماءُ",39,"ا",2,0],["مَوتهُ نَقلةٌ لأعلى فأعلى","كلُّ علياءَ فوقها علياءُ",40,"ا",2,0],["موت المجاهد في سبيل فضيلة","هو للفضيلة في سواهُ مولدُ",41,"د",1,0],["مؤتلفاتٍ جذلاً","وهنَّ بعضُ الجذلِ",42,"ل",1,0],["موت البريَّة عند وقت وفاتِها","والعاشقون لهم فنونُ مماتِ",43,"ت",1,0],["مَوتُ الفَتى سِجنٌ فَكَيفَ وَفُرقَةٌ","خَطبانِ يوهي منهُما جَلدُ الصَفا",44,"ف",2,0],["مَوتُهُ أَقرَحَ أَجفانَ العُلى","وَاِنطَوَت مِن بَعدِهِ بُسطُ النَوالِ",45,"ل",1,0],["موتورة قد أصابتْ منه غرَّته","فأَقصدتْ وَكذا فتك الرعاد يد",46,"د",1,0],["مُؤتَلِفٌ خِلتَ في أَواخِرِهِ","حُداةَ عِيرٍ إِذا جَلَّحوا صَدَحوا",47,"ح",3,0],["مُؤَتَّرَةِ الأَنساءِ مُعوَجَّةِ الشَوى","سَفينَةُ بَرٍّ بِالنَجاءِ دَفوقُ",48,"ق",1,0],["مَوت العُلوم بِمَوت العارِفين بِها","وَمَوتِهِم لِخَرابِ الدارِ عُنوان",49,"ن",1,0],["مَوْتي أو داوِ بالتداني دائي","الموتُ ولا شَماتهُ الأعداء",50,"ا",2,0],["موتٌ ودين اللَه مع ملكوتِه","وجهنمُ النيران والآلامِ",51,"م",1,0],["موته أكفلٌ فإن","مات بالخير يقبر",52,"ر",1,0],["موت زران أردت فالموت عندي","صار للحر خير ما يقتنيه",53,"ي",2,0],["مَوتُ الذَليل كَعَيشِهِ وَيَد الفَتى","شَلّاء أَو مَقطوعَة سِيّانِ",54,"ن",1,0],["موت الوعول وموت الأسد خادرةً","إلا كموت ظباء الخنس العفر",55,"ر",1,0],["موت البلار وموت من فيها ولا","موت امرئ فرد من الفقهاء",56,"ا",2,0],["موت الغني أَخي الثراء وإِن علا","إِلا وجدك موتة الفقراء",57,"ا",2,0],["موت الأسود الضواري موت عكرسة","موت المساكين إلا موت ذي الشرف",58,"ف",1,0],["موت الصغار بأحشاء الكبار حكى","ناراً من الحزن تلهاب لها وسنا",59,"ن",2,0],["مؤتنِفٌ غير مستزيدٍ","وعاثرٌ غير مستقيلِ",60,"ل",1,0],["موتٌ عدوٍ وحياةُ وافدٍ","في السّلمِ شهدٌ والحروبِ علقم",61,"م",1,0],["موتى صدى تضمُّها","أكفانها من الخلل",62,"ل",1,0],["مُوتُوا إذا شِئْتُمُ قَدْ طَارَ مِنْ كَلِمي","مِنْ نُصْرَةِ الْحَقِّ ما حَرَّرْتُ في الكُتُبِ",63,"ب",1,0],["مَوتُ التَّقيِّ حياةٌ لا انقِطَاعَ لها","قد مات قَومٌ وَهُم في النَّاسِ أحيَاءُ",64,"ا",2,1],["مَوتي حَياتي بِها ذلي لبهجتها","عزِّي وَأَمنيَ مِن روعٍ وَإِفلاس",65,"س",1,0],["موت الفتى الحر في الهيجاء أفضل من","موت الفتى الحر بالأحزان والهُون",66,"ن",1,0],["موتكم ظمأى فراحت أنفسُ","ما لها غير المنايا موردُ",67,"د",1,0],["مَوتُهُ خَطْبٌ عظيمٌ","عمّنا فيه البلاءُ",68,"ا",2,0],["موتوا بلا أعبَاء تحت غِطائِكمْ","ما أسعَد الموتى بلا أعبَاءِ",69,"ا",2,0],["مؤتمن الدين يا ابن غيث","لا زلت فراج كل ضيقِ",70,"ق",1,1],["مؤتمنَ الدولة وله سبحانَ من","حسَّن أخَلاقَك والخِلقَه",71,"ق",2,1],["مؤتمن الدين أبق وأسمع ثناء","يزري على الدر بترصيفِهِ",72,"ف",2,1],["موتى وهجرك مقرونان في قرن","فكيف أهجر من في هجره أجلي",73,"ل",2,0],["مَوْتَى وَأَحْياءً بَشَرٍّ مُوقَرِ","يَشْكُونَ فَقْراً لَيْسَ بِالتَفَقُّرِ",74,"ر",1,0],["موتوا كراما والخليل قد منع","إلا بما ابتدي بمجموع يقع",75,"ع",1,0],["موتاً من اللحظ فهوَ المالك الحكُم","قضى الزمان بأَن انجو بلا طلبٍ",76,"ب",1,0],["موت الأَحِبَّة للأَحِبَّة قبضهم","بل نهضهم عن رتبة الأنكاس",77,"س",1,0],["مَوْتَى أجَنَّتْهَا الصدورُ وربما","رَجَعَ النشورُ بها على الوسواس",78,"س",1,0],["مَوْتَى فإن قَلِقَتْ أجفانُها علمتْ","أنَّ الدروعَ 