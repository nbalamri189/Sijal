{"poems":[[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[85,"لا تعجبوا لكويتب صعفت","https://www.aldiwan.net/poem7554.html","أحذ الكامل"],[45,"أمير المؤمنين أما غياث","https://www.aldiwan.net/poem64646.html","الوافر"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[69,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[77,"أيغلبُ من عاداك والله غالبُه","https://www.poetsgate.com/ViewPoem.aspx?id=33204",""],[100,"من رحلة الطاحونة الى الميلاد الثاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67666&r=&rc=153",""],[116,"اطل مدة الهجر ان ما شئت وارفض","https://www.aldiwan.net/poem40918.html","عموديه"],[144,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[144,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[170,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[170,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[170,"زهت هجر من بعدما رث حالها","https://www.aldiwan.net/poem1648.html",""],[213,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[272,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[440,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[440,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[454,"أيا ذكريات الأمس ترقصن في الرؤى","https://www.aldiwan.net/poem61233.html","الخفيف"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"]],"verses":[["فَيَاذُلَّ أّذْنٍ همُّهَا إِذْنَ حَاجِبٍ","وَيَا هُونَ وَجْهٍ خَلْفَ سُدَّةِ بَابِ",0,"ب",1,0],["في اذنه الأقلام قد زرعت","لكنها في صدغه نشأت",1,"ت",1,0],["فَيا ذُلَّ البَريدِ وَمُبرِديهِ","إِذا فَضَّت خَرائِطُهُ الخَروطُ",2,"ط",1,0],["فَيا ذِلَّةَ الخَصرِ اللَطيفِ وَقَد خَلا","بِهِ وَهَلُ الأَقرابِ نَهدُ المَراكِلِ",3,"ل",1,0],["فيا ذوي الفضلِ رفقاً إنَّ دهرَكُم","لمْ يدرِ ما الفضةُ البيضا منَ السبجِ",4,"ج",1,0],["فيا ذكرى الأحبةِ مات قلبي","فإني لا أحسّ له حراكا",5,"ك",2,0],["فَيَا ذُلَّ مَنْ عَادَاكَ يَا مَلِكَ الْعُلَى","لَخَابَتْ أَمَانِيهِ وَسَاءَتْ عَوَاقِبُهْ",6,"ب",2,0],["فيا ذلَّ من عاداك يا ملكَ العُلا","لخابَت أمانيهِ وساءت عواقِبُه",7,"ب",2,0],["فيا ذكريات التيه من جرّ قبلنا","خطاه وأمسى مثلنا حيث أصبحا",8,"ح",2,0],["فيا ذا الرياسات الموفق حامدا","لك القلب لم يبرح فأوف وانقض",9,"ض",1,0],["فَياذا الصَدرِ يَزدادُ اِتِّساعاً","إِذا ما اِزدادَ صَدرُ الدَهرِ ضيقا",10,"ق",2,0],["فَيا ذا العَطايا لَم تَدَع مُتَطَلِّباً","وَيا ذا القَضايا لَم تَدَع مُتَظَلِّما",11,"م",2,0],["فيا ذوي العلم يقرا الكفر بينكم","وان سئلتم تقولوا القول لم يجب",12,"ب",1,0],["فَيا ذا العُلى كَم ذا التَجَنّي عَلى القِلى","وَفي العَزمِ حادٍ لِلمَطايا وَقائِدُ",13,"د",1,0],["فَيا ذا العُلى وَالمَجدِ وَالمَنصِبِ الَّذي","سَما فَعَلا حَتّى على النَّجمِ أَتأَدا",14,"د",2,0],["فَيا ذا العُلى وَالمَجدِ وَالدَوحَةِ الَّتي","زَكى فَرعُها وَاِزدادَ طيباً ظِلالُها",15,"ل",3,0],["في أذنهِ حِسّ عُودٍ صوتُ سائلهِ","أفنى خزائنَه بَذْلٌ وإنْفاقُ",16,"ق",1,0],["فيا ذلّةَ الإسلامِ والمُلكِ والتُّقى","وقد وطِئ الأعلاجُ خزّاً ومرمرا",17,"ر",2,0],["فَياذا كرا عن ذي الاراك اعد لنا","حَديثك عَن أَهل الاراك يطيب",18,"ب",1,0],["فيا ذرَّةً فوق سطح العُباب","نأى الشطُّ فالتحمي بالعُباب",19,"ب",1,0],["فيا ذِمَّةَ الصِّهر الَّذِي شَدَّ عَهْدَها","بخاتِمَةِ الآياتِ من آيةِ الكُرسِي",20,"س",2,0],["فَيا ذُلَّ أَعلامِ الهُدى يَوْمَ عِزِّهِمْ","ويا عِزَّ أَعْلامِ الهُدى بِكَ إِذْ هانُوا",21,"ن",3,0],["فيا ذكريات الأمس عودي وجددي","شبابي بسحر كالشباب مغالي",22,"ل",2,0],["فيا ذِلَّةَ الشاكي إذا كانَ لا يرى","سِوى ظالمٍ مِن مثلِهِ يتعلَّمُ",23,"م",1,0]]}