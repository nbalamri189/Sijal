{"poems":[[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[85,"لا تعجبوا لكويتب صعفت","https://www.aldiwan.net/poem7554.html","أحذ الكامل"],[45,"أمير المؤمنين أما غياث","https://www.aldiwan.net/poem64646.html","الوافر"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[69,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[77,"أيغلبُ من عاداك والله غالبُه","https://www.poetsgate.com/ViewPoem.aspx?id=33204",""],[113,"اطل مدة الهجر ان ما شئت وارفض","https://www.aldiwan.net/poem40918.html","عموديه"],[141,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[141,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[158,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[167,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[167,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[167,"زهت هجر من بعدما رث حالها","https://www.aldiwan.net/poem1648.html",""],[210,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[269,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[436,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[451,"أيا ذكريات الأمس ترقصن في الرؤى","https://www.aldiwan.net/poem61233.html","الخفيف"],[475,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"]],"verses":[["فَيَاذُلَّ أّذْنٍ همُّهَا إِذْنَ حَاجِبٍ","وَيَا هُونَ وَجْهٍ خَلْفَ سُدَّةِ بَابِ",0,"ب",1,0],["في اذنه الأقلام قد زرعت","لكنها في صدغه نشأت",1,"ت",1,0],["فَيا ذُلَّ البَريدِ وَمُبرِديهِ","إِذا فَضَّت خَرائِطُهُ الخَروطُ",2,"ط",1,0],["فَيا ذِلَّةَ الخَصرِ اللَطيفِ وَقَد خَلا","بِهِ وَهَلُ الأَقرابِ نَهدُ المَراكِلِ",3,"ل",1,0],["فيا ذوي الفضلِ رفقاً إنَّ دهرَكُم","لمْ يدرِ ما الفضةُ البيضا منَ السبجِ",4,"ج",1,0],["فيا ذكرى الأحبةِ مات قلبي","فإني لا أحسّ له حراكا",5,"ك",2,0],["فَيَا ذُلَّ مَنْ عَادَاكَ يَا مَلِكَ الْعُلَى","لَخَابَتْ أَمَانِيهِ وَسَاءَتْ عَوَاقِبُهْ",6,"ب",2,0],["فيا ذلَّ من عاداك يا ملكَ العُلا","لخابَت أمانيهِ وساءت عواقِبُه",7,"ب",2,0],["فيا ذا الرياسات الموفق حامدا","لك القلب لم يبرح فأوف وانقض",8,"ض",1,0],["فَياذا الصَدرِ يَزدادُ اِتِّساعاً","إِذا ما اِزدادَ صَدرُ الدَهرِ ضيقا",9,"ق",2,0],["فَيا ذا العَطايا لَم تَدَع مُتَطَلِّباً","وَيا ذا القَضايا لَم تَدَع مُتَظَلِّما",10,"م",2,0],["فيا ذوي العلم يقرا الكفر بينكم","وان سئلتم تقولوا القول لم يجب",11,"ب",1,0],["فَيا ذا العُلى كَم ذا التَجَنّي عَلى القِلى","وَفي العَزمِ حادٍ لِلمَطايا وَقائِدُ",12,"د",1,0],["فَيا ذا العُلى وَالمَجدِ وَالمَنصِبِ الَّذي","سَما فَعَلا حَتّى على النَّجمِ أَتأَدا",13,"د",2,0],["فَيا ذا العُلى وَالمَجدِ وَالدَوحَةِ الَّتي","زَكى فَرعُها وَاِزدادَ طيباً ظِلالُها",14,"ل",3,0],["في أذنهِ حِسّ عُودٍ صوتُ سائلهِ","أفنى خزائنَه بَذْلٌ وإنْفاقُ",15,"ق",1,0],["فيا ذلّةَ الإسلامِ والمُلكِ والتُّقى","وقد وطِئ الأعلاجُ خزّاً ومرمرا",16,"ر",2,0],["فَياذا كرا عن ذي الاراك اعد لنا","حَديثك عَن أَهل الاراك يطيب",17,"ب",1,0],["فيا ذرَّةً فوق سطح العُباب","نأى الشطُّ فالتحمي بالعُباب",18,"ب",1,0],["فيا ذِمَّةَ الصِّهر الَّذِي شَدَّ عَهْدَها","بخاتِمَةِ الآياتِ من آيةِ الكُرسِي",19,"س",2,0],["فَيا ذُلَّ أَعلامِ الهُدى يَوْمَ عِزِّهِمْ","ويا عِزَّ أَعْلامِ الهُدى بِكَ إِذْ هانُوا",20,"ن",3,0],["فيا ذكريات الأمس عودي وجددي","شبابي بسحر كالشباب مغالي",21,"ي",1,0],["فيا ذِلَّةَ الشاكي إذا كانَ لا يرى","سِوى ظالمٍ مِن مثلِهِ يتعلَّمُ",22,"م",1,0]]}