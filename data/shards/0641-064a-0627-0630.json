افر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97104","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90813","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133169","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58016","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136386",""],[3464,"شموس سعوده هلت تبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158759",""],[4578,"بشاير وافتنا بسعد محمدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49407",""],[5010,"أذّن شيطانه في أذنه","https://www.poetsgate.com/ViewPoem.aspx?id=189861",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5503,"هِيَ النَّفس بَين الْعقل الطَّبْع والهوى","https://www.poetsgate.com/ViewPoem.aspx?id=194724",""],[5616,"إليك يا قمري المسجى","https://www.poetsgate.com/ViewPoem.aspx?id=204868",""],[5720,"خيرُ الخلقِ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199490",""],[5720,"لِيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=204764",""],[5781,"يَبابهُ وربيعي","https://www.poetsgate.com/ViewPoem.aspx?id=202855",""],[5829,"لك همس الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=198412",""],[5874,"ذئبةُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202082",""],[5913,"جريمة حب","https://www.poetsgate.com/ViewPoem.aspx?id=177073",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6102,"السِّفر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=186268",""],[6333,"آخر رسالة حب مالم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7033&r=&rc=1",""]],"verses":[["فَيَاذُلَّ أّذْنٍ همُّهَا إِذْنَ حَاجِبٍ","وَيَا هُونَ وَجْهٍ خَلْفَ سُدَّةِ بَابِ",0,"ب",1,0],["في اذنه الأقلام قد زرعت","لكنها في صدغه نشأت",1,"ت",1,0],["فَيا ذُلَّ البَريدِ وَمُبرِديهِ","إِذا فَضَّت خَرائِطُهُ الخَروطُ",2,"ط",1,0],["فَيا ذِلَّةَ الخَصرِ اللَطيفِ وَقَد خَلا","بِهِ وَهَلُ الأَقرابِ نَهدُ المَراكِلِ",3,"ل",1,0],["فيا ذوي الفضلِ رفقاً إنَّ دهرَكُم","لمْ يدرِ ما الفضةُ البيضا منَ السبجِ",4,"ج",1,0],["فيا ذكرى الأحبةِ مات قلبي","فإني لا أحسّ له حراكا",5,"ك",2,0],["فَيَا ذُلَّ مَنْ عَادَاكَ يَا مَلِكَ الْعُلَى","لَخَابَتْ أَمَانِيهِ وَسَاءَتْ عَوَاقِبُهْ",6,"ب",2,0],["فيا ذلَّ من عاداك يا ملكَ العُلا","لخابَت أمانيهِ وساءت عواقِبُه",7,"ب",2,0],["فيا ذكريات التيه من جرّ قبلنا","خطاه وأمسى مثلنا حيث أصبحا",8,"ح",2,0],["فيا ذا الرياسات الموفق حامدا","لك القلب لم يبرح فأوف وانقض",9,"ض",1,0],["فَياذا الصَدرِ يَزدادُ اِتِّساعاً","إِذا ما اِزدادَ صَدرُ الدَهرِ ضيقا",10,"ق",2,0],["فَيا ذا العَطايا لَم تَدَع مُتَطَلِّباً","وَيا ذا القَضايا لَم تَدَع مُتَظَلِّما",11,"م",2,0],["فيا ذوي العلم يقرا الكفر بينكم","وان سئلتم تقولوا القول لم يجب",12,"ب",1,0],["فَيا ذا العُلى كَم ذا التَجَنّي عَلى القِلى","وَفي العَزمِ حادٍ لِلمَطايا وَقائِدُ",13,"د",1,0],["فَيا ذا العُلى وَالمَجدِ وَالمَنصِبِ الَّذي","سَما فَعَلا حَتّى على النَّجمِ أَتأَدا",14,"د",2,0],["فَيا ذا العُلى وَالمَجدِ وَالدَوحَةِ الَّتي","زَكى فَرعُها وَاِزدادَ طيباً ظِلالُها",15,"ل",3,0],["في أذنهِ حِسّ عُودٍ صوتُ سائلهِ","أفنى خزائنَه بَذْلٌ وإنْفاقُ",16,"ق",1,0],["فيا ذلّةَ الإسلامِ والمُلكِ والتُّقى","وقد وطِئ الأعلاجُ خزّاً ومرمرا",17,"ر",2,0],["فَياذا كرا عن ذي الاراك اعد لنا","حَديثك عَن أَهل الاراك يطيب",18,"ب",1,0],["فيا ذرَّةً فوق سطح العُباب","نأى الشطُّ فالتحمي بالعُباب",19,"ب",1,0],["فيا ذِمَّةَ الصِّهر الَّذِي شَدَّ عَهْدَها","بخاتِمَةِ الآياتِ من آيةِ الكُرسِي",20,"س",2,0],["فَيا ذُلَّ أَعلامِ الهُدى يَوْمَ عِزِّهِمْ","ويا عِزَّ أَعْلامِ الهُدى بِكَ إِذْ هانُوا",21,"ن",3,0],["فيا ذكريات الأمس عودي وجددي","شبابي بسحر كالشباب مغالي",22,"ل",2,0],["فيا ذِلَّةَ الشاكي إذا كانَ لا يرى","سِوى ظالمٍ مِن مثلِهِ يتعلَّمُ",23,"م",1,0],["فيا ذا العلى مُحسن قد أتاك","وفي بابِ علياك قد حطّ رَحلا",24,"ل",2,0],["فَيا ذا الَّذي سادَ الوَرى بِمنَاقب","تَجل عَن الإِحصاء إِذ هِيَ عُدّت",25,"ت",1,0],["فيا ذا الذي يسعى ليدركَ غايتي","رأيت هجيناً مع جوادٍ يُسابقه",26,"ق",2,0],["فَيا ذا الوَزير الكَرم مَن شاعَ جودهُ","تَخَلّقْ بِخلق اللَّه مَنْ لَكَ أَوجَدا",27,"د",2,0],["فيا ذا الجود جد لي بمامولي وقصدي","وخذني في نهوضي الطريق المستقيمه",28,"م",2,0],["فياذا الجود هبنا حب","ه واحفظ من النكب",29,"ب",1,0],["فيا ذات الطهارة شفّعي بي","دموعي واشفعي لي يا سروري",30,"ر",2,0],["فيا ذخيرة مصر يوم أعوَزَها","في موقف الهول مأمول ومدَّخرُ",31,"ر",1,0],["فياذات الرَّشاقة والتثني","متى ألقاك أو أنَّي أراك",32,"ك",1,0],["فَياذا الَّذي عَن قَوس إِعجابِهِ رَمى","فَخابَت مَراميهِ وَذو العُجَبِ خائب",33,"ب",1,0],["فَيَأذى بِيَ الأَدنى وَيَشمَت بِيَ العِدا","وَيَأمَنُ كَيدي الكاشِحونَ الأَباعِدُ",34,"د",1,0],["فَيا ذعرة الغُزلان أَن يَرنو طَرفَها","وَيا خَجلة الأَغصان أَن يَمس العَطف",35,"ف",1,0],["فئاذانُنا خرس عن الهجو والخنا","وعن غيبة الاخوان والشتم والسب",36,"ب",1,0],["فَيا ذُبانةً جَلَسَتْ بِنَجو","وَتَحسَبُ أَنّهُ عَسَلٌ وَشَمْعُ",37,"ع",1,0],["فيا ذلها تلك المواهب إنها","أضاعت إبائي بين أهلى أو صحبي",38,"ب",2,0],["في إذ جنّ ليلي","بتُّ أساريه لاله",39,"ل",2,1],["فَيَا ذَلِكَ الدَّانِي إلى ذَلِكَ الحِمَى","إِذَا ما أَنَخْتَ العِيسَ في ذَلِكَ الوَادِي",40,"د",2,0],["فيا ذِكرَ ليلى شَنِّفِ السمعَ مُوقَراً","أحاديثَ من ليلى يَذوب لَهَا الصَّخر",41,"ر",1,0],["فيا ذا الجلالةِ والصالحاتِ","يذخرها الحُوَلُ القُلَّبُ",42,"ب",1,0],["فَيا ذُخر مِصر ان مِصراً وَاِهلها","لاِحسان مَولاها غَدَت كُلَّها أَسرى",43,"ر",2,0],["في أذنه لؤلؤة","كأنها والحلقه",44,"ق",2,0],["فيا ذا الذي قد عمَّني بِرُّ فضلهِ","فطيماً صغيراً مُنذُ ما ضمَّني مهدُ",45,"د",1,0],["فيا ذنوبي وخير القول وا أسفا","يا ليت شعري لدى الديان ما شاني",46,"ن",2,0],["فَيا ذاك الجَمال وَكُنت تَهوى","وَقَد كُنت المعززَ في القُلوب",47,"ب",1,0],["فَيا ذوي العَقل إمّا أَن تعوا فتَفوا","بالعذرِ عَهدي وَإِلا فاقتفوا وَقفوا",48,"ف",3,0],["فيا ذنب الزمان إلى البرايا","حرمت من الردى عذراً جميلا",49,"ل",2,0],["فَياذا المَعاطِفِ عَطفاً لَنا","وَيا ذا التَمايُلِ هَل مِن نَصيبِ",50,"ب",1,0],["فَيا ذا التَسامي يا أَمينُ إِخائِهِ","وَمَن لاحَ في أُفقِ المُروءَةِ فَرقَدا",51,"د",2,0],["فَيا ذا الفَضلِ يا حُسنَ السَجايا","كَذا اِسماً حَيثُ حَلَيتُكَ العَلاء",52,"ا",2,0],["فيا ذكاء بأفق الفضل قد بزغت","فارتد عنها حسير الطرف من طمحا",53,"ح",2,0],["فيا ذات الخبا هل من تدان","ويا عهد الصبا هل من غياب",54,"ب",1,0],["فيا ذا الموشم إلى كم تغشم","أيا عطراً لمن شم أما ترحموني",55,"ي",1,0],["فيا ذلاًّ لمن أضحوا جنوداً","وأنصاراً له وهو الأميرُ",56,"ر",1,0],["فيا ذا الخديوي الذي كل عصره","على مصره عيد له يغبط الدهر",57,"ر",1,0],["فيا ذا الغرب زد بشراً ورفقاً","إذا منه أو افخر ذاك جيد",58,"د",1,0],["فياذا الغلى ميلاد نجلك قد علا","بطالعه السامي على كل مولد",59,"د",1,0],["فِيْ أُذْنِهِ شَيْطَانُهُ قَدْ أَذَّنا","فَغَدَا يُصَلِّيْ دُوْنَمَا يَتَطَهَّرُ",60,"ر",1,1],["فيا ذا العرش ثبتني وكن لي","نصيراً حافظاً ولمن دعاني",61,"ي",1,0],["فيا ذَا الَّذِي ضيعت نَفسك فِي الْهوى","تروم لَهَا عزا وَأَنت تهينها",62,"ن",3,0],["فيا ذلَّ القوافلِ والقوافي","إذا غابَ المُخَضَّبُ والخِضابُ",63,"ب",1,0],["فيا ذا النَّدَىٰ والجودِ أبلغْ صَلاتَنَا","إلىٰ مَنْ بهِ عَادَتْ إلينا الفضائِلُ",64,"ل",1,0],["فَيَا ذَا الْعَطَاءَاتِ وَالْمَنِّ هَبْ لِيْ","دُعَائِيْ .. فَأَنْتَ السَّمِيْعُ الْبَصِيْرُ",65,"ر",1,0],["فَيا ذاتَ أَمْسٍ قَدْ صَهَرْتُ فُؤادَهُ","فَأَشْعَلَ فِيَّ النَّارَ أَيَّةَ شُعْلَةِ",66,"ه",1,0],["في أذن من رقدت تغدوا فتذكرني","ياللحروف أذا ما ساقها سبق",67,"ق",1,0],["فيَا ذِئْبَةَ الأحلامِ حُلِّي بِسَاحَةٍ","سِوَى القَلْبِ واخْتَانِي حَبِيبًا سِوَائِيَا",68,"ا",3,0],["فيا ذكرى الأسى فكي أسيراً","جريمته المحبة والتأسي",69,"س",2,0],["فيأذنُ لي أبواي لأمضي","أقابلَهم بجناحٍ طليقْ",70,"ق",1,0],["فَيا ذااا... هاكَ جُرحًا وَاشفِ غِلًّا","وَيا هَ...ذاكَ لَنْ تُشفَى الجُرُوحُ",71,"ح",1,0],["في أذن هذا الدجى ألقيتُ خاطرتي","فخلتُ أن الهوى قد صاغها أدبا",72,"ب",2,0]]}