oem15148.html","الكامل"],[466,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[498,"كم للصبابة والصبا من منزل","https://www.aldiwan.net/poem67332.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34400","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48643","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48810","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203786",""],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128280","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87864","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137955",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201732","الرمل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128886","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86372","الكامل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141838","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104538","الكامل"],[4796,"معزوفة لها","https://www.poetsgate.com/ViewPoem.aspx?id=180984",""],[4830,"هو نفْسُ مُحمّد","https://www.poetsgate.com/ViewPoem.aspx?id=204707",""],[4927,"أم العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=12984",""],[4927,"ارحل يا بلطجي","https://www.poetsgate.com/ViewPoem.aspx?id=79604",""],[4927,"ثلاث ثورات، والقادم أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=80803",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5074,"الضَّيغم الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5150,"ارحلْ ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203386",""],[5246,"يا من يؤمل أن ينال ويرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187068",""],[5261,"رمضان الخير","https://www.poetsgate.com/ViewPoem.aspx?id=212889",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5376,"نورٌ على نورٍ بهاء محمد ِ","https://www.poetsgate.com/ViewPoem.aspx?id=188493",""],[5409,"حتام يحدو الليل في","https://www.poetsgate.com/ViewPoem.aspx?id=155294",""],[5725,"آه يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215377",""],[5829,"الهاتفة","https://www.poetsgate.com/ViewPoem.aspx?id=152689",""],[5829,"بالسلم جئناكم","https://www.poetsgate.com/ViewPoem.aspx?id=178831",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6225,"اعياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78099&r=&rc=156",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""]],"verses":[["وَطَغى عَلَيَّ فَكُلُّ رَحبٍ ضَيِّقٌ","إِن قُلتُ فيهِ وَكُلُّ حَبلٍ يَخنُقُ",0,"ق",1,0],["وطغى على الأبصار","بعد بياضه الزاهي سواده",1,"د",2,0],["وطغى السِّحْرُ والغرامُ بقلبي","فتوسَّلْتُ ضارعاً بجفوني",2,"ن",2,0],["وطغى على المَلَكِ الموسَّدِ بيننا","في ضعفِ زنبقَة ولطفِ أقاحِ",3,"ح",1,0],["وطغت منافعه علَي","ه وصرن دنياه ودينه",4,"ن",2,0],["وطغى على الملك الموسد بيننا","في لطف زنبقة وضعف أقاح",5,"ح",1,0],["وطغَى على الوادي فأصبحتِ الرُّبَى","وكأنَّها تحت العُبابِ وِهادُ",6,"د",1,0],["وطغتْ ثلاثةُ أبحر فتزاخرتْ","وهُمُ هنالك بالفواضل أزخَر",7,"ر",1,0],["وطغَتْ عواصفُها فغَالَ هُبوبُها","أَضْواءَ ذاكَ الكوكبِ اللمّاع",8,"ع",1,0],["وطغت عليه دفاترٌ","كالسيل ليس لها نضوب",9,"ب",1,0],["وطغت ردّة فعادت نبيا","ونخيلا من السيوف الشهيره",10,"ر",2,0],["وطغى حولنا من السفح موج","من ضجيج كأنّه هول حشر",11,"ر",1,0],["وطغيانها يلتوى في الخداع","كما يلتوي في الدجى الأرقمُ",12,"م",1,0],["وطغمةٍ من دُعاةِ السُوء ساقطةٍ","ليسَتْ بِشَوكٍ إذا عُدَّتْ ولا غار",13,"ر",1,0],["وطغتْ منافعهُ علي","ه وضرن دنياه ردينهْ",14,"ن",2,0],["وطغام قوم تزعم الارشاد لا","قال ولا عند التزاحم حال",15,"ل",1,0],["وطغى بحر فضله فهو بحر","علوى وماله من شراع",16,"ع",1,0],["وطَغى ومن يَستغْنِ يطغَ كما الثّرى","إنْ يرْوَ يوصَفْ نَبتُهُ بجُنونِ",17,"ن",1,0],["وطغى فراح يبلّ من","دم كل منكوب غليله",18,"ه",1,0],["وطغت أبالسةُ الجحي","م على ملائكة النعيم",18,"م",1,0],["وَطَغى من طَغى بِجَهلٍ عليها","فهدَتهُ للجِبتِ والطاغوتِ",19,"ت",1,0],["وَطَغى الغَرامُ عَلى السُلُوِّ","فَجَدَّ في سَنَنِ الإِباقِ",20,"ق",1,0],["وطغت في الفضاء آهاتنا الحي","رى تغني رجاءنا المصروعا",21,"ع",2,0],["وطغى به السَمَكُ الطموحُ لحربهِ","فغدا يرينا الجهد في عصيانِهِ",22,"ن",2,0],["وطغت نوائبها عليّ فقَرصها","جرحٌ ومختصراتها إسرافُ",23,"ف",1,0],["وطغتْ بأنجاد النعاسِ أزِمَّةٌ","فخلعن طاعةَ راحةٍ أو إصْبعِ",24,"ع",1,0],["وطغى المُلوكُ وباتَ من إِشْفاقه","خَشْيانَ يُخْبِتُ للقديم الأول",25,"ل",1,0],["وطغى جاحمُ الغليل فما ينقعِ ب","ردُ الزُّلال حرَّ الهُيامِ",26,"م",1,0],["وَطَغَت لِعَجزِ الماءِ عَن إِطفائِها","حَتّى ظَنَنتُ الكَأسَ جَذوَةَ مُصطَلي",27,"ل",2,0],["وَطَغى وَمَدَّ لَهُ الرَجيمُ بِشركِهِ","شرَكاً فعاد بِعَكسِهِ مَطرودا",28,"د",2,0],["وطغت عليها الحادثات فلو أتى","لنجاتها نوح لأخفق نوح",29,"ح",1,0],["وطغى حولَها مغيرٌ جديدٌ","وبغى بينها مغيرٌ قديم",30,"م",1,0],["وطغى بحد السيف من","سئمت فظاظته الفتوحُ",31,"ح",1,0],["وطغت عليها وحشة من بيتها","فكأنه بعد العشي تبدلا",32,"ل",2,0],["وَطَغى الفَناءُ عَلى الشَبا","بِ فَغالَهُ قَبلَ الفَناء",33,"ا",2,0],["وطغى عثير الضوا مر","حتى خيل أن الأرض التقت لسماها",34,"ا",3,0],["وطغى شرُّها فغشَّى البرايا","وهو باقٍ يشتدُّ في الطغيان",35,"ن",1,0],["وطغت أكداره حتى غدا","ظلمةً ليس بها خيط ضياء",36,"ا",2,0],["وطغى الوادي نحيبا وهمى","غيث دمع أزعج الأفلاك رعدا",37,"د",2,0],["وطغت موجة من الطمع الفتاك","أودت بنعمة الضعفاء",38,"ا",2,0],["وطغى عليه الحب وهو أميره","فأطاع جامح قلبه وانقادا",39,"د",2,0],["وطغى الوغى فعلاً لوقع سيوفهم","صوت يهول منها يصرَّع جيل",40,"ل",1,0],["وطغت على الدنيا خلائق حبله","فحوت اعنتها يمين المجرم",41,"م",1,0],["وَطَغى حُضورُكَ بالشَّفيفِ فَشَفَّها","فَبَدَتْ لِعينِكَ واستَحَمَّتْ بالسَّنا",42,"ن",2,0],["وطغى عُبابُ سخائهِ في النّا","سِ فاغتَرَفَتْ يسارٌ عَذْبَهُ ويمينُ",43,"ن",1,0],["وَطَغَوْا عَلَىْ شَعْبِ الْعِرَاْقِ بِأَرْضِهِ","وَبَغَوْا عَلَىْ آشُوْرَ º وَالنَّمْرُوْدِ",44,"د",1,0],["وَطَغَتْ عَلَى الْقَوْمِ الَجِيَاْعِ","الصَّاْبِرِيْنَ إِلَىْ أَجَلْ",45,"ل",1,0],["وَطَغَىْ عَلَىْ أَبْنَاْئِهَاْ أَعْدَاْؤُهَاْ","وَعُجُوْلُهُمْ  بِالْقَتْلِ  وَالأَبْقَاْرُ",46,"ر",1,0],["وَطَغَىْ عَلَى \"الْجَوْلاْنِ\" جَيْشُ عَدُوِّنَاْ","وَتَزَيَّفَتْ بِبِلاْدِنَا الأَشْيَاْءُ",47,"ا",2,0],["وَ طَغَى الهولُ فالدِّماءُ سَوَاقٍ","وَ قصورٌ تُحِيْطُهَا الأَشْلاءُ",48,"ا",2,0],["وطغى بنو حمّالةِ ال","حطبِ الّذين تناسلوا",49,"ل",3,0],["وطغت على أحلامه فتغيرت","سبحان من ملك العباد وروضها",50,"ه",2,0],["٥- وطغت على تلك النفوس مطامع","حتى تولي الخير والعمران",51,"ن",1,0],["وطغت على قدري تضللني فإن","راسلتُ أحلامي تموت رسائلي",52,"ل",2,0],["وطغى لأحمد وهج نور سابغٍ","لا النجم فيه باديا من فرقد",53,"د",1,0],["وطغت على أحلامه","لحجٌ من اليأس المحيق",54,"ق",1,0],["وطغاة الشر من جسّاسهم","غرزوا في ظهرنا رمحاً طويلا",55,"ل",2,0],["وطغت بنات سجيتي","وسرى الخيال وباعدا",56,"د",2,0],["وطغت على الاوطان مسحا بالورى","جز الرقاب وكل شيء قد هلك",57,"ك",1,0],["وطغى بحري وسرى فُلْكي","ومخرتُ عبابك في تحنانْ",58,"ن",1,0],["وَ طَغَى الولاةُ فَمَا اسْتَقَرَّ بَلاطُهُمْ","حَتَّى اسْتَبَدَّ الظُّلْمُ في حَجَّاجِها",59,"ج",3,0],["وطغى العطرُ , فالرياضُ سرتْ في الْ","ماءِ , يرعى وُرودَها التشتيتُ",60,"ت",1,0],["وطغى في البلاد ظلمٌ وفسقٌ","وعلا كلَّ سيدٍ قوادُ",61,"د",1,0]]}