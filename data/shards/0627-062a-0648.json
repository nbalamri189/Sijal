4,"أتوب إليك من نقض العهود","https://www.aldiwan.net/poem67755.html","الوافر"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[517,"اتوني واهلي في قرار ديارهم","https://www.aldiwan.net/poem48599.html","الطويل"],[538,"أتوب إِلى الله الرحيم فإنه","https://www.aldiwan.net/poem69410.html","الطويل"],[539,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[552,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[563,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[563,"سرى جنح ليل والعيون هواجع","https://www.aldiwan.net/poem52871.html","الطويل"],[563,"تقول لقلبي ربة الأعين النجل","https://www.aldiwan.net/poem52902.html","الطويل"],[563,"لهذا الفرق دان الفرقدان","https://www.aldiwan.net/poem52922.html","الوافر"],[568,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[570,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["أَتوعِدُني بِالقارِعاتِ بَجيلَةٌ","لَقَد ذَلَّ مَن عَرَّضتُمُ لِلمَتالِفِ",0,"ف",1,0],["أَتَوَخّى بَردَ القُلوبِ مِنَ الوَج","دِ وَقَلبي يَزدادُ بِالوَجدِ حَرّا",1,"ر",2,0],["أَتوا بِمَخالِبِ الآسادِ سُلَّت","بَراثِنُها وَأَشلاءِ الجُلودِ",2,"د",1,1],["أَتوبُ مِن سُخطِها خَوفاً إِذا سَخِطَت","فَإِن سَخِطتُ تَمادَت ثُمَّ لَم تَتُبِ",3,"ب",1,0],["أَتَوْا دَوْحَةَ التَّحْقِيقِ تَدْنُو قُطُوفُهَا","فَحَازُوا جَنَاهَا وَهْيَ مَعْرِفَةُ الَّربِّ",4,"ب",1,0],["أَتوعِدُني أَن جاشَ بَحرُ اِبنِ عَمِّكُم","وَبَحرُكَ ساجٍ لا يُواري الدَعامِصا",5,"ص",2,0],["أَتودَعُ فيكَ كُنوزُ العُلومِ","وَيَمشي لَكَ الغَربُ مُستَرفِدا",6,"د",2,0],["أَتَوا أَهلَهُم بِالمُعجِزاتِ تَفَنُّناً","فَيا لَيتَكُم تَأتونَ بِالكَلِماتِ",7,"ت",1,0],["أَتَوا خالِصينَ لِوَجهِ الأَميرِ","فَلا عَن رِياءٍ وَلا عَن رَهَب",8,"ب",1,0],["أَتوكَ كَآسادِ الثَرى فَرَدَدتَهُم","كَما أَجفَلَت وَسطَ الفَلاةِ نَعامُ",9,"م",1,0],["أتوديعاً لصاحبكم","بإحسانٍ وإجمال",10,"ل",1,0],["أَتُوَافِقُ الأَيَّامُ فِي إِدْبَارِهَا","وَتخَالِفُ الأَيَّامَ فِي إِقْبَالِهَا",11,"ل",3,0],["أَتُوقِرْهُ السَّنُونَ فَلَنْ أَرَاهُ","طَلِيقاً مَارِحاً مَرَحَ الْجُنُونِ",12,"ن",1,0],["أَتَوْني بنوَّار يروق نَضَارةً","كخدّ الذي أهوى وطيب تنفُّسِهْ",13,"س",2,1],["أ تونس أن في بغداد قوماً","تَرِفّ قلوبهم لكِ بالوِداد",14,"د",1,1],["أ تونس أن مجدك ذو انتماء","إلى عُليا نِزار أو إياد",14,"د",1,0],["أَتَوعِدُني وَراءَ بَني رِياحٍ","كَذَبتَ لِتَقصُرَنَّ يَداكَ دوني",15,"ن",2,0],["أَتوعِدُنا وَتَمنَعُ ما أَرَدنا","وَنَأخُذُ مِن وَرائِكَ ما نُريدُ",16,"د",1,0],["أَتَونا بِشَهرانَ العَريضَةِ كُلِّها","وَأَكلُبِها ميلادَ بَكرِ بنِ وائِلِ",17,"ل",1,1],["أَتَونَا عِندَ نِسوَتِنَا فَلاَقَوا","ظَعَائنَ ما هرَبنَ ولاَ سُبِينَا",18,"ن",2,0],["أتَونَا بالظَّعَائِنِ وَاقِفَات","فَأيُّ ذَوِي ظَعائِنَ إذ أُتِينَا",18,"ن",2,0],["أَتَوهُم يَحسبُونَهُمُ جَنَاةً","فأَقلص أيدياً ما يَجتَنينَا",18,"ن",2,0],["أَتوعِدُنا بِالحَربِ حَتّى كَأَنَّنا","وَإِيّاكَ لَم يُعصَب بِها قَلبُنا عَصبا",19,"ب",2,0],["أتوقنُ بالمقدور قبل وقوعِه","وتنفِر نفرَ الغِرِّ ذي الغفلاتِ",20,"ت",1,0],["أتوقِعُ بامرئٍ لم يمس يرجو","سواك على البلية من ظهير",21,"ر",1,0],["أتود أنك تجتني ثمر العلا","عفواً وأنك في طباع الجوهري",22,"ر",2,1],["أَتَوها بِرِبحٍ حاوَلَتهُ فَأًصبَحَت","تُكَفَّتُ قَد حَلَّت وَساغَ شَرابُها",23,"ب",3,0],["أَتوعِدُني الوِبارُ بَنو سُلَيمٍ","وَما تَحمي الوِبارُ وَلا تَصيدُ",24,"د",1,0],["أَتَوا مَلِكاً فَوقَ السِماكِ مَحَلُّهُ","فَمِن جودِهِ ذاكَ السَحابُ الَّذي يَسري",25,"ر",2,0],["أتوا بوشايات عظيم إثامها","فكادت بها تغتال نفسيَ آفات",26,"ت",1,0],["أَتوكَ يَجُرّونَ الحَديدَ كَأَنَّهُم","سَرَوا بِجِيادٍ ما لَهُنَّ قَوائِمُ",27,"م",1,0],["أَتوبُ مِنَ الإِساءَةِ إِن أَلَمَّت","وَأَعرِفُ مَن يُسيءُ وَلا يَتوبُ",28,"ب",1,0],["أَتوني بِلا وَعدٍ وَإِن لَم تَجِد لَهُم","بِراحِهُمُ راحوا جَميعاً عَلى وَعدِ",29,"د",1,0],["أَتوبُ إِلَيكِ مِن بَينٍ","سِوى هَذا وَمِن بُعُدِ",30,"د",1,0],["أَتوبُ إِلَيكَ مِن ثِقَةٍ بِخِلٍّ","طَريفٍ بِالأُخُوَّةِ أَو تَليدِ",31,"د",1,0],["أَتوَيتَ لُبّي وَمِن شَأنِ المُحِبِّ إِذا","ما قيدَ لِلشَيءِ يُتوي لُبَّهُ اِنقادا",32,"د",2,0],["أَتَوكَ يُزجيهُمُ لِلحَينِ جاهِلِهُم","مُستَقدِماً بِهِمُ لِلبَغيِ مُزدَلِفا",33,"ف",2,0],["أَتَوكَ وُفودَ الشُكرِ يُثنونَ بِالَّذي","تَقَدَّمَ مِن نُعماكَ عِندَهُمُ قَبلُ",34,"ل",1,0],["أَتَوانَيتَ أَم تَشاغَلتَ عَنها","أَم تَعَلَّمتَ مَطلَ إِسماعيلِ",35,"ل",1,0],["أَتَوَخّى سَترَ حُبٍّ لَم يَزَل","ظاهِرَ الوَجدِ بِهِ حَتّى عَلَن",36,"ن",1,0],["أَتوهُ وَلَم يُرسِل إِلَيهِم وَما أَلوا","عَنِ الأَمنَعِ الأَوفى الجِوارَ المُهَذَّبِ",37,"ب",1,0],["أَتَونا بِالقُدورِ مُعَدِّليها","وَصارَ الجُدُّ لِلجَدِّ السَعيدِ",38,"د",1,0],["أَتوعِدُني قَيسٌ وَدونَ وَعيدِها","ثَراءُ تَميمٌ وَالعَوادي مِنَ الأُسدِ",39,"د",1,1],["أَتَوَقّى الأَعداءَ إِن رُمتُ ذِكرا","كَ فَأَكني عَنِ اِسمِكَ المَرموزِ",40,"ز",1,0],["أَتَوا بِأَساطيلٍ تَمُرُّ كَأَنَّها","جَرادٌ مُظِلٌّ ضاق عن عرضه البَحرُ",41,"ر",1,0],["أَتَوكِ مُسلِّمينَ فما شجاهم","سوى خَبَبِ العِداةِ مُودّعينا",42,"ن",2,0],["أتَوْا أزميرَ يَسْتَعلُونَ عِزَّاً","ويستبقونها مُتخايلينا",42,"ن",2,0],["أتوا غَرِقينَ في صَلَفٍ وكِبرٍ","وعادوا بالهوانِ مُخيَّبينا",42,"ن",2,0],["أَتَوا مُتفائِلينَ لهم ضَجيجٌ","فَردَّ جموعَهم مُتطيِّرينا",42,"ن",2,0],["أَتوا لُوزانَ يلتمسون فيها","دُعاةَ الحقِّ في المتآمِرينا",42,"ن",2,0],["أَتُؤمِنونَ بِرَبٍّ لا شَريكَ لَهُ","أَم تُؤمِنونَ بِأَصنامٍ وَأَوثانِ",43,"ن",1,0],["أَتَوكَ وَعاقَني حِدثانُ دَهرٍ","يُصَرِّفُ لا كَما أَرضى عِناني",44,"ن",2,0],["أَتوا مِصرَ ضَيفاناً أَطلنا قِراهمو","وَإِكرامهم وَالحرُّ للضّيفِ يُكرِمُ",45,"م",1,0],["أتوا دارَ أمضَى النّاسِ رأياً وهِمّةً","لنائبةٍ تُعتادُ أو حادثٍ يَعْرُو",46,"ر",2,0],["أتوكِ مُكبّرينَ فلا تلوذي","بغير الذُّعرِ واضطربي اضطرابا",47,"ب",2,0],["أتُؤذونَ عبدَ اللّهِ أن يتبعَ الهُدى","فيا ويحَهُ من مؤمنٍ ما يُقارِفُ",48,"ف",1,0],["أَتوا ناري فَقُلتُ مَنونَ أَنتُم","فَقالوا الجِنَّ قُلتُ عِموا ظَلاما",49,"م",2,0],["أَتَوْا بِشَفِيعٍ لا يُرَدُّ وَلَمْ يَكُنْ","بِخَلْقٍ سوَاهُ ذلك الهَوْلُ يَرْتَدُّ",50,"د",1,0],["أتَوْا بِطِمرَّاتٍ مِنَ الجُرْدِ سُيِّرَتْ","وَرَجْلٍ لهُمْ مِثْلُ الجَرادِ طُمُورُ",51,"ر",1,0],["أتَوكَ فما خَرّوا إلى البِيض سُجّداً","ولكنّما كانَتْ تَخِرُّ الجماجم",52,"م",1,0],["أتَوكَ فلم يُرْدَدْ مُنيبٌ ولم يُبَح","حريمٌ ولم يُخمَش لغانيةٍ خَدُّ",53,"د",1,0],["أَتَوا بِها في الحِبابِ يَخفُرُها","مَشيٌ هُوَينى ما إِن بِهِ نَزَقُ",54,"ق",1,0],["أَتوبُ إِلَيكَ مِنَ السَيِّئات","وَأَستَغفِرُ اللَهَ مِن فَعَلتي",55,"ت",2,1],["أَتوفي بِالَّذي قالَت","كَما قُلتُ فَأَوفَيتُ",56,"ت",1,0],["أَتوعِدُ عَبداً لَم يَخُنكَ أَمانَةً","وَتَترُكُ عَبداً ظالِماً وَهوَ ظالِعُ",57,"ع",1,0],["أَتوهِمُني بِالمَكرِ أَنَّكَ نافِعي","وَما أَنتَ إِلّا في حِبالِكَ جاذِبُ",58,"ب",1,0],["أَتَوكَ بِأَصنافِ المَحالِ وَإِنَّما","لَهُم غَرَضٌ في أَن يُقالَ عَلومُ",59,"م",1,0],["أَتوهمُ بِأَحاديثٍ وَقيلَ لَهُم","قولوا صَدَقنا وَإِلّا أَروِيَ الخِذِمُ",60,"م",1,0],["أَتَوكُم بِإِقبالِهِم وَالحُسامِ","فَشَدَّ بِهِ زاعِمٌ ما زَعَم",61,"م",1,0],["أَتوعِدُ أُسرَتي وَتَرَكتَ حُجراً","يُريغُ سَوادَ عَينَيهِ الغُرابُ",62,"ب",1,1],["أتوا يدفعون الشر عني بمثله","ولم يظهروا في كل ما أَظهروا جبنا",63,"ن",2,0],["أتوا بشناعات فعيبوا فَحاولوا","عدولاً فَجاؤا بِالَّذي هو أَشنع",64,"ع",1,0],["أتوا من السواد والصعيد","شقاوة للبلد السعيد",65,"د",1,0],["أَتوبُ إِلَيكَ يا رَحمَنُ مِمّا","عَمِلتُ فَقَد تَظاهَرَتِ الذُنوبُ",66,"ب",1,0],["أَتَونا في الظَلامِ عَلى جِيادٍ","مُضَمَّرَةِ الخَواصِرِ كَالسَعالي",67,"ل",2,0],["آتُوا زَكَاتَكُمُ فَفِي","هَا البِرُّ مَزْدَوِجُ الثَّوَابِ",68,"ب",1,0],["أَتُونا لا يرونَ لَهُمْ كِفَاءً","فجدَّعْنَا المَسَامِعَ والأُنُوفَا",69,"ف",2,0],["أتوانى عند حصد السنبل","مؤثر لو كنت مسماراً ولا",70,"ل",2,0],["أتَوْكِ مُناجزين أسودَ غابٍ","وشالوا بعد نكبتهم نَعاما",71,"م",2,0],["أتوب إليك من السيآ","ت وأستغفر الله من فعلتي",72,"ت",2,1],["أتَوه بتاؤيلاتِهم يُفسدونه","قوانينَ باسم العدل تَنهى وتأمُر",73,"ر",1,0],["أتُوبُ إلَيْكَ مِنْ ثِقَةٍ بخِلٍّ،","طَرِيفٍ في الأُخُوّةِ، أوْ 