,"ر",2,0],["أتَوْها فسالَتْ مياهُ الحديدِ","إلى أنْ أشَرْتَ فعادتْ أُجونا",101,"ن",2,0],["أَتوا فِرَقاً من كلِّ أشعثَ قد نَبا","به الجَنْبُ شَوقاً والمِهادُ وَثير",102,"ر",1,0],["أتَوكَ فأعَطْوكَ المَقادَ بأسرِهمْ","وعَفَّى على آثارِ ما أذْنبوا عُذْر",103,"ر",1,0],["أَتُوعِدُني كأنّكَ ذو رُعَينٍ","بأفضلِ عيشةٍ أو ذو نُوَاسِ",104,"س",1,1],["أتوب ولكن لا ثبات لتوبةٍ","بعمرٍ به الأوزار كالماء بالخمر",105,"ر",1,0],["أَتَوا أرضاً وعاثوا في سَماها","فكان فَسادُهم عَرضَ السماءِ",106,"ا",2,0],["أَتوبُ مِنها مُخلِصاً","إِلى الَّذي عَزَّ وَجَل",107,"ل",1,0],["أتوني فلم أرضَ ما بيّتوا","وكانوا أتَوني بشيء نُكر",108,"ر",1,1],["أتوافق الأيام في إدبارها","وتخالف الأيام في غقابلها",109,"ل",3,0],["أتوا من كل أرض لم يريدوا","سوى البيت المحرم والمقام",110,"م",1,0],["أتوب ولكن أنقض العزم بعدها","وأندم في نقضي وأطمع في أخرى",111,"ا",1,0],["أتَوكَ بتزوير على حين غفلة","وأَنْتََ عن التزوير إذ ذاك غافل",112,"ل",1,0],["أَتُوبُ من الذنبِ الذي سُؤْتَنِي له","وإِن كنتُ منه لم أَزَلْ مُتَحَرِّجا",113,"ج",2,0],["أتوا إلى القدس باسم الله فانتصرو","ولو أتوا باسم قحطان لما غلبوا",114,"ب",3,0],["أتوسوسين لنا بسرٍّ قد خبأتِ مدى الشتاء","هذى البراعم إذ تُفتَّحُ لا يُخالطها الرياء",115,"ا",2,1],["أتوسَع قدّامي وحاش قياسكم","خُطَى قدَمٍ لو قد حذت ما حذت نعلي",116,"ل",2,0],["أتوا بك مُلفى آملٍ يبتغي الغنى","وعِصْمَةَ مذْعورٍ ومنشطَ عانِ",117,"ن",1,0],["أتوعدني وأنت ببطن نجد","فلا نجدا أخاف ولا تِهاما",118,"م",2,0],["أتوك وراموا أن يهزك بغيهم","على شرفي والبغي مر مصائره",119,"ر",2,0],["أتوا والجهل قد طمَّ البرايا","فماج بهم فجاج الأرض علما",120,"م",2,0],["أتوب إليك اليوم من كل توبةٍ","فقد هنت في عيني وكنت جليلا",121,"ل",2,0],["أتوب إليك من نقض العهود","لتؤمن مقلتي من السهود",122,"د",1,1],["أتَوهُ يمدّون الرِقابَ تطاوُلاً","فأضحوا ومنهم ذلك المدُّ للجَزرِ",123,"ر",1,0],["اتوني وَاِهلي في قَرار دِيارَهم","بِحَيثُ التَقى مُنفضى كُليه وَالحَزم",124,"م",1,1],["أتوبُ إِلى الله الرحيم فإنه","غفورٌ لذنبِ المرءِ ما لم يُعاودِ",125,"د",1,1],["أتوا كقِلاَصٍ في الفِجَاجِ تَواخَذت","يحثُّهمُ قلبٌ لهم صار حَادِيا",126,"ي",2,0],["أتوا جَمْعاً وقد وقفوا جميعاً","على عَرَفات يا سُقِيَتْ مُقامَهْ",127,"م",2,0],["أَتَوْه مثرِيَّةً ذنباً أكفُّهُمْ","وفارقوه بأَيْمانٍ مفاليسِ",128,"س",1,0],["أَتوهُ أسارى الموبقاتِ وودّعوا","وَما فيهمُ إلّا الطّليقُ المحرّرُ",129,"ر",1,0],["أتُوقُ إلى تِلكَ الدِّيارِ كأنَّني","غريبٌ عليهِ طالَ في الدَّهرِ تَرْحالُ",130,"ل",1,0],["أتُوقُ إلى تلك الدِّيارِ ومَن بِها","وهيهاتِ مالي في اللقاءِ مَطامِعُ",131,"ع",1,0],["أتُوقُ إلى تلكَ الديارِ وأهلِها","جميعاً كما تاقَ الغَرِيبُ إلى الأهلِ",132,"ل",1,0],["أَتوقُ على السَّماعِ إلى حِماها","كما اشتاقَ المُحبُّ على العِيانِ",133,"ن",1,0],["أَتَوَخَّى رِضَاهُ جُهْدِي فَإِمَّا","مَسَّهُ الضُّرُّ مَسَّهُ إِرْفَاقِي",134,"ق",2,0],["أَتوعدني وانت بذات عرق","وقد غصت تهامة بالرجال",135,"ل",1,0],["أَتَوْكَ فضيَّفْتَهم بالغِنَى","وعَادُوا فزَوَّدتَهم بالأَرَبْ",136,"ب",1,0]]}