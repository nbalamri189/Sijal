541,"","https://poetry.dctabudhabi.ae/diwan/poem/76748","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35116","الطويل"],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4727,"لعل الدّهر مدّخر ثوابا","https://www.poetsgate.com/ViewPoem.aspx?id=208810",""],[4759,"وددت هدأتها","https://www.poetsgate.com/ViewPoem.aspx?id=204068",""],[4759,"قفا نسأل الدار","https://www.poetsgate.com/ViewPoem.aspx?id=204178",""],[4859,"فرقة!","https://www.poetsgate.com/ViewPoem.aspx?id=204309",""],[4884,"هي الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=202365",""],[5088,"إذا غناني القرشي يوما","https://www.poetsgate.com/ViewPoem.aspx?id=178176",""],[5092,"نعمْ هي لي","https://www.poetsgate.com/ViewPoem.aspx?id=139680",""],[5277,"رثاءُ مَن لا بواكي لها","https://www.poetsgate.com/ViewPoem.aspx?id=192868",""],[404,"لسْتُ براحلِ","https://www.poetsgate.com/ViewPoem.aspx?id=195049",""],[5363,"وددْتُ موتاً","https://www.poetsgate.com/ViewPoem.aspx?id=144293",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5409,"أمحتضن الوادي حضانة مرضعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155273",""],[5419,"عذراً رسولَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=32217",""],[5431,"فديتك...","https://www.poetsgate.com/ViewPoem.aspx?id=196955",""],[5431,"نقيٌ كلون القلب عنه تكلّما","https://www.poetsgate.com/ViewPoem.aspx?id=198598",""],[5431,"لقد آنس الأرواح حزنٌ مقعرُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198970",""],[5431,"وما كلّ وجه بالبشاشة صادق","https://www.poetsgate.com/ViewPoem.aspx?id=211697",""],[5431,"مسدس....","https://www.poetsgate.com/ViewPoem.aspx?id=213714",""],[5516,"على ضفة النهر","https://www.poetsgate.com/ViewPoem.aspx?id=212479",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5781,"وخزةٌ في قلبٍ مكشوفٍ للوجع","https://www.poetsgate.com/ViewPoem.aspx?id=185317",""],[5781,"وخْزَةٌ في قلبٍ مكشوفٍ للوجع","https://www.poetsgate.com/ViewPoem.aspx?id=202853",""],[5809,"وددت","https://www.poetsgate.com/ViewPoem.aspx?id=205563",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[5818,"وسائلةٍ ألِلعشّاقِ طِبّ","https://www.poetsgate.com/ViewPoem.aspx?id=193176",""],[5838,"لست أرضى بتيه","https://www.poetsgate.com/ViewPoem.aspx?id=200855",""],[5929,"لا تحسبي الحب لهوا","https://www.poetsgate.com/ViewPoem.aspx?id=196922",""],[5957,"سورة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=213916",""],[6031,"خَليلَيَّ حَالَ البعدُ دونَ لقاكما","https://www.poetsgate.com/ViewPoem.aspx?id=46262",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6097,"بانت سُعادُ","https://www.poetsgate.com/ViewPoem.aspx?id=190698",""],[6137,"ابعد من الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=174328",""],[1583,"قبلتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73064&r=&rc=21",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["وَدَدتُ بِأَنَّ ما تَخبى المَواضي","بَدالٌ لي بِما جَنَتِ المَواسي",0,"س",2,0],["وَدِدتُ مِنَ الشَوقِ الَّذي بِيَ أَنَّني","أُعارُ جَناحَي طائِرٍ فَأَطيرُ",1,"ر",1,1],["وَدِدتُ وَبَيتِ اللَهِ أَني عَصَيتُهُم","وَحُمِلتُ في رَضوانِها كُلُّ مَوبِقِ",2,"ق",1,0],["وَدِدتُ لَو طَرَحوا بي يَومَ جِئتُهُمُ","في مَسبَحِ الحوتِ أَو في مَسرَحِ العَطَبِ",3,"ب",1,0],["وَدِدتُ لَو كُلُّ ذي غُرورٍ","أَمسى لِنَعلَيهِما شِراكا",4,"ك",2,0],["وَدِدتُ وَما تُغني الوِدادَةُ أَنَّني","بِما في ضَميرِ الحاجِبِبَّةِ عالِمُ",5,"م",1,1],["وَدَدتُ وَبَيتِ الله أَنَّكِ بَكرَةٌ","هِجانٌ وَأَني مُصعَبٌ ثُمَّ نَهرُبُ",6,"ب",1,0],["وَدِدتُ وَبَيتِ اللَهِ لَو أَنَّ أَنفَهُ","هَواءٌ فَما مَتَّ المُخاطَ عَنِ العَظمِ",7,"م",1,1],["وَدِدتُ إِذ ذاكَ بِأَنَّ الوَرى","فيكَ مَدى الأَيّامِ لُوّامُ",8,"م",1,0],["وددت لو تمَّ لي حجِّي بقربهما","ما كل ما تشتهيه النفس يتفق",9,"ق",1,0],["وَدِدتُ الإِفاضَةَ قَبلَ اللِقاءِ","فَلَمّا لَقيتُكِ لَم أَنبَسِ",10,"س",1,0],["وَدِدتُ لَو أَنِّيَ إِيّاهُ","بَل خِلتُ كَأَنِّيَ إِيّاهُ",11,"ه",1,0],["وَدَدتُ لَو أَنَّها تَمَّت فَيُبصِرُها","غَيري وَتُسكِرُهُ مِثلي مَعانيها",12,"ي",3,0],["وَدَدتُ بِأَنّي فُزتُ مِنكَ بِنَظرَةٍ","تَبُلُّ غَليلاً في الحَشا وَالحَيازِمِ",13,"م",1,0],["وَدِدتُ بِأَنّي ما رَأَيتُ وُجوهَكُم","وَأَنَّ طَريقاً جِئتُكُم مِنهُ مَسدودُ",14,"د",1,0],["وَدِدتُ وَلا تُغني الوِدادَةُ أَنَّها","نَصيبي مِنَ الدُنيا وَإِنّي نَصيبُها",15,"ب",3,0],["وَدِدتُ عَلى حُبِّ الحَياةِ لَوَ اَنَّها","يُزادُ لَها في عُمرِها مِن حَياتِيا",16,"ي",2,0],["وددت لو اني كنت يوم رحيله","اسير على الضعف الذي بي مع الركب",17,"ب",1,0],["وددت لو اني اسطعت ان اخفي الهوى","ولكنما اخفاؤه ليس بالهين",18,"ن",1,0],["وددت لو ظهرت لي","من الحياة الخفايا",19,"ا",3,0],["وددت من كل قلبي غير مختشع","لو عاد يوما على اعقابه الازل",20,"ل",1,0],["وددت لو أني كنت في مصر محشوراً","فشاهدت يوماً للعروبة مذكورا",21,"ر",2,1],["وددت لو أني قبل منعاك ميت","ولم أتل شيئاً من نعيِّك في الكتب",22,"ب",1,0],["وَدِدتُ لَو أَنّي فِداكَ مِنَ الرَدى","وَالكاذِبونَ المُرجِفونَ فِدائي",23,"ا",2,0],["وَدِدنا لَو مَشَيتَ بِنا الهُوَينا","وَأَينَ الخُلودُ لَدَيكَ أَينا",24,"ن",2,0],["وَدِدتُ وَهَل نَفسُ اِمرِئٍ بِمَلومَةٍ","إِذا هِيَ لَم تُعطَ المُنى في وِدادِها",25,"د",3,0],["وَدِدتُ لَوَ انَّ الطَيفَ مِن أُمِّ مالِكٍ","عَلى قُربِ عَهدَينا أَلَمَّ فَسَلَّما",26,"م",2,0],["وَدِدتُ بِحِنّاباءَ إِذ أَنتَ موكِفٌ","حِمارَكَ مَحلوقٌ تَسوقُ بِعَفزَرا",27,"ر",2,0],["وددت ألقي بها لمائك","لعلها فيك تبردُ",28,"د",1,0],["وددت بأن أطيل لك القوافي","فيمنعني حياؤك أن أطيلا",29,"ل",2,0],["وددتُ يا نورَ عيني لو وَقَى بَصَري","جَنادِلاً وتُراباً لاصِقا بشَرَك",30,"ك",1,0],["ودِدتُ ذاك الشِراعَ الرخص لو كفني","يُحاكُ منه غَداةَ البَين يَطويني",31,"ن",2,0],["وَدِدنا وَنُعطى ما يَجودُ لَوَ أَنَّهُ","لَنا رائِمٌ حَتّى يَأوبَ المُنَخَّلُ",32,"ل",1,0],["وَدِدتُ لَو أَنَّكَ في","قَولِكَ هَذا تُنصِفُ",33,"ف",1,0],["وَدَدنا لِلنَواعِبِ لَو عَمينا","وَسُدَّت مِن مَسامِعِنا الخُروقُ",34,"ق",1,0],["وَدَدتُ أَنَّ اِعتِدالَ قَدِّه","يَشفي بِهِ مَن عَلى رَمَق",35,"ق",1,0],["وَدِدتُ لجِيلٍ قد تقَدَّمَ عصرُهم","لوِ استأخروا في حَلبة العُمرِ أو كروا",36,"ر",3,0],["وَدِدتُ أَنَّ إِلهي كانَ غادَرَني","وَمُدَّتي في يَدَيها أَقصَرُ المُدَدِ",37,"د",1,0],["وَدِدتُ بِأَنّي في عِمايَةَ فارِدٌ","تُعاشِرُني الأَروى فَأَكرَهُ قُمرَها",38,"ر",3,0],["وَدِدتُ أَنِّيَ مِثلُ السَيفِ لَيسَ لَهُ","حِسٌّ إِذا فُلَّ أَو رَثَّت لَهُ خِلَلُ",39,"ل",1,0],["وَدِدتُ وَفاتِيَ في مَهمَهٍ","بِهِ لامِعٌ لَيسَ بِالمَعلَمِ",40,"م",1,1],["وَدَدتُ بِعِلمِ اللَهِ أَنَّ صَحابَتي","عَلى كُلِّ حالٍ أَفرَدوني فَما ثَنّوا",41,"ن",3,0],["وَددت لَو اَنِّي اليَوم مثلك ميت","فَلَم ترَ عيني من يضير يضير",42,"ر",1,0],["وَددت لَو اَنَّ الموت يبطئُ ساعةً","لعليَ من مرأى محياك أَشبع",43,"ع",1,0],["وددت لَو اَنَّ الحب يَقسم منصفاً","فَيسلبني عضواً وَيترك لي عضوا",44,"و",2,0],["وَدَدت لَو أني أَرا","ها بعيون أَربَع",45,"ع",1,0],["وَدِدتُ لو قلبي كهذي القفار","أصمُّ لا يسمع ما في الديار",46,"ر",1,0],["وددتُ لو عنديَ جهل الثرى","تَعمُر أو تُقفر هذي البيوت",46,"ت",1,0],["ودَدْتُ لو أنِّي في إثرِهِ","درجتُ على الأرض في الدارجينْ",47,"ن",1,0],["ودِدْتُ لو شِدْتُ بالأسماء شاديةً","بها ربوعٌ حبيباتٌ وأرجاءُ",48,"ا",2,0],["ودِدْتُ لو حطَّمت هذي القيودْ","وجئتُ ألقاكِ على العاصفهْ",49,"ه",1,0],["وَددتُ لَولا ثَوابُ رَبّي لَو","أَماتَني قَبلَهُ وَأَحياهُ",50,"ا",2,0],["ودِدْتُ بأن أَلْقى من الناس مُنصفاً","إذا قلتُ حقّاً قال لي أنت صادقُ",51,"ق",1,0],["وَدَدتُ لَو مُتُّ يَومَ قالوا","غُصنُكَ يا فَرعَ فَهرَ ذاوِ",52,"و",1,0],["وددت لوَ أني عدت للدرس ناشئًا","أسير، وفي يمناي: لوح، ومرقم",53,"م",1,0],["وَدِدْتُ، وَهَلْ نَفسُ امرِىءٍ بملومة","إذا هيَ لمْ تُعطِ المنَى مِنْ وَدادها",54,"د",3,0],["وَدِدْتُ بَيَاضَ السّيفِ يَوْمَ لَقَينَني","مَكانَ بَيَاضِ الشَّيبِ كَانَ بمَفْرِقِي",55,"ق",2,0],["ودد يباع له الوقار ولا ندامة والصواب","أغلى عليّ من النجوم ولا ألام ولا أعاب",56,"ب",1,0],["وَدِدْتُ وَمَا تُغْنِي الودَادَة ُ أَنَّني","بما في ضمير الحاجبيّة عالمُ",57,"م",1,1],["ودِدْتُ لم تمَّ لي حجّي بقربهما","ما كلٌّ ما تشتهيه النفسُ يتفقُ",58,"ق",1,0],["وددتُ ، على حبِّ الحياة ِ، لو أنها","يزاد لها، في عمرها ، من حياتنا",59,"ن",2,0],["وَدِدْنَا وَنُعْطى ما يَجُودُ، لَوَ انَّهُ","لنا رائمٌ، حتى يؤوبَ المنخل",60,"ل",1,0],["وَدَدتُ أَني في باب البَريد لِكَي","كُلٌّ يَمُرُّ فَأَحظى مِنهُ بِالنَظَر",61,"ر",1,0],["وددت لو لأن لي لفظٌ فأودعه","ما ضاق عن بعضه شرحي وتبييني",62,"ن",2,0],["وددت لو تنفع الأماني","لو كنت لدناً من الغصون",63,"ن",1,0],["ودِدتُ وإن كانت من العمر تنقضى","لو أن بواقيها تكون حَوالى",64,"ل",2,0],["ودِدتُ التصابى فيك إذ كان عاذرى","وعاديتُ حلمى إذ غدا عنك زاجرى",65,"ر",2,1],["وددت لو باتت معي ليلة","اوصا التي في الحلق أو صلت",66,"ت",1,0],["وددت بأطراف البنان لو أنني","بذي أروني ترومي ورائي الثعالب",67,"ب",1,0],["وَدِدتُ وَقَد جاوَرتُهُم أَنَّ مَنزِلي","بِحَيثُ ثَوَت غُبسُ الذِئابِ السَواغِبِ",68,"ب",1,0],["وَدِدتُ بِلا مَقتٍ مِنَ اللهِ أَنَّهَأ","نَصِيبِى مِنَ الدُّنيا وَأَنِّى نَصِيبُهَا",69,"ب",3,0],["ودِدتُ لو أنّكم تَدْرو","ن أشواقِي وبَلبالي",70,"ل",2,0],["ودِدْتُ ودادي منك في عين همّتي","وفي القلب والأحشاء والجِلْد والشَعْر",71,"ر",1,0],["وددت لو أنني أصبحت متبعاً","آثارها أرد الماء الذي ترد",72,"د",1,0],["وَدِدتُّ بِأَنَّكِ لَمّا هَتَفتِ","بِوَعدٍ وَلَم تُنجِزي ساكِتَه",73,"ت",2,0],["وَددنا لو أن السقمَ فينا جميعُهُ","وكانت معافاةً فذاكَ بهِ ترضى",74,"ض",2,0],["وَدِدتُ لَو كانَ مَسعى أَخمصَيهِ عَلى","خَدَّيّ صَوناً لِنَعلَيهِ وَتَرفيها",75,"ي",3,0],["وَدِدتُ بِأَن لَم يخلق اللَهُ لي وَقَد","نَعاهُ لِيَ الناعونَ عَيناً وَلا أُذنا",76,"ن",2,0],["وَدِدتُ بِأَنَّني أَستافُ تُربَ ال","غُوَيرِ وَأوسِعُ الحَصباءَ لَثما",77,"م",2,0],["وَدِدتُ بِأَنّي زُرتُ قَبرَكَ راجِلاً","وَقَبَّلتُ تُرباً أَنتَ فيها مُوَسَّدُ",78,"د",1,0],["وددتُ لو اني ميتٌ علَّ رحمةً","تخامرُ قلباً من (نهيلة) قاسيا",79,"ي",2,0],["وددت لو هاجه ندائي","وهزّه صوتي الجديد",80,"د",1,0],["وَدِدْتُ 