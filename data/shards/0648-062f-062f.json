وَدَدتُ وَجامِعِ الأَشباحِ أَنِّي","لَقيتُكَ قَبلَ لقيانِ الخَيالِ",106,"ل",1,0],["وَدَدَت لَما تَمشى في الجَزيرة لَو","يَتاح لي في حِماها الخُلد أَزمانا",107,"ن",2,0],["وددت واللَه اني لم أكن بشرا","من هول ما مر بي يا أحسن البشر",108,"ر",1,0],["وددتُ أناساً لم يراعوا الودادَ لي","وما سمتهم بالسوء حبةَ خردلِ",109,"ل",1,1],["وددت لما رمت قلبى لواحظُها","لو أنها بمواضى النبل ترميني",110,"ن",2,0],["وددتُ لو أني تزو","وَجْتُ وبيتي يعمرُ",111,"ر",1,1],["وددتُ أن الحمام لي وطنٌ","مُدَّة عمر الشتاءِ والصيف",112,"ف",1,0],["وددتُ من وَدَّ مولايَ الحسينَ كما","رفضتُ رافضَهُ جهلاً بما رفضا",113,"ض",2,0],["وَدِدْتُ نُجومَ اللَّيلِ مِن أَجلِ أَنّها","عَلى هامِها لِلعِزِّ تَبني قصورَها",114,"ر",3,0],["وَدِدناهُ بُغضاً بِالحَياةِ جبانةً","وَتَكرَهُهُ آجالُهم فَتَطولُ",115,"ل",1,0],["وَدِدتُ سَقامَ جِسمي في غَرامي","بِمَنْ شَمس الضّحى وَالبدرَ أزرَى",116,"ر",2,1],["وَدِدتُ اِجتِماعاً لَيلةً بِجانِبِه","لِعِلمي بِما قَد جاءَ في لَيلَةِ القدْرِ",117,"ر",1,0],["وددت عدوي يا مُنَى النفس أنه","به مثل ما بي من زوال ديارك",118,"ك",1,0],["وَدَدتُ لَوَ اَنَّكَ بَينَ اليَدَين","أَضُمُّكَ لِلصَّدرِ ضَمّاً عَسِرْ",119,"ر",1,0],["وَدَدنا أَنَّ أُمَّكَمُ غُرابٌ","فَكُنتُم شَرَّ طَيرٍ في الطُيورِ",120,"ر",1,0],["ودِدتُ على ما كان من سَرَفِ الهوى","وغَىّ الأمانى أَنَّ ما شئتُ يُفعَلُ",121,"ل",1,0],["ودّدت لما فضَّ لي ختمها","وجال طرفي في مغانيها",122,"ي",3,0],["وددت لو أنك","يا سمراء شيء في يدي",123,"د",2,0],["وددت لو أغفو إلى الموعد","ويغفل الوجد إلى مسهدي",124,"د",2,1],["وددتُ لو أمسِكُ هذا السنا","ولونَه المزدهيَ الزاهيا",125,"ي",2,0],["وَدِدْتُ لو كانَ شُرْبُ الرَّاح مُفْتَرضاً","على الوَرَى أَو مباحاً غيرَ مُفْترضِ",126,"ض",1,1],["وددت لو أن المدى تنفسا","حتى أراه بالغا أندلسا",127,"س",2,0],["ودِدْتُ وما تُغْني الوَدادة والمُنى","لو انّي أرى قلباً يُباعُ فيشترى",128,"ر",2,0],["وددت لو المناطد أعتليها","فتدنيني من الفلك الأغر",129,"ر",1,0],["وددت لو أن أمي من تميم","وأن أبي وعمي من فزاره",130,"ر",2,0],["وددت يومك لم يجرِ القضاءُ به","لو كانَ للوح أنْ يستوقفُ القلما",131,"م",2,0],["وددتُ أن تبقى وأن لك الردى","فداءاً بمن فوقَ البسيطة يذهبُ",132,"ب",1,0],["وددنا لو تنقَّط بالآلي","ولكن نقطت من مسك خالك",133,"ك",1,0],["وددنا لو تُنَقَّطُ باللآلي","ولكن نقطت من مسك خالك",134,"ك",1,0],["وددت لو أنها جاءت بتهنئة","من ساحة الشام من ليبيا من الهرم",135,"م",1,0],["وددت لو أنها كانت تليق بكم","بالاتحاد بمن في الشرق من أمم",135,"م",1,0],["وددت لو أنها بالنور قد كتبت","وددت لو أنها صيغت لكم بدمي",135,"م",2,0],["وددت لو أنها لكنها عجزت","عن التألق واستعصت على قلمي",135,"م",2,0],["وددت لو أن أذني مثل عيني","اك وأن عيني مثل قلبه",136,"ه",1,0],["وددت والحر في بيروت يكويني","ان لا أعيش لشهر غير كانون",137,"ن",1,1],["وددت اذ طاب تشبيبي برقتها","لو ان من غزل الالحاظ اغزالي",138,"ل",2,0],["وَدَدتُ لَو تَمَّ لي حَجّي فَفُزتُ بِهِ","ما كُلُّ ما تَشتَهيهِ النَفسُ يَتَفِّقُ",139,"ق",1,0],["وددتُ بأني ما علوت كما علوا","عليه وإني ما دنوتُ كما دنوا",140,"و",2,1],["وَدِدْتُ لخدِّي تحت نَعْليْه مَوْطِئاً","فيا ليْته يَرْضَى وَضعتُ له الجَفْنَا",141,"ن",2,0],["وددِتُ بأني كنتُ قرطاً مُعَلّقاً","عليك وعِقداً منكِ يُجلى به الفجرُ",142,"ر",1,0],["وَددنا إِذ شَكَوت السقم أَنا","بصحتنا نُعاوضُك السقاما",143,"م",2,0],["وَدَدت بأني لا أُفارق شخصه","وَلكنما الأَيام تَجري عَلى العكس",144,"س",1,1],["وَدَّدتُ وَبَيتِ اللَهِ في الحُبِّ أَنَّني","قَدَرتُ عَلى ما تَقدِرينَ مِنَ الصَبرِ",145,"ر",1,1],["وَدِدت القَوافي لَو أَتَتني طَوائِعاً","فَأَنظم ذاكَ الحُسنَ في الشعر سِمطَين",146,"ن",1,0],["وددت لو أنه نحو انثنى هيفا","كالبان معتدلاً لا بيِّن العرج",147,"ج",1,0],["وددت لوَانك تعطي خيالي","وتعرض صورته للنظر",148,"ر",1,0],["وددت بان خدي كان نعلاً","لو طيك هكذا في كل نادي",149,"د",2,0],["وددت لتلقاها سليماً من الردى","فكانت ولكن في نيوب الردى المردي",150,"د",2,0],["وددت لو اني بعت اسود ناظري","فدى مقلة من ذلك الماء زرقاء",151,"ا",2,0],["وددت إن ودك لا ينثني","يزور جثماني ولو مت",152,"ت",1,0],["وددت بأن احظى بقربك ساعة","لأعرف كيف الصبر وهو جميل",153,"ل",1,0],["وددت لو اني مثل جابون ثائراً","فأوقظ قوماً غافلين ونو",154,"و",1,0],["وددت لو أني مثل ابليس منظرا","ولو بؤت يوم الحشر باللعنة الكبرى",155,"ر",2,0],["وددت بلادي أن تسود بنفسها","لأكتب فيها خير ما أنا كاتبه",156,"ب",2,0],["وددتُ لَو انَّني قَلبي لابقى","بذيّاك المقام على الدَوامِ",157,"م",1,0],["وددت بِأَن يرضى فَإِن جاد بِالرِّضَا","تفكر فِي ذَنْب الْمُحب فيندم",158,"م",1,0],["وددتُ ولو أحيا بما قد وددْته","أتيتُ إلى قبر الرسول ولو حبوا",159,"و",2,0],["وَدَدتُ أَنَّ البِحارَ السَبعَ لي مَدَدٌ","وَأَنَّ جِسمي دُموعٌ كُلُّها هَمَلُ",160,"ل",1,0],["وددت بأن القلب شق بمديةٍ","وأدخلت فيه ثم أطبق في صدري",161,"ر",2,1],["وددت بأن ظهر الأرض بطن","وأن البطن منها صار ظهرا",162,"ر",2,1],["وددت لو أنني من قبل موسى","نقلت على رضى مني لقبري",163,"ر",2,0],["وَدِدتُ الجِبالَ الشُمُّ عن مَعقِلِ الحِمى","فللنابحِ الأَحياءُ والأَسَدِ القفرُ",164,"ر",1,0],["وَدِدتُ نَوَى دهري الخَوُونِ لأَنَّهُ","أقلُّ وفاءً من ذوات النقائبِ",165,"ب",1,0],["وددت بالقرب من خلٍ يجود به","أو نفحةٌ نشقت من طيبه الزاكي",166,"ك",2,0],["وَددتُ لَو اَنّي ذا حَبيب فَأَرتجي","لقاه وَيَبكي إِن بعدتُ حَبيبُ",167,"ب",1,1],["وددتُ وقد ضن البشير بصدقه","لوَ انَّ نذيرًا بالمساكين يعبرُ",168,"ر",1,0],["وددت لو اني لا أفارق أوْجَهُ","ولا أستوي في الأرض لو كنت قادرا",169,"ر",2,0],["وددت والدمع في عينيّ محتجزٌ","لو سال منه على خدىَّ غدران",170,"ن",1,0],["ودِدْتُ لوَ انَّ بني آدم","تعلموا حكمتك الباطنةْ",171,"ن",2,0],["وددت لوَ انَّ لي في كلْ","ل جُحْر ألف ثعبانِ",172,"ن",1,0],["وددت لو اني طائر فوق أيكة","فلا أشتكي ولا أتقي خطبا",173,"ب",2,0],["وددت لو أنني غضبا","بلحمك أقتل السغبا",174,"ب",2,0],["وددت لو أنني خصصت بما اس","اتبشعت منه وحزت متعه",175,"ع",2,0],["وددتُ لو ان جسمي قيد روحي","لكان من السفينة لي بديل",176,"ل",1,0],["وددت أن جاد لي بُقبلته","وكل جارحةٍ تكون فما",177,"م",2,0],["وددتُ لو أنّ لي في كل جارحةٍ","سمعاً لأسمع منه القَول والكلما",178,"م",2,0],["وددتُ وبيتِ اللهِ أني فديتُهُ","وعبد العزيز يومَ يضرب بالخمر",179,"ر",1,0],["وددتُ بأنني المدفون حيا","ولم يطرق مسامعي النحيب",180,"ب",1,0],["وددت وما تغني الودادة أنني","ملكت عنان الخيل ساعة عبروا",181,"ر",3,0],["وددت لو أَن مخزن","ابن أسعد فيه خمارة",182,"ر",2,0],["وددت اذ نظرت عيني اليك به","لو أ