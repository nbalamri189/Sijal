 ذات اللطف نحسبها فرضا","https://www.aldiwan.net/poem35196.html","الطويل"],[280,"جاء الحبيب فما أقبلت منه على","https://www.aldiwan.net/poem32297.html","البسيط"],[280,"بكت معنا العلياء إذ فقدت معنا","https://www.aldiwan.net/poem32322.html","الطويل"],[280,"خليلي بالحمى عرج وسل ما","https://www.aldiwan.net/poem32414.html","الوافر"],[280,"إليك المطايا أعنقت يا محمد","https://www.aldiwan.net/poem32811.html","الطويل"],[296,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[326,"أقبل على موكب الحيارى","https://www.aldiwan.net/poem54967.html","مخلع البسيط"],[362,"وقيت ما فيك أتقيه","https://www.aldiwan.net/poem60580.html","مخلع البسيط"],[362,"لما افتحت كتابي منشئا بيدي","https://www.aldiwan.net/poem60660.html","البسيط"],[364,"وددت أن لو تراجعنا بألسننا","https://www.aldiwan.net/poem16920.html","البسيط"],[364,"وددت لو ان القلب كان لساني","https://www.aldiwan.net/poem17123.html","الطويل"],[364,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[374,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[374,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[390,"وددت أني بكفه قلم","https://www.aldiwan.net/poem53004.html","المنسرح"],[399,"دعوت إلى السلوان غير سميع","https://www.aldiwan.net/poem46744.html","الطويل"],[400,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[400,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[400,"له الحمد حمدا لا يلم به الحصر","https://www.aldiwan.net/poem33919.html","الطويل"],[429,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[434,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[451,"وددت أهدي طويل العمر من أدبي","https://www.aldiwan.net/poem61568.html","البسيط"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[456,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[456,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[477,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[549,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[565,"أي أب رزيته","https://www.aldiwan.net/poem69562.html","مجزوء الرجز"],[573,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"]],"verses":[["وَدَدتُ بِأَنَّ ما تَخبى المَواضي","بَدالٌ لي بِما جَنَتِ المَواسي",0,"ي",1,0],["وَدِدتُ مِنَ الشَوقِ الَّذي بِيَ أَنَّني","أُعارُ جَناحَي طائِرٍ فَأَطيرُ",1,"ر",1,1],["وَدِدتُ وَبَيتِ اللَهِ أَني عَصَيتُهُم","وَحُمِلتُ في رَضوانِها كُلُّ مَوبِقِ",2,"ق",1,0],["وَدِدتُ لَو طَرَحوا بي يَومَ جِئتُهُمُ","في مَسبَحِ الحوتِ أَو في مَسرَحِ العَطَبِ",3,"ب",1,0],["وَدِدتُ لَو كُلُّ ذي غُرورٍ","أَمسى لِنَعلَيهِما شِراكا",4,"ك",2,0],["وَدِدتُ وَما تُغني الوِدادَةُ أَنَّني","بِما في ضَميرِ الحاجِبِبَّةِ عالِمُ",5,"م",1,1],["وَدَدتُ وَبَيتِ الله أَنَّكِ بَكرَةٌ","هِجانٌ وَأَني مُصعَبٌ ثُمَّ نَهرُبُ",6,"ب",1,0],["وَدِدتُ وَبَيتِ اللَهِ لَو أَنَّ أَنفَهُ","هَواءٌ فَما مَتَّ المُخاطَ عَنِ العَظمِ",7,"م",1,1],["وَدِدتُ إِذ ذاكَ بِأَنَّ الوَرى","فيكَ مَدى الأَيّامِ لُوّامُ",8,"م",1,0],["وددت لو تمَّ لي حجِّي بقربهما","ما كل ما تشتهيه النفس يتفق",9,"ق",1,0],["وَدِدتُ الإِفاضَةَ قَبلَ اللِقاءِ","فَلَمّا لَقيتُكِ لَم أَنبَسِ",10,"س",1,0],["وَدِدتُ لَو أَنِّيَ إِيّاهُ","بَل خِلتُ كَأَنِّيَ إِيّاهُ",11,"ه",1,0],["وَدَدتُ لَو أَنَّها تَمَّت فَيُبصِرُها","غَيري وَتُسكِرُهُ مِثلي مَعانيها",12,"ي",3,0],["وَدَدتُ بِأَنّي فُزتُ مِنكَ بِنَظرَةٍ","تَبُلُّ غَليلاً في الحَشا وَالحَيازِمِ",13,"م",1,0],["وَدِدتُ بِأَنّي ما رَأَيتُ وُجوهَكُم","وَأَنَّ طَريقاً جِئتُكُم مِنهُ مَسدودُ",14,"د",1,0],["وَدِدتُ وَلا تُغني الوِدادَةُ أَنَّها","نَصيبي مِنَ الدُنيا وَإِنّي نَصيبُها",15,"ب",3,0],["وَدِدتُ عَلى حُبِّ الحَياةِ لَوَ اَنَّها","يُزادُ لَها في عُمرِها مِن حَياتِيا",16,"ي",2,0],["وددت لو اني كنت يوم رحيله","اسير على الضعف الذي بي مع الركب",17,"ب",1,0],["وددت لو اني اسطعت ان اخفي الهوى","ولكنما اخفاؤه ليس بالهين",18,"ن",1,0],["وددت لو ظهرت لي","من الحياة الخفايا",19,"ا",3,0],["وددت من كل قلبي غير مختشع","لو عاد يوما على اعقابه الازل",20,"ل",1,0],["وددت لو أني كنت في مصر محشوراً","فشاهدت يوماً للعروبة مذكورا",21,"ر",2,1],["وددت لو أني قبل منعاك ميت","ولم أتل شيئاً من نعيِّك في الكتب",22,"ب",1,0],["وَدِدتُ لَو أَنّي فِداكَ مِنَ الرَدى","وَالكاذِبونَ المُرجِفونَ فِدائي",23,"ا",2,0],["وَدِدنا لَو مَشَيتَ بِنا الهُوَينا","وَأَينَ الخُلودُ لَدَيكَ أَينا",24,"ن",2,0],["وَدِدتُ وَهَل نَفسُ اِمرِئٍ بِمَلومَةٍ","إِذا هِيَ لَم تُعطَ المُنى في وِدادِها",25,"د",3,0],["وَدِدتُ لَوَ انَّ الطَيفَ مِن أُمِّ مالِكٍ","عَلى قُربِ عَهدَينا أَلَمَّ فَسَلَّما",26,"م",2,0],["وَدِدتُ بِحِنّاباءَ إِذ أَنتَ موكِفٌ","حِمارَكَ مَحلوقٌ تَسوقُ بِعَفزَرا",27,"ر",2,0],["وددت ألقي بها لمائك","لعلها فيك تبردُ",28,"د",1,0],["وددت بأن أطيل لك القوافي","فيمنعني حياؤك أن أطيلا",29,"ل",2,0],["وددتُ يا نورَ عيني لو وَقَى بَصَري","جَنادِلاً وتُراباً لاصِقا بشَرَك",30,"ك",1,0],["ودِدتُ ذاك الشِراعَ الرخص لو كفني","يُحاكُ منه غَداةَ البَين يَطويني",31,"ن",2,0],["وَدِدنا وَنُعطى ما يَجودُ لَوَ أَنَّهُ","لَنا رائِمٌ حَتّى يَأوبَ المُنَخَّلُ",32,"ل",1,0],["وَدِدتُ لَو أَنَّكَ في","قَولِكَ هَذا تُنصِفُ",33,"ف",1,0],["وَدَدنا لِلنَواعِبِ لَو عَمينا","وَسُدَّت مِن مَسامِعِنا الخُروقُ",34,"ق",1,0],["وَدَدتُ أَنَّ اِعتِدالَ قَدِّه","يَشفي بِهِ مَن عَلى رَمَق",35,"ق",1,0],["وَدِدتُ لجِيلٍ قد تقَدَّمَ عصرُهم","لوِ استأخروا في حَلبة العُمرِ أو كروا",36,"ر",3,0],["وَدِدتُ أَنَّ إِلهي كانَ غادَرَني","وَمُدَّتي في يَدَيها أَقصَرُ المُدَدِ",37,"د",1,0],["وَدِدتُ بِأَنّي في عِمايَةَ فارِدٌ","تُعاشِرُني الأَروى فَأَكرَهُ قُمرَها",38,"ر",3,0],["وَدِدتُ أَنِّيَ مِثلُ السَيفِ لَيسَ لَهُ","حِسٌّ إِذا فُلَّ أَو رَثَّت لَهُ خِلَلُ",39,"ل",1,0],["وَدِدتُ وَفاتِيَ في مَهمَهٍ","بِهِ لامِعٌ لَيسَ بِالمَعلَمِ",40,"م",1,1],["وَدَدتُ بِعِلمِ اللَهِ أَنَّ صَحابَتي","عَلى كُلِّ حالٍ أَفرَدوني فَما ثَنّوا",41,"ن",3,0],["وَددت لَو اَنِّي اليَوم مثلك ميت","فَلَم ترَ عيني من يضير يضير",42,"ر",1,0],["وَددت لَو اَنَّ الموت يبطئُ ساعةً","لعليَ من مرأى محياك أَشبع",43,"ع",1,0],["وددت لَو اَنَّ الحب يَقسم منصفاً","فَيسلبني عضواً وَيترك لي عضوا",44,"و",2,0],["وَدَدت لَو أني أَرا","ها بعيون أَربَع",45,"ع",1,0],["وَدِدتُ لو قلبي كهذي القفار","أصمُّ لا يسمع ما في الديار",46,"ر",1,0],["وددتُ لو عنديَ جهل الثرى","تَعمُر أو تُقفر هذي البيوت",46,"ت",1,0],["ودَدْتُ لو أنِّي في إثرِهِ","درجتُ على الأرض في الدارجينْ",47,"ن",1,0],["ودِدْتُ لو شِدْتُ بالأسماء شاديةً","بها ربوعٌ حبيباتٌ وأرجاءُ",48,"ا",2,0],["ودِدْتُ لو حطَّمت هذي القيودْ","وجئتُ ألقاكِ على العاصفهْ",49,"ه",1,0],["وَددتُ لَولا ثَوابُ رَبّي لَو","أَماتَني قَبلَهُ وَأَحياهُ",50,"ا",2,0],["ودِدْتُ بأن أَلْقى من الناس مُنصفاً","إذا قلتُ حقّاً قال لي أنت صادقُ",51,"ق",1,0],["وَدَدتُ لَو مُتُّ يَومَ قالوا","غُصنُكَ يا فَرعَ فَهرَ ذاوِ",52,"و",1,0],["وددت لوَ أني عدت للدرس ناشئًا","أسير، وفي يمناي: لوح، ومرقم",53,"م",1,0],["وَدِدْتُ، وَهَلْ نَفسُ امرِىءٍ بملومة","إذا هيَ لمْ تُعطِ المنَى مِنْ وَدادها",54,"د",3,0],["وَدِدْتُ بَيَاضَ السّيفِ يَوْمَ لَقَينَني","مَكانَ بَيَاضِ الشَّيبِ كَانَ بمَفْرِقِي",55,"ق",2,0],["وَدِدْتُ وَمَا تُغْنِي الودَادَة ُ أَنَّني","بما في ضمير الحاجبيّة عالمُ",56,"م",1,1],["ودِدْتُ لم تمَّ لي حجّي بقربهما","ما كلٌّ ما تشتهيه النفسُ يتفقُ",57,"ق",1,0],["وددتُ ، على حبِّ الحياة ِ، لو أنها","يزاد لها، في عمرها ، من حياتنا",58,"ن",2,0],["وَدِدْنَا وَنُعْطى ما يَجُودُ، لَوَ انَّهُ","لنا رائمٌ، حتى يؤوبَ المنخل",59,"ل",1,0],["وَدَدتُ أَني في باب البَريد لِكَي","كُلٌّ يَمُرُّ فَأَحظى مِنهُ بِالنَظَر",60,"ر",1,0],["وددت لو لأن لي لفظٌ فأودعه","ما ضاق عن بعضه شرحي وتبييني",61,"ي",1,0],["وددت لو تنفع الأماني","لو كنت لدناً من الغصون",62,"ن",1,0],["ودِدتُ وإن كانت من العمر تنقضى","لو أن بواقيها تكون حَوالى",63,"ل",2,0],["ودِدتُ التصابى فيك إذ كان عاذرى","وعاديتُ حلمى إذ غدا عنك زاجرى",64,"ر",2,1],["وددت لو باتت معي ليلة","اوصا التي في الحلق أو صلت",65,"ت",1,0],["وددت بأطراف البنان لو أنني","بذي أروني ترومي ورائي الثعالب",66,"ب",1,0],["وَدِدتُ وَقَد جاوَرتُهُم أَنَّ مَنزِلي","بِحَيثُ ثَوَت غُبسُ الذِئابِ السَواغِبِ",67,"ب",1,0],["وَدِدتُ بِلا مَقتٍ مِنَ اللهِ أَنَّهَأ","نَصِيبِى مِنَ الدُّنيا وَأَنِّى نَصِيبُهَا",68,"ب",3,0],["ودِدتُ لو أنّكم تَدْرو","ن أشواقِي وبَلبالي",69,"ل",2,0],["ودِدْتُ ودادي منك في عين همّتي","وفي القلب والأحشاء والجِلْد والشَعْر",70,"ر",1,0],["وددت لو أنني أصبحت متبعاً","آثارها أرد الماء الذي ترد",71,"د",1,0],["وَدِدتُّ بِأَنَّكِ لَمّا هَتَفتِ","بِوَعدٍ وَلَم تُنجِزي ساكِتَه",72,"ت",2,0],["وَددنا لو أن السقمَ فينا جميعُهُ","وكانت معافاةً فذاكَ بهِ ترضى",73,"ض",2,0],["وَدِدتُ لَو كانَ مَسعى أَخمصَيهِ عَلى","خَدَّيّ صَوناً لِنَعلَيهِ وَتَرفيها",74,"ي",3,0],["وَدِدتُ بِأَن لَم يخلق اللَهُ لي وَقَد","نَعاهُ لِيَ الناعونَ عَيناً وَلا أُذنا",75,"ن",2,0],["وَدِدتُ بِأَنَّني أَستافُ تُربَ ال","غُوَيرِ وَأوسِعُ الحَصباءَ لَثما",76,"م",2,0],["وَدِدتُ بِأَنّي زُرتُ قَبرَكَ راجِلاً","وَقَبَّلتُ تُرباً أَنتَ فيها مُوَسَّدُ",77,"د",1,0],["وددتُ لو اني ميتٌ علَّ رحمةً","تخامرُ قلباً من (نهيلة) قاسيا",78,"ي",2,0],["وددت لو هاجه ندائي","وهزّه صوتي الجديد",79,"د",1,0],["وَدِدْتُ لو كنتُ حيثُ قلبي","فكنتُ من بَعْضِ حَاضريه",80,"ي",2,0],["وَدِدتُ لَو أَنَّني وَالدارُ نازِحَةٌ","أَسعى إِلَيكَ بِرَأسي حاكِياً قَلَمي",81,"ي",1,0],["وَدَدتُ أَن لَو تَراجَعنا بِأَلسُنِنا","كَفى تَراجُعُنا مِن أَلسُنِ الكُتُبِ",82,"ب",1,1],["وَدِدتُ لَوَ انَّ القَلبَ كانَ لِساني","لَعَلَّ بَياناً فيهِ فَوقَ بَيانِ",83,"ن",1,1],["وَدِدتُ لَو أَنَّ فَضلَ الحَظِّ مُكتَسَبٌ","فَكُنتُ أَكسِبُهُ كَالفَضلِ وَالأَدَبِ",84,"ب",1,0],["وددتُ حتفي وأني لا أفراقهم","فالموت في حبهم واللَه أوفقُ لي",85,"ل",2,0],["وددتُ أرى منها خيالَ خيالها","وقلتُ عسى أني بوهمٍ أزورها",86,"ر",3,0],["وددتُ أنّي بكفِّه قلمٌ","أو أنني مدَّة على قَلَمِهْ",87,"ه",1,1],["ودِدْتُ لَو أنَّ الحُزنَ ساعةَ بنتُم","عصاني وأن الصّبر كان مُطيعي",88,"ي",1,0],["وددت أني أمِّيٌّ فكم جلبت","أقلام خلى من خبط ومن خطل",89,"ل",1,0],["وددْتُ بأن الليل دام وإنه","إلى الحشر لا شمس على الأفق تطلع",90,"ع",1,0],["وددت وهل تغني الودادة أنه","يحل بجسمي ضُرُّهُ ولك الأجر",91,"ر",1,0],["ودِدْتُ لو أتحفني بودّه","ودام لي على قديمِ عهدِه",92,"ه",1,0],["وددت فراق روحي عن فراقي","لشخصك كان إذ روحي تهون",93,"ن",1,0],["وددت أهدي طويل العمر من أدبي","في عيده نفح أضواء وأنداء",94,"ا",2,1],["وددتُ الهوى يومين وصلا وهِجرةً","به اليومَ يشقَى من به أمسِ ينعَمُ",95,"م",1,0],["ودِدتُكَ لم أذخر هواكَ نصيحةً","أروح بها ملء الفؤادِ كما أُضحي",96,"ي",1,0],["ودِدْنا لعفّتِنا أننا","وُلدنا إذا كُرِهَ الشَّيْبُ شِيبا",97,"ب",2,0],["وددت لو أن السير فوق حمارة","من الصبح تمشي بالرديفين للعشا",98,"ش",2,0],["ودِدْتُ وما ودِدْتُ لغير جُرمٍ","وهنّ القالياتُ وما قُلينا",99,"ن",2,0],["وددتُ وداداً أنّه غير صادقٍ","وكم قاتلٍ ما كنتُ أهواه صادقا",100,"ق",2,0],["ودِدْتُ منه وَقد حَفّ الوشاةُ بنا","أنّا بعِلّةِ قرْبِ البينِ نعتنِقُ",101,"ق",1,0],["وَدِدْتُمْ بأنّ المجدَ أصبحَ شارداً","وَليسَ لَنا فيه اِقتِناصٌ لقانِصِ",102,"ص",1,0],["وَدِدْتُ لَوْ بِجَسَدِي","كُنْتُ احْتَمَلْتُ عِلَلَكْ",103,"ك",1,0],["وَدِدْتُ أَنَّي لِلْمَنَا","يَا كُنْتُ يَوْمَاً بَدَلَكْ",103,"ك",1,0],["وَدِدْتُ أَعضائِي أَسماعاً لتسمعَه","ولو تحمَّلْن فيه وطأَة العَذَلِ",104,"ل",1,0]]}