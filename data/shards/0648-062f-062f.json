!",207,"ب",2,0],["وَدَدتُم لَو خَلَعتُم عَنهُ حُكماً","وَ طُفتُم مِثلَما الغَنَمُ الشَغوبُ",208,"ب",1,0],["وددت من الغيب كل الوداد","لو اني لأشعارها راويه",209,"ي",2,0],["وَدَدتُ تَقْبيلَ خدَّيهِ فإذ عطِشٌ","لِمنْ يُرَوِّي فتسقيهِ مواجِعُهُ",210,"ع",2,0],["وَدَدْتُ تَقْبيلَ خَدَّيْهِ فَإِذْ عَطِشٌ","كَمَنْ يُرَوِّي فَتَسْقيهِ مَواجِعُهُ",211,"ع",2,0],["وَدِدتُ لَوْ شَيَّدُونِي فِيكَ مِئْذَنَةً","أَوْ أَوْقَدُونِي بِنَارِ الشَّوْق قِندِيلا",212,"ل",2,1],["وددتُ لوِ الممات وقد توانى","يرى قلبَ السقيمِ مِنَ البلاءِ",213,"ا",2,0],["وددت لوِ السؤال وقد بلينا","بذي الأيّام منْ مِنّا يحبّ ؟!",214,"ب",1,0],["وددته بضميرى","وودّنى لفظ فيه",215,"ي",2,0],["وَدِدْتُ لَوْ أَنَّنِي دَهْراً أُرَافِقُهَا","أَسُوسُهَا بِالرِّضَى فِي الْحِلْمِ وَ الْغَضَبِ",216,"ب",1,0],["وددت بأنني في كل ِ حرف ٍ","أسطرني وأكتبني اختصارا",217,"ر",2,0],["وددتُ لوَ انَّ الدهرَ أسْعَفَ إنِّني","تجرَّعْتُ كَأْسَ الحَتْفِ قبلَ نَوَاكما",218,"م",2,0],["ودِدْتُ ينطقُ ثغرٌ حينَ أسأله","وتُنفخُ الرّوحُ في جسمٍ فتحييها",219,"ي",3,0],["وَدِدنا لو تُراسِلُنا سُعادُ","وَكم في النّفسِ مِن أَمرٍ يُرادُ؟!",220,"د",1,1],["وددت لو أنى الان بين احضانكم أغفو","ووددت لو انكم الان بين احضاني",221,"ن",2,0],["وددتُ لو قبّلتُها مرتينْ","إِحداهما عند انسكاب اللُّجينْ",222,"ن",1,1],["وَدِدْنَا لَوْ تَدَحْرَجْنَا كِلَانَا","عَلَى قُزَحٍ لِتَنْظُرَنَا الْعُيُونُ",223,"ن",1,0]]}