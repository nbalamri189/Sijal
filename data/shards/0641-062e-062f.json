{"poems":[[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[78,"محب طوى كشحا على الزفرات","https://www.aldiwan.net/poem39476.html","الخفيف"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/41638","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[164,"شهود الهوى منى علي عذول","https://www.aldiwan.net/poem58955.html","الطويل"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[193,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[216,"لله من طفلة قلبي مساكنها","https://www.aldiwan.net/poem37858.html","الطويل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[469,"ولقد حللت من المحلة منزلاً","https://www.aldiwan.net/poem3546.html","عموديه"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[580,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[591,"كفى شرفا أني بحبك أعرف","https://www.aldiwan.net/poem17599.html","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34423","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37831","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16904","السريع"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126560","الخفيف"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126561","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31585","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77896","المنسرح"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100915","الطويل"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132215","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132618","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89210","الكامل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85039","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131077",""],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147660","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127095","الطويل"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5190,"الكذبة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=153355",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5362,"زار مخافة الرقيب غلسا","https://www.poetsgate.com/ViewPoem.aspx?id=170388",""],[5483,"تصدق بوصل إن دمعي سائل","https://www.poetsgate.com/ViewPoem.aspx?id=186113",""],[1333,"لو كنت في ديني من الابطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56026&r=&rc=4",""]],"verses":[["فَخَدَمتَ بِالعِلمِ البِلا","دَ وَلَم تَزَل أَوفى خَديمِ",0,"م",1,0],["فَخدِّي أَرضٌ للدُّمُوعِ وَمُقْلتي","سَمَاءٌ لها تَنْهَلُّ بِالعَبَراتِ",1,"ت",1,0],["فخدّ الثنا باقٍ بقاء فتًى يرى","إن الثراء وكلّ شيء فان",2,"ن",1,0],["فَخُدُودُهُنَّ مِنَ الدُّمُوعِ نَدِيَّةٌ","وَقُلُوبُهُنَّ مِنَ الْهُمُومِ صَوَادِي",3,"د",2,0],["فخدى بحمد الله بالدمع مخصب","ولكن ربع الاصطبار محيل",4,"ل",1,0],["فخَدِّي الزعفرانُ ولا أًحاشي","ودَمعي الأرجوانُ ولا أُبالي",5,"ل",2,0],["فَخِدمتهُ كانت فخاراً لديهمُ","وَقَد كانَ حسّادهم أنجمُ السما",6,"م",2,0],["فخدُّها أخضرٌ بالوردِ مُنْفَتحٌ","وثَغْرُها سَلْسَبِيلٌ غير مرشوفِ",7,"ف",1,0],["فَخَد بيد المقرى واشفع له وَلي","فَو اللَه اني مذنب وَهوَ مذنب",8,"ب",1,0],["فخدوده وردٌ وهيف قدوده","قضبٌ ودعج عيونه من نرجس",9,"س",1,0],["فخدمتُهُ أغنتكُمُ وهو واحدٌ","وكم واحدٍ أغنى غَناءَ أنامِ",10,"م",1,0],["فخدمتُه بمدائِحي وقرائِحي","وصحِبْتُه بتوسُّلي وتوصُّلي",11,"ل",2,0],["فَخدُّكَ وَرْدٌ وَاللَّواحِظُ نَرْجِسٌ","وَشَخْصُكَ نِدْمانٌ وَرِيقُكَ قَرْقَفُ",12,"ف",1,0],["فخدّاه تفاحي وَعَيناه نرجسي","وعارضُه مسكي وريقتُه خمري",13,"ر",2,0],["فَخدُّكَ ياقوتٌ وثَغرُكَ جَوهَرٌ","وسنُّكَ دُرٌّ والعِذارُ زُمرُّدُ",14,"د",1,0],["فَخَدُّهُ مِن سَلَحٍ تارَةً","وَتارَةً مِن قِشرِ بِلَّورِ",15,"ر",1,0],["فخدود مصافحات خدوداً","ونحو قد لف نحر بنحر",16,"ر",1,0],["فخدود مصافحات خدوداً","ولكن شهر وصلك شهرزور",17,"ر",1,0],["فَخُدودٌ مِثْلَ الشَّقائِقِ في اللو","ن تَليها شَقائِقٌ كَالخُدودِ",18,"د",1,0],["فخده في التراب منعفر","وَرجله في الركاب تجذبه",19,"ب",2,0],["فخدرها وجليل القدر مهتدل","ورحلها وجميل الصبر منتهب",20,"ب",1,0],["فخده وِإلاَّ ناله عندىَ الطَّوى","وأصبح فى حالٍ من العيش أنكد",21,"د",1,0],["فخدها جهاراً لا تراقب من الورى","قضاة ولا شيئاً فأنت في ذمتي",22,"ي",1,0],["فخدّه والعذار حسناً","زبرجد اخضر وتبر",23,"ر",1,0],["فخدمته بالنظم خدمة راغبٍ","متشرفاً من مدحه قرطاسي",24,"س",2,0],["فخِد نحوها باليعملات فانما","لطيبة عندي يستطاب وخيدها",25,"د",3,0],["فَخَدّي وَالرِضابُ وَكُلُّ قَدّي","مُباحٌ في مَباحٍ في مُباحِ",26,"ح",1,0],["فخدود كأنهن ورود","ونهود بهن ذو النسك يحلم",27,"م",1,0],["فخدّي وجسمي والفؤاد وأدمعي","شهود بهم دعوى الغرام تصحح",28,"ح",1,1],["فخد شقيق الأنس فيه مضرج","وثغر أقاح اللهو أمسى مفلجا",29,"ج",2,0],["فخده بإنصاف وصفو سريرة","تجده بما يغني عن الشيخ منعما",30,"م",2,0],["فَخُدِعتُ يَومَ سَمِعتُهُ نَغَماً","ورَجَعتُ بَعدَ سَمَاعِهِ صِفْرَا",31,"ر",2,0],["فخدعن ذوي التحقيق في شأن أمرها","مقالاً ودعنا من مقالاتك النكرا",32,"ر",2,0],["فخده رق لعيني منظرا","وقلبه علي بالوصل قسا",33,"س",2,0],["فخدك موجود به التبر والغنى","وحسنك معدوم لديه الشمائل",34,"ل",1,0],["فخد الكفاف ولا تكن ذا فضلة","فالفضل تسأل عنه أي سؤال",35,"ل",1,0]]}