""],[5736,"دموع الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=203163",""],[5770,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=178689",""],[5776,"شفرة الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=199407",""],[5790,"عندي غرام وتبريح وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=112041",""],[5818,"إذرفْ دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=193230",""],[5836,"الحفاظ عل المودة مع الناس","https://www.poetsgate.com/ViewPoem.aspx?id=194362",""],[5851,"سفيرة ورسالتها الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175291",""],[5902,"جماع أشتات الْفَضَائِل وَالَّذِي","https://www.poetsgate.com/ViewPoem.aspx?id=189172",""],[5939,"اللغز السهل","https://www.poetsgate.com/ViewPoem.aspx?id=185490",""],[5956,"رحلتْ إلى الرحمن زوجة عبد الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=215612",""],[6091,"دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=177535",""],[2588,"شاخصة (أستغفر الله)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65603&r=&rc=35",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""],[572,"وَقَعَتْنِي ما بينَ حُزْنٍ وبؤسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9352&r=&rc=209",""]],"verses":[["إِذ رَفَعنا الجِمالَ مِن سَعَفِ البَح","رَينِ سَيراً حَتّى نَهاها الحِساءُ",0,"ا",2,0],["إذْ رَآهَا وَالشُّعُوبُ شَأَتْ","لَمْ تَزَلْ فِي أَوَّلِ الدَّرْب",1,"ب",1,0],["إِذْ رَاحَ يَبْذُلُ فِي الطَّلِيعَةِ نَفْسَهُ","لِنَجَاتِهِمْ مِنْ ذِلَّةٍ وَهَوَانِ",2,"ن",1,0],["إذ رمتهم يد الزمان بخطب","جلل ما لنقضه إبرام",3,"م",1,0],["إذ راح بالانكليز اليوم ممتنعاً","فضاعف الشرّ فيما جرّ واجترما",4,"م",2,0],["أذْرى غبارَ الشيبِ فوق مفارقي","ركضُ السنين الراكضات أمامي",5,"م",2,0],["إذ رموْهُمْ بنارهم من يمينٍ","وشِمال وخلفِهمْ وأمام",6,"م",1,0],["إذ رقد الحياء نادمت نجمه","أدير له ذكر الكرى ويدير",7,"ر",1,0],["أُذري على الخدِّينِ دم","عاً من فراقِهمُ سِجاما",8,"م",2,0],["إِذ رَآني مِن أَذى ال","قَولِ حاذِر",9,"ر",1,0],["إِذ رامَ اِستِراقَ السَمعِ يَوماً","رَجيمُ الكَيدِ عاجَلَهُ بِرَجمِ",10,"م",1,0],["أَذراءُ أَمطاءِ الغِنى يَضحَكنَ عَن","أَذراءِ أَمطاءِ المَطايا القودِ",11,"د",1,0],["أُذري الدُموعَ كَذي سُقمٍ يُخامِرُهُ","وَما يُخامِرُ مِن سُقمٍ سِوى الذِكَرِ",12,"ر",1,0],["إِذ رَكِبُوا فيما أُرى","مِن حالِهِم ما رَكِبُوا",13,"ب",3,0],["أَذرى الدُموعَ فَلامَهُ أَصحابُهُ","إِذ صاحَ بِالبَينِ المُشِتِّ غَرابُهُ",14,"ب",2,0],["إذْ راحَ بالقَوْلِ الصَّرِيحِ مُبَشِّراً","بالنَّسلِ مِنها عاقِراً مَعضولا",15,"ل",2,0],["أَذرَتِ الدَمعَ وَقالَت وَيلَتي","مِن وَلوعِ الكَفِّ رَكّابِ الخَطَر",16,"ر",1,0],["إذْ رَدَّها الخَيْلُ تَعْدُوَ وَهْيَ خَافِضَة","حَدَّ النَّبارس مَطروراً نَواحِيهَا",17,"ي",3,0],["إذ راح يخفق وحده","خفقان أجنحةِ الحمام",18,"م",1,0],["إذ رَأتْهُ قُرَيْشٌ قال قائِلُها:","إلى مَكَارِمِ هذا يَنْتَهِي الكَرَمُ",19,"م",1,0],["إذ رمهم هضباته شم","وديرتهم عذية",20,"ي",2,0],["إِذ رَجائي لَدَيهِ وَقفٌ عَلى النُج","حِ وَفَألي مُصَدَّقٌ مُذ وَفى لي",21,"ل",2,0],["إِذْ رأَى الوَصْلَ مُولَعاً مِنْهُ بِالهَجْ","رِ وحُكْمَ الهَوى عَلَى الجَوْرِ جارِ",22,"ر",1,0],["إِذ رَأَى كَفِّيَ دَأباً","بِعَصَاها مُستَهامَه",23,"م",2,0],["أَذرِ الدُموعَ فَما الدُموعُ سِوى نَدى","هذي الحَياة وَعرفُه فَيّاحُ",24,"ح",1,0],["إذ رَجَع الحبرجُ ما لاَقاه","ثم رأى من بعده أخاه",25,"ا",2,0],["إذ رأى فوقه الغمامة ظلاُ","ويميل الظلال أنى يميل",26,"ل",1,0],["إِذ رَقيبُ الهَوى غَفو","لٌ وَأَسرارُهُ عَلَن",27,"ن",1,0],["إذ رأوها برفعةٍ","خبر الفتح مبتدا",28,"د",2,0],["إذرفي الدمع وانضحى من دم الق","لب وروّي مصارع الأبطال",29,"ل",1,0],["إذ رأوني طائر الأح","لام وثّابَِ الرغاب",30,"ب",1,0],["أُذْرِي الدّموعَ ويَلْحَى اللاّئمون معاً","على الزّمانِ الّذي قد فَرَّق الخُلَطا",31,"ط",2,0],["إذ رمت يا لؤلؤة الاندلس ال","حسناء قتل اثنين دون رحمة",32,"ه",1,0],["إذ رأسٌ رأيتَ به طِماحاً","شدوت له الغمائِمَ والصِّقاعا",33,"ع",2,0],["أذروة يشجب حزتَ المدا","وَجاوزت حدَّ المعالي مداكا",34,"ك",2,0],["إذْ رُبَّ رَاوٍ حاِملِ الرِّوايَهْ","لِغَيْرِهِ مِمَّنْ لَهُ الدِّرايَهْ",35,"ه",1,0],["إِذ رَجَعتَ الآنَ في جَيشِ الهَنا","لَحماً بَيروتَ يَزهو بِالمَعاد",36,"د",1,0],["إِذْ رَقَّ بَعْدَ مُدْمَجِ الإِدْماجِ","وَدُمْلُجِيٍّ حَسَنِ الدِمْلاجِ",37,"ج",1,0],["إذرمت من بني الابى لوذعياً","رضعته العلوم وهو رضيع",38,"ع",1,0],["إذ ربما في الكثر يُرجى السلمُ","ومفرد الطعنات فيه الوهمُ",39,"م",1,0],["إذ رُب نحظى بعد ذاك المرّفي","شيءٍ لذيذ الطعم حلو المضغةِ",40,"ه",1,0],["إذ ربما لم يرتضوا خازناً","مع أنه نعم المثيل الشبيهْ",41,"ي",2,0],["إذ رأيت التيه من ذي الغنا","تهت علي التائه بالباس",42,"س",1,0],["اذ ركعت رأيت لها الأعادي","سجوداً في التراب بغير هام",43,"م",1,0],["إِذ رَحلُ أُختِكَ لِلعَجَم","وَفِراشُ أُمِّكَ في الظُلَم",44,"م",1,0],["إذ رمَت قعصَ نابلٍ ليسَ يُنمي","مَدَّ في ازَربِ زيزفونا رنونا",45,"ن",2,0],["إذ رأينا أن النبي صريعُ","فأشاب القذالَ أي مشيبِ",46,"ب",1,0],["إذ رأينا بيوته موحشاتٍ","ليس فيهن بعدَ عيش حبيبي",46,"ب",2,0],["إذ رمانا ببغيه وبنو الحا","رث قوم يزهون بالغلواء",47,"ا",2,0],["اذراح فيها حمام الايك يسمعني","نقر الزاهر اوتنغيم مزمار",48,"ر",1,0],["إذ رأت مشهد النبوَّةِ نوراً","زانه منكَ مظهرٌ وَضَّا",49,"ا",1,0],["إذ راقَ في نظري كتابٌ قد حوى","للمنشئينَ بلاغَةً وبيانا",50,"ن",2,0],["أذري دموعك والدما","ءَ على الشهيدِ بن الشهيدِ",51,"د",1,0],["أَذْرت على الخدِّ الدموع فخلتها","برداً تساقط فوق ورد أحمر",52,"ر",1,0],["إذ رُؤيَةٌ لاَ فِي مُقَابَلَةٍ مِنَ الرَّ","ائِى مُحَالٌ لَيسَ فِي الإمكَانِ",53,"ن",1,0],["أذرف الدمعَ دماً من كبدي","مُذ سَقاني الصدُّ كاساتٍ صدودا",54,"د",2,0],["إذ رأس مالك لعبة بصرية","بيضاء مغربة عليها السوسن",55,"ن",1,0],["إذ ركبت ضبّةُ اعجازَ النّعَم","فلم تدع ساقاً لها ولا قَدَم",56,"م",1,0],["إذ رمى البين عنك بي فحوتني","يمن أوحوتك عن شأم",57,"م",1,0],["أَذروة هاشم وَسَنام فَهرٍ","وَطودهم الأَشمّ المُستَطيلا",58,"ل",2,0],["أَذُرى النَخلِ بِالسَوادِ رَأَينا","أَم رَأَينا لِآلِ هِندٍ حُمولا",59,"ل",2,0],["إذ رن قرب الجدول","للنفس لا للمحفل",60,"ل",1,0],["إذ رضوا بافتضاض فطيون منهم","كل بكر ريا الروادف رود",61,"د",1,0],["إِذ ريع فالليث القضا قض دونه","وإِن سئل المعروف لم يتلجلج",62,"ج",1,0],["إذ ربنا بالاقتدا بهم أمر","في غير ما خصوا به دون البشر",63,"ر",1,0],["إذ ربنا لم يرضها دار جزا","لمن أحب واصطفى وعززا",63,"ز",2,0],["إذ رأت في الجو من بع","د الظلام اليوم نور",64,"ر",1,0],["إِذ راعَهَا نَبَأُ يُذَاعُ وشدَّ مَا","سمِعَتهُ كُرهاً مِن جِهازش مُذيعِهَا",65,"ع",3,0],["إذ روَى أو أشادَ العالِمُونَ بِهَا","تملَّكَ القلبَ راويهَا وشادِيهَا",66,"ي",3,0],["إذ رمزت لي بالسيف والقلم","عن اتحاد الأحكام والحكم",67,"م",1,0],["إذ رمى كل نعمةٍ بزَوالٍ","وانتقالٍ وكلّ سِترٍ بهتْكِ",68,"ك",1,0],["إذ رأيه في المشكلا","ت نهايةٌ لا تنكر",69,"ر",1,0],["إذ راح بدر الزور منعكساً","وارتدَّ مكسوفاً على الغرب",70,"ب",1,0],["اِذْ رآني كالصقرِ سُلَّ جناحا","ه وكانا الى الحِمامِ ذريَعا",71,"ع",2,0],["إذ رأى أن يكتب العهد الذي","لو له خط لما ضلوا وتاهوا",72,"ا",1,0],["إذ روضه اللّذات دانية الجنا","قد باكرتها ديمة الإيناس",73,"س",1,0],["إذ رموهم بالفسق والزور والجو","ر وظلم العباد سلباً ونهبا",74,"ب",2,0],["إذْ ربما قد عَوَّقتْه الأقْدارُ","وكلُّ شيءٍ عنده مِقْدارُ",75,"ر",1,0],["اذ رأت حبها يسير رويدا","وهو في هاجس من الاشجان",76,"ن",1,0],["اذ رأى امه فويق سرير","زينوه بالورد والاعلام",77,"م",1,0],["إذ رماني القمرُ الزا","هر عن فترةِ جفنِ",78,"ن",1,0],["إذ ربما في حالة استنجاك من","دخل النجاسة تحتها لم تسلم",79,"م",1,0],["إِذ رَاعَني صوت هببتُ لهُ","وَذُعرتُ منهُ أيّما ذعرِ",80,"ر",1,0],["إِذ ردَّ بولس داحضاً لِسهامِهِ","فَغَدَت لراشقها الغَبيّ تمزّقُ",81,"ق",1,0],["إِذ راهم في حِماها كَالحَمام","أُرسلوا كَالضانِ ما بَينَ الذِئاب",82,"ب",1,0],["إِذ راضَ مِنهُ النَفسَ لِلنَّحوِ الَّذي","تَصحو بِهِ فَتَذوقُ لَذّاتِ الغِنا",83,"ن",2,0],["أذرتِ الدمعَ وقالت ويلتي","كيف أنجو من غلام مستشر",84,"ر",1,0],["أذرت الدمع فأوهت جلدي","واعتراها كجنون مستتر",84,"ر",1,0],["إذ روضة اللذات دانية الجنى","قد أمطرتها ديمة الايناس",85,"س",1,0],["أذرية الطيار يا أل جعفر","أرى حبكم لاشك مفترض الأدا",86,"د",2,0],["أذرى بطوفان نوحٍ في تدفُّقهِ","وزيدَ في صنعهِ صبغٌ لابحار",87,"ر",1,0],["إذ رنات عود","تصبو بأهل الرشاد",88,"د",1,0],["أذري الدم ليلي ونهاري والله","لم يغن عن الهوى حذاري والله",89,"ه",1,0],["إِذ رَأى أَن لَم يَضِرها جَهدُهُ","وَرَأى خَلقاءَ ما فيها طَمَع",90,"ع",1,0],["أذر دمع العينين فيها وسلها","ان أطاقت إليك رجع الجواب",91,"ب",1,0],["أذرفْ فدمعُكَ موقِظٌ مِنْ غفلةٍ","هذي الورى كثباتِ كهفٍ .. حرِّكا",92,"ك",2,0],["أُذْرُفْ فقد تمحو دموعُك جرمَنا","قد ضَلَّ (معتصمٌ) إليكَ المسلكا",92,"ك",2,0],["أذررف الدمع مالي بالمقادير حيله","غير صبري وصبري قد تعدى احتمالي",93,"ل",2,0],["أذرفت دمع العين ساعة لفتنا","دمعة فرح سالت على الخد وديان",94,"ن",1,0],["إذ رفرفت ليهود الرّجس ألويةٌ","في أفق موطننا , والعُربُ كالجزَر",95,"ر",1,0],["أذْرِي على عينيَّ لؤلؤَ نَظْرةٍ","لِتغوصَ في بحرِ الهوى أسماكي",96,"ك",2,0],["أذر الدموع فلات حين مجاز","وابك لغريب الفرد في شيراز",97,"ز",1,1],["أذرفي يا عين دمعي وأمسحي","في ليالي نجمها طاح وأفل",98,"ل",1,0],["إذ رماه زمناه","فإذا فيه اصفرارُ",99,"ر",1,0],["إِذْ رَمَوْا ظُلْمَا فَضَائِلَهُ","أَسْهُمًا لِلْكَذْبِ وَالفَنَدِ",100,"د",1,0],["أَذْرِف الدمعه .. وتتليها الدموع","والدموع ... ! تتليها ونّات القهر",101,"ر",1,0],["أَذِرْوَةَ يَشْجُبٍ أَفْلَحْتَ سَعْياً","وَلازَمْتَ المَعالِي وَالفَلاحَا",102,"ح",2,0],["أَذِرْوَةَ يَشْجُبَ حُزْتَ المَدَى","وَجاوَزَ حَدَّ المَعالِي مَداكَا",103,"ك",2,0],["إذ رأى المصطفى محيّاً بهيّاً","ولرؤياه في الملا أصداء",104,"ا",2,0],["إذ رعته من (آل زكوان) عينٌ","بفواغي ورودها ورَواها",105,"ا",3,0],["‏أذرفي ياعيوني دمعتك من جديد","وأذكري سالفة ليلى ومجنونها",106,"ن",3,0],["إذْ رَمَتْ قلبي بلَحظٍ قاتلٍ","يا ظِباءَ الحُبِّ رُحماكِ عَلَيْ",107,"ي",1,0],["اذرف دموعك في الليالي واغرفِ","من فيض دمعٍ في المحاجر مترفِ",108,"ف",1,1],["إذ ردَّه \"الجزار\" مدحوراً وهيئته زريه","بئس السلام فتاتهم والسلم سلم البندقيه",109,"ي",2,0],["إذ راودته الأرض ملء سهولها","وجبالها _ يطوي الزمان ويعرجُ",110,"ج",1,0],["إذ رنا فالظبي والظبي في خجلٍ","وإن بدا فالقنا الخطي خطار",111,"ر",1,0],["إذرفْ دموعك يا صديقي واحتسِ","من بعد بيعك للغرامِ الأنْفسِ",112,"س",1,1],["إذْ رُبَّما عادَ الوِدادُ لِسابِقٍ","وأتاكَ مِنْ بعدِ الخِصَامِ مُلاقيَا",113,"ي",2,0],["أذرُو الرمادَ وفي الوجدانِ جمرَتهُ","تصعِّدُ الشعرَ والأخشابُ أفكارُ",114,"ر",1,0],["أذري بسحب بيانهم فِي هطلها","فِيمَا يبين بطله وبدثه",115,"ث",2,0],["أَذروها في عَصْفِ فُتوني","فتَصيرُ فُتاتا كالمُهلْ",116,"ل",1,0],["أذرَى عليها الدمع يرجو منحَها","دمَهُ لقاء حياتها بأمانِ",117,"ن",1,0],["أذرعُ الحلمَ جيئةً وذهاباً","لا أرى في الأحلامِ إلا أساها",118,"ا",3,0],["إذ رأونا نتبارى في الطربْ","ما لنا دون الملذّات أرَبْ",119,"ب",1,1],["اذرِفي الدَّمعَ كيفَ شئتِ .. فإنِّي","صخرةٌ لا تلينُ للدامعِينا",120,"ن",2,0],["إذ رأتني مشَّطْتُ عاجاً بعاجٍ","وهي الإبنوسُ بالإبنوسِ",121,"س",1,0]]}