{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[95,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[90,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[90,"هي النفوس وإن لم تبلغ الحلما","https://www.aldiwan.net/poem44830.html","البسيط"],[53,"راع المها شيبي وفيه أمانها","https://www.aldiwan.net/poem66071.html","الكامل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[87,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[64,"أما الشباب فقد تقض","https://www.aldiwan.net/poem52278.html","مجزوء الكامل"],[68,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[68,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[46,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[33,"يا ليتني قد أجزت الحبل نحوكم","https://www.aldiwan.net/poem42540.html","البسيط"],[42,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[42,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[52,"عجبت فطمة من نعتي لها","https://www.aldiwan.net/poem62386.html","الرمل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62303","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[30,"هذا الذي تعرف البطحاء وطأته","https://www.poetsgate.com/ViewPoem.aspx?id=22084",""],[128,"فتنتك تذكارات ميه","https://www.aldiwan.net/poem23746.html","مجزوء الكامل"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[159,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[177,"قال لي يهزأ من لم","https://www.aldiwan.net/poem4415.html","مجزوء الرمل"],[227,"شبح الدموع تمضك الأتراح","https://www.aldiwan.net/poem41872.html","الكامل"],[233,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[235,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[239,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[263,"إن سطا الدهر واعتدى","https://www.aldiwan.net/poem35952.html","مجزوء الخفيف"],[294,"لا تضني بالدمع يا عين ما الدمع","https://www.aldiwan.net/poem11695.html","الخفيف"],[332,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[368,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[447,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[737,"","https://poetry.dctabudhabi.ae/diwan/poem/97760","الخفيف"],[751,"","https://poetry.dctabudhabi.ae/diwan/poem/200331","الخفيف"],[858,"","https://poetry.dctabudhabi.ae/diwan/poem/95998","الرجز"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/17733","الخفيف"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["إِذ رَفَعنا الجِمالَ مِن سَعَفِ البَح","رَينِ سَيراً حَتّى نَهاها الحِساءُ",0,"ا",2,0],["إذْ رَآهَا وَالشُّعُوبُ شَأَتْ","لَمْ تَزَلْ فِي أَوَّلِ الدَّرْب",1,"ب",1,0],["إِذْ رَاحَ يَبْذُلُ فِي الطَّلِيعَةِ نَفْسَهُ","لِنَجَاتِهِمْ مِنْ ذِلَّةٍ وَهَوَانِ",2,"ن",1,0],["إذ رمتهم يد الزمان بخطب","جلل ما لنقضه إبرام",3,"م",1,0],["إذ راح بالانكليز اليوم ممتنعاً","فضاعف الشرّ فيما جرّ واجترما",4,"م",2,0],["أذْرى غبارَ الشيبِ فوق مفارقي","ركضُ السنين الراكضات أمامي",5,"م",2,0],["إذ رموْهُمْ بنارهم من يمينٍ","وشِمال وخلفِهمْ وأمام",6,"م",1,0],["إذ رقد الحياء نادمت نجمه","أدير له ذكر الكرى ويدير",7,"ر",1,0],["أُذري على الخدِّينِ دم","عاً من فراقِهمُ سِجاما",8,"م",2,0],["إِذ رَآني مِن أَذى ال","قَولِ حاذِر",9,"ر",1,0],["إِذ رامَ اِستِراقَ السَمعِ يَوماً","رَجيمُ الكَيدِ عاجَلَهُ بِرَجمِ",10,"م",1,0],["أَذراءُ أَمطاءِ الغِنى يَضحَكنَ عَن","أَذراءِ أَمطاءِ المَطايا القودِ",11,"د",1,0],["أُذري الدُموعَ كَذي سُقمٍ يُخامِرُهُ","وَما يُخامِرُ مِن سُقمٍ سِوى الذِكَرِ",12,"ر",1,0],["إِذ رَكِبُوا فيما أُرى","مِن حالِهِم ما رَكِبُوا",13,"ب",3,0],["أَذرى الدُموعَ فَلامَهُ أَصحابُهُ","إِذ صاحَ بِالبَينِ المُشِتِّ غَرابُهُ",14,"ب",2,0],["إذْ راحَ بالقَوْلِ الصَّرِيحِ مُبَشِّراً","بالنَّسلِ مِنها عاقِراً مَعضولا",15,"ل",2,0],["أَذرَتِ الدَمعَ وَقالَت وَيلَتي","مِن وَلوعِ الكَفِّ رَكّابِ الخَطَر",16,"ر",1,0],["إذْ رَدَّها الخَيْلُ تَعْدُوَ وَهْيَ خَافِضَة","حَدَّ النَّبارس مَطروراً نَواحِيهَا",17,"ي",3,0],["إذ راح يخفق وحده","خفقان أجنحةِ الحمام",18,"م",1,0],["إذ رَأتْهُ قُرَيْشٌ قال قائِلُها:","إلى مَكَارِمِ هذا يَنْتَهِي الكَرَمُ",19,"م",1,0],["إذ رمهم هضباته شم","وديرتهم عذية",20,"ي",2,0],["إِذ رَجائي لَدَيهِ وَقفٌ عَلى النُج","حِ وَفَألي مُصَدَّقٌ مُذ وَفى لي",21,"ل",2,0],["إِذْ رأَى الوَصْلَ مُولَعاً مِنْهُ بِالهَجْ","رِ وحُكْمَ الهَوى عَلَى الجَوْرِ جارِ",22,"ر",1,0],["إِذ رَأَى كَفِّيَ دَأباً","بِعَصَاها مُستَهامَه",23,"م",2,0],["أَذرِ الدُموعَ فَما الدُموعُ سِوى نَدى","هذي الحَياة وَعرفُه فَيّاحُ",24,"ح",1,0],["إذ رَجَع الحبرجُ ما لاَقاه","ثم رأى من بعده أخاه",25,"ا",2,0],["إذ رأى فوقه الغمامة ظلاُ","ويميل الظلال أنى يميل",26,"ل",1,0],["إِذ رَقيبُ الهَوى غَفو","لٌ وَأَسرارُهُ عَلَن",27,"ن",1,0],["إذ رأوها برفعةٍ","خبر الفتح مبتدا",28,"د",2,0],["إذرفي الدمع وانضحى من دم الق","لب وروّي مصارع الأبطال",29,"ل",1,0],["إذ رأوني طائر الأح","لام وثّابَِ الرغاب",30,"ب",1,0],["أُذْرِي الدّموعَ ويَلْحَى اللاّئمون معاً","على الزّمانِ الّذي قد فَرَّق الخُلَطا",31,"ط",2,0],["إذ رمت يا لؤلؤة الاندلس ال","حسناء قتل اثنين دون رحمة",32,"ه",1,0],["إذ رأينا أن النبي صريعُ","فأشاب القذالَ أي مشيبِ",33,"ب",1,0],["إذ رأينا بيوته موحشاتٍ","ليس فيهن بعدَ عيش حبيبي",33,"ب",2,0],["إذ رمانا ببغيه وبنو الحا","رث قوم يزهون بالغلواء",34,"ا",2,0],["إذ ركبت ضبّةُ اعجازَ النّعَم","فلم تدع ساقاً لها ولا قَدَم",35,"م",1,0],["أَذُرى النَخلِ بِالسَوادِ رَأَينا","أَم رَأَينا لِآلِ هِندٍ حُمولا",36,"ل",2,0],["إِذ رَاعَني صوت هببتُ لهُ","وَذُعرتُ منهُ أيّما ذعرِ",37,"ر",1,0],["إِذ رَأى أَن لَم يَضِرها جَهدُهُ","وَرَأى خَلقاءَ ما فيها طَمَع",38,"ع",1,0]]}