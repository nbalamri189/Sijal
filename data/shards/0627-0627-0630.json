{"poems":[[55,"إذا رابني الأقوام بعد ودادة","https://www.aldiwan.net/poem29849.html","الطويل"],[29,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[53,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[91,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[87,"الرشد أجمل سيرة يا أحمد","https://www.aldiwan.net/poem63675.html","الكامل"],[87,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[68,"قد قضينا العمر في مطلكم","https://www.aldiwan.net/poem38741.html","الرمل"],[99,"صورة للبحر أم صورة نفس","https://www.aldiwan.net/poem24941.html","الرمل"],[82,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[21,"أأذكر حاجتي أم قد كفاني","https://www.aldiwan.net/poem36248.html","الوافر"],[50,"أمربعنا بالشط لا لعب البلى","https://www.aldiwan.net/poem62578.html","الطويل"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[48,"بني الآداب غرتكم قديما","https://www.aldiwan.net/poem22343.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140853",""],[47,"على الحَيّ، سرْنا عَنهُمُ وأقَامُوا","https://www.poetsgate.com/ViewPoem.aspx?id=32086",""],[121,"عسل","https://www.aldiwan.net/poem24056.html","الكامل"],[128,"هات اسقنيها يا غلام","https://www.aldiwan.net/poem23753.html","مجزوء الكامل"],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[190,"ولي هر رميت به خبيث","https://www.aldiwan.net/poem43306.html","الوافر"],[203,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[287,"بالملك الأشرف لم","https://www.aldiwan.net/poem32630.html","منهوك الرجز"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[443,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[591,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122744","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44781","الرمل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121066","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108799","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108723","الطويل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101587","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127982","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49551","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106894","الطويل"],[2720,"","https://poetry.dctabudhabi.ae/diwan/poem/146623","الهزج"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114536","البسيط"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203188","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73419","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83630","الكامل"],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[4858,"ومن المساجد ينبع الظفر","https://www.poetsgate.com/ViewPoem.aspx?id=37236",""],[5026,"قنديل مذاب","https://www.poetsgate.com/ViewPoem.aspx?id=213500",""],[5046,"متشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=197914",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5213,"تهددني الأيام جهلا بجورها","https://www.poetsgate.com/ViewPoem.aspx?id=170468",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5493,"موعد بلا لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=197213",""],[5695,"براءة ووفاء..","https://www.poetsgate.com/ViewPoem.aspx?id=212553",""],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""]],"verses":[["أَأَذهَبُ عَن قَومٍ كِرامٍ أَعِزَّةٍ","إِلى جِذمِ قَومٍ عاجِزينَ بِخالِ",0,"ل",1,0],["أَأَذكُرُ الجَهدَ وَالبَلوى الَّتي نَزَلَت","أَم قَد كَفاني الَّذي بُلِّغتَ مِن خَبَري",1,"ر",2,0],["أَإِذا تكونُ كريهةٌ أُدعىَ لها","وإذا يحاسُ الحَيْسُ يُدعى جُندُبُ",2,"ب",1,0],["أاذا نجحت حمدت نفسك مطريا","واذا فشلت تعاتب الاياما",3,"م",2,0],["أَإِذا وَجَدتَ الغيدَ أَلهاكَ الهَوى","وَإِذا وَجَدتَ الشِعرَ عَزَّ الأَغيَدُ",4,"د",1,0],["أَإِذا أَصابَ القُطنَ كاسِدُ سوقِهِ","قُمنا عَلى ساقٍ إِلى أَثمانِهِ",5,"ن",2,0],["أَإِذا مُتنا نَرى وَعدَكُمُ","أَم إِذا كُنّا تُراباً وَعِظاما",6,"م",2,0],["أإذا اشتد على القلب البلاء","أإذا جار عبابٌ وتناهى",7,"ه",2,0],["أَأَذكى علَيه القينُ بالرّيحِ نارَهُ","وَأَمكَنَه في الطبعِ بَينَهُما طَبْعُ",8,"ع",1,0],["أَأَذكُرُ حاجَتي أَم قَد كَفاني","حَياؤُكَ إِنَّ شيمَتَكَ الحَياءُ",9,"ا",2,1],["أَأَذكُرُ طَرفاً بِالصُدودِ تَقَطَّعَت","قُلوبٌ إِلَيهِ بِالوِصالِ صَوادِ",10,"د",1,0],["أَآذِنٌ أَنتَ في قَط","عِ كُلِّ مَن صافاكا",11,"ك",2,0],["أَأُذهِبُ فيكُمُ أَيّامَ شَيبي","كَما أَذهَبتُ أَيّامَ الشَبابِ",12,"ب",1,0],["أَإِذا ما نجا امرؤ من جدال","أَخذته الأمراض أخذاً وَبيلا",13,"ل",2,0],["إاذ ما ذكرنا جوده كان حاضراً","نأى أو دنى يسعى على قدم الخضر",14,"ر",1,0],["أأذْكُرُ أيّامَ المُصَافَاةِ، بَعدَمَا","تَجَرّمَ عامٌ بَعدَهُنّ، وَعَامُ",15,"م",1,0],["أَأَذوقُ مِن شَفَتَيْكِ يا حُبّي عَسَلْ؟","ما عادَ يَكفي أَلفُ مِلْيونٍ قُبَلْ",16,"ل",1,1],["أإذا استمعت إلى الفلا","والعود كفرني الإمام",17,"م",1,0],["أأذمُّ الزمانَ والعدلُ فيه","قائمٌ بيننا وأنتم ثِقاتُه",18,"ت",2,0],["أأُذادُ عن بَرْدِ الحياض ومثلُهم","يُدعَى إلأى العَذبِ الزلالِ فيكرَعُ",19,"ع",1,0],["أأذكرُ أيام الحمى لا وحقّها","بل أتناسى إنَّ ذكر الحمى يصبى",20,"ب",2,0],["أأذكره هذا فرض ليس بذم","للذي شيق وأنّي بالمنام",21,"م",1,0],["أإذا نالَ من كريمٍ سفيهٌ","أتقيموا لهُ السفاهةَ عذرا",22,"ر",2,0],["أَأَذكُرُ الحاجَةَ أَم","حَسبي بِمَحمودِ الشِّيَم",23,"م",1,0],["أَأُذادُ عنكمْ في غدٍ وأنا الّذي","لي مِن وِدَادِكَ ذمةٌ لَنْ تُخفَرا",24,"ر",2,0],["أأذُمّ بارح طيرها أم اشتكي","زمني فقد أقصى بلوغ مرامي",25,"م",2,0],["أأذمُّ فاحشَ صبغها في غدرةٍ","عندي لها أمثالُها آلافُ",26,"ف",1,0],["أأذهلُ عن خطِّ القوافي لخطّها","وما كنتُ عن خطّ القوافي بذاهل",27,"ل",1,0],["أَأُذَلُّ فِي أَيَّامِ مَنْ قَدْ كَانَ لي","ظَنٌّ بِنَيْلِ العزِّ في أَيَّامهِ",28,"م",2,0],["أَإِذا خَضَعتَ لَهُ استَبَدَّ","وَإن نَزَلتُ لَهُ رَحَل",29,"ل",1,0],["أأذمه وأنا العليم بما له","عند الكريم أخيه من حرمات",30,"ت",1,0],["أَإِذا أَنشَدتُ يوفيكَ نَشيدي","حَقَّكَ الواجِبَ يا خَيرَ شَهيدِ",31,"د",1,1],["أأذكرها جهراً وسري يصونها","وأكتمها وجداً وأشكو أمانيا",32,"ن",3,0],["أإذا الغزالة لم تُنل","تستقبح القمر المقل",33,"ل",1,0],["أأذنب عبدٌ حامدٌ لك شاكرٌ","فيبعده عن وجهك البلد القفر",34,"ر",1,0],["أأذوب لا واللَه لست أذوب","إن قال ترك قلت ذا المطلوب",35,"ب",1,1],["أأذم مافعل الزمان واننى","بجميل أحمد صادق مغمور",36,"ر",1,0],["أآذنةٌ عُلْياك لِلْعِيدِ إن دَنَا","على الطّائرِ الميمونِ والطّالَعِ السَّعد",37,"د",1,0],["أَأَذكر إغفالي احتقاراً ونَبذَتي","بعيداً كأني لم أكن أطلب البعدا",38,"د",2,0],["أإذن لي في العود؟","أطال الله مولانا",39,"ن",2,0],["أإِذا تبين جهلهم ذو فطنة","عدوه غياً منه او اجراما",40,"م",2,0],["أأذكر من حين الدخول لآدم","وإلا خروج المصطفى وهو يتبع",41,"ع",1,0],["ااذ منحتُ ثنياتِ اللوى كَتِفى","فابشرْ بألهوبِ نارِ الفتنةِ العرمِ",42,"م",1,0],["أآذنت بغروبٍ شهبها فبدت","صفراً أم الكيمياءُ في يد الساقي",43,"ي",1,0],["أإذا صرت من جفاهم عظاما","أبوصلٍ تعود خلقاً جديدا",44,"د",2,0],["أَأَذكُرُ حاجَتي أَم قَد كَفاني","عَنِ الاِفصاحِ حَدسُكَ وَالذَكاء",45,"ا",2,0],["أَإِذا كُنتُ ذا ضَلالٍ وإِثمِ","تغتدي أَنتَ نائِماً في قَبري",46,"ر",2,0],["أَإِذا اِبتُليتُ وَفي البَلاء هديّةٌ","مِمَّن لِنَيل رِضاه طولُ تشوُّقي",47,"ق",2,0],["أأذنبَ في لونه الأسودُ","فتعذبيه عملٌ يُحمَدُ",48,"د",1,1],["أَأَذِلُّ وَالْقُرآنُ يَرْفَعُني...","فَوْقَ الذي قَدْ حَطَّهُ القَدَرُ؟",49,"ر",1,0],["أَأَذِلُّ واللهُ العَزيزُ مَعِي؟","وَبِهِ أَصولُ لِحَربِ مَنْ وَتَرُوا",49,"ر",3,0],["أ أذوب كالقِنديل في هذا الإناءْ","شَجنًا فلستُ أديرُ هَنْدَسةَ القضاءْ",50,"ا",2,1],["أ أذوب في شفةِ الظلام ولم يبتْ","قمرُ الفُؤاد على فراش من ضِياءْ",50,"ا",2,0],["إإذا نظمت من الكلام رديئه","والمفردات الساقطات الفاجرة",51,"ر",2,0],["إاذا كانت الآمال بالوصل أوهاما","فليس بمجد شبب الصب أو هاما",52,"م",2,1],["أأذعن للدنيا وأشياخ هاشم","نمتني الى المجد المؤثل والفخر",53,"ر",1,0],["أ إذا ولجت بواطني","صرت اللجوج الخائنا ؟",54,"ن",2,0],["أَ إذا مددْتُ يدِي لكيْ تحظَى بِمَا","حَظِيَتْ بهِ كلُّ الأَكُفِّ بلَا شقَا",55,"ق",2,0],["أإذا كبرْنا تنتهي أحلامُنا","ويصيبُ أنفسَنا هوى وضَلالُ؟",56,"ل",1,0],["أأذعتُ سرّا أم تراني ضاحكا","مما مضى من عمرنا وتبدّلا",57,"ل",2,0]]}