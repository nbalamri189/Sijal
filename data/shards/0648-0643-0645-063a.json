{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[3,"كم يبعد الدهر من أرجو أقاربه","https://www.aldiwan.net/poem125.html",""],[86,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[86,"ببابك النحس والسعود","https://www.aldiwan.net/poem68833.html","مخلع البسيط"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[72,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[78,"من للملوك بشأو الأصيد البطل","https://www.aldiwan.net/poem14155.html","البسيط"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[45,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[45,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[28,"أرى ابن سليم ليس تنهض خيله","https://www.aldiwan.net/poem5438.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[46,"إذا عبت عندي غيري اليوم ظالما","https://www.aldiwan.net/poem22176.html","الطويل"],[46,"بحمد الله لم تخلق كعاب","https://www.aldiwan.net/poem22997.html","الوافر"],[46,"لقد صدئت أفهام قوم فهل لها","https://www.aldiwan.net/poem23200.html","الطويل"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[8,"وليست بشوهاء مقبوحة","https://www.aldiwan.net/poem21783.html","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9891","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[46,"إذا عِبتَ، عندي، غيريَ اليوم ظَالماً،","https://www.poetsgate.com/ViewPoem.aspx?id=18011",""],[28,"أرى ابن سليم ليس تنهض خيله","https://www.poetsgate.com/ViewPoem.aspx?id=22011",""],[115,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[132,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[132,"ألما بى على دمن تذوب","https://www.aldiwan.net/poem54887.html","البسيط"],[143,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[150,"ماذا أقول ولا عتب على القدر","https://www.aldiwan.net/poem68476.html","البسيط"],[169,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[169,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[199,"تجنى الخبيب فقالوا غضب","https://www.aldiwan.net/poem45639.html","المتقارب"],[210,"لعلياك في أفق الكمال مطالع","https://www.aldiwan.net/poem13464.html","الطويل"],[235,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[235,"ألا يا ابن الحصين جمعت نفسا","https://www.aldiwan.net/poem32114.html","الوافر"],[235,"عسى الدهر يوما بالبخيلة يسمح","https://www.aldiwan.net/poem32121.html","الطويل"],[275,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[297,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[297,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[297,"أشارت من لها في الحسن شاره","https://www.aldiwan.net/poem33259.html","الوافر"],[304,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[304,"بإحيا علوم الدين تحيا قلوبنا","https://www.aldiwan.net/poem16849.html","الطويل"],[359,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[366,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[371,"أرى جنبات الأرض باسمك ترجف","https://www.aldiwan.net/poem57307.html","الكامل"],[403,"صفي الدين قد وافى النظام","https://www.aldiwan.net/poem33417.html","الوافر"],[403,"وكم غافل غره مادح","https://www.aldiwan.net/poem33766.html","المتقارب"],[406,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[416,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[416,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[470,"رمى أهل نهري بابل إذ أضلهم","https://www.aldiwan.net/poem4739.html","الطويل"],[506,"قل للزنادق عني","https://www.aldiwan.net/poem2394.html","المجتث"],[506,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[515,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[515,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[575,"قالوا قضيب البان قد بانا","https://www.aldiwan.net/poem2840.html","السريع"]],"verses":[["وَكَم غادَرَ البَينُ المُفَرِّقُ مِن فَتىً","يُمَسِّحُ قَلباً دائِمَ الخَفَقانِ",0,"ن",1,0],["وَكَم غَمرَةٍ يَعلو المُلَجَّمَ ماؤُها","شَقَقتَ وَلَو أَنَّ الدِماءَ تَسيلُ",1,"ل",1,0],["وَكَم غارَةٍ أَقبَلتُموها مَواقِراً","مِنَ الأَسَلِ الذيّالِ وَالبيضِ وَالسَردِ",2,"د",1,0],["وكمْ غَمْرَةٍ دونَ الخِلافَةِ خاضَها","بآرائهِ وهْيَ الصّوارِمُ تُنْتَضى",3,"ض",2,0],["وَكَم غَديرٍ مَزَجتُ الماءَ فيهِ دَم","عِندَ الصَباحِ وَراحَ الوَحشُ طالِبُهُ",4,"ب",2,0],["وَكَم غَريقٍ راحَ في لُجَّةٍ","يَهوي بِها الطَودُ فَلا يَظهَرُ",5,"ر",1,0],["وَكَم غَضِبَ الناسُ مِن قَبلِنا","لِسَلبِ الحُقوقِ وَلَم نَغضَبِ",6,"ب",1,0],["وَكَم غَنِيٍّ أَضاعَ مالا","وَشابَ في مَوقِفِ الحِسابِ",7,"ب",1,0],["وكم غُصُنٍ قد عانق الغصنَّ مثله","وكلٌُّ على كلٌّ من الشوق يَسْتَعدي",8,"د",2,0],["وكم غافلٍ يلهو بساقٍ من المنى","يدِيرُ على أمثالهِ وعدَ عرقوب",9,"ب",1,0],["وكم غَضبتْ للحقّ منك سجيةٌ","تؤدّب بالتنكير من لم يُؤدَّبِ",10,"ب",1,0],["وكم غلبتْ غلبَ القُيول هناتُه","ولم تُقْتَبَسْ من قبلِ ذاك ولم تُرَمْ",11,"م",1,0],["وَكَم غايَةٍ مِن دونِها المَوتُ حاسِراً","سَما نَحوَها وَالمَوتُ يَنظُرُ خَسرانُ",12,"ن",1,0],["وَكَم غَدَت عاطِلا حَتّى عَرضتُ لَها","فَأَصبَحت في سُرى الحُلي وَالحُلَلِ",13,"ل",1,0],["وكم غادة كانت تميس بمشيها","كما تعبث الأرواح بالغصن الرطب",14,"ب",1,0],["وكم غاصبٍ مال اليتامى مبكر","لأجل صلاة الصبح يرجو بها الأجرا",15,"ر",2,0],["وَكَم غِرَّةٍ لِلمَجدِ بادَرَ فَوتَها","وَعائِرِ حَمدٍ أَعلَقَتهُ حَبائِلُه",16,"ل",2,0],["وَكَم غَلَّستُ مُدَّلِجاً بِصَحبي","عَلى مُتَعَصفِرِ الناجودِ قانِ",17,"ن",1,0],["وَكَم غارَةٍ بِالرومِ أَصبَحتَ تَبتَغي","بِكَفَّيكَ مِنها فيأَها وَقِتالَها",18,"ل",3,0],["وكم غادةٍ زارَتْ على خوفِ رِقْبَةٍ","ولم يَثْنِها عن زورتي لومُ لائمِ",19,"م",1,0],["وكم غزالةِ إنْسٍ أنْحلَتْ جسدي","بِالهجرِ حَتَّى حَكى ما رقّ من غَزَلِ",20,"ل",1,0],["وكم غادةٍ لا يعرفُ الرئمُ مثلها","رمتني بِسَهْمَيْ مُقلَتَيها على عَمدِ",21,"د",1,0],["وَكَم غَوَّروا في مَورِدٍ وَتَظَمُّؤٍ","عُيونَ رَكيٍّ أَو عُيونَ رَكائِبِ",22,"ب",1,0],["وَكَم غُرَّت مَعاطِسُ مِن رِجالٍ","بِريحِ أُلوَّةٍ أَو ريحِ رَنفِ",23,"ف",1,0],["وَكَم غَرَّتِ الدُنيا بَنيها وَساءَني","مَعَ الناسِ مَينٌ في الأَحاديثِ وَالنَقلِ",24,"ل",1,0],["وَكَم غَيَّبَ الإِلفُ الشَقيقُ أَليفَهُ","فَريعَ لَهُ الأَيّامَ ثُمَّ سَلاهُ",25,"ل",3,0],["وَكَم غائبٍ كانَ يَخشَى الرَدى","فَآبَ وَأَودَى الَّذي في الحَضَر",26,"ر",1,0],["وَكَم غَديرٍ مَزَجتُ الماءَ فيهِ دَماً","عِندَ الصَباحِ وَراحَ الوَحشُ طالِبُهُ",27,"ب",2,0],["وَكَمْ غَزَاةٍ وَكَمْ حَرْبٍ تَجَشَّمَهَا","حَتى يَعُودَ بِتَمْكِينٍ وَتَأْيِيدِ",28,"د",1,0],["وكم غَفَرَ الناسُ ذنبَ القويِّ","وكم ألصَقُوا بالضعيف التُّهَمْ",29,"م",1,0],["وكم غادى ربيعَ الفكرِ فيه","من النَّزَّعاتِ عابرةً خريف",30,"ف",1,0],["وكم غَوّروا، في موردٍ وتظمّىء","عيونَ رَكيٍّ، أوْ عيونَ ركائب",31,"ب",1,0],["وَكَمْ غَارَةٍ بالرّومِ أصْبَحَت تَبتغَي","بِكَفّيْكَ مِنْهَا فَيْئَهَا وَقِتَالَهَا",32,"ل",3,0],["وكم غلب الايام يا نفس صابر","ولم ير صدع الخطب من هو يصبر",33,"ر",1,0],["وكم غيث أَرَبَّ بِهنَّ عاما","راوعده تزمزم باهتزام",34,"م",1,0],["وكَم غَنِيَت بساحِتها فَتَاةٌ","مُهَفهَفَةٌ مُعَمَّةٌ عَرُوبُ",35,"ب",1,0],["وَكَم غَرَّ ظَمآناً سَرابٌ بِقَفرَةٍ","وَخَبَّرَ بَرقٌ بِالحَيا وَهوَ خُلَّبُ",36,"ب",1,0],["وكم غدونا وكم رحنا على طرب","بالصخرتين إلى الصفصاف فالنهر",37,"ر",1,0],["وَكَم غُصَصٍ جُرِّعتُها في هَواكُمُ","وَلَم أُصغِ سَمعاً لِلَّذي جاءَ عاذِلا",38,"ل",2,0],["وَكَم غِنىً عِندَنا قَد جَرَّ داهِيَةً","دَهياءَ تَترُكُ فَحلَ القَومِ عِنِّينا",39,"ن",2,0],["وَكَم غمَرت قَوماً غمارُ هباتهِ","وَنالَت وفودُ العربِ نائلهُ الغمرا",40,"ر",2,0],["وكم غشني حينَ عاملتهُ","فمزْ بينَ فضتهِ والذهبْ",41,"ب",1,0],["وكم غادرت فوق الثرى من معفر","طريح عليه طائر النسر واقع",42,"ع",1,0],["وَكَم غارَةٍ شَعواءَ ضَرَّمَ نارَها","بِكُلِّ أَشَّمِ المَنكِبَينِ ضُبارِمِ",43,"م",1,0],["وَكَم غادَرتَ بِالوُزَراءِ لَمّا","نَوَيتَ الغَدرَ مِن قَلبٍ قَريحِ",44,"ح",1,0],["وَكَم غادَرَت بِالجِزعِ قَلباً بِذِكرِها","جَزوعاً وَعَيناً في ذُرى السَفحِ تَسفَحُ",45,"ح",1,0],["وَكَم غَشِيَ الوَغى ولَه زَئيرٌ","فبُدِّلَ بالزّفيرِ من الزَئيرِ",46,"ر",1,0],["وكم غَدَت أمنيّه","جالِبَةً مَنيَّه",47,"ه",1,0],["وَكَم غابِطٍ نُعماك لجَّ بجهله","ضلالاً وقد أَوردته من جِمامها",48,"م",3,0],["وَكَم غزا لِلعِدى جَمعاً فقسَّمه","فالزَوجُ للأيمِ والمَولودُ لليُتمِ",49,"م",1,0],["وَكم غرَّت بماضي مُقلتَيها","مُعَنّىً حكَّمت فيه غِرارَه",50,"ر",2,0],["وكم غير هذا والجميع مسبح","لخالقه سبحان رب البرية",51,"ه",1,0],["وكم غيره من عارف ومحقق","وحبر عليم والإله حسيبنا",52,"ن",2,0],["وكم غزوةٍ منا أتتهم فُجاءةً","على واديِ الجرد قد حمدوا المسرا",53,"ر",2,0],["وَكَم غالَطتُ فيهِ الحَقيقَةَ","وَالحَقُّ أَبلَجُ لا تَخفى لَهُ غُرَرُ",54,"ر",1,0],["وكَم غمةٍ لَو لَم تكُن لم يكُن لَها","سِواكَ ولا كانَت لغَيرِكَ تُكشَفُ",55,"ف",1,0],["وكم غمر يريد علا سواها","وهل يعلو على الشمس الرغام",56,"م",1,0],["وكم غافلِ غره مادح","بخطبه راقياً مِنْبَرا",57,"ر",2,1],["وَكَم غادِرٍ قَد شَبَّ نارَ عَداوَةٍ","لَهُ فدحاه كَيدَهُ في ضِرامِهِ",58,"م",2,0],["وكم غادةٍ في ليالي الوصال","جَمَعْتُ مع القُرط خِلخالها",59,"ل",3,0],["وكم غرَّ ظمآناً سرابٌ بقيعَةٍ","وأغناه طيفٌ في الكرى وهو زائل",60,"ل",1,0],["وكم غصنٍ هصرتُ بها رطيباً","جَنيّ الزهر مخضرّ الأَديم",61,"م",1,0],["وكم غرت من قوم ولي في بيوتكم","غرائب أبكارٌ تُزَفُّ وعُونُ",62,"ن",1,0],["وكم غضبتُ ثم عد","تُ أستميح الصُّلحا",63,"ح",2,0],["وكم غمزةٍ في جانبي لم أقل لها","أَلمِتِ وجُرحي لو شكوتُ رغيبُ",64,"ب",1,0],["وَكَم غادَرَت أَسيافُهُم مِن مُنافِقٍ","يَمُجُّ دَماً أَوداجُه وَالأخادِعُ",65,"ع",1,0],["وكم غَليل فؤاد","بصحة القول يَشفيه",66,"ي",2,0],["وكم غرٍ ببذلِ المال غَرُّوا","فكانَ على الحُطَام له انحِطام",67,"م",1,0],["وكم غره منها سراب بقيعة","تصدقه العينان وهو كذوب",68,"ب",1,0],["وكم غارة مسودة النقع أسفرت","وقائعه فيها عن العز والنصر",69,"ر",1,0],["وكم غمة لولا أبو النجم أصبحت","قذى في عيون أو شجاً في حلاقم",70,"م",1,0],["وكم غُرّ الرّجالُ فجرّبوني","فلم أكُ في تجاربهمْ غبينا",71,"ن",2,0],["وكم غدت شمسُ الضُّحى لي بها","ضجيعةً والبدرُ نُدْمانا",72,"ن",2,0]]}