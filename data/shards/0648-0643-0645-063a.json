5,"أتاني نعي فاستطار فؤاديا","https://www.poetsgate.com/ViewPoem.aspx?id=171982",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5873,"السعادة المسبية","https://www.poetsgate.com/ViewPoem.aspx?id=215416",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[6031,"مررت بكربلاء فهاج وجدي","https://www.poetsgate.com/ViewPoem.aspx?id=46419",""],[6093,"إذا شيبٌ بدا ليَ ذاك وفدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176440",""],[6093,"يظن بنا الناس ما يشتهون","https://www.poetsgate.com/ViewPoem.aspx?id=204473",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""],[5309,"قضيت العمر في سكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573569",""],[6167,"تلك القمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85544&r=&rc=27",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[5190,"شَهد وسُهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85035&r=&rc=110",""]],"verses":[["وَكَم غادَرَ البَينُ المُفَرِّقُ مِن فَتىً","يُمَسِّحُ قَلباً دائِمَ الخَفَقانِ",0,"ن",1,0],["وَكَم غَمرَةٍ يَعلو المُلَجَّمَ ماؤُها","شَقَقتَ وَلَو أَنَّ الدِماءَ تَسيلُ",1,"ل",1,0],["وَكَم غارَةٍ أَقبَلتُموها مَواقِراً","مِنَ الأَسَلِ الذيّالِ وَالبيضِ وَالسَردِ",2,"د",1,0],["وكمْ غَمْرَةٍ دونَ الخِلافَةِ خاضَها","بآرائهِ وهْيَ الصّوارِمُ تُنْتَضى",3,"ض",2,0],["وَكَم غَديرٍ مَزَجتُ الماءَ فيهِ دَم","عِندَ الصَباحِ وَراحَ الوَحشُ طالِبُهُ",4,"ب",2,0],["وَكَم غَريقٍ راحَ في لُجَّةٍ","يَهوي بِها الطَودُ فَلا يَظهَرُ",5,"ر",1,0],["وَكَم غَضِبَ الناسُ مِن قَبلِنا","لِسَلبِ الحُقوقِ وَلَم نَغضَبِ",6,"ب",1,0],["وَكَم غَنِيٍّ أَضاعَ مالا","وَشابَ في مَوقِفِ الحِسابِ",7,"ب",1,0],["وكم غُصُنٍ قد عانق الغصنَّ مثله","وكلٌُّ على كلٌّ من الشوق يَسْتَعدي",8,"د",2,0],["وكم غافلٍ يلهو بساقٍ من المنى","يدِيرُ على أمثالهِ وعدَ عرقوب",9,"ب",1,0],["وكم غَضبتْ للحقّ منك سجيةٌ","تؤدّب بالتنكير من لم يُؤدَّبِ",10,"ب",1,0],["وكم غلبتْ غلبَ القُيول هناتُه","ولم تُقْتَبَسْ من قبلِ ذاك ولم تُرَمْ",11,"م",1,0],["وَكَم غايَةٍ مِن دونِها المَوتُ حاسِراً","سَما نَحوَها وَالمَوتُ يَنظُرُ خَسرانُ",12,"ن",1,0],["وَكَم غَدَت عاطِلا حَتّى عَرضتُ لَها","فَأَصبَحت في سُرى الحُلي وَالحُلَلِ",13,"ل",1,0],["وكم غادة كانت تميس بمشيها","كما تعبث الأرواح بالغصن الرطب",14,"ب",1,0],["وكم غاصبٍ مال اليتامى مبكر","لأجل صلاة الصبح يرجو بها الأجرا",15,"ر",2,0],["وَكَم غِرَّةٍ لِلمَجدِ بادَرَ فَوتَها","وَعائِرِ حَمدٍ أَعلَقَتهُ حَبائِلُه",16,"ل",2,0],["وَكَم غَلَّستُ مُدَّلِجاً بِصَحبي","عَلى مُتَعَصفِرِ الناجودِ قانِ",17,"ن",1,0],["وَكَم غارَةٍ بِالرومِ أَصبَحتَ تَبتَغي","بِكَفَّيكَ مِنها فيأَها وَقِتالَها",18,"ل",3,0],["وكم غادةٍ زارَتْ على خوفِ رِقْبَةٍ","ولم يَثْنِها عن زورتي لومُ لائمِ",19,"م",1,0],["وكم غزالةِ إنْسٍ أنْحلَتْ جسدي","بِالهجرِ حَتَّى حَكى ما رقّ من غَزَلِ",20,"ل",1,0],["وكم غادةٍ لا يعرفُ الرئمُ مثلها","رمتني بِسَهْمَيْ مُقلَتَيها على عَمدِ",21,"د",1,0],["وَكَم غَوَّروا في مَورِدٍ وَتَظَمُّؤٍ","عُيونَ رَكيٍّ أَو عُيونَ رَكائِبِ",22,"ب",1,0],["وَكَم غُرَّت مَعاطِسُ مِن رِجالٍ","بِريحِ أُلوَّةٍ أَو ريحِ رَنفِ",23,"ف",1,0],["وَكَم غَرَّتِ الدُنيا بَنيها وَساءَني","مَعَ الناسِ مَينٌ في الأَحاديثِ وَالنَقلِ",24,"ل",1,0],["وَكَم غَيَّبَ الإِلفُ الشَقيقُ أَليفَهُ","فَريعَ لَهُ الأَيّامَ ثُمَّ سَلاهُ",25,"ل",3,0],["وَكَم غائبٍ كانَ يَخشَى الرَدى","فَآبَ وَأَودَى الَّذي في الحَضَر",26,"ر",1,0],["وَكَم غَديرٍ مَزَجتُ الماءَ فيهِ دَماً","عِندَ الصَباحِ وَراحَ الوَحشُ طالِبُهُ",27,"ب",2,0],["وَكَمْ غَزَاةٍ وَكَمْ حَرْبٍ تَجَشَّمَهَا","حَتى يَعُودَ بِتَمْكِينٍ وَتَأْيِيدِ",28,"د",1,0],["وكم غَفَرَ الناسُ ذنبَ القويِّ","وكم ألصَقُوا بالضعيف التُّهَمْ",29,"م",1,0],["وكم غادى ربيعَ الفكرِ فيه","من النَّزَّعاتِ عابرةً خريف",30,"ف",1,0],["وكم غَوّروا، في موردٍ وتظمّىء","عيونَ رَكيٍّ، أوْ عيونَ ركائب",31,"ب",1,0],["وَكَمْ غَارَةٍ بالرّومِ أصْبَحَت تَبتغَي","بِكَفّيْكَ مِنْهَا فَيْئَهَا وَقِتَالَهَا",32,"ل",3,0],["وكم غلب الايام يا نفس صابر","ولم ير صدع الخطب من هو يصبر",33,"ر",1,0],["وكم غيث أَرَبَّ بِهنَّ عاما","راوعده تزمزم باهتزام",34,"م",1,0],["وكَم غَنِيَت بساحِتها فَتَاةٌ","مُهَفهَفَةٌ مُعَمَّةٌ عَرُوبُ",35,"ب",1,0],["وَكَم غَرَّ ظَمآناً سَرابٌ بِقَفرَةٍ","وَخَبَّرَ بَرقٌ بِالحَيا وَهوَ خُلَّبُ",36,"ب",1,0],["وكم غدونا وكم رحنا على طرب","بالصخرتين إلى الصفصاف فالنهر",37,"ر",1,0],["وَكَم غُصَصٍ جُرِّعتُها في هَواكُمُ","وَلَم أُصغِ سَمعاً لِلَّذي جاءَ عاذِلا",38,"ل",2,0],["وَكَم غِنىً عِندَنا قَد جَرَّ داهِيَةً","دَهياءَ تَترُكُ فَحلَ القَومِ عِنِّينا",39,"ن",2,0],["وَكَم غمَرت قَوماً غمارُ هباتهِ","وَنالَت وفودُ العربِ نائلهُ الغمرا",40,"ر",2,0],["وكم غشني حينَ عاملتهُ","فمزْ بينَ فضتهِ والذهبْ",41,"ب",1,0],["وكم غادرت فوق الثرى من معفر","طريح عليه طائر النسر واقع",42,"ع",1,0],["وَكَم غارَةٍ شَعواءَ ضَرَّمَ نارَها","بِكُلِّ أَشَّمِ المَنكِبَينِ ضُبارِمِ",43,"م",1,0],["وَكَم غادَرتَ بِالوُزَراءِ لَمّا","نَوَيتَ الغَدرَ مِن قَلبٍ قَريحِ",44,"ح",1,0],["وَكَم غادَرَت بِالجِزعِ قَلباً بِذِكرِها","جَزوعاً وَعَيناً في ذُرى السَفحِ تَسفَحُ",45,"ح",1,0],["وَكَم غَشِيَ الوَغى ولَه زَئيرٌ","فبُدِّلَ بالزّفيرِ من الزَئيرِ",46,"ر",1,0],["وكم غَدَت أمنيّه","جالِبَةً مَنيَّه",47,"ه",1,0],["وَكَم غابِطٍ نُعماك لجَّ بجهله","ضلالاً وقد أَوردته من جِمامها",48,"م",3,0],["وَكَم غزا لِلعِدى جَمعاً فقسَّمه","فالزَوجُ للأيمِ والمَولودُ لليُتمِ",49,"م",1,0],["وَكم غرَّت بماضي مُقلتَيها","مُعَنّىً حكَّمت فيه غِرارَه",50,"ر",2,0],["وكم غير هذا والجميع مسبح","لخالقه سبحان رب البرية",51,"ه",1,0],["وكم غيره من عارف ومحقق","وحبر عليم والإله حسيبنا",52,"ن",2,0],["وكم غزوةٍ منا أتتهم فُجاءةً","على واديِ الجرد قد حمدوا المسرا",53,"ر",2,0],["وَكَم غالَطتُ فيهِ الحَقيقَةَ","وَالحَقُّ أَبلَجُ لا تَخفى لَهُ غُرَرُ",54,"ر",1,0],["وكَم غمةٍ لَو لَم تكُن لم يكُن لَها","سِواكَ ولا كانَت لغَيرِكَ تُكشَفُ",55,"ف",1,0],["وكم غمر يريد علا سواها","وهل يعلو على الشمس الرغام",56,"م",1,0],["وكم غافلِ غره مادح","بخطبه راقياً مِنْبَرا",57,"ر",2,1],["وَكَم غادِرٍ قَد شَبَّ نارَ عَداوَةٍ","لَهُ فدحاه كَيدَهُ في ضِرامِهِ",58,"م",2,0],["وكم غادةٍ في ليالي الوصال","جَمَعْتُ مع القُرط خِلخالها",59,"ل",3,0],["وكم غرَّ ظمآناً سرابٌ بقيعَةٍ","وأغناه طيفٌ في الكرى وهو زائل",60,"ل",1,0],["وكم غصنٍ هصرتُ بها رطيباً","جَنيّ الزهر مخضرّ الأَديم",61,"م",1,0],["وكم غرت من قوم ولي في بيوتكم","غرائب أبكارٌ تُزَفُّ وعُونُ",62,"ن",1,0],["وكم غضبتُ ثم عد","تُ أستميح الصُّلحا",63,"ح",2,0],["وكم غمزةٍ في جانبي لم أقل لها","أَلمِتِ وجُرحي لو شكوتُ رغيبُ",64,"ب",1,0],["وَكَم غادَرَت أَسيافُهُم مِن مُنافِقٍ","يَمُجُّ دَماً أَوداجُه وَالأخادِعُ",65,"ع",1,0],["وكم غَليل فؤاد","بصحة القول يَشفيه",66,"ي",2,0],["وكم غرٍ ببذلِ المال غَرُّوا","فكانَ على الحُطَام له انحِطام",67,"م",1,0],["وكم غره منها سراب بقيعة","تصدقه العينان وهو كذوب",68,"ب",1,0],["وكم غارة مسودة النقع أسفرت","وقائعه فيها عن العز والنصر",69,"ر",1,0],["وكم غمة لولا أبو النجم أصبحت","قذى في عيون أو شجاً في حلاقم",70,"م",1,0],["وكم غُرّ الرّجالُ فجرّبوني","فلم أكُ في تجاربهمْ غبينا",71,"ن",2,0],["وكم غدت شمسُ الضُّحى لي بها","ضجيعةً والبدرُ نُدْمانا",72,"ن",2,0],["وكم غدا رافئاً ما الغير مزقه","وملبسا كل فعل ثوب اتقان",73,"ن",1,0],["وكم غمرةٍ خاضوا على إِثر غمرةٍ","ولم يحفلوا يوماً بمدٍ ولا جزر",74,"ر",1,0],["وكم غادرتِ من طَرْفٍ كليلٍ","وكم غادرتِ من طَرْفٍ غضيض",75,"ض",1,0],["وَكَم غَزا في العِدا الجَزّارُ مُحتَسِباً","بِالمالِ وَالنّفسِ لا يَثنيه تَهويلُ",76,"ل",1,0],["وَكَم غَنِموا مِنّا حِساناً كَواعِباً","وَغُزلانَ درّ في المَقاصير تُقصَرُ",77,"ر",1,0],["وكم غزال رامه مفلس","لكنه عن نيله قاصر",78,"ر",1,0],["وكم غدرت من سبا","كأس السلاف المضرم",79,"م",1,0],["وكم غدوت لوجه البسط مجتليا","كما سعيت لزهر الأنس مقتطفا",80,"ف",2,0],["وكم غدوت لعطف الله معتنقا","كما ظللت لثغر الزهر ملتثما",81,"م",2,0],["وَكَم غائبٍ تحتَ الترابِ وشخصه","لَهُ بينَ أحشاء مقامٌ ومربعُ",82,"ع",1,0],["وكم غادرتهم في الجو يدووا","وكم أخفيت منهم في الشعايبْ",83,"ب",1,0],["وَكَم غَشومٍ شَديدِ البَطشِ ذي جَنَفٍ","بِالكِبرِ مُشتَمِلٍ بِالتِّيهِ مُؤتَزِرِ",84,"ر",1,0],["وكَمْ غِرٍّ سِواكَ عَصَيْتُ حَتّى","تُوَجَّهَ بِالْمَلامِ إلى سَوائي",85,"ي",1,0],["وَكَم غَرَّد القُمريُّ في خَوط أَيكَةٍ","فَجاوَبتُ ذيّاك الحَمامَ المُغَرِّدا",86,"د",2,0],["وكم غصن بأرضك جف غضاً","يفدى بالنفوس معروق الفطام",87,"م",1,0],["وكم غدرة جاءت بها وشنائع","أتتها وعصيان عليه استمرت",88,"ت",1,0],["وكم غلبت بدار الاسر متخذا","نوائب الدهر اجنادا وسجانا",89,"ن",2,0],["وكم غرّ من متخم ممعص","وفور اللذاذة في سرطه",90,"ط",2,0],["وكم غُلَّةٍ في الصَّدْرِ من حُبِّ مُعْرضٍ","عَرَضت لها بالصَّبْر حتَّى اضْمَحلَّتِ",91,"ت",1,0],["وكم غاص بالفكر الوري زناده","فجمع أزهار المعاني وقطّفا",92,"ف",2,0],["وَكَم غَضِبتُ فَما بِاليُتم غَضَبي","حَتّى رَجَعتُ بِقَلب ساخِط راضِ",93,"ض",1,0],["وكم غّنى الهزاز بها فصمّت","وتُولي السمعَ والبصرَ الغُرابا",94,"ب",2,0],["وَكَم غَرَّت بِزبرجِها قُرونا","فَما أَبقَت وَلا بَقَتِ القُرونُ",95,"ن",1,0],["وكم غَدْوَةٍ لي في رِضَاكَ ورَوَحَةٍ","على مَنْهَجٍ من سُنَّةِ البِرِّ لازب",96,"ب",1,0],["وكم غالَ نفساً غالب الدهرَ ربُّها","وحلَّ بقلبٍ ثابتٍ فتصدَّعا",97,"ع",2,0],["وكم غادروا من غادة قمريّة","تباهي ضياء الزبر قان إذا بدر",98,"ر",1,0],["وَكَم غادَةٍ حَسناءَ تَبكي خَطيبَها","وَكَم مِن رَضيعٍ عَضَّهُ البُؤسُ وَاليُتمُ",99,"م",1,0],["وكَمْ غَادَةٍ تُلقى لِظَاهِرِ طِمرِهَا","وتَلعَبُ بِالألبَابِ إنْ رُفِعَ الطِّمرُ",100,"ر",1,0],["وكَم غُربَةٍ في غَيرِ حَقٍّ قَطَعتُها","فَهَلا لِذات اللَهِ كانَ تَغَرُّبي",101,"ب",2,0],["وَكَم غُمَّةٍ قَد فَرَّجوها بِهِمَّةٍ","بِها قَبلَ مَسعاهُم عُيونُ الهدى رُمدُ",102,"د",1,0],["وَكَم غادَرتُمُ بَطَلاً كَمِيّاً","لَدى الهَيجاءِ كانَ لَهُ غَناءُ",103,"ا",2,0],["وَكَم غُصنٍ قَد اِرتَسَمَت حُلاهُ","عَلَيهِ يَهُزُّهُ رَوحُ الشَمالِ",104,"ل",1,0],["وكم غادة حنت اليه وقلبها","المعذب من وجد يذوب على الجمر",105,"ر",1,0],["وَكَم غَريقٍ سابِحٍ","كانَ مَتينَ الجَلَدِ",106,"د",1,0],["وكم غرني تحسين ظني به فلم","يضيء لي على طوال اقتداحي لزنده",107,"د",2,0],["وكم غادَرَتْ لَمَهَبِّ الرياحِ","سنا جَسَدٍ شَرِقٍ بالجِسادِ",108,"د",1,0],["وكم غرة في جبهة الكون أسفرت","بإحسانه عن وجه عز وسؤدد",109,"د",1,0],["وَكَم غَدا حيثما سلت صَوارمها","أَعدى الأَعادي إِلَيها ملقي السلم",110,"م",1,0],["وكم غزا جيش الجهالات علمه","فاصبح شمل الجهل منه مبددا",111,"د",2,0],["وَكَم غرة ماجَت بِأَمواج غرةٍ","تَجَرعتها بِالصَّبرِ حَتَّى تَجَلَّت",112,"ت",1,0],["وكم غدا لي نديماً والمدامة من","فيه وفيه عذولي ليس يرتدع",113,"ع",1,0],["وكم غنى أعقبه فقرٌ وكم","من ملكٍ عن ملكه قد خلعا",114,"ع",2,0],["وكم غدوت إذا أبصرت غصن نقاً","أنسى الهمومَ كأن الهم ما كانا",115,"ن",2,0],["وَكَم غَزالٍ عَلى يَدَيكِ نَجا","مِن دَقِّ خُصيَيهِ بِالطَواميرِ",116,"ر",1,0],["وَكم غرّة بَيضاء وَالدَهرُ أَبيضٌ","يَبينُ لَدى سودِ اللَيالي سَوادها",117,"د",3,0],["وَكَم غنمتُ بها صَفواً وَكَم بلغت","لي همّةٌ بعذولٍ ليس تَكتَرث",118,"ث",1,0],["وَكم غِواية عيشٍ بتَّ تَأملُها","ثم انجلت فَكأن الأَمرَ لَم يَطل",119,"ل",1,0],["وَكَم غادةٍ غَنّت عَلَيها وَأَقبلت","فَطافَت عَلى الأَقيالِ من عهد آدم",120,"م",1,0],["وكم غيرها من غمة كان عضبه","مبدد غماها وجالي قتامها",121,"م",3,0],["وكم غوان لها غناء","في راكع في الحمى وساجد",122,"د",1,0],["وكم غارة شعواء شن على العدى","وكم فارس منهم نعته حلائله",123,"ل",2,0],["وكم غارة شعوا شنوا على العدى","وكم طارف منهم حووه ومتلد",124,"د",1,0],["وكم غمرةٍ قد حفها الكرب خضتها","وعزمك لا يلوى ولا يتزعزع",125,"ع",1,0],["وكم غادة من ذوات الجمال","سريرتها الثلج أو انصع",126,"ع",1,0],["وكم غَداةَ اللَّقا","من طفلةٍ غفلهْ",127,"ل",2,1],["وَكمْ غادرْتُ من نجد جوادٍ","طَعاماً للفَراعلِ والذئابِ",128,"ب",1,0],["وكم غارة أردفتها إثر غارة","مواقف فيها رابط الجاش مرعب",129,"ب",1,0],["وَكَم غَدا يَسلُبُها جاهِداً","مَن كانَ بِالنَّفسِ يَفديها",130,"ي",3,0],["وَكَم غارَة شَعواء شَن بِضِدِّهِ","وَبِالحَزمِ في إِقدامِهِ يَتَترس",131,"س",1,0],["وكم غالهم من صرفه بطوارق","لو أن برضوى بعضها انهد جانبه",132,"ب",2,0],["وكم غزال كحيل الطرف ذي غنج","مهفهف القد في أرجائها سنحا",133,"ح",2,0],["وكم غلبت علىّ وغلبت لى","رجاء مابرحت به جريا",134,"ي",2,0],["وكم غَنيٍّ سنيٍّ بات مفتقراً","قد فرَّ حظٌّ لهُ والحظُّ فرّارُ",135,"ر",1,0],["وكمْ غدا شافعاً نعمى بثانيةٍ","وكم إلى نفسه في مُعتفٍ شفعا",136,"ع",2,0],["وَكَم غَذا مشن مُعتَفِي عَوارِفٍ","وَمُعتَفى مَعارِفٍ بِما غَذا",137,"ا",1,0],["وكَم غُصونِ على الأحداقٍ قد بسقت","تخَتالُ تحتَ نُهودِ الغيدِ في ثَمَر",138,"ر",1,0],["وَكَم غَرَّني الغَرَّارُّ من صُبحِ وَجهِها","وَلم أَدرِ أَنَّ اللَّيلَ راحَ خِمارَها",139,"ر",3,0],["وكم غَلبت من كيس ذي تفرسٍ","كما افترست بالسُكر مهجة أغلب",140,"ب",1,0],["وكم غنيت حين تنكبتني","مني شيطانها أبداً مريد",141,"د",1,0],["وكم غلَّلت من بطلٍ همامٍ","بدون الحرب اضحى في حبالك",142,"ك",1,0],["وكم غرقت في ذا اللج قوماً","فباتوا مغمرين بسو وبالك",142,"ك",1,0],["وكم غادةٍ حَسْنَا بأعلى قِبَابها","سبَاها لئيمٌ بعد إغلاقِ بابها",143,"ب",3,0],["وكم غمرة خضنا إليه وإنما","يخوض عباب البحر من يطلب الدرَّا",144,"ر",2,0],["وكم غدوت عن مهمِّ عنَّ لي","مستفهما به ولم ينفصل",145,"ل",1,0],["وكَم غايِبٍ رَدَّه عَلى اهلَه مِنْ السِّفَر","وكَم ضِيعِةٍ تَتلِف ويَسَّر أوالها",146,"ل",3,0],["وكم غنموا من راية ومدافع","وخيل وآلات ومال وانفال",147,"ل",1,0],["وكم غدرت بهم إذ غادرتهم","شتاتا في فوادحها الخطوب",148,"ب",1,0],["وكم غزا قوماً ببتاره","فما نجوا بالصارم الباترِ",149,"ر",1,0],["وكم غلا في العجب حتى أَبَى","قياسَنا الغصنَ إلى قدّه",150,"د",2,0],["وكم غيرهم ما ودّهم يرحموني","ما فارقوا ظِلّك ولمعة حريرك",151,"ك",1,0],["وكم غوامض أسرارٍ ومعجزةٍ","وكم فتوحٍ به خصَّت وكم حكم",152,"م",1,0],["وكَم غَفَونا ومَدُّ الضَّمِّ يَحمِلُنا","إلى شواطئ حُلمٍ ساحرِ الصُّوَرِ",153,"ر",1,0],["وَكَمْ غَمْرَةٍ يَلْقَى وَكَمْ غَصَّةٍ يَرَى","عَلَى الرَّغمِ مَنْ كَانَ الزَّمَانُ لَهُ حَرْبَا",154,"ب",2,0],["وكم غنيت للأشواق لحنا .","طيور العشق تصدح في سماكا",155,"ك",2,0],["وَكَمْ غَفَا الطَّلُّ في أحْضانِ زَنبَقَةٍ","ثَكْلى تُناجيكَ في مَوَّالِها العَبِقِ",156,"ق",1,0],["وكم غارة شعواء فيها كتائبا","أعدت لتلقانا بها وسلاهبا",157,"ب",2,0],["وكم غزوت بجيش الرعب من ملك","ولم تسل حساما أو تثر رهجا",158,"ج",2,0],["وكم غرض أغرقت بالنزع نحوه","أصبت وقد تخطي الرماة المراميا",159,"ي",2,0],["وكم غرسنا بإخوانٍ خناجرَنا","وخصمُنا مترعٌ من ريِّ أنهار",160,"ر",1,0],["وكم غيم أشوفه بارقه بالسما لاح","يقبل ويقفي ماروى منه وارق",161,"ق",1,0],["وكم غيث اشوفه مالمع ضي بارقه","واروى دماديم ارتوت منه شاربه",162,"ب",2,0],["وكم غيم اخايل بارقه حين مابرق","ولاشفت سيل اقراه يرخي ذوايبه",162,"ب",2,0],["وَكَمْ غائِبٍ تَحْتَ التُّرابِ وَشَخْصُهُ","لَهُ بَيْنَ أَحْشائِي مُقامُ وَمَرْبَعُ",163,"ع",1,0],["وَكَمْ غَدا طَرْفُها الفَتَّانُ فاتِرُهُ","يُسَطِّرُ الحُبَّ فِي قَلْبِي وَكَمْ رَسَما",164,"م",2,0],["وَكَمْ غازَلْتُ غِزْلَتَها","قَرِيضاً كانَ أَوْ خُطَبا",165,"ب",2,0],["وكم غمرته أنفاس الخزامى","قد امتزجت بدمع ندي هتون",166,"ن",1,0],["وكم غزا القلب من يأسٍ ومن أملٍ","عند المسير الذي تذكيه غاياتُ",167,"ت",1,0],["وكم غمرة خضنا إليه وإنما","يخوض العباب الماء من يطلب الدرا",168,"ر",2,0],["وكم غصنٍ بارضك جب غضا","يفدى بالنفوسِ من الكرام",169,"م",1,0],["وكَمْ غرَّتْ حَياةُ الزَّيفِ قوماً","فبَعدَ الخَزِّ قد لبِسُوا الغُبارَا",170,"ر",2,0],["وكم غالطَ الشعرُ حاليْ الذي","تَراني عليهِ المَدى سائِرَا",171,"ر",2,0],["وَكَمْ غَفَوتُ عَلَى تِلْكَ النُّهُودِ وَمَا","عَلِمتُ إِنِّي بِسَهْلٍ كُنتُ أَم جَبَلِ",172,"ل",1,0],["وَكَم غَنَّى بِها قَبلي","مِفَنٌ هامَ بِالسِّحرِ",173,"ر",1,0],["وكم غَرَّدتْ للحياةِ طُيورٌ","وكم غازَلَتْها طُيُوفٌ وَكَمْ",174,"م",1,0],["وَكَمْ غَيْظَةٍ قَدْ نُمْْتُ فِيْ ظِلِّ دَوْحِهَا","غَدَى دَوُحُهَا تَحْتَ الْقَوَاطِعِ يُحْطَبُ",175,"ب",1,0],["وكم غَرَقْتُ بِعَينٍ ، دَمعُها عَسَلٌ","لَو لامَسَ الشَّوكَ رَقَّ الشَّوكُ واْخضَلاّ",176,"ل",2,0]]}