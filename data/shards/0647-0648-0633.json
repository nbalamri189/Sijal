ي","هجر الديارَ فغيمتْ سُحبُ",109,"ب",1,0],["هو سيد الثقلين جاء بنوره","يقصي ظلاما دامسا وغيوما",110,"م",2,0],["هو سر بعثتك الذي","كانت به الأقدار حبلى",111,"ل",2,0],["هو سرُ أسرار الوجود مخلدٌ","ومشعشعٌ من ذاته وفريدُ",112,"د",1,0],["هوس ابتلاع أناته متلبسا","بذنوبه قطع الطريق منغّصه !",113,"ص",2,0],["هو سحرٌ هو ابتكارُ خيالٍ","لو تراءى يرى الفؤاد جنانه",114,"ن",2,0],["هو سباني يا ( بدر) سنه","غض واطرافه مواثيجه",115,"ج",2,0],["هو سيّدُ الخَلق الذي من حُسنه","تتفاخرُ الأخلاقُ والأوصافُ",116,"ف",1,0],["هُوَسيِّد الثَّقَليْنِ ليسَ كَمِثلهِ","بَشرٌ ، شَهَادةُ واِمقٍ بهِ قَدْ صَفَا",117,"ف",2,0],["هو سلطاننا على السلم أعلا","حكمه راسخاً بما أرساها",118,"ا",3,0],["هوَ سمفونيّةٌ حالمة ٌ","تحْفة ٌ مِنْ صُنْعِ روح ٍ مُبْدِعَةْ",119,"ع",2,0],["هو سيد للعالمين وقدوة","من كفه نبع الزلال سواقيا",120,"ي",2,0],["هو سبه الجرح وايضاً هو بعد طبه","قلبي له ولاهويت بدنيتي ثاني",121,"ن",2,0],["هو سبب بلواه شوقٍ لي .. يحن","أو ذكرني فخاف لومي والعتاب",122,"ب",1,0],["هو ساحرٌ والقلبُ فيهِ بهاؤهُ","يبقى يراقص في قصيدي حالها",123,"ل",3,0],["هو سيمفونياتٌ وبحرٌ هائج","وزنابقُ الآذان منها تطربُ",124,"ب",1,0],["هو سابقٌ أسطورةَ \"العنقاءِ\"","بالنفعِ للإنسانِ، لا الإيذاءِ",125,"ا",2,0],["هو سليل المجد قيدومٍ ممجَّد","من سلالةْ قوم وافين المعاني",126,"ن",2,0],["هو سيدٌ هو قائدٌ هو جنَّةٌ","قدْ حَرَّرَ الإنسانَ والألبابا",127,"ب",2,0],["هُوَ سَادسُ الخُلفاءِ دونَ مُدافعٍ","وتراه في حُلَلِ الصلاح كَمِيلا",128,"ل",2,0],["هو سيد العظماء ما من سيدٍ","إلا له يعنو بكل وقارِ",129,"ر",1,0],["هو سيف النبي فيه عيون ال","كفر أفقاً وناظر الشرك أقذى",130,"ذ",2,0],["هو سيدُ الرُسِل الكرام وختمهم","من جاء للخُلق الرفيع مُتمما",131,"م",2,0],["هوَ سيّدٌ والسَّيدونَ مفاخرٌ","والخالدون يُحطِّمون اللاء",132,"ا",2,0],["هو ساطعٌ كسرور أحمدَ كلما قدِم الوفودْ","هو ضاحكٌ رغم اليهودِ..وكلِّ أذنابِ اليهودْ",133,"د",1,0],["هُوَ سَلَّمَ الأقصى لأنجاس الدُّنا","كي يعبثوا بوقارِهِ وبِطُهْرِهِ",134,"ر",2,0]]}