{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[53,"هو سيف دولتنا الذي يوم الوغى","https://www.aldiwan.net/poem30615.html","الكامل"],[71,"إن سلطاننا الذي نرتجيه","https://www.aldiwan.net/poem3727.html","الخفيف"],[52,"قد حما غصن النقا أسده","https://www.aldiwan.net/poem27110.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85687","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[106,"الطبيب إمام","https://www.poetsgate.com/ViewPoem.aspx?id=179382",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[113,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[113,"أواه من ألم الفراق لأنه","https://www.aldiwan.net/poem42152.html","الكامل"],[126,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[187,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[187,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[187,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[229,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[269,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[280,"أومض البرق بعلياء منين","https://www.aldiwan.net/poem32401.html","الرمل"],[302,"أهلا وسهلا بالحبيب الواصل","https://www.aldiwan.net/poem16820.html","الكامل"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[326,"فيك معنى من المعاني بعيد","https://www.aldiwan.net/poem54991.html","الخفيف"],[429,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[429,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[434,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[438,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[549,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[549,"زرت هندا ومن ظلام قميصي","https://www.aldiwan.net/poem48109.html","الطويل"],[556,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["هُوَ سُؤلي إِن أَسعَدَ اللَهُ جَدّي","وَمَعالي الأُمورِ لِلذِمرِ سولُ",0,"ل",1,0],["هُوَ سَيفُ دَولَتِنا الَّذي يَومَ الوَغى","يَفري قُلوبَ عُداتِهِ بِفِرِندِهِ",1,"د",2,1],["هُوَ سَيفٌ كَما يُقالُ وَلكِن","قاطِعٌ لِلرُّسومِ وَالأَرزاقِ",2,"ق",1,0],["هُوَ سُقمي حينَ أَفقِدُه","وَشِفاءُ السُقمِ لَو أَجِدُه",3,"د",2,0],["هُوَ سعلاة إذا ما","أَظلم اللَيل وغولُ",4,"ل",1,0],["هو سحرُ مصرَ وعرشُها ولواؤها","والصّولجانُ وتاجُها المتوسمُ",5,"م",1,0],["هو سيفٌ ماض على كلِّ داءٍ","وهْوَ للناس: رحمةٌ، وسلامُ",6,"م",1,0],["هو ساعدُ السبّاح فوق الماءِ إِن","خاض الوغى، وقوادمُ الطيَّار",7,"ر",1,0],["هو ساكت متواضع عن عزة","ولديه كبار الرجال صغار",8,"ر",1,0],["هو سلم المدد الخفي وصاحب ال","قدر العلي ومأمل الفقراء",9,"ا",2,0],["هو سيدي الصّافِي الأبى المرتضى","زاكِي الأَرومةِ ذُو النجار العلِى",10,"ل",2,0],["هوَ سُلطانُ النبيّينَ الكرام","وَعَليهم أخذَ اللَّه العهود",11,"د",1,0],["هوَ سيّدُ الرسلِ الكرامِ إمامهم","سُلطانُهم مِقدامُهم علّامُهم",12,"م",1,0],["هوَ سيّدُ الرسلِ الكرام الأكرمُ","أَرقاهمُ رُتباً وأعلى أعلمُ",13,"م",1,0],["هوَ سُلطانهم وكلٌّ أميرٌ","غيرُ بدعٍ أن تسبق الأمراءُ",14,"ا",2,0],["هو سابق الأعيان إذ كتب اسمه","بالعرش ثمت أودع الألواحا",15,"ح",2,0],["هُوَ سيد الكَونين وَالثقلين لا","شمه له في الغور والانحاد",16,"د",1,0],["هُوَ سُلطانٌ مَتى ناظَرَ ذا","أَدَبٍ جاءَ بِسُلطانٍ مُبين",17,"ن",1,0],["هو سيد متواضع متخشع","ورع تقي زاهد في العاجل",18,"ل",1,0],["هو سنّةٌ نَفَذت نفاذَ أسنّةٍ","بيضاءَ كأبيض في المَضاءِ يَماني",19,"ن",2,0],["هو سرٌّ لما أُكابدُ في حبّك","من لوعتي ووجدي وناري",20,"ي",1,0],["هو سيفُ السُنّة المولى الذي","في استباقِ المجد فردٌ لا يُبارى",21,"ر",2,0],["هو سيرٌ قُدّ كالسّيْ","رِ وقد سارَ وساروا",22,"ر",3,0],["هو سيف به يصول وبشر","للموالي وفتكة للأعادي",23,"د",2,0],["هو سر خالقه وخاتم رسله","لولا الرسول فرسله لم ترسل",24,"ل",1,0],["هو سِرٌّ لم يُفْشَ ما دامَتِ الأَرْ","ضُ ومَرَّتْ ليالي التَّشْريق",25,"ق",1,0],["هو سُكرٌ مثلما دَب","بتْ بأعضائك راحُ",26,"ح",1,0],["هو ساهٍ عَنِ الّذي نَحنُ فيهِ","مِن حَديثٍ وَقيلةٍ وَاِشتِكاءِ",27,"ا",2,0],["هو سر يبدو من الغيب جهر","لقلوب الرجال فيه انتشاء",28,"ا",2,0],["هُوَ ساحرٌ يُطغي فقالوا لم نَجِدْ","من ساحرٍ يُحيي الرَّميمَ بطَلْسَمِ",29,"م",1,0],["هو سورُه حيثُ السطورُ بروجُه","فلذاك صار مُحسَّناً ومحصَّنا",30,"ن",2,0]]}