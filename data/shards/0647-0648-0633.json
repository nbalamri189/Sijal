{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[53,"هو سيف دولتنا الذي يوم الوغى","https://www.aldiwan.net/poem30615.html","الكامل"],[71,"إن سلطاننا الذي نرتجيه","https://www.aldiwan.net/poem3727.html","الخفيف"],[52,"قد حما غصن النقا أسده","https://www.aldiwan.net/poem27110.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85687","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[106,"الطبيب إمام","https://www.poetsgate.com/ViewPoem.aspx?id=179382",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[100,"سحر الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=50091",""],[116,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[116,"أواه من ألم الفراق لأنه","https://www.aldiwan.net/poem42152.html","الكامل"],[129,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[190,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[190,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[232,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[283,"أومض البرق بعلياء منين","https://www.aldiwan.net/poem32401.html","الرمل"],[305,"أهلا وسهلا بالحبيب الواصل","https://www.aldiwan.net/poem16820.html","الكامل"],[306,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[329,"فيك معنى من المعاني بعيد","https://www.aldiwan.net/poem54991.html","الخفيف"],[433,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[433,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[438,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[442,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[501,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[552,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[552,"زرت هندا ومن ظلام قميصي","https://www.aldiwan.net/poem48109.html","الطويل"],[559,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[563,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[576,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["هُوَ سُؤلي إِن أَسعَدَ اللَهُ جَدّي","وَمَعالي الأُمورِ لِلذِمرِ سولُ",0,"ل",1,0],["هُوَ سَيفُ دَولَتِنا الَّذي يَومَ الوَغى","يَفري قُلوبَ عُداتِهِ بِفِرِندِهِ",1,"د",2,1],["هُوَ سَيفٌ كَما يُقالُ وَلكِن","قاطِعٌ لِلرُّسومِ وَالأَرزاقِ",2,"ق",1,0],["هُوَ سُقمي حينَ أَفقِدُه","وَشِفاءُ السُقمِ لَو أَجِدُه",3,"د",2,0],["هُوَ سعلاة إذا ما","أَظلم اللَيل وغولُ",4,"ل",1,0],["هو سحرُ مصرَ وعرشُها ولواؤها","والصّولجانُ وتاجُها المتوسمُ",5,"م",1,0],["هو سيفٌ ماض على كلِّ داءٍ","وهْوَ للناس: رحمةٌ، وسلامُ",6,"م",1,0],["هو ساعدُ السبّاح فوق الماءِ إِن","خاض الوغى، وقوادمُ الطيَّار",7,"ر",1,0],["هو سرّ الأرض غذّته السما","وجلته فتنا بيضا وسمرا",8,"ر",2,0],["هو ساكت متواضع عن عزة","ولديه كبار الرجال صغار",9,"ر",1,0],["هو سلم المدد الخفي وصاحب ال","قدر العلي ومأمل الفقراء",10,"ا",2,0],["هو سيدي الصّافِي الأبى المرتضى","زاكِي الأَرومةِ ذُو النجار العلِى",11,"ل",2,0],["هوَ سُلطانُ النبيّينَ الكرام","وَعَليهم أخذَ اللَّه العهود",12,"د",1,0],["هوَ سيّدُ الرسلِ الكرامِ إمامهم","سُلطانُهم مِقدامُهم علّامُهم",13,"م",1,0],["هوَ سيّدُ الرسلِ الكرام الأكرمُ","أَرقاهمُ رُتباً وأعلى أعلمُ",14,"م",1,0],["هوَ سُلطانهم وكلٌّ أميرٌ","غيرُ بدعٍ أن تسبق الأمراءُ",15,"ا",2,0],["هو سابق الأعيان إذ كتب اسمه","بالعرش ثمت أودع الألواحا",16,"ح",2,0],["هُوَ سيد الكَونين وَالثقلين لا","شمه له في الغور والانحاد",17,"د",1,0],["هُوَ سُلطانٌ مَتى ناظَرَ ذا","أَدَبٍ جاءَ بِسُلطانٍ مُبين",18,"ن",1,0],["هو سيد متواضع متخشع","ورع تقي زاهد في العاجل",19,"ل",1,0],["هو سنّةٌ نَفَذت نفاذَ أسنّةٍ","بيضاءَ كأبيض في المَضاءِ يَماني",20,"ن",2,0],["هو سرٌّ لما أُكابدُ في حبّك","من لوعتي ووجدي وناري",21,"ر",2,0],["هو سيفُ السُنّة المولى الذي","في استباقِ المجد فردٌ لا يُبارى",22,"ر",2,0],["هو سيرٌ قُدّ كالسّيْ","رِ وقد سارَ وساروا",23,"ر",3,0],["هو سيف به يصول وبشر","للموالي وفتكة للأعادي",24,"د",2,0],["هو سر خالقه وخاتم رسله","لولا الرسول فرسله لم ترسل",25,"ل",1,0],["هو سِرٌّ لم يُفْشَ ما دامَتِ الأَرْ","ضُ ومَرَّتْ ليالي التَّشْريق",26,"ق",1,0],["هو سُكرٌ مثلما دَب","بتْ بأعضائك راحُ",27,"ح",1,0],["هو ساهٍ عَنِ الّذي نَحنُ فيهِ","مِن حَديثٍ وَقيلةٍ وَاِشتِكاءِ",28,"ا",2,0],["هو سر يبدو من الغيب جهر","لقلوب الرجال فيه انتشاء",29,"ا",2,0],["هُوَ ساحرٌ يُطغي فقالوا لم نَجِدْ","من ساحرٍ يُحيي الرَّميمَ بطَلْسَمِ",30,"م",1,0],["هو سورُه حيثُ السطورُ بروجُه","فلذاك صار مُحسَّناً ومحصَّنا",31,"ن",2,0]]}