abi.ae/diwan/poem/91030","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90899","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90907","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91004","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94534","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135114","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83369","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83458","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83475","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83572","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83520","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83448","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83404","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4717,"لا تحزني...","https://www.poetsgate.com/ViewPoem.aspx?id=199634",""],[501,"نسمت من صوب سوريا الجنوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205277",""],[1901,"رَبٍّ إني طغى عليَّ مَشيبي","https://www.poetsgate.com/ViewPoem.aspx?id=160419",""],[4858,"اصبر وصابر","https://www.poetsgate.com/ViewPoem.aspx?id=139896",""],[4859,"متفرد!","https://www.poetsgate.com/ViewPoem.aspx?id=207455",""],[4942,"ساحر","https://www.poetsgate.com/ViewPoem.aspx?id=188681",""],[5045,"سيرة نظالي","https://www.poetsgate.com/ViewPoem.aspx?id=185176",""],[5205,"خطرت وقد خطرت هواتف خاطري","https://www.poetsgate.com/ViewPoem.aspx?id=120991",""],[5285,"دمع الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=204399",""],[5302,"صلوا عليه وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=201897",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5431,"هو سرُ أسرار الوجود مخلدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187756",""],[5431,"لتخلصه ....","https://www.poetsgate.com/ViewPoem.aspx?id=210627",""],[5431,"دعك منهم","https://www.poetsgate.com/ViewPoem.aspx?id=213637",""],[5480,"زين التباريجه","https://www.poetsgate.com/ViewPoem.aspx?id=1592",""],[5490,"أقرئهُ عنّي الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=176415",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5628,"الصوت الناعم","https://www.poetsgate.com/ViewPoem.aspx?id=179900",""],[5704,"يا ليت...","https://www.poetsgate.com/ViewPoem.aspx?id=198741",""],[5747,"ياليته يروف بي","https://www.poetsgate.com/ViewPoem.aspx?id=61662",""],[5794,".. وطن","https://www.poetsgate.com/ViewPoem.aspx?id=122798",""],[5861,"هو قالها","https://www.poetsgate.com/ViewPoem.aspx?id=191302",""],[5956,"لِمَ تقطعين الغاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=182417",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[6001,"بنت العز","https://www.poetsgate.com/ViewPoem.aspx?id=376",""],[6070,"قُمْ وافتَحْ الصََندوقَ والأبوابا","https://www.poetsgate.com/ViewPoem.aspx?id=193902",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6129,"يفدي حذاءَك باعةُ الأبقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=13877",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6152,"الشمائل المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=203758",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[6247,"بطاقة عيد إلى أمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80270&r=&rc=9",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["هُوَ سُؤلي إِن أَسعَدَ اللَهُ جَدّي","وَمَعالي الأُمورِ لِلذِمرِ سولُ",0,"ل",1,0],["هُوَ سَيفُ دَولَتِنا الَّذي يَومَ الوَغى","يَفري قُلوبَ عُداتِهِ بِفِرِندِهِ",1,"د",2,1],["هُوَ سَيفٌ كَما يُقالُ وَلكِن","قاطِعٌ لِلرُّسومِ وَالأَرزاقِ",2,"ق",1,0],["هُوَ سُقمي حينَ أَفقِدُه","وَشِفاءُ السُقمِ لَو أَجِدُه",3,"د",2,0],["هُوَ سعلاة إذا ما","أَظلم اللَيل وغولُ",4,"ل",1,0],["هو سحرُ مصرَ وعرشُها ولواؤها","والصّولجانُ وتاجُها المتوسمُ",5,"م",1,0],["هو سيفٌ ماض على كلِّ داءٍ","وهْوَ للناس: رحمةٌ، وسلامُ",6,"م",1,0],["هو ساعدُ السبّاح فوق الماءِ إِن","خاض الوغى، وقوادمُ الطيَّار",7,"ر",1,0],["هو سرّ الأرض غذّته السما","وجلته فتنا بيضا وسمرا",8,"ر",2,0],["هو ساكت متواضع عن عزة","ولديه كبار الرجال صغار",9,"ر",1,0],["هو سلم المدد الخفي وصاحب ال","قدر العلي ومأمل الفقراء",10,"ا",2,0],["هو سيدي الصّافِي الأبى المرتضى","زاكِي الأَرومةِ ذُو النجار العلِى",11,"ل",2,0],["هوَ سُلطانُ النبيّينَ الكرام","وَعَليهم أخذَ اللَّه العهود",12,"د",1,0],["هوَ سيّدُ الرسلِ الكرامِ إمامهم","سُلطانُهم مِقدامُهم علّامُهم",13,"م",1,0],["هوَ سيّدُ الرسلِ الكرام الأكرمُ","أَرقاهمُ رُتباً وأعلى أعلمُ",14,"م",1,0],["هوَ سُلطانهم وكلٌّ أميرٌ","غيرُ بدعٍ أن تسبق الأمراءُ",15,"ا",2,0],["هو سابق الأعيان إذ كتب اسمه","بالعرش ثمت أودع الألواحا",16,"ح",2,0],["هُوَ سيد الكَونين وَالثقلين لا","شمه له في الغور والانحاد",17,"د",1,0],["هُوَ سُلطانٌ مَتى ناظَرَ ذا","أَدَبٍ جاءَ بِسُلطانٍ مُبين",18,"ن",1,0],["هو سيد متواضع متخشع","ورع تقي زاهد في العاجل",19,"ل",1,0],["هو سنّةٌ نَفَذت نفاذَ أسنّةٍ","بيضاءَ كأبيض في المَضاءِ يَماني",20,"ن",2,0],["هو سرٌّ لما أُكابدُ في حبّك","من لوعتي ووجدي وناري",21,"ر",2,0],["هو سيفُ السُنّة المولى الذي","في استباقِ المجد فردٌ لا يُبارى",22,"ر",2,0],["هو سيرٌ قُدّ كالسّيْ","رِ وقد سارَ وساروا",23,"ر",3,0],["هو سيف به يصول وبشر","للموالي وفتكة للأعادي",24,"د",2,0],["هو سر خالقه وخاتم رسله","لولا الرسول فرسله لم ترسل",25,"ل",1,0],["هو سِرٌّ لم يُفْشَ ما دامَتِ الأَرْ","ضُ ومَرَّتْ ليالي التَّشْريق",26,"ق",1,0],["هو سُكرٌ مثلما دَب","بتْ بأعضائك راحُ",27,"ح",1,0],["هو ساهٍ عَنِ الّذي نَحنُ فيهِ","مِن حَديثٍ وَقيلةٍ وَاِشتِكاءِ",28,"ا",2,0],["هو سر يبدو من الغيب جهر","لقلوب الرجال فيه انتشاء",29,"ا",2,0],["هُوَ ساحرٌ يُطغي فقالوا لم نَجِدْ","من ساحرٍ يُحيي الرَّميمَ بطَلْسَمِ",30,"م",1,0],["هو سورُه حيثُ السطورُ بروجُه","فلذاك صار مُحسَّناً ومحصَّنا",31,"ن",2,0],["هو سلسبيل نحتسيه سائغاً","لكننا من مستساغ نثمل",32,"ل",1,0],["هو سادن العبّاس شبل المُرتضى","مَن لم يزل يَسقي العطاشى ماءها",33,"ا",3,0],["هو سادن العبّاس شبل المرتضى","مَن خصّنا بنوالهِ وحَبانا",34,"ن",2,0],["هو سيف دولتهم ففي الأعداء حد","سِنانِهِم وأكفهم في القائمِ",35,"م",1,0],["هو سيفٌ لا يُسلِمُ الضربَ خدي","يه ولا يُلبِسُ المقاصِد عُمدا",36,"د",2,0],["هوَ سَيِّدُ الأيّام مِثلُكَ في بَني","حَواء سَيِّدُ سَيِّدٍ ومَسُودِ",37,"د",1,0],["هو ساكن روحي التي أحيا بها","هو نازل في جسمي المتضضع",38,"ع",1,0],["هُوَ سَيف الجُنود في يَوم حَرب","هُوَ حُصن للحادِثات مشيد",39,"د",1,0],["هُوَ سيبويهِ أَوانِهِ وَخليله","لَكنّه الزّجّاجُ وَهوَ الراجحُ",40,"ح",1,0],["هو سمْعَ إذا تَمَطّرَ مشياَ","وعُقابٌ يَحُثُّها عسبَارُ",41,"ر",1,1],["هُوَ سَيدي فَخري مَلاذي مَسعَدي","حامي حِمايَ وَليُّ أَمري مسعفي",42,"ف",2,0],["هو سيف دولتك الذي أغنيته","بطويل باعك من وسيع خطاه",43,"ا",2,1],["هو سلوة للثاكلين ومطمع","للآملين يدوم ذاك المطمع",44,"ع",1,0],["هو سيدي هو عدتي هو مرشدي","وهو الرؤف المنهل العذب الخفي",45,"ف",2,0],["هو سعدٌ ومن يماثل سعداً","فى سداد وعزمةٍ وخطابِ",46,"ب",1,0],["هو سيّدُ الكرماءِ إن ذُكر السخا","وأخو المكارم إن غدوا أحلافَها",47,"ف",3,0],["هو سيد من عهد سادات الوفا","علما ومن عهد الأمير أمير",48,"ر",1,0],["هوَ سؤلي وَموئلي واختياري","منه بين الوَرى لبست إزارا",49,"ر",2,0],["هو سيد الهادي الحبيب محمد","له رفعة عم الأنام علاها",50,"ا",3,0],["هوَ سيّدُ للتابعينَ وقد أخَذ","عن نُخبتَين من الصحابِ الزهَد",51,"د",1,0],["هو سِمْعٌ إذا تمطَّرَ شيئاً","وعُقابٌ يحثُّها عِسْبارُ",52,"ر",1,1],["هُوَ سَهلُ خَدَّينِ وَأَقنى الأنفِ بَل","عِرنِينُهُ حَسَنٌ كما وَرَدَ الخَبَر",53,"ر",1,0],["هو سيفك الماضي الذي أرهفته","فَسَطَا وناصرك الذي لا يَخْذُل",54,"ل",1,0],["هو سابقُ الآدابِ حاملُ رايةٍ","لم يَبقَ فيها موضِعُ استدرَاكِ",55,"ك",1,0],["هُوَ سَيد وَكَواكبيّ نسبة","وَعُلومه للعالمين تفيد",56,"د",1,0],["هُوَ سر الإِله لَولاه نوح","فلكه ما اِستَقر فَوقَ الجُودي",57,"ي",1,0],["هو سحرٌ طوراً وطوراً سلاف","ما حكاه معتق الجريال",58,"ل",1,0],["هُو سَبعةٌ شاهدُهُ سهيل","أربَعَةٌ عادَه بغيرِ ميل",59,"ل",1,0],["هُوَ سِرُّ المُلوكِ في كُلِّ أَمرٍ","فَعَلَيهِ خَناصِرُ المُلكِ تُعقَد",60,"د",1,0],["هُوَ سِرُّ وَحيِ اللَهِ ثُمَّ أَمينُهُ","في أُمَّةٍ عَرَفَتهُ مِنها المَرجَعا",61,"ع",2,0],["هو سيد طالت يداه تطولا","ولذاك عنه تقاصر السادات",62,"ت",1,0],["هو سيد السادات مخدوم العلى","شيخ المشايخ خيرة الأخيار",63,"ر",1,0],["هو سيد الأبان سعد أوانه","فخر الزمان ميسر المعسور",64,"ر",1,0],["هو سباق غاية الفخر فضلاً","هو فتاح كل كنز مطلسم",65,"م",1,0],["هو سهل في شاطئ النهر غض","كان يهدي الإبداع والإلهاما",66,"م",2,0],["هو سبط آل المجد وابن اصوله","وابو الندى واخو العلا وسميره",67,"ر",2,0],["هو سفرٌ قلبته فإذا بي","وفؤادي في دفتيه يسح",68,"ح",1,0],["هو سيفها وجنودها عند الوغى","هو رمحها ومجنها وعرابها",69,"ب",3,0],["هو سيد الرسل الذى نرجو به","أن نحتمى مما نخلف وتسلم",70,"م",1,0],["هو سِرُّ الإله فِي الخلق حتماً","هو عينُ الوجود نور سَناها",71,"ا",3,0],["هو سِفرٌ حوى بِديعَ معانٍ","بِبَيانٍ أَبان عنها العسيرا",72,"ر",2,0],["هو سر بدءهم وسر ايابهم","وهو الطريق إلى الآله الموصل",73,"ل",1,0],["هو سيف اللَه لا ينبو ولا","تعتريه في الملمات فلول",74,"ل",1,0],["هوَ سَيف دين اللَه في نَحر العِدا","هو مسكت البُلغاء آنة يَنطق",75,"ق",1,0],["هو سترها وطلاء زينتها","ورياضة للنفس تحييها",76,"ي",3,0],["هو سيارة ركب","خطرت فوق رغام",77,"م",1,0],["هو سيد طوراً وطوراً خادمٌ","فتراه دهرك ظالماً مظلوما",78,"م",2,0],["هُوَ سَيفٌ غِمدَهُ بُردَتاهُ","يَنتَضيهِ الحَزمُ حينَ يُسَلُّ",79,"ل",1,0],["هو ساقه للحرب فوق جياده","لكنه واويحه لم يقفل",80,"ل",1,0],["هو سيد من سادة أفعالهم","يزهو بها التاريخ والتدوين",81,"ن",1,0],["هو سبط عبد القادر الباز الذي","شرف انتسابا للبتول ومحتدا",82,"د",2,0],["هو سر محي الدين بعد وفاته","والسر في الآباء في الأولاد",83,"د",1,