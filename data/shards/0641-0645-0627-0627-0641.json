{"poems":[[5,"ليجز الله من جشم بن بكر","https://www.aldiwan.net/poem278.html",""],[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[53,"عجبت لقوم يقبلون مدائحي","https://www.aldiwan.net/poem8165.html","الطويل"],[53,"غضبت وظلت من سفه وطيش","https://www.aldiwan.net/poem64921.html","الوافر"],[53,"ولما أجمعوا بينا وشدت","https://www.aldiwan.net/poem65064.html","الوافر"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[51,"وما ذاك إلا أنني واثق بما","https://www.aldiwan.net/poem63215.html","الطويل"],[48,"فعلت فعل تجار مخسرين به","https://www.aldiwan.net/poem22667.html","البسيط"],[58,"","https://poetry.dctabudhabi.ae/diwan/poem/9849","الطويل"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[984,"","https://poetry.dctabudhabi.ae/diwan/poem/122195","المنسرح"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93619","الطويل"],[2801,"","https://poetry.dctabudhabi.ae/diwan/poem/144467","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201381","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201089","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132598","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59482","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44715","الطويل"]],"verses":[["فَما اِفتَرَقَت لِذاكَ نَباتُ نَعشٍ","وَلا كَسَفَت لَهُ شَمسُ السَماءِ",0,"ا",2,0],["فَما أَفجَرَت حَتّى أَهَبَّ بِسُدفَةٍ","عَلاجيمَ عَينٍ اِبني صُباحٍ يُثيرُها",1,"ر",3,0],["فَمَا آفتي شعرٌ إليهم مُبَغَّضٌ","ولكنه منعٌ إليهم محبَّبُ",2,"ب",1,0],["فما افترقتْ لمغضبكَ الثُريّا","ولا اجتمعتْ هناك بناتُ نعشِ",3,"ش",1,0],["فما افترَّتْ شفاهٌ عن ثغورٍ","بل افترَّتْ جفونٌ عن دموع",4,"ع",1,0],["فما أَفْضَحَ الدَّمْعَ السّكوبَ إذا جرى","وأَظْهَرَهُ لُطفاً لما في المَغايبِش",5,"ب",2,0],["فَما آفَةُ الأَملاكِ غَيرَكَ في الوَغى","وَلا آفَةُ الأَموالِ غَيرُ حِبائِكا",6,"ك",2,0],["فَما أَفادوا سِوى إِحلالِ نِسوَتِهِم","مُعَرَّضاتٍ لِأَهلِ الباطِنِ الفُجُرِ",7,"ر",1,0],["فما أَفْضَحَ الدَّمْعَ السّكوبَ إذا جرى","وأَظْهَرَهُ لُطفاً لما في المَغايبِ",8,"ب",1,0],["فما أَفْلَحَتْ بين الأنام قبيلةٌ","إذا ابتليت يوماً بداء الضرائر",9,"ر",1,0],["فما أفادتهم الدروع سوى","النقلة من خفةٍ إلى ثقل",10,"ل",1,0],["فَما أَفلَحَت في الغَزوِ كِندَةُ بَعدَها","وَلا أَدرَكوا مِثقالَ حَبَّةِ خَردَلِ",11,"ل",1,0],["فَما اِفتَرق الجَمعان حَتّى تَجمَعَت","عَلى جثث القَتلى سِباع وَأَنسر",12,"ر",1,0],["فما أفادتني سوى","حرفة أهل الأدب",13,"ب",1,0],["فما أفي للحياة من ذممٍ","ولا اؤدّي ما تقتضي هممي",14,"م",2,0],["فما أفتح العينين طاب كراهما","على عالم إلا على عالم سحري",15,"ر",2,0],["فما أفلت شمس الامامة والهدى","عن الأفق حتى أشرق الكوكب الدري",16,"ر",2,0],["فما أفقنا وعين الصبح شارقة","وما هجدنا وغول الليل سهران",17,"ن",1,0],["فما افترَّ ثغرُ الفجرِ حتى انبرى لهُ","أخو أكلبٍ لُدٍ عَنيدٍ يخاتلهْ",18,"ل",2,0],["فَما اِفتَرَّ ثَغرُ المَرءِ إِلا وَأَمطَرَت","مَآقيهِ دَمعاً في الخُدود لَهُ غَدرُ",19,"ر",1,0]]}