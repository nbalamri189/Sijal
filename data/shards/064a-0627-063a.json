em/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43878","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[90,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[28,"أنا ابن خندف والحامي حقيقتها","https://www.poetsgate.com/ViewPoem.aspx?id=21597",""],[78,"يا غُرَّةَ الشَّمس الَّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86493&r=&rc=38",""],[86,"أوشَكَ الدِّيكُ أن يَصيحَ ونَفسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13071&r=&rc=26",""]],"verses":[["يا غَزالَ الجِزعِ لَو كا","نَ عَلى الجِزعِ لُمامُ",0,"م",1,0],["يا غِياثَ الخَلقِ أَيّا","مُكَ في الأَيّامِ شامُ",0,"م",1,0],["يا غارِبَ النِعَمِ العِظا","مِ غَدَوتَ مَعموراً جَزيلا",1,"ل",2,0],["يا غَريبَ الدِيارِ صَبري غَريبٌ","وَقَتيلَ الأَعداءِ نَومي قَتيلُ",2,"ل",1,0],["يا غَزالاً بَينَ النَقا وَالمُصَلّى","لَيسَ تَبقى عَلى نِبالِكَ دِرعي",3,"ي",1,0],["يا غائِباً نَقَضَ الوِدادا","أَشمَتَّ بِالقُربِ البِعادا",4,"د",2,1],["يا غَيرَةَ اللَهِ اِغضَبي لِنَبِيِّهِ","وَتَزَحزَحي بِالبيضِ عَن أَغمادِها",5,"د",3,0],["يا غُصُناً طالَ وَفَرعاً طابا","لَمّا ذَوى أَودَعتُهُ التُرابا",6,"ب",2,0],["يا غَزالَ الرَملِ قَلبي","لَكَ مُنقادُ الجَنيبِ",7,"ب",1,0],["يا غَريبَ الدارِ عَن وَطَنِه","مُفرَداً يَبكي عَلى شَجَنِه",8,"ن",2,1],["يا غايَةً في الحُسنِ إِنّي غايَةٌ","في الحُبِّ لَيسَ يُطيقُ ما بي واصِفُ",9,"ف",1,0],["يا غوْثَ مَنْ وصَلَ الصّريخَ فلمْ يجِدْ","في الأرْضِ منْ وزَرٍ ولا مِنْ واقِي",10,"ق",2,0],["يا غَزالاً غَزا دِيارَ الأعادي","وأجالَ الجِيادَ تحْتَ العَجاجِ",11,"ج",1,0],["يَا غَزَالاً تَرَكَ الْقَلْبَ الْمُبَلَّى","حِينَ وَلَّى فِي خُفُوقِ وَكَآبَهْ",12,"ه",1,1],["يا غَزالاً وِرْدُهُ في أدمُعي","كلّما شاءَ ومرْعاهُ الحَشا",13,"ش",2,0],["يا غالِبي حَسبُكِ مِن غالِبِ","إِرحَم عَليَّ بنَ أَبي طالِبِ",14,"ب",1,1],["يا غَريبَ الدارِ وَالقَبرِ وَيا","سَلوَةَ النيلِ إِذا ما الخَطبُ جَد",15,"د",1,0],["يا غُلامُ المُدامَ وَالكاسَ وَالطا","سَ وَهَيِّئ لَنا مَكاناً كَأَمسِ",16,"س",1,0],["يا غَزالاً أَرى الغَوايَةَ رُشداً","في هَواهُ وَأَحسَبُ الرُشدَ غَيّا",17,"ي",2,1],["يا غَزالاً أَصارَني","موثَقاً في يَدِ المِحَن",18,"ن",1,1],["يا غَزالاً جُمِعَت فيهِ","مِنَ الحُسنِ فُنونُ",19,"ن",1,1],["يا غافِلاً وَلَهُ في الدهرِ مَوعِظَةٌ","إِن كُنتَ في سنَةٍ فالدهرُ يَقظانُ",20,"ن",1,0],["يَا غُرَبَاءَ الحِمَى سَلاما","حِمَامُكمْ هَوَّنَ الحِمَامَا",21,"م",2,1],["يَا غِبْطَتي دُومِي فَمَا تَعْدُوكَ لِي","أُمْنِيَّةٌ أَنْ تَسْمَحِي بِدَوَامِ",22,"م",1,0],["يَا غَريباً إلى العَرَارِ مَشُوقاً","أَيْنَ دُونَ العَرارِ مِنْكَ الشَّمِيمُ",23,"م",1,0],["ياغُلامي بَل سَيِّدي لَن أَمَلَّك","هَب لِمَولاكَ لاعَدِمتُكَ عَدلَك",24,"ك",1,1],["يا غارِساً منِّي نباتَ مدائحٍ","من مثلهِ يُجنى الثمار غرائِبا",25,"ب",2,0],["يا غائبين تعلَّلْنا لغيبتهم","بطيبِ لهوٍ ولا والله لم يطب",26,"ب",1,1],["يا غزالاً رنا وغصناً تثنى","وهلالاً سما وبدراً أنارا",27,"ر",2,0],["يا غيثَ جودٍ نداه","والبر بر وبحر",28,"ر",1,0],["يا غادراً بي ولم أغدر بصحبتِه","وكان مني مكان السمع والبصر",29,"ر",1,1],["يا غائباً عن مجلسٍ قد شاتمت","ندماه واسْتعلتْ لديهِ الأكؤس",30,"س",1,1],["يا غائباً ولُهى كفّيه حاضرة","مهما سلوت فلا والله أسلوكا",31,"ك",2,0],["يا غصن بانٍ قد تبين جوره","إن أنت لم تعطف فكيفَ تميل",32,"ل",1,0],["يا غائباً أظلمت دار لغيبته","وهكذا البدر تدجو بعده الظلم",33,"م",1,0],["يا غصن يا أهيف يا طفل يا","قاتل هذا الشيخ يا والسلام",34,"م",1,0],["يا غائباً ذهبت أيدي الحمام به","بعداً ليومك ماذا بالحشا فعلا",35,"ل",2,0],["يا غافِلاً لِجَهالَةٍ عَن شاني","هَلا عَرَفتَ حَقيقَتي وَبَياني",36,"ي",1,1],["يا غايَةَ السُؤلِ وَالمَأمولِ يا سَكَني","يا عَيشَ روحِيَ يا ديني وَدُنيائي",37,"ا",3,0],["يا غامِطَ النعمة أيقِنْ أنها","قد غَضِبَ اللّه لها كلَّ الغضبْ",38,"ب",1,0],["يا غُصُناً من لُؤلُؤٍ رَطْبِ","فيه سرورُ العينِ والقلبِ",39,"ب",1,1],["يا غائباً عني بعيدَ الإيابْ","نَغَّصني فقدُك بَرْدَ الشرابْ",40,"ب",1,1],["يا غايتي في مُنْيَتي","ماذا يَضُرُّك لو مَنَنَتا",41,"ت",2,0],["يا غضّةَ السن يا صغيرتها","أمسيتِ إحدى المصائب الكُبرِ",42,"ر",1,0],["يا غيوراً أن يُهْتكَ المستورُ","وشفيقاً أن يهلِك المضرورُ",43,"ر",1,1],["يا غريبَ التمام كيف أتمَّتْ","بِك أمٌّ جنينُها الدهرَ سِقط",44,"ط",1,0],["يا غمَّ آب عند سكان الغرف","يا برد كانون لعار بالنَجَف",45,"ف",1,0],["ياغرسَ ذي العرشِ لا شريكَ لهُ","أنبتَك اللَّهُ ثم لا حَصَدَكْ",46,"ك",1,0],["يا غياثي إذا استرثتُ غِياثي","وثمالي إذا فقدتُ الثمالا",47,"ل",2,0],["يا غُيوثَ الناس في المَحل إذا","كلكلُ الأزمةِ أَرْسى وطحن",48,"ن",1,0],["يا غائِبينَ وَفي قَلبي أُشاهِدُهُم","وَكُلَّما اِنفَصَلوا عَن ناظِري اِتَّصَلوا",49,"ل",3,0],["يا غائِباً أَهدى مَحا","سِنَهُ إِلَيَّ وَظَرفَهُ",50,"ف",2,1],["ياغافِلاً عَن نَفسِهِ","أَخَذَتهُ أَلسِنَةُ الوَرى",51,"ر",2,0],["ياغادِرينَ أَلَم يَكُن","بَيني وَبَينَكُم عُهودُ",52,"د",1,1],["يا غائِبينَ عَنِ العِيا","نِ لَقَد حَضَرتُم في الفُؤادِ",53,"د",1,1],["يا غائِباً وَجَميلُهُ","ما غابَ في بُعدٍ وَقُربِ",54,"ب",1,1],["يا غُربَةَ الرُّوحِ المُفَكِّر إنَّهُ","في النَّاسِ يحيا سَائماً مَسْؤُوما",55,"م",2,0],["يا غَزالاً صادَ مِنّي","بِالطُلَى لَيثَ الهَياجِ",56,"ج",1,0],["يا غَفَرَ اللَهُ لَهُ ذَنبَهُ","في ظُلم صَبٍّ هائِمٍ فيهِ",57,"ي",2,0],["يا غَيمُ عَيني أَقوى مِنك تَهتانا","أَبكي لِحُزني وَما حُمّلتَ أَحزانا",58,"ن",2,1],["يا غُرَّةً تَسخَرُ بِالبَدرِ","وَمُقلَةً تَنفُثُ بِالسِحرِ",59,"ر",1,1],["يا غيرةَ اللَه ابطشي بعصابة","الهاهمُ الجبروت والطغيان",60,"ن",1,0],["يا غزالا أهِل القلب به","قلبي السفح وأحنى ملعبا",61,"ب",2,0],["يا غربة في العلوم ما طويت","إلا بسيف المنية الخاطف",62,"ف",1,0],["يا غُرَّةَ الوادي وَسُدَّةَ بابِهِ","رُدّي مَكانَكَ في البَرِيَّةِ يُردَدِ",63,"د",1,0],["يا غائِبينَ وَفي الجَوانِحِ طَيفُهُم","أَبكيكُمُ مِن غُيَّبٍ حُضّارِ",64,"ر",1,0],["يا غابَ بولونَ وَلي","ذِمَمٌ عَلَيكَ وَلي عُهود",65,"د",1,1],["يا غابَ بولونَ وَبي","وَجدٌ مَعَ الذِكرى يَزيد",65,"د",1,0],["يا غادِياً وَالثَغرُ خَلفَ مَسائِهِ","يَصِلُ السُرى بِأَصيلِهِ وَضَحائِهِ",66,"ا",3,1],["يا غَطَفانُ دَعي مَرعى مُهَنَّأَةٍ","تُعدي الصِحاحَ إِذا ما عَرُّها اِنتَشَرا",67,"ر",2,0],["يا غصنا لما اكتسى نضرة","وابتسم النور عليه ذوى",68,"ا",1,0],["يا غُرَّةَ الأُمَراءِ إنَّ زَمانَنا","ما عِشتَ في الدُّنيا أَغَرُّ مُحجَّلُ",69,"ل",1,0],["يا غَيْبَةَ الكَرَمِ المفقودِ غائبُه","وخيْبةَ الأدَبِ المجفوِّ صاحبُه",70,"ب",2,0],["يا غريبَ السَّماحِ والمَجدِ والسُّؤ","دُدِ أصبحْتَ في الأنامِ غَريبا",71,"ب",2,0],["يا غَفلَتي عَن يَومِ يَج","مَعُ شِرَّتي كَفَنٌ وَلَحدُ",72,"د",1,0],["يا غَفلَتي عَمّا خُلِقتُ لَهُ","إِنّي بِمُنقَلَبي لَذو جَهلِ",73,"ل",1,0],["يا غائِبينَ لَقَد أَضنى الهَوى جَسَدي","وَالغُصنُ يَذوي لِفَقدِ الوابِلِ الرَزِمِ",74,"م",1,0],["يا غائِبينَ وَما غابَت مَحاسِنُهُم","وَنازِحينَ وَأَقصى بَينَهُم أَمَمُ",75,"م",1,0],["يا غائِباً أَخفى التُرابُ جَمالَهُ","عَنّا وَأَنعُمُهُ لَدَيَّ حُضورُ",76,"ر",1,0],["يا غائِبينَ وَمَأواهُم سَرائِرُنا","تَكادُ حينَ تُناجيكُم ضَمائِرُنا",77,"ن",2,0],["يا غائِبينَ وَلا تَخلو خَواطِرُنا","مِن شَخصِهِم وَإِنِ اِشتاقَت نَواظِرُنا",77,"ن",2,0],["يا غازياً يضرب القل","ب وهو حصنٌ مُحَطَّم",78,"م",1,0],["يا غلة المتلهف الصادي","با آيتي وقصيدتي الكبرى",79,"ر",2,1],["يا غراما كان مني في دمي","قدراً كالموت أوفى طعمه",80,"ه",1,0],["يا غزالاً حَرّم ال","لَهُ دَمي وهو يُحلّه",81,"ل",2,0],["يا غيثَ المحلِ بلا كذبٍ","وشجاعَ الحربِ بلا فَنَدِ",82,"د",1,0],["يا غُصنَ بانٍ ناعِمٍ قَدُّهُ","فَوقَ نَقاً يَهتَزُّ أَعلاهُ",83,"ا",2,0],["يا غافِلاً عَنِّيَ مالي أَرى","طَرفَكَ عَن قَتلِيَ لا يَغفَلُ",84,"ل",1,0],["يا غَزالاً قِطافُ وَجنَتِهِ الوَر","دُ وَدُرٌّ بِفيهِ دُرٌّ نَثيرُ",85,"ر",1,1],["يا غايَةَ الأُدَباءِ وَالظُرَفاءِ بَل","يا سَيِّدَ الشُعَراءِ وَالخُطَباءِ",86,"ا",2,0],["يا غافِرَ الذَّنبِ وَالأَلبابُ حائِرَةٌ","في الحَشرِ وَالنارُ تَرمي الجَوَّ بِالضَّرَمِ",87,"م",1,0],["ياغُصنَ حُسنٍ قامَ يَنشُرُ فَرعَهُ","وَرَقاً وَيَفتُقُ نورَهُ نُوّارا