جنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5102,"لاهية","https://www.poetsgate.com/ViewPoem.aspx?id=12886",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5183,"بين العيد والمدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=185683",""],[5189,"الساعة ثانيةً ليلاً","https://www.poetsgate.com/ViewPoem.aspx?id=191804",""],[5189,"سلّم الأمر","https://www.poetsgate.com/ViewPoem.aspx?id=207684",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5302,"هام قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201901",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5497,"علل النفس بما يسعدها","https://www.poetsgate.com/ViewPoem.aspx?id=206747",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5570,"إن أفارقهم فقد عشت دهرا","https://www.poetsgate.com/ViewPoem.aspx?id=186734",""],[5703,"أخطأ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=206208",""],[5725,"ضرباً بهارية الصفاح","https://www.poetsgate.com/ViewPoem.aspx?id=177494",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[5736,"خمر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=208882",""],[402,"في فؤادي من أسى ما في فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=36013",""],[5853,"ظلمة الشك","https://www.poetsgate.com/ViewPoem.aspx?id=175613",""],[5943,"قدرٌ تغيَّرَ حينَ ألقتْ طفلَها","https://www.poetsgate.com/ViewPoem.aspx?id=34799",""],[5943,"قاوم، جاهد، اِصبر، صابرْ","https://www.poetsgate.com/ViewPoem.aspx?id=45281",""],[5956,"ابتسامات في غابات السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=183966",""],[5957,"طالما أنت أنا","https://www.poetsgate.com/ViewPoem.aspx?id=186316",""],[5957,"تذكرتُ","https://www.poetsgate.com/ViewPoem.aspx?id=189912",""],[6032,"لا تسلني من أكون ..","https://www.poetsgate.com/ViewPoem.aspx?id=181522",""],[199,"هلْ أنتَ منصرفٌ فتنظرُ ماترى","https://www.poetsgate.com/ViewPoem.aspx?id=22428",""],[243,"يا نهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68172&r=&rc=164",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[402,"رؤية أربت على الرؤيا بما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53566&r=&rc=418",""]],"verses":[["فَرَمَيتُ غَفلَةَ عَينِهِ عَن شاتِهِ","فَأَصَبتُ حَبَّةَ قَلبِها وَطِحالَها",0,"ل",3,0],["فَرَمى النُهى وَالفَضلَ مُج","تَمِعينَ حينَ رَماهُما",1,"م",2,0],["فَرَماكَ حُرّاسُ السَما","ءِ وَتِلكَ قاصِمَةُ الظُهورِ",2,"ر",1,0],["فَرَماها في فَرائِصِه","بِإِزاءِ الحَوضِ أَو عُقُرِه",3,"ر",2,0],["فرمت كفّها على ذلك الدَو","سر كيما تشوصه بالبنانه",4,"ن",2,0],["فرمَوك بالأبصار وهي كليلةٌ","من نور وجهك نورهنّ مذال",5,"ل",1,0],["فَرَمَيتُ القَومَ رِشقاً صائِباً","لَيسَ بِالعُصلِ وَلا بِالمُقتَعِل",6,"ل",1,0],["فَرُميتُ مِنكَ بِغَيرِ ما أَمَّلتُهُ","وَالمَرءُ يَشرَقُ بِالزُلالِ البارِدِ",7,"د",1,0],["فَرّ منك الغزالُ يا لابس الشَّي","بِ فِرار الغزال من صَيَّادِهْ",8,"د",2,0],["فرمى بك الغرضَ البعي","د مُسدِّدٌ لا يستشيرُ",9,"ر",1,0],["فرماه بزوال","أودهاه بانفتاق",10,"ق",1,0],["فرماهُ بكوكبٍ هاشميٍّ","كان أدْهى له من السِّجِّيل",11,"ل",1,0],["فَرَمى فَأَنفَذَ مِن نَجودٍ عائِطٍ","سَهماً فَخَرَّ وَريشُهُ مُتَصَمِّعُ",12,"ع",1,0],["فَرَمى فَأَلحَقَ صاعِدِيّاً مِطحَراً","بِالكَشحِ فَاِشتَمَّلَت عَلَيهِ الأَضلُعُ",12,"ع",1,0],["فَرَمى لِيُنقِذَ فَرَّها فَهَوى لَهُ","سَهمٌ فَأَنفَذَ طُرَّتَيهِ المِنزَعُ",12,"ع",1,0],["فَرَمى بِناظِرِهِ فَأَبصَرَ بابَها","فَمَشى إِلَيهِ مِشيَةَ العَجلانِ",13,"ن",1,0],["فرماها بنظرةٍ غَشِيَتْها","سَكْرَةُ الحبِّ والأَسى وغيومُهْ",14,"م",2,0],["فَرَمَوا بِما يَرمونَ عَنهُ وَأَدبَروا","يَطَؤونَ كُلَّ حَنِيَّةٍ مِرنانِ",15,"ن",1,0],["فَرَمى الأَمينُ بِنَفسِهِ في دِجلَةٍ","يَرجو النَجاءَ فَصارَ في الديماسِ",16,"س",1,0],["فَرَمَوا وَجالوا بِالقَنا وَتَثاقَفوا","بِسُيوفِهِم مِن بَعدِ طولِ دِعاسِ",16,"س",1,0],["فَرُم بِيَدَيكَ هَل تَسطيعُ نَقلاً","جِبالاً مِن تِهامَةَ راسِياتِ",17,"ت",1,0],["فَرَمى فَأَخطَأَهُ وَجالَ كَأَنَّهُ","أَلِمٌ عَلى بَرزِ الأَماعِزِ يَلحَبُ",18,"ب",1,0],["فِرَّ مِنَ اللُؤمِ وَاللِئامِ وَلا","تَدنُ مِنهُم فَإِنَّهُم جَرَبُ",19,"ب",1,0],["فَرَمَت رُجومُ النَيِّراتِ رَجيمَها","وَتَساقَطَت مِن خَوفِكَ الأَوثانُ",20,"ن",1,0],["فَرَمَى عن دُجُنَّةِ النقعِ نَحراً","منكَ والجوّ بالظلامِ كَحيلُ",21,"ل",1,0],["فَرَماهُ بِالأَفشينِ بِالنَجمِ الَّذي","صَدَعَ الدُجى صَدعَ الرِداءِ البالي",22,"ل",2,0],["فرمْتُ منها نظرةً ثانيةً","فأسبَلَتْ مِنْ دونِها رواقَها",23,"ق",3,0],["فرمى الأكابرَ والأصاغرَ كاذباً","بالكفر أو بالفسقِ أو بالزندقهْ",24,"ه",1,0],["فَرَمَتني فَأَقصَدَتني بِسَهمٍ","شَكَّ مِنّي الفُؤادَ بَعدَ الوَتَينِ",25,"ن",1,0],["فَرَمى فَأَقصَدَها بِرَميَتِهِ","وَرَنا فَمُهِّدَ لِلفَتى أَجَلُه",26,"ل",2,0],["فَرَمَتني بِسَهمِها ثُمَّ دافَت","لِبَناتِ الفُؤادِ سَمّاً نَقيعا",27,"ع",2,0],["فرمى أشتاتكم في وطنٍ","راعه منكم بشعبٍ مُلتئِمْ",28,"م",1,0],["فرماها بلطمةٍ تُعرِضُ الأجْ","يالُ عن ذكرِها صَوادفَ صُورا",29,"ر",2,0],["فَرَّ مِن عَدنٍ وَقَد بانَ عَلى","حُسنِهِ آثارُها أَيَّ بَيانِ",30,"ن",1,0],["فَرَمى حَبائِله وَحَطم قَوسه","وَأَتى سَريرك خائِفاً يَتَرصَد",31,"د",1,0],["فَرَماها واثِقاً أَنَّهُ","صائِدٌ إِن أُطعِمَ الصَيدَ رام",32,"م",1,0],["فَرَّ منه الشيطانُ إذْ كانَ فارو","قاً فلِلنَّارِ مِنْ سَنَاهُ انْبِراءُ",33,"ا",2,0],["فَرَمَت أَوجُهَ النُدامى بِنَبلٍ","لَيسَ يُدمي وَلَيسَ يُبدي شِجاجا",34,"ج",2,0],["فَرَمى بِالطَرفِ نَحوي","وَهوَ بِالطَرفِ يَصيدُ",35,"د",1,0],["فَرُم وَزَراً يُنجيكَ يا اِبنَ وَشيكَةٍ","فَلستَ بِناجٍ مِن مُضيمٍ وَضائِمِ",36,"م",1,0],["فَرَمَت بي خَلفَ السُتورِ لِأَفوا","هِ المَنايا مِن بَينِ حُمرٍ وَسودِ",37,"د",1,0],["فَرُم تَوبَةً قَبلَ المَماتِ فَإِنَّني","أَخافُ عَلَيكَ اللَهَ حينَ تَؤوبُ",38,"ب",1,0],["فِرَّ مِن هَذِهِ البَريَّةِ في الأَر","ضِ فَما غَيرُ شَرِّها لَكَ حاصِل",39,"ل",1,1],["فَرَمَتْهُ بهِ على جانِبِ الكُرْ","سِيّ أُمُّ اللُّهَيْمِ أُخْتُ النّآدِ",40,"د",1,0],["فَرَمَتْ إِلى إيقَاظِهِمْ لَكِنْ رَمَتْ","بِأَشَدَّ قَارِعَةً مِنَ الزَّلْزَالِ",41,"ل",1,0],["فَرَمَى مِلَّةَ عِيسى بِالَّذِي","كان مِنْهُ مُلْحِقاً بِالوِزْرِ وِزْرَا",42,"ر",2,0],["فَرَمَى الدَّهْرُ بِهِ مِنْ حَالِقٍ","لاَ تَكِلْ لِلْيَأْسِ تَصْرِيفَ قِيَادِكْ",43,"ك",1,0],["فرمى الأكاليل التي ضفرت له","وسعى إليك وقد تهلل وانتمى",44,"م",2,0],["فَرَماها في فَرائِصِها","بِإِزاءِ الحَوضِ أَو عُقُرِه",45,"ر",2,0],["فَرَمَتْ كَفُّ الزَّمَانِ بِهِ","فَكأَنَّ الْعُشَّ لم يَكُن",46,"ن",1,0],["فرماه سهم الصائِدي","نَ، فخَرَّ مخضوبَ الجناح",47,"ح",1,0],["فِرَّ مِنَ اللُّؤْمِ واللِّئامِ وَلاَ","تَدْنُ إليْهِمْ فَإنَّهُمْ جَرَبُ",48,"ب",1,0],["فرمت إلى حضن الممات كيانها","وتبدّلت بالكدّ عيشا أنعما",49,"م",2,0],["فرم زوراً ينجيك يا ابن وشيكة ٍ","فلستَ بناج من مضيمٍ وضائم",50,"م",1,0],["فرَّ مذ مُدَّتِ الأكفُّ إليهِ","كفرار النعيمِ منْ كفِّ حالم",51,"م",1,0],["فرمى لكَ الماضي الأليم بِوزْرِهِ","ورنا لكَ المستَقبلُ البسام",52,"م",1,0],["فرماه في فرائصها","بإزَاءِ الحَوْضِ أوْ عُقَرهْ",53,"ر",2,0],["فرموه بالإشراك ثمّ تلمّسوا","من حاسديه شاهدا مقبولا",54,"ل",2,0],["فرمى أشتاتكم في وطن","راعه منكم بشعب ملتثم",55,"م",1,0],["فرمتني بسهمها، ثمّ دلفتْ","لبناتِ الفؤادِ سماً نقيعا",56,"ع",2,0],["فرميتها وبرغم أن","في أني من قد رماها",57,"ا",3,0],["فرمقتني شزراً ولم تدعي","مجالاً للتحيه",58,"ي",2,0],["فَرُمتَ إِرتِقَاءً في الهَوَاءِ وَمَن يَرُم","بِغَيرِ جَنَاحٍ مُرتَقًى في الهَوَى هَوَى",59,"و",2,0],["فرّ من الحبِّ قلبُه فنجَا","من بعد ما خاضَ في الهوى لجُجاَ",60,"ج",2,1],["فرمى الدهر بعيني أسهماً","مذ نأيتم لا أرى فيها أحد",61,"د",1,0],["فَرَمَيْتُ غَفْلَتَها بِذِكْرِ تَفَرُّقٍ","فَابْيَضَّ مِنْ خَوْفِ الفِراقِ لَهُ الدَّمُ",62,"م",1,0],["فرمت بتفتير اللواحظ مهجتي","وأستنصرت منها غلي قبيلا",63,"ل",2,0],["فَرَماني ببلادءٍ","وغَلاءٍ وجلاءِ",64,"ل",3,0],["فَرَمى الأَميرُ جُمُوعَهُم فَتَمَزَّقَت","كَالشاءِ إِذ جَفَلَت مِنَ السِرحانِ",65,"ن",1,0],["فرمتُ أنْ أخرجَ من بعدِما","دخلتُ ظَنّاً أنّ ما رمتُ هَيْن",66,"ن",1,0],["فرماك عن قوس العليل تبرّما","كالمسريح باسهم النصح",67,"ح",1,0],["فَرُموا في القليبِ شرِّ وعاءٍ","بِئسَما قَد حَواه ذاك الوعاءُ",68,"ا",2,0],["فَرَمى بِهِ أَدبارَهُنَّ غُلامُنا","لَمّا اِستَتَبَّ بِهِ وَلَم يَستَدخِلِ",69,"ل",1,0],["فرماني في بلاد","ورماكم في بلادِ",70,"د",1,0],["فرمتها من الزهورِ","عيونٌ تريبُها",71,"ب",3,0],["فرماه ناظره بسهم صائب","وانظر إلى دمه على وجناته",72,"ت",2,0],["فَرَمى بَعلُها بِها في قَطيعٍ","أَبرَصٍ مِن عَبيدِهِ لِتُلاقي",73,"ق",2,0],["فَرَموا بِها فيها فَلَم يُرَ قَعرُها","مِن بَعدِ مِن ماءٍ بِها مَجانِ",74,"ن",1,0],["فَرَماني مُجاهِراً","بِالمُلِمّاتِ وَالمِحَن",75,"ن",1,0],["فَرُمْ تَحْصِيلَهَا فَهْماً","علَى أَهلِ الدِّراياتِ",76,"ت",1,0],["فَرُمْتُ تَخَلُّصاً مِمَّا عَرَانِي","بِمَا قَدْ يَطْرُدُ الأَحْزَانَ دُونِي",77,"ن",2,0],["فَرَمَتْ غَوَارِبُ ذَا مَحَامِدَ ذَا","مِنْ أَجْلِ ذَا السَّامِي الْقَرَاطِيسِ",78,"س",1,0],["فرَمَت بكأسي ثم قالت هكذا","تُلهيكَ فلتتكسَّرِ الأقداح",79,"ح",1,0],["فَرِماحُهُ ما إِن تَزالُ لَدى الوَغى","تَندَقُّ مِنها في الصُدورِ صُدورُ",80,"ر",1,0],["فرماهم ورماني ومضى","ما شاء يرمى",81,"م",2,0],["فرّ من طبرُق وبئر حكيم","كالنعام الشريد في بيدائه",82,"ا",3,0],["فرمى الدهر بسهم نافذ","خافقينا فأتى في المقتل",83,"ل",1,0],["فَرَمَتكَ بي حتَّى اشتَرَك","نا في مَذَمَّتِها اشتِراكا",84,"ك",2,0],["فرُميت منها بنكبةٍ","شُلَّت يمينُ الراميه",85,"ي",2,0],["فَرموكَ في النّيرانِ بُغْضاً مِنهمُ","لِمُحَّمدٍ وكراهةً أن تُقبَرا",86,"ر",2,0],["فَرَمتْ جُموعَهُمُ اللّيا","لِي بالتَّشَتُّتِ والبِعَادِ",87,"د",1,0],["فَرَماهُمُ مِنْ رَأْيِهِ بِنَوافِذٍ","تُهْدَى بِلا هادٍ إلَى الأَحْشاءِ",88,"ا",2,0],["فرَماه بالسّهْمِ المُعلّى سهمُه","في قدْحِه نارَ الوغى وقِداحِه",89,"ح",2,0],["فَرَمى عن قوسِ بأْسٍ صادِقٍ","وَسَطَا بساعِدِ الدينِ الأَشَدْ",90,"د",1,0],["فرمى بكَ الثَّغْرَ القَصِيَّ تَيَقُّناً","أَلّا يَرى غيرَ المُهَنَّدِ مَوْئِلَكْ",91,"ك",1,0],["فرماح الشموع قد شهرت","بين الندامى أسنَّةً من نار",92,"ر",1,0],["فرم نجوةً وانبذ إليه ذمامهُ","فلولا ابتغاء الحربِ ما كسرَ الجفنا",93,"ن",2,0],["فَرَمّوا لَهُ أَثوابَهُ وَتفَجَّعو