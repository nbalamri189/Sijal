{"poems":[[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147503","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13610","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[128,"أين جمشيد ابن كايو كباد","https://www.aldiwan.net/poem23713.html","الخفيف"],[136,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[170,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[376,"كم نهتهم صبابتي وغرامي","https://www.aldiwan.net/poem57128.html","الخفيف"],[443,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[458,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[463,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145908","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95538","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35740","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100954","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101005","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96032","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137106",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137371",""],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113697","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203052","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216422",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131289",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131249",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95339","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88590","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83458","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89591","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147279","الرمل"],[4691,"السيد المقيم","https://www.poetsgate.com/ViewPoem.aspx?id=114273",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5431,"قصيدة اليوم ...","https://www.poetsgate.com/ViewPoem.aspx?id=202682",""],[5457,"شكوى الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=213118",""],[5780,"المرء بالأعمال","https://www.poetsgate.com/ViewPoem.aspx?id=187625",""],[5851,"دمعة طفل عربي","https://www.poetsgate.com/ViewPoem.aspx?id=175299",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[6145,"على خطا شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7796",""],[6277,"رثاء الهبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64488&r=&rc=51",""]],"verses":[["لَم تَفُقها شَمسُ النَهارِ بِشَيءٍ","غَيرَ أَنَّ الشَبابَ لَيسَ يَدومُ",0,"م",1,0],["لَم تَفتَرِق شَهَواتُ القَومِ في أَرَبٍ","إِلا قَضى وَطَراً مِن ذَلِكَ الأَرَبِ",1,"ب",1,0],["لم تف بالذمة للحر وال","حر مراع وافيات الذمم",2,"م",1,0],["لَمْ تَفِتْهُمْ وَالْمَنَايَا دُونَهَا","نُصْرَةُ الحَقِّ بِعَزْمٍ وَإبَاءْ",3,"ا",2,0],["لَم تَفضُلونا بِشَيءٍ غَيرَ واحِدَةٍ","هِيَ الرَجاءُ فَسَوّى بَينَنا الياسُ",4,"س",1,0],["لم تُفَارِقْ كِمَامَها وشذَاها","يَنْشُرُ الطِّيبَ في جَمِيع الْجِهاتِ",5,"ت",1,0],["لم تفاجئ بها عدوّا فقد","أنذر منها زماجر وصهيل",6,"ل",1,0],["لم تفطر مرائر الزط لما","غيبوه ولا انفرت أَكباد",7,"د",1,0],["لم تفارق بناتُه ضنكَ عيشٍ","ليته لم يلد وكان عقيما",8,"م",2,0],["لَم تَفُق لَو تَأمَّلَ المُنكِرُ الأثقَا","لَ لَكِن لَم يَنظُرِ الأَنقَالا",9,"ل",2,0],["لم تفترعْه الحادثاتُ ولم تطُفْ","إلا بمحروسِ الجهاتِ مَصونِ",10,"ن",1,0],["لم تفرقهم المطامع في الدن","يا فكانوا كحزمة من عضيد",11,"د",1,0],["لَم تُفَضَّل بِطيبِها جَنَّةُ الخُل","دِ عَليها بَل فُضِّلَت بالدَّوامِ",12,"م",1,0],["لم تفتخر بهم كلا وإن كرمت","أعراقهم بفخار غير مردود",13,"د",1,0],["لم تفته أصالةٌ","إن يكن فاته الوطر",14,"ر",1,0],["لم تفوِّز ليَ الأماني ولم تر","م بأشباحنا ظهورُ النياقِ",15,"ق",1,0],["لم تفن كلهم سيوف الهند بل","لسيوف جودك في النفوس جراح",16,"ح",1,0],["لم تفكر مصر فيها","وهي شغل العالمينا",17,"ن",2,0],["لم تفُتهُ مفاخرٌ","من معالِ ومن حسب",18,"ب",1,0],["لَم تُفِدني الأَيّامُ إِلّا غُروراً","بِكَ وَالمُرتَضى بِهِ مَغرورُ",19,"ر",1,0],["لم تفوّه معشارَ ما قد أفاضت","لكم راحُ كفّه البيضاء",20,"ا",2,0],["لم تفارقه في هوى النفس لكن","في أَمانٍ جلت عن الإِرتياب",21,"ب",1,0],["لم تفتقر يوماً إلى حاجة","منك وفي حقك لم تطمع",22,"ع",1,0],["لم تفكر في غيرِ دنياكَ يوماً","آمِناً من تَقَلُّبِ الأزمانِ",23,"ن",1,0],["لم تفكر في غيرِ لهوٍ يؤدّى","يا ضعيفَ النُّهى إلى الخسرانِ",23,"ن",1,0],["لم تفكر في غير لهوكَ يوماً","بين خمرٍ وبين غيدٍ حسانِ",23,"ن",1,0],["لم تفت قارعو تحل بربعه","حياً وتزعجه رميماً أعظما",24,"م",2,0],["لَم تَفهَم الأذهَانُ مِنهُ سَريرَ بَل","قِيسٍ وَلاَ بَيتاً عَلَى الأركَانِ",25,"ن",1,0],["لم تفارق بشاشة الاعياد","كل ايام بولس العواد",26,"د",1,1],["لم تفده الرقاة شيأ وأضحت","في دواه الاساة حيرى وحسرى",27,"ر",2,0],["لم تفرقوا ما البزاة الشُّهب عندكم","وقد أحاطتكم الغربان والرَّخمُ",28,"م",1,0],["لم تفاخر بالمجد دوحاً ونالت","قصب السبق يوم عرض الثمار",29,"ر",1,0],["لَم تفز مِن ماءِ درّتها","بِسوى الضحضاح وَالكثبِ",30,"ب",1,0],["لم تفرق بين الحياة وبين ال","موتِ حتى فتَّ السوابقَ مَهْلا",31,"ل",2,0],["لم تفتإِ الخُلفاءُ في شخص الصَفا","حتى مجيء الحاكم الديَّانِ",32,"ن",1,0],["لم تفهمي مني سوى","أن النفائس تُطلَب",33,"ب",1,0],["لم تفسد الاخلاق بعد صلاحها","حتى اراد فسادها الكبراء",34,"ا",2,0],["لم تفقد الآداب مثلك منشئاً","ألف الفصاحة قلبه ولسانه",35,"ن",2,0],["لم تفتضض وولد لي بكر","أول مولود ومنه الشعر",36,"ر",1,0],["لم تفتها شمس النهار بشيء","غير أن الشباب ليس يدوم",37,"م",1,1],["لم تَفُتني النَفحاتُ في رَمَضانٍ","مِنَّةُ اللَهِ غايَةُ الإِمتِنانِ",38,"ن",1,0],["لَم تَفتَتِن يَوماً وَشِعرُكَ فِتنَةٌ","يا مُبدِعاً لَم يَزهُهُ ما أَبدَعا",39,"ع",2,0],["لَم تُفنِها الأَيّامُ بَل","وَكَذا اللَيالي الماضِيَه",40,"ي",2,0],["لم تفد فيه استغاثات الصدى","لم يلن قلبا لصرخات الحنايا",41,"ا",3,0],["لم تفهمي لغتي وطول كآبتي","شرح الهوى لا لم يعد مفهوما",42,"م",2,0],["لم تُفق من شجونها فيهِ بغدا","د ولا صابرت أساها الشام",43,"م",1,0],["لم تفارقه ما حييت إلى أن","فقدتك الشريعة السمحاء",44,"ا",2,0],["لم تفقه الحبَ لم تلمس معابده","أنْ جلّ همٍ غوى أو تستحل دمه!!",45,"م",2,0],["لم تفتحِ البابَ إلا بعدما دفعوا","كلَّ السعادةِ حتى أصبحوا خشبا",46,"ب",2,0],["لم تفللِ الأخطارُ عزمَكَ أيها الشْ","شَهْمُ الخطير وغيرُكَ الكسلان",47,"ن",1,0],["لم تفعلوا شيئا فماذا ياترى","أحكي لأطفال صغار في الكبر",48,"ر",1,0],["17-لمْ تُفلِحِ المُمْكِناتُ أجمعُها","أمامَ ڤيروسٍ صِرتَ مُنبطِحا",49,"ح",2,0],["لم تفتقدك من القطاع منازل","ومعاهد ومآثر ومساجدُ",50,"د",1,0],["لم تفطر مرائر الزط لما","غيبوه ولا اتفرت اكباد",51,"د",1,0]]}