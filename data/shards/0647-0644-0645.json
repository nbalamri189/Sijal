 الفِراشِ وَقَد","فديتَ بِالروحِ ختّامَ النَبِيّينا",195,"ن",2,0],["هَل مِثلُ سَبقِكَ في الاِسلامِ اِن عَرفوا","وَهذِهِ الخُصلَةُ الغَرّاءُ تَكفينا",195,"ن",2,0],["هَل مِثلُ عِلمك ان زَلّوا وَاِن وَهَنوا","وَقَد هُديتَ كَما أَصبَحتَ تَهدينا",195,"ن",2,0],["هَل مِثل سيفِكَ في يَوم الضِرابِ وَقد","دارَت رحى الحَرب تَجديعاً وَتَوهينا",195,"ن",2,0],["هَل مِثل فِعلِك في بَدر وَقَد حَمَشَت","نَفسُ الوَغى وَأَسالَت سَيلَها حينا",195,"ن",2,0],["هَل مِثلَ صَرعِكَ أَعلام الضَلالِ وَلَم","تَنفكّ تفلقُ هاماتِ الأَضَلّينا",195,"ن",2,0],["هَل مِثلُ يَومِكَ في أَحد وَقد غُرِفَت","عَصائِبُ الشِركِ تَغييراً وَتَعيينا",195,"ن",2,0],["هَل مِثلُ بَأسِكَ مَع عَمروٍ وَقَد جَبَنوا","وَحاذَروا المَوتَ تَعجيلاً وَتَحيينا",195,"ن",2,0],["هَل مِثلُ قَلعِكَ باب الكُفرِ تَحذُفُهُ","كَأَنَّهُ قُلَّةٌ من رَميِ رامينا",195,"ن",2,0],["هَل مِثلُ فاطِمَةَ الزَهراءِ سَيِّدَةٌ","زُوِّجتَها يا جَمالَ الفاطِمِيّينا",195,"ن",2,0],["هَل مِثل نَجلَيكَ في فَخرٍ وَفي كَرَمٍ","اِذ كُوِّنا من بَلالِ المَجدِ تَكوينا",195,"ن",2,0],["هَل مِثل جَمعِكَ لِلقُرآن تَعرِفُهُ","لَفظاً وَمَعنىً وَتَأويلاً وَتَبيينا",195,"ن",2,0],["هَل مِثلُ حَوزِكَ مَجموع الوَصِيَّة لا","تَخشى وَقَد جَرَّها سوم المُسامينا",195,"ن",2,0],["هَل مِثلُ عَزِّكَ في يَوم الغَدير وَقَد","حصَّلتَهُ سابِقاً كلَّ المُجارينا",195,"ن",2,0],["هَل مِثلُ كَونِكَ هارونَ النَبِيِّ وَقَد","شَأَوتَ بِالقُربِ أَصنافَ المُبارينا",195,"ن",2,0],["هَل مِثلُ حالِكَ عِند الطَير تَحضُرُهُ","بِدَعوَةٍ حُزتَها دونَ المُصَلّينا",195,"ن",2,0],["هَل مِثل فَضلِكَ عِندَ النَعلِ تَخصِفُها","وَلم يَكُن جاحِدوا التَفضيلَ لاهينا",195,"ن",2,0],["هَل مِثل برِّكَ في حالِ الرُكوعِ وَما","زَكا كبرِّكَ بِرّ لِلمُزَكّينا",195,"ن",2,0],["هَل مِثلُ بَذلِكَ لِلعاني الأَسيرِ وَلِلط","طفلِ اليَتيمِ وَقَد أَعطَيتَ مِسكينا",195,"ن",2,0],["هَل مِثل أَمرِكَ اِذ تَتلو بَراءَةَ في","خَيرِ المَواسِمِ قَد سُؤتَ المُناوينا",195,"ن",2,0],["هَل مِثل فَتواكَ اِذ قالوا مُجاهرةً","لَولا عَلِيٌّ هَلَكنا في فَتاوينا",195,"ن",2,0],["هَل مِثل صَبرِكَ اِذ خانوا وَاِذ خَتَروا","حَتّى جَرى ما جَرى في يَوم صَفّينا",195,"ن",2,0],["هَلْ من مُجارٍ أو مُبَارٍ أو","مُسَامٍ أو مُداني",196,"ي",1,0],["هَل مِنّةٌ في حَمْل جسْمٍ حَلّ في","أرضِ الْغَريّ فؤادُه الخفّاق",197,"ق",1,0],["هلْ مُنِعمٌ في النَّاسِ أو مُفضِلٌ","يرغبُ في الشُكرِ وفي الذِّكرِ",198,"ر",1,1],["هَلُمِّي بنا نستجدّ البكاءَ","فَقَدْ حَمَّلَ العينَ أثقالَها",199,"ل",3,0],["هَلُمَّ بنا نزورُ أبا الخصيبِ","ونرعى جانِبَ العيش الخصيبِ",200,"ب",1,1],["هلُمِّي بنا يا ناق نذكر ما مضى","ونبكي شؤوناً لا يفيد بكاها",201,"ا",3,0],["هل مثلُ خلقِكَ زَهْرُ الروضِ مبتسماً","أَو مثلُ جودِكَ جُودُ العارِضِ الهَتِنِ",202,"ن",1,0],["هل مَرَّ شهرٌ قَطُّ عنك وما","لَكَ أَجْرُ مَنْ قد صامَ أَو صَلَّى",203,"ل",2,0],["هل من رفيق رفيقِ","على فراق الفريقِ",204,"ق",1,1],["هل منكَ في عرَفاتِ الحسنِ عرْفُ جدًى","أو في مِنى الطّرفِ من منٍّ أرجّيهِ",205,"ي",2,0],["هلُمِّي إِلَى أُمِّ الرَّزَايا فأَسْعِدِي","نفوساً يضيقُ الدَّهْرُ عن حَسَراتِها",206,"ت",3,0],["هَلُمَّ إِلَى حَيْثُ تُنْسى الرَّزايا","هَلُمَّ إِلَى حَيْثُ تُؤْسى الكُلُومُ",207,"م",1,0],["هَلُمَّ إِلَى حيثُ يُؤْوى الغريبُ","هَلُمَّ إِلَى حَيْثُ يُحْمى الحريمُ",207,"م",1,0],["هَلُمَّ لِعِزِّ حِمىً لا يُرامُ","يَسُحُّ عَلَيْهِ حَياً لا يَرِيمُ",207,"م",1,0],["هَلْ مَنْ يُسامِيهِ وأَقْرَبُ مَا يُرى","مِنَّا إِذَا كَانَ الغَمامُ الصيِّبا",208,"ب",2,0],["هَلُمِّي إِلَى بَحرَيْنِ قَدْ مَرَجَ النَّدى","عبابَيْهِما لا يَسأمانِ انتظارَكِ",209,"ك",1,0],["هَلُمِّي إِلَى سيفينِ والحدُّ واحدٌ","يجيران من صرف الحوادث جارَكِ",209,"ك",1,0],["هَلُمِّي إِلَى طِرْفَيْ رِهانٍ تقدَّما","إِلَى الأَمَدِ الجالي عَلَيْكَ اختيارَكِ",209,"ك",1,0],["هل مثل صاحبك الثانيك في الغار","ومثل بو حفص العاري من العار",210,"ر",1,0],["هل مال عنها للسوى","من حبها اضحى غريمه",211,"م",2,0],["هلمي مجنحة بالعلوم إلى","الشمس فالشمس لا تنزل",212,"ل",1,0],["هلمي محصنة بالعدالة","للمجد فالمجد لا يبذل",212,"ل",1,0],["هلموا إن مجلسها ربيع","بألوان الملاحة قد تزيا",213,"ي",2,0],["هلموا نقتبس منها حبورا","يشعشعنا ونلثمه نجيا",213,"ي",2,0],["هل من الذكرة يا أهلَ مِنىً","غيرَ أن أَوجعَهُ الشوقُ فأنَّا",214,"ن",2,0],["هل مبلغٌ بالروضتين سلامَنا","ظبيا على ما بيننا من بِينِ",215,"ن",1,0],["هل مجابٌ يدعو مبدِّد أوطا","ري بجمَع يردُّ أيامَ جَمعِ",216,"ع",1,0],["هلموا بها قبَّ البطون كأنها","أهلَّةُ جو أو قسيُّ معابلِ",217,"ل",1,0],["هل مجيرٌ من الدجى فهو طفل","لم يشب من قطيعة وفراقِ",218,"ق",1,0],["هلموا خفافا بني المكتب","فهذا الأوان إلى اللعب",219,"ب",1,1],["هلموا جميعا لتحرير كم","بفك القيود ونشر السلام",220,"م",1,0],["هلمَّ العطايا فاللُّهى تفتح اللَّها","وسح الندا يستنجز الخاطرَ الوعدا",221,"د",2,0],["هلم إلى نحيف الجسم مني","لتنظر كيف آثار النحاف",222,"ف",1,0],["هل من وَليٍّ تَرَدَّى خِلعَةً عَظُمَتْ","إِلاَّ وتَطْريزُها في الغَيبِ من قِبَلي",223,"ل",2,0],["هلمّ لتسكنَ الفؤادَ فإنّه","بما لكَ منهُ جنةٌ لم تُعَلَّمِ",224,"م",1,0],["هل من فَريسةِ مَفخرٍ إلّا وقد","نشبَتْ حُشاشَتُها بمخلَبِ ورْدِهِ",225,"د",2,0],["هلُمَّ بنا إلى أرضِ الحَجونِ","عسى نقضي الغَداةَ بها دُيوني",226,"ي",1,1],["هلمّ بنا يا برْقُ في أبرقِ الحِمى","نُساقطُ دُرَّ الدّمْعِ فرداً وتوأما",227,"م",2,1],["هلمّ بِنا نقضي من النّدْبِ واجِباً","لعصرٍ مضى فيه وعهدٍ تقدّما",227,"م",2,0],["هلّم الخطا بدر الدجنّة وارفقا","بعينيكما فالضوء قد يورث العمى",228,"م",2,1],["هَلُمّوا إِلى نُصحِ النُصوحِ الِّذي أَتى","بِحَقٍ مُنيرٍ وَجهُهُ لا يُحَبَّسُ",229,"س",1,0],["هَلُمّوا إِلى دينِ النَبِيِّ مُحَمَّدٍ","وَلَو كانَ في أَقصى جِبالِ عُمانِ",230,"ن",1,0],["هَلُمَّ سلاحي لا أبا لكَ إنني","أرى الحربَ لا تزدادُ إِلا تماديا",231,"ي",2,0],["هَل مِن اذنٍ في كِلمَةٍ بالتحيَّة","لأُحيِّي الشَّبيبَةَ العرَبيَّه",232,"ي",2,1],["هَل مِن مَقالةِ شامِتٍ","أم مِن مَلامَةٍ إرتَكَب",233,"ب",1,0],["هلم اسقني كأسي ودع عنك من أبى","وروِّ عظاماً قصرُهُنَّ إلى بِلى",234,"ا",1,1],["هَل مامَضى مِنكِ يا أَسماءُ مَردودُ","أَم هَل تَقَضَّت مَعَ الوَصلِ المَواعيدُ",235,"د",1,1],["هل مُجيرٌ من غصّةٍ ما تقضّى","أو شفيعٌ في حاجةٍ ليس تقُضى",236,"ض",2,1],["هلموا يا رجال الغيب واسعوا","وصلوا واركعوا بي ساجدينا",237,"ن",2,0],["هل من فتى يا بني قومي أُفَهِّمُهُ","فيكشف الله عنه هذه الغُمَما",238,"م",2,0],["هل ملامي يليق في قمر","إن تبدى يسجد له القمر",239,"ر",1,0],["هلُمُّوا للنَّزاهةِ نحوَ دارٍ","لها قد قامَ في بيروتَ رَنَّهْ",240,"ه",1,1],["هل مَنْ يُصدِّقهُ ويترُكُ دينَهُ","بسَماعهِ عن حادثٍ مُترَدِّمِ",241,"م",1,0],["هل مِثلُ عبدِ العزيزِ اليومَ من مَلِكٍ","كلاّ ولا كانَ في الدَّهرِ الذي سَلفَا",242,"ف",2,0],["هل مُبْلغٌ عَنّي التَحيَّةَ ظَبيةً","عن مِسكِ نَكْهتِها اللَطائِمُ تُفتَق",243,"ق",1,0],["هل منكَ يا زَهرَ الحدائقِ نَفحةٌ","تُهدَى إلينا اليومَ مع رِيحِ الصَّبا",244,"ا",1,0],["هَل مِن شَجيعٍ وَماهِرٍ يُبارِزُني","كَأَنَّهُ أَسَدٌ أَقرانَهُ بَهَرا",245,"ر",2,0],["هلم إلى الأمر الذي إن فعلتموا","نجوتم ولم تخشوا لغائلة غدرا",246,"ر",2,0],["هَلُماَّ بكانونِنَا جاحِماً","وقُولاَ لموْقدِنَا أَجِّجِ",247,"ج",1,1],["هلم الينا نكفكَ الأمرَ كله","فعالاً وإمساناً وإن شئت فابعدِ",248,"د",1,0],["هَلُمَّ إِلَيها قَد أُثيرَت زُروعُها","وَعادَت عَليها المَنجَنونُ تَكَدَّسُ",249,"س",1,0],["هل من كريم عاشق","يحمي عن العوانق",250,"ق",1,0],["هَلُمَّ إِلى العَهْدِ القَديمِ نُجِدُّهُ","وَنُنْشِي به مَيْتَ الهَوَى طَيب النَّشْرِ",251,"ر",1,0],["هَلُمَّ إِلَيْهِ بَيْنَ قَصْفٍ وَلذَّةٍ","فإِنَّ غُصُونَ الزَّهْرِ تَصْلُحُ لِلقَصْفِ",252,"ف",1,0]]}