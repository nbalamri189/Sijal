diwan.net/poem36929.html","المتقارب"],[479,"على الناهضين نهوض الكرام","https://www.aldiwan.net/poem37616.html","المتقارب"],[495,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[495,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[500,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[505,"حبيبي","https://www.aldiwan.net/poem56769.html","الطويل"],[514,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[514,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[514,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[527,"هلم الخطا بدر الدجنة وارفقا","https://www.aldiwan.net/poem45995.html","الطويل"],[536,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[536,"أشاقك من عهد الخليط مغان","https://www.aldiwan.net/poem23856.html","الطويل"],[537,"كفى حزنا أن تطعن الخيل بالقنا","https://www.aldiwan.net/poem69408.html","الطويل"],[538,"هل من اذن في كلمة بالتحية","https://www.aldiwan.net/poem47488.html","عموديه"],[538,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[540,"هلم اسقني كأسي ودع عنك من أبى","https://www.aldiwan.net/poem56619.html","الطويل"],[540,"هل مامضى منك يا أسماء مردود","https://www.aldiwan.net/poem56859.html","البسيط"],[551,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[558,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[558,"أنا التعين والرب المهين ما","https://www.aldiwan.net/poem34077.html","البسيط"],[558,"أيها الناي عندك الخبر","https://www.aldiwan.net/poem34554.html","الخفيف"],[562,"هلموا للنزاهة نحو دار","https://www.aldiwan.net/poem52641.html","الوافر"],[562,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[562,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[562,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[562,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[567,"هلما بكانوننا جاحما","https://www.aldiwan.net/poem69766.html","المتقارب"],[570,"أذنب علينا ستم عروة خاله","https://www.aldiwan.net/poem59457.html","الطويل"],[576,"أعاذل إن المرء رهن مصيبة","https://www.aldiwan.net/poem1799.html","الطويل"],[584,"نحن بنات طارق","https://www.aldiwan.net/poem69385.html","مجزوء الرجز"],[586,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[586,"تبسم زهر اللوز عن در مبسم","https://www.aldiwan.net/poem17607.html","الطويل"]],"verses":[["هَل مُجيرٌ بِذابِلٍ أَو حُسامٍ","أَو مُعينٌ بِساعِدٍ أَو بَنانِ",0,"ن",1,0],["هَل مِن أَبٍ كَأَبي لِجُرحِ مُلِمَّةٍ","أَعيا وَشَعبِ عَظيمَةٍ لَم يُلأَمِ",1,"م",1,0],["هَلُمَّ نُعِد صَفوَ الوَدادِ كَما بَدا","إِعادَةَ مَن لَم يُلفِ عَن ذاكَ مِن بُدِّ",2,"د",1,0],["هَلمَّ نَبْكِ على نجدٍ وَساكِنِهِ","فَلَن تَرى بَعدَ نَجدٍ عيشَةً رَغَدا",3,"د",2,0],["هَلُمَّ نَشرَبْ راحاً مُعَتَّقَةً","صَفَتْ وَرَقَّتْ وَعُمِّرَتْ حُقُبا",4,"ب",2,0],["هلُمّوا الى تقْبيلِ راحَةِ يوسُفٍ","بمَنْ وجْهُهُ البُشْرى ومَنْ كفُّهُ السُقْيا",5,"ي",2,0],["هَلُمَّ فَجَفْنُ الدَّهْرِ قَدْ لاَذَ بِالْغَمْضِ","وَأَمْكَنَ مَيْدَانُ التَّصَابِي مِنَ الرَّكْضِ",6,"ض",1,1],["هَلُمّ فَما بَيْني وبيْنَكَ ثالِثُ","وقَدْ غَفَلَتْ في الحُبِّ عَنّا الحَوادِثُ",7,"ث",1,1],["هَلُمَّ إِلَينا آلَ بُهثَةَ إِنَّما","هِيَ الدارُ لا نَعتافُها وَنُهينُها",8,"ن",3,1],["هَلُمَّ إِلى ذُبيانَ إِن بِلادَها","حُصونٌ وَإِنَّ السَمهَرِيَّ قُرونُها",8,"ن",3,0],["هَل مِن سَبيلٍ فَماءُ العَتبِ لي أَسِنٌ","إِلى العُذوبَةِ مِن عُتباكَ وَالخَصَرِ",9,"ر",1,0],["هل من الغبن أن تكون المودات","بديلاً من الجمان الغوالي",10,"ي",1,0],["هَلْ مَعَ اللَّيْلِ وَالنَّهَا","رِ سِوَى السُّهْدِ وَالمِحَنْ",11,"ن",1,0],["هَلْ مُلْتَقًى يَجْمَعُ الروحَ الَّتِي رَجَعَتْ","أَدْرَاجَها وَالَّتِي تُزْجَى مِنَ العَدَمِ",12,"م",1,0],["هَلْ مَنْ يُنَبيءُ بَعْدَ أي مَشقةٍ","قدْ بَشرَتْ بِثِمَارِهَا الأَكمَامُ",13,"م",1,0],["هَلْ مِثْلُ وَجْهِ الصَّبَاحِ مُبْتَسِماً","يُرِيهِ لِلدَّهْرِ وَجْهُ مُبْتَسِمِ",14,"م",1,0],["هَلْ مِثْلُ مَا نَتَباكَى عِنْدَنَا حَزَنٌ","وَهَلْ كَمَا نَتَشَاكَى عِنْدَنَا أَلَمُ",15,"م",1,0],["هَلْ مَسْقِطُ الرَّأْسِ مُغْنٍ إذْ نَكُونُ وَمَا","مِنَّا امْرُؤٌ فِي ثَرَاهُ ثَابِتُ الْقَدَمِ",16,"م",1,0],["هلمّ إلى ذوق طعم الأدب","هلمّ إلى نيل أقصى الأرب",17,"ب",1,1],["هلمّ إلى ذا الغناء الذي","منيرة منه أتت بالعجب",17,"ب",1,0],["هل من نظير بينكم لنظيرة","أو من فقيه مثلها وفطين",18,"ن",1,0],["هلّم نبكِ النهى والعلم والشرفا","فقد قضى من بهذا كان متّصفا",19,"ف",2,1],["هلّم نبك الذي كانت شمائله","كمثل قطر الغوادي رقّةً وصفا",19,"ف",2,0],["هلّم نبك امرأً لم يغلُ واصفه","بالخير إلا رآه فوق ما وصفا",19,"ف",2,0],["هَل مِن نَوالٍ لَمَوعودٍ بَخِلتِ بِهِ","وَلِلرَهينِ الَّذي اِستَغلَقتِ مِن فادي",20,"ي",1,0],["هَل مِثلُ حاجَتِنا إِلَيكُم حاجَةٌ","أَو مِثلُ جاري بِالمُوَقَّرِ جارُ",21,"ر",1,0],["هَل مِن حُلومٍ لِأَقوامٍ فَتُنذِرَهُم","ما جَرَّبَ الناسُ مِن عَضّي وَتَضريسي",22,"س",2,0],["هل من بكى الدار راجٍ أن تحَسَّ له","أو يبكيَ الدارَ ماءُ العبرةِ الخَضِلُ",23,"ل",1,1],["هلم إلى أمية إن فيها","شفاء الواريات من الغليل",24,"ل",1,1],["هَل مِنَ الظاعِنينَ مُهدٍ سَلامي","لِلفَتى الماجِدِ الأَريبِ الأَديبِ",25,"ب",1,0],["هل مطر يغسل في الأرضِ من","بياضه أسود هذا الوسخ",26,"خ",1,0],["هل من وفاءٍ كُفؤُهُ","فَيَفِي حَقيقاً بالوفاءِ",27,"ا",2,0],["هل مشتر والسعيدُ بائِعُهُ","هل قابِلٌ والسعيد من يهبُهْ",28,"ب",2,0],["هل مِلاكُ النعوتِ إلا المعاني","أو قِوامُ الأبيات إلا البيوتُ",29,"ت",1,0],["هل مانعي حاجتي مليحٌ","خِلْوٌ من البغْض والفجَاجَهْ",30,"ج",2,0],["هل ما ترى من منظر أو مَسمعٍ","أو مطعمٍ أو منكحٍ أو مَلْبس",31,"س",1,0],["هل من سبيل إلى تجديد ودكمُ","وهل يجدد شيء بعد إخلاق",32,"ق",1,0],["هلُمّ إلى مُساعدتي عليها","فلستَ لمثلِ ذلكَ بالتَّروكِ",33,"ك",1,0],["هل من وليٍّ غيرُ مُنْتَعِشٍ","هل من عدوٍّ غيرُ مُصْطلِمِ",34,"م",1,0],["هل من مُوَلٍّ غيرُ مُقْتَبلٍ","هل من شتيت غيرُ منتظمِ",34,"م",1,0],["هل مُلِّكَ الأعداء عند قيامه","إلا تذلُّلَ آنُفٍ وجباه",35,"ه",1,0],["هَل ما عَلِمتَ وَما اِستودِعَت مَكتومُ","أَم حِبلُها إِذ نَأَتكَ اليَومَ مَصرومُ",36,"م",1,1],["هَلُمّوا يا بَني الإِسلامِ نَسعى","عَسى الزَمَنُ الَّذي وَلّى يَعودُ",37,"د",1,0],["هَلُمّوا يا بَني مِصرٍ هَلُمّوا","فَما يُجدي الوُقوفُ وَلا يُفيدُ",37,"د",1,0],["هل ما تقول الطير في","الاغرود وحي نازل",38,"ل",1,0],["هلموا نسابق من لنا قد تقدموا","فنعل علاهم او نمر كما مروا",39,"ر",3,0],["هلموا الى الاصلاح يا قوم واعجلوا","فما هو بعد اليوم يقبل تأخيرا",40,"ر",2,0],["هلموا الى الاصلاح ان زمانه","اتى ولعل اللَه يجعل تغييرا",40,"ر",2,0],["هلم إلى جنبي فإني مريضة","بحمى قوى جسمي بها تتزلزل",41,"ل",1,0],["هلموا أهل ذا النادى","على قدم نعظمه",42,"م",2,0],["هَل مِن خَطيبٍ مُحسِنٍ خَبير","يَدعو بِطولِ العُمرِ لِلأَمير",43,"ر",1,0],["هَل مِن ذُيولِكِ مَسكِيٌّ نُحَمِّلُهُ","غَرائِبَ الشَوقِ وَشياً مِن أَمالينا",44,"ن",2,0],["هَل مِن نَداكَ عَلى المَدارِسِ أَنَّها","تَذَرُ العُلومَ وَتَأخُذُ الفُوتبولا",45,"ل",2,0],["هلموا إذا ما خفتهم الفقر فاصعدوا","إلى جبل من فوقكم ينبت الغنى",46,"ن",2,1],["هَلُمُّ نُكافِهِ عَمّا اِب","تَغى فينا وَما اِحتَسَبا",47,"ب",2,0],["هَلُمَّ إِلى الصِدقِ نَسري إِلَي","هِ بِحُجَّتِنا فيهِ أَو نَدَّلِج",48,"ج",1,0],["هَل مُبَكٍّ عَلى الشَبابِ بِمُستَغ","زَرِ دَمعِ الأَسى عَلى مَفقودِه",49,"د",2,0],["هَل مُغرَمٌ يُعطي الجَوى حَقَّ الهَوى","مِنكُم فَيُنفِدَ دَمعَهُ أَو مُسعِدُ",50,"د",1,0],["هَل مِن سَبيلٍ إِلى الظُهرانِ مِن حَلَبٍ","وَنَشوَةٍ بَينَ ذاكَ الوَردِ وَالآسِ",51,"س",1,0],["هَل مِن رَسولٍ يُؤَدّي ما أُحَمِّلُهُ","إِلى الأَميرِ أَبي موسى بنِ عَبّاسِ",51,"س",1,0],["هَلُمَّ نَجمَع طَرَفَي حالِنا","إِلى سَواءٍ بَينَنا مُنصِفِ",52,"ف",1,0],["هَلُمَّ إِلى الحُكّامِ بَكرِ بنِ وائِلٍ","وَلا تَكُ مِثلَ الحائِرِ المُتَرَدِّدِ",53,"د",1,0],["هَلُمَّ نُوافِ مَكَّةَ ثُمَّ نَسأَل","بِنا وَبِكُم قُضاعَةَ أَو نِزارا",54,"ر",2,0],["هَلُمَّ إِلى الإِسلامِ وَالعَدلُ عِندَنا","فَقَد ماتَ عَن أَرضِ العِراقِ خِبالُها",55,"ل",3,0],["هَلِمَّ أَباً كَاِبنَي عِقالٍ تَعُدُّهُ","وَواديهِما يا اِبنَ المَراغَةِ وادِيا",56,"ي",2,0],["هل من فلسطين مكتوبٌ يطمئنني","عمن كتبت إليه.. وهو ما كتبا؟",57,"ب",2,0],["هَلُمَّ فَقدْ بَرَدَتْ راحُنا","وأَشفَتْ على الشُّرْبِ أقداحُنا",58,"ن",2,1],["هَلُمَّ إِلى المَوالي الصي","دِ في سَعَةٍ وَفي رَحَبِ",59,"ب",1,0],["هَلُمَّ يا طالِبَ النَوالِ إِلى","مَن فَتَكَت بِالنُضارِ كَفّاهُ",60,"ا",2,0],["هَل مَن يَنُمُّ بِحُبٍّ مَن يَنُمُّ لَهُ","بِما رَموهُ كَمَن لَم يَدرِ كَيفَ رُمي",61,"م",2,0],["هَلُمَّ إِلى رَبعِ الجَوادِ الَّذي بَدَت","مَناقِبُهُ مِثلَ النُجومِ الطَوالِعِ",62,"ع",1,0],["هل منك يوم رضىً ضنَّ الزمان به","أعيا خيالي وأضناني توقّعُه",63,"ع",2,0],["هَلِمّوا اِعجَبوا مِن أَنبَهِ الناسِ كُلِّهِم","ذَريعَتُهُ فيما يُحاوِلُ خامِلُ",64,"ل",1,0],["هَلُمَّ إِلى ميعادِهِ فَاِنتَظَرنَهُ","فَقَد حانَ مِنهُ أَن يَجيءَ أَوانُ",65,"ن",1,0],["هَلُمَّ فَأَخبِرني بِذَنبِيَ أَعتَرِف","بِعُتباكَ أَو أَعرِف إِذاً كَيفَ أُصرَمُ",66,"م",1,0],["هَلُمَّ فَأَعطِني وَاِستَرضِ مِنّي","مَواثيقاً عَلى أَن لا تَحولا",67,"ل",2,0],["هَل مِن كَريمٍ يَهتاجُ ذي حَسَبٍ","قَد شَفَّهُ مِن حَسيبِهِ السَهَرُ",68,"ر",1,0],["هَل مِن رَسولٍ يَكمي حَوائِجَنا","بِحاجَةٍ تُشتَهى إِلى عُمَرِ",69,"ر",1,0],["هَلُمُّوا فارْفعوهُ منارَ صِدقٍ","يَفيضُ شُعاعُه شَرَفاً ومجدا",70,"د",2,0],["هَلُمُّوا نَرْفَعُ الهاما","أَنَقْضِي الدّهرَ نُوَّاما",71,"ا",1,0],["هَلُمّوا شَبابَ النّيلِ فالبِرُّ أوجَبُ","أَمِن حَقِّهِ أن تنعموا وهو مُتْعَبُ",72,"ب",1,0],["هَلُمّوا إلى البيضاءِ إن رَابَ مَذهبٌ","وأُمُّوا سَواءَ الأمرِ إن مَالَ أَنْكَبُ",72,"ب",1,0],["هَلُمّوا فَصُونوا للِكنانةِ مَجْدَها","وكونوا لها الجُندَ الذي ليس يَرهبُ",72,"ب",1,0],["هَلُمّوا شَبابَ النّيلِ لا تَتَهيَّبوا","فقد نَشطَ الدّاعي وجَدَّ المُثوِّبُ",72,"ب",1,0],["هَلُمّوا إلينا إنّ فيهِ بقيّةً","لِمنْ كان من إرثِ النبيين مُعدِما",73,"م",2,0],["هَل مِنَ اللَهِ مَهرَبٌ أَو نَجاءٌ","حينَ يُزجي جُنودَهُ وَالرِعالا",74,"ل",2,0],["هَلُمَّ هَلُمَّ يا زيدٌ","هَلُمَّ الشاءَ والنَعَمَا",75,"م",2,0],["هَلُمَّ فَلاقِهِ يا كعبُ رِزْقاً","مِنَ الرِضوانِ ليس له نَفادُ",76,"د",1,0],["هَلمُّوا نَتَّبِعْهُ فإنْ أبيتُم","فليس لنا سِوَى الأخرى بَديلُ",77,"ل",1,0],["هلمّوا بالقواضبِ إن أردتم","فما يُغنِي التَّردّدُ والنُّكولُ",77,"ل",1,0],["هَل مِن مُعينٍ عَلى أَحداثِ أَزماني","أَسَأتَ مُعتَمِداً لي بَعدَ إِحسانِ",78,"ن",1,1],["هَلُمُّوا لهُ فَهْوَ الرَّشِيدُ بِرَأْيِهِ","وبينَ يَدَيْهِ جُودُ كَفَّيْهِ جَعْفَرُ",79,"ر",1,0],["هل من أعِقّةِ عالِجٍ يَبْرِينُ","أمْ منهما بَقَرُ الحُدوجِ العِينُ",80,"ن",1,1],["هلمّا نُحيّي الأجرَعَ الفردَ واللّوى","وعُوجا على تلك الرّسومِ وعَرّجَا",81,"ج",2,0],["هَلُمّ على أنّي أقِيكَ بأضْلُعي","فأملِكُ دَمعي عنْك وَهْو شآبيب",82,"ب",1,0],["هلمّوا فذا مصرَعُ العالَمينَ","فمن كلّ قلبٍ عليه أسى",83,"ا",1,0],["هَل مُخطِئٌ حَتفَهُ عُفرٌ بِشاهِقَةٍ","رَعى بِأَخيافِها شَثّاً وَطُبّاقا",84,"ق",2,1],["هَل مِن دَواءٍ لِمَشغُوفٍ بِجارِيَةٍ","يَلقَى بِلُقيانِها رَوحاً وَرَيحانا",85,"ن",2,0],["هَل مِن سَبيلٍ إِلى زِيارَتِها","أَم هَل لِما بي مِن حُبِّها غِيَرُ",86,"ر",1,0],["هَل مِن رَسولٍ مُخبِرٍ","عَنّي جَميعَ العَرَبِ",87,"ب",1,1],["هَل مِن عَريبٍ أَو ذَوي جُرهُمٍ","أَو إِرَم أَو آلِ طَسمٍ عَريب",88,"ب",1,0],["هَل مَيَّزَ يَوماً هَواءٌ في لَطافَتِهِ","بِمُنخُلٍ أَو صَفا ماءٌ بِغِربالِ",89,"ل",1,0],["هَل من يدرى إلا ظناً","ماذا سيجيء به غدُهُ",90,"د",2,1],["هل مَلَّتِ الخمرةُ أقداحَكمْ","أم نَضَبَتْ من خمرهنّ الدّنانْ",91,"ن",1,0],["هل من نشيدكِ ما يجدد لي الصِّبا","ويعيدُ لمحة ثغره البسَّامِ",92,"م",1,0],["هَلْ مِنْ طَبِيبٍ لِدَاءِ الْحُبِّ أَوْ رَاقِي","يَشْفِي عَلِيلاً أَخَا حُزْنٍ وَإِيرَاقِ",93,"ق",1,1],["هَلْ مِنْ فَتَى يَنْشُدُ قَلْبِي مَعِي","بَيْنَ خُدُورِ الْعيْنِ بِالأَجْرَعِ",94,"ع",1,1],["هَلْ مِنْ بَيَانٍ فِي تَرَسُّلِ كَاتِبٍ","كَبَيَانِهِ العَذْبِ النَّقِيِّ الرَّائِقِ",95,"ق",1,0],["هَلْ مِنْ مَتَاعٍ للعُقُولِ كَمَتْنِهِ","وَشُرُوحِهِ فِي كُلِّ بِحْثٍ شَائِقِ",95,"ق",1,0],["هَلُمُّوا اشْهَدُوا صُبْتَ النَّجَاحِ وَقَدْ بدَا","مُبِيناً يُحيِّي بِالتَّيَمُّنِ وَالبِشْرِ",96,"ر",1,0],["هَلْ مَنْبِتٌ لِلْخَيْرِ لَمْ يَرُوِهِ","مِنْكَ سُحَابٌ شَامِلُ الوَرْقِ",97,"ق",1,0],["هَلْ مِنْ بَشِيرٍ أَوْ نَذِيرٍ قادِرٍ","مُتَبَيِّنٍ مِنْهُمْ مَكَانَ الدَّاءِ",98,"ا",2,0],["هَلْ مِنْ الصَّابِ فِي كُؤُوسِكَ سُؤْرٌ","قَدْ سُقِينَا يَا دَهْرُ حَتَّى رَوِينَا",99,"ن",2,0],["هَلْ مِنْ كَمَال لِمَنْ تَسْمو مَكَانَتُهُ","كالمَجْدِ وَالخُلقِ العَالِي إِذا ائتَلفَا",100,"ف",2,0],["هَلْ مَعْدَنُ التِّيْجَانِ بَخْسٌ حَقُّهُ","إِنْ يَأْبَ طَبْعَ أَسِنَّةٍ وَقَوَاضِبِ",101,"ب",1,0],["هَلْ مِثْلُ عَبْدِ اللهِ في أَهْلِ النهَى","مَلِكٌ بَصِيرٌ بِالأُمُورِ رَشِيدُ",102,"د",1,0],["هَل مُستَطيع أَن يُكفكف دَمعه","مَن لا بَراحَ لَهُ عَن البُرحاءِ",103,"ا",2,0],["هَل مُسعِدٌ بِالبُكا مُعينٌ","داهيتي أَعظَمُ الدَواهي",104,"ه",2,0],["هل من رسالةِ حِبٍّ أستعينُ بها","على سقامِي فقد تَشفي الرِّسالاتُ",105,"ت",1,0],["هل مطمعٌ أن تُرَدَّ القيروانُ لنا","وصَبْرَةٌ والمعلّى فالحنيّاتُ",105,"ت",1,0],["هَلمَّ فَالْوَقْتُ أَنْفَاسٌ لَهَا أَمَدٌ","وَلاَ أقُولُ بأنَّ الوَقْتَ مِنْ ذَهَبِ",106,"ب",1,0],["هلمي الدموعِ وإنما","من فيضِ أعيْنِنَا بكاؤه",107,"ا",3,0],["هلم إليها إنها دار","سكانها للعريب أنصار",108,"ر",1,1],["هلموا إلى تقبيل راحة يوسف فمن","وجهه البشرى ومن كفه السقيا",109,"ي",2,0],["هل متّ ؟ يبدو متّ ، لا إنها","دعاية ، زيف ، دخان مثار",110,"ر",1,0],["هلمَّ فعندي مُشتهى كلَّ ماجدٍ","ومن كلِّ ذوق طيّبٍ فتذَّوق",111,"ق",1,0],["هَلُما معي نحو هذي الرياض","نجددْ عهوداً بفصل الربيع",112,"ع",1,0],["هلمَّ لشُطئانِ الفراتينِ واستمِع","أهازيجهَا تستطرفِ المعجِزَ البَدعا",113,"ع",2,0],["هلمَّ به ذرعاً إلى بغدادَ لا تخشَ خاطفاً","فانَّا نسجنا من \" فريدٍ \" لك الدرعا",113,"ع",2,0],["هلُموا فهذا الروض زاهٍ أريضُهُ","لنرتاده والماءُ صاف معينه",114,"ن",2,0],["هلُّما ننوح على دوحةٍ","ذوى الأصل منها وجفَّ الثمر",115,"ر",1,0],["هلموا انظروا قلبي فان صفاءه","يبين الذي خلَّفتمُ فيه من قَرح",116,"ح",1,0],["هل مدَ روحُ اللهِ عيسى روحَه","ام كان يَنْفُثُها به جبريل",117,"ل",1,0],["هلمُّوا إلى قبر الزهاويِّ نقتنصْ","به نَفَساً من روُحه ونُطارِد",118,"د",1,0],["هلمى .هلمى . أن هاتيك نسبة","تقرب ما بيني وبين الملائك",119,"ك",1,0],["هَلُمّوا الى النشء المثقّفِ واكشِفوا","حجاباً يُغَطّي سَوءةً وقناعا",120,"ع",2,0],["هَلُمّ