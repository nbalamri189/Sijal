{"poems":[[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[51,"أبلغ فتى آل بشر بل مؤملهم","https://www.aldiwan.net/poem62001.html","البسيط"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[80,"يا ليل هجر الحبيب طلت على","https://www.aldiwan.net/poem31525.html","المنسرح"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[46,"خف دنيا كما تخاف شريفا","https://www.aldiwan.net/poem22360.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[169,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[271,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[282,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[285,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[403,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[441,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[453,"حمدت ربي على ذمي فأكثره","https://www.aldiwan.net/poem61236.html","البسيط"],[529,"أهوى الذي يهوى فإن عن ما","https://www.aldiwan.net/poem37079.html","السريع"],[538,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[575,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[586,"هل جابر جائر بالوصل لم يجد","https://www.aldiwan.net/poem17500.html","البسيط"]],"verses":[["هَل جاءَكُم نَبَأُ القَومِ الأُلى دَرَجوا","وَخَلَّفوا لِلوَرى مِن ذِكرِهِم عَجَبا",0,"ب",2,0],["هَلْ جِئْتَ تَبْتُرُنَا أَوْ جِئْتَ تَزْجُرُنَا","مِنْ حَيْثُ تُوقِظُنَا الأَوْجَاعُ وَالغُمَمُ",1,"م",1,0],["هَل جاحِدٌ يابَني العَبّاسِ نِعمَتَهُ","أَبوكُمُ أَم عُبَيدُ اللَهِ أَم قُشَمُ",2,"م",1,0],["هل جائزٌ يا أبا العباس أو حسنٌ","وأنت شهمٌ ذكي القلب نَظّارُ",3,"ر",1,0],["هَل جَوادٌ بِأَبيَضٍ مِن بَني الأَص","فَرِ ضَخمِ الجُدودِ مَحضِ النِجارِ",4,"ر",1,0],["هل جَمدَ البحرُ من دجاكَ فما","ينتقلُ الحوت فيه بالسّبْحِ",5,"ح",1,0],["هل جالَ في تلكَ المشاهدِ مُصحفٌ","أم جال فيها مُصحفٌ وحُسامُ",6,"م",1,0],["هَل جئتَ مِنهُم أُناساً عَيشَهُم رغدٌ","أَم هَل نَزَلَت بِقطر غَير مَنكوبِ",7,"ب",1,0],["هل جاءها بالأمسِ منكَ على النوى","يومٌ كيومكَ للمسامع هائل",8,"ل",1,0],["هَل جَنابٌ نَحُلُّهُ غَيرَ دُنيا","نا فَإِنّا مِنها بِشَرِّ جَنابِ",9,"ب",1,0],["هَلْ جَاءَكُمْ نَبَأُ بِأَمْرٍ مُعْضِلٍ","رَاعَ الكِنَانَةَ فِي سِنِينَ خَوَالي",10,"ل",2,0],["هل جاءه ان أخاه متى","يَذكرْه يَشَرقْ بدموع المآق",11,"ق",1,0],["هَلْ جَارُكُمَا الأَعْلَىْ دَارَاً","مِنْ أَهْلِ المِفْتَاحِ السِّحْرِيْ؟",12,"ر",2,0],["هَل جاءَ قَومي وَأَخداني الَّذينَ هُمُ","إِن أُرمَ مِن قِبَلِ الرامينَ لا قِبلي",13,"ل",2,0],["هَل جددوا عهدا بمعهد رامة","أَم طنبوا في الشعب شعب العرعر",14,"ر",1,0],["هَل جاءَ مِن صَنعاءَ تاجِرُ بَزِّهِ","فَالوَشيُ مِن مَطوِيِّهِ مَنشورُ",15,"ر",1,0],["هل جاءهم بمثلث","ومربع أم هل سحر",16,"ر",1,0],["هَل جُلتَ في مُعتَرَكٍ لِلأَسى","فَاِضطَرَمَت لِلدَمعِ أَقرانُ",17,"ن",1,0],["هل جرى مني لذا الهجر ذنوب","لا لعمري بل هو الحظ الكئيب",18,"ب",1,1],["هل جائز يقنصن من","غير الذي فيهم جنى",19,"ن",2,0],["هل جنت الأرض حتى صرت تحرثها","وكنت ملقى عليها بين أحجار",20,"ر",1,0],["هَلْ جِئْتُ بالبُرْهانِ عِزّ الهُدَى","أَمْ لَسْتُ فيما قُلْتُهُ بَارِها",21,"ر",3,0],["هل جادَ بالإِكسيرِ عنِّي جابِرٌ","وعلَى المُحالِ غَدَوتُ ذا بُرهانِ",22,"ن",1,0],["هل جُهدُ طرفِيَ إِلاَّ سُهْد نَاظِره","وجُهْدُ جَفْنِيَ إِلاَّ سَكْبُ عَبْرَتِه",23,"ت",2,0],["هَلْ جَابِرٌ جَائِرٌ بالوَصْلِ لَمْ يَجُدِ","أَمْ نَاصِرٌ جَفْنِي عَلى السَّهَدِ",24,"د",1,1]]}