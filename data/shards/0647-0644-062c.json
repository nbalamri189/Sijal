{"poems":[[88,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[53,"أبلغ فتى آل بشر بل مؤملهم","https://www.aldiwan.net/poem62001.html","البسيط"],[47,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[82,"يا ليل هجر الحبيب طلت على","https://www.aldiwan.net/poem31525.html","المنسرح"],[107,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"خف دنيا كما تخاف شريفا","https://www.aldiwan.net/poem22360.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[92,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[173,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[276,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[287,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[290,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[409,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[447,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[458,"حمدت ربي على ذمي فأكثره","https://www.aldiwan.net/poem61236.html","البسيط"],[534,"أهوى الذي يهوى فإن عن ما","https://www.aldiwan.net/poem37079.html","السريع"],[543,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[580,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[591,"هل جابر جائر بالوصل لم يجد","https://www.aldiwan.net/poem17500.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122728","الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39135","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48662","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63845","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104963","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201559","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204581","البسيط"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60283","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74069","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91397","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91515","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36436","الدوبيت"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102751","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54454","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94446","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94511","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94487","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83667","البسيط"],[4392,"","https://poetry.dctabudhabi.ae/diwan/poem/101564","الكامل"],[4717,"فرجعناك إلى أمك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[4741,"هل سمعتيه يبكى .؟","https://www.poetsgate.com/ViewPoem.aspx?id=130129",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4767,"جرح في مسرح الفن","https://www.poetsgate.com/ViewPoem.aspx?id=190963",""],[4767,"مهر القريض","https://www.poetsgate.com/ViewPoem.aspx?id=194941",""],[4852,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=214379",""],[4858,"مرسي والسيسي","https://www.poetsgate.com/ViewPoem.aspx?id=144476",""],[4929,"البعوض","https://www.poetsgate.com/ViewPoem.aspx?id=199625",""],[5064,"محاولات تيه متشرّد","https://www.poetsgate.com/ViewPoem.aspx?id=199152",""],[5064,"أبدَيتَ بعد الوصل هجرَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=199156",""],[5082,"دمعة في مكتوب محبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=212404",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5219,"أين عهدي .... ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=195011",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5273,"كبرياء عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=28546",""],[5273,"مأساة العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=28757",""],[5277,"ويْ حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=203366",""],[5285,"باقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203581",""],[5376,"ليلةُ أنسٍ أم حميمُ الغضا","https://www.poetsgate.com/ViewPoem.aspx?id=203249",""],[5410,"رأيت وجدي لقلبي إرث إعمار","https://www.poetsgate.com/ViewPoem.aspx?id=151722",""],[5490,"هل جادك الوجد؟","https://www.poetsgate.com/ViewPoem.aspx?id=176135",""],[5616,"عامان","https://www.poetsgate.com/ViewPoem.aspx?id=205247",""],[5674,"ياوجها من الألق","https://www.poetsgate.com/ViewPoem.aspx?id=188335",""],[5674,"متمردة","https://www.poetsgate.com/ViewPoem.aspx?id=191453",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5781,"حبُّكَ...في الأول من نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=212813",""],[5861,"إلى مغرور","https://www.poetsgate.com/ViewPoem.aspx?id=188092",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""]],"verses":[["هَل جاءَكُم نَبَأُ القَومِ الأُلى دَرَجوا","وَخَلَّفوا لِلوَرى مِن ذِكرِهِم عَجَبا",0,"ب",2,0],["هَلْ جِئْتَ تَبْتُرُنَا أَوْ جِئْتَ تَزْجُرُنَا","مِنْ حَيْثُ تُوقِظُنَا الأَوْجَاعُ وَالغُمَمُ",1,"م",1,0],["هَل جاحِدٌ يابَني العَبّاسِ نِعمَتَهُ","أَبوكُمُ أَم عُبَيدُ اللَهِ أَم قُشَمُ",2,"م",1,0],["هل جائزٌ يا أبا العباس أو حسنٌ","وأنت شهمٌ ذكي القلب نَظّارُ",3,"ر",1,0],["هَل جَوادٌ بِأَبيَضٍ مِن بَني الأَص","فَرِ ضَخمِ الجُدودِ مَحضِ النِجارِ",4,"ر",1,0],["هل جَمدَ البحرُ من دجاكَ فما","ينتقلُ الحوت فيه بالسّبْحِ",5,"ح",1,0],["هل جالَ في تلكَ المشاهدِ مُصحفٌ","أم جال فيها مُصحفٌ وحُسامُ",6,"م",1,0],["هَل جئتَ مِنهُم أُناساً عَيشَهُم رغدٌ","أَم هَل نَزَلَت بِقطر غَير مَنكوبِ",7,"ب",1,0],["هل جاءها بالأمسِ منكَ على النوى","يومٌ كيومكَ للمسامع هائل",8,"ل",1,0],["هَل جَنابٌ نَحُلُّهُ غَيرَ دُنيا","نا فَإِنّا مِنها بِشَرِّ جَنابِ",9,"ب",1,0],["هَلْ جَاءَكُمْ نَبَأُ بِأَمْرٍ مُعْضِلٍ","رَاعَ الكِنَانَةَ فِي سِنِينَ خَوَالي",10,"ل",2,0],["هل جاءه ان أخاه متى","يَذكرْه يَشَرقْ بدموع المآق",11,"ق",1,0],["هَلْ جَارُكُمَا الأَعْلَىْ دَارَاً","مِنْ أَهْلِ المِفْتَاحِ السِّحْرِيْ؟",12,"ر",2,0],["هَل جاءَ قَومي وَأَخداني الَّذينَ هُمُ","إِن أُرمَ مِن قِبَلِ الرامينَ لا قِبلي",13,"ل",2,0],["هَل جددوا عهدا بمعهد رامة","أَم طنبوا في الشعب شعب العرعر",14,"ر",1,0],["هَل جاءَ مِن صَنعاءَ تاجِرُ بَزِّهِ","فَالوَشيُ مِن مَطوِيِّهِ مَنشورُ",15,"ر",1,0],["هل جاءهم بمثلث","ومربع أم هل سحر",16,"ر",1,0],["هَل جُلتَ في مُعتَرَكٍ لِلأَسى","فَاِضطَرَمَت لِلدَمعِ أَقرانُ",17,"ن",1,0],["هل جرى مني لذا الهجر ذنوب","لا لعمري بل هو الحظ الكئيب",18,"ب",1,1],["هل جائز يقنصن من","غير الذي فيهم جنى",19,"ن",2,0],["هل جنت الأرض حتى صرت تحرثها","وكنت ملقى عليها بين أحجار",20,"ر",1,0],["هَلْ جِئْتُ بالبُرْهانِ عِزّ الهُدَى","أَمْ لَسْتُ فيما قُلْتُهُ بَارِها",21,"ر",3,0],["هل جادَ بالإِكسيرِ عنِّي جابِرٌ","وعلَى المُحالِ غَدَوتُ ذا بُرهانِ",22,"ن",1,0],["هل جُهدُ طرفِيَ إِلاَّ سُهْد نَاظِره","وجُهْدُ جَفْنِيَ إِلاَّ سَكْبُ عَبْرَتِه",23,"ت",2,0],["هَلْ جَابِرٌ جَائِرٌ بالوَصْلِ لَمْ يَجُدِ","أَمْ نَاصِرٌ جَفْنِي عَلى السَّهَدِ",24,"د",1,1],["هَل جَعلتُم تَلَفي مِن حُبِّكُم","وتَجَنّيكُم جَزاءً وَنَكالا",25,"ل",2,0],["هَلْ جُسومٌ يومَ النَّوى ودَّعوها","باقِياتٌ لِسُوءِ ما أوْدَعُوها",26,"ه",2,1],["هل جئت بالشورى بهيجا معلماً","أم جاء فيك من السماء رسول",27,"ل",1,0],["هل جاء يوم الشرق تق","سمه العداة ولا مفرا",28,"ر",2,0],["هل جائزٌ أن يُعشقَ الفرَّاءُ في","حُكْمِ الهوى أو أَنْ يناك الأَحْمر",29,"ر",1,0],["هل جاء في طلب القسى لحتفه","أم جاء يطلب عنده الأوتارا",30,"ر",2,0],["هل جاء إلا أخذه وأليم بط","شته بجاحدة له مستنكفه",31,"ف",2,0],["هَل جَاءَكُم فِي ذَاكَ مِن أثَر وَمِن","نَص وَمِن نَظَرٍ وَمِن بُرهَانِ",32,"ن",1,0],["هَل جَاءَكُم أثرٌ بِأنَّ صَحَابَهُ","سَالُوهُ فُتيَا وَهوَ فِي الأكفَانِ",32,"ن",1,0],["هل جئت في دين النبيّ ببدعة","أم كنت في أحكامه مرتابا",33,"ب",2,0],["هل جدَّدوا لِعيشهم مستقبلاً","ولشبيبةٍ تَهيمُ كالقطا",34,"ا",1,0],["هلجان قبرس راس عباس كذا","والبارقا اندرست ولموشة",35,"ه",1,0],["هل جناحٌ به أطير فإني","كيفما سرتُ بالورى أتصادم",36,"م",1,0],["هل جئت دهري هذا في أواخره","أو أنني في وجودي سابق زمني",37,"ن",2,0],["هَل جَلَستَ العَصرَ مِثلي","بَينَ جَفناتِ العِنَب",38,"ب",1,0],["هل جاء فيها ذا كلام هالك","فسل الصحاح وسل كتاب المجمل",39,"ل",1,0],["هَل جازَ عَبد اللَه أَمر مُنافِق","صلّى الصَلاة مريبة أَو صاما",40,"م",2,0],["هَل جنيّ الوَرد فَردٌ","أَم بِهِ الرَيحان جالا",41,"ل",2,0],["هَل جزتِ أَرضَ حَبيب عَني ابتعدت","أَوطانُه فبهذا الطيب ذكّاكِ",42,"ك",1,0],["هَل جَدَّدَ لي حَديثكم تذكارا","إِلّا وأُحِسُّ في ضُلوعي نارا",43,"ر",2,1],["هل جيرة بلوى العقيق أقاموا","يلفى لديهم حرمة وذمام",44,"م",1,1],["هل جائزٌ في العُلى لرَبِّ عُلىً","أنْ يَغْتَدي هاجراً لِربِّ عُلى",45,"ل",2,0],["هل جاز ينسبها لجمع ثعالبٍ","يَهجو بها هَذا الزلال المُسكرا",46,"ر",2,0],["هل جاز أن تبغوا القلا عمداً إلى","من هم على شرط المحبة ثابتين",47,"ن",1,0],["هل جاز يا سؤلي تضني باللقا","وَالقلب آلى الدهر لن يتصبَّرا",48,"ر",2,0],["هَل جاءَ تَوفيقُ لِلتَوفيقِ يا سيّدي","ما بَينَ تُرك وَعُربٍ فطنَةَ الفِطَنِ",49,"ن",1,0],["هل جايزٌ وضع المثاني كالأغا","ني في المغاني مجلس السفاء",50,"ا",2,0],["هل جُننتمْ ؟! فابعدوه .. واخسئوا","إِنْ ظننتُمْ أنَّ هذا من بَنِيْ",51,"ي",1,0],["هَلْ جِئْتَهُ يا بَدْرُ عَنّىِ شَاكِياً","فَالْقَلْبُ فِي وَجْدٍ يُرِيْدُ سَرَاحَهُ",52,"ح",2,0],["هل جنا المرجفون من كل بحر","فيه خاضوا لآلئا أو حليا",53,"ي",2,0],["هل جئتَ من ربِّ العباد بدعوةٍ","أم جئتَ منه إلى الخليقة مرسلا ؟",54,"ل",2,0],["هل جفَّ نبعُ الشعرِ أم ما ذا جرى","إنَّا نرى مُهرَ القريضِ تضوَّرا",55,"ر",2,1],["هل جئتَ للدنيا ..","سِوى لتكونَ للمولى .. خَلَفْ؟",56,"ف",1,0],["هل جئتَ تحرسُ شرعة القرآن يا","سيسيُّ أم أسرعتَ تسعى للفجور؟",57,"ر",1,0],["هل جئتَ تُقنعني بأنَّك عازفٌ","إذهبْ فصوتُكَ لا يطاقُ جواري",58,"ر",2,0],["هَلْ جَرَى الحُبُّ فِي خَيَالاتِ نَوْمٍ","فَمحَا الجَفْنُ مَا تَقُولُ الجُفُونُ",59,"ن",1,0],["هَل جِئتُ أَنثُرُ دَمعِيَ ال","شَّاكِي لتنْثُرَ أَنْتَ دُرَّكْ",60,"ك",1,0],["هل جاء في الأنباءِ ماهزّ الورى؟","إنّ الخيامَ غدت تُجَمّلُ مئزري",61,"ر",2,0],["هَلْ جَزَلْنَاْ الرَّيْقَ حَتْمَاً وَاحْتَدَمْنَاْهُ سِجَالْ","هَلْ رَمَيْنَاْ الجَمْرَ آسَاً بَينَ أَنْفَاْسِ الجَمَالْ",62,"ل",1,0],["هل جزائي؟من وفائي","صنت حبا أجبرتني",63,"ن",2,0],["هَل جُعتَ قُل لِي .. هَل ظَمِئتَ مُرَدِدًا","أُمَّاهُ .. ابنُكِ ضَاحِكًا قَد أزمَعَا",64,"ع",2,0],["هل جئتَ تُوقِدُ فيَّ ذاكِرَتي","أمْ جئتَ تُكْمِلُ ما بدأناهُ",65,"ا",2,0],["هل جفَّ ماؤكَ من هجرٍ تكابدُهُ","أم ترتجي توبةً أفصحْ فما العِلَلُ",66,"ل",1,0],["هلْ جئتَ مشتكياً هجرَ الحبيبِ لنا","أم جئتَ تُصلحُ ما أزرى بكَ المَلَلُ",66,"ل",1,0],["هل جعلتَ الثأرَ غِلّاً أحمراً","ورفعتَ النأيَ للقُرْبِ شعارا",67,"ر",2,0],["هلْ جاء بالآفاقِ يذرفُ دمعةً","وجَدتْ إلى وردِ الخدودِ سبيلا ؟!",68,"ل",2,0],["هل جاوزَ الثوَّارُ حقاً لهم","فاستنزفوا الصبرَ بعينِ الرضا",69,"ض",2,0],["هل جئتَ تزرع في صدري سهام لظىً","أم جئتَ تُتْبِعُ إعصاراً بإعصار ِ",70,"ر",1,0],["هل جادك الوجدُ والأشواقُ تحترقُ","وأمعنَ السّهد