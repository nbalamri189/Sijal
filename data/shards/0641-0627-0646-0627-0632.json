{"poems":[[65,"طلبنا النوال الغمر والخير يبتغى","https://www.aldiwan.net/poem46193.html","الطويل"],[121,"أُغاضبها","https://www.aldiwan.net/poem24054.html","المتدارك"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93854","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130097","الطويل"],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5190,"اعذريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78335&r=&rc=48",""]],"verses":[["فإنّ ازْدِيادَ المالِ منْ غَيرِ نائِلٍ","يَشين الفَتى كالسِّن لُزَّ بهِ الشَّغا",0,"غ",2,0],["فأُنازِعُها وتُنازِعُني","وأُحاكِمُها، وتُحاكِمُني",1,"ن",2,0],["فإن ازدواج الشكل بالشكل مشعر","بقوة تمييز وصحة فطرة",2,"ه",1,0],["فإن أزعقوا بالدردنيل مشارباً","فقد صدروا في مصر عن حوض مزعق",3,"ق",1,0],["فَإنَّ أزواماً لَكَ المذكورَه","قريبُ مايَه زامِ هِي مشهورَه",4,"ه",1,0],["فإن ازدهت عجباً مفاخرها زها","وسما بأبهة عليها أبهى",5,"ب",3,0],["فإن أَزهرت فالبحرُ يسقي أصولها","وينزلها الغيث الغزير فيهطلُ",6,"ل",1,0],["فَأَنَا زَرْعُهَا مَخِيلًا نَضِيدًا","وَحِصِيدًا فِي جُرْنِها وَطَحِينَا",7,"ن",2,0],["فإنْ أَزْمَعَتْ هجري وضنَّت بوصلها","قبلتُ النَّوى منها ، وفيهِ فنائيا",8,"ي",2,0]]}