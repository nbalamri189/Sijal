{"poems":[[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[91,"أي شيء في العيد أهدي إليك","https://www.aldiwan.net/poem9050.html","عموديه"],[91,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[45,"أمخلفي يا فتح أنت وظاعن","https://www.aldiwan.net/poem10665.html","الكامل"],[87,"يا قلب ما لك لا تفيق","https://www.aldiwan.net/poem8342.html","مجزوء الرمل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[46,"أما الحياة ففقر لا غنى معه","https://www.aldiwan.net/poem22619.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"]],"verses":[["أَم خِفتَ تِلكَ الراصِدا","تِ هُناكَ مِن شُهُبٍ وَنار",0,"ر",1,0],["أمْ خِلْتَ أَنِّي إن مدحتُكَ خِلْتنِي","كافأتُ طَوْلَكَ حَاشَ لِي أَنْ أَطمَحا",1,"ح",2,0],["أمْ خفْتَ إن جُمِعَتْ لِنفْسِي نعْمَتَا","حَظٍ وشُكْرٍ ناطِقٍ أن أمرحا",1,"ح",2,0],["أَمخُموراً وَلَيسَ في الأَرضِ خَمرٌ","كَالَّتي تَسكُبينَ مِن لَحظَيكِ",2,"ك",1,0],["أَم خِفتِ أَن يَأتي الدُجى الجاني وَلا تَأتي النُجوم","أَنا لا أَرى ما تَلمَحينَ مِنَ المَشاهِدِ إِنَّما",3,"م",2,0],["أَمخبرٌ أحد النجو","م لشمسنا بعض المطالب",4,"ب",1,0],["أَمُخَلِّفي يا فَتحُ أَنتَ وَظاعِنٌ","في الظاعِنينَ وَشاهِدٌ وَمُغَيِّبي",5,"ي",1,1],["أَمْ خِلْتَ أَنَّ يَدَ الزَّمَا","نِ قَصِيرَةٌ عَنْ أَنْ تَنَالَكْ",6,"ك",1,0],["أم خولطت فيه أوهامٌ وأخيلةٌ","كما تخالطت الألوانُ في الجُون",7,"ن",1,0],["أم خَطُّ يَاقَوتَ فِي تشدِيدهِ ألِفاً","فِي مُصحَفِ الحُسنِ رَأيَ العَينِ وَالبَصَرِ",8,"ر",1,0],["أَمُختَرِمي رَيبُ المَنونِ وَلَم أَنَل","مِنَ المالِ ما أَعصي بِهِ وَأُطيعُ",9,"ع",1,0],["أمُخَتَّماً منهمْ بقائِمِ سيفِهِ","ومُوَشَّحاً بنِجادِهِ المتقلِّص",10,"ص",1,0],["أَم خُصَّ بِالأَمَلِ المَبسوطِ كُلُّ فَتىً","مِن آلِ حَوّاءَ يُنسي وِردُه الصَدَرا",11,"ر",2,0],["أم خِفْتَ من قلم الرَّقي","بِ فما أشرتَ وما أبنْتْ",12,"ت",1,0],["أمخلوقةٌ هيَ أم ربَّةٌ","تسيرُ الخلائقُ في نِيرها",13,"ه",2,0]]}