{"poems":[[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[91,"أي شيء في العيد أهدي إليك","https://www.aldiwan.net/poem9050.html","عموديه"],[91,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[45,"أمخلفي يا فتح أنت وظاعن","https://www.aldiwan.net/poem10665.html","الكامل"],[87,"يا قلب ما لك لا تفيق","https://www.aldiwan.net/poem8342.html","مجزوء الرمل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[46,"أما الحياة ففقر لا غنى معه","https://www.aldiwan.net/poem22619.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[144,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[212,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[212,"أمختار لا توقظ شجوني فإنني","https://www.aldiwan.net/poem46309.html","الطويل"],[223,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[262,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[271,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[329,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[365,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[410,"يا نفس أين جميل صبرك","https://www.aldiwan.net/poem31864.html","مجزوء الكامل"],[449,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[453,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[459,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[459,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[465,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[466,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[517,"يا أيها الركب اني غير تابعكم","https://www.aldiwan.net/poem48587.html","البسيط"]],"verses":[["أَم خِفتَ تِلكَ الراصِدا","تِ هُناكَ مِن شُهُبٍ وَنار",0,"ر",1,0],["أمْ خِلْتَ أَنِّي إن مدحتُكَ خِلْتنِي","كافأتُ طَوْلَكَ حَاشَ لِي أَنْ أَطمَحا",1,"ح",2,0],["أمْ خفْتَ إن جُمِعَتْ لِنفْسِي نعْمَتَا","حَظٍ وشُكْرٍ ناطِقٍ أن أمرحا",1,"ح",2,0],["أَمخُموراً وَلَيسَ في الأَرضِ خَمرٌ","كَالَّتي تَسكُبينَ مِن لَحظَيكِ",2,"ك",1,0],["أَم خِفتِ أَن يَأتي الدُجى الجاني وَلا تَأتي النُجوم","أَنا لا أَرى ما تَلمَحينَ مِنَ المَشاهِدِ إِنَّما",3,"م",2,0],["أَمخبرٌ أحد النجو","م لشمسنا بعض المطالب",4,"ب",1,0],["أَمُخَلِّفي يا فَتحُ أَنتَ وَظاعِنٌ","في الظاعِنينَ وَشاهِدٌ وَمُغَيِّبي",5,"ب",2,1],["أَمْ خِلْتَ أَنَّ يَدَ الزَّمَا","نِ قَصِيرَةٌ عَنْ أَنْ تَنَالَكْ",6,"ك",1,0],["أم خولطت فيه أوهامٌ وأخيلةٌ","كما تخالطت الألوانُ في الجُون",7,"ن",1,0],["أم خَطُّ يَاقَوتَ فِي تشدِيدهِ ألِفاً","فِي مُصحَفِ الحُسنِ رَأيَ العَينِ وَالبَصَرِ",8,"ر",1,0],["أَمُختَرِمي رَيبُ المَنونِ وَلَم أَنَل","مِنَ المالِ ما أَعصي بِهِ وَأُطيعُ",9,"ع",1,0],["أمُخَتَّماً منهمْ بقائِمِ سيفِهِ","ومُوَشَّحاً بنِجادِهِ المتقلِّص",10,"ص",1,0],["أَم خُصَّ بِالأَمَلِ المَبسوطِ كُلُّ فَتىً","مِن آلِ حَوّاءَ يُنسي وِردُه الصَدَرا",11,"ر",2,0],["أم خِفْتَ من قلم الرَّقي","بِ فما أشرتَ وما أبنْتْ",12,"ت",1,0],["أمخلوقةٌ هيَ أم ربَّةٌ","تسيرُ الخلائقُ في نِيرها",13,"ه",2,0],["أَم خِلتَ أَنَّ المَجدَ لَيسَ يَنالُهُ","مَن لا يَكونُ عَلى الرَدى هَجّاما",14,"م",2,0],["أمخلفٌ أنت ما هذا أما شهدت","بصدق وعدك أيام الثلاثاء",15,"ا",2,0],["أمختارُ لا توقظ شجوني فإنني","بصوتك أستوحي لواعج أشجاني",16,"ن",2,1],["أم خان عهدكم الذي","ظنّيتموه بكم ضنين",17,"ن",1,0],["أم خلتم الأوهام أن","جح في الأمور من البطين",17,"ن",1,0],["أم خلت أن أساك تمحو الأسى","كلا ورب جراحة لن تحسما",18,"م",2,0],["أمخاطبينَ اللهَ باللغةِ التي","شَرفت بتنزيلِ الكتابِ الأنوَر",19,"ر",1,0],["أم خداع نسجته","لضحاياها الحياه",20,"ه",1,0],["أم خَطَّ عينُ عُبَيْدِ اللهِ كاتبُه","لمّا أرادَ له تَسْطيرَ عُنْوان",21,"ن",1,0],["أم خِلتِ أنّ نوائبَ الدْ","دُنيا لغيرِكِ لا تَنوبُ",22,"ب",1,0],["امخيمين بذى الأراك وواردى","ماء هناك اليه يهدى الضال",23,"ل",1,0],["أمْ خوْط بان قد تثنى يانِعاً","وافى عليه الطيرُ يشدو ساجعا",24,"ع",2,0],["أم خطأً فسار عم","داً قتلُها أنفسَنا",25,"ن",2,0],["أمخيّمون على اللوى من عالج","أم لاحقون الماء في ماوانِ",26,"ن",1,0],["أمخجلة الخطّيِ قداً تعطفاً","على ذي حشى عيَّ الأساةَ ندوبها",27,"ب",3,0],["أمَّ خلدون ، والد ُّنا أمَد ٌ","كلُّ ما ظلَّ في الد ُّنا أمَد ُ",28,"د",1,0],["أمَّ خلدون ، نحنُ مِن وَجَع ٍ","ضِلعُنا عن أخيه ِيَبتَعِد ُ",28,"د",1,0],["أمَّ خلدون..أيُّ بارقة ٍ","حلوَة ٍجاءَنا بها الرَّشَد ُ؟",28,"د",1,0],["أمَّ خَلدون ، لا أ قولُ كما..","لا ، ولا أرصُد ُالذي رَصَدوا",28,"د",3,0],["أمَّ خَلدون إنَّ بي غَبَشاً","ألفُ فَجْر ٍعليه ِيَنعَقِد ُ",28,"د",1,0],["أمَّ خَلدون كَفكِفي وَجَعي","وَعِدِيني ببَعض ِما أعِد ُ",28,"د",1,0],["أمَّ خَلدون ..أيُّ مُعْجِزَة ٍ","تُقنِعُ العِرقَ كيفَ يَنفصِد ُ؟!",28,"د",1,0],["أمَّ خلدون..لَملِمي سَهَري","وارْقدُي بي فالناسُ قد رَقدوا",28,"د",3,0],["ام خَبِّروني عَن دائي يَعلمكُم","وَاِعلَم الناس بِالداءِ الاطَبّونا",29,"ن",2,0]]}