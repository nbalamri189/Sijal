{"poems":[[88,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[93,"أي شيء في العيد أهدي إليك","https://www.aldiwan.net/poem9050.html","عموديه"],[93,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[47,"أمخلفي يا فتح أنت وظاعن","https://www.aldiwan.net/poem10665.html","الكامل"],[89,"يا قلب ما لك لا تفيق","https://www.aldiwan.net/poem8342.html","مجزوء الرمل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[83,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[77,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"أما الحياة ففقر لا غنى معه","https://www.aldiwan.net/poem22619.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[215,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[215,"أمختار لا توقظ شجوني فإنني","https://www.aldiwan.net/poem46309.html","الطويل"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[333,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[415,"يا نفس أين جميل صبرك","https://www.aldiwan.net/poem31864.html","مجزوء الكامل"],[453,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[457,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[463,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[469,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[521,"يا أيها الركب اني غير تابعكم","https://www.aldiwan.net/poem48587.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122721","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122697","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62490","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59244","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96634","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80233","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133816","الخفيف"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100619","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49543","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49565","الطويل"],[1878,"","https://poetry.dctabudhabi.ae/diwan/poem/202460",""],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177832","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53074","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53147","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100373","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100315","الكامل"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96433","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132711","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108109","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66344","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66430","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205690","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127283","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111199","الكامل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35060","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83410","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139591",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204203",""],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[4984,"ما تخبئه النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[5183,"الأبيات الحرى","https://www.poetsgate.com/ViewPoem.aspx?id=180266",""],[5212,"شبيه موسى","https://www.poetsgate.com/ViewPoem.aspx?id=212105",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5464,"سبايا","https://www.poetsgate.com/ViewPoem.aspx?id=36084",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5582,"نَهَكَ الغَرامُ فُؤادَهُ وَحَشاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187332",""],[5909,"ألحبُ أقوى أم وعاء الدجلِ","https://www.poetsgate.com/ViewPoem.aspx?id=210576",""],[5948,"أمُخبري أنت يا قتيبةُ عن","https://www.poetsgate.com/ViewPoem.aspx?id=100596",""]],"verses":[["أَم خِفتَ تِلكَ الراصِدا","تِ هُناكَ مِن شُهُبٍ وَنار",0,"ر",1,0],["أمْ خِلْتَ أَنِّي إن مدحتُكَ خِلْتنِي","كافأتُ طَوْلَكَ حَاشَ لِي أَنْ أَطمَحا",1,"ح",2,0],["أمْ خفْتَ إن جُمِعَتْ لِنفْسِي نعْمَتَا","حَظٍ وشُكْرٍ ناطِقٍ أن أمرحا",1,"ح",2,0],["أَمخُموراً وَلَيسَ في الأَرضِ خَمرٌ","كَالَّتي تَسكُبينَ مِن لَحظَيكِ",2,"ك",1,0],["أَم خِفتِ أَن يَأتي الدُجى الجاني وَلا تَأتي النُجوم","أَنا لا أَرى ما تَلمَحينَ مِنَ المَشاهِدِ إِنَّما",3,"م",2,0],["أَمخبرٌ أحد النجو","م لشمسنا بعض المطالب",4,"ب",1,0],["أَمُخَلِّفي يا فَتحُ أَنتَ وَظاعِنٌ","في الظاعِنينَ وَشاهِدٌ وَمُغَيِّبي",5,"ب",2,1],["أَمْ خِلْتَ أَنَّ يَدَ الزَّمَا","نِ قَصِيرَةٌ عَنْ أَنْ تَنَالَكْ",6,"ك",1,0],["أم خولطت فيه أوهامٌ وأخيلةٌ","كما تخالطت الألوانُ في الجُون",7,"ن",1,0],["أم خَطُّ يَاقَوتَ فِي تشدِيدهِ ألِفاً","فِي مُصحَفِ الحُسنِ رَأيَ العَينِ وَالبَصَرِ",8,"ر",1,0],["أَمُختَرِمي رَيبُ المَنونِ وَلَم أَنَل","مِنَ المالِ ما أَعصي بِهِ وَأُطيعُ",9,"ع",1,0],["أمُخَتَّماً منهمْ بقائِمِ سيفِهِ","ومُوَشَّحاً بنِجادِهِ المتقلِّص",10,"ص",1,0],["أَم خُصَّ بِالأَمَلِ المَبسوطِ كُلُّ فَتىً","مِن آلِ حَوّاءَ يُنسي وِردُه الصَدَرا",11,"ر",2,0],["أم خِفْتَ من قلم الرَّقي","بِ فما أشرتَ وما أبنْتْ",12,"ت",1,0],["أمخلوقةٌ هيَ أم ربَّةٌ","تسيرُ الخلائقُ في نِيرها",13,"ه",2,0],["أَم خِلتَ أَنَّ المَجدَ لَيسَ يَنالُهُ","مَن لا يَكونُ عَلى الرَدى هَجّاما",14,"م",2,0],["أمخلفٌ أنت ما هذا أما شهدت","بصدق وعدك أيام الثلاثاء",15,"ا",2,0],["أمختارُ لا توقظ شجوني فإنني","بصوتك أستوحي لواعج أشجاني",16,"ن",2,1],["أم خان عهدكم الذي","ظنّيتموه بكم ضنين",17,"ن",1,0],["أم خلتم الأوهام أن","جح في الأمور من البطين",17,"ن",1,0],["أم خلت أن أساك تمحو الأسى","كلا ورب جراحة لن تحسما",18,"م",2,0],["أمخاطبينَ اللهَ باللغةِ التي","شَرفت بتنزيلِ الكتابِ الأنوَر",19,"ر",1,0],["أم خداع نسجته","لضحاياها الحياه",20,"ه",1,0],["أم خَطَّ عينُ عُبَيْدِ اللهِ كاتبُه","لمّا أرادَ له تَسْطيرَ عُنْوان",21,"ن",1,0],["أم خِلتِ أنّ نوائبَ الدْ","دُنيا لغيرِكِ لا تَنوبُ",22,"ب",1,0],["امخيمين بذى الأراك وواردى","ماء هناك اليه يهدى الضال",23,"ل",1,0],["أمْ خوْط بان قد تثنى يانِعاً","وافى عليه الطيرُ يشدو ساجعا",24,"ع",2,0],["أم خطأً فسار عم","داً قتلُها أنفسَنا",25,"ن",2,0],["أمخيّمون على اللوى من عالج","أم لاحقون الماء في ماوانِ",26,"ن",1,0],["أمخجلة الخطّيِ قداً تعطفاً","على ذي حشى عيَّ الأساةَ ندوبها",27,"ب",3,0],["أمَّ خلدون ، والد ُّنا أمَد ٌ","كلُّ ما ظلَّ في الد ُّنا أمَد ُ",28,"د",1,0],["أمَّ خلدون ، نحنُ مِن وَجَع ٍ","ضِلعُنا عن أخيه ِيَبتَعِد ُ",28,"د",1,0],["أمَّ خلدون..أيُّ بارقة ٍ","حلوَة ٍجاءَنا بها الرَّشَد ُ؟",28,"د",1,0],["أمَّ خَلدون ، لا أ قولُ كما..","لا ، ولا أرصُد ُالذي رَصَدوا",28,"د",3,0],["أمَّ خَلدون إنَّ بي غَبَشاً","ألفُ فَجْر ٍعليه ِيَنعَقِد ُ",28,"د",1,0],["أمَّ خَلدون كَفكِفي وَجَعي","وَعِدِيني ببَعض ِما أعِد ُ",28,"د",1,0],["أمَّ خَلدون ..أيُّ مُعْجِزَة ٍ","تُقنِعُ العِرقَ كيفَ يَنفصِد ُ؟!",28,"د",1,0],["أمَّ خلدون..لَملِمي سَهَري","وارْقدُي بي فالناسُ قد رَقدوا",28,"د",3,0],["ام خَبِّروني عَن دائي يَعلمكُم","وَاِعلَم الناس بِالداءِ الاطَبّونا",29,"ن",2,0],["أمُخَبِّري بالشّعبِ كَيفَ بَشامُهُ","مِن بَعدِ ساكِنِه وَما مأثُولُه",30,"ل",2,0],["أمُخَبِّري أرأيتَ سَفحَ الرَملِ سَف","حَ الرَّملِ بَعدَهُم وبارقَ بارِقا",31,"ق",2,0],["أم خاله الأسود الداعي بصَائرنا","بمنبر الخد فانقادت له شرَعا",32,"ع",2,0],["أمُخَلِّفًا جَسَدِي وَسَالِبَ مُهْجَتِي","مَاذا يَضُرُّك لَوْ سَلَبْت البَاقِي",33,"ق",2,0],["أَمخجلة لِلخيزرانِ تهزّعاً","إِذا ما تثنّى في غلائلها القدُّ",34,"د",1,0],["أَم خِفتِ مِني خَلعَ مُلكِكِ سائِباً","فَأَرَيتِ إِرهابَ المَليك المُطلَقِ",35,"ق",1,0],["أم خفقة وانتفاض","ووثبة وانتشار",36,"ر",1,0],["ام خمرةٌ دارت على","فكر اللبيب فعربدا",37,"د",2,0],["أُمُخْلِفَةٌ تلك الوسائلُ بعدما","شَدَدنا قُوَاها بالنُّجومِ الثَّواقب",38,"ب",1,0],["أمُخْبِرَتي كيفَ استقرّتْ بكِ النّوَى","على أنّ عندي ما يزيدُ على الخبر",39,"ر",1,0],["أم خلت آس عذارك ال","منشوق يحمي منك وردك",40,"ك",1,0],["أمختبطاً والليل داج ألا أرح","قلاصك لا يأتي عليه مسيرها",41,"ر",3,0],["أمخيمين على نوى أشتاقكم","شوقاً يجدد لي الصبابة والجوى",42,"ج",3,1],["أمخترع المعروف دون معاشر","بحارهم في جنب نائله ثمد",43,"د",1,0],["أمخترع المعروف دون معاشر","لهم أعين من منظر الحق تطرف",44,"ف",1,0],["أم خَلفَنَا وأمَامَنَا سُبحَانَهُ","أم هَل يُرَى مِن فَوقِنَا بِبَيَانِ",45,"ن",1,0],["أم خان عند عتو المبطلين بها","عن نصر خالقه إذا كان مجانا",46,"ن",2,0],["أم خود تزهو في حلل","أم تلك حلى حسن تؤثر",47,"ر",1,0],["امخاطر الغمرات بالغمرات بل","ومقابل الاهوال بالاهوال",48,"ل",1,0],["امخاتل الصياد من كثب رشا","ومناضل الآساد ظبي كناس",49,"س",1,0],["أمخلدُ لم تترك لنفسي بقيةً","وزدتَ على ما كُنتَ أرجُوَ وأمُلُ",50,"ل",1,0],["أم خطاب لهم أتى فيه نسخ","رفع الحكم لي وأبقى ارتسامه",51,"م",2,0],["أم خرد هيف المعاطف قلدّت","بفريد درّ بالجمان مفصل",52,"ل",1,0],["أم خلت إن طباعة قد بدلت","بعد الغنى فغدا كريماً يغدق",53,"ق",1,0],["أم خمرة أبرزت عند المزاج لها","بأفق كاساتها شهباً من الحببِ",54,"ب",1,0],["أم خمرة صهباء غاديّة","قلدها المزج بدرّ الحباب",55,"ب",1,0],["أمخطئٌ أنا إن أحسستُ في كبدي","شوقين من نشوةٍ فيها وإرواء",56,"ا",2,0],["أم خمرة جليت بكأس رائق","أم ريق من قد هام فيه جناني",57,"ن",2,0],["أم خرد غيد بسمن عن اللمى","فشغفن قلب الواجد الولهان",58,"ن",1,0],["أَم خِلتهُ بِنهاه أَو بغرامهِ","يَرضى بِأَحكام الآله القاسي",59,"س",2,0],["أَم خَبا العَدلُ وهو نورُ البَرايا","وَفَشا الظُلمُ حالِكَ الظُلماتِ",60,"ت",1,0],["أمختار دين الله والدولة التي","بها للأيادى مسرحق ومراح",61,"ح",1,0],["أم خلتها أشبه بالصواب","فهات ما عندك من جواب",62,"ب",1,0],["إمخلدٍ في سنام المجد تخليدي","أرسى من إطويق وجبال السراواتي",63,"ت",2,0],["أم خُيلت لي في شبابي كأنها","بنت الربيع فراشة أبدا تحوم",64,"م",1,0],["أم خمول والورى قد أحدثت","بدعا خالفت الشرع الأجل",65,"ل",1,0],["أم خوفته الليالي السود مقبلة","بالسوء فالتاث بالأجداث تؤويه",66,"ي",2,0],["أَم خاتَمُ المَلِكِ الذي بِصَلاتِهِ","مُتَصَدِّقاً مَلَكَ الخَلائِقَ حَيدَرُ",67,"ر",1,0],["أم خاتَمُ السِّبطِ ابنَ بِنتِ مُحمَّدٍ","ذا مَنْ نُسائِلُ هَلْ لَهُ مَنْ يَثأرُ؟",67,"ر",1,0],["أمخر الدرب والدروب بموج","بين واد تصبني وتلاع",68,"ع",1,0],["أمْ خيلَ معتصِمٍ تذودُ بهاِ","عنْ حُرَّة ٍ صاحتْ وعنْ سُنَن ِ ؟",69,"ن",1,0],["أَمُخَبِّرِي ما كانَ مِنْ خَبَرِ اللِّوَى","هَلْ خَفَّ ساكِنُهُ وَحُلْنَ عُهُودُهُ",70,"د",2,0],["أَمُخَبِّرِي عَمَّنْ عَهِدْتُ مِنَ الأُولِي","بانُوا وَعَمَّنْ لَمْ أَزَلْ أَهْواهُ",71,"ا",2,0],["أم خفقة منها الحنايا ركّعٌ؟","أو سُجَّدٌ أو متلفات المُقلِ ؟",72,"ل",1,0],["أمُخبري أنت يا قتيبةُ عن","أنَفكَ أم أنتَ كأتمٌ خبرهُ",73,"ر",2,1]]}