,"https://www.aldiwan.net/poem69105.html","الطويل"],[50,"أباهل إني حين لاح قتيري","https://www.aldiwan.net/poem63805.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"يا للرجال أمن شخص بأجياد","https://www.aldiwan.net/poem63932.html","البسيط"],[50,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[50,"يا صاح لا تجر في لومي وتأنيبي","https://www.aldiwan.net/poem64829.html","البسيط"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[7,"ليهنئ بني ذبيان أن بلادهم","https://www.aldiwan.net/poem1982.html","الطويل"],[46,"أغنى الأنام تقي في ذرى جبل","https://www.aldiwan.net/poem22250.html","البسيط"],[46,"الروح تنأى فلا يدرى بموضعها","https://www.aldiwan.net/poem22331.html","البسيط"],[46,"الله يشهد أني جاهل ورع","https://www.aldiwan.net/poem22468.html","البسيط"],[46,"قيان غدت خمسا وعشرا على عصا","https://www.aldiwan.net/poem22515.html","الطويل"],[46,"إذا زادك المال افتقارا وحاجة","https://www.aldiwan.net/poem22520.html","الطويل"],[46,"لعمري لقد فضح الأولين","https://www.aldiwan.net/poem22598.html","المتقارب"],[46,"ذهاب عيني صان الجسم آونة","https://www.aldiwan.net/poem22833.html","البسيط"],[46,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[46,"غدا كل طفل على عمره","https://www.aldiwan.net/poem23157.html","المتقارب"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[46,"متى ما تخالط عالم الإنس لا يزل","https://www.aldiwan.net/poem23586.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[19,"لعمرك ما آسى طفيل بن مالك","https://www.aldiwan.net/poem350.html",""],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[15,"يا دار هند عفاها كل هطال","https://www.aldiwan.net/poem45254.html","البسيط"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140972",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72217","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[22,"أَرَسْمَ دِيارٍ مِنْ هُنَيْدَة َ تَعْرِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=19785",""],[50,"ألا طرقت موهناً مهدد","https://www.poetsgate.com/ViewPoem.aspx?id=21823",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[34,"ألأا يا شِبهَ لُبنى لا تُرَاعي","https://www.poetsgate.com/ViewPoem.aspx?id=18159",""],[45,"أإبْرَاهِيمُ! دِعْوَةَ مُسْتَعِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32951",""],[45,"سَلاها كيْفَ ضَيّعَتِ الوِصَالا","https://www.poetsgate.com/ViewPoem.aspx?id=32096",""],[45,"تصدت لنا دعد وصدت على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=31307",""],[16,"هل ما علمتَ وما استُودِعتَ مكتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=4903",""],[28,"ألم تذكروا يا آل مروان نعمة","https://www.poetsgate.com/ViewPoem.aspx?id=22030",""],[28,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[51,"يا كائناً بين أوعاثٍ وأوعارِ","https://www.poetsgate.com/ViewPoem.aspx?id=29234",""],[39,"أَلاَ أَيُّها اللَّيْلُ الطَّوِيلُ، أَلاَ اصْبِحِي","https://www.poetsgate.com/ViewPoem.aspx?id=4248",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["وَقَد عَجَمَ الأَقوامُ بَعدَكَ صَعدَتي","فَما أَثَّرَت فيها النُيوبُ العَواجِمُ",0,"م",1,0],["وَقَد عَطَفَت عَلَيَّ بَناتُ دَهري","كَما عَطَفَت عَلى السَقَبِ الرَؤومُ",1,"م",1,0],["وَقَد عُصِبَت مِنّي اللَيالي بِساعِدٍ","تَئِنُّ الأَعادي مَرَّةً وَتُنيلُ",2,"ل",1,0],["وَقَد عَلِمَ الأَعداءُ أَن لا يَرُدَّهُم","بِغَيرِ زَفيرٍ خانِقٍ وَعَويلِ",3,"ل",1,0],["وَقَد عَرَفَ العِدى وَبَلَوا قَديماً","خُطايَ إِلى المَنايا وَاِزدِلافي",4,"ي",1,0],["وَقَد عَلِمَت رَبيعَةُ أَنَّ بَيتي","لِغَيرِ الغَدرِ مَرفوعُ العِمادِ",5,"د",1,0],["وَقَد عَجَمَت مِنّي اللَيالي مُذَرَّباً","تَخَلَّلَ أَنيابَ الأَساوِدِ وَالأُسدِ",6,"د",1,0],["وَقَد عَرَفَت تَوَقُّلِيَ المَعالي","كَما عَرَفَت تَوَقُّلِيَ العِقابُ",7,"ب",1,0],["وَقَد عَلِمَ الأَعداءُ أَنَّكَ تَحتَهُ","غَلَبتَ وَما كانَ القَضاءُ بِغالِبِ",8,"ب",1,0],["وَقَد عَلِمَت أَنَّ الرَمِيَّ بَقاؤُهُ","قَليلٌ بِسَهمٍ بَينَ جَنبَيهِ جارِحِ",9,"ح",1,0],["وَقَد عَبَّ في كأسِ الكَرى كُلُّ راكِبٍ","فَمالَ نَزيفاً وَالجيادُ بِنا تَردِي",10,"د",2,0],["وَقَدْ عَلِمَتْ عُلْيا كِنانَةَ أَنَّني","عَلى ما يزينُ الأَكْرَمِينَ حَريصُ",11,"ص",1,0],["وَقَدْ عَلِمَ اللهُ والنَّاسِبُو","نَ أَنَّ لنا صَفْوَ هذا النَّسَبْ",12,"ب",1,0],["وقد عَلِقَتْني والنّوى مُطْمَئنّةٌ","بِنا مِنْ هَوى أمِّ الوَليدِ عَلوقُ",13,"ق",1,0],["وقدْ عَلَمَتْ عُلْيا كِنانَةَ أنّنا","إذا نَقَض الطّيشُ الحُبا حُلَماؤُها",14,"ا",3,0],["وقدْ عَلمَتْ خِندِفٌ أنّني","أكونُ بنَيْلِ المَعالي قَمينا",15,"ن",2,0],["وقد عَلِمَتْ عُلْيا نِزارٍ ويَعْرُبٍ","غَداةَ استُثيرَ النَّقْعُ أنّا كُماتُها",16,"ت",3,0],["وقَدْ عَلِمَ القبائِلُ أنَّ قَومِي","أعزُّهُمُ وأكرَمُهُمْ فَعالا",17,"ل",2,0],["وقَدْ عَلِموا أنّي أجَرْتُ رِكابَهُمْ","فقالوا وهُم مِمّا يُعانونَ عُذّالُ",18,"ل",1,0],["وَقَد عَصَفَت ريحُ الوُشاةِ بِوَصلِنا","وَجَرَّت عَلَيهِ ذَيلَها فَتَقَطَّعا",19,"ع",2,0],["وَقَد عِشنا نَلَذُّ العَيشَ حينا","لَوَ اِنَّ الدَهرَ لِلإِنسانِ راعِ",20,"ع",1,0],["وقدْ عارَضْتَ عُذْرَكَ باعتِرافٍ","فزِدْتَ مذمّةً تسِمُ الطّريقهْ",21,"ق",2,0],["وقد عيلَ صبْري في ارْتِقابي خليفَةً","تُحَلُّ بهِ للضُّرِّ عنّي أوْهاقُ",22,"ق",1,0],["وقد عرَفَ الشّهْرُ المُبارَكُ حقَّ ما","أفاضَ منَ النعْمى ووفّى منَ البِرِّ",23,"ر",1,0],["وَقَد عَلِمَت بِالغَيبِ أَنّي أُحِبُّها","وَأَنّي لِنَفسي مالِكٌ في تَجَمَّلِ",24,"ل",1,0],["وَقَد عابَني قَومٌ بِتَقبيلِ خَدِّهِ","وَما ذاكَ عَيبٌ أَسوَدُ الرُكنِ يُلثَمُ",25,"م",1,0],["وَقَد عَرَفَت أَسيافُنا وَرِقابُهُم","مَواقِعَها فيها فَإِن عاوَدوا عُدنا",26,"ن",2,0],["وَقَد عَلِمَ القَبائِلُ مِن مَعَدٍّ","إِذا قُبَبٌ بِأَبطَحِها بُنينا",27,"ن",2,0],["وَقَد عَلِمَت سَلمى وَإِن كانَ بَعلُه","بِأَنَّ الفَتى يَهذي وَلَيسَ بِفَعّالِ",28,"ل",1,0],["وَقَد عَلِمَت قِدماً أُمَيَّةُ أَنكُم","مِنَ الحَيِّ مَأوى الخائِفِ المُتَحَصِّنِ",29,"ن",1,0],["وَقَد عَلِمَت بِالغَيبِ أَن لَن أُوَدَّها","إِذا هِيَ لَم يَكرُم عَلَيَّ كَريمُها",30,"م",3,0],["وَقَدْ عَرَفَتْ مِنْهُ الصَّحَافَةُ كَاتِباً","بَلِيغاً يُحِقُّ وَالبُطْلُ رَاغِمُ",31,"م",1,0],["وَقَد عَلِمَت أَسماءُ أَنَّ حَديثَها","نَجيعٌ كَما ماءُ السَماءِ نَجيعُ",32,"ع",1,1],["وَقَد عَرَفَت وَجهي مَعَ اِسمٍ مُشَهَّرٍ","عَلى أَنَّنا كُنّا نُطيلُ التَنائِيا",33,"ي",2,0],["وَقَد عَدَتني عادِياتٌ شُجَّرُ","عَنها وَهَجرٌ وَالحَبيبُ يَهجُرُ",34,"ر",1,0],["وقد عرفت منها مرينٌ سوابقاً","تقر لها بالفضل أخرى اللياليا",35,"ي",2,0],["وقد عشتُ حتى ذقتُ فقدك قَلَّما","تُبلَّغ نفس ما تريد أمانيها",36,"ي",3,0],["وقد عُدتَ من جَبْل الشِّوار لتجتلي","عقائلَ للفتح المبين بلا عَدِّ",37,"د",1,0],["وقد عبّدت للسالكين طريقه","وحرّر أهلوه وبورك أنسه",38,"س",2,0],["وقد علم القوم الكرام بأنني","غلام على حبّ المكارم قد شباً",39,"ب",2,0],["وقد علم الراوون شعري بأنهم","إذا أنشدوه أطربوا بلحونه",40,"ن",2,0],["وقد علم الأعداء أن سيوفنا","تململ في الأغماد شوقاً إلى الضرب",41,"ب",1,0],["وقد عَمِيَتْ منها النوافذ والكُوى","فلم تكتحل من ضوء شمس بمروَد",42,"د",1,0],["وقد عمّهم قَيد التعاسة مُوثَقاً","فلم يتميّز مُطلَق عن مقيّد",42,"د",1,0],["وقد عهدوا لنا بتراث ملك","أضعنا في رعايته العهودا",43,"د",2,0],["وقد علمت بنو آثور أنا","أولو عزم يعرقب كل ناز",44,"ز",1,0],["وَقَد عَهِدنا بِها حوراً مُنَعَّمَةً","لَم تَلقَ أَعيُنُها حُزناً وَلا رَمَدا",45,"د",2,0],["وَقَد عَلِمَت بَنو وَقبانَ أَنّي","ضَبورُ الوَعثِ مُعتَزِمُ الخَبارِ",46,"ر",1,0],["وَقَد عَلِمَت تَميمٌ أَنَّ تَيماً","بَعيدٌ حينَ يُنسَبُ مِن نِزارِ",47,"ر",1,0],["وَقَد عَلِمَ اِبنُ أَبحَرَ أَنَّ خَيلي","غَداةَ الجُمدِ صادِقَةُ الغِوارِ",47,"ر",1,0],["وَقَد عَلِمَ الأَقوامُ أَنَّ سُيوفَنا","عَجَمنَ حَديدَ البَيضِ حَتّى تَصَدَّعا",48,"ع",2,0],["وَقَد عَلِقَ الأُخَيطَلُ حَبلَ سَوءٍ","فَأَبرَحَ يَومُهُنَّ بِهِ وَطالا",49,"ل",2,0],["وَقَد عَلِمَت سَدوسٌ أَنَّ فيها","مَنارَ اللُؤمِ واضِحَةَ السَبيلِ",50,"ل",1,0],["وَقَد عَزَّ الكَواهِلُ بَعدَ نَيٍّ","عَرائِكَها وَقَد لَحِقَ الثَميلُ",51,"ل",1,0],["وَقَد عَلِمَ الجيرانُ أَنَّ مُجاشِعاً","فُروخُ البَغايا لا يَرى الجارَ مَحرَما",52,"م",2,0],["وَقَد عَلِمَ الأَقوامُ لَو أَنَّ حاتِم","أَرادَ ثَراءَ المالِ كانَ لَهُ وَفرُ",53,"ر",1,0],["وَقَد عَلِمَ الحَيُّ حَيَّ الضِبابِ","وَأَصدَقُ قيلِ الفَتى أَفضَلُه",54,"ل",2,0],["وَقَد عادَيتُ ضَوءَ الصُبحِ حَتّى","لِطَرفي عَن مَطالِعِهِ اِزوِرارُ",55,"ر",1,0],["وَقَد عَلِمَت أُمّي بِأَنَّ مَنِيَّتي","بِحَدِّ سِنانٍ أَو بِحَدِّ قَضيبِ",56,"ب",1,0],["وَقَد عَرَفَت وَقعَ المَساميرِ مُهجَتي","وَشُقَّقَ عَن رُزقِ النُصولِ إِهابي",57,"ي",1,0],["وَقَد عَلِمَت رَبيعَةُ بَل نِزارٌ","بِأَنّا الرَأسُ وَالناسُ الذُنابى",58,"ب",2,0],["وَقَد عَلِمَ الزِبَعرى غَيرَ جَهلٍ","بِأَنَّ العَبدَ عَبدُ بَني حُمامِ",59,"م",1,0],["وقد عَبِقَتْ بها ريَّا الخُزامى","كَريّا المِسك ضُوِّعَ بانتهابِ",60,"ب",1,0],["وقد عرفَ البحرُ الذي أنا عارفٌ","فطأطأ من طغْيانه ومُرُوده",61,"د",2,0],["وقد عدم المعصومُ فيه رقيبه","كما عدِم القينات فيه الحوافظا",62,"ظ",2,0],["وقد عرفت القريض أصلحك ال","لَهُ وفيه الأغلال والخِلع",63,"ع",1,0],["وقد علم المستمرئو الظلمِ أننا","سنجوي بطوناً أو سنشجي حلوقها",64,"ق",3,0],["وقد عَلِقَت قبضتاه عُرى","بها عصم الله تلك الوُثَق",65,"ق",1,0],["وقد علمَتْ أن لم تُسلَّلْ نصالُها","لذلك بلْ سُلَّتْ لضربِ الجماجمِ",66,"م",1,0],["وَقَد عَلِمَ الأَقوامُ أَنَّكَ سَيِّدٌ","وَأَنَّكَ مِن دارٍ شَديدٍ حَصاتُها",67,"ت",3,0],["وَقَد عَرَكَت بِاِبنَي دُخانٍ فَأَصبَحا","إِذا ما اِحزَأَلّا مِثلَ باقِيَةِ البَظرِ",68,"ر",1,0],["وَقَد عَهِدتُ بِها بيضاً مُنَعَّمَةً","لا يَرتَدينَ عَلى عَيبٍ وَلا وَصَبِ",69,"ب",1,0],["وَقَد عَلِمَت أُمَيَّةُ أَنَّ ضِغني","إِلَيها وَالعُداةُ لَها هَريرُ",70,"ر",1,0],["وَقَد عَلِمَ النِساءُ إِذا اِلتَقَينا","وَهُنَّ وَراءَنا أَنّا نَغارُ",71,"ر",1,0],["وَقَد عَلَّقَتني السُقمَ إِذ بَرَقَت لَنا","عَلى غِرَّةٍ مِنّا وَما شَعَرَت فُضلا",72,"ل",2,0],["وَقَد عَلِمَت أُفناءُ تَغلِبَ أَنَّني","نُضارٌ وَلَم أَنبُت بِقَرقَرَةٍ أَثلا",72,"ل",2,0],["وَقَد عَلَوتُ قُتودَ الرَحلِ يَسفَعُني","يَومَ تَجيءُ بِهِ الجَوزاءُ مَسمومُ",73,"م",1,0],["وَقَد عَلِمَت أَن لا اِنقِلابَ لِرَحلِها","إِذا تَرَكَت مِن آخِرِ اللَيلِ دارَها",74,"ر",3,0],["وَقَد عَيَّروني المالَ حينَ جَمَعتُهُ","وَقَد عَيَّروني الفَقرَ إِذ أَنا مُقتِرُ",75,"ر",1,0],["وَقَد عَلِمَت سُلَيمى أَنَّ رَأيِي","وَرَأيَ البُخلِ مُختَلِفٌ شَتيتُ",76,"ت",1,0],["وَقَد عِشتُ دَهراً ما شَكَوتُ بِحادِثٍ","بَلى كُنتُ أَشكو الأَغيَدَ المُتَدَلِّلا",77,"ل",2,0],["وَقَد عابَها الواشي فَقالَ طَويلَةٌ","مَقالَ حَسودٍ مُظهِرٍ لِعِنادِ",78,"د",1,0],["وَقَد عَلِمَ الأَقوامُ أَنَّكَ تَشتَري","جَميلَ الثَنا وَالحَمدُ أَبقى وَأَربَحُ",79,"ح",1,0],["وَقَد عَلِمَت قَيسٌ وَأَفناءَ خِندِفٍ","وَمَذحِجُ إِذ وافَيتُهُم في المَنازِلِ",80,"ل",1,0],["وَقَد عَوَّدَتهُ بَعدَ أَوَّلِ بُلجَةٍ","مِنَ الصُبحِ حَتّى اللَيلِ أَن لا تَلاقِيا",81,"ي",2,0],["وَقَد عَبّرتْ لَكَ تِلكَ الرُؤى","لِيَشبَعَ طاوٍ وَيَروى صدِي",82,"ي",1,0],["وَقَد عَلِمَت أَنَّ الخُطوبَ تَطوعُني","وَما زِلتُ مِن لِبسِ الدَنياتِ عاريا",83,"ي",2,0],["وَقَد عَرَفتَ خافِيَ الأَحمالِ","فَاِصبِر وَقُل لِأُمَّةِ الجِمالِ",84,"ل",1,0],["وَقَد عَرَفتَ حالَتي وَضِدَّها","فَقُل لِمَن يَسأَلُ عَنّي بَعدَها",85,"ه",2,0],["وَقَد عَلِمَت خَيلَهُ أَنَّهُ","إِذا هَمَّ وَهوَ عَليلٌ رَكِب",86,"ب",1,0],["وَقَد عايَنوهُ في سِواهُم وَرُبَّما","أَرى مارِقاً في الحَربِ مَصرَعَ مارِقِ",87,"ق",1,0],["وَقَد عَرَفَتكَ فَما بالُها","تَراكَ تَراها وَلا تَنزِلُ",88,"ل",1,0],["وَقَد عَلِمَ الرومُ الشَقِيّونَ أَنَّنا","إِذا ما تَرَكنا أَرضَهُم خَلفَنا عُدنا",89,"ن",2,0],["وقد علمتْ حسَّانةُ الجِيدِ أنَّني","أكلِّفُ أوطاي صدورَ اللّهاذمِ",90,"م",1,0],["وقد علموا أني إِذا الخطبُ أظلمتْ","جوانبُه أغشى مقيلَ الضراغمِ",90,"م",1,0],["وقد علِموا أن السعايةَ حَلْبَةٌ","بها القولُ تالٍ والقبولُ أمامُ",91,"م",1,0],["وقد عَلِمَ الإلحادُ مُذْ نُصِرَ الهُدَى","بأنْ ليس للدينِ الحنيفيِّ مَنْسخُ",92,"خ",1,0],["وَقَد عاجَ في أَطلالِها غَيرَ مُمسِكٍ","لِدَمعٍ وَلا مُصغٍ إِلى عَذَلِ الرَكبِ",93,"ب",1,0],["وَقَد عَلِموا أَنَّ الخِلافَةَ لَم تَكُن","لِتَصحَبَ إِلّا مَذهَباً أَنتَ ذاهِبُه",94,"ب",2,0],["وَقَد عَلِمَ الأَقوامُ أَنَّ صَريمَةً","إِذا اختَلَفَت شورى النَجِيِّ اِستَبَدَّتِ",95,"ت",1,0],["وَقَد عاقَدتَني بِخِلافِ هَذا","وَقالَ اللَهُ أَوفوا بِالعُقودِ",96,"د",1,0],["وَقَد عاجَمَتني الحادِثاتُ فَصادَفَت","صَبوراً عَلى اللَأواءِ مُنشَحِذِ الحَدِّ",97,"د",1,0],["وَقَد عَلِمَ العاصي وَإِن أَمعَنَت بِهِ","مَحَلَّتُهُ في الأَرضِ أَنَّكَ زائِرُه",98,"ر",2,0],["وَقَد عَلِمَ الأَقوامُ سالِفَ حُرمَتي","وَحَظَّ الشَكورِ في ثَنايَ وَفي شُكري",99,"ي",1,0],["وَقَد عَلِمَت تِلكَ العِمامَةُ أَنَّها","تُلاثُ عَلى تِلكَ النَجابَةِ وَالعِتقِ",100,"ق",1,0],["وَقَد عَجَمَت تِلكَ الخُطوبُ قَناتَهُ","فَزادَ عَلى عَجمِ الخُطوبِ اِعتِدالُها",101,"ل",3,0],["وَقَد عَهِدتُ اللَيالي وَهيَ جاهِدَةٌ","تَسعى عَلَيَّ فَعادَت وَهيَ تَسعى لي",102,"ي",1,0],["وَقَد عَلِمَ الوُشاةُ ثَباتَ عَهدي","إِذا عَهدُ الَّذي أَهواهُ حالا",103,"ل",2,0],["وَقَد عَلِمَ القَومُ أَنَّ الَّذي","تُحَمِّلُ لا بُدَّ أَن يَحتَمِل",104,"ل",1,0],["وَقَد عَلِمَت بِأَنّي لَم أُضَيِّع","لَها عَهداً وَلَم أُخفِر ذِماما",105,"م",2,0],["وَقَد عَلِمَت خُلَّتي أَنَّني","أُفارِقُها عِندَ هِجرانِها",106,"ن",3,0],["وَقَد عَلِمَت ذُهلُ بنُ شَيبانَ أَنَّكُم","إِلى بَيتِها الأَعلى وَأَهلُ عَلائِها",107,"ا",3,0],["وَقَد عَلِمَ اللائي بَكَينَ عَلَيكُمُ","وَأَنتُم وَراءَ الخَندَقِ المُتَصَوِّبِ",108,"ب",1,0],["وَقَد عَلِمَ المِصرُ الَّذي كانَ ضائِعاً","أَباعِدُهُ مَزؤودَةٌ وَأَقارِبُه",109,"ب",2,0],["وَقَد عَصَبَت أَهلَ الشَواجِنِ خَيلُهُم","وَقَد سارَ مِنها بِالمَجازَةِ مِقنَبُ",110,"ب",1,0],["وَقَد عَلِمَ الأَقوامُ أَنَّ اِبنُ يوسُفٍ","قَطوبٌ إِذا ما المَشرَفِيَّةُ سُلَّتِ",111,"ت",1,0],["وَقَد عَلِموا مُذ شَدَّ حَقوَيهِ أَنَّهُ","هُوَ اللَيثُ لَيثُ الغابِ غَيرُ المُعَرِّدِ",112,"د",1,0],["وَقَد عَلِمَ الداعيكَ أَن سَتُجيبُهُ","بِحاجِزَةٍ وَالنَقعُ أَكدَرَ ثائِرُه",113,"ر",2,0],["وَقَد عَلِمَ الناسُ الَّذينَ أَبوهُمُ","لِحَوّاءَ أَنّا مِن حَصى التُربِ أَكثَرُ",114,"ر",1,0],["وَقَد عَلِمَت بَجيلَةُ أَنَّ مِنكُم","فَوارِسَها وَصاحِبَ كُلِّ ثَغرِ",115,"ر",1,0],["وَقَد عَلِمَت أَنَّ القِرى لِاِبنِ غالِبٍ","ذُراها إِذا لَم يَقرِ ضَيفاً دَرورُها",116,"ر",3,0],["وَقَد عَلِمَت أَعداؤُها أَنَّ جَعفَراً","يَقي جَعفَراً حَدَّ السُيوفِ ظُهورُها",117,"ر",3,0],["وَقَد عَلِمَت أَفناءُ جَعفَرَ أَنَّهُ","يَقي جَعفَراً وَقعُ العَوالي ظُهورُها",118,"ر",3,0],["وَقَد عَلِمَت مَيسونُ أَنَّ رِماحَكُم","تَهابُ أَبا بَكرٍ جِهاراً صُدورُها",118,"ر",3,0],["وَقَد عَلِمَ المَقرونُ بي أَنَّ رَأسَهُ","سَيَذهَبُ أَو يُرمى بِهِ في النَفانِفِ",119,"ف",1,0],["وَقَد عَلِمَ الجيرانُ أَنَّ قُدورَنا","ضَوامِنُ لِلأَرزاقِ وَالريحُ زَفزَفُ",120,"ف",1,0],["وَقَد عَلِموا أَن لَن يَميلَ بِكَ الهَوى","وَما قُلتَ مِن شَيءٍ فَإِنَّكَ فاعِلُه",121,"ل",2,0],["وَقَد عَلِمَ الظُلمُ الَّذي سَلَّ سَيفَهُ","عَلى الناسِ بِالعُدوانِ أَنَّكَ قاتِلُه",122,"ل",2,0],["وَقَد عَلِمَت ذاكَ البَرِيَّةُ كُلُّها","بِحَيثُ اِلتَقَت رُكبانُها وَرِجالُها",123,"ل",3,0],["وَقَد عَلِمَ الأَقوامُ حَولي وَحَولَكُم","بَني الكَلبِ أَنّي رَأسُ عِزٍّ وَكاهِلُه",124,"ل",2,0],["وَقَد عَلِموا ما كانَ مَروانُ يَنتَهي","إِذا دَأَبَ الأَقوامُ حَتّى تُحَكَّما",125,"م",2,0],["وَقَد عَلِموا أَنّي أَنا الشاعِرُ الَّذي","يُراعي لِبَكرٍ كُلِّها كُلَّ مَحرَمِ",126,"م",1,0],["وَقَد عَلِمَ الساعي إِلى قَبرِ غالِبٍ","مِنَ السَيفِ يَسعى أَنَّهُ غَيرُ مُسلَمِ",127,"م",1,0],["وَقَد عَلِمَت مَعَدُّ الفَضلِ أَنّا","ذَوُو الحَسَبِ المَكَمَّلِ وَالحُلومِ",128,"م",1,0],["وَقَد عَلِمَ الجانونَ أَنَّ اِبنَ غالِبٍ","لِكُلِّ دَمٍ قالوا هَرَقناهُ غارِمُه",129,"م",2,0],["وَقَد عَلِمَ الساعي إِلَيهِ لِيَعطِفَن","لَهُ حَبلَ مَنّاعٍ مِنَ الخَوفِ سالِمِ",130,"م",1,0],["وَقَد عَلِمَت أَبناءُ خِندِفَ أَنَّنا","ذُراها وَأَنّا عِزُّها وَسَنامُها",131,"م",3,0],["وَقَد عَلِمَت قَيسُ اِبنُ عَيلانَ أَنَّها","إِذا سَكَتَ الأَصواتُ غَيرَ الغَماغِمِ",132,"م",1,0],["وَقَد عَلِمَت ذُهلا رَبيعَةَ أَنَّكُم","عَبيدٌ وَكُنتُم أَعبُداً لِلَّهازِمِ",133,"م",1,0],["وَقَد عَلِمَت أَنَّ الرِكابَ قَدِ اِشتَكَت","مَواقِعَ عُريانٍ مَكانَ كُلومِ",134,"م",1,0],["وَقَد عَلِمَ الداعي إِلى الحَربِ أَنَّني","بِجَمعِ عِظامِ الحَربِ غَيرُ سَؤومِ",134,"م",1,0],["وقد عانَقَ منكَ الجِذْ","عُ رَحبَ الباعِ بسَّاما",135,"م",2,0],["وقد عفا مَنزِلُها بقلبِه","كما عفا منزلُها بذي سَلَمْ",136,"م",1,0],["وقد عَلِمَتْ أموالُهُ حينَ سامَها","حِفاظَ المَعالي أنَّه سَيُضيعُها",137,"ع",3,0],["وقد عَلِمَ الأعداءُ أنْ لستَ بادئاً","بجائحةٍ إلا وأنتَ مُعيدُها",138,"د",3,0],["وقد عصفتْ بالجسرِ ريحٌ فأقبلتْ","سفائِنُهُ تَعْوَجُّ بعدَ استوائِها",139,"ا",3,0],["وَقَد عَلِمَ الأَحياءُ أَنّي زَعيمُها","وَأَنّي لَدى الحَربِ العَذيقُ المُرَجِّبُ",140,"ب",1,0],["وَقَد عَرَفتُ اللِئامَ لَيسَ لَهُم","عَهدٌ وَلا خِلَّةٌ وَلا حَسَبُ",141,"ب",1,0],["وَقَد عَزَمتُ بِأَن أَغشاهُ ثانِيَةً","فَهَل تُعينُ عَلى غَيٍّ هَمَمتُ بِهِ",142,"ه",1,0],["وَقَد عَقَدَ الحَبابُ لَها نِطاقاً","لِمِعصَمِ كَأسِها شِبهَ السِوارِ",143,"ر",1,0],["وَقَد عَمَّنا فَصلُ الرَبيعِ بِفَضلِهِ","فَبادَرَنا بِالوَردِ في أَوَّلِ القَطرِ",144,"ر",1,0],["وقد عجبَ الليلُ من مُغْرَمٍ","بكى من تَبَسّمِ صُبْحٍ مُبين",145,"ن",1,0],["وقد عَقَدَتْ أيمانُهُ العُذْرَ دونها","فَحَلَّ نَدى أيمانِنا عُقد العذرِ",146,"ر",1,0],["وَقَد عَلِمَ الحَزمُ الَّذي أَنتَ رَبُّهُ","بِأَن لا يَعي العَظمُ الَّذي أَنتَ هائِضُ",147,"ض",1,0],["وَقَد عَلِمَ القِرنُ المُساميكَ أَنَّهُ","سَيَغرَقُ في البَحرِ الَّذي أَنتَ خائِضُ",147,"ض",1,0],["وَقَد عَلِمَ الأَفشينُ وَهوَ الَّذي بِهِ","يُصانُ رِداءُ المُلكِ عَن كُلِّ جاذِبِ",148,"ب",1,0],["وَقَدْ عِشْتُ دَهْرَاً لا أَدِينُ لِظَالِمٍ","وَلَمْ يَحْتَكِمْ يَوْماً عَلَيَّ زَعِيمُ",149,"م",1,0],["وقدْ علمَ الأقوامُ لو أن حاتماً","أرادَ ثراءَ المالِ كانَ لهُ وفرُ",150,"ر",1,0],["وَقَد عَلِمَت إِذ باعَدَتني تَجَنُّباً","فَدَت نَفسَها نَفسي عَلى مَن تُعَوِّلُ",151,"ل",1,0],["وَقَد عَرَفتُ لَها أَطلالَ مَنزِلَةٍ","بِالخَيفِ غَيَّرَها الأَرواحُ وَالمَطَرُ",152,"ر",1,0],["وَقَد عَطَفَت وَهناً بِهِ الكَأسُ هاجِراً","وَما كُنتُ أَدري الكَأسَ مِن أَحرُفِ العَطفِ",153,"ف",1,0],["وَقَد عَلِمنا لَوَ انَّ العِلمَ يَنفَعُنا","أَن سَوفَ يَلحَقُ أُخرانا بِأولانا",154,"ن",2,0],["وَقَد عَجِبتُ وَما بِالمَوتِ مِن عَجبٍ","ما بالُ أَحيائِنا يَبكونَ مَوتانا",154,"ن",2,0],["وقَد عَلِموا أَنَّهُ خَيرُهم","وفي بَيتِهِم ذِي النَدى والَكرَم",155,"م",1,0],["وَقَد عَقَل الحِراءُ وَاِصطَهَرَ اللَظى","جَنادِبَ يَرمَحنَ الحَصى كُلَّ مَرمَحِ",156,"ح",1,0],["وَقَد عَلِمتِ إِذا ما اللَيلُ أَعظَمَهُ","بَعضُ الرِجالِ وَهابُو الهَولَ فَاِكتَنَسُوا",157,"س",3,0],["وَقَد عَلِمَت خَيلُ اِبنِ خَشعَةَ أَنَّها","مَتى تَلقَ يَوماً ذا جِلادٍ تُجالِدِ",158,"د",1,0],["وَقَد عَلِمَت خَيلُ اِبنِ خَشعَةَ أَنَّها","مَتى تَلقَ يَوماً غَمرَةً لا تُعانِدِ",158,"د",1,0],["وَقَد عَلِمَت هِندٌ عَلى النَأيِ أَنَّني","إِذا عَدِموا يُسراً لِنِعمَ المُكَلَّفُ",159,"ف",1,0],["وَقَد عُرِضَت قَيانُهُمُ عَلَينا","وَباعوا بَعضَهُم مِنّا رَقيقا",160,"ق",2,0],["وَقَد عَلا جانِبَيهِ","وَقَد تَجاوَزَ قَدرَه",161,"ر",2,0],["وَقَد عَدَلَ الدَهرُ ميزانَهُ","فَلا فيهِ حَرٌّ وَلا فيهِ قُر",162,"ر",1,0],["وَقَد عَلِمَ المَقتولُ بِالشَمِ أَنَّني","أُريدُ بِهِ مَن رامَني وَأَغاروا",163,"ر",3,0],["وَقَد عِشتُ حَتّى ما لَدى وَجهِ مُنيَةٍ","يَعودُ إِلَيها مِن فُؤادِيَ عالِجُه",164,"ج",2,0],["وَقَد عَلَونَ غَيرَ مُكرَماتٍ","مَنابِراً وَلَسنَ خاطِباتِ",165,"ت",1,0],["وَقَد عَلِمتُ ما أَشُك","كُ أَنَّ ذا مِن بُغيَتِه",166,"ت",2,0],["وقد عمَّ من في ذلك الثغرِ نائِلاً","كما افترقَتْ تَهمي من المُزْن فُرَّقُه",167,"ق",2,0],["وقد عجمَتْ هندَ الملوك وسِندَهَا","ليالٍ تركنَ الفيلَ كالبَكرِ يَقْلخ",168,"خ",1,0],["وقد عجزوا في ثغرِهمْ عن عدوّهمْ","بحيث تجول المُقرَبات اليعابيب",169,"ب",1,0],["وَقَد عَنَّ لي الخِنثى فَقُل لِبَعوضَةً","سَقَطتِ وَلَم أَشعُر وَطِرتِ فَطيري",170,"ي",1,0],["وَقَد عَرِكَت بِتَدمُرَ خَيلُ قَيسٍ","فَكانَ لِتَدمُرٍ فيها دَمارُ",171,"ر",1,0],["وَقَد عَجِبتُ وَإِغرامي بِها عَجَبٌ","ما لي أَقودُ حَروناً غَيرَ مُنقادِ",172,"د",1,0],["وَقَد عَلِمَت حَمّادَةُ النَفسِ أَنَّني","إِلى نائِلٍ لَو نِلتُ مِن وِردِها صَدِ",173,"د",1,0],["وَقَد عَطَفتُ مَكيحاً بَعدَ حَيصَتِهِ","عَلى الوَديقِ فَما وِترٌ بِمَطلوبِ",174,"ب",1,0],["وَقَد عَرَفتُ عَريفاً ناكَ خالَتَهُ","وَقَد تَلَفَّعَ شَيباً غَيرَ مَخضوبِ",174,"ب",1,0],["وَقَد عَلِمَت عَليا رَبيعَةَ أَنَّني","إِذا السَيفُ أَكدى كانَ فِيَّ مَضاءُ",175,"ا",2,0],["وَقَد عَرَّضنَ لي وَاللَهُ دوني","أَعوذُ بِهِ إِذا عَرَضَ البَلاءُ",176,"ا",2,0],["وَقَد عَسَرَت مِن دونِهِم بِأَكُفِّهِم","بَنو عامِرٍ عَسرَ المَخاضِ المَوانِعِ",177,"ع",1,0],["وَقَد عَلِمتُ المَنايا غَيرَ تارِكَةٍ","لَيثاً بِخِفّانِ أَو ظبيّاً بِفِرتاجا",178,"ج",2,0],["وَقَد عَلِمنا بِأَنّا في عَواقِبِنا","إِلى الزَوالِ فَفيمَ الضَغنُ وَالحَسَدُ",179,"د",1,0],["وَقدَ عَلِمتُ إِذا سُهِّدتُ مِن حَذَرٍ","أَن لَيسَ يَنفي خُطوبَ الدَهرِ تَسهادي",180,"د",2,0],["وَقَد عُذِرَت في نَوحِها وَغِنائِها","فَلَمّا أَطالَت فيهِما بَطَلَ العُذرُ",181,"ر",1,0],["وَقدَ عَرَّفَتها أُمُّها أَمسِ شَرَّهُ","وَأَنَّ الرَدى يَقرو المَكانَ الَّذي تَقرو",182,"ر",2,0],["وَقَد عَلِمَ اللَهُ أَنَّ العِبادَ","إِن يُرزَقوا نِعمَةً يَبطَروا",183,"ر",3,0],["وَقَد علِمتُ وَغَيري عَن مُشاهَدَةٍ","إِنَّ العُلى إِلفُ قَومٍ في الوَغى لِيسِ",184,"س",1,0],["وَقَد عِشتُ حَتّى لَو تَرى العَيشَ لاحَ لي","هَباءً كَنَسجِ العَنكَبوتِ شَبارِقُه",185,"ق",2,0],["وَقَد عاشَ ماشاءَ هَذا الغُرابُ","فَما قالَتِ الطَيرُ يا أَقزَلُ",186,"ل",1,0],["وَقَد عَزَّ رَملٌ عَلى حاسِبٍ","كَما عَزَّ بَحرٌ عَلى كائِلِ",187,"ل",1,0],["وَقَد عَدِمَ التَيَقُّنُ في زَمانٍ","حَصَلنا مِن حِجاهُ عَلى التَظَنّي",188,"ي",1,0],["وَقَد عَلِمَ اللَهُ اِعتِقادي وَإِنَّني","أَعوذُ بِهِ مِن شَرِّ ما أَنا فيهِ",189,"ف",3,0],["وقد علمَتْ هذي البسيطةُ أنّها","تُراثُكَ فلْتَشْرُفْ بذاك وتزْدَدِ",190,"د",1,0],["وَقَد عَلِمَت عِرساكَ أَنَّكَ آيِبٌ","تُخَبِّرُهُم عَن جَيشِهِم كُلَّ مَربَعِ",191,"ع",1,0],["وَقَد عَلِموا أَن مَن يُرِد ذاكَ مِنهُمُ","مِنَ الأَمرِ يَركَب مِن عِنانِيَ مِسحَلا",192,"ل",2,0],["وَقَد عَلا لِمَّتي شَيبٌ فَوَدَّعَني","مِنها الغَواني وَداعَ الصارِمِ القالي",193,"ي",1,0],["وَقَد عَلِمَت عُليَا مَعَدٍّ بَلاَءَنا","وَنَجرانَ زُرنا باللَهامِيمِ ضُمَّرا",194,"ر",2,0],["وقد عرفتك فما بالها","تراك تراها فلا تنزل",195,"ل",1,0],["وقَدْ عَلِمَ الجوعُ الذي باتَ سارِياً","عَلى الضَّيفِ والجيرانِ أَنَّكَ قاتلُهْ",196,"ل",2,0],["وقد علم الرومي أنك حتفه","على أن بعض الموقنين يخال",197,"ل",1,0],["وَقَد عَمِرَت تَيمٌ زَماناً وَما يُرى","لِنِسوَةِ تَيمٍ مِن حِفافٍ وَلا خِدرِ",198,"ر",1,0],["وَقَد عَلِمَت بَنو عَبسٍ بِأَنّي","أَهُشُّ إِذا دُعيتُ إِلى الطَعانِ",199,"ن",1,0],["وَقَدْ عَاقَ شُكْرِي عَنْهُ فَرْطُ احْتِشَامِهِ","فَهَلْمُجْزِيءٌ شُكْرٌ يَجِيءُ رِثَاءَ",200,"ا",2,0],["وَقَدْ عَلِمَ المَوْتُ الَّذِي بِتَّ حَرْبَهُ","مِرَاسَكَ فِي دَفْعِ الرَّزَايَا الجَلاَئِل",201,"ل",1,0],["وقد عُرِّيَتْ بيضٌ خِفَافٌ كأَنَّها","مَقابيسُ يُزْهِيهَا لِعَيْنَيْكَ شَاهِرُ",202,"ر",1,0],["وَقَد عَلِمَت سَلمى وَإِن كانَ بَعلُها","بِأَنَّ الفَتى يَهذي وَلَيسَ بِفَعّالِ",203,"ل",1,0],["وَقَد عَسَت شَعَراتٌ في عَوارِضِهِ","تُزري عَلى عارِضَيهِ أَيَّ إِزراءِ",204,"ا",2,0],["وقد علم الأقوامُ أنك مُكملٌ","لك الحسنُ في مرأىً وغيبِ ضمير",205,"ر",1,0],["وقد علَّمتنا أنْ يكونَ إخاؤنا","كشامخِ رَضْوَى ركنُه غيرُ زائل",206,"ل",1,0],["وقد علمتْ هندٌ على النأي أنّني","إذا عدموا رسلاً فنعم المكلّف",207,"ف",1,0],["وقد عدت صفداً في غدٍ","وكم وعدتك ولا تصفد",208,"د",1,0],["وقد عَلِمَ الأقوامُ أنَّ مُزاحماً","من الشعبِ مخدومٌ وللشّعبِ خادم",209,"م",1,0],["وقد عاشت إلى الأوباشِ تُعزى","وماتتْ وهي مُعدَمةٌ خَلاء",210,"ا",2,0],["وَقَدْ عِشنا نَلَذُّ العَيشَ حيناً","لَوَ کنَّ الدَّهْرَ للإنْسَانِ رَاعِ",211,"ع",1,0],["وَقَدْ عَاقَدْتَني بخِلافِ هذا،","وَقَالَ الله: أوْفُو بِالعُقُودِ",212,"د",1,0],["وَقَدْ عَلَمِ الوُشَاةُ ثَباتَ عَهْدِب","إِذا عَهْدُ الَّذي أَهْواهُ حَالا",213,"ل",2,0],["وقد عجمتني الحادثات فصادفت","صبوراً على اللأواء منشحذ الحد",214,"د",1,0],["وقد عَلَوتُ قُتُودَ الرَّحلِ يَسعَفُني","يَوم تَجيءُ به الجوزاءُ مسمومُ",215,"م",1,0],["وَقدْ عَلِمُوا كانَ مَرْوَانُ يَنتهي","إذا دَأبَ الأقْوَامُ حتى تُحَكَّمَا",216,"م",2,0],["وَقَدْ عَلِمَتْ قَيسُ بنُ عَيلانَ أنّها","إذا سَكَتَ الأصْواتُ غَيرَ الغَماغِمِ",217,"م",1,0],["وقد عرفتُ وغيري حق معرفة","للشعر أنصار صدقٍ أيَّ أنصار",218,"ر",1,0],["وقَدْ عَقَلَ الحِرْباءُ، واصَطَهَرَ اللَّظَى","جَنَادِبَ يَرْمَحْنَ الحَصَى كُلَّ مَرْمَحِ",219,"ح",1,0],["وَقَدْ عُوِّدَ الأَطْفَالُ فِيهِ التَّسَوَّلاَ","وَسِيمَتْ بِهِ الأَبْكَارُ سَوْماً مُحَلَّلاَ",220,"ل",2,0],["وقد علم القوم الكرام بأني","غلام على حب المكارم قد شبا",221,"ا",1,0],["وَقَدْ عَلَتْهُمْ هَفْوَة ً هَبْوَة ٌ","ذاتُ هياجٍ كلهيبِ الحريقْ",222,"ق",1,0]]}