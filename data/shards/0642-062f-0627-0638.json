{"poems":[[63,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[83,"ياجامع الشمل بعدما افترقا","https://www.aldiwan.net/poem61453.html","الطويل"],[54,"قد أظلم الليل يا نديمي","https://www.aldiwan.net/poem26678.html","مجزوء البسيط"],[48,"أهلا بغائلة الردى وإيابها","https://www.aldiwan.net/poem22352.html","الكامل"],[48,"إذا جلست على أقتاد ناجية","https://www.aldiwan.net/poem22790.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85776","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[111,"الله أكبر فاز المجد واغتبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66838&r=&rc=17",""],[240,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[543,"قد غاب عبد الله عني من غدا","https://www.aldiwan.net/poem47575.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138276",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112463","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38617","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62560","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117477","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115947","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11977","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27780","السريع"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45694","البسيط"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100485","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113701","الدوبيت"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74297","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100784","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138522",""],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141507","المجتث"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54412","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54353","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94461","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72356","الخفيف"],[4674,"جنية الماء","https://www.poetsgate.com/ViewPoem.aspx?id=186367",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[5038,"نوار الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=189964",""],[5111,"قُدْسَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=212591",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5833,"قد أظلم الليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=196996",""],[5873,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215307",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6190,"في موكب العطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87009&r=&rc=15",""]],"verses":[["قد أَظَلَّتْكَ يا أبا إسحاقِ","غارَةُ اللَّفظِ والمعاني الدِّقاقِ",0,"ق",1,1],["قَد أَظلَمَت عيشَتي وَلَستُ أَرى","إِلّا بِكُم مَشرِقاً لَها أُفُقا",1,"ق",2,0],["قَد أَظلَمَ اللَيلُ يا نَديمَي","فَاِقدَح لَنا النارَ بِالمُدامِ",2,"م",1,1],["قَد أَظهَرَت نُوَباً تَزيدُ عَلى الحَصى","عَدَداً وَكَم في ضَبنِها وَعِيابِها",3,"ب",3,0],["قَد أَظلَمَ الدَهرُ وَالصُبحُ الجَليُّ نَأَت","عَنهُ المَطامِعُ فَلِيُرفَع لَنا الغَلَسُ",4,"س",1,0],["قد أظهروا أَنَّهم في كل ما فعلوا","يدافعون عن الأوطان والدينِ",5,"ن",1,1],["قَدْ أَظْلَمَتْ مِنْهُ الْعُيُونُ كَأَنَّما","كَحَل الْبُكَاءُ جُفُونَها بِقَتَادِ",6,"د",1,0],["قد أظهر الله نورا كان في أزل ال","أزال في علمه المخزون منضبطا",7,"ط",2,0],["قَد أَظَلَّت بَشائِرُ العيدِ في أَك","رَمِ زَورٍ مِنهُ وَأَشرَفِ وَفدِ",8,"د",1,0],["قد أَظلمَت مراكُشٌ مِن بعدِه","يا كوكبَ الحمراءِ هل تَتطلَّعُ",9,"ع",1,0],["قد أظهروا إخلاصهم وخضوعهم","لرئيس دين أيما إظهار",10,"ر",1,0],["قد أظلمت في وجهي الدنيا فلا","سلوى أراني أو اعزاء واجدا",11,"د",2,0],["قد أظلمت عيناه أما خده","فذوى وأما حسنه فتوارى",12,"ر",2,0],["قَد أَظلمَ الكَونُ وَاِسودَّت جَوانِبهُ","إِذ ماتَ بَدري وَكانَ الكَون فيهِ يُرى",13,"ر",2,1],["قد أظهر الخطب الجوى","بذكر سكان اللوى",14,"ل",3,0],["قد أظهرَ المحبوبُ أُعجوبةً","حارَ بها العاشقُ في أمرِه",15,"ه",1,1],["قد أظلمت بهجةُ الدنيا لغيبتِهِ","والدّهرُ قد عاد ندماناً لما صَنَعا",16,"ع",2,0],["قَد أَظَلَّ الوُفودَ وَهُوَ صَباحٌ","وَأَذَلَّ الأُسودَ وَهُوَ غَزالُ",17,"ل",1,0],["قد أظهر التحنيط أعجبَ آيةٍ","وصلت إليها حكمةُ الإنسانِ",18,"ن",1,0],["قَد أَظلم بِالحَوادث أُفق سَعدي","فَجلِّ بِشَمس عَونك لي ضَبابه",19,"ب",2,0],["قد أظهرت أحكامها عندنا","في دارِنا الدنيا فلم تبتئس",20,"س",1,0],["قَد أَظَهرَا في الوَرى اِزدِواجاً","فَاِمتَزج النور بِالظَلام",21,"م",1,0],["قد أظلمت تلك المدارس بعده","ولكم علاها من سناه ضياء",22,"ا",2,0],["قد أظلمت سبل الرشاد وطالما","كشفت بغرة وجهك الظلماء",22,"ا",2,0],["قد أظماني الغرام مما فيَّا","هيَّا بفضول دمعِ كاسي هيَّا",23,"ي",2,1],["قَد أَظلَمَت نار الطغاة فَصادفت","بَحراً يَجُر مِن العَساكر أَبحُرا",24,"ر",2,0],["قد اظهر اللَه ما يخفيه باطنه","وأخرج الدهر ما ينويه للعلن",25,"ن",1,0],["قد اظلمت من بعده الدنيا فقد","كان بها نور هدى يتقد",26,"د",1,0],["قد أظهر الله فيها","زُهرَ الكواكب زَهرا",27,"ر",2,0],["قد أَظلمَ الأُفقُ في عيني لغيبتكم","فإنْ أَذنْتُ لشخصي في الحضورِ أضا",28,"ض",2,0],["قد أَظلمتْ مُذْ غابَ عنّا دُورُه","لمّا خلتْ من بَدْرهِ داراتُهُ",29,"ت",2,0],["قد أظلم القطر مذ غابت زواهركم","والأنس قد زال طراً من أراضينا",30,"ن",2,0],["قد أظلت شمسا بغير كسوف","وأقلت بدرا بغير خسوف",31,"ف",1,0],["قد أظلم الكونُ إلا نورَ فتنتها","تشدُّ أغلال سجَّانٍ على النظرِ",32,"ر",1,0],["قَدْ أَظْلَمَ اللَّيْلُ فِيْ بَغْدَاْدَ مُذْ رَحَلَتْ","شَمْسُ الْعُرُوْبَةِº وَالْعُرْبَاْنُ نُوَّاْمُ",33,"م",1,0],["قدْ أظْهرتْ يومَ الرحيلِ وليجةً","لمّا غدوْتُ عنِ الْوشاةِ كليلا",34,"ل",2,0],["قَدْ أظلمَ الليْل ، لا الأفْجَارُ تُطْرِبُنَا","الْقُدْسُ أيْنَ ؟ . ' وَأيْنَ الْوَرْدُ حَيْفَاءُ ؟.'",35,"ا",2,0],["قد أظهرت معجزات في تخطرها","قوموا أنظروا كيف أحيت كلّ ملحودِ",36,"د",1,0],["قد أظلمَ الليلُ وأسوَدت جَوانبهُ","وأدبرَ النجمُ وانفضَّتْ كواكِبهُ",37,"ب",2,1],["قد أظلمت دنيا الغرور بناظري","عندي الدياجي ..جرجرت أذيالَها",38,"ل",3,0],["قد أظهرت حقاً لترضيَ ربها","وتزيح عن حصن العدالة جورا",39,"ر",2,0],["قد أظهرتْ خصلةً أزرتْ بسنبلةٍ","في الحقلِ أخجلَها ما كانَ أخجلَها",40,"ل",3,0]]}