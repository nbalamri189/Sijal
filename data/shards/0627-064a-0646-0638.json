{"poems":[[55,"أي عيد من الهوى عاد قلبي","https://www.aldiwan.net/poem30718.html","الخفيف"],[74,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[556,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109338","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[5213,"هل تبلغ العيس بى الدارا","https://www.poetsgate.com/ViewPoem.aspx?id=170460",""],[5431,"متعة الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=205267",""]],"verses":[["أَينَ ظَبيٌ بِذي النَقا يوقِدُ النا","رَ عِشاءً بِالمَندَلِيِّ الرَطبِ",0,"ب",1,0],["أيّ نظم صافي الحديث إذا ما","عاقرته الألباب قيل عتيق",1,"ق",1,0],["أين ظباءُ المنحنَى","سوالفا وأعينا",2,"ن",2,1],["أيُّ نظمٍ وهبتهُ لذة الغم","ضِ فوافى من لذة الغمض أحلى",3,"ل",2,0],["أين ظبيُ الأراكِ طابا جميعاً","بين روضِ العقيقِ طيباً وظِلاّ",4,"ل",2,0],["أَينَ ظبيٌ عهدتُه في نواحي","كِ دَخولاً حَبَّ القلوب هَجوما",5,"م",2,0],["اين ظباك البيض عهدي بها","تُغري أهاب الدجن كالمبضع",6,"ع",1,0],["أين ظباء كانت أوانسها","يذب عنها الحياء والخفر",7,"ر",1,0],["اين ظباء العين في ربعه","أواهلا يألفن من زارا",8,"ر",2,0],["أي نظمٍ لم ينزف الروح حرفا","هو ضربٌ من الغلوّ السخيفِ",9,"ف",1,0]]}