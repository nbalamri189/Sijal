{"poems":[[57,"رأيت القناعة رأس الغنى","https://www.aldiwan.net/poem24653.html","المتقارب"],[57,"بلوت بني الدنيا فلم أرى فيهم","https://www.aldiwan.net/poem24729.html","الطويل"],[42,"ذهبت وكان المرء يبلو ويبتلى","https://www.aldiwan.net/poem50398.html","الطويل"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21451.html","الكامل"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[61,"أمير العلا لا زلت كهفا لآمل","https://www.aldiwan.net/poem51330.html","الطويل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[87,"أعد على السمع ذكر البان والعلم","https://www.aldiwan.net/poem8243.html","البسيط"],[105,"أبوا أن يقعدوا والجيش يزجى","https://www.aldiwan.net/poem44027.html","الوافر"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147460","الكامل"],[100,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[151,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[161,"خذوا لي من الألحاظ أمنا على عقلي","https://www.aldiwan.net/poem58987.html","الطويل"],[236,"عذيري من أبي بشر","https://www.aldiwan.net/poem31923.html","الهزج"],[271,"تثاقل ليلي والظلام ثقيل","https://www.aldiwan.net/poem35683.html","الطويل"],[283,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[304,"تكون من برد زندها","https://www.aldiwan.net/poem58065.html","الكامل"],[339,"أرى دهرنا فيه عجائب جمة","https://www.aldiwan.net/poem68706.html","الطويل"],[354,"ألا حدثا مولاي ذا المنزل الرحب","https://www.aldiwan.net/poem40776.html","الطويل"],[372,"فؤاد صحا حتى تعقبه السكر","https://www.aldiwan.net/poem57381.html","الطويل"],[417,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[417,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[465,"لقد بوركت يا بن المبارك بلدة","https://www.aldiwan.net/poem3187.html","عموديه"],[465,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[465,"تعجب هند من حنيني إلى اللمي","https://www.aldiwan.net/poem3365.html","عموديه"],[469,"بلوت بني الدنيا فلم أرفيهم","https://www.aldiwan.net/poem60418.html","الطويل"]],"verses":[["فَلا ذا يَراني عَلى بابِهِ","وَلا ذا يَراني بِهِ مُنهَمِكِ",0,"ك",1,0],["فَلا ذا يَراني واقِفاً في طَريقِهِ","وَلا ذا يَراني قاعِداً عِندَ بابِهِ",1,"ب",2,0],["فَلا ذَنبَ لي لَو كُنتُ أَضطَرُّ ضَيعَتي","إِلى جولِ رَسٍّ مِن حَجاً مُتَماسِكِ",2,"ك",1,0],["فَلَأَذكُرَنَّ بَني رُهَيَّةَ كُلَّهُم","وَبَني الحُصَينِ بِخُزيَةٍ وَهَوانِ",3,"ن",1,0],["فلا ذاقَ عفوَ اللَّه عرَّةُ دولة","نبيهُ المخاري للخبائثِ أكَّالُ",4,"ل",1,0],["فلا ذنب للجرد العتاق إذا كبت","وقد حملت منكم جبال الفضائل",5,"ل",1,0],["فَلِأَذرَبيجانَ اِختِيالٌ بَعدَما","كانَت مُعَرَّسَ عَبرَةٍ وَنَكالِ",6,"ل",1,0],["فَلا ذَمَامَةَ فِي قَوْلٍ وَلا عَمَلٍ","وَلا أَمَانَةَ فِي عَهْدٍ وَلا قَسَمِ",7,"م",1,0],["فَلاذوا بالنبيِّ وناشدُوه","لِيَحْمِلَهُمْ فَضاقَ بهم وضاقوا",8,"ق",3,0],["فَلأذهبن فِداءَ قَومي","في غِمار المَوت خائض",9,"ض",1,0],["فلا ذنب يا رب السماء على إمرىء","رأى منك ما لا يشتهى فتزندقا",10,"ق",2,0],["((فلأذهب … عفوا طوّلنا ))","لم تذهب لقيانا … مجّال",11,"ل",1,0],["فلا ذلاً رأين ، ولا اختضاعا","سَجَنَّ مُهنَّداً، ونَفَيْن تِبْراً",12,"ا",1,0],["فَلاذَ يَقولُ الحَقِّ بَعدَ تَمَرُّدٍ","وَقُلنا اِفتِخاراً مِنهُ حَقَّ بِأَوحَدٍ",13,"د",1,0],["فلا ذقت ما قد ذقت ساعة فوقت","سهام الهوى تلك اللواحظ من أجلى",14,"ل",2,0],["فَلا ذِمَّتَهُ يُبري","فَلا يَحصِدُ بِالشُكرِ",15,"ر",1,0],["فلا ذقتُ إِلا في الصّباحِ مَنيّتي","ولا مات إِلا في الضّياء عليل",16,"ل",1,0],["فَلا ذاقَتِ الدُنيا فِراقَكَ ساعَةً","وَجَدُّكَ فيها صاعِدٌ لَيسَ يَنحَطُّ",17,"ط",1,0],["فلا ذا على ما علمت انطفى","ولا ذا وحاشاه من ذا اخترق",18,"ق",1,0],["فَلا ذا بِفَضلِ الرَأيِ أَدرَكَ بُلغَةً","وَلَم أَرَ هَذا ضَرَّهُ النَوكُ وَالجَهلُ",19,"ل",1,0],["فَلاذُوا بِقطب المَجد في فلك التُقى","وَهَل فلك إِلّا وَدار عَلى قطبِ",20,"ب",1,0],["فَلا ذُقتُ طَعمَ الخَمرِ من بَعد ريقهِ","ولا لاحَ لي من بَعد غُرَّتِه البَدرُ",21,"ر",1,0],["فلا ذنبَ للأيَّام من بعدِ هذه","فَقَدْ جاءَت الأيام للناس بالعذر",22,"ر",1,0],["فلاذوا بقبر ابن النبيّ محمد","فهل سُرَّ في تدميرهم صاحب القبر",23,"ر",1,0],["فلا ذاق قلبي سلوةً عن سواكم","ولا طعمت غير السهاد جفوني",24,"ن",2,0],["فلا ذقتما ما ذقت ساعة فوقت","سهام جفونٍ عن قي حواجب",25,"ب",1,0],["فلا ذقتِ ما طعمُ الصبابةِ والنَّوى","ولا بتِ من لقيا حبيبِ على وعد",26,"د",1,0],["فَلا ذا يَراني قائِماً في طَريقِهِ","وَلا ذا يَراني جالِساً عِندَ بابِهِ",27,"ب",2,0]]}