{"poems":[[59,"رأيت القناعة رأس الغنى","https://www.aldiwan.net/poem24653.html","المتقارب"],[59,"بلوت بني الدنيا فلم أرى فيهم","https://www.aldiwan.net/poem24729.html","الطويل"],[44,"ذهبت وكان المرء يبلو ويبتلى","https://www.aldiwan.net/poem50398.html","الطويل"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21451.html","الكامل"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[63,"أمير العلا لا زلت كهفا لآمل","https://www.aldiwan.net/poem51330.html","الطويل"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[89,"أعد على السمع ذكر البان والعلم","https://www.aldiwan.net/poem8243.html","البسيط"],[107,"أبوا أن يقعدوا والجيش يزجى","https://www.aldiwan.net/poem44027.html","الوافر"],[104,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147460","الكامل"],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[87,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[154,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[164,"خذوا لي من الألحاظ أمنا على عقلي","https://www.aldiwan.net/poem58987.html","الطويل"],[240,"عذيري من أبي بشر","https://www.aldiwan.net/poem31923.html","الهزج"],[275,"تثاقل ليلي والظلام ثقيل","https://www.aldiwan.net/poem35683.html","الطويل"],[287,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[308,"تكون من برد زندها","https://www.aldiwan.net/poem58065.html","الكامل"],[343,"أرى دهرنا فيه عجائب جمة","https://www.aldiwan.net/poem68706.html","الطويل"],[358,"ألا حدثا مولاي ذا المنزل الرحب","https://www.aldiwan.net/poem40776.html","الطويل"],[376,"فؤاد صحا حتى تعقبه السكر","https://www.aldiwan.net/poem57381.html","الطويل"],[422,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[422,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[469,"لقد بوركت يا بن المبارك بلدة","https://www.aldiwan.net/poem3187.html","عموديه"],[469,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[469,"تعجب هند من حنيني إلى اللمي","https://www.aldiwan.net/poem3365.html","عموديه"],[473,"بلوت بني الدنيا فلم أرفيهم","https://www.aldiwan.net/poem60418.html","الطويل"],[607,"","https://poetry.dctabudhabi.ae/diwan/poem/146482","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122769","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66745","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66798","الطويل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111171","الرجز"],[1392,"","https://poetry.dctabudhabi.ae/diwan/poem/20870","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49956","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49557","الطويل"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17527","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89558","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53141","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27259","الطويل"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111079","الطويل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83250","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121197","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91858","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91286","الكامل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21399","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34644","المتقارب"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198880","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119485","الطويل"],[4051,"","https://poetry.dctabudhabi.ae/diwan/poem/28251","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78231","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127205","الوافر"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132199","الطويل"],[4778,"طفحنا المُرَّ عاما بعد عامٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193626",""],[3591,"لنا الجرأة الكبرى على ذلك القدر","https://www.poetsgate.com/ViewPoem.aspx?id=149436",""],[5318,"لأرضِ الحشدٍ ينتسبُ الرِجالُ","https://www.poetsgate.com/ViewPoem.aspx?id=210843",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5431,"فديتك...","https://www.poetsgate.com/ViewPoem.aspx?id=196955",""],[5431,"وغايته تبرر ماأراده!","https://www.poetsgate.com/ViewPoem.aspx?id=213966",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[6068,"رأيت غرامها... -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175920",""],[469,"فلا ذقتما ما ذقت ساعة فوقت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574754",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""]],"verses":[["فَلا ذا يَراني عَلى بابِهِ","وَلا ذا يَراني بِهِ مُنهَمِكِ",0,"ك",1,0],["فَلا ذا يَراني واقِفاً في طَريقِهِ","وَلا ذا يَراني قاعِداً عِندَ بابِهِ",1,"ب",2,0],["فَلا ذَنبَ لي لَو كُنتُ أَضطَرُّ ضَيعَتي","إِلى جولِ رَسٍّ مِن حَجاً مُتَماسِكِ",2,"ك",1,0],["فَلَأَذكُرَنَّ بَني رُهَيَّةَ كُلَّهُم","وَبَني الحُصَينِ بِخُزيَةٍ وَهَوانِ",3,"ن",1,0],["فلا ذاقَ عفوَ اللَّه عرَّةُ دولة","نبيهُ المخاري للخبائثِ أكَّالُ",4,"ل",1,0],["فلا ذنب للجرد العتاق إذا كبت","وقد حملت منكم جبال الفضائل",5,"ل",1,0],["فَلِأَذرَبيجانَ اِختِيالٌ بَعدَما","كانَت مُعَرَّسَ عَبرَةٍ وَنَكالِ",6,"ل",1,0],["فَلا ذَمَامَةَ فِي قَوْلٍ وَلا عَمَلٍ","وَلا أَمَانَةَ فِي عَهْدٍ وَلا قَسَمِ",7,"م",1,0],["فَلاذوا بالنبيِّ وناشدُوه","لِيَحْمِلَهُمْ فَضاقَ بهم وضاقوا",8,"ق",3,0],["فَلأذهبن فِداءَ قَومي","في غِمار المَوت خائض",9,"ض",1,0],["فلا ذنب يا رب السماء على إمرىء","رأى منك ما لا يشتهى فتزندقا",10,"ق",2,0],["((فلأذهب … عفوا طوّلنا ))","لم تذهب لقيانا … مجّال",11,"ل",1,0],["فلا ذلاً رأين ، ولا اختضاعا","سَجَنَّ مُهنَّداً، ونَفَيْن تِبْراً",12,"ا",1,0],["فَلاذَ يَقولُ الحَقِّ بَعدَ تَمَرُّدٍ","وَقُلنا اِفتِخاراً مِنهُ حَقَّ بِأَوحَدٍ",13,"د",1,0],["فلا ذقت ما قد ذقت ساعة فوقت","سهام الهوى تلك اللواحظ من أجلى",14,"ل",2,0],["فَلا ذِمَّتَهُ يُبري","فَلا يَحصِدُ بِالشُكرِ",15,"ر",1,0],["فلا ذقتُ إِلا في الصّباحِ مَنيّتي","ولا مات إِلا في الضّياء عليل",16,"ل",1,0],["فَلا ذاقَتِ الدُنيا فِراقَكَ ساعَةً","وَجَدُّكَ فيها صاعِدٌ لَيسَ يَنحَطُّ",17,"ط",1,0],["فلا ذا على ما علمت انطفى","ولا ذا وحاشاه من ذا اخترق",18,"ق",1,0],["فَلا ذا بِفَضلِ الرَأيِ أَدرَكَ بُلغَةً","وَلَم أَرَ هَذا ضَرَّهُ النَوكُ وَالجَهلُ",19,"ل",1,0],["فَلاذُوا بِقطب المَجد في فلك التُقى","وَهَل فلك إِلّا وَدار عَلى قطبِ",20,"ب",1,0],["فَلا ذُقتُ طَعمَ الخَمرِ من بَعد ريقهِ","ولا لاحَ لي من بَعد غُرَّتِه البَدرُ",21,"ر",1,0],["فلا ذنبَ للأيَّام من بعدِ هذه","فَقَدْ جاءَت الأيام للناس بالعذر",22,"ر",1,0],["فلاذوا بقبر ابن النبيّ محمد","فهل سُرَّ في تدميرهم صاحب القبر",23,"ر",1,0],["فلا ذاق قلبي سلوةً عن سواكم","ولا طعمت غير السهاد جفوني",24,"ن",2,0],["فلا ذقتما ما ذقت ساعة فوقت","سهام جفونٍ عن قي حواجب",25,"ب",1,0],["فلا ذقتِ ما طعمُ الصبابةِ والنَّوى","ولا بتِ من لقيا حبيبِ على وعد",26,"د",1,0],["فَلا ذا يَراني قائِماً في طَريقِهِ","وَلا ذا يَراني جالِساً عِندَ بابِهِ",27,"ب",2,0],["فلا ذقتم ما ذقت منكم فلي بكم","رسيس غرامٍ مقعدٌ ومقيم",28,"م",1,0],["فَلا ذُكِرَت مَواليها بِخَيرٍ","وَلا سُقيَت مَنازِلُها بِغَيمِ",29,"م",1,0],["فلا ذلك الدينارُ أُحميَ تِبره","ولا الحَب ممّا كان في الأرضِ يُزرَعُ",30,"ع",1,0],["فلا ذلك الدينارُ أُحْمِيَ تِبره","يَقيناً وأما الحَبُّ فاللهُ أعلمُ",31,"م",1,0],["فلا ذوي روض جلا ثغامه","وليذو عود قد شممت آسه",32,"س",2,0],["فَلا ذو غِنىً يَرجينَ مِن فَضلِ مالِهِ","وَإِن قالَ أَخِّرني وَخُذ رَشوَةً أَبى",33,"ا",1,0],["فلاذت بك الآمالُ منا وأقبلَت","إِليك القوافى المحكَمات الأَوابِدُ",34,"د",1,0],["فلا ذنبَ لي إن لم أكنْ جدَّ عالمٍ","على أيّكمْ نبدا بِثَنْي الخنَاصر",35,"ر",1,0],["فلا ذو المال يرزقه بعقل","وَلا بِالمالِ تُقتَسَمُ العُقولُ",36,"ل",1,0],["فَلا ذاقَتِ الدُنيا فِراقَكَ إِنَّنِي","أَرى ساحَةَ الدُنيا بِوَجهِكَ تبهِجُ",37,"ج",1,0],["فلاذوا بظل وارف، في مديده،","امانُ غريبٍ … أمن مغتربات",38,"ت",1,0],["فَلا ذُخرَ بعد اليوم لِلدَّمعِ والأَسى","وَإ كانَ لا يُشفى بِذاكَ غَليلُ",39,"ل",1,0],["فلا ذوت في ثرى ذا الملك نَبْعَتُه","يوماً ولا غاض طول الدهر مَنْبَعُه",40,"ع",2,0],["فلا ذاتُه أبقى ولا أدركَ المنى","وغودر في الأمواتِ جسماً بلا نفس",41,"س",1,0],["فلا ذاك مما يرتضيه حفاظكم","ولا كان معهوداً لكم سالف الدهر",42,"ر",1,0],["فَلا ذمة يرعونها في بِلادِهِم","وَلا خشيَة من بَأسها يوم تفزعُ",43,"ع",1,0],["فلا ذاق يوما من سنين كآبتي","وان كان من يهوى تلافي مفندي",44,"د",2,0],["فلا ذل إلا ذل من حل نحوها","ولا عار إلا مقصر دون عارها",45,"ر",3,0],["فلاذ باعطاف الجياد تحوطه","ملاذ بغاث الطير ابصرن اجدلا",46,"ل",2,0],["فلا ذعرت يا دار ارامك التي","بها المظباء الآنسات معارف",47,"ف",1,0],["فَلا ذو المال يَقنع من كَثير","وَلا ذو الفَقر يَرجع عن لآمه",48,"م",2,0],["فَلأذكرنّ ثناءكم ما لم يَكُن","قَد خانَني المَنطوق وَالمَفهوم",49,"م",1,0],["فَلا ذا جَلالٍ هِبنَهُ لِجَلالِهِ","وَلا ذا ضَياعٍ هُنَّ يُترَكنَ لِلفَقرِ",50,"ر",1,0],["فلا ذاك يُعذَرُ في فعله","وحقُّك في الناس أن تُقتلا",51,"ل",2,0],["فَلاذَت بِمُعْتَصِمٍ بِالكتابِ","وَهوبِ المَمالِكِ سَلّابِها",52,"ب",3,0],["فَلَأُذكين شَذا مَديحَكَ شاكِراً","ما ماسَ خوط البان رَطباً وَاِنثنى",53,"ن",2,0],["فلا ذكر في الدنيا لمن ليس ذكره","تطوقه من كل ناحية جند",54,"د",1,0],["فلاذت بلا وان ولا متقاعس","ولا نأكل عن نصرة الدين جاثم",55,"م",1,0],["فَلا ذاقَ النَعيمَ وَلا شَراباً","وَلا يُسقى مِنَ المَرَضِ الشَفايا",56,"ا",3,0],["فَلأَذرقن أَسى عَلَيهِ مَدامِعي","ما دمت عائِشَة بخدر فَنائى",57,"ا",2,0],["فلا ذقتم مصابا بعد هذا","ليا ابن علي لحسن الفعال",58,"ل",1,0],["فلا ذكرى تؤرقنا","ولا آمال ترعانا",59,"ن",2,0],["فلا ذام فيها يستبين لعائب","سوى هادم اللذات ما دونه طوس",60,"س",1,0],["فلا ذاك يشكوهم هذا تأسفاً","لكل امرئ مما دهاه نصيب",61,"ب",1,0],["فلا ذكرى الشتات نذير عزم","ولم يعصمنا من ذنبٍ عويل",62,"ل",1,0],["فلا ذبلت يوماً حدائق عزكم","ولا بحت تختال في الحلل الخضر",63,"ر",1,0],["فلاذوا بالفِرار ونالوا خِزياً","وما صمدوا إذا حُمَّ النِزالُ",64,"ل",1,0],["فلاذ بإضلال وابتداتع برائم","سبيلاً إلى تشكيكه كل قاصر",65,"ر",1,0],["فلا ذهبا أو مذهباً كنت طالباً","ولا منصباً بالعلم ترجى وسائله",66,"ل",2,0],["فلا ذكت بعده في العرب نار قرىً","ولا ترنم حادي الجود في ظعن",67,"ن",1,0],["فلا ذنب إذا مابات ملقى","بذاك اليم ليلا مكفهرا",68,"ر",2,0],["فلا ذقت العذاب بكفِ بلوى","ولا حكم الليالي الجائراتِ",69,"ت",1,0],["فلا ذممٌ تُصان ولا عقودٌ","ولاصدقٌ بقولٍ أو شهادةْ",70,"د",2,0],["فلاذَ إلى التعرف من جديدٍ","عليه.. قبل أن تمَّ العناقُ",71,"ق",1,0],["فلا ذا يساوي طول هذا","وذا حبي لبعدك مستحيلا",72,"ل",2,0],["فلا ذقتما ما ذقت ساعة فُوقت","سهام جفون عن قسيّ حواجب",73,"ب",1,1],["فلا ذاك الأوان يفوت يوماً","إذا ما ضمنا شرف الهوية",74,"ي",2,0]]}