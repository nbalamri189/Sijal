{"poems":[[70,"ونديم بت منه","https://www.aldiwan.net/poem42254.html","مجزوء الرمل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[301,"قال خلي بالله صف أرض مصر","https://www.aldiwan.net/poem57828.html","الخفيف"],[346,"قال خذها من يدي تشبه ما","https://www.aldiwan.net/poem19915.html","الرمل"],[400,"قال خليلي إن لي جيرة","https://www.aldiwan.net/poem33987.html","السريع"],[441,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[556,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"]],"verses":[["قالَ خُذها قُلتُ خُذها","أَنتَ وَاِشرَبها هَنِيّا",0,"ي",2,0],["قالَ خُذهُ وَأَرسِل اِبنَكَ","إِنّي لِلَّذي قَد فَعَلتُما غَيرُ قالِ",1,"ل",1,0],["قال خلي بالله صف أرض مصرٍ","وقت كتانها بوصف محقق",2,"ق",1,1],["قَالَ خُذْهَا مِن يَدِي تَشْبَهُ مَا","في فَمي قلت ولا كُلَّ الصِّفاتِ",3,"ت",1,1],["قال خليلي إن لي جيرة","عَدَوْا على جار لنا يصلح",4,"ح",1,1],["قال خاصمت من اذاهم حديك","مسند ما لصدقه تبديل",5,"ل",1,0],["قال خير الخلق سيدُنا","الجفا والبغيُ في الشام",6,"م",1,0]]}