{"poems":[[72,"ونديم بت منه","https://www.aldiwan.net/poem42254.html","مجزوء الرمل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[308,"قال خلي بالله صف أرض مصر","https://www.aldiwan.net/poem57828.html","الخفيف"],[353,"قال خذها من يدي تشبه ما","https://www.aldiwan.net/poem19915.html","الرمل"],[409,"قال خليلي إن لي جيرة","https://www.aldiwan.net/poem33987.html","السريع"],[449,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[563,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70962","الخفيف"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107205","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75907","الرمل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128233","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200892","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200556","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204879","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204665","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205052","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203007","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36750","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[4858,"طابتِ الأيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=138207",""],[4915,"فجرُ العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=211262",""],[5010,"لَمْ يَزَلْ يَنْبِضُ قَلْبِيْ أَمَلَا","https://www.poetsgate.com/ViewPoem.aspx?id=190251",""],[5136,"قال خليلي إذا جرى مدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121498",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5747,"ياعطاشا عطشنا","https://www.poetsgate.com/ViewPoem.aspx?id=61669",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""]],"verses":[["قالَ خُذها قُلتُ خُذها","أَنتَ وَاِشرَبها هَنِيّا",0,"ي",2,0],["قالَ خُذهُ وَأَرسِل اِبنَكَ","إِنّي لِلَّذي قَد فَعَلتُما غَيرُ قالِ",1,"ل",1,0],["قال خلي بالله صف أرض مصرٍ","وقت كتانها بوصف محقق",2,"ق",1,1],["قَالَ خُذْهَا مِن يَدِي تَشْبَهُ مَا","في فَمي قلت ولا كُلَّ الصِّفاتِ",3,"ت",1,1],["قال خليلي إن لي جيرة","عَدَوْا على جار لنا يصلح",4,"ح",1,1],["قال خاصمت من اذاهم حديك","مسند ما لصدقه تبديل",5,"ل",1,0],["قال خير الخلق سيدُنا","الجفا والبغيُ في الشام",6,"م",1,0],["قال خوفي عليك من قائلٍ قد","خَسِرَتْ كيفُّ باذرٍ في السباخ",7,"خ",1,0],["قالَ خُذهُ كيفَ أَحبَبتَ فما","أنا في الحُبِّ مُطِيعٌ مَن عَتَب",8,"ب",1,0],["قال خرجت رائداً لأهلي","وكان ذاك العام عام محل",9,"ل",1,0],["قَال خِّلي كيفَ الوُصُولُ لِمَا هُو","بَينَ سُمرِ القَنَا وَبيضِ الصِّفَاحِ",10,"ح",1,0],["قالَ خُذها ثُم لا يَأخُذُها","أَحدٌ منّي وَلا كانَ أَخَذ",11,"ذ",1,0],["قال خذها قد ظفرت بها","قلت زدني فقال لا وأبيك",12,"ك",1,0],["قال خلي وصفوة الناس حولي","طبعك الحلو يجذب الأقمارا",13,"ر",2,1],["قال خليلي ضعْ لهم حدوداً","واحفظ لنا العهد من النُكّاث",14,"ث",1,0],["قال خلّي أين القصائد بالأمس","رأينا فيها البها والكمالا",15,"ل",2,1],["قال خلي وقد شكوت له البؤ","س وما انتاب مهنتي من كاد",16,"د",1,1],["قال خليلي إذ رأى ثقله","وأبصر الإعراض لا يخجلهْ",17,"ل",2,0],["قال خلي وحديثانا شجون","أتوخى يا أخي أن لا يكون",18,"ن",1,1],["قال خَليلي لَمّا رآهُ","وَقَد تَلاهُ فرعٌ نَؤُوشُ",19,"ش",1,0],["قال خانت عفيفة عهد صب","كالدراري وداده في صفاها",20,"ه",2,0],["قال خل اشكوكك اللي تترك الراوي ظماني","مايصيبك في جبينك من خلقك الله تشله",21,"ل",2,0],["قالَ: خلِّ العذرَ، يا جدّي ، بعيداً","أنت ، يا جدّيَ ، ذو بأسٍ شديدِ",22,"د",1,0],["قالَ خذني إليكَ كلي فإني","لم أكن دونَ عزمةٍ منكَ أمرا",23,"ر",2,0],["قَالَ خِلِّيْ وَهْوَ مُغْتَاضٌ لِمَا","قَدْ تَفَوَّهْتُ بِهِ ، وَارْتَجَلَا",24,"ل",2,0],["قال خليلي إذا جرى مدمعي","وجداً وقد ودعني السرب",25,"ب",1,1],["قال خلف الوفر قلت نعم","إن وقاه العلم من درنه",26,"ن",2,0],["قال خلف السيف قلت نعم","إن يصل والحزم في فطنه",26,"ن",2,0],["قال خلف الجد قلت نعم","أنه الناموس في وضنه",26,"ن",2,0],["قال خلف العلم قلت نعم","إن يك التوفيق في سننه",26,"ن",2,0],["(قال خالد عطاشا والموارد بعيده","والثريا حداها سهيل يم المغيب)",27,"ب",1,1],["قالَ خُذني كَمِثالٍ وَاعتَقِد","أَنَّني ما كُنتُ بِالمُكتَئِبِ",28,"ب",1,0]]}