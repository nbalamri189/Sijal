{"poems":[[95,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[56,"إن زرته ألفيته متبذلا","https://www.aldiwan.net/poem27530.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[246,"غلظت شفاه الشيخ حتى","https://www.aldiwan.net/poem45749.html","مجزوء الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131261",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117211","الكامل"],[1021,"لا تعذلن فلست أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=47609",""],[5829,"آفة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=175412",""]],"verses":[["مُتَثَبِّتٌ فيمَا انْتَوَاهُ مُصَمِّمٌ","وَلَهُ عَلَى النَّقْلِ الكِثَارِ تَمَامُ",0,"م",1,0],["مُتَثاقِلاً عَمّا يَسوءُ صَديقَهُ","وَإِلى الَّتي تُشجي العَدُوَّ سَريعا",1,"ع",2,0],["مُتَثَاقِلينَ مِنَ الوَقَارِ وَإنِّمَا","سَارُوا بِطَيْفٍ ناحِلٍ أَوْ أَنْحَفا",2,"ف",2,0],["مَتَثَبِّتِينَ مِنَ الْبِنَاءِ برُكْنِهِ","لِتَمَاسُكِ الأَعْضَادِ وَالأَجْزَاءِ",3,"ا",2,0],["متثاقلاً من حَملها","متباطئاً متأخرا",4,"ر",2,0],["متثنِّي الأخلاقِ ليس بجافٍ","كيف ثَنَّيْتَه وليس بجاس",5,"س",1,0],["مُتَثَبّتٌ يغنى بمح","مودِ الاناةِ عن البَدَارِ",6,"ر",1,0],["متثبتان عَلى الَّذي يَريانِهِ","حُرّانِ في نَقلَيهِما ثِقَتانِ",7,"ن",1,0],["متثنيات مثل بانات اللوى","متحركاتٌ ما لهن سكون",8,"ن",1,0],["متثبثاً بعسى وعلّ لعلّه","أن يدرك الركب الذي قد سارا",9,"ر",2,0],["متثبت عند الرعيدِ","وفي نجاز الوعد يعجل",10,"ل",1,0],["متثاقلا يمشي الهوينى شاردا","متخبطا كتزاحم الضدان",11,"ن",1,0]]}