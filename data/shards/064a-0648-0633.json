م في قطر العدل","https://www.poetsgate.com/ViewPoem.aspx?id=194806",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""],[4222,"بالملك الناصر استنارت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52859&r=&rc=151",""]],"verses":[["يُوَسِّدُ الرَحلَ خَدّا ما تَوَسَّدَهُ","قَبلَ المَطالِبِ غَيرُ الحُسنِ وَالطيبِ",0,"ب",1,0],["يوسف يا سبط الندى والعلى","يا أمل البيت الخصيب الرحاب",1,"ب",1,1],["يُوسُفُ الخَيْرِ شَادَهُ باسْمِ سَمْعَانَ","أَبيهِ واللهُ خَيْرُ مُثِيبِ",2,"ب",1,0],["يُوسعونَ الخَصْمَ الألَدَّ من الإش","جاءِ بالحق أو من الإجراض",3,"ض",1,0],["يُؤَسِّسُ في الأَرضِ لِلغابِرينَ","وَيَغرِسُ لِلآخَرينَ الثَمَر",4,"ر",1,0],["يُوَسِّطُهُ المَفاوِزَ كُلَّ يَومٍ","طِلابُ الطالِبينَ لا الاِنتِظارُ",5,"ر",1,0],["يُؤَسّي الأَداني عَنهُ أَن لَيسَ عِندَهُم","نَكيرٌ سِوى سَكبِ الدُموعِ البَوادِرِ",6,"ر",1,0],["يوسُفِيُّ الجَمالِ كَم تاهَ صَبٌّ","في مَعاني جَمالِهِ اليوسُفِيِّ",7,"ي",1,0],["يوسُفُ نالَ المُلكَ مِن بَعدِهِ","وَعاشَ في عِزٍّ وَفي أَمنِ",8,"ن",1,0],["يُوَسِّدُ شبليه لحومَ فَوَارسٍ","ويقطعُ كاللّصّ السبيلَ على السَّفْرِ",9,"ر",1,0],["يوسُفِيّاً مُحَمَّدِيّاً حَفِيّاً","بِذَليلِ الثَرى رَؤوفاً رَحيما",10,"م",2,0],["يوسفُ أعرِضْ ما الذي تبتغي","مِنْ عمرَ المعدولِ مِنْ عامِرِ",11,"ر",1,0],["يوسف باعَهُ أَبوكم يَهوذا","إِنَّ حُب الدينار فيكُم قَديم",12,"م",1,0],["يوسِعْكَ من كِسْفٍ ومن مارجٍ","نارٍ ومن قِطْرٍ ومن صَعْق",13,"ق",1,0],["يوسِعُهُ ضَمّاً إِلى أَحشائِهِ","وَإِن عَرى جَلَّلَ في رِدائِهِ",14,"ا",3,0],["يُوَسَّعُ الجِلدَ وَالعِظامَ لَها","أَطبِقَةً مازَجَت دَماً بِدَمِ",15,"م",1,0],["يُوسُفُ أَنَّ الرُّزْءَ جِدُّ فَادِحٌ","فَارْجَعْ إِلَى العَقْلِ إِذا الطَّبْعُ أَبَى",16,"ب",2,0],["يُوسُفَ النُّبْلِ طَارِفاً وَتَلِيداً","شَرَفاً يَا أَمِيرُ يَا ابْنَ الأَمِيرِ",17,"ر",1,0],["يُؤَسِّسُ عَلياءَهُ","عَلى البِرِّ إِن شادَها",18,"د",3,0],["يوسفي القسمات","نرجسي اللحظات",19,"ت",1,0],["يوسفىٌّ في الحسن بل عُمَريٌّ","في تُقاه وبأسِه ومَضَائِه",20,"ا",3,0],["يوسفُ الحسنِ أُعطيَ النصفَ منه","وَبِذاك النصفِ اِفتتن النساءُ",21,"ا",2,0],["يُوسِعُهُ مِن هَجوِنا","وَالذَمّ ضيقُ صَدرِهِ",22,"ر",2,0],["يوسُفِيٌّ حُسنُهُ مُتَّخِذٌ","حَبَّة القَلبِ لَهُ مَأوىً وَسِجنا",23,"ن",2,0],["يوسِعُ الأَعداءَ بِالسَيفِ وَبِال","رُمحِ في يَومِ الوَغى ضَرباً وَطَعنا",23,"ن",2,0],["يوسُفُ لَو لَم يَكُن نَبِيّاً","لَكانَ في حُسنِهِ غُلامَك",24,"ك",1,0],["يوسُفِيُّ الجَمالِ حُلوُ المُحَيّا","بابِلِيُّ اللِحاظِ ظَبيٌ ظَلومُ",25,"م",1,0],["يوسي أَذى الخُمارِ بِال","خَمرِ إِذا ما جُرِحا",26,"ح",2,0],["يوسُفَ الشاعِرَ فَرخٌ","وَجَدوهُ بالأَبِلَّةِ",27,"ل",2,1],["يُوسعُها ركْلاً بلا اتّقاء","وكلّما عادتْ عن اسِتعْلاء",28,"ا",2,0],["يوَسوِسُ في صَدري إذا خَطرَت بِه","كذا الجنُّ وَسواسِ الصُّدورِ فِعالُها",29,"ل",3,0],["يوسدنا أيدي المطايا حنينها","تقول لنا من سكر نومكم هبوا",30,"ب",3,0],["يوسعُ القِرْنَ كِفاحاً رائعاً","فإذا أمْكَنَهُ النَّصْرُ وَهَبْ",31,"ب",1,0],["يوسعُ المادحين منَاً ونقداً","سالماً من كريهِ منٍّ ونقدِ",32,"د",1,0],["يوسعْنَنَا الرَّسْلَ مقيمين وإنْ","سرنا فيوسعن الرّسيمَ والرَّمَلْ",33,"ل",1,0],["يوسفي المقام يملك مصراً","وعراقاً بحسنه اليوسفي",34,"ي",1,0],["يُوسُفُ الشَّيخُ الرَّفيعُ الشَّانِ مِن","آلِ عبد الملِكِ القومِ الكِرامْ",35,"م",1,1],["يوسُفَ عَصرٍ صَلاحُ مَملَكَةٍ","بِكُلِّ أَمرٍ لِلبِرِّ مُؤتَمَرُ",36,"ر",1,0],["يُوسُفُ أيُّ آلِكَ تَعتَريهِ","إلى شَرَفٍ أَولَئِكَ أَم أُلَيّا",37,"ي",2,0],["يوسُف يا ابنَ نورِ الدين إنّي","دعوتُكَ والوسيلةُ أن تُجيبا",38,"ب",2,0],["يوسِفيٌّ يمرُّ في الرملَة الوع","ساءِ بالوشي بانةً ملداء",39,"ا",2,0],["يُوسُفيُّ إن باشَرت شَفتاه","قَدَحَ الرّاحِ فاحَ مِسكاً ونَدّا",40,"د",2,0],["يوسفي الجمال تيم روحي","لا عدمنا جماله اليوسفيا",41,"ي",2,0],["يوسف الحسن عد بوصل وأنجز","ان قلبي لا يستطيع المطالا",42,"ل",2,0],["يوسفُ الحسنِ قبلَ أن يُتُوفَّى","كان بالحسنِ كلَّه لكِ أَوصى",43,"ص",2,0],["يوسفي الجمال من نار خديه","قد رأينا احتراق إبراهيما",44,"م",2,0],["يُوسُف الحُسنِ وَالبها","جَعَلَ القَلبَ مِصرَه",45,"ه",1,1],["يوسفٌ قلدني","ربهُ أيدني",46,"ي",1,1],["يوسف بن يوسفٍ","وكفى لي مفتخر",47,"ر",1,0],["يوسفياً ناصرياً","طود عزم رسخا",48,"خ",2,0],["يوسف شرفني","حيث جدَّد العهود",49,"د",1,0],["يوسفياً قد أقام سُنة","نُظمت أشرافها في نسق",50,"ق",1,0],["يوسُفي مطمحي ملء العلى","ناصري هازم للفرق",50,"ق",1,0],["يوسُفي ما ارتضينا فتنة","حينَ تُقتادُ القلوب للفتن",51,"ن",1,0],["يوسفي أنا وحسب وفائي","أنني لا أرى بخل بديلا",52,"ل",2,0],["يوسفي أنا وحسبك عطفاً","علم الدوح معطفاً أن يميلا",52,"ل",2,0],["يوسفي كلما","قد عفا أو صفحا",53,"ح",2,0],["يوسف قد سَاد فخراً دهره","وفتى يوسفَ في ذا الدهر سادْ",54,"د",1,0],["يوسع النازل من","ملء جِفانٍ وجُفون",55,"ن",1,0],["يُوسُفِيُّ الحُسْنِ حُورِيُّ النَّظَرْ","صَاغَهُ القَيُّومْ",56,"م",1,0],["يوسف الكسّاب من قارنهُ","جهذٌ بالفضل قد وازنهُ",57,"ه",1,0],["يوسف المرثى لمن آمنه","وهو فرعونٌ على الاعدا الليام",57,"م",1,0],["يوسف العصر الملاذ المؤتمنْ","منهال الظمآن غوث المستضام",57,"م",1,0],["يوسفيُّ الوجهِ رُؤيانا لهُ","مبتغانا وهيَ نِعمَ المبتغَى",58,"غ",2,0],["يوسع الخطو في الخطايا وان ضا","ق عليه ضاقت عليه رحابه",59,"ب",2,0],["يوسع الكائنات صفحا وجد ال","ناس من دون ذاك جدٌ عثور",60,"ر",1,0],["\"يوسف الناصرُ\" دين الهدى","\"ذو الفضل والمجد الكريم\" الخلال",61,"ل",1,0],["يوسوسكم ويأمركم بما لا","لكم يرضى الإله ولا يريد",62,"د",1,0],["يوسف والبتول مريمُ كانا","عند تلك الأقوالِ ينذهلان",63,"ن",1,0],["يوسعهم رفقاً إذا ما أخطأوا","ولا يزجيهم إذا ما أبطأوا",64,"ا",3,0],["يوسفيّ الخيم عزّ على","طالب إدراك مفتخره",65,"ر",2,0],["يوسفيّ إذا انتمى أصدر الأم","لاك قسراً عن مفخر الابراد",66,"د",1,0],["يوسف أنت يا ابن يوسف والإخ","وة ترجو لديك خير عتاد",66,"د",1,0],["يوسفي النجر والجود به","في السنين الجُدْب يخضر الجَديب",67,"ب",1,0],["يوسفُ خوجةُ الرضيّ","صاحب طابع البهيِّ",68,"ب",3,0],["يوسفيٌّ له بديع معان","ضاق عن وصفها نطاق البيان",69,"ن",1,0],["يوسفُ إن قطّع أيدٍ فذا","قطَّعَ أكبادَ أناس فُنُون",70,"ن",1,0],["يوسفُ ذو المحاسن المشهوره","والسيرة الجميلة المذكوره",71,"ه",1,0],["يوسف ابن الحبيب ذو المجد وافى","والمعالي قد بلغته مراده",72,"د",2,1],["يُؤسِّس رُكنَ الدين والعَدل والتُّقى","ويهدم سُورَ الضير والضيم والظُّلمِ",73,"م",1,0],["يوسع جرحاً بحشا خصمه","لسانه العضب ويوسي الجراح",74,"ح",1,0],["يوسِّد عارضيه العفر هلا","أوسِّد عارضي شوك القتاد",75,"د",1,0],["يوسف الزين فخر لبنان طرا","وزعيم على حمى سوريه",76,"ي",2,0],["يوسف الزين يوسفي خلال","جامع الحلم والندى والحميه",77,"ي",2,0],["يوسُفُ الأملاكِ قد أبْدَعَني","حُمْرةً مُعجِبةً في زَرَقِ",78,"ق",1,1],["يوسُفٌ مُبدعي فرائِقُ وصْفي","بحُلى العِزّ والكمالِ تحلّى",79,"ل",2,0],["يوسُفُ الصَّدْق مُعْجِبٌ بينَ وصْفَيْ","حجّتَيْهِ إنابَةً وإبانَهْ",80,"ن",2,0],["يوسُفٌ أبْدَعَني","بالذي أوْدَعَني",81,"ي",1,1],["يوسُفٌ النّاصِرُ المرَجّى","شرّفَ قدْري ورفَّعَهْ",82,"ع",2,0],["يوسُفٌ أبْدَعَ لي","كُلَّ وصْفٍ مُعْجِبِ",83,"ب",1,0],["يوسُفٌ ناصِرُ الخلائِفِ حقّاً","مَنْ يُجاري خِلالَهُ أو يُجانِسْ",84,"س",1,0],["يوسُفٌ ناصرُ الهُدى كَفَّ منهُ","كَفَّ ناهٍ عنِ المكارِمِ ناهِسْ",84,"س",1,0],["يوسُفٌ الناصِرُ بحْرُ النّدى","ومَنْ له قيسُ بنُ سعدٍ أبُ",85,"ب",1,0],["يوسف الحسن كان لكن عليه","رحت مذ غاب في أسى يعقوب",86,"ب",1,0],["يوسف حسن وعزيز له","قلبي المُعَنّى في الهوى مصرُ",87,"ر",1,0],["يوسوس لي فأسمعه","كذلك كُلُّ من عشقا",88,"ق",2,0],["يوسعنهُ رغبة فيهنَّ كاذبة","حتى إذا ما صبا أوسعنهُ خجلا",89,"ل",2,0],["يوسف علي خان الذي رهطه","خير أصول أنجبت بالبنين",90,"ن",1,0],["يوسف الجمالِ وفر","عون في تعديه",91,"ي",2,0],["يُوسعُ أَعفاجهُ طِعانا","مِن بَطلٍ غَير مُستَميتِ",92,"ت",1,0],["يوسفي الحسن لما إن شدا","خلته داوود يتلو في الزبور",93,"ر",1,0],["يوسفي الحسن أما إن شدا","خلته داود يتلو في الزبور",94,"ر",1,0],["يوسفُ مصرَ الذي إليهِ","تشدُّ آمالنا الرَّواحْ",95,"ح",1,0],["يوسف مصرَ التي ملاحمُها","جاءَتْ بأَوصافهِ تعرِّفُها",96,"ف",3,0],["يُوسفيٌّ الحُسنِ مُنفردٌ","كانفرادي فيه بالأَسفِ",97,"ف",1,0],["يوسعه إن رآه حاسده","مدحاً ويثني عليه جاذبه",98,"ب",2,0],["يؤسي العروبة من فراقك أن","تطوى وما لك عندها بدل",99,"ل",1,0],["يوسف عز الدين ميلاده","بشر بالملك لعبد العزيز",100,"ز",1,0],["يُوسُفًا وَدَّعتَ يا إِخوَتَهُ","وأَبًا وافاكَ مَعْ إِخوَتِهِ",101,"ت",2,0],["يوسى على هجران من يزهو به","وجه الزمان فليس يشقى مملق",102,"ق",1,0],["يوسف لا يجليه حسناً فلو","عاينه يوسف مثلى صبا",103,"ب",2,0],["\"يوسف الحسن في خصالك و\"\"النجا\"","\"ر\"\" يحكيه من حجاك نجار\"",104,"ر",1,0],["يوسفيّ البهاء حدّ البلاء","طاعنٌ في تصبر الأنبياء",105,"ا",2,1],["يوسف الحلم قد يروه بعيدا","إذ رأونا بذا العجاف سنينا",106,"ن",2,0],["يوسفي الحسن ممشوق القوام","جادلٍ في وصفها مثل المهات",107,"ت",1,0],["يوسفُ المكلوم في ساح المعالي","لن يَعيب َالقوم َلينٌ في القناةِ",108,"ا",2,0],["يُؤسفني أن أُطرد طردا","من بلدٍ أملؤه مجدا",109,"د",2,1],["يُؤسفني يُلبسني القيدا","حكمٌ أُلبِسُهُ أنا العِقْدا",109,"د",2,0],["يُؤسفني أن أوأد وأدا","وأنا حيٌّ أتلو الحمدا",109,"د",2,0],["يُؤسفني أن يهدمني حكمٌ","بالشعر سقيت له الشهدا",109,"د",2,0],["يوسفُ الصديقُ هوْ شا","هِدنا حولَ الضميرْ",110,"ر",1,0],["يوسف مصر الذي إليه","تشد آمالنا الرواحل",111,"ل",1,0]]}