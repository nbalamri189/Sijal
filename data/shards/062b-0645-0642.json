دّثْ بِما أُعيدُ وأبْدي",4,"د",2,0],["ثُمَّ قُلْ كَيْفَ كَانَ بَعْدَ انْتِشَاءِ الر","رُوحِ مِنْ أُنْسِكَ الشَّهِيِّ وَقُرْبِكْ",5,"ك",1,0],["ثُمَّ قالَت لي بِثَغرٍ باسِمٍ","نَظَمَ الدُرَّ بِهِ وَالحَبَبا",6,"ب",2,0],["ثُمَّ قالوا كَيفَ لا نَعبُدُها","هَل لَها فيما تَرى العَينُ قَرين",7,"ن",1,0],["ثُمَّ قالوا البَكرِيُّ صَدري كَما قا","لوا وَفالوا وَوَجهيَ الزَنكَلوني",8,"ن",2,0],["ثُمَّ قالوا مَعادُنا عَن قَريبٍ","فَاِرتَقِبنا فَقُلتُ هذا مَسيري",9,"ر",2,0],["ثُمَّ قالَت بَقاءُ مَن يَدَّعي الحُبَّ","مَحالٌ وَهذِهِ العيسُ تُحدى",10,"د",2,0],["ثُمَّ قَد وُفِّقَ عَبدٌ عَظُمَت","نِعمَةُ المَولى عَلَيهِ فَشَكَر",11,"ر",1,0],["ثم قالت وقد ذوت مقلتاها","وشكت من فؤادها خفقانه",12,"ن",2,0],["ثم قولوا معي مقالاً رفيع الصَ","وْت فلتحي زمرة العُمّال",13,"ل",1,0],["ثُمَّ قَصَدنا صَيدَ عَينِ قاصِرِ","مَظِنَّةَ الصَيدِ لِكُلِّ خابِرِ",14,"ر",1,0],["ثم قالوا لمَ هذا قلت ذي","صدقاتُ السرِّ من كاتبه",15,"ه",1,0],["ثم قالوا عن سليمى لا تحل","قلت محبوبي سليمى وزياده",16,"ه",1,0],["ثمَّ قالتْ تحبّني قلت في حل","ية سمرا واليوم حلية أسمر",17,"ر",1,0],["ثمَّ قوّضت منكَ المودَّة وانْقضت","فيا عجباً من رحلها المتحمَّل",18,"ل",1,0],["ثم قالوا أنتَ مجنونٌ بها","قلت مجنون ومجنون ومجنون",19,"ن",1,0],["ثم قالت أما اتقيتَ إلهَ ال","ناسِ في طول هجرتي واجتنابي",20,"ب",2,0],["ثم قالت بطرفها سوف تدري","فأضاقت عليّ رَحْبَ الفجاجِ",21,"ج",1,0],["ثم قالتْ وأحسَّتْ عَجَبي","من سراها حيثُ لا تسري الأسودُ",22,"د",1,0],["ثم قفَّى بتوبةٍ","مطّ فيها وجرَّها",23,"ر",3,0],["ثم قفّت بضرطة","لم يعقها توقُّفُ",24,"ف",1,0],["ثم قامت مدلة","تتشاجى فتعنُف",24,"ف",1,0],["ثم قام الكماةُ صفَّين من كُلْ","لِ عظيمٍ في قومه مَرْزُبان",25,"ن",1,0],["ثم قام المُمجَّدون مثولاً","ضاربين الصدورَ بالأذقانِ",25,"ن",1,0],["ثُمَّ قالَت يا حَبيبي مَرحَباً","لا رَآكَ الطَرفُ إِلّا نَيِّرا",26,"ر",2,0],["ثُمَّ قالَت لَكُمُ البُشرى وَلي","قَد نَجَونا الآنَ مِن كَيدٍ عَظيم",27,"م",1,0],["ثُمَّ قولي لِلطَيرِ ماتَ حَبيبي","فَلِماذا يا طَيرُ لا تَبكينَه",28,"ن",2,0],["ثمَّ قَدَّمْتُها إليكَ فأَهرقْتَ","رحيقي ودُستَ يا شعبُ كأسي",29,"س",2,0],["ثمَّ قَدَّْمتُها إليكَ فمزَّقْتَ","ورودي ودُسْتَهَا أَيَّ دَوْسِ",29,"س",1,0],["ثم قبلته ثلاثا وسبعا","ثم طوقت جيده تطويقا",30,"ق",2,0],["ثم قالوا هذا طريقك فانهجه","وإن طال فوق ذاك الوادي",31,"د",2,0],["ثُمَ قَضى مُحَمدٌ بِغَمِّهِ","وَالشَرُّ باقٍ وَالبَلاءُ ما اِنقَضى",32,"ا",1,0],["ثُمَ قَضى مُقتبِلَ الشَبابِ","عَن دَولة مُقبلِةِ الأَسباب",33,"ب",1,0],["ثُمَّ قالَت وَهيَ أَدرى","بِالَّذي قالَت وَأَعلَم",34,"م",1,0],["ثُمَّ قَضَى اللّهُ إلى الجِنانِ","أَنْ يُجْتَنَى الدَّاني مِنَ الأَغْصانِ",35,"ن",1,0],["ثم قالتْ لتِرْبها وهيَ تبكي","ويحَ هذا الشبابِ غَضَّاً جديدَا",36,"د",2,0],["ثُمَّ قالوا هَلّا اِمتَلَأتَ لَقالَت","هُوَ حَسبي وَلَم تُرِد مِن مَزيدِ",37,"د",1,0],["ثُمَّ قَدِّم لَنا التَأَهُّبَ لِلصَو","مِ وَداعَ السَلافَةِ الخَندَريسِ",38,"س",1,0],["ثُمَّ قُل كُلَّما تَراءَت لَكَ الكَأ","سُ فَشابَت بِها فُروعُ الظَلامِ",39,"م",1,0],["ثُمَّ قابَلتُ أَيادي ثَناهُ","بِدُعاءٍ صالِحٍ مُستَجابِ",40,"ب",1,0],["ثُمَّ قيلَ اِهتَدى فَيالَيتَهُ دا","مَ عَلى ذَلِكَ الضَلالِ القَديمِ",41,"م",1,0],["ثُمَّ قاسَمتَني فَعِندَكَ قَلبي","حينَ فارَقتَني وَذِكرُكَ عِندي",42,"د",2,0],["ثُمَّ قولا لِكُلِّ كَهلٍ وَناشٍ","مِن بَني بَكرَ جَرِّدوا لِلقِتالِ",43,"ل",1,0],["ثم قالت إنْ جئتَ من باب","بالعطايا رأيتَ بابَ طاقْ",44,"ق",1,0],["ثُمَّ قالَت لِأُختِها قَد ظَلَمنا","إِن رَجَعناهُ خائِباً وَاِعتَدَينا",45,"ن",2,0],["ثُمَّ قالَت وَدِدتُ أَنَّ شِفاءً","لَكَ يُحمى مِنهُ الغَداةَ يَقينا",46,"ن",2,0],["ثُمَّ قالَت لِتِربِها وَلِأُخرى","مِن قَطيبٍ مَوَلَّدٍ حَدِّثاني",47,"ن",2,0],["ثُمَّ قالَت بَل لِمَن أَبغُضُكُم","شِقوَةَ العَيشِ وَتَكليفَ الحَزَن",48,"ن",1,0],["ثُمَّ قالَت وَهيَ تُذري","دَمعَ عَينَيها سُجوما",49,"م",2,0],["ثُمَّ قالَت وَدَمعُها يَغسِلُ الكُح","لَ مِراراً يَخالُ دُرّاً نَظيما",50,"م",2,0],["ثُمَّ قالَت لِتِربِها إِنَّ قَلبي","مِن هَواهُ أَمسى مُصاباً كَليما",50,"م",2,0],["ثُمَّ قالَت لا تُعلِمَنَّ بِسِرّي","يا اِبنَ عَمّي أَقسَمتُ قُلتُ أَجَل لا",51,"ل",2,0],["ثُمَّ قالَت لِأُختِها وَلِأُخرى","لَيتَهُ كانَ قَد تَزَوَّجَ عَشرا",52,"ر",2,0],["ثُمَّ قالَت لِلَّتي مَعَها","لا تُديمي نَحوَهُ النَظَرا",53,"ر",2,0],["ثُمَّ قالَت لِلَّتي مَعَها","وَيحَ نَفسي ما أَتى عُمَرُ",54,"ر",1,0],["ثُمَّ قالوا اِربَعَن عَلَيكَ وَقَضِّ ال","يَومَ بَعضَ الهُمومِ وَالأَوطارِ",55,"ر",1,0],["ثُمَّ قولي كَفَرتَ يا أَكذَبَ النا","سِ جَميعاً مِن حاضِرينَ وَبادي",56,"د",2,0],["ثُمَّ قالوا تُحِبُّها قُلتُ بَهراً","عَدَدَ النَجمِ وَالحَصى وَالتُرابِ",57,"ب",1,0],["ثُمَّ قُمنا لَمّا تَجَلّى لَنا الصُب","حُ نُعَفّي أَثارَنا بِالتُرابِ",58,"ب",1,0],["ثم قالت وهي تبكي عجباً","لكِ يا أُماه ماذا تكتمينْ",59,"ن",1,0],["ثُمَّ قالَت قَد كُنتُ آذَنتُ أَهلي","قَبلَ هَذا عَلى الَّذي قَد هَوِيتا",60,"ت",2,0],["ثُمَّ قالَت لِمَوكِبٍ كَمَها الرَم","لِ أَطاعَت لَهُ النَباتَ الرِياضُ",61,"ض",1,0],["ثُمَّ قالَت لَهُ سَأَعصيكَ فيها راغِماً","مِثلَما عَصَتني نِساها",62,"ا",3,0],["ثُمَّ قَد صاروا حَديثاً","مِثلَ عادٍ في ثَمودِ",63,"د",1,0],["ثم قام النبيُّ يدعو إلى الل","هِ وفي الكُفرِ نَجْدَةٌ وإباءُ",64,"ا",2,0],["ثُمَّ قالوا عَنْ ذُقون حُلِقَت","قُلْتُ لا بَدَّ لها أن تُخلَفا",65,"ف",2,0],["ثُمَّ قالَت جَهَرتَ بِاِسمي في الشِع","رِ فَهَلّا كَنَّيتَ في الأَشعارِ",66,"ر",1,0],["ثُمَّ قولوا لا تَمَلّوا","رَبَّنا أَبقِ الأَمينا",67,"ن",2,0],["ثم قصّرتَ في القيادةِ تسعى","يا مجرَّ الزناةِ واللايطينا",68,"ن",2,0],["ثُمَّ قالَت أَنا في عُلِّيَّةٍ","يَسهَرُ العَينُ وَأَنتَ المُشتَهر",69,"ر",1,0],["ثُمَّ قالَت نَلقاكَ بَعدَ لَيالٍ","وَاللَيالي يُبلينَ كُلَّ جَديدِ",70,"د",1,0],["ثُمَّ قَد قَصَّرَت وَما قَصَّرَ الحُب","بُ كَأَنّي جَعَلتُهُ مِن تِلادي",71,"د",2,0],["ثُمَّ قولا لَها بِقَولٍ وَفيها","ضِنَّةٌ مِن فُؤادِهِ المُستَباحِ",72,"ح",1,0],["ثُمَّ قالَت فِدىً لِنَفسِكَ نَفسي","وَفِداءٌ لِمالِ أَهلِكَ مالي",73,"ل",2,0],["ثُمَّ قُلنا دُونكَ الصَيَد بِهِ","تُدرِكِ المَحبُوبَ مِنّا وَتعِش",74,"ش",1,0],["ثم قولي من بعدها أنت ربي","هو مني حماقة وقصور",75,"ر",1,0],["ثم قاما فدلَّياني ثلاثاً","في صميم الجحيم وهي تفور",75,"ر",1,0],["ثُمَّ قالوا خراجةٌ فيه لا بد","دَ من الشق عاجلاً لتزولا",76,"ل",2,0],["ثُمَّ قالوا الحمَّى الَّتي لازمَته","تيفوئيدٌ قد لا تدوم طَويلا",76,"ل",2,0],["ثُمَّ قال