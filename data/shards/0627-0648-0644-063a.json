{"poems":[[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64026","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137185",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58255","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4987,"مريت الاطراف؟","https://www.poetsgate.com/ViewPoem.aspx?id=49587",""],[5105,"لما رأوا جيشَكَ المنصورَ منتظماً","https://www.poetsgate.com/ViewPoem.aspx?id=135335",""]],"verses":[["أولغت في مُهَج الأعداء مرهَفةً","من كل أزرَق نظارٍ بلا نظر",0,"ر",1,0],["أَولَغتَها مِن دَمِ الأَوداجِ ظامِئَةً","وَزِدتَها دُفَعاً في العَلِّ وَالنَهَلِ",1,"ل",1,0],["أولغتَهُ تامورَ كلِّ عظيمة","مستصعبٍ تامورُها أنْ يولغا",2,"غ",2,0],["اولغا بطلعتها البهيه","شمس تشع على البريه",3,"ي",2,1],["أو لَغْلَغ حَسَنُ الشّياة مُدَبّج","مثلَ العروس تُزَف ذا ألوانِ",4,"ن",1,0],["أو لغيلان لألقى صيدحا","بالموامي دهشة المندهش",5,"ش",1,0],["اول غيابك قلت مابي خلاف","واليوم شف حالي غيابك تلفها",6,"ف",3,0],["أولغتَ شبلك في الهيجا دماءَهُمُ","حتى تورَّد منه النابُ والظفر",7,"ر",1,0]]}