{"poems":[[88,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[119,"بعيشك هات اخبار المغاني","https://www.aldiwan.net/poem40469.html","عموديه"],[136,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[234,"بعثت بساكنات طائرات","https://www.aldiwan.net/poem51186.html","الوافر"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101054","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130809",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132567","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89147","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110028","البسيط"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33119","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119711","الطويل"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""],[5533,"نُكْران","https://www.poetsgate.com/ViewPoem.aspx?id=214447",""],[5688,"ظاهرة الغش في المدارس","https://www.poetsgate.com/ViewPoem.aspx?id=200922",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""]],"verses":[["كانَ مُرَّ النَفسِ أَو تَرضى العُلا","تَظمَأُ الأَفلاكُ إِن لَم يَشرَبِ",0,"ب",1,0],["كَأَنَّ مَرآهُ بَدرٌ غَيرُ مُستَتِرٍ","وَطيبَ رَيّاهُ مِسكٌ غَيرُ مُكتَتِمِ",1,"م",1,0],["كأن مراتع الغزلان تزهو","بنجد بعض اطراف الجنان",2,"ن",1,0],["كَأنَّ مُرَجَّعاتِ الوَشمِ ما","أسَارَت منها الغَوادِى والسَّوَارِي",3,"ر",2,0],["كأنّ مرورَها شَدَّا وعَدْواً","مرورُ يديك في بَذْل السَّماح",4,"ح",1,0],["كأن مرماهُ مغناطيس أنصُله","ففيه قبل انتحاءِ القصد تسديدُ",5,"د",1,0],["كانَ مَرعانا خَصيباً","فَبِهمْ عادَ جَديبا",6,"ب",2,0],["كان مرجوًّا لخير زاخر","من رجال الغد أو أسد الشّرى",7,"ر",2,0],["كأن مراميها ضمائر عصبةٍ","تجمع فيها كل باغٍ وآم",8,"م",1,0],["كان مر النفس أو ترضى العلا","تهبط الافلاك ان لم يركب",9,"ب",1,0],["كأنّ مُرّ الغرام من شغفي","شهد وشهدُ السّلوّ لي صبرُ",10,"ر",1,0],["كأن مرهفه والضرب يوقده","شمس الهجير وارواح العدى برد",11,"د",1,0],["كأن مرمى مناياها مرائرها","أو المعاش بمسنون المنون فري",12,"ر",2,0],["كأَنَّ مرآكِ مِرآةُ الالهِ تُرى","أَسنى بواهرهِ في حُسن مرآكِ",13,"ك",1,0],["كَأَنَّ مُرّي يُبَكّي مُرَّ نَكبَتِهِ","عودٌ يُقَطِّرُ ماءً وَهوَ يَستعِرُ",14,"ر",1,0],["كأنّ مريض الجفن مرهفُ باسل","فقد أثخن الأكباد جرحاً إذا سُلاّ",15,"ل",2,0],["كأن مرايا الروم انهار روضها","وأعناقهم في مائها تتوسم",16,"م",1,0],["كأن مرارة الأشواق وحي","يفجر في ربوع الغار عينا",17,"ن",2,0],["كانَ مُرْتادًا يُطَوَّى عَيْبُهُ","وعُيُونُ القَوْمِ يَخْطُبْنَ وِدادَهْ",18,"د",2,1],["كأنّ مرامه قد صار غشّا","بغير الغشّ لن تُملا السّطور",19,"ر",1,0],["كانَ مَرْمُوقاً فَحاوَلْتِ الذي","سَوْف يُبْدِيه لَقىً بيْن الرِّمالْ!",20,"ل",1,0]]}