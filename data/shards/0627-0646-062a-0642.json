?id=136230",""],[5225,"اغسلي بالبرد","https://www.poetsgate.com/ViewPoem.aspx?id=16758",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5425,"في كُلِّ يَومٍ لنا من كَربَلاءَ دَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207513",""],[5596,"عودة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=205675",""],[5616,"دَنس","https://www.poetsgate.com/ViewPoem.aspx?id=203431",""],[5628,"استغاثات حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178521",""],[5660,"فَالوَصلُ وَ الصَّدُ في أَيامِنا دُوَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23914",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[402,"ما لجرح جرحته من ضماد","https://www.poetsgate.com/ViewPoem.aspx?id=35448",""],[5897,"إلى حمامة فضولية","https://www.poetsgate.com/ViewPoem.aspx?id=176412",""],[5956,"رفضٌ وثأر","https://www.poetsgate.com/ViewPoem.aspx?id=181968",""],[5956,"جمال جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182670",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[5975,"أنتِ قلبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=53268",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[6115,"ياذميري وصل المكتوبي","https://www.poetsgate.com/ViewPoem.aspx?id=180532",""],[313,"أمل المحروم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66512&r=&rc=34",""],[5355,"لا تعذليه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87225&r=&rc=50",""]],"verses":[["إِن تَقتَطِعهُ الأَعادي عَن مَذاهِبِهِ","فَرُبَّ أَبيَضَ مَغمودٍ لِمَنشورِ",0,"ر",1,0],["إِن تَقْرِ عَلوَةُ نِضوَينا بِهِ فأَنِخْ","وَإِن أَبَتْ ذاكَ فاترُكْهُ وَلا تُنِخِ",1,"خ",1,0],["أَنتَ قاسي الفُؤادِ جَلدٌ عَلى الأَي","نِ شَديدُ القُوى شَديدُ العُرامِ",2,"م",1,0],["إِن تُقرِضوا اللَهَ في أَوطانِكُم فَلَكُم","أَجرُ المُجاهِدِ طوبى لِلَّذي اِكتَتَبا",3,"ب",2,0],["إِنْ تَقْتَرِبْ شَفَتَاهُ وَالزَّمَانُ رِضىً","تَرَقْرَقَتْ مِنْهُمَا الآيَاتُ وَالْحِكَمُ",4,"م",1,0],["إِنَّ تَقوى رَبِّنا خَيرُ نَفَل","وَبِإِذنِ اللَهِ رَيثي وَعَجَل",5,"ل",1,1],["إِن تُقبِلوا نَجعَل قِرى سَرَواتِكُم","حَولَ المَدينَةِ كُلَّ لَدنٍ مِذوَدِ",6,"د",1,0],["إِن تَقتُلوا مِئَةً بِهِ فَدَنِيَّةٌ","بِأَبي أُزَيهِرَ مِن رِجالِ الأَبطَحِ",7,"ح",1,0],["أنتَ قبل التقريظِ من كمَّل اللَ","هُ فماذا يزيدُك التقريظُ",8,"ظ",1,0],["إن تُقدَّم مُنافسيك فلن يُذ","كر للنصل إن تقدَّم فُوقا",9,"ق",2,0],["إن تقاضيتُك احتجزتَ وإن طا","ل سكوتي قابلْتَه باهتمالِ",10,"ل",1,0],["أَنْتَ قَفْرٌ جهنَّميٌّ لَعِينٌ","مُظْلِمٌ قاحلٌ مريعٌ جمودُهْ",11,"ه",1,0],["أَنْتَ قلبٌ لا شوقَ فيه ولا عزمٌ","وهذا داءُ الحَيَاةِ الدّويُّ",11,"ي",1,0],["أَنتِ قُدْسي ومعبدي وصباحي","وربيعي ونَشْوتي وخُلودي",12,"د",2,0],["انتقد ما تبديه ساعة تلحوا","من عثار ثم انتقد عثراتي",13,"ت",2,0],["اِنتَقل المُلكُ فَكانَت نُقلَةً","مِن ذِروة العزِّ إِلى أَوجِ العُلا",14,"ا",1,0],["أَنتَ قَد عَلَّمتَني تَركَ الأَسى","كُلُّ زَينٍ مُنتَهاهُ المَوتُ شَين",15,"ن",1,0],["إِن تُقرِضا فَقَضاءٌ لا يَريثَ وَإِن","وَهَبتُما فَقَبولُ الرِفدِ وَالصَفَدِ",16,"د",1,0],["إِن تَقُل في حَديثِها فَهوَ الفَر","عُ سَما في أُرومِها فَينانُه",17,"ن",2,0],["إِن تَقتُلوا مِنّا خِداشاً فَإِنَّها","عَلى إِرثِ أَضغانٍ لَكُم وَذُحولِ",18,"ل",1,1],["أَنتَ قَوتُ القُلوبِ لَو كُنتَ أَعطَي","تَ لِحُبٍّ مَن أُنسِكُم ما فاتَه",19,"ت",2,0],["أنتَ قاسٍ معذِّبٌ ليتَ أني","أستطيعُ الهجرانَ والتعذيبَا",20,"ب",2,0],["إِن تُقِم عندي ظلامي","يستَحِل ليلِي ضياء",21,"ا",2,0],["أنت قد صيرت أمري عجبا","كثرت حوليَ أطيار الربى",22,"ب",2,0],["إِن تُقارِبهُ أَو تُباعِدهُ ما لَم","تَأتِ فَحشاءَ فَهوَ مِنكَ قَريبُ",23,"ب",1,0],["إِن تَقبَلي عُذري فَلَستُ بِعائِدٍ","حَتّى تُغادَرَ في المَقابِرِ أَعظُمي",24,"م",2,0],["أَنتَ قَرَّبتَني إِلى الحينِ حَتّى","حُمِّلَ القَلبُ مِنهُمُ ما أَطاقا",25,"ق",2,0],["إِن تَقُل نُصحاً فَعَن ظَهرِ غِشٍّ","دائِمِ الغِمرِ بَعيدِ الذَهابِ",26,"ب",1,0],["إِن تُقصِني فَنِفارٌ جاءَ مِن رَشاءِ","أَو تُضنِني فَمُحاقٌ جاءَ مِن قَمَرِ",27,"ر",1,0],["أنْتقي طاقةً وذوقُكِ يهدي","ني إلى الرائعاتِ في التَّلوينِ",28,"ن",1,0],["إنْ تقولوا ما بَيَّنَتْهُ فما زَا","لَتْ بها عن عيونهم غشوَاءُ",29,"ا",2,0],["إِن تَقتُلوا اِبنَ أَبي بَكرٍ فَقَد قَتَلَت","حُجراً بِدارَةِ مَلحوبٍ بَنو أَسَدِ",30,"د",1,0],["إِن تَقتُلوا مِنّا ثَلاثَةَ فِتيَةٍ","فَلِمَن بِساحوقَ الرَعيلُ المُطنِبُ",31,"ب",1,0],["إِنْ تَقَضَّى طِيبُ الحَيَاةِ فَمَا مَعْ","نَى حَيَاةٍ قَدْ أَقْفَرَتْ مِنْ مُرَادِ",32,"د",1,0],["إِنْ تَقْتُلُونَا فَدِينُ الحقِّ فِطْرَتُنَا","والقَتْلُ في الحقِّ عِنْدَ اللهِ تفضيلُ",33,"ل",1,0],["أنتِ قد أنجبت سعداً بطلاً","وقليلٌ مثلَه مَنْ تلدين",34,"ن",1,0],["أنت قد طرتَ بي إلى عرفات","وإلى المصطفى؛ فزرت مقامه",35,"م",2,0],["أنتَ قَبْلَ الجميعِ تَعرِفُ أني","في شعوري أجري على المكشوف",36,"ف",1,0],["إن تقتلوا آباءها بسيوفكم","قترقّبوا الغارات من أيتامها",37,"م",3,0],["انت قصرت لي الكرى حين طول","ت لي الليل مظلما قلاكا",38,"ك",2,0],["انت قلبي ومهجتي ولعمري","انا لم اعرف الهوى لولاكا",39,"ك",2,0],["انت قد اطمعته فيك فلو","عنه اخفيت حكيما خبرك",40,"ك",1,0],["أنت قطعت حبل خلك بالغد","ر وأيبس ثدي هذا الإخاء",41,"ا",2,0],["إِنْ تَقْتُليني فَمَطْلُولٌ لَدَيْكِ دَمي","أَوْ تَهْجُريني فَإِنِّي غَيْرُ مُنْتَصِفِ",42,"ف",1,0],["أنت قيثاري وكاسي و","سمائي والجناح",43,"ح",1,0],["إِن تَقضِ أُمُّكَ نَحبَها فلقد رَأت","أعلامَ واحِدها تُظِلُّ النيلا",44,"ل",2,0],["أَنتَ قَصدي مِنَ الغُوَيرِ وَنَجدٍ","حينَ أَغدو مُسائِلاً وَأَروحُ",45,"ح",1,0],["أنت قطب الحسن أضحى","فلكُ الصدر مدارك",46,"ك",1,0],["إن تقترف ذنباً تقل أذنَبَت","قديّسةٌ قَبلي وقدّيس",47,"س",1,0],["ان تقتَرحني زينب ابنة مالك","أَدبا وَمعرفة أعيد وأبتدى",48,"د",2,0],["ان تقصد البجلي عشت مبجلا","اولذت بالحكمى قال تحكما",49,"م",2,0],["إنّ تقوى اللّه نعمَ الملجأ","ورجاءُ الناس بئس النبأ",50,"ا",1,1],["إِنْ تَقْصدوا لا تُحْجَبوا أ