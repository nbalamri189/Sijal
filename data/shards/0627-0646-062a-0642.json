{"poems":[[53,"أناشد أنت أطلالا بذي القور","https://www.aldiwan.net/poem30217.html","البسيط"],[63,"هل وقفة بجنوب القاع تجمعنا","https://www.aldiwan.net/poem45777.html","البسيط"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[23,"أتركتم غزو الدروب وجئتم","https://www.aldiwan.net/poem21260.html","الكامل"],[23,"يا دوس إن أبا أزيهر أصبحت","https://www.aldiwan.net/poem21465.html","الكامل"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[89,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"سألوني لم لم أرث أبي","https://www.aldiwan.net/poem8189.html","الرمل"],[45,"عهد المشوق بوصل الأنس الخرد","https://www.aldiwan.net/poem62749.html","البسيط"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[28,"إن تقتلوا منا خداشا فإنها","https://www.aldiwan.net/poem5411.html","الطويل"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[97,"الليالي يا ما أَمر الليالي","https://www.aldiwan.net/poem24353.html","الخفيف"],[97,"لا تقل عند رحيلك أسعد اللهُ مساءك","https://www.aldiwan.net/poem24410.html","مجزوء الرمل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[44,"ديمة سمحة القياد سكوب","https://www.aldiwan.net/poem30571.html","الخفيف"],[31,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[31,"ولقد قلت يوم بانوا لبكر","https://www.aldiwan.net/poem42217.html","الخفيف"],[31,"أيها القائل غير الصواب","https://www.aldiwan.net/poem42617.html","المديد"],[81,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem61518.html","البسيط"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"يا هاشم ابن حديج ليس فخركم","https://www.aldiwan.net/poem62612.html","البسيط"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[113,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[113,"لي قلب قد قلبته على الجم","https://www.aldiwan.net/poem40867.html","عموديه"],[113,"مد من عينيك للقلب شرك","https://www.aldiwan.net/poem41101.html","عموديه"],[118,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[153,"يا منية النفس كوني كيف شئت فما","https://www.aldiwan.net/poem55619.html","الطويل"],[195,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[223,"أَيصيخ لي الملك الهمام قليلا","https://www.aldiwan.net/poem55085.html","الكامل"],[230,"جسد ناحل وقلب جريح","https://www.aldiwan.net/poem14705.html","الخفيف"],[257,"جل من أعلى منارك","https://www.aldiwan.net/poem35944.html","مجزوء الرمل"],[268,"حل لدعد الروح والكيس","https://www.aldiwan.net/poem35053.html","السريع"],[269,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[269,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[273,"إن تقوى الله نعم الملجأ","https://www.aldiwan.net/poem25410.html","الرمل"],[273,"جلدا خليلي ما لنفسك تجزع","https://www.aldiwan.net/poem25489.html","الكامل"],[280,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[280,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[329,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[364,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[369,"حدثينا حديث نوح وكم كان","https://www.aldiwan.net/poem57052.html","الخفيف"],[400,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[402,"أنت قدما أتحت لي من رجائي","https://www.aldiwan.net/poem49476.html","الخفيف"],[406,"إن تقطع الأيام منك علائقي","https://www.aldiwan.net/poem32407.html","الكامل"],[413,"دمت بالنيشان والعيد سعيدا","https://www.aldiwan.net/poem53854.html","الرمل"],[413,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[413,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[468,"قالت وقلت تحرجي وصلي","https://www.aldiwan.net/poem4643.html","أحذ الكامل"],[498,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[498,"أيها الفجر النسيمات شذت","https://www.aldiwan.net/poem38044.html","الرمل"],[501,"نحن قتلنا حوشبا","https://www.aldiwan.net/poem21748.html","مجزوء الرجز"],[527,"هب لي يا رب قسطا","https://www.aldiwan.net/poem37230.html","مجزوء الرمل"],[536,"أنت قل لي بم تدعى","https://www.aldiwan.net/poem47470.html","عموديه"],[556,"نحن أهل الشام سوط الله في","https://www.aldiwan.net/poem34357.html","الرمل"],[556,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[573,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["إِن تَقتَطِعهُ الأَعادي عَن مَذاهِبِهِ","فَرُبَّ أَبيَضَ مَغمودٍ لِمَنشورِ",0,"ر",1,0],["إِن تَقْرِ عَلوَةُ نِضوَينا بِهِ فأَنِخْ","وَإِن أَبَتْ ذاكَ فاترُكْهُ وَلا تُنِخِ",1,"خ",1,0],["أَنتَ قاسي الفُؤادِ جَلدٌ عَلى الأَي","نِ شَديدُ القُوى شَديدُ العُرامِ",2,"م",1,0],["إِن تُقرِضوا اللَهَ في أَوطانِكُم فَلَكُم","أَجرُ المُجاهِدِ طوبى لِلَّذي اِكتَتَبا",3,"ب",2,0],["إِنْ تَقْتَرِبْ شَفَتَاهُ وَالزَّمَانُ رِضىً","تَرَقْرَقَتْ مِنْهُمَا الآيَاتُ وَالْحِكَمُ",4,"م",1,0],["إِنَّ تَقوى رَبِّنا خَيرُ نَفَل","وَبِإِذنِ اللَهِ رَيثي وَعَجَل",5,"ل",1,1],["إِن تُقبِلوا نَجعَل قِرى سَرَواتِكُم","حَولَ المَدينَةِ كُلَّ لَدنٍ مِذوَدِ",6,"د",1,0],["إِن تَقتُلوا مِئَةً بِهِ فَدَنِيَّةٌ","بِأَبي أُزَيهِرَ مِن رِجالِ الأَبطَحِ",7,"ح",1,0],["أنتَ قبل التقريظِ من كمَّل اللَ","هُ فماذا يزيدُك التقريظُ",8,"ظ",1,0],["إن تُقدَّم مُنافسيك فلن يُذ","كر للنصل إن تقدَّم فُوقا",9,"ق",2,0],["إن تقاضيتُك احتجزتَ وإن طا","ل سكوتي قابلْتَه باهتمالِ",10,"ل",1,0],["أَنْتَ قَفْرٌ جهنَّميٌّ لَعِينٌ","مُظْلِمٌ قاحلٌ مريعٌ جمودُهْ",11,"ه",1,0],["أَنْتَ قلبٌ لا شوقَ فيه ولا عزمٌ","وهذا داءُ الحَيَاةِ الدّويُّ",11,"ي",1,0],["أَنتِ قُدْسي ومعبدي وصباحي","وربيعي ونَشْوتي وخُلودي",12,"د",2,0],["انتقد ما تبديه ساعة تلحوا","من عثار ثم انتقد عثراتي",13,"ت",2,0],["اِنتَقل المُلكُ فَكانَت نُقلَةً","مِن ذِروة العزِّ إِلى أَوجِ العُلا",14,"ا",1,0],["أَنتَ قَد عَلَّمتَني تَركَ الأَسى","كُلُّ زَينٍ مُنتَهاهُ المَوتُ شَين",15,"ن",1,0],["إِن تُقرِضا فَقَضاءٌ لا يَريثَ وَإِن","وَهَبتُما فَقَبولُ الرِفدِ وَالصَفَدِ",16,"د",1,0],["إِن تَقُل في حَديثِها فَهوَ الفَر","عُ سَما في أُرومِها فَينانُه",17,"ن",2,0],["إِن تَقتُلوا مِنّا خِداشاً فَإِنَّها","عَلى إِرثِ أَضغانٍ لَكُم وَذُحولِ",18,"ل",1,1],["أَنتَ قَوتُ القُلوبِ لَو كُنتَ أَعطَي","تَ لِحُبٍّ مَن أُنسِكُم ما فاتَه",19,"ت",2,0],["أنتَ قاسٍ معذِّبٌ ليتَ أني","أستطيعُ الهجرانَ والتعذيبَا",20,"ب",2,0],["إِن تُقِم عندي ظلامي","يستَحِل ليلِي ضياء",21,"ا",2,0],["أنت قد صيرت أمري عجبا","كثرت حوليَ أطيار الربى",22,"ب",2,0],["إِن تُقارِبهُ أَو تُباعِدهُ ما لَم","تَأتِ فَحشاءَ فَهوَ مِنكَ قَريبُ",23,"ب",1,0],["إِن تَقبَلي عُذري فَلَستُ بِعائِدٍ","حَتّى تُغادَرَ في المَقابِرِ أَعظُمي",24,"ي",1,0],["أَنتَ قَرَّبتَني إِلى الحينِ حَتّى","حُمِّلَ القَلبُ مِنهُمُ ما أَطاقا",25,"ق",2,0],["إِن تَقُل نُصحاً فَعَن ظَهرِ غِشٍّ","دائِمِ الغِمرِ بَعيدِ الذَهابِ",26,"ب",1,0],["إِن تُقصِني فَنِفارٌ جاءَ مِن رَشاءِ","أَو تُضنِني فَمُحاقٌ جاءَ مِن قَمَرِ",27,"ر",1,0],["أنْتقي طاقةً وذوقُكِ يهدي","ني إلى الرائعاتِ في التَّلوينِ",28,"ن",1,0],["إنْ تقولوا ما بَيَّنَتْهُ فما زَا","لَتْ بها عن عيونهم غشوَاءُ",29,"ا",2,0],["إِن تَقتُلوا اِبنَ أَبي بَكرٍ فَقَد قَتَلَت","حُجراً بِدارَةِ مَلحوبٍ بَنو أَسَدِ",30,"د",1,0],["إِن تَقتُلوا مِنّا ثَلاثَةَ فِتيَةٍ","فَلِمَن بِساحوقَ الرَعيلُ المُطنِبُ",31,"ب",1,0],["إِنْ تَقَضَّى طِيبُ الحَيَاةِ فَمَا مَعْ","نَى حَيَاةٍ قَدْ أَقْفَرَتْ مِنْ مُرَادِ",32,"د",1,0],["إِنْ تَقْتُلُونَا فَدِينُ الحقِّ فِطْرَتُنَا","والقَتْلُ في الحقِّ عِنْدَ اللهِ تفضيلُ",33,"ل",1,0],["أنتِ قد أنجبت سعداً بطلاً","وقليلٌ مثلَه مَنْ تلدين",34,"ن",1,0],["أنت قد طرتَ بي إلى عرفات","وإلى المصطفى؛ فزرت مقامه",35,"م",2,0],["أنتَ قَبْلَ الجميعِ تَعرِفُ أني","في شعوري أجري على المكشوف",36,"ف",1,0],["انت قصرت لي الكرى حين طول","ت لي الليل مظلما قلاكا",37,"ك",2,0],["انت قلبي ومهجتي ولعمري","انا لم اعرف الهوى لولاكا",38,"ك",2,0],["انت قد اطمعته فيك فلو","عنه اخفيت حكيما خبرك",39,"ك",1,0],["أنت قطعت حبل خلك بالغد","ر وأيبس ثدي هذا الإخاء",40,"ا",2,0],["إِنْ تَقْتُليني فَمَطْلُولٌ لَدَيْكِ دَمي","أَوْ تَهْجُريني فَإِنِّي غَيْرُ مُنْتَصِفِ",41,"ف",1,0],["أنت قيثاري وكاسي و","سمائي والجناح",42,"ح",1,0],["إِن تَقضِ أُمُّكَ نَحبَها فلقد رَأت","أعلامَ واحِدها تُظِلُّ النيلا",43,"ل",2,0],["أَنتَ قَصدي مِنَ الغُوَيرِ وَنَجدٍ","حينَ أَغدو مُسائِلاً وَأَروحُ",44,"ح",1,0],["أنت قطب الحسن أضحى","فلكُ الصدر مدارك",45,"ك",1,0],["إن تقترف ذنباً تقل أذنَبَت","قديّسةٌ قَبلي وقدّيس",46,"س",1,0],["ان تقتَرحني زينب ابنة مالك","أَدبا وَمعرفة أعيد وأبتدى",47,"د",2,0],["ان تقصد البجلي عشت مبجلا","اولذت بالحكمى قال تحكما",48,"م",2,0],["إنّ تقوى اللّه نعمَ الملجأ","ورجاءُ الناس بئس النبأ",49,"ا",1,1],["إِنْ تَقْصدوا لا تُحْجَبوا أو تَقْرُبُوا","لا تبْعدُوا أو تَسْأَلُوا لا تمْنَعُوا",50,"ع",3,0],["أَنتَ قَرمٌ في الحَقِّ سَهلٌ وَفي البا","طِلِ صَعبٌ تَفِرُّ مِنكَ القُرومُ",51,"م",1,0],["أَنتَ قَلَّمتَ في الأَقاليمِ بِالأق","لامِ أَظفارَ ظافِراتِ الذِّئابِ",52,"ب",1,0],["إنْ تَقْتُلُوهُ فَقَدْ تُسْبَى نِسَاؤُكُمُ","وَقَدْ تَكُونُ لَهُ المُعْلاَةُ وَالخَطَرُ",53,"ر",1,0],["إنَّ تَقبيلَ صُحْنِ خَدّك نُسْكٌ","فهْو إحدى مصارعِ الشهداء",54,"ا",2,0],["أَنتَ قِسمي وَلَيسَ لي مِنكَ قِسمٌ","وَكَذا الحُبُّ وَالقِلى أَقسامُ",55,"م",1,0],["أنت قبلَ الدُّنيا خُلِقت ولكن","هي تَفنى من قَبلك المِسكِينَه",56,"ن",2,0],["إن تقدر أن المعالي جسم","كنت روحاً لذاتها الجوهريه",57,"ي",2,0],["أنتَ قِدْماً أتحْتَ لي من رَجائي","بِكَ أُنساً بِبِرِّكَ المُسْتَرام",58,"م",1,1],["إنْ تَقْطَعِ الأيّامُ منك عَلائِقِي","فأنَا المُواصِلُ بالودَادِ الصّادِقِ",59,"ق",1,1],["أَنْتَ قد ألَّفْتَ فيما بينهم","وأغظْتَ البَرْمَ والخصم الحسودا",60,"د",2,0],["إنْ تَقَدَّمْتُ إليه فالمنى","من نداه والعطاء المتوالي",61,"ي",1,0],["أنت قطب في عالم العلم منه","تستمدّ الأَقطاب والأَبدال",62,"ل",1,0],["إِن تُقبِلي نُقبِل ونُنزِلُكُم","مِنّا بِدارِ السَهلِ والرّحبِ",63,"ب",1,0],["أَنْتَ قد أظْهَرْتنا بعد الخَفا","ثَبَتَ الوَعْدُ وقد حانَ الزَّمَنْ",64,"ن",1,0],["أنتَ قَدْ شابهْتَ مِصباحَ الهُدى","وهو يعْلو لم نَقُلْ حاكى الصَّباحا",65,"ح",2,0],["إن تَقتُلُوا مِنَّا أَبَا ال","يَقظَانِ شَيخاً مُسلِمَا",66,"م",2,0],["أَنْتَ قَدْ عَوَّدْتَني البِ","رّ بِعاداتٍ جَمِيلَهْ",67,"ل",2,0],["أنتَ قل لي بمَ تُدعى","يا نَصيراً لِلطَّريفِ",68,"ف",1,1],["انتقام الله ممن شاء ذا","برجال الله أهل الغرف",69,"ف",1,0],["أنت قيد الوجود إن غبت غابا","وإذا ما حضرت كنت حجابا",70,"ب",2,1],["أَنتَ قاضٍ له الشهودُ سجايا","ه أَميرٌ له المعالي جُنودُ",71,"د",1,0]]}