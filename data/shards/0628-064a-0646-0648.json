{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[113,"يا غزالا يقل مسكا فتيقا","https://www.aldiwan.net/poem16499.html","الخفيف"],[139,"حان وقت الطلا فقم يا نديم","https://www.aldiwan.net/poem48885.html","الخفيف"],[146,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[154,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[234,"نحن في روضة يقصر عنها","https://www.aldiwan.net/poem50980.html","الخفيف"],[242,"عللاني بمطرب الأشعار","https://www.aldiwan.net/poem18802.html","الخفيف"],[308,"بت من روض خده","https://www.aldiwan.net/poem57963.html","مجزوء الخفيف"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[435,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[498,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34538","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53913","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96703","الرمل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35709","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101041","المجتث"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143883","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27636","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77362","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60864","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93910","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93859","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93811","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99430","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103452","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216632",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4935,"صاح رز قبر الكريمبن الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=129515",""],[4978,"رد على قصيدة ويعود غريباً","https://www.poetsgate.com/ViewPoem.aspx?id=177348",""],[4988,"تغتال الشّهيق","https://www.poetsgate.com/ViewPoem.aspx?id=186969",""],[5121,"فرفوري","https://www.poetsgate.com/ViewPoem.aspx?id=37467",""],[5409,"شهد الليل غارة للغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=155312",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""]],"verses":[["بَينِ وَبَينَكَ حُرمَتانِ تَلاقَتا","نَثري الَّذي بِكَ يَقتَدي وَقَصيدي",0,"د",2,0],["بَينَ وَعد آمالِنا وَوَعيد","مِنكَ تَستَنظر الكَذوب الصَدوقا",1,"ق",2,0],["بين ورد ونرجس وأقاح","وسرورٍ ولذة ونعيمِ",2,"م",1,0],["بيْنٌ وهجرٌ يَضيع الوصلُ بينهما","فكيف أرجو خِصام الحبِّ بالملَلِ",3,"ل",1,0],["بين ورد هام في وجنته","نرجسٌ يسرق منه النظرا",4,"ر",2,0],["بين وردٍ وسوسَنٍ وبَهَارٍ","سعودٍ قد جانبتها النحوس",5,"س",1,0],["بَيْنَ وَرْدٍ وَسَوْسَنٍ وَأَقَاحٍ","وَشَقِيقٍ وَنَرْجِسٍ وَبَهَارِ",6,"ر",1,0],["بين ورد مفتحٍ","وشرابٍ مسكرِ",7,"ر",1,0],["بين وصلٍ صافي النعيمِ وهجر","غاضَ فيه نبعُ الصبا والشباب",8,"ب",1,0],["بين وردٍ من الخدود وآسٍ","من عذارٍ وناظرٍ نرجسيّ",9,"ي",1,0],["بين وزيرٍ تغُصُّ الصدرَ جلستُهُ","يختال أو مَلِكٍ في الفرس جبّارِ",10,"ر",1,0],["بَينَ وَردَينِ مِن بَنانٍ وَخَد","وَشَرابَينِ مِن رِضابٍ وَراحِ",11,"ح",1,0],["بين وَهْدٍ غُبْرِ المتون وهَيْها","تَ وِهادٌ مغبرّةٌ من قِلاعِ",12,"ع",1,0],["بَينَ وَردٍ وَبَينَ آسٍ جَنِيٍّ","وَسطَ بُستانِ ديرٍ ما سَرجيسِ",13,"س",1,0],["بَيِّنُوا نِسْبتَه لي منهما","واتْرُكُوا نسبتَه لابن فَرَجْ",14,"ج",1,0],["بينَ وَجدي واِشتياقي","لسعيرِ الشوقِ سالِ",15,"ل",1,0],["بَينَ وَريدَيها وَبَينَ الجَحفَلِ","تُلقيهِ في طُرقٍ أَتَتها مِن عَلِ",16,"ل",1,0],["بَينَ وَصلٍ وَصُدودِ","كَحَياةٍ وَمَماتِ",17,"ت",1,0],["بينٌ وطول سهاد","رحماك يا ذا الجلال",18,"ل",1,0],["بين وردٍ كوردِ خَدَّيه في الحس","ن وروضٍ كوجهه في الجمال",19,"ل",1,0],["بين وَعدٍ مُبَشِّرٍ بِنَعيمٍ","في فَرادِيسَ خالداتِ الجِنانِ",20,"ن",1,0],["بينوا أمرنا لكل لبيبٍ","في كلامٍ إن شئتم أو كتاب",21,"ب",1,0],["بَينَ وَثبٍ تَغتَرُّ فيهِ المَنايا","عَن ثَنايا تَجري عَلَيها الدِماءُ",22,"ا",2,0],["بين وبينَ الفقر صوتٌ واحدٌ","يا راشدَ بن مظفرٍ يا راشدُ",23,"د",1,0],["بين ورد ونرجس وأقاح","جنب نهريريك نهر بغداد",24,"د",1,0],["بين وقت مضى وهذا الزمان","ظهر الفرق بين البرهان",25,"ن",1,1],["بين ورد ونرجس عن يمين","وأقاحي وسوسن عن شمال",26,"ل",1,0],["بين ورد ونرجس عن يمين","وشقيق وسوسن عن شمال",27,"ل",1,0],["بين وردٍ ونرجسٍ وتلالي","أقحوانٍ وبابلي مدام",28,"م",1,0],["بين وردٍ ونرجسٍ وخزامى","وبنفس وسوسن وبهار",29,"ر",1,0],["بين وجوه تُضل من لا","يضل في ضوئها المبين",30,"ن",1,0],["بين وادي النقا وبين المصلّى","زمن مر ما ألذ وأحلى",31,"ل",2,1],["بين واش وشى بافتراء","وعذول يعزى الى العوّاء",32,"ا",2,0],["بين ولدان وحور حل في","جنة الفردوس بالخير العميم",33,"م",1,0],["بين واعٍ أسيادُه خلف بحرٍ","وتقيٍّ ككيس قطنٍ صافِ",34,"ف",1,0],["بين وعي آ وبين حالة لا وعي","أدرك اللي صار من حولي واحيق",35,"ق",1,0],["بَيْنَ وَرْدٍ وَالحَنَايَا بَلَّلَتْنَا","سَاحَتْ الأَنْفَاسُ فِي رَوْضِي جِنَانَا",36,"ن",2,0],["بين وحلٍ إذا أتى القر طامٍ","وغبارٍ إن أقبل الحر قاتم",37,"م",1,0],["بيّن وأعثَرْنا لبثُنا تثْقَف","نهم كذاك وأَيُّها الثقلانِ",38,"ن",1,0],["بين وادٍ من ضفتيه تدانت","بجناها أشجاره قد حناها",39,"ا",3,0]]}