{"poems":[[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[90,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[119,"من لدمع طغى وقلب مهيم","https://www.aldiwan.net/poem40590.html","عموديه"],[259,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[353,"كن قاطعا من قطع القده","https://www.aldiwan.net/poem20140.html","السريع"],[382,"يا إلهي النفوس قد غالهنه","https://www.aldiwan.net/poem59227.html","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61026","البسيط"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109637","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140304",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216777","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205604","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102937","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44713","الرمل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119395","الرجز"],[5057,"زارني في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=198052",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5550,"أنت بحر","https://www.poetsgate.com/ViewPoem.aspx?id=211903",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5756,"ثامن السبع العجايب","https://www.poetsgate.com/ViewPoem.aspx?id=5422",""],[5950,"غثى ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128333",""],[5956,"القِيَمُ المقلوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184102",""]],"verses":[["كَنَقانِقِ الظَلمانِ أَعجَلَها الدُجى","وَحَدا بِها زَجِلُ الرَواعِدِ مُبرِقُ",0,"ق",1,0],["كن قوياً في كل ما تَدّعيه","إنما الفَوز للقويٍّ المِلَمّ",1,"م",1,0],["كَنَقا الكَثيبِ تَهَيَّلَت أَعطافُهُ","وَالريحُ تَجبُرُ مَتنَهُ وَتُهيلُ",2,"ل",1,0],["كنقيبة الملك الحليم فانه","للكائنات ملاكها وقوامها",3,"م",3,0],["كن قليبي خير العشيرين ما عش","ت فقدر الامين عال مفخم",4,"م",1,0],["كن قريباً،كن صديقاً","لا كبعض الناس ضدّي",5,"د",2,0],["كُنْ قَاطِعاً مَن قَطَعَ القِدَّه","وَسَلّ عَنهُ النَّفْسَ بِالوَحْدَه",6,"ه",1,1],["كُنَّ قَبلاً هياكلاً نيِّراتٍ","بضياءٍ ينير أفعالهنه",7,"ن",2,0],["كَنُقطة الأَرض فَالآمال تَقصدها","مِن كُل ناحِيَة بِالطبع كَالماء",8,"ا",2,0],["كن قنوعاً بما تيسر فالطا","مع عبدٌ ما تنقضي آرابُه",9,"ب",2,0],["كنقطة شكٍ في صحيفة كاتبٍ","بها يقصد التنبيهُ في موضعِ السرَّ",10,"ر",1,0],["كُن قَناتي وَكُن حُسامي وَترسي","في قِراعِ الأَذى وَدَفعِ الشُرورِ",11,"ر",1,0],["كن قدوةً لهم في الفضل تبق بهم","حيا وأنت بطي الموت منشور",12,"ر",1,0],["كن قريباً أو كن بعيداً فما أن","ت على الحالتين بالمختار",13,"ر",1,0],["كن قطرة من سحاب مثمر غدق","ولا تكن ذرة من رمل صحراءِ",14,"ا",2,1],["كنقاخ وطحلب وجفاخ","وسنير وشبرق وطخات",15,"ت",1,0],["كُن قَنوعاً بِالَّذي قَد قَسَما","قاسمُ الأَرزاق مُحيي الأَنفُسِ",16,"س",1,0],["كنقرة من فضة","في حقه من ذهب",17,"ب",1,0],["كُن قريبَاً أكُنْ مُعافَىً وإلّا","ستراني أُذوبُ كالشمعِ قهرَا",18,"ر",2,0],["كُنْ قصيَّاً ، فنصفُك اليومَ مَيْتٌ","أو خفيَّاً أدمنتَ سُكنى المغارة",19,"ر",2,0],["كنْ قريبًا مني وليس بعيدًا","إنَّ طعْمَ الوصال جدُّ فريد",20,"د",1,0],["كُنْ قَرِينًا لِلْهُدَي كُنْ","مُعْرِضًا عَمَّا سِوَاهُ",21,"ا",2,0],["كن قلبي في وصالك وابل ٍلحظة نزوله","وفي فراقك مثل دمعة تنحدر من عين شايب",22,"ب",1,0],["كنّ قلبي كريمٍ طاح بيد خبثى","يرمي الطيب جزل ويذكرونه رثيث",23,"ث",1,0],["كن قاسياً فالكونُ أصبح قاسياً","كنْ فاسقاً فالكون أصبح فاسقا",24,"ق",2,0]]}