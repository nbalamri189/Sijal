{"poems":[[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"يا كاسي الخلق الرضي وصاحب","https://www.aldiwan.net/poem68898.html","الكامل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[88,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[89,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[45,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[45,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[81,"بأبي جفون معذبي وجفوني","https://www.aldiwan.net/poem61470.html","الكامل"],[46,"العيش ثقل وقاضي الأرض ممتحن","https://www.aldiwan.net/poem23482.html","البسيط"],[46,"سكنت إلى الدنيا فلما عرفتها","https://www.aldiwan.net/poem23505.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39668","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54540","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54574","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[116,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[129,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[136,"ما بال أصدق وعدها كسراب","https://www.aldiwan.net/poem49142.html","الكامل"],[151,"أجد مدح خير الخلق ذاتا وجودة","https://www.aldiwan.net/poem68582.html","الطويل"],[167,"زكاة رؤوس الناس في عيد فطرهم","https://www.aldiwan.net/poem47061.html","الطويل"],[212,"خلا جيبي ففارقني رفاقي","https://www.aldiwan.net/poem46253.html","الوافر"],[213,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[262,"لقد علمت ما قد اضر بنا البعد","https://www.aldiwan.net/poem38339.html","الطويل"],[262,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[276,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[276,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[286,"بين الجبال وبين حوض","https://www.aldiwan.net/poem39375.html","مجزوء الكامل"],[299,"ما الورد إِن زق على","https://www.aldiwan.net/poem35476.html","عموديه"],[299,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[321,"إلى الله شكرا آل مصر إليكم","https://www.aldiwan.net/poem67175.html","الطويل"],[378,"يا لها فرحة بها العقل يسمو","https://www.aldiwan.net/poem59148.html","الخفيف"],[417,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[438,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[440,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[442,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[459,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[459,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[459,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[480,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[515,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[552,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[561,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"]],"verses":[["زَكِيُّ المَشاعِرِ عَفُّ الهَوى","شَهِيُّ الأَحاديثِ حُلوُ السَمَر",0,"ر",1,0],["زَكّاكَ إِقدامٌ وَرَأيٌ شاهِدٌ","وَنَقِيُّ إيمانٍ وَحُسنُ بَيانِ",1,"ن",1,0],["زكا مغرساً فالذام ليس يؤمّه","وطاب جنىً فالسوء ليس يمسّه",2,"س",2,0],["زكت لك نفس بين جنبيك حرّة","فلا أظهرت كبراً ولا أضمرت ضغنا",3,"ن",2,0],["زَكا وأمْكنهُ فعل الجميل فما","في الناسِ لو قصرت جدواه عاذره",4,"ر",2,0],["زكت عناصر مولانا وأردفها","فضلٌ فأول ما زكى عناصره",5,"ر",2,0],["زكت دماء لاجل الحق سائبة","فانها وحدها للمجد اثمان",6,"ن",1,0],["زكوت فرعاً كما قد","زكا لغرسك أصل",7,"ل",1,0],["زكى القلب طُهِّر من","هوىً وغوايةٍ دمه",8,"م",2,0],["زَكَت صَنائِعُهُ عِندي وَأَنعُمُهُ","كَما زَكَت مِدَحي فيهِ وَأَشعاري",9,"ر",2,0],["زَكَت بِالفَتحِ أُحدانُ المَساعي","وَأَوضَحَ دارِسُ الكَرَمِ المَحيلِ",10,"ل",1,0],["زَكّاكُمُ قُربانُ إيمانِكُم","بِهِ وَزَكّى الغَيرَ إيمانُه",11,"ن",2,0],["زَكَتْ في فروعِ المَكرماتِ فروعُها","وأَنجبتِ الدُنْيا بآبائها النُّجبِ",12,"ب",1,0],["زكَا تُربُ مَنشَاهُ وطَابَت أصُولُهُ","وأينَع زهرٌ فِيهِ كَالنَّجمِ نَاجِمُ",13,"م",1,0],["زَكّي جَمالاً أَنتِ فيهِ غَنِيَّةٌ","وَتَصَدَّقي مِنهُ عَلى المِسكينِ",14,"ن",1,0],["زَكّوهُ دَهراً فَلَمّا صارَ قاضِيَهُم","وَاِستَعمَلَ الحَقَّ عادوا لا يُزَكّونَه",15,"ن",2,0],["زَكَنَّ المَنايا أَن زَكَونَ فَنِعمَةٌ","مِنَ اللَهِ دامَت لِلزَواكي الزَواكِنِ",16,"ن",1,0],["زَكتْ أُميَّةُ في أعراقه وجرتْ","دماً يُروِّي الثرى أو يغسلُ العارا",17,"ر",2,0],["زَكِيٍّ لَكَ الإِرْثُ العَظِيمُ مِن العُلَى","وَمَا ثَرْوَةٌ فِي جَنْبِهِ بِحِسَابِ",18,"ب",1,0],["زَكي بِكَ العَزَاءُ لِمِصْرَ عَنْهُ","إِذَا افتُقِدَتْ مَكَانُ الأَوْفِياءِ",19,"ا",2,0],["زَكَّى سَجَايَاهَا الجَمِيلَةَ مَا تُرَى","مِنْ ذِلكَ الأَدَبِ الجَمِيلِ الوَافِرِ",20,"ر",1,0],["زَكَّى لَدَى الْخَافِقَيْنِ العَارِفَيْنِ بِهِ","مَكَانَ فَضْلِكَ بَيْنَ الْجِلَّةِ النُّخَبِ",21,"ب",1,0],["زَكَوت طِفلاً فَكُنت فَخراً","وَكَم كَبيرٍ لَهُ مَخازي",22,"ز",2,0],["زَكا فَأَتاني يَغلِبُ الجَمعَ وَحدَهُ","وَعَن رَأيِهِ يصّالحُ الفتيانِ",23,"ن",1,0],["زَكا اِبني في تِسعٍ وَأربَعَةٍ لَهُ","وَلَم أَزكُ في خَمسينَ عاماً وَنَيِّفِ",24,"ف",1,0],["زك الاصول بكل فعل طيب","منشور اصل المرء طي فعاله",25,"ل",2,0],["زكَا عنصراً من دَوْحةٍ يغربيّة","تعالتْ سموّاً من كرامِ العناصرِ",26,"ر",1,0],["زكّي الجمالِ لغارمٍ إحساسهُ","أول ست مالكةً لخيرِ نصابِ",27,"ب",1,0],["زَكا فَزَكَت أَفعالُهُ وَطِباعُه","فَما شَبَّ حَتّى اِمتَدَّ في الفَضلِ باعُهُ",28,"ه",1,0],["زَكَاةُ رؤوسِ الناسِ في عيدِ فِطرهِم","يَقولُ رسولُ اللهِ صاعٌ من البُرِّ",29,"ر",1,1],["زكى في وزارته غريب","فلا تستنكروا شكوى الغريب",30,"ب",1,0],["زَكِيُّ نَفْسٍ لَهُ في الحَمْدِ مَرْتَبةٌ","ما قَطُّ يَحْمِلُها قَفْرٌ وسَمْلاقُ",31,"ق",1,0],["زكافي الورى فعلاً ومجداً ومحتدا","وقد يثمر المعروف ما اينع المجد",32,"د",1,0],["زكى مباني الأصل والفرع والعلا","رفيع عماد البيت عند التناسب",33,"ب",1,0],["زَكا زَكَرِياءُ المُبارَك مَنْشَأ","فَصَرّح عن مَعْروفِهِ نَابِتُ البَكرِ",34,"ر",1,0],["زَكَرِياءَ بن يَحْيَى المُرْتَضَى","ابْن عَبْد الواحدِ بن عُمَرا",35,"ر",2,0],["زكاد واسطة الجبا","ل أمامنا كالمنبر",36,"ر",1,0],["زكا وطاب عبْقُه","ونفساً مُرّددا",37,"د",2,0],["زكا نبتُ البلادِ وَليس بدْعاً","زكيّاتُ الدما كانت حياها",38,"ا",3,0],["زَكى اِنتسابهمُ ثمّ اِكتسابهمُ","حُقّ العيانُ فلا جحد ولا تهمُ",39,"م",1,0],["زَكت ليلة وافته فيها ودونها","لِسابعة العشرين عشر وَفت حسبا",40,"ب",2,0],["زَكاءٌ وَحِلمٌ وَاِقتِدارٌ وَحِكمَةٌ","وَحُسنُ أَطلاعٍ مِنهُ نُنفِقُ مَن سِعَهُ",41,"ع",2,0],["زكريّا أبشرْ بأسنى رسولٍ","مذ رأيت الإله عندك يُحوَى",42,"و",2,0],["زكوتُ فما ألمَمْتُ يوماً بريبة","ويزكو الفتى من حيث تزكو العناصر",43,"ر",1,0],["زكت أرومتهم إذ عُظّموا شرفاً","على الورى فحكاهم منهم التبَعُ",44,"ع",1,0],["زكا فَرعُها فِي آلِ ذِي النُّونِ سُنَّةً","بِهَا رَاقَتِ الأثمارُ فِي يابِسِ الغرسِ",45,"س",1,0],["زَكَا تُرْبُها فِي ثرى المَأْثُرَاتِ","فأَيْنَعَ إِثمارُها بالزَّكاءِ",46,"ا",2,0],["زكا أُما سمت وَأَبا","وأَعماماً سمت نسبا",47,"ب",2,0],["زكتْ ما زكتْ حتى انتهتْ ثمراتُها","إلى خير فرع شفَّ عنه أُرومُ",48,"م",1,0],["زكا تحتها التربُ اللئيمُ وأورق ال","قَتادُ الجفيفُ فهو ريّان يانعُ",49,"ع",1,0],["زكنتُ إليه ظنّاً صار حقاً","وكم وقفتْ براكبها الطماعهْ",50,"ع",2,0],["زكيَّة طينتُهم حديدة","شوكتُهم طاب حصاهم وكثُرْ",51,"ر",1,0],["زكا غُصُنٌ من آل ضبَّة أصلُهُ","أبوك له فرعٌ وإنك عَقْبُهُ",52,"ب",2,0],["زكا نجره في العالمين وخيمه","مهيب تلاع المأثرات وخيمها",53,"م",3,0],["زكية النفس ذات اللطف معدنه","سلسلة المجد شبت في مبانيه",54,"ي",2,0],["زكيٌّ لا تَمَلُّ له اِنتِشاقاً","كأنّ هواهُ أنفاسُ الكعابِ",55,"ب",1,0],["زكيُّ النفسِ محمود السّجايا","مُصانُ العِرضِ ممدوحُ الجنابِ",55,"ب",1,0],["زَكَتْ غُروسي فما ذنبي إلى نَفَرٍ","ما كان يوماً لهمْ غرسي نما وزكي",56,"ك",2,0],["زكّهِ واغرِسْ بجنبيهِ رضىً","كالرضى الساكنِ في رمْلِ البقيعْ",57,"ع",1,0]]}