{"poems":[[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"يا كاسي الخلق الرضي وصاحب","https://www.aldiwan.net/poem68898.html","الكامل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[88,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[89,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[45,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[45,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[81,"بأبي جفون معذبي وجفوني","https://www.aldiwan.net/poem61470.html","الكامل"],[46,"العيش ثقل وقاضي الأرض ممتحن","https://www.aldiwan.net/poem23482.html","البسيط"],[46,"سكنت إلى الدنيا فلما عرفتها","https://www.aldiwan.net/poem23505.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39668","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54540","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54574","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"]],"verses":[["زَكِيُّ المَشاعِرِ عَفُّ الهَوى","شَهِيُّ الأَحاديثِ حُلوُ السَمَر",0,"ر",1,0],["زَكّاكَ إِقدامٌ وَرَأيٌ شاهِدٌ","وَنَقِيُّ إيمانٍ وَحُسنُ بَيانِ",1,"ن",1,0],["زكا مغرساً فالذام ليس يؤمّه","وطاب جنىً فالسوء ليس يمسّه",2,"س",2,0],["زكت لك نفس بين جنبيك حرّة","فلا أظهرت كبراً ولا أضمرت ضغنا",3,"ن",2,0],["زَكا وأمْكنهُ فعل الجميل فما","في الناسِ لو قصرت جدواه عاذره",4,"ر",2,0],["زكت عناصر مولانا وأردفها","فضلٌ فأول ما زكى عناصره",5,"ر",2,0],["زكت دماء لاجل الحق سائبة","فانها وحدها للمجد اثمان",6,"ن",1,0],["زكوت فرعاً كما قد","زكا لغرسك أصل",7,"ل",1,0],["زكى القلب طُهِّر من","هوىً وغوايةٍ دمه",8,"م",2,0],["زَكَت صَنائِعُهُ عِندي وَأَنعُمُهُ","كَما زَكَت مِدَحي فيهِ وَأَشعاري",9,"ي",1,0],["زَكَت بِالفَتحِ أُحدانُ المَساعي","وَأَوضَحَ دارِسُ الكَرَمِ المَحيلِ",10,"ل",1,0],["زَكّاكُمُ قُربانُ إيمانِكُم","بِهِ وَزَكّى الغَيرَ إيمانُه",11,"ن",2,0],["زَكَتْ في فروعِ المَكرماتِ فروعُها","وأَنجبتِ الدُنْيا بآبائها النُّجبِ",12,"ب",1,0],["زكَا تُربُ مَنشَاهُ وطَابَت أصُولُهُ","وأينَع زهرٌ فِيهِ كَالنَّجمِ نَاجِمُ",13,"م",1,0],["زَكّي جَمالاً أَنتِ فيهِ غَنِيَّةٌ","وَتَصَدَّقي مِنهُ عَلى المِسكينِ",14,"ن",1,0],["زَكّوهُ دَهراً فَلَمّا صارَ قاضِيَهُم","وَاِستَعمَلَ الحَقَّ عادوا لا يُزَكّونَه",15,"ن",2,0],["زَكَنَّ المَنايا أَن زَكَونَ فَنِعمَةٌ","مِنَ اللَهِ دامَت لِلزَواكي الزَواكِنِ",16,"ن",1,0],["زَكتْ أُميَّةُ في أعراقه وجرتْ","دماً يُروِّي الثرى أو يغسلُ العارا",17,"ر",2,0],["زَكِيٍّ لَكَ الإِرْثُ العَظِيمُ مِن العُلَى","وَمَا ثَرْوَةٌ فِي جَنْبِهِ بِحِسَابِ",18,"ب",1,0],["زَكي بِكَ العَزَاءُ لِمِصْرَ عَنْهُ","إِذَا افتُقِدَتْ مَكَانُ الأَوْفِياءِ",19,"ا",2,0],["زَكَّى سَجَايَاهَا الجَمِيلَةَ مَا تُرَى","مِنْ ذِلكَ الأَدَبِ الجَمِيلِ الوَافِرِ",20,"ر",1,0],["زَكَّى لَدَى الْخَافِقَيْنِ العَارِفَيْنِ بِهِ","مَكَانَ فَضْلِكَ بَيْنَ الْجِلَّةِ النُّخَبِ",21,"ب",1,0],["زَكَوت طِفلاً فَكُنت فَخراً","وَكَم كَبيرٍ لَهُ مَخازي",22,"ي",1,0],["زَكا فَأَتاني يَغلِبُ الجَمعَ وَحدَهُ","وَعَن رَأيِهِ يصّالحُ الفتيانِ",23,"ن",1,0],["زَكا اِبني في تِسعٍ وَأربَعَةٍ لَهُ","وَلَم أَزكُ في خَمسينَ عاماً وَنَيِّفِ",24,"ف",1,0]]}