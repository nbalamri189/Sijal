","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139662",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139646",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139755",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139633",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4978,"يُحيي الليالي حوليَ السُّمّارُ","https://www.poetsgate.com/ViewPoem.aspx?id=177197",""],[5055,"زكية","https://www.poetsgate.com/ViewPoem.aspx?id=105166",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5145,"عودوا ببعض عشيات الحمى عودوا","https://www.poetsgate.com/ViewPoem.aspx?id=108065",""],[5155,"الربيع العائد","https://www.poetsgate.com/ViewPoem.aspx?id=176168",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"الحسين -سبط رسول الله-","https://www.poetsgate.com/ViewPoem.aspx?id=199897",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5529,"معي فلنهن الدين والآية الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=172829",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5736,"معابد الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=211829",""],[5790,"أسرب المها لا حبذا أنت من سرب","https://www.poetsgate.com/ViewPoem.aspx?id=111944",""],[5879,"يا نبض القلب","https://www.poetsgate.com/ViewPoem.aspx?id=215451",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5956,"زكام","https://www.poetsgate.com/ViewPoem.aspx?id=182074",""],[5956,"هلّل إلى التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=192293",""],[6031,"سَلاَمٌ إذَا استَعْبَقْتَ رَيَّاهُ أُجلِيَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46402",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[210,"أهدي لذي المجد الرفيع وذي الصفا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612371",""],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""]],"verses":[["زَكِيُّ المَشاعِرِ عَفُّ الهَوى","شَهِيُّ الأَحاديثِ حُلوُ السَمَر",0,"ر",1,0],["زَكّاكَ إِقدامٌ وَرَأيٌ شاهِدٌ","وَنَقِيُّ إيمانٍ وَحُسنُ بَيانِ",1,"ن",1,0],["زكا مغرساً فالذام ليس يؤمّه","وطاب جنىً فالسوء ليس يمسّه",2,"س",2,0],["زكت لك نفس بين جنبيك حرّة","فلا أظهرت كبراً ولا أضمرت ضغنا",3,"ن",2,0],["زَكا وأمْكنهُ فعل الجميل فما","في الناسِ لو قصرت جدواه عاذره",4,"ر",2,0],["زكت عناصر مولانا وأردفها","فضلٌ فأول ما زكى عناصره",5,"ر",2,0],["زكت دماء لاجل الحق سائبة","فانها وحدها للمجد اثمان",6,"ن",1,0],["زكوت فرعاً كما قد","زكا لغرسك أصل",7,"ل",1,0],["زكى القلب طُهِّر من","هوىً وغوايةٍ دمه",8,"م",2,0],["زَكَت صَنائِعُهُ عِندي وَأَنعُمُهُ","كَما زَكَت مِدَحي فيهِ وَأَشعاري",9,"ر",2,0],["زَكَت بِالفَتحِ أُحدانُ المَساعي","وَأَوضَحَ دارِسُ الكَرَمِ المَحيلِ",10,"ل",1,0],["زَكّاكُمُ قُربانُ إيمانِكُم","بِهِ وَزَكّى الغَيرَ إيمانُه",11,"ن",2,0],["زَكَتْ في فروعِ المَكرماتِ فروعُها","وأَنجبتِ الدُنْيا بآبائها النُّجبِ",12,"ب",1,0],["زكَا تُربُ مَنشَاهُ وطَابَت أصُولُهُ","وأينَع زهرٌ فِيهِ كَالنَّجمِ نَاجِمُ",13,"م",1,0],["زَكّي جَمالاً أَنتِ فيهِ غَنِيَّةٌ","وَتَصَدَّقي مِنهُ عَلى المِسكينِ",14,"ن",1,0],["زَكّوهُ دَهراً فَلَمّا صارَ قاضِيَهُم","وَاِستَعمَلَ الحَقَّ عادوا لا يُزَكّونَه",15,"ن",2,0],["زَكَنَّ المَنايا أَن زَكَونَ فَنِعمَةٌ","مِنَ اللَهِ دامَت لِلزَواكي الزَواكِنِ",16,"ن",1,0],["زَكتْ أُميَّةُ في أعراقه وجرتْ","دماً يُروِّي الثرى أو يغسلُ العارا",17,"ر",2,0],["زَكِيٍّ لَكَ الإِرْثُ العَظِيمُ مِن العُلَى","وَمَا ثَرْوَةٌ فِي جَنْبِهِ بِحِسَابِ",18,"ب",1,0],["زَكي بِكَ العَزَاءُ لِمِصْرَ عَنْهُ","إِذَا افتُقِدَتْ مَكَانُ الأَوْفِياءِ",19,"ا",2,0],["زَكَّى سَجَايَاهَا الجَمِيلَةَ مَا تُرَى","مِنْ ذِلكَ الأَدَبِ الجَمِيلِ الوَافِرِ",20,"ر",1,0],["زَكَّى لَدَى الْخَافِقَيْنِ العَارِفَيْنِ بِهِ","مَكَانَ فَضْلِكَ بَيْنَ الْجِلَّةِ النُّخَبِ",21,"ب",1,0],["زَكَوت طِفلاً فَكُنت فَخراً","وَكَم كَبيرٍ لَهُ مَخازي",22,"ز",2,0],["زَكا فَأَتاني يَغلِبُ الجَمعَ وَحدَهُ","وَعَن رَأيِهِ يصّالحُ الفتيانِ",23,"ن",1,0],["زَكا اِبني في تِسعٍ وَأربَعَةٍ لَهُ","وَلَم أَزكُ في خَمسينَ عاماً وَنَيِّفِ",24,"ف",1,0],["زكت بكم الأكوان حينا وبوركت","فيا بركات افرغت من عيابها",25,"ب",3,0],["زكها بالتقوى فما تفلح النف","س بحال الا على تقواها",26,"ا",3,0],["زكى قلوبهم النور المبين كما","يزكو النبات بما يلقى من المطر",27,"ر",1,0],["زك الاصول بكل فعل طيب","منشور اصل المرء طي فعاله",28,"ل",2,0],["زكَا عنصراً من دَوْحةٍ يغربيّة","تعالتْ سموّاً من كرامِ العناصرِ",29,"ر",1,0],["زكّي الجمالِ لغارمٍ إحساسهُ","أول ست مالكةً لخيرِ نصابِ",30,"ب",1,0],["زَكا فَزَكَت أَفعالُهُ وَطِباعُه","فَما شَبَّ حَتّى اِمتَدَّ في الفَضلِ باعُهُ",31,"ه",1,0],["زَكَاةُ رؤوسِ الناسِ في عيدِ فِطرهِم","يَقولُ رسولُ اللهِ صاعٌ من البُرِّ",32,"ر",1,1],["زكى في وزارته غريب","فلا تستنكروا شكوى الغريب",33,"ب",1,0],["زَكِيُّ نَفْسٍ لَهُ في الحَمْدِ مَرْتَبةٌ","ما قَطُّ يَحْمِلُها قَفْرٌ وسَمْلاقُ",34,"ق",1,0],["زكافي الورى فعلاً ومجداً ومحتدا","وقد يثمر المعروف ما اينع المجد",35,"د",1,0],["زكى مباني الأصل والفرع والعلا","رفيع عماد البيت عند التناسب",36,"ب",1,0],["زَكا زَكَرِياءُ المُبارَك مَنْشَأ","فَصَرّح عن مَعْروفِهِ نَابِتُ البَكرِ",37,"ر",1,0],["زَكَرِياءَ بن يَحْيَى المُرْتَضَى","ابْن عَبْد الواحدِ بن عُمَرا",38,"ر",2,0],["زكاد واسطة الجبا","ل أمامنا كالمنبر",39,"ر",1,0],["زكا وطاب عبْقُه","ونفساً مُرّددا",40,"د",2,0],["زكا نبتُ البلادِ وَليس بدْعاً","زكيّاتُ الدما كانت حياها",41,"ا",3,0],["زَكى اِنتسابهمُ ثمّ اِكتسابهمُ","حُقّ العيانُ فلا جحد ولا تهمُ",42,"م",1,0],["زَكت ليلة وافته فيها ودونها","لِسابعة العشرين عشر وَفت حسبا",43,"ب",2,0],["زَكاءٌ وَحِلمٌ وَاِقتِدارٌ وَحِكمَةٌ","وَحُسنُ أَطلاعٍ مِنهُ نُنفِقُ مَن سِعَهُ",44,"ع",2,0],["زكريّا أبشرْ بأسنى رسولٍ","مذ رأيت الإله عندك يُحوَى",45,"و",2,0],["زكوتُ فما ألمَمْتُ يوماً بريبة","ويزكو الفتى من حيث تزكو العناصر",46,"ر",1,0],["زكت أرومتهم إذ عُظّموا شرفاً","على الورى فحكاهم منهم التبَعُ",47,"ع",1,0],["زكا فَرعُها فِي آلِ ذِي النُّونِ سُنَّةً","بِهَا رَاقَتِ الأثمارُ فِي يابِسِ الغرسِ",48,"س",1,0],["زَكَا تُرْبُها فِي ثرى المَأْثُرَاتِ","فأَيْنَعَ إِثمارُها بالزَّكاءِ",49,"ا",2,0],["زكا أُما سمت وَأَبا","وأَعماماً سمت نسبا",50,"ب",2,0],["زكتْ ما زكتْ حتى انتهتْ ثمراتُها","إلى خير فرع شفَّ عنه أُرومُ",51,"م",1,0],["زكا تحتها التربُ اللئيمُ وأورق ال","قَتادُ الجفيفُ فهو ريّان يانعُ",52,"ع",1,0],["زكنتُ إليه ظنّاً صار حقاً","وكم وقفتْ براكبها الطماعهْ",53,"ع",2,0],["زكيَّة طينتُهم حديدة","شوكتُهم طاب حصاهم وكثُرْ",54,"ر",1,0],["زكا غُصُنٌ من آل ضبَّة أصلُهُ","أبوك له فرعٌ وإنك عَقْبُهُ",55,"ب",2,0],["زكا نجره في العالمين وخيمه","مهيب تلاع المأثرات وخيمها",56,"م",3,0],["زكية النفس ذات اللطف معدنه","سلسلة المجد شبت في مبانيه",57,"ي",2,0],["زكيٌّ لا تَمَلُّ له اِنتِشاقاً","كأنّ هواهُ أنفاسُ الكعابِ",58,"ب",1,0],["زكيُّ النفسِ محمود السّجايا","مُصانُ العِرضِ ممدوحُ الجنابِ",58,"ب",1,0],["زَكَتْ غُروسي فما ذنبي إلى نَفَرٍ","ما كان يوماً لهمْ غرسي نما وزكي",59,"ك",2,0],["زكّهِ واغرِسْ بجنبيهِ رضىً","كالرضى الساكنِ في رمْلِ البقيعْ",60,"ع",1,0],["زكيُّ الأصُولِ زَكيُّ الفروع","زَكيُّ الفَخارِ زَكيُّ النَّسَب",61,"ب",1,0],["زَكِيُّ نفسٍ صدوقٌ لم يمل لهوى","حاطَ العبادَ وفي الإِصلاحِ قد دأَبا",62,"ب",2,0],["زكى أصله والفرع طاب غراسه","أرومته الشوس الكرام الأطايب",63,"ب",1,0],["زَكَّى العدولُ العدلَ في بسطةٍ","لكنْ سوى العدلِ بها جُرَحَهْ",64,"ح",2,1],["زكيت ملكك في ليا","ل الشهر بالنعم الجسام",65,"م",1,0],["زكت شرفا اعراقه وفروعه","وطابت لنا منه الفضائل والفعل",66,"ل",1,0],["زَكِيٌّ ذكِيٌّ كم جَلا نورُ فِكرِهِ","دُجى مُشكلاتٍ بانَ منهُ نَهارُها",67,"ر",3,0],["زَكِيٌّ ذَكِيٌّ شَافِعٌ عِنْدَ مَالِك","كَريِمٍ رَحِيمٍ غَافِرٍ مُتَجَاوِزِ",68,"ز",1,0],["زَكا أصلاً ولا عجبٌ","غلام قد زكا فرعا",69,"ع",2,0],["زكاتي أجريها علي وبذلها","إلي به نص الكتاب حباني",70,"ن",2,0],["زكيٌّ طاب أصلاً ثم فَرْعاً","فكم وافى بطيبٍ بعد طيب",71,"ب",1,0],["زكا رأياً وفطنته استنارت","فأوشك أن يرى ما في الضمايرْ",72,"ر",1,0],["زكت بهم الأكوان حيناً وبوركت","فيا بركات أفرغت من عيابها",73,"ب",3,0],["زكاةُ دموع العين فرضٌ على الفتى","وإن بانت الأحبابُ تَمَّ نصابه",74,"ب",2,0],["زكا طرفاه حين يذكَرُ خاله","سَنا مُضَر أو عَمّهُ غُرَّةُ الازْدِ",75,"د",1,0],["زكا بسراج الدين كالجامة التى","بها نفحات الطيب يعلها النّشرُ",76,"ر",1,0],["زكيَّ الفؤاد بلغتَ العلا","بما فيك من عزمةٍ ماضيه",77,"ي",2,1],["زكيٌّ ذكيٌّ أَورَعٌ مُتَورِّعٌ","حَيِيٌّ سخِيٌّ خاشِعُ القَلبِ أَوَّاهُ",78,"ا",2,0],["زكت الصبا وصفت أوبقات الصبا","والبدر في كبد السماء منير",79,"ر",1,0],["زكت روضة البحرين عن طيب نشرها","وعزّت شبين الكوم بين لِداتها",80,"ت",3,0],["زكت فسمت عن الدنيا طلابا","وأضنى حبها قوماً وتاما",81,"م",2,0],["زكيٌّ زها في لوحة الدهر حليةً","تحلى بها التاريخ فهي له عقد",82,"د",1,0],["زكِّى جمالاً أنت فيه غَنيّةٌ","وتصدق منه على المسكينِ",83,"ن",1,1],["زكِّي جمالاً حُزتِ فيه تمامَهُ","وتصدقي منهُ على المسكينِ",84,"ن",1,0],["زكا قدرُهُ مَنْ ذا يُباهيهِ في العُلى","يُبارز مَن أمسى له العرشُ يَبرُزُ",85,"ز",1,0],["زكي صدوق القول أيد قوله","كتاب عزيز باهر النظم معجز",85,"ز",1,0],["زكاة على الأبدان تسعى لقبره","فسيروا وزوروا والغنائم أحرزوا",85,"ز",3,0],["زَكاني مَعروفُهُ وَالجَميلُ","إِذا كانَ عِندَ زَكِيٍّ زَكا",86,"ا",1,0],["زكيُّ مجدٍ وأحسابٍ تعظِّمُهُ","سيادةً وفخاراً سادةٌ شُوسُ",87,"س",1,0],["زكيُّ حلمٍ حديدُ الفهمِ نبعَتُهُ","إِلى الهدى والأيادي أصلُهُ الزاكي",88,"ك",2,0],["زَكا نسباً وآداباً فأضحى","بهنَّ الشمسَ في شرف يوازي",89,"ز",2,0],["زكت فكري فيها واينع هاجسي","فظلت على أهل القريض مقدما",90,"م",2,0],["زكت فطابت بغرس الدين نعمته","في منبت العزّ حيث المجد والحسبُ",91,"ب",1,0],["زكت فيه الشمايل الأريحيه","محبن للعفو والحلم فرده",92,"د",2,0],["زكا فرعه الموما إليه وأثمرت","رياض علاه بالمهابة والقدرِ",93,"ر",1,0],["زكا فرعاً فكان لخير أصلٍ","فأكرم بالأصول وبالفروع",94,"ع",1,0],["زكانك منكوس فخيرك مرجأ","إلى غير ميقات وشرّك ناجز",95,