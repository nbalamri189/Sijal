abi.ae/diwan/poem/36795","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131246",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199111","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101375","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119605","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90853","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90813","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90851","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90900","الوافر"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4495,"","https://poetry.dctabudhabi.ae/diwan/poem/138874",""],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[5047,"الذهب المعتق","https://www.poetsgate.com/ViewPoem.aspx?id=189925",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5632,"برآة طفل","https://www.poetsgate.com/ViewPoem.aspx?id=178124",""],[5742,"الحمراء تأريخ ونهضة","https://www.poetsgate.com/ViewPoem.aspx?id=206897",""],[5848,"كأنك مطر متعلق فالسما ماطاح","https://www.poetsgate.com/ViewPoem.aspx?id=48816",""],[5851,"ويهتفون بحياة الرداءة","https://www.poetsgate.com/ViewPoem.aspx?id=175276",""],[463,"أمنْ أسماءَ والمسرى بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60031&r=&rc=87",""],[5567,"جنة من هيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82095&r=&rc=136",""]],"verses":[["مِنَ الغُلبِ مِن عِضدانِ هامَةَ شُرِّبَت","لِسَقيٍ وَجَمَّت لِلنَواضِحِ بيرُها",0,"ر",3,0],["مِنَ الْغَرْبِ مَا نُكْسَى لِنَسْتُرَ عُرْيَنَا","وَمِنْهُ شَرَابٌ نَصْطَفِيهِ وَمَطْعَمُ",1,"م",1,0],["مِنَ الغُرِّ الكِرامِ بَني سِنانٍ","لَوَ أَنَّكَ تَستَضيءُ بِهِم أَضاؤوا",2,"ا",1,1],["من الغيد تحتفّ الظبا بحجابها","ولكنها كالبدرِ في الماءِ يظهر",3,"ر",1,0],["من الغيد يحمي لحظُ عينيه ثغرَه","ولم أرَ سيفاً وحده قد 