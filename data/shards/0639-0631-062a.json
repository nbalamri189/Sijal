{"poems":[[56,"يا جواد اللسان من غير فعل","https://www.aldiwan.net/poem27459.html","الخفيف"],[91,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[99,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[108,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[113,"ألا فانصحا من رام حمدان شاعرا","https://www.aldiwan.net/poem16304.html","الطويل"],[147,"محل لهم بين النقا والأجارع","https://www.aldiwan.net/poem11772.html","الطويل"],[168,"عصى عاذليه واعترته لجاجة","https://www.aldiwan.net/poem67860.html","الطويل"],[202,"أشاقك إذ غنى الحمام المطوق","https://www.aldiwan.net/poem51916.html","الطويل"],[303,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[374,"أرى المرء يهوى أن تطول حياته","https://www.aldiwan.net/poem4288.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138435",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112469","الوافر"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/105359","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56262","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50010","الطويل"],[1767,"","https://poetry.dctabudhabi.ae/diwan/poem/146212","الطويل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138748",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89989","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66170","الطويل"],[4785,"الفتنة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=129733",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""]],"verses":[["عُرتَ عَيناً فَدَع لِمَهرانَ عَيناً","لا تَدَعهُ يَطوفُ في العُميانِ",0,"ن",1,0],["عرت نكبات الدهر بغدادَ بعدما","بها رَدَحاً ألقى السلام المراسيا",1,"ي",2,0],["عَرَّت لِياجَ عَنِ الحُصونِ وَجَرَّدَت","نامورَ عَن فولاذِها المَشكوكِ",2,"ك",1,0],["عرته الرجفةُ الكبرى وراحت","جيوشُ الصبرِ تنهزمُ انهزاما",3,"م",2,0],["عرت البلاد زلازلٌ فتقوَّضت","فيها بهنَّ منازلٌ وَمَغاني",4,"ن",2,0],["عرَتْهُ -على غرةٍ- سكتةٌ","فلا قلبَ إلا عليه انفطر",5,"ر",1,0],["عرتكم لأخذ الحق لله غيرة","فآضت بفتح والثواب المغانم",6,"م",1,0],["عَرَتِ الخطوبُ وكيف لاتعرو","فصَبَرتَ أنتَ ودِرعُكَ الصبرُ",7,"ر",1,1],["عَرتِ الخطوب فما خَفَضْتَ لها","من جانحٍ وكذلك النَسْر",7,"ر",1,0],["عرت الخطوب وكيف لا تعرو","وطريقُ مثلِكَ ، صامداً ، وعَر",7,"ر",1,0],["عَرَتها لِفَقد الأَهل دَهشة غُربة","فَقامَت عَلى الأَقدام تَرجف كَالسَعدي",8,"د",2,0],["عَرَتني صُروفُ النائِباتِ فَقَصَّرَت","ذِراعي وَرَدَّت خائِباتٍ ذَرائِعي",9,"ع",2,0],["عَرَتهُ خُطوبٌ شَرَّدَت نَومَ عَينِهِ","وَلَيسَ لِعَينِ المُستَهامِ هُجوعُ",10,"ع",1,0],["عرتني فألحاظُ الجفونِ جآذرٌ","تُطاعِنُ قلبي والجوانحُ مأزِقُ",11,"ق",1,0],["عرتني لِما شاهدتُ واللهِ دهشةٌ","جهلتُ يميني عندها من شماليا",12,"ي",2,0],["عرت خلالكَ عَن عارٍ فَأَلبَسَها ال","باري حُلى الأَشرَفين الحلم وَالأَدَبِ",13,"ب",1,0],["عرتنيَ أعراض شديد مراسها","عليّ وهمٌ ليس فيه إفراق",14,"ق",1,0],["عرتني خطوب والهموم تراكمت","علىّ وكان الحزن اثقل من رضوى",15,"و",2,0],["عرتك الحادثات فضقت ذرعا","وأجريت العيون دما ودمعا",16,"ع",2,1],["عرت عن جلابيب الفضول فاقبلت","مجردة عنه وفي فضلها تكسى",17,"س",2,0],["عرتها ضربة الملعون يوماً","فما عطست وما أبدت رموشَهْ",18,"ش",2,0],["عرتنا ملمّات الفراق فابعدت","ذوات الثنايا الغُر والحدقِ النُّجلِ",19,"ل",1,0],["عَرَتني هُمومٌ برَّحت وشواغل","وأصبح دهري وهو بي متشاغِلُ",20,"ل",1,1],["عرته من الخمر الشبابي نشوة","فراح مدى الأيام لا يعرف الصحوا",21,"و",2,0],["عرتني في مستودع الحسن حيرة","أَفي الخدام في القد روحي اودعُ",22,"ع",1,0],["عرتني من بنات النار حمّى","تلازم في النهار وفي الظلامِ",23,"م",1,0],["عرتني من وَشكش الفِراق صبابَةً","عَدمِت اصطباري عندها وتجلَّدي",24,"د",2,0],["عَرَتْنيَ منها رِقَّةُ الشَّوْقِ والهَوَى","فَبِتُّ عَلَى نارِ الجَوَى مُتَقَلِّبا",25,"ب",2,0],["عرتني خشيةٌ لله لما","رأيت الشمس تأذن بالشروق",26,"ق",1,1],["عرتهم منك والأبصار خاشعةٌ","مهابةٌ بجلال الموت تقترن",27,"ن",1,0]]}