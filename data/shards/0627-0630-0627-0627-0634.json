ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[458,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[458,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[461,"إذا اشتملت على شمس وبدر دجى","https://www.aldiwan.net/poem16103.html","البسيط"],[461,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[468,"خمر بدار الفناء","https://www.aldiwan.net/poem60493.html","المجتث"],[513,"إذا اشتد ما ألقاه هون علتي","https://www.aldiwan.net/poem67704.html","الطويل"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[562,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"]],"verses":[["إِذا اِشتَمَلوا عَلى الأَعداءِ عادوا","وَقَد غَمَروا الضَغائِنِ بِالحُلومِ",0,"م",1,0],["إِذا أَشاحَ بِنَصلٍ في أَنامِلِهِ","قامَت تُعانِقُهُ الهاماتُ وَالقَصَرُ",1,"ر",1,0],["إِذا اِشتَجَرَ القَنا فَصَلَ الهَوادي","وَإِن قَرَّ الوَغى فَصَلَ الخِطابا",2,"ب",2,0],["إِذا أَشِرَ القَريبُ عَلَيكَ فَاِقطَع","بِحَدِّ السَيفِ قُربى الأَقرِباءِ",3,"ا",2,0],["إذا اشتَبَهَتْ آيُ الخلائِفِ في النّدى","فآيُ نَداكَ المُحْكَماتُ الفَواتِحُ",4,"ح",1,0],["إِذَا أَشْرَقَتْ يَوْمَ النَّوَالِ وُجُوهُهُمْ","رَأيْتَ بُدُوراً في خِلاَلِ السَّحَائِبِ",5,"ب",1,0],["إِذا اِشتَمَلَ اللَيلُ البَهيمُ عَلى الوَرى","تَجَرَّدَ لِلإيذاءِ حَيثُ يُثارُ",6,"ر",1,0],["إِذا أَشكَلَ الخَطبُ المُلِمُّ فَإِنَّهُ","وَآراءَهُ كَالخَطِّ يوضَحُ بِالشَكلِ",7,"ل",1,0],["إِذَا اشْتَدَّ غَلْيٌ فِي إِنَاءٍ فَمَا الَّذِي","يُعَابُ عَلَيْهِ إِنْ وَهَى وَتَحَطَّمَا",8,"م",2,0],["إِذا اِشتَهى الضَيفُ طَبيخَ الشِتا","أَتاهُ بِالشَهوَةِ في الصَيفِ",9,"ف",1,0],["إذا اشتاق هزّ الريح خافق بنده","وإن حَنَّ غنَّتْه الجياد الصواهلُ",10,"ل",1,0],["إذا اشتكيا إليَّ رأيت حقاً","لمحرومين شفهما السغوبُ",11,"ب",1,0],["إذا أشرقت في محفلٍ ظنَّ أهله","سنا المشترى من ضوئها متقمّطا",12,"ط",2,0],["إذا اشتركَ الورَّادُ في الشِّرب أخلصتْ","له النفسُ وُدّاً غيرَ مشتركِ الشِّربِ",13,"ب",1,0],["إذا اشترى الحمدَ أفناءُ الملوك رأى","بين التجارةِ والأفضالِ فُرقانا",14,"ن",2,0],["إِذا أَشكو إِلى خِدنٍ هُمومي","وَفي وُسعي السُكوتُ ظُلِمتُ خِدني",15,"ي",1,0],["إذا أَشْرَفَتْ مِنّا الهُومُ طَوالِعاً","تَنَادَيْنَ مِنْ صَدْرِ الفَتَى بِرَحِيلِ",16,"ل",1,0],["إِذا اِشتَبَهَت دُموعٌ في خُدودٍ","تَبَيَّنَ مَن بَكى مِمَّن تَباكى",17,"ك",2,0],["إِذا اِشتَهى الكَلبُ أَن يُقَذِّرَنا","لَوَّثَنا في غِناءِ جارِيَتِه",18,"ت",2,0],["إِذا اشتَرَكا في سَوءَةٍ يَركَبانِها","تَبَدّى عُبَيدُ اللَهِ مِن دونِ أَحمَدِ",19,"د",1,0],["إِذا إِشرَأَبّوا لَهُ فَمُلتَمِسٌ","بِكَفِّهِ أَو مُقَبِّلٌ بِفَمِه",20,"م",2,0],["إِذا أَشرَفَ البُرجُ المُطِلُّ رَمَينَهُ","بِأَبصارِ خوصٍ قَد أَرَثَّت قُطوعُها",21,"ع",3,0],["إذا اشتهرَتْ بالحُسْنِ أخلاقُ صاحبٍ","فليسَ لخلوقٍ جَفاهُ خَلاقِ",22,"ق",1,0],["إِذا اِشتَمَلَت عَلى اليَأسِ القُلوبُ","وَضاقَ لِما بِهِ الصَدرُ الرَحيبُ",23,"ب",1,1],["إِذا اِشتَدَّ دوني حِجابُ اِمرأً","كَفَيتُ المَؤونَةَ حُجّابَهُ",24,"ه",1,1],["إِذا اِشتَدَّ ما بي كانَ أَفضَلُ حيلَتي","لَهُ وَضعَ كَفّي فَوقَ خَدّي وَأَسكُتُ",25,"ت",1,0],["إذا أُشْرِعَتْ للطّعْنِ سَرتْ كأنَّما","يُشَكُّ بها في كلّ سابقةٍ نَحْرُ",26,"ر",1,0],["إِذا اِشتَعَلَت في الطاسِ وَالكاسِ نارُها","صَليتُ بِها مِن راحَتَي ناعِمٍ لَدنِ",27,"ن",1,0],["إِذا اِشتَكَيتَ رَأَيتَ الدينَ مُشتَكِياً","وَالبَأسَ وَالجودَ وَالدُنيا وَما فيها",28,"ي",3,0],["إذا أشْأمَتْ كانَتْ لُبانَةَ مُعْرِقٍ","وإن أعْرَقَتْ كانَتْ لُبانَةَ مُشئم",29,"م",1,0],["إِذا اشتَغَبَ الناسُ البُيوتَ فَإِنَّهُم","أُلو اللَهُ وَالبَيتِ العَتيقِ المُحَرَّمِ",30,"م",1,0],["إِذا أُشرِعَت فيكَ الأَسِنَّةُ رَدَّها","لِصَونِكَ تَجفافٌ عَنِ الطَعنِ مُبهَمُ",31,"م",1,0],["إذا اشتاقَتِ الخيلُ المَناهلَ أعرَضَتْ","عنِ الماء فاشتاقتْ إليها المناهل",32,"ل",1,0],["إِذا أَشرَعوها لِلطِعانِ حَسِبتَها","كَواكِبَ تُهديها بُدورُ تَمامِ",33,"م",1,0],["إِذَا اشْتَجَرَتْ فِيهِ الرِّماحُ تَراجَعَتْ","سَوَافِرَ عَنْ نَصْرٍ يُضِيءُ عَمُودُهُ",34,"د",2,0],["إِذَا اشْتَدَّ أَوْرَى زَنْدَةَ الْحَرْبِ لَفْظُهُ","وَإِنْ رَقَّ أَزْرَى بِالْعُقُودِ فَرِيدُهُ",34,"د",2,0],["إِذَا اشْتَبَكُوا أَوْ رَاجَعُوا الزَّحْفَ خِلْتَهُمْ","بُحُوراً تَوَالَى بَيْنَها الْجَزْرُ والْمَدُّ",35,"د",1,0],["إِذَا أَشَرْتُ لَهُمْ فِي حاجَةٍ بَدَرُوا","قَضَاءَهَا قَبْلَ أَنْ يَرْتَدَّ إِلْمَاعِي",36,"ي",1,0],["إِذا اشْتدَّ كَرْبٌ بِالْحَزِينِ فنَثْرُهُ","دُمُوعٌ وَتَقْطِيعُ الأعَارِيضِ أَنْفَاسُ",37,"س",1,0],["إذا اشتبهت غُصُونُ الروضِ شَكْلاً","فليس لقدِّه في الحسنِ شكلُ",38,"ل",1,0],["إذا أشْرَقَتْ يومَ النّوالِ وجوهُهُم","رأيت البدُورَ في خِلال السَّحائب",39,"ب",1,0],["إذا اشتبهت آيى الخلائف في الندى","فأي نداك المحكمات الفواتح",40,"ح",1,0],["إذا اشتملتْ على اليأس القلوبُ","وَضَاْقَ بِمَا بِهِ الصَّدْرُ الرَّحِيْبُ",41,"ب",1,1],["إذا اشتهيتُ فزادي غيرُ مُحْتَمَلٍ","وان ظَمِئْتُ فوِرْدي غيرُ مشروب",42,"ب",1,0],["إذا اشتركا في سوءة يركبانها","تبدا عبيد الله من دون أحمد",43,"د",1,0],["إذا اشتهى اقتات شلوا من تذكره","وامتصّ ما خطّ في رمل الهوى ومحا",44,"ح",2,0],["إذا اشتكت الأرضُ داءَ المحو","لِ داوَى رُباها بإخصابها",45,"ب",3,0],["إِذا اشْتَدَّ حَرُّ اشْتِياقِ القُلوبِ","أَقَالَتْ بِها أَنْفُسَ العَاشِقِينا",46,"ن",2,0],["إِذا اشْتَدَّ ما أَلْقى جَلَسْتُ إِزاءهُ","وَنارُ الهَوى قَدْ أُضْرِمَتْ بَيْنَ أَوْصالي",47,"ي",1,1],["إِذا أَشْرَقَتْ كانَتْ شموسَ مشارِقٍ","وَإِنْ غَرَبتْ كانتْ بدورَ مَغارِبِ",48,"ب",1,0],["إذا اشتقنا إليه وقد تولى","وجدنا ماءه خلفا كريما",49,"م",2,0],["إذا اشتدّ إظلام العقوق تبلجت","مآثر تذكى نار معروفكم عندي",50,"د",2,0],["إِذا أُشكِلَت عقدةٌ في البِلادِ","خفّوا لحلِّ ذهِ العِقدَه",51,"د",2,0],["إذا اشتعلتْ نارُها في الكؤو","سِ أَلْهَبْتُ بالمزجِ إشعالَها",52,"ل",3,0],["إذا أَشكلت مظلِماتُ الأمو","رِ أَوضح بالرُشْدِ إِشكالها",52,"ل",3,0],["إذا أشاب الصبحُ رأْسَ الدُّجى","وهزّنا الساقي أجَبْناه",53,"ن",3,0],["إِذا اِشتَكى الناسُ جَدبَ عامِهِمُ","أَشكاهُمُ سَيلُ جودِهِ العَرِمُ",54,"م",1,0],["إذَا اشْتَدَّ غَيْظُ الْقَيْظِ بَيْنَ أَكَامِهَا","نُنَادِي أَبَا يَعْزَى فَيَعْرُوهُ إِسْهَالُ",55,"ل",1,0],["اذا اِشتَقتُه عَلّلتُ بالبَدرُ ناظِري","وَقابَلتُ عُلويَ الرياحِ مُقبّلا",56,"ل",2,0],["إِذا اِشتَغَلَت شوسُ المُلوكِ بِلَهوِها","فَلَيسَ لَهُ إِلّا المَكارِمَ أَشغالُ",57,"ل",1,0],["إِذا أَشرَقَت لِلأَشرَفِ القَيلِ رايَةٌ","تَنَكَّسَتِ الصُلبانُ بِالكَسرِ تَنكيسا",58,"س",2,0],["إِذا اِشتَدَّ الزَمانُ أَكَبَّ لَغباً","فَلا قَرحاً يُدِرُّ وَلا لَبونا",59,"ن",2,0],["إذا أشار براي في المهم فهل","رأيت كيف وقوعُ السهم في الهدف",60,"ف",1,0],["إذَا اشتَكَت مِن كَلاَلِ البَينِ أوعَدَهَا","رُوحُ القُدُومِ فَتَحيَا عِندَ مِيعَادِي",61,"ي",1,0],["إذا اشتهت شهوة يعودها","بخوف معبودها فسلاها",62,"ا",3,0],["إذا اشتَروا سُرورَهم","بمالِهم تَسمَّحوا",63,"ح",3,0],["إِذا اِشتَقتَ يَوماً دارَهُم وَرَأَيتَني","فَإِنَّكَ مِنها بِاللَحاظِ تَجولُ",64,"ل",1,0],["إِذا أَشرَقَت شَمسُ الصَباحِ وَأَشرَقَت","تَعارَضَتا نوراً فَشُكِّكتُ فيهِما",65,"م",2,0],["إِذا اِشتَجَرَت راياتُهُم وَتَأَلَّفَت","طُيورٌ إِلَيهِم قُلتَ حَنَّت إِلى وَكرِ",66,"ر",1,0],["إذا اشتغل الحسّاد عنا بدائهم","فنحن لنفع الحاسدين نَجول",67,"ل",1,0],["إِذا اِشتَدَّ ما بي قلت قَولَ مُتَيَّمِ","لِيَوم النَوى في القَلبِ منه كلومُ",68,"م",1,1],["إِذا أَشْرَقَتْ آراؤُهُ في مُلِمَّةٍ","تَبَسَّمَ بَعْدَ البِشْرِ في وَجْهِهَا الجَهْمِ",69,"م",1,0],["إذا اشتدّ الهجانُ الى محلّ","تقاصرَ دون مرْماهُ الهَجينُ",70,"ن",1,0],["إذا اشتدّ ما بي كان أفضلُ حيلتي","لهُم وضعَ كفّي تحت خدّي وأصْمُتُ",71,"ت",1,0],["إِذا أَشْرَعْتَها فِي إِثْرِ غاوٍ","فَقدْ ضاقَتْ بِهِ سُبُلُ النَّجاءِ",72,"ا",2,0],["إذا أشعل الأبطالُ في الحرب شوكةً","وَطَوها حفاةً أرجلاً ثمّ أسؤقا",73,"ق",2,0],["إذا اشتدَّ عاركتَ ليثاً غضوباً","فإن لان غازلتَ ظبياً ألوفا",74,"ف",2,0],["إذا اشتبهتْ كواكبهم طلوعاً","فنور الدولة القمرُ الوحيدُ",75,"د",1,0],["إذا اشتملتُ على شمسٍ وبدر دجىً","يُهْدى به الركب أنَّى وجهةً سلكوا",76,"ك",3,1],["إذا أشْرقَتْ في ليلِ حَظٍّ تَبَلَّجَتْ","نَواحيهِ حتى صُبْحُ نُعْماهُ ناصِعُ",77,"ع",1,0],["إِذا اِشتَهَيتَ نَجاةً","فَاِتبَع جَليلَ الدُعاءِ",78,"ا",2,0],["إذا اشتد ما ألقاه هون علتي","رضاي بأن تحيا سليماً وأسقما",79,"م",2,1],["إذا اِشتدّ ضيقُ الأمر بانَ اِرتخاؤهُ","وهل تحدُثُ الصّهباءُ لولا المَعاصرُ",80,"ر",1,0],["إذا اشتعلت خرصاته في عجاجة","تمد مذاكيها على الجو عثيرا",81,"ر",2,0],["إذا اشتدَّ خَطبٌ أعجزَ الناسَ كشفُهُ","رماهُ به عن مثلِ قوسِ جُلاهِقِ",82,"ق",1,0]]}