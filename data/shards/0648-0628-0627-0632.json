{"poems":[[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"أليس أبوكم آدم إن عزيتم","https://www.aldiwan.net/poem23622.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[40,"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21195",""],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[482,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199619","المسحوب"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127304","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72969","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72465","الرجز"],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""]],"verses":[["وَبازِلٍ كَعَلاةِ القَينِ دَوسَرَةٍ","لَم يُجذِ مِرفَقُها في الدَفِّ مِن زَوَرِ",0,"ر",1,0],["وَبِأَزواجكَ اللَّواتي تَشَرَّفْ","ن بأنْ صانَهُنَّ منك بِناءُ",1,"ا",2,0],["وَبازٍ يُغادي الطَيرَ مُهتَضِماً لَها","فَهَل يَرتَجي النَصفَ الضَعيفُ إِذا بُزي",2,"ز",2,0],["وباز من صاد وسهم من رمى","من الهداة الراشدين الكرما",3,"م",2,0],["وبأَزْهِار الصَّباحِ وقَدْ","نَهَضَتْ مِنْ غَفْوَةِ الوَسَنِ",4,"ن",1,0],["وبازلٍ كعلاة ِ القينِ دوسرة","ٍ لَمْ يُجْذِ مِرْفَقُهَا في الدِّفْءِ مِنْ زَوَرِ",5,"ر",1,0],["وبازلٍ فيهمُ جُلالٍ","أنهضه بالعلا البُزُولُ",6,"ل",1,0],["وبا زمانَ تناجينا على أمَمٍ","تُراكَ بعدَ تمادي البينِ تَنْتَظِرُ",7,"ر",1,0],["وبازوركم في الباسم","يا خلاّن الزمان",8,"ن",1,0],["وَبَازَغَ مِنْهُ البَدْرُ بَدْراً عَلَيْهِ قَدْ","أَنَافَ فَلاَ بُعْداً لِيَوْمِ بُزَاغِ",9,"غ",1,0],["وبإزاء الشيخ اسماعيلا","اخوه احمدي غدا نزيلا",10,"ل",2,0],["وباز الأيادي في يمينك صائد","حمائم مدح سجعها راق فحواه",11,"ا",2,0],["وبازل الفكر أناخ كلكلا","بسوحها وعنه قد ألقى العتب",12,"ب",1,0],["وبازل الفكر أناخ ككلا","بسوحها وعنه قد ألقى القتب",13,"ب",1,0],["وبأزهر أباذ استبان رعيلهم","أولاه والخرى بحافلسان",14,"ن",1,0]]}