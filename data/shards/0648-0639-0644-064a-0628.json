,"(( لا حرزت راحه ولا مربح أحرزت ))","https://www.poetsgate.com/ViewPoem.aspx?id=26734",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5184,"لا يا كبير الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=186072",""],[5277,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=206322",""],[5338,"القلب شوقا للقاء طموح","https://www.poetsgate.com/ViewPoem.aspx?id=187677",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5409,"يا لها من فلتةٍ مبكيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155299",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5490,"قف بالمعرة","https://www.poetsgate.com/ViewPoem.aspx?id=176334",""],[5652,"مكاسر العنبر","https://www.poetsgate.com/ViewPoem.aspx?id=181102",""],[5926,"تراتيل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214036",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""],[6230,"مَلَكٌ تَوَاضَعَ ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67165&r=&rc=39",""]],"verses":[["وعلى بابك ألقي جَعبتي","كغريبٍ آبَ من وادي المحن",0,"ن",1,0],["وعلى بهاءِ الدين أثني بالذي","في الجامعِ المعمورِ قَدْ أولاني",1,"ن",2,0],["وَعَلى بَقايا دورِهِ وَطُلولِهِ","أَمسَت تُقامُ قُصورُهُ الشَمّاءُ",2,"ا",2,0],["وعليَّ بعدكِ يا نوار من الأسى","ضاق الفضاءُ وإنه لوسيع",3,"ع",1,0],["وَعَلَى بَهْجَةِ المَرَابِعِ فِي لُبْ","نَانَ أَرْسَى سَحَابَةً مِنْ حِدَادِ",4,"د",1,0],["وَعَلَى بُلْبُلِ الشَّآمِ سَلاَمٌ","طيَّبَتْهُ مِصْرٌ بِنَفْحِ الوُرُودِ",5,"د",1,0],["وعلى بريقِ الموتُ رُحْنَ سوافراً","بيضٌ كواعبُ ، يندفعنَ عصائبا",6,"ب",2,0],["وعلى بطور احمدي مد في","نهج السلوك مسالك الاسعاد",7,"د",1,0],["وعلى بنيه وصحبه والتابعي","ن ذوي الهدى ما حن ليلاً حادي",8,"د",2,0],["وعلى بنيه الطيبين وصحبه","وعلى الخصوص البضعة الزهراء",9,"ا",2,0],["وعلى بنيه كواكب السا","دات والصحب الأسود",10,"د",1,0],["وَعَلى بِلادِ الشامِ يَظهَرُ مُلكُهُ","فَيُذِلُّ قَهراً عُصبَةَ الصُلبانِ",11,"ن",1,0],["وَعَلِيُّ بنُ سُلَيمَا","نَ رَمَى كَلباً فَصَادَه",12,"د",2,0],["وعلى بقيَّةِ حمرةٍ في صفرةٍ","دمعٌ يسيل مُزَعفَراً ومُعَصفَرا",13,"ر",2,0],["وعلى بقايا العزّ في أطلالِها","دمعُ الحزينِ وعبرةُ المتبصِّر",14,"ر",1,0],["وعليٌّ بن نظامٍ الداعي له","بدوام دولته السَعيدِ قِرانُها",15,"ن",3,0],["وَعَلى بَزلَتي","سَيِّدي لا تَشنَعُ",16,"ع",1,0],["وَعلَى بَابِه المَراهِمُ لَمْ يُؤْ","ذَنْ لَها والحِجابُ ثَمَّ عَسِيرُ",17,"ر",1,0],["وَعَلِيٌّ بابُ جَنّاتِ العُلى","فَأتِ مِنهُ بِجَنِ داني جَنَّتَي",18,"ي",1,0],["وَعَلى باب عُلاهُم كَم تَلا","آية الفَتح لَنا مفتتحا",19,"ح",2,0],["وعليُّ بنُ مُلهمٍ حاز خيرَ ال","مجدِ عن سائر الأنام وشرَّه",20,"ر",2,0],["وَعلى بَني حسن فَهم","زَينُ المَدائِنِ وَالثُغور",21,"ر",1,0],["وعلى بقيّتنا طلاوةُ سؤددٍ","تُهدِي لعينك فائتاً من حاصلِ",22,"ل",1,0],["وعلى بنيك وصحبك الزهر الأولى","ما الطلُّ نمنم رشُّه الأزهارا",23,"ر",2,0],["وعلى برده لقد رشَّ من ن","فاحِ نشر القبول عرفاً شذيّا",24,"ي",2,0],["وعلى بُرْقُعِ الجَمالِ نُقوشٌ","كَتَبَتْ بالفُنونِ للقلبِ معْنَى",25,"ن",2,0],["وعلى بابِ مَنْ نُحِبُّ سُتورٌ","نسْجَها نحنُ إنْ أَرَدْنا كَشَفْنَا",25,"ن",2,0],["وعلى بطون الأرض ان تبقى لهم","أفلاذها وتدر ضرع المال",26,"ل",1,0],["وَعَلى بَني الأَوطان مدّ لِواءه","وَحَماهمُ مِن صَولة الأَشرار",27,"ر",1,0],["وَعَلى بساط العَدل قُلتَ مهدّداً","لِلبَغي كفَّ الجور عَن أَوطانيه",28,"ن",3,0],["وَعَلى بِساط الورد بين جَداول","تَحلو مَواردها جعلت مَقامي",29,"م",2,0],["وعليّ باب كل هدى","منك للأحباب قد وصلا",30,"ل",2,0],["وعلى بنيه الغر أعلام الهدى","ما انهل قطر من متون غمام",31,"م",1,0],["وعلى بالفتح الرفيع تفضلن","ذخري لكي أحظى بإحراز الوطر",32,"ر",1,0],["وعَلَى بِسَاطِ الآسِ قَدْ نَثَرَ النَّدَى","دُرَراً كَمَا نَثَرَتْ يَدٌ أَسْلاَكَا",33,"ك",2,0],["وَعَلَى بِلاَدِ العُرْبِ أَمْضَى حُكْمَهُ","فَالعَدْلُ فِيهَا قَائِمُ القِسْطَاسِ",34,"س",1,0],["وَعَلى بَنانِ مُديرِها عقيانُها","مِن سَكبِها وَعَلى فُضولِ المِعصَمِ",35,"م",1,0],["وعلى بلدة الجوادين عرِّج","بالقوافي مُهنّياً وبشيرا",36,"ر",2,0],["وَعلى بُرقِ الفَضلِ مِنكُم قَد سَرَى","عَبدٌ بِحُبِّكُمُو طَوَى الأَضلاَعَ طَى",37,"ا",1,0],["وعلى بانها الهزار تغنى","طرباً في محاسن النغمات",38,"ت",1,0],["وعلى بنيك الشم والاصحاب ما","طفيق امرؤ بك للمهيمن يرغَبُ",39,"ب",1,0],["وعلى بنيك وصحبك الأخيار ما","قامت بقدرة ربّها الأشياء",40,"ا",2,0],["وعلى بحور العلم غاضت في ثرى","كشاف غامضها إلى ان أغمضا",41,"ض",2,0],["وعلى برمانا سحابة نعمة","هطلت وسحت كالسحاب سجالا",42,"ل",2,0],["وعلى بَنِى الطُّروَادِ زَفسُ قَضَى","بالوَيلِ فاخبُر أمرَهُ خُبرا",43,"ر",2,0],["وعلى بساط البسط في حلل الرضى","نعمى وطائي والنعيم لحافي",44,"ف",2,0],["وعلى بلاط الرمس أرخاً دبَّجوا","أضحى الأمين لدى السلام أمينا",45,"ن",2,0],["وعلى بساط الأنس في حلل الرضا","وخطاب ذي العرش الإله الفاطر",46,"ر",1,0],["وعلى بني الآداب من","يبغي مداه يعد باغي",47,"غ",2,0],["وعلى بعض ذلك المدح كلُّ ال","مدح نزرٌ من الملا والثناء",48,"ا",2,0],["وعلى بَنِيهِ اليَومَ أَن يَتَقاتلوا","طَمَعًا بمن قَتَلوهُ في الأَرحام",49,"م",1,0],["وعلى بَنَيهِ اليَومَ أَن يَتَقاسَموا","باسمِ الوِفاقِ حَقائِبَ الأَيتامِ",49,"م",1,0],["وعلى بيانِ خِتامِهِ:","سنعودُ بعدَ دقائقِ",50,"ق",1,0],["وعلى بقايا الصّبرِ صارَ توكؤي","في كلُّ يومٍ تستجدُّ رياحُ",51,"ح",1,0],["وعلى بلدة المعز دموعٌ","خلّدت ذكرهُ بها الأهرامُ",52,"م",1,0],["وعلى بقايا أطلال لأفكار عنزت","راسي أبحيل الله رب ألبريه",53,"ي",2,0],["وعلى بني الديان عرج فاقتضى","دين الرفاهة من بني الديان",54,"ن",1,0],["وعلى بَنيكَ استأسَدَتْ كَفُّ الردى","ووجوهُ شِيبِكَ بالمهانة تُصفعُ",55,"ع",1,0],["وعلى بقايا الأمسِ يحيا يومَهُ","فيعيشُ مُضطرّاً.. ويقنعُ بالكفافْ",56,"ف",1,0],["وَعَلى بَنِيكَ الطَّاهِرينَ وَصَحْبِكَ الْ","أَخْيارِ مَنْ هُمْ لِلْفَخَارِ صُروحُ",57,"ح",1,0],["وَعَلَى بَنِيهِ الطَّاهِرينَ وَصَحْبِهِ","أَهْلَ النَّجَابَةِ وَالسَّبيلِ الأَنْهَجِ",58,"ج",1,0],["وعلى برق وعودٍ خلبٍ","سفكوا من دمهم ما سفكوا",59,"ك",3,0],["وعلى بياض الفجر نامتْ صَحوَةٌ","أيَنامُ في وَضَحِ الضحى مَغبونُ؟",60,"ن",1,0],["وعلى بساط الشوق رفرفَنا الجوى","والعشق رقرقَ دمعَنا غدرانا",61,"ن",2,0],["وعلى بساط حروف شعرآ بالوصايف عاليات","جيت اتباها بالقصيد الي ب صدري شايله",62,"ل",2,0],["وعلى بساط من حنين سار بي","وأعود تحرقني شرارات الجوى",63,"و",2,0],["وعليَّ بالدعوات أحفظ شمله","وأعزه ليعينه الديَّانُ",64,"ن",1,0],["وعلى بَنَفْسَجَتَيْنِ كانَتْ بَسمَتِي","تَمشِي ... فَتَحْضُنُها يَدُ الشُّهَداءِ",65,"ا",1,0],["وعلى بَيَاضِ الظَّهْرِ غَطَّى نُورُها","نُورَ البَياضِ بِوَهْجِهِ المُتَدَفِّقِ",66,"ق",1,0]]}