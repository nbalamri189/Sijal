{"poems":[[53,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[62,"أحلف بالله ما رمزت ولا","https://www.aldiwan.net/poem52149.html","المنسرح"],[28,"فسيري فأمي أرض قومك إنني","https://www.aldiwan.net/poem5344.html","الطويل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[28,"فسيري فأمي أرض قومك إنني","https://www.poetsgate.com/ViewPoem.aspx?id=22118",""]],"verses":[["أَو زَفرَةٍ تُحسَبُ الضُلوعُ لَها","أُطرَ قِسِيٍّ يَرمينَ بِاللَهَبِ",0,"ب",1,0],["أو زورَقٌ جاءَ في العيد منحدراً","حيث الدجى كعباب البحر مسجور",1,"ر",1,0],["أوزانها سرّها فإن علمت","فإنّ مثالها بقنطارِ",2,"ر",1,0],["إِوَزَّى بِها لا يَأطِرُ الحَملُ مَتنَهُ","وَيَعجِزُ عَن حَملِ العُلا لا يُطيقُها",3,"ق",3,0],["أو زاره طيفٌ خفيّ الهوَى","يَطْرُقُهُ في الوهم لا في المنام",4,"م",1,0],["أو زاره في الحشر آثَرَهُ","كَرَماً عَلَيهِ بِصالِحِ العَمَلِ",5,"ل",1,0],["أو زهرة حلَّت من ال","أكمام منعقد الإزار",6,"ر",1,0],["أَو زجرة كان فيها","للظالمين ارتداع",7,"ع",1,0],["أو زار طيف كُثَيِّرٍ","أو أحوصٌ ثانٍ ظهر؟",8,"ر",1,0],["إوَزَّى بها لا يَأطِرُ الحَمْلُ مَتْنَهُ،","ويَعْجِزُ عَنْ حَمْلِ العُلى لا يُطيقُها",9,"ق",3,0]]}