{"poems":[[55,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[74,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[64,"أحلف بالله ما رمزت ولا","https://www.aldiwan.net/poem52149.html","المنسرح"],[30,"فسيري فأمي أرض قومك إنني","https://www.aldiwan.net/poem5344.html","الطويل"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[82,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[108,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[30,"فسيري فأمي أرض قومك إنني","https://www.poetsgate.com/ViewPoem.aspx?id=22118",""],[121,"الشعر","https://www.aldiwan.net/poem24070.html","السريع"],[139,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[208,"قد كنت أطلب منك الوصل مقتصدا","https://www.aldiwan.net/poem53337.html","البسيط"],[214,"طراز ذاك العذار من رقمه","https://www.aldiwan.net/poem13371.html","المنسرح"],[234,"ويلي على من كل عين","https://www.aldiwan.net/poem50794.html","مجزوء الكامل"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[242,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[371,"أوزار حربي ألسن العذال","https://www.aldiwan.net/poem17067.html","الكامل"],[409,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[435,"تاالله يا ظبيات الروم إن لعبت","https://www.aldiwan.net/poem39853.html","البسيط"],[443,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[482,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[556,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126756","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48529","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70692","السريع"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59334","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59367","الكامل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178042","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72278","الكامل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198197",""],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117104","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79849","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100952","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106832","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107318","الرجز"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127394","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127378","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201775","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200564","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204912","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100870","الكامل"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34724","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130053","الكامل"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140161",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66428","المجتث"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92209","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216632",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114566","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114396","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86495","الخفيف"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78290","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94363","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72688","الكامل"],[4755,"عُقبَى الحائِرِين","https://www.poetsgate.com/ViewPoem.aspx?id=183683",""],[4764,"عروس الموت","https://www.poetsgate.com/ViewPoem.aspx?id=27726",""],[4869,"الحراميه","https://www.poetsgate.com/ViewPoem.aspx?id=151546",""],[4938,"قالت: حبست. فقلت: خطب أنكد","https://www.poetsgate.com/ViewPoem.aspx?id=186318",""],[5092,"مَسَاوات","https://www.poetsgate.com/ViewPoem.aspx?id=152405",""],[5102,"بنت السجان","https://www.poetsgate.com/ViewPoem.aspx?id=12893",""],[5150,"شكرا","https://www.poetsgate.com/ViewPoem.aspx?id=202785",""],[5246,"بين الربى وعلى ضفاف الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=187024",""],[5277,"نائح الكرْخ","https://www.poetsgate.com/ViewPoem.aspx?id=185544",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[592,"وإذا أردت ترى مصارع من ثوى","https://www.poetsgate.com/ViewPoem.aspx?id=128824",""],[5648,"حي الضمير ويجلد الذات كرباج","https://www.poetsgate.com/ViewPoem.aspx?id=157947",""],[5725,"قمر بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177977",""],[5736,"ألوان","https://www.poetsgate.com/ViewPoem.aspx?id=208200",""],[5804,"اغتنم الخير قبل أن ترحل","https://www.poetsgate.com/ViewPoem.aspx?id=214738",""],[5829,"حبات العيون","https://www.poetsgate.com/ViewPoem.aspx?id=211667",""],[5841,"قلي عَدَوك وغيروا من طباعك","https://www.poetsgate.com/ViewPoem.aspx?id=37036",""],[5897,"زارنا الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=160573",""],[6068,"إن كنت تدري -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175876",""],[6120,"أُوَزِّعُ الْحُزْنَ فِي يَوْمِي","https://www.poetsgate.com/ViewPoem.aspx?id=214994",""],[6174,"سفر في قصيدة حبّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86188&r=&rc=5",""]],"verses":[["أَو زَفرَةٍ تُحسَبُ الضُلوعُ لَها","أُطرَ قِسِيٍّ يَرمينَ بِاللَهَبِ",0,"ب",1,0],["أو زورَقٌ جاءَ في العيد منحدراً","حيث الدجى كعباب البحر مسجور",1,"ر",1,0],["أوزانها سرّها فإن علمت","فإنّ مثالها بقنطارِ",2,"ر",1,0],["إِوَزَّى بِها لا يَأطِرُ الحَملُ مَتنَهُ","وَيَعجِزُ عَن حَملِ العُلا لا يُطيقُها",3,"ق",3,0],["أو زاره طيفٌ خفيّ الهوَى","يَطْرُقُهُ في الوهم لا في المنام",4,"م",1,0],["أو زاره في الحشر آثَرَهُ","كَرَماً عَلَيهِ بِصالِحِ العَمَلِ",5,"ل",1,0],["أو زهرة حلَّت من ال","أكمام منعقد الإزار",6,"ر",1,0],["أَو زجرة كان فيها","للظالمين ارتداع",7,"ع",1,0],["أو زار طيف كُثَيِّرٍ","أو أحوصٌ ثانٍ ظهر؟",8,"ر",1,0],["إوَزَّى بها لا يَأطِرُ الحَمْلُ مَتْنَهُ،","ويَعْجِزُ عَنْ حَمْلِ العُلى لا يُطيقُها",9,"ق",3,0],["أوزانُ أشعاري تراتيلهُ","يَصنعُ تفعيلاتِها بَحْرُهُ",10,"ر",2,0],["أو زورة لشجٍ نأيتَ وقلبهُ","بسوى التهتكَ فيكَ لم يتلاهَى",11,"ا",3,0],["أو زد جفاك فمالي فيك من حيل","عما قليل ترى لي فيك معتقدا",12,"د",2,0],["او زارني طيفه فرشت له","خدي وقبلت لاثما قدمه",13,"م",2,0],["أو زارني لم أستطع","خوفاً عليه ألثمُه",14,"م",2,0],["أَوْ زَارَ أُفْقَ مَدِينَةٍ قَمَراً زَرَتْ","زَهْواً بِطَلْعَتِهِ عَلَى غُمْدَانِ",15,"ن",1,0],["أَوْ زَاهٍِد فِيمَا تَكََدَّرَ مُكْتَفٍ","بِالْقُوتِ مِنْ خَشْلِ الْفَلاَ أَوْ بَهْشِهِ",16,"ش",2,0],["أَوزارُ حَربي أَلسُنُ العُذّالِ","وَالقَطعُ عِندَ تَقاطُعِ الأَقوالِ",17,"ل",1,1],["أو زبدة من فنون العلم خالصة","عن التشكك والتخليط والوهم",18,"م",1,0],["أو زججت بين قوسي الحواجب أو","أضا على غررٍ صبحٌ ولاح مسا",19,"س",2,0],["أو زرته لسررت منه محصبا","وعممت بالمعروف منك معرّفا",20,"ف",2,0],["أو زقا الأمواتُ يستحيونها","نشرت بالحسن رِمّاتٍ وهاما",21,"م",2,0],["أُوزَّعُه يوماً على الهجرِ والنوى","ويوماً إذا ما اجتزتُ بالربعِ والمغنى",22,"ن",2,0],["أوْ زمَنٌ يموت من","حيث غشومٌ أَزْمِنَهْ",23,"ن",2,0],["أو زاد في الزكاة أو كان نقص","من فرضها الموجوب بعد أن خلص",24,"ص",1,0],["أوَزير يحيى أنت أكرم سيّد","أضحى لسيّدنا الحميد وزيرا",25,"ر",2,0],["أَو زرخٍ تهجمُ بِالخَيلِ","لِلكَبسة في جُنحِ الليلِ",26,"ل",1,0],["أوزارة الأحرار نرجو بعد ما","أبت الوفاق وزارة العمال",27,"ل",1,0],["أوزير مصر لك التحية والرضى","ولك الثناء مردداً ترديدا",28,"د",2,0],["أوزارة الوادي تؤول إليك أم","عبء عليك لأهله محمول",29,"ل",1,0],["أو زُمَّ وَخَّادةً تزينُ بها ال","إدلاج والهاجراتِ والطفَلا",30,"ل",2,0],["أوزرتنى ترى مكانا خالي","هيهات ان كنت ترى خيالي",31,"ي",1,0],["أوْ زَوْرَقًا فِي بَحْرِ تبرٍ عَائِمًا","أوْ مِنْجَلاً لحصاد هَامِ الغَيْهَبِ",32,"ب",1,0],["أوْ زَوْرَقاً من فِضَّةٍ فِي عَسْجَدٍ","أو جَدْوَلاً يَلْوِي بِرَوْضِ شَقِيقِ",33,"ق",1,0],["إوزة غيضةٍ لقحت كشافاً","لقحقحها إذا درجت نقيض",34,"ض",1,0],["أو زخرفت عدن لهم فلم","ن ترى تذكى السعير",35,"ر",1,0],["أو زُهورٍ في مُروجِ","أو ملوك في سروجِ",36,"ج",1,0],["أو زهورا ما بين تلك الزهور","أو بدورا توطنت أفلاكا",37,"ك",2,0],["أَو زوَّجوه فبأخت شرفٍ","يحكي طريفُ مجدِها تِلادَها",38,"د",3,0],["أوزيرَ مصر على كرامتها","عُد مُكرَماً أدَّيت ما وجبا",39,"ب",2,0],["أَوزارَةَ الإِصلاحِ تِلكَ ضَحِيَّةٌ","إِن تَشمَليها بِالعِنايَةِ تُؤجَري",40,"ر",2,0],["أو زردة والسَّمنُ فيها غارِقُ","ووافر والكلّ حُلْوٌ فائقُ",41,"ق",1,0],["أو زاخر هيّجت ريح الجنوب له","لُجّاً فلج بموج جامع أَرِن",42,"ن",1,0],["أو زهرةً حسناءَ باسمةً","تضعينها في مفرق الرأس",43,"س",1,0],["أو زَحنُ أو طُوفانُ أو أمطَار","فَذاكَ بالتَّدبِيرِ في الأسفَار",44,"ر",1,0],["أو زِدتُ في أثنائِها مسائلا","مُهِمَّةً عن ذكرِها قد غفلا",45,"ل",2,0],["أو زل شعورهم مثل البهائم لا يبغون","شيئا سوى ملء البطينات",46,"ت",1,0],["أو زمجر البحر والأمواج هائجة","أو أرسلت شهبها زرق السماوات",47,"ت",1,0],["او زورقٍ يخبط في لُجَّةٍ","لا الجزر يُنجيه ولا المدُّ",48,"د",1,0],["أوزع إحساساً لمن فقدوا الحسّا","وأرسل أنواراً لمن أظلموا نفسا",49,"س",2,1],["أو زلزلاتٍ أو صواعق أو لظىً","للحرب أو نوعٍ من الاعصار",50,"ر",1,0],["أو زهرة فيحاء خيف ذبولُها","وضياع نفحتها إذا لم تستر",51,"ر",1,0],["أَوَزيرٌ أَم قائِدٌ بَل بَعيدٌ","أَنتِ مِن ذَينِ مَوضِعَ الفَرقَدَينِ",52,"ن",1,0],["أو زال إسماعيل عن أَرجائها","فلسوف يأتي بعد ذاك ويسلمُ",53,"م",1,0],["أو زماني قد جاد لي بالأماني","وجلاها بكرا عروبا عروسا",54,"س",2,0],["أَو زَفَرات يسن زافِرها","قصد ضُلوع فشا تقصّدها",55,"د",3,0],["أَوزارةَ الشَعبِ اِستَهل","لي إنَّ شعبك يَستهلُّ",56,"ل",1,0],["أَوزان قَولي وَمَعناه قَد اِئتَلفا","كَما تَأَلَفت الأَرواح في القدم",57,"م",1,0],["أو زهر روض مجودٍ","أو عرف مسكٍ مذاعِ",58,"ع",1,0],["أو زهر روض كان غضّاً يانعاً","فغدا غثاء يابس الأفنان",59,"ن",1,0],["أو زودن عينيك وانظر باهتاً","وأطل فما أنا واثق برجوع",60,"ع",1,0],["أو زفرة من فؤاد صب","يعارض السجع بالأنين",61,"ن",1,0],["أو زُهُورٌ لا بل تَدَلَّت لأن تخدمَهُ","وقفت تُرَجِّي رِضاهُ",62,"ا",2,0],["أو زفها لي زفيفَ عرسٍ","لأعزبٍ عارِفٍ بقيمَه",63,"م",2,0],["أو زهر الربى كزهر معان","وشع الدهر حسنها توشيعا",64,"ع",2,0],["اِو زادَ جِسمي اِعتِلالا بِالخَفيفِ فَلى","روح لَدَيهِم وَشكل حاضِر وَخَفى",65,"ف",2,0],["أو زار قَلباً كسيراً عاد ذا طربٍ","لم يعرف البؤسَ مخدوماً من السَعدِ",66,"د",1,0],["أو زعزعت اركانكنَّ بكفها","أيدي الحوادث أو تغير حال",67,"ل",1,0],["أَو \"زَاهِدٌ\" تَرَكَ الرِّيَالَ مَخَافَةً","لِيَبيعَ بالدُّولارِ أَو باليُورُو",68,"ر",2,0],["اوزن حروفي والأمل يِثقل الكفه","واخفي دموعي عنه / والفرح ماليني",69,"ن",2,0],["اُوزن على شمسك الفيّه","واعطف على جآرك وجآري",70,"ر",2,0],["أو زارني فيه المحب فموجع","يذري الدموع بزفرة تتردد",71,"د",1,0],["أوزِّعُها بقايا الفرحِ لحناً","ويبقى الحزنُ دوماً من نصيبي",72,"ب",2,0],["أو زوّد وِدّو بالقيفان","يغازلها.. صار فْْمِحنا",73,"ن",2,0],["أو زاهدٍ هابَ من كشفِ الغطاءِ لهُ",