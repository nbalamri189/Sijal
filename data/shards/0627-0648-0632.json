{"poems":[[53,"لم يبق عندي من الإباء سوى","https://www.aldiwan.net/poem30700.html","المنسرح"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[62,"أحلف بالله ما رمزت ولا","https://www.aldiwan.net/poem52149.html","المنسرح"],[28,"فسيري فأمي أرض قومك إنني","https://www.aldiwan.net/poem5344.html","الطويل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[28,"فسيري فأمي أرض قومك إنني","https://www.poetsgate.com/ViewPoem.aspx?id=22118",""],[118,"الشعر","https://www.aldiwan.net/poem24070.html","السريع"],[136,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[205,"قد كنت أطلب منك الوصل مقتصدا","https://www.aldiwan.net/poem53337.html","البسيط"],[211,"طراز ذاك العذار من رقمه","https://www.aldiwan.net/poem13371.html","المنسرح"],[230,"ويلي على من كل عين","https://www.aldiwan.net/poem50794.html","مجزوء الكامل"],[238,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[238,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[367,"أوزار حربي ألسن العذال","https://www.aldiwan.net/poem17067.html","الكامل"],[404,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[430,"تاالله يا ظبيات الروم إن لعبت","https://www.aldiwan.net/poem39853.html","البسيط"],[438,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[478,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[552,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَو زَفرَةٍ تُحسَبُ الضُلوعُ لَها","أُطرَ قِسِيٍّ يَرمينَ بِاللَهَبِ",0,"ب",1,0],["أو زورَقٌ جاءَ في العيد منحدراً","حيث الدجى كعباب البحر مسجور",1,"ر",1,0],["أوزانها سرّها فإن علمت","فإنّ مثالها بقنطارِ",2,"ر",1,0],["إِوَزَّى بِها لا يَأطِرُ الحَملُ مَتنَهُ","وَيَعجِزُ عَن حَملِ العُلا لا يُطيقُها",3,"ق",3,0],["أو زاره طيفٌ خفيّ الهوَى","يَطْرُقُهُ في الوهم لا في المنام",4,"م",1,0],["أو زاره في الحشر آثَرَهُ","كَرَماً عَلَيهِ بِصالِحِ العَمَلِ",5,"ل",1,0],["أو زهرة حلَّت من ال","أكمام منعقد الإزار",6,"ر",1,0],["أَو زجرة كان فيها","للظالمين ارتداع",7,"ع",1,0],["أو زار طيف كُثَيِّرٍ","أو أحوصٌ ثانٍ ظهر؟",8,"ر",1,0],["إوَزَّى بها لا يَأطِرُ الحَمْلُ مَتْنَهُ،","ويَعْجِزُ عَنْ حَمْلِ العُلى لا يُطيقُها",9,"ق",3,0],["أوزانُ أشعاري تراتيلهُ","يَصنعُ تفعيلاتِها بَحْرُهُ",10,"ر",2,0],["أو زورة لشجٍ نأيتَ وقلبهُ","بسوى التهتكَ فيكَ لم يتلاهَى",11,"ا",3,0],["أو زد جفاك فمالي فيك من حيل","عما قليل ترى لي فيك معتقدا",12,"د",2,0],["او زارني طيفه فرشت له","خدي وقبلت لاثما قدمه",13,"م",2,0],["أو زارني لم أستطع","خوفاً عليه ألثمُه",14,"م",2,0],["أَوْ زَارَ أُفْقَ مَدِينَةٍ قَمَراً زَرَتْ","زَهْواً بِطَلْعَتِهِ عَلَى غُمْدَانِ",15,"ن",1,0],["أَوْ زَاهٍِد فِيمَا تَكََدَّرَ مُكْتَفٍ","بِالْقُوتِ مِنْ خَشْلِ الْفَلاَ أَوْ بَهْشِهِ",16,"ش",2,0],["أَوزارُ حَربي أَلسُنُ العُذّالِ","وَالقَطعُ عِندَ تَقاطُعِ الأَقوالِ",17,"ل",1,1],["أو زبدة من فنون العلم خالصة","عن التشكك والتخليط والوهم",18,"م",1,0],["أو زججت بين قوسي الحواجب أو","أضا على غررٍ صبحٌ ولاح مسا",19,"س",2,0],["أو زرته لسررت منه محصبا","وعممت بالمعروف منك معرّفا",20,"ف",2,0],["أو زقا الأمواتُ يستحيونها","نشرت بالحسن رِمّاتٍ وهاما",21,"م",2,0],["أُوزَّعُه يوماً على الهجرِ والنوى","ويوماً إذا ما اجتزتُ بالربعِ والمغنى",22,"ن",2,0],["أوْ زمَنٌ يموت من","حيث غشومٌ أَزْمِنَهْ",23,"ن",2,0],["أو زاد في الزكاة أو كان نقص","من فرضها الموجوب بعد أن خلص",24,"ص",1,0]]}