e/diwan/poem/136441",""],[4691,"أهيف مريضة نبأ صحيحُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=59635",""],[4691,"إذا مر شعري عليك تذكر","https://www.poetsgate.com/ViewPoem.aspx?id=61413",""],[4709,"عاشق في زمن العهر","https://www.poetsgate.com/ViewPoem.aspx?id=214836",""],[4816,"اغتراب","https://www.poetsgate.com/ViewPoem.aspx?id=8464",""],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[5055,"نوفه","https://www.poetsgate.com/ViewPoem.aspx?id=102731",""],[5150,"بوحي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=202786",""],[5185,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5268,"سُوار","https://www.poetsgate.com/ViewPoem.aspx?id=207001",""],[5376,"أتى طيفُكِ الساني على حين غِرَّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197291",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5411,"عَلَى دَقَّةِ الأَحْلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=185916",""],[5430,"هموم","https://www.poetsgate.com/ViewPoem.aspx?id=1445",""],[5493,". في حب الشاعرة خديجة ماء العينين .","https://www.poetsgate.com/ViewPoem.aspx?id=197412",""],[5510,"هو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206113",""],[5544,"فحَلّق بِها يا هَيثَم المجد عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=213408",""],[5582,"لِمَنْ تِلْكَ الهَوادِجُ وَالحُدُوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=186779",""],[5616,"الناس","https://www.poetsgate.com/ViewPoem.aspx?id=203231",""],[5691,"ديار أهلها رحلوا...!","https://www.poetsgate.com/ViewPoem.aspx?id=206526",""],[5790,"إليكم بكم في حبكم أتوسل","https://www.poetsgate.com/ViewPoem.aspx?id=112105",""],[5926,"رنين الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213933",""],[5943,"هوِّنْ عليك فإنَّ العمرَ محدودُ","https://www.poetsgate.com/ViewPoem.aspx?id=60866",""],[5957,"أحبكَ أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=11393",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6097,"بانت سُعادُ","https://www.poetsgate.com/ViewPoem.aspx?id=190698",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[463,"أغشُّ بآمالي كأنيَ أنصحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60003&r=&rc=59",""]],"verses":[["إِذا مَرَقَ الدُجى مِنّا أَخَذنا","عَليها بِالمَذانِبِ وَالتَلاعِ",0,"ع",1,0],["إِذا مَرَئيَّةٌ وَلَدَت غُلاما","فَأَلأَمُ مُرضَعٍ نُشِغَ المَحارا",1,"ر",2,0],["إِذا مَرِئياتٌ حَلَلنَ ببِلَدَة","مِنَ الأَرضِ لَم يَصلُح طَهوراً صَعيدُها",2,"د",3,0],["إِذا مَرَئيُّ باعَ بِالكَسرِ بِنتَهُ","فَما رَبِحَت كَفُّ اِمرِئ يَستَفيدُها",2,"د",3,0],["إِذا مَرَّ الحَجيجُ عَلى قُنَيعٍ","دَبَبتَ اللَيلَ تَستَرِقُ العِيابا",3,"ب",2,0],["إِذا مَرَرتَ بِوادٍ جاشَ غارِبُهُ","فَاِعقِل قُلوصُكَ وَاِنزِل ذاكَ وادينا",4,"ن",2,1],["إِذا مَرَّ قَرنٌ كَفى نَسلُهُ","وَخَلَّفَ قَرناً إِذا ما اِنقَصَم",5,"م",1,0],["إِذا مَرَّت بِهِ الأَجيالُ تَترى","سَمِعتَ لَها أَزيزاً وَاِبتِهالا",6,"ل",2,0],["إِذا مَرَّ نَحوَ المَرءِ كانَ حَياتَهُ","كَإِصبَعِ عيسى نَحوَ مَيتٍ يُخاطِبُه",7,"ب",2,0],["إِذا مَرَرنا عَلى الأَصَمِّ بِها","أَغنَتهُ عَن مِسمَعَيهِ عَيناهُ",8,"ا",2,0],["إِذا مَرِضتْ فيها الأصائلُ أسبلتْ","عليها السواري بالدموعِ السواجمِ",9,"م",1,0],["إِذا مرِضَتْ فيها الأصائِلُ عادَها","على شُعَبِ الأغصانِ نوحُ الحمائمِ",10,"م",1,0],["إِذا مَرَّ بِالشَجراءِ جانَبَ قَصدَها","يَرى أَنَّها أَرسالُ خَيلٍ تُقاتِلُه",11,"ل",2,0],["إذا مرَقَتْ من الظَّلماءِ أذكَتْ","على المُرَّاقِ ثائرةَ العَذابِ",12,"ب",1,0],["إِذا مَرِضَ القَلبُ كَيفَ الشِّفا","وَفيهِ هَوى الغرَّةِ المُبرِيَه",13,"ه",1,0],["إذا مَرَّ في أَرْضٍ بِجَيْشٍ عَرَمْرَم","تكادُ لهُ أُمُّ النُّجُومِ تَمُورُ",14,"ر",1,0],["إِذا مَرَتِ الرِياحُ يَمينَ رَوحٍ","جَرَت ذَهَباً وَطابَ لَها الجِلادُ",15,"د",1,0],["إِذا مَرَّتِ الأَوقاتُ حُرِّكَ ساكِنٌ","وَسُكِّنَ في أَضعافِها المُتَحَرِّكُ",16,"ك",1,0],["إِذا مَرَّ أَعمى فَاِرحَموهُ وَأَيقِنوا","وَإِن لَم تُكَفَّوا أَنَّ كُلَّكُم أَعمى",17,"م",2,1],["إِذا مَرِضَت قُلوبُهُمُ خَفاهُم","نِطاسِيٌّ بِدائِهِم طَبيبُ",18,"ب",1,0],["إذَا مرَّ قِرْنٌ كفى نَسْلُهُ","وأورَثَه بَعْدَهُ آخَرِينَا",19,"ن",2,0],["إذا مرّ وجه عابر رحت أجتلي","أساريره بشر عليهنّ أم رعب",20,"ب",1,0],["إذا مرّ يوماً ولم أتذكر","به أن أقول صباحك سكر",21,"ر",1,1],["إذا مَرِضتْ قُلوبُهُمُ شَفاهُمْ","نطاسيٌّ بدائهمْ طبيبُ",22,"ب",1,0],["اذا مر يوما في المجالس ذكره","فقد رش فيها عطر ورد الخمائل",23,"ل",1,0],["إذا (مَرَّاكشُ) الحَمراءُ تاهَتْ","وفاخَرَتِ السّماواتِ العَلِيَّةْ",24,"ي",2,0],["إذا مرّ ذكراها تذكّرت جيرتي","وإخوان ودّ في جميع المواضع",25,"ع",1,0],["إذا مر بي يوم حميد وربما","تبسم في الليل النجوم الزواهر",26,"ر",1,0],["إِذامَرَتهُ ريحٌ يَمانِيَّةٌ","يَرُدُّ رَيعانَهُ إِلى نَضَدِ",27,"د",1,0],["إذا مَراثى أحبابكم تُليتْ","سمعتموها كأنها غَزلُ",28,"ل",1,0],["إذا مَرِضتْ حالٌ بفقرٍ يَميثُها","فأنت لها مما اشْتكتْه مَسيح",29,"ح",1,0],["إذا مرضت فعوّادي ميازقةٌ","أولاد ساسان أهل الضر والعجف",30,"ف",1,0],["إِذا مرّ المكرّرُ من سواهُ","فِبالتكرارِ قَد يَحلو ويَحلى",31,"ل",2,0],["إذا مرضنا تداوينا بذكركمُ","ونترك الذكرَ أحياناً فننتكسُ",32,"س",1,1],["إذا مرّ من فرط المهابة وحدَه","تراه كجيشٍ مرّ في كثرة العدّ",33,"د",1,0],["إذا مَرَرتَ بها ألقِ السَّلامَ وقُل","لكِ السَّلامةُ فاسلم أيُّها القَدَح",34,"ح",1,0],["إذا مَرّتِ الراياتُ حَيّوا جلالها","وقد خفقت في جيشك الحَسَن الشّكل",35,"ل",1,0],["إذا مَرَست في السّلمِ تَطربُ للضّرى","وتَشتاقُ مَجداً أنتَجتهُ الملاحم",36,"م",1,0],["إذا مر في الروض خرت له","غصون الأراك وبان اللوى",37,"و",2,0],["إذا مَرّ في الهمّ الشبابُ على الفتَى","فإنّ سوادَ الشَّعْرِ منه خِضاب",38,"ب",1,0],["إذا مر في فكري الديار وأهلها","فيالي من وجد يجدده الذكر",39,"ر",1,0],["إِذا مرَّ ذِكراكُم بقلبي تَضَايَقتْ","ضُلوعِيَ عَمَّا تَحتَهُنَّ من الوَجْدِ",40,"د",1,1],["إذا مرَّتْ على أرضٍ فَرَتْها","مرور العاصفات على هشيم",41,"م",1,0],["إذا مررنا على الأهمّ بها","أغنَتْهُ عن مِسمعَيْه عيناهُ",42,"ه",1,0],["إذا مر لي يوم الخميس وليله","تمرر شربي وهو عذب مبرد",43,"د",1,0],["إذا مربيت الشعر يحمل حكمة","تبناه ذو فهم فثنى وعقبا",44,"ب",2,0],["إذا مررتَ بالقبابِ من قُبا","مرفوعةً وقد هوت شمسُ الأُصُلْ",45,"ل",1,0],["إذا مرَّ يتقري مَن الهالكُ الردَى","يميِّلُ في أبنائه ويرجِّحُ",46,"ح",1,0],["إذا مرَّ بالوِعساءِ وهو مزمجرٌ","تَدهدى له كثبانُها ورمالُها",47,"ل",3,0],["إذا مَرِضَ اليمينُ أبو عليٍّ","رعاهُ اللهُ فالمجدُ المَريضُ",48,"ض",1,1],["اذا مِرجَمُ العلياءِ حاول شوطهُ","غدا وهو موهونٌ من البُهر ظالعُ",49,"ع",1,0],["اذا مَرَّتْ على ليلٍ بهيمٍ","تَجَلَّلهُ التَّبَلُّجُ والضِّياءُ",50,"ا",2,0],["إذا مرتَ الحربُ قطر السهام","تقلد فوق غديرٍ نهر",51,"ر",1,0],["إِذا مَرَّ قَصدُ المَرءِ يَسحَبُ ذَيلَهُ","إِلى جودِهِ المَوجودِ قامَ بِحَقِّهِ",52,"ق",2,0],["اِذا مرَّ يومٌ لا أراكِ فاِنَّهُ","هو الموتُ أو أسبابُهُ أو دلائلُهْ",53,"ل",2,0],["إذا مرّ في الأوهام معنى وِصالِها","رأيتُ جِيادَ الموتِ تعثُر بالفِكْرِ",54,"ر",1,0],["إذا مرّ ذكرُ الخَيفِ لو لم يكن به","ولاءُ عليٍّ كادَ بالنّارِ يُضرَمُ",55,"م",1,0],["إذا مرَّ ذكرُ الفاخرينَ فذِكْرُه","كفاتحةِ القرآنِ في أوّل الذِّكْرِ",56,"ر",1,0],["إذا مرضنا وتخطتكم","عوائق الأيام فهو الغرض",57,"ض",1,0],["إذا مرح الملوك غداة فخر","وجدناكم لجامحها لجاما",58,"م",2,0],["إذا مَرَّتْ قَوافينا بِهَضبٍ","أرانا من عَظائِمِهِ جِبالا",59,"ل",2,0],["إذ أمر الله على ما أنبا","بدفعه حقوق أهل القربى",60,"ب",2,0],["إذا مَرَّتْ عَلى أُذُنَيْ فَصيحٍ","سِوَاكَ يَعِضُّ إِصْبَعَه طَوِيلا",61,"ل",2,0],["إِذا مَرَّ رَكبٌ بهَا أَعرَضُوا","أَلا ربَّما يَمَّمُوها رِجالا",62,"ل",2,0],["إذا مَرته فاحَ من ريحِه","أزكى من المِسك إذا يَسطَعُ",63,"ع",1,0],["إذا مر يوماً الأصم يخاله","يحييه أو عن بعض شيءٍ يسائله",64,"ل",2,0],["إذا مرَّ لم يدخُل مَمرّاً كأنّما","سَقَوهُ مُداماً بالكبير المفدَّمِ",65,"م",1,0],["إذا مَرْجُنا مرجت رَوضُهُ","فما مرجُ راهط ما راهط",66,"ط",1,0],["إِذا مَرَّ البعادُ على خَيالي","لَزِمتُ الماءَ شُرباً وَاِنغِماسا",67,"س",2,0],["إِذا مَرَّ بِالأَغصانِ في الرّوضِ ذاكِراً","لَها ميسَ قدِّ الحِبِّ تَرقص بِالذّكرِ",68,"ر",1,0],["إِذ أَمره فَرضٌ عَليّ حَتم","وَفي اِمتِثالِه هدي وَغنمُ",69,"م",1,0],["إذا مر ركبٌ مصعدين فليتني","مع الرائحين المصعدين لهم عبدا",70,"د",2,0],["إذا مَرِضْتُ فَمِنْ قلبٍ يُعَذِّبُني","وإن بَكَيْتُ فمن نَجْوَى أُعانِيها",71,"ي",3,0],["إذا مر في واد العفاة سحابه","سقاها من التبر المذاب فأحياها",72,"ا",3,0],["إذا مر في وهم امرئ لثم خدها","بدى خفر في خدها منه فاحمرا",73,"ر",2,0],["إذا مرضنا أتيناكُم نعودُكُمُ","وتُذنبونَ فنأتيكم ونعتذرُ",74,"ر",1,0],["إِذا مَرِضَ القاضي مَرِضنا بِأَسرِنا","وَإِن صَحَّ لَم يسمَع لَنا بِمَريضِ",75,"ض",1,1],["إِذا مَرَقوا مِن بَطنِ لَيلٍ رَقَت بِهِم","إِلى ظهرِ يَومٍ عَزمَةٌ هِيَ ما هِيا",76,"ي",2,0],["إذا مَرَقتْ بين الودائقِ والدُّجى","فلا حِجْلَ إلا ما تثير السّنابك",77,"ك",1,0],["إِذا مَرَّ يَومٌ لا أَراكَ مُمَثّلاً","بِهِ كانَ مَحسُوباً بِحَولٍ مُحَرَّمِ",78,"م",1,0],["إذا مرت على العشاق يوما","تراهم هائمين بكل واد",79,"د",1,0],["إذا مر بالأوهام معنى وصالها","يمرُّ مرورَ المستحيل من الأمر",80,"ر",1,0],["إِذا مَرِضَت كَفٌّ وَخيفَ أَذاتُها","فَلَيسَ لَها في الطِبِّ خَيرٌ مِنَ البَترِ",81,"ر",1,0],["إذا مررت على نخل الحفيف فقل:","اسلم سلمت حريم الحائم الصادي",82,"د",2,0],["إذا مر حين زاده الشوق جدة","وليس يعاب للربوع حنين",83,"ن",1,0],["اذا مر قلت نسيم الصباح","ذلاذله تحمل العنبرا",84,"ر",2,0],["إذا مر نعش قيل نعش مسافع","ألا لا بودي لو بنى لي لاحد",85,"د",1,0],["إِذا مِرّيخُها زادَ اِحمِراراً","صَبَبنا المُشتَري فيها مِزاجا",86,"ج",2,0],["إذا مررتكم مررتببيتها","تبكى الخطى منى وترتعد الدموع",87,"ع",1,0],["اذا مرَّ في رأسي تجرعه فمي","شجاً في اللها مثل السمام المثمل",88,"ل",1,0],["إذا مر لي ذكر العذيب وبانه","تذكرت في أيام قربكم وردى",89,"د",2,0],["إذا مرضوا يوماً عدوني بدائهم","وما لي إن صحّوا بصحتهم سهم",90,"م",1,0],["إذا مرضوا يوماً عدوني بسقمهم","وما ليَ إن صحّوا بصحتهم سهم",91,"م",1,0],["إذا مرضنا وآدتنا مواجعنا","كانت منياتنا فيك الأطباء",92,"ا",2,0],["اذا مَرَّتْ سنابكُها بقاعٍ","خلعن عليه أرديةَ العَجَاجِ",93,"ج",1,0],["إذا مرضنا أتيناكم نزوركُم","وتُذنبون فنأتيكُم فنعتذِرُ",94,"ر",1,0],["إذا مر النسيم على رباها","يسلي فوجهُ القلب الكئيبا",95,"ب",2,0],["إِذا مَرِضَت نَفسي فَأَنتُم أُساتها","وَإِن ظَمئت يَوماً فَأَنتُم فُراتُها",96,"ت",3,1],["إذا مرَّ ذكرٌ منك يوماً على فمي","توهَّمتهُ مسكاً سرى في خياشمي",97,"م",2,0],["إذا مرضنا نوينا كلَّ صالحةٍ","وإن شفين