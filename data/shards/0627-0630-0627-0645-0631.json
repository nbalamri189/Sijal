{"poems":[[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[30,"ألا لا أرى كالدار بالزرق موقفا","https://www.aldiwan.net/poem29595.html","الطويل"],[27,"أخالد عاد وعدكم خلابا","https://www.aldiwan.net/poem5685.html","الوافر"],[47,"إذا مررت بواد جاش غاربه","https://www.aldiwan.net/poem25129.html","البسيط"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[85,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[43,"الناس ما لم يروك أشباه","https://www.aldiwan.net/poem10599.html","المنسرح"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[45,"لقد وفق الله الموفق للذي","https://www.aldiwan.net/poem65562.html","الطويل"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[81,"دع العتب رأسا فأنت الرئيس","https://www.aldiwan.net/poem61294.html","المتقارب"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[50,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[46,"عليك بتقوى الله في كل حالة","https://www.aldiwan.net/poem23067.html","الطويل"],[46,"إذا مر أعمى فارحموه وأيقنوا","https://www.aldiwan.net/poem23336.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1613","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67349","المتقارب"],[94,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[99,"صباح السكر","https://www.poetsgate.com/ViewPoem.aspx?id=577",""],[27,"أقادكَ بالمقادِ هوى عجيبٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16348&r=&rc=12",""],[115,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[117,"مراكش (عندا علي)(1)","https://www.aldiwan.net/poem24035.html","الوافر"],[118,"جرى ذكر هجرٍ في خروق المسامع","https://www.aldiwan.net/poem495.html",""],[120,"أجل في حياتي الطرف تبصر رسومها","https://www.aldiwan.net/poem49284.html","الطويل"],[127,"أوحشت النخل من معاقل فالرو","https://www.aldiwan.net/poem24262.html","المنسرح"],[142,"لا مرية في الردى ولا جدل","https://www.aldiwan.net/poem58417.html","المنسرح"],[185,"عليك ثناء العالمين فصيح","https://www.aldiwan.net/poem14142.html","الطويل"],[186,"يا رب عفوك عن شيخ وذي حنف","https://www.aldiwan.net/poem43615.html","البسيط"],[189,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[259,"إذا مرضنا تداوينا بذكركم","https://www.aldiwan.net/poem35557.html","البسيط"],[259,"على ساكني القلمون مني تحية","https://www.aldiwan.net/poem35770.html","الطويل"],[270,"جاء الندامى وحل الأنس والفرح","https://www.aldiwan.net/poem35293.html","البسيط"],[270,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[270,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[303,"أيا من تقصر أوصافنا","https://www.aldiwan.net/poem57734.html","المتقارب"],[364,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[409,"ديار الهوى حيا معالمك ولإن","https://www.aldiwan.net/poem31699.html","عموديه"],[409,"إذا مر ذكراكم بقلبي تضايقت","https://www.aldiwan.net/poem32493.html","الطويل"],[416,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[432,"تنشر أثوابنا مدائحه","https://www.aldiwan.net/poem12439.html","المنسرح"],[441,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[449,"سلام على الماضي","https://www.aldiwan.net/poem1000.html",""],[458,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[458,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[461,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[461,"إذا مرض اليمين أبو علي","https://www.aldiwan.net/poem15171.html","الوافر"],[461,"يود المسف الجون تحمله الصبا","https://www.aldiwan.net/poem15374.html","الطويل"],[461,"لفخر الدين أخلاق كرام","https://www.aldiwan.net/poem15920.html","الوافر"],[464,"وهيفاء تقتل عشاقها","https://www.aldiwan.net/poem3318.html","عموديه"],[468,"بنفسي أخ لي خلقه مثل خلقه","https://www.aldiwan.net/poem59795.html","الطويل"],[477,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[515,"يا مالك الرق ومن حقه","https://www.aldiwan.net/poem12168.html","السريع"],[515,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[562,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"]],"verses":[["إِذا مَرَقَ الدُجى مِنّا أَخَذنا","عَليها بِالمَذانِبِ وَالتَلاعِ",0,"ع",1,0],["إِذا مَرَئيَّةٌ وَلَدَت غُلاما","فَأَلأَمُ مُرضَعٍ نُشِغَ المَحارا",1,"ر",2,0],["إِذا مَرِئياتٌ حَلَلنَ ببِلَدَة","مِنَ الأَرضِ لَم يَصلُح طَهوراً صَعيدُها",2,"د",3,0],["إِذا مَرَئيُّ باعَ بِالكَسرِ بِنتَهُ","فَما رَبِحَت كَفُّ اِمرِئ يَستَفيدُها",2,"د",3,0],["إِذا مَرَّ الحَجيجُ عَلى قُنَيعٍ","دَبَبتَ اللَيلَ تَستَرِقُ العِيابا",3,"ب",2,0],["إِذا مَرَرتَ بِوادٍ جاشَ غارِبُهُ","فَاِعقِل قُلوصُكَ وَاِنزِل ذاكَ وادينا",4,"ن",2,1],["إِذا مَرَّ قَرنٌ كَفى نَسلُهُ","وَخَلَّفَ قَرناً إِذا ما اِنقَصَم",5,"م",1,0],["إِذا مَرَّت بِهِ الأَجيالُ تَترى","سَمِعتَ لَها أَزيزاً وَاِبتِهالا",6,"ل",2,0],["إِذا مَرَّ نَحوَ المَرءِ كانَ حَياتَهُ","كَإِصبَعِ عيسى نَحوَ مَيتٍ يُخاطِبُه",7,"ب",2,0],["إِذا مَرَرنا عَلى الأَصَمِّ بِها","أَغنَتهُ عَن مِسمَعَيهِ عَيناهُ",8,"ا",2,0],["إِذا مَرِضتْ فيها الأصائلُ أسبلتْ","عليها السواري بالدموعِ السواجمِ",9,"م",1,0],["إِذا مرِضَتْ فيها الأصائِلُ عادَها","على شُعَبِ الأغصانِ نوحُ الحمائمِ",10,"م",1,0],["إِذا مَرَّ بِالشَجراءِ جانَبَ قَصدَها","يَرى أَنَّها أَرسالُ خَيلٍ تُقاتِلُه",11,"ل",2,0],["إذا مرَقَتْ من الظَّلماءِ أذكَتْ","على المُرَّاقِ ثائرةَ العَذابِ",12,"ب",1,0],["إِذا مَرِضَ القَلبُ كَيفَ الشِّفا","وَفيهِ هَوى الغرَّةِ المُبرِيَه",13,"ه",1,0],["إذا مَرَّ في أَرْضٍ بِجَيْشٍ عَرَمْرَم","تكادُ لهُ أُمُّ النُّجُومِ تَمُورُ",14,"ر",1,0],["إِذا مَرَتِ الرِياحُ يَمينَ رَوحٍ","جَرَت ذَهَباً وَطابَ لَها الجِلادُ",15,"د",1,0],["إِذا مَرَّتِ الأَوقاتُ حُرِّكَ ساكِنٌ","وَسُكِّنَ في أَضعافِها المُتَحَرِّكُ",16,"ك",1,0],["إِذا مَرَّ أَعمى فَاِرحَموهُ وَأَيقِنوا","وَإِن لَم تُكَفَّوا أَنَّ كُلَّكُم أَعمى",17,"م",2,1],["إِذا مَرِضَت قُلوبُهُمُ خَفاهُم","نِطاسِيٌّ بِدائِهِم طَبيبُ",18,"ب",1,0],["إذَا مرَّ قِرْنٌ كفى نَسْلُهُ","وأورَثَه بَعْدَهُ آخَرِينَا",19,"ن",2,0],["إذا مرّ وجه عابر رحت أجتلي","أساريره بشر عليهنّ أم رعب",20,"ب",1,0],["إذا مرّ يوماً ولم أتذكر","به أن أقول صباحك سكر",21,"ر",1,1],["إذا مَرِضتْ قُلوبُهُمُ شَفاهُمْ","نطاسيٌّ بدائهمْ طبيبُ",22,"ب",1,0],["اذا مر يوما في المجالس ذكره","فقد رش فيها عطر ورد الخمائل",23,"ل",1,0],["إذا (مَرَّاكشُ) الحَمراءُ تاهَتْ","وفاخَرَتِ السّماواتِ العَلِيَّةْ",24,"ي",2,0],["إذا مرّ ذكراها تذكّرت جيرتي","وإخوان ودّ في جميع المواضع",25,"ع",1,0],["إذا مر بي يوم حميد وربما","تبسم في الليل النجوم الزواهر",26,"ر",1,0],["إِذامَرَتهُ ريحٌ يَمانِيَّةٌ","يَرُدُّ رَيعانَهُ إِلى نَضَدِ",27,"د",1,0],["إذا مَراثى أحبابكم تُليتْ","سمعتموها كأنها غَزلُ",28,"ل",1,0],["إذا مَرِضتْ حالٌ بفقرٍ يَميثُها","فأنت لها مما اشْتكتْه مَسيح",29,"ح",1,0],["إذا مرضت فعوّادي ميازقةٌ","أولاد ساسان أهل الضر والعجف",30,"ف",1,0],["إِذا مرّ المكرّرُ من سواهُ","فِبالتكرارِ قَد يَحلو ويَحلى",31,"ل",2,0],["إذا مرضنا تداوينا بذكركمُ","ونترك الذكرَ أحياناً فننتكسُ",32,"س",1,1],["إذا مرّ من فرط المهابة وحدَه","تراه كجيشٍ مرّ في كثرة العدّ",33,"د",1,0],["إذا مَرَرتَ بها ألقِ السَّلامَ وقُل","لكِ السَّلامةُ فاسلم أيُّها القَدَح",34,"ح",1,0],["إذا مَرّتِ الراياتُ حَيّوا جلالها","وقد خفقت في جيشك الحَسَن الشّكل",35,"ل",1,0],["إذا مَرَست في السّلمِ تَطربُ للضّرى","وتَشتاقُ مَجداً أنتَجتهُ الملاحم",36,"م",1,0],["إذا مر في الروض خرت له","غصون الأراك وبان اللوى",37,"و",2,0],["إذا مَرّ في الهمّ الشبابُ على الفتَى","فإنّ سوادَ الشَّعْرِ منه خِضاب",38,"ب",1,0],["إذا مر في فكري الديار وأهلها","فيالي من وجد يجدده الذكر",39,"ر",1,0],["إِذا مرَّ ذِكراكُم بقلبي تَضَايَقتْ","ضُلوعِيَ عَمَّا تَحتَهُنَّ من الوَجْدِ",40,"د",1,1],["إذا مرَّتْ على أرضٍ فَرَتْها","مرور العاصفات على هشيم",41,"م",1,0],["إذا مررنا على الأهمّ بها","أغنَتْهُ عن مِسمعَيْه عيناهُ",42,"ه",1,0],["إذا مر لي يوم الخميس وليله","تمرر شربي وهو عذب مبرد",43,"د",1,0],["إذا مربيت الشعر يحمل حكمة","تبناه ذو فهم فثنى وعقبا",44,"ب",2,0],["إذا مررتَ بالقبابِ من قُبا","مرفوعةً وقد هوت شمسُ الأُصُلْ",45,"ل",1,0],["إذا مرَّ يتقري مَن الهالكُ الردَى","يميِّلُ في أبنائه ويرجِّحُ",46,"ح",1,0],["إذا مرَّ بالوِعساءِ وهو مزمجرٌ","تَدهدى له كثبانُها ورمالُها",47,"ل",3,0],["إذا مَرِضَ اليمينُ أبو عليٍّ","رعاهُ اللهُ فالمجدُ المَريضُ",48,"ض",1,1],["اذا مِرجَمُ العلياءِ حاول شوطهُ","غدا وهو موهونٌ من البُهر ظالعُ",49,"ع",1,0],["اذا مَرَّتْ على ليلٍ بهيمٍ","تَجَلَّلهُ التَّبَلُّجُ والضِّياءُ",50,"ا",2,0],["إذا مرتَ الحربُ قطر السهام","تقلد فوق غديرٍ نهر",51,"ر",1,0],["إِذا مَرَّ قَصدُ المَرءِ يَسحَبُ ذَيلَهُ","إِلى جودِهِ المَوجودِ قامَ بِحَقِّهِ",52,"ق",2,0],["اِذا مرَّ يومٌ لا أراكِ فاِنَّهُ","هو الموتُ أو أسبابُهُ أو دلائلُهْ",53,"ل",2,0],["إذا مرّ في الأوهام معنى وِصالِها","رأيتُ جِيادَ الموتِ تعثُر بالفِكْرِ",54,"ر",1,0],["إذا مرّ ذكرُ الخَيفِ لو لم يكن به","ولاءُ عليٍّ كادَ بالنّارِ يُضرَمُ",55,"م",1,0],["إذا مرَّ ذكرُ الفاخرينَ فذِكْرُه","كفاتحةِ القرآنِ في أوّل الذِّكْرِ",56,"ر",1,0],["إذا مرضنا وتخطتكم","عوائق الأيام فهو الغرض",57,"ض",1,0],["إذا مرح الملوك غداة فخر","وجدناكم لجامحها لجاما",58,"م",2,0],["إذا مَرَّتْ قَوافينا بِهَضبٍ","أرانا من عَظائِمِهِ جِبالا",59,"ل",2,0],["إذ أمر الله على ما أنبا","بدفعه حقوق أهل القربى",60,"ب",2,0],["إذا مَرَّتْ عَلى أُذُنَيْ فَصيحٍ","سِوَاكَ يَعِضُّ إِصْبَعَه طَوِيلا",61,"ل",2,0]]}