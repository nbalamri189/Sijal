{"poems":[[88,"سعيت إلى أن كدت أنتعل الدما","https://www.aldiwan.net/poem10509.html","الطويل"],[94,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[46,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[50,"قل للعروضي عبد","https://www.aldiwan.net/poem66566.html","المجتث"],[109,"ياسمينُ التي من حَلبْ","https://www.poetsgate.com/ViewPoem.aspx?id=208770",""],[88,"سَعَيْتُ إلى أنْ كِدْتُ أَنْتَعِلُ الدَّما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13101&r=&rc=56",""],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34418","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59784","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31629","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128718","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111829","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101031","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100959","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101064","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118348","الخفيف"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100460","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62795","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91549","الوافر"],[4519,"","https://poetry.dctabudhabi.ae/diwan/poem/198925","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139591",""],[5129,"إلى أمي ... عيونك إرهاص لقافيتي","https://www.poetsgate.com/ViewPoem.aspx?id=120506",""]],"verses":[["وَيا يَدُ ما كَلَّفتُكِ البَسطَ مَرَّةً","لِذي مِنَّةٍ أَولى الجَميلَ وَأَنعَما",0,"م",2,0],["ويائِسٍ ماتَ في","لُبِّهِ المَرامُ الوَحيدُ",1,"د",1,0],["وَيَا يَدَاً حَوْلَنَا دَارَتْ تُعَوِّذُنَا","مِنْ بَطْنِ يَثْرِبَ حَتَّى الأَبْعَدِينَ مَدَى",2,"د",2,0],["وَيا يَومَ الثُلاثاءِ اِعتُمِدنا","بِفَقدٍ فيكَ لِلسَنَدِ العَميدِ",3,"د",1,0],["ويا يزيدُ بحقّ الحورا","ءِ زين القيانِ",4,"ن",1,0],["ويا ياسمينُ خُلقتُ خجولا","سوى فِ فِتنتين، الهوى والغضب..",5,"ب",1,0],["ويأيُّهَا النَّجمُ الذي طالَ سُهدُه","وقد أَخَذَتْ منه السُّرَى أين يَمَّما",6,"م",2,0],["وَيا يَدي وَهيَ اليمنى وَيا بصري","لا بَل هوَ النور يَهديني ويرشدني",7,"ن",2,0],["ويأيها الظبيُّ الذي بان وهو في","فؤادي بحكم الشوق يرعى ويرتع",8,"ع",1,0],["ويأَيُّها المُسْتامُ حَرْبي بِجَهْلِهِ","وذو الجَهْلِ يَغْلو ساعَةً ثُمَّ يَنْدَمُ",9,"م",1,0],["ويا يلت من قد مزق القلب هجره","تدارك ما قد فات بالوصل أو رفا",10,"ف",2,0],["ويا يوم وافوا لاجبين كأنما","قد انحلَّ نطقُ البحر والبحر زاخرُ",11,"ر",1,0],["ويأيها النائي تقبل نفوسنا","تحيتنا يوم الوداع وأجمل",12,"ل",1,0],["ويأيها الباكي وقد ظن أنه","أسال عيوناً أو أذاب قلوبا",13,"ب",2,0],["ويأيها البحران كيف افترقتما","وقد مرج البحرين يلتقيان",14,"ن",1,0],["ويا يدم لمن هويت ديار","اصبحت ما ترى بها ديارا",15,"ر",2,0],["ويا يومه قد رزأت النبي","رميت الوصي شجيت البتولا",16,"ل",2,0],["ويا يومَه عَزَّ الأنام بفقدِه","فأنتَ بمولاهُم تُعزّى المَواليا",17,"ي",2,0],["وَيا يأساً لذي أَملٍ وَحُزناً","وَخسراناً لِمَن يَرجو ضَنينا",18,"ن",2,0],["ويا يومَه ما كان أقطعَ هولَهُ","تشيبُ لمرآهُ المروّعِ وُلْدانُ",19,"ن",1,0],["ويا يوم فلوا في بروت وادبروا","شماطيط فلا عز عن كل منوال",20,"ل",1,0],["ويا يمَّ جودٍ ساغ للناس وردُه","فجود يديه للأنام مباحُ",21,"ح",1,0],["ويَا يَديْكِ الَّتي غَنَّتْ قَصَائِدَهَا","لَحْناً عَلىْ شَعْرِيَ الْمَشْغُوفِ بالنَّغَمِ",22,"م",1,0]]}