s://www.aldiwan.net/poem54160.html","الوافر"],[432,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[432,"كم نابل في طرفيك البابلي","https://www.aldiwan.net/poem12697.html","السريع"],[439,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[439,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[439,"بفتح الفتوح وسعد السعود","https://www.aldiwan.net/poem34864.html","المتقارب"],[439,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[441,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[453,"يا شعب لا تعبد الأصنام إذ نطقت","https://www.aldiwan.net/poem61594.html","الكامل"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[458,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[464,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[500,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[500,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[515,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[522,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[529,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[551,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[567,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[567,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[575,"أيا شمسي منك أشرق بهجة","https://www.aldiwan.net/poem2994.html","الطويل"]],"verses":[["وكَمْ حَياةٍ جَنَتْها النّفْسُ منْ تَلَفٍ","ورُبَّ أمْنٍ حَواهُ القَلْبُ منْ وجَلِ",0,"ل",1,0],["وكمْ حيلةٍ أضْمَرْتَ في غسَقِ الدُجى","زجَرْتَ لَها داعي الغَرامِ فما ارْعَوَى",1,"و",2,0],["وكمْ حِكْمَةٍ أبْدى وكمْ ظُلْمَةٍ جَلا","بنُورِ هُدىً منْ رأيِهِ ورَشادِ",2,"د",1,0],["وَكَم حُبوسٍ عَلى المَوتى وَغُلَّتُها","يَشري الجُباةُ بِهِ خوصاً وَرَيحانا",3,"ن",2,0],["وَكَم حاوَلوا في الأَرضِ إِطفاءَ نورِهِ","وَإِطفاءُ نورِ الشَمسِ مِن ذاكَ أَقرَبُ",4,"ب",1,0],["وَكَم حَرَّكَ العُجبُ مِن حائِنٍ","فَغادَرتُهُ ما بِهِ مِن حَبَض",5,"ض",1,0],["وكم حفلٍ يهيأ لي","وذلك محض أفضال",6,"ل",1,0],["وَكَم حَنَشٍ ذَعفِ اللُعابِ كَأَنَّهُ","عَلى الشَرَكِ العادِيِّ نِضوُ عِصامِ",7,"م",1,0],["وكم حلَّةٍ جلَّلْتَه بحُليِّها","من الوشي تُنْسي السابرِيَّ اليمانيا",8,"ي",2,0],["وكم حبّرت أقلامه من صحائف","بجيد العلا من درّهن قلائد",9,"د",1,0],["وَكَم حِصنِ جَبّارٍ هُمامٍ وَسوقَةٍ","إِذا ما أَتى أَبوابَهُ لَم تُغَلَّقِ",10,"ق",1,0],["وَكَم حافِرٍ حُفرَةً لِاِمرِئٍ","سَيَصرَعُهُ البَغيُ فيما اِحتَفَر",11,"ر",1,1],["وكم حاجبٍ غضبانَ كاسرِ حاجبٍ","محا الله ما فيه من الكسر بالكسرِ",12,"ر",1,1],["وكم حمَّلونا نعمةً بعد نعمةٍ","على أننا منها خِفافُ الكواهلِ",13,"ل",1,0],["وكم حاجةٍ مقرونةٍ بخيانةٍ","أباها وإن سيءَ امرؤٌ متذللُ",14,"ل",1,0],["وكم حاجةٍ مستحسنٍ حملُ ثقلها","تحمّلَ منها فوق ما يُتحمّلُ",14,"ل",1,0],["وَكَم حَمَلَت مِن صَديدٍ يَسيلُ","وَكَم وَضَعَت مِن حِناشٍ وَدود",15,"د",1,0],["وكم حَنَّةٍ لي نحوَ نَجْدٍ وأنَّةٍ","كما حَنَّ مرقوعُ الأظلَّينِ رازِحُ",16,"ح",1,0],["وَكَم حُفرَةٍ في غَورِ نَجرانَ أَشفَقَت","ضُلوعي عَلى أَصدائِها أَن تُرَوَّعا",17,"ع",2,0],["وكم حومَةٍ حامَتْ عُقابُ لوائِها","عليكَ ونارُ الحربِ تُذكي سعيرَها",18,"ر",3,0],["وَكَم حافِرٍ لِمرِئٍ حُفرَةً","فَصارَت لِحافِرِها حُفرَه",19,"ر",2,0],["وَكَم حَرَّكتُهُ بِشَرابِ عَتبٍ","فَأَقسَمَ لا يُجيبُ وَلا يَنُضُّ",20,"ض",1,0],["وَكَم حاجَةٍ حاوَلتُها مِن جَنابِهِ","وَأَلحَقتُ في قَولي لَهُ وَخِطابِيا",21,"ي",2,0],["وكم حَوْلها من سائسٍ حافظٍ لها","يُكرّمها عن خُطّةِ المتبذّلِ",22,"ل",1,0],["وكم حِكَمٍ في خطِّ قوْمٍ كثيرةٍ","وأفْضَلُ منها لَمْعَهٌ من سَنا الحسِّ",23,"س",1,0],["وكَم حَوى التُّرْبُ دوني من ذَوي رَحِمي","وما مَقَلْتُ لِبُعدي منهمُ أحدا",24,"د",2,0],["وكم حافرٍ في الرسغ منه زبرجدٌ","كسير به ممّا علاه زجاجُ",25,"ج",1,0],["وكمْ حوى مِنْ جوهرٍ مُثْمِنْ","فما فدى الجوهرُ هذا العرضْ",26,"ض",1,0],["وكم حوتْ من ربيع الدهر أخيلةً","فطِرْنَ رعباً وأفراساً فعُرِّينا",27,"ن",2,0],["وَكَم حَوى مِن فَجرِهِ وَغِيِّهِ","مُذَكِّراً بِما حَوَت أُمَيَّه",28,"ه",1,0],["وَكَم حَضَرَ الهَيجاءَ في ناصِحِ الشَظا","تَكامَلَ في أَسنانِهِ فَهوَ قارِحُ",29,"ح",1,0],["وَكَمْ حُلِيِّ نِساءٍ لاَ يُثَمِّنُهُ","مُقَوِّمٌ قَطُّ في الدُّنيا بِتَثْمِينِ",30,"ن",1,0],["وَكَم حَدَثٍ مِن صُروفِ الزَمانِ","يُكَرِّهُهُ شَيخُنا وَالحَدَث",31,"ث",1,0],["وَكَم حَلَّ فيها مَعشَرٌ بَعدَ مَعشَرٍ","مِنَ الناسِ عاشوا سوقَةً وَمُلوكا",32,"ك",2,0],["وَكَم حَبَلتَ وُحوشُ الرَملِ راتِعَةً","وَمِن أَمامِكَ يَومٌ شَرُّه حَبلَك",33,"ك",1,0],["وَكَم حَلَم الأَديمُ مِن اِبنِ دَهرٍ","حَديثِ السِنِّ ما بَلَغَ اِحتِلاما",34,"م",2,0],["وَكَم حكمة فيها بلاغ أذعتها","بِقافية ملء البلاد شرود",35,"د",1,0],["وَكَم حاول الإنسان كشفاً لسرها","بما حازَ من علم فَما انكشف السر",36,"ر",1,0],["وَكَمْ حُجَجٍ مِنَ الصَّدَقَاتِ بُلْجٍ","نَفَيْتِ بِهَا اعْتِرَاضاً مِنْ غَيُورِ",37,"ر",1,0],["وَكَمْ حَقَّقْتِ أَنَّ الْسُّوقَ حِرْزٌ","حَرِيزٌ لِلْحَرَائِرِ كَالخُدُورِ",37,"ر",1,0],["وَكَمْ حَثَثْتَ فَأَذْكَيْتَ","مُزْبَدَ المَاءِ جَمْرَا",38,"ر",2,0],["وَكَم حيٍ يَعيشُ بنَفْسِ مَيْتٍ","طَوَتْ آمالَها طَيَّ الردَاءِ",39,"ا",2,0],["وكم حرسَتْ مصْرَ عينُ السماءِ","وَكادَ الإلهُ لمن كادها",40,"د",3,0],["وكم حكمت على الأقوامِ في صلفٍ","فردّك الدهر منهياً ومأمورا",41,"ر",2,0],["وكم حاجة ٍ مقرونة ٍ بخيانة ٍ","أباها وإن سيىء امرؤ متذللُ",42,"ل",1,0],["وكم حاجة في نفس مثلي قضيتها","وما ذاك يا مولاي منك تطبّع",43,"ع",1,0],["وكم حققت من أمل ظننا ال","حوادث دون مدركه تحول",44,"ل",1,0],["وكم حظيتُ بظبيٍ جسمهُ ترف","كم ضاع في حبهِ مال وآمالُ",45,"ل",1,0],["وَكَم حَرَمٍ لَو نَأَيتَ اِستُبيحَ","وَكَم ثَغَرٍ لَو بَعُدتَ اِنثَغَر",46,"ر",1,0],["وكم حجة أبرزتها لمخالفٍ","منعت بها أنفاسه أن يصعدا",47,"د",2,0],["وكم حق به وجدَ انتصافا","وذي عجز به رزقَ اقتدارا",48,"ر",2,0],["وكم حسرة للبيض والسمر أغمدت","وما فلقت هاما ولا ولدت فخرا",49,"ر",2,0],["وكم حملتني من اسا ثرت تحته","بضعف وحسادي تراقب وقعتي",50,"ي",1,0],["وَكَم حَصانٍ أُبرِزَت جَهرَةً","تُساقُ لِلجَلدِ بِغَيرِ اِحتِشام",51,"م",1,0],["وَكَم حُلَّةٍ عَمَّرَت مَنزِلاً","وَأَبقَت مَنازِلَ قَومٍ رُسُوما",52,"م",2,0],["وكم حائن أَوْدَى به ضَنْك عيشِه","وللدهرِ فيه مِخْلَبان وناب",53,"ب",1,0],["وَكَم حاسِدٍ ليَ اِنبَرى فَاِنثَنى","لِغُصَّةَ نَفسٍ شَجاها شَجاها",54,"ه",2,1],["وكم حار عشاقٌ ولا مثل حيرتي","إذا شئت يوماً أن أسوء حبيبي",55,"ي",1,1],["وكم حكموا انها علةٌ","وما علةُ غيري تعليلها",56,"ل",3,0],["وكم حاربتني عيونُ المهى","وحاربت أعداءَ سلطانها",57,"ن",3,0],["وكم حبيبٍ فقدنا","فلمْ نجدْ من يغرِّي",58,"ي",1,0],["وكم حاز راجيه علوا وسؤددا","وقدرا سما مجدا او يكفيك ذا القدر",59,"ر",1,0],["وكم حبيب براح الريق أسكرني","وكم جميلٍ بورد الخد حياني",60,"ي",1,0],["وكم حديثٍ كأنه سمرٌ","قد مر لي في الزنا مع السمر",61,"ر",1,1],["وكم حمّلته منه أطيبَ نفحةٍ","تروح بروح الروح في النفح والسَّك",62,"ك",1,0],["وكم حرٍّ لهم أضحى رقيقاً","وكم عبدٍ تمتّع بالحرائر",63,"ر",1,0],["وَكَمْ حَرَصْتَ بِهِمْ أنْ يُصْلِحوا فَأَبَوْا","وَأنْ يُطِيعُوا فَلَجُّوا فيكَ عِصْيانا",64,"ن",2,0],["وكم حسن قد زاده حسنه سنى","محاه وبالإحسان والحسن عوضا",65,"ض",2,0],["وَكَم حَمَوا حَقيقَةً","وَلَم يُوَلّوا القَهقَرا",66,"ر",2,0],["وَكَم حُسامٍ أَبيَضٍ","رَدّوا شَباهُ أَحمَرا",66,"ر",2,0],["وَكَم حلَّلت بالصدِّ قتلَ أَخي الهوى","وَكان يَرى قتل الصُدود محرَّما",67,"م",2,0],["وَكَم حاولتُ صَبري في هَواها","فَقال إليكَ عنّي واِستَقالا",68,"ل",2,0],["وَكَم حلا مَورِدٌ منه لعاشقِه","لكنَّه ربَّما سُقَّت مَرائرُهُ",69,"ر",2,0],["وَكَم حَلَّها مِن تَيَّحانٍ سَمَيدَعِ","مُصافي النَدى ساقٍ بِيَهماءَ مُطعَمِ",70,"م",1,0],["وكم حادث قد ضاق متسع الفضا","على به فانزاح منه بخطرة",71,"ه",1,0],["وكم حاسد يبغي العوائل كاده","وأكبته فانكب في حال حاسر",72,"ر",1,0],["وكم حبيب وفي العهد مجتمع","على المودة لا بالعاجز الوكل",73,"ل",1,0],["وكم حكمة عنهم وحكم وكم وكم","نواميس قهر للطغاة روامي",74,"م",2,0],["وَكَم حُقوقٌ بِمَسعاهُ لَقَد حَفِظَت","وَأَنفُسٌ وَقِيَت مِن فِتنَةٍ جَلَلِ",75,"ل",1,0],["وَكَمْ حِكَمٍ تَأْتي بِها وَعَجَائِبٍ","بِها تَأْنَسُ الأَفْهامُ وَهْيَ غَرائِبُ",76,"ب",1,0],["وَكَمْ حَرامٍ وَحَرامٍ وَقَعَا","عَليَّ مِن وَقْتِ العِشَا لِلسَّحَرِ",77,"ر",1,0],["وَكَم حَشىً سالِمَةٍ مِنَ الأَسى","أَسلَمنَها بَغياً إِلى المَنونِ",78,"ن",1,0],["وَكَم حال أَحال الدَهرَ مكراً","وَصادمها وَسَلّ لَها حُساما",79,"م",2,0],["وَكَم حَجَرٍ حَيّا الحَبيبَ تَحيّةَ ال","مُحبّ لِمَحبوبٍ تَعالى المُحَبّبُ",80,"ب",1,0],["وَكَم حاوَلوا اِن يَلحقوك وَبَينَهُم","وَبَينَك عَبد اللَهِ فيما أَرى عسر",81,"ر",1,0],["وكم حارَبْتُ سُلطانَ اللّيالي","فهاأنَذا أُسالمُ أَو أُهادِن",82,"ن",1,0],["وكم حاجةٍ للحُرِّ لمّا قضَيْتَها","حَسِبتَ غطاءً عن فؤادٍ قدِ انكَشَف",83,"ف",1,0],["وكم حاسدٍ عُلْياكَ يُمسي كأنّه","لفَرْطِ الأَسى من مُقْلتَيْهِ نَحير",84,"ر",1,0],["وَكَم حاجِبٍ قَد خافَ عَيناً فَلَم يُشِر","وَعَينٍ عَلَيها دونَ عَبدِكَ حاجِبُ",85,"ب",1,1],["وَكَم حَرَّكَت ساكِناً لِلغُبارِ","فَسَكَّن مِن تَحتِهِ غابِرا",86,"ر",2,0],["وَكَم حُفَرٍ مُعَطَّلَةٍ كَبِئرٍ","مُعَطَّلَةٍ وَإِن شيدَت كَقَبرِ",87,"ر",1,0],["وَكَم حَلَّت صُروفُ الدَّهرِ حَولِي","فَحَوَّلَهُنَّ عَهدٌ لا يَحولُ",88,"ل",1,0],["وكم حاسٍ بلا كاسٍ","وكم كاسٍ بلا حاس",89,"س",1,0],["وكم حديث أتى","عن صاحب المعجزات",90,"ت",1,0],["وكم حاولتُ صَرْفَ أسايَ عنه","فلم أُفلحْ ولم تَزُلِ القُروحُ",91,"ح",1,0],["وكم حشدتْ يوماً عليّ جنودَه","فما كَلَّ عَنْ حربٍ لَهُ أبداً حدّي",92,"ي",1,0],["وكم حاسد قد أنضج الغيط قلبه","ولكنه غيظ الأسير على القِدِّ",93,"د",1,0],["وكم حُسِدْنا على وُدٍّ بهِ أنسِتْ","نفوسُنا مثلَ أُنْسِ الطِّفْلِ باللَّبَنِ",94,"ن",1,0],["وَكَم حمار غَدا وَالدَهرُ يَرفَعه","قَد داسَ أَعلى ذَرى كيوانَ بِالعَقِبِ",95,"ب",1,0],["وكم حدَّثوا يوم النَّدى بحديثه","فقلتُ أحاديث الكلام إلى هنا",96,"ن",2,0],["وكم حطَّ القضاء إلى حضيض","وكان محلُّه فوقَ الأَثير",97,"ر",1,0],["وكم حفِظَتْ سيوفُكَ من دماءٍ","أُضيعَتْ عند أَبناءِ الضِّياعِ",98,"ع",1,0],["وكم حوى ردفُك من موجةٍ","تضربُ من خصركَ في ساحِلِ",99,"ل",1,0],["وكم حَلَّى يَدِي من ذي عِنانِ","ودَلَّ إلى يَدِي من ذاتِ دَلِّ",100,"ل",1,0],["وكم حَنَّ معشوقٌ وأَعْتَبَ عاشِقٌ","وقلبُكَ مَا أَقْسى وقَلْبِيَ مَا أَصْبى",101,"ب",2,0],["وكم حَصَدَ الدهرُ للخُلْدِ منها","ثمارَ النُّهى وثِمارَ التَّهادِي",102,"ي",1,0],["وكَمْ حَمَلَتْ منكَ بَيْدَاءُ قَفْرٍ","إِلَى الكُفْرِ من يَوْمِ حَيْنٍ مُبِيدِ",103,"د",1,0],["وكم حَلَّ مَوتُ الحَقِّ من شَدِّ عَقدِكم","ويُحيي ابْنُ يَحْيى عَقدَكُمْ فَيَشُدُّهُ",104,"د",2,0],["وكم حذّرت من ملك عنيد","عصى والنفس مهلكها هواها",105,"ا",3,0],["وكم حسبنا همو نبراسَ أمتَّهم","فأرهقوها وزادوا من دياجيها",106,"ي",3,0],["وكم حملتنا نبتغي المجد عندكم","أو الرفدَ فتلاءُ الذراع أمونُ",107,"ن",1,0],["وكم حاسدٍ لي ودَّ لو لم يعش ولم","أُنابِلهُ في تأبينكم وأسايفِ",108,"ف",1,0],["وكم حَلَّةٍ مجفوَّةٍ ولها الهوى","وأُخرَى لها البغضاءُ وهْي تُزارُ",109,"ر",1,0],["وكم حُبَّ من وادٍ إلى العيش مجدِبٍ","وأُبغِضَ مَثْرى آخَر وخصيبُهُ",110,"ب",2,0],["وكم حباني غراء ليس لها","مثلٌ وكم حكمت فيه من مثل",111,"ل",1,0],["وكم حاز ذاك اليوم من ذي بسالةٍ","فأنساهً ركض الشهب مشي الأداهمِ",112,"م",1,0],["وكم حَبْرٍ يَموجُ ببحْرِ عِلْمٍ","له من فقرِهِ سُحْبُ البَلِيَّهْ",113,"ي",2,0],["وكم حالٍ يُترجِمُهُ سُكوتٌ","يؤدِّي فيه منطوقَ اللِّسَانِ",114,"ن",1,0],["وكم حر يعد الصاب شهدا","فيعذب عنده طعم العذاب",115,"ب",1,0],["وكم حمي النسيم بنار وجدي","وقد بردت حلي بل ثغور",116,"ر",1,0],["وكم حريم سبته الترك غاصبة","وكان من دون ذاك الستر أستار",117,"ر",1,0],["وكم حدود أقيمت من سيوفهم","على الرقاب وحطت فيه أوزار",117,"ر",1,0],["وكَمْ حُرَمٍ للهِ تَنْتَهِكُونَها","وما فِيكُمُ مَنْ خافَ لَوْمَةَ لائِمِ",118,"م",1,0],["وَكَم حاملٍ يومَ الكريهة قاطعاً","وساعدُه عند الضّرابِ كَهامُ",119,"م",1,0],["وَكَمْ حَقَّقَ الأَمْرَ الذِي هُوَ بَاطِلٌ","وَكَمْ دَحَضَ الحَقَّ الَّذِي مَالَهُ دَحْضُ",120,"ض",1,0],["وَكَمْ حَنَنْتُ إِلَى حاناتِه وَغَدَا","شَوْقي يُكَابِرُ أَصْوَاتاً بِأَقْدَاحِ",121,"ح",1,0],["وكم حُمَّ منها من حِمامٍ لذِي الهَوى","وكم من عَذابٍ صُبَّ مِنْها عَلى صَبِّ",122,"ب",1,0]]}