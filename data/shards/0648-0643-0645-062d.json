oem.aspx?id=48112",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5167,"تغيب الخلق عن عيني سوى قمر","https://www.poetsgate.com/ViewPoem.aspx?id=181116",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5184,"يا دجلة الخير .. يا أماهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210847",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5313,"وبلدة قطعتها بضامر","https://www.poetsgate.com/ViewPoem.aspx?id=181095",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5493,"إلى المنفى أعود","https://www.poetsgate.com/ViewPoem.aspx?id=197216",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[5606,"إن رضيتوا وإن زعلتوا كسرناالإحتكار","https://www.poetsgate.com/ViewPoem.aspx?id=198511",""],[5616,"قطار","https://www.poetsgate.com/ViewPoem.aspx?id=203453",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5703,"أسطورة حلب","https://www.poetsgate.com/ViewPoem.aspx?id=206281",""],[402,"أطلت نأيك عني","https://www.poetsgate.com/ViewPoem.aspx?id=35675",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5830,"إِنَّ الوَصْلَ يُحْيِيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=200823",""],[5873,"غيث الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=215780",""],[5943,"أهلا سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=53799",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"شكرتُ عواطفَ الناي الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=207913",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[5377,"نهاية التجربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79546&r=&rc=0",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""],[5190,"عندما تعاتبني ابنتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78339&r=&rc=52",""],[6355,"إرثُ والدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66638&r=&rc=98",""]],"verses":[["وكَمْ حَياةٍ جَنَتْها النّفْسُ منْ تَلَفٍ","ورُبَّ أمْنٍ حَواهُ القَلْبُ منْ وجَلِ",0,"ل",1,0],["وكمْ حيلةٍ أضْمَرْتَ في غسَقِ الدُجى","زجَرْتَ لَها داعي الغَرامِ فما ارْعَوَى",1,"و",2,0],["وكمْ حِكْمَةٍ أبْدى وكمْ ظُلْمَةٍ جَلا","بنُورِ هُدىً منْ رأيِهِ ورَشادِ",2,"د",1,0],["وَكَم حُبوسٍ عَلى المَوتى وَغُلَّتُها","يَشري الجُباةُ بِهِ خوصاً وَرَيحانا",3,"ن",2,0],["وَكَم حاوَلوا في الأَرضِ إِطفاءَ نورِهِ","وَإِطفاءُ نورِ الشَمسِ مِن ذاكَ أَقرَبُ",4,"ب",1,0],["وَكَم حَرَّكَ العُجبُ مِن حائِنٍ","فَغادَرتُهُ ما بِهِ مِن حَبَض",5,"ض",1,0],["وكم حفلٍ يهيأ لي","وذلك محض أفضال",6,"ل",1,0],["وَكَم حَنَشٍ ذَعفِ اللُعابِ كَأَنَّهُ","عَلى الشَرَكِ العادِيِّ نِضوُ عِصامِ",7,"م",1,0],["وكم حلَّةٍ جلَّلْتَه بحُليِّها","من الوشي تُنْسي السابرِيَّ اليمانيا",8,"ي",2,0],["وكم حبّرت أقلامه من صحائف","بجيد العلا من درّهن قلائد",9,"د",1,0],["وَكَم حِصنِ جَبّارٍ هُمامٍ وَسوقَةٍ","إِذا ما أَتى أَبوابَهُ لَم تُغَلَّقِ",10,"ق",1,0],["وَكَم حافِرٍ حُفرَةً لِاِمرِئٍ","سَيَصرَعُهُ البَغيُ فيما اِحتَفَر",11,"ر",1,1],["وكم حاجبٍ غضبانَ كاسرِ حاجبٍ","محا الله ما فيه من الكسر بالكسرِ",12,"ر",1,1],["وكم حمَّلونا نعمةً بعد نعمةٍ","على أننا منها خِفافُ الكواهلِ",13,"ل",1,0],["وكم حاجةٍ مقرونةٍ بخيانةٍ","أباها وإن سيءَ امرؤٌ متذللُ",14,"ل",1,0],["وكم حاجةٍ مستحسنٍ حملُ ثقلها","تحمّلَ منها فوق ما يُتحمّلُ",14,"ل",1,0],["وَكَم حَمَلَت مِن صَديدٍ يَسيلُ","وَكَم وَضَعَت مِن حِناشٍ وَدود",15,"د",1,0],["وكم حَنَّةٍ لي نحوَ نَجْدٍ وأنَّةٍ","كما حَنَّ مرقوعُ الأظلَّينِ رازِحُ",16,"ح",1,0],["وَكَم حُفرَةٍ في غَورِ نَجرانَ أَشفَقَت","ضُلوعي عَلى أَصدائِها أَن تُرَوَّعا",17,"ع",2,0],["وكم حومَةٍ حامَتْ عُقابُ لوائِها","عليكَ ونارُ الحربِ تُذكي سعيرَها",18,"ر",3,0],["وَكَم حافِرٍ لِمرِئٍ حُفرَةً","فَصارَت لِحافِرِها حُفرَه",19,"ر",2,0],["وَكَم حَرَّكتُهُ بِشَرابِ عَتبٍ","فَأَقسَمَ لا يُجيبُ وَلا يَنُضُّ",20,"ض",1,0],["وَكَم حاجَةٍ حاوَلتُها مِن جَنابِهِ","وَأَلحَقتُ في قَولي لَهُ وَخِطابِيا",21,"ي",2,0],["وكم حَوْلها من سائسٍ حافظٍ لها","يُكرّمها عن خُطّةِ المتبذّلِ",22,"ل",1,0],["وكم حِكَمٍ في خطِّ قوْمٍ كثيرةٍ","وأفْضَلُ منها لَمْعَهٌ من سَنا الحسِّ",23,"س",1,0],["وكَم حَوى التُّرْبُ دوني من ذَوي رَحِمي","وما مَقَلْتُ لِبُعدي منهمُ أحدا",24,"د",2,0],["وكم حافرٍ في الرسغ منه زبرجدٌ","كسير به ممّا علاه زجاجُ",25,"ج",1,0],["وكمْ حوى مِنْ جوهرٍ مُثْمِنْ","فما فدى الجوهرُ هذا العرضْ",26,"ض",1,0],["وكم حوتْ من ربيع الدهر أخيلةً","فطِرْنَ رعباً وأفراساً فعُرِّينا",27,"ن",2,0],["وَكَم حَوى مِن فَجرِهِ وَغِيِّهِ","مُذَكِّراً بِما حَوَت أُمَيَّه",28,"ه",1,0],["وَكَم حَضَرَ الهَيجاءَ في ناصِحِ الشَظا","تَكامَلَ في أَسنانِهِ فَهوَ قارِحُ",29,"ح",1,0],["وَكَمْ حُلِيِّ نِساءٍ لاَ يُثَمِّنُهُ","مُقَوِّمٌ قَطُّ في الدُّنيا بِتَثْمِينِ",30,"ن",1,0],["وَكَم حَدَثٍ مِن صُروفِ الزَمانِ","يُكَرِّهُهُ شَيخُنا وَالحَدَث",31,"ث",1,0],["وَكَم حَلَّ فيها مَعشَرٌ بَعدَ مَعشَرٍ","مِنَ الناسِ عاشوا سوقَةً وَمُلوكا",32,"ك",2,0],["وَكَم حَبَلتَ وُحوشُ الرَملِ راتِعَةً","وَمِن أَمامِكَ يَومٌ شَرُّه حَبلَك",33,"ك",1,0],["وَكَم حَلَم الأَديمُ مِن اِبنِ دَهرٍ","حَديثِ السِنِّ ما بَلَغَ اِحتِلاما",34,"م",2,0],["وَكَم حكمة فيها بلاغ أذعتها","بِقافية ملء البلاد شرود",35,"د",1,0],["وَكَم حاول الإنسان كشفاً لسرها","بما حازَ من علم فَما انكشف السر",36,"ر",1,0],["وَكَمْ حُجَجٍ مِنَ الصَّدَقَاتِ بُلْجٍ","نَفَيْتِ بِهَا اعْتِرَاضاً مِنْ غَيُورِ",37,"ر",1,0],["وَكَمْ حَقَّقْتِ أَنَّ الْسُّوقَ حِرْزٌ","حَرِيزٌ لِلْحَرَائِرِ كَالخُدُورِ",37,"ر",1,0],["وَكَمْ حَثَثْتَ فَأَذْكَيْتَ","مُزْبَدَ المَاءِ جَمْرَا",38,"ر",2,0],["وَكَم حيٍ يَعيشُ بنَفْسِ مَيْتٍ","طَوَتْ آمالَها طَيَّ الردَاءِ",39,"ا",2,0],["وكم حرسَتْ مصْرَ عينُ السماءِ","وَكادَ الإلهُ لمن كادها",40,"د",3,0],["وكم حكمت على الأقوامِ في صلفٍ","فردّك الدهر منهياً ومأمورا",41,"ر",2,0],["وكم حاجة ٍ مقرونة ٍ بخيانة ٍ","أباها وإن سيىء امرؤ متذللُ",42,"ل",1,0],["وكم حاجة في نفس مثلي قضيتها","وما ذاك يا مولاي منك تطبّع",43,"ع",1,0],["وكم حققت من أمل ظننا ال","حوادث دون مدركه تحول",44,"ل",1,0],["وكم حظيتُ بظبيٍ جسمهُ ترف","كم ضاع في حبهِ مال وآمالُ",45,"ل",1,0],["وَكَم حَرَمٍ لَو نَأَيتَ اِستُبيحَ","وَكَم ثَغَرٍ لَو بَعُدتَ اِنثَغَر",46,"ر",1,0],["وكم حجة أبرزتها لمخالفٍ","منعت بها أنفاسه أن يصعدا",47,"د",2,0],["وكم حق به وجدَ انتصافا","وذي عجز به رزقَ اقتدارا",48,"ر",2,0],["وكم حسرة للبيض والسمر أغمدت","وما فلقت هاما ولا ولدت فخرا",49,"ر",2,0],["وكم حملتني من اسا ثرت تحته","بضعف وحسادي تراقب وقعتي",50,"ي",1,0],["وَكَم حَصانٍ أُبرِزَت جَهرَةً","تُساقُ لِلجَلدِ بِغَيرِ اِحتِشام",51,"م",1,0],["وَكَم حُلَّةٍ عَمَّرَت مَنزِلاً","وَأَبقَت مَنازِلَ قَومٍ رُسُوما",52,"م",2,0],["وكم حائن أَوْدَى به ضَنْك عيشِه","وللدهرِ فيه مِخْلَبان وناب",53,"ب",1,0],["وَكَم حاسِدٍ ليَ اِنبَرى فَاِنثَنى","لِغُصَّةَ نَفسٍ شَجاها شَجاها",54,"ه",2,1],["وكم حار عشاقٌ ولا مثل حيرتي","إذا شئت يوماً أن أسوء حبيبي",55,"ب",2,1],["وكم حكموا انها علةٌ","وما علةُ غيري تعليلها",56,"ل",3,0],["وكم حاربتني عيونُ المهى","وحاربت أعداءَ سلطانها",57,"ن",3,0],["وكم حبيبٍ فقدنا","فلمْ نجدْ من يغرِّي",58,"ي",1,0],["وكم حاز راجيه علوا وسؤددا","وقدرا سما مجدا او يكفيك ذا القدر",59,"ر",1,0],["وكم حبيب براح الريق أسكرني","وكم جميلٍ بورد الخد حياني",60,"ن",2,0],["وكم حديثٍ كأنه سمرٌ","قد مر لي في الزنا مع السمر",61,"ر",1,1],["وكم حمّلته منه أطيبَ نفحةٍ","تروح بروح الروح في النفح والسَّك",62,"ك",1,0],["وكم حرٍّ لهم أضحى رقيقاً","وكم عبدٍ تمتّع بالحرائر",63,"ر",1,0],["وَكَمْ حَرَصْتَ بِهِمْ أنْ يُصْلِحوا فَأَبَوْا","وَأنْ يُطِيعُوا فَلَجُّوا فيكَ عِصْيانا",64,"ن",2,0],["وكم حسن قد زاده حسنه سنى","محاه وبالإحسان والحسن عوضا",65,"ض",2,0],["وَكَم حَمَوا حَقيقَةً","وَلَم يُوَلّوا القَهقَرا",66,"ر",2,0],["وَكَم حُسامٍ أَبيَضٍ","رَدّوا شَباهُ أَحمَرا",66,"ر",2,0],["وَكَم حلَّلت بالصدِّ قتلَ أَخي الهوى","وَكان يَرى قتل الصُدود محرَّما",67,"م",2,0],["وَكَم حاولتُ صَبري في هَواها","فَقال إليكَ عنّي واِستَقالا",68,"ل",2,0],["وَكَم حلا مَورِدٌ منه لعاشقِه","لكنَّه ربَّما سُقَّت مَرائرُهُ",69,"ر",2,0],["وَكَم حَلَّها مِن تَيَّحانٍ سَمَيدَعِ","مُصافي النَدى ساقٍ بِيَهماءَ مُطعَمِ",70,"م",1,0],["وكم حادث قد ضاق متسع الفضا","على به فانزاح منه بخطرة",71,"ه",1,0],["وكم حاسد يبغي العوائل كاده","وأكبته فانكب في حال حاسر",72,"ر",1,0],["وكم حبيب وفي العهد مجتمع","على المودة لا بالعاجز الوكل",73,"ل",1,0],["وكم حكمة عنهم وحكم وكم وكم","نواميس قهر للطغاة روامي",74,"م",2,0],["وَكَم حُقوقٌ بِمَسعاهُ لَقَد حَفِظَت","وَأَنفُسٌ وَقِيَت مِن فِتنَةٍ جَلَلِ",75,"ل",1,0],["وَكَمْ حِكَمٍ تَأْتي بِها وَعَجَائِبٍ","بِها تَأْنَسُ الأَفْهامُ وَهْيَ غَرائِبُ",76,"ب",1,0],["وَكَمْ حَرامٍ وَحَرامٍ وَقَعَا","عَليَّ مِن وَقْتِ العِشَا لِلسَّحَرِ",77,"ر",1,0],["وَكَم حَشىً سالِمَةٍ مِنَ الأَسى","أَسلَمنَها بَغياً إِلى المَنونِ",78,"ن",1,0],["وَكَم حال أَحال الدَهرَ مكراً","وَصادمها وَسَلّ لَها حُساما",79,"م",2,0],["وَكَم حَجَرٍ حَيّا الحَبيبَ تَحيّةَ ال","مُحبّ لِمَحبوبٍ تَعالى المُحَبّبُ",80,"ب",1,0],["وَكَم حاوَلوا اِن يَلحقوك وَبَينَهُم","وَبَينَك عَبد اللَهِ فيما أَرى عسر",81,"ر",1,0],["وكم حارَبْتُ سُلطانَ اللّيالي","فهاأنَذا أُسالمُ أَو أُهادِن",82,"ن",1,0],["وكم حاجةٍ للحُرِّ لمّا قضَيْتَها","حَسِبتَ غطاءً عن فؤادٍ قدِ انكَشَف",83,"ف",1,0],["وكم حاسدٍ عُلْياكَ يُمسي كأنّه","لفَرْطِ الأَسى من مُقْلتَيْهِ نَحير",84,"ر",1,0],["وَكَم حاجِبٍ قَد خافَ عَيناً فَلَم يُشِر","وَعَينٍ عَلَيها دونَ عَبدِكَ حاجِبُ",85,"ب",1,1],["وَكَم حَرَّكَت ساكِناً لِلغُبارِ","فَسَكَّن مِن تَحتِهِ غابِرا",86,"ر",2,0],["وَكَم حُفَرٍ مُعَطَّلَةٍ كَبِئرٍ","مُعَطَّلَةٍ وَإِن شيدَت كَقَبرِ",87,"ر",1,0],["وَكَم حَلَّت صُروفُ الدَّهرِ حَولِي","فَحَوَّلَهُنَّ عَهدٌ لا يَحولُ",88,"ل",1,0],["وكم حاسٍ بلا كاسٍ","وكم كاسٍ بلا حاس",89,"س",1,0],["وكم حديث أتى","عن صاحب المعجزات",90,"ت",1,0],["وكم حاولتُ صَرْفَ أسايَ عنه","فلم أُفلحْ ولم تَزُلِ القُروحُ",91,"ح",1,0],["وكم حشدتْ يوماً عليّ جنودَه","فما كَلَّ عَنْ حربٍ لَهُ أبداً حدّي",92,"د",2,0],["وكم حاسد قد أنضج الغيط قلبه","ولكنه غيظ الأسير على القِدِّ",93,"د",1,0],["وكم حُسِدْنا على وُدٍّ بهِ أنسِتْ","نفوسُنا مثلَ أُنْسِ الطِّفْلِ باللَّبَنِ",94,"ن",1,0],["وَكَم حمار غَدا وَالدَهرُ يَرفَعه","قَد داسَ أَعلى ذَرى كيوانَ بِالعَقِبِ",95,"ب",1,0],["وكم حدَّثوا يوم النَّدى بحديثه","فقلتُ أحاديث الكلام إلى هنا",96,"ن",2,0],["وكم حطَّ القضاء إلى حضيض","وكان محلُّه فوقَ الأَثير",97,"ر",1,0],["وكم حفِظَتْ سيوفُكَ من دماءٍ","أُضيعَتْ عند أَبناءِ الضِّياعِ",98,"ع",1,0],["وكم حوى ردفُك من موجةٍ","تضربُ من خصركَ في ساحِلِ",99,"ل",1,0],["وكم حَلَّى يَدِي من ذي عِنانِ","ودَلَّ إلى يَدِي من ذاتِ دَلِّ",100,"ل",1,0],["وكم حَنَّ معشوقٌ وأَعْتَبَ عاشِقٌ","وقلبُكَ مَا أَقْسى وقَلْبِيَ مَا أَصْبى",101,"ب",2,0],["وكم حَصَدَ الدهرُ للخُلْدِ منها","ثمارَ النُّهى وثِمارَ التَّهادِي",102,"د",2,0],["وكَمْ حَمَلَتْ منكَ بَيْدَاءُ قَفْرٍ","إِلَى الكُفْرِ من يَوْمِ حَيْنٍ مُبِيدِ",103,"د",1,0],["وكم حَلَّ مَوتُ الحَقِّ من شَدِّ عَقدِكم","ويُحيي ابْنُ يَحْيى عَقدَكُمْ فَيَشُدُّهُ",104,"د",2,0],["وكم حذّرت من ملك عنيد","عصى والنفس مهلكها هواها",105,"ا",3,0],["وكم حسبنا همو نبراسَ أمتَّهم","فأرهقوها وزادوا من دياجيها",106,"ي",3,0],["وكم حملتنا نبتغي المجد عندكم","أو الرفدَ فتلاءُ الذراع أمونُ",107,"ن",1,0],["وكم حاسدٍ لي ودَّ لو لم يعش ولم","أُنابِلهُ في تأبينكم وأسايفِ",108,"ف",1,0],["وكم حَلَّةٍ مجفوَّةٍ ولها الهوى","وأُخرَى لها البغضاءُ وهْي تُزارُ",109,"ر",1,0],["وكم حُبَّ من وادٍ إلى العيش مجدِبٍ","وأُبغِضَ مَثْرى آخَر وخصيبُهُ",110,"ب",2,0],["وكم حباني غراء ليس لها","مثلٌ وكم حكمت فيه من مثل",111,"ل",1,0],["وكم حاز ذاك اليوم من ذي بسالةٍ","فأنساهً ركض الشهب مشي الأداهمِ",112,"م",1,0],["وكم حَبْرٍ يَموجُ ببحْرِ عِلْمٍ","له من فقرِهِ سُحْبُ البَلِيَّهْ",113,"ي",2,0],["وكم حالٍ يُترجِمُهُ سُكوتٌ","يؤدِّي فيه منطوقَ اللِّسَانِ",114,"ن",1,0],["وكم حر يعد الصاب شهدا","فيعذب عنده طعم العذاب",115,"ب",1,0],["وكم حمي النسيم بنار وجدي","وقد بردت حلي بل ثغور",116,"ر",1,0],["وكم حريم سبته الترك غاصبة","وكان من دون ذاك الستر أستار",117,"ر",1,0],["وكم حدود أقيمت من سيوفهم","على الرقاب وحطت فيه أوزار",117,"ر",1,0],["وكَمْ حُرَمٍ للهِ تَنْتَهِكُونَها","وما فِيكُمُ مَنْ خافَ لَوْمَةَ لائِمِ",118,"م",1,0],["وَكَم حاملٍ يومَ الكريهة قاطعاً","وساعدُه عند الضّرابِ كَهامُ",119,"م",1,0],["وَكَمْ حَقَّقَ الأَمْرَ الذِي هُوَ بَاطِلٌ","وَكَمْ دَحَضَ الحَقَّ الَّذِي مَالَهُ دَحْضُ",120,"ض",1,0],["وَكَمْ حَنَنْتُ إِلَى حاناتِه وَغَدَا","شَوْقي يُكَابِرُ أَصْوَاتاً بِأَقْدَاحِ",121,"ح",1,0],["وكم حُمَّ منها من حِمامٍ لذِي الهَوى","وكم من عَذابٍ صُبَّ مِنْها عَلى صَبِّ",122,"ب",1,0],["وكم حلت بمعرفة وفهم","مشاكل أصبحت كالمعجزات",123,"ت",1,0],["وَكَم حَلَّ مِن عِيٍّ وَأَطلَقَ حَبَّةً","وَكَم فَلَّ مِن غَيٍّ وَأَنطَقَ أَبكَما",124,"م",2,0],["وكَم حُلَلٍ أُلبِستَها وَمَطارِفٍ","شَدَوت بِها تُزري بوشيِ المَطارِفِ",125,"ف",1,0],["وَكَم حُمَّ الفِراقُ فَهَل أَراها","قَدِ اكتَنَفَتكَ مِن هُنّا وَهُنّا",126,"ن",2,0],["وكم حيرت هاد وكم حيدت هدى","وكم بخست خصما وكم أخسرت وزنا",127,"ن",2,0],["وكم حاشك ما صانها ولبانها","على حين داب الناس صون الحواشك",128,"ك",1,0],["وكم حملت ولم تعقد نكاحاً","بمن شابا عليه العارضان",129,"ن",1,0],["وكم حادثات غرائب وقعا","تجارين بين الدجى والضحى",130,"ا",1,0],["وكم حطمتْ أغلال أيديهمُ يدي","وما زال غلي في يدي غير محطوم",131,"م",1,0],["وكم حملت تلك الجوانح لوعةً","وأنت بعقبى قومك المغرم الصب",132,"ب",1,0],["وكم حلّةٍ ضُرِّجتْ بالعَبيرِ","وهَبْتَ معاً والصَّقيل الحُساما",133,"م",2,0],["وكم حاولوا بالإفك صدع صفاتنا","وهل خف يوما يذبل ويلملم",134,"م",1,0],["وَكَم حازَ عَيباً ما حَوَته الوَرى كَما","حَوى ما تُذَمُّ النّاسُ فيهِ وتُقدحُ",135,"ح",1,0],["وَكَم حَقيرٍ حَوى في غَيرِهِ عظماً","وَذاكَ في نَفسِهِ مِن جِنسِ محتقرِ",136,"ر",1,0],["وَكَم حِمارٍ غَدا بِاليُمنِ مُتَّصِفاً","وَكَم حِمارٍ عَلا قَدراً على فَرسِ",137,"س",1,0],["وكم حوَى هذه يا صاح مِنْ مَلِكٍ","أباده هاذمُ اللذاتِ والنعم",138,"م",1,0],["وكم حسودٍ تركناه يموتُ على","فراشه بين ضَجَّاجٍ وعجَّاج",139,"ج",1,0],["وَكَمْ حُسِدنا على أوجَاعِنا وَعَلى","دُمُوعِنا وعلى تِهطالِها النّهِمِ",140,"م",1,0],["وكم حالت الأحوالُ منا بِحالة","نعمنا بها والنفس الأمُ طالب",141,"ب",1,0],["وكم حضرت نادياً","وكم خصرت باديا",142,"ي",2,0],["وكم حضرت وادياً","بطر في المطهم",142,"م",1,0],["وكم حللت حانة","وكم قتلت عانة",142,"ه",1,0],["وكم حسيس رعته","وكم خسيس عبته",142,"ه",1,0],["وكم حلى بنفثته زعاها","كما وقى بها طعن الصعاد",143,"د",1,0],["وكم حمى ووقى عينا وجاد بها","واقتادها وسبى وامتاحها وطفا",144,"ف",2,0],["وكم حليب وكم ماء سقت يده","بلمسه الشاه أو تفجيرها الديما",145,"م",2,0],["وكم حاسد أضحى يلجلج مضغتي","وينظرني باللَّحظِ نظرة أحولا",146,"ل",2,0],["وَكَم حسرةٍ يومَ الوداعِ تصعّدت","لَها هيم أَنفاسي وذابت لها كبدِ",147,"د",1,0],["وَكم حاسد لي فيك مِن قبل قد سَعت","أَفاعيه فيما بيننا والعقاربُ",148,"ب",1,0],["وكم حُروبٍ أَذكَتْ جواحَمها","سنابكُ الخيلِ مِنْ مذاكيهِ",149,"ي",2,0],["وكم حاكَ أَبرادَ العُلا فأَجادَها","وكم حَكَّ أَفواهَ القُروحِ فأَدْماها",150,"ا",3,0],["وكمْ حُجَّةٍ بالرَّأْيِ عنِّي أَقامَها","وكم حاجةٍ بالمَشْرَفيَّ تَقاضاها",150,"ا",3,0],["وكَمْ حَنَنْتُ إلى حاناتِهِ وغَدا","شَوْقي يُكاثِرُ أَصْواتاً بِأَقْداحِ",151,"ح",1,0],["وكم حملتني كفه فوق كتفه","وكم لاعبتني حينما كنت ألعب",152,"ب",1,0],["وكم حاجة بذلت نفسها","ففوّتها الحرص من فرطه",153,"ط",2,0],["وَكَمْ حجَّةٍ أَصْبَحَتْ حُجَّةً","عَلَيَّ فَلَمْ تُجْدِ إِلاَّ اعْتِذَارَا",154,"ر",2,0],["وَكَمْ حَازَ فِي عَصْرِ الصِّبَا مِنْ فَضَائِلٍ","تَأَدَّتْ لَنَا مِنْ بَيْنِ مَثْنَى وَوِحْدَانِ",155,"ن",1,0],["وكم حصون إذا عددتها كثرت","يكفيك من باطن المنشور عنوانا",156,"ن",2,0],["وكم حاسدٍ ظنّهُ زينةً","ويأبى لها ثُكْلُها أن تُزَانا",157,"ن",2,0],["وكم حاولوا أن يطفئوا نوره وقد","أبى اللَه إلّا أن يَخيبوا فخُيِّبوا",158,"ب",3,0],["وكم حاربوا المختار في الدين ضِلّةًً","ومن حارب الرحمن يخزي ويُحرَب",158,"ب",1,0],["وكم حكمت سيف الحق فاختار","محل القطع من روس الأكابر",159,"ر",1,0],["وكم حاذا النبي بكل فعل","وقول في امتثال واجتناب",160,"ب",1,0],["وكم حاذاه في الأوصاف طرا","كما حاذا الغراب أخو الغراب",160,"ب",1,0],["وكم حاولت فتنتتا خداعا","ولم تك بالمهذب واللبيب",161,"ب",1,0],["وكم حقوق لي لم أؤنب","ان قلت اهلها بهم اوصى النبي",162,"ب",2,0],["وكم حادثٍ غال فاغتالَتْه منه ظُبّي","تَعَوَّدتْ كشف مَكْروهٍ وَرَأْبَ ثَأَى",163,"ا",1,0],["وكم حكمةٍ لم تَسمع الأُذنُ مِثلَها","لهُ إن تَلُح في ناظرِ العَين تُكتبِ",164,"ب",1,0],["وَكَم حَبا وَعَلى المُستَضعَفينَ حَنا","وَكَم صَفا وَضَفا جوداً لِجَبرِهِمِ",165,"م",1,0],["وكم حلَّ فيها من أناسٍ تقدّموا","وهاموا بها عشقاً وتاهُوا بها فخْرا",166,"ر",2,0],["وكم حُبوشٍ بالطُّبولِ راقِصهْ","وسائر الخلق إلَيْها شاخِصَهْ",167,"ه",1,0],["وكم حَباهُ اللَهُ من آيةٍ","بَيِّنَةٍ بانت لِقاصٍ ودان",168,"ن",1,0],["وكم حريم لاهل البيت محترم","قد استحل وكم صاحت صوائحه",169,"ح",2,0],["وكم حساد لي كان قبل إقامتي","ببابك يبدي لي توجع راحم",170,"م",1,0],["وكم حازم يبكي الفضائل والنهى","وذي عيلة يبكي السماحة والندى",171,"د",2,0],["وكم حذّر الهادي الورى عن شهادة","بزور بتهديد أتى وتوعد",172,"د",1,0],["وَكَم حاسِدٍ رامَها بِالمُنى","وَماذا عَلَيها وَلَهوَ الثَّمَن",173,"ن",1,0],["وَكَم حَبَسَ القُمرِيَّ حُسنُ غِنائِهِ","وَقَيَّدَتِ البازِيَّ حُجنُ المَخالِبِ",174,"ب",1,0],["وكم حويتُ جزيلاً من مكارمه","ورحتُ أرفلُ في أثوَابه الجُدد",175,"د",1,0],["وَكَم حرة بَعد التحجب أُبرزت","وَأَدمعها كَالمعصرات هَواتن",176,"ن",1,0],["وَكَم حميت ثُغور المُسلمين وَهُم","ما بَينَ أَنياب خمص الأَسد لو فطنُوا",177,"ن",3,0],["وكم حديث لهما خرجه","ياقوت دمعي وابن مقلتي كتب",178,"ب",1,0],["وَكَم حُرُماتٍ بتُّ أَخشى اِنتِهاكَها","إِذا ما دَعا الداعي وَصمَّ سَميع",179,"ع",1,0],["وكم حيلةٍ تترى على إثر حالةٍ","وذو الودّ من يحتالُ أو يتسبّبُ",180,"ب",1,0],["وكم حاذرَ المرءُ فى عَيشه","وهل ينفعُ المرءَ فيهِ الحَذَر",181,"ر",1,0],["وكم حمراء فوق الراس تحكي","جهنمَ أوقدَت للكافرينا",182,"ن",2,0],["وكم حاز من فضل إذا رمت وصفه","يقول لساني لست في العجز أولا",183,"ل",2,0],["وَكَم حادِثات مِنكَ كَرب بِجَيشِها","عَلي الخَلق فَاِنقادوا لِطوع التَذَلل",184,"ل",1,0],["وكم حاسد قد غاله بشتيمة","وكم مبغض للحق بالهجر سابق",185,"ق",1,0],["وكم حسنات ليس في الوسع عدها","تكارمها والبحر في الفيض سيان",186,"ن",1,0],["وكم حكمة بالصمت والصمت بثها","كما تم بالورد الشذا من كمامه",187,"م",2,0],["وكم حَذِرَتْ منك المنيةُ حتفَها","وقام القنا لما تنمرت هائبا",188,"ب",2,0],["وكم حبارى امها صقر فلم","يظفر بغير حتفه بالذرق",189,"ق",1,0],["وكم حديث جاءنا بفضله","عن سيد عن الهوى لم ينطق",189,"ق",1,0],["وكم حام