{"poems":[[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[11,"ألا أخلفت سوداء منك المواعد","https://www.aldiwan.net/poem235.html",""],[107,"سبيلك في مرضاة ربك يا بشر","https://www.aldiwan.net/poem43572.html","الطويل"],[11,"إلا أخلقتْ منك المواعد،","https://www.poetsgate.com/ViewPoem.aspx?id=16839",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[556,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[556,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96361","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111484","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58016","الوافر"],[5189,"إشراقة","https://www.poetsgate.com/ViewPoem.aspx?id=211849",""],[5688,"وغرّ بدا لي","https://www.poetsgate.com/ViewPoem.aspx?id=200926",""],[5740,"ألاَ اخْرَسْ فَهذاَ مِنْك أعْلا وأكبَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211476",""]],"verses":[["إِلا أُخرِس الغاوي وَلا فاهَ قائِلٌ","بِأَمثالِها ما بَلَّلَ القَطرُ جَلمَدا",0,"د",2,0],["أَلا أَخلَفَت سَوداءَ مِنكَ المَواعِدُ","وَدونَ الَّذي أَمَّلتَ مِنها الفَراقِدُ",1,"د",1,1],["ألا اخْرُج إلينا وانظرِ اليومَ أيُّنا","له الشّرفُ العالي الذُّرى وله الفَخْرُ",2,"ر",1,0],["إلا أخلقتْ منك المواعد،","ودونَ الذي أمّلْتَ منها الفَراقِدُ",3,"د",1,1],["أَلا أَخبرونا هل سَمِعتم بمعشرٍ","سِواكُم رَأوا في صلبِ ربّهمُ فخرا",4,"ر",2,0],["إلا أخٌ ما ارعوَى فآذوْ","هُ وَهْوَ منْ أجلِها نكِيْبُ",5,"ب",1,0],["ألّا أخذتَ بمن أخذ","تَ تَليدَ مالي أو طريفي",6,"ف",2,0],["ألّا أخذتَ بمن أخذتَ عصائباً","ليسوا لمَكْرُمةٍ من الأكياسِ",7,"س",1,0],["إِلا أُخيَّ بني الجَوال يوعدُني","ماذا يريدُ ابنُ جَوّالٍ بايعادي",8,"د",2,0],["إِلاَّ أَخيلَ وَذلِكَ ابنُ إِلاهَةٍ","فَاصدُق وُقُل لي أَينَ هَكطُرُ كَوكَبا",9,"ب",2,0],["ألاَ اخْتَرْ آلَ سيسَانٍ","نصيراً ودَعْ قوماً سبيلُهُم النفورُ",10,"ر",1,0],["ألاَ أخبرنّكَ أن تَستَقيمْ","طريقك للحقِ دربٌ سليمْ",11,"م",1,1],["ألا اخسأ دجيجيل وجانب جنابنا","فإنّ هجانا فوق كلّ تملّق",12,"ق",1,0],["ألاَ اخْرَسْ فَهذاَ مِنْك أعْلا وأكبَرُ","ونَفْسُكَ مِما رُمْتَ أدْنى وأصغرُ",13,"ر",1,1]]}