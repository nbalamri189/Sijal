"],[5274,"لا بد من صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203380",""],[5277,"تلويحٌ وتلميح","https://www.poetsgate.com/ViewPoem.aspx?id=203960",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5351,"المتناقض","https://www.poetsgate.com/ViewPoem.aspx?id=202233",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5431,"لاتلومي تعلّقي بالرجالِ....","https://www.poetsgate.com/ViewPoem.aspx?id=200455",""],[5431,"القبة العليا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210728",""],[5442,"يا مظهر حب الرسول وجهله","https://www.poetsgate.com/ViewPoem.aspx?id=114781",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5500,"صفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=188512",""],[5538,"إني قرير العين حين أراكا","https://www.poetsgate.com/ViewPoem.aspx?id=142632",""],[5612,"ماذا جَرى لكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179543",""],[5644,"ليست بإمكاني","https://www.poetsgate.com/ViewPoem.aspx?id=211269",""],[5717,"لا دار سلمى هي بل ربع الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=170593",""],[5758,"حصاد مراهق","https://www.poetsgate.com/ViewPoem.aspx?id=201211",""],[5829,"وإن طاوعتني في الحبِّ أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=178392",""],[5829,"واسقط حكمة الرجل الحصيف","https://www.poetsgate.com/ViewPoem.aspx?id=211484",""],[5910,"الثقة.. والغرور","https://www.poetsgate.com/ViewPoem.aspx?id=206321",""],[5923,"من مذكرات مراقب امتحان","https://www.poetsgate.com/ViewPoem.aspx?id=149684",""],[6097,"اِطوِ العِتابَ","https://www.poetsgate.com/ViewPoem.aspx?id=190660",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[5393,"رب شيخ يمد للحق رجلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85468&r=&rc=35",""]],"verses":[["أَيَكونُ البَخيلُ غَيرَ بَخيلٍ","أَم يَكونُ الجَوادُ غَيرَ جَوادِ",0,"د",1,0],["أيكفينا من الدَولات أنّا","تُعلَّق في الديار لنا البُنود",1,"د",1,0],["أيكون ظِلَّ الله تاركُ حكمه ال","مَنْصوص في آي الكتاب المُنزل",2,"ل",1,0],["أيكون ما شرع النبي محمد","شيئاً يخالف شرعة التمدين",3,"ن",1,0],["أيكسر حالي بالجفاء وطالما","تعوَّدت من نعماك عاطفة الجبر",4,"ر",1,0],["أيكيَّةٌ تدعو بشجو إن دعا","ريب الزمان قرينها بفراق",5,"ق",1,0],["أَيَكونُ غاصِبَنا وَيَزعُمُ أَنَّهُ","أَمسى عَلَينا مُحسِناً مُتَصَدِّقا",6,"ق",2,0],["أَيَكونُ غَيرُكَ مُجرِماً وَتَبيتُ في","وَجَلٍ كَأَنَّكَ أَنتَ صِرتَ المُجرِما",7,"م",2,0],["أى كف قد باشرت صفع خدّ","فسمعنا دويَّها في الصعيد",8,"د",1,0],["أَيكي وَأَيكُكَ ضاحِكا","نِ عَلى خَمائِلِ مونبِلي",9,"ل",2,0],["أَيَكفُرُ بِالإِنجيلِ مَن تِلكَ كُتبُهُ","أَناجيلُ مِنها مُنذِرٌ وَبَشيرُ",10,"ر",1,0],["أَيَكونُ الهِجانُ غَيرَ هِجانٍ","أَم يَكونُ الصُراحُ غَيرَ صُراحِ",11,"ح",1,0],["أَي كَبتَ كُلِّ حاسِدٍ مُنافِقِ","أَنتَ لَنا وَكُلُّنا لِلخالِقِ",12,"ق",1,0],["أيكيَّةٌ صدحتْ شَجْواً على فَنَنٍ","فأشعلتْ ما خبا من نارِ أشجاني",13,"ن",2,1],["أَيُّكُم سائِلٌ زُرَي","قَةَ عَن حالِ بِنتِها",14,"ت",3,1],["أَيُّ كَفٍّ بَنانُها تَمطُرُ الإِحسا","نَ وَبلاً حَلَّت بِدارِ بَنانِ",15,"ن",1,0],["أيكون ذنبي أَن رفع","تُك وارتفعتُ إلى السماء",16,"ا",2,1],["أيكونَ ذنبي أن جعل","تُك فوق عرشٍ من سناء",16,"ا",2,0],["أيكون ذنبي أنني","بك أحتمي من كل داء",16,"ا",2,0],["أيكون ذنبي أن أرا","ك لخاطري قَبَساً أضاء",16,"ا",2,0],["أيكون ذنبي أن يُنا","طَ بك التعلُّلُ والرجاء",16,"ا",2,0],["أيكون ذنبي أن حب","بَك لي من الدنيا وِقاء",16,"ا",2,0],["أيكون ذنبي أيّ ذن","ب صار لي إلا الوفاء",16,"ا",2,0],["أَيُّ كَريمٍ يَرضى بِشَتمِ بَني","عَبدِ الكَريمِ الجِحاجِحِ النُجُبِ",17,"ب",1,0],["أيُّ كفٍّ لمْ تنلْ منها المنى","فبلاها اللهُ منهُ بالشللْ",18,"ل",1,0],["أيكون مَنْ كَرِهَ الضّلالَ لقومِه","وَوَفىَ لِربِّ العالمين مَلوما",19,"م",2,0],["أيكفرُ بعضُها فيفيضُ زَيْتاً","ويطغَى بعضُها ماءً وطيناً",20,"ن",2,0],["أَيَكُفُّ شَكوَكَ أَن يَكونَ أَماما","حَنِقٌ يَشُبُّ مِنَ الوَعيدِ ضِراما",21,"م",2,1],["أَيُّكم يا آل بَيت المُصطَفى","ما قَضى مُستشهداً مُنذُ عَلي",22,"ل",2,0],["أيَكونُ قَوْمٌ في الجَحِيمِ ويَصْطَفِي","منهم كَلِيماً رَبُّنا وخَلِيلا",23,"ل",2,0],["أَيَكُونُ مَنْ حَفِظَ الإلهُ مُضَيَّعاً","أَوْ مَنْ أُشِيدَ بِنَصْرِهِ مَخْذُولا",23,"ل",2,0],["أيكِيّةِ الذهَبِ المرصَّعِ رَفرَفَتْ","فيها حَمامٌ ما دَعَونَ هَديلا",24,"ل",2,0],["أَيَكونُ رَفعٌ لِلشُرورِ فَيَنتَهي","غاوٍ وَيَقنَعُ بِالنَباتِ الضَيغَمِ",25,"م",1,0],["أَيُّ كَمَالٍ وَجَمَالٍ يُرَى","كَمَا يُرَى فِي طَالِعِ الزَّهْرِ",26,"ر",1,0],["أَيَكُونُ مِنَّا كُلُّ حرٍ سَائِدٍ","وَسَوَادُنَا يَبْقَى أَذَلَّ سَوَادِ",27,"د",1,0],["أَيُّ كَفيلٍ أَعْمَى إِذَا قيلَ مَنْ","فِي الْقَوْم يَومَ الَّذي وَيَومَ التَّنَاد",28,"د",1,0],["أَي كَنْزٍ أَخْرَجْتَهُ فِي القَوَافِي","بَيْنَ جَزْلٍ نَظَمْتَهُ وَرَقِيقِ",29,"ق",1,0],["أيكفي الأرضَ نَورُك من بعيدِ","وأنَّك حولها أبدًا تدور؟",30,"ر",1,0],["أيكفي الأرضَ ومضٌ منك يَبْدُو","إذا ما الأَرضُ فَارَقَها النهار؟",31,"ر",1,0],["أيكبت همي خامدا غير حامد","له العدل أمرا وهو في النفس جاحم",32,"م",1,0],["أيكون الخل سوى خل","حتى في الكأس المعسولة",33,"ل",2,0],["أيَكونُ قَوْمٌ في الجَحِيمِ ويَصْطَفِي","أو من أشيدَ بنصرهِ مخذولا؟",34,"ل",2,0],["أيكى بدمع له من حسرتى مدد","وأستريح إلى صبر بلا مدد",35,"د",1,0],["أيكون غاضبنا ويزعم أنّه","أمسى علينا محسنا متصدّقا",36,"ق",2,0],["أيكرم العيد شكوانا نزلت","عليك يا ابن رسول الله شكوانا",37,"ن",2,0],["أيكف شأوك أن يكون أماما","حنقٌ يشب من الوعيد ضراما",38,"م",2,1],["أيكون ذنبي أن أحبّكِ","لي من الدنيا وقِاءْ",39,"ا",2,0],["أيكون الحل سوى خل …","حتى في الكأس المعسوله",40,"ل",2,0],["أيكُ العصافيرِ والدنيا عليَّ أسىً","أما تُرَوَّحُ عني بعضُ أحزاني",41,"ن",2,1],["أي كهف في حيكم من اتاه","فاز منه بظل روض انيق",42,"ق",1,0],["أَيَكون الهَوى نَدىً وَمَلابا","وَثِماراً جَنى الهَناء رِطابا",43,"ب",2,1],["أَيَكونُ الهَوى اِعصُرِ الصُبحَ وَاللَي","لَ شَراباً وَأَترِعِ الأَكوابا",43,"ب",2,0],["أَيَكونُ الهَوى اِقطُفِ الشَهدَ ما أَص","فى اللَيالي وَما أَلَذَّ اللُعابا",43,"ب",2,0],["أَيَكونُ الهَوى لَنا حُلُمُ الجَ","نَّةِ فَليَنفَرِط بِنا أَطيانا",43,"ن",2,0],["أيُّ كريمٍ لم يشِمْ شِميتي","وأيُّ عافٍ لم يَرِد بَحري",44,"ر",2,0],["أيكونُ مبسوطَ الجناح","كمثلِ مقصوصِ الجناح",45,"ح",1,0],["أيكونُ خدُّكِ رقّةً إبريسماً","ويكونُ طرفُكِ حدّةً فولاذا",46,"ذ",2,0],["أيكونُ منهم بعدَ ظلم نُفوسِهم","عَدلٌ وإنصافٌ لِمظلوميك",47,"ك",1,0],["أيكون طرسُ الخد من ياقوتةٍ","ويخط فيها الحسن إلا بالذهب",48,"ب",1,0],["أيّ كون محجّبُ الأسرار","خلف عينيك يا بنة الأقدار",49,"ر",1,0],["أيكونُ في جسمي فؤادٌ واحدٌ","فكأن جسمي في فؤادٍ واحِد",50,"د",1,0],["أيكونُ لومُك عند ذلك نافعي","أم مانعي أم مصلحي أم مفسدي",51,"د",2,0],["أيكونُ نكرانُ الجميل جزاءها","منا ، فنرضى أن يسيء شرارُها ؟؟",52,"ر",3,0],["أيكونُ الإرهابَ في صَدِّ باغٍ","مستبد وظالم مُستهينِ؟؟",53,"ن",1,0],["أيكونُ الإرهاب في نصر حقٍ","واحتكام إلى تعاليم دينِ؟!",53,"ن",1,0],["أي كف بالدعا تسعدني","وتواسي أحسن اللّه جزاها",54,"ا",3,0],["أَيكٌ إِذا ما رَجَّعَتْ","أَصواتُها رَجَعَتْ حَمائم",55,"م",1,0],["أي كأس من الجمال يصد ال","كأس عني ويمنع الظلم ظلما",56,"م",2,0],["أيكسر جفناً لحظهُ وهو صارمٌ","ويعطي أماناً أم يسوّ فنا أمنا",57,"ن",2,0],["أيكم تدعوه نخوته","للسخا حتى نجاريه",58,"ي",2,0],["أي كسب كماله اعتقادين ناقص","تحصيل كماله اجتهادين ناقص",59,"ص",1,1],["أيكرم مثوى ضيفكم وغريبكم","فيمكث أم تطوى ببين مراحله",60,"ل",2,0],["أَيَكُونُ رُزْءاً مِثْلَ رُزْءِ بَني الْوَرَى","إذْ ماتَ ذَاكَ العالِمُ المتَبَتِّلُ",61,"ل",1,0],["أَيَّكُم حاطَ ذا جِوارٍ بِعِزٍّ","قَبلَ أَن تَحتَويهِ مِنّا الدارُ",62,"ر",1,0],["أي كنت من قبل أني كنت لا معه","فلا تكن معه بل كن به تكنِ",63,"ن",1,1],["أَيُّ كتابٍ قد حوت سطُوره","جوداً جزيلاً بكلام جزل",64,"ل",1,0],["أَيُّ كَفٍّ مَا سوَّرتْها عَطَايا","هُ وعنقٍ مَا قُلِّدته عُقودُه",65,"د",2,0],["أيكون مِثْلي في الهَوى مُتَظلّماً","يَشْكو الزّمانَ وأنْتَ مِنْ حُكّامهِ",66,"م",2,0],["أَيَكونَ مِثلي شاعِراً وَأَكونُ مِن","لَم يَجتَذِبهُ مِنَ الوُجوهِ أَنيسَها",67,"س",3,0],["أيكةٌ كلُّ منزلٍ لسعيدٍ","فيه غُصنٌ منها برغمِ الحسودِ",68,"د",1,0],["أيكون وردك زاخراً متضرِّباً","ويُذاد عنه أطهرُ الوراد",69,"د",1,0],["أيكون كل فتى لآخر هادماً","ويريد نجوته من الزلزال",70,"ل",1,0],["أيكلفونك أن تضر وإنهم","لا يحملون عواقب الضّرار",71,"ر",1,0],["أيّ كلابٍ بلا سواجيرِ","وأيّ فُدْنٍ بغير ما نِيْرِ",72,"ر",1,1],["أيكفي بكائي ودمعي دماءُ","ومثلُك َيبكي عليهِ البكاءُ",73,"ا",2,1],["أيكتب من كان اليراع بكفه","شقياً وتوبُ العبد كالسيف للإِصرِ",74,"ر",1,0],["أيكون مأتمَ عالمٍ","ينهارُ في العدمِ الضرير",75,"ر",1,0],["إيكفي فيك مدحٌ بالقوافي","وشعري عاجزٌ مهما رضيت",76,"ت",1,0],["أيكفي شعوري بحب الشيوخ","ليكتب شعراً واحلى مقال",77,"ل",1,0],["أي كن مسكنا لثان في لمن","ثانية حذاء الاثنين دمن",78,"ن",1,0],["أي كرب ما حله اللطف عن مس","مسك من حب النبي بحبل",79,"ل",1,0],["ايكُ السَعادة أَينَعَت حينَ اِنجَلا","بَدر الوِزارة لِوَجه الرَحماه",80,"ا",2,1],["أيكسر خاطري يا أم ربي","لديك وأنت جابرة الكسير",81,"ر",1,0],["أَيَكون في الآداب مثلُكَ سابِقي","وَصَواهلي حازَت رِهان عَلاء",82,"ا",2,0],["ايكابدون من البوارج واللوا","عج ما اكابده انا واعاني",83,"ن",2,0],["أيكُونُ مَن أعطَى الكَمَالَ بِنَفسِهِ","ذَاكَ الكَمَالُ أذَاكَ ذُو إمكَانِ",84,"ن",1,0],["أيَكُونُ إنسَانٌ سَمِيعاً مُبصِراً","مُتَكَلِّماً بِمَشِيئَةٍ وَبَيَانِ",84,"ن",1,0],["أيكونُ حَيًّا سَامِعاً أو مُبصِراً","مِن غَيرِ مَا سَمعٍ وَغَيرِ عِيَانِ",84,"ن",1,0],["أيكونُ حقًّا ذا الدليلُ وما اهتدَى","خَيرُ القُرونِ لَهُ مُحالٌ ذَانِ",84,"ن",1,0],["أيكونُ أصلُ الدينِ ماتمَّ الهدَى","إلاَّ بِهِ وبهِ قُوَى الإِيمَانِ",84,"ن",1,0],["أيَكُونُ تَنزِيلاً وَلَيسَ كَلاَم مَن","فَوقَ العِبَادِ أذَاكَ ذُو إمكَانِ",84,"ن",1,0],["أيَكُونُ تَنزِيلاً مِنَ الرَّحمَنِ وَالرَّ","حمضنش لَيسَ مُبَاينَ الأكوَانِ",84,"ن",1,0],["أيَكُونُ ذَاكَ بِغيرِ حرفٍ أم بِلاَ","صَوتٍ فَهَذَا لَيسَ فِي الإمكَانِ",84,"ن",1,0],["أَي كَزينو الرَملِ مَعذِرَةً","قَد بَلَغنا وَيلَكَ الأَرَبا",85,"ب",2,0],["أيكونُ للجرسِ البقاءُ ولم يكنْ","لفتًى برى الباري له الأكوانا",86,"ن",2,0],["أَيّ كَوماء مِن كَرائم شدقم","تَتَرامى ما بَين أَكثبة الرم",87,"م",1,0],["أيكفيكمُ قتلٌ وقطعٌ لسارق","تعدّى ولولا الظلم ما كان مجرما",88,"م",2,0],["إيك انتهت آمالنا فارم ما دهى","بعزمك يدمغ هامة الباطل الحق",89,"ق",1,0],["أيكون الانسان أعقل ممن","قد براه هاتوا لنا البرهانا",90,"ن",2,0],["أيكو