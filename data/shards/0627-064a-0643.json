{"poems":[[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[88,"لنا ملك وليس له رعايا","https://www.aldiwan.net/poem44793.html","الوافر"],[88,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[88,"قل للحجابيين كيف ترونكم","https://www.aldiwan.net/poem44838.html","الكامل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[51,"أشجتك داعية مع الإشراق","https://www.aldiwan.net/poem65734.html","الكامل"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[91,"قال السماء كئيبة وتجهما","https://www.aldiwan.net/poem62735.html","عموديه"],[85,"لي سؤال يا أهل مصر فردوا","https://www.aldiwan.net/poem7543.html","الخفيف"],[85,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[85,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[43,"أنا عين المسود الجحجاح","https://www.aldiwan.net/poem9521.html","الخفيف"],[43,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[62,"أيكية صدحت شجوا على فنن","https://www.aldiwan.net/poem52263.html","البسيط"],[45,"أيكم سائل زري","https://www.aldiwan.net/poem62648.html","مجزوء الخفيف"],[45,"يا أخا الفضل والندى يا أبا العباس","https://www.aldiwan.net/poem66835.html","الخفيف"],[97,"أيكون ذنبي أن رفع","https://www.aldiwan.net/poem24919.html","مجزوء الكامل"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"لفعالك المذموم ريح حوابس","https://www.aldiwan.net/poem23322.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55062","الخفيف"],[106,"إلى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179547",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[67,"أسَمِعْتُمُ أنَّ الإلَه لحَاجَة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14543",""],[47,"أوصيك بالحزن ولا أوصيك بالجلد","https://www.poetsgate.com/ViewPoem.aspx?id=12902",""],[91,"عام 1910","https://www.poetsgate.com/ViewPoem.aspx?id=53146",""],[105,"أيكف شأوك أن يكون أماما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54863&r=&rc=33",""],[97,"ذنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63568&r=&rc=115",""],[197,"أيك العصافير والدنيا علي أسى","https://www.aldiwan.net/poem45344.html","البسيط"],[208,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[221,"أيكون الهوى ندى وملابا","https://www.aldiwan.net/poem39721.html","الخفيف"],[227,"جلت مساعي عن الفخر","https://www.aldiwan.net/poem51081.html","السريع"],[268,"يا طائرا في الدوح ناح","https://www.aldiwan.net/poem35201.html","مجزوء الكامل"],[268,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[268,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[301,"ولرب أشقر قال نبت عذاره","https://www.aldiwan.net/poem58028.html","الكامل"],[326,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[369,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[369,"أرأيت إن أخذ الغرام على يدي","https://www.aldiwan.net/poem57502.html","الكامل"],[397,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[397,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[400,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[429,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[462,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[462,"وألوى سبى جفني مغير جفونه","https://www.aldiwan.net/poem3354.html","عموديه"],[477,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[502,"أي كسب كماله اعتقادين ناقص","https://www.aldiwan.net/poem38132.html","عموديه"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[527,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[551,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[556,"أي كنت من قبل أني كنت لا معه","https://www.aldiwan.net/poem33802.html","البسيط"],[573,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[584,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"]],"verses":[["أَيَكونُ البَخيلُ غَيرَ بَخيلٍ","أَم يَكونُ الجَوادُ غَيرَ جَوادِ",0,"د",1,0],["أيكفينا من الدَولات أنّا","تُعلَّق في الديار لنا البُنود",1,"د",1,0],["أيكون ظِلَّ الله تاركُ حكمه ال","مَنْصوص في آي الكتاب المُنزل",2,"ل",1,0],["أيكون ما شرع النبي محمد","شيئاً يخالف شرعة التمدين",3,"ن",1,0],["أيكسر حالي بالجفاء وطالما","تعوَّدت من نعماك عاطفة الجبر",4,"ر",1,0],["أيكيَّةٌ تدعو بشجو إن دعا","ريب الزمان قرينها بفراق",5,"ق",1,0],["أَيَكونُ غاصِبَنا وَيَزعُمُ أَنَّهُ","أَمسى عَلَينا مُحسِناً مُتَصَدِّقا",6,"ق",2,0],["أَيَكونُ غَيرُكَ مُجرِماً وَتَبيتُ في","وَجَلٍ كَأَنَّكَ أَنتَ صِرتَ المُجرِما",7,"م",2,0],["أى كف قد باشرت صفع خدّ","فسمعنا دويَّها في الصعيد",8,"د",1,0],["أَيكي وَأَيكُكَ ضاحِكا","نِ عَلى خَمائِلِ مونبِلي",9,"ل",2,0],["أَيَكفُرُ بِالإِنجيلِ مَن تِلكَ كُتبُهُ","أَناجيلُ مِنها مُنذِرٌ وَبَشيرُ",10,"ر",1,0],["أَيَكونُ الهِجانُ غَيرَ هِجانٍ","أَم يَكونُ الصُراحُ غَيرَ صُراحِ",11,"ح",1,0],["أَي كَبتَ كُلِّ حاسِدٍ مُنافِقِ","أَنتَ لَنا وَكُلُّنا لِلخالِقِ",12,"ق",1,0],["أيكيَّةٌ صدحتْ شَجْواً على فَنَنٍ","فأشعلتْ ما خبا من نارِ أشجاني",13,"ي",1,1],["أَيُّكُم سائِلٌ زُرَي","قَةَ عَن حالِ بِنتِها",14,"ت",3,1],["أَيُّ كَفٍّ بَنانُها تَمطُرُ الإِحسا","نَ وَبلاً حَلَّت بِدارِ بَنانِ",15,"ن",1,0],["أيكون ذنبي أَن رفع","تُك وارتفعتُ إلى السماء",16,"ا",2,1],["أيكونَ ذنبي أن جعل","تُك فوق عرشٍ من سناء",16,"ا",2,0],["أيكون ذنبي أنني","بك أحتمي من كل داء",16,"ا",2,0],["أيكون ذنبي أن أرا","ك لخاطري قَبَساً أضاء",16,"ا",2,0],["أيكون ذنبي أن يُنا","طَ بك التعلُّلُ والرجاء",16,"ا",2,0],["أيكون ذنبي أن حب","بَك لي من الدنيا وِقاء",16,"ا",2,0],["أيكون ذنبي أيّ ذن","ب صار لي إلا الوفاء",16,"ا",2,0],["أَيُّ كَريمٍ يَرضى بِشَتمِ بَني","عَبدِ الكَريمِ الجِحاجِحِ النُجُبِ",17,"ب",1,0],["أيُّ كفٍّ لمْ تنلْ منها المنى","فبلاها اللهُ منهُ بالشللْ",18,"ل",1,0],["أيكون مَنْ كَرِهَ الضّلالَ لقومِه","وَوَفىَ لِربِّ العالمين مَلوما",19,"م",2,0],["أيكفرُ بعضُها فيفيضُ زَيْتاً","ويطغَى بعضُها ماءً وطيناً",20,"ن",2,0],["أَيَكُفُّ شَكوَكَ أَن يَكونَ أَماما","حَنِقٌ يَشُبُّ مِنَ الوَعيدِ ضِراما",21,"م",2,1],["أَيُّكم يا آل بَيت المُصطَفى","ما قَضى مُستشهداً مُنذُ عَلي",22,"ل",2,0],["أيَكونُ قَوْمٌ في الجَحِيمِ ويَصْطَفِي","منهم كَلِيماً رَبُّنا وخَلِيلا",23,"ل",2,0],["أَيَكُونُ مَنْ حَفِظَ الإلهُ مُضَيَّعاً","أَوْ مَنْ أُشِيدَ بِنَصْرِهِ مَخْذُولا",23,"ل",2,0],["أيكِيّةِ الذهَبِ المرصَّعِ رَفرَفَتْ","فيها حَمامٌ ما دَعَونَ هَديلا",24,"ل",2,0],["أَيَكونُ رَفعٌ لِلشُرورِ فَيَنتَهي","غاوٍ وَيَقنَعُ بِالنَباتِ الضَيغَمِ",25,"م",1,0],["أَيُّ كَمَالٍ وَجَمَالٍ يُرَى","كَمَا يُرَى فِي طَالِعِ الزَّهْرِ",26,"ر",1,0],["أَيَكُونُ مِنَّا كُلُّ حرٍ سَائِدٍ","وَسَوَادُنَا يَبْقَى أَذَلَّ سَوَادِ",27,"د",1,0],["أَيُّ كَفيلٍ أَعْمَى إِذَا قيلَ مَنْ","فِي الْقَوْم يَومَ الَّذي وَيَومَ التَّنَاد",28,"د",1,0],["أَي كَنْزٍ أَخْرَجْتَهُ فِي القَوَافِي","بَيْنَ جَزْلٍ نَظَمْتَهُ وَرَقِيقِ",29,"ق",1,0],["أيكفي الأرضَ نَورُك من بعيدِ","وأنَّك حولها أبدًا تدور؟",30,"ر",1,0],["أيكفي الأرضَ ومضٌ منك يَبْدُو","إذا ما الأَرضُ فَارَقَها النهار؟",31,"ر",1,0],["أيَكونُ قَوْمٌ في الجَحِيمِ ويَصْطَفِي","أو من أشيدَ بنصرهِ مخذولا؟",32,"ل",2,0],["أيكى بدمع له من حسرتى مدد","وأستريح إلى صبر بلا مدد",33,"د",1,0],["أيكون غاضبنا ويزعم أنّه","أمسى علينا محسنا متصدّقا",34,"ق",2,0],["أيكف شأوك أن يكون أماما","حنقٌ يشب من الوعيد ضراما",35,"م",2,1],["أيكون ذنبي أن أحبّكِ","لي من الدنيا وقِاءْ",36,"ا",2,0],["أيكُ العصافيرِ والدنيا عليَّ أسىً","أما تُرَوَّحُ عني بعضُ أحزاني",37,"ي",1,1],["أي كهف في حيكم من اتاه","فاز منه بظل روض انيق",38,"ق",1,0],["أَيَكون الهَوى نَدىً وَمَلابا","وَثِماراً جَنى الهَناء رِطابا",39,"ب",2,1],["أَيَكونُ الهَوى اِعصُرِ الصُبحَ وَاللَي","لَ شَراباً وَأَترِعِ الأَكوابا",39,"ب",2,0],["أَيَكونُ الهَوى اِقطُفِ الشَهدَ ما أَص","فى اللَيالي وَما أَلَذَّ اللُعابا",39,"ب",2,0],["أَيَكونُ الهَوى لَنا حُلُمُ الجَ","نَّةِ فَليَنفَرِط بِنا أَطيانا",39,"ن",2,0],["أيُّ كريمٍ لم يشِمْ شِميتي","وأيُّ عافٍ لم يَرِد بَحري",40,"ي",1,0],["أيكونُ مبسوطَ الجناح","كمثلِ مقصوصِ الجناح",41,"ح",1,0],["أيكونُ خدُّكِ رقّةً إبريسماً","ويكونُ طرفُكِ حدّةً فولاذا",42,"ذ",2,0],["أيكونُ منهم بعدَ ظلم نُفوسِهم","عَدلٌ وإنصافٌ لِمظلوميك",43,"ك",1,0],["أيكون طرسُ الخد من ياقوتةٍ","ويخط فيها الحسن إلا بالذهب",44,"ب",1,0],["أيّ كون محجّبُ الأسرار","خلف عينيك يا بنة الأقدار",45,"ر",1,0],["أيكونُ في جسمي فؤادٌ واحدٌ","فكأن جسمي في فؤادٍ واحِد",46,"د",1,0],["أيكونُ لومُك عند ذلك نافعي","أم مانعي أم مصلحي أم مفسدي",47,"ي",1,0],["أيكونُ نكرانُ الجميل جزاءها","منا ، فنرضى أن يسيء شرارُها ؟؟",48,"ر",3,0],["أيكونُ الإرهابَ في صَدِّ باغٍ","مستبد وظالم مُستهينِ؟؟",49,"ن",1,0],["أيكونُ الإرهاب في نصر حقٍ","واحتكام إلى تعاليم دينِ؟!",49,"ن",1,0],["أي كف بالدعا تسعدني","وتواسي أحسن اللّه جزاها",50,"ا",3,0],["أَيكٌ إِذا ما رَجَّعَتْ","أَصواتُها رَجَعَتْ حَمائم",51,"م",1,0],["أي كأس من الجمال يصد ال","كأس عني ويمنع الظلم ظلما",52,"م",2,0],["أيكسر جفناً لحظهُ وهو صارمٌ","ويعطي أماناً أم يسوّ فنا أمنا",53,"ن",2,0],["أيكم تدعوه نخوته","للسخا حتى نجاريه",54,"ي",2,0],["أي كسب كماله اعتقادين ناقص","تحصيل كماله اجتهادين ناقص",55,"ص",1,1],["أيكرم مثوى ضيفكم وغريبكم","فيمكث أم تطوى ببين مراحله",56,"ل",2,0],["أَيَكُونُ رُزْءاً مِثْلَ رُزْءِ بَني الْوَرَى","إذْ ماتَ ذَاكَ العالِمُ المتَبَتِّلُ",57,"ل",1,0],["أَيَّكُم حاطَ ذا جِوارٍ بِعِزٍّ","قَبلَ أَن تَحتَويهِ مِنّا الدارُ",58,"ر",1,0],["أي كنت من قبل أني كنت لا معه","فلا تكن معه بل كن به تكنِ",59,"ن",1,1],["أَيُّ كتابٍ قد حوت سطُوره","جوداً جزيلاً بكلام جزل",60,"ل",1,0],["أَيُّ كَفٍّ مَا سوَّرتْها عَطَايا","هُ وعنقٍ مَا قُلِّدته عُقودُه",61,"د",2,0],["أيكون مِثْلي في الهَوى مُتَظلّماً","يَشْكو الزّمانَ وأنْتَ مِنْ حُكّامهِ",62,"م",2,0]]}