{"poems":[[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[55,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[53,"صديق ليس يمكن من خطابه","https://www.aldiwan.net/poem8653.html","الوافر"],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[30,"شعثا قد انتزع القياد بطونها","https://www.aldiwan.net/poem5484.html","الكامل"],[68,"يا قابض المال الذي لم تزل","https://www.aldiwan.net/poem39516.html","السريع"],[107,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[50,"بباب بنية الوضاح ظبي","https://www.aldiwan.net/poem10410.html","الوافر"],[132,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[275,"أمن قتله العشاق خصرك ناحل","https://www.aldiwan.net/poem35358.html","الطويل"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[385,"فؤاد ملؤه ألم","https://www.aldiwan.net/poem49238.html","مجزوء الوافر"],[422,"إذا اضطرم البرق اليماني في الدجى","https://www.aldiwan.net/poem53836.html","الطويل"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[503,"مشت كالغصن يثنيه النسيم","https://www.aldiwan.net/poem3706.html","الوافر"],[556,"من شاء ان يعذلني في الهوى","https://www.aldiwan.net/poem47279.html","السريع"],[580,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[580,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63789","المنسرح"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62680","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62556","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95534","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202067","الرمل"],[2210,"","https://poetry.dctabudhabi.ae/diwan/poem/107082","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27866","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27566","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109410","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77331","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77293","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106862","الطويل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105402","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112529","الوافر"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128313","الوافر"],[3345,"","https://poetry.dctabudhabi.ae/diwan/poem/97850","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88983","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144494","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132004","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132151","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85141","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85119","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85140","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35512","السريع"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35516","الطويل"],[4116,"","https://poetry.dctabudhabi.ae/diwan/poem/177927","الطويل"],[4491,"","https://poetry.dctabudhabi.ae/diwan/poem/95747","الوافر"],[4691,"وشم بخاصرة الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=61390",""],[4699,"حبيبٌ باشتياقي لا يبالي","https://www.poetsgate.com/ViewPoem.aspx?id=154299",""],[4699,"ويبقى الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193392",""],[4764,"تعود قلبي اطعونك","https://www.poetsgate.com/ViewPoem.aspx?id=30111",""],[4829,"همسة شمالية","https://www.poetsgate.com/ViewPoem.aspx?id=34265",""],[4578,"بفاتر جفنه فتن البريا","https://www.poetsgate.com/ViewPoem.aspx?id=49617",""],[4958,"الشيءْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53952",""],[5431,"فإنّ الناس كلّهمُ طغاةُ!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200427",""],[5431,"سينقذنا همامٌ عنتريٌ ولا يخشى لعولمةٍ شِراكا","https://www.poetsgate.com/ViewPoem.aspx?id=201631",""],[327,"ألا هاج قلبي العام ظعنٌ بواكر","https://www.poetsgate.com/ViewPoem.aspx?id=3814",""],[5660,"أَرى في عُيوني وُجوهاً كَثيرَه","https://www.poetsgate.com/ViewPoem.aspx?id=23973",""],[5784,"قدر وظروف","https://www.poetsgate.com/ViewPoem.aspx?id=189765",""],[5838,"معتدل القامة مثل القضيب","https://www.poetsgate.com/ViewPoem.aspx?id=200858",""],[5879,"حماسيات (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215441",""],[5956,"يعذبنا الصهاين أيام عيشهم معنا في فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=202512",""],[5975,"الرسم الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=52992",""],[5988,"عاذلي بت نائما","https://www.poetsgate.com/ViewPoem.aspx?id=99722",""],[6002,"أَلاَ أَيُّهَا الْحَادِي تَرَنَّمْ وَزَمْزِمِ","https://www.poetsgate.com/ViewPoem.aspx?id=210297",""],[6068,"يعذلني أناس في هواها -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175894",""],[6068,"يعذبني التذكار رائعة البسم -14-","https://www.poetsgate.com/ViewPoem.aspx?id=177649",""],[6093,"عازف عود","https://www.poetsgate.com/ViewPoem.aspx?id=197105",""],[6152,"لك العهد الوثيق","https://www.poetsgate.com/ViewPoem.aspx?id=204876",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""],[6243,"موحَش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84432&r=&rc=6",""]],"verses":[["يَعذُلُني في الزَماعِ كُلُّ فَتىً","وَالسَيفُ إِن قَرَّ في الغُمودِ صَدي",0,"د",2,0],["يُعَذَّلُ أَحياناً وَيُعذَرُ مِثلَها","وَيُستَحسَنُ البادي بِهِ وَيُعابُ",1,"ب",1,0],["يُعَذِّبُّها عَضُّ السِوارِ بِمِعصَمٍ","أَبانَ لَها أَنَّ النَعيمَ عَذابُ",2,"ب",1,0],["يَعْذُبُ الطَّعْنُ فِي جَوَانِحِنَا","إِذْ تَكُونُ القُدُودُ مُرَّانَا",3,"ن",2,0],["يُعذِّبني وأصبرُ كلَّ يومٍ","فينقِمُ أن صبرتُ على عَذابِهْ",4,"ب",2,0],["يُعذّبُ قلبَ مَنْ يهوا","ه بين قطيعةٍ وصِلَهْ",5,"ل",2,0],["يعذُبُ الموردُ الذي يُستقى من","هُ ولا تعذبُ المِياهُ الطَّوامي",6,"م",2,0],["يَعُذنَ مِنهُ بِحُزّانِ المِتانِ وَقَد","فُرِّقنَ عَنهُ بِذي وَقعٍ وَآثارِ",7,"ر",1,0],["يُعَذِّبانِ عِبادَ اللَهِ في شُبَهٍ","وَيَذبَحانِ كَما ضَحَّيتَ بِالغَنَمِ",8,"م",1,0],["يَعذِمنَ وَهيَ مُصِرَّةٌ آذانَها","قَصَراتِ كُلِّ نَجيبَةٍ شِملالِ",9,"ل",1,0],["يَعذُبُ لي الإِحماضُ في قابِضٍ","حُلوٍ إِذا ما مَرَّ يُستَملَحُ",10,"ح",1,0],["يُعَذِّبُنِي لأتركَ دِينَ رَبِّي","إلى دينِ المآثِمِ والذُّنوبِ",11,"ب",1,0],["يَعذُبُ مَن يَشاءُ بِمُقلَتَيهِ","إِذا رَنَتا وَيَفعَلُ ما يَشاءُ",12,"ا",2,0],["يعذبُ فيها دائماً أبداً ولم","يجدْ وَزَراً يأوى إليه فَيَسْلَما",13,"م",2,0],["يعذرني شامتي عليه","يرق لي من جفاه من لا",14,"ل",2,0],["يُعذِّبهُ ردفٌ كنخسِ ضميرنا","وما التذَّ يا حسناءُ بالعيشِ قاتل",15,"ل",1,0],["يُعَذَّرُ ذو الدَينِ الطَلوبِ بِدَينِهِ","وَلَيسَ لِأَمرٍ يَظلِمُ الناسَ عاذِرُ",16,"ر",1,0],["يعذّبُهم جهلهم بالغيوب","ومُظلِمُها مُتنسيرٌ لديك",17,"ك",1,0],["يُعَذِّبُ أحبابه ظالماً","وما ذا على غادرٍ لو وَفى",18,"ا",1,0],["يُعَذِّبُ المُسلِمَ أَو لا فَلِم","أَلبَسَهُ الأَثوابَ رُهبانُ",19,"ن",1,0],["يُعَذِبُني بِلا ذَنب","وَيَجفوني وَيَنتَقم",20,"م",1,0],["يعذّب هذا الوجد منه فؤاده","وما ذاك إلاَّ ما جَنَتْه عيونه",21,"ن",2,0],["يَعذِر فيه المولى المُولِّي","شيئاً ولا يُعذَر الخليلُ",22,"ل",1,0],["يعذّبني إذا فكّرتُ فيه","ويُتعبُها إذا راحَت تقومُ",23,"م",1,0],["يعذلني في ذا الهوى فارغٌ","وطافحٌ قلبِيَ من شُغلهِ",24,"ل",2,0],["يعذُر الناس من تكونُ له أُمّاً","إِذا ما ازْدَهَى على الآباءِ",25,"ا",2,0],["يعذِلُني رخيمُه","في شادنٍ رَخيم",26,"م",1,0],["يعذبن قلبي والشباب شفيعه","فكيف وساعي الشيب فيه سعى لها",27,"ل",3,0],["يَعْذِرني الناسُ في محبّته","ولستُ في غيرِه بمعذور",28,"ر",1,0],["يعذله في حب مستقبح","وعاذر محبوبه ظاهر",29,"ر",1,0],["يعذلني في حبِّ مَنْ وجهها","غار على الليل بضوء الصباحْ",30,"ح",1,0],["يعذب الشعرُ إن رواه الوفاء","واحتواه من الولاء الرواءُ",31,"ا",2,1],["يعذب الماء لصاد باسمه","وتعود النار بردا وسلاما",32,"م",2,0],["يعذرني صحبي إذا","اخترت الفنا أو الفلا",33,"ل",2,0],["يعذب الله بها عبدَه","إذا يشاء وبها يرحم",34,"م",1,0],["يعذبنا النهار سُدى وويلاً","وليلته يعذبنا نداها",35,"ا",3,0],["يعذر الشاعر يوماً ان هجا","كل من لانفع منه يرتجى",36,"ج",2,1],["يُعَذَّبونَ عَلى الإِسلامِ مِن سَفَهٍ","وَيُفتَنونَ عَنِ التَوحيدِ مِن لَمَمِ",37,"م",1,0],["يُعَذِّبُهُ بُعدُ الحَبيبِ فَإِن دَنا","بِهِ وَطَرٌ يُزري بِشيمَتِهِ عَفّا",38,"ف",2,0],["يعذبها الجسمُ الذي أصلُه الثرى","بها في النوى داءٌ وذلك داءُ",39,"ا",2,0],["يعذب اللوم فيك وهو عذاب","فلتلمني بحبك اللوام",40,"م",1,0],["يعذبه عبادك كل يوم","ويصلى الضيم حينا بعد حين",41,"ن",1,0],["يعذّب أهله في القرص حتى","يظّلوا منه في يوم عصيب",42,"ب",1,0],["يعذلني عاذلي عليك ولا","يحصل مني إلا على العتب",43,"ب",1,1],["يعذبني ويسألني مناه","ومع هذا لأفديه مجابا",44,"ب",2,0],["يعْذُبُ الورْدُ فيهِ وهْوَ عذابٌ","مُرْسَلٌ للغَليلِ في القلْبِ حابِسْ",45,"س",1,0],["يعذب الإسهاب من ألفاظه","ومن الغير يمل الاختصارُ",46,"ر",1,0],["يعذبها عذابا مستطيرا","ودمع العين منهمر غزير",47,"ر",1,0],["يعذر المهمل في واجبه","ولقد ينفحه آي الثناء",48,"ا",2,0],["يعذبني والغير يحظى بوصله","وما وصله إلا اجتلاء لشكله",49,"ه",1,0],["يعذبه بأنوا الجفاء","ليعلم كيفما نقض العهود",50,"د",1,0],["يعذبني والغير يحظى بوصله","وما وصله إلا الحديث الذي أشا",51,"ش",2,0],["يُعذِّب القَلبَ بِهجرانِه","وَلَيس للقَلبِ سِواه اِنشِراح",52,"ح",1,0],["يَعذّب طرفي حينَ يَلحَظ وَجهَهُ","وَينعم سَمعي دُونَهُ عِندَما يَشدو",53,"د",2,0],["يعذب قلبي ظالماً عذب ظلمه","ولكن تعذيبي لمرشفه عذب",54,"ب",1,0],["يُعذِّبني إذا فكَّرتُ فيه","وَيُتعِبها إذا رامت تَقوم",55,"م",1,0],["يعذبني ما الحُلوُ ينوي لي َ الشقا","ولكن بما لم ينوه ِ لي يعذّبُ",56,"ب",1,0],["يعذبني .. ويعلم ما بقلبي","وما أرجو وما يرنو ببالي",57,"ل",2,0],["يعذبني الحنينُ بغيرِ رفقِ","ويغدو الكونُ في عينيَّ قفرا",58,"ر",2,0],["يعذبني ،، بلا رحمه ،، وشمسي قَبلها تَغرب","قَبل لا تَبرز أحلامي بِخفه بينِ جَفنيني",59,"ن",2,0],["يعذب قلبي وتصرخ سوادة قلبي تزعيقه","جفولك عن دروب الشوق ماجيتي ممرّاته",60,"ت",2,0],["يعذب دون عذب الورد منه","فؤاداً ليس يرضى بالدنيه",61,"ي",2,0],["يُعَذِّبُكَ الْخَيارُ والاْخْتِيارُ","فَإِنَّ كِلا البَديلَيْنِ انْتِحارُ",62,"ر",1,1],["يعذبنا زمانٌ مستبدٌ","ويجلدنا التغرّبُ والشتاتُ",63,"ا",2,0],["يُعذّبني اليباسُ إذا اعتراكا","فأجعلني غمائمَ في مداكا",64,"ك",2,1],["يُعَذَّرُ ذو الدَّيْنِ الطلوبُ بِدَيْنهِ","وليس لأمر يظلنم الناس عاذر",65,"ر",1,0],["يُعَذِّبُ مِنّي الفُؤادَ هَواكِ","وَ أَنتِ مُنَعَّمَةٌ يا أَميرَه",66,"ر",2,0],["يعذبني الحرف حسا وفكرا","ويجلدني ليقال طريف",67,"ف",1,0],["يعذلنىّ فيه جميع الورى","كأنني جئت بأمر عجيب",68,"ب",1,0],["يعذب الحسنَ نبضٌ لا يجامله","ويقهر الحسنُ نبضا ظلّ يعليه",69,"ي",2,0],["يعذبنا الصهاينُ من سماحٍ","دَفقناه عليهم كالنهورِ",70,"ر",1,1],["يعذبني التغرُّبُ عنكِ حتى","نذرتُ إليكِ منِّي ما تبقّى",71,"ق",2,0],["يعذر العاشقين من","كان بالحب عالما",72,"م",2,0],["يُعَذَّبُ طَوْرًا بِالْعُذَيْبِ وَتَارَةً","يُنَعَّمُ في التَّنْعِيمِ أَيَّ تَنَعُّمِ",73,"م",1,0],["يعذلني أناس في هواها","وكلّ الحبّ معناه رضاها",74,"ا",3,1],["يعذبني التذكار رائعة البسم","وماجدة الأنساب في الخال والعم",75,"م",1,1],["يُعَذِّبُنِيْ بِالصَّدِّ والهَجْرِ لاهِيًا","كَعَازِفِ عُوْدٍ عَذَّبَ العُوْدَ وَ انْتَشَى",76,"ش",2,1],["يعذبني الحنين إليكِ ليلا","وعند الصبح يملؤني ارتجافا",77,"ف",2,0],["يَعذُبُ الموت في ضفاف الغواني","إنما الموت في المشانق أعذبُ",78,"ب",1,0],["يَعْذ ُب الهمْس كلّما نام بعْضي","في ضفاف تَمُرّ فيها الخيول ُ",79,"ل",1,0]]}