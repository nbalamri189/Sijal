{"poems":[[57,"علي ثياب لو تباع جميعها","https://www.aldiwan.net/poem24695.html","الطويل"],[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[37,"ولما احلوني بصلعاء صيلم","https://www.aldiwan.net/poem7421.html","الطويل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[51,"قلت لخود ضفتها مرة","https://www.aldiwan.net/poem65392.html","السريع"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[44,"كفاني من حوادث كل دهر","https://www.aldiwan.net/poem30498.html","الوافر"],[105,"علينا لك الحق الذي أنت تعلم","https://www.aldiwan.net/poem42049.html","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[90,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[111,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[182,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[223,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[235,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[237,"ليس لنا في سوى ابن الحاج من حاج","https://www.aldiwan.net/poem18115.html","البسيط"],[275,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[275,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[380,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[410,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[416,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[416,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[461,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[461,"تمارح أنضاء السرى عجرفية","https://www.aldiwan.net/poem15469.html","الطويل"],[461,"تدل عليه عبقة هاشمية","https://www.aldiwan.net/poem15654.html","الطويل"],[477,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"]],"verses":[["عَلَيَّ ثِيابٌ لَو تُباعُ جَميعُها","بِفَلسٍ لَكانَ الفَلسُ مِنهُنَّ أَكثَرا",0,"ر",2,1],["عَلى ثَلاثٍ باقِياتٍ سودِ","وَغَيرَ باقي مَلعَبِ الوَليدِ",1,"د",1,0],["علي ثياب الغانيات وتحتها","عزيمة أمر أشبهت سلَّة النصل",2,"ل",1,0],["على ثقةٍ بأن لها لديه","مُناخاً بالسعادة غير شأس",3,"س",1,0],["على ثلاث ضيفكم قائماً","فهل تقومون على أربع",4,"ع",1,0],["على ثقةٍ بأنْ سترَى وترعى","ربيعاً للطَّليح به مَسامُ",5,"م",1,0],["عَلى ثِقَةٍ وَأَنتَ لِذاكَ أَهلٌ","أَخَذتُ بِحَبلِ ذِمَّتِكَ اِختِيارا",6,"ر",2,0],["على ثِقَةٍ بالله أرجوه وحده","وأعلم أنّ الله أعلى وأعظمُ",7,"م",1,0],["على ثقةٍ من ناصر الدين أنه","سينصرُ منك الحقّ خيرُ نصير",8,"ر",1,0],["على ثقةٍ أنْ لستَ في الناس واجداً","على مِثله – إلاَّ القليلَ – مُناصراً",9,"ر",2,0],["على ثقةٍ أنَّ الحياةَ تَراوُحٌ","نسائمُها جوّالةٌ والسمائم",10,"م",1,0],["عَلى ثَلاثَةٍ يدورُ الجَبرُ","المالُ والأعدادُ ثُمَّ الجذرُ",11,"ر",1,0],["عَلى ثَراك غَوادي الصُبحِ تَنهَمرُ","يا راحِلاً تَحتَ ظلِّ اللَّهِ يَستَتِرُ",12,"ر",1,1],["عَلى ثَغرِهِ بَسَماتُ الرَبيعِ","وَفي قَلبِهِ بَسَماتٌ أُخَر",13,"ر",1,0],["عَلى ثِقَةٍ أَنَّهُ لَيسَ بِال","مُحَصَّلِ مِنها سِوى ما ذَهَب",14,"ب",1,0],["عَلَى ثَرَاهُ سَلاَمٌ فَائِحٌ عَبِقٌ","وَرَحْمَةُ اللهِ تَغْشَاهُ بِأَفْوَاجِ",15,"ج",1,0],["عَلى ثِقَةٍ مِن فَيْضِ راحَتِهِ الوَرى","إِذا صَدَقَ الإمْحَالُ فاتَّهَموا المُزْنا",16,"ن",2,0],["على ثِقَةٍ مِن عَطفِها وقَبولِها","نَصيحَةَ كافٍ أو كِفايَة ناصِح",17,"ح",1,0],["عَلى ثِقَة بِاتلافي وَعلم","أحبك بِاختياري لا بِرَغمي",18,"ي",1,1],["عَلى ثِقَةٍ أَلقَت إِلَيكَ أُمورَها","قُرَيشٌ كَما أَلقى عَصاهُ المُسافِرُ",19,"ر",1,0],["على ثقةٍ بالنَّيْل ممَّا يرومُه","يُعاني السّرى ليلاً ويطوي الفيافيا",20,"ي",2,0],["على ثقة منه بما أنتَ أهلهُ","وما كانَ إلاَّ في جنابك واثقا",21,"ق",2,0],["على ثرىً لا يُنبِت العزَّ ولا","يكون للحرّ الكريم مَنزلا",22,"ل",2,0],["على ثقةٍ أنَّ المُناخَ بمخْصِبٍ","يعيش به ركبٌ وتُحمى رواحلُ",23,"ل",1,0],["على ثقةٍ أنَّ الطَّراديَّ ضامِنٌ","غنى أسْنِماتٍ عُرِّيتْ وغواربِ",24,"ب",1,0],["على ثقةٍ أني المُشارُ وأنني","بديعُ المعاني الرائقاتِ غَريبُها",25,"ب",3,0],["على ثرًى أُخْلِفَ مِن","رىَّ الغمامِ موعدُه",26,"د",2,0],["على ثَرىً حَلَّهُ غريبُ رسو","لِ اللَّهِ مَجْرُوحةٌ جَوَارِحُهْ",27,"ح",2,0]]}