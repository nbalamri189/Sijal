{"poems":[[59,"علي ثياب لو تباع جميعها","https://www.aldiwan.net/poem24695.html","الطويل"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[39,"ولما احلوني بصلعاء صيلم","https://www.aldiwan.net/poem7421.html","الطويل"],[53,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[53,"قلت لخود ضفتها مرة","https://www.aldiwan.net/poem65392.html","السريع"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[46,"كفاني من حوادث كل دهر","https://www.aldiwan.net/poem30498.html","الوافر"],[107,"علينا لك الحق الذي أنت تعلم","https://www.aldiwan.net/poem42049.html","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[92,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[186,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[228,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[240,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[242,"ليس لنا في سوى ابن الحاج من حاج","https://www.aldiwan.net/poem18115.html","البسيط"],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[280,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[385,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[416,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[422,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[422,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[466,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[466,"تمارح أنضاء السرى عجرفية","https://www.aldiwan.net/poem15469.html","الطويل"],[466,"تدل عليه عبقة هاشمية","https://www.aldiwan.net/poem15654.html","الطويل"],[482,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[572,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66799","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64077","المنسرح"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67839","الطويل"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/112983","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124699","الطويل"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131419","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35739","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108784","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71082","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147332","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68028","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117962","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106737","المتقارب"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33425","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[4888,"على شط الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=207741",""],[5431,"على ثغرِ مزمار الرياح معلّقُ","https://www.poetsgate.com/ViewPoem.aspx?id=195131",""],[5493,"إلى المنفى أعود","https://www.poetsgate.com/ViewPoem.aspx?id=197216",""],[5574,"إلى أبطال الحدّ الجنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=206008",""],[5595,"عليٌّ أصلهُ نسبُ النبيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=144759",""],[6019,"رحيقُ الوفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=120903",""],[6019,"إطلالةٌ عابرة","https://www.poetsgate.com/ViewPoem.aspx?id=177790",""]],"verses":[["عَلَيَّ ثِيابٌ لَو تُباعُ جَميعُها","بِفَلسٍ لَكانَ الفَلسُ مِنهُنَّ أَكثَرا",0,"ر",2,1],["عَلى ثَلاثٍ باقِياتٍ سودِ","وَغَيرَ باقي مَلعَبِ الوَليدِ",1,"د",1,0],["علي ثياب الغانيات وتحتها","عزيمة أمر أشبهت سلَّة النصل",2,"ل",1,0],["على ثقةٍ بأن لها لديه","مُناخاً بالسعادة غير شأس",3,"س",1,0],["على ثلاث ضيفكم قائماً","فهل تقومون على أربع",4,"ع",1,0],["على ثقةٍ بأنْ سترَى وترعى","ربيعاً للطَّليح به مَسامُ",5,"م",1,0],["عَلى ثِقَةٍ وَأَنتَ لِذاكَ أَهلٌ","أَخَذتُ بِحَبلِ ذِمَّتِكَ اِختِيارا",6,"ر",2,0],["على ثِقَةٍ بالله أرجوه وحده","وأعلم أنّ الله أعلى وأعظمُ",7,"م",1,0],["على ثقةٍ من ناصر الدين أنه","سينصرُ منك الحقّ خيرُ نصير",8,"ر",1,0],["على ثقةٍ أنْ لستَ في الناس واجداً","على مِثله – إلاَّ القليلَ – مُناصراً",9,"ر",2,0],["على ثقةٍ أنَّ الحياةَ تَراوُحٌ","نسائمُها جوّالةٌ والسمائم",10,"م",1,0],["عَلى ثَلاثَةٍ يدورُ الجَبرُ","المالُ والأعدادُ ثُمَّ الجذرُ",11,"ر",1,0],["عَلى ثَراك غَوادي الصُبحِ تَنهَمرُ","يا راحِلاً تَحتَ ظلِّ اللَّهِ يَستَتِرُ",12,"ر",1,1],["عَلى ثَغرِهِ بَسَماتُ الرَبيعِ","وَفي قَلبِهِ بَسَماتٌ أُخَر",13,"ر",1,0],["عَلى ثِقَةٍ أَنَّهُ لَيسَ بِال","مُحَصَّلِ مِنها سِوى ما ذَهَب",14,"ب",1,0],["عَلَى ثَرَاهُ سَلاَمٌ فَائِحٌ عَبِقٌ","وَرَحْمَةُ اللهِ تَغْشَاهُ بِأَفْوَاجِ",15,"ج",1,0],["عَلى ثِقَةٍ مِن فَيْضِ راحَتِهِ الوَرى","إِذا صَدَقَ الإمْحَالُ فاتَّهَموا المُزْنا",16,"ن",2,0],["على ثِقَةٍ مِن عَطفِها وقَبولِها","نَصيحَةَ كافٍ أو كِفايَة ناصِح",17,"ح",1,0],["عَلى ثِقَة بِاتلافي وَعلم","أحبك بِاختياري لا بِرَغمي",18,"م",2,1],["عَلى ثِقَةٍ أَلقَت إِلَيكَ أُمورَها","قُرَيشٌ كَما أَلقى عَصاهُ المُسافِرُ",19,"ر",1,0],["على ثقةٍ بالنَّيْل ممَّا يرومُه","يُعاني السّرى ليلاً ويطوي الفيافيا",20,"ي",2,0],["على ثقة منه بما أنتَ أهلهُ","وما كانَ إلاَّ في جنابك واثقا",21,"ق",2,0],["على ثرىً لا يُنبِت العزَّ ولا","يكون للحرّ الكريم مَنزلا",22,"ل",2,0],["على ثقةٍ أنَّ المُناخَ بمخْصِبٍ","يعيش به ركبٌ وتُحمى رواحلُ",23,"ل",1,0],["على ثقةٍ أنَّ الطَّراديَّ ضامِنٌ","غنى أسْنِماتٍ عُرِّيتْ وغواربِ",24,"ب",1,0],["على ثقةٍ أني المُشارُ وأنني","بديعُ المعاني الرائقاتِ غَريبُها",25,"ب",3,0],["على ثرًى أُخْلِفَ مِن","رىَّ الغمامِ موعدُه",26,"د",2,0],["على ثَرىً حَلَّهُ غريبُ رسو","لِ اللَّهِ مَجْرُوحةٌ جَوَارِحُهْ",27,"ح",2,0],["علىٌّ ثامنٌ والقبرُ منهُ","بأرضِ الطّوسِ إن قَحَطوا رِهامُ",28,"م",1,0],["على ثيابي خطٌّ حوافِرُهُ","أقلامُهُ والمحابرُ الطرق",29,"ق",1,0],["عَلىَ ثقة مِنَّا بِصِدْقِ وَلائِهِ","فَجَادَ عَلَيْنَا مِنْ جَزِيلِ عَطَائِهِ",30,"ه",1,0],["عليَّ ثيابٌ فوق قيمتها الفلسُ","وفيهن نفس دون قيمتها الإنسُ",31,"س",1,1],["عَلى ثُلوج وَقَعت كَثيره","في لَيلة بارِدة مطيره",32,"ه",1,0],["على ثغرك الظمآن ذكرى من الهوى","مجمرة الأعصاب محرورة الدم",33,"م",1,1],["على ثقةٍ منا تحِنَّ قلوبنا","إليك كما كنّا أباك نؤمّل",34,"ل",1,0],["عَلى ثِقَةٍ بِالمَنزِلِ الرَحبِ وَالغِنى","لَدَيكَ وأَحواضٍ غِزارٍ بُحورُها",35,"ر",3,0],["على ثغر من أهواه للآس آيةٌ","تقول اعرفوا قدري وقولوا لعاشقي",36,"ي",1,1],["على ثِقَةٍ أَنَّ الزمان إِذا عَرَى","بخَطْبٍ جَرَى من بعده فأَدالا",37,"ل",2,0],["عَلَى ثَكَنَاتِ الوَردِ رِيحٌ تَشُدُّنِي","لِرَفْرَفَةِ الأَسرَابِ نَرْجِسَ قِبْلَتِي",38,"ي",1,1],["على ثغر دمياط بهُ منَّ فاضياً","فحاز به به فضلاً على الغير زائدا",39,"د",2,0],["عَلَى ثَفِنات البين أجثو وإنني","أَحنُّ وهل يَشْفي المحبَّ حنين",40,"ن",1,0],["على ثقة مني وعلم بأنه","على كل حال رأيه الأصوب الأعلا",41,"ل",2,0],["عَلى ثِقَةٍ مِن بُلوغِ النَجاحِ","وَلَم تَضرِبِ التيهَ ضَربَ القِمارِ",42,"ر",1,0],["على ثقةٍ إنِّي نحيلٌ ومدنف","صددت وأن الناسَ بي فيكَ أعرَفُ",43,"ف",1,1],["على ثلث مليون اناف عديدهم","وكل له في الحرب مشية مختال",44,"ل",1,0],["على ثغرِها من عُنْصِرِ المجدِ صَخْرَةٌ","عليها تهاوى مَطْمَعُ السُّفهاءِ",45,"ا",2,0],["على ثغرِ مزمار الرياح معلّقُ","أطيرُ إذا غنى إليه أحلّقُ",46,"ق",1,1],["على ثوبي القديمِ غبارُ ذكرى","تحيط بها من الخوفِ الرعودُ",47,"د",1,0],["٤- على ثغْرِ الرّدى صعدوا","لهم ذابتْ جلاميدُ",48,"د",1,0],["عليٌّ ثابتُ القول ِ عليّاً","كبيرُ الشأنِ تغريه المعالي",49,"ل",2,0],["على ثغركَ البسماتُ تنداحُ غيمةً","بها تُنبتُ الرَّيحانَ في يابس الصحرا",50,"ر",2,0],["..على ثغري بقاياها غَمامٌ","ومازالتْ على شفتيَّ بسمَةْ",51,"م",2,0]]}