{"poems":[[65,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[73,"إلى لحية المرء اللعين ارتقت","https://www.aldiwan.net/poem3806.html","الطويل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[45,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[45,"أريقك أم ماء الغمامة أم خمر","https://www.aldiwan.net/poem9572.html","الطويل"],[47,"سفاها تمادى لومها ولجاجها","https://www.aldiwan.net/poem62680.html","الطويل"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[99,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[99,"تشكين في حبي لك الحق إنني","https://www.aldiwan.net/poem24915.html","الطويل"],[18,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[35,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[48,"أما وفؤاد بالغرام قريح","https://www.aldiwan.net/poem22295.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42710","الوافر"],[113,"اليلتنا هذي حكيت لياليا","https://www.aldiwan.net/poem16623.html","الطويل"],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[124,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[176,"صوت صفير البلبل","https://www.aldiwan.net/poem26279.html","مجزوء الرجز"],[215,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[254,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[287,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[302,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[384,"يا أسم أسقاك البريق الوامض","https://www.aldiwan.net/poem4560.html","الرجز"],[409,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[447,"بمثوى مسقط طال الثواء","https://www.aldiwan.net/poem14294.html","الوافر"],[447,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[447,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[463,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[471,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[500,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[541,"أشاقك من عهد الخليط مغان","https://www.aldiwan.net/poem23856.html","الطويل"],[556,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[569,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[580,"وليلة وصل راقبت غفلة الدهر","https://www.aldiwan.net/poem2955.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64157","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38927","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49949","الطويل"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105238","الوافر"],[2206,"","https://poetry.dctabudhabi.ae/diwan/poem/146666","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27882","البسيط"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202675","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116502","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65966","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204635","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74061","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205905","المتقارب"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85127","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85243","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59465","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78231","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136914",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127205","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94389","الوافر"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107141","البسيط"],[4767,"شباب الطف","https://www.poetsgate.com/ViewPoem.aspx?id=199910",""],[4816,"اهداء للصديق سعيد الحجري","https://www.poetsgate.com/ViewPoem.aspx?id=199475",""],[5155,"الوحده العربيه","https://www.poetsgate.com/ViewPoem.aspx?id=176192",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5199,"رابطة عبس العالميه","https://www.poetsgate.com/ViewPoem.aspx?id=150974",""],[5285,"محض اختيار","https://www.poetsgate.com/ViewPoem.aspx?id=203580",""],[5431,"الرحمى ....","https://www.poetsgate.com/ViewPoem.aspx?id=215240",""],[5488,"يابارق من جدا الشرق سناي","https://www.poetsgate.com/ViewPoem.aspx?id=100728",""],[5525,"صرخة بلا فم","https://www.poetsgate.com/ViewPoem.aspx?id=967",""],[5533,"لَيَالي الشَّوْق","https://www.poetsgate.com/ViewPoem.aspx?id=186685",""],[5561,"بلاء الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=196888",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5652,"سمسر جميل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192041",""],[5727,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=206473",""],[5873,"لوحة المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=215792",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""]],"verses":[["أَلَيلَتَنا بِالحَزْنِ عودي فَإِنَّني","أُطامِنُ أَحشائي عَلى لَوعَةِ الحُزْنِ",0,"ن",1,1],["إِلى لِحيَةِ المَرءِ اللَعينِ اِرتَقَت يَدٌ","لَها في صُعودِ الحادِثاتِ سُعودُ",1,"د",1,1],["إِلى لَوائِحَ مِن أَطلالِ أَحوِيَةٍ","كَأَنَّها خِلَلٌ مَوشِيَّةٌ قُشُبُ",2,"ب",1,0],["إلى لغات جمه","لأن فيها حكمه",3,"ه",1,0],["إِلَيَّ لَعَمري قَصدُ كُلِّ عَجيبَةٍ","كَأَنّي عَجيبٌ في عُيونِ العَجائِبِ",4,"ب",1,0],["إِلى لَيثِ حَربٍ يُلحِمُ اللَيثَ سَيفُهُ","وَبَحرِ نَدىً في مَوجِهِ يَغرَقُ البَحرُ",5,"ر",1,0],["إِلى لَيلَةٍ إِمّا سُراها مُبَلِّغي","أُجاوِدَ إِخواني وَإِمّا ادِّلاجُها",6,"ج",3,0],["أَلَيلَتَنا الطولى بِطِمّينَ هَل لَنا","سَبيلٌ إِلى اللَيلِ القَصيرِ بِبابِلا",7,"ل",2,0],["أليلاىَ ما أبقَى الهوى فيَّ من رُشدِ","فردِّي على المشتاقِ مهجتَه ردِّي",8,"د",2,1],["أليلايَ حُبِّي فيك حُبُّ مُوَحِّدٍ","تَنَزَّهَ عن ريبٍ وجلَّ عن الشِّرك",9,"ك",1,0],["أَلَيلَتَنا بِذي حُسُمٍ أَنيري","إِذا أَنتِ اِنقَضَيتِ فَلا تَحوري",10,"ر",2,1],["أَلَيلى بِأَبوابِ الخُدورِ تَعَرَّضَت","لِعَينِيَ أَم قَرنٌ مِنَ الشَمسِ طالِعُ",11,"ع",1,0],["أليلَتَنا إذ أرْسَلَتْ وارداً وَحْفَا","وبتنا نرى الجوزْاءَ في أُذنِها شَنفا",12,"ف",2,1],["أَلَيلى وَكُلٌّ أَصبَحَ اِبنَ مُلَوَّحٍ","وَلُبنى وَما فينا سِوى ابنِ ذَريحِ",13,"ح",1,0],["اليلةٌ ما مرَّ أم ليلتانْ","إبقَيْ معي حتى يلوح السَحَرْ",14,"ر",1,0],["أَلَيْلَى مَا لِقَلْبِكِ لَيْسَ يَرْثِي","لِمَا أَلْقَاهُ مِنْ أَلَمِ الْفِرَاقِ",15,"ق",1,1],["اليلتنا هَذي حَكَيت لَيالياً","مَضين وَشَملي بِالأَحبة جامِعُ",16,"ع",1,1],["أليلاي كم من ليلة طال ليلها","ينام الخلي البال فيها واسهر",17,"ر",1,0],["أليلتان جزائي منك أجلهما","بعدٌ على حسرات إثر إحسان",18,"ن",1,0],["إِلَى لِقَاءِ مَلِكٍ","مُعَظَّمٍ مُبَجَّلِ",19,"ل",1,0],["أليلةُ عيد تلك واها وآهة","إذا كانت الآهاتُ في الخوف تنفع",20,"ع",1,0],["أَلَيلى عَلى شَحطِ المَزارِ تَذَكَّرُ","وَمِن دونِ لَيلى ذو بِحارٍ وَمَنوَرُ",21,"ر",1,1],["إِلى لَماهُ اِرتِياحُ الروحِ مُنبَعِثٌ","كَأَنَّ أَنفاسَهُ روحٌ وَرَيحانُ",22,"ن",1,0],["أَلَيلَةُ الحَشرِ لا بَل يَومُ عاشور","وَنَفخَةُ الصُّورِ لا بل نفثُ مصدورِ",23,"ر",1,1],["اليل بين قنوين رابض","بجيزة الوادي قطا نوهض",24,"ض",1,0],["إلى لقاء اللّه سبحانه","عند فراق العبد دار الزوال",25,"ل",1,0],["إلى ليلى الشريفة حن قلبي","وأنى لي على البعد اللقاء",26,"ا",2,0],["أليلتنا بالأمس عودي","ليورق بعد يبس الغصن عودي",27,"د",2,0],["أليلى سهرت عليك الليالي","إذا لاح لي النجم بت حليفه",28,"ف",2,0],["أليلَ سوادي ما أرى الصبحَ سَرّني","فمن ردَّ لي ذاك الظلامَ فأغسقا",29,"ق",2,0],["أَلَيلى اِحذَري نَقضَ القِوى لا يَزَل","عَلى النَأيِ وَالهِجرانِ مِنكِ نَصيبُ",30,"ب",1,0],["أليلتنا بين العتابين والعذرِ","أليلة عذر كنت أم بيضة العقر",31,"ر",1,1],["إِلى لُطفِهِ بِالمُؤمِنينَ وَنَصرِهِ","لَهُم وَتَوَلّى الخَذلُ كُلَّ هِدانِ",32,"ن",1,0],["ألَيْلَتَنا بكاظمةٍ أضِلِّي","بياضَكِ أنْ يلمّ بنا ضلالا",33,"ل",2,0],["أليلى ما لأهلك أسلموك","ومثلك لا يعار ولا يباع",34,"ع",1,0],["أَليلتَنَا إِن لم تكونِي عبَارة","وحقِّك عن عُمرٍ فَدَيْتُكِ بالعُمْر",35,"ر",1,0],["إلى لازودٍ وفيروزجٍ","وماذينج اللون إِسرنجِه",36,"ج",2,0],["إِلَيّ لَقَد أَهدى رَداحاً بِفَضلِها","يقرّ أَخو فَضل خَبير وَعارفُ",37,"ف",1,0],["إلى لغاية معا ظرف كمع","في عند لام زد وتبيينا يقع",38,"ع",1,0],["إِلَى لَمُوحَينِ بألحَاظِ اللأى","مُرادُهُ مِن ذِي رُعَينٍ حَجرُهُ",39,"ه",1,0],["أَليليَ أم ليلُ السّليم المسَهَّدِ","فَما بتّه إلاَّ بمقلة أَرمَدِ",40,"د",1,1],["أليلتا بجرعاء المصلّى","رعاك اللَه كم لك من أياد",41,"د",1,1],["أليلة يوم البين ما كنت ليلةً","ولكن ليال قد خلقن بلا فجر",42,"ر",1,1],["إلى لمقامِ الذي ما عنده عرض","أيضاً ويعصمه من على الحَرَض",43,"ض",1,0],["أليل النوى هل من سبيل إلى فجر","ويا قلب كم تأسى ويا دمع كم تجري",44,"ر",2,1],["الى لا الى ان شاء من شاء عزمنا","وما ثم في الاقوام شخص مؤجر",45,"ر",1,0],["إِليّ لكي يأتي إليه وإننا","مضينا إليه قاصدين نسارع",46,"ع",1,0],["أليلي طلت وانطفأ السراج","ولا جيران لي الا الدجاج",47,"ج",1,1],["أليلة القدر به أضاءت","باسمة عن ثغره الشهيّ",48,"ي",1,0],["أَليلة الجمعة تلك الَّتي","أَنم فيها البشر ميلادا",49,"د",2,0],["إلى لحظة ثم تلقى الجمو","ع ما بين نَعْسَان أو راقدِ",50,"د",1,0],["إلى لحظه يعزى المهند مثل ما","إلى قده الرمح المثقف ينسب",51,"ب",1,0],["أليلٌ غشى الدنيا أم الأفق مسود","أم الفتنة الظلماء قد أقبلت تغد",52,"د",1,1],["إلى لوائح من أطلال أحْويةٍ","كأن أرسمها في الطّرس أسطارُ",53,"ر",1,0],["إلى ليقيا يحملاه سريعاً","لإخوته والصحاب البعاد",54,"د",1,0],["آلي لِيَختَطِفَن أَفئِدَة الوَرى","يَومَ المُصاب وَبر في الايلاء",55,"ا",2,0],["إلى لظى وخلفه خضوم","تنتظر القايم كي تستعدي",56,"ي",1,0],["إلى لدنة الكشح ريانة","يعانق فيها الجمال الدلالا",57,"ل",2,0],["إلى ليث شذاه المسك أمسى","ولم نعهده إلا للغزال",58,"ل",1,0],["آلى لعمر أبيه أن لا يبتغي","نفساً تغض على القذى أجفانها",59,"ن",3,0],["إلى لبنان قد صاح الكَليمُ","أَلا ابشر جاءَك السعد الوَسيمُ",60,"م",1,1],["اليلمع المصقع اليهفوف من وفدت","نجب القريض إليه وهو وفّاها",61,"ا",3,0],["إلى لقيا العِدَى طاروا استباقاً","وما في القلبِ شكٌّ وارتياب",62,"ب",1,0],["الى لقاء من بعد طيب الموادع","يحفظك ربي يا سعيد السنافي",63,"ف",2,0],["الى لقاها تذوب النفس من ظمأ","وفي هواها يهون الخطب والالم",64,"م",1,0],["إلى لغة ما زعزع الدهر ركنها","ولا شأنها نحب ولا عابها حقب",65,"ب",1,0],["اليله اليله رشيديه على حسب الميول","من فيض والا غيض دام الراس له روح وجسد",66,"د",1,1],["أ ليلَ الصبابةِ : قلْ لي بصِدقٍ","أكان غراميَ محضَ اختبارْ ؟!",67,"ر",1,0],["إلى لجج من العدم المحلى","يزيد به توهمنا انتفاخا",68,"خ",2,0],["الى لقيتي المحبين غفاي","زقري لهم زقرة مستذله",69,"ل",2,0],["الى لمحتي دم جوفي .. اف خليه","علىالورق .. لا صار روحك تالم",70,"م",1,0],["إلى لَيْلٍ تَمَطَّى في فُؤادِي","إلى عَهْدِ الصَّبابةِ والشُّجُونِ",71,"ن",1,0],["أ ليلٌ قضى ما قد مضى؟ أم قضى الفجرُ ؟","بصبحٍ على أشلائِهِ الّليلُ يجترُّ",72,"ر",1,1],["أليلى هل سألت الناس عني؟","وهل تدرين ما سني ووزني ؟",73,"ن",2,1],["الي لهم .. ف الترجمه .. بدع وآفاق","شامو .. على .. صُم .. الجبال النوايف",74,"ف",1,0],["إلى لا موعدٍ نَمضي أخيرًا","مُقالٌ حُبُّنَا أو مُسْتقيلُ",75,"ل",1,0],["إلى لقياك تحملني دواما","رياح عواصف الشوق العتية",76,"ي",2,0],["إلى لغتي أهدي حنين الأصابع","وأعرفُ أني في الهوى غير ضائع",77,"ع",1,1],["إلى لَحْظَتيكَ يَحُجُّ السَرابْ","ويَنطِقُ في ضِفَّتيكَ اليَبابْ",78,"ب",1,1]]}