{"poems":[[63,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[71,"إلى لحية المرء اللعين ارتقت","https://www.aldiwan.net/poem3806.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[43,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[43,"أريقك أم ماء الغمامة أم خمر","https://www.aldiwan.net/poem9572.html","الطويل"],[45,"سفاها تمادى لومها ولجاجها","https://www.aldiwan.net/poem62680.html","الطويل"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[97,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[97,"تشكين في حبي لك الحق إنني","https://www.aldiwan.net/poem24915.html","الطويل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[46,"أما وفؤاد بالغرام قريح","https://www.aldiwan.net/poem22295.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42710","الوافر"],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[109,"اليلتنا هذي حكيت لياليا","https://www.aldiwan.net/poem16623.html","الطويل"],[115,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[120,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[172,"صوت صفير البلبل","https://www.aldiwan.net/poem26279.html","مجزوء الرجز"],[211,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[249,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[282,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[297,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[379,"يا أسم أسقاك البريق الوامض","https://www.aldiwan.net/poem4560.html","الرجز"],[403,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[441,"بمثوى مسقط طال الثواء","https://www.aldiwan.net/poem14294.html","الوافر"],[441,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[441,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[458,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[466,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[495,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[536,"أشاقك من عهد الخليط مغان","https://www.aldiwan.net/poem23856.html","الطويل"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[564,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[575,"وليلة وصل راقبت غفلة الدهر","https://www.aldiwan.net/poem2955.html","الطويل"]],"verses":[["أَلَيلَتَنا بِالحَزْنِ عودي فَإِنَّني","أُطامِنُ أَحشائي عَلى لَوعَةِ الحُزْنِ",0,"ن",1,1],["إِلى لِحيَةِ المَرءِ اللَعينِ اِرتَقَت يَدٌ","لَها في صُعودِ الحادِثاتِ سُعودُ",1,"د",1,1],["إِلى لَوائِحَ مِن أَطلالِ أَحوِيَةٍ","كَأَنَّها خِلَلٌ مَوشِيَّةٌ قُشُبُ",2,"ب",1,0],["إلى لغات جمه","لأن فيها حكمه",3,"ه",1,0],["إِلَيَّ لَعَمري قَصدُ كُلِّ عَجيبَةٍ","كَأَنّي عَجيبٌ في عُيونِ العَجائِبِ",4,"ب",1,0],["إِلى لَيثِ حَربٍ يُلحِمُ اللَيثَ سَيفُهُ","وَبَحرِ نَدىً في مَوجِهِ يَغرَقُ البَحرُ",5,"ر",1,0],["إِلى لَيلَةٍ إِمّا سُراها مُبَلِّغي","أُجاوِدَ إِخواني وَإِمّا ادِّلاجُها",6,"ج",3,0],["أَلَيلَتَنا الطولى بِطِمّينَ هَل لَنا","سَبيلٌ إِلى اللَيلِ القَصيرِ بِبابِلا",7,"ل",2,0],["أليلاىَ ما أبقَى الهوى فيَّ من رُشدِ","فردِّي على المشتاقِ مهجتَه ردِّي",8,"د",2,1],["أليلايَ حُبِّي فيك حُبُّ مُوَحِّدٍ","تَنَزَّهَ عن ريبٍ وجلَّ عن الشِّرك",9,"ك",1,0],["أَلَيلى بِأَبوابِ الخُدورِ تَعَرَّضَت","لِعَينِيَ أَم قَرنٌ مِنَ الشَمسِ طالِعُ",10,"ع",1,0],["أليلَتَنا إذ أرْسَلَتْ وارداً وَحْفَا","وبتنا نرى الجوزْاءَ في أُذنِها شَنفا",11,"ف",2,1],["أَلَيلى وَكُلٌّ أَصبَحَ اِبنَ مُلَوَّحٍ","وَلُبنى وَما فينا سِوى ابنِ ذَريحِ",12,"ح",1,0],["اليلةٌ ما مرَّ أم ليلتانْ","إبقَيْ معي حتى يلوح السَحَرْ",13,"ر",1,0],["أَلَيْلَى مَا لِقَلْبِكِ لَيْسَ يَرْثِي","لِمَا أَلْقَاهُ مِنْ أَلَمِ الْفِرَاقِ",14,"ق",1,1],["أليلتنا بذي حسم أنيري","إذا أنت إنقضيت فلا تحوري",15,"ر",2,1],["اليلتنا هَذي حَكَيت لَيالياً","مَضين وَشَملي بِالأَحبة جامِعُ",16,"ع",1,1],["أليلاي كم من ليلة طال ليلها","ينام الخلي البال فيها واسهر",17,"ر",1,0],["أليلتان جزائي منك أجلهما","بعدٌ على حسرات إثر إحسان",18,"ن",1,0],["إِلَى لِقَاءِ مَلِكٍ","مُعَظَّمٍ مُبَجَّلِ",19,"ل",1,0],["أليلةُ عيد تلك واها وآهة","إذا كانت الآهاتُ في الخوف تنفع",20,"ع",1,0],["أَلَيلى عَلى شَحطِ المَزارِ تَذَكَّرُ","وَمِن دونِ لَيلى ذو بِحارٍ وَمَنوَرُ",21,"ر",1,1],["إِلى لَماهُ اِرتِياحُ الروحِ مُنبَعِثٌ","كَأَنَّ أَنفاسَهُ روحٌ وَرَيحانُ",22,"ن",1,0],["أَلَيلَةُ الحَشرِ لا بَل يَومُ عاشور","وَنَفخَةُ الصُّورِ لا بل نفثُ مصدورِ",23,"ر",1,1],["اليل بين قنوين رابض","بجيزة الوادي قطا نوهض",24,"ض",1,0],["إلى لقاء اللّه سبحانه","عند فراق العبد دار الزوال",25,"ل",1,0],["إلى ليلى الشريفة حن قلبي","وأنى لي على البعد اللقاء",26,"ا",2,0],["أليلتنا بالأمس عودي","ليورق بعد يبس الغصن عودي",27,"د",2,0],["أليلى سهرت عليك الليالي","إذا لاح لي النجم بت حليفه",28,"ف",2,0],["أليلَ سوادي ما أرى الصبحَ سَرّني","فمن ردَّ لي ذاك الظلامَ فأغسقا",29,"ق",2,0],["أَلَيلى اِحذَري نَقضَ القِوى لا يَزَل","عَلى النَأيِ وَالهِجرانِ مِنكِ نَصيبُ",30,"ب",1,0],["أليلتنا بين العتابين والعذرِ","أليلة عذر كنت أم بيضة العقر",31,"ر",1,1],["إِلى لُطفِهِ بِالمُؤمِنينَ وَنَصرِهِ","لَهُم وَتَوَلّى الخَذلُ كُلَّ هِدانِ",32,"ن",1,0],["ألَيْلَتَنا بكاظمةٍ أضِلِّي","بياضَكِ أنْ يلمّ بنا ضلالا",33,"ل",2,0],["أليلى ما لأهلك أسلموك","ومثلك لا يعار ولا يباع",34,"ع",1,0],["أَليلتَنَا إِن لم تكونِي عبَارة","وحقِّك عن عُمرٍ فَدَيْتُكِ بالعُمْر",35,"ر",1,0]]}