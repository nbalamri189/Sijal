{"poems":[[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216600",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216566",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216551",""],[5725,"بلاد النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198717",""]],"verses":[["دَشّ بستان الحشا يقصِل قصِال","دون شُوري واستوى عَنّي وكيل",0,"ل",1,0],["دَشّيتْ فِيْ بابٍ مبَطَّلْ","باب الشِعر وآبَطّلْ الطَّيّ",1,"ط",2,0],["دَشّيتْ باب الحب بَسْ مارْ","ييت بخرج ولا ريت مِخْرَج",2,"ج",1,1],["دشداشتك ها يا وطن صبغ النيل","گوم ابطرگها وخلْ يسامرنا الليل",3,"ل",1,1]]}