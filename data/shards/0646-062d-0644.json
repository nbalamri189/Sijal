{"poems":[[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[55,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[65,"وريم رماني طرفه بسهامه","https://www.aldiwan.net/poem45781.html","الطويل"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[90,"متى تطلق الأيام حرية الفكر","https://www.aldiwan.net/poem45065.html","الطويل"],[29,"أعاذل ما بالي أرى الحي ودعوا","https://www.aldiwan.net/poem5916.html","الطويل"],[4,"أعاذل قومي فاعذلي الآن أو ذري","https://www.aldiwan.net/poem21164.html","الطويل"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[53,"ما يفيق الكتاب من ظلم إبراهيم","https://www.aldiwan.net/poem62899.html","الطويل"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[93,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[47,"بت أبدي وجدا وأكتم وجدا","https://www.aldiwan.net/poem63457.html","الخفيف"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[71,"أراني الله وجهك كل حين","https://www.aldiwan.net/poem28575.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[77,"قد رق من نفس الصباح نسيم","https://www.aldiwan.net/poem69018.html","الكامل"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/57143","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[93,"في فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53028",""],[2,"ألاَ أبلغْ، لديكَ، بني تميمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=5261",""],[164,"خذوا لي من سمر القدود أمانا","https://www.aldiwan.net/poem58947.html","الطويل"],[164,"لنا ما دنا مما نروم وما شطا","https://www.aldiwan.net/poem59104.html","الطويل"],[254,"تغيرت المنازل من سليمى","https://www.aldiwan.net/poem2124.html","الوافر"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[447,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[463,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[469,"لكم من سقامي بالهوى شاهد عدل","https://www.aldiwan.net/poem3604.html","عموديه"],[556,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122697","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129511","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59564","المتقارب"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205217","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80212","الكامل"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/27034","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104988","المنسرح"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124683","الخفيف"],[2974,"","https://poetry.dctabudhabi.ae/diwan/poem/198750","الكامل"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123931","المتقارب"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141228","المتقارب"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17774","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"أعينيني","https://www.poetsgate.com/ViewPoem.aspx?id=87493",""],[4767,"مسحة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=210249",""],[4929,"نقل مباشر","https://www.poetsgate.com/ViewPoem.aspx?id=200157",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5345,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=2468",""],[5431,"مرّوا على النفس...","https://www.poetsgate.com/ViewPoem.aspx?id=190591",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5701,"ودنيا الورى فندق للورى","https://www.poetsgate.com/ViewPoem.aspx?id=164636",""],[5739,"قصيده تنتظر شاعر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131709",""],[5853,"علام..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175681",""],[5956,"السُّيول","https://www.poetsgate.com/ViewPoem.aspx?id=183189",""]],"verses":[["نُحَلَّأُ عَن ماءِ الحُلولِ وَنَنثَني","عَلى رَصفِ أَكبادٍ أَحَرِّ مِنَ الجَمرِ",0,"ر",1,0],["نَحِلوا مِنَ البَلوى نُحولَ مَطِيِّهِم","فَضَوامِرٌ مِن فَوقِهِنَّ ضَوامِرُ",1,"ر",1,0],["نَحَلتُ إِذا ما فيكُمُ مِن مَعائِبٍ","وَنازَعتُكُم طُعماتِ تِلكَ الخَبائِثِ",2,"ث",1,0],["نَحَلتُ كَأَنّي سِلكُ عِقدٍ وَدُرُّهُ","قَريضي فَنِطْنِي حَيثُ نيطَ سِخابُ",3,"ب",1,0],["نَحلاً كَدَرداقِ الحَفيضَةِ مَر","هوباً لَهُ حَولَ الوَقودِ زَجَل",4,"ل",1,0],["نحلول علماً بالحياة وإنّ ذا","منَوط إلى ما ليس يدرَك بالفكر",5,"ر",1,0],["نَحُلُّ عَلى الثَغرِ المَخوفِ وَأَنتُمُ","سَرابٌ عَلى قيقاءَةٍ يَتَرَيَّعُ",6,"ع",1,0],["نَحُلُّ بِلاداً كُلُّها حُلَّ قَبلَنا","وَنَرجو الفَلاحَ بَعدَ عادٍ وَحِميَرِ",7,"ر",1,0],["نَحلتُك حَلْياً من مديحٍ كأنه","هَوى كلِّ صبٍّ من عِناق الحبائبِ",8,"ب",1,0],["نحلَتْكَ حَمْدَ الحامديك مَواعدٌ","كُذُبٌ تجودُ بها وأنت جمادُ",9,"د",1,0],["نَحلوا ذا واواً وبزوا أخاه","ألفاً منه بين رِدْفٍ وصدر",10,"ر",1,0],["نحلوهم ذخائراً لك بالبا","طل من قِيلهم وكان زهوقا",11,"ق",2,0],["نَحِلتُ إِلى أَن كِدتُ أُنكِرُ صورَتي","وَأَخشى لِفَرطِ السُقمِ أَن أَتَنَهَّدا",12,"د",2,0],["نَحَلَتهُ العِراقُ ما كانَ نُحلاً","مِن عُمانٍ وَمُلكِها لِلجُلَندى",13,"د",2,0],["نَحُلُّ بِسَهلِها فَإِذا فَزِعنا","جَرى مِنهُنَّ بِالأَصلاءِ عونُ",14,"ن",1,0],["نحلْتُ فمنْ يعدني لم يجدني","وليسَ يدلُّهُ إلاّ أنيني",15,"ن",2,0],["نَحُلُّ ديارَهم فنزورُ منهم","مَساميحَ النُّفوسِ مُحبَّبِينا",16,"ن",2,0],["نَحُلَت وأنحلَتِ الزُّجاجَ كَأنَّها","في صدرِ شارِبِها الهَوى المَكتُومُ",17,"م",1,0],["نَحُلُّ الدِيارَ وَراءَ الدِيارِ","ثُمَّ نُجَعجِعُ فيها الجُزُر",18,"ر",1,0],["نُحَلِّي بِأَرطالِ اللُجَينِ سُيُوفَنا","وَنَعلُو بِها يَومَ الهِياجِ السَنَوَّرا",19,"ر",2,0],["نحلتُ مِنْ فرطِ الأسى","فيهِ ولوْ أنني الأسدْ",20,"د",1,0],["نحلم الحلم كالصباحِ افتراراً","وكزهر الرياض لونا وعطرا",21,"ر",2,0],["نحلت إلى أن أنكر صورتي","وأخشى لفرط السقم أن أتنهّدا",22,"د",2,0],["نحلُّ سهولها، فإذا فزعنا","جرى منهنَّ، بالآصالِ، عونُ",23,"ن",1,0],["نحلت هوى قالت تقشف عامداً","لينحل من يبغي في الفراش أمانا",24,"ن",2,0],["نحل عن الاهوا وتسمو نفوسنا","إذا حبطت بالقوم أهواءهم حبطا",25,"ط",2,0],["نَحُلُّ مَخوفَ كُلِّ حِمىً وَثَغرٍ","وَما بَلَدٌ نَليهِ بِمُستَباحِ",26,"ح",1,0],["نَحِلَتْ حتَّى انبرت أعظُمُها","والهوى يُنْقِبُ أهليه نكالا",27,"ل",2,0],["نحل بالنص جلي كل مشكلة","من المسائل عن إسناد ذي سند",28,"د",1,0],["نحَلتُ نحولَ ربعكُمُ","كأنّ عِراصَه بدَني",29,"ن",2,0],["نحلوك سابقة بلهوة مثلها","طاف الأمان بمعقل المتحصن",30,"ن",1,0],["نحلنا ملوكاً قبلك المدحَ فانتفت","خلائقُ غِشٍّ لن تصحّ على النَّحلِ",31,"ل",1,0],["نَحَلْتني مدحَك فخراً باقياً","في عَقِبي ما دام للدهر بقا",32,"ق",2,0],["نَحَلتِ ففي ترابِكِ منكِ رَسمٌ","كما أني خَيالٌ في ثيابي",33,"ب",2,0],["نحلوا على شعب الرحال فأشْبهت","أعوادها منهم عَريقَ الأضلعِ",34,"ع",1,0],["نحلتُ إلى أن لم يرَ الطيفُ مضجعي","ولم يبدُ في ظلّ الغزالة لي ظلُّ",35,"ل",1,0],["نَحَلنَ حتّى حالهنّ السُّرى","بعضَ بقايا شَطَنٍ مُبْرَمِ",36,"م",1,0],["نَحلَتهُ سَيِّدَهُ النِّساءِ وأحمَدٌ","وَعَليُّ مَجدَهُمُ الطَّويلَ الباسِقا",37,"ق",2,0],["نحل له الرسل الكرام حباهم","وان ذكروا فهو العذيق المرجب",38,"ب",1,0],["نحلُّ اليفاعَ بأسيافنا","ونرعى الجميم وإن لاحَ لاح",39,"ح",1,0],["نَحُلتُ وما قولي نحلت تعجباً","هل الحب إلاّ لوعة ونحول",40,"ل",1,0],["نحلت شِكايتها كُلطفكَ رقَّةً","إِذ قُمتت تَبعَث لِلنَحيل نَحيلا",41,"ل",2,0],["نَحُلُّ بِها وَنُنزِلُ حَيثُ شِئنا","بِما بَينَ الطَريقِ إِلى رَماحِ",42,"ح",1,0],["نَحلُلْ جَنَاباً مُمْرِعاً آمِناً","فيه المنى جامعةُ الشَّمل",43,"ل",1,0],["نحلتُك الحبّ علي إذ نحَلتُكَهُ","أجني بحبّك منه أفضل النحَل",44,"ل",1,0],["نَحُلَت وَضَمَّ السَيرُ أَضلُعَها","فَتَشابَهَت هِيَ وَالبُرى الصُفرُ",45,"ر",1,0],["نحل الجسم وعظمي وهنا","والكرى قد زال والسهد بقي",46,"ي",1,0],["نَحلتُ مثل السواك فيك فما","ضرَّك لو أنني رشفت فمك",47,"ك",1,0],["نحلةٌ مصّتِ الشقيقَ المندّى","ثمَّ طارت تفوحُ عطراً وندا",48,"د",2,1],["نحلت أمانيها العظام وأقفرت","وكسا شفاه الحالمين ذبولُ",49,"ل",1,0],["نُحل الجسوم ومقروحو الجفون وهي","تُكنِي عن النسك والإسهار والندمِ",50,"م",1,0],["نحلت فصرت إذا ما بدت","اريها السهى وتريني القمر",51,"ر",1,0],["نَحَلتُ فَلَو زُرتُهَا مَا خَشيِ","تُ رَقيباً يَرَانِيَ فِيمَن يَرَى",52,"ر",2,0],["نُحَلِّيها عَن جارِنا وَشَريبِنا","وَإِن صَبَّحَتنا وَهيَ عوجٌ خَوامِسُ",53,"س",1,0],["نحل الجسوم قريحو الجفون وهي","تكني عن النسك والاسهار والندم",54,"م",1,0],["نَحلتُ مِنَ الآلامِ حَتّى كَأَنَّني","مُقَدَّر مَفروض وَما هُوَ واقِعُ",55,"ع",1,0],["نحلت وصرت أعوادا","فمنك اليوم أدنيني",56,"ن",2,0],["نحِل الجسمُ وأعضائي خوَت","ومن الحب عروقي ما ارتوتْ",57,"ت",1,1],["نحلٌ تُسمِّمُ في الزهورِ متوكَها **","فيموتُ فيها للثِّمارِ صلاحُ",58,"ح",1,0],["نَحلتُ من أسَفٍ تَلِفتُ مِن كَمَدٍ","وجَمرِ هَجرٍ وما رَثَت لذي عَدَمِ",59,"م",1,0],["نحلق حتى كأنا نحس بأنا نلامس برد السحاب","تعالي تفتح ورود الخزامى بعطر يرف بكل الشعاب",60,"ب",1,0],["نحلات روحك قد جادت بشهد جوى","في واحة الحب خلّ النحل يرتشف",61,"ف",1,0],["نَحلاتُ روحِكَ قد جادَتْ بشهدِ جَوىً","مِن واحةِ الذكر خَلِّ النحلَ يَرتشِفُ",62,"ف",1,0],["نحل به ثم نمضي إلى","فنادق من زارها يحجب",63,"ب",1,0],["نحل جسم المولع والمحبه في عزايرها.","متى نور اللقا يفضح ظلام ٍ تمتليه كْهوف.",64,"ف",1,0],["نحلق في سماء الحب نشدو","نعانق كل من يدعو سلاما",65,"م",2,0],["نحلّق فوق الوجود عِليَّاً","لنلقَى النجومَ لنا ساجِدةْ",66,"د",2,0]]}