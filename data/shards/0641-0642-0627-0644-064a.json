{"poems":[[53,"إني سألت ابن أبي طاهر","https://www.aldiwan.net/poem62937.html","الطويل"],[93,"رآني الله ذات يوم في الأرض أبكي من الشقاء","https://www.aldiwan.net/poem8734.html","عموديه"],[93,"لا نبغيض الروس لكن لا نحبهم","https://www.aldiwan.net/poem62766.html","عموديه"],[34,"وقلت لها اعتللت بغير ذنب","https://www.aldiwan.net/poem27815.html","الوافر"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[87,"كان على بعض الدروب جمل","https://www.aldiwan.net/poem8008.html","الرجز"],[87,"يقال إن الليث في ذي الشده","https://www.aldiwan.net/poem8020.html","الرجز"],[87,"الدب معروف بسوء الظن","https://www.aldiwan.net/poem8022.html","الرجز"],[87,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[87,"مر الغراب بشاة","https://www.aldiwan.net/poem8039.html","المجتث"],[87,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[107,"ما يكسب المرء من إثم ولا يزر","https://www.aldiwan.net/poem44197.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19689","الرجز"],[82,"انظرهما في الظلام قد نجما","https://www.poetsgate.com/ViewPoem.aspx?id=3715",""],[119,"وقال لحاني عليه العذول","https://www.aldiwan.net/poem41122.html","عموديه"],[139,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[190,"دعوه يبكي لفقد خلانه","https://www.aldiwan.net/poem43249.html","المنسرح"],[203,"أهديت ذا الحسن وردا","https://www.aldiwan.net/poem45623.html","المجتث"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"سألت نسيم أرضك حين وافى","https://www.aldiwan.net/poem58124.html","الطويل"],[473,"وشادن من بني الكتاب قلت له","https://www.aldiwan.net/poem60481.html","البسيط"],[505,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[572,"ومستحث الأوتار من نام","https://www.aldiwan.net/poem69522.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126877","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66713","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66641","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87166","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48540","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77503","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77480","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77666","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121225","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126192","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65399","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65266","الرجز"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28876","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203204","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4929,"واحد = خمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212790",""],[5010,"الجَدّ وحفيده","https://www.poetsgate.com/ViewPoem.aspx?id=190233",""],[5135,"وَرْقاء","https://www.poetsgate.com/ViewPoem.aspx?id=202009",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""]],"verses":[["فقال يُعشي بصري ضوؤها","وليس ضوءُ البدر يُعشي البصر",0,"ر",1,0],["فَقالَ يا شاعِراً عَجيباً","قُل لي إِذَن ما الَّذي تَشاء",1,"ا",2,0],["فَقالَ يا قَومُ هَذا سِرُّ يَومِكُمُ","أَلا اِشرَبوا إِنَّ سِرَّ اليَومَ سِرّانِ",2,"ن",1,0],["فَقالَ يَمينَها وَبِذاكَ أَقضي","وَكُلُّ قَضائِهِ حَسَنٌ جَميلُ",3,"ل",1,0],["فقال يا رب ردّها","فما نعمتُ بعدها",4,"ه",2,0],["فَقالَ يا لِلنَحسِ وَالشَقاءِ","إِن طالَ هَذا لَم يَطُل بَقائي",5,"ي",1,0],["فَقالَ يا مَن صانَ لي مَحَلّي","في حالَتَي وِلايَتي وَعَزلي",6,"ي",1,0],["فَقالَ يا مَن لا تُداسُ أَرضُه","وَمَن لَهُ طولُ الفَلا وَعَرضُه",6,"ه",1,0],["فَقالَ يا لَجَدّيَ التَعيسِ","أَسَأتَ ظَنّي بِالنَبي الرَئيسِ",7,"س",1,0],["فَقالَ يا مَليكَه","وَرَبَّةَ الأَريكَه",8,"ه",1,0],["فَقالَ يا أُمَّ سَعدٍ","هَذا عَذابٌ أَليمُ",9,"م",1,0],["فَقالَ يا نورَ عُيونِ الأَرضِ","وَمُخجِلَ الكَوثَرِ يَومَ العَرضِ",10,"ض",1,0],["فَقالَ يا حارِسُ خَل","لِ السُخطَ وَالتَعَتُّبا",11,"ب",2,0],["فقال يا ويلكم ما زلتُ أتبعكم","حتى هلكتُ فلا جاهٌ ولا خَطَرُ",12,"ر",1,0],["فقال يا روعةَ المساءِ","وفِتنةَ اللُّبِّ والبصرْ",13,"ر",1,0],["فقال يا حارس خل ال","سخط والتعتّبا",14,"ب",2,0],["فقال: يفتح عينيه ثم يطبقهما","فقلت: فعل امرىء في جفونه رمد",15,"د",1,0],["فقال يذيبك تعذيبه","ولم يدر ذو العذل اني كذا",16,"ذ",2,0],["فقال ينكر مني ما أحاوله","لمن تجدّ وجُل الناس في لعبِ",17,"ب",1,0],["فقال يا صاحبي أصله","إذا فرح قلبي يحل بيرانه",18,"ن",2,0],["فقالَ يا شبهَ خدي","خدي يغارُ عليكا",19,"ك",2,0],["فَقال يَوماً واِفتَرى","بهتاً وكذباً مُنكرا",20,"ر",2,0],["فقال يلين قلت لكل ضد","وقال يميل قلت لكل واش",21,"ش",1,0],["فَقالَ يَرفَعُ في الديوانِ قِصَّتَهُ","حَتّى نُوَقِّقَ فيها بِالَّذي يَجِبُ",22,"ب",1,0],["فقالَ يُهَالُ القلبُ منهُ إذا رأَى","علامَةَ هِجرانٍ فقلتُ يُهَالُ",23,"ل",1,0],["فقالَ يُخَالُ الموتُ في وَجَناتِهِ","غَراماً لمن يهْوى فقلتُ يُخَالُ",23,"ل",1,0],["فقالَ يُسَالُ الدَّمعُ من بحرِ جَفنِهِ","إذا ما رأَى الوادي فقلتُ يُسَالُ",23,"ل",1,0],["فقالَ يُغَالُ الجسمُ منه تلهُّفاً","لآرامِ وادينا فقلتُ يَغَالُ",23,"ل",1,0],["فقالَ يُحَالُ الدَّمعُ منه كما الدِّما","ويحفُرُ أُخْدوداً فقلتُ يُحَالُ",23,"ل",1,0],["فقالَ يُنَالُ الوصلُ إنْ كانَ هكذا","فبَشِّرْهُ يا هذا فقلتُ يُنَالُ",23,"ل",1,0],["فَقَالَ يَحْدُو بِمِثْلِ نَغْمَتِهَا","وَإِنْ أَطَالَ الحَبِيْبُ إِرْغَامِي",24,"م",2,0],["فقال يا أمّ عمّي اليوم منفرد","يدعو أهَل ناصر ذا اليوم ينصُرني",25,"ن",2,0],["فقال يا قوم إنّ اللهَ أرسلني","إليكمُ فأجيبوا اللهَ وادّرِكوا",26,"ك",3,0],["فقال يا خيرَ خلقِ اللهِ كلّهمِ","أردتُ حين دعوتُ اللهِ مطَّلِبا",27,"ب",2,0],["فَقالَ يا أَهلَ هَذا الحَيِّ ما فَعلت","يَدُ الهَوى في شجيٍّ بَينَكُم عاني",28,"ن",2,0],["فقال يا نعمى رأي","ت أمتي في وصب",29,"ب",1,0],["فَقالَ يا فارس المَعالي","وَمَن لَهُ في الرِجالِ شانُ",30,"ن",1,0],["فَقالَ يا خَروف حينَ جاءَ","يَكفيك عَكَّرت عَليَّ الماء",31,"ا",2,0],["فَقالَ يا اللَّهُمَّ يا اللَّهُمّا","لا تحرمَن هَذا النَزيلَ لَحما",32,"م",2,0],["فقال يخشى فوات حاجتنا","وليس هذا من أكبر الغل",33,"ل",1,0],["فقال يا سيدي عجلت بمك","ر وهي وكان الإنسان من عجل",33,"ل",1,0],["فقال يا حبذا أبو الأسود الزا","هد فينا بسلحة قبلي",33,"ل",2,0],["فَقالَ يا رَبِّ أَعِزَّ القَطرا","عَنهُم فَعَدّاهُم سِنينَ عَشرا",34,"ر",2,0],["فقال يا ولدي اياك من زمن","رضوان يشهو به من غاية الكبر",35,"ر",1,0],["فقال يا داودُ نبّىء مَن صدَق","من كلّ صدَيق بغيرى ما عَلِق",36,"ق",1,0],["فقال يا مانيُّ أَنت الذي","وقعتَ في أخت ما أكره",37,"ر",2,0],["فقال يا من نحا ذا النّحو ما سمعت","أذناي من يجمعُ الدّينار يصرفُهُ",38,"ه",1,0],["فقال يسرٌ جاءنيْ","منهُ ووصلٌ قرّبه",39,"ب",2,0],["فقال يا رب وماذا أمهر","قيل له اذكر أو فصل تظفرُ",40,"ر",1,0],["فقالَ يا عبدَ بني علاج","مالكَ في ذاكَ من احتياج",41,"ج",1,0],["فَقالَ يُديرُ المَوتَ في مَرجَحَنَّةٍ","تَسِفُّ العَوالي وَسطَها وَتَشولُ",42,"ل",1,1],["فقال يا هذي الدليلة اسعدي","أجود في هذا بما حازت يدي",43,"ي",1,0],["فقال يغنيني رد في الذي","سموه عشاقي تليل الذهب",44,"ب",1,0],["فقال يا أتريذ مولى البشر","أنت ولي الأمر والمرجع",45,"ع",1,0],["فقال : يكاد الأمر غيرَ مُصدَّقٍ","فقلتُ : بلى ، عين الحقيقة والصدقِ",46,"ق",1,0],["فَقَالَ : يَمِيْنُ اللهِ أَكْتُمُ جَاهِدًا","سِوَى جَدَّتِي أُبْدِيْ لَها الصِّدْقَ مِنْ قَلْبِيْ",47,"ب",2,0],["فَقَالَ : يَا صَاحِبِي ، لا تَجْزَعَنْ أَبَداً","\"فَهَلْ عَلى عَوْدَةٍ يَسْتَأْذِنُ الشَّجَنُ\"",48,"ن",1,0],["فقال يا ابن علي خذ بمعصمها","وحسبي السخط من شمس وواليها",49,"ي",3,0],["فقال يا عمه احفظ ما خصصت به","هذا به حد أهل الكفر مفلول",50,"ل",1,0],["فقال: يا أيها الباقون في حلم","طال المقام، وكان الموعدُ الأمدا",51,"د",2,0]]}