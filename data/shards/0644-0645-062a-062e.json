oem/45786","الطويل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216808","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33584","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120418","السريع"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204227","الكامل"],[4767,"استنهاض القلم","https://www.poetsgate.com/ViewPoem.aspx?id=201142",""],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[5119,"النرد","https://www.poetsgate.com/ViewPoem.aspx?id=196606",""],[5204,"لم تخل زرقاء من العيب","https://www.poetsgate.com/ViewPoem.aspx?id=200365",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5226,"القدس .. في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=24251",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5409,"شيعت فيك عصارة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=155453",""],[5493,"عزوف القلب","https://www.poetsgate.com/ViewPoem.aspx?id=199529",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5956,"رصاص وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192450",""],[5956,"طول عمري وجهادي لم أشاهدْ","https://www.poetsgate.com/ViewPoem.aspx?id=193357",""],[6228,"نبحث عن بقيتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85967&r=&rc=4",""]],"verses":[["لَم تَخَف مِنهُمُ القَنا","وَالدُروعَ الأَواقِيا",0,"ي",2,0],["لَم تُخطِ في أَمري الصَوابَ مُوَفَّقاً","هَذا جَزاءُ الشاعِرِ الكَذّابِ",1,"ب",1,0],["لم تخفَ في أثنائه خافيه","حتى ترى فيه اهتزاز النسيم",2,"م",1,0],["لم تُخَيِّبْ ولم تؤنِّبْ ولم تحْ","رمْ نصيباً من انْتِباهٍ بليدَكْ",3,"ك",1,0],["لم تخلُ من منظر تُشوِّقهُ","ومن عفاف يفي بمستَترِ",4,"ر",1,0],["لم تُخلني قطُّ من صنائعك الغر","رِ ولا من حُروبك الضُّرس",5,"س",1,0],["لم تُخلني ساعةً من بذْلِ عارفةٍ","وأن أُرَى مُخْلياً من نشرها أُذُنا",6,"ن",2,0],["لَم تَخلُ مِن أَسَفٍ عَلَيكَ حَشاشَةٌ","أَبَداً فَيَخلو مِن دُموعٍ مِحجَرُ",7,"ر",1,0],["لمْ تُخَلِّفْ ليَ الحَيَاةُ من الأَمسِ","سِوى لوعَةٍ تَهُبُّ وتُرْسي",8,"س",2,0],["لم تخل في ساعة تجود","بالنفس فيها من ادّكارك",9,"ك",1,0],["لَم تَخِط لِلناسِ يَوماً كَفَناً","إِنَّما خاطَت بَقاءً وَكِيانا",10,"ن",2,0],["لَم تَخلُ مِن فِئَةٍ تَحُفُّكَ رَغبَةً","وَخَلائِقٍ يُبرِزنَ شَخصَكَ فارِدا",11,"د",2,0],["لَم تَخالَج فيهِ الشُكوكُ وَلا كا","نَ لِوَحشِ القُلوبِ عَنهُ نِفارُ",12,"ر",1,0],["لَم تَخطُ بابَ الدِهليزِ مُنصَرِفاً","إِلّا وَخَلخالُها مَعَ الشُنُفِ",13,"ف",1,0],["لم تخل من زور يصادف معركا","ذا قسطل فيشيب فيه أمردا",14,"د",2,0],["لَم تَخلُ مِنكَ خَواطِري وَنَواظِري","في حالِ تَسهادي وَحينَ أَنامُ",15,"م",1,1],["لَم تَخلُ أَرضٌ مِن ثَناهُ وَإِن خَلَت","مِن ذِكرِهِ مُلِئَت قَناً وَقَواضِبا",16,"ب",2,0],["لَم تَخَوَّف ضَرَّ العَدُوِّ وَلا بَغ","ياً وَلَكِن تَخافُ ضَرَّ الصَديقِ",17,"ق",1,0],["لَم تَخلُ في خَصرِهِ مَناطِقُهُ","مِن جَذبِ سَيفٍ وَحَملِ دَبوسِ",18,"س",1,0],["لَم تَخشَ إِلَّا اللَّهَ فِي أَمرٍ وَلَم","تَملِك طِبَاعَكَ عادَةٌ فَتَحُولا",19,"ل",2,0],["لم تَخْلُ أرضٌ من نَداهُ ولا خلا","من شكْرِ ما يولي لسانٌ قائل",20,"ل",1,0],["لَم تَخطُ مِن خِدرِها شِبراً إِلى أَحَدٍ","وَلَم تَزَل بَينَ جَنّاتٍ وَأَنهارِ",21,"ر",1,0],["لِمَ تَختارُ أُنوكاً","خامِلَ القَدرِ أَعمَشا",22,"ش",2,0],["لَم تُخلَقِ الخَيلُ مِن عُرٍّ وَمَصمَتَةٍ","إِلّا لِيُركَضَ في حاجاتِهِ الفَرَسُ",23,"س",1,0],["لَم تُخلِدِ الراحُ وَالمَزاهِرُ وَال","قَيناتُ حَيَّي عادٍ وَلا قُدُمِ",24,"م",1,0],["لم تَخْضِمِ البِيضُ لها حَلْقَةً","يَسيرَةَ الصُّنْعِ ولم تَقْضَم",25,"م",1,0],["لَمْ تَخْلُ مِنْهُ مَقَامَةٌ شَرْقِيةٌ","فِي الغَرْبِ تَعْقِدُهَا هُنَاكَ جَوَالِي",26,"ل",2,0],["لم تخدعيني مطلقاً إنما","نفسك يا هذي التي تخدعين",27,"ن",1,0],["لم تخْبُ نارُ الفتنة ال","كُبرى وجُرْحُ الكون دام",28,"م",1,0],["لم تخف عيبا ولم تأخذ مخالسة","ولا الهناء بها الا على علل",29,"ل",1,0],["لم تخلف كفُّ الليالي من الكوفَةِ","إلا مُحرَّقاتِ الركائِم",30,"م",1,0],["لم تُخلني قطُّ من صنائعك ال","غُرِّ ولا من حُروبك الضُّرس",31,"س",1,0],["لَم تَخط آساد الفَلافي عَهدِهِ","بَينَ الشَقائِقِ خيفة أَن تَتَهما",32,"م",2,0],["لم تَخفَ منك عن الرحمن خافيةٌ","بل كلُّ فعلك مقدورٌ بمقدار",33,"ر",1,0],["لم تخش إقلالا بما أنفقته","لما قطعت الشك قطع الشك",34,"ك",1,0],["لَم تخرجِ السحبُ يوماً عن إشارتهِ","غيثٌ وصحوٌ وتكثيرٌ وتقليلُ",35,"ل",1,0],["لم تخبُ من بنتِ النخيلِ","ولا ابنَةِ العُنقودِ ناري",36,"ر",2,0],["لم تخلُ من نارٍ لهمْ في الدجى","ثنيَّةٌ علياءُ أو مَرقَبُ",37,"ب",1,0],["لم تخل من تيه الدلال وإنني","لأرى الدلال على الفراق دليلا",38,"ل",2,0],["لم تخدع النفس ما رأت من","زركشة في العروس تحمد",39,"د",1,0],["لَم تَخُن فيهِ بَعلَها فَتَريست","انُ وَإيزولتُ أَشرفُ العُشّاقِ",40,"ق",1,0],["لَم تَخْفَ عن ربِّ البرِيْ","يَةِ من فِعالِهِمُ خَفِيّه",41,"ي",2,0],["لَم تَخَف مِنهُ بَنو الآمالِ إِذ","يَغمُرُ القَومَ بِفَيضِ المَنِّ مِنّا",42,"ن",2,0],["لَم تَخلُ سَمعاً مِن هَناءِ مُهَنِّئ","لِلمُسلِمينَ وَمِن سَماعِ مُبَشِّرِ",43,"ر",1,0],["لَم تَخلُ في دَهرِها سا","عَةً مِنَ التَّشريخِ",44,"خ",1,0],["لَم تَخشَ ثأراً بما أَردت لواحظُها","دمُ المحبّين في شَرع الهَوى هَدَرُ",45,"ر",1,0],["لَم تُخف يوماً لها بادرةٌ","لا ولا خِذلانُ جارٍ في جَريره",46,"ر",2,0],["لم تخف صولة الطغاة ولم تجفل","من الجمع صائحا كالرعود",47,"د",1,0],["لم تَخْل عَيْني من خِيالِك ساعةً","فتَشابَه التّقريب والتَّبعيد",48,"د",1,0],["لم تَخْلُ عَيْنَي من نورِ غُرَّتهِ","إلاّ وفَيْضُ الدّموعِ يَملَؤها",49,"ا",3,0],["لَم تَخلُ أَرض مِنهُمُ مِن صَيبٍ","وَسماء مُجدٍ منهُمُ مِن كَوكَبِ",50,"ب",1,0],["لم تخش يثرب تثريبا لفادحة","من بعده إذ سرت في ذكره السور",51,"ر",1,0],["لم تخش في ركب المنون رزية","بل أنت في وفد الإله مقدم",52,"م",1,0],["لم تخز أولادها والوالدين ولا","بين الرجال إذا ناضلت تخزيني",53,"ن",2,0],["لم تخنه سلامة مثل ما","خانته طباع بالغدر مؤتلفه",54,"ف",2,0],["لم تخلُ عن فضلك في بعضهم","فضائلٌ ينسبها خاليا",55,"ي",2,0],["لم تخف جانبَ المحُول من الأر","ض ولم تخشَ في السُّرى أهوالَهْ",56,"ل",2,0],["لم تُخترَق قبلي ولا تولَّجتْ","بمثلهنَّ الألسنُ المسامعا",57,"ع",2,0],["لم تخْشَ إذ ْكنتَ صِلَّ الرَّملِ مُنتصِباً","أنْ يَسلِبوكَ ، وَهَل مِن مُرمِلٍ سُلِبا ؟",58,"ب",2,0],["لم تخلد في تاريخنا الذهبي","مما يكلل تاج العرب تكليلا",59,"ل",2,0],["لَم تَخشَ ناراً هَوى لَظاها","لِمَن لَهُ نَحوَها اِنحِياشُ",60,"ش",1,0],["لم تخلُ كعبةُ خِدرِها من طائِفٍ","إمّا غَيورٌ أو محبٌّ شَيّقُ",61,"ق",1,0],["لم تخلقوا إلا على قدر ما","يختاره المجد وما يؤثر",62,"ر",1,0],["لم تَخلُ هاتيكِ المجَالسُ لحظَةً","من ذِكرِه بالفخرِ والإعجَابِ",63,"ب",1,0],["لم تَخِرْ جسمِيَ فَرْداً","لَكَ معْ حسمِيَ روحي",64,"ح",2,0],["لم تخالف شرع طه المصطفى","عند من بالله موجود وحي",65,"ي",1,0],["لم تخلُ من صَوبِ دمعٍ بَعدَ مَصرَعِهِ","عَينٌ ولم يَخلُ من ذِكراهُ قَطُّ فَمُ",66,"م",1,0],["لَم تُخطِنا إِذ رَمَتنا","آرام آلِ بِلالِ",67,"ل",1,0],["لَمْ تَخْلُ مِنْ قَلْبِ المُحِبِّ وَحَقِّ مَا","تَرْضَى بِهِ وَبِغَيْرِ ذَا لَمْ أَحْلِفِ",68,"ف",1,0],["لم تخفْ وجداً بعاشقها","حرمةَ الشهر الذي انتهكتْ",69,"ت",1,0],["لَم تُخِلِ صَنعاءَ إلاَّ وهيَ فَخُّ رَدَىً","كالغُلِّ في الجيدِ أَو كالقَيدِ في القَينِ",70,"ن",1,0],["لم تخب نار قطينه حتى ذكت","نار الفراق بقلبي المحزون",71,"ن",1,0],["لم تخشَ رب البرايا","ولم تراقبه مالك",72,"ك",1,0],["لم تخطر الجدوى بخاطره","وكذاك راح وماله خطرُ",73,"ر",1,0],["لمْ تَخْفَ أَشْجاني ولا ظَهرَتْ","فَضَنِيْتُ بَيْنَ السِّرِّ وَالجَهْرِ",74,"ر",1,0],["لم تَخْلُ من زَوْرٍ يُشَاهِدُ مَعْرَكاً","ذا قَسْطَلٍ فيَشِيبُ فيه أمْرَدا",75,"د",2,0],["لَم تُخلَقِ الشِعرى لَيالي حُرِّمَت","إِذ لا عَزيزَ مِنَ الأَنامِ يَرومُها",76,"م",3,0],["لم تختلف علماؤُها في مُشكلٍ","إلاَّ وردَّ إلى الصواب خِلافَها",77,"ف",3,0],["لم تخش وقع الردى لما صدعت به","والسيف يلمع والخطِّيُّ مُشتَجَر",78,"ر",1,0],["لم تخشيا غَولاً ولا نقمةً","من حاسب باغٍ وذي مطمع",79,"ع",1,0],["لم تخش أهوالَ المَعادِ كأنَّها","بين الميعاد مُقرة بجمودها",80,"د",3,0],["لَم تَخل أَفعالُنا اللاتي نَذل بِها","إِحدى ثَلاث خِصال في مَعانيها",81,"ي",3,1],["لم تخن غربه يد شلاء","أوتروا القوس إنَّ للسهم مرمًى",82,"ا",1,0],["لم تخني ولم أخنك ولا والله","ربي لا خنت من لم يخني",83,"ن",2,0],["لم تخش في اللَه يوماً لوم لائمة","ولم يشب أبداً اخلاصك الضَغَن",84,"ن",1,0],["لم تخله من نصرها هنديّةٌ","زرقاءُ أو خَطِّيَّةٌ سمراء",85,"ا",2,0],["لم تخلُ كعبة خدرها من طائفٍ","والحسنُ صاحبُهُ يُحَبُّ ويعشقُ",86,"ق",1,1],["لم تخط إن فكرت في نظمها","ولونها من حمة العقرب",87,"ب",1,0],["لم تخنه في مشكلات القضايا","فطنة الحازم اللبيب الرشيد",88,"د",1,0],["لم تخش في مولاكَ لومةَ لائم","حتى أقَرّ به الكفورُ الملحدُ",89,"د",1,0],["لم تخيب من نوال راغباً","لم تمانع عن وصال طالبا",90,"ب",2,0],["لم تُخدِّد وجهَ الثرى بخدود","وهي إذ ذاك آية الأخدود",91,"د",1,0],["لم تخن عهدَ تربها بوعودِ","وهي إذ ذاك لم تفِ بالوعود",91,"د",1,0],["لم تختلف فيها العقول وشأنها","نصب الخلاف كما تقدم قبلها",92,"ل",3,0],["لَم تَختَلِجهُ القِصارُ الدُنُّ في شَبَهٍ","وَلَم يُقَدنَ لِفَأسِ العاضِدِ الخالي",93,"ل",2,0],["لم تخن عهدها ولم تفش سرا","لا ولم تعص للهوى أحكاما",94,"م",2,0],["لم تخل في ارض التمدن بقعة","من غرس منفعة إليه ينتمي",95,"م",2,0],["لم تُخلَقِ الكعبةُ لولا كربلا","وكَربلا نالَت بمن فيها العُلا",96,"ل",2,0],["لم تخف حاله على الإمام","وفعله في سالف الأيام",97,"م",1,0],["لم تَخشَ في اللَهِ لَومَ اللائمين وقد","جاهَرتَ بِالحَقِّ وَالغَيرُ انزَوى جُبنا",98,"ن",2,0],["لم تخلق الأيام جدةَ ودِّه","أبداً ولا نجمي لديه آفل",99,"ل",1,0],["لم تختلف وَصْفاتُه وصفاتُهُ","من حيث أن جيمعها إتقان",100,"ن",1,0],["لَم تَخلُ منه أَبَداً مُهجَتي","إِذا خَلا من شخصه ناظِري",101,"ر",2,0],["لم تُخْطِ قامةُ رُمحِه أغراضَها","وإصابةُ الأغراضِ نيلُ أماني",102,"ن",2,0],["لمتخذ دار الخِلافة مَوطِناً","وَنَشر سَجاياه طوى الأَرض أَجمَعا",103,"ع",2,0],["لم تخلدهم الكنوز التي قد","كنوزها من فضة ونضار",104,"ر",1,0],["لم تخلق النفس في أمواهه عبثا","تلك الحسان ولا الأغوال في التيه",105,"ي",2,0],["لم تخل أرضٌ فيك من فاتحٍ","وفيلقٍ يتبعه فيلق",106,"ق",1,0],["لم تخلُ من حكمةٍ يَوماً وَقائِعُهُ","وَهي الهُدى لِقُلوبٍ مُستَنيراتِ",107,"ت",1,0],["لم تخشَ فِيه اللَه يومَ منعتَه","حقّ التحيةِ حيثُ مرَّ مسلِّما",108,"م",2,0],["لم تخل من تنغيص عيش الفتى","فحسبه ان يرزق القوتا",109,"ت",2,0],["لم تخط فيها خطوة إلاّ وقد","