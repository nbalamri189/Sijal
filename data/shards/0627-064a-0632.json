{"poems":[[95,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[53,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[53,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[53,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[47,"قالت الشيب بدا قلت أجل","https://www.aldiwan.net/poem65571.html","الطويل"],[30,"وإذا الرجال رأوا يزيد رأيتهم","https://www.aldiwan.net/poem5177.html","الكامل"],[68,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[76,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[41,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"أيزورنا شرخ الشباب فيرتجى","https://www.aldiwan.net/poem22579.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[190,"فقالوا هو الزاهي فقلت ولم زها","https://www.aldiwan.net/poem43447.html","الطويل"],[242,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[422,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[438,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[455,"أيزيد حاربت الملوك ولم يكن","https://www.aldiwan.net/poem707.html",""],[457,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[458,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[469,"سفرت والليل داج فأنارا","https://www.aldiwan.net/poem3476.html","عموديه"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[475,"لعمري لقد جاء العراق كثير","https://www.aldiwan.net/poem4642.html","الطويل"],[510,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[558,"أيزيد يا مغرور ألأم من مشى","https://www.aldiwan.net/poem68337.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34427","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48845","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48753","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59689","الخفيف"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44986","الخفيف"],[1230,"","https://poetry.dctabudhabi.ae/diwan/poem/123608","الكامل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130252","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109005","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96505","الكامل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45416","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83048","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100917","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146340","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199917","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65329","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33115","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91293","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91860","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91256","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120389","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[1901,"أَلا شَدَّ ما ضنّتْ بمعروفها سُعدَي","https://www.poetsgate.com/ViewPoem.aspx?id=160413",""],[4929,"تراب الورد للشعراء خدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199440",""],[5005,"وُد.....","https://www.poetsgate.com/ViewPoem.aspx?id=189352",""],[5121,"عِنَاقُ الأَشْقِيَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=33629",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5212,"رزءُ العليل","https://www.poetsgate.com/ViewPoem.aspx?id=212052",""],[4045,"أيزيد إنك نائم فاستيقظ","https://www.poetsgate.com/ViewPoem.aspx?id=200286",""],[5284,"مُرَادُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[5573,"ارموز خط وبعد شط ودلو بير وعمق طي","https://www.poetsgate.com/ViewPoem.aspx?id=200172",""],[5660,"فَهَل مِن بَلسَمٍ لِلجُرحِ فينا","https://www.poetsgate.com/ViewPoem.aspx?id=23972",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""]],"verses":[["أيُّ زَوْجٍ وَفَتْ وَفَاءَكَ أيَّا","مَ التَّلاَقِي وَبَعْدَهَا لِلْقَرِينِ",0,"ن",1,0],["أيزيدُكَ التَّبْجِيلُ وَالتَّكْرِيمُ","شَرَفاً وَأَنْتَ عَلِيُّ إبْرَاهِيمُ",1,"م",1,1],["أَيُزهي شخْصَ مثلِكَ عند مثلي","أبا عثمان سِرْبَالٌ جديدُ",2,"د",1,0],["أيزعمُ القَدرَ المحتومَ ثبّطه","إن قال ذاك فقد حَلّ الذي عقدا",3,"د",2,0],["أيزخرُ لي بحرُ النوالِ بفضلهِ","وتمطلني في غير حين مِطال",4,"ل",1,0],["أَيُّ زَورٍ لَكِ لَو قَصداً سَرى","وَمُلِمٍّ مِنكِ لَو حَقّاً فَعَل",5,"ل",1,0],["أَيَزيدُ إِنَّكَ لِلمَهَلَّبِ أَدرَكَت","كَفّاكَ خَيرَ خَلائِقِ الأَخيارِ",6,"ر",1,0],["أَيُزارُ في بابِ البُوَيرَةِ راهِبٌ","لَيلاً فَيَدري في الصَباحِ وَيَعلَمُ",7,"م",1,0],["أَيُّ زَمانٍ جادَ إِلّا نَهَب","أَم أَيُّ خَطبٍ جارَ إِلّا ذَهَب",8,"ب",1,1],["أَيَزعُمُ أَن لا يَستَديمَ وَظَهرُهُ","وَأَقرابُهُ قَد شَنَّجَتها كُلومُها",9,"م",3,0],["أَيَزيدُ يَاِبنَ ذَرا الحَوا","صِنِ وَالعَقائِلِ لِلعَقائِل",10,"ل",1,0],["أَيَزيدُ عَمَّ المَجدُ مِن","كَ المُحتَفينَ وَكُلَّ ناعِل",10,"ل",1,0],["أيُّ زَنْدٍ فاقدَحاهُ ثم في","أيِّ كفٍّ فصِلاها بامتِداد",11,"د",1,0],["أَيَزورُنا شَرخُ الشَبابِ فَيُرتَجى","أَم يَستَقِرُّ بِمَنزِلٍ فَيُزارُ",12,"ر",1,1],["أيزرى أيزرى في أُرومة قدرها","عداءُ لئام بالشرور تكيدها",13,"د",3,0],["إيزيسُ ذاتُ المُلكِ حينَ تَوَحَّدَت","أَخَذَت قِوامَ أُمورِها الأَشياءُ",14,"ا",2,0],["أيزهى ولم يزه النبيّ بنفسه","وقد قال إني مثلكم بشرٌ أصلي",15,"ل",2,0],["أَيُّ زَمانٍ قَدْ مَضَى مُسْرِعاً","يَاحَرَّ أنْفَاسِي عَلَى سُرْعَتِهِ",16,"ت",2,0],["أَيُزْعَمُ أَنَّ إدراري لغَيْري","لعَمْرُكَ إنّه كَذِبٌ فَريّ",17,"ي",1,0],["أيزعمُ واشي الحبّ أني سلوتهم","ألا ساء واشي الحبّ ما يتوهم",18,"م",1,0],["أي زَوْرٍ لو سَعى لي قصداً","لشَفى منّي السَّقامَ المُتاحا",19,"ح",2,0],["أيزيد حاربت الملوك ولم يكن","تلقى المحارب للملوك رشيدا",20,"د",2,1],["أيزعم أن الفرس أوصت له به","وحجبه عن غيره ملكها شحَّا",21,"ح",2,0],["أي زادْ شئتمو حُّل لكم","إن يكن عندي وليس الاعتداء",22,"ا",2,0],["أي زور طاف تدنيه النّوى","تخذَ الليل إزاراً حين زارا",23,"ر",2,0],["أيَّ زَهْو ٍ، وأيَّ عافيَة ٍ","حَشَدَ العُمْرُ وهوَ يَحتَشِد ُ؟",24,"د",1,0],["أيزعُمُ أنِّي من كِنانَةَ أوِّلي","وما لي من أُمٍّ هناكَ ولا أبِ",25,"ب",1,0],["أيُّ زعمٍ وقد علموا أنّك","والحياة حبيبان ما افترقا",26,"ق",2,0],["أَيَزيدُ يا مَغرورُ أَلأَمَ مَن مَشى","تَرجو الفَلاحَ وَأَنتَ نُطفَةُ مَزيَدِ",27,"د",1,1],["أَيَزعم القدر المَكتوب أَوقعه","فالضَرب وَالحبس أَيضاً فيهِ مُكتَتبُ",28,"ب",1,0],["أيزهَد في الحسن السفور منزهاً","ويغري بذات الحسن إخفاؤها الحسنا",29,"ن",2,0],["أيزعم ملككم ملكه","وهول القيامة فيما زعم",30,"م",1,0],["أيزيد والودُّ أنجم غضاً","وسواك إن ينتجعهُ هشيم",31,"م",1,0],["أَيُّ زادٍ تَزَوَّدَتهُ يَداه","عامِداً مِن كَبائِرِ الآثام",32,"م",1,0],["أيزيد قد لاقيت منكرة","عجلت بأمك مدخل القبر",33,"ر",1,1],["أيزْعُمُ أقوامٌ رمَوْهُ بظِنَّةٍ","بأن سوفَ تأتيني عقاربُهُ تَسْرِي",34,"ر",2,1],["أيزورني يبكي معي","أو يشتكي شكوى اليتيمه",35,"م",2,0],["أيزيد انك لم تزل","للازد مذ خلقت دعامه",36,"م",2,1],["أَيَزيدُكُن في الحَربِ إِذ هَيَّجتَها","كَأَبيكَ لا رِعشاً وَلا رَعديدا",37,"د",2,0],["أيّ زمان لبست جدته","فارتجعتها أيامه الأخر",38,"ر",1,0],["أَيُّ زَمانٍ نَشَأتَ فيه","كَذي ضِلال بِأَرضِ تيهِ",39,"ه",1,1],["أيزول عهدُك يا حسينُ كأنَّهُ","أوفَى على الآذان وهو كَلاَم",40,"م",1,0],["أَيُزَيّن الإِسلامَ مَنْ","عَمِيَتْ بصيرَتُه وَعَيْنُه",41,"ه",1,0],["أي زور في الكون ما أيدوه","أي حق لم يختضب بالدماء",42,"ا",2,0],["أيزداد كسرُ القلب من كسر جفنه","وضرب كسور في الكسور مُقلّلُ",43,"ل",1,0],["أيزُورُني ليلا وأنشدُ في الدُّجى","قد زار بدرُ التّمّ ليل تمام",44,"م",1,1],["أيزهو لعين المرء ما يتنوَّعُ","ولا شيء في الدنيا من الموت يمنعُ",45,"ع",1,1],["أَيَزعَمُ أَنَّ العامِرِيَّ لِفِعلِهِ","بِعاقِبَةٍ يُرمى بِهِ الرَجوانِ",46,"ن",1,0],["أَيزعم أَني أَتقي البأس لَو عدت","عَواديه أَو أَخشى الظُبَى وَاللهاذما",47,"م",2,0],["أَيزعمون بِأَني ثمّ يدفعني","عَن نيلهم جمعُهم هيهات ما زعموا",48,"م",3,0],["أَيّ زَهر في ابتسام","من رُبى جَدواك فاح",49,"ح",1,0],["أيزوى ابن طه عن منصة جدّه","ويُرضى لها ترب الخلاعة عبشمي",50,"م",2,0],["أيزعم إرغامي وقد ضمنا النسب","ثلاثة إخوانٍ لنا إقرنوس أب",51,"ب",1,0],["ايزعم ان الحق قد بار اهله","فما احد عنه يقوم مناضلا",52,"ل",2,0],["ايزعم قرنه فيها غبازى","فيرميه ويلطأ خلف صخر",53,"ر",1,0],["أيزعُم أنّا قد تَبلنا فؤادَه","ويُضمرُ من فَرطِ الغرامِ لنا الحقدا",54,"د",2,0],["ايزهرُ في خدود الغيدِ حرفي","ويشغل خاطري خصرُ وقَدُّ ؟",55,"د",1,0],["أيزهر خدٌّ ويثمر خدٌّ؟","وينسى شذاه بثغركِ وردُ؟!",56,"د",1,1],["أَيُّ زَهْر ٍذَابَ فِيِنَا فَارْتَوَيْنَا","سَكْرةً طَابَتْ عَلَيْنَا كَالدَّوَاءِ",57,"ا",2,0],["\"أي زهر وصفت، \"\"وابن زهير\"\"\"","\"لم يقل: يا \"\"رياح\"\"! هذا رباحي\"",58,"ح",2,0],["أَيَزيدُ لَنْ تَنْجو بِقَتْلِ حُسَيْنِنا","وَلِذِكْرِنا واللهِ لا تَمْحو وَلَنْ",59,"ن",1,0],["أيزيد إنك نائم فاستيقظ","ومضيع لقوام جاهك فاحفظ",60,"ظ",1,1],["أَيُزْهِرُ بَعْدَ هَذَا الحَالِ قَوْلٌ","وتَحْكِي بَعْدَهُ مَاقَدْ شَعَرْتَا ؟؟",61,"ت",2,0],["ايزيح كرب ايدل درب ايرد كيد يكود ضد","بكل شر يشور ضر يشب كبد يزوود كي",62,"ي",1,0],["أَيَزهَدُ في حِياضِ المَجدِ قَومي","وَ تَهجُرُ أُسدُنا يَوماً عَرينا",63,"ن",2,0],["أَيُّ زَهرٍ لَم يُلامِسهُ النَّدى","أَيُّ رَوضٍ ما رَشًفنا جَدوَلَه",64,"ل",2,0]]}