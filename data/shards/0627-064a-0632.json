{"poems":[[93,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[51,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[51,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[45,"قالت الشيب بدا قلت أجل","https://www.aldiwan.net/poem65571.html","الطويل"],[28,"وإذا الرجال رأوا يزيد رأيتهم","https://www.aldiwan.net/poem5177.html","الكامل"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[74,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[39,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"أيزورنا شرخ الشباب فيرتجى","https://www.aldiwan.net/poem22579.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[187,"فقالوا هو الزاهي فقلت ولم زها","https://www.aldiwan.net/poem43447.html","الطويل"],[238,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[417,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[433,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[451,"أيزيد حاربت الملوك ولم يكن","https://www.aldiwan.net/poem707.html",""],[453,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[454,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[465,"سفرت والليل داج فأنارا","https://www.aldiwan.net/poem3476.html","عموديه"],[466,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[471,"لعمري لقد جاء العراق كثير","https://www.aldiwan.net/poem4642.html","الطويل"],[506,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[554,"أيزيد يا مغرور ألأم من مشى","https://www.aldiwan.net/poem68337.html","الكامل"]],"verses":[["أيُّ زَوْجٍ وَفَتْ وَفَاءَكَ أيَّا","مَ التَّلاَقِي وَبَعْدَهَا لِلْقَرِينِ",0,"ن",1,0],["أيزيدُكَ التَّبْجِيلُ وَالتَّكْرِيمُ","شَرَفاً وَأَنْتَ عَلِيُّ إبْرَاهِيمُ",1,"م",1,1],["أَيُزهي شخْصَ مثلِكَ عند مثلي","أبا عثمان سِرْبَالٌ جديدُ",2,"د",1,0],["أيزعمُ القَدرَ المحتومَ ثبّطه","إن قال ذاك فقد حَلّ الذي عقدا",3,"د",2,0],["أيزخرُ لي بحرُ النوالِ بفضلهِ","وتمطلني في غير حين مِطال",4,"ل",1,0],["أَيُّ زَورٍ لَكِ لَو قَصداً سَرى","وَمُلِمٍّ مِنكِ لَو حَقّاً فَعَل",5,"ل",1,0],["أَيَزيدُ إِنَّكَ لِلمَهَلَّبِ أَدرَكَت","كَفّاكَ خَيرَ خَلائِقِ الأَخيارِ",6,"ر",1,0],["أَيُزارُ في بابِ البُوَيرَةِ راهِبٌ","لَيلاً فَيَدري في الصَباحِ وَيَعلَمُ",7,"م",1,0],["أَيُّ زَمانٍ جادَ إِلّا نَهَب","أَم أَيُّ خَطبٍ جارَ إِلّا ذَهَب",8,"ب",1,1],["أَيَزعُمُ أَن لا يَستَديمَ وَظَهرُهُ","وَأَقرابُهُ قَد شَنَّجَتها كُلومُها",9,"م",3,0],["أَيَزيدُ يَاِبنَ ذَرا الحَوا","صِنِ وَالعَقائِلِ لِلعَقائِل",10,"ل",1,0],["أَيَزيدُ عَمَّ المَجدُ مِن","كَ المُحتَفينَ وَكُلَّ ناعِل",10,"ل",1,0],["أيُّ زَنْدٍ فاقدَحاهُ ثم في","أيِّ كفٍّ فصِلاها بامتِداد",11,"د",1,0],["أَيَزورُنا شَرخُ الشَبابِ فَيُرتَجى","أَم يَستَقِرُّ بِمَنزِلٍ فَيُزارُ",12,"ر",1,1],["أيزرى أيزرى في أُرومة قدرها","عداءُ لئام بالشرور تكيدها",13,"د",3,0],["إيزيسُ ذاتُ المُلكِ حينَ تَوَحَّدَت","أَخَذَت قِوامَ أُمورِها الأَشياءُ",14,"ا",2,0],["أيزهى ولم يزه النبيّ بنفسه","وقد قال إني مثلكم بشرٌ أصلي",15,"ل",2,0],["أَيُّ زَمانٍ قَدْ مَضَى مُسْرِعاً","يَاحَرَّ أنْفَاسِي عَلَى سُرْعَتِهِ",16,"ت",2,0],["أَيُزْعَمُ أَنَّ إدراري لغَيْري","لعَمْرُكَ إنّه كَذِبٌ فَريّ",17,"ي",1,0],["أيزعمُ واشي الحبّ أني سلوتهم","ألا ساء واشي الحبّ ما يتوهم",18,"م",1,0],["أي زَوْرٍ لو سَعى لي قصداً","لشَفى منّي السَّقامَ المُتاحا",19,"ح",2,0],["أيزيد حاربت الملوك ولم يكن","تلقى المحارب للملوك رشيدا",20,"د",2,1],["أيزعم أن الفرس أوصت له به","وحجبه عن غيره ملكها شحَّا",21,"ح",2,0],["أي زادْ شئتمو حُّل لكم","إن يكن عندي وليس الاعتداء",22,"ا",2,0],["أي زور طاف تدنيه النّوى","تخذَ الليل إزاراً حين زارا",23,"ر",2,0],["أيَّ زَهْو ٍ، وأيَّ عافيَة ٍ","حَشَدَ العُمْرُ وهوَ يَحتَشِد ُ؟",24,"د",1,0],["أيزعُمُ أنِّي من كِنانَةَ أوِّلي","وما لي من أُمٍّ هناكَ ولا أبِ",25,"ب",1,0],["أيُّ زعمٍ وقد علموا أنّك","والحياة حبيبان ما افترقا",26,"ق",2,0],["أَيَزيدُ يا مَغرورُ أَلأَمَ مَن مَشى","تَرجو الفَلاحَ وَأَنتَ نُطفَةُ مَزيَدِ",27,"د",1,1]]}