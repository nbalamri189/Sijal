{"poems":[[93,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[51,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[51,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[45,"قالت الشيب بدا قلت أجل","https://www.aldiwan.net/poem65571.html","الطويل"],[28,"وإذا الرجال رأوا يزيد رأيتهم","https://www.aldiwan.net/poem5177.html","الكامل"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[74,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[39,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[46,"أيزورنا شرخ الشباب فيرتجى","https://www.aldiwan.net/poem22579.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"]],"verses":[["أيُّ زَوْجٍ وَفَتْ وَفَاءَكَ أيَّا","مَ التَّلاَقِي وَبَعْدَهَا لِلْقَرِينِ",0,"ن",1,0],["أيزيدُكَ التَّبْجِيلُ وَالتَّكْرِيمُ","شَرَفاً وَأَنْتَ عَلِيُّ إبْرَاهِيمُ",1,"م",1,1],["أَيُزهي شخْصَ مثلِكَ عند مثلي","أبا عثمان سِرْبَالٌ جديدُ",2,"د",1,0],["أيزعمُ القَدرَ المحتومَ ثبّطه","إن قال ذاك فقد حَلّ الذي عقدا",3,"د",2,0],["أيزخرُ لي بحرُ النوالِ بفضلهِ","وتمطلني في غير حين مِطال",4,"ل",1,0],["أَيُّ زَورٍ لَكِ لَو قَصداً سَرى","وَمُلِمٍّ مِنكِ لَو حَقّاً فَعَل",5,"ل",1,0],["أَيَزيدُ إِنَّكَ لِلمَهَلَّبِ أَدرَكَت","كَفّاكَ خَيرَ خَلائِقِ الأَخيارِ",6,"ر",1,0],["أَيُزارُ في بابِ البُوَيرَةِ راهِبٌ","لَيلاً فَيَدري في الصَباحِ وَيَعلَمُ",7,"م",1,0],["أَيُّ زَمانٍ جادَ إِلّا نَهَب","أَم أَيُّ خَطبٍ جارَ إِلّا ذَهَب",8,"ب",1,1],["أَيَزعُمُ أَن لا يَستَديمَ وَظَهرُهُ","وَأَقرابُهُ قَد شَنَّجَتها كُلومُها",9,"م",3,0],["أَيَزيدُ يَاِبنَ ذَرا الحَوا","صِنِ وَالعَقائِلِ لِلعَقائِل",10,"ل",1,0],["أَيَزيدُ عَمَّ المَجدُ مِن","كَ المُحتَفينَ وَكُلَّ ناعِل",10,"ل",1,0],["أيُّ زَنْدٍ فاقدَحاهُ ثم في","أيِّ كفٍّ فصِلاها بامتِداد",11,"د",1,0],["أَيَزورُنا شَرخُ الشَبابِ فَيُرتَجى","أَم يَستَقِرُّ بِمَنزِلٍ فَيُزارُ",12,"ر",1,1],["أيزرى أيزرى في أُرومة قدرها","عداءُ لئام بالشرور تكيدها",13,"د",3,0],["إيزيسُ ذاتُ المُلكِ حينَ تَوَحَّدَت","أَخَذَت قِوامَ أُمورِها الأَشياءُ",14,"ا",2,0]]}