{"poems":[[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[563,"نفسي على نفسي الوجود بها نزل","https://www.aldiwan.net/poem34240.html","الكامل"],[563,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122575","الكامل"],[1894,"","https://poetry.dctabudhabi.ae/diwan/poem/198779","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[5829,"درة الدهر الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=152342",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""]],"verses":[["والَحضرُ صابَت عليهِ آسَيةٌ","من ثُغرَةٍ أَيِّدٍ مَناكبُها",0,"ب",3,0],["وَالحَضرُ صابَت عَلَيهِ داهِيَةٌ","من فَوقِهِ أَيِّدٌ مَناكِبُها",1,"ب",3,0],["والحضرة العليا التي","طمع الأعاظم في سخاها",2,"ا",3,0],["والحضرتان له فحضرة ذاته","محض الوجود ووَصفُهُ نظمُ الغزل",3,"ل",1,0],["والحضرة بثي رونقها","فينا إنا نتودده",4,"د",2,0],["والحضرميّ اغتال مَعنَ وناصِرا","معنَ بن زايدة يزيد ومزيدا",5,"د",2,0],["والحضارات والصناعة والفن","ودور العلوم والعرفان",6,"ن",1,0],["والحضرميّ ثمَّ للخيارِ","ثم يزيدُ جاءَ في الآثار",7,"ر",1,0],["والحضارات التي فيها استراحت","ليس للأنواء رأى أن تقاما",8,"م",2,0],["والحضرة العليا تقول لمن اتى","لرحابها اهلا بكم ورادي",9,"د",2,0],["والحضرمي أراد نصرة قومه","قدماه وسط الدار أمر شاغل",10,"ل",1,0]]}