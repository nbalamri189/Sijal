{"poems":[[95,"القلوب والمقل","https://www.aldiwan.net/poem9152.html","المقتضب"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[21,"من يطمس الله عينيه فليس","https://www.aldiwan.net/poem36207.html","مجزوء البسيط"],[7,"من يطلب الدهر تدركه مخالبه","https://www.aldiwan.net/poem2013.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[108,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[141,"الحمد لله ولي الحمد","https://www.aldiwan.net/poem67916.html","الرجز"],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[147,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[228,"سجدت في هيكل الأماني","https://www.aldiwan.net/poem41922.html","مخلع البسيط"],[295,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[325,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[409,"حتام أنت على الغرام معنفي","https://www.aldiwan.net/poem33645.html","الكامل"],[469,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[503,"العلم يكسو الحلل الفاخرة","https://www.aldiwan.net/poem3699.html","السريع"],[534,"لا تشتغل بملبس فكل ذي","https://www.aldiwan.net/poem37214.html","الرجز"],[563,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138226",""],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93485","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70708","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70738","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56595","الكامل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124696","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27917","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27522","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27239","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93982","الرمل"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120159","الكامل"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120164","الكامل"],[3423,"","https://poetry.dctabudhabi.ae/diwan/poem/198782","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66413","الدوبيت"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114545","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40121","الرمل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36248","الدوبيت"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123469","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123470","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62136","الخفيف"],[4718,"من زارني","https://www.poetsgate.com/ViewPoem.aspx?id=137099",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[4832,"لطائف الحب أو مستطرف الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=166711",""],[4578,"فرق المليحة قد أضا أم فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=49398",""],[4994,"سفر في تفاصيل الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=209153",""],[5002,"هلال وحدتنا...","https://www.poetsgate.com/ViewPoem.aspx?id=206180",""],[5198,"بدر التمام","https://www.poetsgate.com/ViewPoem.aspx?id=136234",""],[5261,"خبيئة وخطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=212888",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[6115,"من يطلب المدح كنّه يطلب الذمّه","https://www.poetsgate.com/ViewPoem.aspx?id=180489",""],[6115,"لايضيق الصدر ولا يعتريه الفزه","https://www.poetsgate.com/ViewPoem.aspx?id=180523",""],[2220,"قل كيف يسكن قلب لا يحيط به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11195&r=&rc=69",""]],"verses":[["من يطيق حملته","من له بها قبل",0,"ل",1,0],["مَن يُطالِعهُ وَيَستَأنِس بِهِ","يَجِدُ الجِدَّ وَلا يَعدَم دِعابا",1,"ب",2,0],["مَن يَطمُسُ اللَهُ عَينيهِ فَلَيسَ","لَهُ نورٌ يُبيِّنَ بِهِ شَمساً وَلا قَمَرا",2,"ر",2,1],["مَن يَطلِبِ الدَهرُ تُدرِكهُ مَخالِبُهُ","وَالدَهرُ بِالوِترِ ناجٍ غَيرُ مَطلوبِ",3,"ب",1,1],["مَنْ يُطَالِعْ آيَاتِهِ يَرَ فِعْلَ الشُّ","هُبِ الْبِيضِ فِي الدَّيَاجِي السُّود",4,"د",1,0],["مَنْ يَطْلُبِ العَلْيَاءَ يُدْرِكْ أَوْجَهَاً","مُتتَبِّعاً وَالْفَائِزُ المُتَتَبِّعُ",5,"ع",1,0],["مَنْ يطلبِ الخبر محضًا عزَّ مطلبُهُ","فإنما فطرةُ الأشياء تأباه",6,"ا",2,0],["مَن يُطِعِ اللَهَ فَقَد أَصابا","أَو يَعصِهِ أَوِ الرَسولَ خابا",7,"ب",2,0],["من يطَّلِعْ شَرَفا فيعلمَ لي","هل روَّح الرُّعيانُ بالإبلِ",8,"ل",1,0],["مَن يَطَّبيهِ الطَرفُ يَحمِلُ فارِساً","مُتَلَبِّباً لا الطَرفَ وَهوَ كَحيلُ",9,"ل",1,0],["مَن يَطلُبُ المَجدَ في حَياةٍ","فَليَشتَرِ المَجدَ بِالزَفيرِ",10,"ر",1,0],["من يطلب الأمر الخطير","يضحّ بالشىء الخطير",11,"ر",1,0],["مَن يُطِق جَورُهُ وَجَورُ جُفونِ","هِيَ سُكري مِن غَيرِ شُربٍ مَدامَه",12,"م",2,0],["من يطو منشور الفضا في وصلهم","نال الذي يهواه غير معنف",13,"ف",1,0],["من يُطلق الألفَ في طلقٍ","كم بين طلِّ الندى والوابل الهطل",14,"ل",1,0],["مَن يَطلُب العزَّ بِغَير التُقى","تَرجعُ عَنهُ نَفسه داخِرَه",15,"ر",2,0],["مَنْ يَطْلُبِ الشّيءَ الْعَظِيمَ عاجِزاً","عَنْ حَمْلِهِ ونَالَهُ وَنَى لَهُ",16,"ل",2,0],["من يطلب الدنيا ترى قلبه","مستغرقاً فيها وأَحْشاه",17,"ا",2,0],["من يطلب الجاه المزيف فهو في","نظري وأيم الحق غر جامح",18,"ح",1,0],["مَن يَطلُبِ الجَورَ لا يَظفَر بحاجَتهِ","وطالِبُ الحقِّ قد يُهدَى له الظَّفَرُ",19,"ر",1,0],["من يطلب الأمر بأساً غير مقترن","بالرأي ضاع عليه البأس والطلب",20,"ب",1,0],["مَنْ يطعْ أمره يعزُّ ويُجزَى","كلَّ خيرٍ ومَنْ يحاربْه يُجزَى",21,"ز",2,0],["مَنْ يطلبِ الخيرَ مِنْ لِحْزٍ أخي حرجٍ","أضْحى الندى عنه محجوزاً ومحبوسا",22,"س",2,0],["من يطلب منه أعتصا","ماً يمس من غير اعتصام",23,"م",1,0],["من يطرب الغاب بقيثارة","وا لهفة الغاب على الصادحين",24,"ن",1,0],["من يطلبِ الشكر بالإنعام ليس له","ذاك التكرم فابحث أيها العلم",25,"م",1,0],["من يطع الارسالَ صِدقاً فقد","أطاع من أرسلهم والسلام",26,"م",1,1],["من يطمئن إلى تحصيل فائته","فإن ما فاته أعى لمنتبه",27,"ه",1,0],["من يطلبُ طورَ المجدِ بها","من يكسبُ نورَ الوُجدِ بها",28,"ه",2,0],["من يطلب الخُلدَ فليعمل لسيرتِه","يَفنى الوجودُ ولكن تخلدُ السِّيرَ",29,"ر",1,0],["من يطع مولاه يجعل","جنة المأوى مقره",30,"ر",2,0],["من يطعم الغرثان من","متزود ومحوصل",31,"ل",1,0],["من يطلب العلياء دون تدبر","لا تعجبن لسعيه أن يخفق",32,"ق",1,0],["من يطلب النصر الكبير سعى له","جيشاً يُوَحّدُ والشعوب تُدَعِّمُ",33,"م",1,0],["من يطعمه يقول من لذّته","هذا بسراً أطيب منه رطبا",34,"ب",2,0],["مَن يطلُبِ الخَلاصَ نالَه الأسَى","وفي خُطوبِ الناسِ للناسِ أُسَى",35,"س",2,0],["منيطةٌ بكم الذكرَ الجميلَ كما","تنيطُ حسناءُ عقدَ الدُّر في عُنُقِ",36,"ق",1,0],["من يطلب الدنيا بغير مخذّم","فليخذم الحسرات والإذلالا",37,"ل",2,0],["مَنْ يُطِعْ يَنْجُ وَمَن يَعْصِ يكن","من غداةٍ عبْرَةً للآخَرين",38,"ن",1,0],["من يطلب الكل يفتح الكل","والالف مثل واحد في العد",39,"د",1,0],["مَن يُطلِعُ صاحبي عَلى أَوصابي","مَن يُبلِغُهُ رِسالَةً من صابِ",40,"ب",1,1],["مَن يطلبِ المجدَ في الإقدامِ نائلُه","إنَّ اكتسابَ المنى بالجِدِّ والسهَر",41,"ر",1,0],["مَن يطلبِ المجدَ لا يخشى عوارضَهُ","إن العوارضَ قد تَمضي ولا أثَرا",42,"ر",2,0],["من يطع ربه تطعه الليالي","وتجئه الورى وهم خدام",43,"م",1,0],["من يطرد المقفي ألا واعذابه","يجيه من الحقران مايطفح الكيل",44,"ل",1,0],["من يطلب العليا عن الذل والعيب","لو انقتل سبعين كرة فلا تاب",45,"ب",1,0],["من يطلب الشيء لا يسأم بمطلبه","وإنما الداء كل الداء في السأم",46,"م",1,0],["من يطرق الغصن الرطيب إذا بدا","ويعودُ خد الورد وهو موردُ",47,"د",1,0],["مَنْ يَطلُب السِّلمَ لا يرضى الهَوانَ به","ولا يُقدِّمُ رأسَ العِزِّ قُربانا",48,"ن",2,0],["من يطفئ النار فالدخان يخنقنا","نضحى يدا وبها نقضي على الهبل",49,"ل",1,0],["من يطلق المأسور ويفك قيده","القيد عذبني وحطّم عظامي",50,"م",2,0],["من يطعن الطهر، كيف تردعه","وقد نوي قبلُ ما سيرتكب",51,"ب",1,0],["من يطلب العزّ في أكفانه خَرِقٌ","مثل الغريق الذي في قشّة علقا",52,"ق",2,0],["من يطرق الباب ماهذا البشير اتى","فارتدّٓ طرفي حزيناً مثل ابوابي",53,"ب",2,0],["من يطفي في ضلوع الشعر ناره","من يشتت عن عقول الناس حيره",54,"ر",2,0],["مَنْ يَطلُبِ الثَّأرَ يَركَبْ نَحوَ حُمرَتِهِ","زَوارِقَ الدَّمِ لا رَجعَ المَواوِيلِ",55,"ل",1,0],["من يطلب المدح كنّه يطلب الذمّه","هذا الكلام الصحيح وفيه براهانه",56,"ن",2,1],["من يطيع ابليس لقاّه الهوان وغزه","واتلفه والقاه من حصن حصين وازي",57,"ز",2,0],["من يطمئن إلى تحصيل فائتة","فإن ما فاته أعلى لمنتبه",58,"ه",1,0]]}