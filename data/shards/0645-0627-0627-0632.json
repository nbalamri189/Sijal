{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[88,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[49,"أما من الموت لحي نجا","https://www.aldiwan.net/poem10321.html","السريع"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[49,"أمَا منَ المَوْتِ لِحَيٍّ لجَا؟","https://www.poetsgate.com/ViewPoem.aspx?id=16958",""],[143,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[186,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[210,"بقوامه والطلعة الغراء","https://www.aldiwan.net/poem13313.html","الكامل"],[261,"من بسنا وجهه دهانا","https://www.aldiwan.net/poem38160.html","مخلع البسيط"],[275,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[377,"ما أزمتي اشتدت لوقر خطيتي","https://www.aldiwan.net/poem59284.html","الكامل"],[429,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"]],"verses":[["ما ازْدَدْتَ بالتّمْحيصِ إلا جدّةً","ونضَوْتَ منْ خِلَعِ الزّمانِ لَبيسا",0,"س",2,0],["ما ازدان صدراكما شيئاً بحَملهما","بل أصبحا في كلا صدريكما دَرَنا",1,"ن",2,0],["ما أَزيَنَ الحِلمَ لِأَربابِهِ","وَغايَةُ الحِلمِ تَمامُ التُقى",2,"ا",1,0],["ما أَزيَنَ الجودَ مِن حَليفٍ","ما أَشيَنَ البُخلَ لِلبَخيلِ",3,"ل",1,0],["ما أزْهَدَ المرءَ إذا لم يجِدْ","وأبعد الزهدَ عن الواجد!",4,"د",1,0],["ما أزينَ الحِلْمَ لإصحابهِ","وغاية ُ الحِلْمِ تمامُ التُّقَى",5,"ا",1,0],["ما أَزمَعوا هَرَباً وَلا فُلّوا شَباً","إِلّا وَأَنتَ عَلى التَرَجُّلِ مُزمِعُ",6,"ع",1,0],["ما ازددت بالحرص رزقا فوق ما هولي","ولا حرمت بتقصير ولا فشل",7,"ل",1,0],["ما ازور الحاظا بمجلس لذة","الا حلا شربي على الزوراء",8,"ا",2,0],["ما ازداد حباً لنا محب","إلا أراه الهوى هوانا",9,"ن",2,0],["ما أزْمَع الإيغال في أكْنَافِها","إلاّ تصَيّد عَزْمُهُ زُعَمَاءَها",10,"ا",3,0],["ما أزمتي اشتدَّت لوِقرِ خطيَّتي","إلّا وهانت بافتتاح البسملهْ",11,"ل",2,1],["ما أزاح اللثام إلّا وبتنا","في رياضٍ من وجهه القمري",12,"ي",1,0]]}