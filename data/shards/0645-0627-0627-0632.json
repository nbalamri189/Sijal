{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[90,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[51,"أما من الموت لحي نجا","https://www.aldiwan.net/poem10321.html","السريع"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[108,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[51,"أمَا منَ المَوْتِ لِحَيٍّ لجَا؟","https://www.poetsgate.com/ViewPoem.aspx?id=16958",""],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[190,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[214,"بقوامه والطلعة الغراء","https://www.aldiwan.net/poem13313.html","الكامل"],[266,"من بسنا وجهه دهانا","https://www.aldiwan.net/poem38160.html","مخلع البسيط"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[382,"ما أزمتي اشتدت لوقر خطيتي","https://www.aldiwan.net/poem59284.html","الكامل"],[435,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87009","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86777","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86657","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87210","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87110","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87058","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86794","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86622","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87219","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87216","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120109","المنسرح"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69238","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56571","المنسرح"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128301","البسيط"],[215,"","https://poetry.dctabudhabi.ae/diwan/poem/116148","البسيط"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17546","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26519","الكامل"],[2164,"","https://poetry.dctabudhabi.ae/diwan/poem/101864","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67877","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109780","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130071","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48324","الكامل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114676","الكامل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32699","البسيط"],[4902,"ياصغير مايكبرني لقب","https://www.poetsgate.com/ViewPoem.aspx?id=22586",""],[5425,"الرِهانْ","https://www.poetsgate.com/ViewPoem.aspx?id=207506",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""]],"verses":[["ما ازْدَدْتَ بالتّمْحيصِ إلا جدّةً","ونضَوْتَ منْ خِلَعِ الزّمانِ لَبيسا",0,"س",2,0],["ما ازدان صدراكما شيئاً بحَملهما","بل أصبحا في كلا صدريكما دَرَنا",1,"ن",2,0],["ما أَزيَنَ الحِلمَ لِأَربابِهِ","وَغايَةُ الحِلمِ تَمامُ التُقى",2,"ا",1,0],["ما أَزيَنَ الجودَ مِن حَليفٍ","ما أَشيَنَ البُخلَ لِلبَخيلِ",3,"ل",1,0],["ما أزْهَدَ المرءَ إذا لم يجِدْ","وأبعد الزهدَ عن الواجد!",4,"د",1,0],["ما أزينَ الحِلْمَ لإصحابهِ","وغاية ُ الحِلْمِ تمامُ التُّقَى",5,"ا",1,0],["ما أَزمَعوا هَرَباً وَلا فُلّوا شَباً","إِلّا وَأَنتَ عَلى التَرَجُّلِ مُزمِعُ",6,"ع",1,0],["ما ازددت بالحرص رزقا فوق ما هولي","ولا حرمت بتقصير ولا فشل",7,"ل",1,0],["ما ازور الحاظا بمجلس لذة","الا حلا شربي على الزوراء",8,"ا",2,0],["ما ازداد حباً لنا محب","إلا أراه الهوى هوانا",9,"ن",2,0],["ما أزْمَع الإيغال في أكْنَافِها","إلاّ تصَيّد عَزْمُهُ زُعَمَاءَها",10,"ا",3,0],["ما أزمتي اشتدَّت لوِقرِ خطيَّتي","إلّا وهانت بافتتاح البسملهْ",11,"ل",2,1],["ما أزاح اللثام إلّا وبتنا","في رياضٍ من وجهه القمري",12,"ي",1,0],["ما اِزدان صَدرك مِن نَياشين العُلا","بِأَجلّ ما يَعلو بِهِ مُتناول",13,"ل",1,0],["ما اِزدان دِيوانٌ عَلى طُول المَدى","بِبَديع مَدح في علاك فَريد",14,"د",1,0],["ما اِزدَدت تَشريفاً وَحُزت تَقدّماً","وَرقيت بِالعرفان أَسنى رُتبة",15,"ه",1,0],["ما ازداد مَجدي بامتداحك رفعةً","يُومي إِلَيهِ بحوزها نيشانه",16,"ن",2,0],["ما اِزداد بِالحَزم تَوفيقاً إِلى عَمَلٍ","يَزدان فيهِ بِتَأييد وَإِقدام",17,"م",1,0],["ما اِزددت في العيد تشريفاً بِتهنئة","ختمت فيها بِمقبول الدَعا كلمي",18,"م",2,0],["ما اِزدَهَت مَصر بَهجة بِكَ وَاِزدا","د بأرجائِها الصَفا وَالسُعود",19,"د",1,0],["ما اِزداد تَشريف مَدح فيكَ قَد ملِئَت","بِهِ سِجلات ما يُتلى مِن الكُتُب",20,"ب",1,0],["ما اِزداد نَظميَ تَشريفاً بِتهنئة","مِن الحَضيض بِها للأوج قَد نُقِلا",21,"ل",2,0],["ما ازداد في عيد الولادة بَهجةً","بِبَديع مَدحك وَاِزدَهى دِيوانيه",22,"ن",3,0],["ما أزدن في الحروب إلا","حمامة والعدوّ بازي",23,"ي",1,1],["ما اِزددت في أَدَبي حَرفاً أُسَرَّ بِهِ","إِلّا تزيدت حَرفاً تَحتَه شومُ",24,"م",1,1],["ما أزهد الناس إذ ترغبهم","وأطمع الناس إن هم رغبوا",25,"ب",3,0],["ما ازداد بالخلق ملكاً حين أنشأهم","ولا يريد بهم دفعاً لمضطهد",26,"د",1,0],["ما ازددتُ خوفا على فؤادي","إلا وزدتم صفا وأمنا",27,"ن",2,0],["ما اِزدَدتُ في أَدَبي حَرفاً أُسِرُّ بِهِ","أَلا تَبَيَّنتُ حَرفاً تَحتَهُ شومُ",28,"م",1,1],["ما اِزدادَ إِلّا رِفعَةً بِنُكولِهِ","وَاِزدادَتِ الأَعداءُ عَنهُ نُكولا",29,"ل",2,0],["ما أزهرت قط لولاهم بساكنها","أرض ولا أخضر من أشجارها ورق",30,"ق",1,0],["ما ازدَدْتَ إلاَّ من قريشٍ بُعدا","أو كنتَ إلاَّ مَصقَليًّا وَغدا",31,"د",2,0],["ما ازهد الانسان في ساعاته","واشد صبوته الى اعوامه",32,"م",2,0],["ما اِزداد دَهري في التعنُّت والأذى","إلّا بلغتُ من العلا ما يصعبُ",33,"ب",1,0],["ما أزْهَرَتْ للمَكْرُماتِ حدائِقٌ","إلا غدَتْ يُمْنى يَديكَ تُرودُها",34,"د",3,0],["ما ازددت حين وليت الا خسة","كالكلب أنجس ما يكون اذا اغتسل",35,"ل",1,0],["ما ازددت من أدبي حرفاً أسر به","إلا تزيدت حرفاً تحته شوم",36,"م",1,1],["ما أزل وراسي يشم المهب","لوبقى من شمر طفل غرير",37,"ر",1,0],["ما أَزْعَجَتْنِيْ سَكْرَةٌ ضَيَّعتُها","إِنِّي أُحِبُّكِ كَيْ أَفِيْقَ وأَسْكَرَا",38,"ر",2,0],["مَا ازدَدتُ مِنْ مَكرٍ بِوَثبَتِها","إِلَّا حَرِيقًا أَجَّهُ وَقدُ",39,"د",1,0],["مَا ازْدَدْتُ - فِي ظَنِّي - بِأَمْسِيَ حِيرَةً","وَ اليَومَ لَنْ أَحْتَارَ فِيهِ وَ لَنْ أَظُنَّهْ",40,"ن",2,0],["ما أزهرت عندي المنى لو لم يكن","زرع الهوى عينيكِ في شباكي",41,"ك",2,0]]}