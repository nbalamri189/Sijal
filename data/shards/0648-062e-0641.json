00,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[424,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[429,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[429,"كتبت ومن لي أن تكون أناملي","https://www.aldiwan.net/poem12554.html","الطويل"],[429,"يا ذرويا كان في حبه","https://www.aldiwan.net/poem12643.html","السريع"],[436,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[451,"لمن النجوم رقصن فوق خميلة","https://www.aldiwan.net/poem61633.html","الكامل"],[456,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[456,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[456,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[456,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[456,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[462,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[462,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[462,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[462,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[462,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[466,"يا من علقت بحبل حبه","https://www.aldiwan.net/poem60455.html","مجزوء الكامل"],[475,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[484,"ألا أبلغ سهيلا أنني","https://www.aldiwan.net/poem485.html",""],[498,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[573,"فارقت من كنت له مالكاً","https://www.aldiwan.net/poem2700.html","السريع"],[573,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[573,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"]],"verses":[["وَخَفَّت قُلوبٌ مِن رِجالٍ كَما هَفَت","نَزائِعُ طَيرٍ غُدوَةً بِالقَوادِمِ",0,"م",1,0],["وَخَفيري في غَياهِبِها","سابِحٌ ضَمَّنتُهُ الأَمَلا",1,"ل",2,0],["وَخَفائِفاً فُجِعَت بِكُلِّ حَقيبَةٍ","مَلأى وكُلِّ مَزادِ ماءٍ أَثجَلِ",2,"ل",1,0],["وَخَفَّفتُ عَن أَيدي الأَقارِبِ ثِقلَهُ","وَحَمَّلتُهُ ثِقلَ الجَنادِلِ وَالنَقا",3,"ق",2,0],["وَخَفِ السِقاطَ عَلى الَّذينَ عَلَوا","وَمِنَ العُلُوِّ يُحاذِرُ الوَقصُ",4,"ص",1,0],["وخَفَّتْ عليهِ وطْأَةُ الدّهْرِ فيهِمُ","عشيّةَ ألقى عِندهُمْ ثِقْلَ مَغرَمِ",5,"م",1,0],["وخَفَضْتَ الجَناحَ في الأرْضِ حتّى","لمْ تدَعْ فوقَ ظهْرِها منْ جُناحِ",6,"ح",1,0],["وخَفْ إنْ كَذَبْتَ طُرُوَّ افتِضاحِ","فَما كَذَبَ الفَجْرُ إلا افْتَضَحْ",7,"ح",1,0],["وَخَفَّ لِتَوْدِيعِي وَتَشْييعِ رِحْلَتِي","أَخُو كُلِّ إِيثَارٍ وَكُلِّ وَفَاءِ",8,"ا",2,1],["وَخِفتَ مَقامَ اللَهِ في كُلِّ مَوقِفٍ","فَخافَكَ أَهلُ الشَكِّ وَالنَزَغاتِ",9,"ت",1,0],["وَخَفِّف مِن مُصابِ الشَرقِ فينا","فَنَحنُ عَلى رِجالِ الغَربِ ثِقلُ",10,"ل",1,0],["وَخَفَّضتُ مِن حُزني عَلى مَجدِ أُمَّةٍ","تَدارَكتَها وَالخَطبُ لِلخَطبِ يَعتَلي",11,"ل",2,0],["وَخِفتُكَ حَتّى اِستَنزَلَتني مَخافَتي","وَقَد حالَ دوني مِن عَمايَةَ نيقُ",12,"ق",1,0],["وخفِّف الحزن إنَّا لاحقون بمن","مضَى فأمضَى شَبَاة الحادث الأشِب",13,"ب",1,0],["وخفِّف ما نلقى من الحزنِ أننا","بمنْ غابَ عنَّا لاحقون بترتيب",14,"ب",1,0],["وخفَّ ذهني فكلامي على الأ","قلامِ ميتٌ فوقَ أعواد",15,"د",1,0],["وخفف الحزن إني لا حق بهم","وإن صرف الردى بالخلق كرار",16,"ر",1,0],["وخفف عن أحشاه وهجاً لو أنه","سحائب ضيف عن قريب تقشع",17,"ع",1,0],["وخفت على قصدي سواك من الورَى","فألفيته من جود كفك في اليمّ",18,"م",1,0],["وخفناك وقد تعفو","وقلب المرء خفّاق",19,"ق",1,0],["وخفِيُّ الحديثِ يَنْمِي فيُحيِي","بعدما ماتت الضغائن ذحلا",20,"ل",2,0],["وخِفْتُ عليكَ عاديةَ اللَّيالي","فبتُّ الليلَ أرقبُ كُلَّ نجم",21,"م",1,0],["وَخَفِّض عَلَيكَ مِنَ النائِباتِ","وَلا تَكُ مِنها كَئيباً بِشَر",22,"ر",1,0],["وَخِفتُ إِعراضَها عَنّي فَقُلتُ إِذَن","هُوَ الَّذي أَبَداً يَبكي مِنَ الزَمَنِ",23,"ن",1,0],["وخفوق الفؤاد في ساعة التك","وين داع إلى سكون الفؤاد",24,"د",1,0],["وَخُفوقُ قَلبٍ لَو رَأَيتِ لَهيبَهُ","يا جَنَّتي لَظَنَنتِ فيهِ جَهَنَّما",25,"م",2,0],["وخفَّاقةٍ طوعَ الرياحِ كأنَّها","كواسِرُ دُجْنٍ اِلتقتها الأهاضيبُ",26,"ب",1,0],["وَخِفنا أَن يَكونَ المَو","تُ قَد فاجاكَ أَو كَرَبا",27,"ب",2,0],["وَخَفَّضَ مِن تَناوُلِنا سُهَيلٌ","فَقَصَّرَ وَاِستَهَلَّ الفَرقَدانِ",28,"ن",1,0],["وخِفْتَ عليه من الخَلَواتِ مني","ولم تَكُ بينَنا حالٌ تُخافُ",29,"ف",1,0],["وخفَّ عليه ثِقْلُ الدِّرعِ حتى","كأنَّ دروعَه سَرَقُ الثِّيابِ",30,"ب",1,0],["وَخِفتَ أَبا جَهلٍ فَأَصبَحتَ تابِعاً","لَهُ وَكَذاكَ الرَأسُ يتبَعُهُ الذَنَب",31,"ب",1,0],["وَخَفِ القِيامَةَ ما اِستَطَعتَ فَإِنَّما","يَومُ القِيامَةَ يَومُ كَشفِ المُخبَآتِ",32,"ت",1,0],["وَخَفِ الإِلَهَ فَإِنَّهُ لَكَ ناظِرٌ","وَكَفى بِرَبِّكَ زاجِراً وَسَئولا",33,"ل",2,0],["وَخَفَّض عَنكَ نورَ الدينِ حُزناً","تَكادُ الراسِياتُ بِهِ تَذوبُ",34,"ب",1,0],["وخفتُ عليه عينَ سحرٍ تُصيبُهُ","فصَيّرْتُ تعويذي له آيةَ الكرسي",35,"ي",1,0],["وَخَفّاقَةِ الراياتِ في جوْفِ نقْعِها","ترى الجُرْدَ فيها بالكماة تَكَدّسُ",36,"س",1,1],["وخفتُ على بناتِ الفكرِ يتماً","فإنَّ الشيبَ ينذرُ بالرواحِ",37,"ح",1,0],["وَخُفِّضَ عَنّي النَومُ أَقبَلتُ مِشيَةَ ال","حُبابِ وَرُكني خَشيَةَ الحَيِّ أَزوَرُ",38,"ر",1,0],["وَخَفَّضَ مِن صيتِ الأَبِيِّ وَصَوتِهِ","وَزَلزَلَ مِن رُكنِ العَصِيِّ وَضَعضَعا",39,"ع",2,0],["وَخَفَّ بِقَلبِيَ فيهِ الهَوى","وَلاعَبَ قُرطانَهُ شِنفُهُ",40,"ف",2,0],["وخفَايا الغيبِ للهِ الذي","يَعلمُ السّرَّ ويَدرِي مَوقِعَهْ",41,"ع",2,0],["وخفَّ أبو سُفيانَ يكذبُ نفسَهُ","ويُشهِدُها من خيفةٍ كيف يحتال",42,"ل",1,0],["وخفّ ذَوُو الحلومِ الراسياتِ","فأصبحتِ الممالكُ راجفاتِ",43,"ت",1,0],["وخَفّوا يُريدونَ القِتالَ فَردَّهم","نبيٌّ يَردُّ الشَّرَّ والشّرُّ زاحِفُ",44,"ف",1,0],["وَخُفِّفَت النُذورُ وَأَردَفتهُم","فُضولُ اللَهِ وَاِنتَهَتِ القُسومُ",45,"م",1,0],["وَخَفَّضَ جَأشي أَنَّ كُلَّ اِبنِ حُرَّةٍ","إِلى حَيثُ صِرتَ لا مَحالَةَ صائِرُ",46,"ر",1,0],["وَخَفِيَّةٍ بِالفِكرِ قَد ناجَيتَها","وَعَواقِبٍ بِالرَأيِ قَد أَبصَرتَها",47,"ت",3,0],["وَخِفْتُ مِنْ عَتْبِهِمْ عَلَيَّ كما","خافَ العَتاهِي العَتْبَ مِنْ عُتْبَهْ",48,"ب",2,0],["وَخَفَت عَن كُلِّ عَينٍ","وَخَفَت عَن كُلِّ دَلِّ",49,"ل",1,0],["وَخُفّاً واسِعاً مِن تَحتِ بُردٍ","مِنَ الديباجِ مِن نَهبِ الهُمامِ",50,"م",1,0],["وَخِفنَ الضِحى مِن نَومِهِنَّ عَلى الضُحى","فَأَقبَلنَ إِقبالَ الغُصونِ المَوائِدِ",51,"د",1,0],["وَخَف شَرَّ الأَصاغِرِ مِن بَنيهِ","وَقُل ما شِئتَ في أُسدٍ وَأَجرِ",52,"ر",1,0],["وَخَفَّ بِالجَهلِ أَقوامٌ فَبَلِّغهُم","مَنازِلاً بِسَناءِ العِزِّ تَلتَفِعُ",53,"ع",1,0],["وَخَف حَيَوانَ هَذي الأَرضِ وَاِحذَر","مَجيءَ النَطحِ مِن روقٍ وَجُمِّ",54,"م",1,0],["وخفقتَ تحت دَجاهُ من وَجَلِ","كالطيرِ تحت الخنجر الصلْتِ",55,"ت",1,0],["وخَفّتْ ثَقالٌ في المجالِسِ للنّوَى","فأهْدى لها ربُّ الغَمامِ ثِقالَها",56,"ل",3,0],["وخفقتْ كتائبُ الإسلام","في البحر أعلاماً على أعلام",57,"م",1,0],["وخفت فجاءات الردى فسبقتها","بوثبة جبار إلى الذروات",58,"ت",1,0],["وخِفْتُ من الغصن إذ تمتمتْ","بأُذْنيَ أوراقهُ كِلْمَتَينْ",59,"ن",1,0],["وَخِفْنَ الضِّحَى مِنْ نَوْمِهِنَّ عَلَى الضُّحَا","فأقبلن إقبال الغصون الموائد",60,"د",1,0],["وخَفيُّ كيدٍ حيثُ يسمو كائدٌ","ومن المكايدِ جالبٌ للعار",61,"ر",1,0],["وخَفُّوا لبيت المال يستنهضونَهُ","وكان على فضِّ المشاكل أقدَرا",62,"ر",2,0],["وَخُفوق الرِياح شَق جُيوب","وَبُكاء الغَمام نَثر عُقود",63,"د",1,0],["وَخَفِّض عَلَيكَ القَولَ وَاِعلَم بِأَنَّني","مِنَ الأَنَسِ الطاحي الجميعِ العَرَمرَمِ",64,"م",1,0],["وخفْ قولَ الجماعة أن يقولوا","مقدمنا من الأهوال ريِعَا",65,"ع",2,0],["وخفَّف الخطبَ بعد شدّته","أَنْ كُلُّ حىّ لأمِّه الهَبَلُ",66,"ل",1,0],["وَخَفَّفَ وِزراً كانَ أَنقَضَ ظَهرَه","وَشَدَّ بِروحِ القُدسِ جِبريلَ أَزرَهُ",67,"ه",1,0],["وخفف نفل الصوم فيها عن الورى","ذنوباً عظاما حملها أثقل الظهرا",68,"ر",2,0],["وخفَّ كل حليمِ منك أذهله","أمرٌ به عن شروط الحلم قد غَفلا",69,"ل",2,0],["وَخَف سَيفَ بَدرِ الدِينِ وَاِحذَر فَإِنَّهُ","لَأَغيَرُ مِن لَيثٍ جَرِيِّ المَقادِمِ",70,"م",1,0],["وَخُفوقُ قَلبي بِالشُجونِ فَهَل تَرى","يَبغي لِحاقَ الحَيِّ حَيثُ تَحَمَّلا",71,"ل",2,0],["وخفوقِ القلوبِ ضربٌ من","التسبيحِ عندَ اللقاءِ والتهليلِ",72,"ل",1,0],["وخفتُ من الهموم ذهابَ عقلي","فطارِدني بطاردة الهمومِ",73,"م",1,0],["وَخَفَّت اِلَيهِ وَاِرتِعاشَةُ جِسمِها","يُلَوِّنُها البَدرُ الحييُّ المصوِّرُ",74,"ر",1,0],["وَخَفَّ هومير بِالإِلياذِ محرقها","أَمامَ عَينَيكَ بخوراً وَقُربانا",75,"ن",2,0],["وخُفوقَ قلبي عندَ ذكركِ هَيْبةً","لك واطّراحِي فيكِ كُلَّ عذول",76,"ل",1,0],["وَخِفنَ عَلى الحُسن أَن يَستَتيهَ","الحاظَنا فَاِتَّخَذنَ الهِجالا",77,"ل",2,0],["وَخَف صارِماً هَزَّ المَدِيحُ فِرِنْدَهُ","حَبِيبٌ إِليه أَنْ يُهَزَّ ويُنْدَبَا",78,"ب",2,0],["وخفت نواها من جَنوب عُنيزةٍ","كما خفّ من نيلِ المرامي جفيرُها",79,"ر",3,0],["وَخَفَّ المَوازينُ بِالكافِرينَ","وَزُلزِلَتِ الأَرضُ زِلزالَها",80,"ل",3,0],["وخفينا من النحول ولكن","عن رقيب وحاسد ما خفينا",81,"ن",2,0],["وخفض عيش بدهر","من أهله ضقت ذرعا",82,"ع",2,0],["وَخِفتُ وَقَد وَقاني اللَهُ مِن أَن","أَرى يَوماً عَبوساً قَمطَريرا",83,"ر",2,0],["وَخفَّفوه بِحَذفٍ مثل فِعلهمُ","في هَيِّن وَلهذا الحَذف أَنحاءُ",84,"ا",2,0],["وخفف رداء الظهر عن حمل ذمة","وأسقط عن المشغول حرمة أحدان",85,"ن",1,0],["وَخفقِ أَحشائي وَهجرِ الكرى","وَلونِ وَجهي الكاسفِ الحائلِ",86,"ل",1,0],["وَخَفَّت خِباها مِن جَنوبِ عُنَيزَةٍ","كَما خَفَّ مِن نَيلِ المَرامي جَفيرُها",87,"ر",3,0],["وَخِفْتُ إذا أَنشدْتُهُ حِذْقَ نَقْدهِ","فَأَرجُو لَهُ نَقْداً وَأَخْشَى لهُ نَقْدا",88,"د",2,0],["وَخِفْتُ عَلَيهِ مِن نَظَرِي","فَفَاضَ الدَّمْعُ وَابتَدَرا",89,"ر",2,1],["وَخِفْتُ لِغَرْقي من النِّيلِ أَنْ","يُقالَ بِنارِ السِّراجِ احتَرَقْ",90,"ق",1,0],["وخَفَّ الحُسامُ بكفّ الكَميّ","وكأْسُ المُدامِ بكَفِّ النّديم",91,"م",1,0],["وَخَفَّفَ اللَهُ عَن قَلبي بِما حَمَلَت","مِنها يَمينِيَ مِن فَضلٍ وَإِن ثَقُلا",92,"ل",2,0],["وخفضت رايات العداوة عندما","أبصرت رايات السلامة تَخفُق",93,"ق",1,0],["وَخِفت أَن يَرميَ مِن","يَعذُلُني بِالشَرر",94,"ر",1,0],["وخفضت مرفوعاً بلا سبب","أكذا يجازي كل ذي نبل",95,"ل",1,0],["وخُفوقِ قلب لا يقر قراره","مُضنى بغير هواكمُ لا يولع",96,"ع",1,0],["وخفف ما بي من غرام وغربةٍ","نظام هو الدر 