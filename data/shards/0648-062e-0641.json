تجن الأضلع","https://www.aldiwan.net/poem33683.html","الكامل"],[404,"بروق بأكناف الحمى تتردد","https://www.aldiwan.net/poem33980.html","الطويل"],[404,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[428,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[433,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[433,"كتبت ومن لي أن تكون أناملي","https://www.aldiwan.net/poem12554.html","الطويل"],[433,"يا ذرويا كان في حبه","https://www.aldiwan.net/poem12643.html","السريع"],[440,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[454,"لمن النجوم رقصن فوق خميلة","https://www.aldiwan.net/poem61633.html","الكامل"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[459,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[459,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[465,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[465,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[465,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[465,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[469,"يا من علقت بحبل حبه","https://www.aldiwan.net/poem60455.html","مجزوء الكامل"],[478,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[487,"ألا أبلغ سهيلا أنني","https://www.aldiwan.net/poem485.html",""],[501,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[565,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[576,"فارقت من كنت له مالكاً","https://www.aldiwan.net/poem2700.html","السريع"],[576,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"]],"verses":[["وَخَفَّت قُلوبٌ مِن رِجالٍ كَما هَفَت","نَزائِعُ طَيرٍ غُدوَةً بِالقَوادِمِ",0,"م",1,0],["وَخَفيري في غَياهِبِها","سابِحٌ ضَمَّنتُهُ الأَمَلا",1,"ل",2,0],["وَخَفائِفاً فُجِعَت بِكُلِّ حَقيبَةٍ","مَلأى وكُلِّ مَزادِ ماءٍ أَثجَلِ",2,"ل",1,0],["وَخَفَّفتُ عَن أَيدي الأَقارِبِ ثِقلَهُ","وَحَمَّلتُهُ ثِقلَ الجَنادِلِ وَالنَقا",3,"ق",2,0],["وَخَفِ السِقاطَ عَلى الَّذينَ عَلَوا","وَمِنَ العُلُوِّ يُحاذِرُ الوَقصُ",4,"ص",1,0],["وخَفَّتْ عليهِ وطْأَةُ الدّهْرِ فيهِمُ","عشيّةَ ألقى عِندهُمْ ثِقْلَ مَغرَمِ",5,"م",1,0],["وخفوق الصمت ينبي أنّ في","سرّه ضوضاء زحف طافر",6,"ر",1,0],["وخَفَضْتَ الجَناحَ في الأرْضِ حتّى","لمْ تدَعْ فوقَ ظهْرِها منْ جُناحِ",7,"ح",1,0],["وخَفْ إنْ كَذَبْتَ طُرُوَّ افتِضاحِ","فَما كَذَبَ الفَجْرُ إلا افْتَضَحْ",8,"ح",1,0],["وَخَفَّ لِتَوْدِيعِي وَتَشْييعِ رِحْلَتِي","أَخُو كُلِّ إِيثَارٍ وَكُلِّ وَفَاءِ",9,"ا",2,1],["وَخِفتَ مَقامَ اللَهِ في كُلِّ مَوقِفٍ","فَخافَكَ أَهلُ الشَكِّ وَالنَزَغاتِ",10,"ت",1,0],["وَخَفِّف مِن مُصابِ الشَرقِ فينا","فَنَحنُ عَلى رِجالِ الغَربِ ثِقلُ",11,"ل",1,0],["وَخَفَّضتُ مِن حُزني عَلى مَجدِ أُمَّةٍ","تَدارَكتَها وَالخَطبُ لِلخَطبِ يَعتَلي",12,"ل",2,0],["وَخِفتُكَ حَتّى اِستَنزَلَتني مَخافَتي","وَقَد حالَ دوني مِن عَمايَةَ نيقُ",13,"ق",1,0],["وخفِّف الحزن إنَّا لاحقون بمن","مضَى فأمضَى شَبَاة الحادث الأشِب",14,"ب",1,0],["وخفِّف ما نلقى من الحزنِ أننا","بمنْ غابَ عنَّا لاحقون بترتيب",15,"ب",1,0],["وخفَّ ذهني فكلامي على الأ","قلامِ ميتٌ فوقَ أعواد",16,"د",1,0],["وخفف الحزن إني لا حق بهم","وإن صرف الردى بالخلق كرار",17,"ر",1,0],["وخفف عن أحشاه وهجاً لو أنه","سحائب ضيف عن قريب تقشع",18,"ع",1,0],["وخفت على قصدي سواك من الورَى","فألفيته من جود كفك في اليمّ",19,"م",1,0],["وخفناك وقد تعفو","وقلب المرء خفّاق",20,"ق",1,0],["وخفِيُّ الحديثِ يَنْمِي فيُحيِي","بعدما ماتت الضغائن ذحلا",21,"ل",2,0],["وخِفْتُ عليكَ عاديةَ اللَّيالي","فبتُّ الليلَ أرقبُ كُلَّ نجم",22,"م",1,0],["وَخَفِّض عَلَيكَ مِنَ النائِباتِ","وَلا تَكُ مِنها كَئيباً بِشَر",23,"ر",1,0],["وَخِفتُ إِعراضَها عَنّي فَقُلتُ إِذَن","هُوَ الَّذي أَبَداً يَبكي مِنَ الزَمَنِ",24,"ن",1,0],["وخفوق الفؤاد في ساعة التك","وين داع إلى سكون الفؤاد",25,"د",1,0],["وَخُفوقُ قَلبٍ لَو رَأَيتِ لَهيبَهُ","يا جَنَّتي لَظَنَنتِ فيهِ جَهَنَّما",26,"م",2,0],["وخفَّاقةٍ طوعَ الرياحِ كأنَّها","كواسِرُ دُجْنٍ اِلتقتها الأهاضيبُ",27,"ب",1,0],["وَخِفنا أَن يَكونَ المَو","تُ قَد فاجاكَ أَو كَرَبا",28,"ب",2,0],["وَخَفَّضَ مِن تَناوُلِنا سُهَيلٌ","فَقَصَّرَ وَاِستَهَلَّ الفَرقَدانِ",29,"ن",1,0],["وخِفْتَ عليه من الخَلَواتِ مني","ولم تَكُ بينَنا حالٌ تُخافُ",30,"ف",1,0],["وخفَّ عليه ثِقْلُ الدِّرعِ حتى","كأنَّ دروعَه سَرَقُ الثِّيابِ",31,"ب",1,0],["وَخِفتَ أَبا جَهلٍ فَأَصبَحتَ تابِعاً","لَهُ وَكَذاكَ الرَأسُ يتبَعُهُ الذَنَب",32,"ب",1,0],["وَخَفِ القِيامَةَ ما اِستَطَعتَ فَإِنَّما","يَومُ القِيامَةَ يَومُ كَشفِ المُخبَآتِ",33,"ت",1,0],["وَخَفِ الإِلَهَ فَإِنَّهُ لَكَ ناظِرٌ","وَكَفى بِرَبِّكَ زاجِراً وَسَئولا",34,"ل",2,0],["وَخَفَّض عَنكَ نورَ الدينِ حُزناً","تَكادُ الراسِياتُ بِهِ تَذوبُ",35,"ب",1,0],["وخفتُ عليه عينَ سحرٍ تُصيبُهُ","فصَيّرْتُ تعويذي له آيةَ الكرسي",36,"س",2,0],["وَخَفّاقَةِ الراياتِ في جوْفِ نقْعِها","ترى الجُرْدَ فيها بالكماة تَكَدّسُ",37,"س",1,1],["وخفتُ على بناتِ الفكرِ يتماً","فإنَّ الشيبَ ينذرُ بالرواحِ",38,"ح",1,0],["وَخُفِّضَ عَنّي النَومُ أَقبَلتُ مِشيَةَ ال","حُبابِ وَرُكني خَشيَةَ الحَيِّ أَزوَرُ",39,"ر",1,0],["وَخَفَّضَ مِن صيتِ الأَبِيِّ وَصَوتِهِ","وَزَلزَلَ مِن رُكنِ العَصِيِّ وَضَعضَعا",40,"ع",2,0],["وَخَفَّ بِقَلبِيَ فيهِ الهَوى","وَلاعَبَ قُرطانَهُ شِنفُهُ",41,"ف",2,0],["وخفَايا الغيبِ للهِ الذي","يَعلمُ السّرَّ ويَدرِي مَوقِعَهْ",42,"ع",2,0],["وخفَّ أبو سُفيانَ يكذبُ نفسَهُ","ويُشهِدُها من خيفةٍ كيف يحتال",43,"ل",1,0],["وخفّ ذَوُو الحلومِ الراسياتِ","فأصبحتِ الممالكُ راجفاتِ",44,"ت",1,0],["وخَفّوا يُريدونَ القِتالَ فَردَّهم","نبيٌّ يَردُّ الشَّرَّ والشّرُّ زاحِفُ",45,"ف",1,0],["وَخُفِّفَت النُذورُ وَأَردَفتهُم","فُضولُ اللَهِ وَاِنتَهَتِ القُسومُ",46,"م",1,0],["وَخَفَّضَ جَأشي أَنَّ كُلَّ اِبنِ حُرَّةٍ","إِلى حَيثُ صِرتَ لا مَحالَةَ صائِرُ",47,"ر",1,0],["وَخَفِيَّةٍ بِالفِكرِ قَد ناجَيتَها","وَعَواقِبٍ بِالرَأيِ قَد أَبصَرتَها",48,"ت",3,0],["وَخِفْتُ مِنْ عَتْبِهِمْ عَلَيَّ كما","خافَ العَتاهِي العَتْبَ مِنْ عُتْبَهْ",49,"ب",2,0],["وَخَفَت عَن كُلِّ عَينٍ","وَخَفَت عَن كُلِّ دَلِّ",50,"ل",1,0],["وَخُفّاً واسِعاً مِن تَحتِ بُردٍ","مِنَ الديباجِ مِن نَهبِ الهُمامِ",51,"م",1,0],["وَخِفنَ الضِحى مِن نَومِهِنَّ عَلى الضُحى","فَأَقبَلنَ إِقبالَ الغُصونِ المَوائِدِ",52,"د",1,0],["وَخَف شَرَّ الأَصاغِرِ مِن بَنيهِ","وَقُل ما شِئتَ في أُسدٍ وَأَجرِ",53,"ر",1,0],["وَخَفَّ بِالجَهلِ أَقوامٌ فَبَلِّغهُم","مَنازِلاً بِسَناءِ العِزِّ تَلتَفِعُ",54,"ع",1,0],["وَخَف حَيَوانَ هَذي الأَرضِ وَاِحذَر","مَجيءَ النَطحِ مِن روقٍ وَجُمِّ",55,"م",1,0],["وخفقتَ تحت دَجاهُ من وَجَلِ","كالطيرِ تحت الخنجر الصلْتِ",56,"ت",1,0],["وخَفّتْ ثَقالٌ في المجالِسِ للنّوَى","فأهْدى لها ربُّ الغَمامِ ثِقالَها",57,"ل",3,0],["وخفقتْ كتائبُ الإسلام","في البحر أعلاماً على أعلام",58,"م",1,0],["وخفت فجاءات الردى فسبقتها","بوثبة جبار إلى الذروات",59,"ت",1,0],["وخِفْتُ من الغصن إذ تمتمتْ","بأُذْنيَ أوراقهُ كِلْمَتَينْ",60,"ن",1,0],["وَخِفْنَ الضِّحَى مِنْ نَوْمِهِنَّ عَلَى الضُّحَا","فأقبلن إقبال الغصون الموائد",61,"د",1,0],["وخَفيُّ كيدٍ حيثُ يسمو كائدٌ","ومن المكايدِ جالبٌ للعار",62,"ر",1,0],["وخَفُّوا لبيت المال يستنهضونَهُ","وكان على فضِّ المشاكل أقدَرا",63,"ر",2,0],["وخفّة الأيّام في ثغرها","لكن بعينيها وقار السنين",64,"ن",1,0],["وَخُفوق الرِياح شَق جُيوب","وَبُكاء الغَمام نَثر عُقود",65,"د",1,0],["وَخَفِّض عَلَيكَ القَولَ وَاِعلَم بِأَنَّني","مِنَ الأَنَسِ الطاحي الجميعِ العَرَمرَمِ",66,"م",1,0],["وخفْ قولَ الجماعة أن يقولوا","مقدمنا من الأهوال ريِعَا",67,"ع",2,0],["وخفَّف الخطبَ بعد شدّته","أَنْ كُلُّ حىّ لأمِّه الهَبَلُ",68,"ل",1,0],["وَخَفَّفَ وِزراً كانَ أَنقَضَ ظَهرَه","وَشَدَّ بِروحِ القُدسِ جِبريلَ أَزرَهُ",69,"ه",1,0],["وخفف نفل الصوم فيها عن الورى","ذنوباً عظاما حملها أثقل الظهرا",70,"ر",2,0],["وخفَّ كل حليمِ منك أذهله","أمرٌ به عن شروط الحلم قد غَفلا",71,"ل",2,0],["وَخَف سَيفَ بَدرِ الدِينِ وَاِحذَر فَإِنَّهُ","لَأَغيَرُ مِن لَيثٍ جَرِيِّ المَقادِمِ",72,"م",1,0],["وَخُفوقُ قَلبي بِالشُجونِ فَهَل تَرى","يَبغي لِحاقَ الحَيِّ حَيثُ تَحَمَّلا",73,"ل",2,0],["وخفوقِ القلوبِ ضربٌ من","التسبيحِ عندَ اللقاءِ والتهليلِ",74,"ل",1,0],["وخفتُ من الهموم ذهابَ عقلي","فطارِدني بطاردة الهمومِ",75,"م",1,0],["وَخَفَّت اِلَيهِ وَاِرتِعاشَةُ جِسمِها","يُلَوِّنُها البَدرُ الحييُّ المصوِّرُ",76,"ر",1,0],["وَخَفَّ هومير بِالإِلياذِ محرقها","أَمامَ عَينَيكَ بخوراً وَقُربانا",77,"ن",2,0],["وخُفوقَ قلبي عندَ ذكركِ هَيْبةً","لك واطّراحِي فيكِ كُلَّ عذول",78,"ل",1,0],["وَخِفنَ عَلى الحُسن أَن يَستَتيهَ","الحاظَنا فَاِتَّخَذنَ الهِجالا",79,"ل",2,0],["وَخَف صارِماً هَزَّ المَدِيحُ فِرِنْدَهُ","حَبِيبٌ إِليه أَنْ يُهَزَّ ويُنْدَبَا",80,"ب",2,0],["وخفت نواها من جَنوب عُنيزةٍ","كما خفّ من نيلِ المرامي جفيرُها",81,"ر",3,0],["وَخَفَّ المَوازينُ بِالكافِرينَ","وَزُلزِلَتِ الأَرضُ زِلزالَها",82,"ل",3,0],["وخفينا من النحول ولكن","عن رقيب وحاسد ما خفينا",83,"ن",2,0],["وخفض عيش بدهر","من أهله ضقت ذرعا",84,"ع",2,0],["وَخِفتُ وَقَد وَقاني اللَهُ مِن أَن","أَرى يَوماً عَبوساً قَمطَريرا",85,"ر",2,0],["وَخفَّفوه بِحَذفٍ مثل فِعلهمُ","في هَيِّن وَلهذا الحَذف أَنحاءُ",86,"ا",2,0],["وخفف رداء الظهر عن حمل ذمة","وأسقط عن المشغول حرمة أحدان",87,"ن",1,0],["وَخفقِ أَحشائي وَهجرِ الكرى","وَلونِ وَجهي الكاسفِ الحائلِ",88,"ل",1,0],["وَخَفَّت خِباها مِن جَنوبِ عُنَيزَةٍ","كَما خَفَّ مِن نَيلِ المَرامي جَفيرُها",89,"ر",3,0],["وَخِفْتُ إذا أَنشدْتُهُ حِذْقَ نَقْدهِ","فَأَرجُو لَهُ نَقْداً وَأَخْشَى لهُ نَقْدا",90,"د",2,0],["وَخِفْتُ عَلَيهِ مِن نَظَرِي","فَفَاضَ الدَّمْعُ وَابتَدَرا",91,"ر",2,1],["وَخِفْتُ لِغَرْقي من النِّيلِ أَنْ","يُقالَ بِنارِ السِّراجِ احتَرَقْ",92,"ق",1,0],["وخَفَّ الحُسامُ بكفّ الكَميّ","وكأْسُ المُدامِ بكَفِّ النّديم",93,"م",1,0],["وَخَفَّفَ اللَهُ عَن قَلبي بِما حَمَلَت","مِنها يَمينِيَ مِن فَضلٍ وَإِن ثَقُلا",94,"ل",2,0],["وخفضت رايات العداوة عندما","أبصرت رايات السلامة تَخفُق",95,"ق",1,0],["وَخِفت أَن يَرميَ مِن","يَعذُلُني بِالشَرر",96,"ر",1,0],["وخفضت مرفوعاً بلا سبب","أكذا يجازي كل ذي نبل",97,"ل",1,0],["وخُفوقِ قلب لا يقر قراره","مُضنى بغير هواكمُ لا يولع",98,"ع",1,0],["وخفف ما بي من غرام وغربةٍ","نظام هو الدر النفيس المنضَّد",99,"د",1,0],["وخفف حزني أنني مذ عرفته","مطيع له فيما يقول ويأتي",100,"ت",2,0],["وخفقة الموج أشجان تجاوبها","من القلوب التفاتات وأشجان",101,"ن",1,0],["وخفيفَ أُنبوبِ اليراعِ وإِنْ","كان الذي يَجْرِي به ثِقْلا",102,"ل",2,0],["وخفّفَ ما ألقى من البعدِ أنني","أراك بطرْفِ الودّ ما زلتَ في قربي",103,"ب",2,0],["وخفتُ أن ينطِقَ ثغري بما","يُبيحُ آثارَ حِمى الثّغِر",104,"ر",1,0],["وَخَفَّتْ عَلَى يُمْناكَ مِنَّا مطالِبٌ","تَشَكَّى إِلينا البَرُّ والبَحْرُ ثِقْلَها",105,"ل",3,0],["وخفقنَ ألواناً حملنَ عواطفاً","وأضأنَ أنغاماً تردُ جميلا",106,"ل",2,0],["وخفيّة الأعلامِ مهملة","بلهاء ينكِرُ ضَبُّها المَكْنا",107,"ن",2,0],["وخفضي في مدائحهِ","خزامةَ أنفِيَ العَرِمِ",108,"م",1,0],["وخفت عليك عينَ الدهر غُضَّتْ","فأزرقها بأغراضي عَلوقُ",109,"ق",1,0],["وخفَّتْ مسامعُ هنَّ الجبالُ","وجفَّتْ أناملُ هنَّ البحارُ",110,"ر",1,0],["وخَفْ على قلبي غداً من وقفةٍ","يكون لي فيها الوداعُ العطَبا",111,"ب",2,0],["وخفنا سهامَ اللَّحظ لمَّا بدت لنا","حواجبُ أمثال القسيِّ تزجَّج",112,"ج",1,0],["وخف إلى العلياء يحمل ثقلها","وخير صفات المجد أن يحمل الثقل",113,"ل",1,0],["وخف إلى الندى لا عن سؤال","فما يخشى بها المن الثقيل",114,"ل",1,0],["وخفَّت سماء الشام من غادياتهِ","فلم تشكُ ثقلاً من سحائبها الدُّلح",115,"ح",1,0],["وخفيّ الوميض ينمى كما يس","رع سقط االزنادِ في الحرَّاقٍ",116,"ق",1,0],["وَخَفِ العُقوبَةِ فَالفَتى","لا بُدَّ أَن يُجزى بِذَنبِهِ",117,"ب",2,0],["وخفوقَهُ خفقانُ قلبي كلَّما","أمسى مِنَ التفريقِ وهو مُرَوَّعُ",118,"ع",1,0],["وَخَفِّض عَنكَ في المِش","يَةِ لا يُغني تَبازيكا",119,"ك",2,0],["وخَفْ من الله بِقَلْبٍ خاشعٍ","فإنَّما الخَوفُ بهِ يُنْفي الكَسَلْ",120,"ل",1,0],["وَخفقَةٍ لَيسَ بِها طُوئِيُّ","وَلا خَلا الجِنِّ بِها إِنسِيُّ",121,"ي",1,0],["وخف دعوة المظلوم إذ ليس بينها و","حجاب وبين الله إياك تغفل",122,"ل",1,0],["وخفت هَتْكَ السِّتر فيه فقد","وقَعْت فِيمَا خِفِت من هَتْكِه",123,"ك",2,0],["وخِفْتُ عِصْيانَ من لو شاءَ أَهْلَكَني","واخترتُ طاعةَ من لو شاءَ أَنْشَانِي",124,"ن",2,0],["وخِفْتَ على عِقْدنا الانتثار","لأَنَّ ببقياه كان انتَظَم",125,"م",1,0]]}