{"poems":[[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[85,"أم الملائك والبدور","https://www.aldiwan.net/poem6815.html","مجزوء الكامل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[28,"إني لينفعني بأسي فيصرفني","https://www.aldiwan.net/poem5522.html","البسيط"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1417","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54653","الكامل"],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[97,"أين غد","https://www.poetsgate.com/ViewPoem.aspx?id=25465",""],[117,"يا رشأ السدرِ ولو أنني","https://www.aldiwan.net/poem4354.html","السريع"],[153,"قد جاءت البغلة السفواء يجنبها","https://www.aldiwan.net/poem55485.html","البسيط"],[167,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"شد المناطق يثني عطف مخمور","https://www.aldiwan.net/poem13307.html","البسيط"],[221,"الصيف يا ليل طار","https://www.aldiwan.net/poem39732.html","مخلع البسيط"],[221,"يا حب عذب","https://www.aldiwan.net/poem39733.html","مخلع البسيط"],[221,"كل ما في الحياة أنت فقد","https://www.aldiwan.net/poem41443.html","الخفيف"],[273,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[273,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[280,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[296,"إن كان للموت حتما كل مولود","https://www.aldiwan.net/poem36254.html","عموديه"],[303,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[326,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[326,"وسألتني من أنت لما جئت","https://www.aldiwan.net/poem54986.html","مجزوء الكامل"],[326,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[326,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[326,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[447,"لم تغن عن هفوات النفس آداب","https://www.aldiwan.net/poem980.html",""],[451,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[451,"حلمت أنك قد أصبحت معتزلا","https://www.aldiwan.net/poem61371.html","البسيط"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[459,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[463,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[491,"قد جاءت البغلة السفواء يجلب","https://www.aldiwan.net/poem67364.html","البسيط"],[551,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[565,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[565,"ومستدير كجرم البدر مسطوح","https://www.aldiwan.net/poem69754.html","البسيط"]],"verses":[["مِلءُ الوِشاحِ وَصِفرُ الدَرعِ بَهكَنَةٌ","إِذا تَأَتّى يَكادُ الخَصرُ يَنخَزِلُ",0,"ل",1,0],["مِلْءُ الجَوَانِحِ مَا بِهِ دَخَل","يَوْمَ الحِفَاظِ وَمَا بِهِ دَخَنُ",1,"ن",1,0],["مِلءُ العُيونِ جَمالاً ثُمَّ يونِقُني","لَحنٌ لَبيثٌ وَصَوتٌ غَيرُ خَوّارِ",2,"ر",1,0],["مِلءَ صدور المجالس اختُلِست","لا بل صدور الورى إلى الثُّغرِ",3,"ر",1,0],["مِلءُ المَدائِنِ وَالقُرى آلائُهُ","وَهِباتُهُ وَيَعيشُ عَيشَ المُملِقِ",4,"ق",1,0],["مِلءُ آفاقِهِ فَحيحُ الأَفاعي","وعَجيجُ الآثامِ والآلامِ",5,"م",1,0],["ملء المحافل ملء عي","ن زمانه ملء السرير",6,"ر",1,0],["ملء بردينا عفاف وهوى","حفِظ الحسن وصنت الأدبا",7,"ب",2,0],["مِلءَ الجِفانِ مِنَ الشيزى مُكَلَّلَةً","وَالضَربَ عِندَ اِحمِرارِ المَوتِ لِلبُهَمِ",8,"م",1,0],["ملءُ ضلوعي لظىً وأعجبُه","أني بهذا اللهيبِ أبترد",9,"د",1,0],["مِلءُ نَفسِ الدَهرِ مِن شَرَفٍ","قَد رَسا طَوداً عَلى القِدَمِ",10,"م",1,0],["مِلءُ المَسامِعِ مَنطِقاً مِلءُ الجَوا","نِحِ هَيبَةً مِلءُ النَواظِرِ مَنظَرا",11,"ر",2,0],["مِلْءُ السَّموَاتِ والأَرْضِينَ مَعْ جَبَلٍ","والْفَرْشِ والعَرْشِ والكُرْسِي وَما حَصَرُوا",12,"ر",3,0],["مِلءِ فُروعِ الأيكِ ضِرغامَةٌ","جَهْمُ المُحيّا أهْرَتُ الشِّدق",13,"ق",1,0],["مِلءُ عَيني مَلاحَةً وَجَمالاً","وَفُؤادي مَهابَةً وَجَلالا",14,"ل",2,0],["ملءُ عينيكَ يا فتى الشرق أحلا","مٌ سكارى وصبوةٌ واشتهاءُ",15,"ا",2,0],["ملء كأس في يديهِ ذهبيّهْ","فاسقنيها أنتِ يا أندلسيَّهْ",16,"ه",1,0],["مِلءُ الخَوَاطِرِ والبَوَادِي ذكْرُهُ","وَسَنَاهُ بَيْنَ مَشَارِقٍ وَمَغَارِبِ",17,"ب",1,0],["ملْءُ محرابهِ: صلاةٌ، ونُسْكٌ","في وَقَار يحفُّهُ، ومَهَابة",18,"ب",2,0],["ملءَ العيون سماتُ أصيدَ طافحٍ","عزماً ، وملءَ السمع فصلُ خِطاب",19,"ب",1,0],["ملء العراق أماجدٌ لولاهمُ","هو مثلُ بنيان بغير أساس",20,"س",1,0],["ملءُ العيونِ هما وخيرُهما","ما يملأُ العينينِ والكفّا",21,"ف",2,0],["ملءَ نفسي وغرفتي يتراءى","شَبَحُ الهمَّ لي وملءَ السِكاك",22,"ك",1,0],["مِلءُ عينيكَ خضرة تًستسرٌّ","النفسُ منها وتُستطار القلوب",23,"ب",1,0],["ملءُ دور العراق أفئدةٌ","حَرَّى تَشكِّى من الأذى أنواعا",24,"ع",2,0],["ملءُ القلوب خشوعٌ من مهابتِه","وملءُ أعينهم من خوفِه سَهر",25,"ر",1,0],["ملءَ عيني رأيت منكِ مع الأخرى","غرامَ البَناتِ يا فتّانه",26,"ن",2,0],["ملء المدائن والقرى آلاؤه","وهباته ، ويعيش عيش المملق",27,"ق",1,0],["ملء ضلوعي لظىً وأعجبه","أني بهذا اللهبِ أبتردُ",28,"د",1,0],["ملءُ فؤادي زفرةٌ تلتظي","وملء عيني عَبرَةٌ تجرِي",29,"ر",2,0],["مِلءُ الحِزَامِ وَمِلءُ العَيْنِ مُسْفِرَةٌ","يُرِيكَ غَائِبَها فِي الحُسْنِ حَاضِرُهُ",30,"ر",2,0],["مِلءُ المُفاضَةِ مِن بَأسٍ وَمِن كَرَمٍ","وَمِن وَفاءٍ وَمِن حِلمٍ وَمِن أَدَبِ",31,"ب",1,0],["مِلءَ المُسُوكِ قَناطيراً مُقَنطَرَةً","ما خافَ في جَمعِها حُوباً وَلا أَثَما",32,"م",2,0],["مِلءُ قَلبي محبّةٌ لمحبّي","كَ وإِن قلّ في فؤادي الصفاءُ",33,"ا",2,0],["ملء نحو راحته ان رمت نائلها","فانها لتري صرف الدنانير",34,"ر",1,0],["مِلءُ السِنين","لِلعاشِقين",35,"ن",1,0],["مِلءَ الفِكَر","لَمّا أَتينا",36,"ن",2,0],["مِلءُ نَهرِ الحَياةِ تَزدادُ روحي","عَطشاً كُلَّما اِرتَوَت شَفَتايا",37,"ا",3,0],["مِلْءَ الفَضَاءِ طَمُوحُ المَوْجِ مُزْبِدُهُ","يَعُبُّ مُنْفَرِدٌ منهُ وَمُرْتَدَفُ",38,"ف",1,0],["مِلْءَ المُرْادِ نَضارةً وعُذوبةً","يَجِدُ المُرادَ عُفاتُهُ والمَوْرِدا",39,"د",2,0],["مِلءُ الإِزارِ ثَقيلَةٌ أَردافُها","جاذَبنَ خَصراً ناحِلاً كَالخِنصَرِ",40,"ر",1,0],["ملءَ العيون وقاراً والنفوس نهى","أَحسنْ بخلقٍ وخلقٍ منه محمود",41,"د",1,0],["مِلء قَلبي وَمُهجتي وَوجودي","وَحَياتي وَمَسمعي وعياني",42,"ن",2,0],["ملء الحمى باكون طال حنينهم","للفرحة النشوانة العذراء",43,"ا",2,0],["ملءُ الزمان وجودها وهي","السجية في مثالك",44,"ك",1,0],["ملءُ كفّي ورأسُها يتداعى","وعناءٌ عليّ هذا التداعي",45,"ي",1,0],["ملء عينيك غمرة من غمام","أفعمتها الأيام دمعا سخيا",46,"ي",2,0],["ملء دير الأحزان رهبان دمع","كل برّ منهم بألف نبيّ",46,"ي",1,0],["ملء كفيك خافقي فاحفظيه","ليغنيك غنوة الأشواق",46,"ق",1,0],["ملء سمعي خمر من النغم السا","حر ذابت في كأسه أسقامى",47,"م",2,0],["ملء التراب جماجم فادف","ن حطامك في التراب",48,"ب",1,0],["ملء القلوب لكم أسمى مودتن","وما إخالك في ذا الود ترتاب",49,"ب",1,0],["ملء العصور المآسي وهي شاهدة","أن النبوغ ذبيح كان مأسورا",50,"ر",2,0],["ملء الأشعة أو ظل لها نضر","وفي تبسم أنداء وأزهار",51,"ر",1,0],["ملءُ الشِّنانِ إذا أظلَّت ساحةً","ألقت فراعَ فؤادَها التحويلُ",52,"ل",1,0],["ملءُ الإهاب عليمةٌ بطلابها","خفَّتْ ليومِ تحمّل الأثقالِ",53,"ل",1,0],["مِلءُ اُهْبِ القومِ اِنْ فتَّشتها","يا أخا سُفْيانَ كِبْرٌ وبَخلْ",54,"ل",1,0],["مِلْءَ الحَياتَين ِانفَرَدتَ عن الوَرى","في أنَّكَ الفَلَكُ الأعَزُّ الأرفَعُ",55,"ع",1,0],["مِلءُ الحِزامِ وَمِلءُ اللَبَدِ مُجفَرَّةً","يُريكَ عائِبَها في الحَسَنِ حاضِرُهُ",56,"ر",2,0],["مِلءُ العُيونِ مُقَلِّصٌ لِنِجادِهِ","طَبِنٌ بِأَنحاءِ الأُمورِ طَبيبُ",57,"ب",1,0],["مِلْءُ صدرٍ ومِلْءُ عيْنٍ وسَرْجٍ","وفؤادٍ وَرَغْمُ أَنْفِ حَسُودِ",58,"د",1,0],["مِلْءُ البِنَانِ وَقَدْ أَوْفَتْ صَفَائِحُهُ","عَلَى الأَقَالِيمِ فِي أَقْطَارِهَا الفيحِ",59,"ح",1,0]]}