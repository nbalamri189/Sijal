ttps://www.poetsgate.com/ViewPoem.aspx?id=36539",""],[6163,"وطئت أقدامنا سطح القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80802&r=&rc=2",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[454,"لم تغنِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82676&r=&rc=40",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["مِلءُ الوِشاحِ وَصِفرُ الدَرعِ بَهكَنَةٌ","إِذا تَأَتّى يَكادُ الخَصرُ يَنخَزِلُ",0,"ل",1,0],["مِلْءُ الجَوَانِحِ مَا بِهِ دَخَل","يَوْمَ الحِفَاظِ وَمَا بِهِ دَخَنُ",1,"ن",1,0],["مِلءُ العُيونِ جَمالاً ثُمَّ يونِقُني","لَحنٌ لَبيثٌ وَصَوتٌ غَيرُ خَوّارِ",2,"ر",1,0],["مِلءَ صدور المجالس اختُلِست","لا بل صدور الورى إلى الثُّغرِ",3,"ر",1,0],["مِلءُ المَدائِنِ وَالقُرى آلائُهُ","وَهِباتُهُ وَيَعيشُ عَيشَ المُملِقِ",4,"ق",1,0],["مِلءُ آفاقِهِ فَحيحُ الأَفاعي","وعَجيجُ الآثامِ والآلامِ",5,"م",1,0],["ملء المحافل ملء عي","ن زمانه ملء السرير",6,"ر",1,0],["ملء بردينا عفاف وهوى","حفِظ الحسن وصنت الأدبا",7,"ب",2,0],["مِلءَ الجِفانِ مِنَ الشيزى مُكَلَّلَةً","وَالضَربَ عِندَ اِحمِرارِ المَوتِ لِلبُهَمِ",8,"م",1,0],["ملءُ ضلوعي لظىً وأعجبُه","أني بهذا اللهيبِ أبترد",9,"د",1,0],["مِلءُ نَفسِ الدَهرِ مِن شَرَفٍ","قَد رَسا طَوداً عَلى القِدَمِ",10,"م",1,0],["مِلءُ المَسامِعِ مَنطِقاً مِلءُ الجَوا","نِحِ هَيبَةً مِلءُ النَواظِرِ مَنظَرا",11,"ر",2,0],["مِلْءُ السَّموَاتِ والأَرْضِينَ مَعْ جَبَلٍ","والْفَرْشِ والعَرْشِ والكُرْسِي وَما حَصَرُوا",12,"ر",3,0],["مِلءِ فُروعِ الأيكِ ضِرغامَةٌ","جَهْمُ المُحيّا أهْرَتُ الشِّدق",13,"ق",1,0],["مِلءُ عَيني مَلاحَةً وَجَمالاً","وَفُؤادي مَهابَةً وَجَلالا",14,"ل",2,0],["ملءُ عينيكَ يا فتى الشرق أحلا","مٌ سكارى وصبوةٌ واشتهاءُ",15,"ا",2,0],["ملء كأس في يديهِ ذهبيّهْ","فاسقنيها أنتِ يا أندلسيَّهْ",16,"ه",1,0],["مِلءُ الخَوَاطِرِ والبَوَادِي ذكْرُهُ","وَسَنَاهُ بَيْنَ مَشَارِقٍ وَمَغَارِبِ",17,"ب",1,0],["ملْءُ محرابهِ: صلاةٌ، ونُسْكٌ","في وَقَار يحفُّهُ، ومَهَابة",18,"ب",2,0],["ملء هذا الرحاب ، يمتدّ يرمي","عنه نفسا ، ويبتدي منه نفسا",19,"س",2,0],["ملءَ العيون سماتُ أصيدَ طافحٍ","عزماً ، وملءَ السمع فصلُ خِطاب",20,"ب",1,0],["ملء العراق أماجدٌ لولاهمُ","هو مثلُ بنيان بغير أساس",21,"س",1,0],["ملءُ العيونِ هما وخيرُهما","ما يملأُ العينينِ والكفّا",22,"ف",2,0],["ملءَ نفسي وغرفتي يتراءى","شَبَحُ الهمَّ لي وملءَ السِكاك",23,"ك",1,0],["مِلءُ عينيكَ خضرة تًستسرٌّ","النفسُ منها وتُستطار القلوب",24,"ب",1,0],["ملءُ دور العراق أفئدةٌ","حَرَّى تَشكِّى من الأذى أنواعا",25,"ع",2,0],["ملءُ القلوب خشوعٌ من مهابتِه","وملءُ أعينهم من خوفِه سَهر",26,"ر",1,0],["ملءَ عيني رأيت منكِ مع الأخرى","غرامَ البَناتِ يا فتّانه",27,"ن",2,0],["ملء المدائن والقرى آلاؤه","وهباته ، ويعيش عيش المملق",28,"ق",1,0],["ملء العيون مفاتنا لكنّها","ملء القلوب علا أعزّ أثيلا",29,"ل",2,0],["ملء ضلوعي لظىً وأعجبه","أني بهذا اللهبِ أبتردُ",30,"د",1,0],["ملءُ فؤادي زفرةٌ تلتظي","وملء عيني عَبرَةٌ تجرِي",31,"ر",2,0],["مِلءُ الحِزَامِ وَمِلءُ العَيْنِ مُسْفِرَةٌ","يُرِيكَ غَائِبَها فِي الحُسْنِ حَاضِرُهُ",32,"ر",2,0],["مِلءُ المُفاضَةِ مِن بَأسٍ وَمِن كَرَمٍ","وَمِن وَفاءٍ وَمِن حِلمٍ وَمِن أَدَبِ",33,"ب",1,0],["مِلءَ المُسُوكِ قَناطيراً مُقَنطَرَةً","ما خافَ في جَمعِها حُوباً وَلا أَثَما",34,"م",2,0],["مِلءُ قَلبي محبّةٌ لمحبّي","كَ وإِن قلّ في فؤادي الصفاءُ",35,"ا",2,0],["ملء نحو راحته ان رمت نائلها","فانها لتري صرف الدنانير",36,"ر",1,0],["مِلءُ السِنين","لِلعاشِقين",37,"ن",1,0],["مِلءَ الفِكَر","لَمّا أَتينا",38,"ن",2,0],["مِلءُ نَهرِ الحَياةِ تَزدادُ روحي","عَطشاً كُلَّما اِرتَوَت شَفَتايا",39,"ا",3,0],["مِلْءَ الفَضَاءِ طَمُوحُ المَوْجِ مُزْبِدُهُ","يَعُبُّ مُنْفَرِدٌ منهُ وَمُرْتَدَفُ",40,"ف",1,0],["مِلْءَ المُرْادِ نَضارةً وعُذوبةً","يَجِدُ المُرادَ عُفاتُهُ والمَوْرِدا",41,"د",2,0],["مِلءُ الإِزارِ ثَقيلَةٌ أَردافُها","جاذَبنَ خَصراً ناحِلاً كَالخِنصَرِ",42,"ر",1,0],["ملءَ العيون وقاراً والنفوس نهى","أَحسنْ بخلقٍ وخلقٍ منه محمود",43,"د",1,0],["مِلء قَلبي وَمُهجتي وَوجودي","وَحَياتي وَمَسمعي وعياني",44,"ن",2,0],["ملء الحمى باكون طال حنينهم","للفرحة النشوانة العذراء",45,"ا",2,0],["ملءُ الزمان وجودها وهي","السجية في مثالك",46,"ك",1,0],["ملءُ كفّي ورأسُها يتداعى","وعناءٌ عليّ هذا التداعي",47,"ي",1,0],["ملء عينيك غمرة من غمام","أفعمتها الأيام دمعا سخيا",48,"ي",2,0],["ملء دير الأحزان رهبان دمع","كل برّ منهم بألف نبيّ",48,"ي",1,0],["ملء كفيك خافقي فاحفظيه","ليغنيك غنوة الأشواق",48,"ق",1,0],["ملء سمعي خمر من النغم السا","حر ذابت في كأسه أسقامى",49,"م",2,0],["ملء التراب جماجم فادف","ن حطامك في التراب",50,"ب",1,0],["ملء القلوب لكم أسمى مودتن","وما إخالك في ذا الود ترتاب",51,"ب",1,0],["ملء العصور المآسي وهي شاهدة","أن النبوغ ذبيح كان مأسورا",52,"ر",2,0],["ملء الأشعة أو ظل لها نضر","وفي تبسم أنداء وأزهار",53,"ر",1,0],["ملءُ الشِّنانِ إذا أظلَّت ساحةً","ألقت فراعَ فؤادَها التحويلُ",54,"ل",1,0],["ملءُ الإهاب عليمةٌ بطلابها","خفَّتْ ليومِ تحمّل الأثقالِ",55,"ل",1,0],["مِلءُ اُهْبِ القومِ اِنْ فتَّشتها","يا أخا سُفْيانَ كِبْرٌ وبَخلْ",56,"ل",1,0],["مِلْءَ الحَياتَين ِانفَرَدتَ عن الوَرى","في أنَّكَ الفَلَكُ الأعَزُّ الأرفَعُ",57,"ع",1,0],["مِلءُ الحِزامِ وَمِلءُ اللَبَدِ مُجفَرَّةً","يُريكَ عائِبَها في الحَسَنِ حاضِرُهُ",58,"ر",2,0],["مِلءُ العُيونِ مُقَلِّصٌ لِنِجادِهِ","طَبِنٌ بِأَنحاءِ الأُمورِ طَبيبُ",59,"ب",1,0],["مِلْءُ صدرٍ ومِلْءُ عيْنٍ وسَرْجٍ","وفؤادٍ وَرَغْمُ أَنْفِ حَسُودِ",60,"د",1,0],["مِلْءُ البِنَانِ وَقَدْ أَوْفَتْ صَفَائِحُهُ","عَلَى الأَقَالِيمِ فِي أَقْطَارِهَا الفيحِ",61,"ح",1,0],["مِلءُ القلوبِ ومِلءُ السَّمعِ والبصرِ ال","هادي وإن ضاقَ عنهُ السَّمعُ والبَصر",62,"ر",1,0],["مِلءُ المَسامِعِ والنَّواظِر بَهْجَةً","ما مِثلُها حدِّث بِذا ثُمَّ احْلِفِ",63,"ف",1,0],["ملء آذانها غنا","ؤك ما ذاع في الفضاء",64,"ا",2,0],["ملء السموات والأرضين مذ خلقت","ووزنهن وضعف الضعف في العدد",65,"د",1,0],["مِلءَ الحِزامِ إِذا ما اِشتَدَّ مَحزِمُهُ","ذي كاهِلٍ وَلَبانٍ يَملَأُ اللَبَبا",66,"ب",2,0],["ملء عينِ الدُنيا مَثُلت ولكن","بين بُردَي تكرُّمٍ وسماح",67,"ح",1,0],["ملء العيون دموع من هناءتها","فالدمع در على الخدين منضود",68,"د",1,0],["ملء القلوب جلالاً والعيونِ سناً","والحرب بأساً وأكناف النديِّ ندى",69,"د",2,0],["ملء أبصار الأنام ولا","أفْق إلا منه ملآن",70,"ن",1,0],["مِلءُ النَّواظرُ حُسناً حين تلحظُهُ","وأَمْلَكُ الحُسن للأَلحاظ ما مَلأَ",71,"ا",1,0],["ملءُ أحشائه اشتياقًا إليها","نارُ وجدٍ وَقودها الأحشاء",72,"ا",2,0],["ملء أبرادهم تعاليم طه","ومواضي اليرموك في الأروام",73,"م",1,0],["ملء ما بين الثريا والثرى","إن من قاس علاكم بالورى",74,"ر",2,0],["ملء قلوب القومِ إن حاربوا","وهو إذا سُولم ملء العيون",75,"ن",1,0],["مِلءُ كَفَّي ضَجيعِها","نالَ مِنها تَفَخُّذا",76,"ذ",2,0],["ملء خميسٍ عن دعوه يحب","بالخيل والأَسياف والأسهم",77,"م",1,0],["ملء برديه اطلاع","واقتدار ضم جدا",78,"د",2,0],["مِلءُ السِوارَينِ وَالحِجلَينِ مِئزَرُها","بِمَتنِ أَعفَرَ ذي دِعصَينِ مَكفولُ",79,"ل",1,0],["ملء العيون وملء السرج رونقه","ملء القلوب إذا طاش الحليم سكن",80,"ن",1,0],["ملء النديِّ وإن تطامن دِقّة","كم دِقّة شحذت مضاء مهند",81,"د",1,0],["مِلء الحبالِ دِرَفْسةٌ","ترقُّد تخويدَ الظليمِ",82,"م",1,0],["ِملَء الحبال إذا تقارب خطْوها","قربت هنُاك دَكاِدكٌ وَصحاصحُ",83,"ح",1,0],["ملءَ عَينيَِّ عَن الدُنيا عَمىً","فَاِفهموني مِلءَ أُذْنَيَّ الصَممْ",84,"م",1,0],["ملء برديه عفة ودلال","حرس اللَه قده المياسا",85,"س",2,0],["ملء أَوفاضك الجَلال فَمَرحى","بِالجَلال المَفيض مِن أَنسابك",86,"ك",1,0],["ملء آهاتِها الهَوى وَالحَنان الجَ","م وَالعَطف وَالرِضا وَالحَرارَه",87,"ر",2,0],["ملء فَضاء الظُنون","ملء سَماء الخَيال",88,"ل",1,0],["مِلءُ المَناصِب مُنهومون قَد جَعَلوا","مِن دُونِها سدَّ ذِي القَرنين يَحميها",89,"ي",3,0],["ملء الجوانح آهاتٌ مروعٌة","تستنهض القوم هل في القوم من عمر ؟",90,"ر",1,0],["ملء السّوار والحجال والحجى","ودرعها مجدولة المخلخل",91,"ل",1,0],["مِلءُ ذرّاتِهِ أناشيدُ مجدٍ","بصداها مُحرّر النيل أنشد",92,"د",1,0],["ملءُ الخيام وملءُ كل عمارة","عهد يزيد وبَيعة عصماءُ",93,"ا",2,0],["مِلْءَ الْوجُودِ رُبَىً تَشْدُو مَبَاهِجُهَا","تاَجُ الْمُنَى بِأَيَا دِيْنَا فَتَحْنَاهُ",94,"ا",2,0],["ملء الطلاس وملء سرج سبوحه","بأساً وملء نواظر وصدور",95,"ر",1,0],["ملء الجفون فضضاً","ملء الفؤاد مضضا",96,"ض",2,0],["ملءَ قلبي جعلتُها وعيوني","ودليلي وشمسَ دربِ حياتي",97,"ت",2,0],["ملء عقلي مواجعٌ وشرودٌ","ترقصُ الروح بين طعْنٍ وطعنِ!!",98,"ن",1,0],["ملء قلبي لواعجٌ وحنين","لرياض بهيّة وبيوت",99,"ت",1,0],["مِلْءَ المَشافي بِأمريكا مَحاجِرُهُم","بِيعَتْ وشَعْفاتُهُم صارَتْ مَناديلا",100,"ل",2,0],["مِلءَ التَّصَبُّرِ أحلامٌ تُراودني","فأغمِضُ الجفنَ عنها.. عن أسىً فيهِ",101,"ي",2,0],["مِلْءُ عَيْنَيْكِ يا حبيبة ُبحرٌ","وسماءٌ نجومُها ألْوانُ !",102,"ن",1,0],["مِلْءُ الفُؤَادِ يَقِينٌ أَنَّ لِي أَمَلاً","أَحْلَى وَ أَشْهَى مِنَ التُّفَاحِ وَ العَسَلِ",103,"ل",1,0],["ملء الجوانح ما به دخل","يوم الحافظ وما به دخن",104,"ن",1,0],["ملء عطفيه غرور حاقد","لم لا يطغى وقد حاز القمر",105,"ر",1,0],["ملءَ هذا السَّهْبِ من غيهبنا","ملءَ أثداء السبايا في الخيامْ",106,"م",1,0],["مِلءْ عَيْنِي نَدَى وانْتَ قُبَالِي","لِتَرَى بَعْدَ بُعْدِنَا كَيْفَ حَالِي",107,"ل",2,1],["ملء القلوب لكم أسمى مودتنا","وما إخالك في ذا الود ترتاب",108,"ب",1,0],["مِلءُ صَدْر وَمِلءُ سَرْجِ وعينٍ","وفؤادٍ ورغمَ أنفٍ حسودِ",109,"د",1,0]]}