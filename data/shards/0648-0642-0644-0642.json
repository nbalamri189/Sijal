{"poems":[[55,"لأمر يا بني جشم","https://www.aldiwan.net/poem29770.html","مجزوء الوافر"],[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[46,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[132,"قضى اللّه فيما بيننا بقرابة","https://www.aldiwan.net/poem50668.html","الكامل"],[396,"رسول الله جئنا زائر ينا","https://www.aldiwan.net/poem54467.html","عموديه"],[438,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[545,"أجارتنا بذي نفر أقيمي","https://www.aldiwan.net/poem56652.html","الوافر"],[556,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72276","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71319","المنسرح"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95340","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22062","الطويل"]],"verses":[["وَقَلقَلتُ الجِيادَ دَوا","مِيَ الأَشداقِ بِاللُجُمِ",0,"م",1,0],["وَقَلقَلَ الفِتيانُ أَسيافَهُم","فَأَوشَكَت تَبدو حَواشيها",1,"ي",3,0],["وَقَلقَلَ نَأيٌ مِن خُراسانَ جَأشَها","فَقُلتُ اِطمَئِنّي أَنضَرُ الرَوضِ عازِبُه",2,"ب",2,0],["وقلقلتُه حتى كأنّ ضلوعه","سفيف حصير فرّجته الروامل",3,"ل",1,0],["وقل قوله إن وافَقَ الحق والهدى","وإن لم يوافق فالتجنب أصوبُ",4,"ب",1,0],["وقل قضيت حوائجكم جميعا","صلحنا شأنكم دنيا ودينا",5,"ن",2,0],["وقُلْ قد سقاهُ البَيْنُ كَأْساً مَريرةً","فَقَدْ والذي يُدْنِي المَزَارَ سَقَانِي",6,"ن",2,0],["وَقُل قَولاً تُطَبّقُ مَفصَلَيهِ","بمَدحَةِ صاحبِ الرأيِ الصَرومِ",7,"م",1,0],["وقلْقَلَها رُكبانُها نحو بابِه","كما طاح من أعلامِ ثَهْلانَ طائحُ",8,"ح",1,0],["وقلَّ قَوْليَ في كثيرٍ نِلْتُه","يا رحمةَ المكثِر لِلْمُقِلِّ",9,"ل",1,0],["وقلقل الحصن فارتاع اليهود له","وكان أكثرهم عمداً يفنده",10,"د",2,0],["وقلْ قضَى ذلِكَ المَشُوُقُ بِكُمْ","وَمَا قضَى مِنْ وصَالِكُمْ أَرَبا",11,"ب",2,0],["وقل قُشعريرة زيد زالت","وهذه أُمنية قد طالت",12,"ت",1,0],["وقل قلّ صبر الصب من بعد بعدكم","ومن لاعج الاشواق زاد تحرّفا",13,"ف",2,0],["وَقُل قَد وَعَدتِ وَعداً فَأَنجِزي","وَلا تُخلِفي لا خَيرَ في مُخلِفِ الوَعدِ",14,"د",1,0]]}