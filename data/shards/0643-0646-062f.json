{"poems":[[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[136,"طرقتني نوار عند دكار","https://www.aldiwan.net/poem54837.html","الخفيف"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137802",""],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123645","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137290",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101604","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69898","الوافر"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125356","الرجز"],[4955,"كن دائما رجل المواقف في الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=194249",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5285,"نجم المجرة","https://www.poetsgate.com/ViewPoem.aspx?id=203532",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"صعبٌ معاملة الأزواج للبعض","https://www.poetsgate.com/ViewPoem.aspx?id=203123",""],[5969,"إلى طفلتي ( كندة )","https://www.poetsgate.com/ViewPoem.aspx?id=199209",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""]],"verses":[["\" كندةٌ \" أينَ ؟ لم تُبقِّ يَد الدهرِ","عليها ولا تَدُلُّ المَعالم ؟",0,"م",1,0],["كَنَدَى المُصطفي الخٍِليفَةِ في الأُز","مِ إِذَا أخلَفَ الغيوثُ السَّوَارِي",1,"ر",2,0],["كنَّ دُهماً من الدآدي وقد كُن","نَ بتلك الوجوه دُرْعاً وقُمْرا",2,"ر",2,0],["كن دواما أليف صبر","لا تغظ من سماع مر",3,"ر",1,0],["كنديمي جذيمة نتعاطى","من كؤوس الوداد اعذب شربه",4,"ب",2,0],["كندا لبعدك تشتكي مر النوى","وربوعنا للقاك ذات هيام",5,"م",1,0],["كَنديكَلُ الجاهُ عليها إصبَعُ","أمَّا بجُبتِي نصفُهُ فاسمَعوا",6,"ع",3,0],["كن دائما ذئب الفلا","إن أصبحت دنياك شاة",7,"ه",1,0],["كندى الفجر سال فاشتفه التر","بُ فحالت وحلاً لآلي حبابه",8,"ب",2,0],["كُن دارس الكُتب بَينَ الناس يا ولداً","لا دارس التبن بينَ الكدشِ وَالبَقَرِ",9,"ر",1,0],["كنَداه يمنحُ رفده من سالا","وينيلُ راجيه النّوال جسيما",10,"م",2,0],["كن دنفاً مقترباً ممتثلاً مضطرباً","منتقلاً مغترباً مثل شهاب في السما",11,"ا",1,0],["كن دائماً رجلَ المواقفِ في الحياةْ","لاتلتفت لمن ادَّعى نهجَ الدُّعاةْ",12,"ا",2,1],["كندى بهاء الدين يستقري الورى","فيناله الداني معاً والقاصي",13,"ص",2,0],["كنديمِ كأسي في المساءِ يزورُني","ليَصبَّ خمراً في كؤوسِ المُحْتملْ",14,"ل",1,0],["كن ديبلوماسياًّ معي يا خالدٌ","رُدِّ التحيةَ نجِّني مِن مَعزِلي",15,"ل",2,0],["كن دائماً وسطاً في كل مسألةٍ","حتى الحبيبة لا تخلو من البغضِ",16,"ض",1,0],["كِندُ احتياجُ الهَوى للشِعرِ في لَهَفٍ","سِرُ النَقاءِ وما يُحيي صَباباتي",17,"ت",2,0],["كِندٌ حُروفي وما أَعنيهِ مِنْ كَلِمي","تَشفي ارْتِباكَ الهَوى في كُلِ أَبياتي",17,"ت",2,0],["كنَّ دهما من الدآدي وقد","كنَّ بتلك الوجوه درعاً وقمرا",18,"ر",2,0]]}