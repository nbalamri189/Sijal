{"poems":[[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[49,"أيا ظالما أمسى يعاتب منصفا","https://www.aldiwan.net/poem25225.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[47,"له الويل من ليل تطاول آخره","https://www.aldiwan.net/poem63564.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42643","الطويل"],[132,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[136,"ما خاب من كان مشغولا بتدريس","https://www.aldiwan.net/poem54815.html","البسيط"],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18516","الطويل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123689","المديد"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59246","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64836","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48940","المتقارب"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108773","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108634","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66239","المتقارب"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58413","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112297","الرمل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129365","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91135","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131266",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4852,"الشعر مقصور علي","https://www.poetsgate.com/ViewPoem.aspx?id=215427",""],[5002,"ياطير","https://www.poetsgate.com/ViewPoem.aspx?id=205176",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[6018,"لئن بخلت بإسعادى سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=181196",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["فإن أدع اللواتي من أناس","أصاغرهن لا أدع الذينا",0,"ن",2,0],["فَإِن أدَع اللَّواتي مِن أُناس","أضَاعُوهُنَّ لاَ أدَعُ الَّذِينَا",1,"ن",2,0],["فَإِن أَدنَتِ الأَيّامُ داراً بَعيدَةً","شَفى القَلبَ مَظلومٌ مِنَ العَتبِ فَاِشتَفى",2,"ف",2,0],["فَإِن أَدعُ في اللَأواءِ فَهوَ مُحارِبٌ","وَإِن أَسعَ لِلعَلياءِ فَهوَ مُظاهِرُ",3,"ر",1,0],["فَإِن أَدرَكَتهُ بِالعِراقِ مَنِيَّةٌ","فَقاتِلُهُ عِندَ الخَليفَةِ آسِرُه",4,"ر",2,0],["فَإِنْ أَدْرَكَتْ نَفْسِي الْمَرَامَ وَلَمْ أَقُمْ","مَقَامَ ضَلِيعٍ بِالَّذِي أَنْتَ آمِرُ",5,"ر",1,0],["فإن ادَّعيتَ بأنهم ذكروك أو","هابوكَ بالسوآى فأنتَ الجاني",6,"ن",2,0],["فَإِنَّ إِدريسَ نَالَ اليَومَ مَرتَبَةً","مِن شَيخِهِ لَم ييَشِنهَا رَينُ تَدلِيسِ",7,"س",1,0],["فَإِن أُدرِك مُنايَ فَكَم هُمامٍ","أَفادَ المَجدَ أَن جابَ البِلادا",8,"د",2,0],["فَإِن أُدعَ يَومَ الرَوعِ حَسبي أَجابَني","ذَوُو حَسَبٍ في ذِروَةِ المَجدِ فاخِرِ",9,"ر",1,0],["فأنادي خل عن عذلي","فلي التعذيب فيه حلا",10,"ل",2,0],["فَإنِ ادَّعَيْتَ بِأنَّ أقْمَارَ الدُّجَى","تَحْكِي سَنَاهَا كُنْتَ عَيْنَ الأحْمَقِ",11,"ق",1,0],["فإنْ أَدَمْتُمْ هجْرَ هِجرانِكمْ","فوَصْلُكمْ أَنْفَسُ أَغْراضي",12,"ض",2,0],["فإن أدعُ قومي إلى الاتحاد","دعوتُ بصدر الفلاة النَّعاما",13,"م",2,0],["فأنا دونه مقيمٌ بجسم","وأنا راحل اليه بقلب",14,"ب",1,0],["فأنادي ونور وجهك بادٍ","ذا صباح الصبوح يا ميُّ أشرق",15,"ق",1,0],["فإن ادعى بشرٌ وأقسم أنه","ساواك في شوط السماحة كُفِّرا",16,"ر",2,0],["فإنّ أداء حقوق الكتاب","دليل التمسك بالعترةِ",17,"ه",1,0],["فأنُادي إنْ كانَ لا بُدَّ من ذا","فاقبِضوها بِطارةِ الزَّبّال",18,"ل",1,0],["فأنا دُون المَلا شأني عَجيب","ليس يحلو لي سوَى الليل الطويل",19,"ل",1,0],["فان أدعي مملوكها كنت صادقا","لنعتها عندي وإني شكورها",20,"ر",3,0],["فإنا دَهمنا الأَرضَ مِن عَهد يافث","وَلليوم مازلنا نَرضُّ القَضا رضّا",21,"ض",2,0],["فإن أدركوا الأوطار لم يبد منهم","لعينك إلا جاحدٌ وكفور",22,"ر",1,0],["فَإِن أدنُ مِن فُلكِ الاَغارِقِ فَاقذِفُوا","عَلَيها لَهِيبَ النَّارِ لا تَتَوَقَّفُوا",23,"ف",3,0],["فأنا (دُعا) ..(ولّادة) العصر، التي","لو ألف (خنسا)، ما مَلَتْ لي راسا",24,"س",2,0],["فأنا دَفَنتُ مَلاَمِحِي","والحبُّ ذاك تكفنا",25,"ن",2,0],["فأناديه  إذا سميته","يا \" مفيش \" اذهب فأنت الأبخل",26,"ل",1,0],["فإنْ أَدركْتِ كُنْهي فارتويني","وإن أُعمِيتِ عنّي فارتحالا",27,"ل",2,0],["فإن أدركت آمالى وإلا","فليس على إلا الجتهاد",28,"د",1,0],["فإن أدْنُ قالوا مُريبٌ","وإن أنأَ قالوا كفَرْ!",29,"ر",1,0]]}