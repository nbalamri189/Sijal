{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[53,"عيدان مجموعان في عيد","https://www.aldiwan.net/poem11441.html","السريع"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[87,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[63,"الكأس قطب السرور والطرب","https://www.aldiwan.net/poem51765.html","المنسرح"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[82,"نفى هم شيبي سرور الشباب","https://www.aldiwan.net/poem31576.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[82,"أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","https://www.poetsgate.com/ViewPoem.aspx?id=3585",""],[53,"أغرُّ مُخيلاتِ الأماني لَمُوعها","https://www.poetsgate.com/ViewPoem.aspx?id=29518",""],[113,"تشاغل عن كل بطاعة ربه","https://www.aldiwan.net/poem16536.html","الطويل"],[154,"الطعن والضرب منسوبان للعرب","https://www.aldiwan.net/poem68456.html","البسيط"],[164,"تولت فما من مطمع في لقائها","https://www.aldiwan.net/poem58712.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[240,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[280,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[325,"لك الحمد يا مولاي كم أنت محسن","https://www.aldiwan.net/poem67184.html","الطويل"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[382,"رعى الله ديرا كنت فيه مسلما","https://www.aldiwan.net/poem59252.html","الطويل"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[435,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[466,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem16421.html","الوافر"],[482,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[584,"تعود على الإحسان يغنيك زاده","https://www.aldiwan.net/poem28338.html","الطويل"],[591,"غنينا به عن كل لهو ولذة","https://www.aldiwan.net/poem17978.html","الطويل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101202","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90536","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70923","البسيط"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113645","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132856","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79795","المتقارب"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95105","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141735","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47118","الطويل"],[2528,"","https://poetry.dctabudhabi.ae/diwan/poem/199542","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65246","الوافر"],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141891","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35572","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77176","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120447","البسيط"],[5020,"أيا وقفبة البين ماذا شببت","https://www.poetsgate.com/ViewPoem.aspx?id=201049",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5842,"إلى بشار الأسد بعد خطابه الثاني ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=62445",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""]],"verses":[["فَمِن صَبَواتٍ تَستَقيمُ لِمائِلٍ","وَمِن أَريَحِيّاتٍ تَهُبُّ بِنائِمِ",0,"م",1,0],["فمن صواب الرأي لُقِّيتَهُ","جمعُك بين العيد والغيدِ",1,"د",1,0],["فمن صد عن نفَّاحها وبرودها","فعندي له لفّاحها وسَفوعها",2,"ع",3,0],["فمن صور مجللة فِراء","ووِلدان مسربلة جبايا",3,"ي",2,0],["فمن صقيلِ المُدُودِ مُطَّردٍ","كأنه ماءُ صفحةِ القُضُبِ",4,"ب",1,0],["فَمِن صَدرِهِ رَحباً وَمِن وَجهِهِ سَناً","وَمِن صِيتِهِ فَرعاً وَمِن حِلمِه أَصلا",5,"ل",2,0],["فمن صَوْتِ رَعدٍ يسوق السحابَ","كما يسمعُ الفحلُ شولاً رغاءَ",6,"ا",2,0],["فمن صارمٍ بالكف يحمل كلها","ومن صارمٍ يختص بعض الأنامل",7,"ل",1,0],["فَمِنْ صِحَّةِ الإِنْسَانِ ما فِيهِ سُقْمُهُ","وَمِنْ أَمْنِهِ مَا فَاجَأَتْهُ الْمَخَاطِرُ",8,"ر",1,0],["فمن صدره رحباً ومن وجهه سناً","ومن صيتِه فرعا، ومن حمله أصلا",9,"ل",2,0],["فمن صدَّ من نَفَّاحها وبَرُودها","فعندي له لفَّاحها وسَفُوعها",10,"ع",3,0],["فَمنصِبَهُ في كُل مصر فَضائل","وَقَد عَقَد الأَنداد عَن مِثلَها الفلس",11,"س",1,0],["فمن صوارمَ مثل النَّار في صعد","ومن سوابقَ مثلِ الماءِ في صبب",12,"ب",1,0],["فمن صان أنثى خوف عار فهذه","من العار صانت حوتي أوليائها",13,"ا",3,0],["فمن صابَ كنتَ شريكا له","ومن زَلّ بايَنْتَه باعْتِصام",14,"م",1,0],["فَمُنصُلُهُ مِن دِماءِ العِشارِ","أَو مِن دِماءِ العِدى مُختَصِب",15,"ب",1,0],["فَمِنْ صاهِلٍ ضَافِي السَّبِيبِ مُطَهَّم","وَسَابِحَةٍ تَرْدِي عَلَى إثْرِه سَفْوَا",16,"و",2,0],["فَمِن صائدٍ عنقاءَ تبهجُ نفسه","إِلى صائد حيّات سوءٍ تبيدها",17,"د",3,0],["فَمَنصورُهُ القُطرُ البَهِيَّ لَها الهَنا","بِتَوكيلِهِ فيها وَاِنعَم بِها بُشرى",18,"ر",2,0],["فَمِن صَبرٍ تَداعى لِلتَداعي","وَمِن حُزنٍ تَداعى بِالنَفيرِ",19,"ر",1,0],["فمن صيدنايا كان مطلعُ نوره","فأحسن ببدرٍ طلَّ من ذلكَ الحمى",20,"م",2,0],["فمن صدور العوالي ما يرى وصباً","ومن نفوس المعالي ما شفى سقما",21,"م",2,0],["فمن صفات مجدٍ قد أضأت","زواهرها بأكثر ما أشاعوا",22,"ع",3,0],["فمنْصورانِ حَبْرٌ أو إِمامٌ","ببأسِكَ حينَ يحْتَدم الخِصامُ",23,"م",1,0],["فمِن صريعٍ على الآثارِ من سَهَفٍ","يستافُهنَّ وللأطلالِ يعتنقُ",24,"ق",1,0],["فمِن صامتٍ لم يَستَطِع وصفَ سُقمِه","ومِن ناطقٍ مِن نُطقِه لم يَجِد صَبرا",25,"ر",2,0],["فمن صَحَبَ الإِحْسَانَ أغناهُ فضلُهُ","ومن صَدَّ عنه النَّاس ضاع عتادُهُ",26,"د",2,0],["فَمنْ صَدَّ عَنّا حَسْبُه الصَّدُّ وَالقِلى","ومَنْ فَاتنَا يَكْفيهِ أنّا نَفُوتهُ",27,"ه",1,0],["فمن صفة تدعى المصابيح عنده","وفوق السما تدعى الثريا أو الشعرى",28,"ر",2,0],["فمَن صادَ العصافرَ واجتَباها","يُداعبُها تراه يهابُ بُرا",29,"ر",2,0],["فمنْ صديقُك يا مَنْ لا صديق له","ومن محبُّك يا مغرورُ في الدار",30,"ر",1,0],["فمن صبواتٍ تستفزُّ فؤاده","ومن زفراتٍ أضرمت فيه أضلعا",31,"ع",2,0],["فمن صنعةِ البدرِ المنيرِ نُصُولُها","ومن نسجِ أنفاسِ الرِّياحِ دُرُوعُها",32,"ع",3,0],["فمن صاحب الأمر أمس استبان","لنا معجزٌ أمرُهُ باهرُ",33,"ر",1,0],["فمن صدره شبه الحسين رجله","وللحسن الاعلى وحسبك فاعدد",34,"د",1,0],["فَمن صَممٍ بِها وَحِذَارِ واشٍ","جَعلتُ لَها كَلامي بالإشارَة",35,"ه",1,0],["فمِن صادحاتٍ فوق غُصنِ أراكة","يهجن بلابيل الشَّجيّ إذا دعا",36,"ا",1,0],["فمن صدرها الرمان يحرم قطفهُ","وفي فمها حلَّ الرحيق المعتق",37,"ق",1,0],["فمن صورةٍ لَوْ نَالها البَدْرُ في الدّجى","أو الشّمسُ ما آنستَ من أحَدٍ رشدا",38,"د",2,0],["فمن صادر قد آب بالري حامد","ومن وارد شاح بفيه ليكرعا",39,"ع",2,0],["فَمِن صفاتِهَا أَنهَا جزيرَه","مُنقَسِمَه في البَحرِ وكبيرَه",40,"ه",1,0],["فمنصوبُ القوام ضممتُ منه","ومضموما فتحتُ بلام جرّ",41,"ر",1,0],["فمن صم عن حق وأعوج عن هدى","أزار وريديه الأصم المقوما",42,"م",2,0],["فمن صعر الدّنيا أقاموا ومن ردى","أقالوا ومن فتك الزّمان أقادوا",43,"د",3,0],["فَمِن صدغِ لامٍ جالَ في خَدّ مهرَق","فراقَ سَواد مِنهُما وَبياضُ",44,"ض",1,0],["فَمِن صَحبِ الأَدنى يُصِبهُ عُوارُهُ","وَكُل قَرين لِلفَتى مِنهُ يَقبَس",45,"س",1,0],["فمن صروف الليالي منتهى عبر","وفي التجارب ما يغنى عن الخبر",46,"ر",1,0],["فمن صرف دمع جرى للفرا","ق وممتزج بعده بالدّم",47,"م",1,0],["فمنصوصها في ترك من أظهر الهدى","وباطنه في الاعتقاد على الضد",48,"د",1,0],["فمن صدق المعصوم فيما أتى به","وكان به متيقناً ومعظما",49,"م",2,0],["فمن صباحٍ مُترعٍ بالشَّذا","تنسجه ومن شعاعِ البُروقْ",50,"ق",1,0],["فمن صاعد فيها لأقصى مدارك ال","مفاهيم إذ تبدو على متن لجتي",51,"ت",2,0],["فمِنْ صمتِنا قد تفجّرَ صوتٌ","وفي التّيهِ نِلنا سَواءَ السبيلِ",52,"ل",1,0],["فمن صدر عاليه الصدور انتظامها","ومن حد ماضيه الرؤوس انتثارها",53,"ر",3,0]]}