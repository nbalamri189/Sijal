{"poems":[[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[63,"خطرت لذكرك يا أميمة خطرة","https://www.aldiwan.net/poem45810.html","الكامل"],[63,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[63,"بدا والثريا في مغاربها قرط","https://www.aldiwan.net/poem46211.html","الطويل"],[55,"أيبطل إحرامي كتاب كتبته","https://www.aldiwan.net/poem26099.html","الطويل"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"يا مليك القلوب يحفظك الله","https://www.aldiwan.net/poem9827.html","عموديه"],[93,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[93,"مهد العذر بعد ما أنا رائو","https://www.aldiwan.net/poem11316.html","الخفيف"],[93,"أيبكي أبناءك اليتم","https://www.aldiwan.net/poem11403.html","المنسرح"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[91,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[85,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[45,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[45,"ألما فات من تلاق تلاف","https://www.aldiwan.net/poem65153.html","الخفيف"],[45,"هب الدار ردت رجع ما أنت قائله","https://www.aldiwan.net/poem65535.html","الطويل"],[97,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[69,"أيبست أفئدة بالحزن يا خضر","https://www.aldiwan.net/poem28056.html","البسيط"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[105,"هو الجد لا عذر للهازلين","https://www.aldiwan.net/poem42056.html","المتقارب"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[105,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8239","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16671","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10807","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54845","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54578","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141977","الخفيف"],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[91,"دمعة على جبران جبران","https://www.poetsgate.com/ViewPoem.aspx?id=52997",""]],"verses":[["أَيُّ باقٍ يُبقي عَليكَ وَلَو كُن","تَ مُوَقّىً مِنَ الخُطوبِ مُعَرّى",0,"ر",2,0],["أَيُبِلُّ مَن جَلَبَ السَّقامَ طَبيبُهُ","وَيُفيقُ مَن سَحَرَتهُ عَينُ الرَّاقي",1,"ي",1,0],["أيَبْغي العِدا شَأْوَهُمْ والرِّياحُ","إذا ما ابْتَدَرْنَ إليهِ وَجينا",2,"ن",2,0],["أيَبْغي عُلاً تَسمو إليهنَّ صاعِداً","ضَجيعُ هَوَيْنَى مِنْ سَجيَّتهِ الهَبْطُ",3,"ط",1,0],["أَيُبطِلُ إِحرامي كِتابٌ كَتَبتُهُ","إِلى أَهلِ وُدّي أَم عَلَيَّ بِهِ دَمُ",4,"م",1,1],["أَيُّ بُنْيَانِ مَعَالٍ","آمِن خَوْفَ انْقِضَاضِ",5,"ض",1,0],["أَي بُدورَ الشَرقِ ماذا نابَكُم","في مَسارِ الغَربِ مِن صَرفِ الغِيَر",6,"ر",1,0],["أي بحر زمردي محاط","بإطارٍ من عسجدي الرمال",7,"ل",1,0],["أَيُّ بِدْعٍ إِذَا تَلَقَّتْهُ مِصْرٌ","وَبَنُوهَا بِالبِشْرِ وَالتَّرْحِيبِ",8,"ب",1,0],["أيُّ بَرَّتْ كَبِرِّكِ كَبِرِّكِ بِابْنُ","جَعَلَتْهُ المِثَالَ بَيْنَ الْبنِينِ",9,"ن",1,0],["أَيُّ بَيْتٍ كَذَلِكَ البَيْتِ عِزّاً","أَيُّ مَجْدٍ كَمَجْدِهِ المُتَقَادِمْ",10,"م",1,0],["أَيُّ بَأْسِ وَأَيُّ حِلْمِ وَهَلْ يُلْفَى","كَذَاكَ النَّدَى وَتِلْكَ المَكَارِمْ",10,"م",1,0],["أَيَبْكِي أبْنَاءَكَ اليُتْمُ","وَكَمْ سَرَرْتَ الأَيْتَامَ قَبْلَهُمُ",11,"م",1,1],["أَي بَحَّاثَةٍ أَرِيبٍ أَدِيبٍ","بَانَ عَنَّا وَحَقُّهُ مَهْضُومُ",12,"م",1,0],["أيُبكيكَ سفكي ماء وجْهي برحلةٍ","تُنَزِّهُني عن سفكه في الألائمِ",13,"م",1,0],["أَيَبيتُ يَشرَبُ مِن مَعينِ دُموعِهِ","وَتَبيتُ تَحسوها كَعَينِ الديكِ",14,"ك",1,0],["أَيَبيتُ قَومُكَ فَوقَ أَشواكِ الغَضى","وَتَبيتُ تَخطُرُ بِالحَريرِ وَتَرفُلُ",15,"ل",1,0],["أَيُّ بِدَعٍ إِن أَخرَجَ الحَقلُ لِلنا","سِ صُنوفَ النَباتِ في نَيسانِ",16,"ن",1,0],["أيبقى المكثرون من الخطايا","إذا ماتوا وليس لهم جزاءُ",17,"ا",2,0],["آيِبُ الفَضلِ كُلَّما","آبَتِ الشَمسُ وَالقَمَر",18,"ر",1,0],["أَيَبطُلُ عيدُ الدَهرِ مِن أَجلِ دُمَّلٍ","وَتَخبو مَجاليهِ وَتُطوى مَواكِبُه",19,"ب",2,0],["أَيبَسَ العَيشُ بَعدَهُنَّ وَقَد يُع","هَدُ فيهِنَّ وَهوَ غَضُّ رَطيبُ",20,"ب",1,0],["أَيُّ بادي أُكرومَةٍ أَو مَرَوٍّ","بَينَ رَأيَينِ أَو حَصاةِ قِذافِ",21,"ف",1,0],["أَيَبلُغُهُ بِالبَذلِ قَومٌ وَقَد سَعَوا","فَما بَلَغوا شُكرَ الَّذي هُوَ باذِلُه",22,"ل",2,0],["أي بؤسي أملت عليك مرير ال","قول حقاً أسأت للبأساء",23,"ا",2,0],["أيبسْتَ أفئدةً بالحزنِ يا خضْرُ","فالدمعُ يسقيكَ إنْ لمْ يسقِكَ المطرُ",24,"ر",1,1],["أيْ بنيَّ اسمعْ وصايا جَمعتْ","حكماً خُصَّتْ بها خيرُ المللْ",25,"ل",1,0],["أيبقى الفسادُ فلا حاجزٌ","يهدُّ قُواهُ ولا حائلُ",26,"ل",1,0],["أَيُبَرُّ من سفَكَ الدّماءَ ويُتَّقَى","ويُسيءُ من دَفَعَ البَلاءَ ويأثَمُ",27,"م",1,0],["أيبقى من نُصابُ على يديهِ","ويُمعِنُ مِدْرَهُ القومِ الذَّهابا",28,"ب",2,0],["أَيَبغي الإِنكليزُ لَها اِستلاباً","ولمّا تَختضِب بِدَمٍ سِجامِ",29,"م",1,0],["أيَّ بشرى زفَّها أرخم لحنِ","من تُراه ذلك الطيف المغنِّي",30,"ي",1,0],["أَيَبكي حَمامُ الأَيكِ مِن فَقدِ إِلفِهِ","وَأَصبِرُ ما لي عَن بُثَينَةَ مِن صَبرِ",31,"ر",1,0],["أيَبْسُطُ عذْري مُنْعِمٌ أمْ يَخُصّني","بما هوَ حَظّي مِن ألِيمِ عِتابِ",32,"ب",1,1],["أَيَبكي الحَمامُ الوُرقُ مِن فَقدِ إِلفِهِ","وَتَسلو وَما لي عَن أَليفِيَ مِن صَبرِ",33,"ر",1,0],["أَيْ بناتِ المَاءِ غَبْنٌ بَيِّنٌ","أَنْ تُرَى سُوداً وَمَا أَبْهَاكِ شُقْرَا",34,"ر",2,0],["أَيَّ بَانٍ أَقَامَ هَذِي المَنَارَ","وَهَدَى النَّاسَ مُدْلَجِينَ حَيَارَى",35,"ر",2,1],["أَيُّ بَاقٍ فِي صَفْحَةِ الحَمْدِ أَبْقَى","مِنْ مَسَاعٍ خَلَّدْتهَا وَأَيَادِ",36,"د",1,0],["أَيَبْلُغُ مِنْكَ سَمْعَ المُسْتَجِيبِ","كَمَا عَوَّدْتِهِ صَوْتُ الحَرِيب",37,"ب",1,1],["أَيُّ بُشْرَى حَمَّلْتُموهَا الْكِتَابَا","جَاءَنِي دَاعِياً فَكُنْتُ الجَّوَابَا",38,"ب",2,1],["أيبالي من عنده البعد والقرب","سواءٌ أن يعجزَ المعجزينا",39,"ن",2,0],["أيباهي بحسنه متباه","وهي ليلى وذاك قول الإله",40,"ه",1,0],["أيبشَمُ بالزاد جوفٌ، وجوفٌ","يعُزُّ عليه فتاتُ الغذاء؟",41,"ا",2,0],["أيُّ بشْرَى إلى السَّمَواتِ زُفَّتْ","رَدَّدَتْها أملاكُها تَرديدا؟",42,"د",2,0],["أيُّ بحر من البيان بامواجِ","المعاني فياضةً ، متلاطِم",43,"م",1,0],["أيبست روضك الجميل ، ولم تظفر","بغير التّراب من أدواحك",44,"ك",1,0]]}