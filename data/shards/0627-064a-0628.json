https://www.poetsgate.com/ViewPoem.aspx?id=187413",""],[5431,"وعفريتُ قنديلي يئنُ ويشتكيٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189638",""],[5431,"لاتلومي تعلّقي بالرجالِ....","https://www.poetsgate.com/ViewPoem.aspx?id=200455",""],[5431,"القبة العليا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210728",""],[5616,"قاصمة الظهر","https://www.poetsgate.com/ViewPoem.aspx?id=203429",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5736,"فتات حديث","https://www.poetsgate.com/ViewPoem.aspx?id=211831",""],[5756,"الجمهرة","https://www.poetsgate.com/ViewPoem.aspx?id=5430",""],[5776,"الجبينُ والمخدة","https://www.poetsgate.com/ViewPoem.aspx?id=199341",""],[6079,"أيُبكيكَ رَسمٌ في الشآم عليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207850",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[5001,"رحلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80711&r=&rc=1",""]],"verses":[["أَيُّ باقٍ يُبقي عَليكَ وَلَو كُن","تَ مُوَقّىً مِنَ الخُطوبِ مُعَرّى",0,"ر",2,0],["أَيُبِلُّ مَن جَلَبَ السَّقامَ طَبيبُهُ","وَيُفيقُ مَن سَحَرَتهُ عَينُ الرَّاقي",1,"ق",2,0],["أيَبْغي العِدا شَأْوَهُمْ والرِّياحُ","إذا ما ابْتَدَرْنَ إليهِ وَجينا",2,"ن",2,0],["أيَبْغي عُلاً تَسمو إليهنَّ صاعِداً","ضَجيعُ هَوَيْنَى مِنْ سَجيَّتهِ الهَبْطُ",3,"ط",1,0],["أَيُبطِلُ إِحرامي كِتابٌ كَتَبتُهُ","إِلى أَهلِ وُدّي أَم عَلَيَّ بِهِ دَمُ",4,"م",1,1],["أَيُّ بُنْيَانِ مَعَالٍ","آمِن خَوْفَ انْقِضَاضِ",5,"ض",1,0],["أَي بُدورَ الشَرقِ ماذا نابَكُم","في مَسارِ الغَربِ مِن صَرفِ الغِيَر",6,"ر",1,0],["أي بحر زمردي محاط","بإطارٍ من عسجدي الرمال",7,"ل",1,0],["أَيُّ بِدْعٍ إِذَا تَلَقَّتْهُ مِصْرٌ","وَبَنُوهَا بِالبِشْرِ وَالتَّرْحِيبِ",8,"ب",1,0],["أيُّ بَرَّتْ كَبِرِّكِ كَبِرِّكِ بِابْنُ","جَعَلَتْهُ المِثَالَ بَيْنَ الْبنِينِ",9,"ن",1,0],["أَيُّ بَيْتٍ كَذَلِكَ البَيْتِ عِزّاً","أَيُّ مَجْدٍ كَمَجْدِهِ المُتَقَادِمْ",10,"م",1,0],["أَيُّ بَأْسِ وَأَيُّ حِلْمِ وَهَلْ يُلْفَى","كَذَاكَ النَّدَى وَتِلْكَ المَكَارِمْ",10,"م",1,0],["أَيَبْكِي أبْنَاءَكَ اليُتْمُ","وَكَمْ سَرَرْتَ الأَيْتَامَ قَبْلَهُمُ",11,"م",1,1],["أَي بَحَّاثَةٍ أَرِيبٍ أَدِيبٍ","بَانَ عَنَّا وَحَقُّهُ مَهْضُومُ",12,"م",1,0],["أيُبكيكَ سفكي ماء وجْهي برحلةٍ","تُنَزِّهُني عن سفكه في الألائمِ",13,"م",1,0],["أَيَبيتُ يَشرَبُ مِن مَعينِ دُموعِهِ","وَتَبيتُ تَحسوها كَعَينِ الديكِ",14,"ك",1,0],["أَيَبيتُ قَومُكَ فَوقَ أَشواكِ الغَضى","وَتَبيتُ تَخطُرُ بِالحَريرِ وَتَرفُلُ",15,"ل",1,0],["أَيُّ بِدَعٍ إِن أَخرَجَ الحَقلُ لِلنا","سِ صُنوفَ النَباتِ في نَيسانِ",16,"ن",1,0],["أيبقى المكثرون من الخطايا","إذا ماتوا وليس لهم جزاءُ",17,"ا",2,0],["آيِبُ الفَضلِ كُلَّما","آبَتِ الشَمسُ وَالقَمَر",18,"ر",1,0],["أَيَبطُلُ عيدُ الدَهرِ مِن أَجلِ دُمَّلٍ","وَتَخبو مَجاليهِ وَتُطوى مَواكِبُه",19,"ب",2,0],["أَيبَسَ العَيشُ بَعدَهُنَّ وَقَد يُع","هَدُ فيهِنَّ وَهوَ غَضُّ رَطيبُ",20,"ب",1,0],["أَيُّ بادي أُكرومَةٍ أَو مَرَوٍّ","بَينَ رَأيَينِ أَو حَصاةِ قِذافِ",21,"ف",1,0],["أَيَبلُغُهُ بِالبَذلِ قَومٌ وَقَد سَعَوا","فَما بَلَغوا شُكرَ الَّذي هُوَ باذِلُه",22,"ل",2,0],["أي بؤسي أملت عليك مرير ال","قول حقاً أسأت للبأساء",23,"ا",2,0],["أيبسْتَ أفئدةً بالحزنِ يا خضْرُ","فالدمعُ يسقيكَ إنْ لمْ يسقِكَ المطرُ",24,"ر",1,1],["أيْ بنيَّ اسمعْ وصايا جَمعتْ","حكماً خُصَّتْ بها خيرُ المللْ",25,"ل",1,0],["أيبقى الفسادُ فلا حاجزٌ","يهدُّ قُواهُ ولا حائلُ",26,"ل",1,0],["أَيُبَرُّ من سفَكَ الدّماءَ ويُتَّقَى","ويُسيءُ من دَفَعَ البَلاءَ ويأثَمُ",27,"م",1,0],["أيبقى من نُصابُ على يديهِ","ويُمعِنُ مِدْرَهُ القومِ الذَّهابا",28,"ب",2,0],["أَيَبغي الإِنكليزُ لَها اِستلاباً","ولمّا تَختضِب بِدَمٍ سِجامِ",29,"م",1,0],["أيَّ بشرى زفَّها أرخم لحنِ","من تُراه ذلك الطيف المغنِّي",30,"ي",1,0],["أَيَبكي حَمامُ الأَيكِ مِن فَقدِ إِلفِهِ","وَأَصبِرُ ما لي عَن بُثَينَةَ مِن صَبرِ",31,"ر",1,0],["أيَبْسُطُ عذْري مُنْعِمٌ أمْ يَخُصّني","بما هوَ حَظّي مِن ألِيمِ عِتابِ",32,"ب",1,1],["أَيَبكي الحَمامُ الوُرقُ مِن فَقدِ إِلفِهِ","وَتَسلو وَما لي عَن أَليفِيَ مِن صَبرِ",33,"ر",1,0],["أَيْ بناتِ المَاءِ غَبْنٌ بَيِّنٌ","أَنْ تُرَى سُوداً وَمَا أَبْهَاكِ شُقْرَا",34,"ر",2,0],["أَيَّ بَانٍ أَقَامَ هَذِي المَنَارَ","وَهَدَى النَّاسَ مُدْلَجِينَ حَيَارَى",35,"ر",2,1],["أَيُّ بَاقٍ فِي صَفْحَةِ الحَمْدِ أَبْقَى","مِنْ مَسَاعٍ خَلَّدْتهَا وَأَيَادِ",36,"د",1,0],["أَيَبْلُغُ مِنْكَ سَمْعَ المُسْتَجِيبِ","كَمَا عَوَّدْتِهِ صَوْتُ الحَرِيب",37,"ب",1,1],["أَيُّ بُشْرَى حَمَّلْتُموهَا الْكِتَابَا","جَاءَنِي دَاعِياً فَكُنْتُ الجَّوَابَا",38,"ب",2,1],["أيبالي من عنده البعد والقرب","سواءٌ أن يعجزَ المعجزينا",39,"ن",2,0],["أيباهي بحسنه متباه","وهي ليلى وذاك قول الإله",40,"ه",1,0],["أيبشَمُ بالزاد جوفٌ، وجوفٌ","يعُزُّ عليه فتاتُ الغذاء؟",41,"ا",2,0],["أيُّ بشْرَى إلى السَّمَواتِ زُفَّتْ","رَدَّدَتْها أملاكُها تَرديدا؟",42,"د",2,0],["أيُّ بحر من البيان بامواجِ","المعاني فياضةً ، متلاطِم",43,"م",1,0],["أيبست روضك الجميل ، ولم تظفر","بغير التّراب من أدواحك",44,"ك",1,0],["أيّ بدع في ثورة من محبّ","قد يثور المقيّد المكبول",45,"ل",1,0],["أيّ بدع في المهرجانات يصنعن","فحقّ المتوّج المهرجان ....",46,"ن",1,0],["أيّ بدع إذا بكيت لسعد","إن بكى السيف حدّه ما تعدّى",47,"د",2,0],["أي بأس له اذا ذكر احتا","طت وفود الخمود بالنيران",48,"ن",1,0],["أيبست وقدة الحياة ضلوعي","فأغثني بوبلٍ حسنٍ ترود",49,"د",1,0],["أيَبْيَضُّ فَرعى والجوى في جوانحى","كأَنّ الهدى يا قلب مسكنُه راسي",50,"س",2,0],["أيبقى هذا الاعجمي بكفره","عزيزا وأنتم مثل فقع الفلا ذلا",51,"ل",2,0],["أيبلغ الجهل هذا الجد ويحكمه","ما كنت أحسب هذا كله فيه",52,"ي",2,0],["أي بأس كبأسه حيثما ثار","بوجه الأعداء كالبركان",53,"ن",1,0],["أي بني مصر هناء لكم","ما نشرتم في ذراكم من علم",54,"م",1,0],["ايبغي عذولي نسخ آية حسنه","وياقوت بالريحان قد خط احرفا",55,"ف",2,0],["أَي بَأسٍ عَلَيكِ وَالأُمَّةُ الشَي","خَةُ عَينٌ وَمِسمَعٌ وَكَلامُ",56,"م",1,0],["أَيبسَ اللَيلُ في نَقاوَةِ خَدَّي","ها بحرِّ الأَنينِ تِلكَ الزُهورا",57,"ر",2,0],["أَيُّ بُرحٍ لَو كانَ لي مُسعِدٌ في","هِ وَجُرحٍ لَو كانَ لي مِنهُ آسِ",58,"س",1,0],["أيبني المرءُ في الدنيا ويقني","كما نسجت بيوتاً عنكبوت",59,"ت",1,0],["أيبقى بقاء الدهر كل ضرورة","وتبقى على الدنيا سلامة سلطان",60,"ن",1,0],["أَيُّ بُركانٍ مِن جِبالِ النارِ","فَتَحتُ فوهَ لِاِلتِقامِ العِمارِ",61,"ر",1,0],["أي بني قوم حسبكم","عذل من بالحمى افتتن",62,"ن",1,0],["أَيّ بَيت كَبَيتِكُم آل طه","طهر اللَه ساكِنيه وَمجد",63,"د",1,0],["أَيَبيَضُّ رَأسي وَالأَسى بَينَ أَضلُعي","كَأَنَّ هُمومَ المَرءِ مَسكَنُها الشِعرُ",64,"ر",1,0],["أَيَبْطُلُ ذَحْلٌ والنبيُّ وليُّه","ويُهْمَل وتْرٌ والمهَيْمنُ طالبه",65,"ب",2,0],["أيّ برق أفاد أي غمام","وَصباح أدّى لِضوءِ نهار",66,"ر",1,0],["أيبلغنا بنو التامي","ن ثم نبيت كالبهم",67,"م",1,0],["أي بؤس يبز بؤسا عميم","الإثم فيما بغى وما اقترفه",68,"ف",2,0],["أي بعثٍ لما انتهى الناس منه","باندثار الدفين والدّفان",69,"ن",1,0],["أي بيتي فصلٍ وفضلٍ أقاما","بين خرمٍ عراهما واخترامِ",70,"م",1,0],["أيُّ بسطٍ خُضر من النبت زينت","برقوم الحوذانِ والنمَّامِ",70,"م",1,0],["أي بعل جلا عليه عروس المد","ن بعد النشوز يوم الزفاف",71,"ف",1,0],["أي بشرى للخيل جلت عن الش","شكر ونعمى لتلكم الأخفاف",71,"ف",1,0],["أيُّ بدع لو ساعدتني سعادٌ","شاب فودي وضاع مني الفؤادُ",72,"د",1,1],["أيْ بنيّ ذاك إرثٌ أسّهُ من","في السّماءِ وابتناهُ منْ أعبْتا",73,"ت",2,0],["أيْ بنيّ هل شقاكَ ما ورثتا؟","أمْ ثقيلُ الحملِ كانَ فاسْترحْتا؟",73,"ت",2,0],["أيَبيتُ مُخضَراً يَمُجُّ تُرابُهُ","رَيّاً وَيُصبِحُ دَوحُهُ مَطلُولا",74,"ل",2,0],["أيبتغي رجل الدنيا الجديدة ما","لم يرج من قدم الدنيا النبيّونا",75,"ن",2,0],["أيُّ بِدعٍ أنابهُ من مُنيبٍ","جاءَ مستغفراً الى غَفّارِ",76,"ر",1,0],["أي بليغ أعيت بلاغته","قسّاً وفاقت إياس في لسنه",77,"ن",2,0],["أيُّ بدر نأى علينا بزوغُهْ","ذاك بدرٌ أعيا المحاقَ بلوغُهْ",78,"غ",2,1],["أيّ بيتِ سَمَتْ دعائمُهُ لم","يتناوَلْ سُمُوَّها التقويض",79,"ض",1,0],["أيْبَسَ الحُزنُ أدْمُعي فاسْتَعَارَتْ","أعيُني أدمُعَ القطا والشموعِ",80,"ع",1,0],["أيبغي التصابي بعدما ابيض فوده","فيا للنهى للشيخ بالدف يضرب",81,"ب",1,0],["أيْبَسْتَمْ عُود الهُدَى بُرْهَةً","فَعادَ غَضًّا نُزْهَةَ النَّاظِر",82,"ر",1,0],["أَي بُشرى أَتَت إِلي وَلَكن","لَم أتمم مِن الصبا أَغراضا",83,"ض",2,0],["ايبس من جلدة خنزيرٍ","بل انتن من صرم البغلهْ",84,"ل",2,0],["أَيُّ بَدْرٍ مِنْ قُرَيْشٍ بَزَغَا","فاضِحاً شَيْطانَ كُفْرٍ نَزَغَا",85,"غ",2,1],["أَيَبْقى جَميعاً شَمْلُها وَهْيَ سَبْعَ