{"poems":[[55,"جاء بها قالصة عن ساق","https://www.aldiwan.net/poem29930.html","الرجز"],[85,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[46,"ذل السؤال شجى في الحلق معترض","https://www.aldiwan.net/poem29718.html","البسيط"],[76,"من موقف أفصحت بيض السيوف به","https://www.aldiwan.net/poem13190.html","البسيط"],[42,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[369,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[371,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[406,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[409,"يا جيرة في القلب مأواهم","https://www.aldiwan.net/poem33406.html","السريع"],[422,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[438,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[463,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54112","الرجز"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39031","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37944","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16835","الرجز"],[1151,"","https://poetry.dctabudhabi.ae/diwan/poem/204383","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46555","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109224","السريع"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107298","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120874","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93836","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114583","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102749","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4767,"خليفة المختار","https://www.poetsgate.com/ViewPoem.aspx?id=179823",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5122,"مابين كفي والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=24074",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5596,"الأمل والصدى","https://www.poetsgate.com/ViewPoem.aspx?id=205464",""],[5943,"العين إن خاصمت","https://www.poetsgate.com/ViewPoem.aspx?id=20470",""],[5956,"حدْسي قال لي","https://www.poetsgate.com/ViewPoem.aspx?id=182219",""],[6142,"بالأمس كانوا معي واليوم قد رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=155753",""]],"verses":[["مَناشِطُ العُشبِ عَلى المَلّاقِ","أَشعَثُ بادي جِنجِنِ التَراقي",0,"ق",2,0],["من أشهبٍ قد بدا صبحاً تُراعُ له","شُهبُ السماء فإن الصبح يخفيها",1,"ي",3,0],["من أشهب كالصبح يطلع غرةً","في مستهل العسكر الجرّارِ",2,"ر",1,0],["من أشهب كالصبح يعلو سرجَهُ","صبحٌ به نجم الضلالة يأفلُ",3,"ل",1,0],["مَن أَشتَكي وَإِلى مَن أَعتَزي وَنَدى","مَن أَجتَدي كُلُّ أَمري فيكَ مُنتَقِضُ",4,"ض",1,0],["مِن أَشهَبٍ شَقَّ عَنهُ النَقعُ هَبوَتَهُ","كَما تَفَرّى أَديمُ اللَيلِ عَن فَلَقِ",5,"ق",1,0],["مِنَ أَشياءَ قَد لاقَيتُها فيكَ لَم يَكُن","لِيُحصيها مَن مَنَّ وَصلاً وَعَدَّدا",6,"د",2,0],["من أشاروا علّي كانوا غباء","ليتهم موضعي وكنت المشيره",7,"ر",2,0],["مَنِ اشتَهى أن يَرى شَخْصَ الكمالِ فقُلْ","له بوَجْهِ كمالِ الدَّولةِ اكْتَحِل",8,"ل",1,0],["من أَشقَرٍ يَبْدو كخدّ خَريدةٍ","خَجِلَتْ فما زادتْ سوى تَوْريد",9,"د",1,0],["مَناشيرُ ما دامَ الخِتامُ لِفاعُها","فَماضَرَّها ألا تُطانُ وَلا تُسحى",10,"ح",2,0],["من أشهبٍ صافي الأديم كالشَّفَق","وادهمٍ كقطعِةٍ من الغَسَق",11,"ق",1,0],["من أشرعوا الأقلام في نشر الهدى","وإذا تحيرت العقول أصابوا",12,"ب",3,0],["من أشعث الرأس ومن أغبر","ما غير بيت اللّه مغزاهم",13,"م",1,0],["من أشرف النَّاس وأَعلى نسباً","وكانَ من أَندى الورى يمينا",14,"ن",2,0],["من أشرقتْ للمجدِ منه شواهدٌ","غنيَ العِيانُ بها عن استِدلالِ",15,"ل",1,0],["مَنْ أَشرَقَتْ بسجاياهُ مَقاوِلُهُ","وأَعرَقَتْ فِي مَساعيهِ تبابعُهُ",16,"ع",2,0],["مَنِ اشتكَى أحزانَه","فما أجنَّ شجَنا",17,"ن",2,0],["مَن أشتكي الشوقَ إذ هَزَّت وسادتَهُ","مدامعٌ تَنتَحي أو أضلعٌ تَجِبُ",18,"ب",1,0],["مَنِ اِشتَرى الجَمَلَ الهَزيلَ عَلَّفَهُ","حَتّى بَدا سَمنُهُ لَدَيهِ فَاِنجَبَرا",19,"ر",2,0],["مَنِ اِشتَرى فَرَساً عَيباً رَآهُ بِهِ","أَعارَهُ لِفَتىً غَزا بِهِ الفُجَرا",19,"ر",2,0],["مَنِ اشترى القوسَ بما","يملكُه لا يُعْذَلُ",20,"ل",1,1],["مِنْ أشْقَرٍ كالبَرْقِ في وَمَضاتِهِ","أو أشْهَبٍ كالشُّهبِ في أضْوائِها",21,"ا",3,0],["مِنْ أَشرَفِ النّاسِ أَصلاً","مِن أَحسَنِ النّاسِ زِيّا",22,"ي",2,0],["من أشبع الجيش الكثير بصاعه","ولعسه روى عطاش القسطل",23,"ل",1,0],["مِن أَشهَلٍ كَعَينِهِ وَأَبيَضٍ","كَثَغرِهِ وَأَحمَرٍ كَخَدِّهِ",24,"د",2,0],["من أشرف الخلق طراً حبه فجرى","طي القلوب كجري الماء في الغصن",25,"ن",1,0],["مَن اِشتَرى المَدح مدح","مَن منع الناس اطرح",26,"ح",1,0],["من اشترى ما ليس يحتاجه","باع الذي يحتاج يوماً إِليه",27,"ي",2,0],["مِنْ أَشْهَبٍ كَالطِّرْسِ لاَحَ الطَّعْنُ فِي","لَبَّاتِهِ كَسُطُورِ خَطٍّ مُدْمَجِ",28,"ج",1,0],["مَن أَشادَ المَجدَ طِفلاً","وَبَنى بَيتَ الكَمالِ",29,"ل",1,0],["مِن أَشِنتى وَنَيجَرٍ وَسِرا ليو","نا وَمِن استُرالِيا وَالهُنودِ",30,"د",1,0],["من أشهبٍ مثل الشهاب بناره","يرمي رجيم من عداك مريدُ",31,"د",1,0],["من أشرقت في الكون من آثاره","شمس بها في كل داج يستضا",32,"ض",2,0],["من أشرقت في الورى شهامتهُ","شمسا وليلُ الحُروب مُعتكرُ",33,"ر",1,0],["من اشرقت شمس الهدى في قلبه","بلا وساطة النبي البر",34,"ر",1,0],["مِن أَشقَرٍ وَأَحمَرٍ","وَأَدهَمٍ وَأَشهَبِ",35,"ب",1,0],["من أشرقَت منهُ البدا","يةُ أشرقَت منهُ النهايه",36,"ا",3,0],["من أشبع ألفا من الجياع بصاع","زادا وظماء به ارتووا ولهم زاد",37,"د",1,0],["من أشرق الكون لما آن مولده","وكان قبل ظلام الجهل أدجاه",38,"ا",2,0],["من اشرقت بهداه كل داجية","لما أتى من جهالات واشراك",39,"ك",1,0],["مَن اشتَرى الباقي بالفاني يَفُز","بِهِ وَيَحمَد رَأيَهُ فيما اشتَرى",40,"ا",1,0],["من أشركوا بالله لم يتمكنوا","من قتله والمصطفى في الغار",41,"ر",1,0],["من أشفقَ يا ربُّ وجَرَّهْ","قطِّعْ يا مولانا حبْلَهْ",42,"ل",2,0],["من أشجرة(ن) نصف العرب من فنودها","من لا ينتمي فيها فلا معدنه بأصيل",43,"ل",1,0],["من أشرفِ النَّاس إن ضاقَ الزمانُ بهم","عفُّوا فَلا يَسأَلونَ النَّاسَ إلحافا",44,"ف",2,0],["مَن أشعلَ الروحَ قنديلاً وقافية؟","وبثَّ في دمنا من طِيبِه عَبَقا",45,"ق",2,0],["من أشعل البرق في آفاق موهبتي","وانزل الغيث في أرجائها مطرا",46,"ر",2,0],["من أشعلَ النارَ كي تُغتالَ فرحتُنا","وينعقَ البومُ والأحبابُ ينكلِموا",47,"م",3,0],["مُناشَدَتي أضَمِّنُها احترامي","إليك لكي تعود لفيىء حضني",48,"ن",2,0],["مناشداً دارهم والوجد يتحفني","بالحزن آنا وبالأشجان أحيانا",49,"ن",2,0]]}