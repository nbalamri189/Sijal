{"poems":[[53,"جاء بها قالصة عن ساق","https://www.aldiwan.net/poem29930.html","الرجز"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[83,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[44,"ذل السؤال شجى في الحلق معترض","https://www.aldiwan.net/poem29718.html","البسيط"],[74,"من موقف أفصحت بيض السيوف به","https://www.aldiwan.net/poem13190.html","البسيط"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[364,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[364,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[366,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[380,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[400,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[403,"يا جيرة في القلب مأواهم","https://www.aldiwan.net/poem33406.html","السريع"],[416,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[432,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[458,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[458,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"]],"verses":[["مَناشِطُ العُشبِ عَلى المَلّاقِ","أَشعَثُ بادي جِنجِنِ التَراقي",0,"ي",1,0],["من أشهبٍ قد بدا صبحاً تُراعُ له","شُهبُ السماء فإن الصبح يخفيها",1,"ي",3,0],["من أشهب كالصبح يطلع غرةً","في مستهل العسكر الجرّارِ",2,"ر",1,0],["من أشهب كالصبح يعلو سرجَهُ","صبحٌ به نجم الضلالة يأفلُ",3,"ل",1,0],["مَن أَشتَكي وَإِلى مَن أَعتَزي وَنَدى","مَن أَجتَدي كُلُّ أَمري فيكَ مُنتَقِضُ",4,"ض",1,0],["مِن أَشهَبٍ شَقَّ عَنهُ النَقعُ هَبوَتَهُ","كَما تَفَرّى أَديمُ اللَيلِ عَن فَلَقِ",5,"ق",1,0],["مِنَ أَشياءَ قَد لاقَيتُها فيكَ لَم يَكُن","لِيُحصيها مَن مَنَّ وَصلاً وَعَدَّدا",6,"د",2,0],["من أشاروا علّي كانوا غباء","ليتهم موضعي وكنت المشيره",7,"ر",2,0],["مَنِ اشتَهى أن يَرى شَخْصَ الكمالِ فقُلْ","له بوَجْهِ كمالِ الدَّولةِ اكْتَحِل",8,"ل",1,0],["من أَشقَرٍ يَبْدو كخدّ خَريدةٍ","خَجِلَتْ فما زادتْ سوى تَوْريد",9,"د",1,0],["مَناشيرُ ما دامَ الخِتامُ لِفاعُها","فَماضَرَّها ألا تُطانُ وَلا تُسحى",10,"ح",2,0],["من أشهبٍ صافي الأديم كالشَّفَق","وادهمٍ كقطعِةٍ من الغَسَق",11,"ق",1,0],["من أشرعوا الأقلام في نشر الهدى","وإذا تحيرت العقول أصابوا",12,"ب",3,0],["من أشعث الرأس ومن أغبر","ما غير بيت اللّه مغزاهم",13,"م",1,0],["من أشرف النَّاس وأَعلى نسباً","وكانَ من أَندى الورى يمينا",14,"ن",2,0],["من أشرقتْ للمجدِ منه شواهدٌ","غنيَ العِيانُ بها عن استِدلالِ",15,"ل",1,0],["مَنْ أَشرَقَتْ بسجاياهُ مَقاوِلُهُ","وأَعرَقَتْ فِي مَساعيهِ تبابعُهُ",16,"ع",2,0],["مَنِ اشتكَى أحزانَه","فما أجنَّ شجَنا",17,"ن",2,0],["مَن أشتكي الشوقَ إذ هَزَّت وسادتَهُ","مدامعٌ تَنتَحي أو أضلعٌ تَجِبُ",18,"ب",1,0],["مَنِ اِشتَرى الجَمَلَ الهَزيلَ عَلَّفَهُ","حَتّى بَدا سَمنُهُ لَدَيهِ فَاِنجَبَرا",19,"ر",2,0],["مَنِ اِشتَرى فَرَساً عَيباً رَآهُ بِهِ","أَعارَهُ لِفَتىً غَزا بِهِ الفُجَرا",19,"ر",2,0]]}