{"poems":[[55,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[88,"ما لي أرى بحر السياسة","https://www.aldiwan.net/poem10920.html","مجزوء الكامل"],[95,"بلغت من عيشي أعز مرام","https://www.aldiwan.net/poem11394.html","الكامل"],[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[53,"هي سوداء غير أن عليها","https://www.aldiwan.net/poem8172.html","الخفيف"],[87,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[71,"وإذا رأت عيناي عالي رتبة","https://www.aldiwan.net/poem29273.html","الكامل"],[48,"كيف الرباح وقد تألى ربنا","https://www.aldiwan.net/poem22713.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39609","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[119,"هيج البعد هواها","https://www.aldiwan.net/poem40431.html","عموديه"],[128,"اطو الصحيفة واتئد بعتابي","https://www.aldiwan.net/poem23768.html","الكامل"],[139,"حتام تأسى والحمام محتم","https://www.aldiwan.net/poem49156.html","الكامل"],[139,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[190,"إلفان متفقان شتهما الردى","https://www.aldiwan.net/poem43246.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[275,"ما كان أجمل سبحة من صاحب","https://www.aldiwan.net/poem35259.html","الكامل"],[438,"أصبحت من صرف الزمان الجاري","https://www.aldiwan.net/poem12527.html","الكامل"],[469,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[484,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[520,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[563,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[563,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"],[563,"خلوة القبر أشرف الخلوات","https://www.aldiwan.net/poem34708.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122676","الكامل"],[980,"","https://poetry.dctabudhabi.ae/diwan/poem/216968","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216692",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136272","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123090","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71055","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60891","المتدارك"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70319","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100514","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205025",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200128","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118798","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74251","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79707","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101652","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112318","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62825","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76450","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125905","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93740","الرمل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198541","الخفيف"],[4691,"هذهِ الدنيا ( ضحك الشاعر )","https://www.poetsgate.com/ViewPoem.aspx?id=92558",""],[4755,"سَيَمُوتُ خَبَّازٌ لِيُولَدَ مِن","https://www.poetsgate.com/ViewPoem.aspx?id=184718",""],[4755,"لِجَبِينِهِ رَفَعَتْهُ مِن قَدَمِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=184815",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[5232,"رقصةٌ بابليَّة","https://www.poetsgate.com/ViewPoem.aspx?id=216017",""],[5327,"رابعةُ الصُّمود","https://www.poetsgate.com/ViewPoem.aspx?id=147699",""],[5411,"روحي تُحبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=185917",""],[5413,"هي سنة العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=200545",""],[3338,"أنا شاكر أنا ذاكر أنا ناشر","https://www.poetsgate.com/ViewPoem.aspx?id=93919",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5455,"آخر الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=213953",""],[5510,"جرح المسافات","https://www.poetsgate.com/ViewPoem.aspx?id=206066",""],[5612,"هِيَ سِكَّةٌ للشَّوْق","https://www.poetsgate.com/ViewPoem.aspx?id=186956",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5722,"حنين مغترب","https://www.poetsgate.com/ViewPoem.aspx?id=12689",""],[5753,"في انتظار الآخرة","https://www.poetsgate.com/ViewPoem.aspx?id=207646",""],[5939,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=185513",""],[5956,"القِيَمُ المقلوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184102",""],[5956,"هي سامِيا العظمى محمدُ سالكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215550",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6320,"أَجْرَاسُ السَّفَر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84361&r=&rc=58",""]],"verses":[["هِيَ سُلوَةٌ ذَهَبَت بِكُلِّ غَرامِ","وَالحُبُّ نَهبُ تَطاوُلِ الأَيّامِ",0,"م",1,1],["هِيَ سُنَّةُ المُحتَلِّ في","كُلِّ العُصورِ وَما تَعَدّى",1,"د",2,0],["هِيَ سَاعَةٌ كَشَفَ الرَّجَاءُ ظَلامَهَا","عَنْ مُقْلَتِي بِالطَّالِعِ المُسْتَامِ",2,"م",1,0],["هي سنَّةٌ أَحْيَيْتَها وفريضةٌ","أَدَّيتَها قُرُبَاتُها تُتَقَبَّلُ",3,"ل",1,0],["هي سوداءُ غيرَ أنَّ عليها","ظُلمةً تَدْلهمُّ منها القلوبُ",4,"ب",1,1],["هِيَ سَرجُهُ المَشدودُ وَه","وَ عَلى أَعِنَّتِها أَمير",5,"ر",1,0],["هي سُنَّةُ الدنيا فَكَمْ مِنْ فاضلٍ","في الخاملين وكم تُرفِّع مِنْ غبي",6,"ب",2,0],["هِيَ سَبعَةٌ مِثلُ القَداحِ فَوائِزٌ","مُتَساوِياتٌ في غِناً وَيَسارِ",7,"ر",1,0],["هيَ سيل من الهيولى طفت في","ه نجوم كَثيرة كالغثاء",8,"ا",2,0],["هيَ سَكرى تجرّدتْ","من ثيابٍ ومن عِصَمْ",9,"م",1,0],["هِيَ سَاعَةٌ تَمْضِي وَتَأْتِي سَاعَةٌ","وَالدَّهْرُ ذُو غِيَرٍ بِهَذَا النَّاسِ",10,"س",1,0],["هي سؤدد العربي يوم فخاره","وقوامُ نهضته وسرُّ كيانه",11,"ن",2,0],["هي سيناء فؤادي","وجد اليوم هداها",12,"ا",3,0],["هي سنة الحب الذي زاولته","زمناً وزاوله معي أصحابي",13,"ب",2,0],["هي سنّة الدنيا وليس بممكنٍ","تبديلها أبداً ومثلكَ يعلمُ",14,"م",1,0],["هي ساعة راش القضاءُ سهامهُ","فيها وحلّ بنا البلاء وحاقا",15,"ق",2,0],["هِيَ سَبعَةٌ تَأتيكَ سَبعَ مائىٍ","تُنسِيكَها وَالحَصدُ لِلبَذرِ",16,"ر",1,0],["هي ساعة فإذا تسلمها مضى","وأخذت عنه من الرجوع أمانا",17,"ن",2,0],["هِيَ سِرٌّ بِعِلمِهِ اِستَأثَرَ اللَ","هُ وَحارَت في شَأنِها العُقَلاءُ",18,"ا",2,0],["هي سبحةٌ سوداءُ يسرٌ حبّها","فاليسرُ مأمولٌ بفألِ اللاعب",19,"ب",1,0],["هي سنّةٌ وأنا الضّمينُ لنصفها","فكن الضّمينَ لنصفِها بعِيارِ",20,"ر",1,0],["هي سكرة لا ينقضي","حتى المماتِ خمارها",21,"ر",3,0],["هي سلمى كما علمت أمامي","وأنا النامي في هواها غرامي",22,"ي",1,0],["هي سلمى ولا أزيدك علما","يوم كنا ولا تسل كيف كنا",22,"ن",2,0],["هي سلوة حلت عقود وفائها","مذ شف ثوب الصبر عن برحائها",23,"ا",3,1],["هي سلمى وكلهم طالبوها","وإليها كل القلوب تميل",24,"ل",1,0],["هي سورة في الذكر تتلى دائماً","هي صورة من نفحها في صورها",25,"ر",3,0],["هي سعد لكل عبد سعيد","يترقى بها علا الدرجات",26,"ت",1,0],["هيَ سُنَّة عُذريَّةٌ تَلَفي بِها","فَرضٌ وايَّةُ عاشِقٍ لا تُتلِفُ",27,"ف",1,0],["هي ستة فكن الضمين لنصفها","أكن الضمين لنصفها بعيار",28,"ر",1,0],["هي سب عِلّات مضناها","والمصايب والتنَهّيدِ",29,"د",1,0],["هي سر حكاه نور ومعنى","فيه سر الجمال ضمن الجلال",30,"ل",1,0],["هي سر الهوى فإن تلق نفساً","لسواها يشفها باحتواها",31,"ا",3,0],["هِيَ سَبعَةٌ زُهرٌ خُصِصتَ بِها","وَكَذا الطَوالِعُ سَبعَةٌ زُهرُ",32,"ر",1,0],["هي ساعةف يت دانيها الحياة كما","في بعدها الموت قد أضحت ترائيه",33,"ي",2,0],["هي سِجْنٌ في اعتقادي ومتى","لم أَرِمْ عنها فضاءً وسَعَهْ",34,"ع",2,0],["هْيسٌ مُيسٌ لُعسٌ نُعْسٌ","شُمُسٌ لا يَلِينُ لمهتضم",35,"م",1,0],["هي سَبعةٌ مثلُ القياسِ الأصلي","وَضِفدَع في غير هذا الفَصلِ",36,"ل",1,0],["هِي سَبعُ مَايَه بَيت يَزيدُ عَنهَا","عَن أَحمَدِ السَّعدِيِ إحفَظَنهَا",37,"ه",2,0],["هيَ سنَّةٌ مألوفةٌ","فيمن تَقَدَّمَ أَو غَبَر",38,"ر",1,0],["هي سامراء قد فاح شذاها","وترآى نور أعلام هداها",39,"ا",3,1],["هي سينماء قد مللنا","عرضها منذ الأزل",40,"ل",1,0],["هي سجنٌ وان تعالت فسجني","قفص لي معلق في الهواء",41,"ا",2,0],["هي سلوتي هي محنتي هي منحتي","هي قبلتي هي أوَّلي هي آخري",42,"ر",2,0],["هيَ سنة العُشاق شاعَ بِأَنَّها","أَحكامها مَعكوسة الاحكام",43,"م",1,0],["هي سهم من الزمان رماه","ليس للوصل دونه من واق",44,"ق",1,0],["هي سرٌّ فضَّلَ الثغرَ على","أذُلانِ غيرَ الحسِّ ليست تستحبُّ",45,"ب",1,0],["هيَ سوريا التي لَو قُدّرَت","قِيَمُ الدّنيَا غَدَت كلّ القيَم",46,"م",1,0],["هيَ ساعَة زلزالها","في القَلب أَنسانا مسينا",47,"ن",2,0],["هيَ ساعَة البين الَّتي","لَم تدن إلّا كَي نَبينا",47,"ن",2,0],["هيَ ساعة إِمّا ردى فَيريحها","عَن قصدها أَو نيل أَقصى المقصدِ",48,"د",1,0],["هي سُنّةٌ نُسخت بها سننُ الوَرى","جمعاً ودينٌ شاعَ في الأدْيانِ",49,"ن",1,0],["هيَ ساعَة مرت عَلى نفرين مج","نونين بين دعابة وَمجون",50,"ن",1,0],["هِيَ ساعاتٌ مَضَت لَكِنَنَّي","لَستُ أَدري كَيفَ تَمضي يا حَبيبي",51,"ب",2,1],["هِيَ ساعاتٌ تَوارَت بَعدَ ما","حَطَّمَت مني وَمِن قَلبي الكَئيبِ",51,"ب",1,0],["هِيَ ساعاتٌ تَراءَت بَينَها","صُورُ الماضي بِأَشتاتِ الضُروبِ",51,"ب",1,0],["هي سُنَّةٌ لك أجرُها وثوابُها","مشفوعةٌ بالشكر والإطراء",52,"ا",2,0],["هي سكر النديم دون الحميا","إذ يحيي النديم والجلاسا",53,"س",2,0],["هي سوق كثرت خيراتها","فتحت أبوابها للداخلين",54,"ن",1,0],["هيَ سر لم يكيفه البَشر","غامض أَعيا عَن الكشف النَّظر",55,"ر",1,1],["هي سؤلي من الملاح كما أن","ك من سادة الأخلاء سولي",56,"ل",2,0],["هي سطرٌ محبّرٌ بدمانا","بحروفٍ تغتالُ منَّا السّرورا",57,"ر",2,0],["هِيَ سُنَّةُ الدُّنيَا فَلَا تَثِقُوا","لَن يَغْلِبَ السَّاحَاتِ تِلْفَازُ",58,"ز",1,0],["هِيَ سِيرَةٌ لِلضَّوءِ لاذَ بِهَا","فِي بَدئِهِ الزَّاهِي ومُختَتَمِهْ",59,"م",2,0],["هِيَ سِرُّهُ الأبْهَى, وإنْ جُهِلَتْ","سَيَقُولُهَا يَومَاً بِمِلءِ فَمِهْ",59,"م",2,0],["هي سلع والبتراء ترجمة اسمها","نسجت عليه عناكب الإهمال",60,"ل",1,0],["هيَ سحرٌ بَابليّ ٌ","توجَّتْهُ بالأناقه",61,"ق",2,0],["هِىَ ساحةُ المَجدِ المُخَلَّدِ ذِكرُهُ","وذُكاؤها بِدَمِ الشَّهادَةِ ساطِعَة",62,"ع",2,0],["هِيَ سَكْرَةٌ وَبِها جَنَحْتُ بِغَيْبَتي","وَفَمي بأوْرادِ التَّعَشّقِ صادِحُ",63,"ح",1,0],["هيَ سنةُ العشاق مذْ نزل الهوى","\"وعليُّ بَا\" للعاشقين سماءُ",64,"ا",2,0],["هي ستة وأنا الضمين لنصفها","فكن الضمين لنصفها بعيار",65,"ر",1,0],["هي سفرة العمر انتهت","ودنى إلى الأخرى فقولي",66,"ل",2,0],["هي سلمتني للزمن والصواديف","وانا اتذّكرها .. ولا اذكر خطاها",67,"ا",3,0],["هي سُنّةُ الأحباب في شرعِ الهوى","يتفرَّقون وما بهم يتفجّرُ",68,"ر",1,0],["هِيَ سِكَّةٌ للشَّوْقِ كُنْتُ اخْتَرْتُها","طَوْعاً وقدْ كُنْتُ الصَّغيرَ الغِرَّا",69,"ر",2,0],["هي سيرة قُرشِية علوية","مشكاةُ نورٍ - زيتُها قدْ أوقدا",70,"د",2,0],["هيَ سلوايَ إنْ أظلّني الهمُّ","وسادَتْ بيَ الخُطوبُ الثِقال",71,"ل",1,0],["هي سقطةٌ أخرى تقرُّ فناءنا","صمتًا نصفقُ للأيادي الغادرة",72,"ر",2,0],["هي سُنّةُ الدنيا: غُرورٌ زائلٌ","إن كنتَ فيها قد أردتَ مَتاعا",73,"ع",2,0],["هي سُبَّة هي طعنة ونقيصة","تبقى بقولك أو بفعلك صادقا",74,"ق",2,0],["هي ساميا العظمى محمدُ سالكٍ","سلكت طريق الصدق لا التلفيقِ",75,"ق",1,0],["هي سَهْلُنَا وَتَرَاهُ مِنْ","أَحْدَ