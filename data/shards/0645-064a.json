{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"إيها فكم تهصر أغصان الضال","https://www.aldiwan.net/poem46152.html","الرجز"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[86,"مى يا بابلي إليك شوقي","https://www.aldiwan.net/poem68841.html","الوافر"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[93,"راعنا خطبهم وكان جسيماً","https://www.aldiwan.net/poem11370.html","الخفيف"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[30,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[47,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[23,"ألا أبلغ بني الديان عني","https://www.aldiwan.net/poem21455.html","الوافر"],[23,"ميكال معك وجبرئيل كلاهما","https://www.aldiwan.net/poem21582.html","الكامل"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"على اليمن والأقدام مقدم ما نأوا","https://www.aldiwan.net/poem18252.html","الطويل"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"انظر إلى بنتك يا خالد","https://www.aldiwan.net/poem61878.html","السريع"],[51,"ساءلت يوما خالدا","https://www.aldiwan.net/poem65011.html","مجزوء الكامل"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[62,"ميقات موسى يوم تدبيرنا","https://www.aldiwan.net/poem52172.html","السريع"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[45,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[61,"ميت مات في محل قراره","https://www.aldiwan.net/poem51363.html","الخفيف"],[61,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[61,"أيها المطلون بعدي حذار","https://www.aldiwan.net/poem51623.html","الخفيف"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[49,"في عداد الموتى وفي ساكني الدن","https://www.aldiwan.net/poem64299.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[97,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[97,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[31,"فيم الوقوف بمنزل خلق","https://www.aldiwan.net/poem42476.html","الكامل"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[74,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[74,"فيا لشجا قلب من الصبر فارغ","https://www.aldiwan.net/poem13267.html","الطويل"],[105,"برق بأنباء الأحبة سار","https://www.aldiwan.net/poem42118.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"اسم سما لفظه وازدان معناه","https://www.aldiwan.net/poem44048.html","البسيط"],[102,"شوقي يقول وما درى بمصيبتي","https://www.aldiwan.net/poem33012.html","الكامل"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[17,"اسلم سلمت ولا سليم على البلى","https://www.aldiwan.net/poem1194.html",""],[52,"يا قلب قد جد بين الحي فانطلقوا","https://www.aldiwan.net/poem26817.html","البسيط"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"بزاتنا الأقداح","https://www.aldiwan.net/poem62536.html","المجتث"],[48,"لم ينسني السعي والطواف ولا","https://www.aldiwan.net/poem65007.html","المنسرح"],[48,"لم أزل أخلع في الحب الرسن","https://www.aldiwan.net/poem66112.html","البسيط"],[50,"يا قلب ما لي أراك لا تقر","https://www.aldiwan.net/poem63821.html","المنسرح"],[50,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[46,"جاء القران وأم الله أرسله","https://www.aldiwan.net/poem23037.html","البسيط"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140819",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42666","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141950","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43653","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9550","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[31,"فِيمَ الوُقُوفُ بِمَنْزِلٍ خَلَقٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18922&r=&rc=185",""],[42,"حَسَدوا الفَتى إِذ لَم يَنالوا سَعيهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84104&r=&rc=134",""]],"verses":[["مَيتٌ يَهونُ عَلى الفَوارِسِ فَقدُهُ","مَن لا يُرِقُّ عَوالِيَ المُرّانِ",0,"ن",1,0],["ميلوا إِلى السِلمَ إِنَّ السِلمَ واسِعَةٌ","وَاِستَوضِحوا الحَقَّ إِنَّ الحَقَّ عُريانُ",1,"ن",1,0],["مَيِّتٌ تَبكي لَهُ فاطِمَةٌ","وَأَبوها وَعَليٌّ ذو العُلى",2,"ا",1,0],["مِيلِ الهَوادي ناحِلاتِ الأوْصالْ","كأنّها مَزمومَةٌ بالأصْلالْ",3,"ل",1,0],["مَيثاءَ دارٌ عَفا رَسمُها","فَما إِن تَبَيَّنُ أَسطارَها",4,"ر",3,1],["مى يا بابِلِيُّ إِلَيكَ شَوقي","وَعَيني لازَمَت سَكبَ الدُموعِ",5,"ع",1,1],["مِئونَ مِنَ الأَيّامِ خَمسٌ قَطَعتُها","أَسيراً وَإِن لَم يَبدُ شَدٌّ وَلا قَمطُ",6,"ط",1,0],["مِئَتَيْ هَالِكٍ أَصَبْتَ رِجَالاً","وَنِسَاءً أَصَبْتَ غُنْماً عَظِيمَا",7,"م",2,0],["ميلُ الذُرى مَطوِيَّةُ الآطالِ","إِلى الصُدورِ وَإِلى المَحالِ",8,"ل",1,0],["مَيَاً وَشاقَتكَ الرُسومُ الدُثَّرُ","آريُّها وَالمُنتَأَى المُدَعثَرُ",9,"ر",1,0],["مَيلاءَ مِن مَعدِنِ الصيرانِ قاصِيَةٍ","أَبعارُهُنَّ عَلى أَهدافِها كُثَبُ",10,"ب",1,0],["ميتة الأبطال فيها شمم","طأطأت من دونه الشمّ الجبال",11,"ل",1,0],["مَيامينَ خَطّارونَ يَحمونَ نِسوَةً","مَناجيبُ تَغلو في قُرَيشٍ مُهورُها",12,"ر",3,0],["مَيَّزتُ بَينَهُما فَلَم يَتَفاضَلا","كَالفَرقَدَينِ تَشاكَلَت حالاهُما",13,"م",2,0],["مَيامِسُ غَزَّةٍ وَرِماحُ غابٍ","خِفافٌ لا تَقومُ بِها اليَدانِ",14,"ن",1,0],["ميكالُ مَعكَ وَجِبرَئيلُ كِلاهُما","مَدَدٌ لِنَصرِكَ مِن عَزيزٍ قادِرِ",15,"ر",1,1],["ميتٌ من الحبِّ إلا أنني بسرى","ذكرِ الصبابةِ حيٌّ بين أحياء",16,"ا",2,0],["ميامين حفوا الجانبين من العلا","وتاجاً علا فوقَ الرؤوس جنابا",17,"ب",2,0],["ميم فمٍ يسكرني ذكره","فيا لها سكرة خرطوم",18,"م",1,0],["مياهٌ مَهينات يؤولُ مآلُها","إلى رِمَمٍ من أعظُمٍ نخراتِ",19,"ت",1,0],["مِيلا عن الورْدِ إلى سَيِّدٍ","من سادة الرّيْحانِ ممدوحِ",20,"ح",1,0],["ميلادك المدخولُ ميلادها","وهْوَ كما تعلمه فاسدُ",21,"د",1,0],["ميِّز بعقلك أيَّنا ال","مخنوق في بيت الضَّريطِ",22,"ط",1,0],["ميامينُ يُضحي من تولَّوا أمورَهُ","مَليّاً بأن يُجبى له الحمدُ والمالُ",23,"ل",1,0],["ميلعَ الوخدِ تقذفُ المروَ بالمرْ","وِ وتَرمي اللُّغامَ بعد اللُّغام",24,"م",1,0],["ميَّاسةً كَعَرائِسِ الفِرْدَوْسِ","بَيْنَ حُقُولِهِ",25,"ه",1,0],["مَيتَ الجَلالِ مِنَ القَوافي زَفرَةٌ","تَجري وَمِنها عَبرَةٌ تَتَرَقرَقُ",26,"ق",1,0],["ميتَةٌ لَم تَلقَ مِنها عَلَزاً","مِن وَقارِ اللَيثِ أَن لا يُحتَضَر",27,"ر",1,0],["ميلي اِنظُريهِ في النَدِيِّ كَأَنَّهُ","عُثمانُ عَن أُمِّ الكِتابِ يُلاحي",28,"ح",2,0],["مَيتٌ تُحيطُ بِهِ الحَيا","ةُ زَمانُهُ مَعَهُ دَفين",29,"ن",1,0],["ميلادُ إِحسانٍ وَهِجرَةُ سُؤدَدٍ","قَد غَيَّرا وَجهَ البَسيطَةِ حالا",30,"ل",2,0],["ميعادُ كُلِّ رَقيقِ الشَفرَتَينِ غَداً","وَمَن عَصى مِن مُلوكِ العُربِ وَالعَجَمِ",31,"م",1,0],["ميقات موسى يوم تدبيرنا","فافطن فإنّ الفطنة الحدسُ",32,"س",1,1],["ميّزهما ثم خذ كلاً على حدة","بلا قذاة ولا شوب ولا كدر",33,"ر",1,0],["مِئونَ عَيناً تَوَلَّيتَ الثَوابَ بِها","حَتّى اِنثَنَت لِأَبي العَبّاسِ آلافا",34,"ف",2,0],["ميلَ الحَواجِبِ وَالنُجومُ كَأَنَّها","خَلَلَ الحَنادِسِ شُعلَةٌ في أَدهَمِ",35,"م",1,0],["ميلوا إِلى الدارِ مِن لَيلى نُحَيِّيها","نَعَم وَنَسأَلُها عَن بَعضِ أَهليها",36,"ي",3,1],["ميت مات في محل قراره","لم يغب عن محله وجواره",37,"ر",2,1],["مَيثاءُ طَيِّبةُ الأنفاسِ ضاحكةٌ","تكادُ تهتزُّ عُجْباً من نَواحِيها",38,"ي",3,0],["مِئزَرٌ كَانَ غايةَ النَّفعِ أضحَى","وهُوَ اليومَ غايةُ الأضرارِ",39,"ر",1,0],["مَيادينُ رَيحانٍ كأنَّ نسيمَه","نَسيمُ الهَوى أيامَ وَصْلِ الحَبائبِ",40,"ب",1,0],["مَيِّتٌ ماتَ وَهوَ في وارِفِ العَي","شِ مُقيماً في ظِلِّ عَيشٍ ظَليلِ",41,"ل",1,0],["ميّزتها بشبابها الغضِّ","وبقدِّها أُفديه من قد",42,"د",1,0],["ميكي وما ميكي ومص","رعُه على الدنيا جديد",43,"د",1,0],["ميثاقنا أسطرٌ من مدمعٍ ودمٍ","يا طاهر النفحة اذكر طاهر القَسم",44,"م",1,0],["مَيمونَةٌ وُلِدَت عَلى يُمنٍ","بِالطائِرِ المَيمونِ لا النَحسِ",45,"س",1,0],["مَيمَونَةٍ لَو لَمَسَت جَلمَداً","صَلداً لَسالَ الماءُ عَنهُ فَساح",46,"ح",1,0],["مَيّاسُ أَعطافِ السَماحِ كَأَنَّهُ","غُصنٌ تَنَفَّسَ نَورُهُ مَطلولُ",47,"ل",1,0],["مَيادينُ أَوطاري وَلَذَّةُ لَذَّتي","وَمَنشَأُ تَهيامي وَمَلعَبُ غُزلاني",48,"ن",2,0],["مَيْتٌ على ميتٍ ينوحُ وذاهبٌ","يبكي لِمظْعنِ ذاهبٍ سيّارِ",49,"ر",1,0],["مِيثاقُكم مَجدٌ لِمصرَ وسُؤددٌ","وسبيلكم فيها هُدىً ورشادُ",50,"د",1,0],["ميثاقُنا نَسْجُ الحياةِ لأمّةٍ","تَبغِي الحياةَ كريمةَ الأنوالِ",51,"ل",1,0],["مَيمونةٌ أنتِ هذا ما تَخيَّرهُ","لَكِ الذي اختاره مِن خَلقِهِ اللَّهُ",52,"ه",1,0],["مئة على مئة إذا هي صلِّحت","وجد العمى نحو العيون سبيلا",53,"ل",2,0],["مَيتَ دَهرٍ قَد كُنتُ ثُمَّ حَيِيتُ","وَحَياتي رَهنٌ بِأَن سَأَموتُ",54,"ت",1,0],["مَيتاً خُلِقتُ وَلَم أَكُن مِن قَبلِها","شَيئاً يَموتُ فَمُتُّ حَيثُ حَيِيتُ",55,"ت",1,0],["مَيتُ السَرائِرِ ضَحّاكٌ عَلى حَنَقٍ","ما دامَ يَعجَزُ عَن أَعدائِيَ الحَنَقُ",56,"ق",1,0],["مِيزانُهُ في التُّقَى مِيزَانُ مَعْدَلَةٍ","وَحِكْمَةٍ لا صَغىً فيها وَلا صِغرُ",57,"ر",1,0],["مَيدانُها الحَشايا","وَرَكضُها النِكاحُ",58,"ح",1,0],["مَيسانُ مِن حَيثُ ما عَطَفتَ لَهُ","حَيّاكَ وَجهٌ بِحُسنِهِ المَثَلُ",59,"ل",1,0],["ميمُهُ شَفَّ فُؤادي في الهَوى","وَبِحاءٍ فيهِ قَلبي قَد فُتِن",60,"ن",1,0],["ميراثُ مَن بورِ