oem36867.html","البسيط"],[477,"أهوى الملاح لأني","https://www.aldiwan.net/poem36871.html","المجتث"],[477,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[477,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[498,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[498,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[503,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[503,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[511,"ألا تكن في الهوى أرويت من ظماء","https://www.aldiwan.net/poem67749.html","البسيط"],[512,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[527,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[536,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[551,"مياس قل لي أين أنت من الورى","https://www.aldiwan.net/poem68270.html","الكامل"],[556,"محمد الإسم حمد الرسم معلوم","https://www.aldiwan.net/poem33887.html","البسيط"],[556,"أيها الناي عندك الخبر","https://www.aldiwan.net/poem34554.html","الخفيف"],[556,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["مَيتٌ يَهونُ عَلى الفَوارِسِ فَقدُهُ","مَن لا يُرِقُّ عَوالِيَ المُرّانِ",0,"ن",1,0],["ميلوا إِلى السِلمَ إِنَّ السِلمَ واسِعَةٌ","وَاِستَوضِحوا الحَقَّ إِنَّ الحَقَّ عُريانُ",1,"ن",1,0],["مَيِّتٌ تَبكي لَهُ فاطِمَةٌ","وَأَبوها وَعَليٌّ ذو العُلى",2,"ا",1,0],["مِيلِ الهَوادي ناحِلاتِ الأوْصالْ","كأنّها مَزمومَةٌ بالأصْلالْ",3,"ل",1,0],["مَيثاءَ دارٌ عَفا رَسمُها","فَما إِن تَبَيَّنُ أَسطارَها",4,"ر",3,1],["مى يا بابِلِيُّ إِلَيكَ شَوقي","وَعَيني لازَمَت سَكبَ الدُموعِ",5,"ع",1,1],["مِئونَ مِنَ الأَيّامِ خَمسٌ قَطَعتُها","أَسيراً وَإِن لَم يَبدُ شَدٌّ وَلا قَمطُ",6,"ط",1,0],["مِئَتَيْ هَالِكٍ أَصَبْتَ رِجَالاً","وَنِسَاءً أَصَبْتَ غُنْماً عَظِيمَا",7,"م",2,0],["ميلُ الذُرى مَطوِيَّةُ الآطالِ","إِلى الصُدورِ وَإِلى المَحالِ",8,"ل",1,0],["مَيَاً وَشاقَتكَ الرُسومُ الدُثَّرُ","آريُّها وَالمُنتَأَى المُدَعثَرُ",9,"ر",1,0],["مَيلاءَ مِن مَعدِنِ الصيرانِ قاصِيَةٍ","أَبعارُهُنَّ عَلى أَهدافِها كُثَبُ",10,"ب",1,0],["ميتة الأبطال فيها شمم","طأطأت من دونه الشمّ الجبال",11,"ل",1,0],["مَيامينَ خَطّارونَ يَحمونَ نِسوَةً","مَناجيبُ تَغلو في قُرَيشٍ مُهورُها",12,"ر",3,0],["مَيَّزتُ بَينَهُما فَلَم يَتَفاضَلا","كَالفَرقَدَينِ تَشاكَلَت حالاهُما",13,"م",2,0],["مَيامِسُ غَزَّةٍ وَرِماحُ غابٍ","خِفافٌ لا تَقومُ بِها اليَدانِ",14,"ن",1,0],["ميكالُ مَعكَ وَجِبرَئيلُ كِلاهُما","مَدَدٌ لِنَصرِكَ مِن عَزيزٍ قادِرِ",15,"ر",1,1],["ميتٌ من الحبِّ إلا أنني بسرى","ذكرِ الصبابةِ حيٌّ بين أحياء",16,"ا",2,0],["ميامين حفوا الجانبين من العلا","وتاجاً علا فوقَ الرؤوس جنابا",17,"ب",2,0],["ميم فمٍ يسكرني ذكره","فيا لها سكرة خرطوم",18,"م",1,0],["مياهٌ مَهينات يؤولُ مآلُها","إلى رِمَمٍ من أعظُمٍ نخراتِ",19,"ت",1,0],["مِيلا عن الورْدِ إلى سَيِّدٍ","من سادة الرّيْحانِ ممدوحِ",20,"ح",1,0],["ميلادك المدخولُ ميلادها","وهْوَ كما تعلمه فاسدُ",21,"د",1,0],["ميِّز بعقلك أيَّنا ال","مخنوق في بيت الضَّريطِ",22,"ط",1,0],["ميامينُ يُضحي من تولَّوا أمورَهُ","مَليّاً بأن يُجبى له الحمدُ والمالُ",23,"ل",1,0],["ميلعَ الوخدِ تقذفُ المروَ بالمرْ","وِ وتَرمي اللُّغامَ بعد اللُّغام",24,"م",1,0],["ميَّاسةً كَعَرائِسِ الفِرْدَوْسِ","بَيْنَ حُقُولِهِ",25,"ه",1,0],["مَيتَ الجَلالِ مِنَ القَوافي زَفرَةٌ","تَجري وَمِنها عَبرَةٌ تَتَرَقرَقُ",26,"ق",1,0],["ميتَةٌ لَم تَلقَ مِنها عَلَزاً","مِن وَقارِ اللَيثِ أَن لا يُحتَضَر",27,"ر",1,0],["ميلي اِنظُريهِ في النَدِيِّ كَأَنَّهُ","عُثمانُ عَن أُمِّ الكِتابِ يُلاحي",28,"ح",2,0],["مَيتٌ تُحيطُ بِهِ الحَيا","ةُ زَمانُهُ مَعَهُ دَفين",29,"ن",1,0],["ميلادُ إِحسانٍ وَهِجرَةُ سُؤدَدٍ","قَد غَيَّرا وَجهَ البَسيطَةِ حالا",30,"ل",2,0],["ميعادُ كُلِّ رَقيقِ الشَفرَتَينِ غَداً","وَمَن عَصى مِن مُلوكِ العُربِ وَالعَجَمِ",31,"م",1,0],["ميقات موسى يوم تدبيرنا","فافطن فإنّ الفطنة الحدسُ",32,"س",1,1],["ميّزهما ثم خذ كلاً على حدة","بلا قذاة ولا شوب ولا كدر",33,"ر",1,0],["مِئونَ عَيناً تَوَلَّيتَ الثَوابَ بِها","حَتّى اِنثَنَت لِأَبي العَبّاسِ آلافا",34,"ف",2,0],["ميلَ الحَواجِبِ وَالنُجومُ كَأَنَّها","خَلَلَ الحَنادِسِ شُعلَةٌ في أَدهَمِ",35,"م",1,0],["ميلوا إِلى الدارِ مِن لَيلى نُحَيِّيها","نَعَم وَنَسأَلُها عَن بَعضِ أَهليها",36,"ي",3,1],["ميت مات في محل قراره","لم يغب عن محله وجواره",37,"ر",2,1],["مَيثاءُ طَيِّبةُ الأنفاسِ ضاحكةٌ","تكادُ تهتزُّ عُجْباً من نَواحِيها",38,"ي",3,0],["مِئزَرٌ كَانَ غايةَ النَّفعِ أضحَى","وهُوَ اليومَ غايةُ الأضرارِ",39,"ر",1,0],["مَيادينُ رَيحانٍ كأنَّ نسيمَه","نَسيمُ الهَوى أيامَ وَصْلِ الحَبائبِ",40,"ب",1,0],["مَيِّتٌ ماتَ وَهوَ في وارِفِ العَي","شِ مُقيماً في ظِلِّ عَيشٍ ظَليلِ",41,"ل",1,0],["ميّزتها بشبابها الغضِّ","وبقدِّها أُفديه من قد",42,"د",1,0],["ميكي وما ميكي ومص","رعُه على الدنيا جديد",43,"د",1,0],["ميثاقنا أسطرٌ من مدمعٍ ودمٍ","يا طاهر النفحة اذكر طاهر القَسم",44,"م",1,0],["مَيمونَةٌ وُلِدَت عَلى يُمنٍ","بِالطائِرِ المَيمونِ لا النَحسِ",45,"س",1,0],["مَيمَونَةٍ لَو لَمَسَت جَلمَداً","صَلداً لَسالَ الماءُ عَنهُ فَساح",46,"ح",1,0],["مَيّاسُ أَعطافِ السَماحِ كَأَنَّهُ","غُصنٌ تَنَفَّسَ نَورُهُ مَطلولُ",47,"ل",1,0],["مَيادينُ أَوطاري وَلَذَّةُ لَذَّتي","وَمَنشَأُ تَهيامي وَمَلعَبُ غُزلاني",48,"ن",2,0],["مَيْتٌ على ميتٍ ينوحُ وذاهبٌ","يبكي لِمظْعنِ ذاهبٍ سيّارِ",49,"ر",1,0],["مِيثاقُكم مَجدٌ لِمصرَ وسُؤددٌ","وسبيلكم فيها هُدىً ورشادُ",50,"د",1,0],["ميثاقُنا نَسْجُ الحياةِ لأمّةٍ","تَبغِي الحياةَ كريمةَ الأنوالِ",51,"ل",1,0],["مَيمونةٌ أنتِ هذا ما تَخيَّرهُ","لَكِ الذي اختاره مِن خَلقِهِ اللَّهُ",52,"ه",1,0],["مئة على مئة إذا هي صلِّحت","وجد العمى نحو العيون سبيلا",53,"ل",2,0],["مَيتَ دَهرٍ قَد كُنتُ ثُمَّ حَيِيتُ","وَحَياتي رَهنٌ بِأَن سَأَموتُ",54,"ت",1,0],["مَيتاً خُلِقتُ وَلَم أَكُن مِن قَبلِها","شَيئاً يَموتُ فَمُتُّ حَيثُ حَيِيتُ",55,"ت",1,0],["م