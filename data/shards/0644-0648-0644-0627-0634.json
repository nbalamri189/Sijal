{"poems":[[57,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[95,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117019","البسيط"],[236,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[302,"أدر المدامة بالكبير","https://www.aldiwan.net/poem33264.html","مجزوء الكامل"],[308,"لولا شفاعة شعرها في صبها","https://www.aldiwan.net/poem57866.html","الكامل"],[343,"يا من ترفع للدنيا وزينتها","https://www.aldiwan.net/poem68606.html","البسيط"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[415,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[469,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[520,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[520,"تيقنوا أن قلبي منهم يجب","https://www.aldiwan.net/poem12032.html","البسيط"],[556,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70739","البسيط"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17628","المنسرح"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25434","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6761","البسيط"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96246","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27801","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58404","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3652,"","https://poetry.dctabudhabi.ae/diwan/poem/198850","الدوبيت"],[4750,"الأزمات","https://www.poetsgate.com/ViewPoem.aspx?id=180409",""],[4858,"إلى روح الشهيد سيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=29820",""],[5219,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=194937",""],[5302,"لما اغتالك الحلك","https://www.poetsgate.com/ViewPoem.aspx?id=201221",""],[5829,"يا ثغرها","https://www.poetsgate.com/ViewPoem.aspx?id=147423",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"لولا شعاعُك هل أنا مسعودُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193692",""],[5956,"حارس الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=206676",""],[6068,"حيرانُ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175951",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""]],"verses":[["لَولا شَقاوَةُ جَدّي ما عَرَفتُكُمُ","إِنَّ الشَقِيَّ الَّذي يَشقى بِمَن عَرَفا",0,"ف",2,0],["لَولا شُفُوفُ حِجَابِهَا عَنْ شَاحِبٍ","مِنَ ضَوْئِهَا لَمْ يَبْدُ لِلمُسْتَامِ",1,"م",1,0],["لولا شجاعتهُ لهاب طريقةً","خشناء مقفرةً من الأُنَّاس",2,"س",1,0],["لولا شَفاعتُها وأنتَ رَهينُها","ما طابَ مُضْطجَعٌ وخَفَّ سُؤالُ",3,"ل",1,0],["لولا شماتةُ أعداءِ ذوي حسَدٍ","أو اغتمامُ صديقٍ كان يرجوني",4,"ي",1,1],["لولا شذاً من نشركم ينشق","ما حنّ نحو المُهتم المُعرق",5,"ق",1,1],["لَولا شِباكُ حَبابها","كادَت تَطيرُ من السُرورِ",6,"ر",1,0],["لولا شفاعة شعرها في صبها","ما خففت بالوصل منه سقاما",7,"م",2,1],["لَولا شَماتَةُ أَعداءٍ ذَوي حَسَدٍ","وَإِن أَتاكَ بِنَقص مَن يُرَجّيني",8,"ن",2,0],["لولا شِعارٌ إماميٌّ رَعاهُ لمَا","كسَتْ سوادَ مِدادٍ كفّه الدُّررا",9,"ر",2,0],["لولا شَماتُ الأعادي عند ذكرِهِمُ","لغادَرَتْ أدمُعي في الأرض غُدرانا",10,"ن",2,0],["لولا شفيعاك اللَّمى والهوى","خاب مشيراك الصّبا والدلال",11,"ل",1,0],["لولا شفاعتك الحسنى لقصر بي","عن البلوغ إليها السعي والطلب",12,"ب",1,0],["لولا شفاعته الحسنى نائله الأسنى","لما أنجح المسعى ولا الطلب",13,"ب",1,0],["لولا شهادتُهمْ عليك لكنتَ في","ما بيننا حقّاً بغير دليلِ",14,"ل",1,0],["لولا شهادتك الشريفة لي بما","رفع القوافي لاتهمت مواهبي",15,"ب",2,0],["لولا شَبا الهُنْدُوانيَّاتِ ما جَنحَ الْ","كفارُ للسَّلم طوعاً بعد ما ثاروا",16,"ر",3,0],["لَولا شَقائي وَما بُليتُ بِهِ","مِن هَجرِها ما اِستَشرتُ ما اِكتتما",17,"م",2,0],["لَوْلا شَكِيمُ المِسْحَلَيْنِ انْدَقّا","إِذا العَجاجُ المُسْتَطارُ انْعَقَّا",18,"ق",2,0],["لَولَا شَجَا أَشْغَالِهِ لَمْ يَهْجُرِ","بابَكَ مِنْ راحٍ لَكُمْ مُسْتَبْشِرِ",19,"ر",1,0],["لولا شهور كالجدار توسَّطت","ما بيننا لربيتُ في حُجراتهِ",20,"ت",2,0],["لَولا شِتاءٌ وَلَفحُ قَيظٍ","وَخَوفُ لِصٍّ وَحِفظُ قَوت",21,"ت",1,0],["لولا شغيل عافني بالقر","ب حاول عن مزارك",22,"ك",1,1],["لولا شهودي ما عرفت وجودي","فامنن عليّ فأنتَ شهيدي",23,"د",2,1],["لولا شفاعةُ أحمدٍ خيرِ الورى","فينا لَقَطّعَ رَبُّنا أصالَها",24,"ل",3,0],["لَولا شباهُ ما اِتّقت","نوب الزَمان المتّقونا",25,"ن",2,0],["لولا شبك يصيدها في الأقداح","طارت فرحاً إلى محل الأرواح",26,"ح",1,0],["لولا شحّي فيك جيتك اجهار من النهار","غير ما يصلح مقامٍ بلا رايٍ بصير",27,"ر",1,0],["لولا شعاع النورِ منْ تاريخنَا","يزجيه صحبك في الجهادِ وقد هُدُوا",28,"د",3,0],["لولا شجون خبت ما صغتها دررا","هيهات تكتم أشواقا غدت عللا",29,"ل",2,0],["لو لا شباك هواي اليوم ما سلمت","منك الحنايا فلم تترك كمن تركوا",30,"ك",3,0],["لولا شفاهكِ ما رشفت الريقا","ولما جنيت من الورود رحيقا",31,"ق",2,1],["‏ لولا شعوبٌ بريئات تحنُّ على","طبيعةِ الشِّعرِ كان الجهلُ يقتلُهُ",32,"ل",2,0],["لولا شذا الأرواح تخلو روضةٌ","من عطرها وَيُدَمَّرُ التجديدُ",33,"د",1,0],["لولا شعاعُك هل أنا مسعودُ","يا خالداه؟ أمِ اغتذاني الدُّودُ؟",34,"د",1,1],["لولا شواغلُنا تلاقينا معا","فأنا أمرؤ أدركت كم هي طيبتُهْ",35,"ت",2,0],["لو لا شهدْتَ لِحاظها لعلمته","أبهى لحاظ في الورى المتكاثر",36,"ر",1,0],["لولا شعاع للمنى يرود","أرجاء عمر مجّه الوجود",37,"د",1,0]]}