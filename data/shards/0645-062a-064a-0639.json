{"poems":[[0,"تطاول ليلك بالأثمد","https://www.aldiwan.net/poem81.html","المتقارب"],[53,"متى عهدك بالكرخ","https://www.aldiwan.net/poem9989.html","الهزج"],[80,"شعرت فجئت بعين المحال","https://www.aldiwan.net/poem14186.html","المتقارب"],[45,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[47,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[47,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[48,"متى عدد الأقوام لبا وفطنة","https://www.aldiwan.net/poem22184.html","الطويل"],[48,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1943","المتقارب"],[47,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[47,"ما جَوُّ خَبْتٍ، وَإنْ نأتْ ظُعُنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31881",""],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[201,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[287,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[374,"قدمت فلم أترك لذي قدم حكما","https://www.aldiwan.net/poem4315.html","الطويل"],[382,"من مشرق العين أو من مغرب الدمع","https://www.aldiwan.net/poem59339.html","البسيط"],[469,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[556,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[569,"بكم وغرامي محنتي وتولعي","https://www.aldiwan.net/poem868.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122596","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122733","الطويل"],[720,"","https://poetry.dctabudhabi.ae/diwan/poem/76777","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63786","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62686","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107192","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143789","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53224","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87737","الطويل"],[3186,"","https://poetry.dctabudhabi.ae/diwan/poem/198687","المتقارب"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45777","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129402","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59498","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93253","المتقارب"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105166","البسيط"],[4750,"الفياض الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=180403",""],[4869,"غربتي ودراستي","https://www.poetsgate.com/ViewPoem.aspx?id=151634",""],[5246,"إذا لم يساعدني لإسعاف صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=187057",""],[5314,"خلجات","https://www.poetsgate.com/ViewPoem.aspx?id=214746",""],[5409,"نعيك هز أرجاء البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=155455",""],[5431,"حيدرة ...دعوة للمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=204619",""],[5525,"اغفر لي الزله","https://www.poetsgate.com/ViewPoem.aspx?id=34703",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5732,"غنيت ما قصدي طرب","https://www.poetsgate.com/ViewPoem.aspx?id=177854",""],[5739,"الحرف دلاّل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127067",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["مَتى عَهدُنا بِطِعانِ الكُم","ةِ وَالحَمدِ وَالمَجدِ وَالسُؤدُدِ",0,"د",1,0],["متى عهدُك بالكرْخِ","وبالشَّبُّوطِ والفَرْخِ",1,"خ",1,1],["مَتى عَزّ في حِمص غَيرُ العَزيز","أَو ذَلّ غَيرُ الذَميم الفَعالْ",2,"ل",1,0],["مَتى عاوَدَ الجالونَ عاوَدتَ أَرضُهُم","وَفيها رِقابٌ لِلسُيوفِ وَهامُ",3,"م",1,0],["مَتى عاوَدتِني فيها بِلَومٍ","فَبِتِّ ضَجيعَةً لِلمُستَعارِ",4,"ر",1,0],["مَتى عَدِمتَ الجَوى أَعارَكَهُ","مُعيدُ لَحظِ مَكروةٍ فِتَنُه",5,"ن",2,0],["مَتى عَدَّدَ الأَقوامُ لُبّاً وَفِطنَةً","فَلا تَسأَليني عَنهُما وَسَليبي",6,"ب",2,1],["مَتى عَرَضَ الحِجى لِلَّهِ ضاقَت","مَذاهِبُهُ عَلَيهِ وَإِن عَرُضنَه",7,"ن",2,0],["مَتى عَهدُنا بِطِعانِ الكُما","ةِ وَالحَمدِ وَالمَجدِ وَالسُؤدُدِ",8,"د",1,0],["مَتَى عَاوَدْتِني فِهيا بِلَوْمٍ،","فَبِتِّ ضَجِيعَةً للْمُسْتَعَارِ",9,"ر",1,0],["متى عَدِمتُ الجَوَى أُعَارِكُهْ،","مُعيدَ لحظٍ، مَكرورَةٍ فِتَنُهْ",10,"ن",2,0],["متى عدل الناهون عن سبل النهى","وما رأوا الدنيا وفخر سماتها",11,"ت",3,0],["متى على رملك الفضيّ تجمعنا","على المحبّة والإخلاص أفراح",12,"ح",1,0],["مَتى عايَنتهُ المُشرِكونَ تَقَطَّعَت","لِهَيبَتِهِ أَكبادُهُم وَالمَفاصِلُ",13,"ل",1,0],["متى عُدَّ أفراد المعالي فإنه","لأول من يُسمي وآخر من يُسما",14,"م",2,0],["متى عثرنا نَقُم واللَه يُنهضنا","ملاكُنا حافظٌ بالرد والردع",15,"ع",1,0],["متى عنَّ سرب العامرية غدوةً","فإياك يا بثَّ الفؤاد وإياها",16,"ا",3,0],["متى عجِموا كانوا الصّخورَ وإنْ هُمُ","دُعوا يومَ مكروهٍ أجابوا فأسرعوا",17,"ع",3,0],["متى عندي صرق ما ادعي به","حلالي خضوعي للهوى وتضرعي",18,"ع",2,0],["مَتَى عَلِقَت بِحبلِ علي كَفّي","فقَد عُوِّضتُ مِن نَحسٍ بِسَعدِ",19,"د",1,0],["مَتَى عَهدُكُم بِالهَضبِ هَضبِ حُلاحِل","وَما ظَنُّكُم بِالإسحِلِ المُتَمايِلِ",20,"ل",1,1],["مَتى عَهدُنا بِطعانِ الكَما","ةِ وَالمَجدِ وَالحَمدِ وَالسؤدُدِ",21,"د",1,0],["متى عُدَّ الكواكبُ من مَعَدٍّ","فأنكمُ شموسٌ لا بدور",22,"ر",1,0],["متى عودة تحيي الرسوم وتنعش","الجسوم وتشفي كل قلب معلل",23,"ل",1,0],["مَتَى عَنَّ لِي مِن ذِكرِ قَومِيَ سانِحُ","فَلا تَسأَلا ماذا تُلاقِي الجَوانِحُ",24,"ح",1,1],["مَتَى عَبرَت مِن جَانِبِ السّيفِ لَم تُبل","أَتَسبَحُ بَحراً أَم تَخُبُّ عَلى بَرِّ",25,"ر",1,0],["مَتى عَطِلَت رُباكِ مِنَ الخِيامِ","سُقيتِ مَعاهِداً صَوبَ الغَمامِ",26,"م",1,1],["متى علقت نفسي حبيبا تعلقت","به غيرُ الأيام تسلبنيه",27,"ي",2,0],["متى عقلي يُشاهِدُ نور طه","متى سترى يرى نور اجتلاكا",28,"ك",2,0],["متى عودتمُ الجرد المذاكي","تبيت على مرابطها صفونا",29,"ن",2,0],["مَتّى عَنك هَذا الغَرب يَرفَع نيره","فَتخلص مِن ظُلم الطَواغيت وَالقَهر",30,"ر",1,0],["متى عهِد الغيثُ يا غافلاً","كلَون العَقيق أبو العَنْدم",31,"م",1,0],["متَى عَقَدت الرَّأيَ أو رَايَةً","قَدَحَت زَندَ النَّجمِ عَينٌ سَحَاح",32,"ح",1,0],["مِتّى عَقَد الرايات رَوّى حُسامه","وَإِن حَلَّ أَرضاً غَصَها بِالعَساكر",33,"ر",1,0],["متى عد أهل الحزم فاذكر مواطنا","لداود ذي الأيدي ودع عنك تبعا",34,"ع",2,0],["متى عَهْدُنا بفكاكِ الأسيرِ","وجبر كسير الورى المُهْضَمِ",35,"م",1,0],["متى عبس الكرام تجده طلفا","وسل يوم الطراد عن الجواد",36,"د",1,0],["متى عُجتَ يا صاح بالسَّيِّدَهُ","فَسَلْ عن فؤاديَ في الأَفئِدهْ",37,"د",2,1],["متى عيوني ترى بالحي مجمعكم","وسرب آرامكم تبدو من الحجب",38,"ب",1,0],["متى عيني تشوف اللي على قلبي ربيع ودار","أشاهد للسعادة في حياة المجتمع صورة",39,"ر",2,0],["متى على الله يقضي الهم ... واقضي","من غربتي وادراستي والمعاناه",40,"ا",2,1],["متى عرفت لم تعرف الخيل دورها","وأضحت ذوات الخف مرجعها النحر",41,"ر",1,0],["متى عرفت طريقي كي تدمرني","متى استطعت وعرشي جد عملاق",42,"ق",1,0],["متى عطفت على الأزهار دارٌ","نبات حقولها شجر القتاد",43,"د",1,0],["متى عُميّت بصائرنا","بأدخنةٍ وأبخرة!!",44,"ر",2,0],["متى عمرك سمعت بعاشق قد مات من غلّه","هذاك الحاسد وراعي الهوى تتلفه الأمالي",45,"ل",2,0],["مَتَى عُرِضَتْ فِي الفَضْلِ بَيْنَ القَصائِدِ","مَحا فَضْلُها فِي الفَضْلِ فَضْلَ القَصائِدِ",46,"د",1,0],["متى عليها نسمع النايحاتي","ودار الثنا والجود فيها زغاريت",47,"ت",1,0],["متى على الله يرزق العود .! رجّال.","ويشب في قلب الهشيم ووريثه.",48,"ث",2,0],["متى عهدت الأسود الضاريات عنت","لسائميها بخسف أو لوت عنقا",49,"ق",2,0],["متى عمر بصوت الحق يأتي","وسوط العدل ألهب ذي برود",50,"د",1,0]]}