://www.poetsgate.com/ViewPoem.aspx?id=112152",""],[5881,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=183810",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5956,"المضياف","https://www.poetsgate.com/ViewPoem.aspx?id=194184",""],[6068,"إن المحب فؤاده أواب","https://www.poetsgate.com/ViewPoem.aspx?id=192761",""],[6225,"العروبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80915&r=&rc=184",""],[119,"لك أشكو يا أرحم الرحماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55608&r=&rc=5",""],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""]],"verses":[["سِربٌ إِذا اِستَوقَفتُ في ظَبَياتِهِ","عَينِيَّ رُحتُ عَلى جَوىً مَوقوفِ",0,"ف",1,0],["سُربِلتَ سُربالَ مُلكٍ غَيرَ مُغتَصَبٍ","قَبلَ الثَلاثينَ إِنَّ المُلكَ مُؤتَشَبُ",1,"ب",1,1],["سُربِلتَ سِربالَ مُلكٍ غَيرِ مُبتَدَعٍ","قَبلَ الثَلاثينَ إِنَّ الخَيرَ مُؤتَنَفُ",2,"ف",1,0],["سِربٌ حَماهُ الدَهرُ ما حَماهُ","لَمّا رَآنا اِرتَدَّ ما أَعطاهُ",3,"ه",1,0],["سِر بنا عن دمشق يا طالبَ العي","ش فما للمقام للمرء رَغْبه",4,"ه",1,1],["سِرْ بهُدَى كوكبٍ هَداك به","ولا تَعرَّضْ لكوكبٍ كَدرَه",5,"ر",2,0],["سر بالتاج فهو تاج ابيك الفرد","والعرش عرشه المكفول",6,"ل",1,0],["سرب النور دافقا","مثل سيل قد انحدر",7,"ر",1,0],["سر بالسلامة حاملا زفراتنا","واذكر مقامك بيننا الأعواما",8,"م",2,0],["سِربٌ مَحاسِنُهُ حُرِمتُ ذَواتِها","داني الصِفاتِ بَعيدُ مَوصوفاتِها",9,"ت",3,1],["سربٌ من الأنسِ ركَّبنَ الغصونَ على","حِقفِ النَّقا وسترنَ الوردَ بالعنمِ",10,"م",1,0],["سِر بِسَعدِ السُعودِ في","صُحبَةِ الواحِدِ الصَمَد",11,"د",1,0],["سَرِباً مَدامِعُها تَنوحُ عَلى اِبنِها","بِالرَملِ قاعِدَةً عَلى جَلّالِ",12,"ل",1,0],["سِربُ الحَديثةِ مُنْذُ صِينَ به","في مأمنٍ ممَّن يُنفِّرُه",13,"ر",2,0],["سرب من الحور الفوا","تن كالزهور نواضرُ",14,"ر",1,1],["سِر بِالمَطايا وَلا تَرفَق فَلَيسَ فَتىً","أَولى بِهَذا السُّرى مِن سائِقٍ حُطَمِ",15,"م",1,0],["سِرْ باللّواءِ يَدَعْ لجندِكَ شِلْوَهُ","مَنْ ظَنَّ أنّ مجالَها قد ضاقا",16,"ق",2,0],["سِرْ بالكتابِ رَسولاً حَسْبُهُ شَرفاً","أن راحَ يَحمله مِن أشرفِ الرُّسُلِ",17,"ل",1,0],["سِربَينِ عَنّا بِجَبينٍ صَلدِ","فَاِنقَضَّ يَأدو غَيرَ مُجرَهِدِّ",18,"د",1,0],["سِربٌ تَراءى كَنِظامِ العَقدِ","حُلوُ الحَديثِ حَسَنُ التَصَدّي",19,"د",2,0],["سِرْ بي إلى الدَّارِ الَّتِي","شِيدَتْ عَلَى كرَمِ العَنَاصرْ",20,"ر",1,0],["سِرْ بِيُمْنٍ وَإِنَّ ذِكْرَكَ فِينَا","لَمُقِيمُ فَلَيْسَ بُعْدُكَ بُعْدَا",21,"د",2,0],["سِرْ بالسفينَةِ هَوْناً","فليس ثَمَّةَ صَخْر",22,"ر",1,0],["سِرْ بالرِّياضِ وخُذ مِنْها نَضارَتها","ونَاغ ما شِئْتَ مِنْ وَرْدٍ ورَيْحان",23,"ن",1,0],["سربْتَ في طبقات الأرض مُنْسَرِبًا","فكيف أصبحتَ تيجانًا على القمم؟",24,"م",1,0],["سِرْبُ الغواني على الأبواب منتظرٌ","تكشَّفَتْ منه أعْضَادٌ، وسيقان",25,"ن",1,0],["سِربَان من بط وبيضٍ خرَّدٍ","يتباريان سباحة ووثوبا",26,"ب",2,0],["سِرْبي مرعى الوحشِ ربْربيه","بَدْريِّ حُسن الوجه كوكبيِّه",27,"ب",3,0],["سربالهم في الحرب هيكل ذكرهم","والغير يجعل للحروب حديدا",28,"د",2,0],["سربدا مجلاه","ثم انجلى معناه",29,"ه",1,1],["سر بنا نطلب فِكراً","لم يجُل قطُّ ببالِ",30,"ل",1,0],["سِر بنا نَستعِيض","عن ظلامِ الحضيض",31,"ض",1,0],["سِر بنا نَقطَعُ شَوطاً","قبلَ أن تَفنى اللَيالي",32,"ي",1,0],["سربٌ يُغنينَ بالأفواهِ مطربةً","وثلةٌ برباباتِ وعيدانِ",33,"ن",1,0],["سِرْبُ الشُّهَدَاءِ حَمَائِمُهُمْ","هَدَلَتْ بالمجْدِ تُقَلِّدُنَا",34,"ن",2,0],["سربوا تحت متو","ن الأرض والأرض جموح",35,"ح",1,0],["سربال نورٍ على جسم من الراحِ","نقوش خدّيه من ورد وتفّاحِ",36,"ح",1,1],["سِربُ مَها أَم دُمى مَحاريبِ","أَم فَتَياتُ الحَيِّ الأَعاريبِ",37,"ب",1,1],["سِرْبِي إلَى سِرْبٍ لحَربِي ناهِدٍ","لا هِنْدُهُ سَلْمٌ وَلا سَلْمَاهُ",38,"ا",2,0],["سِرْبٌ مِنَ الْحَمْدِ الْجَزِيلِ غَدَوْتُمُ","مَرْعى عَقائِلِهِ وَمَوْرِدَ عِينِهِ",39,"ن",2,0],["سُرَّ بِهِ الناسُ فَقالوا كُلُّهُم","لِمِثلِ هَذا اليَومِ كُنّا نَرتَقِب",40,"ب",1,0],["سر بالأمان عبيد الله ممتطياً","متن العلى بكمال العز والطرب",41,"ب",1,1],["سر باسم ربك هذا عامك الثاني","وارفع لواء الهدى في كل ميدان",42,"ن",1,1],["سر بها شاذليه ما ترى قط هولا","واعلم أنك مسخر عبد والله مولى",43,"ل",2,0],["سِرْ بنا نَحْو حدةٍ وسناعِ","والإكامِ الّتي بسفح القاعِ",44,"ع",1,1],["سِرْ بحفظِ الله وارجَعْ سالماً","راغماً بالعِزِّ أنْفَ الحاسدين",45,"ن",1,1],["سِرْبُ المُقاصِرِ والمَلاعِبِ صُنْتُهُ","فأَطَرْتُهُنَّ مع القَطَا الأَسْرابِ",46,"ب",1,0],["سربلت صفرة الغزالة لونا","مثلما وشيت بخيط الفجر",47,"ر",1,0],["سر بي ولا تخف المقاتل واثقاً","بالله إن العار عين المقتل",48,"ل",1,1],["سرب الغواني بين شبان الهوى","ألعوبة في مسرح الشيطان",49,"ن",1,0],["سر بدا في الكون أعجم حرفه","معناه دق عن الأديب الدان",50,"ن",1,0],["سربلتها بغرادةٍ جزئيَّةٍ","حتى يردَّ بها إليك الشاردُ",51,"د",1,0],["سرٌّ بأنماط الغيوب محتَّمٌ","مرسومه والحال معنىً شاهدُ",51,"د",1,0],["سربي لسرب حبيب قلبي مسرعاً","يا جمر وجدي واقطع الأقطارا",52,"ر",2,0],["سرْ بطريقِ اللهِ حتَّى المُنْتَهى","إذْ ليس للإَنسانِ إِلاَّ ما سعَى",53,"ا",1,1],["سِربِنا يا حَادي العيس عَسَى","أن نلاقي يومَ جمع سِربنا",54,"ن",2,0],["سرٌّ بذات أبيه كان محجَّباً","فبَدا به للّهِ في الإفشاءِ",55,"ا",2,0],["سِرْ بِنا نَحْوَ جِبْلَةٍ أَوْ فَعُدْ نَح","وَ ذَمارٍ يَزُولُ عَنّا الكَرْبُ",56,"ب",1,0],["سَرْبَلَني ما لا بديلٌ له","وربّما اِستبدل مَن سربلا",57,"ل",2,0],["سِرْبُ النَّعَامِ نافراً في البِيْدِ","فالنَّبْتُ قد قامَ مِنَ اللُّحُودِ",58,"د",1,0],["سر بالسلامة محفوفا إلى ملك","عليه اسبغ ربي اوفر النعم",59,"م",1,0],["سِر بالسلامةِ والإقبالِ بالظفرِ","فأنتَ كالبدرِ إن تطلع وإن تسرِ",60,"ر",1,1],["سر بعيد في الدنو ودونه","فتن بها كل الورى مفتون",61,"ن",1,0],["سر بي إلى الشقراء من جلق","واثن إلى الخضراء منك العنان",62,"ن",1,1],["سر بجو العلى إلى حيث تهوى","فالمعالي تسيرُ حيث تسير",63,"ر",1,0],["سربنا كما يسري الخيال وغضّضت","على ركبنا من ناظر الليل أجفان",64,"ن",1,0],["سِرْبُ الجَوَى لا الجَوِّ عُوِّدَ حُسْنُهُ","أنْ يَرْتَعِي حَبَّ القلوبِ ويَلْقُطَا",65,"ط",2,0],["سرَّ بِنا وَنالَ مِنّا أنسا","إِذ كانَ في الحرسِ مِن فرَنسا",66,"س",2,0],["سرْ بنا نقصد الذي إن قصدنا","ه بلغْنا المرجوَّ والمأمولا",67,"ل",2,0],["سر بدارا من الجَزائِر صبحا","لا تواني الغدو وَالآصالا",68,"ل",2,0],["سَربَلتَني كَرَماً بِأَبهَجِ حلَّةٍ","وَمَنَحتَني بِالحلمِ كُلِّ تَعَطف",69,"ف",1,0],["سر بِالسَلامة فَالتأييد يقدمكا","أَنى تَوَجهت وَالتَوفيق يَصحبكا",70,"ك",2,1],["سر بجد أيها الحادي فقد","ادلج السارون من هذا البلد",71,"د",1,1],["سرب الأنيس به غنَيْنا مَرّةً","زَمن الحمى والسَّربٌ غير مُرَوّعِ",72,"ع",1,0],["سِرْبٌ تُقِلُّ مَتُونُهُنَّ فَوَارِساً","نَارُ الوَغَى بِسُيُوفِهِمْ لاَ تَنْطَفِي",73,"ف",2,0],["سِر بى ولا تَسأم لعلّ ترى","عينى غَزيِّلَ ذلك السَّربِ",74,"ب",1,0],["سرَّ بها الدهرُ بني العليا لم","يدع لهم قلباً عليه موجِدا",75,"د",2,0],["سر بحفظ الله يا هذا الهمام","وابلغ الامال وارجع بسلام",76,"م",1,0],["سر بالسلامة آمناً","وارجع سليماً غانماً",77,"م",2,0],["سرباس سرباس يا عيني وَيا كبدي","يا هود قَلبي وَيا داوود عشاقي",78,"ي",1,0],["سر بوجدي ولوعتي وهيامي","يا نسيمَ الصبا وبلِّغ سلامي",79,"م",2,1],["سر بنا نحو أَثيلات الحمى","عل منا البرء يسري في العلل",80,"ل",1,0],["سر بحزم وحكمة وصلاح","حسبك الله وهو نعم الوكيل",81,"ل",1,0],["سر بي إلى الغرب حيث الشمس مائلة","فقلت ما لي ولليل الدجوجي",82,"ي",1,0],["سَربَلتَ قَوماً سَرابيلَ الندى فَبَغوا","فَسُمتَهُم حَدَّ ماضي الضَربِ بَتّار",83,"ر",1,0],["سِرٌّ بَدبعٌ كانَ في إِخفائِهِ","مِن قَبلِ سَعدِكَ حِكمَةٌ لَم تَظهَرِ",84,"ر",1,0],["سِرٌّ بَديعٌ أَرادَ اللَهُ يُظهِرُهُ","لَمّا أَتَيتَ وَكَم في الغَيبِ أَسرارُ",85,"ر",1,0],["سر بالمهارى الناجيات لا نجت","بالركب عن سرب المها المجتاز",86,"ز",1,0],["سرب مهاً تهمي عيون عينها","بيض ظباً تَدِينُ بالإجهاز",86,"ز",1,0],["سر بالجياد المذاكي تذك نار سَطَا","يزداد وقداً بِرَقْرَاقِ الدم السَّرِب",87,"ب",1,0],["سِر بِهِ بِسِربِهِ لِسِربِهِ","فَاللُهى تَفتَحُ بِالحَمدِ اللَها",88,"ه",2,0],["سر بسيط ظاهر","يختال في شبح مركب",89,"ب",1,0],["سرُّ به خصَّه باريه إذْ جُمعت","وأودعت فيه عن أمرٍ ودائعه",90,"ه",1,0],["سرب يريث بالكثيب خطوه","حتى تخطى عقد الرمل فحل",91,"ل",1,0],["سرب تتهاداها علوج امية","فمن ملحد تهدى إلى شر ملحد",92,"د",1,0],["سرب جعلت له ضُلوعي مرتعاً","وَمدامعي ورداً فَلَم يتأنس",93,"س",1,0],["سربى نديمي للربا متنزها","بخدود ورد أَو لواحظ نرجس",93,"س",1,0],["سربٌ من العفر تغشَانَا لواحظُه","عن جانَبيها المنايَا والمنَى زمر",94,"ر",1,0],["سربها يا صاح نحو الم