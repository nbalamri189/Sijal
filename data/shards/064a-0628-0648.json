{"poems":[[136,"ألم يأن أن تجفو الصبا وتحلما","https://www.aldiwan.net/poem54748.html","الطويل"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[303,"وقف على الفيض أنفاس مصعدة","https://www.aldiwan.net/poem36301.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[454,"مع صادق الشعر","https://www.aldiwan.net/poem970.html",""],[469,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[505,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[578,"عاديت في الله قوماً أنكروا رصداً","https://www.aldiwan.net/poem3659.html","البسيط"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123376","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103439","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140039","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216392",""],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75829","الوافر"],[4169,"","https://poetry.dctabudhabi.ae/diwan/poem/116599","الطويل"],[4782,"مواسم","https://www.poetsgate.com/ViewPoem.aspx?id=215403",""],[4817,"أنشودة إلى روح أبي","https://www.poetsgate.com/ViewPoem.aspx?id=215385",""],[5168,"شلون اكتب","https://www.poetsgate.com/ViewPoem.aspx?id=33618",""],[5268,"سُوار","https://www.poetsgate.com/ViewPoem.aspx?id=207001",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5431,"وكانت له قطفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=197851",""],[5695,"لولا الحب....","https://www.poetsgate.com/ViewPoem.aspx?id=212443",""],[5725,"ياعراق","https://www.poetsgate.com/ViewPoem.aspx?id=179277",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5848,"ولد عمك علشانك تمشكل مع ولد خالك","https://www.poetsgate.com/ViewPoem.aspx?id=48990",""],[6035,"إنّ المُقَرِّظَ بالأحبابِ مُتَّهَمُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177163",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""]],"verses":[["يُبُوِّئُ لِلأضيَافِ أرحَبَ مَنزِلٍ","ويُكرِمُهُم مُستَبشِراً مُتَنَعِمَّا",0,"م",2,0],["يَبوءُ بِخُسرٍ بائِعُ العِزِّ بِالغِنى","وَأَخسَرُ مِنهُ مُشتَري الغَدرِ بِالوَفا",1,"ف",2,0],["يبوِّئُ القوم للهيجا مقاعدَهم","من هابطٍ وادياً أو مرتقٍ أَكما",2,"م",2,0],["يَبوءُ بِالرَدِّ مُحروماً مَراحِمُهُ","كَلّا فَمَن تَكُنِ الحُسنى دَعائِمُهُ",3,"ه",1,0],["يبوح على قدر المحبة مقولي","وليس لغير الحب يشدو وينظم",4,"م",1,0],["يبو ح له النطاق بما حاه","وتكتم سرها عنه الحجول",5,"ل",1,0],["يبولُ مقْهوراً وتَلوي بهِ","لنومِهِ جُثَّتُهُ المُعْرَقَهْ",6,"ق",2,0],["يبَومَ البَعيرِ وَيَومَ النَهرَوانِ وَفي","صِفّينَ داوى شُكاةَ الدينِ بِالقُضُبِ",7,"ب",1,0],["يَبوغُ ذو الفضل تَثْقِيفاً فإنْ تُلِيَتْ","آياته ظلّ كاليَرْبوعِ في النَّفقِ",8,"ق",1,0],["يبوئ عرش النيل من شاء جانفاً","فننشده والخطب بالخطب يلتقي",9,"ق",2,0],["يَبوسانِ لَم تَطمِثهُما كَفُّ حالِبٍ","عَلى السَوطِ وَالأَنساعِ كانَ مِراهُما",10,"م",2,0],["يُبَوَّأ أيدي مالكيه كأنه","على آمريه في الجلال أميرُ",11,"ر",1,0],["يبول نائمهم في صحن مسجدهم","ويقتل القمل والبرغوث في الحرم",12,"م",1,0],["يبوئي من يلقى جنانَ قبوله","ويَسْقيه منْ معسولِ ألفاظه أريا",13,"ي",2,0],["يَبوءون بالعصيانِ والدهرُ مُطرِق","ألا فِي طروقِ الدهر دَهْياءٌ صَيْلم",14,"م",1,0],["يِبوي الرّيادي مسرعٍ للخَلا بوّاق","ولا خاف من شِيب الغوارب يِكيدِنّه",15,"ن",2,0],["يَبُوءُ بِصاحِبي أو يَقْتُلونِي","قَتِيلٌ مَاجِدٌ سَمْحٌ كَريمُ",16,"م",1,0],["يبوحُ بما يُخفى حَشاً وضُلُوعُذ","سقيمة أطراف الدُّمُوع جَزوعُ",17,"ع",1,1],["يبوح بالجرح في أجفاننا وجعٌ","ودمعتان على كف النوى مطر",18,"ر",1,0],["يَبُوسُ النَّهْرُ رِجْلَيْهِ","فَيَقْبِسُ مِنْهُمَا الطُّهْرَا",19,"ر",2,0],["يبو شفايف ورد رمان والطول","مثل الخيزران وصدر ناهد",20,"د",1,0],["يَبوحُ ليْ النَّخلُ إنْ عانَقتهُ رُطَبًا","كأنَّ بالقلبِ ما بالنَّخلِ مِن رُطَبِ",21,"ب",1,0],["يبوس عاصمة بالفخر معلمها","كنعان صاحبها لم ترض بالعجم",22,"م",1,0],["يبوح شذا ورد بعنق غواية","وتسبيح أقمار تراءت به طيفا",23,"ف",2,0],["يبوحُ الدّمعُ إنْ عزّ الكلامُ","بما تقضي الضرورةُ والمَقامُ",24,"م",1,1],["يبو سيف الماصدة بغمده ومهيب","لوتسلّة اتهاب منّة ابطالها",25,"ل",3,0],["يبو حجي الزين ياجلمة رزان","جنها مهرة تزامط بخيالها",25,"ل",3,0],["يبوصلونَ الطّريقَ الأمس وجهتهم","وينحتونَ الرّمالَ ندىً ومرجانا",26,"ن",2,0],["يبونك كل واحد قال يالله علّها لي فال","والى احدٍ قالها رديت فال الله ولا فالك",27,"ك",1,0],["يَبُوحُ لَعْجُ الهوى بالشوقِ مُضْطَرِمٌ","وهلْ أَجِيجُ الجَوَى في القلبِ يُكْتَتَمُ ؟",28,"م",1,0],["يبوسها قدام جمعيه وتبوس هيه","لا كسكسه في الحريه مسيو ومدام",29,"م",1,0]]}