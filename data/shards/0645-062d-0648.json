{"poems":[[3,"دهتني صروف الدهر وانتشب الغدر","https://www.aldiwan.net/poem165.html",""],[88,"يا صاحب الروضة الغناء هجت بنا","https://www.aldiwan.net/poem68930.html","البسيط"],[88,"بلغتك لم أنسب ولم أتغزل","https://www.aldiwan.net/poem68961.html","الطويل"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[74,"محو شعر المديح وكان مما","https://www.aldiwan.net/poem18910.html","الوافر"],[63,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[46,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43653","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54256","الوافر"],[96,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[132,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[164,"محوت المداد كمحو المداد","https://www.aldiwan.net/poem59040.html","المتقارب"],[333,"فلسطين يا كعبة العالمين","https://www.aldiwan.net/poem54916.html","المتقارب"],[343,"حدثت باليأس عنك النفس فانصرفت","https://www.aldiwan.net/poem68735.html","البسيط"],[376,"أرى طارقا يصبو إلي ويصبيني","https://www.aldiwan.net/poem57085.html","الطويل"],[422,"محوت بسيف سطوتك الفسادا","https://www.aldiwan.net/poem53896.html","الوافر"],[438,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[505,"يا شمس طيبة بل شمس الوجودات","https://www.aldiwan.net/poem37662.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122592","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122801","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48845","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122316","الطويل"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77842","المنسرح"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198882","الطويل"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105303","الرجز"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113808","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27685","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204847","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112623","الرجز"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91575","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85080","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135236","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35503","الوافر"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40112","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119485","الطويل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36478","الدوبيت"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[4755,"جَمَعتُ ما ضَاعَ مِن عُمري","https://www.poetsgate.com/ViewPoem.aspx?id=200232",""],[4755,"جَمَعتُ ما ضَاعَ مِن عُمري وما بَقِيَا","https://www.poetsgate.com/ViewPoem.aspx?id=207433",""],[5050,"صبرا على مضض المصارع","https://www.poetsgate.com/ViewPoem.aspx?id=38198",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5411,"خلف الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=195063",""],[5413,"لمَالِكِ عصره","https://www.poetsgate.com/ViewPoem.aspx?id=200591",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5577,"هجرة","https://www.poetsgate.com/ViewPoem.aspx?id=176246",""],[5730,"كيف يحزن قلب أنت ساكنهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210334",""],[5956,"خاتم الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=184660",""],[5956,"ذهبنا إلى الفضلي نخفف وحشة","https://www.poetsgate.com/ViewPoem.aspx?id=192983",""],[5956,"الاصطباح بالأفراح","https://www.poetsgate.com/ViewPoem.aspx?id=193167",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6165,"نشيد الألواح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87256&r=&rc=16",""],[6202,"فليسقط الشعر -2","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86741&r=&rc=42",""],[2220,"هذا الوجودُ الذي بالعرف نعرفه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11744&r=&rc=614",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["مَحَوتُ بِذِكري في الوَرى ذِكرَ مَن مَضى","وَسُدتُ فَلا زَيدٌ يُقالُ وَلا عَمروُ",0,"ر",2,0],["مَحَوتَ ما كَتَبوا عَنّا بِقاطِعَةٍ","مِنَ البَراهينِ فَلَّت قَولَ رينانِ",1,"ن",1,0],["مَحَوتَ بِهِ في الدينِ كُلَّ ضَلالَةٍ","وَأَثبَتَّ ما أَثبَتَّ غَيرَ مُضَلَّلِ",2,"ل",1,0],["مَحَوْا بِجَمِيل الثَّأْرِ مَا خَطَّ مُفْتَرٍ","عَلَيْنَا وَفِي كَفَّيْهِ لِلْعَارِ مِيسَمُ",3,"م",1,0],["محو شعر المديح وكانَ ممَّا","يقرّ نواظراً ويسرّ فكره",4,"ه",1,1],["محوتَ صَحائِفَ اللَّذَّاتِ لمَّا","مَحوتَ بها سطورَ الزَّفْنِ مَحوا",5,"و",2,0],["مَحَوتَ بِها وَقائِعَ مِن مُلوكٍ","وَكُنَّ وَقَد مَلَأتَ الخافِقَينِ",6,"ن",1,0],["مَحوٌ مِنَ البيضِ الرِقاقِ أَصابَهُ","فَعَفاهُ لا مَحوٌ مِنَ الأَحوالِ",7,"ل",1,0],["مُحوِلاً جَرَّت بِهِ ال","رِيّاحُ ذَيلاً مُعجَلا",8,"ل",2,0],["محَوْا لفظةَ الأربابِ من كلماتِهمْ","فما عرفوا معنى مَسودٍ وسيِّدِ",9,"د",1,0],["مَحَوتُم كِتاباً لِلعِتابِ خَطَطتُهُ","وَمُدَّ لِمَبنِيِّ الرِضا كَفُّ هادِمِ",10,"م",1,0],["محوتِ الليلَ ناصعةَ الْجَبينِ","فكنتِ بشائِرَ الصبحِ المبينِ",11,"ن",1,1],["محوت من قلبي الدنيا فما سلمت","إلاّ طيوف هوانا وحدها فيه",12,"ي",2,0],["محوَ بأس الإمام ذي العدل سلطان","بن سيف شحرور كيْدِ الأعادِي",13,"د",2,0],["مَحَوتَ ذِكرَ الكِرامِ الأَوَّلينَ بِها","وَالسَيلُ ما غَرِقَت في فَيضِهِ الغُدُرُ",14,"ر",1,0],["مَحَوتَ بِها أَثَرَ المُفسِدينَ","وَما لَيسَ تَجبُرُ لا يَنجَبِر",15,"ر",1,0],["محوت المداد كمحو المداد","وأفنيت ذى الفئة الباغيه",16,"ه",1,1],["محوت بنورك جنح الظلام","ولا زلت للنيل حدّ الحسام",17,"م",1,0],["مَحَوتُ ذِكرَكَ مِن قَلبي وَمِن أُذني","وَمِن لِساني فَصِل إِن شِئتَ أَو فَدَعِ",18,"ع",1,0],["مَحوتُ به ما كانَ لي من نُفُوسِهم","وصرتُ إِذا جاوَزتُ حدَّكَ رَدُّوني",19,"ن",2,0],["مَحَوْتَ بسَيف سَطوتك الفَسادا","بحكْمٍ قَد أَرَحْتَ به العبادا",20,"د",2,1],["محَوْتَ ذُنوبَ الأمسِ من هَفواتِه","بما قام في إثباتِه اليومُ والغدُ",21,"د",1,0],["محوطا برب العرش من كل طارق","وأصلي ووصلي ثم شملي وما ليه",22,"ي",2,0],["محوتُ فيك السوى اثبتُّ معرفتي","فبارك اللهُ في محوي وإثباتي",23,"ي",1,0],["مَحوتَهم مَحوَ المدادِ فأصبَحت","كَنائسُهم مَنسُوخَةً بالمساجدِ",24,"د",1,0],["مَحَوتَ صَنيعَكَ الأَمسي عِندي","فَلَيتَكَ أولاً لَم تَصطَنِعني",25,"ن",2,0],["محوتِ الذي خط القديم وما مضى","وجئتِ بما خط الجديد وما سنّا",26,"ن",2,0],["محوت ظلام الظلم في كل بلدة","بعدلك حتى ليس للظلم محرم",27,"م",1,0],["محوطاً إلى أن آل تدبير أمره","وحفظ حماه بالخميس العرمرم",28,"م",1,0],["محولات الحال","مبلبلات البال",29,"ل",1,0],["محونا بك الأديان لو عاش رسلنا","لجاءك عيسى تابعا وكليم",30,"م",1,0],["محوت بالعدل الذي سرت به","ما نقش الجور وخطت البدع",31,"ع",1,0],["مَحوطٌ بالسرور وبالتهاني","عليه البشرُ والإقبالُ وقفُ",32,"ف",1,0],["محوّما في قلق","كطائر في سهد",33,"د",1,0],["محوته من صدورٍ أنت تعرفها","بسِنَةٍ أو نُعاسٍ فاحتمى دمه",34,"م",2,0],["محوتم لنا العار الذي لطخ العُربا","وعلمتم الأعداء أن تفهم الحربا",35,"ب",2,1],["محوّلاً فسطاطهُ وثقلَهُ","مستبدلاً بخرِ أهل أهلَهُ",36,"ه",1,0],["محوت سواك عنه محوا مؤبدا","وعاين حضرة المعاني القديمة",37,"ه",1,0],["محوتَ بنورِ طلعتك الدَياجي","وَأَغنى راحُ راحتك الرَواجي",38,"ج",2,1],["محو وصحوا قد علا","إذ فاز بالقدح الكبير",39,"ر",1,0],["محونا بك الأجداب والضُّرَّ والغلا","وشرّاً لمن قد كان خيف ولو سما",40,"م",2,0],["مَحَوت بِهِم ذُنوب الدَّهر عِندي","وَبِالحَسَنات تُمحى السَيّئات",41,"ت",1,0],["محوْتَ ما أَثبتَهُ الجَور مَضى","عَلَيهِ إِخلادُ اللَيالي فخلَّد",42,"د",1,0],["محوت بما أثبته من ملامحم","أعدت بها الاسلام كتب الملاحم",43,"م",1,0],["مَحواً لِخَيال غَيرِها عَن بَصَري","وَكَّلتُ بِها الدَمع أُزيلُ النَقشا",44,"ش",2,0],["مَحَوْتَ بماضي الْعَزْمِ كُلِّ مُلِمَّةٍ","وَلَم تَخْشَ خَطْباً حيثُما رُمت مَقْصَدَا",45,"د",2,0],["محور حربٍ ذاك بل مزبر ال","حتف الذي للشرك طرّاً محا",46,"ح",2,0],["مَحَوتُ أَطوَلَ أَسمائِي، وأَقصَرَها","كَسَرتُ أَكبَرَ حَرفٍ مِن دَمِي سُقِيا",47,"ق",3,0],["مَحَوتُ أَطوَلَ أَسمائِي، وأَقصَرَها","كَسَرتُ أَثمَرَ غُصنٍ مِن دَمِي سُقِيا",48,"ق",3,0],["محوا الضلالة بالجمو","ع وبالبراهين القواطع",49,"ع",1,0],["محوطاً بقال الله قال رسوله","وليس لنا إلاَّ هما حين نرتما",50,"م",2,0],["مُحَوَّطٌ كَهْفُ أوْجاعي بِأحْجِيةٍ.","به الأنينُ بعمْقِ الرُّوح قد نُصِبا",51,"ب",2,0],["محوتَ بنور العلمِ والحنْكة التي","حَبَتْكَ الليالي في البلاد الدياجيا",52,"ي",2,0],["محوتَ عنهم ظلامَ الجهلِ فانقلَبوا","بِنعمةٍ مِن عطاءِ اللهِ يُسديها",53,"ي",3,0],["محوتُ الدرب بعدك يا طريقي","فماللنفسِ في الأيام نفسا",54,"س",2,0],["مَحَوْتُ خَوْفِي مِنَ الأَيّامِ ِ، هَيْبَتَهَا","ولمْ تَعُدْ تَعْتَرِيني بَعْدَهَا الآهُ",55,"ا",2,0],["محوتَ الكفر يا ماحي الخطايا","وحاشرَنا على عقبيك حشرا",56,"ر",2,1],["محَونا بأفراحٍ لديه همومَنا","لأنه يرمي فوقهنَّ شِباكا",57,"ك",2,0],["مِحْور الفكرِ وطلاّع الأعالي","يجتبيه الله من أغلى سُيُوبِهْ",58,"ب",2,0],["مَحَوَا آيةَ النهارِ فَعَادتْ","آيةُ الليلِ ما لها مِنْ مَاحي",59,"ح",2,0],["محوتُ عن جسدي آثار من تركوا","أسماءهم قِبلةً لاسمي لينتشروا",60,"ر",3,0],["محوت شعري ولا كانت منابره","إذا يساير ذل الصمت خوّارا",61,"ر",2,0],["محوته من صدورٍ أنت تعرفها","بسنة ٍ أو نهاسٍ فاحتمى دمهُ",62,"م",2,0],["محَوْتِ كُلَّ تفاصِيلِي بمُوجِزِهِ","حتَّى فهِمْتُ درُوسَ الرادِيكاليَّةْ",63,"ي",2,0]]}