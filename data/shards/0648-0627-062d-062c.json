{"poems":[[72,"سأعرض عمن راح عني معرضا","https://www.aldiwan.net/poem42835.html","الطويل"],[40,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[47,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[76,"لك الخير أي الخير في رد صاحب","https://www.aldiwan.net/poem12963.html","الطويل"],[54,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[50,"إذا عبا أبو الهيجاء","https://www.aldiwan.net/poem65307.html","الهزج"],[52,"فتاتي نديمي غنيا بحياتي","https://www.aldiwan.net/poem64737.html","الطويل"],[48,"دمع على ما يفوت منسكب","https://www.aldiwan.net/poem23328.html","المنسرح"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62231","الطويل"],[108,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[119,"ساعرض عمن راح عني معرضا","https://www.aldiwan.net/poem40906.html","عموديه"],[136,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[154,"عن الحب في الهادي استحال سلونا","https://www.aldiwan.net/poem68587.html","الطويل"],[164,"تلاطم بحر جيشه وماجا","https://www.aldiwan.net/poem58954.html","الوافر"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[214,"شد المناطق يثني عطف مخمور","https://www.aldiwan.net/poem13307.html","البسيط"],[234,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[303,"سقيا لمن أضرمت من حبها كبدي","https://www.aldiwan.net/poem36322.html","عموديه"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[325,"أيرقع منظر المرآة عنه","https://www.aldiwan.net/poem61817.html","البسيط"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[438,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[470,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[556,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82797","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122735","الرمل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66746","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63991","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56355","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87781","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59500","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59462","المتقارب"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20950","الطويل"],[5080,"سعي الظمائر","https://www.poetsgate.com/ViewPoem.aspx?id=185455",""],[5112,"طارق","https://www.poetsgate.com/ViewPoem.aspx?id=212407",""],[5147,"مخيلتي تطالبني بأمر","https://www.poetsgate.com/ViewPoem.aspx?id=166714",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5781,"قصيدةٌ محروقةٌ ودخان....","https://www.poetsgate.com/ViewPoem.aspx?id=198547",""],[5956,"رقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185617",""]],"verses":[["وَأَحجُزُ طَرفي عَنهُ وَهوَ رَسولُهُ","وَأَحجُبُ قَلبي عَنهُ وَهوَ شَفيعُهُ",0,"ع",2,0],["وَأَحجاراً مِنَ الصَوّانِ سُفعاً","بِهِنَّ بَقِيَّةٌ مِمّا صَلينا",1,"ن",2,0],["وَأَحجِ بِحَجّامِ الدَساكِرِ أَن يُرى","لَهُ اِبنُ ضَلالٍ نازِحُ الخَيرِ شاحِطُه",2,"ط",2,0],["وَأَحجَمتُ جُبناً عَن لَمامٍ بِعَتبَةٍ","وَإِنّي لَمَطوِيٌّ عَلى بَأسِ عامِرِ",3,"ر",1,0],["وَأَحجارٍ كَأَخلالٍ","مُقيماتٍ عَلى بَوِّ",4,"و",1,0],["وَأَحجارُ المَجانيقِ","لَنا تُفّاحُ لُبنانا",5,"ن",2,0],["وَأَحجُبُ زُوّاري اِغتِباطاً بِخَلوَةٍ","وَما كُنتُ أَهوى قَبلَها خَلَواتي",6,"ت",2,0],["وَأَحجَمَ القِرنُ عَن فَوارِسِهِ","وَما لِرَيبِ المَنونِ إِحجامُ",7,"م",1,0],["وأَحْجُزُهَا عَنْ ضِغْنِهَا وكَأَنَّمَا","تُقَادِعُني كَفِّي مِنَ الفَرْطِ مِعْوَلاَ",8,"ل",2,0],["وأحجمتْ في خفَّة النَّعامِ","إليكِ، يا شَبِيبَةُ، احترامي",9,"م",2,0],["واحجر طرفي فيه وهو رسوله","وامنع عنه الفكر وهو ضجيعه",10,"ع",2,0],["وأحجُوهَأ إِذا أخَذَت تَثَنَّى","قَضِيبَ ألبَانِ في هَبِّ النَّسِيمِ",11,"م",1,0],["وَأَحجَمَ عَن إِقدامِهِ كُلُّ باسِلِ","وَمَن لَجَّ أَضحى مُستَباحَ المَقاتِلِ",12,"ل",1,0],["وأَحجم كلَّ ليثِ وغىً تدانى","ليفزع بعد إِيغال وعاجا",13,"ج",2,0],["وَأحجَّ حَجّاً كامِلاً مَبرورا","وَيَكون بيتُ هِدايتي مَعمورا",14,"ر",2,0],["واحجج الى حرم بالبر معتمر","تفز يجج حميد السعى مبرور",15,"ر",1,0],["وأحْجل الوردَ بكاءُ النَّدى","فاحمرّ والحمرةُ تُسْتاقُ",16,"ق",1,0],["وَأحجمت بعد أنْ صحَّ الهوى لترى","هل كنتُ مقتصداً أم غير مقتصد",17,"د",1,0],["وأحجمتِ العتاقُ منَ المذاكي","تملْمل في اللِّجامِ وبالشِكال",18,"ل",1,0],["وَاِحجِب وَجهَهُ كَيلا يَراها","مَخافَةً إِن تَثنيهِ لِعَيني",19,"ن",2,0],["وَاِحجُجِ البَيتَ وَطُف سَبعاً بِهِ","وَاِقضَ فَرضي فيهِ وَاِقصِد عَلَمَي",20,"ي",1,0],["وأحجيةٌ فيك حبّرتُها","ولو لم يكنْ فيك لم تُحبَرِ",21,"ر",1,0],["وأَحجبها الحواجب عن وداعي","فعني يا خليلي ودعاها",22,"ا",3,0],["واحجر على عينيك حفظاً أن ترى","غصنين منه دَنَيا فاعتنقا",23,"ق",2,0],["وأحجبُ نائباتِ الدهر منه","بخوصٍ لا تُحصِّلني وشُزْرِ",24,"ر",1,0],["وأحجَمتَ كيف، وفي ألفِ سيف؟","ولو كنتُ وَحديَ لم أُحجِمِ",25,"م",1,0],["وأحجار قُذفن تُقىً وبِرّاً","كما قُذفتْ بإصبعها القُلامَهْ",26,"م",2,0],["وَأَحجم عَما رَمَتني فيهِ مقدما","وَأَقدم فيما تَكرَهين وَأَسرف",27,"ف",1,0],["واحجُبُوا النّاسَ بإطماعِكُمُ","عِندَ فقدِ الصِّدقِ يُرضَى بِالمُحالِ",28,"ل",1,0],["واحجم عنها المسلمونَ ولم يكن","ليثبتَ إلاّ رابطُ الجأشِ أروعُ",29,"ع",1,0],["وأحْجِ بهم أن يَستطيرَ صفاتَهُمْ","قراعُك ممَّا تستطيرُ صُدُوعها",30,"ع",3,0],["وَأَحجارٍ نِفاسٍ فاخِراتٍ","لَوامِعَ كَالبُروقِ يَشِفُّ ماها",31,"ا",3,0],["وأحجبت عنه مرأى حسن طلعة من","إن شامه البدر يوماً راح مفتضحا",32,"ح",2,0],["وأحجارُ القلوبِ إذا أتتهُ","بجوهرها فتصبحُ كاللآلي",33,"ل",2,0],["وَأَحجى بِمثلي أَن يَكفَّ بَراعه","فَإِن مَنال الشَمس غَير قَريب",34,"ب",1,0],["وأحجمتِ الفوارسُ من نزارٍ","وقحطانٍ وهم أُسد الضّرامِ",35,"م",1,0],["وأحجمتِ الصَّيدُ من يعرُبٍ","وهَللَّت الشُّوسُ منْ قيدرِ",36,"ر",1,0],["وَأَحَجتُم حَتّى عَلاهُ بِصارِمٍ","حُسامٍ إِذا مَسَّ الضَريبَةَ يَبتُرُ",37,"ر",1,0],["واحجيةٌ عليها طافَ قلبي","احاولُ فكَّ احجيتي فتِهتُ",38,"ت",1,0],["وَأُحْجِيَّةٍ مِنْ قِطَافٍ رِشَاقٍ","عَلَى شُرْفَةِ الْبَدْرِ بِشْرَا تُسَالْ",39,"ل",1,0],["وأحجم حولن مبدئي المفدى","لساني واليراعة والضمير",40,"ر",1,0],["وأحجم أهلوها بيوم عصبصبٍ","به النقع يسمو كارتكام السحائب",41,"ب",1,0],["وأحجر كالخفاش حتى إذا بدا","من الغي ليبل جال فيه وغمغما",42,"م",2,0],["وأحجيتي ((بدائيٌّ حميمٌ ))","وماهو للتأوّلِ بالتماسِ",43,"س",1,0],["وأحْجُبُ عنْ سَمْعِ الضَّريرِ مَواجِعي","فَقَدْ تُبْصِرُ الأحْداقُ حينَ نُعَذَّبُ",44,"ب",1,0],["وأُحَجِّبُ الأشعار عن نظَرِ المَلا","كيلا يُقالَ تريدُ تُبرزُ سِحْرَها",45,"ه",2,0]]}