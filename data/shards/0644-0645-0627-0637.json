9","الدوبيت"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127311","الكامل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45944","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83354","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72674","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204234","الخفيف"],[4716,"يا أماماً قد حاز علماً وفهماً","https://www.poetsgate.com/ViewPoem.aspx?id=125955",""],[4755,"لَمَّا طَغَى المَاء..","https://www.poetsgate.com/ViewPoem.aspx?id=183533",""],[4755,"صَلَّيتُ حتى غَادَرَ المِحرابُ","https://www.poetsgate.com/ViewPoem.aspx?id=196533",""],[4832,"جود المسعى فكل قد وعى","https://www.poetsgate.com/ViewPoem.aspx?id=166705",""],[5206,"لَمَّا طَمَى قامُوسُ سِحرِكَ فَايِرًا","https://www.poetsgate.com/ViewPoem.aspx?id=187423",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5358,"نعم صدَقتِ","https://www.poetsgate.com/ViewPoem.aspx?id=197395",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5790,"لما طرقت خباءها","https://www.poetsgate.com/ViewPoem.aspx?id=111928",""],[5956,"حبيبةُ الأزهارِ","https://www.poetsgate.com/ViewPoem.aspx?id=193363",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6152,"قلبي لكِ تذلل","https://www.poetsgate.com/ViewPoem.aspx?id=204953",""],[6355,"الفرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66690&r=&rc=150",""]],"verses":[["لَم أَطلُبِ المُثري البَخيلَ لِحاجَةٍ","أَبَداً وَأَقنَعُ بِالجَوادِ المُرمِلِ",0,"ل",1,0],["لمّا طوى الكَشْحَ منْ حِقْدٍ على إِحَنٍ","وظلَّ يَهْرِفُ إبْراقاً وإرْعادا",1,"د",2,0],["لم أُطِلها كما أطالَ رِشاءً","ماتحٌ ساء ظنُّه بقليبِ",2,"ب",1,1],["لَمّا طَلَعتَ عَلى الشُعاعِ مُوَزِّعاً","مُتَرَجرِجاً كَخَواطِرِ المُرتابِ",3,"ب",1,0],["لَمّا طَلَعتَ عَلى المِياهِ تُنيرُها","سَكَنَت وَقَد كانَت بِغَيرِ قَرارِ",4,"ر",1,0],["لَمّا طَغَوا وَبَغَوا جَهلاً عَبا لَهُم","حَرباً تُغِصُّهُمُ بِالبارِدِ الشَبِمِ",5,"م",1,0],["لمَّا طلعت عليه","وهَى وأنّ وسلَّم",6,"م",1,0],["لما طلعت على مشارفه","أيقنتُ أني فوق سُلَّمه",7,"ه",1,0],["لَمّا طَلَبتُ العَذبَ مِنها أَصبَحَت","قُلُبي بِها مَملوءَةً وَرِداهي",8,"ه",2,0],["لمّا طلعت على الأحداثِ تدفعُها","تكشّفَ العارضُ المُسودُّ وانْقشعا",9,"ع",2,0],["لمّا طلعتَ ومصرُ حائرةُ الخُطى","جَعلَ الهُدى قَدَماً لمصرَ وساقا",10,"ق",2,0],["لَمّا طَغى فِرعَونُ دَهري عاتِياً","شَقَّت عَصا شِعري بَنانَكَ أَبحُرا",11,"ر",2,0],["لَمّا طَفا النَجمُ في بَحرِ الدُجى وَصَلوا","حَبلَ السُرى بِذَميلٍ غَيرِ تَلبيثِ",12,"ث",1,0],["لَمْ أُطِلْ في تَعْدادِ مَدْحِكَ نُطْقي","ومُرادِي بذلك استقصاءُ",13,"ا",2,0],["لَمّا طَوى اللَيلُ حَواشي بُردِهِ","عَن واضِحِ اللَونِ نَقِيِّ وَردِهِ",14,"د",2,1],["لَما طَيَّبَ اللَهُ أَرواحَها","وَلا بَلَّ مِن عَظمِها الأَنحَلا",15,"ل",2,0],["لَمّا طَلَعنَ مِن الرَقي","قِ عَلَيَّ بِالبَرَدانِ خَمسا",16,"س",2,1],["لَما طَلَعنَ حَفَفنَها","وَأَصَخنَ ما يَهمِسنَ هَمسا",16,"س",2,0],["لما طَغى وجاوزَ الحُدودا","ونَقضَ الميثاقَ والعُهودا",17,"د",2,0],["لَم أطِق فيهِ حيلَةً غَيرَ أَنّي","مُذ قَضى نَحبَهُ أَلفتُ النَحيبا",18,"ب",2,0],["لما طلبتُ من الدنيا مراتبَها","ولا بذلتُ لها عرضي ولا ديني",19,"ي",1,0],["لمّا طلعت أفاقت \" الخضرا على","فجر بأنفاس الخلود معطّر",20,"ر",1,0],["لم أطع فيك واشياً يزرع الحقد","ويجني ثماره في الخلفاء",21,"ا",2,0],["لم أُطِلْ في شرحِ الغرامِ فخ","يرُ الوَصْفِ في علّة الغرامِ اختصارُه",22,"ر",2,0],["لم أُطِق أن أزيدَ قلبي على ما","فيه من لوعةٍ وحَرِّ اشتياقِ",23,"ق",1,0],["لم أُطِق أن أرى فراقك جهراً","وفِراقُ الحبيب غير مُطَاقِ",23,"ق",1,0],["لم أُطِق أن أراك يا","أحسنَ الناسِ مُدنَفا",24,"ف",2,0],["لَمّا طَما بَحرُ العِراقِ مُزَمجِراً","ثانِيَةً مُتَخَمِّطاً بِغُثائِهِ",25,"ا",3,0],["لَمّا طلَعتَ عَلى العَدُوِّ تَخاذَلَت","أَنصارُهُ وَتَواكَلَت أَجنادُهُ",26,"د",2,0],["لما طلعتِ على عرشِ الهوى سَحَراً","وخرَّ قلبي صَريعاً عندَ مرآك",27,"ك",1,0],["لما طلعتَ عليّ في ليلِ الأسى","أعرَضتُ عن يأسي لحسنِ رَجائي",28,"ا",2,0],["لَمّا طَعَنّا بِالرِماحِ صُدورَهُم","وَلَّوا ظُهورَهُمُ فَجاءَ الماءُ",29,"ا",2,0],["لَمّا طَوَتكَ الأَربَعو","نَ وَآنَ لِلعُمرِ اِنقِراضُ",30,"ض",1,1],["لمّا طرقْتُ الحيَّ قالتْ خِيفةً","لا أنتَ إن عَلِمَ الغَيورُ ولا أنا",31,"ن",2,0],["لمَّا طَرَقْتُهمُ مُستَبضِعاً أَدَباً","وأين مَن كان يَقْرى الفَضْلَ أفضالا",32,"ل",2,0],["لمّا طَويْتُ أنا البعادَ نَشَرْتُمُ","ذَرْعاً لبُرْدِ المَهْمَهِ المَذْروع",33,"ع",1,0],["لماطغى إبليس وهو مخيّرٌ","ألقاه مولاه وساء بما فعل",34,"ل",1,0],["لما طاب سكنى طيبة ولقد بنا","بجنيب النبي المصطفى ذلك اللحد",35,"د",1,0],["لم أطع للسُلُوّ حكما ولكن","ساقني ظلمُها ونقصُ وفاها",36,"ا",3,0],["لما طَلعتَ البدرَ من ثَنِيَّةٍ","تُجلَى بها عينٌ وعَينٌ تَرمَدُ",37,"د",1,0],["لما طمحْتُ إِلى عيشٍ أرمَّقُهُ","أعُبُّهُ تارةً عبّاً وأرتشفُ",38,"ف",1,0],["لمّا طلعتُ بصدق العزمِ مشتملاً","رأى الكماة بوجهي مالئ المُقَلِ",39,"ل",1,0],["لمّا طَلَعنَ عَليَّ في غَسَقٍ","فَخَلَفْنَ ضوءَ الشّمسِ والقمرِ",40,"ر",1,1],["لما طلبت الصبر عنكم في الهوى","ألفيت أحشائي بذاك شحاحا",41,"ح",2,0],["لمَّا طَوَت أنجَلينا دارُ غُربتها","أجرَتْ دُموعَ بني التيَّانِ كالمَطَرِ",42,"ر",1,1],["لَمْ أُطِعِ العُذَّالَ فِيْهَا وَقَدْ","أَصْغَتْ إِلَى أَقْوَالِ عُذَّالِهَا",43,"ل",3,0],["لَمّا طَلَبْتُ وِصَالَهُ","أَضْحَى عَليَّ يُكَبِّرُ",44,"ر",1,0],["لَمّا طاوَلتُ أَحسابَ عُثمانَ عُصبَةٌ","وَلا دانَ مِنها مَطلَبٌ نَحوَ طالِبِ",45,"ب",1,0],["لما طلبتُ لهُ موتاً يعاجلهُ","قالت معي كلُّ أهل العشق آمينا",46,"ن",2,0],["لما طلعتَ لها بكلِّ ثنيةٍ","أنسيتَها المنصورَ والسفاحا",47,"ح",2,0],["لما طوت أفق البسيطة نشَّرت","خضر الملأ على الهضاب بالسودِ",48,"د",1,0],["لمَّا طَغَى كَبْشُهُ تَعمَّدَهُ","فصيَّرَ الرأْسَ مِنهُ في الكرِشِ",49,"ش",1,0],["لم أطق عد مساعيك التي","هي مثل الشهب أمست تتّجلى",50,"ل",2,0],["لما طغى بحر الحياة بعاصفٍ","عمت زوابعه شطوط بلادي",51,"د",2,1],["لمَّا طليقةُ جدّه وردت","لِقتاله يقتادها رجسُ",52,"س",1,0],["لما طوى الأرضَ لمصر أشرقت","بنوره كأنه وادي طوى",53,"و",2,0],["لما طما بك بحر كبرك لم تجد","يا غر معتقلاً سوى البهتان",54,"ن",1,0],["لَمّا طَلَعتَ عَلى سَمَندٍ سابِحٍ","في لَونِ حَليِ لِجامِهِ وَالمَركَبِ",55,"ب",1,0],["لم اطع حكم الهوى لكنما","لهوى الأوطان بالقلب احتكام",56,"م",1,0],["لما طلعت فكنت بدراً نيِّراً","لم تلتفت حتى رأينا كوثرا",57,"ر",2,0],["لما طغى كلب النصارى بطرهم","هُدّت بفضل جهاده أصنامه",58,"ه",1,1],["لمّا طغى الروم واستعلت بأكلبهم","قاد الجيوش وذاد الأكلب الكفره",59,"ر",2,0],["لم أطق ما أردت بي يا بن مروا","ن ستلقى إذا أردت أناسا",60,"س",2,0],["لَمَّا طَغَى بِحرُ النَصارى في الورى","وتلاطَمَت أمواجُهُ بِبَلاءِ",61,"ا",2,0],["لم أطلب الدين إلا عند حادثة","أزاد فيها رضاء الخالق الباري",62,"ر",2,0],["لمَّا طلعتَ على البلاد مسلِّماً","كادت تطيرُ بأهلها تسليما",63,"م",2,0],["لم أطبع الاشعار الا رحمة","فلقد جعلت بها هدى المتحير",64,"ر",1,0],["لم أطلب العلم للدنيا التي ابتغيت","من المناصب أو للجاه والمال",65,"ل",1,1],["لما طغوا ساكني جده","وصيروا لعبهم تجاره",66,"ه",1,1],["لما طغت في أكلها","عندي وزادت في السماجه",67,"ج",2,0],["لما طلعنَ علمتَ أَن","نكَ من جموعكُ في اغترَارِ",68,"ر",1,0],["لَما طالتِ البيْداءُ حينَ قصَدتُهُ","هَوىً لمسيري أو ضِراراً على إبلي",69,"ل",2,0],["لم أطق نشرها عداداً ولكن","كست الكون حلة الأشجان",70,"ن",1,0],["لمّا طَوى اللَهُ انتشارَ ظلامِهِم","أرمى بهم في ظُلمةِ الأَغلاسِ",71,"س",1,0],["لم أطق حبس دموعي","يوم ولى معرضا",72,"ض",2,0],["لما طوت صدورهم من غل","ولاختيار البعض حال الكل",73,"ل",1,0],["لَمْ أُطِلها وَكُلُّ غُصْنٍ قَصِيرٍ","لاَ يُعَنِّي مَنْ يَجْتَنِي الأثْمارَا",74,"ر",2,0],["لم أطو كشحا عن هواك وإنما","علق الفراق بأذيل الرفقاء",75,"ا",2,0],["لَم أَطِق حَصرَ ما حَوَيتَ مِن المَد","حِ وَمن ذا يَطيقُ للِشهبِ عدا",76,"د",2,0],["لمّا طلَعن علمتَ أَنك","من جُموعك في اغترارِ",77,"ر",1,0],["لَمّا طَوتِ السِرَّ عَن الأَغيار","وَالقَومُ رَموا إِليَّ بِالأَبصارِ",78,"ر",1,1],["لما طلعنا يعرجا","ودنت لنا فيه المنيّه",79,"ي",2,1],["لَما طَمِحَت عَيناكَ يَوماً لِغَيرِها","وَما كُنتَ يَو