{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[63,"بشراك قد ظفر الراعي بما ارتادا","https://www.aldiwan.net/poem46210.html","البسيط"],[51,"لم أطلها كما أطال رشاء","https://www.aldiwan.net/poem8149.html","الخفيف"],[91,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[85,"ملك السماء بهرت في الأنوار","https://www.aldiwan.net/poem63717.html","الكامل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[97,"يا للحبيب المفدى","https://www.aldiwan.net/poem24786.html","المجتث"],[97,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[44,"إحدى بني بكر بن عبد مناه","https://www.aldiwan.net/poem30327.html","الكامل"],[105,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[105,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[52,"وفتية لا يخوض الشك أنفسهم","https://www.aldiwan.net/poem27181.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"لما طوى الليل حواشي برده","https://www.aldiwan.net/poem63252.html","الرجز"],[50,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[50,"لما طلعن من الرقي","https://www.aldiwan.net/poem62366.html","مجزوء الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117019","البسيط"],[100,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[120,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[128,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[204,"ما تركت اللقاء يوم الفراق","https://www.aldiwan.net/poem53223.html","الخفيف"],[204,"يا مريضا قد أمرض","https://www.aldiwan.net/poem53246.html","مجزوء الخفيف"],[235,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[235,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[270,"الكون بالطيب والأنوار حياك","https://www.aldiwan.net/poem35436.html","البسيط"],[270,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[282,"جاءوا بجيشهم لقطع مياهنا","https://www.aldiwan.net/poem32896.html","الكامل"],[338,"لما طوتك الأربعون","https://www.aldiwan.net/poem68742.html","مجزوء الكامل"],[364,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[364,"أصون سمعك عن شكواي إجلالا","https://www.aldiwan.net/poem60797.html","البسيط"],[364,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[377,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[437,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[443,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[458,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[461,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[551,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[551,"لما طلعن علي في غسق","https://www.aldiwan.net/poem47773.html","أحذ الكامل"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[562,"لما طوت أنجلينا دار غربتها","https://www.aldiwan.net/poem52571.html","البسيط"],[567,"هل حاكم يعدي على ظبية","https://www.aldiwan.net/poem69552.html","السريع"],[586,"ومؤذن في حبه","https://www.aldiwan.net/poem17518.html","مجزوء الكامل"]],"verses":[["لَم أَطلُبِ المُثري البَخيلَ لِحاجَةٍ","أَبَداً وَأَقنَعُ بِالجَوادِ المُرمِلِ",0,"ل",1,0],["لمّا طوى الكَشْحَ منْ حِقْدٍ على إِحَنٍ","وظلَّ يَهْرِفُ إبْراقاً وإرْعادا",1,"د",2,0],["لم أُطِلها كما أطالَ رِشاءً","ماتحٌ ساء ظنُّه بقليبِ",2,"ب",1,1],["لَمّا طَلَعتَ عَلى الشُعاعِ مُوَزِّعاً","مُتَرَجرِجاً كَخَواطِرِ المُرتابِ",3,"ب",1,0],["لَمّا طَلَعتَ عَلى المِياهِ تُنيرُها","سَكَنَت وَقَد كانَت بِغَيرِ قَرارِ",4,"ر",1,0],["لَمّا طَغَوا وَبَغَوا جَهلاً عَبا لَهُم","حَرباً تُغِصُّهُمُ بِالبارِدِ الشَبِمِ",5,"م",1,0],["لمَّا طلعت عليه","وهَى وأنّ وسلَّم",6,"م",1,0],["لما طلعت على مشارفه","أيقنتُ أني فوق سُلَّمه",7,"ه",1,0],["لَمّا طَلَبتُ العَذبَ مِنها أَصبَحَت","قُلُبي بِها مَملوءَةً وَرِداهي",8,"ه",2,0],["لمّا طلعت على الأحداثِ تدفعُها","تكشّفَ العارضُ المُسودُّ وانْقشعا",9,"ع",2,0],["لمّا طلعتَ ومصرُ حائرةُ الخُطى","جَعلَ الهُدى قَدَماً لمصرَ وساقا",10,"ق",2,0],["لَمّا طَغى فِرعَونُ دَهري عاتِياً","شَقَّت عَصا شِعري بَنانَكَ أَبحُرا",11,"ر",2,0],["لَمّا طَفا النَجمُ في بَحرِ الدُجى وَصَلوا","حَبلَ السُرى بِذَميلٍ غَيرِ تَلبيثِ",12,"ث",1,0],["لَمْ أُطِلْ في تَعْدادِ مَدْحِكَ نُطْقي","ومُرادِي بذلك استقصاءُ",13,"ا",2,0],["لَمّا طَوى اللَيلُ حَواشي بُردِهِ","عَن واضِحِ اللَونِ نَقِيِّ وَردِهِ",14,"د",2,1],["لَما طَيَّبَ اللَهُ أَرواحَها","وَلا بَلَّ مِن عَظمِها الأَنحَلا",15,"ل",2,0],["لَمّا طَلَعنَ مِن الرَقي","قِ عَلَيَّ بِالبَرَدانِ خَمسا",16,"س",2,1],["لَما طَلَعنَ حَفَفنَها","وَأَصَخنَ ما يَهمِسنَ هَمسا",16,"س",2,0],["لما طَغى وجاوزَ الحُدودا","ونَقضَ الميثاقَ والعُهودا",17,"د",2,0],["لَم أطِق فيهِ حيلَةً غَيرَ أَنّي","مُذ قَضى نَحبَهُ أَلفتُ النَحيبا",18,"ب",2,0],["لما طلبتُ من الدنيا مراتبَها","ولا بذلتُ لها عرضي ولا ديني",19,"ي",1,0],["لمّا طلعت أفاقت \" الخضرا على","فجر بأنفاس الخلود معطّر",20,"ر",1,0],["لم أطع فيك واشياً يزرع الحقد","ويجني ثماره في الخلفاء",21,"ا",2,0],["لم أُطِلْ في شرحِ الغرامِ فخ","يرُ الوَصْفِ في علّة الغرامِ اختصارُه",22,"ر",2,0],["لم أُطِق أن أزيدَ قلبي على ما","فيه من لوعةٍ وحَرِّ اشتياقِ",23,"ق",1,0],["لم أُطِق أن أرى فراقك جهراً","وفِراقُ الحبيب غير مُطَاقِ",23,"ق",1,0],["لم أُطِق أن أراك يا","أحسنَ الناسِ مُدنَفا",24,"ف",2,0],["لَمّا طَما بَحرُ العِراقِ مُزَمجِراً","ثانِيَةً مُتَخَمِّطاً بِغُثائِهِ",25,"ا",3,0],["لَمّا طلَعتَ عَلى العَدُوِّ تَخاذَلَت","أَنصارُهُ وَتَواكَلَت أَجنادُهُ",26,"د",2,0],["لما طلعتِ على عرشِ الهوى سَحَراً","وخرَّ قلبي صَريعاً عندَ مرآك",27,"ك",1,0],["لما طلعتَ عليّ في ليلِ الأسى","أعرَضتُ عن يأسي لحسنِ رَجائي",28,"ا",2,0],["لَمّا طَعَنّا بِالرِماحِ صُدورَهُم","وَلَّوا ظُهورَهُمُ فَجاءَ الماءُ",29,"ا",2,0],["لَمّا طَوَتكَ الأَربَعو","نَ وَآنَ لِلعُمرِ اِنقِراضُ",30,"ض",1,1],["لمّا طرقْتُ الحيَّ قالتْ خِيفةً","لا أنتَ إن عَلِمَ الغَيورُ ولا أنا",31,"ن",2,0],["لمَّا طَرَقْتُهمُ مُستَبضِعاً أَدَباً","وأين مَن كان يَقْرى الفَضْلَ أفضالا",32,"ل",2,0],["لمّا طَويْتُ أنا البعادَ نَشَرْتُمُ","ذَرْعاً لبُرْدِ المَهْمَهِ المَذْروع",33,"ع",1,0],["لماطغى إبليس وهو مخيّرٌ","ألقاه مولاه وساء بما فعل",34,"ل",1,0],["لما طاب سكنى طيبة ولقد بنا","بجنيب النبي المصطفى ذلك اللحد",35,"د",1,0],["لم أطع للسُلُوّ حكما ولكن","ساقني ظلمُها ونقصُ وفاها",36,"ا",3,0],["لما طَلعتَ البدرَ من ثَنِيَّةٍ","تُجلَى بها عينٌ وعَينٌ تَرمَدُ",37,"د",1,0],["لما طمحْتُ إِلى عيشٍ أرمَّقُهُ","أعُبُّهُ تارةً عبّاً وأرتشفُ",38,"ف",1,0],["لمّا طلعتُ بصدق العزمِ مشتملاً","رأى الكماة بوجهي مالئ المُقَلِ",39,"ل",1,0],["لمّا طَلَعنَ عَليَّ في غَسَقٍ","فَخَلَفْنَ ضوءَ الشّمسِ والقمرِ",40,"ر",1,1],["لما طلبت الصبر عنكم في الهوى","ألفيت أحشائي بذاك شحاحا",41,"ح",2,0],["لمَّا طَوَت أنجَلينا دارُ غُربتها","أجرَتْ دُموعَ بني التيَّانِ كالمَطَرِ",42,"ر",1,1],["لَمْ أُطِعِ العُذَّالَ فِيْهَا وَقَدْ","أَصْغَتْ إِلَى أَقْوَالِ عُذَّالِهَا",43,"ل",3,0],["لَمّا طَلَبْتُ وِصَالَهُ","أَضْحَى عَليَّ يُكَبِّرُ",44,"ر",1,0]]}