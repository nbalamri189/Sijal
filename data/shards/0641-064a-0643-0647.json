{"poems":[[95,"ألعرق الذوقي أشهى الطلا","https://www.aldiwan.net/poem11352.html","السريع"],[287,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44995","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203698","الخفيف"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11321","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"]],"verses":[["فِي كَهْفِ جُبْرَانَ وَجُبْرَانُ مَنْ","يَعْدُو لَهُ جَوْداً وَإِقْدَاما",0,"م",2,0],["فيكَ هَزَّ المَدحُ أَعطافَ العُلى","فَاِشرَأَبَّت لِكَريمٍ أَريَحِيِّ",1,"ي",1,0],["في كُهولَ إِذا اِستَقَرَّت حَمي","ا الكَأسِ لَم يَنطِقوا بِغَيرِ الصَوابِ",2,"ب",1,0],["في كهوف الذئبان ترجو ملاذاً","لبنيها، من الطغاة الذئاب",3,"ب",1,0],["في كهولٍ إذا استدرّت حميا الك","أسِ لم ينطقوا بغيرِ الصوابِ",4,"ب",1,0],["فيك همس قال لطفا مذ جرى","فاقد الاذان",5,"ن",1,0]]}