w.poetsgate.com/ViewPoem.aspx?id=206177",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5848,"جرحي المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=53379",""],[5992,"كأنَّ بروقَ الجوّ في حجراتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=41847",""],[6125,"أنيخي الركبَ في كنفي أنيخي","https://www.poetsgate.com/ViewPoem.aspx?id=210907",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""],[6152,"صباحكِ خير","https://www.poetsgate.com/ViewPoem.aspx?id=203690",""],[6225,"الحج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81096&r=&rc=290",""],[5616,"أننسى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1925&r=&rc=0",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["كَأَنَّ الناسَ بَعدَكَ في ظَلامٍ","أَوِ الأَيّامَ أُلبِسَتِ الحِدادا",0,"د",2,0],["كأنّ النّقْعَ إذْ أرْخى سُدولاً","علَيهِمْ قَبْلَ مَهْلِكِهِمْ حِدادُ",1,"د",1,0],["كَأَنَّ النَّجُومَ الزُّهْرَ أَعْشَارُ سُورَةٍ","وِمِنْ خَطَرَاتِ الرَّجْمِ أَثْنَاءَهَا مَطُّ",2,"ط",1,0],["كَأَنَّ النسرَ حينَ رَأَى وُرودَ ال","نَعائِمِ طارَ عَن كَفِّ الخَضيبِ",3,"ب",1,0],["كَأَنَّ النَوى إِذ نادَتِ الدَمعَ رَخَّمَت","فَلا أَثَرٌ فيها أَجابَ لِعَينِ",4,"ن",1,0],["كَأَنَّ الناسَ حينَ تَمُرُّ حَتّى","عَواتِقَ لَم تَكُن تَدَعُ الحِجالا",5,"ل",2,0],["كَأَنَّ النَدى الشَتوِيَّ يَرفَضُّ ماؤُهُ","عَلى أَشنَبِ الأَنيابِ مُتَّسِقِ الثَغرِ",6,"ر",1,0],["كأن النسيم الطلق بين جنانه","غناء حبيب يطرب النفس جرسه",7,"س",2,0],["كَأَنَّ النِساءَ الآسِراتِ حَنَينَني","عَريشاً فَمَشيِي في الرِجالِ دَبيبُ",8,"ب",1,0],["كأن النجومَ الزّهرَ في كبد الدّجى","شرارُ لظًى من ذهنه المتوقد",9,"د",1,0],["كأن النجوم المائلاتِ بأفقه","مفارقُ شيبٍ لا تسرّ ولا تسري",10,"ر",2,0],["كان النعي يثير في الأرواح","حزنا عميقا ما له من ماح",11,"ح",1,1],["كأن الناس في دين جديد","على جنباته استبقوا الصلاحا",12,"ح",2,0],["كانَ النَدامى إِن شَدَوتَ وَعاقَروا","سِيّانَ صَوتُكَ بَينَهُم وَالراحُ",13,"ح",1,0],["كَأَنَّ النَحسَ حينَ جَرى عَلَيهِم","أَطارَ بِكُلِّ مَملَكَةٍ غُرابا",14,"ب",2,0],["كَأَنَّ النُسورَ الواقِعاتِ عَشِيَّةً","عَلى نَقَدٍ حَولَ الجِمارِ مُذَبَّحِ",15,"ح",1,0],["كَأَنَّ النُجومَ المُستَسِرّاتِ في الدُجى","سِكاكُ دِلاصٍ أَو عُيونُ جَرادِ",16,"د",1,0],["كَأَنَّ النُجومَ الزُهرَ أَدَّتهُ خالِصاً","لِزُهرَةِ صُبحٍ قَد تَعَلَّت وَمُشتَري",17,"ر",2,0],["كَأَنَّ النَوى يَكذِبنَهُ نَحبُ ناذِرٍ","يُقَضّينَ مِنهُ أَو أَلِيَّةُ حالِفِ",18,"ف",1,0],["كَأَنَّ النَجمَ وَالجَوزاءَ يَسري","عَلى آثارِ صادِرَةٍ أَوامِ",19,"م",1,0],["كانَ النَبِيُّ وَلَم يَخلُد لِأُمَّتِهِ","لَو خَلَّدَ اللَهُ خَلقاً قَبلَهُ خَلَدا",20,"د",2,0],["كانَ النَبِيُّ فَلَم يَخلُد لِأُمَّتِهِ","لَو خَلَّدَ اللَهُ حَيّاً قَبلَهُ خَلَدا",21,"د",2,0],["كانَ النَديمَ فَلَم أَنَل","مِن قُربِهِ غَيرَ النَدامَه",22,"م",2,0],["كَأَنَّ النِعاجَ الغُرَّ وَسطَ رِحالِهِم","إِذا اِستَجمَعَت وَسطَ الخُدورِ مَطافِلُه",23,"ل",2,0],["كَأَنَّ النَدامى حينَ كَظّوا بِشُربِهِ","مَحارِبُ وَرَّقينَ قَد مُلِأَت حِبرا",24,"ر",2,0],["كَأَنَّ النارَ في ذَيلي","وَفي جَيبي وَأَرداني",25,"ن",2,0],["كَأَنَّ الناسَ حينَ نَغيبُ عَنهُم","نَباتُ الأَرضِ أَخلَفَها القِطارُ",26,"ر",1,0],["كَأَنَّ النَّدَى فَوْقَ الشَّقيقِ مَدَامِعٌ","تَجُولُ بِخَدٍّ أَوْ جُمَانٌ عَلَى تِبْرِ",27,"ر",1,0],["كَأَنَّ النِّقْسَ فَوْقَ الطْرسَ غَيْثٌ","أَعَارَ الأَرْضَ ثَوْباً مِنْ رُوَاءِ",28,"ا",2,0],["كأن النَّازِليهِ نُزُولُ سجنٍ","وأين مَضَوا فَحَوْلَهُمُو حِصَار!",29,"ر",1,0],["كأنَّ النِّعَاجَ الغُرَّ وسْطَ رِحَالِهِم","إذا استعجمتْ وسط الخدور مطافلهْ",30,"ل",2,0],["كأنّ النجوم على صدره","جراح يلوح عليها الدم",31,"م",1,0],["كأن النجم إذا ولى سحيرا","فصال جلن في يوم مطير",32,"ر",1,0],["كَأنّ النّساءِ الآسراتِ حَنَيْنَني","عريشاً فمشي في الرجالِ دبيبُ",33,"ب",1,0],["كأنَّ النصرَ أضحكَها ثُغورا","فللأيامِ عنهنَّ ابتسامُ",34,"م",1,0],["كَأَنَّ النَعامَ باضَ فَوقَ رُؤوسِهِم","بِنَهيِ القِذافِ أَو بِنَهيٍ مُخَفِّقِ",35,"ق",1,1],["كَأَنَّ النارَ تُخرِجُها ثِيابي","وَتَدخُلُ بِعدَ نَومِ الناسِ صَدري",36,"ر",2,0],["كَأنَّ النَّارَ مُضرَمةٌ بِقلبي","وفي عَيني بَالِيَةُ المَزَادِ",37,"د",1,0],["كَأَنَّ النَوى قَد ضَمَّ مِن بَعدِ فُرقَةٍ","بِها خَدَّ مَعشوقٍ إِلى خَدِّ عاشِقِ",38,"ق",1,0],["كانَ النبيُّ بهِ أجلَّ سموحِ","مِن غيرِ إِسرافٍ ولا تسريحِ",39,"ح",1,0],["كأنَّ الناسَ ليسَ لهم قلوبٌ","تحركهنَّ أنفاسُ الحزينِ",40,"ن",1,0],["كَأَنَّ النُجومَ الضَئيلَة في الأُفقِ","رَشحُ خُمورٍ عَلى خابيه",41,"ي",2,0],["كَأَنَّ النجومَ زَفيرُ خَطايا","تُصَعِّدُهُ لَيلَةٌ زانِيَه",41,"ي",2,0],["كانَ النَدى يَطفو عَل","ى آمالِهِ وَعَلى صِباه",42,"ا",2,0],["كأنّ الندى فيه مدامعُ عاشقٍ","أريقت غداةَ البينِ في خدّ معشوقِهْ",43,"ق",2,0],["كأنّ النَّدَى فوقَ أغصانه","إذا أسفرَ الصُّبْح دُرٌّ نَثير",44,"ر",1,0],["كأنّ الندى فوق الشقائق جائلاً","دموعٌ أرِيقت في الخدود على النحر",45,"ر",1,0],["كأنَّ النجومَ في أديمِ سمائِها","سَفائِنُ فَوضَى سابحاتٌ على النهر",46,"ر",1,0],["كأَنَّ النجومَ الزُهرَ عيسٌ نوافرٌ","كأَنَّ الدجى ركبٌ من الزِنج قافِلُ",47,"ل",1,0],["كان النبوغُ قَبْلَها","حملاً ببطنِ الكتب",48,"ب",1,0],["كأن النجوم السائرات توقفت","عن السير حتى ما بلغن المقاصدا",49,"د",2,0],["كَأَنّ النَدى كنز وَلَيسَ عَلى سوى","يَديهِ لَهُ بَين الأَنام ظُهورُ",50,"ر",1,0],["كَأَنّ النُجوم الزُهر زهر حَدائقٍ","أَو القفر لاحَت لِلسُراة حباحبُه",51,"ب",2,0],["كان النّوى تَكْفِي فكيف بها إذا","جمَع الزّمانُ لنا نوىً ونوائبا",52,"ب",2,0],["كأن الندى طافَ بين الوَرى","لينزلَ حيثُ ينالُ اختِيارَه",53,"ر",2,0],["كَأَنَّ النَبلَ بَينَهُم جَرادٌ","تُكَفّيهِ شَآمِيَةٌ خَريقُ",54,"ق",1,0],["كانَ النَبِيُّ مَدينَةَ العِلمِ الَّتي","حَوَت الكَمال وَكنتَ أَفضلَ باب",55,"ب",1,0],["كأنَّ النّوى لَم تخْتَرِم غيرَ شَملِه","ولم يَجْرِ إلاّ بالّذي ساءَه القَدْرُ",56,"ر",1,0],["كانَ النسيبُ شقيقَ روحي والهوى","في مهجتي وقراره بجنابي",57,"ي",1,0],["كَأَنَّ النجومَ الزُّهْرَ حَفَّتْ بوجْهِهِ","فأَدَّتْهُ محروساً إِلَى قَمَرِ السَّما",58,"م",2,0],["كأن النائحات مصرّعات","على آثاره صرعى مدام",59,"م",1,0],["كأنّ الندى دينٌ له كلّما انقضت","فرائضُه عنه تلتها نوافلُهْ",60,"ل",2,0],["كأنَّ النوى والهجرَ قد خُلِقا لهُ","اِذا زالَ ذا عنه فذا لا يُزايلُه",61,"ل",2,0],["كَأَنَّ النَوى لَم تَكُن أَصقَبَت","وَلَم تَأتِ قَومَ أَديمٍ حُلولا",62,"ل",2,0],["كان النبي نبياً في الغيوب به","وآدم النفخ بين الماء والطين",63,"ن",1,0],["كَأَنَّ النَّرْجِسَ البَرِّيَّ فِيْهِ","مَدَاهِنُ مِنْ لُجَيْنٍ لِلْخَلُوقِ",64,"ق",1,0],["كأن الناس حولك حين قاموا","وفود نداك أيام الصلات",65,"ت",1,0],["كان الندى في شهور الحول مُقْتَسَماً","بين البرية فاغتال الندى صَفَرُ",66,"ر",1,0],["كانَ النبيّ إذا رآ","هُ إليهِ أدناه وضمّه",67,"م",2,0],["كان النجوم الزهر زهري خوخه","ولم ار مثلي شبه الزُّهر بالزَّهر",68,"ر",1,0],["كان النبيُّ بوحيِ اللهِ مُنذِرَها","وكان ذا بعدَه لا شكّ هادِيها",69,"ه",2,0],["كأنَّ النبات الغضّ يغشى صعيدها","حقولٌ من الفيروز ومنبتهُ الشَذرُ",70,"ر",1,0],["كأنّ النخيلَ الباسقاتِ إلى العُلا","عذارى حجال رجّلت لمماً شُقرا",71,"ر",2,0],["كأنَّ الناسَ كلَّهم لأُمٍّ","ونحن لعِلَّةٍ عَلت ارتفاعا",72,"ع",2,0],["كأنَّ الناس طفل وهو ثدي","لمرضعة غزير في المحبسِ",73,"س",1,0],["كان النبي مكثراً للصوم في","شعبان إذ رمضان قافٍ فاءِ",74,"ا",2,0],["كأن الندى عفراء وهو لحبِّهِ","إذا ليم فيه عروة بن حَزامِ",75,"م",1,0],["كان الندى مستوحشا حتى رأى","من بذلك المعروف أحسن مؤنس",76,"س",1,0],["كَأنَّ النُّجُومَ خِلاَلَ الدُّجَى","مَشيبٌ بِفَوْدٍ أضَا وَانْتَشَرْ",77,"ر",1,1],["كَأنَّ النَّدَى إذْ كَلَّلَ الوَرْدَ دُرهُ","دُمُوع التَّصَابِي في خُدُودِ الكَوَاعِبِ",78,"ب",1,0],["كَأنَّ النُّجُومَ الزهْرَ في لَيْلِ دَجْنِهَا","قَلاَئِدُ دُرّ كَلَّلَتْ مُسْحَ رَاهِبِ",78,"ب",1,0],["كأنّ النجوم مصابيح رتب","تلألأن ثحثجة واِضطرابا",79,"ب",2,0],["كَأَنَّ النارَ إِذا شُبَّت لِلَيلى","أَضاءَت جيدَ مغزِلَةٍ نَوارِ",80,"ر",1,0],["كَأَنَّ الناسَ جِسمٌ وَه","وَمِنهُ مَوضِعُ القَلبِ",81,"ب",1,0],["كان الناس في الدنيا","كلامٌ أنت معناهُ",82,"ا",2,0],["كأنّ النَّوى حَتمٌ علينا مُقدَّرٌ","فما ينقضى ممَّن نُحبُّ رحيلُ",83,"ل",1,0],["كأن النوم يعملةٌ شرودٌ","من الأجفان ضلت عن هداها",84,"ا",3,0],["كأنَّ الندامى على شربِها","بدورُ دُجىً تتعاطى شموسا",85,"س",2,0],["كَأنَّ النّاسَ كُلَّهُمُ قُشورٌ","ومَوْلانا عَلِيٌّ كَاللُّبابِ",86,"ب",1,0],["كأن النجم معترضاً وشاة","تسارق فيه لحظاً مسترابا",87,"ب",2,0],["كَ