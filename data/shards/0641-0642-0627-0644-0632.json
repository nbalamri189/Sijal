{"poems":[[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66672","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21298","الطويل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124015","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83571","البسيط"],[4927,"لَغْطُ النَّاْصِحِيْن","https://www.poetsgate.com/ViewPoem.aspx?id=29836",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""]],"verses":[["فَقالَ زوجي طالقُ","وَخدمي عتائقُ",0,"ق",1,0],["فقال زيد إذ أتاه ما أنا","ذاكره عنهم بترتم أمرنا",1,"ن",2,0],["فقال زعيمُ القومِ ما فيه مطلبٌ","ولم يُظفرِ الرحمنُ منهم بهِ يدا",2,"د",2,0],["فَقالَ زدني لَيسَ هَذا يَكفي","إِنَّ العَليل دائِماً يَستَشفي",3,"ي",1,0],["فَقال زيادٌ لا يُرَوِّعُ جارُهُ","وَجارةُ جارِي مثلُ جلدي وَأَقرَبُ",4,"ب",1,0],["فقال زعيم القوم أصبحت راضياً","بما كان في أمر القدير مقدرا",5,"ر",2,0],["فَقالَ زُرنا وَحُجَّ البَيتَ في صِلَةٍ","يا طالَما قَد وَصَلت العام أَرحاما",6,"م",2,0],["فَقَاْلَ \\\" زَكِيْ الدَّبُوْر \\\": حَاْذِرْ غَرَاْمَهَاْ","وَإِلاَّ سَتَحْكِيْ فِيْ هَوَاْكَ الْمَنَاْبِرُ",7,"ر",1,0],["فقال زماني قد رماني بظلمه","وأنتِ بهذا مِنْ زمانيَ أ ظْلَمُ",8,"م",1,0]]}