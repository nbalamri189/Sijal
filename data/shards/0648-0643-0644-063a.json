{"poems":[[55,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[55,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[55,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[65,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[3,"ذنبي لعبلة ذنب غير مغتفر","https://www.aldiwan.net/poem162.html",""],[74,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[34,"ألا يا غراب البين فيم تصيح","https://www.aldiwan.net/poem27761.html","الطويل"],[87,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[63,"ينافسني في الشعر والشعر كاسد","https://www.aldiwan.net/poem51701.html","الطويل"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[68,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[48,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[96,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[173,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[190,"وكل غلام فيه تيه ونخوة","https://www.aldiwan.net/poem43877.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[197,"وكل غنى يتيه به غني","https://www.aldiwan.net/poem13117.html","الوافر"],[214,"طلائعنا بالبشر والسعد تطلع","https://www.aldiwan.net/poem13455.html","الطويل"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[254,"عفا رسم برامة فالتلاع","https://www.aldiwan.net/poem2111.html","الوافر"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[354,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[415,"أأحبابنا من غاب عمن يوده","https://www.aldiwan.net/poem32512.html","الطويل"],[445,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[447,"وداعا وحسبي الله يا عرفات","https://www.aldiwan.net/poem14298.html","الطويل"],[447,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[463,"إذا رضيت رباك عن الربيع","https://www.aldiwan.net/poem56133.html","الوافر"],[466,"إذا نعمة الإنسان لم تك قربة","https://www.aldiwan.net/poem16073.html","الطويل"],[469,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[475,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177918","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108985","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69335","الطويل"],[1973,"","https://poetry.dctabudhabi.ae/diwan/poem/145493","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31689","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62768","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102403","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133124","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139548",""],[4903,"أوَاجدَةٌ وَجدي حَمامةُ أيكةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=96546",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5213,"أملت انشي التهاني فيك والغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=170521",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5493,"شَفْشاوُن سليلة الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=200238",""],[5690,"يا روضة العلم يامن في حديقتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172221",""],[5909,"وصالٌ وفي الحالين ضربٌ من العنا","https://www.poetsgate.com/ViewPoem.aspx?id=209186",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[6115,"اذا صار للمعنى جزاله وفن وذوق","https://www.poetsgate.com/ViewPoem.aspx?id=180494",""],[5309,"طوينا رحاب الأرض كي ندرك المنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573582",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["وَكُلُّ غُلامٍ خالَطَ البَأسُ قَلبَهُ","يُقَطَّعُ أَقرانَ الأُمورِ الغَواشِمِ",0,"م",1,0],["وَكُلُّ غَضَنيٍّ إِذا قُلتُ قَد وَنى","مِنَ الشَدِّ جَلّى في الغُبارِ وَجالا",1,"ل",2,0],["وَكُلُّ غُلامٍ مِلءُ دِرعَيهِ نَجدَةٌ","وَلَوثَةُ أَعرابيَّةٍ وَتَغَطرُفُ",2,"ف",1,0],["وَكُلُّ غُلامٍ مِنهُمُ شامَ سَيفَهُ","رَأى فيهِ وَجهَ الحَقِّ طَلقَ المَناظِرِ",3,"ر",1,0],["وَكُلِّ غُلامٍ حَيِيِّ اللِحاظِ","يَلقى الطِعانَ بِرُمحٍ وَقاحِ",4,"ح",1,0],["وَكُلُّ غُلامٍ ذي جِلادٍ وَنَجدَةٍ","وَكُلُّ جَوادٍ ذي هِباتٍ وَمَيعَةِ",5,"ه",1,0],["وكُلُّ غُلامٍ عامريٍّ إذا سَما","إِلى القِرْنِ لمْ يحْفِلْ صِياحَ المُهَجْهِجِ",6,"ج",1,0],["وَكُلُّ غُصنٍ قَويمٍ راقَ مَنظَرُهُ","ما حَظُّ عاشِقَها مِنهُ سِوى النَظَرِ",7,"ر",1,0],["وكلّ غمام غير جودك مقلعٌ","وكلّ وميض غير برقكَ خلّب",8,"ب",1,0],["وكلُّ غصنٍ يروقُ منظرُهُ","يُعْقَبُ من مجتناهُ محتطبُهْ",9,"ب",2,0],["وكل غِنىً في ظل غيركَ تافهٌ","ولو أنني كِسرى وداريَ إصْطَخر",10,"ر",1,0],["وَكُلُّ غَداةٍ لا أَبا لَكِ تَنتَحي","إِلَيَّ فَتَلقاني وَأَنتَ مُشيحُ",11,"ح",1,0],["وكل غصن مائل","بالثلج أو مقوّم",12,"م",1,0],["وَكُلُّ غُرمولِ بَغلٍ","يَرَينَ يَحسُدنَ قُنبَه",13,"ب",2,0],["وكلُّ غَبيٍّ لو يُباشِرُ بَرْدُهُ","لظَى النَّارِ أضحَى حرَّها وهو بارِدُ",14,"د",1,0],["وَكُلِّ غُرَيرِيٍّ كَأَنَّ فُروجَهُ","إِذا رَفَّعَت مِنهُ فُروجُ حِصانِ",15,"ن",1,0],["وَكُلُّ غَضَنفَرٍ لِلبُؤسِ كامٍ","شَبيهِ السَيفِ فيهِ المَوتُ كامِن",16,"ن",1,0],["وكل غادٍ له نصيب","من مائك البارد الشبم",17,"م",1,0],["وَكُلَّ غَنِيٍّ يَسلُبانِ مِنَ الغِنى","وَكُلَّ كَمِيٍّ عَن جَوادٍ يَحُطّانِ",18,"ن",1,0],["وكل غرام قارن الشيب سوءة","وكل غرير في المشيب غرور",19,"ر",1,0],["وكلّ غمام مرّ في الرّمل ديمة","وكلّ كنّاس للظباء مديم",20,"م",1,0],["وَكُلُّ غَمامٍ لَم تُثِر غادِياتِهِ","رِياحُ نَدى كَفَّيكَ فَهوَ جَهامُ",21,"م",1,0],["وكلّ غلام فيه تيه ونخوةٌ","يلين إذا ما حل يوما بعكبرا",22,"ر",2,1],["وَكلٌّ غَدا في الناسِ حرّاً بزعمهِ","وَهل تركَ القهّارُ مِن خلقهِ حُرّا",23,"ر",2,0],["وَكُلُّ غِنىً يَتيهُ بِهِ غَنيُّ","فَمُرتَجَعٌ بِمَوتٍ أَو زَوالِ",24,"ل",1,1],["وكل غدا يبغي النجاة لنفسه","هزيما فلا يلوي ولا القول يسمع",25,"ع",1,0],["وَكُلُّ غَريبٍ حينَ تَأتينَ يَحضُرُ","أُحِبُّكِ وَالدُنيا طَنين بِمَسمَعي",26,"ي",1,0],["وَكُلُّ غَضارَةٍ لَكَ مِن حَبيبٍ","لَها بِكَ أَو لَهَوتَ بِهِ مَتاعُ",27,"ع",1,0],["وكُلِّ غَارِبَةٍ إِجْحَافُ نائِبَةٍ","تَثْنِي الأَمَانَ حِذاراً والسرُور أَسَى",28,"س",2,0],["وَكُلُّ غُصنٍ بِكُلِّ فاكِهَةٍ","دانٍ لِجاني الثِّمارِ مَهصُورِ",29,"ر",1,0],["وَكُلُّ غَنِيٍّ بِالكُنوزِ فَظاهِرٌ","إِلى ما بِهِ اِستَغنى عَلَيهِ بَدا الفَقرُ",30,"ر",1,0],["وكلُّ غريبِ الدّارِ فالأَرضُ دونَهُ","وإِن كان حيّاً فالحِمامُ اغتِرابُهُ",31,"ب",2,0],["وكُلَّ غَريقٍ فِي الحديدِ كَأَنَّما","تَسَرْبَلَ من غَزْلِ الغزالَةِ واعْتَمَّا",32,"م",2,0],["وكل غراب بالتفرق ناعق","وكل نعيم بعده أزمات",33,"ت",1,0],["وكل غيره ميت مميت","ومجتمع فمفترق شتيت",34,"ت",1,0],["وكلُّ غلامٍ له حكمُه","على الناس راضين أو كارهينا",35,"ن",2,0],["وكلّ غلامٍ وراء اللثا","م من وجهه القمرُ الكاملُ",36,"ل",1,0],["وكلّ غريبة الأبوين بكر","رَداحٍ شرطَ سمعك أو شَموعِ",37,"ع",1,0],["وكلُّ غِنىً لم يُستفدْ بوجودهِ","رِضى اللّهِ والعَلْياءَ فهو عَناءُ",38,"ا",2,0],["وكل غيرانَ أغار القرى","في دوره فاغتال حمر اللقاحْ",39,"ح",1,0],["وَكُلُّ غَنيٍّ قانِعٌ بِفَعالِهِ","وَكُلُّ عَزيزٍ عِندَهُ مُتواضِعُ",40,"ع",1,0],["وكلُّ غُصن قد نشا وانتشى","مُنذ تربّى في مُهود المِهاد",41,"د",1,0],["وكل غدير كان يخطر هادرا","ليخطر في ما قد نوى الدهر من غدري",42,"ر",2,0],["وكل غانيةٍ تبكي وقولتها","يا ليت إنسان عيني كان مأواها",43,"ا",3,0],["وَكُلُّ غَمامٍ غَيرِ كَفِّكَ مُخلِفٌ","وَكُلُّ مَديحٍ غَيرِ مَدحِكَ بُهتانُ",44,"ن",1,0],["وكلُّ غريبِ الدارِ يدعو همومَهُ","غرائبَ محسوداً عليها شجونها",45,"ن",3,0],["وكل غيهب ظلم قد بدا فإذا","امعنت فكرا تجده غير منكتم",46,"م",1,0],["وكُلُّ غازٍ إِذا جُلَّتْ غَنيمَتُهُ","فَإِنَّ آَثَرَ شَيْءٍ عِنْدَهُ القَفَلُ",47,"ل",1,0],["وكلُّ غُلامٍ يحسَبُ الموتَ مَغْنَماً","يَخافُ عليهِ الفوتَ إنْ لم يُزاحِمِ",48,"م",1,0],["وكلُّ غداة تنتحي لك تنتحي","إليَّ فتلقاني وأنت مشيحُ",49,"ح",1,0],["وكل غال لديهم صار مرتخصا","فالكل بالنفس والأموال قد جادا",50,"د",2,0],["وكلَّ غيورٍ لا يزال يروعُهُ","تنسُّمُ روضٍ أو ترنُّم وَرْقاءِ",51,"ا",2,0],["وكل غني دينه البخل والغنا","وكل فقيرٍ همه اللبس والسرط",52,"ط",1,0],["وكلُّ غنىً لدى الدنيا ففقرٌ","وكل تبسُّمٍ فيها نحيب",53,"ب",1,0],["وكلّ غَريب الدارِ يدعُو همومه","غَرَائِبَ مَحسُودٌ عليَهَا شُجُونهَا",54,"ن",3,0],["وكل غريب إن أتاها تحيطه","بأنس فما يشكو بأحضانها غَرْبا",55,"ب",2,0],["وَكُلٌّ غَدَا فِي شُربِهِ حَسْبَ شِربِهِ","وَأَنْهَى لَذَاذَاتِ النُّهَى فِي الهَوَى الثَّمْلُ",56,"ل",1,0],["وكل غيران قذاف بمهجته","سيان يقتل في الهيجاء او قتلا",57,"ل",2,0],["وكل غدا يلقى الذي هو أهله","إذا ما أتى عرض لمولاه أو نكرا",58,"ر",2,0],["وكلّ غراب للرذيلة مطلقٌ","ويُتحفه الوالي بحزب مؤسس",59,"س",1,0],["وكلّ غافٍ أميرٌ ها هنا نزفتْ","ذكراهُ لما رأى للمشتهى شبهًا",60,"ه",2,0],["وكل غصنٍ زوى يروي بمنهلهِ","لذاك وافى إليه أرز لبنانِ",61,"ن",1,0],["وكلُ غرامٍ بعض ما أنت حاملٌ","وبعضُ اشتياقٍ دافعٌ بيَ للفنا",62,"ن",2,0],["وَ كُلُّ غَدُوْرٍ - دُونَها - لَيْسَ عِنْدَنَا","لَهُ غَيْرُ أَسْيَافِ النِّضَالِ بِهَا الخَزْقُ",63,"ق",1,0],["وكلٍ غدا يفتل وينقض ويرمي فوق","وعن هافي الاهداف يعليه ويزمّه",64,"م",2,0],["وَكُلُّ غَريبٍ لِلغريبِ نَسيب","وَمَرَّت بِنا شَتَّى اللَّيالي كَأَنَّنا",65,"ن",2,0],["وكل غصن بعصف الريح ممتحن","كأنه عاقل مبلى بمجنون",66,"ن",1,0]]}