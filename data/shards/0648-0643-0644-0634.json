كر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[563,"كواكب جرت من السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56280&r=&rc=10",""],[6225,"صمود لبنان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80972&r=&rc=241",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[2220,"إذا يضيق بنا أمر ليزعجنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11253&r=&rc=127",""],[5126,"الحياة صغرى وكبرى!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87821&r=&rc=36",""]],"verses":[["وَكلُّ شَيءٍ سِوى مُفارَقِة ال","أَحبابِ مُستَصَغَرٌ وَإِن فَجَعا",0,"ع",2,0],["وكُلُّ شَهيرِ العِتْقِ أشْرَفَ جيدُهُ","وقامَ على مَلْمومَةٍ منْ زَبَرْجَدِ",1,"د",1,0],["وكلُّ شاهينٍ شهيِّ المرتمى","كبارقٍ طار وصوب قد همى",2,"م",2,0],["وكلُّ شعبةِ أصلٍ مثمرٍ عَقُمت","فليس تُعتدُّ إلا أرذلَ الشُّعبِ",3,"ب",1,0],["وكل شعب على الاوعاد معتمد","فحظه في عراك الدهر خذلان",4,"ن",1,0],["وكل شاعر قديم ال","عصر أو مخضرم",5,"م",1,0],["وكلَّ شئ بذلا","حتى أتم الرجلا",6,"ل",2,0],["وَكُلُّ شَيءٍ سَرَّني","تَذهَبُ فيهِ مَذهَبي",7,"ب",2,0],["وَكُلُّ شَبابٍ أَو مَشيبٍ رَهينَةٌ","بِمُعتَرِضٍ مِن حادِثِ الدَهرِ مُغتالِ",8,"ل",1,0],["وَكُلُّ شَريكٍ في السُرورِ بِمُصبَحي","أَرى بَعدَهُ مَن لا يَرى مِثلَهُ بَعدي",9,"د",2,0],["وَكُلُّ شَواةِ غِطريفٍ تَمَنّى","لِسَيرِكَ أَنَّ مَفرِقَها السَبيلُ",10,"ل",1,0],["وَكُلُّ شَجاعَةٍ في المَرءِ تُغني","وَلا مِثلَ الشَجاعَةِ في الحَكيمِ",11,"م",1,0],["وَكُلُّ شَيءٍ فَقَدتَ يَوماً","وَاِعتَضتَ عَنهُ نَسيتَ فَقدَه",12,"د",2,0],["وَكُلُّ شَيءٍ مِنَ الدُنيا فَمُنتَقِصٌ","وَكُلُّ عَيشٍ مِنَ الدُنيا فَمَملولُ",13,"ل",1,0],["وَكُلُّ شَيءٍ فَإِلى زَوالِ","يا عَجَباً مِنّي بِما اشتِغالي",14,"ل",2,0],["وَكُلُّ شُجَاعٍ سَيفُهُ حَاسِدٌ لَهُ","وَعاشِقُ هَامٍ فَهوَ مِن ذَينِ ناحِلُ",15,"ل",1,0],["وَكُلُّ شَوهاءَ طَوعٍ غَيرِ آبِيَةٍ","عِندَ الصَباحِ إِذا هَمّوا بِإِلجامِ",16,"م",1,0],["وَكلُّ شيءٍ سَمِعْنا مِنْ مناقِبِهِمْ","فمِنْ مَناقِبِ عِزِّ الدِّينِ مُخْتَصَرُ",17,"ر",1,0],["وَكل شمس لها جرم بنسبته","يَجري الأثير إِلَيها فَهي تَستَعر",18,"ر",1,0],["وكلُّ شبابٍ أو جَدِيدٍ إلى بِلىً","وكُلُّ امرِىءٍ يَوْماً إلى اللّهِ صائِرُ",19,"ر",1,0],["وَكُلُّ شَيءٍ لَهُ بَدْءٌ وَعَاقِبَةٌ","وَكَيْفَ يَبْقَى عَلَى حِدْثَانِهِ الزَّمَنُ",20,"ن",1,0],["وَكُلُّ شَعْبٍ كَاسرٍ قيُودَهُ","بِالْحَقِّ مَا اعْتَدَى وَلاَ تَعَدَّى",21,"د",2,0],["وكل شباب أو جديد غلى بلى","وكل امرىء يوماً إلى الله صائرُ",22,"ر",1,0],["وكلّ شُجاعٍ عاونَ الدهرَ ضَّده","مرّجيهمُ فهو المضامُ المغلَّب",23,"ب",1,0],["وَكُلُ شاكِرٍ صُنع الأَيادي","وَما فَعل الصَوارم وَالجُنود",24,"د",1,0],["وكل شبع وكل مطعمة","يفنى ويبقى على المستعصم الكرم",25,"م",1,0],["وكل شيء قد غلا سعرهُ","يرخصه ممّا غلا تركه",26,"ك",2,1],["وكلّ شيء فله دولة","وفيه إقبالٌ وإدبار",27,"ر",1,0],["وَكلُّ شَطرٍ جاءَ مُستقلّا","لا بعدهُ يحتاجهُ لا قبلا",28,"ل",2,0],["وكل شيء أنيس","حتى القطا والصلال",29,"ل",1,0],["وكل شيء عظيم","حتى أقل النمال",29,"ل",1,0],["وَكُلُّ شَيءٍ وإنٍ أَعيا لَهُ أَجَلٌ","يَقضي كَما تَنقَضي لِلناسِ آجالُ",30,"ل",1,0],["وَكُلُّ شَيءٍ قَد كُنتُ أَحسِبُهُ","أَخذُ ثِيابي ما دارَ في خَلَدي",31,"د",2,0],["وكل شقاق عاد وهو تألف","إلى الله في إعزازه يُتَقرب",32,"ب",1,0],["وكل شاة في غدٍ","برجلها معلقه",33,"ق",2,0],["وكلّ شيءٍ له ضدٌّ يقابله","بالخير والحكم فيه ظاهر الحجج",34,"ج",1,0],["وكل شيء وله غاية","وغاية العرفان حرمان",35,"ن",1,0],["وكلٌّ شهيدٍ سوفَ يشخُبُ جرحهُ","دماً طاهراً يومَ القيامةِ أذفرا",36,"ر",2,0],["وكلُّ شعبٍ له أرضٌ يُدبِّرها","فيمَ التصدي لمسعانا ومَسعاك",37,"ك",1,0],["وَكل شَريف عنده مُتَواضع","وَكل عَظيم القريَتين حقير",38,"ر",1,0],["وكل شيء سواهم لي به بدل","منهم وَمالي بهم من غيرهم بدل",39,"ل",1,0],["وكلُّ شعبٍ شريكٌ في دمائِهمُ","فعجهزٌ هَبَّ يعدو إِثرَ مَنْ جرحا",40,"ح",2,0],["وكلِّ شيطانٍ بَغى","مِن كلّ جنّ وَبَشر",41,"ر",1,0],["وَكُلُّ شَيءٍ خارِجٌ عَنها إِذا اِع","تَبَرتَهُ وَجدَتَهُ مِنها بَدا",42,"د",2,0],["وَكُلُّ شَعبٍ عَصى ما تَأمُرونَ بِهِ","أَرَتهُ أَن عَصاهُ عِندَها شُعَبُ",43,"ب",1,0],["وكل شيء فهو ينضح بمافي أناه","وعادني أوصيك ياطالب سبيل النجاه",44,"ا",2,0],["وكل شر فملىء البطن أصل ابتداه","ذا من حلال فكيف السحت والإشتباه",44,"ا",2,0],["وكل شخص عطاشفه ورأسه ملاه","وتابع الشح والأهواو وكثر العكاه",44,"ا",2,0],["وكلُّ شخص صريعٌ لا يطيقُ قوى","قد لَفّتِ الريحُ منه الرأسَ والرّكبَا",45,"ب",2,0],["وكل شيء منه فيه حصة","حتى السماء ووبله وطله",46,"ل",2,0],["وكل شيء له عقبى إلى أمد","وما لحبي وولوالي لها أمد",47,"د",1,0],["وكلُّ شيء عندَها","إلا الرقاد والسَّحَرْ",48,"ر",1,0],["وكل شيء يرى فيها فقل حسن","واعجب به شاكرا واضربه كالمثل",49,"ل",1,0],["وكلُّ شخصٍ تولَّى","لمَا أَرادَ ورامَهْ",50,"م",2,0],["وكلُّ شيءٍ حازَهُ جَميلُ","والنَّفسُ دائماً له تميلُ",51,"ل",1,0],["وكلَّ شَعْواء لها غَمْغَمَةُ الش","شاكي إذا حَنّ لمنْ يشكو وأنْ",52,"ن",1,0],["وكلُّ شيءٍ راقنا حسنهُ","فهْوَ سرابٌ في الضحى يبرقُ",53,"ق",1,0],["وكل شيء هو عالم به","وبالذي يخفيه في الطويه",54,"ي",2,0],["وكل شيء سبيل الرب خلقته","إليه في الناس من يمشي به وصلا",55,"ل",2,0],["وكل شيء صرفت عنه","ولم يصرّح به لساني",56,"ن",2,0],["وكل شيء للحق شان","والحق باد في كل شان",56,"ن",1,0],["وكل شخص يدعي","ما ليس فيه علنا",57,"ن",2,0],["وكل شيء فالعلم ترتيب","له بأحكامه وتصفيف",58,"ف",1,0],["وكل شيءٍ تراه","اطلب له استنقاذا",59,"ذ",2,0],["وكل شيء من الأشياء أجمعها","قامت فمذمومة فيه ومحموده",60,"د",2,0],["وكل شيء له وقت يكون به","فلا تكن في القضايا غير مبتهج",61,"ج",1,0],["وكل شيء به بدا عدمٌ","مقدر كالستور والحجب",62,"ب",1,0],["وكل شيء له إلينا","من حيث معروفنا انتساب",63,"ب",1,0],["وكل شيء هالك فيها إذا","بدت وكل الشيء في الفناء",64,"ا",2,0],["وكلُّ شهرٍ ربيعٌ منكَ نحسَبهُ","حتَّى كأنَّ جميع الدهر نَيسانُ",65,"ن",1,0],["وكل شيءٍ تنساهُ إلا","المَلالَ والغَدرَ والخِيانَه",66,"ن",2,0],["وكلُّ شِعْر قُلْتُ في غَيْرِه","فإِنَّه تَجرِبَةُ الخَاطِر",67,"ر",1,0],["وكُلُّ شِعْرٍ قلته في مَجْدِه","شَدَا بِه الشَّادِي وسَارَ البَريدْ",68,"د",1,0],["وكلُّ شيءٍ له حالٌ يغيِّرُهُ","كما تُغَيِّرُ لونَ اللمّةِ الغِيَرُ",69,"ر",1,0],["وكلّ شيءٍ على رزءِ الحسين بكى","وكلّ طرفٍ له بالدمع منهملِ",70,"ل",1,0],["وَكُلُّ شَيء بتقدير العَزيز لَها","يَبدو بِأَحسن تَنظيم وَإِحكام",71,"م",1,0],["وكل شعر يلهيك رونقه","فهو لشعري الطراز والخلل",72,"ل",1,0],["وَكُلُّ شَيء فيكَ قَلَّ نَفعه","وَالزَرع قَد صافَ وَآن قَطعه",73,"ه",1,0],["وكلَّ شَك مُريبٍ","وكلَّ إمْرٍ فَرِىِّ",74,"ر",2,0],["وكلُّ شُنخوبٍ مُنيفِ الذرا","روَّى شناظِيهِ صبيرٌ وجُون",75,"ن",1,0],["وكل شخص يرجى مخلصا حسنا","من الحساب الذي في عرضه طول",76,"ل",1,0],["وكل شخص ينادي يا محمد سل","مولاك في أمرنا فالأمر قد عظما",77,"م",2,0],["وكلُّ شكلٍ نعمةٌ","من جريهِ أيانَ ما يجري",78,"ر",2,0],["وكل شيء هان","يا فرحة الديدان",79,"ن",1,0],["وكل شريف عنده متواضع","وكل لبيب بالجمال أسير",80,"ر",1,0],["وكلِّ شغلٍ شاغلِ","أعطاك صرْفُ الدهرِ من",81,"ن",1,0],["وكل شيءٍ حسنه قد فاضا","من صنعة الرحمن والإنسان",82,"ن",1,0],["وكل شيء عوده قد وجبا","في آخر البيت ابن كيسان اجتنبي",83,"ي",1,0],["وَكُلُّ شَيءٍ بَلَغَ الحَدَّ انتَهَى","عَمِرتُ فِي ظِلِّ النَّعِيمِ نَاعِمَا",84,"م",2,0],["وَكُلُّ شخصٍ له نَحو ببابكم","ما كان يعلمه الفرا ولا العتقي",85,"ق",2,0],["وكل شيء تلاشى","حتى بقايا اقتداري",86,"ر",2,0],["وكل شرط ثابت في الشرع","لا بد من إحرازه للمنع",87,"ع",1,1],["وكل شيء لم يكن مقررا","من جانب الشرع ولا محررا",87,"ر",2,0],["وكل شيء فعلى قدره","يحجم أو يقدم أو يجرى",88,"ر",2,0],["وكل شيء مسه مشركٌ","أفسدهُ رطباً مدى الدهر",89,"ر",1,0],["وكل شيءٍ طاهرٍ أصلهُ","فهوَ على سيسانهِ يجري",89,"ر",2,0],["وكل شيءٍ إذا ما النقض خالطه","عليه إعلامهم فيه يما ثلبا",90,"ب",2,0],["وكل شيطان وكل جن","من ظاهر منهم ومستجن",91,"ن",1,0],["وَكُلِّ شَموسِ العَدوِ ضافٍ سَبيبُها","وَمُنجَرِدٍ كَالسيدِ نَهدِ المَراكِلِ",92,"ل",1,0],["وكل شيء وان غصت لواحظها","عنه صروف الليالي برهة فاني",93,"ي",1,0],["وكل شخص وإن طالت أصابعه","فأصله قيل من أنثى ومن ذكر",94,"ر",1,0],["وكلَّ شَموعٍ تجلي عند ابتسامِها","شُفُوفَ سُمُوطِ اللؤلؤِ المتُناسق",95,"ق",1,0],["وكلُّ شخصٍ على انفراد","من مثله قد حماه ماله",96,"ل",2,0],["وكلُّ شيء من الكوان نعلمه","موحدا هو في القر