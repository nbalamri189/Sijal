{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[55,"صاحت بذودي بغداد فآنسني","https://www.aldiwan.net/poem30446.html","البسيط"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[164,"يا من رأى مثل ابن تاج الدين","https://www.aldiwan.net/poem58960.html","الكامل"],[382,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[556,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"]],"verses":[["أَطغاهُ رَونَقُ غَربِهِ فَطَغى","وَالمَاءُ يُطغيهِ تَرَقرُقُهُ",0,"ق",2,0],["أَطغى عَلى قاطِنيها غَيرَ مُكتَرِثٍ","وَأَفعَلُ الفِعلَ فيهاغَيرَ مَأمورِ",1,"ر",1,0],["أطغاك ما نِلتَ بي فدُونَكها","من صائلٍ بالطغاة بطّاش",2,"ش",1,0],["أطغاك جهلٌ بما أعطتك مرحمةٌ","قدماً أطالت على الحُرَّاص رفرافا",3,"ف",2,0],["أطغى البحرُ ذو العباب على العربِ","فَلَفّ القصورَ بالأطنابِ",4,"ب",1,0],["أطغاه أن طمحت إلى أعلامه","أبصار أهل عبادة الأصنام",5,"م",1,0],["أطغتك من نفحات أحمد نعمة","درت بضرع في لهاك لبون",6,"ن",1,0],["أطغاك بل أغواك عن حبي وعن","مدحي وهوْ يرضيهِ أنك تَقلَق",7,"ق",1,0],["أطغاكُمُ خَفضُ الأناةِ ودونها","نِقَمٌ تعدّل جانبَ المُتَزَيِّلِ",8,"ل",1,0],["أطغى الشريعةَ من دماهم بعدما","سَدّت قنا منهم لها وسهام",9,"م",1,0],["أطغت عباد اللَه وهي عبيد","فالأرض من ثقل الذنوب تميد",10,"د",1,1]]}