{"poems":[[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[1525,"","https://poetry.dctabudhabi.ae/diwan/poem/116108","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131950","الكامل"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35651","المتدارك"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78288","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78350","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4739,"شمس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=28118",""],[4797,"عقبال مية عام","https://www.poetsgate.com/ViewPoem.aspx?id=29438",""],[4805,"حكمه","https://www.poetsgate.com/ViewPoem.aspx?id=176602",""],[4940,"الصُّنُوفُ المُهْلِكَات","https://www.poetsgate.com/ViewPoem.aspx?id=215164",""],[5525,"ديمة","https://www.poetsgate.com/ViewPoem.aspx?id=942",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["لَو لِلفُحولِ تَعِنُّ لَافتَخَروا بِها","وَلِجَروَلٍ لَحَبا بَني شَمّاسِ",0,"س",1,0],["لَوْ للمَجُوسِ تعرَّضَتْ","بِسُيُوفِ لحْظَتِها مُلِيحَهْ",1,"ح",2,0],["لَو للِّقَا عَطَفَتكَ منهُ شكَايَةٌ","رَقَّت وَدَمع طَافحُ شُؤبُويهُ",2,"ه",1,0],["لو للكواكب أشتكي ما ذقته","لتناثرت فوق الربى أجراما",3,"م",2,0],["لو للورى رخص الشرع المبين لما","قال الورى إنما المهدي منتظر",4,"ر",1,0],["لَو لِلأَيّامِ شَمائِلُهُ","لَم تَجنِ عَلَيكَ وَلَم تَخُنِ",5,"ن",1,0],["لَو لِلسَّعادَةِ عين في مُساعَدَتي","ما كانَ لي ساعد بِالطوق مَشدود",6,"د",1,0],["لَو لِلدِّيارِ فَم لقالَت مَرحَبا","بُشرى بِنير عزتي وَمدارى",7,"ر",2,0],["لو للسيوفِ مَضاءُ عَزْمتهِ","ويراعِهِ أَمنتْ مِنَ الثَّلمِ",8,"م",1,0],["لو للعيون احساس ما شافت عيوب","ما شوهت وجه الوفا دمعة الياس",9,"س",1,0],["لوللقلوب اسواق بايع وسوام","لاابدلك وان جيتني ماشريتك",10,"ك",1,0],["لو للحياء في وجه الايام بينه","ما شح حظ الاجودي بكسب نوماس",11,"س",1,1],["لو للحياة العلم أن سيجيئها","لتبرأت في الغيب من أجدادِهْ",12,"د",2,0],["لو للزمن .. عن نية الغد ر شيمه","ما فرق أحبابٍ ولا بعد أوطان",13,"ن",1,0],["لو للجمَالِ رِسَالاتٌ مٌنزَّلَةٌ","ختَمْتِ أنتِ الرِّسَالاتِ الجمَالِيَّةْ",14,"ي",2,0]]}