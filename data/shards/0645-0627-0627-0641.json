{"poems":[[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[87,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[51,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[69,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12821","السريع"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[108,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[123,"ما أفصح اللحظ يا حبيبي","https://www.aldiwan.net/poem49361.html","مخلع البسيط"],[145,"قد حصلنا من الماش كما قي","https://www.aldiwan.net/poem58431.html","البسيط"],[158,"تركب الروح فيه إذ تركبه","https://www.aldiwan.net/poem55504.html","البسيط"],[207,"يا من على وجناته","https://www.aldiwan.net/poem53101.html","مجزوء الكامل"],[213,"يا سيداً هباته","https://www.aldiwan.net/poem13333.html","مجزوء الرجز"],[213,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[235,"طيف لك زائري جميل الوصف","https://www.aldiwan.net/poem14912.html","الدوبيت"],[238,"رب الزمان أجل قد","https://www.aldiwan.net/poem31743.html","مجزوء الكامل"],[285,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32291.html","الرجز"],[285,"أفدي غلاما قط ما قطبا","https://www.aldiwan.net/poem32868.html","السريع"],[300,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[300,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[306,"بي غزال لما أطعت هواه","https://www.aldiwan.net/poem58131.html","الخفيف"],[341,"ما أفضح الموت للدنيا وزينتها","https://www.aldiwan.net/poem68674.html","البسيط"],[356,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[367,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[466,"هيج بلبالي بأهل بابل","https://www.aldiwan.net/poem3494.html","عموديه"],[470,"قد قلت لما جفاني","https://www.aldiwan.net/poem59634.html","المجتث"],[502,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[517,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[553,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"]],"verses":[["ما اِفتَرَقنا مِنَ الضَميرِ فَيَنضو ال","ذِكرُ ما بَينَنا ظُبى الاِشتِياقِ",0,"ق",1,0],["ما أفرح الملبوس من أيامنا","بك لا عُدِمتَ وأكسف المخلوعا",1,"ع",2,0],["ما أفاد الصقر المحلق في الجو","مدلا أن الفضاء وسيع",2,"ع",1,0],["ما آفَةُ السَعيِ سِوى الضَلالِ","ما آفَةُ العُمرِ سِوى الآمالِ",3,"ل",1,0],["ما أَفضَلَ الصَبرَ وَالقَناعَةَ لِل","ناسِ جَميعاً لَو أَنَّهُم قَنِعوا",4,"ع",3,0],["ما افْتَرَّ ثغْرٌ للأَزاهِرِ أَشْنَب","وانْهَلَّ دَمْعٌ للسَّحَابِ سَفُوحُ",5,"ح",1,0],["ما أَفلَتتْ من يدي غيداءُ عاصيةٌ","إلا وعادتْ إليها وهي سمحاءُ",6,"ا",2,0],["ما آفَةُ الحُبِّ الَّذي بَينَنا","يا فَوزُ إِلّا سوءَ رَأيِ الرَسول",7,"ل",1,0],["ما أَفضَلَ الرَفضَ لِلمَلاهي","وَالصَبرَ لِلفادِحِ الجَليلِ",8,"ل",1,0],["ما أفْلَتَ الرُّسْلُ من نقدٍ، ولا سلِموا","من لائمٍ لامَ، أو من عاتبٍ عَتَبَا",9,"ب",2,0],["ما أفترينا في مدحه بل وصفنا","بعض أخلاقه وذلك يكفي",10,"ف",2,0],["مَا افْتَرَّتْ ثَانِيَةٌ حَتَّىْ","قَالَتْ أُخْرَىْ : لاَ تَفْتَرِّيْ",11,"ر",2,0],["ما أفصح اللحظ يا حبيبي","وأعذب البث بالعيون",12,"ن",1,1],["ما افتخار الفتى بثوبٍ جديدٍ","وهو من تحته بعِرضٍ لبيسِ",13,"س",1,0],["مَا أَفْسَدَتْ يَدُها اليُمْنى مَحَاسِنَهُ","مُذْ أَصْلَحَتْ يَدُها اليُسْرى مَساوِيهِ",14,"ي",2,0],["ما آفة المحبوب من","ك سوى لواحظك الضعيفَهْ",15,"ف",2,0],["ما افتر ثغر المدح عن","نظم ثنايا الشكر",16,"ر",1,0],["ما افترّ ثغر الصبح عن شنب الندى","وبدا سنا وجه النهار المشرق",17,"ق",1,0],["ما اِفتَقَدَني وَقَد تَمَتَّتُ بِهِ","لَو صُبَّ عَلَيَّ نَومُ أَهلِ الكَهفِ",18,"ف",1,0],["ما اِفتَرَّ في وَجهِ الرَبي","عِ الطَلقِ ثَغرُ الأُقحُوانِ",19,"ن",1,0],["ما أَفرَقَت مُهجَتُهُ مِنَ الجَوى","لَكِنَّهُ أَشفى عَلى فِراقِها",20,"ق",3,0],["ما اِفتَرَّ إِلا خِلتَ في فيهِ سِم","طُ الدُرِّ مِن أَصدافِهِ رُكِّبا",21,"ب",2,0],["ما اِفترَقا واِجتَمعا","يغشاهُما الخَيرُ معا",22,"ع",2,0],["ما اِفترَّ منها الثغرُ إلّا غَدت","تُجلى على خُطّابها في عُقود",23,"د",1,0],["ما أفاق العذول من سكرة العذ","ل عليه حتى غدا فيه صبا",24,"ب",2,0],["ما أَفضَحَ المَوتَ لِلدُنيا وَزينَتِها","جداً وَما أَفضَحَ الدُنيا لِأَهليها",25,"ي",3,1],["ما اِفترّ ثَغر الزَهر عَن لُؤلؤٍ","رَطب إِذا ما اِنهلَّ دَمع الغَمام",26,"م",1,0],["ما آفةُ الإنسانِ إلا المُنَى","طُوبَى لِمَنْ طَلّقها واستَراح",27,"ح",1,0],["ما أفصحَ الدمعَ وقد خاطبهُ","عيُّ طلول الدار والمنازل",28,"ل",1,0],["ما آفَتي غَيرُ قَلبٍ","أَطَعتُهُ وَعَصاني",29,"ن",2,0],["ما أَفرطَ الدَّمعُ منه في مُحَرَّمِهِ","إِلاَّ وشوَّالُهُ أبكى الدِما رَجَبَا",30,"ب",2,0],["ما أفقر الدهر من مثلي وأنت بما","أقول درى ولكن قلة القسم",31,"م",1,0],["ما اِفتَرَّ فجرٌ وما لاحَتْ بشائرُهُ","وما تَرَنَّمَ قُمْرِيٌّ على غُصُنِ",32,"ن",1,0]]}