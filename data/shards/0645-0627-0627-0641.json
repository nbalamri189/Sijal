{"poems":[[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[87,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[51,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[69,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12821","السريع"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[108,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[124,"ما أفصح اللحظ يا حبيبي","https://www.aldiwan.net/poem49361.html","مخلع البسيط"],[146,"قد حصلنا من الماش كما قي","https://www.aldiwan.net/poem58431.html","البسيط"],[159,"تركب الروح فيه إذ تركبه","https://www.aldiwan.net/poem55504.html","البسيط"],[208,"يا من على وجناته","https://www.aldiwan.net/poem53101.html","مجزوء الكامل"],[214,"يا سيداً هباته","https://www.aldiwan.net/poem13333.html","مجزوء الرجز"],[214,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[237,"طيف لك زائري جميل الوصف","https://www.aldiwan.net/poem14912.html","الدوبيت"],[240,"رب الزمان أجل قد","https://www.aldiwan.net/poem31743.html","مجزوء الكامل"],[287,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32291.html","الرجز"],[287,"أفدي غلاما قط ما قطبا","https://www.aldiwan.net/poem32868.html","السريع"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[308,"بي غزال لما أطعت هواه","https://www.aldiwan.net/poem58131.html","الخفيف"],[343,"ما أفضح الموت للدنيا وزينتها","https://www.aldiwan.net/poem68674.html","البسيط"],[358,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[469,"هيج بلبالي بأهل بابل","https://www.aldiwan.net/poem3494.html","عموديه"],[473,"قد قلت لما جفاني","https://www.aldiwan.net/poem59634.html","المجتث"],[505,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[520,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130200","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48849","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63741","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145790","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59108","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84478","البسيط"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48910","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11990","المنسرح"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104463","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53123","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93875","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132560","المجتث"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132677","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91750","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141495","السريع"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77090","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36445","الدوبيت"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102744","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105114","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58073","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105170","الكامل"],[4568,"","https://poetry.dctabudhabi.ae/diwan/poem/143589","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52162","الخفيف"],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[307,"كم فيك يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=213636",""],[5323,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=209170",""],[5363,"رثاء الشيخ البروفسور إبراهيم الكندي","https://www.poetsgate.com/ViewPoem.aspx?id=199950",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5512,"ذات العيون الشهل","https://www.poetsgate.com/ViewPoem.aspx?id=205887",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[6102,"وطن ولا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=182752",""],[6110,"قد صيرني الهوى جذاذا","https://www.poetsgate.com/ViewPoem.aspx?id=141176",""]],"verses":[["ما اِفتَرَقنا مِنَ الضَميرِ فَيَنضو ال","ذِكرُ ما بَينَنا ظُبى الاِشتِياقِ",0,"ق",1,0],["ما أفرح الملبوس من أيامنا","بك لا عُدِمتَ وأكسف المخلوعا",1,"ع",2,0],["ما أفاد الصقر المحلق في الجو","مدلا أن الفضاء وسيع",2,"ع",1,0],["ما آفَةُ السَعيِ سِوى الضَلالِ","ما آفَةُ العُمرِ سِوى الآمالِ",3,"ل",1,0],["ما أَفضَلَ الصَبرَ وَالقَناعَةَ لِل","ناسِ جَميعاً لَو أَنَّهُم قَنِعوا",4,"ع",3,0],["ما افْتَرَّ ثغْرٌ للأَزاهِرِ أَشْنَب","وانْهَلَّ دَمْعٌ للسَّحَابِ سَفُوحُ",5,"ح",1,0],["ما أَفلَتتْ من يدي غيداءُ عاصيةٌ","إلا وعادتْ إليها وهي سمحاءُ",6,"ا",2,0],["ما آفَةُ الحُبِّ الَّذي بَينَنا","يا فَوزُ إِلّا سوءَ رَأيِ الرَسول",7,"ل",1,0],["ما أَفضَلَ الرَفضَ لِلمَلاهي","وَالصَبرَ لِلفادِحِ الجَليلِ",8,"ل",1,0],["ما أفْلَتَ الرُّسْلُ من نقدٍ، ولا سلِموا","من لائمٍ لامَ، أو من عاتبٍ عَتَبَا",9,"ب",2,0],["ما أفظع الشنار أو يزيله","ضرب يزيل الهام من فوق الطلى",10,"ا",1,0],["ما أفترينا في مدحه بل وصفنا","بعض أخلاقه وذلك يكفي",11,"ف",2,0],["مَا افْتَرَّتْ ثَانِيَةٌ حَتَّىْ","قَالَتْ أُخْرَىْ : لاَ تَفْتَرِّيْ",12,"ر",2,0],["ما أفصح اللحظ يا حبيبي","وأعذب البث بالعيون",13,"ن",1,1],["ما افتخار الفتى بثوبٍ جديدٍ","وهو من تحته بعِرضٍ لبيسِ",14,"س",1,0],["مَا أَفْسَدَتْ يَدُها اليُمْنى مَحَاسِنَهُ","مُذْ أَصْلَحَتْ يَدُها اليُسْرى مَساوِيهِ",15,"ي",2,0],["ما آفة المحبوب من","ك سوى لواحظك الضعيفَهْ",16,"ف",2,0],["ما افتر ثغر المدح عن","نظم ثنايا الشكر",17,"ر",1,0],["ما افترّ ثغر الصبح عن شنب الندى","وبدا سنا وجه النهار المشرق",18,"ق",1,0],["ما اِفتَقَدَني وَقَد تَمَتَّتُ بِهِ","لَو صُبَّ عَلَيَّ نَومُ أَهلِ الكَهفِ",19,"ف",1,0],["ما اِفتَرَّ في وَجهِ الرَبي","عِ الطَلقِ ثَغرُ الأُقحُوانِ",20,"ن",1,0],["ما أَفرَقَت مُهجَتُهُ مِنَ الجَوى","لَكِنَّهُ أَشفى عَلى فِراقِها",21,"ق",3,0],["ما اِفتَرَّ إِلا خِلتَ في فيهِ سِم","طُ الدُرِّ مِن أَصدافِهِ رُكِّبا",22,"ب",2,0],["ما اِفترَقا واِجتَمعا","يغشاهُما الخَيرُ معا",23,"ع",2,0],["ما اِفترَّ منها الثغرُ إلّا غَدت","تُجلى على خُطّابها في عُقود",24,"د",1,0],["ما أفاق العذول من سكرة العذ","ل عليه حتى غدا فيه صبا",25,"ب",2,0],["ما أَفضَحَ المَوتَ لِلدُنيا وَزينَتِها","جداً وَما أَفضَحَ الدُنيا لِأَهليها",26,"ي",3,1],["ما اِفترّ ثَغر الزَهر عَن لُؤلؤٍ","رَطب إِذا ما اِنهلَّ دَمع الغَمام",27,"م",1,0],["ما آفةُ الإنسانِ إلا المُنَى","طُوبَى لِمَنْ طَلّقها واستَراح",28,"ح",1,0],["ما أفصحَ الدمعَ وقد خاطبهُ","عيُّ طلول الدار والمنازل",29,"ل",1,0],["ما آفَتي غَيرُ قَلبٍ","أَطَعتُهُ وَعَصاني",30,"ن",2,0],["ما أَفرطَ الدَّمعُ منه في مُحَرَّمِهِ","إِلاَّ وشوَّالُهُ أبكى الدِما رَجَبَا",31,"ب",2,0],["ما أفقر الدهر من مثلي وأنت بما","أقول درى ولكن قلة القسم",32,"م",1,0],["ما اِفتَرَّ فجرٌ وما لاحَتْ بشائرُهُ","وما تَرَنَّمَ قُمْرِيٌّ على غُصُنِ",33,"ن",1,0],["ما أفسد اللّه في أقطاره بلداً","إلا وارسله للصلح بينهم",34,"م",1,0],["ما آفة الوجدان أن تتفرقوا","شيعاً وأن تتنافسوا أحزابا",35,"ب",2,0],["ما أَفسدَ القيظُ من الأنوارِ","من اصفرارٍ ومنَ احمرارِ",36,"ر",1,0],["ما أفجَعَ الدِّينَ الذي مِن جَوقةِ","المُتدَيِّنينَ تَحَمَّلَ الأوزَارا",37,"ر",2,0],["مَا افترَ ثغرُ الزهْرِ مُبْتَسِماً وَمَا","جَالَتْ جُيُوش النَّصْرِ وَاضحةُ الغُرَرْ",38,"ر",1,0],["ما أفخَر الدُرَّ مَع تَفريع نِسبَتهم","يَوماً بِأَنفَسَ من تَنويعِ ذِكرِهِم",39,"م",1,0],["ما افتك الموت عدوانا وامهره","دراية في فنون الفتك عدوانا",40,"ن",2,0],["ما افتخاري إذا أَسأْت فِعالاً","واجدت المقال نظماً ونثرا",41,"ر",2,0],["ما آفَتي غَيرَ وَردٍ وَجنَتِهِ","وَالوَردُ لا شَكَّ آفَةُ الجُعَلِ",42,"ل",1,0],["ما افتتن مرسلها علي تحكما","فيما يلف من الفروع وينشر",43,"ر",1,0],["ما أفخرنا لو سامحنا","فيعودُ الكسر بمُلتسم",44,"م",1,0],["ما افْتَرَّ برق وتغنت طَرَباً","وُرْقٌ بِغُصْنٍ مورق نضير",45,"ر",1,0],["ما افترّ برق أو ترنَّمَ بالضحى","وُرْقٌ على عَذَبات دَوْحٍ أخضر",46,"ر",1,0],["ما افسد الدهر سوف يصلحه","اصلحها صالح واعدلها",47,"ل",3,0],["ما أفتر عن ثغره بليل","إلا وللصبح لاح مبرق",48,"ق",1,0],["ما افطر اليوم الا","لكي يلف الدجاجه",49,"ه",1,0],["ما افتر ثغر منضد ورنا","طرف غضيض وماس غصن نقا",50,"ق",2,0],["ما أَفقنا من المدامة إِلا","كان ما نبتغي لَمىً أَو مُداما",51,"م",2,0],["ما افترقا قطُّ ولا اجتمعا","كلاهما من ضدِّه يولد",52,"د",1,0],["ما اِفتَر ثُغر الزَهر مُبتَسِماً","لِقَهقَهَةِ الرُعود",53,"د",1,0],["ما اِفتَرَّ دُجى ليليَ من غُرَّتها","إِلّا اِضطَربت ذكاءُ من غَيرتها",54,"ه",2,1],["ما أفادوا الاكما أودع اليمّ","خياطا ألقى به من ماء",55,"ا",2,0],["ما افتك الألحاظ ترمى اسهما","بقولبنا ما ان لها ارعاظ",56,"ظ",1,0],["ما افتر مبسمها وأزهر خدها","إلا وأزهرت القفار البيد",57,"د",1,0],["ما أفلح الجبنا هلاّ همو سمعوا","بخالدٍ إذْ بحتْفِ الأنفِ مقبوضُ",58,"ض",1,0],["ما أفتر مبسم ثغرها إلا غدا","يزري بسمط اللؤلؤ المنضود",59,"د",1,0],["ما افتضَّ بِكرَ أكامها ووهادها","خَبَبُ الجياد ولا وَجيفُ البُزَّل",60,"ل",1,0],["ما افترقنا حيناً من الدهرِ حتى","جمع الدهرُ بيننا من جديدِ",61,"د",1,0],["ما افجع الماساة يحيا","ها بعمق واصطخاب",62,"ب",1,0],["ما أفزع الموتُ قلبي والأسى دمُه","وما أفاقَ لدنيا وعدها رفلُ",63,"ل",1,0],["‏ما أفسحَ الكون في عيني وأجملهُ","‏ما دامَ ما بيننا بالوصلِ مزدانا",64,"ن",2,0],["ما أفدحَ الخسرانَ فقدٌ مؤلمٌ","يدعُ القلوب مع العقول ذواهلا",65,"ل",2,0],["ما أفادت قربة أبي لهب","شيئاً وتبت يداه عبداً عصيا",66,"ي",2,0],["ماأفكر وين وكيف الانتصار","لانه يفكر بنفسي وش .؟ يديمه",67,"م",2,0],["ما أفادَ القلبَ وَقْدٌ قبلَهُ","كلٌّ نورٍ في الدُّنا ما أنتجا",68,"ج",2,0],["مَا أَفْضَعَ العَالَمَ فِي صَمْتِهِ","يَنْفُضُ لِلأَمْرِ يَدَيْهِ الثِّقَالْ",69,"ل",1,0],["ما افتَكَّ مِن لُغَةٍ تُجَرِّحُهُ","إِلَّا إِلى لُغَةِ النَّزيفِ دَمُهْ",70,"م",2,0],["ما أفعل لم أجد لآهي","في صخر فؤادها نفاذا",71,"ذ",2,0]]}