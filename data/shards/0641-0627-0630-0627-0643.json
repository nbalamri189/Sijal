{"poems":[[95,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11164.html","الخفيف"],[95,"بلغت من عيشي أعز مرام","https://www.aldiwan.net/poem11394.html","الكامل"],[90,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[90,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[53,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[31,"أجرير إنك والذي تسمو له","https://www.aldiwan.net/poem6043.html","الكامل"],[93,"عصفت ريح الندى بالمشعل فخبا","https://www.aldiwan.net/poem8756.html","عموديه"],[72,"يا هذه لا تغلطي","https://www.aldiwan.net/poem42874.html","مجزوء الكامل"],[91,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[46,"إني نظرت ولا صواب لعاقل","https://www.aldiwan.net/poem29692.html","الكامل"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[104,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/203549","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55005","الخفيف"],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[92,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[53,"يا أبا أحمدٍ ومثلُك لا يَغْ فَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=27822",""],[146,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[203,"كنت أرجوك أن تعين على اله","https://www.aldiwan.net/poem45553.html","الخفيف"],[203,"ما لي أراك مغاضبا","https://www.aldiwan.net/poem45554.html","مجزوء الكامل"],[228,"كيف قوضتم بناء القضاء","https://www.aldiwan.net/poem41913.html","الخفيف"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[318,"قل لمن يفهم عني ما أقول","https://www.aldiwan.net/poem59486.html","الرمل"],[376,"لحن حتى أمرن طرفا بقلبي","https://www.aldiwan.net/poem57526.html","الكامل"],[382,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[385,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[402,"يا أديبا إليه كل أديب","https://www.aldiwan.net/poem11059.html","عموديه"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[422,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[422,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[449,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[458,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[463,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[520,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[563,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[567,"يا حسنها دارا لكثرة وفدها","https://www.aldiwan.net/poem52638.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82796","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[744,"","https://poetry.dctabudhabi.ae/diwan/poem/98142","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62660","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67756","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136286","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109167","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109164","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48911","الخفيف"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17533","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100954","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27452","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27876","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87770","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105670","الكامل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98161","الخفيف"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198419",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87580","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87368","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97935","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74062","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48330","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108301","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110133","الكامل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103797","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32784","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77052","الكامل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105138","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127076","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28626","الكامل"],[4423,"","https://poetry.dctabudhabi.ae/diwan/poem/124258","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120287","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120232","الخفيف"],[4717,"مضايا","https://www.poetsgate.com/ViewPoem.aspx?id=199649",""],[4915,"نُبُوءة","https://www.poetsgate.com/ViewPoem.aspx?id=211345",""],[182,"من لي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=72826",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5616,"نفور","https://www.poetsgate.com/ViewPoem.aspx?id=203194",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5831,"سجدة كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=20398",""],[5970,"بعض عمر الفتي ليال تقضى","https://www.poetsgate.com/ViewPoem.aspx?id=130622",""],[6082,"لك يا منازل","https://www.poetsgate.com/ViewPoem.aspx?id=59931",""],[1583,"هذه الأرض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73069&r=&rc=26",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["فَإِذَا كَانَ مِنْهُ عِنْدَكَ فَضْلٌ","فَابْذُلِ الفَضْلَ وَاغْتَنِمْ شُكْرَانِي",0,"ن",2,0],["فَإِذَا كَمِيٌّ لاحَ لِي مُتَرَجِّلاً","وَأُوَامُهُ بَادٍ فَهَاجَ أُوَامِي",1,"م",2,0],["فإذا كنت تبتغي المسخ فينا","كي يعيش الإنسان وهو حمار",2,"ر",1,0],["فإذا كنت قد أصبت وإلا","فانبذوا ما أقوله في الكناسه",3,"س",2,0],["فإذا كان منه وعد رأى الإخ","لاف نكْثاً كما رأى الوعد عهدا",4,"د",2,0],["فَإِذا كُلَيبٌ لا تُوازِنُ دارِماً","حَتّى يُوازَنَ حَرزَمٌ بِأَبانِ",5,"ن",1,0],["فَإِذا كُلُّ قُصورِ الأَمَلِ كَالهَبا","فَإِذا كُلُّ قُصورِ الأَمَلِ كَالهَبا",6,"ب",2,0],["فَإِذا كَذَبتِ فَلا يَكُن","كَذِباً لِكُلِّ الناسِ ظاهِر",7,"ر",1,0],["فاذا كان القلب منك كقلبي","فتعالى نذل ما قد تصعب",8,"ب",1,0],["فَإِذا كِتابُكَ قَد تُخِيِّرَ لَفظُهُ","وَإِذا كِتابي لَيسَ بِالمُتَخَيِّرِ",9,"ر",1,0],["فَإِذا كَشَفتَهُمُ وَجَدتَ لَدَيهِمُ","كَرَمَ النُفوسِ وَقِلَّةَ الآدابِ",10,"ب",1,0],["فَإِذا كانَ لَفحةً مِن جَحيم الر","رجس أَملى أَحكامَه شَيطانُه",11,"ه",1,0],["فإذا كان ما يقولون حقاً","فاسألوهم في أين كان أبوه؟",12,"ب",3,0],["فَإِذَا كُنْتُمَا أَساسَيْه تَمت","لَكُمَا زِينةُ الْحَيَاة جَمِيعَا",13,"ع",2,0],["فإذا كانَ حِطةً وجموداً","فالعدوُّ اللدودُ للمألوف",14,"ف",1,0],["فإذا كانَ ما نخافُ فهرقُ الدّمِ","سهلٌ كما تُراقُ ذَنوب",15,"ب",1,0],["فإذا كلُّ يومِنا مثلُ أمسٍ","وإذا كلُّ رُشدنا مثلُ غَي",16,"ي",1,0],["فإذا كان منه وعد رأى الإِخلا","ف نكْثاً كلما رأى الوعد عهدا",17,"د",2,0],["فإذا كمالُ الملكِ سَحّ سحابُهُ","نبتَ الرجاءُ وأثمر المأمولُ",18,"ل",1,0],["فإذا كنتَ قد ظننتَ غروراً","إنما أنتَ جوهرٌ مكنونُ",19,"ن",1,0],["فإذا كتبتُ إليكَ مع","تذراً أحلتَ على التجني",20,"ن",2,0],["فَإِذا كانَ قاضِياً ذلِكَ الحُس","نُ يدينُ العباد تَحتَ الخفاءِ",21,"ا",2,0],["فَإِذا كانَ عِلمُها علمَ حالٍ","حائلٍ في اِنفعالها عنهُ آني",22,"ن",2,0],["فَإذَا كانَت طَوَايَاكَ الَّتي","بَينَ جَنبَيكَ كَذَا فِيهَا ضَلُولُ",23,"ل",1,0],["فإذا كانتِ التمائم للحبِّ","إذا ما أتمها تمَّ حبي",24,"ب",2,0],["فإذا كانت العقول رِصاناً","كلُّ فعل لهن فعلٌ صواب",25,"ب",1,0],["فَإِذا كانَ فيهِ هَجر وَصَدٌّ","أَو فُراقٌ يَطول فَهُوَ المَنون",26,"ن",1,0],["فإذا كان منه عندكك فضل","فابذل الفضل واغتنم شكراني",27,"ن",2,0],["فإذا كانَ بَعْدَ بدئي معادي","حبّكم يا بني الوصيّ عتادي",28,"ي",1,0],["فإذا كنت أكبر الناس قدراً","ما لنا لا نرى بك استكبارا",29,"ر",2,0],["فإذا كنتَ راضياً أنت عنِّي","لا أُبالي أنْ يضمر الدهر حقدا",30,"د",2,0],["فإِذا كَتَبْتُ بناظِرِي في قَلبِهِ","أَخْفى فخطَّ بناظِرَيْهِ جَوَابِي",31,"ب",2,0],["فإذا كتبا وإذا خطبا","لا تدري أيهما الأجود",32,"د",1,0],["فإذا كفرتَ بنا فعدلٌ أننا","نمضي بغيرِ التاج للمستقبل",33,"ل",1,0],["فإذا كشفتَ ضميرَه متنصِّلاً","ألفيتَ خيرَ بطانة تتكشَّفُ",34,"ف",1,0],["فإذا كنت للمبارك خلاً","فلك الدهر خادم وخليل",35,"ل",1,0],["فإذا كنت فكوني خطأ","وهو ذنب كان مني وقعا",36,"ع",2,0],["فإذا كفَى التأريخُ يوماً غيرَها","يأتي مُؤرِّخُها بتأريخينِ",37,"ن",1,0],["فَإِذا كادَت الحَرب أَن تَنجَلي","وَيَطرح الجُند ذاكَ العَنا",38,"ا",1,0],["فَإِذا كانَ في الوَغى ذا ثباتٍ","حزَّ بِالسَيف رَأسَه أَو سباه",39,"ا",2,0],["فَإِذا كانَ في القيامةِ نودي","مَن قتيلُ الهَوى تَقدّمت وَحدي",40,"ي",1,0],["فإذا كان لها فحل فمَنْ","أرضعته ابنهُ من ذا الغُذَيّ",41,"ي",1,0],["فإذا كانَ هَكذَا ثَبَتَ الحا","مِلُ والفَاِعلُ اللَّطيفُ الَجليلُ",42,"ل",1,0],["فَإِذَا كَانَ عَطَاءٌ فَاتِهِمْ","وإِذَا كَانَ قِتَالٌ فَاعْتَزِلْ",43,"ل",1,0],["فإذا كنت للتلقي محلا","فاشهد العلم ما حيا للجهاله",44,"ل",2,0],["فإذا كتبت به الثناءَ فإنما","كان المداد له مداد فؤادي",45,"د",2,0],["فإذا كتهلت وما الشباب براجعٍ","أبصرت في ذا الرسم عهد شبابي",46,"ي",1,0],["فإذا كنتَ طائراً ففؤادي","طائر يشتهي نظيرَك جارا",47,"ر",2,0],["فإذا كان عليها","صدأ فهو جهاله",48,"ل",2,0],["فإِذا كل ساحلٍ لسُراها","في انتظار وأهلُه في ارتقاب",49,"ب",1,0],["فإذا كان ذلك الحزن رشداً","فلماذا خير الورى ينهاها",50,"ا",3,0],["فإذا كان ضلة فهو لولا","أنه ذو مضلّة ما أتاها",50,"ا",3,0],["فإذا كان يجذبك نعت الطعام","إذا الجوع ناب أذاه فمه",51,"م",2,0],["فإذا كان عسر أطلقَ العبد حمده","على كلِّ حالٍ منه في نفعٍ أو ضرّ",52,"ر",1,0],["فإذا كنت معي أنت معي","وإذا ما لم تكن لستَ معي",53,"ع",2,1],["فَإِذا كَتمت الشَوق بَينَ جَوانِجي","باحَت بِهِ عَيني وَإِن لَم أَنبُس",54,"س",1,0],["فإذا كشفت القلب منه وجدته","وبقلبه تتزاحم الآثام",55,"م",1,0],["فاذا كان من يعود مطيلا","لم يكن عائدا وكان بغيضا",56,"ض",2,0],["فإذا كان عليلاً","بطلت تلك العوامل",57,"ل",1,0],["فاذا كنتَ بعد ذا حيثُ لا يُم","كنُ بُرءٌ رجوتَ منهُ العجائب",58,"ب",1,0],["فاذا كانَ في الثناءِ قصورٌ","فَعلينا قصورنا قد عادا",59,"د",2,0],["فإذا كانت المروءة فيه","بر من غير أن يكون ابتذال",60,"ل",1,0],["فَإِذا كانَ للتطرُّف أَبطا","لٌ فَإِنّي العَريقُ في أَبطاله",61,"ل",2,0],["فَإِذا كانَ في الخَفيّات شكّ","فمن الشكّ ما يَعود يَقينا",62,"ن",2,0],["فإذا كنتَ مُسعِفاً كُلَّ قصْدٍ","ومُنيلاً في الدّهْرِ ما لا يُنالُ",63,"ل",1,0],["فإذا كتبت الشعر بعد أوانه","يأتي عليه تصنعٌ وتكلفُ",64,"ف",1,0],["فإذا كرهتَ الصبرَ فاعلَم أَنَّما","حقّاً كَرِهتَ بأن تكون مكلَّلا",65,"ل",2,0],["فاذا كسوناكم حداد مأتم","ابنا بصافية الاديم عروس",66,"س",1,0],["فَإِذا كَتَبتُ لِكَي أُنَزِّهَ ناظِري","في حُسنِ لَفظِكَ لَم تَجُد بِجَوابِ",67,"ب",1,0],["فإذا كمنا الأمر ثم بدا","في وجهه ربٌّ عتا جبنا",68,"ن",2,0],["فَإِذا كَسا الرَوع القُلوب رَأَيتَني","