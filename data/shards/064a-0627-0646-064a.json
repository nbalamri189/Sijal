{"poems":[[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[90,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[74,"سقا زمان الصبا يا منزل الهرم","https://www.aldiwan.net/poem19688.html","البسيط"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[108,"تراشق القادة","https://www.poetsgate.com/ViewPoem.aspx?id=179639",""],[79,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[435,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[458,"أمودعي من قبل أن يلقاني","https://www.aldiwan.net/poem61317.html","الكامل"],[505,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[534,"يا نيري فلك العلياء قد طلعت","https://www.aldiwan.net/poem37483.html","البسيط"],[563,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59237","السريع"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205623","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[1552,"","https://poetry.dctabudhabi.ae/diwan/poem/203246","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101060","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101029","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125483","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201718","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2370,"","https://poetry.dctabudhabi.ae/diwan/poem/121521","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129857","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79709","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130045","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216558",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138657",""],[3680,"","https://poetry.dctabudhabi.ae/diwan/poem/203329","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81247","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81243","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139736",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102008","البسيط"],[4679,"يانيل قد فاضت دموعي نيلاً","https://www.poetsgate.com/ViewPoem.aspx?id=142756",""],[4869,"آخر بيت","https://www.poetsgate.com/ViewPoem.aspx?id=151563",""],[1470,"نبع الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=12967",""],[5183,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180185",""],[5216,"النّيل","https://www.poetsgate.com/ViewPoem.aspx?id=186992",""],[5285,"الكلُّ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203143",""],[5285,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=203201",""],[5376,"يا نيل مصر","https://www.poetsgate.com/ViewPoem.aspx?id=215093",""],[470,"ما زلتِ نبضَ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=178072",""],[470,"في عيد ميلادها","https://www.poetsgate.com/ViewPoem.aspx?id=178041",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[5895,"نبض النيل","https://www.poetsgate.com/ViewPoem.aspx?id=198611",""],[6004,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=33680",""]],"verses":[["يَا نَيِّراً لَوْلاَ تَوُقُّدُ نُورِهِ","هَفَتِ الحُلُومُ وَفَالَتِ الآرَاءُ",0,"ا",2,0],["يا نيّراً فجع القريض بموته","فبكته عين وزينة وكسيره",1,"ر",2,0],["يا نيل مصر ودمعي لا يحلّ بكما","عهد الوفاءَين من جارٍ ومنسجم",2,"م",1,0],["يا نيلُ وَالموفونَ فيكَ قَلائِلٌ","لَيتَ الذُعافَ لِمَن يَخونُكَ مَشرَبُ",3,"ب",1,0],["يا نيل مصر وفي الأيام موعظة","ماذا لقيت من الدنيا واهليها",4,"ي",3,0],["يا نيلُ أَنتَ يَطيبُ ما نَعَتَ الهُدى","وَبِمَدحَةِ التَوراةِ أَحرى أَخلَقُ",5,"ق",1,0],["يا نيازي تَعال وانظر الى الدس","تور في بَغداد الى أَين صارا",6,"ر",2,0],["يَا نَيِّراً جِرْؤُ السِّقَامِ فَنَالهُ","عَجَباً أَيقْتَحِمُ السِّقَامُ النَّيِّرَا",7,"ر",2,0],["يا نيلُ، جُذْ بدمعك المْدرَارِ","على بناءِ سعيدِ، المُنهارِ",8,"ر",1,0],["يا نيِّراً لولا توقدُ نورِهِ","هفتِ الحلومُ وفالطتِ الأراءُ",9,"ا",2,0],["يا نيسماً في وادي الجنان","فاسترقّ الروح منا والجنان",10,"ن",1,0],["يا ن يرف النقش نفض يراعه","بيتيمة الألحان والألوان",11,"ن",1,0],["يا نِياقَ الرَّكبِ جِدِّي","واطْفِئِ نارَ اشْتِياقي",12,"ق",2,0],["يا نَيِّرَيْ فَلَكِ العَلْياءِ قَدْ طَلَعَتْ","شُمُوسُ سِرَّكُما بالفَتْحِ والفَرَجِ",13,"ج",1,1],["يا نياماً عبِّروا الرؤيا به","هو حقٌّ وسوى الحق ضلال",14,"ل",1,0],["يا نير الأفق وكهف القرى","ومنتهى السؤل وعين المرام",15,"م",1,0],["يَا نَيِّرَ الخَدّ وَلاَ نَيِّرٌ","إلاَّ بِآفَاقِ البَهَا طَالِعُ",16,"ع",1,1],["يا نيل إن سغت للمستعمرين ولم","تطب لأبنائك العلاّت والجرع",17,"ع",1,0],["يا نيّري فلكِ المعالي مَن غدا","لهما بكلّ سماءِ مجدٍ مَشرِق",18,"ق",1,0],["يا نياق الحجيج لا ذقت سهداً","بعدها لا ولا تجشمت وخدا",19,"د",2,1],["يا نيل أنت روح هذا الوادي","تحميه من جدب ومن فساد",20,"د",1,0],["يا نيل أنت ثارء مصر وغيثها","والأرض قفر والبلاد محول",21,"ل",1,0],["يا نيخاؤُسَ اليوم أصبح قُطرُنا","من نُورِهِ السامي يَزُولُ ظلامُ",22,"م",1,0],["يا نيلُ مجراك تسرى","منه لمصر الحياه",23,"ه",1,0],["يا نياماً ليتهم تحت الثرى","عاينوا ما فوقه في الحلم",24,"م",1,0],["يا نُيوبَ البَغي لَحمي كولِيرا","فَإِن اِسطَعتِ فَمِن لَحمي كُلي",25,"ل",2,0],["يا نيل قد عوّدتنا منك الوفا","إذ كنت تأتينا على ميعاد",26,"د",1,0],["يا نيل مصر أين حمصُ ونهرها","حيث المناظر أنجمٌ تلتاح",27,"ح",1,1],["يا نيل سر إني يا نيل منك فدى","وأنت يا شعب لا تصخب ولا تثر",28,"ر",1,0],["يا نيلُ أنت أجلّ ما يُرجى لنا","هل كانَ إلّا في ورودك عزّنا",29,"ن",2,0],["ياني خَطَّه وِسط قِرْطاسِ","وانحِنيت اقَبِّل حروفه",30,"ف",2,0],["يا نيلُ أَنتَ أَبٌ لَنا","وَأَبو الأَعِزَّة لا يذلُّ",31,"ل",1,0],["يا نيراً ملأ العوالم نوره","لولاه شابه ليلها أيامها",32,"م",3,0],["يا نيل يا ملك المياه بأسرها","ما في وقوفك ساعة من بأس",33,"س",1,0],["يا نيرا راق مرآه ومخبره","فكان للدهر ملء السمع والبصر",34,"ر",1,0],["يا نَيل لَم تَحبس لإِنسان","يَخفق مِن جَنبيك قَلبان",35,"ن",1,1],["يا نَيل يا آية ما لِلقَضاء","مِن جبرة تَدفع شَتّى الصُوَر",36,"ر",1,0],["يا نيراً هو بالكمال تمامُ","بضياء غرَّتك انمحى الإظلامُ",37,"م",1,1],["يا نيراً فاق كل النيرات سناً","فمن سناه ضياء الشمس والقمر",38,"ر",1,0],["يانيل قد فاضت دموعي نيلاً","شوقاً لمن بحماك بات نزيلاَ",39,"ل",2,1],["يا نيلُ إن يكُفي رباك مقيلهُ","فلهُ فؤادي قد خصصت مقيلاَ",39,"ل",2,0],["ياني تعبت اسمعك مع من يسميني","واكلمه باسمك ولاضاق اشكي له",40,"ل",2,0],["يا نيلُ.. يا نبعَ الخلود.. حنانا","حيّتْكَ في فجر الوثوب.. دِمانا",41,"ن",2,1],["يا نيل - والجنّات أنتَ ضممتَها","في لهفة، وحضنتَها ولهانا",41,"ن",2,0],["يا نيلُ: أشبالُ الكنانة أقدموا","يتقحّمون الموت.. والنيرانا",41,"ن",2,0],["يا نيلُ.. يا نبعَ الحياة.. وفيضها","قد شاء شعبك أن يكون، فكانا",41,"ن",2,0],["يا نيلُ.. شرعُ الغاصبين مقاصلٌ","ومجازر لا تعرف الإيمانا..",41,"ن",2,0],["يا نيلُ بُشرى سوف ينكشف الأذى","وتعود ترفل هانئاً جذلانا",41,"ن",2,0],["يا نيلُ دمتَ على الزمان مُخلَّداً","وبقيتَ تروي مِصرَ والسودانا",41,"ن",2,0],["يا نيل مصر عظمت عن مثل","وصفا فأين النظم والنثر",42,"ر",1,0],["يانيلُ قُل لي هل وُلِدتَ جليلا","أمْ خَيلُ مصرٍ أرضَعَتْك صَهيلا",43,"ل",2,1],["يانيلُ قل لي لو عَلِمت فصاحةً","لغَلَبْتَ كلَّ العالَمينَ مَقيلا",43,"ل",2,0],["يانيلُ أنتَ غِذاؤنا وكِساؤنا","أبقاكَ رَبّي مُحْسِنًا وَفَضيلا",43,"ل",2,0],["يا نيلُ فلتشهدْ على عهدٍ لنا","قد وثَّقَتْهُ نجمةُ الأفلاكِ",44,"ك",1,0],["يا نيلُ سحرك في الدجى قنديلُ","قد شاقني من ثغركَ التقبيلُ",45,"ل",1,1],["يا نيل مصر لك الخمائل كلها","تربو ضفافك جنة وهضابُ",46,"ب",1,0],["يا نيل أنت هواء كل متيم","فبك الرجاء فلا يطول غيابُ",46,"ب",1,0],["ياني.. وحسبُكِ إن أقُلْ","ياني، يُغالبني بكائي!",47,"ا",3,0],["ياني.. وعمرُكِ عمري.. لو تُخيِّرُني ال","دنيا، تَنازلتُ عن عرشي وأختامي",48,"م",2,0],["ياني.. سأسألُ عرشَ اللهِ مغفرَةً","أنْ قلتُ: ياني.. على أطرافِهِ نامي!",48,"م",2,0],["ياني.. لعيدِكِ أضلاعي سأُسرِِجُها","شَمعاً، واخشَعُ من رأسي لأقدامي",48,"م",2,0],["يانياق الشوق رفقا في الهوى","قد اصاب الشوق اكباد الصحاحِ",49,"ح",1,0],["يا نيلُ سَتَبقَى مُنْتَصِراً بِعَزَائِمَ سُمْرٍ تتشَمَّرْ","فرِمالى مَلَّتْ قَفْرَتَها وسَراباً فِيها يَسْتَعْمِرْ",50,"ر",1,0],["يَاْنِيْلُ شَهْدَاً جَرَيْ فِيْ الأرْضِِ مِنْ أزلٍ","تَزْهوْ وَعَنْ صَرحِ أَمْجَاْدِي تُحَدّثُنِيْ",51,"ن",2,0]]}