{"poems":[[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[3,"أرض الشربة تربها كالعنبر","https://www.aldiwan.net/poem163.html",""],[86,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[85,"بعدت ديار واحتوتك ديار","https://www.aldiwan.net/poem7354.html","الكامل"],[85,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[85,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[105,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[105,"أتنام عينك والعيون سهاد","https://www.aldiwan.net/poem42119.html","الوافر"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[105,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"يا أيها الشعب الذلول أما كفى","https://www.aldiwan.net/poem43103.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[105,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[105,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[75,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85486","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10814","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9931","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[39,"إنَّ الفؤادَ هفَا للبائنِ الغردِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7469&r=&rc=9",""],[105,"ناد القبور وبشر كل مقبور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55005&r=&rc=175",""],[105,"عرش القياصر والقضاء إذا جرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54945&r=&rc=115",""],[100,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""],[113,"بلذة العيش عش يا خالي البال","https://www.aldiwan.net/poem40629.html","عموديه"],[118,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[148,"ضعوا فوق قلبي راحة الصبر إنني","https://www.aldiwan.net/poem68562.html","الطويل"],[148,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[196,"بيني وبين الحادثات خصام","https://www.aldiwan.net/poem51882.html","الكامل"],[219,"ضجة جاوزت عنان السماء","https://www.aldiwan.net/poem55257.html","الخفيف"],[224,"صوت الوطنية","https://www.aldiwan.net/poem24224.html","عموديه"],[248,"ضننت على نفسي وقد كنت قادرا","https://www.aldiwan.net/poem15068.html","الطويل"],[269,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[282,"عاد الشمقمق في الخسارة","https://www.aldiwan.net/poem44310.html","مجزوء الكامل"],[326,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[326,"بعد حين ستواريني كما","https://www.aldiwan.net/poem55021.html","مجزوء الرمل"],[402,"ضج من نتن ريقك المكان","https://www.aldiwan.net/poem49701.html","الخفيف"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[459,"تناط أيادي الله منه وعنده","https://www.aldiwan.net/poem15663.html","الطويل"],[468,"خليلان باحا بالهوى فتشاحنت","https://www.aldiwan.net/poem4631.html","الطويل"],[513,"اسمع بذي الفتح المبين وأبصر","https://www.aldiwan.net/poem12148.html","الكامل"],[549,"يا ليلة لما نأى بدرها","https://www.aldiwan.net/poem48067.html","السريع"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[560,"يا حسن يوم إليه الناس قد جمعت","https://www.aldiwan.net/poem52640.html","البسيط"],[560,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[560,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"]],"verses":[["ضَجيعُ الهُوَينا يَغلِبُ الخَصمُ رَأيَهُ","وَأَكبَرُ سُلطانِ الرِجالِ الخَصائِمُ",0,"م",1,0],["ضَجَّتِ الخَيلُ مِن سَرايايَ حَتّى","لَحَسَدنَ البِطاءَ قُبُّ الجِيادِ",1,"د",1,0],["ضَجِرتَ مِنَ العَلياءِ فَاِختَرتَ عَزلَها","كَأَنَّكَ قَد أَفنَت نَداكَ المَحامِدُ",2,"د",1,0],["ضَجّوا فَصُحتُ عَلَيهِمُ فَتَجَمَّعو","وَدَنا إِلَيَّ خَميسُ ذاكَ العَسكَرِ",3,"ر",1,0],["ضَجَّتِ الأَفلاكُ مِن أَهوالِها","وَاِستَعاذَ الشَمسُ مِنها وَالقَمَر",4,"ر",1,0],["ضَجّوا مِنَ الحَربِ إِذ عَضَّت غَوارِبَهُم","وَقَيسُ عَيلانَ مِن أَخلاقِها الضَجَرُ",5,"ر",1,0],["ضجت عواد بالبَراح روائح","وشكا حديد سابح وبخار",6,"ر",1,0],["ضَجَّت عَلَيكِ مَآذِنٌ وَمَنابِرٌ","وَبَكَت عَلَيكَ مَمالِكٌ وَنَواحِ",7,"ح",1,0],["ضَجَّت لِمَصرَعِ غالِبٍ","في الأَرضِ مَملَكَةُ النَباتِ",8,"ت",1,1],["ضَجَّت عَلى أَبطالِها ثُكُناتُهُ","وَاِستَوحَشَت لِكُماتِها النُزّاحِ",9,"ح",1,0],["ضَجَّت عَلَيكِ مَعالِماً وَمَعاهِداً","وَبَكَت فُراقُكِ بِالدُموعِ الهُمَّعِ",10,"ع",1,0],["ضَجَّ الحِجازُ وَضَجَّ البَيتُ وَالحَرَمُ","وَاِستَصرَخَت رَبَّها في مَكَّةَ الأُمَمُ",11,"م",1,1],["ضَجيعُ مُسَنَّدينَ بِكَفرِ توثى","خُفوتاً مِثلَ ما خَفَتَ الشُروبُ",12,"ب",1,0],["ضَجَّت لِوَقعِ الماءِ وَاِضطَرَبَت","مِن غَيرِ إِيلامٍ وَلا مَضِّ",13,"ض",1,0],["ضَجِرَ الَّذي جاراهُ حينَ رَأى","سَهمَ القَضاءِ بِأَمرِهِ يَمضي",13,"ي",1,0],["ضَجَّةٌ تَمضِي وأخرَى تَذهبُ","أَرأَيتُمْ كيفَ ذَابَ الموكبُ",14,"ب",1,0],["ضجّت لمصرعك الكنانةُ ضجّةً","كادت تميد لهولها الأطوادُ",15,"د",1,0],["ضَجَّ الحريبُ فقالوا هَزَّهُ طربٌ","وهَاجَهُ العهدُ مِن عِلمٍ ومن نُورِ",16,"ر",1,0],["ضَجَّ الكِتابُ وَضَجَّ البَيتُ مِن أَسَفٍ","وَباتَ فيكم رَسولُ اللَهِ غَضبانا",17,"ن",2,0],["ضَجَّ الزَمانُ اِرتِياعاً مِن جَرائِرِها","وَذاقَتِ المُرَّ مِن أَخلاقِها الحِقَبُ",18,"ب",1,0],["ضَجَّت بِلادُكَ تَشكو ما صَنَعتَ بِها","دَعها تَضِجُّ وَتَشكو غَيرَ أَسوانِ",19,"ن",1,0],["ضَجَّ الدَمُ المَسفوكُ في يَدِ عُصبَةٍ","جُنَّت بِقَتلِ الأَبرِياءِ جُنونا",20,"ن",2,0],["ضَجَّ النُعاةُ فَما بَكى حُلَفاؤُكُم","أَينَ الدُموعُ وَكَيفَ يَبكي الجاني",21,"ن",2,0],["ضَجَّت شُعوبُ الأَرضِ عِندَ هُوِيِّهِ","وَاِرتَجَّتِ الأَقدارُ وَالبُلدانُ",22,"ن",1,0],["ضَجَّتِ الأَرضُ تُحيِّي أُمَماً","صَرَعَ الظُلمَ بَنوها البُسَّلُ",23,"ل",1,0],["ضَجَّ الصَباحُ لِما لاقَت طَلائِعُهُ","مِن سوءِ أَعمالِهِم وَاِستَعبَرَ الغَسَقُ",24,"ق",1,0],["ضَجَّت شُعوبُ المُسلمين وَراعهم","ظُلمُ الأُلى لَولا السياسَةُ أَنصفوا",25,"ف",3,0],["ضَجَّ النُّعاةُ فهزَّ يثربَ وَجدُها","وهفا بِمَكَّةَ شَجُوها المتنوِّعُ",26,"ع",1,0],["ضجّتِ الكائناتُ هل من سفيرٍ","يتلافى الدُّنى فكنتَ السفيرا",27,"ر",2,0],["ضجعتي في الرياضِ بين الرياحي","ن قريباً من ماءِ عَيْنٍ مَعين",28,"ن",1,0],["ضَجَّت تَميمٌ وَأَحزَتها مَثالِبُها","يُنقَلنَ مِن بَلَدٍ ناءٍ إِلى بَلَدِ",29,"د",1,0],["ضَجرتُمُ وأتانا من مَلامكُمُ","ومن معاريضِكُم ما يُشبهُ الضَّجَرا",30,"ر",2,0],["ضَجْعَةُ المَوْتِ رَقْدَةٌ يُستريحُ ال","جِسْمُ فيها والعَيشُ مِثلُ السّهادِ",31,"د",1,0],["ضَجَّ النُعاةُ فَضَجَّ كُلُّ مُوَحِّدٍ","وَاِرتَجَّ ما بَينَ الحَطيمِ وَزَمزَمِ",32,"م",1,0],["ضجرت من هَذا السكون القبورُ","انفضوا عنكم الخمول وَثوروا",33,"ر",3,0],["ضجرت نَفسي من توالي الليالي","واستملّت تعاقب الأيام",34,"م",1,0],["ضَجَّت الأنجمُ في آفاقها","ذاتَ ليلٍ تشتكي طولَ الأبَدْ",35,"د",1,1],["ضَجيعَينِ في قَبرٍ عَنِ الناسِ مُعزَلٍ","وَنُقرَنُ يَومَ البَعثِ وَالحَشرِ وَالنَشرِ",36,"ر",1,0],["ضَجّوا فَصُحتُ عَلَيهِمُ فَتَجَمَّعوا","وَدَنا إِلَيَّ خَميسُ ذاكَ العَسكَرِ",37,"ر",1,0],["ضجّت الصحراء تشكوعريها","فكسوناها زئيراً ودخانا",38,"ن",2,0],["ضَجَّ أَبوكَ الكَظيمُ مِمّا","نالَكَ وَالدَمعُ لا يَغيضُ",39,"ض",1,0],["ضجيعَ التراب، أطلتَ الرقودَا","عزيزٌ على الضاد ألا تعودَا!",40,"د",2,1],["ضجّتْ بناتُ الماء منه وأوشكتْ","تجفو الطيورُ لأجله أوكارها",41,"ر",3,0],["ضَجَّتْ تَمِيمٌ، وأخْزَتْها مَثَالِبُها","يُنْقَلْنَ مِنْ بَلَدٍ نَاءٍ إلَى بَلَدِ",42,"د",1,0],["ضج الحريب فقالوا هزه الرب","وهاجه العهد من علم ومن نور",43,"ر",1,0],["ضجت شعوب الأرض عند هوية","وارتجت الأقطار والبلدان",44,"ن",1,0],["ضجيج فراغ ، يلوك صداه","ويوهم شدقيه ، بالازدراد",45,"د",1,0],["ضج المحبون يبكي كلهم فرحا","والدمع ما بين مواج وسيال",46,"ل",1,0],["ضج من لؤمك الخلائق في الأر","ض وعاذوا من شره في السماء",47,"ا",2,0],["ضَجِيعايَ سُهدٌ لا يَغيبُ ووَحشَةٌ","وأنَّى لمِثلي بالتَّسلَّي وبالغُمضِ",48,"ض",1,0],["ضَجيعاهُ نالا كُلَّ أَمنٍ وَمِنَّةٍ","بِقُربِ العُلا وَالمَجدِ وَالسؤددِ المَحضِ",49,"ض",1,0],["ضجَّتْ لمصرعكَ النوادبُ ضجَّةً","سدَّت مسامعَها لها الأيام",50,"م",1,0],["ضجة جاوزت عنان السماء","عند وادي من الأنيس خواءِ",51,"ا",2,1],["ضجّت الدنيا فماذا ترتقب","مصر من أهوالها حتى تثب ؟",52,"ب",1,1],["ضجت الدنيا من الهول الذي","ترك الدنيا جميعاً تضطرب",52,"ب",1,0],["ضجيعاهُ رضوان الإله عليهما","بَريئان ممنَ كان يُعزى إلى الرَّفضِ",53,"ض",1,0],["ضَجيع رَسول اللَه مظهر دينه","غضنفره في اللَه يَرضى وَيَغضَب",54,"ب",1,0],["ضَجّوا فَقُلتُ تَصَبَّروا","فَالنَجحُ يَقرنُ بِالصباره",55,"ر",2,0],["ضجّتِ الدنيا لها جازِعَةً","ثم غنّت بعد أن مات الذُبال",56,"ل",1,0],["ضجّت الأرض وعافتني","غدوّاً ورواحا",57,"ح",2,0],["ضَجَّ مِنْ نَتْنِ رَيِّقِكَ الْمَكَانَ","واستَغاثا بِمُنْزِلِ الفُرْقانِ",58,"ن",1,1],["ضجَّتْ منابرُها بدعوتها لكم","فلو ادعت بكم النبوَّةَ صُدِّقَتْ",59,"ت",1,0],["ضَجيجُ حجيج عرَّفوا بِسويْمقٍ","كفيلِ لهم ممَّنْ دعاهم بغافرِ",60,"ر",1,0],["ضَجيعٌ دَنا مِنّي جَذِلتُ بِقُربِهِ","فَباتَ يُمَنِّيني وَبِتُّ أُعاتِبُهُ",61,"ب",2,0],["ضجر الحديد من الحديد وشاور","في نصر آل محمد لم يضجر",62,"ر",1,0],["ضَجيعَ جِسمي وَغَرامِي بهِ","ضَجيع أسرارِيَ في قلبي",63,"ي",1,0],["ضج قومي وحاولوا الترجيحا","فرموا نحوها لحاظاً صحيحا",64,"ح",2,0],["ضجت الأسواق منه وقد","ملت الخانات والربط",65,"ط",1,0],["ضجَّت بتَطهيرِهِ الدُّنيا مُؤرِّخةً","أبهَى طَهورٍ أتى نُوراً على نُورِ",66,"ر",1,0],["ضجَّتْ بمصرَعهِ مصرٌ وساحتُها","وضجَّت الشَّامُ فارتَّجت بها الأكَمُ",67,"م",1,0],["ضَجَّت بهِ الإسكنْدَريَّةُ هَيبةً","فكأنَّ فوقَ سريرهِ الإسكَنْدَرا",68,"ر",2,0]]}