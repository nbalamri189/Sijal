9",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5377,"صوت الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79570&r=&rc=26",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[231,"الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79157&r=&rc=31",""],[6211,"ضَجِرٌ كما شفتاك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78241&r=&rc=12",""],[2588,"شاخصة (فلسطين)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65593&r=&rc=25",""],[6277,"بالجميل اللذيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64477&r=&rc=40",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6336,"المجاهدون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73557&r=&rc=18",""],[5190,"إطلالة على العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78300&r=&rc=13",""],[6355,"حصاد الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66593&r=&rc=53",""]],"verses":[["ضَجيعُ الهُوَينا يَغلِبُ الخَصمُ رَأيَهُ","وَأَكبَرُ سُلطانِ الرِجالِ الخَصائِمُ",0,"م",1,0],["ضَجَّتِ الخَيلُ مِن سَرايايَ حَتّى","لَحَسَدنَ البِطاءَ قُبُّ الجِيادِ",1,"د",1,0],["ضَجِرتَ مِنَ العَلياءِ فَاِختَرتَ عَزلَها","كَأَنَّكَ قَد أَفنَت نَداكَ المَحامِدُ",2,"د",1,0],["ضَجّوا فَصُحتُ عَلَيهِمُ فَتَجَمَّعو","وَدَنا إِلَيَّ خَميسُ ذاكَ العَسكَرِ",3,"ر",1,0],["ضَجَّتِ الأَفلاكُ مِن أَهوالِها","وَاِستَعاذَ الشَمسُ مِنها وَالقَمَر",4,"ر",1,0],["ضَجّوا مِنَ الحَربِ إِذ عَضَّت غَوارِبَهُم","وَقَيسُ عَيلانَ مِن أَخلاقِها الضَجَرُ",5,"ر",1,0],["ضجت عواد بالبَراح روائح","وشكا حديد سابح وبخار",6,"ر",1,0],["ضَجَّت عَلَيكِ مَآذِنٌ وَمَنابِرٌ","وَبَكَت عَلَيكَ مَمالِكٌ وَنَواحِ",7,"ح",1,0],["ضَجَّت لِمَصرَعِ غالِبٍ","في الأَرضِ مَملَكَةُ النَباتِ",8,"ت",1,1],["ضَجَّت عَلى أَبطالِها ثُكُناتُهُ","وَاِستَوحَشَت لِكُماتِها النُزّاحِ",9,"ح",1,0],["ضَجَّت عَلَيكِ مَعالِماً وَمَعاهِداً","وَبَكَت فُراقُكِ بِالدُموعِ الهُمَّعِ",10,"ع",1,0],["ضَجَّ الحِجازُ وَضَجَّ البَيتُ وَالحَرَمُ","وَاِستَصرَخَت رَبَّها في مَكَّةَ الأُمَمُ",11,"م",1,1],["ضَجيعُ مُسَنَّدينَ بِكَفرِ توثى","خُفوتاً مِثلَ ما خَفَتَ الشُروبُ",12,"ب",1,0],["ضَجَّت لِوَقعِ الماءِ وَاِضطَرَبَت","مِن غَيرِ إِيلامٍ وَلا مَضِّ",13,"ض",1,0],["ضَجِرَ الَّذي جاراهُ حينَ رَأى","سَهمَ القَضاءِ بِأَمرِهِ يَمضي",13,"ض",2,0],["ضَجَّةٌ تَمضِي وأخرَى تَذهبُ","أَرأَيتُمْ كيفَ ذَابَ الموكبُ",14,"ب",1,0],["ضجّت لمصرعك الكنانةُ ضجّةً","كادت تميد لهولها الأطوادُ",15,"د",1,0],["ضَجَّ الحريبُ فقالوا هَزَّهُ طربٌ","وهَاجَهُ العهدُ مِن عِلمٍ ومن نُورِ",16,"ر",1,0],["ضَجَّ الكِتابُ وَضَجَّ البَيتُ مِن أَسَفٍ","وَباتَ فيكم رَسولُ اللَهِ غَضبانا",17,"ن",2,0],["ضَجَّ الزَمانُ اِرتِياعاً مِن جَرائِرِها","وَذاقَتِ المُرَّ مِن أَخلاقِها الحِقَبُ",18,"ب",1,0],["ضَجَّت بِلادُكَ تَشكو ما صَنَعتَ بِها","دَعها تَضِجُّ وَتَشكو غَيرَ أَسوانِ",19,"ن",1,0],["ضَجَّ الدَمُ المَسفوكُ في يَدِ عُصبَةٍ","جُنَّت بِقَتلِ الأَبرِياءِ جُنونا",20,"ن",2,0],["ضَجَّ النُعاةُ فَما بَكى حُلَفاؤُكُم","أَينَ الدُموعُ وَكَيفَ يَبكي الجاني",21,"ن",2,0],["ضَجَّت شُعوبُ الأَرضِ عِندَ هُوِيِّهِ","وَاِرتَجَّتِ الأَقدارُ وَالبُلدانُ",22,"ن",1,0],["ضَجَّتِ الأَرضُ تُحيِّي أُمَماً","صَرَعَ الظُلمَ بَنوها البُسَّلُ",23,"ل",1,0],["ضَجَّ الصَباحُ لِما لاقَت طَلائِعُهُ","مِن سوءِ أَعمالِهِم وَاِستَعبَرَ الغَسَقُ",24,"ق",1,0],["ضَجَّت شُعوبُ المُسلمين وَراعهم","ظُلمُ الأُلى لَولا السياسَةُ أَنصفوا",25,"ف",3,0],["ضَجَّ النُّعاةُ فهزَّ يثربَ وَجدُها","وهفا بِمَكَّةَ شَجُوها المتنوِّعُ",26,"ع",1,0],["ضجّتِ الكائناتُ هل من سفيرٍ","يتلافى الدُّنى فكنتَ السفيرا",27,"ر",2,0],["ضجعتي في الرياضِ بين الرياحي","ن قريباً من ماءِ عَيْنٍ مَعين",28,"ن",1,0],["ضَجَّت تَميمٌ وَأَحزَتها مَثالِبُها","يُنقَلنَ مِن بَلَدٍ ناءٍ إِلى بَلَدِ",29,"د",1,0],["ضَجرتُمُ وأتانا من مَلامكُمُ","ومن معاريضِكُم ما يُشبهُ الضَّجَرا",30,"ر",2,0],["ضَجْعَةُ المَوْتِ رَقْدَةٌ يُستريحُ ال","جِسْمُ فيها والعَيشُ مِثلُ السّهادِ",31,"د",1,0],["ضَجَّ النُعاةُ فَضَجَّ كُلُّ مُوَحِّدٍ","وَاِرتَجَّ ما بَينَ الحَطيمِ وَزَمزَمِ",32,"م",1,0],["ضجرت من هَذا السكون القبورُ","انفضوا عنكم الخمول وَثوروا",33,"ر",3,0],["ضجرت نَفسي من توالي الليالي","واستملّت تعاقب الأيام",34,"م",1,0],["ضَجَّت الأنجمُ في آفاقها","ذاتَ ليلٍ تشتكي طولَ الأبَدْ",35,"د",1,1],["ضَجيعَينِ في قَبرٍ عَنِ الناسِ مُعزَلٍ","وَنُقرَنُ يَومَ البَعثِ وَالحَشرِ وَالنَشرِ",36,"ر",1,0],["ضَجّوا فَصُحتُ عَلَيهِمُ فَتَجَمَّعوا","وَدَنا إِلَيَّ خَميسُ ذاكَ العَسكَرِ",37,"ر",1,0],["ضجّت الصحراء تشكوعريها","فكسوناها زئيراً ودخانا",38,"ن",2,0],["ضَجَّ أَبوكَ الكَظيمُ مِمّا","نالَكَ وَالدَمعُ لا يَغيضُ",39,"ض",1,0],["ضجيعَ التراب، أطلتَ الرقودَا","عزيزٌ على الضاد ألا تعودَا!",40,"د",2,1],["ضجّتْ بناتُ الماء منه وأوشكتْ","تجفو الطيورُ لأجله أوكارها",41,"ر",3,0],["ضَجَّتْ تَمِيمٌ، وأخْزَتْها مَثَالِبُها","يُنْقَلْنَ مِنْ بَلَدٍ نَاءٍ إلَى بَلَدِ",42,"د",1,0],["ضج الحريب فقالوا هزه الرب","وهاجه العهد من علم ومن نور",43,"ر",1,0],["ضجت شعوب الأرض عند هوية","وارتجت الأقطار والبلدان",44,"ن",1,0],["ضجيج فراغ ، يلوك صداه","ويوهم شدقيه ، بالازدراد",45,"د",1,0],["ضجّ سوق الرقيق في ندوة القوم","ونخّاسه طغى واستبدّا",46,"د",2,0],["ضجّت ملائكة السّماء بساخر","مرّ الدعابة شاتم مدّاح",47,"ح",1,0],["ضج المحبون يبكي كلهم فرحا","والدمع ما بين مواج وسيال",48,"ل",1,0],["ضج من لؤمك الخلائق في الأر","ض وعاذوا من شره في السماء",49,"ا",2,0],["ضَجِيعايَ سُهدٌ لا يَغيبُ ووَحشَةٌ","وأنَّى لمِثلي بالتَّسلَّي وبالغُمضِ",50,"ض",1,0],["ضَجيعاهُ نالا كُلَّ أَمنٍ وَمِنَّةٍ","بِقُربِ العُلا وَالمَجدِ وَالسؤددِ المَحضِ",51,"ض",1,0],["ضجَّتْ لمصرعكَ النوادبُ ضجَّةً","سدَّت مسامعَها لها الأيام",52,"م",1,0],["ضجة جاوزت عنان السماء","عند وادي من الأنيس خواءِ",53,"ا",2,1],["ضجّت الدنيا فماذا ترتقب","مصر من أهوالها حتى تثب ؟",54,"ب",1,1],["ضجت الدنيا من الهول الذي","ترك الدنيا جميعاً تضطرب",54,"ب",1,0],["ضجيعاهُ رضوان الإله عليهما","بَريئان ممنَ كان يُعزى إلى الرَّفضِ",55,"ض",1,0],["ضَجيع رَسول 