ظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5390,"كَبِيرٌ بعَيْنَيَّاسْمُكَ يَا وَطنِي","https://www.poetsgate.com/ViewPoem.aspx?id=215720",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5431,"جدوى الحياة....","https://www.poetsgate.com/ViewPoem.aspx?id=205102",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[5550,"كفِّي الصُدود","https://www.poetsgate.com/ViewPoem.aspx?id=213892",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[1680,"أيا نفحة الألطاف من لطف ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=108882",""],[5725,"محمد ادعج العينين وصفا","https://www.poetsgate.com/ViewPoem.aspx?id=184579",""],[5725,"شكوى في الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=186682",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5751,"الذنب أجر المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=214780",""],[5776,"أنينُ المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=199455",""],[5783,"حنين إلى \"نجد\"","https://www.poetsgate.com/ViewPoem.aspx?id=34823",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5956,"تربيتي الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=194887",""],[6068,"رَأَيْتُ الْشَّوْق يأكُلُ مِن عِقَاليِ -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175789",""],[6068,"يعذبني التذكار رائعة البسم -14-","https://www.poetsgate.com/ViewPoem.aspx?id=177649",""]],"verses":[["فَمَن ذا يُراميني وَلي مِنكَ جِنَّةٌ","وَمَن ذا يُدانيني وَلي مِنكَ عاضِدُ",0,"د",1,0],["فَمَن ذا أُسامي وَجَدّي النَبِيُّ","أَم مَن أُطاوِلُ أَم مَن أُلاحي",1,"ح",2,0],["فمَنْ ذا الذي يُهْدي إليكَ مَدائِحاً","كَما أسْلَمَ السِّلْكُ الجُمانَ المُفَصَّلا",2,"ل",2,0],["فمَنْ ذا لهُ جدٌّ كجَدّكَ أو أبٌ","لَلآلئُ والمجْدُ المؤثّلُ نسّاقُ",3,"ق",1,0],["فمَنْ ذالَهُ كالقوْمِ إنْ شِئْتَ في نَدىً","وبأسٍ وفي فضْلٍ وفي صِدْقِ مَشْهَدِ",4,"د",1,0],["فمن ذا منكم قد شقّ قلبي","وهل كشفت لكم فيّ الغيوب",5,"ب",1,0],["فمن ذات دلّ أعجزالشعر وصفها","وأن كان فيها الشعر ممتلئاً عشقا",6,"ق",2,0],["فمن ذا يراهم ثم لم يك واغلاً","عليهم وأن أمسى يعد الفتى الأتقى",6,"ق",2,0],["فمن ذا يضاهيه وجبريل خادمٌ","لمقدمه العالي وعيسى مبشرُ",7,"ر",1,0],["فَمَن ذا الَّذي أَعتاضُ عَنكُم مِنَ الوَرى","يَكونُ حَبيبي مِثلَكُم وَخَديني",8,"ن",2,0],["فَمَن ذا الَّذي تُدنيهِ مِنكَ وَتَصطَفي","فَيَكتُبُ ما يوحى إِلَيكَ وَيَكتُمُ",9,"م",1,0],["فَمَن ذا يَسأَلُ البَجَلِيَّ عَمّا","يَذُمُّ مِنَ اِختِياري أَو يَعيبُ",10,"ب",1,0],["فَمَن ذا الَّذي يَرجو الخِلافَةَ مِنهُمُ","وَقَد قُمتَ فيهِم بِالبَيانِ وَبِالفَصلِ",11,"ل",1,0],["فَمَنْ ذا يَقيها السُّوءَ أم مَنْ يُنَجِّها","دماءَ ذواتِ الذُّلِّ أم مَنْ يَسوسُها",12,"س",3,0],["فَمِنْ ذكورٍ عُراةٍ كالذُّكورِ به","ومن إناثٍ عليها الوَشْيُ والحِبَرُ",13,"ر",1,0],["فمن ذا سواهُ في الورى لا تلمُّهُ","على شَعَثٍ أيُّ الرجال المهذَّبُ",14,"ب",1,0],["فَمَن ذا الَّذي إِن جِئتُ ما أَمَروا بِهِ","يَبيتُ بِهَمٍّ آخِرَ اللَيلِ يَأرَقُ",15,"ق",1,0],["فَمَن ذا الَّذي يَرمي بِسَهمَيكَ في الوَرى","وَعَبدُ مُنافٍ والِداكَ وَحِميَرُ",16,"ر",1,0],["فَمَن ذا يُبلِغُ الحَلّافَ عَنّي","يَقولُ لَهُ فِداكَ أَبو نُواسِ",17,"س",1,0],["فَمَن ذا مُبلِغٌ عَمرواً رَسولاً","فَقَد ذَكَّرتَ وُدَّكَ غَيرَ ناسِ",18,"س",1,0],["فَمَن ذا الَّذي لي مِثلَ ما تَصنَعُ المُنى","إِذا ما أَظَلَّتني المَنِيَّةُ يَصنَعُ",19,"ع",1,0],["فمن ذا وقد أَقصوك عنّا يعولنا","ومن ذا به عنا الطوارئ ندفع",20,"ع",1,0],["فمَن ذَا لِفَصْلِ القَوْلِ يَسْطَعُ نُورُهُ","إِذا نحنُ نَاوَأْنَا الألَدّ المناوبَا",21,"ب",2,0],["فَمِنْ ذَاتِ حُسْنٍ رَدَّ فِتْنَتَهُ التُّقَى","وَمِنْ مَاجِدٍ حُرٍّ ومِنْ سَيِّد حَبْرِ",22,"ر",1,0],["فَمَن ذا يُبَلِّغُهُ عَن أَبيهِ","تَحِيَّةَ ثَكلانَ أَو مَألَكا",23,"ك",2,0],["فمن ذاك للتوفير وهو أجله","ومنه لتمحيص لذنب يواقع",24,"ع",1,0],["فمن ذا لفصل القول يسطع نوره","إذا نحن ناوينا الألد المناويا",25,"ي",2,0],["فَمَنْ ذا يَسألُ النّجليّ عَمّا","يَذُمُّ مِنِ اخْتِيارِي، أوْ يَعيبُ",26,"ب",1,0],["فمن ذا مُبْلغ إياه عنِّي عتاباً","تحته عَتْبٌ ووجْدُ",27,"د",1,0],["فمنذ بها نيطت عليك تمائم","وأنت بها من دون تربك مولع",28,"ع",1,0],["فمنْ ذَا كمسعودٍ سلالةِ راشدٍ","نوالٌ سخىٌّ في الأنام جَزيلُ",29,"ل",1,0],["فَمُنذُ مَلَكتَ الدَهرَ لا زِلتَ رَبَّهُ","غَدا فِعلُهُ فينا مِنِ اِسمِكَ مُشتَقّا",30,"ق",2,0],["فَمَن ذا لِذَبِّكَ عَنهُ اِستَقَلَّ","وَمَن ذا بِعِبئِكَ فيهِ اِستَقَلّ",31,"ل",1,0],["فَمَن ذا يُلزِمُ النَكباءَ ذَنباً","إِذا لَم تَستَطِع لِلهِضبِ نَقلا",32,"ل",2,0],["فَمُنذُ حَلَلتَ ذا البَلَدَ اِستَقَلَّت","غَمائِمُ ضُمِّنَت خَوفاً وَمَحلا",32,"ل",2,0],["فمن ذا الذي أنشَاكَ إذ كنت نطفةً","ضعيفاً ولا لحمٌ عليك ولا عظمُ",33,"م",1,0],["فَمَن ذا الَّذي يَحوي مِنَ الفَضلِ ما حَوى","وَفاءٌ بِلا غَدرِ وَعَقلٌ بِلا هَوى",34,"ه",3,0],["فَمَن ذا الَّذي يَحوي مِنَ الفَضلِ ما حَوى","أَلَيسَ الَّذي ما ضَلَّ قَطُّ وَما غَوى",35,"غ",3,0],["فمن ذا الذي عنها يعفّ وهذه","منافعها إن أمكنته مصائده",36,"د",2,0],["فَمَن ذا رأى في الناسِ شَخصاً موالياً","لِقومٍ يرَونَ الحبَّ في جدّهِ كُفرا",37,"ر",2,0],["فَمُنذُ تُهتُ وَحيداً","وَقَد تَرَكتُك وَحدك",38,"ك",1,0],["فمِنْ ذاكرٍ ربَّه خَشْيةً","ومِنْ مستهل بطول الدعاء",39,"ا",2,0],["فَمَنْ ذَا يُجَارِينِي إِلَى كُلِّ غَايَةٍ","وَمَنْ ذَا يُبَارِينِي وَمَنْ ذَا يُجَادِلُ",40,"ل",1,0],["فمن ذا الذي يرضى الحياةَ يشوبُها","من الجَورِ عيشٌ بالدِّماءِ مُخَضَّبُ",41,"ب",1,0],["فمن ذا الّذي لم يستجب ثمّ يقتفي","بمفرد أهل الله في بعض كتبه",42,"ب",2,0],["فمن ذاقها دارت بهِ الأرضُ دورةً","فأيقَنَ أنَّ العيشَ أكثرُهُ حلم",43,"م",1,0],["فمن ذا يُعزِّيهِ ويَشرحُ صَدرَهُ","ببسطةِ كفٍّ عندها تحسُنُ الحال",44,"ل",1,0],["فَمَنْ ذَا مُبْلِغُ الأَمْلاَكِ عَنَّا","وَسُوِّاسِ الْحَوَاضِرِ وَالْبَوادِي",45,"د",2,0],["فمن ذا الذي استغنى عن الصحب في الدنا","على النصح والامر المهم بروبان",46,"ن",1,0],["فمن ذلك الفضل الردي تكونت","وفي مدخل الأوساخ في الأرض حلت",47,"ت",1,0],["فَمَن ذا يُسَرُّ بِطولِ البَقاء","إِذا كانَ يُبدِعُ هَذي البِدَع",48,"ع",1,0],["فَمَن ذا دَعاكِ أن تحلّي مسامعي","بجوهر ما حزت من اللطف والظرفِ",49,"ف",1,0],["فمنذُ رأَى الوجْهُ ذا البِشْرَ مِنْ","كَ كان له الدَّهرَ بالَسّعْدِ بُشْرى",50,"ر",2,0],["فمَن ذا الذي يَلْقَى مَعانيَّ هذه","ولا يَتمّنى سَعْيَه لِمَصالحي",51,"ح",2,0],["فمَن ذا بتأميرٍ أُخاطِبُ منهمُ","وقد صارَ كلُّ القومِ واليَ مَنبِج",52,"ج",1,0],["فمن ذالنا يا ربنا في أمورنا","سواك ولا أركن بحولي وقوتي",53,"ي",1,0],["فمن ذا يهنّي الوافدين لبابه","بأكرمَ من أعطى وأرشدَ من هدى",54,"د",2,0],["فمن ذكر وجدٍ يسلب المرءَ لبَّه","على مثله دمع المتيَّم ذائبُ",55,"ب",1,0],["فمن ذا يروم العاقل الندب في الورى","وأعظم منكم في الدناليس يوجد",56,"د",1,0],["فمن ذا يرجى بعد أن جاء نحوكم","مليكا ومن ذا يستماح له رفد",57,"د",1,0],["فَمنْ ذا الَّذِي مِنْ بُعْدِ أَرْضِي ومَشْهَدِي","تَخَبَّطَهُ شيطانُ ضِغْني من المَسِّ",58,"س",1,0],["فَمَنْ ذَا الَّذِي يَرْجُو من المُلْكِ غِرَّةً","وَمَا حَوَّمَتْ إِلّا عَلَيْكَ حَوَائِمُهْ",59,"م",2,0],["فمن ذا لائمي إذا قلت روحي","لليلى غير مستثن هديه",60,"ي",2,0],["فمن ذا لائمي إِن عشت أَبكي","بنزوى عصبة رمسوا خذاها",61,"ا",3,0],["فمن ذا لائمي إِن عشت أَبكي","وعاد الحزن في المقسوم شركي",62,"ي",1,0],["فمن ذا دام أو من ذا يدوم","وهل عظم يصان عن الرفات",62,"ت",1,0],["فمن ذا هذا بالقرآن هذا","خلافك يوصل الليل الضحيا",63,"ي",2,0],["فمن ذي لسانٍ مفصح وهو أخرسٌ","ومن بائح بالسرِّ وهو كتومُ",64,"م",1,0],["فمن ذا يبتغي في الفضلِ سبقي","وقد يئس السوابقُ من لَحاقي",65,"ق",2,0],["فَمِن ذي قَوامٍ كَمِثلِ القَضيبِ","وَمِن ذاتِ دَلٍّ كَمِثلِ القَمَر",66