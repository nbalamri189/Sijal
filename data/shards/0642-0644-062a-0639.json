y.dctabudhabi.ae/diwan/poem/64706","الرمل"],[1508,"","https://poetry.dctabudhabi.ae/diwan/poem/130655","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12034","الدوبيت"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143788","الخفيف"],[2534,"","https://poetry.dctabudhabi.ae/diwan/poem/145716","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130809",""],[2849,"","https://poetry.dctabudhabi.ae/diwan/poem/145224","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58362","السريع"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115793","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118827","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79717","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132583","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97994","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138676",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128916","السريع"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76472","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136514",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72755","الخفيف"],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[4987,"قبل اسافر","https://www.poetsgate.com/ViewPoem.aspx?id=49555",""],[5055,"حرف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=103544",""],[5055,"بتول","https://www.poetsgate.com/ViewPoem.aspx?id=106077",""],[5376,"ياأمتي خبا النفيرُ فاسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=188498",""],[5409,"قال صحبي علام لا تقتفي النا","https://www.poetsgate.com/ViewPoem.aspx?id=155372",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5606,"يصير والا مايصير","https://www.poetsgate.com/ViewPoem.aspx?id=197425",""],[5615,"شعرور!","https://www.poetsgate.com/ViewPoem.aspx?id=187950",""],[6056,"كأس المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130314",""]],"verses":[["قَلَّت عُيونُ الناسِ عَن نَيلِهِم","فَعَوَّذوا مِن أَعيُنِ الأَنجُمِ",0,"م",1,0],["قُلتَ عَن نَفسِكَ قَولاً صادِقاً","لَم تَشُبهُ شائِباتُ الكَذِبِ",1,"ب",1,0],["قُلتُ عَظَّمتُمُ القَضِيَّةَ في دَل","وٍ خَليعٍ قَد رَقَّعوهُ بِنَعلِ",2,"ل",1,0],["قُلتُ عَفواً فَإِنَّها","سَورَةٌ مِن مُعَربِدِ",3,"د",1,0],["قُلتُ عَبدَ العَزيزِ تَفديكَ نَفسي","قالَ لَبَّيكَ قُلتُ لَبَّيكَ أَلفا",4,"ف",2,0],["قُلتُ عِندَ الإِيابِ يا نارُ بَرداً","وَسَلاماً كوني لِإِبراهيمِ",5,"م",1,0],["قُلتُ عُلُوُّ صُنعِكَ اِحتِشامُكا","إِن كُنتَ لي حَلَّ الرُموزِ دائِبا",6,"ب",2,0],["قُلتُ عِندَ اختِبارِها بِيَدَيها","ثَمَراً صانَهُنَّ جَيْبٌ مُزَرَّر",7,"ر",1,0],["قُلتُ عِندي يومَ أَصطادُ المُنى","جَذَعٌ يُحْكِمُ تأنيسَ الشَّرُود",8,"د",1,0],["قُلتُ عِرضي دونَ عِرضِكُمُ","وَلَمَن عاداكُمُ جَزَرُ",9,"ر",1,0],["قُلتُ عَينٌ بَكَت مِنَ الشَيبِ إِذ حَل","لَ وَأُخرى مِمَّن يُريني الصُدودا",10,"د",2,0],["قلت عودا من حيث قد جئتما بي","إنما هذه لهمّي تثير",11,"ر",1,0],["قُلْتُ: عَيْنٌ بَكَتْ مِنَ الشَّيْبِ إِذْ حَلَّ","وَأخْرَى مِمَّنْ يُرينِي الصُّدُودا",12,"د",2,0],["قلْت علا النّاسُ إلا أنتَ قلتُ لها","كذاك يسْفُلُ عند الوزن من رَجَحَا",13,"ح",2,0],["قُلتُ عُج نَحوي أُسائِل","كَ عِنِ الحُبِّ فَعاجا",14,"ج",2,0],["قُلْتُ عُذْرِي بَادٍ فَقالَ مُجيباً","هُوَ بَادٍ فابشِرْ وُجُودِيَ حَاضِرْ",15,"ر",1,0],["قُلتُ عِندي وَعِندَكُم عَمَّن","أَوجَبَ اللَهُ في الكِتابِ اِتِّباعَه",16,"ع",2,1],["قلت عفوا قف هنا","أو ترى ما العمل",17,"ل",1,0],["قل تعالوا فالمصلحون استفاقوا","من سبات وقيل فاز الجسور",18,"ر",1,0],["قلتُ عَمِّي العَماءُ عن كلِّ شيءٍ","قلتُ واسمي مَهْدي فقالَ بمَهْدِي",19,"د",2,0],["قلتُ على مَن فَضًَّلو","كَ أيها الخَبيرُ",20,"ر",1,0],["قلتُ عُودي إِلى فُؤادِيَ قالَت","كَيفَ عَوْدي وَفي لي كلّ باسِ",21,"س",1,0],["قلت: عندي بحر خمرٍ","حوله آجام نيك",22,"ك",1,0],["قلت عندي على هواك شهود","أدمع مستهلة ليس ترقا",23,"ق",2,0],["قلت عبد العزيز تفديك نفسي","ذاب قلبي وجداً عليك فعطفا",24,"ف",2,0],["قلْتُ عِدني بوصالٍ","قالَ دعْ هذي الوَثاوِثْ",25,"ث",1,0],["قلت عزوّه بفقدي","ولد الشيخ يتيم",26,"م",1,0],["قَلَت عَجَباً لِعاشِقيها مَهرُ","هَل غَيرَ دِمائِكُم لِدِمائي مَهرُ",27,"ر",1,0],["قلت عنك الملام ما","باختياري هويته",28,"ت",2,0],["قلت عبد الإله قم بأبي أن","ت فلبىَّ، فقلت لبيكَ ألفا",29,"ف",2,0],["قلت عفواً هل ترى جئت إلى الن","جم تلهو أم لأمر يوقن",30,"ن",1,0],["قلت عن نفسك قولا صادقاً","ليس تمحوه كرور الحقب",31,"ب",1,0],["قلت: عاجلتني لماذا أجبني؟","قال: إني أنا النذير المبين",32,"ن",1,0],["قلتُ عنِ التّوبة قالوا نعم","فازدَدْتُ مِنْ ذلكَ إعجابا",33,"ب",2,0],["قلتُ عجلُ به فقال مجيبا","علمُ الدين قيصَرُ الشعرانيَ",34,"ن",2,0],["قلت عاود جفون صبٍّ عميدٍ","قبل يرمى فؤاده بالخبالِ",35,"ل",1,0],["قلت عقلي فلم يعرني التفاتا","صحت قلبي فلج في عصياني",36,"ن",2,0],["قلت عذاب الغرام عذب","وذو الهوى بالغرام يسعد",37,"د",1,0],["قلت عدي أن تبعثي","خادمكم قالت غبي",38,"ب",2,0],["قل تعالوا عن مثيلٍ إنما","شأنهم اكبر من ان ينسبا",39,"ب",2,0],["قلت على عيني ورأسي غدا","آتي بما شئت أيا منيتي",40,"ي",1,0],["قلت عاث الشر في","ارضكم طولا",41,"ل",2,0],["قلت عيباً رأيت في فقالت","قد كفى بالمِشيب عندي عَيبا",42,"ب",2,0],["قلت عبد اللطيف صبحي عليها","قد غدا ناظرا فقرت عيونا",43,"ن",2,0],["قلت عيّا لا يجي بينهم يومٍ سعيد","باخذ الرحلة بحر لو مَ انا راعي بحر",44,"ر",1,0],["قلت عايف ونفسي بالخفا تشتهيك","عزة النفس تدري طيب ماهي ردى",45,"د",2,0],["قلت عيني تمنت كل شيءٍ تنول","المحبة مشاعر لو يجف المعين",46,"ن",1,0],["قلت عيني تمنت كل شيءٍ تقول","المحبة مشاعر لو يجف المعين",47,"ن",1,0],["قلت عن الويلاتِ يا نفسُ ابعدي","فالناسُ تدعوك لأمرٍ مفزعِ",48,"ع",1,0],["قلت عنهم سلوا العواقب حتى","تعرفوني أمخطئا أم مصيبا",49,"ب",2,0],["قلت عاش الشيخ واللي ناجبينه","عادة الطيب اليا جا الجد عاني",50,"ن",2,0],["قلت علمي جاك بالخط القصير","والله ماواحد كما عيسى شراك",51,"ك",1,0],["قُلتُ عَنهُ ، إِنَّ البِدايَةَ مِنْهُ","فَدَهَتْني ، عَلى النَّقِيضِ ، النِّهايَهْ !",52,"ا",3,0],["قلت عمري ..! مايقّدّ ر بالثمن ، للطيبيني","بس أنا ، مهديه رمز ٍ للي قلبي مهتويه",53,"ي",2,0]]}