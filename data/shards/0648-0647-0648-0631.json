{"poems":[[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[72,"حرمت عيني الكرى","https://www.aldiwan.net/poem42702.html","مجزوء الرمل"],[132,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[308,"يا ماجدا نجهد في وصفه","https://www.aldiwan.net/poem57733.html","السريع"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[563,"ربنا من لطفه لا يدرك","https://www.aldiwan.net/poem33505.html","الرمل"],[563,"إن محسوسات الحواس الظواهر","https://www.aldiwan.net/poem34517.html","الخفيف"],[563,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107215","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136211","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136128","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79416","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95575","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93886","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93797","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83520","الخفيف"],[3464,"الحمد مقصور عليه ذي السنا","https://www.poetsgate.com/ViewPoem.aspx?id=158703",""],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""]],"verses":[["وهو رجمٌ لكلِّ عفريتِ حربٍ","أيُّ سهمٍ أعدَّهُ أيُّ رامي",0,"م",2,0],["وَهُوَ رَيحاني وَروحي","وَنَديمي وَمُدامي",1,"م",2,0],["وهو رُوحُ القدسِ جبريلُ الأمينْ","صفوةُ الرحمن والعقد الثمينْ",2,"ن",1,0],["وهو رباعي وفي لفظه","تراه حقاً ناقصاً حرفا",3,"ف",2,0],["وهو رُوحي بنَشْأَتي وبُروزي","وانْقِلابي ما بينَ مَيْتٍ وحَيِّ",4,"ي",1,0],["وهو روح وهو نور المصطفى","خلقوا منه فلا ترتبكوا",5,"ك",3,0],["وهو روحٌ لطفٌ من الله باد","وهو خاف عن الجميع وظاهر",6,"ر",1,0],["وهو رأى العوام من أهل دين ال","له حظ النفوس فيهم أثيرا",7,"ر",2,0],["وهو راده والله يعشق","وناعن عشقو ما ننكف",8,"ف",1,0],["وهوَ رُوحِي لَو تَناسى لِذِمامِي","بِعَذُولي عَتَهٌ في عَقلِهِ",9,"ه",1,0],["وهو روح العلا وصدر المعالي","وهو سر النهى ورشد الحيارى",10,"ر",2,0],["وهو ربي كم قد عهدت جميلا","منه منا العقول فيه تحار",11,"ر",1,0],["وهو رهين الفرش والوساده","وعاكف على السوى المعيب",12,"ب",1,0],["وَهوَ رَبيب نعمَتي وَقصري","وَهوَ غَذيُّ دَولَتي وَبري",13,"ي",1,0],["وهو ريقٌ من فم الدُّن","يا إلى ثغرِكَ خارِجْ",14,"ج",1,0],["وهو رجس خبثه قد ثبتا","صاغه الشيطان فيما يكفرُ",15,"ر",1,0],["وَهوَ رانٍ يَغارُ مِن قُبَلِ البَد","رِ المُعَنّى عَلى شِفاهِ غَزالِه",16,"ل",2,0],["وهو روض فيه جنى ثمرات","مجتناها لرائح ولغادي",17,"د",2,0],["وهو روض وزارع الخير يحظى","في حماه بحصد ما هو زارع",18,"ع",1,0],["وهو رباطٌ من شمال القلعه","اشياخه السبق حازوا الرفعه",19,"ه",1,0],["وهو ريحانةُ النبي ولكن","رميت بالذبول في الطف قسرا",20,"ر",2,0],["وهو رأسُها المنظورُ فيها لأنها","لمنظورةٌ والمِثلُ حقَّ لهُ المِثلُ",21,"ل",1,0],["وهو روحُ الأَرواحِ خير البَرايا","صفوةُ اللَهِ مصطَفاه لِذاتِه",22,"ت",2,0],["وهو رسول الله طه أحمدٌ","ومحمدٌ روح المكارم والملا",23,"ا",1,0],["وهو روض فيهِ أزهار غِضاضٌ","عوضت من جاءها عن كل قاحل",24,"ل",1,0],["وهو رَوحٌ لكل داعٍ إذا ما","كان في شدةٍ أتاه الرخاء",25,"ا",2,0],["وهو روح في الشعب , لو تهجُر الشعب","تلاشى كجيفة وتبدد",26,"د",1,0],["وهْوَ ريشاتُ غُرابٍ لا يَني","يجْلِبُ الشُّؤمَ وإنْ لمْ ينعقِ",27,"ق",1,0]]}