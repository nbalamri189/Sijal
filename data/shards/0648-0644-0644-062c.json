{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[65,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[79,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[10,"جرى لي طير في حمام حذرته","https://www.aldiwan.net/poem21067.html","الطويل"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[74,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[77,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[48,"أصاب الأخفشين بصير خطب","https://www.aldiwan.net/poem22696.html","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[96,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[10,"جَرى ليَ طيرٌ فِي حمامٍ حذرتهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10488&r=&rc=13",""],[119,"كر الجديدين تبدو منه الوان","https://www.aldiwan.net/poem40479.html","عموديه"],[190,"الدهر في حالتي جمع وتفريق","https://www.aldiwan.net/poem43567.html","البسيط"],[208,"أقرت نجوم الحسن أنك بدرها","https://www.aldiwan.net/poem53254.html","الطويل"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[275,"تحوم عليك روحي كالفراش","https://www.aldiwan.net/poem35387.html","الوافر"],[280,"نفوس العالمين لك الفداء","https://www.aldiwan.net/poem25644.html","الوافر"],[290,"وللجلفة الفخر العظيم وحزبها","https://www.aldiwan.net/poem39372.html","الطويل"],[309,"العبد قد بناه","https://www.aldiwan.net/poem16835.html","مجزوء الرجز"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[438,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[457,"أرنت الورق وهنا فوق أبراج","https://www.aldiwan.net/poem13683.html","البسيط"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[466,"تفر صنوف العيب عن نيل مجده","https://www.aldiwan.net/poem16118.html","الطويل"],[520,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93500","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122572","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86935","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54045","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48615","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59812","المجتث"],[1025,"","https://poetry.dctabudhabi.ae/diwan/poem/143446","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59438","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138106",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49965","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48958","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48935","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77837","الرجز"],[1711,"","https://poetry.dctabudhabi.ae/diwan/poem/145760","المنسرح"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69438","السريع"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89555","الطويل"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101269","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106904","المتقارب"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75877","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122493","المتقارب"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62800","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123926","البسيط"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3857,"","https://poetry.dctabudhabi.ae/diwan/poem/142322","المجتث"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69949","الوافر"],[396,"","https://poetry.dctabudhabi.ae/diwan/poem/133406",""],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101381","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86364","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90929","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135069","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136548",""],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138862",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83124","البسيط"],[4691,"منفوحة الأعشى","https://www.poetsgate.com/ViewPoem.aspx?id=166400",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4884,"بِشُؤْمِ المُتنبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=201772",""],[5145,"أما والزرق تخطر وهي سمر","https://www.poetsgate.com/ViewPoem.aspx?id=108061",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5411,"شَرُّ البَليّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=185440",""],[5421,"باب قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=212719",""],[5431,"سلامي إلى صنعا تعزّ وربعها","https://www.poetsgate.com/ViewPoem.aspx?id=188446",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5587,"يا جزائر","https://www.poetsgate.com/ViewPoem.aspx?id=196573",""],[5596,"مجاراة قصيدة الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=206695",""],[5629,"ماني شبيهة","https://www.poetsgate.com/ViewPoem.aspx?id=184488",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""]],"verses":[["وللجسد المصفر بالسقم ثوبه","أما عرقت فأحمر طيبا مخاضبه",0,"ب",2,0],["ولِلجارِ فيهمْ ذِمَّةٌ لَم يُهِبْ بها","وقَد أطْفأَ المُثْرونَ نارَ القِرى غَدْرُ",1,"ر",1,0],["وَلِلْجُودِ تُهْمِي سَاجِماً مِنْ سَحَابِهِ","وَلِلْبَأَسِ تُذْكي جَاحِماً مِنْ نصَالِهِ",2,"ل",2,0],["وَلِلجارِ يَوماً إِن دَعا لِمَضيفَةٍ","دَعا مُستَغيثاً أَوَّلاً بِالجَوايِحِ",3,"ح",1,0],["وللجداولِ تصفيقٌ بساحتِها","والقطر روضٌ وللأطيارِ رنَّات",4,"ت",1,0],["وللجناس نصيب من مناقبِه","فالفضل والفصل والأحكام والحكم",5,"م",1,0],["ولَلجاحمُ المشبوبُ في القلب والحشا","أحرُّ إذا استثْبتُّ من كُلّ جاحِمِ",6,"م",1,0],["وللجَديدَينِ من طُولٍ ومِن قِصَرٍ","حَبْلانِ منُقَبضٌ عنّا ومُنبَسط",7,"ط",1,0],["وَلِلجَرميُّ ما اِجتَرَمَت يَداهُ","وَحَسبُكَ مِن فَلاحٍ أَو بَوارِ",8,"ر",1,0],["وللجدوال أنات مجرحة","كأنها حمل في كف ناحره",9,"ر",2,0],["وللجُهدِ في الدنيا نصابٌ وطاقةٌ","وليس لجُهدِ العبقريِّ نِصاب",10,"ب",1,0],["وللجيادِ صهيلٌ في شَكائِمها","تكادُ تَشربُهُ الصحراءُ ألحانا",11,"ن",2,0],["وللجارِ يوماً إنْ دَعا لمَضيفَة ٍ","دعَا مستغيثاً اوَّلاً بالجوابحِ",12,"ح",1,0],["وللجناب الرفيع القدر واسطتي","نورين من قد اتانا فيه قرآن",13,"ن",1,0],["وللجديدين في ترديد كرهما","سعد ونحس بتحقيق وتوفيق",14,"ق",1,0],["وللجُدَري فيه رسوم محاسنٍ","يُرى فيه آثارَ المحاسن أثرُها",15,"ر",3,0],["وللجوى افردن حين","ثنا بالقد الرديني",16,"ي",1,0],["وللجسمَينِ في الشَّوقِ ارتِعاشٌ","تُقابله الخمائلُ بارتِعاش",17,"ش",1,0],["وللجُرْد المُطَهّمَة ارْتِكاضٌ","وللبِيض المُهَنَّدَة انْتِضاء",18,"ا",2,0],["وللجلفة الفخر العظيم وحزبها","غدا مركزا منه المحامد تنبع",19,"ع",1,1],["وللجميع منهم","فإنهم أشباه",20,"ا",2,0],["وَللجسمِ روحٌ عاضَدته مشاعرٌ","بِه ولهُ تَحريكُها وَركودها",21,"د",3,0],["وَلِلُّجِّ بيضٌ وَهيَ في شاطِئٍ قَناً","تثيرُ بِها في الأَنفُسِ الطَعنُ وَالضَربُ",22,"ب",1,0],["وللجود معنًى عند غيرك مبهم","وليس له إلا يمينك شارح",23,"ح",1,0],["وللجداول من فوق الخمائل اس","ياف تجرد من أجفان أمواج",24,"ج",1,0],["ولَلجُبنُ خيرٌ لوَ انَّ الردى","عن المرء في عيشه غافلُ",25,"ل",1,0],["وللجبْن ضربٌ في الكتيبة أرْعَلٌ","يُفلَّلُ ماضيهِ ويُحْطَمُ ذابِلُهْ",26,"ل",2,0],["وللجهل إِن طاشت حبى القوم راجحٌ","يُطاولُ رضْوى حلمُه ويُثاقلُهْ",26,"ل",2,0],["وللجوامع من أحباسكم نعم","لمن تصدر في علم وفي عمل",27,"ل",1,0],["وللجمال والجلا","ل إرث آل ياسين",28,"ن",1,0],["ولِلجَهَالَةِ عَدوَى يَستَضِرُّ بها","ذو العَقلِ إن لم يُجَانِب مَوضِعَ التُّهَمِ",29,"م",1,0],["وللجوزاءِ في الجَوِّ اعتراضٌ","وإردافٌ كما اعترضَ الشَّهاد",30,"د",1,0],["وَللجبان إِذا ما ذاقَها قدم","كَالطود في حربه للمفتري راسي",31,"س",2,0],["وللجفون جفاها نومها فغدت","وكحلها السهر المعلوم والسهدُ",32,"د",1,0],["وللجميع عمدة","على التقى والورع",33,"ع",1,0],["وللجوى والوجيب","أيَّ احتدام بصدري",34,"ي",1,0],["وللجِياد أماراتٌ تُريكَ بها","عَيبَ البِغال، فما تُخفي الذي بانا",35,"ن",2,0],["وللجو فرق بالأسنة أشيب","وللنقع فرع بالعجاجة أسحم",36,"م",1,0],["وللجو طرف بالعجاج مكحل","وللأرض خدّ بالنجيع خصيب",37,"ب",1,0],["وللجيش هلال تم نيره","لما أحاطته للأصداغ هالات",38,"ت",1,0],["وللجمرّ أهون من لوعة","تحز الأضالع حز المُدى",39,"ا",1,0],["وللجود في مغنى بني عمرٍ يدٌ","لها من يدي ذهل بنانٌ وساعِدُ",40,"د",1,0],["وَلِلْجِنِّ طَرْدٌ عَنْ مَقَاعِدِ سَمْعِهَا","بِكُلِّ شِهَابٍ لاَ يَمَلُّ مِنَ الطَّرْدِ",41,"د",1,0],["وللِجناتش والنيرانِ كونٌ","عَلَيهَا مرُّ أَحوالٍ خَوَالي",42,"ل",2,0],["وللجنبلاطيينَ جانبَها","دررٌ تغازلُ حسنها الشُّهبُ",43,"ب",1,0],["وللجهل أغلال يحاول فكَّها","فريق من النشئ الجديد أديب",44,"ب",1,0],["وَللجنون عندها شفاء","وَللعقول عندها جنون",45,"ن",1,0],["وللجيوشِ التي تحفُّ به","مناظرُ الأسدِ في مواكبها",46,"ب",3,0],["وللجميل أُلوفٌ يفتنون بهِ","وليس يفْتنهُ بالحبِّ فتانُ",47,"ن",1,0],["وللجفن ربع ثم للشفر نصفه","من الدية العظمى كذلك تفعل",48,"ل",1,0],["وَلِلجَبِينِ الصَلتِ أَن يُسلَبَ البَه","جَةَ أَو يَعدَمَ حُسنَ الوَسام",49,"م",1,0],["وَلِلجَهبَذِ الصَرّافِ لِلأَلفِ خَمسَةٌ","وَسَبعونَ مِنّا وافِياتٌ وَنَيَّفُ",50,"ف",1,0],["وَلِلجَحفَلِ الجَرّارِ يَهدي رَعيلُهُ","إِلى كُلِّ جَبّارٍ أَبِيٍّ يُشاغِبُه",51,"ب",2,0],["وللجن والأملاك شأن لديكم","فنل مسجداً في أرض كوفان ترشد",52,"د",1,0],["وللجسم في العمر أن يستريح","وللداء في الصدر أن يبرأ",53,"ا",1,0],["وللجنوبِ تصاويرٌ وَعِدَّتُهَا","خَمسٌ وَعَشرٌ عَنِ الرُّصَّادِ مَنقولُ",54,"ل",1,0],["وَللجزريِّ ابنِ الأَثير نِهايَةٌ","إِذا قُرِئَت أَزرَت بِسَمعِ المَثالِبِ",55,"ب",1,0],["وللجَاهِلِينَ وللقاعِدِين","عنش المكرُماتش لجِدُّ خَصِيمِ",56,"م",1,0],["وللجليل ما عرفته","لإيش بقيت تصيب",57,"ب",1,0],["وللجدِّ صيدٌ بينَ خَودٍ وفارسٍ","وللهوِ صيدٌ بينَ ظَبيٍ وضَيْغَمِ",58,"م",1,0],["وللجبين بأنوار الامامة قد","زها وصخر بني صخر يشججه",59,"ج",2,0],["وللجنّ إذ للرشد يهدي سفيرها","وغذ برجوم الشهب يرمى مريدها",60,"د",3,0],["وللجديد اشتعال","وللقديم خمود",61,"د",1,0],["وللجبين بها في حال سجدته","فخر وشكر وتعفير وتطويل",62,"ل",1,0],["وَللجلاسِ قَد اَهدى سَميراً","يُناجي العَقلَ بِالسحرِ الحَلالِ",63,"ل",1,0],["وللجماعة والجمعة فضائل طوال","عظيمة القدر معروفة لدان وعال",64,"ل",1,0],["وللجماهير آذان مفتحة","كي تسمع النصح لكن باغت الصمم",65,"م",1,0],["وللجواد التهاني عود بهجتها","كبهجة الروض مولياً وموسوما",66,"م",2,0],["وللجمع جأتنا بفرقان فرقها","نبية حسن قد نعتنا لعشقها",67,"ه",2,0],["وللجود مسك والمكارم عنبر","وللفضل لذ وهو في ذاته عطر",68,"ر",1,0],["وللجُود ما تَحوي من المال كفُّه","وللمَجد ما تبني لديه المآثر",69,"ر",1,0],["وللجبال ألا ميدي لمصرعه","وللمهاد ألا من بعد انقلبي",70,"ب",2,0],["وللجياد ألا تلقى أعنتها","فليث غابتها عار على الهضب",70,"ب",1,0],["وَللجُهود بِأَعشى الرأي يُطفِئُها","ماضٍ عَلى ضوئِها سارٍ بِهاديها",71,"ي",3,0],["وللجريمةِ فيها ألفُ قافيةٍ","تروي الفظاعةَ حتَّى ضجَّتِ السُّبُلُ",72,"ل",1,0],["وللجابريّة قد سرجت الابجر","مقدم كموجن طاميّن لطامي",73,"م",2,0],["وللجودِ إِعْياءٌ وللخذْلِ أَجْرُهُ","وللحُمْقِ إِظْهَارٌ وللحِلْمِ مُضْمِرُ",74,"ر",1,0],["وللجمرات ترميها اقتداراً","وما ترمي به الجمرات جمر",75,"ر",1,0],["وللجفون تبارٍ في مدامعها","ما بين منسجم منه ومضطرم",76,"م",1,0],["وَللْجائِعين خواء البُطُون","يَبابٌ يَبابٌ وَلا يَنْضِبُ",77,"ب",1,0],["وللجوعى إلى قمر بعيدٍ","ففي قلبي شواطئ من أمان ِ",78,"ن",1,0],["وللجود أبوابٌ وأنت مليكها","وفاضت به الخيرات حتى تسيّدا",79,"د",2,0],["وللجبالِ بكردستان نائحةٌ","تبكي الينابيعُ، والغاباتُ، والرَّشَبا",80,"ب",2,0],["وَ لِلْجَزَائِرِ تَذْكُو الأُغْنِيَاتُ وَمِنْ","فُنُونِهَا هَذِهِ الأَلْحَانُ وَ الوَتَرُ",81,"ر",1,0],["وللجدول الجاري براحاتهم ندىً","شمائله لمّا تزل في توارد",82,"د",1,0],["وللجرح تعليمة ، وللحبل مسة","وحبل المفارق مُس والجرح ها هو !",83,"و",1,0],["وللجهات يبيض الريح في يدهًٍِ","تجمّدُ الخَمْسَ... للثّورَاتِ رِدّاتُ",84,"ت",1,0],["وللجهل رتبة اللوزم لعجزه","كذا لانتهاء العلم عجز بخيرة",85,"ه",1,0]]}