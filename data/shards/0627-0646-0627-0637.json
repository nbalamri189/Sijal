للشَّمالِ .. هُناك عيدُ!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86213&r=&rc=11",""],[5519,"لحن الغياب ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69278&r=&rc=11",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["أنا طامع بالجود منك ولم يكن","لابن الخطيب من الأنام سواكا",0,"ك",2,0],["أَنَا طَاقُ تَزْهُو بِيَ الأَيَّامُ","تَعِبَتْ فِي بَدَائِعِي الأَفْهَامُ",1,"م",1,1],["إِن أَطافَت بِكَ الخُطوبُ فَهَذي","سُنَّةُ الكَونِ مِن قَديمِ الزَمانِ",2,"ن",1,0],["إنَّا طَلِيعَةُ الحِمَى تَطَوَّعَا","مُلَبِّيَاتٌ مَجْدِهِ إذَا دَعَا",3,"ع",2,0],["إنْ أُطْلِقُوا أوْ قُيِّدُوا إنْ أُمِّنُوا","أوْ شُرِّدُوا حَالاَهُمُ سِيَّانِ",4,"ن",1,0],["إن أطعتَ النفسَ في رَفْضِ العُلى","واطِّراح الحمد ذَمَّتْكَ المِنن",5,"ن",1,0],["أَنا طائِرٌ قَد كانَ يَمرَحُ في الرُبى","وَعَلى ضِفافِ الجَدوَلِ المُتَرَقرِقِ",6,"ق",1,0],["أنا طائرٌ مُتَغرِّدٌ مُتَرنِّمٌ","لكِنْ بصوتِ كآبتي وزَفيري",7,"ر",2,0],["انا طفلها المولود من احشائها","ولدرها في كل حين ارضع",8,"ع",1,0],["إنْ أطرقُوا هِيبُوا وإنْ نطقُوا","قالوا الجميل وإن وَلُوا عَدَلوا",9,"ل",3,0],["إِن أَطلُبِ الأَمَلَ البَعي","دَ لَدَيهِ يَدنُ عَلَيَّ بُعدُه",10,"د",2,0],["إِن أَطرَقَ اِستَوحَشَت لِلخَوفِ أَفإِدَةٌ","وَيَملَأُ الأَرضَ مِن أُنسٍ إِذا اِبتَسَما",11,"م",2,0],["أنا طيفُ الماضي على صخرة الآ","بادِ أستشرفُ الزمان الآتي",12,"ت",2,0],["أَنا طَوْدُهَا الرّاسِي إِذا ما زَلْزَلَتْ","أَيْدِي الحوادِثِ مِن فُؤادِ جبانِهَا",13,"ن",3,0],["إِنْ أَطَالُوا جَدَّ رَفْساً وَإِذَا","أَقْصروا حَمْحَمَ تَأْنِيباً وَزَجْرَا",14,"ر",2,0],["أنا طيف من خيالاتِ الليالي","من صدى الوادي ومن همسِ الدوالي",15,"ي",1,0],["أنا طفل الحياة يا ضلة الروح","فعفوا إن جئت أمرا فريا",16,"ي",2,0],["أنا طاق تزهى بي الأيام","تعبت في بدائعي الأفهام",17,"م",1,1],["إنْ أطرَقَ استَوْحشتْ للخوْفِ أفئدَةٌ،","وَيَملأ الأرْضَ من أُنسٍ، إذا ابتسمَا",18,"م",2,0],["أنا طيرك الشادي وللأنغام من كبدي انسراب","سكبت أغاريدي وللأمواج زأر واحتراب",19,"ب",1,0],["إن أطعتَ النفسَ في رَفْضِ","بها حين دلَّتْك على قصدِ السَّنن",20,"ن",1,0],["أنا طائفيٌّ، كلُّ مُرْتَكِبِي الهَوى","قَومي، ومالكة القلوبِ العاطِفَةْ",21,"ف",2,0],["أنا طاسة مطبوعة","بالحسن كاملة الدخول",22,"ل",1,1],["إِن أَطَلَّت من كوَّةِ المَوتِ تبصر","نَزَواتِ الأَرواحِ في الأَحياءِ",23,"ا",2,0],["إن أطفالي الذين تراهم","حول ناري في الليل مثل الفراش",24,"ش",1,1],["إن أطبقت شفتايَ جَفنيك اهدئي","لأذوقَ لذاتِ الهوى ألوانا",25,"ن",2,0],["أنا طلّقت وقاري","ورأيتُ العقل حبسا",26,"س",2,0],["أنا طيف سابح في أفق","راعش الأنوار من خلق يديك",27,"ك",1,0],["أنا طهّرت بالندامةِ ذنبي","فارجِعي أو فأمعني في الجفاء",28,"ا",2,0],["انا طوراً ارى الحياة شروراً","ثم اخرى أرى الحياة تبسم",29,"م",1,0],["أَنا طالب نيل اللقا","وَمفنّدي يَأبى الطَلَب",30,"ب",1,0],["إِن أَطاعَ الشِّعر فيه","بَعدَ ما كانَ عَصاني",31,"ن",2,0],["إنْ أطلقوا لفظة الكتاب فما","يشارُ إلاَّ إليه في الكتب",32,"ب",1,0],["إنْ أطلنا الحنينَ شوقاً إليكم","فعلى الصَّبِّ أنْ يطيل الحنينا",33,"ن",2,0],["إنْ أطع في تركها من نصحا","فلقَدْ جئت لعمري بشنيعْ",34,"ع",1,0],["إن أطلع الورد هذا الشهر مزدهيا","فإن أجمله تحرير عبدان",35,"ن",1,0],["إن أطلقوه فقد أطلقت قافية","فيها يقيد حتى تبعث الرمم",36,"م",1,0],["أنا طوراً من النبيط","وطوراً من العرب",37,"ب",1,0],["أنا طورُ سيناءِ التَّجَلِّي ضِمْنَهُ","قَبَسي هُنالكَ ظاهِرٌ مَرْئِيُّ",38,"ي",1,0],["إن أطلقوا أمس البلا","د فمنهمُ ليست طليقه",39,"ق",2,0],["إن أطرقوا فمن الحياء وإن همُ","رفعوا النواظر كبَّروا إجلالا",40,"ل",2,0],["إن أطربتهم نغمتي","يوماً فما سمعوا أنيني",41,"ن",2,0],["أنا طفلٌ الكلامٍ يخطو غريباً","مربَكَ الصوتِ خائِفاً فاحضنيهِ",42,"ي",2,0],["أَنا طَرحُ بَينَ خَلا","تِ حَديداتِ النِصال",43,"ل",1,1],["إن أطفأت في المحل نيران القرى","رفعوا على قنن الجبال شهابها",44,"ب",3,0],["إِن أَطافَت بِهِ المَراثي قَريباً","فَقَديماً أَطافَ فيهِ المَديحُ",45,"ح",1,0],["أنا طالبك يا الله يا منزل كتابه","ويا عالم بسر الضماير وتدري به",46,"ب",2,0],["أنا طب في الرأي في موضع الرأ","ي معين على الخصيم المعن",47,"ن",1,0],["أنا طننت من وعد ام قايد","وكم يا جغر نهده بعد نهده",48,"د",2,0],["إن أطالع أخا اليسارِ يبادر","نى بشكوى الزمان والإعسار",49,"ر",1,0],["أُناطِقُهُ كيما أَقولُ وَإِنَّما","أُناطِقُهُ عَمداً لِينتثرَ الدُّرُّ",50,"ر",1,0],["إِنا طوينا الريحَ في كفنا","فطارت الريحُ واحلامُنا",51,"ن",2,0],["أَنا طَائِرٌ فَوْقَ الخَلِيجِ أُعِيدُ ذِكرَكَ لِلْعُبَابِ","بِمَرَافِئِي سُفنٌ تَسِيرُ لِعَالَمِ الأمَلِ المُذَابِ",52,"ب",1,0],["إن أطاق النُقادُ تحوير عقلي","ابداً لم يحوّروا من شعوري",53,"ي",1,0],["إن أطاعتني الأكابر يوماً","فلأني مروّض للوحوش",54,"ش",1,1],["أنا طائر للأرض أنزل ابتغي","قوتاً يساعدني على الطيران",55,"ن",1,1],["إن أطلال بعلبك كتاب","قد حلا مبدأ وطاب ختاما",56,"م",2,0],["أنا طائر لا يرتضي الأرضَ مسكناً","كأني بين الجو أبحث عن عرشي",57,"ش",2,1],["ان أطلت الحنين شوقاً إليها","فليالي النوى على القلب أطول",58,"ل",1,0],["أنا طوع الهوى لحي به أنت","وأنت العاتي على القلب ظلما",59,"م",2,1],["أن أطرق استولى الأنام مهابة","فإذا تبسم طارحوه القيلا",60,"ل",2,0],["إِن أَطفأَ جمرتي اِشتِعالُ الراسِ","أَو شابَ عِذارُ مَنِيَّتي بالياسِ",61,"س",1,1],["إن اطعتُ الغَرامَ فيه فإني","قد عصيتُ اللُّوَّامَ والعُذَّالا",62,"ل",2,0],["إِنّا طَعمنا الذُلَّ مرّاً عَلقَماً","عشرين عاماً في بُكى وَنواحِ",63,"ح",1,0],["إنّا طعمنا الذلَّ مرّاً علقَماً","أترى يعود العزُّ بعد براحِ",64,"ح",1,0],["أنا طوعُ حبِّكَ لا عَدِم","تُكَ ما حييتُ وفي يديكا",65,"ك",2,0],["انا طفل وإن شابت زهوري","وشمعة بسمة رغم السنين",66,"ن",1,0],["أنا طيف يعيش تناقضاتٍ","يعالجني ويعركني حنيني",66,"ن",2,0],["إن أطرب الأسماع مدح مهذب","فمديح إسماعيل أعظم مطرب",67,"ب",1,1],["ان اطرب اللاهين عزف القيان","اواعجب الساهين صرف الدنان",68,"ن",1,0],["أنا طفل واقف ٌ في بابكم","يتمنى نظرة ً من مقلتيكِ",69,"ك",1,0],["أنا طفلك الحبشي أهيم ُ","تعالي إليّ لنحيي الحواسا",70,"س",2,0],["إِن أَطَعْت الْعَدو فِينَا فَإنَّا","قد عصينا فِيك الصّديق الصدوقا",71,"ق",2,0],["‏أنا طفلُكِ الفادي ترابَكِ، مِنْ","‏ريحٍ، بهِ في الجو تضطربُ",72,"ب",1,0],["‏أناْ طفلُكِ الغافي وإن كَمُنَت","‏في دربِهِ الأهوالُ والنُّوَبُ",72,"ب",1,0],["أناطح في الدنا كل البرايا","وأصرع فيهم الليث الحساما",73,"م",2,0],["أنا طيرٌ ، وجناحايَ هما","أنتما ، طرنا إلى أفقٍ بعيد",74,"د",1,0],["أنا طائرٌ كُوني سماءً ثرّةً","لا شكَّ أنَّ الظنَّ فيكِ مُحقَّقُ",75,"ق",1,0],["أنا طفلُ الرُّهِينغا إذا نسيتُم","أُبادِلُكم مع العيدِ العِتَابا",76,"ب",2,0],["أنا طفلُ الرّهينغا إذا نسيتم","أغيثوني رِجالاً أو رِكَابا",76,"ب",2,0],["أنَا طَائِرٌ .. عُصْفُورُ عُشٍّ دَافيءٍ","وَجَنَاحُ صَقْرٍ يُطْبِقُ الأَمْيَالا",77,"ل",2,0],["انا طالب رضا رَبّي ويرزقني بنات الحور","بعدما يغفر ذنوب الفقير وكل غلطاته",78,"ت",2,0],["أنا طيرُك َ المحتار ُ يا طرب َ الربى","والغصن ُ يذوي حين طيرُك َ يشرد ُ",79,"د",1,0],["إن أطبق َ الخطب ُ فينا والربى احترقت ْ","فأي َّ نفس ٍ على الأقدام ِ تنتصب ُ ؟؟!",80,"ب",1,0],["إنْ أطعنا الله في غدنا","صارت الدنيا لنا رَغَدا",81,"د",2,0],["أنا طِلِيبك وانتِهْ صِرْت وَحْدَكْ طِليبْ","أخْفِيتْ عَنِّي ملامِحْ بَانْ فيها الضَّنَى",82,"ن",2,0],["أنا طيرُ شِعرٍٍ إنِّما","في الحبِّ مكسورُ الجَناحْ",83,"ح",1,0],["أنا طفلٌ وعمري ألفُ عامٍ","وخلفَ همومِهِ الكبرى توارى",84,"ر",2,0],["أنا طَيْرٌ بِلا وَكْرٍ","يغنَّي وَحْده شِعرَهْ",85,"ر",2,0],["إن أطلت المكث فيهم فاعلمي","إن لليوم وإن طال غدا",86,"د",2,0],["أنا طَيْرٌ لِرُوحِ الحُبِّ","غَنَّى وَحْده سِحْرَهْ",87,"ر",2,0],["أُناطِحُ مُستَبدَّ الدهرِ حتى","تَهَشّمَ فوق صخرتهِ الشبابُ",88,"ب",1,0],["إن أطعموا فاحذر شهيَّ طعامهم","أو أسقوِا العطشى فموتٌ بعد حينْ",89,"ن",1,0],["أنا طفلةٌ في الحب فاحضن لوعتي","واهصر ضلوع الورد والأعذاقا",90,"ق",2,0],["أنَا طائرُ ( الفينيق ِ) هل تسعى له","موسّادُكُمْ بين الرمادِ وترسُمُ ؟",91,"م",1,0],["أنا طفلُ الهوى مازلتُ أحبو","إلى عينَيكَ مِنْ وَلَهي وأعثَرْ",92,"ر",1,0],["إن أطلقوا أو قيدوا إن أموا","أو شردوا حالاهم سيان",93,"ن",1,0],["أناْ طفلٌ يَضحكُ جَذلانا","قلبي في النشوةِ يتبعثرْ",94,"ر",1,0],["إنْ أطفأَ الداءُ البغيضُ شموعَنا","فعيونُ قلبي للضياءِ بديلُ",95,"ل",1,0],["إنْ أُطْعَمِ اليأسَ من فمٍ ويدٍ","فمقصديْ الشعر لا أرى بدلا",96,"ل",2,0],["أنا طفل وأنت الأمُّ نهدٌ","لإرضاعي، ويقتلني نواكِ",97,"ك",1,0],["أنا طاقة الأشواق في هذا الورى","خُزِنتْ وهذا اليومَ تنفجرُ",98,"ر",1,0],["أنا طفل طائش حيث أولِّي","متعبٌ جداً لنفسي ولِنَسْلي",99,"ي",1,1],["أنا طارحٌ للناسِ شعراً مقرفاً","وحقوقهم مني الأزاهر والشذى",100,"ذ",2,0],["أنا طارقُ الباب يا طارقُ","لأخبارِ والدكم سارقُ",101,"ق",1,1],["أنا طائعٌ لك بالدعاء لربنا","وأقوم مجبورا إلى التفريكِ",102,"ك",1,0],["أنا طائرُ العَنْقَاء تحتَ رمادِهِ","تَشُبُّ لظى الأيامِ فِيَّ وتُشْعِلُ",103,"ل",1,0],["أنا طِيب ُ الحصادِ .. فليتَ شعري:","\"أكنتُ البَرَّ .. أم غَلبَ الجُحودُ؟!\"",104,"د",1,0],["أنا طفلةٌ في رباكَ تطوف","وقلبي كَطَيْرٍ أَسِيرٍ يغنّي",105,"ن",2,0],["إن أطلقوها صواريخا مدمرة","في الجو والبر منها يقطر اللهب",106,"ب",1,0],["أنا طفلٌ عراقيٌّ يتيمٌ","هوى برصاصِكُم أبَتي صريعا",107,"ع",2,0]]}