{"poems":[[77,"يا سيد السادات جئتك قاصدا","https://www.aldiwan.net/poem35475.html","الكامل"],[77,"أنا طاق تزهو بي الأيام","https://www.aldiwan.net/poem36123.html","الخفيف"],[86,"أين يوم القنال يا ربة التاج","https://www.aldiwan.net/poem10696.html","الخفيف"],[93,"خير الحلى من أدب وطهر","https://www.aldiwan.net/poem11237.html","البسيط"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"بالله أولي يمينا برة قسما","https://www.aldiwan.net/poem65683.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141934","الرمل"],[95,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=721",""],[77,"أنا طاق تزهى بي الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=34159",""],[45,"بِالله أَولَى يَمِيناً بَرّةً، قَسَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32080",""],[94,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=12695",""],[51,"يا كريماً لم يزل محتمِلا","https://www.poetsgate.com/ViewPoem.aspx?id=30692",""],[118,"زبانية الهوى","https://www.aldiwan.net/poem24059.html","الكامل"],[211,"أنا طاسة مطبوعة","https://www.aldiwan.net/poem13477.html","مجزوء الكامل"],[224,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[257,"إن أطفالي الذين تراهم","https://www.aldiwan.net/poem48548.html","الخفيف"],[271,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[291,"قل لمن خاس بعهدي","https://www.aldiwan.net/poem11702.html","مجزوء الرمل"],[329,"أنت دنياي التي تهتف بي","https://www.aldiwan.net/poem54915.html","الرمل"],[329,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[343,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[354,"يا كاشفا سر الرمو","https://www.aldiwan.net/poem40566.html","مجزوء الكامل"],[372,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[417,"يا ناجيا نحو كل مكرمة","https://www.aldiwan.net/poem54078.html","المنسرح"],[417,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[417,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[454,"طوبى ومرحى إذا الأحرار جمعهم","https://www.aldiwan.net/poem61266.html","البسيط"],[480,"في موقف العدل والأبصار شاخصة","https://www.aldiwan.net/poem37613.html","البسيط"],[496,"لا يغرنك الذي أنا فيه من الطلب","https://www.aldiwan.net/poem9764.html","مجزوء الخفيف"],[501,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"]],"verses":[["أنا طامع بالجود منك ولم يكن","لابن الخطيب من الأنام سواكا",0,"ك",2,0],["أَنَا طَاقُ تَزْهُو بِيَ الأَيَّامُ","تَعِبَتْ فِي بَدَائِعِي الأَفْهَامُ",1,"م",1,1],["إِن أَطافَت بِكَ الخُطوبُ فَهَذي","سُنَّةُ الكَونِ مِن قَديمِ الزَمانِ",2,"ن",1,0],["إنَّا طَلِيعَةُ الحِمَى تَطَوَّعَا","مُلَبِّيَاتٌ مَجْدِهِ إذَا دَعَا",3,"ع",2,0],["إنْ أُطْلِقُوا أوْ قُيِّدُوا إنْ أُمِّنُوا","أوْ شُرِّدُوا حَالاَهُمُ سِيَّانِ",4,"ن",1,0],["إن أطعتَ النفسَ في رَفْضِ العُلى","واطِّراح الحمد ذَمَّتْكَ المِنن",5,"ن",1,0],["أَنا طائِرٌ قَد كانَ يَمرَحُ في الرُبى","وَعَلى ضِفافِ الجَدوَلِ المُتَرَقرِقِ",6,"ق",1,0],["أنا طائرٌ مُتَغرِّدٌ مُتَرنِّمٌ","لكِنْ بصوتِ كآبتي وزَفيري",7,"ر",2,0],["انا طفلها المولود من احشائها","ولدرها في كل حين ارضع",8,"ع",1,0],["إنْ أطرقُوا هِيبُوا وإنْ نطقُوا","قالوا الجميل وإن وَلُوا عَدَلوا",9,"ل",3,0],["إِن أَطلُبِ الأَمَلَ البَعي","دَ لَدَيهِ يَدنُ عَلَيَّ بُعدُه",10,"د",2,0],["إِن أَطرَقَ اِستَوحَشَت لِلخَوفِ أَفإِدَةٌ","وَيَملَأُ الأَرضَ مِن أُنسٍ إِذا اِبتَسَما",11,"م",2,0],["أنا طيفُ الماضي على صخرة الآ","بادِ أستشرفُ الزمان الآتي",12,"ت",2,0],["أَنا طَوْدُهَا الرّاسِي إِذا ما زَلْزَلَتْ","أَيْدِي الحوادِثِ مِن فُؤادِ جبانِهَا",13,"ن",3,0],["إِنْ أَطَالُوا جَدَّ رَفْساً وَإِذَا","أَقْصروا حَمْحَمَ تَأْنِيباً وَزَجْرَا",14,"ر",2,0],["أنا طيف من خيالاتِ الليالي","من صدى الوادي ومن همسِ الدوالي",15,"ي",1,0],["أنا طفل الحياة يا ضلة الروح","فعفوا إن جئت أمرا فريا",16,"ي",2,0],["أنا طاق تزهى بي الأيام","تعبت في بدائعي الأفهام",17,"م",1,1],["إنْ أطرَقَ استَوْحشتْ للخوْفِ أفئدَةٌ،","وَيَملأ الأرْضَ من أُنسٍ، إذا ابتسمَا",18,"م",2,0],["أنا طيرك الشادي وللأنغام من كبدي انسراب","سكبت أغاريدي وللأمواج زأر واحتراب",19,"ب",1,0],["إن أطعتَ النفسَ في رَفْضِ","بها حين دلَّتْك على قصدِ السَّنن",20,"ن",1,0],["أنا طائفيٌّ، كلُّ مُرْتَكِبِي الهَوى","قَومي، ومالكة القلوبِ العاطِفَةْ",21,"ف",2,0],["أنا طاسة مطبوعة","بالحسن كاملة الدخول",22,"ل",1,1],["إِن أَطَلَّت من كوَّةِ المَوتِ تبصر","نَزَواتِ الأَرواحِ في الأَحياءِ",23,"ا",2,0],["إن أطفالي الذين تراهم","حول ناري في الليل مثل الفراش",24,"ش",1,1],["إن أطبقت شفتايَ جَفنيك اهدئي","لأذوقَ لذاتِ الهوى ألوانا",25,"ن",2,0],["أنا طلّقت وقاري","ورأيتُ العقل حبسا",26,"س",2,0],["أنا طيف سابح في أفق","راعش الأنوار من خلق يديك",27,"ك",1,0],["أنا طهّرت بالندامةِ ذنبي","فارجِعي أو فأمعني في الجفاء",28,"ا",2,0],["انا طوراً ارى الحياة شروراً","ثم اخرى أرى الحياة تبسم",29,"م",1,0],["أَنا طالب نيل اللقا","وَمفنّدي يَأبى الطَلَب",30,"ب",1,0],["إِن أَطاعَ الشِّعر فيه","بَعدَ ما كانَ عَصاني",31,"ن",2,0],["إنْ أطلقوا لفظة الكتاب فما","يشارُ إلاَّ إليه في الكتب",32,"ب",1,0],["إنْ أطلنا الحنينَ شوقاً إليكم","فعلى الصَّبِّ أنْ يطيل الحنينا",33,"ن",2,0],["إنْ أطع في تركها من نصحا","فلقَدْ جئت لعمري بشنيعْ",34,"ع",1,0],["إن أطلع الورد هذا الشهر مزدهيا","فإن أجمله تحرير عبدان",35,"ن",1,0],["إن أطلقوه فقد أطلقت قافية","فيها يقيد حتى تبعث الرمم",36,"م",1,0],["أنا طوراً من النبيط","وطوراً من العرب",37,"ب",1,0],["أنا طورُ سيناءِ التَّجَلِّي ضِمْنَهُ","قَبَسي هُنالكَ ظاهِرٌ مَرْئِيُّ",38,"ي",1,0]]}