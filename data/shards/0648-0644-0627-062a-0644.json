,[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139588",""],[4709,"النجم شاهد","https://www.poetsgate.com/ViewPoem.aspx?id=214854",""],[4755,"هو الوَقتُ كالسَّيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=204522",""],[1901,"رويْدَكَ لا تُشمتْ بصاحِبكَ العِدَى","https://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[4881,"نصائح","https://www.poetsgate.com/ViewPoem.aspx?id=181833",""],[4956,"إلى سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=1483",""],[4978,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=177226",""],[4984,"حسن إختيار أو انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=191329",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5081,"إِذَا فِى الْبَيْتِ قَدْ دَبَّ النِّزَاعُ","https://www.poetsgate.com/ViewPoem.aspx?id=187571",""],[3591,"ضعفٌ ألم بقلبي بعدما ارتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=149393",""],[3591,"عارٌ على الغيد أن تزهو وتفتخرا","https://www.poetsgate.com/ViewPoem.aspx?id=149462",""],[5174,"رَفيفٌ إِلى مِشكاةِ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=185374",""],[5183,"من وحي تونس","https://www.poetsgate.com/ViewPoem.aspx?id=180207",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"أشاقك أن ترى الربع المحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170514",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5323,"يا شاعر ( الآه )","https://www.poetsgate.com/ViewPoem.aspx?id=207211",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5376,"يا قِبلةَ الشوقِ هاج القلبَ وجدانُ","https://www.poetsgate.com/ViewPoem.aspx?id=191873",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[709,"لا برَّ في الحبِّ يا أهلَ الهوى قسمي","https://www.poetsgate.com/ViewPoem.aspx?id=30299",""],[5594,"قل للامام مقالا غير مجحود","https://www.poetsgate.com/ViewPoem.aspx?id=201056",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5804,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184421",""],[6031,"أوْفاتَّخِذْ لَكَ سِنداناً ومِطْرقَةً","https://www.poetsgate.com/ViewPoem.aspx?id=46347",""],[6038,"كويتيه","https://www.poetsgate.com/ViewPoem.aspx?id=25685",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6131,"يَا صَاعدًا للنورِ متَّكئَ النَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=189339",""],[463,"تغربْ فالبدار الحبيبة ِ دارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60062&r=&rc=118",""],[2220,"ويلتاح في جو السماءِ إذا انبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11168&r=&rc=42",""]],"verses":[["وَلا تَلوِي عَلى سَلَبٍ","إِذا ظَفِرَت عَساكِرُه",0,"ر",2,0],["ولا تلجن بيوت بني سعيد","ولو قالوا وراءك مصفحينا",1,"ن",2,0],["ولا تلوم ولو فاضت جفونكم","على المصاب الذي انْقضت حوائمه",2,"م",2,0],["ولا تلُومَنَّني على جَزَعي","فَدُون ما بي أتى على جلدي",3,"د",2,0],["ولا تَلْهُ عن إصراخ داعيك بالتي","يسير بها الركبان في البر والبحرِ",4,"ر",1,0],["ولا تلمهُ إذا رماك به","سِرُّ مخازيك قبْله فاش",5,"ش",1,0],["ولا تلمني على اشتطاطي في ال","حكم ولا في سؤالك الترفا",6,"ف",2,0],["ولا تَلحِيَنِّيَ في أنْ أذِل","لَ صفْراً من الإلّ فالوُدُّ إلُّ",7,"ل",1,0],["ولا تَلْحَنِي في طِلابِ الشبابِ","فنفسي به لم تَزَلْ مُسْتهامه",8,"م",2,0],["وَلا تَلبِسوا الخِزَّ إِلّا جَديداً","وَإِن لَبِسَ الخِرَقَ البائِسون",9,"ن",1,0],["وَلا تِلالٌ كَنُهودِ الدُمى","وَلا سُفوحٌ كَتَراقيها",10,"ي",3,0],["ولا تلائم روح غير جثتها","يوما وفي ذلكم ذكرى لمدّكرِ",11,"ر",1,0],["ولا تَلْقَهُ إلا بِخَيْرِ وَسيلَةٍ","يَلوحُ على وَجْهَيْهِ خَيْرُ مَقالِ",12,"ل",1,0],["وَلا تَلوموا في اتِّباعِ الهَوى","فَإِنَّني في شُغُلٍ شاغِلِ",13,"ل",1,0],["ولا تَلَقّى الفَوزَ إذ سوهموا","بنو القوافي من مُعَلّى القداح",14,"ح",1,0],["وَلا تَلوما ذا الهَوى إِنَّها","لَيسَت بِبِدعٍ حَنَّةُ النازِعِ",15,"ع",1,0],["ولا تَلْممْ بزمزمَ إنّ فيها","لكَ المُهلُ الذي يشوي البطونا",16,"ن",2,0],["ولا تَلْمَسْ كتابَ اللهِ واخسَأْ","إذا رفعْتهُ أيدي اللّامسينا",16,"ن",2,0],["وَلا تِلاواتِ السُوَر","يَمسَحُ مِرناناً يُسُر",17,"ر",1,0],["وَلا تُلاقي كَما لَقَت بَنو أَسَدٍ","فَقَد أَصابَتهُمُ مِنها بِشُؤبوبِ",18,"ب",1,0],["وَلا تَلِجي الحَمّامَ قَد جاءَ ناصِحٌ","بِتَحريمِهِ مِن قَبلِ أَن يَفسُدَ الناسُ",19,"س",1,0],["وَلا تُلبِسي الحِجلَينِ بِنتَكِ وَالبُرى","لِتَشهَدَ عُرساً وَاِشغِلَنها بِعِرناسِ",20,"س",1,0],["وَلا تَلقى سِوى حَيٍّ كَمَيتٍ","وَمَنزوفٍ وَإِن لَم يُسقَ راحا",21,"ح",2,0],["ولا تُلحِ إلاَّ مَن أَلاَمَ ولا تَلُم","وبالبَذلِ مِن شَكَوى صَديقِكَ فامدُدِ",22,"د",1,0],["وَلا تَلُمْ خِلاً عَلَى هَفْوَةٍ","فَقَلَّمَا تَلْقَى فَتىً أَمْجَدَا",23,"د",2,0],["وَلا تَلْتَمِسْ نَيْلَ الْمُنَى مِنْ خَلِيقَةٍ","فَتَجْنِي ثِمَارَ الْيَأْسِ مِنْ شَجَرِ الْبُخْلِ",24,"ل",1,0],["وَلا تَلجُّوا إِذَا مَا الرَّأْيُ لاحَ لَكُمْ","إِنَّ اللَّجَاجَةَ مَدْعَاةٌ إِلَى الْفَشَلِ",25,"ل",1,0],["وَلا تَلْتَمِسْ مِنْ غَيْرِ مَوْلاكَ هَادِياً","إِذَا اللهُ لَمْ يَهْدِ الْعِبَادَ فَمَنْ يَهْدِي",26,"د",2,0],["وَلا تَلْتَمِسْ أَمْرَاً يَزِيدُكَ يَقْظَةً","فَلَيْسَ لإِدْرَاكِ اليَقِينِ مَزِيدُ",27,"د",1,0],["وَلا تَلَفَّتُ إِلاَّ","وَجِيرَةُ الحَيِّ صُورُ",28,"ر",1,0],["ولا تلمُسِ الكأسَ التي قد رشفتها","أخاف على كفيكَ من حرّ أنفاسي",29,"ي",1,0],["ولا تلق للتنفيذ أذنا فانه","له بيعة صدق وقدر ملازم",30,"م",1,0],["ولا تُلاقي كما لاقَتْ بَنو أسَدٍ،","فقدَ أصابَتْهُمُ منها بشُؤبُوبِ",31,"ب",1,0],["ولا تَلْحَينّي في أنْ أذِلَّ","صِفْراً من الإلّ فالوُدُّ إلّ",32,"ل",1,0],["وَلا تَلحُ إِلّا مَن أَلامَ وَلا تَلُم","وَبِالبَذلِ مِن شَكوى صَديقَكَ فَاقتَدِ",33,"د",1,0],["ولا تلال كهنود الدمى","ولا سفوح كتراقيها",34,"ي",3,0],["ولا تلوعني نظرة العطف إنني اع","تماداً على علياك لاو عن الملك",35,"ك",1,0],["ولا تلبثتُ في الإبطاءِ منحرفاً","عنكم وعن شاهديكم منطقي وَفَمِي",36,"م",2,0],["ولا تلم مهجتي فيما تكابده","فأنت عني بحالات الغرامِ خلي",37,"ل",2,0],["ولا تُلقيَنَّ البأسَ عند احتقارهِ","ألا ربما جر الخطوبَ صغيرُها",38,"ر",3,0],["وَلا تَلقَهُ مُستَعتِباً مِن ظُلامَةٍ","فَما الدَهرُ سَمّاعاً لِمَن جاءَ عاتِبا",39,"ب",2,0],["وَلا تَلَفَّت إِلى أَهلٍ وَلا وَطَنٍ","فَالحرُّ يَرحَلُ عَن دارِ الأَذى كَرَما",40,"م",2,0],["وَلا تَلحَياها إِنَّها خَيرُ عُدَّةٍ","لِنَفسٍ إِذا بَعضُ الهُمومِ عَراها",41,"ا",3,0],["وَلا تَلَفَّت إِلى قَولٍ يَزيِدُ ضَنىً","لا تَحرِقُ النارُ إِلّا رِجلَ واطيها",42,"ي",3,0],["وَلاَ تَلْتَفِتْ مِنْهُمْ لِمَدْحٍ وَلاَ هِجاً","فَذَمُّهُمُ مَدْحٌ وَمَدْحُهُمُ بَذَا",43,"ذ",2,0],["وَلا تَلم في الهوى العذرى ذا شجن","في الغور هب له ريح الصبا فصبا",44,"ب",2,0],["وَلا تَلَذَّذتُ بِالمَطعومِ مُنهَمِكاً","وَلا سَعَيتَ لَدَينا سَعى مُفتَتَنِ",45,"ن",1,0],["ولا تلمس الشيء النفيس لشهوة","ولمسك مال الغير من دأب وغدان",46,"ن",1,0],["ولا تله عما يشتهيه جميعه","سوى ما نهى عنه مكون أكوان",46,"ن",1,0],["ولا تلحأن غنيت فيك تطرباً","فلو وجدت وجدي الجبال لغنت",47,"ت",1,0],["ولا تَلُمِ المُتيَّمَ في هواهُ","فعَذْلُ العاشِقينَ من الخَطايا",48,"ا",3,0],["ولا تلكَ السماءُ لهم سماءٌ","كأَنَّهُم الأَفاعي في وِعاءِ",49,"ا",2,0],["ولا تلاعب تائهاً عربيدا","إن الطباع تَعشِقُ التّقليدا",50,"د",2,0],["ولا تلاوةَ إِلاَّ ما نُكَرِّرُهُ","من مُبْتَدَى النَّحْلِ أو من مُنْتَهَى صادِ",51,"د",1,0],["ولا تلجّجْ إنْ طَما موجُها","فربّما أصبحَ طُوفانا",52,"ن",2,0],["ولا تلمسوا بعد التجارب حدَّها","فإن بني عبد الرحيم أُولاكا",53,"ك",2,0],["ولا تَلْقَ يومَ الرَّوع إلا مُصالتاً","بجَدِّك إن كلَّت ظُبىً وشِفارُ",54,"ر",1,0],["ولا تُلزمنِّي في العتاب بقيّةً","فسادُك فيها فاتكٌ بصلاحي",55,"ح",2,0],["ولا تلك التي نثرت دموعا","ونادت زوجها والقلب دام",56,"م",1,0],["ولا تلق للحساد بالاً بما لغوا","فما مسَّ زور الحاسدين نعالنا",57,"ن",2,0],["ولا تلفتي عزم الفؤاد بكله","ولو رمش عينٍ عن رحاب المدينة",58,"ه",1,0],["ولا تُلْفِتْ إلى الآمالِ قَلْباً","وخُذْ عن شَيْخِكَ المَهْدِيِّ زِيَّهْ",59,"ي",2,0],["ولا تلجْلَجَتِ الأجسادُ في نَفَسٍ","إِلاَّ وأٌفرِغَ فيه منكَ إحياءُ",60,"ا",2,0],["ولا تلحني فيمن أحب فإنني","أضن به مما تظن وأشغف",61,"ف",1,0],["ولا تلذّذْتُ في مُرِّ العَذابِ بكمْ","إنْ كان يعْذُبُ إلّا ذِكرُكُمْ بفَمي",62,"م",2,0],["ولا تلا المدح على سمعه","أبشر فشانيك هو الأبتر",63,"ر",1,0],["ولا تَلْحَني إنْ ضَلّ عنّي تصبُّري","فقد ضلّ عنّي صاحبي وقريني",64,"ن",2,0],["ولا تلَمهُ ورؤوسٌ لنا","سليمةٌ إنْ عاث بالأرجلِ",65,"ل",1,0],["وَلا تُلزميني اليوم عَيباً بصبغةٍ","سَتكتسبيها إِنْ بقيتِ لها غدا",66,"د",2,0],["ولا تلتفت للحاسدين فإنهم","يقاسون من حبل الوداد انقطاعه",67,"ع",2,0],["ولا تلوموه إنه رجل","عن الصفا قد ثناه تكديره",68,"ر",2,0],["ولا تَلُمْ دَمْعَكَ في سَكْبِه","فإِنَّه وافاك في حِينهِ",69,"ن",2,0],["وَلا تَلِم النَّوَآ في أكلِ لَحمي","هَنيئاً كُّلَما أَكَلَتَ مَريّا",70,"ي",2,0],["ولا تَلتَهب إن أخلَبت في بُروقِها","عَليكَ ولا إن أجلبت في رُعُودِها",71,"د",3,0],["وَلا تلمني عَلى عشق لغانية","بِها تنعَّم في دين الهَوى بالي",72,"ل",2,0],["وَلا تَلمني عَلى التَأكيد في طَلبٍ","فيهِ الشِفاء مِن الأَمراض وَالعلل",73,"ل",1,0],["ولا تلتفتْ نحو الذنوب التي مضت","فمنها بَلائي الآن أعظم دائي",74,"ي",1,0],["ولا تلفتْ فيها إلى قول قائلٍ","وكن بالذّي جادتْ به جدُّ مفتونِ",75,"ن",1,0],["ولا تلاحِ مُلاحٍ","ولا تفاخرْ مُفاخر",76,"ر",1,0],["ولا تلتفِتْ للعميق ِالسَحيقِ","ولكِنْ إلى الأعْمَق ِالأسْحَق",77,"ق",1,0],["ولا تلبس الاوجال ان لاح مكسب","فتمسي وقد أهدت الى قلبك القلبا",78,"ا",1,0],["ولا تلتوي إن قيل تشفى بشربها","فقم هاتها صرفا ودعني بها أشقى",79,"ق",2,0],["وَلأَتْلوَنَّ قَطيعَةٍ بِقَطيعَةٍ","أَنَفاً كمَا تَلَتِ الْبُروقَ رُعُودُ",80,"د",1,0],["وَلا تَلَوْتُ أساطِيرَ الْغَرامِ وَلا","مَحا سُطورَ الأَسى من عَبْرَتي ماحِ",81,"ح",1,0],["ولا تلج البحر المحيط فانه","حوى لججاً عند التأمل مخطره",82,"ر",2,0],["وَلا تَلَبَث بِحَيٍّ فيهِ ضَيمٌ","يُميتُ القَلبَ إِلا إِن كُبِّلتا",83,"ت",2,0],["وَلا تَلاهُ عالِمٌ في كُتبِهِ","رَوَّضَها اللَّهُ بِسارِي سُحبِهِ",84,"ه",1,0],["ولا تلق حاجاتي إلى غير قادر","على النزع والايتاء ما دمت باقيا",85,"ي",2,0],["ولا تلق بالمظلوم فيهم مذللاً","وقد مد بالشكوى إليك الأياديا",86,"ي",2,0],["ولا تلق يا ذا المجد حالي كسيرة","ومجدك يا ذا المجد أسنى ذريعتي",87,"ي",1,0],["وَلا تُلزِمَنّي بِالتَّكَاسُلِ حُجَّةً","تُشَبِّبُهَا نَارُ الحَيَاءِ عَلَى خَدِّي",88,"د",2,0],["ولا تلمني فكيف أصنع في","سرم شديد الحكال مؤتكل",89,"ل",1,0],["ولا تُلْهِكَ الدنيا عن الحق واعْتَمِلْ","لآخِرةٍ لابُدَّ أَنْ سَتَصِيرُها",90,"ر",3,0],["وَلاَ تُلهِهِ الأشغَالُ عنْ نَشرِ طَيهَا","صِحَاحٍ عَلَى طُولِ المَدَى وَحِسَانِ",91,"ن",1,0],["ولا تلغو إذا الخطباء قامت","ولا تنطق لدى الخطباء هجرا",92,"ر",2,0],["ولا تلفت رأي الوشاة وقولهم","فكل إناء بالذي فيه يرشح",93,"ح",1,0],["ولا تلقى عصي السير الا","اذا وصلت لثاني السدين",94,"ن",1,0],["ولا تِلْكُمُ السَّلْوَى سِوى ما أَقُولُهُ","بسَلْواي عمّا كنت من شهوةٍ أَهْوَي",95,"و",2,0],["وَلا تُلفَ في شَرِّهِ هائِباً","كَأَنَّكَ فيهِ مُسِرُّ السَّقَمْ",96,"م",1,0],["ولا تلوموه على صده","باللَه فالغزلان تهوى النفار",97,"ر",1,0],["ولا تلقفت منه الريح خاطره","إلا وجدت بها روحاً وريحانا",98,"ن",2,0],["ولا تلجن يوما علي فإنني","أخاف إذا ما زرتني أن تمَزّقا",99,"ق",2,0],["ولا تلتفتْ إذ ذاك فحل جداله","فإن الكلابَ السودَ تولغن في الدما",100,"ا",1,0],["ولا تلتفت مَن ظنَّ سوءاً بنا ولا","تعرِّج عليه واعف عن سيءٍ فرط",101,"ط",1,0],["ولا تلم مهجة هذي العلى","إن تدمها أظفار أحزانها",102,"ن",3,0],["ولا تلين إذا عوسرتَ مقتسِراً","وكلّ أمرك ما يوسرت ميسور",103,"ر",1,0],["وَلا تَلق خلقا سائِلاً وزنَ ذرَّةِ","ولَو جادَ بالدُّنيا لسائِله بَذلا",104,"ل",2,0],["ولا تلوموا من عشق وعربد","فأكثر الأمه محمديّه",105,"ي",2,0],["ولا تلوي بكن عن التوقي","فتاة الغرب فهي لها وقاءُ",106,"ا",2,0],["ولا تلبسي إلا حروزاً كهذه","عليك كذى خضر أو خضر الغلائل",107,"ل",1,0],["ولا تلم يا شاني","وخلني وشاني",108,"ي",1,0],["ولا تلومن اقواماً بنظرته","غدوا سكارى بلا عقل ولا دين",109,"ن",1,0],["ولا تلوي لعرسك وهي ثكلى","وكنت مواسياً ثكلى الغريب",110,"ب",1,0],["ولا تلمني إذا شاهدت مربدةً","مني فعذري لدى العذريِّ قد وضحا",111,"ح",2,0],["ولا تلوِ عن ذكر بان اللوى","ففيه مُنى خاطري والنعيم",112,"م",1,0],["وَلا تَلحَظا غَيثاً سِواه فَإِنُّه","هُوَ البَحر يروي مَن أَتاه وَلا يَردي",113,"د",2,0],["ولا تلبسوا إلا القلوب فإنها","سرابيل بأس لا الدلاص المسرادا",114,"د",2,0],["ولا تلح على رد الجواب ولا","تجل بارض ظنون السوء والتهم",115,"م",1,0],["ولا تلفظ بغير الحق ممتثلا","والسمع والبطن فاحفظ ذين من تهم",115,"م",1,0],["ولا تلمِ الفتاةَ على خمول","فما كسلاً أردتَ ولا خمولا",116,"ل",2,0],["وَلا تَلُمَنِّي أن حَلَلْتُ مُقَضِّياً","مَناسِكَ أشْجانِي وضَحَّيتُ بالصَّبرِ",117,"ر",1,0],["ولا تلتفت لما جرى به حكمه","فليس ذلك من شأن أهل المحبة",118,"ه",1,0],["ولا تلبسوا بعدي السواد تحسّراً","ولكن ترَدّوا بالبياض لِفرحتي",119,"ي",1,0],["ولا تَلبَسوا خزَّ العِراقِ وقَزَّهُ","فكلٌّ يلبسُ المُخزياتِ لَبيقُ",120,"ق",1,0],["وَلاَ تَلِى فَارِقةً فَعُولاَ","أصلاً وَلاَ المِفعَالَ وَالمفعِيلاَ",121,"ل",2,0],["وَلأَتلُوَنَّ حُروفَ وَحيِكَ في الدُجى","وَلأُحرِقَنَّ بِنورِهِ شَيطاني",122,"ن",2,0],["ولا تلحني يا عذلي في صبابة","قصارى مداها حرقة وضرام",123,"م",1,0],["وَلا تَلقَ عَن عِلمي الغِطاءَ فَلَيسَ لي","بَوادِرَ تَحمي صَفوِهِ اَن يَكدرا",124,"ر",2,0],["ولا تلوما إذا ما عبرة همعت","فما استجم الحيا إلا لكي يكفا",125,"ف",2,0],["ولا تلوموا من غدا واجبا","قلبي فإن النوم أضحى حرام",126,"م",1,0],["ولا تلفظوا فيها فمهما لفظتُهم","بغير كتابٍ مستبينٍ يكن وهما",127,"م",2,0],["وَلا تلو عنّي الجيدَ تَأبى إجابَتي","وَقد ذُقتُ بعد العِزِّ ما طَعمَهُ الذلُّ",128,"ل",1,0],["ولا تلهك آمالك","عن الذكرى لشان الحين",129,"ن",1,0],["ولا تلم من تمنَّى الموت من سَقمٍ","إذا ألَجَّ عليه وهو في كمد",130,"د",1,0],["ولا تلُم عاشقاً يصبي لبهجتِها","فالحسنُ يعشق بالافكارِ والحدقِ",131,"ق",1,0],["ولا تلينُ على العلّات معجَمتي","في النائباتِ إذا ما مسّني طبَعا",132,"ع",2,0],["ولا تُلينُ من عودي غمائزُه","إذا المُعمر منها لان أو خضَعا",132,"ع",2,0],["ولا تُلقى لموتاهم قبورٌ","ولا تُوسى لجرحاهم جروح",133,"ح",1,0],["ولا تلمْ يا رفيقي في محبتِها","هي التي سرقتْ عمري فلا عجبُ",134,"ب",1,0],["ولا تَلعَنِ الدَّارَ ما دُمتَ فيها","فلا تَملِكُ الدَّارُ كالنّاسِ نَقلا",135,"ل",2,0],["ولا تَلحهُ أو تستبينَ سبيلهُ","وتعرفَ من قرب أضلَّ أم أهتدى",136,"د",2,0],["ولا تلتفِتْ يوما إلى مُتزمِّتٍ","لقولكَ يَنْفي تارةً ويحرِّفُ",137,"ف",1,0],["ولا تلُمني فإن الشعرَ جيّدُه","يأبى اصطحابي، ولا أرضى بمؤتشب",138,"ب",1,0],["ولا تلغية ثوراتٌ تتالت","ولا التشطيرُ جلّ به المُصابُ",139,"ب",1,0],["ولا تلمِ الأقدار ما أنت مجبر","على مسلك وعرٍ تنوء به ثقلا",140,"ل",2,0],["ولا تلهيك المعزى بمعزاء واعتبر","بذفرى وذفرا فذال وفاء",141,"ا",2,0],["وَلَا تُلْقِ المَلَامَةَ نَحْوَ جِيلٍ","تَرَبَّوا فِى شَوَارِعِنَا وّجَاعُوا",142,"ع",3,0],["ولا تلذين مع صبٍ لذاذته","بحسن جسمك لما بالجمال خلا",143,"ل",2,0],["ولا تليق بأن تأوي مغاني حنّ","ان عليها به إحسانه غدرا",144,"ر",2,0],["وَلا تَلُومِي, فإِنَّ اللَّومَ زَلزَلَةٌ","وَالصَّفحَ طَبعٌ جَلِيلٌ, وَالوِدادَ أَجَلْ",145,"ل",1,0],["ولا تلماني أن أهيم بحبها","فكم هام بالحسن العريق حليم",146,"م",1,0],["ولا تلمها على حزن وقد نكبت","وردّ واردها بالغيظ حين ظمي",147,"م",2,0],["ولا تلقى على مي نصوحا","وكم لاقيت في مي عذولا",148,"ل",2,0],["ولا تلمز أخاك بلا اكتراث","ألا حافظ على نشر الإخاء",149,"ا",2,0],["ولا تلمها إذا ألوت معاطفها","يوما لتقبيل باديها وخافيها",150,"ي",3,0],["‏ولا تَلُمْ عَاشِقاً شَطَّ المَزَارُ بهِ","سَرَى يُنَاجِي بلَيْلِ السُّهْدِ ليْلاهُ ‏",151,"ا",2,0],["ولا تلتفتْ إنَّ الوراءَ سفائنٌ","ستحرقها والبحرُ دونك والعدا",152,"د",2,0],["ولا تلمني اذا سحَّتْ مدامعُنا","فكلُّ دمعِ الهوى يبكيه هيمانُ",153,"ن",1,0],["ولا تلدُ الأرضُ الشجاعَ، وإنما","الشجاعُ الذي في حضنِ عزتِها شبَّا",154,"ب",2,0],["وَلاَ تَلَذَّذْتُ فِي مُرِّ الْعَذَابِ بِكُمْ","إِنْ كَانَ بَعْذُبُ إِلاَّ ذِكْرُكُمْ بِفَمِي",155,"م",2,0],["ولا تلم قلقى فيها ولا جزعى","ما الصّبر عن مثلها عندى بمحمود",156,"د",1,0],["ولا تلحق المقفي عبار ومشاريه","انسه ولايلحقك لومه اليالام",157,"م",1,0],["ولا تلهبُّ ذاك البرق منه حكى","لهيبَ قلبٍ مشوقٍ فيه ما فيه",158,"ي",2,0],["ولا تلتقي الأطيافُ إلّا لوُدِّها","كذاكَ قضى الرحمنُ ما كانَ قاضيا",159,"ي",2,0],["ولا تُلِمَّ بِربْعِ الشِّعْرِ إنَّ لَهُ","ظُعْناً تأخَّرتَ عن مَسْرَاهُ إذْ سَارَا",160,"ر",2,0],["ولا تلوم احدن بحسنك سبيته","مثلي ما ينلام لو يلاقيك",161,"ك",1,0],["وَ لَا تَلَلتُ عُتُلًّا تَحتَ قافِيَتِي","إِلَّا وَ غَرغَرَ فِي كَفَّيَّ مَهزُوما",162,"م",2,0],["وَ لا تلومَنَّ أحلاميْ إذَا انْطفأتْ","فمُنتهَى الحُلمِ أنْ ترسُو علَى المُقلِ",163,"ل",1,0],["ولا تلقَ يومَ الروع إلا مصالتا","بجدك إن كلت ظباً وشفارُ",164,"ر",1,0],["ولا تلتفتْ إذ ذاك فخل جداله","فإن الكلابَ السودَ تولغن في الدما",165,"ا",1,0]]}