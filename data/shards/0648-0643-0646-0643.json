{"poems":[[91,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[45,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[71,"لا تقنعن بدون","https://www.aldiwan.net/poem28598.html","المجتث"],[15,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem45262.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140854",""],[45,"أحاد أم سداس في أحاد","https://www.poetsgate.com/ViewPoem.aspx?id=138",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[132,"مشايخنا مصابكم عظيم","https://www.aldiwan.net/poem50526.html","الوافر"],[216,"ألا فاستمع يا نجل يحيى مقالتي","https://www.aldiwan.net/poem37865.html","الطويل"],[308,"صديقك مهما جنى غطه","https://www.aldiwan.net/poem58233.html","المتقارب"],[415,"تطامن إذا أنكرت دهرك إنما","https://www.aldiwan.net/poem31680.html","عموديه"],[463,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[543,"دع المباهج لا تحفل بمتعتها","https://www.aldiwan.net/poem47513.html","عموديه"],[556,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86855","الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39157","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65038","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111862","البسيط"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58298","الوافر"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198450","المتقارب"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145071","المجتث"],[3293,"","https://poetry.dctabudhabi.ae/diwan/poem/146471","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62841","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62846","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86253","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216817",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34594","الهزج"],[3853,"","https://poetry.dctabudhabi.ae/diwan/poem/124002","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44723","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127060","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4797,"عقبال مية عام","https://www.poetsgate.com/ViewPoem.aspx?id=29438",""],[5038,"تجمّل بالتّقى","https://www.poetsgate.com/ViewPoem.aspx?id=188253",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5558,"لكنّه قد يُرى بالبسمة البخْلُ","https://www.poetsgate.com/ViewPoem.aspx?id=211795",""],[5561,"رحيلُ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192742",""],[5616,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203486",""],[5809,"الشمس والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=205557",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5957,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=24468",""]],"verses":[["وكن كأزهار الربيع مبادياً","أهذي لهاتيك المبادي عواقب",0,"ب",1,0],["وَكُن كَاللَيثِ يَأتي مِن أَمامِ","فَيَملَأُ كُلَّ ناطِقَةٍ وُجوما",1,"م",2,0],["وَكُن كَالنَحلِ وَالدُنيا الخَلايا","يَمُرُّ بِها وَلا يَمضي عَقيما",1,"م",2,0],["وَكُن كَالأُسدِ عِندَ الماءِ تَجري","وَلَيسَت وُرَّداً حَتّى تَحوما",1,"م",2,0],["وَكُن كَالمَوتِ لا يَرثي لِباكٍ","بَكى مِنهُ وَيَروي وَهوَ صادِ",2,"د",1,0],["وَكُن كَريماً تَجِد كَريماً","في مَدحِهِ يا أَبا المُغيثِ",3,"ث",1,0],["وكنْ كغائصِ بحرٍ","مخاطرٍ للآلي",4,"ل",2,0],["وَكُنَّ كَأَسرابِ القَطا هاجَ وِردَها","مَعَ الصُبحِ في يَومِ الحَرورِ رَميضُ",5,"ض",1,0],["وكن كالموت لا يرثي لباكٍ","بكى منه ويروي وهو صادي",6,"د",2,0],["وَكُن كَالمَوتِ لا يَرثي لِباكٍ","بَكى مِنهُ لَيَرْوَى وَهوَ صادِ",7,"د",1,0],["وكن كما أنت قاسٍ كيساً فطناً","فللجفاء كما للرفق أحيان",8,"ن",1,0],["وكنْ كأخيك سيفٍ ذى المعالي","هزبرٌ لا تروِّعه الكلومُ",9,"م",1,0],["وكنْ كابنِ جوفالِ بِفُرْضَةِ مسقط","لأنكَ من دمّ الخِتانة تفزع",10,"ع",1,0],["وكن كالظلام مع النار إذ","يوارى الأوار ويبدي السنا",11,"ن",2,0],["وكن كالذباب إن رأى الريح عاصفا","تلاصق من خوف الأذية بالأرض",12,"ض",1,0],["وكن كعليٍّ أو فكن لي كثابتٍ","وفاءً وإعطاءً وإنْ شئتَ فازددِ",13,"د",1,0],["وكُن كَبِنِبينَ بالعِرفَانِ ذَا شغَفٍ","فبينَ بينَ إلى بِنبينَ أُهدِيهَا",14,"ه",2,0],["وَكُنْ كَمَن أنت مشغوفٌ بسيرتهِ","ممّن أصابهمُ المكروه فاِحتزموا",15,"م",3,0],["وَكُن كَأبيك حَيث بِهِ اِستَقامَت","أُمور الملك وَاِزدان السَرير",16,"ر",1,0],["وكُنْ كما كُنْتَ لَهُ أوّلاً","يَكُنْ لَكَ الآنَ كما كانَ لَكْ",17,"ك",1,0],["وكن كهفه يوم التغابن وأته","من الأجر كفلا يدفع الإثم والإسرا",18,"ر",2,0],["وكُنْ كأَبي الأَشبالِ غيرَ مُصاحِبٍ","صِحاباً سِوَى أَنيابِه والمخالبِ",19,"ب",1,0],["وكن كما شئت في الحالين ممتدحاً","فالشمس رأد الضحى كالشمس في الجملِ",20,"ل",1,0],["وكن كمثل واسطي غفلة","عن شم ضارع وعتب سقق",21,"ق",1,0],["وكن كعرقب وضب مع من","عليك قلبه امتلا بالحنق",21,"ق",1,0],["وَكُنْ كالتّيسِ ذا نابٍ وَقُرنٍ","وَكن كالكلبِ ذا نابٍ وَظُفرِ",22,"ر",1,0],["وَكُنْ كخرا تَلوكُ البوزَكستي","أميرَ الروم في أَكنافِ مصرِ",22,"ر",1,0],["وكن كالطريق لمجتازها","يمر وأنت على حالكا",23,"ك",2,0],["وكن كسولا خمولا","غر الفؤاد غبيا",24,"ي",2,0],["وكن كالشمس تطلع كل يومٍ","ولا تك في زيارته هلالا",25,"ل",2,0],["وكن كأَبيكَ حينَ رآكَ أَهلاً","لما أَبدى إليكَ وما أَعَادا",26,"د",2,0],["وكن كأَبيكَ تُنْكِرُهُ الهُوينا","وتَعرِفُهُ المطرقةُ الوَلُودُ",27,"د",1,0],["وَكُن كَيفَ شَئتَ اليَومَ في ما تَرومُهُ","لَكَ السَعدُ عَبدٌ وَالزَمانُ خَديمُ",28,"م",1,0],["وكن كما كان كل رب","جل عن الصغو والجواب",29,"ب",1,0],["وكن كاسمك لا تَمن","عك النخوةُ والكبرُ",30,"ر",1,0],["وكن كغيلان ميّ يوم موقفه","بدار مية يستسقى لها المطرا",31,"ر",2,0],["وَكُن كَوكَباً يَطوي المَنازلَ سائِرا","لِيَحتَلَّ أَوجاً قَد تَوخّاهُ في البَحرا",32,"ر",2,0],["وكن كفيلا بخلاص امرئ","ما زال في بحر الخطا يغمر",33,"ر",1,0],["وكن كالنجم حين هوى","ومثل الليث منتهرا",34,"ر",2,0],["وكنك معي وانا فقدتك من اعوام","مع الخيال القاك كني لقيتك",35,"ك",1,0],["وَكُنْ كَاللّيثِ لِلأقْرانِ نِدّاً","صَدوقاً لا يُداخِلُهُ الرِّياءُ",36,"ا",2,0],["وكن كأباً في الله ناءٍ إباؤه","ذراه نجا جادت عليه نجاء",37,"ا",2,0],["وكنْ كريماً على من غارَ مبسمُه","فبسمةٌ منك يشفى دونها الغلُّ",38,"ل",1,0],["وكن كالّذي للصلاةِ وفيٌّ","بحُسنِ يقينٍ ونوحِ ضمير",39,"ر",1,0],["وكن كالورد ينفحنا عبيراً","ونحن ندوسه فيظل حيّا!",40,"ي",2,0],["وكن كالنخل يمنحنا ظلالاً","ويُسقط فوقنا رطباً جنيّا",40,"ي",2,0],["وكنُ كالشمسِ إننْ زَعَلَتْ مساءً","تصالحُنا وتضحكُ في الصباحِ",41,"ح",1,1],["وكنْ كالبدرِ يطلعُ في ليالٍ","به تحلو،فتوصَفُ بالمِلاحِ",41,"ح",1,0],["وَ كُنْ كَا النَّحْلِ مِنْ زَهْرٍ لِزَهْر","وَ لا تَخْشَىَ مِنَ الغُصْنِ اِرْتِعَادَا",42,"د",2,0],["وكن كالصباح يشع ضياءً","لكل بعيد وكل قريبِ",43,"ب",1,0]]}