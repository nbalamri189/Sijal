{"poems":[[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[86,"طف بالأريكة ذات العز والشان","https://www.aldiwan.net/poem68949.html","البسيط"],[37,"لا ذوات القرون ينطحن جما","https://www.aldiwan.net/poem7315.html","الخفيف"],[51,"لا يحزننك من يموت","https://www.aldiwan.net/poem65836.html","مجزوء الكامل"],[91,"أشقى البرية نفسا صاحب الهمم","https://www.aldiwan.net/poem62723.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[28,"لو كنت في الثأر الذي كنت طالبا","https://www.aldiwan.net/poem4974.html","الطويل"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[61,"تذكر نجدا فحن ادكارا وأرقه","https://www.aldiwan.net/poem51684.html","المتقارب"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[66,"وحق من لا سواهم عندي القسم","https://www.aldiwan.net/poem39644.html","البسيط"],[80,"لا ذنب للطرف في معداه يوم كبا","https://www.aldiwan.net/poem31260.html","البسيط"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[105,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[105,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[105,"وفد الفارس الذي تفرق الأب","https://www.aldiwan.net/poem44008.html","الخفيف"],[81,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"أقول لصاحبي ومثل ما بي شكاه","https://www.aldiwan.net/poem42306.html","الوافر"],[52,"لا ذنب لا ذنب لابن العير حين هوت","https://www.aldiwan.net/poem26623.html","البسيط"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"فكروا في الأمور يكشف لكم بع","https://www.aldiwan.net/poem22733.html","الخفيف"],[46,"لا ذنب للدنيا فكيف نلومها","https://www.aldiwan.net/poem22844.html","الكامل"],[68,"ما بين ضال المنحنى وظلاله","https://www.aldiwan.net/poem1518.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43859","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[45,"أنظر إلى ناظر قد شفه السهد","https://www.poetsgate.com/ViewPoem.aspx?id=31304",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"صاحب القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53269",""]],"verses":[["لا ذِراعي رِخوَةُ الحَب","لِ وَلا السيفُ كَهامُ",0,"م",1,0],["لاذَت بِسُدَّتِكَ العَلياءِ وَاِعتَصَمَت","وَأَخلَصَت لَكَ في سِرٍّ وَإِعلانِ",1,"ن",1,0],["لا ذوات القرون ينطحن جُمَّا","في حشاه ولا الذليلُ ذليلُ",2,"ل",1,1],["لا ذاق ثُكلكَ ذائقٌ","حتى يرى في الناسِ مِثْلَكْ",3,"ك",1,0],["لا ذاقَ جَفني الكَرى حَتّى تَنالَ يَدي","ما لا يَفوزُ بِهِ غَيري مِنَ الحُلُمِ",4,"م",1,0],["لا ذَنبَ لِلأَقدارِ في إِذلالِكُم","هَذا جَزاءُ الغافِلِ المُتَواني",5,"ن",2,0],["لأذوبَ في فجر الجمال السرمديِّ","وأرتوي من مَنْهَلِ الأَضواءِ",6,"ا",2,0],["لَأَذكَرتَهُ بِالرُمحِ ما كانَ ناسِياً","وَعَلَّمتَهُ بِالسَيفِ ما كانَ جاهِلا",7,"ل",2,0],["لاذَت بِحَرِّ القَيظِ فَامتَنَعَت بِهِ","وَتَعَوَّذَت بِالقُربِ مِن رَمَضانِ",8,"ن",1,0],["لَأَذهَبتُ عَنكَ الخُزيَ في كُلِّ مَشهَدٍ","وَأَصبَحتَ لا يَلحى فَعالَكَ لاحِ",9,"ح",1,0],["لأَذكرَني أعزَّ الناسِ جاراً","وأحلى الأرضِ في عينيَّ دَارا",10,"ر",2,0],["لأَذكَرَني بِشرَه عارضٌ","أضاءَ دُجى اللَّيلِ حتَّى أنارا",11,"ر",2,0],["لاذَ بِهِ الوافِدونَ فَاِمتَلَأَت","مِنهُ يَداهُم وَصَدَّقوا الأَمَلا",12,"ل",2,0],["لا ذَنبَ لي يوجِبُ الهِجرانَ عِندَكُمُ","وَهَبهُ كانَ فَأَينَ العَفوُ وَالكَرَمُ",13,"م",1,0],["لا ذَنْبَ للطِّرْفِ في مَعْداهُ يوم كبا","بالبحرِ والطّوْدِ والضّرْغامِ من حَسَنِ",14,"ن",1,1],["لأذكيتَ نارَ العِزّ وهي التي بها","وَضَعْتَ سماتِ الذلّ فوْقَ المَخاطمِ",15,"م",1,0],["لا ذَنبَ لي غَيرَ ما سَيَّرتُ مِن غُرَرٍ","شَرقاً وَغَرباً وَما أَحكَمتُ مِن عُقَدي",16,"د",2,0],["لا ذو الحُقودِ اللُقَّحِ اللاتي تَرى","كَشحَ الصَديقِ وَلا العِداتِ الحُيَّلِ",17,"ل",1,0],["لاذوا بِحُسنِ الصَبرِ حَتّى زَلزَلَت","هوجُ الحَوادِثِ رُكنَهُ فَتَداعى",18,"ع",2,0],["لاذَ الغُواةُ بِهِ وَاِستَعصَمَت فِئَةٌ","شُرُّ الكَبائِرِ مِن أَدنى مَساويها",19,"ي",3,0],["لا ذَنبَ لِلدَهرِ فيما نالَ مِن أُمَمٍ","جَدَّ النِضالُ فَلَم يَغلِبهُ راميها",19,"ي",3,0],["لاذوا بِهِ وَأَذاعوا كُلَّ رائِعَةٍ","مِنَ الأَحاديثِ تَضليلاً وَتَمويها",19,"ي",3,0],["لاذَتْ بأكنانِها القُصوى ولو قَدرتْ","لاذتْ من الزّاخرِ الطّامِي بأكنانِ",20,"ن",1,0],["لأُذِيقنَّهُ الجَزاءَ أليماً","فيرى موضِعي وكيفَ يُدانُ",21,"ن",1,0],["لا ذَنبَ إِلّا عاشِقٌ","أَذعَنَ يَبغي النَصَفا",22,"ف",2,0],["لا ذَت بِهِ أَهلُ العِرا","قِ بِلا أَلَفَّ وَلا مُواكِل",23,"ل",1,0],["لَأَذكُرُ إِسمَها ما دُمتُ حَيّاً","وَما الرَجُلُ المُصَرِّحُ كَالكَتُومِ",24,"م",1,0],["لا ذَنبَ لا ذَنبَ لِاِبنِ العَيرِ حينَ هَوَت","قُواهُ مِن خَوَرٍ فيها وَمِن لينِ",25,"ن",1,1],["لا ذاتَ سِربٍ يُعَرّي الرَ","دى وَلا ذاتُ سُربَه",26,"ب",2,0],["لا ذُكورٌ وَلا إِناثٌ مِنَ العا","لَمِ يُهدى لِلرُشدِ بِالتَذكيرِ",27,"ر",1,0],["لا ذَنبَ لِلدُنِّيا فَكَيفَ نَلومُها","وَاللَومُ يَلحَقُني وَأَهلَ نِحاسي",28,"ي",1,1],["لا ذُقْتُ يوماً راحةً من عاذلٍ","إنْ كنتُ مِلْتُ لقِيلهِ ولِقاله",29,"ل",2,0],["لا ذِمَّتِي رَهْنُ الْفِكَاكِ وَلا يَدِي","تُلْقِي أَزِمَّةَ عِفَّتِي وَحَبائِي",30,"ا",2,0],["لاذَت بِكَ الحورُ قائِلات","اِرقُد هَنيئاً نَعِمت بالا",31,"ل",2,0],["لاَذَتْ بِأَكْبَرِ مِعْوَانٍ لِذِي أمَلٍ","نَاءٍ وَأَشْرَفِ عُنْوَانٍ لِمُنْتَسِبِ",32,"ب",1,0],["لا ذنب راميه للمناب ولا","آمال أوطانه ستغتفره",33,"ر",2,0],["لا ذقت ما ذاقه من أنت مالكه","ولا وجدت به مثل الذي يجد",34,"د",1,0],["لا ذنب للأقدرا في إذلالكم","هذا جزاء الغافل المتواني",35,"ن",2,0],["لا ذاق جفني الكرى تنال يدي","ما لا يفوز به غيري من الحلم",36,"م",1,0]]}