m/ViewPoem.aspx?id=188467",""],[5376,"أرَّا ومارَّا والعواصمُ واحدُ","https://www.poetsgate.com/ViewPoem.aspx?id=196641",""],[5410,"ألم","https://www.poetsgate.com/ViewPoem.aspx?id=142535",""],[5431,"الحب معجزة","https://www.poetsgate.com/ViewPoem.aspx?id=191865",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5431,"وتفيض في آباري العطشى...","https://www.poetsgate.com/ViewPoem.aspx?id=200190",""],[5431,"سوناتا العشق...","https://www.poetsgate.com/ViewPoem.aspx?id=200245",""],[5461,"يزحف الموت","https://www.poetsgate.com/ViewPoem.aspx?id=5305",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5525,"تالي نهار","https://www.poetsgate.com/ViewPoem.aspx?id=839",""],[5530,"ترتيلةٌ على حدّ المُحال","https://www.poetsgate.com/ViewPoem.aspx?id=197855",""],[5595,"لَقيتُها ، وكأنَّ الدّمْعَ يُؤنِسُها","https://www.poetsgate.com/ViewPoem.aspx?id=177969",""],[2110,"لا تبك رسما عفا ولا طللا","https://www.poetsgate.com/ViewPoem.aspx?id=156290",""],[5739,"اكتبيني بقرطاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131226",""],[5771,"بَدَاوة","https://www.poetsgate.com/ViewPoem.aspx?id=189436",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5776,"الفجر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=199936",""],[5830,"هَلْ كَنْتُ جُرْماً","https://www.poetsgate.com/ViewPoem.aspx?id=200766",""],[5853,"حلم باللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188363",""],[5939,"اخضعي","https://www.poetsgate.com/ViewPoem.aspx?id=195299",""],[6093,"لا ذنب للأيام غير مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=197274",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6152,"مودة من ورق","https://www.poetsgate.com/ViewPoem.aspx?id=203030",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[469,"أجنها الفكر وأبداها العبق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574814",""],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""],[6229,"بين يدي الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65210&r=&rc=33",""],[6248,"قميص لأوراق بيضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86025&r=&rc=2",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[6259,"أوقد البين في الخميس خميسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59386&r=&rc=34",""],[6310,"الزَّحف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71996&r=&rc=1",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""]],"verses":[["لا ذِراعي رِخوَةُ الحَب","لِ وَلا السيفُ كَهامُ",0,"م",1,0],["لاذَت بِسُدَّتِكَ العَلياءِ وَاِعتَصَمَت","وَأَخلَصَت لَكَ في سِرٍّ وَإِعلانِ",1,"ن",1,0],["لا ذوات القرون ينطحن جُمَّا","في حشاه ولا الذليلُ ذليلُ",2,"ل",1,1],["لا ذاق ثُكلكَ ذائقٌ","حتى يرى في الناسِ مِثْلَكْ",3,"ك",1,0],["لا ذاقَ جَفني الكَرى حَتّى تَنالَ يَدي","ما لا يَفوزُ بِهِ غَيري مِنَ الحُلُمِ",4,"م",1,0],["لا ذَنبَ لِلأَقدارِ في إِذلالِكُم","هَذا جَزاءُ الغافِلِ المُتَواني",5,"ن",2,0],["لأذوبَ في فجر الجمال السرمديِّ","وأرتوي من مَنْهَلِ الأَضواءِ",6,"ا",2,0],["لَأَذكَرتَهُ بِالرُمحِ ما كانَ ناسِياً","وَعَلَّمتَهُ بِالسَيفِ ما كانَ جاهِلا",7,"ل",2,0],["لاذَت بِحَرِّ القَيظِ فَامتَنَعَت بِهِ","وَتَعَوَّذَت بِالقُربِ مِن رَمَضانِ",8,"ن",1,0],["لَأَذهَبتُ عَنكَ الخُزيَ في كُلِّ مَشهَدٍ","وَأَصبَحتَ لا يَلحى فَعالَكَ لاحِ",9,"ح",1,0],["لأَذكرَني أعزَّ الناسِ جاراً","وأحلى الأرضِ في عينيَّ دَارا",10,"ر",2,0],["لأَذكَرَني بِشرَه عارضٌ","أضاءَ دُجى اللَّيلِ حتَّى أنارا",11,"ر",2,0],["لاذَ بِهِ الوافِدونَ فَاِمتَلَأَت","مِنهُ يَداهُم وَصَدَّقوا الأَمَلا",12,"ل",2,0],["لا ذَنبَ لي يوجِبُ الهِجرانَ عِندَكُمُ","وَهَبهُ كانَ فَأَينَ العَفوُ وَالكَرَمُ",13,"م",1,0],["لا ذَنْبَ للطِّرْفِ في مَعْداهُ يوم كبا","بالبحرِ والطّوْدِ والضّرْغامِ من حَسَنِ",14,"ن",1,1],["لأذكيتَ نارَ العِزّ وهي التي بها","وَضَعْتَ سماتِ الذلّ فوْقَ المَخاطمِ",15,"م",1,0],["لا ذَنبَ لي غَيرَ ما سَيَّرتُ مِن غُرَرٍ","شَرقاً وَغَرباً وَما أَحكَمتُ مِن عُقَدي",16,"د",2,0],["لا ذو الحُقودِ اللُقَّحِ اللاتي تَرى","كَشحَ الصَديقِ وَلا العِداتِ الحُيَّلِ",17,"ل",1,0],["لاذوا بِحُسنِ الصَبرِ حَتّى زَلزَلَت","هوجُ الحَوادِثِ رُكنَهُ فَتَداعى",18,"ع",2,0],["لاذَ الغُواةُ بِهِ وَاِستَعصَمَت فِئَةٌ","شُرُّ الكَبائِرِ مِن أَدنى مَساويها",19,"ي",3,0],["لا ذَنبَ لِلدَهرِ فيما نالَ مِن أُمَمٍ","جَدَّ النِضالُ فَلَم يَغلِبهُ راميها",19,"ي",3,0],["لاذوا بِهِ وَأَذاعوا كُلَّ رائِعَةٍ","مِنَ الأَحاديثِ تَضليلاً وَتَمويها",19,"ي",3,0],["لاذَتْ بأكنانِها القُصوى ولو قَدرتْ","لاذتْ من الزّاخرِ الطّامِي بأكنانِ",20,"ن",1,0],["لأُذِيقنَّهُ الجَزاءَ أليماً","فيرى موضِعي وكيفَ يُدانُ",21,"ن",1,0],["لا ذَنبَ إِلّا عاشِقٌ","أَذعَنَ يَبغي النَصَفا",22,"ف",2,0],["لا ذَت بِهِ أَهلُ العِرا","قِ بِلا أَلَفَّ وَلا مُواكِل",23,"ل",1,0],["لَأَذكُرُ إِسمَها ما دُمتُ حَيّاً","وَما الرَجُلُ المُصَرِّحُ كَالكَتُومِ",24,"م",1,0],["لا ذَنبَ لا ذَنبَ لِاِبنِ العَيرِ حينَ هَوَت","قُواهُ مِن خَوَرٍ فيها وَمِن لينِ",25,"ن",1,1],["لا ذاتَ سِربٍ يُعَرّي الرَ","دى وَلا ذاتُ سُربَه",26,"ب",2,0],["لا ذُكورٌ وَلا إِناثٌ مِنَ العا","لَمِ يُهدى لِلرُشدِ بِالتَذكيرِ",27,"ر",1,0],["لا ذَنبَ لِلدُنِّيا فَكَيفَ نَلومُها","وَاللَومُ يَلحَقُني وَأَهلَ نِحاسي",28,"ي",1,1],["لا ذُقْتُ يوماً راحةً من عاذلٍ","إنْ كنتُ مِلْتُ لقِيلهِ ولِقاله",29,"ل",2,0],["لا ذِمَّتِي رَهْنُ الْفِكَاكِ وَلا يَدِي","تُلْقِي أَزِمَّةَ عِفَّتِي وَحَبائِي",30,"ا",2,0],["لاذَت بِكَ الحورُ قائِلات","اِرقُد هَنيئاً نَعِمت بالا",31,"ل",2,0],["لاَذَتْ بِأَكْبَرِ مِعْوَانٍ لِذِي أمَلٍ","نَاءٍ وَأَشْرَفِ عُنْوَانٍ لِمُنْتَسِبِ",32,"ب",1,0],["لا ذنب راميه للمناب ولا","آمال أوطانه ستغتفره",33,"ر",2,0],["لا ذقت ما ذاقه من أنت مالكه","ولا وجدت به مثل الذي يجد",34,"د",1,0],["لا ذنب للأقدرا في إذلالكم","هذا جزاء الغافل المتواني",35,"ن",2,0],["لا ذاق جفني الكرى تنال يدي","ما لا يفوز به غيري من الحلم",36,"م",1,0],["لاذت به سادات حزب الاوليا","فافرغ القلوب في اطوارها",37,"ر",3,0],["لاذت بطول رحاب حضرة قدسها","عشاقها وجلالها غشاها",38,"ا",3,0],["لا ذنب للطرفِ إن زلت قوائِمُهُ","وهضبَةُ الحُلم إبراهيمُ يُزجِيها",39,"ه",2,1],["لا ذُقْتَ نقصا ما هَمَى وابلٌ","ومَا تَلا قارٍ على منبرِ",40,"ر",1,0],["لا ذَنْبَ لي إلا المشيبُ وهَكذا","كل الأنام إذا انتهت غاياتُه",41,"ت",2,0],["لاذوا بشم جبالهم من زاخرٍ","متلاطمِ الأمواجِ قد ملأ الملا",42,"ل",2,0],["لا ذَت بِكَ العَرَبُ العَرباءُ وَاِعتَلَقَت","مِن جودِ كَفِّكَ حَبلاً غَيرَ مُنقَضِبِ",43,"ب",1,0],["لا ذقت طعم الوصل إن لم أكن","على القضا في حبّه أمسك",44,"ك",1,0],["لا ذقت مولاي رزءاً بعدها أبدا","وأجزل الله في الدنيا لك العملا",45,"ل",2,0],["لأذكر ما قد فات في الحب بيننا","وانت معي يا روح جنباً إلى جنب",46,"ب",1,0],["لاذوا بِعائِشَةَ الطَهورِ فَأَقبَلَت","بِإِشارَةٍ فيها صَلاحُ الشانِ",47,"ن",1,0],["لِأُذهِبَنَّ حَياتي","ما بَينَ بَمٍّ وَزيرِ",48,"ر",1,0],["لا ذَنبَ لي فيما أَتَيتُ لِأَنَّني","قَبَّلتُ راحَتَهُ وَخَدّي مِخذَمُ",49,"م",1,0],["لا ذَنبَ للأيام عندي في الذي","صَنَعَت ويَعذرها الحليم لجهلها",50,"ل",3,0],["لِأَذكر أحلى ما لقيتُ وإن أكن","غريبَ الهوى والدارِ فالأثمنُ الأندر",51,"ر",1,0],["لا ذُقتَ مِن ذاكَ اللَّمى يا عاذِلي","فَإِنَّ لِلَهِ لَجُنداً مِن عَسَل",52,"ل",1,0],["لاذت بطلعته الشبيبة فانثنت","للغرب ترمق كالخبير العاقل",53,"ل",1,0],["لا ذَعَرتُ السَوامَ في غَلَسِ الصُب","حِ مُغيراً وَلا دَعَوتُ يَزيدا",54,"د",2,1],["لاذوا بأكنافنا فقالوا","السلم بالعاقلين أحرى",55,"ر",2,0],["لا ذَنْبَ عِنْدِي لِلَيتي","مِ إذا نَحَتْ بِهِ المَطَالِبْ",56,"ب",1,1],["لا ذَنبَ إِلّا لِلزَمان فَقَد بَغى","حَتّى دَعا الأَذناب أَن تَتَرأسا",57,"س",2,0],["لِأَذمَمتَ لي مِن صَروفِ الزَمانِ","وَغَيرُكَ رَبُّ الذِمامِ الذَميمِ",58,"م",1,0],["لاذوا بِستُرٍ رقيقٍ من تَجمُّلِهمْ","إلاّ ينَلْهمْ وشيكُ الغَوثِ يَنْكَشِف",59,"ف",1,0],["لا ذاكراً عِظَمَ الأحقادِ إن سلَفتْ","ولا لأدنَى حُقوقِ القومِ بالنّاسي",60,"س",2,0],["لا ذقتَ حرَّ صَبَابتي","وكُفيتَ ما أَلْقَى بها",61,"ه",2,1],["لا ذكرتُ الخَميس إِذا فاجأتَني","كُنَّ فيهِ وَلَستُ أَنسى الخَميسا",62,"س",2,0],["لا ذَنبَ لي كَم رمت كتم فَضائِلي","فَكَأَنَّما برقعت وَجه نَهاري",63,"ر",2,0],["لا ذَنبَ للصَبّ المشُوق إذا بَدَتْ","أسرَارُه يَومَ النّوى للعُذّلِ",64,"ل",1,1],["لا ذاقَ ريقك بعد ذلك إنْ صحا","أو كانَ يعثر غيّه برشاده",65,"د",2,0],["لاذت سلاطين الورى ببابه","ترجو مراضيه وتأبى إن أبى",66,"ا",1,0],["لا ذنبَ للعُشّاقِ إن عنب الهوى","كتمانهُ فضَح الغرامُ فاحوا",67,"ح",3,0],["لا ذنب للدهر إن الدهر ليس لهُ","حكمٌ وإن كثرت في ذاك أقوالُ",68,"ل",1,0],["لا ذنب إلّا إنني","شبهته ظبي النعم",69,"م",1,0],["لا ذَنبَ لي إلا هواهُ لأنني","لما دعاني للغرامِ أجبتُهُ",70,"ت",2,0],["لا ذَاتُ خِدْرِهمُ يُرَامُ لِوَجْهِهَا","كِنٌّ ولا ذو مَهْدِهمْ بمُمَهَّدِ",71,"د",1,0],["لأذكر فتيان الشباب الذي مضى","ورغدة عيش بالجمومين طيب",72,"ب",1,0],["لاذت بحقويه الأمور كما به","لاذوا ولاذ به اللواء الأعظم",73,"م",1,0],["لا ذو لسان يوم النديِّ ولا","مقياسُ رأيٍ إن حادثٌ هجما",74,"م",2,0],["لا ذقتَ ما ذقتُ من برحي جوىً وهوى","وقد تولّت سراعاً عنّي الظّعن",75,"ن",1,0],["لاذوا بعاديّ السيادة لا","كعداتهِ نبتوا مع البقل",76,"ل",1,0],["لا ذقتَ زلاً والجمالُ ولايةٌ","عاملتني فيها بغير الواجبِ",77,"ب",1,0],["لا ذنبَ للصبح وشمسٌ ما رأى","والعذرُ للَّيل ومسكٌ ما انتشق",78,"ق",1,0],["لا ذاقت ما ذاق الكئيب ولا سرى","بحشاكِ وجدُ المستهام المغرمِ",79,"م",1,0],["لا ذاقَ قلبي من طلولك سلوةً","فهو الذي أغناكِ عن مغناك",80,"ك",1,0],["لا ذنبَ لِلجَلْدِ يُبدي ما يكابِدُه","من الفراقِ إذا ما ناحَ أو باحا",81,"ح",2,0],["لا ذنبَ لي عندَ مَنْ رثَّتْ عهودُهمُ","اِلاّ بوادرُ شيبٍ جَرَّهُ الكِبَرُ",82,"ر",1,0],["لاذت إلى اصلح وانحلت عزائمها","مما اعتراها وما لاقته من لغب",83,"ب",1,0],["لاذَتِ الأَقطابُ في سُدَّتِهِ","عُرْبُهُمْ بين الوَرَى والعَجَمُ",84,"م",1,0],["لاذوبن الروح في نار الجوى","ولا حرقن القلب في بلبا له",85,"ل",2,0],["لا ذاق وصلاً من تبرم قبلفه","بمساكن وهواك من سكانه",86,"ن",2,0],["لا ذنب عندي للزمان وقد غدا","بدر بن رزيك كريم كرامه",87,"م",2,0],["لا ذو تُقىً في ظاهِرٍ مُتَجنبٌ","لأوَامرٍ مُتتَبِّعٌ لِنَوَاه",88,"ه",1,0],["لا ذاك يدري كيف خاب ولا درى","هذا عليهِ كيف كان حصولُهُ",89,"ل",2,0],["لا ذنبَ لي قبل المشيب وإنّني","لمؤاخذٌ من بعده بجرائرِ",90,"ر",1,0],["لاذوا بمن ثَمَرُ المروءَة يانعٌ","منه وأُمُّ المَكْرُماتِ وَلودُ",91,"د",1,0],["لا ذَنبَ عندي منه إلّا أنّهُ","كان السّفير لفرقةِ الأحبابِ",92,"ب",1,0],["لاذت الأنفس أن يعدمها","بتجليه كما شاء جلالا",93,"ل",2,0],["لا ذنب للعقل هذا قدر طاقته","وذاك منه تسابيح وأذكار",94,"ر",1,0],["لا ذاته تشبه الذوات ولا","صفاته كالصفات يا دود",95,"د",1,0],["لاذَتْ بساحتِكَ الوُفودُ وأطبَقَتْ","مثلَ ازدِحامِ الحجِّ في وادي مِنَى",96,"ن",2,0],["لا ذهبت دموع عيني العينا","إذا ذكرت قتلهم حسينا",97,"ن",2,0],["لاَ ذَنْبَ لِلعَيْنِ بَلْ لِلْقَلْبِ مَا خُلِقَتْ","إلّا لِيُدْرِكَ مَا يُبْدِي لَهُ البَصَرُ",98,"ر",1,0],["لا ذا ولا هذا فمال غنينا","في مصرف أوطار مثل هباء",99,"ا",2,0],["لا ذَعرتُ السوام في فلقِ","الصبح مغيراً ولا دُعيت يزيدا",100,"د",2,0],["لا ذنبَ للدهرِ فذا دَأبُه","قِدماً على أهلِ المَعالي ضَنين",101,"ن",1,0],["لاذَ بالدَّرب ثُم أدلَج يَستَر","جِف فَلاقَى وقُوعَكم بِمطاره",102,"ر",2,0],["لا ذكرَ فيه لأحمدٍ ووصيٍّه","وبَنيه ذلك مجلسٌ نَطِفٌ ردي",103,"د",2,0],["لا ذنب لي في البعد أعرفه سوى","أني حفظت العهد، لما خنتم",104,"م",1,0],["لأذى من أجله يلحقني","كلما بسقى ضحىً أو بالعشي",105,"ش",2,0],["لا ذنب للناس يوم الأربعاء بما","أصابني فيه من بؤس ومن محنِ",106,"ن",1,1],["لاذَ بِاللَّهِ تَعالى","مِن لَظى لَم تَك تُبقي",107,"ق",2,0],["لا ذَنبَ للناقِلِ الراوي لَكُم خَبراً","فيما رَواهُ إِذا لَم يَصدُقِ الخَبرُ",108,"ر",1,1],["لاذوا بِجاهِ المُصطَفى لمّا نَووا","رِفقَتنا وَلاِهتدا العِلم قفوا",109,"ف",3,0],["لا ذنب لي علِمَ الذي أسرَرته","نظرا ولم أرمز ولم أتكلم",110,"م",1,0],["لاذمة الأدب بالمضاعة عنده","كلا ولا عهد له بذميمِ",111,"م",1,0],["لأذاقَ حِزْبَ الكُفْرِ زَقُّومَ النَوَى","وَإن اسْتَغَاثَ سَقَاهُ كَأسَ فِرَاقِ",112,"ق",1,0],["لاذوا بتيجان الملو","ك فكان غوثَهُمُ فحيحُ",113,"ح",1,0],["لاذَت بِساحَت