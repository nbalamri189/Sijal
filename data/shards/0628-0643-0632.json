{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[415,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96699","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216439","الكامل"],[5861,"سر الداء","https://www.poetsgate.com/ViewPoem.aspx?id=188030",""]],"verses":[["بِكِ زَهْوُ آلِ بُشَارَةٍ أَهْلِ النَّدَى","أَهْلِ الْوفَاءِ لِخِدْنِهِمْ وَالجَارِ",0,"ر",1,0],["بك زادَ الإِسلامُ يا سيفَه المِخ","ذَمَ عزّاً وذلَّ شِركٌ وكُفرُ",1,"ر",1,0],["بك زيّن اللّه البلادَ فأَصبحت","كالبكرِ تسحب فضلة الأذيالِ",2,"ل",1,0],["بِكَ زَيِّنَت أرضُ الحجازِ لأنَّها","رأت الهِلالَ وأمَّها الإِنعامُ",3,"م",1,0],["بك زادت الأهرام ركناً والتقت","منها على بُعد الزمان دعائم",4,"م",1,0],["بكَ زهرتي أنبتُّها وسقيتُها","ولغيرِ حبّكَ ما رفعْتُ لوائي",5,"ا",3,0]]}