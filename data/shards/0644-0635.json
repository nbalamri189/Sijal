{"poems":[[93,"ما بين لصوص ولصوص","https://www.aldiwan.net/poem11192.html","المتدارك"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"إما تريني قالبا مجني","https://www.aldiwan.net/poem66392.html","الرجز"],[91,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[56,"ليس يخشى جيش الحوادث من جن","https://www.aldiwan.net/poem58558.html","الطويل"],[2,"كم للمنازل من عام ومن زمن","https://www.aldiwan.net/poem25005.html","البسيط"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"فأفرط في ترادفه وزادا","https://www.aldiwan.net/poem38682.html","الوافر"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[44,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[31,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[31,"يا نعم قد طالت مماطلتي","https://www.aldiwan.net/poem41843.html","الكامل"],[33,"لصفراء في قلبي من الحب شعبة","https://www.aldiwan.net/poem25819.html","الطويل"],[105,"أما ومضارب البيض الرقاق","https://www.aldiwan.net/poem43994.html","الوافر"],[52,"قم صاحبي نغدو لجيش الوحش","https://www.aldiwan.net/poem26891.html","الرجز"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140830",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[106,"شرع الاستعمار","https://www.poetsgate.com/ViewPoem.aspx?id=179645",""]],"verses":[["لِصِغَارِهِمُ المَوْتُ المُزْرِي","وَكِبَارِهِمُ الشَّرَفُ الأَسْنَى",0,"ن",2,0],["لصَريرهَا رَجْعٌ تَسَامَعُهُ النُّهَى","وَلَهُ رَنِينَ مَثَالِثٍ وَمَثَانِ",1,"ن",1,0],["لِصِغَارِ الْهُمُومِ تُقْتَلُ فِي أَنْ","فُسِ أَهْلِ النُّهَى كِبَارُ الْهُمُومِ",2,"م",1,0],["لَصائِدِها في الصَيدِ حَقٌّ وَطُعمَةٌ","وَيَخشى العَذابَ أَن يُعَرِّدَ ناكِلا",3,"ل",2,0],["لصفحتُ عن دهري به وذنوبُهُ","قد أوبقته أشدَّ ما إيباق",4,"ق",1,0],["لصاحب السوء بُعيدَ ضنِّي","به ومَنِّي صافياً مِنْ مَنِّي",5,"ن",2,0],["لِصاحِبٍ أَنا تَيّاهٌ بِصُحبَتِهِ","وَشاعِرٍ طالَما تاهَت بِهِ العَرَبُ",6,"ب",1,0],["لص الشباب إذا سرى في مهجة","وردت على شط الحياة حمامها",7,"م",3,0],["لَصُمَّ العِبادُ فَلَم يَسمَعوا","وَكُفَّ العِبادُ فَلَم يُبصِروا",8,"ر",3,0],["لصغيرٍ أَعارَ رُزْءَ كَبيرٍ","وفَريدٍ أَذاقَ فَقْدَ جَمِيعِ",9,"ع",1,0],["لِصاحِبَيَّ وَقَد زالَ النَهارُ بِنا","هَل تُؤنِسانِ بِبَطنِ الجَوِّ مِن ظُعُنِ",10,"ن",1,0],["لَصِدقِ قَولِكَ لَو حَبَّ اِمرُؤٌ حَجَراً","لَكانَ في الحَشرِ عَن مَثواهُ لَم يَرِمِ",11,"م",1,0],["لَصَيَّرتُ البَياضَ لَها سِجِلّاً","وَصَيَّرتُ السَوادَ لَها سَوادا",12,"د",2,0],["لِصاحِبِ التاجِ وَالقَصرِ المَشيدِ وَمَن","أَتى بِعَدلٍ بِرَحبِ الأَرضِ مَنشورِ",13,"ر",1,0],["لَصيقُ فُؤادي مُذ ثَلاثونَ حِجَّةً","وَصَيقَلُ ذِهني وَالمُرَوِّحُ عَن هَمّي",14,"م",2,0],["لِصَبٍّ زادَهُ حُبّاً وَوَجداً","بِكُم سُعدى مَلامَةُ مَن يَلومُ",15,"م",1,0],["لَصَبا وَأَلقى عَنهُ بُرنُسَهُ","وَسَعى وَأَهوَنُ سَعيِهِ رَمَلُه",16,"ل",2,0],["لِصَفراءَ في قَلبي مِنَ الحُبِّ شُعبَةٌ","هَوىً لَم تَرُمهُ الغانِياتُ صَميمُ",17,"م",1,1],["لصوصٌ ما يُبالونَ الدنَايا","إذا عَقَدوا العزائمَ لاِنْطِلاَقِ",18,"ق",1,0],["لِصَيدِها وَهيَ شِدادُ البَطشِ","فَقامَ نَحوَها بِوَجهٍ بَشِّ",19,"ش",1,0],["لَصَحنُ المَسجِدِ المَعمو","رِ فَالرَهباتُ فَالسَنَدُ",20,"د",1,0],["لِصَريمَةٍ غَلَبَت مُواصَلَتي","وَمَوَدَّةٍ زادَت عَلى وَفري",21,"ي",1,0],["لِصُّ الكَرى مَلَكَ الرَدى في زَعمِهِم","إِنَّ الحَياةَ مِنَ الأَنامِ لِتُسرَقُ",22,"ق",1,0],["لصوصٌ أطاعوا أبا مرةٍ","بترك الركوع وترك السجود",23,"د",1,0],["لصيَّرتُهُ مُثلَةً في الحياةِ","وسُخريةَ البعثِ في الآخرهْ",24,"ه",1,0],["لِصٌّ تَوَهَّمَ مَغْنَماً","وَإِذَا العُقُوبَةُ مَا غَنِمْ",25,"م",1,0],["لصٌّ تصرَّفَ فيما ليس يملكهُ","ما كان للصِّ أن يَمْتَنَّ أو يهبا",26,"ب",2,0],["لصٌّ تسلَّلَ من وراءِ جدارِ","مُتنقِّلاً من شُرفةٍ لِجِدارِ",27,"ر",1,1]]}