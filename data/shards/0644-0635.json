{"poems":[[93,"ما بين لصوص ولصوص","https://www.aldiwan.net/poem11192.html","المتدارك"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"إما تريني قالبا مجني","https://www.aldiwan.net/poem66392.html","الرجز"],[91,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[56,"ليس يخشى جيش الحوادث من جن","https://www.aldiwan.net/poem58558.html","الطويل"],[2,"كم للمنازل من عام ومن زمن","https://www.aldiwan.net/poem25005.html","البسيط"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"فأفرط في ترادفه وزادا","https://www.aldiwan.net/poem38682.html","الوافر"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[44,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[31,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[31,"يا نعم قد طالت مماطلتي","https://www.aldiwan.net/poem41843.html","الكامل"],[33,"لصفراء في قلبي من الحب شعبة","https://www.aldiwan.net/poem25819.html","الطويل"],[105,"أما ومضارب البيض الرقاق","https://www.aldiwan.net/poem43994.html","الوافر"],[52,"قم صاحبي نغدو لجيش الوحش","https://www.aldiwan.net/poem26891.html","الرجز"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140830",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[106,"شرع الاستعمار","https://www.poetsgate.com/ViewPoem.aspx?id=179645",""],[100,"السفر إلى الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50347",""],[121,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[132,"لصوتك في كل القلوب دبيب","https://www.aldiwan.net/poem54885.html","الطويل"],[135,"وهل في عالم الإنسان أحلى","https://www.aldiwan.net/poem48991.html","الوافر"],[143,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[143,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[155,"وذي غنج مر بي مسرعا","https://www.aldiwan.net/poem55530.html","المتقارب"],[160,"لصومك شهر الصوم يكسى من الفجر","https://www.aldiwan.net/poem59111.html","الطويل"],[169,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[189,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[197,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[211,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[231,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[256,"عمرك الله يا ابن عمرو","https://www.aldiwan.net/poem48441.html","مخلع البسيط"],[270,"لصلاح قومي أعشق التأليفا","https://www.aldiwan.net/poem34985.html","الكامل"],[270,"لصوتك في قلبي دوي ورنات","https://www.aldiwan.net/poem35254.html","الطويل"],[270,"سعاد أعيدي لي كلاما مرخما","https://www.aldiwan.net/poem35443.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[275,"مهلا أمامة كم تطول نواك","https://www.aldiwan.net/poem25545.html","الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"لا هم دمعي من طول البكا نفدا","https://www.aldiwan.net/poem36823.html","عموديه"],[303,"بالرحبة انهد ركبي","https://www.aldiwan.net/poem57764.html","المجتث"],[303,"كأنما خاله من فوق مبسمه","https://www.aldiwan.net/poem57950.html","البسيط"],[304,"يا بهجة الحسن هل أراك","https://www.aldiwan.net/poem16810.html","مخلع البسيط"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[305,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[320,"لصاحب هذا القبر نسأل ربنا","https://www.aldiwan.net/poem61611.html","الكامل"],[353,"حبائل البر في استعطاف ذي الهيف","https://www.aldiwan.net/poem40031.html","البسيط"],[364,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[364,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[364,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[365,"ونحن هزمنا جيش صعدة بالقنا","https://www.aldiwan.net/poem44504.html","الطويل"],[371,"وأقول إني لو ظفرت","https://www.aldiwan.net/poem57331.html","مجزوء الكامل"],[400,"هو الحب الكبير","https://www.aldiwan.net/poem10294.html","عموديه"],[403,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[461,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[468,"قد كان عيشي ربيعا","https://www.aldiwan.net/poem59845.html","المجتث"],[482,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[500,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[504,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[506,"لصنائع المعروف فلتة غافل","https://www.aldiwan.net/poem2402.html","الكامل"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[558,"لمن طلل بين الأجارع بالي","https://www.aldiwan.net/poem33537.html","الطويل"],[567,"لصديق لنا صديقة سوء","https://www.aldiwan.net/poem69465.html","الخفيف"],[575,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"]],"verses":[["لِصِغَارِهِمُ المَوْتُ المُزْرِي","وَكِبَارِهِمُ الشَّرَفُ الأَسْنَى",0,"ن",2,0],["لصَريرهَا رَجْعٌ تَسَامَعُهُ النُّهَى","وَلَهُ رَنِينَ مَثَالِثٍ وَمَثَانِ",1,"ن",1,0],["لِصِغَارِ الْهُمُومِ تُقْتَلُ فِي أَنْ","فُسِ أَهْلِ النُّهَى كِبَارُ الْهُمُومِ",2,"م",1,0],["لَصائِدِها في الصَيدِ حَقٌّ وَطُعمَةٌ","وَيَخشى العَذابَ أَن يُعَرِّدَ ناكِلا",3,"ل",2,0],["لصفحتُ عن دهري به وذنوبُهُ","قد أوبقته أشدَّ ما إيباق",4,"ق",1,0],["لصاحب السوء بُعيدَ ضنِّي","به ومَنِّي صافياً مِنْ مَنِّي",5,"ن",2,0],["لِصاحِبٍ أَنا تَيّاهٌ بِصُحبَتِهِ","وَشاعِرٍ طالَما تاهَت بِهِ العَرَبُ",6,"ب",1,0],["لص الشباب إذا سرى في مهجة","وردت على شط الحياة حمامها",7,"م",3,0],["لَصُمَّ العِبادُ فَلَم يَسمَعوا","وَكُفَّ العِبادُ فَلَم يُبصِروا",8,"ر",3,0],["لصغيرٍ أَعارَ رُزْءَ كَبيرٍ","وفَريدٍ أَذاقَ فَقْدَ جَمِيعِ",9,"ع",1,0],["لِصاحِبَيَّ وَقَد زالَ النَهارُ بِنا","هَل تُؤنِسانِ بِبَطنِ الجَوِّ مِن ظُعُنِ",10,"ن",1,0],["لَصِدقِ قَولِكَ لَو حَبَّ اِمرُؤٌ حَجَراً","لَكانَ في الحَشرِ عَن مَثواهُ لَم يَرِمِ",11,"م",1,0],["لَصَيَّرتُ البَياضَ لَها سِجِلّاً","وَصَيَّرتُ السَوادَ لَها سَوادا",12,"د",2,0],["لِصاحِبِ التاجِ وَالقَصرِ المَشيدِ وَمَن","أَتى بِعَدلٍ بِرَحبِ الأَرضِ مَنشورِ",13,"ر",1,0],["لَصيقُ فُؤادي مُذ ثَلاثونَ حِجَّةً","وَصَيقَلُ ذِهني وَالمُرَوِّحُ عَن هَمّي",14,"م",2,0],["لِصَبٍّ زادَهُ حُبّاً وَوَجداً","بِكُم سُعدى مَلامَةُ مَن يَلومُ",15,"م",1,0],["لَصَبا وَأَلقى عَنهُ بُرنُسَهُ","وَسَعى وَأَهوَنُ سَعيِهِ رَمَلُه",16,"ل",2,0],["لِصَفراءَ في قَلبي مِنَ الحُبِّ شُعبَةٌ","هَوىً لَم تَرُمهُ الغانِياتُ صَميمُ",17,"م",1,1],["لصوصٌ ما يُبالونَ الدنَايا","إذا عَقَدوا العزائمَ لاِنْطِلاَقِ",18,"ق",1,0],["لِصَيدِها وَهيَ شِدادُ البَطشِ","فَقامَ نَحوَها بِوَجهٍ بَشِّ",19,"ش",1,0],["لَصَحنُ المَسجِدِ المَعمو","رِ فَالرَهباتُ فَالسَنَدُ",20,"د",1,0],["لِصَريمَةٍ غَلَبَت مُواصَلَتي","وَمَوَدَّةٍ زادَت عَلى وَفري",21,"ي",1,0],["لِصُّ الكَرى مَلَكَ الرَدى في زَعمِهِم","إِنَّ الحَياةَ مِنَ الأَنامِ لِتُسرَقُ",22,"ق",1,0],["لصوصٌ أطاعوا أبا مرةٍ","بترك الركوع وترك السجود",23,"د",1,0],["لصيَّرتُهُ مُثلَةً في الحياةِ","وسُخريةَ البعثِ في الآخرهْ",24,"ه",1,0],["لِصٌّ تَوَهَّمَ مَغْنَماً","وَإِذَا العُقُوبَةُ مَا غَنِمْ",25,"م",1,0],["لصٌّ تصرَّفَ فيما ليس يملكهُ","ما كان للصِّ أن يَمْتَنَّ أو يهبا",26,"ب",2,0],["لصٌّ تسلَّلَ من وراءِ جدارِ","مُتنقِّلاً من شُرفةٍ لِجِدارِ",27,"ر",1,1],["لصنعا التي تردي جميع ملوكها","وتهوى وتستجدي ملوك سواها",28,"ا",3,0],["لصنعا التي تأتي وتغرب فجأة","لتأتي ويجتاز الغروب ضحاها",28,"ا",3,0],["لصاحبه صرم الأمور ولم تكن","لتملأ منه الصدر حلواً وعلقما",29,"م",2,0],["لِصَوتِكَ في كل القلوبِ دَبِيبُ","لأنَّكَ مِن كُلِّ القلوبِ قريبُ",30,"ب",1,1],["لصاحبه على الأرواحِ بطش","فإما بالخلالِ أو الدلالِ",31,"ل",1,0],["لِصَرفِ اللَيالي أَن يَصولَ وَنَخضَعا","وَحَتمٌ عَلَينا أَن يَقولَ وَنَسمَعا",32,"ع",2,1],["لَصَدَدتَ عَمّا رُمتُهُ","صَدَّ الذَليلِ عَنِ الحَليلَه",33,"ل",2,0],["لِصُدْغَيْهِ ظِلٌّ عَلَى وَجْنَتَيْهِ","كَظِلِّ غُصُونٍ تَثَنَّيْنَ لِينا",34,"ن",2,0],["لصومك شهر الصوم يكسى من الفجر","ملابس لم تخلع على ليلة القدر",35,"ر",1,1],["لِصَمصامِهِ هامُ العِدى وَلِرُمحِهِ","كُلاها وَلِلبَوغا دَمٌ وَعِظامُ",36,"م",1,0],["لصحبهِ من العذابِ أَمنه","الآمنُ المأمونُ كلٌّ أمِنَه",37,"ه",1,0],["لصَقوا المثالِبَ بي وكُلَّ","مثالبي عدمُ اتّجاري",38,"ي",1,0],["لصحراء يوم البؤس أعددت حبهم","وقد يظمأ النبع الأصيل فيورق",39,"ق",1,0],["لصابر الثبت الشهيد قتيل أهل","البغي في الإلجام والإسراج",40,"ج",1,0],["لصوف شعر استها مدادٌ","يعجنه بولها بحبر",41,"ر",1,0],["لصلاحِ قومي أعشقُ التأليفا","ويزيدُني حبِّي لهم تكليفا",42,"ف",2,1],["لِصَوتِكِ في قلبي دَويٌّ ورنّاتُ","كما ردَّدَت صوتَ البلابلِ جنّاتُ",43,"ت",1,1],["لِصَوتكِ رنّاتٌ كأوتار مُطربِ","شَجانا فأبكانا عَشيَّةَ نَغّما",44,"م",2,0],["لِصوقعةِ الجلّى صواعِقٌ جَلّلت","لها الفلك الأعلى دَجا وتقوَّرا",45,"ر",2,0],["لَصَبا فُؤادُك لي ورَقَّ فَمَا قَسَا","وَسَخَتْ بِمَاء شُؤونِها عَيْناكِ",46,"ك",1,0],["لصحبةِ الأَميرِ","السيِّد الخَطيرِ",47,"ر",1,0],["لصوتِها في حفافِ العرشِ هينمةٌ","هل تسمعون؟ ففي أُذنيَّ منه صدى",48,"د",2,0],["لصيفها حز حر","وللشتا برد برد",49,"د",1,0],["لص أتى وظلام الليل معتكرٌ","ليسرق الدر من صندوق مرجان",50,"ن",1,0],["لصار مثلي حليف وجد","كريح حب علي فناك",51,"ك",1,0],["لصانع حسن السيف يعزى فرنده","كما أن نفذا الحكم يعزى لسطان",52,"ن",1,0],["لِصادقِ رَعيهِ القصرُ السعيدُ","حِمىً لشبابِ دَولته مُعيدُ",53,"د",1,1],["لِصاحِبِ هَذا القَبرِ نَسأَل رَبَّنا","تَتابَعَ إِحسانٌ وَإِسباغٌ أَفضالِ",54,"ل",1,1],["لصرّة أَشتري وَصل الحَبيب بِها","أَحبّ مَن بَيع روحي مِنهُ عَن شَغَفي",55,"ف",2,0],["لصَوْنكَ مبذولاً من الوجهِ طالما","بذلْتَ من الأموالْ كُلَّ مَصون",56,"ن",1,0],["لصاحبٍ رأْيُه العالي ورايتُه","مُضَمَّنانِ سِجالَ الرِّزْقِ والأَجَل",57,"ل",1,0],["لصَبْرِه يُكابِرُ اتِّقادُه","حَشْوَ الحشَا بعد الحسانِ الخُرَّد",58,"د",1,0],["لَصاحَت تُنادي الهامُ منهم بأرضنا","صياحَ النَّدامى حول بيت تِجَارِ",59,"ر",1,0],["لصناعةٍ باتَت تُكَل","لِفُني البكورَ إلى الصِّناعَه",60,"ع",2,0],["لصيَّرْتُ الحروف كؤوس حُبٍّ","يطوف بها على العشَّاق ساقِ",61,"ق",1,0],["لصحا ووافى آخذاً","عني من العلم اللدني",62,"ي",1,0],["لصافحتُ من أمواجها كفَّ غادرٍ","سواء عليها الغَمزُ في الرَّخْصِ والشَّثْنِ",63,"ن",1,0],["لصُحفها منها إذا ما انتُضيَت","ما بجفون البيض من نصالها",64,"ل",3,0],["لصيَّر أبياتَها سُبحةً","ومثَّلَ قِرطاسَها مَسجِدا",65,"د",2,0],["لِصيامِها ولِفِطْرِها","ولخَوْفِها ورَجائها",66,"ا",3,0],["لِصاحِبٍ بِهرَجانٌ","أَخلاقُهُ وَزُيوفُ",67,"ف",1,0],["لصدعي مني غدا في الكون منتشرا","فالنصل فرقني والسهم في قبج",68,"ج",1,0],["لصَعِقْنا وطَرَقْنا","قُبَّةَ الأُفقِ اضْطِرَامَا",69,"م",2,0],["لصحة تأخير الكرام عن الردى","على صادق في الصبح قدم كاذب",70,"ب",1,0],["لصنائع المعروف فلتة غافل","إن لم تضعها في محل قابل",71,"ل",1,1],["لصِنوان مَسموم السِّهامِ ولحظُها","ومَبْسِمُها والجوهَرُ الفردُ توأمُ",72,"م",1,0],["لصيق الغواني كيف يألف بالسوى","وقد بات منها في لذيذ وصال",73,"ل",1,0],["لِصَدِيْقٍ لَنَا صَدِيْقَةُ سُوءٍ","رَحِمَ اللَّهُ مَنْ لَحَاهُ عَلَيْهَا",74,"ي",3,1],["لصيرتَ قلبي من حُلَى الصبرِ عارياً","وصيرتَ خدِّي من حُلَى الدَّمعِ كَاسِيَا",75,"ي",2,0]]}