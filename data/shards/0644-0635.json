53&r=&rc=109",""],[6247,"حروف مهاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80264&r=&rc=3",""]],"verses":[["لِصِغَارِهِمُ المَوْتُ المُزْرِي","وَكِبَارِهِمُ الشَّرَفُ الأَسْنَى",0,"ن",2,0],["لصَريرهَا رَجْعٌ تَسَامَعُهُ النُّهَى","وَلَهُ رَنِينَ مَثَالِثٍ وَمَثَانِ",1,"ن",1,0],["لِصِغَارِ الْهُمُومِ تُقْتَلُ فِي أَنْ","فُسِ أَهْلِ النُّهَى كِبَارُ الْهُمُومِ",2,"م",1,0],["لَصائِدِها في الصَيدِ حَقٌّ وَطُعمَةٌ","وَيَخشى العَذابَ أَن يُعَرِّدَ ناكِلا",3,"ل",2,0],["لصفحتُ عن دهري به وذنوبُهُ","قد أوبقته أشدَّ ما إيباق",4,"ق",1,0],["لصاحب السوء بُعيدَ ضنِّي","به ومَنِّي صافياً مِنْ مَنِّي",5,"ن",2,0],["لِصاحِبٍ أَنا تَيّاهٌ بِصُحبَتِهِ","وَشاعِرٍ طالَما تاهَت بِهِ العَرَبُ",6,"ب",1,0],["لص الشباب إذا سرى في مهجة","وردت على شط الحياة حمامها",7,"م",3,0],["لَصُمَّ العِبادُ فَلَم يَسمَعوا","وَكُفَّ العِبادُ فَلَم يُبصِروا",8,"ر",3,0],["لصغيرٍ أَعارَ رُزْءَ كَبيرٍ","وفَريدٍ أَذاقَ فَقْدَ جَمِيعِ",9,"ع",1,0],["لِصاحِبَيَّ وَقَد زالَ النَهارُ بِنا","هَل تُؤنِسانِ بِبَطنِ الجَوِّ مِن ظُعُنِ",10,"ن",1,0],["لَصِدقِ قَولِكَ لَو حَبَّ اِمرُؤٌ حَجَراً","لَكانَ في الحَشرِ عَن مَثواهُ لَم يَرِمِ",11,"م",1,0],["لَصَيَّرتُ البَياضَ لَها سِجِلّاً","وَصَيَّرتُ السَوادَ لَها سَوادا",12,"د",2,0],["لِصاحِبِ التاجِ وَالقَصرِ المَشيدِ وَمَن","أَتى بِعَدلٍ بِرَحبِ الأَرضِ مَنشورِ",13,"ر",1,0],["لَصيقُ فُؤادي مُذ ثَلاثونَ حِجَّةً","وَصَيقَلُ ذِهني وَالمُرَوِّحُ عَن هَمّي",14,"م",2,0],["لِصَبٍّ زادَهُ حُبّاً وَوَجداً","بِكُم سُعدى مَلامَةُ مَن يَلومُ",15,"م",1,0],["لَصَبا وَأَلقى عَنهُ بُرنُسَهُ","وَسَعى وَأَهوَنُ سَعيِهِ رَمَلُه",16,"ل",2,0],["لِصَفراءَ في قَلبي مِنَ الحُبِّ شُعبَةٌ","هَوىً لَم تَرُمهُ الغانِياتُ صَميمُ",17,"م",1,1],["لصوصٌ ما يُبالونَ الدنَايا","إذا عَقَدوا العزائمَ لاِنْطِلاَقِ",18,"ق",1,0],["لِصَيدِها وَهيَ شِدادُ البَطشِ","فَقامَ نَحوَها بِوَجهٍ بَشِّ",19,"ش",1,0],["لَصَحنُ المَسجِدِ المَعمو","رِ فَالرَهباتُ فَالسَنَدُ",20,"د",1,0],["لِصَريمَةٍ غَلَبَت مُواصَلَتي","وَمَوَدَّةٍ زادَت عَلى وَفري",21,"ر",2,0],["لِصُّ الكَرى مَلَكَ الرَدى في زَعمِهِم","إِنَّ الحَياةَ مِنَ الأَنامِ لِتُسرَقُ",22,"ق",1,0],["لِصَحْبِي والقِلاَصُ العِيسُ تَثْنِي","أَزِمَّتَهَا سَوَالِفُ كَالجُذُوعِ",23,"ع",1,0],["لصوصٌ أطاعوا أبا مرةٍ","بترك الركوع وترك السجود",24,"د",1,0],["لصيَّرتُهُ مُثلَةً في الحياةِ","وسُخريةَ البعثِ في الآخرهْ",25,"ه",1,0],["لِصٌّ تَوَهَّمَ مَغْنَماً","وَإِذَا العُقُوبَةُ مَا غَنِمْ",26,"م",1,0],["لصٌّ تصرَّفَ فيما ليس يملكهُ","ما كان للصِّ أن يَمْتَنَّ أو يهبا",27,"ب",2,0],["لصٌّ تسلَّلَ من وراءِ جدارِ","مُتنقِّلاً من شُرفةٍ لِجِدارِ",28,"ر",1,1],["لصنعا التي تردي جميع ملوكها","وتهوى وتستجدي ملوك سواها",29,"ا",3,0],["لصنعا التي تأتي وتغرب فجأة","لتأتي ويجتاز الغروب ضحاها",29,"ا",3,0],["لصاحبه صرم الأمور ولم تكن","لتملأ منه الصدر حلواً وعلقما",30,"م",2,0],["لِصَوتِكَ في كل القلوبِ دَبِيبُ","لأنَّكَ مِن كُلِّ القلوبِ قريبُ",31,"ب",1,1],["لصاحبه على الأرواحِ بطش","فإما بالخلالِ أو الدلالِ",32,"ل",1,0],["لِصَرفِ اللَيالي أَن يَصولَ وَنَخضَعا","وَحَتمٌ عَلَينا أَن يَقولَ وَنَسمَعا",33,"ع",2,1],["لَصَدَدتَ عَمّا رُمتُهُ","صَدَّ الذَليلِ عَنِ الحَليلَه",34,"ل",2,0],["لِصُدْغَيْهِ ظِلٌّ عَلَى وَجْنَتَيْهِ","كَظِلِّ غُصُونٍ تَثَنَّيْنَ لِينا",35,"ن",2,0],["لصومك شهر الصوم يكسى من الفجر","ملابس لم تخلع على ليلة القدر",36,"ر",1,1],["لِصَمصامِهِ هامُ العِدى وَلِرُمحِهِ","كُلاها وَلِلبَوغا دَمٌ وَعِظامُ",37,"م",1,0],["لصحبهِ من العذابِ أَمنه","الآمنُ المأمونُ كلٌّ أمِنَه",38,"ه",1,0],["لصَقوا المثالِبَ بي وكُلَّ","مثالبي عدمُ اتّجاري",39,"ر",2,0],["لصحراء يوم البؤس أعددت حبهم","وقد يظمأ النبع الأصيل فيورق",40,"ق",1,0],["لصابر الثبت الشهيد قتيل أهل","البغي في الإلجام والإسراج",41,"ج",1,0],["لصوف شعر استها مدادٌ","يعجنه بولها بحبر",42,"ر",1,0],["لصلاحِ قومي أعشقُ التأليفا","ويزيدُني حبِّي لهم تكليفا",43,"ف",2,1],["لِصَوتِكِ في قلبي دَويٌّ ورنّاتُ","كما ردَّدَت صوتَ البلابلِ جنّاتُ",44,"ت",1,1],["لِصَوتكِ رنّاتٌ كأوتار مُطربِ","شَجانا فأبكانا عَشيَّةَ نَغّما",45,"م",2,0],["لِصوقعةِ الجلّى صواعِقٌ جَلّلت","لها الفلك الأعلى دَجا وتقوَّرا",46,"ر",2,0],["لَصَبا فُؤادُك لي ورَقَّ فَمَا قَسَا","وَسَخَتْ بِمَاء شُؤونِها عَيْناكِ",47,"ك",1,0],["لصحبةِ الأَميرِ","السيِّد الخَطيرِ",48,"ر",1,0],["لصوتِها في حفافِ العرشِ هينمةٌ","هل تسمعون؟ ففي أُذنيَّ منه صدى",49,"د",2,0],["لصيفها حز حر","وللشتا برد برد",50,"د",1,0],["لص أتى وظلام الليل معتكرٌ","ليسرق الدر من صندوق مرجان",51,"ن",1,0],["لصار مثلي حليف وجد","كريح حب علي فناك",52,"ك",1,0],["لصانع حسن السيف يعزى فرنده","كما أن نفذا الحكم يعزى لسطان",53,"ن",1,0],["لِصادقِ رَعيهِ القصرُ السعيدُ","حِمىً لشبابِ دَولته مُعيدُ",54,"د",1,1],["لِصاحِبِ هَذا القَبرِ نَسأَل رَبَّنا","تَتابَعَ إِحسانٌ وَإِسباغٌ أَفضالِ",55,"ل",1,1],["لصرّة أَشتري وَصل الحَبيب بِها","أَحبّ مَن بَيع روحي مِنهُ عَن شَغَفي",56,"ف",2,0],["لصَوْنكَ مبذولاً من الوجهِ طالما","بذلْتَ من الأموالْ كُلَّ مَصون",57,"ن",1,0],["لصاحبٍ رأْيُه العالي ورايتُه","مُضَمَّنانِ سِجالَ الرِّزْقِ والأَجَل",58,"ل",1,0],["لصَبْرِه يُكابِرُ اتِّقادُه","حَشْوَ الحشَا بعد الحسانِ الخُرَّد",59,"د",1,0],["لَصاحَت تُنادي الهامُ منهم بأرضنا","صياحَ النَّدامى حول بيت تِجَارِ",60,"ر",1,0],["لصناعةٍ باتَت تُكَل","لِفُني البكورَ إلى الصِّناعَه",61,"ع",2,0],["لصيَّرْتُ الحروف كؤوس حُبٍّ","يطوف بها على العشَّاق ساقِ",62,"ق",1,0],["لصحا ووافى آخذاً","عني من العلم اللدني",63,"ن",2,0],["لصافحتُ من أمواجها كفَّ غادرٍ","سواء عليها الغَمزُ في الرَّخْصِ والشَّثْنِ",64,"ن",1,0],["لصُحفها منها إذا ما انتُضيَت","ما بجفون البيض من نصالها",65,"ل",3,0],["لصيَّر أبياتَها سُبحةً","ومثَّلَ قِرطاسَها مَسجِدا",66,"د",2,0],["لِصيامِها ولِفِطْرِها","ولخَوْفِها ورَجائها",67,"ا",3,0],["لِصاحِبٍ بِهرَجانٌ","أَخلاقُهُ وَزُيوفُ",68,"ف",1,0],["لصدعي مني غدا في الكون منتشرا","فالنصل فرقني والسهم في قبج",69,"ج",1,0],["لصَعِقْنا وطَرَقْنا","قُبَّةَ الأُفقِ اضْطِرَامَا",70,"م",2,0],["لصحة تأخير الكرام عن الردى","على صادق في الصبح قدم كاذب",71,"ب",1,0],["لصنائع المعروف فلتة غافل","إن لم تضعها في محل قابل",72,"ل",1,1],["لصِنوان مَسموم السِّهامِ ولحظُها","ومَبْسِمُها والجوهَرُ الفردُ توأمُ",73,"م",1,0],["لصيق الغواني كيف يألف بالسوى","وقد بات منها في لذيذ وصال",74,"ل",1,0],["لِصَدِيْقٍ لَنَا صَدِيْقَةُ سُوءٍ","رَحِمَ اللَّهُ مَنْ لَحَاهُ عَلَيْهَا",75,"ي",3,1],["