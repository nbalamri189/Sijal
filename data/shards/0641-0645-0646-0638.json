{"poems":[[90,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"أصاح هي الدنيا تشابه ميتة","https://www.aldiwan.net/poem22277.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/141830","الطويل"],[164,"خذوا لي من سمر القدود أمانا","https://www.aldiwan.net/poem58947.html","الطويل"],[202,"أيا برق نافح ذكر ظبي مهفهف","https://www.aldiwan.net/poem51865.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[382,"حواسك يا بتولة مرتضيه","https://www.aldiwan.net/poem59163.html","الوافر"],[385,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[520,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117103","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87832","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130802",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65948","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65962","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112500","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65438","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132707","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111523","الوافر"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139394",""],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44688","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141098","المنسرح"],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4978,"تشطير لقصيدة نادية الكيلاني","https://www.poetsgate.com/ViewPoem.aspx?id=177236",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5595,"لَقيتُها ، وكأنَّ الدّمْعَ يُؤنِسُها","https://www.poetsgate.com/ViewPoem.aspx?id=177969",""]],"verses":[["فمنظر الحزن مشهود بمنظرها","والبؤس مرآه مقرون بمرآها",0,"ا",3,0],["فمَنْ ظنَّ أنَّ الناسَ يرْعَوْنَ دونَهُ","نفوسهُمُ فلْيَعْتَبِر بالبهائمِ",1,"م",1,0],["فمِنْ ظُباكَ إلى عَليا قَناكَ إلى","نارِ الجحيم فما يخلو من النُّقَل",2,"ل",1,0],["فَمَن ظَلَّ مِنها آكِلاً فَهوَ خاسِرٌ","وَمَن عادَ عَنها ساغِباً فَهوَ رابِحُ",3,"ح",1,0],["فمن ظنه كرماً فليس بكاذب","ومن ظنه نخلاً فليس يُجَهّل",4,"ل",1,0],["فمن ظفرت منهم يداه بصلحه","يذق جفنه طعم الرقاد أمانا",5,"ن",2,0],["فمنظرُهُ والثغرُ منه وعَرْفُهُ","وقامتُهُ والردفُ منه وخدَّاهر",6,"ا",3,0],["فمن ظن شيئاً غير هذا فإنه","لتقصيره عن فكرة مستقيمة",7,"ه",1,0],["فمنظرك الرفيع لنحو مولىً","أتى منك الخلاص إلى البريه",8,"ي",2,0],["فَمِن ظاهر تَرويهِ عَنهُ أَفاضل","وَمِن باطن تَختارُهُ أَهل عرفان",9,"ن",1,0],["فمن ظبيٍ غريرٍ فِي عقالٍ","ومن ليثٍ هصورٍ فِي خِطامِ",10,"م",1,0],["فمن ظن أن المدح قام بحقكم","فذاك غبي في الرجال غبين",11,"ن",1,0],["فمنظر كمخبر","طريفة في الطرف",12,"ف",1,0],["فَمن ظَبيٍ شَآمِيٍّ غَريرٍ","أَهيمُ بِهِ إِلى ظَبيٍ كِناني",13,"ي",1,0],["فمن ظامىء قد جفَّ في السير ريقه","وماؤك عذبٌ سلسبيل تَسَلَّسُ(8)",14,"س",1,0],["فمن ظن انا مثل اؤلاء من مضوا","بعار التواني خاب في مثلنا ظنا",15,"ن",2,0],["فمنظرها عجب ومسمعها شفا","ومأخذها سهل ومنطقها شهد",16,"د",1,0],["فمن ظن أني مهمل أو مقيد","بروض الهوينا همتي فهو ناعس",17,"س",1,0],["فمن ظاعن يمضي وتبقى مناقبه","ومن قاطن يبقى وتبقى مثالبه",18,"ب",2,0],["فمنظرهم أضحوكة كلباسهم","ومخبرهم في الحادثات رهيب",19,"ب",1,0],["فمن ظنّ مثلا لهُ لم يكن","يميزُ الخبيث من الطّيب",20,"ب",1,0],["فمن ظمآن لم ينقع غليلا","واخر غص بالماء الزلال",21,"ل",1,0],["فمن ظهرٍ الى بطنٍ وفخذٍ","صفائحُ تُرمضُ الاعضاءِ حرَّا",22,"ر",2,0],["فمن ظالعات ومن غائراتٍ","وآخرَ في حيرةٍ قد رقد",23,"د",1,0],["فَمَنظرُ البيد وَالأَغنامُ سارحةٌ","مَعَ الأَباعرِ في أَبهى مَراعيها",24,"ي",3,0],["فمن ظهور الرّكاب معملة","إلى بطون الرّبى إلى الفلك",25,"ك",1,0],["فمن ظلمة النفس عنه انجلت","ففيه لأنوارهم أبرج",26,"ج",1,0],["(فمن ظمإ كما وجْدٍ )","سَرَى كَالنَّهْرِ يَرْوِينِي",27,"ن",2,0],["فمن ظن أن الهجر ليس بسنة","وليس بمشروع فقد زل واختبل",28,"ل",1,0],["فمن ظن أن الحق فيما يقوله","طواغيتهم لا في الذي جاءت الرسل",28,"ل",1,0],["فمن ظنَّ المنى في هجرِ دارٍ","فما في الهجرِ اشفاقٌ ورفْقُ",29,"ق",1,0],["فمَنْظرُ الفَقر ِ بَادٍ في ملامحِها","لِيطبعَ اليأسَ أوْتَاراً لممْشاها",30,"ا",3,0]]}