{"poems":[[57,"فوز ماذا عليك أن تؤنسيني","https://www.aldiwan.net/poem26432.html","الخفيف"],[93,"جعت والخبز وفير في وطابي","https://www.aldiwan.net/poem8748.html","عموديه"],[72,"إن أمري لعجيب","https://www.aldiwan.net/poem42454.html","مجزوء الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[234,"أسرب مها عن أم سرب جنه","https://www.aldiwan.net/poem50754.html","المتقارب"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[385,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[409,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[415,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[422,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[458,"أرجال لا ولا شبه رجال","https://www.aldiwan.net/poem61613.html","الرمل"],[482,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109383","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76071","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130777","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68008","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205920","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4733,"نشيدُ البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=192765",""],[5057,"غاري","https://www.poetsgate.com/ViewPoem.aspx?id=184760",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5277,"ليلُ البنفسج","https://www.poetsgate.com/ViewPoem.aspx?id=206770",""],[5341,"أقرب لتلويحة قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185352",""],[5431,"رياض الفنون","https://www.poetsgate.com/ViewPoem.aspx?id=205321",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5525,"البتول","https://www.poetsgate.com/ViewPoem.aspx?id=878",""],[5667,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=214890",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""]],"verses":[["كُلُّ أَرضٍ حَلَلتِ فيها فَما يَح","تاجُ سُكّانُها إِلى مِصباحِ",0,"ح",1,0],["كُلُّ أَرضٍ نامَ عَنها أَهلُها","فَهيَ أَرضٌ لِاِغتِصابٍ وَاِنتِهابِ",1,"ب",1,0],["كُلُّ أَرضٍ لِيَ فيها","غائِبٌ أَسأَلُ عَنهُ",2,"ن",2,0],["كُلُّ أَرضٍ حَلَّ فيها أَو حِمى","مَنزِلُ البَدرِ وَغابُ البَيهَسِ",3,"س",1,0],["كُلُّ أُرْجُوحَةٍ تَرَى الْقَوْمَ فِيهَا","خُشَّعَاً بَيْنَ رُكَّعٍ وَقِيَامِ",4,"م",1,0],["كِلا رَاعِيَيها أَطلَسُ اللَونِ ثَوبُهُ","عَنودَانِ مِن كِنانةٍ قَد تَسَرَّرا",5,"ر",2,0],["كِلا راحَتْيك ندىً أو ردىً","كأنّك للناسِ نارٌ وجَنّه",6,"ن",2,0],["كُلٌّ أراد خُروجَه من لُبْسِه","لمّا رأى بالسّعْدِ منه دُخولا",7,"ل",2,0],["كُلُ أَرض نَزَلوها صَيروا","تَريها مِسكاً وَكافوراً حَصاها",8,"ا",3,0],["كل أرض جئتها تلفظني","فكأني في فم الدنيا درن",9,"ن",1,0],["كلُّ أَرضٍ فيها من الأُسْدِ جيشٌ","سائرٌ فوقَه من السُّمْرِ غِيلُ",10,"ل",1,0],["كلّ أرضٍ تحلُّها كانَ أهلو","ها بما ترتجيه مستبشرينا",11,"ن",2,0],["كل أرضٍ أنتبت لي منبراً","هي أرضي وهي شمسٌ وظلال",12,"ل",1,0],["كلاّ رجعتُ عنِ الغَوايةِ والهَوَى","أَنِفاً لقد جذبَ العفافُ زمانيا",13,"ي",2,0],["كل أرباب النهى والبلغا","في بها أوصافه منذهلاتْ",14,"ت",1,0],["كل أرض إن ظللتها سماء","فهي قد ظلل السماء ثراها",15,"ا",3,0],["كل أرض شرفتها ذاته","عيشها يغدو الرغيد الأطيبا",16,"ب",2,0],["كُلُّ أَركانِها يَمانِيُّ يُمنٍ","فَبِكُلٍّ مِنها يَكونُ اِستلامُ",17,"م",1,0],["كل أرض بنار حرب تداعت","وهي أرض السلام غوراً ونجدا",18,"د",2,0],["كل أرض من البهاء تعرت","وهي روض الجمال تشرق سعدا",18,"د",2,0],["كلُّ أرضٍ بالقلب سوف تُنَسَّى","غيرَ قلبٍ إذَا رأى كشميرا",19,"ر",2,0],["كل أرض للمصلِّي مسجد","غير أن الكعبة الكبرى مقام",20,"م",1,0],["كلّا رمت وصف بعض علاه","قال لي قائل البلاغة كلا",21,"ل",2,0],["كل أرض حل فيها حرم","آمن فيه صفا المعتمر",22,"ر",1,0],["كل أرضٍ يحلُّ فيها ربيعٌ","وهي للخائفينَ دارُ الأمان",23,"ن",1,0],["كل ارضٍ لها نبات لذا يخ","تلف النبت باختلاف المواضع",24,"ع",1,0],["كلُّ أرضٍ مَدارُنا يَحتويها","سَتلبِّي في مَحفلِ الأسوارِ",25,"ر",1,0],["كلّ أرضٍ بها السعادةُ أرضي","كلّ دارٍ بها ارتياحيَ داري",26,"ر",2,0],["كلّ أرض لا تفتح الكتب كتاباً","دفنوا قبل موتهم في التّراب",27,"ب",1,0],["كلُّ ارتيابي فيكِ محْضُ تَعِلَّةٍ","انا هكذا دانٍ ولستُ بِناءِ",28,"ا",1,0],["كلّ أرض نْمرّها غربة جديدة","والسّلام اقْرب لتلويحة فراق",29,"ق",1,0],["كلّ أرضٍ إذا استقرّت حرورا","صار فيها تصحرٌ وشقوقُ",30,"ق",1,0],["كلّ ارهاصات نفسي","كلّ طيشٍ قد شردْ",31,"د",1,0],["كل أرضٍ تشيلك يا ثقيل الحمول","وكل وقتٍ كريمٍ بالرضا والزعل",32,"ل",1,1],["كُلُّ ارتعاشاتِنا في الحبِّ نَنظمُها","بينَ البساتينِ أشعاراً فَتنتَظِمُ",33,"م",1,0],["كل أرض على الخريطة أرضي","من أجاج ومن فرات الماء",34,"ا",2,0]]}