{"poems":[[102,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[9,"أتشفيك تيا أم تركت بدائكا","https://www.aldiwan.net/poem21961.html","الطويل"],[88,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[37,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[95,"آنست بكم ولكن تم أنسي","https://www.aldiwan.net/poem11257.html","الوافر"],[29,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[29,"شتمتما قائلا بالحق مهتديا","https://www.aldiwan.net/poem5979.html","البسيط"],[29,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[74,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[53,"إذا ضحكتم ضحكنا في مفارحكم","https://www.aldiwan.net/poem65465.html","البسيط"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[31,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[72,"حبيبي عينه قالوا تشكت","https://www.aldiwan.net/poem42767.html","الوافر"],[87,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[30,"يطرد عنها الجائزين كأنه","https://www.aldiwan.net/poem5159.html","الطويل"],[30,"رأيت جريرا لم يضع عن حماره","https://www.aldiwan.net/poem5424.html","الطويل"],[68,"أتشمخ إن كساك الدهر ثوبا","https://www.aldiwan.net/poem38604.html","الوافر"],[68,"لا حب إلا للحبيب الأول","https://www.aldiwan.net/poem39651.html","الكامل"],[41,"أتشتم أزد القريتين وطيئا","https://www.aldiwan.net/poem53743.html","الطويل"],[50,"أتشتم خير ذي حكم ابن سعد","https://www.aldiwan.net/poem62611.html","الوافر"],[52,"ألا يا صنم الأززد","https://www.aldiwan.net/poem64851.html","الهزج"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[102,"إلى قارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50126",""],[30,"وبيض كأرآم الصريم ادريتها","https://www.poetsgate.com/ViewPoem.aspx?id=21955",""],[30,"رأيت جريرا لم يضع عن حماره","https://www.poetsgate.com/ViewPoem.aspx?id=21986",""],[41,"أَتَشْتُمُ أَزْدَ القَرْيَتَيْن وطَيِّئاً","https://www.poetsgate.com/ViewPoem.aspx?id=4272",""],[96,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[141,"أنا النذير لمسدي نعمة أبدا","https://www.aldiwan.net/poem67961.html","البسيط"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[211,"أتشحذ أرماحا بأيدي عدونا","https://www.aldiwan.net/poem27974.html","الطويل"],[240,"وقائل قال لي لما رآني في","https://www.aldiwan.net/poem32139.html","البسيط"],[308,"يقولون لما رنا وانثنى","https://www.aldiwan.net/poem58087.html","المتقارب"],[408,"حمامة الأيك مهلا","https://www.aldiwan.net/poem46704.html","المجتث"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[458,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[473,"يا موقظ العتب الذي هو راقد","https://www.aldiwan.net/poem60254.html","الكامل"],[484,"أتشقى أمة انتم بنوها الدراري","https://www.aldiwan.net/poem36966.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138226",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101527","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143266","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48788","الوافر"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205255","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138133",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138106",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79824","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216446",""],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21473","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100369","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101667","الكامل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26119","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145130","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138698",""],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131033",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77183","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122156","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72433","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4759,"شبه منك","https://www.poetsgate.com/ViewPoem.aspx?id=205139",""],[4797,"مدحك يابو خالد","https://www.poetsgate.com/ViewPoem.aspx?id=178139",""],[4830,"حُمرةُ الخدَّين","https://www.poetsgate.com/ViewPoem.aspx?id=213318",""],[4984,"أتشكو من الأحداث","https://www.poetsgate.com/ViewPoem.aspx?id=215858",""],[1043,"دبيبان","https://www.poetsgate.com/ViewPoem.aspx?id=92993",""],[5608,"عزي ومجدي","https://www.poetsgate.com/ViewPoem.aspx?id=32823",""],[5648,"الزمان الشين","https://www.poetsgate.com/ViewPoem.aspx?id=156245",""],[5660,"لَعَمرُكَ ما يُغني البُكى وَ التَوَجُّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=28435",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5781,"بين شوكه والألم....","https://www.poetsgate.com/ViewPoem.aspx?id=206644",""],[5910,"في هجاءِ شيخٍ كذوبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=206235",""],[5956,"بداية الصلوات لجلال الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=194045",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[6117,"مانعةُ الرَّخَاء","https://www.poetsgate.com/ViewPoem.aspx?id=182789",""],[5309,"يا ابن القساة اتعظ بالموت والنار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573793",""],[6225,"اعياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78099&r=&rc=156",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[5536,"سيف دولتنا عليا !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76355&r=&rc=33",""]],"verses":[["أتشتمّ أنفاسه","طيوف الربى الهجّع",0,"ع",1,0],["أَتَشفيكَ تَيّا أَم تُرِكتَ بِدائِكا","وَكانَت قَتولاً لِلرِجالِ كَذَلِكا",1,"ك",2,1],["أَتَشقى بِعَهدٍ سَما بِالعُلومِ","فَأَضحى الضَعيفُ بِها أَيِّدا",2,"د",2,0],["أَتَشخَصُ والشخص الَّذي أَنتَ عادِلُ","بِهِ الخُلدَ بِينَ العائِداتِ سَقيمُ",3,"م",1,0],["أَتَشْدُو أمُّ كَلْثومٍ وَتَبْقَى","أمَالِيدُ الجَنَانِ بِلاَ تَثَنِّي",4,"ن",2,0],["أَتَشْدُو أمُّ كُلْثومٍ وَفِينَا","طَرُوبٌ لا تيرَى كَصَريعِ دَنِّ",4,"ن",1,0],["أَتَشتُمُني وَما عَلِمَت تَميمٌ","لِتَيمٍ غَيرَ حِلفِهِمُ نِصابا",5,"ب",2,0],["أَتَشتُمانِ سِفاهاً خَيرَكُم حَسَباً","فَفيكُما وَإِلَهي الزَورُ وَالخَطَلُ",6,"ل",1,0],["أَتَشتُماهُ عَلى رَفعي وَوَضعِكُما","لا زِلتُما في سِفالٍ أَيُّها السَفَلُ",6,"ل",1,0],["أَتَشتِمُ يَربوعاً لِأَشتِمَ مالِكاً","وَغَيرُكَ مَولى مالِكٍ وَصَميمُها",7,"م",3,0],["أتشكَّى لك الزمان الذي تمل","ك إصلاحه لديَّ فهل لا",8,"ل",2,0],["أتشبعون ونطوي في جواركم","من عسرةٍ تَلَدُ الإخوان لا الطُرف",9,"ف",1,0],["أتُشحنُ روضةٌ عَرُضَت وطالتْ","بأشباهِ النعامِ أو الرّئالِ",10,"ل",1,0],["أَتَشتِمُ قَوماً أَثَّلوكَ بِدارِمٍ","وَلَولاهُمُ كُنتُم كَعُكلٍ مُوالِيا",11,"ي",2,0],["أَتَشكو عَينُهُ رَمداً وَفيها","يُقالُ أَصَحُّ مِن عَينِ الغَزالِ",12,"ل",1,0],["أتشغل قلبي الراح عن بعض ما به","وأشغال قلبي لو علمت كثير",13,"ر",1,0],["أَتَشرَبُ أَسلابَ اِمرأً كانَ وَجهُهُ","إِذا أَظلَمَت سيما اِمرِئِ السوءِ أَسفَرا",14,"ر",2,0],["أَتَشتُمُ قَوماً أَنتَ تَزعُمُ مِنهُمُ","عَلى مَطعَمٍ مِن مَطعَمٍ أَنتَ آكِلُه",15,"ل",2,0],["أَتَشمَخُ إِن كَساكَ الدَهرُ ثَوباً","شَرُفتَ بِهِ وَلَم تَكُ بِالشَريفِ",16,"ف",1,1],["أَتَشُكُّ في أَنَّ النَبِيَّ مُحَمَّداً","خَيرُ البَرِيَةِ وَهوَ آخِرُ مُرسَلِ",17,"ل",1,0],["أَتَشتُمُ أَزدَ القَريَتَينِ وَطَيِّئاً","لَقَد رُمتَ أَمراً كاَ غَيرَ مَرومِ",18,"م",1,1],["أَتَشتُمُ خَيرَ ذي حَكَمِ اِبنِ سَعدٍ","لَقَد لاقَيتَ داهِيَةً نَآدا",19,"د",2,1],["أَتَشفيني مِنَ الأَسقا","مِ أَم تورِدُني نَحبا",20,"ب",2,0],["أَتَشْتَاقُ الرُّبُوعَ فَكَيْفَ تُجْلَى","رُبَاهَا وَالمَدَارِجُ وَالحُقُولُ",21,"ل",1,0],["أَتَشْهَدُ هَذَا الجَّمْعَ مِنْ صَفْوَةِ الحِمَى","وَأَجْفَانُهُمْ تَهْمِي وَأَنْفَاسُهُمْ حَرَّى",22,"ر",2,0],["أتشتمّ يا قارئي في غناي","دخان المغنّي وشهق الرباب ؟",23,"ب",1,0],["أتَشرَبُ أسلابَ امرِىءٍ كانَ وَجْهُهُ","إذا أظلمتْ سِيما امرِىءِ السوء أسفرَا",24,"ر",2,0],["أتَشْتُمُ قَوْماً أنْتَ تَزْعُمُ مِنْهُمُ","عَل مَطْعَمٍ من مَطعَمٍ أنتَ آكِلُهْ",25,"ل",2,0],["أَتَشْتُمُ أَزْدَ القَرْيَتَيْن وطَيِّئاً","لقدْ رمتَ أمراً كانَ غيرَ مرومِ",26,"م",1,1],["أتشكو ولكن عندك الريح والدجى","وللجنّ من شتّى الظلال نجوم",27,"م",1,0],["أَتَشمَخونَ وَمِنّا أَصلُ نِعمَتُكُم","سَتَعلَمونَ إِذا صِرتُم لَنا خَوَلا",28,"ل",2,0],["أتشفع الخمسون لي عندَهم","هيهاتَ والعشرون لم تَشفعِ",29,"ع",1,0],["أتشغَلُني خَودٌ تكعّبَ ثديُها","عن الذِّروةِ الشَمَاءِ أُعلي بها كعبي",30,"ب",2,0],["أَتَشحَذُ أَرماحاً بِأَيدي عَدُوِّنا","وَتَترُكُ أَرماحاً بِهِنَّ نُكايِدُ",31,"د",1,1],["أَتَشتَري جُبَّةً تَلقى الشِتاءَ بِها","وَأَنتَ شاعِرُ مَولانا وَكاتِبُهُ",32,"ب",2,0],["أتشتاق من طرفه أبيضا","فقلت ومن قده أسمرا",33,"ر",2,0],["أَتشتكين بعاداً","وأنتِ ذَاتُ جَناحِ",34,"ح",1,0],["أتشافى في عيسى لا في عسى","يشتفي القلب ولا في ربَّما",35,"م",2,0],["اتشمخون بماضيكم وحاضركم","يكاد ينصر في ضعف له الزورا",36,"ر",2,0],["أتشكَّى القذَى بمقلةِ حيرا","نَ عليهم إلى ضلوعٍ حَرَّى",37,"ر",2,0],["أَتَشُكُّ في الذَهَبِ الَّذي هُوَ خالِصٌ","أَنّي وَأَنتَ الصَيرُفِيُّ الناقِدُ",38,"د",1,0],["أتشقى أمة انتم بنوها الدراري","في الليالي المدلهمّة",39,"م",2,1],["أتشبّهون به غنياً فاسداً","خلقاً وكيف يجود شيء طالح",40,"ح",1,0],["أَتشكُّ بعدئذٍ وأنت معلّمي","اني بَرَعتُ بهِ وقد اتقنتُهُ",41,"ت",2,0],["أتشكو أم كذلك؟ فالتصابي","قَبيحٌ بعدَ شيب العارضين",42,"ن",1,1],["أتشكو مصر ضائقة وفيها","نوالك وهو للنيلين ند",43,"د",1,0],["أتشوّق الغادين يوم سويقة","لو كان يدني النازحين تشوّق",44,"ق",1,0],["أتشكو من الدنيا فَلِم أنت عائش","أما في الردى منجى لمن بات شاكيا",45,"ي",2,0],["أتشكين من مرض زائل","قريب الشفاء يسير الدوا",46,"ا",1,0],["أتُشيمُ سيفَكَ عن جماجم معشرٍ","وتروكم بالذُحل في صفين",47,"ن",1,0],["أَتشرقُ الشمس ولا عينُها","بالنقع تعمى قبل أن تغربا",48,"ب",2,0],["أَتُشعِلُ الجِسمَ ناراً وَهيَ بارِدَةٌ","فَيا لمَقرورَةٍ أَورى مِنَ الشَرَرِ",49,"ر",1,0],["اتشكّلت فيه المنابيت","نَبْت الزريجا زين الآرياح",50,"ح",1,0],["أَتَشغَلُ عَنّا يا ابنَ عمِّ فَلا تَرى","مِنَ البُخلِ لاءً سَوفَ تَعتَلّ بِالشُّغلِ",51,"ل",1,0],["أتَشبعُ الوحشُ والأطيارُ طاوية","كواسرُ الطيرِ أولى بالفريساتِ",52,"ت",1,0],["اتشكاك بعض حرّ غليل","لم تسعه الحشا وكلي غليل",53,"ل",1,0],["أَتشكُّ في حبّي إِذن لا إنما","زدتِ الهوى حتى استحالَ هوانا",54,"ن",2,0],["أَتَشتُمُ أَقواماً أَجاروا نِساءَكُم","وَأَنتَ ابنَ يَربوعٍ عَلى الضَيمِ وارِكُ",55,"ك",1,1],["أتشنق مصر خير أبنائها حجى","وتقوى وأخلاقا فما أفضع القتلا",56,"ل",2,0],["اتشكو الظما لابيك الحسين","فهل منه تامل نيل المراد",57,"د",1,0],["أتشكاك من ضنا ونحول","خنت عهدي خفظاً لعهد عذول",58,"ل",1,0],["أتشتكي الوجد والزهر الثواقب لم","تبرح بأمرك في ما شئت تأتمر",59,"ر",1,0],["أتشثبي نجمة عقلي وفاتنتي","إذا بدت خجلت من نورها الزهر",59,"ر",1,0],["أَتَشكو لِلَّذي يَحتاجُ دَهراً","كَما تَحتاجُ في سعة وَفَقر",60,"ر",1,0],["أتشتكي فاقة والله عمدتنا","أم ترتجي العز من أجوافها الربض",61,"ض",1,0],["أتشتمني أن كنتُ أبكي بعبرةٍ","لقومٍ أتاني ودهم غيرَ كاذِب",62,"ب",1,0],["أتشكي لك من سيف جفاك","لا تبح يا مانع الريق دمي",63,"ي",1,0],["أتشتاق أم شاقتك ظعنٌ تقاذفت","بها فلوات بالمطيّ قواذف",64,"ف",1,0],["