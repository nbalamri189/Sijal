{"poems":[[100,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[9,"أتشفيك تيا أم تركت بدائكا","https://www.aldiwan.net/poem21961.html","الطويل"],[86,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[93,"آنست بكم ولكن تم أنسي","https://www.aldiwan.net/poem11257.html","الوافر"],[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[27,"شتمتما قائلا بالحق مهتديا","https://www.aldiwan.net/poem5979.html","البسيط"],[27,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"إذا ضحكتم ضحكنا في مفارحكم","https://www.aldiwan.net/poem65465.html","البسيط"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[29,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[70,"حبيبي عينه قالوا تشكت","https://www.aldiwan.net/poem42767.html","الوافر"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[28,"يطرد عنها الجائزين كأنه","https://www.aldiwan.net/poem5159.html","الطويل"],[28,"رأيت جريرا لم يضع عن حماره","https://www.aldiwan.net/poem5424.html","الطويل"],[66,"أتشمخ إن كساك الدهر ثوبا","https://www.aldiwan.net/poem38604.html","الوافر"],[66,"لا حب إلا للحبيب الأول","https://www.aldiwan.net/poem39651.html","الكامل"],[39,"أتشتم أزد القريتين وطيئا","https://www.aldiwan.net/poem53743.html","الطويل"],[48,"أتشتم خير ذي حكم ابن سعد","https://www.aldiwan.net/poem62611.html","الوافر"],[50,"ألا يا صنم الأززد","https://www.aldiwan.net/poem64851.html","الهزج"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[100,"إلى قارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50126",""],[28,"وبيض كأرآم الصريم ادريتها","https://www.poetsgate.com/ViewPoem.aspx?id=21955",""],[28,"رأيت جريرا لم يضع عن حماره","https://www.poetsgate.com/ViewPoem.aspx?id=21986",""],[39,"أَتَشْتُمُ أَزْدَ القَرْيَتَيْن وطَيِّئاً","https://www.poetsgate.com/ViewPoem.aspx?id=4272",""],[94,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[138,"أنا النذير لمسدي نعمة أبدا","https://www.aldiwan.net/poem67961.html","البسيط"],[143,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[167,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[208,"أتشحذ أرماحا بأيدي عدونا","https://www.aldiwan.net/poem27974.html","الطويل"],[236,"وقائل قال لي لما رآني في","https://www.aldiwan.net/poem32139.html","البسيط"],[304,"يقولون لما رنا وانثنى","https://www.aldiwan.net/poem58087.html","المتقارب"],[403,"حمامة الأيك مهلا","https://www.aldiwan.net/poem46704.html","المجتث"],[417,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[454,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[459,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[469,"يا موقظ العتب الذي هو راقد","https://www.aldiwan.net/poem60254.html","الكامل"],[480,"أتشقى أمة انتم بنوها الدراري","https://www.aldiwan.net/poem36966.html","الوافر"]],"verses":[["أتشتمّ أنفاسه","طيوف الربى الهجّع",0,"ع",1,0],["أَتَشفيكَ تَيّا أَم تُرِكتَ بِدائِكا","وَكانَت قَتولاً لِلرِجالِ كَذَلِكا",1,"ك",2,1],["أَتَشقى بِعَهدٍ سَما بِالعُلومِ","فَأَضحى الضَعيفُ بِها أَيِّدا",2,"د",2,0],["أَتَشخَصُ والشخص الَّذي أَنتَ عادِلُ","بِهِ الخُلدَ بِينَ العائِداتِ سَقيمُ",3,"م",1,0],["أَتَشْدُو أمُّ كَلْثومٍ وَتَبْقَى","أمَالِيدُ الجَنَانِ بِلاَ تَثَنِّي",4,"ن",2,0],["أَتَشْدُو أمُّ كُلْثومٍ وَفِينَا","طَرُوبٌ لا تيرَى كَصَريعِ دَنِّ",4,"ن",1,0],["أَتَشتُمُني وَما عَلِمَت تَميمٌ","لِتَيمٍ غَيرَ حِلفِهِمُ نِصابا",5,"ب",2,0],["أَتَشتُمانِ سِفاهاً خَيرَكُم حَسَباً","فَفيكُما وَإِلَهي الزَورُ وَالخَطَلُ",6,"ل",1,0],["أَتَشتُماهُ عَلى رَفعي وَوَضعِكُما","لا زِلتُما في سِفالٍ أَيُّها السَفَلُ",6,"ل",1,0],["أَتَشتِمُ يَربوعاً لِأَشتِمَ مالِكاً","وَغَيرُكَ مَولى مالِكٍ وَصَميمُها",7,"م",3,0],["أتشكَّى لك الزمان الذي تمل","ك إصلاحه لديَّ فهل لا",8,"ل",2,0],["أتشبعون ونطوي في جواركم","من عسرةٍ تَلَدُ الإخوان لا الطُرف",9,"ف",1,0],["أتُشحنُ روضةٌ عَرُضَت وطالتْ","بأشباهِ النعامِ أو الرّئالِ",10,"ل",1,0],["أَتَشتِمُ قَوماً أَثَّلوكَ بِدارِمٍ","وَلَولاهُمُ كُنتُم كَعُكلٍ مُوالِيا",11,"ي",2,0],["أَتَشكو عَينُهُ رَمداً وَفيها","يُقالُ أَصَحُّ مِن عَينِ الغَزالِ",12,"ل",1,0],["أتشغل قلبي الراح عن بعض ما به","وأشغال قلبي لو علمت كثير",13,"ر",1,0],["أَتَشرَبُ أَسلابَ اِمرأً كانَ وَجهُهُ","إِذا أَظلَمَت سيما اِمرِئِ السوءِ أَسفَرا",14,"ر",2,0],["أَتَشتُمُ قَوماً أَنتَ تَزعُمُ مِنهُمُ","عَلى مَطعَمٍ مِن مَطعَمٍ أَنتَ آكِلُه",15,"ل",2,0],["أَتَشمَخُ إِن كَساكَ الدَهرُ ثَوباً","شَرُفتَ بِهِ وَلَم تَكُ بِالشَريفِ",16,"ف",1,1],["أَتَشُكُّ في أَنَّ النَبِيَّ مُحَمَّداً","خَيرُ البَرِيَةِ وَهوَ آخِرُ مُرسَلِ",17,"ل",1,0],["أَتَشتُمُ أَزدَ القَريَتَينِ وَطَيِّئاً","لَقَد رُمتَ أَمراً كاَ غَيرَ مَرومِ",18,"م",1,1],["أَتَشتُمُ خَيرَ ذي حَكَمِ اِبنِ سَعدٍ","لَقَد لاقَيتَ داهِيَةً نَآدا",19,"د",2,1],["أَتَشفيني مِنَ الأَسقا","مِ أَم تورِدُني نَحبا",20,"ب",2,0],["أَتَشْتَاقُ الرُّبُوعَ فَكَيْفَ تُجْلَى","رُبَاهَا وَالمَدَارِجُ وَالحُقُولُ",21,"ل",1,0],["أَتَشْهَدُ هَذَا الجَّمْعَ مِنْ صَفْوَةِ الحِمَى","وَأَجْفَانُهُمْ تَهْمِي وَأَنْفَاسُهُمْ حَرَّى",22,"ر",2,0],["أتشتمّ يا قارئي في غناي","دخان المغنّي وشهق الرباب ؟",23,"ب",1,0],["أتَشرَبُ أسلابَ امرِىءٍ كانَ وَجْهُهُ","إذا أظلمتْ سِيما امرِىءِ السوء أسفرَا",24,"ر",2,0],["أتَشْتُمُ قَوْماً أنْتَ تَزْعُمُ مِنْهُمُ","عَل مَطْعَمٍ من مَطعَمٍ أنتَ آكِلُهْ",25,"ل",2,0],["أَتَشْتُمُ أَزْدَ القَرْيَتَيْن وطَيِّئاً","لقدْ رمتَ أمراً كانَ غيرَ مرومِ",26,"م",1,1],["أتشكو ولكن عندك الريح والدجى","وللجنّ من شتّى الظلال نجوم",27,"م",1,0],["أَتَشمَخونَ وَمِنّا أَصلُ نِعمَتُكُم","سَتَعلَمونَ إِذا صِرتُم لَنا خَوَلا",28,"ل",2,0],["أتشفع الخمسون لي عندَهم","هيهاتَ والعشرون لم تَشفعِ",29,"ع",1,0],["أتشغَلُني خَودٌ تكعّبَ ثديُها","عن الذِّروةِ الشَمَاءِ أُعلي بها كعبي",30,"ب",2,0],["أَتَشحَذُ أَرماحاً بِأَيدي عَدُوِّنا","وَتَترُكُ أَرماحاً بِهِنَّ نُكايِدُ",31,"د",1,1],["أَتَشتَري جُبَّةً تَلقى الشِتاءَ بِها","وَأَنتَ شاعِرُ مَولانا وَكاتِبُهُ",32,"ب",2,0],["أتشتاق من طرفه أبيضا","فقلت ومن قده أسمرا",33,"ر",2,0],["أَتشتكين بعاداً","وأنتِ ذَاتُ جَناحِ",34,"ح",1,0],["أتشافى في عيسى لا في عسى","يشتفي القلب ولا في ربَّما",35,"م",2,0],["اتشمخون بماضيكم وحاضركم","يكاد ينصر في ضعف له الزورا",36,"ر",2,0],["أتشكَّى القذَى بمقلةِ حيرا","نَ عليهم إلى ضلوعٍ حَرَّى",37,"ر",2,0],["أَتَشُكُّ في الذَهَبِ الَّذي هُوَ خالِصٌ","أَنّي وَأَنتَ الصَيرُفِيُّ الناقِدُ",38,"د",1,0],["أتشقى أمة انتم بنوها الدراري","في الليالي المدلهمّة",39,"م",2,1]]}