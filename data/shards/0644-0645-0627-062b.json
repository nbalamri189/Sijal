{"poems":[[53,"عيني لا تتهلل منكما الدرر","https://www.aldiwan.net/poem62856.html","البسيط"],[93,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"لما ثوت في الأرض وهي لطيفة","https://www.aldiwan.net/poem22234.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[53,"عينيَّ لا تتهللْ منكما الدِّرَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29049",""],[208,"ما تركت اللقاء يوم الفراق","https://www.aldiwan.net/poem53223.html","الخفيف"],[279,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[406,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"]],"verses":[["لما ثوى عافَ بطنُ الأرض جيفتَهُ","لكنّ حَوْباءهُ ارتاحتْ لها سقرُ",0,"ر",1,0],["لَمّا ثَوى في مَيسَلونَ تَرَنَّحَت","هَضَباتُها وَتَنَفَّسَت أَطيابا",1,"ب",2,0],["لم أثْقَفِ المرءَ يَعْصي مَن هداه ومَن","نجّاه من عثراتِ الدَّحْض والزَّلَل",2,"ل",1,0],["لَمّا ثَوَت في الأَرضِ وَهيَ لَطيفَةٌ","قُدَماؤُنا أَمِنَت مِنَ الأَحداثِ",3,"ث",1,1],["لَمَّا ثَغَا الثَّغْوَةَ الأُولَى فَأَسْمَعَهَا","ودُونَهُ شُقَّةٌ مِيلاَنِ أَوْ مِيلُ",4,"ل",1,0],["لِمَ آثرْتَ من اللَّونِ السوادا","لونُها كان على الشعْبِ حِدادا",5,"د",2,0],["لَما ثكِلْتَ فَتَاكَ مِصْرُ","جَمِيعُهَا ثَكِلَت فَتَاكْ",6,"ك",1,0],["لما ثوى عافَ بطنُ الأرض جيفتَهُ","لكنّ حَوْباءهُ ارتحاحتْ لها سقر",7,"ر",1,0],["لم أثق بالحياة بعدك إلا","ليقيني أنّي على الميثاقِ",8,"ق",1,0],["لَمَّا ثَوَى دَارَ السَّلامِ تَرَحَّلَتْ","عَنَّا مَحَاسِنُ دَهْرِنَا بِسَلامِ",9,"م",1,0],["لم أثنِ عزمي أو يعودُ بي الهدى","لاَ أَمْتَ فيه أوْ أموت فَأُعذرا",10,"ر",2,0]]}