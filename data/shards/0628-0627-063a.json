{"poems":[[93,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[30,"ألا حي المنازل بالسلام","https://www.aldiwan.net/poem29530.html","الوافر"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[72,"تنهدت لما أذكرتني النواهد","https://www.aldiwan.net/poem18571.html","الطويل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[29,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[61,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[48,"يا رب ظبي بمكان خال","https://www.aldiwan.net/poem65082.html","الرجز"],[143,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[143,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[143,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[143,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[198,"طرقت على علل الكرى أسماء","https://www.aldiwan.net/poem51991.html","الكامل"],[235,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[235,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[280,"يا دهر قد عديت عنك طلابي","https://www.aldiwan.net/poem60597.html","الكامل"],[280,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[280,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[282,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[282,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[351,"قد أغتدي والليل مركوم الظلم","https://www.aldiwan.net/poem68967.html","الرجز"],[364,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[364,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[406,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[416,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[427,"وفد البيان","https://www.aldiwan.net/poem42145.html","عموديه"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[439,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[461,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[461,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[461,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[461,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[461,"هنيئا لأيام المناسك والتي","https://www.aldiwan.net/poem16025.html","الطويل"],[461,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[461,"نازلت همي وهو فارس بهمة","https://www.aldiwan.net/poem16262.html","الكامل"],[461,"باغي الصلاح تقال عثرته","https://www.aldiwan.net/poem16345.html","أحذ الكامل"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[551,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"]],"verses":[["بَاغَتَهُ اليَأْسُ وَأَيُّ امْرِيءٍ","يَقْدِرُ فِي حَالٍ عَلَى رَدِّهِ",0,"د",2,0],["بِأَغبَرَ مَهزولِ الأَفاعي مَجَنَّةٍ","سَخاوِيَّةٍ مَنسوجَةٍ بِقَتامِ",1,"م",1,0],["بِأَغبرَ نازِحٍ نَسَجَت عَلَيهِ","رِياحُ الصَيفِ شُبّاكَ القَتامِ",2,"م",1,0],["بِأَغبَرَ خَفّاقٍ كَأَنَّ قَتامَهُ","دُخانَ الغَضا يَعلو فُروجَ المَخارِمِ",3,"م",1,0],["بِأَغبَرَ وَهّاجِ السَمومِ تَرى بِهِ","دُفوفَ المَهارى وَالذَفارى تَنَتَّحُ",4,"ح",1,0],["بأغزال شعري في بديع صفاتها","ومدح رئيس الشام تسري القصائد",5,"د",1,0],["بأغرَّ أبلجَ لم تزل أيامُهُ","مشغولةً بالكَيس لا بالكاس",6,"س",1,0],["بِأَغَرَّ ما وَلَدَ النِساءُ شَبيهُهُ","أَحَداً عَلِقنَ بِهِ عَلى الأَطهارِ",7,"ر",1,0],["باغاريد عن محا","كاتها يعجز الوتر",8,"ر",1,0],["باغته في اللقاء بهتُ","إذ شاهد المنظر الكئيبا",9,"ب",2,0],["بأغرَّ يمنَحُني السَّبيكَ المُقتَني","كرَماً وأمنحُه الحَبيكَ المُعلَما",10,"م",2,0],["بِأَغَرَّ أَدهَمَ ذي حُجولٍ أَربَعٍ","مُبيَضُّها يَزهو عَلى مُسوَدِّهِ",11,"د",2,0],["بِأَغَرَّ لَيسَ بِتَوأَمٍ وَيَمينُهُ","تَغدو وَتَطرُقُ بِالنَوالِ التَوأَمِ",12,"م",1,0],["بِأَغَرَّ وَضّاحِ الجَبينِ كَأَنَّهُ","تَحتَ الدُجُنَّةِ كَوكَبٌ وَقّادُ",13,"د",1,0],["بِأَغَنَّ كَالحَولاءَ زانَ جِنانَهُ","نَورُ الدَكادِكِ سوقُهُ تَتَخَضَّدُ",14,"د",1,0],["بِأَغبَسَ إِيّاكَ مِنهُ إِذا","بَدا ثَبجُ أَعطافِهِ الناتِحَه",15,"ح",2,0],["بِأَغضَفٍ غُذّي بِحُسنِ حالِ","مُسَوَّدُ العَمِّ حَسيبُ الخالِ",16,"ل",1,0],["بِأَغَرَّ يَثني الحادِثاتِ فَتَنثَني","رَهَباً وَيَقتادُ الجِبالَ فَتُصحِبُ",17,"ب",1,0],["بِأَغَرَّ ما أَمَّ المَناقِبَ تابِعاً","فيها وَلا أَخَذَ العُلى تَقَليدا",18,"د",2,0],["باغي نَظيرِكَ فائِزٌ بِمُرادِهِ","لَكِن إِذا اِلتَقَتِ الثُرَيّا وَالثَرى",19,"ر",2,0],["باغي النُجومِ مُبَيَّنٌ عَن عَجزِهِ","وَمُصارِعُ اللَيثِ الغَضَنفَرِ يُصرَعُ",20,"ع",1,0],["بأغرَّ ذي كرمٍ نَمَتْه من بني","عبدِ العزيزِ عصابةٌ كُرَماءُ",21,"ا",2,0],["بِأَغلَبَ مَسبوحِ الذِراعَينِ باسِلٍ","يُزَلزِلُ أَقدامَ العِدى أَيَّ زَلزالِ",22,"ل",1,0],["بِأَغزَرَ مِن كَفِّ الخَليفَةِ نائِلاً","وَرِفداً إِذا اِغتَصَّت مَغانيهِ بِالوَفدِ",23,"د",1,0],["بِإَغَرَّ تُسْكِرُ صَحْبَهُ أَخْلاقُهُ","وَالْخَمْرُ جائِرَةٌ عَلَى الأَلْبابِ",24,"ب",1,0],["بِأَغَرَّ يَجْلُوا لِلْوُفُودِ جَبِينُهُ","شَمْساً تَكُونُ لَها الْمَعالِي مَشْرِقا",25,"ق",2,0],["بِأَغْزَرَ مِنْ عَيْنَيَّ يَوْمَ تَمَثّلَتْ","عَلَى الظَّنِّ أَعْلامَ الْحِمى وَعَلى الرَّجْمِ",26,"م",1,0],["بِأَغزَرَ مِن يُمناهُ تَنهَلُّ بِالنَدى","فَلَيسَ بِأَرضٍ حَلَّها الدَهر إِمحالُ",27,"ل",1,0],["بِأَغزَر مِن كَفِّهِ إِن أَبَت","عُيونُ الغَمامِ عَلى الأَرضِ دَفَقا",28,"ق",2,0],["بأغضفٍ معلمٍ أو قد علم","كأن شقَّ الشدق من فيه القضم",29,"م",1,0],["بأغرَّ يغدو حِلْيةً لزمانِه","وجُدودُه كانوا حُلَى الأزمان",30,"ن",1,0],["باغٍ على البَغْيِ أصَر","أعلَن ذاكَ أو أسَر",31,"ر",1,0],["بِأَغَرَّ يَحسِدُهُ أَفاضِل عَصرِهِ","قدر الفَضيلة مِثلَ قدر حُسودِها",32,"د",3,0],["بأغرَّ أبيضَ تنجلي بجبينه","ظلمات سجف ستائر لدياجر",33,"ر",1,0],["بأغرٍّ أبلج من هاشم","أبلَجَ المحتد فرعاً ونجارا",34,"ر",2,0],["باغ يظن قواه توهن عزمكم","ساءت مآربه وساء توهما",35,"م",2,0],["باغٍ أصابَ بِبَغْيهِ وبنكثِهِ","نَفساً عليها يَتَّقي ويُحَامِي",36,"ي",1,0],["بأَغَرَّ من بيتِ النُّبوَّةِ والهُدى","كالبدرِ من وَلَدِ النَّبيِّ مُحَمَّدِ",37,"د",1,0],["باغيك بنقيصةٍ","قتيلُ داءِ الطمعِ",38,"ع",1,0],["بأغزرَ من يمناهُ جوداً إذا همى","على معتفيه رفدها ونوالها",39,"ل",3,0],["بأغلب من بأس الوزير أبي الرضا","إذِ الذِّمْرُ نِكس والمقحِّم خائم",40,"م",1,0],["بأغَرَّ بَسَّامٍ كأنَّ بَنانَه","في كلِّ مكْرُمةٍ قطارُ سَحابِ",41,"ب",1,0],["بأغَرَّ وضَّاحِ الجبينِ مُمَجَّدٍ","يخشى اِشارتَه الخميسُ الجحْفل",42,"ل",1,0],["بأغلبَ من آل المُظفَّرِ شَأنهُ","بناءُ المعالي واغْتنامُ الصَّنائعِ",43,"ع",1,0],["بأغْلب يُلْقي الجودَ في كل فاقةٍ","كما يضع الهنديَّ في كل مقْتَلِ",44,"ل",1,0],["بأغَرَّ كَرَّارٍ إذا اشْتَجر القَنا","سارٍ إلى كَسْبِ العُلى مِدْلاجِ",45,"ج",1,0],["باغي الصَّلاح تُقالُ عَثْرَتُهُ","وسِواهُ لا يُعْفى منَ الزَّلَلِ",46,"ل",1,1],["بأغزرَ مِن دمعي عُقَيْبَ نواهمُ","وقد زُرْتُ للغادينَ ربعاً ومَعْلمَا",47,"م",2,0],["بأغلالٍ من العُرفِ","إذا سِيل وأقيادِ",48,"د",1,0]]}