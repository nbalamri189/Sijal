{"poems":[[95,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[32,"ألا حي المنازل بالسلام","https://www.aldiwan.net/poem29530.html","الوافر"],[29,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[29,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[74,"تنهدت لما أذكرتني النواهد","https://www.aldiwan.net/poem18571.html","الطويل"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[31,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[46,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[50,"يا رب ظبي بمكان خال","https://www.aldiwan.net/poem65082.html","الرجز"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[202,"طرقت على علل الكرى أسماء","https://www.aldiwan.net/poem51991.html","الكامل"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[285,"يا دهر قد عديت عنك طلابي","https://www.aldiwan.net/poem60597.html","الكامل"],[285,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[285,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[287,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[287,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[356,"قد أغتدي والليل مركوم الظلم","https://www.aldiwan.net/poem68967.html","الرجز"],[369,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[422,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[433,"وفد البيان","https://www.aldiwan.net/poem42145.html","عموديه"],[445,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[466,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[466,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[466,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[466,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[466,"هنيئا لأيام المناسك والتي","https://www.aldiwan.net/poem16025.html","الطويل"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[466,"نازلت همي وهو فارس بهمة","https://www.aldiwan.net/poem16262.html","الكامل"],[466,"باغي الصلاح تقال عثرته","https://www.aldiwan.net/poem16345.html","أحذ الكامل"],[482,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122799","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88604","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64027","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64026","الكامل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115105","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61114","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79960","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79848","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20448","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53089","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53183","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204632","الكامل"],[3201,"","https://poetry.dctabudhabi.ae/diwan/poem/200119","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87500","الهزج"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89051","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53025","المتدارك"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110140","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86490","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86443","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86391","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130548","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83523","الخفيف"],[4755,"رِيحُ ذِكْرَاكِ في دَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=183646",""],[4789,"الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=215288",""],[4578,"حدائق أزهار الربيع بأفنان","https://www.poetsgate.com/ViewPoem.aspx?id=49537",""],[4869,"حليب امك بفمك","https://www.poetsgate.com/ViewPoem.aspx?id=151661",""],[5155,"الى معجزة الغناء العربي (ام كلثوم)","https://www.poetsgate.com/ViewPoem.aspx?id=176242",""],[5431,"وكأنّ في العينين حانته...","https://www.poetsgate.com/ViewPoem.aspx?id=199679",""],[482,"لكم مِن فؤادي شاهدٌ ليس يكذبُ","https://www.poetsgate.com/ViewPoem.aspx?id=111424",""],[5848,"شموخ المملكه","https://www.poetsgate.com/ViewPoem.aspx?id=53331",""],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""]],"verses":[["بَاغَتَهُ اليَأْسُ وَأَيُّ امْرِيءٍ","يَقْدِرُ فِي حَالٍ عَلَى رَدِّهِ",0,"د",2,0],["بِأَغبَرَ مَهزولِ الأَفاعي مَجَنَّةٍ","سَخاوِيَّةٍ مَنسوجَةٍ بِقَتامِ",1,"م",1,0],["بِأَغبرَ نازِحٍ نَسَجَت عَلَيهِ","رِياحُ الصَيفِ شُبّاكَ القَتامِ",2,"م",1,0],["بِأَغبَرَ خَفّاقٍ كَأَنَّ قَتامَهُ","دُخانَ الغَضا يَعلو فُروجَ المَخارِمِ",3,"م",1,0],["بِأَغبَرَ وَهّاجِ السَمومِ تَرى بِهِ","دُفوفَ المَهارى وَالذَفارى تَنَتَّحُ",4,"ح",1,0],["بأغزال شعري في بديع صفاتها","ومدح رئيس الشام تسري القصائد",5,"د",1,0],["بأغرَّ أبلجَ لم تزل أيامُهُ","مشغولةً بالكَيس لا بالكاس",6,"س",1,0],["بِأَغَرَّ ما وَلَدَ النِساءُ شَبيهُهُ","أَحَداً عَلِقنَ بِهِ عَلى الأَطهارِ",7,"ر",1,0],["باغاريد عن محا","كاتها يعجز الوتر",8,"ر",1,0],["باغته في اللقاء بهتُ","إذ شاهد المنظر الكئيبا",9,"ب",2,0],["بأغرَّ يمنَحُني السَّبيكَ المُقتَني","كرَماً وأمنحُه الحَبيكَ المُعلَما",10,"م",2,0],["بِأَغَرَّ أَدهَمَ ذي حُجولٍ أَربَعٍ","مُبيَضُّها يَزهو عَلى مُسوَدِّهِ",11,"د",2,0],["بِأَغَرَّ لَيسَ بِتَوأَمٍ وَيَمينُهُ","تَغدو وَتَطرُقُ بِالنَوالِ التَوأَمِ",12,"م",1,0],["بِأَغَرَّ وَضّاحِ الجَبينِ كَأَنَّهُ","تَحتَ الدُجُنَّةِ كَوكَبٌ وَقّادُ",13,"د",1,0],["بِأَغَنَّ كَالحَولاءَ زانَ جِنانَهُ","نَورُ الدَكادِكِ سوقُهُ تَتَخَضَّدُ",14,"د",1,0],["بِأَغبَسَ إِيّاكَ مِنهُ إِذا","بَدا ثَبجُ أَعطافِهِ الناتِحَه",15,"ح",2,0],["بِأَغضَفٍ غُذّي بِحُسنِ حالِ","مُسَوَّدُ العَمِّ حَسيبُ الخالِ",16,"ل",1,0],["بِأَغَرَّ يَثني الحادِثاتِ فَتَنثَني","رَهَباً وَيَقتادُ الجِبالَ فَتُصحِبُ",17,"ب",1,0],["بِأَغَرَّ ما أَمَّ المَناقِبَ تابِعاً","فيها وَلا أَخَذَ العُلى تَقَليدا",18,"د",2,0],["باغي نَظيرِكَ فائِزٌ بِمُرادِهِ","لَكِن إِذا اِلتَقَتِ الثُرَيّا وَالثَرى",19,"ر",2,0],["باغي النُجومِ مُبَيَّنٌ عَن عَجزِهِ","وَمُصارِعُ اللَيثِ الغَضَنفَرِ يُصرَعُ",20,"ع",1,0],["بأغرَّ ذي كرمٍ نَمَتْه من بني","عبدِ العزيزِ عصابةٌ كُرَماءُ",21,"ا",2,0],["بِأَغلَبَ مَسبوحِ الذِراعَينِ باسِلٍ","يُزَلزِلُ أَقدامَ العِدى أَيَّ زَلزالِ",22,"ل",1,0],["بِأَغزَرَ مِن كَفِّ الخَليفَةِ نائِلاً","وَرِفداً إِذا اِغتَصَّت مَغانيهِ بِالوَفدِ",23,"د",1,0],["بِإَغَرَّ تُسْكِرُ صَحْبَهُ أَخْلاقُهُ","وَالْخَمْرُ جائِرَةٌ عَلَى الأَلْبابِ",24,"ب",1,0],["بِأَغَرَّ يَجْلُوا لِلْوُفُودِ جَبِينُهُ","شَمْساً تَكُونُ لَها الْمَعالِي مَشْرِقا",25,"ق",2,0],["بِأَغْزَرَ مِنْ عَيْنَيَّ يَوْمَ تَمَثّلَتْ","عَلَى الظَّنِّ أَعْلامَ الْحِمى وَعَلى الرَّجْمِ",26,"م",1,0],["بِأَغزَرَ مِن يُمناهُ تَنهَلُّ بِالنَدى","فَلَيسَ بِأَرضٍ حَلَّها الدَهر إِمحالُ",27,"ل",1,0],["بِأَغزَر مِن كَفِّهِ إِن أَبَت","عُيونُ الغَمامِ عَلى الأَرضِ دَفَقا",28,"ق",2,0],["بأغضفٍ معلمٍ أو قد علم","كأن شقَّ الشدق من فيه القضم",29,"م",1,0],["بأغرَّ يغدو حِلْيةً لزمانِه","وجُدودُه كانوا حُلَى الأزمان",30,"ن",1,0],["باغٍ على البَغْيِ أصَر","أعلَن ذاكَ أو أسَر",31,"ر",1,0],["بِأَغَرَّ يَحسِدُهُ أَفاضِل عَصرِهِ","قدر الفَضيلة مِثلَ قدر حُسودِها",32,"د",3,0],["بأغرَّ أبيضَ تنجلي بجبينه","ظلمات سجف ستائر لدياجر",33,"ر",1,0],["بأغرٍّ أبلج من هاشم","أبلَجَ المحتد فرعاً ونجارا",34,"ر",2,0],["باغ يظن قواه توهن عزمكم","ساءت مآربه وساء توهما",35,"م",2,0],["باغٍ أصابَ بِبَغْيهِ وبنكثِهِ","نَفساً عليها يَتَّقي ويُحَامِي",36,"م",2,0],["بأَغَرَّ من بيتِ النُّبوَّةِ والهُدى","كالبدرِ من وَلَدِ النَّبيِّ مُحَمَّدِ",37,"د",1,0],["باغيك بنقيصةٍ","قتيلُ داءِ الطمعِ",38,"ع",1,0],["بأغزرَ من يمناهُ جوداً إذا همى","على معتفيه رفدها ونوالها",39,"ل",3,0],["بأغلب من بأس الوزير أبي الرضا","إذِ الذِّمْرُ نِكس والمقحِّم خائم",40,"م",1,0],["بأغَرَّ بَسَّامٍ كأنَّ بَنانَه","في كلِّ مكْرُمةٍ قطارُ سَحابِ",41,"ب",1,0],["بأغَرَّ وضَّاحِ الجبينِ مُمَجَّدٍ","يخشى اِشارتَه الخميسُ الجحْفل",42,"ل",1,0],["بأغلبَ من آل المُظفَّرِ شَأنهُ","بناءُ المعالي واغْتنامُ الصَّنائعِ",43,"ع",1,0],["بأغْلب يُلْقي الجودَ في كل فاقةٍ","كما يضع الهنديَّ في كل مقْتَلِ",44,"ل",1,0],["بأغَرَّ كَرَّارٍ إذا اشْتَجر القَنا","سارٍ إلى كَسْبِ العُلى مِدْلاجِ",45,"ج",1,0],["باغي الصَّلاح تُقالُ عَثْرَتُهُ","وسِواهُ لا يُعْفى منَ الزَّلَلِ",46,"ل",1,1],["بأغزرَ مِن دمعي عُقَيْبَ نواهمُ","وقد زُرْتُ للغادينَ ربعاً ومَعْلمَا",47,"م",2,0],["بأغلالٍ من العُرفِ","إذا سِيل وأقيادِ",48,"د",1,0],["بِأَغَرَّ قُوبِلَ مِن نَبيِّ مُرسَلٍ","في العالَمينَ ومن إمامٍ قائِمِ",49,"م",1,0],["بِأَغَرَّ أغلَبَ هاشِمي قائِمٍ","في اللهِ بِالمَفرُوضِ والمَسنُونِ",50,"ن",1,0],["بِأَغَرَّ تَلقَى مِنهُ أَلفَي عَنتَرٍ","بَأساً وَيَنسِلُ مِنهُ أَلفَي حاتِم",51,"م",1,0],["بأغزر دمعاً منهم يوم فارقوا","ذرى حرم بابن النبي يشرف",52,"ف",1,0],["باغر من آل النبي يضمه","بيت باطراف الاباء مسردق",53,"ق",1,0],["باغٌ من النَّور كل واحدةٍ","فيه من النور وَحدَها باغ",54,"غ",1,0],["بأغرٍّ ما انصابَتْ لأزْلٍ كفُّهُ","إلا استحال الأزْلُ فيها أهْيَغا",55,"غ",2,0],["بأغيد عمهوجٍ ترى بَينَ","الاتحمي المنمنم",56,"م",1,0],["بِأَغر كالغصن الرَّطيب قوامه","وَأَغن كَالظَّبي الغَرير الأَغيَد",57,"د",1,0],["بأغرَّ يغلب وجهه شمس الضحى","بضيائه حتَّى تموت خمودا",58,"د",2,0],["بأغرَّ يُنميه إلى عمرو العُلى","حَسَبٌ محمَّده عليُّ معدّه",59,"د",2,0],["باغتتكم والنفس تمرح سكى","بين غناءِ روضةٍ وأغاني",60,"ن",2,0],["باغتتكم مصداقَ قولٍ حكيم","جاءَ ح