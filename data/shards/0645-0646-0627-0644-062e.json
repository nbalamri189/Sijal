لتْ غادةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182335",""],[5956,"شهقتُ وقد جاءت إليّ رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=193803",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["مِنَ الخَفِراتِ قَد نَعِمَت بِزَوجٍ","سَما بِجَلالِهِ أَدَبٌ وَدينُ",0,"ن",1,0],["مِنَ الخَفِراتِ البيضِ لَم تَرَ شَقوَةً","وَفي الحَسَبِ المَحضِ الرَفيعِ نِجارُها",1,"ر",3,0],["مِنَ الخَفراتِ البيضِ وَدَّ جَليسُها","إِذا ما اِنقَضَت أُحدوثَةٌ لَو تُعيدُها",2,"د",3,0],["من الخزرجين الَّذين نمتهُمُ","عشائر من قحطانها وفصائلُ",3,"ل",1,0],["من الخِلقِ التي تُركت قديماً","ومن طُرُزِ العمالقة اللبيس",4,"س",1,0],["مِنَ الخَفِراتِ البيضِ أُخلِصُ لَونُها","تُلاحي عَدُوّاً لَم يَجِد ما يَعيبُها",5,"ب",3,1],["مِنَ الخَميسِ إِلى الخَمي","سِ إِلى الخَميسِ إِلى الخَميسِ",6,"س",1,0],["مِن آلِ خاقانَ الَّذينَ صَغيرُهُم","في سَرجِهِ وَكَأَنَّهُ في مَهدِهِ",7,"د",2,0],["مِنَ الْخَمْرِ الَّتِي دَرَجَتْ عَلَيْهَا","أَفَانِينٌ مِنَ الْعُصُرِ الْفَوَانِي",8,"ن",2,0],["مِنَ الخَفِراتِ البيضِ لَم تَدرِ ما الخَنا","وَلَم تُلفَ يَوماً بَعدَ هَجعَتِها تَسري",9,"ر",2,0],["مِن الخيرِ فاسْتَكْثِرْ لنفسِكَ واسْتَزِدْ","وما تَسْتَطعْ من صالحِ الأمرِ فادَّخِرْ",10,"ر",1,0],["مِنَ الخَوفِ لا ذو سأمَةٍ بِعِبادَةٍ","وَلا هوَ مِن طولِ التَعَبُّدِ يَجهَدُ",11,"د",1,0],["مِنَ الخَيلِ العِتاقِ القو","دِ يَتلوها عَلى حَذوِ",12,"و",1,0],["من الخطَلِ المعدودِ أن قيلَ ماجِدٌ","ومادِحُهُ المُثْني عليه مَجِيد",13,"د",1,0],["مِنَ الخَفِراتِ لَم تَطلُع بِفُحشٍ","عَلى جارٍ وَلا بَكَرَت تَرودُ",14,"د",1,0],["من الخيرِ والشرِّ إلهامها","مقادِرُ تجري بهنَّ اليراعْ",15,"ع",1,0],["من الخيلِ سورٌ والصوارمِ سورُ","وليس لهم إلاَّ إلى الأسرِ ملجاٌُ",16,"ج",2,0],["من الخوفِ كالعَيْرِ قبلَ الكواءِ","يَحبقُ مما اصطلى واكتوى ؟!",17,"ا",1,0],["من الخالديين الاماجد من زووا","عن الدين عبأ الوهن بالبيض والسمر",18,"ر",1,0],["من الخِفراتِ البيضِ دُعجُ عيونِها","إذا نظرتْ تَسْبى الوَرَى بالنواظِرِ",19,"ر",1,0],["مِنَ الخَفِراتِ لا سَقوطاً خِمارُها","إِذا بَرَزَت وَلا خَروجَ المُقَيَّدِ",20,"د",1,0],["مِنَ الخورِ حَبحابٌ كَثيرٌ رُغاؤُهُ","يَرُشُّ عَلى الحاذينِ مِن بَولِهِ قَطرُ",21,"ر",1,0],["من الخدورِ التي بها احتجبوا","إلى القبور التي بها نزلوا",22,"ل",3,0],["من الخلفاءِ الرافعين بِناءهم","بأطولِ أعمادٍ وأثبتِ أساسِ",23,"س",1,0],["مِن آل خوري مِن سُراةِ عشيرةٍ","هيَ في الشآمِ من الطرازِ الأَوَّلِ",24,"ل",1,0],["مِنَ الخَفِراتِ البيضِ يَحسِبُ لَونَها","إِذا طارَ عَنها مِدرَعُ الشَفِّ مَذهَبا",25,"ب",2,0],["من الخضر الحسان اذا تبدت","تشوقك في البداوة والحضاره",26,"ر",2,0],["من الخدود السائلاتِ الصفر","عن مثل أطراف الرماح السُمْر",27,"ر",1,0],["من الخائِضاتِ النهرِ يَسمو حَبَابُه","فيُذْكرُ من حُسْنٍ ثُغورَ الحَبائبِ",28,"ب",1,0],["مِنَ الخَفِراتِ خِلتُ رِضابَ فيها","سُلافَةَ قَرقَفٍ شيبَت بِمِسكِ",29,"ك",1,0],["من الخيل سبّاق حكى كلَّ سُنبُك","يقلبُ فَهماً والسراة مداكا",30,"ك",2,0],["مِنَ الخَرابِ مِنَ الأوطانِ أوطاني","وقد مضى لي في العُمْرانِ عُمْران",31,"ن",1,0],["من الخيل النجيبات اللواتي","نشأنَ مع النعام بكل وادي",32,"د",2,0],["من الخود هيفاء القوام غريرة","تحلت بها الجوزاء وابتهج النسر",33,"ر",1,0],["من الخمرِ الحلاِ لشارِبيها","وفيه شمائلُ الخمرِ الحَرامِ",34,"م",1,0],["من الخوف تدْمى بالذَّميل خفافها","وأذْواء قفْرٍ قد نضاها سَقامُها",35,"م",3,0],["من الخير ما يُحيي وليَّاً ويحتوي","عدواً ويغدو الخطبُ وهو مُسالمهْ",36,"م",2,0],["من الخير أوفى ما جزى ذا عوارفٍ","تطيبُ اذا عُدَّ الثَّناءُ مَحافِلُهُ",37,"ل",2,0],["مِن الخَزرَجِيّاتِ الحِسانِ فمَا لَها","سِوَى خِدرِنا إِن رُمتَها مِن مَظنَّةِ",38,"ه",1,0],["مِنَ الخَفِراتِ البيضِ يُقسِمُ أنَّها","بِأجفانِها كُحلٌ وَلَيسَ بها كُحل",39,"ل",1,0],["من الخَفِراتِ يُخفي الليلُ منها","إذا ما جَنَّ ما لا يُستراب",40,"ب",1,0],["من الخشب الصلب ذات ارتفاع","وأقصرها طال طول الهاذم",41,"م",1,0],["من الخُزامى وَمِنَ العَرار","يا حبَّذا ذلكَ من عَطَّار",42,"ر",1,0],["مِن آلِ خَيرِ الخلقِ طهَ المُصطَفى","مِن أَهلِ بَيتٍ في الأَنامِ مطهّرِ",43,"ر",1,0],["مِنَ الخَفِراتِ الخُرَّدِ العِينِ حُسنُها","عَلى حُسنِ رَبّاتِ الجَمالِ أَمِيرُ",44,"ر",1,0],["من الخفرات الملهيات عن النهى","وإن هي تلهو بالحياة وتلعب",45,"ب",1,0],["من الخفيف ما ابتداؤه سبب","يليه مفروق وذا وضع وجب",46,"ب",1,0],["مِنَ الْخُلَفَاءِ الرَّاشِدِينَ بِمَا لَهُ","عَلَى الْبِرِّ وَالتَّقْوَى أَجَلّ تَحَثُّثِ",47,"ث",1,0],["مِنَ الْخَزْرَجِيِّينَ الَّذِين سُيُوفُهُمْ","تُدَافِعُ عَنْ دِينِ الهُدَى كُلَّ مُكرِثِ",47,"ث",1,0],["مِنْ آلِ خَزْرَجَ فِي سَرَارَةِ مَحْتَدٍ","أَعْيَا حَدِيثُ عَلاَئِهِ الحُفَّاظَا",48,"ظ",2,0],["مِنَ الخَزْرَجِيِّينَ الَّذِينَ سُيُوفُهُمْ","بِهِنَّ النَّوَى عَنْ أَهْلِ مِلَّتِنَا الْتَوَى",49,"و",2,0],["مِنَ الخَافِرَاتِ البِيضِ خِلْتُ دَلاَلَهَا","كَمُشْبِهِهِ يُوهِي القُوَى بِلِدَاغِ",50,"غ",1,0],["مِنْ آلِ خَزْرَجَ فِي الذَّوَائِبِ عِيصُهُ","بَدْرُ المَفَاخِرِ أَكْرَمُ الأَعْيَاصِ",51,"ص",1,0],["مِنْ آلِ خَزْرَجَ فِي الصَّمِيمِ شِعَارُهُ","جُودٌ يُنَحِّلُ مِرْزَماً وَسِمَاكَا",52,"ك",2,0],["مِنَ الخَزْرَجِيِّينَ الَّذِينَ بُيُوتُهُمْ","بِأَعْلَى مَراقِي الْمَعْلُوَاتِ شَوَامِخُ",53,"خ",1,0],["مِنْ آلِ خَزْرَجَ فِي سَرَارَةِ ضِئْضِىءٍ","لاَذَتْ بِهِ الغُرُّ الكِرَامُ لِيَاذَا",54,"ذ",2,0],["من الخُرّدِ الوسنانةِ اللحظ حرَّمت","على العينِ منِّي أن تذوقَ حثاثها",55,"ث",3,0],["مِنَ الخَفَراتِ البيضِ تُغني لِحاظِها","عَن المُرهَفاتِ البيضِ في كُلِّ مَشهَدِ",56,"د",1,0],["من الخُنسِ قد باتَت وأضحَت تَعُلُّه","بعمياءَ لا تخشى بها من مهيّجِ",57,"ج",1,0],["من الخفرات البيض ما انفك دونها","مرام تحاماه الخطوب تحاميا",58,"ي",2,0],["من آل خاقان الذين وجوههم","عند اسوداد النقع كالأقمار",59,"ر",1,0],["من الخفِراتِ إِن كشَفَتْ نقاباً","تقضَّى الليل وانتعشَ النَّهارُ",60,"ر",1,0],["من الخصائص لكن قد أبيح لنا","ما يجري منها اعتباراً يذهل الفكرا",61,"ر",2,0],["من الخفراتِ اللائي كنْتَ عظلتَها","وآليْتَ أقساماً بحنْث ملازمِ",62,"م",1,0],["مِنَ الخَفِراتِ البيضِ خُمصانَةَ الحَشا","ثِقالُ الخَطا تَكسو الفَريدَ المُقَلَّدا",63,"د",2,0],["من الخفراتِ البيض تجري وشاحُها","على مثل خَوْطِ البانةِ المترعرعِ",64,"ع",1,0],["من الخَفرات البيض يسكن بالحمى","وتحمى بيض الهند والأسل الظِماء",65,"م",3,0],["مِنَ الخَفَراتِ البيضِ لَم يُرَ مِثلُها","شِفاءً لِذي بَثٍّ وَلا لِسَقيمِ",66,"م",1,0],["مِن الخَليعين لِم يفطَن لِحاجته","يَظَلُّ ما بَينَ أَقداحٍ وَسُمّار",67,"ر",1,0],["من الخنصر الصفري الخواصر أخصر","ومن ورد صدى سلسل الريق أخصر",68,"ر",1,1],["من الخفرات البيض لم أرمثلها","شفاءً لذي بث ولا لسقيم",69,"م",1,0],["من الخطار يخطر من لبان","بوردي البرود من الدمقس",70,"س",1,0],["من آل خياط الكرام كريمة","درجت بلحد حف بالتكريم",71,"م",1,0],["من آل خياط لا زالت منازلهم","مرفوعة الشان يرجوها ذوو الشان",72,"ن",1,0],["من آل خياط كريمتهم","اضحت تُزفُّ لماجدٍ اكرم",73,"م",1,0],["من الخلد قد أخرجت جدّي آدماً","فلا تخرجيني مثل جدي من ديني",74,"ي",1,0],["من الخليّ المفيق","إلى رفيق الطريق",75,"ق",1,1],["مِن آل خندف ميمون الجبين وَمن","عَلى أنوف جيوش الشرك قَد ظهرا",76,"ر",2,0],["منَ الخزْرَجِ الأرضَيْنَ ترْتاحُ منهُمُ","إلى العِز أقْيالٌ وتَسْمو تَبابِعُ",77,"ع",1,0],["مِنَ الخَفِراتِ البيضِ تَحسِبُ أَنَّها","إِذا حاوَلت مَشياً نَزيفٌ مُرَنَّحُ",78,"ح",1,0],["من الخالق الهادي ومن يطعم الورى","ويسقي ومن يشفي المريض من السقم",79,"م",1,0],["مَنِ الخالِقُ الباري لَكُم كَنهارِكم","نَهاراً يُجَلّي ليلَهُ المُتَغَمدا",80,"د",2,0],["مِنَ الخُلدِ لا شَكَّ نَهَض","وَماثَلَ عَرّافَنا لِغَرَض",81,"ض",1,0],["مِنَ الخَمرِ صِرفاً بِها أَلفُ عَينِ","هَدِيَّةَ وُدٍّ إِلى الأَترِذَينِ",82,"ن",1,0],["مِنَ الخَصمَينِ أَيًّا ثارَ مِنهُ","بِنا شَرَرُ النَّوَائِبِ والشُّرُورِ",83,"ر",1,0],["من الخلد من ذا عليك افترى","كما لو أتيت ابنتي منكرا",84,"ر",2,0],["مِنَ الخَفَراتِ العَينُ هَيفاءُ رُخصَة","لِخَلخالِها وَالخَصرُ يَسُرُّ لَدى عَسر",85,"ر",1,0],["مِنَ الخَبَلِ أَن يَرجو الوِصال مُتَيَّم","إِذا الدارُ قَفر وَالمَزار بَعيد",86,"د",1,0],["مِن الخَفراتِ الغُر غَنجاء بِضة","بَديعَة حُسن مِن بَنات الاِعارِب",87,"ب",1,0],["من الخفرات البيض بكريزينها","حياء به من نفسها تتخفر",88,"ر",1,0],["من الخوف مني وهي في القلب حبّها","كرامة من في القلب لا زال يُذكر",89,"ر",1,0],["من الخماسية لكنَّ فقط","وكلها جاءت لمعنى لا شطط",90,"ط",1,0],["من الخفِراتِ البيضِ ودَّ جَليسُها","إذا ما قَضَت أُحدُوثة لو تُعيدُها",91,"د",3,0],["من الخبرِ الذي وافى بلِرْماً","أعيسى المجدُ أم عيسى النّبي",92,"ي",1,0],["من الخطا قد عريت","إذ كلُّها مستصوبة",93,"ب",2,0],["من الخليفه العاشر اعمارچ بْدوه","ونتي بيهم خصله خصله اتعمّرين",94,"ن",1,0],["مِنَ الْخَاْنِ لِلْكَفْرِ تَلْقَى الشَّبَاْبَ","تُرَدِّدُ: إِزْرِعَ ، دَرْعَاْ، نَمَرْ",95,"ر",1,0],["من الخليج الى اقصى المحيط له","عز ومجد وتقدير وتبجيل",96,"ل",1,0],["من الخليج إلى المحيط يظلنا","علم يرف رف بالمباهج والصفاء",97,"ا",2,0],["من الخفَّاقِ أبْعثُها رُخاءً","فيهمي غيثُها غدقًا نديَّا",98,"ي",2,0],["مِنَ الخُرَّدِ البِيضِ ما أُرْسِلَ فِي","وَجْهِها اللَّحْظُ إِلاَّ اسْتَحالا",99,"ل",2,0],["مِنَ الخَفِراتِ البِيضِ ما امْتَصَّ رِيقَها","وَقَبَّلَ مِنْها الثَّغْرَ إِلاَّ بَشامُهُ",100,"م",2,0],["مِنَ الخُرَّدِ البِيضِ ظَمْيا الحَشا","لَذِيذَةُ رَشْفِ اللَّمَى وَالقُبَلْ",101,"ل",1,0],["مِنَ الْخِيَامِ خَرَجْتُمْ تَعْزِفُونَ لَنَا","لَحْنَ الْفِدَاءِ فَجُنَّ اللَّحْنُ وَالْوَتَرُ",102,"ر",1,0],["من الخلق مطواع أوامرَ ربِه","ومنهم على عصيانِه يبذل الجهدا",103,"د",2,0],["من آل خصيب حباكم بها","ملخصة بمعاني ظرب",104,"ب",1,0],["من الخلد لي هطلتْ غادةٌ","أكاد أُجَنّ بأخلاقها",105,"ق",3,1],["من الخالدَيْنِ الرائعين اْبنِ فيصلٍ","وشبْلٍ لأحمدَ أغنَيَاني تعفّفا",106,"ف",2,0],["من الخطايا الموجبات سخطكا","من ذا يقوم سيدي لمقتكا",107,"ك",2,0]]}