{"poems":[[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[63,"لست أرجي انحطاط أوزاري","https://www.aldiwan.net/poem51614.html","البسيط"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[48,"سألت منجمها عن الطفل الذي","https://www.aldiwan.net/poem22701.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[48,"سألتْ مُنَجّمَها عن الطّفلِ الذي","https://www.poetsgate.com/ViewPoem.aspx?id=20276",""],[132,"من كان عند الله غالب","https://www.aldiwan.net/poem50660.html","مجزوء الكامل"],[201,"بأبي وأمي من مددت لها يدي","https://www.aldiwan.net/poem39903.html","الكامل"],[458,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[484,"أطرق بكفك بابا غير موصود","https://www.aldiwan.net/poem36942.html","البسيط"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216404",""],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107330","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16815","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56056","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137854",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95511","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76172","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123886","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103042","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131004","الرجز"],[4702,"حب الزبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155198",""],[4702,"المبسم الحالي","https://www.poetsgate.com/ViewPoem.aspx?id=156813",""],[4929,"حادي العيس (على نمط الشعر الجاهلي)","https://www.poetsgate.com/ViewPoem.aspx?id=201029",""],[4984,"\" ليس الأدل \" 2","https://www.poetsgate.com/ViewPoem.aspx?id=175833",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5398,"أبنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=37123",""],[5493,"تهفو الأقاحي","https://www.poetsgate.com/ViewPoem.aspx?id=197610",""],[5956,"نحن بالغيريين أقلُّ اهتماماً","https://www.poetsgate.com/ViewPoem.aspx?id=183330",""]],"verses":[["وَالنُحورُ قائِمَةٌ","قاعِدٌ بِها الوَصَبُ",0,"ب",1,0],["والنَّحرُ والخَصرُ منه قد قُسِما","بينَ صَليبٍ وبينَ زُنَّارِ",1,"ر",1,0],["وَالنَحرُ أَصلَحُ لِلشَرودِ وَما شَفى","مِنهُ كَنَحرٍ بَعدَ طولِ كَلالِ",2,"ل",1,0],["وَالنَحسُ يَعتادُ البَصيرَ وَلُبَّهُ","حَتّى يُقيمَ عِشائَهُ في ظُهرِهِ",3,"ر",2,0],["والنّحْلُ يَجْني المُرّ مِن نوْرِ الرُّبَى","فيَصِيرُ شُهْداً في طريق رُضابِهِ",4,"ب",2,0],["والنّحسُ يَعتادُ البَصيرَ ولبَّهُ،","حتى يُقيمَ عِشاءَهُ في ظُهرِه",5,"ر",2,0],["والنحوَ لا تُهْمِلْهُ فهْ","وَ أساسُ كل بيانِ كاتبْ",6,"ب",1,0],["والنحس منذ طفولتي خدني فيا","لشقاء موتور الفؤاد المبعد",7,"د",1,0],["والنحل تأوي للقفير هنيئة","حتى كأن الشهد في نظراتي",8,"ت",2,0],["والنحل من بعضه ما فيه مصلحة","وما الحرير يرى إلا من الدود",9,"د",1,0],["والنحر لهْ مثل الاَصاحيف","لي بلَقلامه ما تسطّر",10,"ر",1,0],["والنحوُ من أسناهُ قدراً إذ به","معرفةُ العبدِ كلامَ ربِّه",11,"ه",1,0],["وَالنَحسُ في طالِعِهِ","أَثبَتَ مِن وَصلِ وَتَد",12,"د",1,0],["والنحو نحو الله سار فنال مِن","مولاه ما قد نال من ارضوهُ",13,"ض",3,0],["والنحو فيه مصلح الكلام","لأنه كالملح في الطعام",14,"م",1,0],["والنحو في اللغة قصد أصلُ","وجهة قدر وقسم مثل",14,"ل",1,0],["والنحو دون شاهد لا يكمل","والشاهد المجهول ليس يقبل",15,"ل",1,0],["والنحتُ نوعان فتحتٌ جيءَ به","لجانبيه فاستواء فانتبه",16,"ه",1,0],["والنحو بدل حاله خبر بدا","اعرابه في وصف حسن نحاته",17,"ت",2,0],["والنَّحل إن يتغذَّى بالزهور غداً","ما يجتنَى منه ريحَ الزهرُ مُكتسبَا",18,"ب",2,0],["وَالنَحوُ وَاللُغى لسيبويه","في قُبةٍ مَضروبةٍ عَلَيه",19,"ه",1,0],["وَالنحس يدبر إن رآه مُقبِلاً","وَالسَعد وَالإقبال مِن إِقباله",20,"ل",2,0],["والنحو والحكمة","والمنطق والتطبب",21,"ب",1,0],["والنحو ما وردت ركابك نحوه","فترى هنالك مورداً أو مصدرا",22,"ر",2,0],["وَالنَحوُ وَالتَصريفِ وَالمَعاني","وَكُلُّ عِلمٍ رامَهُ المَعاني",23,"ي",1,0],["والنحسُ يجري أمامها صعَداً","وسعدُها أيّ ذاك ما طلَعا",24,"ع",2,0],["والنحس متصلا والسعد منقطعا","أهبت بالحظ لو ناديت مستمعا",25,"ع",2,0],["والنحل دائبٌ يجدّ العملا","فليس يدري كسلا أو مللا",26,"ل",2,0],["والنحر من رمانتينه بدا يْزيد","وحب الزبيب بْروسها يشتكيله",27,"ل",2,0],["والنحر بانواره ملا الكون ضاويها","والصدر مزبور يتضايق من ردونه",28,"ن",2,0],["والنَّحلُ ذاتُ دوِيٍّ حولَ ساحتِها","ترعى على الزَّهر ِ منْ سِدرٍ وتُمَّارِ",29,"ر",1,0],["والنحر من غالي الحُلِيِّ ارتقى","ما كان يوما من بريق عطل",30,"ل",1,0],["والنحل أكرمها المهيمن بالشفا","واختصها بالذكر في قرآنه",31,"ن",2,0],["والنحلُ يرقصُ والرحيقُ مرامُهُ","والشهدُ يدنو من سنا الأفنانِ",32,"ن",1,0],["والنحلُ مُحْتَفِلٌ بالرَّشْفِ مِنْ عسلٍ","\"هذا الرّحيقُ نميرٌ يُحْتسَى رَغَبَا\"",33,"ب",2,0],["‏ والنحل يبذل كل قوّته لكي","‏ ‏ يجني الرحيق يناله الأشرارُ",34,"ر",1,0]]}