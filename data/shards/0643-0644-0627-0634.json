{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[482,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138269",""],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129528","الرجز"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74016","الهزج"],[4691,"رتلت عيناك آيات الحبور","https://www.poetsgate.com/ViewPoem.aspx?id=61392",""],[5616,"مهاجرون","https://www.poetsgate.com/ViewPoem.aspx?id=203327",""],[6213,"أعباء الصور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76246&r=&rc=3",""]],"verses":[["كُلُّ أَشْتَاتِ النَّدَى إنْ فُرِّقَتْ","فَإِلَى بابِ فُؤادٍ مُلْتَقاها",0,"ا",3,0],["كلُّ أشعارِ الورى مؤتَّمةٌ","وهو للأشعارِ قد أضحى إِماما",1,"م",2,0],["كلا شيمتيه م حياء ومن حبا","ببشر ويسر عنه تهمي وتهمر",2,"ر",1,0],["كل أشاد بذكره المعطار إذ","أثنى الثناء المستطاب وحبذا",3,"ذ",2,0],["كل أشم شامخ عرنينه","لا يذعنن للسحاب بعلا",4,"ا",1,0],["كلا شرفيه خوّلَهُ شموخاً","يد الدهر المؤبّد لا يبيد",5,"د",1,0],["كلا شطريه إن ضوع","ف فعلان بلا مين",6,"ن",1,0],["كل أشيائي بلا لمستها","كيف تختال على عطر الزهورْ",7,"ر",1,0],["كل أشجاركم غداً تتعرّى","عندما يضرب الشبابَ الخريف!",8,"ف",1,0],["كل إشعاع تباهى أنه","صار ما لفَّ المساعي للسفر",9,"ر",1,0]]}