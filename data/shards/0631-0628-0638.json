{"poems":[[74,"عللونا عند النوى بالعناق","https://www.aldiwan.net/poem19354.html","الخفيف"],[94,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[50,"رب ظبي كهلال","https://www.aldiwan.net/poem66281.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43875","الخفيف"],[376,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[445,"رب ظبي خنث ألحاظه","https://www.aldiwan.net/poem34783.html","الرمل"],[457,"رب ظبي مقرطق مذ تبدى","https://www.aldiwan.net/poem13967.html","الخفيف"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102036","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46494","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114517","الخفيف"]],"verses":[["ربَّ ظبيٍ منكم رعى أخضر العي","ش وأفنى موارد الآماق",0,"ق",1,0],["رُبَّ ظَبْيٍ عَلِقْتُهُ","بالبَها قَدْ تَقَرْطَقا",1,"ق",2,0],["رُبّ ظبي كهلالٍ","بتُّ أسقيه المداما",2,"م",2,1],["رُبَّ ظَبْيٍ هويتُه","يَنْتَمِي للهوازِنَهْ",3,"ه",1,1],["ربَّ ظَهرٍ قلبتُه مثلَما يُق","لَبُ ظهرُ المجنِّ لِلأرشاقِ",4,"ق",1,0],["رُبَّ ظَبيٍ خَنِثٍ ألحاظُهُ","كَعَوَالي مُنذِرٍ يَومَ النِّزالِ",5,"ل",1,1],["ربَّ ظبي مُقَرْطَقٍ مُذ تَبَدّى","خلتَ بدراً من فوقه قد تلالا",6,"ل",2,1],["رب ظلم بالحزم أشبه حقاً","وحقوقا أضاعها الإنخداع",7,"ع",1,0],["رُبّ ظبي سنحا","فأهاج البُرحا",8,"ح",2,1],["رُب ظَبيٍ لَقيتهُ","يُنتَمي للهوازِنة",9,"ه",1,1],["رُبَّ ظبيٍ ذي نخوةٍ ودلالٍ","جُرحُ قلبي من لحظِهِ لَيسَ يُشفى",10,"ف",2,1]]}