{"poems":[[90,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[68,"لعمرك ما تجافى الطيف طرفي","https://www.aldiwan.net/poem39920.html","الوافر"],[92,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[113,"قد زارني وكأنه ريحانة","https://www.aldiwan.net/poem16318.html","الكامل"],[164,"سرور عم حتى ما عرفنا","https://www.aldiwan.net/poem59038.html","الوافر"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[463,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145104","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52122","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93593","الطويل"],[3393,"","https://poetry.dctabudhabi.ae/diwan/poem/107074","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4764,"حملت الدمع في كفي","https://www.poetsgate.com/ViewPoem.aspx?id=27096",""],[5216,"وقالتْ لماذا تَغارُ عَلَيّ","https://www.poetsgate.com/ViewPoem.aspx?id=187642",""],[5956,"شعرتُ بأني غبارٌ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=182531",""]],"verses":[["ولكنّ زلزال الخطوب هوى به","إلى قعر مهواة الشقاء المجسَّم",0,"م",1,0],["وَلَكِن زارَني مِن غَيرِ وَعدٍ","عَلى عَجَلٍ فَلَم يَرَ ما يُزارُ",1,"ر",1,0],["ولكنْ زَعمتُ بأن الزمانَ","دانٍ يُسفُّ مع الهيدَب",2,"ب",1,0],["وَلكنز مَبسَمِهِ دَنَوت فَخِلتَهُ","ياقوتة مَلَئَت بِأَنفُس جَوهَرِ",3,"ر",1,0],["ولكن زاد أوجههم ضياء","وأجزل في طلاقتهم واسنا",4,"ن",2,0],["وَلَكن زادَ ما شادوا","بِعَون القادر الاَزَلي",5,"ل",2,0],["ولكن زفّها الأحرارُ منكم","فما أشقيت حرّتَها بعبدِ",6,"د",1,0],["ولكن زرت أبلج يقتضيه","نداه عمارة الأمل الخراب",7,"ب",1,0],["ولكن زوت وجه الحقيقة مقلة","تظن سراب القفر عذب رواء",8,"ا",2,0],["ولكن زوى عني الأماني أنها","بلاد بها ربع العروبة ماحل",9,"ل",1,0],["ولكن زاد أوجههم ضياء","وأجزل في طلاقتهم وأسنى",10,"ن",2,0],["وَلَكن زِمام السُوء فرق بَيننا","فَشتتنا شيباً وَشَتتنا مردا",11,"د",2,0],["ولكن زاد في شيبي بهاءً","فخفت بأن يصاب من العيون",12,"ن",1,0],["وَلكِنَّ زَوجَ النبِيلِ مِنَيلا","فَعَنها على رَغمِنا لَن يَحُولا",13,"ل",2,0],["وَلَكِنَّ زَفسَ وَقَد أَنِفا","أَجابَ أَرَبَّ البِحارِ كَفَى",13,"ف",2,0],["وَلَكِنَّ زَفسَ وَقَد غِيظَ حِقدا","بِهِم زَعزَعَ اللَّيلَ بَرقاً وَرَعدا",13,"د",2,0],["وَلَكِنَّ زَفساً وَهوَ نشاهدُ وَهنِهِم","أَمام ذِيُومِيذ الصَّواعِقَ أَمطَرا",14,"ر",2,0],["ولكن زفس إذا ما نوى","فما للورى رد ما قد نوى",15,"ن",3,0],["ولكن زنث التراب جرف","فموقف آخيل فيه انخسف",16,"ف",1,0],["ولكن زادت ابكفه/مرارة وقتي المعتم","تخلخل كل ما فيني/ هوى من بعدي/ ميزاني",17,"ن",2,0],["ولكن زففتُ إليكِ القوافي","تُغنّي الجمالَ الحبيبَ البَهِيّ",18,"ي",1,0],["ولكنَّ زيفَ المظاهر يخفي ال","حقائقَ عنك فما أنا شيىءُ",19,"ا",1,0]]}