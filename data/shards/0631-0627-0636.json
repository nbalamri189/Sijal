,"https://www.poetsgate.com/ViewPoem.aspx?id=16172",""],[5038,"قل للأميرة","https://www.poetsgate.com/ViewPoem.aspx?id=188346",""],[585,"لا تلوموا مولعاً مضطربا","https://www.poetsgate.com/ViewPoem.aspx?id=161861",""],[585,"حي يا برق زمزماً والمقاما","https://www.poetsgate.com/ViewPoem.aspx?id=161876",""],[5183,"ملْغِزَة (2)","https://www.poetsgate.com/ViewPoem.aspx?id=186411",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5183,"نحن","https://www.poetsgate.com/ViewPoem.aspx?id=180151",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5220,"الحب الاكيد","https://www.poetsgate.com/ViewPoem.aspx?id=34406",""],[5264,"عذاب","https://www.poetsgate.com/ViewPoem.aspx?id=177738",""],[5407,"الشوق نارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207673",""],[5455,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=213959",""],[5587,"الحب سرار","https://www.poetsgate.com/ViewPoem.aspx?id=197803",""],[402,"لكنما الكبراء في أقوامهم","https://www.poetsgate.com/ViewPoem.aspx?id=36031",""],[402,"صدق النعي ورددد الهرمان","https://www.poetsgate.com/ViewPoem.aspx?id=36491",""],[402,"ما لهذا الخافق الواهي يجب","https://www.poetsgate.com/ViewPoem.aspx?id=35115",""]],"verses":[["راضِ بِما يُضوي الفَتى وَيُضني","غَنيتُ بِالمَجدِ وَلَم أَستَغنِ",0,"ن",1,0],["راضَ الأُمورَ عَلى أولى شَبيبَتِهِ","فَالرَأيُ مُحتَنِكٌ وَالعُمرُ مُؤتَنِفُ",1,"ف",1,0],["راضَ صَعبَ الزَمانِ بِالعَدلِ حَتّى","كادَ يَأتي بِذاهِبِ الأَمسِ رَدّا",2,"د",2,0],["راضَت خَلائِقَهُ العُقارُ وَبَدَّلَت","نزقَ الصِبى بِمُوَقَّرٍ مِطواعِ",3,"ع",1,0],["رَاضَ الصِّعَابَ العَاتِيَاتِ مُذَلِّلاً","عَقَبَاتِهَا بِالدَّأْبِ وَالإِحْسَانِ",4,"ن",1,0],["رَاضِياً مِنْ خِبْرَةٍ","أَنْ لا تَجُوزَ الخَبَرَا",5,"ر",2,0],["راضوا بها الأبدان بعد طلابهم","علماً تراض بدرسه الأفهام",6,"م",1,0],["رَاضَني ظَرْفُهُ ويَقَّظَ مني","عِلْمُهُ فادَّكَرْتُ بعد سُمُودِ",7,"د",1,0],["راضَ بالرأي مصعبَ الخطبِ حتّى","عاد مثل الطَّليح في التَّذلالِ",8,"ل",1,0],["راض مِنِّي جنونُ دهرٍ سخيفٍ","ربما ثَقَّفَ العقولَ جنونه",9,"ن",2,0],["راضني ثم هاجني فاعتلاه","بي شديدُ المحال لا موهونه",9,"ن",2,0],["راضَها بِاليُمنِ مِن طَلعَتِهِ","خَيرُ مَن حَجَّ وَمَن صَلّى وَصاما",10,"م",2,0],["راضِياً مِنها وَما يَق","نَعُ مِنها بِالصِغارِ",11,"ر",1,0],["راضٍ مِنَ الهَجرِ المُبَرِّحِ بِالنَوى","وَمِنَ الصَبابَةِ أَن يَبيتَ سَليما",12,"م",2,0],["راضَ الزَمانَ وَراضَتهُ نَوائِبُهُ","فَما اِستَكانَ وَلَم يُذمَم وَلَم يُلَمِ",13,"م",1,0],["راضَ الهَوى قَلبَها القاسي فَجادَ لَنا","وَكانَ أَبخَلَ مِن تَمّوزَ بِالمَطَرِ",14,"ر",1,0],["راضٍ مَعَ السَخطِ يُبدي عَزمَ مُنتَقِمٍ","لِلمُذنِبينَ وَيَعفو عَفوَ مُقتَدِرِ",14,"ر",1,0],["راضَ الزمانَ فلم يزلْ منه أخا","ذُلٍّ وقدماً كان فيه جماحُ",15,"ح",1,0],["راضَعتُهُ كَأسَ المُدامِ وَبَينَنا","بِجَنى الحَديثِ حَديقَةٌ وَقَبولُ",16,"ل",1,0],["راضَ نَفسي حَتّى تَرَضَّيتُ إِبلي","سُ قَديماً قَد طاوَعَتهُ النُفوسُ",17,"س",1,1],["راضَعتُهُنَّ مِنَ الصِبا","كَأساً عَقَدنَ بِها لِساني",18,"ن",2,0],["رَاضَتْهُ رَائِضَةُ الخُطُوبِ فَلَم يَكُنْ","قَرْمٌ يُسَاجِلهُ غَدَاةَ سِجَالِ",19,"ل",1,0],["رَاضُوا مُعَادَلَةَ القَنَاةِ وَسَدَّدُوا","أَرْقَامَهُمْ كَشَبَا القَنَا المَيَّالِ",19,"ل",1,0],["رَاضِياً مِنْ قِسْمَةِ اللهِ بِمَا","جَلَّ عَنْ قَدْرٍ وَغنْ قَلَّ انَّشَبْ",20,"ب",1,0],["رَاضَتْ مِنَ الْحُكْمِ مَا يُنَافِي","حُرِّيَّةَ النَّاسِ رُوْضَ مُصْعَبْ",21,"ب",1,0],["راض بِما قَدَّرتَهُ","مَن لَيسَ يَرضى كفرَك",22,"ك",1,0],["راضت النخوةُ من أخلاقنا","فخضعنا وجمحنا كرمَاءْ",23,"ا",2,0],["راضوا الْجَمُوحَ فأعطاهُمْ مَقَادتَه","وذلَّلوا الصَّعْبَ حتى لاَنَ نافرُه",24,"ر",2,0],["راضونَ ممتَّنون عن حالةٍ","لا يرتضيها مَن به يحتفون",25,"ن",1,0],["راضت محاسنُه النفوسَ فادركت","ثأراً فهاهي بالكئوس تروضه",26,"ض",2,0],["راض الشفاه الشامسات على الهوى","فضحكن يهمسن الحوار عليلا",27,"ل",2,0],["راض سواك الجوعُ والأُوامُ","وراضك الإيمانُ والإسلامُ",28,"م",1,0],["راضوا الْجَمُوحَ فأعطاهُمْ مَقَادتَه","وذلَّلو الصَّعْبَ حتى لاَنَ نافرُه",29,"ر",2,0],["راضيا حينا وحينا ساخطا","قيد جبارين روحي وهواها",30,"ه",2,0],["راض الزمانَ سياسةً فبِقَصْدِه","تجري الكواكبُ في ذُرا الأبراج",31,"ج",1,0],["راضتْ سياستُك البلادَ وأهلَها","فكأنها أُمٌّ وهم إخوان",32,"ن",1,0],["راض قلبي الهوى فلان وقد كا","ن جموحا يهابهُ الرواض",33,"ض",1,0],["راضٍ بِما رضي الإلَ","هُ وَما به لسواه غيظُ",34,"ظ",1,0],["راضتِ النَخوةُ من أخلاقِنا","وارتَضى آدابنا صدقُ الولاء",35,"ا",2,0],["راض بأحلامي التي","تضفى عليك حلى الجلال",36,"ل",1,0],["راضِ الغَرامِ جَموحُ قَلبي مُذ غَدا","وَالخَدُّ مِنهُ بِالعِذارِ مُرَوِّضُ",37,"ض",1,0],["راضَ الأُمورَ فَأَصبَحَت","طَوعَ الأَزِمَّةِ وَاِمطَطاها",38,"ا",3,0],["راضَها بُرهَةً وَتَأ","بى عَلَيهِ إِلّا الحَرَن",39,"ن",1,0],["راضوا الأُمورَ فَأَصبَحَت مُنقادَةً","لَهُمُ وَكانَت شُمَّساً لا تَبتَعُ",40,"ع",1,0],["راضَت محاسِنُها الجَموحَ على الهَوى","فانْساقَ حتّى ما أطاقَ جِماحا",41,"ح",2,0],["راضه السُكرُ فاِقتَني الرَشأ الوح","شيّ أنساً من خُلقه المأنوسِ",42,"س",1,0],["راضٍ وَعَينُ الرِضا بِالحَظِّ تَرمُقُهُ","وَلا عُيوبَ مُعاذِ اللَهِ أَو عارُ",43,"ر",1,0],["راضَها الرَّائِضُ ثُمَّ اِستُعفِيَت","لِقِرَى الهَمِّ إِذا ما يَحْتَضِرْ",44,"ر",1,0],["راض بحكم القضا في السابقات رضى","يا ليت شعري أفعلي الآن راضيكا",45,"ك",2,0],["راضٍ عن الإعراضِ والوصلِ به","وفي انطلاقِ الكف وانضمامِها",46,"م",3,0],["راضٍ من الهُونِ ومن عجْزِ المُنى","بما اكتسى منتفحاً وما طَعِمْ",47,"م",1,0],["راض العلا قارح العزيمة واس","تظهر حتى كأنه جَذعُ",48,"ع",1,0],["راضٍ إذا سفك الدما","ءَ بما تقلَّد من جُناحِ",49,"ح",1,0],["راضوا الأمورَ فتيُّهم كمسنِّهم","سَوْمَ الكعوبِ تلاحقَتْ فتنظمَّتْ",50,"ت",1,0],["راضون أن يُشبعوا ويَضْوَوا","والعامُ مسحنفزٌ غَصوبُ",51,"ب",1,0],["راضَ الزمانَ فأصبحت أيامه","طوعاً وتضاءَلت أقداره",52,"ر",2,0],["راضوا الليالي فانقادت مسخرة","واستصغروا هجمات الدهر فاتضعا",53,"ع",2,0],["راضَعتُ فيهِ الكَأسَ أَهيَفَ يَنثَني","نَحوي بِجيدِ رَشاً وَعَينَي مُغزِلِ",54,"ل",1,0],["راضٍ كَلا أو ساخط كالراضي","والعمر دَين والزمان تقاضِ",55,"ض",1,1],["راضه فارسه حتى أتى","سلس الأعطاف سهل المقود",56,"د",1,0],["راضته لي مشمولة","تري النشاط بالكسل",57,"ل",1,0],["راضٍ بأنْ نفسي فَدَتك وما حَوَتْ","كفّايَ لي مِن طارفٍ وتِلادِ",58,"د",1,0],["راض على كل حال","بالحق طهر رجسه",59,"س",2,0],["راضَ الصِّعابَ التي انقادَتَ فكانَ لهُ","في القَفرِ والبَحرِ بُستانٌ ومَيْدانُ",60,"ن",1,0],["راضَها الماءُ فاطمَأنت وقد ندَّ","ت وعَضَّت على الشَّكيمِ جِماحا",61,"ح",2,0],["راضَتهُ لَوعَتهُ وَضَمَّرَهُ الهَوى","فَجَرى فَحازَ السَبقَ في مِضمارِهِ",62,"ر",2,0],["راض الأمور فأقبلت منقادة","وزمامها بيديه لا يستصعب",63,"ب",1,0],["راضت خلائقه محاسن فاغتدى","الخال عبد والعذار تخرجا",64,"ج",2,0],["راضٍ بما اعتاد من ذل ومتربة","وهول عادية بل جور أحكام",65,"م",1,0],["رَاضَعْتُهَا ثَدْيَ الوِصَالِ وَبَيْنَنَا","بِجَنَى الحَديِثِ حَدِيقَةٌ غَنَّاءُ",66,"ا",2,0],["راضٍ بحكم هواك واجد","فعلام أنت عليّ واجد",67,"د",1,1],["راضعا ثدي فخار وابا","جاد حتى بلغ السيل الزبى",68,"ب",2,0],["راضيته من بعد سخطٍ به","ورضته من بعد طول الجماح",69,"ح",1,0],["راضوا الخطوب وما ارتاضا لها أَنَفاً","وصابروها فلم تصبِر كما صبروا",70,"ر",3,0],["راضِين سَوْمَ الخَسْفِ خَوْفَ منِيَّةٍ","تَسْقي الأَنامَ بكاسها المسمومِ",71,"م",1,0],["راضتْ تجارِبُه الزمان وراضها","فاقتاد أصعَبهَ برأيٍ فيَصلِ",72,"ل",1,0],["راضوا ببأسهم الدنيا وجودهم","رياضة هذبتنا أيَّ تهذيبِ",73,"ب",1,0],["راضت شمائله الشمول وطالما","قد بتُّ ألقى عزة بتخضعي",74,"ع",2,0],["راضت شمائله كأس الشمول وكم","قد ليَّنت شرس الأخلاق صهباء",75,"ا",2,0],["رَاضيةٌ هويتُها","فَطوَّلت جفَائيَه",76,"ه",1,1],["راضع من لبانها فارسيٌّ","أدم اللون ليس ينميه آدم",77,"م",1,0],["راضَ الزَّمانَ فَأَصبَحَت أَخلاقُهُ","وَأَعادَ صَبغَ شَبابِهِ لَمّا نَضا",78,"ض",2,0],["راض بالنسك نفسه فهي لا","تغضب الا والهمت تقواها",79,"ا",3,0],["راض بقوت المعاش منضع","على تراث الأباء يتكل",80,"ل",1,0],["راضَت فراسته نجائب عزمه","فاذا جرت طارَت بجنحى طائِر",81,"ر",1,0],["راضَ حَبيبي عارِضٌ قَد بَدا","يا حُسنَهُ مِن عارِضٍ رائضِ",82,"ض",1,1],["راض صعب القريض رب قواف","لو بعصر الرضي قيل الرضي",83,"ي",1,0],["راض الإلاه لك الزّمان وطالما","قد كان عنك من الحياء نفورا",84,"ر",2,0],["راض الانام بعلمه وبحلمه","فتقدموا في حلبة الاسباق",85,"ق",1,0],["راض عنكم رمضان يؤر","رخ فارق شهر القرآن",86,"ن",1,0],["راض المَصاعِب رائِض","جعل العَصيّ الأطوعا",87,"ع",2,0],["راضَ الخطوب وشيَّعتْهُ عَزيمةٌ","كالسيفِ أَيسرُ مسِّه التَّطبيْقُ",88,"ق",1,0],["راض الغرام بمدمع مدرار","ودعى السلو بوقفة في الدار",89,"ر",1,1],["راضها بالمزاج ساق رخيم","من فنون الجمال فاق الملاحا",90,"ح",2,0],["راض لما يرضي الإله وساخط","من كل فعل يسخط القيوما",91,"م",2,0],["راض الكلام الصعب حتى ردهن","سلس المقادة في يديه عنانه",92,"ن",2,0],["راضوا نفوسهم لخدمة ربهم","ولذاك فازوا منه بالرضوان",93,"ن",1,0],["راضٍ بتدبير الإله مفوضاً","كل الشؤن إلى العليم بحاله",94,"ل",2,0],["راضي أنا بِمَّا يِقَدَّر عَلَيَّه","صابِر على عِظم الأمور وكِمَالها",95,"ل",3,0],["راضية النفسِ سلاميّة ٌ","عفيفةُ الروح ولا تكذبُ",96,"ب",1,0],["راضي بتعذيبك لأجل قلبٍ غلاك","أربع سنين وأنا متحم ل تغليك",97,"ك",1,0],["راضِ منْ الحَيِّ ما يَرجو مَنِيَّتَهُ","راضِ من المَيْتِ ما يَرجُو مِنَ التّبَبِ",98,"ب",1,0],["راضيه كلي بقسمه / نَصها رب البرايا","بس خلوني اشوفه / قبل اعدامي وحتفي",99,"ف",2,0],["راضيةٌ قد رضيت بالقدر","وما إله الكون فيها أمرْ",100,"ر",1,1],["راضي بحكم الله علي مهما يكون","عالج عيوني لو بعد طبك عميت",101,"ت",1,0],["راضت ببشر وصالها قلبي وقد","تركت رقيبي باللقاء يغتاظ",102,"ظ",1,0],["رَاض بِمَا صنعت أَيدي الغرام بِهِ","فحسبه الْحبّ مَا أعْطى وَمَا سلبا",103,"ب",2,0],["راض الخطوب الصم بعد جماحها","وألان من قلب الزمان القاسي",104,"س",2,0],["راضَ الأُسودَ وَأنْتِ لَمْ تَتَرَوَّضي","كَيفَ السَّبيلُ إلَيكِ لا تَتَرَدَّدي",105,"د",2,0],["راض منها الصعب حتى أنه","سلب الخاتم ثم انقلبا",106,"ب",2,0],["راض هوج الرياح حتى امتطاها","ذللاً أسلست إليه الزماما",107,"م",2,0],["راضها الجد فراضت ظهره","وطواها الجَد للغاية طيْ",108,"ي",1,0],["راضها للبيان حتى استبانت","سرها في جلاله الروحاني",109,"ن",2,0],["راضهم والسلاح صفر وأيديه","م عليها سكينة الأتقياء",110,"ا",2,0],["راضها في جماحها وتحدى","نعرة الدهر في بني الإنسان",111,"ن",1,0],["رَاضٍ عَنِ النَّفسِ يَرضَى مَنْ يُدَاهِنُهُ","يَستَبشِعُ الحَقَّ بِالتَّعرِيفِ يَزرَاكَا",112,"ك",2,0],["راضي بتعذيبه ونيرانه بقلبي لو تزيد","ياليت نيران الغلا ما تنطفي ياليتها",113,"ت",3,0],["راضيه حبيبتى بظلمك ليا","معقوله لسه ما شبعتيش",114,"ش",1,0],["راضي بمقسومي وصابر على البعد","وراضي بتقصيره وراضي بْعقابه",115,"ب",2,0],["راضي بحالي كذا ... واللي يجي عادي","لعيون منهو ركز في قلبي الحربه",116,"ب",2,0],["رَاضْيَة قْضَايَا وْ الفْرَاحْ مَا تَطْيَابْلِي","وْدَمْعْتِي جَرَّايَا مِنْ عِينِي مَا تْغِيبْ",117,"ب",1,0],["راضوا معادلة القناة وسدوا","أرقامهم كشبا القنا الميال",118,"ل",1,0],["راضا لصعاب العاتيان مذللا","عقباتها بالدأب والإحسان",119,"ن",1,0],["راضيا من قسمة الله بما","جل عن قدر وإن قل النشب",120,"ب",1,0]]}