{"poems":[[53,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[71,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[93,"أنت تبغي السيرا","https://www.aldiwan.net/poem11269.html","مجزوء الرمل"],[88,"قصدوا الرياضة لاعبين وبينهم","https://www.aldiwan.net/poem44415.html","الكامل"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[45,"غلت الأشياء حتى الكشح","https://www.aldiwan.net/poem64549.html","مجزوء الرمل"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[74,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[52,"راض نفسي حتى ترضيت إبلي","https://www.aldiwan.net/poem26911.html","الخفيف"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54586","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=179088",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[101,"للّه يومٌ جَرَى باليُمْن طائرُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62454&r=&rc=46",""],[130,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[183,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[183,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[184,"ما لعيني مذ هويت اغتماض","https://www.aldiwan.net/poem43663.html","الخفيف"],[187,"لك نحو أرض العرب لحظ","https://www.aldiwan.net/poem35157.html","مجزوء الكامل"],[223,"يا لواء الحسن أحزاب الهوى","https://www.aldiwan.net/poem55176.html","الرمل"],[224,"الانتظار الخالد","https://www.aldiwan.net/poem24230.html","عموديه"],[230,"ألقاه بالشكوى إليه فيعرض","https://www.aldiwan.net/poem14815.html","الكامل"],[233,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[233,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[233,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[273,"طلعت عليك مع المساء صباحا","https://www.aldiwan.net/poem25602.html","الكامل"],[295,"طاف بدر الدجى بشمس الكؤوس","https://www.aldiwan.net/poem33240.html","الخفيف"],[318,"أهل البلاغة يهني القلب إن صاروا","https://www.aldiwan.net/poem67224.html","البسيط"],[365,"ثم إن ينزع إلى أقصاهما","https://www.aldiwan.net/poem4616.html","الرمل"],[438,"هيظت قلبي أبا الخرصي يسلوكا","https://www.aldiwan.net/poem14470.html","البسيط"],[456,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[456,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[456,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[456,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[456,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[462,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[491,"كم للصبابة والصبا من منزل","https://www.aldiwan.net/poem67332.html","الكامل"],[493,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[549,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[556,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[560,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"]],"verses":[["راضِ بِما يُضوي الفَتى وَيُضني","غَنيتُ بِالمَجدِ وَلَم أَستَغنِ",0,"ن",1,0],["راضَ الأُمورَ عَلى أولى شَبيبَتِهِ","فَالرَأيُ مُحتَنِكٌ وَالعُمرُ مُؤتَنِفُ",1,"ف",1,0],["راضَ صَعبَ الزَمانِ بِالعَدلِ حَتّى","كادَ يَأتي بِذاهِبِ الأَمسِ رَدّا",2,"د",2,0],["راضَت خَلائِقَهُ العُقارُ وَبَدَّلَت","نزقَ الصِبى بِمُوَقَّرٍ مِطواعِ",3,"ع",1,0],["رَاضَ الصِّعَابَ العَاتِيَاتِ مُذَلِّلاً","عَقَبَاتِهَا بِالدَّأْبِ وَالإِحْسَانِ",4,"ن",1,0],["رَاضِياً مِنْ خِبْرَةٍ","أَنْ لا تَجُوزَ الخَبَرَا",5,"ر",2,0],["راضوا بها الأبدان بعد طلابهم","علماً تراض بدرسه الأفهام",6,"م",1,0],["رَاضَني ظَرْفُهُ ويَقَّظَ مني","عِلْمُهُ فادَّكَرْتُ بعد سُمُودِ",7,"د",1,0],["راضَ بالرأي مصعبَ الخطبِ حتّى","عاد مثل الطَّليح في التَّذلالِ",8,"ل",1,0],["راض مِنِّي جنونُ دهرٍ سخيفٍ","ربما ثَقَّفَ العقولَ جنونه",9,"ن",2,0],["راضني ثم هاجني فاعتلاه","بي شديدُ المحال لا موهونه",9,"ن",2,0],["راضَها بِاليُمنِ مِن طَلعَتِهِ","خَيرُ مَن حَجَّ وَمَن صَلّى وَصاما",10,"م",2,0],["راضِياً مِنها وَما يَق","نَعُ مِنها بِالصِغارِ",11,"ر",1,0],["راضٍ مِنَ الهَجرِ المُبَرِّحِ بِالنَوى","وَمِنَ الصَبابَةِ أَن يَبيتَ سَليما",12,"م",2,0],["راضَ الزَمانَ وَراضَتهُ نَوائِبُهُ","فَما اِستَكانَ وَلَم يُذمَم وَلَم يُلَمِ",13,"م",1,0],["راضَ الهَوى قَلبَها القاسي فَجادَ لَنا","وَكانَ أَبخَلَ مِن تَمّوزَ بِالمَطَرِ",14,"ر",1,0],["راضٍ مَعَ السَخطِ يُبدي عَزمَ مُنتَقِمٍ","لِلمُذنِبينَ وَيَعفو عَفوَ مُقتَدِرِ",14,"ر",1,0],["راضَ الزمانَ فلم يزلْ منه أخا","ذُلٍّ وقدماً كان فيه جماحُ",15,"ح",1,0],["راضَعتُهُ كَأسَ المُدامِ وَبَينَنا","بِجَنى الحَديثِ حَديقَةٌ وَقَبولُ",16,"ل",1,0],["راضَ نَفسي حَتّى تَرَضَّيتُ إِبلي","سُ قَديماً قَد طاوَعَتهُ النُفوسُ",17,"س",1,1],["راضَعتُهُنَّ مِنَ الصِبا","كَأساً عَقَدنَ بِها لِساني",18,"ي",1,0],["رَاضَتْهُ رَائِضَةُ الخُطُوبِ فَلَم يَكُنْ","قَرْمٌ يُسَاجِلهُ غَدَاةَ سِجَالِ",19,"ل",1,0],["رَاضُوا مُعَادَلَةَ القَنَاةِ وَسَدَّدُوا","أَرْقَامَهُمْ كَشَبَا القَنَا المَيَّالِ",19,"ل",1,0],["رَاضِياً مِنْ قِسْمَةِ اللهِ بِمَا","جَلَّ عَنْ قَدْرٍ وَغنْ قَلَّ انَّشَبْ",20,"ب",1,0],["رَاضَتْ مِنَ الْحُكْمِ مَا يُنَافِي","حُرِّيَّةَ النَّاسِ رُوْضَ مُصْعَبْ",21,"ب",1,0],["راض بِما قَدَّرتَهُ","مَن لَيسَ يَرضى كفرَك",22,"ك",1,0],["راضت النخوةُ من أخلاقنا","فخضعنا وجمحنا كرمَاءْ",23,"ا",2,0],["راضوا الْجَمُوحَ فأعطاهُمْ مَقَادتَه","وذلَّلوا الصَّعْبَ حتى لاَنَ نافرُه",24,"ر",2,0],["راضونَ ممتَّنون عن حالةٍ","لا يرتضيها مَن به يحتفون",25,"ن",1,0],["راضت محاسنُه النفوسَ فادركت","ثأراً فهاهي بالكئوس تروضه",26,"ض",2,0],["راض سواك الجوعُ والأُوامُ","وراضك الإيمانُ والإسلامُ",27,"م",1,0],["راضوا الْجَمُوحَ فأعطاهُمْ مَقَادتَه","وذلَّلو الصَّعْبَ حتى لاَنَ نافرُه",28,"ر",2,0],["راضيا حينا وحينا ساخطا","قيد جبارين روحي وهواها",29,"ه",2,0],["راض الزمانَ سياسةً فبِقَصْدِه","تجري الكواكبُ في ذُرا الأبراج",30,"ج",1,0],["راضتْ سياستُك البلادَ وأهلَها","فكأنها أُمٌّ وهم إخوان",31,"ن",1,0],["راض قلبي الهوى فلان وقد كا","ن جموحا يهابهُ الرواض",32,"ض",1,0],["راضٍ بِما رضي الإلَ","هُ وَما به لسواه غيظُ",33,"ظ",1,0],["راضتِ النَخوةُ من أخلاقِنا","وارتَضى آدابنا صدقُ الولاء",34,"ا",2,0],["راض بأحلامي التي","تضفى عليك حلى الجلال",35,"ل",1,0],["راضِ الغَرامِ جَموحُ قَلبي مُذ غَدا","وَالخَدُّ مِنهُ بِالعِذارِ مُرَوِّضُ",36,"ض",1,0],["راضَ الأُمورَ فَأَصبَحَت","طَوعَ الأَزِمَّةِ وَاِمطَطاها",37,"ا",3,0],["راضَها بُرهَةً وَتَأ","بى عَلَيهِ إِلّا الحَرَن",38,"ن",1,0],["راضوا الأُمورَ فَأَصبَحَت مُنقادَةً","لَهُمُ وَكانَت شُمَّساً لا تَبتَعُ",39,"ع",1,0],["راضَت محاسِنُها الجَموحَ على الهَوى","فانْساقَ حتّى ما أطاقَ جِماحا",40,"ح",2,0],["راضه السُكرُ فاِقتَني الرَشأ الوح","شيّ أنساً من خُلقه المأنوسِ",41,"س",1,0],["راضٍ وَعَينُ الرِضا بِالحَظِّ تَرمُقُهُ","وَلا عُيوبَ مُعاذِ اللَهِ أَو عارُ",42,"ر",1,0],["راضَها الرَّائِضُ ثُمَّ اِستُعفِيَت","لِقِرَى الهَمِّ إِذا ما يَحْتَضِرْ",43,"ر",1,0],["راض بحكم القضا في السابقات رضى","يا ليت شعري أفعلي الآن راضيكا",44,"ك",2,0],["راضٍ عن الإعراضِ والوصلِ به","وفي انطلاقِ الكف وانضمامِها",45,"م",3,0],["راضٍ من الهُونِ ومن عجْزِ المُنى","بما اكتسى منتفحاً وما طَعِمْ",46,"م",1,0],["راض العلا قارح العزيمة واس","تظهر حتى كأنه جَذعُ",47,"ع",1,0],["راضٍ إذا سفك الدما","ءَ بما تقلَّد من جُناحِ",48,"ح",1,0],["راضوا الأمورَ فتيُّهم كمسنِّهم","سَوْمَ الكعوبِ تلاحقَتْ فتنظمَّتْ",49,"ت",1,0],["راضون أن يُشبعوا ويَضْوَوا","والعامُ مسحنفزٌ غَصوبُ",50,"ب",1,0],["راضَ الزمانَ فأصبحت أيامه","طوعاً وتضاءَلت أقداره",51,"ر",2,0],["راضوا الليالي فانقادت مسخرة","واستصغروا هجمات الدهر فاتضعا",52,"ع",2,0],["راضَعتُ فيهِ الكَأسَ أَهيَفَ يَنثَني","نَحوي بِجيدِ رَشاً وَعَينَي مُغزِلِ",53,"ل",1,0],["راضٍ كَلا أو ساخط كالراضي","والعمر دَين والزمان تقاضِ",54,"ض",1,1],["راضه فارسه حتى أتى","سلس الأعطاف سهل المقود",55,"د",1,0],["راضته لي مشمولة","تري النشاط بالكسل",56,"ل",1,0],["راضٍ بأنْ نفسي فَدَتك وما حَوَتْ","كفّايَ لي مِن طارفٍ وتِلادِ",57,"د",1,0],["راض على كل حال","بالحق طهر رجسه",58,"س",2,0],["راضَ الصِّعابَ التي انقادَتَ فكانَ لهُ","في القَفرِ والبَحرِ بُستانٌ ومَيْدانُ",59,"ن",1,0]]}