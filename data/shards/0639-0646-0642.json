],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"توشَّحَ الليلُ في أغوارِ لوحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=205053",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5431,"إياك أن تقعا","https://www.poetsgate.com/ViewPoem.aspx?id=207941",""],[5542,"قلعة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=10191",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5739,"ياغايبه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131706",""],[5809,"مراض","https://www.poetsgate.com/ViewPoem.aspx?id=205099",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6093,"ذاك لنا","https://www.poetsgate.com/ViewPoem.aspx?id=197424",""],[6124,"يا مالكا قلبي لما","https://www.poetsgate.com/ViewPoem.aspx?id=201239",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6315,"الفتاة الراهبة .. الفتاة الهاربة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87578&r=&rc=3",""]],"verses":[["عَنَقاً عَلى عُنقِ الطِلابِ تَحُثُّها","هِمَمٌ ضَمَنَّ عَوائِدَ الإِنجاحِ",0,"ح",1,0],["عُنْ قَدْرِهِ المُعْتَلِي","تُقْصُرُ أَسْنَى الرُّتَبْ",1,"ب",1,0],["عَنْ قَاتِلِ النُّبْلِ عَدُوِّ الحِجَى","مُظْمِيءِ نصْلِ السَّيْفِ فِي غِمْدِهِ",2,"د",2,0],["عَن قَريبٍ تَرَونَ حا","سِدَهُ وَهوَ راحِمُه",3,"م",2,0],["عن قريب نرى السعا","دة بالعين من امم",4,"م",1,0],["عُنُقٌ كَقائِمَةِ القَليبِ تَعَطَّفَت","أَوَداً وَرَأسٌ مِثلُ قَعوِ الماتِحِ",5,"ح",1,0],["عُنُقُ المجاهدِ ليس يُغمَطُ حَقُّه","سِيَّانِ سَيْفٌ قاطِعٌ وتُرابُ",6,"ب",1,0],["عُنقَ الزَرافَةِ ما بالِي وَبالُكُمُ","تُكَفِّرونَ رِجالاً كَفَّروا رَجُلا",7,"ل",2,0],["عَن قَريب ستهب","بُ علينا عاصفُ",8,"ف",1,1],["عَن قَريبٍ تَرَونَهُ","بِظُنونٍ تُصَدَّقُ",9,"ق",1,0],["عَن قصّهِ عن وعظهِ عن حضّهِ","لَو كانَ مِن تلقائهِ ما أحجموا",10,"م",3,0],["عَن قَوسِ وَصلٍ بِسِهامِ الهَوى","فَلَم نَزَل حَتّى صَرَعناهُ",11,"ن",3,0],["عن قريبٍ نكونُ فيها رجالاً","ونربي بناتنا والبنينا",12,"ن",2,0],["عن قسطل الحرب لم يثنوا عنتهم","وما لهم عن حيض الموت تهليل",13,"ل",1,0],["عَن قَليلِ بَينَ العُراةِ وَبَينَ ال","بَردِ حَربُ لا تُصطَلى وَنِزالُ",14,"ل",1,0],["عَن قَوسِ حاجِبِها رَمَت لَمّا رَنَت","قَلبي بِلَحظٍ سَهمُهُ ما أَقتَلَه",15,"ل",2,0],["عَن قَوسِ حاجِبِهِ رَمى لَمّا رَنا","فَأَصابَني بِسِهامِ زاهٍ هازي",16,"ز",2,0],["عَن قَوسِهِ يَرمي وَعَن لَحَظاتِهِ","فَسِهامُهُ عَن مَقتَلٍ لَم تَخرُجِ",17,"ج",1,0],["عُنقودُ صُدغِكَ رَجعُ اللَحظِ يَعصِرُهُ","خَمراً بِريقِكَ شَمسُ الخَدِّ تَهصِرُهُ",18,"ر",2,0],["عن قليلٍ ترى دقيقةَ عدلٍ","أبديٍّ بها الديارُ يَباب",19,"ب",1,0],["عنقودُ كافورٍ وزهرةُ بقعةٍ","تفاحةٌ في غيضةٍ حسناء",20,"ا",2,0],["عنقاء من طخفة أو رجامها","مشرفة الهادي على أعلامها",21,"م",3,0],["عن قريب وحبيب","لم يراهم بعض ساعه",22,"ع",2,0],["عن قتيل في القدس من غير ذنبٍ","عمره في الشهور، قبل السنينِ؟!",23,"ن",1,0],["عن قول ربي كل شيء هالك","إلا الذي استثناه خالقنا العلي",24,"ل",2,0],["عن قليلٍ نَرى قوامَكَ ذَا المَا","ئِسَ قد عادَ ذَا اعتدالٍ قَويمَا",25,"م",2,0],["عن قهوةٍ بوجودِها","ألبابُنا لا شكّ تُعْدَمْ",26,"م",1,0],["عُنُقٌ لعمرُ أبيك جامحةٌ","لم يثنها الرُّوَّاضُ من قبلي",27,"ل",2,0],["عنقاً إلى البيت العتيق من العلى","ومغارس الحسب الأصيل الزاكي",28,"ك",2,0],["عنقا تجد براكبيها في السرى","ما بين منسرج الحدا وطويله",29,"ل",2,0],["عنقي باغلال الغرام مطوق","لا اطلب الاطلاق من اغلاله",30,"ل",2,0],["عنقو ونام لبكرا","ويكون في الليل شريك",31,"ك",1,0],["عَن قَليلٍ يَسُرُّ ما ساءَ أو يُضت","حِكُكَ الحادِثُ الذي أبكاكا",32,"ك",2,0],["عنقود صُدغ الذي أهواه تَيَّمني","فقال لي ريقه لمَّا رأَى وصبي",33,"ي",1,1],["عنقه شرى عنق الدّماني مْثنّي","يا شبه ريمٍ جافل في أقفاره",34,"ر",2,0],["عن قريب يزورنا","في قيود الأداهم",35,"م",1,0],["عن قلبه الهاوي إلى","ما قد هواه وصَبَا",36,"ب",2,0],["عَنْ قَوَامِ البَانِ عَنْ لَحْظِ المَهَا","عَنْ ثَنَايَا الزَّهْرِ عَنْ جِيدِ الغَزَالْ",37,"ل",1,0],["عَنْ قَصَبٍ أَسْحَمَ مُدْلَهِمِّ","لا أَبْتَغِي بِالعَمَل الأَذَمِّ",38,"م",1,0],["عنقاء معكوسك اقنع تكتسب نشبا","ولا تشدُّ على مهريّةٍ قتبا",39,"ب",2,1],["عَن قول مِبْغِض يَشعِبَه","ويقول هذا شِ عذِرَه",40,"ر",2,0],["عن قبحه ليس بغضا","قابلتُ بالغدر حباً",41,"ب",2,0],["عن قبلةٍ قد ضلَّت بصيرتُهم","ويل لمن خصَّه عقلٌ وإِيمان",42,"ن",1,0],["عن قُلَّبِ القَلْبِ يَفْري كلَّ نازلة","حَزماً يسدُّ طريقَ العارِضِ الهَطِل",43,"ل",1,0],["عن قاب قوسين أو أدنى هبطت ولم","تستكمل الليل بين المد والقفل",44,"ل",1,0],["عنقود كافور حبيبي عرفهُ","قد عرّف الدنيا وفيه تنعم",45,"م",1,0],["عن قريب ترى الصريخ ينادي","باحتكام الكميت في كل نادي",46,"د",2,0],["عنقوده المسوّد ذا مثل الدُّجى","تحكي بُعوراً كُلّلَت تَكليلا",47,"ل",2,0],["عنقاءُ مُغربٍ قد تعورفَ ذكرها","عُرفاً وبابُ وجودها مسدودُ",48,"د",1,0],["عن قده العدل يروى مسنداً ولذا","تدعو له بالبقا عشاق دولته",49,"ت",2,0],["عن قرب من في قربه","يرجو الشفاعة كل مذنب",50,"ب",1,0],["عن قَليلٍ يَصير مث","ليَ من كنتُ مثلَهُ",51,"ه",1,0],["عن قوس حاجبه يرمي بمصمية","فهل له في صميم القلب من غرض",52,"ض",1,0],["عنقت على عنق الطريق جوافلا","ينجو بها التوخيد والاعناق",53,"ق",1,0],["عنق مائل وطرف كسير","وفم مرتج ووجه قطوب",54,"ب",1,1],["عن قصد كانت تغريني","بدمى الأطفال تناغيني",55,"ن",2,1],["عن قصد كانت تغريني","بلسان الرمز تحاكيني",55,"ن",2,0],["عُنْقاً يقلبها وَرَأساً غاوِياً","صَعْلاً وَقَد يَسمو عَلى الصَّعْلِ",56,"ل",1,0],["عن قليلٍ تَرونها وتَرونَ ال","نقعَ من بَعْدِها مكانَ الرَّدِيْفِ",57,"ف",1,0],["عن قريب أفارق الدار يا من","تغتدي الدَّار بعده أطلالا",58,"ل",2,0],["عُنُقي لِحَدِّ المَشرفية إِن يَكُن","أو كانَ مِثلُكَ خَضرَماً وَنَجيبا",59,"ب",2,0],["عُنُقٌ يَطولُ بِها فُضولَ عِنانِهِ","وَمُحَزَّمٌ يَغتالُ فَضلَ حِزامِهِ",60,"م",2,0],["عن قريب تفارق الروح جسمي","وسيبقى رسمي مدى الايام",61,"م",1,0],["عَن قَليلٍ يُشكى إِلَي","كَ فَتَرثي لِمَن بَكا",62,"ك",2,0],["عن قريب المعنى فحلق آمادا","فحلت عين الندى حيث حلا",63,"ل",2,0],["عن قلب مشبوب الحشى","اكفف سهامك ظبي وجره",64,"ر",2,0],["عَن قيدك لَو حلَّ فؤادي قالَت","ما