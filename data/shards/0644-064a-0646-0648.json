{"poems":[[90,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[29,"أصاح أليس اليوم منتظري صحبي","https://www.aldiwan.net/poem5684.html","الطويل"],[49,"هي الدار من سلمى وهاتي المرابع","https://www.aldiwan.net/poem25232.html","الطويل"],[49,"وعلة لم تدع قلبا بلا ألم","https://www.aldiwan.net/poem25379.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[63,"هل الصبر مجد حين أدرع الصبرا","https://www.aldiwan.net/poem51671.html","الطويل"],[68,"لئن وهى عقد السحاب الثمين","https://www.aldiwan.net/poem40656.html","الرجز"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[107,"أمهجة مصر يضرب كل رام","https://www.aldiwan.net/poem43149.html","الوافر"],[107,"أخا الدهر ما الدهر إذ ينسب","https://www.aldiwan.net/poem43389.html","الكامل"],[83,"أثار الليث ألحاظ نيام","https://www.aldiwan.net/poem61486.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85820","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30493","البسيط"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[147,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[280,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[305,"ألم تسأل بفاضحة الديارا","https://www.aldiwan.net/poem45488.html","الوافر"],[422,"عرفت صبابة هذي النياق","https://www.aldiwan.net/poem53927.html","المتقارب"],[438,"انظر لمطرد المياه بصفحتي","https://www.aldiwan.net/poem12710.html","الكامل"],[443,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[445,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[445,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[458,"رئيس العزف حين تشير تحيى","https://www.aldiwan.net/poem61720.html","الوافر"],[473,"كأنما سرج قناديلها","https://www.aldiwan.net/poem60058.html","السريع"],[482,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[482,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[520,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63746","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120050","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50042","المتقارب"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123036","الكامل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/122936","المجتث"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110625","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199935","الخفيف"],[3393,"","https://poetry.dctabudhabi.ae/diwan/poem/107079","المجتث"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124015","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20563","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108375",""],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36023","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86535","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32672","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76685","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139588",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[6152,"حنين روح","https://www.poetsgate.com/ViewPoem.aspx?id=203307",""]],"verses":[["لئن وَأدوا البنات فقد قَبَرنا","جميع نسائنا قبل الممات",0,"ت",1,0],["لَئِن وَضَعَت قَيسٌ وَخِندِفُ بَينَها","عَصا الحَربِ ما أَوجَفتَ فيها مَعَ الرَكبِ",1,"ب",1,0],["لَئِن وَصَلَت سَلمى حِبالَ مَوَدَّتي","فَإِنَّ وَشيكَ البَينِ لاشَكَّ قاطِعُ",2,"ع",1,0],["لَئِن وَهَبتُكَ نَفساً لا نَظيرَ لَها","فَما سَمَحتُ بِها إِلّا لِواهِبِها",3,"ب",3,0],["لئن ودَّعتُ جهلي غير قولي","ألا سُقيتْ معاهدُنا القِدامُ",4,"م",1,0],["لَئِنْ وَتَرَتْ كَفِّي سعيدَ بنَ هاشمٍ","فقد نالَ من شِعْري بغارَتِه الوِترا",5,"ر",2,0],["لَئِن وَهى عِقدُ السَحابِ الثَمين","فَلا عَدا رَبعَكِ يا مارِدين",6,"ن",1,1],["لَئِن وجدتُكِ عَنّي غيرَ نابيَةٍ","فإنّ نفسيَ منها ربُّها فطرك",7,"ك",1,0],["لئن وفدت غياط دمشق عجلى","لقد خفت بلبنان الهضاب",8,"ب",1,0],["لَئِن وَجَدوا السِهامَ وَهُنَّ شَتّى","فَما وَجَدَ الرَمِيُّ سِوى الحِمامِ",9,"م",1,0],["لَئِن وَجَبَ الحِلمُ عَمَّن أَساءَ","فَإِنَّ دِفاعَ الأَذى أَوجَبُ",10,"ب",1,0],["لَئِن واصَلتَ يا موسى مُحِبّاً","لَقَد أَحيَيتَ يا عيسى رَميما",11,"م",2,0],["لئن وثق الجمهور خالقاً","فرب حكيم بينهم غير واثق",12,"ق",1,0],["لَئِنْ وردْتُ سُهَيْلاً غِبَّ ثالِثةٍ","لَتَقْرَعَنَّ عليَّ السِّنَّ مِن نَدمِ",13,"م",1,0],["لين وفيه ليَّان","واعجباً يا غطفان",14,"ن",1,0],["لَئِن وَجَدوا الثَباتَ لَهُم عَدُوّاً","لَقَد وَجَدوا الفِرارَ لَهُم صَديقا",15,"ق",2,0],["لَئِن وَضَعَت عَنها الجِيادُ سُروجَها","لَقَد أُسرِجَ الرَأيُ الأَصيلُ وَأُلجِما",16,"م",2,0],["لَئِنْ وَكَفَتْ فيها العُيونُ سَحَائِباً","فَعَنْ بَارِقَاتٍ لُحْنَ مِنْها لِشَائِمِ",17,"م",1,0],["لئِنْ وَرَدُوا يُنَشِّطُهم قُدومٌ","لقَد صَدَرُوا يُنَشِّطهم قُفولُ",18,"ل",1,0],["لَئِن وَرَدَ السُمارَ لَنَقتُلَنهُ","فَلا وَأَبيكِ لا أَرِدُ السُمارا",19,"ر",2,0],["لئن وَقَفَتْ بك في الرّقمتين","وَقَفْتَ على بعض أدوائها",20,"ا",3,0],["لينٌ وشدٌّ في المضايقِ شِيمَتي","كبلالِ بنِ مُدافعِ بنِ بِلالِ",21,"ل",1,0],["لئن وترته الحادثات فلم تزل","تبيت الليالي للكرام على وتر",22,"ر",1,0],["لئِنْ وَجَدَتْهُ أَشْأَمَ من قُدارٍ","لقد عَدِمَتْهُ أَخْيَبَ من حُنَيْنِ",23,"ن",1,0],["لئِنْ وَدَّعَتْ مني غَيوراً فإِنَّنِي","عَلَى عَزْمَتِي من شَجْوِها لَغَيُورُ",24,"ر",1,0],["لئن وَحَدَّت للفنانِ دُنيا","فَروُحُكَ وُزعِّت في الخالدات",25,"ت",1,0],["لَينوفَرٌ مِن ذَهَبٍ أَصفَرٍ","في بِرَكٍ مِن ذَهَبٍ أَحمَرِ",26,"ر",1,0],["لئن وَصَلَتْ نجداً ولاحتْ لعينِها","ذُرَى الهَضَباتِ البيضِ زالتْ غمومُها",27,"م",3,0],["لئن وصلتِ بنا يا نوقُ أرضَهمُ","فلا نزلتِ بوادٍ غيرِ معشابِ",28,"ب",1,0],["لئن وصلتك سهواً","لقد هجرتك عمداً",29,"د",2,0],["لئنْ ولَّى وقد لبسَ ازوراراً","فليس يُلامُ في لبسِ ازورارِه",30,"ر",2,0],["لئن وقرت يوما بسمعي ملامة","لهند فلا عفت الملامة في هندِ",31,"د",1,0],["لئِن ودَّعونا فقد أودعونا","غراماً مقيماً وشوقاً نجيا",32,"ي",2,0],["لينور في ظُلَم الردى","وترى الهُدى فيه استبان",33,"ن",1,0],["لئن وقفت شبابي","على مجون وسخف",34,"ف",1,0],["لئن وطدت آباك سؤدد فخرها","فإنك شيدت الفخار الموطدا",35,"د",2,0],["لئن ودَّع الهيجاءَ سيفُك فترةً","فلِلسيفِ عهدٌ بالدِّماء ذنوب",36,"ب",1,0],["لي نور لسدرة الخلد ينمى","ولذا يبهر النواظر نوري",37,"ر",2,0],["لئن ولدت بعيداً","فقد حللت بقلبي",38,"ب",2,0],["لئن وردت شنجيط يوما ظماؤهم","لقد شربوا زعقاً من الموت أكدرا",39,"ر",2,0],["لئن وسع المجدُ المكرَّمُ قدرَه","فكم ضاق عن ما طال في الكون موضع",40,"ع",1,0],["لَئن وَرثوها مُشعلينَ لَرُبَّما","جَعَلتُ لَهُم فَوقَ العَرانينِ ميسَما",41,"م",2,0],["لئن وقفت لنمرٍ كلَّ ديواني","لما استطعت أفيهِ بعض إحسانِ",42,"ن",1,1],["لَئِن وَثِقتَ بِحلمي ساعَةَ الغَضَبِ","خَطَبتَ بي فَأَنا العالي عَلى الخُطَبِ",43,"ب",1,0],["لئن واثبوا الأتراك بغياً فإنما","يمن لهم منذ القديم خيال",44,"ل",1,0],["لَئِن وُضِعَ الخِوانُ وَلاحَ شَخصٌ","لِأَختَطِفَنَّ رَأسَكَ وَالسَلامُ",45,"م",1,0],["لئن وقفت شمس النهار ليوشع","لقد وقفت شمس الهوى لي والشهب",46,"ب",1,0],["لئن وافقتَه قولاً وفعلاً","يُقاد اليكما الصعب الجموح",47,"ح",1,0],["لئن وردت بي ذلك الربعَ أينُفى","ووافى الرجا يزجى إليه بركبه",48,"ب",2,0],["لئن واصلتك المكرمات فقد غدا","لها عن بني الأيام أكثرِهم صدُّ",49,"د",1,0],["لئن وصفوا مجانيناً بأرضٍ","فإن جنونَنا وعيُ المكيدَهْ",50,"د",2,0],["لينوا وهونوا واخضعوا وتذلّلوا","إنّ السياسةَ هكذا فتَعَلّموا",51,"م",3,0],["لئن وجد السرور بمن أتاه","فأنّى لي بغيبته السرور",52,"ر",1,0]]}