{"poems":[[57,"ألا تعجبون كما أعجب","https://www.aldiwan.net/poem26533.html","المتقارب"],[53,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[31,"عفا من آل فاطمة الثريا","https://www.aldiwan.net/poem6027.html","الوافر"],[31,"عفا دير لبى من أميمة فالحضر","https://www.aldiwan.net/poem6041.html","الطويل"],[45,"إلى أي حين أنت في زي محرم","https://www.aldiwan.net/poem10531.html","الطويل"],[47,"تعاط الصبابة أو عانها","https://www.aldiwan.net/poem66802.html","المتقارب"],[30,"أخالد لولا الدين لم تعط طاعة","https://www.aldiwan.net/poem5200.html","الطويل"],[30,"ألم خيال من علية بعدما","https://www.aldiwan.net/poem5318.html","الطويل"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140805",""],[30,"أخالد لولا الدين لم تعط طاعة","https://www.poetsgate.com/ViewPoem.aspx?id=21074",""],[94,"راعها منهُ صَمتُه ووجُومُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14597&r=&rc=42",""],[136,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[147,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[147,"أعد منعما بالعفو روحي إلى جسمي","https://www.aldiwan.net/poem11815.html","الطويل"],[203,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[267,"ألا أيها المهدي هل أنت مخبري","https://www.aldiwan.net/poem68195.html","الطويل"],[333,"يتناهى الأنام والأيام","https://www.aldiwan.net/poem54925.html","الخفيف"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[487,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[518,"علام وقد أذبت القلب شوقا","https://www.aldiwan.net/poem67709.html","الوافر"],[556,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[563,"سواكم روى عنكم سوانا روى عنا","https://www.aldiwan.net/poem33841.html","الطويل"],[563,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18501","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18511","المتقارب"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1377,"","https://poetry.dctabudhabi.ae/diwan/poem/202223","الطويل"],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124280","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20578","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113999","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118390","الوافر"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199814","المسحوب"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198478","الكامل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124776","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131703",""],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145036","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216553",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216547",""],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82830","البسيط"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145144","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102392","الطويل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114437","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125824","الكامل"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139868",""],[4791,"داعي الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28407",""],[4797,"كهربتني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=132232",""],[5186,"يا ناثر النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5198,"طير ياللي","https://www.poetsgate.com/ViewPoem.aspx?id=135068",""],[5199,"سود اليالى","https://www.poetsgate.com/ViewPoem.aspx?id=146777",""],[5401,"هات القلم","https://www.poetsgate.com/ViewPoem.aspx?id=142369",""],[5434,"عجل على المسجد","https://www.poetsgate.com/ViewPoem.aspx?id=37620",""],[5434,"صدر وردوف","https://www.poetsgate.com/ViewPoem.aspx?id=37613",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5956,"سَقامٌ وبيلٌ بعادكِ عني","https://www.poetsgate.com/ViewPoem.aspx?id=193938",""],[6002,"أَلاَ أَيُّهَا الْحَادِي تَرَنَّمْ وَزَمْزِمِ","https://www.poetsgate.com/ViewPoem.aspx?id=210297",""]],"verses":[["وَإِلا تَحَمَّلتُ عَنكَ الذُّنو","بَ وَأَقرَرتُ أَنّي أَنا المُذنِبُ",0,"ب",1,0],["وإلا تأَسِّيْنا مراراً وقولُنا","هو الدهر لا تَبقى عليه الجلامدُ",1,"د",1,0],["وَإِلّا تَذهَبِ الأَيّامُ نَرفِد","جَميلَةَ مِثلَها قَبلَ الفِراقِ",2,"ق",1,0],["وَإِلّا تَصُر أَعرابَ بَكرِ بنِ وائِلٍ","مُهاجِرُها لا يُرعَ إِلٌّ وَلا صِهرُ",3,"ر",1,0],["وَإِلّا تَمُت تَحتَ السُيوفِ مُكَرَّماً","تَمُت وَتُقاسِ الذُلَّ غَيرَ مُكَرَّمِ",4,"م",1,0],["وَإِلّا تَجِدني مُطيعاً لَها","فَلَم أَعصِها كُلَّ عِصيانِها",5,"ن",3,0],["وَإِلّا تَناهَوا تَخطِرِ الخَيلِ بِالقَنا","وَنَدعُ تَميماً ثُمَّ لا نَطَّلِب عُذرا",6,"ر",2,0],["وَإِلّا تُبَلِّغها القِلاصُ فَإِنَّها","سَتُبلِغُها عَنّي بُطونُ الصَحائِفِ",7,"ف",1,0],["وَإِلّا تَكُن تِلكَ الأَمانِيُّ غَضَّةً","تَرِفُّ فَحَسبي أَن تُصادِفَ ذُبَّلا",8,"ل",2,0],["وإلا تمت تحت السيوف مكرماً","تمت وتقاسي الذل غير مكرم",9,"م",1,0],["وَإلاّ تَناهَوْا تَخْطِرِ الخَيْلُ بالقَنا،","وَنَدْعُ تَميماً ثمّ لا نَطّلِبْ غُذْرَا",10,"ر",2,0],["والاتشفْ من فمي الأناشيدَ شكرى َ،","فالهوى ساحرُ الدلالِ، وسَيمُه",11,"م",2,0],["وَإِلاَّ تُضَيِّعهَا زَعَازِعُ صَرصَرٍ","مِنَ الشِّعرِ لاَتُثنَى لِصَولَة ثَانِ",12,"ن",1,0],["وَإِلّا تَأَمَّل حُرَّ وَجهِيَ هَل تَرى","بِصَفحَتِهِ إِلّا لِجودِكَ ميسَما",13,"م",2,0],["وَإِلّا تُعِدها خُلطَةً تَكبِتُ العِدى","عِدايَ وَتُجريني لَدَيكَ عَلى رَسمي",14,"م",2,0],["وإلا تُعينا على سلوةٍ","فصبراً على الأعينِ النُعسِ",15,"س",1,0],["وإلَّا تَدَعنِي والهُمُومُ تَنُوبُنِي","وقَلبي مِنَ العلجَينِ جَمُّ البَلابِلِ",16,"ل",1,0],["والأتيّ العالي من السيل لا يم","نع تهداره حصى أو رجام",17,"م",1,0],["وإلاّ تُحِطْ علماً بأَعلم من بها","فَسَلْ من شجاع القوم عن جوهر النَصل",18,"ل",1,0],["وإلاّ تلافاني بلطفك لم تكد","بوادر حظِّي أن تروح تجاها",19,"ا",3,0],["وإلا تفعلي أنطِقْ بهُجْرٍ","يسوء الودَّ يا ذات النطاقِ",20,"ق",1,0],["وإلا توارى الفتح عنه وأظلمت","عوالمه والله لا غير أمجد",21,"د",1,0],["وألا تبتلى بدنيء قومٍ","فيكثر فيك من قيلٍ وقال",22,"ل",1,0],["وإلّا ترنُّمُ حنّانَةٍ","تئطُّ كما زَفَرَ المِرْجَلُ",23,"ل",1,0],["وَإلّا تَجمّلتمْ على غير خبرةٍ","فكم ذا غَطَى التّحسينُ سوأَةَ زائفِ",24,"ف",1,0],["وإلا تكن في أسر وهمك واقفاً","مع العقل تستدعي السرور أو الحزنا",25,"ن",2,0],["والإتصال ربه لا يعزل","عنه يوليه عليه فاعقلوا",26,"ل",3,0],["وَإِلّا تَناوَلهُنَّ مِنكَ بِرَحمَةٍ","يَكُنَّ سَبايا وَالبُعولَةُ أَعبُدا",27,"د",2,0],["وَأَلّا تَزالَ تُبَكّي لَهُ","وَتَبتَلَّ بِالدَمعِ أَشفارُها",28,"ر",3,0],["والآتيين بعرش بلقيس كما","بهما سليمان اصطفى بلقيسا",29,"س",2,0],["وإلا تغاديني المنية أغشكم","على عدواء الدهر جيشا لهاما",30,"م",2,0],["والا تنازعنا القريض وحكّموا","لنا حكما بين القصائد يحكم",31,"م",1,0],["وَإِلا تَكُن إِلّا لِساني فَإِنَّهُ","بِحُسنِ الَّذي أَسدَيتَ عَني لَناطِقُ",32,"ق",1,0],["وَإلّا تكُن نجلَ المهاةِ فإنَّها","وإيّاهُ مِمّا أُرضِعا بلِبانِ",33,"ن",1,0],["وإلا ترجعن لنا جواباً","فإنا بالجواب لعارفونا",34,"ن",2,0],["وآلات الحروب معاً بدعنا","وفينا سنة المتبارزينا",34,"ن",2,0],["وإلا تُكَفْكِفْهُ شيئاً يُضَرِّجْ","جآجِئَها والغصونَ اللدانا",35,"ن",2,0],["والا تزدجر عما عليه","جبلت من التهور والصبيل",36,"ل",1,0],["والاّ تشرّف به حسين التثنّي","عنق الرّشا عين الخفوق النّداوي",37,"ا",3,0],["وَالإِتِّبَاعُ بِدُونِ شَرعِ رَسُولِهِ","عَينُ المُحَالِ وَأبطَلُ البُطلاَنِ",38,"ن",1,0],["والإتّحادُ الحرُّ شمسُ مفاخرٍ","وملاحِمٌ تُروى بكلِّ لِسانِ",39,"ن",1,0],["والإتّحادُ الحقُّ قد دعّمتَهُ","بتآلُف وتقارُبٍ وَتَدانِ",39,"ن",1,0],["وإلا تكن تأثم ببذل جميعه","ويكره تضييق لغير المعوّد",40,"د",1,0],["والاتكاء حالة الأكل اترك","ما أكل النبي وهو متكي",41,"ي",1,0],["والا تأملت في الطير","عليش صفق جناحه",42,"ه",1,0],["وآلاتها معروضة في خزائن","زجاجية للقافلات الجوائل",43,"ل",1,0],["والا تَفتَخِر بِبَني كُلَيبٍ","فَما كانوا الصَريحَ وَلا اللُبابا",44,"ب",2,0],["والاتحاد إن ضَاعْ نِفْتَضْ","وِنْضيع مِ الدنيا وْلِوْجود",45,"د",1,0],["والّا تْوافِق يوم لَشْمال","بآنِذبحه راسك بسكّين",46,"ن",1,0],["وَالاتِّحادُ قُوىً لا يُستَهانُ بِها","تَعنو لها قوّةُ البَتّارِ وَالأَسَلِ",47,"ل",1,0],["والاتحاد هو الدواء ولم يكن","بالمستحيل لو اختفت أطماع",48,"ع",1,0],["وألا تني يا أم عمرو نميمة","تدب بها بيني وبينك عقرب",49,"ب",1,0],["والاتفاقية غيرها كمن","يصل إلينا يستعن بنا يعن",50,"ن",1,0],["والآتِ عَن حَسَنٍ لا شاهِدٌ لَهُمُ","فيهِ كما في ابي السعودِ وهو سني",51,"ن",2,0],["والاتحاديون في أقطابهم","كادوا وكدت فكان كيدُك غالبا",52,"ب",2,0],["وألا تراني عندما قد كرهته","لكونك في قلبي كبيراً معظما",53,"م",2,0],["وإلاّ تكون جروح قلبي عطيبه","وتسمع نداه إلى تضايق وناداك",54,"ك",1,0],["والا ترى بتعبك وأعلن تحديك","وأشوف قلبك بيتحمل حلايا",55,"ا",3,0],["والإتحاد تمزق بتفرق...","والإعتدال تهور بتهوس",56,"س",1,0],["والا تعالي من علوك سحابة","الياانتشا عطر المسا تستهلي",57,"ل",2,0],["والا تقول انك مع الراى الصواب","وغيرك خطاء لن النجاح اخو الفشل",58,"ل",1,0],["والا ترحل بي على ذات الأكباس","بوينق ماهي من طراز الجماحي",59,"ح",2,0],["والا ترى الدنيا حدود مسماه","لابد مايقفي وتقفي زروعه",60,"ع",2,0],["والا ترى قلبي ليا اصطك بالجوف","اومى بحالي لين تابس عصاها",61,"ا",3,0],["والأتقياء جنان الخلد تفرحهم","فازوا بروضتها والله قد سرّوا",62,"ر",3,0],["وإلا تزوجتُ أخرى سواكِ","تُمزق عني شرانق جُبْني",63,"ن",2,0],["وَإِلاَّ تَرَنَّحْ بِالأَغَانِي وَغَنِّ لي","وَدَنْدِنْ وَرَجِّعْ بِالْمَثَانِي وَهَيْنِمِ",64,"م",1,0]]}