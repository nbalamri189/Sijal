{"poems":[[94,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[94,"سر مع الدهر لا تصدنك","https://www.aldiwan.net/poem38962.html","الخفيف"],[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[87,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[87,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[107,"وفد الفارس الذي تفرق الأب","https://www.aldiwan.net/poem44008.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[87,"كلُّ حيٍّ على المنية غادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9597&r=&rc=87",""],[87,"سينية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71542&r=&rc=239",""],[94,"قضَّيتُ أدْوارَ الحياة ِ، مُفَكِّراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14594&r=&rc=39",""],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[276,"كل شيء منكم عليكم دليل","https://www.aldiwan.net/poem52133.html","الخفيف"],[280,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[367,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[376,"سر مع الوجد والأسى في طريق","https://www.aldiwan.net/poem57258.html","الخفيف"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[422,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[438,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[449,"سر مسرعا ليس يغني الناس ما علموا","https://www.aldiwan.net/poem55923.html","عموديه"],[466,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[563,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39018","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64973","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136130","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136100","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112960","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77817","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101048","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71039","الكامل"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114989","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93582","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87789","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93852","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201253","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202726","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87368","الخفيف"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123937","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205706","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34575","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103038","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141571","البسيط"],[4578,"قلبٌ بنار الأسى والوجد حرانُ","https://www.poetsgate.com/ViewPoem.aspx?id=49529",""],[4888,"نجمان هما أمي وابي","https://www.poetsgate.com/ViewPoem.aspx?id=207727",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5183,"الِّلثَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186447",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5387,"لغة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=53821",""],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5431,"نظرةٌ تُحيي تُذيب","https://www.poetsgate.com/ViewPoem.aspx?id=183475",""],[5431,"لانهائي العشقِ منك ابتداءُ..","https://www.poetsgate.com/ViewPoem.aspx?id=197606",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""]],"verses":[["سرْ مَا اسْتَطَعْتَ فَسَوْفَ تُلفِي مثلما","خلَّفتَ مَمشُوقَ الغُصونِ حَطيما",0,"م",2,0],["سِرْ مَعَ الدَّهْرِ لا تَصُدَّنَّكَ","الأَهوالُ أَو تُفْزِعَنَّكَ الأَحداثُ",1,"ث",1,1],["سِرْ مَعَ الدَّهْرِ كيفما شاءتِ","الدُّنيا ولا يخدعنَّكَ النَّفَّاثُ",1,"ث",1,0],["سرَّ مصراً منها أجد طرازٍ","حسب مصر ذاك الطراز الأجد",2,"د",1,0],["سرّ مضى الموتى به","ومضت على الموتى الدهور",3,"ر",1,0],["سِر مَعَ العُمرِ حَيثُ شِئتَ تَأوبا","وَاِفقُدِ العُمرَ لا تَأُب مِن رُقادِ",4,"د",1,0],["سَرمَدُ الحُسنِ وَالبَشاشَةِ مَهما","تَلتَمِسهُ تَجِدهُ في إِبّانِه",5,"ن",2,0],["سَرمَدٌ شَيبُهُ وَلَم أَرَ شَيباً","قَبلَهُ يُرجى البَقاءَ وَيُنسي",6,"س",2,0],["سِرْ معي ننظُر الذي رَاحَ يَنْهَى","أن تُقامَ الأصنامُ والأوثانُ",7,"ن",1,0],["سَرَّ مَا سَرَّ مِنْ قُلُوبٍ وَأَجْلَى","عَنْ سَمَاءِ الصَّفاءِ كُلَّ ارْبِدَادِ",8,"د",1,0],["سرْ معَ العمرِ حيثُ شئتَ تؤوبا","وافقد العمر لا تؤبْ من رقاد",9,"د",1,0],["سرمد شيبه، ولم أر شيئاً","قبله يرجى البقاء وينسي",10,"س",2,0],["سرْ ما اسْتَطَعْتَ، فَسَوْفَ تُلقي مثلما","خلَّفتَ مَمشُوقَ الغُصونِ حَطِيما",11,"م",2,0],["سر من الله بدا كل من","يشهد لله له يشهد",12,"د",1,0],["سِرٌّ مِنَ الرحْمَانِ لاَ","سِرٌّ منَ السُّلْطانِ أَخْمَدْ",13,"د",1,0],["سِر مُنجداً ومدرباً قدّامَها","لتسيرَ خلفَكَ وهي بحرٌ يزخر",14,"ر",1,0],["سرمدى البقا أَخير قديم","قصرت عَن مَدى علاه العقول",15,"ل",1,0],["سَرْمَداً أَحمِل خَطْباً آدَنِي","وَبِخَطبِي الإِدُّ فيهِ سَمَدا",16,"د",2,0],["سِر مُنقَلِبًا حتى تَبقى","في نَظَرِ العالَمِ محبوبا",17,"ب",2,0],["سِر مَع الوَجدِ والأَسى في طَريقِ","فَقَليلٌ سُلوكُها لِلمَشوقِ",18,"ق",1,1],["سر مسير الحَبوه","لا تن بالحِبوه",19,"ه",1,0],["سرٌّ من الله إلاَّ أنَّ نورهم","في الخافقين وما صبحٌ بمستتر",20,"ر",1,0],["سر مجدّاً الى طِلابِ المعالي","فوقَ ظهرِ السّواهمِ الأنقاضِ",21,"ض",1,0],["سر مسرعا ليس يغني الناس ما علموا","كم معجزات بدت من فكر مجتهد",22,"د",1,1],["سرٌّ من الله محمودٌ خصصتَ به","ذلَّتْ له العربُ العرباءُ والعَجمُ",23,"م",1,0],["سر من الغيب سار في سريرة من","له يريد بلا سعي ولا سبب",24,"ب",1,0],["سِرٌّ من الحُسْنِ لو يُجلَى سَناهُ عَلى","أعْمَى لأبصرَ ما قَدْ وارَتِ الحُجُبُ",25,"ب",1,0],["سِرْ مُوقَّىً مِمَّا تَخافُ مُهَنَّاً","بفُتوحِ البلادِ سَهْلاً وحَزْناً",26,"ن",2,1],["سر ما قد رأيت خاف ولكن","رب معنى في سره ما حيكت",27,"ت",1,0],["سر مع الاسم في غريب التداني","وكن الوصف غايبا في المغيب",28,"ب",1,0],["سر معافا حادي الظعن بنا","قاصداً أهل النوال والسنا",29,"ن",2,1],["سر مكنون أَهل جيرون جاءَت","بالقبا وَالقَضيب وَالمفتاح",30,"ح",1,0],["سر مع اللَه آمناً كل سوء","من زمان أو من عدو غشوم",31,"م",1,0],["سِرٌّ من الأَسرار إِلا أَنَّه","هو بالذي أَضْمَرْتُ منْي أَعْلَمُ",32,"م",1,0],["سرَّ من عاشَ مالهُ فإذا حا","سبَهُ اللَهُ سرَّهُ الإعدامُ",33,"م",1,1],["سر مَعي حَيث أَكاويب الهَنا","قَد تَهادوهن مِن ناد لِناد",34,"د",1,0],["سِرٌّ مَضى بِكَ لَم يَزَل","صَعباً عَلى العلم اِكتِشافه",35,"ف",2,0],["سِرٌّ مِن العالم العُلويِّ ضمِّنَه","جسمٌ مِن الجَوهر الأَرضيِّ مَجبولُ",36,"ل",1,0],["سر من الأسرار يحجب نوره","عن جاهل ما كان يدري الحكمه",37,"م",2,0],["سر موتي جسمي سآمن موتي","حين أفني جسمي وأصبح روحا",38,"ح",2,0],["سِرْ من بني غسان للنعمان","وانظره مع كسرى أنو شروان",39,"ن",1,0],["سرّ منا الأرواحَ كلَّ سرورٍ","كلَّفت في اظهارِهِ الاجسادا",40,"د",2,0],["سر معافى كما تشا","ناعم البال والكنف",41,"ف",1,0],["سرِمَت بقلبكَ وانتهت","وكذاكَ امواهُ الدموعِ",42,"ع",1,0],["سرٌّ من الله في رُوحيْن ما برحا","من قبل لقياهما يرعاهما الله",43,"ه",1,0],["سُرَّ من را أسرُّ من بغدادِ","فالهُ عن بعض ذكرها المُعتادِ",44,"د",1,1],["سرّ مصون من ألست بربّكم","بحرٌ خضمّ دأبه الإعطاء",45,"ا",2,0],["سر من الأسرار لا يأتي به","أحد فلا وحى ولا إيحاء",45,"ا",2,0],["سر مسراه للأمور ملاك","وهلاك للمال والحساد",46,"د",1,0],["سَرمَدِيُّ البَقاءِ يَحكُمُ في المَو","تِ وَيَبقى عَلى بَقاءِ البَقاءِ",47,"ا",2,0],["سرّ مَوتي كانَ يَومَ اِنتِهابي بَينَ","ذَقنِ الخرا وعين الحصانِ",48,"ن",1,0],["سر ما في الحَياة مِن لَيلِها الطا","مي وَلجى فَجرَها الوَضاء",49,"ا",2,0],["سَرْ مضرب الأرض في طول وفي عرض","ترى النساء يبعن العرض كالعرض",50,"ض",1,1],["سرٌّ من الله قد أحيا الأنام به","إن كان يبدو لسر الله إعلانُ",51,"ن",1,0],["سِرْ مَعَ كُلِّ ذَكِيٍّ واجْعلْ","نَجْمَكَ سَبَّاقًا كالشُّهُبِ",52,"ب",1,0],["سَرْمَدِيُّ صَرْحُ دِيِنِي","رَقَّ وَجْدِي صُرْتُ حُرَّا",53,"ر",2,0],["سِرْ مُغِذّا لتبلغ القصد جِداًّ","وتحاذي المرام حيث لِقاها",54,"ا",3,0],["سَرّ مينى أهيم فيه بما ض","يِّ فقد كان للجلال سِناما",55,"م",2,0],["سرُ مجهولُ يجمعنا","يمزج روحينا في الشفقِ",56,"ق",1,0],["سر من الغيب صدر الدهر ضاق به","وسعا ولكن بماضي عدله اتسعا",57,"ع",2,0],["سرمديٌ جلَّ كنههْ","راحمٌ مني قريبْ",58,"ب",1,0],["سرمدي الهوى وفيك انتمائي","لانهائي العشقِ منك ابتداءُ",59,"ا",2,0],["سر من العالم العلوي ضمنه","جسم من الجوهر الأرضي محمول",60,"ل",1,0],["سرمدي الإشراق في أفق قدسٍ","يستمد الوجود منك وجودا",61,"د",2,0],["سِرٌّ مِنَ الرَحمَنِ لا","شَرٌّ مِنَ السُلطانِ أَخمَدَ",62,"د",1,0]]}