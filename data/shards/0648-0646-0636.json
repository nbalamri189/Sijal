{"poems":[[63,"قضت وطرا مني النوى وتخاذلت","https://www.aldiwan.net/poem45787.html","الطويل"],[63,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[63,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[35,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[88,"قالوا نخلد ذكره بحديقة","https://www.aldiwan.net/poem44396.html","الكامل"],[88,"من كان يأرق بالهموم","https://www.aldiwan.net/poem44437.html","مجزوء الكامل"],[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[23,"نصرنا رسول الله والدين عنوة","https://www.aldiwan.net/poem21586.html","الطويل"],[72,"لا وعيش اللقاء ما لدموعي","https://www.aldiwan.net/poem19164.html","الخفيف"],[51,"عبثت به الحمى فورد جسمه","https://www.aldiwan.net/poem64093.html","الكامل"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[45,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[66,"رقصوا فقام الحرب واشتبك القنا","https://www.aldiwan.net/poem39232.html","الكامل"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85369","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125674","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[35,"تظلُّ ابنة ُ الضَّمريِّ في ظلِّ نعمة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22010",""],[132,"هاج ما اكتن من دفين الدار","https://www.aldiwan.net/poem54898.html","البسيط"],[166,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[237,"هي الدنيا يغر بنا سناها","https://www.aldiwan.net/poem19730.html","الوافر"],[261,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[270,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[298,"ما لها تشرق حمرا أتراها","https://www.aldiwan.net/poem36835.html","عموديه"],[322,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[328,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[357,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[366,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[396,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[416,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[429,"في يوم قلعة جندل","https://www.aldiwan.net/poem40755.html","مجزوء الكامل"],[432,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[432,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[432,"مولاي أمرك قد تقدم","https://www.aldiwan.net/poem12729.html","مجزوء الكامل"],[477,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[479,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[514,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[515,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[567,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[587,"أعلى المنازل إذ عفت أعلامها","https://www.aldiwan.net/poem11516.html","عموديه"]],"verses":[["وَنِضوي لِذاتِ الضَّالِ قالٍ وَبالنَّقا","شَجٍ وَعَلى وادي الأَراكَةِ ناشِزُ",0,"ز",1,0],["ونَضا وَزيرُكَ عَزْمةً عَرَبيّةً","نَبَذَتْ إليكَ الأمرَ وهْوَ وَثيقُ",1,"ق",1,0],["ونَضا وَزيرُكَ دونَ مُلْكِكَ عَزْمَةً","تَكْفيهِ نَهْضَةَ فَيلَقٍ شَهباءِ",2,"ا",2,0],["ونُضحي وَأثباجُ المضيّ مَقِيلُنا","بِجَذبٍ بنا في الصَيهَدِ المُتَوَقِّدِ",3,"د",1,0],["ونضيفها في التسميات إلى اسمه","حتى يكون له بها تذكار",4,"ر",1,0],["ونضحن من ماء الحيا","ة عليه في شنب الثغور",5,"ر",1,0],["وَنَضّاحِ المَقَذِّ تَرى المَطايا","عَشِيَّةَ خِمسِهِنَّ لَهُ ذُنابى",6,"ب",2,0],["وَنضخِيَ إِيّاهُ التَقِيَّاتُ مِنهُم","أُدَاجِي عَلَى الدَّاءِ المُرِيبِ وأَدمُلُ",7,"ل",1,0],["وَنَضرِبُ هامَ الدارِعينَ وَنَنتَمي","إِلى حَسَبٍ مِن جِذمِ غَسّانَ قاهِرِ",8,"ر",1,0],["ونضوا في حماه هيبة ملكٍ","يستردّ العاصي مردّ المطيع",9,"ع",1,0],["ونضاه بَنْثره فجاء كعصفرٍ","قد رُشَّ رشاً في بياض حرير",10,"ر",1,0],["وَنَضحَكُ لِلآمالِ ضِحكَةُ وامِقٍ","فَيَضحَكُ مِنّا الدَهرُ ضِحكَةَ ساخِرِ",11,"ر",1,0],["وَنَضا مِنَ الأَجفانِ سَي","فاً قَلَّ ما يَبقى جَريحُه",12,"ح",2,0],["وَنَضا غِرارى سَيفِهِ لِيُوَقِّيا","طَرَفَيهِمِ عَن كُلِّ خَطبٍ مُؤيِدِ",13,"د",1,0],["وَنَضرِبُهُ حَتّى اِطمَئَنَّ قَذالُهُ","وَلَم يَطمَئِنَّ قَلبُهُ وَخَصائِلُه",14,"ل",2,0],["وَنَضَوا مِنَ السودِ المِراضِ صَوارِماً","بيضاً فَلَم نَعلَم عَلَينا أَم لَنا",15,"ن",2,0],["ونضيرِ الحقول والعشب المخض","ل يكسو شواطئ الأنهارِ",16,"ر",1,0],["ونضرةَ عيشٍ كان همّيَ جامداً","بِهِ حَيثُ تَبري في الزجاجَةِ سَيّالُ",17,"ل",1,0],["وَنَضرَةُ الوَجهِ يَستَغنِي النَّدِيمُ بهَا","عَنِ المُدَامِ وَعَن رَوضٍ مِنَ الزَّهَرِ",18,"ر",1,0],["ونَضَتْ بَزْوَةٌ فرابغُ فالجُحْ","فَةُ عنها ما حاكه الإِنضاءُ",19,"ا",2,0],["ونضا فجْرُهُ على نَسْرِهِ ال","واقعِ سيْفاً فهَمّ بالطّيَرانِ",20,"ن",1,0],["وَنضالاً عَن الحَياة شَديداً","طالَ حَتّى سئمت ذاكَ النضالا",21,"ل",2,0],["وَنضا عليك السيف يضرب مجهزاً","دهر فَلَم تجزع من السياف",22,"ف",1,0],["ونضيرِ الحقول والعشب المخضل","ل يكسو شواطئ الأنهارِ",23,"ر",1,0],["ونضَّتْ مِن غلائِلها","وألقتها على الصَّخرِ",24,"ر",1,0],["ونِضالي في جَنِبكَ النَّاسَ يَر","مُونَ وأَرمي وكُلُّنا غيرُ آلِ",25,"ل",1,0],["وَنَضا اللِّثَامَ فَأَشْرَقتْ","شَمْسٌ أَشِعَّتُهَا ضَفَائِر",26,"ر",1,0],["ونضحَكُ للدنيا اللعوبِ وزُورِها","ونمرَحُ في زَهْوِ الشباب ونرتَع",27,"ع",1,0],["ونضيرُ ألفاظٍ كأزهارِ الرُّبا","يبسِمن غِبَّ العارِضِ السَّحَّاحِ",28,"ح",1,0],["وَنَضْحك من آمالِنا كيف أنَّها","أَصَاخَتْ إلى وَعْدِ الزَّمان المُلَفِّقِ",29,"ق",1,0],["ونَضَتْ ستائرَ مخدعيها، تشتكي","من طولِ ليلٍ، واحتجاب نهار",30,"ر",1,0],["ونضَوْتُ أثوابي بها","واعتضتُ عنها بالمآزر",31,"ر",1,0],["ونضّر في حوران سهلا وشاهقا","وباكر بالنّعمى غنّيا ومتربا",32,"ب",2,0],["ونُضحي وأثباجُ المطيِّ مقيلُنا","بجذبٍ بنا في الصَّيهدِ المتوقِّدِ",33,"د",1,0],["وَنضَا الصبرَ والعزاءَ وأذكَى","نَارَ بَرحِ الأحزَانِ في الأحشاءِ",34,"ا",2,0],["ونَضا سرابيلَ المذلّة جارها","واجتابَ غرّاً سابغَ الأبرادِ",35,"د",1,0],["وَنَضَّرَ مَضْجِعاً لِفَتَاةِ صِدْقٍ","حَوَى غُرَرَ الْفَضَائِلِ إِذْ حَوَاهَا",36,"ا",3,0],["ونضوت بالنعمى لباس","البؤس والنعمى تزين",37,"ن",1,0],["ونضربُهُم ضرباً بما ضرَبوا بهِ","ونرشُقُهم رشقاً دَراكاً مُشرشرا",38,"ر",2,0],["وَنضرِبُ ضَربَ اليائسين بثأرِنا","لترحبَ أرضٌ أو يضيقَ فضاء",39,"ا",2,0],["وَنَضَتْ أثوابها الحمرَ عَلى","جنباتِ الأُفقِ واستبقتْ حلاها",40,"ا",3,0],["وَنَضرِبُ مَن تَعَرَّضَ مُوضِحاتٍ","عَلانِيَّةً جِهاراً غَيرَ غُطشِ",41,"ش",1,0],["ونضَت حواء عن","خبتها مثل السراب",42,"ب",1,0],["ونضا آدم عن صح","رائه مثل السحاب",42,"ب",1,0],["وَنَضَا عِزّتَهُ فِي حَربِكُمُ","فَاكتَسَى مِن ذلّةٍ مَا أُلبِسَا",43,"س",2,0],["وَنَضنَضَ في كَفِّ المُديرِ لِسانُها","فَما قالَ أَو كانَ القَذالُ لَهُ فَما",44,"م",2,0],["ونضرب رأس الكبش في حومة الوغى","وتحمدنا أشياعنا في المشارِق",45,"ق",1,0],["ونضحك آمنين ولو عقلنا","لحقَّ لنا التَّغابن والبكاء",46,"ا",2,0],["ونضت بوادي الشيخ من","مخلابها سيفاً محد",47,"د",1,0],["ونضَا مُحَيَّاهُ الدياجيَ فازْدَهَتْ","تِيهًا بُغرَّةِ وجهه الأَزِمانُ",48,"ن",1,0],["ونضَتْ حُلّةَ الغَمامِ عن الأفْ","قِ رُبىً في غلائلٍ أفوافِ",49,"ف",1,0],["ونضير منثورٍ يُشوّ","قُني الأسورُ والمَخدّمْ",50,"م",1,0],["ونضا قميصَ الصبرِ عنه حنينُه","وولوعُه بسنا البروقِ اللمّعِ",51,"ع",1,0],["ونضوت من غمد الوظيف حسامكم","فخذوه منطقا بقوة قادر",52,"ر",1,0],["ونَضوا السّيوفَ فقلتُ غُرُّ مَلائِكٍ","هزّتْ يَدَيْها أنيبُ الأغوالِ",53,"ل",1,0],["ونضت يمين الله منه صارماً","عاداته تفليق هام الفيلق",54,"ق",1,0],["وَنَضَّدْنَا عَلَيْهِ نَعْ","نَعَ البَقْلِ وَطَرْخُونَهْ",55,"ن",2,0],["ونضيد ثغر كالأقاحي أزهرت","في حر رمل أقلعت أرهامها",56,"م",3,0]]}