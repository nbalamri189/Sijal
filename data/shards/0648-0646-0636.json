m/127933","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105174","الكامل"],[4830,"لاكأسٌ ولا خِلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=208983",""],[4927,"الشبيح الصفوي","https://www.poetsgate.com/ViewPoem.aspx?id=80796",""],[5144,"لولا تعرض ذكر من سكن الغضا","https://www.poetsgate.com/ViewPoem.aspx?id=181815",""],[5198,"سمو النبض","https://www.poetsgate.com/ViewPoem.aspx?id=135067",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""],[5725,"شيخ المتظاهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198883",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5848,"نسولف !!","https://www.poetsgate.com/ViewPoem.aspx?id=49002",""],[5909,"ونُضفي على ذاك التعلق باللقا","https://www.poetsgate.com/ViewPoem.aspx?id=210582",""],[2575,"روضة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=10282",""],[6149,"لولا ادكاري في العذيب لقده","https://www.poetsgate.com/ViewPoem.aspx?id=169623",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[2638,"طيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87870&r=&rc=27",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["وَنِضوي لِذاتِ الضَّالِ قالٍ وَبالنَّقا","شَجٍ وَعَلى وادي الأَراكَةِ ناشِزُ",0,"ز",1,0],["ونَضا وَزيرُكَ عَزْمةً عَرَبيّةً","نَبَذَتْ إليكَ الأمرَ وهْوَ وَثيقُ",1,"ق",1,0],["ونَضا وَزيرُكَ دونَ مُلْكِكَ عَزْمَةً","تَكْفيهِ نَهْضَةَ فَيلَقٍ شَهباءِ",2,"ا",2,0],["ونُضحي وَأثباجُ المضيّ مَقِيلُنا","بِجَذبٍ بنا في الصَيهَدِ المُتَوَقِّدِ",3,"د",1,0],["ونضيفها في التسميات إلى اسمه","حتى يكون له بها تذكار",4,"ر",1,0],["ونضحن من ماء الحيا","ة عليه في شنب الثغور",5,"ر",1,0],["وَنَضّاحِ المَقَذِّ تَرى المَطايا","عَشِيَّةَ خِمسِهِنَّ لَهُ ذُنابى",6,"ب",2,0],["وَنضخِيَ إِيّاهُ التَقِيَّاتُ مِنهُم","أُدَاجِي عَلَى الدَّاءِ المُرِيبِ وأَدمُلُ",7,"ل",1,0],["وَنَضرِبُ هامَ الدارِعينَ وَنَنتَمي","إِلى حَسَبٍ مِن جِذمِ غَسّانَ قاهِرِ",8,"ر",1,0],["ونضوا في حماه هيبة ملكٍ","يستردّ العاصي مردّ المطيع",9,"ع",1,0],["ونضاه بَنْثره فجاء كعصفرٍ","قد رُشَّ رشاً في بياض حرير",10,"ر",1,0],["وَنَضحَكُ لِلآمالِ ضِحكَةُ وامِقٍ","فَيَضحَكُ مِنّا الدَهرُ ضِحكَةَ ساخِرِ",11,"ر",1,0],["وَنَضا مِنَ الأَجفانِ سَي","فاً قَلَّ ما يَبقى جَريحُه",12,"ح",2,0],["وَنَضا غِرارى سَيفِهِ لِيُوَقِّيا","طَرَفَيهِمِ عَن كُلِّ خَطبٍ مُؤيِدِ",13,"د",1,0],["وَنَضرِبُهُ حَتّى اِطمَئَنَّ قَذالُهُ","وَلَم يَطمَئِنَّ قَلبُهُ وَخَصائِلُه",14,"ل",2,0],["وَنَضَوا مِنَ السودِ المِراضِ صَوارِماً","بيضاً فَلَم نَعلَم عَلَينا أَم لَنا",15,"ن",2,0],["ونضيرِ الحقول والعشب المخض","ل يكسو شواطئ الأنهارِ",16,"ر",1,0],["ونضرةَ عيشٍ كان همّيَ جامداً","بِهِ حَيثُ تَبري في الزجاجَةِ سَيّالُ",17,"ل",1,0],["وَنَضرَةُ الوَجهِ يَستَغنِي النَّدِيمُ بهَا","عَنِ المُدَامِ وَعَن رَوضٍ مِنَ الزَّهَرِ",18,"ر",1,0],["ونَضَتْ بَزْوَةٌ فرابغُ فالجُحْ","فَةُ عنها ما حاكه الإِنضاءُ",19,"ا",2,0],["ونضا فجْرُهُ على نَسْرِهِ ال","واقعِ سيْفاً فهَمّ بالطّيَرانِ",20,"ن",1,0],["وَنضالاً عَن الحَياة شَديداً","طالَ حَتّى سئمت ذاكَ النضالا",21,"ل",2,0],["وَنضا عليك السيف يضرب مجهزاً","دهر فَلَم تجزع من السياف",22,"ف",1,0],["ونضيرِ الحقول والعشب المخضل","ل يكسو شواطئ الأنهارِ",23,"ر",1,0],["ونضَّتْ مِن غلائِلها","وألقتها على الصَّخرِ",24,"ر",1,0],["ونِضالي في جَنِبكَ النَّاسَ يَر","مُونَ وأَرمي وكُلُّنا غيرُ آلِ",25,"ل",1,0],["وَنَضا اللِّثَامَ فَأَشْرَقتْ","شَمْسٌ أَشِعَّتُهَا ضَفَائِر",26,"ر",1,0],["ونضحَكُ للدنيا اللعوبِ وزُورِها","ونمرَحُ في زَهْوِ الشباب ونرتَع",27,"ع",1,0],["ونضيرُ ألفاظٍ كأزهارِ الرُّبا","يبسِمن غِبَّ العارِضِ السَّحَّاحِ",28,"ح",1,0],["وَنَضْحك من آمالِنا كيف أنَّها","أَصَاخَتْ إلى وَعْدِ الزَّمان المُلَفِّقِ",29,"ق",1,0],["ونَضَتْ ستائرَ مخدعيها، تشتكي","من طولِ ليلٍ، واحتجاب نهار",30,"ر",1,0],["ونضَوْتُ أثوابي بها","واعتضتُ عنها بالمآزر",31,"ر",1,0],["ونضّر في حوران سهلا وشاهقا","وباكر بالنّعمى غنّيا ومتربا",32,"ب",2,0],["ونُضحي وأثباجُ المطيِّ مقيلُنا","بجذبٍ بنا في الصَّيهدِ المتوقِّدِ",33,"د",1,0],["وَنضَا الصبرَ والعزاءَ وأذكَى","نَارَ بَرحِ الأحزَانِ في الأحشاءِ",34,"ا",2,0],["ونَضا سرابيلَ المذلّة جارها","واجتابَ غرّاً سابغَ الأبرادِ",35,"د",1,0],["وَنَضَّرَ مَضْجِعاً لِفَتَاةِ صِدْقٍ","حَوَى غُرَرَ الْفَضَائِلِ إِذْ حَوَاهَا",36,"ا",3,0],["ونضوت بالنعمى لباس","البؤس والنعمى تزين",37,"ن",1,0],["ونضربُهُم ضرباً بما ضرَبوا بهِ","ونرشُقُهم رشقاً دَراكاً مُشرشرا",38,"ر",2,0],["وَنضرِبُ ضَربَ اليائسين بثأرِنا","لترحبَ أرضٌ أو يضيقَ فضاء",39,"ا",2,0],["وَنَضَتْ أثوابها الحمرَ عَلى","جنباتِ الأُفقِ واستبقتْ حلاها",40,"ا",3,0],["وَنَضرِبُ مَن تَعَرَّضَ مُوضِحاتٍ","عَلانِيَّةً جِهاراً غَيرَ غُطشِ",41,"ش",1,0],["ونضَت حواء عن","خبتها مثل السراب",42,"ب",1,0],["ونضا آدم عن صح","رائه مثل السحاب",42,"ب",1,0],["وَنَضَا عِزّتَهُ فِي حَربِكُمُ","فَاكتَسَى مِن ذلّةٍ مَا أُلبِسَا",43,"س",2,0],["وَنَضنَضَ في كَفِّ المُديرِ لِسانُها","فَما قالَ أَو كانَ القَذالُ لَهُ فَما",44,"م",2,0],["ونضرب رأس الكبش في حومة الوغى","وتحمدنا أشياعنا في المشارِق",45,"ق",1,0],["ونضحك آمنين ولو عقلنا","لحقَّ لنا التَّغابن والبكاء",46,"ا",2,0],["ونضت بوادي الشيخ من","مخلابها سيفاً محد",47,"د",1,0],["ونضَا مُحَيَّاهُ الدياجيَ فازْدَهَتْ","تِيهًا بُغرَّةِ وجهه الأَزِمانُ",48,"ن",1,0],["ونضَتْ حُلّةَ الغَمامِ عن الأفْ","قِ رُبىً في غلائلٍ أفوافِ",49,"ف",1,0],["ونضير منثورٍ يُشوّ","قُني الأسورُ والمَخدّمْ",50,"م",1,0],["ونضا قميصَ الصبرِ عنه حنينُه","وولوعُه بسنا البروقِ اللمّعِ",51,"ع",1,0],["ونضوت من غمد الوظيف حسامكم","فخذوه منطقا بقوة قادر",52,"ر",1,0],["ونَضوا السّيوفَ فقلتُ غُرُّ مَلائِكٍ","هزّتْ يَدَيْها أنيبُ الأغوالِ",53,"ل",1,0],["ونضت يمين الله منه صارماً","عاداته تفليق هام الفيلق",54,"ق",1,0],["وَنَضَّدْنَا عَلَيْهِ نَعْ","نَعَ البَقْلِ وَطَرْخُونَهْ",55,"ن",2,0],["ونضيد ثغر كالأقاحي أزهرت","في حر رمل أقلعت أرهامها",56,"م",3,0],["ونضوب كفك بعدما سالت لها","كمنابع منها يفيض الجود",57,"د",1,0],["وَنَضر الزَرع فَاخضرت لَفائفه","وَاِنبَثَ في الأَرض آكاما وَوديانا",58,"ن",2,0],["ونضرب في بلاد الله حتى","نرى أيامنا خضر الحواشي",59,"ي",1,0],["وَنضحَكُ نضحَك حَدَّ البُكاء","وَحَدَّ التشفّي بمَا يُضمِرونْ",60,"ن",1,0],["ونضرة الزهر غضا","وخيمة الناظورِ",61,"ر",1,0],["ونضا الشيب فوق رأسي سيفا","لم أطعه وقد غدا مسلولا",62,"ل",2,0],["وَنضحكُ منكمُ عَجَباً وَتِيهًا","وَنَجْزِيكُمْ بِمَا أسْلَفْتُمُونَا",63,"ن",2,0],["وَنَضَا اللَّحْظَ فِي الجُفُونِ حُسَاماً","جَازَ فِي الحَدّ عَنْ نِهَايَةِ حَدّهْ",64,"د",2,0],["ونضَتْ يدُ الإصباحِ من غِمدِ الدّجى","سيفّاً فمزَّقَ دولةَ الظَّلْمَاءِ",65,"ا",2,0],["وَنَضَا فِي الجفنِ سَيْفًا وَحَمَى","حسنَهُ مِنْ نَظْرَةِ المُخْتَلِسِ",66,"س",1,0],["وَنَضَا في الجَوّ منْ غِمْدِ السحابْ","صَارِمَ البَرقْ",67,"ق",1,0],["ونضَّاحة الذفرى رجوفٍ كأنها","علاةٌ أُنيخت بين كِير ومعوَلِ",68,"ل",1,0],["ونضيء في جنباتها","قَبَسَ المكارم من جديدِ",69,"د",1,0],["ونضارة الوجه الصبوح، ومبسما","كالطلّ بين براعم الأوراد؟!",70,"د",1,0],["وَنَضت أَلحاظُه أَنصُلَها","فَثَناني بَطشُها أَن أَبطِشا",71,"ش",2,0],["ونضحناها ولكن مهجاً","صنع الوجدُ بها ما صنعا",72,"ع",2,0],["ونضا جفوني الوجدُ من مُقَل النوى","ففرى بها كبدي وقلبي يَخفِقُ",73,"ق",1,0],["ونضطره إما لحالة خائن","أمانته أو خائض في الأباطل",74,"ل",1,0],["ونضوا على أهل السبيلِ بواتراً","في الحرب مانضيت من الاغمادِ",75,"د",1,0],["وَنَضى عَلى السودانِ بيضاً عُوِّدَت","إِن صالت آن تُجلي الصَدا بِدماءِ",76,"ا",2,0],["ونضر أياماً لنا سلفت به","وطرف العوادي دونهن كليل",77,"ل",1,0],["ونضحي ونمسي في أفانين لذة","لنا مصبحٌ في ظلها ومقيل",77,"ل",1,0],["ونضا من الملك المعظم مرهفاً","متوقداً ماضي الشبا مسنونه",78,"ن",2,0],["ونضين كل مهند في غمده","للموت فيه تمايل ونذير",79,"ر",1,0],["ونضمه ونشمه","فكأَنه رود كعاب",80,"ب",1,0],["وَنُضيتُ مِمّا تَعلَمينَ فَأَصبَحَت","نَفسي إِلى إِخوانِها كَالمُقذَرِ",81,"ر",1,0],["ونَضمَنُ جارنا ونراه منّا","فنَرفُدُه ونجزِلُ إن رَفَدنا",82,"ن",2,0],["ونُضار الأصيل سالَ كما سا","لَ مزيجُ الورُوس بالأقحوان",83,"ن",1,0],["وَنُضارٌ كانَت أَنيسي وَحُبّي","وَنضارٌ كانَت حَياتي وَروحي",84,"ح",2,0],["وَنُضارٌ أَبقَت بِقَلبي حُزنا","لَيسَ يَنفَكُّ أَو أُوافِي ضَريحي",84,"ح",2,0],["ونضرة الوجه مرُّ العمر يذبلها","وزاهر الثوب طولُ العهد يبليه",85,"ي",2,0],["وَنَضائِدٌ مِن نَرجسٍ وَبَنَفسَجٍ","وَجَنيِّ خيرِيٍّ وَوَردٍ يعبَقُ",86,"ق",1,0],["وَنَضرِبُها حَتّى نُحَلِّلَ نَفرَها","وَتَخرُجَ مِمَّا تَكرَهُ النَّفسُ مُقْدَما",87,"م",2,0],["ونضاه فيصلا يسطع نورا","قاطع الضربات لا يهمل حا",88,"ح",2,0],["وَنَضا جفنه المَريض سُيوفاً","عَبثت حينَ جردت في القُلوب",89,"ب",1,0],["ونضّاخة في الأوج يعلو صعودُها","كقطعة بلّور تضمّنها ثلجُ",90,"ج",1,1],["ونضا على أهل العمود حسامه","فهوى عمودهم بضربة فيصل",91,"ل",1,0],["ونضى على الاوطان صارم حقده","ومضى ونار الحقد في تدمدم",92,"م",1,0],["ونَضا لِنَصْرِ الحَقّ مِنْهُ مُهَنّداً","يَسقِي العِدى صرْف الرّدى هذّاذا",93,"ذ",2,0],["ونضرب في فضاءِ الله","حَتّى نَبلغَ الشُّهبَا",94,"ب",2,0],["وَنضّر هاتيك المنازلَ وَالحمى","وَسكّانَها أَهلَ الوَفا وَالفتوّةِ",95,"ه",1,0],["وَنضَّر هاتيك الغُصون من الصفا","بروح التهاني كلما راعني النَوى",96,"و",2,0],["ونضرة الخدين والسيماء","ولمعة العينين في استحياء",97,"ا",2,0],["ونضت حجاب ثيابها","وجيمع أنواع الحلى",98,"ل",2,0],["ونضرب أهل البغى بالصارم الذي","إذا صال لا يرضى سوى الهام من غمد",99,"د",1,0],["ونضرب الكبشَ مخضرّاً كتائبه","ضرباً على مسكنات الهام صلصالا",100,"ل",2,0],["ونضِّر حياتي يا بديع وموتيا","بأخذ علوم الشرع والحقِّ في أثرِ",101,"ر",1,0],["ونضيت عزما لو يلاقي حده","أعلى شمام ساخ منه شمام",102,"م",1,0],["ونضربُهم على ألمٍ وقَرحٍ","كضربِ فلاةٍ ولدان ثِقال",103,"ل",1,0],["وَنَضَت عَلَيكَ جَلالَها وَوَقارَها","وَحَنَت عَلَيك بِمائِها وَشَرابِها",104,"ب",3,0],["ونضى المطايا بالأصائل والضحى","وأرمى بها يهماء خبت ومجهلا",105,"ل",2,0],["ونضوا صوارمهم لفتكٍ عاجلٍ","فيه وكاد العمرُ أن يتصرَّما",106,"م",2,0],["ونضرته وخضرته بواقٍ","مدى الايام في كل الفصولِ",107,"ل",1,0],["ونضت ما حاكه الانضاء عن","متنها واكتستِ الوجدَ وشاحا",108,"ح",2,0],["ونضت من ا