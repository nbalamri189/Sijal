{"poems":[[90,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[87,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[47,"أقول لصاحب من سر عبس","https://www.aldiwan.net/poem64577.html","الوافر"],[7,"ولست بذاخر لغد طعاماً","https://www.aldiwan.net/poem1965.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[161,"سيد الشهور","https://www.aldiwan.net/poem23652.html","الوافر"],[303,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[449,"صراع السيف والقلم","https://www.aldiwan.net/poem55927.html","عموديه"],[458,"بني معروف جاحدكم جحود","https://www.aldiwan.net/poem61351.html","الوافر"],[520,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[558,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56290","الطويل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216681",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106862","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125847","السريع"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93258","المتقارب"],[4755,"تَمَخَّضّ مُوفَنبيكُ عامًا وليلةً","https://www.poetsgate.com/ViewPoem.aspx?id=184805",""],[4755,"أَبُو ظَبيَ تَلهُو بِنا والرِّياضُ","https://www.poetsgate.com/ViewPoem.aspx?id=206448",""],[4929,"وضوحٌ في طريق المآلات","https://www.poetsgate.com/ViewPoem.aspx?id=202053",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5464,"القتلى لا يحييهم الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=24377",""],[5736,"مواسم الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=208427",""],[5848,"دمعه مالها داعي","https://www.poetsgate.com/ViewPoem.aspx?id=50586",""],[5848,"لا تستحين","https://www.poetsgate.com/ViewPoem.aspx?id=50609",""],[4442,"براعم الروضة أعللها النطف","https://www.poetsgate.com/ViewPoem.aspx?id=171004",""],[4442,"أناخ على ذكا فخبت ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=171228",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6268,"فلسفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82929&r=&rc=15",""]],"verses":[["تمخضوا من سماع الوحي عن همم","نالوا بها أنجم الجوزاء من كثب",0,"ب",1,0],["تَمَخَّضي عَن خَمسَةٍ","إِن شِئتِ أَو عَن عَشرَةِ",1,"ه",1,0],["تَمَخَّطُ لِلزُكامِ وَفيكَ بَردٌ","جُمادِيُّ يُخَبِّرُ عَن قُعاسِ",2,"س",1,0],["تَمَخَّضَتِ المَنونُ لَهُ بِيَومٍ","أَتى وَلِكُلِّ حامِلَةٍ تَمامُ",3,"م",1,0],["تمخض من حين لآخر زاحِراً","وإني لأدري ما به يتمخض",4,"ض",1,0],["تَمَخَّضَ بَدْرُنَا في جَوْفِ ليْلٍ","فَهَلَّ هِلاَلُنَا.... بَرَقَ العنَانُ",5,"ن",1,0],["تمخَّضتِ الأيامُ حتى أتين بي","عصوراً طوالاً غرة في جبينها",6,"ن",3,0],["تمخّض جمعهم عما","دعوه خير مختتم",7,"م",1,0],["تمخض بالحياة حياة شعب","أبي عز في جبل ونعف",8,"ف",1,0],["تمخض الدست عن أم النوائب عن","كبيرة صغرت في جنبها الكبر",9,"ر",1,0],["تَمَخَّضَت عَنهُ تِمّاً بَعدَ مَحمَلِهِ","شَهرَينِ بَيداءُ لَم تُضرَب وَلَم تَلِدِ",10,"د",1,0],["تمخض ظلماً عندما راح حاملاً","بأحشاه أوجاع الخطاء المخبَّلِ",11,"ل",1,0],["تمخر بحورٍ ما لها من مرافي","واهل الهوى رغم البلايا مساعيد",12,"د",1,0],["تمخَّض فينا الدهرُ وهو ضعيفة","قواه وإنّا وُلدُه الضعفاءُ",13,"ا",2,0],["تَمَخَّض الطودُ فهل من خَبَرْ","يُنبِئُ عما قد جرى من عِبرْ",14,"ر",1,1],["تمخضت الدنيا فكان نتيجة","بها المنبر المثلوم يهتز لا المهد",15,"د",1,0],["تَمَخَّضَ عزمٌ لها مُنْجِبٌ","فيا سَعْدَ ما وَضَعَتْ حامِلُ",16,"ل",1,0],["تَمَخَّضّ مُوفَنبيكُ عامًا وليلةً","ولكنهُ فِي لحظَةِ الوَضْعِ أجهَضَا",17,"ض",2,1],["تَمَخَّضتُمُو -بَعدَ خَمسٍ- بِفَأرٍ","أَلا بِئسَ فَأرُ الأَذَى والمَخَاضُ",18,"ض",1,0],["تَمخَّضَتِ الصحراءُ فيهم بخيرِها","فساروا انحرافا في مسار اعوجاج",19,"ج",1,0],["تمخضتِ الأنا عن ضوء حرفٍ","شرارته أنارت ألف معنى",20,"ن",2,0],["تمخّضتْ عن بكاءٍ ضحكةٌ وغدتْ","فجيعة ً نشوة ٌ قد أمطرتْ مُتعا",21,"ع",2,0],["تمخّضتْ عن بكاء ٍضحكة ٌ وغدتْ","رزيئة ً نشوة ٌقدْ أمطرتْْ مُتَعا",22,"ع",2,0],["تَََََمخّضَ الحُزنُ عن دمعٍ ألوذُ به","يُسابقُ الغيمةَ السّودا إذا انْهملا",23,"ل",2,1],["تمخطري وسط قلبي واخذي","ذراعي توسديها ونامي فوق اراضيها",24,"ي",3,0],["تمخطري في عيون العيد .. لا تستحين","مادامك اجمل وارق انثى بملبوسها",25,"س",3,1],["تمخض ما أن حملت صواعقا","أصبح منها الشرق للغرب هدف",26,"ف",1,0],["تمخض والنتاج به فقلنا","لقد ولد المعارف والسخاء",27,"ا",2,0],["تَمَخَّطَتِ الدنيا فسالَ مُخَاطُها","ب ( صهيونَ ) سيلاً في الليالي تبعثرَا",28,"ر",2,0],["تمخَّضتْ أحرُفي مما ألمَّ بها","فأنجبت من جحيم البؤس فلسفتي",29,"ت",2,0]]}