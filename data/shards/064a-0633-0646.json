{"poems":[[53,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[40,"يسنها آبل ما إن يجزئها","https://www.aldiwan.net/poem7852.html","البسيط"],[87,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[107,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[199,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[409,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[415,"كناس سرب المها عريسة الأسد","https://www.aldiwan.net/poem32224.html","البسيط"],[463,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[466,"أقول لمنطيق من الحي أفوه","https://www.aldiwan.net/poem16098.html","الطويل"],[567,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79867","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69316","الرجز"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199812","المسحوب"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124776","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94252","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216539",""],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113702","المنسرح"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134238","الخفيف"],[5147,"مخيلتي تطالبني بأمر","https://www.poetsgate.com/ViewPoem.aspx?id=166714",""],[5431,"طبيب الفقراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=215177",""],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""]],"verses":[["يُسنَى الجزاء على الفعالِ لذيذِهِ","وأليمِهِ إن كان منه أليمُ",0,"م",1,0],["يَسُنُّها آبِلٌ ما إِن يُجَزِّئُها","جَزأً شَديداً وَما إِن تَرتَوي كَرَعا",1,"ع",2,1],["يَسُنُّ الشَبابُ البَأسَ وَالجودَ لِلفَتى","إِذا الشَيبُ سَنَّ البُخلَ بِالنَفسِ وَالمالِ",2,"ل",1,0],["يَسُنُّ لِقَومي في عَطائِيَ سُنَّةً","فَإِن قَومِيَ اِعتَلّوا عَلَيَّ كَفاني",3,"ن",2,0],["يَسُنّ عليه الذِّمْرُ عذراءَ نثرةً","تَخال بها التَأنيث في الذكر العَضبِ",4,"ب",1,0],["يَسُنُّ لِمصرَ الحُبَّ من وصفهِ الرَّدى","ويشرع للقومِ الجهادَ المنظَّما",5,"م",2,0],["يَسُنُّها آبِلٌ إِمّا يُجَزِّئُها","جزءاً طَويلاً وَإِمّا تَرتَعي كَرَعا",6,"ع",2,0],["يسنده البارق في ومضه","ونسمة الروض له ترسل",7,"ل",1,0],["يُسنِي المواهبَ مَسروراً بها جَذِلاً","فَمنُّهُ غيرُ مَمنونٍ ولا نَكِدِ",8,"د",1,0],["يُسنِد عن آبائه أخبارَها","صادقةً إذا اتهمتَ المُسنِدا",9,"د",2,0],["يُسنُّ قميصاهُ على شامخِ الذُّرى","إذا ما الحُبى من سورة الخطب حُلَّتِ",10,"ت",1,0],["يَسُنُّ لهُ الوقوفَ على حُدودٍ","فتُزعجُ نفسَهُ تلك الحُدودُ",11,"د",1,0],["يَسُنُّ أَنْيابَ شَبَا الضِغامِ","أَرْأَسَ شَدَّاخٍ عَلَى اللِكامِ",12,"م",1,0],["يسني لها أثمانها مُستحيياً","ولو يميحُ نفسهُ معَ الثمن",13,"ن",1,0],["يَسنى لَها عَذبٌ خَصِر","حَتّى إِذا الماءُ اِحتُكِر",14,"ر",1,0],["يسني بياض اخدودها من ورا الشيّل","ظبي القفر تقطف زهر كل عنقود",15,"د",1,0],["يسن وفي الحاجات أو شهر صومهم","وللجار والقربى وإن يؤذ أكد",16,"د",1,0],["يسند النص في المقال إلى ما","صح نقلاً واختير في الفقهيه",17,"ي",2,0],["يِسْنِدْ عليه الباز الاشْهَب","مِنْ الشّام يِخْتالَهْ عَ الاتلال",18,"ل",1,0],["يسنَحُ لكن بصفحتي رشأٍ","والقدُّ إن ماد دونه القُضُبُ",19,"ب",1,0],["يَسنح الظبي آمناً في ثراكم","وأراه بُعدةٍ وعَديد",20,"د",1,0],["يسند العدل يمنها عن فتوح","عن سعود عن عزة عن أمان",21,"ن",1,0],["يسنون المناهج عن حساب","عليه حياة مبدئنا تدور",22,"ر",1,0],["يسنّ لنا دروبا من فلاحٍ","خطى نهرٍ بلا لكْئٍ شحيحٍ",23,"ح",1,0],["يسن لنا خلاصا إنْ أرقنا","جرار القلب في عمرٍ قبيح",23,"ح",1,0],["يسند «العمُّ» في الجهاد خُطاها","بخيوطٍ تدور في الكون رَيْما",24,"م",2,0]]}