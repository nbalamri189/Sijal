ViewPoem.aspx?id=130643",""],[6051,"وَإِيَّاكَ والظُّلْمَ المُبَيِّن، إنَّنِي","https://www.poetsgate.com/ViewPoem.aspx?id=85176",""],[6070,"إذا ما كنتَ تَرغَبُ في النَّجاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=191615",""],[6134,"صروف دعتني أن أفيق من الكرى","https://www.poetsgate.com/ViewPoem.aspx?id=169567",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[520,"أمعتسف المهامه والموامي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577639",""]],"verses":[["فَلا تَكفُرِ النُعمى وَأَثنِ بِفَضلِه","وَلا تَأمَنَن ما يُحدِثُ اللَهُ في غَدِ",0,"د",1,0],["فَلا تُكذَبَنَّ فَإِنَّ السُلُ","وَّ لِلقَلبِ مَوعِدُهُ المَحشَرُ",1,"ر",1,0],["فَلاتَكُ مِثلَ الَّتي اِستَخرَجَت","مِن أَظلافِها مُديَةً أَو بِفيها",2,"ي",3,0],["فَلا تَكسِروا أَرماحَهُم في صُدورِكُم","فَتَغشِمَكُم إِنَّ الرِماحَ مِنَ الغَشمِ",3,"م",1,0],["فَلا تَكِلوني لِلزَمانِ فَإِنَّني","أَخافُ عَلَيكُم أَن تَحينَ وَفاتي",4,"ت",2,0],["فَلا تَكُن ذا حِجابٍ","وَلا تُطِل في التَجَنّي",5,"ن",2,0],["فَلا تَكفُروا مَروانَ آلاءَ أَهلِهِ","بَني عَبدُ شَمسٍ وَاِشكُروهُ فِعالَها",6,"ل",3,0],["فَلا تَكُ كَالراكِبِ السَبعَ كَي","يُهابَ وَأَنتَ لَهُ أَهيَبُ",7,"ب",1,0],["فَلا تُكثِروا طولَ شَكِّ الخِلاجِ","وَشُدّوا عَلى العيسِ أَكوارَها",8,"ر",3,0],["فَلا تَكِلنا فيها إِلى أَحَدٍ","مُعِلُّها مُحسِناً يُعَلِّلُها",9,"ل",3,0],["فَلا تَكفُرونا ما فَعَلنا إِلَيكُمُ","وَأَثنوا بِهِ وَالكُفرُ بورٌ بَضائِعُه",10,"ع",2,0],["فَلا تَكُ كَالوَسنانِ يَحلُمُ أَنَّهُ","بِقَريَةِ كِسرى أَو بِقَريَةِ قَيصَرا",11,"ر",2,0],["فَلا تَكُ كَالشاةِ الَتي كانَ حَتفُها","بِحَفرِ ذِراعَيها تُثيرُ وَتَحفِرُ",12,"ر",1,1],["فلا تكرهَنْ أن أوتِيَتْ ما تودُّهُ","فكرهُك ما ودت من النكراتِ",13,"ت",1,0],["فلا تكُ إما خائناً أو مُضيّعاً","ولكنْ أميناً حافظاً كذويكا",14,"ك",2,0],["فلا تكره السوءَى من القولِ مغرياً","بها الناس صلاها لديك مع الصالي",15,"ل",2,0],["فلا تكن المطروفَ عنها وصادها","تُضِئْ لك والإجمالُ بالمرء أجملُ",16,"ل",1,0],["فَلا تَكُ كالثَورِ الَّذي دُفِنَت لَهُ","حَديدَةُ حَتفٍ ثَمَّ ظَلَّ يُثيرُها",17,"ر",3,0],["فَلا تَكُ مِثلَ الأُقحُوانَةِ راعَها","مِنَ الحَقلِ أَن تُجنى فَلَم تَسكُنِ الحَقلا",18,"ل",2,0],["فَلا تُكثِرا لَومي فَما أَنا بِالذي","سَنَنتُ الهَوى في الناسِ أَو ذُقته وَحدِي",19,"د",2,0],["فلا تكترث بعصاباتهم","ولُذ بقفا حضرة الوالد",20,"د",1,0],["فَلا تَكونُنَّ تُركِيّا الفَتاةُ وَلا","تِلكَ العَجوزَ وَكونوا تُركِيا القِدَمِ",21,"م",1,0],["فَلا تَكثِرِ الرومُ التَشَكّى فَإِنَّهُ","يُراوِحُها بِالخَيلِ إِن لَم يُغادِها",22,"د",3,0],["فَلا تَكفُرُنَّ الفَتحَ آلاءَ مُنعِمٍ","نَجَوتُم بِها مِن لاحِجِ القُطرِ ضَيِّقِ",23,"ق",1,0],["فَلا تَكذَبَن عَن فَضلِهِ وَوَفائِهِ","فَما هُوَ في هاتَينِ إِلّا السَمَوأَلُ",24,"ل",1,0],["فَلا تَكونَن كَمَن تَغذو بِدِرَّتِها","أَولادَ أُخرى وَلا يَبقى لَها وَلَدُ",25,"د",1,0],["فَلا تَكتُمُنَّ اللَهَ ما في نُفوسِكُم","لِيَخفى وَمَهما يُكتَمِ اللَهُ يَعلَمِ",26,"م",1,0],["فَلا تُكثِرَنَّ القَولَ في غَيرِ وَقتِهِ","وَأَدمِن عَلى الصَمتِ المُزيِّنِ لِلعَقلِ",27,"ل",1,1],["فَلا تَكُ مَن أَعطى المُدامَ قِيادَهُ","فَأَودَت بِهِ وَاِستَوطَأَ الجَهلَ مَركَبا",28,"ب",2,0],["فلا تكُ منها ظالماً لِصِفاتِهَا","على الثّغرِ بالإغريضِ والرّيقِ بالشهدِ",29,"د",1,0],["فَلا تَكفُرُنَّ الصامِتِيَّ مُحَمَّداً","آيادِيَ شَفعاً سَيبُها مُتَدارِكُ",30,"ك",1,0],["فلا تكُ في الدنيا مضافاً وكنْ بها","مضافاً إليهِ إنْ قدرتَ عليهِ",31,"ه",1,1],["فَلا تَكفُروها يا بَني مِصرَ نِعمَةً","وَلا يَجلِبَنَّ الشَرَّ في مِصرَ جالِبُ",32,"ب",1,0],["فَلا تَكُ إِلّا مُحسِناً تُؤثِرُ الَّتي","أَوائِلُها حَمدٌ وَأَعقابُها أَجرُ",33,"ر",1,0],["فَلا تُكثِروا شَوكَ الأَذى في غُصونَكُم","فَيَكثُرَ مِنّي فيكُمُ الكَسرُ وَالخَبطُ",34,"ط",1,0],["فلا تُكثِروا ذكرَ الزمان الذي خلا","فذلك عصْرٌ قدْ تَقَضّى وذا عَصْر",35,"ر",1,0],["فلا تكن بالشقاء متّبعاً","إبليسَ إنّ اللواطَ من حيلِه",36,"ل",2,0],["فَلا تَكُ زيراً لِلنِساءِ وَإِن تَمِل","لَهُنَّ فَلا تَأذَن لِزيرٍ وَلا صَنجِ",37,"ج",1,0],["فَلا تَكوني مِثلَ الَّتي لَدَغَت","تَبدَأُ في شَرِّها بِأَقرَبِها",38,"ب",3,0],["فَلا تُكَلِّف جَواداً سَيرَ نائِيَةٍ","فيها الحَزونَةُ إِلّا بَعدَ إِنعالِ",39,"ل",1,0],["فَلا تَكتَحِلْ عَيْنَاكَ فِيهَا بِعَبْرَةٍ","على ذَاهِبٍ مِنْهَا فَإِنَّكَ ذاهِبُ",40,"ب",1,0],["فَلاَ تَكُونَنَّ كَالنَّازِي بِبِطْنَتِهِ","بَيْنَ القَرْينَيْنِ حَتَّى ظَلَّ مَقْرُونَا",41,"ن",2,0],["فلا تُكَذِّبْ بوَعْدِ اللّهِ وارْضَ بهِ","ولا تُوكّلْ عَلى شَيْءٍ بإشْفاقِ",42,"ق",1,0],["فَلا تَكفُرِ النُعمى وَأَثنِ بِفَضلِها","وَلا تَأمَنَن ما يُحدِثُ اللَهُ في غَدِ",43,"د",1,0],["فلا تَكْذِبْ بِوَعْدِ اللِه وارْضَ به","قد قدر الله ما كل امرىء لاقِ",44,"ق",1,0],["فلا تكِلوا الأمورَ إلى قضاء","فما كانَ القضاءُ لكم رَضاعا",45,"ع",2,0],["فَلا تكذِبَنْ عَنْ فَضْلِهِ وَوَفائِهِ،","فَمن هُوَ في هَذينِ إلاّ السّمَوْألُ",46,"ل",1,0],["فلا تك مثل الأقحوانة راعها","من الحقل أنّ تجنى فلم تكن الحقلا",47,"ل",2,0],["فلا تكن المطروفَ عنها وصادها","تُضيء لك والإجمالُ بالمرء أجمل",48,"ل",1,0],["فلا تكثرُ بشكركَ لي فخيرٌ","لديّ دريهمٌ من ألف مِرسي",49,"ي",1,0],["فَلا تَكتَرِث مِن قَولِ واشٍ وَشى بِها","فَما مُبلِغُ الحُسّادِ إِلّا مِحالها",50,"ل",3,0],["فلا تكتسبْ غيرَ القَناعةِ إنها","تجارةُ حُرٍّ ليس تخلو من الربح",51,"ح",1,0],["فلا تكن كدرَ الأخلاق يا أملي","فيُصبح الصَّفوُ من ذا كلِّه كدرا",52,"ر",2,0],["فلا تكن ناسكاً ثقيلاً","فكَمْ عَفا ربُّنا وعافى",53,"ف",2,0],["فلا تك ممن قر عينا ببذل ما","حوت يده في الكيمياء وطابا",54,"ب",2,0],["فلا تَكِلهُ إلى سواك ومن","سواكَ بعد المُهَيمنِ الصَّمَدِ",55,"د",1,0],["فلا تَكُ يوماً واثقاً أو مصدّقاً","فكلُّ ضعيفٍ ما لهُ نُصراء",56,"ا",2,0],["فَلا تَكُ كَالَّذِي إِنْ جِئْتُ أَشْكُو","إِلَيْهِ الْوَجْدَ أَوْسَعَنِي مَلاما",57,"م",2,0],["فَلا تَكتُموا الحَقَّ يا حاسِديهِ","وَلا تُلبِسوا الحَقَّ بِالباطِلِ",58,"ل",1,0],["فلا تُكثِر النَّجوى وَأنتَ مُحارِبٌ","تُؤامر فيها كُلُّ نكسٍ مقصِّر",59,"ر",1,1],["فَلا تكن مُعتمدا","عَلى صديقٍ أَبدا",60,"د",2,0],["فَلا تكسِبا حِنثاً عَفا اللَهُ عنكما","على كُلِّ حالٍ لا رُزئناكما فَقدا",61,"د",2,0],["فلا تكن في مريةٍ إن دعا","يوماً ولبى في الهوى لبى",62,"ب",2,0],["فَلا تَكسفَن بالعتبِ نظرة 