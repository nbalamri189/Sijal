السريع"],[381,"برق بدا جنح الدجى يتألق","https://www.aldiwan.net/poem48835.html","الكامل"],[401,"حينما يكون البحر شاهداً","https://www.aldiwan.net/poem6727.html","عموديه"],[407,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[433,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[433,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[440,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[454,"ولولي ولولي وصيحي وطيري","https://www.aldiwan.net/poem61249.html","الخفيف"],[454,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[454,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[459,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[459,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[465,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[465,"يا من إذا غاب غاب الخير أجمعه","https://www.aldiwan.net/poem3529.html","عموديه"],[465,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[471,"أيهذا المخبري عن يزيد","https://www.aldiwan.net/poem4794.html","الخفيف"],[539,"ما أبصرت عيني بها عيناك","https://www.aldiwan.net/poem48002.html","عموديه"],[539,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[541,"ما أبالي من رابه الدهر ما لم","https://www.aldiwan.net/poem56621.html","الخفيف"],[552,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[552,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[552,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[568,"ما أبصرت عيني ولا عين أحد","https://www.aldiwan.net/poem69706.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[576,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[576,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["ما اِبيَضَّ مِن لَونِ العَوارِضِ أَفضَلُ","وَهَوى الفَتى ذاكَ البَياضُ الأَوَّلُ",0,"ل",1,1],["ما أَبدَعَ المِقدارُ فيما جَنى","لَكِنَّهُ حَمَّلَ غَيرَ المُطيق",1,"ق",1,0],["ما أُبالي مِن زَماني بَعدَها","إِذ أَصَحَّ النَفسَ إِن جِسمي أَعَلّ",2,"ل",1,0],["مَا أَبْهَجَ الْعِيدَ وَالأَقْطَابُ تَجْمَعُهُمْ","رَوَابِطُ الْوَدِّ حَوْلَ السَّيِّدِ الْقُطُبِ",3,"ب",1,0],["مَا ابْتِسَامُ الْهِلاَلِ فِي الشَّكِّ أجْلَى","مِنْهُ نُوراً بِأعْيُنِ المُسْتَبِينِ",4,"ن",1,0],["مَا أَبْدَعَ الكَلِمَ المُثَقِّ","فَ فِيهِ مِنْ أَدَبٍ فُنُونُ",5,"ن",1,0],["ما أبصرت عيناي مثل هديةٍ","أبدت لنا صنع الإله تعالى",6,"ل",2,0],["ما أبهج النور وما أحسنا","إذا دنا منك لوجه الحبيب",7,"ب",1,0],["ما أبعد الخيرَ عن فتىً كَسِل","يسرح في لهوه وفي لَعِبه",8,"ب",2,0],["ما أبالي إِذَا حَفِظتُ أبا القَا","سِمٍ فِيهِم مَلامَةَ اللُوَّامِ",9,"م",1,0],["ما أبَالِي وَلَن أُبَالِي فِيهِم","أبَداً رَغمض سَاخِطِينَ رَغَامِ",9,"م",1,0],["ما أُبَالِي إذَا أُنِخنَ إِلَيهِم","نَقَبَ الخُفِّ واعتِرَاقِ السَّنَامِ",9,"م",1,0],["ما أُبالي أَنَبَّ بِالحُزنِ تَيسٌ","أَم لَحاني بِظَهرِ غَيبٍ لَئيمُ",10,"م",1,0],["ما أبصر المبصر خطًّا مثله","وكيف لا والخطّ لابن مقله",11,"ه",1,0],["ما آبَ مِن سَفَرٍ إِلّا وَأَزعَجَهُ","رَأيُ إِلى سَفَرٍ بِالعَزمِ يَزمَعُهُ",12,"ع",2,0],["ما أُبالي أأثمرتْ لاجتناءٍ","بعد هذا أم أيبستْ لاحتطابِ",13,"ب",1,0],["ما أبين اليمن في نقيبته","على أعاديه حيث ما انصرفا",14,"ف",2,0],["ما أَبْصرتْ عيناي قبلَ وجوهها","وفروعها نوراً يُقلُّ ظلاما",15,"م",2,0],["ما أَبصَرَت عَينايَ غانِيَةً","إِلّا ذَكَرتُ إِلى الدُمى فَقري",16,"ر",2,0],["ما أَبي إِلّا أَخٌ فارَقتُهُ","وُدُّهُ الصِدقُ وَوُدُّ الناسِ مَين",17,"ن",1,0],["ما أَبعَدَ الغاياتِ إِلّا أَنَّني","أَجِدُ الثَباتَ لَكُم بِهِنَّ كَفيلا",18,"ل",2,0],["ما آبَ جَبّارُ القُرونِ وَإِنَّما","يَومُ الحِسابِ يَكونُ يَومَ إِيابِهِ",19,"ب",2,0],["ما أُبالي إِذا اِتَّقَتكَ الرَزايا","مَن دَهَتهُ حُبولُها وَالخُبولُ",20,"ل",1,0],["ما أَبعَدَ العَيبَ وَالنُقصانَ عَن شَرَفي","أَنا الثُرَيّا وَذانِ الشَيبُ وَالهَرَمُ",21,"م",1,0],["ما أبعدَ العَيبَ والنّقصانَ منْ شَرَفِي","أنَا الثّرَيّا وَذانِ الشّيبُ وَالهَرَمُ",22,"م",1,0],["ما أُبالي إِذا أَخَذتُ بِحَبلٍ","مِنهُ ما أَجمَعَت عَلَيَّ الخُطوبُ",23,"ب",1,0],["ما أُبالي إِذ أَخَذتُ بِحَبلٍ","مِنهُ ما أَحدَثَت نَوائِبُ دَهري",24,"ر",2,0],["ما أَبو جَعفَرٍ بِمُستَقصَرِ الجَد","وى وَلا سالِكٍ سَبيلَ النِفاقِ",25,"ق",1,0],["ما أُبالي إِذا اِبتَدَأتَ بِنُعمى","أَنتَ فيها أَم غَيرُكَ المَسؤولُ",26,"ل",1,0],["ما أَبعَدَ المَكرُماتِ عَن رَجُلٍ","عَلى سُؤالِ الرِجالِ يَتَّكِلُ",27,"ل",1,0],["ما اِبنُ سُلَيمٍ سائِراً بِجِيادِهِ","إِلى غارَةٍ إِلّا أَفادَكَ مَغنَما",28,"م",2,1],["ما أَبعَدَ الشَيءَ مِنكَ ما لَم يُسا","عِدكَ عَلَيهِ القَضاءُ وَالقَدَرُ",29,"ر",1,0],["ما ابتَلى اللَهُ فُؤادي","بِكَ إِلّا شُؤمَ جَدِّه",30,"د",2,0],["ما أَبَينَ الفَضلَ في مُغَيَّبِ ما","أَورَدَ مِن رَأيِهِ وَما أَصدَر",31,"ر",1,0],["ما أَبيَنَ الأَمرَ وَلَكِنَّني","أَرى جَميعَ الناسِ عَنهُ عُماة",32,"ا",2,0],["ما آبَ مَن آبَ لَم يَظفَر بِبُغيَتِهِ","وَلَم يَغِب طالِبٌ لِلنُجحِ لَم يَخِبِ",33,"ب",1,0],["ما اِبيَضَّ وَجهُ المَرءِ في طَلَبِ العُلى","حَتّى يُسَوَّدَ وَجهُهُ في البيدِ",34,"د",1,1],["ما أُبالي إِذا عَنَتكَ أُموري","كَيفَ أَنحَت عَلَيَّ أَيدي الصُروفِ",35,"ف",1,0],["ما أُبالي بَعدَ اِنبِساطِكَ بِالمَعرو","فِ مَن كانَ مِنهُمُ ذا اِنقِباضِ",36,"ض",1,0],["مَا اِبتَدى إِلّا رَأَيتَ بِهِ","شَيخَ رَأيٍ في فَتى كَرَمِ",37,"م",1,0],["ما ابنُ محمود ولا أصحابُه","كالأُلى اجتاحوا قُوى الشَّعبِ اجْتياحا",38,"ح",2,0],["ما أَبعَدَ النُجحَ عَمَّن لا مَضاءَ لَهُ","وَأَضيَعَ الأَمرَ بَينَ القالِ وَالقيلِ",39,"ل",1,0],["ما أَبغَضَ العَيشَ إِلّا أَن تُجَمِّلَهُ","سودٌ يُدَمِّرُ صَرحَ البَغيِ ذاريها",40,"ي",3,0],["ما أَبعَدَ النُسكَ مِن قَلبٍ تَقَسَّمَهُ","قُطرَبُّلٌ فَقُرى بَنّى فَكِلواذى",41,"ذ",2,0],["ما أُبالي مَتى يَكونُ وَقَد قَض","ضَيتُ مِنهُ السُرورَ كَأسُ حِمامي",42,"م",2,0],["ما أُبالي مَن ضَنَّ عَنّي بِنَيلٍ","إِن قَضى اللَهُ مِنكِ لي يَومَ جودِ",43,"د",1,0],["ما أَبو العَبّاسِ في أَثباتِهِ","لَعِبَ الدَهرُ بِهِ تِلكَ اللُعَب",44,"ب",1,0],["ما أَبأَسَ الحَيوانَ لَيسَ لِنابِتٍ","أَسَفٌ بِما يَبدو مِنَ النُوّارِ",45,"ر",1,0],["ما أُبرِمَ المُلكُ إِلّا عادَ مُنتَقَضاً","وَلا تَأَلَّفَ إِلّا شَتَّ وَاِفتَرَقا",46,"ق",2,0],["ما أبص الإكليل يطلع لَيلاً","وَالثريّا مَرفوعة في السماء",47,"ا",2,0],["ما أبدعَ الحلم الذي صوَّرا","لوْ لم تَشبْهُ اليقظةُ القاتلهْ",48,"ه",1,0],["ما أبى الخلدَ آدمٌ","أو غوى فيه أو عثَرْ",49,"ر",1,0],["مَا أَبْعَدَ الْخَيْرَ في الدُّنْيَا لِطَالِبِهِ","وَأَقْرَبَ الشَّرَّ مِنْ نَفْسٍ تُحَاذِرُهُ",50,"ر",2,0],["مَا أَبْهَجَ الشَّمْسَ حِينَ يَجْلُو","طَلْعَتَهَا مَوْكِبُ الْغَوَادِي",51,"د",2,0],["مَا أَبْهَجَ الزَّهْرَ عَلَى","جَبِينِهَا المُكَلَّلِ",52,"ل",1,0],["مَا أَبْهجَ الكفُوئَينِ ضَمَّهُمَا الهَوَى","يَقِفَانِ مِنْهُ مِثْلَ هَذَا المَوْقِفِ",53,"ف",1,0],["مَا أَبْهَجَ الشَّمْسَ الَّتِي لاَحَتْ لَهَا","بَعْدَ الْقُنُوطِ وَطَالَعَتْ بِرجَاءِ",54,"ا",2,0],["مَا أَبْهَجَ السَّلْمَ وَتَبْشِيرَهُ","وَغِبْطَةَ الْخَلْقِ بِمَا بُشِّرُوا",55,"ر",3,0],["مَا أَبْدَعَ الغَرْسَ الَّذِي","أَهْدَى وَمَا أَحْلَى الفِرِنْدَا",56,"د",2,0],["ما أُبالي إِذا النَوى قَرَّبَتكُم","فَدَنَوتُم مَن حَلَّ أَو كانَ سارا",57,"ر",2,0],["ما أبلغ الدنيا وأبلغ درسها","وأجلّها وأجلّ ما تلقيه",58,"ي",2,0],["ما أبهجَ الأكليل فوق جبينه!","هذا الجبين يزين الإكليلا!",59,"ل",2,0],["ما أبعدَ البغيَ عنا! إننا نفرٌ","إلى العلا -لا الدمِ الموَّارِ- ظمآن",60,"ن",1,0],["ما أبقت الأيدي التي عبثت به","من مجدِه عرضاً له أو جوهرا",61,"ر",2,0],["ما \"ابن حمدان \" إذ يقودُ من الموتِ","جيوشاً تُزجَى لموتٍ مُداهِم",62,"م",1,0],["ما أبهجَ الزهرَ المرقرقَ في الضحى","يجلو العيونَ شعاعهُ ووميضه",63,"ض",2,0],["ما أبعدَ الشأوين هذا إن يضيق","منه الحشا فبذا يُفَرَّج ضيقه",64,"ق",2,0],["مَا أَبْعَدَ المَكرُمَاتِ عَنْ رَجُلٍ","عَلَ سُؤَالِ الرِّجالِ يتَّكِلُ",65,"ل",1,0],["ما أبعد النجع عمن لا مضاء له","وأضيع الأمر بين القال والقيل",66,"ل",1,0],["ما أَبِي إلاَّ أَخٌ فارَقْتُه","وأَماتَ الرُّسْلَ إلاَّ الوالدين",67,"ن",1,0],["ما أَبصَرت عَيني عَلى","وَجه البَسيطة مِن حسن",68,"ن",1,0],["ما أبصَرَتْ عينايَ أحسنَ منظراً","منه فما منه الضياءُ يغيبُ",69,"ب",1,0],["ما أَبعَدَ الصِدقَ مِن ظَنٍّ تُكَذِّبُهُ","زُرقُ الأَسِنَّةِ وَالهِندِيَّةُ الخُذُمُ",70,"م",1,0],["ما أُبالي إِذا حَسبتُك مِنْ دَه","ري بِما كان ساقطاً من حِسابي",71,"ب",2,0],["ما أبصرت عيناي بعدك باقياً","إلا يلوح العذر فوق جبينه",72,"ن",2,0],["ما أبدت الدنيا لشخص نعمة","ومسرة إلا وكان لها السبب",73,"ب",1,0],["ماابن الحسام وما الحبيشي مالهم","أبداً وما والله للسرى عنا",74,"ن",2,0],["ما أبصرت مقلة كلا ولا سمعت","أذن بأُخرى في فضل يضاهيه",75,"ي",2,0],["ما أبالي أراشدا فاصبحاني","حسبتني عواذلي أم غويا",76,"ي",2,0],["ما أَبْعَدَ الأشياءَ مما يَسُرّْ","فِعْلا وأَدْناها إلى ما يَضُرّْ",77,"ر",1,1],["ما أبالي بعد هذا","كيف كان الناس بعدي",78,"د",2,0],["ما أبالي بأيّ أرض حللت","إنني حيثما سقطت لقطت",79,"ت",1,1],["ما أبالي وحبيبي منصف","طال هذا العمر أو لم يطل",80,"ل",1,0],["ما أبعد الغيثَ من تشبِيهه بِيَدي","وأقربَ الشمسَ من أن تقتَفي شيمي",81,"م",2,0],["ما آب من جزعٍ ولا من ذلة","لكنه للاتفاق يميل",82,"ل",1,0],["ما أَبعَدَ المَظلومَ مِن حَقِّهِ","إِن كانتِ الدَعوى عَلى الحاكِمِ",83,"م",1,0],["ما ابيض يومي من عدو أزرق","الأوصال علي عيش أسود",84,"د",1,0],["ما أُبالِي لَيلَةَ القَد","رِ وَلا تُسمِعُنِيها",85,"ي",3,0],["مَا أَبْينَ الضدّيْنِ في حالِي التي","حالَتْ أسىً باق وصَبْر نافِد",86,"د",1,0],["ما أُبالِي إِذا تَعَهَّدْنَ مَغْنا","يَ بِأَنْ لا يَصُوبَ صَوْبُ الْعِهادِ",87,"د",1,0],["ما اِبنُ العَميدِ وَلا عَبدُ الحَميدِ وَلا ال","صابي بِأَحسَنَ ذِكراً مِنهُ إِن ذُكِروا",88,"ر",3,0],["ما أَبعَدَ الرُشدَ عَن قَومٍ أَتَوا سَفَهاً","لِيَهدِموا مَجدَهُم في الناسِ لَو عَلِموا",89,"م",3,0],["ما اِبتَسَمَت إِلّا اِنثَنَت تَشتَكي","مِن ثَغرِها الغَيرَةَ بي