{"poems":[[11,"أبلغ الحارث بن عمرو بأني","https://www.aldiwan.net/poem226.html",""],[46,"والله لو تدري بما ألقى","https://www.aldiwan.net/poem30196.html","الكامل"],[71,"بي فقير بل غني","https://www.aldiwan.net/poem28650.html","مجزوء الرمل"],[214,"بي فارغ أهواه لا شغل له","https://www.aldiwan.net/poem13446.html","الرجز"],[473,"يا أخا لا يمر حلو الإخاء","https://www.aldiwan.net/poem60521.html","الخفيف"],[556,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79466","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128721",""],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95182","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60858","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141517","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[5781,"كم نحنُ تُعَساء","https://www.poetsgate.com/ViewPoem.aspx?id=204826",""],[5791,"ميقات نرد ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208602",""]],"verses":[["بِيَفاعٍ وَذاكَ مِنها مَحَلٌّ","فَوقَ مَلكٍ يَدينَ بِالأَحسابِ",0,"ب",1,0],["بي فَوقَ ما تَلقى بِواحِدِها","أُمٌّ تَراهُ لِجَنبِها مُلقى",1,"ق",2,0],["بي فقيرٌ بل غنيٌّ","بسنا وجهٍ منيرِ",2,"ر",1,1],["بي فارغ أهواه لا شغل له","من التجني لا يرق لحالي",3,"ي",1,1],["بِيَ فَقرٌ إِلى المُدامِ وَإِن لَم","أَكُ مِمَّن يُعَدُّ في الفُقَراءِ",4,"ا",2,0],["بِيَفاعِ مشرفةٍ وهل يُغنِي الفتى","سُلِبَ الحياةَ مَقِيلُهُ بِيَفاعِ",5,"ع",1,0],["بي فاقةٌ غطَّيْتُها بتجمُّلٍ","وتحمُّلٍ وتَخَمُّلٍ وتَسَتُّرِ",6,"ر",1,1],["بي فيه قصور ولو أشيد قصورا","تعلو بطباق على منازل كيوان",7,"ن",1,0],["بِي فَلكيٌّ رَاقَنِي حُسنُهُ","بالوصلِ لَم يَعطف عَليَّ مَن مَلَك",8,"ك",1,1],["بيفاعتين إلى الدريب","إلى الحصاد إلى نبع",9,"ع",1,0],["بي فوق دعصك رخصة","خطرت بممشوق رشيق",10,"ق",1,0],["بي فخرُكم وكرامتي من غيركم","مثل النبيّ بأرضِهِ لا يُعرَفُ",11,"ف",1,1],["بي في سر التصابي لافتضاح","فتضاحكن لها يخدعنها",12,"ه",2,0],["بِيَفاعَةِ السَّمراءِ تَخْلَعُ عِشْقَها","والقلْبُ بَيْنَ تَمَلْمُلٍ وتحايُلِ",13,"ل",1,0],["بي فكرةٌ يغتالها السردُ","عن (جمرةٍ) ميقاتها خدُّ",14,"د",1,1]]}