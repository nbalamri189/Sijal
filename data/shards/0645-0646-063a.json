{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[54,"دليتني بغرور وعدك","https://www.aldiwan.net/poem27520.html","الكامل"],[88,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[51,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[51,"يا أيها الملك السعيد المعرس","https://www.aldiwan.net/poem64580.html","الكامل"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[92,"وأود أن أحيا بفكرة شاعر","https://www.aldiwan.net/poem38906.html","الكامل"],[92,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[78,"يا من تعرض لي يريد مساءتي","https://www.aldiwan.net/poem14159.html","الكامل"],[78,"قبح الدهر فماذا صنعا","https://www.aldiwan.net/poem14203.html","الرمل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[2,"فيم لحت إن لومها ذعر","https://www.aldiwan.net/poem25030.html","المنسرح"],[58,"يا لهف نفسي قتلت ربيعه","https://www.aldiwan.net/poem30981.html","الرجز"],[66,"قال النبي مقال صدق لم يزل","https://www.aldiwan.net/poem38627.html","الكامل"],[66,"من غرس نعمته وترب سماحه","https://www.aldiwan.net/poem40335.html","الكامل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[80,"وراقصة بالسحر في حركاتها","https://www.aldiwan.net/poem31492.html","الطويل"],[44,"من بنو عامر من ابن الحباب","https://www.aldiwan.net/poem30069.html","الخفيف"],[44,"أبدت أسى أن رأتني مخلس القصب","https://www.aldiwan.net/poem30587.html","البسيط"],[87,"يا ناصر الحق على الباطل","https://www.aldiwan.net/poem8364.html","السريع"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"من غائب في الحب لم يؤب","https://www.aldiwan.net/poem62414.html","البسيط"],[48,"إني عجبت وفي الأيام معتبر","https://www.aldiwan.net/poem62445.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21082","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54851","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54742","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[45,"لا يَرِمْ رَبْعَكَ السّحابُ يَجُودُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31418",""],[64,"كانَت لِقَلبي أَهواءٌ مُفَرَّقَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=93392",""]],"verses":[["مِن غُمَّةٍ كَاللَيلِ شا","بَ لَها الذَوائِبُ وَالقُرونُ",0,"ن",1,0],["مِن غَمامٍ كَالمَتالي","يَنقُلُ اللَيلَ وَسوقَه",1,"ق",2,0],["من غَيْر لُبٍّ ولا مُراقَبةٍ","للهِ في موْرِد ولا صَدَرِ",2,"ر",1,0],["مِنْ غَادَةٍ خَلَبَ الأَلْبَابَ مَنْطِقُهَا","هِيَ الْفَرِيدَةُ فِي عَقْلٍ وَتِبْيَانِ",3,"ن",1,0],["مِن غَيرِ ما جُرمٍ سِوى ثِقَةٍ","مِنّي بِوَعدِكَ حينَ قُلتَ ثِقِ",4,"ق",1,0],["من غادة في حسنها غانيه","تبسم عن لألاء درّ نظيم",5,"م",1,0],["من غير سمعك يدري ما أرجعه","في الخصب من مستطاب الحمد صداح",6,"ح",1,0],["من غدا طاهراً كطهرك فينا","كانَ كلّ الشهور شهر صيامهْ",7,"م",2,0],["من غير أن تبأسَ منه بائسه","قد أفلتْ عنك النجومُ الناحِسَه",8,"س",2,0],["من غرس أيديكم جنت أيديكُمُ","كَرُمتْ مَجانيكمْ وطاب المغرِس",9,"س",1,0],["من غشوم كلما لنّا له","زاد بغياً وتمادى في العنُف",10,"ف",1,0],["من غدا سرجُهُ على ظهرِ طِرفٍ","فحرامٌ عليه شدُّ الحزام",11,"م",1,0],["من غيرِ إنذارٍ فأَحْمِلَ عُدَّتي","وأَخوضَهُ كالسَّابحِ العَوَّامِ",12,"م",1,0],["مِنْ غرامٍ مذَهَّبِ التَّاجِ ميْتٍ","وفؤادٍ مصفَّدٍ مغلولِ",13,"ل",1,0],["مَن غَرّهُ مِنّي خَلائقُ سَهلَةٌ","فالسمّ تَحتَ ليان مَسّ الأَرقَمِ",14,"م",1,0],["مَن غمامُ الجودِ مِن راحتِهِ","عصفت ريحٌ بِهِ فاِنقَشَعا",15,"ع",2,0],["مِن غَيرِ إِصقَابٍ يَكونُ مِنَ النَّوى","إِلا اللِّمامَ وَلا كَبيرَ وِصَالِ",16,"ل",1,0],["مَن غابَ مِنهُم لَم يَغِب عَن سَمعِهِ","وَضَميرِهِ وَفُؤادِهِ وَلِسانِهِ",17,"ن",2,0],["مِن غَزالٍ يَصيدُني أَو غَزالٍ","يَتَأَبّى مُمانِعَن لا أَصيدُه",18,"د",2,0],["مِن غائِبٍ عَمّا عَناكُم لَم يَغِب","دَرَكَ العُيونِ وَحاضِرٍ لَم يَحضُرِ",19,"ر",1,0],["مِن غادَةٍ مُنِعَت وَتَمنَعُ نَيلَها","فَلَوَ انَّحا بُذِلَت لَنا لَم نَبذُلِ",20,"ل",1,0],["مِن غَيرِ ما يُلصِقُ المَلامَةَ إِل","لا سُخفَ رَأيٍ وَسائَها عُصُرُ",21,"ر",1,0],["مِن غَيرِ ما بُطْلٍ وَلا خَديعَه","حلّوا بِها المَنزِلَةَ الرَفيعَه",22,"ع",2,0],["مَن غابَ عَنكُمُ أَصلُهُ فَفِعالُه","تُنبيكُمُ عَن أَصلِهِ المُتَناهي",23,"ه",2,0],["مِن غَرسِ نِعمَتِهِ وَتُربِ سَماحِهِ","وَرَبيبِ دَولَتِهِ وَراضِعِ جودِه",24,"د",2,1],["من غُلْبِ أسُودٍ ما عَمَرُوا","إلّا آجامَ ظباً وقَنَا",25,"ن",2,0],["من غادةٍ في وصل هجرانها","يَقْنَعُ منها بوصالِ الحُلُم",26,"م",1,0],["مَن غَدا في كُلِّ فَضلٍ أَوحَداً","ذَلِكَ الأَوحَدُ كلّ العَدَدِ",27,"د",1,0],["مُنَغّمَةٌ أَلفاظَهَا بِتَرنُّمٍ","كَسا مَعبِداً مِن عِزِّهِ ذِلَّةَ العَبدِ",28,"د",1,0],["مَن غَدَت خَيلُهُ عَلى سَرحِ شِعري","وَهوَ لِلحَينِ راتِعٌ في كِتابي",29,"ب",2,0],["مِن غَيرِ ما سَبَبٍ ماضٍ كَفى سَبَباً","لِلحُرِّ أَن يَعتَفي حُرّاً بِلا سَبَبِ",30,"ب",1,0],["مِنْ غَيْرِ مَا ذَنْبٍ سِوَى مَنْطِقٍ","ذِي رَوْنَقٍ كَالصَّارِمِ الْقَاطِلِ",31,"ل",1,0],["مَن غابَ عَنهُم مِن بَني الدُنيا فَما","عَرَفَ المَسيخَ وَلا رَأى عِزريلا",32,"ل",2,0],["مِن غادة عذبني نأيها","ما ضَرَّ لَو كُنتُ وَإِيّاها",33,"ا",3,0],["مَن غادَرَ السَيِّدَ السِبَطرَ لَدى ال","مَعرَكِ عَمراً مُخَضَّباً تَرِبا",34,"ب",2,0],["منْ غيرُ أحمدَ جاءَ يَحْمَدُ رَبَّهُ","حَمْداً جَدِيداً بالمزِيدِ كَفِيلا",35,"ل",2,0],["مَن غائِبٌ في الحُبِّ لَم يَؤُبِ","لا شَيئاَ يَرقُبُهُ سِوى العَطَبِ",36,"ب",1,1],["مِن غَيرِ ذَنبٍ وَلا شَيءٍ قُرِفتُ بِهِ","أَبدى خَبيثَتَهُ ظُلماً وَأُغرِيَ بي",37,"ي",1,0],["من غش نفسا جمع المظالما","ماذا ترى فيمن يغش عالما",38,"م",2,0],["مِن غَيرِ ما حاجَةٍ إلاَّ لِيجعَلَنا","فَوقَ البَرِيَّةِ أَرباباً كما فَعَلا",39,"ل",2,0],["مِنْ غَيْرِ ما ذَنْبٍ جَنَيْتُ وَإِنَّما","بُغْضُ الْفَضِيلَةِ شِيمَةُ الْجُهَلاءِ",40,"ا",2,0],["مِنْ غَادَةٍ سَالتْ غِوَاشُ الدُّجَى","بَيْنَ حَوَاشِي صُبْحِهَا السَّاطِعِ",41,"ع",1,0],["مِنْ غَد تَبْرَحُ خِدْرَ الكَاعِبِ","البِكْرِ فِي طُهْرِ",42,"ر",1,0],["مِنْ غيْرِ مِيعَادٍ تَقدَّ","مَ لِلرَّحِيلِ المُزْمَعِ",43,"ع",1,0],["مِنْ غُرِّ آيَاتِ المَعَا","رِفِ وَالصِّنَاعَاتِ المُفِيدَهْ",44,"د",2,0],["مِنْ غَيَابَاتِ الدُّجَى أَبْصَارُهُمْ","تَطْلُبُ النُّورَ وَتأْبَى أَنْ تَقِرَّا",45,"ر",2,0],["مِنْ غِذَاءِ النُّورِ مِنْ سَقْيِ النَّدَى","مِنْ حُنُوِّ اللَّيْلِ مِنْ ضمِّ الثَّرَى",46,"ر",2,0],["مَنْ غَابَ عَنْ أَحْبَابِه فَلَهُ بِه","فِي الآنِ بَعْدَ الآنَ عَوْدٌ أَحْمَدُ",47,"د",1,0],["مَنْ غاضَ مَاءُ صِباهُ","رَأَى الْحَيَاةَ سَرَابا",48,"ب",2,0],["منْ غَزَالٍ يَصِيدُني، أو غَزَالٍ","يَتَأبّى مُمَانعاً لا أصِيدُهْ",49,"د",2,0],["من غص داوى بشرب الماء غصته","فكيف يصنع من قد غص في الماء؟",50,"ا",1,1]]}