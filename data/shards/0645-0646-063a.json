],[531,"من غدا مستحكم الطمع","https://www.aldiwan.net/poem37326.html","المديد"],[540,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[546,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[553,"إن كنت أزمعت عن وجدى بكم هربا","https://www.aldiwan.net/poem47310.html","البسيط"],[560,"يا نسيم الحي عني","https://www.aldiwan.net/poem33633.html","مجزوء الرمل"],[560,"مالي لقد أصبحت من نيل المنى","https://www.aldiwan.net/poem33789.html","الكامل"],[560,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[560,"ليلة ذا القدر ليلة الجمع","https://www.aldiwan.net/poem34371.html","المنسرح"],[560,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[560,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[564,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[569,"وزائر والعيون هاجعة","https://www.aldiwan.net/poem69608.html","المنسرح"],[569,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/29530","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18995","الكامل"]],"verses":[["مِن غُمَّةٍ كَاللَيلِ شا","بَ لَها الذَوائِبُ وَالقُرونُ",0,"ن",1,0],["مِن غَمامٍ كَالمَتالي","يَنقُلُ اللَيلَ وَسوقَه",1,"ق",2,0],["من غَيْر لُبٍّ ولا مُراقَبةٍ","للهِ في موْرِد ولا صَدَرِ",2,"ر",1,0],["مِنْ غَادَةٍ خَلَبَ الأَلْبَابَ مَنْطِقُهَا","هِيَ الْفَرِيدَةُ فِي عَقْلٍ وَتِبْيَانِ",3,"ن",1,0],["مِن غَيرِ ما جُرمٍ سِوى ثِقَةٍ","مِنّي بِوَعدِكَ حينَ قُلتَ ثِقِ",4,"ق",1,0],["من غادة في حسنها غانيه","تبسم عن لألاء درّ نظيم",5,"م",1,0],["من غير سمعك يدري ما أرجعه","في الخصب من مستطاب الحمد صداح",6,"ح",1,0],["من غدا طاهراً كطهرك فينا","كانَ كلّ الشهور شهر صيامهْ",7,"م",2,0],["من غير أن تبأسَ منه بائسه","قد أفلتْ عنك النجومُ الناحِسَه",8,"س",2,0],["من غرس أيديكم جنت أيديكُمُ","كَرُمتْ مَجانيكمْ وطاب المغرِس",9,"س",1,0],["من غشوم كلما لنّا له","زاد بغياً وتمادى في العنُف",10,"ف",1,0],["من غدا سرجُهُ على ظهرِ طِرفٍ","فحرامٌ عليه شدُّ الحزام",11,"م",1,0],["من غيرِ إنذارٍ فأَحْمِلَ عُدَّتي","وأَخوضَهُ كالسَّابحِ العَوَّامِ",12,"م",1,0],["مِنْ غرامٍ مذَهَّبِ التَّاجِ ميْتٍ","وفؤادٍ مصفَّدٍ مغلولِ",13,"ل",1,0],["مَن غَرّهُ مِنّي خَلائقُ سَهلَةٌ","فالسمّ تَحتَ ليان مَسّ الأَرقَمِ",14,"م",1,0],["مَن غمامُ الجودِ مِن راحتِهِ","عصفت ريحٌ بِهِ فاِنقَشَعا",15,"ع",2,0],["مِن غَيرِ إِصقَابٍ يَكونُ مِنَ النَّوى","إِلا اللِّمامَ وَلا كَبيرَ وِصَالِ",16,"ل",1,0],["مَن غابَ مِنهُم لَم يَغِب عَن سَمعِهِ","وَضَميرِهِ وَفُؤادِهِ وَلِسانِهِ",17,"ن",2,0],["مِن غَزالٍ يَصيدُني أَو غَزالٍ","يَتَأَبّى مُمانِعَن لا أَصيدُه",18,"د",2,0],["مِن غائِبٍ عَمّا عَناكُم لَم يَغِب","دَرَكَ العُيونِ وَحاضِرٍ لَم يَحضُرِ",19,"ر",1,0],["مِن غادَةٍ مُنِعَت وَتَمنَعُ نَيلَها","فَلَوَ انَّحا بُذِلَت لَنا لَم نَبذُلِ",20,"ل",1,0],["مِن غَيرِ ما يُلصِقُ المَلامَةَ إِل","لا سُخفَ رَأيٍ وَسائَها عُصُرُ",21,"ر",1,0],["مِن غَيرِ ما بُطْلٍ وَلا خَديعَه","حلّوا بِها المَنزِلَةَ الرَفيعَه",22,"ع",2,0],["مَن غابَ عَنكُمُ أَصلُهُ فَفِعالُه","تُنبيكُمُ عَن أَصلِهِ المُتَناهي",23,"ه",2,0],["مِن غَرسِ نِعمَتِهِ وَتُربِ سَماحِهِ","وَرَبيبِ دَولَتِهِ وَراضِعِ جودِه",24,"د",2,1],["من غُلْبِ أسُودٍ ما عَمَرُوا","إلّا آجامَ ظباً وقَنَا",25,"ن",2,0],["من غادةٍ في وصل هجرانها","يَقْنَعُ منها بوصالِ الحُلُم",26,"م",1,0],["مَن غَدا في كُلِّ فَضلٍ أَوحَداً","ذَلِكَ الأَوحَدُ كلّ العَدَدِ",27,"د",1,0],["مُنَغّمَةٌ أَلفاظَهَا بِتَرنُّمٍ","كَسا مَعبِداً مِن عِزِّهِ ذِلَّةَ العَبدِ",28,"د",1,0],["مَن غَدَت خَيلُهُ عَلى سَرحِ شِعري","وَهوَ لِلحَينِ راتِعٌ في كِتابي",29,"ب",2,0],["مِن غَيرِ ما سَبَبٍ ماضٍ كَفى سَبَباً","لِلحُرِّ أَن يَعتَفي حُرّاً بِلا سَبَبِ",30,"ب",1,0],["مِنْ غَيْرِ مَا ذَنْبٍ سِوَى مَنْطِقٍ","ذِي رَوْنَقٍ كَالصَّارِمِ الْقَاطِلِ",31,"ل",1,0],["مَن غابَ عَنهُم مِن بَني الدُنيا فَما","عَرَفَ المَسيخَ وَلا رَأى عِزريلا",32,"ل",2,0],["مِن غادة عذبني نأيها","ما ضَرَّ لَو كُنتُ وَإِيّاها",33,"ا",3,0],["مَن غادَرَ السَيِّدَ السِبَطرَ لَدى ال","مَعرَكِ عَمراً مُخَضَّباً تَرِبا",34,"ب",2,0],["منْ غيرُ أحمدَ جاءَ يَحْمَدُ رَبَّهُ","حَمْداً جَدِيداً بالمزِيدِ كَفِيلا",35,"ل",2,0],["مَن غائِبٌ في الحُبِّ لَم يَؤُبِ","لا شَيئاَ يَرقُبُهُ سِوى العَطَبِ",36,"ب",1,1],["مِن غَيرِ ذَنبٍ وَلا شَيءٍ قُرِفتُ بِهِ","أَبدى خَبيثَتَهُ ظُلماً وَأُغرِيَ بي",37,"ب",2,0],["من غش نفسا جمع المظالما","ماذا ترى فيمن يغش عالما",38,"م",2,0],["مِن غَيرِ ما حاجَةٍ إلاَّ لِيجعَلَنا","فَوقَ البَرِيَّةِ أَرباباً كما فَعَلا",39,"ل",2,0],["مِنْ غَيْرِ ما ذَنْبٍ جَنَيْتُ وَإِنَّما","بُغْضُ الْفَضِيلَةِ شِيمَةُ الْجُهَلاءِ",40,"ا",2,0],["مِنْ غَادَةٍ سَالتْ غِوَاشُ الدُّجَى","بَيْنَ حَوَاشِي صُبْحِهَا السَّاطِعِ",41,"ع",1,0],["مِنْ غَد تَبْرَحُ خِدْرَ الكَاعِبِ","البِكْرِ فِي طُهْرِ",42,"ر",1,0],["مِنْ غيْرِ مِيعَادٍ تَقدَّ","مَ لِلرَّحِيلِ المُزْمَعِ",43,"ع",1,0],["مِنْ غُرِّ آيَاتِ المَعَا","رِفِ وَالصِّنَاعَاتِ المُفِيدَهْ",44,"د",2,0],["مِنْ غَيَابَاتِ الدُّجَى أَبْصَارُهُمْ","تَطْلُبُ النُّورَ وَتأْبَى أَنْ تَقِرَّا",45,"ر",2,0],["مِنْ غِذَاءِ النُّورِ مِنْ سَقْيِ النَّدَى","مِنْ حُنُوِّ اللَّيْلِ مِنْ ضمِّ الثَّرَى",46,"ر",2,0],["مَنْ غَابَ عَنْ أَحْبَابِه فَلَهُ بِه","فِي الآنِ بَعْدَ الآنَ عَوْدٌ أَحْمَدُ",47,"د",1,0],["مَنْ غاضَ مَاءُ صِباهُ","رَأَى الْحَيَاةَ سَرَابا",48,"ب",2,0],["من غلا اللي يقتل أزهوّه مه انّه يزهي","من سحاه .. ومن فرط حسنه .. وكثر أحسانه",49,"ن",2,0],["منْ غَزَالٍ يَصِيدُني، أو غَزَالٍ","يَتَأبّى مُمَانعاً لا أصِيدُهْ",50,"د",2,0],["من غوالي دموعنا الخمر والعطر","ونعمى دمائنا الأرجوان",51,"ن",1,0],["من غص داوى بشرب الماء غصته","فكيف يصنع من قد غص في الماء؟",52,"ا",1,1],["مِن غَير أَمر شَرَفا أَحياءُنا","إِذ لَيسَ نادينا سِوى ناديكُما",53,"م",2,0],["من غير آداب قلب","وكم لقولك زله",54,"ل",2,0],["مُنَغَّصُ العَيش من لا يَرتضى أبداً","حالاً ولم يُلفَ إلّا طامحَ البَصر",55,"ر",1,0],["من غير ما وهن ولا خوف المللْ","ولسان حال يصدق المتكلّما",56,"م",2,0],["مَن غير إسماعيل بعدكَ يقتفي","في فتح أبوابِ الخيال خطاكا",57,"ك",2,0],["من غر مهجوم الربا رعته","بفيلق يعدم من غرمه",58,"م",2,0],["مِن غَيرِ ما وَهنٍ وَلَكِنّي اِمرُؤٌ","أَصونُ عِرضاً لَم يُدَنِّسهُ الطَخا",59,"ا",1,0],["مِن غَيرِ شَيءٍ سِوى قَصرٍ بِأَلسُنِنا","عَمّا يُعابُ وَطُولٍ في عَوالينا",60,"ن",2,0],["من غالب الدهر كان الدهر غالبه","قسراً واللدهر إحلاء وإمرار",61,"ر",1,0],["من غابة الغزلان","فررت يا شادن",62,"ن",1,0],["مِن غِلمَةٍ بِجَمالِهِم نارُ الهَوى","وَبِبَأسِهِم نارُ الوَغى تَتَضَرَّمُ",63,"م",1,0],["مِن غَيرِ خَمرٍ يا للكَئيبِ المَشوق","يَندُبُ الأَوطان",64,"ن",1,0],["من غفوةِ الجهّالِ كانت يقظتي","يا صاحبي لا توقظِ المستيقظا",65,"ظ",2,0],["من غصنِ قلبكِ زهرُ الحبّ ينتثرُ","أليسَ لي بعدَهُ ظلٌّ ولا ثمرُ",66,"ر",1,1],["من غزَّةِ القصوى إلى يافا إِلى","حيفا إِلى عكاء صدقُ مَواعد",67,"د",1,0],["مِن غَيرِ مَقلِيَةٍ وَإِنَّ حِبالَها","لَيسَت بِأَرمامٍ وَلا أَقطاعِ",68,"ع",1,0],["من غيبةٍ وغدرِ","وَخدعةٍ ومكرِ",69,"ر",1,0],["من غانياتٍ كالرَّبا","رِب قاصرات الطَرفِ حورِ",70,"ر",1,0],["مِن غَيرِ نَقصٍ وَخَدشِ","بَل بِالكَمالِ السامي",71,"م",2,0],["مَن غالَهُ مَخوفٌ","فَعاصِمٌ أَمانُ",72,"ن",1,0],["مِن غَيرِ ميعاد أَتى فَتَضاعَفَت","لَقَد ومه الحسنات واللَذّات",73,"ت",1,0],["من غَيثِ مكرمةٍ وليثِ كتيبةٍ","وغنَى فَقيرٍ وانتعاشِ صريع",74,"ع",1,0],["من غَيْثِ جُودٍ انهمَر","ولَيثِ بأسٍ استَعر",75,"ر",1,0],["من غَرْسِ وُدٍّ مُدَّخَر","هذا المَسيرُ يُبتَدَر",75,"ر",1,0],["من غادةٍ أمِنت وقد","سفكت دمي ثورات ثائِر",76,"ر",1,0],["من غير إخلالٍ بحفظ الواجبِ","ولا قمار وهو سمُّ الكَاسبِ",77,"ب",1,0],["من غير حصر وتعيين","فضل ومن من الله",78,"ه",1,0],["من غر يات المعارف","والصناعات المفيده",79,"د",2,0],["مَنْ غنْ جَرَتْ مَعَهُ الفحولُ إلى مدى","قصرتْ خطاهمْ عَن خُطاه وَفَاتا",80,"ت",2,0],["مَنْ غيرُه رُدّتْ لَه شمسُ الضّحَى","وكفاهُ فضلاً في الأَنامِ ومَفخرا",81,"ر",2,0],["من غير تحريف ولا تصحيف","وابدأ بعلم النحو والتصريف",82,"ف",1,0],["من غاب شخصه عنا لا سوى","وهو عن المهجة لا يغفل",83,"ل",1,0],["من غير تقدير اشتراك في البنا","لم لا يكون الوجه ذاك جميلا",84,"ل",2,0],["من غبار يغشاهما ودخان","ويغطي العيون من حرماتك",85,"ك",1,0],["من غربتي عن سفح صن","عا وابتعادي عن صحابي",86,"ب",2,0],["من غرامٍ رمى به كلّ مرمى","يتلظَّى فلم يجد عنه بدَّا",87,"د",2,0],["مِن غَير ما فُحشٍ يَكونُ بِهِم","في مُنتَجِ المُهُرات وَالمُهر",88,"ر",1,0],["من غابَ يشهدُ أنّ الله بجّلَهُ","وأنه أوحدُ الدنيا وإن حضَرا",89,"ر",2,0],["من غناءٍ أَلذ من نشوة الكأ","س وأشهى من صبوةٍ مستثاره",90,"ر",2,0],["من غير التاريخ من إيحائه","وأثار نخوتنا برغم رميمنا",91,"ن",2,0],["من غيب الشاعر الخنذيذ عن أملي","وأى فاتنةٍ قد خصَّه فوها",92,"و",3,0],["من غصَّ في دار السلام وإنما","هي حين تعمُرُ بيضةُ الإسلامِ",93,"م",1,0],["من غُبَّر السِّيَرِ التي سلفتْ لكم","والمجدِ آخرهم يريك الأوّلا",94,"ل",2,0],["مِن غالبي شمس العلا","على مكان المطلعِ",95,"ع",1,0],["من غِلمةٍ تحاشدوا على الندَى","تحاشُدَ الإبْلِ على الأورادِ",96,"د",1,0],["من غير ما مطرٍ ولكن لزْبةٌ","أمْهى عوارقَها عُصوفُ الشمألِ",97,"ل",1,0],["من غير مزج واتصال للفتى","فيه به معنى الملام أقاح",98,"ح",1,0],["من غيَّرَ الأَيَّامُ أحوالَهُ","وشيَّبَتْ رغماً لهُ مِفْرَقَهْ",99,"ق",2,0],["مَنْ غَدا مُسْتَحْكِمَ الطَّمعِ","عاشَ طُولَ الدَّهْرِ في جَزَعِ",100,"ع",1,1],["مَن غُرِسَت في حَشَا النَّاسِ مَحَبَّتُهُ","وَهَيبَةٌ له مِن قَاصٍ ومِن دانِ",101,"ن",1,0],["من غبطة الريح من أنفاس غبطتها","من خضرة الماء من نافورة الخصب",102,"ب",1,0],["من غير جرمٍ ولا عذرٍ لمعتذرٍ","مللتُمُ كَلِفاً لا يعرف المَلَلا",103,"ل",2,0],["من غرام واشتياق","نحو طه وابن طه",104,"ه",1,0],["من غير ما صور تغيره ولا","هو بالظهور بها يكون مكوّنا",105,"ن",2,0],["من غير تأثير لهم في كل ما","يكون من ذلك باستئصال",106,"ل",1,0],["من غير فرق لدى بصائرنا","بين جماد وبين ذي لمع",107,"ع",1,0],["من غاظه أمر فقد جهل الذي","هو حاكم وهناك منه أغيظ",108,"ظ",1,0],["من غير ظلم وحاشا الله يظلم من","عليه يحكم عن علم بإجلاء",109,"ا",2,0],["من غابَ عن عينٍ فسَوفَ يغيِبُ عن","قَلبٍ فتِلكَ وِثاقُهُ في المَشهَدِ",110,"د",1,0],["مُنَغِّصٌ وَصْلَهُ بِحِشْمَتِهِ","يَعْتَدِلُ اليَأْسُ فِيْهِ والطَّمَعُ",111,"ع",1,0],["مِنْ غَيْرِ تَدْمَاءِ الثَّغَرْ","مِنْهُ بِنَابٍ وَظُفُرْ",112,"ر",1,0],["مِن غَيرِ ما جُرمٍ أَكونُ جَنَيتُهُ","فيهِم وَلا أَنا إِن نُسِبتُ قَذيفُ",113,"ف",1,0],["مِن غَيرِ لا عُدمٍ وَلَكِن شيمَةٌ","إِنَّ الكِرامَ هُمُ الكِرامُ طَبائِعا",114,"ع",2,0]]}