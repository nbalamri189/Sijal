://www.aldiwan.net/poem47411.html","الرجز"],[388,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[394,"ايقر همتك البعيده","https://www.aldiwan.net/poem11021.html","عموديه"],[399,"قاضي القضاة وعالم العلما الذي","https://www.aldiwan.net/poem46479.html","الكامل"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[400,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[400,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[400,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[400,"كل ما في الأكوان من آياتك","https://www.aldiwan.net/poem34100.html","الخفيف"],[400,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[413,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[425,"لا يبعدن قومي الذين هم","https://www.aldiwan.net/poem766.html",""],[429,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[451,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[451,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[456,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[456,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[456,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[459,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[480,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[498,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[527,"من غدا مستحكم الطمع","https://www.aldiwan.net/poem37326.html","المديد"],[536,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[542,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[549,"إن كنت أزمعت عن وجدى بكم هربا","https://www.aldiwan.net/poem47310.html","البسيط"],[556,"يا نسيم الحي عني","https://www.aldiwan.net/poem33633.html","مجزوء الرمل"],[556,"مالي لقد أصبحت من نيل المنى","https://www.aldiwan.net/poem33789.html","الكامل"],[556,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[556,"ليلة ذا القدر ليلة الجمع","https://www.aldiwan.net/poem34371.html","المنسرح"],[556,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[556,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[560,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[565,"وزائر والعيون هاجعة","https://www.aldiwan.net/poem69608.html","المنسرح"],[565,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"]],"verses":[["مِن غُمَّةٍ كَاللَيلِ شا","بَ لَها الذَوائِبُ وَالقُرونُ",0,"ن",1,0],["مِن غَمامٍ كَالمَتالي","يَنقُلُ اللَيلَ وَسوقَه",1,"ق",2,0],["من غَيْر لُبٍّ ولا مُراقَبةٍ","للهِ في موْرِد ولا صَدَرِ",2,"ر",1,0],["مِنْ غَادَةٍ خَلَبَ الأَلْبَابَ مَنْطِقُهَا","هِيَ الْفَرِيدَةُ فِي عَقْلٍ وَتِبْيَانِ",3,"ن",1,0],["مِن غَيرِ ما جُرمٍ سِوى ثِقَةٍ","مِنّي بِوَعدِكَ حينَ قُلتَ ثِقِ",4,"ق",1,0],["من غادة في حسنها غانيه","تبسم عن لألاء درّ نظيم",5,"م",1,0],["من غير سمعك يدري ما أرجعه","في الخصب من مستطاب الحمد صداح",6,"ح",1,0],["من غدا طاهراً كطهرك فينا","كانَ كلّ الشهور شهر صيامهْ",7,"م",2,0],["من غير أن تبأسَ منه بائسه","قد أفلتْ عنك النجومُ الناحِسَه",8,"س",2,0],["من غرس أيديكم جنت أيديكُمُ","كَرُمتْ مَجانيكمْ وطاب المغرِس",9,"س",1,0],["من غشوم كلما لنّا له","زاد بغياً وتمادى في العنُف",10,"ف",1,0],["من غدا سرجُهُ على ظهرِ طِرفٍ","فحرامٌ عليه شدُّ الحزام",11,"م",1,0],["من غيرِ إنذارٍ فأَحْمِلَ عُدَّتي","وأَخوضَهُ كالسَّابحِ العَوَّامِ",12,"م",1,0],["مِنْ غرامٍ مذَهَّبِ التَّاجِ ميْتٍ","وفؤادٍ مصفَّدٍ مغلولِ",13,"ل",1,0],["مَن غَرّهُ مِنّي خَلائقُ سَهلَةٌ","فالسمّ تَحتَ ليان مَسّ الأَرقَمِ",14,"م",1,0],["مَن غمامُ الجودِ مِن راحتِهِ","عصفت ريحٌ بِهِ فاِنقَشَعا",15,"ع",2,0],["مِن غَيرِ إِصقَابٍ يَكونُ مِنَ النَّوى","إِلا اللِّمامَ وَلا كَبيرَ وِصَالِ",16,"ل",1,0],["مَن غابَ مِنهُم لَم يَغِب عَن سَمعِهِ","وَضَميرِهِ وَفُؤادِهِ وَلِسانِهِ",17,"ن",2,0],["مِن غَزالٍ يَصيدُني أَو غَزالٍ","يَتَأَبّى مُمانِعَن لا أَصيدُه",18,"د",2,0],["مِن غائِبٍ عَمّا عَناكُم لَم يَغِب","دَرَكَ العُيونِ وَحاضِرٍ لَم يَحضُرِ",19,"ر",1,0],["مِن غادَةٍ مُنِعَت وَتَمنَعُ نَيلَها","فَلَوَ انَّحا بُذِلَت لَنا لَم نَبذُلِ",20,"ل",1,0],["مِن غَيرِ ما يُلصِقُ المَلامَةَ إِل","لا سُخفَ رَأيٍ وَسائَها عُصُرُ",21,"ر",1,0],["مِن غَيرِ ما بُطْلٍ وَلا خَديعَه","حلّوا بِها المَنزِلَةَ الرَفيعَه",22,"ع",2,0],["مَن غابَ عَنكُمُ أَصلُهُ فَفِعالُه","تُنبيكُمُ عَن أَصلِهِ المُتَناهي",23,"ه",2,0],["مِن غَرسِ نِعمَتِهِ وَتُربِ سَماحِهِ","وَرَبيبِ دَولَتِهِ وَراضِعِ جودِه",24,"د",2,1],["من غُلْبِ أسُودٍ ما عَمَرُوا","إلّا آجامَ ظباً وقَنَا",25,"ن",2,0],["من غادةٍ في وصل هجرانها","يَقْنَعُ منها بوصالِ الحُلُم",26,"م",1,0],["مَن غَدا في كُلِّ فَضلٍ أَوحَداً","ذَلِكَ الأَوحَدُ كلّ العَدَدِ",27,"د",1,0],["مُنَغّمَةٌ أَلفاظَهَا بِتَرنُّمٍ","كَسا مَعبِداً مِن عِزِّهِ ذِلَّةَ العَبدِ",28,"د",1,0],["مَن غَدَت خَيلُهُ عَلى سَرحِ شِعري","وَهوَ لِلحَينِ راتِعٌ في كِتابي",29,"ب",2,0],["مِن غَيرِ ما سَبَبٍ ماضٍ كَفى سَبَباً","لِلحُرِّ أَن يَعتَفي حُرّاً بِلا سَبَبِ",30,"ب",1,0],["مِنْ غَيْرِ مَا ذَنْبٍ سِوَى مَنْطِقٍ","ذِي رَوْنَقٍ كَالصَّارِمِ الْقَاطِلِ",31,"ل",1,0],["مَن غابَ عَنهُم مِن بَني الدُنيا فَما","عَرَفَ المَسيخَ وَلا رَأى عِزريلا",32,"ل",2,0],["مِن غادة عذبني نأيها","ما ضَرَّ لَو كُنتُ وَإِيّاها",33,"ا",3,0],["مَن غادَرَ السَيِّدَ السِبَطرَ لَدى ال","مَعرَكِ عَمراً مُخَضَّباً تَرِبا",34,"ب",2,0],["منْ غيرُ أحمدَ جاءَ يَحْمَدُ رَبَّهُ","حَمْداً جَدِيداً بالمزِيدِ كَفِيلا",35,"ل",2,0],["مَن غائِبٌ في الحُبِّ لَم يَؤُبِ","لا شَيئاَ يَرقُبُهُ سِوى العَطَبِ",36,"ب",1,1],["مِن غَيرِ ذَنبٍ وَلا شَيءٍ قُرِفتُ بِهِ","أَبدى خَبيثَتَهُ ظُلماً وَأُغرِيَ بي",37,"ي",1,0],["من غش نفسا جمع المظالما","ماذا ترى فيمن يغش عالما",38,"م",2,0],["مِن غَيرِ ما حاجَةٍ إلاَّ لِيجعَلَنا","فَوقَ البَرِيَّةِ أَرباباً كما فَعَلا",39,"ل",2,0],["مِنْ غَيْرِ ما ذَنْبٍ جَنَيْتُ وَإِنَّما","بُغْضُ الْفَضِيلَةِ شِيمَةُ الْجُهَلاءِ",40,"ا",2,0],["مِنْ غَادَةٍ سَالتْ غِوَاشُ الدُّجَى","بَيْنَ حَوَاشِي صُبْحِهَا السَّاطِعِ",41,"ع",1,0],["مِنْ غَد تَبْرَحُ خِدْرَ الكَاعِبِ","البِكْرِ فِي طُهْرِ",42,"ر",1,0],["مِنْ غيْرِ مِيعَادٍ تَقدَّ","مَ لِلرَّحِيلِ المُزْمَعِ",43,"ع",1,0],["مِنْ غُرِّ آيَاتِ المَعَا","رِفِ وَالصِّنَاعَاتِ المُفِيدَهْ",44,"د",2,0],["مِنْ غَيَابَاتِ الدُّجَى أَبْصَارُهُمْ","تَطْلُبُ النُّورَ وَتأْبَى أَنْ تَقِرَّا",45,"ر",2,0],["مِنْ غِذَاءِ النُّورِ مِنْ سَقْيِ النَّدَى","مِنْ حُنُوِّ اللَّيْلِ مِنْ ضمِّ الثَّرَى",46,"ر",2,0],["مَنْ غَابَ عَنْ أَحْبَابِه فَلَهُ بِه","فِي الآنِ بَعْدَ الآنَ عَوْدٌ أَحْمَدُ",47,"د",1,0],["مَنْ غاضَ مَاءُ صِباهُ","رَأَى الْحَيَاةَ سَرَابا",48,"ب",2,0],["منْ غَزَالٍ يَصِيدُني، أو غَزَالٍ","يَتَأبّى مُمَانعاً لا أصِيدُهْ",49,"د",2,0],["من غص داوى بشرب الماء غصته","فكيف يصنع من قد غص في الماء؟",50,"ا",1,1],["مِن غَير أَمر شَرَفا أَحياءُنا","إِذ لَيسَ نادينا سِوى ناديكُما",51,"م",2,0],["من غير آداب قلب","وكم لقولك زله",52,"ل",2,0],["مُنَغَّصُ العَيش من لا يَرتضى أبداً","حالاً ولم يُلفَ إلّا طامحَ البَصر",53,"ر",1,0],["من غير ما وهن ولا خوف المللْ","ولسان حال يصدق المتكلّما",54,"م",2,0],["مَن غير إسماعيل بعدكَ يقتفي","في فتح أبوابِ الخيال خطاكا",55,"ك",2,0],["من غر مهجوم الربا رعته","بفيلق يعدم من غرمه",56,"م",2,0],["مِن غَيرِ ما وَهنٍ وَلَكِنّي اِمرُؤٌ","أَصونُ عِرضاً لَم يُدَنِّسهُ الطَخا",57,"ا",1,0],["مِن غَيرِ شَيءٍ سِوى قَصرٍ بِأَلسُنِنا","عَمّا يُعابُ وَطُولٍ في عَوالينا",58,"ن",2,0],["من غالب الدهر كان الدهر غالبه","قسراً واللدهر إحلاء وإمرار",59,"ر",1,0],["من غابة الغزلان","فررت يا شادن",60,"ن",1,0],["مِن غِلمَةٍ بِجَمالِهِم نارُ الهَوى","وَبِبَأسِهِم نارُ الوَغى تَتَضَرَّمُ",61,"م",1,0],["مِن غَيرِ خَمرٍ يا للكَئيبِ المَشوق","يَندُبُ الأَوطان",62,"ن",1,0],["من غفوةِ الجهّالِ كانت يقظتي","يا صاحبي لا توقظِ المستيقظا",63,"ظ",2,0],["من غصنِ قلبكِ زهرُ الحبّ ينتثرُ","أليسَ لي بعدَهُ ظلٌّ ولا ثمرُ",64,"ر",1,1],["من غزَّةِ القصوى إلى يافا إِلى","حيفا إِلى عكاء صدقُ مَواعد",65,"د",1,0],["مِن غَيرِ مَقلِيَةٍ وَإِنَّ حِبالَها","لَيسَت بِأَرمامٍ وَلا أَقطاعِ",66,"ع",1,0],["من غيبةٍ وغدرِ","وَخدعةٍ ومكرِ",67,"ر",1,0],["من غانياتٍ كالرَّبا","رِب قاصرات الطَرفِ حورِ",68,"ر",1,0],["مِن غَيرِ نَقصٍ وَخَدشِ","بَل بِالكَمالِ السامي",69,"م",2,0],["مَن غالَهُ مَخوفٌ","فَعاصِمٌ أَمانُ",70,"ن",1,0],["مِن غَيرِ ميعاد أَتى فَتَضاعَفَت","لَقَد ومه الحسنات واللَذّات",71,"ت",1,0],["من غَيثِ مكرمةٍ وليثِ كتيبةٍ","وغنَى فَقيرٍ وانتعاشِ صريع",72,"ع",1,0],["من غَيْثِ جُودٍ انهمَر","ولَيثِ بأسٍ استَعر",73,"ر",1,0],["من غَرْسِ وُدٍّ مُدَّخَر","هذا المَسيرُ يُبتَدَر",73,"ر",1,0],["من غادةٍ أمِنت وقد","سفكت دمي ثورات ثائِر",74,"ر",1,0],["من غير إخلالٍ بحفظ الواجبِ","ولا قمار وهو سمُّ الكَاسبِ",75,"ب",1,0],["من غير حصر وتعيين","فضل ومن من الله",76,"ه",1,0],["من غر يات المعارف","والصناعات المفيده",77,"د",2,0],["مَنْ غنْ جَرَتْ مَعَهُ الفحولُ إلى مدى","قصرتْ خطاهمْ عَن خُطاه وَفَاتا",78,"ت",2,0],["مَنْ غيرُه رُدّتْ لَه شمسُ الضّحَى","وكفاهُ فضلاً في الأَنامِ ومَفخرا",79,"ر",2,0],["من غير تحريف ولا تصحيف","وابدأ بعلم النحو والتصريف",80,"ف",1,0],["من غاب شخصه عنا لا سوى","وهو عن المهجة لا يغفل",81,"ل",1,0],["من غير تقدير اشتراك في البنا","لم لا يكون الوجه ذاك جميلا",82,"ل",2,0],["من غبار يغشاهما ودخان","ويغطي العيون من حرماتك",83,"ك",1,0],["من غربتي عن سفح صن","عا وابتعادي عن صحابي",84,"ي",1,0],["من غرامٍ رمى به كلّ مرمى","يتلظَّى فلم يجد عنه بدَّا",85,"د",2,0],["مِن غَير ما فُحشٍ يَكونُ بِهِم","في مُنتَجِ المُهُرات وَالمُهر",86,"ر",1,0],["من غابَ يشهدُ أنّ الله بجّلَهُ","وأنه أوحدُ الدنيا وإن حضَرا",87,"ر",2,0],["من غناءٍ أَلذ من نشوة الكأ","س وأشهى من صبوةٍ مستثاره",88,"ر",2,0],["من غير التاريخ من إيحائه","وأثار نخوتنا برغم رميمنا",89,"ن",2,0],["من غيب الشاعر الخنذيذ عن أملي","وأى فاتنةٍ قد خصَّه فوها",90,"و",3,0],["من غصَّ في دار السلام وإنما","هي حين تعمُرُ بيضةُ الإسلامِ",91,"م",1,0],["من غُبَّر السِّيَرِ التي سلفتْ لكم","والمجدِ آخرهم يريك الأوّلا",92,"ل",2,0],["مِن غالبي شمس العلا","على مكان المطلعِ",93,"ع",1,0],["من غِلمةٍ تحاشدوا على الندَى","تحاشُدَ الإبْلِ على الأورادِ",94,"د",1,0],["من غير ما مطرٍ ولكن لزْبةٌ","أمْهى عوارقَها عُصوفُ الشمألِ",95,"ل",1,0],["من غير مزج واتصال للفتى","فيه به معنى الملام أقاح",96,"ح",1,0],["من غيَّرَ الأَيَّامُ أحوالَهُ","وشيَّبَتْ رغماً لهُ مِفْرَقَهْ",97,"ق",2,0],["مَنْ غَدا مُسْتَحْكِمَ الطَّمعِ","عاشَ طُولَ الدَّهْرِ في جَزَعِ",98,"ع",1,1],["مَن غُرِسَت في حَشَا النَّاسِ مَحَبَّتُهُ","وَهَيبَةٌ له مِن قَاصٍ ومِن دانِ",99,"ن",1,0],["من غبطة الريح من أنفاس غبطتها","من خضرة الماء من نافورة الخصب",100,"ب",1,0],["من غير جرمٍ ولا عذرٍ لمعتذرٍ","مللتُمُ كَلِفاً لا يعرف المَلَلا",101,"ل",2,0],["من غرام واشتياق","نحو طه وابن طه",102,"ه",1,0],["من غير ما صور تغيره ولا","هو بالظهور بها يكون مكوّنا",103,"ن",2,0],["من غير تأثير لهم في كل ما","يكون من ذلك باستئصال",104,"ل",1,0],["من غير فرق لدى بصائرنا","بين جماد وبين ذي لمع",105,"ع",1,0],["من غاظه أمر فقد جهل الذي","هو حاكم وهناك منه أغيظ",106,"ظ",1,0],["من غير ظلم وحاشا الله يظلم من","عليه يحكم عن علم بإجلاء",107,"ا",2,0],["من غابَ عن عينٍ فسَوفَ يغيِبُ عن","قَلبٍ فتِلكَ وِثاقُهُ في المَشهَدِ",108,"د",1,0],["مُنَغِّصٌ وَصْلَهُ بِحِشْمَتِهِ","يَعْتَدِلُ اليَأْسُ فِيْهِ والطَّمَعُ",109,"ع",1,0],["مِنْ غَيْرِ تَدْمَاءِ الثَّغَرْ","مِنْهُ بِنَابٍ وَظُفُرْ",110,"ر",1,0]]}