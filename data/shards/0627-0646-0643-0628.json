{"poems":[[50,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[411,"أنكب عن عذري وإبراز حجتي","https://www.aldiwan.net/poem49617.html","الطويل"],[520,"إن كبرت سني فلي همة","https://www.aldiwan.net/poem12156.html","السريع"],[556,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77647","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216532",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135839","الرجز"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123862","المنسرح"],[5431,"قالت لي القدس...","https://www.poetsgate.com/ViewPoem.aspx?id=202677",""],[5561,"الثائرون","https://www.poetsgate.com/ViewPoem.aspx?id=207881",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""],[5756,"المملكة عندنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=5189",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["إِن كَبَّرَ الناسُ غَنّى","وَإِن تَغَنَّوا يَكبَر",0,"ر",1,0],["إن كَبّرتْ بأقاصي الصين مِئْذَنةٌ","سمعتَ في الغربِ تهليلَ المصلّينَا",1,"ن",2,0],["أنُكِّبُ عن عُذري وإبرازِ حُجَّتي","ولي ألسُنٌ بالاحتجاجِ فِصاحُ",2,"ح",1,1],["إن كبرت سني فلي همة","لم يتأثر فضلها بالكبر",3,"ر",1,1],["إنّ كِبْرَ الفتى ولا فضلَ فيه","عند أهل النُّهى يكون جنونا",4,"ن",2,0],["إنْ كبا عن تَلْعَةٍ للمخازي","نزع العِرقُ به فَتَراقى",5,"ق",2,0],["إِنَّك بِالضَرب الأَليم تكسبُ","فَاضرب وَخُذ ما تَشتَهي وَتَطلبُ",6,"ب",1,0],["أنكب عن عاداتهم ورسومهم","ولا أبتغي للنفس رسماً سوى رسمي",7,"م",2,0],["انكبّ كوب الشاهي","وعَلى الكرافي سالْ",8,"ل",1,1],["إنك بالحقِّ إلهي تقضي","فاقضِ عليهم بالذي لي يُرضي",9,"ي",1,0],["انكبها حسرة وبي لهب","يصعد من زفرتي وانفاسي",10,"س",2,0],["أنْ كبّلوك وسدّ الضيقُ مخرجه","لم يبقَ إلا لهاثُ الذلّ..تركيعُ!!",11,"ع",1,0],["إنْ كبوةٌ صفعتْ وجوهَ أحِبَّةٍ","النارُ تثأرُ للّذينَ تنادوا",12,"د",3,0],["إِنْ كَبَا فِي الطَّرِيقِ يَوْمًا حِصَانٌ","فَغَدًا يَنْهَبُ الطَّرَيقَ الْحِصَانُ",13,"ن",1,0],["إِنْ كَبَّرَتْ لِلْهُدَى فَالْكَوْنُ مِئْذَنَةٌ","إِنْ زَمْجَرَتْ لِلْعِدَا تَنْقَصُّ بُرْكَانَا",14,"ن",2,0],["ان كبرت القاله والارياق يباس","يظيم عدوانه ولا يستظيمي",15,"م",2,0],["إن كبّروا هزّ الفضا صوت تكبير","ولسجودهم في ناصيتهم علامة",16,"م",2,0],["أنكبةٌ ما أُعاني أم رؤى حُلُمٍ","سهتْ فأبقتهُ في روحي دواهيه ِ",17,"ي",2,0]]}