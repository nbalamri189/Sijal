{"poems":[[90,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[74,"أيها الكامل قصرا","https://www.aldiwan.net/poem18208.html","مجزوء الرمل"],[93,"عاد للأرض مع الصيف صباها","https://www.aldiwan.net/poem62805.html","عموديه"],[94,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[91,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[87,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[60,"أيها الكاتب ما تكتب","https://www.aldiwan.net/poem30941.html","مجزوء الرمل"],[33,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85861","الخفيف"],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[33,"وَلَقَدْ أَشْهَدُ المُحَدِّثَ عِنْدَ کلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19117&r=&rc=379",""],[228,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[358,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[469,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[567,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[580,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63782","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77362","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132960","الخفيف"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117208","الخفيف"],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[5064,"حِواريّة البرق والرّيح","https://www.poetsgate.com/ViewPoem.aspx?id=199142",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[4394,"أيها الكاتمُ الحديث الذي","https://www.poetsgate.com/ViewPoem.aspx?id=208623",""],[5725,"ردى الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=187314",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[5956,"هدايا للأطفال العرب من صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=192184",""]],"verses":[["أيها الكاظمي نم مستريحاً","حيث لا مبغض ولا إيذاء",0,"ا",2,0],["أيها الكامل قصراً","وولاءً وثناء",1,"ا",2,1],["أَيُّها الكابِحُ عَن لَذّاتِها","نَفسَهُ هَيهاتِ لَن تُعطى سِواها",2,"ا",3,0],["أَيُّها الكونُ أَيُّها القَدَرُ الأَعمى","قِفُوا حيثُ أَنتُمُ أَو فسيرُوا",3,"ر",3,0],["ايها الكوكب انطفأت بليل","بغتة بعد ذلك الاشراق",4,"ق",1,0],["ايها الكهرباء انت جوابي","للجماهير عند كل سؤال",5,"ل",1,0],["أَيُّها الكاتِبُ المُصَوِّرُ صَوِّر","مِصرَ بِالمَنظَرِ الأَنيقِ الخَليقِ",6,"ق",1,1],["أَيُّها الكاتِبُ ما تَك","تُبُ مَكتوبٌ عَلَيك",7,"ك",1,1],["أَيُّها الكاشِحُ المُعَرِّضُ بِالصَر","مِ تَزَحزَح فَما لَها الهِجرانُ",8,"ن",1,0],["أيها الكفر أنت لي","قبل خلقي مقدر",9,"ر",1,0],["أيها \" الكوكبُ الجديدُ \" تخيرْني","إذا ارتحت ، بسمةً في المباسم",10,"م",1,0],["أيّها الكافرون هذي دموعي","من رسالات وحيها الإيمان",11,"ن",1,0],["أَيُّهَا الكَاشِحُ المُعَرِّضُ بِکلصَّرْ","مِ، تَزَحْزَحْ فَمَا لَهَا الهِجْرَانُ",12,"ن",1,0],["أَيُّها الكوخ وَالعُيون السكارى","بِخُمورٍ لَم تَمتَزِج بِعَذابِ",13,"ب",1,0],["أيها الكوكب الذي غاب في التر","ب حزين الشعاع والومضات",14,"ت",1,0],["أيها الكوكب المشعّ من الشر","فةِ نورا يضيء قلب النهار",15,"ر",1,0],["أَيُّها الكَوكَب الَّذي","مِن سَما الفَضل أَشرَقا",16,"ق",2,0],["أَيُّها الكوفِيُّ أَنشد","هذِهِ وَاِحلُل حِباها",17,"ا",3,0],["أيها الكامل المروءة والمفحم","فضلاً أولي القوافي الفصاح",18,"ح",1,1],["أيُّها الكاملُ الصّفِاتِ اللَّواتي","جَمَعت من لطائفٍ ما تفرَّقْ",19,"ق",1,0],["أَيُّها الكاسِرُ الغمودَ وما يع","لَم أَنَّ الأجْفَانَ مِنْهُ الْغُمود",20,"د",1,0],["أيها الكاشحون فُكُّوا أسيراً","هو أولى الورى بفكِّ الإسار",21,"ر",1,0],["أَيُّها الكاسِفُ أَقمارَ السّما","وَهوَ شَمسٌ في الضُّحى والغلَسِ",22,"س",1,1],["أَيُّها الكَرمُ كَم جَنَيتَ حُروباً","حُمَّ فيها عَلى البَرايا البَلاءُ",23,"ا",2,0],["أيها الكاتبُ الذي حيَّر الخل","قَ بخطَّين بين مسكٍ ونَقسِ",24,"س",1,1],["أيّها الكاتم الحديث وقد طا","لَ به الأمرُ وانتهى الكِتمانُ",25,"ن",1,0],["أيها الكاتب حقاً إن بي","ملئت بالزيف ظلماً كتب",26,"ب",1,0],["أيها الكنز الذي يطبه","من يعاني للمعاني والمعاد",27,"د",1,0],["أَيُّها الكَائِنُ الخُرَافِيُّ أَقدِمْ","كَمْ شغَلْنَا الحيَاةَ جَهْلاً وعَارَا",28,"ر",2,0],["أَيُّهَا الكَائِنُ امتلأنَا صَدِيدًا","فجِرَاحَاتُنَا حيَارَى حيَارَى",28,"ر",2,0],["أَيُّها الكَائِنُ الزَّمَانُ تعدَّى","نفسَهُ والمكَانُ زادَ انحِسَارَا",28,"ر",2,0],["أَيُّها الكَائِنُ استَحِلْ زَيتُونًا","وتسَلَّقْ نحوَ السَّماءِ جهَارَا",28,"ر",2,0],["أيها الكافرون بالحق..إن الحق","..رغم الكفران يقوى ويشتد",29,"د",1,0],["أيها الكارهون أن يُقبِل الشعب","... علينا بالله ماذا جنينا",30,"ن",2,0],["أيها الكاتمُ الحديث الذي طا","ل به الأمرُ وانتهى الكتمان",31,"ن",1,1],["ايها الكاتم السريرة عمرا","قد فشى السرَّ كالعتاة فضوحُ",32,"ح",1,0],["أيها الكاهن ..الذي صب خمرًا","في كؤوسي ..من المدام العتيقِ",33,"ق",1,0],["أيها الكون اتّحدْ ضد الأذى","ضد حلفٍ طبعُه طبعُ الوبا",34,"ب",2,0]]}