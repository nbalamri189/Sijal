ق تحرك قده","يوقف دوران الزمان اذا مشا",36,"ش",2,0],["مُحرَنجَمُ الجامِلِ والنُئِيُّ","وَصالِياتٌ لِلصِلى صُلِيُّ",37,"ي",1,0],["مِحرابُه الطِّرسُ فالعقولُ له","ساجدةٌ إِن رأَتْه قد سجدا",38,"د",2,0],["محروسةً من ذُلِّها ومِطالِها","وسليمةً من ذَمِّها أَوْ عَابها",39,"ب",3,0],["محرقاً في الوَغى بِنار هَوان","كُلَّ مَن كانَ طاغياً وَعَصيا",40,"ي",2,0],["محرجة خص كأن عيونها","إذا آذن القناص بالصيد عضرس",41,"س",1,1],["محرم لمتني بلسان ودٍّ","وشددت النكير وما جنيتُ",42,"ت",1,1],["مُحرّر الحُكمِ طبقَ النصِّ يوقِعهُ","وَالنصّ لِلحكمِ تَحريرٌ وَتَشييدُ",43,"د",1,0],["محركا فاجعل لما حرّكته","كحلقة بوضعها رسمته",44,"ه",1,0],["محرضَةٌ مُشطٌ روينا كلا","من هذه بالضمِّ ليسَ إلا",45,"ل",2,0],["محرفٌ منه أتى المصوبُ","وقائمٌ من بعده مبوب",45,"ب",1,0],["محرفٌ ومطلقٌ والطالعُ","مركبٌ من بعد رِدفٍ واقِعُ",45,"ع",1,0],["محرك الكل أنت القصد والغرض","وغاية مالها إن قستها عرض",46,"ض",1,1],["محراب جامعنا وَكَعبة ربنا","وَلَطيف باطن عرشه وَالكرسي",47,"س",2,0],["محراب قدس الجامع","بحر البلاغ السابع",48,"ع",1,0],["محراب إِسرافيل يوم سجوده","وَالأَرض ما حملت عَلى بهموت",49,"ت",1,0],["مُحْرِمٌ يستحلُّ كلَّ دمٍ بَسْ","لٍ بِبَسْلٍ منْ حكمه وَحَلال",50,"ل",1,0],["محرمات لم تزل ترمي الطلى","بالسقيع الصَّلْت من عريانها",51,"ه",2,0],["محرمات في العدا ما كبرت","في وغىً إلا وصلَّت حيضا",52,"ض",2,0],["محرم وصله علي وقد","أحل شرع الهوى لديه دمي",53,"م",2,0],["محرمة أَكفال خَيلي عَلى القَنا","وَدامية لباتها وَنُحورَها",54,"ه",2,1],["مُحَرَّراً مُجَرَّباً مُمَهَّدَا","فَآنتَخ لِكَنديكَل وُقِيتَ الردى",55,"د",2,0],["محرِّراً أهلَها مِن جاهليَّتهم","ودائباً تشتكى استمرارَه الهمم",56,"م",1,0],["محرابهُ متبرقع بدياجرٍ","فيها يناجي خالق الاشياءِ",57,"ا",2,0],["محرّمةٌ على أنظار قارِ","مهيأةٌ لجاهٍ وافتخار",58,"ر",1,0],["محرك هذه الدنيا شعور","بجذب أو بدفع أو نفور",59,"ر",1,0],["محرّمٌ فيه الهنا محرّمُ","والحُزنُ فرضٌ والبُكا مُحَتّم",60,"م",1,1],["مَحروز عَنْ كيد الحساسيد","سالِم وعَنْ كِلّ عدو غَدّار",61,"ر",1,0],["مَحْروزه لا يِفْرِسك شامي","ولا مِنْ حِمَل بِنْدِقه فِيْ الإيد",62,"د",1,0],["مَحروسَة من رَب