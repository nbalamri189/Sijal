7,"نداء القدس","https://www.poetsgate.com/ViewPoem.aspx?id=29241",""],[5277,"مريمُ..عليها السلام..القطوفُ القُدْسيّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=199954",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5358,"قالوا نساك","https://www.poetsgate.com/ViewPoem.aspx?id=21900",""],[5365,"أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191264",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5674,"أسرار ملحمة الوسامة","https://www.poetsgate.com/ViewPoem.aspx?id=189090",""],[5926,"أيلام قلب","https://www.poetsgate.com/ViewPoem.aspx?id=214343",""],[5956,"يقول المحروم","https://www.poetsgate.com/ViewPoem.aspx?id=194109",""],[6093,"بِشَامِ الغيد روحي والمرامُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176151",""],[6293,"ترنيمةُ المدَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83639&r=&rc=1",""]],"verses":[["محرَّرُ اللفظ لكنْ غر أنعمهِ","قد صيرتنيَ من بعض الأرقاء",0,"ا",2,0],["محروسة بشعاع البيض ملتمعاً","ونور ذاك المحيا آية الحرس",1,"س",1,0],["محرابُ صدغيه يحثُّ توجّهي","وبه على شرف البُدور تجوّهي",2,"ه",2,1],["مُحَرَّمُ الحولِ في تقدُّمِهِ","لكنهُ لابن خِيفَةٍ رَجَبُهْ",3,"ب",2,0],["محرقة من شبها","كأنه لها حصب",4,"ب",1,0],["مُحَرَّمَةٌ أَكفالُ خَيلي عَلى القَنا","مُحَلَّلَةٌ لَبّاتُها وَالقَلائِدُ",5,"د",1,0],["مُحَرِّكُ رَأسَهُ تَوَهَّمُهُ","قَد قامَ مِن عَطسَةٍ عَلى شَرَفِ",6,"ف",1,0],["مُحَرَّقَةٌ لِلغَزلِ أَظفارُ كَفِّهِ","لِتَدقيقِهِ ذا الطُرَّتَينِ المُحَبَّرا",7,"ر",2,0],["مِحْرَبٌ يَقهَرُ العداةَ ويُلْقي","كَلْكَلَ الحَربِ منهمُ في الدِّيارِ",8,"ر",1,0],["مِحْرَبٌ يَخرُجُ مِن أَغمَادِهِ","خُلُجاً توقدُ نِيرانَ الكِفاح",9,"ح",1,0],["