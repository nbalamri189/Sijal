{"poems":[[3,"هذه نار عبلة يا نديمي","https://www.aldiwan.net/poem203.html",""],[53,"لعن الله خالدا","https://www.aldiwan.net/poem61945.html","مجزوء الخفيف"],[68,"أين في الحمى عرب","https://www.aldiwan.net/poem40097.html","المقتضب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9973","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[103,"لاَ الدَّمعُ غاضَ وَلا فُؤادُكَ سَالى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62411&r=&rc=3",""],[102,"شاعر .. ووطنه في الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67707&r=&rc=194",""],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[370,"ولقد أجمع رجلي بها","https://www.aldiwan.net/poem44509.html","الرمل"],[385,"من لقلب يصلى سعير تجنيك","https://www.aldiwan.net/poem49223.html","الخفيف"],[466,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[569,"في فؤادي من الغرام لهيب","https://www.aldiwan.net/poem885.html",""],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118154","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105190","الخفيف"],[4764,"إنكسار الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=24544",""],[4797,"صلف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50253",""],[4963,"مرثيه في الاخ عبدالله الحبشان الدوسري","https://www.poetsgate.com/ViewPoem.aspx?id=35849",""],[5936,"النعيرية","https://www.poetsgate.com/ViewPoem.aspx?id=184770",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""]],"verses":[["كُلَّما ذُقتُ بارِداً مِن لَماه","خِلتُهُ في فَمي كَنارِ الجَحيمِ",0,"م",1,0],["كلَّما ذرَّ شارقٌ","خرَّ للأير ساجدا",1,"د",2,0],["كُلَّما ذَكَرتُهُمُ","حَزَّني لَهُم طَرَبُ",2,"ب",1,0],["كُلَّما ذُقتُ بارِداً مِن لَماها","خِلتُهُ في فَمي كَنارِ الجَحيمِ",3,"م",1,0],["كَلِمٌ إذَا حَدَرَ اللِّثَامَ رَأَيْتَهَا","حَالَتْ إِلَى مَسْنُونَةٍ وَنِصَالِ",4,"ل",1,0],["كَلِمٌ إذَا حَدَرَ اللِّئامَ رَأَيْتَهَا","حَالَتْ إلَى مَسْنُونَة ٍ وَنِصالِ",5,"ل",1,0],["كلما ذقت رائعا من مماتي","رمت أقسى يدا وأعنف روعه",6,"ع",2,0],["كُلَّما ذَرَ شاعِرٌ في سَماءٍ","شَعَرَ اللَيلُ بِاِنقِلابٍ خَطيرِ",7,"ر",1,0],["كلُّ ماذلك منّي خُلُقٌ","وبكلٍ أنا في الرَّوع جديرُ",8,"ر",1,0],["كُلَما ذابَ مِن صُدودك أَحيت","هُ الأَماني كَأَنَّها لاهوت",9,"ت",1,0],["كلما ذدتُ حسامي عن عِديّ","ولجَ الضيمُ بتأخير ذيادي",10,"د",2,0],["كلما ذاق كأس يأس مريرٍ","جاء كأسٌ من الرجا معسول",11,"ل",1,0],["كلما ذر شارق أو تغنت","ذات طوقٍ لها الزمان هديل",12,"ل",1,0],["كلما ذكرني بان الغضا","عهدنا ذكره نوحى الحماما",13,"م",2,0],["كلُّ ما ذُقتُ مِن عذابك عذبٌ","لَذَّ لي طعمه كَأَشهى طعامِ",14,"م",1,0],["كلما ذاقها أخو الشوق نادى","إن شرب السلاف يبري العليلا",15,"ل",2,0],["كِلمَا ذَابَت حُروفي إنفِضَت مِني حُروف","وإدعت إني غَريبه .. وإني كلي مُجرمه",16,"م",2,1],["كل ما ذعذع علي صلف الهوى حدريه","يكفخ فوادي بصدري قبل يكفخ ثوبي",17,"ب",2,1],["كل ماذكرته هلت العين تبكيه","والله مانسى طيبين العلومي",18,"م",2,0],["كل ما ذكر داره يعض إصبعه عض","من حرقةٍ في وسط جوفه تلظه",19,"ه",1,0],["كلّما ذُدتَهنَّ عُدْنَ كما عَا","دَ لوِرْدِ الحياضِ سَرْحٌ طَريدُ",20,"د",1,0]]}