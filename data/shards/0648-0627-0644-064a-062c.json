{"poems":[[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[46,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[104,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[139,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[148,"أبدا إليك تولع الأحباب","https://www.aldiwan.net/poem4461.html","الكامل"],[409,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[409,"نعمة إن ذكرتها وجب الكشر","https://www.aldiwan.net/poem33599.html","الخفيف"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[551,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126725","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122664","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122307","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77969","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88637","الخفيف"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105668","الكامل"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131363","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125812","الكامل"],[4797,"أعز الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=132240",""],[4935,"والى جناته قربه","https://www.poetsgate.com/ViewPoem.aspx?id=129519",""],[5573,"ماحال دون معانق الشوق حراس","https://www.poetsgate.com/ViewPoem.aspx?id=201913",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5763,"أطلال الشِعر","https://www.poetsgate.com/ViewPoem.aspx?id=27061",""],[402,"أين أقطاب مصر والاعلام","https://www.poetsgate.com/ViewPoem.aspx?id=36207",""],[402,"عز المعالي مات يوسف سابا","https://www.poetsgate.com/ViewPoem.aspx?id=35358",""],[5866,"لا والله الا وصلوها مواصيل","https://www.poetsgate.com/ViewPoem.aspx?id=182873",""]],"verses":[["وَإِلى جَنابِ أَبي الحُسَينِ تَشَنَّعَت","بِزِمامِها كَالمُصعَبِ المَخطومِ",0,"م",1,0],["وَإِلى جَنابِ أَبي المُغيثِ تَواهَقَت","خوصُ العُيونِ مَوائِرُ الأَعضادِ",1,"د",1,0],["وَإِلى جَهَنَم أَنتُما","حطب لَها طول البَقاء",2,"ا",2,0],["وإلى جنبهِ يقاسي اللظى الأخ","طلُ مستعبراً ويشكو جرير",3,"ر",1,0],["وإلى جنبه على النار أفلا","طون يصغي كأنه مسرور",3,"ر",1,0],["وَإِلَى جَانِبِ المَصَانِعِ شِيدَتْ","لِلعُلُومِ الصرُوحُ وَالآطَامُ",4,"م",1,0],["وَإِلَى جَمِيعِ الشَّرْقِ فَانْعِ مُهَذَّباً","فِقْدَانُهُ فِي الشَّرْقِ عَمَّ مُصَابَا",5,"ب",2,0],["وإلى جوارهما تثنّت","سروةٌ، بل سروتانْ",6,"ن",1,0],["وإلى جنابكَ بنت فكرس أقبلت","بحليّها تمشي على استحياءِ",7,"ا",2,0],["وإلى جنابك سارعت همم الكرا","م ويممت وصلا وكشف حجاب",8,"ب",1,0],["وإلى جمع سرى جمعهم","وبها جمع الصلاتين عشاها",9,"ا",3,0],["وإلى جدة رجعنا وفيها","قد رسمنا حروف هذي المقاله",10,"ل",2,0],["وإلى جَنوب البانِ كلّ مُضِرَّةٍ","بالبان بين موائسٍ وموائدِ",11,"د",1,0],["وآلى جَنابٌ حِلْفَةً فأَطعْتَهُ","فَنفْسَكَ وَلِّ اللَّوْمَ إِنْ كُنْتَ لائِما",12,"م",2,0],["وإِلى جَنْبِ ذَلِكَ الخالِ وَشْمٌ","قد تَخَفَّى بِصُدْغِها وَتخَفَّر",13,"ر",1,0],["وإلى جدّه الإمامة ألقت","لعلاه بالطرح كلّ قتادِ",14,"د",1,0],["وإلى جَلالِ جَميلِ وَجهِكَ لَو رَأى","فِرعونُ ذُو الأوتادِ طالَ رُكُوعُهُ",15,"ع",2,0],["وَإِلى جَنة وَراحٍ وروحٍ","سارَ وَاللَه بِالنَعيم حباه",16,"ا",2,0],["وإلى جوار حماك اقصدنا السرى","فنزلت ساحة كعبة القصاد",17,"د",1,0],["وإِلى جُودهمْ وبأسهمْ س","لَّم أهلُ الأهواء والأمراض",18,"ض",1,0],["وإلى جنب مهجتي وسِّداه","أو إلى جنب جسمه وسِّداني",19,"ن",2,0],["وَإِلى جَحيم عجلت أَرواحهم","فَكأَنَّما كانوا به وهماً جَرى",20,"ر",2,0],["والى جنبها يروح ويغدو","لم ترعه بجفوة وصدود",21,"د",1,0],["وإلى جواد السبق زف من الهنا","آيات بشر كلهن نظام",22,"م",1,0],["وإلى جانب الأضيّة دورٌ","ما عليهن لو رجعن جوابى",23,"ب",2,0],["وَإِلى جَناب أَبي السعودِ وَربعه","نُصّي الرَكايب تَظفَري بِمَرامِ",24,"م",1,0],["وإِلى جانَبِيهِ من فَوقِ عَرشٍ","عسجَدَيٍّ هِيرَا تَشُوقُ اعتِدالا",25,"ل",2,0],["وإلى جُميلة مجدهم متسلسل","كتسلسل الأطواد بالأطواد",26,"د",1,0],["والي جاهم اللي ما له الا الله المعبود","يقولون سكرنا عددنا وبيبانه",27,"ن",2,0],["والى جاهم اللي تسبقه واسطه ورود","يقولون بطلنا عددنا وعمدانه",27,"ن",2,0],["والى جناته قربه","وحباه في ذراها الاعتزاز",28,"ز",1,1],["والي جمعنا طالبه لاتوريت","تحت الثرى يجعل لي بستره لباس",29,"س",1,0],["وإلى جنان الخلد تستبق المنى","وهي التي سبقت بمدّ الأذرع",30,"ع",1,0],["وإلى جفنيكِ ترتدُّ الأماني","كم سقينَ القلبَ رمحاً بزَّ رمحا",31,"ح",2,0],["وإلى جانب المصانع شيدت","لعلوم الصروح والآطام",32,"م",1,0],["وإلى جميع الشرق فانع مهذبا","فقدانه في الشر عم مصابا",33,"ب",2,0],["والي جنح عن منهج اهل التنافيل","حرام والله ينتسب للقبيلة",34,"ل",2,0]]}