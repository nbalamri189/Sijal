{"poems":[[54,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[43,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[45,"أحجابا بعد المديح ومطلا","https://www.aldiwan.net/poem64640.html","الخفيف"],[33,"أحجاج بيت الله في أي هودج","https://www.aldiwan.net/poem25989.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"سقيا لحرب أنا أحييها","https://www.aldiwan.net/poem66587.html","المنسرح"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72229","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[36,"أحجاج إن الله أعطاك غاية","https://www.poetsgate.com/ViewPoem.aspx?id=15897",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[115,"الرياض","https://www.aldiwan.net/poem24038.html","البسيط"],[117,"بعلاكم وهو حسب المطنب","https://www.aldiwan.net/poem4363.html","الرمل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[209,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[377,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[434,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[459,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[475,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[556,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"]],"verses":[["أَحَجَّتكَ أَسيافُهُم كارِهاً","وَما لَكَ في الحَجِّ مِن رَغبَه",0,"ب",2,0],["أَحجارُ ناسٍ فَوقَ أَرضٍ مِن دَمٍ","وَنُجومُ بَيضٍ في سَماءِ قَتامِ",1,"م",1,0],["أَحِجاباً بَعدَ المَديحِ وَمَطلاً","بَعدَ وَعدٍ مَن ذا بِهَذَينِ يَرضى",2,"ض",2,1],["أَحُجّاجَ بَيتِ اللَهِ في أَيِّ هَودَجٍ","وَفي أَيِّ خِدرٍ مِن خُدورِكُمُ قَلبي",3,"ب",2,1],["أحْجَمَتْ عندهُ الحجُون وأكْدى","عِنْد إعطائه القليلَ كَدَاءُ",4,"ا",2,0],["أحجارُنا نخبةٌ بباطيةٍ","يديرُها ما يخلّ ساقيها",5,"ي",3,0],["أَحَجَّاجُ إنَّ اللّهَ أَعْطاك غايَةً","يُقَصِّرُ عنها مَن أَرادَ مَداها",6,"ا",3,1],["أَحَجَّاجُ لا يُفْلَلْ سِلاحُكَ إنّما ال","مَنايا بِكَفِّ اللّهِ حيثُ يَراها",6,"ا",3,0],["أَحَجَّاجُ لا تُعْطِ العُصاةَ مُناهُمُ","ولا اللّهُ يُعْطِي لِلْعُصاةِ مُناها",6,"ا",3,0],["أُحْجِيَّةٌ لِلْخَلْقِ لَمْ تُدْرَكْ وَمَا","فَتِئَتْ تُحَاجِيهِمْ بِهَا الأَدْهَارُ",7,"ر",1,0],["أحجاج لا يفلل سلاحك إنما ال","منايا بكف الله حيث تراهَا",8,"ا",3,0],["أحجمت في ضعف النَّعا","م وصُلْتَ في عزم الأسود",9,"د",1,0],["أَحُجُّ أطلالَ مَنْ حَبُّوا ومَنْ عَشِقُوا","وليس بيني وبين المُنْحَنَى بُعْدُ",10,"د",1,0],["أحجَمَ الأعداءُ عنكُم رهبةً","من رأى الموت عياناً يَرهَبِ",11,"ب",1,0],["أَحجمَ الفيلُ عَن حِمى اللّه لمّا","قَصَدَت هدمَ بيته الأشقياءُ",12,"ا",2,0],["أحجارُها عاتبات","على الذي قد صنعتم",13,"م",1,0],["أَحجاب البُعاد وَالهَجر أَشكر","أم حِجاب الصُدود وَالأَطراق",14,"ق",1,0],["احجارها من مرمر ونقوشها","من جوهر فاعجب الحسن نظام",15,"م",1,0],["أحجارُ سُوءٍ جُعلتْ آلَةً","وسِرها النفعُ أو الضَّرُّ",16,"ر",1,0],["أحَجْرٌ على الاْجفانِ تهويمُها اِذا","سرت ْشمألٌ وهناً إلى الغَوْرِ مِن حِجْرِ",17,"ر",1,0],["أحج إليها كل وقت ومهجتي","لكعبتها وادي العقيق ورابغ",18,"غ",1,0]]}