{"poems":[[56,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[45,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[47,"أحجابا بعد المديح ومطلا","https://www.aldiwan.net/poem64640.html","الخفيف"],[35,"أحجاج بيت الله في أي هودج","https://www.aldiwan.net/poem25989.html","الطويل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"سقيا لحرب أنا أحييها","https://www.aldiwan.net/poem66587.html","المنسرح"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72229","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[38,"أحجاج إن الله أعطاك غاية","https://www.poetsgate.com/ViewPoem.aspx?id=15897",""],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[121,"الرياض","https://www.aldiwan.net/poem24038.html","البسيط"],[123,"بعلاكم وهو حسب المطنب","https://www.aldiwan.net/poem4363.html","الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[215,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[385,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[443,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[466,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[482,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[563,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63815","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131400","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108896","الوافر"],[266,"","https://poetry.dctabudhabi.ae/diwan/poem/129589","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28569","الخفيف"],[2374,"","https://poetry.dctabudhabi.ae/diwan/poem/97838","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93703","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87686","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100315","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200840","الطويل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145873","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108076","البسيط"],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5431,"دع عنك شكا في الوجود مؤرقا","https://www.poetsgate.com/ViewPoem.aspx?id=187362",""],[5431,"فتطوى له الأكوان طيّ الشرائح","https://www.poetsgate.com/ViewPoem.aspx?id=192308",""],[5431,"تستوي الهامات عزّا ومنحى ....","https://www.poetsgate.com/ViewPoem.aspx?id=211306",""],[5438,"شَرِيدُ الأَشْوَاق","https://www.poetsgate.com/ViewPoem.aspx?id=202220",""],[709,"غَرَبَتْ مِنكمُ شُمُوسُ التَّلاَقِي","https://www.poetsgate.com/ViewPoem.aspx?id=2876",""],[5725,"احجية الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186471",""],[5952,"شوقٌ لِ قُبَّتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=212162",""],[5956,"أحج إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=192512",""],[5724,"أحجاج بيت الله ألف تحية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55154&r=&rc=21",""]],"verses":[["أَحَجَّتكَ أَسيافُهُم كارِهاً","وَما لَكَ في الحَجِّ مِن رَغبَه",0,"ب",2,0],["أَحجارُ ناسٍ فَوقَ أَرضٍ مِن دَمٍ","وَنُجومُ بَيضٍ في سَماءِ قَتامِ",1,"م",1,0],["أَحِجاباً بَعدَ المَديحِ وَمَطلاً","بَعدَ وَعدٍ مَن ذا بِهَذَينِ يَرضى",2,"ض",2,1],["أَحُجّاجَ بَيتِ اللَهِ في أَيِّ هَودَجٍ","وَفي أَيِّ خِدرٍ مِن خُدورِكُمُ قَلبي",3,"ب",2,1],["أحْجَمَتْ عندهُ الحجُون وأكْدى","عِنْد إعطائه القليلَ كَدَاءُ",4,"ا",2,0],["أحجارُنا نخبةٌ بباطيةٍ","يديرُها ما يخلّ ساقيها",5,"ي",3,0],["أَحَجَّاجُ إنَّ اللّهَ أَعْطاك غايَةً","يُقَصِّرُ عنها مَن أَرادَ مَداها",6,"ا",3,1],["أَحَجَّاجُ لا يُفْلَلْ سِلاحُكَ إنّما ال","مَنايا بِكَفِّ اللّهِ حيثُ يَراها",6,"ا",3,0],["أَحَجَّاجُ لا تُعْطِ العُصاةَ مُناهُمُ","ولا اللّهُ يُعْطِي لِلْعُصاةِ مُناها",6,"ا",3,0],["أُحْجِيَّةٌ لِلْخَلْقِ لَمْ تُدْرَكْ وَمَا","فَتِئَتْ تُحَاجِيهِمْ بِهَا الأَدْهَارُ",7,"ر",1,0],["أحجاج لا يفلل سلاحك إنما ال","منايا بكف الله حيث تراهَا",8,"ا",3,0],["أحجمت في ضعف النَّعا","م وصُلْتَ في عزم الأسود",9,"د",1,0],["أَحُجُّ أطلالَ مَنْ حَبُّوا ومَنْ عَشِقُوا","وليس بيني وبين المُنْحَنَى بُعْدُ",10,"د",1,0],["أحجَمَ الأعداءُ عنكُم رهبةً","من رأى الموت عياناً يَرهَبِ",11,"ب",1,0],["أَحجمَ الفيلُ عَن حِمى اللّه لمّا","قَصَدَت هدمَ بيته الأشقياءُ",12,"ا",2,0],["أحجارُها عاتبات","على الذي قد صنعتم",13,"م",1,0],["أَحجاب البُعاد وَالهَجر أَشكر","أم حِجاب الصُدود وَالأَطراق",14,"ق",1,0],["احجارها من مرمر ونقوشها","من جوهر فاعجب الحسن نظام",15,"م",1,0],["أحجارُ سُوءٍ جُعلتْ آلَةً","وسِرها النفعُ أو الضَّرُّ",16,"ر",1,0],["أحَجْرٌ على الاْجفانِ تهويمُها اِذا","سرت ْشمألٌ وهناً إلى الغَوْرِ مِن حِجْرِ",17,"ر",1,0],["أحج إليها كل وقت ومهجتي","لكعبتها وادي العقيق ورابغ",18,"غ",1,0],["أَحُجَّاجَنا ما لي أرى السَّفْرَ آيباً","ولست أراكم آيبينَ معَ السفر",19,"ر",1,0],["إحجب نساءك المطهرات","واتخذوا من جملة الآيات",20,"ت",1,0],["أحجناء صبرا كلّ نفس رهينةٌ","بموت ومكتوب عليها فناؤها",21,"ا",3,0],["أحجناء أسباب المنايا بمرصد","فإلا يعاجل غدوها فمساؤها",21,"ا",3,0],["أحجناء إن أفلت من السجن تلقي","حتوف منايا لا يردّ قضاؤها",21,"ا",3,0],["أحجناء إن أضحى أبوك ودلوه","تعرّت عرا منها ورث رشاؤها",21,"ا",3,0],["أحجناء إن يصبح أبوك ونفسهُ","قصيرٌ تمنّيها طويلٌ عناؤها",21,"ا",3,0],["أحجِّبُ منظرَ المرآة عنه","لتسلم من نبال المقلتينِ",22,"ن",1,1],["أحجب من أهواه خوف وشاته","وأقصيه عني والمزار قريب",23,"ب",1,1],["أحجبُ الوارِدينَ عَنهُ وَلا آ","ذَنُ مِنهم إِلّا لِصافي ودادِك",24,"ك",1,0],["أَحجّاج لَم تَشهد مقام بناتهِ","وَعمّاتهِ يُندبنهُ اللّيلَ أَجمعا",25,"ع",2,1],["أَحجّاج لم تقتل بِه إِن قَتلتهُ","ثَماناً وعشراً واِثنتين وأربعا",25,"ع",2,0],["أَحجّاج من هذا يَقومُ مقامهُ","عَلينا فَمهلاً لا تَزِدنا تَضَعضعا",25,"ع",2,0],["أَحجّاج إمّا أَن تَجودَ بِنعمةٍ","عَلينا وإمّا أَن تُقتّلنا مَعا",25,"ع",2,0],["أَحجُّ إِلَيك مَسروراً كَأَني","أَحجُّ الكَعبة البَيت الحَراما",26,"م",2,0],["أَحجم القُنّاص عَنها","أَنَّهُم خافوا العُيونا",27,"ن",2,0],["احجب نبالك عن قسي حواجب","هزئت برمي النبل من اقواسي",28,"س",2,0],["أحجّب نفسي من حياء وعفّة","وأبصر قوماً خشّعاً هيبة ليا",29,"ي",2,1],["أحجارُ سمٍّ فهو وحياً يسري","وغاضَ ماءُ فارسٍ ألبتا",30,"ت",2,0],["أحجب الأضواء عن عيني عزوفا","عن رياض الحب أغضي في احتشام",31,"م",1,0],["أَحْجرتَ عرشَ الملكِ حين قهرتَه","والمالُ فِي كفيك صار مُباحا",32,"ح",2,0],["أحُجّاجَ بيتِ اللهِ فزْتُمْ بزوْرَةٍ","حباكُمْ بها طوْعَ السّعادَةِ موسِمُ",33,"م",1,0],["احجب محياك عني إن لي كبدَا","إذا رأيتُشبيه الشيخ تضطرم",34,"م",1,0],["أحجموا عنه وولوا بدداً","كلهم من خوفه القلب فقد",35,"د",1,0],["أحجارُ ( شَطْرَنْجٍ ) تُحَرَّكُ عِندما","يَقَعُ المُغَفّلُ في شِباكِ الخَانِ",36,"ن",1,0],["أحجار نرد قد تُرى آمالنا","ماغيّرت شرع الرؤى الأحجارُ",37,"ر",1,0],["أحجُّ إلى ربّ الغرام ومهجتي","به عُمّدت تحميه من كلّ جارحِ",38,"ح",1,0],["أحجُ إلى ( العذراء) رمزا مرضعا","وذاتي بها عشتار نجمٌ وما ونى",39,"ن",2,0],["أَحُجُّ بِجُنْحِ اللَّيْلَ نَحْو قَصِيدَتِي","وَ لِي قِبْلَةُ المَنْفَى بِكُلِّ المَنَاطِقِ",40,"ق",1,0],["أحجَّتْ نارَ زفرتي الفرقُ فيهمْ","فنشا الدَّجنُ منْ دخانِ احتراقي",41,"ق",2,0],["احجية في سرك الغامضِ","اضغاث جفنٍ وسنٍ غامضِ",42,"ض",1,1],["أحج في اليوم ألفاً عند باحته","تَخِذتُهُ في فؤاديْ والأنا حَرَما",43,"م",2,0],["أحج إليه في يومي وليلي","بأعمالي وأقوالي وعقلي",44,"ي",1,1],["أحجاج بيت الله ألف تحية","بأوجهكم نور من الله يسطع",45,"ع",1,1]]}