{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"خليلي هل لي لو ظفرت بنية","https://www.aldiwan.net/poem29881.html","الطويل"],[53,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[86,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[51,"إذا اختط قوم خطة لمدينة","https://www.aldiwan.net/poem62874.html","الطويل"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[45,"فلا تحسب الغنم جمع التلاد","https://www.aldiwan.net/poem66648.html","المتقارب"],[66,"رعى الله من لم يرع لي حق صحبة","https://www.aldiwan.net/poem40109.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116988","البسيط"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"فَلا تَحْسبِ الغُنْمَ جَمْعَ التِّلادِ","https://www.poetsgate.com/ViewPoem.aspx?id=32002",""],[187,"نفوس الناس بالشح","https://www.aldiwan.net/poem43661.html","الهزج"],[271,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[271,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[281,"نبي العلى والندى ما لي صفت وضفت","https://www.aldiwan.net/poem60702.html","البسيط"],[285,"برزت من المنازل القباب","https://www.aldiwan.net/poem44319.html","الوافر"],[343,"رقادك قلبي شجاك الألم","https://www.aldiwan.net/poem55386.html","المتقارب"],[350,"وعن طرب أصفق إذ تغني","https://www.aldiwan.net/poem15968.html","الوافر"],[365,"سلا حادي الأنضاء أين يريد","https://www.aldiwan.net/poem60957.html","الطويل"],[410,"أيا لائمي في وقفة المتلوذ","https://www.aldiwan.net/poem31847.html","الطويل"],[417,"بدا مستهلا بالبشارة يهتف","https://www.aldiwan.net/poem53841.html","الطويل"],[417,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[430,"وجارية لطهماز ربية","https://www.aldiwan.net/poem40857.html","الوافر"],[440,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[454,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[459,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[465,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[480,"ولائمة للثغر إثر ابتسامها","https://www.aldiwan.net/poem37031.html","الطويل"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[515,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"]],"verses":[["وَفي ذَلِكَ الوادي الَّذي أَنبَتَ الهَوى","جَنابانِ مِن نُوّارِهِ أَرِجانِ",0,"ن",1,0],["وَفي ذَلِكَ السَربِ الَّذي تَرَيانِهِ","أَحَمُّ غَضيضُ الناظِرَينِ كَحيلُ",1,"ل",1,0],["وَفى ذا السُرورُ بِتِلكَ الكُرَب","وَهَذا المَقامُ بِذاكَ التَعَب",2,"ب",1,1],["وَفي ذاكَ ما يَستَفيدُ الفَتى","وَأَيُّ اِمرِئٍ لا يُلاقي الشُرورا",3,"ر",2,0],["وَفي ذِمَّتي لِليازِجِيِّ وَديعَةٌ","وَأُخرى لِزَيدانٍ وَقَد سَبَقاني",4,"ن",2,0],["وفي ذاك ما ينهاهُمُ أن يشيّدوا","وأن يقتنوا إلا كزاد المسافرِ",5,"ر",1,0],["وفي ذاك ما جلّى عمايةَ عامهٍ","وقشّعها لكن ليلكَ ألْيلُ",6,"ل",1,0],["وَفي ذاكَ مُعتَبَرٌ لِلَّبي","بِ وَمُتَّعِظٌ لَكَ لَو تَعلَمُ",7,"م",1,0],["وَفي ذِمَّةِ الرَحمَنِ مَن ذَمَّ صُحبَتي","وَلَم أَكُ يَوماً ناقِضاً لِذِمامِهِ",8,"م",2,0],["وفي ذَمَلانِ العِيسِ كِلْتَا مَآربي","إذا أرْقَلَتْ بي من أَمُونٍ وعَيْهَم",9,"م",1,0],["وفي ذي النواويسِ موْجُ البحارِ","وما بالبحارِ إليْهِ ظَما",10,"ا",1,0],["وفي ذَوْب اللُّجَيْنِ طَمِعْتِ لمّا","رأيْتِ سَرَابَها يَغْشَى الرّمَالا",11,"ل",2,0],["وفي ذِمَّةِ المجد من شيبكم","دمٌ فوق أروقة الحقِّ سالا",12,"ل",2,0],["وَفِي ذَكَاءٍ لَهُ شُعَاعٌ","يَبْدُو عَلى وَجَهِكَ الصَّبِيحِ",13,"ح",1,0],["وفي ذُنوبي إذا فكّرتُ مشتَغَلٌ","وفي معاديَ إن لَم ألق غُفرانا",14,"ن",2,0],["وفي ذلَّةٍ عزّا ، وفي ضَلَّةٍ هُدىً","وفي جَنَفٍ عدلاً ، وفي جَدَبٍ خصبْا",15,"ب",2,0],["وفي ذاكَ عن سُخطِ أهل البلادِ","على حُكمهِ أو رضاهم غِنى",16,"ا",1,0],["وفي ذَاكَ مُغْتَبَرٌ لِلَّبِيبِ ،","ومُتَّعَظٌ لكَ لَوْ تَعْلَمُ",17,"م",1,0],["وفي ذاك علاماتٌ","بما قد قلت مشروطة",18,"ط",2,0],["وفي ذاكَ فخرٌ لا عزاءٌ فإنّهُ","لحمدٌ يمرُّ الذكرُ فيهِ حُساما",19,"م",2,0],["وفي ذلك الروضِ الكثيفِ بحيرةٌ","نثرتُ عَليها عقدَكِ المتقطّعا",20,"ع",2,0],["وَفِي ذُرى الْمَجْدِ مِنْ تاجِ الْمُلُوكِ فَتىً","بِالْعِزِّ مُغْتَبِقٌ بِالسَّعْدِ مُصْطَبِحُ",21,"ح",1,0],["وَفي ذا راحَةٍ وَفَراغِ بالٍ","فَدَأَب الدَهر ذا أَبَداً وَدابي",22,"ب",2,0],["وفي ذكريات الاماني شجون","متى عبثت بالفتى تخترم",23,"م",1,0],["وَفي ذِكريكَ لَم آنَس بِذِكري","وَأُنسي وَحشَةُ العُذّالِ مِنّي",24,"ن",2,0],["وفي ذلك الوادي العَقيقّيِ ظَبيةٌ","تُصادُ ظباءُ القاع وهْي تَصيد",25,"د",1,0],["وفي ذلكَ البيتِ الذي أَتَعَزَّلُ","حِذارَ وُشاةِ الحيِّ أدماءُ مُغْزِلُ",26,"ل",1,0],["وفي ذلك الميلاد أرِّخْ بقولنا","وُلِدَتْ بأفراحٍ سليمانُ آصفُ",27,"ف",1,0],["وفي ذلك الوادي سوالب أنفسٍ","رمينَ بأحداق السوانح أسهما",28,"م",2,0],["وفي ذات الدخان التبغ أضحى","فوأدي هائما صافي الطويّه",29,"ي",2,0],["وفي ذِمَّةِ اللهِ أصْلٌ كريمٌ","يُسكِّنُ من فقدِ بعضِ الفُرُوعِ",30,"ع",1,0],["وفي ذّمةِ الرحمنِ نورٌ أذابه","على الطِّرسِ أو نورٌ على العالم ابتكر",31,"ر",1,0],["وَفَي ذُو المجِد سَبَّاقا فوافَى","يحلِّق عُرْفُه والنجمُ كابي",32,"ب",2,0],["وفي ذي القعدة الشهر الحرام ان","تقالك فيه ايما لطيف",33,"ف",1,0],["وفي ذلك المغنى إلى الدمع فاقةٌ","وكم مدمعٍ أغنى على فاقةٍ مغنى",34,"ن",2,0],["وفي ذلك الملثوم منها تحية","تعرض قصدا كلهم لاغتنامها",35,"م",3,0],["وفي ذاك التنازل منه مغزى","يشف عن التنازل باختيار",36,"ر",1,0],["وفي ذاك الصنيع لنا دليل","ينم على أياديه الغزار",36,"ر",1,0],["وفي ذمّةِ الرّحمنِ خيرُ مودَّعٍ","أقامَ لدَينا بعدَهُ الوَجْدُ والفِكْرُ",37,"ر",1,0]]}