oem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120507","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4722,"نفيتم صفات الله فالله أكمل","https://www.poetsgate.com/ViewPoem.aspx?id=26476",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5096,"على موعد الشَّوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207839",""],[5111,"ذِكِراكِ","https://www.poetsgate.com/ViewPoem.aspx?id=212164",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[1680,"أتطلب أن تكون كثير مال","https://www.poetsgate.com/ViewPoem.aspx?id=108878",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""]],"verses":[["وَفي ذَلِكَ الوادي الَّذي أَنبَتَ الهَوى","جَنابانِ مِن نُوّارِهِ أَرِجانِ",0,"ن",1,0],["وَفي ذَلِكَ السَربِ الَّذي تَرَيانِهِ","أَحَمُّ غَضيضُ الناظِرَينِ كَحيلُ",1,"ل",1,0],["وَفى ذا السُرورُ بِتِلكَ الكُرَب","وَهَذا المَقامُ بِذاكَ التَعَب",2,"ب",1,1],["وَفي ذاكَ ما يَستَفيدُ الفَتى","وَأَيُّ اِمرِئٍ لا يُلاقي الشُرورا",3,"ر",2,0],["وَفي ذِمَّتي لِليازِجِيِّ وَديعَةٌ","وَأُخرى لِزَيدانٍ وَقَد سَبَقاني",4,"ن",2,0],["وفي ذاك ما ينهاهُمُ أن يشيّدوا","وأن يقتنوا إلا كزاد المسافرِ",5,"ر",1,0],["وفي ذاك ما جلّى عمايةَ عامهٍ","وقشّعها لكن ليلكَ ألْيلُ",6,"ل",1,0],["وَفي ذاكَ مُعتَبَرٌ لِلَّبي","بِ وَمُتَّعِظٌ لَكَ لَو تَعلَمُ",7,"م",1,0],["وَفي ذِمَّةِ الرَحمَنِ مَن ذَمَّ صُحبَتي","وَلَم أَكُ يَوماً ناقِضاً لِذِمامِهِ",8,"م",2,0],["وفي ذَمَلانِ العِيسِ كِلْتَا مَآربي","إذا أرْقَلَتْ بي من أَمُونٍ وعَيْهَم",9,"م",1,0],["وفي ذي النواويسِ موْجُ البحارِ","وما بالبحارِ إليْهِ ظَما",10,"ا",1,0],["وفي ذَوْب اللُّجَيْنِ طَمِعْتِ لمّا","رأيْتِ سَرَابَها يَغْشَى الرّمَالا",11,"ل",2,0],["وفي ذِمَّةِ المجد من شيبكم","دمٌ فوق أروقة الحقِّ سالا",12,"ل",2,0],["وَفِي ذَكَاءٍ لَهُ شُعَاعٌ","يَبْدُو عَلى وَجَهِكَ الصَّبِيحِ",13,"ح",1,0],["وفي ذُنوبي إذا فكّرتُ مشتَغَلٌ","وفي معاديَ إن لَم ألق غُفرانا",14,"ن",2,0],["وفي ذلَّةٍ عزّا ، وفي ضَلَّةٍ هُدىً","وفي جَنَفٍ عدلاً ، وفي جَدَبٍ خصبْا",15,"ب",2,0],["وفي ذاكَ عن سُخطِ أهل البلادِ","على حُكمهِ أو رضاهم غِنى",16,"ا",1,0],["وفي ذَاكَ مُغْتَبَرٌ لِلَّبِيبِ ،","ومُتَّعَظٌ لكَ لَوْ تَعْلَمُ",17,"م",1,0],["وفي ذاك علاماتٌ","بما قد قلت مشروطة",18,"ط",2,0],["وفي ذاكَ فخرٌ لا عزاءٌ فإنّهُ","لحمدٌ يمرُّ الذكرُ فيهِ حُساما",19,"م",2,0],["وفي ذلك الروضِ الكثيفِ بحيرةٌ","نثرتُ عَليها عقدَكِ المتقطّعا",20,"ع",2,0],["وَفِي ذُرى الْمَجْدِ مِنْ تاجِ الْمُلُوكِ فَتىً","بِالْعِزِّ مُغْتَبِقٌ بِالسَّعْدِ مُصْطَبِحُ",21,"ح",1,0],["وَفي ذا راحَةٍ وَفَراغِ بالٍ","فَدَأَب الدَهر ذا أَبَداً وَدابي",22,"ب",2,0],["وفي ذكريات الاماني شجون","متى عبثت بالفتى تخترم",23,"م",1,0],["وَفي ذِكريكَ لَم آنَس بِذِكري","وَأُنسي وَحشَةُ العُذّالِ مِنّي",24,"ن",2,0],["وفي ذلك الوادي العَقيقّيِ ظَبيةٌ","تُصادُ ظباءُ القاع وهْي تَصيد",25,"د",1,0],["وفي ذلكَ البيتِ الذي أَتَعَزَّلُ","حِذارَ وُشاةِ الحيِّ أدماءُ مُغْزِلُ",26,"ل",1,0],["وفي ذلك الميلاد أرِّخْ بقولنا","وُلِدَتْ بأفراحٍ سليمانُ آصفُ",27,"ف",1,0],["وفي ذلك الوادي سوالب أنفسٍ","رمينَ بأحداق السوانح أسهما",28,"م",2,0],["وفي ذات الدخان التبغ أضحى","فوأدي هائما صافي الطويّه",29,"ي",2,0],["وفي ذِمَّةِ اللهِ أصْلٌ كريمٌ","يُسكِّنُ من فقدِ بعضِ الفُرُوعِ",30,"ع",1,0],["وفي ذّمةِ الرحمنِ نورٌ أذابه","على الطِّرسِ أو نورٌ على العالم ابتكر",31,"ر",1,0],["وَفَي ذُو المجِد سَبَّاقا فوافَى","يحلِّق عُرْفُه والنجمُ كابي",32,"ب",2,0],["وفي ذي القعدة الشهر الحرام ان","تقالك فيه ايما لطيف",33,"ف",1,0],["وفي ذلك المغنى إلى الدمع فاقةٌ","وكم مدمعٍ أغنى على فاقةٍ مغنى",34,"ن",2,0],["وفي ذلك الملثوم منها تحية","تعرض قصدا كلهم لاغتنامها",35,"م",3,0],["وفي ذاك التنازل منه مغزى","يشف عن التنازل باختيار",36,"ر",1,0],["وفي ذاك الصنيع لنا دليل","ينم على أياديه الغزار",36,"ر",1,0],["وفي ذمّةِ الرّحمنِ خيرُ مودَّعٍ","أقامَ لدَينا بعدَهُ الوَجْدُ والفِكْرُ",37,"ر",1,0],["وفي ذرة الأصلاب في كل نطفة","تعدد أعيان من الأبوية",38,"ه",1,0],["وفي ذاتِ السلاسلِ من سُلَيْمٍ","غداةَ أتاهمُ الموتُ المُبيرُ",39,"ر",1,1],["وَفي ذَلِكَ المِيلاد أَقوى دَلالة","عَلى أَن هذا العام يُمنٌ عَلى الناس",40,"س",1,0],["وَفي ذمة اللذات نَخلع بِالرضا","شِعارَ الهَوى لَكن بِغَير فجور",41,"ر",1,0],["وفي ذاك ما ناباه من هتك حرمةٍ","لنا ودماءٍ ليس تخلو من السفك",42,"ك",1,0],["وفي ذي المنازل يأتي الضياء","نهارا وليلا من الكهرباء",43,"ا",2,1],["وفي ذلك الوادِي رَشاً أَضْلُعي له","كِناسٌ وقُمْرِيٌّ فوادِي له وَكْنُ",44,"ن",1,0],["وفي ذا العُذْرِ للعاذ","رِ عُذْرٌ أَيُّما عُذْرِ",45,"ر",1,0],["وَفِي ذلكَ المغنَى حَبيبٌ تَكَفَّلَت","لِنَفسِي بِأَشتاتِ الجَمالِ شِيَاتُهُ",46,"ت",2,0],["وفي ذلك السرب مستأسد","وإن كان في مرطح العين خِشفا",47,"ف",2,0],["وفي ذلك الخِدرِ المُكلَّلِ ظَبيَةٌ","لكلِّ فؤاد عندَ أجفانها ذَحلُ",48,"ل",1,0],["وفي ذلك الحي الذي سكن الحمى","غزال ربيب تتقي لحظه الأسد",49,"د",1,1],["وفي ذاك تكريمٌ لعلم وعزمة","وفيه وفاءٌ للوداد على طهر",50,"ر",1,0],["وفي ذاك تَنشيطٌ لطلاَّبنا الأُولى","عليهم لواء النِّيل يُعقد للنَّصرِ",50,"ر",1,0],["وَفي ذا الكف خمر","وَفي ذا الكف قطف",51,"ف",1,0],["وَفي ذا الخمر سكر","وَفي ذا القطف حتف",51,"ف",1,0],["وفي ذلك القبرِ المُقدَّسِ تُرْبُهُ","عَفَافٌ وإقدامٌ وحَزْمٌ ونائِلُ",52,"ل",1,0],["وفي ذرى الحرمل ظلّ لها","إذا غلا واحتدمَ الهجرُ",53,"ر",1,0],["وفي ذِمَّةِ مِن خَيرِ مَن وَطِئَ الثَّرَى","ومَن يَعتلِقهُ حَبلُه لا يُعَذَّب",54,"ب",1,0],["وَفي ذَملانِ العيسِ في كُلِّ مَهمهٍ","بِكُلِّ جَرٍ عاري الاِشاجِعِ شاحِبِ",55,"ب",1,0],["وفي ذا خلافٌ بيِّنٌ متحقِّقٌ","يقول به أهل الشريعة والهدى",56,"ا",1,0],["وفي ذي أراطٍ يوم كان لخيلنا","مجال عليهم في المكر وملعب",57,"ب",1,0],["وفي ذلك المغنى وجدت عصابةً","على المجد قد شدوا عقود المآزر",58,"ر",1,0],["وفي ذكر هول الموت والقبر والبلى","عن اللهو واللّذاتِ للمرء زاجر",59,"ر",1,0],["وفي ذلكَ المَغنى فتاةٌ كريمَةٌ","إِلى خَيرِ أَصلٍ في العَشِيرَةِ تَنتَمي",60,"م",2,0],["وفي ذروة الطود الشموخ بقمةٍ","تلوح في عرض الفضا أرزة العطر"