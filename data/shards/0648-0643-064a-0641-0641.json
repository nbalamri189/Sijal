{"poems":[[63,"لقد نزعت من عقد ثغرك درة","https://www.aldiwan.net/poem51366.html","الطويل"],[415,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79885","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89043","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4578,"يا من بألفاظه ازدانت نواحينا","https://www.poetsgate.com/ViewPoem.aspx?id=49531",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""]],"verses":[["وكيف فساد الأقحوان وعيبه","وريقك يسقيه المدامة والشهدا",0,"د",2,0],["وكيفَ فَرَى عرضَ الفَلاَ من يؤودُه","ويَبهرهُ في جانِب الخِدرِ أن يَخْطُو",1,"ط",2,0],["وكيفَ في رُقية الليالي","وصُمِّ حيَّاتها احتيالي",2,"ل",2,0],["وكيف في كلِّ ذاك العتبِ ما شَفيت","وكانَ في الحقِّ منه البعضُ يشفيها",3,"ي",3,0],["وكيف في الدين نخشى خفض نافلة","بعصرنا حيث ذاك المجد في صعد",4,"د",1,0],["وَكَيفَ فَراغُ القَلب من نارِ حسرةٍ","إِذا كانَت الأَلباب مرجعَ عبرة",5,"ه",1,0],["وكيف فيك يرى السلوان من بنيت","من حبكى بنية تشتاق لقياك",6,"ك",1,0],["وكيف فاهت بتحريك اللسان على","طلاب بحر يوالينا ويولينا",7,"ن",2,0],["وكيف فوق فراتِ العذب نسوته","صيّرن من كحلهن القلبَ مكتحلا",8,"ل",2,0]]}