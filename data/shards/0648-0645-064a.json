{"poems":[[53,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[86,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[54,"وميثاء خضراء زربية","https://www.aldiwan.net/poem27457.html","المتقارب"],[30,"وميتة في الأرض إلا حشاشة","https://www.aldiwan.net/poem29469.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[37,"وميراث ابن آجر حيث ألقى","https://www.aldiwan.net/poem7436.html","الوافر"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[64,"إذا هجرت فمن لي","https://www.aldiwan.net/poem67551.html","المجتث"],[78,"رعى الله من يصلى فؤادي بحبه","https://www.aldiwan.net/poem14243.html","الطويل"],[85,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[43,"شديد البعد من شرب الشمول","https://www.aldiwan.net/poem9954.html","الوافر"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[45,"أذم إليك تغليس الدجون","https://www.aldiwan.net/poem66667.html","الوافر"],[97,"متى نلتها كانت لأنفسنا منى","https://www.aldiwan.net/poem24587.html","الطويل"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[69,"النوم عن جفني طريح طريد","https://www.aldiwan.net/poem28920.html","السريع"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[21,"وميز في إنفاقه بين مصلح","https://www.aldiwan.net/poem36196.html","الطويل"],[52,"سلمت أمير المؤمنين على الدهر","https://www.aldiwan.net/poem27019.html","الطويل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"وميرائية تمشي اختيالا","https://www.aldiwan.net/poem66544.html","الوافر"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85382","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[77,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""]],"verses":[["وَمَيلٍ كَخيطانِ الأَراكِ تَرَنَّحوا","فَمِن ذَقَنٍ مُستَقبَلٍ بِلِسانِ",0,"ن",1,0],["وَميتَتي في النَوى وَالقُربِ واحِدَةٌ","إِذا تَكافَأَتِ الغاياتُ وَالسُبُلُ",1,"ل",1,0],["وَميضٌ رأى بُرْدَ الغَمامَةِ مُغْفَلاً","فمَدّ يَداً بالتِّبْرِ أعْلَمَتِ البُرْدا",2,"د",2,0],["وَميرَتِ الحيتانُ في بَحرِها","وَمَطمَعُ الإِنسانِ لا يُقدَرُ",3,"ر",1,0],["وَمِياهٌ قَد أَخجَلَ الوَردَ أَن عا","رَضَ تَذهيبَهُ لَها تَفضيضُ",4,"ض",1,0],["وَمَيثاءَ خَضراءَ زَربِيَّةٍ","بِها النَورُ يُزهِرُ مِن كُلِّ فَنّ",5,"ن",1,1],["وَمَيِّتَةٍ في الأَرضِ إِلاّ حُشاشَةً","ثَنَيتُ بِها حَيّاً بِمَيسورِ أَربَعِ",6,"ع",1,1],["وَمَيَّةَ في الظَعائِنِ وَهيَ شَكَّت","سَوادَ القَلبِ فَاِقتَتَل اِقتِتالا",7,"ل",2,0],["وَمَيَّةُ أَحسَنُ الثَقَلَينِ خَدّاً","وَسالِفَةً وَأَحسَنُهُ قَذالا",7,"ل",2,0],["وَمَيِّتَةِ الأَجلادِ يَحيا جَنينُها","لأَِوَّلِ حَملٍ ثُمَّ يورِثُها عُقرا",8,"ر",2,0],["وميراث ابن آجرَ حيث ألقى","بأصل الضنء ضئضئة الأصيل",9,"ل",1,1],["وميكال دهر جديد على","يديه تصبّ يد الرازق",10,"ق",1,0],["وَمَي لِروحي وَراحي","يا أَكثَري وَأَقَلّي",11,"ل",2,0],["وَميلي عَلى جِسمي بِجِسمِكِ فاِنثَنَت","تُعيدُ الَّذي أَمَّلتُ مِنها كَما تُبدي",12,"د",2,0],["وميت ضجت الدنيا عليه","وآخر ما تحس له نعيا",13,"ي",2,0],["وم يرد إحياء غد","راتِ الزمان يسأم",14,"م",1,0],["وَمَيدانُ الفَصاحَةِ وَالقَوافي","وَمُمتَحَنُ الفَوارِسِ وَالخُيولِ",15,"ل",1,0],["وميضُ جفاءٍ لو أمتُّ شرارَهُ","لما شبَّ لي بين الضُّلوعِ ضِرامُ",16,"م",1,0],["وَمَيلَهُما بِعَزمِ أَبي عَلِيٍّ","إِلى صَهباءَ تُشرِقُ في العُيونِ",17,"ن",1,0],["وميدان سباقين للمجد والعلى","إذا اشتجرت أخرى الميادين بالقنا",18,"ن",2,0],["وميلٌ إليها بالظنونِ وإنّما","يُنَكِّبُ عنها كلُّ يَقظانَ ذو حِجْرِ",19,"ر",1,0],["وميلوا وجولوا واحكموا وتخولوا","وصولوا وطولوا وانبذوا الزهدَ وانهبوا",20,"ب",3,0],["وميتتي فيك حسينيةٌ","ولي عذولٌ فوقَ ما بي يزيدْ",21,"د",1,0],["وميراثُ النبيِّ لكم وأنتم","وُلاةُ البيتِ غير مُكذَّبينا",22,"ن",2,0],["وَمَيَّزَ في إِنفاقِهِ بَينَ مُصلِحٍ","مُعايَشَةً يَضُرُ وَيَنفَعُ",23,"ع",1,1],["وَميدانُ وَحشٍ تَركُضُ الخَيلَ وَسطَهُ","فَيُؤخَذُ مِنها ما يَشاءُ عَلى قَدرِ",24,"ر",1,0],["ومَيْتٌ مُؤْذِنٌ بِفِرَاقِ رُوحٍ","أَقامَ وسُرِّيَتْ عنه شعُوبُ",25,"ب",1,0],["وَمَيَّلهُ إِلى الجِدِّ","فَفيهِ قُربُ مَن يَبعُد",26,"د",1,0],["وَمَينَ إِخفاقِ القَتَر","سارٍ وَلَيسَ لِلسَمَر",27,"ر",1,0],["وميرائيّةٍ تمشي اختيالاً","من التكريهِ فاترةِ الكلام",28,"م",1,1],["وَميراثُ النَبِيِّ وَصاحِبَيهِ","تِلاداً لا يُباعُ وَلا يُعارُ",29,"ر",1,0],["وَمياه العيون تمشي الهوَينا","فوق ظل تحت الغصون رَقيق",30,"ق",1,0],["وميّتٍ بعث الدنيا وعاش بها","ما كلُّ من ضمّه قبرٌ بملحود",31,"د",1,0],["وميض رأى برد الغمامة مغفلا","فمد يدا بالتبر أعملت البردا",32,"د",2,0],["وميطي الرِداء عن البُرعُمَينِ","يَفِضْ عَسلٌ منهما يَرعُف",33,"ف",1,0],["ومَيْتٌ ضَجَّتِ الدنيا عليه","وآخرُ ما تحسنُّ له نعيَّا",34,"ي",2,0]]}