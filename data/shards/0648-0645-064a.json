{"poems":[[53,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[86,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[54,"وميثاء خضراء زربية","https://www.aldiwan.net/poem27457.html","المتقارب"],[30,"وميتة في الأرض إلا حشاشة","https://www.aldiwan.net/poem29469.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[37,"وميراث ابن آجر حيث ألقى","https://www.aldiwan.net/poem7436.html","الوافر"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[64,"إذا هجرت فمن لي","https://www.aldiwan.net/poem67551.html","المجتث"],[78,"رعى الله من يصلى فؤادي بحبه","https://www.aldiwan.net/poem14243.html","الطويل"],[85,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[43,"شديد البعد من شرب الشمول","https://www.aldiwan.net/poem9954.html","الوافر"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[45,"أذم إليك تغليس الدجون","https://www.aldiwan.net/poem66667.html","الوافر"],[97,"متى نلتها كانت لأنفسنا منى","https://www.aldiwan.net/poem24587.html","الطويل"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[69,"النوم عن جفني طريح طريد","https://www.aldiwan.net/poem28920.html","السريع"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[21,"وميز في إنفاقه بين مصلح","https://www.aldiwan.net/poem36196.html","الطويل"],[52,"سلمت أمير المؤمنين على الدهر","https://www.aldiwan.net/poem27019.html","الطويل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"وميرائية تمشي اختيالا","https://www.aldiwan.net/poem66544.html","الوافر"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85382","الخفيف"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[77,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""],[115,"يثور بنار الغرام لارض مي","https://www.aldiwan.net/poem40492.html","عموديه"],[115,"أغث يا ختام المرسلين بإحسان","https://www.aldiwan.net/poem42161.html","الوافر"],[115,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[127,"تطاول همه ببراق سعر","https://www.aldiwan.net/poem24272.html","الوافر"],[135,"بدا علم الإنسان في عالم الحس","https://www.aldiwan.net/poem49035.html","الطويل"],[150,"وجدت ولا طب لما أنا واجد","https://www.aldiwan.net/poem68550.html","الطويل"],[169,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[186,"وما العيش إلا مع الغانيات","https://www.aldiwan.net/poem43736.html","المتقارب"],[203,"ومشفقة تظن بنا الظنونا","https://www.aldiwan.net/poem68147.html","الوافر"],[212,"فها كبدي من محجري تسيل","https://www.aldiwan.net/poem37841.html","الطويل"],[212,"وميالة العطفين غرثانة الحشى","https://www.aldiwan.net/poem37870.html","الطويل"],[212,"ونشوانة غيداء ظامية الحشا","https://www.aldiwan.net/poem37898.html","الطويل"],[221,"بينما الجو بديع رائق","https://www.aldiwan.net/poem55264.html","الرمل"],[252,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[252,"وميض ثغر يفتر بالثغر","https://www.aldiwan.net/poem1447.html",""],[261,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[270,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[280,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[281,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[282,"وميض برق أرى في فيك أم شنبا","https://www.aldiwan.net/poem32294.html","البسيط"],[305,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[342,"أخي فداك الروح يا حبيبي","https://www.aldiwan.net/poem55321.html","الرجز"],[348,"وميض البرق أم ثغر يلوح","https://www.aldiwan.net/poem19945.html","الوافر"],[348,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[353,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[391,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[391,"فاء الفتاة سقاني","https://www.aldiwan.net/poem54705.html","المجتث"],[406,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[416,"نبهت للنأي عيون الرفاق","https://www.aldiwan.net/poem53892.html","السريع"],[416,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[429,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[452,"وميثاء لا تحتلها الشمس ثرة","https://www.aldiwan.net/poem13658.html","الطويل"],[453,"خادم آمر كفيل بكتبي","https://www.aldiwan.net/poem61301.html","الخفيف"],[458,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[468,"وميت المن حتى الإمتنان","https://www.aldiwan.net/poem59587.html","السريع"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[477,"علامة سلواني إذا قلت بعدكم","https://www.aldiwan.net/poem15332.html","الطويل"],[505,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[515,"قفا فلعل الفيض من عبراته","https://www.aldiwan.net/poem12041.html","الطويل"],[515,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[536,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[551,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[558,"أنا النور المبين ولا أكني","https://www.aldiwan.net/poem33817.html","الوافر"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[567,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"],[567,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَمَيلٍ كَخيطانِ الأَراكِ تَرَنَّحوا","فَمِن ذَقَنٍ مُستَقبَلٍ بِلِسانِ",0,"ن",1,0],["وَميتَتي في النَوى وَالقُربِ واحِدَةٌ","إِذا تَكافَأَتِ الغاياتُ وَالسُبُلُ",1,"ل",1,0],["وَميضٌ رأى بُرْدَ الغَمامَةِ مُغْفَلاً","فمَدّ يَداً بالتِّبْرِ أعْلَمَتِ البُرْدا",2,"د",2,0],["وَميرَتِ الحيتانُ في بَحرِها","وَمَطمَعُ الإِنسانِ لا يُقدَرُ",3,"ر",1,0],["وَمِياهٌ قَد أَخجَلَ الوَردَ أَن عا","رَضَ تَذهيبَهُ لَها تَفضيضُ",4,"ض",1,0],["وَمَيثاءَ خَضراءَ زَربِيَّةٍ","بِها النَورُ يُزهِرُ مِن كُلِّ فَنّ",5,"ن",1,1],["وَمَيِّتَةٍ في الأَرضِ إِلاّ حُشاشَةً","ثَنَيتُ بِها حَيّاً بِمَيسورِ أَربَعِ",6,"ع",1,1],["وَمَيَّةَ في الظَعائِنِ وَهيَ شَكَّت","سَوادَ القَلبِ فَاِقتَتَل اِقتِتالا",7,"ل",2,0],["وَمَيَّةُ أَحسَنُ الثَقَلَينِ خَدّاً","وَسالِفَةً وَأَحسَنُهُ قَذالا",7,"ل",2,0],["وَمَيِّتَةِ الأَجلادِ يَحيا جَنينُها","لأَِوَّلِ حَملٍ ثُمَّ يورِثُها عُقرا",8,"ر",2,0],["وميراث ابن آجرَ حيث ألقى","بأصل الضنء ضئضئة الأصيل",9,"ل",1,1],["وميكال دهر جديد على","يديه تصبّ يد الرازق",10,"ق",1,0],["وَمَي لِروحي وَراحي","يا أَكثَري وَأَقَلّي",11,"ل",2,0],["وَميلي عَلى جِسمي بِجِسمِكِ فاِنثَنَت","تُعيدُ الَّذي أَمَّلتُ مِنها كَما تُبدي",12,"د",2,0],["وميت ضجت الدنيا عليه","وآخر ما تحس له نعيا",13,"ي",2,0],["وم يرد إحياء غد","راتِ الزمان يسأم",14,"م",1,0],["وَمَيدانُ الفَصاحَةِ وَالقَوافي","وَمُمتَحَنُ الفَوارِسِ وَالخُيولِ",15,"ل",1,0],["وميضُ جفاءٍ لو أمتُّ شرارَهُ","لما شبَّ لي بين الضُّلوعِ ضِرامُ",16,"م",1,0],["وَمَيلَهُما بِعَزمِ أَبي عَلِيٍّ","إِلى صَهباءَ تُشرِقُ في العُيونِ",17,"ن",1,0],["وميدان سباقين للمجد والعلى","إذا اشتجرت أخرى الميادين بالقنا",18,"ن",2,0],["وميلٌ إليها بالظنونِ وإنّما","يُنَكِّبُ عنها كلُّ يَقظانَ ذو حِجْرِ",19,"ر",1,0],["وميلوا وجولوا واحكموا وتخولوا","وصولوا وطولوا وانبذوا الزهدَ وانهبوا",20,"ب",3,0],["وميتتي فيك حسينيةٌ","ولي عذولٌ فوقَ ما بي يزيدْ",21,"د",1,0],["وميراثُ النبيِّ لكم وأنتم","وُلاةُ البيتِ غير مُكذَّبينا",22,"ن",2,0],["وَمَيَّزَ في إِنفاقِهِ بَينَ مُصلِحٍ","مُعايَشَةً يَضُرُ وَيَنفَعُ",23,"ع",1,1],["وَميدانُ وَحشٍ تَركُضُ الخَيلَ وَسطَهُ","فَيُؤخَذُ مِنها ما يَشاءُ عَلى قَدرِ",24,"ر",1,0],["ومَيْتٌ مُؤْذِنٌ بِفِرَاقِ رُوحٍ","أَقامَ وسُرِّيَتْ عنه شعُوبُ",25,"ب",1,0],["وَمَيَّلهُ إِلى الجِدِّ","فَفيهِ قُربُ مَن يَبعُد",26,"د",1,0],["وَمَينَ إِخفاقِ القَتَر","سارٍ وَلَيسَ لِلسَمَر",27,"ر",1,0],["وميرائيّةٍ تمشي اختيالاً","من التكريهِ فاترةِ الكلام",28,"م",1,1],["وَميراثُ النَبِيِّ وَصاحِبَيهِ","تِلاداً لا يُباعُ وَلا يُعارُ",29,"ر",1,0],["وَمياه العيون تمشي الهوَينا","فوق ظل تحت الغصون رَقيق",30,"ق",1,0],["وميّز الشام بالنعمى ودلّلها","فمن ثرى الشام صاغ الرّوح والجسدا",31,"د",2,0],["وميّتٍ بعث الدنيا وعاش بها","ما كلُّ من ضمّه قبرٌ بملحود",32,"د",1,0],["وميض رأى برد الغمامة مغفلا","فمد يدا بالتبر أعملت البردا",33,"د",2,0],["وميطي الرِداء عن البُرعُمَينِ","يَفِضْ عَسلٌ منهما يَرعُف",34,"ف",1,0],["ومَيْتٌ ضَجَّتِ الدنيا عليه","وآخرُ ما تحسنُّ له نعيَّا",35,"ي",2,0],["وميدان الوغا يبدي عجاجا","تقول الليل غلغله الظلام",36,"م",1,0],["وميل بجود منك من مال وأسرع ال","غياث وحقق فيك ظني وإيماني",37,"ي",1,0],["وميل جميع المسلمين لسيرنا","بحكمة رشد منك تصحى من السكر",38,"ر",1,0],["وَمَيتٍ بِالجَنابِ أَثَلَّ عَرشي","كَصَخرٍ أَو كَعَمرٍو أَو كَبِشرِ",39,"ر",1,0],["وميز طرْقَ الحق وهي غوامض","فأظهر نور الصبح للجنّ والإنسِ",40,"س",1,0],["وَميضُ الهَوى في القَلب يُوجَدُ خَفقُه","فَما لجِفُوني تَشتكي ألَمَ العَدوى",41,"و",2,0],["وَمَيلي إِلى أَهلِ التَواضُعِ وَالعُلى","بِوُدّي وَبُغضي الأَسفَلَ المُتَعالي",42,"ل",2,0],["وميدان آس وأشجار ورد","وشاهسفرمّ غضيض نضر",43,"ر",1,0],["وَميضُ عَقيقَةٍ لَمَعَت بِلَيلٍ","تَرى فيها العَقائِقَ مُستَبينا",44,"ن",2,0],["وميّالةُ العِطْفين ريّانُ قدِّها","خفيفٌ وأمّا رِدْفُها فَثَقِيْلُ",45,"ل",1,0],["ومَيَّالة العِطْفَيْنِ غَرْثانَةُ الحَشى","فلم تدرِ أنّي في هواها أُنَغَّصُّ",46,"ص",1,1],["وميم به ماءُ الحياةِ تصونه","عن الرَّشْفِ أسيافٌ حدادٌ نواضدُ",47,"د",1,0],["ومياه الحوض تنساب ضحى","بين أشجار الحديقة كالصلال",48,"ل",1,0],["وَميَّلكَ الواشي إِلى الصَدِّ وَالنَوى","وَلا عَجَبٌ لِلغُصنِ أَن يَتَميَّلا",49,"ل",2,0],["وَميضُ ثَغر يَفترُّ بالثَغرِ","أَسفر في رامَة عَلى السَفَرِ",50,"ر",1,1],["وميثاق الغواني مستحيل","فلا تكثر بهن الأعتقادا",51,"د",2,0],["وميَّلتِ الأنسامُ أزهارَ جنّةٍ","كأفئدةٍ خفّاقةٍ لرقيب",52,"ب",1,0],["وَمَيْدانُ فِكْرٍ لا يُحازُ لَهُ مَدىً","وَلا يَبْلُغُ الإِسْهابُ غايَةَ سَهْبِهِ",53,"ب",2,0],["وميلي إلى الصبر الجميل فإنه","لينصر من للصبر مال وعرجا",54,"ج",2,0],["وَميضَ بَرقٍ أَرى في فيكَ أَم شَنَبا","وَهَل رَشَفتَ رُضاباً مِنهُ أَم ضَرَبا",55,"ب",2,1],["وَميتُ القوى مَن لا يهيء بنفسهِ","لإنصافها من حيثُ يغبنُ جسمهُ",56,"م",2,0],["وميسم التقوى عليك بادي","وقسمات الناسك الغريب",57,"ب",1,0],["وَمِيضُ البَرْقِ أَمْ ثَغْرٌ يَلُوحُ","وَنَشْرُ المِسْكِ أَمْ شَنَبٌ يَفوحُ",58,"ح",1,1],["وَمَيَّزَ قولَ تلكَ وَذاكَ فيها","وَتَفْضِيلُ الجِراءِ علَى الجَرائِدْ",59,"د",1,0],["وَميلوا حَيثما مالت قُدود","كَأَعطافٍ مِن السُمرِ الرِشاقِ",60,"ق",1,0],["وميز الفرض من مسنونها باقتفاه","واستقبل الكعبة الغرا بحسن انتباه",61,"ا",2,0],["وَمِيمُهَا مُستَدِيرٌ","بِالصَّبرِ مُنذ زَم