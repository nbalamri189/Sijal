m/101364","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107284","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105144","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90890","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94532","الطويل"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138845",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73295","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136506",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83132","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83120","المتقارب"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138826",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72617","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76753","الطويل"],[4709,"من أين لي بحروف أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214868",""],[4884,"قهوة أمي","https://www.poetsgate.com/ViewPoem.aspx?id=210383",""],[4929,"قراءة دخانية","https://www.poetsgate.com/ViewPoem.aspx?id=207715",""],[4981,"حروف دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=190483",""],[5101,"مِرآتكَ الماء","https://www.poetsgate.com/ViewPoem.aspx?id=193169",""],[5121,"فَنَّان","https://www.poetsgate.com/ViewPoem.aspx?id=215811",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5186,"حسب إدراك ذي العوالم فكرا","https://www.poetsgate.com/ViewPoem.aspx?id=156486",""],[5225,"عليهم صابر","https://www.poetsgate.com/ViewPoem.aspx?id=25795",""],[5277,"أريدكَ مثلَ رابعة","https://www.poetsgate.com/ViewPoem.aspx?id=208530",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[5409,"يا زماني كأنما كل أيا","https://www.poetsgate.com/ViewPoem.aspx?id=155266",""],[5411,"النَّقْشُ اليَمانِي","https://www.poetsgate.com/ViewPoem.aspx?id=186271",""],[5431,"ومناها سماحةٌ والقبولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197474",""],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5596,"كلف بمكة","https://www.poetsgate.com/ViewPoem.aspx?id=206192",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[5736,"شكواي","https://www.poetsgate.com/ViewPoem.aspx?id=208435",""],[5790,"تأنوا ففي طي النسيم رسائل","https://www.poetsgate.com/ViewPoem.aspx?id=112102",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5957,"أيها المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213547",""],[6010,"أستاذة النحو ,,,","https://www.poetsgate.com/ViewPoem.aspx?id=175986",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6139,"نجوم الليل","https://www.poetsgate.com/ViewPoem.aspx?id=212336",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6259,"فؤادي الفداءُ لها من قببْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59354&r=&rc=2",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""],[572,"يا مُعرِضاً عنّي بوجهٍ مدبرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9432&r=&rc=289",""]],"verses":[["وَمَيلٍ كَخيطانِ الأَراكِ تَرَنَّحوا","فَمِن ذَقَنٍ مُستَقبَلٍ بِلِسانِ",0,"ن",1,0],["وَميتَتي في النَوى وَالقُربِ واحِدَةٌ","إِذا تَكافَأَتِ الغاياتُ وَالسُبُلُ",1,"ل",1,0],["وَميضٌ رأى بُرْدَ الغَمامَةِ مُغْفَلاً","فمَدّ يَداً بالتِّبْرِ أعْلَمَتِ البُرْدا",2,"د",2,0],["وَميرَتِ الحيتانُ في بَحرِها","وَمَطمَعُ الإِنسانِ لا يُقدَرُ",3,"ر",1,0],["وَمِياهٌ قَد أَخجَلَ الوَردَ أَن عا","رَضَ تَذهيبَهُ لَها تَفضيضُ",4,"ض",1,0],["وَمَيثاءَ خَضراءَ زَربِيَّةٍ","بِها النَورُ يُزهِرُ مِن كُلِّ فَنّ",5,"ن",1,1],["وَمَيِّتَةٍ في الأَرضِ إِلاّ حُشاشَةً","ثَنَيتُ بِها حَيّاً بِمَيسورِ أَربَعِ",6,"ع",1,1],["وَمَيَّةَ في الظَعائِنِ وَهيَ شَكَّت","سَوادَ القَلبِ فَاِقتَتَل اِقتِتالا",7,"ل",2,0],["وَمَيَّةُ أَحسَنُ الثَقَلَينِ خَدّاً","وَسالِفَةً وَأَحسَنُهُ قَذالا",7,"ل",2,0],["وَمَيِّتَةِ الأَجلادِ يَحيا جَنينُها","لأَِوَّلِ حَملٍ ثُمَّ يورِثُها عُقرا",8,"ر",2,0],["وميراث ابن آجرَ حيث ألقى","بأصل الضنء ضئضئة الأصيل",9,"ل",1,1],["وميكال دهر جديد على","يديه تصبّ يد الرازق",10,"ق",1,0],["وَمَي لِروحي وَراحي","يا أَكثَري وَأَقَلّي",11,"ل",2,0],["وَميلي عَلى جِسمي بِجِسمِكِ فاِنثَنَت","تُعيدُ الَّذي أَمَّلتُ مِنها كَما تُبدي",12,"د",2,0],["وميت ضجت الدنيا عليه","وآخر ما تحس له نعيا",13,"ي",2,0],["وم يرد إحياء غد","راتِ الزمان يسأم",14,"م",1,0],["وَمَيدانُ الفَصاحَةِ وَالقَوافي","وَمُمتَحَنُ الفَوارِسِ وَالخُيولِ",15,"ل",1,0],["وميضُ جفاءٍ لو أمتُّ شرارَهُ","لما شبَّ لي بين الضُّلوعِ ضِرامُ",16,"م",1,0],["وَمَيلَهُما بِعَزمِ أَبي عَلِيٍّ","إِلى صَهباءَ تُشرِقُ في العُيونِ",17,"ن",1,0],["وميدان سباقين للمجد والعلى","إذا اشتجرت أخرى الميادين بالقنا",18,"ن",2,0],["وميلٌ إليها بالظنونِ وإنّما","يُنَكِّبُ عنها كلُّ يَقظانَ ذو حِجْرِ",19,"ر",1,0],["وميلوا وجولوا واحكموا وتخولوا","وصولوا وطولوا وانبذوا الزهدَ وانهبوا",20,"ب",3,0],["وميتتي فيك حسينيةٌ","ولي عذولٌ فوقَ ما بي يزيدْ",21,"د",1,0],["وميراثُ النبيِّ لكم وأنتم","وُلاةُ البيتِ غير مُكذَّبينا",22,"ن",2,0],["وَمَيَّزَ في إِنفاقِهِ بَينَ مُصلِحٍ","مُعايَشَةً يَضُرُ وَيَنفَعُ",23,"ع",1,1],["وَميدانُ وَحشٍ تَركُضُ الخَيلَ وَسطَهُ","فَيُؤخَذُ مِنها ما يَشاءُ عَلى قَدرِ",24,"ر",1,0],["ومَيْتٌ مُؤْذِنٌ بِفِرَاقِ رُوحٍ","أَقامَ وسُرِّيَتْ عنه شعُوبُ",25,"ب",1,0],["وَمَيَّلهُ إِلى الجِدِّ","فَفيهِ قُربُ مَن يَبعُد",26,"د",1,0],["وَمَينَ إِخفاقِ القَتَر","سارٍ وَلَيسَ لِلسَمَر",27,"ر",1,0],["وميرائيّةٍ تمشي اختيالاً","من التكريهِ فاترةِ الكلام",28,"م",1,1],["وَميراثُ النَبِيِّ وَصاحِبَيهِ","تِلاداً لا يُباعُ وَلا يُعارُ",29,"ر",1,0],["وَمياه العيون تمشي الهوَينا","فوق ظل تحت الغصون رَقيق",30,"ق",1,0],["وميّز الشام بالنعمى ودلّلها","فمن ثرى الشام صاغ الرّوح والجسدا",31,"د",2,0],["وميّتٍ بعث الدنيا وعاش بها","ما كلُّ من ضمّه قبرٌ بملحود",32,"د",1,0],["وميض رأى برد الغمامة مغفلا","فمد يدا بالتبر أعملت البردا",33,"د",2,0],["وميطي الرِداء عن البُرعُمَينِ","يَفِضْ عَسلٌ منهما يَرعُف",34,"ف",1,0],["ومَيْتٌ ضَجَّتِ الدنيا عليه","وآخرُ ما تحسنُّ له نعيَّا",35,"ي",2,0],["وميدان الوغا يبدي عجاجا","تقول الليل غلغله الظلام",36,"م",1,0],["وميل بجود منك من مال وأسرع ال","غياث وحقق فيك ظني وإيماني",37,"ن",2,0],["وميل جميع المسلمين لسيرنا","بحكمة رشد منك تصحى من السكر",38,"ر",1,0],["وَمَيتٍ بِالجَنابِ أَثَلَّ عَرشي","كَصَخرٍ أَو كَعَمرٍو أَو كَبِشرِ",39,"ر",1,0],["وميز طرْقَ الحق وهي غوامض","فأظهر نور الصبح للجنّ والإنسِ",40,"س",1,0],["وَميضُ الهَوى في القَلب يُوجَدُ خَفقُه","فَما لجِفُوني تَشتكي ألَمَ العَدوى",41,"و",2,0],["وَمَيلي إِلى أَهلِ التَواضُعِ وَالعُلى","بِوُدّي وَبُغضي الأَسفَلَ المُتَعالي",42,"ل",2,0],["وميدان آس وأشجار ورد","وشاهسفرمّ غضيض نضر",43,"ر",1,0],["وَميضُ عَقيقَةٍ لَمَعَت بِلَيلٍ","تَرى فيها العَقائِقَ مُستَبينا",44,"ن",2,0],["وميّالةُ العِطْفين ريّانُ قدِّها","خفيفٌ وأمّا رِدْفُها فَثَقِيْلُ",45,"ل",1,0],["ومَيَّالة العِطْفَيْنِ غَرْثانَةُ الحَشى","فلم تدرِ أنّي في هواها أُنَغَّصُّ",46,"ص",1,1],["وميم به ماءُ الحياةِ تصونه","عن الرَّشْفِ أسيافٌ حدادٌ نواضدُ",47,"د",1,0],["ومياه الحوض تنساب ضحى","بين أشجار الحديقة كالصلال",48,"ل",1,0],["وَميَّلكَ الواشي إِلى الصَدِّ وَالنَوى","وَلا عَجَبٌ لِلغُصنِ أَن يَتَميَّلا",49,"ل",2,0],["وَميضُ ثَغر يَفترُّ بالثَغرِ","أَسفر في رامَة عَلى السَفَرِ",50,"ر",1,1],["وميثاق الغواني مستحيل","فلا تكثر بهن