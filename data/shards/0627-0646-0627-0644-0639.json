يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[539,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[552,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[552,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[554,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"إن العوام كلها موجودة","https://www.aldiwan.net/poem34484.html","الكامل"],[559,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[559,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[563,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[576,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[576,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[577,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"]],"verses":[["إِنَّ العِشارَ لاتَقي مِن سَيفِهِ","دِماءَها عامَ الجُدوبِ بِاللَبَن",0,"ن",1,0],["إِنَّ العِدا عَن غُروبِهِ طَلَعوا","وَبَعدَما غارَ سَيفُهُ نَجَموا",1,"م",3,0],["إِنَّ العُبابَ إِذا تَغَطغَطَ أَو طَمى","جَعَلَ الجِبالَ وَإِن عَلَونَ مَسيلا",2,"ل",2,0],["إِنَّ العِدى لَيُنضِها","إِن لَم يَقِ العَفوَ حَزَر",3,"ر",1,0],["إِنَّ العُيونَ عَنِ العَلْياءِ نابِيَةٌ","وَمَسْرَحُ العَيْنِ مِنّي مَسْبَحُ الشُّهُبِ",4,"ب",1,0],["إنّ العُلا في شِفارِ البِيضِ كامِنَةٌ","أو في الأسِنَّةِ منْ عَسَّالَةٍ ذُبُلِ",5,"ل",1,0],["إِنَّ العَواذِلَ قَد أَشَعنَ حَديثَنا","فَالناسُ بَينَ مُكَذِّبٍ وَمُصَدِّقِ",6,"ق",1,0],["إِنَّ العِبادَ وَشَأنَهُم وَأُمورَهُم","بِيَدِ الإِلَهِ يُقَلِّبُ الأَحوالا",7,"ل",2,0],["إِنَّ العَطيَّةَ خَيرُ ما وَجَّهتَها","وَحَسِبتَها حَمداً وَأَجراً واجِبا",8,"ب",2,0],["إِن العَراقَ لِأَهلي لَم يَكُن وَطَناً","وَالبابُ دونَ أَبي غَسّانَ مَشدودُ",9,"د",1,0],["إن العراق لعمر الله مسبعة","تَواثبُ الأسد فيه من هنا وهنا",10,"ن",2,0],["إن العراق بعَرضِه وبطوله","وبرافديه وباسقات نخليه",11,"ل",3,1],["أن العوائد كالأغلال تَجمعنا","على قُلوب لنا منهنّ أشتات",12,"ت",1,0],["أن العقاب يزيد النفس شِرَّتها","وليس يُنْكِر هذا غير مَن جهِلا",13,"ل",2,0],["إن العراق على بضاضة قطره","أمسى بفقدك يابساً معروقا",14,"ق",2,0],["إِنَّ العُيونَ الَّتي في طَرفِها حَوَرٌ","قَتَلنَنا ثُمَّ لَم يُحيِينَ قَتلانا",15,"ن",2,0],["إِنَّ العَدُوَّ إِذا رَمَوكَ رَمَيتَهُم","بِذُرى عَمايَةَ أَو بِهَضبِ سُواجِ",16,"ج",1,0],["إِنَّ العَدُوَّ إِذا راموا قَناتَكُمُ","يَلقَونَ مِنها صَميماً غَيرَ مُنادِ",17,"د",1,0],["إِنَّ العَواذِلَ لَم يَجِدنَ كَوَجدِنا","فَلَهُنَّ مِنكَ تَعَبُّدٌ وَزَفيرُ",18,"ر",1,0],["إن العشيرة تستثيب بماله","فتغير وهو موفِّر أموالَها",19,"ه",2,1],["إِنَّ العَرانينَ مِن كَعبٍ وَعامِرِها","وَهاشِمٍ وَقَديمُ المَجدِ وَالحَسَبُ",20,"ب",1,0],["إنَّ العذولَ إذا رآه ولامني","أبصرتموا أعمى يحاور أطرشا",21,"ش",2,0],["إن العذول هو الغني وأن من","يفني عليك حياته لموفّق",22,"ق",1,0],["إن العبيدَ إذا أهدتْ لسادتها","فقد تعدَّت وأَربتْ كلَّ إرباءِ",23,"ا",2,0],["إن العلاء لَمَاجِدٌ ولِمَاجِدٍ","من معشر طلبوا العلاء فأدلجوا",24,"ج",3,0],["إن العلاء للعُلا نِعْمَ الأخُ","لا يفعل السُّوءَى لرضْخٍ يُرْضَخُ",25,"خ",1,0],["إن العقوبةَ بالأيورِ تزيدُها","زللاً إلى ما قدّمتْ وسقاطا",26,"ط",2,0],["إن العيون لتشتاقُ الرياضَ إذا","ما الزهرُ أشرقَ فيها وهوْ مُشتبكُ",27,"ك",1,0],["إن العيوبَ مع التتبّع جمةٌ","وكثيرُهنّ إذا اغتفرت قليلُ",28,"ل",1,0],["إِنَّ العَرارَة وَالنُبوحَ لِدارِمٍ","وَالمُستَخِفُّ أَخوهُمُ الأَثقالا",29,"ل",2,0],["ان العيون اذا الرزية صرحت","عند البكاء كثيرة الالحاح",30,"ح",1,0],["ان العراق لكم يجل وانما","اجلالكم في وقته اجلالها",31,"ل",3,0],["ان العراق شقيق مصر","على نزوح في النخوم",32,"م",1,0],["ان العراق به يعيش لشقوة","شعب يسام الذل ثم يسام",33,"م",1,0],["ان العجول على نبالة قصده","متعثر في السير بالاذيال",34,"ل",1,0],["إن العلاقة بيننا قد وثقت","فكأن عروتها من الميلاد",35,"د",1,0],["إِنَّ العِنايَةَ لَمّا جامَلَت وَعَدَت","أَلّا تَكُفَّ وَأَن تَترى أَياديها",36,"ي",3,0],["إِنَّ العِنايَةَ لِلبِلادِ تَخَيَّرَت","وَالخَيرُ ما تَقضي وَما تَختارُ",37,"ر",1,0],["إنَّ العُلاَ شِيَمِي والبَأْسَ مِنْ نِقَمي","والمَجْدَ خِلْطُ دَمي والصِّدْقَ حَشْوُ فَمي",38,"ي",1,1],["إن العُلَى حدَّثتِني وهي صادقةٌ","في ما تُحدِّثُ أنَّ العزَّ في النُقَلِ",39,"ل",1,0],["إن العُلَى لم تزلْ تبغِي الكَفِيَّ لها","حتَّى اطمأَنَّتْ إِلى معمورِ ناديكا",40,"ك",2,1],["إنَّ العيونَ إِذا نطقتُ تخاوصتْ","نحوي يروقُهُمُ المقالُ الناصِعُ",41,"ع",1,1],["إِنَ العَرَبُ اِنقادَت إِلَيكَ قُلوبُها","فَقَد جِئتَ إِحساناً إِلى كُلِّ مُعرِبِ",42,"ب",1,0],["إِنَّ العَتيدَ صَبابَةً مَن لا يَني","يَدعو صَبابَتَهُ الخَيالُ إِذا سَرى",43,"ر",2,0],["إِنَّ العَواصِمَ قَد عُصِمنَ بِأَبيَضٍ","ماضٍ كَحَدِّ الأَبيَضِ المَصقولِ",44,"ل",1,0],["إِنَّ العُقولَ لَذاهِلا","تٌ غافِلاتٌ لاهِيَه",45,"ي",2,0],["إِنَّ العُقولَ عَنِ الجِنا","نِ وَحورِهِنَّ لَساهِيَه",45,"ي",2,0],["إِنَّ العُلى حَدَّثَتني وَهيَ صادِقَةٌ","إِنَّ المَعارِفَ في أَهلِ النُهى ذِمَمُ",46,"م",1,0],["إِنَّ العَزاءَ وَإِن فَتىً حُرِمَ الغِنى","رِزقٌ جَزيلٌ لِلَّذي لَهُ يُرزَقُ",47,"ق",1,0],["إِنَّ الْعُلا أَثَرٌ تَحْيَا بِذُكْرَتِهِ","أَسْمَاءُ قَوْمٍ طَوَى أَحْسَابَهَا الْقِدَمُ",48,"م",1,0],["إن العراقَ بلا نصيرٍ منكم","وبلا مُجيرٍ ، مُقفِرٌ وجديب",49,"ب",1,0],["إِنّا لَعَمرُكِ ما نَخافُ وَما","نَرجو زِيارَةَ زائِرٍ ظُهُرا",50,"ر",2,0],["إِنَّ العَواذِلَ قَد بَكَرنَ يَلُمنَني","وَحَسِبتُ أَكثَرَ لَومِهِنَّ ضِرارا",51,"ر",2,0],["إنا لعمرك نهدي كلَّ مُعتَسِفٍ","إلى السّبيلِ ونلويهِ إذا جَمحا",52,"ح",2,0],["إِنّا لَعَمرُ الأُلى ظَنّوا الظُنونَ بِنا","لا بِالضِعافِ وَلا القَومِ التَنابيلِ",53,"ل",1,0],["إِنّا لَعَمرُ اللائِمينَ عَلى الهَوى","لَنَرى سَواءً مَن يَلومُ وَيَعذِرُ",54,"ر",1,0],["إِنَّ العَدُوَّ أَحَبُّ مِمَّن تَصطَفي","وَأَجَلُّ شَأناً في النُفوسِ وَأَرفَعُ",55,"ع",1,0],["إِنّا لَعَمرُكَ ما نُطيعُ لِغَيرِهِ","حُكماً وَلا نُعطي سِواهُ زِماما",56,"م",2,0],["إنّا لعمرِ اللَّهِ نَعرِفُ حَقَّهُ","ونُعِزُّ مِلَّته التي نتملَّلُ",57,"ل",1,0],["إِنَّ العِذارَ صَحيفَةٌ تَتلو لَنا","ما كانَ صانَ الحُسنُ مِن أَسرارِهِ",58,"ر",2,0],["أَنَّ العَرارَةَ وَالنُبوحَ لِطَيِّئٍ","وَالعِزَّ عِندَ تَكامُلِ الأَحسابِ",59,"ب",1,0],["إنَّ العُلا لَمْ تَسْتَقِمْ إلاَّ بِكُمْ","يا خَمْسَةً كَدَعائِمِ الإِسْلامِ",60,"م",1,0],["إنْ العِمادَ أرانا","بأنَّه الْيَوْمَ صائِمْ",61,"م",1,0],["إِنَّ العُيونَ حُجِبنَ عَنكَ بِهَيبَةٍ","فَإِذا بَدَأتَ بِهِنَّ نُكِّسَ ناظِرُ",62,"ر",1,0],["إِنَّ العُيونَ الَّتي في طَرفِها مَرَضٌ","فَرَجَّعَتهُ بِلَحنٍ وَقعُهُ شَكِلُ",63,"ل",1,0],["إِنَّ العُروقَ إِذا اِستَسَرَّت في الثَرى","أَندى النَباتُ بِها وَطابَ المَزرَعُ",64,"ع",1,0],["إِنَّ العَواريِّ اِستُرِدَّ جَميعُها","فَالراحُ مِنها وَالجُسومُ عَواري",65,"ر",2,0],["إِنَّ العُقولَ تَقولُ مولِيَةً","لَيسَ الأَنامُ كَنابِتِ البَقلِ",66,"ل",1,0],["إِنَّ العِراقَ وَإِنَّ الشامَ مُذ زَمَنٍ","صِفرانِ ما بِهِما لِلمُلكِ سُلطانُ",67,"ن",1,0],["إِنّا لَعَمرُكَ لا يُضا","مُ حَليفُنا أَبَداً لَدَينا",68,"ن",2,0],["إِنَّ العروبة نفسها","عَن عز بيضتها تحامي",69,"م",2,0],["إن العداء لشر","تذمه العقلاء",70,"ا",2,0],["إن العراق لبيت","لأهله أي بيت",70,"ت",1,0],["إنَّ العيون قريرات بما شهدت","وَالقَلب يفرح والآمال تبتسم",71,"م",1,0],["إنَّ العقول لعمر اللَه ساخرة","مما رموك به زوراً وبهتانا",72,"ن",2,0],["إن العدالة ويك اليوم في الطلبِ","يا ظلم فاِستخف أَو فالجأ إلى الهربِ",73,"ب",1,1],["إن العراق لأمٌّ","لنا وَنحن بنوها",74,"ه",2,0],["إن العراق على فتوة ضيفه","يَبني الرجاء ويعقد الآمالا",75,"ل",2,0],["إن العراق لمسعود برؤيته","أباً له من بلاد العدل قد وردا",76,"د",2,0],["إنّ العَوائقَ عُقْنَ عنكَ ركائبي","فلَهُنّ من طَرَبٍ إليكَ هَديلُ",77,"ل",1,0],["إِنْ العَرِينَ وَهَؤُلاَءِ أُسُودُهُ","لَمُؤَمَّنٍ بِتَرْعْرُعِ الأَشْبَالِ",78,"ل",1,0],["إِنَّ الْعَقِيدَةَ إِنْ صَحَّتْ وَزَلْزَالَهَا","مُفِني الْقُرَى فَهْيَ حِصْنٌ غَيْرُ مَهْدُودِ",79,"د",1,0],["إِنَّ الْعَقِيدَةَ نِعْمَةٌ عُلْوِيَّةٌ","تَصْفُو عَلَى الْنِّقَمَاتِ وَالأَرْزَاءِ",80,"ا",2,0],["إِنَّ العَقِيدَةَ شِيمَةٌ عُلْوِيَّةٌ","تَصفُو عَلَى الأَكْدَارِ وَالأَقْذَاءِ",81,"ا",2,0],["إنَّ العذارَى حماك اللّهُ أحْجِيَةٌ","بها النفورُ رضاًن والحقُّ نُكْرانُ",82,"ن",1,0],["إنَّ العروبةَ تدري أَنَّ صاحبَهُ","يَرْعَى حِماها وعينُ اللهِ ترعاهُ",83,"ا",2,0],["إن العروبةَ لا تفنَى، لو فَنِيَتْ","شُمّ الجبال فناءَ الأربُع الدُّرُس",84,"س",1,0],["إن العروبة لو خُطَّتْ مفاخرُها","سِفْرًا، لكنتِ لهذا السفرِ عُنوانا",85,"ن",2,0],["إن العروبةَ قد باتَتْ موحَّدَةً:","حسٍّا، وعاطفةً؛ أرضًا وسكَّانا",85,"ن",2,0],["إنَّ العروبةَ قد صَحَتْ","من نوم أصحاب الرقيمِ",86,"م",1,0],["إن العراقَ وقد نُعيت موكِّلٌ","مما دهاه يمُقْعِدٍ ومقيم",87,"م",1,0],["إنَّ العراقَ وقد نزلتَ رُبوعَهُ","لَيَعُدُّ ساكِنَه لديكَ نزيلا",88,"ل",2,0],["إنَّ العراقَ يُجلُّ بيْعةَ هاشمٍ","من عهدِ جدِّكَ بالقرونِ الأولى",88,"ل",2,0],["إنَّ العذارَى حماك اللّهُ أحْجِيَة ٌ","بها النفورُ رضاً والحقُّ نُكْران",89,"ن",1,0],["إن العدى قد أحدثوا الدواهيا","وروعوا الآباء والذراريا",90,"ي",2,0],["ان العبيد عبيد كيفما انتحلوا","اسم المراتب والسادات سادات",91,"ت",1,0],["إن العناوين التي","كنا نسير على غرارة",92,"ر",2,0],["إن العروبة والتعاجم في الهوى","سي فقدك تهيننا فنهون",93,"ن",1,0],["إن العيون النجل أصل بليّتي","ومنِيتي وصبابتي وعنائي",94,"ا",2,0],["إن العظائمَ ربّما بُلغت","بالهَوْن لا بالكرِّ والفَرِّ",95,"ر",1,0],["إِنَّ العُلى المُعيي المُلوكَ طِلابُها","لَكَ دونَ هَذا الخَلقِ يُفتَحُ بابُها",96,"ب",3,1],["إِنَّ العَواصِمَ نادَت مِنكَ عاصِمَها","وَقَد تَوالى عَلَيها الخَوفُ وَالرَهَبُ",97,"ب",1,0],["إِنَّ العَواصِمَ مُذ جادَت يَداكَ بِها","في كُلِّ يَومٍ إِلَيها لِلمُنى سَفَرُ",98,"ر",1,0],["إِنَّ العُلى رَضِيَتكُمُ غُرَراً لَها","مِن بَعدِ أَن أَبَتِ المُلوكَ حُجولا",99,"ل",2,0],["إِنَّ العِراقَ لَم أُفارِق أَهلَهُ","عَن شَنَآنٍ صَدَّني وَلا قِلى",100,"ا",1,0],["إِنَّ العَزاءَ إِذا عَزَّتهُ جائِحَةٌ","ذَلَّت عَريكَتُهُ فَاِنقادَ مَجنوبا",101,"ب",2,0],["إِنَّ العِتاقَ مِنَ الجِيادِ هِيَ الَّتي","تَجري الأُصولُ بِها عَلى عِلّاتِها",102,"ت",3,0],["إن العيون وقاك الله نظرتها","يفعلن في اللب ما لا تفعل السحره",103,"ر",2,0],["إن الع