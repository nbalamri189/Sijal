m/ViewPoem.aspx?id=103531",""],[5092,"خذني لغزة","https://www.poetsgate.com/ViewPoem.aspx?id=175328",""],[5150,"أم الدنيا .. مصر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202872",""],[5264,"يا شعب قوم فتح عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=121863",""],[5285,"أنشودة حب","https://www.poetsgate.com/ViewPoem.aspx?id=204395",""],[5295,"فجر المنى","https://www.poetsgate.com/ViewPoem.aspx?id=159305",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5376,"يا مصرَ أهلوك قد باتوا على ألمِ","https://www.poetsgate.com/ViewPoem.aspx?id=202907",""],[5376,"على مشارفِ عيد اللهِ مبتسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205890",""],[5411,"مِصْر العُروبَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=185426",""],[5419,"عذراً رسولَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=32217",""],[5431,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=183051",""],[5431,"يامصر...","https://www.poetsgate.com/ViewPoem.aspx?id=202807",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5574,"في كنفِ الإلٰهِ مُهدهِداً بدراً","https://www.poetsgate.com/ViewPoem.aspx?id=206002",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5612,"مكاشفة","https://www.poetsgate.com/ViewPoem.aspx?id=185750",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5701,"يا ليت شعري أي شيء أرى","https://www.poetsgate.com/ViewPoem.aspx?id=164594",""],[5701,"يا مصدر السلطات مالك هكذا","https://www.poetsgate.com/ViewPoem.aspx?id=164582",""],[5701,"سهرت أنظمه والناس قد هجعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164586",""],[5704,"مصر أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192534",""],[5725,"الى الشهيد مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=211703",""],[5736,"طوبى اليوم تنزيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=208241",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[4623,"محبتي لك نجتني من العطب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146603",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[402,"يا مصر أنت الهل والسكن","https://www.poetsgate.com/ViewPoem.aspx?id=36539",""],[5829,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=176839",""],[192,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=16376",""],[5956,"حتى الدجى حسد النجاح فقد سجى","https://www.poetsgate.com/ViewPoem.aspx?id=193508",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6004,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=33680",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6068,"#مصر‬ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=177017",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[5190,"عاشق الكنانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85059&r=&rc=134",""]],"verses":[["يا مُصعَبَ العَلياءِ قا","دَتكَ العِدا نِقضاً ذَلولا",0,"ل",2,0],["يا مُصعَباً بَخَسَت أَيدي المَنونِ بِهِ","فَقيدَ قَودَ ذَلولِ الظَهرِ مِطواعِ",1,"ع",1,0],["يا مُصْطَفَى منْ قبْلِ نشْأةِ آدَمٍ","والكوْنُ لمْ تُفْتَحْ لهُ أغْلاقُ",2,"ق",1,1],["يا مُصطَفى الرّحمانِ والنّورُ الذي","أخْفى الضّلالَ وأظْهرَ التّوْحيدا",3,"د",2,1],["يا مِصرُ حَتّامَ يَشكو الفَضلُ في زَمَنٍ","يُجنى عَلَيهِ وَيُمسي فيكِ أَسوانا",4,"ن",2,0],["يا مِصرُ حَسبُكِ ما بَلَغتِ مِنَ المُنى","صَدَقَ الرَجاءُ وَصَحَّتِ الأَحلامُ",5,"م",1,0],["يا مِصرُ قَد أَودى فَتا","كِ وَلا فَتىً إِلّا عَلي",6,"ل",2,0],["يا مِصرُ هَل بَعدَ هَذا اليَأسِ مُتَّسَعٌ","يَجري الرَجاءُ بِهِ في كُلِّ مُضطَرَبِ",7,"ب",1,0],["يَا مِصْرُ أَنْتِ الأَهْلُ وَالسَّكَنُ","وَحِمىً عَلَى الأَرْوَاحِ مُؤْتَمَنُ",8,"ن",1,1],["يَا مِصْرُ لَوْ تُقْدَرُ الأَقْدَارُ بِالكِرَمِ","لَكُنْتِ سَابِقَةَ الأَمْصَار وَالأُمَمِ",9,"م",1,1],["يَا مِصْرُ يَا دَارَ السَّمَاحَةِ وَالنَّدَى","دُومِي وَعِزِّي فِي المَمَالِكِ واعْظُمِي",10,"م",2,0],["يَا مُصْطَفَى مِصْرَ الرَّفِيعَ مَقامُهُ","هَيْهَاتَ يَبْدِلُ مَا بَلَغْتَ مَقَامُ",11,"م",1,0],["يَا مِصْرُ خَطْبُكِ خَطْبُ الشَّرْقِ أَجْمَعِهِ","عَلَى اخْتِلافِ بَنِيهِ وَالأَسَى عُمَمُ",12,"م",1,0],["يا مصطفى وكمامُ الكون ما فتقت","يا مجتبى وزناد النور ما قُدِحا",13,"ح",2,0],["يا مُصطفى والكونُ لم تعلَقُ بِهِ","من بعدُ أيدي الخَلْقِ والإنشاءِ",14,"ا",2,0],["يا مصر أما بشمسِ حسنٍ","أو بشمسِ علمٍ ليَ اسْتميلي",15,"ل",2,0],["يا مصر فيك الشعر مات أميره","وانقض يصرخ تاجه وسريره",16,"ر",2,1],["يا مصر حزنك سوف يبقى لاذعا","حتى يجيء إليك منك نظيره",16,"ر",2,0],["يا مصر حزنك سوف يبقى لادغا","حتى يجيئ اليك منك نظيره",17,"ه",1,0],["يا مصر يا فتاتي","يا زينة البنات",18,"ت",1,0],["يا مصر سماؤك جوهرة","وثراك بحار عسجده",19,"د",2,1],["يا مِصرُ أَنتِ كِنانَةُ اللَهِ الَّتي","لا تُستَباحُ وَلِلكِنانَةِ حامِ",20,"م",1,0],["يا مُصطَفى البُلَغاءِ أَيَّ يَراعَةٍ","فَقَدوا وَأَيَّ مُعَلِّمٍ بِيَراعِ",21,"ع",1,0],["يا مِصرُ أَشبالُ العَرينِ تَرَعرَعَت","وَمَشَت إِلَيكِ مِنَ السُجونِ أُسودا",22,"د",2,0],["يا مصر أنت الكون والدنيا معاً","وعظائم الأجيال في تاجيك",23,"ك",1,0],["يا مصرُ غُضّي من جمالِكِ واحْجُبي","سُلطانَ حُسنْكِ عن هَوى الأبناءِ",24,"ا",2,0],["يا مصرُ عهدكِ من أذىً ومرارةٍ","وهَواكِ من هَمٍّ ومن بَلبالِ",25,"ل",1,0],["يا مصرُ عامُكِ عامُ الخَيرِ فَاِرتَقِبي","فيهِ المُنى وَثِقي مِنهُ بِتَنويلِ",26,"ل",1,0],["يا مِصرُ خَطبُكِ في المَمالِكِ فادِحُ","وَمَصابُ أَهلِكِ جاوَزَ المُسطاعا",27,"ع",2,0],["يا مِصرُ أَنتِ لِكُلِّ نَفسٍ مَطلَبٌ","جَلَلٌ وَأَنتِ لِكُلِّ قَلبٍ مَطمَعُ",28,"ع",1,0],["يا مِصرُ إِن رَجَعَ المَشوقُ فَقَد وَفى","حُسنُ البَلاءِ بِحُسنِكِ الفَتّانِ",29,"ن",1,0],["يا مِصرُ لا تَلِدي رِجالاً بَعدَهُم","وَأَرى الرِجالَ لِغَيرِ ذَلِكَ تولَدُ",30,"د",1,0],["يا مِصرُ هُبّي في المَمالِكِ وَاِعمَلي","ذَهَبُ الكَرى وَتَوَلَّتِ الأَحلامُ",31,"م",1,0],["يا مِصرُ ماذا تَطلُبينَ أَما كَفى","أَن تُصبِحي لِلعادِياتِ طَعاما",32,"م",2,0],["يا مصلتَ السيف لا تطلب به بدلاً","لا تبقينَّ فما أبقى وما عدلا",33,"ل",2,1],["يا مِصرُ حَسبُكِ ما رَضيتِ مِنَ الأَذى","وَبَرِئتِ مِن ماضيكِ إِن لَم تَنقَمِ",34,"م",1,0],["يا مصر أَنت اليَوم وح","دَكِ ذلك البلد المفدّى",35,"د",2,0],["يا مصر إِنَّك أَنت اليوم مملكة","في ذمة العلم قبل الصارم الذرب",36,"ب",1,0],["يا مصر إنك أنت اليوم آسية","عَلى الوليّ وَما بغداد تختلف",37,"ف",1,0],["يا مصرُ ذلكَ يوم الملتقى وعلى","صَباحه قَدِم الرُّسْلُ الأجلَّاءُ",38,"ا",2,0],["يا مصر أشبال العرين ترعرعت","ومشت إليكي من القيود أسودا",39,"د",2,0],["يَا مِصْرُ دَامَ عُلُوٌّ جَدِّكْ","عِيْدُ الجَلاَءِ أَتى كَوُدِّكْ",40,"ك",1,1],["يَا مِصْرُ كَمْ فِي سِيرَةِ الجِيلِ الَّذِي","يَمْضِي هُدىً لِلوَاحِقِ الأَجْيالِ",41,"ل",1,0],["يَامِصْرُ قَامَ العُذْرُ إِنْ","يُقْلِقْ مَضَاجِعَكِ الوَجِيبُ",42,"ب",1,0],["يَا مُصْطَفَى زَادَكَ اللهُ الكَرِيمُ وَمَا","غَيْرُ الحَلَى مِنْ مَزِيدٍ فَوْقَ مَا وَهَبَا",43,"ب",2,0],["يَا مُصْطَفَى زَادَكَ اللهُ الكَرِيمُ وَمَا","يَزِيدُ إِلاَّ حُلَىً تَجْلُو الَّذِي وَهَبَا",44,"ب",2,1],["يا مِصْرُ بَاهِي كُلَّ مِصْرٍ بِالأولَى","أَنْجَبْتِ مِنْ أَبْنَائِكِ الْعُظَمَاءِ",45,"ا",2,0],["يا مصرُ ما نظمَ الجهاد قصيدة","إلا استهلّ بذكركِ الفواح",46,"ح",1,1],["يا مصر ما انفتحت عين على حسن","إلا وأطلعت ألفاً من نظائره",47,"ر",2,0],["يا مِصْرُ نَحْنُ الْفِدَاءُ نَحْنُ","ما مَسَّنا في الْخُطُوبِ وَهْنُ",48,"ن",1,0],["يا مِصْرُ فارُوقُكِ الْمُرَجَّى","إِلَيْهِ تَرْنُو الْمُنَى وتُزْجَى",48,"ج",2,0],["يا مصرُ، شُقِّي ثياب العرسُ، وانتحبي!!","مَن في الحمى بعد إبراهيم للأدب؟",49,"ب",1,1],["يا مصرُ، قد عزَّ العزاءْ","نَفنى، وأنتِ لك البقاءُ!",50,"ا",2,1],["يا مصر، جنديُّك المجهول من زمن","قد جاء قائدك الأعلى فسمَّاه",51,"ا",2,0],["يا مصرُ