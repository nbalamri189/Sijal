{"poems":[[53,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[53,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[77,"يا مصطفى من قبل نشأة آدم","https://www.aldiwan.net/poem35897.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[86,"ثلاثة من سراة النيل قد حبسوا","https://www.aldiwan.net/poem10357.html","البسيط"],[86,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[86,"جل الأسى فتجملي","https://www.aldiwan.net/poem10486.html","مجزوء الكامل"],[86,"إن كنتم تبذلون المال عن رهب","https://www.aldiwan.net/poem10919.html","البسيط"],[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[93,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[72,"نقب على ود الجميل","https://www.aldiwan.net/poem19553.html","مخلع البسيط"],[89,"يا مصر فيك الشعر مات أميره","https://www.aldiwan.net/poem44611.html","الكامل"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"يا مصر سماؤك جوهرة","https://www.aldiwan.net/poem7882.html","المتدارك"],[85,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[97,"يا أم من تستصرخين من الذي","https://www.aldiwan.net/poem24595.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[105,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"وضح السبيل فما لنا نتردد","https://www.aldiwan.net/poem43144.html","الكامل"],[105,"كذب الوشاة وأخطأ اللوام","https://www.aldiwan.net/poem43167.html","الكامل"],[105,"صبوا المداد وحطموا الأقلاما","https://www.aldiwan.net/poem43383.html","الكامل"],[75,"يا مصلت السيف لا تطلب به بدلا","https://www.aldiwan.net/poem69006.html","البسيط"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85603","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202641","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55107","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54616","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54612","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141978","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[106,"أبو الشعراء!","https://www.poetsgate.com/ViewPoem.aspx?id=179680",""],[106,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[106,"اللفتة الملكية","https://www.poetsgate.com/ViewPoem.aspx?id=179577",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[93,"ولَيْلَةٍ رَائِقَةِ الْبَهَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31937",""],[105,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[85,"اخترتَ يومَ الهولِ يومَ وداعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9609&r=&rc=99",""],[115,"الغارة الغارة يا مصطفى","https://www.aldiwan.net/poem40888.html","عموديه"],[115,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[135,"حتام قلبي للوصال يميل","https://www.aldiwan.net/poem48844.html","الوافر"],[142,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[143,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[143,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[143,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[143,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[185,"بمنازل الفسطاط حل فؤادي","https://www.aldiwan.net/poem14145.html","الكامل"],[211,"يا مصلح الساعات","https://www.aldiwan.net/poem46228.html","منهوك المنسرح"],[225,"يا مصر سيري على آثارهم وقفي","https://www.aldiwan.net/poem55115.html","البسيط"],[235,"يا جلال الدين يا ملكا","https://www.aldiwan.net/poem31800.html","المديد"],[259,"يا مصطفى من قبل نشأة آدم","https://www.aldiwan.net/poem35541.html","الكامل"],[261,"الحب ادواء عسيره","https://www.aldiwan.net/poem38138.html","مجزوء الكامل"],[270,"يا مصر فيك النيل والأهرام","https://www.aldiwan.net/poem34981.html","الكامل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[297,"كل نجم سيعتريه أفول","https://www.aldiwan.net/poem32954.html","الخفيف"],[310,"حي المعاهد كانت قبل تحييني","https://www.aldiwan.net/poem59516.html","البسيط"],[409,"يا مصر ما درت في وهمي ولا خلدي","https://www.aldiwan.net/poem32471.html","البسيط"],[437,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[453,"أخي سليمان هذي غربتي بلغت","https://www.aldiwan.net/poem61238.html","البسيط"],[479,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[479,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[514,"يا مصدر البيض محمره وسمر الصعد","https://www.aldiwan.net/poem20869.html","المواليا"],[562,"دع النسيب وجانب جانب الغزل","https://www.aldiwan.net/poem52825.html","البسيط"]],"verses":[["يا مُصعَبَ العَلياءِ قا","دَتكَ العِدا نِقضاً ذَلولا",0,"ل",2,0],["يا مُصعَباً بَخَسَت أَيدي المَنونِ بِهِ","فَقيدَ قَودَ ذَلولِ الظَهرِ مِطواعِ",1,"ع",1,0],["يا مُصْطَفَى منْ قبْلِ نشْأةِ آدَمٍ","والكوْنُ لمْ تُفْتَحْ لهُ أغْلاقُ",2,"ق",1,1],["يا مُصطَفى الرّحمانِ والنّورُ الذي","أخْفى الضّلالَ وأظْهرَ التّوْحيدا",3,"د",2,1],["يا مِصرُ حَتّامَ يَشكو الفَضلُ في زَمَنٍ","يُجنى عَلَيهِ وَيُمسي فيكِ أَسوانا",4,"ن",2,0],["يا مِصرُ حَسبُكِ ما بَلَغتِ مِنَ المُنى","صَدَقَ الرَجاءُ وَصَحَّتِ الأَحلامُ",5,"م",1,0],["يا مِصرُ قَد أَودى فَتا","كِ وَلا فَتىً إِلّا عَلي",6,"ي",1,0],["يا مِصرُ هَل بَعدَ هَذا اليَأسِ مُتَّسَعٌ","يَجري الرَجاءُ بِهِ في كُلِّ مُضطَرَبِ",7,"ب",1,0],["يَا مِصْرُ أَنْتِ الأَهْلُ وَالسَّكَنُ","وَحِمىً عَلَى الأَرْوَاحِ مُؤْتَمَنُ",8,"ن",1,1],["يَا مِصْرُ لَوْ تُقْدَرُ الأَقْدَارُ بِالكِرَمِ","لَكُنْتِ سَابِقَةَ الأَمْصَار وَالأُمَمِ",9,"م",1,1],["يَا مِصْرُ يَا دَارَ السَّمَاحَةِ وَالنَّدَى","دُومِي وَعِزِّي فِي المَمَالِكِ واعْظُمِي",10,"م",2,0],["يَا مُصْطَفَى مِصْرَ الرَّفِيعَ مَقامُهُ","هَيْهَاتَ يَبْدِلُ مَا بَلَغْتَ مَقَامُ",11,"م",1,0],["يَا مِصْرُ خَطْبُكِ خَطْبُ الشَّرْقِ أَجْمَعِهِ","عَلَى اخْتِلافِ بَنِيهِ وَالأَسَى عُمَمُ",12,"م",1,0],["يا مصطفى وكمامُ الكون ما فتقت","يا مجتبى وزناد النور ما قُدِحا",13,"ح",2,0],["يا مُصطفى والكونُ لم تعلَقُ بِهِ","من بعدُ أيدي الخَلْقِ والإنشاءِ",14,"ا",2,0],["يا مصر أما بشمسِ حسنٍ","أو بشمسِ علمٍ ليَ اسْتميلي",15,"ي",1,0],["يا مصر فيك الشعر مات أميره","وانقض يصرخ تاجه وسريره",16,"ر",2,1],["يا مصر حزنك سوف يبقى لاذعا","حتى يجيء إليك منك نظيره",16,"ر",2,0],["يا مصر حزنك سوف يبقى لادغا","حتى يجيئ اليك منك نظيره",17,"ه",1,0],["يا مصر يا فتاتي","يا زينة البنات",18,"ت",1,0],["يا مصر سماؤك جوهرة","وثراك بحار عسجده",19,"د",2,1],["يا مِصرُ أَنتِ كِنانَةُ اللَهِ الَّتي","لا تُستَباحُ وَلِلكِنانَةِ حامِ",20,"م",1,0],["يا مُصطَفى البُلَغاءِ أَيَّ يَراعَةٍ","فَقَدوا وَأَيَّ مُعَلِّمٍ بِيَراعِ",21,"ع",1,0],["يا مِصرُ أَشبالُ العَرينِ تَرَعرَعَت","وَمَشَت إِلَيكِ مِنَ السُجونِ أُسودا",22,"د",2,0],["يا مصر أنت الكون والدنيا معاً","وعظائم الأجيال في تاجيك",23,"ك",1,0],["يا مصرُ غُضّي من جمالِكِ واحْجُبي","سُلطانَ حُسنْكِ عن هَوى الأبناءِ",24,"ا",2,0],["يا مصرُ عهدكِ من أذىً ومرارةٍ","وهَواكِ من هَمٍّ ومن بَلبالِ",25,"ل",1,0],["يا مصرُ عامُكِ عامُ الخَيرِ فَاِرتَقِبي","فيهِ المُنى وَثِقي مِنهُ بِتَنويلِ",26,"ل",1,0],["يا مِصرُ خَطبُكِ في المَمالِكِ فادِحُ","وَمَصابُ أَهلِكِ جاوَزَ المُسطاعا",27,"ع",2,0],["يا مِصرُ أَنتِ لِكُلِّ نَفسٍ مَطلَبٌ","جَلَلٌ وَأَنتِ لِكُلِّ قَلبٍ مَطمَعُ",28,"ع",1,0],["يا مِصرُ إِن رَجَعَ المَشوقُ فَقَد وَفى","حُسنُ البَلاءِ بِحُسنِكِ الفَتّانِ",29,"ن",1,0],["يا مِصرُ لا تَلِدي رِجالاً بَعدَهُم","وَأَرى الرِجالَ لِغَيرِ ذَلِكَ تولَدُ",30,"د",1,0],["يا مِصرُ هُبّي في المَمالِكِ وَاِعمَلي","ذَهَبُ الكَرى وَتَوَلَّتِ الأَحلامُ",31,"م",1,0],["يا مِصرُ ماذا تَطلُبينَ أَما كَفى","أَن تُصبِحي لِلعادِياتِ طَعاما",32,"م",2,0],["يا مصلتَ السيف لا تطلب به بدلاً","لا تبقينَّ فما أبقى وما عدلا",33,"ل",2,1],["يا مِصرُ حَسبُكِ ما رَضيتِ مِنَ الأَذى","وَبَرِئتِ مِن ماضيكِ إِن لَم تَنقَمِ",34,"م",1,0],["يا مصر أَنت اليَوم وح","دَكِ ذلك البلد المفدّى",35,"د",2,0],["يا مصر إِنَّك أَنت اليوم مملكة","في ذمة العلم قبل الصارم الذرب",36,"ب",1,0],["يا مصر إنك أنت اليوم آسية","عَلى الوليّ وَما بغداد تختلف",37,"ف",1,0],["يا مصرُ ذلكَ يوم الملتقى وعلى","صَباحه قَدِم الرُّسْلُ الأجلَّاءُ",38,"ا",2,0],["يا مصر أشبال العرين ترعرعت","ومشت إليكي من القيود أسودا",39,"د",2,0],["يَا مِصْرُ دَامَ عُلُوٌّ جَدِّكْ","عِيْدُ الجَلاَءِ أَتى كَوُدِّكْ",40,"ك",1,1],["يَا مِصْرُ كَمْ فِي سِيرَةِ الجِيلِ الَّذِي","يَمْضِي هُدىً لِلوَاحِقِ الأَجْيالِ",41,"ل",1,0],["يَامِصْرُ قَامَ العُذْرُ إِنْ","يُقْلِقْ مَضَاجِعَكِ الوَجِيبُ",42,"ب",1,0],["يَا مُصْطَفَى زَادَكَ اللهُ الكَرِيمُ وَمَا","غَيْرُ الحَلَى مِنْ مَزِيدٍ فَوْقَ مَا وَهَبَا",43,"ب",2,0],["يَا مُصْطَفَى زَادَكَ اللهُ الكَرِيمُ وَمَا","يَزِيدُ إِلاَّ حُلَىً تَجْلُو الَّذِي وَهَبَا",44,"ب",2,1],["يا مِصْرُ بَاهِي كُلَّ مِصْرٍ بِالأولَى","أَنْجَبْتِ مِنْ أَبْنَائِكِ الْعُظَمَاءِ",45,"ا",2,0],["يا مصرُ ما نظمَ الجهاد قصيدة","إلا استهلّ بذكركِ الفواح",46,"ح",1,1],["يا مصر ما انفتحت عين على حسن","إلا وأطلعت ألفاً من نظائره",47,"ر",2,0],["يا مِصْرُ نَحْنُ الْفِدَاءُ نَحْنُ","ما مَسَّنا في الْخُطُوبِ وَهْنُ",48,"ن",1,0],["يا مِصْرُ فارُوقُكِ الْمُرَجَّى","إِلَيْهِ تَرْنُو الْمُنَى وتُزْجَى",48,"ج",2,0],["يا مصرُ، شُقِّي ثياب العرسُ، وانتحبي!!","مَن في الحمى بعد إبراهيم للأدب؟",49,"ب",1,1],["يا مصرُ، قد عزَّ العزاءْ","نَفنى، وأنتِ لك البقاءُ!",50,"ا",2,1],["يا مصر، جنديُّك المجهول من زمن","قد جاء قائدك الأعلى فسمَّاه",51,"ا",2,0],["يا مصرُ، قد طار الإسارُ، فحطِّمي","بيمينك الأغلالَ، أو فتحطَّمي",52,"م",2,0],["يا مصرُ، وجُهك -أين كنَّا- قبلةٌ","فيها المسيحيُّ التقى بالمسلم",52,"م",1,0],["يا مصرُ، جيشُكِ جال في ساح الوغى","لا واهنًا عزمًا، ولا مخذولا",53,"ل",2,0],["يا مصطفى الرحمن والنور الذي","أخفى الضلال وأظهر التوحيدا",54,"د",2,0],["يَا مِصْرُ دَارَ السَّعْدِ وَالهَنَاءِ","وَمَهْبَطَ الأَسْرَارِ وَالإِيحَاءِ",55,"ا",2,0],["يا مصر عهدك من أدى ومرارة","وهواك من هم ومن بلبال",56,"ل",1,0],["يا مصتطفى البلغاءِ ، أيّ يراعة ٍ","فقدوا ؟ وأيّ معلمٍ بيراع ؟",57,"ع",1,0],["يا مصطفى الرحمن من خلقه","وخير من لله عهدا وفا",58,"ف",2,0],["يا مصطفى الرحمن يا أحمد","لك العلا والفضل والسودد",59,"د",1,1],["يا مصطفى البارىء من خلقه","يا روح جسم الكون يا احمد"