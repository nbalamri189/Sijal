{"poems":[[79,"جفا ابن أبي رمانة وجه مقدمي","https://www.aldiwan.net/poem36042.html","الطويل"],[56,"وإن له لطباخا وخبزا","https://www.aldiwan.net/poem27417.html","الوافر"],[90,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[90,"أحب صراحتى قولا وفعلا","https://www.aldiwan.net/poem45064.html","الوافر"],[49,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[49,"عطفت على عمر ابن تغلب بعدما","https://www.aldiwan.net/poem25319.html","الطويل"],[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[72,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[47,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[30,"ستعلم يا عمرو بن عفرا من الذي","https://www.aldiwan.net/poem1263.html",""],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[50,"خليلي أقعد للصبوح ولا تقل","https://www.aldiwan.net/poem66601.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85420","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42714","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[1,"","https://poetry.dctabudhabi.ae/diwan/poem/199405","الطويل"],[79,"لعل خيالا منك يطرق مضجعي","https://www.poetsgate.com/ViewPoem.aspx?id=34177",""],[47,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""],[92,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[119,"جهلت أصول الدين ثم ارتقبت من","https://www.aldiwan.net/poem41694.html","الطويل"],[151,"فلم يكن المولى لأكل عصيدة","https://www.aldiwan.net/poem47626.html","الطويل"],[211,"عفا مجدل من أهله فمتالع","https://www.aldiwan.net/poem27933.html","الطويل"],[234,"غدا عامر الأوطان في مقلتي قفرا","https://www.aldiwan.net/poem51110.html","الطويل"],[266,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[266,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[275,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[285,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[334,"ليبك أبا الجدعاء ضيف معيلُ","https://www.aldiwan.net/poem412.html",""],[376,"توق إذا ما حرمة العدل جلت","https://www.aldiwan.net/poem57518.html","الطويل"],[385,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[409,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[409,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[454,"جهاد ولكن ليس بالسيف والقن","https://www.aldiwan.net/poem990.html",""],[505,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[520,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[521,"وقد كانت الايام اذ نحن باللوى","https://www.aldiwan.net/poem48592.html","الطويل"],[592,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83285","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87107","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70906","الطويل"],[1034,"","https://poetry.dctabudhabi.ae/diwan/poem/144667","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136191","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64520","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11155","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104732","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20432","الطويل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140236",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106851","المتقارب"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100110","الطويل"],[2480,"","https://poetry.dctabudhabi.ae/diwan/poem/138769",""],[2836,"","https://poetry.dctabudhabi.ae/diwan/poem/203436","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122451","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109820","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200172","الطويل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132965","الطويل"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144740","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91267","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35598","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102760","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45062","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138826",""],[4675,"دفاع عن علامة الصومال عبد الكريم حسن حوش","https://www.poetsgate.com/ViewPoem.aspx?id=192203",""],[4679,"رأى الدهر ما قد سامنا البين والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=142725",""],[4915,"تشظِّيات ما قبلَ الرَّحيل","https://www.poetsgate.com/ViewPoem.aspx?id=211407",""],[5302,"خليلي زورا","https://www.poetsgate.com/ViewPoem.aspx?id=200132",""],[592,"وليس بكفء أن يجاب وإنه","https://www.poetsgate.com/ViewPoem.aspx?id=128794",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"وما خرَتِ الأبدانَ فينا عزائمُ","https://www.poetsgate.com/ViewPoem.aspx?id=204771",""],[5628,"شحوب","https://www.poetsgate.com/ViewPoem.aspx?id=191437",""],[520,"هل القلب الا بضعة يتقلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577441",""],[6184,"أأضحكُ عِنْدَما يَبْكي الجليلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78613&r=&rc=5",""],[6290,"عَفَا اللهُ عَنْ أُولِي اللّحَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85655&r=&rc=44",""]],"verses":[["وَلَكِنْ دَرَانِي مَغْربيّاً مُحَقِّقاً","وَأَنَّ طَعَامِي لَمْ يَكُنْ حبَّ رُمَّانِ",0,"ن",1,0],["وَلَكِن دونَهُ حَبسٌ وَضَربٌ","وَأَبوابٌ تُطابَقُ دونَ بابِ",1,"ب",1,0],["ولكن دموع العين أثناء ضحكها","هواطل مهما يسجم الضحك تسجم",2,"م",1,0],["ولكن دالت الأيام حتى","تهلون هؤلاء بهؤلاء",3,"ا",2,0],["وَلَكِنَّ دَهراً دافَعَتني خُطوبُهُ","كَما دَفَعَ الدَينَ الغَريمُ المُماطِلُ",4,"ل",1,0],["وَلَكِن دُنُوُّ لايُوَلَّدُ هِجرَةً","وَهَجرٌ رَفيقٌ لايُصاحِبُهُ زُهدُ",5,"د",1,0],["ولكن دع زحامي في طريقي","فإنك واجد سعة وريفا",6,"ف",2,0],["وَلَكِن دَعاني لِلعَلاءِ بنِ جَلدَكٍ","تَشَوُّقُ قَلبٍ قادَني وَتَشَوُّفُ",7,"ف",1,0],["وَلَكِنَّ دَهراً مَلَّكَ الوَغدَ هابِطاً","مَشارِقَها مَوصولَةً بِالمَغارِبِ",8,"ب",1,0],["وَلَكِن دِيافِيٌّ أَبوهُ وَأُمُّهُ","بِحَورانَ يَعصِرنَ السَليطَ أَقارِبُه",9,"ب",2,0],["وَلَكِن دَعَت لِلحَينِ عَينٌ مَريضَةٌ","فَطاوَعتَها عَمداً كَأَنَّكَ حالِمُ",10,"م",1,0],["ولكن ديار اللهوِ يا ربّ فاسقِها","ودرّ على خضرائِها كل جدوَل",11,"ل",1,0],["وَلكن دون الخفر لَو أَستَطيعه","جموعاً ومن خلف الجموع جموع",12,"ع",1,0],["وَلَكِنْ دَعَتْهُمْ نَبْأَةٌ فَتَفَرَّقُوا","كَمَا انْقَضَّ في سِرْبٍ مِنَ الطَّيْرِ بَاشِقُ",13,"ق",1,0],["وَلَكِنْ دَعَاكَ إِلَيْهِ النُّبُو","غُ وَأَيَّدَهُ مَجْدُك المُلْزِمُ",14,"م",1,0],["ولكن دعا من قيس عيلان عصبةً","يسوفون في أعلى الحجاز البرائرا",15,"ر",2,0],["ولكن دمعي لا يطيع لمن دعا","وكم بين عاص في الدموع وطيع",16,"ع",1,0],["ولكن دهراً ملك الوغد هابطاً","ومشارقها موصولة بالمغارب",17,"ب",1,0],["ولكنَّ دأبَ الشاعِرينَ تحرُّشٌ","ومن عادةٍ الكُتابِ خلقُ المتاعبّّ",18,"ب",1,0],["ولكن دهاك الوهم والزيغ والهوى","أعوذ بسر اللَه من ضربة المكر",19,"ر",1,0],["ولكن دعاكم للحلاوة والشوى","وكل لذيذ طاب من أنفس الأكل",20,"ل",1,0],["وَلَكِنَّ دينَ اللَهِ دينُ مَحَمَّدٍ","رَضينا بِهِ فيهِ الهُدى وَالشَرائِعُ",21,"ع",1,0],["ولكنَّ دهراً عاقني واستهاضني","فخلَّفَني رَغْماً وأوجعني ضُرّا",22,"ر",2,0],["ولكن دهري عن مرامي ممانع","عسوف ودأب الدهر ببدي التعسفا",23,"ف",2,0],["ولكن دعاني منك مولى لنظمه","ومن بدعه المولى بحبه لما دعا",24,"ع",2,0],["ولكن دَعوتي للخَصمِ عيبٌ","لأني لستُ أحسِبهُ قرينا",25,"ن",2,0],["وَلَكِن دعوت اللَه يكشف كُربَتي","فَما كربة الاومنه لها كشف",26,"ف",1,0],["وَلَكِنَّ دَهْراً أَثَخَنَتْنِي جِراحُهُ","إذا حَزَّ فِي جِلْدِي أَلَحَّ عَلَى عَظْمِي",27,"م",2,0],["ولكِنْ دَعَا أَشْبَاهَ نَبْتٍ كأَنَّهُمْ","قُرُودٌ على خَيْلٍ تَخُبُّ وتَرْكُلُ",28,"ل",1,0],["ولكنَّ دُنياهم سعت فسعوا لها","وتلك التي فلت ضميراً عن التي",29,"ت",2,0],["وَلَكن دَعت قَلبي شَمائِلُ سَيد","وَدود فَأَحيَتهُ فَلَبى وَما ضَنا",30,"ن",2,0],["ولكن دعوا آل الخليفة كلهم","وأعوانه من حاكم ومؤازر",31,"ر",1,0],["ولكن ديَّاراً للعلى شادها الأُلى","عَفَتْ فبكاها جازع وجليد",32,"د",1,0],["ولكن دين القوم ألف شملهم","كما وحد الاسلام من قبل شملنا",33,"ن",2,0],["ولكنْ دَواعي الحُبِّ تَدْفَعُنا إلى","بَيانِ دَعاوينا ولم نكتَسِبْ جُرْمَا",34,"م",2,0],["ولكن دروا أن الذي جاء مادحاً","بغير الذي فيهم يسب ويثلب",35,"ب",1,0],["وَلكِن دَهراً بَعد دَهر تَقَلَّبَت","بِنا مِن نَواحيهِ ظُهور وابطن",36,"ن",1,0],["ولكن دهاهم من دهائك فتكة","بفتيان صدق كالأسود الضراغم",37,"م",1,0],["وَلَكِنداعي المَوتِ لا يَقبَلُ الرُشى","وَأَنفَسَ مِنهُ لَيسَ يَلقى وَأَرفَعا",38,"ع",2,0],["وَلَكن دَعتني لِلقَريض مسرّةٌ","حَباني بِها يَوم القبول نَسيم",39,"م",1,0],["ولكن دعيني بعد ما شاب عارضي","إذا لم أكنْ خِلاًّ فلم أك مُبغضا",40,"ض",2,0],["ولكن دليلٌ سعى سعيةً","فأخزى الإله بها العالمينا",41,"ن",2,0],["ولكن دأب الاكرمين سماحة","وادخالهم للعيب في حيز الستر",42,"ر",1,0],["ولكن دعائي يا محيط وسيطة","أمرت بها المضطر عند البلية",43,"ه",1,0],["وَلَكِن دُونَ ذَلِكَ مَهمَهٌ لَو","جَرَتهُ الرِّيحُ لَم تَرجُ الإِيَابا",44,"ب",2,0],["وَلَكِن دَعوني يا بَنيَّ تَعُسُّني","ثَعالِبُ في أَوطانِها وَنُسورُ",45,"ر",1,0],["وَلكِنَّ دَمعَ العَينِ عَنكَ مُتَرجِمٌ","بأَنَّكَ فِى حُبِّ الرَّسُولِ لَبَارِعُ",46,"ع",1,0],["وَلَكِن دَعَتني هِمَّتي حينَ أَبلَغَت","إِلَيكَ وَخالٌ مِن نَوالِكَ هاضِبُ",47,"ب",1,0],["ولكن دهري أصبح الصمت عنده","بكل فصيح فيه أولى وأجدرا",48,"ر",2,0],["ولكن دموعُك لاشت قواي","فها أنا ذا أتمنّى الرجوع",49,"ع",1,0],["ولكن دعاني للرحيل أصاغر","جفائي لها بعض الذنوب الكبائر",50,"ر",1,0],["ولكن دعاهم من براهم فأسرعوا","ملبين للداعي ويانعم معبرا",51,"ر",2,0],["ولكن دعا قوماً يظنون أنّهم","رموا غرضاً في دينهم فأصابوا",52,"ب",3,0],["ولكنْ دَأبُهُ في القوْلِ مَزّحٌ","مَعِي فحَملْتُ ذاك على المزَاحِ",53,"ح",1,0],["ولكن دارت الحسرات فيهم","كما دارت بشاربها العقار",54,"ر",1,0],["ولكن دهري قصّ جنحي وأرجلي","فما حالُ طيرٍ لا يطير ولا يمشي",55,"ش",2,0],["ولكنَّ دَمعي إن كَتَبتُ مُشَوِّشٌ","كتابي وما نفعُ الكتابِ الُمشوَّشِ",56,"ش",1,0],["وَلكن دَعا للحرب دَاعٍ وعَاقَنَا","مَعَائِبُ كَانَتْ بَيْنَنَا وضَغَائِنُ",57,"ن",1,0],["وَلَكن دَعاني حُسنُ ظَني بصفحكم","وَعلّ لديكم أن تُقال عثار",58,"ر",1,0],["وَلَكِن دَعاهُ الحِلمُ وَالفَضل وَالحجى","إِلى أَن يَكونَ الأَحلم الأَكرَمَ الأَتقى",59,"ق",2,0],["وَلَكِن دَعِ البَحثَ في صَدَدِ","نُلامُ عَلَيهِ وَلا نَجتَدي",60,"ي",1,0],["ولكنّ دمعي صار أكثره دما","فإني يرجى أن يروى به قحط",61,"ط",1,0],["وَلَكِن دَرَت أَنَّ الحَياةَ مُعارَةٌ","وَهَل دامَ في جيدٍ نَظيمٌ مِنَ العِقدِ",62,"د",1,0],["ولكن دعا الداعي لآل محمدٍ","فطوعاً أجابته الدموع الزوارف",63,"ف",1,0],["ولكن دعاني الشوقُ والحبُّ والهوى","فطابَ ليَ المغنى ولَذّ ليَ الشعر",64,"ر",1,0],["ولكن دعاني اليوم شعري ودلّني","بأن دفاع الشيخ حتم مؤصل",65,"ل",1,0],["ولكن دهته بعد فرط آعتنائه","جيوش سقام عنه قد ردها الصبر",66,"ر",1,0],["ولكنَّ داءً يعتريني لغُربةٍ","أَخفُّ بلاءً مِن بلائي بإخوتي",67,"ت",2,0],["ولكن دوام الحال أصعب مبتغى","إذا ما الليالي أوقفت في السرى ركبا",68,"ب",2,0],["ولكن دعا داعً إلى رد إفكه","وإبطال تمويه به ظل يكدح",69,"ح",1,0],["ولكن دين المرسلين لديكمو","هو الشرك بالمعبود والجعل للند",70,"د",1,0],["ولكنَ دأبي أن ارومَ سعادةً","بمغفرةٍ والعتقُ منك مكارمُ",71,"م",1,0],["ولكنْ دعي لي حياتي التي","ألفتُ فإنّي مللت ُ الفُتُورْ",72,"ر",1,0],["ولكن دروا أن الذي جاء مادحاً","بغير الذي فيهم يسب ويثاب",73,"ب",1,0],["ولكنْ دَعْكَ من جفرا ودعها","يغازلها سواك ويستميلُ",74,"ل",1,0],["وَ لَكِنَّ دِينَ اللهِ قَوْلٌ مُطَابِقٌ","لِفِعْلٍ، وَ عُقْبَى الْمَرْءِ فِي التَّرْكِ وَ الْمَسْكِ",75,"ك",1,0]]}