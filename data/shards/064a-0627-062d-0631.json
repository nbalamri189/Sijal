{"poems":[[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[74,"قالوا ذقون الملاح باردة","https://www.aldiwan.net/poem18632.html","المنسرح"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[46,"أي رأي وأي عقل صحيح","https://www.aldiwan.net/poem30056.html","الخفيف"],[92,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43905","الكامل"],[92,"تنويمة الجياع","https://www.poetsgate.com/ViewPoem.aspx?id=647",""],[132,"دمعي جرى يوم بان الحي من إضم","https://www.aldiwan.net/poem50496.html","البسيط"],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[382,"السيف والحيف في حرب وفي حربِ","https://www.aldiwan.net/poem66948.html","البسيط"],[406,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[466,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[500,"يا حريصا على الغنى","https://www.aldiwan.net/poem9822.html","مجزوء الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48749","الكامل"],[842,"","https://poetry.dctabudhabi.ae/diwan/poem/138066","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37984","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120027","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202087","المنسرح"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25355","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109058","الرجز"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49035","الكامل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95287","المنسرح"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65957","الرجز"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9630","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117285","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113836","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4702,"عزام بن عبدالعزيز الشاطري","https://www.poetsgate.com/ViewPoem.aspx?id=155109",""],[4702,"الصقر ينفض غباره","https://www.poetsgate.com/ViewPoem.aspx?id=155206",""],[4728,"هذا انت حيّ ومعْتبرْك مْتوفّي","https://www.poetsgate.com/ViewPoem.aspx?id=176896",""],[4789,"الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=215288",""],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[4888,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=207762",""],[4939,"يا حريصاً قطع الأيامَ في","https://www.poetsgate.com/ViewPoem.aspx?id=135257",""],[5002,"سهم المنايا...","https://www.poetsgate.com/ViewPoem.aspx?id=205731",""],[5002,"الصباح الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=214530",""],[5031,"من تفاصيل عشقٍ يوسفي","https://www.poetsgate.com/ViewPoem.aspx?id=148228",""],[5055,"قصايد","https://www.poetsgate.com/ViewPoem.aspx?id=101658",""],[5055,"غارة الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=103656",""],[5081,"حَاءٌ وَلَامٌ وَالنِّهَايَةُ بَاؤهَا","https://www.poetsgate.com/ViewPoem.aspx?id=190536",""],[5121,"آه الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36284",""],[5121,"نَارُ الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=215598",""],[5277,"الجريرية","https://www.poetsgate.com/ViewPoem.aspx?id=191048",""],[5277,"حسيبةُ طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=198721",""],[5277,"نونٌ وذكراها","https://www.poetsgate.com/ViewPoem.aspx?id=201749",""],[5321,"شَرَّك غَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=152742",""],[5411,"مِصْر العُروبَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=185426",""],[5431,"حب الأنا.","https://www.poetsgate.com/ViewPoem.aspx?id=183042",""],[5480,"تغاريد الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=1145",""],[5480,"ثوب الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=10980",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5595,"أرقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=144614",""],[5830,"صُبِّي كُؤُوسَ الهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=200762",""],[5830,"قِرَاءَةٌ بِكَفِّ زَرْقَاء اليَمَامَة","https://www.poetsgate.com/ViewPoem.aspx?id=201191",""],[5851,"ظنون","https://www.poetsgate.com/ViewPoem.aspx?id=175301",""],[5943,"كلَّما وجَّهتُ وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=11287",""],[5969,"يا صاحِبَ الحُسْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=203979",""],[5974,"في وجنتيها الحسن حط رحاله","https://www.poetsgate.com/ViewPoem.aspx?id=214828",""],[5976,"يا حرف","https://www.poetsgate.com/ViewPoem.aspx?id=30520",""],[5976,"درب الأحرار .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30812",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""]],"verses":[["يا حَرَّ قَلبي مَن سُقي","رُضابَهُنَّ الأَبرَدا",0,"د",2,0],["يا حرّ قلبي إذ لا يقبلها","فمي ويا بردها على كبدي",1,"ي",1,0],["يا حرّ صدري على ثلاثة أم","واهٍ هُريقت في الترب والمدَرِ",2,"ر",1,0],["يا حرَّ صدري على الخطوب وما","تطويه بالغيب من بوائقها",3,"ق",3,0],["يا حرَّها من عبرةٍ سالت","مِن فاتكِ العينين مكحولِ",4,"ل",1,0],["يا حَروناً في البُخلِ قَد وَأَبي بُخ","لِكَ عوقِبتَ بِالأَصَمِّ الجَموحِ",5,"ح",1,0],["يا حُرَّةً لم تَدْرِ ما","معنى ﭐضطغانٍ وانتقامِ",6,"م",1,0],["يَا حُرَّ أَمْسَيْتُ شَيْخاً قَدْ وَهَى بَصَرِي","وَالْتَاثَ مَا دُونَ يَوْمِ الوَعْدِ مِنْ عُمُرِي",7,"ر",2,1],["يَا حُرَّ مَنْ يَعْتَذِرْ مِنْ أَنْ يُلِمَّ بِهِ","رَيْبُ الزَّمَانِ فَإِني غَيْرُ مُعْتَذِرِ",7,"ر",1,0],["يَا حُرَّ أَمْسى سَوادُ الرَّأْسِ خَالَطَهُ","شَيْبُ القَذالِ اخْتِلاَطَ الصَفْوِ بِالْكَدَرِ",7,"ر",1,0],["يَا حُرَّ أَمْسَتْ تَلِيَّاتُ الصِّبَا ذَهَبَتْ","فَلْسْتُ مِنْهَا عَلَى عَيْنٍ ولاَ أَثَرِ",7,"ر",1,0],["يا حرُّ كيف قبِلتَ شِرعتَه","وقنِعتَ منه بزادِ مأسورِ",8,"ر",1,0],["يا حرفَةَ الشّعراءِ إنَّكِ منهمُ","حيث اِبتغوا رزقاً لبِالمِرْصادِ",9,"د",1,1],["يا حُرَّةً لم تَدْرِ ما","معنى اضطغانٍ وانتقامِ!",10,"م",1,0],["يا حرقتي تعبتُ بحسْرتها","سرىً بدا لا أرى لي لذة الوسَنِ",11,"ن",1,0],["يا حر قولنج البطو","ن وبرد أعصاب الظهور",12,"ر",1,0],["يا حرم المعتفين طاف به","رجاؤنا وارداً لزمزمه",13,"م",2,0],["يا حَربةَ القلب لا تنفكُّ همَّتُها","يوم الكريهة في المسلوب لا السلب",14,"ب",1,0],["يا حروفَ الشعر لا تَصطحبي","لغةَ الشعر الى جُرحي الدَّفين",15,"ن",1,0],["يا حرَّةَ الأخوين إنَّ صَبابتي","عظمت وما أن في وصالك طائل",16,"ل",1,0],["يا حريصاً على الغنى","قاعداً بالمراصدِ",17,"د",1,1],["يا حرّ قلبي لآل اللّه قد حملت","بين الأجانب فوق الأنيق الهزلِ",18,"ل",1,0],["يا حر مصر ويا منجّيها غداً","بقوى الأباة وعزة الأحرار",19,"ر",1,0],["يا حر قلبي ويا لهفي ويا جزعي","عليك حران ملقى فوق حرات",20,"ت",1,0],["يا حَرِيّاً بِكَمالٍ وَحَقيق","وَأَخا اللّفظِ البديعِ الأعذبِ",21,"ب",1,0],["يا حرَّ قلبيَ في تشرين حين أتى","وَإِنّ قَلبي لِنارِ الحبّ كانونُ",22,"ن",1,0],["يا حريا بلبس كل ثناء","وعريا من كل ذام وعارِ",23,"ر",1,0],["يا حريقا بنار عي التصابي","يا غريقا في بحره المسجور",24,"ر",1,0],["يا حر قلبي على قتل الحسين ويا","لهفي ويا طول تعدادي ويا حزني",25,"ن",2,0],["يا حَرماً آمنا لساكنه","وخائبٌ مَنْ دُخُوَله حُرِما",26,"م",2,0],["يا حَرْبُ يا ابْنَ حَكَمٍ لِلمُعْتَمِي","أَنْت امْرُؤٌ تُعْرَفُ بِالتَكَرُّمِ",27,"م",1,1],["يا حرَّ تموزَ وُقيت ضَرَّه","علمتنا كيف تهونُ الحرَّه",28,"ر",2,1],["يا حَرَجات الظِّلال أَين أَحبّا","ؤك والعاقِرونَ والنِّيَبُ",29,"ب",1,0],["يا حرّةً في الشوفِ قد نبغتْ","في بيتِ مجدٍ أسُّهُ الكرمُ",30,"م",1,1],["يا حراء حن من شوق لها","مهبط الوحي وبطحاء الحجون",31,"ن",1,0],["يَا حَرَماً للجَمالِ يَا عُمراً","وَبيتُ حُسنِ الوِدَادِ عُمَر",32,"ر",1,1],["يا حرمة الاسلام يا دين الهدى","يا حرمة الذكر المنير الزاهر",33,"ر",1,0],["يا حُرَّ أَمسَت لُباناتُ الصِبا ذَهَبَت","فَلَستُ مِنها عَلى عَينٍ وَلا أَثَرِ",34,"ر",1,0],["يا حرمة هتكت لعزة أحمد","فيها وعزة ربه حرماتها",35,"ت",3,0],["يا حرَّ لبي لا تذوب مهجتي","رُحماً ولا تدع الحشا أن يعدما",36,"م",2,0],["يا حرّ ما بين الجوانح من لظى","لهب عليه قد طويتُ ضلوعا",37,"ع",2,0],["يا حرب قد أشبعت أطيار الفلا","والوحش غص بهيضة الأشلاء",38,"ا",2,0],["يا حَرَّها مِن جَمرَةٍ مَشبوبَةٍ","تُلقى لَها الأَيدي عَلى الأَكبادِ",39,"د",1,0],["يا حرف وينك ما لقيتك فالحروف","اليا كتبتك شفت غيرك ينقري",40,"ر",2,1],["ياحرفي اللي فيه روس الكباريت","لا ناش بارود القهر شب ناره",41,"ر",2,1],["يا حرّ جوفي منك يا حرّ جوفي","عدو في ثوب الصديق مْتخفّي",42,"ف",2,0],["يا حرفُ يفترشُ الوريقةَ لا تنمْ","كلُّ المجراتِ الرحيبةِ ساحُك",43,"ك",1,0],["يا حر قلبي من فيها على بردٍ","بفاتر الجفن يحمي بعد تبريدِ",44,"د",1,0],["يا حُرقةَ الأرضَ التي بِتْنا على","ثَوَرانها أينَ الرياضُ الغابرةْ؟",45,"ر",2,0],["يا حريصاً قطع الأيامَ في","بوسِ عيشٍ وعناءٍ وتَعَبْ",46,"ب",1,1],["ياحرَّ جُرْجي وأنَّاتي لها أمَدُ","لم تلتئمْ لابسلوٍ أونالني الجلدُ",47,"د",1,0],["يا حرقةَ الإدْمانِ تُرْثى غصَّة ً","والدَّمعُ يَشْرَبُه المُنَى باكٍ بِه",48,"ب",2,0],["يَا حَرْفِيَ المصلُوبَ.. فَوْقَ مَباهجِ ال","نَّارنْجِ.. يَا شَفَةَ الصَّبا المُتَمَوْسِقَةْ",49,"ق",2,0],["يا حروف القصايد حرفنا وش يكون","لو بيرجع حنيني وين باقي السنين",50,"ن",1,1],["يا حروف القصايد ساهرات العيون","ساجنات المشاعر مطْلقات السجين",50,"ن",1,0],["يا حروف القصايد واصفات الفتون","شاب حرفي فإيدي يْسارها واليمين",50,"ن",1,0],["يا حروف القصايد كل حبي شجون","شاقني منك معنى في عيوني ثمين",50,"ن",1,0],["يا حروف القصايد ما بعثت الجنون","غير ود وسهرني وشفت حرفي معين",50,"ن",1,0],["يا حروف القصايد كل ما جبت لون","فاح عطر القصايد يمّم المبدعين",50,"ن",1,0],["يا حرف أنا ونيت من غارة الذيب","واقف على الأطلال ورعى حلاله",51,"ل",2,0],["يَا حَرْفُ فَاسْكُبْ مِنْ فُؤَادِكَ أَرْضَهَا","وَارْوِ الْقَصِيدَ بِدَمْعِهَا وَدِمَائِهَا",52,"ه",2,0],["يَا حَرّ هَذَا الْجَوَى مَا بَالهُ يَبْكِي","نَزْفٌ جَرَى فِي بِيُوتِ الْشِّعْرِ يَنْعَاهَا",53,"ا",3,0],["يَا حُرْقَةَ الآهِ فِي حَرْفٍ بِقِرْطَاسِ","إِذْ نَاحَ شِعْراً بآهِ الْقَلْبِ فِي النَّاسِ",54,"س",1,1],["يا حرّةً أعطتني كلّ صفاتها","من خيرِ ما جادتْ به الأحرارُ",55,"ر",1,0],["يا حرّةً نادت بمفترقِ اللِوى","من ذا يجودِ لدينهِ بالأنفسِ",56,"س",1,0],["يا حرّةً..لمْ تزلَ بينَ النساءِ مهاً","أعطى ملامحَها العذراءَ معناها",57,"ا",3,0],["ياحرّها اللّي عزوته طير حوران","لاهدّته بالجول يكثر شببها",58,"ب",3,0],["يا حُرَّة وَإلَيْكِ صغْتُ مَشاعِري","فَتَمايَلَتْ في بَحْرِها الأشْعارُ",59,"ر",1,0],["ياحرْقَ قلبي والذكاء مكبلٌ",".وتهافت الأقلام دون كفاحِ",60,"ح",1,1],["يا حرفي قوم وأسعفني وخليني على المشراف","أقول الشعر وأتهجّى أسّج القاف بأشعاري",61,"ر",2,0],["يا حروف الشعر سيري وأسعفيني يا حروف","إنظمي م الشعر شله وعاضدي نبع المداد",62,"د",1,1],["ياحرف علمْ امخايل البرق لاحه","صندوق يخفي بالبحر كنز مفتاح",63,"ح",1,0],["يا حُرقة َ التيهِ في أفنانِها علُقتْ","أسرابُ عشق ٍ فيها القلبُ يستترُ",64,"ر",1,1],["يَاحَرْفُ ثُرْ فَالهَوَى المَكْلُومُ يَصْفَعُنَا","وَ اسْتَصْرِخِ الآهَ رَوِّ الآهَ ألْحَانَا",65,"ن",2,0],["يَا حَرْفُ يَا وَجَعَ الحِكَايَةِ دُلَّنِي","فِي أُمَّتِي حَلاً لِكَيْ نَسْتَبْصِرَا",66,"ر",2,0],["ياحرقة العيد الأخير تضرمي","وتضرمي إن السكوت جنون",67,"ن",1,0],["ياحروف الحبِّ ثوري","واقرأي القرآنَ جهرا",68,"ر",2,0],["يا حُرقة الشَّوقِ ما ضَر الفؤادَ سِوى","فَقدِ الوِصالِ إذا ما الجَمرُ قد بَرَدا",69,"د",2,0],["يا حرف رفقا بالفؤاد فإنه","صادٍ تولّاه الغرام فأنشدا",70,"د",2,0],["يا حرف لي مدّه وانا انصاك وتخون !!","وش فيك ؟! يا مال البلا والطواعين .. !!",71,"ن",1,1],["يا حرْف ما بدّلْك بكنوز (قارون)","دامك تعوّضني عن الصاع صاعين .. !!",71,"ن",1,0],["يا حرّ .. راسك للطمانه توطّيه ؟!","وانت الذي لك بالشواهيق مقدار",72,"ر",1,0],["يا حرّةً مأسورةً في هَمِّنا","أفْنَيْتِ عُمْرَكِ والسنينَ تصَبُّرا",73,"ر",2,0]]}