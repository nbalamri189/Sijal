{"poems":[[37,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[53,"بنات ثوابة ما في الأنام","https://www.aldiwan.net/poem65927.html","المتقارب"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[26,"لعمرك والمنايا غالبات","https://www.aldiwan.net/poem24090.html","الوافر"],[30,"ولكن خربانا تنوس لحاهم","https://www.aldiwan.net/poem5249.html","الطويل"],[104,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29335","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[53,"يا حسنَ الوجه والشمائلِ وال","https://www.poetsgate.com/ViewPoem.aspx?id=30289",""],[60,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[132,"كتابكم وافى إلينا فسرنا","https://www.aldiwan.net/poem50528.html","الطويل"],[265,"جزى الله أفناء العشيرة كلها","https://www.aldiwan.net/poem1113.html",""],[308,"وقائلة ما بال دمعك أصفرا","https://www.aldiwan.net/poem58136.html","الطويل"],[315,"أبى الطيف أن يعتاد إلا توهما","https://www.aldiwan.net/poem59514.html","الطويل"],[376,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[409,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[415,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[415,"بثينة ما أعرضت عنك ملالة","https://www.aldiwan.net/poem32558.html","الطويل"],[440,"نزعت عن الهوى وعن المدامه","https://www.aldiwan.net/poem26356.html","الوافر"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[543,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38156","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129511","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61051","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28338","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45404","المتقارب"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83244","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94003","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100724","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126106","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48451","الوافر"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32397","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29305","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141635","الوافر"],[4858,"حبائلُ الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=35576",""],[5584,"تقي","https://www.poetsgate.com/ViewPoem.aspx?id=174842",""],[5817,"أ لو نمتي","https://www.poetsgate.com/ViewPoem.aspx?id=190710",""],[6056,"أطرش الزفة","https://www.poetsgate.com/ViewPoem.aspx?id=130513",""]],"verses":[["وَلَكِن خَليلي مَن يَدومُ وِصالُهُ","وَيَحفَظُ سِرّي عِندَ كُلِّ دَخيلِ",0,"ل",1,0],["ولكن خُلقتم بلطفِ اللطيفِ","لأن تَحْمِلوا لا لأن تُحمَلوا",1,"ل",3,0],["ولكن خانني شركاءُ سوءٍ","وغلّوا لا صفا لهُمُ الغُلولُ",2,"ل",1,0],["وَلكِن خَبِّروا قَومي بَلائي","إِذا ما اِسّاءَلَت عَنّي الشُعوبُ",3,"ب",1,0],["وَلَكِنَّ خِرباناً تَنوسُ لِحاهُمُ","عَلى قُصُبٍ جوفٍ تَناوَحَ خورُها",4,"ر",3,1],["وَلَكنَّ خَيرَ الناسِ مِن كَفَّ شَرَّه","عَن الناس أَو أَغنى الحَياةَ وَأَسعَدا",5,"د",2,0],["ولكنّ خالي سابق متفرّع","ذرى العز عنان على كل مخطم",6,"م",1,0],["ولكنْ خُذوا أَسْيَافَكُمْ وَتَوَكَّلُوا","على اللهِ إنَّ الأمْرَ للهِ أجمعُ",7,"ع",1,0],["ولكن خُلقكم بلطفِ اللطيفِ","لأن تَحْمِلوا لا لأن تُحمَلوا",8,"ل",3,0],["ولكن خليلي من يدوم وصاله","ويحفظ سري قلبه ودخيل",9,"ل",1,0],["ولكن خرجْنا نطلبُ الرزقَ أينما","يكونُ ومن برٍّ بسيطٍ ومن يَمِّ",10,"م",1,0],["وَلَكِن خُذوني أَيَّ يَومٍ قَدَرتُمُ","عَلَيَّ فَحُزّوا الرَأسَ أَن أَتَكَلَّما",11,"م",2,0],["ولكن خدي اصفر من سقم الهوى","فسال به والماءُ لون إنائه",12,"ه",1,0],["ولكن خيال كاذب وطماعة","تعلل قلباً بالأماني متيما",13,"م",2,0],["ولكن خَلت بي حيثُ لا يَبطش الندى","فيُخشى ولا يُصغي إذا قمتُ مادِحا",14,"ح",2,0],["ولكن خبرنا الناس من قبل خبركم","فما همهم إلا اتباع الدراهم",15,"م",1,0],["ولكن خِفتُ من نارِ الأعادِي","عليكَ فكنتُ إِطفاءَ الضِّرامِ",16,"م",1,0],["ولكن خشِيتُ الكاشِحين فإنَّني","على سِرِّنا مِن أَن يَذيعَ شفيقُ",17,"ق",1,0],["وَلكِنْ خانَ مَعْشُوقٌ وَأَضحى","نَديمٌ وَهْوَ مِنْ عُدَدِ الندامَهْ",18,"م",2,0],["ولكن خانني منه أمينٌ","وأسلمني إلى الأخطار حامي",19,"م",2,0],["ولكنَّ خبثَ النفسِ داؤُه مُعضِلٌ","ولاَ لِقَضاءٍ عَن مَريضِه مَبرَمُ",20,"م",1,0],["وَلَكِن خُطِّبت مِن غَيرِ كُفؤٍ","وَضيعٍ في البريَّةِ لا شَريفِ",21,"ف",1,0],["ولكن خمولي حثني أن يكون لي","بمدحك قدح في النباهة يضرب",22,"ب",1,0],["وَلَكن خُذها لا سَلام مودع","وَلَكِنها نار نريد التهابها",23,"ب",3,0],["وَلَكِن خَليطاً مِن نَعيمٍ وَشَدَّةٍ","فَإِن يَأتِ خَيرٌ فَاِخشَ شَراً مُعَقِّبا",24,"ب",2,0],["وَلكِن خيوانَ هُم قَومُهُ","فَبِئسَ هُمُ القَومُ لَلصّاحِب",25,"ب",1,0],["وَلَكِنَّ خَيرَ الناسِ مَن قالَ ناهِضاً","أَراكَ أَيا دَهري عَلى الرَغمِ خادِمي",26,"م",2,0],["ولكن خالفت نصي وكانت","بكانونين عدت تحاط",27,"ط",1,0],["ولكن خيال الشعر أرَّق خاطري","وسهّد طرفي والاديب سهود",28,"د",1,0],["ولكن خطام النفس اعسر محملا","من الصخرة الصماء حين ترومها",29,"ه",2,0],["ولكنْ خِدْمَتي شرَفي وذِكْري","لدى موْلايَ موهبةٌ عظيمَهْ",30,"م",2,0],["وَلكِن خَلَعتِ القَلبَ بِالوَعدِ وَالمُنى","وَلَم أَرَ يَوماً مِنكِ جوداً وَلا صِدقا",31,"ق",2,0],["وَلكِن خَسِرتَ القَدحَ خُسرانَ جاهِدٍ","فَعُدتَ لِتَبَنّي بادِئاً غَيرَ يائِسِ",32,"س",1,0],["ولكنَّ خير اللَه كالبحر في الوَرى","فيغصبُهُ عاصٍ ويجنيهِ راهبُه",33,"ب",2,0],["ولكن خف إلهاً ما","لكَ الأشياء مقتدرَا",34,"ر",2,0],["ولكن خوف أن يغشى عليها","من القرم الشديد إلى السفاح",35,"ح",1,0],["ولكنْ خُلَّبٌ برقُ الغواني","فلا تروي الظّماءَ ولا الصوادي",36,"د",2,0],["ولكن خيالي مسهب في تصور","فلا تجفلي مما بها كلماتي",37,"ت",2,0],["ولكن خفت إن قالوا","نراه لأنه الجانِ",38,"ن",1,0],["ولكن خايف ٍ من قول بن عمار حاله مال","وهم ماشافوا اللي صار ومايدرون عن ظرفه",39,"ف",2,0]]}