an/poem/67608","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83370","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117227","البسيط"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/205162","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18812","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58135","البسيط"],[463,"تزلُّ الليالي مرة ً وتصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17988",""],[4865,"ألا أيها الويلات ويلة من بكى","https://www.poetsgate.com/ViewPoem.aspx?id=213877",""],[4881,"يقولون لي","https://www.poetsgate.com/ViewPoem.aspx?id=181740",""],[4935,"صاح انتبه من غفلة الشهوات","https://www.poetsgate.com/ViewPoem.aspx?id=129375",""],[4935,"ببحثك عن كل ما يصدر","https://www.poetsgate.com/ViewPoem.aspx?id=129316",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[231,"الإهداء","https://www.poetsgate.com/ViewPoem.aspx?id=186123",""],[5111,"سَبْكُ الحُروفِ","https://www.poetsgate.com/ViewPoem.aspx?id=212327",""],[5177,"ولا خير في الدنيا لمن لم يكن له","https://www.poetsgate.com/ViewPoem.aspx?id=90895",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[592,"أما والذي لا يعلم الغيب غيره","https://www.poetsgate.com/ViewPoem.aspx?id=128850",""],[5431,"وإن كان الحبيب بصدر بيتٍ فصحْبتكم لها بالبيت عجْزُ","https://www.poetsgate.com/ViewPoem.aspx?id=189466",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[5582,"قِفْ وَسَلِّمْ فِي مَغانِي ذِي سَلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=63570",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[4444,"انا المذنب الخطأ والعفو واسعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=85455",""],[5691,"يا قدْسُ...!","https://www.poetsgate.com/ViewPoem.aspx?id=206847",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[5885,"البئر قد جف","https://www.poetsgate.com/ViewPoem.aspx?id=203025",""],[5943,"بناءُ النَّفسِ يلزمه اعتناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=34822",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[6259,"علا بك نجمُ الدين فاشتدَّ ناصره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59378&r=&rc=26",""]],"verses":[["فَإِن تَعتَطِل يَوماً مِنَ الدَهرِ صَعدَتي","فَقَد طالَ في نَحرِ العَدُوِّ طِعانُها",0,"ن",3,0],["فَإِن تَعهَديني وَلي لِمَّةٌ","فَإِنَّ الحَوادِثَ أَلوى بِها",1,"ب",3,0],["فَأَنتَ عَلى مِنهاجِهم تَقتَتَدي بِهم","أَمامَكَ ما سَدّوا وَأَنتَ عَقيبُ",2,"ب",1,0],["فإن تعجبوا أن سال دمعي لأجله","فِإنَّ دمي من أجله سَيسيل",3,"ل",1,0],["فَأَنتَ عَلى يَجودَةَ مُستَذَلِّ","وَفي الحَيِّ الَّذينَ عَلا لِهابا",4,"ب",2,0],["فأنتَ عندِي وعند الناس أكرم من","ذاك الممكن يا نعم الفتى الراجي",5,"ج",2,0],["فإن تعدَّت عِصابةٌ فلها","منه سيوفُ النَّكال أو خَشَبُهْ",6,"ب",2,0],["فإن تُعمل المطل حتى إذا","حَداني الملالُ مع الصادر",7,"ر",1,0],["فإن تعجّب قومٌ قلت ممتثلاً","قولَ الفرزدق فيما أدَّت السِّيَرُ",8,"ر",1,0],["فإن تعاطى الحديث مات من ال","عيِّ وأبصرتَ عُرّةَ العُرر",9,"ر",1,0],["فأنت عون لمن هجاك على","نفسِكَ ظُفرٌ لكل خمّاش",10,"ش",1,0],["فإنُ تعذَّرنَ أن يُجبنك بال","قوَّةِ فاحتَلْ لطائفَ الحيلِ",11,"ل",1,0],["فَإِن تَعفُني مِنها تَكُن لِيَ حُرمَةٌ","أَكونُ عَلى غَيري بِها أَتَشَرَّفُ",12,"ف",1,0],["فانت عما في فؤا","دي من اسىً تترجم",13,"م",1,0],["فَإِن تُعطِهِ مِنكَ الأَمانَ فَسائِلٌ","وَإِن تُعطِهِ حَدَّ الحُسامِ فَأَخلِقِ",14,"ق",1,0],["فَإِن تَعَلَّيتَ فَالمُوَفَّقُ بِاللَ","هِ مَرادُ النَدى وَمُطَّلِبُه",15,"ب",2,0],["فإن تعف عني تعف عن غير جاحد","لما كان والإقرار بالذنب أروح",16,"ح",1,1],["فَإِن تَعطِ نَفسَكَ آمالَها","فَعِندَ مُناها يَحِلُّ النَدَم",17,"م",1,0],["فَإِنَّ تَعَدَّ أَكلُهُ لُقمَةً","رَأَيتَ في أَضلاعِهِ رَفسي",18,"س",2,0],["فَأَنتَ عِندي بِلا شَكٍّ بَقِيَّتُهُم","مُنذُ اِحتَلَمتَ وَقَد جاوَزتَ سَبعينا",19,"ن",2,0],["فَإِن تُعطِني أُفرِغ إِلَيكَ مَحامِدي","وَإِن تَأبَ لا يُضرَب عَلَيكَ سِدادُ",20,"د",1,0],["فَإِن تَعِش تُبصِرِ الباكينَ قَد ضَحِكوا","وَالضاحِكينَ لِفَرطِ الجَهلِ باكينا",21,"ن",2,0],["فإنْ تَعْهَديني لا أزالُ مُسائِلاً","فإنّيَ لم أُعْطَ الصّحيحَ فأستَغني",22,"ن",2,0],["فإنَّ تعاوُنَ الأمْلاكِ جَهْلٌ","على مَلِكٍ بخالِقِهِ يُعانُ",23,"ن",1,0],["فَأَنتَ عَلى الأَدنى شَمالٌ عَرِيَّةٌ","شَآمِيَّةٌ تَزوي الوُجوهَ بَليلُ",24,"ل",1,0],["فإن تعش سالماً عاشَت سعادته","وإن تمت ماتَت الآمال والهمم",25,"م",1,0],["فإن تعطه بعض الأمان فسائلٌ","وإن تعطه حدّ الحسام فأخلق",26,"ق",1,0],["فان تعف عنى تعف عن تمرد","ظلوم غشوم لا يزايل مائما",27,"م",2,0],["فإنْ تعذَّرنَ أن يُجبنك بالقوْ","وَة فاحتَلْ لطائفَ الحيل",28,"ل",1,0],["فانت على فرش التدلل راقد","واني على ترب التذلل اسهد",29,"د",1,0],["فَإِن تُعقِبِ الأَيّامُ وَالدَهرُ تَعلَموا","بَني قارِبٍ أَنّا غِضابٌ بِمَعبَدِ",30,"د",1,0],["فأنت عليم بالذي هو مضمرٌ","لنا فيه ارحمنا فرحمتك القصَدُ",31,"د",1,0],["فأنت على الأعدا هزبرٌ وفي الندى","خضم وعن من تاب عافٍ عن الذنبِ",32,"ب",1,0],["فان تعجبت من فضل أتيت به","فذلك الفضل عندي بعض ما وهبا",33,"ب",2,0],["فإن تعرضتَ إلى رِفْدِهم","كنت عدوا لهمُ والسلام",34,"م",1,0],["فإن تعطشت إلى شربه","فاغترف الماء ببوقيل",35,"ل",1,0],["فإن تعالى رجال في مناسبهم","ترفعا فالمحلّ الدين والأدبُ",36,"ب",1,0],["فَإن تُعِن ثَعلباً يَسطو على أسدٍ","أَو تخذل اللّيثَ لا يَقوى لثعلبهِ",37,"ب",2,0],["فَإِن تَعدَوَنّا الجاهِلَيَّةُ أَنَّنا","لَنُحدِثُ في الأَقوامِ بُؤسى وَأَنعُما",38,"م",2,0],["فإن تعطِ طفلكِ للخادمين","فما زدتِ إلا عديدَ الخدمْ",39,"م",1,0],["فَإِن تَعطِفِ القَومَ أَحلامُهُم","وَيَرجِعَ مِن وُدِّهِم ما نَأى",40,"ا",1,0],["فَإِن تعالى إِلَيكِ النوحُ من تَعِسٍ","إِرمي لعازر شَيئاً من عَطاياكِ",41,"ك",1,0],["فأنت عمادي في حياتي وعدتي","لموتي وذخري في المعاد إذا دنا",42,"ن",2,0],["فَإِن تَعَذَّرَ أَو عَزَّتُ مَطالِبُهُ","فَالكَأسُ وَالكيسُ وسواسٌ وَخَنّاسُ",43,"س",1,0],["فَأَنْتَ عَلَى الدَّهْرِ حَلْيٌ بَهِيٌّ","وَأَنْتَ عَلَى الْمَجْدِ تاجٌ عَقِيدُ",44,"د",1,0],["فأَنتِ عصمةٌ لنا","وأَنتِ برجُ الأَسد",45,"د",1,0],["فَإَن تُعطِني جَرمٌ لِأَنّي اِمتَدَحتُها","فَما عَلِمَت جَرمٌ لَها مادِحاً قَبلي",46,"ي",1,1],["فإِن تَعالَت عَنكَ هِمَّاتُه","فقَد تَدانَت منكَ أَخلاقُهُ",47,"ق",2,0],["فأنت عندي أخسُّ الناس منزلةً","يا ظالماً أذهلَ الكفارَ والغَطَطا",48,"ط",2,0],["فَإِن تَعَذَر هَذا","فَما لَها مِن خَلاق",49,"ق",1,0],["فأنتَ علَيها خائِفٌ غَصْبَ غاصِبٍ","وحِيلةَ مُحتالٍ وغِيلَةَ مَرْصَدِ",50,"د",1,0],["فأن تعلُ قَحطان فَفي الليل أَنجم","وَلا يَستَوي أَغفاله وَزواهِرُهُ",51,"ر",2,0],["فَإِن تَعَذَّرَ مطريه وَمادِحه","أَتى إِلَيهِ مرجِّيهِ وَنادِبُهُ",52,"ب",2,0],["فأَنتَ عَلَيْهِ دَليلي وعَوْنِي","وجدواكَ ذُخْرِي إِلَيْهِ وَزَادِي",53,"د",2,0],["فإن تعف عني فهو منك كرامة","فإني سؤول والمسول كريم",54,"م",1,0],["فإن تعطياه الحق حقاً عليكما","فبئس فروع القوم تظلم أصلها",55,"ل",3,0],["فإن تعف عني فهي منك كرامةً","ومهما تعذبني فذو الدين غارم",56,"م",1,0],["فأنت عدل إذا عذبتني واذا","رحمتني فهو من أياديكا",57,"ك",2,0],["فأنت عين التقى والمجد نجدته","بل أكرم الكرما الباقين والأول",58,"ل",1,0],["فإن تَعُدْ تَعُدْ إلى خلائقٍ","مازلتَ محسودا على حِسانِها",59,"ن",3,0],["فإن تعزَّلتَ وفارقتَها","أو نابَ في تدبيرها نائبُ",60,"ب",1,0],["فإن تعد بعد حين عنكَ حامدةً","مغارها فعدا أرساغها الثمن",61,"ن",1,0],["فَإِن تَعتَريني بِالنَهارِ كَآبَةٌ","فَلَيلي إِذا أَمسى أَمَرُّ وَأَطوَلُ",62,"ل",1,0],["فأنتَ على عقلٍ تنوَّرَ بالهُدى","وفيهِمْ من الشِّرْكِ الخَفِيِّ خَبَالُ",63,"ل",1,0],["فَأَنْتَ عِنْدَهُمُ العَدْلُ الرَّضِيُّ وإنْ","رَفَضْتَ شَرْعَ رَسُولِ اللهِ عَنْ كَمَلِ",64,"ل",1,0],["فأَنْتَ عَلَى الحَقِّ الْمُبِينِ وإِنْ أَبَى","مَقالَكَ جَهْلاً كُلُّ فَدْمٍ مُبَلَّدِ",65,"د",1,0],["فأَنْتَ عَلَى الحَقِّ الْمُبينِ مُوافِقٌ","شَرِيعَةَ خَيْرِ المرْسَلِينَ مُحَمّدِ",66,"د",1,0],["فانتِعاشُ النفُوسِ ينمُو سريعا","وازدهَارُ القلوبِ في الإديادِ",67,"د",1,0],["فإن تعشْ برهةً فأنت بما","رُمِيتَ مَيْتٌ لم تسكن الرَّجَما",68,"م",2,0],["فَإِن تعطِني أولى الخِضاب شبيبةً","فإنّي أُخيراه بغير شبابٍ",69,"ب",1,0],["فأنتَ عِنديَ نِصفُ النَّاس وا عجَبا","إن كانَ يُحسَبُ نِصفَ النَّاسِ إنسانُ",70,"ن",1,0],["فَأَنتَ عَليُّ القَدر في خَير دَولةٍ","لِتوفيقها في مَصرَ أَعلامُ غالب",71,"ب",1,0],["فَأَنتَ عِقدٌ مُثمَنُ","لَم تَفتَقِر لواسطة",72,"ه",1,0],["فإن تُعيروهُ لذي فطنةٍ","لا بدَّ أَنْ يَحْبِسَه أَشْهُرَا",73,"ر",2,0],["فإن تعد حرَّةً مصرٌ لصاحبها","حق القيام بهذي المهرجانات",74,"ت",1,0],["فإن تعدلوا كنا صحاباً أعزة","وإن تظلموا كان الوفاق بعيدا",75,"د",2,0],["فأنت عديم الشبه في موقف الوغا","تصرعُ للأبطال من غير لا ذعر",76,"ر",1,0],["فَإِنْ تَعلُه هام السّماكِ رَكِبتها","تَطولُ الثّريّا فَوقه لَو طَلبتها",77,"ه",2,0],["فإنْ تعجل جوابَ مسألتي","أذكرْكَ بالخير بين أصحابي",78,"ب",2,0],["فإن تعتُبى فالوعظ أحكمُ حاكم","ألسنا مماليك المقدَّر والقضا",79,"ض",2,0],["فَاِنتعشني من أزاليق بها","صرتُ ما بينَ مخافاتٍ همَم",80,"م",1,0],["فَأَنتَ عَلى العِبادِ أَفَضتَ خَيراً","فَهامَت في مَحبتكَ العِبادُ",81,"د",1,0],["فَإِن تَعُد عادَت لِما ساءَها","وَكانَتِ النَعلُ لَها حاضِرَه",82,"ر",2,0],["فأنت عند المحل مزن لنا","يهمي وعند النقد إبريز",83,"ز",1,0],["فإن تعلموني كنت كفاً وساعداً","وإن تهملوني ضائعاً تشمتوا العدا",84,"د",2,0],["فَأَنتَ عِبت نَفسكا","لَما اتبعت حسكا",85,"ك",2,0],["فَإِن تُعاقِب فَأَهلٌ لِلعِقابِ وَإِن","تَغفِر فَعَفوُكَ مَأمولٌ وَمُنتَظَرُ",86,"ر",1,0],["فأنت عدة أعمالي وعمدة","آمالي وعصمة أقوالي وأفعالي",87,"ل",2,0],["فإن تعذر حلو كان ما وسعت","أقدارهم وإذا لم يقدرا عُذرا",88,"ر",2,0],["فإنْ تعطفْ على رجلٍ غريبٍ","فإني ذلك الرجل الغريب",89,"ب",1,0],["فإنْ تَعَافُوا الْعَدْلَ والإيمَانَا","فإنَّ في أيْمَانِنَا نِيرَانَا",90,"ن",2,1],["فان تعفو فمنٌّ منك ربي","كذاك الظن في المولى العلي",91,"ي",1,0],["فإن تعفُ فمن شيم وخُلقِ","وإن عاقبتَ ماعاقبتَ ظلما",92,"م",2,0],["فإنْ تُعقِبِ الأَيّامُ قرباً نَلَذُّهُ","فنُعمى بها مَنَّ الإلهُ وأسعفا",93,"ف",2,0],["فَإِن تَعفُ عَمَّن يَطلُبُ العَفوَ مِنهُمُ","فَعِندَكَ لِلجاني عِقابٌ وَغُفرانُ",94,"ن",1,0],["فأنت عِندي بلا شكٍ 