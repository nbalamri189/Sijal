{"poems":[[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85574","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[580,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102038","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105518","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112807","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109452","البسيط"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124604","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28317","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82826","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48278","الوافر"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114630","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70120","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90960","السريع"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94556","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94585","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94886","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139546",""],[5102,"أبي . . .","https://www.poetsgate.com/ViewPoem.aspx?id=15171",""],[5198,"في نصرة رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=135209",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5703,"من شُرفةِ المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=208738",""],[5711,"بمدرجِ الأقلاعِ مِنْ يأسِ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=24707",""],[5720,"الأَرض (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200226",""],[5976,"ما عيّنت خير","https://www.poetsgate.com/ViewPoem.aspx?id=30536",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""]],"verses":[["لِنصرِكَ ربَّنا خُضْنا المنايا","وفيكَ وفي رسولِكَ ما لَقينا",0,"ن",2,0],["لِنَصرِكُم وَالسُيوفُ تَطلُبُهُم","حَتّى تَوَلَّوا وَأَمعَنوا هَرَبا",1,"ب",2,0],["لنصبر قَليلاً على ضيمنا","لعل الَّذي ضامنا يعدل",2,"ل",1,0],["لِنَصِيرِ شَرَفٍ زَادَ اسْمُهُ","بِعَزِيزِ النَّصْرِ نُبْلاً وَازْدِهَاءْ",3,"ا",2,0],["لنصرةِ دينِ الله جرَّدَ خالدٌ","حساماً عليهِ أسلَمَ البُسلاء",4,"ا",2,0],["لِنُصْرَتِهِ ما أشْرَفَتْ راسِياتُها","وَما صَيَّرَتْ عِلْماً يَقيناً بِها الظَّنّا",5,"ن",2,0],["لِنصرِكَ حتَّى تملكَ الغربَ بالغَلْبِ","قد اجْتَمعتْ زُهْرُ الكواكبِ في الغَرْبِ",6,"ب",1,1],["لنصبح في أفكارنا خير مرشد","وتغدوعلى أخلاقنا خير حارس",7,"س",1,0],["لنصرة الحق وافاه الملائك إذ","أعيا الجلاد وهبت ريح نكباه",8,"ا",2,0],["لنصر الهدى كأس الحمام له حلا","على أن كأس الموت معمه مر",9,"ر",1,0],["لنصرته ورفع القدر جاءت","ملائك ربنا يوم القليب",10,"ب",1,0],["لنصب فعل أن وكي لام ولن","والفاء والواو وأو حتى إذن",11,"ن",1,0],["لنصب مستثنى الأسامي إلا","والفعل قام القوم إلا عبلا",11,"ل",2,0],["لنصره الشرع نرجو أن يكون له","من ربه منزلٌ مع صاحب الغار",12,"ر",1,0],["لنص العلى والمكرمات تقلّدوا","سيوفاً ولا كالهندوانيّة العضب",13,"ب",1,0],["لنصبتني شبح السهام صوائبا","سميت فيها الخمسة الأشباحا",14,"ح",2,0],["لَنَصفَحُ عَن أَشياءَ مِنهُم تَريبُنا","وَنصدفُ عَن ذي الجَهلِ مِنهُم وَنَحلمُ",15,"م",1,0],["لِنَصيرَ مِن خيرِ الرِجال","وَلِمِصرَ نُظهِرُ ما اِستَكَن",16,"ن",1,0],["لنُصْرةِ مُلْكِهِ الأعْلَى تجلّتْ","ملائِكُ ترتقي السّبعَ الشِّدادا",17,"د",2,0],["لنصر فى فؤادى فرط حب","ينيف به على كل الصحاب",18,"ب",1,1],["لِنُصرَةِ أَيِّ القَومِ مَن يَجرِمِنكُمُ","يَأُوبَنَّ مَنكُوبابً يُخَضِّبُهُ الدَّمُ",19,"م",1,0],["لنصرِ الحَقِّ كُرسيٌّ تَسامى","بيوحنا الَّذي قَد سادَ فيهِ",20,"ي",2,1],["لنصف ذي الحجة قل ارخوا","عاما به آن غياب الهلال",21,"ل",1,0],["لنُصرَة الحقِّ قد قاموا بأسرهم","وربهم باليدِ العُليا لهم نصرا",22,"ر",2,0],["لنصر اللَه قد وافى إحترامٌ","من الكُبّارِ ذي البطش الشديدِ",23,"د",1,0],["لنصر العاهل الكُبّارِ دوماً","وحفظ علي رضى برضاه والي",24,"ل",2,0],["لنصر اللَه أرَّخنا بحمدٍ","عُطاشى فاشربوا ماءً طهوراً",25,"ر",2,0],["لنصر الدين قم إذ فيك أضحى","قويما منه أعليتَ الجنابا",26,"ب",2,0],["لنصنعَ بعض دمى القصبِ","نكسّرها قبل أن تهرُبي",27,"ب",2,0],["لنصرتك ناقف صفوف وصفوفي","نذب عن عرضك حشود وطوابير",28,"ر",1,0],["لنص رسول الله أفضل مرسلٍ","وإجماع أهل العلم من كل مستهد",29,"د",1,0],["لنصرة أهل الحق من كل قائم","بذلك لا آلو وإني لباذله",30,"ل",2,0],["لنصونَ مجدكِ ياشآمُ فنصرُنا","شَمسٌ بدَتْ بسمائنا تَتلالا",31,"ل",2,0],["لنصوغ مِنْ كل الجمال جمالاً","نتفرد العزف المُشردُ البياع",32,"ع",1,0],["لنصبحَ قدوةً .. في كل خير","وننبذَ شأفة العمل المُرِيب",33,"ب",1,0],["لنّ صبْي ٍ لا يجار وْلا يجير","يا عساه يْزول يالله .. يا عسى .. !!",34,"س",2,0],["لنصحوَ بعد انقضاء اللهيب","وقد عادت الروح شيّاً فشيّا",35,"ي",2,0]]}