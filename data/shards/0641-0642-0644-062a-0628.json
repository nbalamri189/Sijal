{"poems":[[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[56,"وميثاء خضراء زربية","https://www.aldiwan.net/poem27457.html","المتقارب"],[29,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[53,"شكوت إِلى بدري هواه فقال لي","https://www.aldiwan.net/poem64053.html","الطويل"],[53,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[40,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[33,"تشط غدا دار جيراننا","https://www.aldiwan.net/poem42585.html","المتقارب"],[42,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[50,"سألتها قبلة ففزت بها","https://www.aldiwan.net/poem10794.html","المنسرح"],[50,"وندمان ترادفه خمار","https://www.aldiwan.net/poem62552.html","الوافر"],[50,"لا تصحبن أخا نسك وإن نسكا","https://www.aldiwan.net/poem64465.html","البسيط"],[50,"إذا خطرت فيك الهموم فداوها","https://www.aldiwan.net/poem65098.html","الطويل"],[50,"من يك من حبيك خلوا فما","https://www.aldiwan.net/poem66202.html","البسيط"],[52,"عبيدة أطلقي عني صفادي","https://www.aldiwan.net/poem63921.html","الوافر"],[50,"","https://poetry.dctabudhabi.ae/diwan/poem/199536","السريع"],[50,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[33,"أتوصلُ زينبُ، أمْ تهجرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18900&r=&rc=163",""],[113,"لعمرك ما الدنيا العريضة بالدنيا","https://www.aldiwan.net/poem16188.html","الطويل"],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[173,"قالوا الدبيثي ذو قواف","https://www.aldiwan.net/poem1671.html",""],[208,"مزاري قريب والوصال بعيد","https://www.aldiwan.net/poem53338.html","الطويل"],[234,"سألت حبك إذ أخلصت ظاهره","https://www.aldiwan.net/poem51201.html","البسيط"],[267,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[275,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[287,"تبوح دموعي واللسان صموت","https://www.aldiwan.net/poem32850.html","الطويل"],[310,"وقالوا الرزق بالتدريس صعب","https://www.aldiwan.net/poem56374.html","الكامل"],[343,"إذا اعتصم الوالي بإغلاق بابه","https://www.aldiwan.net/poem68808.html","الطويل"],[358,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[369,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[401,"وقالت لا أراك تُليق شيئاً","https://www.aldiwan.net/poem564.html",""],[435,"سألت القلب لما فر مني","https://www.aldiwan.net/poem39871.html","الوافر"],[438,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[440,"تأذى بلحظي من أحب وقال لي","https://www.aldiwan.net/poem25694.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[505,"يقولون يا هذا الشيوخي كم تهم","https://www.aldiwan.net/poem37726.html","الطويل"],[534,"وذي رفض ينازعني بجهل","https://www.aldiwan.net/poem37547.html","الوافر"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137340",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87209","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86704","الطويل"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143236","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100140","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120052","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59384","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80174","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25342","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108764","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108621","الوافر"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33020","الطويل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131699",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82986","المتقارب"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83020","المجتث"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101883","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201075","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200700","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200540","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200142","الوافر"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112482","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87589","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87449","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87417","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112402","المتقارب"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66482","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91380","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117982","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131085",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103036","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77081","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100564","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83491","الوافر"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119556","السريع"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204252","السريع"],[4929,"سكبت حبي له لحنا","https://www.poetsgate.com/ViewPoem.aspx?id=199297",""],[5054,"نَعيمُ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=213763",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[307,"مساءُ البهاء","https://www.poetsgate.com/ViewPoem.aspx?id=213699",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[5612,"صَلُّوا عَليْه","https://www.poetsgate.com/ViewPoem.aspx?id=179970",""],[5644,"لمن تكتبين؟","https://www.poetsgate.com/ViewPoem.aspx?id=204499",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[1920,"حديث البنفسج","https://www.poetsgate.com/ViewPoem.aspx?id=191390",""],[5975,"وتسألني","https://www.poetsgate.com/ViewPoem.aspx?id=52989",""],[5997,"ريع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214208",""],[6021,"دار","https://www.poetsgate.com/ViewPoem.aspx?id=201667",""]],"verses":[["فَقُلْتُ بَعِيداً لاَ مُدِحْتَ بِطَيِّبٍ","سِوَى عِبْرَةٍ عَنْ بَارِحِ الْخَطْبِ تَنْجُمُ",0,"م",1,0],["فَقُلتُ بَعُدتُم وَلَكِنَّني","أُشَبِّهُهُ بِجَنابِ الحَسَن",1,"ن",1,0],["فَقُلتُ بِحاجَةٍ وَطَوَيتُ أُخرى","فَهاجَ عَلَيَّ بَينَهُما اِكتِئابا",2,"ب",2,0],["فقلت بلى قال التمسهُ فإنه","نظيري وشِبهي في علوي وفي قدري",3,"ر",2,0],["فقلت بنَيْتُ مأْثُرةً بِشعْرِي","فلا تعرِض لمأثُرَتي بهدم",4,"م",1,0],["فَقُلتُ بِالشامِ إِخوانٌ ذَوُو ثِقَةٍ","ما إِن لَنا دونَهُم رَيٌّ وَلا شَبَعُ",5,"ع",1,0],["فَقُلتُ بَلى قَلَّ عِندي لَكُم","كَلالُ المَطِيِّ إِذا تُجهَدُ",6,"د",1,0],["فَقُلتُ بَلى عَرِّجا ساعَةً","وَغُضّا المَلامَ فَعاجا وَطاعا",7,"ع",2,0],["فَقُلتُ بِاللَهِ يا مُعَذِّبَتي","جودي بِأُخرى أَقضي بِها أَرَبي",8,"ب",2,0],["فَقُلتُ بَلى وَبِأُخرَياتٍ","عَلى أَنّي سَأَجعَلُها جِيادا",9,"د",2,0],["فَقُلتُ بِالشُكرِ مِن عَينَيكَ آخُذُهُ","فَصَدَّ مِن خَجَلٍ مِنّي وَما ضَحِكا",10,"ك",2,0],["فَقُلتُ بِكَم رِطلٌ فَقالَت بِأَصفَرٍ","فَحُزتُ زِقاقاً وِزرُهُنَّ عَظيمُ",11,"م",1,0],["فَقُلتُ بِعني مِنهُ ما أَشتَهي","فَمَرَّ عَجلانَ وَلَم يَلوِ",12,"ل",2,0],["فَقُلتُ بِفَقدِها حارَبتُ نَومي","وَحارَبتُ التَيَقُّظَ بِاِفتِقادي",13,"د",2,0],["فقلت بالله وآلائه","ورب ياسين مع الحشر",14,"ر",1,0],["فقلت بكم رطل فقال بأصفر","فحزت دناناً وزرهن عظيم",15,"م",1,0],["فقلت: بلى ، أقعدي ناصحاً،","يُنَفِّضُ عَنّا الَّذي يَنْظُرُ",16,"ر",1,0],["فَقُلت بَياض تَحتَ مسود سالف","لِقَتلي في دين الغَرام هُما الفُتيا",17,"ي",2,0],["فقلت بشرى ولكني على سفر","من ذا أقام كنجم القطب لم يحل",18,"ل",1,0],["فَقُلتُ بُعداً لَكُم وَسُحقاً","فَكُلُّ أَفهامِكُم سَقِيمَه",19,"م",2,0],["فقلت بذنبي في الهوى وعذابه","فيا ربّ خلِّصني فلستُ أعودُ",20,"د",1,0],["فقلت بَلِّغه ما أخلصتُ منك له","فقال قد أنبأتْهُ بي طويّتُه",21,"ه",1,0],["فَقُلتُ بأربَعِينَ فَقَال أحسِن","إلَيَّ فإنّ مِثلَكَ ذُو سِجَالِ",22,"ل",1,0],["فقلتُ بذاكَ لي شرفٌ","وهذي عادةُ العرب",23,"ب",1,0],["فَقُلتُ بَلى للقُربُ خَيرٌ مِنَ النَوى","لِأَنّي إِذا شَطَّ المَزارُ نُسيتُ",24,"ت",1,0],["فَقلتُ بظاهر في الأمرِ لينٌ","ولَكن باطناً يُخشى خُشونه",25,"ه",1,0],["فَقُلتُ بِهِ مَسٌّ مِنَ العيِّ ظاهِر","فَفي إِذنِهِ لِلناسِ إِظهارُ ما بِهِ",26,"ب",2,0],["فَقُلت بِبَيع النَفس ما أَنا ماكس","فَقال بِهَجري أَنتَ لا شَكَّ ماكثُ",27,"ث",1,0],["فَقُلت بِماذا الضدّ أَصبَح نابِسا","فَقالَ بأنّي لحد مِثلك نابثُ",27,"ث",1,0],["فقلتُ بلِ المولَى ابنُ خالدٍ الّذي","بأسنَى العَطايا منه زائرُهُ يُقرى",28,"ر",2,0],["فقلتُ بحَسبها يَسرُ وعار","ومُرتحلٌ إِذا رَحَلَ الوفودُ",29,"د",1,0],["فقلت بمن يمثلُ قال دعني","فكل الصيد في جوف الفراء",30,"ا",2,0],["فقلتُ بعُدْتُمْ بل حكى وجهَ أحمدٍ","كذلك يسْري ضوؤه ويَنورُ",31,"ر",1,0],["فَقُلْتُ بُلِينا بالرَّقيبِ فَقال ما","بُلِينا وَلكِنَّ الرَّقيبَ بُلي بِنا",32,"ن",2,0],["فقلت بربي أستعين فأنني","نويت لهم خيراً وان كنت قاصرا",33,"ر",2,0],["فَقُلتُ بِمِتْكينَ السَّرارَةُ تَنْجَلي","وكَوْكَبُنا من ذلكَ البُرْجِ مَرْئِيُّ",34,"ي",1,0],["فَقُلْتُ بِفِيكَ يا مَخْذُولُ تُرْبٌ","وشَرُّكُما لِخَيْرِكُما الفِدَاءُ",35,"ا",2,0],["فقلتُ بنفسي هذهِ صورةُ الذي","يُذيقُ الورى كأساً أمرَّ من الصبر",36,"ر",1,0],["فَقُلت بِإِخلاص لِعلياهُ شاكِراً","بِدَولتك الإِتقان نال مُناه",37,"ن",3,0],["فَقُلت بِأَوقات الصَفاء مؤرِّخاً","أَتى مصطفى كَالبَدر في بر أحمد",38,"د",1,0],["فقلت: بزاقى لايفى بجميعه","ومن أين لى أن أبزق الدرب كله",39,"ه",1,0],["فقلت بلى إن السلو بسيد","أغر وأزكى العالمين وأورعا",40,"ع",2,0],["فقلت بأن للإحسان مول","سوى المولى أبي الفضل الهجانِ",41,"ن",1,0],["فقلت بأن للإحسان مولى","سوى المولى أبي الفضل الجوادِ",42,"د",1,0],["فَقُلْت بِالْوَجْهِ الَّذِي","لِغَيْرِهِ لَمْ يَسْجُدِ",43,"د",1,0],["فَقُلتُ بِكَفِّ الشَرعِ يا قَومِ إِرخوا","تَجَرَّد لِلفَتوى حُسامُ بِهاءِ",44,"ا",2,0],["فَقُلْتُ بَيْنَ الخَفْضِ وَالتَأْسِيفِ","غَيَّرَ لَوْنَ اللِمَّةِ الخَصِيفِ",45,"ف",1,0],["فقلت بهذا يضعف اللَه صبرنا","وجور الهوى يزداد يا منيتي ضعفا",46,"ف",2,0],["فقلت بلى وصالح بين ثغري","وثغر حبيبتي قيراط تبر",47,"ر",1,0],["فَقُلتُ بَلى ما مِن إِذا قيلَ مَن لَهُ","تَسَمَّ لَهُ لَم أَغضُضِ الطَرفَ ناكِسا",48,"س",2,0],["فقلت بالله يا غزال تهمد","واصل محبك قال ما هو الآن",49,"ن",1,0],["فَقُلتُ بحُرمَةِ من زُرتُمُ","أَحَقّاً تقولون قالوا نعم",50,"م",1,0],["فَقُلتُ بات فُلانٌ","يَرجو النَّجاةَ بدانِ",51,"ن",1,0],["فقلت بملوي الجعود تبرقعي","فكم كبد شقت عليك مرائره",52,"ر",2,0],["فقلت بيَ استرشد ولاتك مرشدي","فشعريَ من روحي وروحيَ من ربي",53,"ي",1,0],["فقلت بحمد الله قد صكّ سمعنا","نباح كلاب لا نباح أنام",54,"م",1,0],["فقلتُ بضاعةُ الإخلاص عندي","فليس تروج في سوق النّفاق",55,"ق",1,0],["فقلت بحمد ربي صرت وحدي","أعيش ولو بسجني مستقلا",56,"ل",2,0],["فقلت بهذا الشعر بؤسى وشقوتي","كما قتل الصداح زهر الخمائل",57,"ل",1,0],["فَقُلتُ بنظم تأريخي هنآء","لَقَد حظَيت باسمى الحسن اسما",58,"م",2,0],["فَقُلتُ بل انتَ وَالقَضاءُ","سيّانِ في قَتلة البشر",59,"ر",1,0],["فَقُلتُ باللَه هَل تعذُلنَ عاشقَهُ","فَقُلنَ كَيفَ وإِنّا من مُحبيِّهِ",60,"ي",2,0],["فقلتُ بربّكَ ماذا عسى","تقولُ ففسّر معاني النّشيد",61,"د",1,0],["فقلت بالدرة البيضا التي ملكت","قلبي ولبي واني لست ناسيها",62,"ي",3,0],["فقلت بئس الشعر من مطرب","قد مجّه طبعي واستفرغه",63,"غ",2,0],["فَقُلت بي أَغيدٌ يَجفو وَغانيةٌ","تَنأى وَمنكرُ أَحوالي وَمعترفُ",64,"ف",1,0],["فقلت بلادي حيثما الدين قائم","بكل منيب في الهواجر صوام",65,"م",1,0],["فقلت بقلبي لظى الوجد منك","فقالت وقلبي به مثلما",66,"م",2,0],["فقلت بنفسي حاجة ما قضيتها","على مثلها أنفاس وجدي تردد",67,"د",1,0],["فَقُلتُ بِالسَعدِ وَطولِ الهَنا","وَاليَمَنِ أَرخِنا زَواجَ الأَغَرِّ",68,"ر",1,0],["فقلت بلى لله درك هذه","أماني لا در جلته ثغور",69,"ر",1,0],["فقلت بيض مواضي الشيب قد سفكت","دم الشباب وهذا منه بعض دمي",70,"ي",1,0],["فَقُلتُ بَلى قَبِلتُ بكلّ شَيءٍ","أَمرت بهِ بحسن الإِتّباعِ",71,"ع",1,0],["فقل