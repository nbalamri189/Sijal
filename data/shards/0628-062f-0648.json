d=197097",""],[5664,"الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=46385",""],[5690,"لما أعاد مليكنا","https://www.poetsgate.com/ViewPoem.aspx?id=172280",""],[5720,"لأجلكَ أُستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=199596",""],[402,"وارحمتا لي من صروف زماني","https://www.poetsgate.com/ViewPoem.aspx?id=36540",""],[5790,"بات في أحناء صدري","https://www.poetsgate.com/ViewPoem.aspx?id=112055",""],[5790,"لا وعينيك ويكفى ذا القسم","https://www.poetsgate.com/ViewPoem.aspx?id=111869",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5823,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=59133",""],[5848,"ولد عمك علشانك تمشكل مع ولد خالك","https://www.poetsgate.com/ViewPoem.aspx?id=48990",""],[5851,"ضوء من خفايا الروح","https://www.poetsgate.com/ViewPoem.aspx?id=175293",""],[5853,"سجال مع ديك الجن","https://www.poetsgate.com/ViewPoem.aspx?id=188358",""],[5909,"تُعلّلني الأطيافُ منك ونظرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=210239",""],[5956,"بدون غروري","https://www.poetsgate.com/ViewPoem.aspx?id=184008",""],[5956,"العواطف أساس الصالحات وأساس الفن الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=192122",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[5956,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=193405",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5957,"وجدتُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=22601",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[6056,"السلامه من الله","https://www.poetsgate.com/ViewPoem.aspx?id=156702",""],[6120,"سُلْطَانَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=213477",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[520,"ثغر الهدى متبلج بسام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577634",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""],[6259,"أتلك حُدوجٌ أم نجوم سوائرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59384&r=&rc=32",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""]],"verses":[["بُدورٌ إِذا اِزدَحَمَت في الظَلا","مِ شَمَّرَ بُردَيهِ عَنها الدُجى",0,"ا",1,0],["بدوي مدّن الصحرا كما","الناس إلى الحشر النظاما",1,"م",2,0],["بُدورٌ لِسارٍ أو بُحورٌ لِسائِلٍ","فمَنْ تأتِ منْهُمْ تلْقَ أرْوَعَ بَدْرِيّا",2,"ي",2,0],["بَدَوَاتُ فِكْرٍ وَحْيُهُ","هَادٍ وَكَاتِبُهُ أَمِينُ",3,"ن",1,0],["بَدَوِيَّةٍ خَلاَّبَةٍ بِجَمَالِهَا","قُرِنَتْ حَصَانَتُهَا إِلَى الإِقْدَامِ",4,"م",1,0],["بدومةً فالبيِعِ الشارعات","مبدى أنيقاً وعيشاَ غريرا",5,"ر",2,0],["بَدَوتُ وَأَهلي حاضِرونَ لِأَنَّني","أَرى أَنَّ داراً لَستِ مِن أَهلِها قَفرُ",6,"ر",1,0],["بِدَولَةِ سَيفِ اللَهِ طُلنا عَلى الوَرى","وَفي عِزِّهِ صُلنا عَلى مَن تَجَبَّرا",7,"ر",2,0],["بدوا كلهم في حلة الورد ملبساً","فقال الورى هذا هو الأسد الورد",8,"د",1,0],["بدورٌ وكثبانٌ تُواصل بينها","غصونٌ رَوِيّات المُتون مَوَائس",9,"س",1,0],["بدوا وجحرتم ظالمين بني استِها","فبتُّم وفي الأستاه منكم كُسوعها",10,"ع",3,0],["بدؤكَ الحرَّ حَرَّضَ العَوْدَ منّا","وسماحِ الفتى عليه مُعين",11,"ن",1,0],["بَدَوِّيَةٌ إِن شِئتَ أَو حَضَرَِيَّةٌ","جَمَعَ الخُزامى نَشرُها وَالمَندَلا",12,"ل",2,0],["بدوا والركب في شوق إليه","يضئ لنا رُباها والجبالا",13,"ل",2,0],["بدورٌ أَكَنَّتْهَا خدورٌ يجُنُّها","جناحُ خُدارِيّ من الليلِ أفتَخُ",14,"خ",1,0],["بُدورٌ تَجلَّت للعِراقِ فأشرَقَت","وأوحشَ نادي الحُصنِ منها فأظلَما",15,"م",2,0],["بِدَولَةِ مَلكٍ يَغصِبُ اللَيثَ قُوتَهُ","وَيَقتُلُ مَن يَلقاهُ شِدَّةُ رُعبِهِ",16,"ب",2,0],["بُدورُ المُظلِماتِ إِذا أَنادَوا","وَأُسدُ الغابِ أَزعَلَها الرُكوبُ",17,"ب",1,0],["بُدورُ لَيلِ التَمامِ حُسناً","عينُ حُقوفٍ ظِباءُ ميثِ",18,"ث",1,0],["بدولةِ عبدِ اللَّهِ ذي العزِّ والتُّقَى","يُحبَّرُ في أدنَى مَقاماتهِ المَدْحُ",19,"ح",1,0],["بدُونِها ضَنّ عن أقارِبِهِ","كامِلُ عَبسٍ إذا الضِّرابُ فَأى",20,"ا",2,0],["بدوسر جاورت الفرات مكرماً","كأنك نجم في علو المنازل",21,"ل",1,0],["بدوٌ بكل نشزٍ وقاع","وحضرٌ في عامر البقاع",22,"ع",1,0],["بدوي أورق الصخر له","وجرى بالسلسبيل البلقع",23,"ع",1,0],["بدوارس الأطلال يُلحقُ أمَّهُ","ويرى أباه رابعَ الأهرام",24,"م",1,0],["بدور لسار أو بحور لسائل","فمن تلق منهم تلق أروع بدريا",25,"ي",2,0],["بدوأ تجفيف شطآن الأسى","كي يبيعوها ، كأكياس الطحين",26,"ن",1,0],["بدويّ مدّن الصحرا كما","علّم الناس إلى الحشر النظاما",27,"م",2,0],["بدوي مدّن الصحراء كما","علم الناس إلى الحشر النظاما",28,"م",2,0],["بدويَّ المُناحِ أرهفَ منه الحسَّ","جوٌّ مُشَعْشَعٌ غيرُ غائِم",29,"م",1,0],["بدوا وحَجرتم ظالمين بني استها","فبتُّمْ وفي الأستاه منكم كُسُوعُها",30,"ع",3,0],["بدولة لا يزاول المجد يشرطها","على الزمان فوافاه بما شرطا",31,"ط",2,0],["بدولة زين العابدين وصدقه","وبالباقر المعروف في كل عرفان",32,"ن",1,0],["بدور الدياجي والشموس إلى الضحى","سيوف المعادي للطواغ كوالحا",33,"ح",2,0],["بدولةِ سيفٍ نسلِ سلطان سيفنا","إمامِ الهدى أهل الندى والتكرُّمِ",34,"م",1,0],["بدولةِ سيفٍ ذي المعالي إمَامِنَا","سلالةِ سلطانِ بن سيف المؤيدِ",35,"د",1,0],["بدولة اليعربيّ إمامنا","سلالة سلطان بن سيف المؤيَّد",36,"د",1,0],["بِدَولَتِكَ اِزدادَ الزَمانُ نَضارَةً","فَلا بَرِحَت سِتراً عَلى الدَهرِ مُسبَلا",37,"ل",2,0],["بُدورٌ وَنورُ الشَمسِ أَجلى مِنَ البَدرِ","أَتانا بِدينِ الحَقِّ أَسبَغَ نِعمَةٍ",38,"ه",1,0],["بَدَونَ كأَنَّهُنَّ غَمامُ صَيفٍ","تَهَلَّلَ وَاكفَهَرَّ لَهُ صَبِيرُ",39,"ر",1,0],["بِدونِ قتالٍ آمنت يمنٌ وإذ","غَزا بتبوكَ الروم فرّوا وما فرّا",40,"ر",2,0],["بُدوءَ لَهُ مَعَ دينِهِ وَتَمامِهِ","حَلمٌ إِذا وُزِنَ الحُلومُ ثَقيلُ",41,"ل",1,0],["بَدوُ الإساءة حبٌّ كان عن زللٍ","وما لخلقٍ بردِّ الفائتات يَدُ",42,"د",1,1],["بدور سموا بيض الوجوه تهللوا","وللنقع وجه من دجى الليل اظلم",43,"م",1,0],["بَدَوِيّاتٍ إِذا حاضَرتَها","فاحَ عَرفُ الشيحِ مِن أَردانِها",44,"ن",3,0],["بَدَوِيَّةً حَضَرِيَّةً كَرُمَت مَنا","سِبُها إِذا اِنتَسَبَت عَنِ الإِقرافِ",45,"ف",1,0],["بَدَوِيَّةً حَضَرِيَّةً فَاِحكُم لَها","بِفَصاحَةِ البادي وَلُطفِ الحاضِرِ",46,"ر",1,0],["بَدَوِيّاتٍ وَلَم تُغ","ذَ بِأَلبانِ اللِقاحِ",47,"ح",1,0],["بُدورٌ بِدورِ الحان دارت كو