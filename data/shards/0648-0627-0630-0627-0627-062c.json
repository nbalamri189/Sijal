{"poems":[[55,"نزل المسيل وبات يشكو سيله","https://www.aldiwan.net/poem30691.html","الكامل"],[88,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[53,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[87,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[64,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[47,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[63,"قل للأمير الماجد السامى","https://www.aldiwan.net/poem51822.html","مجزوء الكامل"],[68,"لا يظنن معشري أن بعدي","https://www.aldiwan.net/poem41574.html","الخفيف"],[82,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[371,"يا من إذا ناديت في ظلم","https://www.aldiwan.net/poem17019.html","أحذ الكامل"],[409,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[572,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138232",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72344","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55962","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50018","المتدارك"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107002","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204463","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103522","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62911","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48285","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108026","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133270","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86363","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204294","الخفيف"],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[6093,"أتهجأ البسمات","https://www.poetsgate.com/ViewPoem.aspx?id=194335",""]],"verses":[["وَإِذا اِجتَمَعتَ عَلى مَعايِبَ جَمَّةٍ","فَتَنَحَّ جُهدَكَ عَن طَريقِ العايِبِ",0,"ب",1,0],["وَإِذا اِجتَوَتكَ مَحَلَّةٌ وَتَنَكَّرَت","لَكَ فَاِعدُها وَاِنزَح مَعَ النُزّاحِ",1,"ح",1,0],["وإذا أجَدَّ جوادُ قَوْمٍ في النَّدى","ومَزَحْتَ أنتَ فحسْبُنَا أنْ تمزحا",2,"ح",2,0],["وإذا اجتلى من مَدْحه","بِكراً فذلك يومُ عُرسه",3,"س",2,0],["وَإِذا أَجَرتَ فَأَنتَ بَيتُ اللَهِ لَم","يَدخُل عَلَيهِ المُستَجيرَ عَداءُ",4,"ا",2,0],["وإِذا أجلتَ يديكَ فوقَ مهارقٍ","فهُناك مسقطُ لؤلؤٍ وجُمانِ",5,"ن",1,0],["وَإِذا اجتَداهُ المُجتَدونَ فَإِنَّهُ","يَهَبُ العُلا في نَيلِهِ المَوهوبِ",6,"ب",1,0],["وَإذَا اجْتَنَى ثَمَرَ المَدِي","حِ سَقَاهُ مِنْ أَنْوَائِهِ",7,"ا",3,0],["وَإِذا أَجَّجوا الكِفاحَ رَأوني","تابِعاً في مَجالِها أَشياخي",8,"خ",2,0],["وإذا أجتُثّ أصلُ فرعٍ تَبَقّى","فيه ماءٌ من الحياةِ قليلُ",9,"ل",1,0],["وَإذَا أَجَدْتَ فَهْلُ مَرَامُكَ فوْقَ أَنْ","يَصِفُوكَ بِالإِتْقانِ وَالإبْدَاعِ",10,"ع",1,0],["وَإِذا اِجتَلَيتُ عُقودَ أَشطُرِهِ","ظَفِرَ الهَوى بِمَراشِفٍ لُعسِ",11,"س",1,0],["وإذا أجاب بلستُ أدري أقبلا","ضرباً له في وجهه وقفائه",12,"ا",3,0],["وإذا اجدبَ الزمانُ فما تلقاهُ","يوماً إلاّ خصيبَ الربع",13,"ع",1,0],["وإذا أجن الليل بات مُسامري","ومُحاورٍي وممثَّلاً بإزائي",14,"ي",1,0],["وإذا اجتليت قلائدا في جيدنا","فهو المقلدها لذاك الجيد",15,"د",1,0],["وإذا أجلت الطرف لم تر بيننا","لولي عهد الملك غير مريد",15,"د",1,0],["وإذا أجدبت خواطر قوم","فاحظ من خاطري بروض ندي",16,"ي",1,0],["وإذا أجدت بريشةٍ منك تو","لينى وتحبيني الدواء الشافي",17,"ف",2,0],["وإذا اجتهدت همّة وُجدت","أينما قصّدت بالفتى الحِيَلُ",18,"ل",1,0],["وإذا اجتث دوحةً فمهاةٌ","وإذا اجتث غصنها الميالا",19,"ل",2,0],["وإذا اجتَمعتَ وهم بمشهَدِ مَجلِسٍ","فَابدَر بإيرَادٍ وشُغلِ زَمَانِ",20,"ن",1,0],["واذا اجتمعتم في المجالس فالغو","والغوا اذا ما احتج بالقرآن",20,"ن",1,0],["واذا اجتبى النادي تخا","ل بصدره أرسى يلملم",21,"م",1,0],["وإذا أجزاء جسمي اجتمعت","بعد أن طافت جميع الكائنات",22,"ت",1,0],["وإذا أجفانه ومضت","كوميض البرق في مزنه",23,"ن",2,0],["واذا اجتيبتِ الدروعُ فما يل","بسُ الاَّ من الظبى سِربَالا",24,"ل",2,0],["وإذا أجَلْتَ الخيْلَ خلّفَتِ العِدَى","صرْعَى ونصْرُ اللهِ لم يتخلّفِ",25,"ف",1,0],["وإذا أجدت فما عساني آتياً","مما أتيتَ جرائد الأخبار",26,"ر",1,0],["وإذا اجتداك من البرية مجتد","أذهبت عنه وضمة البأساء",27,"ا",2,0],["وَإِذا أَجالَ بَها اِمرُءُ نَظَراً","كادَت بَمَرأى اللَحظُ تَختَلِجُ",28,"ج",1,0],["وإذا اجتاز في السطوح فمن قب","ل قبوع الجرذان منه قبوعي",29,"ع",2,0],["وإذا اجتهدت أريد أولها","حارت رؤاي فكلها أُوَلُ",30,"ل",1,0],["وإذا أجَلْتَ العينَ في تكوينها","سترى بَديعَ الزَّهْرِ والثَّمراتِ",31,"ت",1,0]]}