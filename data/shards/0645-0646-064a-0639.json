ttps://www.poetsgate.com/ViewPoem.aspx?id=164613",""],[5702,"مرثية حنان","https://www.poetsgate.com/ViewPoem.aspx?id=116712",""],[5736,"حياك بياك","https://www.poetsgate.com/ViewPoem.aspx?id=208434",""],[5736,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=214133",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5829,"بالعشقِ أغراني","https://www.poetsgate.com/ViewPoem.aspx?id=214655",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5956,"الوعود البلفورية","https://www.poetsgate.com/ViewPoem.aspx?id=192302",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[6115,"ماكل من ينتخي ويقال له ونعم","https://www.poetsgate.com/ViewPoem.aspx?id=180487",""],[6115,"زلة الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180512",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6213,"نبراس أمتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76308&r=&rc=56",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[2220,"علمي بالرحمنِ لا يثبتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11793&r=&rc=663",""],[2220,"إنَّ لنا في سبأ آية ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11357&r=&rc=231",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["مَن يَعشَقُ العِزَّ لا يَعنو لِغانِيَةٍ","في رَونَقِ الصَفوِ ما يُغني عَنِ الكَدَرِ",0,"ر",1,0],["مَنيعُ الحِمَى لا يَخْتِلُ الذِئبُ سَرْحَهُ","ومنْ شِيَمِ السِّرْحانِ خَتْلٌ وعُدْوانُ",1,"ن",1,0],["مُنّي عَلَيَّ وَاِرحَمي","يا بِأَبي يا بِأَبي",2,"ب",2,0],["مُنّي عَلى مَن شَفَّهُ","حُبُّكُمُ وَاِحتَسِبي",2,"ب",2,0],["مِنّي عَلى دارِ السَلامِ تَحِيَّةٌ","وَعَلى الخَليفَةِ مِن بَني عُثمانِ",3,"ن",1,0],["مَنْ يَعْبُدُ الشَّمْسَ المُنِي","رَةَ هُلْ يُلامُ عَلَى افْتِنَانِ",4,"ن",1,0],["مَنْ يُعَاوِنُهُ بِالْحُطَامِ يُحَقِّقْ","فِي غَدٍ قَدْرَ مَا أَفَادَ الْحُطَامُ",5,"م",1,0],["مَنْ يُعَاطِي السُّمَّارِ بَعْدَكَ مَا كُنْ","تَ تُعَاطِي مِنْ سِرِّ بِنْتِ الْكُرُومِ",6,"م",1,0],["منّي عليَّ حجاب لست أرفعُه","إلا بتوفيق هَدْي منك ترضاهُ",7,"ا",2,0],["مَن يُعطِهِ اللَهُ مِنكُم يُعطَ نافِلَةً","وَيُحرَمِ اليَومَ مِنكُم فَهوَ مَحرومُ",8,"م",1,0],["من يَعمْ في بحار همِّي يظهر","زَبدٌ فوقَ فَرعهِ الغربيب",9,"ب",1,0],["مني عليكن السلام تحية","إن الشباب هراقَه مُهريق",10,"ق",1,0],["منيعِ الجَدا لو يُسألُ النِقْرَ لم يَكُن","لتأخُذَهُ في البُخْلِ لومةُ لائمِ",11,"م",1,0],["مَن يَعرِفُ الشَمسَ لا يُنكِر مَطالِعَها","أَو يُبصِرُ الخَيلَ لا يَستَكرِمِ الرَمَكا",12,"ك",2,0],["منيع النواحي محكم الرأس حابس","لما فيه من ريح الهواء تحصّنا",13,"ن",2,0],["مَن يَعتَفي العافي بِهِمَّتِهِ وَمَن","يَأوي إِلَيهِ المُعتِمُ المُعتامُ",14,"م",1,0],["مَنيعٍ بَنو سُفيانَ تَحتَ لِوائِهِ","إِذا ثَوَّبَ الداعي وَجاءَت حَلائِبُه",15,"ب",2,0],["مَنْ يَعْرِفِ اللَهَ يَعْرِفْ أوَّلِيَّةَ ذَا","فَالدِّينُ مِنْ بَيْتِ هَذَا نَالَهُ الاُمَمُ",16,"م",1,0],["مَن يَعِش يَكبَر وَمَن يَكبَر يَمُت","وَالمَنايا لا تُبالي ما أَتَت",17,"ت",1,1],["مَنيعُ يَقيني ضَيمُ كُلِّ غَضَنفَرٍ","طَويلِ نِجادِ السَيفِ ماضي العَزائِمِ",18,"م",1,0],["من يعاليلَ كبيضٍ وُضِعَتْ","في اشتباكِ الماءِ من فوقِ زَرَد",19,"د",1,0],["مَن يَعشُ ضَوءَ الآلِ يَعلَم أَنَّهُم","مَلَأٌ لَدى مَلَإِ السَماءِ مَكينُ",20,"ن",1,0],["مَنيعُ نَواحي السِرِّ فيهِ حَصينُها","إِذا صارَتِ النَجوى المُذالَةَ مَحفِلا",21,"ل",2,0],["من يَعصِمُ الأقطارَ من دَيّانِها","ويَرُدُّ غارتَهُ عنِ الأقوامِ",22,"م",1,0],["مَنيعَ الحِمَى لا يُسلِمُ الدّهرَ عِرضَهُ","إذا أسلم العِرضَ الذّليلُ المُطاوعُ",23,"ع",1,0],["مُنّي عَلَيَّ وَلَو بِطَيفٍ طارِقٍ","ما قَلَّ يَكثُرُ مِن نَوالِ ضَنينِ",24,"ن",1,0],["من يعرُبَ الأكرمين في نسب","يشارك الشمسَ في منازلها",25,"ل",3,0],["مَن يُعطِهِ دِرهَماً يَنكِح خَليلَتَهُ","وَنائِكٌ في اِستِ رَبِّ البَيتِ مُرتادا",26,"د",2,0],["مَن يُعطَ شَيئاً يُستَلَبهُ وَمَن يَنَم","جِنحَ الظَلامِ فَإِنَّهُ سَيُؤَرَّقُ",27,"ق",1,0],["مَن يَعرِفِ الدُنيا يَهُن عِندَهُ","إِمراعُها الدَهرَ وَإِمحالُها",28,"ل",3,1],["مِن يَعابيبَ ذُكورٍ وُقُحٍ","وَهِضَبّاتٍ إِذا اِبتَلَّ العُذُر",29,"ر",1,0],["منيع الحمى ورد إذا قام أو مشى","بأكناف ترج لم ترمرم أسودها",30,"د",3,0],["من يعش يمش وَالحياة طَريق","في وهاد كَثيرة وَتلاع",31,"ع",1,0],["منْ يُعَزي عَنْهُ المُرُوءَةَ أَمْسَتْ","وَبَنُوهَا الأبْرَارُ غَيْرُ عِدَادِ",32,"د",1,0],["مَنْ يُعَزِّي عَنْهُ الوَفَاءَ وَقَدْكَا","نَ يَرَى نَقْضَهُ مِنَ الإِلحَادِ",32,"د",1,0],["مَنْ يُعَزِّي عَنْهُ الصَّرَاحَةَ كَانَ ال","غُرْمُ فِيهَا وَالغُنْمُ فِي الإِهْمَادِ",32,"د",1,0],["مَنْ يُعَزِّي القُصَّادَ عِلْماً تَوَخَّوْا","أَوْ نَوَالاً عَنْ مُسْعِف القُصَّادِ",32,"د",1,0],["مَنْ يُعَزِّي كِنَانَةَ اللهِ عَنْ رَا","مِي عِدَاهَا بِسَهْمِهِ المِصْرَادِ",32,"د",1,0],["مَنْ يَعْدِلُ الشَّيْخَ الرَّئيسَ مُرُوءَةً","إِنْ ذَادَ ضُرّاً أَوْ أَقالَ عِثْارَا",33,"ر",2,0],["مَنْ يَعْدِلُ الشَّيْخَ الرئيسَ ثَقَافَة","وَكِتَابَة وَخَطَابَةً وَحِوَارَا",33,"ر",2,0],["مَنْ يَعِشْ عَْشَ مَا جِدٍ","نَهْدُهُ بَعْدَهُ وَضَحْ",34,"ح",1,0],["مَنْ يُعمر يجد أخلاّءَهُ في الأر","ضِ أوفَى مِمَّن عليها وأحنَى",35,"ن",2,0],["منِّي على فتنامَ ألفُ تحيَّة","حَيُّوا معي الشعبَ الذي بَهَرَ الورى",36,"ر",2,0],["من يعطه الله فيها نفسه كرهت","صبرا فما كرهت بالخير مشتمل",37,"ل",1,0],["مَنْ يعشْ يكبرْ ومنْ يكبَرْ يمُتْ","والمَنايا لا تُبالي مَنْ أتَتْ",38,"ت",1,1],["من يعي يسأله: أين أنا؟","ضاع قدّامي، كما ضاع ورائي",39,"ا",2,0],["من يعيد الشجو للأحزان ؟ من","يمنح التسهيد أوجاع الصبابة ؟",40,"ب",2,0],["من يعرف ( التهرين ) ؟ من","أين الطريق إلى ( القزالي )( 2 )",41,"ل",2,0],["مني عليك تحيةٌ وسلامُ","ولذكرِك الإجلالُ والإِعظام",42,"م",1,0],["من يعرف … (النهرين) ؟ .. من أين الطريق إلى (القزالي)","من ذا هناك ؟ مسافر مثلي يعاني مثل حالي",43,"ل",2,0],["من يعيد الشجر للأحزان ؟ من","يمنح التسهيد أوجاع الصبابه ؟",44,"ب",2,0],["من يعاف المدام مِن غَير مَزج","شرب الهَم فيكَ وَالحُزن صرفا",45,"ف",2,0],["من يعزى الأنامَ كيف يعزَّى","وهْو قد صار في الأمورِ حَكيمَا",46,"م",2,0],["من يُعَمَّرْ فيها بَزدْ منها أُوَام","عفوكَ اللهمَّ يا ربَّ الأنام",47,"م",1,0],["مَن يَعدُلِ الصَّبَّ في إجرَاءِ أدمعِهِ","يَومَ النَّوَى لم يَجِد بعضَ الذي يَجِدُ",48,"د",1,0],["من يعرفِ الرحمنَ حقاً يعترف","بحقوقهِ لخليفةِ الرحمنِ",49,"ن",1,0],["من يعشق العلياءَ يلقَ عندها","ما لقىَ المحبُّ من أحبابه",50,"ب",2,0],["مَنيعَ الحِمى تَضفو عَلَيكَ مَلابِسٌ","لِأَذيالِها فَوقَ السَماءِ مَساحِبُ",51,"ب",1,0],["مَنيعُ الجَنابِ إِذا الدَهرُ صالَ","سَريعُ الجَوابِ إِذا السَيفُ صَلّ",52,"ل",1,0],["مَن يَعُدُّ الإيجازَ فَضلاً فَإِنّي","في مَديحيكَ أَعشَقُ التَطويلا",53,"ل",2,0],["مَنيعٌ جارُهُ إِن حَلَّ أَرضاً","جَلا الإِظلامَ عَنها وَالظَلاما",54,"م",2,0],["مَنيعُ حِمى المَعروفِ طالِبُ رِفدِهِ","يُمارِسُ لَيثاً أَو يُلامِسُ شَيهَما",55,"م",2,0],["من يعط كنز رضاك يغن ويغنم","ويجل قدرا في العيون ويعظم",56,"م",1,1],["مُنّي عَلَيَّ بِراحَةٍ مِن مُهجَةٍ","فَالمَوتُ أَيسَرُ مِن عَذابٍ داِئمِ",57,"م",1,1],["مَنيعُ الحِمى لا يَذعَرُ القَومُ سَرحَهُ","وَلا تُتَّقى غاراتُهُ بِالمَآلِكِ",58,"ك",1,0],["مَنيعُ الحِمى لا يُذعِرُ القَومُ سَرحَهُ","وَلا يَمنَعُ الأَعداءُ شَيئاً يُحاوِلُه",59,"ل",2,0],["منِيعُ نواحي السرّ لا يُسْخِط النَّدى","أغرُّ كَريْعان الضُّحى المتبلِّج",60,"ج",1,0],["مَن يُعَزِّي الجيادَ أم من يُسَلَّى","مجلسَ الملك والسّريرَ الكئيبا",61,"ب",2,0],["مِنِّي عَلَى جَدِّهِ الْمُخْتَارِ مِنْ مُضَرٍ","أَزْكَى صَلاَةٍ يَوَدُّ الْمِسْكُ يَفْدِيهَا",62,"ي",3,0],["منيعا عن الأعدا سريعا إلى الندى","رفيعا من العليا مريع المعالم",63,"م",1,0],["من يُعطِ لا يوهَب ومن يمنَع يَنَل","كن مؤمناً بالله واشبع دِينا",64,"ن",2,0],["مني عليك سَلام اللَه ما سجعت","وَرق الحمى وَثني روح الصبا غصنا",65,"ن",2,0],["مني عليك صَلاة اللَه دائمة","تنمى فَتَستَغرق الاعصار وَالحقبا",66,"ب",2,0],["مني عليه تحيات مباركة","تنمى فَتَستَغرِق الآصال وَالبكرا",67,"ر",2,0],["مُنِّي عَلَيَّ بِرَشْفَةٍ تَشْفي الصَّدَى","إنَّ الصَّدَى يَشْفِيهِ رَشْفُ لَمَاكِ",68,"ك",1,0],["مَنْ يَعْتَبِر يَدلُله في الدُّنيا عَلى","حَشْرِ القِيامة جَمْعُها المَحْشورُ",69,"ر",1,0],["مَن يَعتلق حبلَ عهدٍ منهم فله","عندَ المهيمنِ عهدٌ ليس ينصرمُ",70,"م",1,0],["مَن يُعاديكَ وَالوَفا فيكَ طَبعُ","وَأَياديكَ مِن قِفا نَبكِ أَشهُرُ",71,"ر",1,0],["مَن يَعلُهُ الشَيبُ لَم يُحدِث لَهُ عِظَةً","فَذاكَ مِن سوسِهِ الإِفراطُ وَالعُنُفُ",72,"ف",1,0],["مَنْ يُعاني أمراً يُعانُ عليه","كم مُعانٍ للأمر غيرِ مُعان",73,"ن",1,0],["من يَعدَم العلمَ يُظلِمْ عقلُهُ أبداً","حتى تراه شبيهَ الحال في النَعَم",74,"م",1,0],["من يعرف اللَه بارينا وقدرتَه","وخسةَ البشر المخلوق مذ قُمِطا",75,"ط",2,0],["مُنِّي علي بلفتةٍ","كيلا ألامَ فَأُذنبا",76,"ب",2,0],["من يعادي لهم حاربه من كون الكون","كل من حبهم منهم يعد إذ يعدون",77,"ن",1,0],["من يعمر الدنيا فقير مقمور","وعامر الأخرى غني مغمور",78,"ر",1,1],["مني عبد الشمس المنيرة","هل يلام على افتتان",79,"ن",1,0],["من يعشق الصيد هو اليقظانُ","وتارك الصيد هو الكسلانُ",80,"ن",1,0],["منيع الذُرى بَشّ الأسرةِ ناعم","نبسّم عن عذب الغروبين مشرق",81,"ق",1,0],["من يعشق السلم حر شامخ بطل","وعاشق الحرب رغم الزهو رعديد",82,"د",1,0],["منيعٌ ولكنه بالعفا","ة مستطرَق أبداً سائلُ",83,"ل",1,0],["من يَعلُ عزُّ نفسه يَعلُ ومن","يَعلُ على حكم الزمان يسفُلِ",84,"ل",1,0],["منيعُ الحمى لو ساور الموتُ جارهُ","لردَّ المنايا الحمرَ تنبو نصالُها",85,"ل",3,0],["منيع الحمى والعِرض بالبأس والندى","بَذولُ سَنايا الأعطياتِ وَهوبُها",86,"ب",3,0],["منيعُ الحِمى لا يُسْتباح نزيلهُ","ولو أسلمَتْهُ للحِمامِ العشائِرُ",87,"ر",1,0],["مَنيعُ الجارِ ناصِرُهُ","مُباحُ الجودِ باذِلُهُ",88,"ل",2,0],["مُنّي عَلى عانٍ أَطَلتِ عَناءَهُ","في الغُلِّ عِندَكِ والعُناةُ تُسَرَّحُ",89,"ح",1,0],["من يعرب العرباء حيث التقت","شعائب السؤدد من يعرب",90,"ب",1,0],["مَن يَعتَمِدكَ ابنَ عَبدِ اللَهِ مُجتَدياً","لِسَيبِ عَرفِكَ يَعمَد خَيرَ مَعمودِ",91,"د",1,0],["مَن يُعير الصّديقَ رأياً إذا ما","سلّه في الخطوب كان حساما",92,"م",2,0],["مِن يَعْمَلاتٍ ما وردن عن هوىً","ولم تَبِتْ مِن شلّها على وَجَلْ",93,"ل",1,0],["مَن يعشقُ الظّلمَ فما عنده","لعاشقٍ شيءٌ من النَّصْفِ",94,"ف",1,0],["من يعرف الله فذاك الذي","يعرفهم قاموا بأسمائه",95,"ا",3,0],["من يعرف الله فليس يسألُ","والله 