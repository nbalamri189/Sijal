{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[63,"الناس من خولي والدهر من خدمي","https://www.aldiwan.net/poem45927.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[93,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[93,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[93,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"وفارس أجبن من صفرد","https://www.aldiwan.net/poem62889.html","الطويل"],[51,"إن كنت صفعانا ولي ضيعة","https://www.aldiwan.net/poem65385.html","السريع"],[51,"لنا صديق كلا صديق","https://www.aldiwan.net/poem66443.html","مخلع البسيط"],[51,"من يكن يكرم اللئام فقد أضحوا","https://www.aldiwan.net/poem66495.html","الخفيف"],[70,"أحبابنا وحياتكم","https://www.aldiwan.net/poem42442.html","مجزوء الكامل"],[78,"مولاي أشكو إليك داء","https://www.aldiwan.net/poem14151.html","مخلع البسيط"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[45,"هو الظلام فلا صبح ولا شفق","https://www.aldiwan.net/poem65179.html","البسيط"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[61,"رفق الزمان بنا وكان عنيفا","https://www.aldiwan.net/poem51543.html","الكامل"],[61,"فلقد حدا برق الغليل","https://www.aldiwan.net/poem51762.html","مجزوء الكامل"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[58,"لو صيغ من فضة نفس على قدر","https://www.aldiwan.net/poem31142.html","البسيط"],[66,"عين حبي أعيذها بالله","https://www.aldiwan.net/poem39639.html","الخفيف"],[66,"لو صرت من سقمي شبيه سواك","https://www.aldiwan.net/poem39929.html","الكامل"],[44,"لو صحح الدمع لي أو ناصح الكمد","https://www.aldiwan.net/poem30314.html","البسيط"],[69,"لو كنت تدري ما لقيت من الهوى","https://www.aldiwan.net/poem28550.html","الكامل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"عقرب السوء تمادى في الأذى","https://www.aldiwan.net/poem44060.html","الرمل"],[81,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[46,"ما غاب اسحاق البرايا عنهم","https://www.aldiwan.net/poem23044.html","الكامل"],[46,"لو صح ماقال رسطاليس من قدم","https://www.aldiwan.net/poem23069.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[82,"في رثاء الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=1468",""],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"لو صادت البقَّة ُ فيلَ الزَّنْجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27244",""],[127,"عزّ التأسّي وفاض الدمع هتانا","https://www.aldiwan.net/poem792.html",""],[129,"يا بتعة فاقت ببهجتها","https://www.aldiwan.net/poem50579.html","مجزوء الكامل"],[129,"أنا بحر هجو إن أردت جفائي","https://www.aldiwan.net/poem50677.html","الكامل"],[135,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[156,"لطمت بعناب البنان شقائق","https://www.aldiwan.net/poem55730.html","الكامل"],[161,"الحمد للّه رب العالمين على","https://www.aldiwan.net/poem58891.html","الكامل"],[187,"حسبي من التريبات والحشم","https://www.aldiwan.net/poem43276.html","المنسرح"],[200,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[212,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[223,"لوصفك ينتمي كلمي","https://www.aldiwan.net/poem55424.html","مجزوء الوافر"],[230,"قل للأمير ابن الإمام الذي","https://www.aldiwan.net/poem50756.html","السريع"],[230,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[230,"لو صد خوف عين رقيبه","https://www.aldiwan.net/poem51207.html","الكامل"],[233,"عذرا فقلبي ما عليه اعتذار","https://www.aldiwan.net/poem14839.html","السريع"],[272,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[299,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[410,"لو صبرنا على البلاء احتسابا","https://www.aldiwan.net/poem32055.html","الخفيف"],[417,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[417,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[430,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[433,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[433,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[438,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[459,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[459,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[465,"هذا العقيق تلك أعلام الحمى","https://www.aldiwan.net/poem3211.html","عموديه"],[465,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[501,"سر واترك العيس على حالها","https://www.aldiwan.net/poem37551.html","السريع"],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[506,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[516,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[516,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"]],"verses":[["لَو صَحَّ أَنَّ البَينَ يَعشَقُهُ","ما اِستَعبَرَت في السَيرِ أَينُقُهُ",0,"ق",2,1],["لَوْ صِيَغتِ الأَرْضُ لي دُونَ الوَرى ذَهَباً","لَمْ تَرْضَها لِمُرَجِّي نائِلي هِمَمِي",1,"م",2,0],["لَو صَدَقَتهُ ما تَقولُ وَلا","كِنَّ عِداتٍ دونَهُنَّ عِلَل",2,"ل",1,0],["لَو صَحَّ في هَذا الوُجودِ تَناسُخٌ","لَرَأَيتُ فيكَ تَناسُخَ الأَرواحِ",3,"ح",1,0],["لو صوروا شخص الكمال لكنته","وبحسن فعلك حسنه مزداد",4,"د",1,0],["لو صنعوا ما صنعت أو بع","ضه لسدنا في العالمينا",5,"ن",2,0],["لَوْ صَوَّرَ الحِسُّ مَعْنَاهَا لِنَاظِرِهَا","تَكَشَّفُ النَّفْسُ فِيهَا عَنْ دَمٍ قَانِ",6,"ن",1,0],["لَوْ صَنَعُوا مَا صَنَعْتَ أَوْ بَعْضَ","هُ لَسُدْنَا المُسَوَّدِينَا",7,"ن",2,0],["لو صافح الكفَّ الخضيبَ بكفه","فخرت بنهر للمجرة جاري",8,"ر",2,0],["لو صوَّر الشام شخصاً كنت صاحبه","وجامع الشام وجهاً كنت ناظره",9,"ر",2,0],["لو صحا ودَّ أن عمركُم المم","دود فيه وعُمرَهُ المسْحوتُ",10,"ت",1,0],["لو صاح في الليل به صائحٌ","لكانت الأرض له طفرَهْ",11,"ر",2,0],["لو صح ما قلت لكان الغنى","يضر والفقر الذي ينفع",12,"ع",1,0],["لو صَحَّ عندي له اعتقادٌ","ما دِنتُ ربي بما يدينُ",13,"ن",1,0],["لو صفا عيشها فأسعد حيّاً","لكمالٍ وحكمةٍ وبيان",14,"ن",1,0],["لَو صَحَّ وُدُّكَ صَحَّ ظَنُّ","كَ بي وَبانَ لَكَ اليَقينُ",15,"ن",1,0],["لَو صَوَّر اللَهُ لِلمَعالي","جسماً لأصبَحتَ فيهِ روحا",16,"ح",2,0],["لو صين دستور البلا","د لما تعدّى من تعدّى",17,"د",2,0],["لَو صادَفَ الدَهرَ يَبغي نَقلَةً فَرَمى","بِعَزمِهِ في رِحالِ الدَهرِ لَم يَرِمِ",18,"م",1,0],["لَو صُوِّرَ الشَرقُ إِنساناً أَخا كَرَمٍ","لَكُنتُمُ الروحَ وَالأَقوامُ جُثمانا",19,"ن",2,0],["لَو صافَحوا المُزنَ ما اِبتَلَّت أَكُفُّهُمُ","وَلَو يَخوضونَ بَحرَ الصينِ ما غَرِقوا",20,"ق",3,0],["لَو صَفَرنا عَبَّ في الماءِ وَلَو","مَرَّ مُجتازاً عَلى الأُتنِ نَهَق",21,"ق",1,0],["لو صَافَحَتْ سَمْعَ ابنِ أوْسٍ لم يَقُلْ","أطلالُهُم سَلَبَتْ دماها الهِيفا",22,"ف",2,0],["لو صافحَتْ سَمَعَ المُحِبْ","بِ لأذهلْتهُ عن الحبيبِ",23,"ب",1,0],["لو صافَحَت سَمْعَ الوليدِ جَثَا لَها","أرسومُ دارٍ أم سُطورُ كتابِ",24,"ب",1,0],["لَو صِيغَ مِن فِضَّةٍ نَفسٌ عَلى قَدرِ","لَعادَ مِن فَضلِهِ لَمّا صَفا ذَهَبا",25,"ب",2,1],["لَو صِرتُ مِنَ السَقامِ في زِيِّ سِواك","لا أَعشَقُ دونَ سائِرِالخَلقِ سِواك",26,"ك",1,0],["لَو صِرتُ مِن سَقَمي شَبيهَ سِواكِ","ما اِختَرتُ مِن دونِ الأَنامِ سِواكِ",27,"ك",1,1],["لَو صَحَّحَ الدَمعُ لي أَو ناصَحَ الكَمَدُ","لَقَلَّما صَحِباني الروحُ وَالجَسَدُ",28,"د",1,1],["لوصلْتَ وصلي واقتطعْتَ قطيعتي","وهجرْتَ هجري واجتنبتَ تجنُّبي",29,"ي",1,0],["لو صدقنا للعوادي مِثلهم","ما ارتضينا العيشَ من زُورٍ ومَيْنْ",30,"ن",1,0],["لو صدقتَ اللَّهَ في دينِ الهدى","فُزْتَ منه بالذمامِ الأقربِ",31,"ب",1,0],["لَو صُوِّرَ الإِسلامُ شَخصاً جاءَكُم","عَمداً بِنَفسِ الوامِقِ المُتَحَيِّرِ",32,"ر",1,0],["لِوِصالِ أُخرى قَد سَلَوتُ سُلُوَّها","فَأَبَت بَناتُ فُؤادِيَ المُرتاحِ",33,"ح",1,0],["لَو صَحَّ أَنَّ البَدرَ لَيسَ بِعاقِلٍ","هَنَّأتُهُ أَلّا يُحِسَّ مُحاقا",34,"ق",2,0],["لَو صَحَّ ماقالَ رَسطاليسُ مِن قِدَمٍ","وَهَبَّ مَن ماتَ لَم يَجمَعُهُمُ الفَلَكُ",35,"ك",1,1],["لو صانع الإمامُ أو تأنَّى","ما بلغ الشاميُّ ما تمنَّى",36,"ن",2,0],["لوْ صوَّرَ فِي جِسْم مرِئٍ مَلكاً","لَصَوَّرَ المَلَكَ الإِنْسِيَّ فِي آسِ",37,"س",1,0],["لو صوروا اللؤم الذميم فمثلوا","ذاك الفتى عدّوا من الحذاق",38,"ق",1,0],["لو صُبَّتِ الأَمْطَارُ صَبّاً فَوْقَهم","ما مَسَّ مَوْطِىءَ نَعْلِهم أَمْطارُ",39,"ر",1,0],["لو صبَّ منه قطرة في جدول","لتجمَّد الآذيُّ، بل لتحجرا",40,"ر",2,0],["لو صُغْتُ كُلَّ مشاعري","شَكَت المحابِرُ، والدفاتر",41,"ر",1,0],["لو صارَ ما كانَ من مُلكٍ ومن مَلكٍ","كما حَكى عن خوالي الطيف وسنانُ",42,"ن",1,0],["لو صعّد القصب الولهان زفرته","لنوّرت بيده واخضلّ واديه",43,"ي",2,0],["لو صادت البقَّة ُ فيلَ الزَّنْجِ","وهملجَ البُرْغُوث تحت السَّرْج",44,"ج",1,1],["لو صادف الماء من همّي ومن هممي","شيّاً لأشعل وسط الماء نيرانا",45,"ن",2,0],["لو صُوِّرتْ شخصاً لكا","نتْ سيداً حُلْوَ الطباعِ",46,"ع",1,0],["لو صادَمَتْ صُمَّ الرَّواسي سطوتي","لَكَبَتْ أعاليها عَلَى الغَبْرَاءِ",47,"ا",2,0],["لَو صُدِقوا ضَرباً خِلالَ بُيوتِهِم","لَكُنّا أُسىً عِندَ النِساءِ المَطافِلِ",48,"ل",1,0],["لَوْ صُيِّرَتْ شَمْعاً عَلَيْكَ أَنامِلي","مَا آلَمَتْني فيكَ بِالْوَقْدِ",49,"د",1,0],["لو صحَّ ما قيل من إفراط ما سمحتْ","بهِ المقاديَرُ في تخفيف ما نقلا",50,"ل",2,0],["لو صحّ عقلي لما رضيت بأن","أختار من صحّتي ضنى سقمي",51,"م",2,0],["لو صوَّرها لكانت صورة امرأة","مصبوغة من جهالات بأَلوان",52,"ن",1,0],["لو صح عندك أنى من أهيم به","لطرت تنشد صفحي ثم غفراني",53,"ن",2,0],["لوصفك ينتمي كلمي","ويطرب في يدي قلمي",54,"م",2,1],["لو صُوِّرتْ أفعالُك الغُرُّ ما","أصبحنَ إلاّ أوْجُهاً لِلحسانْ",55,"ن",1,0],["لو صوّرت خَلْقَها إرادتُها","ما قدَّرته كمثل ما قُدِرا",56,"ر",2,0],["لو صدّ خوفَ عين رقيبِهِ","هانت عليّ بذاك شِدّةُ صَعْبِهِ",57,"ه",1,1],["لَو صالَ بِاللَحظِ عَلى حَيدَرٍ","ما حَمَلَت راحَتُهُ ذا الفِقار",58,"ر",1,0],["لَو صور الخلق من قول ومن كلم","لكان معنى لمعنى القول وَالكلم",59,"م",1,0],["لو صببتَ الماءَ ما بينهما","لم يكدْ يخلُصُ من فرطِ اعتلاقْ",60,"ق",1,0],["لو صَبَرنا على البلاءِ احتساباً","لرَجونا عنه جزيلَ الثّوابِ",61,"ب",1,1],["لو صُوِّر المجد تصويراً على رجلٍ","ما كانَ إلاّكَ أوصافاً وتصويرا",62,"ر",2,0],["لو صغى للعذول ما كانَ أَمسى","دنفاً في شؤونه يتردَّى",63,"د",2,0],["لو صحا الدهر من سلافة جودٍ","شقَّ أطواقه بكىً وندامه",64,"م",2,0],["لو صابك بعض من شجني","أو بعض غرامي لم تقم",65,"م",1,0],["لو صُوِّرَ الدَّهْرُ لأَضْحَى تاجَهُ","وأَصبَحَتْ كِرامُهُ خلاخلا",66,"ل",2,0],["لو صال سيفٌ على سيف بن ذي يزَنٍ","لفلّ أشفارَهُ في غِمْدِ غَمْدان",67,"ن",1,0],["لو صوّروا جسماً جميعَ الناسِ","لكانَ هذا لهمُ كالرّاسِ",68,"س",1,0],["لو صافح الصخر الأصمّ كفّهُ","لا تنبحس الصخر بماء ودفق",69,"ق",1,0],["لو صادني بالغنَى مُنيلٌ","لصادني بالهوى الغواني",70,"ن",2,0],["لو صُبِغتْ بالبكاء ناصلةٌ","دام شبابي مما بكيتُ دما",71,"م",2,0],["لو صحتَ تُسمعهم وصوتُك في الثرى","فحصوا عليك وفي السماء لطاروا",72,"ر",3,0],["لو صيغت الأيّامُ من أخلاقه","لم يعترضْها كَدرٌ ولا نَكَدْ",73,"د",1,0],["لو صافح الرمضاء باطنُ كفهِ","ظهراً لبُدلَ بالربيع المُبْقلِ",74,"ل",1,0],["لو صح لي من يوم وصلك مطلب","ما كنت من صبري لهجرك معدما",75,"م",2,0],["لو صافحت كفّاهُ يبساً ذاوياً","لأفاض مدَّ الجودِ من جلموده",76,"د",2,0],["لو صورتها بد الرسام وارتسمت","للناظرين عرفت المنظر البشعا",77,"ع",2,0],["لو صحت والشوق بها عابث","شبَّت إلى الجوِّ وهبَّت بنار",78,"ر",1,0],["لو صادَفَ الجِبالَ بعضُ زَفْرَتي","لانْفَلَقَتْ وأَصبَحَتْ تَصَدَّعُ",79,"ع",1,0],["لو صارَ ذا الكلبُ في ثراءٍ","في قصرهِ غيْرَ مستباحِ",80,"ح",1,0],["لو صَبا نجدٍ تلتْ في مدحِه","بَيتَ شِعرٍ لحكى العود غضاها",81,"ا",3,0],["لو صورت شيم الملوك حكاية","كنت المعبر عنه بالمقصود",82,"د",1,0],["لو صبحت اسكندراً","ما أفلح الإسكندر",83,"ر",1,0]]}