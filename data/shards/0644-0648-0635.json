{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[63,"الناس من خولي والدهر من خدمي","https://www.aldiwan.net/poem45927.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[93,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[93,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[93,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"وفارس أجبن من صفرد","https://www.aldiwan.net/poem62889.html","الطويل"],[51,"إن كنت صفعانا ولي ضيعة","https://www.aldiwan.net/poem65385.html","السريع"],[51,"لنا صديق كلا صديق","https://www.aldiwan.net/poem66443.html","مخلع البسيط"],[51,"من يكن يكرم اللئام فقد أضحوا","https://www.aldiwan.net/poem66495.html","الخفيف"],[70,"أحبابنا وحياتكم","https://www.aldiwan.net/poem42442.html","مجزوء الكامل"],[78,"مولاي أشكو إليك داء","https://www.aldiwan.net/poem14151.html","مخلع البسيط"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[45,"هو الظلام فلا صبح ولا شفق","https://www.aldiwan.net/poem65179.html","البسيط"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[61,"رفق الزمان بنا وكان عنيفا","https://www.aldiwan.net/poem51543.html","الكامل"],[61,"فلقد حدا برق الغليل","https://www.aldiwan.net/poem51762.html","مجزوء الكامل"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[58,"لو صيغ من فضة نفس على قدر","https://www.aldiwan.net/poem31142.html","البسيط"],[66,"عين حبي أعيذها بالله","https://www.aldiwan.net/poem39639.html","الخفيف"],[66,"لو صرت من سقمي شبيه سواك","https://www.aldiwan.net/poem39929.html","الكامل"],[44,"لو صحح الدمع لي أو ناصح الكمد","https://www.aldiwan.net/poem30314.html","البسيط"],[69,"لو كنت تدري ما لقيت من الهوى","https://www.aldiwan.net/poem28550.html","الكامل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"عقرب السوء تمادى في الأذى","https://www.aldiwan.net/poem44060.html","الرمل"],[81,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[46,"ما غاب اسحاق البرايا عنهم","https://www.aldiwan.net/poem23044.html","الكامل"],[46,"لو صح ماقال رسطاليس من قدم","https://www.aldiwan.net/poem23069.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[82,"في رثاء الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=1468",""],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"لو صادت البقَّة ُ فيلَ الزَّنْجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27244",""]],"verses":[["لَو صَحَّ أَنَّ البَينَ يَعشَقُهُ","ما اِستَعبَرَت في السَيرِ أَينُقُهُ",0,"ق",2,1],["لَوْ صِيَغتِ الأَرْضُ لي دُونَ الوَرى ذَهَباً","لَمْ تَرْضَها لِمُرَجِّي نائِلي هِمَمِي",1,"ي",1,0],["لَو صَدَقَتهُ ما تَقولُ وَلا","كِنَّ عِداتٍ دونَهُنَّ عِلَل",2,"ل",1,0],["لَو صَحَّ في هَذا الوُجودِ تَناسُخٌ","لَرَأَيتُ فيكَ تَناسُخَ الأَرواحِ",3,"ح",1,0],["لو صوروا شخص الكمال لكنته","وبحسن فعلك حسنه مزداد",4,"د",1,0],["لو صنعوا ما صنعت أو بع","ضه لسدنا في العالمينا",5,"ن",2,0],["لَوْ صَوَّرَ الحِسُّ مَعْنَاهَا لِنَاظِرِهَا","تَكَشَّفُ النَّفْسُ فِيهَا عَنْ دَمٍ قَانِ",6,"ن",1,0],["لَوْ صَنَعُوا مَا صَنَعْتَ أَوْ بَعْضَ","هُ لَسُدْنَا المُسَوَّدِينَا",7,"ن",2,0],["لو صافح الكفَّ الخضيبَ بكفه","فخرت بنهر للمجرة جاري",8,"ر",2,0],["لو صوَّر الشام شخصاً كنت صاحبه","وجامع الشام وجهاً كنت ناظره",9,"ر",2,0],["لو صحا ودَّ أن عمركُم المم","دود فيه وعُمرَهُ المسْحوتُ",10,"ت",1,0],["لو صاح في الليل به صائحٌ","لكانت الأرض له طفرَهْ",11,"ر",2,0],["لو صح ما قلت لكان الغنى","يضر والفقر الذي ينفع",12,"ع",1,0],["لو صَحَّ عندي له اعتقادٌ","ما دِنتُ ربي بما يدينُ",13,"ن",1,0],["لو صفا عيشها فأسعد حيّاً","لكمالٍ وحكمةٍ وبيان",14,"ن",1,0],["لَو صَحَّ وُدُّكَ صَحَّ ظَنُّ","كَ بي وَبانَ لَكَ اليَقينُ",15,"ن",1,0],["لَو صَوَّر اللَهُ لِلمَعالي","جسماً لأصبَحتَ فيهِ روحا",16,"ح",2,0],["لو صين دستور البلا","د لما تعدّى من تعدّى",17,"د",2,0],["لَو صادَفَ الدَهرَ يَبغي نَقلَةً فَرَمى","بِعَزمِهِ في رِحالِ الدَهرِ لَم يَرِمِ",18,"م",1,0],["لَو صُوِّرَ الشَرقُ إِنساناً أَخا كَرَمٍ","لَكُنتُمُ الروحَ وَالأَقوامُ جُثمانا",19,"ن",2,0],["لَو صافَحوا المُزنَ ما اِبتَلَّت أَكُفُّهُمُ","وَلَو يَخوضونَ بَحرَ الصينِ ما غَرِقوا",20,"ق",3,0],["لَو صَفَرنا عَبَّ في الماءِ وَلَو","مَرَّ مُجتازاً عَلى الأُتنِ نَهَق",21,"ق",1,0],["لو صَافَحَتْ سَمْعَ ابنِ أوْسٍ لم يَقُلْ","أطلالُهُم سَلَبَتْ دماها الهِيفا",22,"ف",2,0],["لو صافحَتْ سَمَعَ المُحِبْ","بِ لأذهلْتهُ عن الحبيبِ",23,"ب",1,0],["لو صافَحَت سَمْعَ الوليدِ جَثَا لَها","أرسومُ دارٍ أم سُطورُ كتابِ",24,"ب",1,0],["لَو صِيغَ مِن فِضَّةٍ نَفسٌ عَلى قَدرِ","لَعادَ مِن فَضلِهِ لَمّا صَفا ذَهَبا",25,"ب",2,1],["لَو صِرتُ مِنَ السَقامِ في زِيِّ سِواك","لا أَعشَقُ دونَ سائِرِالخَلقِ سِواك",26,"ك",1,0],["لَو صِرتُ مِن سَقَمي شَبيهَ سِواكِ","ما اِختَرتُ مِن دونِ الأَنامِ سِواكِ",27,"ك",1,1],["لَو صَحَّحَ الدَمعُ لي أَو ناصَحَ الكَمَدُ","لَقَلَّما صَحِباني الروحُ وَالجَسَدُ",28,"د",1,1],["لوصلْتَ وصلي واقتطعْتَ قطيعتي","وهجرْتَ هجري واجتنبتَ تجنُّبي",29,"ي",1,0],["لو صدقنا للعوادي مِثلهم","ما ارتضينا العيشَ من زُورٍ ومَيْنْ",30,"ن",1,0],["لو صدقتَ اللَّهَ في دينِ الهدى","فُزْتَ منه بالذمامِ الأقربِ",31,"ب",1,0],["لَو صُوِّرَ الإِسلامُ شَخصاً جاءَكُم","عَمداً بِنَفسِ الوامِقِ المُتَحَيِّرِ",32,"ر",1,0],["لِوِصالِ أُخرى قَد سَلَوتُ سُلُوَّها","فَأَبَت بَناتُ فُؤادِيَ المُرتاحِ",33,"ح",1,0],["لَو صَحَّ أَنَّ البَدرَ لَيسَ بِعاقِلٍ","هَنَّأتُهُ أَلّا يُحِسَّ مُحاقا",34,"ق",2,0],["لَو صَحَّ ماقالَ رَسطاليسُ مِن قِدَمٍ","وَهَبَّ مَن ماتَ لَم يَجمَعُهُمُ الفَلَكُ",35,"ك",1,1],["لو صانع الإمامُ أو تأنَّى","ما بلغ الشاميُّ ما تمنَّى",36,"ن",2,0],["لوْ صوَّرَ فِي جِسْم مرِئٍ مَلكاً","لَصَوَّرَ المَلَكَ الإِنْسِيَّ فِي آسِ",37,"س",1,0],["لو صوروا اللؤم الذميم فمثلوا","ذاك الفتى عدّوا من الحذاق",38,"ق",1,0],["لو صُبَّتِ الأَمْطَارُ صَبّاً فَوْقَهم","ما مَسَّ مَوْطِىءَ نَعْلِهم أَمْطارُ",39,"ر",1,0],["لو صبَّ منه قطرة في جدول","لتجمَّد الآذيُّ، بل لتحجرا",40,"ر",2,0],["لو صُغْتُ كُلَّ مشاعري","شَكَت المحابِرُ، والدفاتر",41,"ر",1,0],["لو صارَ ما كانَ من مُلكٍ ومن مَلكٍ","كما حَكى عن خوالي الطيف وسنانُ",42,"ن",1,0],["لو صعّد القصب الولهان زفرته","لنوّرت بيده واخضلّ واديه",43,"ي",2,0],["لو صادت البقَّة ُ فيلَ الزَّنْجِ","وهملجَ البُرْغُوث تحت السَّرْج",44,"ج",1,1]]}