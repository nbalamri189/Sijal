gate.com/ViewPoem.aspx?id=199689",""],[5829,"اعلان حب هام","https://www.poetsgate.com/ViewPoem.aspx?id=150261",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"ولد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178915",""],[5829,"العاشق الجسور","https://www.poetsgate.com/ViewPoem.aspx?id=215927",""],[5969,"لا نجمٌ ولا قَمَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198951",""],[5969,"يُسَلينا التَفَكُرُ في المُحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198976",""],[6068,"في نصر أحمد -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175895",""],[6147,"لو سجّلوني ..ميّتا..","https://www.poetsgate.com/ViewPoem.aspx?id=151486",""],[6183,"أنت المغني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79843&r=&rc=33",""],[6275,"مهرجان من حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83609&r=&rc=1",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["وَأَصُدُّ عَن ماءِ القَليبِ وَماؤُهُ","في حَيِّزِ الإِكرابِ وَالأَوذامِ",0,"م",1,0],["وَاِصدُم بِكَأسِكَ صَدرَ الدَهرِ مُعتَقِلاً","بِصارِمِ اللَهوِ يَجلو قَسطَلَ الكُرَبِ",1,"ب",1,0],["وَأَصدَرتَ عَنهُ الجَيشَ مِن بَعدِ هَبوَةٍ","تُوَصِّلُ أَعناقَ القَنا وَالقَواضِبِ",2,"ب",1,0],["وَأَصدَقُنا هَوىً مَن كانَ يُذري الدْ","دُموعَ فأَيُّنا أَندى عُيونا",3,"ن",2,0],["وأصْدَى إذا ما أعْقَبَ الرِّيُ ذِلّةً","وأزْجُرُ عِيسِي وهْيَ هِيمٌ خَوامسُ",4,"س",1,0],["وأصْدَرْتَ ما أوْرَدْتَ والحَزْمُ باسِطٌ","يَدَيْكَ ولا إيرادَ إلا بإصْدارِ",5,"ر",1,0],["وأصْدِرِ البِيض حُمراً عَنْ جَماجِمِهمْ","إذا رَوِيْنَ بِها عَلاً على نَهَلِ",6,"ل",1,0],["وَأَصدِمُ كَبشَ القَومِ ثُمَّ أُذيقُهُ","مَرارَةَ كَأسِ المَوتِ صَبراً يُمَجَّجُ",7,"ج",1,0],["وَأَصدى إِلى إِسعافِكَ السائِغِ الجَنى","وَأَضحى إِلى إِنصافِكَ السابِغِ الظِلِّ",8,"ل",1,0],["وَأَصدَرَها بادي النَواجِذِ قارِحٌ","أَقَبٌّ كَسِكرِ الأَندَرِيِّ مَحيصُ",9,"ص",1,0],["وأصدَع برأيك لا لفظ بمحتبسٍ","إذا خطبت ولا فكرٌ بمنزعج",10,"ج",1,0],["وأصدقُ المدح مدح ذي حسدٍ","ملآن من بغضةٍ ومن شَنَف",11,"ف",1,0],["واصدِفْ عن الشُّمِّ آل وهْبٍ","أهل الندى الغَمْرِ والحُلومِ",12,"م",1,0],["وأَصْدَقُ ما أَبُثُّكَ أنَّ قلبي","بِتَصْديقِ القِيامَةِ غيرُ صَافِ",13,"ف",1,0],["وأَصُدُّ دونَ الوِرْدِ والوُرَّادُ أَر","سالٌ كما ازدحَمَ القطا الأسروبُ",14,"ب",1,0],["وَأَصدَقُ ما كُنتَ شُبهاً بِهِ","إِذا مَرِضَ الرَيرُ أَو ماتَ فيكا",15,"ك",2,0],["وأَصدَعُ بالحُسنى التي طارَ ذِكرُها","وأكبادُ قَوْمٍ تَستَطيرُ صدوعُها",16,"ع",3,0],["وأصدُّهُمْ عنْ بدعةٍ","عَظُمَتْ فخيفَ لها السطا",17,"ط",2,1],["وَاِصدُقيني فَإِنَّ قَلبي رَهينٌ","ما يُطيقُ الكَلامَ فيمَن سِواكِ",18,"ك",1,0],["وَأَصدَعُ أَحشاءَ الظَلامِ بِفِتيَةٍ","مَواكِبَ مِنها أَنجَمَ اللَيلُ أَنجُما",19,"م",2,0],["وأصدقُ العزمِ ما لو جاشَ مُصطخِبٌ","مِنَ الحوادثِ غَالَتْهُ زَواخِرُهُ",20,"ر",2,0],["وَاِصدَع غَيابَةَ كُلِّ شَكٍّ مُظلِمٍ","بِشِهابِ عِلمٍ ساطِعٍ وَبَيانِ",21,"ن",1,0],["وَأَصَدَّ عَن خَطَلٍ وأَحلَمَ قُدرَةً","عَن كاشِحٍ يَستَنُّ بِالأَغوارِ",22,"ر",1,0],["وَأَصدَعُ شَكّي بِاليَقينِ وَإِنَّني","لِنَفسي عَلى بَعضِ المَساءَةِ حابِسُ",23,"س",1,0],["وَأَصداغٍ يُرَصِّفُها أَميري","عَلى خَدٍّ تَلَألَأُ وَجنَتاهُ",24,"ا",2,0],["وأصدَى فلا أبدي إلى الماءٍ حاجةً","وللشّمس فوق اليعملات لعاب",25,"ب",1,0],["واصْدَحِي يا جنادلَ النهر تحتي","بأناشيدِ مائكِ المُنْهَلِّ",26,"ل",1,0],["وأصدُّ الريحَ عن وجهتها","فتجوبُ الكونَ لا تدري اتّجاها",27,"ا",3,0],["واصدحي يا خواطري","طُويَتْ شُقَّة السَّفَرْ",28,"ر",1,0],["وَأَصْدَعُ الْخَصْمَ وَمَا خِلْتُنِي","أَصْدَعُ إِلَّا الْبَطَلَ الأَصْيَدَا",29,"د",2,0],["وَأَصْدُقُهُ وُدِّي وإِنْ كُنْتُ عَالِماً","بِأَنَّ النَّقَا لَمْ يَدْنُ مِنِّي بَعِيدُهُ",30,"د",2,0],["وَأَصْدَعُ الْجَيْشَ وَالْفُرْسَانُ مِنْ مَرَحٍ","تَحْتَ الْعَجاجِ بِأَطْرَافِ الْقَنَا نُخُطُ",31,"ط",1,0],["واصدَحْ بنونيةٍ لما هتفتُ بها","تشرّق السمع شوقي وابنُ زيدونا",32,"ن",2,0],["واصدَحْ به حينًا على أدواحه","لحنًا كلحن حمامه السَّجَّاع",33,"ع",1,0],["وأُصدِقُكِ الحديثَ فكم \" حُلولٍ \"","حرامٍ ، لُحْنَ في زِيٍّ مُباح",34,"ح",1,0],["وأصْدَقُ في القول من هُدْهُدٍ","وأخشنُ في الحق من جلمد",35,"د",1,0],["وأَصْدَقُ مَا كُنتَ شِبْهاً بهِ","إِذا مَرِضَ الأَيْرُ أَو مَاتَ فِيكَا",36,"ك",2,0],["واصدَحْ بنونية ٍ لما هتفتُ بها","تسرّق السمع شوقي وابنُ زيدونا",37,"ن",2,0],["وَأَصدق مِن أَصفيهِ وَدي مَداهن","وَمَلعب طوقي مِنهُ في قَبضة النَصل",38,"ل",1,0],["واصدق لمن تهواه في ترك السوى","واقبل عليه بحلية المتذلل",39,"ل",1,0],["وأصدح لا أبالي هل أصاخت","لي الأرواح أم صم الرمال",40,"ل",1,0],["وأصدّ عن نظر الملاح وحبِهم","وأرى المحبَّ وما يقول فأعجبُ",41,"ب",1,0],["وَأَصدَقُ مَن يَمشي عَلى الأَرضِ لَهجَةً","بِهِ خُتِمَ السِلكُ النَبيئيُّ بَهجَةً",42,"ه",1,0],["واصدع بأمر الله غير مجامل","لفلان في رب السما وفلان",43,"ن",1,0],["وَأَصُدَّ عَنهُ إِذا اِلتَقَينا خَشيَةً","مِن كاشِحٍ طاوٍ عَلى شَحنائِهِ",44,"ا",3,0],["وَأَصدَقُ بَأساً مِن كُلَيبٍ إِذا غَدا","يَجُرُّ إِلى حَربِ المُلوكِ الجَحافِلا",45,"ل",2,0],["وا صديقاه وا حنيني إليه","واشتياقي وحرقتي وهيامي",46,"م",2,0],["وا صديقاه آه بل كيف يصفو","العيش لي بالقسوة الأحكام",46,"م",1,0],["واصدَع بنَشوَتِها وفَرطِ سرورِ","ها شملَ الضنى والهمّ والتسهيد",47,"د",1,0],["وَأَصدَرَت نَفسُهُ ما في قَذارَتِها","الحَمراءِ مِن شَهوَةٍ لِلأَحمَرِ القاني",48,"ن",2,0],["وأصدق رؤيا المرء رؤياه إنها","لمن شبه الشيطان تُحمى وتمنع",49,"ع",1,0],["واصدف عن البحرِ الذي ألْفَيتَه","ثَمداً لِبَحر نوالِها ضَحضَاحا",50,"ح",2,0],["واصْدُرْ عَن الملحِ الأجاجِ مُسوّغاً","عَذْباً فُرَاتاً للسّمَاحِ قَراحا",50,"ح",2,0],["وَاصْدُقُوا العَزْمَةَ في تكذيبِهِمْ","عُذّلاً يَبْغونَ مِنْكُمْ عِوَجا",51,"ج",2,0],["واِصدقهمُ في الوَعدِ","فالخُلفُ خُلقُ الوَغدِ",52,"د",1,0],["واصداره عن واحد بعد واحد","أو القول بالتجويز رمية حيرة",53,"ه",1,0],["وأصدق ما بناه من قصور","هيامه كذب",54,"ب",1,0],["واصدحي كالطيور","واسطعي كالقمر",55,"ر",1,0],["وأصدَقُ خَلْقِ اللهِ طعْناً بذابلٍ","إذا مُدَّ للخيلِ القنا بينَ آذان",56,"ن",1,0],["واصدَعْ بما أَمرَ العُلا وإن انثَنى","عنه الحَسودُ بقَلبِه المَصْدوع",57,"ع",1,0],["واصدع بتكذيبهم فيما به حكموا","فإنَّ تقويمهم للحق تعويج",58,"ج",1,0],["واصدق ولا تبرح ملازم الباب","تعطي كمثل الصادقين",59,"ن",1,0],["وأصدق انما الصد","ق مفتاح العنايات",60,"ت",1,0],["وأصدَقُ مدحٍ ما تردِّدُه العِدى","وتشهدُ فيه أنه ليس يُجْحَدُ",61,"د",1,0],["وأصدقُ النقل في صفات ال","أسود ما قالت الشُّبولُ",62,"ل",1,0],["وأصدقُ ما محضتُ القومَ مدحي","إذا ما كان مَجدُ القوم مَجدي",63,"د",2,0],["وأصدف عنها وهي قفر كظنّهم","وما هي إلاَّ بالقلوب أواهل",64,"ل",1,0],["وأصدف عن القمر المنير فطل","عةُ المولى نظام الدّين أبهى بل أشفّْ",65,"ف",1,0],["وَاِصدُق إِذا اِدَّرَعَ الجَبانُ بِكَذبِهِ","فَلَرُبَّ صِدقٍ كانَ أَصلَ خَلاصِ",66,"ص",1,0],["واصدع بحقك في أسماع هاضمه","مستبسلا غير هياب ولا وجل",67,"ل",1,0],["واصدق لربك واستمسك بعروته","وفازع لعلياه في وقت المهمات",68,"ت",1,0],["وأصدق إلا أن أريد مديحهم","فإني على حكم الضرورة أكذب",69,"ب",1,0],["واصدع الهم باهتمام أبي","لم يهب عزمه ركوب الصعاب",70,"ب",1,0],["واصدم بها شعث النواصي ربى","غزة أو ما حولها من نواح",71,"ح",1,0],["واصدق فما تخفى طوية صادق","ممن أسر الجمر تحت رماد",72,"د",1,0],["وَأصْدَقُ منْ هَذا وَأوْلى بأَنكُمْ","تَرَكْتُمْ أمُوراً وَهْيَ أَوْلَى وأَحْزَمُ",73,"م",1,0],["وأُصدُّ عن لُقيا العدوِّ وهل","ألقى العدوّ ولستَ في ظهري",74,"ر",2,0],["واصدق وصادقنا ولا تنظر إلى","ما يقتضي منها فهوم عوام",75,"م",1,0],["واصدِق الناس إِذا حدثتهم","ودعِ الكذب لمن شاء كذب",76,"ب",1,0],["وأصدق فعل شاع في الأرض صيتها","وطارت إلى شرقيها والمغارب",77,"ب",1,0],["وَأصدُفُ عَن شَحيحِ الكَفِّ أَلاّ","أُقَبِلَ كَفَّهُ ظَهراً وَبَطنا",78,"ن",2,0],["وأصدق الناس إيماناً أشدهم","حزناً ومن قد تسلى كاذب أشر",79,"ر",1,0],["واصدع صفات الجميع منهم","بفعلك صدعهم صفاتي",80,"ي",1,0],["وأصدر حالا عجول الأوامر","ليأتي على عجل كل ناظر",81,"ر",1,1],["وأصدق باك في النوائب من بكى","على شامخ يهوي ومؤتلق يخبو",82,"ب",2,0],["وَاِصدَح بِجِلَّقَ يا بشراكِ قَلعَتها","فَإِنّما فيكِ إِبراهيمُ سُلطانُ",83,"ن",1,0],["واصدُقوا إنما المروءةُ صدقٌ","أهلُها القائلُ الفعولُ المُجازِى",84,"ز",2,0],["واصدقاني ألستما بين ليل","ونهار ما لي حليف ظلام",85,"م",1,0],["وأصدرها عنا ورودٌ مهنأ","قد ارفضَّ عنه الموكب المتزاحم",86,"م",1,0],["وأصدق برهانا وأظهر حجة","وأكثر تنويلا وأوفر مغنما",87,"م",2,0],["وأصدق عند الناس في كل موطن",