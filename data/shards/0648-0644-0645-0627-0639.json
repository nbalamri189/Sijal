{"poems":[[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[53,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[77,"أصابتك يا عين عين الحسد","https://www.aldiwan.net/poem36551.html","المتقارب"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[47,"ولما عز دمع العين فاضت","https://www.aldiwan.net/poem25218.html","الوافر"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[72,"هناء محا ذاك العزاء المقدما","https://www.aldiwan.net/poem19668.html","الطويل"],[72,"إمام المسلمين تعز عمن","https://www.aldiwan.net/poem20567.html","الوافر"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[51,"أبلغ أباك إذا هلكت وقل له","https://www.aldiwan.net/poem66706.html","الكامل"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[91,"وقائلة هجرت الشعر حتى","https://www.aldiwan.net/poem62775.html","عموديه"],[32,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[45,"سلاها كيف ضيعت الوصالا","https://www.aldiwan.net/poem65574.html","البسيط"],[45,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[61,"محلك من وصل الأحبة آنس","https://www.aldiwan.net/poem51593.html","الطويل"],[66,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[74,"ألا ليت لمح البارق المتألق","https://www.aldiwan.net/poem13196.html","الطويل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[81,"ولما عزمنا ولم يبق من","https://www.aldiwan.net/poem61516.html","المتقارب"],[52,"ولما عدت خيلنا للطراد","https://www.aldiwan.net/poem27072.html","المتقارب"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13662","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[77,"لمن طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[77,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[133,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[133,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[144,"أبا زنة لا زال جدك هابطا","https://www.aldiwan.net/poem11736.html","الطويل"],[144,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[148,"إلى الصون مدت تلمسان يداها","https://www.aldiwan.net/poem47691.html","الطويل"],[151,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[186,"أوجهك أم قبلة فالغصو","https://www.aldiwan.net/poem14585.html","المتقارب"],[212,"ولما عزني في الحب دهري","https://www.aldiwan.net/poem46598.html","الوافر"],[236,"نعمت زمانا مع المترفين","https://www.aldiwan.net/poem31598.html","المتقارب"],[272,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[276,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[281,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[283,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[286,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[306,"رنت بفواتر الأجفان سكرى","https://www.aldiwan.net/poem56517.html","الوافر"],[354,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[365,"فديتك رابني الإعراض عني","https://www.aldiwan.net/poem60653.html","الوافر"],[365,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[365,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[365,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[394,"الشيب ينشر عمرا ثم يطويه","https://www.aldiwan.net/poem53662.html","الطويل"],[403,"سقى العقيق فالديار فاللوى","https://www.aldiwan.net/poem46428.html","الرجز"],[404,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[417,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[433,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[459,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[459,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[465,"من هم المضنى ومن شجنه","https://www.aldiwan.net/poem3411.html","عموديه"],[469,"إذا الصديق رماني","https://www.aldiwan.net/poem60454.html","المجتث"],[501,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[516,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[539,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[552,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[552,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[552,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[552,"في كل يوم أرى عجيبا","https://www.aldiwan.net/poem48077.html","مخلع البسيط"],[568,"ولما عبثن بأوتارهن","https://www.aldiwan.net/poem69490.html","البسيط"],[576,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["وَلَمّا عَطَفتُ الناظِرَينِ بِلَفتَةٍ","إِلى الدارِ خَلّى عَبرَةَ العَينِ شانُها",0,"ن",3,0],["وَلَم أَعلَم كَعِلمِ بَني زَماني","بِأَنَّ القُربَ داعِيَةُ المَلالِ",1,"ل",1,0],["ولمّا علَوْتَ وقُدْتَ الزّمانَ","بحَبْلٍ فأوْهَقْتَهُ منْ مَسَدْ",2,"د",1,0],["ولمّا عرَتْ هَذي الجَزيرَة روْعَةٌ","وأصْبَحَ فِيها الرُّعْبُ مُلْتَهِبَ الوَقْدِ",3,"د",1,0],["ولمّا عرَتْ هَذي الجَزيرةَ نَبْوَةٌ","وعُطِّلَ منْ فَرْضِ الجِهادِ أكيدُهُ",4,"د",2,0],["وَلَمّا عَزَّ دَمعُ العَينِ فاضَت","دِماءً عِندَ تَرحالِ الفَريقِ",5,"ق",1,1],["ولم أعط كأساً بالنضار وخدّه","لمعطيه بالدرِّ النظيم متوّجا",6,"ج",2,0],["ولما علا نحو السماء ثناؤه","أتى بالنجوم الزهر والسحب السح",7,"ح",1,0],["ولما عقدنا باسم علياك خنصراً","رأينا من التحقيق أن يتحتما",8,"م",2,0],["ولم أعرف لها اسماً ولكن","أقول الآن فاطمة الرزايا",9,"ا",3,0],["ولم أعلَمْك تطلُبُني بذَحْلٍ","ولكني إخالُك مستنيكا",10,"ك",2,0],["ولمَا عرضتُ له فخاب تعرُّضي","لكن عففتُ وألحف السؤَّالُ",11,"ل",1,0],["ولما عنيتُ وكيف ذاك وإنّما","أَثنى بما يُغْني الغناءَ الراهنا",12,"ن",2,0],["ولما عَنَوْا مكروهَ نفسِكَ عندها","لكنهم محبوبَ أنفسِهم عنَوا",13,"ن",3,0],["وَلَمّا عَلَونَ الأَرضَ شَرقِيَّ مُعنِقٍ","ضَرَحنَ الحَصى الحَمصِيِّ كُلَّ مَكانِ",14,"ن",1,0],["وَلَم أَعقِد عَلى خَوفٍ لِساني","وَلا ضَنّاً عَلى الدُنيا بِفَنّي",15,"ن",2,0],["وَلَمّا عَلَونَ اللابَتَينِ تَشَوَّفَت","قُلوبٌ إِلى وادي القُرى وَعُيونُ",16,"ن",1,0],["وَلَم أَعدَمِ الظِلَّ الخَصيبَ وَإِنَّما","أُجاذِبُكَ الظِلَّ الَّذي هُوَ أَخصَبُ",17,"ب",1,0],["وَلَمّا عَرَضتَ الجَيشَ كانَ بَهاؤُهُ","عَلى الفارِسِ المُرخى الذُؤابَةَ مِنهُمُ",18,"م",1,0],["وَلَم أَعدُد هَوايَ لَها سَفاهاً","وَلا وَجدي القَديمَ بِها ضَلالا",19,"ل",2,0],["وَلَم أَعرِفِ الذَنبَ الَّذي سُؤتَني لَهُ","فَأَقتُلَ نَفسي حَسرَةً وَتَنَدُّما",20,"م",2,0],["ولم أَعْبَ بالوعْدِ الذي وَعَدَ الوَرى","فمَنْ كان يرجوه فإني آيسُ",21,"س",1,0],["وَلَمّا عَطَفتُ العَيسَ آخِرَ رِحلَةٍ","إِلى مَعهَدٍ لي وَالحَبيبُ بِهِ عَهدُ",22,"د",1,0],["وَلَم أَعلَم بِأَنَّ الرَمسَ يُمسي","بِمَوجِ الحَربِ مِن صَدَفِ اللَآلي",23,"ل",2,0],["ولمّا عَشينَا من توقّد نورها","تَخِذْنَا سناهُ من نواظرنا كُحْلا",24,"ل",2,0],["ولَما عَدمنا من بهاليلِ قَومها","مَآتِم تَبكيها بَكَينا مع الشُهبِ",25,"ب",1,0],["وَلَمّا عَلَت وَجهَ النَهارِ كَآبَةٌ","وَدارَت بِهِ لِلشَمسِ نَظرَةُ مُشفِقِ",26,"ق",1,0],["وَلَم أَعتَنِق بَرقَ الغَمامِ وَإِنَّما","وَضَعتُ عَلى قَلبي يَدَيَّ تَأَلُّما",27,"م",2,0],["وَلَمّا عَزَمنا وَلَم يَبقَ مِن","مُصانَعَةِ الشَوقِ غَيرُ اليَسيرِ",28,"ر",1,1],["وَلَمّا عَدَت خَيلُنا لِلطِرادِ","جَعَلنا إِلى الدَيرِ ميعادَها",29,"د",3,1],["وَلَمّا عَلا الحَبرُ أَكفانَهُ","هَوى مَلِكٌ بَينَ أَثوابِها",30,"ب",3,0],["وَلَم أُعطَ فيها حيلَةً غَيرَ أَنَّني","أَحِنُّ إِلى ما فاتَ مِنها وَأَنشِجُ",31,"ج",1,0],["وَلَم أُعرِض عَنِ اللَذّاتِ إِلّا","لِأَنَّ خِيارَها عَنّي خَنَسنَه",32,"ن",2,0],["وَلَمّا عَوى وَالرَملُ بَيني وَبَينَهُ","تَيَقَّنَ صَحبي أَنَّهُ غَيرُ راجِعِ",33,"ع",1,0],["ولما عزمتَ الظّعن كي تفصل التي","عصتْ كلّ طبٍّ بالأمورِ خبير",34,"ر",1,0],["ولما عرت هذي الجزيرة نبوة","وعطل من فوق الجهاد أكيده",35,"د",2,0],["ولما عرت هذه الجزيرة روعة","وأصبح فيها الرعب ملتهب الوقد",36,"د",1,0],["ولم أعتض أنوءا من نهوض","ولم يعهد لذى لغة لسانا",37,"ن",2,0],["ولَم أُعطِ الأَمَانَ الرَّنقَ ِإلاَّ","لِمَن أعطَاني الرَّنقَ الأَمَانَا",38,"ن",2,0],["وَلَمّا عَمَمتَ الخَلقَ بِالفَقرِ وَالرَدى","فَبادوا وَأَوسَعتَ المَنازِلَ إِخرابا",39,"ب",2,0],["وَلَمّا عَمَمتَ بِها السائِلي","نَ عادَت تَطَلَّبُ مَن لَم يَسَل",40,"ل",1,0],["وَلَم أَعدُ قَدرِيَ كَي لا يَكو","نَ ذا أَمَلٍ طالَ حَتّى أَمَلّ",40,"ل",1,0],["ولما علمت الصدق منها بأنها","أنالتني الكرسي وحزت علاها",41,"ا",3,0],["ولم أعلمن في القطر غيري كافلاًُ","ولا عارفا في حقها وبهاها",41,"ا",3,0],["وَلَمّا عَلا قَدراً وَرِفعَةَ هِمَّةٍ","تَداعَت لَهُ الأَملاكُ مِن كُلِّ أُمَّةٍ",42,"ه",1,0],["ولما عَصتْ في السجود الغصونُ","فللنارِ عاقبةُ المرجع",43,"ع",1,0],["ولما عزّني في الحب دهري","وأرغمني الزمان على نزوحي",44,"ي",1,1],["ولم أعرف لرؤيتكم سبيلاً","بعثت بصورتي من بعد روحي",44,"ي",1,0],["وَلَم أَعصِ في حُكمِها غادَةً","كَعاباً وَلا رَشَأً أَحوَرا",45,"ر",2,0],["وَلَم أَعتَصِم بِاللَه الاومدلى","من البر ظلا في رضاء له وكف",46,"ف",1,0],["ولَم أعتَمد إلا حِمَاه أُعِدُّهُ","عِتاداً لدَهْرٍ جانفٍ غير جانِح",47,"ح",1,0],["وَلَمّا عَزَّ نائِلُهُمْ قِياداً","وَهَبْتُ الصَّعْبَ مِنْهُمْ لِلذَّلُولِ",48,"ل",1,0],["وَلَمّا عُذْتُ بِالْعَلْياءِ قالَتْ","لَعَلَّكَ صاحِبُ الشُّكْرِ الْقَتِيلِ",48,"ل",1,0],["وَلَمّا عَرى جُدرانَهُ العُريُ فَاِكتَسَت","قُشَعريرَةً أَوصى بِأَن يُلبَسَ الفَصّا",49,"ص",2,0],["ولم اعتلي ظهر الجوا","د وفي النزال السيف جر",50,"ر",1,0],["وَلَم أُعطِ الهوادةَ عَن هوانٍ","وَلا جَزعٍ لأن حمّلتُ إِصرا",51,"ر",2,0],["وَلمّا عَلَيهِ اِشتَدَّ إِيذاءُ قَومِهِ","رَأى أَنّ بعد الدار أَحرى وَأَصوبُ",52,"ب",1,0],["ولم أعرِفْ له سبباً لعَمْري","سوى الإضجارِ بالنّظْمِ السّقيم",53,"م",1,0],["ولمّا عصَى الحِصْنُ الجَلاليُّ رَبَّهُ","وآوى من الأعداء أهْلَ الغَوائل",54,"ل",1,0],["ولمّا عَنّ للفلَكِ التّسامي","رأى بِعدادِ غِلْمتِكَ التحاقا",55,"ق",2,0],["ولمّا عَرضْنا للحُمولِ وأعرضَتْ","كُعوبُ قناً يُحطمنَ دونَ كواعب",56,"ب",1,0],["وَلَم أَعجّ بِأَقراني اِذا شَهدوا","بَياضَ شعري وَأَشكُ من تعدّيه",57,"ي",2,0],["ولم أُعاتبْ سيفَ حظّي إنْ نَبَا","ولم أَقلْ لِزَمني حتّى مَتى",58,"ا",1,0],["ولما عراني الضعف من كل جانب","وجاوزت ما فوق الثمانين من عمري",59,"ر",2,1],["ولم أعبأ بجعجعة وطحن","فذاك الصخر خرّ من اليفاع",60,"ع",1,0],["ولما عَسا غصنُ الزمانِ عطَفْتَهُ","بكفّيْكَ فهْو الناضرُ المتأوّدُ",61,"د",1,0],["ولما عداك كثيرُ حظٍّ عازِبٍ","لما فطنت كفاك منه قليلُ",62,"ل",1,0],["ولم أعدَمْ نوالَهُمُ ولكن","وجوهٌ بعدَها ألمٌ ووجدُ",63,"د",1,0],["ولما عزَّ ماءُ الرَّكب فيهم","وقفتُ أَحُلُّ من عيني مَزادي",64,"د",2,0],["ولم أعرج على منازله","أسأل آثارهنَّ عن ظعنه",65,"ن",2,0],["وَلَم أُعَرِّضُهُ مِنّي","إِلى أَذى الاغتِيابِ",66,"ب",1,0],["ولم أَعْبَأْ بها حتَّى تَفانَتْ","وماتَتْ وهي عاجِزَةٌ قَوِيَّهْ",67,"ي",2,0],["ولما علت لبني علي راية","فيها ولا امتاز العدو من الولي",68,"ل",2,0],["ولَما عَرفتُ سِوَى أشم","مٍ دُونه شُمُّ العَرَب",69,"ب",1,0],["ولمّا عرفنا دارَها بمُحَجَّرٍ","وَحَلَّتْ عيونٌ بالدّموعِ حُباها",70,"ا",3,0],["ولمّا عراني ظِلُّهُ وحملتُهُ","أنِسْتُ على عَمْدٍ بحَمْلِ المظالِمِ",71,"م",1,0],["ولمّا عرانِي ما عرانِيَ واِلتَوى","عليَّ أخٌ فيما عرا وشقيقُهُ",72,"ق",2,0],["وَلَم أعَفْ سلمها فَلم ذي","تَشِبُّ ما بَينَنا الحُروبا",73,"ب",2,0],["وَلَمَّا عَبِثْنَ بَأَوْتَارِهِنَّ","قُبَيْلَ التَّبَلُّجِ أَيْقَظْنَنِي",74,"ن",2,1],["ولما علا شَأْناً لقدْ زيَّن الْعُلَى","ولما بَنَى الحُسْنَى لقد أَحْسَنَ البِنَا",75,"ن",2,0]]}