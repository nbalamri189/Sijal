,1,0],["ولمّا علَوْتَ وقُدْتَ الزّمانَ","بحَبْلٍ فأوْهَقْتَهُ منْ مَسَدْ",2,"د",1,0],["ولمّا عرَتْ هَذي الجَزيرَة روْعَةٌ","وأصْبَحَ فِيها الرُّعْبُ مُلْتَهِبَ الوَقْدِ",3,"د",1,0],["ولمّا عرَتْ هَذي الجَزيرةَ نَبْوَةٌ","وعُطِّلَ منْ فَرْضِ الجِهادِ أكيدُهُ",4,"د",2,0],["وَلَمّا عَزَّ دَمعُ العَينِ فاضَت","دِماءً عِندَ تَرحالِ الفَريقِ",5,"ق",1,1],["ولم أعط كأساً بالنضار وخدّه","لمعطيه بالدرِّ النظيم متوّجا",6,"ج",2,0],["ولما علا نحو السماء ثناؤه","أتى بالنجوم الزهر والسحب السح",7,"ح",1,0],["ولما عقدنا باسم علياك خنصراً","رأينا من التحقيق أن يتحتما",8,"م",2,0],["ولم أعرف لها اسماً ولكن","أقول الآن فاطمة الرزايا",9,"ا",3,0],["ولم أعلَمْك تطلُبُني بذَحْلٍ","ولكني إخالُك مستنيكا",10,"ك",2,0],["ولمَا عرضتُ له فخاب تعرُّضي","لكن عففتُ وألحف السؤَّالُ",11,"ل",1,0],["ولما عنيتُ وكيف ذاك وإنّما","أَثنى بما يُغْني الغناءَ الراهنا",12,"ن",2,0],["ولما عَنَوْا مكروهَ نفسِكَ عندها","لكنهم محبوبَ أنفسِهم عنَوا",13,"ن",3,0],["وَلَمّا عَلَونَ الأَرضَ شَرقِيَّ مُعنِقٍ","ضَرَحنَ الحَصى الحَمصِيِّ كُلَّ مَكانِ",14,"ن",1,0],["وَلَم أَعقِد عَلى خَوفٍ لِساني","وَلا ضَنّاً عَلى الدُنيا بِفَنّي",15,"ن",2,0],["وَلَمّا عَلَونَ اللابَتَينِ تَشَوَّفَت","قُلوبٌ إِلى وادي القُرى وَعُيونُ",16,"ن",1,0],["وَلَم أَعدَمِ الظِلَّ الخَصيبَ وَإِنَّما","أُجاذِبُكَ الظِلَّ الَّذي هُوَ أَخصَبُ",17,"ب",1,0],["وَلَمّا عَرَضتَ الجَيشَ كانَ بَهاؤُهُ","عَلى الفارِسِ المُرخى الذُؤابَةَ مِنهُمُ",18,"م",1,0],["وَلَم أَعدُد هَوايَ لَها سَفاهاً","وَلا وَجدي القَديمَ بِها ضَلالا",19,"ل",2,0],["وَلَم أَعرِفِ الذَنبَ الَّذي سُؤتَني لَهُ","فَأَقتُلَ نَفسي حَسرَةً وَتَنَدُّما",20,"م",2,0],["ولم أَعْبَ بالوعْدِ الذي وَعَدَ الوَرى","فمَنْ كان يرجوه فإني آيسُ",21,"س",1,0],["وَلَمّا عَطَفتُ العَيسَ آخِرَ رِحلَةٍ","إِلى مَعهَدٍ لي وَالحَبيبُ بِهِ عَهدُ",22,"د",1,0],["وَلَم أَعلَم بِأَنَّ الرَمسَ يُمسي","بِمَوجِ الحَربِ مِن صَدَفِ اللَآلي",23,"ل",2,0],["ولمّا عَشينَا من توقّد نورها","تَخِذْنَا سناهُ من نواظرنا كُحْلا",24,"ل",2,0],["ولَما عَدمنا من بهاليلِ قَومها","مَآتِم تَبكيها بَكَينا مع الشُهبِ",25,"ب",1,0],["وَلَمّا عَلَت وَجهَ النَهارِ كَآبَةٌ","وَدارَت بِهِ لِلشَمسِ نَظرَةُ مُشفِقِ",26,"ق",1,0],["وَلَم أَعتَنِق بَرقَ الغَمامِ وَإِنَّما","وَضَعتُ عَلى قَلبي يَدَيَّ تَأَلُّما",27,"م",2,0],["وَلَمّا عَزَمنا وَلَم يَبقَ مِن","مُصانَعَةِ الشَوقِ غَيرُ اليَسيرِ",28,"ر",1,1],["وَلَمّا عَدَت خَيلُنا لِلطِرادِ","جَعَلنا إِلى الدَيرِ ميعادَها",29,"د",3,1],["وَلَمّا عَلا الحَبرُ أَكفانَهُ","هَوى مَلِكٌ بَينَ أَثوابِها",30,"ب",3,0],["وَلَم أُعطَ فيها حيلَةً غَيرَ أَنَّني","أَحِنُّ إِلى ما فاتَ مِنها وَأَنشِجُ",31,"ج",1,0],["وَلَم أُعرِض عَنِ اللَذّاتِ إِلّا","لِأَنَّ خِيارَها عَنّي خَنَسنَه",32,"ن",2,0],["وَلَمّا عَوى وَالرَملُ بَيني وَبَينَهُ","تَيَقَّنَ صَحبي أَنَّهُ غَيرُ راجِعِ",33,"ع",1,0],["ولما عزمتَ الظّعن كي تفصل التي","عصتْ كلّ طبٍّ بالأمورِ خبير",34,"ر",1,0],["ولما عرت هذي الجزيرة نبوة","وعطل من فوق الجهاد أكيده",35,"د",2,0],["ولما عرت هذه الجزيرة روعة","وأصبح فيها الرعب ملتهب الوقد",36,"د",1,0],["ولم أعتض أنوءا من نهوض","ولم يعهد لذى لغة لسانا",37,"ن",2,0],["ولَم أُعطِ الأَمَانَ الرَّنقَ ِإلاَّ","لِمَن أعطَاني الرَّنقَ الأَمَانَا",38,"ن",2,0],["وَلَمّا عَمَمتَ الخَلقَ بِالفَقرِ وَالرَدى","فَبادوا وَأَوسَعتَ المَنازِلَ إِخرابا",39,"ب",2,0],["وَلَمّا عَمَمتَ بِها السائِلي","نَ عادَت تَطَلَّبُ مَن لَم يَسَل",40,"ل",1,0],["وَلَم أَعدُ قَدرِيَ كَي لا يَكو","نَ ذا أَمَلٍ طالَ حَتّى أَمَلّ",40,"ل",1,0],["ولما علمت الصدق منها بأنها","أنالتني الكرسي وحزت علاها",41,"ا",3,0],["ولم أعلمن في القطر غيري كافلاًُ","ولا عارفا في حقها وبهاها",41,"ا",3,0],["وَلَمّا عَلا قَدراً وَرِفعَةَ هِمَّةٍ","تَداعَت لَهُ الأَملاكُ مِن كُلِّ أُمَّةٍ",42,"ه",1,0],["ولما عَصتْ في السجود الغصونُ","فللنارِ عاقبةُ المرجع",43,"ع",1,0],["ولما عزّني في الحب دهري","وأرغمني الزمان على نزوحي",44,"ي",1,1],["ولم أعرف لرؤيتكم سبيلاً","بعثت بصورتي من بعد روحي",44,"ي",1,0],["وَلَم أَعصِ في حُكمِها غادَةً","كَعاباً وَلا رَشَأً أَحوَرا",45,"ر",2,0],["وَلَم أَعتَصِم بِاللَه الاومدلى","من البر ظلا في رضاء له وكف",46,"ف",1,0],["ولَم أعتَمد إلا حِمَاه أُعِدُّهُ","عِتاداً لدَهْرٍ جانفٍ غير جانِح",47,"ح",1,0],["وَلَمّا عَزَّ نائِلُهُمْ قِياداً","وَهَبْتُ الصَّعْبَ مِنْهُمْ لِلذَّلُولِ",48,"ل",1,0],["وَلَمّا عُذْتُ بِالْعَلْياءِ قالَتْ","لَعَلَّكَ صاحِبُ الشُّكْرِ الْقَتِيلِ",48,"ل",1,0],["وَلَمّا عَرى جُدرانَهُ العُريُ فَاِكتَسَت","قُشَعريرَةً أَوصى بِأَن يُلبَسَ الفَصّا",49,"ص",2,0],["ولم اعتلي ظهر الجوا","د وفي النزال السيف جر",50,"ر",1,0],["وَلَم أُعطِ الهوادةَ عَن هوانٍ","وَلا جَزعٍ لأن حمّلتُ إِصرا",51,"ر",2,0],["وَلمّا عَلَيهِ اِشتَدَّ إِيذاءُ قَومِهِ","رَأى أَنّ بعد الدار أَحرى وَأَصوبُ",52,"ب",1,0],["ولم أعرِفْ له سبباً لعَمْري","سوى الإضجارِ بالنّظْمِ السّقيم",53,"م",1,0],["ولمّا عصَى الحِصْنُ الجَلاليُّ رَبَّهُ","وآوى من الأعداء أهْلَ الغَوائل",54,"ل",1,0],["ولمّا عَنّ للفلَكِ التّسامي","رأى بِعدادِ غِلْمتِكَ التحاقا",55,"ق",2,0],["ولمّا عَرضْنا للحُمولِ وأعرضَتْ","كُعوبُ قناً يُحطمنَ دونَ كواعب",56,"ب",1,0],["وَلَم أَعجّ بِأَقراني اِذا شَهدوا","بَياضَ شعري وَأَشكُ من تعدّيه",57,"ي",2,0],["ولم أُعاتبْ سيفَ حظّي إنْ نَبَا","ولم أَقلْ لِزَمني حتّى مَتى",58,"ا",1,0],["ولما عراني الضعف من كل جانب","وجاوزت ما فوق الثمانين من عمري",59,"ر",2,1],["ولم أعبأ بجعجعة وطحن","فذاك الصخر خرّ من اليفاع",60,"ع",1,0],["ولما عَسا غصنُ الزمانِ عطَفْتَهُ","بكفّيْكَ فهْو الناضرُ المتأوّدُ",61,"د",1,0],["ولما عداك كثيرُ حظٍّ عازِبٍ","لما فطنت كفاك منه قليلُ",62,"ل",1,0],["ولم أعدَمْ نوالَهُمُ ولكن","وجوهٌ بعدَها ألمٌ ووجدُ",63,"د",1,0],["ولما عزَّ ماءُ الرَّكب فيهم","وقفتُ أَحُلُّ من عيني مَزادي",64,"د",2,0],["ولم أعرج على منازله","أسأل آثارهنَّ عن ظعنه",65,"ن",2,0],["وَلَم أُعَرِّضُهُ مِنّي","إِلى أَذى الاغتِيابِ",66,"ب",1,0],["ولم أَعْبَأْ بها حتَّى تَفانَتْ","وماتَتْ وهي عاجِزَةٌ قَوِيَّهْ",67,"ي",2,0],["ولما علت لبني علي راية","فيها ولا امتاز العدو من الولي",68,"ل",2,0],["ولَما عَرفتُ سِوَى أشم","مٍ دُونه شُمُّ العَرَب",69,"ب",1,0],["ولمّا عرفنا دارَها بمُحَجَّرٍ","وَحَلَّتْ عيونٌ بالدّموعِ حُباها",70,"ا",3,0],["ولمّا عراني ظِلُّهُ وحملتُهُ","أنِسْتُ على عَمْدٍ بحَمْلِ المظالِمِ",71,"م",1,0],["ولمّا عرانِي ما عرانِيَ واِلتَوى","عليَّ أخٌ فيما عرا وشقيقُهُ",72,"ق",2,0],["وَلَم أعَفْ سلمها فَلم ذي","تَشِبُّ ما بَينَنا الحُروبا",73,"ب",2,0],["وَلَمَّا عَبِثْنَ بَأَوْتَارِهِنَّ","قُبَيْلَ التَّبَلُّجِ أَيْقَظْنَنِي",74,"ن",2,1],["ولما علا شَأْناً لقدْ زيَّن الْعُلَى","ولما بَنَى الحُسْنَى لقد أَحْسَنَ البِنَا",75,"ن",2,0],["وَلَمّا عَلِمنا الكُفرَ مِنهُم وَإنَّهُم","جِهادُهُم فَرضٌ عَلَى كُلِّ مُسلِمِ",76,"م",1,0],["ولم أعتن في عين كل عناية","وفي الفقر من فقري عنائي وغيبتي",77,"ي",1,0],["وَلما عَلت أَركانها وَتجّهزت","بِما يَدفع الأَعداء عَنا بهمة",78,"ه",1,0],["ولما علونا الحزنَ واعتسفت بنا","رسوم الدِّيار اليعملاتُ الرواسمُ",79,"م",1,0],["ولم أعدَّ أبا عبد المليك فذا","باغٍ كما قالَهُ من أرَّخَ السِيَرا",80,"ر",2,0],["ولم أعرف لمفسدة مجالاً","يمدد جرمه إلا اتقيت",81,"ت",1,0],["وَلِما عَمِلوا حقّاً يجدوا","لا يَظلِمُ ربّك مِن أحدِ",82,"د",1,0],["وَلَمّا عَلى خَدِّها اِسودّ قالَت","له صِرْ لخدّيَ خالاً فصارا",83,"ر",2,0],["وَلَمّا عَلى الثلثينِ مِنهُ قَدِ اِنطَوى","فَمن ثمَّ عينُ الشّرعِ أَصبَح يقلعُ",84,"ع",1,0],["ولما عَرَفنَ الجدَّ جدَّ ابنِ ملقَطٍ","عَدَلنَ له وانصاعَ مِنهُنَّ أَوَّلُ",85,"ل",1,0],["ولم أعرف الروس الحسن فضلا","على مستغرب من روس حزنِ",86,"ن",1,0],["ولم أعتمد الا شفاعة أحمد","وهل خاب من يرجو المشفع في الأمم",87,"م",1,0],["وَلمْ أعُجْ إلاَ عَلَى بَابِهِ","وَهل يُرَجّى غيرُ بابِ الكريم",88,"م",1,0],["ولم أعرج على شيء سواك فهل","إلاك يا رب مولى يرحم الضعفا",89,"ف",2,0],["وَلَمْ أعْطِ إلا كُلَّ مَا مَلَكَتْ يَدِي","وَرْوحِي لِحَادِيهَا المُبَشِّرِ بِالْقُرْبِ",90,"ب",1,0],["ولم أُعْرِضْ بِوجْهي عن نَصيحي","ولم أُقْبِلْ مِن المُطْري خِداعَهْ",91,"ع",2,0],["ولم أعلمِ العُذْرَ في غلْقِه","فكنتُ أعودُ على قاعدَهْ",92,"د",2,0],["ولما عزمتَ الأمرَ لا رأيَ دونهُ","خَصَصتَ به من كان أولى وأجدَرا",93,"ر",2,0],["وَلَمّا عَصاني القلب أظهرتُ عولةً","وَقلتُ أَلا قلب بقلبي أُبادِلُه",94,"ل",2,0],["ولم أعارض بقولي من تقدمني","منهم وإن عذبت مني الأقاويل",95,"ل",1,0],["وَلَمّا عَلَتني كَبرَة وَتَوَزَّعَت","لِداتي مَناياهُم وَأوحش جانِبي",96,"ب",2,1],["ولَم أُعملِ العيسَ المراسيلَ بالفَلا","لأبنيَ مجداً رُكنُهُ قد تهَدَّما",97,"م",2,0],["ولم أعطه جهلا ولكن سحائبي","تعم ذوي الإخلاص والشنآن",98,"ن",1,0],["وَلَمّا عَلَت نَشرَ الرُصافَةِ بُشِّرَت","بِعارِضِ مُزنِ باكِرِ الوَبلِ مُثجِمِ",99,"م",1,0],["ولما عييتُ جلستُ كأني","فقيرٌ على بابها اجتدي",100,"د",2,0],["وَلَمّا عَصَيتُ العاذِلينَ وَلَم أُبَل","مَلامَتُهُم أَلقوا عَلى غارِبي حَبلي",101,"ي",1,1],["ولم اعتقد فيه الذي كان ينطوى","عليه له نفس خبيث عيوبها",102,"ب",3,0],["ولما علمنا بالبراهين أنه","رفيق بنا قلنا الرفيقُ هو الله",103,"ل",2,0],["ولم أعرِّج على جفائي","وطول هجري وسيئاتي",104,"ت",2,0],["وَلَمّا عَلى الإِسلامُ وَاِشتَدَّ أَزرُهُ","وَصاحَ لَهُ في دَولَةِ الشِركِ ناعِقُ",105,"ق",1,0],["ولم أعهدك في طلب المعالي","وكسب الحمد غير فتىً جواد",106,"د",1,0],["ولما عدت أسد الرجال ويدها","عند اللقاء لواحظ الغزلان",107,"ن",1,0],["ولمَّا علِمتُ بأنَّ الوِسَامَ","تحلَّى بصدرِ الحِجا والفُهُومِ",108,"م",1,0],["ولم أعتقد أن الخلافة فلتةٌ","بعهد أبي بكرٍ ولا كان من دأبي",109,"ب",2,0],["ولم أعبد الله العظيم تنسكاً","ولكنما يهتاج نفسيَ موجد",110,"د",1,0],["ولما عييت بإقناعه","وظل لما أدعى ينكر",111,"ر",1,0],["ولما علمت الجرم خدمة موطني","رأى كاهلي حمل الجبال خفيفا",112,"ف",2,0],["ولما علمت الذنب خدمة موطني","حلا السجن في عيني وطاب ليَ الشنق",113,"ق",1,0],["ولما عصى قلبي السلوُ أطعتهُ","على حب ليلى في التباعد والقُربِ",114,"ب",1,1],["ولم أعلق بآمال صعاب","أنازعها بألسنة حداد",115,"د",1,0],["ولم اعدم الغر الكرام فكم وكم","تفانى بحبي اليوم من ماجد قرم",116,"م",1,0],["ولمّا علوت العرشَ طالت صروحهُ","وضاقَت بهِ الأعداء والمجد يحسدُ",117,"د",1,0],["وَلَمَّا عَرَفْنَا عَرْفَهَا نَزَّهَ الهَوى","شَذَا عُرْفِهَا النِّدِّي عَنْ وِجْهَهِ النِّدِّ",118,"د",1,0],["وَلَمّا عَدَدنا كُلَّ بؤسى وَأَنعُمٍ","وَجَدَّ الرِهانُ الحَقُ حَتّى تَخَدَّدا",119,"د",2,0],["وَلماعَةٍ ما بِها مِنْ عِلامٍ","وَلا أَمراتٍ وَلا رِعي ماءِ",120,"ا",2,0],["وَلمّا عَلا السَيل الزبى وَتَزافَرَت","كهول وضجّت جلّة وَدرادقُ",121,"ق",1,0],["ولمّا عَجَمنا حصاةَ الرجا","ل بين النواجذ والاضرسِ",122,"س",1,0],["ولمّا عَدِمْنا الصبرَ بعدَ محمّدٍ","أتينا أباهُ نستفيدُ التّعازِيا",123,"ي",2,0],["ولم أعلمْ بأنّ الرزقَ خصمي","وأنّي صاحبُ الجَدِّ العَقيمِ",124,"م",1,0],["ولم أَعنِ رُمَّان الحبيبِ بمأرب","وما كل من يُسمَى بصاحبه يُعنَى",125,"ن",2,0],["ولما عب للهيجاء بحر","تموج به المنايا في اندفاع",126,"ع",1,0],["ولما عرَضْتَ الجيشَ أعرَضَتِ العِدَى","عن الحرْبِ وارْتاعَتْ لما هوَ واقِعُ",127,"ع",1,0],["وَلما عَلَيَّ الدَهرُ جارَ بِبُعدِهِم","وَأَوسَعني بِالظُلمِ في وُدِّهِم غَدرا",128,"ر",2,0],["وَلما عَلمتُ الظَعنَ قَد سارَ راحِلاً","وَفيهِ حَبيبُ القَلب قَد ساءَني النَوى",129,"ن",3,0],["وَلما عَلى عَرشِ الخديوية اِستَوى","وَطابَت بِهِ من اهلِ مِصر خَواطِر",130,"ر",1,0],["ولما عادوا عن الجيش حتى","القحوا فتنةً ليوم النشور",131,"ر",1,0],["ولم أعرف لذا سبباً فاسعى","بجهدي في إزالة ما يزال",132,"ل",1,0],["ولم أعلم وربّك ما عراها","وأغراها لتتركني شجيا",133,"ي",2,0],["ولم أعثر على خل وفي","يقوم بنصرتي وبجبر كسري",134,"ر",2,0],["ولما علمت الأمر بالستر ظاهراً","تيقّنت كون الظهر للعصر ساترا",135,"ر",2,1],["ولم أعترفْ أنّي جَنيتُ وإنما","يُصانَعُ بالإقرار من ألَم الضَّربِ",136,"ب",1,0],["وَلَمَّا عَلَيها قَضَى الحَرَقُ","تُجَاهَ سَفِينِهِمِ انطَلَقُوا",137,"ق",3,0],["وَلَمَّا عَلى مَرمَى القُنِيِّ تَدَانَيا","عَلَيهِ الهِرَقلِيُّ استَطالَ يَفاخِرُ",138,"ر",1,0],["ولَمَّا علا وَقعُ القَنا انقَضَّ عائِثاً","إِلَى ساحةِ الهَيجاءِ أَنياسُ يَلجَبُ",139,"ب",1,0],["ولما عنا جهدنا اكتملا","وحان لنا نقبض البدلا",140,"ل",2,0],["ولما على الإغريق فيبوس هاجها","وصاح بهم صوتاً يهد قوى الجسم",141,"م",1,0],["وَلَم اِعدد لِذاكَ الحي زادا","اِذ الاِظعان قَد قامَت بِحَملي",142,"ل",2,0],["ولم أعتب على علياك كلا","ولكني عتبت على نصيبي",143,"ب",2,0],["ولم أعجب إذا ما قد صدقتم","لنا بالوعد من دون العباد",144,"د",1,0],["ولم اعلم بانك من اناسٍ","ظموا قلبي وعندهم الشراب",145,"ب",1,0],["ولمّا عاينت عيناهُ زهواً","تأَلَّق من سنا ورد الخدودِ",146,"د",1,0],["ولمّا عن ذكاءٍ خصَّصوها","لانطون الكبير سَمَت سماها",147,"ا",3,0],["ولما على علياءَ سوريةٍ علا","دياجيرها زالت وضاءَ بها الفجرُ",148,"ر",1,0],["ولمّا عقلَناها وفي العقل سَكرةٌ","من الشوق لم تُشفع بَسكرة راح",149,"ح",1,0],["ولم أعرض فيه للمذاهب","لأن ذاك جالب المعاطب",150,"ب",1,0],["ولم أَعد أَخطر لهُ في بالِ","وشحَّ في الاخبار والتسآلِ",151,"ل",1,0],["وَلَم أُعاتِب صاحِباً إِلّا وَما","يَأتي بِهِ أَكثَرُ مِمّا قَدَّما",152,"م",2,0],["ولما علقت بأهدابه","تحسست بالندم الفاضح",153,"ح",1,0],["ولم أعلقْ بآمالٍ فأخشى","عليه من الضِّياع ومنْ نَفاد",154,"د",1,0],["ولم أعصِ الهوى فيكَ","كما لم أطعِ العذلا",155,"ل",2,0],["ولما عتوا زأر الناصحون","فلم يجد فيهم هناك الزئير",156,"ر",1,0],["ولما عفت دول بهنّ لهَت فبي","يتها الدمار فأصبحت تحت الثرى",157,"ر",2,0],["وَلَمْ أَعْلَمْ لَهَا وَزْنٓا","بِغَيْرِ الْعَقْلِ وَالْعِبَرِ",158,"ر",1,0],["ولَم أعبأ إذا ما جئت صفراً","من الأعمال في يوم المعاد",159,"د",1,0],["ولما عدت من نظم القوافي","تذكرت الصديق على الطريق",160,"ق",1,0],["وَلَمْ أَعْلَمْ صُدوراً مِنْ حَمامٍ","تُحَفِّزُ أَمْ حَماماً مِنْ صُدورِ",161,"ر",1,0],["ولم أعاتب حبيباً","كي لا يكون مجيبا",162,"ب",2,0],["ولم اعد لنصر الله سابحة","ولم أصلِّ سوى فرض ولم أصم",163,"م",1,0],["وَلَمَّا عَلَى بَابِ الحَبيبِ تَضَرَّعُوا","أقَامُوا عَلَى صِدقٍ وَأعيُنُهُم هَمْلُ",164,"ل",1,0],["ولما عفا عنه الحسين وخصه","بعين الرضا منه هوى ساجدا شكرا",165,"ر",2,0],["ولم أعرفْ لقافلتي غُدوّا","إلى بستان ِ غيركَ أو رُواحا",166,"ح",2,0],["وَلَمْ أَعْلَمْ بِأَرْضِي مِنْ سَمائِي","وَلا خَلْفِي أُمَيِّزُ مِنْ أَمامِي",167,"م",2,0],["[ وَلَمَّا عايَنَتْ لِلْبَيْنِ مِنْهُ","خِلالَ ضُلُوعِهِ الزَّفَراتِ تَتْرا ]",168,"ر",2,0],["ولم أعدّد من الأعلام من برزوا","قامات عزٍّ تساموا في المقامات",169,"ت",1,0],["ولما عيوب الراجل بس خلو الجيب...","أزاي الفقر ماهواش عيب.....",170,"ب",1,0],["ولمْ أعرفْ حقيقتَهُ","وقد قطَّعتُ أعمارا",171,"ر",2,0],["ولما عدلت عن الشراب لمبسم","ألفيت فيه الكأس والإبريقا",172,"ق",2,0],["ولمَّا عدتُ بالتفكيرِ أدعو","وجدتُ القومَ في لهوٍ مشينِ",173,"ن",1,0],["ولم أُعْطِ من كنوز أفكاري ورؤاي إلا دُرَّتينْ","أحسّ بأنني طيرٌ لم يطر بعد أكثر من ميلينْ",174,"ن",1,0],["ولم أعرفه طول العمرِ إلا","بروحي باشتياقٍ بي مثيري",175,"ر",2,0],["ولمّا عظمُها وهنتْ، وشابتْ","تراها بالدُّعا رفعتْ كتابا",176,"ب",2,0],["ولم أعاتبه في نفار","فإنه للظباء ديدن",177,"ن",1,0],["ولَمْ أعشَقِ الشِّعرَ أكثرَ مِنها","وما كُنتُ للحُبِّ -يَوماً- قَؤولا",178,"ل",2,0],["ولم أعلم بأن القلب قاسِ","وأذكر عهدنا إذ كنتَ ناسِ",179,"س",1,1],["ولّما عَبَثْنَ باَوتارِهِنَّ","قبيلُ التَّبَلُّجِ يقّظنَنِي",180,"ن",2,1]]}