35",""],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5561,"كيف السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=196513",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[5690,"اللّه يعطي والزمان يجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=172143",""],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5995,"أخلو به وأعف عنه كأنني","https://www.poetsgate.com/ViewPoem.aspx?id=112508",""],[6093,"فكل ساع له في سعيه وطر","https://www.poetsgate.com/ViewPoem.aspx?id=207056",""],[5309,"هذا هواك فودعي عهد الهوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573549",""],[6159,"شكراً جزيلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85857&r=&rc=3",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["كَالمَطايا أَقبَلَت مَرحولَةً","شَلَّها حادٍ إِذا أَنجَدَ غارا",0,"ر",2,0],["كَالمِسْكِ في لَوْنٍ وَفي أَرَجٍ","يُمْتارُ مِنْهُ العَنْبَرُ الشَّمِلُ",1,"ل",1,0],["كالماءِ والنارِ موجودَيْنِ في حَجَرٍ","والبَدْرِ في سُدَفٍ والدُّرِّ في صَدَفِ",2,"ف",1,0],["كالمُهْرِ إنْ طامَنْتَ منْ غَرْبِهِ","أشَمَّهُ المَيْعَةَ جِنُّ المِراحْ",3,"ح",1,0],["كَالمُدلِجِ الحَيرانِ في ال","بَيداءِ أَخطَأَهُ القَمَر",4,"ر",1,0],["كَالمِضرَحِيَّ عَدا فَأَصبَحَ واقِعاً","مِن قُدس فَوقَ مَعاقِلِ الأَوعالِ",5,"ل",1,0],["كَالمِسكِ تَخلِطُهُ بِماءِ سَحابَةٍ","أَو عاتِقٍ كَدَمِ الذَبيحِ مُدامِ",6,"م",1,0],["كالماءِ تأسِنُ بِئرُهُ إلا إذا","خبطَ السُّقاةُ جِمامَهُ بدِلاءِ",7,"ا",2,0],["كالمُتبع المدحَ بالهجاء إذا","ما المرءُ لم يَفْدِ عرضَهُ سَلَبُهْ",8,"ب",2,0],["كالمسْكِ مَجَّ الوردُ من مائِهِ","فيه وأذكاهُ به الجَدْعُ",9,"ع",1,0],["كالمسك يفخر منسوباً إلى ملك","وإن تواضع منسوباً إلى الفار",10,"ر",1,0],["كَالمَوجِ ضِحكي كَالضِياءِ تَرَنُّحي","كَالفَجرِ زَهوي كَالخِضَمِّ عُرامي",11,"م",2,0],["كَالماءِ وَالظالِعُ الصَديانُ يَطلُبُهُ","هُوَ الشِفاءُ لَهُ وَالرِيُّ لَو يَرِدُ",12,"د",1,0],["كالملاك البريءِ كالوردة البيضاءِ","كالموجِ في الخِضَمِّ البَعيدِ",13,"د",1,0],["كالمُشتَري قَد لَفّ مِن مريخِهِ","إِذ لَفَّهُ في الماءِ جَذوَةَ نارِ",14,"ر",1,0],["كَالمُستَعينِ المُستَعانِ الَّذي","تَمَّت لَهُ النُعمى بِإِفضالِهِ",15,"ل",2,0],["كَالمُزنِ إِن سَطَعَت لَوامِعُ بَرقِهِ","أَجلَت لَنا عَن ديمَةٍ أَو وابِلِ",16,"ل",1,0],["كَالمُزنَةِ اِستُؤنِفَت أولى مَخيلَتِها","ثُمَّ اِستَهَلَّت بِغُزرٍ تابَعَ الدِيَما",17,"م",2,0],["كَالمُلبِسِ الثَوبَ مِن عُريٍ وَعَورَتُهُ","لِلناسِ بادِيَةٌ ما إِن يُواريها",18,"ي",3,0],["كَالمُتَّقي قَطرَ السَحا","بِ وَحَولَهُ في الأَرضِ بَحر",19,"ر",1,0],["كالمندل الرطب من خصائصه","يضوع للناس وهو يحترق",20,"ق",1,0],["كَالمِسكِ شَيبَ بِذَوبِ النَحلِ يَخلِطُهُ","ثَلجٌ بِصَهباءَ مِمّا عَتَّقَت جَدَرُ",21,"ر",1,0],["كَالماءِ في السُحُبِ وَكَالدُرِّ في ال","أَصدافِ وَالشادِنِ في القَفرِ",22,"ر",1,0],["كَالمَشرَفيِّ خَلابَةً وَذَلاقَةً","أَو كَالزَمانِ تَسَهُّلاً وَتَصَعُّبا",23,"ب",2,0],["كالمَشرَفيّ العَضْبِ شاعَ فِرِنْدُهُ","وجَلَتْ مضارِبَهُ أكُفُّ قُيونهِ",24,"ن",2,0],["كالمُزْنِ يَدلحُ فالرُّعودُ غَماغِمٌ","في حَجرْتَيْهِ والبُروقُ منَاصل",25,"ل",1,0],["كَالمِسكِ إِن بُزِلَت وَالسَبكِ إِن سُكِبَت","تَحكي إِذا مُزِجَت إِكليلَ مَرجانِ",26,"ن",1,0],["كَالمَأجَنِ المَستورِ إِذ زُرتُهُ","في دارِ مُلكٍ لَبطُها راعِبُ",27,"ب",1,0],["كَالمُزنِ مِن ماضي الرَبابِ وَمُقبلٍ","مُتَنَظَّرٍ وَمُخَيِّمٍ مُتَهَلِّلِ",28,"ل",1,0],["كالمرائي لا بسا شفافة","للتقى فوق فؤاد دغل",29,"ل",1,0],["كالمارد الجبار منطرح","على صدر الرغام",30,"م",1,0],["كالمِلح يُحسَبُ سُكَّراً في لونهِ","أَو حجمهِ ويَحولُ عند مَذاقِهِ",31,"ه",1,0],["كَالمُحَبَّينِ لَو أَطاقا اِلتِقاءً","أَفرَطا في العِناقِ وَالاِلتِزامِ",32,"م",1,0],["كالمنى في القلوب كالدم في الأبدان","كالسكر في دماغ المعاقر",33,"ر",1,0],["كالمشمش ماتت واقفة","لتعد الميلاد الأخضر",34,"ر",1,0],["كالموج تحت العاصف المجتاح","والنّهد وهو مطلق السّراح",35,"ح",1,0],["كالمسْكِ مَجَّ الوردُ من مائِهِ","فيه وأذكاهُ به الجَدْحُ",36,"ح",1,0],["كالمسك يفخر منسوباً إلى ملك","وإن تواضع منسوباً إلى القار",37,"ر",1,0],["كالمُزنِ منْ ماضي الربابِ ومُقبلٍ","مُنْتَظَّرٍ ومُخَيم مُتَهلِلِ",38,"ل",1,0],["كال ما ضيك قد وسعت بحلمي","غير ما جئت ليلة الأربعاء",39,"ا",2,0],["كالمَرْخِ يُبدٍي الاخْضرارَ غصونُه","والنارُ في جنبيْهِ ذاتُ كُمونِ",40,"ن",1,0],["كالمشرفيِّ إذا أغمدت في فُرُشي","وإن نُفضتُ منَ الحُمّى فكليزَني",41,"ن",2,1],["كالماءِ والنارِ جَرى والتظى","كالريحِ والتُّرب سَما وارجَحَنْ",42,"ن",1,0],["كَالمَجدَلِ العادِيِّ إِلّا أَنَّهُ","يُمرى فَيَنقَضُّ اِنقِضاضَ الأَجدَلِ",43,"ل",1,0],["كالمسك ضاع لنا وضاع مكانه","عنا فأغنى نشره عن نشره",44,"ه",1,0],["كالمِبْرد المنقوش نَقْشاً خَفَّفت","آثارَ مَوْقِعه يَدا ضُرَّابه",45,"ب",2,0],["كالمرتضى شمس المعالي مَنْ حَبا","كَ اللهُ منه بكلِّ ما تختار",46,"ر",1,0],["كالمُبتغِى كَيْلَ ماءِ البحرِ في لُججٍ","وحاسبِ القَطْرِ في مُستغزِر الدِّيَم",47,"م",1,0],["كالموجِ مهما همَّ في وثبهِ","تراهُ ينحلُّ على الساحلِ",48,"ل",1,0],["كَالمَناراتِ تَبعَثُ النورَ فياللي","لِ وَتَشقى في الشاطىءِ المَهجورِ",49,"ر",1,0],["كَالمرأَةِ البَغيِّ في مُقلَتها","عُنصُرُ نارٍ قُدَّ من شَهوَتِها",50,"ه",2,0],["كالمُقْلة الدعجاء زنجيَّة","كافرة لَمْعَ نجوم المدار",51,"ر",1,0],["كالمسك نَشْراً والبرق مبتسَما","والغصن قدّاً والحِقْف مؤتَزرا",52,"ر",2,0],["كالماء في صَرْحٍ له ممرَّد","يحسبه الغائب ما لم يَشهَد",53,"د",1,0],["كَالمِسكِ نَكهَتُهُ وَأَطيَب مَخبَراً","ما خالَ عَنهُ بِطيبِها البَردانِ",54,"ن",1,0],["كَالماءِ ما في نَظمِهِ","كَلٌّ وَلا تَكَلُّفُ",55,"ف",1,0],["كَالماءِ شيبَت بِهِ الرا","حُ وَهوَ عَذبٌ نَميرُ",56,"ر",1,0],["كَالماءِ إِلّا أَنَّها","مِن قُوَّةِ الأَلفاظِ جَلمَد",57,"د",1,0],["كَالمُدامِ الشَمولِ يَحدُثُ في عِط","فِ السَخِيِّ الكَريمِ مِنها اِنتِشاءُ",58,"ا",2,0],["كالماء جسماً حيثما لاحظته","ألفيت من شبحي به تمثالا",59,"ل",2,0],["كالمُزْنِ مَصْدَرُهُ في إِ