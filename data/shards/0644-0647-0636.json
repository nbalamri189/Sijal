{"poems":[[53,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[47,"أراد سلوا عن سليمى وعن هند","https://www.aldiwan.net/poem63510.html","الطويل"],[124,"ما أفصح اللحظ يا حبيبي","https://www.aldiwan.net/poem49361.html","مخلع البسيط"],[159,"له ضاحك برقه خاطف","https://www.aldiwan.net/poem55544.html","المتقارب"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123436","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119256","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19975","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11951","المتقارب"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137324",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100225","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115486","السريع"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""]],"verses":[["له ضحكاتٌ حين يُسألُ حاجةً","إذا كثُرت من غيرِهِ الضَّجراتُ",0,"ت",1,0],["لَهُ ضِحكَةٌ عِندَ النَوالِ كَأَنَّها","تَباشيرَ بَرقٍ بَعدَ بُعدٍ مِنَ العَهدِ",1,"د",1,0],["له ضياءٌ إذا ترامى","على النجيات والشجون",2,"ن",1,0],["لَهُ ضاحِكٌ بَرْقُهُ خَاطِفٌ","عُقُولَ الرِّجالِ إِذا مَا ابْتَسَمْ",3,"م",1,1],["له ضِحْكُ مَسرورٍ ودَمعةُ ثاكِلٍ","وعِزَّةُ مَعشوقٍ وذِلَة عاشق",4,"ق",1,0],["له ضوء شمس في رطوبة لؤلؤ","ولفظ به قس يقيس ويعرب",5,"ب",1,0],["لَهُ ضَحكَةٌ تَستَغرِقُ المالَ بِالنَدى","عَلى عَبسَة تُشجى القَنا بِالتَرائِبِ",6,"ب",1,0],["لَهُ ضَيعَةٌ كُلَّما أَمحَلَت","يَعيشُ وَإِن أَخصَبَت ماتَ جوعا",7,"ع",2,0],["له ضحكت برمانا وسرت","وازهرت المغاني والرسوم",8,"م",1,0],["له ضروب من الفعل الجميل وذا","ضرب لهمته أحلى من الضرب",9,"ب",1,0],["له ضلوع قلّما تنطوى","على لظى مع أنها قادحَه",10,"ح",2,0],["له ضياء يستبيح الليلا","تدعوه أعراب العلا سهيلا",11,"ل",2,0],["له ضربة لا يعجم القوم حرفها","بها يعرب في الحرب تضرب أمثالا",12,"ل",2,0]]}