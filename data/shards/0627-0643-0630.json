3090","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76739","الطويل"],[4830,"أذكى الحياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=200328",""],[4858,"مصير الصحفي","https://www.poetsgate.com/ViewPoem.aspx?id=29942",""],[4858,"حتّامَ هذا القتلُ ؟ّ","https://www.poetsgate.com/ViewPoem.aspx?id=138194",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4858,"يا غافلينَ عن الأسير وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=138315",""],[4860,"غٌربة مُواطن","https://www.poetsgate.com/ViewPoem.aspx?id=32519",""],[4902,"ياطاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=18514",""],[5002,"حقبةُ الألم.....","https://www.poetsgate.com/ViewPoem.aspx?id=210848",""],[5013,"أكذا تكون جناية الأقدار","https://www.poetsgate.com/ViewPoem.aspx?id=170961",""],[5121,"عَجَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33572",""],[5158,"شف لي طريقة","https://www.poetsgate.com/ViewPoem.aspx?id=58966",""],[5219,"أوهام وأوهام","https://www.poetsgate.com/ViewPoem.aspx?id=194031",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[5324,"لا تبتئس وطني .","https://www.poetsgate.com/ViewPoem.aspx?id=207470",""],[404,"دُمُوْعُ امرأةٍ من ميانْمارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191589",""],[5455,"غربة أعياد","https://www.poetsgate.com/ViewPoem.aspx?id=34466",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5464,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=6687",""],[5758,"وَهْمُ القَصِيدَة","https://www.poetsgate.com/ViewPoem.aspx?id=200521",""],[5764,"الليل فضّاح","https://www.poetsgate.com/ViewPoem.aspx?id=137062",""],[5764,"رجلي وبابك","https://www.poetsgate.com/ViewPoem.aspx?id=191426",""],[5848,"ضحكه وتنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=51951",""],[5848,"حزني واعرفه زين","https://www.poetsgate.com/ViewPoem.aspx?id=53358",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5944,"أيها الناي","https://www.poetsgate.com/ViewPoem.aspx?id=212711",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[6003,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200570",""],[6120,"‏أُكذُوبَةُ الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=213466",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6249,"حبٌّ مختَلَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85657&r=&rc=0",""]],"verses":[["أَكَذا تَذوبُ عَلَيكُمُ","نَفسي وَما بَلَغَت مُناها",0,"ا",3,0],["أَكَذا المَنونُ تُقَنطِرُ الأَبطالا","أَكَذا الزَمانُ يُضَعضِعُ الأَجيالا",1,"ل",2,1],["أَكَذا تُصابُ الأُسدُ وَهيَ مُذِلَّةٌ","تَحمي الشُبولَ وَتَمنَعُ الأَغيالا",1,"ل",2,0],["أَكَذا تُقامُ عَنِ الفَرائِسِ بَعدَما","مَلَأَت هَماهِمُها الوَرى أَوجالا",1,"ل",2,0],["أَكَذا تُحَطُّ الزاهِراتُ عَنِ العُلى","مِن بَعدِ ما شَأَتِ العُيونَ مَنالا",1,"ل",2,0],["أَكَذا تُكَبُّ البُزلُ وَهيَ مَصاعِبٌ","تَطوي البَعيدَ وَتَحمِلُ الأَثقالا",1,"ل",2,0],["أَكَذا تُغاضُ الزاخِراتُ وَقَد طَغَت","لُجَجاً وَأَورَدَتِ الظِماءَ زُلالا",1,"ل",2,0],["أَكذِبُ إِن صَدَّقتُهُ بَعدَما","عَرَفتُ مِنهُ الكَذِبَ في وَعدِهِ",2,"د",2,0],["أَكَذا نَموت وَتَنقَضي أَحلامُنا","في لَحظَة وَإِلى التُرابِ نَصيرُ",3,"ر",1,0],["أَكَذا يُجازي الآمِنونَ بُدورِهِم","أَو هَكَذا قَد جاءَ في القُرآنِ",4,"ن",1,0],["أَكَذا يَقودُ بِكَ الأَسى نَحوَ الرَدى","وَالعُودُ عُودٌ وَالشَمولُ شُمولُ",5,"ل",1,0],["أَكَذَّبتُ طَرفي أَم رَأَيتُ بِذي الغَضا","لِبَثنَةَ ناراً فَاِرفَعوا أَيُّها الرَكبُ",6,"ب",1,0],["أكذا تقر البيض في الأغماد","أكذا تحين مصارع الآساد",7,"د",1,1],["أُكَذِّبُ ظَنّي بِأَن قَد سَخِط","تَ وَما كُنتُ أَعهَدُ ظَنّي كَذوبا",8,"ب",2,0],["أكذِّبُ أنَّ النَّأيَ حَتفُ مُتَيَّمٍ","فألفيتُه حَتفاً ولستُ مُتَيَّمَا",9,"م",2,0],["أَكَذا يَكونُ خِطابُ إِخوانِ الصَفا","إِن راسَلوا جَعَلوا الخِطابَ خُطوبا",10,"ب",2,0],["أَكذا تُغادَرُ للخطوبِ تَنوشُها","وَتمدُّ أَيديها إِلى حَوبائِها",11,"ا",3,0],["أَكَذاكَ زَعمُكَ يا ابنَ عَوفٍ إنّها","لكبيرةٌ بل أنتَ وَيْحَكَ تَلعبُ",12,"ب",1,0],["أَكذاكَ ينخدِعُ الغبيُّ وهكذا","يَتَخَبَّطُ المفتونُ في أوهامِهِ",13,"م",2,0],["أكذاكَ تَختلفُ الزُّروعُ فناضرٌ","ضَافِي الظّلالِ وذابلٌ يَتصوَّحُ",14,"ح",1,0],["أَكَذا سَريعاً صارَ حَب","لُكَ سَيِّدي مُتَنَقَّضا",15,"ض",2,0],["أَكَذَّبَ القَومُ بِالميزانِ أَن سَمِعوا","أَنَّ القِيامَةَ فيها عادِلٌ يَزِنُ",16,"ن",1,0],["أكذا أنتَ أيها الزمن الحا","قدُ تغتال نشوة اللحظاتِ",17,"ت",1,0],["أكذا أنت ذاهبٌ بليالي الص","صَفوِ عنا سريعةَ الخطواتِ",17,"ت",1,0],["أكذا تنقضي حلاوةُ نعما","ها كما ينقضي شقاءُ الحياةِ",17,"ه",1,0],["أكذا الجِيادُ إذا أرَادَتْ مَوْرداً","نَضَبَ الفُراتُ لها وغاض النّيلُ",18,"ل",1,0],["أَكَذَاكَ يَخْتِمُ فِي الشَّقَاءِ حَيَاتَهُ","مَنْ كَانَ جَمَّ الْجَاهِ وَالإِيسَارِ",19,"ر",1,0],["أَكَذَا يُقْطَعُ النَّظِيمُ مِنَ","العِقْدِ وَيُلْقَى بِدُرِّهِّ مَنْثُورَا",20,"ر",2,0],["أَكَذَا نِهَايَةُ ذَلِكَ الْجُهْدِ","أَكَذَا خِتَامُ السَّعْيِ وَالْجِدِّ",21,"د",1,1],["أَكَذَا المَآثِرُ فِي نَتَائِجِهَا","أَكَذَا المَفَاخِرُ آخِرَ العَهْدِ",21,"د",1,0],["أَكَذاكِ يُلْقَى في نَجَا","سَاتِ المَوَاطيءِ بالأَزَاهرْ",22,"ر",1,0],["أَكَذَا يَكُونُ الْحُكمُ فِي سَادَاتِهِ","أَكَذَا يَكُونُ البَأْسُ فِي الآسَادِ",23,"د",1,0],["أَكَذَا نَدَى الْيَدِ وَهْوَ شَافٍ كَالنَّدَى","أَكَذَا الْعَزِيمَةُ وَهْيَ قَدْحُ زِنَادِ",23,"د",1,0],["أَكَذَا القَضَاءُ فَمَا تَكَبُّرُ شَامِخٍ","مُغْنٍ لَدَيْهِ وَلاَ تَطَامُنُ وَادِ",23,"د",1,0],["أَكَذَا الإِدَالَةُ فِي سَبِيلِ العَدْلِ مِنْ","سَيْفِ الأميرِ لِمِنْجَلِ الحصَّادِ",23,"د",1,0],["أَكذِبُ وَاللَهِ عَلى أُمِّهِ","كَكِذبِهِ أَيضاً عَلى أُمّي",24,"م",2,0],["أكذاك تُؤويه الملاجئ مثلما","تؤوي اليتيمَ، وتكفل المسكينا؟",25,"ن",2,0],["أكذا يكون على الوداد جزاؤها","أم لست من ابنائها الأمجاد",26,"د",1,0],["أكذا مصِيرُكَ للضَريحِ","ولا اعتراضٌ منكَ يبدو",27,"د",2,0],["أكذا النهاية يا لَعُقبى","ما لها في الخَلقِ بُدُّ",27,"د",1,0],["أكذا آخر الحياة يكونُ","وإلى الموتِ ينتهي التكوينُ",28,"ن",1,1],["أكذا يُجازَى ودُّ كلّ قرينِ","أم هذه شيمُ الظباءِ العِين",29,"ن",1,1],["أكذا الهوى ومذاقه في فجره","ما كان أحلى الحب عند المولدِ",30,"د",1,0],["أَكذا يُبادُ حلاحلٌ ومهذَّبٌ","أَكذا يُنالُ مُسَوَّدٌ وهمام",31,"م",1,0],["أَكذَبُ الناسِ إِذا آ","لى يَميناً بِالطَلاقِ",32,"ق",1,0],["أَكذبٌ في المَديحِ وَفي العَطايا","لَعمرِكَ ذاكَ خُسرانٌ كَبيرُ",33,"ر",1,0],["أكذا النفوس إذا عشقن الأنفسا","تعيي الأساة ضناً ويعييها الأسى",34,"س",2,1],["أكذا نموتُ لكي نفوزَ بقبلةٍ","كانت على ظمأ الغرامِ لهيبا",35,"ب",2,0],["أكذاكَ سرُّكِ أن تريهِ آكلا","مما بذَلتِ له ومما صانا",36,"ن",2,0],["أكذا نقَضتِ عُهودَ أشرَفِ أُمّةٍ","وبَعثتِ أشراراً لخيرِ مَليك",37,"ك",1,0],["أكذبت أحسنَ ما يظنُّ بي الهوى","ولقيت داعي الوجدِ بالهجرانِ",38,"ن",1,1],["أَكذِبُ طَريفي فيكَ وَالطَرفُ صادِقُ","وَما بَعدَ مَشهودٍ مِنَ العَينِ مُقنِعُ",39,"ع",1,1],["أكذاك كل مفارق أم لم يكن","قبلي محب فارق الأحبابا",40,"ب",2,0],["أَكَذا كُلُّ غائِبٍ","غابَ عَمَّن يُحِبُّهُ",41,"ه",1,1],["أَكَذا طالَت بِكَ الغَف","لَةِ عَما بتُّ أَلقَى",42,"ق",2,0],["أكذِّب أخبارَ النعاةِ تَزَوُّراً","على أنَّ تكذيبَ الحقائقِ زُورُ",43,"ر",1,0],["أكذا سَلِمتُم من تَباريح الهوى","حتى ولا أحدٌ أراهُ مُساعِدي",44,"د",2,0],["أَكذا يكونُ جزاءُ مَن حفظ الهوى","ورعَى عهودكَمُ يُهَانُ ويُبْعَدْ",45,"د",1,0],["أكذَا حَبِيبُ الله يا أهلَ الشقَا","وحَبيبُ خير الرسْلِ يُنْبذُ بالعَرا",46,"ر",2,0],["أكذوبة ميّتة يخاف أن يبعثها كلامُهُ","ناشرة الفودين, مرخاة الزمام",47,"م",1,0],["أكذا يجازى ودّ كل متيمٍ","بالحب أم ذي شيمة الغزلان",48,"ن",1,0],["أكذبت من حبي ويقضهم","من قال إن الحبّ مشترك",49,"ك",1,0],["أكذبتَ ظنّ السحاب الجون من نعمٍ","روّيت منها الورى بالعلّ والسهل",50,"ل",1,0],["أكذبت ظنّ الأعادي بالذي كملت","به السعادة واستهتى لك الخطر",51,"ر",1,0],["اكذب خداع وشر الورى","باغ غدا يظلم فنيانها",52,"ن",3,0],["أكذبتُ قالةَ أيامي وقد زعَمت","للضيم أنّ زعيم الملك يُسلِمني",53,"ن",2,0],["أكذا أخافُ الحادثاتِ وأنت","منتجعي وألقاها بقلبِ جبان",54,"ن",1,0],["أكذاك تعزُّ متى ذلُّوا","لهواك وتمنعُ أن طلبوا",55,"ب",3,0],["أكذبك الله بما افتريته","عليهما في ذاك وادعيته",56,"ه",1,0],["أَكَذا بِلاَ سَبَبٍ ولا ذَنْبِ","تُبْدِي الصُّدُودَ لِمُغْرَمٍ صَبِّ",57,"ب",1,1],["أكذبتها عزمة ظهرت","لا تبالي نفس من سفكتْ",58,"ت",1,0],["اكذا يُعامَل قلبُ حرٍّ عاشقٍ","قد ذاق انواع العذاب بحبّهِ",59,"ب",2,0],["أكذا وفاكَ للاثمٍ","ايديك من وجدٍ وفاك",60,"ك",1,0],["اكذا كلُّ الغواني","ليس يرعين الودادا",61,"د",2,0],["أكذا يغرس المودة من شا","ءَ حليفاً على الزمان عتيدا",62,"د",2,0],["أُكَذِّبُ طَرفي عَنكِ في كُلِّ ما أَرى","وَأُسمِع أُذني مِنكِ ما لَيسَ تَسمَعُ",63,"ع",1,1],["اكذب الناصح الصدوق ارتياب","اين للصب ما يزيل ارتيابه",64,"ب",2,0],["أَكْذَبْتَ ما ظنَّهُ مِنْ سَلْبِ مُهْجتِهِ","مِنْهُ وصدَّقْتَ مَنْ سَمَّاكَ محمودا",65,"د",2,0],["أكذاك تبكر في علاك وتمطر","يا غيث ملكك لك ملكك مزهر",66,"ر",1,1],["أكذا يصبح الموالي عبيداً","أكذا يحكم العبيد الموالي",67,"ل",2,0],["أكذا ينقضي مع الصفو ليلي","ومع الهم يستجد نهاري",68,"ر",2,0],["أكذا جزا سهري عليك بان ترى","شوقي اليك بمقلة الغفلان",69,"ن",1,0],["أكذا تعامل والديك وهكذا","اوصى الاله بما حوى اللوحان",69,"ن",1,0],["أكذا يكون مجاور الغزلانِ","عينٌ مسهدةٌ ودمعٌ قاني",70,"ن",2,1],["أكذا وفا الأحباب يرجع خائباً","من وصلها الداني ويحظى القاصي",71,"ص",2,0],["أكذَبَ الحِسَّ بِجَمَالٍ وَقَدْ","كَانَ مَشهُوراً كَيَوم الجَمَلِ",72,"ل",1,0],["أكذا بدور الحسن لم","تبرح لها الخطى قامه",73,"م",2,0],["أكذا شيمة أحداث الليالي","شَنُّ غارات وإرهاف نصالِ",74,"ل",1,1],["أكذا تسمو المقادير إلى","هضبات المجد في أعلى جبالِ",74,"ل",1,0],["أكذا تهوي بدور التِّمِّ من","أفق العلياء من بعد كمال",74,"ل",1,0],["أكذا يَقْنِصُ آسادَ الشَّرَى","قدرٌ يرخص منها كلّ غال",74,"ل",1,0],["أكذا تخسف أقمار الهدى","أكذا تنسف أطواد المعالي",74,"ل",2,0],["أكذا يُدَكْدَكُ كلُّ طود شامخ","أكذا يُغَيَّضُ كلُّ بحر مزبد",75,"د",1,0],["أكذا النجوم النيرات تزول عن","آفاقها حتى يضلّ المهتدي",75,"د",2,0],["أكذا تمدّ النائبات يداً إلى","شرف على قلل النجوم موطَّد",75,"د",1,0],["أكذا المنازل بعد طول أنيسها","تمسي وتصبح كاليباب الفدفد",75,"د",1,0],["أكذا يهد الدهر أطواد الهدى","ويرد بالنكبات شاردة الردى",76,"د",2,1],["أكذا تغيب النيرات وينطفي","ما كان من أنوارها متوقدا",76,"د",2,0],["أَكَذا تَصنَعُ الصَّبابَةُ أَم عا","دَ عَلَينا الصِّيامُ في شَوّالِ",77,"ل",1,0],["أ