 لِلمُستَجيرِ جارٌ وَلِلرا","جي مَلاذٌ وَلِليَتامى ثِمالُ",121,"ل",1,0],["أَنتَ لِلبائِسِ الفَقيرِ إِذا أَم","لَقَ مالٌ وَلِلطَريدِ مَآلُ",121,"ل",1,0],["أَنتَ لِما سَنَّهُ الأَئِمَّةُ أَع","لامُ الهُدى مُقتَفٍ وَمُتَّبِعُ",122,"ع",1,0],["أَنتَ لِلدينِ خَيرُ مُستَخلَفٍ را","عٍ وَلِلمُؤمِنينَ خَيرُ أَميرِ",123,"ر",1,0],["أَنْتَ لِلأَعْيَادِ عِيدٌ وَزَيْنٌ","فَهَنِيئاً بِسَنَاكَ لِعِيدِ",124,"د",1,0],["أنتَ ليلُ الحادِثاتِ وإن","كنتَ نورَ الصُبحِ في النظرِ",125,"ر",1,0],["أنتِ لُغْزٌ في حياتي","في المآسي ، أيُّ ضرْبِ؟",126,"ب",1,0],["أنت لي موئل وحصن حصين","فيه لي مطلب ولي منه قثو",127,"و",1,0],["أَنْتَ لِلْمُسْلِمِينَ حِصْنٌ وَحِرزُ","وَلِراجِي نَداكَ ذُخْرٌ وَكَنْزُ",128,"ز",1,1],["أَنتَ لَو مارَزَتكَ أُسدٌ ضَوار","هَوَتِ الأُسدُ في مَهاوي المَهالِك",129,"ك",1,0],["إِن تلفهُ في السلمِ تبصر حاتماً","أو شِمتَهُ في الحربِ شمتَ غَضَنفرا",130,"ر",2,0],["أنتَ لا تَعرِف إيَّاكَ ولاَ","تَدري مَن أنتَ وَلاَ كَيفَ الوُصُولُ",131,"ل",1,0],["إِن تَلقَهُ الأَسَدُ في آجامِها تَجِمِ","فَبَأسُهُ حاصِلٌ مِن بَأسِ مُقتَدِرِ",132,"ر",1,0],["إِن تَلقَ بَلوى فَصابِرٌ أَنِفٌ","وَإِن تُلاقِ النُعمى فَلا فرِحُ",133,"ح",1,0],["أنت لحنٌ في حياتي خالد","وأنا والكون للّحن صدى",134,"د",2,0],["أنت لا زلت في الضمائر حيّا","خالداً مشرقاً برغم الملمات",135,"ت",1,0],["انت لا تبدين الا","في شفاه وعيون",136,"ن",1,0],["إِنَّ تِلكَ الَّتي تَرَي","نَ سَبَتني بِوارِدِ",137,"د",1,0],["إن تلك التي أحن إليها","وعذابي وراحتي في يديها",138,"ي",3,1],["اِن تلوموا أَولا تَلوموا فاني","مُغرَم مُغرم بِغَير نِزاع",139,"ع",1,0],["أنت لم تَحْوِ مِثْلَك الخَلْقُ شَخْصاً","وهْو لم يَحْوِ مثْلَه العامُ شَهرا",140,"ر",2,0],["أنت للعيِد وهْو للنّاسِ عيدُ","صاحبٌ مُسعِدٌ ويومٌ سعيدُ",141,"د",1,1],["أنت لولاك كان للناسِ في الأف","واهِ ذِكْرُ الكريمِ كالعَنقاء",142,"ا",2,0],["إِن تَلتَمِس دَرَكَ الجَحيمِ فَعادِهِ","أَو تَلتَمِس دَرَكَ النَسيمِ فَوالِهِ",143,"ل",2,0],["أنتِ ليَ الكلُّ إذ كلي لكِ أبداً","وأنت في الكل عن عينيَّّ لم تَغِب",144,"ب",1,0],["أنتَ لا تسألُ العبادَ، ولكنْ","تسألُ الله رازقاً وهَّابا",145,"ب",2,0],["إن 