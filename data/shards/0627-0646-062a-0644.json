ِلمُؤمِنينَ خَيرُ أَميرِ",122,"ر",1,0],["أَنْتَ لِلأَعْيَادِ عِيدٌ وَزَيْنٌ","فَهَنِيئاً بِسَنَاكَ لِعِيدِ",123,"د",1,0],["أنتَ ليلُ الحادِثاتِ وإن","كنتَ نورَ الصُبحِ في النظرِ",124,"ر",1,0],["أنتِ لُغْزٌ في حياتي","في المآسي ، أيُّ ضرْبِ؟",125,"ب",1,0],["أنت لي موئل وحصن حصين","فيه لي مطلب ولي منه قثو",126,"و",1,0],["أَنْتَ لِلْمُسْلِمِينَ حِصْنٌ وَحِرزُ","وَلِراجِي نَداكَ ذُخْرٌ وَكَنْزُ",127,"ز",1,1],["أَنتَ لَو مارَزَتكَ أُسدٌ ضَوار","هَوَتِ الأُسدُ في مَهاوي المَهالِك",128,"ك",1,0],["إِن تلفهُ في السلمِ تبصر حاتماً","أو شِمتَهُ في الحربِ شمتَ غَضَنفرا",129,"ر",2,0],["أنتَ لا تَعرِف إيَّاكَ ولاَ","تَدري مَن أنتَ وَلاَ كَيفَ الوُصُولُ",130,"ل",1,0],["إِن تَلقَهُ الأَسَدُ في آجامِها تَجِمِ","فَبَأسُهُ حاصِلٌ مِن بَأسِ مُقتَدِرِ",131,"ر",1,0],["إِن تَلقَ بَلوى فَصابِرٌ أَنِفٌ","وَإِن تُلاقِ النُعمى فَلا فرِحُ",132,"ح",1,0],["أنت لحنٌ في حياتي خالد","وأنا والكون للّحن صدى",133,"د",2,0],["أنت لا زلت في الضمائر حيّا","خالداً مشرقاً برغم الملمات",134,"ت",1,0],["انت لا تبدين الا","في شفاه وعيون",135,"ن",1,0],["إِنَّ تِلكَ الَّتي تَرَي","نَ سَبَتني بِوارِدِ",136,"د",1,0],["إن تلك التي أحن إليها","وعذابي وراحتي في يديها",137,"ي",3,1],["اِن تلوموا أَولا تَلوموا فاني","مُغرَم مُغرم بِغَير نِزاع",138,"ع",1,0],["أنت لم تَحْوِ مِثْلَك الخَلْقُ شَخْصاً","وهْو لم يَحْوِ مثْلَه العامُ شَهرا",139,"ر",2,0],["أنت للعيِد وهْو للنّاسِ عيدُ","صاحبٌ مُسعِدٌ ويومٌ سعيدُ",140,"د",1,1],["أنت لولاك كان للناسِ في الأف","واهِ ذِكْرُ الكريمِ كالعَنقاء",141,"ا",2,0],["إِن تَلتَمِس دَرَكَ الجَحيمِ فَعادِهِ","أَو تَلتَمِس دَرَكَ النَسيمِ فَوالِهِ",142,"ل",2,0],["أنتِ ليَ الكلُّ إذ كلي لكِ أبداً","وأنت في الكل عن عينيَّّ لم تَغِب",143,"ب",1,0],["أنتَ لا تسألُ العبادَ، ولكنْ","تسألُ الله رازقاً وهَّابا",144,"ب",2,0],["إن تَلْقَهمْ تَلْقَ أحْباراً جَهَابذةً","أو طاعنين العدا شَزراً ورامينا",145,"ن",2,0],["إن تلوت القرآن لاقيته في","ه مقيماً في معجز الآيات",146,"ت",1,0],["أنتِ لِمْ أضنَيْتِ صَبّاً","بِكِ دونَ الخَلقِ لاذا",147,"ذ",2,0],["أنتَ للرائد روضٌ أنُفٌ","وزلال المنهل العذب لظامي",148,"م",2,0],["أنتَ للناس جميعاً مَوْرِدٌ","ولها منك وُرودٌ وصُدور",149,"ر",1,0],["أنتَ للناس لعمري منهلٌ","ونداك السائغُ العذب النمير",149,"ر",1,0],["أنتَ للحقّ واليقين صباح","راح يجلو ليلاً من الشك فاحم",150,"م",1,0],["أنت لا غيرك الإمام لقوم","سلكوا في الندى سبيل المكارم",150,"م",1,0],["أنت للمجد رفعةٌ وارتفاعٌ","ولك المجد دارة واستداره",151,"ر",2,0],["أنت للمجد والمكارم رب","وهمام على المعالي أميرُ",152,"ر",1,0],["إِنْ تَلاقَيْتَها فأَنْفسُ نَفْسٍ","لَكَ أَسْنى حُلِيِّها وحُلاها",153,"ا",3,0],["إِن تَلُمني عَجائِزٌ مِن نِزارٍ","فَأَراني فيما فَعَلتُ مُجيدا",154,"د",2,0],["أنت لها أو رجُلٌ منكُمُ","والناسُ أكَّالٌ ومستاثِرُ",155,"ر",1,0],["أنت لها بعدَ أبيك ثُغرةٌ","غيرُك لا يكون من سِدادِها",156,"د",3,0],["أنتَ لها فاشدد يميناً بها","اَلأخُ وابنُ العمِّ والصاحبُ",157,"ب",1,0],["إن تلقهم والأفقُ كابٍ لونهُ","تلقَ الفضائل والفواضل والقِرى",158,"ر",2,0],["أَنْتَ لهُ مِلْكٌ فكُنْ","رَهناً لأَمرِ من مَلَكْ",159,"ك",1,0],["أنْتَ لا تَفْحَصُ عَنْ عَيْبِ امْرِىءٍ","تَبَّ مَنْ ظلَّ لِعَيْبٍ يَفْحَصُ",160,"ص",1,0],["إن تَلْقَ مِنْهُمْ واحِدا","تَظُنَّ ذَاكَ السَّيّدا",161,"د",2,0],["أنت لِلمَجدِ قد خُلِقتَ وهذي","آيةُ المَجدِ في الجَبينِ سُطورا",162,"ر",2,0],["أنتَ لو كنتَ في الحقيقةِ صبّاً","بكَ ما تدَّعي من البُرحَاء",163,"ا",2,0],["إنْ تُلفِهِ للمرء مستركباً","فهوَ الّذي تَلقاه مُستنزلا",164,"ل",2,0],["أنت لا شيءَ وهو شيءٌ عظيم","فاشتغل بالوفا لفكِّ رهونه",165,"ن",2,0],["أنت لا أنت أنا لست أنا","ما خرجنا نحن عن محض الفنا",166,"ن",2,0],["أنت لا نحن كلنا","نحن ما أنت قاذف",167,"ف",1,0],["أنت لا تستطيع أنك تهدي","عبد رب قد ضل عن معبوده",168,"د",2,0],["أَنْتَ لَم تَمْرَضْ وَلَكِنْ","أَحْسَبُ الوُدَّ مَرِيْضَا",169,"ض",2,0],["أنت لم تَعْتَلَّ لكنَّ العُلا","والنّدى اعتلاَّ وذا شئٌ عَجَبْ",170,"ب",1,0],["أنت لا تعرف إياك ولا","تدر من أنت ولا كيف الوصول",171,"ل",1,0],["أَنت لي ماءُ الحَياةِ ومَا","قَالَهُ الواشُون كالزَّبَد",172,"د",1,0],["أَنْت لي مُنجبٌ وشَأْنُك عَال","بنجيبٍ مِني وشَانيك أَبْتَر",173,"ر",1,0]]}