l","المديد"],[578,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[759,"","https://poetry.dctabudhabi.ae/diwan/poem/31386","الكامل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10422","الكامل"],[963,"","https://poetry.dctabudhabi.ae/diwan/poem/96103","البسيط"]],"verses":[["أَنتَ لِلدُنيا وَلِلدي","نِ مِساكٌ وَنِظامُ",0,"م",1,0],["أَنتَ لا غَيرُكَ الهَوى","مِن جَميعِ الخَلائِقِ",1,"ق",1,0],["أَنتَ لَعَمري عارِفٌ أَنَّني","لا أَجِدُ الراحَةَ حَتّى أَراك",2,"ك",1,0],["أنْتَ لم تأمَنِ الهَوى","لا تُعَيّرْ فَتُبْتَلَى",3,"ل",2,0],["أَنْتَ للْمُسْلِمِينَ خَيْرُ عِمَادِ","وَمَلاَذٍ وَأَيُّ حِرْزٍ حَرِيزِ",4,"ز",1,1],["أَنتَ لا تَعرِفُ الغَرامَ وَإِن كُن","تَ تُرينا زَفيرَ أَهلِ الغَرامِ",5,"م",1,0],["أَنتَ لا تَعرِفُ الحَنينَ إِلى الإِل","فِ فَما هَذِهِ الدُموعُ الهَوامي",5,"م",2,0],["أَنتَ لَم يُقنِعكَ أَن أَلبَستَني","نِعمَةً تُذكِرُ عَهدَ السُندُسِ",6,"س",1,0],["إن تلتمس رجلاً حراً شمائله","غرا مناقبه زهراً محامده",7,"د",2,1],["أَنْتَ لَوْ لَمْ تَكُنْ أَلِيفَ شَبَابِي","لَمْ تُطِبْ لِي نَضَارَةُ الأَيَّامِ",8,"م",1,0],["إِنَّ تِلْكَ الحَيَاةَ إِنْ تَصِلوهَا","لَحَيَاةٌ جَدِيرَةٌ بِالدَّوَامِ",9,"م",1,0],["أنت لولاهم لما أص","بحت بعض الأغنياء",10,"ا",2,0],["إِن تَلقَها في اِعتِلالٍ تَرضَ عِلَّتَها","أَو زُيِّنَت زادَها في العَينِ تَزيِينا",11,"ن",2,0],["أَنتَ لَيثُ الوَغى وَحَتفُ الأَعادي","وَغِياثُ المَلهوفِ وَالمُستَجيرِ",12,"ر",1,0],["أنت لا شكّ من صبا أرض مصرٍ","فلهذا أرى عليك قبولا",13,"ل",2,0],["أَنتَ لي رَوحٌ وَراحٌ","أَنتَ زَهرٌ وَمُدامُ",14,"م",1,0],["إن تلك الغصونَ عندي لتُضحي","ظالماتٍ فهل لها من متابِ",15,"ب",1,0],["إنَّ تلك النَّفْسَ كفءٌ","لصَفايا مُتُعاتِهْ",16,"ت",2,0],["أنْتَ لا مِنْ ذوي الأُيُورِ فَتَهْوَا","كَ ولا من ذوي الوجوه الصِّبَاحِ",17,"ح",1,0],["أنت للناس كُلِّهم ولأمٍّ","غاض فِيها ماء البرية غيضا",18,"ض",2,0],["أنتَ لا شك قحطبيٌّ ولكنْ","لستَ حاشاك قحطبيّاً فقطُّ",19,"ط",1,0],["أنت لي مولىً ظلومٌ","لا تكافئني بعشقي",20,"ق",2,0],["أنت لا شك أكرمُ الجِن والإن","سِ وإلا فعضَّ فُوك بجعْسِكْ",21,"ك",1,0],["أنتَ للناسِ إلهٌ","لا يدينون لغَيْرِكْ",22,"ك",1,0],["أنتَ للدنيا إذا جا","رت خِطامٌِ وزمامُ",23,"م",1,0],["إن تلافيتَ مجدَهم بعدما شَذْ","ذَ فأضحى مُدوَّنَ الديوان",24,"ن",1,0],["أنت لولا سفالُ كعبِك بادٍ","لك شُمروخُ ذي الهِضاب أَبان",24,"ن",1,0],["أنت لي في الجانب الجدب حَياً","أنت لي في الجانب القفر سكن",25,"ن",1,0],["أَنتَ لا تَستَطيعُ إِحياءَ الصَريع","وَأَنا حَملَ الأَسى لا أَستَطيع",26,"ع",1,0],["أَنتَ لَم تَصنَعِ الحَريرَ الَّذي","تَلبَس وَاللُؤلُؤَ الَّذي تَتَقَلَّد",27,"د",1,0],["أَنتَ لا تَأكُلُ النُضارَ إِذا جِع","ت وَلا تَشرَبُ الجُمانَ المُنَضَّد",27,"د",1,0],["أَنتَ لِلأَرضِ أَوَّلاً وَأَخيراً","كُنتَ مَلكاً أَو كُنتَ عَبداً ذَليلا",28,"ل",2,0],["أَنتَ لِلشورى نُعَوِّذُها","بِكَ مِن عاتٍ وَمِن نَهِمِ",29,"م",1,0],["أَنْتَ لا ميِّتٌ فيبلَى ولا حيٌّ","فيمشي بل كائنٌ لَيْسَ يُفْهَمْ",30,"م",1,0],["أَنْتَ لا شيءَ في الوُجُودِ فغادِرْهُ","إلى الموتِ فهوَ عنكَ غَنِيُّ",30,"ي",1,0],["أنتِ لا تعلمين واللَّيْلُ لا يعلَمُ","كم في ظلامِهِ مِنْ قَتيلِ",31,"ل",1,0],["أَنْتَ لا تدركُ الحقائقَ إن طافتْ","حواليكَ دون مسٍّ وجَبَّسِ",32,"س",1,0],["أنتِ لم تُخْلَقي ليقْرُبَكِ النَّاسُ","ولكنْ لتُعْبَدي من بعيدِ",33,"د",1,0],["انت للشرق شاعر عبقري","تتغذى بقوله الافهام",34,"م",1,0],["انت لو تمسك الثريا بايد","شعراء امسكتها باليدين",34,"ن",1,0],["انت لشعب كسرت","منه القلوب جابره",35,"ر",2,0],["انت لا تدري حين تسمع شعري","أبكاء ذا أم ترنم شاد",36,"د",1,0],["انت لا تعرفني","غير اني اعرفك",37,"ك",1,0],["ان تلك السماء كالارض هذي","حومة تدمى للكفاح الشديد",38,"د",1,0],["انت لا تدرئين عني دائي","انت لا تصلحين منه خرابي",39,"ب",2,0],["انت لا تنجديني في شقائي","انت لا تنقذينني من عذابي",39,"ب",2,0],["انت لا تدفعين وطأة شيبي","انت لا ترجعين عهد شبابي",39,"ب",2,0],["انت لا تقدرين ان تهبيني","راحة او تسكني اعصابي",39,"ب",2,0],["أنت للكل ذليل","قابلٌ حكم الرجال",40,"ل",1,0],["إِن تِلجي فَالمَوتُ في الوُلوجِ","أَو تَخرُجي فَالهُلكُ في الخُروجِ",41,"ج",1,0],["أَنتَ لِلفَتحِ تَنتَمي","وَكَفى الفَتحُ مَنصِبا",42,"ب",2,0],["أَنتَ لَيثُ مَعرَكَةٍ","وَهوَ صارِمٌ فَرَدُ",43,"د",1,0],["إِن تَلِ البَرَّ فَالبِلادُ نُضارٌ","أَو تَلِ البَحرَ فَالرِياحُ رُخاءُ",44,"ا",2,0],["إِن تَلقَهُ لا تَلقَ إِلّا قَسطَلاً","أَو جَحفَلاً أَو طاعِناً أَو ضارِبا",45,"ب",2,0],["أَنتَ لِعَمري البَدرُ المُنيرُ وَلَ","كِنَّكَ في حَومَةِ الوَغى زُحَلُ",46,"ل",1,0],["إِن تَلتَمِس تَمرِ أَخلافَ الأُمورِ وَإِن","تَلبَث مَعَ الدَهرِ تَسمَع بِالأَعاجيبِ",47,"ب",1,0],["أَنتَ لَو كُنتَ كَلاماً","كُنتَ مِن بَعضِ مُحالِه",48,"ل",2,0],["إِنَّ تِلكَ الطُلولَ مِن وَهبينا","حَزَّنَت خالِياً وَزادَت حَزينا",49,"ن",2,0],["أنت .. لن تنكري على احتراقي","كلنا .. في مجامر النار نسوه",50,"و",2,0],["أنتَ للحاكَةِ حتَّى","يُصْدِرَ الوِرْدَ خَليلُ",51,"ل",1,0],["إِن تَلقَ يَوماً عَلى عِلّاتِهِ هَرِماً","تَلقَ السَماحَةَ مِنهُ وَالنَدى خُلُقا",52,"ق",2,0],["أنت لا تبرح عيني فلذا","لا تراني اليوم فيمن ودّعك",53,"ك",1,0],["إن تلك العصا لرَمزٌ على القو","ة في قلب ماردٍ جبّارِ",54,"ر",1,0],["أنت لحنُ الخلد والرح","مة في أرض شقيه",55,"ي",2,0],["أنت له كلُّ الحِمى المُرتَجى","وكلُّ مَبغاه إليكَ النُّزوح",56,"ح",1,0],["إِن تَلُمني عَجائِزٌ مِن نِزارٍ","فَأَراني فيما فَعَلتُ مُجيدا",57,"د",2,0],["إن تَلِفَتْ روحُ هذه اقتسمَتْ","من هذه فضلةً تعيشُ بها",58,"ب",3,0],["إن تلا يحيى عليٌّ في العلى","فبما دانَ من الإِحسان دان",59,"ن",1,0],["أَنتِ لا تُرحمين منك فيفدَى","مِعْصَماً في السوار منه أَسيرُ",60,"ر",1,0],["إِن تُلغَ مَوعِظَةُ الحَوادِثِ بَعدَما","وَضُحَت فَكَم مِن جَوهَرٍ لا يَنفِقُ",61,"ق",1,0],["أَنتَ لي مَعقِلٌ مِنَ الدَهرِ إِن را","بَ بِرَيبٍ أَو حادِثٍ مَضّاضِ",62,"ض",1,0],["أنتَ لو كنتَ عاقلاً","لتمسكتَ بالأثرْ",63,"ر",1,0],["أَن تَلَبَّث لي إِلى أَن","نَلبَسَ اللَيلَ العَريضا",64,"ض",2,0],["أَنتِ لِلَهِ بِناءٌ قائِمٌ","تَلتَوي عَنهُ أُكُفُّ الهادِمينْ",65,"ن",1,0],["أَنتَ لِلحُرِّ سُنَّةٌ وَكِتابٌ","يَستَفيدُ المِثالَ مِن صَفَحاتِهْ",66,"ت",2,0],["إن تُلفهِ حين ترجوه وتسأله","مُستغفِراً لك لا يَعلَقْ بك الغَمَرُ",67,"ر",1,0],["أَنتِ لا تُحسِنينَ وَعدَكِ هَذا","كُلُّ مَن شاءَ أَخلَفَ الميعادا",68,"د",2,0],["إنْ تَلْتَفِتْ فكَرادسِاً ومَقانِباً","أو تَسْتَمِعْ فتَغَمْغُماً وصَهِيلا",69,"ل",2,0],["أنتَ لا تغتدي