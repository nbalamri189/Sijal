{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[3,"تمشي النعام به خلاء حوله","https://www.aldiwan.net/poem187.html",""],[93,"يا حبيباً ما لي سواه حبيب","https://www.aldiwan.net/poem11285.html","الخفيف"],[47,"احذر مقاربة اللئام فإنه","https://www.aldiwan.net/poem25352.html","الكامل"],[51,"أحذر أهل الأرض حد ابن طالب","https://www.aldiwan.net/poem8507.html","الطويل"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[62,"أجيرتنا بالجزع كيف خلصتم","https://www.aldiwan.net/poem52262.html","الطويل"],[61,"أحذركم أمواج دجلة إذ غدت","https://www.aldiwan.net/poem51826.html","الطويل"],[49,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[49,"إحذر من الدنيا مغبتها","https://www.aldiwan.net/poem64171.html","الكامل"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[105,"مرحبا بالوفد وافى من هجر","https://www.aldiwan.net/poem44012.html","المتقارب"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[46,"اذكر إلهك إن هببت من الكرى","https://www.aldiwan.net/poem22491.html","الكامل"],[46,"جاء القران وأم الله أرسله","https://www.aldiwan.net/poem23037.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147496",""],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[51,"فاجأ الناس خالداً وابنَ عشْر","https://www.poetsgate.com/ViewPoem.aspx?id=29110",""],[140,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[167,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[184,"احذر ذنوبك إنها","https://www.aldiwan.net/poem43439.html","مجزوء الكامل"],[184,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[197,"على الشمس من نسج الغمام ستور","https://www.aldiwan.net/poem45202.html","الطويل"],[283,"رجب علوت وقد رأى منك العدا","https://www.aldiwan.net/poem39404.html","الكامل"],[296,"عجبت للبحر يطغى ثم ينقبض","https://www.aldiwan.net/poem36837.html","البسيط"],[320,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[346,"قد تغنى لكم أغن دعاه","https://www.aldiwan.net/poem19863.html","الخفيف"],[374,"إحذر لسانك إن جلست منادما","https://www.aldiwan.net/poem59249.html","الكامل"],[374,"حب الإله وحب العالم اختلفا","https://www.aldiwan.net/poem59329.html","البسيط"],[374,"إحذر فديتك كبريا نفس سمت","https://www.aldiwan.net/poem59404.html","الكامل"],[385,"يا ثقاتي نقل الأعداء","https://www.aldiwan.net/poem3690.html","مجزوء الرمل"],[388,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[388,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[388,"احذر لسانك أيها الإنسان","https://www.aldiwan.net/poem54456.html","عموديه"],[388,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[388,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[388,"سالم عوض باحويرث بالسلامه وصل","https://www.aldiwan.net/poem54532.html","عموديه"],[390,"احذر الغيبة فهي","https://www.aldiwan.net/poem53648.html","مجزوء الرمل"],[402,"احذر صديقك إن تغير إنه","https://www.aldiwan.net/poem49889.html","الكامل"],[406,"احذر من الدنيا ولا","https://www.aldiwan.net/poem31926.html","مجزوء الكامل"],[438,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"احذر الهزل وجانب أهله","https://www.aldiwan.net/poem16008.html","الرمل"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[497,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[538,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[549,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[556,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"]],"verses":[["اِحذَر عَدوَّكَ أَن تُقَرِّبَهُ","مِن قَلبِكَ الخَدَعاتُ وَالحِيَلُ",0,"ل",1,0],["اِحذَرِ الشَمسَ بِجَونٍ","يُعجِلُ اللَيلُ غُسوقَه",1,"ق",2,0],["أَحذاكَ حَرَّ الوَجدِ غَيرِ مُساهِمٍ","وَسَقاكَ كَأسَ الهَمِّ غَيرَ مُعاقِرِ",2,"ر",1,0],["اِحذَر مُباغَضَةَ الرِجالِ فَإِنَّها","تُدمي وَتَقدُرُ أَن يَقولَ العائِبُ",3,"ب",1,0],["اِحذَر مَحَلَّ السَوءِ لا تَحلُل بِهِ","وَإِذا نَبا بِكَ مَنزِلٌ فَتَحَوَّلِ",4,"ل",1,0],["إِحْذَرِي يَا حَبِيبَةَ القَلْبِ هُمَا","لَيْسَ إِلاَّ وَهْماً مِنَ الأَوْهَامِ",5,"م",1,0],["اِحذَر مُقارَبَةَ اللِئامِ فَإِنَّهُ","يُنبيكَ عَنهُم في الأُمورِ مُجَرِّبُ",6,"ب",1,1],["أُحذِّرُ أَهلَ الأرضِ حَدَّ ابنِ طالبٍ","فما زال مشحوذاً على من يصاحبُ",7,"ب",1,1],["أحذاه عبد الله شيمته","والأصل يسقي ماؤه فرعه",8,"ع",2,0],["أحذى الأميرُ ربيعَنا خُلُقاً","يهمي إذا ما البرقُ لم يُشَمِ",9,"م",1,0],["احذري الدهر حين يبدي سلاما","فهو نشال السعادة ينهب",10,"ب",1,0],["اِحذَرِ التُخمَةَ إِن كُنتَ فَهِم","إِنَّ عِزرائيلَ في حَلقِ النَهِم",11,"م",1,0],["أُحَذِّرُكمْ طُوفانَ دمعي فبدِّلُوا","إِذا أزِفَ البينُ الركائبَ بالسُّفْنِ",12,"ن",1,0],["أُحذِّركُمْ أمواجَ دجلةَ إذ غدَتْ","مُصَنْدَلَةً بالمَدِّ أمواجُ مائِها",13,"ا",3,1],["إِحذَر عَلَيكَ اللِئامَ إِنَّهُمُ","لَيسَ يُبالونَ مِنكَ ما رَكِبوا",14,"ب",3,0],["إِحذَر مِنَ الدُنيا مَغَبَّتَها","كَم صالِحٍ عَبَثَت بِهِ فَفَسَد",15,"د",1,1],["أَحذاكَها صَنَعُ اللِسانِ يَمُدُّهُ","جَفرٌ إِذا نَضَبَ الكَلامُ مَعينُ",16,"ن",1,0],["أَحذى قَرابينُهُ صَرفَ الرَدى وَمَضى","يَحتَثُّ أَنجى مَطاياهُ مِنَ الهَرَبِ",17,"ب",1,0],["احذرْ عدوَّكَ والمعاندَ مرَّةً","واحذرْ صديقَ الصدقِ سبعَ مرارِ",18,"ر",1,0],["احذروا الأُسْدَ إذا ما غَضبتْ","واتّقوا أشبالَها والأجمَا",19,"م",2,0],["احذروها وارْحموا أنفسَكم","لا تكونوا في لَظاها حَطَبا",20,"ب",2,0],["احذروها إنَّها المكرُ الذي","مَكَرَ الشيطانُ في ماضِيِ العُصُرْ",21,"ر",1,0],["إحذروها غارةً ملمومةً","يَتّقِي أهوالَها مَن يتقي",22,"ي",1,0],["احذرِ العقبى فما يَدرِي الفتى","أيَّ وِردٍ إن دعا الداعي يَرِدْ",23,"د",1,0],["إِحذَر مَجيئَكَ في الحِسابِ بِزائِفٍ","فَاللَهُ رَبُّكَ أَنقَدُ النُقّادِ",24,"د",1,0],["إِحذَر سَليلَكَ فَالنارُ الَّتي خَرَجَت","مِن زِندِها إِن أَصابَت عودَهُ اِحتَرَقا",25,"ق",2,0],["أحذَقَها بالخيلِ والرِّجالِ","مُشمِّراً وجدَّ في القتالِ",26,"ل",1,0],["احذر الشعب إنه بركان","مطمئن وَقَد يجيء انفجارا",27,"ر",2,0],["احذر عَلَى الدين من تشظ","فالدر ملقى إذا تشظى",28,"ظ",2,0],["احذر الصرعةَ يا مس","كين من دهرٍ عثورِ",29,"ر",1,0],["احذرْ لساني أن تكونَ مقالةً","ليست تَليقُ به فانكَ تُقطَع",30,"ع",1,0],["احذِرُوا خالداً ولا تَعذِلوهُ","أيها الناس قد تبيَّنتُ عذره",31,"ر",2,0],["اِحذرْ عذارك والعذارُ مغلِّس","فإذا بدا صبحُ المشيبِ فأقصرِ",32,"ر",1,0],["أَحذارَ المَوتِ أَبقى هَكَذا","لا وَمُجري الماءِ رِزقاً لِلعبادِ",33,"د",1,0],["احذر ذنوبك إنّها","كالغل أو صفد العقال",34,"ل",1,1],["أحذق خلق الله بالمجس","وبالصفات في دقيق الحدس",35,"س",1,0],["أُحذّرُ كلَّ الناسِ من كتب دينهِ","وَبالردِّ وَالإعراضِ تَفسيره أَحرى",36,"ر",2,0],["أُحذّرُ قَومي مِن عُداةٍ تألّبوا","عَلينا وَساموا دينَنا الخسفَ والخُسرا",36,"ر",2,0],["أحذنا على الدهرِ المواثيقَ عندهُ","فأيامهُ للنائباتِ قبورُ",37,"ر",1,0],["احذر وحاذر فالقلوب تيقظت","ومحمد من دينه سمع الندا",38,"د",2,0],["احذرْ من البحر لا تغررك هدأتُه","ولو تَماوتَ حتى ما به نَبَضُ",39,"ض",1,0],["إِحذَر ذَوي الضِغنِ لا تَأمَن بَوائِقَهُم","وَإِن طُلِبتَ فَلا تَغفَل إِذا غَفَلوا",40,"ل",3,0],["أَحَذِرتُمْ مِنّي نَمِيمَةَ واشٍ","أَمْ خَشِيتُمْ مِنّي اطِّلاعَ رَقِيبِ",41,"ب",1,0],["إحذر لسانك إن جلستَ منادماً","وزنِ الكلامَ فمن يزنْهُ لم يُلَمْ",42,"م",1,1],["احذر مكامن إبليس اللعين وخذ","مديح مريم ستراً يمنع الصلَفا",43,"ف",2,0],["إحذر فديتك كبريا نفسٍ سمت","فتمامها كفرٌ بحق الباري",44,"ي",1,1],["احذَروا أن تَترُكوني","في الهَوى أقرَعُ سنّي",45,"ن",2,0],["احذر من التبعات","فإنها ظلمات",46,"ت",1,0],["احذر تخالطهم أنى لك نصيح وناه","احذر تجيهم سوى للنصح خذها وصاه",47,"ا",2,0],["احذر لسانك أيها الإنسان","لا يلدغنك أنه ثعبان",48,"ن",1,1],["احذر احذر من آفات اللسان","إنها الموجبة دار الهوان",49,"ن",1,0],["احذر احذر أخي تكن","نابعا مذهب اللئام",50,"م",1,0],["احذر تثبت توقف من فساد وخلل","لا تفت إلا بعلم سالم من علل",51,"ل",1,0],["اِحذَرِ الغِيبَةَ فَهيَ ال","فُسقُ لا رخصةَ فيهِ",52,"ه",1,1],["احذَرْ صديقَكَ إنْ تَغَيَّر إنَّهُ","ضِدُّ يُصيب الحُرَّ حينَ يعارضُ",53,"ض",1,1],["احْذَرْ من الدّنيَا ولاَ","تَغْتَرَّ بالعُمرِ القَصيْرِ",54,"ر",1,1],["أحذركم من الدُنيا عداها","وأَخراكم أحذركم جزاها",55,"ا",3,0],["اِحذروا العارَ فيه والعَارُ أن يم","سي ذمامي في رعيهِ مخفورا",56,"ر",2,0],["اِحْذَر الهَزْل وجانبْ أهلَه","اِنه يُنْقِصُ منْ قَدْرِ النَّبيلْ",57,"ل",1,1],["أحذر ملازمة البكاء فلم يزل","ماء الدموع يشبُّ نيران الشَّغفْ",58,"ف",1,0],["أَحذَيتُ رُمحي عائِطاً مَمكورَةً","كَوماءَ أَطرافُ العِضاهِ لَها خَلى",59,"ا",1,0],["أَحذو قَصائِدَ للراوينَ باقيَةً","كَأَنَّها بَينهُم موشِيَةُ الحُلَلِ",60,"ل",1,0],["اِحذرِ الدّهرِ فللدّه","رِ اِزوِرارٌ واِنقِلابُ",61,"ب",1,0],["احذر احذر تجد بأنك عنها","خارج بانفصال شيءٍ دهاكا",62,"ك",2,0]]}