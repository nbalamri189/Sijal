ewPoem.aspx?id=186844",""],[5573,"كاس الهوى ومنادم الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=200178",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5606,"الأمرعاتي","https://www.poetsgate.com/ViewPoem.aspx?id=195169",""],[5606,"العام الأول قلت باروح للصيد","https://www.poetsgate.com/ViewPoem.aspx?id=197740",""],[5690,"يا خاطفاً قلبي الذي","https://www.poetsgate.com/ViewPoem.aspx?id=172239",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5747,"ياسعود","https://www.poetsgate.com/ViewPoem.aspx?id=61661",""],[5827,"وتسارعت أعمارنا","https://www.poetsgate.com/ViewPoem.aspx?id=207781",""],[5969,"طقوس الجمر في عصر الجليد","https://www.poetsgate.com/ViewPoem.aspx?id=213788",""],[5977,"حرر قيودك","https://www.poetsgate.com/ViewPoem.aspx?id=212738",""],[5977,"سلام على تلك القبور وأهلها","https://www.poetsgate.com/ViewPoem.aspx?id=214339",""],[6035,"لادامت لكم نِعمُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175082",""],[6084,"إحذر صديقك لا تأمنه إن له","https://www.poetsgate.com/ViewPoem.aspx?id=170885",""],[6084,"احذر هوى النفس لا تأمنه إن به","https://www.poetsgate.com/ViewPoem.aspx?id=170823",""],[6085,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=8675",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6320,"قُنْصُلِيَّةُ المَوْت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84343&r=&rc=40",""]],"verses":[["اِحذَر عَدوَّكَ أَن تُقَرِّبَهُ","مِن قَلبِكَ الخَدَعاتُ وَالحِيَلُ",0,"ل",1,0],["اِحذَرِ الشَمسَ بِجَونٍ","يُعجِلُ اللَيلُ غُسوقَه",1,"ق",2,0],["أَحذاكَ حَرَّ الوَجدِ غَيرِ مُساهِمٍ","وَسَقاكَ كَأسَ الهَمِّ غَيرَ مُعاقِرِ",2,"ر",1,0],["اِحذَر مُباغَضَةَ الرِجالِ فَإِنَّها","تُدمي وَتَقدُرُ أَن يَقولَ العائِبُ",3,"ب",1,0],["اِحذَر مَحَلَّ السَوءِ لا تَحلُل بِهِ","وَإِذا نَبا بِكَ مَنزِلٌ فَتَحَوَّلِ",4,"ل",1,0],["إِحْذَرِي يَا حَبِيبَةَ القَلْبِ هُمَا","لَيْسَ إِلاَّ وَهْماً مِنَ الأَوْهَامِ",5,"م",1,0],["اِحذَر مُقارَبَةَ اللِئامِ فَإِنَّهُ","يُنبيكَ عَنهُم في الأُمورِ مُجَرِّبُ",6,"ب",1,1],["أُحذِّرُ أَهلَ الأرضِ حَدَّ ابنِ طالبٍ","فما زال مشحوذاً على من يصاحبُ",7,"ب",1,1],["أحذاه عبد الله شيمته","والأصل يسقي ماؤه فرعه",8,"ع",2,0],["أحذى الأميرُ ربيعَنا خُلُقاً","يهمي إذا ما البرقُ لم يُشَمِ",9,"م",1,0],["احذري الدهر حين يبدي سلاما","فهو نشال السعادة ينهب",10,"ب",1,0],["اِحذَرِ التُخمَةَ إِن كُنتَ فَهِم","إِنَّ عِزرائيلَ في حَلقِ النَهِم",11,"م",1,0],["أُحَذِّرُكمْ طُوفانَ دمعي فبدِّلُوا","إِذا أزِفَ البينُ الركائبَ بالسُّفْنِ",12,"ن",1,0],["أُحذِّركُمْ أمواجَ دجلةَ إذ غدَتْ","مُصَنْدَلَةً بالمَدِّ أمواجُ مائِها",13,"ا",3,1],["إِحذَر عَلَيكَ اللِئامَ إِنَّهُمُ","لَيسَ يُبالونَ مِنكَ ما رَكِبوا",14,"ب",3,0],["إِحذَر مِنَ الدُنيا مَغَبَّتَها","كَم صالِحٍ عَبَثَت بِهِ فَفَسَد",15,"د",1,1],["أَحذاكَها صَنَعُ اللِسانِ يَمُدُّهُ","جَفرٌ إِذا نَضَبَ الكَلامُ مَعينُ",16,"ن",1,0],["أَحذى قَرابينُهُ صَرفَ الرَدى وَمَضى","يَحتَثُّ أَنجى مَطاياهُ مِنَ الهَرَبِ",17,"ب",1,0],["احذرْ عدوَّكَ والمعاندَ مرَّةً","واحذرْ صديقَ الصدقِ سبعَ مرارِ",18,"ر",1,0],["احذروا الأُسْدَ إذا ما غَضبتْ","واتّقوا أشبالَها والأجمَا",19,"م",2,0],["احذروها وارْحموا أنفسَكم","لا تكونوا في لَظاها حَطَبا",20,"ب",2,0],["احذروها إنَّها المكرُ الذي","مَكَرَ الشيطانُ في ماضِيِ العُصُرْ",21,"ر",1,0],["إحذروها غارةً ملمومةً","يَتّقِي أهوالَها مَن يتقي",22,"ي",1,0],["احذرِ العقبى فما يَدرِي الفتى","أيَّ وِردٍ إن دعا الداعي يَرِدْ",23,"د",1,0],["إِحذَر مَجيئَكَ في الحِسابِ بِزائِفٍ","فَاللَهُ رَبُّكَ أَنقَدُ النُقّادِ",24,"د",1,0],["إِحذَر سَليلَكَ فَالنارُ الَّتي خَرَجَت","مِن زِندِها إِن أَصابَت عودَهُ اِحتَرَقا",25,"ق",2,0],["أحذَقَها بالخيلِ والرِّجالِ","مُشمِّراً وجدَّ في القتالِ",26,"ل",1,0],["احذر الشعب إنه بركان","مطمئن وَقَد يجيء انفجارا",27,"ر",2,0],["احذر عَلَى الدين من تشظ","فالدر ملقى إذا تشظى",28,"ظ",2,0],["احذر الصرعةَ يا مس","كين من دهرٍ عثورِ",29,"ر",1,0],["احذر واصعد وايقن ان صاحبها","سيف من الله لا تحويه أجفان",30,"ن",1,0],["احذرْ لساني أن تكونَ مقالةً","ليست تَليقُ به فانكَ تُقطَع",31,"ع",1,0],["احذِرُوا خالداً ولا تَعذِلوهُ","أيها الناس قد تبيَّنتُ عذره",32,"ر",2,0],["اِحذرْ عذارك والعذارُ مغلِّس","فإذا بدا صبحُ المشيبِ فأقصرِ",33,"ر",1,0],["أَحذارَ المَوتِ أَبقى هَكَذا","لا وَمُجري الماءِ رِزقاً لِلعبادِ",34,"د",1,0],["احذر ذنوبك إنّها","كالغل أو صفد العقال",35,"ل",1,1],["أحذق خلق الله بالمجس","وبالصفات في دقيق الحدس",36,"س",1,0],["أُحذّرُ كلَّ الناسِ من كتب دينهِ","وَبالردِّ وَالإعراضِ تَفسيره أَحرى",37,"ر",2,0],["أُحذّرُ قَومي مِن عُداةٍ تألّبوا","عَلينا وَساموا دينَنا الخسفَ والخُسرا",37,"ر",2,0],["أحذنا على الدهرِ المواثيقَ عندهُ","فأيامهُ للنائباتِ قبورُ",38,"ر",1,0],["احذر وحاذر فالقلوب تيقظت","ومحمد من دينه سمع الندا",39,"د",2,0],["احذرْ من البحر لا تغررك هدأتُه","ولو تَماوتَ حتى ما به نَبَضُ",40,"ض",1,0],["إِحذَر ذَوي الضِغنِ لا تَأمَن بَوائِقَهُم","وَإِن طُلِبتَ فَلا تَغفَل إِذا غَفَلوا",41,"ل",3,0],["أَحَذِرتُمْ مِنّي نَمِيمَةَ واشٍ","أَمْ خَشِيتُمْ مِنّي اطِّلاعَ رَقِيبِ",42,"ب",1,0],["إحذر لسانك إن جلستَ منادماً","وزنِ الكلامَ فمن يزنْهُ لم يُلَمْ",43,"م",1,1],["احذر مكامن إبليس اللعين وخذ","مديح مريم ستراً يمنع الصلَفا",44,"ف",2,0],["إحذر فديتك كبريا نفسٍ سمت","فتمامها كفرٌ بحق الباري",45,"ي",1,1],["احذَروا أن تَترُكوني","في الهَوى أقرَعُ سنّي",46,"ن",2,0],["احذر من التبعات","فإنها ظلمات",47,"ت",1,0],["احذر تخالطهم أنى لك نصيح وناه","احذر تجيهم سوى للنصح خذها وصاه",48,"ا",2,0],["احذر لسانك أيها الإنسان","لا يلدغنك أنه ثعبان",49,"ن",1,1],["احذر احذر من آفات اللسان","إنها الموجبة دار الهوان",50,"ن",1,0],["احذر احذر أخي تكن","نابعا مذهب اللئام",51,"م",1,0],["احذر تثبت توقف من فساد وخلل","لا تفت إلا بعلم سالم من علل",52,"ل",1,0],["اِحذَرِ الغِيبَةَ فَهيَ ال","فُسقُ لا رخصةَ فيهِ",53,"ه",1,1],["احذَرْ صديقَكَ إنْ تَغَيَّر إنَّهُ","ضِدُّ يُصيب الحُرَّ حينَ يعارضُ",54,"ض",1,1],["احْذَرْ من الدّنيَا ولاَ","تَغْتَرَّ بالعُمرِ القَصيْرِ",55,"ر",1,1],["أحذركم من الدُنيا عداها","وأَخراكم أحذركم جزاها",56,"ا",3,0],["اِحذروا العارَ فيه والعَارُ أن يم","سي ذمامي في رعيهِ مخفورا",57,"ر",2,0],["اِحْذَر الهَزْل وجانبْ أهلَه","اِنه يُنْقِصُ منْ قَدْرِ النَّبيلْ",58,"ل",1,1],["أحذر ملازمة البكاء فلم يزل","ماء الدموع يشبُّ نيران الشَّغفْ",59,"ف",1,0],["أَحذَيتُ رُمحي عائِطاً مَمكورَةً","كَوماءَ أَطرافُ العِضاهِ لَها خَلى",60,"ا",1,0],["أَحذو قَصائِدَ للراوينَ باقيَةً","كَأَنَّها بَينهُم موشِيَةُ الحُلَلِ",61,"ل",1,0],["اِحذرِ الدّهرِ فللدّه","رِ اِزوِرارٌ واِنقِلابُ",62,"ب",1,0],["احذر احذر تجد بأنك عنها","خارج بانفصال شيءٍ دهاكا",63,"ك",2,0],["إحذر إلى من عاملتك بطيبها","لا تنتجل عنها بغير صميل",64,"ل",1,0],["اِحذَرْ صَديقَكَ لا تأمَنْهُ في زَمنٍ","إِنَّ الصّداقةَ مِنها الضُّرُّ والكَدرُ",65,"ر",1,1],["أَحْذاكَهُ مَنْ لاَ يَزالُ ضَمِيرُهُ","عَمَّا كَرهْتَ مِنَ الْمَذَاهِبِ مُعْرضا",66,"ض",2,0],["أحذر منها كلَّ حرٍّ مهذب","أديب أبىِّ النفس زيْنِ فَعالِ",67,"ل",1,0],["احذرْ عدَتْك الرزايا كلَّ داهية","وعشْ غريراً عزوفاً غيرَ مغرور",68,"ر",1,0],["احذر فديتك أن تلفى أخا طمع","يلقيك في طبع ناهيك من طبع",69,"ع",1,1],["احذر غوائل دهرك أيها الساهي","وجرد العزم فعل الآمر الناهي",70,"ي",1,1],["احذري أن تفكري في المساء","واتركي البدر سابحاً في فضائه",71,"ه",1,0],["إِحذَر وَقاكَ اللَّهُ شِدَّةَ شُؤمِهِ","فَالكاتِبُ المَشؤُومُ شَرُّ خَدِيمِ",72,"م",1,0],["أحذر تكن ذا عوزٍ بعد الخبا","لكل ما ذكرنا عنه بنبا",73,"ب",2,0],["أحذر بان تبقى بها من جانبْ","من دون تغطيس فتلقى العاطبْ",73,"ب",1,0],["أحذر دخول الزهر بالأجمالِ","إذ ما لجنس الزهر من ادخالِ",73,"ل",1,0],["أحذر من الفيران واخشَ الهرَّا","لا تقبلنهُ أن أتى من برّا",73,"ر",2,0],["إحذَرْ جليسَ السّوء والبَسْ دونَه","ثوبَ التّقيّة جاهداً وتدرّعِ",74,"ع",1,1],["احذر عَلى التحقيق","عَداوة الصديق",75,"ق",1,0],["احذر تصاريف الزمان وريبه","لا تأمنن حوادث الأيام",76,"م",1,0],["احذر هديت فذات الغدر ما برحت","تبدي الوداد وتخفي المكر والضغنا",77,"ن",2,0],["احذر بما تجمع تكوى كيّا","فَما يُغادِر الكتاب شَيّا",78,"ي",2,0],["أحذاني السقمَ ثوباً ضافياً وغدا","وطرفهُ منه كاسٍ وهو عريانُ",79,"ن",1,0],["احذر من ابن العم فهو مصحَّف","ومن القريب فإنما هو أحْرُفُ",80,"ف",1,1],["احذر تخلي التقوى","حوك اتكالك على النسب",81,"ب",1,0],["احذَر تَزِلَّ فَتَحتَ رِجلِكَ هُوَّةٌ","كَم قَد هَوَى فِيهَا عَلَى الأزمَانِ",82,"ن",1,0],["إِحذَر وِصالَ اللئيم إِنَّ لَهُ","عَضهاً إِذا حَبلُ وَصلِهِ اِنقَطَعا",83,"ع",2,0],["اِحذِر مَحاسِنَ أَوجُهٍ فَقَدَت مَحا","سِنَ أَنفُسٍ وَلَو أَنَّها أَقمارُ",84,"ر",1,1],["احذر على ليلى عيون الأغيار","واحذر تجنب بين تلك الأخدار",85,"ر",1,1],["اِحذَرِ الرَميَةَ يا طا","هِرُ مِن كَفِّ الحُبيشي",86,"ش",2,0],["احذَر مودة ماذقٍ","مزجَ المرارَةَ بالحَلاوَه",87,"ه",1,1],["أحذِّرك الناس إِلّا قَليلا","فَلا تبغِيَنَّ إليهِم سَبيلا",88,"ل",2,1],["احذَر عدوَّك مرَّةً","واحذَر صَديقَكَ ألف مَرَّه",89,"ه",1,1],["إحذَر عَنِ العَقربِ أن تميلا","ومِن مَهَايمَ اقصُدِ السُّهَيلاَ",90,"ل",2,0],["إحذَرَ جَرَّ الماءِ تَحتَ الجَاهِ","لا تَتَرُكِ الأشياءَ في اشتباهِ",91,"ه",1,0],["إحذر هُنَاكَ العِرقَ في الطريقِ","خُذ عَنهُ مَا عِشرينَ بالتَّحقيقِ",91,"ق",1,0],["إحذَر على قُربِكَ يَاخي مِنهُ","فَخُذ حَذَركَ يَا خليلي مِنهُ",91,"ه",1,0],["إحذَرَ مِنهُ قَبلَهُ المَاءُ","يُقلِعُ مُبيَضَّا ولا خَفَاءُ",92,"ا",2,0],["احذر الاعين الصحاح","ما على فعلها مزيد",93,"د",1,0],["احذرْ من أكله على الغذاء","وفي امتلاءِ البطْن والمسَاء",94,"ا",2,0],["أحذَرْ نَديميَ أنْ تذوقَ المسكرا","أو أنْ تُحاوِلَ قطّ أمراً مُنكرا",95,"ر",2,1],["احذر ذباباً لاصقاً تارة","في قذرٍ وتارة في دبقْ",96,"ق",1,0],["احذر فديتك ما حيي","ت حبائل المتشاكلات",97,"ت",1,1],["احذر قومي من رجال تزلفوا","وقد جعلوا طرق الخداع وسائلا",98,"ل",2,0],["إحذر كفيت بطالةً وهوىً","واستمثل المثلات في النحل",99,"ل",1,0],["إحذر على عدنان ان حدثته","بالمجد أو فامزجه بالتفكيه",100,"ي",2,0],["احذر زمانك يا مفتر بالنعم","فكم لَهُ بَعد صَفو العَيشِ مِن نَقمِ",101,"م",1,1],["إِحذَر عِقابَ اللَهِ وارجُ ثَوابَهُ","حَتّى تَكونَ كَمَن لَهُ قَلبانِ",102,"ن",1,0],["أحذركَ مِن نَفَسِ العَجوزِ وَبُضعَها","فَهُما لِجِسمِ ضَجيعِها سُقمانِ",102,"ن",1,0],["احذر أولي التسبيح والسبحةِ","والصوف والعكاز والشملةِ",103,"ه",1,1],["احذر زمانك لو يجدي لك الحذر","فإنه الافعوان الحية الذكر",104,"ر",1,1],["احذرْ مكايد وَجْنَةٍ محمَّرةٍ","فالجمر محمرُّ الغِلاَلَة مَحْرِقُ",105,"ق",1,0],["احذر أضاليل الحياة فإنما","هي غفلة الأفكار عن سبل الهدى",106,"د",2,0],["أحذرك السحر 