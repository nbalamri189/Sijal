{"poems":[[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[74,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[53,"لو يعلم الأعداء أين تحلني","https://www.aldiwan.net/poem61961.html","الكامل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[87,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[52,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[48,"دنياك دارشرور لا سرور بها","https://www.aldiwan.net/poem22794.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[124,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[146,"لقاؤك يا لبنى خيال","https://www.aldiwan.net/poem58405.html","الطويل"],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[289,"ما جمع الناس لدنياهم","https://www.aldiwan.net/poem44311.html","السريع"],[358,"وطرف رد عنه الطرف لما","https://www.aldiwan.net/poem39582.html","الوافر"],[469,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[545,"قفا فهريقا الدمع بالمنزل الدرس","https://www.aldiwan.net/poem56802.html","الطويل"],[556,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[556,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[566,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[1446,"","https://poetry.dctabudhabi.ae/diwan/poem/130743","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109353","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77352","البسيط"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146353","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202719","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91994","الكامل"],[4077,"","https://poetry.dctabudhabi.ae/diwan/poem/198901","البسيط"],[4869,"المال ..","https://www.poetsgate.com/ViewPoem.aspx?id=151709",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5442,"هل نازح الدار بعد البين مقترب","https://www.poetsgate.com/ViewPoem.aspx?id=114788",""],[5459,"هذي الحشاشة تذوي","https://www.poetsgate.com/ViewPoem.aspx?id=190947",""],[5754,"يَا من إِلَى الْفضل سبق","https://www.poetsgate.com/ViewPoem.aspx?id=191645",""],[5790,"وصاحبٍ عادني يوما فأقلقني","https://www.poetsgate.com/ViewPoem.aspx?id=111936",""],[402,"بالمس أمته من بيته اتخذت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54034&r=&rc=886",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["وَلَوْ أَطَاعُوا هَوَاهُمْ قِي تَجِلَّتِهِ","لَكَانَ دُونَ الَّذِي يَبْنُونَهُ الْهَرَمُ",0,"م",1,0],["ولو أطافت بنات النعش لابْتدرت","تنافس النَّعش فيها أو تساهمه",1,"م",2,0],["ولو اطَّلعتَ على هوايَ جعلتني","بمَحَلِّ رُوح من صميم فؤادِ",2,"د",1,0],["ولو أطاعتها مقاديرُها","جرتْ لتلقاهُ ولم تخنس",3,"س",1,0],["وَلَوِ اِطَّلَعتَ عَلى الحَيا","ةِ فَعَلتَ ما لَم يُفعَلِ",4,"ل",1,0],["وَلَو أُطيعُكَ في نَفسي مُعالَجَةً","أَنهَبتُ عِرضي وَما عِرضي بِمُنتَهَبِ",5,"ب",1,0],["وَلَو أَطاعَ أَميرَ العَقلِ صاحِبُهُ","لَكانَ آثَرَ مِن أَن يَنطِقَ الخَرَسُ",6,"س",1,0],["وَلَو أَطلَعَ اللَهُ الهِلالَ طُلوعَهُ","لَقالوا لِسَبعٍ تَمَّ أَو لثمانِ",7,"ن",1,0],["ولو أطلقت شوقي بل نحري","وروى وبل غاديتيه خدي",8,"د",2,0],["ولو أُطلقت حدّاه واسُتَّل في الطُّلَى","براها بيمنى ضارب وشمالِ",9,"ل",1,0],["ولو أطاق الدَّستُ سعيا لسعى","مستقبِلا يختال في أثوابهِ",10,"ب",2,0],["ولو اطلعت عليه في اعجازه","لنهلت من آياته بمعين",11,"ن",1,0],["ولو أطاقُوا لقاموا من قُبورهم","حتى يعيدوا زمان الفتح مؤتنَفا",12,"ف",2,0],["وَلَو أَطاقوا القَفرَ ما فاتَهُم","وَكَيفَ لِلجائِعِ بَالقَفرِ",13,"ر",1,0],["وَلَو أَطلقت مِنهُ عِنان عَزم","لَكادَ بِنَعلِهِ يطأُ الثريّا",14,"ي",2,0],["ولو أطَّلعت على صحيفة فكرهِ","لرأيتَ كلّ الخلق في مرآتها",15,"ت",3,0],["وَلَو أَطمَعتَنا الدارُ أَو ساعَفَت بِها","نَصَصنا ذواتِ النَصِّ وَالعَنَقِ المَلسِ",16,"س",1,0],["ولو اِطّلعتَ على ضميرٍ فيك لِي","أبصرتَ منه تقسُّمِي وتروُّعِي",17,"ع",2,0],["وَلَو أَطافَ الّذي قِيدتْ مشافِرُهُ","إلى ورودِ حياضِ الموتِ ما وردا",18,"د",2,0],["وَلَو أَطارَ الحَربَ طَعنٌ كَالضَّرَم","في يَومِ هَيجا ذي طِلالٍ وَقَتَم",19,"م",1,0],["ولو اطلعت على جواهرِ نظمها","قد سطرت في وجنةِ القرطاسِ",20,"س",1,0],["ولو أطاقت لبثت ما أبث لها","من حرّ قلب لدى الأحزان مرهون",21,"ن",1,0],["وَلَو أَطاعَ لَطاحَ الدينُ مُنهَدِماً","لَكِنَّها القَوسُ مُعطاةُ لِباريها",22,"ي",3,0],["ولو أَطلقْتَني لهَربتُ مِنها","أسيراً من جَوامِعه الدّيُون",23,"ن",1,0],["ولو أُطلقَ الحيوان عاش كما اشتهى","ولم نرَ كالإنسان من عائشٍ قسرا",24,"ر",2,0],["وَلو اطلعتَ بعد فكرك في الثَرى","قامَت لَديك معاشرٌ وَقرون",25,"ن",1,0],["ولو أطاقوا انتقاصاً من حياتهم","لم يتحفوك بشيء غير أعمار",26,"ر",1,0],["ولو اطلبوه انفاس ما مد الانفاس","الله على عقله وحاله يعينه",27,"ن",2,0],["ولو أطاعاك في حكم على جنف","فأنت تعرف كيد الخصم والحكم",28,"م",1,0],["ولو أطعت صباباتي عصيت لها","عذري ولو أن في عصيانه التلفا",29,"ف",2,0],["ولو أطلقن على وجهي سعيت به","لو كان لم بنه عنه الشرع والأدب",30,"ب",1,0],["وَ لَوْ أَطَاعَ الَّذِي تُنْجِيهِ طَاعَتُهُ","لَمْ يُثْنِهِ عَنْ بُلُوغِ الْمُرْتَجَى طَلَلُ..",31,"ل",1,0],["وَلَو أطَاق كسر ال","رَاء وَلَكِن مَا اتّفق",32,"ق",1,0],["ولو أطال قليلا لم يطل أجلى","وجاءني غاسلي يسعى بأكفاني",33,"ن",2,0],["ولو اطاعوا هواهم في تجلته","لكان دون الذي يبنونه الهرم",34,"م",1,0],["ولو أطلَّت .. ووجه الأفق مكتئب","ما عاد للأفق وجه وهو مكتئب",35,"ب",1,0]]}