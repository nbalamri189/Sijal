{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[9,"ألا حي ميا إذ أجد بكورها","https://www.aldiwan.net/poem21932.html","الطويل"],[32,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[29,"ألا حي الديار بسعد إني","https://www.aldiwan.net/poem5772.html","الوافر"],[30,"إني إلى خير البرية كلها","https://www.aldiwan.net/poem5296.html","الطويل"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[422,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[435,"جرى الصفاء بفوار الهنا العذب","https://www.aldiwan.net/poem40791.html","البسيط"],[445,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[447,"وداعاً أيها الطهر النبي","https://www.aldiwan.net/poem14344.html","الوافر"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[466,"مدحتكم والمادحون بني العلى","https://www.aldiwan.net/poem15401.html","الطويل"],[466,"له هزة لو لا تقاه ونسكه","https://www.aldiwan.net/poem15591.html","الطويل"],[466,"كأن مجن الشمس فوق جبينه","https://www.aldiwan.net/poem15671.html","الطويل"],[466,"ويا رب إن جازيت بالخير محسنا","https://www.aldiwan.net/poem16359.html","الطويل"],[553,"لعمرُ أبيك والأنباء تُنمى","https://www.aldiwan.net/poem1176.html",""],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2457","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96659","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108539","الطويل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33841","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28628","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204177","المنسرح"],[5004,"بساتيها للمسك فيها روائح","https://www.poetsgate.com/ViewPoem.aspx?id=181492",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""]],"verses":[["كَأَنَّ مَجرى النِسعِ في ذَفِّها","مُضطَرَبُ الأَيمِ عَلى الأَجرَعِ",0,"ع",1,0],["كَأَنَّ مُجاجَ العِرقِ في مُستَدارِها","حَواشي بُرودٍ بَينَ أَيدٍ تُطيرُها",1,"ر",3,0],["كَأَنَّ مَجَرَّ العِيسِ أَطرافَ خُطمِها","بِحَيثُ اِنتَهى مِن كِرسِ مَركُوِّهِ العُقرُ",2,"ر",1,0],["كَأَنَّ مُجاشِعاً نَخَباتُ نيبٍ","هَبَطنَ الهَرمَ أَسفَلَ مِن سَرارا",3,"ر",2,0],["كَأَنَّ مُجاجَ النَحلِ بَينَ لِثاتِها","وَماءُ سَحابٍ أَحرَزَتهُ الوَقائِعُ",4,"ع",1,0],["كَأَنَّ مَجَرَّ الرامِساتِ ذُبولَها","عَلَيهِ حَصيرٌ نَمَّقَتهُ الصَوانِعُ",5,"ع",1,0],["كَاَنَّ مَجْوِسيّاً أَتَى دُونَ ظِلِّهَا","ومَاتَ النَّدَى مِنْ جَانِبَيْهِ فَأَصْرَمَا",6,"م",2,0],["كَأَنَّ مَجدَكَ وَهوَ الدَهرَ في صُعُدٍ","مِن فَرطِ إِسراعِهِ يَنحَطُّ في صَبَبِ",7,"ب",1,0],["كأَنَّ مجالس الأفراح منهم","كؤوس الرَّاح تنظمهم حبابا",8,"ب",2,0],["كأنَ مجراه من عين الحياة أتى","يعطي التهاني ويشفي كل ذي وصبِ",9,"ب",1,0],["كَأَنَّ مَجَرَّةَ الأَفلاكِ حَفَّتْ","بِهَا محفوفَةً بالشِّعْرَيَيْنِ",10,"ن",1,0],["كأن مجالها في الخد جارٌ","بها يحدد مستربي",11,"ي",1,0],["كأنَّ مجرَّها مجرَى سبوحٍ","بلُجِّ أوالَ شَرَّعَ نُوتياها",12,"ا",3,0],["كأنَّ مِجَنَّ الشمس من قسماتهِ","اذا ما ادلهمَّت في الوجوه النوازل",13,"ل",1,0],["كأنَّ مِجَنَّ الشمس غُرَّة وجهه","يكون له أفْقُ القميصين مطْلعا",14,"ع",2,0],["كأنَّ مِجَنَّ الشمس فوق جبِينه","اذا ما وجوهُ الحدثاِ اكْفهرَّتِ",15,"ت",1,1],["كأنَّ مجنَّ الشمس في رونق الضُّحى","مُحيَّاه في يوم السَّلامِ إذا انْتَدى",16,"د",2,0],["كَأَنَّ مَجامِعَ الأَردافِ مِنها","نَقىً دَرَجَت عَلَيهِ الريحُ هارا",17,"ر",2,0],["كَأَنَّ مَجالَ العَينِ مِنهُ وَقَلبَهُ","وَغُرَّتَهُ نَصلٌ حَماهُ الصَدى الصَقلُ",18,"ل",1,0],["كَأَنَّ مُجَفَّفاتِ الخَيلِ فيهِ","إِذا مَرَّت بَرازيقاً فُيولُ",19,"ل",1,0],["كأنَّ مَجَرّ الغاديات مجرة الس","ماءِ إذا لاحت نجومُ ظُباها",20,"ا",3,0],["كَأنّ مجاج ريقَتها زلالٌ","يُخالطهُ مزاجٌ من عقارِ",21,"ر",1,0],["كأن مجاج النحل في لهواتهم","إذا رجعوا الأصواتَ فيها وأطلقوا",22,"ق",3,0],["كأن مجاريها أنامل خيّرٍ","تمد لراجيها سبائك فضة",23,"ه",1,0],["كَأَنَّ مجامِعَ الهُلُباتِ منهُ","وَهاديَها لميعادٍ وِفاقِ",24,"ق",1,0],["كَأَنَّ مَجالَ الطَرفِ في كُلِّ ناظِرٍ","عَلى حَرَكاتِ العاشِقينَ رَقيبُ",25,"ب",1,0],["كَأَنَّ مَجَرَّ الخَيلِ أَرسانَها بِهِ","مَساقِطُ أَرماحِ القَنا في مُعَرَّسِ",26,"س",1,0],["كَأَنَّ مَجالَهُنَّ بِبَطنِ رَهبى","إِلى قُطمانَ آثارُ السِلاحِ",27,"ح",1,0],["كأن مجاري الدمع أودية الحيا","تديم عليك الوكف والهملانا",28,"ن",2,0],["كَأَنَّ مَجالَ الطَّرفِ مِن كُلِّ ناظِرٍ","عَلى حَرَكاتِ العاشِقينَ رَقيبُ",29,"ب",1,0],["كأن مجرى سواكه برَدٌ","وريقه ذوبُ ذلك البرد",30,"د",1,0],["كأن مجاريها سبائك فضةٍ","تذاب وأسياف تهز قواضب",31,"ب",1,0],["كأن مجامع الربلات منها","فئام ينهضون إلى فئام",32,"م",1,0],["كأنَّ مجرَى الخَيَالِ النَّهرُ وَ انْخَفَضَا","يَجري كَجمرٍ فويقَ المَاءِ ثمَّ مضَى",33,"ض",2,1]]}