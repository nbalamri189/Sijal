{"poems":[[53,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[73,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[27,"ما بال جهلك بعد الحلم والدين","https://www.aldiwan.net/poem4437.html","البسيط"],[72,"دانت لك الدنيا وملت لأرغد","https://www.aldiwan.net/poem18570.html","الكامل"],[45,"بعدوك الحدث الجليل الواقع","https://www.aldiwan.net/poem64709.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[105,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"لو أن من تهواه يهواكا","https://www.aldiwan.net/poem64469.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[100,"ليلة فارس الغبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67737&r=&rc=224",""],[116,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[144,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[144,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[170,"أبا الفضائل يا من في مفاضته","https://www.aldiwan.net/poem1653.html",""],[170,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[205,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[238,"راقت عشية رأس الطرف طرف فتى","https://www.aldiwan.net/poem19501.html","البسيط"],[255,"أمل","https://www.aldiwan.net/poem24947.html","مجزوء الرمل"],[260,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[311,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[323,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[365,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[399,"هل غيرُ أن كثُر الأشر وأهلكت","https://www.aldiwan.net/poem695.html",""],[404,"إن ناب خطب أو عرا حادث","https://www.aldiwan.net/poem33371.html","السريع"],[404,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[433,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[478,"لما استحث حداة الجيرة الابلا","https://www.aldiwan.net/poem15257.html","البسيط"],[563,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[587,"منعت جفوني لذة الإغفاء","https://www.aldiwan.net/poem17400.html","الكامل"]],"verses":[["هَل غادَروا إِلّا حَشاً","قَلِقاً وَقَلباً مُستَفَزّا",0,"ز",2,0],["هَل غادَرَ الشُعَراءُ مِن مُتَرَدَّمِ","أَم هَل عَرَفتَ الدارَ بَعدَ تَوَهُّمِ",1,"م",1,1],["هَل غَيرَ أَن مَحضَ الوَفاءَ لِغادِرٍ","أَو غَيرَ أَن صَدَقَ الوِصالَ لِقاطِعِ",2,"ع",1,0],["هَل غَيرُ نُإيٍ مُحيلٍ في مَنازِلِهِم","أَو غَيرُ أَورَقَ بَينَ المُثَّلِ الجونِ",3,"ن",1,0],["هل غير قولي قائمٌ بصفات ما","قد قلت يا ابن عليّ لا ومحمد",4,"د",1,0],["هَل غايَةُ الوَجدِ المُبَرَّحِ غَيرُ أَن","يَعلو نَشيجٌ أَو تَفيضَ مَدامِعُ",5,"ع",1,0],["هَل غَيرُ بُؤسى ساعَةٍ أَلبَستَها","بِنَداكَ ما لَبِسَت مِنَ الإِنعامِ",6,"م",1,0],["هل غيرُ أنْ تَتَيَقَّظِي","فتُعَاوِدِي كَرَّ الخِصامِ",7,"م",1,0],["هل غُودرتْ للزّارعينَ وسيلةٌ","أو خُلّيتْ للصّانعين أداةُ",8,"ه",1,0],["هَل غَيرُ دارٍ بَكَرَت ريحُها","تَستَنُّ في جائِلِ رَمرامِها",9,"م",3,0],["هَل غَيرُ إِمساكٍ بِأَطرافِ المُنى","فيها لِطالِبِ خِلَّةٍ أَو راجي",10,"ج",2,0],["هل غير أُخرى صَيلَمٌ إنّ الذي","وقّاكَ تلك بأُختِها لَضَمين",11,"ن",1,0],["هل غير شكري نعمةٌ أتعَبَتْ","صَمتي وأُخرَى أتْعَبَتْ نُطْقي",12,"ق",2,0],["هَل غَيرَ أَن كُنتَ فَتىً عاشِقاً","أَهلَكَكَ الحُبُّ وَأَغواكا",13,"ك",2,0],["هَلْ غَيْرُ هَذَا الصَّرْحِ زِينَ بِمِثْلٍِ مَا","فِيهِ لإِينَاسٍ وَحُسْنِ لِقَاءِ",14,"ا",2,0],["هل غيرُ أن رُمتَ الثناء كما ادعي","نَفَرٌ ، وأن أنْبَهتَ ذكرَكَ عامدا",15,"د",2,0],["هل غيرُ آلافٍ تروحُ كما اغتدت","بيَدى سواكَ طرائقاً وبدائدا",15,"د",2,0],["هل غير هذا يا طريق تقول لي ؟","أسألت ؟ يمضي يجتذي أوصالي",16,"ل",2,0],["هل غيرة من باب جانب جودكم","تبقى الحسود بغيظ كيد ضلاله",17,"ل",2,0],["هَل غالَني زَمَنٌ وَظِلُّكَ عاصِمي","أَو فاتَني طَلَبٌ وَأَنتَ المَطلَبُ",18,"ب",1,0],["هَل غَيرُ ظِلِّكَ لِلعُفاةِ مَقيلُ","أَم غَيرُ عَفوِكَ لِلجُناةِ مُقيلُ",19,"ل",1,1],["هَل غَيرُ إحراقِ غَلّاتٍ وَقَد شَقِيَت","بِهِم عَجائِزُ هِمّاتٌ وَأَطفالُ",20,"ل",1,0],["هَل غَيرُنا كانَ يَلقاهُم بِعُدَّتِنا","لا وَالَّذي بَيَّنَ الفُرقانَ تَبيينا",21,"ن",2,0],["هل غير إحسانِ فعلٍ أو إساءَته","يبقى جزاؤهما في الصُّحف مرقوما",22,"م",2,0],["هَلْ غَيْرَةٌ تَقْتَضِي طُهْرِي مِنْ نَجَسِ ال","شِّرْكِ بِمُطْلَقِ دِينِ الْمِلَّةِ الصِّرْفَهْ",23,"ف",2,0],["هل غدا عشقي صلاةً؟","لَيْتَهُ ما كان ديني!",24,"ن",2,0],["هل غير جنابك يقصد لا","وجمالِك ذي الحسن البهِج",25,"ج",1,0],["هل غير بابك للغريب مؤمل","أو عن جنابك للأماني معدل",26,"ل",1,1],["هَل غَشِينا مَحرَماً مِن قَومِنا","أَو جَزَينا جازِياً فُحشاً بِفُحش",27,"ش",1,0],["هل غافِرٌ أنت تَقْصيراً عثَرْتُ به","يا مَنْ بلُقياهُ ذَنْبُ الدّهرِ يُغتَفَر",28,"ر",1,0],["هَل غَيرُ أن كَثُرَ الأشرُّ وأَهلَكَت","حَربُ الصَّديقِ أَكاثِرَ الأَموالِ",29,"ل",1,1],["هل غير رب العرش سبحانه","أخرج ذا النون من النون",30,"ن",1,0],["هل غير حضرتك الرفيعة مقصد","هل من سواها يطلب استجداء",31,"ا",2,0],["هل غَيْرُ صاحِبِِكَ المُوفِي إِذا غَدَروا","أَو غَيْرُ خَادِِمِكَ الباقِي إِذا انْحَرَفَوا",32,"ف",3,0],["هل غيَّرَ البينُ ما قد كنتُ أعهَدُه","حتى تعاينَ منّي وامقاً خَجِلا",33,"ل",2,0],["هل غارَ من كَفِّ الأميرِ مُحمَّدٍ","كم حاسدٍ حَسَدَ الأميرَ محمَّدا",34,"د",2,0],["هَلْ غِيثَ رَبْعُ الحَيّ بَعْدَ مَدامِعي","أَمْ أَمْسَكَتْ عَنْهُ يَدُ الأَنْواءِ",35,"ا",2,0]]}