مير تبلد الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=188737",""],[4978,"أنشدت شِعرك فالسنا يتجدد","https://www.poetsgate.com/ViewPoem.aspx?id=177533",""],[5011,"قمري البان","https://www.poetsgate.com/ViewPoem.aspx?id=197870",""],[5038,"إنبطح يا عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=195230",""],[585,"يا صاحب التاج ما للقوم في وصب","https://www.poetsgate.com/ViewPoem.aspx?id=161843",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5185,"الأقنعة","https://www.poetsgate.com/ViewPoem.aspx?id=73329",""],[5273,"نداء","https://www.poetsgate.com/ViewPoem.aspx?id=28772",""],[5277,"مقهى البيروتي.. ذاكرة المكان..","https://www.poetsgate.com/ViewPoem.aspx?id=185251",""],[5324,"بغداد مشفقة على أعدائها .","https://www.poetsgate.com/ViewPoem.aspx?id=207568",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5493,"كل له ظله","https://www.poetsgate.com/ViewPoem.aspx?id=197568",""],[5510,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=205683",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5690,"للعدل والإصلاح أنت كفيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=172177",""],[5693,"أين أنتم يا صفاتي ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=35587",""],[5736,"يا حادي الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=203923",""],[3856,"مَعنًى يُجَاهِدُ فِي شِفاهِ الأبكَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=215913",""],[5781,"خَمائِلهُ بِلَونِ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=208990",""],[5956,"منطقُ الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=192220",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6142,"أمريضا بالسير بنت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=155735",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[6142,"يا مفعم البئر في بدر أشاوسة","https://www.poetsgate.com/ViewPoem.aspx?id=155712",""],[6142,"من فالق الكبش من قرن إلى قدم","https://www.poetsgate.com/ViewPoem.aspx?id=155714",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6242,"قلمٌ حائر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87569&r=&rc=16",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""]],"verses":[["هَل غادَروا إِلّا حَشاً","قَلِقاً وَقَلباً مُستَفَزّا",0,"ز",2,0],["هَل غادَرَ الشُعَراءُ مِن مُتَرَدَّمِ","أَم هَل عَرَفتَ الدارَ بَعدَ تَوَهُّمِ",1,"م",1,1],["هَل غَيرَ أَن مَحضَ الوَفاءَ لِغادِرٍ","أَو غَيرَ أَن صَدَقَ الوِصالَ لِقاطِعِ",2,"ع",1,0],["هَل غَيرُ نُإيٍ مُحيلٍ في مَنازِلِهِم","أَو غَيرُ أَورَقَ بَينَ المُثَّلِ الجونِ",3,"ن",1,0],["هل غير قولي قائمٌ بصفات ما","قد قلت يا ابن عليّ لا ومحمد",4,"د",1,0],["هَل غايَةُ الوَجدِ المُبَرَّحِ غَيرُ أَن","يَعلو نَشيجٌ أَو تَفيضَ مَدامِعُ",5,"ع",1,0],["هَل غَيرُ بُؤسى ساعَةٍ أَلبَستَها","بِنَداكَ ما لَبِسَت مِنَ الإِنعامِ",6,"م",1,0],["هل غيرُ أنْ تَتَيَقَّظِي","فتُعَاوِدِي كَرَّ الخِصامِ",7,"م",1,0],["هل غُودرتْ للزّارعينَ وسيلةٌ","أو خُلّيتْ للصّانعين أداةُ",8,"ه",1,0],["هَل غَيرُ دارٍ بَكَرَت ريحُها","تَستَنُّ في جائِلِ رَمرامِها",9,"م",3,0],["هَل غَيرُ إِمساكٍ بِأَطرافِ المُنى","فيها لِطالِبِ خِلَّةٍ أَو راجي",10,"ج",2,0],["هل غير أُخرى صَيلَمٌ إنّ الذي","وقّاكَ تلك بأُختِها لَضَمين",11,"ن",1,0],["هل غير شكري نعمةٌ أتعَبَتْ","صَمتي وأُخرَى أتْعَبَتْ نُطْقي",12,"ق",2,0],["هَل غَيرَ أَن كُنتَ فَتىً عاشِقاً","أَهلَكَكَ الحُبُّ وَأَغواكا",13,"ك",2,0],["هَلْ غَيْرُ هَذَا الصَّرْحِ زِينَ بِمِثْلٍِ مَا","فِيهِ لإِينَاسٍ وَحُسْنِ لِقَاءِ",14,"ا",2,0],["هل غير اخلاصي ودا","دك يا ابن عمي والصلاح",15,"ح",1,0],["هل غيرُ أن رُمتَ الثناء كما ادعي","نَفَرٌ ، وأن أنْبَهتَ ذكرَكَ عامدا",16,"د",2,0],["هل غيرُ آلافٍ تروحُ كما اغتدت","بيَدى سواكَ طرائقاً وبدائدا",16,"د",2,0],["هل غير هذا يا طريق تقول لي ؟","أسألت ؟ يمضي يجتذي أوصالي",17,"ل",2,0],["هل غيرة من باب جانب جودكم","تبقى الحسود بغيظ كيد ضلاله",18,"ل",2,0],["هَل غالَني زَمَنٌ وَظِلُّكَ عاصِمي","أَو فاتَني طَلَبٌ وَأَنتَ المَطلَبُ",19,"ب",1,0],["هَل غَيرُ ظِلِّكَ لِلعُفاةِ مَقيلُ","أَم غَيرُ عَفوِكَ لِلجُناةِ مُقيلُ",20,"ل",1,1],["هَل غَيرُ إحراقِ غَلّاتٍ وَقَد شَقِيَت","بِهِم عَجائِزُ هِمّاتٌ وَأَطفالُ",21,"ل",1,0],["هَل غَيرُنا كانَ يَلقاهُم بِعُدَّتِنا","لا وَالَّذي بَيَّنَ الفُرقانَ تَبيينا",22,"ن",2,0],["هل غير إحسانِ فعلٍ أو إساءَته","يبقى جزاؤهما في الصُّحف مرقوما",23,"م",2,0],["هَلْ غَيْرَةٌ تَقْتَضِي طُهْرِي مِنْ نَجَسِ ال","شِّرْكِ بِمُطْلَقِ دِينِ الْمِلَّةِ الصِّرْفَهْ",24,"ف",2,0],["هل غدا عشقي صلاةً؟","لَيْتَهُ ما كان ديني!",25,"ن",2,0],["هل غير جنابك يقصد لا","وجمالِك ذي الحسن البهِج",26,"ج",1,0],["هل غير بابك للغريب مؤمل","أو عن جنابك للأماني معدل",27,"ل",1,1],["هَل غَشِينا مَحرَماً مِن قَومِنا","أَو جَزَينا جازِياً فُحشاً بِفُحش",28,"ش",1,0],["هل غافِرٌ أنت تَقْصيراً عثَرْتُ به","يا مَنْ بلُقياهُ ذَنْبُ الدّهرِ يُغتَفَر",29,"ر",1,0],["هَل غَيرُ أن كَثُرَ الأشرُّ وأَهلَكَت","حَربُ الصَّديقِ أَكاثِرَ الأَموالِ",30,"ل",1,1],["هل غير رب العرش سبحانه","أخرج ذا النون من النون",31,"ن",1,0],["هل غير حضرتك الرفيعة مقصد","هل من سواها يطلب استجداء",32,"ا",2,0],["هل غَيْرُ صاحِبِِكَ المُوفِي إِذا غَدَروا","أَو غَيْرُ خَادِِمِكَ الباقِي إِذا انْحَرَفَوا",33,"ف",3,0],["هل غيَّرَ البينُ ما قد كنتُ أعهَدُه","حتى تعاينَ منّي وامقاً خَجِلا",34,"ل",2,0],["هل غارَ من كَفِّ الأميرِ مُحمَّدٍ","كم حاسدٍ حَسَدَ الأميرَ محمَّدا",35,"د",2,0],["هَلْ غِيثَ رَبْعُ الحَيّ بَعْدَ مَدامِعي","أَمْ أَمْسَكَتْ عَنْهُ يَدُ الأَنْواءِ",36,"ا",2,0],["هل غير أن يعذلوني أنني فشلٌ","فكلّ هذا نعم فاغروا بتعذيلي",37,"ل",2,0],["هل غاضت الأنهار من جزع فمن","هذا الدم المسفوك ري الصادي",38,"د",2,0],["هل غير ذلك مسلك","للمكثرين من المآربْ",39,"ب",1,0],["هل غايةٌ في المسيرِ نعرِفُها","أم أمرنا في المسيرِ مُلتَبَسُ",40,"س",1,0],["هَل غَيرُ سَيلٍ مِن دَمٍ دافِقِ","يَروي غَليلَ الساخِطِ الحانِقِ",41,"ق",1,1],["هل غادر القوم حول هودجها","تسيل أرواحهم على الأسل",42,"ل",1,0],["هل غيره قد كان يدعى","الصادق البر الأمينا",43,"ن",2,0],["هل غادرت هل غادر الشعراء في","بحر القريض لوارد من مشرع",44,"ع",1,0],["هل غيرُ هذا الفراقِ حادثةٌ","أعظمُ من خَطبه فيحذرُها",45,"ر",3,0],["هَل غارَ غيرَ ذويهِ مدحهُ سرَفاً","أم صارَ مدحُ سواهُ غيرَ ما اختُرِقا",46,"ق",2,0],["هل غابر من بقايا الدهر تنظره","الا كما قد مضى فيما تقضّونا",47,"ن",2,0],["هل غادرت هل غادر الشعراء في","بحر القصيد لو ارد من مشرع",48,"ع",1,0],["هل غادر الشعرا قولا لمن نظرا","في قول عنترة هل غادر الشعرا",49,"ر",2,1],["هل غير شتى حبوبٍ قد تعاورها","جيش المهاريس أو نخز المناخيز",50,"ز",1,0],["هَل غَير قَلبي لِلنَوى","بِسِهام بعدك قَد جرِح",51,"ح",1,0],["هل غرك ما قال الواشي","اني سالٍ تبت يده",52,"د",2,0],["هَل غياض الواديينِ","لم تَزل مَسارحَ العِين",53,"ن",1,0],["هل غير وجهك يا جميل جميل","كلا ومثلك في الرجال قليل",54,"ل",1,1],["هل غيض بحر الجود الاحسان","ام دك طود الفضل في لبنان",55,"ن",1,1],["هل غيركم فيه نجح أملي","كلا فلا تلمحه عيوني",56,"ن",2,0],["هل غيركم يرجى لفك إلى","هيهات بل هيهات ما كماكم",57,"م",1,0],["هل غالمرء يلقى بالتصفح صحبه","وقد أدرجت تحت الصفيح صحائبه",58,"ب",2,0],["هل غير محمود الصفات اريده","ورياضه ظلّ عليّ ظليل",59,"ل",1,0],["هل غيرها من حبة درّية","تجلو إليك مناظر الآفاق",60,"ق",1,0],["هل غيره من احد في احد","حامي على الدين وواسى ونصر",61,"ر",1,0],["هل غيره بالمخزيات ملفح","او غيره بالمزريات معمم",62,"م",1,0],["هل غير هذا الرشأ القادم","رأيت بدرا غاب في فاحم",63,"م",1,1],["هل غاب حزني بالبها","ئم إذ بهذا قد حضر",64,"ر",1,0],["هَل غادَر الدمع المذا","ل لذي جوى سرّاً مصونا",65,"ن",2,0],["هل غَيْرُه تميّزا","بسهله الممتنع",66,"ع",1,0],["هَل غَير خَير بَني السَبط الكَريم تَرى","بَينَ الوَرى وَهُوَ مثل الشَمس في النجم",67,"م",1,0],["هَل غَطفَةٌ أو زَورَةٌ أو وَقفةٌ","أو لَفظَةٌ تَقضِي بإدرَاكِ الوَطَر",68,"ر",1,0],["هل غير كرفك صارم","في الكحل قد صقلوا فرنده",69,"د",2,1],["هل غير خدك جمرة","تقد الجوانح وهي ورده",69,"د",2,0],["هل غيركم يا سادتي","لذنب يوم الحشر غافر",70,"ر",1,0],["هَل غَيرَةٌ وَحَميَّةٌ لِبلادكُم","فالجارُ أَصبَحَ عالِماً مُتَحَضِّراً",71,"ر",2,0],["هل غارت الحور والولدان يا ولدي","منّا فسرتم إليهم حيثما ساروا",72,"ر",3,0],["هل غيَّر الدهر من مولاي معرفةً","كما بفرقتهِ لي أوجب السهرا",73,"ر",2,0],["هل غيرةٌ منكم تأتي على قدرٍ","فيصبح الوادي الميمون قد خصبا",74,"ب",2,0],["هل غازلتك برامة غزلانها","ورعتك من تلك الظباء حسانها",75,"ن",3,1],["هل غادرَ المجدُ والتاريخ موطنهُ ؟","أم قد تمادى بك الأنذال والسَفلُ ؟",76,"ل",1,0],["هَل غَيَّرَ التَّغييرُ ثَورَتَهُ","أم خَانَتِ النَّصَّ التَّفَاسِيرُ؟",77,"ر",1,0],["هل غرّت(ن) للرّاس إلا حنّا","هل سنّ خلع الباب إلا قومي",78,"م",2,0],["هلْ غيرها ..آوَىَ المسيحَ وأمَّهُ ؟","هل غيرها .. وصَّى الرسولُ ببرِها ؟",79,"ر",3,0],["هل غادرَ الإنسانُ منَّا يا تُرى","أم سادَ في أخلاقنا الإفلاسُ",80,"س",1,0],["هل غزةٌ فينا الشقيقةُ ؟ ويحنا","سيكيس عن إسفافنا يتردد",81,"د",1,0],["هل غاب عن ذهنك كلامي لك من العاذل ذهن","لي ما عرف وزنك ولي هو في كلامه ما وزن",82,"ن",1,0],["هَلْ غَيرُعُمْيانِ الْفَتاوى وَاللِّحى","مَنْ حَدَّ لِلتَّكْفيرِفي الْيَدِ خِنْجَرَهْ",83,"ر",2,0],["هل غرك الملك والقواد ساهرةٌ","تطوف حولك بالمران والقضب",84,"ب",1,0],["هل غيابُ الشمس ِعنّي كان عذري","كي أكونَ الآنَ مرغى بالنّحيل ِ",85,"ل",1,0],["هل غرقنا يا حبيبي","في العيون الدامعة ؟",86,"ع",2,0],["هلْ غادرَ الشعراءُ نحو الأنجمِ","أم أنّهمْ رحلوا بلوم اللوَّمِ",87,"م",1,1],["هلْ غادرَ السعدُ يا بغدادُ شاطئَنا","فأنتِ ثكلى وفي الصوبيْنِ باكيهِ",88,"ي",2,0],["هل غيّرت بغداد شكل ردائِها؟","منذ الخليقة والرداءُ جمالُ",89,"ل",1,0],["هَلْ غَابَ عَنْكُمْ مُصابُ الطَّفِّ أَمْ لَعِبَتْ","فيكُمْ عَلَىٰ الغَيِّ والْجَهْلِ الأَضَاليلُ",90,"ل",1,0],["هلْ غابتِ الشمسُ منْ أرجاءِ أزمنتِي","حتّى تغيضَ ظلالُ الأمسِ في سَرَبِ؟!",91,"ب",1,0],["هل غرَّ قلبك أنني لا أعتب","هل بعد مكرك إن حلفتَ سأقرب",92,"ب",1,0],["هَلْ غبت عن وعيي بعي","دا أم تُراني قدْ جنيْت ُ",93,"ت",1,0],["هل غادرتنا نشوة الصبوات أم","للذكريات لها هناك مدام؟",94,"م",1,0],["هل غير مدحت بالعظائِم قائِم","فبغير مدحت ما لذاك سبيلُ",95,"ل",1,0],["هل غفلتم ؟ ذاك قلبي .","في جناب لو علمتم .",96,"م",1,0],["هل غرّكَ النغمُ المنسابُ في لغتي","كي يقتلَ اللحنَ في الأوتارِ مزمارُ",97,"ر",1,0],["\"هَل غادرَ الشُّعراءُ؟\" عرقلَ خَطوَه،","وهو الذي تَركُوه \"مِن مُتَرَدَّمِ\"",98,"م",1,0],["هَلْ غرَّكَ التِّيهُ في ليلاتِ عاشقةٍ","أمْ شَهْوةُ الجُرحِ ذي تَخْبو وتتَّقِدُ ؟",99,"د",1,0],["هل غدا الحُسْن لكي يُغتصَبا","وغدا البترول شيئاً مُرعبا؟",100,"ب",2,0],["هلَّ غوثًا عبد العزيزِ وَسَعدًا","يَنشِدُ الحقَّ بالرِّضَا والإخَاءِ",101,"ا",2,0],["هل غيره لبني الزمان من الردى","أمن المروع ونجدةُ المنجود",102,"د",1,0],["هل غير سيدنا المولى أبي حسن","يأتي من الوجهة المرضي آتيها",103,"ي",3,0],["هل غير معجزة الباري وآيته ال","كُبرى علي أمير النحل كافيها",104,"ي",3,0],["هل غيره كاشف العماء عن ملأ ال","إسلامِ في سطوة الله ساطيها",104,"ي",3,0],["هل غير سيفك للإسلام حاميةٌ","أم هلف سواه لظى الهيجاء حاميها",105,"ي",3,0],["هل غير من حب طه والإله وحباه","وفارس عدنان وحاميها",106,"ي",3,0],["هل غرَّدَ العصفورُ وارتادَ الفضا","إلا ليسمو يا بنى الدنيا الشعورْ",107,"ر",1,0],["(هل غادر الشعراء) شيئاً ينظم؟","فعلام تنفخ في الهواء وتزخم؟",108,"م",1,1],["هل غاب خوفاً من الأقدار تدركه","أم أنَّ بوحك يا سكران أخجله",109,"ل",2,0],["هلْ غادرتْ سُحُبُ الأشواق ِمِنْ دَمِنا","هل هرّبتْ ذلكَ الغيْثَ الذي هَطلا",110,"ل",2,0]]}