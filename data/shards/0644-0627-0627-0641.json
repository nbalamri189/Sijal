{"poems":[[75,"لا افتنان كافتناني","https://www.aldiwan.net/poem11970.html","مجزوء الرمل"],[93,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[68,"أود حسادي أن يكثروا","https://www.aldiwan.net/poem38470.html","السريع"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[48,"من لي بترك الطعام أجمع إن ال","https://www.aldiwan.net/poem23538.html","المنسرح"],[280,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[567,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70708","الخفيف"],[2233,"","https://poetry.dctabudhabi.ae/diwan/poem/98185","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108045","الكامل"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84996","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114292","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119447","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36236","الدوبيت"],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[5431,"كلّي دموعٌ والفرات صلاتي","https://www.poetsgate.com/ViewPoem.aspx?id=186984",""],[5431,"عنه الظلامُ بحول الله منكفئُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201569",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[6068,"يا قرة العينين أفديك -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175869",""]],"verses":[["لا اِفتِنانٌ كَاِفتِناني","في حُلى الظُرفِ الحِسانِ",0,"ن",1,1],["لا اِفتِخارٌ لِنَحلَةٍ وَجَدَت حَق","لاً فَعادَت مِن زَهرِهِ بِالمَجاني",1,"ن",2,0],["لا اِفتِخارٌ إِلّا لِمَن لا يُضامُ","مُدرِكٍ أَو مُحارِبٍ لا يَنامُ",2,"م",1,1],["لا أفقد الحساد إلا إذا","فقدت ما أحسد من أجله",3,"ه",1,0],["لا أُفقِرُ الطَرَبَ القِلاصَ وَلا أُرى","مَع زيرِ نِسوانٍ أَشُدُّ قُتودي",4,"د",2,0],["لا أَفجَعُ الأُمُّ بِالرَضيعِ وَلا","أَشرَكُ هَذا الفَريرَ في اللَبَنِ",5,"ن",1,0],["لا أُفْقَ إِلا أَقاصِيهِ وَإِنْ شَحَطَتْ","فِي دينِها بِهُداه مِنْ أَدَانِيهِ",6,"ي",2,0],["لا أفلحَ البينُ ما أمضَى مَضاربَهُ","كالبرقِ يُخطَفُ من إيماضِهِ البَصَرُ",7,"ر",1,0],["لا افتخارٌ إلا لمنْ عاش عِزَّا","وأبادَ الكفارَ جُنداً وبَزَّا",8,"ز",2,1],["لا افتر ثغر الثرى من بعد بعدهم","ولا ترنح أيك لا ولا بان",9,"ن",1,0],["لا أفرحن بقدر ما عيني ترى","رشأً جميلاً ناطقاً بلساني",10,"ي",1,1],["لا أفتأ الدهرَ أُحامي عن علي","صهرِ الرسولِ ذي الأماناتِ الوفي",11,"ي",1,0],["لاَ آفَةٌ بِالذِي رَأى ثَنَايَاكَ","وَهيَ الثُّرَيَّا بِصُبحٍ مِن مُحَيَّاكَ",12,"ك",1,1],["لا أفقد اللَه العلي دوره","بهاءه وضوءه ونوره",13,"ر",2,0],["لا أَفلَحَ خَيلُ خارجيٍّ جاءَ","يَسعى لِيبيدَ هَذِهِ الخَضراءَ",14,"ا",2,0],["لا أفقَ كُنْتَ تمره","من أعيني..إلاّ انْثَنى",15,"ن",2,0],["لاأفق غير حماقةٍ وضلالةٍ","لازاد غير الظلم والظلماتِ",16,"ت",1,0],["لاأفقَ يبزغُ من أعماق هاوية","إذا رماك لهذي : الجوعُ والظمأ",17,"ا",1,0],["لا أفهم شيئاً منها إلا","أن أرقى في الحال سفينكْ",18,"ك",1,0],["لا أفتح الأجفان من خوف","أن تسقطيني في تجلّيك",19,"ك",1,0]]}