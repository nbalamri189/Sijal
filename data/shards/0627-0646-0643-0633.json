{"poems":[[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[71,"رأيت ظبيا كسرت","https://www.aldiwan.net/poem28479.html","مجزوء الرجز"],[48,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[112,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=34733",""],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[438,"إن كسر الخليج صادفه اليو","https://www.aldiwan.net/poem12325.html","الخفيف"],[580,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122549","الرمل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[1839,"","https://poetry.dctabudhabi.ae/diwan/poem/123640","السريع"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110293","الخفيف"],[2228,"","https://poetry.dctabudhabi.ae/diwan/poem/123771","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[4750,"زيارة","https://www.poetsgate.com/ViewPoem.aspx?id=180413",""],[4805,"هجينيه 1","https://www.poetsgate.com/ViewPoem.aspx?id=176593",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5455,"ليل يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=34432",""],[5461,"شرهة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=28441",""],[5550,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=212912",""],[5701,"حي مصرا رعى المهيمن مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=164580",""],[5794,".. وطن","https://www.poetsgate.com/ViewPoem.aspx?id=122798",""],[5823,"عرس الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=15602",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""]],"verses":[["إِنَّكَ سامٍ سَموَةَّ قَمودِ","فَقُلتُ لا وَالمُبدِئ المُعيدِ",0,"د",1,0],["إنْ كُسرَتْ منهُ يدٌ","يوماً فكمْ قلبٍ كسرْ",1,"ر",1,0],["إِن كَسَّرَتني يَدُ المَنايا","فَما الأَطِبّاءُ جابِرِيّا",2,"ر",3,0],["أنكسرت من الفراق وشوف عيني","شوف عيني وأنت تدري ب أنكساري",3,"ر",2,1],["أنكسرت من الفراق وشوف عيني","شوف عيني وأنت تدري ...... بنكساري",3,"ر",2,0],["إن كَساكَ المديحَ فِكري فكم قد","أمطَرتْ ديمةٌ على الدأْماء",4,"ا",2,0],["إنَّ كَسْرَ الخليجِ صادَفَهُ اليَوْ","مُ وفي عَظْمِهِ من الفَقْرِ كَسْرُ",5,"ر",1,1],["إِن كسرَ الجفنَ فلا غروَ أَن","تكسِرَه الأَبطالُ يومَ النِزال",6,"ل",1,0],["إن كَسبتُم أو حَلَبتم كانَ لي","مِنكمُ واللهِ شَطرَ الحَلَبِ",7,"ب",1,0],["إن كستني من ضنى أجفانها","ثوب سقم فهو أبهى حلتي",8,"ي",1,0],["انكسرت جفونها مثل ما","رنَّقَ في العين قذاة القذي",9,"ي",1,0],["ان كسر الجباه بالفأس خير","لذويها من أن تذل الجباه",10,"ا",2,0],["إن كست أنكست وإن هي يوما","ان حلت انحلت كفاك القيل",11,"ل",1,0],["ان كساه الإله ثوب جنان","فالعدى سلبته في الطف طمرا",12,"ر",2,0],["انكسر وجه السما في عشارقها","تكسر الشمس المويقه وتكسرنا",13,"ن",2,0],["انكس لياقلت ابنهجله","زايد شرفها يرديني",14,"ن",2,0],["إنْ كستهم وقاحة الطين قهرا","مسح الثوب رمشه المقروح",15,"ح",1,0],["إنكسار العاطفه... يعني انحدار","وانحدار العاطفة يعني .. هزيمه",16,"م",2,1],["إنكسرت وقعدت تحط فيّ وتشيل","لين رحت وخذتني في طريق الهيام",17,"م",1,0],["إنكسر جناح قلبي في مطيره","والجناح إليا إنكسر بالطير عاب",18,"ب",1,0],["إنَّ كسْبَ العلاء شيْءٌ على المقْ","دام سهْلٌ وليسَ صعْبَ المرام",19,"م",1,0],["إن كسا النيل أرضها الحلل الخض","ر فكم جرت المطارف حمرا",20,"ر",2,0],["انكسر مجداف .. وأغرقت السفن","همت بك واسرجت للذكرى ركاب",21,"ب",1,0],["إن كسرت أغصاننا فجذورنا","تعطي الشباب وجلهم فرسان",22,"ن",1,0],["إنْ كسوتُ الدَّربَ خطوي لا أُبالي","حيثُ أَنِّي قد أخذتُ الحقَّ وِرْدَا",23,"د",2,0]]}