{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[57,"عفوا تعف نساؤكم في المحرم","https://www.aldiwan.net/poem24638.html","الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[73,"من مبلغ عني البدر الذي كملا","https://www.aldiwan.net/poem11896.html","البسيط"],[73,"أما رضاك فعلق ما له ثمن","https://www.aldiwan.net/poem11905.html","البسيط"],[10,"إن الزمان وما يفنى له عجب","https://www.aldiwan.net/poem21104.html","البسيط"],[93,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[88,"كم قد لبست بها الضحا من روضة","https://www.aldiwan.net/poem44440.html","الكامل"],[88,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[27,"بان الخليط فودعوا بسواد","https://www.aldiwan.net/poem5712.html","الوافر"],[27,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"سبحان مجري الفلك والفلك","https://www.aldiwan.net/poem65811.html","أحذ الكامل"],[38,"أعائر بات يمري العين أم ودق","https://www.aldiwan.net/poem7730.html","البسيط"],[89,"الشعر ما قاله الكرخي عبود","https://www.aldiwan.net/poem44750.html","البسيط"],[85,"إن الزغاليل الكرام بمصرنا","https://www.aldiwan.net/poem7279.html","الكامل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[62,"يا أيها السائل عن سرنا","https://www.aldiwan.net/poem52232.html","السريع"],[62,"يا صاحبي أعيناني على سكن","https://www.aldiwan.net/poem52364.html","البسيط"],[45,"حاشاك من ذكر ثنته كئيبا","https://www.aldiwan.net/poem10895.html","الكامل"],[45,"من مبلغ الطائي وهو مخيم","https://www.aldiwan.net/poem66817.html","الكامل"],[45,"إن الزمان زمان سو","https://www.aldiwan.net/poem66864.html","مجزوء الكامل"],[28,"قال الملائكة الذين تخيروا","https://www.aldiwan.net/poem5254.html","الكامل"],[28,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[49,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[49,"إن الزمان يغرني بأمانه","https://www.aldiwan.net/poem63165.html","الكامل"],[49,"إكره لغيرك ما لنفسك تكره","https://www.aldiwan.net/poem63176.html","الكامل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[80,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[80,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[80,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[44,"محمد بن سعيد أرعني أذنا","https://www.aldiwan.net/poem29706.html","البسيط"],[52,"يا من تبجح في الدنيا وزخرفها","https://www.aldiwan.net/poem26971.html","البسيط"],[52,"عتبت عليك مليحة العتب","https://www.aldiwan.net/poem27304.html","الكامل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[50,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[46,"خف يا كريم على عرض تعرضه","https://www.aldiwan.net/poem23086.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"من للموظف","https://www.poetsgate.com/ViewPoem.aspx?id=179515",""],[51,"قلْ للأمير أدامَ اللَّهُ نعماكا","https://www.poetsgate.com/ViewPoem.aspx?id=30010",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[122,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[122,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[141,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[184,"حسبي ضجرت من الأدب","https://www.aldiwan.net/poem44151.html","مجزوء الكامل"],[197,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[233,"يا مهدي الورد الجني لنا","https://www.aldiwan.net/poem31780.html","السريع"],[233,"أبني أسامة كم تدوم موات","https://www.aldiwan.net/poem31782.html","الكامل"],[259,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[278,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[295,"برق الحمى لاح مجتازا على الكثب","https://www.aldiwan.net/poem33336.html","البسيط"],[351,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[351,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[362,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[362,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[362,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[362,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[399,"مولاي صبرا للقضا","https://www.aldiwan.net/poem46509.html","مجزوء الكامل"],[400,"حتى م ذا الدهر بالتشتيت يرمينا","https://www.aldiwan.net/poem33381.html","الرمل"],[400,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[402,"يا من تبجح بالدنيا وزخرفها","https://www.aldiwan.net/poem49945.html","البسيط"],[446,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[451,"ما جاء قبلك للتخليد إنسان","https://www.aldiwan.net/poem61247.html","البسيط"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[549,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[549,"قولوا لمن غلط الزمان به","https://www.aldiwan.net/poem48069.html","أحذ الكامل"],[556,"إن الزجاجة عبرة للرائي","https://www.aldiwan.net/poem35082.html","الكامل"],[562,"إن الزمان الذي كنا نحاذره","https://www.aldiwan.net/poem851.html",""]],"verses":[["إِنَّ الزَمانَ أَضَنُّ بَعدَ وَفاتِهِ","مِن أَن يُعيدَ لِمِثلِهِ أَشكالا",0,"ل",2,0],["إِنَّ الزِنا دَينٌ فَإِن أَقرَضتَهُ","كانَ الوَفا مِن أَهلِ بَيتِكَ فَاِعلَمِ",1,"م",1,0],["أَنَّ الزَمانَ الَّذي مازالَ يُضحِكُنا","أُنساً بِقُربِهِمُ قَد عادَ يُبكينا",2,"ن",2,0],["أَنَّ الزَمانَ الَّذي أَهدى مَوَدَّتَهُ","إِلَيَّ مُرتَهِنٌ شُكري بِما فَعَلا",3,"ل",2,0],["إِنَّ الزَمانَ الَّذي عَهدي بِهِ حَسَنٌ","قَد حالَ مُذ غابَ عَنّي وَجهُكَ الحَسَنُ",4,"ن",1,0],["إِنَّ الزَمانَ وَما يَفنى لَهُ عَجَبٌ","أَبقى لَنا ذَنَباً وَاِستُؤصِلَ الراسُ",5,"س",1,1],["إنَّ الزِّرَاعَةَ إذْ غَدَوْتَ وَزِيرَهَا","نَشِطَتْ موفَّقَةً لِمَا تَعْتَامُ",6,"م",1,0],["أن الزهور تكنّهنّ براعم","مثل العلوم تجنهن صدور",7,"ر",1,0],["أن الزواج محبّةٌ فإذا جرى","بسوى المحبّة كان شيئاً متعبا",8,"ب",2,0],["إِنَّ الزِنادَ إِذا خَبَت نيرانُهُ","أَورى الوَليدُ لَكُم بِخَيرِ زِنادِ",9,"د",1,0],["إِنَّ الزِيارَةَ لا تُرجى وَدونَهُمُ","جَهمُ المُحيّا وَفي أَشبالِهِ غَضَفُ",10,"ف",1,0],["إِنَّ الزَمانَ أَراهُ في الرَحِيلِ غِنىً","وَلَو إِلى السَدّ أَضحى وَهُوَ يُزمَعُهُ",11,"ع",2,0],["إنَّ الزمانَ الذي تحيا فتبلغُهُ","يا ابنَ الكرام لمغبوطٌ بمحْياكا",12,"ك",2,0],["إن الزمانَ إذا غدا فعدا","قتلَ الملوكَ بكلّ مُعترك",13,"ك",1,0],["إِنَّ الزَمانَ الَّذي تَرجو هَوادِيَهُ","يَأتي عَلى الحَجَرِ القاسي فَيَنفَلِقُ",14,"ق",1,0],["ان الزمان عجوز من تقادمه","وما على وجهه البسام تجعيد",15,"د",1,0],["إن الزغاليل الكرام بمصرنا","كظباء مكة صيدهن حرام",16,"م",1,1],["إِنَّ الزَمانَ وَأَهلَهُ","فَرَغا مِنَ الفَردِ اللَعين",17,"ن",1,0],["إن الزواييق وتركيبها","مع الكباريت أباطيلُ",18,"ل",1,0],["إِنّ الزمانَ الذي كانت بشاشَتُه","للقلبِ والعين ملهىً بانَ وانقرضَا",19,"ض",2,0],["إِنَّ الزَمانَ إِذا تَتابَعَ خَطوُهُ","سَبَقَ الطَلوبَ وَأَدرَكَ المَطلوبا",20,"ب",2,0],["أَنَّ الزِيادَةَ يَومَ رُمتَ زِيادَتي","عادَت عَلَيَّ بِأَكبَرِ النُقصانِ",21,"ن",1,0],["إِنَّ الزَمانَ زَمانُ سَو","وَجَميعُ هَذا الخَلقِ بَو",22,"و",1,1],["إِنَّ الزِيارَةَ في الحَياةِ وَلا أَرى","مَيتاً إِذا دَخَلَ القُبورَ يُزارُ",23,"ر",1,0],["إِنَّ الزِحامَ لِغَيرِكُم فَتَحَيَّنوا","وِردَ العَشِيِّ إِلَيهِ يَخلو المَنهَلُ",24,"ل",1,0],["إِنَّ الزَمانَ لِأَهلِهِ لَمُؤَدَّبٌ","لَو كانَ يَنفَعُ فيهِمُ التَأديبُ",25,"ب",1,0],["إِنَّ الزَمانَ يَغُرُّني بِأَمانِهِ","وَيُذيقُني المَكروهَ مِن حَدَثانِهِ",26,"ن",2,1],["إِنَّ الزَمانَ لِأَهلِهِ لَمُؤَدَّبٌ","بِصُروفِهِ وَمُيَقِّظٌ وَمُنَبِّهُ",27,"ه",1,0],["إِنَّ الزَرازيرَ لَمّا قامَ قائِمُها","تَوَهَّمَت أَنَّها صارَت شَواهينا",28,"ن",2,0],["إنّ الزّمانَ ليجري في تصرّفِهِ","على مُرادك منه غيرَ مُتّهمِ",29,"م",1,0],["إِنَّ الزّمانَ خَديمُ دَولَتِهِ","يُفني أعاديها وإنْ كَثُروا",30,"ر",3,0],["إنّ الزمانَ أصابني بزمانةٍ","أبلت بتجديدِ الحَياة قَشيبي",31,"ب",2,0],["إنّ الزمانَ بما قاسيتُ شيّبَني","ولم أُشَيّبْهُ هذا والزّمانُ أبي",32,"ي",1,0],["إِنَّ الزَمانَ اِنثَنى عَنّي بِغُمَّتِهِ","وَصَدرُ حَسرَتِهِ يَغلي وَيَضطَرِمُ",33,"م",1,0],["إِنَّ الزَمانَ إِذا جَرَّبتَ خِلقَتَهُ","مُقَسَّمُ الأَمرِ بَينَ الصَفوِ وَالكَدَرِ",34,"ر",1,0],["إِنَّ الزَمانَ رَمَت حَوادِثَهُ","هَدَفَ الشَبابِ بِأَسهُمٍ شُهبِ",35,"ب",1,0],["إنّ الزّمانَ على كثافَةِ زَورِهِ","لَيَكِلُّ عن أعباءِ ما يَتَحَمَّل",36,"ل",1,0],["إِنَّ الزِيارَةَ أَعقَبَت بِفُؤادِهِ","طَرَباً فَأَعقَبَ فِتنَةً وَفَسادا",37,"د",2,0],["إِنَّ الزُجاجَةَ لَمّا حُطِّمَت سُبِكَت","وَكَم تَكَسَّرَ مِن دُرٍّ فَما سُبِكا",38,"ك",2,0],["إن الزَلازِل لا تَزال خفيَّة","أَسباب ثورتها عَن الأذهان",39,"ن",1,0],["إنَّ الزَمان صفا سر","ر جاء بالطيبات",40,"ت",1,0],["إن الزواج له حقو","ق واجباتٌ ما رَعاها",41,"ا",3,0],["إن الزهور قصيرةٌ أعمارُها","وقصائدي تبقى على الآباد",42,"د",1,0],["إنا لزمنا الصمت، حتى أحدقت","مِحَنٌ بنا يُنطقن كلَّ جماد",43,"د",1,0],["إنَّ الزمانَ الذي تحيا فتبلغهُ","يا بنَ الكرام لمغبوطٌ بمحْياكا",44,"ك",2,0],["إن الزهور تكهن براعم","مثل العلوم تجنهن صدور",45,"ر",1,0],["إن الزمان ولا أقول زماني","بين الطوابع والرسوم رماني",46,"ي",1,1],["إن الزبيبة منذ اللّه كونها","وعقبها فيه هذا العود يؤذيه",47,"ه",1,0],["إِنَّ الزَمانَ جَنى لَمّا جَنى نَدَماً","فَقامَ مِن فِعلِهِ في الحالِ مُعتَذِرا",48,"ر",2,0],["إن الزمان بمن تقدم","في النباهة منقلب",49,"ب",1,0],["إن الزمانَ لمن جدوا على بَصَرٍ","بالرايِ وهو على الساهينَ باللعبِ",50,"ب",1,0],["إِنَّ الزَمانَ رَمى وَليَّكُمُ","في مُقلَتَيهِ بِحادِثٍ جَلَلِ",51,"ل",1,0],["أَنَّ الزَمانَ يُعيدُ فِكرَتَهُ","فيكُم فَيَسلُكُ مَنهَجَ العَدلِ",52,"ل",1,0],["أنا لزمان لمستجف","لا يدر له لبان",53,"ن",1,0],["إِنَّ الزَّمانَ بَرَتْ عُودِي نَوائِبُهُ","فَما أُعَدُّ بِهِ نَبْعاً وَلا غَرَبا",54,"ب",2,0],["أَنَّ الزَمانَ على الحالينِ مُنقلِبٌ","وَهَل رأَيتَ زَماناً غَيرَ مُنقلِبِ",55,"ب",1,0],["إِنّ الزَمان وَإِن أَنالَهُم منىً","فَلسوف تَنسِف ما بَنوه رِياحُ",56,"ح",1,0],["إِنّ الزَمان الَّذي عمَّ الفَساد بِهِ","بِصالح الدَولة العَلياء قَد صَلُحا",57,"ح",2,0],["إنّ الزمان إذا دهَى بصُروفه","شُكِيَتْ عَظائمُه إلى عُظَمائه",58,"ا",3,0],["إنَّ الزّمانَ على ما فيهِ من نُوَبٍ","تَمُرُّ مَرّاً على الإنسانِ حالاه",59,"ا",2,0],["إنّ الزّمانَ على تَطاوُلِ عَمْرِه","بَرْقٌ يَمُرُّ فخُذْ بحَظِّك أَو دَع",60,"ع",1,0],["إنّ الزّمانَ لباخلٌ فإذا سخَا","يوماً أتَى من جُودِه ببدائع",61,"ع",1,0],["إِنَّ الزَمانَ غادِرُ عِنادُهُ","إِذا التَوى عَلى الفَتى لَم يَكَدِ",62,"د",1,0],["إنّ الزّمان وأنت أدْرى","بالزّمانِ أَبو العَجائبْ",63,"ب",1,0],["إن الزمان الذي قد كان يضحكنا","أنساً بقربكم قد عاد يبكينا",64,"ن",2,0],["إن الزمان وقيت فتنته","أضحى بلا لُبٍّ ولا عقل",65,"ل",1,0],["إنَّ الزَّمانَ كما جَرَّبْتَ خِلقَتَهُ","مُقَسَّمُ الأمرِ بين الصَّفْوِ والكَدَرِ",66,"ر",1,0],["ان الزمان ولا أطيل معاندى","فى حل راحاتى وأمنياتى",67,"ت",2,0],["إن الزمان الذي نورت طلعته","من نوره سطعت للخلد أزمان",68,"ن",1,0],["إِنّ الزّمان جميعَه بك طيّبٌ","إصباحُهُ وظلامُهُ وأصيلُهُ",69,"ل",2,0],["إنّ الزّمانَ ولا عَدْوَى على زمنٍ","سقانِيَ المُرَّ مِن فقدِيك حين سقى",70,"ق",2,0],["إِنَّ الزّمانَ أَرادَ طُرفَتَنا","فَأرى بِما أَعطَاكَهُ عجَبَهْ",71,"ب",2,0],["إن الزجاجة عبرة للرائي","فانظر بها بالباء بعد الراءِ",72,"ا",2,1],["إن الزمان الذي كنا نحاذره","قد ابتلانا فلم يبقي ولم يذر",73,"ر",1,1]]}