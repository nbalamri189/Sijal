ِ أَشكالا",0,"ل",2,0],["إِنَّ الزِنا دَينٌ فَإِن أَقرَضتَهُ","كانَ الوَفا مِن أَهلِ بَيتِكَ فَاِعلَمِ",1,"م",1,0],["أَنَّ الزَمانَ الَّذي مازالَ يُضحِكُنا","أُنساً بِقُربِهِمُ قَد عادَ يُبكينا",2,"ن",2,0],["أَنَّ الزَمانَ الَّذي أَهدى مَوَدَّتَهُ","إِلَيَّ مُرتَهِنٌ شُكري بِما فَعَلا",3,"ل",2,0],["إِنَّ الزَمانَ الَّذي عَهدي بِهِ حَسَنٌ","قَد حالَ مُذ غابَ عَنّي وَجهُكَ الحَسَنُ",4,"ن",1,0],["إِنَّ الزَمانَ وَما يَفنى لَهُ عَجَبٌ","أَبقى لَنا ذَنَباً وَاِستُؤصِلَ الراسُ",5,"س",1,1],["إنَّ الزِّرَاعَةَ إذْ غَدَوْتَ وَزِيرَهَا","نَشِطَتْ موفَّقَةً لِمَا تَعْتَامُ",6,"م",1,0],["أن الزهور تكنّهنّ براعم","مثل العلوم تجنهن صدور",7,"ر",1,0],["أن الزواج محبّةٌ فإذا جرى","بسوى المحبّة كان شيئاً متعبا",8,"ب",2,0],["إِنَّ الزِنادَ إِذا خَبَت نيرانُهُ","أَورى الوَليدُ لَكُم بِخَيرِ زِنادِ",9,"د",1,0],["إِنَّ الزِيارَةَ لا تُرجى وَدونَهُمُ","جَهمُ المُحيّا وَفي أَشبالِهِ غَضَفُ",10,"ف",1,0],["إِنَّ الزَمانَ أَراهُ في الرَحِيلِ غِنىً","وَلَو إِلى السَدّ أَضحى وَهُوَ يُزمَعُهُ",11,"ع",2,0],["إنَّ الزمانَ الذي تحيا فتبلغُهُ","يا ابنَ الكرام لمغبوطٌ بمحْياكا",12,"ك",2,0],["إن الزمانَ إذا غدا فعدا","قتلَ الملوكَ بكلّ مُعترك",13,"ك",1,0],["إِنَّ الزَمانَ الَّذي تَرجو هَوادِيَهُ","يَأتي عَلى الحَجَرِ القاسي فَيَنفَلِقُ",14,"ق",1,0],["ان الزمان عجوز من تقادمه","وما على وجهه البسام تجعيد",15,"د",1,0],["إن الزغاليل الكرام بمصرنا","كظباء مكة صيدهن حرام",16,"م",1,1],["إِنَّ الزَمانَ وَأَهلَهُ","فَرَغا مِنَ الفَردِ اللَعين",17,"ن",1,0],["إن الزواييق وتركيبها","مع الكباريت أباطيلُ",18,"ل",1,0],["إِنّ الزمانَ الذي كانت بشاشَتُه","للقلبِ والعين ملهىً بانَ وانقرضَا",19,"ض",2,0],["إِنَّ الزَمانَ إِذا تَتابَعَ خَطوُهُ","سَبَقَ الطَلوبَ وَأَدرَكَ المَطلوبا",20,"ب",2,0],["أَنَّ الزِيادَةَ يَومَ رُمتَ زِيادَتي","عادَت عَلَيَّ بِأَكبَرِ النُقصانِ",21,"ن",1,0],["إِنَّ الزَمانَ زَمانُ سَو","وَجَميعُ هَذا الخَلقِ بَو",22,"و",1,1],["إِنَّ الزِيارَةَ في الحَياةِ وَلا أَرى","مَيتاً إِذا دَخَلَ القُبورَ يُزارُ",23,"ر",1,0],["إِنَّ الزِحامَ لِغَيرِكُم فَتَحَيَّنوا","وِردَ العَشِيِّ إِلَيهِ يَخلو المَنهَلُ",24,"ل",1,0],["إِنَّ الزَمانَ لِأَهلِهِ لَمُؤَدَّبٌ","لَو كانَ يَنفَعُ فيهِمُ التَأديبُ",25,"ب",1,0],["إِنَّ الزَمانَ يَغُرُّني بِأَمانِهِ","وَيُذيقُني المَكروهَ مِن حَدَثانِهِ",26,"ن",2,1],["إِنَّ الزَمانَ لِأَهلِهِ لَمُؤَدَّبٌ","بِصُروفِهِ وَمُيَقِّظٌ وَمُنَبِّهُ",27,"ه",1,0],["إِنَّ الزَرازيرَ لَمّا قامَ قائِمُها","تَوَهَّمَت أَنَّها صارَت شَواهينا",28,"ن",2,0],["إِنَّ الزَّمَانَيْنِ رَغْمَ البُعْدِ بَيْنَهُمَا","تَطَابَقَا فِي الرَّزَايَا لُحْمَةً وَسَدَى",29,"د",2,0],["إنّ الزّمانَ ليجري في تصرّفِهِ","على مُرادك منه غيرَ مُتّهمِ",30,"م",1,0],["إِنَّ الزّمانَ خَديمُ دَولَتِهِ","يُفني أعاديها وإنْ كَثُروا",31,"ر",3,0],["إنّ الزمانَ أصابني بزمانةٍ","أبلت بتجديدِ الحَياة قَشيبي",32,"ب",2,0],["إنّ الزمانَ بما قاسيتُ شيّبَني","ولم أُشَيّبْهُ هذا والزّمانُ أبي",33,"ب",2,0],["إِنَّ الزَمانَ اِنثَنى عَنّي بِغُمَّتِهِ","وَصَدرُ حَسرَتِهِ يَغلي وَيَضطَرِمُ",34,"م",1,0],["إِنَّ الزَمانَ إِذا جَرَّبتَ خِلقَتَهُ","مُقَسَّمُ الأَمرِ بَينَ الصَفوِ وَالكَدَرِ",35,"ر",1,0],["إِنَّ الزَمانَ رَمَت حَوادِثَهُ","هَدَفَ الشَبابِ بِأَسهُمٍ شُهبِ",36,"ب",1,0],["إنّ الزّمانَ على كثافَةِ زَورِهِ","لَيَكِلُّ عن أعباءِ ما يَتَحَمَّل",37,"ل",1,0],["إِنَّ الزِيارَةَ أَعقَبَت بِفُؤادِهِ","طَرَباً فَأَعقَبَ فِتنَةً وَفَسادا",38,"د",2,0],["إِنَّ الزُجاجَةَ لَمّا حُطِّمَت سُبِكَت","وَكَم تَكَسَّرَ مِن دُرٍّ فَما سُبِكا",39,"ك",2,0],["إن الزَلازِل لا تَزال خفيَّة","أَسباب ثورتها عَن الأذهان",40,"ن",1,0],["إنَّ الزَمان صفا سر","ر جاء بالطيبات",41,"ت",1,0],["إن الزواج له حقو","ق واجباتٌ ما رَعاها",42,"ا",3,0],["إن الزهور قصيرةٌ أعمارُها","وقصائدي تبقى على الآباد",43,"د",1,0],["إنا لزمنا الصمت، حتى أحدقت","مِحَنٌ بنا يُنطقن كلَّ جماد",44,"د",1,0],["إنَّ الزمانَ الذي تحيا فتبلغهُ","يا بنَ الكرام لمغبوطٌ بمحْياكا",45,"ك",2,0],["إن الزهور تكهن براعم","مثل العلوم تجنهن صدور",46,"ر",1,0],["إن الزمان ولا أقول زماني","بين الطوابع والرسوم رماني",47,"ن",2,1],["إن الزبيبة منذ اللّه كونها","وعقبها فيه هذا العود يؤذيه",48,"ه",1,0],["إِنَّ الزَمانَ جَنى لَمّا جَنى نَدَماً","فَقامَ مِن فِعلِهِ في الحالِ مُعتَذِرا",49,"ر",2,0],["إن الزمان بمن تقدم","في النباهة منقلب",50,"ب",1,0],["إن الزمانَ لمن جدوا على بَصَرٍ","بالرايِ وهو على الساهينَ باللعبِ",51,"ب",1,0],["إِنَّ الزَمانَ رَمى وَليَّكُمُ","في مُقلَتَيهِ بِحادِثٍ جَلَلِ",52,"ل",1,0],["أَنَّ الزَمانَ يُعيدُ فِكرَتَهُ","فيكُم فَيَسلُكُ مَنهَجَ العَدلِ",53,"ل",1,0],["أنا لزمان لمستجف","لا يدر له لبان",54,"ن",1,0],["إِنَّ الزَّمانَ بَرَتْ عُودِي نَوائِبُهُ","فَما أُعَدُّ بِهِ نَبْعاً وَلا غَرَبا",55,"ب",2,0],["أَنَّ الزَمانَ على الحالينِ مُنقلِبٌ","وَهَل رأَيتَ زَماناً غَيرَ مُنقلِبِ",56,"ب",1,0],["إِنّ الزَمان وَإِن أَنالَهُم منىً","فَلسوف تَنسِف ما بَنوه رِياحُ",57,"ح",1,0],["إِنّ الزَمان الَّذي عمَّ الفَساد بِهِ","بِصالح الدَولة العَلياء قَد صَلُحا",58,"ح",2,0],["إنّ الزمان إذا دهَى بصُروفه","شُكِيَتْ عَظائمُه إلى عُظَمائه",59,"ا",3,0],["إنَّ الزّمانَ على ما فيهِ من نُوَبٍ","تَمُرُّ مَرّاً على الإنسانِ حالاه",60,"ا",2,0],["إنّ الزّمانَ على تَطاوُلِ عَمْرِه","بَرْقٌ يَمُرُّ فخُذْ بحَظِّك أَو دَع",61,"ع",1,0],["إنّ الزّمانَ لباخلٌ فإذا سخَا","يوماً أتَى من جُودِه ببدائع",62,"ع",1,0],["إِنَّ الزَمانَ غادِرُ عِنادُهُ","إِذا التَوى عَلى الفَتى لَم يَكَدِ",63,"د",1,0],["إنّ الزّمان وأنت أدْرى","بالزّمانِ أَبو العَجائبْ",64,"ب",1,0],["إن الزمان الذي قد كان يضحكنا","أنساً بقربكم قد عاد يبكينا",65,"ن",2,0],["إن الزمان وقيت فتنته","أضحى بلا لُبٍّ ولا عقل",66,"ل",1,0],["إنَّ الزَّمانَ كما جَرَّبْتَ خِلقَتَهُ","مُقَسَّمُ الأمرِ بين الصَّفْوِ والكَدَرِ",67,"ر",1,0],["ان الزمان ولا أطيل معاندى","فى حل راحاتى وأمنياتى",68,"ت",2,0],["إن الزمان الذي نورت طلعته","من نوره سطعت للخلد أزمان",69,"ن",1,0],["إِنّ الزّمان جميعَه بك طيّبٌ","إصباحُهُ وظلامُهُ وأصيلُهُ",70,"ل",2,0],["إنّ الزّمانَ ولا عَدْوَى على زمنٍ","سقانِيَ المُرَّ مِن فقدِيك حين سقى",71,"ق",2,0],["إِنَّ الزّمانَ أَرادَ طُرفَتَنا","فَأرى بِما أَعطَاكَهُ عجَبَهْ",72,"ب",2,0],["إن الزجاجة عبرة للرائي","فانظر بها بالباء بعد الراءِ",73,"ا",2,1],["إن الزمان الذي كنا نحاذره","قد ابتلانا فلم يبقي ولم يذر",74,"ر",1,1],["إن الزكيَّ زكا في الناس منبته","ودام يرويه نبع المجد ما نضبا",75,"ب",2,0]