{"poems":[[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[72,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[72,"يا مشتكي الهم دعه وانتظر فرجا","https://www.aldiwan.net/poem20349.html","البسيط"],[51,"استقبل المهرجان بالفرح","https://www.aldiwan.net/poem9407.html","المنسرح"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[66,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[81,"رحب بضيف الأنس قد أقبلا","https://www.aldiwan.net/poem61405.html","الطويل"],[81,"نظر جرى قلبي على آثاره","https://www.aldiwan.net/poem61515.html","الكامل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[46,"يا مشرع الرمح في تثبيت مملكة","https://www.aldiwan.net/poem22282.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[107,"مهلا فحبك بي أراه عابثا","https://www.aldiwan.net/poem16450.html","الكامل"],[113,"يا مشهدا بجوار ايوب ازدهى","https://www.aldiwan.net/poem40454.html","عموديه"],[195,"لا الروض روض ولا الصهباء صهباء","https://www.aldiwan.net/poem39803.html","البسيط"],[202,"يا صيرفيا هواه","https://www.aldiwan.net/poem53236.html","المجتث"],[233,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[280,"من منصفي من غزال الترك ذي الدعج","https://www.aldiwan.net/poem32835.html","البسيط"],[280,"عيناك بالنيران قلبي أصلتا","https://www.aldiwan.net/poem32844.html","الكامل"],[347,"يا حسنا ظاهره","https://www.aldiwan.net/poem15945.html","مجزوء الرجز"],[351,"يا مشير الدولة العليا ومن","https://www.aldiwan.net/poem40585.html","الرمل"],[362,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[364,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[374,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[413,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[434,"أزال لقياك ما ألقى من الحزن","https://www.aldiwan.net/poem2603.html","البسيط"],[493,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[556,"يا مشتغلا بكامل الإيمان","https://www.aldiwan.net/poem33837.html","الدوبيت"],[565,"يا مشبها في لونه فعله","https://www.aldiwan.net/poem69471.html","السريع"]],"verses":[["يا مشيراً أشارَ خير السلاط","ين إلى فضله فضاع فضله",0,"ل",2,0],["يا مشتري سلع الثناء بماله","هنئت مرتبة على كيوان",1,"ن",1,0],["يا مشتكي الهمّ دعه وانْتظر فرجاً","ودار وقتك من حينٍ إلى حين",2,"ن",1,1],["يا مُشبِهَ المهرجان مُفْتَتِحاً","من دولةِ الغيْثِ خَيْر مُفتَتحِ",3,"ح",1,0],["يا مشرباً كان لي بلا كدرٍ","يا سمراً كان لي بلا سهرِ",4,"ر",1,0],["يا مشكلا لمّا نزل","ومشكلَين إن رحل",5,"ل",1,0],["يا مشتهى انكلتره","يا بنت أخت لندره",5,"ه",1,0],["يا مُشبِهَ البَدرِ حينَ يَبدو","في النورِ وَالبُعدِ وَالكَمالِ",6,"ل",1,0],["يا مَشهَداً صَدَرَت بِفَرحَتِهِ إِلى","أَمصارِها القُصوى بَنو الأَمصارِ",7,"ر",1,0],["يا مُشرِفاً يُرجى كَما يُتَّقى","يا مُنقِذَ الغَرقى وَآسي الِجراح",8,"ح",1,0],["يا مَشرَفِيّاً غَرَّني بِفِرِندِهِ","وَنَسيتُ ما في حَدِّهِ وَغِرارِهِ",9,"ر",2,0],["يا مَشرَفيُّ اسْجُدْ له من بينهِمْ","يا باطلُ ازهقْ يا حقيقةُ حَصْحِصي",10,"ص",2,0],["يا مُشرِعَ الرُمحِ في تَثبيتِ مَملَكَةٍ","خَيرٌ مِنَ المارِنِ الخَطِيِّ مِسباحُ",11,"ح",1,1],["يا مشترى الآداب لا تسعوا فقد","نفد المتاع وسدَّت الأسواق",12,"ق",1,0],["يا مشبه الآرام إِلّا أَنَّهُ","خَلَقت لَنا عَيناهُ سِحراً نافِثا",13,"ث",2,0],["يا مشهدا بجوار ايوب ازدهى","من قومنا فلذ العبا باثنين",14,"ن",1,1],["يا مشعل الروح كم قال العواذلُ لي","لا أنتِ ولا حوّاءُ حوّاء",15,"ا",2,0],["يا مُشبِهَ الحُور لا بل","أجلُّ منها وألطَف",16,"ف",1,0],["يا مُشرِقَ البَحرِ الخِضَمِّ بِمائِهِ","إِسلَم فَقَد هَلَكَ الحَسودُ بِدائِهِ",17,"ا",3,1],["يا مُشهِرَ السَيفِ في الهَيجاءِ مُشتَهِراً","أغمده عَيناكَ قَد أَغنَتكَ في الرَهَجِ",18,"ج",1,0],["يا مُشمِتاً بي حاسِدي لَمّا رَأى","شَملي بِهِ بَعدَ الدُنُوِّ مُشَتَّتا",19,"ت",2,0],["يا مُشهِدي مِن حُسنِهِ","ما غِبتُ فيهِ عَنّي",20,"ن",2,0],["يا مُشير الدَولة العليا وَمَن","هُوَ في أَربابِها مِن لُبّها",21,"ب",3,1],["يا مُشتكَي كُلِّ حُرٍّ رابَه زَمنٌ","لا روَّع الحُرَّ أن يَلقاكَ مُشتكيا",22,"ي",2,0],["يا مُشبِهَ المُعتَفي حاشا مَكارِمَهُ","وَما زَلَلتُ فَلا تُلحِق بِيَ الزَلَلا",23,"ل",2,0],["يا مشهداً أضحى بعيني أغبراً","لكنه في القلب أسودُ أسفع",24,"ع",1,0],["يا مشيراً بالذي يرشدنا","إنَّما أنتَ بطرق الرُّشد أهدى",25,"د",2,0],["يا مشمحرة العلا إن حلّ غيركمُ ال","وهاد لم نزلوا إلا على القنَنِ",26,"ن",1,0],["يا مُشرعاً للندى عذباً موارده","بيناه مبتسم الأرجاء إذ نضبا",27,"ب",2,0],["يا مشتغلاً بكامل الإيمانِ","تسبيحك لم يخرج عن الإمكانِ",28,"ن",1,1],["يَا مُشْبِهَاً فِي لَوْنِهِ فِعْلَهُ","لَمْ تَعْدُ مَا أَوْجَبَتِ القِسْمَهْ",29,"ه",1,1]]}