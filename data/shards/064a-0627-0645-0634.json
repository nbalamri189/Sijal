{"poems":[[74,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[74,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[74,"يا مشتكي الهم دعه وانتظر فرجا","https://www.aldiwan.net/poem20349.html","البسيط"],[53,"استقبل المهرجان بالفرح","https://www.aldiwan.net/poem9407.html","المنسرح"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[68,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[46,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[83,"رحب بضيف الأنس قد أقبلا","https://www.aldiwan.net/poem61405.html","الطويل"],[83,"نظر جرى قلبي على آثاره","https://www.aldiwan.net/poem61515.html","الكامل"],[77,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"يا مشرع الرمح في تثبيت مملكة","https://www.aldiwan.net/poem22282.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[113,"مهلا فحبك بي أراه عابثا","https://www.aldiwan.net/poem16450.html","الكامل"],[119,"يا مشهدا بجوار ايوب ازدهى","https://www.aldiwan.net/poem40454.html","عموديه"],[201,"لا الروض روض ولا الصهباء صهباء","https://www.aldiwan.net/poem39803.html","البسيط"],[208,"يا صيرفيا هواه","https://www.aldiwan.net/poem53236.html","المجتث"],[240,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[287,"من منصفي من غزال الترك ذي الدعج","https://www.aldiwan.net/poem32835.html","البسيط"],[287,"عيناك بالنيران قلبي أصلتا","https://www.aldiwan.net/poem32844.html","الكامل"],[354,"يا حسنا ظاهره","https://www.aldiwan.net/poem15945.html","مجزوء الرجز"],[358,"يا مشير الدولة العليا ومن","https://www.aldiwan.net/poem40585.html","الرمل"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[382,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[443,"أزال لقياك ما ألقى من الحزن","https://www.aldiwan.net/poem2603.html","البسيط"],[500,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[563,"يا مشتغلا بكامل الإيمان","https://www.aldiwan.net/poem33837.html","الدوبيت"],[572,"يا مشبها في لونه فعله","https://www.aldiwan.net/poem69471.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122744","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87274","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86923","الرمل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66986","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64360","البسيط"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49902","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119967","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35392","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56202","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117564","الكامل"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140223",""],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44842","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80066","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108892","البسيط"],[1796,"","https://poetry.dctabudhabi.ae/diwan/poem/198800","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118310","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114774","المنسرح"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188166","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123169","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108493","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53145","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53077","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53231","الرجز"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198405",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112548","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62791","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103617","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110024","البسيط"],[3950,"","https://poetry.dctabudhabi.ae/diwan/poem/146098","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127234","الكامل"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100666","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133201",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33530","الكامل"],[4562,"","https://poetry.dctabudhabi.ae/diwan/poem/199212","المجتث"],[4755,"أَكُلَّما جَدَّ حُزنٌ في دَمي انطَفَأَت","https://www.poetsgate.com/ViewPoem.aspx?id=191419",""],[4800,"رقص الزار","https://www.poetsgate.com/ViewPoem.aspx?id=104751",""],[4858,"موكب النور","https://www.poetsgate.com/ViewPoem.aspx?id=29798",""],[4858,"إلى كلّ مُبْتلىً بالتّدخين","https://www.poetsgate.com/ViewPoem.aspx?id=138778",""],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""],[4862,"يامشعلا بحشاشتي نيرانا","https://www.poetsgate.com/ViewPoem.aspx?id=55517",""],[4862,"الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=97000",""],[4978,"تحية لأستاذتي نادية بوغرارة","https://www.poetsgate.com/ViewPoem.aspx?id=189774",""],[4987,"لاتنشغل","https://www.poetsgate.com/ViewPoem.aspx?id=49563",""],[5028,"تحلا بعيني","https://www.poetsgate.com/ViewPoem.aspx?id=27713",""],[5032,"جبل الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=189969",""],[5055,"ريحة عود","https://www.poetsgate.com/ViewPoem.aspx?id=103649",""],[5434,"يامشتري حظ","https://www.poetsgate.com/ViewPoem.aspx?id=37626",""],[5606,"ماياجيك باس","https://www.poetsgate.com/ViewPoem.aspx?id=196788",""],[5732,"يامشرف المرقاب","https://www.poetsgate.com/ViewPoem.aspx?id=177886",""],[5767,"يا مشفقاً من خمول قوم","https://www.poetsgate.com/ViewPoem.aspx?id=186784",""],[402,"أكملت للعقبى جهادك","https://www.poetsgate.com/ViewPoem.aspx?id=36014",""],[5848,"يا لابسين الأقنعة والقناعات","https://www.poetsgate.com/ViewPoem.aspx?id=48843",""],[6003,"خفقات متيم","https://www.poetsgate.com/ViewPoem.aspx?id=188896",""],[6115,"يا مشغلٍ فكره بما قالوا الناس!","https://www.poetsgate.com/ViewPoem.aspx?id=186666",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[201,"لاالروض روض ولا الصهباء صهباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65315&r=&rc=18",""]],"verses":[["يا مشيراً أشارَ خير السلاط","ين إلى فضله فضاع فضله",0,"ل",2,0],["يا مشتري سلع الثناء بماله","هنئت مرتبة على كيوان",1,"ن",1,0],["يا مشتكي الهمّ دعه وانْتظر فرجاً","ودار وقتك من حينٍ إلى حين",2,"ن",1,1],["يا مُشبِهَ المهرجان مُفْتَتِحاً","من دولةِ الغيْثِ خَيْر مُفتَتحِ",3,"ح",1,0],["يا مشرباً كان لي بلا كدرٍ","يا سمراً كان لي بلا سهرِ",4,"ر",1,0],["يا مشكلا لمّا نزل","ومشكلَين إن رحل",5,"ل",1,0],["يا مشتهى انكلتره","يا بنت أخت لندره",5,"ه",1,0],["يا مُشبِهَ البَدرِ حينَ يَبدو","في النورِ وَالبُعدِ وَالكَمالِ",6,"ل",1,0],["يا مَشهَداً صَدَرَت بِفَرحَتِهِ إِلى","أَمصارِها القُصوى بَنو الأَمصارِ",7,"ر",1,0],["يا مُشرِفاً يُرجى كَما يُتَّقى","يا مُنقِذَ الغَرقى وَآسي الِجراح",8,"ح",1,0],["يا مَشرَفِيّاً غَرَّني بِفِرِندِهِ","وَنَسيتُ ما في حَدِّهِ وَغِرارِهِ",9,"ر",2,0],["يا مَشرَفيُّ اسْجُدْ له من بينهِمْ","يا باطلُ ازهقْ يا حقيقةُ حَصْحِصي",10,"ص",2,0],["يا مُشرِعَ الرُمحِ في تَثبيتِ مَملَكَةٍ","خَيرٌ مِنَ المارِنِ الخَطِيِّ مِسباحُ",11,"ح",1,1],["يا مشترى الآداب لا تسعوا فقد","نفد المتاع وسدَّت الأسواق",12,"ق",1,0],["يا مشعل النور كم حرّية ذبحت","على يديك ونور مات بل وئدا",13,"د",2,0],["يا مشبه الآرام إِلّا أَنَّهُ","خَلَقت لَنا عَيناهُ سِحراً نافِثا",14,"ث",2,0],["يا مشهدا بجوار ايوب ازدهى","من قومنا فلذ العبا باثنين",15,"ن",1,1],["يا مشعل الروح كم قال العواذلُ لي","لا أنتِ ولا حوّاءُ حوّاء",16,"ا",2,0],["يا مُشبِهَ الحُور لا بل","أجلُّ منها وألطَف",17,"ف",1,0],["يا مُشرِقَ البَحرِ الخِضَمِّ بِمائِهِ","إِسلَم فَقَد هَلَكَ الحَسودُ بِدائِهِ",18,"ا",3,1],["يا مُشهِرَ السَيفِ في الهَيجاءِ مُشتَهِراً","أغمده عَيناكَ قَد أَغنَتكَ في الرَهَجِ",19,"ج",1,0],["يا مُشمِتاً بي حاسِدي لَمّا رَأى","شَملي بِهِ بَعدَ الدُنُوِّ مُشَتَّتا",20,"ت",2,0],["يا مُشهِدي مِن حُسنِهِ","ما غِبتُ فيهِ عَنّي",21,"ن",2,0],["يا مُشير الدَولة العليا وَمَن","هُوَ في أَربابِها مِن لُبّها",22,"ب",3,1],["يا مُشتكَي كُلِّ حُرٍّ رابَه زَمنٌ","لا روَّع الحُرَّ أن يَلقاكَ مُشتكيا",23,"ي",2,0],["يا مُشبِهَ المُعتَفي حاشا مَكارِمَهُ","وَما زَلَلتُ فَلا تُلحِق بِيَ الزَلَلا",24,"ل",2,0],["يا مشهداً أضحى بعيني أغبراً","لكنه في القلب أسودُ أسفع",25,"ع",1,0],["يا مشيراً بالذي يرشدنا","إنَّما أنتَ بطرق الرُّشد أهدى",26,"د",2,0],["يا مشمحرة العلا إن حلّ غيركمُ ال","وهاد لم نزلوا إلا على القنَنِ",27,"ن",1,0],["يا مُشرعاً للندى عذباً موارده","بيناه مبتسم الأرجاء إذ نضبا",28,"ب",2,0],["يا مشتغلاً بكامل الإيمانِ","تسبيحك لم يخرج عن الإمكانِ",29,"ن",1,1],["يَا مُشْبِهَاً فِي لَوْنِهِ فِعْلَهُ","لَمْ تَعْدُ مَا أَوْجَبَتِ القِسْمَهْ",30,"ه",1,1],["يا مُشبِهاً بيضَ السُّيُوفِ","وَمُشبِهاً سُمرَ الأسَل",31,"ل",1,0],["يا مَشاهيرَ البيادهْ","أَنتمُ في الحَرب سادَهْ",32,"ه",1,0],["يا مُشيراً جُود كَفيه غَدا","يَزدَري في كُل واد بِالبِحار",33,"ر",1,0],["يا مُشْبِهَ المَلِكِ الجَعْدِيِّ تَسْمِيَةً","ومُخْجِلَ القمرِ البَدْرِيِ أَنْوَارَا",34,"ر",2,0],["يا مشتكي الهم والأحداث والنوب","أنفِ الهموم بأم اللهو والطرب",35,"ب",1,1],["يا مشتكي الهم دعه وانتظر فرجا","ممن يفرج كربات المساكين",36,"ن",1,1],["يا مشمس الآراء يوم عجاجة","كدراء مظلمة ونقع عاتم",37,"م",1,0],["يا مُشبِهَ المَهدِيِّ في آرائِهِ","حَزماً وَفي كَرّاتِهِ إِقداما",38,"م",2,0],["يا مشهراً بمروّةٍ وفتوّةٍ","وشهامةٍ بسواه أصلاً لم تبنْ",39,"ن",1,0],["يا مُشتكي ألم الهوى إن الذي","تشكو إليه مُستهامٌ وامقُ",40,"ق",1,1],["يا مشيبا قد توافى مرحبا","صاحب لي أينما قد سرت سار",41,"ر",1,0],["يَا مُشبِهَ القَوسِ إِلا أَنَّ أَسهُمَهُ","قَضَت عَلَى مَن تَبَنَّاهُ مِنَ الأُمَمِ",42,"م",1,0],["يا مشبهاً عندي أبا","محمود في طيب الخليقه",43,"ق",2,0],["يا مشبع الطير أبطالاً إن انتقما","ومشبع الناس أطياراً إذا رحما",44,"م",2,0],["يا مشرق النور يا درع الأمان لنا","هذي أغاريدُنا تسعى على قدم",45,"م",1,0],["يا مشوقا بنعم هذي التراب","لا يغرنك انه كالسراب",46,"ب",1,1],["يا مُشرفاً أشرَفت مكانتُهُ","ومَيّزت قَدرَهُ صيَانَتُه",47,"ت",2,1],["يامشرق الرأي يامن نور حكمته","صبح تألق بالأنوار ينسكب",48,"ب",1,0],["يا مشرفاً فوق طرف الغصن ليتك لو","غربت في القلب كي تقضي بذا وطري",49,"ر",2,0],["يا مشبه الصخر عطفاً","على قلوب حزينه",50,"ن",2,1],["يا مشرقي بالدموع بُلَّ صَدَى","حُشاشة لا يَبِلُّ مُدْنَفُهَا",51,"ف",3,0],["يا مشتري رقّ العلا","دم حائزاً شرفاً وسعدا",52,"د",2,0],["يا مشتري الحمد بأغلى الأثمان","وخير مرجوٍّ لأهل الإيمان",53,"ن",1,1],["يا مشفقاً من خمول قوم","ليس لهم عندنا خلاق",54,"ق",1,1],["يا مشعل الموت في قوم يفاجئهم","وليس يدفعه رأى وتقدير",55,"ر",1,0],["يا مُشرِقاً تَغتَدي للشّمسِ طلعتُهُ","شمساً وتَمطُرُ كفّاهُ على المَطَرِ",56,"ر",1,0],["يا مشفقاً من سقام كنت ألبسه","أنا جنيت على نفسي وأولى لي",57,"ل",2,0],["يا مشتهي آكامِكَ الأَبَديَّةِ ال","فادي يسوعُ المُبتغَى والمشتَهى",58,"ا",1,0],["يا مشبه العمرين المنتدي سَكَناً","بَرّاً وبحراً وفي الأَينَينِ يفتتكُ",59,"ك",1,0],["يا مشيباً جنى عليّ صدوداً","وصدوداً جنى علي مشيبا",60,"ب",2,0],["يا مشفقا وضع الدقائق","لي على طرف التمامه",61,"م",2,0],["يا مشرق الأوصاف يا","علَم الفضائل والهدى",62,"د",2,0],["يا مشتكي من زمان كله كدرٌ","هون عليك فما هذا بمحمودِ",63,"د",1,0],["يا مُشرِقاً مَلأَ العيو","نَ فَلحظُها ما يستقلُّ",64,"ل",1,1],["يا مُشبِه ابن هلالٍ","في خطِّه والسَّداد",65,"د",1,0],["يا مُشرِعًا بابَ عينيْ لِلسُّهادِ، ويا","مُعَكّرًا في سُهادي بِركةَ السَّأمِ",66,"م",1,0],["يامشعل قوم واسمع ما جرالي","حكايه حبّ في عمري عجيبه",67,"ب",2,0],["يا مشبهاً لخفافيْش الدجى سفهاً","هلاّ رأيتك للأنوارٍ معتنقا",68,"ق",2,0],["يا مُشعلَ السّيجارِ أطفئ نارَهُ","وارحم جهازَ تنفّسٍ أوّاها",69,"ا",3,1],["يا مشينا بين أمطار ورعد","نحمل الشنطة 