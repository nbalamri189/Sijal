","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[549,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[551,"وقف العفاة عليك من متحير","https://www.aldiwan.net/poem68288.html","الكامل"],[551,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[551,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[551,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[560,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[565,"بأبي أقيك من الحوادث والردى","https://www.aldiwan.net/poem69492.html","الكامل"],[565,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[565,"روح من الماء في جسم من الصفر","https://www.aldiwan.net/poem69680.html","البسيط"],[567,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[573,"ومخيم بين الحشا وشغافه","https://www.aldiwan.net/poem2911.html","الكامل"],[573,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["وَمُختَلِطِ النَدى أَرِجِ الخُزامى","رَطيبِ ذَوائِبِ الكَلَإِ العَميمِ",0,"م",1,0],["وَمُخَوِّلِ النِعَمِ الجِسا","مِ وَنازِعِ النِعَمِ الجِسامِ",1,"م",1,0],["وَمُختَنِقاً مِن عَبرَةٍ ما تَزولُهُ","وَمُختَبِطاً في لَوعَةٍ ما يَزولُها",2,"ل",3,0],["ومُخْلِسةٌ منْ رَوْعَةِ البَيْنِ لِمّتي","أقَبْلَ الثّلاثينَ اسْتَنارَ مَشيبُها",3,"ب",3,0],["وَمُختَلِسٍ بِالطَرفِ مَا لا يَنالُهُ","قَريباً بِحالِ النازحِ المُتَباعِدِ",4,"د",1,1],["وَمُختَبَطُ الجادي إذا ما تَتابَعَت","عَلى النَاسِ مَثنى قَرَّةٍ وَجُدوبُ",5,"ب",1,0],["وَمُختَنِقٍ راخى اِبنُ عَمروٍ خِناقَهُ","وَغُمَّتَهُ عَن وَجهِهِ فَتَجَلَّتِ",6,"ت",1,0],["وَمَخشِيَّةِ العاثورِ يَرمي بِرَكبِها","إِلى مِثلِهِ خِمسٌ بَعيدٌ مَناهِلُه",7,"ل",2,0],["وَمُختَلَقٌ لِلمُلكِ أَبيَضَ فَدغَمٌ","أَشَمُّ أَبَجُّ العَينِ كَالقَمَرِ البَدرِ",8,"ر",1,0],["ومخضرَةِ الأرجاء في جَنَبَاتها","مسارحُ تحميها الرماحُ الذّوابلُ",9,"ل",1,0],["وَمَخزومٌ هُمُ وَعَدِيُّ كَعبٍ","لِئامُ الناسِ لَيسَ لَهُم دِفاعُ",10,"ع",1,0],["ومخدومة أتبعت مدح نبيها","بخادمة أتبعتها بوليِّها",11,"ه",2,1],["ومُختضِباتٍ من نجيعِ دمائها","إذا جُنِيَتْ من بُكْرَةِ الغَدَوات",12,"ت",1,1],["ومختلفاتٌ بالنمائمِ بيننا","نوابثُ عن أسرارنا وبواحثُ",13,"ث",1,0],["ومُخَالِفٍ أضحى بكم مَغْمُودَةً","أسيافُه مَرْكُوزَةً أرماحُه",14,"ح",2,0],["ومُخَدَّعٍ عند السؤالِ كأنه","غِرٌّ هناك وإنّه لحكيم",15,"م",1,0],["ومخارفٌ نَسَجَ الزَّمانُ بساطَها","مِنْ يابسِ الأَوراقِ والأَكمامِ",16,"م",1,0],["وَمُخَيِّبُ العُذّالِ فيما أَمَّلوا","مِنهُ وَلَيسَ يَرُدُّ كَفّاً خائِبا",17,"ب",2,0],["وَمُختَرَطٍ ماضٍ يُطيعُكَ آمِراً","وَيَعصي إِذا اِستَثنَيتَ لَو كُنتَ ناهِيا",18,"ي",2,0],["وَمُختَشِنٌ لِلهَجاءِ قُلتُ لَهُ","وَخافَ عِندي جَريرَةَ البُخَلِ",19,"ل",1,0],["ومُخطَفِ القَدِّ يُرضِينا ويُسخِطُنا","حُسناً ويَقتُلُنا دَلاً ويُحْيِينَا",20,"ن",2,0],["ومُخطَفٍ شَمَّرَ عن أكمامِه","مُحتَلِمٍ قد سادَ بابنِ عامِه",21,"م",2,0],["ومُختَلَسٌ من حَومَةِ اللَّهوِ لم تَنَلْ","مَقاتِلَه أيدي الحِمامِ المُخالسِ",22,"س",1,0],["ومُخطَفِ الخَصرِ بُرُدُهُ حَبِرٌ","نَحذَرُه وهو خائفٌ حَذِرُ",23,"ر",1,1],["ومُخطَفاتٌ كالعَذارى الحُورِ","مُشمِّراتُ القُمْصِ كالمَنثورِ",24,"ر",1,0],["ومُخْطَفَةِ القَدِّ مُهتزَّةٍ","تباكُرني قبلَ حَيْنِ الصبَّاحِ",25,"ح",1,0],["ومُخطَفٍ يهتزُّ من ماءِ الصِّبا","كأنما يهتزُّ عن ماء العِنَبْ",26,"ب",1,0],["وَمُخَصَّراتٍ زُرنَنا","بَعدَ الهُدّوِّ مِنَ الخُدورِ",27,"ر",1,0],["وَمُخَلَّقِ الخَدَينِ مِن صِبغِ الحَيا","في قُرطُقٍ بِدَمِ القَنيصِ مُخَلَّقِ",28,"ق",1,1],["وَمُخصِبٌ في بَلَدٍ ماحِلٍ","وَعادِلٌ في زَمَنٍ جائِرِ",29,"ر",1,0],["وَمُخَلَّقٍ بِدَمِ الكُماةِ كَأَنَّما","صُبِغَت فَواضِلُ دِرعِهِ مِن خَدِّهِ",30,"د",2,0],["ومخضلّ أوراقِ الصفائح ضُرّجتْ","بكلّ دمٍ أنْدى نباتِ غوائِلِه",31,"ل",2,0],["ومُختَلِف الطَّعمَينِ من طَبعِ عادِلٍ","فطعمٌ له سَمٌّ وطَعْمٌ له شَهْدُ",32,"د",1,0],["وَمَخَطَّ النُؤيِ مَرَّ بِهِ","مَدفَعٌ لِلسَيلِ فَاِنهَدَما",33,"م",2,0],["وَمُخَضَّبٌ رَخصُ البَنانِ كَأَنَّهُ","عَنَمٌ وَمُنتَفِخُ النِطاقِ وَثيرُ",34,"ر",1,0],["وَمخطوطِ السَوادِ كَأَنَّ دَمعاً","جَرى وَدَماً هُناكَ عَلى حِدادِ",35,"د",1,1],["وَمَخيلَةُ المُغتَرِّ يَزعُمُ أَنَّهُ","ثَلَّ العُروشَ بِبَأسِهِ وَحُسامِهِ",36,"م",2,0],["وَمَخفِقِ ذي زِرَّينِ في الأَرضِ مَتنُهُ","وَبِالكَفِّ مَثناهُ لَطيفِ الأَسائِنِ",37,"ن",1,0],["وَمَخافَةٌ لِنَبا المَقا","لَةِ في المَقامَةِ وَالمَحافِل",38,"ل",1,0],["وَمُختَضِبٍ بِحَثّي لِلعُقارِ","سَقَتني كَفُّهُ وَالنِجمُ سارِ",39,"ر",1,1],["وَمِخلَباً بِدَمِها مُلَطَّخا","عَوائِذاً مِن خَطفِهِ وَصُرَّخا",40,"خ",2,0],["وَمَخْبولٌ أتاهُ فثابَ عَقْلٌ","إليه وَلمْ نَخلْهُ له يثُوبُ",41,"ب",1,0],["وَمُختَلِسِ القُلوبِ بِطَرفِ ريمٍ","وَجيدِ مَهاةِ بَرٍّ ذي هِضابِ",42,"ب",1,0],["وَمُخطَفِ الخَصرِ في أَردافِهِ عَمَمٌ","يَميسُ في حُلَّةٍ رَقَّت حَواشيها",43,"ي",3,0],["وَمُخَضَّبٍ رَخصِ البَنا","نِ بَكى عَلَيَّ وَما بَكَيتُه",44,"ت",2,0],["وَمَخرِ الغادِرِ الهَجَرِيِّ أَرضاً","لَهَتكِ أَوانِسٍ كَبَناتِ مَخرِ",45,"ر",1,0],["ومُخرّقٍ عَنْهُ القَمِيصُ تَخالُهُ","وَسْطَ البُيُوتِ منَ الحياءِ سَقِيما",46,"م",2,0],["ومخلق الشباب والمشيب","وملبس البالي على القشيب",47,"ب",1,0],["وَمَخازِنُ العِلمِ المُنَزَّلِ عِندَهُم","بِالوَحيِ وَالقُوّامُ بِالبَرَكاتِ",48,"ت",1,0],["ومخترعٍ يتيه على كِبراً","ولو لم أجرِ لم يجدِ اختِراعا",49,"ع",2,0],["وَمُخْتَشٍ للهِجاءِ قُلْتُ لَهُ،","وَخَافَ عندي جَريرَةَ البُخُلِ",50,"ل",1,0],["ومخلّق بين المجرّة والسّها","صعد الحمام إليه في الطيران",51,"ن",1,0],["ومخأبُنا في السياج العتيق","تدور تدور حكاياتنُا",52,"ن",2,0],["ومخطَّ النؤي، مرّ به","مَدْفَعٌ لِلسَّيْلِ، فَکنْهَدَما",53,"م",2,0],["ومخلدات من نعيم ناعم","لمواله كرماً بها متكرما",54,"م",2,0],["ومخالباً هوجاء تفقأ","عين من أذرى وعاب",55,"ب",1,0],["وَمَخزومٌ أَقَلُّ القَومِ حِلماً","إِذا طاشَت مِن الوَرَهِ الحُلومُ",56,"م",1,0],["ومخاتل يسعى بكل وسيلةٍ","للمال يقنصهُ من الأفرادِ",57,"د",1,0],["وَمُخفي الهِباتِ سُؤدُداً غَيرَ أَنَّها","تَنُمُّ نَميمَ المِسكِ لَمّا تَضَوَّعا",58,"ع",2,0],["وَمَخْطوفَةِ الخَصْرِ لَمَّا بَدَتْ","لدى الليْلِ عايَنْتُ سَهْماً يُضِي",59,"ي",1,1],["وَمِخيَطٍ حارَ فيهِ وَصفي","وَضاقَ عَن شَرحِهِ بَياني",60,"ي",1,1],["ومختِلس الوصال بغير وعدٍ","لصَبٍّ بعدَ صَدٍّ واجْتناب",61,"ب",1,0],["ومخلاهُ القنابر للزكوري","وصار لك التهلّل والسماعُ",62,"ع",1,0],["ومخاطب من قد أكبّ عل","ى التقلّل صبر صابر",63,"ر",1,0],["ومخبِّر البلقاء أنَّ خطيبها","ظَفِرتْ يدي من سجعه بخطاب",64,"ب",1,0],["ومخلبٍ ضخم وقلب قاسِ","ومقلة تلمع كالمِقباسِ",65,"س",1,0],["وَمخايلا من والدٍ","فوق النجوم الشُهبِ قَدرا",66,"ر",2,0],["وَمُخطَفٍ لَوني إِذا","رَأَيتُهُ يَنخَطِفُ",67,"ف",1,0],["وَمُخَوَّلٍ وَمُمَوَّلٍ وَمُنَوَّلٍ","غَمْرِ النَّدَى هَطِلِ النَّوَالِ أَجَشِّهِ",68,"ش",2,0],["ومختار ديوان الملوك الّذي به","غدت بلدة السطان أعذب مورد",69,"د",1,0],["وَمُخَزَّمٍ ناجَتْ ضَمائِرُهُ الْمُنى","طَمَعاً بِقَطْعِ سُهُولِهِ وَحُزُونِهِ",70,"ن",2,0],["وَمُخالِفٍ هَوى النَفسِ الَّتي لَيسَ قَصدَها","سِوى الجَمعِ لِلدارِ الَّتي حَشوُها المِحَنِ",71,"ن",1,0],["وَمُخَلد الفجار في نيرانِهِ","وَجِوار إِبليس اللعين الخاسر",72,"ر",1,0],["وَمُختَبِطينَ مِن بَلَدٍ بَعيدٍ","عَبَأتَ لَهُم سِجالَكَ حينَ جاءوا",73,"ا",1,0],["ومختلف الأصواتِ مؤتلفِ الزحف","لهوم الفلا عبل القنابل ملتف",74,"ف",1,1],["وَمُخيِّمون معَ القطيعة إن دَنوا","هَجَروا وإن راحوا إلينا هَجَّروا",75,"ر",3,0],["ومخائلاً موقوقةً وفضائلاً","ملأتْ قلوبَ الحاسدِين وجيبا",76,"ب",2,0],["وَمُخاصِمٌ فَإِذا اِقتَضَي","نا فَالقُضاةُ هِيَ العَواقِب",77,"ب",1,0],["وَمُخيفي أَنَّهُ يَسهَرُ لي","موقِظاً فِيَّ عُيوناً لِلحِيَل",78,"ل",1,0],["ومُخالفٍ بينَ الجَوارِحِ خائِفٍ","من قائِمٍ بظلامَتي نَهاضِ",79,"ض",1,0],["ومخائلٌ مَيمونَةٌ وسعادةٌ","مقرونةٌ بعزائمٍ لا تفترُ",80,"ر",1,0],["ومختاري يخالفه لأني","عرفت الحق فيه فلا أحابي",81,"ب",2,0],["ومُخمَلَةٍ بِاللَّحمِ مِن دُونِ ثَوبِه","تَطُولُ القِصَارَ وَالطِّوَالُ تَطُولُها",82,"ل",3,0],["ومخلّد الذكر الجميل إلى مدىً","يبقى وما في العالمين مخلَّد",83,"د",1,0],["ومُختارِ يمناكَ العَلِيَّةِ نِسْبَةً","وإِنْ سَفَرَتْ يَرْبُوعُ عنها ودارِمُ",84,"م",1,0],["ومخرج الدر من لجي معرفة","شماء يجثو لديها جالب الزبد",85,"د",1,0],["ومُخلصا مثلي الذي يا طالما","أَسدى من الموتى ومن وَسواسِه",86,"س",2,0],["ومختلِفِ الودّ خاللتُه","فكان هواه عدواً مطاعا",87,"ع",2,0],["ومخطوبةٍ بالكُتب والرُّسْل مهرُها","غرائبُ أبكار الكلام البدائعُ",88,"ع",1,0],["ومخضوبة الأطرافِ لم تُصبِ عاشقاً","عميداً وكم أودَى بهنّ عميدُ",89,"د",1,0],["ومختارُ الاِمامة وهي أهْدى","لما يرضى بخيرتهِ العَلاءُ",90,"ا",2,0],["ومخضرّةِ الأقطارِ مخضلّةِ الثرى","صبحتُ إليها البرقَ قاني الذّوائب",91,"ب",1,0],["ومخطف القدّ معسول مقبلهُ","ودّي لعينيهِ مغسولٌ من الدنس",92,"س",1,1],["وَمُخَلَّلاتٍ تَنتَشي","في كُلِّ شافِ الحِجابِ",93,"ب",1,0],["ومختلف الطعمين عدلاً بنفسه","على قدر السجلين بالحلو والمر",94,"ر",1,0],["ومخترعاً فيكم عيون قصائد","هي العنبر الشحري أو نفثة الشحر",95,"ر",1,0],["وُمخفقٍ كأنّه","من طمعٍ لم يُخفقِ",96,"ق",1,0],["ومخضّب الأطراف ماطَلَنِي","بوصالهِ عَصْراً إلى عَصْرِ",97,"ر",1,0],["ومُخالَسٌ ما كان يُحذر هُلْكُه","ومتارَكٌ ومُقدّمٌ ومؤخّرُ",98,"ر",1,0],["وَمُختَلطاً فيه الذّوائبُ كالشَّوى","وحُرُّهُمُ مِن لبسةِ الذُلِّ كالعبدِ",99,"د",1,0],["وَمُخضّبِ الأطرافِ صَدّ بِوجههِ","لَمّا رَأى شَيبِي مكانَ سوادي",100,"ي",1,0],["وَمُخادِعُ السَمعِ النَعيَّ وَدونَهُ","خَطبٌ أَلَمَّ بِصادِقٍ لا يَخدَعُ",101,"ع",1,0],["وَمُختَلَسٍ مِن شَهرِهِ بِنَعيمِهِ","عَلى غَفلَةٍ مِن شانِئٍ لَيسَ يَغفُلَ",102,"ل",1,0],["وَمُخطَفِ الخَصرِ في أَردافِهِ عَمَمٌ","يَميسُ في خامَةٍ رَقَّت حَواشيها",103,"ي",3,0],["وَمُخَدَّراتٍ ناعِماتٍ خُرَّدٍ","مِثلِ الدُمى حورِ العُيونِ كَواعِبِ",104,"ب",1,0],["ومخطوبة الأرواح ألقت لثامها","عن الوجه منها وهو بالنور ساطع",105,"ع",1,0],["ومُخبرٍ قبلَ أن تَمَّتْ عبارَتُهُ","بكلْمةٍ قد جَرَى عن مَوْتِهِ الخَبَرُ",106,"ر",1,0],["وَمُخَفَّف الأَجْزَاءِ لَيْسَ لِجِرْمِهِ","وَزْنٌ يُمِيْلُ كِفَّةَ المِيْزَانِ",107,"ن",1,0],["وَمَخَالِبٍ مِثْلِ الأَهِلَّةِ طَالَمَا","أَدْمَيْنَ كَفَّ الْبَازِيَارِ الْحَاذِقِ",108,"ق",1,0],["ومُخْرِجٌ لك بالأَجْزَاءِ ألْطَفَهَا","من النهارِ وقَوْسِ الليل في السَّحَرِ",109,"ر",1,0],["وَمخاصم قاومت في كبدٍ","مثل الدهان فكانَ لي العذرُ",110,"ر",1,0],["ومُخَيِّمٌ بين الحَشَا وشَغَافِهِ","نضَبَتْ بِحارُ الشِّعْرِ في أَوْصَافِهِ",111,"ف",2,1],["ومُخْجِل الشَّمس بالملاحة قد","أَلبس خدَّيَّ خجلةَ الواثق",112,"ق",1,0]]}