لطويل"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127933","الوافر"],[4422,"","https://poetry.dctabudhabi.ae/diwan/poem/116633","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83181","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76745","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104869","الوافر"],[4830,"حيثما شاءَ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214573",""],[4578,"زناد نوى الأحباب في القلب يقدحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49376",""],[4851,"ومختطف للعين بت أشيمه","https://www.poetsgate.com/ViewPoem.aspx?id=182364",""],[4891,"ومخاضة يلقى الردى من خاضها","https://www.poetsgate.com/ViewPoem.aspx?id=181110",""],[5010,"محرتُ أمواج الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190464",""],[4119,"إني لأغنى الناس عن عصبية","https://www.poetsgate.com/ViewPoem.aspx?id=16088",""],[5064,"سيرة غير منشُورة","https://www.poetsgate.com/ViewPoem.aspx?id=199145",""],[5135,"أبركِ اللحظات","https://www.poetsgate.com/ViewPoem.aspx?id=201994",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[5212,"شبيه موسى","https://www.poetsgate.com/ViewPoem.aspx?id=212105",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5351,"على درب الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=202234",""],[5461,"يا سيدي عاش راسك","https://www.poetsgate.com/ViewPoem.aspx?id=5234",""],[470,"يا صبر أيوب","https://www.poetsgate.com/ViewPoem.aspx?id=19912",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5725,"اما تستحي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=207331",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[4035,"في صباه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1524&r=&rc=7",""],[6277,"قالوا أناب !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64448&r=&rc=11",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""],[572,"روحٌ من الماءِ في جِسْمٍ مِنَ الصفَرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9301&r=&rc=158",""]],"verses":[["وَمُختَلِطِ النَدى أَرِجِ الخُزامى","رَطيبِ ذَوائِبِ الكَلَإِ العَميمِ",0,"م",1,0],["وَمُخَوِّلِ النِعَمِ الجِسا","مِ وَنازِعِ النِعَمِ الجِسامِ",1,"م",1,0],["وَمُختَنِقاً مِن عَبرَةٍ ما تَزولُهُ","وَمُختَبِطاً في لَوعَةٍ ما يَزولُها",2,"ل",3,0],["ومُخْلِسةٌ منْ رَوْعَةِ البَيْنِ لِمّتي","أقَبْلَ الثّلاثينَ اسْتَنارَ مَشيبُها",3,"ب",3,0],["ومخازيهم تراث خالد","ورثوه كابرا عن كابر",4,"ر",1,0],["وَمُختَلِسٍ بِالطَرفِ مَا لا يَنالُهُ","قَريباً بِحالِ النازحِ المُتَباعِدِ",5,"د",1,1],["وَمُختَبَطُ الجادي إذا ما تَتابَعَت","عَلى النَاسِ مَثنى قَرَّةٍ وَجُدوبُ",6,"ب",1,0],["وَمُختَنِقٍ راخى اِبنُ عَمروٍ خِناقَهُ","وَغُمَّتَهُ عَن وَجهِهِ فَتَجَلَّتِ",7,"ت",1,0],["وَمَخشِيَّةِ العاثورِ يَرمي بِرَكبِها","إِلى مِثلِهِ خِمسٌ بَعيدٌ مَناهِلُه",8,"ل",2,0],["وَمُختَلَقٌ لِلمُلكِ أَبيَضَ فَدغَمٌ","أَشَمُّ أَبَجُّ العَينِ كَالقَمَرِ البَدرِ",9,"ر",1,0],["ومخضرَةِ الأرجاء في جَنَبَاتها","مسارحُ تحميها الرماحُ الذّوابلُ",10,"ل",1,0],["وَمَخزومٌ هُمُ وَعَدِيُّ كَعبٍ","لِئامُ الناسِ لَيسَ لَهُم دِفاعُ",11,"ع",1,0],["ومخدومة أتبعت مدح نبيها","بخادمة أتبعتها بوليِّها",12,"ه",2,1],["ومُختضِباتٍ من نجيعِ دمائها","إذا جُنِيَتْ من بُكْرَةِ الغَدَوات",13,"ت",1,1],["ومختلفاتٌ بالنمائمِ بيننا","نوابثُ عن أسرارنا وبواحثُ",14,"ث",1,0],["ومُخَالِفٍ أضحى بكم مَغْمُودَةً","أسيافُه مَرْكُوزَةً أرماحُه",15,"ح",2,0],["ومُخَدَّعٍ عند السؤالِ كأنه","غِرٌّ هناك وإنّه لحكيم",16,"م",1,0],["ومخارفٌ نَسَجَ الزَّمانُ بساطَها","مِنْ يابسِ الأَوراقِ والأَكمامِ",17,"م",1,0],["وَمُخَيِّبُ العُذّالِ فيما أَمَّلوا","مِنهُ وَلَيسَ يَرُدُّ كَفّاً خائِبا",18,"ب",2,0],["وَمُختَرَطٍ ماضٍ يُطيعُكَ آمِراً","وَيَعصي إِذا اِستَثنَيتَ لَو كُنتَ ناهِيا",19,"ي",2,0],["وَمُختَشِنٌ لِلهَجاءِ قُلتُ لَهُ","وَخافَ عِندي جَريرَةَ البُخَلِ",20,"ل",1,0],["ومُخطَفِ القَدِّ يُرضِينا ويُسخِطُنا","حُسناً ويَقتُلُنا دَلاً ويُحْيِينَا",21,"ن",2,0],["ومُخطَفٍ شَمَّرَ عن أكمامِه","مُحتَلِمٍ قد سادَ بابنِ عامِه",22,"م",2,0],["ومُختَلَسٌ من حَومَةِ اللَّهوِ لم تَنَلْ","مَقاتِلَه أيدي الحِمامِ المُخالسِ",23,"س",1,0],["ومُخطَفِ الخَصرِ بُرُدُهُ حَبِرٌ","نَحذَرُه وهو خائفٌ حَذِرُ",24,"ر",1,1],["ومُخطَفاتٌ كالعَذارى الحُورِ","مُشمِّراتُ القُمْصِ كالمَنثورِ",25,"ر",1,0],["ومُخْطَفَةِ القَدِّ مُهتزَّةٍ","تباكُرني قبلَ حَيْنِ الصبَّاحِ",26,"ح",1,0],["ومُخطَفٍ يهتزُّ من ماءِ الصِّبا","كأنما يهتزُّ عن ماء العِنَبْ",27,"ب",1,0],["وَمُخَصَّراتٍ زُرنَنا","بَعدَ الهُدّوِّ مِنَ الخُدورِ",28,"ر",1,0],["وَمُخَلَّقِ الخَدَينِ مِن صِبغِ الحَيا","في قُرطُقٍ بِدَمِ القَنيصِ مُخَلَّقِ",29,"ق",1,1],["وَمُخصِبٌ في بَلَدٍ ماحِلٍ","وَعادِلٌ في زَمَنٍ جائِرِ",30,"ر",1,0],["وَمُخَلَّقٍ بِدَمِ الكُماةِ كَأَنَّما","صُبِغَت فَواضِلُ دِرعِهِ مِن خَدِّهِ",31,"د",2,0],["ومخضلّ أوراقِ الصفائح ضُرّجتْ","بكلّ دمٍ أنْدى نباتِ غوائِلِه",32,"ل",2,0],["ومُختَلِف الطَّعمَينِ من طَبعِ عادِلٍ","فطعمٌ له سَمٌّ وطَعْمٌ له شَهْدُ",33,"د",1,0],["وَمَخَطَّ النُؤيِ مَرَّ بِهِ","مَدفَعٌ لِلسَيلِ فَاِنهَدَما",34,"م",2,0],["وَمُخَضَّبٌ رَخصُ البَنانِ كَأَنَّهُ","عَنَمٌ وَمُنتَفِخُ النِطاقِ وَثيرُ",35,"ر",1,0],["وَمخطوطِ السَوادِ كَأَنَّ دَمعاً","جَرى وَدَماً هُناكَ عَلى حِدادِ",36,"د",1,1],["وَمَخيلَةُ المُغتَرِّ يَزعُمُ أَنَّهُ","ثَلَّ العُروشَ بِبَأسِهِ وَحُسامِهِ",37,"م",2,0],["وَمَخفِقِ ذي زِرَّينِ في الأَرضِ مَتنُهُ","وَبِالكَفِّ مَثناهُ لَطيفِ الأَسائِنِ",38,"ن",1,0],["وَمَخافَةٌ لِنَبا المَقا","لَةِ في المَقامَةِ وَالمَحافِل",39,"ل",1,0],["وَمُختَضِبٍ بِحَثّي لِلعُقارِ","سَقَتني كَفُّهُ وَالنِجمُ سارِ",40,"ر",1,1],["وَمِخلَباً بِدَمِها مُلَطَّخا","عَوائِذاً مِن خَطفِهِ وَصُرَّخا",41,"خ",2,0],["وَمَخْبولٌ أتاهُ فثابَ عَقْلٌ","إليه وَلمْ نَخلْهُ له يثُوبُ",42,"ب",1,0],["وَمُختَلِسِ القُلوبِ بِطَرفِ ريمٍ","وَجيدِ مَهاةِ بَرٍّ ذي هِضابِ",43,"ب",1,0],["وَمُخطَفِ الخَصرِ في أَردافِهِ عَمَمٌ","يَميسُ في حُلَّةٍ رَقَّت حَواشيها",44,"ي",3,0],["وَمُخَضَّبٍ رَخصِ البَنا","نِ بَكى عَلَيَّ وَما بَكَيتُه",45,"ت",2,0],["وَمَخرِ الغادِرِ الهَجَرِيِّ أَرضاً","لَهَتكِ أَوانِسٍ كَبَناتِ مَخرِ",46,"ر",1,0],["ومُخْلَصَةً بِيضاً كَأَنَّ مُتُونَهَا","مَدَبُّ دَباً طِفْلٍ تَبَطَّنَ جَدْجَدَا",47,"د",2,0],["ومُخرّقٍ عَنْهُ القَمِيصُ تَخالُهُ","وَسْطَ البُيُوتِ منَ الحياءِ سَقِيما",48,"م",2,0],["ومخلق الشباب والمشيب","وملبس البالي على القشيب",49,"ب",1,0],["وَمَخازِنُ العِلمِ المُنَزَّلِ عِندَهُم","بِالوَحيِ وَالقُوّامُ بِالبَرَكاتِ",50,"ت",1,0],["ومخترعٍ يتيه على كِبراً","ولو لم أجرِ لم يجدِ اختِراعا",51,"ع",2,0],["وَمُخْتَشٍ للهِجاءِ قُلْتُ لَهُ،","وَخَافَ عندي جَريرَةَ البُخُلِ",52,"ل",1,0],["ومخلّق بين المجرّة والسّها","صعد الحمام إليه في الطيران",53,"ن",1,0],["ومخأبُنا في السياج العتيق","تدور تدور حكاياتنُا",54,"ن",2,0],["ومخطَّ النؤي، مرّ به","مَدْفَعٌ لِلسَّيْلِ، فَکنْهَدَما",55,"م",2,0],["ومخلدات من نعيم ناعم","لمواله كرماً بها متكرما",56,"م",2,0],["ومخالباً هوجاء تفقأ","عين من أذرى وعاب",57,"ب",1,0],["وَمَخزومٌ أَقَلُّ القَومِ حِلماً","إِذا طاشَت مِن الوَرَهِ الحُلومُ",58,"م",1,0],["ومخاتل يسعى بكل وسيلةٍ","للمال يقنصهُ من الأفرادِ",59,"د",1,0],["وَمُخفي الهِباتِ سُؤدُداً غَيرَ أَنَّها","تَنُمُّ نَميمَ المِسكِ لَمّا تَضَوَّعا",60,"ع",2,0],["وَمَخْطوفَةِ الخَصْرِ لَمَّا بَدَتْ","لدى الليْلِ عايَنْتُ سَهْماً يُضِي",61,"ض",2,1],["وَمِخيَطٍ حارَ فيهِ وَصفي","وَضاقَ عَن شَرحِهِ بَياني",62,"ي",1,1],["ومختِلس الوصال بغير وعدٍ","لصَبٍّ بعدَ صَدٍّ واجْتناب",63,"ب",1,0],["ومخلاهُ القنابر للزكوري","وصار لك التهلّل والسماعُ",64,"ع",1,0],["ومخاطب من قد أكبّ عل","ى التقلّل صبر صابر",65,"ر",1,0],["ومخبِّر البلقاء أنَّ خطيبها","ظَفِرتْ يدي من سجعه بخطاب",66,"ب",1,0],["ومخلبٍ ضخم وقلب قاسِ","ومقلة تلمع كالمِقباسِ",67,"س",1,0],["وَمخايلا من والدٍ","فوق النجوم الشُهبِ قَدرا",68,"ر",2,0],["وَمُخطَفٍ لَوني إِذا","رَأَيتُهُ يَنخَطِفُ",69,"ف",1,0],["وَمُخَوَّلٍ وَمُمَوَّلٍ وَمُنَوَّلٍ","غَمْرِ النَّدَى هَطِلِ النَّوَالِ أَجَشِّهِ",70,"ش",2,0],["ومختار ديوان الملوك الّذي به","غدت بلدة السطان أعذب مورد",71,"د",1,0],["وَمُخَزَّمٍ ناجَتْ ضَمائِرُهُ الْمُنى","طَمَعاً بِقَطْعِ سُهُولِهِ وَحُزُونِهِ",72,"ن",2,0],["وَمُخالِفٍ هَوى النَفسِ الَّتي لَيسَ قَصدَها","سِوى الجَمعِ لِلدارِ الَّتي حَشوُها المِحَنِ",73,"ن",1,0],["وَمُخَلد الفجار في نيرانِهِ","وَجِوار إِبليس اللعين الخاسر",74,"ر",1,0],["وَمُختَبِطينَ مِن بَلَدٍ بَعيدٍ","عَبَأتَ لَهُم سِجالَكَ حينَ جاءوا",75,"ا",1,0],["ومختلف الأصواتِ مؤتلفِ الزحف","لهوم الفلا عبل القنابل ملتف",76,"ف",1,1],["وَمُخيِّمون معَ القطيعة إن دَنوا","هَجَروا وإن راحوا إلينا هَجَّروا",77,"ر",3,0],["ومخائلاً موقوقةً وفضائلاً","ملأتْ قلوبَ الحاسدِين وجيبا",78,"ب",2,0],["وَمُخاصِمٌ فَإِذا اِقتَضَي","نا فَالقُضاةُ هِيَ العَواقِب",79,"ب",1,0],["وَمُخيفي أَنَّهُ يَسهَرُ لي","موقِظاً فِيَّ عُيوناً لِلحِيَل",80,"ل",1,0],["ومُخالفٍ بينَ الجَوارِحِ خائِفٍ","من قائِمٍ بظلامَتي نَهاضِ",81,"ض",1,0],["ومخائلٌ مَيمونَةٌ وسعادةٌ","مقرونةٌ بعزائمٍ لا تفترُ",82,"ر",1,0],["ومختاري يخالفه لأني","عرفت الحق فيه فلا أحابي",83,"ب",2,0],["ومُخمَلَةٍ بِاللَّحمِ مِن دُونِ ثَوبِه","تَطُولُ القِصَارَ وَالطِّوَالُ تَطُولُها",84,"ل",3,0],["ومخلّد الذكر الجميل إلى مدىً","يبقى وما في العالمين مخلَّد",85,"د",1,0],["ومُختارِ يمناكَ العَلِيَّةِ نِسْبَةً","وإِنْ سَفَرَتْ يَرْبُوعُ عنها ودارِمُ",86,"م",1,0],["ومخرج الدر من لجي معرفة","شماء يجثو لديها جالب الزبد",87,"د",1,0],["ومُخلصا مثلي الذي يا طالما","أَسدى من الموتى ومن وَسواسِه",88,"س",2,0],["ومختلِفِ الودّ خاللتُه","فكان هواه عدواً مطاعا",89,"ع",2,0],["ومخطوبةٍ بالكُتب والرُّسْل مهرُها","غرائبُ أبكار الكلام البدائعُ",90,"ع",1,0],["ومخضوبة الأطرافِ لم تُصبِ عاشقاً","عميداً وكم أودَى بهنّ عميدُ",91,"د"