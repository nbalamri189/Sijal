{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[53,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[55,"ومختلس بالطرف ما لا يناله","https://www.aldiwan.net/poem26401.html","الطويل"],[35,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[10,"لهفي على صخر فإني أرى له","https://www.aldiwan.net/poem21062.html","الطويل"],[30,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[23,"فلا والله ما تدري معيص","https://www.aldiwan.net/poem21324.html","الوافر"],[72,"ومخدومة أتبعت مدح نبيها","https://www.aldiwan.net/poem20576.html","الطويل"],[51,"ومختضبات من نجيع دمائها","https://www.aldiwan.net/poem9210.html","الطويل"],[51,"لها ناظر بالسحر في القلب نافث","https://www.aldiwan.net/poem9234.html","الطويل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[43,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[45,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[61,"نطوي الليالي علما أن ستطوينا","https://www.aldiwan.net/poem51410.html","البسيط"],[61,"قد أغتدي والصبح في إقدامه","https://www.aldiwan.net/poem51434.html","الرجز"],[61,"عفاء على اللذات من بعد فارس","https://www.aldiwan.net/poem51595.html","الطويل"],[61,"ومخطف الخصر برده حبر","https://www.aldiwan.net/poem51617.html","المنسرح"],[61,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[61,"على الرغم بدلت من رغم لاحي","https://www.aldiwan.net/poem51742.html","المتقارب"],[61,"عوجا على ذاك الكثيب من كثب","https://www.aldiwan.net/poem51787.html","الرجز"],[49,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[66,"ومخلق الخدين من صبغ الحيا","https://www.aldiwan.net/poem39520.html","الكامل"],[66,"ما دام جري الفلك الدائر","https://www.aldiwan.net/poem40135.html","السريع"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[31,"رث حبل الوصل وانصرما","https://www.aldiwan.net/poem41318.html","المديد"],[31,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem42539.html","الكامل"],[74,"ومخطوط السواد كأن دمعا","https://www.aldiwan.net/poem12889.html","الوافر"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"ومختضب بحثي للعقار","https://www.aldiwan.net/poem26998.html","الوافر"],[52,"تخالهم أسوار جيش أبلخا","https://www.aldiwan.net/poem27136.html","الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"ومقرور مزجت له شمولا","https://www.aldiwan.net/poem10777.html","الوافر"],[48,"دعني من الدار أبكيها وأرثيها","https://www.aldiwan.net/poem66175.html","البسيط"],[50,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[46,"ألما تعجبي من غير سخر","https://www.aldiwan.net/poem22683.html","الوافر"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72239","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10238","الكامل"],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[45,"إنّكَ والاحتِفالَ في عَذَلي","https://www.poetsgate.com/ViewPoem.aspx?id=31802",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[99,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[31,"رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19085&r=&rc=347",""]],"verses":[["وَمُختَلِطِ النَدى أَرِجِ الخُزامى","رَطيبِ ذَوائِبِ الكَلَإِ العَميمِ",0,"م",1,0],["وَمُخَوِّلِ النِعَمِ الجِسا","مِ وَنازِعِ النِعَمِ الجِسامِ",1,"م",1,0],["وَمُختَنِقاً مِن عَبرَةٍ ما تَزولُهُ","وَمُختَبِطاً في لَوعَةٍ ما يَزولُها",2,"ل",3,0],["ومُخْلِسةٌ منْ رَوْعَةِ البَيْنِ لِمّتي","أقَبْلَ الثّلاثينَ اسْتَنارَ مَشيبُها",3,"ب",3,0],["وَمُختَلِسٍ بِالطَرفِ مَا لا يَنالُهُ","قَريباً بِحالِ النازحِ المُتَباعِدِ",4,"د",1,1],["وَمُختَبَطُ الجادي إذا ما تَتابَعَت","عَلى النَاسِ مَثنى قَرَّةٍ وَجُدوبُ",5,"ب",1,0],["وَمُختَنِقٍ راخى اِبنُ عَمروٍ خِناقَهُ","وَغُمَّتَهُ عَن وَجهِهِ فَتَجَلَّتِ",6,"ت",1,0],["وَمَخشِيَّةِ العاثورِ يَرمي بِرَكبِها","إِلى مِثلِهِ خِمسٌ بَعيدٌ مَناهِلُه",7,"ل",2,0],["وَمُختَلَقٌ لِلمُلكِ أَبيَضَ فَدغَمٌ","أَشَمُّ أَبَجُّ العَينِ كَالقَمَرِ البَدرِ",8,"ر",1,0],["ومخضرَةِ الأرجاء في جَنَبَاتها","مسارحُ تحميها الرماحُ الذّوابلُ",9,"ل",1,0],["وَمَخزومٌ هُمُ وَعَدِيُّ كَعبٍ","لِئامُ الناسِ لَيسَ لَهُم دِفاعُ",10,"ع",1,0],["ومخدومة أتبعت مدح نبيها","بخادمة أتبعتها بوليِّها",11,"ه",2,1],["ومُختضِباتٍ من نجيعِ دمائها","إذا جُنِيَتْ من بُكْرَةِ الغَدَوات",12,"ت",1,1],["ومختلفاتٌ بالنمائمِ بيننا","نوابثُ عن أسرارنا وبواحثُ",13,"ث",1,0],["ومُخَالِفٍ أضحى بكم مَغْمُودَةً","أسيافُه مَرْكُوزَةً أرماحُه",14,"ح",2,0],["ومُخَدَّعٍ عند السؤالِ كأنه","غِرٌّ هناك وإنّه لحكيم",15,"م",1,0],["ومخارفٌ نَسَجَ الزَّمانُ بساطَها","مِنْ يابسِ الأَوراقِ والأَكمامِ",16,"م",1,0],["وَمُخَيِّبُ العُذّالِ فيما أَمَّلوا","مِنهُ وَلَيسَ يَرُدُّ كَفّاً خائِبا",17,"ب",2,0],["وَمُختَرَطٍ ماضٍ يُطيعُكَ آمِراً","وَيَعصي إِذا اِستَثنَيتَ لَو كُنتَ ناهِيا",18,"ي",2,0],["وَمُختَشِنٌ لِلهَجاءِ قُلتُ لَهُ","وَخافَ عِندي جَريرَةَ البُخَلِ",19,"ل",1,0],["ومُخطَفِ القَدِّ يُرضِينا ويُسخِطُنا","حُسناً ويَقتُلُنا دَلاً ويُحْيِينَا",20,"ن",2,0],["ومُخطَفٍ شَمَّرَ عن أكمامِه","مُحتَلِمٍ قد سادَ بابنِ عامِه",21,"م",2,0],["ومُختَلَسٌ من حَومَةِ اللَّهوِ لم تَنَلْ","مَقاتِلَه أيدي الحِمامِ المُخالسِ",22,"س",1,0],["ومُخطَفِ الخَصرِ بُرُدُهُ حَبِرٌ","نَحذَرُه وهو خائفٌ حَذِرُ",23,"ر",1,1],["ومُخطَفاتٌ كالعَذارى الحُورِ","مُشمِّراتُ القُمْصِ كالمَنثورِ",24,"ر",1,0],["ومُخْطَفَةِ القَدِّ مُهتزَّةٍ","تباكُرني قبلَ حَيْنِ الصبَّاحِ",25,"ح",1,0],["ومُخطَفٍ يهتزُّ من ماءِ الصِّبا","كأنما يهتزُّ عن ماء العِنَبْ",26,"ب",1,0],["وَمُخَصَّراتٍ زُرنَنا","بَعدَ الهُدّوِّ مِنَ الخُدورِ",27,"ر",1,0],["وَمُخَلَّقِ الخَدَينِ مِن صِبغِ الحَيا","في قُرطُقٍ بِدَمِ القَنيصِ مُخَلَّقِ",28,"ق",1,1],["وَمُخصِبٌ في بَلَدٍ ماحِلٍ","وَعادِلٌ في زَمَنٍ جائِرِ",29,"ر",1,0],["وَمُخَلَّقٍ بِدَمِ الكُماةِ كَأَنَّما","صُبِغَت فَواضِلُ دِرعِهِ مِن خَدِّهِ",30,"د",2,0],["ومخضلّ أوراقِ الصفائح ضُرّجتْ","بكلّ دمٍ أنْدى نباتِ غوائِلِه",31,"ل",2,0],["ومُختَلِف الطَّعمَينِ من طَبعِ عادِلٍ","فطعمٌ له سَمٌّ وطَعْمٌ له شَهْدُ",32,"د",1,0],["وَمَخَطَّ النُؤيِ مَرَّ بِهِ","مَدفَعٌ لِلسَيلِ فَاِنهَدَما",33,"م",2,0],["وَمُخَضَّبٌ رَخصُ البَنانِ كَأَنَّهُ","عَنَمٌ وَمُنتَفِخُ النِطاقِ وَثيرُ",34,"ر",1,0],["وَمخطوطِ السَوادِ كَأَنَّ دَمعاً","جَرى وَدَماً هُناكَ عَلى حِدادِ",35,"د",1,1],["وَمَخيلَةُ المُغتَرِّ يَزعُمُ أَنَّهُ","ثَلَّ العُروشَ بِبَأسِهِ وَحُسامِهِ",36,"م",2,0],["وَمَخفِقِ ذي زِرَّينِ في الأَرضِ مَتنُهُ","وَبِالكَفِّ مَثناهُ لَطيفِ الأَسائِنِ",37,"ن",1,0],["وَمَخافَةٌ لِنَبا المَقا","لَةِ في المَقامَةِ وَالمَحافِل",38,"ل",1,0],["وَمُختَضِبٍ بِحَثّي لِلعُقارِ","سَقَتني كَفُّهُ وَالنِجمُ سارِ",39,"ر",1,1],["وَمِخلَباً بِدَمِها مُلَطَّخا","عَوائِذاً مِن خَطفِهِ وَصُرَّخا",40,"خ",2,0],["وَمَخْبولٌ أتاهُ فثابَ عَقْلٌ","إليه وَلمْ نَخلْهُ له يثُوبُ",41,"ب",1,0],["وَمُختَلِسِ القُلوبِ بِطَرفِ ريمٍ","وَجيدِ مَهاةِ بَرٍّ ذي هِضابِ",42,"ب",1,0],["وَمُخطَفِ الخَصرِ في أَردافِهِ عَمَمٌ","يَميسُ في حُلَّةٍ رَقَّت حَواشيها",43,"ي",3,0],["وَمُخَضَّبٍ رَخصِ البَنا","نِ بَكى عَلَيَّ وَما بَكَيتُه",44,"ت",2,0],["وَمَخرِ الغادِرِ الهَجَرِيِّ أَرضاً","لَهَتكِ أَوانِسٍ كَبَناتِ مَخرِ",45,"ر",1,0],["ومُخرّقٍ عَنْهُ القَمِيصُ تَخالُهُ","وَسْطَ البُيُوتِ منَ الحياءِ سَقِيما",46,"م",2,0],["ومخلق الشباب والمشيب","وملبس البالي على القشيب",47,"ب",1,0],["وَمَخازِنُ العِلمِ المُنَزَّلِ عِندَهُم","بِالوَحيِ وَالقُوّامُ بِالبَرَكاتِ",48,"ت",1,0],["ومخترعٍ يتيه على كِبراً","ولو لم أجرِ لم يجدِ اختِراعا",49,"ع",2,0],["وَمُخْتَشٍ للهِجاءِ قُلْتُ لَهُ،","وَخَافَ عندي جَريرَةَ البُخُلِ",50,"ل",1,0],["ومخلّق بين المجرّة والسّها","صعد الحمام إليه في الطيران",51,"ن",1,0],["ومخأبُنا في السياج العتيق","تدور تدور حكاياتنُا",52,"ن",2,0],["ومخطَّ النؤي، مرّ به","مَدْفَعٌ لِلسَّيْلِ، فَکنْهَدَما",53,"م",2,0]]}