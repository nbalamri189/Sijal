{"poems":[[53,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[53,"رب فتاة حرة المقلد","https://www.aldiwan.net/poem61887.html","الرجز"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[68,"لا يظنن معشري أن بعدي","https://www.aldiwan.net/poem41574.html","الخفيف"],[71,"رب فلاح مليح","https://www.aldiwan.net/poem28281.html","مجزوء الرمل"],[107,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[50,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[50,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem66265.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[119,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[264,"سبق الحكم قبل في تكوينك","https://www.aldiwan.net/poem35822.html","الخفيف"],[309,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[309,"نسمات الحي وهنا إذ سرت","https://www.aldiwan.net/poem16846.html","الرمل"],[325,"ها هو الدمع في المحاجر سائل","https://www.aldiwan.net/poem61620.html","الكامل"],[325,"طاب حظ بدا بعود الدريني","https://www.aldiwan.net/poem67173.html","الخفيف"],[333,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[358,"رب فتى ناولته شيشة","https://www.aldiwan.net/poem39610.html","الطويل"],[435,"لاح للأفراح بدر","https://www.aldiwan.net/poem40994.html","مجزوء الرمل"],[543,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[563,"رب فوارة خلال مروج","https://www.aldiwan.net/poem34233.html","الخفيف"],[567,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[572,"لصديق لنا صديقة سوء","https://www.aldiwan.net/poem69465.html","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39221","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38321","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38909","الخفيف"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131931",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136205","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136129","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136318","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136198","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136367","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136332","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56712","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112776","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95540","الرمل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26654","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111847","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110334","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34735","الخفيف"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131363","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92146","الرمل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34650","الرمل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32822","المنسرح"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114587","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83665","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83565","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83509","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83481","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83417","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4375,"","https://poetry.dctabudhabi.ae/diwan/poem/107159","المديد"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52156","الخفيف"],[4680,"ها هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=199348",""],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4929,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199291",""],[2365,"مالك فى الجهل من عذير","https://www.poetsgate.com/ViewPoem.aspx?id=200647",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5853,"انا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=175703",""],[5970,"عش غريباً وارتحل عنها غريباً","https://www.poetsgate.com/ViewPoem.aspx?id=130603",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""]],"verses":[["رَبِّ فاجعله لي صبوحاً وقَيْلاً","وغَبوقاً وما أسأت الغذاءَ",0,"ا",2,0],["رُبَّ فتاةٍ حُرَّةِ المُقَلّدِ","تختال في زِيِّ غلام أمردِ",1,"د",1,1],["رُبَّ فردٍ منكم في دهرِه","قد كساه اللَّه أنواع الزِّين",2,"ن",1,0],["رُبَّ فِكرٍ لاحَ في لَوحَةِ نَفسي وَتَجَلّى","خِلتُهُ مِنّي وَلَكِن لَم يُقَم حَتّى تَوَلّى",3,"ل",2,0],["رب في قلب مالكي أمرنا اجعل","رأفة لا تبيح أن يتعدوا",4,"د",3,0],["رُبَّ فِعلٍ يَسمو عَلى شامِخِ الشُم","مِ وَقَولٍ يَسمو عَلى الشَمّاخِ",5,"خ",1,0],["ربَّ فلاحٍ مليحٍ","قال يا أهلَ الفتوَّهْ",6,"ه",1,1],["ربِّ فاجْعَلْني إماماً هاديا","واهْدنِي في المؤمنينَ الأصفياءْ",7,"ا",2,0],["رُبَّ فِتيانٍ رَبَأتُهُمُ","مَسقِطَ العَيّوقِ مِن سَحَرِه",8,"ر",2,0],["رُبّ فتى دنياه ليست لهُ","من خلفهِ آخرةٌ وافره",9,"ر",2,0],["رب فجر سألته","هل تنفست في السحر",10,"ر",1,0],["رُبَّ فِكْرٍ في النَّفْسِ وَهْوَ مُضيءٌ","أَخْمَدَتْهُ فَهَاهَةُ الْفَأْفَاءِ",11,"ا",2,0],["رُبَّ فلاّحٍ شَكَتْ في كفِّه","فأسُهُ الخَرْساءُ إذْ خارَتْ قُواهْ",12,"ا",2,0],["ربّ فنح ترويه للدّهر","أشلاء قناة وصارم مفلول",13,"ل",1,0],["رب فرد من الكرام به مز","ق جيش من الانام لهام",14,"م",1,0],["ربّ فامنح أُهيلَ دينك فتحاً","وتولّ انتصارَه بيمينك",15,"ك",1,0],["رب فانفعنا ببركتهم","واهدنا الحسنى بحرمتهم",16,"م",1,0],["رب فاحفظنا بهم وانفع بهم","وأعد من بركات غمرت",17,"ت",1,0],["رَبِّ فَاِجعَل مَثهواهُ جَنّاتِ عَدنِ","وَلِأَهليهِ مِنكَ بِاللُطفِ واصِلِ",18,"ل",1,0],["رُبِّ فَاِحفَظ لَنا بَقاهُ وَمَتِّع","هُ بِمالٍ مُبارَكٍ وَبَنينِ",19,"ن",1,0],["رب فاختر من القطيع حداةً","يتناهى بهم إليك الحداء",20,"ا",2,0],["رُبَّ فَتىً ناوَلته شيشة","فَاِستشعل القَلب بِنيرانها",21,"ه",2,1],["رب فضل وثناء","عم من نعماه يسر",22,"ر",1,0],["رَبِّ فاستبقِه إلينَا مَلاَذا","وآدِم جاهَه عزيزَ الجَنَابِ",23,"ب",1,0],["رُبَّ فوارةٍ خلال مروجٍ","ماؤها ناثرٌ عقودَ لآلي",24,"ل",2,1],["رُبَّ فَرْدٍ منها يفوقُ أُلوفاً","وأُلوفٍ بواحدٍ ليسَ تَلحَقْ",25,"ق",1,0],["رُبَّ فَأْرٍ وَخُنْفَسَاءٍ أُثِيْرَا","مِنْ خِلاَلِ الشُّقُوقِ مِنْ قَدَمَيْهَا",26,"ي",3,0],["ربَّ فَرَّان جَلا صَفْحَتَهُ","لَهَبُ الفرنِ جلاءَ العَسْجدِ",27,"د",1,1],["ربُّ فَهمٍ وَفِطنَةٍ مثلها في","مِثلِهِ طالَما تَمنّى الزّمانُ",28,"ن",1,0],["رَبِّ فَاِفتَح عَليهما خَيرَ فَتحٍ","فيهِ يَعلو فهماهما وَالذّكاءُ",29,"ا",2,0],["رَبُّ فضلٍ كأحمدٍ ليس يُجْحَدْ","فابنُ ياسينَ فاضلٌ عُدَّ يُحمدْ",30,"د",1,1],["رب فارحم شكواي واقبل دعاي","واغثني فأنت ربي غفور",31,"ر",1,0],["رب فاجعل قلبي إليك منيبا","واحفظ القلب من طريق المعابه",32,"ب",2,0],["رب فاجعل هواك داخل قلبي","واجعل الحب راحتي ومدامي",33,"م",2,0],["رب فانظر الي نظرة ود","واغنني بالغنا وقرب مزاري",34,"ر",2,0],["رب فاسلك بنا سبيل رجال","سلكوا في التقى طريقاً سويه",35,"ي",2,0],["رب فاجعل مجتمعنا","غايته حسن الختام",36,"م",1,0],["رُبّ فجر كالكأس قد أكفأوها","بعد ما طوّفت على الندمانِ",37,"ن",1,1],["رُب في جوف الدجى","يأتيك ما ينفي الحرج",38,"ج",1,0],["ربَّ فذِّ كان أسباب العلاء","لقبيل فاجتنوا أوفى نصيب",39,"ب",1,0],["رب فرن رأيته يتلظى","وربيع مخالطي وعقيدي",40,"ي",1,1],["ربَّ فكر وفكرةٍ وصفاتٍ","لاح في الكون نورها وسناها",41,"ا",3,0],["رب فاجىء أرض الشئام بمقت","ينسف الراسيات عن مرساها",42,"ا",3,0],["ربّ فردٍ كان في أفعاله","كابن عبودِ يُضاهي جحفلا",43,"ل",2,0],["ربّ فخر لولا تواضعه ظ","ل على الأفق ساحباً أذياله",44,"ل",2,0],["رب فتى من ذنبه على وجل","خوف عقاب ربه علا وجل",45,"ل",1,0],["ربِّ فضّلته عليّ ولو شِئ","ت فضّلتني عليه بِفَضلِ",46,"ل",1,0],["رب فاجعل له النبي مجيرا","من عذاب الجحيم يوم الحساب",47,"ب",1,0],["رب في ليل بهيم","خيعج السيرَ ابنُ مرَّهْ",48,"ه",1,1],["رُبَّ فظِّ القلبِ لا لينَ له","لو رأى ما بك منه لرَحِم",49,"م",1,0],["رُبَّ فَقيرٍ أَعَزُّ مِن أَسَدِ","وَرُبَّ مُثرٍ أَذَلُّ من نَقَد",50,"د",1,1],["ربِّ فامدُد راحةً منكَ لمَن","لرجاءِ منكَ مدَّ الرَّاحتي",51,"ي",1,0],["رَب في الإِشراقَة الأُو","لى عَلى طينة آدم",52,"م",1,0],["رَبّ فَاِجعَله في رِقاب الأَعادي","واحدٍ بَعدَ واحِدٍ بعد واحِد",53,"د",1,0],["رَبِّ فَاِمنُن بِالفَتح مِنكَ قَريباً","رَبّ هَب لي السَعادَة الأَبَدِيَّه",54,"ي",2,0],["رَبّ فَاِجلُ بَصيرَتي لأَراهُ","وَجلاءُ الأَبصارِ إثمِد كحلِ",55,"ل",1,0],["ربّ فاِمنُن بقُرب طه حَبيبي","أَشرفِ الرسلِ في الكَمالات فردُ",56,"د",1,0],["ربّ فَاِرحَم ضعفي الَّذي بتُّ منهُ","بَينَ قَومي شبهَ الغَريبِ ذَليلا",57,"ل",2,0],["رَبّ فَاِرحَم مُصابَنا وَأَجرنا","من صُروف الزَمان وَالأَيّامِ",58,"م",1,0],["رب فاردده عليّ فقد","ضاق صدري في تطلبه",59,"ب",2,0],["رُبَّ فردٍ بنفسِهِ عُدَّ قوماً","إنْ عددت الألوفَ من حَسَناتهْ",60,"ت",2,0],["ربِّ فالطفْ بالبائسين الحيارى","واقصمْ الظلم فالسنا مفقودُ",61,"د",1,0],["رب فاحشره في نعيم وهيىء","من جزاءٍ له مكانا علِيا",62,"ي",2,0],["رَبِّ فامنُنْ عليّ بالفضل شكراً","لك والوالدين وارفع مقامي",63,"م",2,0],["ربّ فقير غنى نفس","وذي غنى بائس فقير",64,"ر",1,0],["ربّ فجرٍ مبشّرٍ بانبلاجٍ","شقشق الليل داحرا كلّ نحسِ",65,"س",1,0],["ربِّ فاحفظهمُ حُماةً رُعاةً","واحفظ الكل فالجميع وِقاء",66,"ا",2,0],["ربُ فارحم من في التراب توارى","بذل الروح للعراق مكانا",67,"ن",2,0],["رب فعل أنت تأتيه لكي","تطرب الغير فتلقاه غضوباً",68,"ب",2,0],["رُبَّ فَذٍّ؛ مُذَهَّبِ الشِّعرِ؛ مِثلِي","عَبقَرِيٍّ؛ بِكُلِّ مَجدٍ خَلِيقِ",69,"ق",1,0]]}