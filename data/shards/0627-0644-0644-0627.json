{"poems":[[32,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[74,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[74,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[53,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[93,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[40,"إن ابن مغراء عبد ليس نائلنا","https://www.aldiwan.net/poem7823.html","البسيط"],[87,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[45,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[60,"قومي إذا اشتبك القنا","https://www.aldiwan.net/poem30940.html","مجزوء الكامل"],[42,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[77,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[92,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[228,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[254,"أمسى سمير قد بان فانقطعا","https://www.aldiwan.net/poem2108.html","المنسرح"],[401,"اللات كالبيض لما تعدُ أن درست","https://www.aldiwan.net/poem586.html",""],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[422,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[443,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[520,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83294","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122787","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122697","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122573","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64076","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39001","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48959","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48248","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67968","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106899","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100212","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126245","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26115","الكامل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124637","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125842","البسيط"],[4988,"سلايل هبس / قبيلة بني خالد","https://www.poetsgate.com/ViewPoem.aspx?id=186506",""],[5057,"ما أوحش \"الفيس\"","https://www.poetsgate.com/ViewPoem.aspx?id=197195",""],[5151,"قافية الخصر","https://www.poetsgate.com/ViewPoem.aspx?id=184824",""],[5397,"خضعت لعزة ذاتك الدول","https://www.poetsgate.com/ViewPoem.aspx?id=157897",""],[5431,"حنظلة...مازال في العشق الكثير لنكمله!","https://www.poetsgate.com/ViewPoem.aspx?id=198015",""],[5431,"هي لم تعد لليوم تهواه!","https://www.poetsgate.com/ViewPoem.aspx?id=201336",""],[5458,"حتى يقال وقد قيل","https://www.poetsgate.com/ViewPoem.aspx?id=113377",""],[5533,"يا وَيْحَ نَفْسِي","https://www.poetsgate.com/ViewPoem.aspx?id=176700",""],[5616,"آسام","https://www.poetsgate.com/ViewPoem.aspx?id=204837",""],[5652,"معك الضياغم راسية فوق منزال","https://www.poetsgate.com/ViewPoem.aspx?id=177976",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""]],"verses":[["أَلِلأَربُعِ الدُهمِ اللواتي كَأَنَّها","بَقِيّاتُ وَحيٍ في مُتونِ الصَحائِفِ",0,"ف",1,1],["اللابِسينَ لُكُلِّ يَومِ حَفيظَةٍ","حَلَقاً يُداخَلُ شَكُّهُ مَسرودا",1,"د",2,0],["اللائذين اليومَ من حاتمٍ","كأنه شعوآءُ فيها فنخ",2,"خ",1,0],["اللابس التقوى سُماً وفعائلاً","فانظر له في الفضل فضل لباس",3,"س",1,0],["اللائي أشْبَهنَ الغصو","نَ المستقيماتِ الموائلْ",4,"ل",1,0],["اللابِسَ الوَرَقَ اليَبيسَ تَنَسُّكاً","وَالمُشمَخِرَّ إِلى السَماءِ تَجَبُّرا",5,"ر",2,0],["اللافِظينَ النَوى تَحتَ الثِيابِ كَما","مَجَّت كَوادِنُ دُهمٌ في مَخاليها",6,"ي",3,0],["اللاعِباتِ عَلى النَسيمِ غَدائِراً","الراتِعاتِ مَعَ النَسيمِ قُدودا",7,"د",2,0],["اللاءِ أَفتَكُها الجَبانُ بِمُهجَتي","وَأَحَبُّها قُرباً إِلَيَّ الباخِلُ",8,"ل",1,0],["اللابِسونَ دروعَهُم","فَوقَ الصُدورِ لِأَجلِ ذَلِك",9,"ك",1,0],["اللانَ لِقَولي أَو لَعادَو وَما اِعتَصى","عَلَيَّ بِعاداً غِلظَةً وَتَشَدُّدا",10,"د",2,0],["أللاء لا يَعْرِفْنَ إلاّ غَارَةً","شَعْواءَ فهي إلى الكُماةِ صواهل",11,"ل",1,0],["اللاحِقاتُ وراءَهَا وأمامَها","فكأنّهُنّ جَنائبٌ وشَمائل",11,"ل",1,0],["اللاّبِسينَ من الجِلاد الهَبْوَ ما","أغناهُمُ عن لأمَةٍ وسَنَوَّر",12,"ر",1,0],["اللابسات قصائدي ومدامعي","عاتبتهن فما أفاد عتاب",13,"ب",1,0],["اللاهثون على هوامش عمرنا","سيان إن حضروا وإن همُ غابوا",13,"ب",3,0],["اللاجئون جِراحٌ في جوانحِنا","تَدْمَي، فهل لجراح العُرْب ضَمَّاد؟",14,"د",1,0],["اللاجئون سَقام في مفاصلنا","ولا شِفاء لَه إلا إذا عادوا",14,"د",3,0],["أللاؤطان وهي تَعِجُّ شكوى","كعهدهما وتصطخبُ اصطخابا",15,"ب",2,0],["اللائي يمدُدْنَ إلى المُناول","بِيضاً سِباطاً ليس بالعَوامل",16,"ل",1,0],["اللابسونَ بسطوةٍ أَبرادَهُ","وَالمُضرِمونَ البَأسَ في أَجنادِهِ",17,"د",2,0],["اللابِسَ الخَيلَ في العَجاجَةِ بِال","خَيلِ تَساقى سِمامَها نُقَعا",18,"ع",2,0],["اللاتِ كالبيضِ لما تَعدُ أن دَرَست","صُفرُ الأَنامِل مِن نَقفِ القواريرِ",19,"ر",1,1],["اللاّبِسينَ من المكارمِ جُنّةً","ما للمَعَايِبِ غيرَها من وَاقِ",20,"ق",1,0],["اللابسون من الفخار ملابساً","ومن الوقار سكينة بسكون",21,"ن",1,0],["اللابس المجد جديداً والورى","عليهم منه الفتيق والخلق",22,"ق",1,0],["اللابس الفخر لم ينسج غلائله","إلا يد الصانعين السيف والقلم",23,"م",1,0],["اللامِعِ الرَأيِ إِن يَدجُ الزَمانُ بِكُم","وَالخالِفُ الغَيثِ إِن تَستَبطِئوا السُحُبا",24,"ب",2,0],["اللاَّبِسي جُنُنَ الأَسحابِ مُحصِنَةً","مِنَ المَلامَةِ إذ لا تُحصِنُ الجُنَنُ",25,"ن",1,0],["اللائي ما مَدِحَ الوَليدُ بمثلِهنَّ","الصّامِتيّ وَلا حَبيبُ الواثِقَا",26,"ق",2,0],["اللابسي زَردَ الإحسانِ مُحصنةً","من الملامةِ إذ لا تُحصِنُ الزُّرُدُ",27,"د",1,0],["اللابسُ الخُلُقَ الذي هو شيمةٌ","إِذ بعض أخلاقِ الرجالِ تَخَلُّق",28,"ق",1,0],["اللّافظ الدّرّ مَنثوراً وَمُنتَظِماً","وَمودِع الحِكم الأَقوالَ والكَلِما",29,"م",2,0],["اللابسون على المسيحِ حِدادَهم","اللابسون من السلام دِثارا",30,"ر",2,0],["اللابساتِ من الوشيِ الطريفِ كما","يُطرِّفُ الحسنُ بالريشِ الطواويسا",31,"س",2,0],["اللابسات البدر ما","بين الحواجب والمراشف",32,"ف",1,1],["اللانهاية في بعيد سمائها","واللانهاية في القريب الداني",33,"ن",2,0],["اللابس النثرة الحصدا من الزرد الن","نثر المشرد والنظم والأساريب",34,"ب",1,0],["اللابسين اذا ادلهمت نكبة","حلق الحديد مضاعفاً مسرودا",35,"د",2,0],["أللا فارحموا بناً على الباب واقفا","يروم اتصالا فاتحفوه بنظرة",36,"ه",1,0],["اللابِسينَ إِذا الكَتيبَةُ أَقبَلَت","حَلَقا يَسير قَتيرُهُ مَسرودا",37,"د",2,0],["اللاَّحِظُونَ بِنُور الله إن غَضِبُوا","وَالشَّامِلُونَ بِيُمنٍ حَيثُما انصرَفُُوا",38,"ف",3,0],["اللائي يقنصن الغراب بوكره","وَيصدن من قلل الجبال وَعولا",39,"ل",2,0],["اللاجئون من الرمضا إلى النار","عار عليكم جميعاً أيما عار",40,"ر",1,1],["اللابه اللي مجدها مجد وتليد","لليوم هذا ما تروم الا الطّويله",41,"ل",2,0],["\" اللايكاتُ \" ولو في العامِ إن حصلت","أشهى لديهِ منَ البرقوقِ والكَرَزَ",42,"ز",1,0],["اللاهِثُون على حَرفي وهَبْتُ لَهَم","كُلَ الحُروفِ ولي من حَظكِ النُّونُ",43,"ن",1,0],["اللات والعزى به نفيا","ومناة ذكت وانمحى هبل",44,"ل",1,0],["اللاعبون بعرشنا في رقعة ال","شطرنج قد تركوا الحياة معطله",45,"ل",2,0],["اللاوجود الصرف يرعبه","لكنّه الموجود جوّاه",46,"ا",2,0],["اللاهثون وراء بعض دراهم","فهموا الحياة مكاسباً ومغانما",47,"م",2,0],["اللاعِقِيْن حِذَاءَهَ والعابِدِيْن","لا عَيْشَ للأَحْرارِ بَيْنَ الخَانِعيْن",48,"ن",1,0],["أللإِسلام نسبتُنا وهذا","دمُ الإسلام أرخصُ ما يكونُ!؟",49,"ن",1,0],["اللابه الي من قديمٍ سطرها","فخرآ ينومسنا على مر الاجيال",50,"ل",1,1],["اللاذقية، حَفّة، وصِلِنْفة","ليست تملُّ ذهابنا وإيابا",51,"ب",2,0],["6. اللاعنون أبابكرٍ وحجتُّهم","أضاعَ حقَّ عليٍّ ذاكَ بُهتانُ",52,"ن",1,0],["اللابسون الخوفَ تحتَ ثيابهم","لنْ يَبْلغوا -حتى القيامة -- شيّا",53,"ي",2,0],["اللائمونَ أصابوا في تَعَقُّلِهِمْ","لم يشرعوا ردفةَ الأحشاءِ للألمِ",54,"م",1,0]]}