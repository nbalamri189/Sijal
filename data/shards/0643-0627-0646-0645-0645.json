{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[51,"نعى نفسي إلي من الليالي","https://www.aldiwan.net/poem63062.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[458,"عزاء بهذا الموت يا من فدى مصرا","https://www.aldiwan.net/poem61244.html","الطويل"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56459","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45797","الخفيف"],[4963,"ليش نزلتي عيونك ارفعيها وطالعيني","https://www.poetsgate.com/ViewPoem.aspx?id=35142",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""]],"verses":[["كانَ مِمَّن أَسكَرَتهُ","أَمسِ هاتيكَ المُدامُ",0,"م",1,0],["كان مما حدَّثتُ ضيفك أن قل","تُ وقد حل في ذراك طروقا",1,"ق",2,0],["كان مما يُغل في أذنه الري","شةَ حتى تغيب في اللُّغنون",2,"ن",1,0],["كانَ مِمَّن يُرتَجى لَو سَلِما","لِلعُلى لَكِنَّهُ لَم يَسلَمِ",3,"م",1,0],["كَأَنَّ مُمَرِّضي قَد قامَ يَمشي","بِنَعشي بَينَ أَربَعَةٍ عِجالِ",4,"ل",1,0],["كَانَ مِمَّنْ بَنَوْا عُلاَهَا فَرِيعَتْ","بِانْقِضَاضِ البِنَاءِ بَعْدَ البِنَاءِ",5,"ا",2,0],["كأن مماتا ذقت أبلغ حجّة","وأوقع في تفنيد متهم مصرا",6,"ر",2,0],["كانَ مَمْلوكي فأَضْحَى مَالِكِي","إنّ هذا مِنْ أعاجِيبِ الزَّمَنْ",7,"ن",1,0],["كانَ مِما أَسرّه الدَهر دَهراً","ثُم نمَّ التَقليب بِالأَحوال",8,"ل",1,0],["كان ممكن ما احبك كان ممكن تتركيني","كان ممكن من البدايه تخدعي غيري بدالي",9,"ل",2,0],["كان ممكن أكون وكنت مالي مثيل","تشبه الناس بعض وواجد أمثالها",10,"ل",3,0]]}