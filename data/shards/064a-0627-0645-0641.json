iwan/poem/94593","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135132","المجتث"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117245","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117232","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77695","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33699","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136390",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35139","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52194","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"],[4716,"يا مفرداً علومه مجمله","https://www.poetsgate.com/ViewPoem.aspx?id=125958",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5573,"لك البقا مع طول الايام ياخال","https://www.poetsgate.com/ViewPoem.aspx?id=200175",""],[5573,"ينام من عينه خليه من الهم","https://www.poetsgate.com/ViewPoem.aspx?id=204542",""],[5606,"يامفرج هم من زاد به همه","https://www.poetsgate.com/ViewPoem.aspx?id=196752",""],[5652,"معك الضياغم راسية فوق منزال","https://www.poetsgate.com/ViewPoem.aspx?id=177976",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5694,"الهوى الأصلي","https://www.poetsgate.com/ViewPoem.aspx?id=132091",""],[6019,"طيفاً أُعانقُ في محرابَكَ الأجلا","https://www.poetsgate.com/ViewPoem.aspx?id=143419",""],[6089,"امدد كؤؤسك","https://www.poetsgate.com/ViewPoem.aspx?id=213755",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6142,"يا مفعم البئر في بدر أشاوسة","https://www.poetsgate.com/ViewPoem.aspx?id=155712",""],[159,"وغادة ٍ ترفلُ في الشبابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26940&r=&rc=11",""]],"verses":[["يا مُفْرِطَ الجهْلِ والغَباوَةِ لا","يُحْسَبُ إلا منْ جُمْلَةِ البَقَرِ",0,"ر",1,0],["يَا مُفْرَداً عَلَماً أَوْدَى الجِهَادُ بِهِ","أَفْدَحْ بِخُطْبِ الحِمَى فِي المُفْرَدِ العَلَمِ",1,"م",1,1],["يامُفرَداً باتَ يَبكي لامُعينَ لَهُ","أَعانَكَ اللَهُ بِالتَسليمِ وَالجَلَدِ",2,"د",1,0],["يا مفيدَ الورى لآلئَ بحرٍ","يعرِفُ الذوقُ عذبه وفراته",3,"ت",2,0],["يا مفزع العافي إذا شفَّه","حرمانه واشتدَّ إملاقه",4,"ق",2,0],["يا مُفقِدي مَع وُجودي فَيضَ أَنعُمِهِ","هَمّي وَمَوجودُ وَجدي وَهوَ مَفقودُ",5,"د",1,0],["يا مُفرَداً في الحُسنِ وَالشَكلِ","مَن دَلَّ عَينَيكَ عَلى قَتلي",6,"ي",1,1],["يا مُفسدا قام تحت الدين مستترا","ليجعل الامر في البلدان مضطربا",7,"ب",2,0],["يامفردا بات يتكى لا معين له","أعانك الله بالتسليم والجلد",8,"د",1,0],["يا مُفيد الأَنام رَفداً وَفَضلاً","وَمُعير البُدور نوراً وَحُسنا",9,"ن",2,0],["يا مُفرداً بمادحٍ كذَّابِ","وصادقاً في هجوه مغتابي",10,"ب",2,0],["يا مفردا كسب الحطام","بسيفه وسنانه",11,"ن",2,0],["يا مفرد الحسن يا نديما","من ثغره في الغرام جامى",12,"م",2,0],["يا مفرداً سحرت قلبي لواحظه","أما ترق لجفن رق وابله",13,"ل",2,0],["يا مُفْلِتَ الظَّبْيَةِ الْغَنّاءِ مِنْ يَدِهِ","هَلاّ عَلِقْتَ بِها حُيِّيتَ مُقْتَنِصاً",14,"ص",2,1],["يا مفزعاً للمستغيثِ بكم وَقَدْ","أَمسى وَليس يرى له من مفزع",15,"ع",1,0],["يا مفزعي عند الكروب وملجئي","عن الخطوب وخشية الإضرار",16,"ر",1,0],["يا مُفرداً بَينَ أَرباب المُروءة في","بَذل المَساعي وَتَبليغ الصَديق مُنى",17,"ن",2,1],["يا مُفرَداً كَمُلت محاسنُ ذاته","لُطفاً فَفاقَ بِها عَلى أَترابهِ",18,"ه",1,1],["يا مُفلِساً أُودِعَ سِجنَ الهَوى","وَيا يَتيماً في يَدِ الحاجِرِ",19,"ر",1,0],["يا مفرداً بالحسن إنك منتهٍ","فيه كما أنا في الصبابة منتبه",20,"ه",1,0],["يا مُفردَ الحُسنِ إنِّي مُفردٌ أبَداً","بالسُّقم فيكَ وباقي النَّاسِ أشباهُ",21,"ه",1,0],["يا مفرداً ضجت لسان الثنا","في جامع الفضل له تخطب",22,"ب",1,0],["يا مفرَداً في عَصره","بالفضلِ معدوم النظير",23,"ر",1,0],["يا مفيضاً من روحه نفحات","منك يستوهب الكمال كمال",24,"ل",1,0],["يا مفرداً بالجمال قلبي","من بعد بعدك في احتراق",25,"ق",1,0],["يا مفعم القلب ايمانا ومرجه","ذكرا ومعرفة فينا لباريه",26,"ي",2,0],["يا مفخر البيت الحسي","ني التونسي الزاهر",27,"ر",1,1],["يا مفرِدي بالتقلّي","وآمري بالتأسي",28,"س",2,0],["يا مُفْرَداً في الكمالِ أَضْحَى","لَهُ بِرَب