{"poems":[[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[93,"يا مفرداً علماً أودى الجهاد به","https://www.aldiwan.net/poem11282.html","البسيط"],[47,"أوصيك بالحزن لا أوصيك بالجلد","https://www.aldiwan.net/poem25330.html","البسيط"],[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[52,"يا مُفرَداً في الحُسنِ وَالشَكلِ","https://www.aldiwan.net/poem26741.html","السريع"],[88,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[47,"أوصيك بالحزن ولا أوصيك بالجلد","https://www.poetsgate.com/ViewPoem.aspx?id=12902",""],[109,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[155,"وغادة ترفل في الشباب","https://www.aldiwan.net/poem55794.html","الرجز"],[186,"هذا المورث قال لي","https://www.aldiwan.net/poem43233.html","مجزوء الكامل"],[211,"هوى جديد أشد فتكا","https://www.aldiwan.net/poem46241.html","مخلع البسيط"],[222,"يهيم قلبي بمن رقت شمائله","https://www.aldiwan.net/poem55412.html","البسيط"],[280,"يا مفلت الظبية الغناء من يده","https://www.aldiwan.net/poem60762.html","البسيط"],[298,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[304,"ما للفؤاد يفيض بالأكدار","https://www.aldiwan.net/poem16809.html","الكامل"],[353,"يا مفردا بين أرباب المروءة في","https://www.aldiwan.net/poem39756.html","البسيط"],[353,"يا مفردا كملت محاسن ذاته","https://www.aldiwan.net/poem40584.html","الكامل"],[366,"واصل طيف الحب كالهاجر","https://www.aldiwan.net/poem16988.html","السريع"],[369,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[371,"سائل خيالك عما بت ألقاه","https://www.aldiwan.net/poem56995.html","الطويل"],[403,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[416,"مولاي قد حان الوداع","https://www.aldiwan.net/poem53845.html","مجزوء الكامل"],[416,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[429,"أشكو إليك الذي ألاقي","https://www.aldiwan.net/poem40266.html","مخلع البسيط"],[479,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[479,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[495,"لا والذي شق خمسي","https://www.aldiwan.net/poem9884.html","المجتث"],[529,"يا مفردا في الكمال أضحى","https://www.aldiwan.net/poem37167.html","مخلع البسيط"],[529,"بدر بأفلاك البلاغة طالع","https://www.aldiwan.net/poem37341.html","الكامل"],[538,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"]],"verses":[["يا مُفْرِطَ الجهْلِ والغَباوَةِ لا","يُحْسَبُ إلا منْ جُمْلَةِ البَقَرِ",0,"ر",1,0],["يَا مُفْرَداً عَلَماً أَوْدَى الجِهَادُ بِهِ","أَفْدَحْ بِخُطْبِ الحِمَى فِي المُفْرَدِ العَلَمِ",1,"م",1,1],["يامُفرَداً باتَ يَبكي لامُعينَ لَهُ","أَعانَكَ اللَهُ بِالتَسليمِ وَالجَلَدِ",2,"د",1,0],["يا مفيدَ الورى لآلئَ بحرٍ","يعرِفُ الذوقُ عذبه وفراته",3,"ت",2,0],["يا مفزع العافي إذا شفَّه","حرمانه واشتدَّ إملاقه",4,"ق",2,0],["يا مُفقِدي مَع وُجودي فَيضَ أَنعُمِهِ","هَمّي وَمَوجودُ وَجدي وَهوَ مَفقودُ",5,"د",1,0],["يا مُفرَداً في الحُسنِ وَالشَكلِ","مَن دَلَّ عَينَيكَ عَلى قَتلي",6,"ي",1,1],["يا مُفسدا قام تحت الدين مستترا","ليجعل الامر في البلدان مضطربا",7,"ب",2,0],["يامفردا بات يتكى لا معين له","أعانك الله بالتسليم والجلد",8,"د",1,0],["يا مُفيد الأَنام رَفداً وَفَضلاً","وَمُعير البُدور نوراً وَحُسنا",9,"ن",2,0],["يا مُفرداً بمادحٍ كذَّابِ","وصادقاً في هجوه مغتابي",10,"ب",2,0],["يا مفردا كسب الحطام","بسيفه وسنانه",11,"ن",2,0],["يا مفرد الحسن يا نديما","من ثغره في الغرام جامى",12,"م",2,0],["يا مفرداً سحرت قلبي لواحظه","أما ترق لجفن رق وابله",13,"ل",2,0],["يا مُفْلِتَ الظَّبْيَةِ الْغَنّاءِ مِنْ يَدِهِ","هَلاّ عَلِقْتَ بِها حُيِّيتَ مُقْتَنِصاً",14,"ص",2,1],["يا مفزعاً للمستغيثِ بكم وَقَدْ","أَمسى وَليس يرى له من مفزع",15,"ع",1,0],["يا مفزعي عند الكروب وملجئي","عن الخطوب وخشية الإضرار",16,"ر",1,0],["يا مُفرداً بَينَ أَرباب المُروءة في","بَذل المَساعي وَتَبليغ الصَديق مُنى",17,"ن",2,1],["يا مُفرَداً كَمُلت محاسنُ ذاته","لُطفاً فَفاقَ بِها عَلى أَترابهِ",18,"ه",1,1],["يا مُفلِساً أُودِعَ سِجنَ الهَوى","وَيا يَتيماً في يَدِ الحاجِرِ",19,"ر",1,0],["يا مفرداً بالحسن إنك منتهٍ","فيه كما أنا في الصبابة منتبه",20,"ه",1,0],["يا مُفردَ الحُسنِ إنِّي مُفردٌ أبَداً","بالسُّقم فيكَ وباقي النَّاسِ أشباهُ",21,"ه",1,0],["يا مفرداً ضجت لسان الثنا","في جامع الفضل له تخطب",22,"ب",1,0],["يا مفرَداً في عَصره","بالفضلِ معدوم النظير",23,"ر",1,0],["يا مفيضاً من روحه نفحات","منك يستوهب الكمال كمال",24,"ل",1,0],["يا مفرداً بالجمال قلبي","من بعد بعدك في احتراق",25,"ق",1,0],["يا مفعم القلب ايمانا ومرجه","ذكرا ومعرفة فينا لباريه",26,"ي",2,0],["يا مفخر البيت الحسي","ني التونسي الزاهر",27,"ر",1,1],["يا مفرِدي بالتقلّي","وآمري بالتأسي",28,"ي",1,0],["يا مُفْرَداً في الكمالِ أَضْحَى","لَهُ بِرَبْعِ الْعُلَى مَقامُ",29,"م",1,1],["يا مُفْنِياً عَصْرَ الشَّبِيبةِ جاهِداً","في كُلِّ عِلْمٍ للْعَلائِقِ قاطِعُ",30,"ع",1,0],["يا مُفرداً بخِل الزَّما","نُ بجمعِه في مَن نخَب",31,"ب",1,0],["يا مفزعَ الملهوفِ مم","ما خاف يعمِدُ أو يَزِلُّ",32,"ل",1,0]]}