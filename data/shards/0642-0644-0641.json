{"poems":[[63,"قل في الهوى حيلي","https://www.aldiwan.net/poem45722.html","المقتضب"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[51,"لولا فواكه أيلول إذا اجتمعت","https://www.aldiwan.net/poem7933.html","البسيط"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[28,"منازيل عن ظهر القليل كثيرنا","https://www.aldiwan.net/poem5340.html","البسيط"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[72,"يَا فَاضلا قد عني لرتبته","https://www.poetsgate.com/ViewPoem.aspx?id=189425",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[143,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[170,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[298,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[365,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[367,"يا ليلة بات فيها البدر معتنقي","https://www.aldiwan.net/poem17089.html","البسيط"],[433,"قل في الزمان فإنه","https://www.aldiwan.net/poem12632.html","مجزوء الكامل"],[433,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[438,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[480,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"]],"verses":[["قَلَّ في الهَوى حيَلي","يا كَثيرَةَ المَلَلِ",0,"ل",1,1],["قَلَّ فِي النَّاسِ مَنْ لَهُ فَضْلُهُ الجَ","مُّ وَتِلْكَ النُّهَى وَذَاكَ الخِيمُ",1,"م",1,0],["قلْ فيه ما شئتَ من شهرٍ تعهَّدُهُ","في كلّ يومٍ يدٌ للَّهِ بيضاءُ",2,"ا",2,0],["قَلَّ في الناسِ مَن صَبَر","مُختارا",3,"ا",1,0],["قل فيم يأتمر الرجال وما الذي","يبغون من دول لحقن بعاد",4,"د",1,0],["قُل فَكَم مِن جَواهِرٍ بِنِظامٍ","وُدُّها أَنَّها بِفيكَ كَلامُ",5,"م",1,0],["قَلَفنا الحَصى عَنهُ الَّذي فَوقَ ظَهرِهِ","بِأَحلامِ جُهّالٍ إِذا ما تَغَضَّفوا",6,"ف",3,0],["قَلَّ في شَطِّ نَهرَوانَ اِغتِماضي","وَدَعاني هَوى العُيونِ المِراضِ",7,"ض",1,1],["قُلْ في نَوالٍ للزّمانِ مُبَجَّلٍ","قل في كمالٍ للوَرى مُستَنقَص",8,"ص",1,0],["قَلَّ فِي جَنْبِ فَضْلِكَ المَوْفُورِ","مَا تَرَى مِنْ تَجِلَّةٍ وَشُكُورِ",9,"ر",1,1],["قلف لي بنعم وبأتراب لها","يلعبن ما شاء الصبا والأشر",10,"ر",1,0],["قل فِيهِ مَا شِئْت إِن حذفت وَإِن","حرفت واشرح مَا أَنْت عالمه",11,"م",2,0],["قل فال رأيك فى الجلاد ولم تزل ... آراء أغمار الرجال تفيل","وبعثت بالأسطول يحمل عدةً ... فأثابنا بالعدة الأسطول",12,"ل",1,0],["قلِفَت بهم قلقَ اللديغ كأنما","ظنَّت سياطَهُمُ أراقمَ تلسعُ",13,"ع",1,0],["قَلفاءُ مِن نَبطِ البَطائِحِ لَم","تَمرُر لَها المَوسى عَلى بَظرِ",14,"ر",1,0],["قُل في عليٍّ أَمير النَحل غُرَّتهم","ما شئتَ وفق اِتِّساعِ المدح واِحتكمِ",15,"م",1,0],["قُلْ في الورَى طُرّاً إذا استَثْنَيْتَه","القولُ جَمٌّ والفعالُ قليلُ",16,"ل",1,0],["قُل في الزُلالِ إِذا وافى عَلى ظَمَإٍ","فَقَد دَلَلتَ عَلى التَفصيلِ بِالجُمَلِ",17,"ل",1,0],["قلْ في الزمانِ فإنّهُ","هرِمٌ ونكِّب عن زُهَيْرِ",18,"ر",1,1],["قلْ في زهيرٍ وعدِّدْ من مواقفِه","تَقُلْ مَعَدُّ شهدناها وعنانُ",19,"ن",1,0],["قلّ فيك البكاء حقّا وإن كا","ن كثيرا ما بغير نفاد",20,"د",1,0],["قل فيه ما يرضي العلى فإنه","يقول ما يرضي المنى ويفعل",21,"ل",1,0],["قل فهو حينئذ سر الوجود وما","أدراك ما السر فاعلم فضله السامي",22,"م",2,0]]}