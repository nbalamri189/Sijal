,"https://poetry.dctabudhabi.ae/diwan/poem/139058",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64018","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120003","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202099",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55893","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124025","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2419,"","https://poetry.dctabudhabi.ae/diwan/poem/124305","الكامل"],[2419,"","https://poetry.dctabudhabi.ae/diwan/poem/124307","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93616","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111281","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100361","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87451","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103055","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70140","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107494","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135123","الرجز"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120499","الكامل"],[4956,"دولة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=1392",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[402,"إن بكى الشرق فالمصاب أليم","https://www.poetsgate.com/ViewPoem.aspx?id=36206",""]],"verses":[["قَلَّ في الهَوى حيَلي","يا كَثيرَةَ المَلَلِ",0,"ل",1,1],["قَلَّ فِي النَّاسِ مَنْ لَهُ فَضْلُهُ الجَ","مُّ وَتِلْكَ النُّهَى وَذَاكَ الخِيمُ",1,"م",1,0],["قلْ فيه ما شئتَ من شهرٍ تعهَّدُهُ","في كلّ يومٍ يدٌ للَّهِ بيضاءُ",2,"ا",2,0],["قَلَّ في الناسِ مَن صَبَر","مُختارا",3,"ا",1,0],["قل فيم يأتمر الرجال وما الذي","يبغون من دول لحقن بعاد",4,"د",1,0],["قُل فَكَم مِن جَواهِرٍ بِنِظامٍ","وُدُّها أَنَّها بِفيكَ كَلامُ",5,"م",1,0],["قَلَفنا الحَصى عَنهُ الَّذي فَوقَ ظَهرِهِ","بِأَحلامِ جُهّالٍ إِذا ما تَغَضَّفوا",6,"ف",3,0],["قَلَّ في شَطِّ نَهرَوانَ اِغتِماضي","وَدَعاني هَوى العُيونِ المِراضِ",7,"ض",1,1],["قُلْ في نَوالٍ للزّمانِ مُبَجَّلٍ","قل في كمالٍ للوَرى مُستَنقَص",8,"ص",1,0],["قَلَّ فِي جَنْبِ فَضْلِكَ المَوْفُورِ","مَا تَرَى مِنْ تَجِلَّةٍ وَشُكُورِ",9,"ر",1,1],["قلف لي بنعم وبأتراب لها","يلعبن ما شاء الصبا والأشر",10,"ر",1,0],["قل فِيهِ مَا شِئْت إِن حذفت وَإِن","حرفت واشرح مَا أَنْت عالمه",11,"م",2,0],["قل فال رأيك فى الجلاد ولم تزل ... آراء أغمار الرجال تفيل","وبعثت بالأسطول يحمل عدةً ... فأثابنا بالعدة الأسطول",12,"ل",1,0],["قلِفَت بهم قلقَ اللديغ كأنما","ظنَّت سياطَهُمُ أراقمَ تلسعُ",13,"ع",1,0],["قَلفاءُ مِن نَبطِ البَطائِحِ لَم","تَمرُر لَها المَوسى عَلى بَظرِ",14,"ر",1,0],["قُل في عليٍّ أَمير النَحل غُرَّتهم","ما شئتَ وفق اِتِّساعِ المدح واِحتكمِ",15,"م",1,0],["قُلْ في الورَى طُرّاً إذا استَثْنَيْتَه","القولُ جَمٌّ والفعالُ قليلُ",16,"ل",1,0],["قُل في الزُلالِ إِذا وافى عَلى ظَمَإٍ","فَقَد دَلَلتَ عَلى التَفصيلِ بِالجُمَلِ",17,"ل",1,0],["قلْ في الزمانِ فإنّهُ","هرِمٌ ونكِّب عن زُهَيْرِ",18,"ر",1,1],["قلْ في زهيرٍ وعدِّدْ من مواقفِه","تَقُلْ مَعَدُّ شهدناها وعنانُ",19,"ن",1,0],["قلّ فيك البكاء حقّا وإن كا","ن كثيرا ما بغير نفاد",20,"د",1,0],["قل فيه ما يرضي العلى فإنه","يقول ما يرضي المنى ويفعل",21,"ل",1,0],["قل فهو حينئذ سر الوجود وما","أدراك ما السر فاعلم فضله السامي",22,"م",2,0],["قُل في حَبيبٍ وَبَشّارٍ وَرَهطِهِما","وَالبُحتُرِيِّ وَلا تُضَنِّنُ بِهِ وَقِسِ",23,"س",1,0],["قل في عِصامٍ غداً وزيرا","ولم يَكن قَبلَها وزيرا",24,"ر",2,0],["قلْ في اخضِرارِ عِذارِهِ وقَوَامهِ","خلعَ الرَّبيعُ على غُصُونِ البَانِ",25,"ن",1,1],["قل فيَّ ما فيك حينَ يُعجِزكَ ال","قولُ ففي بعضِ ذاك مُستَمْتَع",26,"ع",1,0],["قل فإنه قد كان رب جِرايَةٍ","وقد اغتدى موصولها مقطرعا",27,"ع",2,0],["قل فاحملا كل السلا","ح علىَّ حملة غير وانِ",28,"ن",1,0],["قل فتاكم ليس يدري ما","الوَسَنْ والنوى البسَهُ ثوب السقام",29,"م",1,0],["قل في الثلاث قصرها بالألف","والنادر الثاني بنقص الأحرف",30,"ف",1,0],["قل فاعلن ثمانيا تكرّرت","ثنتان مع أربعة تقرّرت",31,"ت",1,0],["قل فاعلن فرع لمفعولات","من بعد خبله وكشف باتي",31,"ي",1,0],["قل فعلن من متفاعلن إذا","حذ وقل من فاعلن أيضا كذا",31,"ذ",2,0],["قل فيه ما نزل الكتاب بوفقه","من كونه بشرا نبيئا مرسلا",32,"ل",2,0],["قَلَّ في عصرنا الكرامُ وفي فر","هادَ ذاك القليلُ صار كثيرا",33,"ر",2,0],["قل فيها البكاء بالدم لا بالد","دمع وعط الأكباد لا الأبراد",34,"د",1,0],["قل فقد عاد جيش مظهر الرش","د على ناهج الرشاد عفاها",35,"ا",3,0],["قل في تثنيه وخاطره","فبميله يقضي على أجلي",36,"ل",2,0],["قل فيه تشريفا وحبا إنّه","عبد حبيبي للاله مقرّب",37,"ب",1,0],["قل فيه عبد الله خيرُ عباده","لضيائه تتهلل الأرجاء",38,"ا",2,0],["قُل فيهُم قدمات أَوطأ كَم قَرى","في الخَطب أَو قَل ماتَ ابذلكم قَرى",39,"ر",2,0],["قل في علي ما تشاء بفضله","ما لم تناف حقيقة الإيمان",40,"ن",1,1],["قل في القضاء الفصل مهما نطقوا","وان تشأ قل في الجراز الفاصل",41,"ل",1,0],["قلَّ فيهِ الصَبرُ والوَجدُ كثير","وَهواهُ قاتلي بالأَكثرِ",42,"ر",1,0],["قلّ في المكرمات مثلك يا بحر","كما قلّ في الأنام الكرام",43,"م",1,0],["قل فنسي أصد عن أهواءي","وأرد السرى عن الإبلاء",44,"ا",2,0],["قُل فرَّغوا القلب مما كانَ يشغلهُ","عَن حمدِ مولىً رَفيعِ القدرِ مرتقبِ",45,"ب",1,0],["قل فما أنت حاملٌ","بين بُردَيكَ من عجب",46,"ب",1,0],["قل في الكرامِ لهُ","مُشبهٌ وإنْ كثروا",47,"ر",3,0],["قل فيه ما شئت فذاك احسن","لان قصد الحنس فيه بين",48,"ن",1,0],["قُل فيهِ إِمّا تَصِف رُكناً لِمُستَنِد","رَوضاً لِمنتجع أُنساً لِمُغتَربِ",49,"ب",1,0],["قل فيه شعرا كيف شئت ودع لها","تجبيره ان فاتك التجير",50,"ر",1,0],["قلّ فهم السواد للشعر حتى","طرحوا حُرَّه وصانوا العبيدا",51,"د",2,0],["قُلْ: \"فَانْفُذُوا\" آياتُ صِدقٍ بَيِّنٍ","فُتِحتْ بها الأَفَاقُ والأَنْحَاءُ",52,"ا",2,0],["قُلْ فَكَمْ مِنْ مَصَائِبٍ بِعِبَادٍ","كُلُّهَا فِي القُلُوبِ نَادَتْ سِقَامَا",53,"م",2,0],["قل في الناس من له فضله الجسم","وتلك النهى وذاك الخيم",54,"م",1,0]]}