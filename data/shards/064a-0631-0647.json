{"poems":[[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[74,"رب مليح بأسه فاتك","https://www.aldiwan.net/poem18259.html","السريع"],[2,"مرج الدين فأعددت له","https://www.aldiwan.net/poem25039.html","الرمل"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[103,"مَنْ مُجِيرِي مِنْ حالِكات اللّيالِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62416&r=&rc=8",""],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[458,"هتف العابثون بالسلم للسلم","https://www.aldiwan.net/poem61306.html","الخفيف"],[466,"ممدح غمر الرداء والشيم","https://www.aldiwan.net/poem16220.html","الرجز"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25319","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101626","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128952","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83528","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[6056,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=130142",""]],"verses":[["يَرهَبُ العاجِزُ مِن لُجَّتِهِ","فَيُدَعّي في مَبيتٍ وَمَحَل",0,"ل",1,0],["يرهِبَ قلب الليث يومَ الوغى","وهو غزال قلبه ما رَهَب",1,"ب",1,0],["يَرهَبُ السَوطَ سَريعاً فَإِذا","وَنَتِ الخَيلُ مِنَ الشَدِّ مَعَج",2,"ج",1,0],["يُرهَقُ القومُ فإن هم غضبوا","راحتِ الأرواحُ منهم تُخْتَرمْ",3,"م",1,0],["يُرْهِقُ الفِكْرُ بِهِ عُسْ","راً لا يُذْخَرُ عَزْمُ",4,"م",1,0],["يَرْهَبُ النُّورُ أنْ يمرَّ به مَرَّا","وتَخْشَى أذَاهُ ريحُ الشَّمَالِ",5,"ل",1,0],["يُرهِفُ الغربُ له مِسْمَعَهُ","سائلاً: هل كَذَبَتْهُ أُذناهْ؟",6,"ا",2,0],["يَرْهَبُ النُّورُ أنْ يمرَّ به مَ","رَّا وتَحْشَى أذَاهُ ريحُ الشَّمَال",7,"ل",1,0],["يَرهَبُون الدّجنَ إِن لاحَ بِهِ","بَارِقٌ وَالصُّبحَ إِذ مَا نَفّسَا",8,"س",2,0],["يرهقون الشعوب قتلا","وتعذيبا ويشكون أنها لا تنام",9,"م",1,0],["يرْهبُه الفقْرُ وتخْشاهُ الإِزَمْ","منْ تامِكٍ وذي سَنامينِ أحَمْ",10,"م",1,0],["يرهب في عرضة الملام ولا","يرهب يوماً في جسمه الألما",11,"م",2,0],["يُرْهِبُ زَأرِي كَلَبَاتِ النَبْحِ","وَالمُخدِراتِ في الإِجامِ المُلْحِ",12,"ح",1,0],["يرهب الموت أي نعم سوف يلقى","الآن أنت كما ترضى العلى رجلُ",13,"ل",1,0],["يرهق الدهر كل حرٍّ عليه","فهو فيه المسيح بين اليهود",14,"د",1,0],["يرهب البحر بأسهن فللموج","صراخ من خوفها ورنين",15,"ن",1,0],["يرهقه ضرباً بمنقاره","لم يخش من بأس ومن نكبة",16,"ه",1,0],["يُرهق الطَير ينعت الوَحش والصي","ران حَتّى تخرَّ لِلأَذقانِ",17,"ن",1,0],["يُرهِبُ الشَدَّ إِذا أَرهَقنَهُ","وَإِذا بَرَّزَ مِنهُنَّ رَبَع",18,"ع",1,0],["يرهب الموت معشرٌ هم بشر","منه طاحوا لكن بدون نياح",19,"ح",1,0],["يرهش مدد هشاله ابدون عاصوف","رأي النظر مابدل الشك بووكاد",20,"د",1,0],["يرهج على فرقاه في صدري ارهاج","وسط القفص سوات طير ٍسجيني",21,"ن",2,0]]}