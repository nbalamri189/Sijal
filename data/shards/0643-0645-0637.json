وديه"],[113,"بالله ياحبا اضا","https://www.aldiwan.net/poem40892.html","عموديه"],[126,"أبلعرب الملك الهمام العادل","https://www.aldiwan.net/poem50543.html","الكامل"],[164,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[184,"يا أبا القاسم الأديب ويا من","https://www.aldiwan.net/poem44128.html","الخفيف"],[193,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[268,"أكلما البرق في الدجى لمعا","https://www.aldiwan.net/poem35195.html","المنسرح"],[268,"أيها النديم إذا","https://www.aldiwan.net/poem35289.html","المقتضب"],[301,"كم طمع لما اقتضاه الفتى","https://www.aldiwan.net/poem58235.html","السريع"],[326,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[362,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[362,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[362,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[362,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[390,"يا زائرا سائرا إلى الكوفه","https://www.aldiwan.net/poem53676.html","المنسرح"],[397,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[400,"لله درك يا ابن إسماعيلا","https://www.aldiwan.net/poem33595.html","الكامل"],[400,"أخبرونا تفضلا ما الذي كان","https://www.aldiwan.net/poem33912.html","الخفيف"],[403,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[413,"هنيت هنيت بالعيد السعيد فقد","https://www.aldiwan.net/poem53830.html","البسيط"],[413,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[413,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[456,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[459,"إني ومن أكرموا لزيهم","https://www.aldiwan.net/poem16055.html","المنسرح"],[462,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[498,"ما رده الباغي إذا ردت به","https://www.aldiwan.net/poem38052.html","الكامل"],[513,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[549,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[549,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[551,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[556,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"]],"verses":[["كَم طَوى بِالرَدى صَفي","ياً لِقَلبي مُصافِيا",0,"ي",2,0],["كَم طارَ في مُلكِكَ ذو نَخوَةٍ","قالَت لَهُ ريحُ المَنايا قِعِ",1,"ع",1,0],["كَم طَوى المَوتُ لَهُم مِن بَهمَةٍ","خائِضِ الغَمرَةِ فَرّاجِ الضَغَط",2,"ط",1,0],["كَمُطيفِ الدَوّارِ حَتّى إِذا ما","ساطِعُ الفَجرِ نَبَّهَ العُصفورا",3,"ر",2,0],["كَم طَعنَةٍ أَنهرها حدُّهُ","نافِذَةٍ تُنظمُ فيها الكُلى",4,"ل",2,1],["كَم طَريدٍ قَد سَكَّنَ الجَأشَ مِنهُ","كانَ يَدعو بِصَفِّهِنَّ صُراحا",5,"ح",2,0],["كَمْ طِيَّةٍ فِيهَا بَرَى مِنْكَ الْحَشَا","سُقْمٌ وَبَرَّحَ بِاللَّهَاةِ أُوَامُ",6,"م",1,0],["كم طَوَينا من قبلُ في طلب العل","م فجاجاً وكم شَقَقْنا بحارا",7,"ر",2,0],["كم طائر أغفلته حتى جدف","أحسنُ ما هرَّ به سوءُ العلف",8,"ف",1,0],["كَمْ طَرَباتٍ أَفْسَدْتَهُنَّ وكَمْ","صَفْوَةِ عَيْشٍ غَادَرْتَها كَدرَهْ",9,"ر",2,0],["كَمطعمَةِ الزهّادِ مِن كَدِّ فَرجِها","لَها الوَيلُ لا تَزني وَلا تَتَصَدَّقي",10,"ي",1,0],["كَم طالِبٍ عَفواً وَلَيسَ بِمُذنِبٍ","وَمُقَدَّمٍ عُذراً وَليسَ بِهافِ",11,"ف",1,0],["كم طريدٍ مُستقِرٍّ عندهُ","من حَرُورِ الخوْفِ في ظلّ أمان",12,"ن",1,0],["كم طامحِ الألحاظِ نَحْوَ العُلَى","إذا رآهُ غَضَّ لحظَ الطّماح",13,"ح",1,0],["كمْ طامعٍ مِنْ دهرِهِ بالصفا","والدهرُ لا يصفو لمخلوقِ",14,"ق",1,0],["كَم طابِخاً قِدراً لِئاكِلِهِ","فاضَت عَلَيهِ بِفاتِرٍ سُخنِ",15,"ن",1,0],["كَم طائِرٍ أَردى وَكَم سَيُردي","بِالجَمزِ وَالقَفزِ وَصَفقِ الجِلدِ",16,"د",1,0],["كم طرت بي واجتزت سور الضباب","والضوء ملء القلب مِلء الرحاب",17,"ب",1,0],["كَم طَوى البُؤسُ نُفوساً لَو رَعَت","مَنبِتاً خِصباً لَكانَت جَوهَرا",18,"ر",2,0],["كم طوَّقَتْ منكِ القُدودَ سواعدي","ولكم شفاني من جَناكِ طعام",19,"م",1,0],["كم طفلةٍ أودعَ من هرةٍ","حوَّلها الجوعُ إلى مارد!",20,"د",1,0],["كمطعمة الزهاد من كدِّ فرجها","لَكِ الوَيْلُ ، لا تَزْنِي ، ولا تَتَصَدَّقي",21,"ي",1,0],["كم طائراً أغفلتَه حتى جَدفْ","أحسنُ ماهر به سوءُ العلف",22,"ف",1,0],["كم طرفه ادمى","فؤاد مضناه",23,"ا",2,0],["كم طرحنا جبهات","بثراها وشفاها",24,"ا",3,0],["كم طود بهتان بنا","سمة الحقيقة قد نسف",25,"ف",1,0],["كم طوقتْ نُعْمَاك أعناقَ الوَرَى","وسرتْ إليهم مِن لدُنك وَسَائِلُ",26,"ل",1,0],["كم طافَ بي طيفُها والأفقُ مُستْترٌ","بذيلِ سِجفٍ منَ الظلماءِ مُنْسدِلِ",27,"ل",1,0],["كم طبيب يحمي مريضا فأعدا","ه اكتئابا تعجرفُ المطلوب",28,"ب",1,0],["كَمُطَرَّدٍ صَحلٍ يُقَلِّبُ عانَةً","فيها لَواقِحُ كَالقِسِيِّ وَحولُ",29,"ل",1,0],["كم طائرٍ إلفُهُ عليهِ بكى","وكم غريبٍ نأى وما رجِعا",30,"ع",2,0],["كم طَفا على حَبَبٍ","ياسمينُ رَوضِكِ ذا",31,"ذ",2,0],["كم طمع لما اقتضاه الفتى","أزرى وما شد له أزرا",32,"ر",2,1],["كم طوينا الضفاف وهنانة الرم","ل نهزّ الضفاف بالخطرات",33,"ت",1,0],["كم طوَتْ ما طَوتْ بيَ الأرضُ حتّى","بَلّغتْني ذُراه حَرْفٌ أَمون",34,"ن",1,0],["كمَطارِ دينارٍ نفَتْه أكُفُّهِمْ","صُعُداً فحَلّق ثُمّ جَدَّ نُزولا",35,"ل",2,0],["كم طارقينَ وما طَريقُ فتىً إلى","ناديهِ يومَ نَداهُ بالمَسْدود",36,"د",1,0],["كم طُلْتِ لي فَذُمِمِت في زمنِ النّوى","يا ليلتي فالآن طُولي تُحْمَدي",37,"د",2,0],["كم طعنةٍ نَجْلاءَ تَعرِضُ بالحِمىَ","من دون نَظْرةِ مُقلةٍ نَجْلاء",38,"ا",2,0],["كَم طاوَلوه فَرَدَّ أَيدِيَهُم","مَغلولَةً بِالصَغارِ مَكتوفَه",39,"ف",2,0],["كم طوينا من مسافات طوال","وتجاوزنا سهولا وجبالا",40,"ل",2,0],["كم طالب أعطيته مطلوبه","وكفيته في غيرك التأميلا",41,"ل",2,0],["كم طوينا من مَهْمَهٍ وجبال","عجزت عن صعودها الأطيار",42,"ر",1,0],["كَم طرزت أَرض العَدوِّ دَماً إِذا","طرزَت طرسك نَحوَهُم بِمدادِهِ",43,"د",2,0],["كم طاولتك إلى نيل العلاء يدٌ","فقصّرت عن مدى علياك تقصيرا",44,"ر",2,0],["كم طعينٍ بقوامِ أهْيَفٍ","هو لم يشهد طعاناً ونزالا",45,"ل",2,0],["كم طائل قصَّر عن شأوه","ولاحقٍ ما شقَّ منه الغبار",46,"ر",1,0],["كم طالعٍ فيكِ لولا أنه قمرٌ","لم يبدُ ليلا وتحتَ الصبح يكتَتِمُ",47,"م",1,0],["كمْ طيْلسانٍ هزَمْتُ حاملَهُ","في يلْمَقٍ حين أشْكلَ الكَلِمُ",48,"م",1,0],["كم طعنةٍ لك فيصلٍ حمدت","آثارها ومقالةٍ فصل",49,"ل",1,0],["كمْ طائرٍ طلبَ العُلى حطَّتْ به","ضمنَ الحَضيضِ بغيرِ قصدٍ نهضتُهْ",50,"ت",2,0],["كم طرقت سمعك من رجفة","تقصر باع الأمل الطائل",51,"ل",1,0],["كم طالبٍ ما لا يُنال وراكبٍ","من سيّئٍ ما لا يُقال زَليلُهُ",52,"ل",2,0],["كَم طامِعٍ مِن غَيرِكمْ في نيلها","فَرَقتْ مفارِقَه السّيوف الوُثَّبُ",53,"ب",1,0],["كَم طائِرٍ صُدَّ عنهُ","وَنالهُ مَن يدُبُّ",54,"ب",1,0],["كَم طَعنَةٍ لَكَ في الأَعداءِ مُهلِكَةٍ","نَجلاءَ تُعجِلُهُم عَن نَفثِ راقيها",55,"ي",3,0],["كم طاف بي علْمٌ وجا","ء مقبِّلاً حجر اللسان",56,"ن",1,0]]}