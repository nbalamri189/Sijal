شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214369",""],[6070,"أيام عمرك","https://www.poetsgate.com/ViewPoem.aspx?id=187805",""],[6093,"كلالة","https://www.poetsgate.com/ViewPoem.aspx?id=203986",""],[199,"أطربتَ أمْ رفعتْ لعينك غدوة ً","https://www.poetsgate.com/ViewPoem.aspx?id=22431",""],[5309,"ألورى في الأرض مثل العنكبوت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573845",""],[3941,"إلى الفلك لما ارفض ذيالك الحشد","https://diwany.org/%D8%A5%D9%84%D9%89-%D8%A7%D9%84%D9%81%D9%84%D9%83-%D9%84%D9%85%D8%A7-%D8%A7%D8%B1%D9%81%D8%B6-%D8%B0%D9%8A%D8%A7%D9%84%D9%83-%D8%A7%D9%84%D8%AD%D8%B4%D8%AF/","الطويل"],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6251,"أنتَ الأمَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76468&r=&rc=8",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["كَم طَوى بِالرَدى صَفي","ياً لِقَلبي مُصافِيا",0,"ي",2,0],["كَم طارَ في مُلكِكَ ذو نَخوَةٍ","قالَت لَهُ ريحُ المَنايا قِعِ",1,"ع",1,0],["كَم طَوى المَوتُ لَهُم مِن بَهمَةٍ","خائِضِ الغَمرَةِ فَرّاجِ الضَغَط",2,"ط",1,0],["كَمُطيفِ الدَوّارِ حَتّى إِذا ما","ساطِعُ الفَجرِ نَبَّهَ العُصفورا",3,"ر",2,0],["كَم طَعنَةٍ أَنهرها حدُّهُ","نافِذَةٍ تُنظمُ فيها الكُلى",4,"ل",2,1],["كَم طَريدٍ قَد سَكَّنَ الجَأشَ مِنهُ","كانَ يَدعو بِصَفِّهِنَّ صُراحا",5,"ح",2,0],["كَمْ طِيَّةٍ فِيهَا بَرَى مِنْكَ الْحَشَا","سُقْمٌ وَبَرَّحَ بِاللَّهَاةِ أُوَامُ",6,"م",1,0],["كم طَوَينا من قبلُ في طلب العل","م فجاجاً وكم شَقَقْنا بحارا",7,"ر",2,0],["كم طائر أغفلته حتى جدف","أحسنُ ما هرَّ به سوءُ العلف",8,"ف",1,0],["كَمْ طَرَباتٍ أَفْسَدْتَهُنَّ وكَمْ","صَفْوَةِ عَيْشٍ غَادَرْتَها كَدرَهْ",9,"ر",2,0],["كَمطعمَةِ الزهّادِ مِن كَدِّ فَرجِها","لَها الوَيلُ لا تَزني وَلا تَتَصَدَّقي",10,"ي",1,0],["كَم طالِبٍ عَفواً وَلَيسَ بِمُذنِبٍ","وَمُقَدَّمٍ عُذراً وَليسَ بِهافِ",11,"ف",1,0],["كم طريدٍ مُستقِرٍّ عندهُ","من حَرُورِ الخوْفِ في ظلّ أمان",12,"ن",1,0],["كم طامحِ الألحاظِ نَحْوَ العُلَى","إذا رآهُ غَضَّ لحظَ الطّماح",13,"ح",1,0],["كمْ طامعٍ مِنْ دهرِهِ بالصفا","والدهرُ لا يصفو لمخلوقِ",14,"ق",1,0],["كَم طابِخاً قِدراً لِئاكِلِهِ","فاضَت عَلَيهِ بِفاتِرٍ سُخنِ",15,"ن",1,0],["كَم طائِرٍ أَردى وَكَم سَيُردي","بِالجَمزِ وَالقَفزِ وَصَفقِ الجِلدِ",16,"د",1,0],["كم طرت بي واجتزت سور الضباب","والضوء ملء القلب مِلء الرحاب",17,"ب",1,0],["كَم طَوى البُؤسُ نُفوساً لَو رَعَت","مَنبِتاً خِصباً لَكانَت جَوهَرا",18,"ر",2,0],["كم طوَّقَتْ منكِ القُدودَ سواعدي","ولكم شفاني من جَناكِ طعام",19,"م",1,0],["كم طفلةٍ أودعَ من هرةٍ","حوَّلها الجوعُ إلى مارد!",20,"د",1,0],["كمطعمة الزهاد من كدِّ فرجها","لَكِ الوَيْلُ ، لا تَزْنِي ، ولا تَتَصَدَّقي",21,"ي",1,0],["كم طائراً أغفلتَه حتى جَدفْ","أحسنُ ماهر به سوءُ العلف",22,"ف",1,0],["كم طرفه ادمى","فؤاد مضناه",23,"ا",2,0],["كم طرحنا جبهات","بثراها وشفاها",24,"ا",3,0],["كم طود بهتان بنا","سمة الحقيقة قد نسف",25,"ف",1,0],["كم طوقتْ نُعْمَاك أعناقَ الوَرَى","وسرتْ إليهم مِن لدُنك وَسَائِلُ",26,"ل",1,0],["كم طافَ بي طيفُها والأفقُ مُستْترٌ","بذيلِ سِجفٍ منَ الظلماءِ مُنْسدِلِ",27,"ل",1,0],["كم طبيب يحمي مريضا فأعدا","ه اكتئابا تعجرفُ المطلوب",28,"ب",1,0],["كَمُطَرَّدٍ صَحلٍ يُقَلِّبُ عانَةً","فيها لَواقِحُ كَالقِسِيِّ وَحولُ",29,"ل",1,0],["كم طائرٍ إلفُهُ عليهِ بكى","وكم غريبٍ نأى وما رجِعا",30,"ع",2,0],["كم طَفا على حَبَبٍ","ياسمينُ رَوضِكِ ذا",31,"ذ",2,0],["كم طمع لما اقتضاه الفتى","أزرى وما شد له أزرا",32,"ر",2,1],["كم طوينا الضفاف وهنانة الرم","ل نهزّ الضفاف بالخطرات",33,"ت",1,0],["كم طوَتْ ما طَوتْ بيَ الأرضُ حتّى","بَلّغتْني ذُراه حَرْفٌ أَمون",34,"ن",1,0],["كمَطارِ دينارٍ نفَتْه أكُفُّهِمْ","صُعُداً فحَلّق ثُمّ جَدَّ نُزولا",35,"ل",2,0],["كم طارقينَ وما طَريقُ فتىً إلى","ناديهِ يومَ نَداهُ بالمَسْدود",36,"د",1,0],["كم طُلْتِ لي فَذُمِمِت في زمنِ النّوى","يا ليلتي فالآن طُولي تُحْمَدي",37,"د",2,0],["كم طعنةٍ نَجْلاءَ تَعرِضُ بالحِمىَ","من دون نَظْرةِ مُقلةٍ نَجْلاء",38,"ا",2,0],["كَم طاوَلوه فَرَدَّ أَيدِيَهُم","مَغلولَةً بِالصَغارِ مَكتوفَه",39,"ف",2,0],["كم طوينا من مسافات طوال","وتجاوزنا سهولا وجبالا",40,"ل",2,0],["كم طالب أعطيته مطلوبه","وكفيته في غيرك التأميلا",41,"ل",2,0],["كم طوينا من مَهْمَهٍ وجبال","عجزت عن صعودها الأطيار",42,"ر",1,0],["كَم طرزت أَرض العَدوِّ دَماً إِذا","طرزَت طرسك نَحوَهُم بِمدادِهِ",43,"د",2,0],["كم طاولتك إلى نيل العلاء يدٌ","فقصّرت عن مدى علياك تقصيرا",44,"ر",2,0],["كم طعينٍ بقوامِ أهْيَفٍ","هو لم يشهد طعاناً ونزالا",45,"ل",2,0],["كم طائل قصَّر عن شأوه","ولاحقٍ ما شقَّ منه الغبار",46,"ر",1,0],["كم طالعٍ فيكِ لولا أنه قمرٌ","لم يبدُ ليلا وتحتَ الصبح يكتَتِمُ",47,"م",1,0],["كمْ طيْلسانٍ هزَمْتُ حاملَهُ","في يلْمَقٍ حين أشْكلَ الكَلِمُ",48,"م",1,0],["كم طعنةٍ لك فيصلٍ حمدت","آثارها ومقالةٍ فصل",49,"ل",1,0],["كَم طُمأنينَةٍ عَواذِلُنا","وَأدوها في بَعض ِ ما وَأدوا",50,"د",3,0],["كمْ طائرٍ طلبَ العُلى حطَّتْ به","ضمنَ الحَضيضِ بغيرِ قصدٍ نهضتُهْ",51,"ت",2,0],["كم طرقت سمعك من رجفة","تقصر باع الأمل الطائل",52,"ل",1,0],["كم طالبٍ ما لا يُنال وراكبٍ","من سيّئٍ ما لا يُقال زَليلُهُ",53,"ل",2,0],["كَم طامِعٍ مِن غَيرِكمْ في نيلها","فَرَقتْ مفارِقَه السّيوف الوُثَّبُ",54,"ب",1,0],["كَم طائِرٍ صُدَّ عنهُ","وَنالهُ مَن يدُبُّ",55,"ب",1,0],["كَم طَعنَةٍ لَكَ في الأَعداءِ مُهلِكَةٍ","نَجلاءَ تُعجِلُهُم عَن نَفثِ راقيها",56,"ي",3,0],["كم طاف بي علْمٌ وجا","ء مقبِّلاً حجر اللسان",57,"ن",1,0],["كم طَبّبت مرضى وكم قد اطعمت","بؤسا فاُشبع جائع ويتيم",58,"م",1,0],["كم طالب للعلم فيه وطالب","للمال تم لذا وذا ما يطلب",59,"ب",1,0],["كم طامعٍ بعلاه قب","لك طال بالباع القصير",60,"ر",1,0],["كَم طارَ في الجَوِّ مِنها كافِرٌ أشِر","وَكَم تَمزَّقَ مَلعونٌ وَمَبهولُ",61,"ل",1,0],["كم طاش سَهْمُ مُراميه وبات له","طَيْشُ الفَراشة طارَتْ لَيْلَة السَّذَقِ",62,"ق",1,0],["كم طالب للمجد قصَّر ثم ملّ","ومُعاودٌ بالصبر قد بلغ الأمل",63,"ل",1,1],["كم طالبٍ ليسَ له مسعد","ومبتل ليس لهُ ناصر",64,"ر",1,0],["كم طارق ناداه عَرْفُ سمائها","طوبى إليها والسما والطارق",65,"ق",1,0],["كم طعنةٍ من لحظها","في العاشقين مضت جُبَارْ",66,"ر",1,0],["كم طريد أوى بوسع محل","كم فقير أغنى بفاضل زاد",67,"د",1,0],["كم طار منه حتفه يوم الوغى","بطل فنادى ذو الفقار به قع",68,"ع",1,0],["كَم طابَ لي فيكِ المَقام وَكَم صَفا","عَيشي بِربعكِ حَيثُ راقَ زَماني",69,"ن",2,0],["كم طاولتك السحب وكفا وانثنت","حمرا وكان البرق صبغ حياها",70,"ا",3,0],["كم طعنة لسنانه ولسانه","حب الحشا نظمت بسلك اللهذم",71,"م",1,0],["كم طلعة لك يا هلال محرم","قد غيبت وجه السرور بمأتم",72,"م",1,1],["كم طوت مهجتي على كشح لبي","من وداد لكم قديم عتيد",73,"د",1,0],["كَم طَافَ حَولَكَ مِن حَافٍ وَمُنتَعِل","بَادوا وَأَنتَ حَبِيسُ الدَّهرِ لَم تَرمِ",74,"م",1,0],["كم طوى البيدَ باسطاً كفَّ جودٍ","نشرت مَيّتَ الندى المقبورا",75,"ر",2,0],["كم طَاوَلُوهُ في الفِخارِ فَفاقَهُم","عَرضاً إلى المجدِ التَليدِ وطُولا",76,"ل",2,0],["كَم طَوَيتُ الظَلامَ سُهداً إِلى أَن","غارَتِ الشُهب فَرقَداً بَعدَ فَرقَد",77,"د",1,0],["كَم طَوَّحَت بِفَتىً مِثلي وَكَم طَرَحَت","كُؤوسها في حَنايا السِجنِ مِن نَفَرِ",78,"ر",1,0],["كم طوى فيها الطَّوى من مُهجة","فَجَلاها للمنَايا واللّحَد",79,"د",1,0],["كم طرفك المطروف","يرعى النائمين ويسهر",80,"ر",1,0],["كم طول اللّيل باقايس","من اصنوف الحبّ وخطوره",81,"ر",2,0],["كَم طَعنَةٍ لَكَ لَم يُفلِتكَ صاحِبُها","إِلّا وَفَقحتَهُ مَخضوبَةٌ بِدَمِ",82,"م",1,0],["كَم طَعينٍ بِالكَأسِ يَنظُرُ لِلشُه","بِ حَزينا وأَينَ مِنها الشفاءُ",83,"ا",2,0],["كم طاعةٍ بنيتُها فى نَظَرى","وحالةٍ شَيَّدتُها فى خَبَرى",84,"ر",2,0],["كم طل فيها دما حراما","أباح قاضي العيون هدره",85,"ر",2,0],["كم طرتُ فى ظلِّها لم أقترب أدباً","من الفروعِ وأدَّى حاجتِى النَّغم",86,"م",1,0],["كم طفلة حسنا غذتها نعمة","في أشرف الآباء والأمات",87,"ت",1,0],["كم طامح طمحت في الجور همته","قد أقعدوه فأضحى خدنه الفشل",88,"ل",1,0],["كم طفت في الأرض أو كتاب","تستكشف الحسن والبهاء",89,"ا",2,0],["كم طائر وهو غر قد سما خلقا","ووحش باز على الأعقاب منتكص",90,"ص",1,0],["كم طالبت تنفيذها وأنا","أبدا أماطلها أصَبّرها",91,"ر",3,0],["كم طعنةٍ في اثنين قد نفذت له","سلكَى فخاطت أولاً بالآخر",92,"ر",1,0],["كم طوّفت كم وقّفت","ومقيمة ومسافرة",93,"ه",1,0],["كم طؤطئت هام لديك لمعشر","تلوا جبينهم لديك سجودا",94,"د",2,0],["كم طفلة في الدمّ مالت تشتكي","تلوي بكفّيها لمن لا يرحمُ",95,"م",1,0],["كم طالبٍ للعلم طار يمينه","وبها كتاب الدرس لوّثه الدمُ",95,"م",1,0],["كم طاح بالقبطيّ وقع نبا