{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[71,"كم طعنة أنهرها حده","https://www.aldiwan.net/poem3841.html","السريع"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[88,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[51,"يا ابن أبي الجهم احتقب هذا اللطف","https://www.aldiwan.net/poem65467.html","الرجز"],[56,"مولاتنا يا غلام مبتكره","https://www.aldiwan.net/poem58590.html","المنسرح"],[58,"سمعتك تبني مسجدا من خيانة","https://www.aldiwan.net/poem30949.html","الطويل"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[69,"مواعظ الدهر لأبنائه","https://www.aldiwan.net/poem28025.html","السريع"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[48,"أنعت ديكا من ديوك الهند أحسن","https://www.aldiwan.net/poem63253.html","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[58,"سَمِعْتُك تَبْنِي مَسْجِدا مِنْ خِيَانَة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22719",""],[51,"يا ابن أبي الجهم احتقبْ هذا اللَّطفْ","https://www.poetsgate.com/ViewPoem.aspx?id=29582",""]],"verses":[["كَم طَوى بِالرَدى صَفي","ياً لِقَلبي مُصافِيا",0,"ي",2,0],["كَم طارَ في مُلكِكَ ذو نَخوَةٍ","قالَت لَهُ ريحُ المَنايا قِعِ",1,"ع",1,0],["كَم طَوى المَوتُ لَهُم مِن بَهمَةٍ","خائِضِ الغَمرَةِ فَرّاجِ الضَغَط",2,"ط",1,0],["كَمُطيفِ الدَوّارِ حَتّى إِذا ما","ساطِعُ الفَجرِ نَبَّهَ العُصفورا",3,"ر",2,0],["كَم طَعنَةٍ أَنهرها حدُّهُ","نافِذَةٍ تُنظمُ فيها الكُلى",4,"ل",2,1],["كَم طَريدٍ قَد سَكَّنَ الجَأشَ مِنهُ","كانَ يَدعو بِصَفِّهِنَّ صُراحا",5,"ح",2,0],["كَمْ طِيَّةٍ فِيهَا بَرَى مِنْكَ الْحَشَا","سُقْمٌ وَبَرَّحَ بِاللَّهَاةِ أُوَامُ",6,"م",1,0],["كم طَوَينا من قبلُ في طلب العل","م فجاجاً وكم شَقَقْنا بحارا",7,"ر",2,0],["كم طائر أغفلته حتى جدف","أحسنُ ما هرَّ به سوءُ العلف",8,"ف",1,0],["كَمْ طَرَباتٍ أَفْسَدْتَهُنَّ وكَمْ","صَفْوَةِ عَيْشٍ غَادَرْتَها كَدرَهْ",9,"ر",2,0],["كَمطعمَةِ الزهّادِ مِن كَدِّ فَرجِها","لَها الوَيلُ لا تَزني وَلا تَتَصَدَّقي",10,"ي",1,0],["كَم طالِبٍ عَفواً وَلَيسَ بِمُذنِبٍ","وَمُقَدَّمٍ عُذراً وَليسَ بِهافِ",11,"ف",1,0],["كم طريدٍ مُستقِرٍّ عندهُ","من حَرُورِ الخوْفِ في ظلّ أمان",12,"ن",1,0],["كم طامحِ الألحاظِ نَحْوَ العُلَى","إذا رآهُ غَضَّ لحظَ الطّماح",13,"ح",1,0],["كمْ طامعٍ مِنْ دهرِهِ بالصفا","والدهرُ لا يصفو لمخلوقِ",14,"ق",1,0],["كَم طابِخاً قِدراً لِئاكِلِهِ","فاضَت عَلَيهِ بِفاتِرٍ سُخنِ",15,"ن",1,0],["كَم طائِرٍ أَردى وَكَم سَيُردي","بِالجَمزِ وَالقَفزِ وَصَفقِ الجِلدِ",16,"د",1,0],["كم طرت بي واجتزت سور الضباب","والضوء ملء القلب مِلء الرحاب",17,"ب",1,0],["كَم طَوى البُؤسُ نُفوساً لَو رَعَت","مَنبِتاً خِصباً لَكانَت جَوهَرا",18,"ر",2,0],["كم طوَّقَتْ منكِ القُدودَ سواعدي","ولكم شفاني من جَناكِ طعام",19,"م",1,0],["كم طفلةٍ أودعَ من هرةٍ","حوَّلها الجوعُ إلى مارد!",20,"د",1,0],["كمطعمة الزهاد من كدِّ فرجها","لَكِ الوَيْلُ ، لا تَزْنِي ، ولا تَتَصَدَّقي",21,"ي",1,0],["كم طائراً أغفلتَه حتى جَدفْ","أحسنُ ماهر به سوءُ العلف",22,"ف",1,0]]}