{"poems":[[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[90,"إذا شئت أن تسري بكافرة الصوى","https://www.aldiwan.net/poem44444.html","الطويل"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[47,"خيال يعتريني في المنام","https://www.aldiwan.net/poem65653.html","الوافر"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[46,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[22,"تعذر بعد عهدك من سليمى","https://www.aldiwan.net/poem21711.html","الوافر"],[54,"لما رأوها وعلونا نشزا","https://www.aldiwan.net/poem26929.html","الرجز"],[48,"أصحاب ليكة أهلكوا بظهيرة","https://www.aldiwan.net/poem22698.html","الكامل"],[48,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[154,"بدت لجفونك العبر","https://www.aldiwan.net/poem68498.html","مجزوء الرمل"],[190,"إذا هويَ الشيخ الفتاة فقد خطا","https://www.aldiwan.net/poem44156.html","المديد"],[216,"ونشوانة غيداء ظامية الحشا","https://www.aldiwan.net/poem37898.html","الطويل"],[230,"إذا فتح العداة عليك حربا","https://www.aldiwan.net/poem55187.html","الوافر"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[371,"الحسن جاد على الأحباب فازدادوا","https://www.aldiwan.net/poem17180.html","البسيط"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[409,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[422,"شامت البرق حين لاح مطي","https://www.aldiwan.net/poem53862.html","الخفيف"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[435,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83264","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83339","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145970","البسيط"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19934","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62673","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126180","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56184","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64949","الطويل"],[1272,"","https://poetry.dctabudhabi.ae/diwan/poem/73084","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64640","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50008","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122029","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21701","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127984","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77679","الطويل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89679","السريع"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105316","البسيط"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45408","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27868","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28006","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120991","الطويل"],[2719,"","https://poetry.dctabudhabi.ae/diwan/poem/144539","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130802",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112602","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140024","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112302","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102384","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45811","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2540","المتقارب"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138045","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199068","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97065","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81687","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133136","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133132","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124654","الطويل"],[4680,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=185023",""],[5013,"ألا أيها القلب الذي قاده الحب","https://www.poetsgate.com/ViewPoem.aspx?id=170960",""],[5106,"عُدتَ يَا أَيلُولُ مَا أَغرَاكَ فِينَ","https://www.poetsgate.com/ViewPoem.aspx?id=147586",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[5277,"هبني مناماً","https://www.poetsgate.com/ViewPoem.aspx?id=188572",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5431,"وقفة عزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=207555",""],[5736,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=208501",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"ترجوني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181967",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[5956,"تفانيتَ من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=194014",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""]],"verses":[["كَمَا هُوَ كَانَ وَ الدُّنْيَا شَبَابٌ","وَفِيه رَوَائِعُ الْحُسْنِ المُبِينِ",0,"ن",1,0],["كما هي ميزان لوزن رقيّهم","وديوان أخلاق لهم وعوائد",1,"د",1,0],["كم أَهَّةٍ لي قد تأوَّهْتُهَا","فيها ومن أُفٍّ تأففتها",2,"ت",3,0],["كُماةٌ مِن كُهولٍ أَو شَبابٍ","وَفَوضى مِن قُعودٍ أَو قِيامِ",3,"م",1,0],["كُماةٌ حُماةٌ في القِراعِ وَفي القِرى","إِذا شَطَّ قاريها وَطاشَ وَقورُها",4,"ر",3,0],["كُماةٌ إِذا ظَلَّ الكُماةُ بِمَعرِكٍ","وَأَرماحُهُم حُمرٌ وَأَلوانُهُم صُفرُ",5,"ر",1,0],["كَم أَهدَتِ الخَضراءُ في أَحمالِها","لِلأَرضِ مِن تُحَفٍ وَمِن أَلطافِ",6,"ف",1,0],["كُماةٌ إِذا تُدعى نَزالِ لَدى الوَغى","رَأَيتَهُمُ رَجلى كَأَنَّهُمُ رَكبُ",7,"ب",1,0],["كَما هَمَلت وَسالَ مِنَ الأَواتي","دُموعُ النِكسِ مِن وَشَلٍ مَعينِ",8,"ن",1,0],["كَما هاجَ الصَبابَةَ يَومَ مَرَّت","عَوامِدَ نَحوَ واقِصَةَ الحُمولُ",9,"ل",1,0],["كَما هَزَزتَ النَيزَكَ المُرتَزّا","يَحُزُّ أَعناقَ الرِياحِ حَزّا",10,"ز",2,0],["كَم أَهرَمَ الفَتَياتِ وَقتٌ ذاهِبٌ","وَالشَمسُ تَطلُعُ كَالفَتاةِ المُعصِرِ",11,"ر",1,0],["كُماةً إذا الأعرافُ كانتْ أعِنّةً","فمُغْنيهِمُ حُسْنُ الثّباتِ عنِ الحُزْمِ",12,"م",1,0],["كَما هناك أعاد","منهم تمادى الخصام",13,"م",1,0],["كماةٌ خيرة نجب","حماةٌ ذادةٌ صُبُرُ",14,"ر",1,0],["كما هو يهواها كذلك حظّها","هوى نافع عالي المناكب معجب",15,"ب",1,0],["كما هَطَلتْ كفُّ ابنِ سلطان بالندى","ويشكي الجَفَا منها طَرِيفٌ وتالِدُ",16,"د",1,0],["كما هرَبَ الفَتى الصَفاعُ يوما","أَمامَ الكاتبِ ابنِ الكاتِبينا",17,"ن",2,0],["كُماةُ نزالٍ تدَّري في ملاعبٍ","جَنايا المَنايا غير فاصمةٍ سِمطا",18,"ط",2,0],["كَما هُمُ بِكَ في دُنياكَ أَربَعَةٌ","راضٍ وَراجٍ وَقَوّامٌ وَسَجّادُ",19,"د",1,0],["كم آهة لي في هواه وأنةٍ","لو كان ينفعني عليه تأوّهي",20,"ه",2,0],["كما همَّ أقوام بخير الورى فلم","ينالوا سوى خزي ووِزرٍ على وزر",21,"ر",1,0],["كم أهاجَ القلوب منَّا وميضٍ","ثمَّ أدمى بعد القلوب العيونا",22,"ن",2,0],["كم أهاج الشوق من وجد بها","كلما جدَّدَه الذكر استجدا",23,"د",2,0],["كم أهل فضل بديع بالثنا نظموا","باب جودك من قبلي دواوينا",24,"ن",2,0],["كَما هامَ قَلبي بِالخَليلِ بنِ مِردَمِ","هُناكَ الهَوى العُذرِيُّ قَد صَحِبَ العُذرا",25,"ر",2,0],["كُماةٌ تَسبِقُ الأَرواحُ شَداً","سَوابِحُ تَحتَها الخَيلَ العُرابُ",26,"ب",1,0],["كما هو سر اللَه في كل مرسل","كذلك هم أسراره في الأئمة",27,"ه",1,0],["كما هوَ اللهُ نسْمو في محَبَتهِ","والمرءُ حُرٌ بها إذْ كيفَ يُبْدِيهَا",28,"ي",3,0],["كما هتنت طرفاء ناشت غصونها","جنوب وقد كانت من الليل طلت",29,"ت",1,0],["كُماة لا يهابون المنايا","بمخلبها رمتهم أو بضرسِ",30,"س",1,0],["كما هو في دستِ الخلافة مُستَو","وكلُّ رعاياه تُبين عَناها",31,"ا",3,0],["كما هدّ رزء مصطفى كامل العُلا","بمصر فعمت كل مصر مصائبُهْ",32,"ب",2,0],["كما هاجني تغريد قمري بأنه","تغنى فهز البان أعطافه سكرا",33,"ر",2,0],["كما هو شأن من يرعى","وذلك منك يكفينا",34,"ن",2,0],["كما هو المعهود للأشراف","أهل التقى والجود والعفاف",35,"ف",1,0],["كماة الحرب عند لقاه فرّت","كما فرّت من الليث الذيابُ",36,"ب",1,0],["كُماةً وَغىً لا يَضْعُفُ الْجارُ بَيْنهُمْ","مُقيماً ولا يَقْوى بهِ مَنْ يُقاوِمُ",37,"م",1,0],["كُماةٌ إِذا هَزّوا القَنا وَتَدَرَّعوا","تَثَنَّت عَلى غُدرانِها القُضُبُ المُلدُ",38,"د",1,0],["كما هما أو ما بيا فإن ترد","أسس فكالجزء الضمير قد عهد",39,"د",1,0],["كماة أباة الضيم شوس عوايس","إذا كرت الفرسان في رجل خرصان",40,"ن",1,0],["كماة حماة للذّمار تخالهم","ضراغمَ من خَفّان تحنو لأشبلِ",41,"ل",1,0],["كُمَاةٌ تَلاَقَتْ تَحْتَ نَقْعِ سُيُوفِهِمْ","وَلِلْهَامِ رَقْصٌ كُلَّمَا طُلِبَ الثَّارُ",42,"ر",1,1],["كَما هَزَّت المُرّانَ ريحٌ فَحَرَّكَت","أَعالِيَ مِنهُ واِرجَحَنَّت أَسافِلُه",43,"ل",2,0],["كماةُ حربٍ ترى في كلّ باديةٍ","قتلى بأسيافهم لم تحوها الرجم",44,"م",1,0],["كماةٌ تُلقَّبُ أرماحُهم","برضَّاعة الكبد الواغرِ",45,"ر",1,0],["كماةٌ تعدّ الحيَّ منها إذا انبرتْ","عن الطعنِ مَن كان الصريعَ المقطَّرا",46,"ر",2,0],["كما هو فيها من سرور وبهجة","وبشر وتفريح بكل صفاء",47,"ا",2,0],["كما هشت إلى المرعى سوام","تحد لها نصال الذابحينا",48,"ن",2,0],["كَما هَدَرَت وَسطَ القِلاص وَأَرسَلَت","شَقاشِقَها عِندَ الهِياج فُحولُ",49,"ل",1,0],["كَم اِهلَكت مَكَّة مِن زائِر","خَربها اللَهُ وَأَبياتَها",50,"ه",2,1],["كما هو روح لا يحيط به","وصف وهم ان تناهى وصفهم بدن",51,"ن",1,0],["كُماةٌ كُفاةٌ يَرهَبُ الناسُ حَدُّهُم","إِذا ما مَشوا في الحَربِ تَحسَبُهُم نَكبا",52,"ب",2,0],["كما هو إن نكرته وأزلته","عن الياءِ فأقصره تجدْه هو الله",53,"ل",2,0],["كما هو وتر للطلابِ بثاره","لكلِّ شريكٍ يدَِّعي أنه الله",53,"ل",2,0],["كما هو الطالبُ والمطلّبُ","كذا هو الذاهب والمذهب",54,"ب",1,0],["كما هو الأمر لكنَّ فيه ملحمةً","بين العقولِ فكُن بالشرعِ مُتحدا",55,"د",2,0],["كماة إذا هبّت رياح اعتزامهم","أثارت سحاب النقع بالدم ينهلّ",56,"ل",1,0],["كما هاهنا فاعلم إغاثة سائلٍ","وإسعاف ملهوفٍ وإغناء عائلِ",57,"ل",1,0],["كماة علتهم مسحة الجد والعلا","وسيماهم الاخلاص والشرف الاسنى",58,"ن",2,0],["كم أهدر