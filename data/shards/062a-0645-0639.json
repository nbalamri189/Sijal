{"poems":[[47,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[47,"بَرْقٌ أضَاءَ العَقيقُ منْ ضَرَمهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32046",""],[466,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122682","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62685","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109074","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27934","الطويل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[4755,"بِغَيرِ ما نَحتَاجُ يَأتِي الزَّمَانْ","https://www.poetsgate.com/ViewPoem.aspx?id=211919",""],[5644,"ثوري كبركانِ","https://www.poetsgate.com/ViewPoem.aspx?id=198592",""],[5962,"عيون مزون","https://www.poetsgate.com/ViewPoem.aspx?id=205880",""]],"verses":[["تَمَّ عَلى عَهدِهِ القَديمِ لَنا","وَالسَيلُ يَجري عَلى مَدى أَمَمِه",0,"م",2,0],["تَمّ على عَهْدِهِ القَدِيمِ لَنَا،","والسّيْلُ يَجرِي على مدى أَقَِمهْ",1,"م",2,0],["تمعجُ خيل الله في نقعها","بكل طافٍ في الوغى عائم",2,"م",1,0],["تَمَعَّنَ في تَغويرِهِ وَعُلُوةً","إلى أن هَوى ما بَينَ مِثل المَعارِف",3,"ف",1,0],["تم عيشي ببلوغ الأملِ","من مليح ذي صفات جُمَلِ",4,"ل",1,1],["تمعن السير كالشريد الطريد","ثم تمشي كموثق في قيود",5,"د",1,0],["تمعر منه الوجه والعجز قائمٌ","به ويراه اليثربي المكاشف",6,"ف",1,0],["تم على سريره عشر حجج","وتسعةً من الشهور ودَرَج",7,"ج",1,0],["تم على على السنان كريم ال","سبط كالبدر في ليالي التمام",8,"م",1,0],["تَمَعَّنِي يا حَربُ؛ هل يَستَوِي","تَرَنُّحُ المَذبُوحِ والبَهلَوَانْ؟!",9,"ن",1,0],["تَمَعَّنَت قَلَقًا فِي قَاعِ فنجاني","وحاولَت عَبَثًا تحدو بأحزَاني",10,"ن",2,1],["تمعن كل بصر في ماركة ساعه وطرز بشوت","حِلى طيب المعادن فانتظار انظار داهسها",11,"س",3,0]]}