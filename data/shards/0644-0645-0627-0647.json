{"poems":[[77,"أما قصورك كلما أنشأتها","https://www.aldiwan.net/poem35697.html","الكامل"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[91,"ذات شوك كالحراب أو كأظفار العقاب","https://www.aldiwan.net/poem8752.html","عموديه"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[102,"إن قلبي لبلادي","https://www.aldiwan.net/poem32953.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[135,"لم أهدكم هذي الرسالة آملا","https://www.aldiwan.net/poem49018.html","الكامل"],[143,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[195,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[254,"رددي بعدي وجيبي","https://www.aldiwan.net/poem24956.html","مجزوء الرمل"],[270,"لما هوى نجمي تذكرت الهوى","https://www.aldiwan.net/poem35211.html","الكامل"],[282,"عيناك بالنيران قلبي أصلتا","https://www.aldiwan.net/poem32844.html","الكامل"],[298,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[349,"ولو لم يعدني طيف لمياء في القلى","https://www.aldiwan.net/poem15745.html","الطويل"],[364,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[364,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[514,"إذا ذكرتك ولاح البدر لي حنيت","https://www.aldiwan.net/poem20926.html","المواليا"],[567,"يا أيها الصلف المدل بحسنه","https://www.aldiwan.net/poem69737.html","الكامل"],[575,"أي نجل بل أي نجم سعيد","https://www.aldiwan.net/poem2995.html","الخفيف"]],"verses":[["لم أهد بابك مرمري لكنه","ثغري أشرفه بلثم ثراك",0,"ك",1,0],["لم أهتضمْ دِيني ولم أنتهك","عرضي بما قلت ولم أدْنِس",1,"س",1,0],["لَم أَهَب كُلَّ الَّذي عِندي وَلَم يَفرَغ وِطابي","أَنا نَهرٌ لَم أُتَمِّم بَعدُ في الأَرضِ اِنسِيابي",2,"ي",1,0],["لما هَممْتَ بآثارٍ مجدَّدَةٍ","حدْوتَ للحاسِدِ الأحزانَ والكُرَبا",3,"ب",2,0],["لم أَهبْ غيظَ كريم","لا ولا كيْدَ لئيم",4,"م",1,0],["لمّا هَوى في الهَوى وَطاحا","وَقص منه النوى جناحا",5,"ح",2,1],["لما هوَتْ بغدادُ تحت خيولهم","وجرى الفراتُ دمًا صبيبًا مُهْرَقَا",6,"ق",2,0],["لم أهدكم هذي الرسالة آملاً","ذكرى الجواب فقد علمت وفاته",7,"ه",1,1],["لَمّا هَجَرتُ إِلى جَنابِكَ مَضجَعي","ما كُنتَ في فِعلِ الجَميلِ مُضَجَّعا",8,"ع",2,0],["لَمّا هَبَطنَ لِعَرعَرٍ وَتَقاذَفَت","مِنهُ بِهِنَّ حُزونُهُ وَسُهولُ",9,"ل",1,0],["لِمَ أهلي، ثم صحبي","صِرْتُ فيهم كالمعيبِ؟",10,"ب",1,0],["لما هوى نجمي تذكَّرتُ الهوى","ونشرتُ من ماضي شبابي ما انطوى",11,"و",2,1],["لَم أَهوَهُم أَبَداً بِبُغضي غَيرهم","كُلّاً وَمَن فَرَضَ الصَلاةَ وَوَقَّتا",12,"ت",2,0],["لمّا هوتْ نحوه شبّتْ به شعلٌ","ما بين مسبحِ أَسماكٍ وَأفلاك",13,"ك",1,0],["لَمّا هَدَيتُ نَفسي إِلَيها وَلا سَرَت","مِنَ المَسجِدِ الأَدنى إِلى المسجِدِ الأَقصى",14,"ص",2,0],["لمّا همَمْتُ بنَظْمٍ ما دَرى قَلَمي","في الكَفِّ ماذا على القِرطاسِ أُمْليه",15,"ي",2,0],["لمّا هزَزْتَ إليّ العِطْفَ مكرمةً","والحُرُّ مُقتنَصٌ بالوُدِّ واللُّطُف",16,"ف",1,0],["لما هويتك وحبك بالحشا كتبت","خوف الفضيحة عن اسمك بالبدر كنيت",17,"ت",1,0],["لم أُهْدِهِ لك يا مُناي وإنَّما","أهديتُهُ متقرِّباً للعُودِ",18,"د",1,0],["لم أُهَنِّئْ به سِوَايَ فإِني","أَنا أَولَى بأَن أُهَنَّأَ فِيه",19,"ي",2,0]]}