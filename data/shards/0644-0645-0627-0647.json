{"poems":[[79,"أما قصورك كلما أنشأتها","https://www.aldiwan.net/poem35697.html","الكامل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[93,"ذات شوك كالحراب أو كأظفار العقاب","https://www.aldiwan.net/poem8752.html","عموديه"],[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[104,"إن قلبي لبلادي","https://www.aldiwan.net/poem32953.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[108,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[139,"لم أهدكم هذي الرسالة آملا","https://www.aldiwan.net/poem49018.html","الكامل"],[147,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[259,"رددي بعدي وجيبي","https://www.aldiwan.net/poem24956.html","مجزوء الرمل"],[275,"لما هوى نجمي تذكرت الهوى","https://www.aldiwan.net/poem35211.html","الكامل"],[287,"عيناك بالنيران قلبي أصلتا","https://www.aldiwan.net/poem32844.html","الكامل"],[303,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[354,"ولو لم يعدني طيف لمياء في القلى","https://www.aldiwan.net/poem15745.html","الطويل"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[519,"إذا ذكرتك ولاح البدر لي حنيت","https://www.aldiwan.net/poem20926.html","المواليا"],[572,"يا أيها الصلف المدل بحسنه","https://www.aldiwan.net/poem69737.html","الكامل"],[580,"أي نجل بل أي نجم سعيد","https://www.aldiwan.net/poem2995.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126845","السريع"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76562","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38747","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37767","الكامل"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/107039","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82246","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120084","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59305","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80252","الطويل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117074","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126177","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47534","الكامل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82314","السريع"],[1531,"","https://poetry.dctabudhabi.ae/diwan/poem/99867","المتقارب"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66316","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93781","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199915","الكامل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126535","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100854","الكامل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76540","المتقارب"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121328","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138624",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86509","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127317","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90923","السلسلة"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90747","السلسلة"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117234","الكامل"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116092","المجتث"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119585","السريع"],[4811,"زهراء","https://www.poetsgate.com/ViewPoem.aspx?id=198695",""],[4859,"لو كنت تعلم!","https://www.poetsgate.com/ViewPoem.aspx?id=187836",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[5431,"وحفظت نفسي من هبوب الزوبعة ..","https://www.poetsgate.com/ViewPoem.aspx?id=191972",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5457,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213104",""],[5530,"ترتيلةٌ على حدّ المُحال","https://www.poetsgate.com/ViewPoem.aspx?id=197855",""],[5956,"يقول المحروم","https://www.poetsgate.com/ViewPoem.aspx?id=194109",""],[6035,"كارِهة.. ! .","https://www.poetsgate.com/ViewPoem.aspx?id=174226",""],[6043,"رسالة مُغلَّفة","https://www.poetsgate.com/ViewPoem.aspx?id=213365",""],[6125,"عَامَانِ مُذْ أشعَلتِ فيَّ صَبَابةً","https://www.poetsgate.com/ViewPoem.aspx?id=210569",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6185,"موّالُ خاشع !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86945&r=&rc=5",""],[6238,"غِيضَ الكَلامُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86771&r=&rc=0",""]],"verses":[["لم أهد بابك مرمري لكنه","ثغري أشرفه بلثم ثراك",0,"ك",1,0],["لم أهتضمْ دِيني ولم أنتهك","عرضي بما قلت ولم أدْنِس",1,"س",1,0],["لَم أَهَب كُلَّ الَّذي عِندي وَلَم يَفرَغ وِطابي","أَنا نَهرٌ لَم أُتَمِّم بَعدُ في الأَرضِ اِنسِيابي",2,"ب",2,0],["لما هَممْتَ بآثارٍ مجدَّدَةٍ","حدْوتَ للحاسِدِ الأحزانَ والكُرَبا",3,"ب",2,0],["لم أَهبْ غيظَ كريم","لا ولا كيْدَ لئيم",4,"م",1,0],["لمّا هَوى في الهَوى وَطاحا","وَقص منه النوى جناحا",5,"ح",2,1],["لما هوَتْ بغدادُ تحت خيولهم","وجرى الفراتُ دمًا صبيبًا مُهْرَقَا",6,"ق",2,0],["لم أهدكم هذي الرسالة آملاً","ذكرى الجواب فقد علمت وفاته",7,"ه",1,1],["لَمّا هَجَرتُ إِلى جَنابِكَ مَضجَعي","ما كُنتَ في فِعلِ الجَميلِ مُضَجَّعا",8,"ع",2,0],["لَمّا هَبَطنَ لِعَرعَرٍ وَتَقاذَفَت","مِنهُ بِهِنَّ حُزونُهُ وَسُهولُ",9,"ل",1,0],["لِمَ أهلي، ثم صحبي","صِرْتُ فيهم كالمعيبِ؟",10,"ب",1,0],["لما هوى نجمي تذكَّرتُ الهوى","ونشرتُ من ماضي شبابي ما انطوى",11,"و",2,1],["لَم أَهوَهُم أَبَداً بِبُغضي غَيرهم","كُلّاً وَمَن فَرَضَ الصَلاةَ وَوَقَّتا",12,"ت",2,0],["لمّا هوتْ نحوه شبّتْ به شعلٌ","ما بين مسبحِ أَسماكٍ وَأفلاك",13,"ك",1,0],["لَمّا هَدَيتُ نَفسي إِلَيها وَلا سَرَت","مِنَ المَسجِدِ الأَدنى إِلى المسجِدِ الأَقصى",14,"ص",2,0],["لمّا همَمْتُ بنَظْمٍ ما دَرى قَلَمي","في الكَفِّ ماذا على القِرطاسِ أُمْليه",15,"ي",2,0],["لمّا هزَزْتَ إليّ العِطْفَ مكرمةً","والحُرُّ مُقتنَصٌ بالوُدِّ واللُّطُف",16,"ف",1,0],["لما هويتك وحبك بالحشا كتبت","خوف الفضيحة عن اسمك بالبدر كنيت",17,"ت",1,0],["لم أُهْدِهِ لك يا مُناي وإنَّما","أهديتُهُ متقرِّباً للعُودِ",18,"د",1,0],["لم أُهَنِّئْ به سِوَايَ فإِني","أَنا أَولَى بأَن أُهَنَّأَ فِيه",19,"ي",2,0],["لمّا هوى منَ الهُدى كوكبٌ","قَد كانَ كالبدر بليلٍ بهيم",20,"م",1,0],["لم أهمل الكتمان لكن أدمعي","هملت ولو لم تعصني لم تهمُل",21,"ل",1,0],["لَماهُ لظَى الأَحشاءِ لا شَكَّ مُطفِئ","وَإِنّ حَياتي وَصلهُ وَاِقتِرابُهُ",22,"ب",2,1],["لَمّا هَوَيتُ لِكَي أُقَبِّله سَطا","بِحُسامِ لَحظٍ كادَ يَبدو مُعدِمي",23,"م",2,1],["لما هوى ركن الشريعة أرخوا","ندبت مدارسها لرزء القاسم",24,"م",1,0],["لَمّا هَوَت أَيدي الرِّجال بِهِ","في قَعرِ ذاتِ جَوانِبٍ غُبرِ",25,"ر",1,0],["لما هزمت مفاقري","باجش نائلك الهزيمِ",26,"م",1,0],["لَمْ أهَبْكَ الفُؤَادَ غَصْباً وَلَكِنْ","عَنْ طَوَاعِيَةٍ وَبِرَ وَجُودِ",27,"د",1,0],["لَمَا هَامَ قَلْبِي بِالْعَقِيقِ وَبَانِهِ","وَلاَ ضَلَّ طَرْفِي فِي الحِمَى وَزَرُودِهِ",28,"ه",1,0],["لَما هتفتَ بِشكرِ مَولانا الَّذي","جَعَلَ المَعالي لِلكِرام مَراتِبا",29,"ب",2,1],["لَمّا هَوَى بَينَ غِيَاضِ الأُسدِ","وَصَارَ في كَفِّ الهِزَبرِ الوَردِ",30,"د",1,0],["لما هززت جزعها إليَّا","تساقطت ثمارها عليَّا",31,"ي",2,0],["لَمْ أُهْدِهِ إِلاَّ لِتَكْسُوَهُ","ذِكْراً يُجَدِّدُهُ على الْقِدَمِ",32,"م",1,0],["لَم أَهجُ بشّاراً وَلَكِنَّني","هَجَوتُ نفسي بِهِجائيهِ",33,"ي",2,0],["لما هتك الدمع ستر الهوى","وأوردني العشق بحر الغرق",34,"ق",1,0],["لم أهو إلا أن أقيم على الهوى","أضعاف ما راموا بأني أعدل",35,"ل",1,0],["لم أهب لومة تصيب أهابي","إيهاب الجزار نطح الشياه",36,"ا",2,0],["لم أهب غادر الزمان وظني","حسن فيه وهو بالعهد وافي",37,"ف",2,0],["لم أهوكم إلا لأني منكم","يا أمتي وهدايتي وصلاحي",38,"ح",2,0],["لما همى بأيادٍ جودها ديم","أغنى الورى من كريم الطبع والشيم",39,"م",1,0],["لما هوى اظلم المكان كانه","بدر السماوة خرّ عنها هاويا",40,"ي",2,0],["لَماها حَياتِي وَمَن لِي بِهِ","وَمِن دُونِهِ مُقَلٌ قاتِلَه",41,"ل",2,0],["لما هززناه تلا","قى طرفاه بالطرب",42,"ب",1,0],["لما همُ زادوا على ما فعلوا","بنا وما كانوا بنا قد عَمِلوا",43,"ل",3,0],["لما هوى بين القواضب","والقنا فوق الصعيد",44,"د",1,0],["لم أهو قبلك غادة","يا ربة الثغر المجوهر",45,"ر",1,0],["لما هوى ركن العدالة جددوا","نشييده من بعد كل دمار",46,"ر",1,0],["لما هززتم جذع نخلة الثنا","ألقت عليكم رطبا جنبا",47,"ب",2,0],["لم أهو سواها ولو أذاب نواها","جسمي وهواها إلى الممالك بي سار",48,"ر",1,0],["لم أهو سواها ولو أذاب نواها","جسمي وهواها إلى المهالك بي سار",49,"ر",1,0],["لما هدتْ نارُ شوقي ضيفَ طيفكمُ","قريتُهُ بالكرَى اذرارَ مقتبسا",50,"س",2,0],["لما هَمت كفاه أمطارَ اللُهى","صاح الورى أنعم بجريَ النَدا",51,"د",2,0],["لما هجرتم واصلت أشجانه","وتجدّدت ببعادكم أحزانه",52,"ن",2,1],["لَمَّا هَجَرتُم وَبَانَت","صَبَابَتِى للعَوَاذل",53,"ل",1,0],["لم أهد إلا جنة المنتهى","ترفل في أثوابها الخضر",54,"ر",1,0],["لمّا هممتُ ولم أفعل تَغمّدني","بالعطفِ لكنّهُ لم يترك الحذرا",55,"ر",2,0],["لمَا هزئتَ بشوقٍ","أتاك بعد الغياب",56,"ب",1,0],["لَمَّاْ هَتَفْتِ عَلَى الْمِهْتَاْفِ شَاْكِيَةً","سَاْدَ الظَّلامُ، وَنُوْرُ الْفَجْرِ مَا وَمَضَاْ",57,"ض",2,0],["لم أهدر الدرب الأبيّ بشهوة","لا ينحني قلمي لمالٍ أو ضِعهْ",58,"ع",2,0],["لما هوت شرفاته وانشق مر","تجس البناء مشعاراً مخذولا",59,"ل",2,0],["لما هانَ البلاءُ على ضعيفٍ","وما سارَ المصابُ إلى الأمامِ",60,"م",1,0],["لمّا همستُ على ذهولٍ باسمها","دوّى الأريجُ بخافقي واضّوّعا",61,"ع",2,0],["لم أهو أكثر منه من وطن فلِمْ","تقسو عليَّ مشاعرُ الأعيانِ",62,"ن",1,0],["لم أهو والرحمن شاهد قولتي","إلا بلاد الناصرِ المعوانِ",62,"ن",1,0],["لمّا هويتك تلك كانت سقطة","جلبتْ لعمري لعنة وخرابا",63,"ب",2,0],["لمَّا هنا أورقتْ بالحزنِ قافيتي","علمتُ أني هنا فارقتُ زهراتي",64,"ت",2,0],["لمَّا هَمَمْتُ بأنْ أُغَادرَ لَمْ أَعِ","أنِّي ابتَعدتُ ومُهجَتي لا تَبْعُدُ",65,"د",1,0],["لمّا هويْتَ هَويتَ مُتَّحدَ الهوى","وهويْتُ فيك موزَّعَ الأهواءِ",66,"ا",2,0],["لماها مراحٌ للذي يشتكي الضّنى","وموردُ صادٍ وانتفاعٌ لجائعِ",67,"ع",1,0],["لم أهجُ يوماً مِنْ تأبَّطَ سيرَتيْ","وهَجوتُ مَنْ باعَ البلادَ وأجَّرَا",68,"ر",2,0]]}