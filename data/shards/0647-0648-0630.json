{"poems":[[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"أخرق الدف لو رأيت شكيبا","https://www.aldiwan.net/poem68871.html","الخفيف"],[93,"يا ابن الألى بلغوا السماك الأعزلا","https://www.aldiwan.net/poem9847.html","الكامل"],[88,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"ما لآفاقك يا قلبي سودا حالكات","https://www.aldiwan.net/poem38965.html","مجزوء الرمل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"هو ذا مذهبي وهذا شعاري","https://www.aldiwan.net/poem7898.html","الخفيف"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[87,"أحببت من والى عليا رغبة","https://www.aldiwan.net/poem8202.html","الكامل"],[105,"يا ابني خويلد أي شر هجتما","https://www.aldiwan.net/poem43586.html","الكامل"],[105,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[105,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42492","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[116,"منح المهيمن أحمدا بظهوره","https://www.aldiwan.net/poem42002.html","الكامل"],[129,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[129,"يا حبذا بستان قيس الكامل","https://www.aldiwan.net/poem50535.html","الكامل"],[144,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[153,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[224,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[224,"جثم الليل بأحضان التلال","https://www.aldiwan.net/poem41896.html","الرمل"],[227,"الانتظار الخالد","https://www.aldiwan.net/poem24230.html","عموديه"],[227,"الخطر","https://www.aldiwan.net/poem24237.html","عموديه"],[271,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[272,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[276,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[306,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[306,"بشرى فذا صبح التهاني أسفرا","https://www.aldiwan.net/poem56548.html","الكامل"],[321,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[354,"وافت تتيه فما رنت لك جذرا","https://www.aldiwan.net/poem40341.html","الكامل"],[365,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[365,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[378,"يا غافلا والإثم حل بأرضه","https://www.aldiwan.net/poem59360.html","الكامل"],[378,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[430,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[453,"بكرت مهينمة الصبا تغليسا","https://www.aldiwan.net/poem13806.html","الكامل"],[453,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[453,"برح الخفاء فما لجدك معمل","https://www.aldiwan.net/poem13876.html","الكامل"],[480,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[480,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[559,"لي كاتب يمحو السطور وينسخ","https://www.aldiwan.net/poem34656.html","الكامل"],[563,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[568,"يا علي بن سليمان ويا","https://www.aldiwan.net/poem69790.html","الرمل"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["هُوَ ذَلِكَ الطِلَّسمُ مَن أَعيا الحِجا","حَلّاً وَماتَ وَلَم يَفُز بِطِلابِ",0,"ب",1,0],["هُوَ ذِكري وَقِبلَتي وَإِمامي","وَطَبيبي إِذا دَعَوتُ الطَبيبا",1,"ب",2,0],["هو ذلك البطل الذي غاراته","ردت إلى الوطن الحلال الأولا",2,"ل",2,0],["هو ذاك المهديّ أحرز سبقاً","حين أجرى إلى الهدى أفراسه",3,"س",2,0],["هو ذاك الحبر الذي كان للشر","ع مقيماً دليله وقياسه",3,"س",2,0],["هو ذا أحمد فيا منكب الغبراء","زاحم مناكب الجوزاء",4,"ا",2,0],["هو ذلك القلبُ الَّذي","سيَعيشُ كالشَّادي الضَّريرْ",5,"ر",1,0],["هو ذلكَ القلبُ الَّذي","مهما تقلَّبَتِ الحَيَاةْ",5,"ه",1,0],["هو ذا يا قلبيَ البَحْرُ وأمواجُ الحياةْ","هو ذا القارِبُ مشدوداً إلى تِلْكَ الصَّفاةْ",6,"ه",1,0],["هو ذا الشاطئُ لكنْ أينَ رُبَّانُكَ ماتْ","أين أحلامُك يا قلبي لقد فاتَ الفَواتْ",6,"ت",1,0],["هو ذا العام وذى أيامه","جددا تهدى السعود القشبا",7,"ب",2,0],["هو ذا مذهبي وهذا شعاري","وهو للناس من زمان شعار",8,"ر",1,1],["هُوَ ذِروَةٌ في الحُسنِ غَيرُ مَرومَةٍ","وَذَرا البَراعَةِ وَالحِجى بَيروتُهُ",9,"ت",2,0],["هُوَ ذَلِكَ الْحَبْرُ الَّذِي مَنْ أَمَّهُ","نَالَ الرِّضَا وَأُجِيبَ مَنْ نَادَاهُ",10,"د",3,0],["هو ذاك عبدُ اللهِ في أصحابِهِ","يَمشِي إلى قَطَنٍ قَضاءً مُبْرَمَا",11,"م",2,0],["هُوَ ذلكم ما مِنْ رسولٍ غيره","فَيميلُ عنه أخو الرَّشادِ ويَرْغَبُ",12,"ب",1,0],["هو ذاك فاصدعْ يا ضمامُ بنورِهِ","ليلَ العَمى وحَذارِ أن تَتردَّدا",13,"د",2,0],["هوذا الحُب فَليَكُن حينَ يَأتي","ك بَريئاً مِن كُل عَيب مَكانُه",14,"ه",1,0],["هُوَ ذا البَحر مزبداً يَتعالى","إِثر بَعض أَمواجه تَتَوالى",15,"ل",2,1],["هو ذلك الليْثُ الغَضَنْفَرُ فانجُ من","بَطشٍ على مُهَجِ الليوثِ وَشيكِ",16,"ك",1,0],["هو ذلك السرُّ الذي","أفشاه مُبدعه وأبدى",17,"د",2,0],["هُوَ ذَلِكَ الْمَلِكُ الَّذي أَوْصَافُهُ","فِي الشِّعْرِ حِلْيَةُ رَاجِزٍ وَمُقَصِّدِ",18,"د",1,0],["هُوَ ذَلِكَ الشَّهْمُ الَّذِي بَلَغَتْ بِهِ","مَسْعَاتُهُ أَمَدَ السِّمَاكِ الأَرْفَعِ",19,"ع",1,0],["هُوَ ذَلِكَ النَّظْمُ الَّذِي شَهِدَتْ لَهُ","أَهْلُ الْبَرَاعَةِ بِالْمَقَالِ الْمُبْدَعِ",19,"ع",1,0],["هُوَ ذَلِكَ الْمَلِكُ الَّذِي وَرِث الْعُلا","عَنْ نَفْسِهِ شَرَفا وعَن آبائِهِ",20,"ا",3,0],["هُوَ ذاكَ فِي لُجِِّ الدُّجَى","طَفْوُ الدَّرَارِي وَالرُّسُوبُ",21,"ب",1,0],["هو ذا النجم قريب فاعتلي","ما على الأسطول من أسطولهم",22,"م",1,0],["هو ذا الريال فإنه نعم الذي يهب","الشفاء لنا ونعم الراق",23,"ق",1,0],["هو ذا الريال وقد تألق ماحق","دجن الهموم وقد أردن محاقي",23,"ق",2,0],["هو ذا الريال ولم يكن لولا ابنتي","ليسومني نكراً على الإطلاق",23,"ق",1,0],["هو ذخْرُ الطُلاّبِ كم وجدوا","فيهِ أَماناً من طَارِقِ الْحَدثانِ",24,"ن",1,0],["هو ذلك اللوح الإلهي الذي","كتب الإله عليه كل سطوره",25,"ر",2,0],["هو ذَابلي ومهنّدي يومَ الوغى","وذخيرني في الدهرٌ إن أمر عَنَا",26,"ن",2,0],["هو ذُو العلى سلطانُ سيف المنتَضى","حامى رعيته القؤولُ الفاعلُ",27,"ل",1,0],["هُوَ ذاكَ رَبعُ المالِكِيَّةِ فَاِربَعِ","وَاِسأَل مَصيفاً عافِياً عَن مَربَعِ",28,"ع",1,1],["هُوَ ذا دربهم، طويلٌ، ومفروش","بجمرِ الأسى ، وصُمِّ الكِعاب",29,"ب",1,0],["هوذا المُنجلُ فَاِطلُب عَملاً","إِنَّما المنجلُ رَمزُ العَمَلِ",30,"ل",1,0],["هوذا البَدرُ بِأَبهى رَونَقِ","صاعِدٌ خَلفَ جبالِ المَشرقِ",31,"ق",1,0],["هو ذاك سر تنظّري","أبدا إليك ، فما احتيالي ؟",32,"ل",2,0],["هو ذاك يا قلب الخطر","لا الناظرون ولا النظر !",33,"ر",1,0],["هُو ذلكَ البطَلُ الذي صَولاتُهُ","مأمولةٌ لِصلاحِ أمرٍ فاسِد",34,"د",1,0],["هُوَ ذخرتي هُوَ عمدتي هو عدتي","وَحماى في الدنيا وَمؤنس وحدتي",35,"ي",1,0],["هُوَ ذخرتي هو موئلى وَمأملي","هُوَ عمدتي هو عدتي وَعتادي",36,"د",2,0],["هُوَ ذا بِبابِكَ ليسَ يَسْأَم قَرْعَه","ولَطالَما وَلَجَ المُلِظُّ القارِعُ",37,"ع",1,0],["هو ذلكَ القانونُ والعهدُ الّذي","أُوتيتمُ من قبلُ بالإيمانِ",38,"ن",1,0],["هو ذاكُمُ فردُ الكمالِ محمّدٌ","نَجلُ الملوكِ السادةِ الشمِّ الذرى",39,"ر",2,0],["هُوَ ذَلِكَ الشَهمُ الَّذي ما فاتَني","دونَ المَلا في الثَورَةِ الشَنعاءِ",40,"ا",2,0],["هُوّ ذَلِكَ الخلّ الوَفيّ فَلا خَلا","مِنهُ حِمىً بِاللطفِ أَصبَح مُزهرا",41,"ر",2,0],["هو ذاكَ الفِراقُ فارقَني نَو","مي وما عادَ بَعدَه يَلْقاني",42,"ن",2,0],["هو ذلك الدُّرُّ الّذي ألقيتُمُ","في مَسْمَعي ألقيتُه من مَدْمَعي",43,"ع",2,0],["هو ذا الخَطاء وقد رضيت بفعله","وجهنمٌ هي بضعةٌ من بعضه",44,"ض",2,0],["هو ذا حبيبي أبيضٌ في أشقرٍ","اخترتُهُ من بين أهلِ مَلاء",45,"ا",2,0],["هو ذو الفهم والنباهة يوحنا م","المفدى مولى الحجى الألمعيّ",46,"ي",1,0],["هو ذلك الزَّكِنُ اللبيبُ ومن غدا","دَوْحُ البيانِ بِفِكْرِه مغروسا",47,"س",2,0],["هو ذاك الضنين يعبث مجّا","ناً بأهل الهوى وليس يُوافي",48,"ف",2,0],["هو ذاك الشهمُ الحريُّ بكلّما","فتق الثناءُ به وفاحَ المَنْدَلُ",49,"ل",1,0],["هو ذلك الدستور مطلبنا الذي","قاموا بما يرضيك في تخويله",50,"ل",2,0],["هو ذلك القانون عاهد ربه","عنه مع الوزراء والعلماء",51,"ا",2,0],["هو ذاك الرتل جواب القفار","محدث الأنفاق في جوف الجبال",52,"ل",1,0],["هو ذاك يسكنُ في الزُّهورِ فلم يزلْ","ما بين زنبقِهِ يتيهُ، وفُلِّهِ",53,"ل",2,0],["هو ذا وهذا في الظهور وهذه","جبل إذا اختلج المحقق يرسخ",54,"خ",1,0],["هُوَ ذلكَ الرَّجُلُ الذي آثارُهُ","لا تُقتَفى وغُبارُهُ لا يُلحَقُ",55,"ق",1,0],["هُوَ ذَاكَ الذِّهْنُ أذْكَى نَارَهُ","والمِزَاجُ المُفْرِطُ الحَرِّ التَهَبْ",56,"ب",1,0],["هُوَ ذَلِكَ القَمَرُ الَّذي القمرُ الَّذي","مُتَنَاقِضٌ بَدْرُ الدُّجَى لِكَمَالِهِ",57,"ل",2,0]]}