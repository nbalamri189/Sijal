ُوَ ذَلِكَ الطِلَّسمُ مَن أَعيا الحِجا","حَلّاً وَماتَ وَلَم يَفُز بِطِلابِ",0,"ب",1,0],["هُوَ ذِكري وَقِبلَتي وَإِمامي","وَطَبيبي إِذا دَعَوتُ الطَبيبا",1,"ب",2,0],["هو ذلك البطل الذي غاراته","ردت إلى الوطن الحلال الأولا",2,"ل",2,0],["هو ذاك المهديّ أحرز سبقاً","حين أجرى إلى الهدى أفراسه",3,"س",2,0],["هو ذاك الحبر الذي كان للشر","ع مقيماً دليله وقياسه",3,"س",2,0],["هو ذا أحمد فيا منكب الغبراء","زاحم مناكب الجوزاء",4,"ا",2,0],["هو ذلك القلبُ الَّذي","سيَعيشُ كالشَّادي الضَّريرْ",5,"ر",1,0],["هو ذلكَ القلبُ الَّذي","مهما تقلَّبَتِ الحَيَاةْ",5,"ه",1,0],["هو ذا يا قلبيَ البَحْرُ وأمواجُ الحياةْ","هو ذا القارِبُ مشدوداً إلى تِلْكَ الصَّفاةْ",6,"ه",1,0],["هو ذا الشاطئُ لكنْ أينَ رُبَّانُكَ ماتْ","أين أحلامُك يا قلبي لقد فاتَ الفَواتْ",6,"ت",1,0],["هو ذا العام وذى أيامه","جددا تهدى السعود القشبا",7,"ب",2,0],["هو ذا مذهبي وهذا شعاري","وهو للناس من زمان شعار",8,"ر",1,1],["هُوَ ذِروَةٌ في الحُسنِ غَيرُ مَرومَةٍ","وَذَرا البَراعَةِ وَالحِجى بَيروتُهُ",9,"ت",2,0],["هُوَ ذَلِكَ الْحَبْرُ الَّذِي مَنْ أَمَّهُ","نَالَ الرِّضَا وَأُجِيبَ مَنْ نَادَاهُ",10,"د",3,0],["هو ذاك عبدُ اللهِ في أصحابِهِ","يَمشِي إلى قَطَنٍ قَضاءً مُبْرَمَا",11,"م",2,0],["هُوَ ذلكم ما مِنْ رسولٍ غيره","فَيميلُ عنه أخو الرَّشادِ ويَرْغَبُ",12,"ب",1,0],["هو ذاك فاصدعْ يا ضمامُ بنورِهِ","ليلَ العَمى وحَذارِ أن تَتردَّدا",13,"د",2,0],["هوذا الحُب فَليَكُن حينَ يَأتي","ك بَريئاً مِن كُل عَيب مَكانُه",14,"ه",1,0],["هُوَ ذا البَحر مزبداً يَتعالى","إِثر بَعض أَمواجه تَتَوالى",15,"ل",2,1],["هو ذلك الليْثُ الغَضَنْفَرُ فانجُ من","بَطشٍ على مُهَجِ الليوثِ وَشيكِ",16,"ك",1,0],["هو ذلك السرُّ الذي","أفشاه مُبدعه وأبدى",17,"د",2,0],["هُوَ ذَلِكَ الْمَلِكُ الَّذي أَوْصَافُهُ","فِي الشِّعْرِ حِلْيَةُ رَاجِزٍ وَمُقَصِّدِ",18,"د",1,0],["هُوَ ذَلِكَ الشَّهْمُ الَّذِي بَلَغَتْ بِهِ","مَسْعَاتُهُ أَمَدَ السِّمَاكِ الأَرْفَعِ",19,"ع",1,0],["هُوَ ذَلِكَ النَّظْمُ الَّذِي شَهِدَتْ لَهُ","أَهْلُ الْبَرَاعَةِ بِالْمَقَالِ الْمُبْدَعِ",19,"ع",1,0],["هُوَ ذَلِكَ الْمَلِكُ الَّذِي وَرِث الْعُلا","عَنْ نَفْسِهِ شَرَفا وعَن آبائِهِ",20,"ا",3,0],["هُوَ ذاكَ فِي لُجِِّ الدُّجَى","طَفْوُ الدَّرَارِي وَالرُّسُوبُ",21,"ب",1,0],["هو ذا النجم قريب فاعتلي","ما على الأسطول من أسطولهم",22,"م",1,0],["هو ذا الريال فإنه نعم الذي يهب","الشفاء لنا ونعم الراق",23,"ق",1,0],["هو ذا الريال وقد تألق ماحق","دجن الهموم وقد أردن محاقي",23,"ق",2,0],["هو ذا الريال ولم يكن لولا ابنتي","ليسومني نكراً على الإطلاق",23,"ق",1,0],["هو ذخْرُ الطُلاّبِ كم وجدوا","فيهِ أَماناً من طَارِقِ الْحَدثانِ",24,"ن",1,0],["هو ذلك اللوح الإلهي الذي","كتب الإله عليه كل سطوره",25,"ر",2,0],["هو ذَابلي ومهنّدي يومَ الوغى","وذخيرني في الدهرٌ إن أمر عَنَا",26,"ن",2,0],["هو ذُو العلى سلطانُ سيف المنتَضى","حامى رعيته القؤولُ الفاعلُ",27,"ل",1,0],["هُوَ ذاكَ رَبعُ المالِكِيَّةِ فَاِربَعِ","وَاِسأَل مَصيفاً عافِياً عَن مَربَعِ",28,"ع",1,1],["هُوَ ذا دربهم، طويلٌ، ومفروش","بجمرِ الأسى ، وصُمِّ الكِعاب",29,"ب",1,0],["هوذا المُنجلُ فَاِطلُب عَملاً","إِنَّما المنجلُ رَمزُ العَمَلِ",30,"ل",1,0],["هوذا البَدرُ بِأَبهى رَونَقِ","صاعِدٌ خَلفَ جبالِ المَشرقِ",31,"ق",1,0],["هو ذاك سر تنظّري","أبدا إليك ، فما احتيالي ؟",32,"ل",2,0],["هو ذاك يا قلب الخطر","لا الناظرون ولا النظر !",33,"ر",1,0],["هُو ذلكَ البطَلُ الذي صَولاتُهُ","مأمولةٌ لِصلاحِ أمرٍ فاسِد",34,"د",1,0],["هُوَ ذخرتي هُوَ عمدتي هو عدتي","وَحماى في الدنيا وَمؤنس وحدتي",35,"ي",1,0],["هُوَ ذخرتي هو موئلى وَمأملي","هُوَ عمدتي هو عدتي وَعتادي",36,"د",2,0],["هُوَ ذا بِبابِكَ ليسَ يَسْأَم قَرْعَه","ولَطالَما وَلَجَ المُلِظُّ القارِعُ",37,"ع",1,0],["هو ذلكَ القانونُ والعهدُ الّذي","أُوتيتمُ من قبلُ بالإيمانِ",38,"ن",1,0],["هو ذاكُمُ فردُ الكمالِ محمّدٌ","نَجلُ الملوكِ السادةِ الشمِّ الذرى",39,"ر",2,0],["هُوَ ذَلِكَ الشَهمُ الَّذي ما فاتَني","دونَ المَلا في الثَورَةِ الشَنعاءِ",40,"ا",2,0],["هُوّ ذَلِكَ الخلّ الوَفيّ فَلا خَلا","مِنهُ حِمىً بِاللطفِ أَصبَح مُزهرا",41,"ر",2,0],["هو ذاكَ الفِراقُ فارقَني نَو","مي وما عادَ بَعدَه يَلْقاني",42,"ن",2,0],["هو ذلك الدُّرُّ الّذي ألقيتُمُ","في مَسْمَعي ألقيتُه من مَدْمَعي",43,"ع",2,0],["هو ذا الخَطاء وقد رضيت بفعله","وجهنمٌ هي بضعةٌ من بعضه",44,"ض",2,0],["هو ذا حبيبي أبيضٌ في أشقرٍ","اخترتُهُ من بين أهلِ مَلاء",45,"ا",2,0],["هو ذو الفهم والنباهة يوحنا م","المفدى مولى الحجى الألمعيّ",46,"ي",1,0],["هو ذلك الزَّكِنُ اللبيبُ ومن غدا","دَوْحُ البيانِ بِفِكْرِه مغروسا",47,"س",2,0],["هو ذاك الضنين يعبث مجّا","ناً بأهل الهوى وليس يُوافي",48,"ف",2,0],["هو ذاك الشهمُ الحريُّ بكلّما","فتق الثناءُ به وفاحَ المَنْدَلُ",49,"ل",1,0],["هو ذلك الدستور مطلبنا الذي","قاموا بما يرضيك في تخويله",50,"ل",2,0],["هو ذلك القانون عاهد ربه","عنه مع الوزراء والعلماء",51,"ا",2,0],["هو ذاك الرتل جواب القفار","محدث الأنفاق في جوف الجبال",52,"ل",1,0],["هو ذاك يسكنُ في الزُّهورِ فلم يزلْ","ما بين زنبقِهِ يتيهُ، وفُلِّهِ",53,"ل",2,0],["هو ذا وهذا في الظهور وهذه","جبل إذا اختلج المحقق يرسخ",54,"خ",1,0],["هُوَ ذلكَ الرَّجُلُ الذي آثارُهُ","لا تُقتَفى وغُبارُهُ لا يُلحَقُ",55,"ق",1,0],["هُوَ ذَاكَ الذِّهْنُ أذْكَى نَارَهُ","والمِزَاجُ المُفْرِطُ الحَرِّ التَهَبْ",56,"ب",1,0],["هُوَ ذَلِكَ القَمَرُ الَّذي القمرُ الَّذي","مُتَنَاقِضٌ بَدْرُ الدُّجَى لِكَمَالِهِ",57,"ل",2,0],["هو ذلك الفطن الذي من حكمة","قد نال قسطا كان غير طفيف",58,"ف",1,0],["هُوَ ذَلِكَ البَطَلُ الَّذي في ذِكرِهِ","أَبَداً يُضيءُ مِنَ الوُجوهِ عَبوسَها",59,"س",3,0],["هُوَ ذا الشَرقُ في حِماكَ لَكَ الأَم","رُ جَميعاً وَفي يَدَيكَ الزِمامِ",60,"م",1,0],["هو ذو نجار طيّب","مِن عنصرٍ زاكٍ مُطهّر",61,"ر",1,0],["هو ذو الفضلِ والمفاخر مَن قَد","نال عزّاً وللثريّا اِستطالا",62,"ل",2,0],["هو ذا سليل محمّد الحبر الّذي","أروى ببحرِ علومه أظماءها",63,"ا",3,0],["هو ذا محمّد العليّ أخو الوفا","والصدق يُدعى من بني القزويني",64,"ن",2,0],["هو ذو المناقب والفضائل والندى","وأخو المكارمِ والعلى والسؤددِ",65,"د",1,0],["هو ذا أبو الحسن الفتى الزاكي الّذي","بِسَما المَعالي قد بدا كالفرقدِ",65,"د",1,0],["هو ذا ضياءُ الدين خير معظّم","بشمالهِ ملك العلى ويمينِ",66,"ن",1,0],["هو ذُخرنا في النائِبا","تِ وغوثنا في كلّ أزمَه",67,"م",2,0],["هوذا العامٌ فاتحاً سفر فضلٍ","فأملأوهُ من كلّ مسعىً حميد",68,"د",1,0],["هو ذا غلامٌ بالمعارف هائمٌ","منذ الحداثة عاشقٌ غُرَر الفكر",69,"ر",1,0],["هو ذا الآن في دِمشقَ رداحٌ","تدَّعي الكشفَ عند