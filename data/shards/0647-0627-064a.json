{"poems":[[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[74,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[94,"رفرفت في دجية الليل الحزين","https://www.aldiwan.net/poem38917.html","الرمل"],[47,"يا بن المدبر يا أبا إسحاق","https://www.aldiwan.net/poem65205.html","الكامل"],[54,"أنا مذ صار لي سكن","https://www.aldiwan.net/poem26651.html","مجزوء الخفيف"],[48,"عجبا للقطا من الكدر والجو","https://www.aldiwan.net/poem23274.html","الخفيف"],[78,"يا قتيلا من يده","https://www.aldiwan.net/poem39332.html","مجزوء الرمل"],[136,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[190,"لائم لامني أطال التعدي","https://www.aldiwan.net/poem43941.html","الخفيف"],[333,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[563,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[563,"حرم آمن لكعبة قلبي","https://www.aldiwan.net/poem34955.html","الخفيف"],[580,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203698","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55951","الخفيف"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216687",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107342","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125399","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205856","الرمل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138619",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108385",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102952","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76476","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107503","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107501","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97085","الرمل"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[4680,"طلعة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=185087",""],[4691,"قصائد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=141748",""],[4715,"مرثية أمي","https://www.poetsgate.com/ViewPoem.aspx?id=204454",""],[4755,"لَيلٌ.. وصَنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203125",""],[5055,"الرحى","https://www.poetsgate.com/ViewPoem.aspx?id=103539",""],[5135,"أيُّهَا الظَّبْيُ","https://www.poetsgate.com/ViewPoem.aspx?id=202223",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5307,"","https://www.poetsgate.com/ViewPoem.aspx?id=10549",""],[5431,"سنة الله نصره والتلاقي","https://www.poetsgate.com/ViewPoem.aspx?id=198541",""],[5461,"قريت خطّك","https://www.poetsgate.com/ViewPoem.aspx?id=5286",""],[5480,"مذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=9890",""],[5480,"يا وجد","https://www.poetsgate.com/ViewPoem.aspx?id=35636",""],[5725,"الى مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=184689",""],[5732,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=177924",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5841,"قربوا لي العود ...","https://www.poetsgate.com/ViewPoem.aspx?id=34958",""],[5889,"إيه يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=202229",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[6102,"خَانتْ سُعادُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=183983",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""]],"verses":[["هائِمٌ كَالظَليمِ أَزعَجَهُ الصَي","دُ وَراعَتهُ طائِشاتُ السِهامِ",0,"م",1,0],["هائم في الوجود أسأله الوح","ي كما يسأل الغني الفقير",1,"ر",1,0],["هائمٌ في هواك مثلي ولكن","يدفعُ الوهم عنك بالتفنيد",2,"د",1,0],["هائِمٌ قَلْبي بأَعْماقِ الحَيَاةْ","تَائِهٌ حَيْرانْ",3,"ن",1,0],["هائِنَّهُ وَعَطاؤُكَ الجَمُّ اللُهى","أَخَوانِ ذا فانٍ وَهَذا باقِ",4,"ق",1,0],["هائِمُ العَقلِ في نَها","ري وَلَيلي بِلا وَسَن",5,"ن",1,0],["هائِفاتٍ قَد مَزَّقَ الحَرُّ عَنها","الأَهبَ أَو هَمَّ أَم يَميزَ المَفاصِل",6,"ل",1,0],["هائِمٌ يَبْكي عَلَيهِ","رَحمةً ذُو حَسَدِه",7,"د",2,0],["هَائِماً يَقتَرِى طَوَامسَ أثَا","رِ ظِبَاءٍ تَقَادَمَت وَمَهَاهَا",8,"ا",3,0],["هائم في القرى أكدّي وأمشي","من يراني يقول هذا مسدّي",9,"د",2,0],["هائمُ الروح بالهوى والأماني","خالدُ الذات وهو كالناس فان",10,"ن",1,1],["هائم صبٌ كثيرُ جوى","في الهوى لحمٌ على وَضَم",11,"م",1,0],["هائمٌ صبٌّ كثيرُ جوىً","عنه سدت سائر الطرق",12,"ق",1,0],["هائم أطلب الوجود فألقى","حجباً أسدلت ببعد وقرب",13,"ب",1,0],["هائِمٌ حَيْرَانُ في بلدٍ","والذي يَهْواهُ في بَلَد",14,"د",1,0],["هائماً، تطلب الحرابُ دمائي","وشفاهُ الغزاة خَلْفَ الحراب",15,"ب",1,0],["هايماً للقا شديد غرامٍ","هاتفاً من جرى النوى لا حولا",16,"ل",2,0],["هايم نَعَمْ هايم بحب الجميله","بي عين فيها كاتم الصوت جَبّار",17,"ر",1,0],["هائجات في لجها مائجات","كالتحام الأقدار بالأقدار",18,"ر",1,0],["هائم الفكر ساهر الليل باكي ال","عين واهي الوى ضعيف الجنان",19,"ن",1,0],["هائمٌ في الوهم صبٌّ حائرُ","عائفٌ في هذه الدنيا البقاءْ",20,"ا",2,0],["هائِم مازالَ سكرانَ وما","شربَ الكأسَ ولا جاوَرَ دَنَّا",21,"ن",2,0],["هائِمٌ في القِفارِ لَم يُؤوِهِ عُش","شٌ وَلا رَقَّ مُنصِفٌ لِبُكائِه",22,"ا",3,0],["هائم في هواك مثلي ولكن","يدفع الوهم عَنهُ بالتفنيدِ",23,"د",1,0],["هائما ترتاد آفاق المنى","وتناجي شاطئ الوادى الحبيب",24,"ب",1,0],["هائم فيك لا يزيد وعمر","ذو استناد إليك في كل أمر",25,"ر",1,0],["ها ىية التطهير اسفر صبحها","فانجاب ليلٌ الريب عمن يعقل",26,"ل",1,0],["هائجاتُ الشجون غادرت الص","ب اليها يهيج قلباً ووجدا",27,"د",2,0],["هاي الدنا حفت على علاتها","بسرير نعمك والبنود تبند",28,"د",1,0],["ها يدي تحمل اليضتيم لتبدي","ه اسيفا وَبائسا وَيَتيما",29,"م",2,0],["هائِماتٌ مَعَ المجرَّة تجر","ينَ إلى غير غايةٍ او رجاء",30,"ا",2,0],["هائِمٌ في القفارِ يعلنهُ اللي","لُ ويخفيهِ عنك طرف ذُكاءِ",31,"ا",2,0],["هائِماً لا يقرُّ منهُ قرار","من مكانٍ يميلُ نحو مكانِ",32,"ن",1,0],["هائم بالنهار قائم ليل","فهو حلف السها والف السهاد",33,"د",1,0],["هائج ذي لبدةٍ عن","عزمه لم يرجع",34,"ع",1,0],["هائماً في البيد حتى لا أرى","فوق قبر المجد ناساً خانعين",35,"ن",1,0],["هائِمين اِستَلهَما الحُب فَغَنى","بِهِما كُل جَميل أَصبَحا",36,"ح",2,0],["هائم القَلب في جمال معانٍ","فقتِ فيها جَميع أَهلِ الجَمالِ",37,"ل",1,0],["هائِم القَلب مُقبلٌ كلّ وَقتٍ","فَأَثيبي الإِقبال بِالإِقبالِ",37,"ل",1,0],["هائِم القَلب مُثقل الجِسم طَبعاً","فهو يَشكو دوماً من الأَثقالِ",37,"ل",1,0],["هائماً في الرَّوْضِ أَجْلُوا سِرَّهُ","انَّ في الزَّنْبَقِ سِرا مُضْمرا",38,"ر",2,0],["هائل الصبر أرتقي طود همّي","رغم آلام غربتي وقيودي",39,"د",2,0],["هائمات قصائد الحب حيرى","مثلما فارس أضاعك خيلا",40,"ل",2,0],["هاي قصة أم فايز باختصار","من يواسيني وانا حملي ثقيلي",41,"ل",2,0],["ها يا أَحِبَّةَ قَلبي.. ما أَقُولُ لَكُم؟!","صَنعاءُ واللَّيلُ مِسمَارَانِ في كَبِدِي",42,"د",2,0],["هايمٍ يجهل ومجهول الكيان","هو يعرْف أنه كيانه سلمّه",43,"م",2,0],["هَائِمٌ فِي الْبِيْدِ يَشْكُو شَوْقَهُ","ويُرَوِّي الْبِيْدَ دَمْعاً مُسْبَلا",44,"ل",2,0],["ها ياابنَ جعفرَ والكرامةُ لمْ تزلْ","لكَ تنتهي في أفقِها المُتَلَازِمِ",45,"م",1,0],["هايم وابحث واناديبك","واندب بحسرات وعزاتك",46,"ك",1,0],["هائمٌ قد أضعت خيلك سهوا","مطفئ الوحي متعب الأحداق",47,"ق",1,0],["هايم بعيد الدّار سهران ما بات","أتبع هواجيس(ن) بعيد(ن) مداها",48,"ا",3,0],["هايم فحبك واشكي اليوم \"مذبوح\"","ومرتاح يللي فالملذات مرتاح",49,"ح",1,0],["هايم وفكري في عنود ٍ تبعد","مدري زعل مدري جفا أي وسيله!",50,"ل",2,0],["هاي بالدنيا قسمتي يانصيبي","وانت نسمة وسافرت وكت السحر",51,"ر",1,0],["هايف حشا ما به من الشين عذروب","والزين كله طرة في جبينه",52,"ن",2,0],["هايمٍ مشتاق شوقه من قديم","مستكنٍ بالضلوع المغلقات",53,"ت",1,0],["ها يدي قد مددتها لك فاملآها","بما فيه ربحي المشكور",54,"ر",1,0],["هايم ابرمشه وصده لي جنان","ما يهم غيره وابد ما ستخصره",55,"ر",2,0],["هأئم كم تجول وسط الفيافي","حينما الوجد بالسهام رماكا",56,"ك",2,0],["هَائماً يَسْتقي حُزنَهُ","فِيِ بَهيم ِالْبَلى أُسْكِرَا",57,"ر",2,0],["ها يَدِي تَرفعُ (العُقابَ) جِهاراً","فوقَ أصنامٍ مِنْ دَمٍ قدْ تجمَّدْ",58,"د",1,0],["هَا , يَا \" سُعَادُ \" , وَ مَا أَقُولُ لِخَافِقٍ","صَبَّرتُهُ - دَهرًا - وَ مَنْ سَيُعِينُ ؟",59,"ن",1,0],["هَائِمًا لَا أَرَى بِدَربِيَ نُورًا","فِي صِرَاعٍ مَعَ الشُّجُونِ طَرِيدا",60,"د",2,0],["هائماتٍ حذر القوم على","وجهها تعدو وتكبو وجلا",61,"ا",1,0]]}