زلنا على شاعر البلدتين","https://www.aldiwan.net/poem3332.html","عموديه"],[501,"شروق بغربي اللوا لألأت لنا","https://www.aldiwan.net/poem37796.html","الطويل"],[501,"ولما أتينا أرض حيش وعندنا","https://www.aldiwan.net/poem37816.html","الطويل"],[501,"أأم عبيدة أقلقت ركبي","https://www.aldiwan.net/poem37932.html","الوافر"],[506,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[515,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[516,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[552,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[552,"ألا يا نسيم الريح من أرض بابل","https://www.aldiwan.net/poem47217.html","الطويل"],[552,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[552,"ألوما على لوم وأنتم بنجوة","https://www.aldiwan.net/poem47775.html","الطويل"],[564,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[568,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["فَلا باسِطاً بِالسوءِ إِن ساءَني يَداً","وَلا فاغِراً بِالذَمِّ إِن رابَني فَما",0,"م",2,0],["فلا بَرِحَتْ تَسري الرّياحُ مَريضةً","بِها ويُحيّيها الحَيا بانْهمارِهِ",1,"ر",2,0],["فلا بَلَغَتْ إنْ زُرْتُهُ ما تَرومُهُ","رَكائِبُ أنْضاها التّوَقُّصُ والوَخْدُ",2,"د",1,0],["فَلا بَرِحَتْ تَكْسوهُ ما هَبّتِ الصَّبا","أنامِلُ منْ قَطْرٍ غَلائِلَ منْ زَهْرِ",3,"ر",1,0],["فَلا بَرِحَتْ تُروي الغَميمَ بِوابِلٍ","يَدُرُّ على رَوضٍ أزاهِيرُهُ تَغْطو",4,"ط",2,0],["فَلا بَرِحَتْ فيكمْ تَنوءُ بخاطِبٍ","ولا عَدِمَتْ مِنكمْ مَدى الدَّهْرِ راقِيا",5,"ي",2,0],["فَلا بسَطَ الدّهْرُ كفَّ الرّدَى","لذاكَ الشُّخَيْصِ وذاكَ الوُجَيْهِ",6,"ي",2,0],["فَلا برِحَتْ أيّامُكَ الغُرُّ تقْتَفي","بكَ الفَتْحَ والآمالُ لا تتوقّفُ",7,"ف",1,0],["فَلا باغَبيِّ ولا بالعَيِيِّ","ولا بالبَطيِّ ولا بالبَليدْ",8,"د",1,0],["فَلا بَأسَ إِنّي قَد أُجَوِّزُ حاجَتي","بِمُستَحصِدٍ باقٍ مِنَ الرَأيِ مُبرَمِ",9,"م",1,0],["فَلا بَرِحَت تِلكَ الضَغائِنُ إِنَّها","أَفاعٍ لَها بَينَ الضُلوعِ لِصابُ",10,"ب",1,0],["فَلَأَبكِيَنَّكَ ما سَمِعتُ حَمامَةً","تَدعو هَديلاً في فُروعِ الفَرقَدِ",11,"د",1,0],["فَلَأَبكِيَنَّكَ سَيِّداً","فَصلَ الخِطابِ إِذا اِلتَبَس",12,"س",1,0],["فَلا بِدْعٌ إِذَا اعْتمِدَتْ فَضَافَتْ","رِحَابُكَ وَالزُفُودُ لَهَا زِحَامُ",13,"م",1,0],["فلا برِحتُ رُبوعك عامرات","نسُلّ على الشقاء بها حساما",14,"م",2,0],["فَلا بُخلٌ فَيؤيِسَ مِنكَ بُخلٌ","وَلا جودٌ فَيَنفَعُ مِنكَ جودُ",15,"د",1,0],["فَلا بَرِحَت بِالحاسِدينَ كَآبَةٌ","وَلا هَجَعَت لِلشامِتينَ عُيونُ",16,"ن",1,0],["فَلا بِالشامِ لَذَّ بَفِيِّ شُربٍ","وَلا في الأَسرِ رَقَّ عَلَيَّ قَلبُ",17,"ب",1,0],["فلا برحت بدرية النصر والعلى","مؤملة النعماء مرهوبة الفتك",18,"ك",1,0],["فَلا بُعدٌ وَلا قُربٌ","وَلا وَصلٌ وَلا صَدُّ",19,"د",1,0],["فلا بَردُ شِعركِ بَردُ الشرابِ","ولا حَرُّ شعرك حَرُّ الصِّلاءِ",20,"ا",2,0],["فلا برحتْ سبَّابةٌ تستغيثكم","ولا خِنْصَرٌ من شاكرٍ بكُمُ تُثْنى",21,"ن",2,0],["فلأبكِينَّ لك الصديقَ بعَوْلة","ولأضحكنَّ بك العدوَّ إلى العِدا",22,"د",2,0],["فلا بوركت عين تسيح لسقيها","كما لم تبارك في الزروع زروعها",23,"ع",3,0],["فَلا بُتِرَت بُتُر وَلا فنِيَت قَنا","وَلا زَأرت أَسُدٌ وَلا صَهلَت جردُ",24,"د",1,0],["فلا باد ولا خاف","ولا حىّ ولا ميت",25,"ت",1,0],["فَلا بِمَن ماتَ فَخرٌ","وَلا بِمَن نيكَ رَغبَه",26,"ب",2,0],["فَلا بُدَّ مِن نَجرانِ تَثليثَ إِن نَأَوا","وَإِن قَرُبوا شَيئاً فَنَجرانِ لَعلَعا",27,"ع",2,0],["فَلا بَذلَ إِلّا بَذلُهُ وَهوَ ضاحِكٌ","وَلا عَزمَ إِلّا عَزمُهُ وَهوَ مُطرِقِ",28,"ق",1,0],["فَلا بورِكَ الشِعرُ مِن صَنعَةٍ","وَمَن قيلَ فيهِ وَمَن قالَهُ",29,"ل",2,0],["فَلا بَأسَ أَنّي قَد أَخَذتُ بِعُروَةٍ","هِيَ العُروَةُ الوُثقى لِخَيرِ الحَلائِفِ",30,"ف",1,0],["فلا بَرِحَتْ ريحُ الجَنوبِ حَفِيَّةً","تَخُصُّ بألطافِ السحابِ جَنابَها",31,"ب",3,0],["فَلا بُدَّ مِن مَوتٍ وَلا بُدَّ مِن بَلىً","وَإِنَّ بَقائي بَعدَكُم لَقَليلُ",32,"ل",1,0],["فَلَأَبكِيَنَّ عَلى الشَبا","بِ وَطيبِ أَيّامِ التَصاب",33,"ب",1,0],["فَلابُدَّ مِن مَوتٍ وَلابُدَّ مِن بِلاً","وَلابُدَّ مِن بَعثٍ وَلابُدَّ مِن حَشرِ",34,"ر",1,0],["فَلا بُدَّ مِنَ المَوتِ","عَلى حالٍ مِنَ الحالِ",35,"ل",1,0],["فَلَأَبكِيَنَّكَ بِالصَوارِمِ وَالقَنا","حَتّى يُحَطَّمَ ذابِلٌ وَقَضيبُ",36,"ب",1,0],["فَلِاِبنِ زُهَيرٍ قَد أَجَزتَ بِبُردَةٍ","عَلَيكَ فَأَثرى مِن ذَويهِ فَقيرُها",37,"ر",3,0],["فلا بخير ولا بشر","ولا طوال ولا قصار",38,"ر",1,0],["فلا بَسَطَ الصبحُ فيها الضّياءَ","ولا قَبَضَ الليلُ عنها الظلاما",39,"م",2,0],["فلا بَرِحَتْ من رحمةِ اللَّه دائباً","تزورُ ندى كفّيك في قبركَ الأندا",40,"د",2,0],["فَلا بُدَّ يَوماً أَن تَصيرَ لِحُفرَةٍ","بِأَثنائِها تُطوى إِلى يَومِ تُنشَرُ",41,"ر",1,0],["فَلا بَرِحَت تَسطو رَبيعَةُ مِنكُمُ","بِأَرقَمَ عَطّافٍ وَراءَ الأَراقِمِ",42,"م",1,0],["فَلا بُدَّ لِلعَينَينِ إِن شَطَّتِ النَوى","بِلَيلى المُنى مِن واكِفِ الهَمَلانِ",43,"ن",1,0],["فَلا بِلَّيلِ نالَت ما تُرَجّي","وَلا في الصُبحِ كانَ لَها بَراحُ",44,"ح",1,0],["فَلا بَصَرٌ يَسمو إِلَيهِ بِطَرفِهِ","وَدونَ حِجابِ النورِ خَلقٌ مُؤَيَّدُ",45,"د",1,0],["فلا بُورِكُوا مِنْ إِخْوَةٍ إنَّ أُمَّهُمْ","وَإنْ كَثُرَتْ منها البَنُونَ نَزُورُ",46,"ر",1,0],["فلا بَرَقَت أيدي الحوادثِ بَينَكُم","ولا جازَ للدُّنيا على حُكمِكُم حَكمُ",47,"م",1,0],["فلا بالعَجُولِ ولا بالمَلُولِ","ولا بالسَّؤولِ ولا المُغْتَنِم",48,"م",1,0],["فلا بَرِحَتْ تَترَى عليكمُ من الوَرى","صَلاةُ مُصَلٍّ أو سَلامُ مُسَلِّم",49,"م",1,0],["فلا بُخُلٌ يا أكرمَ النّاس مَعشَراً","وأطيَبَ أبناءِ النبيِّينَ عُنصُرَا",50,"ر",2,0],["فَلا بُدَّ أَن تَغشاكَ حينَ غَشيتَها","هَواجِدُ أَبكارٍ عَلَيكَ وَثيبُ",51,"ب",1,0],["فَلا بُدَّ مِن عَوجاءَ تَهوي بِراكِبٍ","إِلى اِبنِ الجُلاحِ سَيرُها اللَيلَ