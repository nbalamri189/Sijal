{"poems":[[90,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[51,"تمسك بالتقى حتى تموتا","https://www.aldiwan.net/poem10834.html","الوافر"],[119,"أغث يا أحمد البدوي وأدرك","https://www.aldiwan.net/poem41747.html","الوافر"],[376,"وطوفتها بين الأنام مخيرا","https://www.aldiwan.net/poem57244.html","الطويل"],[563,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177908","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89531","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53101","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53038","المتقارب"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83220","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133999","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89351","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83383","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62074","الطويل"],[6142,"وطلاب رشدٍ فوق نجب حدت بهم","https://www.poetsgate.com/ViewPoem.aspx?id=155740",""]],"verses":[["وقَلّ حياؤهم حتى رأينا","ظَنين القوم يتّهم البَريّا",0,"ر",3,0],["وَقُل حَسَناً وَأَمسِك عَن قَبيحِ","وَلا تَنفَكَّ عَن سوءٍ صَموتا",1,"ت",2,0],["وقل حصل المراد ولا تدعني","رهين الضد بالخطب الخطير",2,"ر",1,0],["وقُل حينَ تلقاها لَقَد كنتُ خائِفاً","ببُعدِك عَنِّي قَرَّبَ اللَّهُ داركِ",3,"ك",1,0],["وقل حق وبالأسماء خلق","له ذات وأسماء تعالى",4,"ل",2,0],["وقل حين يبدو أحمر اللون مشرقاً","ويا حسنه من أحمر اللون مشرق",5,"ق",1,0],["وَقُل حَبَّذا وَخدُ الرَكائِبِ بِالضُحى","إِذا اِخرَوَّطَت بَعدَ الحُزونِ سُهول",6,"ل",1,0],["وقل حكمت فيه الليالي بغدرها","فبات من الأوطان والأهل مفردا",7,"د",2,0],["وقل حين تبصر جرد الجياد","وقد ألجموها لنصري سُرب",8,"ب",1,0],["وَقُل حَمّادُ قَد أَضناهُ وَجدٌ","وَحَرَّمَ جَفنَهُ طيبَ المنامِ",9,"م",1,0],["وقل حبذا صبري على الجد كلما","بهَ حفظَ التاريخ شكراً لمحمود",10,"د",1,0],["وقلَّ حياؤه بسؤال أمرٍ","دنيءٍ مثله عند الفخام",11,"م",1,0],["وقل حياة ذي القلوب إذ تموت","بذكر حيٍّ يا أخي لا يموتْ",12,"ت",1,0],["وَقل حينَما تَرجو بهِ نَيلَ مأربٍ","وَما ثمَّ إِلّا القرب يحسنُ مَأربا",13,"ب",2,0],["وقل حين تمشي في الندى وطيبها","ينم على أذيالها العطرات",14,"ت",1,0],["وقل حين هارون الكليم استنابه","أكان رئيس القوم أم كان مرؤوسا",15,"س",2,0]]}