tsgate.com/ViewPoem.aspx?id=208452",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5918,"طَوى الآفاقَ","https://www.poetsgate.com/ViewPoem.aspx?id=54708",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5943,"أخرجوا الأحياء من القبور","https://www.poetsgate.com/ViewPoem.aspx?id=61827",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[5956,"بباخرة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=183747",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["نُعانِقُ بيضاً كَأَنَّ الصَدا","بِأَطرافِها شَحبَةٌ أَو غَمَم",0,"م",1,0],["نُعانِقُ فيهِ أَبكارَ المَنايا","وَهُنَّ لِغَيرِ أَنفُسِنا ظُؤارُ",1,"ر",1,0],["نُعاقِرُ بِالضَمِّ كَأسَ العِناقِ","وَنَسفِكُ بِاللَثمِ خَمرَ الرُضابِ",2,"ب",1,0],["نُعاتِبُها وَالذَنبُ مِنها سَجيَّةٌ","وَمَن عاتَبَ الخَرقاءَ مَلَّ عِتابَها",3,"ب",3,0],["نَعاني إِلى فَوزٍ أُناسٌ يَسُرُّهُم","لَعَمرُ أَبيها أَن أَموتَ فَأُقصَدا",4,"د",2,1],["نُعاطيكُمُ بِالحَقِّ حَتّى تَبَيَّنوا","عَلى أَيِّنا تُؤدي الحُقوقَ فُضولُها",5,"ل",3,0],["نَعاكَ النُعاةُ وَحُمَّ القَدَر","وَلَم يُغنِ عَنّا وَعَنكَ الحَذَر",6,"ر",1,1],["نَعَاتِبُكُمْ وَنَعْلَمُ لَوْ مَلَكْتُمْ","سَبَقْتُمْ كُلَّ دَاعٍ بِالْجَوَابِ",7,"ب",1,0],["نعاه لي الناعي فكان كأنه","لدى نعيه أهوى إليّ بخنجر",8,"ر",1,0],["نَعَالِجُ مُرمَقَّاً من العَيشِ فَانِياً","له حَارِكٌ لا يَحمِلُ العِبءَ أجزَلُ",9,"ل",1,0],["نعائي جُذاماً غير موتٍ ولا قتل","ولكن فراقاً للدعائم والأصلِ",10,"ل",1,1],["نَعافُ قُطونَهُ وَنَمَلُّ مِنهُ","وَيَمنَعُنا الإِباءُ مِنَ الزِيالِ",11,"ل",1,0],["نعاهُ للفضلِ والعلياءِ والنسب","ناعيه للأرضِ والأفلاكِ والشهب",12,"ب",1,1],["نِعال كِنْبايةَ والعنبرُ","ومِسْك دارِينكُمُ الأذفرُ",13,"ر",1,1],["نعاء أمِّ أمير المؤمنين إلى","بيتٍ بمكة فالبطحاء معمور",14,"ر",1,0],["نعاء راعية المعروف رعيتَهُ","لكل عان بأرض الروم مأسور",14,"ر",1,0],["نعائي إليك النفس إن لم تُلافِها","فقد جعلت بين الحيازم ترتقي",15,"ق",2,0],["نعائي أبا يحيى إليك فإنَّهُ","تداعتْ معانيهِ وبادتْ معالمه",16,"م",2,0],["نَعّابَةٌ بَعدَ جَهدِ الأَينِ يُفزِعُها","صَوتٌ لِآخَرَ تالٍ بَعدَها يَقَعُ",17,"ع",1,0],["نَعاهُ لَنا الناعي فَكادَت بِنا الدُنى","تَميدُ لِهَولِ الخَطبِ خَطبِ المُروأَةِ",18,"ه",1,0],["نعالج شدة ونروض أخرى","ونسعى السعى مشروعا مباحا",19,"ح",2,0],["نَعاها لَنا الناعي فَمالَ عَلى أَبٍ","هَلوعٍ وَأُمٍّ بِالكِنانَةِ مِثكالِ",20,"ل",1,0],["نَعاهُ البَرقُ مُضطَرِباً فَماجَت","نُجومٌ في السَماءِ مُحَلِّقاتُ",21,"ت",1,0],["نِعامٌ رائِحٌ في يَومِ ريحٍ","وَلَيسَت في أَخِشَّتِها بَعيرِ",22,"ر",1,0],["نَعائي اِبنَ لَيلى لِلسَماحِ وَلِلنَدى","وَأَيدي شَمالٍ بارِداتِ الأَنامِلِ",23,"ل",1,1],["نَعاءِ إِلى كُلِّ حَيٍّ نَعاءِ","فَتى العَرَبِ اِحتَلَّ رَبعَ الفَناءِ",24,"ا",2,1],["نَعاءِ نَعاءِ شَقيقَ النَدى","إِلَيهِ نَعِيّاً قَليلَ الجَداءِ",24,"ا",2,0],["نَعَاءِ عَلَيْهِ أَيُّهَا الثَّقَلانِ","فَقَدْ أَقْصَدَتْهُ أَسْهُمُ الْحَدَثَانِ",25,"ن",1,1],["نُعاني لَدَيها بَعدَما خِلتُ أَنَّهُ","لَهُ الوَيلُ عَن نَعتي لَدَيها قَد اِضَرَبا",26,"ب",2,0],["نُعاوِدُهُ وَالكاسُ يَعبَقُ نَفحَةً","وَأَطيَبُ مِنهُ مانُعيدُ وَما نُبدي",27,"د",2,0],["نَعامٌ إِذا ما صيحَ في حَجَراتِكُم","وَأَنتُم إِذا لَم تَسمَعوا صارِخاً دُثُر",28,"ر",1,0],["نَعَاءِ ابْنَ عَفَّانَ الإِمَامَ لِمُجْتَدٍ","إذَا البرْقُ لِلرَّاجِي سَنَا البَرْقِ خُلَّبُ",29,"ب",1,0],["نَعَاءِ لِفَضْلِ الحِلْمِ والحَزْمِ والنَّدَى","ومَأْوَى اليَتَامَى الغُبْرِ عَامُوا وأَجْدَبُوا",29,"ب",3,0],["نَعَامَةُ لَمَّا صَرَّعَ القَومُ رهطَهُ","تَبَيَّنَ في أَثوابِهِ كَيفَ يَلبَسُ",30,"س",1,0],["نُعَاجِلُهُمْ إذَا نَهَضُوا إِلَيْنَا","بِضَرْبٍ يُعْجِلُ المتَسرِّعِينا",31,"ن",2,0],["نعاه لنا الناعِي فأفْزَعَ مِثْلَما","تُراعُ بِصَوْتٍ في الظلامِ رهيب",32,"ب",1,0],["نَعَاكَ لِيَ النُعَاةُ فَقُلْتُ مَيْنٌ","وَكَمْ يَأْسٍ تشَبَّثَ بالرجَاءِ",33,"ا",2,0],["نعامٌ إذا هم أبصروا رؤساؤهم","سباعٌ على الجمهور حُمْرُ المخالب",34,"ب",1,0],["نعاه الناس في شرق، وغرب","كأنهموا له صَحْبٌ، وآل",35,"ل",1,0],["نعامٌ إذا ما صيح في حجراتكم","وأنتمْ إذا لم تسمعوا صارخاً فما دثرْ",36,"ر",1,0],["نعاه لنا الناعي فكادت بنا الدّنى","تميد لّهول الخطب خطب المروءة",37,"ه",1,0],["نَعَاءِ عُرى الإسلامِ والعدلِ بعدَه","نَعاءِ! لقدْ نابَتْ على الناسِ نُوَّبُ",38,"ب",1,0],["نعاركها حتى يرى من خلالها","محاسن اخلاق الرجال ولؤمها",39,"م",3,0],["نعام عين شقيق النفس لو نصرت","أخاك حالٌ ولكن ليس تنصره",40,"ر",2,0],["نعاك لي الناعي فلا در دره","لقد طبق الدنيا وصيرها سجنا",41,"ن",2,0],["نَعاهُ لَنا الناعِي فَفِي كُل مِسمَعٍ","كَلامٌ وَلَكن في الأَضالعِ أَسهُمُ",42,"م",1,0],["نِعالُهم أينَما حلّوا أوِ اِرتَحلوا","عَلى رؤوسِ أَعاديهم أكاليلُ",43,"ل",1,0],["نعاك لسان الغيب في مسمع التقى","من البضعة الغراء يقصدها قصدا",44,"د",2,0],["نعارض بالصدود ظنونَ قومٍ","فتعترض الشكوك على اليقينِ",45,"ن",1,0],["نَعاماً بِخَطمَةَ صُعرَ الخُدو","دِ لا تَطعَمُ الماءَ إِلّا صِياما",46,"م",2,0],["نُعاني لها الناعونَ حُزناً وإنَّما","سَقاني بها الناعونَ كأسَ الأَسى صِرفا",47,"ف",2,0],["نُعاوِدُهُ لَحْداً بَكَتْهُ الغَمائِمُ","وَشُقَّتْ عليهِ لِلرِّياضِ كَمائِمُ",48,"م",1,1],["نُعَاهِدُ مَنْ نحبّ فلا نُجابُ","ونَمتَدحُ الملوكَ فَلاَ نُثابُ",49,"ب",1,1],["نعالج فيها لوعةً بحشاشةٍ","على الرَّسم منَّا نمزج الدَّمع بالدِما",50,"م",2,0],["نعاشر أهْلَهُ ونقيمُ فيه","بخفض العيش من حسن وطيب",51,"ب",1,0],["نُعانِي أَو نعايِنُ منه لفظاً","مُعاناً بالبلاغة لا مُعانَى",52,"ن",2,0],["نَعاءِ إِلَى ملوكِ الرُّومِ طُرَّاً","ذَوي التِّيجانِ غَرْسِيَةً نَعاءِ",53,"ا",2,0],["نعاودهم لعل خمي","ر رأي خلف صمتهم",54,"م",1,0],["نعاك ليَ الناعي فما كدتُ منكِرا","ليومك وهو الحقُّ أن أتيقَّنا",55,"ن",2,0],["نُعالج في الحبّ مُرّ الكِلامِ","ونقنَع منه بحُلوِ الكَلِمْ",56,"م",1,0],["نعاتب فيها الدهرَ لا كيف عتبُهُ","وأخلاقهُ إخلاقُ ما كان جَدَّدا",57,"د",2,0],["نُعاطي المُلوكَ السَلمَ ما قَصَدوا بِنا","وَلَيسَ عَلَينا قَتلُهُم بِمُحَرَّمِ",58,"م",1,0],["نعاجا قد بعثت بها عجافا","يصد هزالها عنها الذئابا",59,"ب",2,0],["نُعادي منْ يوالينا","نوالي منْ يعَاديْنا",60,"ن",2,0],["نعاك ناعٍ إلى قلبٍ كأنّ به","لواذعَ الجمر لمّا ساءَه الخبرُ",61,"ر",1,0],["نُعاتِبُ حيثُ لا نرجو الجَوابا","زَماناً ليسَ يَسْتمِعُ العِتابا",62,"ب",2,1],["نعاكَ ناعِيكَ تَلْويحاً مُخَافَتَةً","وقد نَعانيَ تَصْرِيحاً إِلى الأُمَم",63,"م",1,0],["نعاه فأدمى عليه الجفون","وأورى بقلبِ المَعالي شَرَر",64,"ر",1,0],["نعاه لي الناعي فأَكبرت نعيهُ","وقلت له ان المصابَ ثقيل",65,"ل",1,0],["نَعاه في يَوم تَعريفِ الحَجيج فَقَد","ضَجّوا وَعَجّوا أَسىً من حادِث نُكُرِ",66,"ر",1,0],["نعاه التقى والعلم والخلق والنهى","وأضحت بنو العليا مدامعها تجري",67,"ر",2,0],["نعالجه بالعتب حيناً وبالرضا","عسى أحد الأمرين فيه يفيد",68,"د",1,0],["نُعاطاها من الفجرِ","إلى الظهرِ إلى العصر",69,"ر",1,0],["نُعاطيها مساجلةً فأضحت","لنا تبدو بحلباتِ السِّباقِ",70,"ق",1,0],["نُعاِتبُ بعضَنا!هلْ مِن عِتابٍ","يَليقُ بنا سوى الدَمع ِالمُدَانِ",71,"ن",1,0],["نُعَاُب .. لأنَّا تَرَكنَا الرِّمَال","إلى الآخرينَ نِعَامَاً هزيلا",72,"ل",2,0],["نُعَابُ .. لأنَّا نُدينُ الأوْلَى يَقْ","تِلُونَ ولسْنا نُدينُ القيتلا",72,"ل",2,0],["نعالها الصخرة العُظمى وهامتها","الشِعّري وإكليلُها بالتاج كلَّلَها",73,"ل",3,0],["نُعَابُ والمعيبُ من يَعِيبُ","وما لنا مِنْ أمرنا مَعِيبُ",74,"ب",1,0],["نعاه المجد منتحباً عليه","وبات العز مفتقداً سطاهُ",75,"ا",2,0],["نُعانِقُ مِنْ رِماحِ الْخَطِّ باباً","وَنَنْشَقُ مِنْ سُيوفِ الْهِنْدِ وَرْدا",76,"د",2,0],["نَعاء إِلى المَكارِمِ وَالمَعالي","فَقيداً ما لِغَيبَتِهِ إِيابُ",77,"ب",1,0],["نعاهدك على البر وفاءً","وعهد الحُر دينٌ لا محالا",78,"ل",2,0],["نُعايِنُها نوراً جَلاهُ تَجَسُّدٌ","ونَشْرَبُها ناراً بِغَيْرِ حَريقِ",79,"ق",1,0],["نَعاءِ حمَيداً لِلسَرايا إِذا غَدَت","تُذادُ بِأَطرافِ الرِماحِ وَتوزَعُ",80,"ع",1,0],["نعاه لنا الناعي فجاوبه الصدى","ولو كان في الأحياء يدعة لأسمعا",81,"ع",2,0],["نعادي الذي عادى من الناس كلهم","جميعا وإن كان الحبيب المصافيا",82,"ي",2,0],["نُعالِجُ العَيشَ أَطواراً تَقَلُّبُهُ","فيه أَفانينُ تُطوى عَن أَفانينِ",83,"ن",1,0],["نعاكَ لها ناعٍ إليك أطارها","بدهياء راعَ الخافقينَ