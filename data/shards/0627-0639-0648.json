doWhat=shqas&qid=79547&r=&rc=1",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6290,"خُلِقْتُ كَبِيرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85162&r=&rc=8",""],[6333,"دمى فوق منضدة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7088&r=&rc=9",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""]],"verses":[["أَعودُ عَلى عُقوقِكُمُ بِحِلمي","إِذا خَطَرَ العُقوقُ لَكُم بِبالِ",0,"ل",1,0],["أَعوذُ بِالعَفوِ وَهَل آمِنٌ","نَذيرَةَ الصِلِّ إِذا نَضنَضا",1,"ض",2,0],["أَعودُ فَلا أَلقاهُ فيمَن يَعودَهُ","وَيَلقاهُ عُوّادٌ سِوايَ كَثيرُ",2,"ر",1,0],["أَعُوذُ بِعِزِّكَ يَاسَيِّدِي","لِذُلِّيَ مِنْ دَعْوَةِ الْبَاطِلِ",3,"ل",1,0],["أعوذُ بصَبْري منْ جُفونٍ مَريضَةٍ","لَها مَرَضٌ في القَلْبِ منّيَ لابِثُ",4,"ث",1,0],["أَعودُ عَلى المولى إِذا زَلَّ حِلمُهُ","بِحِلمي وَكانَ العَودُ أَبقى وَأَحمَدا",5,"د",2,0],["أعوذ بطيب خِيمِكَ من مِطالٍ","حماني ورد بحرِك ذي العُبابِ",6,"ب",1,0],["أعوذ بعزّ اللَّه من أن يضمَّني","وإيّاهُ في الأرض البسيطة جانبُ",7,"ب",1,0],["أَعوذ من عُسْرتي بيسركَ وال","أحرارُ بالأكرمين عُوّاذُ",8,"ذ",1,0],["أعوذ بحقْوَيْك العزيزينِ أن أُرى","مُقِرَّاً بضيمٍ يتركُ الوجهَ حالِكا",9,"ك",2,1],["أعونُ الناسِ لنيّا","كٍ على ظلم مَنيكِ",10,"ك",1,0],["اعوذ بالله ربي فهو يعصمني","اذا استعنت به من كل ابليس",11,"س",1,0],["أعوذ بعيد الملك من أن يمرّ بي","فلا يلتقي بي في غرامك سعده",12,"د",2,0],["أَعوامُ جُهدٍ في الشَبابِ وَراءَها","مِن جُهدِ خَيرِ كُهولَةٍ أَعوامُ",13,"م",1,0],["أَعوادُهُ بَينَ الرِجالِ وَأَصلُهُ","بَينَ السُهى وَالمُشتَري مَحمولُ",14,"ل",1,0],["أَعوَزَ الحَقَّ رائِدٌ","وَإِلى مُصطَفى اِفتَقَر",15,"ر",1,0],["أَعوذُ بِبَدرٍ مِن فِراقِ حَبيبي","وَمِن لَوعَتي في إِثرِهِ وَنَحيبي",16,"ب",2,1],["أَعوذُ بِالرَأي الجَميلِ الَّذي","عَوَّدتَهُ وَالنائِلِ المُستَماح",17,"ح",1,0],["أَعوَزَت دونَهُ القَناعةَ حَتّى","حَشَمَت في طِلابِهِ الأَسفارُ",18,"ر",1,0],["أَعودُ إِلى أَفياءِ أَرعَنَ شاهِقٍ","وَأَدرُجُ في أَفنانِ رَيّانَ أَخضَرِ",19,"ر",1,0],["أَعوذُ بِجَدواهُ الَّتي مَلَأَت يَدي","نَوالاً وَنُعماهُ الَّتي نَبَّهَت ذِكري",20,"ر",2,0],["أَعودُ في كُلِّ يَومٍ مِن تَطَوُّلِهِ","إِلى مُعادٍ مِنَ الإِحسانِ مَكرورِ",21,"ر",1,0],["أَعوَزَت مِن سِواكَ عارِفَةُ الجو","دِ وَخابَت في غَيرِكَ الآمالُ",22,"ل",1,0],["أَعوذُ بِقَبرٍ فيهِ أَكفانُ مُنذِرٍ","وَهُنَّ لِأَيدي المُستَجيرينَ مَحرَمُ",23,"م",1,0],["أَعوذُ بِبِشرٍ وَالمُعَلّى كِلَيهِما","بَني مالِكٍ أَوفى جِوارَن وَأَكرَمُ",23,"م",1,0],["أَعوذُ بِبِشرٍ وَالمُعَلّى وَمُنذِرٍ","سِماكانِ كانا ذو سِلاحٍ وَمُرزِمِ",23,"م",1,0],["أَعوذُ بِالرَحمَنِ أَن أَميلا","مِن عَزفِ جِنٍ أَظَهروا تَهويلا",24,"ل",2,1],["أعوزني الحبر ولا طاقة","بطبخه لي وبتكليفه",25,"ه",1,1],["أَعودُ حِمارَكُم في كُلِّ يَومٍ","إِذا ما ضَرَّهُ فَرطُ الشَعيرِ",26,"ر",1,1],["أُعَوِّلُ في وَقتِ العَليقِ عَليهِمُ","وَهَل عِندَ رَسمٍ دارِسٍ مِن مُعَوَّلِ",27,"ل",1,0],["أَعوَزَت بَغتَةً فَحالي مَوقو","فٌ وَقَلبي لِفَقدِها مَفقوذُ",28,"ذ",1,0],["أعولي يا جراح","اسمعي الدّيان",29,"ن",1,0],["أَعوامُ وَصلٍ كانَ يُنسي طولَها","ذِكرُ النَوى فَكَأَنَّها أَيّامُ",30,"م",1,0],["أعورُ كالبدرِ لهُ مقلةٌ","واحدةٌ قامَتْ مقامَ اثنتينِ",31,"ن",1,1],["أعورُ باليمنى إلى جنبِهِ","أعورُ باليسرى قدِ انضما",32,"م",2,1],["أعولتْ ورقٌ عليه أخضرا","وشَدَتْ غيدٌ عليه يابسا",33,"س",2,0],["أعوذُ باللهِ ربي","من شرِّ طاعونِ النسبْ",34,"ب",1,1],["أَعوذُ بِرَبِّ الناسِ مِن كُلِّ ظالِمٍ","وَأَشكو إِلَيهِ كُلَّ خَصمٍ مُماحِكِ",35,"ك",1,0],["أَعوذُ بِهِ مِن كُلِّ سوءٍ وَأَحتَمي","بِأَسمائِهِ مِن كُلِّ عادٍ وَفاتِكِ",35,"ك",1,0],["أَعوذُ بِجَدِّكَ إِنّي اِمرُؤٌ","سَقَتني الأَعادي إِلَيكَ السِجالا",36,"ل",2,0],["أَعُوذُ باللَّهِ أَنْ أَكُونَ كَمَنْ","تَغْلِبُهُ في الرَّقاعَةِ الرَّغْبَهْ",37,"ب",2,0],["أَعوذُ مِنكَ بِوَجهٍ","بَدرُ الدُجى في مِثالِه",38,"ل",2,0],["أَعوَجِيُّ الآباءِ شارَكَ فيهِ","لاحِقٌ وَالوَجيهُ ثُمَّ الغُرابُ",39,"ب",1,0],["أَعوذُ بِاللَهِ مِن وَرهاءَ قائِلَةٍ","لِزَوجِ إِنّي إِلى الحَمّامِ أَحتاجُ",40,"ج",1,1],["أَعُوّامَ بَحرٍ إِن أُصِبتُم فَهَيِّنٌ","وَإِن تَخلَصوا فَاللَهُ رَبُّكُمُ نَجّى",41,"ج",2,0],["أَعوذُ بِاللَهِ مِن أُلي سَفَةٍ","أَن يَعرِفوا عِلَّةَ الضَلالِ تُزَح",42,"ح",1,1],["أَعوذُ بِرَبِّيَ مِن سُخطِهِ","وَتَفريطِ نَفسي وَإِفراطِها",43,"ط",3,1],["أَعومُ اللُجَّ وَالحيتانُ حَولي","وَما أَنا مُحسِنٌ في ذاكَ عَومي",44,"م",2,0],["أَعوذُ بِالخالِقِ مِن مَعشَرٍ","إِذا غَلَت قِدرُهُم لَم تَدُم",45,"م",1,0],["أَعوَزَ الشَثُّ وَالسَلَم","وَأَديمي بِهِ حَلَم",46,"م",1,1],["أَعوذُ بِخالِقي مِن أَن يَراني","كَشاكِ النَبتِ لا يُجنى وَيَجني",47,"ن",2,0],["أَعوذُ بِاللَهِ مِن قَومٍ إِذا سَمِعوا","خَيراً أَسَرّوهُ أَو شَرّاً أَذاعوهُ",48,"ع",3,1],["أَعوَجيّاتٍ طِوالاً شُزَّباً","دوخِلَ الصَنعَةُ فيها وَالضُمُر",49,"ر",1,0],["أعوامُ إقبالِهِ كاليَّومِ في قِصَرٍ","ويومُ إعراضِه في الطّول كالحِججِ",50,"ج",1,0],["أعوذ بعثمان بن عفان منكما","وباللّه والبيت العتيق المحرم",51,"م",1,0],["اعوجّ من حقدهم ناسُ عليّ بها","وَهَكَذا الناس معوجٌّ ومعتدل",52,"ل",1,0],["أعودةُ الثائرِ المنفيِّ من سفرٍ","لا يبلغُ الوهمُ منه مفرقَ السُّبُلِ",53,"ل",1,0],["أَعوذُ بِكَ اللَهُمَّ أَن تَشحَطَ النَوى","بِبَثنَةَ في أَدنى حَياتي وَلا حَشري",54,"ر",2,0],["أَعُودُ إِلَيْكَ يَوْمَ أَنْفَكَّ أَسْرِي","كَسَارٍ عَادَ فِي أَنْفَاسِ فَجْرِ",55,"ر",1,0],["أَعْوَزَتْهَا سِيَاسَةُ الْمَالِ حَتَّى","عُدَّ إِثْرَاؤُهَا الْمُشَتَّتِ فَقْرَا",56,"ر",2,0],["أعود إليكِ.. والأيام صرعى","تمزّقها السنين.. ولا تبالي",57,"ل",2,0],["أَعوذُ بِاللَهِ مِن لَيلٍ يُقَرِّبُني","إِلى مُضاجَعَةٍ كَالدَلكِ بِالمَسَدِ",58,"د",1,1],["أعوذ ببدر من فراق الحبيب","ومن لوعة في أثره ونحيب",59,"ب",1,1],["أعُودُ إلى أفْيَاءِ أرْعَنَ شَاهِقٍ،","وأدْرُجُ في أفْنَاءِ رَيّانَ أخْضَرِ",60,"ر",1,0],["أعُوّامَ بحرٍ، إن أُصِبْتُمْ فهيّنٌº","وإن تَخلَصوا، فاللَّه ربُّكمُ نجّا",61,"ج",2,0],["أعوذُ باللَّهِ منْ ورْهاءَ قائلةٍ،","للزّوج: إني إلى الحمّامِ أحتاجُ",62,"ج",1,1],["أعوذُ باللَّهِ من أُولي سَفَهٍ،","أن يَعرِفوا عِلّةَ الضّلالِ تُزَحْ",63,"ح",1,1],["أعُوذُ بِبِشْرٍ وَالمُعَلّى كِلَيْهِمَا،","بَني مَالكٍ أوْفَى جِوَاراً وَأكْرَمُ",64,"م",1,0],["أعودة الثّائر النفيذ من سفر","لا يبلغ الوهم منه مفرق السّبل ؟",65,"ل",1,0],["أعوذ من ذكريك بالصبر","وأين مني راحة الصبر",66,"ر",1,0],["أعوذُ بك اللهمَّ من شرِّ ماردٍ","غوىٍّ يرى إن مسَّنا الضر مَغْنَما",67,"م",2,0],["أعوذ بك اللهم من فقر ساعة","كما بك من سوء الأذى نتعوَّذُ",68,"ذ",1,1],["أَعوذُ بِرَبِّ الناسِ مِن كُلِّ طاعِنٍ","عَلَينا بِسوءٍ أَو مُلِحٍّ بِباطِلِ",69,"ل",1,0],["أعوذ بحسن رأيك منك فيها","وأن ألقَى من الخُصماء خَبلا",70,"ل",2,0],["أعوزت نفسك فانظر كيف صرت به","يا دهر أعمى ضئيلا تشتكي الشللا",71,"ل",2,0],["أعوذ بالرحمن من كان مسلماً","من الزيغ عن نهج الهدى واتوب",72,"ب",1,0],["أعوذُ باللهِ من سَحّاقةٍ مَلكتْ","زِمَامَ قلبي لا من غاسِقٍ وَقِبا",73,"ب",2,1],["أعوانه ببابه قعودُ","بيضٌ ومنهم آخرون سود",74,"د",1,0],["اعوذها وقد زارت بليل","برب الناس من واش نموم",75,"م",1,0],["أعود إلى الأيام أحصى ذنوبها","وكل وجود في الوجود إلى ذنب",76,"ب",1,0],["أعوذ باللَه من يوم تصول به","وقت الظهيرة أمطارٌ وأرعاد",77,"د",1,1],["أعود إلى الذكرى أعود فإنها","بقية ما أبقى الفراق المفرّق",78,"ق",1,0],["أعوذ بالحب وهو المالك الآمر","من أن يخيب رجائي فيك يا ساحر",79,"ر",1,0],["أعود إليها كيف أسيوط قبلتي","إذا صلصل الوجد العصوف المزلزل",80,"ل",1,0],["أعود ولكن كيف لا المال فائض","ولا الدهر عن حرب المتيم يغفل",80,"ل",1,0],["أعود للوطن الغالي وأحضنه","إن كان لي عودةٌ للموطن الغالي",81,"ي",1,0],["أعودُ وحدي أعود","وفي الجوانح نار",82,"ر",1,1],["أعود إلى الأحلام أستاف زهرها","فيذهلني ذاك الذبول المروع",83,"ع",1,0],["أعوذ بربّ الجنّ منكم وإنني","لأعلم أن لا عوذ من سورة الوجد",84,"د",1,0],["أعومُ بحارَ الدَّمْعِ مني وإنني","ببحرِ وِدادٍ مِنْكُمُ لَغَرِيقُ",85,"ق",1,0],["أعوذ بحسن وجهك أن","أسوم هواك بالسأم",86,"م",1,0],["أَعوَرَت شَهوَةٌ من الحُبِّ عَينَي","هِ وَكَم أَعوَرَ الهَوى مِن بَصيرِ",87,"ر",1,0],["أَعُوذُ بِالْحُبِّ حُبِّي لِشَمَائِلِكُمْ","مِنْ أَنْ أَكُونَ حَبِيباً مِثْلَ مَهْجُورِ",88,"ر",1,0],["أعودُ إلى نفسي فإن كان صادِقاً","عَتَبتُ على نفسي واصلحت من أمري",89,"ر",2,0],["أَعوذُ بِرَبّي مِنَ المُخزِيا","تِ يَومَ تَرى النَفسُ أَعمالَها",90,"ل",3,0],["أَعوذ بِالحُبّ مِمَّن لَم يذُب كَلف