"https://www.aldiwan.net/poem46314.html","الطويل"],[209,"أعوذ بالله من يوم تصول به","https://www.aldiwan.net/poem46586.html","البسيط"],[209,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[209,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[209,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[209,"منازل كانت جلوة العين والحشا","https://www.aldiwan.net/poem46626.html","الطويل"],[209,"أعود وحدي أعود","https://www.aldiwan.net/poem46767.html","المجتث"],[209,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[210,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[220,"لوصفك ينتمي كلمي","https://www.aldiwan.net/poem55424.html","مجزوء الوافر"],[221,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[235,"يا سيدي سيد الجمهور جمهور","https://www.aldiwan.net/poem18816.html","البسيط"],[239,"سقاها وحيا تربها وابل القطر","https://www.aldiwan.net/poem45764.html","الطويل"],[258,"وقافيةٍ غير إنسيةٍ","https://www.aldiwan.net/poem1112.html",""],[351,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[351,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[364,"بناني فيكم مثل يحيى بن طالب","https://www.aldiwan.net/poem17326.html","الطويل"],[388,"إلى الله أشكو داء قلبي وقالبي","https://www.aldiwan.net/poem54639.html","عموديه"],[397,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[406,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[413,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[429,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[441,"الرقة البيضاء تشكو ولا","https://www.aldiwan.net/poem56022.html","عموديه"],[456,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[464,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[480,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[512,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[573,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["أَعودُ عَلى عُقوقِكُمُ بِحِلمي","إِذا خَطَرَ العُقوقُ لَكُم بِبالِ",0,"ل",1,0],["أَعوذُ بِالعَفوِ وَهَل آمِنٌ","نَذيرَةَ الصِلِّ إِذا نَضنَضا",1,"ض",2,0],["أَعودُ فَلا أَلقاهُ فيمَن يَعودَهُ","وَيَلقاهُ عُوّادٌ سِوايَ كَثيرُ",2,"ر",1,0],["أَعُوذُ بِعِزِّكَ يَاسَيِّدِي","لِذُلِّيَ مِنْ دَعْوَةِ الْبَاطِلِ",3,"ل",1,0],["أعوذُ بصَبْري منْ جُفونٍ مَريضَةٍ","لَها مَرَضٌ في القَلْبِ منّيَ لابِثُ",4,"ث",1,0],["أَعودُ عَلى المولى إِذا زَلَّ حِلمُهُ","بِحِلمي وَكانَ العَودُ أَبقى وَأَحمَدا",5,"د",2,0],["أعوذ بطيب خِيمِكَ من مِطالٍ","حماني ورد بحرِك ذي العُبابِ",6,"ب",1,0],["أعوذ بعزّ اللَّه من أن يضمَّني","وإيّاهُ في الأرض البسيطة جانبُ",7,"ب",1,0],["أَعوذ من عُسْرتي بيسركَ وال","أحرارُ بالأكرمين عُوّاذُ",8,"ذ",1,0],["أعوذ بحقْوَيْك العزيزينِ أن أُرى","مُقِرَّاً بضيمٍ يتركُ الوجهَ حالِكا",9,"ك",2,1],["أعونُ الناسِ لنيّا","كٍ على ظلم مَنيكِ",10,"ك",1,0],["اعوذ بالله ربي فهو يعصمني","اذا استعنت به من كل ابليس",11,"س",1,0],["أعوذ بعيد الملك من أن يمرّ بي","فلا يلتقي بي في غرامك سعده",12,"د",2,0],["أَعوامُ جُهدٍ في الشَبابِ وَراءَها","مِن جُهدِ خَيرِ كُهولَةٍ أَعوامُ",13,"م",1,0],["أَعوادُهُ بَينَ الرِجالِ وَأَصلُهُ","بَينَ السُهى وَالمُشتَري مَحمولُ",14,"ل",1,0],["أَعوَزَ الحَقَّ رائِدٌ","وَإِلى مُصطَفى اِفتَقَر",15,"ر",1,0],["أَعوذُ بِبَدرٍ مِن فِراقِ حَبيبي","وَمِن لَوعَتي في إِثرِهِ وَنَحيبي",16,"ب",2,1],["أَعوذُ بِالرَأي الجَميلِ الَّذي","عَوَّدتَهُ وَالنائِلِ المُستَماح",17,"ح",1,0],["أَعوَزَت دونَهُ القَناعةَ حَتّى","حَشَمَت في طِلابِهِ الأَسفارُ",18,"ر",1,0],["أَعودُ إِلى أَفياءِ أَرعَنَ شاهِقٍ","وَأَدرُجُ في أَفنانِ رَيّانَ أَخضَرِ",19,"ر",1,0],["أَعوذُ بِجَدواهُ الَّتي مَلَأَت يَدي","نَوالاً وَنُعماهُ الَّتي نَبَّهَت ذِكري",20,"ي",1,0],["أَعودُ في كُلِّ يَومٍ مِن تَطَوُّلِهِ","إِلى مُعادٍ مِنَ الإِحسانِ مَكرورِ",21,"ر",1,0],["أَعوَزَت مِن سِواكَ عارِفَةُ الجو","دِ وَخابَت في غَيرِكَ الآمالُ",22,"ل",1,0],["أَعوذُ بِقَبرٍ فيهِ أَكفانُ مُنذِرٍ","وَهُنَّ لِأَيدي المُستَجيرينَ مَحرَمُ",23,"م",1,0],["أَعوذُ بِبِشرٍ وَالمُعَلّى كِلَيهِما","بَني مالِكٍ أَوفى جِوارَن وَأَكرَمُ",23,"م",1,0],["أَعوذُ بِبِشرٍ وَالمُعَلّى وَمُنذِرٍ","سِماكانِ كانا ذو سِلاحٍ وَمُرزِمِ",23,"م",1,0],["أَعوذُ بِالرَحمَنِ أَن أَميلا","مِن عَزفِ جِنٍ أَظَهروا تَهويلا",24,"ل",2,1],["أعوزني الحبر ولا طاقة","بطبخه لي وبتكليفه",25,"ه",1,1],["أَعودُ حِمارَكُم في كُلِّ يَومٍ","إِذا ما ضَرَّهُ فَرطُ الشَعيرِ",26,"ر",1,1],["أُعَوِّلُ في وَقتِ العَليقِ عَليهِمُ","وَهَل عِندَ رَسمٍ دارِسٍ مِن مُعَوَّلِ",27,"ل",1,0],["أَعوَزَت بَغتَةً فَحالي مَوقو","فٌ وَقَلبي لِفَقدِها مَفقوذُ",28,"ذ",1,0],["أعولي يا جراح","اسمعي الدّيان",29,"ن",1,0],["أَعوامُ وَصلٍ كانَ يُنسي طولَها","ذِكرُ النَوى فَكَأَنَّها أَيّامُ",30,"م",1,0],["أعورُ كالبدرِ لهُ مقلةٌ","واحدةٌ قامَتْ مقامَ اثنتينِ",31,"ن",1,1],["أعورُ باليمنى إلى جنبِهِ","أعورُ باليسرى قدِ انضما",32,"م",2,1],["أعولتْ ورقٌ عليه أخضرا","وشَدَتْ غيدٌ عليه يابسا",33,"س",2,0],["أعوذُ باللهِ ربي","من شرِّ طاعونِ النسبْ",34,"ب",1,1],["أَعوذُ بِرَبِّ الناسِ مِن كُلِّ ظالِمٍ","وَأَشكو إِلَيهِ كُلَّ خَصمٍ مُماحِكِ",35,"ك",1,0],["أَعوذُ بِهِ مِن كُلِّ سوءٍ وَأَحتَمي","بِأَسمائِهِ مِن كُلِّ عادٍ وَفاتِكِ",35,"ك",1,0],["أَعوذُ بِجَدِّكَ إِنّي اِمرُؤٌ","سَقَتني الأَعادي إِلَيكَ السِجالا",36,"ل",2,0],["أَعُوذُ باللَّهِ أَنْ أَكُونَ كَمَنْ","تَغْلِبُهُ في الرَّقاعَةِ الرَّغْبَهْ",37,"ب",2,0],["أَعوذُ مِنكَ بِوَجهٍ","بَدرُ الدُجى في مِثالِه",38,"ل",2,0],["أَعوَجِيُّ الآباءِ شارَكَ فيهِ","لاحِقٌ وَالوَجيهُ ثُمَّ الغُرابُ",39,"ب",1,0],["أَعوذُ بِاللَهِ مِن وَرهاءَ قائِلَةٍ","لِزَوجِ إِنّي إِلى الحَمّامِ أَحتاجُ",40,"ج",1,1],["أَعُوّامَ بَحرٍ إِن أُصِبتُم فَهَيِّنٌ","وَإِن تَخلَصوا فَاللَهُ رَبُّكُمُ نَجّى",41,"ج",2,0],["أَعوذُ بِاللَهِ مِن أُلي سَفَةٍ","أَن يَعرِفوا عِلَّةَ الضَلالِ تُزَح",42,"ح",1,1],["أَعوذُ بِرَبِّيَ مِن سُخطِهِ","وَتَفريطِ نَفسي وَإِفراطِها",43,"ط",3,1],["أَعومُ اللُجَّ وَالحيتانُ حَولي","وَما أَنا مُحسِنٌ في ذاكَ عَومي",44,"ي",1,0],["أَعوذُ بِالخالِقِ مِن مَعشَرٍ","إِذا غَلَت قِدرُهُم لَم تَدُم",45,"م",1,0],["أَعوَزَ الشَثُّ وَالسَلَم","وَأَديمي بِهِ حَلَم",46,"م",1,1],["أَعوذُ بِخالِقي مِن أَن يَراني","كَشاكِ النَبتِ لا يُجنى وَيَجني",47,"ي",1,0],["أَعوذُ بِاللَهِ مِن قَومٍ إِذا سَمِعوا","خَيراً أَسَرّوهُ أَو شَرّاً أَذاعوهُ",48,"ع",3,1],["أَعوَجيّاتٍ طِوالاً شُزَّباً","دوخِلَ الصَنعَةُ فيها وَالضُمُر",49,"ر",1,0],["أعوامُ إقبالِهِ كاليَّومِ في قِصَرٍ","ويومُ إعراضِه في الطّول كالحِججِ",50,"ج",1,0],["اعوجّ من حقدهم ناسُ عليّ بها","وَهَكَذا الناس معوجٌّ ومعتدل",51,"ل",1,0],["أعودةُ الثائرِ المنفيِّ من سفرٍ","لا يبلغُ الوهمُ منه مفرقَ السُّبُلِ",52,"ل",1,0],["أَعوذُ بِكَ اللَهُمَّ أَن تَشحَطَ النَوى","بِبَثنَةَ في أَدنى حَياتي وَلا حَشري",53,"ي",1,0],["أَعُودُ إِلَيْكَ يَوْمَ أَنْفَكَّ أَسْرِي","كَسَارٍ عَادَ فِي أَنْفَاسِ فَجْرِ",54,"ر",1,0],["أَعْوَزَتْهَا سِيَاسَةُ الْمَالِ حَتَّى","عُدَّ إِثْرَاؤُهَا الْمُشَتَّتِ فَقْرَا",55,"ر",2,0],["أعود إليكِ.. والأيام صرعى","تمزّقها السنين.. ولا تبالي",56,"ي",1,0],["أَعوذُ بِاللَهِ مِن لَيلٍ يُقَرِّبُني","إِلى مُضاجَعَةٍ كَالدَلكِ بِالمَسَدِ",57,"د",1,1],["أعوذ ببدر من فراق الحبيب","ومن لوعة في أثره ونحيب",58,"ب",1,1],["أعُودُ إلى أفْيَاءِ أرْعَنَ شَاهِقٍ،","وأدْرُجُ في أفْنَاءِ رَيّانَ أخْضَرِ",59,"ر",1,0],["أعُوّامَ بحرٍ، إن أُصِبْتُمْ فهيّنٌº","وإن تَخلَصوا، فاللَّه ربُّكمُ نجّا",60,"ج",2,0],["أعوذُ باللَّهِ منْ ورْهاءَ قائلةٍ،","للزّوج: إني إلى الحمّامِ أحتاجُ",61,"ج",1,1],["أعوذُ باللَّهِ من أُولي سَفَهٍ،","أن يَعرِفوا عِلّةَ الضّلالِ تُزَحْ",62,"ح",1,1],["أعُوذُ بِبِشْرٍ وَالمُعَلّى كِلَيْهِمَا،","بَني مَالكٍ أوْفَى جِوَاراً وَأكْرَمُ",63,"م",1,0],["أعوذ من ذكريك بالصبر","وأين مني راحة الصبر",64,"ر",1,0],["أعوذُ بك اللهمَّ من شرِّ ماردٍ","غوىٍّ يرى إن مسَّنا الضر مَغْنَما",65,"م",2,0],["أعوذ بك اللهم من فقر ساعة","كما بك من سوء الأذى نتعوَّذُ",66,"ذ",1,1],["أَعوذُ بِرَبِّ الناسِ مِن كُلِّ طاعِنٍ","عَلَينا بِسوءٍ أَو مُلِحٍّ بِباطِلِ",67,"ل",1,0],["أعوذ بحسن رأيك منك فيها","وأن ألقَى من الخُصماء خَبلا",68,"ل",2,0],["أعوزت نفسك فانظر كيف صرت به","يا دهر أعمى ضئيلا تشتكي الشللا",69,"ل",2,0],["أعوذ بالرحمن من كان مسلماً","من الزيغ عن نهج الهدى واتوب",70,"ب",1,0],["أعوذُ باللهِ من سَحّاقةٍ مَلكتْ","زِمَامَ قلبي لا من غاسِقٍ وَقِبا",71,"ب",2,1],["أعوانه ببابه قعودُ","بيضٌ ومنهم آخرون سود",72,"د",1,0],["اعوذها وقد زارت بليل","برب الناس من واش نموم",73,"م",1,0],["أعود إلى الأيام أحصى ذنوبها","وكل وجود في الوجود إلى ذنب",74,"ب",1,0],["أعوذ باللَه من يوم تصول به","وقت الظهيرة أمطارٌ وأرعاد",75,"د",1,1],["أعود إلى الذكرى أعود فإنها","بقية ما أبقى الفراق المفرّق",76,"ق",1,0],["أعوذ بالحب وهو المالك الآمر","من أن يخيب رجائي فيك يا ساحر",77,"ر",1,0],["أعود إليها كيف أسيوط قبلتي","إذا صلصل الوجد العصوف المزلزل",78,"ل",1,0],["أعود ولكن كيف لا المال فائض","ولا الدهر عن حرب المتيم يغفل",78,"ل",1,0],["أعود للوطن الغالي وأحضنه","إن كان لي عودةٌ للموطن الغالي",79,"ي",1,0],["أعودُ وحدي أعود","وفي الجوانح نار",80,"ر",1,1],["أعود إلى الأحلام أستاف زهرها","فيذهلني ذاك الذبول المروع",81,"ع",1,0],["أعوذ بربّ الجنّ منكم وإنني","لأعلم أن لا عوذ من سورة الوجد",82,"د",1,0],["أعومُ بحارَ الدَّمْعِ مني وإنني","ببحرِ وِدادٍ مِنْكُمُ لَغَرِيقُ",83,"ق",1,0],["أعوذ بحسن وجهك أن","أسوم هواك بالسأم",84,"م",1,0],["أَعوَرَت شَهوَةٌ من الحُبِّ عَينَي","هِ وَكَم أَعوَرَ الهَوى مِن بَصيرِ",85,"ر",1,0],["أَعُوذُ بِالْحُبِّ حُبِّي لِشَمَائِلِكُمْ","مِنْ أَنْ أَكُونَ حَبِيباً مِثْلَ مَهْجُورِ",86,"ر",1,0],["أعودُ إلى نفسي فإن كان صادِقاً","عَتَبتُ على نفسي واصلحت من أمري",87,"ر",2,0],["أَعوذُ بِرَبّي مِنَ المُخزِيا","تِ يَومَ تَرى النَفسُ أَعمالَها",88,"ل",3,0],["أَعوذ بِالحُبّ مِمَّن لَم يذُب كَلفاً","بِالغانيات وَلم يَعذر بِها دنفا",89,"ف",2,0],["أَعواءٌ يَعبأ اللَيث بِهِ","مِن ذِئابٍ أَو طَنينٌ مِن ذُبابِ",90,"ب",1,0],["أَعودُ إِلى دارٍ بِغَيرِ كِفايَةٍ","وَأَركَبُ مِن داري إِلَيكُم بِلا شُغلِ",91,"ل",1,0],["أعوذ بوجه الله من كل ما اختشى","وإحسانه من كل شر وناكب",92,"ب",1,0],["أعوذ بخالقي من سوء فعلٍ","يصوّره ضلالكم التزاما",93,"م",2,0],["أعوانُ عادِيةِ الأيّامِ والزّمنِ","بغياً وكُفراً لِمَا أوليتَ من مِنَنِ",94,"ن",1,0],["أعوَاذِلي كُفّوا فَليس بِمُسمعِي","نُصْحٌ وبعضُ النّاصحينَ مَلُومُ",95,"م",1,0],["أعوذ ببأسه من كلِّ خطبٍ","فقد أضحى على الدُّنيا عقالا",96,"ل",2,0],["أعوذُ من هجرانِه وصدّه","بلطفِ ذي العرشِ القديم الأزلي",97,"ي",1,0],["أَعوذُ بِقَرْعِ المَوْجِ فِي جَنَبَاتِها","إِلَيْكَ بنا أن يَقْرَعَ السِّنَّ نادِمُ",98,"م",1,0],["أعوذ بالله فمذ حلها","أيقظ للفتنة شيطانها",99,"ن",3,0],["أعوذ من ليني لهم بجَعَدي","ومن ذحولي بينهم ببُلُسي",100,"س",2,0],["أَعوذُ بِنَجدَيكَ الكَريمَينِ أَن يَرى","لَنا حاسِداً في غُبَّرِ الوَصلِ مَطمَعا",101,"ع",2,0],["أعوذ برب العرش من كل حادث","يقيني ويحميني وأهلي وماليا",102,"ي",2,0],["أعوذُ من الزّمانِ ومن نَواهُم","بربِّ المجدِ والمولى المُهابِ",103,"ب",1,0],["أعوذُ بالله من نُبلِ الهَوى فلقد","رَمَى فراحَ يشُقُّ القلبَ من أَمَمِ",104,"م",1,0],["أعوذ بالله من علمٍ بلا عملٍ","ومن تَدارُكِ نفسٍ كَلَّ راعيها",105,"ي",3,0],["أَعُودُ إِلى همِّي بِبُعْدِك إِنَّه","أَباحَ الحَشَا للهمِّ والجسمَ للضَّنى",106,"ن",2,0]]}