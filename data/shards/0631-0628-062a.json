{"poems":[[31,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[87,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[82,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[71,"ودقاق يدق قفا عذولي","https://www.aldiwan.net/poem29004.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85717","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[255,"زيارة قبر المصطفى غاية المنى","https://www.aldiwan.net/poem15064.html","الطويل"],[275,"يا بنت يعرب هل للكرب تنفيس","https://www.aldiwan.net/poem35307.html","البسيط"],[276,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[358,"علام يلوم العاذلون على وجدي","https://www.aldiwan.net/poem40389.html","الطويل"],[396,"يا طبيب القلوب قلبي عليل","https://www.aldiwan.net/poem54534.html","عموديه"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[484,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[505,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54046","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64894","السريع"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128301","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64552","الخفيف"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107350","الكامل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95218","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93951","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93835","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205430","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205011","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3825,"","https://poetry.dctabudhabi.ae/diwan/poem/206310","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133259","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81716","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28713","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58160","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58158","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119565","السريع"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52167","الرمل"],[4767,"أهوى الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=180313",""],[4767,"كف الجود","https://www.poetsgate.com/ViewPoem.aspx?id=198231",""],[4978,"مع منى سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=177219",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5759,"كيف الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=213994",""],[5952,"بوذا","https://www.poetsgate.com/ViewPoem.aspx?id=200108",""],[5956,"حفيدٌ لم تُرْضهِ ضحكةُ جَدِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206258",""],[161,"شهادة ميلاد هبة الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=166671",""],[6311,"نغم المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63488&r=&rc=7",""]],"verses":[["رَبَت وَرَبا في حَجرِها اِبنُ مَدينَةٍ","يَظَلُّ عَلى مِسحاتِهِ يَتَرَكَّلُ",0,"ل",1,0],["ربت كندمان الملوك خلالهم","وتجملوا بمروءة وسماح",1,"ح",1,0],["ربّتْهُ في النيرانِ كَفّا قَيْنِهِ","فهو الزّنادُ لهنّ يوم حروبهِ",2,"ب",2,0],["رَبَتْ أردافهُ إذ دَقَّ خصراً","فقلتُ له بِكَمْ هذا الدقيقُ",3,"ق",1,0],["ربتك حانية يو","م أَنت في المهد طفلُ",4,"ل",1,1],["ربَّتي ربَّةُ أشعاري وحُبِّي وغنائي","هي حوريَّةُ غابٍ لم تَبنْ للشعراءِ",5,"ا",2,1],["رَبَّتهُ فُرسانها فَلا قسطٌ","في الخَيلِ إِلّا دَرى وَلا صبغا",6,"غ",2,0],["رَبتْ في فؤادٍ بالتشاحُنِ غارِقٍ","مليءٍ ، وفي سمَّ الحزازاتِ ناقع",7,"ع",1,0],["رَبَت هِمَّةٌ منه على المالِ والغِنَى","فذَلَّت له الأملاكُ وهو عَزيزُ",8,"ز",1,0],["رَبَّتكِ بغدادُ أم رَبَّتك قرطبةٌ","ماذا أقولُ ومن أهليك بَلقيس",9,"س",1,0],["ربت في ريف رأفته البرايا","وَطيرا الجوبل وحش القفار",10,"ر",1,0],["ربت في ربى نَجد وَعَن طَبعِها رَوَت","نَسيم الصبا بَينَ العباهر وَالرندِ",11,"د",1,0],["رب توبا توبا نصوحا نصوحا","خالصه صادقه لقربك تتيل",12,"ل",1,0],["ربَتْ فهي ذاتُ الوَدْعِ في حُجُراته","وشَبَّتْ فهذا شيبُها والتكهُّلُ",13,"ل",1,0],["رَبَتْ مع الزمان وهو يافع","واكتهل الدهرُ مع اكتهالها",14,"ل",3,0],["رَبتْ يا آلَ أيّوبٍ وأَثَّت","رُبايَ بكم على السَّنَةِ الجمادِ",15,"د",1,0],["ربتي الحسنا ربها","وهب الحسن ما وهب",16,"ب",1,0],["ربَّتْهُ معنًى في جميع شُؤُنِهِ","روحُ الإمامِ الأَحمَدِيِّ أبي علي",17,"ل",2,0],["ربتك في حجراتها بل حجرها","ولبست حلة فخرها متسربلا",18,"ل",2,0],["رُبَّ تقوى رُبَّ نجوى","رُبَّ عِلمٍ رُبَّ حِلمِ",19,"م",1,0],["رب تعالى أن يحاط بكنهه","وعلا على النظراء والأشباهِ",20,"ا",2,0],["رَبُّ تَقَىً يُشْعِرُ أَنَّه","مِنْ أَكْرمِ الخَلْقِ على الخالقِ",21,"ق",1,0],["رب تعالى فلا شيء يحيط به","وهو المحيط بنا في كل مرتصد",22,"د",1,0],["رب تدارك من ترى شكواه","بحق لا إله إلا اللّه",23,"ه",1,0],["رب تعطي لحكمة بالمقادي","ر وتعطي بغير وزن وكيل",24,"ل",1,0],["ربٌّ تسامى رأفةً فمذكر","نعماهُ ذاك البحرُ سوف القلزمُ",25,"م",1,0],["رُبَّ ترَّابٍ مليحٍ","أورثَ القلبَ عَذابا",26,"ب",2,1],["رب تيه ودلال","واحد فرد ودود",27,"د",1,0],["ربته أيدي العز في حجر العلى","حتى نشا نعم الرشا الربيب",28,"ب",1,0],["ربت همومي فنبا مضجعي","وصاحب الآلام لا يهجع",29,"ع",1,0],["رب تخت سموه تخت منام","وهو حقا مكسر للعظام",30,"م",1,1],["رَبَت بمهدِ سنا الإِعزاز باهيةً","وقد زهت دولةً من سالف الطِوَلِ",31,"ل",1,0],["رَبَّته قابلةُ الخلافةِ فانْتَشا","بَعْلاً لَهَا فلَيهنأنَّ نِكاحا",32,"ح",2,0],["رَبٌّ تُنعِّمُهُ بأَبناءِ الوَرَى","ان الشقاءَ لَمِن تنعمهُ ابى",33,"ا",1,0],["رَبَّتكَ في حِجر التُقَى وعَقَقتَها","أَتَحِلُّ منك خِيانةُ الأَثداءِ",34,"ا",2,0],["ربت باللَّبان معاً والدِّهانِ","كأَنْ قد رَبَتْ بين أُمٍّ وأَبْ",35,"ب",1,0],["رب تمم مقصدى ياذا الغنى","فأرى بالسفح هاتيك الخيام",36,"م",1,0],["ربٌّ تقدَّس في سلطانِهِ وعلا","وجلَّ عن كلِّ ما قدْ قال مؤتَفِك",37,"ك",1,0],["رُبَّتَ دار بَعدَ عِمرانِها","أَضحَت خَلاءً ما بِها آهِلُ",38,"ل",1,1],["ربٌّ تبارَكَ عن ضِدٍّ وعن وَلَدٍ","سبحانَه من حَمأِ الطينِ أبدانَا",39,"ن",2,0],["ربٌّ تفرَّدَ بالبَقَا عن خَلْقِهِ","يُحْيِي يُمِيتُ وما سِواهُ فَانِي",40,"ن",2,0],["ربّت دار بعد عمرانها","أضحت خرابا ما بها آهل",41,"ل",1,1],["ربَّ تلك الروضةٍ الغنّاءِ","والموتُ ابتلاها",42,"ا",3,0],["ربَّته والمولى الكريمَ دعَت","أن يرفع المكروه بالنجوى",43,"و",2,0],["ربَتْ منها الوِهادُ وكلُّ أرضٍ","إلى أن أثمرتْ تلك الحقول",44,"ل",1,0],["ربّت على القلب، إن القلب منتظر","حنو كفّك يبقى ذلك الأمل",45,"ل",1,0],["رب توفيقك الذي نتمنى","في ابتداء وفي ختام نزيه",46,"ي",2,0],["ربَّ تلْميذٍ يرْتَجي أنْ يرى","أسْتاذَهُ سالِماً بقلْبٍ مَشوقِ",47,"ق",1,0],["رَبَّتكِ أمُّكِ ياسُهدي لِتسهيدي","يامَن تحَكَّمتِ في سَعدي وتنكيدي",48,"د",2,1],["ربٌ تنالُ الريحُ مِنْ عليائِهِ","وتجرُّهُ لِمهانةٍ مأخوذا",49,"ذ",2,0],["ربَّتْهُ أسرتُه ليصبحَ رائدا","علاّمة ليقود جيلا صاعدا",50,"د",2,0],["13- ربِّ تَوَلاَّهَا بِطُهْرِ سَرِيرَةٍ","يَا رَبِّ وَاحْفَظْهَا مِنَ الشَّيْطَانِ",51,"ن",1,0],["ربت على كتف المساء فربما","عزف المساء على هواك فأطربا",52,"ب",2,1],["ربت على كف المساء فربما","صلى المساء على يديك تقربا",52,"ب",2,0],["ربت على كف المساء فربما","سقط الشتاء على يديك مخضبا",52,"ب",2,0]]}