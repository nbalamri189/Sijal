{"poems":[[53,"جرعتني غصصا ورحت مسلما","https://www.aldiwan.net/poem29966.html","الكامل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[71,"ألغزت في شيء","https://www.aldiwan.net/poem3852.html","مجزوء الكامل"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[27,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[23,"ولقد بكيت وعز مهلك جعفر","https://www.aldiwan.net/poem21429.html","الكامل"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[70,"يا مليحا لي منه","https://www.aldiwan.net/poem42402.html","مجزوء الرمل"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[31,"بانت سليمى فالفؤاد قريح","https://www.aldiwan.net/poem42590.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"زنبور يا خنزير يا ابن الزانية","https://www.aldiwan.net/poem66238.html","الكامل"],[50,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[31,"بَانَتْ سُلَيْمى فَکلفُؤادُ قَرِيحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18813&r=&rc=76",""],[141,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[141,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[141,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[158,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[164,"ولقد جذبت إلي عقرب صدغها","https://www.aldiwan.net/poem47063.html","الكامل"],[167,"يا شمس دين الله كم لك من يد","https://www.aldiwan.net/poem1625.html",""],[259,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[268,"لم أنس ليلا بالنجوم ترصعا","https://www.aldiwan.net/poem35676.html","الكامل"],[335,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[340,"ما حياتي تعب في ملل","https://www.aldiwan.net/poem55344.html","الرمل"],[346,"مولاي شمس الدين يا من ضوؤه","https://www.aldiwan.net/poem20169.html","الكامل"],[346,"أيها الفاضل الذي قصر الفا","https://www.aldiwan.net/poem20783.html","الخفيف"],[364,"ماذا يوسوس في الصدور","https://www.aldiwan.net/poem17372.html","مجزوء الكامل"],[369,"أترى بثار أم بدين","https://www.aldiwan.net/poem57099.html","مجزوء الكامل"],[402,"قل للأمير أدام ربي عزه","https://www.aldiwan.net/poem49387.html","الكامل"],[402,"قل للأمير أدام ربي عزه","https://www.aldiwan.net/poem49453.html","الكامل"],[403,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[407,"ذهب الفرزدق بالفخار وإنما","https://www.aldiwan.net/poem67499.html","الكامل"],[413,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[413,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[413,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[456,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[462,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[513,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[513,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[513,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[536,"يا أمير المؤمنين المرتضى","https://www.aldiwan.net/poem47578.html","عموديه"],[549,"بأبي زائرا أتاني ليلا","https://www.aldiwan.net/poem48068.html","الخفيف"],[556,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[556,"كيف يا قوم يوصف المخلوق","https://www.aldiwan.net/poem34317.html","الخفيف"],[556,"عيني لغير جمالكم لا تنظر","https://www.aldiwan.net/poem34479.html","الكامل"],[573,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[573,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"]],"verses":[["وَلَقَد جَنَيتَ عَلَيَّ عَمداً لا كَمَن","عَرَفَ الجِنايَةَ مُخطِئاً فَتَلافى",0,"ف",2,0],["وَلَقَد جَرَرتَ إِلى الغِنى ذا فاقَةٍ","وَأَصابَ غَزوُكَ إِمَّةً فَأَزالَها",1,"ل",3,0],["وَلَقَد جَعَلتَ هِلالَهُ","وَهوَ الخَفِيُّ كَبَدرِهِ",2,"ر",2,0],["وَلَقَد جَنَبنا الخَيلَ وَهيَ شَوازِبٌ","مُتَسَربِلينَ مُضاعَفاً مَسرودا",3,"د",2,0],["وَلَقَد جَرَيتُ فَجِئتُ أَوَّلَ سابِقٍ","عِندَ المَواطِنِ مُبدِياً وَمُعيدا",3,"د",2,0],["وَلَقَد جَمَعتَ حِمايَةً وَتَكَرُّماً","مَن غارَ يَعلَمُهُ وَمَن قَد أَنجَدا",4,"د",2,0],["وَلَقَد جَهِلتَ بِشَتمِ قَيسٍ بَعدَما","ذَهَبوا بِريشِ جَناحِكَ المَكسورِ",5,"ر",1,0],["وَلَقَد جَرَيتَ فَما أَمامَكَ سابِقٌ","وَعَلى الجَوالِبِ كَبوَةٌ وَغُبارُ",6,"ر",1,0],["وَلَقَد جَرى لُبَدٌ فَأَدرَكَ جَريَهُ","رَيبُ الزَمانِ وَكانَ غَيرَ مُثَقَّلِ",7,"ل",1,0],["وَلقَد جَعَلتُ الحُبَّ سِترَ مَدامِعي","وَلِغَيرِهِ عَينايَ تَنهَمِلانِ",8,"ن",1,0],["وَلَقَد جَزِعتُ وَقُلتُ حينَ نُعيتَ لي","مَن لِلجَلادِ لَدى العُقابِ وَظِلِّها",9,"ل",3,0],["ولقد جاء في الرواية والآ","ثار أنَّا على العقول نُثابُ",10,"ب",1,0],["وَلقد جُدْتَ للإمام بكافٍ","أصْمعِ القلب شَهْمِهِ وَقَّادِهْ",11,"د",2,0],["وَلَقَد جَشِمتَ جَريرُ أَمراً عاجِزاً","وَأَرَيتَ عَورَةَ أُمِّكَ الجُهّالا",12,"ل",2,0],["وَلَقَد جُرِّعتُ مِن بَع","دِكَ كاساتِ المَنايا",13,"ا",3,0],["ولقد جعلت لي الطبيعة قدوة","وتخذت منها في الحياة اماما",14,"م",2,0],["وَلَقَد جَرَيتَ إِلى المَعالي سابِقاً","فَأَخَذتَ حَظَّ الأَوَّلِ المُتَقَدِّمِ",15,"م",1,0],["وَلَقَد جَهَدتُم أَن تُزيلوا عِزَّهُ","فَإِذا أَبانٌ قَد رَسا وَيَلَملَمُ",16,"م",1,0],["وَلَقَد جَرى لَكَ يَومَ حَزمِ سُوَيقَةٍ","فيما يُعِفُّ سانِحٌ وَبَريحُ",17,"ح",1,0],["وَلَقَد جَريتُ مَعَ الصِبا جَرِيَ الصَبا","وَشَرِبتُها مِن كَفِّ أَحوى أَحوَرِ",18,"ر",1,0],["ولقد جعلتُ إلى معاذٍ أمرهُمْ","فجعلتُه لِزَعيمهِ وضَمينهِ",19,"ه",1,0],["ولقد جِئتُمْ كما قد شِئْتُمُ","ليس في فخركُمُ من مُستَزاد",20,"د",1,0],["ولقد جمعتُ عجوزهُ وتجمّعت","وشفيتُ من هذه وتلك فؤاديه",21,"ي",2,0],["وَلَقَد جَرَيتُ مَعَ الصِبا طَلقَ الصَبا","ثُمَّ اِرعَوَيتُ فَلَم أَجِد لي مَركَضا",22,"ض",2,0],["وَلَقَد جَرَت حَلَباتُهُم","فَسَبَقتَهُنَّ وَأَنتَ قاعِد",23,"د",1,0],["وَلَقَد جَرى لَهُمُ فَلَم يَتَعَيَّفوا","تَيسٌ قَعيدٌ كَالوَلِيَّةِ أَعضَبُ",24,"ب",1,0],["ولقد جاء من ملائكةِ العر","شِ لإرجاعِ الأمن جمٌّ غفير",25,"ر",1,0],["وَلَقَد جئت بالحقائق أَشدو","وَتَركت الخَيال للشعراء",26,"ا",2,0],["وَلَقَد جاءَت الحَياة إلى الغب","راء مَدفوعة من الزهراء",26,"ا",2,0],["وَلَقَدْ جَرَيْتُ مَعَ الْغَوَايَةِ وَالصِّبَا","جَرْيَ الْكُمَيْتِ وَلِلْغَرَامِ سِبَاقُ",27,"ق",1,0],["ولقد جرى لكَ، يومَ حزم سويقة ٍ،","فِيما يُعَيَّفُ سَانِحٌ وَبَرِيحُ",28,"ح",1,0],["وَلَقَد جَمَعتَ حَمِيَّةً وَتَقِيَّةً","ثَنَتا إِلَيكَ عِنانَ كُلِّ ثَناءِ",29,"ا",2,0],["وَلَقَد جَمَعتَ مَناقِباً ما اِستَجمَعَت","مَشهورَةً ما اِستَعجَمَت فَتُفَسَّرا",30,"ر",2,0],["وَلَقَد جَزَيتُ الحادِثاتِ بِما جَنَت","فَسَلَبتُها الأَنيابَ وَالأَظفارا",31,"ر",2,0],["وَلَقَد جَمَعتَ فَضائِلاً ما اِستَجمَعَت","يَفنى الزَمانُ وَذِكرُها لَم يَهرَمِ",32,"م",1,0],["ولقد جبرتَ وما لجبرك كاسرٌ","ولقد كَسرتَ وما لكسرِك جابرِ",33,"ر",1,0],["ولقدْ جذبتُ إليَّ عقربَ صُدغِها","فوجدتُها جَرّارةً مَجْرورَهْ",34,"ه",1,1],["وَلَقد جَرى فيها بِواسِطَ وَقعَةٌ","ما كانَ لي فيها هُنالِكَ ناصِرُ",35,"ر",1,0],["ولقد جاء بي إليك وبالحمد","مقفي مسجعا موزونا",36,"ن",2,0],["ولقد جَمعتُ الكونَ تحتَ شغافهِ","ما كانَ أضيعَهُ وأوسَعَهُ معا",37,"ع",2,0],["وَلَقَد جَعَلنَ لَهُ المُحَصَّبَ مَوعِداً","فَلَقَد وَفَينَ وَعاقَهُ ما عاقا",38,"ق",2,0],["ولقد جاهدت فيه زمناً","ونسيت في هواه جذلي",39,"ل",2,0],["وَلَقَدْ جَلَبْتَ لَها الضِّياءَ بِهِمَّةٍ","جَلَبَتْ لهَا مِن أَصْفَهانَ الإثْمِدا",40,"د",2,0],["وَلَقد جِئْتَ قُرَّةً لِعُيونٍ","سَلِمتْ أَنْ تُعَدَّ في العُمْيانِ",41,"ن",1,0],["وَلَقَد جَرَيتَ إِلى مَدى","ما مُنتَهاهُ سِوى المَنثورِ",42,"ر",1,0],["ولَقَد جَهلتُهما لبُع","دِ العَهدِ بَينهما وبَيني",43,"ن",2,0],["ولقد جمعت من الذنوبِ فنونَها","فاجمع من العفوِ الجميلِ فنونَهُ",44,"ن",2,0],["ولقد جَمعْتُ مِنَ العُيوبِ فُنونَها","فاجمَعْ مِنَ العَفْوِ الكَريمِ فُنونَهُ",45,"ن",2,0],["وَلَقَد جَرَيتَ كَما جريتُ لِغايَةٍ","فبلغتها وَأَبوكَ في المِضمارِ",46,"ر",1,0],["وَلَقَد جَرَيتُ مَعَ الجِيادِ فَفُتُّها","بِعِنانِ لا شَبِم وَلا مَبهورِ",47,"ر",1,0],["ولقد جاوَزْتَ حدًّا في العُلى","رَجَعَتْ من دونه الأَبصار حسرى",48,"ر",2,0],["ولقد جَرَيْتَ على مذاكي همّة","لا تَسأم الإتهام والإنجادا",49,"د",2,0],["ولقد جرّد من غمد الدُّجى","صارم الفجر عياناً فتجدُّد",50,"د",1,0],["ولَقَدْ جَبَرْتَ بِرَغْمِ دَهْرٍ ضامَني","مَا أَخْلَقَتْ عَصْرَاهُ مِنْ أَثْوَابِي",51,"ي",1,0],["ولقد جمعتُ إلى مديحك حادياً","ناحاك فاستذممتُ خيرَ ذِمامِ",52,"م",1,0],["ولقد جرى نحوي نسيمُ دياره","سحراً فكاد بأدمعي أن يعثرا",53,"ر",2,0],["ولقد جمعتَ ولا أغشّك قائلاً","ما بين نعمى جائدٍ ومجوِّد",54,"د",1,0],["ولقد جمعت أبا الشجاع إليهما","خفض الجناح ورفعة المقدار",55,"ر",1,0],["ولقد جمعت بما فرقت من الندى","فرقاً من الأهواء كانت نفرا",56,"ر",2,0],["ولقد جمعت من المحاسن جملة","لم تتفق لمخبر ومعبر",57,"ر",1,0],["ولقد جِئتُكُمُ مُرتجياً","مِنكمُ أن تَقبلُوني بالرِّضَى",58,"ض",2,0],["وَلَقد جاءني وَما كانَ في نفْ","سِيَ إسعافُهُ ولا في حِسابي",59,"ي",1,0],["ولقد جاء بالجميع ركون","وانقياد إليه واستلام",60,"م",1,0],["ولقد جاءت النصوص بهذا","في كتاب وسنة ذا مسوق",61,"ق",1,0],["ولقد جعلت وسيلتي لك سيداً","أرسلته بالحق دينك يظهر",62,"ر",1,0],["ولَقدْ جَرَتْ منها الدِّما","ءُ كأَنني فِيهَا طَعِينُ",63,"ن",1,0],["ولقد جاءُوا جِبالاً","وبه عادُوا رِمالا",64,"ل",2,0]]}