{"poems":[[53,"له مال يجم على العطايا","https://www.aldiwan.net/poem66323.html","الوافر"],[82,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[54,"وصاحب سوء وجهه لي أوجه","https://www.aldiwan.net/poem27257.html","الطويل"],[50,"بباب بنية الوضاح ظبي","https://www.aldiwan.net/poem10410.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1313","الطويل"],[189,"وما أنس طيب العناق","https://www.aldiwan.net/poem14529.html","المتقارب"],[220,"صحوتُ وزايلني باطلي","https://www.aldiwan.net/poem684.html",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38590","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117639","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64649","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87509","المتقارب"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99365","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91472","الوافر"],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5753,"حصاد","https://www.poetsgate.com/ViewPoem.aspx?id=214927",""],[5829,"أنت خلي","https://www.poetsgate.com/ViewPoem.aspx?id=153692",""],[6093,"تجربة ماء","https://www.poetsgate.com/ViewPoem.aspx?id=205456",""]],"verses":[["كماء العدِّ مهما نالَ منه","سقاةُ الماءِ أخلفهُ الجُموم",0,"م",1,0],["كماءِ عقيقٍ في الزّجاجِ مُنَظّمٍ","عليه من الإزباد دُرّاً مجوّفا",1,"ف",2,0],["كَماءِ طَريقِ الحَجِّ في كُلِّ مَنهَلٍ","يُذَمُّ عَلى ما كانَ مِنهُ وَيُشرَبُ",2,"ب",1,0],["كَماءِ الدَنِّ يَسكَرُ مَن رَآهُ","فَيَخفِتُ وَالقُلوبُ لَهُ سِباءُ",3,"ا",2,0],["كَماءِ الغَديرِ اِمتَدَّ بَعدَ وُقوعِهِ","بِما هاجَ مِن فَيضِ التِلاع القَوابِلِ",4,"ل",1,0],["كماءَيْنِ من صَبَبَيْ هضْبةٍ","أَلَماّ فضَمَّهما مستقرَ",5,"ر",1,0],["كَماءِ الغَديرِ زَفَتهُ الدَبورُ","يَجُرُّ المُدَجِّجُ مِنها فُضولا",6,"ل",2,0],["كَماءِ إِناءٍ مُستَدير مُبيض","يَدورُ بِهِ دَوماً كَما دارَتِ الرّحى",7,"ح",2,0],["كماءِ البحرِ مُرٍّ ثم تحلو","مذاقتُهُ إذا صحبَ الغماما",8,"م",2,0],["كماء عقيق ينفح المسك ريحه","ينادي مذاق النحل قصرت عن مثلي",9,"ي",1,0],["كَمآءِ تعرَّض وَسطَ الطَريق","يُرى لَمعُهُ وَسَطَ الغَيهبِ",10,"ب",1,0],["كماء الفرات الجم اعرض ورده","لكل اناس فهو سهل الشرائع",11,"ع",1,0],["كماء حوله قومٌ أَعادٍ","عَلَيهِ حائمٌ في البرّ صاد",12,"د",1,0],["كماء الصبا يجري بخد خريدة","فيزهو به ورد الخدود المنعم",13,"م",1,0],["كَمَاءِ الغَيْثِ يُحْيِي البيدَ خُضْرًا","وَ يَبْعَثُهَا وَقَدْ وُصِمَتْ بِعُقْمِ",14,"م",1,0],["كمَاءٍ أنتَ والمُشتاقُ صَادِ","أعيذكَ باحتراقيَ من سُهادِي",15,"د",2,1],["كماء الحياة تروي عروقي","يظلل يومي ويمضي بظلي",16,"ل",2,0],["كماءٍ خاضَ تجربة ًً","بنهرِ النيلِ والغابُونْ",17,"ن",1,0]]}