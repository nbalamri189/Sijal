[4767,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=95450",""],[4905,"لاتمزحن فإن مزحت فلا يكن","https://www.poetsgate.com/ViewPoem.aspx?id=182693",""],[5038,"في الحكمة / الغرور1","https://www.poetsgate.com/ViewPoem.aspx?id=190214",""],[5038,"لا تملأ الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=197221",""],[5055,"نظرة غريبة","https://www.poetsgate.com/ViewPoem.aspx?id=109397",""],[5064,"أحزَان الشّارع اللّيلي","https://www.poetsgate.com/ViewPoem.aspx?id=199144",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[5135,"لحظة الغسق","https://www.poetsgate.com/ViewPoem.aspx?id=201799",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5216,"ابكِ يوما","https://www.poetsgate.com/ViewPoem.aspx?id=187650",""],[5232,"كوثر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=213609",""],[5277,"لا تمسحِ الدمعَ","https://www.poetsgate.com/ViewPoem.aspx?id=195072",""],[5323,"يا فؤادي !","https://www.poetsgate.com/ViewPoem.aspx?id=209173",""],[259,"أين أحلامي","https://www.poetsgate.com/ViewPoem.aspx?id=215967",""],[5411,"يا بن زيدون..","https://www.poetsgate.com/ViewPoem.aspx?id=189921",""],[5411,"هَذِهِ لَيْلَتي","https://www.poetsgate.com/ViewPoem.aspx?id=190855",""],[5413,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=208591",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5459,"هَذِي الجِنان ..","https://www.poetsgate.com/ViewPoem.aspx?id=200767",""],[5461,"لا تملين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=5023",""],[5525,"ما بقى لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=7297",""],[5533,"أُمَّةَ الإِسْلامِ عُودي","https://www.poetsgate.com/ViewPoem.aspx?id=176354",""],[5550,"أقبلتْ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=213634",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5587,"المعروف (1)","https://www.poetsgate.com/ViewPoem.aspx?id=196853",""],[5655,"عُوجا علي أرضهم غداً ولِجا","https://www.poetsgate.com/ViewPoem.aspx?id=107217",""],[5674,"ياوجها من الألق","https://www.poetsgate.com/ViewPoem.aspx?id=188335",""],[5732,"ياما برأس الناب","https://www.poetsgate.com/ViewPoem.aspx?id=177954",""],[5758,"مجاز الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=201128",""],[5848,"الشماعه","https://www.poetsgate.com/ViewPoem.aspx?id=53102",""],[5937,"إلى مُعَلمة","https://www.poetsgate.com/ViewPoem.aspx?id=211808",""],[5939,"حرّيّتي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=180002",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""],[5950,"حمّلوني وزر كلّ القلوب الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=139962",""],[5956,"دائرة الشقاء","https://www.poetsgate.com/ViewPoem.aspx?id=183929",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[6056,"القناااع","https://www.poetsgate.com/ViewPoem.aspx?id=156703",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6093,"أدعياء الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=198902",""],[6093,"فسُمْعةُ الناسِ ليستْ حَقْلَ تَدريبِ","https://www.poetsgate.com/ViewPoem.aspx?id=210702",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[5355,"لا تعذليه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87225&r=&rc=50",""],[6229,"دمية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65180&r=&rc=1",""],[6331,"الصَّبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82022&r=&rc=3",""]],"verses":[["لا تَملِكُ العَرَصاتُ قَعدَتَهُ","وَإِنِ اِستَقَرَّ فَفي ذُرى الإِبلِ",0,"ل",1,0],["لا تَمشِيَنَّ إِلى أَمرٍ تُعابُ بِهِ","فَقَلَّما تَفطُنُ الأَيّامُ بِالزَلَلِ",1,"ل",1,0],["لا تَملِكُ الفَحشاءُ جانِبَ سَمعِهِ","وَيَزِلُّ قَولُ الهُجرِ عَنهُ وَيَزلَقُ",2,"ق",1,0],["لا تمنعن يد المعروف عن احد","ما دمت مقتدراً.. والعيش جنات",3,"ت",1,0],["لا تَمتَطي شَهَواتِ النَّفسِ جامِحَةً","فكِسرَةُ الخُبز عن حَلواكِ تَجزيها",4,"ي",3,0],["لا تَمْنَعِي الأَرْوَاحِ مِنْ قُبْلَةٍ","لَعَلَّ رُوحِي بَعْضُ تِلْكَ النَّسَمْ",5,"م",1,0],["لا تَمْحُ أَيُّهَا الصَّدِيقُ المُفَدَّى","لا تَزُلْ أَيُّهَا الفَقِيدُ المُقِيمُ",6,"م",1,0],["لا تمطلوا دَيْن الغريب فإنني","منكم وإن رَغِمَتْ لذل حُسَّدَي",7,"د",2,0],["لا تملني إذا جزعت فإني","ما ملكت الخيار في إيجادي",8,"د",2,0],["لا تَمنَعونَ لَكُم عِرساً وَما لَكُمُ","إِلّا بِغَيرِكُمُ وِردٌ وَلا صَدَرُ",9,"ر",1,0],["لا تمنعنَّ مَهيرَةً من مهْرها","إن السَّرِيَّ من الفرِيِّ سِفَاحُهُ",10,"ح",2,0],["لا تمنعنِّي لهى مُمَنَّحةً","أضحت عليها الأكفُّ تقترع",11,"ع",1,0],["لا تمتحنّي بمنع وجهك عي","نيَّ فلا صبرَ لي على مِحنك",12,"ك",1,0],["لا تمتعِض للتي صاحتْ قوابلُها","قد التقتْ دجلةُ العوراءُ والنيلُ",13,"ل",1,0],["لا تَمَلُّ البروكَ أو تقعُ الطي","رَ على متنها كبعضِ الأروم",14,"م",1,0],["لا تماروا الناس فيما اعتقدوا","كل نفس بكتاب وسبيل",15,"ل",1,0],["لا تملك المرضى به أرواحها","سأما وإن ملكت به أجسامها",16,"م",3,0],["لا تَمضِ فيها وَأرح مِنها الجَسد","وَامشض بِلا درعِ كَما يَمضي الأَسَد",17,"د",1,0],["لا تَمُرَّنَّ عَلى العَينِ","وَلا بِالأَنفِ جيفَه",18,"ف",2,0],["لا تَمنَحِ المَحبوبَ شُكرَكَ كُلَّهُ","وَاِقرِن بِهِ شُكرَ الأَجيرِ المُجهَدِ",19,"د",1,0],["لا تَمَنّى الزَمانُ مِنها مَزيداً","إِن تَمَنَّيتُ أَن تَفُكّي وِثاقي",20,"ق",2,0],["لا تَموتُ النَفسُ إِلّا بِاِسمِهِ","قامَ بِالمَوتِ عَلَيها وَقَهَر",21,"ر",1,0],["لا تَمْزُجَنْها بغير الماءِ مِنْكَ فإنْ","تَبْخَلْ يداكَ فَدَمْعي سَوْفَ يَمْزُجُها",22,"ج",3,0],["لا تُمازِح في غَيرِ وَقتِ مُزاحِ","وَاِتَّخِذ آلَةً لِوَقتِ الصَياحِ",23,"ح",1,1],["لا تَمنَعونَ لَهُم حَرامَ حَليلَةٍ","وَتُنالُ أَيُّمُهُم وَإِن لَم تُخطَبِ",24,"ب",1,0],["لا تَمدَحَنَّ فَتىً تَرجو نَوافِلَهُ","وَلا تَزُر غَيرَهُ ما عاشَ عَبّادُ",25,"د",1,1],["لا تمزجنها بغير الريق منك وإن","تبخل بذاك فدمعي سوف يمزجها",26,"ج",3,0],["لا تُمضِ رَأيَكَ في هَوىً","إِلّا وَرَأيُكَ فيهِ قَصدُ",27,"د",1,0],["لا تُمسِكِ المالَ وَاِستَرضِ الإِلَهَ بِهِ","فَإِنَّ حَسبَكَ مِنهُ الرَيُّ وَالشَبَعُ",28,"ع",1,0],["لا تَمشِ في الناسِ إِلّا رَحمَةً لَهُمُ","وَلا تُعامِلهُمُ إِلّا بِإِنصافِ",29,"ف",1,0],["لا تَمحُ رَوعَتَهَا بذكر فعالها","دعها تمرّ كما بدت بجلالها",30,"ل",3,1],["لا تَمِل واسخر من الدنيا إذا","شاءت الأيامُ يوماً أن تميلا",31,"ل",2,0],["لا تَمَلَّ القِتالَ يا اِبنَ عُبادٍ","صَبِّرِ النَفسَ إِنَّني غَيرُ سالِ",32,"ل",1,0],["لا تَمنَعَنّي وَقفَةً أَشفي بِها","داءَ الفِراقِ فَإِنَّها ماعونُ",33,"ن",1,0],["لا تَمتَري في الحَقِّ تَطلُبُهُ وَلا","تَلوي العِنانَ لِباطِلٍ لا يَنفَعُ",34,"ع",1,0],["لا تَمنَعَنَّ مِنَ العَدُوِّ ذِمارَها","إِنَّ الذِمارَ بِغَيرِ بأسِكَ يُمنَعُ",35,"ع",1,0],["لا تَملكُ الدنيا عليهم أمرَهم","في شِدّةٍ من دَهرهِم ورَخاءِ",36,"ا",2,0],["لا تَمَلّا حَثَّنا وَاِسقِيانا","قَد بَدا الصُبحُ لَنا وَاِستَبانا",37,"ن",2,1],["لا تُمْسِكُ الدَّمْعَ مِنْ حُزْنٍ عُيُونُهُمُ","إِلاَّ كما يُمْسِكُ المَاءُ الغَرابِيلُ",38,"ل",1,0],["لا تُمكِنَنّي مِنَ العِربيدِ يَشرَبُني","وَلا اللَئيمِ الَّذي إِن شَمَّني قَطَبا",39,"ب",2,0],["لا تَمزُجِ الخَمرَ عَلى حالٍ","وَسَقِّنيها بِنتَ أَحوالِ",40,"ل",1,1],["لا تُمَنّي أَخاكِ في مِلَّةِ الحُب","بِ بِداءٍ دَواؤُهُ مَفقودُ",41,"د",1,0],["لا تُمسِيَنَّ عَلى مَن ماتَ مُلتَهِفاً","فَالناشِئاتُ إِذا طالَ المَدى عُجُزُ",42,"ز",1,1],["لا تُمسِ في نارِ الضَميرِ فَراشَةً","فَضَغائِنُ الصَدرِ الحَريقُ المُشعَلُ",43,"ل",1,0],["لا تَمنَعُ الغادَةَ الحَسناءَ نِعمَتُها","وَأَن تَقومَ حَوالَيها حَواليها",44,"ي",3,0],["لا تُمِلْنِي عن حِمى مُرتَبَعي","عُدْوَتَيْ تَيْمَا لِرَبْعٍ بِتُمَي",45,"ي",1,0],["لا تمسكي بالقوم إن","نَ القوم لا يرعون عهدا",46,"د",2,0],["لا تمنع الشعر عما","يقوله لذويه",47,"ه",1,0],["لا تَموت النفس بالهم","مِ ولا الهمّ يموتُ",48,"ت",1,0],["لاَ تَمْنَعُ المَرْءَ أَحْجَاءُ البِلاَدِ ولاَ","تُبْنَى لَهُ في السَّمَواتِ السَّلاَلِيمُ",49,"م",1,0],["لا تمض فيها وأرح منها الجسد","وامض بلا درع كما يمضي الأسد",50,"د",1,0],["لاَ تَمْلأُ القَلْبَ الخَلِيَّ وَدَأبُهَا","نَهْكُ القُوَى فِي شِقْوَةٍ وَسُعُودِ"