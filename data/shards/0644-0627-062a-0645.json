{"poems":[[53,"من لي برعبلة من البزل","https://www.aldiwan.net/poem29900.html","الكامل"],[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"ما رقع الواشون في ولفقوا","https://www.aldiwan.net/poem29938.html","الكامل"],[57,"الناس بالناس مادام الحياء بهم","https://www.aldiwan.net/poem26156.html","عموديه"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[93,"يا من نأت والروح في إثرها","https://www.aldiwan.net/poem11296.html","السريع"],[93,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[83,"أكتيبة الكتاب أيد جمعكم","https://www.aldiwan.net/poem54314.html","الكامل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[85,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[85,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[85,"جئننا بالشعور والأحداق","https://www.aldiwan.net/poem63027.html","الخفيف"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[56,"وليلة بات طل الغيث ينسجها","https://www.aldiwan.net/poem58473.html","البسيط"],[45,"لا تمازح في غير وقت مزاح","https://www.aldiwan.net/poem62721.html","الخفيف"],[28,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[28,"لا تمدحن فتى ترجو نوافله","https://www.aldiwan.net/poem5039.html","البسيط"],[61,"وروضة بات طل الغيث ينسجها","https://www.aldiwan.net/poem51311.html","البسيط"],[49,"جدوا فإن الأمر جد","https://www.aldiwan.net/poem62047.html","مجزوء الكامل"],[49,"أما بيوتك في الدنيا فواسعة","https://www.aldiwan.net/poem62161.html","البسيط"],[49,"الله كاف فمالي دونه كاف","https://www.aldiwan.net/poem62178.html","البسيط"],[97,"لا تمح روعتها بذكر فعالها","https://www.aldiwan.net/poem24857.html","الكامل"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[105,"أتحاربون الله في جبروته","https://www.aldiwan.net/poem43130.html","الكامل"],[105,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[52,"لا تملا حثنا واسقيانا","https://www.aldiwan.net/poem26608.html","المديد"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"يا خاطب القهوة الصهباء يمهرها","https://www.aldiwan.net/poem10773.html","البسيط"],[48,"لا تمزج الخمر على حال","https://www.aldiwan.net/poem64504.html","السريع"],[50,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[46,"لا تمسين على من مات ملتهفا","https://www.aldiwan.net/poem22756.html","البسيط"],[46,"إن كان من فعل الكبائر مجبرا","https://www.aldiwan.net/poem23144.html","الكامل"],[46,"ناديت أقضية الله التي سلفت","https://www.aldiwan.net/poem23571.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85660","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202547","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[50,"اسْمَعِي يا خُلَيْدَ أنْتِ الْخُلُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=21788",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[57,"النَّاسُ بالنَّاسِ ما دامَ الحياءُ بهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=206883",""],[28,"غيا لباهلة التي شقيت بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21304",""],[99,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["لا تَملِكُ العَرَصاتُ قَعدَتَهُ","وَإِنِ اِستَقَرَّ فَفي ذُرى الإِبلِ",0,"ل",1,0],["لا تَمشِيَنَّ إِلى أَمرٍ تُعابُ بِهِ","فَقَلَّما تَفطُنُ الأَيّامُ بِالزَلَلِ",1,"ل",1,0],["لا تَملِكُ الفَحشاءُ جانِبَ سَمعِهِ","وَيَزِلُّ قَولُ الهُجرِ عَنهُ وَيَزلَقُ",2,"ق",1,0],["لا تمنعن يد المعروف عن احد","ما دمت مقتدراً.. والعيش جنات",3,"ت",1,0],["لا تَمتَطي شَهَواتِ النَّفسِ جامِحَةً","فكِسرَةُ الخُبز عن حَلواكِ تَجزيها",4,"ي",3,0],["لا تَمْنَعِي الأَرْوَاحِ مِنْ قُبْلَةٍ","لَعَلَّ رُوحِي بَعْضُ تِلْكَ النَّسَمْ",5,"م",1,0],["لا تَمْحُ أَيُّهَا الصَّدِيقُ المُفَدَّى","لا تَزُلْ أَيُّهَا الفَقِيدُ المُقِيمُ",6,"م",1,0],["لا تمطلوا دَيْن الغريب فإنني","منكم وإن رَغِمَتْ لذل حُسَّدَي",7,"ي",1,0],["لا تملني إذا جزعت فإني","ما ملكت الخيار في إيجادي",8,"د",2,0],["لا تَمنَعونَ لَكُم عِرساً وَما لَكُمُ","إِلّا بِغَيرِكُمُ وِردٌ وَلا صَدَرُ",9,"ر",1,0],["لا تمنعنَّ مَهيرَةً من مهْرها","إن السَّرِيَّ من الفرِيِّ سِفَاحُهُ",10,"ح",2,0],["لا تمنعنِّي لهى مُمَنَّحةً","أضحت عليها الأكفُّ تقترع",11,"ع",1,0],["لا تمتحنّي بمنع وجهك عي","نيَّ فلا صبرَ لي على مِحنك",12,"ك",1,0],["لا تمتعِض للتي صاحتْ قوابلُها","قد التقتْ دجلةُ العوراءُ والنيلُ",13,"ل",1,0],["لا تَمَلُّ البروكَ أو تقعُ الطي","رَ على متنها كبعضِ الأروم",14,"م",1,0],["لا تماروا الناس فيما اعتقدوا","كل نفس بكتاب وسبيل",15,"ل",1,0],["لا تملك المرضى به أرواحها","سأما وإن ملكت به أجسامها",16,"م",3,0],["لا تَمضِ فيها وَأرح مِنها الجَسد","وَامشض بِلا درعِ كَما يَمضي الأَسَد",17,"د",1,0],["لا تَمُرَّنَّ عَلى العَينِ","وَلا بِالأَنفِ جيفَه",18,"ف",2,0],["لا تَمنَحِ المَحبوبَ شُكرَكَ كُلَّهُ","وَاِقرِن بِهِ شُكرَ الأَجيرِ المُجهَدِ",19,"د",1,0],["لا تَمَنّى الزَمانُ مِنها مَزيداً","إِن تَمَنَّيتُ أَن تَفُكّي وِثاقي",20,"ق",2,0],["لا تَموتُ النَفسُ إِلّا بِاِسمِهِ","قامَ بِالمَوتِ عَلَيها وَقَهَر",21,"ر",1,0],["لا تَمْزُجَنْها بغير الماءِ مِنْكَ فإنْ","تَبْخَلْ يداكَ فَدَمْعي سَوْفَ يَمْزُجُها",22,"ج",3,0],["لا تُمازِح في غَيرِ وَقتِ مُزاحِ","وَاِتَّخِذ آلَةً لِوَقتِ الصَياحِ",23,"ح",1,1],["لا تَمنَعونَ لَهُم حَرامَ حَليلَةٍ","وَتُنالُ أَيُّمُهُم وَإِن لَم تُخطَبِ",24,"ب",1,0],["لا تَمدَحَنَّ فَتىً تَرجو نَوافِلَهُ","وَلا تَزُر غَيرَهُ ما عاشَ عَبّادُ",25,"د",1,1],["لا تمزجنها بغير الريق منك وإن","تبخل بذاك فدمعي سوف يمزجها",26,"ج",3,0],["لا تُمضِ رَأيَكَ في هَوىً","إِلّا وَرَأيُكَ فيهِ قَصدُ",27,"د",1,0],["لا تُمسِكِ المالَ وَاِستَرضِ الإِلَهَ بِهِ","فَإِنَّ حَسبَكَ مِنهُ الرَيُّ وَالشَبَعُ",28,"ع",1,0],["لا تَمشِ في الناسِ إِلّا رَحمَةً لَهُمُ","وَلا تُعامِلهُمُ إِلّا بِإِنصافِ",29,"ف",1,0],["لا تَمحُ رَوعَتَهَا بذكر فعالها","دعها تمرّ كما بدت بجلالها",30,"ل",3,1],["لا تَمِل واسخر من الدنيا إذا","شاءت الأيامُ يوماً أن تميلا",31,"ل",2,0],["لا تَمنَعَنّي وَقفَةً أَشفي بِها","داءَ الفِراقِ فَإِنَّها ماعونُ",32,"ن",1,0],["لا تَمتَري في الحَقِّ تَطلُبُهُ وَلا","تَلوي العِنانَ لِباطِلٍ لا يَنفَعُ",33,"ع",1,0],["لا تَمنَعَنَّ مِنَ العَدُوِّ ذِمارَها","إِنَّ الذِمارَ بِغَيرِ بأسِكَ يُمنَعُ",34,"ع",1,0],["لا تَملكُ الدنيا عليهم أمرَهم","في شِدّةٍ من دَهرهِم ورَخاءِ",35,"ا",2,0],["لا تَمَلّا حَثَّنا وَاِسقِيانا","قَد بَدا الصُبحُ لَنا وَاِستَبانا",36,"ن",2,1],["لا تُمْسِكُ الدَّمْعَ مِنْ حُزْنٍ عُيُونُهُمُ","إِلاَّ كما يُمْسِكُ المَاءُ الغَرابِيلُ",37,"ل",1,0],["لا تُمكِنَنّي مِنَ العِربيدِ يَشرَبُني","وَلا اللَئيمِ الَّذي إِن شَمَّني قَطَبا",38,"ب",2,0],["لا تَمزُجِ الخَمرَ عَلى حالٍ","وَسَقِّنيها بِنتَ أَحوالِ",39,"ل",1,1],["لا تُمَنّي أَخاكِ في مِلَّةِ الحُب","بِ بِداءٍ دَواؤُهُ مَفقودُ",40,"د",1,0],["لا تُمسِيَنَّ عَلى مَن ماتَ مُلتَهِفاً","فَالناشِئاتُ إِذا طالَ المَدى عُجُزُ",41,"ز",1,1],["لا تُمسِ في نارِ الضَميرِ فَراشَةً","فَضَغائِنُ الصَدرِ الحَريقُ المُشعَلُ",42,"ل",1,0],["لا تَمنَعُ الغادَةَ الحَسناءَ نِعمَتُها","وَأَن تَقومَ حَوالَيها حَواليها",43,"ي",3,0],["لا تُمِلْنِي عن حِمى مُرتَبَعي","عُدْوَتَيْ تَيْمَا لِرَبْعٍ بِتُمَي",44,"ي",1,0],["لا تمسكي بالقوم إن","نَ القوم لا يرعون عهدا",45,"د",2,0],["لا تمنع الشعر عما","يقوله لذويه",46,"ه",1,0],["لا تَموت النفس بالهم","مِ ولا الهمّ يموتُ",47,"ت",1,0],["لا تمض فيها وأرح منها الجسد","وامض بلا درع كما يمضي الأسد",48,"د",1,0],["لاَ تَمْلأُ القَلْبَ الخَلِيَّ وَدَأبُهَا","نَهْكُ القُوَى فِي شِقْوَةٍ وَسُعُودِ",49,"د",1,0],["لا تُمْسِكُ الزَّمَن الَّذِي","يَجْرِي وَلاَ تَنْسَى مَعادَكْ",50,"ك",1,0],["لا تُمَنِّي أخاكِ في مِلَّة الْحُب","بِدَاءٍ دَوَاؤُهُ مَفْقُود",51,"د",1,0],["لا تُمِلها عني وفيَّ حَراكٌ","واسقنِها حتى ترانيَ يَبسا",52,"س",2,0],["لا تَمنعَنَّ يدَ المعروفِ عن أَحَد ٍ","ما دُمْتَ مُقْتَدِرًا فالسَّعْدُ تاراتُ",53,"ت",1,0],["لا تَمنَعونَ لَهُمْ جَرَامَ حَلِيلَةٍ","، وَتُنالُ أيّمُهُمْ وَإنْ لمْ تُخْطَبِ",54,"ب",1,0],["لاتموت الخيول برداً وجوعاً","إن للعاشقين رباً رحيما ..",55,"م",2,0],["لا تمتحنّي بمنع وجهك عينيْ","يَ فلا صبرَ لي على مِحنك",56,"ك",1,0],["لاَ تَمَلَّ الْقِتَالَ يا ابْنَ عُبَادٍ","صبرِ النفسَ إنني غيرُ سالِ",57,"ل",1,0]]}