ة","https://www.aldiwan.net/poem14871.html","البسيط"],[236,"سيدي يا ابن جعفر أنت أعلى","https://www.aldiwan.net/poem31899.html","الخفيف"],[238,"قد آن أن ينجز الوعد الذي وعدا","https://www.aldiwan.net/poem18143.html","البسيط"],[262,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[262,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[272,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[291,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[298,"قد حال ما بيني وبين مآربي","https://www.aldiwan.net/poem33319.html","الكامل"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[306,"يا منعما قبل السؤال على الورى","https://www.aldiwan.net/poem56533.html","الكامل"],[349,"كن قاطعا من قطع القده","https://www.aldiwan.net/poem20140.html","السريع"],[354,"إن العطاء عطاء الله جاد به","https://www.aldiwan.net/poem40152.html","البسيط"],[365,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[368,"فهي خذواء بعيش ناعم","https://www.aldiwan.net/poem4620.html","الرمل"],[372,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[378,"يا نسيما نراه يروي الغليلا","https://www.aldiwan.net/poem59174.html","الخفيف"],[392,"الدنيا عبور","https://www.aldiwan.net/poem54558.html","عموديه"],[403,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[404,"جرى القضا بشمول الموت للبشر","https://www.aldiwan.net/poem33928.html","البسيط"],[407,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[407,"لا تملأن قدحي وارفق فقد مزجت","https://www.aldiwan.net/poem50192.html","البسيط"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[454,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[459,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[459,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[469,"يا من إذا حال أخ لا يحول","https://www.aldiwan.net/poem59772.html","السريع"],[478,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[480,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[501,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[515,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[559,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[559,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[559,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[576,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"]],"verses":[["لا تَملِكُ العَرَصاتُ قَعدَتَهُ","وَإِنِ اِستَقَرَّ فَفي ذُرى الإِبلِ",0,"ل",1,0],["لا تَمشِيَنَّ إِلى أَمرٍ تُعابُ بِهِ","فَقَلَّما تَفطُنُ الأَيّامُ بِالزَلَلِ",1,"ل",1,0],["لا تَملِكُ الفَحشاءُ جانِبَ سَمعِهِ","وَيَزِلُّ قَولُ الهُجرِ عَنهُ وَيَزلَقُ",2,"ق",1,0],["لا تمنعن يد المعروف عن احد","ما دمت مقتدراً.. والعيش جنات",3,"ت",1,0],["لا تَمتَطي شَهَواتِ النَّفسِ جامِحَةً","فكِسرَةُ الخُبز عن حَلواكِ تَجزيها",4,"ي",3,0],["لا تَمْنَعِي الأَرْوَاحِ مِنْ قُبْلَةٍ","لَعَلَّ رُوحِي بَعْضُ تِلْكَ النَّسَمْ",5,"م",1,0],["لا تَمْحُ أَيُّهَا الصَّدِيقُ المُفَدَّى","لا تَزُلْ أَيُّهَا الفَقِيدُ المُقِيمُ",6,"م",1,0],["لا تمطلوا دَيْن الغريب فإنني","منكم وإن رَغِمَتْ لذل حُسَّدَي",7,"د",2,0],["لا تملني إذا جزعت فإني","ما ملكت الخيار في إيجادي",8,"د",2,0],["لا تَمنَعونَ لَكُم عِرساً وَما لَكُمُ","إِلّا بِغَيرِكُمُ وِردٌ وَلا صَدَرُ",9,"ر",1,0],["لا تمنعنَّ مَهيرَةً من مهْرها","إن السَّرِيَّ من الفرِيِّ سِفَاحُهُ",10,"ح",2,0],["لا تمنعنِّي لهى مُمَنَّحةً","أضحت عليها الأكفُّ تقترع",11,"ع",1,0],["لا تمتحنّي بمنع وجهك عي","نيَّ فلا صبرَ لي على مِحنك",12,"ك",1,0],["لا تمتعِض للتي صاحتْ قوابلُها","قد التقتْ دجلةُ العوراءُ والنيلُ",13,"ل",1,0],["لا تَمَلُّ البروكَ أو تقعُ الطي","رَ على متنها كبعضِ الأروم",14,"م",1,0],["لا تماروا الناس فيما اعتقدوا","كل نفس بكتاب وسبيل",15,"ل",1,0],["لا تملك المرضى به أرواحها","سأما وإن ملكت به أجسامها",16,"م",3,0],["لا تَمضِ فيها وَأرح مِنها الجَسد","وَامشض بِلا درعِ كَما يَمضي الأَسَد",17,"د",1,0],["لا تَمُرَّنَّ عَلى العَينِ","وَلا بِالأَنفِ جيفَه",18,"ف",2,0],["لا تَمنَحِ المَحبوبَ شُكرَكَ كُلَّهُ","وَاِقرِن بِهِ شُكرَ الأَجيرِ المُجهَدِ",19,"د",1,0],["لا تَمَنّى الزَمانُ مِنها مَزيداً","إِن تَمَنَّيتُ أَن تَفُكّي وِثاقي",20,"ق",2,0],["لا تَموتُ النَفسُ إِلّا بِاِسمِهِ","قامَ بِالمَوتِ عَلَيها وَقَهَر",21,"ر",1,0],["لا تَمْزُجَنْها بغير الماءِ مِنْكَ فإنْ","تَبْخَلْ يداكَ فَدَمْعي سَوْفَ يَمْزُجُها",22,"ج",3,0],["لا تُمازِح في غَيرِ وَقتِ مُزاحِ","وَاِتَّخِذ آلَةً لِوَقتِ الصَياحِ",23,"ح",1,1],["لا تَمنَعونَ لَهُم حَرامَ حَليلَةٍ","وَتُنالُ أَيُّمُهُم وَإِن لَم تُخطَبِ",24,"ب",1,0],["لا تَمدَحَنَّ فَتىً تَرجو نَوافِلَهُ","وَلا تَزُر غَيرَهُ ما عاشَ عَبّادُ",25,"د",1,1],["لا تمزجنها بغير الريق منك وإن","تبخل بذاك فدمعي سوف يمزجها",26,"ج",3,0],["لا تُمضِ رَأيَكَ في هَوىً","إِلّا وَرَأيُكَ فيهِ قَصدُ",27,"د",1,0],["لا تُمسِكِ المالَ وَاِستَرضِ الإِلَهَ بِهِ","فَإِنَّ حَسبَكَ مِنهُ الرَيُّ وَالشَبَعُ",28,"ع",1,0],["لا تَمشِ في الناسِ إِلّا رَحمَةً لَهُمُ","وَلا تُعامِلهُمُ إِلّا بِإِنصافِ",29,"ف",1,0],["لا تَمحُ رَوعَتَهَا بذكر فعالها","دعها تمرّ كما بدت بجلالها",30,"ل",3,1],["لا تَمِل واسخر من الدنيا إذا","شاءت الأيامُ يوماً أن تميلا",31,"ل",2,0],["لا تَمنَعَنّي وَقفَةً أَشفي بِها","داءَ الفِراقِ فَإِنَّها ماعونُ",32,"ن",1,0],["لا تَمتَري في الحَقِّ تَطلُبُهُ وَلا","تَلوي العِنانَ لِباطِلٍ لا يَنفَعُ",33,"ع",1,0],["لا تَمنَعَنَّ مِنَ العَدُوِّ ذِمارَها","إِنَّ الذِمارَ بِغَيرِ بأسِكَ يُمنَعُ",34,"ع",1,0],["لا تَملكُ الدنيا عليهم أمرَهم","في شِدّةٍ من دَهرهِم ورَخاءِ",35,"ا",2,0],["لا تَمَلّا حَثَّنا وَاِسقِيانا","قَد بَدا الصُبحُ لَنا وَاِستَبانا",36,"ن",2,1],["لا تُمْسِكُ الدَّمْعَ مِنْ حُزْنٍ عُيُونُهُمُ","إِلاَّ كما يُمْسِكُ المَاءُ الغَرابِيلُ",37,"ل",1,0],["لا تُمكِنَنّي مِنَ العِربيدِ يَشرَبُني","وَلا اللَئيمِ الَّذي إِن شَمَّني قَطَبا",38,"ب",2,0],["لا تَمزُجِ الخَمرَ عَلى حالٍ","وَسَقِّنيها بِنتَ أَحوالِ",39,"ل",1,1],["لا تُمَنّي أَخاكِ في مِلَّةِ الحُب","بِ بِداءٍ دَواؤُهُ مَفقودُ",40,"د",1,0],["لا تُمسِيَنَّ عَلى مَن ماتَ مُلتَهِفاً","فَالناشِئاتُ إِذا طالَ المَدى عُجُزُ",41,"ز",1,1],["لا تُمسِ في نارِ الضَميرِ فَراشَةً","فَضَغائِنُ الصَدرِ الحَريقُ المُشعَلُ",42,"ل",1,0],["لا تَمنَعُ الغادَةَ الحَسناءَ نِعمَتُها","وَأَن تَقومَ حَوالَيها حَواليها",43,"ي",3,0],["لا تُمِلْنِي عن حِمى مُرتَبَعي","عُدْوَتَيْ تَيْمَا لِرَبْعٍ بِتُمَي",44,"ي",1,0],["لا تمسكي بالقوم إن","نَ القوم لا يرعون عهدا",45,"د",2,0],["لا تمنع الشعر عما","يقوله لذويه",46,"ه",1,0],["لا تَموت النفس بالهم","مِ ولا الهمّ يموتُ",47,"ت",1,0],["لا تمض فيها وأرح منها الجسد","وامض بلا درع كما يمضي الأسد",48,"د",1,0],["لاَ تَمْلأُ القَلْبَ الخَلِيَّ وَدَأبُهَا","نَهْكُ القُوَى فِي شِقْوَةٍ وَسُعُودِ",49,"د",1,0],["لا تُمْسِكُ الزَّمَن الَّذِي","يَجْرِي وَلاَ تَنْسَى مَعادَكْ",50,"ك",1,0],["لا تُمَنِّي أخاكِ في مِلَّة الْحُب","بِدَاءٍ دَوَاؤُهُ مَفْقُود",51,"د",1,0],["لا تُمِلها عني وفيَّ حَراكٌ","واسقنِها حتى ترانيَ يَبسا",52,"س",2,0],["لا تَمنعَنَّ يدَ المعروفِ عن أَحَد ٍ","ما دُمْتَ مُقْتَدِرًا فالسَّعْدُ تاراتُ",53,"ت",1,0],["لا تمل بي إلى الرجاء فقد","أودى بنفسي طموحها والرجاء",54,"ا",2,0],["لا تَمنَعونَ لَهُمْ جَرَامَ حَلِيلَةٍ","، وَتُنالُ أيّمُهُمْ وَإنْ لمْ تُخْطَبِ",55,"ب",1,0],["لاتموت الخيول برداً وجوعاً","إن للعاشقين رباً رحيما ..",56,"م",2,0],["لا تمتحنّي بمنع وجهك عينيْ","يَ فلا صبرَ لي على مِحنك",57,"ك",1,0],["لاَ تَمَلَّ الْقِتَالَ يا ابْنَ عُبَادٍ","صبرِ النفسَ إنني غيرُ سالِ",58,"ل",1,0],["لا تمنيك الأماني في المَدَى","بخلود إنما الدنيا كَظِلّْ",59,"ل",1,0],["لا تمدُدَنْها في خَبائثِ مَتْجِرِ","تُرْدِيكَ في ظلماتِ ليلٍ مُدْبِر",60,"ر",1,0],["لا تَمُرَّنَّ باللِّوَى إِنَّ في جَن","بِ اللّوى أربُعاً لَهَا ورَسُومَا",61,"م",2,0],["لا تَمزُجي صَفوَ الوِدادِ بِجِفوَةٍ","ما الماءُ مُحتاجٌ إِلى أَن يُقطَبا",62,"ب",2,0],["لا تمتعض بمسبّة ال","مزري عليك طلاب غمّك",63,"ك",1,0],["لا تَمنعِ الفَضلَ مِن مالٍ حُبيتَ بِهِ","فَالبَذلُ يُنميهِ بَعدَ الأَجرِ يُدّخَرُ",64,"ر",1,1],["لا تمحوَنْ بما اقتنيت من العلا","والمجدِ رَسْمَ الودِّ مَحْوَ الأسطر",65,"ر",1,0],["لا تمضِ في هذا الدلالِ فانما","أهوى دلالك أن يكونَ تصنعا",66,"ع",2,0],["لا تمزجنها بغير الرِّيق منك وإن","تبخل فإنَّ دموعي سوف تمزجها",67,"ج",3,0],["لا تمزجوا كأسي فإن مدامعي","تكفي وتفضل عن مزاج شرابي",68,"ب",2,0],["لا تمن النفس بالماضي سدى","ما إلى عيش الصبا من سبل",69,"ل",1,0],["لا تَموتُ القُلوبُ إِن سَكَبَت في","جَوفِها أَنمُلُ السَماءِ غَراما",70,"م",2,0],["لا تَمَّم الله لِي في مدّتي أملاً","إن لَمْ تكن لِيَ فِيما أرتجِي أملا",71,"ل",2,0],["لا تمكِّن لَحَاظَ عينيك من قت","لِي فما اللّحظ فيه بالمعذور",72,"ر",1,0],["لا تَمنَعِ الطَيفَ مِن طيبِ الوِصالِ فَما","يَضُرُّهُ أن يُريني الصِدق في الكَذِبِ",73,"ب",1,0],["لا تُمِل غُصنَ دَوحَتي فَهوَ لا يَق","بَلُ كَسراً وَعودُهُ اللَدنُ غَضُّ",74,"ض",1,0],["لاَ تُمْطِلَنْهُ فَفِي مَطْلِ الْغَنِيِّ أَتْتْ","آثَارُ صِدْقٍ بِأَنَّ الظُّلْمَ فيهِ بَدَا",75,"د",2,0],["لا تمس الباً للزمان على شجٍ","سيان فيك صباحه ومساؤه",76,"ا",3,0],["لا تمل إلا إلى الحق فهل","في الملا أعذب من حب الملاح",77,"ح",1,0],["لا تمل بالمطىّ عَن ذروة","العز بعز المنيع تنعم مقيلا",78,"ل",2,0],["لا تمهر الحرية الحمراء","بالثمن اليسير",79,"ر",1,0],["لا تَملكُ الأَعداءُ فضلَ مقادَتي","وَيقودُني ما شاءَ ودُّ الصاحِبِ",80,"ب",1,0],["لا تُمسكَ الأيدي بِها إلّا على","حَبل يدلّى بِالغرور ويقطعُ",81,"ع",1,0],["لا تَمتحنّي بِالبلايا إنّني","مِنها أفرُّ إِليك حتّى تدبرا",82,"ر",2,0],["لا تَمْخَضَنْ فِكْرَكَ في مَدْحهِ","فَذاكَ مَن لا عِنْدَهُ زُبْدَه",83,"ه",1,0],["لا تَمنع الخَلق عَن إِحسان خالقهم","مَن ذا الَّذي لِعَطاء اللَه قَد مَنَعا",84,"ع",2,0],["لا تَمدُدِ الأيدي إليه فطالما","شَنُّوا الحُروبَ لأنْ مدَدْنا الأعيُنا",85,"ن",2,0],["لا تَمَسُّ الأَرضَ إِلَّا دونَها","عَن بَلاطِ الأَرضِ ثَوبٌ مُنعَفِرْ",86,"ر",1,0],["لا تَملِكنَّ ثَناءَ زائِدهِ","فتَظُنُّه ضَرباً مِن البَذلِ",87,"ل",1,0],["لا تميلي عن المُزَمَّلِ حقّاً","بدماه فقد غدوتُ نحيلا",88,"ل",2,0],["لا تميلي عن الأثيم فإني","عنك يوماً وساعةً لن أميلا",88,"ل",2,0],["لا تميلي وشمس عمريَ مالت","لغروبٍ فعاد شمسي أفولا",88,"ل",2,0],["لا تمسي رفات","ولم تصلح لمثواك",89,"ك",1,0],["لا تمنعوا طيفكم من أن يمرّ بنا","فما على عبرات الطيف من عارِ",90,"ر",1,0],["لا تمنع الملك المرهوب أهبته","ولا الغواني حسان الدلِّ والحور",91,"ر",1,0],["لا تَمحِ بِالهُجران نور وَصالَه","فَصَميم حبّك في صَميم فُؤادِهِ",92,"د",2,0],["لا تَملأَنَّ قَدحي وارفِق فَقَد مُزِجَت","لي مِن جُفونِكَ أَقداح وَأَقداحُ",93,"ح",1,1],["لا تمتني في التنائي بالأسى","فحياة القلب أن تدنو وتدني",94,"ن",2,0],["لا تمنحوه سوى القطيعه وحدَها","فمن القطيعةِ ما يكونُ الزاجرا",95,"ر",2,0],["لا تملك الحِيلُ النوافذ ضبطها","حتى إذا يدنو لها الكافي كُفُوا",96,"ف",3,0],["لا تمتهنه في كلّ سوقٍ فقد","تربَح حيناً وبيعُك الخاسرْ",97,"ر",1,0],["لا تَمنَعِ الرَيَّ عِطاشاً فَما","مِن مَورِدٍ إِلّا إِلَيهِ سَبيل",98,"ل",1,0],["لا تَمنعَنْ حَذَرَ الوشاةِ أتيتَّها","فُهِمَ الغرامُ وذاعتِ الأسرارُ",99,"ر",1,0],["لا تمد منه يد","بيننا بغير حبا",100,"ب",2,0],["لا تمل للأغيار يا خلِّ قلباً","فعناء الأغيار شرحٌ يطول",101,"ل",1,0],["لا تمقُتي أثراً بي في الخُطوبِ بَدا","فزينَةُ الصّارم الهِنديّ بالأثرِ",102,"ر",1,0],["لا تمزِجنَّي بالّذين تراهُمُ","فالنّبعُ ممزوجٌ بغير الخِرْوَعِ",103,"ع",1,0],["لا تملنا أيها الغائب عن","عينه بالجفن دع هذا الملاما",104,"م",2,0],["لا تموِّهْ بزينبٍ لا ولا ميْ","نارهم في الحشى بدت وكوت كيْ",105,"ي",1,0],["لا تموِّهْ بك واطلب منك ما","فرَّ من يوم بشأن ضيعك",106,"ك",1,0],["لا تمش معه كما ترى","وامش إليه القهقرى",107,"ر",2,1],["لا تَمْدَحُوني وامْدَحوه فمِنْ","إِنعامِه جُودِي على المجْتَدين",108,"ن",1,0]]}