[460,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[470,"يا من إذا حال أخ لا يحول","https://www.aldiwan.net/poem59772.html","السريع"],[479,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[481,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[502,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[516,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[553,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[560,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[560,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[560,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[560,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[577,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[971,"","https://poetry.dctabudhabi.ae/diwan/poem/21157","الكامل"]],"verses":[["لا تَملِكُ العَرَصاتُ قَعدَتَهُ","وَإِنِ اِستَقَرَّ فَفي ذُرى الإِبلِ",0,"ل",1,0],["لا تَمشِيَنَّ إِلى أَمرٍ تُعابُ بِهِ","فَقَلَّما تَفطُنُ الأَيّامُ بِالزَلَلِ",1,"ل",1,0],["لا تَملِكُ الفَحشاءُ جانِبَ سَمعِهِ","وَيَزِلُّ قَولُ الهُجرِ عَنهُ وَيَزلَقُ",2,"ق",1,0],["لا تمنعن يد المعروف عن احد","ما دمت مقتدراً.. والعيش جنات",3,"ت",1,0],["لا تَمتَطي شَهَواتِ النَّفسِ جامِحَةً","فكِسرَةُ الخُبز عن حَلواكِ تَجزيها",4,"ي",3,0],["لا تَمْنَعِي الأَرْوَاحِ مِنْ قُبْلَةٍ","لَعَلَّ رُوحِي بَعْضُ تِلْكَ النَّسَمْ",5,"م",1,0],["لا تَمْحُ أَيُّهَا الصَّدِيقُ المُفَدَّى","لا تَزُلْ أَيُّهَا الفَقِيدُ المُقِيمُ",6,"م",1,0],["لا تمطلوا دَيْن الغريب فإنني","منكم وإن رَغِمَتْ لذل حُسَّدَي",7,"د",2,0],["لا تملني إذا جزعت فإني","ما ملكت الخيار في إيجادي",8,"د",2,0],["لا تَمنَعونَ لَكُم عِرساً وَما لَكُمُ","إِلّا بِغَيرِكُمُ وِردٌ وَلا صَدَرُ",9,"ر",1,0],["لا تمنعنَّ مَهيرَةً من مهْرها","إن السَّرِيَّ من الفرِيِّ سِفَاحُهُ",10,"ح",2,0],["لا تمنعنِّي لهى مُمَنَّحةً","أضحت عليها الأكفُّ تقترع",11,"ع",1,0],["لا تمتحنّي بمنع وجهك عي","نيَّ فلا صبرَ لي على مِحنك",12,"ك",1,0],["لا تمتعِض للتي صاحتْ قوابلُها","قد التقتْ دجلةُ العوراءُ والنيلُ",13,"ل",1,0],["لا تَمَلُّ البروكَ أو تقعُ الطي","رَ على متنها كبعضِ الأروم",14,"م",1,0],["لا تماروا الناس فيما اعتقدوا","كل نفس بكتاب وسبيل",15,"ل",1,0],["لا تملك المرضى به أرواحها","سأما وإن ملكت به أجسامها",16,"م",3,0],["لا تَمضِ فيها وَأرح مِنها الجَسد","وَامشض بِلا درعِ كَما يَمضي الأَسَد",17,"د",1,0],["لا تَمُرَّنَّ عَلى العَينِ","وَلا بِالأَنفِ جيفَه",18,"ف",2,0],["لا تَمنَحِ المَحبوبَ شُكرَكَ كُلَّهُ","وَاِقرِن بِهِ شُكرَ الأَجيرِ المُجهَدِ",19,"د",1,0],["لا تَمَنّى الزَمانُ مِنها مَزيداً","إِن تَمَنَّيتُ أَن تَفُكّي وِثاقي",20,"ق",2,0],["لا تَموتُ النَفسُ إِلّا بِاِسمِهِ","قامَ بِالمَوتِ عَلَيها وَقَهَر",21,"ر",1,0],["لا تَمْزُجَنْها بغير الماءِ مِنْكَ فإنْ","تَبْخَلْ يداكَ فَدَمْعي سَوْفَ يَمْزُجُها",22,"ج",3,0],["لا تُمازِح في غَيرِ وَقتِ مُزاحِ","وَاِتَّخِذ آلَةً لِوَقتِ الصَياحِ",23,"ح",1,1],["لا تَمنَعونَ لَهُم حَرامَ حَليلَةٍ","وَتُنالُ أَيُّمُهُم وَإِن لَم تُخطَبِ",24,"ب",1,0],["لا تَمدَحَنَّ فَتىً تَرجو نَوافِلَهُ","وَلا تَزُر غَيرَهُ ما عاشَ عَبّادُ",25,"د",1,1],["لا تمزجنها بغير الريق منك وإن","تبخل بذاك فدمعي سوف يمزجها",26,"ج",3,0],["لا تُمضِ رَأيَكَ في هَوىً","إِلّا وَرَأيُكَ فيهِ قَصدُ",27,"د",1,0],["لا تُمسِكِ المالَ وَاِستَرضِ الإِلَهَ بِهِ","فَإِنَّ حَسبَكَ مِنهُ الرَيُّ وَالشَبَعُ",28,"ع",1,0],["لا تَمشِ في الناسِ إِلّا رَحمَةً لَهُمُ","وَلا تُعامِلهُمُ إِلّا بِإِنصافِ",29,"ف",1,0],["لا تَمحُ رَوعَتَهَا بذكر فعالها","دعها تمرّ كما بدت بجلالها",30,"ل",3,1],["لا تَمِل واسخر من الدنيا إذا","شاءت الأيامُ يوماً أن تميلا",31,"ل",2,0],["لا تَمَلَّ القِتالَ يا اِبنَ عُبادٍ","صَبِّرِ النَفسَ إِنَّني غَيرُ سالِ",32,"ل",1,0],["لا تَمنَعَنّي وَقفَةً أَشفي بِها","داءَ الفِراقِ فَإِنَّها ماعونُ",33,"ن",1,0],["لا تَمتَري في الحَقِّ تَطلُبُهُ وَلا","تَلوي العِنانَ لِباطِلٍ لا يَنفَعُ",34,"ع",1,0],["لا تَمنَعَنَّ مِنَ العَدُوِّ ذِمارَها","إِنَّ الذِمارَ بِغَيرِ بأسِكَ يُمنَعُ",35,"ع",1,0],["لا تَملكُ الدنيا عليهم أمرَهم","في شِدّةٍ من دَهرهِم ورَخاءِ",36,"ا",2,0],["لا تَمَلّا حَثَّنا وَاِسقِيانا","قَد بَدا الصُبحُ لَنا وَاِستَبانا",37,"ن",2,1],["لا تُمْسِكُ الدَّمْعَ مِنْ حُزْنٍ عُيُونُهُمُ","إِلاَّ كما يُمْسِكُ المَاءُ الغَرابِيلُ",38,"ل",1,0],["لا تُمكِنَنّي مِنَ العِربيدِ يَشرَبُني","وَلا اللَئيمِ الَّذي إِن شَمَّني قَطَبا",39,"ب",2,0],["لا تَمزُجِ الخَمرَ عَلى حالٍ","وَسَقِّنيها بِنتَ أَحوالِ",40,"ل",1,1],["لا تُمَنّي أَخاكِ في مِلَّةِ الحُب","بِ بِداءٍ دَواؤُهُ مَفقودُ",41,"د",1,0],["لا تُمسِيَنَّ عَلى مَن ماتَ مُلتَهِفاً","فَالناشِئاتُ إِذا طالَ المَدى عُجُزُ",42,"ز",1,1],["لا تُمسِ في نارِ الضَميرِ فَراشَةً","فَضَغائِنُ الصَدرِ الحَريقُ المُشعَلُ",43,"ل",1,0],["لا تَمنَعُ الغادَةَ الحَسناءَ نِعمَتُها","وَأَن تَقومَ حَوالَيها حَواليها",44,"ي",3,0],["لا تُمِلْنِي عن حِمى مُرتَبَعي","عُدْوَتَيْ تَيْمَا لِرَبْعٍ بِتُمَي",45,"ي",1,0],["لا تمسكي بالقوم إن","نَ القوم لا يرعون عهدا",46,"د",2,0],["لا تمنع الشعر عما","يقوله لذويه",47,"ه",1,0],["لا تَموت النفس بالهم","مِ ولا الهمّ يموتُ",48,"ت",1,0],["لاَ تَمْنَعُ المَرْءَ أَحْجَاءُ البِلاَدِ ولاَ","تُبْنَى لَهُ في السَّمَواتِ السَّلاَلِيمُ",49,"م",1,0],["لا تمض فيها وأرح منها الجسد","وامض بلا درع كما يمضي الأسد",50,"د",1,0],["لاَ تَمْلأُ القَلْبَ الخَلِيَّ وَدَأبُهَا","نَهْكُ القُوَى فِي شِقْوَةٍ وَسُعُودِ",51,"د",1,0],["لا تُمْسِكُ الزَّمَن الَّذِي","يَجْرِي وَلاَ تَنْسَى مَعادَكْ",52,"ك",1,0],["لا تُمَنِّي أخاكِ في مِلَّة الْحُب","بِدَاءٍ دَوَاؤُهُ مَفْقُود",53,"د",1,0],["لا تُمِلها عني وفيَّ حَراكٌ","واسقنِها حتى ترانيَ يَبسا",54,"س",2,0],["لا تَمنعَنَّ يدَ المعروفِ عن أَحَد ٍ","ما دُمْتَ مُقْتَدِرًا فالسَّعْدُ تاراتُ",55,"ت",1,0],["لا تمل بي إلى الرجاء فقد","أودى بنفسي طموحها والرجاء",56,"ا",2,0],["لا تَمنَعونَ لَهُمْ جَرَامَ حَلِيلَةٍ","، وَتُنالُ أيّمُهُمْ وَإنْ لمْ تُخْطَبِ",57,"ب",1,0],["لاتموت الخيول برداً وجوعاً","إن للعاشقين رباً رحيما ..",58,"م",2,0],["لا تمتحنّي بمنع وجهك عينيْ","يَ فلا صبرَ لي على مِحنك",59,"ك",1,0],["لا تمنيك الأماني في المَدَى","بخلود إنما الدنيا كَظِلّْ",60,"ل",1,0],["لا تمدُدَنْها في خَبائثِ مَتْجِرِ","تُرْدِيكَ في ظلماتِ ليلٍ مُدْبِر",61,"ر",1,0],["لا تَمُرَّنَّ باللِّوَى إِنَّ في جَن","بِ اللّوى أربُعاً لَهَا ورَسُومَا",62,"م",2,0],["لا تَمزُجي صَفوَ الوِدادِ بِجِفوَةٍ","ما الماءُ مُحتاجٌ إِلى أَن يُقطَبا",63,"ب",2,0],["لا تمتعض بمسبّة ال","مزري عليك طلاب غمّك",64,"ك",1,0],["لا تَمنعِ الفَضلَ مِن مالٍ حُبيتَ بِهِ","فَالبَذلُ يُنميهِ بَعدَ الأَجرِ يُدّخَرُ",65,"ر",1,1],["لا تمحوَنْ بما اقتنيت من العلا","والمجدِ رَسْمَ الودِّ مَحْوَ الأسطر",66,"ر",1,0],["لا تمضِ في هذا الدلالِ فانما","أهوى دلالك أن يكونَ تصنعا",67,"ع",2,0],["لا تمزجنها بغير الرِّيق منك وإن","تبخل فإنَّ دموعي سوف تمزجها",68,"ج",3,0],["لا تمزجوا كأسي فإن مدامعي","تكفي وتفضل عن مزاج شرابي",69,"ب",2,0],["لا تمن النفس بالماضي سدى","ما إلى عيش الصبا من سبل",70,"ل",1,0],["لا تَموتُ القُلوبُ إِن سَكَبَت في","جَوفِها أَنمُلُ السَماءِ غَراما",71,"م",2,0],["لا تَمَّم الله لِي في مدّتي أملاً","إن لَمْ تكن لِيَ فِيما أرتجِي أملا",72,"ل",2,0],["لا تمكِّن لَحَاظَ عينيك من قت","لِي فما اللّحظ فيه بالمعذور",73,"ر",1,0],["لا تَمنَعِ الطَيفَ مِن طيبِ الوِصالِ فَما","يَضُرُّهُ أن يُريني الصِدق في الكَذِبِ",74,"ب",1,0],["لا تُمِل غُصنَ دَوحَتي فَهوَ لا يَق","بَلُ كَسراً وَعودُهُ اللَدنُ غَضُّ",75,"ض",1,0],["لاَ تُمْطِلَنْهُ فَفِي مَطْلِ الْغَنِيِّ أَتْتْ","آثَارُ صِدْقٍ بِأَنَّ الظُّلْمَ فيهِ بَدَا",76,"د",2,0],["لا تمس الباً للزمان على شجٍ","سيان فيك صباحه ومساؤه",77,"ا",3,0],["لا تمل إلا إلى الحق فهل","في الملا أعذب من حب الملاح",78,"ح",1,0],["لا تمل بالمطىّ عَن ذروة","العز بعز المنيع تنعم مقيلا",79,"ل",2,0],["لا تمهر الحرية الحمراء","بالثمن اليسير",80,"ر",1,0],["لا تَملكُ الأَعداءُ فضلَ مقادَتي","وَيقودُني ما شاءَ ودُّ الصاحِبِ",81,"ب",1,0],["لا تُمسكَ الأيدي بِها إلّا على","حَبل يدلّى بِالغرور ويقطعُ",82,"ع",1,0],["لا تَمتحنّي بِالبلايا إنّني","مِنها أفرُّ إِليك حتّى تدبرا",83,"ر",2,0],["لا تَمْخَضَنْ فِكْرَكَ في مَدْحهِ","فَذاكَ مَن لا عِنْدَهُ زُبْدَه",84,"ه",1,0],["لا تَمنع الخَلق عَن إِحسان خالقهم","مَن ذا الَّذي لِعَطاء اللَه قَد مَنَعا",85,"ع",2,0],["لا تَمدُدِ الأيدي إليه فطالما","شَنُّوا الحُروبَ لأنْ مدَدْنا الأعيُنا",86,"ن",2,0],["لا تَمَسُّ الأَرضَ إِلَّا دونَها","عَن بَلاطِ الأَرضِ ثَوبٌ مُنعَفِرْ",87,"ر",1,0],["لا تَملِكنَّ ثَناءَ زائِدهِ","فتَظُنُّه ضَرباً مِن البَذلِ",88,"ل",1,0],["لا تميلي عن المُزَمَّلِ حقّاً","بدماه فقد غدوتُ نحيلا",89,"ل",2,0],["لا تميلي عن الأثيم فإني","عنك يوماً وساعةً لن أميلا",89,"ل",2,0],["لا تميلي وشمس عمريَ مالت","لغروبٍ فعاد شمسي أفولا",89,"ل",2,0],["لا تمسي رفات","ولم تصلح لمثواك",90,"ك",1,0],["لا تمنعوا طيفكم من أن يمرّ بنا","فما على عبرات الطيف من عارِ",91,"ر",1,0],["لا تمنع الملك المرهوب أهبته","ولا الغواني حسان الدلِّ والحور",92,"ر",1,0],["لا تَمحِ بِالهُجران نور وَصالَه","فَصَميم حبّك في صَميم فُؤادِهِ",93,"د",2,0],["لا تَملأَنَّ قَدحي وارفِق فَقَد مُزِجَت","لي مِن جُفونِكَ أَقداح وَأَقداحُ",94,"ح",1,1],["لا تمتني في التنائي بالأسى","فحياة القلب أن تدنو وتدني",95,"ن",2,0],["لا تمنحوه سوى القطيعه وحدَها","فمن القطيعةِ ما يكونُ الزاجرا",96,"ر",2,0],["لا تملك الحِيلُ النوافذ ضبطها","حتى إذا يدنو لها الكافي كُفُوا",97,"ف",3,0],["لا تمتهنه في كلّ سوقٍ فقد","تربَح حيناً وبيعُك الخاسرْ",98,"ر",1,0],["لا تَمنَعِ الرَيَّ عِطاشاً فَما","مِن مَورِدٍ إِلّا إِلَيهِ سَبيل",99,"ل",1,0],["لا تَمنعَنْ حَذَرَ الوشاةِ أتيتَّها","فُهِمَ الغرامُ وذاعتِ الأسرارُ",100,"ر",1,0],["لا تمد منه يد","بيننا بغير حبا",101,"ب",2,0],["لا تمل للأغيار يا خلِّ قلباً","فعناء الأغيار شرحٌ يطول",102,"ل",1,0],["لا تمقُتي أثراً بي في الخُطوبِ بَدا","فزينَةُ الصّارم الهِنديّ بالأثرِ",103,"ر",1,0],["لا تمزِجنَّي بالّذين تراهُمُ","فالنّبعُ ممزوجٌ بغير الخِرْوَعِ",104,"ع",1,0],["لا تملنا أيها الغائب عن","عينه بالجفن دع هذا الملاما",105,"م",2,0],["لا تموِّهْ بزينبٍ لا ولا ميْ","نارهم في الحشى بدت وكوت كيْ",106,"ي",1,0],["لا تموِّهْ بك واطلب منك ما","فرَّ من يوم بشأن ضيعك",107,"ك",1,0],["لا تمش معه كما ترى","وامش إليه القهقرى",108,"ر",2,1],["لا تَمْدَحُوني وامْدَحوه فمِنْ","إِنعامِه جُودِي على المجْتَدين",109,"ن",1,0],["لا تُمسِ في شَكِّ المُنونِ أَما تَرى","أَيّامُهُ مَشهورَةَ الإيضاحِ",110,"ح",1,0]]}