{"poems":[[53,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[68,"أهلا بشهب عند إشراقها","https://www.aldiwan.net/poem40990.html","السريع"],[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[42,"يا ليت ليلى رأتنا غير جازعة","https://www.aldiwan.net/poem42291.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[92,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[96,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[124,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[347,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[435,"لله خير جراءة","https://www.aldiwan.net/poem40718.html","مجزوء الكامل"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[466,"وما رأى الناس من قبلي وان شرفوا","https://www.aldiwan.net/poem15419.html","البسيط"],[466,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122541","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35371","الطويل"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114839","الوافر"],[1990,"","https://poetry.dctabudhabi.ae/diwan/poem/79657","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48196","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48203","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48316","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216808","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102739","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[5493,"جيدُ الدُّجى","https://www.poetsgate.com/ViewPoem.aspx?id=201941",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""]],"verses":[["تنضح بالريق من كنيفٍ","حديثُه في الأنام سيرَه",0,"ر",2,0],["تُنضِبُ بَحرَ اللَيلِ إِذ تَغتَدي","ناهِلَةً مِن لُجِّهِ الطافِحِ",1,"ح",1,0],["تَنضو بِهِ مِلَّةُ الإِسلامِ مرهَفَةً","بِضَربِهِنَّ الطلى تَعلو على المللِ",2,"ل",1,0],["تُنَضِّحُ الرِيقَ مِن فِيها إِذا نَطَقَت","كَأَنَّما مَضَغَت عِلكَ الذَعاليقِ",3,"ق",1,0],["تَنْضَمُّ حِينَ جَلاَئِهِ","أَشْتَاتهُ فِي مَجْمَعِ",4,"ع",1,0],["تُنُضِّمُها صِيدٌ كُماةٌ أشاوسٌ","يقودُهُمُ شهَمٌ يقول ويفعل",5,"ل",1,0],["تَنَضَّحُ من صدرِك المُستطاب","نزيفاً إلى الله يَستظلِم",6,"م",1,0],["تُنضِّرُ الوردَ والرَيحانَ أدمعُنا","وتَسكُبُ العِطرَ والصَهباءَ نَجوانا",7,"ن",2,0],["تنضو وتلبس أفوافاً محبرة","مستبدلاً جدداً من بعد أنضاء",8,"ا",2,0],["تنضح اللّذةُ الشَهِيَّةُ مِنها","خَمرَةٌ من جَمالِها المَأثورِ",9,"ر",1,0],["تَنضو جِذاعَ المَهارى وَهِيَ رَيِّضَةٌ","وَلا تُمالِكُها العِيدِيَّةُ الذُلُلُ",10,"ل",1,0],["تنضب العين إذا غشيت","ها قطوب الحزن والشجن",11,"ن",1,0],["تنضي سوابق جنحها","بيض الظبا عند الوثوبِ",12,"ب",1,0],["تنضو الجياد كأنها ملمومةٌ","هوت انحداراً من فَقار يلملمِ",13,"م",1,0],["تنضى النهارَ شَمْلةً جَونِيَّةً","وتَلبَسُ الليلَ رِداءً أخضرا",14,"ر",2,0],["تنضُبُ أعلاماً لكم سَيرُها","في الأرضِ فلتُشكَرْ يَدُ الناصبِ",15,"ب",1,0],["تنضو ملابس أعْيادٍ وتلبسها","تبني المعالي وللأعداءِ تحْتنكُ",16,"ك",1,0],["تنْضو ملابس كلِّ عيدٍ ذاهِبٍ","وتُجِدُّ آخرَ مُقْبلاً في القابِل",17,"ل",1,0],["تَنضُو الصِّبا وتُريدُ أيام الصِّبا","أتُراكَ تَخلُفُ في الطَّماعَة أشعبا",18,"ب",2,1],["تَنَضنَضَ مِن بُرهانِها كُلُّ لَهذَمٍ","لَهُ في صُدورِ المُلحِدينَ وُلوجُ",19,"ج",1,0],["تَنَضنَضَ ما بَينَ الغُروسِ كَأَنَّهُ","وَقَد رَقرَقَت حَصباؤُهُ حَيَّةٌ رَقطا",20,"ط",2,0],["تَنَضَّيتُ القِلاصَ الى حكيمٍ","خوارجَ من تَبالةَ او مَناها",21,"ا",3,0],["تنضُو البراجمُ والحروبُ جَمالها","لا أنْ تُحَثَّ وأن تحثَّ سواءُ",22,"ا",2,0],["تنْضاعُ رَوْضَتُها ونفحةُ تُرْبِها","عن مسكِ دارينٍ ونشرِ جَوَاءِ",23,"ا",2,0],["تنضاع عن مسك أتته لنا","لمَّا سرتْ وهْناً صَباَ نَجْدِ",24,"د",1,0],["تُنْضَى إليه ركاب الحمد ظامية","ترتاد ريَّ الصدى في منبع الجود",25,"د",1,0],["تنضي اللحاظ السود بيض صوارم","وتهز أعطاف القدود رماحا",26,"ح",2,0],["تَنْضي نَهَارَكَ في صلاحِ شُؤونِه","وتبيتُ تكْلَؤُهُم بطَرفٍ سَاهِرِ",27,"ر",1,0],["تُنْضي حُسامَك في الوَغى فتخالُهُ","نهْراً بدَوْحٍ للقَنا متهَدِّلِ",28,"ل",1,0],["تُنْضي إلى الجبلِ المُنيفِ عزائِماً","أبَتِ المكارِمُ أن تَفُلَّ ظُباها",29,"ا",3,0],["تنضو الحياة على شطيك ما لبست","في ساحة العيش من غش وتمويه",30,"ي",2,0],["تنضى عليها سيوف البرق صارخة","فيها الرعود إذا احتاجت لا بساس",31,"س",1,0],["تنضِّد أسراراً بمكنون سرّها","تدبج أسفاراً بصدر الصحيفة",32,"ه",1,0],["تنضَّدَتِ الأجرامُ كالعقدِ في السَّمَا","وَجيدُ الدُّجى نحوَ الصباحِ تقدَّمَا",33,"م",2,0],["تنضح الماء وُطفه كل وادٍ","فهو للأرض أرضها وسماها",34,"ا",3,0],["تُنَضِّرنا الطفولة بالأماني..","وتَحْقننا الكهولة بالذبولِ",35,"ل",1,0]]}