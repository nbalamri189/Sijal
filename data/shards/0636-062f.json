{"poems":[[77,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[93,"ما كان ريب قبل ريب الحمام","https://www.aldiwan.net/poem11325.html","السريع"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"النار في خديه تتقد","https://www.aldiwan.net/poem11455.html","أحذ الكامل"],[78,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[62,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[62,"قد قلت للتلميذ أذهله","https://www.aldiwan.net/poem52195.html","أحذ الكامل"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[76,"فصلت والنصر والتأييد جنداكا","https://www.aldiwan.net/poem38725.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147599","السريع"],[275,"ذكرت بلجاء بالإصباح منبلجا","https://www.aldiwan.net/poem25609.html","البسيط"],[369,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[371,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[405,"وغزالة غازلتها","https://www.aldiwan.net/poem49474.html","مجزوء الكامل"],[437,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[464,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[500,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[500,"أبرز هذا وطمس","https://www.aldiwan.net/poem37993.html","مجزوء الرجز"],[558,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[558,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[567,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[567,"ياقوتة صفراء قد ركبت","https://www.aldiwan.net/poem69665.html","الكامل"]],"verses":[["ضِدّانِ ما شِئْتَ منْ داعٍ الى سرَفٍ","في الغَيّ هَذا وذا داعٍ الى شَرَفِ",0,"ف",1,0],["ضدان جاءا في مقامٍ واحدٍ","لم تجتمع في مثله الأضداد",1,"د",1,0],["ضِدَّانِ مِنْ لِينٍ وَمِنْ جَفْوَةٍ","لم يَصْحَبَا فِي المَرْءِ إِلاَ التَّمَامْ",2,"م",1,0],["ضدان مثل ندى ابن ريَّان الفتى","لنزيله والبأس يوم نزال",3,"ل",1,0],["ضدان قد جُمِعا كأنهما","دمعي يسيح ولوعتي تقِدُ",4,"د",1,0],["ضدّان أَلَّفَ صَرفُ الدَهرِ بَينَهُما","لَقَد تَلَوّن في الدهرِ أَلوانا",5,"ن",2,0],["ضدّان مختلفان طبعهما","في مبتدا التركيب متفقُ",6,"ق",1,0],["ضدان لما طال مكثهما","في الحبس لانا فيه واتفقا",7,"ق",2,0],["ضِدّانِ ذا يولي الجَميلَ وَذا","أَبَداً بِحَتفِ عُداتِهِ يَقضي",8,"ي",1,0],["ضِدّانِ في قَبضَتَيْ كفَّيكَ قد جُمعا","لولاهما لم يَطبْ عيشٌ ولولاكا",9,"ك",2,0],["ضد أبي الطيب لما غدا","منصرفاً عن شعب بوّان",10,"ن",1,0],["ضِدٌّ لِغُرّتِها بادٍ بطُرّتِها","للّهِ رَأْدُ الضُّحى يَغْشاهُ جُنحُ دُجى",11,"ج",2,0],["ضدان قد جمعا بلفظ واحد","لي في هواه بمعنيين موجَّه",12,"ه",1,0],["ضدان لم يجتمعا إلا لِما","سام الورى فيه منونٌ ومُنى",13,"ا",1,0],["ضِدّانِ لم يجمَعْهُما","إلاّ المحبَّةُ للحَرامِ",14,"م",1,0],["ضدذان لم تجتمع قبلي وأعجب ما","حدثت أن جمع الضدين إنسان",15,"ن",1,0],["ضدَّان مختلفانِ في حالٍ معاً","ذا أنذر الطاغي وهذا بشَّرا",16,"ر",2,0],["ضِدَّانِ من حكمِهِما بينَهما","تَنافُرٌ صدَّهُما فاخْتَلَفَا",17,"ف",2,0],["ضِدَّانِ فَقْرٌ وغِنًى","وقابِسٌ ومُقْتَبَسْ",18,"س",1,0],["ضد ما عنده من الله عندي","ليس عين المحب عين البغيض",19,"ض",1,0],["ضدان ضدان أمر الله أجمعه","حكم قديم به أهل النهى حكموا",20,"م",3,0],["ضِدَّانِ تَفْتِيْرُ أَلْحَاظٍ يُشَبُّ بِهَا","غَلِيْلُ شَوْقٍ وَثَغْرٌ يُبْرِدُ الْغُلَّهْ",21,"ل",2,0],["ضِدَّانِ مُنْتَثَرٌ ومُلْتَقَطٌ","والنَّثْرُ يَجْمَعُ شَمْلَهُ اللَّقْطُ",22,"ط",1,0],["ضِدّانِ قد أُلِّفَ مَعْنَاهُمَا","في لونِ مَعشُوقٍ ومهجُورِ",23,"ر",1,0]]}