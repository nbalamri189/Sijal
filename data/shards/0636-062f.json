{"poems":[[77,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[93,"ما كان ريب قبل ريب الحمام","https://www.aldiwan.net/poem11325.html","السريع"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"النار في خديه تتقد","https://www.aldiwan.net/poem11455.html","أحذ الكامل"],[78,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[62,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[62,"قد قلت للتلميذ أذهله","https://www.aldiwan.net/poem52195.html","أحذ الكامل"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[76,"فصلت والنصر والتأييد جنداكا","https://www.aldiwan.net/poem38725.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147599","السريع"]],"verses":[["ضِدّانِ ما شِئْتَ منْ داعٍ الى سرَفٍ","في الغَيّ هَذا وذا داعٍ الى شَرَفِ",0,"ف",1,0],["ضدان جاءا في مقامٍ واحدٍ","لم تجتمع في مثله الأضداد",1,"د",1,0],["ضِدَّانِ مِنْ لِينٍ وَمِنْ جَفْوَةٍ","لم يَصْحَبَا فِي المَرْءِ إِلاَ التَّمَامْ",2,"م",1,0],["ضدان مثل ندى ابن ريَّان الفتى","لنزيله والبأس يوم نزال",3,"ل",1,0],["ضدان قد جُمِعا كأنهما","دمعي يسيح ولوعتي تقِدُ",4,"د",1,0],["ضدّان أَلَّفَ صَرفُ الدَهرِ بَينَهُما","لَقَد تَلَوّن في الدهرِ أَلوانا",5,"ن",2,0],["ضدّان مختلفان طبعهما","في مبتدا التركيب متفقُ",6,"ق",1,0],["ضدان لما طال مكثهما","في الحبس لانا فيه واتفقا",7,"ق",2,0],["ضِدّانِ ذا يولي الجَميلَ وَذا","أَبَداً بِحَتفِ عُداتِهِ يَقضي",8,"ي",1,0],["ضِدّانِ في قَبضَتَيْ كفَّيكَ قد جُمعا","لولاهما لم يَطبْ عيشٌ ولولاكا",9,"ك",2,0],["ضد أبي الطيب لما غدا","منصرفاً عن شعب بوّان",10,"ن",1,0]]}