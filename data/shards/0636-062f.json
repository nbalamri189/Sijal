{"poems":[[79,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[95,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[95,"ما كان ريب قبل ريب الحمام","https://www.aldiwan.net/poem11325.html","السريع"],[74,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[53,"النار في خديه تتقد","https://www.aldiwan.net/poem11455.html","أحذ الكامل"],[80,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[64,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[64,"قد قلت للتلميذ أذهله","https://www.aldiwan.net/poem52195.html","أحذ الكامل"],[68,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[78,"فصلت والنصر والتأييد جنداكا","https://www.aldiwan.net/poem38725.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147599","السريع"],[280,"ذكرت بلجاء بالإصباح منبلجا","https://www.aldiwan.net/poem25609.html","البسيط"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[376,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[411,"وغزالة غازلتها","https://www.aldiwan.net/poem49474.html","مجزوء الكامل"],[443,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[505,"أبرز هذا وطمس","https://www.aldiwan.net/poem37993.html","مجزوء الرجز"],[563,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[563,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[572,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[572,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[572,"ياقوتة صفراء قد ركبت","https://www.aldiwan.net/poem69665.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48884","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63979","الكامل"],[868,"","https://poetry.dctabudhabi.ae/diwan/poem/177865","السريع"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109125","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20030","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12004","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108814","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49620","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66308","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110289","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53090","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53212","الكامل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95092","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27649","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2312,"","https://poetry.dctabudhabi.ae/diwan/poem/204046","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88659","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102564","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84525","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109799","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140299",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67979","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110094","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131958","الرمل"],[4127,"","https://poetry.dctabudhabi.ae/diwan/poem/73646","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76738","الكامل"],[4767,"تحية القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=179541",""],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[585,"طلع الربيع على الربوع نضيرا","https://www.poetsgate.com/ViewPoem.aspx?id=161872",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5187,"عبق نسرين","https://www.poetsgate.com/ViewPoem.aspx?id=33006",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5409,"قابلت نعيك من ربوع الشام","https://www.poetsgate.com/ViewPoem.aspx?id=155479",""],[5776,"أحتاجُ قلبا سماويا","https://www.poetsgate.com/ViewPoem.aspx?id=199437",""],[5887,"عانق الشوق فؤادي إذ ذكرت اليوم أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=35285",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"خذني لعَطفك","https://www.poetsgate.com/ViewPoem.aspx?id=193808",""],[5190,"شموع ودموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85041&r=&rc=116",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["ضِدّانِ ما شِئْتَ منْ داعٍ الى سرَفٍ","في الغَيّ هَذا وذا داعٍ الى شَرَفِ",0,"ف",1,0],["ضدان جاءا في مقامٍ واحدٍ","لم تجتمع في مثله الأضداد",1,"د",1,0],["ضِدَّانِ مِنْ لِينٍ وَمِنْ جَفْوَةٍ","لم يَصْحَبَا فِي المَرْءِ إِلاَ التَّمَامْ",2,"م",1,0],["ضدان مثل ندى ابن ريَّان الفتى","لنزيله والبأس يوم نزال",3,"ل",1,0],["ضدان قد جُمِعا كأنهما","دمعي يسيح ولوعتي تقِدُ",4,"د",1,0],["ضدّان أَلَّفَ صَرفُ الدَهرِ بَينَهُما","لَقَد تَلَوّن في الدهرِ أَلوانا",5,"ن",2,0],["ضدّان مختلفان طبعهما","في مبتدا التركيب متفقُ",6,"ق",1,0],["ضدان لما طال مكثهما","في الحبس لانا فيه واتفقا",7,"ق",2,0],["ضِدّانِ ذا يولي الجَميلَ وَذا","أَبَداً بِحَتفِ عُداتِهِ يَقضي",8,"ض",2,0],["ضِدّانِ في قَبضَتَيْ كفَّيكَ قد جُمعا","لولاهما لم يَطبْ عيشٌ ولولاكا",9,"ك",2,0],["ضد أبي الطيب لما غدا","منصرفاً عن شعب بوّان",10,"ن",1,0],["ضِدٌّ لِغُرّتِها بادٍ بطُرّتِها","للّهِ رَأْدُ الضُّحى يَغْشاهُ جُنحُ دُجى",11,"ج",2,0],["ضدان قد جمعا بلفظ واحد","لي في هواه بمعنيين موجَّه",12,"ه",1,0],["ضدان لم يجتمعا إلا لِما","سام الورى فيه منونٌ ومُنى",13,"ا",1,0],["ضِدّانِ لم يجمَعْهُما","إلاّ المحبَّةُ للحَرامِ",14,"م",1,0],["ضدذان لم تجتمع قبلي وأعجب ما","حدثت أن جمع الضدين إنسان",15,"ن",1,0],["ضدَّان مختلفانِ في حالٍ معاً","ذا أنذر الطاغي وهذا بشَّرا",16,"ر",2,0],["ضِدَّانِ من حكمِهِما بينَهما","تَنافُرٌ صدَّهُما فاخْتَلَفَا",17,"ف",2,0],["ضِدَّانِ فَقْرٌ وغِنًى","وقابِسٌ ومُقْتَبَسْ",18,"س",1,0],["ضد ما عنده من الله عندي","ليس عين المحب عين البغيض",19,"ض",1,0],["ضدان ضدان أمر الله أجمعه","حكم قديم به أهل النهى حكموا",20,"م",3,0],["ضِدَّانِ تَفْتِيْرُ أَلْحَاظٍ يُشَبُّ بِهَا","غَلِيْلُ شَوْقٍ وَثَغْرٌ يُبْرِدُ الْغُلَّهْ",21,"ل",2,0],["ضِدَّانِ مُنْتَثَرٌ ومُلْتَقَطٌ","والنَّثْرُ يَجْمَعُ شَمْلَهُ اللَّقْطُ",22,"ط",1,0],["ضِدّانِ قد أُلِّفَ مَعْنَاهُمَا","في لونِ مَعشُوقٍ ومهجُورِ",23,"ر",1,0],["ضدان يدفعني هذا ويجذبني","هذا فما صبر مدفوع ومجذوب",24,"ب",1,0],["ضدَّان منثورٌ وملتقطٌ","والنثر يجمع شملُه اللقط",25,"ط",1,0],["ضِدّانِ عندي قَصَّرا هِمَّتي","وجهٌ حَيِيٌّ ولسانٌ وَقاحْ",26,"ح",1,1],["ضدان مؤتلفان فهي ولوعةٌ","في ثلبه كولوعه في ثابها",27,"ب",3,0],["ضِدّانِ لِما اِستَجمِعا حَسُنا","وَالضِدُّ يُظهِرُ حَسنَهُ الضِدُّ",28,"د",1,0],["ضِدُّ اِسمِهِ المُنقِذِيُّ عَن ثِقَةٍ","فَلا تَلومَنَّهُ عَلى اللومِ",29,"م",1,1],["ضدان متفقان منك على دمي","عينٌ مغازلة وقلب سال",30,"ل",1,0],["ضدان ينعم جسم المرء بينهما","كالغصن ينعم بين الشمس والقمر",31,"ر",1,0],["ضد هذا بعض التفات عليٍ","ذب من بقية الأبعاض",32,"ض",1,0],["ضدان ماضينا وحاضرنا","والضد يظهر حسنه الضد",33,"د",1,0],["ضدان ضمهما محل فالتقى","صبح بجلباب الدجنة مرتد",34,"د",1,0],["ضدان ضمهما محل واحد","فالأفق بين تبلج وتجهم",35,"م",1,0],["ضِدَّينِ قد حوت معاً","قَاسِيةٌ مُحنِّنَه",36,"ه",1,0],["ضدَّ ذا لو رأيته","كنت في الحالِ مُعرضا",37,"ض",2,0],["ضِدَّينِ أو مِثلَينِ أو غَيرَينِ كَا","نَا بَل هُمَا لاَ شَك مُتَّحِدَانِ",38,"ن",1,0],["ضدان مجتمعان في وقت معا","في ذات مرء ان ذا لعجيب",39,"ب",1,0],["ضدان في نيل الثناء تغالبا","وَالماء يوشك طبعه ان يغلبا",40,"ب",2,0],["ضدّ الرضى ومراقبيّ رقيبه","وشماتة الأعدا ولوم عذولا",41,"ل",2,0],["ضد الشرير وعون عان فاقد","يَسمو عَلى عمرو العلا وَمضاض",42,"ض",1,0],["ضدان قد جمعا به وكذا الهوى","فيه السعادة مازجت افاتها",43,"ت",3,0],["ضدان زاناه باجتماح","فمن رأى الضد زان ضده",44,"د",2,0],["ضِدانِ فِي قلبي وعيني جُمعا","كَيْفَ فِي حكم الهوى هَذَا يَصِحّ",45,"ح",1,0],["ضِدَّانِ لن يَتَوافَقا لسلامةٍ","ابداً وهل ضِدَّانِ يَنفِقانِ",46,"ن",1,0],["ضده الأيام تجري","وهو كالطفل الرضيع",47,"ع",1,0],["ضِدَّانِ ما اِجتَمَعا إِلا لَدى رَجُلٍ","نَدرٍ وَما هُوَ بِالإِحسانِ مَنّانُ",48,"ن",1,0],["ضدان فيه لمعتد ولمُعتف","السيف يجمع والعطاء يفرق",49,"ق",1,0],["ضِدَّ الذين سَعَتْ بِهِمْ أقدامُُهمْ","نَحْوَ العُلا رغمَ المشَقَّةِ والألمْ",50,"م",1,0],["ضدين مختلفين يحمل منها","عبئين من حذرٍ وسوءٍ ظنون",51,"ن",1,0],["ضدان مختلفان يرسل منهما","لحنا تدفق ساحراً مسحورا",52,"ر",2,0],["ضدان قد جمعتهما حكم","م الإله علا وجلا",53,"ل",2,0],["ضدان بسحرهما فتكا .....","قد حرتُ بأيهما أثقُ",54,"ق",1,0],["ضِدَّانِ كَيفَ نَمَا فِي الصَّدرِ نَبْتُهُمَا","وكَيفَ يُمزَجُ مُبْيَضٌّ ومُسْوَدُّ",55,"د",1,0],["ضدي تحالف في الغياب وضده","وعليّ صال وما ارتعبت مهندي",56,"د",2,0],["ضدان في هذي البلاد أراهما","سعة الشعور وصحة الأجسام",57,"م",1,0],["ضدان ذنبي وطه كيف يمكنني","إبقاء طه ولم يملكني التوبُ",58,"ب",1,0],["ضد من فرق جسمي","فإذا الجسم تبدد",59,"د",1,0],["ضدَّ بعضٍ ليس ضد المعتدي","حِلفِ صهيون وأقطار الخنا؟؟",60,"ن",2,0],["ضد لبنانٍ وضد العُرْب طراً","هجمة الصهيون ساءت مأربا",61,"ب",2,0],["ضد الوجوهِ الكالحاتِ القانصا","تِ اللاعبات بجيدنا المذبوحِ",62,"ح",1,0],["ضد الذين هناؤهم إتعاسُنا","بتسلطٍ وتعجرف مفضوحِ",62,"ح",1,0],["ضِدّانِ ، فَاعجَبْ كَيفَ يُوُلدُ فِي الثَّرَى","بَدرٌ لَهُ تَحتَ الحِجابِ ضُلُوعُ",63,"ع",1,0],["ضِدّانِ تَفْتِيرُ ألْحاظٍ يشرّبُها","غليلُ شوقٍ وثغرٌ بَرَّدَ الغلّهْ",64,"ل",2,0]]}