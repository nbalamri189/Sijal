{"poems":[[95,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[95,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[74,"يا سيدي نفحات جو","https://www.aldiwan.net/poem20003.html","مجزوء الكامل"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54914","الكامل"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[108,"شرع الاستعمار","https://www.poetsgate.com/ViewPoem.aspx?id=179645",""],[189,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[310,"قل للفقيه علام تمسي حائرا","https://www.aldiwan.net/poem56589.html","الطويل"],[369,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[396,"أشكو إلى الواحد الرحمن","https://www.aldiwan.net/poem54486.html","عموديه"],[415,"يا دار لو روت محولك أدمعي","https://www.aldiwan.net/poem31645.html","عموديه"],[520,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[543,"من ذا الذي لا يستجيب إذا دعي","https://www.aldiwan.net/poem47564.html","عموديه"],[545,"عوجا على ربع ليلى أم محمود","https://www.aldiwan.net/poem56853.html","الكامل"],[580,"لا تحسبوا أني بكيت دماً","https://www.aldiwan.net/poem2917.html","أحذ الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126850","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59755","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62465","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144114","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80019","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79967","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79824","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100992","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126664","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125441","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118439","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110668","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138552",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114337","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70052","الكامل"],[4164,"","https://poetry.dctabudhabi.ae/diwan/poem/203846","الكامل"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73343","الدوبيت"],[4692,"لغز","https://www.poetsgate.com/ViewPoem.aspx?id=211040",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4929,"ساعة فخر","https://www.poetsgate.com/ViewPoem.aspx?id=199536",""],[4929,"لا تحسبِ الشعرَ نظماً أنت كاتبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203667",""],[5135,"قالوْا \"شَرِيْفٌ\"","https://www.poetsgate.com/ViewPoem.aspx?id=201815",""],[5183,"جلوة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=186442",""],[5183,"حلبة الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180224",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[307,"وجوه في المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=214163",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5376,"ياأمتي خبا النفيرُ فاسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=188498",""],[5431,"يامن لحبك بعد الله أنتسبُ","https://www.poetsgate.com/ViewPoem.aspx?id=185167",""],[5431,"مات الحسين وفاض القلب أحزانا","https://www.poetsgate.com/ViewPoem.aspx?id=191499",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5533,"ناجَيْتُ طَيْفَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=176948",""],[402,"أين المجاز فيهبط الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=36202",""],[5846,"رعشةُ إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=123431",""],[5853,"غروب شمس","https://www.poetsgate.com/ViewPoem.aspx?id=175722",""],[5881,"لا تبكِ من وجع المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=183762",""],[5956,"لا تستطيع على الشتاء القارس","https://www.poetsgate.com/ViewPoem.aspx?id=184408",""],[5977,"مطر وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212726",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6115,"اللى يحبون الهروج اللفايق","https://www.poetsgate.com/ViewPoem.aspx?id=180496",""]],"verses":[["لكن دهاك البين في شرخ الصبي","وقضى على الأمل السنى السافر",0,"ر",1,0],["لَكِنْ دَعَا دَاعِي الوَفَاءِ لِمَنْ لَهُ","فِي نَفْسِي الإِعْزَازُ وَالإِكْرَامُ",1,"م",1,0],["لَكِنْ دَعَتْهُ بِلادُهُ فَأجَابَهَا","كَيْفَ الكَرِيمُ وَقَدْ دَعَاهُ كَرِيمُ",2,"م",1,0],["لكن دراهم في يد","يّ بدت فقال ليَ الأنام",3,"م",1,0],["لَكن دَهتهم أَساليب العداة وَهُم","ساهون لاهون عَن تِلكَ الأَساليبِ",4,"ب",1,0],["لَكِنْ دهَتْهُ مِنْ عَلٍ كُتْلَةٌ","مُرْسلَةٌ مِنْ قَاذِفٍ مُبْحِرِ",5,"ر",1,0],["لَكِنْ دَعَا دَاعِي الْحِمَى","فَأجَبْتَ مُتَّخِذاً عَتَادَك",6,"ك",1,0],["لَكِنْ دَهَاكَ البَيْنُ فِي شَرْخِ الصِّبَا","وَقَضَى عَلى الأَمَلِ السَّنِيِّ السَّافِرِ",7,"ر",1,0],["لكنَّ درْكَ الثَّأر يَشْ","فِي علَّةَ القلب الحزين",8,"ن",1,0],["لكنَّ دينارًا هوَى من جيبه","فبكَى، وصاح: هنا هَوَى ديناري!",9,"ر",2,0],["لكنْ دُفِعنا فيها إلى مِحَنٍ","تَصْبَحنا بالهموم أو تَغْبُق",10,"ق",1,0],["لكن دَعي الأقدارَ تجري مثلما","شاءَ الغرامُ فوَصلنا قد حانا",11,"ن",2,0],["لكن دعا الأمر بي هاجرْ فطرت له","وأوجفَ الركب بالقلب الذي وجفا",12,"ف",2,0],["لَكن دعَوهُ بنفَّةٍ لتجنّبٍ","من حائكم يا ذا الفقيه وَشُبهَتِه",13,"ت",2,0],["لكنَّ داعيةَ الضَّرورة طالَما","منَعتْ بها قَدَمَ الفتَى أن تَثْبُتا",14,"ت",2,0],["لكنّ دهراً رائعاتُ صُروفُه","كَرَّتْ بشِدَّتهِ بُعَيدَ رخائه",15,"ا",3,0],["لكن دعائي على فقري","وإنني عاجز عنوان",16,"ن",1,0],["لكن دمع العين يحسب قطره","ماء برودا وهو جمر مضرم",17,"م",1,0],["لكن دفعت إلى مديح خلائف","بمديحهم آتى الكتاب المنزل",18,"ل",1,0],["لكن دَعوتَ إلى التَّلطُّف فلتَكُن","مُتَلطِفا واقبَل مُلاَحظَتِي وَعِ",19,"ع",1,0],["لَكِن دَعاني وَمَيضٌ لاحَ مُعتَرِضاً","مِن نَحوِ أَرضِكَ في دُهمٍ مَناضيدِ",20,"د",1,0],["لكن دَمْعِي حين قابَلَهُ","أَلْقى شُعَاعَ الخَدِّ في دَمْعِي",21,"ي",1,0],["لَكَ نَدعو بالنصرِ كي فيك تقضى","لجميع الراجين منك المرامُ",22,"م",1,0],["لكن دعا بولي الشعر مذهبه","أن يجعل الزخرفَ المذموم مُلتمساً",23,"س",2,0],["لكن دهاني منكم عرفانُكم","عيني من التذهيب والتفضيضِ",24,"ض",1,0],["لكنّ دون الخبزِ في داره","وقائعَ الدّيلم والتُرْكِ",25,"ك",1,1],["لكن دُعيتَ وأيّ خلقٍ لم يكن","ليجيب دعوة قاهرٍ خلاّق",26,"ق",1,0],["لكنَّ دارك لم تبرحْ مواقدُها","مضيئةً تصل الإِصباحَ بالسحر",27,"ر",1,0],["لكن دعتك لبذلِ نفسِك عصبةٌ","حان انتشارُ ضلالِها المدفون",28,"ن",1,0],["لكن دعاهم من جوانبها","داعٍ أجيبوا مصرَ فابتدَروا",29,"ر",3,0],["لكن ديار إن نظرت خيالها","تتوقد الزفرات والأنفاس",30,"س",1,0],["لكنَّ دمعي قد وشى","بسرائر القلب الوديعِ",31,"ع",1,0],["لكن دواتاه هاتان اللتان هما","لديهما مقول اشتهاده سكتا",32,"ت",2,0],["لَكِن دَوَامُ الفِعلِ فِي مُستقبلٍ","مَا فِيهِ محذُورٌ مِنَ النُّكرَانِ",33,"ن",1,0],["لَكِن دَلالَتُهُ عَلَى إحدَاهُمَا","بِتَضَمُّنٍ فَافهَمهُ فَهمَ بَيَانِ",33,"ن",1,0],["لكن دار الخلد والمأوى وعد","ن والسلام اضافة لمعان",33,"ن",1,0],["لكن دراجا أبا السمح الذي","فيه يضعفه أولو الاتقان",33,"ن",1,0],["لكن داعي الهوى يدعو الفؤاد إلى","ذكر التصابي وأيام الصبا الأول",34,"ل",1,0],["لكن دعاء كان في قرن نشا","في أقبح الأزمان والأوقات",35,"ت",1,0],["لكن دعاه فلبى خاضعاً وله","شكرا لآلائه فوق الثرى سجدا",36,"د",2,0],["لَكِنَّ دَهرِيَ حَاكِمٌ بِالفَصلِ مَا","بَينِي وَبَينَكِ بِالرَّقِيبِ الحَاصِلِ",37,"ل",1,0],["لكن دنا هرمسٌ يهوي على يديه","يلقي السؤال بلين القول ممتزجا",38,"ج",2,0],["لَكن دَعاهُ اللَهُ في تاريخِهِ","أَدنى ثَوابك لا تَخف يا يوسفُ",39,"ف",1,0],["لكن دمعي كلما أجريته","وقدت به بين الحشا الزفرات",40,"ت",1,0],["لكن دَهتنا بهذا العام حادثةٌ","عمّت ولا فتنة التيمور إذ ظهرا",41,"ر",2,0],["لَكِن دَمعُها مُنصَبِغٌ بِخَدِّها","إذ قَد صَبَغَت حُمرُ دُموعي خَدِّي",42,"ي",1,0],["( لِكِنْدَة) فيها الهوى أوحد","وتاريخها سيد يشهد",43,"د",1,1],["لكنْ دهيْنا بألقابِ ملفقةٍ","تسوسُ في النّاسٍ وهي الذيل والذنبُ",44,"ب",1,0],["لكنْ دُعِيْتُ لهذا فاعتَمدتُ لهُ","منَ الحقائقِ ما تجلو به الرِيَبُ",45,"ب",1,0],["لكنْ دخانَ بلاديْ أفسدتْ فنني","فغادرتْ للهوى والعشقِ أطيارُ",46,"ر",1,0],["لٰكِنَّ دِيْنِي نَهَانِي عَنْ مُفَاخَرَةٍ","بالْجِنْسِ بِالْجَاهِ أَوْ شَيْءٍ مِنَ الْحَسَبِ",47,"ب",1,0],["لكن داء عياء شل مقوله","وشانه منظراً واشتد مزدريا",48,"ي",2,0],["لكن دعوت فما أضيعت دعوة","رفعت عقيرتها لها آمين",49,"ن",1,0],["لكن دعاك القضا والأمر منحتم","وكنت اسرع من لبيى لما يجب",50,"ب",1,0],["لكنّ دهري في خيالي ما به","إلّأ الربيع إذا تُعدّ فصولُ",51,"ل",1,0],["لَكِنْ دَعَانِي فَرْطُ حُبِّكَ وَالوِلاَ","لأَقولَ فِيكَ مِنَ الْمَديحِ نَشِيدِي(١٧)",52,"د",2,0],["لكنَّ دمعي لا يشافي عجزه","والعجز فيه قاتلٌ عني اشفعي",53,"ع",2,0],["لكن دعوتكم تمزيق ملكهمُ","ترتيلةٌ سُمِعتْ في كنهها الأربُ",54,"ب",1,0],["لكن دنيتنا هانت لخالقنا","للعدل آخرة قد كان ميزانا",55,"ن",2,0],["لكنَّ دَعْوَتَكُم تمزيقُ ملكِهمُ","ترتيلةٌ سُمِعتْ من وقعِها وَجِفُوا",56,"ف",3,0],["لكنَّ دَهْرِي رَمَانِي فِيْ مَوَاجِعِهِ","ما عُدْتُ أَعْرفُ في الأَحْدَاثِ مُنْتَسَبِي",57,"ب",2,0],["لكن دعا داعي الوفاء لمن له","في نفسي الإعزاز وافكرام",58,"م",1,0],["لكن دعاني الصبرُ حينَ تَمرّدَتْ","أغلالُ جُرحيَ واْنتَفى عني الدّليلُ",59,"ل",1,0],["لكن دربك صار ملكا آخرا","الله لي في غربة كانت لنا",60,"ن",2,0],["لكن دمع الشيخ سابق قوله","فأشاح والقلب الكبير تفطرا",61,"ر",2,0],["لكنَّ دِفأً في عيون قرينتي","يقضي عليه ببسمةٍ وتلامسِ",62,"س",1,0],["لكن دموعي خالطت قطراته","فرحاًو حزناً.. أي شيء فينا ؟",63,"ن",2,0],["لكن دعاه الله جل جلاله","فأجاب مشتاقا إلى مشتاق",64,"ق",1,0],["لكن دوس اهل النذاله بالاقدام","واكشف سواد وجيههم وانت رايق",65,"ق",1,0]]}