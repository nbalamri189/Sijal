{"poems":[[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[46,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[71,"قال الحمام جهلتم","https://www.aldiwan.net/poem29018.html","المجتث"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[104,"خطر المسا بوشاحه المتلون","https://www.aldiwan.net/poem33130.html","الكامل"],[42,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[22,"ماذا تقول لأفراخ بذي مرخ","https://www.aldiwan.net/poem21684.html","البسيط"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[52,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[22,"مَاذَا تقول لأِفْراخٍ بذي مَرَخٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19752",""],[102,"المحكوم عليه","https://www.poetsgate.com/ViewPoem.aspx?id=50352",""],[69,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[139,"حتام تأسى والحمام محتم","https://www.aldiwan.net/poem49156.html","الكامل"],[193,"من ثنايا العذراء لاح بريق","https://www.aldiwan.net/poem35153.html","الخفيف"],[275,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[473,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[505,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[545,"يا ابن الفواطم خير الناس كلهم","https://www.aldiwan.net/poem56823.html","البسيط"],[556,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[563,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122567","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88602","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73995","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66316","الكامل"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110331","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28583","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76033","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200246","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138674",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138592",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138553",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118770","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85202","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114063","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107279","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136742",""],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146765","المنسرح"],[4755,"كالحُلمِ لكنْ لَم أَكُنْ غافِيَا","https://www.poetsgate.com/ViewPoem.aspx?id=186357",""],[4929,"جزء من قصيدة ملحمة النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=199886",""],[4929,"شجرة البن(دعوة الى عودة زراعتها)","https://www.poetsgate.com/ViewPoem.aspx?id=210429",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5351,"على درب الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=202234",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[402,"لكنما الكبراء في أقوامهم","https://www.poetsgate.com/ViewPoem.aspx?id=36031",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"بجعةٌ مكثتْ وحيدةً حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=192028",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""]],"verses":[["لَم يُواروا بِكَ مَيتاً إِنَّما","أَفرَغوا فيكَ ذَنوباً مِن نَوالِ",0,"ل",1,0],["لَم يُوَلّوا حَتّى أُبيدوا جَميعاً","في مَقامٍ وَكُلُّهُم مَذمومُ",1,"م",1,0],["لم يُواسُوا ولم يُؤسُّوا خليلاً","سوءةً سوءةً لهم سَوآءَ",2,"ا",2,0],["لم يوفقْكَ للموفّق إلا","صدقُ ذاك التوفيق والإقبالِ",3,"ل",1,0],["لَم يودِ مِنهُ واحِدٌ لَكِنَّما","أَودى بِهِ مِن أَسوَدانَ قَبيلُ",4,"ل",1,0],["لم يُؤثر الغصنُ بُعْدي","فماسَ لي وتثنى",5,"ن",2,0],["لم يوهب الفكرُ قانوناً يُحصِّنه","من الظنونِ، ومن سُخف القوانين",6,"ن",1,0],["لَم يُؤثِرِ الخُطَّةَ المُثلى طَواعِيَةً","لِلَهِ مَن راحَ يرمينا بِعِصيانِ",7,"ن",1,0],["لم يوجسون مِن الحَقيقة خَيفة","لم يَصدفون عَن الطَريق البيِّن",8,"ن",1,0],["لَم يُؤذِها حَدُّ الشِتاءِ وَلَم","يُرفَع لَها لِتَطَلُّعٍ سِترُ",9,"ر",1,0],["لَم يوثِروكَ بِها إِذ قَدَّموكَ لَها","لَكِن لِأَنفُسِهِم كانَت بِكَ الخِيَرُ",10,"ر",1,0],["لَم يُؤذِها الصَيفَ طَوفُ الحالِبِينَ بِها","وَلَم تَغِطَّ عَلَيها الجِلَّةُ الفُنُقُ",11,"ق",1,0],["لَم يُوَهَّن مِنَ المَقالِ لِساني","لِجَوابٍ مُجيبُهُ غَيرُ حَربِ",12,"ب",1,0],["لَمْ يُوفِ سِرْبَالَ المحَامَاةِ امْرُؤءٌ","إِيفَاءَهُ مَا حَقَّ لِلسِّرْبَالِ",13,"ل",1,0],["لَمْ يُؤْثِرُوا خَيْراً عَلَى مَا أَمَّلُوا","مِنْ رَدِّ كَيْدِ المُدْغِل المُحْتَالِ",13,"ل",1,0],["لَمْ يؤْتَها إِلاَّكُمُ أَحَدٌ","مِنْ حَاضِرٍ سَمْحٍ وَمِنْ بَادِ",14,"د",1,0],["لم يُوَشَّعْ بجُمَان قولُه","بل بفكر فيه عمقٌ وشَّعَه",15,"ع",2,0],["لم يُولَدُوا في قصور العزِّ شامخةً","تزين أبهاءَها حورٌ وولدان",16,"ن",1,0],["لم يؤرِّقْه في مَناط الثُّرَيَّا","مطلب راح يرتقي أسبابه",17,"ب",2,0],["لم يؤثروك بها إذْ قدَّموك لها","لَكِنْ لأنفُسِهِم كانت بها الإثَرُ",18,"ر",1,0],["لم يوافق إضربه حتى تلاقي","نصفه ميّتا ، ونصفا عليلا",19,"ل",2,0],["لَمْ يُؤْتَ منها عَدَّهُ تَنْوِيلا","ألفيتَ فيها التابعينَ الفيلا",20,"ل",2,0],["لم يوفك الدهرُ الحقوقَ وكلنا","يدري بذا والأصلِ يتلوهُ ابنُمُ",21,"م",1,0],["لَم يوفَّق موفّقٌ قطّ إلّا","جاءَه مِن طريقه التوفيقُ",22,"ق",1,0],["لم يُولدِ العربيُّ إلا فارساً","أو شاعراً أو ضائفاً لنزيل",23,"ل",1,0],["لم يُوطِها زَلّةً يوماً تَسرُّعُها","ولم يُفِتْ سابقةً والحَقُّ تاليها",24,"ي",3,0],["لم يوقِدوا نارا لها تؤنسها","بهم ولم يُرعُوا إليها جَمَلا",25,"ل",2,0],["لم يؤتَ من حظّ الشجاعة ساهرٌ","فيها الذي تؤتَى وطرفُك هاجعُ",26,"ع",1,0],["لَم يولِنا قَطُّ الجَميلُ غِناءَهُ","إِلّا وَجازَيناهُ بِالإِصغاءِ",27,"ا",2,0],["لم يُؤلَفِ الجودُ إِلاَّ من مكَرِمِهِمْ","ولا تُكِنُّ المَعالي دونَ ما كانُوا",28,"ن",3,0],["لَم يوصِني اللَهُ إِذ أَوصى بِبَعضكُمُ","وَلا النَبيُّ الَّذي يَهدي إِلى النورِ",29,"ر",1,0],["لم يؤاتين طيّعاتٍ ولكنْ","زُلْن لمّا أعيَيْتها أن تزولا",30,"ل",2,0],["لم يوفق لها الإله سوى من","خرَّ نجماً على الجهول شهابا",31,"ب",2,0],["لم يوفَّق لها كُليبٌ ولم يُه","دَ إليها أحَيحةًُ بن الجلاح",32,"ح",1,0],["لم يوردوها وغي إِلّا وقد صدروا","من الدماء بها محمرة اللجم",33,"م",1,0],["لم يوفوا بعشر عشر صفات","قد حباها الإله طه الرسولا",34,"ل",2,0],["لم يؤت منهم رسول معجز أبدا","إلا أتاه بأزكى منه جبريل",35,"ل",1,0],["لم يؤت داع قبل طه معجز","إلا ونال أبر أو كالأول",36,"ل",1,0],["لم يول معوج الأمور علاجها","الا وعاد عليها أفراقه",37,"ق",2,0],["لم يولد الآن طفل فيه منذ دعا","إلاّ ومات ولم يبلغ إلى الحلمِ",38,"م",1,0],["لم يُؤْتَ مِنْ عِيٍّ ولا مِنْ خَطَلِ","فانضِجْ صُدُورَ حاسدِيكَ الضُلَّل",39,"ل",1,0],["لم يوار النبي حتى أتيحت","حرمة الدين واستبيح حماها",40,"ا",3,0],["لم يؤد الإله أحكامه في","كل كون إلاَّ به أدّاها",40,"ا",3,0],["لم يوح إلا نعته في كتبه","ولأجل ذلك لم تزل تتنزل",41,"ل",1,0],["لم يودع الله هذا الحسن فيك سُدىً","لكن لتسعد ألبابٌ وأَعيانُ",42,"ن",1,0],["لم يوص ربك إلا بالفقير فقد","سمى الفقير أخاه حينَ سماهُ",43,"ا",2,0],["لم يوجب التخصيص من فضل علي","ه ولا مساواة ولا نقصان",44,"ن",1,0],["لم يولِموا حَيوانَ البَرِّ واقتَصَروا","عَلى كَوامِنَ في الأَفواهِ أغفالِ",45,"ل",1,0],["لَم يُؤخَّر عَن هالِكٍ أَجل","إِنَّ ذا عمرهُ الَّذي رُزِقَه",46,"ق",2,0],["لم يودع الله عندي ماله زمناً","فإنما ماله في البنك أودعه",47,"ه",1,0],["لم يولوا وجهاً عن المقصد الأ","سنى فطوبى لهم وحسن مآب",48,"ب",1,0],["لم يوهن العزم جوع لا ولا عطش","عند اللقا باشتباك السمر بالخدم",49,"م",1,0],["لم يوصوا خوف انخذالٍ ولكن","قد قضى الود أن يوصوا الودودا",50,"د",2,0],["لم يوفِه حق الاخاء فحقُّه","أن لا يعوج الدهر نحو دواته",51,"ت",2,0],["لم يوله بعداً تعاظم أمره","فغدا به متلون الأخلاق",52,"ق",1,0],["لَم يُوَاجِههُ لِكَي لاَ يَفزَعَ ال","مُصطَفَى الهَادِي بِمَا لاَ يُستَطَاب",53,"ب",1,0],["لَم يُوَاجِههُ بِالسُّؤَالِ إِلَى أن","رَفَعَ الوَهمَ عَنهُ ذاكَ الدُّعاءُ",54,"ا",2,0],["لَم يُوَاجِههُ بِالتَّعَبُّسِ كَي لاَ","يَفزَعَ المُصطَفَى بِشَيءٍ يُسَاءُ",54,"ا",2,0],["لَم يُؤَمِّل سِواهُما مِن وَلِيٍّ","وَبهِ العَجزُ أَنشَبَ الأَظفارا",55,"ر",2,0],["لم يُوفِ دَيني وهوَ مُثرٍ قادِرٌ","والظُّلمُ كلُّ الظُّلمِ مَطلُ المُوسِرِ",56,"ر",1,0],["لم يوقدوا نارَ القرى","إلا بأحناء الضُلوع",57,"ع",1,0],["لم يود طرفٌ وإن فقدت به","علقاً نفيساً ما عاش واهبه",58,"ب",2,0],["لَم يُوْلِمُوا كالنَّاسِ لكنهم","كانُوا عَشَاءَ الفِتنَةِ الشَّافِيَا",59,"ف",3,0],["لم يوهننَّكَ عن تبليغِ دعوتِهِ","للناسِ إيذاؤهم عزمًا ولا هِمَمَا",60,"م",2,0],["لم يُولِ مصلحةَ الزراعِ مخلبُها","هما ، وزراعُنا في غيِّهم سُكْرُ",61,"ر",1,0],["لم يوقظ الظلم عزا في نفوسهمُ","إلا أمات بهم جبنا له تَبعُ",62,"ع",1,0],["لم يؤمنوا إلا بأمريكا فما","حكموا هنا إلا لها وأغاروا",63,"ر",3,0],["لَمْ يُوفِهِ حَقًّا خَطِيبٌ مِصْقَعٌ","أوْعَالمٌ مَا قَالَ فيهِ وَألّفَا",64,"ف",2,0],["لم يؤثروا خيرا على ما أملوا","من رد كيد المدغل المختال",65,"ل",1,0],["لم يؤذها الحيوان مِن وحشِ كما ال","إنسانُ يؤذيها بكل جهاتها",66,"ت",3,0],["لم يؤذها الحيوانُ مِن وحشِ كما ال","إنسانُ ينشط في سبيل وفاتها",67,"ت",3,0],["لَمْ يُولِكُمْ مُذْ تَوَلَّى عَنكُمُ مَلَلاً","لوِجْهَةٍ هُو عن قَصْدٍ مُولِّيهَا",68,"ي",3,0]]}