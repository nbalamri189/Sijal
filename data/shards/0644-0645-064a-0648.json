{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[69,"قال الحمام جهلتم","https://www.aldiwan.net/poem29018.html","المجتث"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[102,"خطر المسا بوشاحه المتلون","https://www.aldiwan.net/poem33130.html","الكامل"],[40,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[22,"ماذا تقول لأفراخ بذي مرخ","https://www.aldiwan.net/poem21684.html","البسيط"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[50,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[22,"مَاذَا تقول لأِفْراخٍ بذي مَرَخٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19752",""],[100,"المحكوم عليه","https://www.poetsgate.com/ViewPoem.aspx?id=50352",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[135,"حتام تأسى والحمام محتم","https://www.aldiwan.net/poem49156.html","الكامل"],[189,"من ثنايا العذراء لاح بريق","https://www.aldiwan.net/poem35153.html","الخفيف"],[270,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[364,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[458,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[468,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[500,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[540,"يا ابن الفواطم خير الناس كلهم","https://www.aldiwan.net/poem56823.html","البسيط"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[558,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"]],"verses":[["لَم يُواروا بِكَ مَيتاً إِنَّما","أَفرَغوا فيكَ ذَنوباً مِن نَوالِ",0,"ل",1,0],["لَم يُوَلّوا حَتّى أُبيدوا جَميعاً","في مَقامٍ وَكُلُّهُم مَذمومُ",1,"م",1,0],["لم يُواسُوا ولم يُؤسُّوا خليلاً","سوءةً سوءةً لهم سَوآءَ",2,"ا",2,0],["لم يوفقْكَ للموفّق إلا","صدقُ ذاك التوفيق والإقبالِ",3,"ل",1,0],["لَم يودِ مِنهُ واحِدٌ لَكِنَّما","أَودى بِهِ مِن أَسوَدانَ قَبيلُ",4,"ل",1,0],["لم يُؤثر الغصنُ بُعْدي","فماسَ لي وتثنى",5,"ن",2,0],["لم يوهب الفكرُ قانوناً يُحصِّنه","من الظنونِ، ومن سُخف القوانين",6,"ن",1,0],["لَم يُؤثِرِ الخُطَّةَ المُثلى طَواعِيَةً","لِلَهِ مَن راحَ يرمينا بِعِصيانِ",7,"ن",1,0],["لم يوجسون مِن الحَقيقة خَيفة","لم يَصدفون عَن الطَريق البيِّن",8,"ن",1,0],["لَم يُؤذِها حَدُّ الشِتاءِ وَلَم","يُرفَع لَها لِتَطَلُّعٍ سِترُ",9,"ر",1,0],["لَم يوثِروكَ بِها إِذ قَدَّموكَ لَها","لَكِن لِأَنفُسِهِم كانَت بِكَ الخِيَرُ",10,"ر",1,0],["لَم يُؤذِها الصَيفَ طَوفُ الحالِبِينَ بِها","وَلَم تَغِطَّ عَلَيها الجِلَّةُ الفُنُقُ",11,"ق",1,0],["لَم يُوَهَّن مِنَ المَقالِ لِساني","لِجَوابٍ مُجيبُهُ غَيرُ حَربِ",12,"ب",1,0],["لَمْ يُوفِ سِرْبَالَ المحَامَاةِ امْرُؤءٌ","إِيفَاءَهُ مَا حَقَّ لِلسِّرْبَالِ",13,"ل",1,0],["لَمْ يُؤْثِرُوا خَيْراً عَلَى مَا أَمَّلُوا","مِنْ رَدِّ كَيْدِ المُدْغِل المُحْتَالِ",13,"ل",1,0],["لَمْ يؤْتَها إِلاَّكُمُ أَحَدٌ","مِنْ حَاضِرٍ سَمْحٍ وَمِنْ بَادِ",14,"د",1,0],["لم يُوَشَّعْ بجُمَان قولُه","بل بفكر فيه عمقٌ وشَّعَه",15,"ع",2,0],["لم يُولَدُوا في قصور العزِّ شامخةً","تزين أبهاءَها حورٌ وولدان",16,"ن",1,0],["لم يؤرِّقْه في مَناط الثُّرَيَّا","مطلب راح يرتقي أسبابه",17,"ب",2,0],["لم يؤثروك بها إذْ قدَّموك لها","لَكِنْ لأنفُسِهِم كانت بها الإثَرُ",18,"ر",1,0],["لم يوافق إضربه حتى تلاقي","نصفه ميّتا ، ونصفا عليلا",19,"ل",2,0],["لَمْ يُؤْتَ منها عَدَّهُ تَنْوِيلا","ألفيتَ فيها التابعينَ الفيلا",20,"ل",2,0],["لم يوفك الدهرُ الحقوقَ وكلنا","يدري بذا والأصلِ يتلوهُ ابنُمُ",21,"م",1,0],["لَم يوفَّق موفّقٌ قطّ إلّا","جاءَه مِن طريقه التوفيقُ",22,"ق",1,0],["لم يُولدِ العربيُّ إلا فارساً","أو شاعراً أو ضائفاً لنزيل",23,"ل",1,0],["لم يُوطِها زَلّةً يوماً تَسرُّعُها","ولم يُفِتْ سابقةً والحَقُّ تاليها",24,"ي",3,0],["لم يوقِدوا نارا لها تؤنسها","بهم ولم يُرعُوا إليها جَمَلا",25,"ل",2,0],["لم يؤتَ من حظّ الشجاعة ساهرٌ","فيها الذي تؤتَى وطرفُك هاجعُ",26,"ع",1,0],["لَم يولِنا قَطُّ الجَميلُ غِناءَهُ","إِلّا وَجازَيناهُ بِالإِصغاءِ",27,"ا",2,0],["لم يُؤلَفِ الجودُ إِلاَّ من مكَرِمِهِمْ","ولا تُكِنُّ المَعالي دونَ ما كانُوا",28,"ن",3,0],["لَم يوصِني اللَهُ إِذ أَوصى بِبَعضكُمُ","وَلا النَبيُّ الَّذي يَهدي إِلى النورِ",29,"ر",1,0],["لم يؤاتين طيّعاتٍ ولكنْ","زُلْن لمّا أعيَيْتها أن تزولا",30,"ل",2,0],["لم يوفق لها الإله سوى من","خرَّ نجماً على الجهول شهابا",31,"ب",2,0]]}