{"poems":[[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[87,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[45,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"قل للأمين أقم للحر مأتمه","https://www.aldiwan.net/poem42125.html","البسيط"],[107,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[203,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[261,"سرى متعرضا طيف الخيال","https://www.aldiwan.net/poem48456.html","الوافر"],[374,"إن اللئيم على حقارة قدره","https://www.aldiwan.net/poem4309.html","الكامل"],[396,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[563,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[567,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48940","المتقارب"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112584","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89148","الكامل"],[5419,"للكبار فقط","https://www.poetsgate.com/ViewPoem.aspx?id=32270",""],[5853,"تباريح","https://www.poetsgate.com/ViewPoem.aspx?id=178345",""],[5943,"أبا رامي حماك الله فاسلم","https://www.poetsgate.com/ViewPoem.aspx?id=37261",""],[5969,"روايةٌ صوفية","https://www.poetsgate.com/ViewPoem.aspx?id=207465",""],[6093,"مُشَرَّدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198050",""]],"verses":[["يؤذي بتكرار النُباحِ وما","من مَنْهسٍ فيه لذي نَهس",0,"س",1,0],["يؤذَى كما كان يؤذى الصحب محتملا","في طاعة الله والمختار يبغيها",1,"ي",3,0],["يُؤذي القَليلُ مِنَ اللِئامِ بِطَبعِهِ","مَن لا يَقِلُّ كَما يَقِلُّ وَيَلؤُمُ",2,"م",1,0],["يُؤذيكَ أن يُرْمَى الضّعيفُ بِظالمٍ","شَرِسِ الخلائقِ دَأبُهُ الطُّغيانُ",3,"ن",1,0],["يُؤذَى بأسوأ ما يُؤذَى الهُداةُ بهِ","من فِتيةٍ كلّهم نَشوانُ مفتونُ",4,"ن",1,0],["يُؤذِي رسولَ اللهِ يزعمُ أنّه","في قومِهِ منه أعزُّ وأشرف",5,"ف",1,0],["يؤذيهِ أنَّ الشمس تطلُعُ فوقَه","او لا يظلِّلَ وَجْنَتَيهِ غَمام",6,"م",1,0],["يؤذنها في مطلع الفجر مخبراً","بموت ابيها وهي تسمعُ ما اهدى",7,"د",2,0],["يؤذن في استها أيري أذان الض","حى ويقيم في وقت الزوال",8,"ل",1,0],["يؤذيه وهو بطبعه متنزه","عنه فيقصر رفعة وجلالا",9,"ل",2,0],["يؤذون للمسلم بحيف واحجاف","الله يكفي شرهم وهو كاف",10,"ف",1,0],["يؤذونه سبحانه بالذي","قد نسبوه وهو ما لا يليق",11,"ق",1,0],["يُؤْذي الحزينُ جُفونَهُ بدُموعِهِ","عَبَثاً كما عضَّ البَنانَ النَّادمُ",12,"م",1,0],["يؤذِّنُ للعلم ما بيننا","ويخطُبُ للحق فينا إماما",13,"م",2,0],["يؤذّن بالإفطار للناس مغربا","ونحن حيارى لم نفز بذماء",14,"ا",2,0],["يؤذَى فيُشفَى ثم إن","أكرمت أمرضَهُ البطر",15,"ر",1,0],["يؤذن بالموت فيه غرابٌ","قبيحٌ تملكهم وأساء الخططْ",16,"ط",1,0],["يؤذن في ربى روحي هواها","فتصدح بالإقامة للأمانيْ",17,"ن",2,0],["يؤذِّنُ للفلاح ِ طهورُ فكرٍ","وحبُّ الخير يهديهم مدادا",18,"د",2,0],["يُؤذيهِ مَوتُ شُعورهِ في بُرهةٍ","ويَطيبُ إن بُعِثَ الشُعورُ وقاما",19,"م",2,0],["يُؤْذِيْهِ تَصويرُ إعْلامٍ لفَاقَتِهِ","والمَادِحُونَ يَعدُّونَ الأذَى شَفَقَةْ",20,"ق",2,0]]}