{"poems":[[91,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[47,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[50,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[230,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[543,"بما أجيب عن ثناء عاطر","https://www.aldiwan.net/poem48304.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126878","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87866","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104987","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93670","السريع"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82823","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88947","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89133","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88949","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89110","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36752","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114312","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95320","الكامل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88567","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136841",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5461,"يا سيدي عاش راسك","https://www.poetsgate.com/ViewPoem.aspx?id=5234",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[5809,"مراض","https://www.poetsgate.com/ViewPoem.aspx?id=205099",""],[5848,"ظلم الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=53097",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6099,"دندنات","https://www.poetsgate.com/ViewPoem.aspx?id=35797",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[2220,"إنَّ المقرَ من يستعبدْ الدولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11722&r=&rc=592",""],[4890,"إلى سيزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72664&r=&rc=154",""]],"verses":[["عن رتبة قد نالها","ساءلني مسائل",0,"ل",1,0],["عَن رَهيفِ القَوامِ يَجمَعُ فيهِ","صِفَةَ الغُصنِ لينُهُ وَاِعتِدالُه",1,"ل",2,0],["عن ردفِ كلِّ تهتزُّ قامتهُ","كالغصُنِ النضرِ زانهُ الميَدُ",2,"د",1,0],["عن رباها ، عن غيدها سارحات","يتهادين في الحمى آراما",3,"م",2,0],["عن رِياضٍ فَتَحت أحضانَها","لعِناقِ الصَبِّ في ظِلِّ الشجَر",4,"ر",1,0],["عَن رَأفَةٍ مِنكَ بِالإِسلامِ قَد شُهِرَت","لَم يُعطِها والِدٌ مِن نَفسِهِ وَلَدا",5,"د",2,0],["عَن رَحمَةٍ طالَما أَدنَت عَواطِفُها","مِن سَيبِكَ الغَمرِ مَن لَم تُدنِهِ رَحِمُ",6,"م",1,0],["عَن ربّه قد ناب فيما حَكما","محمَّدُ النعمةُ فضلُ اللَّهِ",7,"ه",1,0],["عَن رِفدِه حَدِّث فكم في رِفدِه","إِنعام بحرٍ وافِرٍ وَمديد",8,"د",1,0],["عن رسول الله عن أبنائه","ما رَوَيْنا من أحاديث المكارم",9,"م",1,0],["عن روضة غنَّاء باكرها الحيا","فوهت بقطر الصيّب المنهال",10,"ل",1,0],["عن رِيّ غُلَّتِنا منعتُم زمزَماً","ورمَيتُمُ جَمَراتِ وجدِكمُ بِنا",11,"ن",2,0],["عن ردِّ شُكري غيرَ أنيِّ رامِز","إلى وَفائي لأبي الوَفََاء",12,"ا",2,0],["عَن رُشدِها الناس ظلّت برهة فغَدَت","بالمرشد اليوم تُسقى خالصَ اللبنِ",13,"ن",1,0],["عن رَشدةٍ مَا اِعتَاضَ أُسرَةَ غِيَّةٍ","يصطَانُ عِرضاً طَاهِراً لِزَكاكُمُ",14,"م",1,0],["عن ربه لا عن أسبابٍ له نصبت","كناظري في مسير الشمس أو زحل",15,"ل",1,0],["عن ريقة روت الشمول","معنى تطيش به العقولُ",16,"ل",1,1],["عَن راحه استغنيت في ريقه","شتان في اللذات راح وَريق",17,"ق",1,0],["عَن رَغبَةٍ مَدَّتِ العَليا لَهم يَدها","فَبايَعوها وَقَد كانوا لها عَونا",18,"ن",2,0],["عن رتبة أهدى لنا نبا وفا","رد الدجى من نور صبحا وعام",19,"م",1,0],["عن راتب الفضل رب المجد من سمعت","بصيته الصم ليس الخُبْرُ كالخَبَر",20,"ر",1,0],["عن رتبة أهدى لنا نبأً","رد الدجى من نور صبحا",21,"ح",2,0],["عن رتبة كادت تجن جنونها","شوقاً إلى هذا الجمال الأنور",22,"ر",1,0],["عَن رَوضَةٍ مَطلولَةٍ","ذاتُ جَنابٍ مُخصِبِ",23,"ب",1,0],["عن ربربٍ بين وهبين ومعقلةٍ","ألهاه بقل وسعدان وتَنُّومُ",24,"م",1,0],["عَن رَسُولِ الإِلاَهِ مَن بِيَدَيهِ ال","حَلُّ وَالرَّبطُ يَومَ وَقفٍ مَهُولِ",25,"ل",1,0],["عَن رِيقها يَتحدث المسواك","أرَجاً فَهل شَجرُ الكِباء أَراكُ",26,"ك",1,1],["عن رجلٍ لا بغيضٍ في عشيرته","ولا ذليلٍ قصير الباع معتَصم",27,"م",1,0],["عن رعاةٍ جاءوا حفاةً من القف","ر فحازوا ملكاً على الدنياء",28,"ا",2,0],["عن رأى راس أبيه شفه","نار وجد دونها حر لظى",29,"ا",1,0],["عن رسول الله المخصوص بالمنهل الصاف","لأي شي نواه قاريها من أصناف لصناف",30,"ف",1,0],["عَنْ رَبِّهِ عَنْ أمرِهِ عَنْ نَفسِهِ","فِي عُزْلَةٍ فِي غَفلَةٍ مُتَغَافِلُ",31,"ل",1,0],["عَنْ رَسولِ اللهِ مُفْتَدِيًا","بَاذِلًا لِلرُّوحِ وَالْجَسَدِ",32,"د",1,0],["عن ربعه الّلي يحبّونه","فرد عليه بهذه القصيدة :",33,"ه",1,0],["عن رجل يصعب على الشعر اختصاره","عن زعيم ٍ قل من تنجب نظيره",34,"ر",2,0],["عن رشا في فؤادي محلّه والقرار","وإلى اليوم قد غاب ياناس",35,"س",1,0],["عن ربيعٍ طال في أعماره","فاقَ في الحسن ربيعَي نينوى",36,"و",2,0],["عن رهبتي جت رغبتي عكس الادراك","ولوحدتي ياسي وظلم الشبابيك",37,"ك",1,0],["عن رجفة الأرض تحت القهر رازحة","عن صفرة الموت إذ تغشى محياكِ",38,"ك",1,0],["عَنْ رَحمَةٍ يسعَى بهَا صَوبَ الهُدَى","تُحْيِي أَمَانِيِهِ وَتهْدِي عَاصِيَا",39,"ي",2,0],["عن رأي صديقٍ في مُقلٍ","لا تعرف معنى الإبصار",40,"ر",1,0],["عن ريحٍ كانتْ حاضرةً","في أي عِقالٍ قدْ عُقِلتْ",41,"ت",1,0],["عَن رَغم أَنفي فاض عالخَد مَدمَعي","مِن ناظر مَقروح فيهِ آلام",42,"م",1,0],["عنْ ربهِ لا عنْ أسبابِ لهُ نصيتْ","كناظري في مسيرِ الشمسِ أوْ زحلِ",43,"ل",1,0],["عن ريشةٍ أخيره","تكتبُ للعشب وللخريفْ",44,"ف",1,0]]}