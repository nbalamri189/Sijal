{"poems":[[63,"يا ابن الذي سيفه في السلم مسلول","https://www.aldiwan.net/poem51339.html","البسيط"],[17,"أعاذلتي ألا لا تعذليني","https://www.aldiwan.net/poem1196.html",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[141,"وزق وافر الجنبين","https://www.aldiwan.net/poem67965.html","الهزج"],[178,"وزق صريع قطيع اليدين","https://www.aldiwan.net/poem46029.html","المتقارب"],[3010,"","https://poetry.dctabudhabi.ae/diwan/poem/98076","المتقارب"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76441","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76447","المتقارب"],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[6237,"حسناء الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77879&r=&rc=21",""]],"verses":[["وزق فرخ زجاج فوه في فمه","وجسمه بصليف القرن موصول",0,"ل",1,0],["وَزِقٍّ قَد جَرَرتُ إِلى النَدامى","وَزِقٍّ قَد شَرِبتُ وَقَد سَقَيتُ",1,"ت",1,0],["وزِقاقَ خَمْرٍ تستَجِدُّ مَساحبا","وهَشيمَ رَيْحانِ يُذَرَّى جانبا",2,"ب",2,0],["وَزِقٍّ وافِرِ الجَنبَي","نِ مِثلِ الجَمَلِ البازِل",3,"ل",1,1],["وَزِقٍ صَرِيعٍ قَطِيعِ الْيَدَيْنِ","قَتَلْناهُ وَلَمْ نَبْكِهِ",4,"ك",2,1],["وَزقّ سباهُ لأصحابهِ","فَظلّ يُحيّا وظلّوا شروبا",5,"ب",2,0],["وَزَقزقة الاطيار وَالديك صادح","يرددها فالكل في الزهر رافل",6,"ل",1,0],["وَزَقزَقَة الطير من طرب","كَوَلوَلة الأم للأَصغر",7,"ر",1,0],["وزقزقة الطيور شدت بشعرٍ","ألذّ من التهجد في سكونِ !!",8,"ن",1,0],["وزقزق العصفور في أيكةٍ","وشّحها الطلُّ بأزهى وشاحْ",9,"ح",1,0]]}