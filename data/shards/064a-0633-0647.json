{"poems":[[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[53,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[30,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[42,"أقول لصاحبي ومثل ما بي شكاه","https://www.aldiwan.net/poem42306.html","الوافر"],[52,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[133,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[136,"إلى كم استهيم إلى سعاد","https://www.aldiwan.net/poem54850.html","الطويل"],[199,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[240,"أعيذك من لوعتي واشتياقي","https://www.aldiwan.net/poem31811.html","المتقارب"],[285,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[409,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[447,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[466,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[567,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83316","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39062","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48846","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[226,"","https://poetry.dctabudhabi.ae/diwan/poem/121483","الرمل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52108","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52109","الخفيف"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199631","المسحوب"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93703","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93718","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132306","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137399",""],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131472",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94006","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134201","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3200,"","https://poetry.dctabudhabi.ae/diwan/poem/146081","السريع"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76544","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62909","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91475","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127057","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54376","الوافر"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66168","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66169","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141680","الخفيف"],[4702,"الشعب في غلاف الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=155323",""],[4849,"جربت احب","https://www.poetsgate.com/ViewPoem.aspx?id=53505",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5461,"ياسامرين الليل","https://www.poetsgate.com/ViewPoem.aspx?id=5066",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[6032,"ما على الدهر عتب","https://www.poetsgate.com/ViewPoem.aspx?id=181506",""],[6032,"كم ليل العاشق ممتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=181516",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""]],"verses":[["يُسَهِّلُ حينَ يَغدوا مِن مَبيتٍ","أَوائِلُهُ لِئاخِرِهِ الإِكاما",0,"م",2,0],["يسهل القول إنها أحسن الأشْ","ياءِ طُرّاً ويعْسرُ التحديدُ",1,"د",1,0],["يَسهَرنَ مَن طَرَقَ الهُمومُ فُؤادَهُ","وَيَرومُ وارِدُهُنَّ كُلَّ مَرامِ",2,"م",1,0],["يُسَهَّدُ ما يَنامُ اللَيل إِلّا","غِشاشاً مِثلَ تَسهِيدِ السَلِيمِ",3,"م",1,0],["يَسهَرُ اللَيلَ كُلَّهُ","نَظَراً في العَواقِبِ",4,"ب",1,0],["يُسَهَّدُ مِن لَيلِ التَمامِ سَليمُها","لِحَليِ النِساءِ في يَدَيهِ قَعاقِعُ",5,"ع",1,0],["يَسهَرونَ الدُجى لِتَخفيفِ وَيلٍ","أَو بَلاءٍ مُصَوَّبٍ أَو نَكالِ",6,"ل",1,0],["يَسْهُو بِغَاشِيَتَيْنِ","تَنْسَدِلاَنِ سَدْلَ الْبُرْقُعِ",7,"ع",1,0],["يَسهَدُ الليلَ لِخَوفٍ","مِن مَتاعٍ أَن يَبُور",8,"ر",1,0],["يُسَهِّدني تَذَكُّرهَا فَجَفني","قَرِيحُ الجَانِبَينِ مِنَ السُّهَادِ",9,"د",1,0],["يُسَهِّدُها الهَمَّ الضَعيفُ كَأَنَّما","تُماطِلُ دون الصُبحِ جَولاً مُجَرَّما",10,"م",2,0],["يُسَهِّلُ لي فيكَ صَعبَ المَلامِ","خَلِيُّ الحَشا لَم يَبِت في وِثاقِ",11,"ق",1,0],["يُسَهِّدُهُ تَشْيِيدُهُ الْمَجْدَ وَالْعُلى","وَتَفْرِيجُ غَمّاءِ الْحَوادِثِ وَالْغَمِّ",12,"م",1,0],["يَسهرُ مُستَرقداً رَعيَّتَه","بالعَدْلِ حتّى يَقِرَّ مّهْدَؤها",13,"ا",3,0],["يسهران المنام إن مسك السو","ء وإن كان النوم في أجفانك",14,"ك",1,0],["يسهو ويلهو بآمال مموهة","ولم يروعه إلا حادث المرض",15,"ض",1,0],["يسهرُ الليل بعيداً صبحهُ","طاهرُ البردةِ من عيب الفِعالِ",16,"ل",1,0],["يَسهَرُ مِن هَواكُم","وَأَنتُمُ رُقودُ",17,"د",1,0],["يسهِّلُ منْ طُرْقِ الكلام صِعابَها","ويفتحُ من سرِّ المعاني حصونَهُ",18,"ن",2,0],["يُسَهَّدُ جَفناً لا يَطيبُ لَهُ الكَرى","وَفي أَرضِ عُثمانَ ظَليمٌ وَظالِمُ",19,"م",1,0],["يَسْهَرُ اللَّيلَ مِنْ مَداهُ بِوَجْدٍ","مُسْتَطيلٍ ومِنْ دُجاهُ بِرَمْسِ",20,"س",1,0],["يسهِّدني حذري حولكم","فياليَ من حاذر ساهد",21,"د",1,0],["يَسهَرُ اللّيلَ وَيَرعى الأَنجُما","وَيُجاري لِلجَواري الكنَّسِ",22,"س",1,0],["يُسهد في ليل بَهيم كفَرعِها","وميضٌ كثغر بالوصال يبشر",23,"ر",1,0],["يسهل الصعب على النفس إذا","ذُكِّرت أن إلى الترب المآل",24,"ل",1,0],["يَسهُكنَ أَمثالَ الرَوائِمِ وُلَّها","فَقَدَت فَرَجَّعَتِ الحَنينَ فِصالَها",25,"ل",3,0],["يسهل الخطب غير هذا فأني","نلت في كسب من يليق الشدائد الفواقر",26,"ر",1,0],["يسهل الأمر غير هذا فأني","قلت في كسب من يلين الفواقر",27,"ر",1,0],["يسهده شعب يئنّ توجّعا","بغير ظهير تحت رحمة عات",28,"ت",1,0],["يسهر الليل مع جند اتخاف اعتب","كالأسود الضواري ماسكين النظام",29,"م",1,0],["يسهو بها الراكب المزجي مطيته","عن حاجة راح يغدو في تقاضيها",30,"ي",3,0],["يسهِّد طَرفَه لَيلاً إِذا ما","سِواه غَفى عَن الأُخرى وَناما",31,"م",2,0],["يَسهو عن الدُنيا بذكر صِلاته","وَالناس عَن صَلواتهم ساهونا",32,"ن",2,0],["يُسَهِّلُ الصَّعبَ عندَهُ الغَرامُ ولا","يَثنيهِ دُونَ الذي يُريدُهُ الرَّهَبُ",33,"ب",1,0],["يسهد الجفن في الاصلاح مجتهدا","وكل جفن بمهد الامن قد هجعا",34,"ع",2,0],["يسهل علينا ملاقاة الحروب","ولا أرى الدار منك قافره",35,"ر",2,0],["يَسهِّل ما قَد كانَ حَزنا وَطالَما","أَجَدَّت لَنا آدابُهُ كُلَّ مُخلَقِ",36,"ق",1,0],["يسهر الليل من يشاهد منها","في دياجي الشعور شمساً عجيبه",37,"ب",2,0],["يسهل تفيم الصعاب بفكره","فتذكو به الإفهام وهي كواسد",38,"د",1,0],["يسهد طرفه في اللَه يدعو","اليه دعاء أواه منيب",39,"ب",1,0],["يسهرني تخمشه دائبا","وعبثه يعمل في حتفي",40,"ي",1,0],["يُسَهِّدُ أَجفانَ الوَرى وَهُوَ نائِمٌ","وَيَهدِي لِنَهج العِشقِ وَهوَ مُحَيَّرُ",41,"ر",1,0],["يَسْهَرُونَ الليلَ الطويلَ حفاظاً","ويلذُّونَ أن يكونَ هُجُوعَا",42,"ع",2,0],["يُسهِّدُني ذِكرُ الليالي التي مضت","سَهدتُ ولكن حَبَّذا ذلكَ السُهدُ",43,"د",1,0],["يَسهرُ اللَيلَ وَالخليُّ نؤومٌ","وَالنَوى بالثبوت يمحو رقاده",44,"د",2,0],["يسهل فيه كلما تعسرا","ويرفع القدر الذي قد حقرا",45,"ر",2,0],["يُسَهَّلُ للرُّكوب لنا طريقاً","بصنعته ولا يُعطي القيادا",46,"د",2,0],["يسهدها حتى تمل حياته","فطورا تفديه وطورا تأثّم",47,"م",1,0],["يَسْهُو سِوايَ وما اُغَمِّضُ ساعَةً","طَرْفي وهَلْ يَسْلُو المُحِبُّ فَيَهْجَعا",48,"ع",2,0],["يَسْهُو الخَلِيُّ وَلمْ يَذُقْ طَرْفُ الشَّجِي","طَعْمُ الرُّقادِ سَلِي الكَرى والمَضْجعا",49,"ع",2,0],["يسهر الليل مطرئاً فإذا ما","أصبح الصبح خار من فرط خمص",50,"ص",1,0],["يسهرون الليالي كالرحى المستدير","واصبح الشعب منهم بين ضرسٍ وناب",51,"ب",1,0],["يسهر عشان الحب وأصير سهران","لامن في يوم احتجت له قال كاني",52,"ن",2,0],["يسهل الصعب على كل امرئٍ","صادق العزم إذا ما عزما",53,"م",2,0],["يسهر مع الذكرى على صفر الأوراق","في صفحة(ن) تشرب دموع اليراعي",54,"ع",2,0],["يسهر يناجي ، ينادي ، ينده ، يخونه سكوت","يرتحل يبحث ، لأنه ، مؤمن بغارب جبينه",55,"ن",2,0],["يسهد الجفنين يغتال الصفا","وغنوص تصطلي منه الحَجَب",56,"ب",1,0],["يسهرنا الحب ينادمنا","ُكم ليل العاشق ممتد",57,"د",1,0],["يسهر وهو سارح ٍفكره مع اللي عشقه","نومه على الكوع من ضيقة ويتململي",58,"ل",2,0]]}