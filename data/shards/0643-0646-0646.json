{"poems":[[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[71,"يا سيدا ذكاؤه","https://www.aldiwan.net/poem28122.html","مجزوء الرجز"],[119,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[202,"ذرني ونجدا لا حملت نجادي","https://www.aldiwan.net/poem51954.html","الكامل"],[396,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[534,"كن ناسكا تبتلا","https://www.aldiwan.net/poem37221.html","مجزوء الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103107","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109788","الخفيف"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140304",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205685","الرمل"],[4814,"ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=193408",""],[4866,"زعول","https://www.poetsgate.com/ViewPoem.aspx?id=149701",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5136,"رب يسر لي أمري","https://www.poetsgate.com/ViewPoem.aspx?id=121586",""],[5431,"بك وحيٌ وكلّهم أصنام ....","https://www.poetsgate.com/ViewPoem.aspx?id=202157",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[119,"يا نبيا علا على الأنبياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55610&r=&rc=7",""]],"verses":[["كُن نَشيطاً عامِلاً جَمَّ الأَمَل","إِنَّما الصِحَّةُ وَالرِزقُ العَمَل",0,"ل",1,0],["كنْ ناهباً أو واهباً","مثِّلْ لنا ولا تقفْ",1,"ف",1,0],["كن نصيري وموئلي ومعيني","وعياذي في شدتي ورخائي",2,"ا",2,0],["كُنْ ناصري يا ناصرَ العَليا على","زَمَنٍ على أَهْلِ البلاغةِ عاد",3,"د",1,0],["كن نافعا للناس","بالفعل والإيناس",4,"س",1,0],["كُنْ ناسِكاً تَبَتَّلا","أو رائِساً تَبجَّلا",5,"ل",2,1],["كن ناظراً في العما بالكشف مطلعا","فيه على سر ما يأتي به القدر",6,"ر",1,0],["كنَّ ناسا فصرن ناراً فاصبح","ن رماداً بها فصرن هباء",7,"ا",2,0],["كن نسخة كل سطر من صحائفها","للناس فيه بحسن الخلق تفسير",8,"ر",1,0],["كُن نَبيهاً لِلعدى ذا حيلَة","كَم وَكَم من كاد خَصماً بِالحِيَل",9,"ل",1,0],["كن نعيمًا وعذابًا ومُنى","تملأ النفس وحرمانًا مذيبا",10,"ب",2,0],["كن نبرةَ صوتي كن رئتي","واملأ أنفاسيَ بالعنبر",11,"ر",1,0],["كنّنا ما أخذنا عِلم لو باليسير","وكنّنا ما اهتدينا وْ لا عرفنا رسول",12,"ل",1,0],["كننتُ انأى عن هواهُ وما","كنتُ يومًا للهوى طالبا",13,"ب",2,0],["كن نصيري أنت وارفع","رب في الأكوان ذكري",14,"ر",2,0],["كن نبيا في الشعر أو مت شهيدا","لا اختيارٌ إلا هما قد يُقامُ !!",15,"م",1,0],["كن نظم ازهورها وسط الرياض","الجواهر في رقاب الغانيلت",16,"ت",1,0],["كُنْ نَاصِرًا للْحَقّ غَيْرَ مُدَاهِنٍ","ما خاب من أسرى به أو تاهَا",17,"ا",3,0],["كن نصيري وكافلي ومعيني","وعياذي في شدتي ورخائي",18,"ا",2,0]]}