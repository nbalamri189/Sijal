{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[29,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[29,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[74,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[53,"ما على الأحرار من رق إذا","https://www.aldiwan.net/poem61880.html","الرمل"],[51,"هل على نفسه امرؤ محزون","https://www.aldiwan.net/poem63134.html","الخفيف"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[236,"زار وهنا ونحن بالزوراء","https://www.aldiwan.net/poem44600.html","الخفيف"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[302,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[325,"كان عيد الفدا لحظك أوفر","https://www.aldiwan.net/poem67178.html","الخفيف"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[396,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[438,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[534,"عجبا أين العقول","https://www.aldiwan.net/poem37269.html","مجزوء الرمل"],[534,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64037","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120070","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59080","الدوبيت"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202129","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126152","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144014","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50011","الكامل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146079","البسيط"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116940","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48242","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10470","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77202","الخفيف"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34718","المجتث"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93718","الكامل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110665","الرجز"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121129","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121745","الكامل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/47016","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117852","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85245","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59484","الرجز"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86364","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97079","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90811","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138862",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33144","السريع"],[4578,"تذكرت شرقيّ الحمى من أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49354",""],[5057,"لا تلوموا","https://www.poetsgate.com/ViewPoem.aspx?id=184016",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[5264,"جمرك البيوع","https://www.poetsgate.com/ViewPoem.aspx?id=180076",""],[5409,"نبتت فوق روضة من غدير","https://www.poetsgate.com/ViewPoem.aspx?id=155302",""],[5409,"يا شبابي لم يصبني لك ذكر","https://www.poetsgate.com/ViewPoem.aspx?id=155268",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5539,"المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=196881",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6144,"نسوان","https://www.poetsgate.com/ViewPoem.aspx?id=13697",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""]],"verses":[["وَالمَقاديرُ إِن رَمَت لا تُبالي","أَرُؤوساً تُصيبُ أَم أَذنابا",0,"ب",2,0],["وَالمُقلَتَينِ وَبَياضِ الجيدِ","وَالكَشحِ مِن أُدمانَةٍ عَنودِ",1,"د",1,0],["وَالمُقرِعينَ عَلى الخِنزيرِ مَيسِرَهُم","بِئسَ الجَزورُ وَبِئسَ القَومُ إِذ يَسَروا",2,"ر",3,0],["وَالمُقرَباتُ نُقودُهُنَّ عَلى الوَجى","بَحثَ السِباعِ مَدامِعَ الأَوشالِ",3,"ل",1,0],["والمقتفي أمدَ العلياء في طرقٍ","طرف البروق بها تعبان مكدود",4,"د",1,0],["والمقرُّونَ به قد خلعوا","طوْقَه عنهم بحكم غيْرِ عادي",5,"د",2,0],["وَالمَقاديرُ لا تَناوَلُها الأَو","هامُ لُطفاً وَلا تَراها العُيونُ",6,"ن",1,0],["وَالمُقتَفى بِإِباءِ كُلِّ عَظيمَةٍ","فَقماءَ ذاتِ دوائِرٍ وَخِطارِ",7,"ر",1,0],["والمُقتَراتِ مِنَ الكلامِ ولم يَكُن","بِتَجارُمٍ جِدّاً ولا بِتَباذُلِ",8,"ل",1,0],["والمقام المحمود والسبق للنا","س دخولاً في الجنة الفيحاء",9,"ا",2,0],["والمقَّريُّ بنفحِ الطيبِ يُنعشُكم","وقد نشقتُم عبيرَ المجدِ أحقابا",10,"ب",2,0],["وَالمقحمُ الخَيلَ وَطيسَ الوغى","إِذا اِتَّقاها البطلُ الأحوسُ",11,"س",1,0],["وَالمَقامُ بِجِدِّكَ قَد حَز","زَت لَعَمري مِن بَعضِ فَضلِكَ أَصغَرُ",12,"ر",1,0],["والمقادير كالأعاصير تهوى","بالمناكيد من ضحايا الأنام",13,"م",1,0],["والمقادير قدرت فاطمأنت","لا تبالي ناح الورى أم تغنى",14,"ن",2,0],["والمقام الرفيع والعز أجمع","في اتباع الرسول يامقتفيه",15,"ي",2,0],["والمُقْطِعَ المعشرَ الراجينَ ما لقِحَتْ","سمائمُ الجدب إِنهالاً وإِنهابا",16,"ب",2,0],["والمُقفِراتُ سوابقٌ وخوافقٌ","والشاهِقاتُ أَسِنَّةٌ وشِفارُ",17,"ر",1,0],["والمقارِي والمصابيحُ إذا","دجت الليلةُ أو جَنَّت ضِياها",18,"ا",3,0],["والمَقاديمُ إِذا هيبَ الرَّدى","والمساميحُ إِذا الجدْبُ أظَلْ",19,"ل",1,0],["والمِقضب الكاسر الشَّبا وكذا ال","مِفصل معناه هاشم البطل",20,"ل",1,0],["والمقضب الفاصل العظام كما ال","قَضّاب يفري مفاصل الجمل",20,"ل",1,0],["والمقصل السيف لا يصان عن ال","أشجار فهو البطيء في العمل",20,"ل",1,0],["والْمَقاييسُ إذا بَا","يَنَتِ الشَّرْعَ نُفُولُ",21,"ل",1,0],["والْمَقْصِدُ الأَسْنَى مَعَ الغَايَةِ ال","قُصْوىَ معَ الهَدْيِ بِلا افْتِرا",22,"ر",2,0],["والمقتدي ماتَ في سبعٍ بأولها","بعدَ الثمانين جدَّ المُلكَ واقتدرا",23,"ر",2,0],["والمقتفي ماتَ من بعدِ التمكنِ في","خمسٍ وخمسين وانقادَت له النُصَرا",23,"ر",2,0],["والمقاصيرُ قد أَنافَتْ ذُراها","في فضاءٍ على الفضاءِ مُنيف",24,"ف",1,0],["والمقاديم يشبّون وغىً","ويدبّون إليه كالدَّبا",25,"ب",2,0],["والمقام الثبت والعز","مه مثل العضب عضبه",26,"ب",2,0],["وَالْمَقْصَدُ مَدْحُ سَيِّدِ الأكْوَانِ","خَيْرِ الفِرَقِ",27,"ق",1,0],["والمقام المحمود والحاضر المو","جود مُفْنى الطُّغاة بالسيف قتلا",28,"ل",2,0],["والمقتدي والمقتدى","والمرتدي والمكتسي",29,"ي",1,0],["والمقتنى المجلوب باستكسابِ","يحلو كما المأخوذ باستغلابِ",30,"ب",1,0],["والمقتضى في حال هذي البرهةِ","إن الملبّي الشديد الهمّةِ",30,"ه",1,0],["والمقتدي المسكين ليس له","عقل ولا رأي ولا حس",31,"س",1,0],["والمقت والابعاد والحرمان","وسقطة من نظر الرحمن",32,"ن",1,0],["والمقتنى لك يا أَبا حسنٍ","جزل الثناء نوالك الجزلُ",33,"ل",1,0],["والمقدمون من الإبداع قد كثروا","وهم قليلون إن عدوا وإن حضروا",34,"ر",3,0],["والمقرم المعلم ما إن له","مرارةٌ تسمع في الذكر",35,"ر",1,0],["والمقت والقبح تغليظ وبعدهما","ما الخزي والغضب المقرون بالبهل",36,"ل",1,0],["والمُقْربَاتُ صَوَامِنٌ ما غادرتْ","خَصْماً فوارسُها الكماةُ فيعتدي",37,"د",2,0],["والمقام المحمود ما قام فيه","غيره من أولئك الأنجاب",38,"ب",1,0],["وَالمُقصِياتُ إِذا ما العُسرُ دارَ بِنا","وَالمَكرُماتُ إِذا دارَ المَياسيرُ",39,"ر",1,0],["وَالمَقاصيرُ وَالقَواريرُ وَالأَس","تارُ وَالخَزُّ وَالوطاءُ الوَثيرُ",40,"ر",1,0],["وَالمُقلَتانِ سُجومٌ","دَمعاهُما تَكِفانِ",41,"ن",1,0],["وَالمقتفي القانون في أَحكامه","أَولى بِهِ إِن لَم يَكُن مَختونا",42,"ن",2,0],["والمقتدى بمن مضى من أهله","لما على أخلاقهم تطلعا",43,"ع",2,0],["والمقال الذي تفجر ناراً","لبني العصر من عصيّ وداني",44,"ن",2,0],["والمَقْصِدُ الأسْنَى لهم دارُ الْبَقَا","دخَلتْه من بابِ الفَناءِ الناسُ",45,"س",1,0],["والمقرفاتُ وما كذَ","بتُك لا حقاتٌ بالعراب",46,"ب",1,0],["والمقادير غدت في أمره","وقفت إن شاء أو شاء تحول",47,"ل",1,0],["والمقتفون سبيله قدما على","قدم إلى القدم الشريف الطاهر",48,"ر",1,0],["والمقتدين بهم ما قال منشدها","تبكي الحساء بدمعٍ سافحٍ جاري",49,"ر",2,0],["والمقعدُ ليس بمكتسبٍ","عيباً فاركبه ولا تسلِ",50,"ل",1,0],["وَآلُ مُقاعِسٍ لَم يَخذُلوها","عَلى حَربٍ أُريدَ وَلا صَلاحِ",51,"ح",1,0],["والمقدمين ونفس القوم محجمة","والخيل ترفع سجف النقع مركوما",52,"م",2,0],["والمقرح الأجفان والمدمي لها","والمودع الأحشاء وجداً مسعرا",53,"ر",2,0],["والمقرنين ببرهم اعذارهم","والمقتنين الشكر أطيب مقتنا",54,"ن",2,0],["والمُقْرَباتُ بأَنْسُرٍ وقوائمٍ","تحكي قوادِمَ أَنْسُرٍ وأَجادلِ",55,"ل",1,0],["والمقدمون لدى الهيجا بسوم وغى","والحرب ترمي باشواظ من اللهب",56,"ب",1,0],["والمقلةُ العبرى التي دمعُها","ننشقُهُ من حسرةٍ غالبَه",57,"ب",2,0],["والمقدس أشواقٌ وبيروت مثلها","فكلٌّ لهذا سائل الدمع صبه",58,"ب",2,0],["والمقاديرُ إن قطَعنَ وِصَالاً","ضاقَ عن كربةِ المُحبِّ الفضاءُ",59,"ا",2,0],["والمقعَدُ الذَّهَبِيُّ يَنبِسُ سَاخِطاً :","أَلِأَجلِ غِرٍّ يُستَبَاحُ سَلَامُ ؟!",60,"م",1,0],["والمقرفين قاعدين وجدرهم مزروع","وكل واحد خنيق ليه غصون وفروع",61,"ع",1,0],["والمقادير لا تعيرك سمعاً","إن أطلت الشكاة أو لم تطيلي",62,"ل",2,0],["والمقادير صيرتني ممن","هم سفين للعابرين وجسر",63,"ر",1,0],["والمقادير إذا ما أزمعت","صورت رسل المنايا عمدا",64,"د",2,0],["والمقام المحمود الحوض والكو","ثر يقفو ظل اللواء الظليلا",65,"ل",2,0],["والمقدر بيد رب الكائنات","وحظ من نيته من طيب النوايا",66,"ا",3,0],["والمقتدى من مضى من أهله","فيمن حوى علما وفيما اطلعا",67,"ا",1,0],["وَ المُقْلَتَانِ اسْتَولَتَا - رُغْمًا - عَلَى","قَلْبِي فَخَرَّ إِلَى الضُّلُوعِ مُجَرَّحا",68,"ح",2,0],["والمقصوعه ورجلها فوق","اختها مرفوعه تستنظر الطوموبيل",69,"ل",1,0],["والمَقعَدُ الخَشَبِيُّ يَنْظُرُ حَائِرًا","والوَقتُ يَسْرِقُ مِنْ يَدَيكِ الغَزْلَا",70,"ل",2,0]]}