{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[264,"يا منكرين على من","https://www.aldiwan.net/poem35547.html","المجتث"],[438,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[463,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[509,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122669","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66723","الطويل"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130674","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79997","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124737","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121025","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132003","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132129","الكامل"],[3756,"","https://poetry.dctabudhabi.ae/diwan/poem/121972","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72738","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4680,"يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=199778",""],[4814,"محضُ خواء","https://www.poetsgate.com/ViewPoem.aspx?id=192444",""],[5183,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=186425",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5843,"اخر مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=51292",""]],"verses":[["عَلْيَاؤُكُمْ غَايَاتُهَا لاَ تَنْتَهِي","فِي مِثْلهَا خَانَ الْبَلِيغَ الْمقْوَلُ",0,"ل",1,0],["عَليّاً وعُثْمانَ ويَعْقوبَ لا عَدا","رِضا اللهِ ذاكَ النّجلَ والأب والجَدّا",1,"د",2,0],["على أولي الذكر كنتم","بجهلكم معتدينا",2,"ن",2,0],["على أولَق يَطوي المراحلَ طاوياً","ويسري وأفواجُ الرّياح طلائح",3,"ح",1,0],["على أوجه الأعياد مِيسمُ حسنِها","من اسمك سطرٌ في الجباهِ موقَّعُ",4,"ع",1,0],["على أوانَ شُوِّهَتْ وعُنِّسَتْ","وسُلبتْ جمالَها والخَفَرا",5,"ر",2,0],["على اولياء الوجد قدك لومتنا","ملاقيه جبراً للحيوة يودّع",6,"ع",1,0],["عَلياً وأحمَداً وأبا القا","سِمِ تُنمَى أم أحمداً أم مُطاعا",7,"ع",2,0],["عليّاً ومِقداداً وأن يخرجوا بِها","رويداً بِلَيْلٍ في سكوتٍ وفي سَترِ",8,"ر",1,0],["عليَّ اوجبتموا شكراً لما نسجت","منوال افكاركم من صنعة الأدب",9,"ب",1,1],["على أوَّل الدهر استهلَّ نداهم","فسالت به قبل الغيوث الأباطحُ",10,"ح",1,0],["على أول الأثراء إن جاءها به","فإن لم يبن طهرٌ لها فالتقدم",11,"م",1,0],["على أوحَدِ الأملاك غير منازع","أصالة أعراق وفضل تقدُّمِ",12,"م",1,0],["على أوَّلِ الليلِ آستَعِدَّ وقِسهُمُ","قياساً بهِ الضيقُ يَهدي المُسَافِر",13,"ر",1,0],["على أوَّلِ الظُّلمَةِ أمَّا غُروبُهُ","وَمَطلَعُهُ في الإستِوَا بالتَّجانُبِ",14,"ب",1,0],["على أوفى الزائرين حقوقهم","وأصوغ فيهم ما يروق ويبهر",15,"ر",1,0],["علياؤهم في العلم عندك والحجى","هي بعلبك ومجدهم أهرام",16,"م",1,0],["على أولقِ فيه اختباط كأنَّه","أبو جابر في خبطهِ وجنونهِ",17,"ن",2,0],["على أوراقها تختال تيها","كما اختالت بمشيتها العذارى",18,"ر",2,0],["علياؤه الشمس وكلُّ رفعةٍ","إذ عشقت سموَّها حرباؤها",19,"ا",3,0],["على أوجاع جرحك يا عراقُ","جموع الخائبين لهم سباقُ",20,"ق",1,1],["على أوتارِ فقدكَ شاخَ لحني","وباتَ العمرُ مرهوناً بحزني",21,"ن",2,1],["علّي أؤدي به حق الصلاة على الم","ختار ما غرَّد القمري موالا",22,"ل",2,0],["علّي أوسع برزخا","فيه المواجع هاجعة",23,"ع",2,0],["على اواه يانفسي وويلاه وش بقى","منافع بها تقضين يانفس طايبه",24,"ب",2,0],["على اولك ياسيد التعب والتعب سجان","مفاريد غر النور ف /الحلق منزره",25,"ر",2,1]]}