{"poems":[[75,"أحمدت عاقبة الدواء","https://www.aldiwan.net/poem11922.html","مجزوء الكامل"],[92,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[41,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[77,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[202,"بيني وبين الحادثات خصام","https://www.aldiwan.net/poem51882.html","الكامل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[333,"تعالي يابنة الأحلام","https://www.aldiwan.net/poem54976.html","الهزج"],[358,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[382,"اليوم يخفق كل نجم مرجف","https://www.aldiwan.net/poem59331.html","الكامل"],[406,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[463,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102036","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87269","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27814","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45740","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205934","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128951","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94558","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4677,"أتنسى","https://www.poetsgate.com/ViewPoem.aspx?id=204575",""],[4752,"معا نحو السلام","https://www.poetsgate.com/ViewPoem.aspx?id=207965",""],[4935,"بالعلى والخير قد وافى حسين","https://www.poetsgate.com/ViewPoem.aspx?id=129486",""],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[4984,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180154",""],[4984,"الدهر أعطى","https://www.poetsgate.com/ViewPoem.aspx?id=190854",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5353,"محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212456",""],[5444,"قبلة الأشواق والإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205445",""],[5691,"طغى الجوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206098",""],[5691,"المربد","https://www.poetsgate.com/ViewPoem.aspx?id=206353",""],[5703,"ستبقى أميراً","https://www.poetsgate.com/ViewPoem.aspx?id=214518",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[463,"ليتها إذ منعتْ ماعونها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60252&r=&rc=308",""]],"verses":[["لِنَرى بِكَ البَهوَ المُطِلَّ","يَميسُ في حُلَلِ البَهاءِ",0,"ا",2,0],["لنَراكُمُ المثلَ العليَّ لأمّةٍ","ترمي إلى أهدافها وتُصيب",1,"ب",1,0],["لِنَرفَعَ مِنهُم ما أَبى اللَهُ رَفعَهُ","وَقَد وَطِئوا بي وَطأَةَ المُتَثاقِلِ",2,"ل",1,0],["لنرى بأعيُننَا مصارعَنا","لو كانتِ الألْبابُ تعتبِرُ",3,"ر",1,0],["لنُرَتِّلنَّ لهم غدًا:","«كونوا قرُودًا خاسئين»",4,"ن",1,0],["لنريكَ أفراحَ العراقَ شَمالَه","وجنوبَه وشبيبةً وكُهولا",5,"ل",2,0],["لنرى الديارَ وهنَّ بعد أنيسها","دُرُسُ المعالمِ والجسومِ رِمام",6,"م",1,0],["لَنَرى بَقاءَكَ نِعْمَةً مَحْقُوقَةً","بِالشُّكْرِ ما سُقِيَ الأَنامُ وما رُعِي",7,"ي",1,0],["لنروى ظمأ الدنيا","بما يوحي به القلب",8,"ب",1,0],["لِنَرى رَوض فَضلِهِ","يانِعَ الزَهر مونِقا",9,"ق",2,0],["لنرى به مصباحَنا متألقاً","فعساه يوم مجيئه لا ينطفي",10,"ف",2,0],["لِنَرْفَعَ رايةً للحقِّ تُمْحَى","بها من صَدْرِ أُمَّتِنَا الكُرُوبُ",11,"ب",1,0],["لنرى مثلَ ابن أيّوب فتىً","ثقةَ الشيمةِ أو مأمونَها",12,"ن",3,0],["لنرى مالذي ملكت به الشر","ق فأضحى يشري لكم ويباع",13,"ع",1,0],["لِنَركُضَ في مَيادين التَهاني","بِحُصن صارَ في مَصرٍ حَصينا",14,"ن",2,0],["لنراه حتى لا نشك بأنه","هو عينه فأتى الحجاب زوالا",15,"ل",2,0],["لِنَرى الجَواري المُنشئات وفَوقها","بَحر النَوال وَدونَها الدَأماءُ",16,"ا",2,0],["لنرى في صباح يوم بهيج","زهرةً يشهد المساء مداها",17,"ا",3,0],["لنرى العيد والأراجيح والروض","ونجني منه وروداً جنيه",18,"ه",1,0],["لنرتع في ظلّ العزيز مليكنا","بروضٍ بها بالأمن قد بسم الزهرُ",19,"ر",1,0],["لِنَرْفَعَ للاجيالِ فيهم رُؤُوسَنا","وَنَفْخَرُ فيهم مَنْ يُفاخِرُ مُنْشِدَا",20,"د",2,0],["لنرشف كأس المحبة خمرًا","وخمر المحبة عذبًا زلال",21,"ل",1,0],["لنَرسُمَ بسمةً في وَجهِ طِفلٍ","وَنسقِي فَرحَةً في قَلبِ ضَامِي",22,"ي",1,0],["لنراه راقياً أسمى العلى","بين عز في ظلال الوالدين",23,"ن",1,0],["لنُرجع من ماض مُحالا كأننا","نحاول بعثا في قلوب لها غلف",24,"ف",1,0],["لنرسم في الآفاق آمال حالم","حقيقتها بين الخيالات والوهم",25,"م",1,0],["لنرى المواقع مثل ما كانت على","عهد النبي بدت فما تتغيَّر",26,"ر",1,0],["لنرجئ كل اللوم والمرء ربما","أزال الرضا عنه الملامةَ والعَتْبا",27,"ب",2,0],["لنرى بأيّ الصّمتِ يُعتقلُ المدى","فينا وكيف تردّهُ الأصداءُ",28,"ا",2,0],["لنرى عمانَ بقمةٍ يرنو لها","- والله يحفظ مجدَها- الثقلان",29,"ن",1,0],["لنَرْجِعْ إلى التّاريخِ ولْنَنْظُرَنْ بهِ","مَنِ انْحازَ للغازي خَذىً ومَنِ انْبَرى",30,"ر",2,0],["لنرْجِعَها إلينا بعْدَ موْتٍ","لسيرَتِها ونِسْيانٍ ودفْنِ",31,"ن",1,0],["لنرحَلَ بالحُبِّ نحْوَ النقاء","وكوخاً سَنبني عليهِ لَنا...",32,"ن",2,0],["لِنَرْقَى حَيَاتِي عَلَى كُلِّ هَوْلٍ","وَ نَحْيَا حَنِيناً بِرَحْبِ الفَضَاءْ",33,"ا",2,0],["لنرتدي أحرفًا ما مسها لغبٌ","ولا ترامى على أطرافها هرمُ",34,"م",1,0],["لنرد كل عقيدة مدخولة","بعقيدة أسمى ونهج أمثل",35,"ل",1,0],["لنرى مثلَ ابن أيّوب فتى ً","نقة َ الشيمة ِ أو مأمونَها",36,"ن",3,0]]}