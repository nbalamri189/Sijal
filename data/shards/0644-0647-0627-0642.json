{"poems":[[55,"كذا يهجم القدر الغالب","https://www.aldiwan.net/poem30740.html","المتقارب"],[57,"أهاجك صوت قمري ينوح","https://www.aldiwan.net/poem26434.html","الوافر"],[9,"صحا القلب من ذكرى قتيلة بعدما","https://www.aldiwan.net/poem21967.html","الطويل"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[29,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[63,"ومبنية من خيزران مفضض","https://www.aldiwan.net/poem51565.html","الطويل"],[82,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[15,"تذكرت أهلي الصالحين بملحوب","https://www.aldiwan.net/poem45284.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[82,"تَغَنَّتْ قيانُ الوُرْقِ في الوَرَق الخُضْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3226",""],[132,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[202,"وخود ضم مئزرها كثيبا","https://www.aldiwan.net/poem51859.html","الوافر"],[216,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[254,"أمن ليلى وجارتها تروح","https://www.aldiwan.net/poem2123.html","الوافر"],[264,"تبدت هلالا وارتدت بالبها مرطا","https://www.aldiwan.net/poem35934.html","الطويل"],[371,"تبا لدنيا ساحره","https://www.aldiwan.net/poem17762.html","مجزوء الرجز"],[488,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[505,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[520,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53751","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126806","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38192","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120033","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96705","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106702","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104824","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109375","البسيط"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34715","المتقارب"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99070","الوافر"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121134","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108344",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45868","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105144","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94462","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123469","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62142","الطويل"],[4595,"","https://poetry.dctabudhabi.ae/diwan/poem/99212","الطويل"],[4830,"يا سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=194932",""],[4927,"وفاء عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29604",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5002,"قال... وقالت!","https://www.poetsgate.com/ViewPoem.aspx?id=202699",""],[3591,"سعيدة حسن قد تصبت حشاشتي","https://www.poetsgate.com/ViewPoem.aspx?id=149382",""],[5121,"سُمَيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=71116",""],[5277,"نفثاتٌ قيسيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199885",""],[5291,"بلادى البيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=14022",""],[5302,"أقمت على نهري","https://www.poetsgate.com/ViewPoem.aspx?id=200064",""],[5362,"أماطت في الدجى عنها الخمارا","https://www.poetsgate.com/ViewPoem.aspx?id=170385",""],[5376,"وما الدنيا بنا الا يبابُ","https://www.poetsgate.com/ViewPoem.aspx?id=188563",""],[5431,"لبيروت الصلاة...","https://www.poetsgate.com/ViewPoem.aspx?id=215336",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[6068,"ألف ألف تحية -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175860",""],[520,"محلك لا يسام ولا يسامى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577649",""],[6355,"بيتٌ ومصراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66658&r=&rc=118",""]],"verses":[["لَها قَسطَلٌ كَنَسيجِ السَدوسِ","بِهامِ الرُبى أَبَداً عاصِبُ",0,"ب",1,0],["لَها قَلبي الغَداةَ وَقَلبُها لي","فَنَحنُ كَذاكَ في جَسَدَينِ روحُ",1,"ح",1,0],["لَها قَدَمٌ رَيّا سِباطٌ بَنانُها","قَدِ اِعتَدَلَت في حُسنِ خَلقٍ مُبَتَّلِ",2,"ل",1,0],["لَها قَصَبٌ فَعمٌ خِدالٌ كَأَنَّهُ","مُسَوِّقُ بَردِيٍّ عَلى حائِرٍ غَمرِ",3,"ر",1,0],["لَها قَصَبٌ رَيّانُ قَد شَجِيَت بِهِ","خَلاخيلُ سَلمى المُصمَتاتُ وَسورُها",4,"ر",3,0],["لها قُبَّةٌ كالحيَّتَيْنِ صَبيلَةٌ","وَوَجْهٌ بتجذيفِ الشَّوانينِ يَلمَعُ",5,"ع",1,0],["لها قَسْوَةٌ من قلبه مُسْتَمِلّةٌ","لعُنْفِ ندامَاها كذا قَسوةُ الكفرِ",6,"ر",1,0],["لَها قَمَعٌ تَذري بِهِ الكورَ تامِكٌ","إِلى حارِكٍ تَأوي إِلى الصُلبِ مَنصوبِ",7,"ب",1,0],["لها قوانينُ من عَدْلٍ ومَرْحَمَةٍ","قد نَفَّذُوا بعْضَها في دَيْرِ يا سينَا",8,"ن",2,0],["لها قسوة ٌ من قبله مستملة","ٌ لِعُنْفِ نَدَامَاها كذا قَسوة ُ الكفر",9,"ر",1,0],["لها قصيبات السبقِ في كلِّ حليةٍ","إذا حضرتْ فاقت كُميتاً وأَدْهَمَا",10,"م",2,0],["لها قُلُبٌ أبى النطقَ اكتتاماً","وسرُّ نطاقِها أبداً مباح",11,"ح",1,0],["لها قامةٌ كالسَّمْهَرِيّ وخَصْرُها","نَحِيْلٌ وفَاقَتْ بالخصور نُحُوْلُها",12,"ل",3,0],["لَها قَرَدٌ كَجُثِّ النَملِ جَعدٌ","تَغَصُّ بِهِ العَراقي وَالقُدوحُ",13,"ح",1,0],["لها قامةٌ كالغصن في موقف الهوى","تقيم لعشّاق الجمال بها قسطا",14,"ط",2,0],["لَها قُلوبٌ تثَبَتَت","وَهيَ لِخَوفٍ طائِرَه",15,"ر",2,0],["لَها قِردٌ تامِكٌ نَيُّهُ","تَزِلُّ الوَلِيَّةُ عَنهُ زَليلا",16,"ل",2,0],["لها قُلوبُ أُولي الأسرارِ قد رُفِعَتْ","بِجَذْبَةٍ تَدَلَّى من مَعاليها",17,"ي",3,0],["لها قوت مصت سنة عليه","وعدة أشهر أيضاً تماما",18,"م",2,0],["لها قدرة في جسوم الأنام","حباها بها اللّه ذو القدرهْ",19,"ر",2,0],["لها قامَ عبد اللّه يقتاد جيشهُ","إلى الحربِ يحكي جدّه في الندى خلقا",20,"ق",2,0],["لَها قُبّة مَخلوقَة مِن زُمرُّدِ","لَها دَرَجٌ مِن فِضّةٍ ثمَّ عَسجَد",21,"د",1,0],["لها قوام كقضيب آسى","ولحظات جؤذر الكناسِ",22,"س",1,0],["لَها قدٌّ كغصنٍ نا","عمٍ ريّان ميّالِ",23,"ل",1,0],["لها قوامٌ في الوشي معتدلٌ","كالغصن الغضّ هزّه الورقُ",24,"ق",1,0],["لها قوامٌ معتدلْ","ومَنْظَرٌ حُلْو شَكِلْ",25,"ل",1,0],["لها قربُ عهدٍ بالولادة لا تخل","أتى قبلُ أو من بعدُ يأتي مثيلها",26,"ل",3,0],["لها قصَبَاتُ السَّبقِ فِي كُلِّ مَحفَلٍ","إذَا استبقَت يَوماً كِنانةُ أو فِهرُ",27,"ر",1,0],["لَها قًبَيلَ يَبلُغَن","أَعلاَمُهُ فَحَقِّقَن",28,"ن",1,0],["لهُ أَقرَّ برقٍّ دهره وعلى","اقراره باختيارٍ أشهد الأُمما",29,"م",2,0],["لَها قَفَصٌ لِاِقتِناصِ الفُه","ودِ واثِبَةٌ فيهِ أَو لابِدَه",30,"د",2,0],["له أقلام كيف يشاء تجري","بتأييد القضاء بالمشيه",31,"ي",2,0],["لها قلب رقيق لا","يطيق لحزنهم يوما",32,"م",2,0],["لها قصبات السبق في حلبة العلى","وقدح المعلى في مساهمة الدول",33,"ل",1,0],["لَها قُلتُ هَل لا تَرفقينَ بِمُغرَمٍ","بِهِ وجدُهُ اِن زادَ شَوقاً وَاِن نَما",34,"م",2,0],["لها قام كالبان أو أغصن النقا","ولكن لها قلب من اللبن قد أقوى",35,"و",2,0],["لَها قَد أَزلَفَت جَنات عَدن","سروراً قَبل إِدراك الحُدود",36,"د",1,0],["لها قد كانت الغادات","من قبل الوغى تجري",37,"ي",1,0],["لها قلب أرق على محب","من الشكوى وأقسى من حديد",38,"د",1,0],["لها قوام هو الخطّارُ في ميسٍ","من لينهِ حاق أغصان النقا خَفَرُ",39,"ر",1,0],["له أقامَ وليَّ الملكِ في شَرَفٍ","يَهُدُّ ركناً له بباهرِ النظَر",40,"ر",1,0],["لها قسمة بين الرواة وبينكم","فمن قسمة ضيزى إلى قسمة عدل",41,"ل",1,1],["لها قشر عقيان ورأس مشرق","وأغصان خيري وأوراق عبهري",42,"ر",2,0],["لها قدٌّ كغصن البان حُسنا","فسبحان الذي خلق الجمالا",43,"ل",2,0],["لَهَاْ قَلْبِيْº وَمَاْ مَلَكَتْ يَمِيْنِيْ","وَتُفْدَىْ بِالصَّبِيَّةِº وَالصَّبِيِّ",44,"ي",1,0],["له إقراء بليل القد","ر يا هذا تنل عجبا",45,"ب",2,0],["لها قال: أنت ِالشِّعر مذ خضتُ موْجَهُ","وقافيتِي والشط ُّ أنتِ وأَبْحُرِي",46,"ر",2,1],["لها قامة لو تكشف الريح ثوبها","لطارت قلوب العاشقين لها وثبا",47,"ب",2,0],["لَهَا قَلْبٌ مِنَ الرَّيْحَانِ يُنْدِي","وَأَنْفَاسٌ كَرِيِمَاتٌ زَكِيَّةْ",48,"ي",2,0],["لها قلبي وما قد كان فيه","إذا ما قلتُ للأطيافِ هيّا",49,"ي",2,0],["لها قرة العين إن أطربتها","وعمرى وزهرى وكل ودادى",50,"د",2,0],["لها قالب لم يطرق العيب روحه","وقلب رقيق لم يذق غير مفتاحي",51,"ح",2,0],["لها قد يضاهي الغصن لينا","وطرف يخجل الظبي احورارا",52,"ر",2,0],["لها قدسيةٌ ليستْ تُراءى","فما لعفافِها أبدا تهابُ",53,"ب",1,0],["لها قلبٌ يميل إلى ثراء","ومن تيه الجبابرة استزادا",54,"د",2,0],["لها قدٌّ يحيرني","جمالاً مفرطاً حشدا",55,"د",2,0],["3-لها قلب جلمود وقول تسلط","وفعل عَدُوٍّ جاء يختال في السير",56,"ر",1,0],["لها قوتٌ مضت سنةٌ عليه","وعدة أشهر أيضاً تماما",57,"م",2,0],["لها قناديلُ في الظلماءِ مُطْفَأةٌ","لها سماسرةٌ في البيد قُطَّاع",58,"ع",1,0]]}