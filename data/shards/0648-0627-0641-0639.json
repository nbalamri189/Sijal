{"poems":[[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[49,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[74,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[87,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[48,"لا تخبأن لغد رزقا وبعد غد","https://www.aldiwan.net/poem22953.html","البسيط"],[48,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[120,"أيهذا المتجني","https://www.aldiwan.net/poem2361.html","مجزوء الرمل"],[139,"يستحيل الفؤاد أن يستحيلا","https://www.aldiwan.net/poem49137.html","الخفيف"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"أكليب مالك كل يوم ظالما","https://www.aldiwan.net/poem27886.html","الكامل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[287,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[371,"يلام لما لا يستطيع ويعذر","https://www.aldiwan.net/poem16990.html","الطويل"],[376,"رأى الورد من خديه يحتمل المحلا","https://www.aldiwan.net/poem57230.html","الطويل"],[382,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[447,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[484,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[534,"هذي بيوت حل فيها القاصر","https://www.aldiwan.net/poem37377.html","الرجز"],[563,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120006","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126119","الرجز"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122083","الطويل"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36171","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76891","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69348","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109741","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109478","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107164","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93797","الخفيف"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[2948,"","https://poetry.dctabudhabi.ae/diwan/poem/198266","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74183","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125878","الطويل"],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105884","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123483","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123500","الكامل"],[4755,"رَاسِلِينِي بمُلصَقٍ أَو بصُورةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183775",""],[4908,"وللأحْزَانِ في مَهْدِ الخَيَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=211480",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"إلى شامي أنا راجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=183085",""],[5550,"إذا شئْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211314",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5837,"زمل التخوت","https://www.poetsgate.com/ViewPoem.aspx?id=189995",""],[5970,"بني مصر هبوا وأجهدوا ما استطعتمو","https://www.poetsgate.com/ViewPoem.aspx?id=130665",""],[5970,"عش غريباً فالعيش محض غريب","https://www.poetsgate.com/ViewPoem.aspx?id=130596",""]],"verses":[["وَاِفعَل بِمالِكَ ما بَدا","لَكَ إِن مُعاناً أَو مُعينا",0,"ن",2,0],["وَأَفعالُهُ لِلراغِبينَ كَريمَةٌ","وَأَموالُهُ لِلطالِبينَ نِهابُ",1,"ب",1,0],["وأفعاله أوفى ندًى من مقاله","وأكرم من أخباره الغرّ خبره",2,"ر",2,0],["وافعل به غير مأمور بعارفة","فعلاً يزفُّ نَعام الشكر إزفافا",3,"ف",2,0],["وأفعالٌ يبيت لحاسديه","بها سمرٌ إذ هجعَ النيامُ",4,"م",1,0],["وَأُفٍّ عَلى العِلمِ الَّذي تَدَّعونَهُ","إِذا كانَ في عِلمِ النُفوسِ رَداها",5,"ا",3,0],["وَاِفعَل بِغَيرِكَ ما تَهواهُ يَفعَلُهُ","وَأَسمِعِ الناسَ ما تَختارُ مِسمَعَه",6,"ع",2,0],["وَاِفعَلِ الخَيرَ فَالحَدي","ثُ كَثيرٌ قَدِ اِختَلَف",7,"ف",1,0],["وَافْعَلْ كَما يُمْلي الْهَوَى","فَاكْتُمْ حَدِيثَكَ أو فَجَاهِرْ",8,"ر",1,0],["وافعَل الخَير إذا اسطَع","تَ ولكن دون مَنِّ",9,"ن",1,0],["وأفعلي كيف تشتهين فقلبي","لن يرى قط للسلوّ سبيلا",10,"ل",2,0],["وَأفعالهُ تُبدي قبيحَ ضلالهِ","وَتكشفُ عَن مكنونِ إِلحادهِ السِترا",11,"ر",2,0],["وَأَفعالهُ مثلُ المَجانين ما لها","لَدى عقلاءِ الناس من حكمة تدرى",12,"ر",2,0],["وَاِفعَل بِقَومِكَ ما أَرادَ بِوائِلٍ","يَومَ الغَديرِ سَمِيُّكَ المَطعونُ",13,"ن",1,0],["وأفعل قد صيغ للتفضيل من","فعل ثلاثي مغاير ضمن",14,"ن",1,0],["وأفعل يصح عند العرب","ان صيغ للتفضيل والتعجب",14,"ب",1,0],["وَأَفعَمَ بِالتَرخيمِ في الأَرضِ صَحنَهُ","وَكانَ بِهِ الآجر قَد عانَقَ الجَصّا",15,"ص",2,0],["وأفعاله فضل وعدل وحكمة","وليس بظلام وليس بجائر",16,"ر",1,0],["وَأَفعل في الألباب من خمرِ بابلٍ","وأعجبُ للمرتادِ من موقع الخصبِ",17,"ب",1,0],["وَأَفعالُكُم تَنهاهُ لَو كانَ يَنتَهي","وَما غابَتِ الآراءُ لَو كانَ يَحضُرُ",18,"ر",1,0],["وأَفعالُكُم تُملي عَلى النَّاسِ مَدحَكُم","وكُلُّ امرِئٍ يُثني بِمِقدارِ ما استَملَى",19,"ل",2,0],["وأفعالاً رأيناها","كأنا ما رأيناها",20,"ا",3,0],["وأفعالُها في جميع الصَّنيع","من البِرِّ تَسْبِقُ أقوالها",21,"ل",3,0],["وافعلْ إذا ما اسطعت خيراً واعلمَنْ","أنك تُجزى مثلَه يوم الجَزا",22,"ا",1,0],["وأَفْعَالُ خَفْضٍ كنت تَشْكُلُها لَهُ","برَفْعِكَ قَدْ أَوْفَتْ عَلَيْها الجَوازِمُ",23,"م",1,0],["وأفعى المنايا لها لسعة","فليس لها من طبيب وراق",24,"ق",1,0],["وأفعمت بالإخلاص قلبا وقالبا","وأبحرت بالآمال وحدك موسقا",25,"ق",2,0],["واَفْعَل وافعَللّ افعنلا","واستَفْعل وانْفَعَل علا",26,"ل",2,0],["وافعل ولا تفعل جيمع أوامري","واترك ولا تترك لنهيي تائبا",27,"ب",2,0],["وافعل ما شئت وَدُمْ وَاصحبْ","جَيشاً عَن مَجدك لا يَرغَبْ",28,"ب",1,0],["وأفعال له ما زال يحيي","بها ميت المكارم وهو مودي",29,"د",2,0],["وافعل من الأمور ما تيسرا","ودع من الأمور من تعسرا",30,"ر",2,0],["وافعل الخير ما استطعت فقد تع","جز عن فعله ويغلق بابه",31,"ب",2,0],["وأفعل التفضيل منه يعتبر","خير الورى أحمد أفضل البشر",32,"ر",1,0],["وأفعل وفعلة أفعال","أفعلة لقلّة أمثال",32,"ل",1,0],["وافعل مع التأنيث والتذكير","واجمع مع التصحيح والتكسير",32,"ر",1,0],["وأفعل التفضيل نحو أفضل","وأعلم فانصب به في العمل",32,"ل",1,0],["وَأَفْعَالُهُ تَخْتَصُّ بِالخَفْضِ وَالغِنَى","فَأَعْجَبُ لِلأَفْعَالِ تَخْتَصُّ بِالخَفْضِ",33,"ض",1,0],["وأفعاله عند استباق \"المدا\" شأت","وفعل \"ظُباه با\"لكماة وجُردُه",34,"د",2,0],["وَأَفعلُ ما أَختار في كلِّ فاسِق","مِنَ الصّيد حَتّى لا تَراهُم وَقَد بادوا",35,"د",3,0],["وافعل الخيرَ ما استطعتَ وأصلح","وتسابق في البِرِّ والإحسانِ",36,"ن",1,0],["واِفعَلي الخير ما اِستَطعتِ عَلى الخَي","رِ فَلَن تعدمي عليهِ الجوازي",37,"ز",2,0],["وَافعَلِ الخَيرَ ما استَطَعتَ فَإِنَّ ال","خيرَ تَلقاهُ مِثلَ ذُخرِكَ ذُخرا",38,"ر",2,0],["وَاِفعَل كَما فَعَلَ الخَليفَةُ جَعفَرٌ","بِالبُحتُرِيِّ وَرَهطُهُ الأَنجابُ",39,"ب",1,0],["وافعل الاحسان فيهم دائماً","فبه تملك أعناق البشر",40,"ر",1,0],["وافعل بها ارخ كمال التقى","وكل إنسانٍ يرى ما فعل",41,"ل",1,0],["وافعَل في النقصان والزيادَه","كما ضَرَبنَا مَثَلَ الإفادَه",42,"ه",1,0],["وافعَل كَذا في دُورِ حَرمِ النورِ","وما يُقاربهُ على التحريرِ",42,"ر",1,0],["وافعَلَّ كاحمرَّ احمراراً خدها","من خجل حتى تبدي عقدها",43,"ه",2,0],["وافعل الخير ما استطعت تجده","ليس شيء عن الكريم بضائع",44,"ع",1,0],["وافعل بمن ترتاب منه مثل فع","ل الملتمس اللبيب الحذق",45,"ق",1,0],["وأفعَلُ العارِفَ قبلَ المسأَلَهْ","وأنتِجُ العَيْرانَةَ السَجْلَلَهْ",46,"ل",2,0],["وَأَفعال بِها تَسمو المَعالي","جَرى فيها عَلى نَهج قَويم",47,"م",1,0],["وَافعَلٌ فَعلاَنُ نَحوُ أشِر","وَنَحو صَديَانَ وَنَحوُ الأجهَرِ",48,"ر",1,0],["وَأفعَلٌ فِيهِ قَلِيلٌ وَفعَل","وَبِسوَى الفَاعِلِ قد يَغنَى فَعَل",48,"ل",1,0],["وَأفعَلَ التَّفضِيلِ صِلهُ أبَدَا","تَقديراً أو لفظاً بِمن إن جُرِّدَا",48,"د",2,0],["وافعم ملكه عدلاً وأمناً","فما من قائل ظهر الفساد",49,"د",1,0],["وأفعالُكَ الحسنى تَدُلُّ بنفسها","على نفسِها والكلُّ راءٍ وسامع",50,"ع",1,0],["وافعاله في الهضم حدث بها ولا","تخف لومة اللوام فهي عظام",51,"م",1,0],["وافعل باصولى مع الفروع وصحبى","والمنشد والسامعين ذاك ومن راد",52,"د",1,0],["وافعل بأصلى والفروع وعترتى","والصحب ما منه ترى السراء",53,"ا",2,0],["وافعل بكل أصولى والفروع كذا","والصحب واحمهم من كل مانكظا",54,"ظ",2,0],["وافعل بأصلى ذا وفرعى واحمهم","والصحب ما من هوله أتحرّز",55,"ز",1,0],["وافعَلِي ما تَرَينَ مِن غَيرِ شُحٍّ","ما يُسَمَّى إِن حَرَّمَ البَدرُ نُورَهْ؟!",56,"ر",2,0],["وأفعالٌ فواحشُ موبقاتٌ","غرقنا في ذنوبٍ، لا نبالي",57,"ل",2,0],["وأفعمت بالإحسان كأسا روية","فحسبك أن تهنا الشراب من النهر",58,"ر",1,0],["وأفعاله سبحانه وبحمده","لقد جل عن شبه وكفوٍ وعن يد",59,"د",1,0],["وأفعال الإله فإن فيها","لأهل الحق من أهل الكمال",60,"ل",1,0],["وأفعى الغربِ تقتلني","بسمٍ خائنٍ لاذعْ",61,"ع",1,0],["وافْعل الخيرَ دائما فهْو فعلٌ","منْ فعال الكرام منذ قديم",62,"م",1,0],["وأفعم قلبي نشوة ومسرة","بظل شبابي للكعاب غرام",63,"م",1,0],["وأفعالهم ما تنحصر عبر الابيات","لو كان جزل الشعر لي باقتدارة",64,"ر",2,0],["وأفعالكم في الحرب إن جدجدها","ونودي بالأبطال أفعال أطفال",65,"ل",1,0],["وأفعل الخير ما استطعت فهذا","للفتى في الحياة خير نصيب",66,"ب",1,0]]}