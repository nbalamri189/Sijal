em38078.html","البسيط"],[507,"لي نحو أرض المنى من شرق اندلس","https://www.aldiwan.net/poem2422.html","البسيط"],[515,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"رأيتك في المنام بعثت نحوي","https://www.aldiwan.net/poem12273.html","الوافر"],[539,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[552,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[552,"أأسقى نمير الماء ثم يلذ لي","https://www.aldiwan.net/poem48117.html","الطويل"],[559,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[568,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[576,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[576,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[587,"كان بعينين فلما طغى","https://www.aldiwan.net/poem17816.html","السريع"],[587,"وأهيف فاق الورد حسنا بوجنة","https://www.aldiwan.net/poem17820.html","الطويل"]],"verses":[["كأن بطينه عنقود كرمٍ","أسالت كف عاصره اللبابا",0,"ب",2,0],["كَأَنَّ بِهِ مِن خَطبِ ظَمياءَ غُصَّةً","يَسيغُ شَجاها بِالدُموعِ الذَوارِفِ",1,"ف",1,0],["كَأَنَّ بِقَعقاعِ الرُعودِ عَشِيَةً","عِشاراً يُراغينَ الجُلالَ الجَلَنفَعا",2,"ع",2,0],["كَأَنَّ بُكوراً مِن نَطاةٍ وَخَيبَرٍ","لَها ناحِطٌ مِنهُم رَميضٌ وَناعِرُ",3,"ر",1,0],["كَأَنَّ بِهِ النَوتِيَّ مِن سَيفِ جُدَّةٍ","عَلى عَجَلٍ يُزجي السَفينَ المُوَقَّرا",4,"ر",2,0],["كَأَنَّ بيضَ المَواضي وَهيَ تَنهَبُهُ","نارٌ تَحَكَّمُ في جِسمٍ مِنَ النورِ",5,"ر",1,0],["كَأَنَّ بِهِ لُغامَ العيسِ باتَت","تُساقِطُهُ عِجالُ الرَجعِ قودُ",6,"د",1,0],["كَأَنَّ بِعَيني بَعدَهُم غائِرَ القَذى","إِذا أَنا لَم أَنظُر إِلى العَلَمِ الفَردِ",7,"د",1,0],["كَأَنَّ بِهِنَّ راعي مُرزِماتٍ","أَبَسَّ فَحَرَّكَ الحورَ الجِلادا",8,"د",2,0],["كَأَنَّ بَني غَبراءَ إِذ يَنهَبونَها","أَحالوا عَلى مالٍ بِذي الدَوحِ سارِحِ",9,"ح",1,0],["كَأَنَّ بِها رَكِيَّةَ مُستَميتٍ","يُخَضخِضُها بُكوراً وَاِدِّلاجا",10,"ج",2,0],["كَأَنَّ بَقاياهُ وَشائِعُ يُمنَةٍ","يُنشِّرُها كَيما يُغالي بِها التَّجرُ",11,"ر",1,0],["كأنّ بقايا نَشْرِها في عِراصِهِ","تَبُثُّ أريجَ المِسْكِ بالجُرَعِ العُفْرِ",12,"ر",1,0],["كأنَّ بِنا مِنْ رَوعةِ البَينِ حَيرَةً","نُحاذِرُ عَيناً أو نُصانِعُ لاحِيا",13,"ي",2,0],["كَأَنَّ بِقَلبي كُلَمّا هاجَ شَوقُهُ","حَراراتِ أَقباسٍ تَلوحُ لِراهِبِ",14,"ب",1,0],["كَأَنَّ بِلادَ اللَهِ ما لَم تَكُن بِها","وَإِن كانَ فيها الخَلقُ قَفرٌ بَلاقِعُ",15,"ع",1,0],["كأن بكَ قد أحْرَزْتَ كلَّ ممَنّعٍ","بَعيدٍ فلمْ يمْنَعْهُ دونَكَ مانِعُ",16,"ع",1,0],["كَأَنْ بالرَّمْلِ مَا بِالصَّخْرِ مِنْ جَلَدٍ","شَوْقاً وَبِالصَّخْرِ مَا بِالرَّمْلِ مِنْ لِينِ",17,"ن",1,0],["كَانَ بِالأَمْسِ وَالِياً مُسْتَطِيلاً","وَهُوَ الْيَوْمَ مَا لَهُ مِنْ وَالِي",18,"ل",2,0],["كأنّ بأفْلاكِ أعْجالِها","سَحاباً بِها قِطَعٌ منْ جَليدْ",19,"د",1,0],["كَانَ بِهِ إِنْ لَمْ تَكُنْ حَازِماً","وَالْوَفْدُ يَبْغِي إِذْنَ حُجَّابِهِ",20,"ب",2,0],["كَأَنَّ بِغِبطانِ الشُرَيفِ وَعاقِلٍ","ذُرا النَخلِ تَسمو وَالسَفينَ المُقَيَّرا",21,"ر",2,0],["كَأَنَّ بِجَوفِهِ أَحشاءَ صَبٍّ","يُؤَجِّجُ نارَها شَوقُ الإِيابِ",22,"ب",1,0],["كانَ بِالبَحرِ إِلَيها ظَمَأٌ","وَعَجيبٌ يَشتَكي البَحرُ الأُواما",23,"م",2,0],["كَأَنَّ بَقاءَ الوَفا بَينَكُم","وَبَيني بَقاءُ حَبابِ الحَيا",24,"ا",1,0],["كَأَنَّ بِها هِراً جَنيباً تَجُرُّهُ","بِكُلِّ طَريقٍ صادَفَتهُ وَمَأزِقِ",25,"ق",1,0],["كأن بناته الكبرى جوار","جوار والسهى فيها غلام",26,"م",1,0],["كأن بناته الصغرى جمان","على لباتها منه نظام",26,"م",1,0],["كَأَنَّ بُغاةَ الخَيرِ عِندَكَ أَصبَحوا","عَلى نَهَجٍ مِن طافِحِ البَحرِ خِضرِمِ",27,"م",1,0],["كَأَنَّ بِنَاءً رَاسِخاً فِي مَكَانِهِ","هَوَى بِشهَابٍ مُحْرِقٍ وَتَهَدَّمَا",28,"م",2,0],["كَانَ بِالأَمْسِ صُورَةً فَتَرَاءتْ","فِي ثَلاثٍ رُوحُ الأَمِيرِ المُهَامِ",29,"م",1,0],["كَأَنَّ بِذِفراها عَنِيَّةَ مُجرِبٍ","لَها وَشَلٌ في قُنفُذِ الليتِ يَنتَحُ",30,"ح",1,1],["كَأَنَّ بَقايا حائِلٍ في مُراحِهِ","لُقاطاتُ وَدعٍ أَو قُيوضُ يَمامِ",31,"م",1,0],["كَأَنَّ بِلادَهُنَّ سَماءُ لَيلٍ","تُكَشَّفُ عَن كَواكِبِها الغُيومُ",32,"م",1,0],["كَأَنَّ بَينَ القُرطِ وَالخَلخالِ","مِنها نَقاً نُطِّقَ في الرِمالِ",33,"ل",1,0],["كأن بروقَ الجو غارتْ وقد أَرتْ","بروجَ قصورٍ شِدتَهُنَّ سواميا",34,"ي",2,0],["كَأَنَّ بَني طُهَيَّةَ رَهطَ سَلمى","حِجارَةُ خارِئٍ يَرمي كِلابا",35,"ب",2,0],["كَأَنَّ بِلادَ اللَهِ وَهيَ عَريضَةٌ","عَلى الخائِفِ المَطلوبِ كِفَّةُ حابِلِ",36,"ل",1,1],["كان بالمُقبل المُغمَّض منه","قبل أفراخ بيضتيه بصيرا",37,"ر",2,0],["كأن بنات في حجراته","نبيطٌ قعود لابساتُ البرانسِ",38,"س",1,1],["كأن بني ذويبة رهط قرد","فراش حول نار يصطلينا",39,"ن",2,0],["كَأَنَّ بَهاءَها لِلناظِريها","مِنَ الأَسَلاتِ وَالبيضِ الفَتينُ",40,"ن",1,0],["كأن بكايَ لي عبدٌ مجيبٌ","فما فرجي إذاً إلاَّ البكاء",41,"ا",2,0],["كأن بقايا ما نضا من كؤسها","أساوِرُ تبرٍ في معاصمِ خُرَّد",42,"د",1,0],["كأنَّ بما في الثغر نظم عقدُه","وإلاَّ بما في العقد نظّم ثغره",43,"ر",2,0],["كأنَّ بني العلياء يوم وفاته","نجومُ سماءٍ خرَّ من بينها البدر",44,"ر",1,0],["كأنَّ بياض الطرس بين سطورها","أياديه في طيِّ السنين الحوالك",45,"ك",1,0],["كأنَّ بابك لم تحفل مواكبه","وبرق بشرك لم يحلب عزَاليكا",46,"ك",2,0],["كان بشيراً بفتىً منكُمُ","بل بربيعٍ منكُم أَخْصبا",47,"ب",2,0],["كان بلا والدٍ ولا ولد","فرداً وحيداً فصار ذا عددِ",48,"د",1,0],["كأن بنات الماء في صرح متنه","إذا ما علا رَوقُ الضحى فترفَّعا",49,"ع",2,0],["كأن بقايا المسك في صحن خدها","بقايا سماد في جدار كنيف",50,"ف",1,0],["كأنَّ بغدادَ لدن أبصرتْ","طلعتَه نائحةٌ تلتدمْ",51,"م",1,0],["كَأَنَّ بِطُبيَيها وَمَجرى حِزامِها","أَداوى تَسُحُّ الماءَ مِن حَوَرٍ وُفرِ",52,"ر",1,0],["كَأَنَّ بَقايا المُحِّ مِن حَيثُ دَرَّجَت","مُفَرَّكُ حُصٍّ في مَبيتَ قِيانِ",53,"ن",1,0],["كَأَنَّ بَناتِ الماءِ في حَجَراتِهِ","أَباريقُ أَهدَتها دِيافُ لِصَرخَدا",54,"د",2,0],["كَأَنَّ بِحاذَيها إِذا ما تَشَذَّرَت","عَثاكيلَ عِذقٍ مِن سُمَيحَةَ مُرطِبِ",55,"ب",1,0],["كَأَنَّ بِقَلبي شاعِراً يَنظُمُ الأَسى","كَأَنّي تَوَلّى مَدمَعي كُلَّ ناثِرِ",56,"ر",1,0],["كَأَنَّ بِهِ لِفَرطِ التيهِ سُكراً","وَقَد لَعِبَت بِعَطفَيهِ المُدامُ",57,"م",1,0],["كَأَنَّ بَقايا لَونِهِ في مُتونِها","بَقايا هَناءٍ في قَلائِصِ مُجرِبِ",58,"ب",1,0],["كَأَنَّ بِرَبعِ الدارِ كُلَّ عَشِيَّةٍ","سَلائِبَ وُرقاً بَينَهُنَّ خَديجُ",59,"ج",1,0],["كَأَنَّ بَقايا الأُثرِ فَوقَ عَمودِهِ","مَدَبُّ الدَبا فَوقَ النَقا وَهوَ سارِحُ",60,"ح",1,0],["كَأَنَّ بَيضَ نَعامٍ في مَلاحِفِها","إِذا اِجتَلاهُنَّ قَيظٌ لَيلُهُ وَمِدُ",61,"د",1,0],["كَأَنَّ بَقايا الجَيشِ جَيشِ اِبنِ باعِجٍ","أَطافَ بِرُكنٍ مِن عَمايَةَ فاخِرِ",62,"ر",1,0],["كَأَنَّ بِكُلِّ رابِيَةٍ وَهَجلٍ","مِنَ الكَتّانِ أَبلاقاً بُنينا",63,"ن",2,0],["كأن بلال نودى قم فأذّن","فرجّ شعاب مكة والبطاحا",64,"ح",2,0],["كانَ بِرَوضٍ غُصُنٌ ناعِمٌ","يَقولُ جَلَّ الواحِدُ المُنفَرِد",65,"د",1,1],["كانَ بِالسَبقِ وَالمَيادينِ أَولى","لَو جَرى الحَظُّ في سَواءِ عَنانِه",66,"ن",2,0],["كَأَنَّ بُناتَهُ رَفَعوا مَناراً","مِنَ الإِخلاصِ أَو نَصَبوا مِثالا",67,"ل",2,0],["كَأَنَّ بِرافِعَ الغاداتِ تَهفو","عَلى وَجَناتِها غَيمٌ وَشَمسُ",68,"س",1,0],["كَأَنَّ بَناتِ نَعشٍ في دُجاها","خَرائِدُ سافِراتٌ في حِدادِ",69,"د",1,0],["كَأَنَّ بَقايا عَنبَرٍ فَوقَ رَأسِها","طُلوعُ رَواعي الشَيبِ في الشَعَرِ الجَعدِ",70,"د",1,0],["كَأَنَّ بَنيهِم عالِمونَ بِأَنَّني","جَلوبٌ إِلَيهِم مِن مَعادِنِهِ اليُتما",71,"م",2,0],["كَأَنَّ بَياضَها وَالراحُ فيها","بَياضٌ مُحدِقٌ بِسَوادِ عَينِ",72,"ن",1,0],["كَأَنَّ بِعَينَيهِ الَّذي جاءَ حامِلاً","بِكَفَّيهِ مِن ناجودِها حينَ يُقطَبُ",73,"ب",1,0],["كَأَنَّ بَياضَ السِنِّ سِنِّ سُمَيرَةٍ","صَبيرٌ يُعَلّى في السَماءِ وَيُرفَعُ",74,"ع",1,0],["كَأَنَّ بِهِ التُفّاحَ غَضّاً جَنَيتُهُ","وَنَشرَ الخُزامى في الصَباحِ تَضَوَّعا",75,"ع",2,0],["كَأَنَّ بِساعِدَيهِ سَوادَ وَرسٍ","إِذا هُوَ فَوقَ أَيدي القَومِ سارا",76,"ر