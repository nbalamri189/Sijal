بعَاً","من النُور ، أو جمرةً تجدح",163,"ح",1,0],["كأنّ بصاقَ الدَّبى، فوقَها","، إذا وقدَتْ، في الأنوف، البُرا",164,"ر",2,0],["كأنَّ بقايا لونهِ في منونها","بَقَايَا هِنَاءٍ في قَلاَئِصِ مُجْرِبِ",165,"ب",1,0],["كأن بنات الماءِ في صرح مَتْنه","تقول إذا راع الرميِّ حفيفُها:",166,"ه",2,0],["كأن برأسي يا أُميم صداعا","وكنت أظن البينَ سهلا فمُذ أتى",167,"ا",1,0],["كأَنّ بهم عن الزمنِ انقطاعا","إذا لمحَ الجديدُ لهم تَوَلَّوْا",168,"ا",1,0],["كَأَنَّ بَنَاتِ الْمَاءِ تَقْرَأُ مَتْنَهَا","صَبَاحاً، وَظِلُّ الغُصْنِ لاَحَ بِها سَطْرُ",169,"ر",1,0]]}