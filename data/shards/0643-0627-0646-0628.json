اغينَ الجُلالَ الجَلَنفَعا",1,"ع",2,0],["كَأَنَّ بُكوراً مِن نَطاةٍ وَخَيبَرٍ","لَها ناحِطٌ مِنهُم رَميضٌ وَناعِرُ",2,"ر",1,0],["كَأَنَّ بِهِ النَوتِيَّ مِن سَيفِ جُدَّةٍ","عَلى عَجَلٍ يُزجي السَفينَ المُوَقَّرا",3,"ر",2,0],["كَأَنَّ بيضَ المَواضي وَهيَ تَنهَبُهُ","نارٌ تَحَكَّمُ في جِسمٍ مِنَ النورِ",4,"ر",1,0],["كَأَنَّ بِهِ لُغامَ العيسِ باتَت","تُساقِطُهُ عِجالُ الرَجعِ قودُ",5,"د",1,0],["كَأَنَّ بِعَيني بَعدَهُم غائِرَ القَذى","إِذا أَنا لَم أَنظُر إِلى العَلَمِ الفَردِ",6,"د",1,0],["كَأَنَّ بِهِنَّ راعي مُرزِماتٍ","أَبَسَّ فَحَرَّكَ الحورَ الجِلادا",7,"د",2,0],["كَأَنَّ بَني غَبراءَ إِذ يَنهَبونَها","أَحالوا عَلى مالٍ بِذي الدَوحِ سارِحِ",8,"ح",1,0],["كَأَنَّ بِها رَكِيَّةَ مُستَميتٍ","يُخَضخِضُها بُكوراً وَاِدِّلاجا",9,"ج",2,0],["كَأَنَّ بَقاياهُ وَشائِعُ يُمنَةٍ","يُنشِّرُها كَيما يُغالي بِها التَّجرُ",10,"ر",1,0],["كأنّ بقايا نَشْرِها في عِراصِهِ","تَبُثُّ أريجَ المِسْكِ بالجُرَعِ العُفْرِ",11,"ر",1,0],["كأنَّ بِنا مِنْ رَوعةِ البَينِ حَيرَةً","نُحاذِرُ عَيناً أو نُصانِعُ لاحِيا",12,"ي",2,0],["كَأَنَّ بِقَلبي كُلَمّا هاجَ شَوقُهُ","حَراراتِ أَقباسٍ تَلوحُ لِراهِبِ",13,"ب",1,0],["كَأَنَّ بِلادَ اللَهِ ما لَم تَكُن بِها","وَإِن كانَ فيها الخَلقُ قَفرٌ بَلاقِعُ",14,"ع",1,0],["كأن بكَ قد أحْرَزْتَ كلَّ ممَنّعٍ","بَعيدٍ فلمْ يمْنَعْهُ دونَكَ مانِعُ",15,"ع",1,0],["كَأَنْ بالرَّمْلِ مَا بِالصَّخْرِ مِنْ جَلَدٍ","شَوْقاً وَبِالصَّخْرِ مَا بِالرَّمْلِ مِنْ لِينِ",16,"ن",1,0],["كَانَ بِالأَمْسِ وَالِياً مُسْتَطِيلاً","وَهُوَ الْيَوْمَ مَا لَهُ مِنْ وَالِي",17,"ي",1,0],["كأنّ بأفْلاكِ أعْجالِها","سَحاباً بِها قِطَعٌ منْ جَليدْ",18,"د",1,0],["كَانَ بِهِ إِنْ لَمْ تَكُنْ حَازِماً","وَالْوَفْدُ يَبْغِي إِذْنَ حُجَّابِهِ",19,"ب",2,0],["كَأَنَّ بِغِبطانِ الشُرَيفِ وَعاقِلٍ","ذُرا النَخلِ تَسمو وَالسَفينَ المُقَيَّرا",20,"ر",2,0],["كَأَنَّ بِجَوفِهِ أَحشاءَ صَبٍّ","يُؤَجِّجُ نارَها شَوقُ الإِيابِ",21,"ب",1,0],["كانَ بِالبَحرِ إِلَيها ظَمَأٌ","وَعَجيبٌ يَشتَكي البَحرُ الأُواما",22,"م",2,0],["كَأَنَّ بَقاءَ الوَفا بَينَكُم","وَبَيني بَقاءُ حَبابِ الحَيا",23,"ا",1,0],["كَأَنَّ بِها هِراً جَنيباً تَجُرُّهُ","بِكُلِّ طَريقٍ صادَفَتهُ وَمَأزِقِ",24,"ق",1,0],["كأن بناته الكبرى جوار","جوار والسهى فيها غلام",25,"م",1,0],["كأن بناته الصغرى جمان","على لباتها منه نظام",25,"م",1,0],["كَأَنَّ بُغاةَ الخَيرِ عِندَكَ أَصبَحوا","عَلى نَهَجٍ مِن طافِحِ البَحرِ خِضرِمِ",26,"م",1,0],["كَأَنَّ بِنَاءً رَاسِخاً فِي مَكَانِهِ","هَوَى بِشهَابٍ مُحْرِقٍ وَتَهَدَّمَا",27,"م",2,0],["كَانَ بِالأَمْسِ صُورَةً فَتَرَاءتْ","فِي ثَلاثٍ رُوحُ الأَمِيرِ المُهَامِ",28,"م",1,0],["كَأَنَّ بِذِفراها عَنِيَّةَ مُجرِبٍ","لَها وَشَلٌ في قُنفُذِ الليتِ يَنتَحُ",29,"ح",1,1],["كَأَنَّ بَقايا حائِلٍ في مُراحِهِ","لُقاطاتُ وَدعٍ أَو قُيوضُ يَمامِ",30,"م",1,0],["كَأَنَّ بِلادَهُنَّ سَماءُ لَيلٍ","تُكَشَّفُ عَن كَواكِبِها الغُيومُ",31,"م",1,0],["كَأَنَّ بَينَ القُرطِ وَالخَلخالِ","مِنها نَقاً نُطِّقَ في الرِمالِ",32,"ل",1,0],["كأن بروقَ الجو غارتْ وقد أَرتْ","بروجَ قصورٍ شِدتَهُنَّ سواميا",33,"ي",2,0],["كَأَنَّ بَني طُهَيَّةَ رَهطَ سَلمى","حِجارَةُ خارِئٍ يَرمي كِلابا",34,"ب",2,0],["كَأَنَّ بِلادَ اللَهِ وَهيَ عَريضَةٌ","عَلى الخائِفِ المَطلوبِ كِفَّةُ حابِلِ",35,"ل",1,1],["كان بالمُقبل المُغمَّض منه","قبل أفراخ بيضتيه بصيرا",36,"ر",2,0],["كأن بنات في حجراته","نبيطٌ قعود لابساتُ البرانسِ",37,"س",1,1],["كأن بني ذويبة رهط قرد","فراش حول نار يصطلينا",38,"ن",2,0],["كَأَنَّ بَهاءَها لِلناظِريها","مِنَ الأَسَلاتِ وَالبيضِ الفَتينُ",39,"ن",1,0],["كأن بكايَ لي عبدٌ مجيبٌ","فما فرجي إذاً إلاَّ البكاء",40,"ا",2,0],["كأن بقايا ما نضا من كؤسها","أساوِرُ تبرٍ في معاصمِ خُرَّد",41,"د",1,0],["كأنَّ بما في الثغر نظم عقدُه","وإلاَّ بما في العقد نظّم ثغره",42,"ر",2,0],["كأنَّ بني العلياء يوم وفاته","نجومُ سماءٍ خرَّ من بينها البدر",43,"ر",1,0],["كأنَّ بياض الطرس بين سطورها","أياديه في طيِّ السنين الحوالك",44,"ك",1,0],["كأنَّ بابك لم تحفل مواكبه","وبرق بشرك لم يحلب عزَاليكا",45,"ك",2,0],["كان بشيراً بفتىً منكُمُ","بل بربيعٍ منكُم أَخْصبا",46,"ب",2,0],["كان بلا والدٍ ولا ولد","فرداً وحيداً فصار ذا عددِ",47,"د",1,0],["كأن بنات الماء في صرح متنه","إذا ما علا رَوقُ الضحى فترفَّعا",48,"ع",2,0],["كأن بقايا المسك في صحن خدها","بقايا سماد في جدار كنيف",49,"ف",1,0],["كأنَّ بغدادَ لدن أبصرتْ","طلعتَه نائحةٌ تلتدمْ",50,"م",1,0],["كَأَنَّ بِطُبيَيها وَمَجرى حِزامِها","أَداوى تَسُحُّ الماءَ مِن حَوَرٍ وُفرِ",51,"ر",1,0],["كَأَنَّ بَقايا المُحِّ مِن حَيثُ دَرَّجَت","مُفَرَّكُ حُصٍّ في مَبيتَ قِيانِ",52,"ن",1,0],["كَأَنَّ بَناتِ الماءِ في حَجَراتِهِ","أَباريقُ أَهدَتها دِيافُ لِصَرخَدا",53,"د",2,0],["كَأَنَّ بِحاذَيها إِذا ما تَشَذَّرَت","عَثاكيلَ عِذقٍ مِن سُمَيحَةَ مُرطِبِ",54,"ب",1,0],["كَأَنَّ بِقَلبي شاعِراً يَنظُمُ الأَسى","كَأَنّي تَوَلّى مَدمَعي كُلَّ ناثِرِ",55,"ر",1,0],["كَأَنَّ بِهِ لِفَرطِ التيهِ سُكراً","وَقَد لَعِبَت بِعَطفَيهِ المُدامُ",56,"م",1,0],["كَأَنَّ بَقايا لَونِهِ في مُتونِها","بَقايا هَناءٍ في قَلائِصِ مُجرِبِ",57,"ب",1,0],["كَأَنَّ بِرَبعِ الدارِ كُلَّ عَشِيَّةٍ","سَلائِبَ وُرقاً بَينَهُنَّ خَديجُ",58,"ج",1,0],["كَأَنَّ بَقايا الأُثرِ فَوقَ عَمودِهِ","مَدَبُّ الدَبا فَوقَ النَقا وَهوَ سارِحُ",59,"ح",1,0],["كَأَنَّ بَيضَ نَعامٍ في مَلاحِفِها","إِذا اِجتَلاهُنَّ قَيظٌ لَيلُهُ وَمِدُ",60,"د",1,0],["كَأَنَّ بَقايا الجَيشِ جَيشِ اِبنِ باعِجٍ","أَطافَ بِرُكنٍ مِن عَمايَةَ فاخِرِ",61,"ر",1,0],["كَأَنَّ بِكُلِّ رابِيَةٍ وَهَجلٍ","مِنَ الكَتّانِ أَبلاقاً بُنينا",62,"ن",2,0],["كأن بلال نودى قم فأذّن","فرجّ شعاب مكة والبطاحا",63,"ح",2,0],["كانَ بِرَوضٍ غُصُنٌ ناعِمٌ","يَقولُ جَلَّ الواحِدُ المُنفَرِد",64,"د",1,1],["كانَ بِالسَبقِ وَالمَيادينِ أَولى","لَو جَرى الحَظُّ في سَواءِ عَنانِه",65,"ن",2,0],["كَأَنَّ بُناتَهُ رَفَعوا مَناراً","مِنَ الإِخلاصِ أَو نَصَبوا مِثالا",66,"ل",2,0],["كَأَنَّ بِرافِعَ الغاداتِ تَهفو","عَلى وَجَناتِها غَيمٌ وَشَمسُ",67,"س",1,0],["كَأَنَّ بَناتِ نَعشٍ في دُجاها","خَرائِدُ سافِراتٌ في حِدادِ",68,"د",1,0],["كَأَنَّ بَقايا عَنبَرٍ فَوقَ رَأسِها","طُلوعُ رَواعي الشَيبِ في الشَعَرِ الجَعدِ",69,"د",1,0],["كَأَنَّ بَنيهِم عالِمونَ بِأَنَّني","جَلوبٌ إِلَيهِم مِن مَعادِنِهِ اليُتما",70,"م",2,0],["كَأَنَّ بَياضَها وَالراحُ فيها","بَياضٌ مُحدِقٌ بِسَوادِ عَينِ",71,"ن",1,0],["كَأَنَّ بِعَينَيهِ الَّذي جاءَ حامِلاً","بِكَفَّيهِ مِن ناجودِها حين