6923.html","الخفيف"],[479,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[493,"ومرنان معبسة ضحوك","https://www.aldiwan.net/poem67311.html","الوافر"],[495,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[500,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[500,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[506,"من كبرت عن قدره خطة","https://www.aldiwan.net/poem2431.html","السريع"],[514,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[514,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[514,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[514,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[514,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[536,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[553,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[558,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[575,"شمس بغير الليل لم تحجب","https://www.aldiwan.net/poem2913.html","السريع"],[586,"نمت بما تحنو عليه ضلوعه","https://www.aldiwan.net/poem17586.html","الكامل"],[586,"ما لامه عليكم عذوله","https://www.aldiwan.net/poem17654.html","الرجز"],[586,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[586,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"]],"verses":[["مُغيرٌ لا يُفادي بِالأَسارى","وَسابٍ لا يَمُنُّ عَلى السَبايا",0,"ا",3,0],["مُغَفَّلٌ عَن هُمومي في بُلَهنِيَةٍ","أَرعى النُجومَ وَطَرفاهُ قَريرانِ",1,"ن",1,0],["مُغرَورِقاتِ المَآقي كُلَّما نَظَرَت","بَرقاً يُضيءُ كِفافَ الغُرِّ وَالجونِ",2,"ن",1,0],["مُغرىً بِنَزعِ قَوادِمي مُستَعذِباً","لِتَأَلُّمي مِن صَرفِهِ وَتَوَجُّعي",3,"ع",2,0],["مَغاويرُ في الجُلّى مَغابيرُ لِلحِمى","مَفاريجُ لِلغُمى مَداريكُ لِلوِترِ",4,"ر",1,0],["مِغوارُ قَومٍ يَروعُ المَوتُ مِن يَدِهِ","أَمسى وَأَصبَحَ نَهباً لِلمَغاويرِ",5,"ر",1,0],["مَغاويرُ لا مَيلٌ تُثَنّي رِقابَها","وَلا بِكَسالى أَوهَنَتها سِناتُها",6,"ت",3,0],["مُغفٍ وَلَيسَ لِلَذَّةٍ إِغفاؤُهُ","مُغضٍ وَلَيسَ لِفِكرَةٍ إِغضاؤُهُ",7,"ا",3,0],["مَغارِسُ طالَت في رُبى المَجدِ وَاِلتَقَت","عَلى أَنبِياءِ اللَهِ وَالخُلَفاءِ",8,"ا",2,0],["مَغاويرُ منْ أبناءِ بَهْرامَ ذادَةٌ","بهِمْ تُلْقَحُ الهَيْجاءُ بعدَ حِيالِ",9,"ل",1,0],["مَغاويرُ والهَيجاءُ تُلقي قِناعَها","مَغازيرُ والغَبْراءُ يُلْوي بِها القَحْطُ",10,"ط",1,0],["مُغاضِبٌ لَيسَ إِلّا اللَهُ يُجبِرُهُ","عَلى الرِضى وَلَهيبي مِنهُ مُستَعِرُ",11,"ر",1,0],["مُغيثٌ ودَعْوَى المُذْنِبينَ خَطيئَتي","ونَفْسي نَفْسي والشّهودُ الجَوارِحُ",12,"ح",1,0],["مُغرَمٌ بِالعودِ وَالنايِ مَعاً","مولَعٌ بِالشُربِ وَالناسُ هُجود",13,"د",1,0],["مَغيمٍ وَلَكِن مِن سَنا الراحِ مُشمِسِ","إِذا ما بَدَت في كَأسِها تَتَلَألَأُ",14,"ل",2,0],["مُغَرَّثَةً زَرقا كَأَنَّ عُيونَه","مِنَ الذَمرِ وَالإِيحاءِ نُوّارُ عِضرِسِ",15,"س",1,0],["مَغاني دِيارٍ لا تَزالُ كَأَنَّها","بِأَفنِيَةِ الشُطّانِ رَيطٌ مُضَلَّعُ",16,"ع",1,0],["مَغانٍ يُهَيِّجنَ الحَليمَ إِلى الصِبا","وَهُنَّ قَديماتُ العُهودِ دَواثِرُ",17,"ر",1,0],["مَغْسُولَةً بِدِمَاءِ الفَجْرِ طَالِعَهَا","مِنْ أَدْمُعِ القَطْرِ ذُرٌّ فَوْقَ مَرْجَانِ",18,"ن",1,0],["مَغْرِسٌ أَطْلَعَ النُّبُوغَ وَأَجْنَى ال","رُّوحَ وَالجِسْمَ طَيِّبَاتِ المَجَانِي",19,"ن",2,0],["مُغْنِي الفَقِيرِ مُغِيْثُ","اللَّهِيفِ مُؤْوِي اليَتِيمِ",20,"م",1,0],["مُغارٌ وَمَشزورٌ بَديعان فيهِما","شَناحٍ كَصَقبِ الطائِفِ المُتَنَخَّلِ",21,"ل",1,0],["مُغَمِّضُ أَطرافَ الخُبوتِ إِذا اِكتَسى","مِنَ الآلِ جُلاًّ نازِحُ الماءِ مُقفِرُ",22,"ر",1,0],["مغنىً أنيقاً للحسان وروضة","نبتت بكل عرارة وأقاح",23,"ح",1,0],["مغاوير أبطالٌ مساعير في الوغى","إذا الخيل لم تثبت وَفرَّ أريبها",24,"ب",3,0],["مَغارِمُ المَجدِ يَعتَدُّ المُلوكُ بِها","مَغانِماً في العُلا في طَيِّها نِعَمُ",25,"م",1,0],["مُغرَمٌ مُؤلَمٌ جَريحٌ أَسيرُ","إِنَّ قَلباً يُطيقُ ذا لَصَبورُ",26,"ر",1,1],["مغرى على رغم العواذلِ والعدَى","بشتاتِ أموالٍ وجمعِ ثناء",27,"ا",2,0],["مغيث الرجا والخوف والذل والخطا","ببذل الندى بالأَمن بالجاه بالصفح",28,"ح",1,0],["مغني الأنام فما تعطل عنده","في الحكم غير محاضر الإفلاس",29,"س",1,0],["مغرف في العلى لماضيه يتلو","وثناه على البسيطة يتلى",30,"ل",2,0],["مغبرُّ الخلق شديد الأيدي","يبني على الكسرِ حروف الصيدِ",31,"د",1,0],["مغلوبةً في الدَّن مسلوبةً","لها انتصارٌ غالبٌ سالبُ",32,"ب",1,0],["مغانٍ لم يكن يصبو","إليهن ذَوُو الحجر",33,"ر",1,0],["مغَفَّلٌ عن أمور نسوته","مُذْلٍ على بيت خبزِهِ حَرَسَهْ",34,"س",2,0],["مغفل حين يُستعفَى وتحسبه","عند انتقاد وجوه الناس صرّافا",35,"ف",2,0],["مُغرماً بالأيورِ كَهْلاً وطفلاً","مُنْذُ داواكَ مصُّها من عُطاشِك",36,"ك",1,0],["مغنيةٌ حقاً بإسقاطِ نقطةٍ","إذا ما شَدَتْ ظلَّتْ وأشداقُها تُلْوَى",37,"و",2,1],["مَغاوِرٌ بَل صَحارى","بَل أَكهُفٌ بَل قُبورُ",38,"ر",1,0],["مُغَمَّرُ العَيشِ يَأفوفٌ شَمائِلُهُ","تَأبى المَوَدَّةَ لا يُعطي وَلا يَسَلُ",39,"ل",1,0],["مُغَرِّبُ آدَمٍ مِن دارِ عَدنٍ","قَضاها في حِماكِ لِيَ اِغتِرابا",40,"ب",2,0],["مَغارِمٌ وَضَحايا ما صَرَخنَ وَلا","كُدِّرنَ بِالمَنِّ أَو أُفسِدنَ بِالكَذِبِ",41,"ب",1,0],["مَغاني الشَعبِ طيباً في المَغاني","بِمَنزِلَةِ الرَبيعِ مِنَ الزَمانِ",42,"ن",1,1],["مغَمِّضٌ طولَ الدُّجَى ناعِسٌ","جُفونُه تُفْتَحُ في الشَّمْسِ",43,"س",1,0],["مغروسةً في مجلسٍ","ضَنْكٍ بمرأى عجبِ",44,"ب",1,0],["مُغَطّىً عَلى الأَعداءِ ما يَقدُرونَهُ","بِعَزمٍ وَقَد غَوّى مِنَ الأَمرِ ما غَوّى",45,"و",2,0],["مَغارِمُ يُسلى في تَرادُفِها الصِبا","وَيُتلَفُ في أَضعافِها الرَشَأُ الأَحوى",45,"و",2,0],["مَغموسَةٍ في النَصرِ تَشدو عَن يَدٍ","مَملوأَةٍ ظَفَراً تَروحُ وَتَغتَدي",46,"د",2,0],["مُغِذٌّ إِلى الدينَورِ تَحتَ عَجاجَةٍ","تَزاءَرُ في غابِ الرِماحِ أُسودُها",47,"د",3,0],["مَغنى مَنازِلِها الَّتي بِمُشَقَّرِ","مَرَّت عَلَيهِ جَنوبُ غَيثٍ مُمطِرٍ",48,"ر",1,1],["مَغاني سُلَيمى بِالعَقيقِ وَدورُها","أَجَدَّ الشَجى إِخلاقُها وَدُثورُها",49,"ر",3,1],["مَغنى سُرورٍ بِالسَعدِ تُنزِلُهُ","وَدارُ أُنسٍ بِاليُمنِ تَعمُرُها",50,"ر",3,0],["مُغلَقٍ بابُهُ عَلى جَبَلِ القَب","قِ إِلى دارَتَي خِلاطَ وَمُكسِ",51,"س",1,0],["مُغلَ رِقابَ المَكرُماتِ بِسُؤدَدٍ","يَبتاعُهُ أَو سُؤدَدٍ يَستامُهُ",52,"م",2,0],["مُغَنّيكَ لِلبُغضِ فيهِ سِمَه","تَلوحُ عَلى خِلقَةٍ مُبهَمَه",53,"م",2,1],["مُغرَمٌ بِالمُدامِ أُترِعُ كَأساً","ساطِعاً ضَوءُها وَأَنزِفُ دَنّا",54,"ن",2,0],["مَغانٍ لِوَحشٍ تَصيدُ القُلو","بَ عُيونُ مَهاهُ وَغِزلانِهِ",55,"ن",2,0],["مُغامِسُ حَربٍ ماتَزالُ جِيادُهُ","مُطَلَّحَةً مِنها حَسيرٌ وَظالِعُ",56,"ع",1,0],["مغان للهوى خلعت عليها","يد الأنواء من زهر برودا",57,"د",2,1],["مغيب الأخبث في التراب","يروع فأر البيت في النقاب",58,"ب",1,0],["مُغضي الجُفونِ على هيفاءَ ساميةٍ","قد وشَّحَته ظُباةُ المشرَفيِّ دَما",59,"م",2,0],["مُغيرانِ لو طافَا على حينِ غفلَةٍ","من الناسِ بالبيتِ الحرامِ لأحرَما",60,"م",2,0],["مُغْرَمٌ بالدُّنُوِّ بعدَ التَّنائي","والتَّلاقي من بعدِ وَشكِ الفِراقِ",61,"ق",1,0],["مُغْضٍ وليسَ لِحاظُه إن بَثَّها","إلا حياةً غَضَّةً وحُتوفا",62,"ف",2,0],["مُغرىً بسُمرِ الخَطِ لا سُمرِ المَها","بأساً وبِيضِ الهِندِ لا بِيضِ العَرَبْ",63,"ب",1,0],["مُغْضٍ على ذُلِّ الحجابِ يَرُدُّه","دامي الجبينِ تَجهُّمُ الحُجَّابِ",64,"ب",1,0],["مَغانِمُ صَفوِ العَيشِ أَسنى المَغانِمِ","هِيَ الظِلَّ إِلّا أَنَّهُ غَيرُ دائِمِ",65,"م",1,1],["مَغاني الحِمى جادَت سَحائِبُ أَدمُعي","عَليكَ إِذا جَفَّت جُفونُ الغَمائِمِ",65,"م",1,0],["مُغرىً بِإِخلافِ المَواعِدِ في الهَوى","يالَيتَهُ جَعَلَ القَطيعَةَ مَوعِدا",66,"د",2,0],["مُغرَمٌ حاوَلَ كِتمانَ الهَوى","وَشُهودُ الدَمعِ لا تَرضى الرُشى",67,"ش",2,0],["مغرمٌ بالعصا فلو خلف سورٍ","لتخطى شواهق الأسوار",68,"ر",1,0],["مُغَرّدةٍ في القُضْبِ تحسَبُ جيدَها","مقلَّدَ طوْقٍ بالجمانِ المُفَصَّلِ",69,"ل",1,0],["مَغْرِبُكَ القبرُ الّذي","يكونُ منه مَطْلَعُك",70,"ك",1,0],["مُغَيّرُ حسني عن جميل رُوائِهِ","وَمُوهِنُ جسمي بالليالي وناهِكُه",71,"ك",2,0],["مَغْنَىً رَعَيْتُ بِهِ الشَّبِيبَةَ غَضَّةً","وَرَوَيْتُ قَلْبِي مِنْ سُلافِ غَمَامِهِ",72,"م",2,0],["مَغْنَى عُلُومٍ تَرَى الأَبْنَاءَ عَاكِفَةً","عَلَى الدُّرُوسِ بِهِ كَالطَّيْرِ فِي الْحَرَمِ",73,"م",1,0],["مَغانِيَ أَطلالٍ وَنُؤياً وَدِمنَةً","أَضَرَّ بِها وَبلٌ وَنَكباءُ زَعزَعُ",74,"ع",1,0],["مُغرىً بِأَغراضٍ تَهولُ بَراعَةً","وَرَفيفِ أَلفاظٍ تَشوقُ رِقاقِ",75,"ق",1,0],["مَغاويرُ لا تُرجى لديهم هَوادةٌ","وفي مصرَ عادٍ يستبيحُ المحرَّما",76,"م",2,0],["مُغفين من فَرْطِ اللُّغوبِ وما درت","تلك الجفونُ لَذاذةَ الإغفاءِ",77,"ا",2,0],["مَغارمُ شَتّى لا تَزالُ تُصِيبُني","إِذا مَغرمٌ مِنها انقَضى جاءَ مَغرَمُ",78,"م",1,0],["مَغانِمُ من عَتَادِ القومِ شَتَّى","تُجاوِزُ حين تُحصِيها الحِسابا",79,"ب",2,0],["مُغبرّةُ الجوِّ ما زال الخفاءُ بها","حتى تَقَنّعَ فيها الموتُ وانتقبا",80,"ب",2,0],["مغرم بالبلادِ صَب ولكنْ","بسوى القول لا يفيضُ غرامُهْ",81,"م",2,0],["مُغَلغَلَةً مَرافِقُها ثِقالاً","إِلى صَنعاءَ مِن فَجٍّ عَميقِ",82,"ق",1,0],["مُغزِلاً تَحنو لِمُستَوسِنٍ","ماثِلٍ لَونَ القَضيمِ التَهام",83,"م",1,0],["مُغضٍ إِذا غَضَّ الزِمامَ خِشاشُهُ","يَفتَرُّ عَن أَنَفٍ فَيَبدُو نابُهُ",84,"ب",2,0],["مُغمَداً في لَيلَةٍ","لا تَرى فيها صُبُح",85,"ح",1,0],["مُغْرىً بِقَتْلِ النَّفْسِ عَمْداً وهْوَ لا","يُعْطَى إلى القَوَدِ القِيادَ ولا الْيَدِ",86,"د",1,0],["مُغامِرٍ يُكنى أَبا كَزّازِ","جَمِّ الوِقاعِ موجَزِ الإيجازِ",87,"ز",1,0],["مَغاويرَ فُرساناً وَجِنّاً إِذا مَشَوا","إِلى المَوتِ إِقدامَ اللُيوثِ الحَوارِدِ",88,"د",1,0],["مُغَفَّلونَ عَنِ الخَيراتِ عِنَدَهُمو","مِن فِطنَةِ الشَرِّ عِلمٌ لَم يَكُن رَشَدا",89,"د",2,0],["مُغَنِّيَةٌ أُعطِيَت مُرغِباً","فَغَنَّت وَ