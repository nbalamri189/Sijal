{"poems":[[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[369,"سلا رسوما أقامت بعد ما ساروا","https://www.aldiwan.net/poem60907.html","البسيط"],[567,"إلى المغارب تسعى الشمس والقمر","https://www.aldiwan.net/poem52883.html","البسيط"],[945,"","https://poetry.dctabudhabi.ae/diwan/poem/146016","الطويل"],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18342","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28609","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136965",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91952","الكامل"]],"verses":[["سلْ أرض يَثْرِبَ عن يهودِ قريظة","وبني النضير، يُجِبْك كيف استُؤْصِلوا",0,"ل",3,0],["سَلا رسوماً أقامتْ بعدَ ما ساروا","أعِندها بمكانِ الحيِّ أخبارُ",1,"ر",1,1],["سل أرضَ مصرَ إذا ما جئتَ ساحتَها","من أينَ فيضُ مياهِ النِّيلِ يُنتَظرُ",2,"ر",1,0],["سلا ربعها أنى استقلت حمولها","وأين استقرت بالعراء خيامها",3,"م",3,0],["سَلا رَبَّةَ الخِدرِ ما شَأنُها","وَمِن أَيِّما شَأنِنا تَعجَبُ",4,"ب",1,1],["سَل أَراك الجَزع هَل جادَت بِهِ","مُزنَةٌ رَوَّت ثَراء مِثلَ جَفني",5,"ن",2,0],["سلْ أرض صفّين كم روَّى روابيها","فيضُ الدِماء بحدِّ البيض والأسل",6,"ل",1,0],["سل أرض أندلس ان كنت تجهلنا","وأهل أندلس عنا بما علموا",7,"م",3,0],["سَل أَرضَهم عن جمعهم","فيما علا وَلمن ترك",8,"ك",1,0]]}