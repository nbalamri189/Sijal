{"poems":[[95,"كتابك في الرشيد كتاب صدق","https://www.aldiwan.net/poem11129.html","الوافر"],[93,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[154,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[369,"وبيت مثل بيت الله فرد","https://www.aldiwan.net/poem60976.html","الوافر"],[396,"عن الناس لا تسأل ولا عن فعالهم","https://www.aldiwan.net/poem54512.html","عموديه"],[396,"عسى نفحة الرحمن تأتي بسرعة","https://www.aldiwan.net/poem54599.html","عموديه"],[406,"وقفة أمام خيام المبعدين","https://www.aldiwan.net/poem6725.html","عموديه"],[545,"غدا بل راح واطرح الخلاجا","https://www.aldiwan.net/poem56879.html","الوافر"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66803","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120004","المنسرح"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138026","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118313","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86575","الطويل"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114907","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117260","الوافر"],[4674,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=207085",""],[4884,"غَدْرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202179",""],[4984,"ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=178841",""],[5008,"ليله مباركه","https://www.poetsgate.com/ViewPoem.aspx?id=27312",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5183,"عبرات الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180253",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5277,"سلامٌ إلى طبّ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200957",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6102,"سَهِيرُ الأَحزان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184416",""],[406,"خيام المبعدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=854&r=&rc=45",""]],"verses":[["عَلَى أَحْدَاثِهِ أَرْسَلْتِ ضَوْءاً","تَغَلْغلَ فِي مَهاوِيهَا السَّحِيقَهْ",0,"ق",2,0],["عَلّي أُحَرِّكُ بِالقَريضِ قُلوبَكُم","إِنَّ القُلوبَ مَواطِنُ الأَهواءِ",1,"ا",2,0],["عَلى أَحمَدٍ مِن رَبِّهِ صَلَواتُهُ","لَقَد عَظُمَت في خَلقِهِ بَرَكاتُهُ",2,"ه",1,0],["على أحوالِ أحداثِ الليالي","له إقدامُ ذِمْرٍ مُستَميت",3,"ت",1,0],["على أحمد المختار والآل كلهم","وأصحابه الغر الكرام الأماثل",4,"ل",1,0],["على أحمد خير البريات كلها","مع الآل والأصحاب في كل لحظة",5,"ه",1,0],["على أحزاننا نمسي ومنه","يكون إذا بدا الفجر اصطباح",6,"ح",1,0],["عَلى أَحداجِ مُكَرَمَةٍ عَوافٍ","تَرَبَّعَتِ اللَقيطَةَ أَو سُواجا",7,"ج",2,0],["على أحمد المختار من نسل هاشمٍ","ومن جاء يروي بالهداية صاديا",8,"ي",2,0],["على احبابَي اعتزموا رحيلا","بلا اوب له حثوا المطايا",9,"ا",3,0],["عليٌّ أحبُّ الناسِ إلاّ محمداً","إليّ فدعني من مَلامِكَ أوْ لُمِ",10,"م",1,0],["على احمرار ينبئك أنَّ بني ال","أصفر أعمامه وأخوالُه",11,"ل",2,0],["عَليُّ أحْمَسُ الأصْحابِ قِدْماً","وأسْمَحُهُمْ بِنَيْلٍ مُسْتَطابِ",12,"ب",1,0],["على احمد كمع الندى وحليفه","ومن هو في الامضاء عضب رسوب",13,"ب",1,0],["عَلى أَحوذيين استَقَلَّت عَشيَةً","فَما هيَ إِلا لمحةٌ وَتَغيبُ",14,"ب",1,0],["على احمد منى صلاة تأيدت","وخير سلام قد أبى العد والحصرا",15,"ر",2,0],["علي أحظى بالفوز فيه وإن","أنجو من ضيقه ومن لهبه",16,"ب",2,0],["على أحمد حق النحيب فإنه","خزانة علم الأولين من العرب",17,"ب",1,0],["على أحد الثغرين ثم تركته","وقد كنت في تأميرهِ غير مُمتري",18,"ر",2,0],["على أحبابه نعم ارتياح","على أعدائه نقم امتحان",19,"ن",1,0],["على أحباب قلبٍ قد تناءوا","وأبقوا في الفؤاد جوى دخيلا",20,"ل",2,0],["على أحجارك انكسر الرجاءُ","فهل في اللوم والشكوى غَناءُ؟!",21,"ا",2,1],["على أحمدَ الحربيِّ دمعي وحرقتي","ودينيَ ذوّادٌ وشعري يدافعُ",22,"ع",1,0],["على أحسن الأحوال لو بلغوا الرضا","محاولة في ركبها جدَّ أخيار",23,"ر",1,0],["علّي أحقق مهجتي واعالج القلب الصويب","ابيه يبقى جانبي حتى باالعمر اشاركه",24,"ك",2,0],["على أحمدٍ والآل والصحب ختمها","أتم صلاة في الضحى والأصائل",25,"ل",1,0],["على أحمد المحمود مني تحية","ترددها الأصداء في الفلوات",26,"ت",1,0],["على أحمد مني التحية ضائعاً","شذاها له في الخافقين هبُوب",27,"ب",1,0],["على أحمد مني السلام تحية","يروح بها روح النسيم مغردا",28,"د",2,0],["على أحمد مني تحية شيق","إلى كل ذي مجد عريق مؤثل",29,"ل",1,0],["على أحمدِ الهادي البشيرِ وقد غدا","على أفقِ هذا الكونِ بدراً تماما",30,"م",2,0],["على أحلامنا، سحقاً لقومٍ","من الأعراب عافوا الاستقامة",31,"م",2,0],["على أحمد الهادي تنزل مجملا","هناك وبالتفصيل عود الشريعة",32,"ه",1,0],["علّي أحظى بشمائلِهم","في «بعضِ» رجالٍٍ أَبْرارِ",33,"ر",1,0],["عَلَى احتِضارِيَ فِي كَفِّ الشُّرُودِ وَ قَدْ","مَضَيتِ عَنِّيَ , فاجتاحَتنِيَ الصُّوَرُ",34,"ر",1,0],["على أحزاننا نمسي ومنها","كون إذا بدا الفجر (الصباح)",35,"ح",1,0]]}