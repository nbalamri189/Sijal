/diwan/poem/123453","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72501","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120549","الوافر"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104488","الكامل"],[4692,"مذ قيل صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=198278",""],[4784,"حياك مياس المعاطف","https://www.poetsgate.com/ViewPoem.aspx?id=170932",""],[4785,"حضن الأم","https://www.poetsgate.com/ViewPoem.aspx?id=129745",""],[4797,"أقول لها .. رد على قطري بن الفجاءة","https://www.poetsgate.com/ViewPoem.aspx?id=29434",""],[4807,"مِدادٌ من شعور","https://www.poetsgate.com/ViewPoem.aspx?id=213614",""],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[4867,"بيان الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=25022",""],[4869,"احتفال اليوم الوطني السعودي في الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151631",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[4978,"تشطير مليك القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177220",""],[5050,"خير الرجال فتى في الهول قد ثبتا","https://www.poetsgate.com/ViewPoem.aspx?id=38203",""],[3591,"إذا ما أنشدت أهلي دمائي","https://www.poetsgate.com/ViewPoem.aspx?id=149383",""],[5183,"مُلْغِزَه رق73م","https://www.poetsgate.com/ViewPoem.aspx?id=186395",""],[5183,"قرينة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=186604",""],[5183,"روضة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=180198",""],[5213,"صنت سمعي عن عاذل فيك لاحي","https://www.poetsgate.com/ViewPoem.aspx?id=170433",""],[5239,"عرس بجزين يا مستعبد النجف","https://www.poetsgate.com/ViewPoem.aspx?id=190941",""],[5281,"حُسنُ الخِتامِ","https://www.poetsgate.com/ViewPoem.aspx?id=200234",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5363,"كحِّل عيونك إن البدر مكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=144466",""],[5458,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=72391",""],[5533,"وَطَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=176873",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5596,"تتابُع الأكدار","https://www.poetsgate.com/ViewPoem.aspx?id=206775",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5756,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=5181",""],[5829,"ودائرة على الباغي تدور","https://www.poetsgate.com/ViewPoem.aspx?id=148335",""],[5848,"فتنة الريم","https://www.poetsgate.com/ViewPoem.aspx?id=48955",""],[5850,"كأنيّ كَسَوْتُ الرَّحْلَ جَوْناً رَبَاعياً","https://www.poetsgate.com/ViewPoem.aspx?id=19718",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5956,"أ هذا جزائي؟","https://www.poetsgate.com/ViewPoem.aspx?id=183251",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[6031,"يا سَيِّداً عَظُمَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46406",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6229,"الوطن المفدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65170&r=&rc=4",""],[6243,"بوح المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84437&r=&rc=11",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""],[5190,"إطلالة على العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78300&r=&rc=13",""]],"verses":[["تَرَبَّصَ أَن يُلقي بِنَجدٍ بَعاعَهُ","وَساقَ إِلى البَيضاءِ عيرَ غَمامِ",0,"م",1,0],["تَربى عَلى رَوضِ الرُبا أَزهارُهُ","وَيَرُفُّ في نادِيَ النَدى ديباجُهُ",1,"ج",2,0],["تَرَبَّعنَ رَوضَ الحَزنِ ما بينَ لَيَّةٍ","وَسَيحانَ مُستَكّاً لَهُنَّ حَدائِقُهُ",2,"ق",2,0],["تَربو بِهِ فينا المَصا","نِعُ وَالمَزارِعُ وَالمَتاجِر",3,"ر",1,0],["تَرَبَّعُ أولاهُ حَجِراتِهِ","جَميعاً وَأُخراهُ تَنوبُ وَتُردِفُ",4,"ف",1,0],["تَرَبَّعَت جانِبَي رَهبى فَمَعقُلَةٍ","حَتّى تَرَقَّصَ في الآلِ القَراديدُ",5,"د",1,0],["تَرَبع في صدر الوزارة كامل","فخَطّ من النُقصان في وجهها حرفا",6,"ف",2,0],["تَرَبَّعَتِ الأَشرافَ ثُمَّ تَصَيَّفَت","حَساءَ البُطاحِ وَاِنتَجَعنَ المَسايِلا",7,"ل",2,0],["تَرَبَّعُ في غَسّانَ أَكفافَ مُحبِلٍ","إِلى الحارِثِ الجَولانِ فَالنَيُّ ظاهِرُ",8,"ر",1,0],["تربَّت بآكام الأسود ترابها","مواقع سحب ما نداها بمنفكّ",9,"ك",1,0],["تَربصتَ بي رَيْبَ المنونِ تجرُّني","على مَطْلك الممدودِ عصراً إلى عصرِ",10,"ر",1,1],["تربّصُ بي عضواً من المال بائراً","عليك وهل عضو من المال بائر",11,"ر",1,0],["تَرَبَّعنا الجَزيرَةَ بَعدَ قَيسٍ","فَأَضحَت وَهيَ مِن قَيسٍ قِفارُ",12,"ر",1,0],["تُربُ أَقدامِكَ عِندي","هُوَ كَالمِسكِ الفَتيقِ",13,"ق",1,0],["تربط العالمين هذا بهذا","حلقات الاثير في جنزير",14,"ر",1,0],["تربيان لها الأبناء صالحة","وتخرجان حماة الدولة النخبا",15,"ب",2,0],["تَرْبا الكلاب بأن يكونَ أباً لهم","ويَرينَ عاراً شدَّةَ الإقراف",16,"ف",1,0],["تربّى في جهنم وهو طفل","فأخرج وهو جبار عنيدُ",17,"د",1,0],["تَرَبَّعَ أَوَّلوهُ مِن دُجَيلٍ","وَدِجلَةَ مَنزِلاً سَهلاً رَحيبا",18,"ب",2,0],["تَرَبَّعتَها فَازدادَ ظاهِرُ حُسنِها","وَأُضعِفَ في لَحظِ العُيونِ ابتِهاجُها",19,"ج",3,0],["تَرَبَّبَتهُ قُرى السَوادِ وَلَم","تُبنَ عَلى أُمَّهاتِهِ مُدُنُه",20,"ن",2,0],["تَرَبَّعَ صارَةً حَتّى إِذا ما","فَنى الدُحلانُ عَنهُ وَالإِضاءُ",21,"ا",2,0],["تَرَبَّص فَإِن تُقوِ المَرَوراةُ مِنهُمُ","وَداراتُها لا تُقوِ مِنهُم إِذاً نَخلُ",22,"ل",1,0],["تَرَبّتْ مع الشمس في عمرها","مُنَقَّلَةً في حُجورِ السّنين",23,"ن",1,0],["تِربٌ لِهِندٍ غادَةٌ","تِلكَ غَزالٌ مُعصِرُ",24,"ر",1,0],["تِربُ الإِساءَةِ لَم يَحمِل لِأُمَّتِهِ","غَيرَ العُقوقِ وَلَم يَهمِم بِإِحسانِ",25,"ن",1,0],["تَرَبَّعَ وَعسَ الأَخرَمَينِ وَأَربَلَت","لَهُ بَعدَما صافَت جِواءُ المَكامِنِ",26,"ن",1,0],["تَرَبَّعنَ غَورَ الأَرضِ حَتّى إِذا بَدَت","مِنَ النَجمِ أَرواحٌ ذَواتُ حَرُورِ",27,"ر",1,0],["تِربانِ قَد كُسِيا المَلامَةَ كُلَّها","وَغَذاهُما في نِعمَةٍ أَبَواهُما",28,"م",2,0],["تَرَبَّعَتِ القُفَّينِ في الشَولِ تَرتَعي","حَدائِقَ مَوليِّ الأَسِرَّةِ أَغيَدِ",29,"د",1,0],["تَرَبُّعُهُ مِرباعُها وَمَصيفُها","مِياهٌ مِنَ الأَشرافِ يُرمى بِها الحَجَل",30,"ل",1,0],["تربع من رمان حول مويسل","إلى قرن ظبي عامدا مستزيدا",31,"د",2,0],["تَرَبَّيتُهُ لَم أَلهَ عَن ثَغَباتِهِ","فَتُبِصرُهُ عَينٌ إذا شيرَ ضائِعا",32,"ع",2,0],["تَرُبُّ الْفَتَى حَتَّى إِذَا تَمَّ أَمْرُهُ","دَهَتْهُ كَمَا رَبَّ الْبَهِيمَة جَازرُ",33,"ر",1,0],["تَرِبَت يَدا مَن عانَهُ فَأَعانَهُ","في أَقعَسِ العِزّ المَنيعِ فَأَقعَصا",34,"ص",2,0],["تربص الوغد من عثمان قتلته","فقام ينهق بين الحمر والبقر",35,"ر",1,0],["تربع الآنس من أرجائها","واستأنست بها الظباء والها",36,"ا",1,0],["تربّى على الوحل من بدئه","وشاخ على الوحل حيث ابتدا",37,"د",2,0],["تربهُ في جبهة ِ الدهرِ غضونا","فَثَراهُ وَحَصاهُ أَبَداً",38,"د",2,0],["تربَّعُ أولاهُ على حجراتِهِ","جميعاً، وأخراهُ تنوبُ وتُردفُ",39,"ف",1,0],["تربَّع الآنسُ من أرجائها","واستأنست بها الظِّباء والمهَا",40,"ا",1,0],["تربض اسد الغاب في اعتابه","وتطرح الحمل على جدارها",41,"ر",3,0],["تربت يمينُ الدهر غيّب في الثرى","هذي الخصال ويِلكمُ الأخلاقُ",42,"ق",1,0],["تِرْبُ المعالي من له في النَّدَى","بادرةٌ تُخرِسُ سُؤَّالَهْ",43,"ل",2,0],["تَرَبَّعَت بَينَ المَهيدِ وَالأَحَم","في نَفَلٍ غاشٍ وَيَعضيدٍ مُتَم",44,"م",1,1],["تَرَبَّعُ أَكنَافَ الحِمَى وَمَقِيلُها","بتَثلِيثَ مِن ظِلِّ الأَرَاكِ ظَليلُ",45,"ل",1,0],["تَربَّى مع النيلِ حتى رَبا","وصار من الشَّحْم ضخما خِدَبّْ",46,"ب",1,0],["تُربّي لَكُم أَطفالكم في حجورها","وَقَد جَعلَت درسَ الضلالِ لهم درّا",47,"ر",2,0],["تَرَبَّصَ الَيلُ حَتّى قالَ شائِمُهُ","عَلى الرُوَيشِدِ أَو خَرجائِهِ يَدِقُ",48,"ق",1,0],["تُربي عَلى الفَيضِ الكَثيرِ فَواضِلاً","نَفَحاتُ أَيامٍ لَهُ وَمُقاوَمِ",49,"م",1,0],["تربةٌ ضمّنتك ضمت ما تريد","من أصيل في معانيه فريد",50,"د",1,0],["تَرَبَّع كلُّ الحُبِّ في كُلِّ ما أَرى","أَم روحك الكُلِّيِّ هذا السنى الكُلّي",51,"ل",2,0],["تَربّع ليلى بالمُضيّح فالحِمى","وتقتاظُ من بطنِ العَقيقِ السَّواقيا",52,"ي",2,0],["تربك بمتنيها الفرند كأنه","على لبة الحسناء عقد مفصل",53,"ل",1,0],["تربَدُّ حتى احمرَّ واسودَّ فَوقها","فأمطَرها الشؤبوبُ أسودَ أحمرا",54,"ر",2,0],["ترَبّص إحدى الحُسنَيينِ تبسُّلاً","فما عابَهُ ألا يكونَ المُظفَّرا",54,"ر",2,0],["تربيدها ان خاض لج","البحر لا يبقى مفر",55,"ر",1,0],["تَربو على أَترابها حَفَراً","وَتَفوقُ غرَّ لِداتها حُسنا",56,"ن",2,0],["تَرِبَتْ كفُّ امرئٍ ينفضها","من عهودٍ أحكمتْ منها العرى",57,"ر",2,0],["تربصتْ زمناً كي تبتلي مقتي","مصوغة بفمي أم أشعرت خَلَدي",58,"د",2,0],["تَرِبَتْ يدا من يبتغي إذلالَنا","أودى به عادي الغرورِ وَطاحا",59,"ح",2,0],["تُربي لَهُ وَهوَ مَسرورٌ بِغَفلَتِها","طَوراً وَطَوراً تَسَنّاهُ فَتَعتَكِرُ",60,"ر",1,0],["تُربٌ تَعاوَرُها عَواصِفٌ أَربَعٌ","عَفّى مَعارِفَ دُمنَةٍ تَقمامُها",61,"م",3,0],["تَرَبَّعَ أَكنافَ القَنانِ فَصارَةٍ","فَما وانَ حَتّى قاظَ وَهوَ زَهومُ",62,"م",1,0],["تَرَبَّعَ مَيثَ النيرِ حَتّى تَطالَعَت","نُجومُ الثُرَيّا وَاِستَقَلَّت عَبورُها",63,"ر",3,0],["تَرَبَّعَ مِن حَوضٍ قَناناً وَثادِقاً","نِتاجَ الثُرَيّا حَملُها غَيرُ مُخدَجِ",64,"ج",1,0],["تَربِيَةُ الخُدَّامِ هذا بِلا","شَكٍّ فَما يخرُجُ عن لالا",65,"ل",2,0],["تَرَبَّعُ أَذوادي فَما إِن يَروعُها","إِذا شَلَّتِ الأَحياءُ في الرَملِ مَفزَعُ",66,"ع",1,0],["تربُ النَّدى وحَليفُها","أَبَداً عَلى مَرِّ اللَّيالي",67,"ل",2,0],["تربعت من بين دارات القنع","بين لوى الأمعز منها وضبع",68,"ع",1,0],["تربعت من جرع العزاف","فالحزن فالدهنا الى جفاف",69,"ف",1,1],["تَرِبت يدا دهري يعاملني","بالبعد عن وطني وعن تِرْبي",70,"ب",2,0],["تربع بالغابات منها غضنفر","همام جريء بالجحافل زائرُ",71,"ر",1,0],["تِرْب الخطابةِ والمجادَة","والعُلا بجميلِ عَهْدكْ",72,"ك",1,1],["تربعَ حاكماً نظما ونثرا","وعف عن السياسة والطنين",73,"ن",1,0],["تربّعت