{"poems":[[53,"حلفت بها صيد الرؤوس سوام","https://www.aldiwan.net/poem29752.html","الطويل"],[57,"ماذا يخبر ضيف بيتك أهله","https://www.aldiwan.net/poem24714.html","الكامل"],[24,"نفى شعر الرأس القديم حوالقه","https://www.aldiwan.net/poem21873.html","الطويل"],[86,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[35,"تنيل قليلا في تناء وهجرة","https://www.aldiwan.net/poem39130.html","الطويل"],[30,"يا دار مية لم يترك لنا علما","https://www.aldiwan.net/poem29601.html","البسيط"],[88,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[23,"لعمرة بالبطحاء بين معرف","https://www.aldiwan.net/poem21350.html","الطويل"],[72,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[51,"تربصت بي ريب المنون تجرني","https://www.aldiwan.net/poem61999.html","الطويل"],[51,"أظنك مما قد مطلت مثوبتي","https://www.aldiwan.net/poem62907.html","الطويل"],[29,"أعاذل ما عليك بأن تريني","https://www.aldiwan.net/poem6049.html","الوافر"],[70,"مرحبا بالزائر الواصل","https://www.aldiwan.net/poem42790.html","مجزوء الرمل"],[89,"تختفى خلف العالم المنظور","https://www.aldiwan.net/poem44889.html","الخفيف"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[43,"يا آل حيدرة المعفر خدهم","https://www.aldiwan.net/poem10622.html","الكامل"],[62,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[45,"لعمرك ما لإسحاق بن سعد","https://www.aldiwan.net/poem11039.html","الوافر"],[45,"سفاها تمادى لومها ولجاجها","https://www.aldiwan.net/poem62680.html","الطويل"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[80,"رددت الملام على العاذلين","https://www.aldiwan.net/poem31275.html","المتقارب"],[31,"قد هاج قلبي محضر","https://www.aldiwan.net/poem42502.html","مجزوء الرجز"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[40,"لمن طلل بالنعف نعف وقير","https://www.aldiwan.net/poem42313.html","الطويل"],[48,"إني علقت الأحمدين كليهما","https://www.aldiwan.net/poem65244.html","الكامل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21054","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[35,"تنيلُ قليلاً في تناءٍ وهجرة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22050",""],[113,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[133,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[140,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[177,"تربعت بين المهيد والأحم","https://www.aldiwan.net/poem535.html",""],[179,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem58786.html","الطويل"],[183,"أيا سيدا نال أعلى الرتب","https://www.aldiwan.net/poem14086.html","المتقارب"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"جزعت أن شت صرف الحي فانفرقوا","https://www.aldiwan.net/poem54414.html","البسيط"],[193,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[209,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[221,"جمالك هذا أم جمالي فإنني","https://www.aldiwan.net/poem39729.html","الطويل"],[244,"رماني وليلى الأخيلية قومها","https://www.aldiwan.net/poem56330.html","الطويل"],[259,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[283,"البحر يمضع ان به","https://www.aldiwan.net/poem39398.html","مجزوء الكامل"],[295,"لولا ازديارك في الكرى وهنا","https://www.aldiwan.net/poem33143.html","أحذ الكامل"],[296,"لست من همي ولا من كمدي","https://www.aldiwan.net/poem36311.html","عموديه"],[296,"سقيا لمن أضرمت من حبها كبدي","https://www.aldiwan.net/poem36322.html","عموديه"],[296,"أرأيت كيف ذرى الدموع وناحا","https://www.aldiwan.net/poem36810.html","عموديه"],[298,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[320,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[335,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[335,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[335,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[346,"عاف نعم حبا للا سفلة","https://www.aldiwan.net/poem20666.html","السريع"],[361,"جزى الله عوفا من موالي جنابة","https://www.aldiwan.net/poem1704.html","الطويل"],[369,"مثل القضيب على اعتدال","https://www.aldiwan.net/poem57222.html","مجزوء الكامل"],[376,"ينشنه نوشاً بأمثال السطع","https://www.aldiwan.net/poem4566.html","الرجز"],[376,"تربعت من جرع العزاف","https://www.aldiwan.net/poem4570.html","الرجز"],[400,"حي الحمى ومنازل الحب","https://www.aldiwan.net/poem34158.html","الكامل"],[426,"أبرق نراه أم سنا الصبح حاضر","https://www.aldiwan.net/poem41427.html","الطويل"],[450,"ترب الخطابة والمجادة","https://www.aldiwan.net/poem13873.html","مجزوء الكامل"],[451,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[459,"سعد الزمان وكل موسم غبطة","https://www.aldiwan.net/poem15367.html","الكامل"],[462,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[462,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[462,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[462,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[463,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[502,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[502,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[514,"تربعت في مسيات فذي بقر","https://www.aldiwan.net/poem48697.html","البسيط"],[536,"تربعت عرش الشعر في نظر الحق","https://www.aldiwan.net/poem47545.html","عموديه"],[536,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[537,"تربص بها الأيام عل صروفها","https://www.aldiwan.net/poem2046.html","الطويل"],[573,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"]],"verses":[["تَرَبَّصَ أَن يُلقي بِنَجدٍ بَعاعَهُ","وَساقَ إِلى البَيضاءِ عيرَ غَمامِ",0,"م",1,0],["تَربى عَلى رَوضِ الرُبا أَزهارُهُ","وَيَرُفُّ في نادِيَ النَدى ديباجُهُ",1,"ج",2,0],["تَرَبَّعنَ رَوضَ الحَزنِ ما بينَ لَيَّةٍ","وَسَيحانَ مُستَكّاً لَهُنَّ حَدائِقُهُ",2,"ق",2,0],["تَربو بِهِ فينا المَصا","نِعُ وَالمَزارِعُ وَالمَتاجِر",3,"ر",1,0],["تَرَبَّعُ أولاهُ حَجِراتِهِ","جَميعاً وَأُخراهُ تَنوبُ وَتُردِفُ",4,"ف",1,0],["تَرَبَّعَت جانِبَي رَهبى فَمَعقُلَةٍ","حَتّى تَرَقَّصَ في الآلِ القَراديدُ",5,"د",1,0],["تَرَبع في صدر الوزارة كامل","فخَطّ من النُقصان في وجهها حرفا",6,"ف",2,0],["تَرَبَّعَتِ الأَشرافَ ثُمَّ تَصَيَّفَت","حَساءَ البُطاحِ وَاِنتَجَعنَ المَسايِلا",7,"ل",2,0],["تَرَبَّعُ في غَسّانَ أَكفافَ مُحبِلٍ","إِلى الحارِثِ الجَولانِ فَالنَيُّ ظاهِرُ",8,"ر",1,0],["تربَّت بآكام الأسود ترابها","مواقع سحب ما نداها بمنفكّ",9,"ك",1,0],["تَربصتَ بي رَيْبَ المنونِ تجرُّني","على مَطْلك الممدودِ عصراً إلى عصرِ",10,"ر",1,1],["تربّصُ بي عضواً من المال بائراً","عليك وهل عضو من المال بائر",11,"ر",1,0],["تَرَبَّعنا الجَزيرَةَ بَعدَ قَيسٍ","فَأَضحَت وَهيَ مِن قَيسٍ قِفارُ",12,"ر",1,0],["تُربُ أَقدامِكَ عِندي","هُوَ كَالمِسكِ الفَتيقِ",13,"ق",1,0],["تربط العالمين هذا بهذا","حلقات الاثير في جنزير",14,"ر",1,0],["تربيان لها الأبناء صالحة","وتخرجان حماة الدولة النخبا",15,"ب",2,0],["تَرْبا الكلاب بأن يكونَ أباً لهم","ويَرينَ عاراً شدَّةَ الإقراف",16,"ف",1,0],["تربّى في جهنم وهو طفل","فأخرج وهو جبار عنيدُ",17,"د",1,0],["تَرَبَّعَ أَوَّلوهُ مِن دُجَيلٍ","وَدِجلَةَ مَنزِلاً سَهلاً رَحيبا",18,"ب",2,0],["تَرَبَّعتَها فَازدادَ ظاهِرُ حُسنِها","وَأُضعِفَ في لَحظِ العُيونِ ابتِهاجُها",19,"ج",3,0],["تَرَبَّبَتهُ قُرى السَوادِ وَلَم","تُبنَ عَلى أُمَّهاتِهِ مُدُنُه",20,"ن",2,0],["تَرَبَّعَ صارَةً حَتّى إِذا ما","فَنى الدُحلانُ عَنهُ وَالإِضاءُ",21,"ا",2,0],["تَرَبَّص فَإِن تُقوِ المَرَوراةُ مِنهُمُ","وَداراتُها لا تُقوِ مِنهُم إِذاً نَخلُ",22,"ل",1,0],["تَرَبّتْ مع الشمس في عمرها","مُنَقَّلَةً في حُجورِ السّنين",23,"ن",1,0],["تِربٌ لِهِندٍ غادَةٌ","تِلكَ غَزالٌ مُعصِرُ",24,"ر",1,0],["تِربُ الإِساءَةِ لَم يَحمِل لِأُمَّتِهِ","غَيرَ العُقوقِ وَلَم يَهمِم بِإِحسانِ",25,"ن",1,0],["تَرَبَّعَ وَعسَ الأَخرَمَينِ وَأَربَلَت","لَهُ بَعدَما صافَت جِواءُ المَكامِنِ",26,"ن",1,0],["تَرَبَّعنَ غَورَ الأَرضِ حَتّى إِذا بَدَت","مِنَ النَجمِ أَرواحٌ ذَواتُ حَرُورِ",27,"ر",1,0],["تِربانِ قَد كُسِيا المَلامَةَ كُلَّها","وَغَذاهُما في نِعمَةٍ أَبَواهُما",28,"م",2,0],["تَرَبَّعَتِ القُفَّينِ في الشَولِ تَرتَعي","حَدائِقَ مَوليِّ الأَسِرَّةِ أَغيَدِ",29,"د",1,0],["تَرَبُّعُهُ مِرباعُها وَمَصيفُها","مِياهٌ مِنَ الأَشرافِ يُرمى بِها الحَجَل",30,"ل",1,0],["تَرَبَّيتُهُ لَم أَلهَ عَن ثَغَباتِهِ","فَتُبِصرُهُ عَينٌ إذا شيرَ ضائِعا",31,"ع",2,0],["تَرُبُّ الْفَتَى حَتَّى إِذَا تَمَّ أَمْرُهُ","دَهَتْهُ كَمَا رَبَّ الْبَهِيمَة جَازرُ",32,"ر",1,0],["تَرِبَت يَدا مَن عانَهُ فَأَعانَهُ","في أَقعَسِ العِزّ المَنيعِ فَأَقعَصا",33,"ص",2,0],["تربهُ في جبهة ِ الدهرِ غضونا","فَثَراهُ وَحَصاهُ أَبَداً",34,"د",2,0],["تربَّعُ أولاهُ على حجراتِهِ","جميعاً، وأخراهُ تنوبُ وتُردفُ",35,"ف",1,0],["تربض اسد الغاب في اعتابه","وتطرح الحمل على جدارها",36,"ر",3,0],["تربت يمينُ الدهر غيّب في الثرى","هذي الخصال ويِلكمُ الأخلاقُ",37,"ق",1,0],["تِرْبُ المعالي من له في النَّدَى","بادرةٌ تُخرِسُ سُؤَّالَهْ",38,"ل",2,0],["تَرَبَّعَت بَينَ المَهيدِ وَالأَحَم","في نَفَلٍ غاشٍ وَيَعضيدٍ مُتَم",39,"م",1,1],["تَرَبَّعُ أَكنَافَ الحِمَى وَمَقِيلُها","بتَثلِيثَ مِن ظِلِّ الأَرَاكِ ظَليلُ",40,"ل",1,0],["تَربَّى مع النيلِ حتى رَبا","وصار من الشَّحْم ضخما خِدَبّْ",41,"ب",1,0],["تُربّي لَكُم أَطفالكم في حجورها","وَقَد جَعلَت درسَ الضلالِ لهم درّا",42,"ر",2,0],["تَرَبَّصَ الَيلُ حَتّى قالَ شائِمُهُ","عَلى الرُوَيشِدِ أَو خَرجائِهِ يَدِقُ",43,"ق",1,0],["تُربي عَلى الفَيضِ الكَثيرِ فَواضِلاً","نَفَحاتُ أَيامٍ لَهُ وَمُقاوَمِ",44,"م",1,0],["تربةٌ ضمّنتك ضمت ما تريد","من أصيل في معانيه فريد",45,"د",1,0],["تَرَبَّع كلُّ الحُبِّ في كُلِّ ما أَرى","أَم روحك الكُلِّيِّ هذا السنى الكُلّي",46,"ل",2,0],["تَربّع ليلى بالمُضيّح فالحِمى","وتقتاظُ من بطنِ العَقيقِ السَّواقيا",47,"ي",2,0],["تربك بمتنيها الفرند كأنه","على لبة الحسناء عقد مفصل",48,"ل",1,0],["تربَدُّ حتى احمرَّ واسودَّ فَوقها","فأمطَرها الشؤبوبُ أسودَ أحمرا",49,"ر",2,0],["ترَبّص إحدى الحُسنَيينِ تبسُّلاً","فما عابَهُ ألا يكونَ المُظفَّرا",49,"ر",2,0],["تربيدها ان خاض لج","البحر لا يبقى مفر",50,"ر",1,0],["تَربو على أَترابها حَفَراً","وَتَفوقُ غرَّ لِداتها حُسنا",51,"ن",2,0],["تَرِبَتْ كفُّ امرئٍ ينفضها","من عهودٍ أحكمتْ منها العرى",52,"ر",2,0],["تربصتْ زمناً كي تبتلي مقتي","مصوغة بفمي أم أشعرت خَلَدي",53,"د",2,0],["تَرِبَتْ يدا من يبتغي إذلالَنا","أودى به عادي الغرورِ وَطاحا",54,"ح",2,0],["تُربي لَهُ وَهوَ مَسرورٌ بِغَفلَتِها","طَوراً وَطَوراً تَسَنّاهُ فَتَعتَكِرُ",55,"ر",1,0],["تُربٌ تَعاوَرُها عَواصِفٌ أَربَعٌ","عَفّى مَعارِفَ دُمنَةٍ تَقمامُها",56,"م",3,0],["تَرَبَّعَ أَكنافَ القَنانِ فَصارَةٍ","فَما وانَ حَتّى قاظَ وَهوَ زَهومُ",57,"م",1,0],["تَرَبَّعَ مَيثَ النيرِ حَتّى تَطالَعَت","نُجومُ الثُرَيّا وَاِستَقَلَّت عَبورُها",58,"ر",3,0],["تَرَبَّعَ مِن حَوضٍ قَناناً وَثادِقاً","نِتاجَ الثُرَيّا حَملُها غَيرُ مُخدَجِ",59,"ج",1,0],["تَربِيَةُ الخُدَّامِ هذا بِلا","شَكٍّ فَما يخرُجُ عن لالا",60,"ل",2,0],["تَرَبَّعُ أَذوادي