{"poems":[[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[99,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[71,"باسم إله الخلق هذا ما اشترى","https://www.aldiwan.net/poem27989.html","الرجز"],[295,"لا تلم أن هجرت أيام أنسى","https://www.aldiwan.net/poem11670.html","الخفيف"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109131","الرمل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82891","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144064","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4858,"في ذكرى الإسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=29825",""],[6275,"البريق الضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83614&r=&rc=6",""]],"verses":[["ثُمَّ ضايَقتُهُ فَلَم يَبقَ لِلشا","هِ عَلى رُغمِهِ سِوى بَيتَينِ",0,"ن",1,0],["ثم ضاقت بهمه مصر فاشتا","ق لغير الأوطان في الأمصارِ",1,"ر",1,0],["ثم ضجّوا لما رَأوْكَ صحيحاً","والعُلى منك ثَغْرُهُ ذو ابتسامِ",2,"م",1,0],["ثمَّ ضمانُ الدركِ المشهورِ","فيهِ على بائعهِ المذكورِ",3,"ر",1,0],["ثم ضحوا بكل غال ثمين","كي نريح البلاد من كل جبس",4,"س",1,0],["ثم ضع نفسك بالذل له","قبل أن النفس قهراً تَضَعَكْ",5,"ك",1,0],["ثم ضاءَ النور يجلو الظلما","فاهتدى أكثرنا بالقبس",6,"س",1,0],["ثم ضَيَّعتَ أَو نَسيتَ وَما يَن","فَعُ عِلمٌ نسيتَه أَو أَضَعته",7,"ت",2,0],["ثُمَّ ضَمَّتهُ وَأَمّا الزُهَرَه","فَاِنثَنَت تاوي إِلى مَنزِلِها",8,"ه",2,0],["ثمّ ضِعفَ الشّفعِ والوَتْ","رِ وضِعفَ الضِّعف ضِعْفا",9,"ف",2,0],["ثم ضاقت طروسهم عند ذا الحصر","وآلت آلاتهم للفناء",10,"ا",2,0],["ثمّ ضلّ القومُ من بعدهمُ","دبّت الفتنة فيهم والوباء",11,"ا",2,0],["ثم ضاعت في صراع","بين أمواج عتيهْ",12,"ي",2,0]]}