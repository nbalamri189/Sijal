{"poems":[[47,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[215,"وما كانت الآداب إلا طرائفا","https://www.aldiwan.net/poem46293.html","الطويل"],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[518,"يا من تجاوز حد السمع والبصر","https://www.aldiwan.net/poem67747.html","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28089","الطويل"],[3416,"","https://poetry.dctabudhabi.ae/diwan/poem/122184","الوافر"]],"verses":[["وَلَو آذَنَتنا بِالتَحَمُّلِ غُدوَةً","لَشَيَّعَ رَكبٌ بِالدُموعِ حُمولَها",0,"ل",3,0],["ولو أذن الدهر العبوس لبعضها","لأصبحت الأيام ضاحكة الثغر",1,"ر",1,0],["وَلَوْ إِذْ أَقْدَمُوا لاقَوْكَ دُونِي","كَعَهْدِكَ أَحْجَمُوا عَنِّي وَخامَوا",2,"م",3,0],["ولو أذنت وفيها بيننا سقر","لهون الشوق خوض النار في سقر",3,"ر",1,0],["وَلَو آذَنتَنا أُمُّ حِقّةَ إِذ بِنا","شَبابٌ وَإِذ لَم تَرُعنا الرَوائِعُ",4,"ع",1,0],["ولو أذِنوا بحربِهم لحالت","هنالك دُونهم حَربٌ رَدَاحُ",5,"ح",1,0]]}