{"poems":[[3,"وفوارس لي قد علمتهم","https://www.aldiwan.net/poem109.html",""],[79,"يحييك بالريحان والروح من قبر","https://www.aldiwan.net/poem36490.html","الطويل"],[29,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[29,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[87,"سنون تعاد ودهر يعيد","https://www.aldiwan.net/poem63719.html","المتقارب"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[47,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[63,"لما مضى اليوم حميدا فانجرد","https://www.aldiwan.net/poem51690.html","الرجز"],[68,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[107,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85407","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43897","الطويل"],[79,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[119,"سهرنا على ذكر الاحبة يا هند","https://www.aldiwan.net/poem41164.html","عموديه"],[124,"نعد أنفاسه ونحسبها","https://www.aldiwan.net/poem49369.html","المنسرح"],[173,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[391,"ألا حييا الدار المحيل رسومها","https://www.aldiwan.net/poem1842.html","الطويل"],[450,"وإن لنا بالشام لو نستطيعه","https://www.aldiwan.net/poem814.html",""],[519,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[520,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[567,"للشعر في كل عصر مركب خشن","https://www.aldiwan.net/poem52868.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48759","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25323","الرجز"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205466","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50022","المتقارب"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95581","البسيط"],[1639,"","https://poetry.dctabudhabi.ae/diwan/poem/29431","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143889","المتقارب"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46746","السريع"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126523","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205028","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131981","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120450","الطويل"],[4994,"سفر في تفاصيل الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=209153",""],[5046,"أنشكو سقاما.. !","https://www.poetsgate.com/ViewPoem.aspx?id=200960",""],[5242,"رجاء الإله لنا شامل","https://www.poetsgate.com/ViewPoem.aspx?id=125970",""],[307,"القطار","https://www.poetsgate.com/ViewPoem.aspx?id=215236",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5464,"بهمومنا لا بالخمور سكارى","https://www.poetsgate.com/ViewPoem.aspx?id=697",""],[5490,"هل جادك الوجد؟","https://www.poetsgate.com/ViewPoem.aspx?id=176135",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5776,"تبسمْ. ..","https://www.poetsgate.com/ViewPoem.aspx?id=199542",""],[6019,"حروفٌ أسكرها الألمُ","https://www.poetsgate.com/ViewPoem.aspx?id=180144",""],[6093,"نَعُدُّ صَدَّ الهَوى ًدَوْمَاً (اللاحق)","https://www.poetsgate.com/ViewPoem.aspx?id=181547",""],[6211,"أبكي...إنا قتلناه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78230&r=&rc=1",""],[6320,"مَهَاوِي اليَأْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84354&r=&rc=51",""]],"verses":[["نُعدي فَنَطعَنُ في أُنوفِهِمُ","نَختارُ بَينَ القَتلِ وَالغُنمِ",0,"م",1,0],["نُعِدُّ السّيوفَ المشرَفيّةَ والقَنا","ويطرُقُ أمْرُ اللهِ منْ حيثُ لا نَدْري",1,"ر",2,0],["نُعَدُّ لِأَيّامٍ نُعِدُّ لِمِثلِها","فَوارِسَ قَيسٍ دارِعينَ وَحُسَّرا",2,"ر",2,0],["نَعُدُّ تَميمَنا وَتَعُدُّ تَيماً","فَقَد أُرديتَ في اللُجَجِ الغِمارِ",3,"ر",1,0],["نَعُدُّ مَعايباً للغيثِ شتَّى","وما في جودِ كفّك من مَعابِ",4,"ب",1,0],["نَعُدُّ عَلَيهِ الزَمانَ القَريبَ","وَيُحصي عَلَينا الزَمانَ البَعيد",5,"د",1,0],["نُعِدُّ المَشرَفِيَّةَ وَالعَوالي","وَتَقتُلُنا المَنونُ بِلا قِتالِ",6,"ل",1,1],["نَعُدُّ لَكَ السِقايَةَ وَالمُصَلّى","وَأَركانَ البَنِيَّةَ وَالمَقاما",7,"م",2,0],["نعُدُّ للزَّورِ كريماتِ العُدَد","فمثلُنا بمثلِهِنَّ مُستَبِدّ",8,"د",1,0],["نُعِدُّ لَها نَقلَ الفُكاهَةِ وَالحِجى","وَنَجلو عَليها بَهجَةَ النَظمِ وَالنَثرِ",9,"ر",1,0],["نَعُدُّ لِأَيّامِ الوَغى الطِرفَ أَجرَداً","وَنَذخُرُ لِلقَومِ العِدى السَيفَ ماضِيا",10,"ي",2,0],["نعدّ للنار نارا","وَللحَديد حديدا",11,"د",2,0],["نَعُدُّ حُصوناً كلَّ دِرْع وَمِغْفرِ","وتَعدو المنايا في عَرينِ الغَضَنْفرِ",12,"ر",1,1],["نعد الرماح المشرفية والقنى","ويطرق أمر الله من حيث لا ندري",13,"ر",2,0],["نعد نجوم الليل من فرط وجدنا","ويعبث فينا الليل والوجد والعد",14,"د",1,0],["نعد أنفاسه ونحسبها","والليل فيه الظلام يلتطم",15,"م",1,1],["نعُدُّ إِذا نَحنُ اِنتَمَينا أُبُوَّةً","تُوازِنُ هاماتِ الرِجالِ شُسُوعُها",16,"ع",3,0],["نَعُدُّ لها أَماثِلَ من ذَويها","وإن كانتْ تُعَدُّ بلا مِثال",17,"ل",1,0],["نَعُدُّ لِأَيّامِ الحِفاظِ مَكارِماً","فِعالاً وَأَعراضاً صَحيحاً أَديمُها",18,"م",3,0],["نَعدّ لَه الأيّام مِن حبّ ذِكرهِ","وَنُحصي لَه يا تيّحان اللّياليا",19,"ي",2,0],["نَعدُّ العَذارى من دَواهي زمانِنا","وأقتَلُها أحداقُها والمَحاجِرُ",20,"ر",1,0],["نعد لها الأوقات إذ كل مزنة","سواها سراب لا يرجى شرابها",21,"ب",3,0],["نعدُّ في يومِ الوغى أنجبَنا","مَن ضرب القَرْنَ بسيفٍ وطَعَنْ",22,"ن",1,0],["نَعُدُّ منهم ألوفاً ما بها حَسَنٌ","حَتَّى يُصادَفَ منهم واحدٌ حَسَنُ",23,"ن",1,0],["نَعُدُّ مِن آلِكَ الخَليلَ وإسما","عيل سِبطَ الخَليلِ واليَسَعا",24,"ع",2,0],["نعد اللياليَ محمودة","إليك ونرقبها دانيه",25,"ي",2,0],["نَعْدِلُ مَنْ دُون أَبِينَا أُدِّ","لَو أَنَّ يَأجوجَ إِلَينا تُهدي",26,"د",2,0],["نعدد من آثارك الغر جملة","وإن عظمت عن أن يحيط بها الحصر",27,"ر",1,0],["نعدّ الملوك إذا ماعددنا","من الأزد شبانها والكهولا",28,"ل",2,0],["نعدو لأمرك مهما كان من جللٍ","كما عدوت لنا بالروح يا نيل",29,"ل",1,0],["نُعِدُّ لِيَومِ الرَوعِ زَغفاً مُفاضَةً","دِلاصاً وَذا غَربٍ أَحَذَّ ضَروسا",30,"س",2,0],["نعد لهم من الشيزى جفاناً","كأمثال القلات إذا مُلينا",31,"ن",2,0],["نُعِدُّ، لتسبقَهُ، العادياتِ","فيدركنا بيسيرِ الخُطَى",32,"ا",1,0],["نُعِدُّها إِن كادَنا مَعشَرٌ","أَو نزلت حَربٌ بِنا حائِلُ",33,"ل",1,0],["نعدَد ما بين الكرام صفاتهِ","وننشدها فخراً وليس لها عدُّ",34,"د",1,0],["نعدها من جماد وهي مدركة","من وقتنا ما اختفى عنا وما ظهرا",35,"ر",2,0],["نعدد في الشعر آثاره","ونبكي على فقده الموجع",36,"ع",1,0],["نعدُّ ما مرَّ مِن أَيام وَحشتنا","يَوماً فَيَوماً وَيَوم السَبت ننتظرُ",37,"ر",1,0],["نعد صروف الدهر وهي كثيرة","واكثر منها جود راحته الولى",38,"ل",2,0],["نُعِدُّ أفراسنا للحربِ مِنْ ورَقٍ","ونعتلي صَهوةَ الأشعارِ فُرسانا",39,"ن",2,0],["نعد نجوم الكون من طول ليلنا","ويعصر غيمَ الشوق دمعًا حنيننا",40,"ن",2,0],["نعد صوارمنا للعدى","وسيف الإله هو الفاصل",41,"ل",1,0],["نعدو من الموتِ أميالاً ونحسبه","قد غابَ عنّا وبعدُ الموت أشبارُ",42,"ر",1,0],["نعدْ كَرَّةً اخرى ، وأخرى ، فإنّما","هو الوعدُ ، ذات الوعد ،لاما تفنّدا",43,"د",2,0],["نعدو وراء السافحين دماءنا","أن يمنحوا بستاننا أمطارا",44,"ر",2,0],["نعدو لنرتشف السراب ونستقي","ضرع الهجير ونأنف الأنهارا",44,"ر",2,0],["نعدو، تكلّ بنا الأعمارُ لاهثة","وقد تمازجَ منّا الدمعُ والعَرَقُ",45,"ق",1,0],["نعد قول ماتكذب مثايله","راويه أصدق من طيور قطاه",46,"ا",2,0],["نعد مجد الطيبين وفعلهم","واذكار فعل الطيبين طراه",46,"ا",2,0],["نعدّ ثوانينا بأنغامِ طلقةٍ","وتصنيعُ صاروخٍ قياسُ الدقائقِ",47,"ق",1,0],["نَعدُو مَعَ الوقتِ، لا ندري نَهايَتَنا","سَلامةَ العُمرِ أمْ تكبو بنا قدمُ",48,"م",1,0],["نَعُدُّ صَدَّ الهَوى دَوْمَاً","مِنْ غِيرِ ذَنْبٍ جَنَيْنَاهُ",49,"ن",3,1],["نَعْدو منَ الشَّوقِ والأحْزانُ تَسْبقُنا","فالشَّوْقُ قَيْسٌ وبعضُ الحُزْنِ ليلاهُ",50,"ا",2,0],["نَعُدُّ نُجُومَ هَذَا الكَوْنِ ظُهْراً","وَفِي الإِظْلاَمِ نَمْتَقِعُ انْتِظَارا",51,"ر",2,0]]}