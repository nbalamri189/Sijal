{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[55,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[55,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[53,"أراب الدهر حتى ما يريب","https://www.aldiwan.net/poem8498.html","الوافر"],[53,"يا ابن الوزيرين لا مواربة","https://www.aldiwan.net/poem64065.html","المنسرح"],[48,"ألو الفضل في أوطانهم غرباء","https://www.aldiwan.net/poem21990.html","الطويل"],[438,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49997","الطويل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101917","الطويل"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81424","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86396","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136942",""],[4727,"أرابك من زمانك ما يريب","https://www.poetsgate.com/ViewPoem.aspx?id=213230",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[5221,"بوح الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=188995",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5784,"من لا خلاق","https://www.poetsgate.com/ViewPoem.aspx?id=202628",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""]],"verses":[["أَرابَكَ فَاِكتَلَأتَ بِغَيرِ رُمحٍ","كَأَنَّ عَلى عَوامِلِهِ سِراجا",0,"ج",2,0],["أَرابَ الرَدى فَيكُمُ جاهِداً","وَزادَ فَجازَ مَدى أَن يُريبا",1,"ب",2,0],["أَرابَ مِن يَومِكَ ما أَرابا","لازِلتُ أَستَسقي لَكَ السَحابا",2,"ب",2,0],["أَرابَكِ مِن مَشيبي ما أَرابا","وَما هَذا البَياضُ عَلَيَّ عابا",3,"ب",2,1],["أَرَابَنِي أَنَّنِي قَبْلاً بَصُرْتُ بِهِ","مُحَنَّطاً مُدْرَجاً فِي سَودِ أَكْفَانِ",4,"ن",1,0],["أَرَابَ الدهرُ حتى ما يُريبُ","وحتى لا عجيبَ له عجيبُ",5,"ب",1,1],["أرابَ دهري وأنت لي وَزَرٌ","فدافع الريبَ أيها الوَزَر",6,"ر",1,0],["أُرابيكَ في الوِدِّ الَّذي قَد بَذَلتَهُ","فَأُضعِفُ إِن أَجدى إِلَيكَ رِباءُ",7,"ب",3,0],["أَرَابَهُ البانُ إِذ لم يَقْضِ آرابا","فارتدَّ ناظرُهُ المرتادُ مرتابا",8,"ب",2,1],["أرابكِ مي أن صَدَدْتُ تَهَيُّباً","وأني على هذا الصّدود لوامقُ",9,"ق",1,0],["أراب وقلبي قد تعلق في ولا","أبي الحسن الكرار والقلب يعلق",10,"ق",1,0],["أرابك منِّي أنْ أقمتُ بموطن","تجوعُ ضواريه وتشبع حمره",11,"ر",2,0],["أرابها وخط المشيب فالتوت","كأنها لم تك من أوالفي",12,"ف",2,0],["ارابهنَّ هلال لاح في غسقي","ومن سواد يراعي ما يواريه",13,"ي",2,0],["أرابَكَ من زمانك ما يُرِيبُ","فكُلُّ صرُوفِهِ فينا عجيبُ",14,"ب",1,1],["أرابك هذا الدهر في سطواته","وتحطيمه هام الكمي الغضنفر",15,"ر",1,0],["أ رابطة الشموخ ألا أشرأبي","لشمرخة من البلد النضير",16,"ر",1,0],["أرابطة الأحبة ذاك بوحي","وهذا الجمع منقطع النظير",16,"ر",1,0],["ارابني أنني قبلا بصرت به","محنطا مدرجا في سود أفان",17,"ن",1,0],["أرابعةٌ تناديها بخبثٍ","ولا وجهٌ لرابعةٍ تلاقي",18,"ق",2,0],["أُرابطُ لو تُجدي مرابطتي على","( ثغورِ ) القوافي .. أملأُ الشعرَ عسكرَا",19,"ر",2,0]]}