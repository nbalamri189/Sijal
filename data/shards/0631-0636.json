diwan/poem/43806","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54309","الطويل"],[72,"رضيت بالكتب بعد الْقرب فَانْقَطَعت","https://www.poetsgate.com/ViewPoem.aspx?id=189416",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[90,"سلام على أرض الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=178976",""],[33,"ألا أيُّهَا الشَّيْخُ الَّذِي مَا بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=2673",""],[45,"تَعَاطَ الصّبَابَةَ، أوْ عَانِها","https://www.poetsgate.com/ViewPoem.aspx?id=31823",""],[45,"رضيت للدين وللدينا","https://www.poetsgate.com/ViewPoem.aspx?id=31587",""],[45,"ما جَوُّ خَبْتٍ، وَإنْ نأتْ ظُعُنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31881",""],[47,"ندبتَ لحسنِ الصبرِ قلبَ نجيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=14728",""],[85,"خَطَوْنا في الجِهادِ خُطاً فِساحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9644&r=&rc=134",""],[53,"رضينا الظبي من عناق الظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9813&r=&rc=10",""],[87,"رضيتُ منَ الدنيا بما لا أودُّهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23836&r=&rc=98",""]],"verses":[["رَضيتُ بِحُكمِ الدَهرِ فيكَ ضَرورَةً","وَمَن ذا الَّذي يَغدو بِما ساءَ راضِيا",0,"ي",2,0],["رَضيعُ وَلاءٍ لَهُ شُعبَةٌ","مِنَ القَلبِ فَوقَ رَضيعِ اللِبانِ",1,"ن",1,0],["رَضينا وَلَم نَسمَح مِنَ النَيلِ بِالرِضا","وَلَكِن كَثيرٌ لَو عَلِمنا قَليلُها",2,"ل",3,0],["رَضاعي مِنَ الدُنيا المَماتُ فِطامُهُ","وَما نَزَحَ الثَديَ الغَزيرَ رَضيعُ",3,"ع",1,0],["رَضيتُ مِنَ الأَحبابِ دونَ الَّذي يُرضي","وَدايَنتُ مَن تُقضى الدُيونُ وَلا يَقضي",4,"ي",1,1],["رَضوا بِخَيالِ المَجدِ والشَخصُ عِندَه","وَما قيمَةُ الأَعراضِ عِندَ الجَواهِرِ",5,"ر",1,0],["رَضيتُ بِهِ في صَدرِ يَومِ عَجاجِهِ","عَلى شَمسِهِ عارِيَةً مِن سُهوبِهِ",6,"ب",2,0],["رَضينا الظُبى مِن عِناقِ الظِبا","وَضَربَ الطُلى مِن وِصالِ الطَلا",7,"ا",1,1],["رَضِيَت مُصاحَبَةَ البِلى وَاِستَوطَنَت","بَعدَ البُيوتِ قُبورَها وَلُحودَها",8,"د",3,0],["رَضينا بِهِنَّ لِلَذّاتِنا","هُناكَ وَهُنَّ بِنا قَد رَضينا",9,"ن",2,0],["رِضاكَ لرِضْوانِ الإلاهِ مُبَلِّغٌ","وحُبُّكَ ذُخْرٌ في المَماتِ وفي المَحْيا",10,"ي",2,0],["رِضَا الْوَالِدِ الْمَوْلَى أَبِيكَ عَرَفْتَهُ","وَقَدْ أُنْكِرَ الْمَعْرُوفُ مِنْ بَعْدِ عِرْفَانِ",11,"ن",1,0],["رَضِيتَ وَمَنْ لَمْ يَرْضَ بِاللَّهِ حَاكِماً","ضَلاَلاً فَلِلَّهِ الرِّضَا وَلَهُ السُّخْطُ",12,"ط",1,0],["رَضيعُ لِبانِ الصِّدْقِ فوْقَ شِمِلّة","مُضَمَّرةٍ وُسِّدتُ منْ كُورِها مهْدا",13,"د",2,0],["رَضيعَي لِبانٍ ثَديَ أُمٍّ تَحالَفا","بِأَسحَمَ داجٍ عَوضُ لا نَتَفَرَّقُ",14,"ق",1,0],["رَضيتَ لِيَ السَقامَ لِباسَ جِسمٍ","كَحَلتُ الطَرفَ مِنهُ بِالسُهادِ",15,"د",1,0],["رِضاكَ لَنا قَبلَ الطَهورِ مُطَهِّرُ","وَقُربُكَ مِن دونِ البَخورِ مُعَطِّرُ",16,"ر",1,1],["رَضِيَ المَجْدُ أَنْ تُزَفَّ بِهِ","بِنْتُ تُومَا إِلَى ابْنِ زَيْدَانِ",17,"ن",1,0],["رَضيتُ مِنَ الوُدِّ وَالعائِداتِ","وَمِن كُلِّ ما أَمَّلَ الآمِلُ",18,"ل",1,0],["رضيتُ بما تقضي عليَّ وتحكمُ","أُهان فأُقصى أمْ أعزُّ فأُكْرَمُ",19,"م",1,1],["رضعت لبانَ العلم في حِجْرِ النُّهى","فوفَتْ لها فيه ضروعٌ حُفّلُ",20,"ل",1,0],["رضى الله والصفحُ الجميل وعفوُهُ","يُوالي على ذاك الصفيح المنضدِ",21,"د",1,0],["رضيتم بأكفان البلى حللاً لكم","وكنتم أولي الديباج والحلل الحمر",22,"ر",1,0],["رَضِعتُم ثُمَّ سالَ عَلى لِحاكُم","ثُعالَةَ حَيثُ لَم تَجِدوا شَرابا",23,"ب",2,0],["رَضينا أَنَّ سَيبَكَ ذو فُضولٍ","وَأَنَّكَ عَن مَحارِمَنا تَذودُ",24,"د",1,0],["رَضينا بِالخَليفَةِ حينَ كُنّا","لَهُ تَبَعاً وَكانَ لَنا إِماما",25,"م",2,0],["رِضاكَ فَإِن تَضرِب إِذا مارَ عِطفُهُ","يَزِدكَ وَإِن تَقنَع بِذَلِكَ يَدأَبِ",26,"ب",1,0],["رَضيتِ بِأَدنى عَيشِنا وَحَمِدتِنا","إِذا صَدَرَت عَن قارِصٍ وَنَقيعِ",27,"ع",1,0],["رَضُوا بهُجَارَ من كنفي حراءٍ","كمعتاض الأراذل بالمثيل",28,"ل",1,1],["رَضُوا بِخِلاَفٍ المُهتَدِينَ وَفِيهُمُ","مُخَبَّأةٌ أخرَى تُصَانُ وَتُحجَبُ",29,"ب",1,0],["رَضِينَا بدُنيا لا نُرِيدُ فِرَاقَها","على أنَّنَا فيها نَمُوتُ وَنُقتَلُ",30,"ل",1,0],["رَضُوا بِفِعَالِ السَوءِ في أهلِ دينِهم","فقد أيتَمُوا طَوراً عِدَاءً وأثكَلُوا",30,"ل",3,0],["رَضيتُ العاذِلاتِ وَما يَقُلنَه","وَإِن أَصبَحتُ عَصّاءً لَهُنَّه",31,"ن",2,0],["رَضيتُ لِنَفسي كانَ غَيرَ مُوَفَّقٍ","وَلَم تَرضَ نَفسي كانَ غَيرَ نَجيبِ",32,"ب",1,0],["رَضيتُ حُكومَةَ المِرقالِ قَيسٍ","وَما أَخسَستُ إِذ حَكَّمتُ خالي",33,"ي",1,1],["رضيت عن الأيام منذ خدمته","فكلُّ ثيابٍ لي بهِ خلع الرِّضا",34,"ض",2,0],["رَضيتُ وَحَقِّكَ كُلَّ الرِضا","إِذا كانَ يُرضيكَ أَن أُقتَلا",35,"ل",2,0],["رَضيتُ بِصُنعِهِ في كُلِّ حالِ","وَلَستُ بِكارِهٍ ما قَد رَماني",36,"ن",2,0],["رضيتُ لمن يشقى عقاباً شقاءه","وإن لم أكن أرضى له بشفائِهِ",37,"ا",3,0],["رضيتَ إذاً بما لا يرتضيهِ","من القومِ الكريمُ ولا اللبيبُ",38,"ب",1,0],["رضيتَ بوعدك لي نائلاً","إذا شِمْتُ في أفقَيْك السحابا",39,"ب",2,0],["رضا اللّهِ في تلك الحقائب والغنى","جميعاً ألا فوزاً لتلك الحقائبِ",40,"ب",1,0],["رَضِيتُ لتفريق أمواله","يَدَي وارثٍ ليس بالحامدِ",41,"د",1,0],["رضيتُ من منظر بطيف كرىً","يعرو ومن مسمع بمدّكرِ",42,"ر",1,0],["رضىً كسخطٍ ولو قَدِرْتُ لغي","يَرْتُ ونكّرتُ مُنكَر الغيرِ",42,"ر",1,0],["رضيتَ منها بأن تناك وتأ","تيك إذا ما أتتك منحدره",43,"ر",2,0],["رَضيتُ في نصف مُدَّتي بمُلا","قاتك بل رُبعِها بل الخُمُس",44,"س",1,0],["رضيتُ بما ترضى فإن شئتُ مرةً","سواه فلا استنشقْتُ إلا بأجدعا",45,"ع",2,0],["رضاك ظلالٌ جنانيةٌ","وعتبك كاللهب السافع",46,"ع",1,0],["رضيت وإن قذيت بكل شيء","رضيت به ولم أخلق طفيفا",47,"ف",2,0],["رضيت مما كنت أمَّلته","بأجر وراقي وغُرمِ الورق",48,"ق",1,0],["رضِيتُك للخُلّان إلا لِواحدٍ","شهدْتَ له بالفضل في الظَّرفِ والعقلِ",49,"ل",1,0],["رضاعُ بناتِ القلبِ بان بِبَيْنِها","حَمِيداً وم