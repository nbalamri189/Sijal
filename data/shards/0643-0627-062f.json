tps://www.aldiwan.net/poem15443.html","الكامل"],[466,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[481,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[481,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[502,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[538,"أمن طيف سلمى بالبطاح الدمائث","https://www.aldiwan.net/poem23872.html","الطويل"],[540,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[560,"رب موصول هو الناي الذي","https://www.aldiwan.net/poem33891.html","الرمل"],[564,"لو كان للدار نطق سبحت عجبا","https://www.aldiwan.net/poem52855.html","البسيط"],[564,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[564,"قف بالديار وإن شجاك الموقف","https://www.aldiwan.net/poem52939.html","الكامل"],[569,"أدن من الدن بي فداك أبي","https://www.aldiwan.net/poem69456.html","مجزوء البسيط"],[577,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/18198","البسيط"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18076","الطويل"]],"verses":[["كادَت تَقاعَسُ لَو ما كُنتَ قائِدَها","تَقاعُسَ البازِلِ المَجنوبِ في الشَطنِ",0,"ن",1,0],["كَأَدماءِ القِرا نَشَدَت طَلاها","وَما وِجدانُ جازِيَةٍ بَغومِ",1,"م",1,0],["كادَ طَلُّ الدُموعِ يَلتَذُّ لَولا","هَزُّ سَيرِ الرَسيمِ وَالإِعناقِ",2,"ق",1,0],["كادَ يَشفَي بِجنَى ريقَتِهِ","غُلَّةً مَسجورَةً لَولا التُّقَى",3,"ا",1,0],["كادَتْ تَزولُ الرّاسِياتُ لِفَقْدِهِ","حتى أذِنْتَ لهُنَّ في استقْرارِ",4,"ر",1,0],["كادَتْ تَضيقُ بأنفاسي مَسالِكُها","كأنّ مَطلَعَها في الصّدْرِ مَسدودُ",5,"د",1,0],["كادَت تُبَيِّنُ وَحياً بَعضَ حاجَتِنا","لَو أَنَّ مَنزِلَ حَيٍ دارِساً نَطَقا",6,"ق",2,0],["كادَ الزَمانُ لَنا وَلا","عَجَبٌ إِذا كادَ الغَريمُ",7,"م",1,0],["كادَت تُجَنُّ وَقَد جُرِحتَ وَخانَها","صَبرٌ عَلى حَملِ الخُطوبِ جَميلُ",8,"ل",1,0],["كاد الصفاء به يتم لأهلها","لو لم تشب ذاك الصفاء حداد",9,"د",1,0],["كادت صروف الجهل تودي بها","لولا أطباء كبارٌ الحجى",10,"ا",1,0],["كادَت بِها العَينُ تَنبوا ثُمًّ ثَبَّتَها","مَعارِفُ الدَارِ وَالجونُ اليَحاميمُ",11,"م",1,0],["كادَ الهَوى يَومَ سَلمانينَ يَقتُلُني","وَكادَ يَقتُلُني يَوماً بِبَيدانا",12,"ن",2,0],["كادَت تَقَطَّعُ عِندَ ذَلِكَ حَسرَةً","نَفسي وَقَد بَعُدَ الغَداةَ مَزارُ",13,"ر",1,0],["كادَ التَذَكُّرُ يَومَ البَينِ يَشعَفُني","إِنَّ الحَليمَ بِهَذا غَيرُ مَعذورِ",14,"ر",1,0],["كادَ مُجيبُ الخُبثِ تَلقى يَمينُهُ","طَبَرزينَ بَينٍ مِقضَباً لِلمَفاصِلِ",15,"ل",1,1],["كادَت مَخازيهِ تُرديهِ فَأَنقَذَهُ","مِنها بِحُسنِ دِفاعٍ عَنهُ عَمُّكُمُ",16,"م",1,0],["كادت رياحُ الأسى والحزنِ تعكسها","حتى الغصون بها معكوسة العذب",17,"ب",1,0],["كادت تصانيفالورى عنده","تموت للهيبةِ في جلدها",18,"ه",2,0],["كاد يوم الندى يذوب سماحاً","وأكفّ الأنام بالقحط كزه",19,"ز",2,0],["كادت من الذكرى تطير نسوعها","وتقوم من صدري حواني الأضلع",20,"ع",1,0],["كادت عطاياه أن تبقى معطلة","لأن نائلها لم يبق مسكينا",21,"ن",2,0],["كادَت سَرائِرُ سَرّي أَن تُسَرَّ بِما","أَولَيتَني مِن جَميلٍ لا أُسَمّيهِ",22,"ي",2,1],["كادكم معشرٌ وأوهنُ بيتٍ","ما بنَتْه من غزلها العنكبوتُ",23,"ت",1,0],["كادت الأرض تُشَقّى","من دماء وتُسَقّى",24,"ق",2,0],["كاد يهوي من السماء إلى الأر","ض شهاب أضاء غرباً وشرقا",25,"ق",2,0],["كادوا وكدت فأزهقت ما دبَّروا","إحدى هناتك أيما إزهاق",26,"ق",1,0],["كادا يقاسان بالعيدين إذْ وُسِما","بوسمِ يَوْمَيْنِ من أيامِ مَلهاكا",27,"ك",2,0],["كاد يُكدِي بطونَ أيديكمُ البَذْ","لُ ويُحفِي ظهورَها التقبيلُ",28,"ل",1,0],["كاد لولاه ان يلين قضيبٌ","من كثيب على شفير انهيالِ",29,"ل",1,0],["كاد هذا المتابُ يُعْتدُّ إجرا","ماً وبعض المتاب كالإجرام",30,"م",1,0],["كادت الأرضُ يوم ذلك تُفشي","سِرّ بُطنانها إلى الظُهران",31,"ن",1,0],["كاد الرشاءُ الذي أُدلي إليك به","من قبلِ بلِّكَه بالماء يُرويني",32,"ن",2,1],["كادَت تَطُلُّ عُروقُهُ مِن جِلدِهِ","وَتَطُلُّ مَعها شَهوَةٌ لِدِمائي",33,"ا",2,0],["كادَ لَولا مابِهِ مِن عُنفُوان","يَقِفُ الوِرقُ بِه وَالعَندَليب",34,"ب",1,0],["كادَت تَطيرُ سُروراً بَِلنَجاحِ وَقَد","كادَت عَلى الهِندِ تَقضي قَبلَ ذا جَزَعا",35,"ع",2,0],["كادَ أَن يُشبِهَ جِسمي خَصرَهُ","إِنَّما رِقَّتُهُ بي سَقَمُ",36,"م",1,0],["كادَ يَلقى مِنكَ مَصرَعُهُ","وَهُوَ لَم يَبلُغ إِلى الحُلُمِ",37,"م",1,0],["كادَ أَن يَخذِلَ فيهِ","كُلَّ طَودٍ مَنكِباه",38,"ه",1,0],["كادَت تَسّاقَطُ غَيظاً عِندَما عَلِمَت","أَنّي أَأُمُّ الَّتي بِالنَفسِ أَفديها",39,"ي",3,0],["كادَت عُيونُهُمُ بِالبُغضِ تَنطِقُ لي","حَتّى كَأَنَّ عُيونَ القَومِ أَفواهُ",40,"ا",2,0],["كادَ أَن يُتلِفَهُ","لَيتَهُ لَو أَتلَفَه",41,"ف",2,0],["كادَ أَن يَحتَرِقَ القُر","طاسُ مِن نارِ زَفيري",42,"ر",2,0],["كَأَدماءَ هَضماءَ الشَراسيفِ غالَها","عَنِ الوَحشِ رِخوَدُّ العِظامِ نَتيجُ",43,"ج",1,0],["كاد الولي لدين عيسى يهتدي","فيه وكاد المهتدي يستنصر",44,"ر",1,0],["كادَت عُيونُ قَوافينا تُحَرِّكُهُ","وَكِدنَ يوقِظنَ في التُربِ السَلاطينا",45,"ن",2,0],["كادَ مُمتاحَهُ لِسابِقِ جَدوا","هُ يَكونُ الإِصدارُ قَبلَ وُرودِه",46,"د",2,0],["كادَ دُجى اللَيلِ مِن طَلاقَتِهِ","يُقمِرُ وَالأُفقُ ساقِطٌ قَمَرُه",47,"ر",2,0],["كادَت تُنَهنِهُ عَبرَتي عَزَماتُها","لَمّا رَأَت هَولَ الفِراقِ فَظيعا",48,"ع",2,0],["كادَ أَمينَ اللَهِ في نَفسِهِ","وَفي مَواليهِ وَفي مالِهِ",49,"ل",2,0],["كادَ حاكي الهَوى يُعادُ وَكادَ ال","خِلوُ يُؤتى مُلكاً بِخَلوَةِ بالِه",50,"ل",2,0],["كادَ الفُؤادُ تَطيرُ الطائِراتُ بِهِ","مِنَ المَخافَةِ إِذ قالَ اِبنُ أَيّوبِ",51,"ب",1,0],["كادَني مُغرِقاً ورُبَّ غريقٍ","خاضَ للكَيْدِ لُجَّةَ الإغْراقِ",52,"ق",1,0],["كادَتْ ترُدُّ على الحَيا أَعْطَافَهُ","لو لم يُمِلْ أعْطَافَهُنَّ حَياءُ",53,"ا",2,0],["كا دَت حَوافِرُها تُدمي جَحافِلَها","حَتّى تَشابَهَتِ الأَحجالُ بِالرَثَمِ",54,"م",1,0],["كادَ أَن يَقضي فَجَدَّدتُ لَهُ","ذِكرَ سُكّانِ الحِمى فَاِنتَعَشا",55,"ش",2,0],["كَادَ الكميتُ يَنوبُ عَن لَعسِ اللمى","ويسوغُ كالخمر الكُمَيْتِ لذائقِ",56,"ق",1,0],["كادت تروّي غليلَ صبٍّ","فؤاده منه في لهيبِ",57,"ب",1,0],["كادَت لِعِرفانِ النَوى أَلفاظُها","مِن رِقَّةِ الشَكوى تَكونُ دُموعا",58,"ع",2,0],["كادَ أَن يَكتُبَ الهَوى بَينَ عَينَي","هِ كِتاباً هَذا حَبيبُ حَبيبِ",59,"ب",1,0],["كادوا النُبُوَّةَ وَالهُدى فَتَقَطَّعَت","أَعناقُهُم في ذَلِكَ المِضمارِ",60,