"],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"ما الغيثُ يَهمي صَوْبُ إسبالِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32136",""],[45,"خَيرُ يَوْمَيكَ في الهوَى وَاقتِبَالِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32129",""],[91,"بين الكأس والطاس","https://www.poetsgate.com/ViewPoem.aspx?id=53236",""],[91,"رسم سياسي","https://www.poetsgate.com/ViewPoem.aspx?id=53140",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""],[46,"كادتْ سنيَّ، إذا نطقْتُ، تقيمُ لي","https://www.poetsgate.com/ViewPoem.aspx?id=18099",""],[38,"على الدّارِ بالرمانتينِ تعوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=21138",""],[51,"يا بني طاهرٍ طهُرتم وطبتم","https://www.poetsgate.com/ViewPoem.aspx?id=30324",""],[61,"أحوالُ مجدِكَ في العُلّوِّ سَواءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59471&r=&rc=4",""]],"verses":[["كادَت تَقاعَسُ لَو ما كُنتَ قائِدَها","تَقاعُسَ البازِلِ المَجنوبِ في الشَطنِ",0,"ن",1,0],["كَأَدماءِ القِرا نَشَدَت طَلاها","وَما وِجدانُ جازِيَةٍ بَغومِ",1,"م",1,0],["كادَ طَلُّ الدُموعِ يَلتَذُّ لَولا","هَزُّ سَيرِ الرَسيمِ وَالإِعناقِ",2,"ق",1,0],["كادَ يَشفَي بِجنَى ريقَتِهِ","غُلَّةً مَسجورَةً لَولا التُّقَى",3,"ا",1,0],["كادَتْ تَزولُ الرّاسِياتُ لِفَقْدِهِ","حتى أذِنْتَ لهُنَّ في استقْرارِ",4,"ر",1,0],["كادَتْ تَضيقُ بأنفاسي مَسالِكُها","كأنّ مَطلَعَها في الصّدْرِ مَسدودُ",5,"د",1,0],["كادَت تُبَيِّنُ وَحياً بَعضَ حاجَتِنا","لَو أَنَّ مَنزِلَ حَيٍ دارِساً نَطَقا",6,"ق",2,0],["كادَ الزَمانُ لَنا وَلا","عَجَبٌ إِذا كادَ الغَريمُ",7,"م",1,0],["كادَت تُجَنُّ وَقَد جُرِحتَ وَخانَها","صَبرٌ عَلى حَملِ الخُطوبِ جَميلُ",8,"ل",1,0],["كاد الصفاء به يتم لأهلها","لو لم تشب ذاك الصفاء حداد",9,"د",1,0],["كادت صروف الجهل تودي بها","لولا أطباء كبارٌ الحجى",10,"ا",1,0],["كادَت بِها العَينُ تَنبوا ثُمًّ ثَبَّتَها","مَعارِفُ الدَارِ وَالجونُ اليَحاميمُ",11,"م",1,0],["كادَ الهَوى يَومَ سَلمانينَ يَقتُلُني","وَكادَ يَقتُلُني يَوماً بِبَيدانا",12,"ن",2,0],["كادَت تَقَطَّعُ عِندَ ذَلِكَ حَسرَةً","نَفسي وَقَد بَعُدَ الغَداةَ مَزارُ",13,"ر",1,0],["كادَ التَذَكُّرُ يَومَ البَينِ يَشعَفُني","إِنَّ الحَليمَ بِهَذا غَيرُ مَعذورِ",14,"ر",1,0],["كادَ مُجيبُ الخُبثِ تَلقى يَمينُهُ","طَبَرزينَ بَينٍ مِقضَباً لِلمَفاصِلِ",15,"ل",1,1],["كادَت مَخازيهِ تُرديهِ فَأَنقَذَهُ","مِنها بِحُسنِ دِفاعٍ عَنهُ عَمُّكُمُ",16,"م",1,0],["كادت رياحُ الأسى والحزنِ تعكسها","حتى الغصون بها معكوسة العذب",17,"ب",1,0],["كادت تصانيفالورى عنده","تموت للهيبةِ في جلدها",18,"ه",2,0],["كاد يوم الندى يذوب سماحاً","وأكفّ الأنام بالقحط كزه",19,"ز",2,0],["كادت من الذكرى تطير نسوعها","وتقوم من صدري حواني الأضلع",20,"ع",1,0],["كادت عطاياه أن تبقى معطلة","لأن نائلها لم يبق مسكينا",21,"ن",2,0],["كادَت سَرائِرُ سَرّي أَن تُسَرَّ بِما","أَولَيتَني مِن جَميلٍ لا أُسَمّيهِ",22,"ي",2,1],["كادكم معشرٌ وأوهنُ بيتٍ","ما بنَتْه من غزلها العنكبوتُ",23,"ت",1,0],["كادت الأرض تُشَقّى","من دماء وتُسَقّى",24,"ق",2,0],["كاد يهوي من السماء إلى الأر","ض شهاب أضاء غرباً وشرقا",25,"ق",2,0],["كادوا وكدت فأزهقت ما دبَّروا","إحدى هناتك أيما إزهاق",26,"ق",1,0],["كادا يقاسان بالعيدين إذْ وُسِما","بوسمِ يَوْمَيْنِ من أيامِ مَلهاكا",27,"ك",2,0],["كاد يُكدِي بطونَ أيديكمُ البَذْ","لُ ويُحفِي ظهورَها التقبيلُ",28,"ل",1,0],["كاد لولاه ان يلين قضيبٌ","من كثيب على شفير انهيالِ",29,"ل",1,0],["كاد هذا المتابُ يُعْتدُّ إجرا","ماً وبعض المتاب كالإجرام",30,"م",1,0],["كادت الأرضُ يوم ذلك تُفشي","سِرّ بُطنانها إلى الظُهران",31,"ن",1,0],["كاد الرشاءُ الذي أُدلي إليك به","من قبلِ بلِّكَه بالماء يُرويني",32,"ن",2,1],["كادَت تَطُلُّ عُروقُهُ مِن جِلدِهِ","وَتَطُلُّ مَعها شَهوَةٌ لِدِمائي",33,"ا",2,0],["كادَ لَولا مابِهِ مِن عُنفُوان","يَقِفُ الوِرقُ بِه وَالعَندَليب",34,"ب",1,0],["كادَت تَطيرُ سُروراً بَِلنَجاحِ وَقَد","كادَت عَلى الهِندِ تَقضي قَبلَ ذا جَزَعا",35,"ع",2,0],["كادَ أَن يُشبِهَ جِسمي خَصرَهُ","إِنَّما رِقَّتُهُ بي سَقَمُ",36,"م",1,0],["كادَ يَلقى مِنكَ مَصرَعُهُ","وَهُوَ لَم يَبلُغ إِلى الحُلُمِ",37,"م",1,0],["كادَ أَن يَخذِلَ فيهِ","كُلَّ طَودٍ مَنكِباه",38,"ه",1,0],["كادَت تَسّاقَطُ غَيظاً عِندَما عَلِمَت","أَنّي أَأُمُّ الَّتي بِالنَفسِ أَفديها",39,"ي",3,0],["كادَت عُيونُهُمُ بِالبُغضِ تَنطِقُ لي","حَتّى كَأَنَّ عُيونَ القَومِ أَفواهُ",40,"ا",2,0],["كادَ أَن يُتلِفَهُ","لَيتَهُ لَو أَتلَفَه",41,"ف",2,0],["كادَ أَن يَحتَرِقَ القُر","طاسُ مِن نارِ زَفيري",42,"ر",2,0],["كَأَدماءَ هَضماءَ الشَراسيفِ غالَها","عَنِ الوَحشِ رِخوَدُّ العِظامِ نَتيجُ",43,"ج",1,0],["كاد الولي لدين عيسى يهتدي","فيه وكاد المهتدي يستنصر",44,"ر",1,0],["كادَت عُيونُ قَوافينا تُحَرِّكُهُ","وَكِدنَ يوقِظنَ في التُربِ السَلاطينا",45,"ن",2,0],["كادَ مُمتاحَهُ لِسابِقِ جَدوا","هُ يَكونُ الإِصدارُ قَبلَ وُرودِه",46,"د",2,0],["كادَ دُجى اللَيلِ مِن طَلاقَتِهِ","يُقمِرُ وَالأُفقُ ساقِطٌ قَمَرُه",47,"ر",2,0],["كادَت تُنَهنِهُ عَبرَتي عَزَماتُها","لَمّا رَأَت هَولَ الفِراقِ فَظيعا",48,"ع",2,0],["كادَ أَمينَ اللَهِ في نَفسِهِ","وَفي مَواليهِ وَفي مالِهِ",49,"ل",2,0],["كادَ حاكي الهَوى يُعادُ وَكادَ ال","خِلوُ يُؤتى مُلكاً بِخَلوَةِ بالِه",50,"ل",2,0],["كادَ الفُؤادُ تَطيرُ الطائِراتُ بِهِ","مِنَ المَخافَةِ إِذ قالَ اِبنُ أَيّوبِ",51,"ب",1,0],["كادَني مُغرِقاً ورُبَّ غريقٍ","خاضَ للكَيْدِ لُجَّةَ الإغْراقِ",52,"ق",1,0],["كادَتْ ترُدُّ على الحَيا أَعْطَافَهُ","لو لم يُمِلْ أعْطَافَهُنَّ حَياءُ",53,"ا",2,0],["كا دَت حَوافِرُها تُدمي جَحافِلَها","حَتّى تَشابَهَتِ الأَحجالُ بِالرَثَمِ",54,"م",1,0],["كادَ أَن يَقضي فَجَدَّدتُ لَهُ","ذِكرَ سُكّانِ الحِمى فَاِنتَعَشا",55,"ش",2,0],["كَادَ الكميتُ يَنوبُ عَن لَعسِ اللمى","ويسوغُ كالخمر الكُمَيْتِ لذائقِ",56,"ق",1,0],["كادت تروّي غليلَ صبٍّ","فؤاده منه في لهيبِ",57,"ب",1,0],["كادَت لِعِرفانِ النَوى أَلفاظُها","مِن رِقَّةِ الشَكوى تَكونُ دُموعا",58,"ع",2,0],["كادَ أَن يَكتُبَ الهَوى بَينَ عَينَي","هِ كِتاباً هَذا حَبيبُ حَبيبِ",59,"ب",1,0],["كادوا النُبُوَّةَ وَالهُدى فَتَقَطَّعَت","أَعناقُهُم في ذَلِكَ المِضمارِ",60,"ر",1,0],["كادَت تُحَلُّ طُلاهُم مِن جَماجِمِهِم","لَو لَم يَحُلّوا بِبَذلِ الحُكمِ ما عَقَدوا",61,"د",3,0],["كادَتِ المَكرُماتُ تَنهَدُّ لَولا","أَنَّها أُيِّدَت بِخَيرِ أَيادِ",62,"د",1,0],["كادَ حديدٌ براحتيهِ","يذوبُ منْ نارِ وجنتيهِ",63,"ه",1,1],["كادت بنو نعشٍ بها","أَنْ يلحقوا ببناتِ نعشِ",64,"ش",1,0],["كادَ الأَسى يَقضي عَلَيكَ صَبابَةً","وَالوَجهُ مِنكَ لِبَينِ إِلفِكِ كابِ",65,"ب",1,0],["كادَ الغَزالُ يَكونُها","لَولا الشَوى وَنُشوزُ قَرنِه",66,"ه",1,0],["كاد يهفو فَزِدْتَهُ مِنكَ رُوحاً","فَانْثَنى راجِحَ الجلالِ وَقورا",67,"ر",2,0],["كادَت الكَأسُ الَّتي في قُبرصٍ","تُشبهُ الكَأسَ الَّتي في كربلا",68,"ل",2,0],["كادوا بِنَصرِ تَميمٍ لي لِتُلحِقَهُم","فيهِم فَقَد بَلَغوا الأَمرَ الَّذي كادوا",69,"د",3,0],["كادَت تَرِفُّ عَلَيها الطَيرُ مِن طَرَبٍ","لَمّا تَغَنَّت بِتَغرِيدٍ عَلى وَتَرِ",70,"ر",1,0],["كادَ السَحابُ يُطيرُها","لَولا الأَزِمَّةُ وَالحَقائِب",71,"ب",1,0],["كَادَ أَنْ يُغشِيَ العُيونَ سناً مِنْ","هُ لِسِرٍّ فيه حَكَتْهُ ذُكاءُ",72,"ا",2,0],["كادَتْ تَسيلُ معَ المَدائحِ مُهجتي","لوْلا ارتِباطُ النّفسِ بالجُثمانِ",73,"ن",1,0],["كادَت تُساقِطُني رَحلي وَمِيثَرَتي","بِذي المَجازِ وَلَم تُحسِس بِهِ نَعَما",74,"م",2,0],["كادَت سِنّي إِذا نَطَقتُ تُقيمُ لي لَهُ","شَخصاً يُعارِضُ بِالعِظاتِ مُبَكِّتا",75,"ت",2,1],["كادَ العَذابُ مِنَ الخَضراءِ يُمطِرُنا","وَكادَت الأَرضُ تَرغو تَحتَنا ضَجَرا",76,"ر",2,0],["كادَت تَساوى نُفوسُ الناسِ كُلِّهِمُ","في الشَرِّ ما بَينَ مَنبوزٍ وَنَبّازِ",77,"ز",1,1],["كادتْ لها أَنفُسُهُمْ تَجودُ","وكادتِ الأَرضُ بهم تَميدُ",78,"د",1,0],["كادَ لولا أدمُعي أستَغْفِرُ اللْ","لَهَ يَخْفَى حُبُّكُمْ عن مَلَكي",79,"ي",1,0],["كادَ إن زيدَ فيهِ من ليلِ صَبٍّ","ثُلُثَاهُ يُرَى مِنَ الصّبح أضوَا",80,"و",2,0],["كادت نوار ترق عند سماعها","لحديث دمعي عن أسايَ مترجم",81,"م",1,0],["كادت لتمثيله الليالي","تبكي وتستعبر الخطوب",82,"ب",1,0],["كآدمٍ صيغ من ترابٍ","ونفخة الروح شرفته",83,"ه",1,0],["كاد أَنْ يرْجِع مِن لَثْمِي له","وارْتِشَافِي الثَّغْر منه أَدْرَدَا",84,"د",2,0],["كادِحاً أَحسَبُ أَنِّي مُخلَدٌ","جاهِلُ اليَوم وتَيسيري لِغَد",85,"د",1,0],["كَادَتْ تُذِيبُ فُؤادِي نارُ لَوْعَتِهِ","لَوْ لَمْ أَكُنْ مِنْ مَسِيلِ الدَّمْعِ في لُجَجِ",86,"ج",1,0],["كَادَ الصفَاءُ بِه يَتِم لأَهْلِهَا","لوْ لَمْ يَشُبْ ذَاكَ الصَّفَاءَ حِدَاد",87,"د",1,0],["كَادَ يَوْم شيعْتَ فِيهِ يُرِيهِمْ","لَمحَةً مِنْ جَلاَلِ يَوْمِ المَعَادِ",88,"د",1,0],["كَادَ لَوْ لَمْ تُدْرِكْهُ يَهْجُرُ طِرْساً","أَصْبَحَ الحِبْرُ فِيهِ وَهْوَ حِدَادُ",89,"د",1,0],["كَادَتْ تَضِيقُ بِكَ الصُّدُو","رُ لِذَاكَ لَوْلاَ رَحْبُ صَدْرِكُ",90,"ك",1,0],["كادَتْ تَرِيبُ الخَلْقَ لوْ لمْ يَرَوْا","فِي الغِبِّ أَن الْحَقَّ مُسْتظْهَرُ",91,"ر",1,0],["كَادَ رَحْبُ الجَوِّ مِنْ حَشْرَجَةٍ","وَحَوَافِيهِ الرُّبَى يُشْبِهُ قِدْرَا",92,"ر",2,0],["كَادَتْ تَخِفُّ الْبَيْعَة الْكُبْرَى لَهُ","لوَ لَمْ يُثَبِّتْهَا الْغَدَاةَ وَقَارْ",93,"ر",1,0],["كَادَ يَخْشَى سِجَالَكَ المُتَنَبِّي","كَيْفَ حَالُ البَهَاءِ وَابْنُ رَشِيقِ",94,"ق",1,0],["كادَت تَطيرُ مَخافَةً لَو لَم تَكُن","مِن شُرَّعِ الأَرماحِ في أَسدادِ",95,"د",1,0],["كادَ يَموتُ اِشفِهِ بِلَفظٍ","مِن فَمِكَ الطَيِّبِ الضَحوكِ",96,"ك",1,0],["كادت تَدُور مع الكَواكِب دَوْرَها","بالنَّحس آونةً وبالإِسْعاد",97,"د",1,0],["كادت أياديه وهي بيضٌ","تُنسي حُلِيَّ الشبابِ سودا",98,"د",2,0],["كَادَتْ تَزُقُّ يَرَاعي الطَّيْرُ تَحْسَبُهُ","وَقَدْ تَغَنَّى بِشِعْرِي سِنَّ مِنْقَارِ",99,"ر",1,0],["كادَ نداك الطوفان","يعطي العطا من لا كان",100,"ن",1,0],["كادحٌ، ما أترَفَتْهُ نعمةٌ","عَرَكَ الدهرَ طويلاً وبلاهْ",101,"ا",2,0],["كادَتْ تَضِجُّ بأَيديهم معاولُهم","وكَاد يلعنُهُم -إذْ يسقُطُ- الحجر",102,"ر",1,0],["كاد أن يغسل القلوب من الحق","دِ، وَيمحو كوامن الأَضغان",103,"ن",1,0],["كادحٌ في شبابه؛ ما قضى في","مَسْرح اللَّهْو والمِرَاح شبابه",104,"ب",2,0],["كادَ الأعادي لنا يومَ اللقاءِ، ولو","أَنَّا وقفنا لهم صفًّا، لما كادوا",105,"د",3,0],["كادت تحِنُّ لفقدِ وجهِك ساحةٌ","فيه ويُسألُ عن دخولِك باب",106,"ب",1,0],["كادَ الضعيف يشُكُّ في إيمانه","والصبرُ كاد يَشَلُّه استسلام",107,"م",1,0],["كادَ أمِينَ الله في نَفسِهِ","وفي مَوَالي