tps://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[5309,"جاهل الحق بالتعصب فاخر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573784",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6225,"المبدع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71261&r=&rc=17",""],[463,"أمرتجعٌ لي فارطَ العيشِ بالحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60128&r=&rc=184",""],[5555,"مَلاعِبُنَا الأُولَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87420&r=&rc=15",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""],[572,"وزائرٌ والعيونُ هاجعة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9371&r=&rc=228",""],[572,"وَزَائرٍ والعيونُ هاجعة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9452&r=&rc=309",""]],"verses":[["كَأَنَّ شَعاعَ قَرنِ الشَمسِ فيها","إِذا ما فَتَّ عَن فيها الخِتاما",0,"م",2,0],["كَأَنَّ شُجاعَي رَملَةٍ دَرَجا مَعاً","فَمَرّا بِنا لَولا وقوفٌ وَمَنزِلُ",1,"ل",1,0],["كَانَ شَجْوِي إِذَا نَأَى","وَسُرُورِي إِذَا أَلَمْ",2,"م",1,0],["كَأَنَّ شُخوصَ الخَيلِ هامٍ مَكانَها","عَلى جُمَدِ رَهبى أَو شُخوصُ خِيامِ",3,"م",1,0],["كان شهماً إن جئته في الملمّا","ت وَقيذاً أوَيْت ركناً شديدا",4,"د",2,0],["كأن شكل هلال العيد في يده","قوسٌ على مهج الأضداد موتور",5,"ر",1,0],["كأن شباباً كان لي فسُلبتُهُ","كسانيَ منه سالفُ الدهرِ مِعْرضا",6,"ض",2,0],["كان شرخُ الشباب قَرْضَ الليالي","ووراءَ القروض قِدماً تقاضي",7,"ض",2,0],["كَأَنَّ شَوادِخَ الغُرّاتِ مِنهُم","بَوازي يَصطَفِقنَ وَيَلتَقينا",8,"ن",2,0],["كأن شعاعها في الثلج نار","لفارس حولها ضربوا القبابا",9,"ب",2,0],["كأن شعر أمين","من نفح بان ورند",10,"د",1,1],["كانَ شِعري الغِناءَ في فَرَحِ الشَر","قِ وَكانَ العَزاءُ في أَحزانِه",11,"ن",2,0],["كَأَنَّ شُعاعَ عَينِ الشَمسِ فيهِ","فَفي أَبصارِنا مِنهُ اِنكِسارُ",12,"ر",1,0],["كَأَنَّ شِراعاً فيهِ مَثنى زِمامِها","مِنَ الساجِ لَولا خَطمُها وَبَلاعِمُه",13,"م",2,0],["كَأَنَّ شِهابَي قابِسٍ تَحتَ جَبهَةٍ","لَهُ مِن صِلابِ الرَعنِ بَل هُوَ أَجهَمُ",14,"م",1,0],["كأنَّ شَمالاً صافَحَتْ صَفْوَ مائِها","وليسَ إليه للشَّمالِ سَبيلُ",15,"ل",1,0],["كان شن الغارات في البلد القفر","فأضحى على سرير العراق",16,"ق",1,0],["كأنَّ شمسَ الضُّحى تخشاه بارزةً","فَضَوْءُها بحجابِ النَّقعِ مُحتَجِبُ",17,"ب",1,0],["كَأَنَّ شَذا عَرفِها عَنبَرٌ","يُلاثُ بِهِ شارِبُ الشارِبِ",18,"ب",1,0],["كأنّ شعاعَ الشمسِ في الأفقِ إذ جلتْ","به صدأ الإظلام مِدْوَس صَيْقَلِ",19,"ل",1,0],["كأنّ شوكةَ عُنّابٍ بِمِبضَعِها","يُجَرَّعُ السمّ منه مَنْ يصادِفُهُ",20,"ه",1,0],["كَأنّ شُهبَ رجومٍ في أَسِنَّتِهِ","يُرْدي بِها مِن طُغاةِ الكفرِ مَن وَرَدا",21,"د",2,0],["كأنّ شُعاعَ عينِ الشمسِ فيه","وإن كان الفِرِنْدُ به ضَبابا",22,"ب",2,0],["كانَ شَوكَ السَيالِ حُسناً فَأَمسى","دونَهُ لِلفِراقِ شَوكُ القَتادِ",23,"د",1,0],["كَأَنَّ شَبا مِسمارِهِ وَهوَ ناجِمٌ","شَبا نابِ قَرمٍ يَضرِبُ الشُولَ يَصرِفُ",24,"ف",1,0],["كَأَنَّ شِدقَيهِ إِذا تَضَوَّرا","صُدغانِ مِن عَرعَرَةٍ تَفَطَّرا",25,"ر",2,0],["كَأَنَّ شَذراً وَهَت مَعاقِدُهُ","بَينَ صَلاهُ فَمَلعَبِ الشَنَفِ",26,"ف",1,0],["كَأَنَّ شَرارَةً وَقَعَت بِقَلبي","لَها في مُقلَتي وَدَمي اِستِنانُ",27,"ن",1,0],["كَأَنَّ شَذاها العَسجَدِيَّ بِطَبعِهِ","تَضَوَّعَ هِندِيّاً وَأودِعَ فُلفُلا",28,"ل",2,0],["كأن شعاع الشمس في حجراتها","مصابيح رهبان زهتها الفتائل",29,"ل",1,0],["كأن شعري عذراء مفجعة","تبل منها بدمع العين أردانا",30,"ن",2,0],["كأَنَّ شعاع النجم والنجم طالع","يضيء جميلاً بعض أَخلاقه الغر",31,"ر",1,0],["كَأَنَّ شُعَاعَ الشَّمْسِ وَالرِّيحُ رَهْوَةٌ","إِذَا رُدَّ فِيهِ سارِقٌ يَتَرَبَّصُ",32,"ص",1,0],["كانَ شيبي بِهِ شَباباً فَلَمّا","بانَ عَنّي رَدَّ الشَبابَ مَشيبا",33,"ب",2,0],["كان شوقي يُصْغِي وما كان يُصْغِي","هو في عالَمٍ من الفنِّ ثاني",34,"ن",2,0],["كان شوقي وحافظٌ إن دجَى الخط","بُ شعاعيْنِ في الدُّجَى يلمعان",34,"ن",1,0],["كان شَيْخُ المَعَرَّةِ الكَوْكَبَ السَّا","طِعَ في ظُلْمةِ القُرُونِ الْخَوالي",35,"ل",2,0],["كان شبابي رفيقَ عمري","فعشتُ من بعده وحيدا",36,"د",2,0],["كأن شمسَ الشتاء ظبيٌ","من طبعه الدلُّ والنِّفار",37,"ر",1,0],["كانَ شيطانه مريدًا، ولكن","يتراءى للعين غير مريد",38,"د",1,0],["كأنَّ شعوراً بالحياة وعيشة","بها يشتهى طَعْمَ الحياةِ ضرائر",39,"ر",1,0],["كأنَ شعاع الشمس في الأفق إذا جلتْ","به صدأ الإظلام مِدْوَسُ صيقَلِ",40,"ل",1,0],["كأن شواظاً في الجوانح ساطعاً","إذا قلت قد خف التوقد يحجم",41,"م",1,0],["كأن شياطين الدجى في أهابه","تغنني على زمر الرياح وتغرب",42,"ب",1,0],["كان شأني الحفاظ والرعي فالآ","ن أرى الرعي أعظم الأرزاء",43,"ا",2,0],["كَأَنَّ شَبَابَهُم بَينَ النَّوَادِى","إِذَا امتِحُنوا في الإِعرَابِ امتِحَانَا",44,"ن",2,0],["كان شرابي وقِياني بها","دمعي ووُرقا ذات أطواقِ",45,"ق",1,0],["كان شخصا فصار للبول ظرفا","منطويّا تبكي عليه الظروف",46,"ف",1,0],["كانَ شَفيقٌ لم يَزَل مُختَلي","في الجِهَةِ اليُسرى من الهَيكَلِ",47,"ل",1,1],["كَأَنَّ شُعاعَ الزُهر في شاسِعِ الفَضا","سِهامٌ عَلى قَلبِ الوُجودِ مروقُها",48,"ق",3,0],["كانَ شِرايَ لَهُ فَضولاً","فَاِعجَب لِما يَجلِبُ الفُضولُ",49,"ل",1,0],["كان شحيحا بها فؤادي","وطالما احرم الشحيح",50,"ح",1,0],["كأن شعاع النور في قسماتها","شَقائق حسن في رياض خرائد",51,"د",1,0],["كأنَّ شِيَاتِ البُلْقِ تَحْمِل شِرَّةً","لِقَلْبِيَ بلْ أوْضَاحُها تُشهِر البُلْقَا",52,"ق",2,0],["كَأَنَّ شَذاها صِفاتُ المَليكِ ال","مُعَظَّمِ في الناسِ تورانَ شاها",53,"ا",3,0],["كَأَنَّ شُروجَ البِقَّمِ الوَردِ أُبطِنَت","أَساريعَ مِنها ذاقِناتٍ شُقوقُها",54,"ق",3,0],["كَأَنّ شَذاها حينَ هَبَّت شمالها","شَمائل إِسماعيل فاحَ عَبيرها",55,"ر",3,0],["كأنّ شَظايا الصَّخْرِ في كُلِّ نُقْرَةٍ","تَطايَرُ من لاتٍ وعُزَّى ونائل",56,"ل",1,0],["كأنّ شهابَ الدّينِ لما سَرتْ بنا","إليه المطايا تُبدِلُ البُعْدَ بالقُرب",57,"ب",1,0],["كان شهداً لذوقه","أو شراباً مروَّقا",58,"ق",2,0],["كأنَّ شعاع النور من حضراتهم","تشق حشا الظلماء فهي حراب",59,"ب",1,0],["كأنَّ شباكاً ألقيتْ في متونها","فأبقتْ مثالاً فوقها قد تسطرا",60,"ر",2,0],["كَأَنَّ شُعاعَ الشمسِ من نُورِ هَدْيها","وعَرْفَ نسيمِ الروضِ من طِيبِها نَفْحُ",61,"ح",1,0],["كَأَنَّ شعاعَ الشمسِ تَحْتَ عَجَاجِهِ","إِذَا مَا الْتَقَى الجمعانِ سِرٌّ وكاتِمُهْ",62,"م",2,0],["كأنّ شِعري أعدَى معاهدَه","فأعربتْ لي عِراصُها العُجْمُ",63,"م",1,0],["كأنّ شعاعَ النار في وجناتها","يُطيرُ شرارَ النار بين ضلوعي",64,"ع",2,0],["كأنَّ شَبا مَطْرورةٍ فارسيَّةٍ","أصاب فؤادي من حديث المُخبِّرِ",65,"ر",1,0],["كأنَّ شبَاهُ والرُّواةُ تَهُزُّهُ","شبا مرهفٍ أو بأس بدر بن مَعقِل",66,"ل",1,0],["كَأَنَّ شارِبَهُ مِن فَوقِ مَضحَكِهِ","زَبَرجَدٌ يَتَلَألَأُ تَحتَهُ يَقَقُ",67,"ق",1,0],["كأنَّ شذا العِقدِ مِن عَلْوةٍ","وقد نفحتْ سَحَراً فائحُ",68,"ح",1,0],["كأنَّ شُؤُن الغيبِ حَصراً جسامُها","لآلِ عليٍّ من لؤيٍّ ابنِ غالِبِ",69,"ب",1,0],["كان شبابي في الدُّمى وسيلةً","ثمّ اِنقَضتْ لمّا اِنقَضتْ وسائلي",70,"ل",2,0],["كأنّ شوقاً قادها","وهي كمن لم يشتقِ",71,"ق",1,0],["كأنّ شموساً طالعاتٍ خلالَه","وإلّا وَرِيساً من مُلاءٍ تمزّقا",72,"ق",2,0],["كأنّ شحومَ البُزَّلِ الكُومِ وسطها","يطارحه فوّارهنّ صبيرُ",73,"ر",1,0],["كَأَنَّ شارِبيها","في سوقِهِم أَقيادُ",74,"د",1,0],["كَأَنَّ شارِبيها","في سوقِهِم قُيودُ",75,"د",1,0],["كَأَنَّ شَقَائِقَ النُّعْمَانِ فِيْهِ","مُخَضَّرَةً كُؤُوسٌ مِنْ عَقِيْقِ",76,"ق",1,0],["كانَ شَبابي عَدُوَّ حِلمي","فَصارَ شَيبي عَدُّوَ جَهلي",77,"ل",2,0],["كأنَّ شعلةَ نارٍ","تشبُّ فيها الوقود",78,"د",1,0],["كأنَّ شقائقَ النُّعمان لَما","غدا الخابورُ حُمرَتها يُقابل",79,"ل",1,1],["كان شهاباً في سماء العلى","فاستوحشت حتى نجومُ السما",80,"م",2,0],["كَأَنَّ شقِيقَ الْوَرْدِ فِي وَجَنَاتِهِ","حَلَفْتُ لِمَنْ قَدْ لاَمَنِي بِحَيَاتِهِ",81,"ه",1,0],["كأنشبتِ الأيام أظفارها على","أولي الفضل واستبقتْ جموع الضلالةِ",82,"ه",1,0],["كأن شذا الروضات إذ مرَّت الصَّبا","رسول وأضواء النجوم شرائِعُ",83,"ع",1,0],["كأنَّ شذا الأزهار سكر وعندها","عَطايا وَهَاوٍ مضغط ومسَارعُ",83,"ع",1,0],["كان شن الغارات في البلد ال","قفر فصارت تشن في الدين",84,"ن",1,0],["كأن شمائله شمال","تنم بأسرار روض نضيرِ",85,"ر",1,0],["كَأنَّ شُعَاعَ الشَّمْس عِنْدَ طلُوعهَا","فُصُوصُ يوَاقيتٍ بِجَزْعٍ تَنَضَّدَتْ",86,"ت",1,1],["كأن شقائق النعمان فيه","ثياب قد روين من الدماءِ",87,"ا",2,0],["كان شتائي مالئاً مهجتي","كآبة تغمر وجه الشتاء",88,"ا",2,0],["كأن شَرابي إِذا يشعشعه الهَوى","حَديث علي إِذ يصححه اللَيث",89,"ث",1,0],["كأن شعاع الشمس في كل وجهة","يفر إذا الغزلان فيه تفرقوا",90,"ق",3,0],["كانَ شُجاع