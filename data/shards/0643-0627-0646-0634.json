://www.aldiwan.net/poem42282.html","الطويل"],[48,"لما رأيت الليل قد تشزرا","https://www.aldiwan.net/poem63412.html","الخفيف"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[50,"دعا بفراق من تهوى أبان","https://www.aldiwan.net/poem24573.html","الوافر"],[46,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85509","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85592","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[80,"وناطقة ٍ بالراءِ سجعاً مُرَدَّداً","https://www.poetsgate.com/ViewPoem.aspx?id=3522",""],[121,"فؤادي من الآمال في العيش مجدب","https://www.aldiwan.net/poem49350.html","الطويل"],[121,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[133,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[143,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[187,"أنا في حالتين ضر وريف","https://www.aldiwan.net/poem43617.html","الخفيف"],[224,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[224,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[236,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[262,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[272,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[276,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[283,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[293,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[354,"بدا وسقاة الراح تجلى بدورها","https://www.aldiwan.net/poem40342.html","الطويل"],[365,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[365,"أسائل عنها الركب وهي مع الركب","https://www.aldiwan.net/poem60986.html","الطويل"],[378,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[417,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[435,"خليلي هل أعطيتما اللحظ حقه","https://www.aldiwan.net/poem25307.html","الطويل"],[440,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[440,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[459,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[459,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[462,"أقول ودمعي مستهل وددتني","https://www.aldiwan.net/poem15113.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[469,"وذي دلال له في خده شعر","https://www.aldiwan.net/poem59804.html","البسيط"],[478,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[501,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[552,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[552,"ودهم كسون الليل سود ثيابه","https://www.aldiwan.net/poem47820.html","الطويل"],[554,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[554,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[568,"وروض عن صنيع الغيث راض","https://www.aldiwan.net/poem69580.html","الوافر"]],"verses":[["كَأَنَّ شَعاعَ قَرنِ الشَمسِ فيها","إِذا ما فَتَّ عَن فيها الخِتاما",0,"م",2,0],["كَأَنَّ شُجاعَي رَملَةٍ دَرَجا مَعاً","فَمَرّا بِنا لَولا وقوفٌ وَمَنزِلُ",1,"ل",1,0],["كَانَ شَجْوِي إِذَا نَأَى","وَسُرُورِي إِذَا أَلَمْ",2,"م",1,0],["كَأَنَّ شُخوصَ الخَيلِ هامٍ مَكانَها","عَلى جُمَدِ رَهبى أَو شُخوصُ خِيامِ",3,"م",1,0],["كان شهماً إن جئته في الملمّا","ت وَقيذاً أوَيْت ركناً شديدا",4,"د",2,0],["كأن شكل هلال العيد في يده","قوسٌ على مهج الأضداد موتور",5,"ر",1,0],["كأن شباباً كان لي فسُلبتُهُ","كسانيَ منه سالفُ الدهرِ مِعْرضا",6,"ض",2,0],["كان شرخُ الشباب قَرْضَ الليالي","ووراءَ القروض قِدماً تقاضي",7,"ض",2,0],["كَأَنَّ شَوادِخَ الغُرّاتِ مِنهُم","بَوازي يَصطَفِقنَ وَيَلتَقينا",8,"ن",2,0],["كأن شعاعها في الثلج نار","لفارس حولها ضربوا القبابا",9,"ب",2,0],["كأن شعر أمين","من نفح بان ورند",10,"د",1,1],["كانَ شِعري الغِناءَ في فَرَحِ الشَر","قِ وَكانَ العَزاءُ في أَحزانِه",11,"ن",2,0],["كَأَنَّ شُعاعَ عَينِ الشَمسِ فيهِ","فَفي أَبصارِنا مِنهُ اِنكِسارُ",12,"ر",1,0],["كَأَنَّ شِراعاً فيهِ مَثنى زِمامِها","مِنَ الساجِ لَولا خَطمُها وَبَلاعِمُه",13,"م",2,0],["كَأَنَّ شِهابَي قابِسٍ تَحتَ جَبهَةٍ","لَهُ مِن صِلابِ الرَعنِ بَل هُوَ أَجهَمُ",14,"م",1,0],["كأنَّ شَمالاً صافَحَتْ صَفْوَ مائِها","وليسَ إليه للشَّمالِ سَبيلُ",15,"ل",1,0],["كان شن الغارات في البلد القفر","فأضحى على سرير العراق",16,"ق",1,0],["كأنَّ شمسَ الضُّحى تخشاه بارزةً","فَضَوْءُها بحجابِ النَّقعِ مُحتَجِبُ",17,"ب",1,0],["كَأَنَّ شَذا عَرفِها عَنبَرٌ","يُلاثُ بِهِ شارِبُ الشارِبِ",18,"ب",1,0],["كأنّ شعاعَ الشمسِ في الأفقِ إذ جلتْ","به صدأ الإظلام مِدْوَس صَيْقَلِ",19,"ل",1,0],["كأنّ شوكةَ عُنّابٍ بِمِبضَعِها","يُجَرَّعُ السمّ منه مَنْ يصادِفُهُ",20,"ه",1,0],["كَأنّ شُهبَ رجومٍ في أَسِنَّتِهِ","يُرْدي بِها مِن طُغاةِ الكفرِ مَن وَرَدا",21,"د",2,0],["كأنّ شُعاعَ عينِ الشمسِ فيه","وإن كان الفِرِنْدُ به ضَبابا",22,"ب",2,0],["كانَ شَوكَ السَيالِ حُسناً فَأَمسى","دونَهُ لِلفِراقِ شَوكُ القَتادِ",23,"د",1,0],["كَأَنَّ شَبا مِسمارِهِ وَهوَ ناجِمٌ","شَبا نابِ قَرمٍ يَضرِبُ الشُولَ يَصرِفُ",24,"ف",1,0],["كَأَنَّ شِدقَيهِ إِذا تَضَوَّرا","صُدغانِ مِن عَرعَرَةٍ تَفَطَّرا",25,"ر",2,0],["كَأَنَّ شَذراً وَهَت مَعاقِدُهُ","بَينَ صَلاهُ فَمَلعَبِ الشَنَفِ",26,"ف",1,0],["كَأَنَّ شَرارَةً وَقَعَت بِقَلبي","لَها في مُقلَتي وَدَمي اِستِنانُ",27,"ن",1,0],["كَأَنَّ شَذاها العَسجَدِيَّ بِطَبعِهِ","تَضَوَّعَ هِندِيّاً وَأودِعَ فُلفُلا",28,"ل",2,0],["كأن شعري عذراء مفجعة","تبل منها بدمع العين أردانا",29,"ن",2,0],["كأَنَّ شعاع النجم والنجم طالع","يضيء جميلاً بعض أَخلاقه الغر",30,"ر",1,0],["كَأَنَّ شُعَاعَ الشَّمْسِ وَالرِّيحُ رَهْوَةٌ","إِذَا رُدَّ فِيهِ سارِقٌ يَتَرَبَّصُ",31,"ص",1,0],["كانَ شيبي بِهِ شَباباً فَلَمّا","بانَ عَنّي رَدَّ الشَبابَ مَشيبا",32,"ب",2,0],["كان شوقي يُصْغِي وما كان يُصْغِي","هو في عالَمٍ من الفنِّ ثاني",33,"ن",2,0],["كان شوقي وحافظٌ إن دجَى الخط","بُ شعاعيْنِ في الدُّجَى يلمعان",33,"ن",1,0],["كان شَيْخُ المَعَرَّةِ الكَوْكَبَ السَّا","طِعَ في ظُلْمةِ القُرُونِ الْخَوالي",34,"ل",2,0],["كان شبابي رفيقَ عمري","فعشتُ من بعده وحيدا",35,"د",2,0],["كأن شمسَ الشتاء ظبيٌ","من طبعه الدلُّ والنِّفار",36,"ر",1,0],["كانَ شيطانه مريدًا، ولكن","يتراءى للعين غير مريد",37,"د",1,0],["كأنَّ شعوراً بالحياة وعيشة","بها يشتهى طَعْمَ الحياةِ ضرائر",38,"ر",1,0],["كأنَ شعاع الشمس في الأفق إذا جلتْ","به صدأ الإظلام مِدْوَسُ صيقَلِ",39,"ل",1,0],["كأن شياطين الدجى في أهابه","تغنني على زمر الرياح وتغرب",40,"ب",1,0],["كان شأني الحفاظ والرعي فالآ","ن أرى الرعي أعظم الأرزاء",41,"ا",2,0],["كَأَنَّ شَبَابَهُم بَينَ النَّوَادِى","إِذَا امتِحُنوا في الإِعرَابِ امتِحَانَا",42,"ن",2,0],["كان شرابي وقِياني بها","دمعي ووُرقا ذات أطواقِ",43,"ق",1,0],["كان شخصا فصار للبول ظرفا","منطويّا تبكي عليه الظروف",44,"ف",1,0],["كانَ شَفيقٌ لم يَزَل مُختَلي","في الجِهَةِ اليُسرى من الهَيكَلِ",45,"ل",1,1],["كَأَنَّ شُعاعَ الزُهر في شاسِعِ الفَضا","سِهامٌ عَلى قَلبِ الوُجودِ مروقُها",46,"ق",3,0],["كانَ شِرايَ لَهُ فَضولاً","فَاِعجَب لِما يَجلِبُ الفُضولُ",47,"ل",1,0],["كان شحيحا بها فؤادي","وطالما احرم الشحيح",48,"ح",1,0],["كأن شعاع النور في قسماتها","شَقائق حسن في رياض خرائد",49,"د",1,0],["كأنَّ شِيَاتِ البُلْقِ تَحْمِل شِرَّةً","لِقَلْبِيَ بلْ أوْضَاحُها تُشهِر البُلْقَا",50,"ق",2,0],["كَأَنَّ شَذاها صِفاتُ المَليكِ ال","مُعَظَّمِ في الناسِ تورانَ شاها",51,"ا",3,0],["كَأَنَّ شُروجَ البِقَّمِ الوَردِ أُبطِنَت","أَساريعَ مِنها ذاقِناتٍ شُقوقُها",52,"ق",3,0],["كَأَنّ شَذاها حينَ هَبَّت شمالها","شَمائل إِسماعيل فاحَ عَبيرها",53,"ر",3,0],["كأنّ شَظايا الصَّخْرِ في كُلِّ نُقْرَةٍ","تَطايَرُ من لاتٍ وعُزَّى ونائل",54,"ل",1,0],["كأنّ شهابَ الدّينِ لما سَرتْ بنا","إليه المطايا تُبدِلُ البُعْدَ بالقُرب",55,"ب",1,0],["كان شهداً لذوقه","أو شراباً مروَّقا",56,"ق",2,0],["كأنَّ شعاع النور من حضراتهم","تشق حشا الظلماء فهي حراب",57,"ب",1,0],["كأنَّ شباكاً ألقيتْ في متونها","فأبقتْ مثالاً فوقها قد تسطرا",58,"ر",2,0],["كَأَنَّ شُعاعَ الشمسِ من نُورِ هَدْيها","وعَرْفَ نسيمِ الروضِ من طِيبِها نَفْحُ",59,"ح",1,0],["كَأَنَّ شعاعَ الشمسِ تَحْتَ عَجَاجِهِ","إِذَا مَا الْتَقَى الجمعانِ سِرٌّ وكاتِمُهْ",60,"م",2,0],["كأنّ شِعري أعدَى معاهدَه","فأعربتْ لي عِراصُها العُجْمُ",61,"م",1,0],["كأنّ شعاعَ النار في وجناتها","يُطيرُ شرارَ النار بين ضلوعي",62,"ع",2,0],["كأنَّ شَبا مَطْرورةٍ فارسيَّةٍ","أصاب فؤادي من حديث المُخبِّرِ",63,"ر",1,0],["كأنَّ شبَاهُ والرُّواةُ تَهُزُّهُ","شبا مرهفٍ أو بأس بدر بن مَعقِل",64,"ل",1,0],["كَأَنَّ شارِبَهُ مِن فَوقِ مَضحَكِهِ","زَبَرجَدٌ يَتَلَألَأُ تَحتَهُ يَقَقُ",65,"ق",1,0],["كأنَّ شذا العِقدِ مِن عَلْوةٍ","وقد نفحتْ سَحَراً فائحُ",66,"ح",1,0],["كأنَّ شُؤُن الغيبِ حَصراً جسامُها","لآلِ عليٍّ من لؤيٍّ ابنِ غالِبِ",67,"ب",1,0],["كان شبابي في الدُّمى وسيلةً","ثمّ اِنقَضتْ لمّا اِنقَضتْ وسائلي",68,"ل",2,0],["كأنّ شوقاً قادها","وهي كمن لم يشتقِ",69,"ق",1,0],["كأنّ شموساً طالعاتٍ خلالَه","وإلّا وَرِيساً من مُلاءٍ تمزّقا",70,"ق",2,0],["كأنّ شحومَ البُزَّلِ الكُومِ وسطها","يطارحه فوّارهنّ صبيرُ",71,"ر",1,0],["كَأَنَّ شارِبيها","في سوقِهِم أَقيادُ",72,"د",1,0],["كَأَنَّ شارِبيها","في سوقِهِم قُيودُ",73,"د",1,0],["كَأَنَّ شَقَائِقَ النُّعْمَانِ فِيْهِ","مُخَضَّرَةً كُؤُوسٌ مِنْ عَقِيْقِ",74,"ق",1,0]]}