{"poems":[[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[88,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[85,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[85,"كأن شعر أمين","https://www.aldiwan.net/poem7113.html","المجتث"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[28,"أتاني بها والليل نصفان قد مضى","https://www.aldiwan.net/poem5518.html","الطويل"],[28,"حلفت برب الجاريات إذا جرت","https://www.aldiwan.net/poem5560.html","الطويل"],[61,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[61,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[66,"أيا صاحبا ساءني بعده","https://www.aldiwan.net/poem39057.html","المتقارب"],[80,"وناطقة بالراء سجعا مرددا","https://www.aldiwan.net/poem31336.html","الطويل"],[80,"وذات خلق تريب الخلق صورته","https://www.aldiwan.net/poem31378.html","البسيط"],[80,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[40,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[48,"لما رأيت الليل قد تشزرا","https://www.aldiwan.net/poem63412.html","الخفيف"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[50,"دعا بفراق من تهوى أبان","https://www.aldiwan.net/poem24573.html","الوافر"],[46,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85509","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85592","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[80,"وناطقة ٍ بالراءِ سجعاً مُرَدَّداً","https://www.poetsgate.com/ViewPoem.aspx?id=3522",""]],"verses":[["كَأَنَّ شَعاعَ قَرنِ الشَمسِ فيها","إِذا ما فَتَّ عَن فيها الخِتاما",0,"م",2,0],["كَأَنَّ شُجاعَي رَملَةٍ دَرَجا مَعاً","فَمَرّا بِنا لَولا وقوفٌ وَمَنزِلُ",1,"ل",1,0],["كَانَ شَجْوِي إِذَا نَأَى","وَسُرُورِي إِذَا أَلَمْ",2,"م",1,0],["كَأَنَّ شُخوصَ الخَيلِ هامٍ مَكانَها","عَلى جُمَدِ رَهبى أَو شُخوصُ خِيامِ",3,"م",1,0],["كان شهماً إن جئته في الملمّا","ت وَقيذاً أوَيْت ركناً شديدا",4,"د",2,0],["كأن شكل هلال العيد في يده","قوسٌ على مهج الأضداد موتور",5,"ر",1,0],["كأن شباباً كان لي فسُلبتُهُ","كسانيَ منه سالفُ الدهرِ مِعْرضا",6,"ض",2,0],["كان شرخُ الشباب قَرْضَ الليالي","ووراءَ القروض قِدماً تقاضي",7,"ض",2,0],["كَأَنَّ شَوادِخَ الغُرّاتِ مِنهُم","بَوازي يَصطَفِقنَ وَيَلتَقينا",8,"ن",2,0],["كأن شعاعها في الثلج نار","لفارس حولها ضربوا القبابا",9,"ب",2,0],["كأن شعر أمين","من نفح بان ورند",10,"د",1,1],["كانَ شِعري الغِناءَ في فَرَحِ الشَر","قِ وَكانَ العَزاءُ في أَحزانِه",11,"ن",2,0],["كَأَنَّ شُعاعَ عَينِ الشَمسِ فيهِ","فَفي أَبصارِنا مِنهُ اِنكِسارُ",12,"ر",1,0],["كَأَنَّ شِراعاً فيهِ مَثنى زِمامِها","مِنَ الساجِ لَولا خَطمُها وَبَلاعِمُه",13,"م",2,0],["كَأَنَّ شِهابَي قابِسٍ تَحتَ جَبهَةٍ","لَهُ مِن صِلابِ الرَعنِ بَل هُوَ أَجهَمُ",14,"م",1,0],["كأنَّ شَمالاً صافَحَتْ صَفْوَ مائِها","وليسَ إليه للشَّمالِ سَبيلُ",15,"ل",1,0],["كان شن الغارات في البلد القفر","فأضحى على سرير العراق",16,"ق",1,0],["كأنَّ شمسَ الضُّحى تخشاه بارزةً","فَضَوْءُها بحجابِ النَّقعِ مُحتَجِبُ",17,"ب",1,0],["كَأَنَّ شَذا عَرفِها عَنبَرٌ","يُلاثُ بِهِ شارِبُ الشارِبِ",18,"ب",1,0],["كأنّ شعاعَ الشمسِ في الأفقِ إذ جلتْ","به صدأ الإظلام مِدْوَس صَيْقَلِ",19,"ل",1,0],["كأنّ شوكةَ عُنّابٍ بِمِبضَعِها","يُجَرَّعُ السمّ منه مَنْ يصادِفُهُ",20,"ه",1,0],["كَأنّ شُهبَ رجومٍ في أَسِنَّتِهِ","يُرْدي بِها مِن طُغاةِ الكفرِ مَن وَرَدا",21,"د",2,0],["كأنّ شُعاعَ عينِ الشمسِ فيه","وإن كان الفِرِنْدُ به ضَبابا",22,"ب",2,0],["كانَ شَوكَ السَيالِ حُسناً فَأَمسى","دونَهُ لِلفِراقِ شَوكُ القَتادِ",23,"د",1,0],["كَأَنَّ شَبا مِسمارِهِ وَهوَ ناجِمٌ","شَبا نابِ قَرمٍ يَضرِبُ الشُولَ يَصرِفُ",24,"ف",1,0],["كَأَنَّ شِدقَيهِ إِذا تَضَوَّرا","صُدغانِ مِن عَرعَرَةٍ تَفَطَّرا",25,"ر",2,0],["كَأَنَّ شَذراً وَهَت مَعاقِدُهُ","بَينَ صَلاهُ فَمَلعَبِ الشَنَفِ",26,"ف",1,0],["كَأَنَّ شَرارَةً وَقَعَت بِقَلبي","لَها في مُقلَتي وَدَمي اِستِنانُ",27,"ن",1,0],["كَأَنَّ شَذاها العَسجَدِيَّ بِطَبعِهِ","تَضَوَّعَ هِندِيّاً وَأودِعَ فُلفُلا",28,"ل",2,0],["كأن شعري عذراء مفجعة","تبل منها بدمع العين أردانا",29,"ن",2,0],["كأَنَّ شعاع النجم والنجم طالع","يضيء جميلاً بعض أَخلاقه الغر",30,"ر",1,0],["كَأَنَّ شُعَاعَ الشَّمْسِ وَالرِّيحُ رَهْوَةٌ","إِذَا رُدَّ فِيهِ سارِقٌ يَتَرَبَّصُ",31,"ص",1,0],["كانَ شيبي بِهِ شَباباً فَلَمّا","بانَ عَنّي رَدَّ الشَبابَ مَشيبا",32,"ب",2,0],["كان شوقي يُصْغِي وما كان يُصْغِي","هو في عالَمٍ من الفنِّ ثاني",33,"ي",1,0],["كان شوقي وحافظٌ إن دجَى الخط","بُ شعاعيْنِ في الدُّجَى يلمعان",33,"ن",1,0],["كان شَيْخُ المَعَرَّةِ الكَوْكَبَ السَّا","طِعَ في ظُلْمةِ القُرُونِ الْخَوالي",34,"ل",2,0],["كان شبابي رفيقَ عمري","فعشتُ من بعده وحيدا",35,"د",2,0],["كأن شمسَ الشتاء ظبيٌ","من طبعه الدلُّ والنِّفار",36,"ر",1,0],["كانَ شيطانه مريدًا، ولكن","يتراءى للعين غير مريد",37,"د",1,0],["كأنَّ شعوراً بالحياة وعيشة","بها يشتهى طَعْمَ الحياةِ ضرائر",38,"ر",1,0],["كأنَ شعاع الشمس في الأفق إذا جلتْ","به صدأ الإظلام مِدْوَسُ صيقَلِ",39,"ل",1,0]]}