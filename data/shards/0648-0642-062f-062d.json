العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[484,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[488,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[507,"الإنسان","https://www.aldiwan.net/poem61093.html","البسيط"],[516,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[517,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[517,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[517,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[540,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[540,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[540,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[540,"ألا دمت يا دار ودام لك الجد","https://www.aldiwan.net/poem48232.html","عموديه"],[545,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[553,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[553,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[553,"لا تنظري اليوم يا سلمى إلي فما","https://www.aldiwan.net/poem47770.html","البسيط"],[553,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[553,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[560,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[560,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[560,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[560,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[560,"بلاء الأنبياء هو البلاء","https://www.aldiwan.net/poem35089.html","الوافر"],[569,"رنت فأصابت سر قلبي بلحظة","https://www.aldiwan.net/poem69756.html","الطويل"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[577,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[577,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[577,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[756,"","https://poetry.dctabudhabi.ae/diwan/poem/17656","البسيط"],[756,"","https://poetry.dctabudhabi.ae/diwan/poem/17652","الطويل"],[511,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/200315","الوافر"],[545,"","https://poetry.dctabudhabi.ae/diwan/poem/20375","الوافر"],[1093,"","https://poetry.dctabudhabi.ae/diwan/poem/75815","الطويل"]],"verses":[["وَقَد حاصَ مِن خَوفِ الرَدى كُلَّ حيصَةٍ","فَلَم يَنجُ وَالأَقدارُ ضَربَةُ لازِمِ",0,"م",1,0],["وَقَد حَلَّقَت خَوفَ الهَوانِ بِمُصعَبٍ","قَوادِمُ أَبّاءٍ كَريمِ المَقاوِمِ",0,"م",1,0],["وَقَد حَجَزَ العَجاجُ فَلا نَجاءٌ","وَقَد ضاقَ المَجالُ فَلا قَرارُ",1,"ر",1,0],["وَقَد حَفَّ بِالبَدرِ النُجومُ كَأَنَّهُ","هَدِيٌّ تَهاداهُ الإِماءُ الوَلائِدُ",2,"د",1,0],["وَقَد حَدَّثَ الرُّكبانُ أَنَّ نَوائِباً","عَرَتْ قَومَها حَتىّ تَغَيَّرَ حالُها",3,"ل",3,0],["وَقَد حَدَّثَ الواشي بِما لا أُريدُهُ","فَماذا يُرَجِّيهِ بِفيهِ تُرابُ",4,"ب",1,0],["وَقَدْ حَارَبَتْهُ مِنْ مَعَدِّ وَغَيْرِها","قَبائِلُ تَبْغِي المُلْكَ صُعْراً خُدُودُها",5,"د",3,0],["وَقَد حَسِبَت ذَنباً عَلَيَّ تَزَوُّجي","فَقُلتُ كِلانا مُذنِبٌ قَد تَزَوَّجا",6,"ج",2,0],["وَقَد حُمِّلتُ مِن حُبَّيكِ ما لَو","تَقَسَّمَ بَينَ أَهلِ الأَرضِ شابوا",7,"ب",3,0],["وقدْ حلّ فيهِ منْ مَها الإنْسِ فِتيةٌ","أوانِسُ لا يَعْرِفْنَ شِيحاً ولا رَمْلا",8,"ل",2,0],["وَقَدْ حُطَّ كُوِي فِي جِوَارِ مَثَابَةٍ","بِهَا تُكْتَبُ الزُّلْفَى وَيُغْتَفَرُ الإِثْمُ",9,"م",1,0],["وَقَدَحْتَ فَوْقَ المَاءِ نَاراً تَلْتَظِي","وَسَفَحْتَ فَوْقَ البَحْرِ بَحْراً مِنْ دَمِ",10,"م",1,0],["وَقَدَحْتَ زَنْدَ عَزِيمَةٍ نَصْرِيَّةٍ","تَرَكَتْ دَيَارَ الْكُفْرِ وَهْيَ طُلُولُ",11,"ل",1,0],["وَقِدحُكَ في العُلومِ هُوَ المُعَلّى","غَداةَ تُجالُ في النادي القِداحُ",12,"ح",1,0],["وَقِدحي في وِدادِكُمُ مُعَلّىً","وَباعي في اِعتِمادِكُمُ طَويلُ",13,"ل",1,0],["وَقَد حالَ مِن رَضوى وَضَيبَرَ دونَهُم","شَماريخُ لِلأَروى بِهِنَّ حُصونُ",14,"ن",1,0],["وقد حالَ خيرٌ من أُناسٍ ورِفْدُهُمْ","بكفَّي غلامٍ لا ضنينٍ ولابرمْ",15,"م",1,0],["وَقَد حَلَفَت بِاللَهِ مَيَّةُ ما الَّذي","أُحَدِّثُها إِلّا الَّذي أَنا كاذِبُه",16,"ب",2,0],["وقد حُمِلَتْ فوق الرؤُوس لأنها","هديَّة مولى حلّ في مفرق الفخر",17,"ر",1,0],["وقد حلّت بامتكم كُروب","لكم فيهنّ لا لَهم الذنوب",18,"ب",1,0],["وقد حاكت الأفكار عند اصطدامها","تلألؤ برق العارض المُتَهّزِم",19,"م",1,0],["وَقَد حاذَرتُ أَهلَكِ أَن يَبينوا","فَما بالَيتِ بِالأُدَمى حِذاري",20,"ر",2,0],["وَقَد حَلَّت أُمامَةُ بَطنَ وادٍ","بِهِ نَخلٌ وَقابَلَتِ الرَغاما",21,"م",2,0],["وَقَد حُطِّمَ الخَطِّيُّ وَاِختَرَمَ العِدى","وَفُلَّلَ حَدُّ المَشرَفيِّ المُهَنَّدِ",22,"د",1,0],["وَقَد حَيِّرَني حِبٌّ","وَطَرفٌ فيهِ تَقويسُ",23,"س",1,0],["وقد حاول الواشون إفساد بيننا","فأعيى على ذي المكرِ منهم وذي الإربِ",24,"ب",1,0],["وقد حُسِّنتَ أخلاقاً وخَلْقاً","فقد أصبحتَ مصباحَ القلوبِ",25,"ب",1,0],["وقد حُزْنَ من التسبي","ح ميراثاً عن الحوتِ",26,"ت",1,0],["وقد حجب الله الحيا غيرَ عصمةٍ","بكفَّيك تُغني المقحِطين عن القَطر",27,"ر",1,0],["وقد حظيَتْ بحظكُمُ رزايا","يُطأطىءُ ذكرُها صيد القَذالِ",28,"ل",1,0],["وقد حاولتْ منجىً فقالت رماحُنا","لِمُمْعِنِها عرّجْ فهذا المخيَّمُ",29,"م",1,0],["وقد حان الوليُّ فلا تَجُزْني","كوسْمِيٍّ عداني ما عداني",30,"ن",2,0],["وقد حماني إخواني مواردَهم","ووكلتني إلى بحرٍ سواقيه",31,"ي",2,0],["وَقَد حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","بِاللَهِ رَبِّ سُتورِ البَيتِ ذي الحُجُبِ",32,"ب",1,0],["وقد حملوه والجماهير خلفه","على مدفع ضخم مكان السواعد",33,"د",1,0],["وقد حللن ما على","الرؤوس من عصائب",34,"ب",1,0],["وقد حفظوا حق الحياة لنفسهم","بما اغتصبوا من حقنا واضاعونا",35,"ن",2,0],["وقد حمل الحملان صفقة عقدها","وسوف يرى الحملان عاقبة العقد",36,"د",1,0],["وَقَدْ حَبَانِي منكُمُ السِّبْطَيْنِ","هُمَا بِحلي العَرْشِ كالقُرْطَيْنِ",37,"ن",1,0],["وَقَد حَمَلتَ الثِقلَ مِن قَبلِهِ","فَأَغنَتِ الشِدَّةُ عَن سَحبِهِ",38,"ب",2,0],["وَقَد حَمَّلتَني شُكراً طَويلاً","ثَقيلاً لا أُطيقُ بِهِ حَراكا",39,"ك",2,0],["وَقَد حاكَموها وَالمَنايا حَواكِمٌ","فَما ماتَ مَظلومٌ وَلا عاشَ ظالِمُ",40,"م",1,0],["وقد حصلت لنا أرض جديد","لنا من شمسها أبداً سراجُ",41,"ج",1,0],["وقد حادَ عنهُ سِهامُ العِدَى","فلم يبقَ في قوسهم منزعُ",42,"ع",1,0],["وقد حلَّ فيه الشمسُ بيتَ سنَائِها","كطلعةِ مولانا وقد مَلأَ الصَّدْرَا",43,"ر",2,0],["وَقَد حَرِصتُ عَلى جَدّي يُصاحِبُني","عَلى الشَبابِ لَوَ أَنَّ الحَظَّ يُكتَسَبُ",44,"ب",1,0],["وَقَد حَكَّموهُ وَهوَ في كُلِّ مُشكِلِ","سَريعُ القَضاءِ مُرتَضى الحُكمِ فاصِلُه",45,"ل",2,0],["وَقَد حَشَدَت حَولَ المَراغَةِ مُدَّةً","لِقَتلٍ عَلى أَبوابِها وَقِتالِ",46,"ل",1,0],["وَقَد حُقِّقَت فيهِ الظُنونُ وَصُدِّقَت","عَلى ماحَكَت مِن قَبلُ فيهِ الدَلائِلُ",47,"ل",1,0],["وَقَد حاوَلتُ أَن تَخِدَ المَطايا","إِلى حَيٍّ عَلى حَلَبٍ حُلولِ",48,"ل",1,0],["وَقَد حاجَزَت عاجِماتِ الخُطو","بِ عَنِ النَبعِ شِدَّةُ عيدانِهِ",49,"ن",2,0],["وَقَد حُمِدَت بِأَخلاقٍ خُبِرتَ بِها","وَإِنَّما يا اِبنُ لَيلى يُحمَدُ الخَبَرُ",50,"ر",1,0],["وَقَد حَلَّ داراً عَن بَنيهِ مُحَمَّدٌ","بَطيئاً لِمَن يَرجو اللِقاءَ لِمامُها",51,"م",3,0],["وَقَد حالَ دوني السِجنُ حَتّى نَسيتُها","وَأَذهَلَني عَن ذِكرِ كُلِّ حَميمِ",52,"م",1,0],["وقد حديت قلائصها الحيارى","بحاد من رواعدها فصيح",53,"ح",1,0],["وقد حَثَّ ابتسامُ البر","قِ دَمْعَ المُزْنِ فانسجَما",54,"م",2,0],["وقد حَجَبَ الجُدرانَ عن كلِّ ناظِرٍ","منَ الرَّيْطِ مبَلولٌ صَباه بَليلُ",55,"ل",1,0],["وقد حَجَبَ الغَيْمُ السَّماءَ كأنَّما","يُزَرُّ عليها منه ثَوْبٌ مُمَسَّكُ",56,"ك",1,0],["وقد حجبَ الأرضَ ريحانُنا","فلم يَبْقَ للعينِ منها نَصيبا",57,"ب",2,0],["وَقَد حَجَبَ الظَبيَ الرَقيبُ وَأَقبَلَت","تُمانِعُني دونَ الكِناسِ أُسودُ",58,"د",1,0],["وَقَد حالَ بَينَ الرّومِ والبحرِ فالتَجوْا","إلى القصرِ حتّى جاءَهُم بالرّدى القصرُ",59,"ر",1,0],["وَقَد حَرَّرتُ في مَديحِكَ جَهدي","فَحَرِّر بِالنَدى صِلَةَ القَصيدِ",60,"د",1,0],["وَقَد حَباني عَصاهُ فَاِعتَصَمتُ بِها","في كُلِّ هَولٍ فَلم أَفزَع وَلَم أَهِمِ",61,"م",1,0],["وَقَد حَلَفَت يَميناً بِر","رَةً بِمَحَلِّ مَن خَلَقا",62,"ق",2,0],["وَقَد حالَ دونَ الكُفرِ وَالغَدرِ أَنَّني","أُعالِجُ نَفساً هَل تُفيقُ وَتَصبِرُ",63,"ر",1,0],["وَقَد حَذِرتُ النَوى في قُربِ دارِهِمُ","فَعيلَ صَبري وَلَم يَنفَعنِيَ الحَذَرُ",64,"ر",1,0],["وَقَد حَلَّ بي ما كُنتَ عَنهُ بِمَعزِل","لِحَيني فَمَوتي يا سُعادُ قَريبُ",65,"ب",1,0],["وقد حَاز خَمساً رِقَّةً ولَطَافَةً","وحَسناً وإحسَاناً وثَغراً ومَبسَمَا",66,"م",2,0],["وقَد حَاز خَمساً عِزَّةً وصِيَانَةً","ومُلكاً وحَظَّا وافِراً وتَحَكُّمَا",66,"م",2,0],["وقَدحتُ في مُهجِ الشبا","بِ شرارةَ العزمِ الوطيد",67,"د",1,0],["وقد حُلِّيَتْ منها صُدُورٌ بِعَسْجَدٍ","وَلُفَّتْ لَها تَحْتَ الحُلِيِّ شُعُورُ",68,"ر",1,0],["وقد حُبِّرَتْ فيها لك الخُطَبُ التي","بدائعُها نَظْمٌ وألفاظُها نَشْر",69,"ر",1,0],["وَقَد حَمَيتُ لِساني أَن أُبينَ بِهِ","فَما يُعَبِّرُ عَنّي غَيرُ إيمائي",70,"ا",3,0],["وَقَد حَلَفتُ يَميناً","مَبرورَةً لا تُكَذَّب",71,"ب",1,0],["وَقَد حَذِرَ الناسُ سِكّينَهُ","فَكُلُّهُم يَتَّقي شَرَّها",72,"ر",3,0],["وَقَد حالَ هَمٌّ دونَ ذَلِكَ شاغِلٌ","مَكانَ الشِغافِ تَبتَغيهِ الأَصابِعُ",73,"ع",1,0],["وَقَد حارَ هادي الرَكبِ وَاللَيلُ ضارِبٌ","بِأَوراقِهِ وَالصُبحُ لَم يَتَبَلَّجِ",74,"ج",1,0],["وَقَد حَمَلَتهُ فَوقَ نَعشٍ وَطالَما","سَرى فَوقَ عَنسٍ أَو عَلا فَرَساً نَهِدا",75,"د",2,0],["وَقَد حُسِبَت مِن بَناتِ السُهولِ","فَجاءَت بِإِحدى بَناتِ الجَبَل",76,"ل",1,0],["وَقَد حَرَسَ المَمالِكَ حَيُّ لَخمٍ","فَغالَتهُم نَوائِبُ يَحتَرِسنَه",77,"ن",2,0],["وقد حبست في الدار حتى كأنها","من الرجن قوس حل عنها سيورها",78,"ر",3,0],["وَقَد حَدَّثوا أَنّا اِلتَقَينا عَلى هَوىً","فَكُلُّهُم مِن حَملِهِ الغَيظَ موقَرُ",79,"ر",1,0],["وقد حلَفَتْ أن تَسألَ الشمسَ حاجةً","وإنْ سألَتْكَ اليُسْرَ بَرّتْ يمِينها",80,"ن",3,0],["وقد حُبِستْ أمْواهُها في أديمِها","سِنينَ وشُبّتْ نارُها تحتَ بُرْقُع",81,"ع",1,0],["وَقَدْ حَنَّتِ الأَطْيَارُ فِي وُكُنَاتِهَا","وَقَامَ يُحَيِّينَا عَلَى سَاقِهِ الزَّهْرُ",82,"ر",1,0],["وَقَدْ حَشَدُوا واستَنْفَروا من يَلِيهِمُ","منَ النّاسِ حتَّى جمعُهُمْ مُتَكَاثِرُ",83,"ر",1,0],["وقد حجب الشمسَ الضبابُ كأنَّما","تلا الليلَ ليلٌ عاكرُ اللونِ أسْفَعُ",84,"ع",1,0],["وقد حملوا أرواحَهُمْ في أكفهم","وليس لهم إلاّ الخلود جَزاءُ",85,"ا",2,0],["وقد حل فيه من مهى الإنس فتية","أوانس لا يعرفن شيحا ولا رملا",86,"ل",2,0],["وقد حَسَدَت بغدادُ شَتى عواصمٍ","من الشرق لم تنعُمْ بهذا التفوُّق",87,"ق",1,0],["وقد حَنُّوا اليه كما تلظى","فطيمٌ حول مرضعة تدُر",88,"ر",1,0],["وقد حوسب الكابي بأوهَى ذنوبِه","ولم يؤخَذِ الناجي بأمّ الكبائر",89,"ر",1,0],["وقد حلفتْ بيضُ الظُبا أن تنوَشه","وسمرُ القَنا الخطيِّ أن تتكسَرا",90,"ر",2,0],["وقد حَمِدتُ شفيعاً لي على رَشَدي","أُمّاً وجدتُ على الإسلامِ لي وأبا",91,"ب",2,0],["وقد حرصت على حدي يصاحبني","على الشباب لو أن الحظ يكتسب",92,"ب",1,0],["وقد حار هادي الرّكب، والليلُ ضاربٌ","بأرواقهِ، والصّبْحُ لم يتبَلّجِ",93,"ج",1,0],["وقد حكمتْ بأن الخلْفَ غدْرٌ","كما حكمتْ بأن الوعْدَ عهْدُ",94,"د",1,0],["وقد حفّ الرّماة بجانبيها","وكلّهم على حنق يراها",95,"ا",3,0],["وقد حِيلَ ما بين الحياةِ وبينهُ","فللموت منه بين عَينٍ وحاجب",96,"ب",1,0],["وَقدٌّ حَشوهُ هَيف","وَطَرف مَلؤُهُ كُحل",97,"ل",1,0],["وقد حصل المراد بفضل طه","وعترته وسيدنا علي",98,"ي",1,0],["وقد حان الرحيل وما ارعويتم","وما استسقيتمو منه رواء",99,"ا",2,0],["وَقَد حالَفوا قَوماً عَلَينا أَظِنَّةً","يَعضّونَ غَيظاً خَلفَنا بِالأَنامِلِ",100,"ل",1,0],["وَقَد حَلَلتَ بِثَغرٍ عَزَّ ساكِنُهُ","سَدَدتَهُ بِسَدادٍ صَحَّحَ اللَقَبا",101,"ب",2,0],["وَقَد حافَ دَهرٌ أَلحَقَ الأَبعَدينَ بي","وَعَدلُكَ لا يَرضى وَفَضلُكَ بي أَحفا",102,"ف",2,0],["وَقَد حَدَثَت في الأَرضِ وَالأَمرُ واضِحٌ","نَوائِبُ تَنهاكُم عَنِ الهَجرِ وَالقِلا",103,"ل",2,0],["وَقَد حَكَّمَتكَ شِفارُ السُيوفِ","عَلى كُلِّ ذي عِزَّةٍ فَاِحتَكِم",104,"م",1,0],["وَقَد حالَتِ الأَقدارُ دونَ شِفائِهِ","لَدى رَوضَةٍ قَد أَشرَقَت بِبَهائِهِ",105,"ه",1,0],["وَقَدْ حُلِّيَتْ أَجْفانُها مِنْ دُمُوعِها","كَما حُلِّيَتْ لَيْلاً سَمَاءٌ بِأَنْجُمِ",106,"م",1,0],["وَقَد حُلِّيَتْ أَجفانُها مِن دموعِها","بِأَحسنَ مِمَّا حُلِّيَتْ في التَّرائبِ",107,"ب",1,0],["وقد حكم الميلاد والله قد قضى","بأنك فيها بالغ ما ترومه",108,"م",2,0],["وَقَد حَضَرَت عاماً بَوادِرَ كُلَّها","فَذِروَةُ منها فالمِراضانِ مأَلَفُ",109,"ف",1,0],["وَقَد حَسَدوا أَهلَ الحِجازِ وأَقبَلُوا","مِنَ الشامِ في أَهليهمُ وَالعَصائِبِ",110,"ب",1,0],["وقد حثَّني في قَصْدِكَ الْحَزْمُ والحِجَا","ومَنْ رأيُه فيما يُشِيرُ صَواب",111,"ب",1,0],["وقد حَبَك الربيعُ لساحليه","فَراوِزَ في حَواشٍ باخْضِرار",112,"ر",1,0],["وقد حَكى الوردُ بُدرِّ النَّدَى","كأَدمُعٍ في خدِّ مُسْتَعْبِر",113,"ر",1,0],["وقد حَباني بكم","كفَّارةً لِما سلف",114,"ف",1,0],["وَقَد حلَقت أَديانَهُم من قلوبهم","فَما تَرَكت مِن نورِ إِيمانهم إثرا",115,"ر",2,0],["وَقَد حرّفوا مثلَ النَصارى كِتابهم","وَزادوا حُروفاً حِبرُها لعنَ الحبرا",116,"ر",2,0],["وَقَد حاوَلت فيهِ النَصارى عقيدةً","لأن يَجعَلوا فوقَ الهوانِ له سِترا",116,"ر",2,0],["وقَد حظرَ اللَّهُ الزناءَ وإن تكن","قَوانينُهم قَد لا تَرى في الزِنا حظرا",116,"ر",2,0],["وقد حان مني للرياضِ التفاتةٌ","حبستُ بها كأسي قليلاً عن الساقي",117,"ق",2,0],["وقد حسبوني طيفَ الخيالِ","لولا الوسادةُ والمضجعُ",118,"ع",1,0],["وقد حسروا عن ساعد الجد إذ بنوا","لمدرسة الإحسان لن تتأوّدا",119,"د",2,0],["وَقَد حَلَفَت بِاللَهِ لا تَقطَعُ القُوى","فَما صَدَقَت فيهِ وَلا بَرِّتِ الحَلفا",120,"ف",2,0],["وقد حلا موردا طابت مصادره","منه ففي الورد محمود وفي الصدر",121,"ر",1,0],["وقد حازت الشقرا بميدانها العلا","وسادت على الشهبا بجبهتها الغرا",122,"ر",2,0],["وقد حاز في العلياء مجداً وسؤددا","ونال محلا ساميا وعلا قدرا",122,"ر",2,0],["وقد حوى احسن السجايا","وشاد مجدا وساد حمدا",123,"د",2,0],["وقَدْ حَمّلتْني الحُبَّ حَمْلَ تَكَلُّفٍ","وزَادَتْ ثَقِيلَ الحُبِّ حَمْلَ جِفاها",124,"ا",3,0],["وقد حاولتْ مني عِناقاً فاغتدت","تُعَلِّلُ مني صدقَها بمحالِ",125,"ل",1,0],["وقد حَملَتُ منه ظِباءً أوانساً","لها أوجهٌ كأنَّهُنَّ شُموسُ",126,"س",1,0],["وَقَد حَمَلت ليد اللانهايَةِ","أَكياسَ آماليَ الزائِلَه",127,"ه",1,0],["وَقد حَمَلت من شِدَّة الحزن رَأسها","وَأَلقَت سوادَ الثَغرِ فوقَ التَرائِبِ",128,"ب",1,0],[