,[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[46,"سرت بقوام يسرق اللب ناعم","https://www.aldiwan.net/poem22256.html","الطويل"],[46,"سلوا معشر الموتى الذي جاء وافدا","https://www.aldiwan.net/poem22424.html","الطويل"],[46,"أتتك بحب فتاة غدت","https://www.aldiwan.net/poem23278.html","المتقارب"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8241","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16628","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[77,"تذكرت عهدا للشباب الذي ولى","https://www.poetsgate.com/ViewPoem.aspx?id=34196",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[45,"يشكو إليك هواك المدنف الوصب","https://www.poetsgate.com/ViewPoem.aspx?id=33094",""],[46,"سرتْ بقوامٍ، يسرِقُ اللُّبَّ، ناعمٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18248",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""]],"verses":[["وَقَد حاصَ مِن خَوفِ الرَدى كُلَّ حيصَةٍ","فَلَم يَنجُ وَالأَقدارُ ضَربَةُ لازِمِ",0,"م",1,0],["وَقَد حَلَّقَت خَوفَ الهَوانِ بِمُصعَبٍ","قَوادِمُ أَبّاءٍ كَريمِ المَقاوِمِ",0,"م",1,0],["وَقَد حَجَزَ العَجاجُ فَلا نَجاءٌ","وَقَد ضاقَ المَجالُ فَلا قَرارُ",1,"ر",1,0],["وَقَد حَفَّ بِالبَدرِ النُجومُ كَأَنَّهُ","هَدِيٌّ تَهاداهُ الإِماءُ الوَلائِدُ",2,"د",1,0],["وَقَد حَدَّثَ الرُّكبانُ أَنَّ نَوائِباً","عَرَتْ قَومَها حَتىّ تَغَيَّرَ حالُها",3,"ل",3,0],["وَقَد حَدَّثَ الواشي بِما لا أُريدُهُ","فَماذا يُرَجِّيهِ بِفيهِ تُرابُ",4,"ب",1,0],["وَقَدْ حَارَبَتْهُ مِنْ مَعَدِّ وَغَيْرِها","قَبائِلُ تَبْغِي المُلْكَ صُعْراً خُدُودُها",5,"د",3,0],["وَقَد حَسِبَت ذَنباً عَلَيَّ تَزَوُّجي","فَقُلتُ كِلانا مُذنِبٌ قَد تَزَوَّجا",6,"ج",2,0],["وَقَد حُمِّلتُ مِن حُبَّيكِ ما لَو","تَقَسَّمَ بَينَ أَهلِ الأَرضِ شابوا",7,"ب",3,0],["وقدْ حلّ فيهِ منْ مَها الإنْسِ فِتيةٌ","أوانِسُ لا يَعْرِفْنَ شِيحاً ولا رَمْلا",8,"ل",2,0],["وَقَدْ حُطَّ كُوِي فِي جِوَارِ مَثَابَةٍ","بِهَا تُكْتَبُ الزُّلْفَى وَيُغْتَفَرُ الإِثْمُ",9,"م",1,0],["وَقَدَحْتَ فَوْقَ المَاءِ نَاراً تَلْتَظِي","وَسَفَحْتَ فَوْقَ البَحْرِ بَحْراً مِنْ دَمِ",10,"م",1,0],["وَقَدَحْتَ زَنْدَ عَزِيمَةٍ نَصْرِيَّةٍ","تَرَكَتْ دَيَارَ الْكُفْرِ وَهْيَ طُلُولُ",11,"ل",1,0],["وَقِدحُكَ في العُلومِ هُوَ المُعَلّى","غَداةَ تُجالُ في النادي القِداحُ",12,"ح",1,0],["وَقِدحي في وِدادِكُمُ مُعَلّىً","وَباعي في اِعتِمادِكُمُ طَويلُ",13,"ل",1,0],["وَقَد حالَ مِن رَضوى وَضَيبَرَ دونَهُم","شَماريخُ لِلأَروى بِهِنَّ حُصونُ",14,"ن",1,0],["وقد حالَ خيرٌ من أُناسٍ ورِفْدُهُمْ","بكفَّي غلامٍ لا ضنينٍ ولابرمْ",15,"م",1,0],["وَقَد حَلَفَت بِاللَهِ مَيَّةُ ما الَّذي","أُحَدِّثُها إِلّا الَّذي أَنا كاذِبُه",16,"ب",2,0],["وقد حُمِلَتْ فوق الرؤُوس لأنها","هديَّة مولى حلّ في مفرق الفخر",17,"ر",1,0],["وقد حلّت بامتكم كُروب","لكم فيهنّ لا لَهم الذنوب",18,"ب",1,0],["وقد حاكت الأفكار عند اصطدامها","تلألؤ برق العارض المُتَهّزِم",19,"م",1,0],["وَقَد حاذَرتُ أَهلَكِ أَن يَبينوا","فَما بالَيتِ بِالأُدَمى حِذاري",20,"ي",1,0],["وَقَد حَلَّت أُمامَةُ بَطنَ وادٍ","بِهِ نَخلٌ وَقابَلَتِ الرَغاما",21,"م",2,0],["وَقَد حُطِّمَ الخَطِّيُّ وَاِختَرَمَ العِدى","وَفُلَّلَ حَدُّ المَشرَفيِّ المُهَنَّدِ",22,"د",1,0],["وَقَد حَيِّرَني حِبٌّ","وَطَرفٌ فيهِ تَقويسُ",23,"س",1,0],["وقد حاول الواشون إفساد بيننا","فأعيى على ذي المكرِ منهم وذي الإربِ",24,"ب",1,0],["وقد حُسِّنتَ أخلاقاً وخَلْقاً","فقد أصبحتَ مصباحَ القلوبِ",25,"ب",1,0],["وقد حُزْنَ من التسبي","ح ميراثاً عن الحوتِ",26,"ت",1,0],["وقد حجب الله الحيا غيرَ عصمةٍ","بكفَّيك تُغني المقحِطين عن القَطر",27,"ر",1,0],["وقد حظيَتْ بحظكُمُ رزايا","يُطأطىءُ ذكرُها صيد القَذالِ",28,"ل",1,0],["وقد حاولتْ منجىً فقالت رماحُنا","لِمُمْعِنِها عرّجْ فهذا المخيَّمُ",29,"م",1,0],["وقد حان الوليُّ فلا تَجُزْني","كوسْمِيٍّ عداني ما عداني",30,"ن",2,0],["وقد حماني إخواني مواردَهم","ووكلتني إلى بحرٍ سواقيه",31,"ي",2,0],["وَقَد حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","بِاللَهِ رَبِّ سُتورِ البَيتِ ذي الحُجُبِ",32,"ب",1,0],["وقد حملوه والجماهير خلفه","على مدفع ضخم مكان السواعد",33,"د",1,0],["وقد حللن ما على","الرؤوس من عصائب",34,"ب",1,0],["وقد حفظوا حق الحياة لنفسهم","بما اغتصبوا من حقنا واضاعونا",35,"ن",2,0],["وقد حمل الحملان صفقة عقدها","وسوف يرى الحملان عاقبة العقد",36,"د",1,0],["وَقَدْ حَبَانِي منكُمُ السِّبْطَيْنِ","هُمَا بِحلي العَرْشِ كالقُرْطَيْنِ",37,"ن",1,0],["وَقَد حَمَلتَ الثِقلَ مِن قَبلِهِ","فَأَغنَتِ الشِدَّةُ عَن سَحبِهِ",38,"ب",2,0],["وَقَد حَمَّلتَني شُكراً طَويلاً","ثَقيلاً لا أُطيقُ بِهِ حَراكا",39,"ك",2,0],["وَقَد حاكَموها وَالمَنايا حَواكِمٌ","فَما ماتَ مَظلومٌ وَلا عاشَ ظالِمُ",40,"م",1,0],["وقد حصلت لنا أرض جديد","لنا من شمسها أبداً سراجُ",41,"ج",1,0],["وقد حادَ عنهُ سِهامُ العِدَى","فلم يبقَ في قوسهم منزعُ",42,"ع",1,0],["وقد حلَّ فيه الشمسُ بيتَ سنَائِها","كطلعةِ مولانا وقد مَلأَ الصَّدْرَا",43,"ر",2,0],["وَقَد حَرِصتُ عَلى جَدّي يُصاحِبُني","عَلى الشَبابِ لَوَ أَنَّ الحَظَّ يُكتَسَبُ",44,"ب",1,0],["وَقَد حَكَّموهُ وَهوَ في كُلِّ مُشكِلِ","سَريعُ القَضاءِ مُرتَضى الحُكمِ فاصِلُه",45,"ل",2,0],["وَقَد حَشَدَت حَولَ المَراغَةِ مُدَّةً","لِقَتلٍ عَلى أَبوابِها وَقِتالِ",46,"ل",1,0],["وَقَد حُقِّقَت فيهِ الظُنونُ وَصُدِّقَت","عَلى ماحَكَت مِن قَبلُ فيهِ الدَلائِلُ",47,"ل",1,0],["وَقَد حاوَلتُ أَن تَخِدَ المَطايا","إِلى حَيٍّ عَلى حَلَبٍ حُلولِ",48,"ل",1,0],["وَقَد حاجَزَت عاجِماتِ الخُطو","بِ عَنِ النَبعِ شِدَّةُ عيدانِهِ",49,"ن",2,0],["وَقَد حُمِدَت بِأَخلاقٍ خُبِرتَ بِها","وَإِنَّما يا اِبنُ لَيلى يُحمَدُ الخَبَرُ",50,"ر",1,0],["وَقَد حَلَّ داراً عَن بَنيهِ مُحَمَّدٌ","بَطيئاً لِمَن يَرجو اللِقاءَ لِمامُها",51,"م",3,0],["وَقَد حالَ دوني السِجنُ حَتّى نَسيتُها","وَأَذهَلَني عَن ذِكرِ كُلِّ حَميمِ",52,"م",1,0],["وقد حديت قلائصها الحيارى","بحاد من رواعدها فصيح",53,"ح",1,0],["وقد حَثَّ ابتسامُ البر","قِ دَمْعَ المُزْنِ فانسجَما",54,"م",2,0],["وقد حَجَبَ الجُدرانَ عن كلِّ ناظِرٍ","منَ الرَّيْطِ مبَلولٌ صَباه بَليلُ",55,"ل",1,0],["وقد حَجَبَ الغَيْمُ السَّماءَ كأنَّما","يُزَرُّ عليها منه ثَوْبٌ مُمَسَّكُ",56,"ك",1,0],["وقد حجبَ الأرضَ ريحانُنا","فلم يَبْقَ للعينِ منها نَصيبا",57,"ب",2,0],["وَقَد حَجَبَ الظَبيَ الرَقيبُ وَأَقبَلَت","تُمانِعُني دونَ الكِناسِ أُسودُ",58,"د",1,0],["وَقَد حالَ بَينَ الرّومِ والبحرِ فالتَجوْا","إلى القصرِ حتّى جاءَهُم بالرّدى القصرُ",59,"ر",1,0],["وَقَد حَرَّرتُ في مَديحِكَ جَهدي","فَحَرِّر بِالنَدى صِلَةَ القَصيدِ",60,"د",1,0],["وَقَد حَباني عَصاهُ فَاِعتَصَمتُ بِها","في كُلِّ هَولٍ فَلم أَفزَع وَلَم أَهِمِ",61,"م",1,0],["وَقَد حَلَفَت يَميناً بِر","رَةً بِمَحَلِّ مَن خَلَقا",62,"ق",2,0],["وَقَد حالَ دونَ الكُفرِ وَالغَدرِ أَنَّني","أُعالِجُ نَفساً هَل تُفيقُ وَتَصبِرُ",63,"ر",1,0],["وَقَد حَذِرتُ النَوى في قُربِ دارِهِمُ","فَعيلَ صَبري وَلَم يَنفَعنِيَ الحَذَرُ",64,"ر",1,0],["وَقَد حَلَّ بي ما كُنتَ عَنهُ بِمَعزِل","لِحَيني فَمَوتي يا سُعادُ قَريبُ",65,"ب",1,0],["وقد حَاز خَمساً رِقَّةً ولَطَافَةً","وحَسناً وإحسَاناً وثَغراً ومَبسَمَا",66,"م",2,0],["وقَد حَاز خَمساً عِزَّةً وصِيَانَةً","ومُلكاً وحَظَّا وافِراً وتَحَكُّمَا",66,"م",2,0],["وقَدحتُ في مُهجِ الشبا","بِ شرارةَ العزمِ الوطيد",67,"د",1,0],["وقد حُلِّيَتْ منها صُدُورٌ بِعَسْجَدٍ","وَلُفَّتْ لَها تَحْتَ الحُلِيِّ شُعُورُ",68,"ر",1,0],["وقد حُبِّرَتْ فيها لك الخُطَبُ التي","بدائعُها نَظْمٌ وألفاظُها نَشْر",69,"ر",1,0],["وَقَد حَمَيتُ لِساني أَن أُبينَ بِهِ","فَما يُعَبِّرُ عَنّي غَيرُ إيمائي",70,"ا",3,0],["وَقَد حَلَفتُ يَميناً","مَبرورَةً لا تُكَذَّب",71,"ب",1,0],["وَقَد حَذِرَ الناسُ سِكّينَهُ","فَكُلُّهُم يَتَّقي شَرَّها",72,"ر",3,0],["وَقَد حالَ هَمٌّ دونَ ذَلِكَ شاغِلٌ","مَكانَ الشِغافِ تَبتَغيهِ الأَصابِعُ",73,"ع",1,0],["وَقَد حارَ هادي الرَكبِ وَاللَيلُ ضارِبٌ","بِأَوراقِهِ وَالصُبحُ لَم يَتَبَلَّجِ",74,"ج",1,0],["وَقَد حَمَلَتهُ فَوقَ نَعشٍ وَطالَما","سَرى فَوقَ عَنسٍ أَو عَلا فَرَساً نَهِدا",75,"د",2,0],["وَقَد حُسِبَت مِن بَناتِ السُهولِ","فَجاءَت بِإِحدى بَناتِ الجَبَل",76,"ل",1,0],["وَقَد حَرَسَ المَمالِكَ حَيُّ لَخمٍ","فَغالَتهُم نَوائِبُ يَحتَرِسنَه",77,"ن",2,0],["وَقَد حَدَّثوا أَنّا اِلتَقَينا عَلى هَوىً","فَكُلُّهُم مِن حَملِهِ الغَيظَ موقَرُ",78,"ر",1,0],["وقد حلَفَتْ أن تَسألَ الشمسَ حاجةً","وإنْ سألَتْكَ اليُسْرَ بَرّتْ يمِينها",79,"ن",3,0],["وقد حُبِستْ أمْواهُها في أديمِها","سِنينَ وشُبّتْ نارُها تحتَ بُرْقُع",80,"ع",1,0],["وَقَدْ حَنَّتِ الأَطْيَارُ فِي وُكُنَاتِهَا","وَقَامَ يُحَيِّينَا عَلَى سَاقِهِ الزَّهْرُ",81,"ر",1,0],["وَقَدْ حَشَدُوا واستَنْفَروا من يَلِيهِمُ","منَ النّاسِ حتَّى جمعُهُمْ مُتَكَاثِرُ",82,"ر",1,0],["وقد حجب الشمسَ الضبابُ كأنَّما","تلا الليلَ ليلٌ عاكرُ اللونِ أسْفَعُ",83,"ع",1,0],["وقد حملوا أرواحَهُمْ في أكفهم","وليس لهم إلاّ الخلود جَزاءُ",84,"ا",2,0],["وقد حل فيه من مهى الإنس فتية","أوانس لا يعرفن شيحا ولا رملا",85,"ل",2,0],["وقد حَسَدَت بغدادُ شَتى عواصمٍ","من الشرق لم تنعُمْ بهذا التفوُّق",86,"ق",1,0],["وقد حَنُّوا اليه كما تلظى","فطيمٌ حول مرضعة تدُر",87,"ر",1,0],["وقد حوسب الكابي بأوهَى ذنوبِه","ولم يؤخَذِ الناجي بأمّ الكبائر",88,"ر",1,0],["وقد حلفتْ بيضُ الظُبا أن تنوَشه","وسمرُ القَنا الخطيِّ أن تتكسَرا",89,"ر",2,0],["وقد حَمِدتُ شفيعاً لي على رَشَدي","أُمّاً وجدتُ على الإسلامِ لي وأبا",90,"ب",2,0],["وقد حرصت على حدي يصاحبني","على الشباب لو أن الحظ يكتسب",91,"ب",1,0],["وقد حار هادي الرّكب، والليلُ ضاربٌ","بأرواقهِ، والصّبْحُ لم يتبَلّجِ",92,"ج",1,0],["وقد حكمتْ بأن الخلْفَ غدْرٌ","كما حكمتْ بأن الوعْدَ عهْدُ",93,"د",1,0],["وقد حفّ الرّماة بجانبيها","وكلّهم على حنق يراها",94,"ا",3,0],["وقد حِيلَ ما بين الحياةِ وبينهُ","فللموت منه بين عَينٍ وحاجب",95,"ب",1,0]]}