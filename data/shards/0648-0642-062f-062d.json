ِ فأَقْلَعا","والليلُ بَيْنَهُما نهارٌ ساطِعُ",177,"ع",1,0],["وَقَدْ حَوَّمَتْ زُهْرُ النُّجومِ كَأَنَّها","كواعِبُ فِي خُضْرِ الحَدائِقِ حُورُ",178,"ر",1,0],["وقد حلبت من الأَيام أَشطرها","وقد قدحت زناد الدَهر فاقتدحا",179,"ح",2,0],["وقد حملت على الأكوار نجبا","إلى الحرمين ترتقل ارتقالا",180,"ل",2,0],["وقد حَّركَ الُمزنض الشتيت فعابرٌ","على عَبرةٍ أو حاضرٌ حِسُّه مِنا",181,"ن",2,0],["وقد حفَّ الظلام بهم وحيناً","تلظى بالمخاوفِ والظنون",182,"ن",1,0],["وقد حلفَتْ واليمينُ البلا","ءُ ظبيةُ لا برَّ منها القَسَمْ",183,"م",1,0],["وقد حَطَّها منبوذةً واستقالَها","مطَا كلِّ ظهرٍ ظنَّ أن سوفَ يحملُ",184,"ل",1,0],["وقد حرصتُ مطلِقاً أعنَّتي","لو أنّ معقولَ القضاء ينطلقْ",185,"ق",1,0],["وقَدَحتْ في أملي عندهُمُ","قادحةٌ لم يك فيها مذنبا",186,"ب",2,0],["وقد حلَّتْ أثيرهُمُ سَجايا","تفوقُ لطافةَ الخمْرِ الشَّمولِ",187,"ل",1,0],["وقد حوتْ مصرُ لأقواماً ذوي أدبٍ","ففي الفواضلِ يا ذا الفضلِ عزِّهم",188,"م",1,0],["وقد حفزتني رحلةُ البين والهوى","سيخلق في الأحشاء ما ليس يخلق",189,"ق",1,0],["وقد حجبتْ عنَّا شموس دياركم","فما بالنا من ففقدها من سمائمِ",190,"م",1,0],["وَقَد حَكَت في قِدرِها الجوذابَه","سَبيكَةً مِن ذَهَبٍ مُذابَه",191,"ه",1,0],["وَقَد حَمَلنا مَعَنا مَفرَشاً","فيهِ تِكاءاتٌ دَبيقِيَّه",192,"ي",2,0],["وقد حالَ ما بيني وبينَ أهيلِها","تَعرُّضُ قفرٍ موحشِ البيدِ واسعِ",193,"ع",1,0],["وقد حمدوا مسراهم إذ تسربلت","ذواتهم بالنور لا بالأباطل",194,"ل",1,0],["وقد حمدوا مسراهم غذ تنفست","طوالع صبح في مفارق غزلان",195,"ن",1,0],["وَقَد حَلَفَت وَالسِترُ بَيني وَبَينَها","بِرَبِّ حَجيجٍ قَد أَهَلّوا وَعَرَّفوا",196,"ف",3,0],["وقدْ حباكَ الكريمُ أوّلَ النعمِ","فلمْ تصُنْها فنُهْ بالسّلم يأتِ غدُ",197,"د",1,0],["وقد حارَتِ الأبصارُ فالكُلُّ شاخِصٌ","على وجَناتِ القومِ والرّيقُ غائِرُ",198,"ر",1,0],["وقد حالت بنو رزيك بيني","وبين الدهر بالمنن الرغاب",199,"ب",1,0],["وقد حملت منك الرواسي ظهورها","من الحزم حتى حان منك ظهورها",200,"ر",3,0],["وقد حصلتم عليها واسم جدكم","محمد وأبوكم خير منتعل",201,"ل",1,0],["وقد حدَّدوا الوقتَ في دَرسِ كُل","لِ فَنِّ مخافَة أَن تَضجَرا",202,"ر",2,0],["وقد ح