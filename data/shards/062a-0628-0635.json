,[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199165","الوافر"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114896","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35657","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199091","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101379","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83358","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57956","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76695","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139527",""],[4884,"الخط صنعة","https://www.poetsgate.com/ViewPoem.aspx?id=210386",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5412,"فعج صاح بالعوج الطلاح إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=181280",""],[709,"لا برَّ في الحبِّ يا أهلَ الهوى قسمي","https://www.poetsgate.com/ViewPoem.aspx?id=30299",""],[5573,"ملامح روح","https://www.poetsgate.com/ViewPoem.aspx?id=200350",""],[243,"عرب الثأر فاهتفي يا ضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=50475",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[6097,"لأيًا بعدَ جيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=190694",""],[6149,"شهدت ليس الشهد غير ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=169627",""]],"verses":[["تَبَصَّر شَبيهَكَ في حُسنِهِ","لَعَلَّكَ تَبلُغُ أَو تَخبُرُ",0,"ر",1,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","كَنَخلِ القُرى أَو كَالسَفينِ حَزائِقُهُ",1,"ق",2,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","سَوالِكَ نَقباً بَينَ حَزمَي شَعَبعَبِ",2,"ب",1,0],["تبصّر خليلي في الزمان فهل ترى","صفا فيه من وقع الشوائب مشرب",3,"ب",1,0],["تبصّر إذا دارت رحى الشرق هل ترى","سوى الجهل في أثناء دورتها قطبا",4,"ب",2,0],["تبصّرْ تجد هذي البسيطة منزلاً","كثير اليتامى عامراً بالمآتم",5,"م",1,0],["تُبَصبِصُ مِنهُ كُلُّ قَوداءَ مُرتَجٍ","إِذا لانَ عَن طولِ الجِراءِ أَباجِلُه",6,"ل",2,0],["تَبَصَّرتُهُم حَتّى إِذا حالَ دونَهُم","رُكامٌ وَحادٍ ذو غَذاميرَ صَيدَحُ",7,"ح",1,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","تَحَمَّلنَ مِن وادي العَناقِ وَثَهمَدِ",8,"د",1,1],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","بِذي نَبِقٍ زالَت بِهِنَّ الأَباعِرُ",9,"ر",1,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","تَجاوَزنَ مَلحوباً فَقُلنَ مُتالِعا",10,"ع",2,0],["تبصر النجم لؤلؤاً","بين ابعادها انتثر",11,"ر",1,0],["تبصر فيها زبدا رائبا","تحمله الأمواج إذ تزخرُ",12,"ر",1,0],["تُبصِرُهُ في كلِّ أحوالِه","عُريانَ يكسو الناسَ أو يُعري",13,"ر",2,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","كَما زالَ في الصُبحِ الأَشاءُ الحَوامِلُ",14,"ل",1,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","تَحَمَّلنَ بِالعَلياءِ مِن فَوقِ جُرثُمِ",15,"م",1,0],["تُبصِرُهُ بَعدَ اِنتِشارِ الوَردِ","مِثلَ الدَبابيسِ بِأَيدي الجُندِ",16,"د",1,0],["تَبَصَّرَ صاحِبي أَتَرى حُمولاً","تُساقُ كَأَنَّها عَومُ السَفينِ",17,"ن",1,0],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","سَلَكنَ غُمَيراً دونَهُنَّ غُموضُ",18,"ض",1,1],["تَبَصَّر خَلِيلَي هَل تَرى مِن ظَعائِنٍ","رَحَلنَ بِنصِف الليلِ مِن بَطنِ مُنعِمِ",19,"م",1,0],["تُبْصِرُ العَيْنانِ منه إِنْ بَدا","قَمَرَ السَّرْجِ وشَمْسَ المَوْكِبِ",20,"ب",1,0],["تُبصِرُ الناس تحت إمرَته الحمقاء","اسرى مكبّلين وقَتلى",21,"ل",2,0],["تُبْصِرُ الكلَّ ثمَّ حتى الصَّبايا","فوقَ سِيمائهم هناءٌ وطِيب",22,"ب",1,0],["تبصر خليلي في الزمان فهل ترى","صفا فيه من وقع الشوائب يتحلب",23,"ب",1,0],["تبصر خليلي هل ترى من ظعائن","سوالك نقباً بن حزمي شَعَبْعَب",24,"ب",1,0],["تبصر جمالك في عيني مرتسما","وقد ترى الدمع يخفيه إلى حين",25,"ن",1,0],["تُبصِرُ الناسَ عليه","كألاعِيبٍ تَدور",26,"ر",1,0],["تُبصِرْ جِباهَ ملوكِ الأرضِ ساجِدةً","على ثرىً هو فيها أشرفُ الذَّمم",27,"م",1,0],["تبصر النهر فتلقى ماءه","حذراً في سيره مثل الهيوب",28,"ب",1,0],["تَبصقُ الرجس عَن عفاف وَطُهر","وَاللآلي تَبقى بِها فَتَغورُ",29,"ر",1,0],["تبصر سماتِ جماله","يظهرنَ أي المستدل",30,"ل",1,0],["تبصَّرْ تجد أنَّ المنيةَ يقظةٌ","إذا كان عيشُ المرءِ في دهره حلما",31,"م",2,0],["تَبِصُّ كَأَنَّها عُجُزٌ فَوانٍ","وَقَد بَثِرَت وَلَيسَ لَها عِفاءُ",32,"ا",2,0],["تَبَصَّرَت لِمُبصِرٍ مَحَجَّتي","وَحُجَّتي عَبرَةُ مَن لَها اِعتَبَر",33,"ر",1,0],["تَبَصَّر بِنورِ الحَقِّ تَلقَ حَقيقَةً","بِعَينِ يَقينِ لا يُدافِعُها الظَنُّ",34,"ن",1,1],["تَبَصَّر خَليلي هَل تَرى مِن ظَعائِنٍ","تَحَمَّلنَ أَمثالَ النِعاجِ عَقائِلُه",35,"ل",2,0],["تبصر خليلي هل ترى من ظعائن","غدونَ لبينٍ من نوى الحي أبيّنِ",36,"ن",1,0],["تبصَّر في الأُمور وحنكته","التجاريب اختباراً واعتبارا",37,"ر",2,0],["تبصر أراك اللَه رأي جهينة","لتعلم في عقباك تدبير حالكا",38,"ك",2,0],["تبصّر واضرب الضربات بكرا","معاذ الله أن تنسى معاذا",39,"ذ",2,0],["تُبصِرها عينيَ مذ فارقتَها","بمقلةٍ شخصُك في إنسانِها",40,"ن",3,0],["تبصر الغاشين حولَيْ بابه","أبداً رَكْباً ورَجْلَى سُمُطا",41,"ط",2,0],["تُبصر من عظامهِ وجِلدهِ","إذا اكتسى اللُّجينَ فوق العسجد",42,"د",1,0],["تَبَصَّرُوها مِراحاً في أعِنَّتِها","يجفن ما بين مقتولٍ ومطرودِ",43,"د",1,0],["تبصّروا فقضَوْا نَحباً وما قُبِضوا","لِذا يُعدّونَ أحياءً لمَوتهمِ",44,"م",1,0],["تبَصَّرْ خَلِيلي هل تَرى مِنْ ظَعائِنٍ","خَرَجْنَ سِراعاً واقْتَعَدْنَ المَفائِما",45,"م",2,0],["تبصره في الناس ذا محنةٍ","وربما بعضهم عيَّرَه",46,"ر",2,0],["تبصِر الهمِّ في الأَقاصِي فتنْفِي","هِ ولا غرْو فالحَبَابُ عُيُون",47,"ن",1,0],["تبصر في الأمور فلاح منها","فلاح كان بعد الليل فجرا",48,"ر",2,0],["تبصر هديت الرشدان كنت مبصرا","بعين وإلا ضاع كل ضياء",49,"ا",2,0],["تُبصِرُهُ دهرَه قاعداً","وهو بأعبائهِ قائمُ",50,"م",1,0],["