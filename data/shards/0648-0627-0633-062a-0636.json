{"poems":[[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[87,"ما وصل من تهوى على أنسة","https://www.aldiwan.net/poem7121.html","السريع"],[87,"بين سمع الله والبصر","https://www.aldiwan.net/poem7590.html","المديد"],[76,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[92,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[159,"لطمت بعناب البنان شقائق","https://www.aldiwan.net/poem55730.html","الكامل"],[164,"هكذا فلتكن إلى الغلمان","https://www.aldiwan.net/poem58854.html","الخفيف"],[190,"قد سقط العار فلا عار","https://www.aldiwan.net/poem43823.html","السريع"],[302,"شق الدجى عن نحره الفجر","https://www.aldiwan.net/poem33263.html","أحذ الكامل"],[302,"برق الحمى لاح مجتازا على الكثب","https://www.aldiwan.net/poem33336.html","البسيط"],[438,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[466,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136179","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50020","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108538","البسيط"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93661","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132305","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132781","الخفيف"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99318","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110004","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35527","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111402","الخفيف"],[4984,"الْعَهْدُ الْجَدِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=209104",""],[5186,"في ليلة القدر أتاح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=156523",""],[5485,"قل للمعلى","https://www.poetsgate.com/ViewPoem.aspx?id=200785",""],[243,"عرب الثأر فاهتفي يا ضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=50475",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5309,"قالوا اترجو من الهك نصرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573557",""]],"verses":[["واسْتضحكت فلها في كلّ ناحيةٍ","هبات حسنٍ وفي الآناف هبات",0,"ت",1,0],["واستضحك الماءُ فهاج البكى","في كل خدر لبنات الهديل",1,"ل",1,0],["واستضاء العالمون نهى","بمبين الآى والسور",2,"ر",1,0],["وَاِستَضحِكِ المَجلِسَ عَن قَهوَةٍ","قَد نَبَّهَت لِلصُبحِ هُدأً فَهَب",3,"ب",1,0],["واستضحك الشط من لئلاء طلعته","كأنه قِطِعِاتٌ من قوارير",4,"ر",1,0],["واسْتَضْحَكَتْ فَبَكَيْتُ قالَتْ لا تَخَفْ","بي فَوقَ ما بِكَ يا أَخَا الوَجْدِ",5,"د",1,0],["واستضعف فيه فوق ملكك هذا","خير ملكٍ تحظى به الجنانَ",6,"ن",1,0],["واستُضعِفَ الحق وقلّ الحيا","وصار للجُهّالِ أنصارُ",7,"ر",1,0],["واِستَضحِكِ الدهرَ العَبوسَ بها","فبمثلها يُستَضحَكُ الدَهرُ",8,"ر",1,0],["واِستَضحكوا الدَهر عَن لَهوٍ فقد ضحكت","كأَسُ المُدامة عَن ثَغرٍ من الحَبَبِ",9,"ب",1,0],["واستضحك الثغرُ عن مُفَضَّلهِ","بما ارْتَضَى اللهُ جِدَّهُ ودَدَه",10,"د",2,0],["واستضحكت فيه بيض الهند من نهل","واستعبر الهامُ من سَح وامدادِ",11,"د",1,0],["واستضيئو بجمال","فاق في الحسن تفرد",12,"د",1,0],["وَاسْتَضْحَكَ الْزَّهرُ والنُّوارُ مُبْتسماً","قَدْ غَادَرَتْ فيهِ أَنْفاسُ الصِّبا بَلَلا",13,"ل",2,0],["واستضحكت ونأت عني وما سمحت","بالري إذ لمحت رأسي قد اشتهبا",14,"ب",2,0],["واستضعفوا أهل دين اللّه فاصطبَروا","لكلّ معضلِ خطبٍ فادح جلَل",15,"ل",1,0],["واستَضعَفوا الأمْرَ من أقصى الجَرِيدِ إلى","ما دونَ صَبرَةَ لاَ يَنْهَاهُم رَهَبُ",16,"ب",1,0],["وَاستضافَت قراك وَالعبربيُّ ال","محض يَستعجل القرى للضيوف",17,"ف",1,0],["واستضعفوهم واستقلُّوا جيشَهُم","فتجحفَلوا كَسَنائِن المَيلاءِ",18,"ا",2,0],["واستضاءت بظل عدل ظليل","في حمى دولة الرشاد العليه",19,"ي",2,0],["وأستضحكت عن الآل أو حصى برد","يكاد يقطر من مائية الشلب",20,"ب",1,0],["واستضاءَت بدورُهُ وتجلَّت","حيث جلَّت عن ذُلّ نقص الخُسوفِ",21,"ف",1,0],["وَاِستَضحَكَت مِن لمتى إذ رَأَت","مُبيضّها أَودى بِمسودّها",22,"د",3,0],["واستضغِيثي إِن كُنتش حَقًّا بِقَولٍ","أَو بِفِعلٍ خَلَبتش يَوماً فُؤَادَه",23,"د",2,0],["واستضعفوا شأن الجهاد فصيَّروا","قَدَرَ الرضوخ مصيرها ومآلها",24,"ل",3,0],["واستضرع البغل حنينا إلى","وزارة العدل ونشر الأمان",25,"ن",1,0],["واستضحكت عن سخطه","أرماحه ونصاله",26,"ل",2,0],["واستضاءت بسمة من شهيد","ومشت فوق معبر من جراح",27,"ح",1,0],["واستضعفوه.. فقرّروا إذلالهُ","فأبتْ كرامتُهُ له أن يخضعا",28,"ع",2,0],["واستضعفتني على الأيام شدتُها","واستحكم البغي والعدوانُ والصخبُ",29,"ب",1,0],["وَاستَضحَكَ الفاني مِنَ الباقي وَلَم","يَبكِ الظَّلومُ عَلَى البُدورِ الآفِلَه",30,"ل",2,0]]}