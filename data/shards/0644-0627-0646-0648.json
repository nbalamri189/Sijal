oetry.dctabudhabi.ae/diwan/poem/198891","الطويل"],[1953,"","https://poetry.dctabudhabi.ae/diwan/poem/123873","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110266","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28476","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28526","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131275",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40163","الخفيف"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78230","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81929","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81711","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133168","الطويل"],[4691,"حجم قهري","https://www.poetsgate.com/ViewPoem.aspx?id=85442",""],[4755,"دَاوَى بِكِ اللهُ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=194875",""],[4755,"مأساة سُهَيل اليَمَاني ( 3 )","https://www.poetsgate.com/ViewPoem.aspx?id=210756",""],[4904,"كانَ الْقِرى لَحْمي","https://www.poetsgate.com/ViewPoem.aspx?id=175727",""],[5030,"سهر","https://www.poetsgate.com/ViewPoem.aspx?id=215698",""],[5064,"فانُوسُ اللَّيَالِي","https://www.poetsgate.com/ViewPoem.aspx?id=199168",""],[5135,"مَا أَخْلَفَ الرَّحْمَٰنُ يَوْماً مَوْعِدَا","https://www.poetsgate.com/ViewPoem.aspx?id=201976",""],[5174,"في يوم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=185487",""],[5284,"هدية لابن أخي عزام","https://www.poetsgate.com/ViewPoem.aspx?id=190601",""],[5431,"بصرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=199811",""],[5573,"ارموز خط وبعد شط ودلو بير وعمق طي","https://www.poetsgate.com/ViewPoem.aspx?id=200172",""],[5674,"أنت نجم في مداراتي","https://www.poetsgate.com/ViewPoem.aspx?id=189349",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6340,"وجه أمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85837&r=&rc=2",""]],"verses":[["لا نَوْمَ حتى تَقودوا الخَيلَ عابِسَة ً","يَنْبُذْنَ طِرْحاً بمُهْراتٍ وأمْهارِ",0,"ر",1,0],["لِأَنوارِ نورِ النورِ في الخَلقِ أَنوارُ","وَلِلسِرِّ في سِرِّ المُسِرّينَ أَسرارُ",1,"ر",1,1],["لأن وجهي بقبح صورته","ما زال لي كالمشيب والصَّلعِ",2,"ع",1,0],["لانوا لَها في شِدَّةٍ وَصَلابَةٍ","لَينَ الحَديدِ مَشَت عَلَيهِ النارُ",3,"ر",1,0],["لا نومَ بعدَ اليّوم عن أسلابنا","فَخُذِي العُهودَ ورَدِّدي الأخبارا",4,"ر",2,0],["لانوا بأيدي الغاصِبينَ فلم تَلِنْ","للقومِ في جِدّ الأُمورِ قَناةُ",5,"ه",1,0],["لا نورَ في الآفاق إلا أن ترى","طيارة قد طاردتها أسهم",6,"م",1,0],["لأَنوار نور الدين في الخلق أنوارُ","وللسرّ في سرّ المسرّين أسرار",7,"ر",1,1],["لانوا لمهماشا وقالوا اشترط","إن نكرم الجار ولا نولمه",8,"م",2,0],["لانَ وَلَكِن صَلبٌ لِعاجِمِهِ","وَالغُضنُ اللَدنُ شَأنُهُ الخَوَرُ",9,"ر",1,0],["لا نؤاخذ عبدَ الرَحيم بقول","أَو بفعل وأَنتَ بروصول",10,"ل",1,0],["لِأَنَّ وَلِيَّ أَمري في زَماني","عَلى أَهلِ التَحَدّي قَد تَحَدّا",11,"د",2,0],["لا نوح أصلاً حيث راحةُ بَشرَةٍ","ذا سابحٌ يوماً وذلك رامح",12,"ح",1,0],["لا نوبُ الدهرِ حينَ تطرُقُهم","تُنصفني منهم ولا النِّعَمُ",13,"م",1,0],["لانوا على العيش وخا","فوا فَوتها فعنفُوا",14,"ف",3,0],["لا نوا ففيهم شرق الماء لل","صَّادي وما فيهم صفاءُ الزلَّال",15,"ل",1,0],["لأنَّ وَريثَ الضَّوءِ يَسطعُ مثلَهُ","وَمَعدنُ هذا مثلُ ذا ليسَ يَصدأ ُُ",16,"ا",1,0],["لِأَن وَجَدَت نَفسي مِنَ الحُبِّ سَلوَةً","فَعادَت إِلى مَن لا يَجودُ لِعاشِقِ",17,"ق",1,0],["لا نومُها عادَ ولا طيفُهمْ","بعدَ النوى والبينِ طرّاقُ",18,"ق",1,0],["لاَِنَّ وِلْدَ البِنْتِ عِنْدَ العَرَبِ","لِجَدِّهِمْ لاَُِمِّهِمْ لَمْ تُنْسَبِ",19,"ب",1,0],["لا نومَ حتَّى تعيدَ الشمَّ عزمتكم","قاعاً بها لا ترى أمتاً ولا عِوجا",20,"ج",2,0],["لِأَنوارِ نورِ اللَه في القَلب أَنوارُ","وَللسرّ في سرّ المُحبّين أَسرارُ",21,"ر",1,1],["لا نومَ إلّا على خوف وزلزلة","فيها ولا ضوء إلّا النارُ والشرَرُ",22,"ر",1,0],["لا نُوالي لَكُم عَدُوّاً وَلا نَح","مِلُ ضِغناً عَلى الوَلِيِّ الوَدودِ",23,"د",1,0],["لا نَومَ إلّا غِرارُ العَينِ ساهِرَةً","إن لم أُرَوِّع بِغَيظٍ أهلَ مَطلوبِ",24,"ب",1,1],["لأنواره في وجه آدم جلوة","وفي حوا حين فرت به حملا",25,"ل",2,0],["لا نوم حتى تبعج البواعِجا","والرمث بالصريمة الكنافجا",26,"ج",2,0],["لا نوره نور ولا ناره","كظل نار شبها في حشاي",27,"ا",2,0],["لانوا وَفيهِم لِلعِدى قَسوَة","وَالغَيثُ مَرجُوٌ وَمَرهوبُ",28,"ب",1,0],["لانوا وَفيهِم لِلعَدُوِّ قَساوَة","كَالماءِ يُغرِف وَهوَ غَيرُ مُكَدَّرِ",29,"ر",1,0],["لا نومَ حتّى يكتَحِلنَ بماجِدٍ","يَضَعُ اللحاظَ مواضعَ الإسهابِ",30,"ب",1,0],["لا نور في الأفق الشرقي نلمحه","ما دمت في الأفق الغربي تزدهر",31,"ر",1,0],["لا نُؤَدّي لِأَنْعُمِ اللَّهِ شُكْراً","بِكَ يا أَعظَمَ البَرِيَّةِ قَدرا",32,"ر",2,1],["لا نوصى ثَكلى قَد أَذابَ وَتينُها","حُزن عَلَيكَ وَحَسرَة وَزَفير",33,"ر",1,0],["لأنَّ وراء الغاية الحجة التي","متى تطلب الإدراك يبعدك المرمى",34,"م",2,0],["لا نور يعدل نور اللوز في أنق","وبهجة عند ذي عدل وإنصاف",35,"ف",1,1],["لأنوارهم تسعى الوفودُ ونارهم","بهم قد كفى جوع وطاب هجوع",36,"ع",1,0],["لا نور فيه يُرجّى","سوى اشتعالات جمرِ",37,"ر",1,0],["لا نَومَ في النَّومِ.. لكنْ تُصبحِينَ على","خَيرٍ -كَقَلبي- وشِعرٍ صِرتِ قافِيَتَهْ",38,"ت",2,0],["لَانُوا لِمَن عاثَ، أَجسادًا وأَفئِدَةً","والنَّارُ تَأكُلُ حتى الصَّخرَ إِن لانا",39,"ن",2,0],["لا نُورَ ثَمَّ وَلا ضِياءَ تَوَقَّفي","ذاكَ السَّرابُ وَوَهْمُهُ أَوْهى لَنا",40,"ن",2,0],["لا نومَ يأتي ولا طيفٌ يعانقني","ولا نديمٌ يُعرِّي ليليَ القاسي",41,"س",2,0],["لا نُورَ فِي أرضِ الغِيَابِ فغيهَبٌ","يمضِي بوحشتِهِ ويأتِي غيهَبُ",42,"ب",1,0],["لَا نَوْمَ لِيْ حَتَّىٰ أُشَاهِدَ فَجْرَها","مَا كَانَتِ الظُّلُمَاتُ يَوْماً سَّرْمَدَا",43,"د",2,0],["لا نور يعلو فوق نور حماتها","من عابها فقد العروش وحُطّمَا",44,"م",2,0],["لانورَ يشبهُ نورَ وحيِ إلهِنا","هذا كلامُ الخالقِ الرَّحمَنِ",45,"ن",1,0],["لأنّ وجهك فردوسٌ به حفلت","مراكب الخلق فا لآلاء من فجرك",46,"ك",1,0],["لانول غط وحد شط يحط وسط العوج غمد","وغم هم وعم سم وشفت ظيم وذقت شي",47,"ي",1,1],["لانورسٌ صادحٌ في درب قافيتي","والليل يعزف أوجاع المعاناةِ",48,"ه",1,0],["لا نوح ما ناح الحَمام المطوق","وَابكي كَما بَكى الغراب وَقار",49,"ر",1,0],["لانور يسعفني.. إلاكِ يا ألقا","من مقلتيه همى.. في خلوتي الشجر",50,"ر",1,0],["لانور غيرك.. في أضواء زيفهمُ","تبْكي على كتفيه.. الشمس والقمر",50,"ر",1,0]]}