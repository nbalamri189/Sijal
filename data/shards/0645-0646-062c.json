{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[55,"قد خفت أن لا أراكم آخر الأبد","https://www.aldiwan.net/poem26393.html","البسيط"],[57,"زن من وزنك بما وزنك","https://www.aldiwan.net/poem24623.html","مجزوء الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[77,"رقمت أنامل صانعي ديباجي","https://www.aldiwan.net/poem36667.html","الكامل"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[93,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[93,"يا عائداً برعاية الرحمن","https://www.aldiwan.net/poem11169.html","الكامل"],[93,"لك يا يوسف العزيز مثال","https://www.aldiwan.net/poem11204.html","الخفيف"],[93,"خفقت لطلعة وجهك الأعلام","https://www.aldiwan.net/poem11374.html","الكامل"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[88,"من جور مصر على العروبة أنها","https://www.aldiwan.net/poem44419.html","الكامل"],[23,"إني حلفت يمينا غير كاذبة","https://www.aldiwan.net/poem21356.html","البسيط"],[72,"رشأ رشفت رضابه أو ثعلب","https://www.aldiwan.net/poem19252.html","الطويل"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"يا مظهرا نخوة عند اللقاء لنا","https://www.aldiwan.net/poem61944.html","البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"ذقت الطعوم فما التذذت كراحة","https://www.aldiwan.net/poem62995.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"سائل أبا الصقر إذا جئته","https://www.aldiwan.net/poem65723.html","السريع"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[89,"ما رأت في الناس عيني","https://www.aldiwan.net/poem44968.html","مجزوء الرمل"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[45,"يا أبا جعفر غدونا حديثا","https://www.aldiwan.net/poem64636.html","الخفيف"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[28,"أي الخلائق ليست في رقابهم","https://www.aldiwan.net/poem5494.html","البسيط"],[28,"يا سائلي أين حلّ الجود والكرم","https://www.aldiwan.net/poem25438.html","البسيط"],[99,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[58,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem30913.html","السريع"],[49,"من جعل الدهر على باله","https://www.aldiwan.net/poem63091.html","السريع"],[49,"على رسول الله مني السلام","https://www.aldiwan.net/poem63104.html","السريع"],[49,"منجاب مات بدائه","https://www.aldiwan.net/poem63214.html","مجزوء الكامل"],[49,"قد نغص الموت علي الحياة","https://www.aldiwan.net/poem65364.html","السريع"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[87,"أترك الدنيا فلست ترى","https://www.aldiwan.net/poem8208.html","المديد"],[69,"وقائل هل طرفه فاتر","https://www.aldiwan.net/poem28249.html","السريع"],[69,"منجم تحته والميل قد نصبا","https://www.aldiwan.net/poem28278.html","البسيط"],[69,"يا آل بيت النبي من بذلت","https://www.aldiwan.net/poem28714.html","المنسرح"],[74,"وأشقر تضرم منه الوغى","https://www.aldiwan.net/poem12966.html","السريع"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"طلحة الخير طلحة الجود أبشر","https://www.aldiwan.net/poem44024.html","الخفيف"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"قد أغتدي في فلق الإصباح","https://www.aldiwan.net/poem62541.html","الرجز"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[50,"اسقني يابن أسعدا","https://www.aldiwan.net/poem63949.html","مجزوء الخفيف"],[46,"من جالس المغتاب فهو مغتاب","https://www.aldiwan.net/poem22376.html","الرجز"],[46,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[23,"","https://poetry.dctabudhabi.ae/diwan/poem/6557","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[57,"زن من وزنك بما وزنك","https://www.poetsgate.com/ViewPoem.aspx?id=3275",""],[45,"يا أبا جَعْفَرٍ! غَدَوْنَا حَديثاً","https://www.poetsgate.com/ViewPoem.aspx?id=31133",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"قل للأمير الطاهريّ الماجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27627",""],[51,"ذقتُ الطعوم فما التذذت كراحة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29081",""],[23,"إنّي حَلَفْتُ يَمِيناً غيرَ كاذِبَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12805&r=&rc=9",""]],"verses":[["مِن جائِدٍ أَو ذائِدٍ أَو عاقِرٍ","أَو ماطِرٍ أَو مُنعِمٍ أَو مُرغِمِ",0,"م",1,0],["مِن جاهِدٍ خابَ وَمِن طالَبٍ","أَوفى عَلى الفَجِّ وَلَم يَطلُعِ",1,"ع",1,0],["مُنجَفِلاً مَعَ الرَدى مُنجابا","فَلِم سَنَنتُ الصارِمَ القِرضابا",2,"ب",2,0],["مَن جَاوَرَتهُ جَرى بِالسَعدِ طَالِعُهُ","وَمَن رَآها فَلَن يَخشَى الرَمَدِ",3,"د",1,0],["مَن جا إِلَيكَ فَرُح إِلَي","هِ وَمَن جَفاكَ فَصُدَّ عَنهُ",4,"ن",2,0],["مَنْ جاءَ منْهُمْ مثْلَ جودِكَ كلّما","حسَبوا المَكارِمَ كُسْوَةً أوْ كِيسا",5,"س",2,0],["منْ جَمادٍ يُقِرُّ أو قَمَرٍ يَنشَق","قُ والماءُ منْ بَنانِ الرّاحِ",6,"ح",1,0],["مَنْ جاءَني يشْكو الظَّماء فمَوْرِدي","صِرْفُ الزُّلالِ العَذْبِ دونَ مِزاجِ",7,"ج",1,0],["مَن جادَ مِن بَعدِ السُؤالِ فَإِنَّهُ","وَهوَ الجَوادُ يُعَدُّ في البُخّالِ",8,"ل",1,0],["منجبة النشء كأخوالهم","مجداً وكالأعمام بالفخر",9,"ر",1,0],["مِنْ جَانِبِ البَحْرِ المَهِيجِ تَجُوزُهُ","فِي الجَوِّ أَوْ مِنْ جَانِبِ البُركَانِ",10,"ن",1,0],["مِنْ جَمَالِ الشَّبَابِ المُحيَّا","وَجلِ المَشِيبِ تَاجِ اللُّجَينِ",11,"ن",1,0],["مُنِجِي البِلادَ وَمُسْتَعِيدُ حُقُوقِهَا","مَاذَا يَفِي مِنْ حَقِّهِ الإِعْظَامُ",12,"م",1,0],["من جمال الحضر لمحا","وعليها أنت تحلّق",13,"ق",1,0],["من جور مصر على العروبة أنها","تتعمّد التمصير في آدابها",14,"ب",3,1],["مِن جِذمِ غَسّانَ مُستَخٍ حَمائِلُهُم","لا يُغبَنونَ مِنَ المَعزى إِذا غابوا",15,"ب",3,0],["من جودهِ ذهبٌ ومن ألفاظه","دُرَرٌ تباح لنا ونحن نصوغ",16,"غ",1,0],["مِن جَوارٍ ساقِياتٍ","وَسَواقٍ جارِياتِ",17,"ت",1,0],["مُنْجحُ القيل ما علمتُ وحاشا","لخليلي من تَرْحةِ الإكداءِ",18,"ا",2,0],["من جوادٍ وماجدٍ وكريمٍ","وزعيمٍ وسيِّدٍ ونقيبِ",19,"ب",1,0],["من جَوارٍ كأنهنَّ جَوارٍ","يتسلسلنَ من مياهٍ عِذابِ",20,"ب",1,0],["من جاد ساد ومن لم يأت عارفةً","ولم يَجُدْ لاكتساب المجد لم يَسُدِ",21,"د",1,0],["من جودُه الجودُ الشهي","رُ وبذله البذلُ الستيرُ",22,"ر",1,0],["من جميع الزَّين كاسٍ","من جميع الشَّين عاري",23,"ر",2,0],["من جور إخوان الصفاء سرورهم","بتفاضل الأحوال والأخطار",24,"ر",1,0],["منجاةُ هاربه محل طريده","منهاة طالبه غياث لهيفه",25,"ف",2,0],["من جمع الأموال من مثل ما","جمَّعته لم يلج في ضيق",26,"ق",1,0],["مَنْ جاد بالحَوْباء جاد بمالهِ","فالمالُ أيسرُ هالكٍ تعجيلا",27,"ل",2,0],["من جامد الكف حين تسأله","وخائن الحبلِ عندَ إعصامي",28,"م",2,0],["مَنْ جَاشَ بالوحي المقدَّسِ قلبُه","لم يحتفل بحِجَارةِ الفلتاءِ",29,"ا",2,0],["من جمالٍ وكمالٍ","حَسُنَا في كل عين",30,"ن",1,0],["من جؤذر ثَم يرنو","وشادن مختال",31,"ل",1,0],["مَن جَعَل المَغربَ مَطلَعَ الضُحى","وَسَخَّر البَربر جُنداً لِلهُدى",32,"ا",1,1],["مِن جَهلِهِم بِالدينِ وَالدُنيا مَعاً","عَبَدوا الأَصَمَّ وَأَلَّهوا التِمثالا",33,"ل",2,0],["مِن جِعادِ الأَكُفِّ غَيرِ جِعادٍ","وَغِضابِ الوُجوهِ غَيرِ غِضابِ",34,"ب",1,0],["مِن جَوادٍ سَمحٍ يُجَمِّشُ بِاللَح","ظِ ذَكاءً فَيَفهَمُ التَعريضا",35,"ض",2,0],["مِن جَهيرِ الخِطابِ يُضعِفُ فَضلاً","عِندَ حالَي تَأَمُّلٍ وَاِستِماعِ",36,"ع",1,0],["مَن جَعَلَ الإِسرافُ يَقتادُهُ","فَقَد أَراني مايَراهُ الخَليع",37,"ع",1,0],["مَن جَدُّهُ دانَ فَضلُ الأَنبِياءِ لَهُ","وَفَضلُ أُمَّتِهِ دانَت لَهُ الأُمَمُ",38,"م",1,0],["مَنْ جَدُّهُ دَانَ فَضْلُ الآنْبِيَاءِ لَهُ","وَفَضْلُ أُمَّتِهِ دَانَتْ لَهَا الاُمَمُ",39,"م",1,0],["من جرب الكي لا ينسى مواجعه","ومن رأى السم لا يشقى كمن شربا",40,"ب",2,0],["من جراح المناضلين.. ولدن","ومن الجرح تولد الكبرياء",41,"ا",2,0],["مِن جِذمِ ذُبيانَ تَنميهِم ذَوائِبُها","إِلى أَرومَةِ عِزٍّ غَيرِ مُحتَقَرِ",42,"ر",1,0],["مَن جاوَرَ النِعمَةَ بِالشُكرِ لَم","يِخشَ عَلى النِعمَةِ مُغتالَها",43,"ل",3,0],["مَن جَعَلَ الدَهرَ عَلى بالِهِ","أَمَّ بِهِ أَفظَعَ أَهوالِهِ",44,"ل",2,1],["مَن جاوَرَ الرَحمَنَ فيدارِهِ","تَمَّت لَهُ النِعمَةُ كُلَّ التَمام",45,"م",1,0],["مِنجابُ ماتَ بِدائِهِ","فَاعجَل لَهُ بِدَوائِهِ",46,"ا",3,1],["مَن جاوَرَ المَوتى فَقَد أَبعَدَ ال","دارَ وَقَد جاوَرَ قَوماً جُفاة",47,"ا",2,0],["من جَحْفَلٍ ضَمِنَ الفتحُ المبينُ له","ذُلَّ الأعادي بعزِّ النَّصرِ والظّفَرِ",48,"ر",1,0],["مَنْ جَرَى فِي غَيْرِ حَلْبَتِهِ","كَانَ مَوْقُوفَاً عَلَى الظِّنَنِ",49,"ن",1,0],["مِنْ جبلِ الريانِ أردافُهُ","وصدغُهُ المعطوفُ مِنْ قافِ",50,"ف",1,0],["مُنَجِّمٌ تحتَهُ والميلُ قدْ نصبا","فخانَهُ عقلُ مَنْ يهواهُ معقولُ",51,"ل",1,1],["مَنْ جاءَ عَنْ بيتِهِ يحدِّثُكم","قولوا لهُ البيتُ والحديثُ لنا",52,"ن",2,0],["مِن جُلَّنارٍ ناضِرٍ خَدُّهُ","وَأُذُنُهُ مِن وَرَقِ الآسِ",53,"س",1,0],["مِن جانبِ الغيلِ المنيعِ تتابعت","وَثَباتُه وتجاوب الإرعادُ",54,"د",1,0],["مِن جَزُورٍ نحرتَها تُطعمُ الجي","شَ وتشفيهِ من أذىً وارْتِماضِ",55,"ض",1,0],["من جاءَ منكم لا يُرَدُّ ومن يَجيءْ","مِنّا فمردودٌ إلينا مُسْلَم",56,"م",1,0],["مَن جانبَ الحقَّ أردته عَمايتُه","وأحزمُ الناس من بالحق يعتصمُ",57,"م",1,0],["مُنجِ ذي الخَيرِ مِن سَفينَةِ نوحٍ","يَومَ بادَت لَبنانِ مِن أُخراها",58,"ا",1,0],["من جاحِدي الدِّينِ والحقِّ المُنير ومن","عادي الأئِمّةِ والكُفّار بالرُّسُل",59,"ل",1,0],["مُنَجِّدٌ يَأشَرُ لِلصِياحِ","ما البَرقُ في ذي عارِضٍ لَمّاحِ",60,"ح",1,0],["مِن جَذبِ أَلوى لَو نَتَر","إِلَيهِ طوداً لَأَنأَطَر",61,"ر",1,0],["مِن جَنى النَحلِ بِالنُقا","خِ زُلالاً مُبَرَّدا",62,"د",2,0],["مَن جالَسَ المُغتابَ فَهوَ مُغتاب","لَستُ عَلى كُلِّ جَنىً بِعَتّاب",63,"ب",1,1],["مَن جَبرَئيلُ إِذا تُخَوِّفُهُم","لا إِيلُ عِندَهُمُ وَلا جَبرُ",64,"ر",1,0],["مَن جاء يسألُ عنهمُ من جاهلٍ","لم يرو سَغباً من دمِ الأوداجِ",65,"ج",1,0],["من جرية الوحي على لسانه","أعيا المجيدين مدى إحسانه",66,"ه",1,0],["من جوهر الحق المبين فصوصه","جبريل وهو به القديم خصومه",67,"ه",1,0],["