4,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[529,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[529,"في حاديات الليالي للفتى عجب","https://www.aldiwan.net/poem37535.html","البسيط"],[544,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[561,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"]],"verses":[["مِن جائِدٍ أَو ذائِدٍ أَو عاقِرٍ","أَو ماطِرٍ أَو مُنعِمٍ أَو مُرغِمِ",0,"م",1,0],["مِن جاهِدٍ خابَ وَمِن طالَبٍ","أَوفى عَلى الفَجِّ وَلَم يَطلُعِ",1,"ع",1,0],["مُنجَفِلاً مَعَ الرَدى مُنجابا","فَلِم سَنَنتُ الصارِمَ القِرضابا",2,"ب",2,0],["مَن جَاوَرَتهُ جَرى بِالسَعدِ طَالِعُهُ","وَمَن رَآها فَلَن يَخشَى الرَمَدِ",3,"د",1,0],["مَن جا إِلَيكَ فَرُح إِلَي","هِ وَمَن جَفاكَ فَصُدَّ عَنهُ",4,"ن",2,0],["مَنْ جاءَ منْهُمْ مثْلَ جودِكَ كلّما","حسَبوا المَكارِمَ كُسْوَةً أوْ كِيسا",5,"س",2,0],["منْ جَمادٍ يُقِرُّ أو قَمَرٍ يَنشَق","قُ والماءُ منْ بَنانِ الرّاحِ",6,"ح",1,0],["مَنْ جاءَني يشْكو الظَّماء فمَوْرِدي","صِرْفُ الزُّلالِ العَذْبِ دونَ مِزاجِ",7,"ج",1,0],["مَن جادَ مِن بَعدِ السُؤالِ فَإِنَّهُ","وَهوَ الجَوادُ يُعَدُّ في البُخّالِ",8,"ل",1,0],["منجبة النشء كأخوالهم","مجداً وكالأعمام بالفخر",9,"ر",1,0],["مِنْ جَانِبِ البَحْرِ المَهِيجِ تَجُوزُهُ","فِي الجَوِّ أَوْ مِنْ جَانِبِ البُركَانِ",10,"ن",1,0],["مِنْ جَمَالِ الشَّبَابِ المُحيَّا","وَجلِ المَشِيبِ تَاجِ اللُّجَينِ",11,"ن",1,0],["مُنِجِي البِلادَ وَمُسْتَعِيدُ حُقُوقِهَا","مَاذَا يَفِي مِنْ حَقِّهِ الإِعْظَامُ",12,"م",1,0],["من جمال الحضر لمحا","وعليها أنت تحلّق",13,"ق",1,0],["من جور مصر على العروبة أنها","تتعمّد التمصير في آدابها",14,"ب",3,1],["مِن جِذمِ غَسّانَ مُستَخٍ حَمائِلُهُم","لا يُغبَنونَ مِنَ المَعزى إِذا غابوا",15,"ب",3,0],["من جودهِ ذهبٌ ومن ألفاظه","دُرَرٌ تباح لنا ونحن نصوغ",16,"غ",1,0],["مِن جَوارٍ ساقِياتٍ","وَسَواقٍ جارِياتِ",17,"ت",1,0],["مُنْجحُ القيل ما علمتُ وحاشا","لخليلي من تَرْحةِ الإكداءِ",18,"ا",2,0],["من جوادٍ وماجدٍ وكريمٍ","وزعيمٍ وسيِّدٍ ونقيبِ",19,"ب",1,0],["من جَوارٍ كأنهنَّ جَوارٍ","يتسلسلنَ من مياهٍ عِذابِ",20,"ب",1,0],["من جاد ساد ومن لم يأت عارفةً","ولم يَجُدْ لاكتساب المجد لم يَسُدِ",21,"د",1,0],["من جودُه الجودُ الشهي","رُ وبذله البذلُ الستيرُ",22,"ر",1,0],["من جميع الزَّين كاسٍ","من جميع الشَّين عاري",23,"ر",2,0],["من جور إخوان الصفاء سرورهم","بتفاضل الأحوال والأخطار",24,"ر",1,0],["منجاةُ هاربه محل طريده","منهاة طالبه غياث لهيفه",25,"ف",2,0],["من جمع الأموال من مثل ما","جمَّعته لم يلج في ضيق",26,"ق",1,0],["مَنْ جاد بالحَوْباء جاد بمالهِ","فالمالُ أيسرُ هالكٍ تعجيلا",27,"ل",2,0],["من جامد الكف حين تسأله","وخائن الحبلِ عندَ إعصامي",28,"م",2,0],["مَنْ جَاشَ بالوحي المقدَّسِ قلبُه","لم يحتفل بحِجَارةِ الفلتاءِ",29,"ا",2,0],["من جمالٍ وكمالٍ","حَسُنَا في كل عين",30,"ن",1,0],["من جؤذر ثَم يرنو","وشادن مختال",31,"ل",1,0],["مَن جَعَل المَغربَ مَطلَعَ الضُحى","وَسَخَّر البَربر جُنداً لِلهُدى",32,"ا",1,1],["مِن جَهلِهِم بِالدينِ وَالدُنيا مَعاً","عَبَدوا الأَصَمَّ وَأَلَّهوا التِمثالا",33,"ل",2,0],["مِن جِعادِ الأَكُفِّ غَيرِ جِعادٍ","وَغِضابِ الوُجوهِ غَيرِ غِضابِ",34,"ب",1,0],["مِن جَوادٍ سَمحٍ يُجَمِّشُ بِاللَح","ظِ ذَكاءً فَيَفهَمُ التَعريضا",35,"ض",2,0],["مِن جَهيرِ الخِطابِ يُضعِفُ فَضلاً","عِندَ حالَي تَأَمُّلٍ وَاِستِماعِ",36,"ع",1,0],["مَن جَعَلَ الإِسرافُ يَقتادُهُ","فَقَد أَراني مايَراهُ الخَليع",37,"ع",1,0],["مَن جَدُّهُ دانَ فَضلُ الأَنبِياءِ لَهُ","وَفَضلُ أُمَّتِهِ دانَت لَهُ الأُمَمُ",38,"م",1,0],["مَنْ جَدُّهُ دَانَ فَضْلُ الآنْبِيَاءِ لَهُ","وَفَضْلُ أُمَّتِهِ دَانَتْ لَهَا الاُمَمُ",39,"م",1,0],["من جرب الكي لا ينسى مواجعه","ومن رأى السم لا يشقى كمن شربا",40,"ب",2,0],["من جراح المناضلين.. ولدن","ومن الجرح تولد الكبرياء",41,"ا",2,0],["مِن جِذمِ ذُبيانَ تَنميهِم ذَوائِبُها","إِلى أَرومَةِ عِزٍّ غَيرِ مُحتَقَرِ",42,"ر",1,0],["مَن جاوَرَ النِعمَةَ بِالشُكرِ لَم","يِخشَ عَلى النِعمَةِ مُغتالَها",43,"ل",3,0],["مَن جَعَلَ الدَهرَ عَلى بالِهِ","أَمَّ بِهِ أَفظَعَ أَهوالِهِ",44,"ل",2,1],["مَن جاوَرَ الرَحمَنَ فيدارِهِ","تَمَّت لَهُ النِعمَةُ كُلَّ التَمام",45,"م",1,0],["مِنجابُ ماتَ بِدائِهِ","فَاعجَل لَهُ بِدَوائِهِ",46,"ا",3,1],["مَن جاوَرَ المَوتى فَقَد أَبعَدَ ال","دارَ وَقَد جاوَرَ قَوماً جُفاة",47,"ا",2,0],["من جَحْفَلٍ ضَمِنَ الفتحُ المبينُ له","ذُلَّ الأعادي بعزِّ النَّصرِ والظّفَرِ",48,"ر",1,0],["مَنْ جَرَى فِي غَيْرِ حَلْبَتِهِ","كَانَ مَوْقُوفَاً عَلَى الظِّنَنِ",49,"ن",1,0],["مِنْ جبلِ الريانِ أردافُهُ","وصدغُهُ المعطوفُ مِنْ قافِ",50,"ف",1,0],["مُنَجِّمٌ تحتَهُ والميلُ قدْ نصبا","فخانَهُ عقلُ مَنْ يهواهُ معقولُ",51,"ل",1,1],["مَنْ جاءَ عَنْ بيتِهِ يحدِّثُكم","قولوا لهُ البيتُ والحديثُ لنا",52,"ن",2,0],["مِن جُلَّنارٍ ناضِرٍ خَدُّهُ","وَأُذُنُهُ مِن وَرَقِ الآسِ",53,"س",1,0],["مِن جانبِ الغيلِ المنيعِ تتابعت","وَثَباتُه وتجاوب الإرعادُ",54,"د",1,0],["مِن جَزُورٍ نحرتَها تُطعمُ الجي","شَ وتشفيهِ من أذىً وارْتِماضِ",55,"ض",1,0],["من جاءَ منكم لا يُرَدُّ ومن يَجيءْ","مِنّا فمردودٌ إلينا مُسْلَم",56,"م",1,0],["مَن جانبَ الحقَّ أردته عَمايتُه","وأحزمُ الناس من بالحق يعتصمُ",57,"م",1,0],["مُنجِ ذي الخَيرِ مِن سَفينَةِ نوحٍ","يَومَ بادَت لَبنانِ مِن أُخراها",58,"ا",1,0],["من جاحِدي الدِّينِ والحقِّ المُنير ومن","عادي الأئِمّةِ والكُفّار بالرُّسُل",59,"ل",1,0],["مُنَجِّدٌ يَأشَرُ لِلصِياحِ","ما البَرقُ في ذي عارِضٍ لَمّاحِ",60,"ح",1,0],["مِن جَذبِ أَلوى لَو نَتَر","إِلَيهِ طوداً لَأَنأَطَر",61,"ر",1,0],["مِن جَنى النَحلِ بِالنُقا","خِ زُلالاً مُبَرَّدا",62,"د",2,0],["مَن جالَسَ المُغتابَ فَهوَ مُغتاب","لَستُ عَلى كُلِّ جَنىً بِعَتّاب",63,"ب",1,1],["مَن جَبرَئيلُ إِذا تُخَوِّفُهُم","لا إِيلُ عِندَهُمُ وَلا جَبرُ",64,"ر",1,0],["مَن جاء يسألُ عنهمُ من جاهلٍ","لم يرو سَغباً من دمِ الأوداجِ",65,"ج",1,0],["من جرية الوحي على لسانه","أعيا المجيدين مدى إحسانه",66,"ه",1,0],["من جوهر الحق المبين فصوصه","جبريل وهو به القديم خصومه",67,"ه",1,0],["من جراح الضّحى سنى أريحيّ","نضّر الكائنات حين هريقا",68,"ق",2,0],["مِن جَوهَرٍ مِن قُرَيشٍ فَاِلتَمِس بَدَلاً","مِنهُم مَعانيقَ في الهَيجا مَقاديمِ",69,"م",1,0],["مِنْ جَالِبِي الإِيسَارِ حَي