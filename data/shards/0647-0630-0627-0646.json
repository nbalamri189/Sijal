{"poems":[[95,"جلس الأمير إلى الطعام عشية","https://www.aldiwan.net/poem11380.html","الكامل"],[90,"هي النفوس وإن لم تبلغ الحلما","https://www.aldiwan.net/poem44830.html","البسيط"],[74,"ودعت بابك لا وداع القالي","https://www.aldiwan.net/poem19532.html","الكامل"],[74,"بدا وقامته تختال بالتيه","https://www.aldiwan.net/poem20562.html","البسيط"],[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[51,"بالله يا حلوة العينين زوريني","https://www.aldiwan.net/poem65335.html","البسيط"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[104,"حسبت أن الشبابا","https://www.aldiwan.net/poem33070.html","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43910","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54313","السريع"],[92,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[159,"تظلم الورد من خديه إذ ظلما","https://www.aldiwan.net/poem55561.html","البسيط"],[208,"للدهر ما بين الأنام وزيف","https://www.aldiwan.net/poem53097.html","الكامل"],[225,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[274,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[301,"لا تحسبن فرند صارمه به","https://www.aldiwan.net/poem33271.html","الكامل"],[301,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[309,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[381,"من لي بقلب أستميحه","https://www.aldiwan.net/poem66886.html","مجزوء الكامل"],[407,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[503,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[503,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[503,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[561,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[565,"هذا نقولا الذي أجرى الدموع دما","https://www.aldiwan.net/poem52636.html","البسيط"],[878,"","https://poetry.dctabudhabi.ae/diwan/poem/121258","الرجز"]],"verses":[["هَذَا نَذِيرٌ لا شَفَاعَةَ بَعْدَهُ","عِنْدَ المُهَيمِنِ أَنْ تُصِرَّ وَتَظْلِمِ",0,"م",1,0],["هذا نجا هارباً والبحر أنجده","وذاك أسلم منه السيف منثلما",1,"م",2,0],["هذا نداك قلائد الأعناق أو","هذا ثناك خواتم الأعمال",2,"ل",1,0],["هذا نباتيُّ لفظٍ يشتكي عطشاً","لعلَّ أفقك بالأنواء يسقيه",3,"ي",2,0],["هذا نهار مشرق","وذاك ليل مظلم",4,"م",1,0],["هَذانِ أَمرانِ فَاِختاري أَحَبَّهُما","إِلَيكَ أَو لا فَداعي المَوتَ يَدعوني",5,"ن",2,0],["هَذا نَبِيٌّ وَلَم يَنزِل بِساحَتِها","إِلّا نَبيٌّ كَريمُ النَّفسِ وَالشِّيَمِ",6,"م",1,0],["هذا نِظامٌ للشعوبِ ومَنهجٌ","حقٌّ يراه فَصِيحُها والأعجم",7,"م",1,0],["هذا نقابٌ وهذا","شعر وهذا وشاحُ",8,"ح",1,0],["هَذا نمير فاطلبيه يا قطا","فإذا رويت من النمير فَطيري",9,"ر",2,0],["هذا نهار مات يا لَلنَّهار","كل مساءٍ مصرعٌ وانهيار",10,"ر",1,0],["هذَانِ خصْمَان لستُ أقْضِي","بينَهُما خوفَ أن أَمِيلا",11,"ل",2,0],["هذان نضوا صبوةٍ","مجنونةٍ يتعانقانْ",12,"ن",1,0],["هذا نَجيِبٌ قَدْ ثَوَى مُفْرَداً","كَأنَّهُ الصمْصَامُ في غِمْده",13,"د",2,0],["هذا نتاجُ شعورٍ جاش جائِشُهُ","راعوا عواطف هذا الشعب ياغُرَبا",14,"ب",2,0],["هذا نبيي ولم يبعث وليس له","إلّا الجمال وآي الحسن قرآن",15,"ن",1,0],["هذا نديمي أناجيه ويترع لي","كؤوس ذكرٍ لمن لي منه نسيان",15,"ن",1,0],["هَذانِ طَرْفانِ لا واللَهِ ما عَزَمَا","إِلا عَلَى سَقَمِي أَوْ لا فَلِمْ سَقِما",16,"م",2,0],["هذا نزارٌ زان فرعَ أرومةٍ","هو تالدٌ في المكرمات طريفُ",17,"ف",1,0],["هذا نظام بديع","لكنه للزوال",18,"ل",1,0],["هذا نصيبي زَهرتي في كمّها","تَذوي وتأميلي يموتُ جنينا",19,"ن",2,0],["هَذا نَدى يمناهُ سال بمتنه","فغدا يَلوحُ بصَفحَتيهِ جَوهرا",20,"ر",2,0],["هَذا نظامُ الدين واِبنُ نظامه","نَسَبٌ يؤولُ إِلى النَبيِّ الأَطهَرِ",21,"ر",1,0],["هَذا نَزيعك بَل نَزيلك لائذاً","بِحِماكَ جلّله الحياءُ فَضيجه",22,"ج",2,0],["هذا نجاحي إن أطع","تُ رسومه فأنا نجيحه",23,"ح",2,0],["هذا نظام يكاد اللطف يجعله","طوقاً على العنق أو كُحْلاً على البصر",24,"ر",1,0],["هذا نِظامٌ سَلْسَلَتْهُ يدُ العَمى","وبذا الكِتابُ على ابنِ آمنةٍ نَزَلْ",25,"ل",1,0],["هذا نَطوقٌ حين يُسبَكُ لفظُهُ","وأَخوهُ ذو لَكَنٍ مع الكَلِماتِ",26,"ت",1,0],["هذانِ موجودٌ ومفقودٌ فقِفْ","خجِلاً هناكَ تُجَهَّلُ العُلماءُ",27,"ا",2,0],["هذا نصحي فاقبله وكن","للجاهل حبلاً في ودج",28,"ج",1,0],["هذا نِقولا الذي أجرَى الدُّموعَ دَماً","بفَقْدِهِ وأطالَ النَّوحَ والأسَفَا",29,"ف",2,1],["هذا نبي معه البرهان","أرسله بحقه الديان",30,"ن",1,0]]}