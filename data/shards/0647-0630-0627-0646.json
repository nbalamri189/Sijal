.com/ViewPoem.aspx?id=205715",""],[5574,"خالي عيسى \"رحمه الله\"","https://www.poetsgate.com/ViewPoem.aspx?id=206004",""],[5587,"شمس الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=196820",""],[5595,"هذا نداؤك لا ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=177542",""],[5674,"أنيس ليل لا أطيق سهاده","https://www.poetsgate.com/ViewPoem.aspx?id=190390",""],[5758,"عزفٌ أخْضر","https://www.poetsgate.com/ViewPoem.aspx?id=200586",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5790,"إن قسته بالبدر ما أنصفته","https://www.poetsgate.com/ViewPoem.aspx?id=111934",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5829,"عن اي نار نحجب","https://www.poetsgate.com/ViewPoem.aspx?id=153241",""],[5952,"قومي","https://www.poetsgate.com/ViewPoem.aspx?id=199830",""],[5956,"سيارة وسط الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=184691",""],[5956,"عاشت مضحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=203447",""],[5977,"ندائي للأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=213074",""],[6070,"خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=188063",""],[6070,"ليلة مع يتيم الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=188468",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6272,"إقرأ كتابك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66793&r=&rc=0",""],[6344,"لهيب من شعلة انطفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87981&r=&rc=21",""]],"verses":[["هَذَا نَذِيرٌ لا شَفَاعَةَ بَعْدَهُ","عِنْدَ المُهَيمِنِ أَنْ تُصِرَّ وَتَظْلِمِ",0,"م",1,0],["هذا نجا هارباً والبحر أنجده","وذاك أسلم منه السيف منثلما",1,"م",2,0],["هذا نداك قلائد الأعناق أو","هذا ثناك خواتم الأعمال",2,"ل",1,0],["هذا نباتيُّ لفظٍ يشتكي عطشاً","لعلَّ أفقك بالأنواء يسقيه",3,"ي",2,0],["هذا نهار مشرق","وذاك ليل مظلم",4,"م",1,0],["هَذانِ أَمرانِ فَاِختاري أَحَبَّهُما","إِلَيكَ أَو لا فَداعي المَوتَ يَدعوني",5,"ن",2,0],["هَذا نَبِيٌّ وَلَم يَنزِل بِساحَتِها","إِلّا نَبيٌّ كَريمُ النَّفسِ وَالشِّيَمِ",6,"م",1,0],["هذا نِظامٌ للشعوبِ ومَنهجٌ","حقٌّ يراه فَصِيحُها والأعجم",7,"م",1,0],["هذا نقابٌ وهذا","شعر وهذا وشاحُ",8,"ح",1,0],["هَذا نمير فاطلبيه يا قطا","فإذا رويت من النمير فَطيري",9,"ر",2,0],["هذا نهار مات يا لَلنَّهار","كل مساءٍ مصرعٌ وانهيار",10,"ر",1,0],["هذَانِ خصْمَان لستُ أقْضِي","بينَهُما خوفَ أن أَمِيلا",11,"ل",2,0],["هذان نضوا صبوةٍ","مجنونةٍ يتعانقانْ",12,"ن",1,0],["هذا نَجيِبٌ قَدْ ثَوَى مُفْرَداً","كَأنَّهُ الصمْصَامُ في غِمْده",13,"د",2,0],["هذا نتاجُ شعورٍ جاش جائِشُهُ","راعوا عواطف هذا الشعب ياغُرَبا",14,"ب",2,0],["هذا نبيي ولم يبعث وليس له","إلّا الجمال وآي الحسن قرآن",15,"ن",1,0],["هذا نديمي أناجيه ويترع لي","كؤوس ذكرٍ لمن لي منه نسيان",15,"ن",1,0],["هَذانِ طَرْفانِ لا واللَهِ ما عَزَمَا","إِلا عَلَى سَقَمِي أَوْ لا فَلِمْ سَقِما",16,"م",2,0],["هذا نزارٌ زان فرعَ أرومةٍ","هو تالدٌ في المكرمات طريفُ",17,"ف",1,0],["هذا نظام بديع","لكنه للزوال",18,"ل",1,0],["هذا نصيبي زَهرتي في كمّها","تَذوي وتأميلي يموتُ جنينا",19,"ن",2,0],["هَذا نَدى يمناهُ سال بمتنه","فغدا يَلوحُ بصَفحَتيهِ جَوهرا",20,"ر",2,0],["هَذا نظامُ الدين واِبنُ نظامه","نَسَبٌ يؤولُ إِلى النَبيِّ الأَطهَرِ",21,"ر",1,0],["هَذا نَزيعك بَل نَزيلك لائذاً","بِحِماكَ جلّله الحياءُ فَضيجه",22,"ج",2,0],["هذا نجاحي إن أطع","تُ رسومه فأنا نجيحه",23,"ح",2,0],["هذا نظام يكاد اللطف يجعله","طوقاً على العنق أو كُحْلاً على البصر",24,"ر",1,0],["هذا نِظامٌ سَلْسَلَتْهُ يدُ العَمى","وبذا الكِتابُ على ابنِ آمنةٍ نَزَلْ",25,"ل",1,0],["هذا نَطوقٌ حين يُسبَكُ لفظُهُ","وأَخوهُ ذو لَكَنٍ مع الكَلِماتِ",26,"ت",1,0],["هذانِ موجودٌ ومفقودٌ فقِفْ","خجِلاً هناكَ تُجَهَّلُ العُلماءُ",27,"ا",2,0],["هذا نصحي فاقبله وكن","للجاهل حبلاً في ودج",28,"ج",1,0],["هذا نِقولا الذي أجرَى الدُّموعَ دَماً","بفَقْدِهِ وأطالَ النَّوحَ والأسَفَا",29,"ف",2,1],["هَذا نُصَيبُ سَعَى فأصبَحَ رِقّه","لبَني أمَيَّة عَن بَني الجسّاس",30,"س",1,0],["هذان لغزان قد حلا ببابك يا","قاضي البرية ما هذان خصمان",31,"ن",1,1],["هذا نبيٌّ ووصيٌّ لهُ","ويُعزل العالمُ في جانبِ",32,"ب",1,0],["هذا نهارُ العيدِ أصبحَ مُظلِماً","وأعار بهجتهُ الثرى فتنوَّرا",33,"ر",2,0],["هَذا نَزيلُ أَبَرٍّ جودُ راحتِه","مسطَّر لِجَميع الناس في الكُتب",34,"ب",1,0],["هَذا نَجيب بِتقدير العزيز غَدا","مجرّداً عن خدامات بِلا سَبَب",35,"ب",1,0],["هذا نصيبي من الفوضى ظفرتُ به","من بعد ما خانني في غيرها الأرب",36,"ب",1,0],["هذا نصيبكمُ من الحسنى وما","أولى العراق بمثله والشاما",37,"م",2,0],["هذا نصيب من ندا","ك وذا كتابي في يميني",38,"ن",2,0],["هذا نظيفٌ إذا الزمانُ رنا","إليه مات الزَّمانُ من فَزَعه",39,"ع",2,0],["هذا نخيلُكِ في أعتى منازفهِ","هوَ الذي قدْ رأى في ذورةِ الغَضَبِ",40,"ب",1,0],["هَذاَ نِظَامٌ يَرُوقُ مَعْنًى","أعْذَبُ مِنْ مَبْسَمِ الحَبيبْ",41,"ب",1,0],["هذا نبيذ رايته حسناً","مستعذباً يرتضيه خابرُهُ",42,"ر",2,0],["هذا نديمي حاضر","والراح تلك وذاك عودي",43,"د",2,0],["هذا نهاية ارباب الكمال وفي","افيائه نيل ما يرجوه امثالي",44,"ل",2,0],["هذا نعيم لست ترضينهُ","في ثامر منه وفي وارق",45,"ق",1,0],["هذا نظامك يا فرد الجمال أتى","كالروض جرت عليها ذيلها الديم",46,"م",1,1],["هذا نجيب بني نبهان وارثه","أبو المعمرّ طبع السَّادة النُّجُبِ",47,"ب",1,0],["هذان حقان نبهانٌ غدا لهما","وبالعتيك معا والازْد مُفتَخَرُ",48,"ر",1,0],["هذا نُصوعُ القلب منعكس على","رأسٍ مُناه أُلفةٌ وسلام",49,"م",1,0],["هذان أَمران شَت البون بَينَهُما","فَاِكفُف لِسانَك عَن ذمي وَتزيني",50,"ن",2,0],["هذا نذيرُ اللَهِ قامَت بهِ","حُجَّتُهُ البَيضاءُ فَوقَ القِمَم",51,"م",1,0],["هذا نراه لدى الشدائد مفزعاً","وبذا أحاديث الفضائل تنقل",52,"ل",1,0],["هذا نبي الحسن في فترة","أرسل والعشاق أسراه",53,"ا",2,0],["هذا نصيبي من الدنيا قنِعتُ به","وهو السعادة وَهو الروح والمالُ",54,"ل",1,0],["هذا نَكالُ إِمامِ المُسلِمينَ لَكُم","فَإِن رَجَعتُم وَإِلّا اِستُؤصِلَ العِقبُ",55,"ب",1,0],["هذا نبات العذار في خدّه","حلوٌ وفكري في حسنه حائرْ",56,"ر",1,1],["هَذَان يَكُونُ مِنَ الحَلاَلِ كَمَا يَكُو","نُ مِنَ الحَرَام كِلاَهُمَا",57,"م",2,0],["هَذَا نَفَى ذَاتَ الإِلهِ وَوَصفَهُ","نَفياً صَرِيحاً لَيسَ بِالكِتمَانِ",57,"ن",1,0],["هَذا نَعيمُ بنُ مَسعودٍ قَبيلَتُهُ","غَطفانُ يُربي عَلى غَطَفانَ كُلّهِمِ",58,"م",1,0],["هَذا نَبِيُّ الإِلَهِ قَبلَكُم","قَد أَنكَرَتهُ عُيونُ إِخوَتِهِ",59,"ت",2,0],["هذا نبي معه البرهان","أرسله بحقه الديان",60,"ن",1,0],["هذا نبي الهدى بذلٌ سجيته","هذا هو المصطفى الهطلاء ديمته",61,"ه",1,0],["هذان صَحبي لا يرّقان لي","قُبحتم يا صحبُ من صحب",62,"ب",1,0],["هذا نبيّ ولم يبعث وليس له","إلّا الجمال وآي الحسن قرآنٌ",63,"ن",1,0],["هذا نشوءك وارتقاؤك بعده","والبدر يكمل بعد سير هلاله",64,"ل",2,0],["هذا نهار العلم اشرق وانجلى","عن وجه أفقك ليل جهل غاسق",65,"ق",1,0],["هذا نُحولي وَسُقمى شاهِدانِ عَلى","أَنّي المُتَيَّمُ لا قبلى وَلا بعدي",66,"د",2,0],["هذا نفيسُ النفس مفردُ عصره","غيث الندى المنعوت بالهتّان",67,"ن",1,0],["هذا نظام جوهر الثناءِ","زاهي السنا كالشمس في السناءِ",68,"ا",2,1],["هذا نداكَ بهِ نيلتْ مَطالِبُها","هذا هُداكَ بهِ راقتْ مطالِعُها",69,"ع",3,0],["هذا نجيب القيم المتفردُ","لطفاً ومن يدري نجيباً يشهدُ",70,"د",1,1],["هذا نَهارُ الهُدَى مُستوضِحاً لَكُمُ","فامشُوا إذِا الليلُ تُغوِيكم فَراقدُهُ",71,"د",2,0],["هذان ماءان كل منهما انحصرا","في قلة رفعا منعاً لما وجبا",72,"ب",2,0],["هذا نذير الشر هبّا","وإلى حمى مصر اشرأبّا",73,"ب",2,0],["هذا نوادر الأصول","إلى الهدى باب الوصول",74,"ل",1,1],["هذا نعيم الخلد من يأو له","يلق النعيم به ولم ير بوسا",75,"س",2,1],["هَذانِ لِلأَفراحِ إِن شَرَدت","يَوماً وَذا لِشَوارِدِ الحُكمِ",76,"م",1,0],["هَذا نَدَبُ العَيشِ حَواهُ يَدُ مَن","قَد أَظفَرَ قَدحَ لَهوِهِ الأَقداحُ",77,"ح",1,0],["هذا نسيم رياض القدس قد نفحا","أم عندليب لسان الحق قد صدحا",78,"ح",2,1],["هَذا نَعيمٌ دائِمٌ","وَمَناهِلُ الدنيا قَصيرَه",79,"ر",2,0],["هذا نهاية علم من هو عالم","وبيان صحبة من أتى ببيان",80,"ن",1,0],["هذا نجيُّ اللَهُ أكرَم شافِعٍ","وَمشَفّعٍ يَومَ الخَلائقُ تُحشَرُ",81,"ر",1,0],["هذا نزيلكم ألم ببابكم","يبغى القرى من نيلكم فأنيلوا",82,"ل",3,0],["هذانِ نهجان للجنَّاتِ واحدُها","يُفْضي وآخرُ يُلْقى في لَظَى سَقَرِ",83,"ر",1,0],["هذان خصمان لا أرضى بحكمهما","فاحكم فديتك بين القلب والبصر",84,"ر",1,0],["هذان اصلان لا تأتيك فائدة","من منطق لم يكونا من مبانيه",85,"ي",2,0],["هذا نعيم ذوي اللذات ما نعموا","في عيشهم وإليه ينتهي المثل",86,"ل",1,0],["هذا نصيبه / والنصيب أغواني","لأرض(ن) بها طيب الثمر مسمومي",87,"م",2,0],["هذا نصيبي / وبعض مما جرالي","بعض البشاير والعنا فيّ صداح",88,"ح",1,0],["هذا نذير الثّلج يا مغرورُ","فهل اتّعظتَ , وزال عنك غرورُ ؟",89,"ر",1,1],["هذا نبي حين يبعث صادعا","بالوحي عنه وأنت من يستخلف",90,"ف",1,0],["هذا نصيح ناصح لألي النهي","ووكيلهم متوكل بنصيحة",91,"ه",1,0],["هذا نداؤكَ في قلبي أخمِّرُهُ","لحناً وأُسكرُهُ في العشق ِ ترديدا",92,"د",2,0],["هذا نَسيج سُكارى في مودّتهم","فالحبّ والشّعر أحلى اليوم ما كانا",93,"ن",2,0],["هذا نداءُ العشقِ للشوقِ الذي","غطَّى سُهادكِ في مدى أشواقيهْ",94,"ي",2,0],["هذا نأى عنك خوفاً أن يخيب وأن","يرى سواه على عطيفك قد حصلا",95,"ل",2,0],["هَذَانِ خَصمَانِ الزَّمَانَ بِأسرِهِ","فِي القَلبِ مَا اجتَمَعَا وَرَبِّي فَاصِلُ",96,"ل",1,0],["هذا نجيُّكِ قلبٌ نابضٌ ودمُ","قد هامَ فيكِ ثرىً تشتاقهُ الديَمُ",97,"م",1,1],["هذا نشيد الحزب فى أعماقنا","عاش الأباة ويسقط الجبناء",98,"ا",2,0],["هذا نصيبُك..لن تصابَ بغيره..","إن شئت فاحلُم..إنني اهواكا",99,"ك",2,0],["هذا نبيُّ الورى قد حازَ مبتسماً","والقلبُ عاصرُه طوداً من الألمِ",100,"م",1,0],["هذا نبيٌّ يخيط الثوبَ يرتقُه","وتحت إمرته طوراً من النعمِ",100,"م",1,0],["هذا نسيمك سله عن شمائلها","فقلبه من خفايا اللطف ملآن",101,"ن",1,0],["هذان ينزلقان في دركٍ","بالحقد أو بالطيش والكذبِ",102,"ب",1,0],["هذا ندائي على أبوابِ اخوتِنا","بين الفيافي وقُربي ثوبُ تكفيني",103,"ن",2,0],["- هذا نَشازٌ يا ابنَ ماءٍ جارحٌ","فيقولُ صبرًا يا ابنَ طينٍ في الجراحْ!",104,"ح",1,0],["هذا نَبِيٌّ نبيهٌ عن شَريعَتِهِ","سَدّ الرَدى ثُمَّ سَنّ الشَرع لِلأُممِ",105,"م",1,0],["هذا نداء الماردين","على الكتاب على الصلاح",106,"ح",1,0],["٢٠- هذا نِزالُ الجوى والحربُ في لُغَتي","مَنْ يكسَبِ اليوْمَ - حتماً - باتَ مُنهَزِما",107,"م",2,0],["٧- هذا نصيبي، بكأسِ الموْتِ أشْربُهُ","مَنْ لم يذُقْهُ معي، حتْماً يذُقْهُ غدا",108,"د",2,0],["هَذَا نَشِيدُ النَّصْرِ أَتْقَنَ لَحْنَهُ","وَ النَّصْرُ يَا وَلَهَ الجَنَانِ بَدِيعُ",109,"ع",1,0],["هذا نِداؤكَ لا نِدائي","وَجعٌ يُقلّبُ بالد