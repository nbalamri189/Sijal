{"poems":[[95,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[310,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[364,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[591,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120005","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59114","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74200","الكامل"],[3168,"","https://poetry.dctabudhabi.ae/diwan/poem/35042","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86300","الطويل"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128543","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131978","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91533","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35509","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73238","الوافر"],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5213,"بلغت بك الروحاء في ذملانها","https://www.poetsgate.com/ViewPoem.aspx?id=170567",""]],"verses":[["فَبَثَّ شَجَاهُ كُلُّ رَبْلٍ وَلَمْ يَكُنْ","سِوَى مَأْتَمٍ تَعْدَادَ تِلْكَ المَآتِمِ",0,"م",1,0],["فَبَثَّ له تِلْك الحَبائل حَازِمٌ","من القوم كَيَّادٌ قَديماً مُكيَّدُ",1,"د",1,0],["فَبَثَّهُنَّ عَلَيهِ وَاِستَمَرَّ بِهِ","صُمعُ الكُعوبِ بَريئاتٌ مِنَ الحَرَدِ",2,"د",1,0],["فبثّ بنيهِ في ذرىً ومناكب","ليعنيَ كلّاً خطّ قطرٍ ورضمهُ",3,"م",2,0],["فبثُّوا بيوتاً ثم حازوا غنايماً","وسفك دم الأعداء نالوا به أجرا",4,"ر",2,0],["فَبِثغرٍ مِنْكَ لِي جُلِيا","قَدْ حَلا طَعْماً وَقَدْ حَلِيا",5,"ي",2,0],["فبثوب كلِ نزاهة متجلب","وبثدى كل نباهة ملبونِ",6,"ن",1,0],["فَبثغره شِمْتُ العُذَيْبَ وبَارقا","وَبِقَدّه خلْتُ النَّقَا وَالبَانَا",7,"ن",2,0],["فبثوب الزمان ليس سواكم","فالبسوه على الدوام قشيبا",8,"ب",2,0],["فبث ما بثت من هم يساط به","صميم قلب بذاك البث مشتعل",9,"ل",1,0],["فَبثثتها شَكوى الغَرام وَكُل ما","لاقَيتهُ مِن كاشح وَحَسود",10,"د",1,0],["فَبَثَّهُنَّ بِطاوي الكَشحِ مُنجَرِدٍ","كَأَنَّ أَظلافَهُ يَهوي بِها زَهَقُ",11,"ق",1,0],["فَبثوا اِلَيهِ شَوق قَلبي وَحُزنُهُ","وَبِاللَّهِ كُفّوا عَن تَماديهِ انَّهُ",12,"ه",1,0],["فبثوا في نفوس القوم روحا","مؤيدة بإخلاص ودين",13,"ن",1,0],["فبث الإمام وقد جئته","شكاة الحنيفة مما ظهر",14,"ر",1,0],["فَبثثتُ الوَجدَ لَو ما","ما أَفاد البَثُّ لَوما",15,"م",2,0],["فَبثَثتَ في الظَلماء كُحلَ جُفونِها","وَعَقَدتَ هاتيكَ الذَوائب بِالدُجى",16,"ج",2,0],["فبُثَّا ما بدا لكُما وقولا","لهُ إن كانَ يَرعى حقَّ عهديَّ",17,"د",2,0],["فبُثَّه الشجو واقصص ما تحس له","لعل لمحة بشرى منه تلفيها",18,"ي",3,0],["فبَثَّه الأمر تصريحاً وقال له","روحي فدا زينب إن كان يرضيها",18,"ي",3,0],["فبثتها شكوى الغرام فأطفأت","بحديثها ما شب من نيرانها",19,"ن",3,0]]}