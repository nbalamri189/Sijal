{"poems":[[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[23,"سائل بني الأشعر إن جئتهم","https://www.aldiwan.net/poem21514.html","السريع"],[51,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[91,"حمل الشمس إلينا قمر","https://www.aldiwan.net/poem62682.html","عموديه"],[80,"ومديد الخطى كأنك منه","https://www.aldiwan.net/poem31318.html","الخفيف"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[69,"ملك هذا حبيبي أم ملك","https://www.aldiwan.net/poem28704.html","المتقارب"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[50,"أسبويه يا ابن الفارسية ما الذي","https://www.aldiwan.net/poem63830.html","الطويل"],[46,"يا سيد هل لك في ظبي تغازله","https://www.aldiwan.net/poem23105.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[50,"أسِبْويه يابن الفارسيّة ماالذي","https://www.poetsgate.com/ViewPoem.aspx?id=22636",""],[113,"يا ربنا يا ارحم الراحمين","https://www.aldiwan.net/poem40450.html","عموديه"],[118,"يا شاعر النفس كم أبكاك مصرعها","https://www.aldiwan.net/poem49358.html","البسيط"],[127,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[132,"أسبلت عبرة على الوجنات","https://www.aldiwan.net/poem20992.html","الخفيف"],[158,"هكذا فلتكن إلى الغلمان","https://www.aldiwan.net/poem58854.html","الخفيف"],[164,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[280,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[280,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[288,"هناك بذلك العلم","https://www.aldiwan.net/poem11658.html","مجزوء الوافر"],[296,"يشغلني بحبه","https://www.aldiwan.net/poem36832.html","عموديه"],[303,"أسبل الدمع عند نشر دخان","https://www.aldiwan.net/poem56449.html","البسيط"],[318,"اسبل الشعر معجبا وتهيا","https://www.aldiwan.net/poem61804.html","الطويل"],[326,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[355,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[436,"دأبك الهجر ودابي","https://www.aldiwan.net/poem34824.html","مجزوء الرمل"],[438,"يا ليت شعري بما ألقاه في حدثي","https://www.aldiwan.net/poem14356.html","البسيط"],[463,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[503,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[513,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[527,"أعلى الذي ألقى طلبت شهودي","https://www.aldiwan.net/poem37458.html","الكامل"],[536,"يا حليف الندى المفدى هنيئا","https://www.aldiwan.net/poem48145.html","عموديه"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"بين بان الحمى وبان المصلى","https://www.aldiwan.net/poem17554.html","الخفيف"]],"verses":[["أَسِبْطَ الإِمَامِ الْغَالِبِيِّ مُحَمَّدٍ","وَيَا فَخْرَ مَلْكٍ كُنْتَ أَنْتَ لَهُ سِبْطُ",0,"ط",1,0],["أُسبوعُ أُنسٍ مُحدِثٌ لي وَحشَةً","عِلماً بِأَنّي فيهِ لَستُ أَراكا",1,"ك",2,0],["أَسَبَاكُمْ إِيقَاعُ شَحْرُورَةِ الوَا","دِي وَرَهْطٌ نِظَامُهُ فِي اكْتِمَالِ",2,"ل",1,0],["أَسبَلَ بِالحِجرِ لِتَكذيبِهِ","دونَ قُرَيشٍ نُهزَةَ القاذِعِ",3,"ع",1,0],["أَسبلت من ذراه جعداً أثيثاً","جائزاً حدَّ متنها الرّجراجِ",4,"ج",1,0],["أَسبَلَ الشِعرَ فَيا عَيني اِسهَري","إِنَّهُ لَيلٌ طَويلٌ مُظلِمُ",5,"م",1,0],["أسْبِقُ الريحَ فوقه فإذا ما","فتّها أمسكتْ بفضلةِ ذيلي",6,"ي",1,0],["أَسبِل عَلَيهِم سِترَ عَفوِكَ مُفضِلاً","وَاِنفَح لَهُم مِن نائِلٍ بِذِنابِ",7,"ب",1,0],["أسبَلَ الشعرَ على أكتافِهِ","قلتُ يا ليلي بهِ ما أطولَكْ",8,"ك",1,0],["أَسبابُ دُنيا وَدينٍ بَينَنا اِجتَمَعَت","بَعدَ التَفَرُّقِ وَاِنضَمَّت أَواخيها",9,"ي",3,0],["أَسِبوَيهِ يا اِبنَ الفارِسِيَّةِ ما الَّذي","تَحَدَّثتَ عَن شَتمي وَما كُنتَ تَنبُذُ",10,"ذ",1,1],["أَسبِل عَلى السائِل المَعروفَ مُبتَدِراً","تُحمَد وَأَسبِل عَلى باغي النَدى سَبَلَك",11,"ك",1,0],["أَسبلتها كَذا دموعاً غزاراً","ثم لم تمسح الدموع الغزارا",12,"ر",2,0],["اسبحي في السماء أَيَتُّها الأر","ضُ وَلا تزعجي سماك السماء",13,"ا",2,0],["أسِبْويه يابن الفارسيّة ماالذي","تحدثت عن شتمي وما كنت تنبذُ",14,"ذ",1,1],["اسبل علينا الستر والطف بنا","ورد عنا صولة الظالمين",15,"ن",1,0],["أسبلت آذي عينٍ ما تركت لها","دمعاً يراق على رزء وأوجاع",16,"ع",1,0],["أسَبَتكِ أرواحُ القَتام","فأرَتكِ ما خلفَ اللِّثام",17,"م",1,0],["أَسبَلَت عَبرَةٌ عَلى الوَجَناتِ","قَد مَرَتها عَظيمَة الحَسَراتِ",18,"ت",1,1],["اسبق الطير يهوي لوكرٍ","في جواب الصريخِ إذ ناداني",19,"ي",1,0],["أسبغْ عليَّ سجالَ العُرفِ أرْوَ بها","وأعطني عروةَ الإحسانِ أَمتسكِ",20,"ك",1,0],["أُسَبِّحُ اللَهَ إِعجاباً بِصورَتِهِ","إِذا رَنا وَكَأَنَّ الطَرفَ وَسنانُ",21,"ن",1,0],["أَسبَلَ سِترَ سِرِّهِ حَتّى إِذا","عايَنَهُ اِستَعبَرَ شَوقاً فَاِنهَتَك",22,"ك",1,0],["أسبت لموطني يمسي","ملاذ حثالة الأمم",23,"م",1,0],["أسبابُه أكثرُ من القر","بى وَأعلى وَأشد",24,"د",1,0],["أَسبلِ الدمعَ عندَ نشرِ دخانِ","فيهِ عطرٌ مِن ياسمينٍ بحقّه",25,"ه",1,1],["اِسبُلِ الشِعرَ مُعجِباً وَتَهيا","لِيُديرَ الكُؤسَ في حالِ سُكرِهِ",26,"ه",1,1],["اسبقي الشمس كالشعاع وثوباً","واسأليها يا أختها أن تثوبا",27,"ب",2,1],["أسبَغَ النُّعمَى فَطَابَت جَنّة","وَجلا البُشرَى فَقَامَت عُرُسَا",28,"س",2,0],["أسبَغْتَ ظِلَّ العَدْلِ غيرَ مُقَلَّصٍ","وسقَيْتَ ماءَ الخَفْضِ غيرَ مُصرَّد",29,"د",1,0],["أَسْبَلَ الليلَ عَلَى مَتْ","نَيْهِ إِسبالَ النِّقابِ",30,"ب",1,0],["أسباب ذنبي متيناً قد اتصلت","أسباب صالحة الأعمال في رثث",31,"ث",1,0],["أسبابُ أهلِكَ يا أوفاهُمُ رَحِماً","أقاطِعٌ أنتَ مِن أسبابِهِم سَبَبا ؟!",32,"ب",2,0],["أسَبِّحُ اللهَ في شروقٍ","لا يُرقبُ بعده مغيبُ",33,"ب",1,0],["أسبلت من أسفي دمعي غداة خلت","رحابكم وعدت مهجورة السبل",34,"ل",1,0],["أسْبَلْتَ جِلبابَ التَّجاهُلِ عامِداً","ولَقَدْ عَرَفْتَ تَهالُكَ الْمَعْمُودِ",35,"د",1,0],["أسبَغَ اللهُ أنعُماً ليس تُحصى","عنكَ فاشكُرهُ ولتَزِد له شُكرا",36,"ر",2,0],["أسبقهم منهم وذلك الحسن","حتى إذا ما مات قام قيل من",37,"ن",1,0],["أَسْبلَتْ دَمْعِي كَجُودِ المُقْرِىءِ ال","عَالِم العَادِلِ الكَبِيرِ المُغازِي",38,"ي",1,0]]}