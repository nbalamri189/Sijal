 على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[5185,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5300,"سائلة لي ما أشجع","https://www.poetsgate.com/ViewPoem.aspx?id=200451",""],[5431,"ياقمحة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=185535",""],[5431,"وتلى العراق وكبّره ...","https://www.poetsgate.com/ViewPoem.aspx?id=197650",""],[5431,"رحلة ضوئية ....","https://www.poetsgate.com/ViewPoem.aspx?id=210418",""],[5452,"ستائر الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=112027",""],[5457,"أسبابنا نفدت","https://www.poetsgate.com/ViewPoem.aspx?id=213652",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[5480,"يا وجد","https://www.poetsgate.com/ViewPoem.aspx?id=35636",""],[5561,"قارورة عطر","https://www.poetsgate.com/ViewPoem.aspx?id=192898",""],[5573,"حاولت عيا الحرح لايلقى دوى والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=206604",""],[5573,"حاولت عيا الجرح لايلقى دوى/والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=213725",""],[5574,"كروان","https://www.poetsgate.com/ViewPoem.aspx?id=205989",""],[5785,"يا ربّ يا مسبل علينا الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131575",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5848,"قبل الزيارة","https://www.poetsgate.com/ViewPoem.aspx?id=48995",""],[5956,"الأسباب النفسية لأمراض الفصام","https://www.poetsgate.com/ViewPoem.aspx?id=183999",""],[5956,"بم أواجه كل شيئ؟","https://www.poetsgate.com/ViewPoem.aspx?id=192603",""],[5956,"أخشَى أموتُ ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193713",""],[5956,"مِن معجزاتك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=200035",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[5966,"حومة فكر","https://www.poetsgate.com/ViewPoem.aspx?id=158864",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[5190,"وليمة رفضت تناولها أعشاب البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78294&r=&rc=7",""]],"verses":[["أَسِبْطَ الإِمَامِ الْغَالِبِيِّ مُحَمَّدٍ","وَيَا فَخْرَ مَلْكٍ كُنْتَ أَنْتَ لَهُ سِبْطُ",0,"ط",1,0],["أُسبوعُ أُنسٍ مُحدِثٌ لي وَحشَةً","عِلماً بِأَنّي فيهِ لَستُ أَراكا",1,"ك",2,0],["أَسَبَاكُمْ إِيقَاعُ شَحْرُورَةِ الوَا","دِي وَرَهْطٌ نِظَامُهُ فِي اكْتِمَالِ",2,"ل",1,0],["أَسبَلَ بِالحِجرِ لِتَكذيبِهِ","دونَ قُرَيشٍ نُهزَةَ القاذِعِ",3,"ع",1,0],["أَسبلت من ذراه جعداً أثيثاً","جائزاً حدَّ متنها الرّجراجِ",4,"ج",1,0],["أَسبَلَ الشِعرَ فَيا عَيني اِسهَري","إِنَّهُ لَيلٌ طَويلٌ مُظلِمُ",5,"م",1,0],["أسْبِقُ الريحَ فوقه فإذا ما","فتّها أمسكتْ بفضلةِ ذيلي",6,"ل",2,0],["أَسبِل عَلَيهِم سِترَ عَفوِكَ مُفضِلاً","وَاِنفَح لَهُم مِن نائِلٍ بِذِنابِ",7,"ب",1,0],["أسبَلَ الشعرَ على أكتافِهِ","قلتُ يا ليلي بهِ ما أطولَكْ",8,"ك",1,0],["أَسبابُ دُنيا وَدينٍ بَينَنا اِجتَمَعَت","بَعدَ التَفَرُّقِ وَاِنضَمَّت أَواخيها",9,"ي",3,0],["أَسِبوَيهِ يا اِبنَ الفارِسِيَّةِ ما الَّذي","تَحَدَّثتَ عَن شَتمي وَما كُنتَ تَنبُذُ",10,"ذ",1,1],["أَسبِل عَلى السائِل المَعروفَ مُبتَدِراً","تُحمَد وَأَسبِل عَلى باغي النَدى سَبَلَك",11,"ك",1,0],["أَسبلتها كَذا دموعاً غزاراً","ثم لم تمسح الدموع الغزارا",12,"ر",2,0],["اسبحي في السماء أَيَتُّها الأر","ضُ وَلا تزعجي سماك السماء",13,"ا",2,0],["أسِبْويه يابن الفارسيّة ماالذي","تحدثت عن شتمي وما كنت تنبذُ",14,"ذ",1,1],["اسبل علينا الستر والطف بنا","ورد عنا صولة الظالمين",15,"ن",1,0],["أسبلت آذي عينٍ ما تركت لها","دمعاً يراق على رزء وأوجاع",16,"ع",1,0],["أسَبَتكِ أرواحُ القَتام","فأرَتكِ ما خلفَ اللِّثام",17,"م",1,0],["أَسبَلَت عَبرَةٌ عَلى الوَجَناتِ","قَد مَرَتها عَظيمَة الحَسَراتِ",18,"ت",1,1],["اسبق الطير يهوي لوكرٍ","في جواب الصريخِ إذ ناداني",19,"ن",2,0],["أسبغْ عليَّ سجالَ العُرفِ أرْوَ بها","وأعطني عروةَ الإحسانِ أَمتسكِ",20,"ك",1,0],["أُسَبِّحُ اللَهَ إِعجاباً بِصورَتِهِ","إِذا رَنا وَكَأَنَّ الطَرفَ وَسنانُ",21,"ن",1,0],["أَسبَلَ سِترَ سِرِّهِ حَتّى إِذا","عايَنَهُ اِستَعبَرَ شَوقاً فَاِنهَتَك",22,"ك",1,0],["أسبت لموطني يمسي","ملاذ حثالة الأمم",23,"م",1,0],["أسبابُه أكثرُ من القر","بى وَأعلى وَأشد",24,"د",1,0],["أَسبلِ الدمعَ عندَ نشرِ دخانِ","فيهِ عطرٌ مِن ياسمينٍ بحقّه",25,"ه",1,1],["اِسبُلِ الشِعرَ مُعجِباً وَتَهيا","لِيُديرَ الكُؤسَ في حالِ سُكرِهِ",26,"ه",1,1],["اسبقي الشمس كالشعاع وثوباً","واسأليها يا أختها أن تثوبا",27,"ب",2,1],["أسبَغَ النُّعمَى فَطَابَت جَنّة","وَجلا البُشرَى فَقَامَت عُرُسَا",28,"س",2,0],["أسبَغْتَ ظِلَّ العَدْلِ غيرَ مُقَلَّصٍ","وسقَيْتَ ماءَ الخَفْضِ غيرَ مُصرَّد",29,"د",1,0],["أَسْبَلَ الليلَ عَلَى مَتْ","نَيْهِ إِسبالَ النِّقابِ",30,"ب",1,0],["أسباب ذنبي متيناً قد اتصلت","أسباب صالحة الأعمال في رثث",31,"ث",1,0],["أسبابُ أهلِكَ يا أوفاهُمُ رَحِماً","أقاطِعٌ أنتَ مِن أسبابِهِم سَبَبا ؟!",32,"ب",2,0],["أسَبِّحُ اللهَ في شروقٍ","لا يُرقبُ بعده مغيبُ",33,"ب",1,0],["أسبلت من أسفي دمعي غداة خلت","رحابكم وعدت مهجورة السبل",34,"ل",1,0],["أسْبَلْتَ جِلبابَ التَّجاهُلِ عامِداً","ولَقَدْ عَرَفْتَ تَهالُكَ الْمَعْمُودِ",35,"د",1,0],["أسبَغَ اللهُ أنعُماً ليس تُحصى","عنكَ فاشكُرهُ ولتَزِد له شُكرا",36,"ر",2,0],["أسبقهم منهم وذلك الحسن","حتى إذا ما مات قام قيل من",37,"ن",1,0],["أَسْبلَتْ دَمْعِي كَجُودِ المُقْرِىءِ ال","عَالِم العَادِلِ الكَبِيرِ المُغازِي",38,"ز",2,0],["أسبي ومثلك من يحوط سرادقي","هذا لعمري أعظم البرحاء",39,"ا",2,0],["أَسباط مَن بِعَطائه وَسطائه","بِالعَدل قَد أَحيا النُفوس وَدمَّرا",40,"ر",2,0],["أُسبِغَ كلُّ النعيم فيه ولا","نعيمَ ما لم يَصِلْه إِسباغ",41,"غ",1,0],["أَسبلَ الرّوضُ بُرقُعَ التّوريدِ","وَهوَ يَزهو عَلى وُجوهِ الوُرودِ",42,"د",1,1],["أَسبَلَت سالِفاً فَجاءَ لِفيها","يَطلُبُ الشّربَ مِن طَهورِ الشّرابِ",43,"ب",1,0],["أَسبغ رَبّنا لِباسَ العافِيَه","عَلى الأميرِ ذي الهِباتِ الوافِيَه",44,"ه",1,0],["أسْبَلَ الشَّعْرَ وَانْثَنَى فَتَثَنَّى","كَقَضِيب يَجُرُّ فَاضِلَ بُرْدِهْ",45,"د",2,0],["أَسْبابَهُ بِالنَجْمِ حِينَ حَلَّقا","بُعْداً مِنَ الغَدْرِ وَإِنْ تَوَعَّقا",46,"ق",2,0],["أسبع الله فوق قبرك صحبا","من نعيم مخلد للمعادِ",47,"د",1,0],["أَسِبلْ جفونَكَ بالعقيقِ وحيِّه","فلعلَّ سائلَه يحرِّكُ ما سَكَن",48,"ن",1,0],["أَسباء هشتون شابور ملكون","سيلا هاسون كافور ساقي",49,"ق",2,0],["أَسباء ساحون ساحت","كَأَنَّها جبرائيل",50,"ل",1,0],["أَسبابَ نُعم الغِنى وَالعِزِّ باسِطَةً","قالَت تَمَنَّ تَجِد قُلتُ لَها جودي",51,"د",2,0],["أسباطُ مَلحَمةٍ دَعائمٌ سُؤددٍ","حازُوا المآثِرَ والفَخارَ الأقدما",52,"م",2,0],["أَسبَلَت فَوقَ الشَعَرَ الوَح","فَ فَكانَت لَيلاً بِهَيماً وَفَجرا",53,"ر",2,0],["أَسُباتٌ عَلى الفِراشِ خُفاتٌ","أَم بِكَفَّيْ مُفَجَّعٍ حَرّانِ",54,"ن",1,0],["أسباب الصّوادف حيرتني","وانته لي تعرف الحق فيّه",55,"ي",2,0],["أسبِّح الله بأسمائه","من كلِّ مذمومٍ ومحمود",56,"د",1,1],["أسبلت فرعاً على تلك النهود","رىوأدارت كأس خمرٍ من برود",57,"د",1,1],["آس بحميا الوصل رجاس","وأحيَ إفهواك اليوم هاوي",58,"ا",3,0],["اسباطُ يعقوبَ باعوا يوسفا فحووا","عاراً بذاك وعيباً مدة الأبد",59,"د",1,0],["أَسبل يَوم عَلَينا","هاطل الأُنس عهادا",60,"د",2,0],["أسبلات بالنُّعمانِ عيني إذ هي","وجنتاها شقائقُ النُّعمَانِ",61,"ن",1,0],["أسبغ الله حوله نعمة العي","ش حليّاً بالمال والولدان",62,"ن",1,0],["أسبقُ النورَ فوق مركبتي العجلى","وقلبي يطيرُ أنّى يطيرُ",63,"ر",1,0],["أَسْبَابُ ميثَاقكَ الوُثْقَى وَإِنْ فُصمَتْ","مِنْ خَائِنِي الْعَهْدِ أَوْصَالٌ وأسْبَابٌ",64,"ب",1,0],["أسب مغلطي شعري انتقاما","وهل يطفى من السب الغليل",65,"ل",1,0],["أسبلت ثوبها عليه فلم","أملك سلواً ولج بي كلفي",66,"ف",2,0],["اسباطه سلكو آثاره فرقوا","مقام خير وحازوا العلم والادبا",67,"ب",2,0],["أسبقتمونا للفضيلة والتقى","وخشيتمو الهلكات إن لم نلحق",68,"ق",1,0],["أسبل من أجفانه أدمعا","لما رآني مسبلا أدمعا",69,"ع",2,0],["اسبغت نعمى هي مشكورة","فاستانفي سابغ نعماك",70,"ك",1,0],["أسباب خيبته محبة أمه","ومن البلاء محبة الجهلاء",71,"ا",2,0],["أسبابةٌ زاد إبهامُهُ","بسقمي ولي خصرُه خنصر",72,"ر",1,0],["آس بيان دوح ورد زها","وِرد سماح بحر جدوى موال",73,"ل",1,0],["أسبلت دمع أمير المؤمنين","واذا بت قلب خير المرسلين",74,"ن",1,0],["أُسَبُّ إِذا أَجَدتُ القولَ فيهم","كَذاك يُقال للرجلِ الجَليدِ",75,"د",1,0],["أَسباط مِن بعطائه وَبِبَأسِهِ","بِالعَدل قَد أُحيي النُفوس وَدمرا",76,"ر",2,0],["أَسبِغ وُضوءَكَ لا تفرِّق شمله","فالفَورُ والإِسباغُ مُفتَرضانِ",77,"ن",1,0],["أسباب رزق الله في أقليمنا","أقلامه لو لم تكن لو يرزق",78,"ق",1,0],["أسبغ في عيش الدنا زهده","وأشبع الجيش بزاد زهيد",79,"د",1,0],["أس بيعتهِ وراعيها الجليل","والرئيسُ العامُ في جِيلٍ وجيل",80,"ل",1,0],["اسبابُ موتي سوءُ فعلي ان ذا","سببٌ لهُ بادٍ وجِسمي مادي",81,"د",2,0],["أسبَلَ دمعي لصدره دُرَراً","جسمي لفرط الضَّنَى لها سلكُ",82,"ك",1,0],["أَسباطُ يوسُفَ مِن مِصرَ أَتَو وَلَهُم","مِن غَيرِ تيهٍ بِها سَلوى وَأَمنانُ",83,"ن",1,0],["أسبابها نافرتت أوتادها وبدا","فيها زحافٌ وايطاءٌ قد التأما",84,"م",2,0],["أسبلتَ دمعك فوق النحر من كلفٍ","حتى غدا وهو مُرفضٌّ ومَسجومَ",85,"م",1,0],["أسبَلَت شَعرَهَا عَلَى وَجهِهَا فَخ","راً عَلَى شَعرِ تِربِهَا وَدَلاَلا",86,"ل",2,1],["اسبَغَ اللهُ نِعمَةً وَجَبَ الشُّكرُ","عَلَينَا وَحَقَّ مِنَّا الثَّنَاءُ",87,"ا",2,0],["اسبلْ علينا سترَكَ المتينا","واجعل علينا حصنكَ الحصينا",88,"ن",2,0],["أسبل الصدغ على خد","دك من مسك عذارا",89,"ر",2,0],["أَسَبْعٌ عجائبُ هذا الزمان","نزلنا إلى درك السابعة",90,"ع",2,0],["أسبغْ عليه إلهي رحمة وسعت","كل الخلائق وامح الذنب رباه",91,"ا",2,0],["أسبلوا دمعكم دما","وادخلوا الباب سجدا",92,"د",2,0],["اسبلت دمعي في تطلب من يكن","كهفا وملجأ في الصعاب للائذ",93,"ذ",1,0],["أسبلت ليل الجعود","فوق رمان النهود",94,"د",1,1],["أسباب رضاك التي ذخرت لضيقي","حبي ومديحي ونسبتي مع ايمان",95,"ن",1,0],["أسبّحُ إذ عاينتُ قدرة خالقي","بوجهٍ لسلمى فاتنٍ وأنيقِ",96,"ق",1,0],["أسبَل الصُّدعُ على خدِّكَ","من مِسْكٍ عِذارا",97,"ر",2,0],["أسبلت فرعاً على تلك النهود","وأدارت كأس خمرٍ من برود",98,"د",1,1],["أَسْبِقُ الفجرَ في الهُبوطِ إلى البحرِ","وكَم طابَ لي بهِ اسْتِحْمامُ",99,"م",1,0],["أسبوع يقبل عليّ ويقفي أسبوع","وأحاول أحيا بذكرك وأقتل البين",100,"ن",1,0],["أسبل الليلُ سُدولاً فوقكم","وتمطّى وقضى منكم لُبانه",101,"ن",2,0],["أسبح بليا مجاديف فبحور الخليل","وأنا ما اهيب البَحَر ولاصعود الجبال!",102,"ل",1,0],["اسبح ف بحر الودّ واغرس به امجاد","أمجاد حبّي لك وشوقي وحناني",103,"ن",2,0],["اسبح ف بحر اضلوع قلبك ودمّك","وارقد بعينك وانزع ادموع لهموم",104,"م",1,0],["أسبح واستعيذ والتجي بهہ من خطأ أو لوم","سواه اللہ سبحانه معافيني وحاميني",105,"ن",2,0]