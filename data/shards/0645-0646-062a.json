.aldiwan.net/poem27889.html","البسيط"],[508,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[541,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[541,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[554,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[554,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[561,"من تجلى له الإله بضر","https://www.aldiwan.net/poem33650.html","الخفيف"],[561,"إن محسوسات الحواس الظواهر","https://www.aldiwan.net/poem34517.html","الخفيف"],[570,"من تراه ينصفني من خليل","https://www.aldiwan.net/poem69533.html","الخفيف"],[570,"سارية بين الدياجي السود","https://www.aldiwan.net/poem69731.html","الرجز"],[578,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[578,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[589,"لا خلت من سناكم الأحياء","https://www.aldiwan.net/poem17398.html","الخفيف"],[589,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/72994","الوافر"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/31551","الوافر"]],"verses":[["مُنتَصِباتٍ كَالقَنا لا نَرى","عَيّاً مِنَ القَولِ وَلا أَفنا",0,"ن",2,0],["مَن تُرى يَدفَعُ رَوقَي","هِ وَمَن يَطلُعُ نيقَه",1,"ق",2,0],["مُنْتَهَبُ الدهرِ كُلَّ وَقْتٍ","قِطَافُهُ عَذْبَةُ الْمَجانِي",2,"ن",2,0],["مِن تَماثيلَ كَالنُجومِ الدَراري","يَهرَمُ الدَهرُ وَهيَ في عُنفُوانِ",3,"ن",1,0],["مُنْتَعِلُ البَرْقِ خَفِيُّ السُّرَى","يُصِمُّ بِالرَّعْدَةِ عَنْ رَعْدِهِ",4,"د",2,0],["مَنْ تُرَى بَعْدَ خَطْبِهِ","حَامِلاً ذَلِكَ الْقَلَمْ",5,"م",1,0],["من تحسدُ السّبعُ الطباقُ علاءهُ","عَالَوْا عليه من الثَّرى بطباقِ",6,"ق",1,0],["من تَخِذ العلمَ عُدّة لوغىُ","أغناه عن دِرعه وعن يَلَبه",7,"ب",2,0],["مِن تَحتِهِ لُقمانُ يَرجو نَهضَهُ","وَلَقَد رَأى لُقمانُ أَن لا يَأتَلي",8,"ل",2,0],["مَنَّتكَ نَفسُكَ يا اِبنَ صَقعَبَ مُنيَةً","كَذَبَتكَ نَفسُكَ ما لَها مِن نابِ",9,"ب",1,0],["من تفاصيلها القماش رياضٌ","مزهراتٌ على الغيوث أدله",10,"ل",2,0],["من تحامَى عداوتي فسعيدٌ","ومُعادِيَّ أوّلُ الأشقياءِ",11,"ا",2,0],["مُنْتنةٌ تضحى قَلنساتُها","أنتنَ أرواحاً من الجوربِ",12,"ب",1,0],["مُنتقلاً لا زال في نُقلةٍ","إلى المحلِّ الأبعد الأجدبِ",12,"ب",1,0],["مِنْ تَرْحَةٍ كَادَتْ تُكَدِّرُ فَرْحَةً","وأراكَ تكره أن أعيشَ مُتَرَّحَا",13,"ح",2,0],["من تُحَفٍ ما تُغِبُّ فائدةً","لم تكُ في وهمنا ولم نرها",14,"ر",3,0],["من تعتصمْ يده يوماً بعصمتنا","يمسكْ بحبل متين غير ذي غَررِ",15,"ر",1,0],["من تُعْطه يسعدْ ومن لا تُعطه","يسعدْ بصَوْنِكَهُ عن الأدناس",16,"س",1,0],["منتهك المالِ لا ممنَّعه","مُمَنَّعُ العِرضِ غيرُ منتَهكهْ",17,"ك",2,0],["من تبدٍّ وتَنزٍّ","وشُرورٍ فيه جَمَّهْ",18,"م",2,0],["مَنَّتكَ نَفسُكَ أَن تُسامِيَ دارِماً","أَو أَن تُوازِنَ حاجِباً وَعِقالا",19,"ل",2,0],["مَن تُرى غَيَّرَ ما أَع","هَدُ مِن تِلكَ السَجِيَّه",20,"ي",2,0],["مَن تَلقَ مِنهُم تَلقَ أَروَعَ ماجِداً","أَبَداً يَصولُ عَلى العِدى وَيَطولُ",21,"ل",1,0],["مَن تُؤتِهِ أشفَى عَلى ما فاتَهُ","مِنهَا وَإن لَم تجزِهِ بِنَوالِ",22,"ل",1,0],["من تعاجِل يمت وينس ومن تم","هل يعش تحت خافق متهاد",23,"د",1,0],["مَن تَكفِهِ الكُوفَةُ يَعلَم أَنَّها","لا نَصر عِندَ أَهلِها وَلا غَنا",24,"ا",1,0],["مُنتَزَهُ العَبّاسِ لِلمُجتَلى","آمَنتُ بِاللَهِ وَجَنّاتِهِ",25,"ت",2,1],["مُنتَظِماتٌ مائِجاتٌ بِهِ","مُنَمَّقاتٌ مِثلَ لُجّاتِهِ",25,"ت",2,0],["مُنتَهى ما بِهِ البِلادُ تُعَزّى","رَجُلٌ ماتَ في سَبيلِ البِلادِ",26,"د",1,0],["مُنتَهَبٍ كُلَّما","ظُنَّ بِهِ النَقصُ تَم",27,"م",1,0],["مِن تَغلِبَ الغالِبينَ الناسَ مَنصِبُهُ","وَمِن عَدِيٍّ أَعادي الجُبنِ وَالبَخَلِ",28,"ل",1,0],["مَن تَعاطى تَشَبُّهاً بِكَ أَعيا","هُ وَمَن دَلَّ في طَريقِكَ ضَلّا",29,"ل",2,0],["من تابَ عن شُربِ المُدا","مِ وعن مقارفةِ الحرامِ",30,"م",1,1],["مُنتَظَرٌ إِذنُهُ وَإِن سَئِمَت","نَفسُ أَبِيٍّ وَطالَ مُرتَقَبُه",31,"ب",2,0],["مَن تَحسُنُ الدُنيا بِإِحسانِهِ","وَيَجمُلُ الدَهرُ بِإِجمالِهِ",32,"ل",2,0],["مِن تَحتِ مُطبَقِ بابِ الشامِ في نَفَرَ","أَسرى يَوَدّونَ وَدّاً أَنَّهُم قُتِلوا",33,"ل",3,0],["مِن تَمَنّي الحَصيفِ عِندَ التَمَنّي","أَن يَكونَ الخِيارُ فيما تَمَنّى",34,"ن",2,0],["مَنَت لَكَ مِنّا أَن تُلاقِيَ عُصبَةً","حِمامُ مَنايا قُدنَ حَيناً مُقَدَّرا",35,"ر",2,0],["مُنتَجِعيكَ اِنتِجاعَ الغَيثِ إِذ وَقَعَت","أَشراطُهُ بِحَياً يُحيِي بِهِ الشَجَرا",36,"ر",2,0],["مِن تُرابٍ خُلِقتَ لا شَكَّ فيهِ","وَغَداً أَنتَ صائِرٌ لِلتُرابِ",37,"ب",1,1],["مَن تَمَنّى المُنى فَأَغرَقَ فيها","ماتَ مِن قَبلِ أَن يَنالَ مُناهُ",38,"ا",2,0],["مَن تَصَدّى لِأَخيهِ","بِالغِنى فَهوَ أَخوهُ",39,"و",2,0],["مَن تَرى مُسعِدي عَلى جَورِ بَدرٍ","يَتَجَلّى وَتارَةً يَتَجَنّى",40,"ن",2,0],["من تلزمُ الناسَ له طاعةٌ","قد أمرَ اللهُ بها في القُرَان",41,"ن",1,0],["مَنْ تَوَسّدْتُ في حشايا حشاها","وارتدى اللحمَ فيه والجلدَ عظمي",42,"م",2,0],["منتصرٌ باللّه في حربه","للّه من أعدائه منتقم",43,"م",1,0],["مَن تَراهُ يَحِدُّ فَضْلَ عَلِيٍّ","وهو مُسْتَصْعَبُ المرَام عسيرُ",44,"ر",1,0],["مَنْ تُوحي السحرَ بناظرةٍ","لا تُنْفَثُ منه في العُقَدِ",45,"د",1,0],["مَنْ تلقَهُ إلى سواهُ صابي","فأوِّلْهُ الإبدالَ في الإعرابِ",46,"ب",1,0],["مَن تَعَزّى عَمَّن يُحِبُّ فَإِنّي","لَيسَ لي ما حَيِيتُ عَنهُ عَزاءُ",47,"ا",2,0],["مُنتَسِباً لَونُهُ وَغُرَّتُهُ","إِلى سَوادِ الفُؤادِ وَالبَصَرِ",48,"ر",1,0],["مَن تَرى علَّم البخيلة حَتّى","سَمحت أَن يَقبِّل الطير فاها",49,"ه",2,0],["منتظري في غرفتي دهرَهُ","جودُ بخيلٍ ما تعوَّدْتُه",50,"ت",2,0],["مِن تُرابٍ بَينَ المَقامِ إِلى الرُك","نِ بَراها إِلالهُ حِينَ بَراها",51,"ا",3,0],["مُنتَقِلٌ في الأَنامِ يُشرِكُ في ال","حُبِّ أُلوفاً وَلَستُ أُشرِكُ بِه",52,"ب",2,0],["مُنْتَضٍ نَصْلاً إذا شاءَ مَضَى","رائشٌ سَهماً إذا شاءَ قَصَد",53,"د",1,0],["مُنتَشِطاً مِن أُذنِهِ سُيورا","فَما يَزالُ والِغاً تامورا",54,"ر",2,0],["مُنتَظِماتٌ وَغَيرُ مُنتَظِمٍ","تَغورُ فيها وَبَعضُها طافِ",55,"ف",1,0],["مِن تِجاراتٍ أَشابَت مَفرِقي","وَكَسَتني ثَوبَ ذُلٍّ وَنَصَب",56,"ب",1,0],["من تركباني تركباني عالماً","بداريكما أكوي وقاع بميسم",57,"م",1,0],["من تَروّى أن النجوم شموس","عظمت في عيونه الكائنات",58,"ت",1,0],["من تحته نار تأز شواظها","يشوى وجوه ذوي الهوى والمأثم",59,"م",1,0],["منتظراً لي شاخصاً باسماً","