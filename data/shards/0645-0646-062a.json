ttps://www.aldiwan.net/poem32977.html","الخفيف"],[102,"برح بي الشوق فلما طغى","https://www.aldiwan.net/poem33000.html","السريع"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[52,"الموت من غادر أعذب به","https://www.aldiwan.net/poem27291.html","المنسرح"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[48,"إذا الشياطين رأت زنبورا","https://www.aldiwan.net/poem63409.html","الرجز"],[48,"لست لدار عفت بوصاف","https://www.aldiwan.net/poem64395.html","المنسرح"],[50,"وأخ ذي ثقة آخيته","https://www.aldiwan.net/poem64820.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85824","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39602","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55192","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55072","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54821","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142336","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[100,"كاهن الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=50426",""],[100,"خدعة","https://www.poetsgate.com/ViewPoem.aspx?id=50386",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[45,"مَنْ قَائلٌ للزّمَانِ ما أرَبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31692",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["مُنتَصِباتٍ كَالقَنا لا نَرى","عَيّاً مِنَ القَولِ وَلا أَفنا",0,"ن",2,0],["مَن تُرى يَدفَعُ رَوقَي","هِ وَمَن يَطلُعُ نيقَه",1,"ق",2,0],["مُنْتَهَبُ الدهرِ كُلَّ وَقْتٍ","قِطَافُهُ عَذْبَةُ الْمَجانِي",2,"ي",1,0],["مِن تَماثيلَ كَالنُجومِ الدَراري","يَهرَمُ الدَهرُ وَهيَ في عُنفُوانِ",3,"ن",1,0],["مُنْتَعِلُ البَرْقِ خَفِيُّ السُّرَى","يُصِمُّ بِالرَّعْدَةِ عَنْ رَعْدِهِ",4,"د",2,0],["مَنْ تُرَى بَعْدَ خَطْبِهِ","حَامِلاً ذَلِكَ الْقَلَمْ",5,"م",1,0],["من تحسدُ السّبعُ الطباقُ علاءهُ","عَالَوْا عليه من الثَّرى بطباقِ",6,"ق",1,0],["من تَخِذ العلمَ عُدّة لوغىُ","أغناه عن دِرعه وعن يَلَبه",7,"ب",2,0],["مِن تَحتِهِ لُقمانُ يَرجو نَهضَهُ","وَلَقَد رَأى لُقمانُ أَن لا يَأتَلي",8,"ل",2,0],["مَنَّتكَ نَفسُكَ يا اِبنَ صَقعَبَ مُنيَةً","كَذَبَتكَ نَفسُكَ ما لَها مِن نابِ",9,"ب",1,0],["من تفاصيلها القماش رياضٌ","مزهراتٌ على الغيوث أدله",10,"ل",2,0],["من تحامَى عداوتي فسعيدٌ","ومُعادِيَّ أوّلُ الأشقياءِ",11,"ا",2,0],["مُنْتنةٌ تضحى قَلنساتُها","أنتنَ أرواحاً من الجوربِ",12,"ب",1,0],["مُنتقلاً لا زال في نُقلةٍ","إلى المحلِّ الأبعد الأجدبِ",12,"ب",1,0],["مِنْ تَرْحَةٍ كَادَتْ تُكَدِّرُ فَرْحَةً","وأراكَ تكره أن أعيشَ مُتَرَّحَا",13,"ح",2,0],["من تُحَفٍ ما تُغِبُّ فائدةً","لم تكُ في وهمنا ولم نرها",14,"ر",3,0],["من تعتصمْ يده يوماً بعصمتنا","يمسكْ بحبل متين غير ذي غَررِ",15,"ر",1,0],["من تُعْطه يسعدْ ومن لا تُعطه","يسعدْ بصَوْنِكَهُ عن الأدناس",16,"س",1,0],["منتهك المالِ لا ممنَّعه","مُمَنَّعُ العِرضِ غيرُ منتَهكهْ",17,"ك",2,0],["من تبدٍّ وتَنزٍّ","وشُرورٍ فيه جَمَّهْ",18,"م",2,0],["مَنَّتكَ نَفسُكَ أَن تُسامِيَ دارِماً","أَو أَن تُوازِنَ حاجِباً وَعِقالا",19,"ل",2,0],["مَن تُرى غَيَّرَ ما أَع","هَدُ مِن تِلكَ السَجِيَّه",20,"ي",2,0],["مَن تَلقَ مِنهُم تَلقَ أَروَعَ ماجِداً","أَبَداً يَصولُ عَلى العِدى وَيَطولُ",21,"ل",1,0],["مَن تُؤتِهِ أشفَى عَلى ما فاتَهُ","مِنهَا وَإن لَم تجزِهِ بِنَوالِ",22,"ل",1,0],["من تعاجِل يمت وينس ومن تم","هل يعش تحت خافق متهاد",23,"د",1,0],["مَن تَكفِهِ الكُوفَةُ يَعلَم أَنَّها","لا نَصر عِندَ أَهلِها وَلا غَنا",24,"ا",1,0],["مُنتَزَهُ العَبّاسِ لِلمُجتَلى","آمَنتُ بِاللَهِ وَجَنّاتِهِ",25,"ت",2,1],["مُنتَظِماتٌ مائِجاتٌ بِهِ","مُنَمَّقاتٌ مِثلَ لُجّاتِهِ",25,"ت",2,0],["مُنتَهى ما بِهِ البِلادُ تُعَزّى","رَجُلٌ ماتَ في سَبيلِ البِلادِ",26,"د",1,0],["مُنتَهَبٍ كُلَّما","ظُنَّ بِهِ النَقصُ تَم",27,"م",1,0],["مِن تَغلِبَ الغالِبينَ الناسَ مَنصِبُهُ","وَمِن عَدِيٍّ أَعادي الجُبنِ وَالبَخَلِ",28,"ل",1,0],["مَن تَعاطى تَشَبُّهاً بِكَ أَعيا","هُ وَمَن دَلَّ في طَريقِكَ ضَلّا",29,"ل",2,0],["من تابَ عن شُربِ المُدا","مِ وعن مقارفةِ الحرامِ",30,"م",1,1],["مُنتَظَرٌ إِذنُهُ وَإِن سَئِمَت","نَفسُ أَبِيٍّ وَطالَ مُرتَقَبُه",31,"ب",2,0],["مَن تَحسُنُ الدُنيا بِإِحسانِهِ","وَيَجمُلُ الدَهرُ بِإِجمالِهِ",32,"ل",2,0],["مِن تَحتِ مُطبَقِ بابِ الشامِ في نَفَرَ","أَسرى يَوَدّونَ وَدّاً أَنَّهُم قُتِلوا",33,"ل",3,0],["مِن تَمَنّي الحَصيفِ عِندَ التَمَنّي","أَن يَكونَ الخِيارُ فيما تَمَنّى",34,"ن",2,0],["مَنَت لَكَ مِنّا أَن تُلاقِيَ عُصبَةً","حِمامُ مَنايا قُدنَ حَيناً مُقَدَّرا",35,"ر",2,0],["مُنتَجِعيكَ اِنتِجاعَ الغَيثِ إِذ وَقَعَت","أَشراطُهُ بِحَياً يُحيِي بِهِ الشَجَرا",36,"ر",2,0],["مِن تُرابٍ خُلِقتَ لا شَكَّ فيهِ","وَغَداً أَنتَ صائِرٌ لِلتُرابِ",37,"ب",1,1],["مَن تَمَنّى المُنى فَأَغرَقَ فيها","ماتَ مِن قَبلِ أَن يَنالَ مُناهُ",38,"ا",2,0],["مَن تَصَدّى لِأَخيهِ","بِالغِنى فَهوَ أَخوهُ",39,"و",2,0],["مَن تَرى مُسعِدي عَلى جَورِ بَدرٍ","يَتَجَلّى وَتارَةً يَتَجَنّى",40,"ن",2,0],["من تلزمُ الناسَ له طاعةٌ","قد أمرَ اللهُ بها في القُرَان",41,"ن",1,0],["مَنْ تَوَسّدْتُ في حشايا حشاها","وارتدى اللحمَ فيه والجلدَ عظمي",42,"ي",1,0],["منتصرٌ باللّه في حربه","للّه من أعدائه منتقم",43,"م",1,0],["مَن تَراهُ يَحِدُّ فَضْلَ عَلِيٍّ","وهو مُسْتَصْعَبُ المرَام عسيرُ",44,"ر",1,0],["مَنْ تُوحي السحرَ بناظرةٍ","لا تُنْفَثُ منه في العُقَدِ",45,"د",1,0],["مَنْ تلقَهُ إلى سواهُ صابي","فأوِّلْهُ الإبدالَ في الإعرابِ",46,"ب",1,0],["مَن تَعَزّى عَمَّن يُحِبُّ فَإِنّي","لَيسَ لي ما حَيِيتُ عَنهُ عَزاءُ",47,"ا",2,0],["مُنتَسِباً لَونُهُ وَغُرَّتُهُ","إِلى سَوادِ الفُؤادِ وَالبَصَرِ",48,"ر",1,0],["مَن تَرى علَّم البخيلة حَتّى","سَمحت أَن يَقبِّل الطير فاها",49,"ه",2,0],["منتظري في غرفتي دهرَهُ","جودُ بخيلٍ ما تعوَّدْتُه",50,"ت",2,0],["مِن تُرابٍ بَينَ المَقامِ إِلى الرُك","نِ بَراها إِلالهُ حِينَ بَراها",51,"ا",3,0],["مُنتَقِلٌ في الأَنامِ يُشرِكُ في ال","حُبِّ أُلوفاً وَلَستُ أُشرِكُ بِه",52,"ب",2,0],["مُنْتَضٍ نَصْلاً إذا شاءَ مَضَى","رائشٌ سَهماً إذا شاءَ قَصَد",53,"د",1,0],["مُنتَشِطاً مِن أُذنِهِ سُيورا","فَما يَزالُ والِغاً تامورا",54,"ر",2,0],["مُنتَظِماتٌ وَغَيرُ مُنتَظِمٍ","تَغورُ فيها وَبَعضُها طافِ",55,"ف",1,0],["مِن تِجاراتٍ أَشابَت مَفرِقي","وَكَسَتني ثَوبَ ذُلٍّ وَنَصَب",56,"ب",1,0],["من تَروّى أن النجوم شموس","عظمت في عيونه الكائنات",57,"ت",1,0],["من تحته نار تأز شواظها","يشوى وجوه ذوي الهوى والمأثم",58,"م",1,0],["منتظراً لي شاخصاً باسماً","تُشِيرُ بالآمال لي راحتاه",59,"ه",1,0],["مَن تراها وإلى أين ومِن","أيِّ خدرٍ طلعتْ أو سامرِ",60,"ر",1,0],["مَنْ تُرى علّمها بالأمسِ حواءَ وآدمْ","لمْ تَزُلْ جِدَّتُها وهيَ حديثٌ يتقادمْ",61,"م",1,0],["مِنْ تُحْفَةٍ مَنْظُومَةٍ لِفُكَاهَةٍ","أَوْ طُرْفَةٍ مَنْظُومَةٍ لِغِنَاءِ",62,"ا",2,0],["مَنْ تَمَنَّى أَنْ يُبْصِرَ الحُسْنَ فِي صُورَةِ","أُنْسٍ رَآهُ فِي وَجْهِ إِلاَّ",63,"ل",2,0],["مَنْ تُرَى عَلَّمَهَا مَا مَزَجَتْ","مِنْ وَجِيفٍ وَعَوِيلٍ وَنَعِيقِ",64,"ق",1,0],["مُنْتَفِياً بَأْسُ الْعَوَادِي بِه","كَمَا انْتفى الْعُنْصُرُ بِالْعُنْصُرِ",65,"ر",1,0],["مَنْ تَسْتَطِلْ آثَارُهُ عُمْرَهُ","يَطُلْ فَإِنْ تَقْصُرْ بِه يَقْصُرِ",65,"ر",1,0],["مُنْتَبِذاً بَهَارِجَ التَّشْيِيعِ وَالتَّ","وْدِيعِ فِي نِهَايَة الجِهَادِ",66,"د",1,0],["مِنْ تَقْليبِكَ الحَقَائِقَ هَلْ كَا","نَ لِوَهْمٍ تَصُوغُهُ مِنْ خَلاَقِ",67,"ق",1,0],["مُنْتَهَى مَا يُجَادُ رَسْماً وَأَبْهَى","مَا تَحُجُّ الْقُلُوبُ فِي الأَنْظَارِ",68,"ر",1,0],["مُنْتَبِذَ السُّبْلِ الَّتِي","تُعْلِقُ بِالثَّوْبِ الوَضَرْ",69,"ر",1,0],["مُنْتَظِمٌ مُنْتثِرٌ ضَاحِكٌ","بَاكِ لَهُ مَاءٌ وَفِيهِ سَعِيرْ",70,"ر",1,0],["مَنْ تَرَاهُ يَصِفُ الوَجْدَ الَّذِي","وَجَدُوهُ إِنْ دَنَا يَوْمُ اللِّقَاءْ",71,"ا",2,0],["مَنْ تَقَصَّى أدْوَارَنَا فِي الْمَرَاقِي","عَزَّهُ أَنْ يَرَى كَعَهْدِكَ عَهْدَا",72,"د",2,0],["مُنتَقى الأَخلاقِ جَدَّ إِلى","جَنَّة الفِردَوسِ مُنتَقِلا",73,"ل",2,0],["منتهى دنياه نهد شرس","وفم سمح وخصر طيع",74,"ع",1,0],["مَنْ تُرَى يَسْتَطِيعُ تَصْوِيرَ فِكْرٍ","لَكَ أَمْضى مِنْ رَجْعَةِ الأَصْدَاءِ",75,"ا",2,0],["مَنْ تُرَى يَسْتَطِيعُ تَصْوِيرَ رَأْيٍ","أَلْمَعِيَ كالْكَوْكَبِ الْوَضَّاءِ",75,"ا",2,0],["من ترضَ «لندنُ» عنْهُ مِنْ","أهل الحِمَى، فهو السعيد",76,"د",1,0],["من تغنّي هنا ؟ وتبكي على ما ؟","كل شيء لا يستحق اهتماما",77,"م",2,1],["من تغنى يا ((كاهن الحرف)) ماذا ؟","هل سعال الحروف يشجي الركاما",77,"م",2,0],["من تمنحين ، الضحكة الواعده","والهزة المعطاءه ، الناشده",78,"د",2,1],["مَن تحبّين يا ابنة الحزب؟ أهوى","قمراً عاشقاً وغصناً عقيقي",79,"ق",2,0],["مُنْتَظَرٌ إذْنُهُ، وَلَوْ سَئمَتْ","نَفْسُ أبيٍّ، وَطَالَ مُرْتَقَبُهْ",80,"ب",2,0],["منتصراً طوراً وطوراً صافدا","مازلت أختارُ لك المحامدا",81,"د",2,0],["منتهى للظهور في مسرح الكو","ن لناس ومبدأ للخفاء",82,"ا",2,0]]}