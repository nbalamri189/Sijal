],[5732,"حار قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177943",""],[5739,"يشربه سمعي","https://www.poetsgate.com/ViewPoem.aspx?id=152740",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5957,"يا حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=25885",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[161,"السُّكَّرُ والسُّكَّرِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=157685",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[6113,"ان بعض الظن اثم","https://www.poetsgate.com/ViewPoem.aspx?id=26374",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[6307,"اعتراف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79013&r=&rc=1",""]],"verses":[["يا حَياةً يَشجى بِها كُلُّ حَيٍّ","وَالتَوالي شَجِيَّةٌ بِالهَوادي",0,"د",2,0],["يا حَياتي لَقَد هَمَمتُ بِأَن أَل","بَسَ ثَوبَينِ مِن ثيابِ الطَبيبِ",1,"ب",1,1],["يا حياً عَمّ نفعُه بعد جدبٍ","يا هلال الإفطار يا بتَّ عندي",2,"د",2,0],["يا حياً سحَّ مُزنُه الوابلُ الهط","طالُ أَرْدِفْهُ دِيمةً مِهطالا",3,"ل",2,0],["يا حَيفَ مَن في الصَباحِ أَغفى","وَغَبنَ مَن لِلصَبوحِ فَوَّت",4,"ت",1,0],["يا حياة اليائس المنفرد","يا يباباً ما به من أحد",5,"د",1,0],["يا حيَّ عالمِ عصرِنا وزمانِنا","ألكَ التصرفُ في دمِ الأخوينِ",6,"ن",1,0],["يا حيثُ لوْ أصبحَ بابُ الرضى","كيفَ لما كنتُ كأمسِ مضى",7,"ض",2,0],["يا حي عالم دهرِنا أحييتنا","فلكَ التصرفُ في دمِ الأخوينِ",8,"ن",1,0],["يا حياةً يهتفُ النَّاسُ بها","إنّما أنتِ حياةُ الهازلينْ",9,"ن",1,0],["يا حيارى الشعوب ويحكِ إنّ ال","حقَّ أعلى يداً وأقوى ظهيرا",10,"ر",2,0],["يا حياةَ النُّفوسِ جِئتَ قُباءً","جِيئةَ الرُّوحِ تَبعثُ المقبورا",10,"ر",2,0],["يا حَياتي لا تَغضَبي وَتعالي","عانِقيني وَأَقصري مِن عِتابي",11,"ي",1,0],["يا حياةَ القلوبِ ويْلي عليها","ذَبُلَتْ من بقائها في يميني",12,"ن",2,0],["يا حيرتي أين حبّي أين ماضية","وأين أين صباه أو تصابيه",13,"ي",2,1],["يا حياتي ويا حياتي إلى كم","أحتسي من يديك صابا وعلقم",14,"م",1,1],["يا حياتي وما حياتي وما مع","نى وجودي فيها لأشقى وأظلم",14,"م",1,0],["يا حياتي أنت الحقيقة عندي","فيك حتى أموت نحسي وسعدي",15,"ي",1,0],["يا حيرة دهشت ذوي الالباب من","ايام مزلقة غدون لياليا",16,"ي",2,0],["يا حيّذا زُوزَنُ الغَرّاء من بلدٍ","نابُ الحوادثِ عن أكنافها نابِ",17,"ب",1,0],["يا حيرة الشيخ الأصم وح","سرة الحدث الضرير",18,"ر",1,0],["يا حيرة العطشان وق","ت الظهر في وسط الهجير",18,"ر",1,0],["يا حَيُّ يا قَيّومُ إِن","وَكَّلتَنا فَمَن لَنا",19,"ن",2,0],["يا حيرتي بين أحلام تززعها","على كف الغرام الراحم الجاني",20,"ن",2,0],["يا حيرة الرائي","أيجمع الضدان",21,"ن",1,0],["يا حيرَة المُشتاق اِن هُوَ لَم يبح","بِالحُبّ ماتَ وَان يبح لا يعذر",22,"ر",1,0],["يا حياتي وأنتَ ضِدُّ حياتي","وقَراري وأنت غَيثُ قَراري",23,"ر",2,0],["يا حَياتي أَراكِ عاراً مَع التَفريق","وَالبُعد فَاِذهَبي بِسَلام",24,"م",1,0],["يا حَياتي وَحَمامي","وَحَميمي وَغَريمي",25,"م",2,0],["يا حي ياقيوم يا حي ياقيوم","يا حي ياقيوم فرج على المغموم",26,"م",1,1],["يا حيدَرُ الشَهمُ البَطَل","مَن لَم يشايِعك يَضَل",27,"ل",1,0],["يا حياة الإنسان لا فرحة في","ك إذا لم تصحب بدمع غبين",28,"ن",1,0],["يا حَيْنَ مختارٍ لسُخْطِكَ بعدما","ضاءَتْ لَهُ الدنيا بنجمِ رِضاكا",29,"ك",2,0],["يا حي يا غفار يا رحمن بل","أنت الحليم مجيب دعوة من ثنا",30,"ن",2,0],["يا حَيرَةً تَجعَلُ الأفكارَ حائِرَةً","مِنَ الأَعادي ويَعمى مِنهُمُ النَظَرُ",31,"ر",1,0],["يا حَيْرَةَ الحُسَّادِ إنَّ قُيودَهُمْ","ثَقُلَتْ ألا بالوهمِ فلْيَتَأَوَّلوا",32,"ل",3,0],["يا حَيْرَةً غلبتْ قوماً وغِيلَ بهم","وفي العُقولِ دواءُ الدَّاءِ والدَّاءُ",33,"ا",2,0],["يا حياة الفتى إذا مات فيه","وفن