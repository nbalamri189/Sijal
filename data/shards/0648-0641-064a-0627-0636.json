{"poems":[[52,"أأبجر هل لهذا الليل صبح","https://www.aldiwan.net/poem63966.html","الوافر"],[435,"لك العلياء والشرف المفدى","https://www.aldiwan.net/poem41437.html","الوافر"],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124279","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89518","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135266","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77173","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139147","الوافر"]],"verses":[["وَفَيّاضِ اليَدَينِ عَلى المَوالي","لَهُ فَضلٌ يُعاشُ بِهِ وَمَنحُ",0,"ح",1,0],["وفياض المكارم منك يهمي","فلم يك في الأنام سواك رفدا",1,"د",2,0],["وفياض اليمين بلا امتنان","وروّاض الحرون بلا امتناع",2,"ع",1,0],["وَفي اِضطِرابِ الفَتى نُجحٌ لِبُغيَتِهِ","وَلِلمَقاديرِ إِسعادٌ وَخِذلانُ",3,"ن",1,0],["وفي اضطجاعِ والركوعِ والسجودْ","وفي انعدام كل شيء ووجودْ",4,"د",1,0],["وَفياض جود عاضَ عَن صيب الحَيا","وَعَمَّ بِهِ حَتّى اِرتو الوَهدُ وَالخال",5,"ل",1,0],["وفيّاضة الآلاءِ من خضرم الندا","وتملأُ موهوماً بوافي العطيَّة",6,"ه",1,0],["وفي أضدادها من غير شك","جميع وجوه أنواع الشرور",7,"ر",1,0]]}