يُعْقَلُ أَنْ أَنْسَى","https://www.poetsgate.com/ViewPoem.aspx?id=201808",""],[5002,"من خلف السّحاب...","https://www.poetsgate.com/ViewPoem.aspx?id=202380",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5411,"طَوّف بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185344",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5628,"زفرة على نعش غسان كنفاني","https://www.poetsgate.com/ViewPoem.aspx?id=178759",""],[5840,"تشكي المحبون الصبابة ليتني","https://www.poetsgate.com/ViewPoem.aspx?id=181438",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[186,"زمان الحمى هل من معاد فنطمعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55779&r=&rc=42",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""]],"verses":[["فَكانَت بَينَ قَومِكُمُ وَبَيني","خُماشاتٌ بِأَطرافِ العَوالي",0,"ي",1,0],["فكانت دَعْوَةٌ صعِدَتْ ونَجْوَى","تقبّلَها المُجيبُ لَها السّميعُ",1,"ع",1,0],["فَكانَت سَرِيَّتَهُنَّ الَّتي","تَروقُ العُيونَ وَتَقضي السِفارا",2,"ر",2,0],["فَكانَ تَنادينا وَعَقدَ عِذارِهِ","وَقالَ صِحابي قَد شَأَونَكَ فَاِطلُبِ",3,"ب",1,0],["فَكَانَتْ لَهُ خَيْرُ الفَوَاتِحِ بِالتُّقَى","وَكَانَتْ لَهُ فِي اللهِ خَيْرُ الخَوَاتِمِ",4,"م",1,0],["فَكَانَتْ ضُرُوبٌ مِنْ عَذَابٍ بَلَوْتَهَا","ضَمِيرُكَ رَاضِيَهَا وَمَنْ شَاءَ نَاقِمُ",5,"م",1,0],["فكانت لهذا القول في القوم هِزّةٌ","سروريّة من دونها هزّة السكر",6,"ر",1,0],["فكانت لها سود الجلابيب ِحليةُ","ولا عجبٌ أن الدجى من حِلى البدر",7,"ر",1,0],["فكانت أرانينُ الذباب هناكمُ","على شدوات الطير ضرباً موقَّعا",8,"ع",2,0],["فكان تاجاً زاد في بهجة","لا كُمَّةً غطَّت على صلعه",9,"ع",2,0],["فَكانَت لَآلٍ في الشُطوطِ وَفي الفَضا","غُيومٌ وَمَوجٌ ضاحِكٌ في الغَوارِبِ",10,"ب",1,0],["فَكانَت كَما نَشتَهي لَيلَةً","وَطالَ الحَديثُ وَطابَ السَمَر",11,"ر",1,0],["فَكانَتِ الكُوفَةُ مَبزَغَ القَمَر","قَد طَلَع السَعدُ بِهِ عَلى الزُمَر",12,"ر",1,0],["فَكانَت النيةُ ذات شَأنِ","وَكادَت الشَمس لَهُم تَستأني",12,"ي",1,0],["فَكانَت خَلفَهُم دُنيا","لَهُ في الأَرضِ كِبارَه",13,"ر",2,0],["فَكانَتِ الأولى تُباهي بِالسِمَن","وَقَولِهِم بِأَنَّها ذاتُ الثَمَن",14,"ن",1,0],["فَكانَت في مَرارَتِها زَئيراً","وَكانَت في حَلاوَتِها بُغاما",15,"م",2,0],["فَكانَت وَكُنّا فِداءَ الأَميرِ","وَلا زالَ مِن نِعمَةٍ في مَزيدِ",16,"د",1,0],["فَكانَت لَأَنفُسِنا هادِيَه","وَلَكِنَّها لِلعِدى داهِيَه",17,"ه",1,0],["فَكانَت لِشَهواتِنا نافِيَه","عَلى أَنَّها لَذَّةٌ فانِيَه",17,"ه",1,0],["فَكانَت دَعوَةً جَمَعَت نِزاراً","وَلَمَّت شَعثَها بَعدَ الفِراقِ",18,"ق",1,0],["فَكانَت كَنابٍ شارِفِ السِنِّ طَرَّقَت","بِسَقبٍ وَكانَت في مَخيلَةِ حائِلِ",19,"ل",1,0],["فَكانَ تَحَكُّماً لا وِزرَ فيهِ","أَيَكتُبُهُ عَلَيَّ الكاتِبانِ",20,"ن",1,0],["فكانتْ شُكُولاً منه زانَتْ حروفُهُ","حِساباً قَلَتْ منه الصِّحاحَ كُسورُ",21,"ر",1,0],["فكانت سراويلٌ وجرد خميصة","وخمس ميء قسيّ وزائف",22,"ف",1,0],["فَكانَت سماء العلم في الشرق تحتوي","على أَنجم والغرب ما فيه أَنجم",23,"م",1,0],["فكانت وكن فداء الأمير","ولا زال من نعمةٍ في مزيد",24,"د",1,0],["فكانت الحرب لدفع الحيف","قد تؤخذ السلم بحد السيف",25,"ف",1,0],["فكانت البصرة أول الثمر","ثم ترقّى في المنازل القمر",26,"ر",1,0],["فكانَتِ الَحيَّةُ الرَّقشَاءُ إذ خُلِقَت","كما تَرَى نَاقةً في الَخلقِ أو جَمَلا",27,"ل",2,0],["فكانت الضّعف قُوَّتها عَلينا","وهل ذا الطَّبعُ إِلّا في السُّلافِ",28,"ف",1,0],["فكانتْ حِيَلةٌ أنْ يَمْتَطيهِ","رضيعُ لِبانه فبغى وزادا",29,"د",2,0],["فكانتْ قوَّةٌ أخرى وداءُ","رَجَونا ان يكونَ به الدواء",30,"ا",2,0],["فكانت حساناً في المظاهرِ خُدْعة","على أنها كانت قِباحَ المخابر",31,"ر",1,0],["فَكَانَت كَنَامِي الغَرْسِ يَزْكُو وَيَنْضُرُ","وَمَطْعَمُهُ طِينٌ وَمَسْقَاهُ أَكْدَرُ",32,"ر",1,0],["فَكَانَت ثُبَاتِ المُهتَدِينَ حَيَاتُها","بِهِ وثُباتِ المغتَوِينَ تَوِينَا",33,"ن",2,0],["فكان تَجلّيها حجابَ جَمالِها","كَشَمسِ الضُحى يَعشى بِها الطَرفُ كُلّما",34,"م",2,0],["فكانت لنا فتنةً ضوعفت","بحسن المغطَّى وحسنِ الغِطاءِ",35,"ا",2,0],["فَكانَت عَزمَةً ذَهَبَت ضَلالاً","إِلى أَن أَصحَبَ الرَأيُ الأَصيلُ",36,"ل",1,0],["فَكانَت لَهُ أُماً وَكانَ لَها أَباً","غَذتهُ وَربَّاها وَقَد نَشأا مَعا",37,"ع",2,0],["فَكانَت له في عمرهِ شرّ رحلةٍ","بِها بينَ تجّارِ الهُدى ربحَ الخُسرا",38,"ر",2,0],["فَكانَت لأرواحِ المُحبّينَ جنّةً","وَكانَت عَلى أعداءِ خيرِ الورى جمرا",38,"ر",2,0],["فكانتْ بهِ جنةُ العاشقين","وكانَ فؤادي كرضوانها",39,"ن",3,0],["فكأن تحت البند مائج ردفه","موج به لعب الهوى فترجرجا",40,"ج",2,0],["فَكانَت تَنثَني عَنهُ اِغتِيالاً","وَتُنشِبُ رَأسَها لِلفَرسِ غَدرا",41,"ر",2,0],["فكانت برغم الدهر أحسنَ ليلةٍ","رأَيتُ لعمري بل هي العُمر أجمعُ",42,"ع",1,0],["فكانت سراباً لاحَ ماءً لِظامئٍ","ومَن لي بها فالوهمُ في الهمِّ نافع",43,"ع",1,0],["فكانت قِسمَتي الثّلثَينِ مِنها","بلا طَمَعٍ وللندمانِ ثلث",44,"ث",1,0],["فكانت جنودُ الحقّ تحتَ لوائها","تهدّدُ أهلَ البطلِ بالزحفات",45,"ت",1,0],["فكانت جحيماً من أبالِسةٍ أتوا","يبيعونَ وسطَ النّارِ فحشاً ومُسكرا",46,"ر",2,0],["فكانت لها أختامُ ملكٍ ونِعمَةٍ","وهَزَّ الدُّنَى تَصهالُها والحماحِم",47,"م",1,0],["فَكانَت الكِلابُ","في عينهِ تَنسابُ",48,"ب",1,0],["فكانت بتركي في مناهيه غفلتي","نهاية تأديبي وفرط عقوبتي",49,"ي",1,0],["فَكانَت بِحَمد اللَه لِلناس جنّةً","وَفَوزاً لآمال العفاة ذوي القَصدِ",50,"د",1,0],["فكانَتْ في النّساء إذا اعتَبرْنا","كمَولانا أبيها في الرِّجال",51,"ل",1,0],["فكانت صلاةٌ شادها ضمن جنةٍ","ليصعد فيها آدماً فوق جنة",52,"ه",1,0],["فَكانَت لَهُ راعياً","عِناية مَن لَم يَزَل",53,"ل",1,0],["فكانت على جيد الزَّمان قلائداً","تلوح وفي بعض القلوب نبالا",54,"ل",2,0],["فكانت إليه أحبَّ الديار","وحبّ الديار لسكانها",55,"ن",3,0],["فكان تأثيرُه هلالاً","يذكِّرُ البدرَ وهْو باهِر",56,"ر",1,0],["فكانتْ حُلى الأيامِ منهُ لآلئاً","فوا أسفي كيفَ استحالتْ لَياليا",57,"ي",2,0],["فكانتْ كَمَنْ