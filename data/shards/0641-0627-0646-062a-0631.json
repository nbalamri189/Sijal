.com/ViewPoem.aspx?id=203333",""],[5703,"أسطورة حلب","https://www.poetsgate.com/ViewPoem.aspx?id=206281",""],[5717,"وكم بدت للمصطفى معاجز","https://www.poetsgate.com/ViewPoem.aspx?id=170605",""],[5742,"بيت السبحية","https://www.poetsgate.com/ViewPoem.aspx?id=206895",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[4455,"أنا الصلتاني الذي قد عَلْمتِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=82290",""],[5950,"أصدق الكاذبين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128122",""],[5956,"أ آتي وأجلس قربك عمري؟","https://www.poetsgate.com/ViewPoem.aspx?id=206264",""],[5957,"ودادي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=29971",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""],[6259,"ألمت بنا بعد الهدوّ سعادُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59370&r=&rc=18",""],[2696,"ألا أبلغا ذا الخزرجيَّ رسالة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27416&r=&rc=20",""]],"verses":[["فَإِن تَرحَمونا اليَومَ نَرحَمكُمُ غَداً","بِعَودٍ مِنَ الجُزمِ النَزارِيِّ مُصعَبِ",0,"ب",1,0],["فَإِن تَرَ فينا صَولَةً عَجرَفِيَةً","فَقَد عُرِفَت فينا الجُدودُ الأَعارِبُ",1,"ب",1,0],["فَإِن تَرَيا إِذا ما سِرتُ شَخصي","أَمامَكُما فَلي قَلبٌ وَراءَ",2,"ا",2,0],["فَإِن تُرِكَت لِلكُحلِ لَم يَترُكِ البُكا","وَتَشرى إِذا ما حَثَحَثَتها المَراوِدُ",3,"د",1,0],["فإِنْ تَرَسَّلَ جَادَتْهُ قَرِيحَتُهُ","بِأَحْسَنِ القَوْلِ مِنْ جَزْلٍ وَمُنْسَجِمِ",4,"م",1,0],["فَإِنْ تَرَسَّلَ فِي عِلْمٍ وَفي أَدَبٍ","فَالْفِكْرُ مُبْتَكَرٌ وَاللَّفْظُ مُنْسَجِمُ",5,"م",1,0],["فَإِن تَرجِعوا رِزقي إِلَيَّ فَإِنَّهُ","مَتاعُ لَيالٍ وَالحَياةُ كَذوبُ",6,"ب",1,0],["فَإِن تُرجَم فَقَد وَجَبَت حُدودُ","وَحَلَّ عَلَيكَ ما لَقِيَت ثَمودُ",7,"د",1,0],["فَإِن تَرغَبوا في الصُلحِ فَالصُلحُ صالِحٌ","وَإِن تَجنَحوا لِلسِلمِ فَالسُلمُ أَسلَمُ",8,"م",1,0],["فَإِن تَرضَ هَذا فَالرِضا ما رَضيتَهُ","وَإِلّا فَغَيِّر إِنَّ أَمرَكَ راشِدُ",9,"د",1,0],["فإن تروَ أخبار التقى عنك والعلى","فإنك عبد الله وابن المبارَكِ",10,"ك",1,0],["فَإِن تَربَعوا تَربَع فَوارِسُ مُعرِضٍ","وَإِن تَركَبوا إِحدى الغَوايَةِ تَركَبِ",11,"ب",1,0],["فَإِن تَرفَعوا يَرفَع فَوارِسُ مُعرِضٍ","وَإِن تَركَبوا إِحدى الغَوايَةِ نَركَبِ",12,"ب",1,0],["فَإِن تَرغَبي عَنها وَفيكِ بَقِيَّةٌ","فَما أَنتِ نَفسي إِنَّما أَنتِ لِيَ ضِدُّ",13,"د",1,0],["فَإِن تَريني واجِماً باهِتاً","حَيالِها أَخشى عَلَيها الزَوال",14,"ل",1,0],["فَإِن تَرجِعوني حَيثُ كُنتُم رَدَدتُمُ","فَقَد رُدَّ بِالمَهدِيِّ كُلُّ المَظالِمِ",15,"م",1,0],["فَإِن تُرمَ عَن عُمرٍ تَدانى بِهِ المَدى","فَخانَكَ حَتّى لَم يَجِد فيكَ مَنزَعا",16,"ع",2,0],["فَإِن تَرجِعِ الأَيّامُ بَيني وَبَينَها","بِذي الأَثلِ صَيفاً مِثلَ صَيفي وَمَربَعي",17,"ي",1,1],["فَإِن تَرتَبِع يَوماً بِغَورِ تِهامَةٍ","نُقِم عِندَها أَو تَشرُكِ البَرَّ نُنجِدِ",18,"د",1,1],["فَإِن تَرُم عِندَهُ مُداعَبَةً","قالَ لَكَ اِحذَر مِن ذَلِكَ العَمَلِ",19,"ل",1,0],["فَإِن تَرشُدوا لا تَخضِبوا السَيفَ مِن دَمٍ","وَلا تُلزِموا الأَميالَ سَبرَ الجَرائِحِ",20,"ح",1,0],["فَإِن تُرِدِ العَليا فَلَستَ بِأَهلِها","وَإِن تَبسُطِ الكَفَّينِ لِلمَجدِ تَقصُرا",21,"ر",2,0],["فَإِن تَرِد العَليا فَلَستَ بِأَهلِها","وَإِن تَبسُطِ الكفَّينِ بِالمَجدِ تُقصَرا",22,"ر",2,0],["فإن ترفداني منكرا لا أثبكما","خنايَ وإلا تسأما الشر أسأم",23,"م",1,0],["فإنْ تَرْكُدْ بغِمْدِكَ لا تَخَفْني","وإنْ تَهْجُمْ علَيّ فغَيْرُ ناج",24,"ج",1,0],["فَإِنْ تَرَنِي وَالحُزْنُ مِلْءُ جَوانِحِي","أُدَارِيهِ فَلْيَغْرُرْك بِشْرِى وَإِينَاسِي",25,"س",2,0],["فأنت رمز الطهرِ والصلاح","لكن أقولُ: مطلَق السراح",26,"ح",1,0],["فإن تراءت لك الحمراء عن كثبٍ","فسائل الصرح أين المجد والجاه",27,"ا",2,0],["فان تراني مستصرخاً من مُلِمَّة","على الناس إذ لم أخدعِ الناسَ صاخبا",28,"ب",2,0],["فإن ترني أُذكي القوافي بنَفثَةٍ","أُراني على كِتمانها غيرَ صابر",29,"ر",1,0],["فإن ترعني عنها ، وفيك بقيّة ،","فما أنت نفسي إنّما أنت لي ضدّ",30,"د",1,0],["فَإِن تُرِد عَرَضَ الدُنيا بِمَنقَصَتي","فَإِنَّ ذَلِكَ مِمّا لَيسَ يُشجيني",31,"ن",2,0],["فإن ترضى الوداع شكرت نفسي","والا يرتضيه فشكرها له",32,"ه",1,0],["فإن تَرْدُدْ عليَّ فرَهْبتي منْ","وإنْ تُحسنْ إليَّ فَرَغبتي في",33,"ف",2,0],["فَإِن تَرفُضوا نُصحي فَما أَنا فيكُمُ","بِأَوَّلِ مَيمُونٍ عَصَتهُ قَبائِلُه",34,"ل",2,0],["فَأَنتِ رَمزٌ لإيحائي وَإِلهامي","أَبصَرته من كوى حُبّي وَأَحلامي",35,"ي",1,0],["فَأَنْتَ رَبٌّ جَمِيلٍ غَيْرَ مَكْفُورِ","وَأَنْتَ حِلْفُ صَنِيعٍ جِدُّ مَشْكُورِ",36,"ر",1,0],["فان تر ما تَرى مني فاني","لهجت بمنصب الحسن المثنى",37,"ن",2,0],["فَأَنتَ رَسولُ اللَهِ وَهيَ شهادَةٌ","أُقِرُّ بِها حَتّى المعادَ وَأَشهَدُ",38,"د",1,0],["فَإِن تَرضَ بِالمَقسومِ عِشتَ مُنَعَّماً","وَإِن لَم تَكُن تَرضى بِهِ عِشتَ في حُزنِ",39,"ن",1,0],["فَإِن تُرِد مَدحَهُ في نَشرِ طَيِّهِم","دَع ما اِدَّعَتهُ النَصارى في نَبِيِّهِم",40,"م",1,0],["فَإِن تَرَ تَقصيراً فَعَفوك لَم يَزَل","لَهُ ساتِراً ستر الرِداء عَلى العينِ",41,"ن",1,0],["فَإِن تَرَ فيهِ نَقصاً عَن وَفاءٍ","بِمَدحك فَاِقترح لِأَخيكَ عُذرا",42,"ر",2,0],["فإنْ تَرُعِ الهمومُ على مَشيبٍ","فقد خُلِقَتْ مطايانا عِجالا",43,"ل",2,0],["فإن تر قديساً خبيراً مجرباً","رَوِيَّتُه قفلٌ ورُؤْيَتُه فتح",44,"ح",1,0],["فَإِن تَرِدني الأَشَواق مُتُّ بِحَسرَتي","وَإِن تَبقني قاسَيت ما هُوَ أَصعَب",45,"ب",1,0],["فَإِن تَردني الأَشواق أَقض بِحَسرَتي","وَيَبقى الهَوى وَالشَوق أَسرَع قتّال",46,"ل",1,0],["فَإِن تَرِني مِن حلية المال عاطِلاً","فَإِن بَحَمد اللَهِ مِن عَفَّة حالي",46,"ل",2,0],["فَإِن تَرَ يَوماً لِلخَطوب اِستكانَتي","ما خالَفت وَاللَهِ قَوليَ أَفعالي",46,"ل",2,0],["فإن ترك الصلاة","من أعظم الموبقات",47,"ت",1,0],["فأنت روح له وراح","فلا سُلوٌّ ولا سلامه",48,"م",2,0],["فإن ترى الشرط مفقوداً فلست ترى","إلزام يلزم بالطاغي أبي لهب",49,"ب",1,0],["فإن ترد الوعظ الذي إن عقلته","فإن دموع العين عنه جواب",50,"ب",1,0],["فأن ترني أَخفي هَواها تجملاً","فَيا رُبَّما أَخفى الضِرام زِنادُ",51,"د",1,0],["فإن تُركوا لا يترك السيف قتلَهم","وإن ظَهَروا باؤوا بقاصمة الظهر",52,"ر",1,0],["فإن ترني بعدهم راضياً","ولو بالخيال فما عن رضا",53,"ا",1,0],["فأنتَ روحي وجسمي","لا فرقَ عنكَ وإلّا",54,"ل",2,0],["فإن ترْعَ ما ضيَّعت عادت كريمةً","وإلاَّ فقولُ الحقِّ ضرْبةُ لازبِ",55,"ب",1,0],["فإن ترعني سمع القبول فإنني","أُعزى فلا أهدا لصيحة خادم",56,"م",1,0],["فإنْ تَراها بلمْسٍ كلَّها اتَّحَدَتْ","ونكْتَةَ القدحِ تُبْدي كامِنَ الشَّرَرِ",57,"ر",1,0],["فإن ترع الأمانة لا أضعها","وإن لا ترع يوحشك انصرافي",58,"ف",2,0],["فَأَنتَ رَأس قُرَيش وَاِبن سَيدها","وَالرَأس فيهِ يَكونُ السَمع وَالبَصَر",59,"ر",1,0],["فَاِن تَرضى فَرُدّي قَول راضٍ","وَاِن تَأَبي فَنَحن عَلى السَواءِ",60,"ا",2,0],["فإنْ تَرَى مَلِكاً قَدْ قَصَّرَتْ يَدُهُ","عَنْ ذا وذَاكَ فهذا أَوَّلُ الْقَدَرِ",61,"ر",1,0],["فإنْ تركوا مآكلاً ومشارباً","فإنّك ترّاكٌ لكلّ حَرامِ",62,"م",1,0],["فَإِنْ تَرَهمْ في القاع نَثراً فشملهمْ","بجنّاتِ عَدْنٍ جامعٌ متألّفُ",63,"ف",1,0],["فإنْ ترقَ عيني من بكاءٍ تجمّلاً","فمن دونها قلبٌ بفقدك موجَعُ",64,"ع",1,0],["فإن ترى خلافهم في الأمر","فقد زعمت أن أهل الكفر",65,"ر",1,0],["فإن تروني عندكم عدوكم","فشفعوا في ولدي نبيكم",65,"م",1,0],["فإِنْ تَرْفَعِ المنقوصَ قَدْرًا تُجِلُّهُ","بِمَا ليس أَهْلًا، والزَّمانُ رقيبُ",66,"ب",1,0],["فَإن تَرزُقُونا العَونَ نَظفَر وإن يَكُن","سِواهُ فَمَن لَم يُرزَقِ العَونُ يُحرِم",67,"م",1,0],["فإن تَرَني فلا وَجدٌ كوجدي","فما كمصابِ فاطمةٍ مصابُ",68,"ب",1,0],["فإن ترد طيبَ عيشٍ في نَسا أجلٍ","وهيبة تشمل الأدنى ومن غربا",69,"ب",2,0],["فَإِن تَرحمي شَكوايَ والحالُ بيّن","أَعيني وَكوني لي يميني وَساعدي",70,"د",2,0],["فإن تروا من حديدٍ مائجٍ جبلاً","على العباب فلا يفزعكم الجبل",71,"ل",1,0],["فإن ترني فبعين اراك","فإني أراك بعين التمام",72,"م",1,0],["فَإِن تَرَ الغَشاشَ مِل إِلَيهِ","وَقُصَّ ذي حِكايَةً عَلَيهِ",73,"ه",1,0],["فإنْ ترقِّعْ تمزيق حادثةٍ","مزَّق أهلوه كلَّ ما ارْتفعا",74,"ع",2,0],["فإن تَرد الزوراء يوماً فَلحمها","حرامٌ وذاك الظهر منها مُحرَّر",75,"ر",1,0],["فَإِن ترَ شخصي في السكينةِ ساكناً","فَسوداءُ قَلبي في اِرتِكاب جهادِ",76,"د",1,0],["فَإِن تَرجِع إِلى الحُسنى وَإِلّا","فَما الإِجداءُ إِلّا في التَنائي",77,"ا",2,0],["فَإِن تَرَفَّعتَ أُخرى","إِذا فَعَلتَ عَلَينا",78,"ن",2,0],["فَإِنْ 