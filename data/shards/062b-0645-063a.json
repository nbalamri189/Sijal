{"poems":[[90,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[53,"ما أحسن العفو من المالك","https://www.aldiwan.net/poem65785.html","السريع"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[45,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[64,"حجر يظهر في التدبير","https://www.aldiwan.net/poem52191.html","مجزوء الرمل"],[47,"غلت الأشياء حتى الكشح","https://www.aldiwan.net/poem64549.html","مجزوء الرمل"],[63,"لما مضى اليوم حميدا فانجرد","https://www.aldiwan.net/poem51690.html","الرجز"],[82,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[33,"إرحمينا يا نعم مما لقينا","https://www.aldiwan.net/poem41278.html","الخفيف"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[104,"كيف أغويتني وأمعنت صدا","https://www.aldiwan.net/poem33127.html","الخفيف"],[52,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85299","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140961",""],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[236,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[264,"إن قلبي لديغ رقط الفراق","https://www.aldiwan.net/poem35937.html","الخفيف"],[333,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71005","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46541","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46515","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96199","المنسرح"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27233","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77420","المديد"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22590","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205812","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112621","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112341","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[4691,"بهجة العيد هويفا عندكم","https://www.poetsgate.com/ViewPoem.aspx?id=59590",""],[4728,"يوم سلّم","https://www.poetsgate.com/ViewPoem.aspx?id=176949",""],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4869,"خارج السرب .....","https://www.poetsgate.com/ViewPoem.aspx?id=155051",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5818,"اطرقِ الأبواب","https://www.poetsgate.com/ViewPoem.aspx?id=196542",""],[5829,"إنما الله غفور","https://www.poetsgate.com/ViewPoem.aspx?id=171624",""],[6124,"وردة","https://www.poetsgate.com/ViewPoem.aspx?id=120692",""],[6167,"عمارة الضباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85571&r=&rc=54",""],[6304,"يقظان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1616&r=&rc=6",""]],"verses":[["ثم غدت جرداء مزوَرّةً","والغيم أمست عينه تدمع",0,"ع",1,0],["ثُمَّ غَدَا يَنفُضُ الجَلِيدَ كَمَا","ساقَط عنه الهَشِيمَ مُحتَطِبُ",1,"ب",1,0],["ثمَّ غدر","لمَّا قدر",2,"ر",1,0],["ثم غدا من بعدِ ذا كلّه","أعْطَفَ مملوكٍ على مالِك",3,"ك",1,0],["ثُمَّ غابَت وَكُلُّ شَمسٍ سِوى هاتي","كَ تَبلى وَتَنطَوي تَحتَ رَمسِ",4,"س",1,0],["ثُمَّ غَدا قَيدُهُ الحِمامُ وَما","تَخلُصُ مِنهُ يَمينُ مَصفودِ",5,"د",1,0],["ثم غاص الطبع فيه","فهو في القبر رفات",6,"ت",1,0],["ثُمَّ غابوا فَتَوَلّا","ها بِتيهٍ وَاقتِدارِ",7,"ر",1,0],["ثم غَشِيناهنَّ أمّاً وولَد","وشادناً يُعطي القِيادَ مَنْ وَجَد",8,"د",1,0],["ثُمَّ غَطَّتْ بِنِقابٍ خَدّها","مَنْ رأى الشمسَ تَوارَت بالحِجاب",9,"ب",1,0],["ثُمَّ غَيَّرتِ ما فَعَلتِ بِفَعلٍ","كانَ فيهِ خِلافُ ما تَعِدينا",10,"ن",2,0],["ثم غشَّاهُ ضربةً عَلَّمَتْهُ","كيف يخشى الهِزبرَ مَن كان شهما",11,"م",2,0],["ثُمَ غَنى أُنشودة عَن حَبيب","لَم يَكُن ظالِماً وَلا خان عَهدا",12,"د",2,0],["ثُمَّ غَدَونا وَغَدا ذاهِباً","وَكُلُّ عَيشٍ مُؤذِنٌ بِالذَهاب",13,"ب",1,0],["ثُمّ غَرِّدْنَ في المَآتِمِ وانْدُبْ","نَ بِشَجْوٍ مَعَ الغَواني الخِرادِ",14,"د",1,0],["ثم غزا في عُقبِ عامٍ قابلِ","فجالَ في شَذُونةٍ والسَّاحلِ",15,"ل",1,0],["ثم غَزا في أَكثرِ العديدِ","مُسْتَصحبَاً بالنَّصرِ والتَّأييدِ",15,"د",1,0],["ثمَّ غزا الإمامُ دارَ الحَرْبِ","فكانَ خَطباً يا لهُ من خَطبِ",15,"ب",1,0],["ثمَّ غَزا بيُمنهِ أشُونَا","وقد أشادُوا حولها حُصونا",15,"ن",2,0],["ثمَّ غزا طَلْجيرةً إليها","وهي الشجَى من بين أَخدعَيْها",15,"ه",2,0],["ثمَّ غزا الإمامُ ذو المَجدَينِ","في مُبتدا عشرينَ واثنتينِ",15,"ن",1,0],["ثم غنى غرداً","وشدا مقتدرا",16,"ر",2,0],["ثُمَّ غابَت عَني فَلَم يَبقَ للشَم","سِ بأفق الرجاء غير شعاع",17,"ع",1,0],["\"ثمّ غدا قدّه الحمام، وما","تخلص منه يمين مصفود\"",18,"د",1,0],["ثُمَّ غالَت مِنكَ نَجمَ ال","جَوِّ فَاِنظُر كَيفَ نَجوى",19,"و",2,0],["ثم غارت يد الجلال فصانت","عزة ربعها فعز الوصول",20,"ل",1,0],["ثمّ غبنا لما رغبنا عن الغي","ر بكأس الجمال صافي المذاق",21,"ق",1,0],["ثم غيبي عن زحمة الموكب الأع","مى وعيشي للحزن والإطراق",22,"ق",1,0],["ثم غمغمت أعذر الله لمّا","طرد الجدّ لارتكاب الخطايا",23,"ي",2,0],["ثم غيبي عنهم إلى يوم ألقا","ك فأحيى مواثقي وعهودي",24,"د",2,0],["ثم غارتْ من أن يُماشيَها الظلْ","لُ فزارتْ في ليلةٍ ظَلماء",25,"ا",2,0],["ثم غَضُّوا عنه طَرفاً","وبوَجهٍ عنهُ مالوا",26,"ل",3,0],["ثم غابوا من بعدما اقتحموها","بين أمواجها وجاءت سيول",27,"ل",1,0],["ثم غاب الأمر عني واختفى","في وجود ظاهر للبصر",28,"ر",1,0],["ثم غلا المنصور في مقاله","وفارق الأمة في انتحاله",29,"ه",1,0],["ثم غلوا فيه فقالوا لم يمت","بل هو في شعب برضى قد ثبت",29,"ت",1,0],["ثم غلا وذكروا غلوه","فيما رووه وادعى النبوة",29,"ه",1,0],["ثم غلوا في القول واستحلوا","محارم الرحمان حتى ضلوا",29,"ل",3,0],["ثم غدتْ كَلاًّ على أهلها","تكرهها آذانُهم والعيون",30,"ن",1,0],["ثُمَّ غَزا ولاته","إِذ ظَنَّهم عداته",31,"ه",1,0],["ثُم غَزاه ذَلِكَ الليث الَّذي","كانَ بِه الجُند زَماناً قَد أَذى",32,"ذ",2,0],["ثم غابت نجومُها واكفَهَرَّت","واختفى نُورُها وزالَ البَهاء",33,"ا",2,0],["ثم غنت فخلتها سمحت","بروحها خلعة على روحي",34,"ي",1,0],["ثم غدا شيخاً على كرههِ","مرتعدَ الكفين والرجلِ",35,"ل",1,0],["ثمّ غابا عن الوجودِ زمانا","حين حلّت عساكرُ الاقتراح",36,"ح",1,0],["ثُمَّ غَنّاها يُرَدِّدها","آيَةً مِن مُحكَمِ الذِكرِ",37,"ر",1,0],["ثمَّ غَدَوتُ أستدلُّ ههنا","عليك بالرأفَةِ منك فاهدِنا",38,"ن",2,0],["ثُمَّ غارَت وَتَجَنَّت","وَأَجَدَّت في الصِّياحِ",39,"ح",1,0],["ثم غادرتنا وعدت وما في ال","كرم قنو من العناقيد حال",40,"ل",1,0],["ثمّ غدَوا يرمونَهُ بالنارِ","وبالحجارِ من أعالي الدار",41,"ر",1,0],["ثمّ غِبتِ","ألا تذكُرينَ بشطّ الغَدير",42,"ر",1,0],["ثم غالطتني وما كان هذا","فيك ظنّي ولا جزاء وصولي",43,"ل",2,0],["ثم غطيني بدفء ٍ واهمسي","مثلما همسي يناغي وجنتيكِ",44,"ك",1,0],["ثم غشاني في حريرٍ شذا فيه الخزام","لا تبعثر في يدي قال: تكفى لمّني",45,"ن",2,0],["ثُمَّ غابَ الوُقُودُ, والضَّوءُ, قُلنا:","بَعدَ هذا أَنَستَطيعُ احتِمالا!",46,"ل",2,0],["ثم غرّدي يا مدلله / خارج السرب","دينك غريب ,, وزوّديهم غرابه",47,"ب",2,0],["ثم غطي رأسيهما والخفايا","فالخفايا يصون منها الغطاء",48,"ا",2,0],["ثم غشوا زهر النجوم غيوما","غادرت نورها البهي ضئيلا",49,"ل",2,0],["ثمّ غيث اللطفِ يسقي مترفيها","مثل من يخشوه فيها دون فرقِ",50,"ق",1,0],["ثم غضَّ الطرف عنها","إنما الله غفور",51,"ر",1,0],["ثُمّ غَابَتْ فِي غِيَابِي","واصْطَفَتْنِي للعَذَابِ",52,"ب",1,0],["ثم غَرِّدْ في روابى الكونِ واسبحْ في الفضاءْ","وإذاخطبٌ رهيبٌ لا يبالى كيفَ جاءْ",53,"ا",2,0],["ثم غطاه من لضى القيظ لفح","أريحي يغار منه الحنانُ",54,"ن",1,0]]}