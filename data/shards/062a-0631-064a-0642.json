{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[32,"خليلي عوجا عوجة ناقتيكما","https://www.aldiwan.net/poem29543.html","الطويل"],[32,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[30,"يا ابن أبي حاضر يا شر ممتدح","https://www.aldiwan.net/poem5040.html","البسيط"],[30,"أتصرف أجمال النوى شاجنية","https://www.aldiwan.net/poem5245.html","الطويل"],[82,"ومستحسن في كل حال دلالها","https://www.aldiwan.net/poem31268.html","الطويل"],[82,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[46,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[48,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54685","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142039","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43632","الطويل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.poetsgate.com/ViewPoem.aspx?id=21791",""],[82,"شموسٌ دعاهنّ وشكُ الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=3318",""],[234,"كأن البركة الغنا إذا ما","https://www.aldiwan.net/poem51193.html","الوافر"],[287,"عذولي لا تلمني في هلالي","https://www.aldiwan.net/poem32663.html","الوافر"],[342,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[385,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107252","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83327","البسيط"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104022","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138113",""],[1108,"","https://poetry.dctabudhabi.ae/diwan/poem/146567","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26550","المتقارب"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109434","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106862","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10410","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103417","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48458","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91768","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128901","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131117",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66553","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86515","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59504","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93252","المنسرح"],[4852,"رجل إهداء","https://www.poetsgate.com/ViewPoem.aspx?id=214441",""],[5038,"حبيس الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=197668",""],[5145,"أما والزرق تخطر وهي سمر","https://www.poetsgate.com/ViewPoem.aspx?id=108061",""],[5187,"حوار مع القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29064",""],[5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[6281,"أعائشُ ما لأهلكِ لا أراهمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26413&r=&rc=14",""],[5190,"الزاهية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85079&r=&rc=154",""],[5190,"دموع التماسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78318&r=&rc=31",""]],"verses":[["تُريقُ عَليها كُؤوسَ الدَما","ءِ بِالطَعنِ وَالمَوتُ نَشوانُ صاحِ",0,"ح",1,0],["تَرى قورَها يَغرَقنَ في الآلِ مَرَّةً","وَآوِنَةً يَخرُجنَ مِن غامِرٍ ضَحلِ",1,"ل",1,0],["تَرى قُرطَها في وَاضِحِ اللَيتِ مُشرِفاً","عَلى هَلَكٍ في نَفنَفٍ يَتَطَوَّحُ",2,"ح",1,0],["تُريقُ سُيوفُهُ مُهَجَ الأَعادي","وَكُلُّ دَمٍ أَراقَتهُ جُبارُ",3,"ر",1,0],["تَرى قُدورَ اِبنِ عَبّادٍ مُعَسكِرَةً","وَالناسُ مِن صادِرٍ عَنها وَوَرّادِ",4,"د",1,0],["تَرى قَطَنٌ أَهلَ الأَصاريمِ إِنَّهُ","غَنِيٌّ إِذا ما كَلَّمَتهُ فَقيرُها",5,"ر",3,0],["ترى قَدّها في نشوةٍ من رَشَاقَةٍ","فهل خَلَعَتْ منه على الغُصُن اللدنِ",6,"ن",1,0],["تُريقُ المدامعَ كالساقياتِ","من السّكْرِ يَعْثُرْنَ بالأكؤسِ",7,"س",1,0],["تَرى قَسَماتِنا تَسوَدُّ فيها","وَما أَخلاقُنا فيها بِسودِ",8,"د",1,0],["تَرى قُرطَها مُستَهلَكاً دونَ حَبلِها","بِنَفنَفِهِ مِن واضِحِ الليتِ أَجيَدا",9,"د",2,0],["تُريقُ بِذاكَ في قَتلٍ دِماءً","رُؤوسٌ في الحَجيجِ مُلَبَّداتُ",10,"ت",1,0],["تُريقُ دِمَاءٌ حَرَّمَ اللَّهُ سَفْكَهَا","وَتَخْرُجُ مِنْهَا لا قِصَاصٌ وَلا عَقْلُ",11,"ل",1,0],["تَرَى قَوَافِيه فِي حُسْنِهَا نَبَتاً","كَمَا تَلاَحَقَ مِصْبَاحٌ بِمِصْبَاحِ",12,"ح",1,0],["تريقُ على الطروس دم الليالي","فتروينا ولم تنقع ظماكا",13,"ك",2,0],["تُرى قَبَّلَتكَ الريحُ عَنّي وَبَلَّغَت","مِنَ السِرَّ ما اِستَودَعتها حينَ هَبَّتِ",14,"ت",1,1],["ترَى قُرْطَهَا مُسْتَهْلَكاً دُونَ حَبْلِهَا","بِنَفْنَفِهِ مِن واضح اللِّيثِ أجْيَدَا",15,"د",2,0],["تُرِيقُ المدامِعَ كالساقياتِ","من السكر يعشرنَ بالأكؤس",16,"س",1,0],["تُرى قمرَ الدّجى قمراً حدَاه","طلوعاً ما له فيها بُروج",17,"ج",1,0],["تَرى قَوساً بِحاجِبِهِ وَراشَت","لَواحِظُهُ سِهاماً بِالنِّصالِ",18,"ل",1,0],["تَرى قِطَعاً مِنَ الأَحناشِ فيهِ","جَماجِمُهُنَّ كَالخَشلِ النَزيعِ",19,"ع",1,0],["تَرى قَبل مَوتي أَرا","ك يا هاجِري زائِري",20,"ي",1,0],["تَرى قَيساً يَسيرُ على وَرائي","تَرِفُّ عَلَيَّ أَلوِيَةُ الظِّرافِ",21,"ف",1,0],["تَرى قِبابَ السَنا في الأُفُقِ صاعِدَةً","عَلى أَساطينِ نورِ ناثِرِ الأَكرِ",22,"ر",1,0],["ترى قطراتِ الطلِّ كالدرِّ فوقها","إذا انتفضت في الأيكِ تنثرُهُ نثرا",23,"ر",2,1],["تريق عليه قطرها فيعيده","كما كان من ثغر الغمامة ريق",24,"ق",1,0],["تريق على القتلى البطاريق عبرة","دماً شيب بالمسك الذي هو خاضبه",25,"ب",2,0],["تَرى قَلَم المُلكِ في كَفِّهِ","ضَحوكاً وَمِن قَبلِهِ باكِيا",26,"ي",2,0],["تَرى قَسَماتِ الأَريَحِيِّ اِبن قاسمٍ","تَهلَّلُ نوراً وَالوُجوهُ كَواسِفُ",27,"ف",1,0],["ترى قلبه عن نية السوء غافلاً","وليس عن المعروف والخير يغفل",28,"ل",1,0],["ترى قبل هذا الكون كنّا بآخرٍ","وكنتَ لنا رباً وكان بقاءُ",29,"ا",2,0],["تَرَى قياساتٍ بلا قِيَاسِ","تَصِحُّ بالحسابِ بَينَ النَّاسِ",30,"س",1,0],["تَرى قِصَدَ المُرّانِ تَهوي كَأَنَّها","تَذَرُّعُ خِرصانٍ بِأَيدي الشَواطِبِ",31,"ب",1,0],["ترى قَراهُ وَدَفَّيهِ فتَحسَبُها","كأحرفٍ سُطِّرت فيهنَ ألواحا",32,"ح",2,0],["تُريقُ دَمَ الأبطالِ أيْدي كُماتِها","فتثني الهَوادي والنّواصي نَواصِعُ",33,"ع",1,0],["تُرى قام ساقيها وَطافت كؤوسها","وَزينت الندمانُ تلك النَواديا",34,"ي",2,0],["ترى قاذفات الموت فيها تظنها","نسورا جثت من فوق عالية الهضب",35,"ب",1,0],["تريقين دمعا بكرة وعشية","كمن ذاق مر الحزن أو فقد الصبرا",36,"ر",2,0],["تَرى قُنْدُسَ الشَّرْبوشِ فَوْقَ جِبينِهِ","كأَهْدابِ أَحْداقٍ بَهَتْنَ إِلى الْبَدْرِ",37,"ر",1,0],["ترى قد تولاها السكون كأنها","لفرط جمودٍ أو جست خيفة الهلك",38,"ك",1,0],["تُريقُ الدِّما من قَبلِ سيفي مهابتي","ويسبق سيفي الموت نحو الغلاصم",39,"م",1,0],["ترى قصوراً كأَنها بِيَعٌ","ناطقة في خِلالها الصُّورُ",40,"ر",1,0],["ترى قصيدي ..\"كحربٍ قادَها بَشَرٌ\"","أمّا حشايْ .. \"حروبٌ بين آلهةِ\"",41,"ه",1,0],["تَرَيْ قَعْرَ سِجْني في دَياجيرِ نَينَوى","وَأَنْتِ عَلى غُصْنِ الْأَراكِ الْعَوالي",42,"ل",2,0],["ترى قسماتهنّ وهنّ تبر","ترصّع بالدموع وهنّ درّ",43,"ر",1,0],["ترى ! قصرتَ في حبٍّ","وعادَ الوصلُ منقطعا",44,"ع",2,0],["تُرِيقُونَ الدَّمَاءَ عَلى ثَراكُمْ","كأن السلم بينكم حرام",45,"م",1,0],["ترى قِطعاً من الأحناشِ فيهِ","جماجمهنَّ كالخشلِ النويعِ",46,"ع",1,0],["تُرِيقينَ كَالشَّهدِ شِعراً مُصَفَّىً","تَتُوقُ لَهُ الأنفُسُ الصَّادِيَة",47,"ي",2,0],["تُريقينَ دُرّاً على وجنتيكِ","وتُبدينَ حزناً على ما بَدَر",48,"ر",1,0]]}