aspx?id=178759",""],[5672,"من الطفيات","https://www.poetsgate.com/ViewPoem.aspx?id=215679",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5720,"رَثَتْكَ بيوتُ اللهِ (*)","https://www.poetsgate.com/ViewPoem.aspx?id=203033",""],[5843,"قلوب احباب","https://www.poetsgate.com/ViewPoem.aspx?id=51295",""],[5939,"وقد يُفصِحُ الزهرُ عمّا مَسَك","https://www.poetsgate.com/ViewPoem.aspx?id=178613",""],[5956,"سقطَ الجنينُ من بطنِ آنَ الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=207114",""],[6225,"صمود لبنان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80972&r=&rc=241",""]],"verses":[["رثاءا لمجد بعده قد تقطعت","بعيش الورى أسبابه ونسائبه",0,"ب",2,0],["رَثَيتُكَ كَي أَسلوكَ فَاِزدَدتُ لَوعَةً","لِأَنَّ المَراثي لا تَسُدُّ المَرازِيا",1,"ي",2,0],["رَثاكَ أَميرُ الشِعرِ في الشَرقِ وَاِنبَرى","لِمَدحِكَ مِن كُتّابِ مِصرَ كَبيرُ",2,"ر",1,1],["رَثى حَبيباً وَرَثى بَعدَهُ","لِذَلِكَ الموفي عَلى الرِمسِ",3,"س",1,0],["رَثَّت مَواثيقُ عَهدٍ كُنتُ أَعرِفُها","وَبَينَنا أَصبَحَ الشَيطانُ نَزّاعا",4,"ع",2,0],["رثيتُ منك صِبىً تكنَّفه","عفاف سرٍّ وحسن مجتهَرِ",5,"ر",1,0],["رَثَتِ الأمانةُ للخيانة إذ رأتْ","بالشمس موقفَ أحمد بنِ علِيِّ",6,"ل",2,1],["رَثَيتُ حَياةً بِالثَناءِ خَليقَةً","وَحَلَّيتُ عَهداً بِالمَفاخِرِ حالِيا",7,"ي",2,0],["رَثَيتُ بِهِ ذاتَ التُقى وَنَظَمتُهُ","لِعُنصُرِهِ الأَزكى وَجَوهَرِهِ الأَسمى",8,"م",2,0],["رَثَيتُ قَبلَكَ أَحباباً فُجِعتُ بِهِم","وَرُحتُ مِن فُرقَةِ الأَحبابِ يُرثى لي",9,"ل",2,0],["رَثَيتُكَ لا مالِكاً خاطِري","مِنَ الحُزنِ إِلّا يَسيراً خَطَر",10,"ر",1,0],["رَثى اِبنَ أَبينا غَيرُ ذي رَحِمٍ لَهُ","فَباعَدَنا مِنهُ وَنَحنُ الأَقارِبُ",11,"ب",1,0],["رَثَت فَلَمّا رَأَت رُسلَ النَوى فَغَدَت","تُطيلُ عَتبي وَعُمرُ اللَيلِ في قِصَرِ",12,"ر",1,0],["رَثَيتُكَ حُزناً بِالقَوافي الَّتي بها","مدَحتُكَ وُدّاً فاعتقدتَ ليَ الودّا",13,"د",2,0],["رَثُّ حَبلُ الوَصلِ وَاِنصَرَما","مِن حَبيبٍ هاجَ لي سَقَما",14,"م",2,1],["رَثَى الأُسْرُبُ الجاني لِفرطِ هَوانِها","على القومِ واسْتَحيا السِّلاحُ المُخَضَّبُ",15,"ب",1,0],["رَثَّ الجَديدانِ وَاِستَرخى لَهُم طِوَلٌ","مِنَ المَظالِمِ لا رَثٌّ وَلا خَلَقُ",16,"ق",1,0],["رَثَتِ المَذابِحُ لِلدِماءَ مُراقَةً","مِلءَ البِطاحِ وَما رَثى الذَبّاحُ",17,"ح",1,0],["رَثَينَ لِجَرحى كساها الحِفاظُ","سَوابِغَ مِن عَلَقٍ يُمتَرى",18,"ا",1,0],["رَثى لِعَينٍ يَقوى بِلَحظَتِها","كَيدٌ لِإِبليسَ كُلَّما ضَعُفتُ",19,"ت",1,0],["رَثيتُ الحَجيجِ فَقالَ العُداةُ","سَبَّ عَلِيّاً وَبَيتَ النَبي",20,"ب",2,1],["رَثِمتُ إِذا لَم تَرأَمِ البازِلُ إِبنَها","وَلَم يَكُ فيها لِلمُبِسِّينَ مَحلَبُ",21,"ب",1,0],["رَثَت لَها وَبَكَت مِن رِقَّةٍ فُوَلٌ","كَالبومِ يَبكي رُبوعاً عَزَّ باكيها",22,"ي",3,0],["رَثى وَبَكّى فَقالَ قَومٌ","أَمَدَّهُ لُؤلُؤُ البِحارِ",23,"ر",1,0],["رَثَّ جَديدُ الصِبا وَآضَت","كافورَةً مسكَةُ العذارِ",23,"ر",1,0],["رِثاءٌ يكادُ المَيْتُ يَحْيَا بلفظِهِ","ويَحْبِسُ شمسَ الأُفْقِ دونَ غُروب",24,"ب",1,0],["رَثَيْتُهُمُ فَأَدْمَى الْحُزْنُ قَلْبِي","فَهَلْ نَدْبٌ يَخِفُّ إِلَى رِثائي",25,"ا",2,0],["رثَيتُ نفوسَ الشاعرين طموحةً","أريدُ لها ان تستَذلَّ جواثيا",26,"ي",2,0],["رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","مِنْ حَبيبٍ هَاجَ لي سَقَما",27,"م",2,1],["رَثيْتُ حياة ً بالثناءِ خليقة ً","وخليتُ عهداً بالمفاخر حاليا",28,"ي",2,0],["رثا لحالي وخصمي","رام لاجلي خصامك",29,"ك",1,0],["رَثى لهُ مِمَّا به ما بِهِ","صبٌّ غدا صبّاً بأَوصابِهِ",30,"ب",2,1],["رثت لنحولي في هواها وذلتي","وكثرة أعدائي عليها وقلتي",31,"ي",1,1],["رث أنت نفسك قبل غي","رك بين صالحهم وفاجر",32,"ر",1,1],["رثّ الصديق رقيق الحال في بلد","أهلوه قوم لهم في اللؤم تحوي",33,"ي",1,0],["رثَّ فيهِ خُلق الرجال وَرَثَّت","نَزَواتُ العُلى وَرَثَّ الضَميرُ",34,"ر",1,0],["رَثى لي عَذولي يَومَ زَمَّت مَطِيَّتي","لِفُرقةِ أَحبابي عَشِيَّةَ وَدَّعوا",35,"ع",3,1],["رَثَيناكِ يا خَيرَ النِساءِ تَعَبُّداً","وَمِثلُكِ لا يُرثى بِنَظمٍ وَلا نَثرِ",36,"ر",1,0],["رَثَّت مَوَدّاتُ الرِجالِ وَأَنهَجَت","وَقَديمُ عَهدِكَ سالِمٌ لَم يُنهِجِ",37,"ج",1,0],["رثى لي العاذل في حبه","حتى إذا خط عذاره لام",38,"م",1,0],["رثيتِ للطيف من عيني وَمنْ خلدي","يبيتُ ما بينَ خفّاق وَسفّاح",39,"ح",1,0],["رثيت له لما أتاني بكسرةٍ","وعارضه قد خط منشورَ ذله",40,"ه",1,1],["رَثوا لي وَقالوا كُنت بِالأَمس عاقِلا","أَصابَتكَ عَينٌ قُلتُ عَينٌ وَحاجِبُ",41,"ا",3,0],["رَثَى لي وقد ساوَيْتُه في نُحولِه","خياليَ لمّا لم يكُنْ ليَ راحِم",42,"م",1,0],["رَثى مِن بَعد ما قَد كانَ يَجفو","لَما لاقَيت مِن كَمَدٍ وَغَم",43,"م",1,0],["رثى لي لطول الاغتراب ورق لي","وما كان لي قبل التباعد راثيا",44,"ي",2,0],["رِث كُلَّ من بَخِلَت كَفّاهُ من مَلِكٍ","فأكثر الناس خَزّانٍ لِغَيرِهِمِ",45,"م",1,0],["رثى الغرام له من فرط شقوته","ورق نجم الدجى مما يؤرقه",46,"ق",2,0],["رثاك نسيبٌ ودّه ولاؤه","مُحِقٌّ إذا زُنَّ القصيُّ بإبطالِ",47,"ل",1,0],["رَثيت بعلمي فيك حتى كأنها","تملِّي عليّ القولَ تلك الخلائقُ",48,"ق",1,0],["رثَمْنَ الحصى حتى كأن رضاضه","جني البُسْر شظَّتْه أكفُّ الأواكل",49,"ل",1,0],["رَثَّت حَواشي يوسُفٍ بَعدَما","قَد كانَ في جدَّتِهِ يوسُفا",50,"ف",2,1],["رثَّتْ حبالُ الوصلِ حتى اِنَّه","لم يبقَ غيرُ رميمِها المتقطَّعِ",51,"ع",1,0],["رثى لي أناسٌ لا رَثَوا لي مِنَ الجوى","غداةَ النوى مِن فيضِ دمعي وفِعْلِهِ",52,"ل",2,0],["رثيتُ لما أُلاقيهِ وحسبي","بأنْ ترثي لِما ألقاهُ حسبي",53,"ب",2,0],["رثَى لِحالي صَديقٌ","عِلْمَ الغَرامِ تعلَّمْ",54,"م",1,0],["رَثاء الَّذي لا يُسخِطُ اللَهَ قَولُهُ","وَيَحزَنُ مِنهُ القَلبُ وَالعَينُ تَذرِفُ",55,"ف",1,0],["رَثَيْتَ نَصْلٍ يَأْخُذُ المَوْتُ جَفْنَهُ","وَأُعْجِبْتَ مِنْ فَرْعٍ يَنُوحُ عَلَى أَصْلِ",56,"ل",1,0],["رثيناه جبراً للقلوب لما بها","وحل بها من موجعات التآسيا",57,"ي",2,0],["رثت له الورق في أدواحها سحراً","لما رأت دمعه كالطل في السحر",58,"ر",1,0],["رثى لكمُ الخصم الشديد عليكمُ","فأصبح يرجو الصلح بينكم الخصم",59,"م",1,0],["رثى له الأغيار في مشرق","وهمه الحسناء والراحُ",60,"ح",1,0],["رَثينْاك يا منْ طابَ فيه الرَّثا لنا","وقد طاب فيه مدحُنا ومقالُنا",61,"ن",2,0],["رَثَّ الرِدا بَينَ أَهدامٍ مُرَقَّعَةٍ","يَبيتُ فيها بِلَيلِ الجائِعِ الفَرِقِ",62,"ق",1,0],["رَثى إلى عَذُولي مِنْ نُحُولي بِهَجْرِهِ","وَقَدْ سَرَّ حُسَّادِي وَقَدْ خَانَني صَبْري",63,"ي",1,0],["رث الزمان وألوى","وظِلت غضاً مجسي",64,"س",2,0],["رثى لحالي ورق حتى","تسأل وصلاً فلا يجيب",65,"ب",1,0],["رثى لهم مما لقوا عاشق أبت","تجف له بعد الفراق مآقي",66,"ق",2,0],["رثى لهمو من خاف يلقى الذي لقوا","فألف في ما قد لقوه كتابا",67,"ا",1,0],["رثا لوداع على غفلة","وألفين في سورة المهلكات",68,"ت",1,0],["رثت لدموعي وألوت عليَّ","تكفكفُ قبلاتها عبرتي",69,"ي",1,0],["رَثَت لِحالي وَقَد لالا مَحياها","منت وَحيت رُضا أَحيت لِمَضناها",70,"ا",1,0],["رثتك القوافى ببيت القصيد","لتزجيك صنواً سواءً سواء",71,"ا",2,0],["رثّ بردُ الحمدِ لولا ملِكٌ","كلّ آن يلبسُ الفخرَ قشيبا",72,"ب",2,0],["رَثَتهُ فَقُلنا إِنَّها لَتُماضِر","وَإِنَّ اِبنَ خَلدونٍ لَمَفقودُها صَخرُ",73,"ر",1,0],["رثا لي عدوي من ذنوبي وقبحها","فكفرتها بالمدح في شافع الحشر",74,"ر",1,0],["رِثاكَ جميلَ الخُلْقِ فرضٌ محتّمٌ","ومثلُكَ مَنْ أرثيه يا عاليَ القدر",75,"ر",1,0],["رثاها كتاب الله والوحي مثلما","بكاها الهدى والحزم والعزم والرشد",76,"د",1,0],["رث يا دهر ثوبنا فعرينا","ولبسنا القميص صبراً جميلا",77,"ل",2,1],["رثى لي القاضي وافتى باح","ضارِ غريمي كي يلاقي جزاه",78,"ا",2,0],["رَثيتُ حبّي وَلِي لَم يَرثُ حينَ قَضَى","وصدَّ عَنّي وعهدَ الردِّ قد نكثا",79,"ث",2,1],["رثيتك لكن لو رأيت لواعجيٍ","لكنت لحالي بعد فقدك راثيا",80,"ي",2,0],["رَثى الغُروب لَها حَتّى بَكى بِدَمٍ","ما بَين مُدَّخَرٍ مِنهُ وَمُنطَلِق",81,"ق",1,0],["رثيتَ لي مما يُجنُّ الحَشَا","من شدة الهجَران والكَربِ",82,"ب",1,0],["رثت ديانتنا فمن لمحمد","ولآله كاف ومنك الكاف",83,"ف",1,0],["رثيت ولم أقض من واجب","عليَّ ولا البعض من واجب",84,"ب",1,0],["رثيت ولولا الرثا للفقيد","قلبت الرثاء عليك امتداحا",85,"ح",2,0],["رثيتُكَ ذاكِراً فضلاً غزِيراً","بِلاَ منٍّ وإِحساناً جَزِيلا",86,"ل",2,0],["رثاك هذا جديد شعري","فاسمعه واسمع به البكاء",87,"ا",2,0],["رثى لي صحابي اذ رثيت لنملة","وليس لها ذنب سوى أنها صغرى",88,"ا",1,0],["رث غناها ورث كعثنها","والخلق المسترث مهجور",89,"ر",1,0],["رثيتك عن قلب قريح وانما","يجيد الرثا قلب الحزين المقرح",90,"ح",1,0],["رثت عواطفهم وبات ضميرهم","خلقاً وحبل العلم صار رماما",91,"م",2,0],["رثيتكُ يا ارض الفراعنة الاُلى","قضوا في بلوغ المجد ما الحق واجبه",92,"ب",2,0],["رثيتُ حياتي بعد فقد محمد","وساءلت هل بعد المعين معين",93,"ن",1,0],["رثى الشعراء ال