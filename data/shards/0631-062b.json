{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[86,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[71,"لا تحسبوا أن قلبي عن محبتكم","https://www.aldiwan.net/poem3916.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"رثت الأمانة للخيانة إذ رأت","https://www.aldiwan.net/poem66725.html","الكامل"],[85,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[85,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[43,"لأي صروف الدهر فيه نعاتب","https://www.aldiwan.net/poem9464.html","الطويل"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[31,"رث حبل الوصل وانصرما","https://www.aldiwan.net/poem41318.html","المديد"],[105,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"نفرن أصيلا كسرب المها","https://www.aldiwan.net/poem43157.html","المتقارب"],[52,"يا مقلة أدنفت كما دنفت","https://www.aldiwan.net/poem27208.html","المنسرح"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43841","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[31,"رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19085&r=&rc=347",""],[85,"سقى اللهُ بالكفر الأباظيِّ مضجعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9636&r=&rc=126",""]],"verses":[["رَثَيتُكَ كَي أَسلوكَ فَاِزدَدتُ لَوعَةً","لِأَنَّ المَراثي لا تَسُدُّ المَرازِيا",0,"ي",2,0],["رَثاكَ أَميرُ الشِعرِ في الشَرقِ وَاِنبَرى","لِمَدحِكَ مِن كُتّابِ مِصرَ كَبيرُ",1,"ر",1,1],["رَثى حَبيباً وَرَثى بَعدَهُ","لِذَلِكَ الموفي عَلى الرِمسِ",2,"س",1,0],["رَثَّت مَواثيقُ عَهدٍ كُنتُ أَعرِفُها","وَبَينَنا أَصبَحَ الشَيطانُ نَزّاعا",3,"ع",2,0],["رثيتُ منك صِبىً تكنَّفه","عفاف سرٍّ وحسن مجتهَرِ",4,"ر",1,0],["رَثَتِ الأمانةُ للخيانة إذ رأتْ","بالشمس موقفَ أحمد بنِ علِيِّ",5,"ل",2,1],["رَثَيتُ حَياةً بِالثَناءِ خَليقَةً","وَحَلَّيتُ عَهداً بِالمَفاخِرِ حالِيا",6,"ي",2,0],["رَثَيتُ بِهِ ذاتَ التُقى وَنَظَمتُهُ","لِعُنصُرِهِ الأَزكى وَجَوهَرِهِ الأَسمى",7,"م",2,0],["رَثَيتُ قَبلَكَ أَحباباً فُجِعتُ بِهِم","وَرُحتُ مِن فُرقَةِ الأَحبابِ يُرثى لي",8,"ي",1,0],["رَثَيتُكَ لا مالِكاً خاطِري","مِنَ الحُزنِ إِلّا يَسيراً خَطَر",9,"ر",1,0],["رَثى اِبنَ أَبينا غَيرُ ذي رَحِمٍ لَهُ","فَباعَدَنا مِنهُ وَنَحنُ الأَقارِبُ",10,"ب",1,0],["رَثَت فَلَمّا رَأَت رُسلَ النَوى فَغَدَت","تُطيلُ عَتبي وَعُمرُ اللَيلِ في قِصَرِ",11,"ر",1,0],["رَثَيتُكَ حُزناً بِالقَوافي الَّتي بها","مدَحتُكَ وُدّاً فاعتقدتَ ليَ الودّا",12,"د",2,0],["رَثُّ حَبلُ الوَصلِ وَاِنصَرَما","مِن حَبيبٍ هاجَ لي سَقَما",13,"م",2,1],["رَثَى الأُسْرُبُ الجاني لِفرطِ هَوانِها","على القومِ واسْتَحيا السِّلاحُ المُخَضَّبُ",14,"ب",1,0],["رَثَّ الجَديدانِ وَاِستَرخى لَهُم طِوَلٌ","مِنَ المَظالِمِ لا رَثٌّ وَلا خَلَقُ",15,"ق",1,0],["رَثَتِ المَذابِحُ لِلدِماءَ مُراقَةً","مِلءَ البِطاحِ وَما رَثى الذَبّاحُ",16,"ح",1,0],["رَثَينَ لِجَرحى كساها الحِفاظُ","سَوابِغَ مِن عَلَقٍ يُمتَرى",17,"ا",1,0],["رَثى لِعَينٍ يَقوى بِلَحظَتِها","كَيدٌ لِإِبليسَ كُلَّما ضَعُفتُ",18,"ت",1,0],["رَثيتُ الحَجيجِ فَقالَ العُداةُ","سَبَّ عَلِيّاً وَبَيتَ النَبي",19,"ب",2,1],["رَثِمتُ إِذا لَم تَرأَمِ البازِلُ إِبنَها","وَلَم يَكُ فيها لِلمُبِسِّينَ مَحلَبُ",20,"ب",1,0],["رَثَت لَها وَبَكَت مِن رِقَّةٍ فُوَلٌ","كَالبومِ يَبكي رُبوعاً عَزَّ باكيها",21,"ي",3,0],["رَثى وَبَكّى فَقالَ قَومٌ","أَمَدَّهُ لُؤلُؤُ البِحارِ",22,"ر",1,0],["رَثَّ جَديدُ الصِبا وَآضَت","كافورَةً مسكَةُ العذارِ",22,"ر",1,0],["رِثاءٌ يكادُ المَيْتُ يَحْيَا بلفظِهِ","ويَحْبِسُ شمسَ الأُفْقِ دونَ غُروب",23,"ب",1,0],["رَثَيْتُهُمُ فَأَدْمَى الْحُزْنُ قَلْبِي","فَهَلْ نَدْبٌ يَخِفُّ إِلَى رِثائي",24,"ا",2,0],["رثَيتُ نفوسَ الشاعرين طموحةً","أريدُ لها ان تستَذلَّ جواثيا",25,"ي",2,0],["رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","مِنْ حَبيبٍ هَاجَ لي سَقَما",26,"م",2,1],["رَثيْتُ حياة ً بالثناءِ خليقة ً","وخليتُ عهداً بالمفاخر حاليا",27,"ي",2,0]]}