{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[86,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[71,"لا تحسبوا أن قلبي عن محبتكم","https://www.aldiwan.net/poem3916.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"رثت الأمانة للخيانة إذ رأت","https://www.aldiwan.net/poem66725.html","الكامل"],[85,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[85,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[43,"لأي صروف الدهر فيه نعاتب","https://www.aldiwan.net/poem9464.html","الطويل"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[31,"رث حبل الوصل وانصرما","https://www.aldiwan.net/poem41318.html","المديد"],[105,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"نفرن أصيلا كسرب المها","https://www.aldiwan.net/poem43157.html","المتقارب"],[52,"يا مقلة أدنفت كما دنفت","https://www.aldiwan.net/poem27208.html","المنسرح"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43841","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[31,"رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19085&r=&rc=347",""],[85,"سقى اللهُ بالكفر الأباظيِّ مضجعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9636&r=&rc=126",""],[113,"يا راشق القلب مني","https://www.aldiwan.net/poem40497.html","عموديه"],[153,"رثى له مما به ما به","https://www.aldiwan.net/poem55781.html","السريع"],[158,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[184,"رث أنت نفسك قبل غي","https://www.aldiwan.net/poem43734.html","مجزوء الكامل"],[184,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[221,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[230,"رثى لي عذولي يوم زمت مطيتي","https://www.aldiwan.net/poem14812.html","الطويل"],[233,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[233,"يا ابن الدوامي الذي هو عصمة","https://www.aldiwan.net/poem32122.html","الكامل"],[259,"سقى الله أرضا أنت فيها بوابل","https://www.aldiwan.net/poem38173.html","الطويل"],[296,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[301,"رثيت له لما أتاني بكسرة","https://www.aldiwan.net/poem57927.html","الطويل"],[351,"بليت بمعسول المراشف واللمى","https://www.aldiwan.net/poem40562.html","الطويل"],[362,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[377,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[400,"سرى طيفها ليلا وما كان ساريا","https://www.aldiwan.net/poem33349.html","الطويل"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[447,"ماذا يطوقه ؟","https://www.aldiwan.net/poem1011.html",""],[456,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[456,"صديق يداري الحزن عنك مماذق","https://www.aldiwan.net/poem56103.html","الطويل"],[459,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[466,"رثت حواشي يوسف بعدما","https://www.aldiwan.net/poem59861.html","السريع"],[475,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[475,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[475,"أظنك لو علمت بفرط حبي","https://www.aldiwan.net/poem15297.html","الوافر"],[498,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[561,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[565,"أبعد مصاب الأم آلف مضجعا","https://www.aldiwan.net/poem69542.html","الطويل"],[585,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["رَثَيتُكَ كَي أَسلوكَ فَاِزدَدتُ لَوعَةً","لِأَنَّ المَراثي لا تَسُدُّ المَرازِيا",0,"ي",2,0],["رَثاكَ أَميرُ الشِعرِ في الشَرقِ وَاِنبَرى","لِمَدحِكَ مِن كُتّابِ مِصرَ كَبيرُ",1,"ر",1,1],["رَثى حَبيباً وَرَثى بَعدَهُ","لِذَلِكَ الموفي عَلى الرِمسِ",2,"س",1,0],["رَثَّت مَواثيقُ عَهدٍ كُنتُ أَعرِفُها","وَبَينَنا أَصبَحَ الشَيطانُ نَزّاعا",3,"ع",2,0],["رثيتُ منك صِبىً تكنَّفه","عفاف سرٍّ وحسن مجتهَرِ",4,"ر",1,0],["رَثَتِ الأمانةُ للخيانة إذ رأتْ","بالشمس موقفَ أحمد بنِ علِيِّ",5,"ل",2,1],["رَثَيتُ حَياةً بِالثَناءِ خَليقَةً","وَحَلَّيتُ عَهداً بِالمَفاخِرِ حالِيا",6,"ي",2,0],["رَثَيتُ بِهِ ذاتَ التُقى وَنَظَمتُهُ","لِعُنصُرِهِ الأَزكى وَجَوهَرِهِ الأَسمى",7,"م",2,0],["رَثَيتُ قَبلَكَ أَحباباً فُجِعتُ بِهِم","وَرُحتُ مِن فُرقَةِ الأَحبابِ يُرثى لي",8,"ي",1,0],["رَثَيتُكَ لا مالِكاً خاطِري","مِنَ الحُزنِ إِلّا يَسيراً خَطَر",9,"ر",1,0],["رَثى اِبنَ أَبينا غَيرُ ذي رَحِمٍ لَهُ","فَباعَدَنا مِنهُ وَنَحنُ الأَقارِبُ",10,"ب",1,0],["رَثَت فَلَمّا رَأَت رُسلَ النَوى فَغَدَت","تُطيلُ عَتبي وَعُمرُ اللَيلِ في قِصَرِ",11,"ر",1,0],["رَثَيتُكَ حُزناً بِالقَوافي الَّتي بها","مدَحتُكَ وُدّاً فاعتقدتَ ليَ الودّا",12,"د",2,0],["رَثُّ حَبلُ الوَصلِ وَاِنصَرَما","مِن حَبيبٍ هاجَ لي سَقَما",13,"م",2,1],["رَثَى الأُسْرُبُ الجاني لِفرطِ هَوانِها","على القومِ واسْتَحيا السِّلاحُ المُخَضَّبُ",14,"ب",1,0],["رَثَّ الجَديدانِ وَاِستَرخى لَهُم طِوَلٌ","مِنَ المَظالِمِ لا رَثٌّ وَلا خَلَقُ",15,"ق",1,0],["رَثَتِ المَذابِحُ لِلدِماءَ مُراقَةً","مِلءَ البِطاحِ وَما رَثى الذَبّاحُ",16,"ح",1,0],["رَثَينَ لِجَرحى كساها الحِفاظُ","سَوابِغَ مِن عَلَقٍ يُمتَرى",17,"ا",1,0],["رَثى لِعَينٍ يَقوى بِلَحظَتِها","كَيدٌ لِإِبليسَ كُلَّما ضَعُفتُ",18,"ت",1,0],["رَثيتُ الحَجيجِ فَقالَ العُداةُ","سَبَّ عَلِيّاً وَبَيتَ النَبي",19,"ب",2,1],["رَثِمتُ إِذا لَم تَرأَمِ البازِلُ إِبنَها","وَلَم يَكُ فيها لِلمُبِسِّينَ مَحلَبُ",20,"ب",1,0],["رَثَت لَها وَبَكَت مِن رِقَّةٍ فُوَلٌ","كَالبومِ يَبكي رُبوعاً عَزَّ باكيها",21,"ي",3,0],["رَثى وَبَكّى فَقالَ قَومٌ","أَمَدَّهُ لُؤلُؤُ البِحارِ",22,"ر",1,0],["رَثَّ جَديدُ الصِبا وَآضَت","كافورَةً مسكَةُ العذارِ",22,"ر",1,0],["رِثاءٌ يكادُ المَيْتُ يَحْيَا بلفظِهِ","ويَحْبِسُ شمسَ الأُفْقِ دونَ غُروب",23,"ب",1,0],["رَثَيْتُهُمُ فَأَدْمَى الْحُزْنُ قَلْبِي","فَهَلْ نَدْبٌ يَخِفُّ إِلَى رِثائي",24,"ا",2,0],["رثَيتُ نفوسَ الشاعرين طموحةً","أريدُ لها ان تستَذلَّ جواثيا",25,"ي",2,0],["رَثَّ حَبْلُ الوَصْلِ، وَکنْصَرَما،","مِنْ حَبيبٍ هَاجَ لي سَقَما",26,"م",2,1],["رَثيْتُ حياة ً بالثناءِ خليقة ً","وخليتُ عهداً بالمفاخر حاليا",27,"ي",2,0],["رثا لحالي وخصمي","رام لاجلي خصامك",28,"ك",1,0],["رَثى لهُ مِمَّا به ما بِهِ","صبٌّ غدا صبّاً بأَوصابِهِ",29,"ب",2,1],["رثت لنحولي في هواها وذلتي","وكثرة أعدائي عليها وقلتي",30,"ي",1,1],["رث أنت نفسك قبل غي","رك بين صالحهم وفاجر",31,"ر",1,1],["رثّ الصديق رقيق الحال في بلد","أهلوه قوم لهم في اللؤم تحوي",32,"ي",1,0],["رثَّ فيهِ خُلق الرجال وَرَثَّت","نَزَواتُ العُلى وَرَثَّ الضَميرُ",33,"ر",1,0],["رَثى لي عَذولي يَومَ زَمَّت مَطِيَّتي","لِفُرقةِ أَحبابي عَشِيَّةَ وَدَّعوا",34,"ع",3,1],["رَثَيناكِ يا خَيرَ النِساءِ تَعَبُّداً","وَمِثلُكِ لا يُرثى بِنَظمٍ وَلا نَثرِ",35,"ر",1,0],["رَثَّت مَوَدّاتُ الرِجالِ وَأَنهَجَت","وَقَديمُ عَهدِكَ سالِمٌ لَم يُنهِجِ",36,"ج",1,0],["رثى لي العاذل في حبه","حتى إذا خط عذاره لام",37,"م",1,0],["رثيتِ للطيف من عيني وَمنْ خلدي","يبيتُ ما بينَ خفّاق وَسفّاح",38,"ح",1,0],["رثيت له لما أتاني بكسرةٍ","وعارضه قد خط منشورَ ذله",39,"ه",1,1],["رَثوا لي وَقالوا كُنت بِالأَمس عاقِلا","أَصابَتكَ عَينٌ قُلتُ عَينٌ وَحاجِبُ",40,"ا",3,0],["رَثَى لي وقد ساوَيْتُه في نُحولِه","خياليَ لمّا لم يكُنْ ليَ راحِم",41,"م",1,0],["رَثى مِن بَعد ما قَد كانَ يَجفو","لَما لاقَيت مِن كَمَدٍ وَغَم",42,"م",1,0],["رثى لي لطول الاغتراب ورق لي","وما كان لي قبل التباعد راثيا",43,"ي",2,0],["رِث كُلَّ من بَخِلَت كَفّاهُ من مَلِكٍ","فأكثر الناس خَزّانٍ لِغَيرِهِمِ",44,"م",1,0],["رثى الغرام له من فرط شقوته","ورق نجم الدجى مما يؤرقه",45,"ق",2,0],["رثاك نسيبٌ ودّه ولاؤه","مُحِقٌّ إذا زُنَّ القصيُّ بإبطالِ",46,"ل",1,0],["رَثيت بعلمي فيك حتى كأنها","تملِّي عليّ القولَ تلك الخلائقُ",47,"ق",1,0],["رثَمْنَ الحصى حتى كأن رضاضه","جني البُسْر شظَّتْه أكفُّ الأواكل",48,"ل",1,0],["رَثَّت حَواشي يوسُفٍ بَعدَما","قَد كانَ في جدَّتِهِ يوسُفا",49,"ف",2,1],["رثَّتْ حبالُ الوصلِ حتى اِنَّه","لم يبقَ غيرُ رميمِها المتقطَّعِ",50,"ع",1,0],["رثى لي أناسٌ لا رَثَوا لي مِنَ الجوى","غداةَ النوى مِن فيضِ دمعي وفِعْلِهِ",51,"ل",2,0],["رثيتُ لما أُلاقيهِ وحسبي","بأنْ ترثي لِما ألقاهُ حسبي",52,"ب",2,0],["رثَى لِحالي صَديقٌ","عِلْمَ الغَرامِ تعلَّمْ",53,"م",1,0],["رَثاء الَّذي لا يُسخِطُ اللَهَ قَولُهُ","وَيَحزَنُ مِنهُ القَلبُ وَالعَينُ تَذرِفُ",54,"ف",1,0],["رَثَيْتَ نَصْلٍ يَأْخُذُ المَوْتُ جَفْنَهُ","وَأُعْجِبْتَ مِنْ فَرْعٍ يَنُوحُ عَلَى أَصْلِ",55,"ل",1,0],["رثيناه جبراً للقلوب لما بها","وحل بها من موجعات التآسيا",56,"ي",2,0]]}