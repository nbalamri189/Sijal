{"poems":[[60,"ومحترس من نفسه خوف ذلة","https://www.aldiwan.net/poem30789.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[360,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[435,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[811,"","https://poetry.dctabudhabi.ae/diwan/poem/31481","الطويل"]],"verses":[["فَقَلَّصَ بَردَيهِ وَأَفضى بِقلبِهِ","إِلى البِرِّ وَالتَقوى فَنالَ الأَمانيا",0,"ي",2,0],["فَقُلْ صَامِتاً وَأَشِرْ مَائِتاً","لِمَنْ تَاهَ فِي الأَرْضِ وَاسْتَكْبَرَا",1,"ر",2,0],["فقلّص آل الشِّركِ ذيلَ غُرورِهِ","وَسَيلُ الجِيَادِ المُحضَرات بِهِ يَدحُو",2,"ح",2,0],["فَقَلَّصَتِ الرَّعارِعُ جانبَيْها","مُنّزَّهَةَ المَقَامِ عَنِ الرِّعاعِ",3,"ع",1,0],["فَقَلصي وَنَزلي ما وَجَدتُّم حَفيلَهُ","وَشَرّي لَكُم ما عِشتُمُ ذو دَغاوِلِ",4,"ل",1,0]]}