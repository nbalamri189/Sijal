{"poems":[[95,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[159,"أنا أفدي مكتومة لا تسمى","https://www.aldiwan.net/poem55550.html","الخفيف"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[505,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53953","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38337","الرمل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126622","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93952","الخفيف"],[2844,"","https://poetry.dctabudhabi.ae/diwan/poem/144463","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[5463,"اتركوني في هواها","https://www.poetsgate.com/ViewPoem.aspx?id=25226",""],[5877,"يا وجودي ..","https://www.poetsgate.com/ViewPoem.aspx?id=37475",""],[5915,"فاجأتها كالظبي فِي سربه","https://www.poetsgate.com/ViewPoem.aspx?id=189108",""],[6056,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""]],"verses":[["قَلَّتْ جَزَاءً دُمُوعٌ جِدُّ فَانِيَةٍ","وَأَنْتَ مُخْلِدُ مَجْدٍ لَيْسَ بِالفَانِي",0,"ن",2,0],["قُلْتُ جُودي بِحَلِّها لِي وَإِلا","قَطْعُها هَيِّنٌ كَما أَشْرَبُ الْمَا",1,"م",2,0],["قُلْتُ جُزيتَ الخيرَ لي من ناصحٍ","أصبحَ عن سَرائري مُستَكْشِفي",2,"ف",2,0],["قلتُ جَدِّي جِدِّي وزَفرَةُ وَجْدي","قالَ قد أَوصلَتْكَ نفحَةُ جَدِّي",3,"د",2,0],["قلتُ جُدْ لِي بالرِّضى يا مالكي","قال لي ما للرّضَى عندي ثَمَنْ",4,"ن",1,0],["قُلتُ جودي بِاللّقا","فَهوَ قَصدي وَالسّلام",5,"م",1,0],["قلت جار الهوى علينا فلو أن","ا غداة الفراق متنا استرحنا",6,"ن",2,0],["قلتُ جعلُ اللهِ خلقٌ كله","ومن الناس مقالٌ مشتهر",7,"ر",1,0],["قلت جاء القول فيه مجملاً","وهو مختصٌّ لشيءٍ مستقر",7,"ر",1,0],["قُلتُ جُوبُوا الفَلا إِلى أَكرَمِ النا","سِ جَميعاً عِرقاً وَفَرعاً وَنَجرا",8,"ر",2,0],["قلت جد المحب وارحمه ترحم","فجزاء الذي يهني التهني",9,"ن",2,0],["قلت: جودى لكئيبٍ","مستهامٍ بك محزون",10,"ن",1,0],["قلّتْ جيوشي وَوَهى منصبي","وَعُدْتُ لا أَمرَ ولا إمره",11,"ر",2,0],["قلتَ جبال الدنيا تقلّع","وَالعيالم السبع عجّ مزبدها",12,"د",3,0],["قلت جالك يالأميره كل ما كنتي تبينه","وإن تبين المستحيله .. سقت هالقمره وضواها .. !",13,"ا",3,0],["قلت جعلك في فراقٍ ولا عقبه جدال","لا اشتهى قلبي وصالك .. ولا عدت احتريه",14,"ي",2,0],["قلت جرت من مقلتي دمعة","فاختضبت أنملها بِالدَّمِ",15,"م",1,0],["قلت جفن ٍغطاء والجفن الأخر حصير","والمشاعر بجوفي ضاربات ٍ حصار",16,"ر",1,0]]}