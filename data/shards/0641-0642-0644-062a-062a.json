,""],[6355,"البسمات الصفر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66647&r=&rc=107",""]],"verses":[["فَقُلتُ تَبَيَّنوا ظُعُناً أَراه","تَحُلُّ شُواحِطاً جُنحَ الظَلامِ",0,"م",1,0],["فَقُلتُ تَعِستَ وَيحُكَ مِن غُرابٍ","وَكانَ الدَهرَ سَعيُكَ في تَبابِ",1,"ب",1,0],["فَقُلتُ تَعَلَّم يا وِثاقُ بِأَنَّها","عَلَيكَ حِمىً أُخرى اللَيالي الغَوابِرِ",2,"ر",1,0],["فقلت تبتّ يدُ خذلاننا","وجاءَ نصرُ اللهِ والفتح",3,"ح",1,0],["فَقُلتُ تَجَنَّبَن سُخطَ اِبنِ عَمٍّ","وَمَطلَبَ شُلَّةٍ وَنَوىً طَروحُ",4,"ح",1,0],["فَقُلتُ تَجَنّى عَلَينا الشِتاء","وَقَد نَفِدَ الفَحمُ مَعَ كَثرَتِه",5,"ه",1,0],["فَقُلتُ تَعَلَّم يا ذُؤالَ وَلا تَخُن","وَلا تَنخَنِع لِلَيلِ وَهوَ خَنوعُ",6,"ع",1,0],["فَقُلتُ تَجَلُّداً وَحَلَفتُ صَبراً","أُبالي اليَومَ لَو دَمَعَت مَآقي",7,"ق",2,0],["فقلت تلك لعمري","سعادة ليس تقلى",8,"ل",2,0],["فقلتُ تحيّةُ الزمن المعادِي","لمقتتلٍ أطال بهِ صدامهْ",9,"م",2,0],["فقُلت تَغَنّي كيفَ شِئْتِ فإنما","غِناؤكِ عِندي يا حَمامَةُ إعْوال",10,"ل",1,0],["فَقُلتُ تَبَيَّنوا ظُعُناً أَراها","تَحُلُّ شُواحِطاً جُنحَ الظَلامِ",11,"م",1,0],["فَقُلْتُ تَعَلَّمْ إِنَّما هِيَ خُطَّةٌ","يَطُولُ بِها مَجْدٌ وتُخْشَى فَضَائِحُ",12,"ح",1,0],["فقُلتَ تمِّي لخَادمي فأطاعَتْ","ك بحقٍّ ومن أطاعَ أُطيعا",13,"ع",2,0],["فقلتُ تبيَّنوا ظغناً أراها","تحلُّ شُواحِطاً جُنْحَ الظَّلامِ",14,"م",1,0],["فقلت تحيّة الزّمن المعادي","لمقتل أطال به صدامه",15,"م",2,0],["فَقُلتُ تَرَحَّل راشِداً في عُمومَةٍ","مُواسينَ في البَأساءِ غَيرِ لِئامِ",16,"م",1,0],["فقلتُ تقولُ بهِم أم بهنَّ","فقالَ بهِمِنَّ يا سَيِّدي",17,"ي",1,0],["فقلتُ تمثُّلاً لك ليت شعري","متى يأتي غياثُك مَن تغيثُ",18,"ث",1,0],["فقلتُ تعرَّضني دونها","رجاءٌ يبشِّرُني عن بشارَه",19,"ر",2,0],["فقلت تاللَه إن الأمر مختلفٌ","والقوم في زمجٍ بالنقض قد مزجا",20,"ج",2,0],["فَقُلتُ تَفَضَّل بِتَعجيلِ ذا","فَهَذا هُوَ الزُبدُ بِالنَرسِيانِ",21,"ن",1,0],["فَقُلتُ تَأَمَّل تَجِد حِجرَها","عَلَيهِ مَلاهي قِيانِ اللَيالي",22,"ل",2,0],["فقلت تذكرت عهدا مضى","ففاضت دموع خيالي تجيبُ",23,"ب",1,0],["فقلت تعالى الله ربي عن الذي","أضل به كل النصارى مدى الدهر",24,"ر",1,0],["فقلتُ تأملْ ما تقولُ فإنه","فَعالُكَ يا مَنْ تقتلُ الناسَ عيناه",25,"ه",1,0],["فَقُلتُ تَلَقَّاكَ الإِلَهُ بِرَحمَةٍ","وَصَلَّى عَلَيكَ اللهُ رَبُّ المَشَارِقِ",26,"ق",1,1],["فَقُلْتُ تَبَّا لِحُبِّ دُنْيا","نَعيمُها بالشَّقاءِ أَشْبَهْ",27,"ه",1,0],["فَقُلت تَعَجَبوا مِن صُنع رَبي","رَأَيت الحور في وَسَطِ الجَحيمِ",28,"م",1,0],["فَقُلتُ تَزَرَّدها يَزيدُ فَإِنَّني","لِدُردِ المَوالي في السِنينَ مُزَرِّدُ",29,"د",1,1],["فقلت ترك الفضول يا ناقص ال","همة عين الإدبار والكسل",30,"ل",1,0],["فقلت تِهْ تِهْ تِهْ وتِهْ","فقال لي مُرَّ يا لكع",31,"ع",1,0],["فقلت تفاحةٌ من روض وجنتها","أشهى وأشرف من الفين رمّانَهْ",32,"ن",2,0],["فقلت تعالى نسترق خُلوَةَ الهوى","على غفلةٍ من عاذلٍ يتَشَكَّكُ",33,"ك",1,0],["فقلت تُرى بأيّكما تلافي","فأومأت احتشاماً للهلال",34,"ل",1,0],["فقلت تعنينَ يا لَمْيا المراشفِ لي","أبا محمدَ ذَا الآلاءِ والنعمِ",35,"م",1,0],["فقلت تجلى في غمامٍ علمته","أتاني به الرحمن في محكم الذكر",36,"ر",1,0],["فَقُلتُ تَعَلَّم أَنَّ وَصلَكَ جاهِدَاً","وَهَجرَكَ عِندي شِقَّةٌ مُتقارِبُ",37,"ب",1,0],["فقلت تاللَه إن شعري","حوى بها بهجة وزينة",38,"ن",2,0],["فقلت : ترفعاً دعهم يعيشوا","فليس يضر عيشُهُم خلودي",39,"د",2,0],["فقلت تقبيلك لا ينتهي","إذ تلدُ القبلةُ لي قُبله",40,"ه",1,0],["فَقُلتُ تَنَكَّبنَ الطَريقَ لِمُختَطٍ","أَخي شُقَّة غولٍ عَلى مَن يُنازِلُه",41,"ل",2,0],["فَقُلت تَرون البَدرَ أَو ذاكَ يَومه","تَجلى وَهذي الأَرض أَم ذي السما تهدي",42,"د",2,0],["فَقُلت تَبارك الرَحمَنُ هَذي","جِنانٌ قال فيها عَينُ عِين",43,"ن",1,0],["فقلت تاللَه إني مغرمٌ دنفٌ","وفي الإشارات ما يغني عن الكلمِ",44,"م",1,0],["فقلت تركاً لذا مالي فقالاه","مما أقول فلا عيني قالاه",45,"ل",3,0],["فَقُلتُ تَذوقُهُ فَلَعَلَّ ذا","كَ الخَدَّ قَد لُثِما",46,"م",2,0],["فقلت ُ تعالي أنت يا غاية المنى","فظنّك بي وهمٌ وقد جاوزَ الوهما",47,"م",2,0],["فَقُلْتُ تَأَمَّلْ بِعَهْدٍ مَضَى","تَجِدْ فِي سُؤَالِكَ مَا فِيهِ حَيْف",48,"ف",1,0],["فقلتُ تعجَّبا: ما الطيفُ هذا","ولكنْ برقَ أعْيُنِهم تَدَنَّى",49,"ن",2,0],["فَقُلْتُ تُرَانِي بِحُلْمٍ مُخِيفٍ","فَجَاء جَوابِي يُحَاكِي البَشَرْ",50,"ر",1,0],["فَقُلتُ ترفّقي إن بُحْتِ قولًا","وألهبَ خدّها قولي احمرارًا",51,"ر",2,0],["فقلت : تلك مسافات مسافرة","في اللانهايات تسقي بعدها مطلا",52,"ل",2,0],["فقلتُ تِلْكَ دعاياتٌ مُلَفَّقةٌ","أنتِ التي شوَّهَتْ من سيرتي مُثُلى",53,"ل",2,0]]}