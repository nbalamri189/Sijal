{"poems":[[57,"أزار أبا الفضل الخيال المؤرق","https://www.aldiwan.net/poem26219.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[26,"تؤمل أن تلاقي أم وهب","https://www.aldiwan.net/poem24089.html","الوافر"],[30,"تذكر هذا القلب من شوقه ذكرا","https://www.aldiwan.net/poem5056.html","الطويل"],[22,"عفا مسحلان من سليمى فحامره","https://www.aldiwan.net/poem21639.html","الطويل"],[50,"أما وصدود مخمور","https://www.aldiwan.net/poem64332.html","البسيط"],[50,"بنفسي من يعذبني هواه","https://www.aldiwan.net/poem66192.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42686","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55075","البسيط"],[234,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[310,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[350,"وواجهه جذلان حتى أمره","https://www.aldiwan.net/poem4473.html","الكامل"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[376,"فلما خبراني أي","https://www.aldiwan.net/poem57191.html","الهزج"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48796","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28380","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117680","الوافر"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101829","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125447","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71079","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2253,"","https://poetry.dctabudhabi.ae/diwan/poem/115137","المتقارب"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87797","الوافر"],[3002,"","https://poetry.dctabudhabi.ae/diwan/poem/73576","الطويل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102359","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65176","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62972","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91097","الطويل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130442","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135432","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4088,"","https://poetry.dctabudhabi.ae/diwan/poem/146164","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[5493,"أرى أعمارنا","https://www.poetsgate.com/ViewPoem.aspx?id=197636",""]],"verses":[["فَلَمّا خَرَجنا اِستَعبَرَت وَتَنَفَّسَت","وَبادَرَها دَمعُ الهَوى يَتَرَقرَقُ",0,"ق",1,0],["فَلَمّا خَلَونا يَعلَمُ اللَهُ وَحدَهُ","لَقَد كَرُمَت نَجوى وَعَفَّت سَرائِرُ",1,"ر",1,0],["فَلَمّا خَرَّ عِندَ الحَوضِ طافوا","بِهِ وَأَبانَهُ مِنهُم عَريفُ",2,"ف",1,0],["فَلَمّا خَشيتُ أَن يَكونَ عَطاؤُهُ","أَداهِمَ سوداً أَو مُحَدرَجَةً سُمرا",3,"ر",2,0],["فَلَمّا خَشيتُ الهونَ وَالعيرُ مُمسِكٌ","عَلى رَغمِهِ ما أَثبَتَ الحَبلَ حافِرُه",4,"ر",2,0],["فَلَمّا خَشِيَ الإِلحا","حَ مِن صَحبٍ وَجُلّاسِ",5,"س",1,0],["فَلَمّا خَطَّهُ بَشَراً سَوِيّاً","حَذا حورَ الجِنانِ عَلى حِذاهُ",6,"ا",2,0],["فَلَمَّا خَشِيتُ عَلَى مُهْجَتِي","أَذَعْتُ الْهَوَى بِلِسَانِ الدُّمُوعِ",7,"ع",1,0],["فَلَمْ أَخَلْ نَثْرَهُ إِلاَّ حُلىً نُظِمَتْ","فِي سَمْطِ دُرِّ بَدِيعِ الصَّوْغِ مُنْتَسِقِ",8,"ق",1,0],["فلِمْ أختفي تحت التراب مضيَّعاً","وقد نوّهت في الخافِقين العُلا باسمي",9,"م",2,0],["فلما خَلت أيامُ أمجادكم خَلت","وللرومِ فيها رغبةٌ بعد رهبة",10,"ه",1,0],["فَلمّا خال أنّ النصحَ غشٌّ","وَغرّتهُ الجراءةُ فَاِستَغرّا",11,"ر",2,0],["فَلَمّا خَشيتُ الذَمَ قُلتُ اِشفَعوا لَهُ","بِثَنتَينِ مِن ذَودِ العِيالِ الغَوابِرِ",12,"ر",1,0],["فلمّا خلَصتُ نجِيَّ العُلا","وأقصرَ عن عذْليَ العاذِلونا",13,"ن",2,0],["فلمَّا خَبَّراني أي","نَ وَقعُ الغَيثِ في المَحلِ",14,"ل",1,1],["فلم اخلُ من تلدٍ منهما","قديمٍ ومن طارفٍ يستجدُّ",15,"د",1,0],["فلما خَيّلَ الصُّبْحُ","ولما يُبْدِ تَبْليجَهْ",16,"ج",2,0],["فلما خلا كرسيُّه منه خانه","ذووه وعاداه الذي كان يصطفي",17,"ف",2,0],["فَلَم أَخلِفِ الظَنَّ الَّذي كانَ يَرتَجي","وَبَعضُ أَخِلاءِ الرِّجالِ خَلوفُ",18,"ف",1,0],["فلما خافَ من طلبي لثاري","أدارَ عذارهُ زرداً عليه",19,"ه",1,0],["فلم أخل أن ظباء النقا","فد ألفت من قبلكالأسدا",20,"د",2,0],["فلم أخش حراساً عليَّ يواقِظاً","وجئتكَ لا ألوى ولا أتفزعُ",21,"ع",1,0],["فلمّا خَلَتْ منها الدِّيارُ ولم تجد","أَنيسا سِوى سُفْعٍ بهنَّ بَوالِ",22,"ل",1,0],["فلما خلوت به شاكياً","إليه جناياتِ بَيْنٍ وهجر",23,"ر",1,0],["فلم أخلُ من شاعرٍ محسنٍ","ومن مضحكٍ طيّب مندرِ",24,"ر",1,0],["فَلَمّا خَرَّ فَوقَ الأَرض يَهوي","تَبَينت الدَخائل وَالحَقائق",25,"ق",1,0],["فلما خبرت الناس خبر مجرب","ولم أر خيراً منه عدت إليه",26,"ه",1,0],["فلما خشيت أظافيره","نجوت وأرهنهم مالكا",27,"ك",2,0],["فلم أخف والله كيد العدا","يوما وسيفي فيهمُ الأصرمُ",28,"م",1,0],["فلما خافَ وشكَ الفوتِ منه","تشبثَ بالقوائمِ والمُحَيَّا",29,"ي",2,0],["فَلم أَخشَ ذا هَول وَلَم أَرج ذا عُلا","فَلم يَنخفض شَأوى وَلم ينك منشأي",30,"ي",1,0],["فلم اخترت فراقي","وأنا الليلة وحدي",31,"د",2,0],["فلم أخل أنني من الهوى سحرا","وقد علمت بأنّ ذا الهوى سحرا",32,"ر",2,0],["فَلِما خاوونَ قالَ أَفكِر فَما","عَلَّهُ يَنجُمُ عَن قَرعِ الحِراب",33,"ب",1,0],["فلما خنت فيك رجوت أن لا","تخلّ بكلّها فتكون غرّة",34,"ر",2,0],["فَلِم أخذتِ الطَرفَ مِنِّي بالذي","جَرَّ عَلى القَلبِ اللِسانُ وجَنى",35,"ا",1,0],["فلما خانني عطر الأقاحي","وجدتُ قلوبهم تبدو جمادا",36,"د",2,0]]}