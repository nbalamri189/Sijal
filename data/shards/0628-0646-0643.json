{"poems":[[87,"قُل لِاِبنِ سينا لا طَبيب","https://www.aldiwan.net/poem7916.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[112,"غني بربي","https://www.poetsgate.com/ViewPoem.aspx?id=8379",""],[572,"ململمات من كرات التبر","https://www.aldiwan.net/poem69695.html","الهزج"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120116","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123304","الرمل"],[5453,"مراتيع الخنا","https://www.poetsgate.com/ViewPoem.aspx?id=28014",""],[5956,"آن الأوان إلى الخلاص من الرِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=192593",""],[5956,"من مزايا البنك الإسلامي للتنمية","https://www.poetsgate.com/ViewPoem.aspx?id=193485",""],[6093,"بنك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=205829",""],[6320,"نَشِيجُ الخِضَمّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83635&r=&rc=16",""]],"verses":[["بَنكُ السَعيدِ عَلَيهِما","حَتّى القِيامَةِ قَيِّمُ",0,"م",1,0],["بَنْكُ مِصْرَ حِصْنَ هَ","ذِي الأُمَّةِ الرَّاسِي الأَشَمُّ",1,"م",1,0],["بنكي رياجيل الشرف والبطاقه","جمايلي وأسمي . وكبر المروّه",2,"و",2,0],["بنكهةِ العطْرِ وفوق العِطْرِ","أجودُ من نَشْقِ سُلاَفِ الخَمْرِ",3,"ر",1,0],["بنكهة يعجن منها","وشارب يقذر منه القذر",4,"ر",1,0],["بنكاحٍ آخر ليس لها عدةً","منه إذا ما تستعد",5,"د",1,0],["بنَك في وسط الجَنينة","يصحّنوها في الجفينة",6,"ه",1,0],["بنّك المحروق ..بالدله يسلاّ","يلبسك تيجان عبد ن بالمزاجي",7,"ج",2,0],["بنك من الإيمانٍ يدعم نفسه","يرجو قوى الإنتاجِ أن تترحَّبا",8,"ب",2,0],["بنك من الأخلاق يدعم نفسه","بالعدل يخترق الخصاصة والوبا",9,"ب",2,0],["بنكَ الجمال ألا ترقَّ","لعاشقٍ أبْدى الشَّجَنْ",10,"ن",1,0],["بِنَكْئِي لِقَرْحٍ أَذْهَلَ النَّزْفَ جَاثِماً","عَلَى الجُرْحِ ظَنَّتْهُ السِّهَامُ مَدَايَا",11,"ا",3,0]]}