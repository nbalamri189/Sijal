.aldiwan.net/poem12469.html","الخفيف"],[433,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[442,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[449,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[453,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[459,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[459,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[459,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[465,"يا زماناً بالخيف كان وكنا","https://www.aldiwan.net/poem3416.html","عموديه"],[501,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[501,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[507,"يا وفود الله فزتم بالمنى","https://www.aldiwan.net/poem2397.html","الرمل"],[552,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[563,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[568,"لا تظنين في بكاء النؤى والطنب","https://www.aldiwan.net/poem69810.html","البسيط"],[587,"حتام يلحى عليك من خلت ال","https://www.aldiwan.net/poem17809.html","المنسرح"]],"verses":[["كَم جُدنَ بِالأَجيادِ لي وَالطُلى","فَاليَومَ يَبخَلنَ بِرَدِّ السَلام",0,"م",1,0],["كَم جَرَّدَت شِفارَها","لَحمَ فَتىً بِلا وَضَم",1,"م",1,0],["كَم جاءَني الخَوفُ مِمّا كُنتُ آمَنَهُ","وَكَم أَمِنتُ الَّتي قَلبي بِها يَجِفُ",2,"ف",1,0],["كَم جَحفَلٍ مِثلِ الضَبابِ هَزَمتُهُ","بِمُهَنَّدٍ ماضٍ وَرُمحٍ أَسمَرِ",3,"ر",1,0],["كَمْ جَمَّعَ الظَّرْفُ مِنِّي بَيْنَ مُفْتَرَقِ","كَمْ أَلَّفَ الْحُسْنُ مِنِّي بَيْنَ لَوْنَيْن",4,"ن",1,0],["كَمْ جَابَ آفَاقاً لإسْعَادِهِ","بِعَزْمِ لاَ وَاهِ وَلاَ وَانِ",5,"ن",1,0],["كَمَجهودٍ تَحامى لَحمَ مَيتٍ","فَلَمّا اِضطُرَّ عادَ إِلَيهِ شَدّا",6,"د",2,0],["كَم جُبتُ دونَكَ مِن تَيهآءَ مُظِلمَةٍ","تيهٍ إِذا ما مُغَنّي جِنِّها سَمَرا",7,"ر",2,0],["كم جاء من مَلِك دهاك بجَوره","ولواك عن قصد السبيل الأفضل",8,"ل",1,0],["كم جملة وصلت لي من نداك وكم","تفصيلة ألبستني أجمل الحلل",9,"ل",1,0],["كم جنينا منه المواهب شهداً","إذ بنينا له الركائب نملا",10,"ل",2,0],["كم جلبت لطائرٍ من همن","وكم وكم قد أهلكت من قرن",11,"ن",1,0],["كم جَوْرةٍ للزمان فاحشةٍ","قاد بها الرأسَ مذعناً ذَنَبُهْ",12,"ب",2,0],["كم جنةٍ فيه وكم","نهرٍ لجِريته خَريرُ",13,"ر",1,0],["كم جاد فيه من مديح لم يجد","عن نحت شاعره ولا تحذيفه",14,"ف",2,0],["كم جاهل كان بالطائيِّ جرَّبه","صلّاً إذا طلب الأعداء زحافا",15,"ف",2,0],["كم جامح أصبح إذ راضه","تدمى لطول الكبح أشداقه",16,"ق",2,0],["كم جارعٍ جُرَعَ المكاره عالما","أنَّ المكارهَ يكتسين مَكارما",17,"م",2,1],["كَم جَريحٍ مُضَرَّجٍ بِدِماهُ","وَقَتيلٍ عَلى الثَرى مَمدودِ",18,"د",1,0],["كَم جَحفَلٍ بَعَثوا إِلَيكَ مَعَ الدُجى","لاقاهُ جَيشُكَ وَالصَباحُ فَزالا",19,"ل",2,0],["كَم جَلَسنا تَحتَ صَفصافَتِها","أَشتَكي وَجدي وَتَشكو لي هَواها",20,"ا",3,0],["كَم جيئَةٍ وَذَهابٍ شُرِّفَت بِهِما","بَطحاءُ مَكَّةَ في الإِصباحِ وَالغَسَمِ",21,"م",1,0],["كم جرَّ هُدّابَها طَخياءُ مظلمةٌ","فأقشعتْ ثم لم تسكُبْ ولم تُصِبِ",22,"ب",1,0],["كَم جَمَعتُ الرَحيقَ وَالريقَ مِنها","وَكِلانا قَتيلُ صَنجِ وُعودِ",23,"د",1,0],["كم جاهلٍ بالأمرِ حاولَ نَيلَه","فرأَى مَنالَ النَّجمِ دونَ مَنالِه",24,"ل",2,0],["كم جامحٍ مُمتَنِعٍ","خلَّيتُه لمَّا جَمَح",25,"ح",1,0],["كَم جَلَونا بِأُفقِكِ البَدرَ صُبحاً","وَاِجتَلَينا بِجُوِّكِ الشَمسَ لَيلا",26,"ل",2,0],["كَم جُموعٍ فَلَّلتَها بِحُسامٍ","شَرِقِ الصَفحَتَينِ ظامي الخُدودِ",27,"د",1,0],["كَم جَلَونا بِمَعرَكٍ كَربَ حَربٍ","وَكُؤوسُ المُدامِ فيها تُدارُ",28,"ر",1,0],["كم جال في وهمي فأرَّقني","أربٌ وأين الفوزُ بالأرب",29,"ب",1,0],["كم جريحٍ تعلّقَ الرّوحُ منه","بالتمنّي والجسمُ منه قتيلُ",30,"ل",1,0],["كم جوادٍ بكاكَ غيرَ صبورٍ","فنياحٌ عليكَ منه الصّهيلُ",30,"ل",1,0],["كَم جَرَّ ما اشفَقتَ مِنْ","لَمْسِكَ منْهُ إصْبَعُكْ",31,"ك",1,0],["كَم جِئتَ في الهَيجا بِيَومٍ أَبيَضٍ","وَالحَربُ قَد جاءَت بِيَومٍ أَسوَدا",32,"د",2,0],["كم جهولٍ وهْوَ مثرٍ مكثرٌ","وحكيمٍ ماتَ منها بالعللْ",33,"ل",1,0],["كم جرتْ أدمعي لهجرِكِ تحكي","مِنْ عطايا الوزير سيلَ البحورِ",34,"ر",1,0],["كم جيفةٍ خرجتْ من فيكَ مُنكَرَةٍ","لمّا تردَّتْ ببدرٍ تِلكمُ الجِيَفُ",35,"ف",1,0],["كم جِئْتَ بالعَرَبيِّ السَّمْحِ مُرتَجِلاً","واليومَ يومُ منايا الرُّومِ فَارْتَجِلِ",36,"ل",1,0],["كَم جُدتِ بِالمَعروفِ وَهوَ مُتَمَّمٌ","هِبَةً وَقُمتِ اللَيلَ وَهوَ تَمامُ",37,"م",1,0],["كَمْ جَدَّلَتْ كلماتُ اللهِ مِنْ جَدِلٍ","فيهِ وكم خَصَمَ البُرْهانُ مِنْ خَصِمِ",38,"م",1,0],["كَم جَوى عَبرَةٍ وَزَفرَةِ عَينٍ","قَد تَضَمَّنتُها فَما أَستَزيدُ",39,"د",1,0],["كَم جادَ قبلي حَضارٌ وَبادِيَةٌ","لِلوارِثينَ بِأَفراسٍ وَأَذوادِ",40,"د",1,0],["كَم جُزتُ شَهراً وَكَم جَرَّمتُ مِن سَنَةٍ","وَما أَرانِيَ إِلّا جاهِلاً غُمُرا",41,"ر",2,0],["كَم جاوَزوا مِن حِندِسٍ مُظلِمٍ","لِيَبلُغوا رَحمَتَكَ المُسفِرَه",42,"ر",2,0],["كَم جُدَّ بِالرِزقِ ثاوٍ في مَنازِلِهِ","وَحُدَّ سارٍ بِأَفراسٍ وَأَجمالِ",43,"ل",1,0],["كَم جِبالٍ مِنَ الجُيوشِ تَرادى","وَالَّذي أوضِعَت لَهُ الحِجرانِ",44,"ن",1,0],["كم جنَّةٍ لكِ قد سكنْتُ ظِلالَها","مُتفكِّهاً في لذَّةٍ وتَنعُّمِ",45,"م",1,0],["كَم جاهِلٍ جاء في بغدادَ يوسعني","نقداً فأعوزه علم وعرفان",46,"ن",1,0],["كَم جاهل ظن الخيال حقيقة","وَرأى الحقيقة في الحياة خيالا",47,"ل",2,0],["كَم جامع لكنوز","يَفنى وَتَبقى الكنوز",48,"ز",1,0],["كَم جَريحٍ لَولاهُمُ ماتَ نَزفاً","في يَدِ الجَهلِ أَو يَدِ الإِهمالِ",49,"ل",1,0],["كم جرَّ نفعَ المسلمين الرّومُ","والبحر عزٌّ أبداً مرومُ",50,"م",1,0],["كم جئت ليلى بأسباب ملفقة","ما كان أكثر أسبابي وعلاتي",51,"ي",1,0],["كَمْ جِئْتُكُم مُسْتَزِيراً","وَطَيْفُكُمْ لاَ يَزُورُ",52,"ر",1,0],["كَمْ جَدَّ فِي صِيَانَةِ السَّوَادِ مِنْ","غَوَائِلِ التَّاْوِيدِ وَالفَسَادِ",53,"د",1,0],["كمْ جَاهِلٍ حَاكَ الرِّدَاءَ وَزَانَهُ","بِالوَشْي بَيْنَ مُرَقَّمٍ وَمُسَطَّرِ",54,"ر",1,0],["كم جهِدْنا كم سهِدْنا","نهدمُ الجهل ونبني الناشئينْ",55,"ن",1,0],["كمْ جازَ صَوْتُك مِنْ بِحارٍ سُجِّرَتْ","وَفَدافِدٍ شُعْثِ الْفِجاجِ فِساحِ",56,"ح",1,0],["كَمْ جَاشَ جَيْشُك بِالْفَوَا","رِسِ مِنْ أَسَاوِرَةٍ وَصِيدِ",57,"د",1,0],["كمْ جَريءٍ لا يَرْهَبُ السَّيْفَ إنْ سُلَّ","وَنِكْسٍ يَخافُ مَسَّ قِرَابِهْ",58,"ب",2,0],["كم جديدٍ عليه نُبْلُ قديمٍ","وقديمٍ عليه حُسْنُ جديدِ",59,"د",1,0],["كم جئت أحمل من جراحات الهوى","نجوى ، يرددها الضمير ترنُّما",60,"م",2,1],["كم جولةٍ في مجمع الفصحى له","بين النجوم الزُّهرِ من علمائه",61,"ا",3,0],["كم جني القَمحَ عَسْجَدًا، وجني القُطْ","نَ لُجَيْنًا، وبات يَلْعَق صابه!",62,"ب",2,0],["كم جبان خاف الردى فأتاه","وتخطّى ستاره واستباحا",63,"ح",2,0],["كَم جاهل غَلط الأَيام قدمهُ","وَذو الفَضائل أَقصاهُ وَأَخرَهُ",64,"ر",2,0],["كم جسوم تضوي بعيش مري","يوم لا يحفظ المقام المقام",65,"م",1,0],["كم جاهلٍ حازَ الغِنى","والمالُ يغفِر جَهلَهُ",66,"ه",1,0],["كَم جَنَينَا بِهِ اللَّهوِ مِن خُو","دٍ تَبَدَّى شَمساً وتَرنُو غَزَالا",67,"ل",2,0],["كم جدت للناس غيري","تكرماً بالوصالِ",68,"ل",1,0],["كم جاهدوا كم طاردوا وتجلّدوا","للنائبات بصارم وبمقول",69,"ل",1,0],["كم جار فضلا بارزا وكامنا","وحل من عقد وكم وكي منن",70,"ن",1,0],["كم جاهل ظلت الآمال تركبه","من جهلة طبقا يرديه عن طبق",71,"ق",1,0],["كَم جَدَّلَت مِن ضَيغَمٍ بِقُرونِها","وافى لِيَقهَرَها عَلى الأَبناءِ",72,"ا",2,0],["كَم جُبت دونَكَ مِن تَيها وَخاوِيَةٍ","يَشكو الكَلالَ بِها النَجّاءَةُ التَعِبُ",73,"ب",1,0],["كَم جَدَّلَت بِحُدُودِها مِن مائِقٍ","مُتَمَرِّدٍ وَالخَيلُ في جَولاتِها",74,"ت",3,0],["كَم جُبتُ دُونكَ مِن مَجهُولَةٍ قَذَفٍ","تِيهٍ قَليلٌ بِها حلٌّ وَمُرتَحَلُ",75,"ل",1,0],["كَم جُبتُ دُونكَ مِن تيهٍ يَتِيهُ بِها","قَلبُ الدَليلِ مِنَ الإِشفاقِ وَالسَأَمِ",76,"م",1,0],["كم جليس إليّ وهو على الأر","ض ولكن كأنّه فوق رأسي",77,"س",2,1],["كم جالس متعظّم","بين المساند والمساور",78,"ر",1,0],["كم جميل صنعته مع قوم","صيروا ذلك الجميع قبيحا",79,"ح",2,1],["كَم جَمادٍ في الورى كما حيوان","كَضبابٍ وذئابٍ وظباء",80,"ا",2,0],["كَم جاءَنا من ربّه","في فضلهِ بالذكرِ نصُّ",81,"ص",1,0],["كَم جَزى المُحسنين خيرَ جزاءٍ","وَلِمَن قَد أساءَ ليس يُجازي",82,"ز",2,0],["كَم جمّعوا في حبّهِ الجموعا","وفرّقوا في حبّهِ المَجموعا",83,"ع",2,0],["كم جبتَ فيه بعزمةٍ أرضَ العدا","فتركتها قفراً بلا عمران",84,"ن",1,0],["كم جرى والفلاة تضرم كالجمرة","خلف الحمار بالمشوار",85,"ر",1,0],["كم جميل تسبيك وجنته","صار في الرمس شمها يردي",86,"د",2,0],["كَمجمَرةٍ أَفنَت مَدى اللَيلِ نارَها","فَما حَشوُها إِلّا رَمادٌ مُجَمَّعُ",87,"ع",1,0],["كَم جَلالَةٍ رَقَدَت","ملءَ عَينِها لَهبُ",88,"ب",1,0],["كم جاد لي بلقاء مَن طفقت","فيه المدامع وُكّفاً تجري",89,"ر",2,0],["كَم جَرَّعَت أَبناءَها","مِن فَتكِها بِهِمُ النَغَص",90,"ص",1,0],["كم جرّ برّ الوالدي","ن فوائداً للمرء جمّه",91,"م",2,0],["كَم جُنودٍ مِنَ المَلائِكِ تَبغي","لَكَ في حَومَةِ المَلاحِمِ خِدمَه",92,"م",2,0],["كم جَثَونا ذلّاً على قدميها","وبكينا وَجداً ولذَّ البكاء",93,"ا",2,0],["كم جِئْتُ بينَ خَمائلٍ وجَداول","مِنها أصعّد في المُنى وأصوِّبُ",94,"ب",1,0],["كَم جَرَحَ القَلبَ بِاللِحاظِ وَكَم","جَرَحتُ بِاللَحظِ خَدَّهُ تَرَفا",95,"ف",2,0],["كَم جَدوَلٍ عِندَهُ سِربٌ يُسَرُّ بِهِ","فَسِربُهُ آمِنٌ وَالماءُ مَذعورُ",96,"ر",1,0],["كم جبال جابها الرس","ل وكم جاب الصحابي",97,"ب",2,0],["كم جهبذ وغضنفر ذي سطوة","قهر الملوك به الزمان يميل",98,"ل",1,0],["كم جولةٍ لي ثمَّ جائرة الخطى","بَيْنَ الخمائلِ كالفراشِ الحائر",99,"ر",1,0],["كم جرح القلب منه جفنٌ","كالسيفِ في صحةِ القياسِ",100,"س",1,1],["كم جادلت طرفه الأحشاء فانقطعت","ما حجة السيف إلا حجة البطل",101,"ل",1,0],["كم جاءه بالشر شرد إلى","أن كسر الأضلاع من موجه",102,"ه",1,0],["كَم جالَ في مَيدانِ حُبِّكَ فارِسُ","بِالسَبقِ فيكَ إِلى رِضاكَ سَبَقتَهُ",103,"ه",1,0],["كَمَجهودٍ تَحامى أَكلَ مَيتٍ","فَلَمّا اِضطُرَّ عادَ إِلَيهِ شَدّا",104,"د",2,0],["كَمْ جِئْتُهُ مِن الحَدِيثِ بِسَمَرْ","فَقَالَ ما يُؤْذِيكُمُ إلا الهَذَرْ",105,"ر",1,0],["كَم جَلا كَأس طِلاً لي م