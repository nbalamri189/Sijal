{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[3,"يا عبل خلي عنك قول المفتري","https://www.aldiwan.net/poem164.html",""],[77,"شاهد بعينيك مني قرة العين","https://www.aldiwan.net/poem36030.html","البسيط"],[93,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[54,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem27603.html","الوافر"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[88,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[72,"يا أيها المربي برؤيته","https://www.aldiwan.net/poem19567.html","البسيط"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[91,"لله ما أحلى البشير وقوله","https://www.aldiwan.net/poem62655.html","عموديه"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[62,"يا نفس إياك إن نابتك نائبة","https://www.aldiwan.net/poem52483.html","البسيط"],[45,"لج من قد هويته في الصدود","https://www.aldiwan.net/poem63538.html","الخفيف"],[61,"لي من عبيد الله خل ما أرى","https://www.aldiwan.net/poem51467.html","الكامل"],[61,"إن عن لهو أو سنح","https://www.aldiwan.net/poem51734.html","مجزوء الرجز"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[66,"أصغرت مالنا النفوس الكبار","https://www.aldiwan.net/poem41561.html","الخفيف"],[97,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"بيتك فيه مصرعك","https://www.aldiwan.net/poem31347.html","مجزوء الرجز"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[105,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[46,"وعظت قوما فلم يرعوا إلى عظتي","https://www.aldiwan.net/poem22466.html","البسيط"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[46,"إياك والأيمان تلقي بها","https://www.aldiwan.net/poem22636.html","السريع"],[46,"لم يسقكم ربكم عن حسن فعلكم","https://www.aldiwan.net/poem23225.html","البسيط"],[46,"جير أن الفتى لفي النصب الأع","https://www.aldiwan.net/poem23544.html","الخفيف"],[76,"يا وجه معتذر ومقلة ظالم","https://www.aldiwan.net/poem38982.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85588","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85364","المجتث"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54875","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[95,"سر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=12258",""],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""]],"verses":[["كَم جُدنَ بِالأَجيادِ لي وَالطُلى","فَاليَومَ يَبخَلنَ بِرَدِّ السَلام",0,"م",1,0],["كَم جَرَّدَت شِفارَها","لَحمَ فَتىً بِلا وَضَم",1,"م",1,0],["كَم جاءَني الخَوفُ مِمّا كُنتُ آمَنَهُ","وَكَم أَمِنتُ الَّتي قَلبي بِها يَجِفُ",2,"ف",1,0],["كَم جَحفَلٍ مِثلِ الضَبابِ هَزَمتُهُ","بِمُهَنَّدٍ ماضٍ وَرُمحٍ أَسمَرِ",3,"ر",1,0],["كَمْ جَمَّعَ الظَّرْفُ مِنِّي بَيْنَ مُفْتَرَقِ","كَمْ أَلَّفَ الْحُسْنُ مِنِّي بَيْنَ لَوْنَيْن",4,"ن",1,0],["كَمْ جَابَ آفَاقاً لإسْعَادِهِ","بِعَزْمِ لاَ وَاهِ وَلاَ وَانِ",5,"ن",1,0],["كَمَجهودٍ تَحامى لَحمَ مَيتٍ","فَلَمّا اِضطُرَّ عادَ إِلَيهِ شَدّا",6,"د",2,0],["كَم جُبتُ دونَكَ مِن تَيهآءَ مُظِلمَةٍ","تيهٍ إِذا ما مُغَنّي جِنِّها سَمَرا",7,"ر",2,0],["كم جاء من مَلِك دهاك بجَوره","ولواك عن قصد السبيل الأفضل",8,"ل",1,0],["كم جملة وصلت لي من نداك وكم","تفصيلة ألبستني أجمل الحلل",9,"ل",1,0],["كم جنينا منه المواهب شهداً","إذ بنينا له الركائب نملا",10,"ل",2,0],["كم جلبت لطائرٍ من همن","وكم وكم قد أهلكت من قرن",11,"ن",1,0],["كم جَوْرةٍ للزمان فاحشةٍ","قاد بها الرأسَ مذعناً ذَنَبُهْ",12,"ب",2,0],["كم جنةٍ فيه وكم","نهرٍ لجِريته خَريرُ",13,"ر",1,0],["كم جاد فيه من مديح لم يجد","عن نحت شاعره ولا تحذيفه",14,"ف",2,0],["كم جاهل كان بالطائيِّ جرَّبه","صلّاً إذا طلب الأعداء زحافا",15,"ف",2,0],["كم جامح أصبح إذ راضه","تدمى لطول الكبح أشداقه",16,"ق",2,0],["كم جارعٍ جُرَعَ المكاره عالما","أنَّ المكارهَ يكتسين مَكارما",17,"م",2,1],["كَم جَريحٍ مُضَرَّجٍ بِدِماهُ","وَقَتيلٍ عَلى الثَرى مَمدودِ",18,"د",1,0],["كَم جَحفَلٍ بَعَثوا إِلَيكَ مَعَ الدُجى","لاقاهُ جَيشُكَ وَالصَباحُ فَزالا",19,"ل",2,0],["كَم جَلَسنا تَحتَ صَفصافَتِها","أَشتَكي وَجدي وَتَشكو لي هَواها",20,"ا",3,0],["كَم جيئَةٍ وَذَهابٍ شُرِّفَت بِهِما","بَطحاءُ مَكَّةَ في الإِصباحِ وَالغَسَمِ",21,"م",1,0],["كم جرَّ هُدّابَها طَخياءُ مظلمةٌ","فأقشعتْ ثم لم تسكُبْ ولم تُصِبِ",22,"ب",1,0],["كَم جَمَعتُ الرَحيقَ وَالريقَ مِنها","وَكِلانا قَتيلُ صَنجِ وُعودِ",23,"د",1,0],["كم جاهلٍ بالأمرِ حاولَ نَيلَه","فرأَى مَنالَ النَّجمِ دونَ مَنالِه",24,"ل",2,0],["كم جامحٍ مُمتَنِعٍ","خلَّيتُه لمَّا جَمَح",25,"ح",1,0],["كَم جَلَونا بِأُفقِكِ البَدرَ صُبحاً","وَاِجتَلَينا بِجُوِّكِ الشَمسَ لَيلا",26,"ل",2,0],["كَم جُموعٍ فَلَّلتَها بِحُسامٍ","شَرِقِ الصَفحَتَينِ ظامي الخُدودِ",27,"د",1,0],["كَم جَلَونا بِمَعرَكٍ كَربَ حَربٍ","وَكُؤوسُ المُدامِ فيها تُدارُ",28,"ر",1,0],["كم جال في وهمي فأرَّقني","أربٌ وأين الفوزُ بالأرب",29,"ب",1,0],["كم جريحٍ تعلّقَ الرّوحُ منه","بالتمنّي والجسمُ منه قتيلُ",30,"ل",1,0],["كم جوادٍ بكاكَ غيرَ صبورٍ","فنياحٌ عليكَ منه الصّهيلُ",30,"ل",1,0],["كَم جَرَّ ما اشفَقتَ مِنْ","لَمْسِكَ منْهُ إصْبَعُكْ",31,"ك",1,0],["كَم جِئتَ في الهَيجا بِيَومٍ أَبيَضٍ","وَالحَربُ قَد جاءَت بِيَومٍ أَسوَدا",32,"د",2,0],["كم جهولٍ وهْوَ مثرٍ مكثرٌ","وحكيمٍ ماتَ منها بالعللْ",33,"ل",1,0],["كم جرتْ أدمعي لهجرِكِ تحكي","مِنْ عطايا الوزير سيلَ البحورِ",34,"ر",1,0],["كم جيفةٍ خرجتْ من فيكَ مُنكَرَةٍ","لمّا تردَّتْ ببدرٍ تِلكمُ الجِيَفُ",35,"ف",1,0],["كم جِئْتَ بالعَرَبيِّ السَّمْحِ مُرتَجِلاً","واليومَ يومُ منايا الرُّومِ فَارْتَجِلِ",36,"ل",1,0],["كَم جُدتِ بِالمَعروفِ وَهوَ مُتَمَّمٌ","هِبَةً وَقُمتِ اللَيلَ وَهوَ تَمامُ",37,"م",1,0],["كَمْ جَدَّلَتْ كلماتُ اللهِ مِنْ جَدِلٍ","فيهِ وكم خَصَمَ البُرْهانُ مِنْ خَصِمِ",38,"م",1,0],["كَم جَوى عَبرَةٍ وَزَفرَةِ عَينٍ","قَد تَضَمَّنتُها فَما أَستَزيدُ",39,"د",1,0],["كَم جادَ قبلي حَضارٌ وَبادِيَةٌ","لِلوارِثينَ بِأَفراسٍ وَأَذوادِ",40,"د",1,0],["كَم جُزتُ شَهراً وَكَم جَرَّمتُ مِن سَنَةٍ","وَما أَرانِيَ إِلّا جاهِلاً غُمُرا",41,"ر",2,0],["كَم جاوَزوا مِن حِندِسٍ مُظلِمٍ","لِيَبلُغوا رَحمَتَكَ المُسفِرَه",42,"ر",2,0],["كَم جُدَّ بِالرِزقِ ثاوٍ في مَنازِلِهِ","وَحُدَّ سارٍ بِأَفراسٍ وَأَجمالِ",43,"ل",1,0],["كَم جِبالٍ مِنَ الجُيوشِ تَرادى","وَالَّذي أوضِعَت لَهُ الحِجرانِ",44,"ن",1,0],["كم جنَّةٍ لكِ قد سكنْتُ ظِلالَها","مُتفكِّهاً في لذَّةٍ وتَنعُّمِ",45,"م",1,0],["كَم جاهِلٍ جاء في بغدادَ يوسعني","نقداً فأعوزه علم وعرفان",46,"ن",1,0],["كَم جاهل ظن الخيال حقيقة","وَرأى الحقيقة في الحياة خيالا",47,"ل",2,0],["كَم جامع لكنوز","يَفنى وَتَبقى الكنوز",48,"ز",1,0],["كَم جَريحٍ لَولاهُمُ ماتَ نَزفاً","في يَدِ الجَهلِ أَو يَدِ الإِهمالِ",49,"ل",1,0],["كم جرَّ نفعَ المسلمين الرّومُ","والبحر عزٌّ أبداً مرومُ",50,"م",1,0],["كم جئت ليلى بأسباب ملفقة","ما كان أكثر أسبابي وعلاتي",51,"ي",1,0],["كَمْ جِئْتُكُم مُسْتَزِيراً","وَطَيْفُكُمْ لاَ يَزُورُ",52,"ر",1,0],["كَمْ جَدَّ فِي صِيَانَةِ السَّوَادِ مِنْ","غَوَائِلِ التَّاْوِيدِ وَالفَسَادِ",53,"د",1,0],["كمْ جَاهِلٍ حَاكَ الرِّدَاءَ وَزَانَهُ","بِالوَشْي بَيْنَ مُرَقَّمٍ وَمُسَطَّرِ",54,"ر",1,0],["كم جهِدْنا كم سهِدْنا","نهدمُ الجهل ونبني الناشئينْ",55,"ن",1,0],["كمْ جازَ صَوْتُك مِنْ بِحارٍ سُجِّرَتْ","وَفَدافِدٍ شُعْثِ الْفِجاجِ فِساحِ",56,"ح",1,0],["كَمْ جَاشَ جَيْشُك بِالْفَوَا","رِسِ مِنْ أَسَاوِرَةٍ وَصِيدِ",57,"د",1,0],["كمْ جَريءٍ لا يَرْهَبُ السَّيْفَ إنْ سُلَّ","وَنِكْسٍ يَخافُ مَسَّ قِرَابِهْ",58,"ب",2,0],["كم جديدٍ عليه نُبْلُ قديمٍ","وقديمٍ عليه حُسْنُ جديدِ",59,"د",1,0],["كم جئت أحمل من جراحات الهوى","نجوى ، يرددها الضمير ترنُّما",60,"م",2,1],["كم جولةٍ في مجمع الفصحى له","بين النجوم الزُّهرِ من علمائه",61,"ا",3,0],["كم جني القَمحَ عَسْجَدًا، وجني القُطْ","نَ لُجَيْنًا، وبات يَلْعَق صابه!",62,"ب",2,0]]}