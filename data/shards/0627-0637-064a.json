as&qid=86012&r=&rc=5",""]],"verses":[["أُطيفُ مِنكَ بِوَجهٍ غَيرِ مُلتَفِتٍ","إِلى المُناجي وَعِطفٍ غَيرِ مُنعَطِفِ",0,"ف",1,0],["أُطيلُ اِختِراطَ البيضِ فيها فَلو خَفا","بِها لَمَعانُ البَرقِ ظُنَّ المُهَنَّدا",1,"د",2,0],["أطيافها حول مسرى خاطري زمر","من الترانيم تشدو حولها زمر",2,"ر",1,0],["أُطيلُ وُقوفي مُستَهاماً بِبابِكُم","وَمِن دونِكُم ضيقٌ وَمَنعُ حِجابِ",3,"ب",1,0],["أطيلوا علَى روْضِ الجَمالِ خُطورَها","الى أنْ يقومَ الوَجْدُ فيها علَى ساقِ",4,"ق",1,0],["أَطِيَّةَ تَهْجِيِري وَبَاعِثَ رِحْلَتِي","فَلَوْلاَكَ لَمْ يُذْكَرْ عِقَالٌ وَلاَ خَطْمُ",5,"م",1,0],["أُطيلُ لهُ الْتِفاتي والتِماحي","لأنّ العَيْنَ ينْفَعُها السّوادُ",6,"د",1,0],["أطير فيها لفرط وجدي","من غصن ورد لغصن ورد",7,"د",1,0],["أطيب عيش المرء في شبابه","فإن تولّى فهو عيش مزدرى",8,"ا",1,0],["أَطيعوا فَلا الحَجّاجُ مُبقٍ عَلَيكُمُ","وَلا جِبرَئيلٌ ذو الجَناحَينِ غافِلُ",9,"ل",1,0],["أطّيب نفسي عن لؤي بن غالب","وهيهات مني ثم هيهات طبيبُها",10,"ب",3,0],["أُطيلُ اِجتِناباً عَنهُمُ غَيرَ بَغضَةٍ","وَلَكِنَّ بُقيا رَهبَةً وَتَصَحُّبا",11,"ب",2,0],["أطيع وقد قالَ لي باطلاً","وأين سلويَ والواشيه",12,"ي",2,0],["أطيب العيش منزل","فيه روض وجدول",13,"ل",1,1],["أُطيفُ بِرَسمٍ أَو أُلِمُّ بِدِمنَةٍ","أَخالُ القُصورَ الزُهرَ وَالغُرَفَ الشُمّا",14,"م",2,0],["أطيِبْ بها حِلَّاً ومحظورةً","في كَرْمها أو كأسِها أطيِبِ",15,"ب",1,0],["أُطيعَ وَأَضحى وَهوَ طَوعُ خَلائِقٍ","كَرائِمَ يَتبَعنَ النَدى حَيثُ يَمَّما",16,"م",2,0],["أطيَبَ ريحاً من نسيمِ الصَّبا","جاءتْ بِرَيَّا الوَرْدِ من جُورِ",17,"ر",1,0],["أَطيَبُ الأَنغامِ في مَسمَعِهِ","رِنَّةُ الشَكوى وَتَردادُ الأَنينْ",18,"ن",1,0],["أطيب بتلك هديّةً يسعى بها","في اللّهِ ساعٍ بالجلال مُظلَّلُ",19,"ل",1,0],["اَطيعوا الرَسولَ عُبادَ لآِلهٍ","تنجَّونَ مِن شَرِ يَومٍ أَلم",20,"م",1,0],["أَطَيفٌ مِن سُعادَ عَناكَ مِنها","مُراعَةُ النُجومِ وَمَن يَهيمُ",21,"م",1,0],["أطِيعوا إماماً للأئمّةِ فاضِلاً","كما كانتِ الأعمالُ يَفضُلُها البِرُّ",22,"ر",1,0],["أَطيَبُ اللَذّاتِ ما كا","نَ جِهاراً بِاِفتِضاحِ",23,"ح",1,0],["أَطيارُ يَعفورٍ ذَواتُ الخَيرِ","أَولى بِذاتِ فَضلِها المَذكورِ",24,"ر",1,0],["أَطيعي عَدُوّاً وَاِحذَري عَينَ حاسِدٍ","عَقارِبُهُ تَسري وَنَحنُ قُعودُ",25,"د",1,0],["أُطيعُكِ ما عَطَفتِ عَلَيَّ بِرّاً","وَإِن حاوَلتِ مَعصِيَتي عَصَيتُ",26,"ت",1,0],["أَطيَبُ الأَصواتِ عِندي","حُسنُ صَوتِ الهِندُواني",27,"ن",2,0],["أَطيَبُ الطِّيبِ طِيبُ أُمِّ عَليٍّ","مِسكُ فَأرٍ وعَنبرٍ مَفتُوٌ",28,"و",1,0],["أُطِيلَتْ بِعُثْنُونِ أَسَالَةُ وَجْهِهِ","وَفِي مَحْجَرَيْهِ كَوْكَبَانِ أَضَاءَا",29,"ا",2,0],["أطِيقُ إِذَا أرَدتُ الشِّعرَ يَوماً","عَلَى عِلاَّتِهِ مَالاَ تَطِيقُ",30,"ق",1,0],["أطيلُ الملال لمن لامني","وأملأ في الروضِ كأسَ الطلا",31,"ل",2,1],["أطيِبْ بأطلالِ ألأراك ونفحةٍ","باتت بمسراها الرجالُ تَضَوَّعُ",32,"ع",1,0],["أَطْيَاَفُ الأمْسِ تُرَاوِدُنَا","وَتَحَدِّي اليَوْمَ يُجَدِّدُنَا",33,"ن",2,1],["أطيّر لهم بالوّد صبحاً حمامة","وهم لي في الظلما عقارب قد دبّوا",34,"ب",3,0],["أطيعوا يا عصاة فقد أناخت","بكلكلها على العاصي المنون",35,"ن",1,0],["أَطْيَبُ الْعَيْشِ بُدُورٌ","تَتَمَّشى بِشُمُوسِ",36,"س",1,0],["أطيعهُ في قتلِ نفسي وما","عليَّ إلا طاعةُ الأمرِ",37,"ر",1,0],["أطيارها شادياتٌ","بغير ما قد شدوتم",38,"م",1,0],["أطيل على حسنها نظرتي","فتصبو إلى رشفه مقلتي",39,"ي",1,0],["أُطيلُ عَلَيهِ في العِتابِ شَكِيَّتي","فَيَعلَمُ أَنّي قَد ظلمتُ فَيُطرِقُ",40,"ق",1,0],["أَطيعوهُ مِن حُرٍّ وَعَبدٍ فَإِنَّهُ","خَليفَةُ مَبعوثٍ إِلى الحُرِّ وَالعَبدِ",41,"د",1,0],["أُطيعُ قلبي وأعصي في الهوى جَسَدي","ما عِفَّةُ المرءِ إلا قوةُ الجلدِ",42,"د",1,1],["أطيبُ العمرِ تولَّى","لا تقُل بعدُ لعلا",43,"ل",2,1],["أطيبتُها أم من قوامِكِ طيبُها","وقد نشرت منه على رقمات",44,"ت",1,0],["أطيّبَةَ الآباءِ والأمَّهاتِ هَل","من الطّيبِ إِلا الطّيبُ طبتِ مقاما",45,"م",2,0],["أُطيلُ الثَّناءَ عَلى ماجِدٍ","أَطالَ عَلَى نُوَبِ الدَّهْرِ باعِي",46,"ع",2,0],["أَطيَبُ شَيءٍ في الزَمانِ مَشرَبا","مُدامَةٌ في الكَأسِ تَجلو حَبَبا",47,"ب",2,1],["أَطيب من تحية","شكرتها فيك يدا",48,"د",2,0],["أَطيبُ بِها أُنساً إِذا ما رَأَيتُها","عَلى أَنَّ قَلبي في هَواها مُعَذَّبُ",49,"ب",1,0],["أُطيلُ الأماني ضَلّةً وأعُدُّها","لجَهْلي غنىً والعُمْرُ قد وَدَّع الشّطرا",50,"ر",2,0],["أطيرُ إلى ناديكَ فَرْطَ صَبابةٍ","كأنّيَ في تلك العِقابِ عُقاب",51,"ب",1,0],["أَطيَبُ المَيِّتينَ ريحَ قُبورٍ","وَالثَناءُ المَبثوثُ ريحُ القُبورُ",52,"ر",1,0],["أطيلُ وقوفي في الطلول كأنني","أحاولُ منها أن تردَّ تحيَّتي",53,"ت",2,0],["أطيلا ملامي أو أَقْصِرا","فإِنّي في الحُب لا أقصر",54,"ر",1,0],["أَطِيلوا على السبع الطوال وقوفَكم","تَدِرَّ عليكم بالعلوم سحاب",55,"ب",1,0],["أَطيف خَيال العامِريّة خَلِّني","فأن المَعالي ظل أَقسامها نَهبا",56,"ب",2,0],["أُطيعُ هَوَى عَصْمَاءَ وهو يُضِلُّنِي","ومَا أنَا فيها للنُّهى بمُطيعِ",57,"ع",1,1],["أطيعوا مليكا يشتري الحمد بالندى","ويرقد في جفن الردى وهو أرمد",58,"د",1,0],["أطيع نفسي وأعصى العاذلين لها","تبغي هداها وتهديني إلى الختر",59,"ر",1,0],["أطيعوا الرب يا أرباب نزوى","أريضوا النفس لا تركب ثآها",60,"ا",3,0],["أَطيعوني وأَوبوا عن طريق","تؤول بكم بشر منتهاها",61,"ا",3,0],["اطيل عنان القول مرتجلا وما","تلعثمت يوما والقلوب هوالع",62,"ع",1,0],["أطيلي البقاءَ فإنَّ العطور","تُراقُ استماعا وُتزهَى الزهور",63,"ر",1,0],["أطيبُ من أخلاقه مشروبةً","ولا جنَا النحلةِ ديفَ باللبَنْ",64,"ن",1,0],["أَطيبُ مِن طيبِ الحَياةِ شُربُها","مُمَكِّنٌ مِنَ النُفوسِ حُبُّها",65,"ه",2,0],["أطيرُ إلى حِماكِ بلا جَناحٍ","لأَغنَمَ فيضَ هِمَّةِ من حَمَاكِ",66,"ك",1,0],["أَطيرُ وجْداً ولي في النَّفْسِ مُثْقَلَةٌ","فكم لها قلتُ يا لوَّامَتي تُوبي",67,"ب",2,0],["أَطيرُ مِنْ قلبي لهُ","في الشَّوقِ بازاً أَشهَبَا",68,"ب",2,0],["أَطْيَبُ الطَّيِّباتِ عِلْمٌ يُريكَ ال","حَق حَقاً ما دُونَهُ مِنْ حِجابِ",69,"ب",1,1],["أُطيعهُ وهو يَعصيني وأُنصِفُهُ","كما يحاول من نفسي ويظلمني",70,"ن",2,0],["أطيبُ ما نِلْتُ من اللَّذّاتِ","ومن سُرُورٍ مُعْجِبِ الأَوْقَاتِ",71,"ت",1,1],["أطيعوا الله ربَّ الناس رَبّاً","وأحمدَ والأولى المتأَمَّرينا",72,"ن",2,0],["أطيار حبي في الفضاء الفسيح","لم تستطع رفرفة بالجناح",73,"ح",1,1],["أطير من فرط أشواقي إليكِ هَوىً","لكنَّ قلبي بنار الشوق خفّاقِ",74,"ق",1,0],["أطيعي البعل وانعطفي عليه","ولا ترخي لنزغتك العنانا",75,"ن",2,0],["أطيب التهنئات بالحج والرت","بة يهديك أطيب المخلصينا",76,"ن",2,0],["أطيب بأنديةِ العقيقِ","ونسيمهِ العبقِ 