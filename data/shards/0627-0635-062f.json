431,"هذا بعلي!!....","https://www.poetsgate.com/ViewPoem.aspx?id=201150",""],[5561,"حُكْمُ القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=192908",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5701,"شيطانة من بنات الأنس لاعبة","https://www.poetsgate.com/ViewPoem.aspx?id=164652",""],[5703,"عيون القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207967",""],[5705,"يا دارَ أسماءَ بين السَفْحِ فالرُّحَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=4532",""],[5732,"غنيت ما قصدي طرب","https://www.poetsgate.com/ViewPoem.aspx?id=177854",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5790,"أصدرتها والعوالي في الطلى ترد","https://www.poetsgate.com/ViewPoem.aspx?id=111912",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[5956,"مناجاة الأخ الميت","https://www.poetsgate.com/ViewPoem.aspx?id=192372",""],[5956,"اذهب لمصنعك الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=193166",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[6115,"نافق وجامل وكل الناس يطرونك","https://www.poetsgate.com/ViewPoem.aspx?id=180522",""],[6213,"حبّات المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81913&r=&rc=88",""],[6214,"ألا ليتَ شعري والفُؤادُ عميدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25654&r=&rc=4",""],[6237,"لكل صابونة ليفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77876&r=&rc=18",""],[406,"مهرجان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1119&r=&rc=63",""],[2220,"ما والدي إلا الذي يحكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11794&r=&rc=664",""],[6314,"الدرب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88074&r=&rc=9",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""],[3022,"تعدو العوادى والخطوب تنوب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73327&r=&rc=0",""]],"verses":[["أَصدِقائي أَقارِبي وَأَخِلّا","ئي قَبيلي وَإِخوَتي إِخواني",0,"ن",2,0],["أَصُدَّ حَياءً لِلرِفاقِ وَإِنَّما","زِمامِيَ مُنقادٌ مَعَ الشَوقِ طَيِّعُ",1,"ع",1,0],["أَصُدُّ عَنِ الواشِي كَأَنِّي طَريدَةٌ","تُراعُ بِمُسْتَنِّ الرَّدى وَتُراغُ",2,"غ",1,0],["أَصُدُّ إِذا ما مَرَّ بي بَعضُ أَهلِها","بِوَجهي وَتَأبى المُقلَتانِ سِوى الذَرفِ",3,"ف",1,0],["أَصدّقتِ حُسّاداً وَكَذَّبتِ عاشِقاً","وَليسَ سَواءً عاشِقٌ وَحَسودُ",4,"د",1,0],["أَصَدَّ نِشاصِ ذي القَرنَينِ حَتّى","تَوَلّى عارِضُ المَلِكِ الهُمامِ",5,"م",1,0],["أَصُدُّ وَبي الجُنونِ لِكَي يَرى","رُواةُ الخَنا أَنِّي لِبَيتِكِ هاجِرُ",6,"ر",1,0],["أَصِدّوا لا تَروعوا شِبهَ مَيٍّ","صُدورَ العيسِ شَيئاً مِن صُدودِ",7,"د",1,0],["أَصدَرتُهُم شَتّى كَأَنَّ قِسِيَّهُم","قُرونُ صِوارٍ ساقِطٍ مُتَلَغِّبِ",8,"ب",1,0],["أصدوده أم دَلُّهُ أم بُخلُه","أخطأتَ تِلك مِلاحه وصِباحُه",9,"ح",2,0],["أُصَدِّقُ الشِعرَ في الحَياةِ وَفيكُم","لَيسَ غَيرَ الأَظلالِ في ديواني",10,"ن",2,0],["أصُدُّ عن الماءِ القَراحِ تشوبُه","قَذاةٌ وما بين الجوانحِ أُلُهوبُ",11,"ب",1,0],["أَصدِقائي عَلى الغِنى فَإِذا عُد","تُ إِلى حاجَةٍ فَأَنتَ صَديقي",12,"ق",2,0],["أَصُدودٌ غَلا بِها أَم دَلالُ","يَومَ زُمَّت بِرامَةَ الأَجمالُ",13,"ل",1,1],["أَصُدودٌ لِغَيرِ ذَنبٍ وَهَجرُ","كُن كَما شِئتَ لَستُ عَنكَ بِسالِ",14,"ل",1,0],["أَصدَقُ الناسِ مَن يُشيدُ بِقَولٍ","إِنَّ سَيفَ الإِمامِ ذو السَيفَينِ",15,"ن",1,0],["أَصدِر هُمومَكَ لا يَقتُلكَ وارِدُها","فَكُلُّ وارِدَةٍ يَوماً لَها صَدَرُ",16,"ر",1,0],["أصدقاء الحروف لا تعذلوني","إن تفجرت أيها الأصدقاء",17,"ا",2,0],["أصدقائي.. حكيت ما ليس يحكى","وشفيعي... طفولتي والنقاء",17,"ا",2,0],["أَصَدّاً وَسُخطاً كَيفَ يَحكُمُ","أَلَيسَ لَهُ قَلبٌ يَرُقُّ فَيَرحَمُ",18,"م",1,1],["أَصداغُهُ أَلِفٌ وَلامُ","وَلِحاظُهُ سَيفٌ حُسامُ",19,"م",1,1],["أَصُدُّ حَياءً أَن يَلِجَّ بِيَ الهَوى","وَفيكِ المُنى لَولا عَدُوٌّ أُحاوِرُه",20,"ر",2,0],["اصدَعْ قُيودَ بني الكنانةِ إنّها","لا تبتغي أسراً ولا استرقاقا",21,"ق",2,0],["أَصُدُّ بِوَجهي عَن كَثيرينَ إِنَّني","أرى المَرءَ تُرديهِ الحَماقَةُ وَالجَهلُ",22,"ل",1,1],["أَصدَقُ الناسِ بِلا","أَكذَبُ الناسِ نَعَم",23,"م",1,0],["إِصدَع نَجِيَّ الهُمومِ بِالطَرَبِ","وَاِنعَم عَلى الدَهرِ بِاِبنَةِ العِنَبِ",24,"ب",1,1],["أَصدَرٌ إِن واجَهَ العَي","نَ وَإِن وَلّى أَكَبّا",25,"ب",2,0],["أَصداغُهُنَّ مُعَقرَبا","تٌ وَالشَوارِبُ مِن عَبيرِ",26,"ر",1,0],["أًصدَعُ البَلدَةَ الغَريبَةَ بِالحَد","دِ جِلاداً عولينَ في تَصبيرِ",27,"ر",1,0],["أَصُدُّ عَنِ النِساءِ وَهُنَّ صُورٌ","كَما صَدَّ الرَهيصُ عَنِ الضِمادِ",28,"د",1,0],["أَصدُق إِلى أَن تَظُنَّ الصِدقَ مَهلَكَةً","وَعِندَ ذَلِكَ فَاِقعُد كاذِباً وَقُمِ",29,"م",1,0],["أصداؤُها الرفَّافَةُ الحائره","في وجهها الآفاق لا توصدُ",30,"د",1,0],["إصدَحي أيتها الأرواحُ باللْحنِ البديعِ","إمرَحي يا راقصات الضوءِ بالموج الخليعِ",31,"ع",1,0],["أُصَدّقُهُ في مِرْيَةٍ وقد امْتَرَتْ","صَحابةُ موسى بعْدَ آياتِه التّسْعِ",32,"ع",1,0],["أَصُدُّ عَنِ الْمَرْمَى الْقَريبِ تَرَفُّعَاً","وأَطْلُبُ أَمْرَاً يُعْجِزُ الطَّيْرَ بُعْدُهُ",33,"د",2,0],["أَصُدُّ عَنِ الْمَوفُورِ يُدْرِكُهُ الْخَنَا","وَأَقْنَعُ بِالْمَيْسُورِ يَعْقُبُهُ الْحَمْدُ",34,"د",1,0],["أَصُدُّ عَنِ النَّعِيمِ صُدُودَ عَجْزٍ","وَأُظْهِرُ سَلْوَةً وَالْقَلْبُ صَابِي",35,"ب",2,0],["أَصْدِرْ صَحَائِفَكَ الَّتِي تُحيِي بِهَا","نِضْوَ الطِّرِيقِ وَتَدْفَعُ المُتَخَلِّفَا",36,"ف",2,0],["أصديقي يودُّ أني أساء","وعدوِّي يُظن فيه الوفاءُ",37,"ا",2,1],["أصدقُ الأَصدقاء في هذه الدُّنْ","يا همُ الأُمَّهات والآباءُ",38,"ا",2,0],["أصدق الأنباء عن خستها","ليس ما ينقل عنها مفتعل",39,"ل",1,0],["أصد حياء أن يلج بي الهوى","وفيكِ المُنَى لولا عَدُوُّ أُحاوِرُ",40,"ر",1,0],["أصد بدموعي وأكابر بقدّي ..","أخاف لاينطق بفرقاي... كاتم",41,"م",1,0],["أصديق .. وبعد خمس سنين","كنت فيها الشذا وكنت الرحيقا",42,"ق",2,0],["أَصُدُّ عَنهُ اِرتِقاباً أَن أُلِمَّ بِهِ","وَمَن يَخَف قالَةَ الواشينَ يَرتَقِبِ",43,"ب",1,0],["أَصُدُّ حَيَاءً أَن يَلِجَّ بِىَ الهَوَى","وَفِيكَ المُنَى لَولاَ عَدُوٌّ حاذِرُه",44,"ر",2,0],["أَصُدُّ وَبِى مِثلُ الجُنُونِ مِنَ الهَوَى","وَأَهجُرُ لَيلَى العَصرَ ثُمَّ أُنِيبُ",45,"ب",1,0],["أصدّ لغير ما 