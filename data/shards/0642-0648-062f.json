{"poems":[[55,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[44,"يا ناعي الدين الذي ينعى التقى","https://www.aldiwan.net/poem50347.html","الكامل"],[53,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[30,"وإذا عددت بني كليب لم تجد","https://www.aldiwan.net/poem5482.html","الكامل"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[54,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[108,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[331,"وكأنهن من الكلال أهلة","https://www.aldiwan.net/poem44266.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[463,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[482,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[558,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124018","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[4981,"هواجس دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=190502",""],[5152,"رسالة للأشاوس في اليمن السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=184990",""],[5537,"نقاش أمن قومي","https://www.poetsgate.com/ViewPoem.aspx?id=207782",""],[463,"لنا من ليلنا بلوى الصريم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60307&r=&rc=363",""]],"verses":[["قوداً إِذا اللَيلُ بِها تَرامى","مَرَقنَ مِن ظَلمائِهِ سِهاما",0,"م",2,0],["قودوا الجيادَ لِنَصرِ آلِ مُحَمَدٍ","لِيَكونَ سَهمُكُمُ مَعَ الأَنصارِ",1,"ر",1,0],["قودَكَ البغلَ أو إباقكَ في الأر","ضِ عليه وأين مني إباقُك",2,"ك",1,0],["قوداً تَذارَعُ غولَ كُلِّ تَنوفَةٍ","ذَرعَ النَواسِجِ مُبرَماً وَسَحيلا",3,"ل",2,0],["قوداً ضَوامِرَ في الرُكوبِ كَأَنَّها","عِقبانُ يَومِ تَغَيِّمٍ وَطِلالِ",4,"ل",1,0],["قَودُ الجِيادِ وَإِصهارُ المُلوكِ وَصَب","رٌ في مَواطِنَ لَو كانوا بِها سَئِموا",5,"م",3,0],["قوداً تَجاسَرُ بِالحُدو","جِ بِشاطِئِ الشَرَفِ المُقابِل",6,"ل",1,0],["قودوا لَهُم قودَ الجِيادِ شَواذِباً","لا يَهتَدونَ إِلى الطَريقِ الأَبعَدِ",7,"د",1,0],["قودَ المَطايا بِعَمى مارِقٍ","عوتِبَ في اللَهِ فَلَم يُعتِبِ",8,"ب",1,0],["قَوَّدَ بدراً أمرَ تلك الطائفَهْ","وكانتِ النَّفسُ عليه خائفَهْ",9,"ه",1,0],["قُوداً تُراحُ إلى الصيَّاحِ إذا غَدَتْ","فِعْلَ الضِّراءِ تَراحُ للكلاّبِ",10,"ب",1,0],["قودوا البخارَ وسوقوا الكهرباء؛ فما","زلتمْ بأسرار هذا الكون جُهَّالا",11,"ل",2,0],["قودٌ طَواها ما طَوَت مِن مَهمَهٍ","نائي الصُوى وَمَناهِجٍ أَدراسِ",12,"س",1,0],["قُوداً تُريعُ إِلى أَغَرَّ لِوَجهِهِ","نورٌ يُضيءُ أَمامَها وَخِلالَها",13,"ل",3,0],["قوّدتَها للحقّ إذ هي ناشطٌ","لا تستطيع يدُ الزمان خِطامَها",14,"م",3,0],["قُودُ الهوادي ما قطعنَ مفازةً","في الآلِ إلا خلتهَنَّ مراكبا",15,"ب",2,0],["قوداً نَواجِيَ فَالحَنِيِّ ضَوامِراً","تَرَكَت عَرائِكَها المَهامِهُ ميلا",16,"ل",2,0],["قوداء كرماء في عرنيها شمم","كم خلفت أمما إذ أمها ميل",17,"ل",1,0],["قُودٍ شَماليلَ قِلاصٍ حُسَّرِ","عُوجٍ عَياهيمَ طِلاحِ السَّفَرِ",18,"ر",1,0],["قوداءُ إن شقّ بالقود الوجى عجمت","منها الجلاميد رجل صلبة ويدَ",19,"د",1,0],["قوداً مَسانيفَ تَرقى في أَعِنَّتِها","مُقوَرَّةً نَقعُها يَعلو بِإِعصارِ",20,"ر",1,0],["قَوداءُ مائِرَةُ الضَبعَينِ نِسبَتُها","في سِرِّ أَرحَبَ أَو تَنمي بِها العيدُ",21,"د",1,0],["قُودي العروبةَ للعلياءِ لو ضَلَّتْ","كما يقودُ عظيمَ الفُلكِ مَلّاحُ",22,"ح",1,0],["قُوْدِي بحكمتكِ البِلادَ وَطَهِّرِي","أَرْضَ السَلامِ منِ انتهاكاتِ البَسُوسْ",23,"س",1,0],["قُوُدُونِيِ حَتى الجَلَّادِ","لنُنَاَقِش ..أحَوَاَلَ بِلاَدِيِ",24,"د",2,0],["قود خلَّفتني من كفِّ دهري","بطول الصدِّ في أسرٍ لئيمِ",25,"م",1,0]]}