.ae/diwan/poem/107485","الخفيف"],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105883","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127078","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145293","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133141","الرجز"],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[5124,"قل لمن زانه عفاف وَدين","https://www.poetsgate.com/ViewPoem.aspx?id=189793",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""]],"verses":[["وَهوبٌ بِأَعناقِ المئينَ عَطاؤُهُ","غَلوبٌ عَلى الأَمرِ الَّذي هُوَ فاعِلُ",0,"ل",1,0],["وهو بعلٌ للمكرمات فما ين","فكُّ بين العَوَان والعذارءِ",1,"ا",1,0],["وَهوَ بَينَ الطُيورِ تَحسَبُهُ العَن","قاءَ لَولا اِستِحالَةُ العَنقاءِ",2,"ا",2,0],["وَهوَ بَينَ النُجومِ يَستَرِقُ السَم","عَ وَلا يَتَّقي رُجومَ السَماءِ",2,"ا",2,0],["وهو بالوان الخيا","ل في الحياة مفعم",3,"م",1,0],["وهو بدر الدجى إذا","لم يشب كنهه كدر",4,"ر",1,0],["وهو برباة هرمس","ويسمى بذي الغير",4,"ر",1,0],["وهو بذاك الغداء يرضعه","يعود حياً من بعد ما عطبا",5,"ب",2,0],["وَهْوَ بِالدَّمْعِ بَخِيلٌ","وَدُمُوعِي مِلْءُ عَيْنِي",6,"ن",2,0],["وهو بالسِّجنِ مُرتهنْ","لم يشَّيعْ بدمعةٍ",7,"ه",1,0],["وَهوَ باقي الإِطرافِ حَيَّت بِهِ الكَأ","سُ وَماتَت أَوصالُهُ وَالكَلامُ",8,"م",1,0],["وَهوبٌ لِلمُخَيَّسَةِ النَواجي","عَلَيها القائِناتُ مِنَ الرِحالِ",9,"ل",1,0],["وَهُوَ بِدُنياهُ مولَعٌ كَلِفٌ","يَقنَعُ مِن صَيدِها بِمِعراضِ",10,"ض",1,0],["وهو بينا يقتافُ في الهدّارِ","منفذا بين موجه للفرارِ",11,"ر",1,0],["وهو بين ذين لا بِعَنودٍ","في الذي يَبتغي ولا بعَسوف",12,"ف",1,0],["وهو بالغيمِ يخنقُ القلب والأفقَ","جميلٌ في عينه محبوب",13,"ب",1,0],["وهو بعد اختباره موشك أن","يتعدى في جحده الملكوتا",14,"ت",2,0],["وهو بالصدق والرضا يتلقى","من لسان الرسول أمر الباري",15,"ر",2,0],["وهو بين الأنبيا شهم جليل","وله باع طويل في الأمور",16,"ر",1,0],["وهو باب الوصول للَه والجا","ه العريض الحامي من الأكدار",17,"ر",1,0],["وهو بحر ضمن زبدته","كل بحر عائم الزبد",18,"د",1,0],["وهو باب الغنى لكل فقير","والملاذ الحامي من الأهوال",19,"ل",1,0],["وهوب الجيادِ وبيضِ القِيا","ن والظبي يرتجُّ منه الكثيبُ",20,"ب",1,0],["وهو بعض الورى وصدر المطايا","وهو من سائق الظعائن حلف",21,"ف",1,0],["وهوَ بحقٍّ عالمٌ معلومُ","مِن ربِّه لا الدرس قد تعلّما",22,"م",2,0],["وهو باقٍ باللَه في كلّ حالٍ","قبل موتٍ وبعد موتٍ سواءُ",23,"ا",2,0],["وهو بينَ أكوسها","البدرُ حولهُ الشهبُ",24,"ب",1,0],["وهو بينَ العيونِ والقلبِ رسمٌ","كلما جالت اللواحظُ يُمحَى",25,"ح",2,0],["وَهوبِ النَجيباتِ المَراقيلِ بِالضُحى","بِأَكوارِها تَجتابُ كُلَّ تَنوفِ",26,"ف",1,0],["وهو بر بنا رؤف رحيم","ومن الجود ان يبر عياله",27,"ل",2,0],["وَهْوَ بِهَا خَيْرُ زَنْدٍ","لأَِنَّهَا خَيْرُ وَقْفِ",28,"ف",1,0],["وهو بلا مكابر","عندي من الأكابر",29,"ر",1,0],["وهو بابٌ لذي العلا","طاب في الصدر موردا",30,"د",2,0],["وهو بأصغاء لها يغل","شرابه غسلينها والمُهل",31,"ل",1,0],["وهو بعد المساجد الثلاث لمن","خير بلاد اللَه جنوب وشام",32,"م",1,0],["وَهوَ بِعَيني وَهوَ إِنسانُها","وَهيَ لَهُ مِن خارِجٍ حاجِبُ",33,"ب",1,0],["وهو برقى في إكام وهضاب","تارة للعين تبدو أو تلوح",34,"ح",1,0],["وهوباً سالباً وأخاً عدوّاً","بفطرته ومنقادا أبيَّا",35,"ي",2,0],["وهوبٌ اذا ما ضنَّت السُّحب بالحيا","وماضِ اذا حُمْس الفوارس فرَّت",36,"ت",1,0],["وَهُوباً ضَروباً في قَتامٍ وعِثْيَرٍ","إذا السُّحب ضنَّت أو إذا الخيل ولَّت",37,"ت",1,0],["وَهَوبٍ لِطَوعاتِ الأَزِمَّةِ في البُرى","وَلِلأُفُقِ النَهدِ الأَسيلِ المُعَذَّرِ",38,"ر",1,0],["وَهوبٌ يوسِعُ الفقراءَ تِبراً","ولم يهبِ العِدا إلّا تَبارا",39,"ر",2,0],["وَهْوَ بِلا تَشَكُّكِ","مُقَدَّمٌ في الْمَسْلَكِ",40,"ك",1,0],["وهو بقلبي توكل ورضىً","عنه وفيه الأمور محتبكه",41,"ك",2,0],["وهو بالطاعات منقلب","حسناً من أحسن الأعمال",42,"ل",1,0],["وهو باق على الذي هو فيه","أزلاً ليس ما سواه اشتراكا",43,"ك",2,0],["وهو بين الناس مرتفع","وهو عند الله منهبط",44,"ط",1,0],["وهو باقي الحروف أيان ولّى","بانحراف لوجهه المشهود",45,"د",1,0],["وهو بعيد غاية البعد عن","أن يشبه الغيب الحقيق النزوح",46,"ح",1,0],["وهو باب لبيت سر عظيم","بيت حق جداره التثبيت",47,"ت",1,0],["وهو بزري وهو أيضاً","ظاهراً من ثمراتي",48,"ت",2,0],["وهو بلا شك إذا كان اعتقد","لمن ذكرنا مبعد فيمن بعد",49,"د",1,0],["وهو بالنَّفس طاب أَصلاً وفرْعاً","وهو بالقلب حلَّ فيه المحرّم",50,"م",1,0],["وهو بابٌ لعلومي فسُقوا","ماءُ صَبرٍ بنقيع الحنظلِ",51,"ل",1,0],["وَهُوَ بِالمدّ في لِسان فرنجٍ","اسمُ شيء إِن فارق الجسم متنا",52,"ن",2,0],["وَهوَ بِالمنصب الرَفيع جَدير","وَجَميع الوَرى بِذاك شُهود",53,"د",1,0],["وَهوَ بِالعَفوِ لَو عَلِمتَ حَقيقٌ","أَيُّ ذَنبٍ مَعَ عَفوِهِ في وُجودِ",54,"د",1,0],["وَهوَ بَدرٌ فيهِ كانَتْ","تغبِطُ الأرضَ السماءُ",55,"ا",2,0],["وَهوَ بِهَذا لِلصَنيع ناكر","وَالحَقّ لا يَجحده المكابِر",56,"ر",1,0],["وَهوَ بِها مُحجَّبٌ مُستَتِرُ","وَرُبَّما بِالبَحث عَنهُ يَظهَر",57,"ر",1,0],["وهو باب اللّه أيّ فتى","من سواه جاء ما دخلا",58,"ل",2,0],["وهو بشوش بالوجه غير عابس","كان ماء الحسن منه يجري",59,"ي",1,0],["وهو باقٍ هناك ما خبت الري -","ح ولاحت كواكب الجوزاء",60,"ا",2,0],["وهو بدر لليلها وإذا ما","وضح الصبحُ فهو شمس ضحاها",61,"ا",3,0],["وَهْوَ بَابُ الرَّجَا وَذُخْرُ المُرَجيِّ","وَهْوَ رَوْضُ المُنَى وَوُسْطَى العُقُودِ",62,"د",1,0],["وَهوَ بِدارِ العاجِزِ المُضِيعِ","تَرَاهُ عِنْدَ الطَمَعِ الطَمُوعِ",63,"ع",1,0],["وَهوَ بِلا شَك يَتم أَمره","فَقَد سَرى بَينَ الجُنود مَكره",64,"ه",1,0],["وهوَ بريء مِنهُم في الظاهِر","وغَيرهُ مختضب الأَظافِر",65,"ر",1,0],["وَهوَ بِحُسن اللعب وَالتَدبير","يَسد خرق الفَص بِالتقدير",66,"ر",1,0],["وَهوَ بِها في خَطَرٍ بَيِّنٍ","لَو كاسَ ما خاطَرَ بِالنارِ",67,"ر",1,0],["وهو بإعراب الفريد قد عرف","في حالة يكون فيها منصرف",68,"ف",1,0],["وهو بواو تارة أو ياء","بعد روي البيت في انتهاء",69,"ا",2,0],["وهو بترك الفضول أجدر لو","يسلم من خفة ومن خطل",70,"ل",1,0],["وهو بحب السودان أعرفه","وليس عن رأيه بمنتقل",70,"ل",1,0],["وهو بين الشهبِ بدرُ الأُفق","فله الأملاكُ لمَّا عَقَدوا",71,"د",3,0],["وهو بحرٌ ولهذا فمه","يقذف اللؤلؤَ في النادي رطيبا",72,"ب",2,0],["وهوَ بالاوجال حالِ","قد جار بي دهري",73,"ي",1,0],["وهوَ بالفصال صال","يا خالق الكونِ",74,"ن",1,0],["وهو ب مهيب في العشير محبب","مساعيه عزت كلّ باد وحاضر",75,"ر",1,0],["وهو باب الله التي ما أتاها","لمرام كل إلى ما أتاها",76,"ا",3,0],["وهو بذر له ولا يبذر العا","قل شيئا لنفسه فيه نير",77,"ر",1,0],["وَهوبٌ لِمَضنونِ الصَفايا تَبَرُّعاً","إِذا الشَولُ لَم تُرفَع لَهُنَّ ذُيولُ",78,"ل",1,0],["وَهُوب إذا ما أَمَّه طالب الندى","وإن يَمَّمَ الأَعداء فهو مَهُوب",79,"ب",1,0],["وهو بالاحكام قاضي عصره","وإمام الأذكياء النجبا",80,"ب",2,0],["وهو بالحزم شاد بيت فخار","فوق هام المها وأعلى قبابه",81,"ب",2,0],["وهْوَ بنُ سُلْطَانٍ به كَرُمَتْ","أنسابُهُ مِنْ أَعْظُمٍ وَدَمِ",82,"م",1,0],["وَهوَ بُعَيدَ طَالعِ الجزيرَه","وبينهم طريقُ فيها الخيرَه",83,"ه",1,0],["وَهوَ بِهَا في مُستَقَلِّ المِرزَمِ","سَبعٌ وَنِصفٌ عِندَ كُلِّ الأُمَمِ",84,"م",1,0],["وَهوَ بِكُوري نالَ يا حبيبي","ثلاثةٌ ونصفُ بالتجريبِ",84,"ب",1,0],["وَهوَ بأنزَلنَا مَعَ مَهَارِ","ثَمَانِيَه وَنِصفُ لا تُمَارِ",84,"ر",1,0],["وَهُوَ بن بيك العُلا علوي أَجل أَب","حازَ المَعالي وَقَد دامَت بِهِ أَبَدا",85,"د",2,0],["وهو باب الفقر والمحل إذا","أهمل المحراث والأرض خلت",86,"ت",1,0],["وهو بدر له الفضائل افق","وهزبر له الأراجيز غاب",87,"ب",1,0],["وهو بدر بسناه","ليل داجى الشعر أقمر",88,"ر",1,0],["وهو بالذات إن تؤرخ بهيج","رق طبعاً وراق في حسن شكله",89,"ل",2,0],["وهو بها لو لم يكن متصفا","لكان بالأضداد منها اتصفا",90,"ف",2,0],["وهو بالبدر السني من وجهه","والجبين الصبح ذو النورين",91,"ن",1,0],["وهوب إذا استر فدت إحدى هباته","أتتك ثبا ملء الفجاج مواهبه",92,"ب",2,0],["وهو برغم المكرمات فقل هوى","من شامخ العلياء طودٌ امنعُ",93,"ع",1,0],["وَهْو بوحُ الرمادِ قبضُ حواشِي","هِ سكونٌ ومسُّ جنبيه جَمر",94,"ر",1,0],["وهو بشِعرِ ابن الزبعري ينطقُ","وهو لأمر كفره مصدق",95,"ق",1,0],["وهوَ بحِجر عمهِ رماهُ","حَرمَلَةٌ سهماً به أرداهُ",96,"ه",1,0],["وهوبٌ فما تَسْلَون إلا بمنةٍ","فقد عرفوا من أجله المنَّ والسلوى",97,"و",2,0],["وهو بليل المشكل السراجُ","للعدل في أقطارها ابتلاجُ",98,"ج",1,0],["وَهوَ بِسَبقٍ حَائِزٌ تَفضِيلاً","مُستَوجِبٌ ثَنَائِىَ الجَمِيلاَ",99,"ل",2,0],["وَهوَ بِما يَعَمَلُ فِيهِ مُتَّحِد","وَقَتاً وَفَاعِلا وَإن شَرطٌ فُقِد",99,"د",1,0],["وهو بيت عند المهيمن ضاهى","شأنه شان بيته المعمور",100,"ر",1,0],["وهو باب الله من لاذ به","أدرك الحسنى ونال الدرجات",101,"ت",1,0],["وَهوَ بر بِالأَنام رؤوفٌ","وَهوَ نور إِن دجت ظلماء",102,"ا",2,0],["وهو بالجم الغفير كاف","وبالجماهير بلا خلاف",103,"ف",1,0],["وهو بد ران تجلي مسفراً","وهلال إن يكن أرخى اللثاما",104,"م",2,0],["وهو بأن يلحظ امر يعقل","لكسب مجهول بذاك يحصل",105,"ل",1,0],["وَهوَ بِصَدرِ جَيشِهِ يَثورُ","بِشِدَّةِ البَأسِ بِهِم يَسيرُ",106,"ر",1,0],["وَهوَ بِمَركَبَتِهِ مُحتَدِمُ","كَتائِبَ الفِتيانِ حَطماً يَحطِمُ",106,"م",1,0],["وهو بين الزهورِ عصرُ افتخار","مثل عصر العباس في الأعصارِ",107,"ر",1,0],["وهو بفاس وهي أم الامصار","مستعملٌ في ليلها وفي النهار",108,"ر",1,0],["وهو بحفظه لنا عن الأذى","لقد سما على العدى مستحوذا",109,"ذ",2,0],["وهو بلا رأس فتبدي صرخة","منها جميع العالمين تذهل",110,"ل",1,0],["وهو بالحزمِ مُدرِكٌ كلَّ سُؤلٍ","ولَعَمْري كم حازماً رامَ حازِمْ",111,"م",1,0],["وهو بحر للعلم بر بأهل ال","فضل طود للحلم جم الحصاة",112,"ه",1,0],["وهو به إلى النبي وصلا","بعشرةٍ من الشيوخ كملا",113,"ل",2,0],["وهو بابٌ لرحمةِ الله يؤتَى","يرغب الناس فيه والأنبياء",114,"ا",2,0],["وَهُوَ بَيت لشاعر من بني مخ","زوم أضنت فُؤَاده أَسمَاء",115,"ا",2,0],["وهو بالتقتير ما ش","ق له وصف غبارا",116,"ر",2,0],["وهو بالأمس واهب القائد الغربي","زلفى اليه سيف النضار",117,"ر",1,0],["وهوبالأمس من حبا لندن الشوهاء","ما شاء منه حب الفخار",117,"ر",1,0],["وهو بنص إنما وليكم","ولي كل مؤمن ومسلم",118,"م",1,0],["وهو بين الأنام واسطة في","كل خير وللحجاب أزالا",119,"ل",2,0],["وهوب إذا ما النجم أخلف نوءه","وقور إذا ما طاش من حادث رضوى",120,"و",2,0]]}