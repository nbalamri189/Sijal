{"poems":[[66,"أما والذي لدمي حللا","https://www.aldiwan.net/poem67550.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[147,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[236,"أبا صالح ما العيش بعدك صالح","https://www.aldiwan.net/poem44572.html","الطويل"],[275,"لئن ذبلت كالزهر يوما قريحتي","https://www.aldiwan.net/poem35607.html","الطويل"],[287,"لئن ذم قوم ثقل أرواحنا الذي","https://www.aldiwan.net/poem32695.html","الطويل"],[290,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[371,"لك المثل الأعلى ومالك من مثل","https://www.aldiwan.net/poem17244.html","الطويل"],[422,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[447,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[466,"لئن ذاد مدحي بأس عذر فانني","https://www.aldiwan.net/poem15485.html","الطويل"],[469,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[572,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37900","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138137",""],[2276,"","https://poetry.dctabudhabi.ae/diwan/poem/144887","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100893","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100493","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109781","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205759","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45960","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""]],"verses":[["لَئِن ذُقتُ فيكَ كُؤوسَ الحِمام","لَما قَالَ قَلبي لِساقَيهِ لا",0,"ل",2,0],["لئن ذهب الشعر الجَميل مضيعاً","فمن ذا عَن الشعر الجَميل يعوض",1,"ض",1,0],["لَئِن ذُدتَ عَنها كُلَّ ذي شَغَفٍ بِها","فَلا غَروَ أَن تَحمي عَرائِنَها الأُسدُ",2,"د",1,0],["لئن ذقت كأساً ذاقها أحمد الرضا","وقد ذاقها من قبل هود وصالح",3,"ح",1,0],["لئن ذبلت كالزَّهرِ يوماً قَريحتي","وقد فَنيَت من كثرةِ الحبِّ مُهجتي",4,"ي",1,1],["لَئِن ذَمَّ قَومٌ ثِقلَ أَرواحِنا الَّذي","بِهِ يَومَ سبتٍ خَرَّ مِن تَحتِنا السَقفُ",5,"ف",1,1],["لينذروا قومهم اذ يرجعوا فيرى","آنا فانا بهم بدر الرقي سرى",6,"ر",2,0],["لَئِن ذَكَروا الفَضلَ بنَ يَحيى بنَ خالِدٍ","فَإِنَّكَ قَد أَنسَيتَنا الفَضلَ بِالفَضلِ",7,"ل",1,0],["لئنْ ذهبت أوائلنا ذهاباً","فأَوَّلُنا وآخرنا سواء",8,"ا",2,0],["لئن ذكروا في الجود كعباً وحاتماً","فأنت لهذا العصر كعب وحاتم",9,"م",1,0],["لئن ذكرت منها رواحاً ومغتدى","ومسرحها في ظل أحوى مذنب",10,"ب",1,0],["لئن ذاد مدحي بأسُ عُذرٍ فانني","بقلبي أجْراً من لساني وأنْطقُ",11,"ق",1,1],["لئن ذهب البين المشت بشخصه","فما ذكره من كل شعب بذاهب",12,"ب",1,0],["لئن ذَلَّ فيه عزيزُ الدُّمُوعِ","لَقَدْ عَزّ فِيْهِ ذَلِيْلُ العَزَاءِ",13,"ا",2,0],["لَئِن ذَمَّ حُسّادي كِرامَ طَبائِعي","فَقَد أَظهَروا طِيبَ المَكارِمِ مِن خُلقي",14,"ي",1,1],["لئن ذكر الناس الإمام وفضله","على مصر لما قام فيها مجدِّدا",15,"د",2,1],["لئن ذهبت أيام لذتنا الأولى","بذي الأسل ما وجدي عليها بذاهب",16,"ب",1,1],["لئن ذقتَ خمراً أنت تدري بطمعها","فذق خمرةَ الموتالتى لم تكن تدري",17,"ر",2,0],["لئن ذاب جسمي لوعةً واستحال من","جوى الحزن معاها ميا ليس يجحد",18,"د",1,0],["لئن ذبلت جناتكم من ودادنا","فجناتنا اوراقها ابداً خضر",19,"ر",1,0],["لئن ذكر الوافون عهد ولائه","لما ذكروا إلَّا الوفيَّ المهذَّبا",20,"ب",2,0],["لَئِن ذُمَّ مِن حالِنا عَجَلَةْ","فَفي تِسعَةٍ عَجَلَةٌ لا تُذَمْ",21,"م",1,1],["لئن ذخرت عقداً إلى صدرها العلى","فأنت إلى صدر العلى ذلك العقد",22,"د",1,0],["لئن ذبلت منها رياض أنيقة","ففي قلبه روض من الوجد مونق",23,"ق",1,0],["لِينْذروا الأَنَامَ مَوعِدَهمْ","يومَ اللِّقاءِ العَدلِ والحَسَمِ",24,"م",1,0]]}