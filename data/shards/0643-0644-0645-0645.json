{"poems":[[95,"يفسح الراحلون للقادمينا","https://www.aldiwan.net/poem11170.html","الخفيف"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83129","الكامل"],[5121,"جِنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=211403",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""]],"verses":[["كَلِمٌ مِنْ تَخَطُّفِ البَرْقِ يَسْبِقْ","نَ إِلَى مَوْقِعِ الجَمَالِ الظُّنُونَا",0,"ن",2,0],["كل ممطور بجدواك انبرى","يكثر الحمد عداد العثير",1,"ر",1,0],["كلَمٌ مِن السِحرِ الحَلالِ تَأَلَّفَت","يَعبَثنَ بِالأَلبابِ وَالأَسماعِ",2,"ع",1,0],["كلم من كل لفظ مجتلى","هوَ في السمع كقرطي ماريه",3,"ه",1,0],["كَلِمٌ مردَّدَةٌ إِذا ما مَجَّها","سمعُ الكَريم أَعادَها مُبديها",4,"ي",3,0],["كلِمٌ منه الحيارى سقطوا","وسُكارى الحرفِ خرّوا في الرّغَدْ",5,"د",1,0],["كلّ ممكن زهدته في رجا المستحيل","قلت آباطول نجمة ما حدٍ طالها",6,"ل",3,1]]}