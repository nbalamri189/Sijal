{"poems":[[90,"هي المنى كثغور الغيد تبتسم","https://www.aldiwan.net/poem44833.html","البسيط"],[93,"لي صاحب دخل الغرور فؤاده","https://www.aldiwan.net/poem8722.html","عموديه"],[71,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[48,"قد بدل العالم عاداتهم","https://www.aldiwan.net/poem23184.html","السريع"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[242,"شرذمة مأبونه","https://www.aldiwan.net/poem19102.html","مجزوء الرجز"],[266,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[266,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[358,"يا من رماه زمانه بعنائه","https://www.aldiwan.net/poem40174.html","الكامل"],[443,"قل لزين الكفاة يا ذا الذي فاق","https://www.aldiwan.net/poem2617.html","الخفيف"],[563,"ما الكل إلا رجل واحد","https://www.aldiwan.net/poem34649.html","السريع"],[578,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138210",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138203",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122676","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77579","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77536","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77533","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77509","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77501","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77473","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/131354","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55983","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108634","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132239","السريع"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114755","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124714","البسيط"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198423","السريع"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138764",""],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85083","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114009","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83550","السريع"],[5050,"قل للذي ترك العلى","https://www.poetsgate.com/ViewPoem.aspx?id=38201",""],[5302,"قلبي شكا بعدا","https://www.poetsgate.com/ViewPoem.aspx?id=215932",""],[5431,"يارب دينك بالغلاة تشوّها...","https://www.poetsgate.com/ViewPoem.aspx?id=212717",""],[5461,"كيف ننسى الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=5293",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5841,"بالقوافي وهمسها وعذب الخواطر والفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=34910",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[6093,"ذات موصدة","https://www.poetsgate.com/ViewPoem.aspx?id=204990",""]],"verses":[["والعجز كالجهل في الأزمان قاطبةً","داءٌ تموت به أو تُمسخ الأمم",0,"م",1,0],["وَالعُجبُ داءٌ لا يَنالُ دَواءَهُ","حَتّى يَنالَ الخُلدَ في الدُنياءِ",1,"ا",2,0],["والعجزُ أوجبَ لي سلبَ الخمول ولو","شلْتُ الحمول مع الركبانِ لم أجبِ",2,"ب",1,0],["وَالعُجبُ داءٌ قاتِلٌ أَهلَهُ","يُمانِعُ الأَستارَ أَن تُسدَلا",3,"ل",2,0],["والعجب أظهر عاصماً ومحله","من دون بسطام على بسطام",4,"م",1,0],["وَالعجمُ خيرهمُ الّذي قَد قلّدا","وَهُناكَ حِزبٌ للجحيمِ تولّدا",5,"د",2,0],["وَالْعُجْبُ يَتْلُو نَحْوَهَا","مِنَ الْغَبَا فُنونَهْ",6,"ن",2,0],["والعجز يدرك في صفاتك وصفها","في كل فضل ممكن احصاؤه",7,"ا",3,0],["والعجز في طلب المنيع ومرتقى","الصعب الرفيع ونيل حظ اوفر",8,"ر",1,0],["وَالْعَجْزُ أَنْ أَتْرُكَ الأُوْطارِ مُقْبِلَةً","حتّى إِذا أَدْبَرَتْ حاوَلْتُها طَلَبا",9,"ب",2,0],["وَالعَجزُ أَوجَبَ لي ذُلَّ الخُمولِ وَلَو","أَنّي تَنَقَّلتُ كانَ العِزُّ في النُّقَلِ",10,"ل",1,0],["وَالعَجزُ أَوجَبَ لي الخُمولَ وَقَد أَرى","بابَ الغِنى فَتحاً فَلم لا أَدخُلُ",11,"ل",1,0],["والعجمي المستجاب وعتبة","نعم الشهيد بنية وبمضجع",12,"ع",1,0],["وَالعَجز عُذري عَن مَديحك سَيّدي","فاِجبر بِفَضلك كَسر قَلب العاجزِ",13,"ز",1,0],["والعجيب العجاب أنك تسدي","عند تسويرها برا بيضاء",14,"ا",2,0],["والعجز عن خلاقه حطه","فيما ترى من أمرك الشاهد",15,"د",1,0],["وَالعَجزُ أَن يُرجى سِواكَ وَإِنَّما","أَخشى نَباتَ الرَوضَةِ المُتَخَلِّسا",16,"س",2,0],["والعجب أدنى خلة وأخو الحجي","لكماله لم يرض نقصاً عائبا",17,"ب",2,0],["والعجب من شيم الحسان وإنما","هذا التشامخ عند ميّ مجتنب",18,"ب",1,0],["والعَجزُ ما يَتَنَجَّمُ المُتَنَجِّمُ ال","عافي وما يَتَعَيَّفُ المُتَعَيِّفُ",19,"ف",1,0],["وَالعَجلات اِنغَرَسَت في الطين","وَلَم يَرَ السَواق مِن مُعينِ",20,"ن",1,0],["وَالعَجَلات فَاِنض عَنها الوَحلا","وَعَن ظُهور الخَيلِ خِفّ الرحلا",20,"ل",2,0],["وَالعجلُ ذو قرنَين بارِزين","وَالفيلُ ضَخم الرَأس وَاليَدَين",21,"ن",1,0],["وَالعجل وَالذئب عَلى عَذابه","هَذا بقرنيه وَذا بِنابه",22,"ه",1,0],["وَالعجلات خُضنَ في التراب","وَنزل البَعض مِن الركاب",23,"ب",1,0],["وَالعجل وَالدرفيل وَالجاموسه","ترينهم مِن فَوق كَالناموسه",24,"ه",1,0],["وَالعَجز في هَذا المقام عَذري","وَالخَوف أَصماني فلَستُ أَدري",25,"ي",1,0],["والعجم صلّت عليه جهرا","بألسن فصح جراد",26,"د",1,0],["والعجْزُ والتَّقْصيرُ قُصْراهُ سوى","أنَّ الذي يَقُوله جَهْدُ المُقِلْ",27,"ل",1,0],["والعجز يأسر جانحيَّ فإن أطف","طوفَ النسائم لا أحط بهباتهِ",28,"ت",2,0],["والعجاجيل كالفراخ بغاها","بكءُ أماتها العجاف هزالا",29,"ل",2,0],["والعجم من ذا البيت ثم الهمل في","كل ترى التاريخ وافى يندرُ",30,"ر",1,0],["والعجز عن تعداد فضلك ظاهرٌ","فاعذر فتى عد النجوم فقصرا",31,"ر",2,0],["والعجب العجاب تكوين ذا","مجتمع في شادن ناهد",32,"د",1,0],["والعجزُ أن طالت يَدِي","وتَقاصَرَت لابن المراغَه",33,"غ",2,0],["والعجز ذنبي لا عدول","عن أخ البر الوصول",34,"ل",1,0],["والعُجب ما استل من رأيٍ إذا التحمت","عرى الخطوب وأمر الأمة ارتبكا",35,"ك",2,0],["والعجب والنوك إلى الجهل في","أكثرهم إلا مع الندره",36,"ر",2,0],["وَالعَجِيبُ العَجِيبُ أنَّا نَرَاهَا","مُرَّةَ الطَّعمِ حُلوَةً فِي المَذَاقِ",37,"ق",1,0],["والعجمي الشيخ ابراهيم","في الصحن من جامعها مقيم",38,"م",1,0],["والعجز إما ككون الخصم أكثر من","مثليه أو إن تراه حالف العللا",39,"ل",2,0],["وَالعَجُزَ احذِف مِن مُرَكَّبٍ وَقَلَّ","تَرخِيمُ جُملَةٍ وَذَا عَمروَ نَقَل",40,"ل",1,0],["وَالعَجَمِىُّ الوَضعِ وَالتَّعرِيفِ مَع","زَيدٍ عَلَى الثَّلاَثِ صَرفُهُ امتَنَع",40,"ع",1,0],["وَالعجب عمّ فكل فَردٍ معجبٌ","بِالنَفس راقَت عِندَهُ الأَسواء",41,"ا",2,0],["والعجيب الحياة من بعد بعدي","عن حبيبي مع أنني لست جلدا",42,"د",2,0],["والعِجَالَ اصففَُن أَمامَ السَّفِينِ","ثُمَّ في الصَّدرِ أَورِ نارَ المَنُونِ",43,"ن",1,0],["وَالعُجبَ والغِيبَةَ وَالرِّيَاء","وَاطِّرِحَن فَخراً وَكِبرِيَاءَ",44,"ا",2,0],["والعُجبُ داءٌ كبير من بُليَّ به","يمتازُ وسماً له بأفحشِ العِلل",45,"ل",1,0],["والعجز عكسه والمشرك عمى","فله عن برهان هذا الدليل",46,"ل",1,0],["وَالعَجزُ قَد أَقعَدَني كُلَّما","فَكرت أَن أَنهَضَ من ذا الرقاد",47,"د",1,0],["والعجز أن تذر الذي","يأتي لما لم يحصلا",48,"ل",2,0],["والعجب كل العجب في شادن","علمني شيئا وعلمته",49,"ت",2,0],["والعجل عاد على الجموع مؤّلها","والفحل ياللبغل إمّا ولّها",50,"ه",2,0],["والعجل من أثر الرسول مخلّقٌ","والعقل عند بهيمة لا يُشتهى",50,"ه",2,0],["والعجوز الذي جندك رماها","وش سبب ذبحة النفس البريه",51,"ي",2,0],["والعِجْل واجْتنبوا وأخرجََ شطاهُ","والرجز مل الرجُسَ في التِبيان",52,"ن",1,0],["والعجب يوم اذكرك من داخلي ابكي واصيح","كيف انا ارضى بذلٍ من بنيه هو طفى",53,"ف",2,0],["والعجز في عينيك مشتعل","والناس من لاهٍ ومنشغلِ",54,"ل",1,0],["والعُجْبُ صومعةٌ يَضلُّ بها الفتى","والكِبْرُ حادٍ مَنْ حدا بهِ أَبْعدَهْ",55,"د",2,0]]}