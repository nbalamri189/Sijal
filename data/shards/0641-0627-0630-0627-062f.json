"https://www.poetsgate.com/ViewPoem.aspx?id=201626",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[5136,"قل إذا ألمت أزمة بك يا هو","https://www.poetsgate.com/ViewPoem.aspx?id=121767",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5232,"صرخةُ الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=213092",""],[5277,"من أوراقِ عاشقٍ كرخيّ","https://www.poetsgate.com/ViewPoem.aspx?id=186552",""],[5284,"المُبعدون","https://www.poetsgate.com/ViewPoem.aspx?id=205895",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[402,"يا عائدا برعاية الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=36542",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[6019,"أبها حكايةٌ لا ينضب جمالها","https://www.poetsgate.com/ViewPoem.aspx?id=193223",""],[6031,"طاب الحواف وطاب ريح شواه","https://www.poetsgate.com/ViewPoem.aspx?id=46415",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6225,"سيناءُ مِنّا ولنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81034&r=&rc=271",""],[6227,"عَذِّبْ كما تهوى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87073&r=&rc=16",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""],[5190,"فاض الكيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78342&r=&rc=55",""],[5190,"الناس صنفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78332&r=&rc=45",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["فَإِذا دَعَوتُ الدَمعَ فَاِستَعصى بَكَت","عَنّا أَسىً حَتّى تَغَصَّ وَتَشرَقا",0,"ق",2,0],["فَإِذا دَعَوتُ لَهُ فَلَستُ أَزيدُهُ","فَإِنِ اِستُجيبَ دُعايَ فَهوَ الخالِدُ",1,"د",1,0],["فَإِذَا دَنَا خَالُوهُ عَرْشاً قَائِماً","شَدَّتْهُ أَمْلاكٌ بِلا أَشْطَانِ",2,"ن",1,0],["فإذا دعتهم للوغى أوطانهم","كانوا الكُماة الشُوس من أبطالها",3,"ل",3,0],["فإذا دَلَّ جاء بالحُجّةِ الغَر","رَاء ذاتِ المعالم الغراءِ",4,"ا",2,0],["فإذا دنا أنأى أخا كَلَفٍ","وإذا نأى أدناه مضجعه",5,"ع",2,0],["فإذا دَنا جعلَ الزِّيارَةَ شأنَه","وإذا نأى بعثَ الخَيالَ الطَّارِقا",6,"ق",2,0],["فَإِذا دَعَتكَ إِلى الخَطيئةِ شَهوَةٌ","فَاِجعَل لِطَرفِكَ في السَماءِ سَبيلا",7,"ل",2,0],["فَإِذا دَعا الدَهرَ العَبوسَ أَجابَهُ","مُتَعَثِّراً بِالرُعبِ في أَذيالِهِ",8,"ل",2,0],["فَإِذا دارَتِ الزُجا","جَةُ خُذها وَأَعطِني",9,"ن",2,0],["فَإِذَا دَعَوْتُ بِصَاحِبٍ لَمْ يَلْتَفِتْ","وَإِذَا لَجَأْتُ إِلَى أَخٍ لَمْ يَنْفَعِ",10,"ع",1,0],["فَإِذَا دَنَتْ مِنَّا فَتِلْكَ عَوَالِمٌ","وَإِذَا نَأَتْ عَنَّا فَتِلْكَ لآلِي",11,"ل",2,0],["فَإِذَا دَنَا فَالشَّمْسُ قَدْ غَرَبَتْ","وَطَفا عَلى وَجْهِ الطِّلى قَمَرُ",12,"ر",1,0],["فإِذَا دَعَا دَاعِي الْفِدَاءِ فَإِنَّهُ","يَقْضِيهِ أَوْ يَقْضِي شَهِيدَ الْوَاجِبِ",13,"ب",1,0],["فإذا دَفَعْتَ، سمعتَ ما","قال ابنُ هانئَ في الرشيد",14,"د",1,0],["فإذا دعا داعي العروبة في غدٍ","حاربتُ جنديَّا بجيش «صلاح»",15,"ح",1,0],["فإذا دُعوا للحرب، هبوا، أو دعوا","للمال، عفُّوا عنه أيَّ عفاف",16,"ف",1,0],["فإذا دربنا رياض تغنّي","في السنا والهوى زجاجات عطر",17,"ر",1,0],["فإذا دَمعي يَسْقي خَدًّا","حينَ أغيبُ يُعَذِّبُني",18,"ن",2,0],["فاذا دُعيتِ الى الدُخول","فبأيِّ عينٍ تَدخُلين",19,"ن",1,0],["فَإِذا دَعَوا وَتَضَرَّعوا لَم يَسأَلوا","إِلّا إِدامَةَ عِزِّ ذا السُلطانِ",20,"ن",1,0],["فإذا دنوت فمرحباً","وإذا نأيت فبالسَّلامه",21,"م",2,0],["فَإِذا دَعاكَ العَيْشُ في خَلَساتِهِ","فَارْكُضْ إِلَيْهِ في الرَّعِيلِ الأَوَّلِ",22,"ل",1,0],["فإذا دعوتهم مشوا هزؤا","مشيَ النعام أهميف فاجتلدا",23,"د",2,0],["فَإِذا دَهتهُ صَواعِق ال","أَيّامِ رُعباً تقشعِرُّ",24,"ر",1,0],["فإذا دارتْ رَحَى السَّعْدِ على","مَنْ رأَى وجهَك أو من سمِعك",25,"ك",1,0],["فَإِذا دَنَت بِجُفونِها","وَإِذا نَأَت بِجَفائِها",26,"ا",3,0],["فاذا دَنَت أَعلام مكة منك أَو","ميقاتها أَحرمت فيمن أَحرما",27,"م",2,0],["فإذا دعا هاروتها","قلباً لبيباً نحوها لباه",28,"ا",2,0],["فإذا دعاه لمجلسٍ ندماؤُهُ","يأتى ويجلس فيه بالقانون",29,"ن",1,0],["فَإِذا دَنا وَقتُ المَشيبِ فَخَلِّهِ","وَالشَيبُ يذهَبُ فيهِ كُلَّ ذَهابِ",30,"ب",1,0],["فإذا دنا فجَع الغزالَ بأُمّه","وإذا رنا خطفَ الظّليمَ المُجْفِلا",31,"ل",2,0],["فإذا دنت في سيرها من زهرة","همت بأخذ ذيولها وبلثمها",32,"م",3,0],["فإذا دَنَتْ منها وديقَةُ جاحِدٍ","رفَعَ الإِمامُ لَها سَحابَةَ وابِلِ",33,"ل",1,0],["فَإِذا دَعَوا بِأَبي رَبيعَةَ أَقبَلوا","بِكَتائِبِ دونَ النِساءِ تَلَمَّموا",34,"م",3,0],["فإذا دجا الليل البهيم ولم تجد","لك ملجأ من ظلمه وظلامه",35,"م",2,0],["فإذا دندن الرباب أجابت","نغمة الدف فاستقر العناء",36,"ا",2,0],["فإذا دُعى بابي الصلاح فانما","ليست مبالغة فهذا الواقع",37,"ع",1,0],["فإذا دعوت سواك حاد عن اسمه","ودعاه باسمك مقولٌ بك مغرم",38,"م",1,0],["فَإِذا دَخَلتُ مُسلماً","حَيّي وَبشَّ مُسلّما",39,"م",2,0],["فإذا دعا داعي الجفاء أزاله","متفانياً وكأنما هو ناسي",40,"س",2,0],["فإذا دمعة تغيم بعينيك","وتهمي براقة الامال",41,"ل",1,0],["فإذا دعت أم العلى أبناءها","لسوابق سكت الورى وأجابها",42,"ب",3,0],["فإذا دعوت فإنما","أدعو لتحيَ المطبعه",43,"ع",2,0],["فإذا دجا ليلُ الخطوب فلقته","من ضوء صبح جبينه بعمود",44,"د",1,0],["فإذا دهتها الحادثات وأسكتت","خفقاتها فيظل قلبي يخفق",45,"ق",1,0],["فإذا دانيتَ ذاك المنحنى","فتحذّر أن تدانى الكُثُبا",46,"ب",2,0],["فإذا دعوت بأحمد في خطّة","فكأنّما ناديتَ إسماعيلا",47,"ل",2,0],["فإذَا دَنَت أَعلاَمُ طَيبَةَ فانزِلَن","وَتَرَجَّلَن وَاسكُب لِدَمعِكَ وَاذرُفَا",48,"ف",2,0],["فإِذَا دَنا مِنَّا الحِمَامُ تَوَفَّنا","فَضلاً على حُسنِ الخِتَامِ بِلا ذَعَر",49,"ر",1,0],["فإذا دَنوا يَبكي مخافاتِ النَوى","وإذا نأوا شوقاً لَهُم يَستعبِرُ",50,"ر",1,0],["فإذا دنوتُ فحكمه مقبوله","لكن لها قلب العلي يتصدع",51,"ع",1,0],["فَإذَا دَعوكَ لغَيرِ حُكمِهمَا فَلا","سَمعاً لِدَاعِي الكُفرِ والعِصيانِ",52,"ن",1,0],["فَإذَا دَعَونَا لِلقُرآنِ دَعَوتُمُ","لِلرَّأيِ أينَ الرَّأيُ مِن قُرآنِ",52,"ن",1,0],["فإذا دنَوتَ مواصلاً فهو المنى","سعدَ المحِبُّ وساعدَ الأحبابُ",53,"ب",1,0],["فاذا دنت شهب السنين فمن","فيه يغاث الناس ان سأَلوا",54,"ل",3,0],["فإذا دجا خطب يفرجه","عن وجهه اراؤه الزهر",55,"ر",1,0],["فَإِذا دَعاني الداعِيانِ تَأَيَّدا","وَإِذا أُحاوِلُ شَوكَتي لَم أُبصِرِ",56,"ر",1,0