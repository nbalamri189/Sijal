{"poems":[[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[74,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[53,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[34,"إلى القرم الذي كانت يداه","https://www.aldiwan.net/poem27736.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[9,"أثوى ، قصّرَ ليلة ً ليزوَّدا،","https://www.poetsgate.com/ViewPoem.aspx?id=20031",""],[20,"ماذا ترجون إِن أَودى ربيعكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69775&r=&rc=16",""],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[208,"كل أيامك هجر","https://www.aldiwan.net/poem53094.html","مجزوء الرمل"],[215,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[215,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[285,"كم سما لي بحسن رأيك جد","https://www.aldiwan.net/poem60696.html","البسيط"],[331,"بقاء الدين والدنيا جميعا","https://www.aldiwan.net/poem44275.html","الوافر"],[342,"كلا يومي طوالة وصل أروى","https://www.aldiwan.net/poem45418.html","الوافر"],[484,"هذي البداية ما لها من ثان","https://www.aldiwan.net/poem37038.html","الكامل"],[505,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199810","المسحوب"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105674","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66449","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205716",""],[5127,"وقفتْ ومدمعُها على اﻷجفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=177316",""],[5638,"طريق الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=200123",""],[5973,"عام بانسيه ٍ ليس يمضي حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=13764",""]],"verses":[["كَلّا يَمينَ اللَهِ حَتّى تُنزِلوا","مِن رَأسِ شاهِقَةٍ إِلَينا الأَسوَدا",0,"د",2,0],["كِلا يَومَيهِ بِالمَعروفِ طَلقٌ","وَكُلُّ فَعالِهِ حَسَنٌ جَميلُ",1,"ل",1,0],["كِلا يَومي أُمامَةَ يَومُ صِدقٍ","وَإِن لَم تَأتِها إِلّا لِماما",2,"م",2,0],["كلّ أيَّامنا مواسمُ فضلٍ","في ذرى بابه وأعياد فطر",3,"ر",1,0],["كلُّ أيامِك يومٌ","فيه شَمْسٌ وغَمامُ",4,"م",1,0],["كِلا يَومَيهِ بِالمَعروفِ طَلقٌ","وَكُلُّ بِلائِهِ حَسَنٌ جَميلُ",5,"ل",1,0],["كلائحةِ الباغي المُضِلّ رأى ضُحىً","شَذاً من سَرابٍ في مَهامِهَ أغفال",6,"ل",1,0],["كَلاَّ يميناً بذاتِ الوَدعِ لو حَدَثَت","فيكُم وقابَلَ قَبرُ الماجِدِ الزَّارا",7,"ر",2,0],["كُلُّ آيَاتِ نُبْلِهَا صَادِرَاتٌ","عَنْ تَمَامِ الْحِجَى وَرِفْقِ الْفُؤَادِ",8,"د",1,0],["كلاّ يمينَ اللهِ حتى تنزلوا","منْ رأسِ شاهقة ٍ إلينا لأسوادا",9,"د",2,0],["كَلّا يَميناً بِذاتِ الوَرعِ لَو حَدَثَت","فيكُم وَقابَلَ قَبرُ الماجِدِ الزارا",10,"ر",2,0],["كلُّ آيِ الرسلِ من آياتهِ","قَد رَأى ذلكَ أربابُ العقول",11,"ل",1,0],["كلُّ أيّامِكَ هَجرُ","ونصيبي منك غَدرُ",12,"ر",1,1],["كل أيامي كروبٌ في كروب","وأعاصير من القلب الطروب",13,"ب",1,0],["كل أيامي جمالٌ في جمال","حين يصبى مهجتي ذاك الغزال",14,"ل",1,0],["كُلُّ أَيّامِ حُبِّكَ الْجُودَ وَصْلٌ","مُسْتَمِرٌّ وَالْحُبُّ وَصْلٌ وَصَدُّ",15,"د",1,0],["كِلا يَومَيكَ مِن نَفعٍ وَضَرٍّ","يَحوطُ حِماهُما كَرَمٌ وَخَيرُ",16,"ر",1,0],["كِلا يَومَي طُوالَةَ وَصلُ أَروى","ظَنونٌ آنَ مَطَّرَحُ الظَنونِ",17,"ن",1,1],["كل إياسٌ في الذكاء وكلهم","قس الفصاحة جاء بالبرهان",18,"ن",1,0],["كلُّ أيامي لحبي ولهٌ","ولياليَّ عليه حرقُ",19,"ق",1,0],["كُلَ أيامي بِدَولَتِكُم","جُمَعٌ غُرُّ وأعراس",20,"س",1,0],["كل آي أتت بكل كتابٍ","كان فيما ترومه مثناها",21,"ا",3,0],["كَلا يَوميه في جودٍ وَبَأسٍ","حَميد السَعي مرضيّ المقام",22,"م",1,0],["كل ايعبر صفاته حد تعبيره","كالغيث والليث في جوده ومشواحه",23,"ه",1,0],["كل أيامك يا عصر الصبا","لم أكن أحسبها من عمري",24,"ر",2,0],["كلائم أهل الحبّ لوماً نشي به","فأضحت بجنبيه تدبّ عقاربه",25,"ب",2,0],["كُلُّ أيامنا تسا","وين في الوسم والعدد",26,"د",1,0],["كُلَّاً يريدُ وصالكَ لو لحظةً","قد قُيدوا ذُللاً بغيرِ عنانِ",27,"ن",1,0],["كُلُّ أَيَّامِي صِرَاعٌ ثَائِرٌ","فَالْفَتَى يَحْيَا دَنِيًّا أَوْ أبِيَّا",28,"ي",2,0],["كل أيامه الشهية عندي","مثل أيام العيد عند الشعوب",29,"ب",1,0]]}