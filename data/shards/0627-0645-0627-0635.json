{"poems":[[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[88,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[27,"أما صبير فإن قلوا وإن لؤموا","https://www.aldiwan.net/poem5667.html","البسيط"],[47,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[124,"يا شيخ أَين من الخريف ربيع","https://www.aldiwan.net/poem23715.html","الكامل"],[132,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[143,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[364,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[416,"حلفت بتربة آبائها","https://www.aldiwan.net/poem53891.html","المتقارب"],[468,"الغيم يبسط في السماء ويفرش","https://www.aldiwan.net/poem59930.html","الكامل"],[551,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[551,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"]],"verses":[["أمّا صَلاةُ صِلاتِهِ فهيَ التِي","قدْ جلّ فيها عنْ مَقامِ السّاهي",0,"ي",1,0],["إمّا صهَلَتْ في أرْضِ عِدىً","فغُرابُ البَيْنِ بهِمْ نَعَقا",1,"ق",2,0],["أم أصختم إلى الأغاريد كي لا","تسموا كيف تنحب الأيتام",2,"م",1,0],["أَمّا صُبَيرٌ فَإِن قَلّوا وَإِن لَؤُموا","فَلَستُ هاجِيَهُم ما حَنَّتِ النيبُ",3,"ب",1,1],["أَما صاحِبٌ فَردٌ يَدومُ وَفاؤُهُ","فَيُصفي لِمَن أَصفى وَيَرعى لِمَن رَعى",4,"ع",2,0],["أَمَّا صَرِيعُ الحَرْبِ مِنْ جُنْدنا","فَرَابِطٌ مَهْما يُسَمْ يَصْبِرِ",5,"ر",1,0],["إما صبوت اليوم قيل لعمركم","يا ناس تهيام الشيوخ فظيع",6,"ع",1,0],["أَم أصبَحَت يُنكِرُ آيَاتِهَا","مَن لَم يَكُن لِلاىِ بالعَارِفِ",7,"ف",1,0],["أَم أَصارَ السُمُوَّ قِسمَكَ مَن عَل","لَمَ مِن قَبلُ آدَمَ الأَسماءَ",8,"ا",2,0],["إمّا صديقٌ لستُ أُنصِفُه","أنا أو صَديقٌ ليس يُنْصِفُني",9,"ي",1,0],["أما صحّ عندك قول الوشاة","فماذا التجافي وماذا التغالي",10,"ي",1,0],["أَما صَنائِفُ ذا فَيَضحَكُ رَقمُها","فيهِ وَأَمّا طَرزُ ذاكَ فَتُنعَشُ",11,"ش",1,0],["إمّا صديقٌ كالعدوِّ تقاعداً","عن نصرتي أو فالعدوّ المُحْنَقُ",12,"ق",1,0],["إمّا صروفٌ مقبلا","تٌ أو صروفٌ مُدبِراتُ",13,"ت",1,0]]}