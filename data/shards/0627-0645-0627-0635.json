{"poems":[[79,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[90,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[29,"أما صبير فإن قلوا وإن لؤموا","https://www.aldiwan.net/poem5667.html","البسيط"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[128,"يا شيخ أَين من الخريف ربيع","https://www.aldiwan.net/poem23715.html","الكامل"],[136,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[369,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[422,"حلفت بتربة آبائها","https://www.aldiwan.net/poem53891.html","المتقارب"],[473,"الغيم يبسط في السماء ويفرش","https://www.aldiwan.net/poem59930.html","الكامل"],[556,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[556,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146224","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77612","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59759","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52028","الطويل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144617","المديد"],[2345,"","https://poetry.dctabudhabi.ae/diwan/poem/31537","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60965","المنسرح"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137378",""],[3575,"","https://poetry.dctabudhabi.ae/diwan/poem/95811","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131234",""],[4665,"","https://poetry.dctabudhabi.ae/diwan/poem/97750","البسيط"],[5064,"الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199136",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5320,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=40903",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5444,"صرخة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=205069",""],[5718,"قدس أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=213783",""]],"verses":[["أمّا صَلاةُ صِلاتِهِ فهيَ التِي","قدْ جلّ فيها عنْ مَقامِ السّاهي",0,"ي",1,0],["إمّا صهَلَتْ في أرْضِ عِدىً","فغُرابُ البَيْنِ بهِمْ نَعَقا",1,"ق",2,0],["أم أصختم إلى الأغاريد كي لا","تسموا كيف تنحب الأيتام",2,"م",1,0],["أَمّا صُبَيرٌ فَإِن قَلّوا وَإِن لَؤُموا","فَلَستُ هاجِيَهُم ما حَنَّتِ النيبُ",3,"ب",1,1],["أَما صاحِبٌ فَردٌ يَدومُ وَفاؤُهُ","فَيُصفي لِمَن أَصفى وَيَرعى لِمَن رَعى",4,"ع",2,0],["أَمَّا صَرِيعُ الحَرْبِ مِنْ جُنْدنا","فَرَابِطٌ مَهْما يُسَمْ يَصْبِرِ",5,"ر",1,0],["إما صبوت اليوم قيل لعمركم","يا ناس تهيام الشيوخ فظيع",6,"ع",1,0],["أَم أصبَحَت يُنكِرُ آيَاتِهَا","مَن لَم يَكُن لِلاىِ بالعَارِفِ",7,"ف",1,0],["أَم أَصارَ السُمُوَّ قِسمَكَ مَن عَل","لَمَ مِن قَبلُ آدَمَ الأَسماءَ",8,"ا",2,0],["إمّا صديقٌ لستُ أُنصِفُه","أنا أو صَديقٌ ليس يُنْصِفُني",9,"ن",2,0],["أما صحّ عندك قول الوشاة","فماذا التجافي وماذا التغالي",10,"ل",2,0],["أَما صَنائِفُ ذا فَيَضحَكُ رَقمُها","فيهِ وَأَمّا طَرزُ ذاكَ فَتُنعَشُ",11,"ش",1,0],["إمّا صديقٌ كالعدوِّ تقاعداً","عن نصرتي أو فالعدوّ المُحْنَقُ",12,"ق",1,0],["إمّا صروفٌ مقبلا","تٌ أو صروفٌ مُدبِراتُ",13,"ت",1,0],["أما صفاتي فلها شان","وقد نماني الشيخ مروان",14,"ن",1,1],["أَما صِغار القَومِ وَالأَسافل","لا رَكب عِندهم وَلا قَوافِل",15,"ل",1,0],["أما صفات الملك فهي قد انقضت","أن ألبس الأبطال أشراف ملبس",16,"س",1,0],["أمَا صَلّدَتْ أزنَادهُمْ عِنْدَ قَدْحِهَا","وَهَلْ طَاوَعَتْ أسيَافُهَمْ كَفَّ سَاحِبِ",17,"ب",1,0],["أم أصاب البين ما ظهر ال","يوم من شملي وما بطنا",18,"ن",2,0],["إِمّا صَرَمتِ جَديدَ الحِبا","لِ مِنّا وَغَيَّرَكِ الآشِبُ",19,"ب",1,1],["أمَّا صِفاتُ الجَمال فهي لكم","والمجد للأشعري والحَسَبُ",20,"ب",1,0],["أّمَّا صفاتُ جُزرِ أَندَمَندِ","الجاهُ فيها خَمسَةٌ لَم يَزدَدِ",21,"د",1,0],["أَمَّا صعودُ الجاهِ والنُّزُولُ","أَربَع أَصابع صح ما أَقولُ",22,"ل",1,0],["أما صفات الحمد فيه فما لها","شبه يماثل فهو فيها أوحد",23,"د",1,0],["إِمّا صديقٌ يُفاد غَمّاً","أو شامتٌ كاشحٌ حَسود",24,"د",1,0],["أما صوادحها فعدن نوائحاً","يرثين بهجتها على الأثلات",25,"ت",1,0],["إمّا صَبرتم فَلا أَدعو لغيركم","وَإِن جَزعتم أُنادي كلّ ذي حضرِ",26,"ر",1,0],["أمَّا صدَى النَّفْسِ فِي فَخْرٍ فمبتدَأٌ","يومًا سيكثُرُ فِي تحقِيرهِ الخبَرُ",27,"ر",1,0],["أم أصيبت في عقلها هذه الدا","ر فتاهت وتاه فيها الفضاء",28,"ا",2,0],["أم أصيب الإنسان في جنسه الح","ي فجلّ البلا وحل الفناء",28,"ا",2,0],["أم أصيبت للحق آياته البي","ض فهامت بليلها السمحاء",28,"ا",2,0],["أما صار فى فم مصر النشيد","وفى كل قلب نشيد الغزل",29,"ل",1,0],["أما صرح المختار عند مماته","بلعن البغاة الساجدين لذي الحد",30,"د",1,0],["أما صرحوا أنا نرد كلامهم","إذا خالف المنصوص رداً محتما",31,"م",2,0],["أم أصوغ المديحَ في موكبً الذلًّ","نفاقا، وأنظمُ الأشعارا?",32,"ر",2,0],["أما صلاحٌ يُلبِّي صرختي فبها","عزفُ الظلامِ على آهاتِ محزون",33,"ن",1,0],["أما صلاحٌ وقد عاثَ التصهينُ في","مسرى النبي وهاموا كالمجانين",33,"ن",1,0],["أما صلاحٌ لسيفِ النصرِ سجدتُه","وليس رقصا بمحرابِ الشياطين",33,"ن",1,0],["أَمَا صَارَتْ سُيُوفُهُمُ عُِصِيًّا","ودِرْعُ الفَخْرِ أَصْدَأَهَا الصَّغَارُ؟",34,"ر",1,0]]}