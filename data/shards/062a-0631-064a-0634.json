{"poems":[[55,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[65,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[29,"عفا ذو حمام بعدنا وحفير","https://www.aldiwan.net/poem5766.html","الطويل"],[53,"ترى شبه الآساد فيهم مبينا","https://www.aldiwan.net/poem62894.html","الطويل"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[107,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[102,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[358,"خذي من ودادي العين يا قرة العين","https://www.aldiwan.net/poem39773.html","الطويل"],[466,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[591,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122786","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62662","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35399","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109272","المنسرح"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109092","الوافر"],[1462,"","https://poetry.dctabudhabi.ae/diwan/poem/96473","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77975","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93648","الوافر"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198984","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201436","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107070","الخفيف"],[3257,"","https://poetry.dctabudhabi.ae/diwan/poem/20057","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82844","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89164","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89361","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114466","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103544","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77110","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136628",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[5848,"يبغى لها قعده","https://www.poetsgate.com/ViewPoem.aspx?id=50539",""],[5863,"تبدت فتاة القصر في الحلل الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=127111",""]],"verses":[["تُرَيِّشُنا الأَيّامُ ثُمَّ تَهيضُنا","أَلا نِعمَ ذا البادي وَبِئسَ المُعَقِّبُ",0,"ب",1,0],["تَريشُها ثَروةٌ لا أستَكينُ لَها","وإنْ ألَحَّ عَليَّ الدَّهْرُ يَبريني",1,"ن",2,0],["تريش لك الأقدار أسهم أسعد","تُصَابُ بها للدارعين مقاتلُ",2,"ل",1,0],["تَرى شَرَطَ المِعزى مُهورَ نِسائِهِم","وَفي قَزَمِ المِعزى لَهُنَّ مُهورُ",3,"ر",1,0],["ترى شبهَ الآساد فيهم مبيّناً","ولكنهم أدهَى دهاء وأنكرُ",4,"ر",1,1],["تَرى شَربَها حُمرَ الحِداقِ كَأَنَّهُم","أَساوى إِذا ما سارَ فيهِم سُوارُها",5,"ر",3,0],["تَرى شُعَل النيرانِ في خَلجِ الظبا","تذيق المنايا من أكفِّ المواهِبِ",6,"ب",1,0],["تَرى شَخصَهُ وَسطَ الخِلافَةِ هَضبَةً","وَخُطبَتَهُ دونَ الخِلافَةِ فَيصَلا",7,"ل",2,0],["تَرى شُرّابَها صَرعى إِذا ما","تَحَسَّتها الحَلاقِمُ وَالحُلوقُ",8,"ق",1,0],["تَرَى شَمائِلَ فيه منكَ بيّنةً","لم تنْتَقِلْ لكَ عن عَهدٍ ولم تَحُل",9,"ل",1,0],["ترى شخوصهم رسميّة وترى","أطماعهم في الحمى أطماع تجّار",10,"ر",1,0],["تريش سِهام الهدبِ عَن قَوس حاجب","فَيَغدو لَها قَلب المُتيّمِ كَالعينِ",11,"ن",1,0],["ترى شجرَ الغُلان فيه كأنَّها","سفائنُ يمٍّ أسلمتها رجالُها",12,"ل",3,0],["تُرَى شَمْسُ الضُّحى إِبّان تَبْدُو","وَتُنْظَرُ حِينَ تُنْتَسبْ الأُصُولا",13,"ل",2,0],["تَرَى شَاني يَقُومُ بِشَرحِ حالي","فَلفي شَأنٌ وَلِلعُذّالِ شانُ",14,"ن",1,0],["تُرى شمساً مقنَّعةً بليلٍ","وخدّاً في غلالةٍ خندريس",15,"س",1,0],["ترى شبحاً لونُ السحاب ثيابُه","فغرتك واستسقيتها وهي بلقعُ",16,"ع",1,0],["تَرى شُهبَ السَماءِ بِهِنَّ غَرقى","فَتَحسِبُها بِها الدُرَّ المَصونا",17,"ن",2,0],["ترى شعاع الخليل منبثقاً","من ذلك الرأس يكشف الظلما",18,"م",2,0],["ترى شاراتهم شارات عدلٍ","ولكن تحتها للظلم شاره",19,"ر",2,0],["تَرى شاربَيْها حينَ يَعْتَوِرانِها","يَميلانِ أحياناً ويَعْتَدِلان",20,"ن",1,0],["تَرى شائع الإِسلام قولاً وَلا تَرى","به عامِلاً إِلا يقل وَيعدم",21,"م",1,0],["تَريشها نَوافذ لا شَريفا","بِعافية يَدَعنَ وَلا وَضيعا",22,"ع",2,0],["ترى شعروا أني غبطت نسيمةً","ذكت بتلاقي الروض غب الغمايم",23,"م",1,1],["ترَى شعابَ الروابى تَتَّقى حَذَراً","اذا طغَى السيلُ أن يطغَى بها الخَطَر",24,"ر",1,0],["ترى شيمتي إكرام ضيفيَ واجبا","فما حيلتي إن كان ضيفيَ عقربا",25,"ب",2,0],["ترى شطها سلكاً ينظم درها","عقود جمان ما الدراري تحاكيه",26,"ي",2,0],["تَريشُ لَهُ الأَطيار عِندَ غُدوِّه","وَتَجنَحُ إِن أَومى لَها بِرَواحِ",27,"ح",1,0],["ترى شُعوراً وَإِخلاصاً تجسَّم في","كُلِّ القُلوبِ فعمَّ الحُزنُ وَالبَشرُ",28,"ر",1,0],["ترى شمس المعارف كيف غابت","وينظر خسفَه القمرُ المنير",29,"ر",1,0],["ترى شجعانهم بثبات جأشٍ","إذا عرف الجبين من الجبان",30,"ن",1,0],["ترى شمساً وزهراً في سماءٍ","إليها صاحِ قم ماذا التواني",31,"ن",2,0],["ترى شربها جنح الظلام كأنهم","بها مصطلو نارٍ يشب وقودها",32,"د",3,0],["تَريشُ سِهاماً مِن لِحاظٍ وَإِنِّما","لَها عِندَ تَحريكِ الجُفونِ سُكونُ",33,"ن",1,0],["تُريش سهامَ المقلتين فانثَنى","لها غَرضاً مَهما أراشت سِهامَها",34,"م",3,0],["ترى شخصه فوق السرير وإنه","له همم فوق النجرم الثواقب",35,"ب",1,0],["ترى شاعرك لا جفت بحور ومرّ به طاريك","يصير النابغه بقياس ذبيان وبني جعده",36,"د",2,0],["ترى شعره قد فاق أشعار غيره","وهل لغدير الغيث قرب من البحر",37,"ر",1,0]]}