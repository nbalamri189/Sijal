{"poems":[[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[273,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[359,"على فقد مثلك تبكى العيون","https://www.aldiwan.net/poem68051.html","المتقارب"],[456,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[536,"طنجة تيهي دلالا","https://www.aldiwan.net/poem47581.html","عموديه"],[556,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"]],"verses":[["طنّت بمسمعك الهواجس في الدجى","فنفت كراك كما يطِنّ بعوض",0,"ض",1,0],["طنَّبَ المجدَ بالمكارم والبي","ت بنصبِ العماد والتطنيبِ",1,"ب",1,0],["طُنُبٌ يُعَثَّرنَ الخُطوبَ وَباحَةٌ","مَمنوعَةٌ إِلّا مِنَ الرُوّادِ",2,"د",1,0],["طَنِّبْ قِبَابَكَ هَذَا العِزُّ والشَّرَفُ","واصْحَبْ شَبَابَكَ لا شَيْبٌ ولا خَرَفُ",3,"ف",1,1],["طَنناك تُبقى لِنَفع العِباد","فَخابَت بِمَوتِك تِلكَ الظُنون",4,"ن",1,0],["طنَّبَ بالأذرع الطوالِ ال","جبالَ تحت القنا الطوالِ",5,"ل",1,0],["طَنجَةُ تِيهي دَلالاً","مَالَكِ فشي الحُسن ثَانِ",6,"ن",1,1],["طنبورنا قد أصلحت أوتاره","فأجاد في النغمات حداً مفرطا",7,"ط",2,0]]}