{"poems":[[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[366,"على فقد مثلك تبكى العيون","https://www.aldiwan.net/poem68051.html","المتقارب"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[543,"طنجة تيهي دلالا","https://www.aldiwan.net/poem47581.html","عموديه"],[563,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122806","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63801","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64593","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127995","الخفيف"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/141729","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96035","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27650","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83209","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74317","الخفيف"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106696","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53005","الكامل"],[5145,"رحلوا بقلبك عرّجوا أم ساروا","https://www.poetsgate.com/ViewPoem.aspx?id=108063",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6124,"ذئاب الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=201332",""]],"verses":[["طنّت بمسمعك الهواجس في الدجى","فنفت كراك كما يطِنّ بعوض",0,"ض",1,0],["طنَّبَ المجدَ بالمكارم والبي","ت بنصبِ العماد والتطنيبِ",1,"ب",1,0],["طُنُبٌ يُعَثَّرنَ الخُطوبَ وَباحَةٌ","مَمنوعَةٌ إِلّا مِنَ الرُوّادِ",2,"د",1,0],["طَنِّبْ قِبَابَكَ هَذَا العِزُّ والشَّرَفُ","واصْحَبْ شَبَابَكَ لا شَيْبٌ ولا خَرَفُ",3,"ف",1,1],["طَنناك تُبقى لِنَفع العِباد","فَخابَت بِمَوتِك تِلكَ الظُنون",4,"ن",1,0],["طنَّبَ بالأذرع الطوالِ ال","جبالَ تحت القنا الطوالِ",5,"ل",1,0],["طَنجَةُ تِيهي دَلالاً","مَالَكِ فشي الحُسن ثَانِ",6,"ن",1,1],["طنبورنا قد أصلحت أوتاره","فأجاد في النغمات حداً مفرطا",7,"ط",2,0],["طَنِّب بِدُورِ بَني يَحيَى بنِ قاسِمِ أه","لِ العِزِّ مِن حَيّ قَحطانٍ وَعَدنانِ",8,"ن",1,0],["طنبورهُ في كفّهِ","والعُود عبد الجارَيه",9,"ي",2,0],["طُنبورُهُ ما عليه زيرٌ","وزقه ليس فيه قار",10,"ر",1,0],["طنبت في الوادي المقدس خيمتي","ورعيت بين شعوبه أغنامي",11,"م",2,1],["طنتدا بلدة احترام وعز","ونزيل بحيها الايضام",12,"م",1,1],["طنابيرهم معمورة بأداتها","ومسجدهم خال من الناس بلقع",13,"ع",1,0],["طنت صلاحي في السلو","وكان لي عين الفساد",14,"د",1,0],["طِّنب ففي التطنيب إن حققته","متوّسِّماً بسماته كشفَ الغطا",15,"ط",2,0],["طنبت منكم تجيب في حمى","طالب شأو المعالي لحق",16,"ق",1,0],["طَنَطِن كَما قَد طَنطَنوا","وَاِسرُب كَصِلٍّ أَسوَدِ",17,"د",1,0],["طنب النَحس في حماه فَأَضحى","ثاوياً عِندَ أَهلِهِ يَتَمَطى",18,"ط",2,0],["طَنّت حَصَانُكَ في الوُجُودِ فكُلٌّ مَن","ناوَاكَ فهوَ بالمهابَةِ يُقصَمُ",19,"م",1,0],["طن رقى الأفلاكَ كوكبُ سعده","وسما بآباءٍ كرام صِيدِ",20,"د",1,0],["طنّت لشائع عدله الدنيا كما","حنّت لسابغ نبله الأمصار",21,"ر",1,0],["طنّب الجود عندهم ثم غنّى","بحكايا أجوادهم إذ حكاها",22,"ا",3,0],["طَنَّ الذُّبابُ بِلَوحِ وَهمِ أَثِيرِهِمْ","فَأَمِيرُهُمْ عِندِي أَسِيرٌ فاقِدُ",23,"د",1,0],["طَنِيْنًا مِثْلَ سِكِّيْنِي","فَدَعْنِي كَيْ أُغَالِبَهَا.",24,"ه",2,0]]}