4,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66534","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111457","الخفيف"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4767,"دوحة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=179253",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5145,"مرحباً بالطالع المشتهر","https://www.poetsgate.com/ViewPoem.aspx?id=108067",""],[5171,"سلامة البيت","https://www.poetsgate.com/ViewPoem.aspx?id=198198",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5351,"ماذا هناك","https://www.poetsgate.com/ViewPoem.aspx?id=202284",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5461,"استطيع امنع لساني","https://www.poetsgate.com/ViewPoem.aspx?id=509",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5671,"ضل الطريق وضلت العفر","https://www.poetsgate.com/ViewPoem.aspx?id=169350",""],[402,"يا ابن لبنان عد إلى لبنان ط","https://www.poetsgate.com/ViewPoem.aspx?id=36536",""],[5992,"حلّ الخريفُ على الأغصانِ وانتثرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=41811",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[6340,"نار في الرسغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85835&r=&rc=0",""]],"verses":[["وَاِستَطالوا الغايَ حَتّى","جَرجَرَ الثِلبُ العَبامُ",0,"م",1,0],["وَاِستَطعَمَتني المَنايا مَن أَضَنُّ بِهِ","فَكانَ بِالرَغمِ إِطعامي وَإِشباعي",1,"ع",2,0],["وَاسْتَطَاعَ النَّاؤُونَ بَيْنَهُمَا أَنْ","يَتَلاقَوْا تَلاقِي الأَجْفَانِ",2,"ن",1,0],["وَاسْتَطْلِعُوا الرَّسْمَ المُحِيلَ فَهَلْ بِهِ","يَوْمَ المَآبِ لِقُرَّة عَيْنَانِ",3,"ن",1,0],["وَاستطرد الحَينُ بُنوةَ الحُسن","وَاِجتَمَعوا فَاِمتَنَعوا عَلى الرَسَن",4,"ن",1,0],["وَاِستَطلَقَت عُقَدُ الجَماعَةِ وَاِزدُري","أَمرُ الخَليفَةِ وَاِستُحِلَّ المُنكَرُ",5,"ر",1,0],["وَاِستَطَبنا المَقيلَ في بَردِ ظِلٍّ","وَشَمَمنا الرَيحانَ بِالكافورِ",6,"ر",1,0],["واستطبنا الرياح إن هي ثارت","وطلبنا الدجى، ورمنا الضبابا",7,"ب",2,0],["واستطارت تحثّ قافلة الفتح","وتطوي الحدود بعد الحدود",8,"د",1,0],["واستطربتْ ظعنُهُم، لمَّا احزألَّ بهمْ","آلُ الضُّحَى ، ناشطاً منْ داعياتِ ددِ",9,"د",1,0],["واستطعمتك الليالي كل حاذقةٍ","فما رأت منك إلّا غير مجزاع",10,"ع",1,0],["واستطِف الرأى ليرِجعْ به","من رجَعَ الشمسَ إلى يُوشَعِ",11,"ع",1,0],["واستطار الهوى فأعلن حربا","بين سود العيون والأكباد",12,"د",1,0],["واِستطردوا في النَقل","لذكرِ أَهلِ البُخلِ",13,"ل",1,0],["واستطلعي علم أسرار قد استترت","عني وظني بأن العين كالأثر",14,"ر",1,0],["وَاِستَطلعوا خَبَراً جاءَ البَشير بِهِ","حَتّى شَفى ما بِهِ نال المُحبّ ضنى",15,"ن",2,0],["واستَطَبْنا طَعمَ المنون عَلى","ذاك كأنَّ المنونَ فيه مُنانا",16,"ن",2,0],["واستطالَتْ على الأزاهرِ حتى","سلَبَتْها نسيمَها العنبَريّا",17,"ي",2,0],["واستطالا عليّ بالهَجْر حتّى","لم أجِدْ ناصراً سوى التُفاحِ",18,"ح",1,0],["واستطلعا شوفي فما برح الجوى","يبدي الذي أخفيه والبرحاء",19,"ا",2,0],["واستَطْلِعِ السَّعْدَ من أفْقٍ إلى أفْقٍ","كواكباً تَتَلالا فَوقَها هِمَمُكْ",20,"ك",1,0],["واستطالت عن عاشقيها وصالت","وتراءت لها القلوب فجالت",21,"ت",1,0],["واسْتَطْلعتْ في سَمواتِ الضَّميرِ لنا","شُموسُ وجدٍ أفانينَ الظَّلامِ جَلتْ",22,"ت",1,0],["واسْتطَبنا ظِلالها وهْيَ نارٌ","واجْتنبْنا هجيرَها وهْوَ نورُ",23,"ر",1,0],["واسْتَطارَتْ نَارِي فَمَا شَمْسُ","هَذَا الأُفْقِ إِلاَّ شَرارَةٌ مِنْ زِنَاد",24,"د",1,0],["واستطاعوا بوحدة العزم والآ","راء من حفظ مجدهم ما استطاعوا",25,"ع",3,0],["واستطيب المقيلُ في برد ظلٍّ","وشممنا الريحان بالكافور",26,"ر",1,0],["واستطعم النحل مما تجتني فجنى","لسعاً وغدذتك منها شهدة العسل",27,"ل",1,0],["واِستطرفَ الملك الأصيلَ وحسبهُ","في شأوِ مبلغِ مجدهِ ما اِستطرفا",28,"ف",2,0],["واستطار القلب مني لهفا","نحو اقمارٍ بذاك المجلسِ",29,"س",1,0],["واستطلع الشرق أقماراً به احتجبت","دهراً فكم في سماهُ اليوم أقمارُ",30,"ر",1,0],["واستطالت على الغرام يد الإثم","واذرت بسره المكنون",31,"ن",1,0],["وَاِستَطلَعَت نَجم السُهى مشن نَهدِها","وَمُذ اِستَفَّزَ الحُب كامن وَجدِها",32,"ه",2,0],["واستطيلي على الأثيرِ بقومٍ","شرفاً صيَّروا ثراك الأثيرا",33,"ر",2,0],["واستطالت به على الدهر كبراً","هممٌ تبذل الخطير احتقارا",34,"ر",2,0],["واستطالا بهمَّةٍ يأسرانِ ال","خطبَ فيها ويُطلقانِ الأسيرا",35,"ر",2,0],["واستطبها مِعطارةَ النظمِ منها","تَحسبُ اللفظَ لؤلؤاً منثورا",35,"ر",2,0],["واْستطابَ الآلامَ في حفظ مبداه","كأنَّ العذابَ فيه جميل",36,"ل",1,0],["واستطالت فسدت الأفق حتى","ضربت دون مجده الأستارا",37,"ر",2,0],["واستطاع السبيل من وجد ال","زاد إلى مكة وخرفاً حلالا",38,"ل",2,0],["واستطالت على سليم وجرت","بدر فضل على جرير تميم",39,"م",1,0],["واستطلع الطالع الميمون منبثقاً","عليه عقبى تباريحٍ واحزان",40,"ن",1,0],["واستطابوا حلاوة الجهل فيهم","وإلى الجهل أخلدوا إخلادا",41,"د",2,0],["وَاِستَطرَفوا إِحياء عيسى مَيِّتاً","فَرداً وجُودُكَ باعِثُ الفُقَراءِ",42,"ا",2,0],["وَاِستَطالَت بِعَلِيٍّ لَهُمُ","دَوحَةً لَم تَكُ تَشكُ القِصَرا",43,"ر",2,0],["واستطارت اشعةٌ تترامى","بين تلك القباب وهي سهام",44,"م",1,0],["واستطو أوراقك الناشره","ذيلاً من النشر",45,"ر",1,0],["واستطالوا ليجتنوا ثمر الفتح","فمرت عليهم الثمرات",46,"ت",1,0],["واستطلع الآباء في أبنائهم","فالعرق كان بطبعه دساسا",47,"س",2,0],["واستطال الأنام من لم يفرق","قط بين الشعري وحب الشعير",48,"ر",1,0],["واستطارتْ فرحاً لما بدا","برِحاب المجد مَلْكٌ أَروعُ",49,"ع",1,0],["واستَطلعِ النَهجَ الرَشيدَ بهِ ولا","تُنكِر هُداهُ الساطعَ اللألاءِ",50,"ا",2,0],["واستطردوا نُجُبَ البَشراءِ عن هِمَمٍ","توقَّدت مثلَ أَحشائي بحُبِّهِمِ",51,"م",1,0],["واستطلعوا السر منك حينًا","والسر أمنية ترامْ",52,"م",1,0],["واستطير الناس بالحرب التي","حملتهم كل خطبٍ جلل",53,"ل",1,0],["وَاسْتَطابَتْ رَيَّا نَواسِمِ بَغْدا","دَ فَكَادَتْ لَولاَ البُرَى أنْ تُطِيرَا",54,"ر",2,0],["وَاستَطالا حَتَّى الرُّعاةُ أَعدَّت","لَهُما الحَتفَ بالسِّنانِ القَوِيمِ",55,"م",1,0],["واستطالوا وشنشنوا واشرأبوا","بثغاءِ التخلُّفِ الجوّاني",56,"ن",2,0],["واستطرَفَت جَريي بِمَيدانِ الصِبا","لمَّا رأَت طِرفَ الشبابِ قد كَبا",57,"ا",1,0],["واستطالوا شرقاً وغرباً وصالوا","في الملا تحت الراية الدينية",58,"ي",2,0],["واستطال الصرحُ للمعبود يدعو","فاستجاب العبد لله ابتهالا",59,"ل",2,0],["وَاسْتَطَابَتْ فِي رَبِيِعٍ","دَوْحَةُ الأَطْيَابِ جَدْرَا",60,"ر",2,0],["واستطال النور من جبهته","فكسا الفحة ثوب السحر",61,"ر",1,0],["واستطال التراب في شمم التك","بير غاباً مؤطراً بالزنود",62,"د",1,0],["واستطالَ الركبُ في ترحالِهمْ","في وهادٍ كلُّها نارٌ وشَيْ",63,"ي",1,0],["واستطرد الخنجر الغافي على","ظهر المشيئاتِ اللواتي وجد",64,"د",1,0],["واستطابوا الوضوء منه فطالت","غرر منهم به وحجول",65,"ل",1,0],["واستطيع امنع يديني لا تنول","وامنع اذني عن سواليف الورى",66,"ر",2,0],["واستطعموا نزرَ الطعامِ يزورُهم","جوعٌ يقظُّ مضاجعا وعوافيا",67,"ي",2,0],["واستطيبوا ضر الهوى فغدوا","سيان إن نفعوا وإن ضروا",68,"ر",3,0],["واستطاع الناؤون بينهما أن","يتلاقوا تلاقي الطفان",69,"ن",1,0],["واستطرد القيظُ إذ ولَت عساكرهُ","واستبردَ الظلُّ فاقدح جمرة العِنَبِ",70,"ب",1,0],["واستطعموا عنده حيفا وما حملت","جناتها الخضر أو أغوارها الخصب",71,"ب",1,0],["واستطعموا أرقي..عصامية","تلتاث بي وتؤرق العصر",72,"ر",1,0]]}