{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[62,"جرى بين هرمس والشمس في","https://www.aldiwan.net/poem52164.html","المتقارب"],[45,"مجانيق شؤمك منصوبة","https://www.aldiwan.net/poem63620.html","المتقارب"],[28,"أتوعدني قيس ودون وعيدها","https://www.aldiwan.net/poem5046.html","الطويل"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[127,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[141,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[167,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[268,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[346,"كلفتني ما لم أطق في الصبا","https://www.aldiwan.net/poem20664.html","السريع"],[400,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[456,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[585,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"]],"verses":[["وَهِرَقلاً يَومَ سا آتيدَمى","مِن بَني بُرجانَ في البَأسِ رَجَح",0,"ح",1,0],["وَهِرٌّ تَصيدُ قُلوبَ الرِجالِ","وَأَفلَتَ مِنها اِبنُ عَمروٍ حُجُر",1,"ر",1,0],["وَهَرَبَت مِنّي وَمِن مَسعودِ","رَأَت غُلامَي سَفَر بَعيدِ",2,"د",1,0],["وهرعنا إلى أنامل يمنا","ه ففزنا بالخمسة الأشباح",3,"ح",1,0],["وهرَّتْ على مُستطرِقي البَرَّ قَرَّةٌ","يَمسُّ أذاها دونَ لوثِ العصائبِ",4,"ب",1,0],["وَهَرَّني الناسُ إِلّا ذا مُحافَظَةٍ","كَما يُحاذِرُ وَقعَ الأَجدَلِ الضُوَعُ",5,"ع",1,0],["وهرمس أقدمهم كلهم","وأكبرهم وهو شيخ نبيلُ",6,"ل",1,0],["وَهَرثَمَةٌ ماتَ لَمّا رَآكَ","مِنَ الخَوفِ تَبني عَلَيهِ المَنارا",7,"ر",2,0],["وَهَرَّت كِلابُ الجِنِّ مِنّي وَبَصبَصَت","بِآذانِها مِن ضَغمِ ضِرغامَةٍ وَردِ",8,"د",1,0],["وَهِرجاماً بَطَشتَ بِهِ فَقُلنا","خِيارُ البَزِّ كانَ عَلى القَعودِ",9,"د",1,0],["وَهَرَبَت سِهامُهُ مِنَ الهَدَف","كَأَنَّهُ يَرمي بِرِجلٍ لا بِكَف",10,"ف",1,0],["وَهَرَبَت سَفينَةُ الطوفانِ","مِنها إِلى الجودِيِّ وَالأَركانِ",10,"ن",1,0],["وهرَبْتُ منهْ إليهِ في حُرُماتِهِ","أدعوه مبتهلا وأسأل ملحفا",11,"ف",2,0],["وَهَرَّ دَهرٌ وَكَشَر","عَن ناجِذَيهِ وَبَسَر",12,"ر",1,0],["وهرَقتِ فضلاتِ الوِطاب","طمعاً بماءٍ تأمُلِين",13,"ن",1,0],["وَهَرَبتُ مِن شَظَفِ المَعا","شِ إِلى التَنَعُّمِ وَالرَبيلَه",14,"ل",2,0],["وَهَرَّت كِلابٌ دُونَها وَهَريرُها","أَثارَ عَلَيها بِالنِباحِ ضِراها",15,"ا",3,0],["وهرَّقنا على الأزهارِ منها","فزدنا طيبها طيباً دسيسا",16,"س",2,0],["وَهِرَّتي قَدْ هَوِيَتْ هِجرَتي","إذْ نارُنا في العِيد نَارُ الخَلِيلْ",17,"ل",1,0],["وهرون أخطا حين لام جماعة","عكوفاً على عجل يخور ولا يهدي",18,"ي",1,0],["وهَرَّ فلم يُطرَدْ فعضَّ سفاهةً","وعقرُك لي أني حقَرتُك نابحا",19,"ح",2,0],["وهرة منها حمرة العين بالدوى","وكان شديداً حره يتلهب",20,"ب",1,0]]}