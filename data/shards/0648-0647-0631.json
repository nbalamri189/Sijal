{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[74,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[64,"جرى بين هرمس والشمس في","https://www.aldiwan.net/poem52164.html","المتقارب"],[47,"مجانيق شؤمك منصوبة","https://www.aldiwan.net/poem63620.html","المتقارب"],[30,"أتوعدني قيس ودون وعيدها","https://www.aldiwan.net/poem5046.html","الطويل"],[46,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[77,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[50,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[147,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[173,"ترى حيث أعلام العيون تراها","https://www.aldiwan.net/poem1689.html",""],[275,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[353,"كلفتني ما لم أطق في الصبا","https://www.aldiwan.net/poem20664.html","السريع"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[463,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[592,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77482","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145790","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136185","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136363","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100929","الكامل"],[2841,"","https://poetry.dctabudhabi.ae/diwan/poem/133886","الطويل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90031","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4116,"","https://poetry.dctabudhabi.ae/diwan/poem/177929","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120529","الوافر"],[4691,"ليتني صخرٌ ليتني جدران ُ!!","https://www.poetsgate.com/ViewPoem.aspx?id=60736",""],[4869,"سنوات الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=151539",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4927,"أنوار العدالة","https://www.poetsgate.com/ViewPoem.aspx?id=80804",""],[182,"وتر مذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=72798",""],[5031,"غريبٌ عن جسد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=165138",""],[5072,"أنا بانتظاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=61801",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5149,"عَبَثَ النُّعَاسُ بِجَفنِها","https://www.poetsgate.com/ViewPoem.aspx?id=213018",""],[5277,"دمعةٌ وشمعةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=195401",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5736,"هروب","https://www.poetsgate.com/ViewPoem.aspx?id=210612",""],[1920,"خوف وشكّ","https://www.poetsgate.com/ViewPoem.aspx?id=192709",""],[5956,"حيوية الدنيا بوجه أسفر","https://www.poetsgate.com/ViewPoem.aspx?id=182286",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6056,"الشعر أكذبه  أعذبه","https://www.poetsgate.com/ViewPoem.aspx?id=130138",""],[6344,"حجاب المرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87979&r=&rc=19",""]],"verses":[["وَهِرَقلاً يَومَ سا آتيدَمى","مِن بَني بُرجانَ في البَأسِ رَجَح",0,"ح",1,0],["وَهِرٌّ تَصيدُ قُلوبَ الرِجالِ","وَأَفلَتَ مِنها اِبنُ عَمروٍ حُجُر",1,"ر",1,0],["وَهَرَبَت مِنّي وَمِن مَسعودِ","رَأَت غُلامَي سَفَر بَعيدِ",2,"د",1,0],["وهرعنا إلى أنامل يمنا","ه ففزنا بالخمسة الأشباح",3,"ح",1,0],["وهرَّتْ على مُستطرِقي البَرَّ قَرَّةٌ","يَمسُّ أذاها دونَ لوثِ العصائبِ",4,"ب",1,0],["وَهَرَّني الناسُ إِلّا ذا مُحافَظَةٍ","كَما يُحاذِرُ وَقعَ الأَجدَلِ الضُوَعُ",5,"ع",1,0],["وهرمس أقدمهم كلهم","وأكبرهم وهو شيخ نبيلُ",6,"ل",1,0],["وَهَرثَمَةٌ ماتَ لَمّا رَآكَ","مِنَ الخَوفِ تَبني عَلَيهِ المَنارا",7,"ر",2,0],["وَهَرَّت كِلابُ الجِنِّ مِنّي وَبَصبَصَت","بِآذانِها مِن ضَغمِ ضِرغامَةٍ وَردِ",8,"د",1,0],["وَهِرجاماً بَطَشتَ بِهِ فَقُلنا","خِيارُ البَزِّ كانَ عَلى القَعودِ",9,"د",1,0],["وَهَرَبَت سِهامُهُ مِنَ الهَدَف","كَأَنَّهُ يَرمي بِرِجلٍ لا بِكَف",10,"ف",1,0],["وَهَرَبَت سَفينَةُ الطوفانِ","مِنها إِلى الجودِيِّ وَالأَركانِ",10,"ن",1,0],["وهرَبْتُ منهْ إليهِ في حُرُماتِهِ","أدعوه مبتهلا وأسأل ملحفا",11,"ف",2,0],["وَهَرَّ دَهرٌ وَكَشَر","عَن ناجِذَيهِ وَبَسَر",12,"ر",1,0],["وهرت علينا كما ينبغي","وجاءت قضايا وأسبابها",13,"ب",3,0],["وهرَقتِ فضلاتِ الوِطاب","طمعاً بماءٍ تأمُلِين",14,"ن",1,0],["وَهَرَبتُ مِن شَظَفِ المَعا","شِ إِلى التَنَعُّمِ وَالرَبيلَه",15,"ل",2,0],["وَهَرَّت كِلابٌ دُونَها وَهَريرُها","أَثارَ عَلَيها بِالنِباحِ ضِراها",16,"ا",3,0],["وهرَّقنا على الأزهارِ منها","فزدنا طيبها طيباً دسيسا",17,"س",2,0],["وَهِرَّتي قَدْ هَوِيَتْ هِجرَتي","إذْ نارُنا في العِيد نَارُ الخَلِيلْ",18,"ل",1,0],["وهرون أخطا حين لام جماعة","عكوفاً على عجل يخور ولا يهدي",19,"د",2,0],["وهَرَّ فلم يُطرَدْ فعضَّ سفاهةً","وعقرُك لي أني حقَرتُك نابحا",20,"ح",2,0],["وهرة منها حمرة العين بالدوى","وكان شديداً حره يتلهب",21,"ب",1,0],["وَهَرع الكُلُّ إِلى النَجاةِ","مَحبةً مِنهنّ في الحَياةِ",22,"ه",1,0],["وهِرَاوَةً تُدمي بهَا جَسَدَ النَهَا","رِ لكي يُحَاذِرَ أنْ يكونَ نَهَارا",23,"ر",2,0],["وهراك ترصعه عيناي","عقيقاً أحمر او دررا",24,"ر",2,0],["وهرول إلى مغنى الاحبة راكبا","جوادا من الاقبال والعزم والذكر",25,"ر",1,0],["وهرول إلى دار الحبيب ميمما","مرابعه تمشي إليه ولو حبوا",26,"و",2,0],["وهرول يوم صفين عجولاً","فسار العسكران مهرولينا",27,"ن",2,0],["وهرولت بالقوت نحو الوحيد","ودمع عينيها برش الطريق",28,"ق",1,0],["وَهرعنَ كلّ خريدة","غطَّت بفضل اللَّيل بَدرا",29,"ر",2,0],["وهرت بنو يربوع إذ هشها الوغى","هريرَ كلاب أوجعتها أيورُها",30,"ر",3,0],["وهرت كلابٌ في الوشيج فاقعصت","ثعالب في أجحارها وخرانقا",31,"ق",2,0],["وَهِرَقلٌ بَينَ تَبريحٍ وَضيق","حَلَّ قَوصاً لا يَرى فيها صَديق",32,"ق",1,0],["وهرمس حثت أن يسير بخلسةٍ","بجثة هكطور الصريع فتشتفي",33,"ي",1,0],["وهرب الكلّ بلا تواني","كالفضل والحارث والنعمان",34,"ن",1,0],["وهربتُ من يده إلى أجفانه","فَرَقاً فسَلَّ عليَّ منها مُرهَفا",35,"ف",2,0],["وهر صائح في حال صحو","بنو دائم في كل آن",36,"ن",1,0],["وهروب المكانِ مني غريب ٌ","أينَ أغدو؟؟ إذا يفرُّ المكانُ !!",37,"ن",1,0],["وهروجهم درّن وياقوت وألماس","تهب في قلبي سوات النسانيس",38,"س",1,0],["وَهَرْوَلَتْ حَسْبَمَاْ يَهْوَىْ مُرَوِّضُهَاْ","فِيْ حَلْبَةِ \"السِّرْكِ\" قَفْزًا فِيْ مَنَاْحِيْهَاْ(22)",39,"ي",3,0],["وَهَرْوَلَتْ نُخْبَةُ الأَوْغَاْدِº وَارْتَعَدَتْ *** وَأَسْجَفَتْ - فَوْقَ مَاْ سَطَّرْتَ - أَسْجَاْفَاْ (10)","قَدْ بَذَّرَ الْقَوْمُ تَبْذِيْراً بِلاْ سَبَبٍ *** وَأَنْتَ تَرْفُضُ تَبْذِيْراً وَإِسْرَاْفَاْ",40,"ف",2,0],["وَهَرْوَلَتِ الأَشْبَاْحُ خَوْفاًº وَوَلْوَلَتْ","وَزَاْلَتْ عَنِ الشَّعْبِ الصَّبُوْرِ الْفَظَاْئِعُ",41,"ع",1,0],["وهربتُ من الثلج القاسي","فدُحِرْتُ إلى جمر النار",42,"ر",1,0],["وهَربت ُ أبحث ُ عن يديك َ فلم أجِد ْْ","هَربا  ..فأروقة ُ الرحيِلُ إيابُها",43,"ب",3,0],["وهربتُ مثلَ الطيرِ خوفَ عواطفي","وسِهامُ عينِكِ أُوغِلَتْ بجناحي",44,"ح",2,0],["وهَرْوَلةِ المَها وبهِنَّ قَلبي","كَسيرٌ ، يا لَأحلامِ الكَسيرِ",45,"ر",1,0],["وهرا سكان فلا تسل ما نابها","وبوكيلٍ نزل العناء العاني",46,"ن",2,0],["وَهَرَبْتُ مِنْ مَلَلِ الْفِرَاشِ مُغَاضِبًا","إنِّي نَدَبتُكِ، فِي المَلَالَةِ، مَهْرَبا",47,"ب",2,0],["وهِرَقْلُ في رومٍ أتى","متكاشفاً عنْ سوأتَيه",48,"ي",2,0],["وهرجٍ على الطرشان ماله خانه","هدية الصادق على الكذابي",49,"ب",2,0],["وهربتُ منكَ إليكَ بعضي أرتجي","ذاك الذي منّي إليكَ دفعتُهُ",50,"ت",2,1],["وهربتُ منّي واختليتُ بوحدتي","لكن خطرتَ مغاضباً ومعنّفا",51,"ف",2,1],["وهرَبْتُ من هذا المُحَيَّا ناجيا","من أن أدنّسَه فظلَّ مُطَهَّرا",52,"ر",2,0],["وهرولي -حِلمُنَا في الذَّاتِ منتظرٌ-","خَلفِي لِنَغشَى لَيَالِي الحِلمِ بِالطَّربِ",53,"ب",1,0],["وهروج بعض البشر ماهي بمرغوبة","البيع ، في سوقهم جملة ، وقطّاعي",54,"ع",2,0],["وَهَرَبْتُ مِنْ وَجَعِي إِلَى","وَجَعٍ يُلَمْلِمُنِي بَقَايَا",55,"ا",3,0]]}