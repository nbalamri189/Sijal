{"poems":[[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[302,"سلا دارها أن أنبأ الطلل القفر","https://www.aldiwan.net/poem33254.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64070","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82632","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86522","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70161","الوافر"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107525","الخفيف"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69286","الطويل"],[5005,"هما ندّان..","https://www.poetsgate.com/ViewPoem.aspx?id=190156",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""]],"verses":[["هُما صَبَرا وَالحَقُّ يَركَبُ رَأسَهُ","عَشِيَّةَ زالَت بِالفُروعِ القَواعِدُ",0,"د",1,0],["هُما صَبوحٌ باكِرٌ غَيمُهُ","ثُنِّيَ في أَعقابِهِ بِالغَبوق",1,"ق",1,0],["هُمَا صُورَتَانَا فِي الْهَوَى وحَدِيثُنَا","حَدِيثُهُمَا بَيْنَ الأَزَاهِرِ يُنْقَلُ",2,"ل",1,0],["هُمُ أَصلُه الزاكي ومحتِدُه الَّذي","زَكا فَزَكا فَرعٌ له وَذكا نشرُ",3,"ر",1,0],["همْ أصفياءُ الله من بين الورى","أَلِفوا السَّدادَ وحالفوا التوفيقا",4,"ق",2,0],["هما صلعة أَنا في صَدرِها","فَبَغداد تَقرب من جَبُّل",5,"ل",1,0],["هم أصول لفروع الأوليا","يجتني منه جني الروضين",6,"ن",1,0],["هم أصرخوا جيرانهم حين أقبلت","عداهم ودقت للوغى عطر منشم",7,"م",1,0],["هما صاحِ ميزابا العلومِ التي أتى","بها فارتوى معلمٌ ومعلمُ",8,"م",1,0],["هما صاحِ ينبوعٌ لأنهارِ جنةٍ","وعندَ ورودكَ الجنانَ ستعلمُ",8,"م",1,0],["هُما صِنوانِ زانهما كَمالٌ","وَتَمَّ العَقدُ في يومٍ سَعيدِ",9,"د",1,0],["همُ اصحابي الأُلى كنتُ معهم","في سرورٍ وكان عيشي هنياً",10,"ي",2,0],["هُمُ أَصبَحوا كَنزي الَّذي لَستُ تارِكاً","وَنَبلي الَّتي أَعدَدتُها لِلمُناضِلِ",11,"ل",1,0],["هما صوتٌ إذا نادى بليلٍ","رأيتَ اللّيلَ من عجزٍ ينادي",12,"د",2,0],["هما صفتا قولٍ وفعلٍ تعلقا","بما شاءه عن قدرة الواحد الفرد",13,"د",1,0],["هُمْ أصْحابٌ للدّارِ بِها","وسَوادُ الشَّعْبِ هُوَ الضَّيْفُ",14,"ف",1,0]]}