َفْتُ ما جَنَتِ الخُطوبُ ولم أُطِلْ","أمَلاً فما لِمَخِيلَةٍ تَصديقُ",0,"ق",1,0],["فَعُرِّفْتَ فِي السَّرَّاءِ نِعْمَةَ مُنْعِمٍ","وَأُلْحِفْتَ فِي الضَّرَّاءِ رَحْمَة رَحْمَانِ",1,"ن",1,0],["فَعَرشٌ لا تَحُفُّ بِهِ قُلوبٌ","تَحُفُّ بِهِ الخُطوبُ وَيَضمَحِلُّ",2,"ل",1,0],["فَعَرشُكَ مَحروسٌ وَرَبُّكَ حارِسٌ","وَأَنتَ عَلى مُلكِ القُلوبِ أَميرُ",3,"ر",1,0],["فَعَرَّضَت طَلَقا أَعناقَها فَرَقاً","ثُمّ اِطَّباها خَريرُ الماءِ يَنسَكِبُ",4,"ب",1,0],["فعِراصُ قلبك بالصِبى معمورةٌ","لما خلتْ ممن تُحبُّ عراص",5,"ص",1,0],["فَعَرَفنَ حينَ رَأَينَهُ مُتَحَمِّساً","يَمشي بِنَفسِ مُحارِبٍ ما يُذعَرُ",6,"ر",1,0],["فَعَرَفتُ مِثلَهُمُ بِأَنّي موجِدٌ","بُؤسي وَأَنّي خالِقٌ نُعَماءِ",7,"ا",2,0],["فَعَرِّض بِذِكري حَيثُ تَسمَعُ زَينَبٌ","وَقُل لَيسَ يَخلو ساعَةً مِنكِ بالُهُ",8,"ل",2,0],["فَعَرِّض إِذا ما جُزتَ بِالبانِ وَالحِمى","وَإِيّاكَ أَن تَنسى فَتَذكُرَ زَينَبا",9,"ب",2,0],["فَعَرَفنا بِذَكيّ ال","عَرف ماقَد كانَ مُضمَر",10,"ر",1,0],["فَعَرَفَ الغِياضَ وَالمُروجا","وَأَتقَنَ الدُخولَ وَالخُروجا",11,"ج",2,0],["فَعَرَفتُ ذاكَ وَلَم أَدَع إِدناءَهُم","وَالحِلمُ بَينَ أَقارِبٍ وَأَباعِدِ",12,"د",1,0],["فعرَفْتُ يَومَ البَيْنِ مَنْهَجَه كما","عَرَفَ ابنُ نَصرٍ مَنهجَ المَعروفِ",13,"ف",1,0],["فَعُرِفتُ بِالحُبِّ المُبَرِّحِ مِثلَما","عُرِفَت يَدُ المَنصورِ بِالتَصريفِ",14,"ف",1,0],["فعرا الأفقَ قتام وبَدَت","سحب تحبو إلى وجه القمر",15,"ر",1,0],["فَعَرَفتُ صورَتَها وَلَيسَ بِمُنكِرٍ","أَحَدٌ شُعاعَ الشَمسِ ساعَةَ تَطلُعُ",16,"ع",1,0],["فَعَرَفنَ الشَوقَ في مُقلَتِها","وَحَبابُ الشَوقِ يُبديهِ النَظَر",17,"ر",1,0],["فَعَريتُ إِلّا مِن قِناعِ كَآبَةٍ","وَعَطِلتُ إِلّا مِن حُلِيِّ بُكاءِ",18,"ا",2,0],["فَعَرِّض مِنَ العَلياءِ في رَأسِ هَضبَةٍ","تُزاحِمُ أَشباحَ النُجومِ العَواتِمِ",19,"م",1,0],["فعَرفتُ أبنائي ولستُ لهم أباً","حتّى يُقيموا سُنَّتي وشِعاري",20,"ر",2,0],["فعرفتُ موضعكم وكيف سما بكم","مجدٌ لكم في المسلمين مؤثَّلُ",21,"ل",1,0],["فَعَرارُهُ مِن لَحظِهِ وَبَهارُهُ","مِن خَدِّهِ وَالآسُ نَبتُ عِذارِهِ",22,"ر",2,0],["فَعَرَّستُ لَمّا اِستَسلَمَت بَعدَ شَأوِهِ","تَنَائِفُ ما نَجا بِهِنَّ هَجوعُ",23,"ع",1,0],["فعُرِّفْتَ في اليْوم البصيرَةَ في غدٍ","وشاركتَ في الرَّأي القضاءَ المقدَّرا",24,"ر",2,0],["فَعَرَفتُهُ وَاللَيلُ مُلتَبِسٌ بِنا","بِرَفيفِ صَلعَتِهِ وَشَيبِ المِسحَلِ",25,"ل",1,0],["فَعَرِّفوني بِفَتاً مِنكُمُ","لا يَمتَري الناسَ وَلَكِن يَمير",26,"ر",1,0],["فَعَردَةٌ فَقَفا حِبِرٍّ","لَيسَ بِها مِنهُمُ عَريبُ",27,"ب",1,0],["فَعَرَفنا هِزَّةً تأخُذُهُ","فَقَرَّناهُ بِرَضراضٍ رِفَل",28,"ل",1,0],["فَعَرَفنا مقومات الثريا","وَعلمنا عناصر الجوزاء",29,"ا",2,0],["فعرتها رِعدةٌ فالتفتتْ","فرأتْهُ فتلقّاها وِجاها",30,"ا",3,0],["فَعَرَا قِلاَدَتَنَا وَكَا","نَتْ زِينَةَ الدُّنْيَا شُحُوبُ",31,"ب",1,0],["فعَرتْهُ جِنَّةٌ زَانَتْ لَهُ","خُطَّةٌ أَدْهَى عَلى المُلْكِ وَأَزْرَى",32,"ر",2,0],["فَعَرَفتُ القَبولَ مِنها لِعُذري","إِذ رَأَتني مِنها أُريدُ اِعتِذارا",33,"ر",2,0],["فعرفتُ القبولَ منها لعذري،","إذْ رَأَتْني مِنْها أُريدُ کعْتِذارا",34,"ر",2,0],["فعرقك عرقه نوع شريف","اصيل قام فيه الاصفياء",35,"ا",2,0],["فعرفت من وادي السعير مقامه","وسطقت أهذي كتلة من قار",36,"ر",1,0],["فَعَرَفتُ عَجزي فيهِ غَيرَ مُكذِّبٍ","وَعَرَفتُ فَضلَ عُلاهُ غَيرَ مُكابِرِ",37,"ر",1,0],["فَعَراهُم كَسرٌ بهِ حصلَ الجب","رُ وخفضٌ بهِ لنا اِستعلاءُ",38,"ا",2,0],["فعرفتهُم ونَبَذتُهُم","لكنّهم لم يعرفوني",39,"ن",2,0],["فعرفتُ ذنبي أن كبش","ي ليسَ بالكبش السمين",39,"ن",1,0],["فعرّضا بي وقولا في حديثكما","ما بال عبدك بالهجران تتلفه",40,"ه",1,0],["فعِرْضُ مجدِك بالمعروف ممتنِعٌ","وعِرْضُ مالِك في العافين مُقْتَسَمُ",41,"م",1,0],["فعرِفْن منْ لمتنَّ في عَبَراتِهِ","وارجِعن عن غايات شوقي ظُلَّعا",42,"ع",2,0],["فعرض لأهليه بصبّ غرامه","طويل بسكان الحجاز عريض",43,"ض",1,0],["فَعَرَفتُ عَرفَكَ مِن رَوائِحِها","وَفَهِمتُ مِنها حُسنَ رَأيِكَ لي",44,"ل",2,0],["فَعَرَضُ الدُّنْيَا قَلَوْهُ وَفِي","زَخَارِفِ الأُخْرَى لَهُمْ غُنْيَهْ",45,"ي",2,0],["فَعَرَضُ الدُّنْيَا بِأَعْيُنِهِمْ","كَعَقْرَبٍ تَلْدَغُ أَوْ حَيَّهْ",45,"ي",2,0],["فعرف كبا العلياء يظهر نشره","توقد ناري حاسد وغيور",46,"ر",1,0],["فعرَّضَ للأخطارِ نفساً عزيزةً","ومُرتبةً من أن يخاطِرَ أخطرا",47,"ر",2,0],["فَعِرضُهُ في حَرَمٍ وَمالُهُ","في حَرَبٍ مِمَّن عَراهُ فَسَأَل",48,"ل",1,0],["فَعِرضُهُ في حَرَمٍ وَمالُهُ","بِشَنِّ غاراتِ العُفاةِ في حَرَب",49,"ب",1,0],["فعرَّفَ الأَميرا","بفضلهِ كثيرا",50,"ر",2,0],["فعرشُ ملكك قد أضحتْ قواعدُه","في قلبِ كلِّ أبيّ ثَّبتتْ قدما",51,"م",2,0],["فَعِرْضُ مَن أَصبحَ من حُسَّادهِ","كَثوبِ طاهِيةٍ دُجَى سَوادهِ",52,"ه",1,0],["فَعَربَدتُ وَلا عَتبَ","عَلى السَكرانِ إِن عَربَد",53,"د",1,0],["فَعَرَّفتَهُ بِكَ إِذ بَدا","نوراً لَدَيكَ مُنَوِّرا",54,"ر",2,0],["فعُرْبُ الورَى كاللّفظِ ليس بمُعْرَب","وعُجْمُ الورَى كاللّفظِ ليس بمُعْجَم",55,"م",1,0],["فعَرِّجا بي على أَدْنَى مَعاهدِهم","يا حاديَيْنا وشَرّ العَهدِ ما نُقِضا",56,"ض",2,0],["فعرف ريح القُطر","يشيد فضل الأدب",57,"ب",1,0],["فعرض بذكري عند ذاك وقل لهم","أسير الخطايا أطلقوه وإن خانا",58,"ن",2,0],["فعرف جمعاً كان في الحسن مفرداً","وشتت شملاً كان في الوصف يوسف",59,"ف",1,0],["فعرفت حقاً أنه غلط","وصف النِّسَا بمحاسن الشعر",60,"ر",1,0],["فَعَرقٌ فَالرِماحُ فَال","لِوى مِن أهلِهِ قَفرُ",61,"ر",1,0],["فَعُرى الحريِص إِلى زور زينب إِلى","مرسى مَجَرْتَاتٍ وخيراً جَرَّتِ",62,"ت",1,0],["فَعَرِّجْ عَلَى الحَجِّ بالمسلمينَ","بِعُقْبِ اصْطِلامِكَ حَجَّ النَّصارى",63,"ر",2,0],["فعرِّجْ عليهم ثم قل لمفرّج","أترغبُ في مدحي وتزهدُ في شكري",64,"ر",2,0],["فَعَرَّفني بين الركاب كأنما","حقيبةُ رحلي باقِيَ الليلِ مَسْحَبُ",65,"ب",1,0],["فعِرضُ ظهير الملك أطيب نفحةً","وأذكى إذا ما أحسن القول قائلُه",66,"ل",2,0],["فعِرض غياث الدين أذكى تأرُّجاً","وأحمدُ سمعاً عند مُصْغِ وناشق",67,"ق",1,0],["فعرفتُ قدر القربِ في حال النّوى","كالصّابِ بعد الأري والقنديد",68,"د",1,0],["فعراصِ مزَّتها إلى قنواتها","فالواديينِ إلى شعاب منينها",69,"ن",3,0],["فَعَرشُ خاخٍ قِفارٌ غَيرَ أَنَّ بِهِ","رَبعاً أَقامَ بِهِ نؤيٌ وَمُنتَضَدُ",70,"د",1,0],["فَعُروَةُ سَنَّ الحُبَّ قَبليَ إِذ شَقى","بِعفَراءَ والنَهديُّ ماتَ عَلى هِندِ",71,"د",1,0],["فعرفك الرحمن يمن ابتدائه","ولا زلت مخصوصاً بكل حبور",72,"ر",1,0],["فَعَرَّجا بَعدَ تَغويرٍ وَقَد وَقَفَت","شَمسُ النَهارِ وَلاذَ الظِلُّ بالعودِ",73,"د",1,0],["فعَرْضُ البلاد على العارفي","نَ أضيقُ من مهجة