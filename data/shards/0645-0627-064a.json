oetsgate.com/ViewPoem.aspx?id=179104",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""]],"verses":[["ما يَنفَعُ الماضينَ إِن بَقِيَت لَهُم","خُطَطٌ مُعَمَّرَةٌ بِعُمرٍ فانِ",0,"ن",1,0],["ما يَطلُبُ الدَهرُ وَالأَيامُ مِن رَجُلٍ","يَعوذُ بِالحَمدِ إِشفاقاً عَلى النِعَمِ",1,"م",1,0],["ما يَضُرُّ القَومَ أوقِظتَ لَهُم","أَن يَكونوا عَن حِمى العِزِّ نِياما",2,"م",2,0],["ما يُدفَعُ المَوتُ عَن بُخلٍ وَلا كَرَمٍ","وَلا جَبانٍ وَلا غَمرٍ وَلا بَطَلِ",3,"ل",1,0],["ما يُبالي الحِمامَ أَينَ تَرَقّى","بَعدَما غالَتِ اِبنَ فاطِمَ غولُ",4,"ل",1,0],["ما يُذِلُّ الزَمانُ بِالفَقرِ حُرّاً","كَيفَ ما كانَ فَالشَريفُ شَريفُ",5,"ف",1,0],["ما يُبالي الهُمامُ أَينَ تَرَقّى","وَخَباءُ العُلى أَمينُ العِمادِ",6,"د",1,0],["ما يَنفَعُ المَرءَ أَحسابٌ بِلا جِدَةٍ","أَلَيسَ ذا مُنتَهى حَظّي وَذاكَ أَبي",7,"ب",2,0],["ما يُؤمِنُ المَرءَ بَعدَ مَسمَعِهِ","قَرعَ اللَيالي لَهُ الظَنابيبا",8,"ب",2,0],["ما يَصنَعُ السَيرُ بِالجُردِ السَراحيبِ","إِن كانَ وَعدُ الأَماني غَيرَ مَكذوبِ",9,"ب",1,1],["ما يَنقَضي عَجَبي مِن جَهلِ حاسِدَةٍ","كانَت بِذي الأَثلِ مِن خِدني وَأَنصاري",10,"ي",1,0],["ما يَصنَعُ الصَبُّ الحَزي","نُ جَفاهُ أَهلُ صَفائِهِ",11,"ا",3,0],["ما يَنَل مِنكَ فَأَحلى مَغنِمٍ","وَيَرى ظَرفاً بِهِ أَن يَمنَعَه",12,"ع",2,0],["ما يُجعَلُ الجُدُّ الظَنونُ الَّذي","جُنِّبَ صَوبَ اللَجِبِ الزاخِرِ",13,"ر",1,0],["ما يَجمَعُ الشَوقُ إِن دارٌ بِنا شَحَطَت","وَمِثلُها في تَداني الدارِ مَهجورُ",14,"ر",1,0],["ما يقول الأقدام في كاذب الأو","جال تلقاء صادق الآجال",15,"ل",1,0],["ما يرجى من مشهدي أو مغيبي","ومكاني إلا من الطيف خالي",16,"ي",1,0],["مائدة فيحاء أصنافها","خمسون إن عدت وليست أقل",17,"ل",1,0],["مَا يَعْظِمِ الإِنْسَانُ لا تَعْصِمْهُ مِنْ","هَذَا المَصِيرِ عَظَائِمُ الإِنْسَانِ",18,"ن",1,0],["مَا يَبْلُغُ الْخَصْمُ مِمَّنْ قَبْلَ مَوْقِفِهِ","لَدَى القَضَاءِ إِلَى نَجْواهُ يَخْتَصِمُ",19,"م",1,0],["مَا يَنْثَنِي عَنْهُ مَاضٍ","حَتَّى يُوَافِي قَادِمْ",20,"م",1,0],["ما يَصنَعُ الشَيخُ بِالعَذراءِ يَملِكُها","كَجَوزَةٍ بَينَ فَكَّي أَدرَدٍ خَرِفِ",21,"ف",1,0],["ما يُحسَدُ المَرءُ إِلّا مِن فَضائِلِهِ","بِالعِلمِ وَالظَرفِ أَو بِالبَأسِ وَالجودِ",22,"د",1,0],["ما يَتَقَضّى عَجَبي","ما عِشتُ مِن مُطَّلِبِ",23,"ب",1,1],["ما يَنفَعُ الرِجسَ مِن قُربِ الزَكِيِّ وَما","عَلى الزَكِيِّ بِقُربِ الرِجسِ مِن ضَرَرِ",24,"ر",1,0],["ما يَرحَلُ الضَيفُ عَنّي غِبَّ لَيلَتِهِ","إِلّا بِزادٍ وَتَشيِيعٍ وَمَعذِرَةِ",25,"ه",1,0],["ما ينكر المرءُ من نورِ جلا غسقاً","ما لم يكن لأماني النفس مُطَّرِحا",26,"ح",2,0],["ما يَدَّري شُعَراءُ الناسِ وَيلَهُمُ","مِن صَولَةِ المُخدِرِ العادي بِخَفّانا",27,"ن",2,0],["ما يُنبِتُ الفَرعُ نَبعاً مِثلَ نَبعَتِكُم","عيدانُها غَيرُ عَشّاتٍ وَلا خورِ",28,"ر",1,0],["ما يُنسِني الدَهرُ لا يَبرَح لَنا شَجَناً","يَومٌ تَدارَكَهُ الأَجمالُ وَالنوقُ",29,"ق",1,1],["ما يُقحِمونَ عَلَيَّ مِن مُتَمَرِّدٍ","إِلّا سَبَقتُ فَنِعمَ قَومُ السابِقِ",30,"ق",1,0],["ما يَمنَعُ اللَيلُ مِنّي ما هَمَمتُ بِهِ","وَلا أَحارُ إِذا ما اِعتادَني السَفَرُ",31,"ر",1,0],["مايَقومُ الأَجرُ في غَز","وِكَ لِلرومِ بِإِثمي",32,"ي",1,0],["ما يَقسِمِ اللَهُ أَقبَل غَيرَ مُبتَإِسٍ","مِنهُ وَأَقعُد كَريماً ناعِمَ البالِ",33,"ل",1,0],["ما يقول المقام أيده الل","ه ولا زال للسعود يحوز",34,"ز",1,1],["ما يمسك الهدب دمعي حين أذكركم","إلا كما يمسك الماءَ الغرابيل",35,"ل",1,0],["ما يرفع الظن طرفاً في مكارمه","إلا وعزم الرجا بالنجح منجزم",36,"م",1,0],["ما يبالي إذا بكى من هوان","وافْتقار إذا ضحكتَ عليه",37,"ه",1,0],["ما يَفعَلُ العَبدُ وَالأَقدارُ جارِيَةٌ","عَلَيهِ في كُلِّ حالٍ أَيُّها الرائي",38,"ي",1,1],["ما يُمسخُ المسخُ الذي","لم يُكسَ ما يخشى استلابهْ",39,"ب",2,0],["ما يجتنيهِ غيرُ مُستجلِبٍ","للأجر من أبعد مُستجلَبِ",40,"ب",1,0],["ما ينْشُرُ المُدَّاح عنْ قاسِم","من مُجْمَلٍ فيه ومَشْرُوحِ",41,"ح",1,0],["ما يَجْبن المرءُ إلا وهو معتقدٌ","أو مُشفِقٌ أنّه إن مات لم يَعُدِ",42,"د",1,0],["ما ينفع الحطبَ المحَرَّقَ في الصِّلا","ضوءٌ جريرتُه عليه فسادُ",43,"د",1,0],["ما يومُ بَيْنِ الحبيب بالسَّعْدِ","ولا مُحِبٌّ عليه بالجَلْدِ",44,"د",1,1],["ما يُفيق الكتّابُ من ظلم إبرا","هيمَ يوماً ولا محاباةِ عمرِو",45,"ر",2,1],["ما يحرش الحارِشون ويلَهُمُ","من أفعوانٍ أصَمَّ نهّاش",46,"ش",1,0],["ما يوفيك حقَّك التقريظُ","كُفءُ تقريظك العليمُ الحفيظُ",47,"ظ",1,0],["ما ينفع الصارم اللسان إذا","غودر يوماً وعرضه قطع",48,"ع",1,0],["ما ينقم الحساد منك سوى","أمنٍ شننت عليهم درعه",49,"ع",2,0],["ما يداني إيناقُ منظرك الأب","صارَ إيناقَ ذكرِك الأسماعا",50,"ع",2,0],["ما يرفعُ الشعر أو يشرِّف من","بدرٍ بزُهر النجوم مكتَنف",51,"ف",1,0],["ما يسيء الرأي فيكم","رجل يحمل طِرقا",52,"ق",2,0],["ما يُدانيكَ بعدها خبثُ نشرٍ","بعد عَشرٍ صداك عند انتباشِك",53,"ك",1,0],["ما يعيبُ العماةُ لولا عماهم","من مصابيحَ أُذكيتْ في ذُبالِ",54,"ل",1,0],["ما يقاسي العفاةُ من عضّ دهرٍ","ما يقاسى فيهم من العذَّالِ",54,"ل",1,0],["ما يفي غُنْم غانمٍ نال مأمو","لاً بعيداً بغُرمه أيامَهْ",55,"ه",1,0],["ما يفي غُنْمُ غانمٍ نالَ مأمو","لاً بعيداً بغُرمه الأياما",56,"م",2,0],["ما ينقض الدهرُ من حالٍ ويُبرمها","إلا بنقضٍ لكم فيه وإبرامِ",57,"م",1,0],["مائدةُ السيد مشحونةٌ","تُغنيك باللُّحمان عن لحمي",58,"م",2,0],["ما يَرعَوينَ إِلى داعٍ لِحاجَتِهِ","وَلا لَهُنَّ إِلى ذي شَيبَةٍ وَطَرُ",59,"ر",1,0],["ما يُضيرُ البَحرَ أَمسى زاخِراً","أَن رَمى فيهِ غُلامٌ بِحَجَر",60,"ر",1,1],["ما يُفيدُ الطَيرَ في قَفَصٍ","ضاقَ هَذا الجَوُّ أَرَحِبا",61,"ب",2,0],["ما يَراهُ الناسُ إِلّا واقِفاً","في مَغاني قَومِهِ المُندَثِرَه",62,"ر",2,0],["ما يَحسَبُ الناسُ في رِدائي","في بُردَتي هَيكَلٌ رَميمُ",63,"م",1,0],["ما يَقولُ الناسُ عَنّي","أَنا صَبٌّ مُستَهامُ",64,"م",1,0],["مائِدَةٌ مُنَوَّعَه","وَقَهوَةٌ مُشَعشَعَه",65,"ع",2,1],["ما يَدرَأُ اللَهُ عَنّي مِن عَداوَتِهِم","فَإِنَّ شَرَّهُمُ في الصَدرِ مَحذورُ",66,"ر",1,0],["ما يزال الهضيم يشهق يأساً","ثم لا يشبه الشهيق الشهيقا",67,"ق",2,0],["ما يصنع العصفور اصبح","في مخالب اجدل",68,"ل",1,0],["مائِدَةٌ مَدَّها","بَحرُ نَوالٍ خِضَم",69,"م",1,0],["ما يَنتَهينَ مِنَ الصَلا","ةِ ضَراعَةً وَمِنَ النُذور",70,"ر",1,0],["ما يُجيلُ الطَرفَ إِلّا حَمِدَتهُ","جُهدَها الأَيدي وَذَمَّتهُ الرِقابُ",71,"ب",1,0],["ما يَقبِضُ المَوتُ نَفساً مِن نُفوسِهِمُ","إِلّا وَفي يَدِهِ مِن نَتنِ