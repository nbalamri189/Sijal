{"poems":[[57,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[87,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[87,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[87,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[48,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[108,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[108,"جندي يحمل سلاحين","https://www.poetsgate.com/ViewPoem.aspx?id=179404",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[275,"هذا البنفسج فيه قد لمع الندى","https://www.aldiwan.net/poem35297.html","الكامل"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[422,"هذا البناء الذي محمود أنشأه","https://www.aldiwan.net/poem53878.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138223",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138256",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63860","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63748","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35347","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126648","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113737","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3320,"","https://poetry.dctabudhabi.ae/diwan/poem/144603","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74049","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86542","الكامل"],[4755,"وسَأَلْتُهَا: ولِمَن كِتَابَتُهُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184804",""],[4875,"مشارف مراسيك","https://www.poetsgate.com/ViewPoem.aspx?id=132830",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5121,"مَرْضِيَّةُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=175024",""],[5121,"بَهَاء","https://www.poetsgate.com/ViewPoem.aspx?id=215872",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5358,"النهار الممطر","https://www.poetsgate.com/ViewPoem.aspx?id=32852",""],[5493,"قدر الهاربين","https://www.poetsgate.com/ViewPoem.aspx?id=207427",""],[5601,"تساؤل","https://www.poetsgate.com/ViewPoem.aspx?id=23515",""],[5720,"يا أيها الشبلُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199718",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[5829,"إنه شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=204021",""],[5899,"سابي","https://www.poetsgate.com/ViewPoem.aspx?id=31520",""],[6045,"البشير عامر","https://www.poetsgate.com/ViewPoem.aspx?id=135938",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[231,"طليعة الضحايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79190&r=&rc=64",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""],[6318,"لغتي الجميلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66157&r=&rc=7",""]],"verses":[["هَذا البَلاءُ بِعَينِهِ","يا إِخوَتي يَغدو وَيَطرُق",0,"ق",1,0],["هَذا البِناءُ العَبقَرِيُّ أَتى بِهِ","بَيتٌ لَهُ فَضلٌ وَحَقُّ ذِمامِ",1,"م",1,0],["هَذا البِناءُ الفاطِمِيُّ مَنارَةٌ","وَقَواعِدٌ لِحَضارَةٍ وَدِعامُ",2,"م",1,0],["هَذا البِناءُ الفَخمُ لَي","سَ أَساسُهُ إِلّا الحَفير",3,"ر",1,0],["هذا البلاءُ لقومٍ مال غَافلِهم","عن رأي سيّدِهم إذ يُحكِمُ الأُرَبا",4,"ب",2,0],["هَذا البَياضُ رَسولُ المَوتِ يَبعَثُهُ","في كُلِّ عَصرٍ إِلى الأَجيالِ وَالأُمَمُ",5,"م",1,0],["هذا البريء الذي لم تدرِ مصر له","ذنبًا يخفِّفُ عنها لوعة الألم",6,"م",1,0],["هذا البَنَانُ الرَّخْصُ لاَ","يَقْوَى على حمل السِّلاح",7,"ح",1,0],["هذا البصيرُ يُرينا بين مندرِسٍ","رثِّ المعالم، هذا المرتَعَ الخصِبا",8,"ب",2,0],["هذا البنفسَجُ فيهِ قد لمعَ النَّدى","فكأنَّهُ دمعٌ على حَدَقٍ بدا",9,"د",2,1],["هذا البروني أم بابك زائراً","منك الدعاء مع الرضا يستوهب",10,"ب",1,0],["هذا البناءُ الَّذي محمودُ أنْشَأهُ","وزانَه زُخْرُفُ زاهٍ وتشييدُ",11,"د",1,1],["هذا البناء يفاخر الأهرام في","عظم فليس يفي به إيضاح",12,"ح",1,0],["هذا البنا هو صرح الإستقلال قد","انشاه زغلول فليس يميد",13,"د",1,0],["هذا البيانُ ما شابَهُ لُغُزُ","لم تَعْدُهُ فُرْصَة الإِحسانِ والنُّهزُ",14,"ز",1,1],["هذا البنفسجُ هذا الياسمينُ وذا ال","نِّسرينُ ذا سوسنٌ في الحُسْنِ مشهور",15,"ر",1,0],["هَذا البَديعُ يَعِزُّ شِبهَ بَدائِعٍ","أَبدَعتَهُنَّ بِهِ فَجاءَ غَريبا",16,"ب",2,0],["هذا البراز وهذى البيض واليلب","إن كنت للعرب والإسلام تنتسب",17,"ب",1,0],["هذا البقيعُ وذاك أشرَفُ بُقعَةٍ","الآلُ والأصحابُ فيها أقبِروا",18,"ر",3,0],["هَذَا البَيَانُ يُزِيلُ لَبساً طَالَمَا","هَلَكَت عَلَيهِ النَّاسُ كُلَّ زَمَانِ",19,"ن",1,0],["هذا البنفسج قد بدا","يحكي لنا بين الرياض",20,"ض",1,1],["هَذا البَيان فَقل لمن","قَد ظَلَّ دونَ نَقيضهِ",21,"ض",2,0],["هذا البشير بما دها","ه استحال إلى نذير",22,"ر",1,0],["هذا البُكَاءُ (اليُوسُفِيُّ) أنا","كَلِمَاتُهُ, وأنَا غَيَابَتُهُ",23,"ت",2,0],["هذا البحر وانسى مشارف مراسيك","واسبح مثل ياشوق فلّة ذوايبك",24,"ك",1,0],["هَذَاْ الْبَرِيْقُ بِوَجْهِ السَّيْفِ .. صَاْحِبُهُ","هَذَا الرَّقِيْقُ كَصُلْبِ الْبِيْضِ والْيَلَبِ",25,"ب",1,0],["هَذَا الْبَرِيِقُ الَّذِي فِي كِلْمَتِي","قَدْ شَفَّ نُورَكِ فِي حَرْفِي الظَّمِي",26,"م",2,0],["هَذَا الْبَهَاءُ الَّذِي يَنْسَابُ فِي الوَرَقِ","بِتَائِلٌ عُصِرَتْ مِنْ رَوْضَةِ الخُلُقِ",27,"ق",1,1],["هذا البنا أبدعت في تخطيطه","ورسمت فيه الحب للأكوان",28,"ن",1,0],["هذا البِناءُ فمَنْ يَمُتْ مِنْ بعْدِهِ","ضمِنَتْ لهُ الأركانُ عُمْرَ مُعَمِّرِ",29,"ر",1,0],["هذا البكاء كأنه إرث جثا","فوق الصدور على مسار الحالمينْ",30,"ن",1,0],["هذا البحر الراكد في عيني ؟","في أيهما أدفن جثة أرضي ؟",31,"ي",1,0],["هذا البيانُ .. وغيرهُ مُسْتقبحٌ","لا خيرَ فيهِ .. لكلِّ ذي إيمانِ",32,"ن",1,0],["هذا البديعُ الناضرُ المُجتبَى","أغذوهُ من لحمي ودمعي الصبيب",33,"ب",1,0],["هذا البشير فهللي يا مهجتي","شهر عظيم إنه شعبان",34,"ن",1,0],["هذا البريء بحزنه","يجتاحني يحتلني",35,"ي",1,0],["هذا البشير تَعَلَّا في جوانِحنا","حتى أَمِنَّا عليه ما نُقَارِعُه",36,"ع",2,0],["هذا البراق به طارت وذاك به ال","بساط طار إلى أقصى نواحيها",37,"ي",3,0],["(1): هذا البيت للمؤلف في قصيدة سابقة","(2): هما المرحومان حجاج ودوس شهيد الطيران",38,"ا",2,0],["هذا البريق الذي أغراك من ألقي","ألهاك أن تلحظي حزني وأكداري",39,"ر",2,0],["هذا البيانُ وقدْ صاغتْهُ معْجِزةً","تمضي مع الدّهرِ مجْداً ظلَّ مُتَّصلا",40,"ل",2,0]]}