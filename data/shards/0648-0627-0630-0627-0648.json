y.dctabudhabi.ae/diwan/poem/116531","الكامل"],[4802,"صوتك بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=34384",""],[4802,"والله مصيبه","https://www.poetsgate.com/ViewPoem.aspx?id=36911",""],[3984,"أنا وأنت","https://www.poetsgate.com/ViewPoem.aspx?id=11732",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[4935,"لاحت لعيني زهرة الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=129285",""],[460,"إنَّ التي زَعَمَتْ فُؤَادَكَ مَلَّها","https://www.poetsgate.com/ViewPoem.aspx?id=22228",""],[5032,"حال شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191236",""],[3591,"مرآك يا رب المحاسن في غد","https://www.poetsgate.com/ViewPoem.aspx?id=149535",""],[5136,"لا تدلن إن حباك الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=121588",""],[5168,"ارض الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=33570",""],[5246,"إلى مكة المكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=187043",""],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5444,"صاحبِ الشمسَ ....نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=185386",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5725,"يا ايها البدر","https://www.poetsgate.com/ViewPoem.aspx?id=195274",""],[5747,"تعطشت لضماي","https://www.poetsgate.com/ViewPoem.aspx?id=61614",""],[402,"وإذا وصفت فنونه في فضله","https://www.poetsgate.com/ViewPoem.aspx?id=36059",""],[402,"طيبوا قرارا أيها الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=36333",""],[5909,"يا آخر العشّاق هبْكَ قيامَتي","https://www.poetsgate.com/ViewPoem.aspx?id=210559",""],[5956,"نقشة الفرحة","https://www.poetsgate.com/ViewPoem.aspx?id=182102",""],[5956,"يا فتاةَ النور","https://www.poetsgate.com/ViewPoem.aspx?id=182208",""],[5956,"من نفس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=183294",""],[5956,"عِشْ مَعَ النباتِ والجمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=184145",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[6035,"يرجون عفواً، والذنوب عظامُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177489",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6093,"لا لنْ أُعاشرَ مَنْ يُؤاخذْ (مجزوء الكامل المرفَّل )","https://www.poetsgate.com/ViewPoem.aspx?id=181695",""],[6093,"حلوية عربية","https://www.poetsgate.com/ViewPoem.aspx?id=215567",""],[6225,"سيناءُ مِنّا ولنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81034&r=&rc=271",""],[463,"أخويّ والعشاقُ إخوه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60271&r=&rc=327",""]],"verses":[["وَإِذ أَوتارُنا تَهفو","وَإِذ أَقداحُنا تُترَع",0,"ع",1,0],["وَإِذَا وَجَدْتَ المَرْءَ فِي إِقْدَامِهِ","نَقْصٌ فَلا يُرْجَى هُنَاكَ تَمَامُ",1,"م",1,0],["وإذا وقفت بدارس من مجده","فكوقفة الباكين بين طلوله",2,"ل",2,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَإِذا غَنيتَ فَهُنَّ عَنكَ غَوانِ",3,"ن",1,0],["وَإِذا وَزَنتَ بِمَجدِ قَيسٍ تَغلِباً","رَجَحوا عَلَيكَ وَشُلتَ في الميزانِ",3,"ن",1,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَجَعَلنَ ذَلِكَ مِثلَ بَرقِ الخُلَّبِ",4,"ب",1,0],["وَإِذا وَقَفتَ عَلى المَنازِلِ بِاللِوى","هاجَت عَلَيكَ رُسومُها اِستِعبارا",5,"ر",2,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَإِذا طُلِبنَ لَوَينَ كُلَّ غَريمِ",6,"م",1,0],["وَإِذا وَجَدتُ عَلى الصَديقِ شَكَوتُهُ","سِرّاً إِلَيهِ وَفي المَحافِلِ أَشكُرُ",7,"ر",1,0],["وإذا وليتَ فليسَ يعْدَمُ قائلاً","ما كان رأيُ إمامِنا ليفيلا",8,"ل",2,0],["وإذا وقرْتَ أو اهتَزَزْتَ لصولةٍ","أرسى يلملمُ أو تزعزعَ يذبلُ",9,"ل",1,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَوَجَدتَ عِندَ عِداتِهِنَّ مِطالا",10,"ل",2,0],["وَإِذا وَزَنتَ حُلومَهُنَّ إِلى الصِبا","رَجَحَ الصِبا بِحُلومِهِنَّ فَمالا",10,"ل",2,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","قَفَزَت حَديدَتُهُ إِلَيكَ فَشالا",10,"ل",2,0],["وَإِذا وَرَدتَ الماءَ كانَ لِدارِمٍ","عَفَواتُهُ وَسُهولَةُ الأَعطانِ",11,"ن",1,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","رَجَحوا وَشالَ أَبوكَ في الميزانِ",11,"ن",1,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","رَجَحوا عَلَيكَ وَأَنتَ غَيرُ حَميدِ",12,"د",1,0],["وَإِذا وَقَفتَ عَلى المَنابِرِ أَوشَكَت","أَخشابُها لِلزَهوِ أَن تَتَكَلَّما",13,"م",2,0],["وَإِذا وَعَدتُ الطَرفَ فيكَ بَهجَعَةٍ","فَاِشهَد عَلَيَّ بِأَنَّني لاءَصدُقُ",14,"ق",1,0],["واذا وافته المنية قبلي","فاحفروا حفرة له في فؤادي",15,"د",2,0],["واذا ولّى شباب","المرء فالدنيا خراب",16,"ب",1,0],["وإذا وداد أخيك مات بموته","فاندب وفاء النفس وأنعَ إخاءها",17,"ا",3,0],["وَإِذا وَكَلتَ إِلى كَريمٍ رَأيَهُ","في الجودِ بانَ مَذيقُهُ مِن مَحضِهِ",18,"ض",2,0],["وَإِذا وَسَمنَكَ وَالبَخيلَ بِنَبزَةٍ","كُنتَ المَضَلَّلَ وَالبَخيلُ الراشِدا",19,"د",2,0],["وإذا وَعى مدحاً تَبَسَّمَ ضاحِكاً","واهتزَّ كالرّمحِ انثَنى وتَقَوَّما",20,"م",2,0],["وَإِذا واشٍ وَشى بي عِندَها","نَفَعَ الواشي بِما جاءَ يَضُر",21,"ر",1,1],["وإذا ونى قلبي يدق مكانه","شممي وتخفق كبرياء همومي",22,"ي",1,0],["وَإِذا وَطِئتُ جَنابَهُ قَدَّستُهُ","فَكَأَنَّني أَمشي بِهِ في مَشعَرِ",23,"ر",1,0],["وإذا وصفت بِشَعرِهِ غَسق الدُّجَى","هَجَم الصَّبَاحُ بِثَغرِهِ وجَبِينِهِ",24,"ن",2,0],["وَإِذا وَردة تَفيضُ جَمالاً","تَتَهادى مَعَ النَسيم اللعوبِ",25,"ب",1,0],["وَإِذا وَصَلتَ بِعاقِلٍ أَمَلاً","كانَت نَتيجَةُ قَولِكَ الفِعلا",26,"ل",2,0],["وَإِذا وَصَفتَ الشَيءَ مُتَّبِعاً","لَم تَخلُ مِن زَلَلٍ وَمِن وَهمِ",27,"م",1,0],["وَإِذا وَلّى حَبَونا","هُ بِذِكرى وَسَلامِ",28,"م",1,0],["وَإِذا وَجَدتُ لَها وَساوِسَ سَلوَةٍ","شَفَعَ الضَميرُ لَها إِليَّ فَسَلَّها",29,"ل",3,0],["وَإِذا وُقِّرَت جِبالُ الرَدى جَل","لَت فَلَم تَندَفِع بِجُلِّ جَبيلِ",30,"ل",1,0],["وإذا وصلْتَ إلى ثَنِيّاتِ اللّوَى","فانْشُدْ فؤاداً بالأُبَيْطح طاحا",31,"ح",2,0],["وإذا وَلّتْ تَوَلّتْ مُهْجَتِي","أو تجلّتْ صارتِ الألبابُ فَي",32,"ي",1,0],["وإذا وصلت إلى المَجرَّة فاضربي","فيها طرافاً فوق كل طراف",33,"ف",1,0],["وَإِذَا وَصَفْتَ فُنُونَهُ فِي فَضْلِهِ","فَاذْكُرْ أَيَادِيَهُ عَلى العمَّالِ",34,"ل",1,0],["وَإذا وَعَدْنَكَ نَائِلاً أخْلَفْنَهُ،","يَبْحَثْنَ بالأدَمَى عُرُوقَ الحُلَّبِ",35,"ب",1,0],["وَإِذا وَرقها تَغنَت سَحيراً","فَوق عود أَغنَت عَن العيدان",36,"ن",1,0],["وَإِذَا وَعَدنَ وَفِينَ لَكِنَّ الوَفَا","عَدَمُ الوَفَاءِ فَقَد عُهِدنَ مَوَاطِلا",37,"ل",2,0],["وإذا وجيه الملك قيل فإنه","وَجْهٌ له من كلِّ فضلٍ مُسْعِد",38,"د",1,0],["وَإِذا وَعَدَنَ الناسَ خَيراً جاءَهُم","عَفواً وَأَنتَ لما تَقولُ فَعولُ",39,"ل",1,0],["وَإِذا وَدِدتَ فَإِنَّ وُدَّكَ نافِعٌ","وَمَنِ اِنتَطَحَت فَلَيسَ مِنكَ بِسالِمِ",40,"م",1,0],["وإذا وفى لهمُ مُحبٌّ لم يَفُوا","وإذا تسلّى عنهم لم يعذِروا",41,"ر",3,0],["وإذا وَعَدتُ وَفَيْت لا مُتَبَرِّماً","وإذا هَمَمْت فعلتُ لا مُتَوقِّعا",42,"ع",2,0],["وإذا وصلت قباب سلع جادها","صوب المواهب هاطلاً سحاحا",43,"ح",2,0],["وإذا وَصَفَتْها الآي فَما","تَصِفُ الأشْعارُ والخُطَبُ",44,"ب",1,0],["وَإِذا وَأى لَكَ مَوعِداً","كانَ الفَعالُ مَعَ المَقالِ",45,"ل",1,0],["وَإِذا وَنوا عَنكَ في قَصدٍ بِطَشتُ إِلى","رِضاكَ إِذا لَم يَنَلهُ غَيرُ بِطّاشِ",46,"ش",1,0],["وَاِذا وَصل اِلى معاهد طيبة","وَالناس بَين مُسلم وَمودّع",47,"ع",1,0],["وإذا وجَدْتُ البحرَ كان مُحرَّماً","أن يُستباحَ تَيمُّمٌ بصَعيد",48,"د",1,0],["وإذا وقوا شح النفوس بمالهم","كانوا بأعراضٍ كَرُمْنَ شِحاحا",49,"ح",2,0],["وإذا وصلتَ وصلتَ ذا رحمٍ دنَت","ومودَّةٍ عُرِفَت فليسَت تُنكَرُ",50,"ر",1,0],["وَإِذا وَصَفت بِسحر شِعري ثَغرُهُ","يَوماً سَكَرت بِشَمّ ذِكرى عُرفِهِ",51,"ف",2,0],["وإذا وقفتم بالمشاعر فاذكروا","عبدا بعيدا واشفعوا إلي تؤجروا",52,"ر",3,0],["وإذا وسوست شياطين همٍ","رجمتها شهب المدامة رجما",53,"م",2,0],["وإِذا وردنا حوضَ جدِّك فاستمعْ","وأَبوكَ يَسقِي للرَّواءِ السَّرْمَدِ",54,"د",1,0],["وإذا وردنا الماء فهو مغدفقٌ","طوراً وطوراً من مياه الأخبيه",55,"ي",2,0],["وإذا وازنت الناس ورم","ت شبيههما فلقد تجهد",56,"د",1,0],["وإذا وقفتُ ففي أصم","مَ أمارت الأحداثُ مروَهْ",57,"و",2,0],["وإذا وصفتك فهو وصفُ محاسني","وإذا مدحتُك فهو مدحُ قبائلي",58,"ل",2,0],["وإذا وَفَى لمنايَ يومٌ حاضرٌ","فأجارَ أسلمني غَدٌ غدَّارُ",59,"ر",1,0],["وإذا وشى نطقُ النطاق بها","صمتت خلاخلها من الثقل",60,"ل",1,0],["وإذا ونت منه السوابق","حثَّ من نفسي بحدو",61,"و",1,0],["وَإِذا وَقَّحَ الأَسى مِنهُ وَجها","لا تُسَلِّط عَلَيهِ إِلّا الأَقاحي",62,"ح",2,0],["وإذا وافيتَ منْ شابَهْتَهُ","فارْوِ عنَّا لوْعةَ الوجدِ صِياحا",63,"ح",2,0],["وإِذا وافَيْتَ بطْحَا واسِطٍ","للصُّدَيْرِ الأَخضرِ المُنْحَدِبِ",64,"ب",1,0],["وإذا وعدت فعد بما تقوى على","إنجازه وإذا اصطنعت فتمم",65,"م",1,0],["وإذا وَقفَت أمَامَه يَوماً فَحُطِّي","فَوقَ نعلِه إن تَنازَلَ فَاكِ",66,"ك",1,0],["وإذا ودَّعَت فَودِّع إذن لَه","وَكَ والزَّهوَ أو تَعودَ بتيت",67,"ت",1,0],["وإذا وفى لك بالمرا","دِ فلا تكنْ أبداً خؤونَهْ",68,"ن",2,0],["وإذا وعظتُ بمن أُصِبتُ من الورى","فحِمامُ كلِّ العالمين حِمامي",69,"م",2,0],["وإذا وصلتِ إلى النّعيمِ فهيّنٌ","من قبله ذاك البلاءُ الأعظمُ",70,"م",1,0],["وإِذا وصلتُ إلى الحسين فدى","وَصْلِي له الخُلّانُ والخُلَلُ",71,"ل",1,0],["وإذا وفدتَ إليهمُ عن أزْمَةٍ","فإلي أعزِّ ندىً وأخصبِ مَرْتَعِ",72,"ع",1,0],["وإذا ود وددنا مثله","وهو أمر جل عن أن يوصفا",73,"ف",2,0],["وإذا وصلت إلى ثنيات اللوى","وقصدت نحو المأزمين رواحا",74,"ح",2,0],["وإذا وكلت إِلَهَكَ في","أمر من أمرك فابتهج",75,"ج",1,0],["وإذا وعدتَ النَّفسَ فيهِ براحةٍ","وعَدَتْكَ أن تُثنى بخَجْلةِ كاذبِ",76,"ب",1,0],["وإذا وَقفتِ على الرُّصافةِ فانشُدي","قلبي ولكنْ من لَظاهُ فحاذِري",77,"ر",2,0],["وإِذا وصلتَ إِلى السحائِب قبَلَهُ","فاعلم بأَنَّك ما ظفرتَ بطائِلِ",78,"ل",1,0],["وإِذا وصلْتَ إِلى السَّحائِب قَبْلَه","فاعْلَم بِأَنَّك ما نَقَعْتَ بِها صَدَى",79,"د",2,0],["وَإِذَا وَقَيْتُ بِوَجْنَتَيَّ نِعَالَهُ","عَدَّدْتُ تَقْصِيري مِنَ الزَّلَّاتِ",80,"ت",1,0],["وإذا وَهَتْ أركان وُدْ","دٍ من أخي ثقة فَشٍدْهُ",81,"د",2,0],["وإذا وَليُّكَ لم يُوالِكَ بالذي","يَقضي بِه شرطُ الولاءِ فَعاده",82,"د",2,0],["وإذا وصلتَ بحبلِ آل محمدٍ","حبلَ المودّةٍ مِنك فابلغْ وازدَدِ",83,"د",1,0],["واذا وجدتِ وجدتِ منك بعطفةٍ","حسب المنيّةَ جنَّةً وخلودا",84,"د",2,0],["وإذا وزنت له الحلوم فحلمه","قد جمعت كل الحلوم بفرده",85,"د",2,0],["وإذا وهبتهمُ الذي سألوكه","لم تبق بعدُ مآرب ومسائل",86,"ل",1,0],["وإذا وصلت إلى مراسيه التي","وهنت فإنك أبلغ الناعينا",87,"ن",2,0],["واذا وجدت من العناية سلما","فامدد خطاك وثق بربك وارنق",88,"ق",1,0],["واذا وليت السدْ لا تكون موضح","وأقلع على الشقرا بقايا جرودها",89,"د",3,0],["وإذا وَقَيْتَ أخاك لم أرَ سُبَّةً","وَقْمَ العِدى والشهمُ واقٍ واقمُ",90,"م",1,0],["وإذا ولىَّ فرابط","في بلاياهُ وصابرْ",91,"ر",1,0],["وإذا ولى فقلبي","من أذى البين تَولْوَل",92,"ل",1,0],["وإذا وكلتَ إلى الزمان","ترى العجائب والعبَرْ",93,"ر",1,0],["وَإِذا وَصلتَ إِلى الهُفُوفِ فبَلِّغَن","عنِّي التَحِيَّةَ ساكِنِيهِ أَجمَعا",94,"ع",2,0],["وَإذَا وَجَدْتَ أرَاقِمًا قَدْ أرْسِلَتْ","فَأعْلَمْ بِأنَّكَ لاَ مَحَالَةَ تُلْسَعُ",95,"ع",1,0],["وإِذا وقفت بدستهِ","ورأيته في المشهدِ",96,"د",1,0],["وإذا وجدت فجد له بالنفس وال","أولاد والأموال ذاك لأجلهم",97,"م",1,0],["وإذا ولت السعادة خانت","ه وصارت أعداءه أحبابه",98,"ب",2,0],["وإذا وزينُهُمُ استخفَّك قُل لَهُ","باللَه يا يَحيى بنَ يحيى دَع جُحا",99,"ح",2,0],["وإذا واَى درك المنى","زمنَ الغنى وبدا المباشر",100,"ر",1,0],["وإِذا وَزَنتُكَ بالبريَّةِ في النَّدى","وبَسالةً خَفّت وكُنْتَ الأَرْجَحَا",101,"ح",2,0],["وَإِذا وَجَدتُ لَها وَساوِسَ سَلوَةٍ","شَفَعَ الفُؤادُ إِلى الضَميرِ فَسَلَّها",102,"ل",3,0],["وَإِذا وفيتَ لمن يَفي","لِسِواك دونَك مُتَّ غَيظا",103,"ظ",2,0],["واذا وقفت بباب ذي مجدٍ فقل","اني بعثتُ من الاديب مذكرَّا",104,"ر",2,0],["وإذا وزنت به العوالم كلها","شالت ورجَّح ذاتَه الميزان",105,"ن",1,0],["وإذا وجت بسيوف غنج جفونها","عبد الهوى قالت إمامي الشافعي",106,"ع",2,0],["وإذا وزنتهم فاحكم وزنهم","وأعرف سجاياهم بقلبٍ مبصر",107,"ر",1,0],["وإذا وجدتَ تمتّعاً في باطِلٍ","جاءتك كلُّ حقيقةٍ في عَسكَرِ",108,"ر",1,0],["واذا وجدتَ العطف لذتَ به","ظلا وريفاً، مثمرا كرما",109,"م",2,0],["وإذا وَنَى فيه النسيم رأيته","متشبثاً بمعاطف الأغصان",110,"ن",1,0],["وإذا وثقت بما تدبر في الورى","ضحكت على تدبيرك الأقدارُ",111,"ر",1,0],["وَإذَا وَضعتَ الجَوهَرَينِ وَثَالِثاً","فِي الوَسطِ وَهوَ الحَاجِزُ الوسطَانِ",112,"ن",1,0],["وَإِذا وَجَدتَ العَيشَ يُعقِبُ صَفوُهُ","كَدَراً فَإِنَّ شَقِيَّهُ لَسَعيدُ",113,"د",1,0],["وَإِذا وَجدت عراصهم قَد أَقفَرَت","فَاقرأ عَلى تلك الرُبوع سَلاما",114,"م",2,0],["وإذا ورقها على العود غنت","رقص الغصن بين أيدي النسيم",115,"م",1,0],["وإذا وصلت إلى الحمى","وأمنت من خوف الحمام",116,"م",1,0],["وإذا وراء القلب كان محله","متروياً فهو المهذب مقولا",117,"ل",2,0],["وإذا وقفت على البليل وربعه","جعلتني العذال ذيبا أبيضا",118,"ض",2,0],["وإذا وصلت لذي طوى قم فاغتسل","وادخل ذليلا من كداء حشيما",119,"م",2,0],["واذا ولولت طرابلس في الغر","ب أتاها العويل من إيران",120,"ن",1,0],["وإذا وقفتَ لدى قدومي واثباً","تسطو عليَّ بذا القنا المتميدِ",121,"د",1,0],["وَإِذْا وَصَلْتُ بِشَعْرِهِ قِصَرَ الدُّجى","هَجَمَ الصَّباحُ بِثَغْرِهِ وَجَبينِهِ",122,"ن",2,0],["وَإِذَا وَلَّتْ فَصَبْراً وَاقْتَنِعْ","أَنَّهَا لِلْمَرْءِ مَالٌ مَا انْخَزَلْ",123,"ل",1,0],["واذا وضعت بحفرتي لي حجتي","ثبت وسكن عند ذا روعاتي",124,"ت",2,0],["واذا وردت على الحساب ولم أجد","ما منه يرضى الحق والغرماء",125,"ا",2,0],["وإذا وعت اسماعه آياته","فيروح وهو مشنف ومرعث",126,"ث",1,0],["وإذا وصلتَ فَغضَّ عن وادي الغضا","طَرْفَ المريبِ وحَيِّ عنّي أَهلَهُ",127,"ل",2,0],["وإذا ونيت وسرت في عرصاتها","فاستبق جدتها التي لم تخلق",128,"ق",1,0],["وإذا وكيل موكل أغمى عليه","ليس يعزل فاكتبن ذا في الدرج",129,"ج",1,0],["واذا وعى لكتابة يلقى غدا","معه كتابا منك فيك أمانه",130,"ن",2,0],["واذا وقف في نية الركب مشفوح","يكفي نحب الله صحيح ونخافه",131,"ف",2,0],["واذا وصلت لحلوقنا نورد هيام","والله وكيلك لا وردنا روينا",132,"ن",2,0],["وإذا ولجت رئاتهم نفساً","تضحين أطيب ما يشمونه",133,"ن",2,0],["وَإِذَاْ وَجَدْنَ شَهَاْمَةً مِنْ عَاْشِقٍ","أَطْلَقْنَ مِنْ جُعَبِ التَّنّكُّرِ أَسْهُمَاْ",134,"م",2,0],["وإذا وصلت إلى الصفا وربوعه","متيمماً للساحة الغناء",135,"ا",2,0],["وإِذا وَجَدْتَ لها وَساوِسَ سَلْوَة ٍ","شَفَعَ الضميرُ إلى الفؤادِ فَسَلَّها",136,"ل",3,0],["وإذا وصلتُ إليهِ كاد يخونني","فرحي وتشرقُ بالدموعِ عيوني",137,"ن",2,0],["وإذا وقفت لدى قدومي وائباً","تسطو عليّ بذا القنا المتميد",138,"د",1,0],["وإذا ودك الوزير فعربد","في أمان ولا يهمك الأمير",139,"ر",1,0],["وإذا وازى زغير عللغلط يوم","ما يغلط ولا يتعده هيهات",140,"ت",1,0],["وإذا وصلتم سالمين تذكروا","ما أبتغي ثم اطلبوا الرحمانا",141,"ن",2,1],["وإذا وجَّهتُ وجهي نحوها","ردَّني البُعْدُ وفقدانُ الأثرْ",142,"ر",1,0],["وإذا وصلت إلى العقيق","وفزت فيه بكل سول",143,"ل",1,0],["وإذا وافيتَ طوداً شامخاً","فدعِ الأشعارَ تأتي سربا",144,"ب",2,0],["وإذا وصلت جبال لبنان فمل","نحو الجنوب مراتع الغزلانِ",145,"ن",1,0],["واذا وصلْت الى مشارف حيه","لا تبتديه من العتاب ملاما",146,"م",2,0],["وإذا ودك تعرف إني على كل البشر مغليك","تعال وشوف بعيونك وش اللي بي من اسبابك",147,"ك",1,0],["وإذا وصفت فنونه في فضله","فذاكر أياديه على العمال",148,"ل",1,1],["وإذا وحدت المرء في غقدامه","نقص فلا يرجى هناك تمام",149,"م",1,0],["وإذا وقفتُ إلى الحسابِ فإنني","أخشى أشوقي شاهدٌ بالزورِ",150,"ر",1,0],["وإذا وقت ربيع جاءها","طلع الشوكُ بديلاً بعدها",151,"ا",1,0],["وإذا ولَّى رجائي من فؤادي","هل أرى منك اهتماماً أم سأدْثَرْ؟",152,"ر",1,0],["وإذا وصفتُ مدى عوالم لذتي","لا النور يشبهها ولا القمرُ",153,"ر",1,0],["وإذا وجدتَ فإنما هي ندرة","نظرتْ إلى الدنيا بطرف أعمى",154,"م",2,0],["وإذا وجدتَ الناس عنك بعزلةٍ","فلأنهم لم يشهدوا بك مَنْهلا",155,"ل",2,0],["وإذا وَنَيْتُم والعقولُ تبلّدَتْ","فأنا براءٌ ماعليّ ملامُ !",156,"م",1,0],["وإذا وعدتَ فأنت منجزُ موعدٍ","كانَ الهُمَامُ لِمَا يقولُ فعولا",157,"ل",2,0],["وإذا وجَدتَ ممَجَّدَاً","ومقالهُ في النّاسِ نَافِذْ",158,"ذ",1,0],["وإذا وصفت مشاعري في غيرها","رجعت إلىي قصائدي عبرية",159,"ي",2,0],["وإذا ورُودُ النصرِ في مصرَ التي","دَمِيَتْ بعاقول ِ الأسى تتساقى",160,"ق",2,0],["وإذا وقفتُ ففي أص","مّ أمارت الأحداثُ مروهْ",161,"و",2,0]]}