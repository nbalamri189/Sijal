{"poems":[[73,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[88,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[27,"ما بال نومك بالفراش غرارا","https://www.aldiwan.net/poem5750.html","الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[47,"ويد يراها الدهر غير ذميمة","https://www.aldiwan.net/poem25248.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[29,"أجرير إنك والذي تسمو له","https://www.aldiwan.net/poem6043.html","الكامل"],[29,"أذكرت عهدك فاعترتك صبابة","https://www.aldiwan.net/poem6097.html","البسيط"],[91,"كن بلسما إن صار دهرك أرقما","https://www.aldiwan.net/poem62736.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[43,"فعلت بنا فعل السماء بأرضه","https://www.aldiwan.net/poem9715.html","الكامل"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[61,"ما تم وشك البين حتى تيما","https://www.aldiwan.net/poem51433.html","الكامل"],[49,"وإذا واش وشى بي عندها","https://www.aldiwan.net/poem64206.html","الرمل"],[97,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[81,"خذ من حديث شؤونه وشجونه","https://www.aldiwan.net/poem61302.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[48,"حي الديار وأهلها أهلا","https://www.aldiwan.net/poem65031.html","الكامل"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[48,"اسقني صفو المدام","https://www.aldiwan.net/poem65109.html","مجزوء الرمل"],[50,"إن التي زعمت فؤادك ملها","https://www.aldiwan.net/poem62260.html","الكامل"],[46,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[27,"بَانَ الخَليطُ فَمَا لَهُ مِنْ مَطْلَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16342&r=&rc=6",""],[110,"إن عربيل أطيب البلدان","https://www.aldiwan.net/poem16312.html","الخفيف"],[133,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[186,"مجد تقاصر عن سماه الفرقد","https://www.aldiwan.net/poem14509.html","الكامل"],[196,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[196,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[205,"هجر الملاح نصيب من لا يهجر","https://www.aldiwan.net/poem53308.html","الكامل"],[230,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[232,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[276,"حسب التقريظ حلاك وما","https://www.aldiwan.net/poem25616.html","المتدارك"],[327,"وفتى خلا من ماله","https://www.aldiwan.net/poem44254.html","مجزوء الكامل"],[350,"إليك أنسي بناسي زاد إيحاشي","https://www.aldiwan.net/poem15744.html","البسيط"],[362,"عج بالعقيق وقف بذات الاجرع","https://www.aldiwan.net/poem68093.html","الكامل"],[365,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[365,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[372,"منتك نفسك أن تطيل فتقصر","https://www.aldiwan.net/poem57462.html","الكامل"],[381,"من منصفي من مفرق في عنفه","https://www.aldiwan.net/poem48821.html","الكامل"],[392,"وصل الكتاب مسجع ومحرر","https://www.aldiwan.net/poem54571.html","عموديه"],[417,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[440,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[442,"ثم اعتمدنا رمي أول جمرة","https://www.aldiwan.net/poem14327.html","الكامل"],[444,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[459,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[459,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[465,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[469,"اقض للعيش حاجة الأفراح","https://www.aldiwan.net/poem60301.html","الخفيف"],[501,"أيها الفجر النسيمات شذت","https://www.aldiwan.net/poem38044.html","الرمل"],[501,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[516,"النصر من قرناء عزمك فاعزم","https://www.aldiwan.net/poem12242.html","الكامل"],[539,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[539,"أنا صب متيم ما حييت","https://www.aldiwan.net/poem48258.html","عموديه"],[552,"لا تستعن أبدا بمن","https://www.aldiwan.net/poem47173.html","مجزوء الكامل"],[552,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[552,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[559,"نحن إخوان النبي المصطفى","https://www.aldiwan.net/poem34355.html","الرمل"],[559,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[559,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[563,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[563,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[576,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"],[576,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[587,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"]],"verses":[["وَإِذ أَوتارُنا تَهفو","وَإِذ أَقداحُنا تُترَع",0,"ع",1,0],["وَإِذَا وَجَدْتَ المَرْءَ فِي إِقْدَامِهِ","نَقْصٌ فَلا يُرْجَى هُنَاكَ تَمَامُ",1,"م",1,0],["وإذا وقفت بدارس من مجده","فكوقفة الباكين بين طلوله",2,"ل",2,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَإِذا غَنيتَ فَهُنَّ عَنكَ غَوانِ",3,"ن",1,0],["وَإِذا وَزَنتَ بِمَجدِ قَيسٍ تَغلِباً","رَجَحوا عَلَيكَ وَشُلتَ في الميزانِ",3,"ن",1,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَجَعَلنَ ذَلِكَ مِثلَ بَرقِ الخُلَّبِ",4,"ب",1,0],["وَإِذا وَقَفتَ عَلى المَنازِلِ بِاللِوى","هاجَت عَلَيكَ رُسومُها اِستِعبارا",5,"ر",2,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَإِذا طُلِبنَ لَوَينَ كُلَّ غَريمِ",6,"م",1,0],["وَإِذا وَجَدتُ عَلى الصَديقِ شَكَوتُهُ","سِرّاً إِلَيهِ وَفي المَحافِلِ أَشكُرُ",7,"ر",1,0],["وإذا وليتَ فليسَ يعْدَمُ قائلاً","ما كان رأيُ إمامِنا ليفيلا",8,"ل",2,0],["وإذا وقرْتَ أو اهتَزَزْتَ لصولةٍ","أرسى يلملمُ أو تزعزعَ يذبلُ",9,"ل",1,0],["وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ","وَوَجَدتَ عِندَ عِداتِهِنَّ مِطالا",10,"ل",2,0],["وَإِذا وَزَنتَ حُلومَهُنَّ إِلى الصِبا","رَجَحَ الصِبا بِحُلومِهِنَّ فَمالا",10,"ل",2,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","قَفَزَت حَديدَتُهُ إِلَيكَ فَشالا",10,"ل",2,0],["وَإِذا وَرَدتَ الماءَ كانَ لِدارِمٍ","عَفَواتُهُ وَسُهولَةُ الأَعطانِ",11,"ن",1,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","رَجَحوا وَشالَ أَبوكَ في الميزانِ",11,"ن",1,0],["وَإِذا وَضَعتَ أَباكَ في ميزانِهِم","رَجَحوا عَلَيكَ وَأَنتَ غَيرُ حَميدِ",12,"د",1,0],["وَإِذا وَقَفتَ عَلى المَنابِرِ أَوشَكَت","أَخشابُها لِلزَهوِ أَن تَتَكَلَّما",13,"م",2,0],["وَإِذا وَعَدتُ الطَرفَ فيكَ بَهجَعَةٍ","فَاِشهَد عَلَيَّ بِأَنَّني لاءَصدُقُ",14,"ق",1,0],["واذا وافته المنية قبلي","فاحفروا حفرة له في فؤادي",15,"د",2,0],["واذا ولّى شباب","المرء فالدنيا خراب",16,"ب",1,0],["وإذا وداد أخيك مات بموته","فاندب وفاء النفس وأنعَ إخاءها",17,"ا",3,0],["وَإِذا وَكَلتَ إِلى كَريمٍ رَأيَهُ","في الجودِ بانَ مَذيقُهُ مِن مَحضِهِ",18,"ض",2,0],["وَإِذا وَسَمنَكَ وَالبَخيلَ بِنَبزَةٍ","كُنتَ المَضَلَّلَ وَالبَخيلُ الراشِدا",19,"د",2,0],["وإذا وَعى مدحاً تَبَسَّمَ ضاحِكاً","واهتزَّ كالرّمحِ انثَنى وتَقَوَّما",20,"م",2,0],["وَإِذا واشٍ وَشى بي عِندَها","نَفَعَ الواشي بِما جاءَ يَضُر",21,"ر",1,1],["وإذا ونى قلبي يدق مكانه","شممي وتخفق كبرياء همومي",22,"ي",1,0],["وَإِذا وَطِئتُ جَنابَهُ قَدَّستُهُ","فَكَأَنَّني أَمشي بِهِ في مَشعَرِ",23,"ر",1,0],["وإذا وصفت بِشَعرِهِ غَسق الدُّجَى","هَجَم الصَّبَاحُ بِثَغرِهِ وجَبِينِهِ",24,"ن",2,0],["وَإِذا وَردة تَفيضُ جَمالاً","تَتَهادى مَعَ النَسيم اللعوبِ",25,"ب",1,0],["وَإِذا وَصَلتَ بِعاقِلٍ أَمَلاً","كانَت نَتيجَةُ قَولِكَ الفِعلا",26,"ل",2,0],["وَإِذا وَصَفتَ الشَيءَ مُتَّبِعاً","لَم تَخلُ مِن زَلَلٍ وَمِن وَهمِ",27,"م",1,0],["وَإِذا وَلّى حَبَونا","هُ بِذِكرى وَسَلامِ",28,"م",1,0],["وَإِذا وَجَدتُ لَها وَساوِسَ سَلوَةٍ","شَفَعَ الضَميرُ لَها إِليَّ فَسَلَّها",29,"ل",3,0],["وَإِذا وُقِّرَت جِبالُ الرَدى جَل","لَت فَلَم تَندَفِع بِجُلِّ جَبيلِ",30,"ل",1,0],["وإذا وصلْتَ إلى ثَنِيّاتِ اللّوَى","فانْشُدْ فؤاداً بالأُبَيْطح طاحا",31,"ح",2,0],["وإذا وَلّتْ تَوَلّتْ مُهْجَتِي","أو تجلّتْ صارتِ الألبابُ فَي",32,"ي",1,0],["وإذا وصلت إلى المَجرَّة فاضربي","فيها طرافاً فوق كل طراف",33,"ف",1,0],["وَإِذَا وَصَفْتَ فُنُونَهُ فِي فَضْلِهِ","فَاذْكُرْ أَيَادِيَهُ عَلى العمَّالِ",34,"ل",1,0],["وَإذا وَعَدْنَكَ نَائِلاً أخْلَفْنَهُ،","يَبْحَثْنَ بالأدَمَى عُرُوقَ الحُلَّبِ",35,"ب",1,0],["وَإِذا وَرقها تَغنَت سَحيراً","فَوق عود أَغنَت عَن العيدان",36,"ن",1,0],["وَإِذَا وَعَدنَ وَفِينَ لَكِنَّ الوَفَا","عَدَمُ الوَفَاءِ فَقَد عُهِدنَ مَوَاطِلا",37,"ل",2,0],["وإذا وجيه الملك قيل فإنه","وَجْهٌ له من كلِّ فضلٍ مُسْعِد",38,"د",1,0],["وَإِذا وَعَدَنَ الناسَ خَيراً جاءَهُم","عَفواً وَأَنتَ لما تَقولُ فَعولُ",39,"ل",1,0],["وَإِذا وَدِدتَ فَإِنَّ وُدَّكَ نافِعٌ","وَمَنِ اِنتَطَحَت فَلَيسَ مِنكَ بِسالِمِ",40,"م",1,0],["وإذا وفى لهمُ مُحبٌّ لم يَفُوا","وإذا تسلّى عنهم لم يعذِروا",41,"ر",3,0],["وإذا وَعَدتُ وَفَيْت لا مُتَبَرِّماً","وإذا هَمَمْت فعلتُ لا مُتَوقِّعا",42,"ع",2,0],["وإذا وصلت قباب سلع جادها","صوب المواهب هاطلاً سحاحا",43,"ح",2,0],["وإذا وَصَفَتْها الآي فَما","تَصِفُ الأشْعارُ والخُطَبُ",44,"ب",1,0],["وَإِذا وَأى لَكَ مَوعِداً","كانَ الفَعالُ مَعَ المَقالِ",45,"ل",1,0],["وَإِذا وَنوا عَنكَ في قَصدٍ بِطَشتُ إِلى","رِضاكَ إِذا لَم يَنَلهُ غَيرُ بِطّاشِ",46,"ش",1,0],["وَاِذا وَصل اِلى معاهد طيبة","وَالناس بَين مُسلم وَمودّع",47,"ع",1,0],["وإذا وجَدْتُ البحرَ كان مُحرَّماً","أن يُستباحَ تَيمُّمٌ بصَعيد",48,"د",1,0],["وإذا وقوا شح النفوس بمالهم","كانوا بأعراضٍ كَرُمْنَ شِحاحا",49,"ح",2,0],["وإذا وصلتَ وصلتَ ذا رحمٍ دنَت","ومودَّةٍ عُرِفَت فليسَت تُنكَرُ",50,"ر",1,0],["وَإِذا وَصَفت بِسحر شِعري ثَغرُهُ","يَوماً سَكَرت بِشَمّ ذِكرى عُرفِهِ",51,"ف",2,0],["وإذا وقفتم بالمشاعر فاذكروا","عبدا بعيدا واشفعوا إلي تؤجروا",52,"ر",3,0],["وإذا وسوست شياطين همٍ","رجمتها شهب المدامة رجما",53,"م",2,0],["وإِذا وردنا حوضَ جدِّك فاستمعْ","وأَبوكَ يَسقِي للرَّواءِ السَّرْمَدِ",54,"د",1,0],["وإذا وردنا الماء فهو مغدفقٌ","طوراً وطوراً من مياه الأخبيه",55,"ي",2,0],["وإذا وازنت الناس ورم","ت شبيههما فلقد تجهد",56,"د",1,0],["وإذا وقفتُ ففي أصم","مَ أمارت الأحداثُ مروَهْ",57,"و",2,0],["وإذا وصفتك فهو وصفُ محاسني","وإذا مدحتُك فهو مدحُ قبائلي",58,"ل",2,0],["وإذا وَفَى لمنايَ يومٌ حاضرٌ","فأجارَ أسلمني غَدٌ غدَّارُ",59,"ر",1,0],["وإذا وشى نطقُ النطاق بها","صمتت خلاخلها من الثقل",60,"ل",1,0],["وإذا ونت منه السوابق","حثَّ من نفسي بحدو",61,"و",1,0],["وَإِذا وَقَّحَ الأَسى مِنهُ وَجها","لا تُسَلِّط عَلَيهِ إِلّا الأَقاحي",62,"ح",2,0],["وإذا وافيتَ منْ شابَهْتَهُ","فارْوِ عنَّا لوْعةَ الوجدِ صِياحا",63,"ح",2,0],["وإِذا وافَيْتَ بطْحَا واسِطٍ","للصُّدَيْرِ الأَخضرِ المُنْحَدِبِ",64,"ب",1,0],["وإذا وعدت فعد بما تقوى على","إنجازه وإذا اصطنعت فتمم",65,"م",1,0],["وإذا وَقفَت أمَامَه يَوماً فَحُطِّي","فَوقَ نعلِه إن تَنازَلَ فَاكِ",66,"ك",1,0],["وإذا ودَّعَت فَودِّع إذن لَه","وَكَ والزَّهوَ أو تَعودَ بتيت",67,"ت",1,0],["وإذا وفى لك بالمرا","دِ فلا تكنْ أبداً خؤونَهْ",68,"ن",2,0],["وإذا وعظتُ بمن أُصِبتُ من الورى","فحِمامُ كلِّ العالمين حِمامي",69,"م",2,0],["وإذا وصلتِ إلى النّعيمِ فهيّنٌ","من قبله ذاك البلاءُ الأعظمُ",70,"م",1,0],["وإِذا وصلتُ إلى الحسين فدى","وَصْلِي له الخُلّانُ والخُلَلُ",71,"ل",1,0],["وإذا وفدتَ إليهمُ عن أزْمَةٍ","فإلي أعزِّ ندىً وأخصبِ مَرْتَعِ",72,"ع",1,0],["وإذا ود وددنا مثله","وهو أمر جل عن أن يوصفا",73,"ف",2,0],["وإذا وصلت إلى ثنيات اللوى","وقصدت نحو المأزمين رواحا",74,"ح",2,0],["وإذا وكلت إِلَهَكَ في","أمر من أمرك فابتهج",75,"ج",1,0],["وإذا وعدتَ النَّفسَ فيهِ براحةٍ","وعَدَتْكَ أن تُثنى بخَجْلةِ كاذبِ",76,"ب",1,0],["وإذا وَقفتِ على الرُّصافةِ فانشُدي","قلبي ولكنْ من لَظاهُ فحاذِري",77,"ر",2,0],["وإِذا وصلتَ إِلى السحائِب قبَلَهُ","فاعلم بأَنَّك ما ظفرتَ بطائِلِ",78,"ل",1,0],["وإِذا وصلْتَ إِلى السَّحائِب قَبْلَه","فاعْلَم بِأَنَّك ما نَقَعْتَ بِها صَدَى",79,"د",2,0],["وَإِذَا وَقَيْتُ بِوَجْنَتَيَّ نِعَالَهُ","عَدَّدْتُ تَقْصِيري مِنَ الزَّلَّاتِ",80,"ت",1,0]]}