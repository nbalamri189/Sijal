{"poems":[[55,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[23,"ألا إن ادعاء بني قصي","https://www.aldiwan.net/poem21438.html","الوافر"],[53,"صِلوا نِصف كنيته باسمه","https://www.aldiwan.net/poem66328.html","المتقارب"],[107,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[107,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[108,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[369,"أسائل عنها الركب وهي مع الركب","https://www.aldiwan.net/poem60986.html","الطويل"],[369,"سأنشر أوصاف المهدب مادحا","https://www.aldiwan.net/poem60993.html","الطويل"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[422,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[532,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88600","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104614","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77568","المتدارك"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119960","السريع"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50024","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129818","الرمل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101872","الوافر"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132157","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40097","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54457","الوافر"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138725",""],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18798","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58161","الوافر"],[4478,"لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=15023",""],[5212,"نِداءُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212030",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5444,"آيات الوصال","https://www.poetsgate.com/ViewPoem.aspx?id=205510",""],[5948,"تَصَرَّمتِ الدنيا فليسَ خلودُ","https://www.poetsgate.com/ViewPoem.aspx?id=100588",""],[6019,"هُما جميلان","https://www.poetsgate.com/ViewPoem.aspx?id=176595",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["هُم أَعجَلوا داعي المَنونِ تَعَرُّضاً","لِلطَعنِ بَينَ ذَوابِلٍ وَشِفارِ",0,"ر",1,0],["هُمُ أَعطَوا مَنازِلَها قُرَيشاً","بِمَكَّةَ وَهيَ لَيسَ لَها نِظامُ",1,"م",1,0],["هما عبدُ سوء إذ أُلِّفا","يوافِقُ معناه معناهُما",2,"م",2,0],["هُما عَيْنَا الخيانةِ من قُريشٍ","وأنتَ يَدُ النبيِّ بها يَذُودُ",3,"د",1,0],["هُما عَرَفا السَّبيلَ فلا مُقامٌ","وكيفَ مُقَامُ مُخْتَبَلٍ سَلِيبِ",4,"ب",1,0],["هما عاهلا الشرق العريق وركنُهُ","هما حِصنُهُ الواقي من الحدثانِ",5,"ن",1,0],["هما عزمان: عومٌ من زُجاجٍ","لدى الجُلَّي، وعزمٌ من حديد",6,"د",1,0],["هُمُ اِعتَذَروا قِدماً بِإِشكالِ طُرقِها","عَلَيهِم فَمُذ أَوضَحتَها لَم يَضِح عُذرُ",7,"ر",1,0],["هُما عتادي الكافِيانِ فَقدَ مَن","أَعدَدتُهُ فَليَنأَ عَنّي مَن نَأى",8,"ا",1,0],["هُم أعلَنوا الحربَ العوانَ على سِ","واكَ وأعلنوا حربا عليكَ عوانا",9,"ن",2,0],["هُمُ أَعرضوا عنّي وولّوا بِوَصْلِهمْ","فولّى لذيذُ العيشِ عنّي وأَعرضا",10,"ض",2,0],["هما عُذْرُ هذا الدّهرِ عن كلِ فارِطٍ","ولولاهُما ما كانَ مُغتفَرَ الذّنب",11,"ب",1,0],["هُما عَوَّداني في قديمٍ وحادثٍ","من الدّهر إنْجاحاً لدى كُلّ مطْلب",12,"ب",1,0],["هُم أَعظَمُ الناس أَقداراً ومقدرة","لكن أَتى فَضله من فوق فَضلِهِم",13,"م",1,0],["هم أعوَزوني الصَّبرَ بعد فراقهم","وسار فؤادي حيث ساروا ويمّموا",14,"م",3,0],["هم اعطشوا زرعي فشمتُ سحائباً","غرائب لما أخلفتني القرائب",15,"ب",1,0],["هم أَعتقوا رق الزَمان وغدوا","يَستَعبِدون بالنَدى أَحراره",16,"ر",2,0],["هما عَدَيا بعدَ وانٍ عليكَ","وقد كنت قِدماً على الناسِ عادي",17,"د",2,0],["هما عَلى السفرة يتعشوا","إِلّا وَفار في القاعه يمشي",18,"ش",2,0],["هم أعدوا للقاء العدا","ضوامرا تحسب عقبانا",19,"ن",2,0],["هما على الغاية القصوى فما لهما","وراء ذلك ما تسعى له القدم",20,"م",1,0],["هما علما عزّ تَسامى ذُراهما","ببُنيان مجدٍ لا يُراعُ بهادمِ",21,"م",1,0],["هم اعتصموا به وتوشحوه","فللَه اعتصام واتشاح",22,"ح",1,0],["هم أعلّوه وهم يشفونه","لا شفاه اللّه من ذاك الوصب",23,"ب",1,0],["هما عقدان قد عقدا ونيطا","بأجياد المفاخر والنحور",24,"ر",1,0],["هما عدواك مهما كنت معتصما","فاحذر وَلا تَكُ في الميدان منهزِما",25,"م",2,0],["هما على منكب هذى الصوره","تتبعهما كواكب منيره",26,"ه",1,0],["هم أعدوا له من قبل نشأته","السيف والرمح والبارود والعلما",27,"م",2,0],["هما على الاصل بغير حيف","توافقا في الكم لا في الكيف",28,"ف",1,0],["هُم أَعادوا المَعروفَ غَضّاً وَقَد صو","وَح مُخْضَرَّه وغاضَ بهاؤُه",29,"ا",3,0],["هما عرياني من عدتي","وإلا أريتك قطع الطلى",30,"ل",2,0],["هم اعتادوا الملالَ فكيف ملُّوا","وصالهم وما ملُّوا الملالا",31,"ل",2,0],["هما علة للخلق أعني محمدا","وأول من لما دعا الخلق لباه",32,"ا",2,0],["هُما عَلَيَّ فَإِن أَرضَيتُها رَضِيَت","عَنّي وَإِن غَضِبَت في باطِلٍ غَضِبا",33,"ب",2,0],["هما عِلْمٌ وزهدٌ فيهِ خير","وبعدٌ عن زخاريف الزمان",34,"ن",1,0],["هما عليّ فإن أرضيتهما رضيت","عنيّ وإن غضبت في باطلٍ غضبا",35,"ب",2,0],["هُمْ أُعْلِموا أَنَّ الإلهَ أتى بِهِ","مِنْ قَبْلِ آدَمَ اسمهُ في العالمينْ",36,"ن",1,0],["هما عقدا للسبط أوثق بيعة","وقد ألزماها للرجال الهواديا",37,"ي",2,0],["هما عصرا زيتونة الشعر فانتشى","من النورِ كونٌ قال للناسِ مَن هما",38,"م",2,0],["هما عالمانا أود يا وتخرّما","وما لهما في العالمين نَديِدُ",39,"د",1,0],["هُما ( عليٌّ ) وَوَجهُ الصُّبحِ مَشرِقُهُ","و( أحمدُ ) الشَّمسُ تَمحو الهَمَّ والحَزَنَا",40,"ن",2,0],["هُمَا عَقْدَانِ مُنْذُ أَنِ افْتَرَقْنَا","إِذَا سُعِدَتْ سَعَادَتُنَا تَكُونُ",41,"ن",1,0]]}