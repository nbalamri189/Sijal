ني البُكى وَ التَوَجُّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=28435",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5790,"قد رأيناك والغزالة تسنح","https://www.poetsgate.com/ViewPoem.aspx?id=111949",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5790,"بديع الحسن ما هذا التجني","https://www.poetsgate.com/ViewPoem.aspx?id=112154",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[1920,"من خلف ستار","https://www.poetsgate.com/ViewPoem.aspx?id=195199",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[5964,"أجدك ما ينفك طيفك سارياً","https://www.poetsgate.com/ViewPoem.aspx?id=181301",""],[5969,"على رسل الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=198684",""],[6075,"أجيبي نبض قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190482",""],[1583,"الموعد الضائع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73063&r=&rc=20",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["وَعَهِدتُها خَضراءَ كَيفَ لَقيتُها","أَبصَرتُ فيها مَسرَحاً لِسَوامي",0,"م",2,0],["وَعَهدي بِذاكَ الظَبيِ إِبّانَ زُرتُهُ","رَعاني وَلَم يَحفِل بِعَينَي رَقيبِهِ",1,"ب",2,0],["وَعَهْدِي بِهِ مَهْمَا دَعَوْتُ وَبَيْنَهُ","وَبَيْنِي الْفَلاَ والسيل وَالْخَيْلُ لَبَّانِي",2,"ن",2,0],["وعهْداً بعيْنِ الدّمْعِ للدّمْعِ بعْدَهُ","مَوارِدُ في آماقِنا وبُحورُ",3,"ر",1,0],["وَعَهدُ الشَبابِ وَلَذّاتُهُ","فَإِن يَكُ ذَلِكَ قَد نُتَّدَن",4,"ن",1,0],["وعَهدُه بمُلوكِ الفُرسِ أنّ لها","سُوراً من الجُندِ والأحراسِ يَحميها",5,"ي",3,0],["وَعَهدي بِهِندٍ وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَما في رَيَّةٍ فَتَقَوَّما",6,"م",2,0],["وعهدته للحبّ بيتاً سالماً","فعلامَ يتركه الأسى منهوكا",7,"ك",2,0],["وعهدَ كِسْرى نعيمُ عيشٍ","من ابن كسرى وحسنُ ملهى",8,"ا",1,0],["وعهدُك صِبغةُ اللَّه استُجدّتْ","فلا تَكُ كالخضابِ لها نُصولُ",9,"ل",1,0],["وَعَهدي بِصَبري في الخُطوبِ يُطيعُني","فَما لي أَراهُ اليَومَ أَظهَرَ عِصياني",10,"ن",2,0],["وَعَهدي بِهِ رَحبُ الحَظيرَةِ مُجمِلٌ","يَغُضُّ وَيَعفو عَن كَثيرٍ وَيَحلُمُ",11,"م",1,0],["وَعَهدي بِها تَبكي عَلى التِبنِ وَحدَهُ","فَكَيفَ عَلى فَقدِ الشَعيرِ مُقامُها",12,"م",3,0],["وَعَهدِيَ عَهدي لِذاكَ الوَفا","سَواءٌ وَفَيتَ وَإِن لَم تَفِ",13,"ف",1,0],["وَعَهدي بِها وَالعَيشُ جَمٌّ سُرورُهُ","مَتى شِئتُ لاقاني هُناكَ بِمُفرِحِ",14,"ح",1,0],["وَعَهدي بِها مِن قَبلِ أَن تَحكُمَ النَوى","عَلى عَينِها أَلّا تَدومَ عُهودُها",15,"د",3,0],["وَعَهداً أَبَينا فيهِ إِلّا تَبايُناً","فَلا أَنا ناسيهِ وَلا هُوَ ذاكِرُه",16,"ر",2,0],["وعَهْدي بها مثلُ الفَراقدِ تُنْتَضى","ذَوائِبُها ما بينَ نَسْرٍ وفَرقَدِ",17,"د",1,0],["وعَهْدي بها لا تُديمُ الصدودَ","ولا تتجَّنى عليَّ الذُّنوبا",18,"ب",2,0],["وعهدٌ كانَ فيك ربيع وردٍ","كهذا اليومِ حُسناً وانسجاما",19,"م",2,0],["وعهد بغداد حيث العيش مؤتلقٌ","يهفو خمائل أو يهتز أفنانا",20,"ن",2,0],["وَعَهدي بِها تُحيي الهَوى وَتُميتُهُ","وَتَشعَبُ أَعشارَ الفُؤادِ وَتَصدَعُ",21,"ع",1,0],["وَعَهدي بِها إِذ ناقِضُ العَهدِ بَدرُها","مُراحُ الهَوى فيها وَمَسرَحُهُ الخِصبُ",22,"ب",1,0],["وعهدي ماؤُنا غوراً","فهذا غَوْرُنا ماءَ",23,"ا",2,0],["وَعَهدي بِها مَحفوفَةٌ بِبَدائِعٍ","تَحُلُّ بِمَغناها بُدورٌ وَأَشمُسُ",24,"س",1,0],["وَعَهدي بِسَلمى وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَمى في رَيِّهِ فَتَقَوَّما",25,"م",2,0],["وَعُهودِ ميثاقٍ أَخَذتَ وَزِدتَها","شَدّاً كَما عُقِدَ القَنا بِكُعوبِها",26,"ب",3,0],["وعهدي بهِ والعيشُ مثلُ جِمامهِ","نميرٌ بماءِ الوَردِ والمسكِ مقطوب",27,"ب",1,0],["وَعَهدِ اللَهِ وَالميثا","قِ بَينَ السِترِ وَالمِنبَر",28,"ر",1,0],["وَعَهدي بِالفُراعِ وَأُمِّ بَكرٍ","ثَقالِ الرِدفِ طَيِّبَةِ الرُضابِ",29,"ب",1,0],["وَعَهِدتُني زَمَنَ الشَبيبَةِ ذاكِياً","قَبسي فَأَخمِدَ وَالخُطوبُ تُغَيِّرُ",30,"ر",1,0],["وعهدي بكم تستنقعون مشافرا","من المحض بالأضياف فوق المناضد",31,"د",1,0],["وعهدي بها للأسد قبل مرابضا","فقل لي وأفصح أين سارت أسودها",32,"د",3,0],["وَعَهدي بِلَيلى وَهيَ ذاتُ مُؤَصِّدٍ","تَرُدُّ عَلَينا بِالعَشِيِّ المَواشِيا",33,"ي",2,0],["وَعُهُودَاً لَمْ يَتْرُكِ الدَّهْرُ مِنْهَا","لأَخِي صَبْوَةٍ ذِماماً وَعَهْدَا",34,"د",2,0],["وعهدًا من رخاءٍ؛ لا فقيرٌ","يمد يديه فيه، ولا سؤال",35,"ل",1,0],["وعهدي بكم والنور في الارض ساطع","باوجهكم فاليوم اين ثوى بها",36,"ب",3,0],["وعهدي بكم أن الرسول بحارها","فماذا قضى وحيا بغور عبابها",36,"ب",3,0],["وعهدي بكم أهل الكساء كساءها","فواحربا قد عرّيت من ثيابها",36,"ب",3,0],["وعهدي بكم والعلم في كبد السما","سراجا فما بال الظلام سجى بها",36,"ب",3,0],["وعهدي بكم والأرض أنتم غيوثها","فقد اجدبت من غيثها وسحابها",36,"ب",3,0],["وعهدا بعين الدمع للدمع بعده","موارد في آماقنا وبحرور",37,"ر",1,0],["وعهدنا منزلا قزما هنا","من ترى عملقة ، حتى طمح ؟",38,"ح",1,0],["وعهدي به لا يُرسلُ القولَ واهناً","ولا في بيانٍ عن مرادٍ يعاضل",39,"ل",1,0],["وَعَهدي بِأَيام مضين كَأَنَّها","تَجرد مِن جفن الزَمان مَواضيا",40,"ي",2,0],["وَعَهدي بِهِ وَالعَيش تُندي ظِلالَهُ","وَتَنفح ني رَيّا حَدائِقُهُ نَفحا",41,"ح",2,0],["وعهدِي ببعض يلقطُ النخَلَ بلحها","ويشربُ ماءَ لا يُمِرُّ ولا يَحْلُو",42,"ل",2,0],["وعَهدي بها والعيش أغْيدُ ناعمٌ","وظِلِّى بهاتيك المرابع وَارِفُ",43,"ف",1,0],["وعهدى به يُنض شموس كواعبِ","تسيل دماً مهما تَوَهَّمها الفِكرُ",44,"ر",1,0],["وعهدي قديماً لا يزالُ المدَى وإن","تَوَالَى على الهَمُّ مِن كل جانبِ",45,"ب",1,0],["وعَهدِى بِهَا إِن تَخطُ صَرَّعَها الوَنَى","فَيَحبِسَهَا عَن بَيتِ جارَتِهَا الأدنَى",46,"ن",2,0],["وعهودُكم بالرَّمل قد نُقضتْ","وكذاك من يبنى على الرملِ",47,"ل",1,0],["وعهدى بحملك لا يُستطار","برسمٍ مُحيلٍ وربعٍ قَواءِ",48,"ا",2,0],["وَعَهدي بِأَثمارِ الأَمانِيِّ تُجتَنى","لَدَيهِ وَأَبكارِ المَحامِدِ تُجتَلا",49,"ل",2,0],["وعهدي سوحها بالوفد ملأى","فأضحت بعدكم خلوا دروسا",50,"س",2,0],["وعهدت نفسي راغباً","حيناً فها أنا راهب",51,"ب",1,0],["وعهدي بسعدي يدرك الصب عطفها","ويحمل عن مشاقها نوب الصبر",52,"ر",1,0],["وعهدي بها من قبلُ حُمراً جِمالُها","وخُضراً مَراعيها وبيضاً حسانُها",53,"ن",3,0],["وَعَهدي بِها إِذ ذاكَ وَالشَملُ جامِعٌ","وَصَفوُ التَداني لَم يُدارِكهُ هِجرانُ",54,"ن",1,0],["وَعَهدي بكُم لِلدين أُسداً فما الّذي","لَكُم قَد جَرى حتّى تهيّبتمُ الهرّا",55,"ر",2,0],["وَعَهدي بِهِ وَاللَهِ يُصلِحُ أَمرَهُ","رَحيبُ مَجالِ الرَأيِ مُنبَلِجِ الصَدرِ",56,"ر",1,1],["وَعَهدي بِالظِباءِ وَهنَّ صِيدٌ","فَقَد أَصبَحنَ يَفرسنَ الأُسودا",57,"د",2,0],["وعهدتُ سيفك جدولاً في وِردِهِ","يومَ الكريهة للنفوسِ هيام",58,"م",1,0],["وعهدي بالهوى ملكاً رحيماً","فأينَ تعطفُ الملكِ الرحيمِ",59,"م",1,0],["وعهدك للأقمار كانت منازلا","فما بقيت الا رسولا ومعهدا",60,"د",2,0],["وَعَهدي بِأَحداثِ اللَيالي ضَوارِياً","تَقومُ بِأَهلِ الفَضلِ فيها وَتَقعُدُ",61,"د",1,0],["وَعَهدي بِحِلمي قَبلَ يَومِكَ ثابِتاً","مَتى هَفَّتِ الأَحلامُ بِالناسِ يَرسَخِ",62,"خ",1,0],["وَعَهدي بِكُم قَبلَ إِعراضِكُم","لَهُ أَرَجٌ طَيِّبُ النَفحَةِ",63,"ه",1,0],["وَعُهُوداً سَلَفَتْ لِي بِالْحِمَى","فَسَقَى الْوَبْلُ الْحِمَى غَيْرَ مُضَارْ",64,"ر",1,0],["وعهد مثمر لجا وداد","رطيب الفرع من طيب الغراس",65,"س",1,0],["وعهودهن علي الوفاء لواثق","ان لا يدوم لمثلهن عهود",66,"د",1,0],["وعهدت الوفا وما لعهود","عقدت بالوفا لديه انتكاث",67,"ث",1,0],["وَعَهدِي به يَنْدى نَعيماً ونضْرَةً","فَيُولي الصَّبا نشراً ويُوفي الضُّحى بِشرا",68,"ر",2,0],["وعهدي عهدُ معتقدٍ عليمٍ","بمعتزْ اعتزازك في رُعينِ",69,"ن",1,0],["وَعَهدي بِكُم تَسمِطونَ الجُدَيَّ","فَما بالُكُم تَسمِطونَ التُيوسا",70,"س",2,0],["وَعَهدي بهاتيك المعاهِد وَالرُبى","أَواهلُ لا ينفكُّ يَعطو بها خِشفُ",71,"ف",1,0],["وَعَهِدْتُهُ رُمْحاً أَش","قُّ بهِ الدُّروعَ فَصَارَ حَبْلا",72,"ل",2,0],["وَعَهدُكَ بِالتَذَكُّرِ تَلقَ عَهدا","بِهِ قَد كُنتَ في طَورِ الخَطابِ",73,"ب",1,0],["وَعَهدي أَنَّ طرفك كسرويّ","فَما بالي أَراه حَيدريّا",74,"ي",2,0],["وَعَهدٌ لَنا حَيّا الحَيا مِنهُ مَعهَداً","سَقانا مِن الأَفراح ما هُوَ شارِبُه",75,"ب",2,0],["وعَهْدي بنَفْسي قبلَ ذلك لم أَشِمْ","سَنا بارقٍ إلاّ وجُنَّ جُنوني",76,"ن",2,0],["وعَهْدي بنَفْسي إذا ما حنَنْتُ","دُفعْتُ إلى مُقْعِدٍ لي مُقيم",77,"م",1,0],["وعَهْدٌ لو أَطَعْنا فيه وَجْداً","بكَيْنا كُلَّ يومٍ منه عاما",78,"م",2,0],["وعَهْدُ الورَى بالبَدْرِ والبحرِ قَبْله","وقد فاق كُلاًّ في فُنونِ الفَضائل",79,"ل",1,0],["وعُهودٌ قَدُمْنَ لي في مُوالا","تِكَ يَعطِفْنَ لي فؤادَكَ عَطْفا",80,"ف",2,0],["وعَهدي برَبْعِ العامريّةِ مَرّةً","وَرَكْبُ الهوَى منّا بِواديهِ يُحْتَطّ",81,"ط",1,0],["وعَهْدٌ كما يَزدادُ طولَ تَقادُمٍ","يَزيدُ لها في الراحِ طِيبَ روائح",82,"ح",1,0],["وعهدُ التّصابي كأنّي به","يَمُرُّ كما مَرَّ عهدُ الصِّبا",83,"ا",1,0],["وَعَهد الصِبا وَنَسيم الصَبا","وَصَفو الدنانِ وَرَجعِ القيانِ",84,"ن",1,0],["وَعَهدي بِالعَقارِبِ حينَ تَشتو","تُخَفِّفُ لدغَها وَتقلُّ ضرّا",85,"ر",2,1],["وَعَهدي بِهِ قَبلَ افتراق فَريقنا","وَأَنداؤُهُ كالبَحرِ لَمّا تَموَّجا",86,"ج",2,0],["وعَهدي بها فيما مَضَى وكأنَّها","على الفِضَّةِ البيضاءِ نقشُ سَوَادِ",87,"د",1,0],["وعهدي بذات الضال عذر على الهوى","أَلا للهوى العذْريّ ما جمع الضال",88,"ل",1,0],["وعهداً مضى فيه الشباب وطيبُه","وقد غالَه من طارق الشيب مغتال",88,"ل",1,0],["وعهد في الصَّريم مضى وصَدَّتْ","أوانسُ غيدِه هجرأ وصَرْما",89,"م",2,0],["وعهدي بربع المالكيَّةِ مَصْرَعٌ","إذا خَطَرَتْ فيه الحسان الخرائد",90,"د",1,0],["وعهد هوىً لأيام التصابي","وإنْ كانت لياليه قصارا",91,"ر",2,0],["وعهدي به ما لان قطّ لشدَّةٍ","ولا أَخَذَتْ منه الأُمورُ العظائم",92,"م",1,0],["وعهدي ليله أبداً قصير","فلما سار من أهواه طالا",93,"ل",2,0],["وعهدناهُ ليسَ يُحْسِنُ شِعْرًا","غَيْرَ أَنْ صادَفَ المَقَالَ فَقَالا",94,"ل",2,0],["وعهدنا الزَّمَان يَرْقُدُ طِرْفاً","أَدْهَماً فاكْتَسَى شِيَاتِ أَغَرِّ",95,"ر",1,0],["وعَهِدْتُها طَوْعَ الهوى إِذْ منظري","نَضْرٌ وغصنُ شَبِيبَتِي ريَّانُ",96,"ن",1,0],["وعهدي به رطْبَ العِجانِ فهل نجا","سليماً على ما في السّنام من الدّعْكِ",97,"ك",1,0],["وعهدُكَ بالآمالِ تَصْرِفُ عَنكُمُ","ورَدَّاكُمُ عَهدَ السَّموْأَلِ عَهْدُهُ",98,"د",2,0],["وعهدي غير لاوية بوعدي","وإِن أَلوي بطيتها لواها",99,"ا",3,0],["وعهدي بالنصل المقارع في الوغى","يَفلُّ وهذا فُلَّ منه قرابُه",100,"ب",2,0],["وعهديَ التالدُ فيكم ما الذي","بدّلَه عندكُمُ أو غالَه",101,"ل",2,0],["وعهودٌ جُددٌ