{"poems":[[53,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[53,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[72,"يا بارقا من نحو بشر باسمه","https://www.aldiwan.net/poem19442.html","الكامل"],[51,"لم يله في المهرجان أولى","https://www.aldiwan.net/poem7936.html","مخلع البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[70,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[70,"أياديك عندي لا يغب سجامها","https://www.aldiwan.net/poem42724.html","الطويل"],[70,"لحاظك أمضى من المرهف","https://www.aldiwan.net/poem42815.html","المتقارب"],[45,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[45,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[45,"له الويل من ليل تطاول آخره","https://www.aldiwan.net/poem63564.html","الطويل"],[61,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[61,"يعنفني أن أطلت النحيبا","https://www.aldiwan.net/poem51786.html","المتقارب"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[97,"غيث على القفر حيّانا وأحيانا","https://www.aldiwan.net/poem24977.html","البسيط"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[69,"تولانا فأولانا","https://www.aldiwan.net/poem28918.html","الهزج"],[33,"شجتني وأبلتني منازل درس","https://www.aldiwan.net/poem25898.html","الطويل"],[39,"عرفت لسلمى رسم دار تخالها","https://www.aldiwan.net/poem53698.html","الطويل"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[50,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[46,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42580","الخفيف"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""]],"verses":[["وَعَهِدتُها خَضراءَ كَيفَ لَقيتُها","أَبصَرتُ فيها مَسرَحاً لِسَوامي",0,"م",2,0],["وَعَهدي بِذاكَ الظَبيِ إِبّانَ زُرتُهُ","رَعاني وَلَم يَحفِل بِعَينَي رَقيبِهِ",1,"ب",2,0],["وَعَهْدِي بِهِ مَهْمَا دَعَوْتُ وَبَيْنَهُ","وَبَيْنِي الْفَلاَ والسيل وَالْخَيْلُ لَبَّانِي",2,"ي",1,0],["وعهْداً بعيْنِ الدّمْعِ للدّمْعِ بعْدَهُ","مَوارِدُ في آماقِنا وبُحورُ",3,"ر",1,0],["وَعَهدُ الشَبابِ وَلَذّاتُهُ","فَإِن يَكُ ذَلِكَ قَد نُتَّدَن",4,"ن",1,0],["وعَهدُه بمُلوكِ الفُرسِ أنّ لها","سُوراً من الجُندِ والأحراسِ يَحميها",5,"ي",3,0],["وَعَهدي بِهِندٍ وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَما في رَيَّةٍ فَتَقَوَّما",6,"م",2,0],["وعهدته للحبّ بيتاً سالماً","فعلامَ يتركه الأسى منهوكا",7,"ك",2,0],["وعهدَ كِسْرى نعيمُ عيشٍ","من ابن كسرى وحسنُ ملهى",8,"ا",1,0],["وعهدُك صِبغةُ اللَّه استُجدّتْ","فلا تَكُ كالخضابِ لها نُصولُ",9,"ل",1,0],["وَعَهدي بِصَبري في الخُطوبِ يُطيعُني","فَما لي أَراهُ اليَومَ أَظهَرَ عِصياني",10,"ي",1,0],["وَعَهدي بِهِ رَحبُ الحَظيرَةِ مُجمِلٌ","يَغُضُّ وَيَعفو عَن كَثيرٍ وَيَحلُمُ",11,"م",1,0],["وَعَهدي بِها تَبكي عَلى التِبنِ وَحدَهُ","فَكَيفَ عَلى فَقدِ الشَعيرِ مُقامُها",12,"م",3,0],["وَعَهدِيَ عَهدي لِذاكَ الوَفا","سَواءٌ وَفَيتَ وَإِن لَم تَفِ",13,"ف",1,0],["وَعَهدي بِها وَالعَيشُ جَمٌّ سُرورُهُ","مَتى شِئتُ لاقاني هُناكَ بِمُفرِحِ",14,"ح",1,0],["وَعَهدي بِها مِن قَبلِ أَن تَحكُمَ النَوى","عَلى عَينِها أَلّا تَدومَ عُهودُها",15,"د",3,0],["وَعَهداً أَبَينا فيهِ إِلّا تَبايُناً","فَلا أَنا ناسيهِ وَلا هُوَ ذاكِرُه",16,"ر",2,0],["وعَهْدي بها مثلُ الفَراقدِ تُنْتَضى","ذَوائِبُها ما بينَ نَسْرٍ وفَرقَدِ",17,"د",1,0],["وعَهْدي بها لا تُديمُ الصدودَ","ولا تتجَّنى عليَّ الذُّنوبا",18,"ب",2,0],["وعهدٌ كانَ فيك ربيع وردٍ","كهذا اليومِ حُسناً وانسجاما",19,"م",2,0],["وعهد بغداد حيث العيش مؤتلقٌ","يهفو خمائل أو يهتز أفنانا",20,"ن",2,0],["وَعَهدي بِها تُحيي الهَوى وَتُميتُهُ","وَتَشعَبُ أَعشارَ الفُؤادِ وَتَصدَعُ",21,"ع",1,0],["وَعَهدي بِها إِذ ناقِضُ العَهدِ بَدرُها","مُراحُ الهَوى فيها وَمَسرَحُهُ الخِصبُ",22,"ب",1,0],["وعهدي ماؤُنا غوراً","فهذا غَوْرُنا ماءَ",23,"ا",2,0],["وَعَهدي بِها مَحفوفَةٌ بِبَدائِعٍ","تَحُلُّ بِمَغناها بُدورٌ وَأَشمُسُ",24,"س",1,0],["وَعَهدي بِسَلمى وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَمى في رَيِّهِ فَتَقَوَّما",25,"م",2,0],["وَعُهودِ ميثاقٍ أَخَذتَ وَزِدتَها","شَدّاً كَما عُقِدَ القَنا بِكُعوبِها",26,"ب",3,0],["وعهدي بهِ والعيشُ مثلُ جِمامهِ","نميرٌ بماءِ الوَردِ والمسكِ مقطوب",27,"ب",1,0],["وَعَهدِ اللَهِ وَالميثا","قِ بَينَ السِترِ وَالمِنبَر",28,"ر",1,0],["وَعَهدي بِالفُراعِ وَأُمِّ بَكرٍ","ثَقالِ الرِدفِ طَيِّبَةِ الرُضابِ",29,"ب",1,0],["وَعَهِدتُني زَمَنَ الشَبيبَةِ ذاكِياً","قَبسي فَأَخمِدَ وَالخُطوبُ تُغَيِّرُ",30,"ر",1,0],["وعهدي بها للأسد قبل مرابضا","فقل لي وأفصح أين سارت أسودها",31,"د",3,0],["وَعَهدي بِلَيلى وَهيَ ذاتُ مُؤَصِّدٍ","تَرُدُّ عَلَينا بِالعَشِيِّ المَواشِيا",32,"ي",2,0],["وَعُهُودَاً لَمْ يَتْرُكِ الدَّهْرُ مِنْهَا","لأَخِي صَبْوَةٍ ذِماماً وَعَهْدَا",33,"د",2,0],["وعهدًا من رخاءٍ؛ لا فقيرٌ","يمد يديه فيه، ولا سؤال",34,"ل",1,0],["وعهدا بعين الدمع للدمع بعده","موارد في آماقنا وبحرور",35,"ر",1,0],["وعهدي به لا يُرسلُ القولَ واهناً","ولا في بيانٍ عن مرادٍ يعاضل",36,"ل",1,0]]}