//www.aldiwan.net/poem34888.html","الطويل"],[444,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[454,"تهدل من باناس شط إلى الفلا","https://www.aldiwan.net/poem13671.html","الطويل"],[460,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[460,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[460,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[460,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[460,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[463,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[463,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[463,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[466,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[466,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[466,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[466,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[466,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[466,"لكم من سقامي بالهوى شاهد عدل","https://www.aldiwan.net/poem3604.html","عموديه"],[472,"ألا لا تلمه اليوم أن يتبلدا","https://www.aldiwan.net/poem4657.html","الطويل"],[502,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[502,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[516,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[517,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[517,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[553,"قل للذين تناكصت ثقتي","https://www.aldiwan.net/poem47331.html","أحذ الكامل"],[553,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[553,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[560,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[563,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[564,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[577,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[588,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"],[588,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[589,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21389","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"]],"verses":[["وَعَهِدتُها خَضراءَ كَيفَ لَقيتُها","أَبصَرتُ فيها مَسرَحاً لِسَوامي",0,"م",2,0],["وَعَهدي بِذاكَ الظَبيِ إِبّانَ زُرتُهُ","رَعاني وَلَم يَحفِل بِعَينَي رَقيبِهِ",1,"ب",2,0],["وَعَهْدِي بِهِ مَهْمَا دَعَوْتُ وَبَيْنَهُ","وَبَيْنِي الْفَلاَ والسيل وَالْخَيْلُ لَبَّانِي",2,"ن",2,0],["وعهْداً بعيْنِ الدّمْعِ للدّمْعِ بعْدَهُ","مَوارِدُ في آماقِنا وبُحورُ",3,"ر",1,0],["وَعَهدُ الشَبابِ وَلَذّاتُهُ","فَإِن يَكُ ذَلِكَ قَد نُتَّدَن",4,"ن",1,0],["وعَهدُه بمُلوكِ الفُرسِ أنّ لها","سُوراً من الجُندِ والأحراسِ يَحميها",5,"ي",3,0],["وَعَهدي بِهِندٍ وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَما في رَيَّةٍ فَتَقَوَّما",6,"م",2,0],["وعهدته للحبّ بيتاً سالماً","فعلامَ يتركه الأسى منهوكا",7,"ك",2,0],["وعهدَ كِسْرى نعيمُ عيشٍ","من ابن كسرى وحسنُ ملهى",8,"ا",1,0],["وعهدُك صِبغةُ اللَّه استُجدّتْ","فلا تَكُ كالخضابِ لها نُصولُ",9,"ل",1,0],["وَعَهدي بِصَبري في الخُطوبِ يُطيعُني","فَما لي أَراهُ اليَومَ أَظهَرَ عِصياني",10,"ن",2,0],["وَعَهدي بِهِ رَحبُ الحَظيرَةِ مُجمِلٌ","يَغُضُّ وَيَعفو عَن كَثيرٍ وَيَحلُمُ",11,"م",1,0],["وَعَهدي بِها تَبكي عَلى التِبنِ وَحدَهُ","فَكَيفَ عَلى فَقدِ الشَعيرِ مُقامُها",12,"م",3,0],["وَعَهدِيَ عَهدي لِذاكَ الوَفا","سَواءٌ وَفَيتَ وَإِن لَم تَفِ",13,"ف",1,0],["وَعَهدي بِها وَالعَيشُ جَمٌّ سُرورُهُ","مَتى شِئتُ لاقاني هُناكَ بِمُفرِحِ",14,"ح",1,0],["وَعَهدي بِها مِن قَبلِ أَن تَحكُمَ النَوى","عَلى عَينِها أَلّا تَدومَ عُهودُها",15,"د",3,0],["وَعَهداً أَبَينا فيهِ إِلّا تَبايُناً","فَلا أَنا ناسيهِ وَلا هُوَ ذاكِرُه",16,"ر",2,0],["وعَهْدي بها مثلُ الفَراقدِ تُنْتَضى","ذَوائِبُها ما بينَ نَسْرٍ وفَرقَدِ",17,"د",1,0],["وعَهْدي بها لا تُديمُ الصدودَ","ولا تتجَّنى عليَّ الذُّنوبا",18,"ب",2,0],["وعهدٌ كانَ فيك ربيع وردٍ","كهذا اليومِ حُسناً وانسجاما",19,"م",2,0],["وعهد بغداد حيث العيش مؤتلقٌ","يهفو خمائل أو يهتز أفنانا",20,"ن",2,0],["وَعَهدي بِها تُحيي الهَوى وَتُميتُهُ","وَتَشعَبُ أَعشارَ الفُؤادِ وَتَصدَعُ",21,"ع",1,0],["وَعَهدي بِها إِذ ناقِضُ العَهدِ بَدرُها","مُراحُ الهَوى فيها وَمَسرَحُهُ الخِصبُ",22,"ب",1,0],["وعهدي ماؤُنا غوراً","فهذا غَوْرُنا ماءَ",23,"ا",2,0],["وَعَهدي بِها مَحفوفَةٌ بِبَدائِعٍ","تَحُلُّ بِمَغناها بُدورٌ وَأَشمُسُ",24,"س",1,0],["وَعَهدي بِسَلمى وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَمى في رَيِّهِ فَتَقَوَّما",25,"م",2,0],["وَعُهودِ ميثاقٍ أَخَذتَ وَزِدتَها","شَدّاً كَما عُقِدَ القَنا بِكُعوبِها",26,"ب",3,0],["وعهدي بهِ والعيشُ مثلُ جِمامهِ","نميرٌ بماءِ الوَردِ والمسكِ مقطوب",27,"ب",1,0],["وَعَهدِ اللَهِ وَالميثا","قِ بَينَ السِترِ وَالمِنبَر",28,"ر",1,0],["وَعَهدي بِالفُراعِ وَأُمِّ بَكرٍ","ثَقالِ الرِدفِ طَيِّبَةِ الرُضابِ",29,"ب",1,0],["وَعَهِدتُني زَمَنَ الشَبيبَةِ ذاكِياً","قَبسي فَأَخمِدَ وَالخُطوبُ تُغَيِّرُ",30,"ر",1,0],["وعهدي بكم تستنقعون مشافرا","من المحض بالأضياف فوق المناضد",31,"د",1,0],["وعهدي بها للأسد قبل مرابضا","فقل لي وأفصح أين سارت أسودها",32,"د",3,0],["وَعَهدي بِلَيلى وَهيَ ذاتُ مُؤَصِّدٍ","تَرُدُّ عَلَينا بِالعَشِيِّ المَواشِيا",33,"ي",2,0],["وَعُهُودَاً لَمْ يَتْرُكِ الدَّهْرُ مِنْهَا","لأَخِي صَبْوَةٍ ذِماماً وَعَهْدَا",34,"د",2,0],["وعهدًا من رخاءٍ؛ لا فقيرٌ","يمد يديه فيه، ولا سؤال",35,"ل",1,0],["وعهدا بعين الدمع للدمع بعده","موارد في آماقنا وبحرور",36,"ر",1,0],["وعهدنا منزلا قزما هنا","من ترى عملقة ، حتى طمح ؟",37,"ح",1,0],["وعهدي به لا يُرسلُ القولَ واهناً","ولا في بيانٍ عن مرادٍ يعاضل",38,"ل",1,0],["وَعَهدي بِأَيام مضين كَأَنَّها","تَجرد مِن جفن الزَمان مَواضيا",39,"ي",2,0],["وَعَهدي بِهِ وَالعَيش تُندي ظِلالَهُ","وَتَنفح ني رَيّا حَدائِقُهُ نَفحا",40,"ح",2,0],["وعهدِي ببعض يلقطُ النخَلَ بلحها","ويشربُ ماءَ لا يُمِرُّ ولا يَحْلُو",41,"ل",2,0],["وعَهدي بها والعيش أغْيدُ ناعمٌ","وظِلِّى بهاتيك المرابع وَارِفُ",42,"ف",1,0],["وعهدى به يُنض شموس كواعبِ","تسيل دماً مهما تَوَهَّمها الفِكرُ",43,"ر",1,0],["وعهدي قديماً لا يزالُ المدَى وإن","تَوَالَى على الهَمُّ مِن كل جانبِ",44,"ب",1,0],["وعَهدِى بِهَا إِن تَخطُ صَرَّعَها الوَنَى","فَيَحبِسَهَا عَن بَيتِ جارَتِهَا الأدنَى",45,"ن",2,0],["وعهودُكم بالرَّمل قد نُقضتْ","وكذاك من يبنى على الرملِ",46,"ل",1,0],["وعهدى بحملك لا يُستطار","برسمٍ مُحيلٍ وربعٍ قَواءِ",47,"ا",2,0],["وَعَهدي بِأَثمارِ الأَمانِيِّ تُجتَنى","لَدَيهِ وَأَبكارِ المَحامِدِ تُجتَلا",48,"ل",2,0],["وعهدي سوحها بالوفد ملأى","فأضحت بعدكم خلوا دروسا",49,"س",2,0],["وعهدت نفسي راغباً","حيناً فها أنا راهب",50,"ب",1,0],["وعهدي بسعدي يدرك الصب عطفها","ويحمل عن مشاقها نوب الصبر",51,"ر",1,0],["وعهدي بها من قبلُ حُمراً جِمالُها","وخُضراً مَراعيها وبيضاً حسانُها",52,"ن",3,0],["وَعَهدي بِها إِذ ذاكَ وَالشَملُ جامِعٌ","وَصَفوُ التَداني لَم يُدارِكهُ هِجرانُ",53,"ن",1,0],["وَعَهدي بكُم لِلدين أُسداً فما الّذي","لَكُم قَد جَرى حتّى تهيّبتمُ الهرّا",54,"ر",2,0],["وَعَهدي بِهِ وَاللَهِ يُصلِحُ أَمرَهُ","رَحيبُ مَجالِ الرَأيِ مُنبَلِجِ الصَدرِ",55,"ر",1,1],["وَعَهدي بِالظِباءِ وَهنَّ صِيدٌ","فَقَد أَصبَحنَ يَفرسنَ الأُسودا",56,"د",2,0],["وعهدتُ سيفك جدولاً في وِردِهِ","يومَ الكريهة للنفوسِ هيام",57,"م",1,0],["وعهدي بالهوى ملكاً رحيماً","فأينَ تعطفُ الملكِ الرحيمِ",58,"م",1,0],["وعهدك للأقمار كانت منازلا","فما بقيت الا رسولا ومعهدا",59,"د",2,0],["وَعَهدي بِأَحداثِ اللَيالي ضَوارِياً","تَقومُ بِأَهلِ الفَضلِ فيها وَتَقعُدُ",60,"د",1,0],["وَعَهدي بِحِلمي قَبلَ يَومِكَ ثابِتاً","مَتى هَفَّتِ الأَحلامُ بِالناسِ يَرسَخِ",61,"خ",1,0],["وَعَهدي بِكُم قَبلَ إِعراضِكُم","لَهُ أَرَجٌ طَيِّبُ النَفحَةِ",62,"ه",1,0],["وَعُهُوداً سَلَفَتْ لِي بِالْحِمَى","فَسَقَى الْوَبْلُ الْحِمَى غَيْرَ مُضَارْ",63,"ر",1,0],["وعهد مثمر لجا وداد","رطيب الفرع من طيب الغراس",64,"س",1,0],["وعهودهن علي الوفاء لواثق","ان لا يدوم لمثلهن عهود",65,"د",1,0],["وعهدت الوفا وما لعهود","عقدت بالوفا لديه انتكاث",66,"ث",1,0],["وَعَهدِي به يَنْدى نَعيماً ونضْرَةً","فَيُولي الصَّبا نشراً ويُوفي الضُّحى بِشرا",67,"ر",2,0],["وعهدي عهدُ معتقدٍ عليمٍ","بمعتزْ اعتزازك في رُعينِ",68,"ن",1,0],["وَعَهدي بِكُم تَسمِطونَ الجُدَيَّ","فَما بالُكُم تَسمِطونَ التُيوسا",69,"س",2,0],["وَعَهدي بهاتيك المعاهِد وَالرُبى","أَواهلُ لا ينفكُّ يَعطو بها خِشفُ",70,"ف",1,0],["وَعَهِدْتُهُ رُمْحاً أَش","قُّ بهِ الدُّروعَ فَصَارَ حَبْلا",71,"ل",2,0],["وَعَهدُكَ بِالتَذَكُّرِ تَلقَ عَهدا","بِهِ قَد كُنتَ في طَورِ الخَطابِ",72,"ب",1,0],["وَعَهدي أَنَّ طرفك كسرويّ","فَما بالي أَراه حَيدريّا",73,"ي",2,0],["وَعَهدٌ لَنا حَيّا الحَيا مِنهُ مَعهَداً","سَقانا مِن الأَفراح ما هُوَ شارِبُه",74,"ب",2,0],["وعَهْدي بنَفْسي قبلَ ذلك لم أَشِمْ","سَنا بارقٍ إلاّ وجُنَّ جُنوني",75,"ن",2,0],["وعَهْدي بنَفْسي إذا ما حنَنْتُ","دُفعْتُ إلى مُقْعِدٍ لي مُقيم",76,"م",1,0],["وعَهْدٌ لو أَطَعْنا فيه وَجْداً","بكَيْنا كُلَّ يومٍ منه عاما",77,"م",2,0],["وعَهْدُ الورَى بالبَدْرِ والبحرِ قَبْله","وقد فاق كُلاًّ في فُنونِ الفَضائل",78,"ل",1,0],["وعُهودٌ قَدُمْنَ لي في مُوالا","تِكَ يَعطِفْنَ لي فؤادَكَ عَطْفا",79,"ف",2,0],["وعَهدي برَبْعِ العامريّةِ مَرّةً","وَرَكْبُ الهوَى منّا بِواديهِ يُحْتَطّ",80,"ط",1,0],["وعَهْدٌ كما يَزدادُ طولَ تَقادُمٍ","يَزيدُ لها في الراحِ طِيبَ روائح",81,"ح",1,0],["وعهدُ التّصابي كأنّي به","يَمُرُّ كما مَرَّ عهدُ الصِّبا",82,"ا",1,0],["وَعَهد الصِبا وَنَسيم الصَبا","وَصَفو الدنانِ وَرَجعِ القيانِ",83,"ن",1,0],["وَعَهدي بِالعَقارِبِ حينَ تَشتو","تُخَفِّفُ لدغَها وَتقلُّ ضرّا",84,"ر",2,1],["وَعَهدي بِهِ قَبلَ افتراق فَريقنا","وَأَنداؤُهُ كالبَحرِ لَمّا تَموَّجا",85,"ج",2,0],["وعَهدي بها فيما مَضَى وكأنَّها","على الفِضَّةِ البيضاءِ نقشُ سَوَادِ",86,"د",1,0],["وعهدي بذات الضال عذر على الهوى","أَلا للهوى العذْريّ ما جمع الضال",87,"ل",1,0],["وعهداً مضى فيه الشباب وطيبُه","وقد غالَه من طارق الشيب مغتال",87,"ل",1,0],["وعهد في الصَّريم مضى وصَدَّتْ","أوانسُ غيدِه هجرأ وصَرْما",88,"م",2,0],["وعهدي بربع المالكيَّةِ مَصْرَعٌ","إذا خَطَرَتْ فيه الحسان الخرائد",89,"د",1,0],["وعهد هوىً لأيام التصابي","وإنْ كانت لياليه قصارا",90,"ر",2,0],["وعهدي به ما لان قطّ لشدَّةٍ","ولا أَخَذَتْ منه الأُمورُ العظائم",91,"م",1,0],["وعهدي ليله أبداً قصير","فلما سار من أهواه طالا",92,"ل",2,0],["وعهدناهُ ليسَ يُحْسِنُ شِعْرًا","غَيْرَ أَنْ صادَفَ المَقَالَ فَقَالا",93,"ل",2,0],["وعهدنا الزَّمَان يَرْقُدُ طِرْفاً","أَدْهَماً فاكْتَسَى شِيَاتِ أَغَرِّ",94,"ر",1,0],["وعَهِدْتُها طَوْعَ الهوى إِذْ منظري","نَضْرٌ وغصنُ شَبِيبَتِي ريَّانُ",95,"ن",1,0],["وعهدي به رطْبَ العِجانِ فهل نجا","سليماً على ما في السّنام من الدّعْكِ",96,"ك",1,0],["وعهدُكَ بالآمالِ تَصْرِفُ عَنكُمُ","ورَدَّاكُمُ عَهدَ السَّموْأَلِ عَهْدُهُ",97,"د",2,0],["وعهدي غير لاوية بوعدي","وإِن أَلوي بطيتها لواها",98,"ا",3,0],["وعهدي بالنصل المقارع في الوغى","يَفلُّ وهذا فُلَّ منه قرابُه",99,"ب",2,0],["وعهديَ التالدُ فيكم ما الذي","بدّلَه عندكُمُ أو غالَه",100,"ل",2,0],["وعهودٌ جُددٌ مَرعيَّةٌ","وعهودُ الناسِ أخلاقٌ سُمولُ",101,"ل",1,0],["وعهد ضاع بين يدي وخصمي","وما يرعاه مثلي لا يضيعُ",102,"ع",1,0],["وعهدٍ رَعيْتُ وذي مَلَّةٍ","وصلتُ من الحق ما يَهجُرُ",103,"ر",1,0],["وعهدي بالتشابُهِ والتنافي","يجرَّان التصادقَ والتَّعادي",104,"د",2,0],["وعهدي بنا والدار قربٌ لشاحطٍ","ووصل لمهجورٍ وودٌّ لوامقِ",105,"ق",1,0],["وعهدي بهم والدهر ملقٍ قياده","إلى كل مشبوح الذراع غَشمْشم",106,"م",1,0],["وعهدي بنا والنَّازحُ الدارَ رابعٌ","مُقيمٌ بها والقاطعُ الحبْلَ واصلُ",107,"ل",1,0],["وعهدي لا إفضاله عن جلسيه","ولا فضله عن كل ناد بآئب",108,"ب",1,0],["وعهدي بها والبين ملقٍ قناعه","فمن بائح منا وآخر كاتم",109,"م",1,0],["وعهدي بها من سحب أذيال زينبٍ","وغدرانها زرقٌ وكثبانها خضرُ",110,"ر",1,0],["وعهدي بذاك السّفح وهو كأنّهُ","من النبت خدٌّ بالعذار منمنم",111,"م",1,0],["وعهدي بها قيدُ العيون وللهوى","بها غدواتٌ شائقات وآصال",112,"ل",1,0],["وعهدُ الصبا مثل الصبى بسويقةٍ","تصحُّ به أشواقنا حين تعتلُّ",113,"ل",1,0],["وَعَهدِي بِها صَفراءَ رُوداً كَأَنَّما","نَضَا عَرَقٌ مِنها عَلَى اللَّونِ عَسجَدا",114,"د",2,0],["وعُهودُنا وشُهودُنا ووُفودُنا","لِجَنابِهِمْ وعَزيزِ تلكَ الدَّارِ",115,"ر",1,0],["وعُهودي خُذْها عُهوداً صِراحاً","ما بها رَمْزَةٌ ولا إِيماءُ",116,"ا",2,0],["وعهودٌ بها لنا مُحكماتٌ","حكمَ الدّهرُ باِنفصامِ عُراها",117,"ا",3,0],["وعهدي به يرنو إلي وطرفه","حسير وقلبي دائم الحسرات",118,"ت",1,0],["وعهدي به لما دهاه حمامه","يجاهد كرباً وهو في غمرات",119,"ت",1,0],["وعهدتُكم قولاً بلا عملٍ","فالآنَ لا قولٌ ولا عملُ",120,"ل",1,0],["وعهدي بتمويه عين المحبّ","تنُمُّ على قلبه الطّائرِ",121,"ر",1,0],["وعهودُهنَّ بعيدةٌ","بدهانِ أيدٍ داهناتِ",122,"ت",1,0],["وعهدنا النور المنفر للظل","مة في الحال إن بدا تنفيرا",123,"ر",2,0],["وَعَهدَ عُثمانَ وَعَهداً مِن عُمَر","وَعَهدَ إِخوانٍ هُمُ كانوا الوَزَر",124,"ر",1,0],["وَعَهِدناكَ كُلَّما اتَّسَعَ الخَطْ","بُ حَوالَيكَ كُنتَ أَوسَعَ صَدرا",125,"ر",2,0],["وعَهِدْتُ قَلْبي جِسْرَ مَعْبَرهِ","لكنَّ ذَاكَ الجِسْرَ مُنْكَسِرُ",126,"ر",1,0],["وَعَهْدِي أَنّ الشَّمْسَ بِالصَّحْوِ آذَنَتْ","فَمَا بالُ سُكْرِي مِنْ مُحَيَّاكَ يُقَبِلُ",127,"ل",1,0],["وَعَهْدٌ كُنْتَ تَعْهَدهُ صَحيحٌ","وَقَلْبٌ كُنْتَ تَسْكُنُهُ عَليلُ",128,"ل",1,0],["وعهدي فيكم فيما مضى ذوي محبة","مؤطدة ما شابها قط ما يرما",129,"م",2,0],["وَعَهدي بِها والحَيُّ يَدعونَ غِرَّةً","لَها أَن يَراها الناظِرُ المُتَصَفِّحُ",130,"ح",1,0],["وَعَهدُ الغانِياتِ كَعَهدِ قَينٍ","وَنَت عَنهُ الجَعائِلُ مُستَذاقِ",131,"ق",1,0]]}