 دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[452,"تهدل من باناس شط إلى الفلا","https://www.aldiwan.net/poem13671.html","الطويل"],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[461,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[461,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[461,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[464,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[464,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[464,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[464,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[464,"لكم من سقامي بالهوى شاهد عدل","https://www.aldiwan.net/poem3604.html","عموديه"],[470,"ألا لا تلمه اليوم أن يتبلدا","https://www.aldiwan.net/poem4657.html","الطويل"],[500,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[515,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[515,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[551,"قل للذين تناكصت ثقتي","https://www.aldiwan.net/poem47331.html","أحذ الكامل"],[551,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[558,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[562,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[586,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"],[586,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[587,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["وَعَهِدتُها خَضراءَ كَيفَ لَقيتُها","أَبصَرتُ فيها مَسرَحاً لِسَوامي",0,"م",2,0],["وَعَهدي بِذاكَ الظَبيِ إِبّانَ زُرتُهُ","رَعاني وَلَم يَحفِل بِعَينَي رَقيبِهِ",1,"ب",2,0],["وَعَهْدِي بِهِ مَهْمَا دَعَوْتُ وَبَيْنَهُ","وَبَيْنِي الْفَلاَ والسيل وَالْخَيْلُ لَبَّانِي",2,"ي",1,0],["وعهْداً بعيْنِ الدّمْعِ للدّمْعِ بعْدَهُ","مَوارِدُ في آماقِنا وبُحورُ",3,"ر",1,0],["وَعَهدُ الشَبابِ وَلَذّاتُهُ","فَإِن يَكُ ذَلِكَ قَد نُتَّدَن",4,"ن",1,0],["وعَهدُه بمُلوكِ الفُرسِ أنّ لها","سُوراً من الجُندِ والأحراسِ يَحميها",5,"ي",3,0],["وَعَهدي بِهِندٍ وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَما في رَيَّةٍ فَتَقَوَّما",6,"م",2,0],["وعهدته للحبّ بيتاً سالماً","فعلامَ يتركه الأسى منهوكا",7,"ك",2,0],["وعهدَ كِسْرى نعيمُ عيشٍ","من ابن كسرى وحسنُ ملهى",8,"ا",1,0],["وعهدُك صِبغةُ اللَّه استُجدّتْ","فلا تَكُ كالخضابِ لها نُصولُ",9,"ل",1,0],["وَعَهدي بِصَبري في الخُطوبِ يُطيعُني","فَما لي أَراهُ اليَومَ أَظهَرَ عِصياني",10,"ي",1,0],["وَعَهدي بِهِ رَحبُ الحَظيرَةِ مُجمِلٌ","يَغُضُّ وَيَعفو عَن كَثيرٍ وَيَحلُمُ",11,"م",1,0],["وَعَهدي بِها تَبكي عَلى التِبنِ وَحدَهُ","فَكَيفَ عَلى فَقدِ الشَعيرِ مُقامُها",12,"م",3,0],["وَعَهدِيَ عَهدي لِذاكَ الوَفا","سَواءٌ وَفَيتَ وَإِن لَم تَفِ",13,"ف",1,0],["وَعَهدي بِها وَالعَيشُ جَمٌّ سُرورُهُ","مَتى شِئتُ لاقاني هُناكَ بِمُفرِحِ",14,"ح",1,0],["وَعَهدي بِها مِن قَبلِ أَن تَحكُمَ النَوى","عَلى عَينِها أَلّا تَدومَ عُهودُها",15,"د",3,0],["وَعَهداً أَبَينا فيهِ إِلّا تَبايُناً","فَلا أَنا ناسيهِ وَلا هُوَ ذاكِرُه",16,"ر",2,0],["وعَهْدي بها مثلُ الفَراقدِ تُنْتَضى","ذَوائِبُها ما بينَ نَسْرٍ وفَرقَدِ",17,"د",1,0],["وعَهْدي بها لا تُديمُ الصدودَ","ولا تتجَّنى عليَّ الذُّنوبا",18,"ب",2,0],["وعهدٌ كانَ فيك ربيع وردٍ","كهذا اليومِ حُسناً وانسجاما",19,"م",2,0],["وعهد بغداد حيث العيش مؤتلقٌ","يهفو خمائل أو يهتز أفنانا",20,"ن",2,0],["وَعَهدي بِها تُحيي الهَوى وَتُميتُهُ","وَتَشعَبُ أَعشارَ الفُؤادِ وَتَصدَعُ",21,"ع",1,0],["وَعَهدي بِها إِذ ناقِضُ العَهدِ بَدرُها","مُراحُ الهَوى فيها وَمَسرَحُهُ الخِصبُ",22,"ب",1,0],["وعهدي ماؤُنا غوراً","فهذا غَوْرُنا ماءَ",23,"ا",2,0],["وَعَهدي بِها مَحفوفَةٌ بِبَدائِعٍ","تَحُلُّ بِمَغناها بُدورٌ وَأَشمُسُ",24,"س",1,0],["وَعَهدي بِسَلمى وَالشَبابُ كَأَنَّهُ","عَسيبٌ نَمى في رَيِّهِ فَتَقَوَّما",25,"م",2,0],["وَعُهودِ ميثاقٍ أَخَذتَ وَزِدتَها","شَدّاً كَما عُقِدَ القَنا بِكُعوبِها",26,"ب",3,0],["وعهدي بهِ والعيشُ مثلُ جِمامهِ","نميرٌ بماءِ الوَردِ والمسكِ مقطوب",27,"ب",1,0],["وَعَهدِ اللَهِ وَالميثا","قِ بَينَ السِترِ وَالمِنبَر",28,"ر",1,0],["وَعَهدي بِالفُراعِ وَأُمِّ بَكرٍ","ثَقالِ الرِدفِ طَيِّبَةِ الرُضابِ",29,"ب",1,0],["وَعَهِدتُني زَمَنَ الشَبيبَةِ ذاكِياً","قَبسي فَأَخمِدَ وَالخُطوبُ تُغَيِّرُ",30,"ر",1,0],["وعهدي بها للأسد قبل مرابضا","فقل لي وأفصح أين سارت أسودها",31,"د",3,0],["وَعَهدي بِلَيلى وَهيَ ذاتُ مُؤَصِّدٍ","تَرُدُّ عَلَينا بِالعَشِيِّ المَواشِيا",32,"ي",2,0],["وَعُهُودَاً لَمْ يَتْرُكِ الدَّهْرُ مِنْهَا","لأَخِي صَبْوَةٍ ذِماماً وَعَهْدَا",33,"د",2,0],["وعهدًا من رخاءٍ؛ لا فقيرٌ","يمد يديه فيه، ولا سؤال",34,"ل",1,0],["وعهدا بعين الدمع للدمع بعده","موارد في آماقنا وبحرور",35,"ر",1,0],["وعهدنا منزلا قزما هنا","من ترى عملقة ، حتى طمح ؟",36,"ح",1,0],["وعهدي به لا يُرسلُ القولَ واهناً","ولا في بيانٍ عن مرادٍ يعاضل",37,"ل",1,0],["وَعَهدي بِأَيام مضين كَأَنَّها","تَجرد مِن جفن الزَمان مَواضيا",38,"ي",2,0],["وَعَهدي بِهِ وَالعَيش تُندي ظِلالَهُ","وَتَنفح ني رَيّا حَدائِقُهُ نَفحا",39,"ح",2,0],["وعهدِي ببعض يلقطُ النخَلَ بلحها","ويشربُ ماءَ لا يُمِرُّ ولا يَحْلُو",40,"ل",2,0],["وعَهدي بها والعيش أغْيدُ ناعمٌ","وظِلِّى بهاتيك المرابع وَارِفُ",41,"ف",1,0],["وعهدى به يُنض شموس كواعبِ","تسيل دماً مهما تَوَهَّمها الفِكرُ",42,"ر",1,0],["وعهدي قديماً لا يزالُ المدَى وإن","تَوَالَى على الهَمُّ مِن كل جانبِ",43,"ب",1,0],["وعَهدِى بِهَا إِن تَخطُ صَرَّعَها الوَنَى","فَيَحبِسَهَا عَن بَيتِ جارَتِهَا الأدنَى",44,"ن",2,0],["وعهودُكم بالرَّمل قد نُقضتْ","وكذاك من يبنى على الرملِ",45,"ل",1,0],["وعهدى بحملك لا يُستطار","برسمٍ مُحيلٍ وربعٍ قَواءِ",46,"ا",2,0],["وَعَهدي بِأَثمارِ الأَمانِيِّ تُجتَنى","لَدَيهِ وَأَبكارِ المَحامِدِ تُجتَلا",47,"ل",2,0],["وعهدي سوحها بالوفد ملأى","فأضحت بعدكم خلوا دروسا",48,"س",2,0],["وعهدت نفسي راغباً","حيناً فها أنا راهب",49,"ب",1,0],["وعهدي بسعدي يدرك الصب عطفها","ويحمل عن مشاقها نوب الصبر",50,"ر",1,0],["وعهدي بها من قبلُ حُمراً جِمالُها","وخُضراً مَراعيها وبيضاً حسانُها",51,"ن",3,0],["وَعَهدي بِها إِذ ذاكَ وَالشَملُ جامِعٌ","وَصَفوُ التَداني لَم يُدارِكهُ هِجرانُ",52,"ن",1,0],["وَعَهدي بكُم لِلدين أُسداً فما الّذي","لَكُم قَد جَرى حتّى تهيّبتمُ الهرّا",53,"ر",2,0],["وَعَهدي بِهِ وَاللَهِ يُصلِحُ أَمرَهُ","رَحيبُ مَجالِ الرَأيِ مُنبَلِجِ الصَدرِ",54,"ر",1,1],["وَعَهدي بِالظِباءِ وَهنَّ صِيدٌ","فَقَد أَصبَحنَ يَفرسنَ الأُسودا",55,"د",2,0],["وعهدتُ سيفك جدولاً في وِردِهِ","يومَ الكريهة للنفوسِ هيام",56,"م",1,0],["وعهدي بالهوى ملكاً رحيماً","فأينَ تعطفُ الملكِ الرحيمِ",57,"م",1,0],["وعهدك للأقمار كانت منازلا","فما بقيت الا رسولا ومعهدا",58,"د",2,0],["وَعَهدي بِأَحداثِ اللَيالي ضَوارِياً","تَقومُ بِأَهلِ الفَضلِ فيها وَتَقعُدُ",59,"د",1,0],["وَعَهدي بِحِلمي قَبلَ يَومِكَ ثابِتاً","مَتى هَفَّتِ الأَحلامُ بِالناسِ يَرسَخِ",60,"خ",1,0],["وَعَهدي بِكُم قَبلَ إِعراضِكُم","لَهُ أَرَجٌ طَيِّبُ النَفحَةِ",61,"ه",1,0],["وَعُهُوداً سَلَفَتْ لِي بِالْحِمَى","فَسَقَى الْوَبْلُ الْحِمَى غَيْرَ مُضَارْ",62,"ر",1,0],["وعهد مثمر لجا وداد","رطيب الفرع من طيب الغراس",63,"س",1,0],["وعهودهن علي الوفاء لواثق","ان لا يدوم لمثلهن عهود",64,"د",1,0],["وعهدت الوفا وما لعهود","عقدت بالوفا لديه انتكاث",65,"ث",1,0],["وَعَهدِي به يَنْدى نَعيماً ونضْرَةً","فَيُولي الصَّبا نشراً ويُوفي الضُّحى بِشرا",66,"ر",2,0],["وعهدي عهدُ معتقدٍ عليمٍ","بمعتزْ اعتزازك في رُعينِ",67,"ن",1,0],["وَعَهدي بِكُم تَسمِطونَ الجُدَيَّ","فَما بالُكُم تَسمِطونَ التُيوسا",68,"س",2,0],["وَعَهدي بهاتيك المعاهِد وَالرُبى","أَواهلُ لا ينفكُّ يَعطو بها خِشفُ",69,"ف",1,0],["وَعَهِدْتُهُ رُمْحاً أَش","قُّ بهِ الدُّروعَ فَصَارَ حَبْلا",70,"ل",2,0],["وَعَهدُكَ بِالتَذَكُّرِ تَلقَ عَهدا","بِهِ قَد كُنتَ في طَورِ الخَطابِ",71,"ب",1,0],["وَعَهدي أَنَّ طرفك كسرويّ","فَما بالي أَراه حَيدريّا",72,"ي",2,0],["وَعَهدٌ لَنا حَيّا الحَيا مِنهُ مَعهَداً","سَقانا مِن الأَفراح ما هُوَ شارِبُه",73,"ب",2,0],["وعَهْدي بنَفْسي قبلَ ذلك لم أَشِمْ","سَنا بارقٍ إلاّ وجُنَّ جُنوني",74,"ي",1,0],["وعَهْدي بنَفْسي إذا ما حنَنْتُ","دُفعْتُ إلى مُقْعِدٍ لي مُقيم",75,"م",1,0],["وعَهْدٌ لو أَطَعْنا فيه وَجْداً","بكَيْنا كُلَّ يومٍ منه عاما",76,"م",2,0],["وعَهْدُ الورَى بالبَدْرِ والبحرِ قَبْله","وقد فاق كُلاًّ في فُنونِ الفَضائل",77,"ل",1,0],["وعُهودٌ قَدُمْنَ لي في مُوالا","تِكَ يَعطِفْنَ لي فؤادَكَ عَطْفا",78,"ف",2,0],["وعَهدي برَبْعِ العامريّةِ مَرّةً","وَرَكْبُ الهوَى منّا بِواديهِ يُحْتَطّ",79,"ط",1,0],["وعَهْدٌ كما يَزدادُ طولَ تَقادُمٍ","يَزيدُ لها في الراحِ طِيبَ روائح",80,"ح",1,0],["وعهدُ التّصابي كأنّي به","يَمُرُّ كما مَرَّ عهدُ الصِّبا",81,"ا",1,0],["وَعَهد الصِبا وَنَسيم الصَبا","وَصَفو الدنانِ وَرَجعِ القيانِ",82,"ن",1,0],["وَعَهدي بِالعَقارِبِ حينَ تَشتو","تُخَفِّفُ لدغَها وَتقلُّ ضرّا",83,"ر",2,1],["وَعَهدي بِهِ قَبلَ افتراق فَريقنا","وَأَنداؤُهُ كالبَحرِ لَمّا تَموَّجا",84,"ج",2,0],["وعَهدي بها فيما مَضَى وكأنَّها","على الفِضَّةِ البيضاءِ نقشُ سَوَادِ",85,"د",1,0],["وعهدي بذات الضال عذر على الهوى","أَلا للهوى العذْريّ ما جمع الضال",86,"ل",1,0],["وعهداً مضى فيه الشباب وطيبُه","وقد غالَه من طارق الشيب مغتال",86,"ل",1,0],["وعهد في الصَّريم مضى وصَدَّتْ","أوانسُ غيدِه هجرأ وصَرْما",87,"م",2,0],["وعهدي بربع المالكيَّةِ مَصْرَعٌ","إذا خَطَرَتْ فيه الحسان الخرائد",88,"د",1,0],["وعهد هوىً لأيام التصابي","وإنْ كانت لياليه قصارا",89,"ر",2,0],["وعهدي به ما لان قطّ لشدَّةٍ","ولا أَخَذَتْ منه الأُمورُ العظائم",90,"م",1,0],["وعهدي ليله أبداً قصير","فلما سار من أهواه طالا",91,"ل",2,0],["وعهدناهُ ليسَ يُحْسِنُ شِعْرًا","غَيْرَ أَنْ صادَفَ المَقَالَ فَقَالا",92,"ل",2,0],["وعهدنا الزَّمَان يَرْقُدُ طِرْفاً","أَدْهَماً فاكْتَسَى شِيَاتِ أَغَرِّ",93,"ر",1,0],["وعَهِدْتُها طَوْعَ الهوى إِذْ منظري","نَضْرٌ وغصنُ شَبِيبَتِي ريَّانُ",94,"ن",1,0],["وعهدي به رطْبَ العِجانِ فهل نجا","سليماً على ما في السّنام من الدّعْكِ",95,"ك",1,0],["وعهدُكَ بالآمالِ تَصْرِفُ عَنكُمُ","ورَدَّاكُمُ عَهدَ السَّموْأَلِ عَهْدُهُ",96,"د",2,0],["وعهدي غير لاوية بوعدي","وإِن أَلوي بطيتها لواها",97,"ا",3,0],["وعهدي بالنصل المقارع في الوغى","يَفلُّ وهذا فُلَّ منه قرابُه",98,"ب",2,0],["وعهديَ التالدُ فيكم ما الذي","بدّلَه عندكُمُ أو غالَه",99,"ل",2,0],["وعهودٌ جُددٌ مَرعيَّةٌ","وعهودُ الناسِ أخلاقٌ سُمولُ",100,"ل",1,0],["وعهد ضاع بين يدي وخصمي","وما يرعاه مثلي لا يضيعُ",101,"ع",1,0],["وعهدٍ رَعيْتُ وذي مَلَّةٍ","وصلتُ من الحق ما يَهجُرُ",102,"ر",1,0],["وعهدي بالتشابُهِ والتنافي","يجرَّان التصادقَ والتَّعادي",103,"ي",1,0],["وعهدي بنا والدار قربٌ لشاحطٍ","ووصل لمهجورٍ وودٌّ لوامقِ",104,"ق",1,0],["وعهدي بهم والدهر ملقٍ قياده","إلى كل مشبوح الذراع غَشمْشم",105,"م",1,0],["وعهدي بنا والنَّازحُ الدارَ رابعٌ","مُقيمٌ بها والقاطعُ الحبْلَ واصلُ",106,"ل",1,0],["وعهدي لا إفضاله عن جلسيه","ولا فضله عن كل ناد بآئب",107,"ب",1,0],["وعهدي بها والبين ملقٍ قناعه","فمن بائح منا وآخر كاتم",108,"م",1,0],["وعهدي بها من سحب أذيال زينبٍ","وغدرانها زرقٌ وكثبانها خضرُ",109,"ر",1,0],["وعهدي بذاك السّفح وهو كأنّهُ","من النبت خدٌّ بالعذار منمنم",110,"م",1,0],["وعهدي بها قيدُ العيون وللهوى","بها غدواتٌ شائقات وآصال",111,"ل",1,0],["وعهدُ الصبا مثل الصبى بسويقةٍ","تصحُّ به أشواقنا حين تعتلُّ",112,"ل",1,0],["وَعَهدِي بِها صَفراءَ رُوداً كَأَنَّما","نَضَا عَرَقٌ مِنها عَلَى اللَّونِ عَسجَدا",113,"د",2,0],["وعُهودُنا وشُهودُنا ووُفودُنا","لِجَنابِهِمْ وعَزيزِ تلكَ الدَّارِ",114,"ر",1,0],["وعُهودي خُذْها عُهوداً صِراحاً","ما بها رَمْزَةٌ ولا إِيماءُ",115,"ا",2,0],["وعهودٌ بها لنا مُحكماتٌ","حكمَ الدّهرُ باِنفصامِ عُراها",116,"ا",3,0],["وعهدي به يرنو إلي وطرفه","حسير وقلبي دائم الحسرات",117,"ت",1,0],["وعهدي به لما دهاه حمامه","يجاهد كرباً وهو في غمرات",118,"ت",1,0],["وعهدتُكم قولاً بلا عملٍ","فالآنَ لا قولٌ ولا عملُ",119,"ل",1,0],["وعهدي بتمويه عين المحبّ","تنُمُّ على قلبه الطّائرِ",120,"ر",1,0],["وعهودُهنَّ بعيدةٌ","بدهانِ أيدٍ داهناتِ",121,"ت",1,0],["وعهدنا النور المنفر للظل","مة في الحال إن بدا تنفيرا",122,"ر",2,0],["وَعَهدَ عُثمانَ وَعَهداً مِن عُمَر","وَعَهدَ إِخوانٍ هُمُ كانوا الوَزَر",123,"ر",1,0],["وَعَهِدناكَ كُلَّما اتَّسَعَ الخَطْ","بُ حَوالَيكَ كُنتَ أَوسَعَ صَدرا",124,"ر",2,0],["وعَهِدْتُ قَلْبي جِسْرَ مَعْبَرهِ","لكنَّ ذَاكَ الجِسْرَ مُنْكَسِرُ",125,"ر",1,0],["وَعَهْدِي أَنّ الشَّمْسَ بِالصَّحْوِ آذَنَتْ","فَمَا بالُ سُكْرِي مِنْ مُحَيَّاكَ يُقَبِلُ",126,"ل",1,0],["وَعَهْدٌ كُنْتَ تَعْهَدهُ صَحيحٌ","وَقَلْبٌ كُنْتَ تَسْكُنُهُ عَليلُ",127,"ل",1,0],["وعهدي فيكم فيما مضى ذوي محبة","مؤطدة ما شابها قط ما يرما",128,"م",2,0]]}