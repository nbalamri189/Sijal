{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[65,"من الطوالع من نجد تظلهم","https://www.aldiwan.net/poem45743.html","البسيط"],[79,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[74,"قلب ذلول وغادة صعبه","https://www.aldiwan.net/poem18237.html","المنسرح"],[53,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[53,"بحرمة أيري يا كنيزة إنه","https://www.aldiwan.net/poem64070.html","الطويل"],[30,"أعض حمي ساقه السيف بعدما","https://www.aldiwan.net/poem1284.html",""],[79,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[124,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[139,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[242,"أعضلت علتي فجئت رئيسا","https://www.aldiwan.net/poem19700.html","الخفيف"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[266,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[285,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[287,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[385,"البدر يغار إذا سفرا","https://www.aldiwan.net/poem48784.html","المتدارك"],[385,"من منصفي من مفرق في عنفه","https://www.aldiwan.net/poem48821.html","الكامل"],[385,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[409,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138262",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122722","المتقارب"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122899","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201706","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109908","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132149","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77078","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94397","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104918","الرجز"],[4767,"استئثار","https://www.poetsgate.com/ViewPoem.aspx?id=185275",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5131,"هذا هو الإسلام في مفهومه","https://www.poetsgate.com/ViewPoem.aspx?id=58407",""],[5232,"حوريَّة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=212768",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""]],"verses":[["أَعَضُّ بَناني إِصبَعاً ثُمَّ إِصبَعاً","عَلى ثامِرٍ مِن فَرعِ مَجدٍ وَوارِقِ",0,"ق",1,0],["أَعُضُّ كَفِّيَ مِن غَيظي فَشيمَتُهُ","أَنْ يُتبِعَ الرَّأسَ مِن أَبنائِهِ الذَّنَبا",1,"ب",2,0],["أَعْضَاؤُهُمْ فِيهَا حُرُوفٌ قُطِّعَتْ","أَثَرُ الْمِدَادِ بِهَا نَجِيعٌ قَانِي",2,"ن",2,0],["أعضايَ في كسوةِ السقامِ بها","ولمتي في المشيب في شهبه",3,"ب",2,0],["أعضاؤها تدعو إلى قطعِها","كأنها مخلوقة من بُظورْ",4,"ر",1,0],["أعضِّي شبا الموسَى بأنفكِ عضةً","فأنفُكِ أولى بالخِتان من البظر",5,"ر",1,0],["أَعَضَّ حُمَيٌّ ساقَهُ السَيفَ بَعدَما","رَأى المَوتَ يَغشى واسِطَ الرَحلِ راكِبُه",6,"ب",2,1],["أعضاؤهم فيها حروف قطعت","أثر المداد بها نجيع قان",7,"ن",1,0],["أعض على الماضي البنان تحسرا","وهل ينفعني اليوم عض بنانيا",8,"ي",2,0],["أعضِ الشبابَ نصيبهُ حيث الزما","ن مطاوعُ واعكف على الصهباءِ",9,"ا",2,0],["أَعْضَلَتْ عِلَّتِي فَجِئْتُ رَئِيسَا","فَاقَ فِي الطِّبِّ أَرِسْطَا طَالِيسَا",10,"س",2,1],["أعضائي الذنبُ لقد هدّمْ","وخميس الخطب فقد أدهمْ",11,"م",1,0],["اعضاء صب ماله الاك","من عينيك واق",12,"ق",1,0],["أَعَضْبَ الدَّوْلَةِ اخْتَرَمَتْكَ مِنّا","يَدٌ ما لِلأَنامِ بِها يَدانِ",13,"ن",1,0],["أَعَضْبَ الدَّوْلَةِ الْمَأْمُولَ صَبْراً","وَكَيْفَ وَهَلْ إِلى صَبْرٍ سَبيلُ",14,"ل",1,0],["أَعضاؤُها مُتَناسِباتٌ في العُلا","مِثلُ الفَرائِدِ زانَهُنَّ نِظامُ",15,"م",1,0],["أَعضاء قَد رَقَت حَتّى","لَو أَضمَرَ شَيئاً ما اِستَتَرا",16,"ر",2,0],["أَعضاؤُهُ نَمَت عَلى أَسرارِهِ","فَبَدَت وَحَتفي كامن في طَرفِهِ",17,"ف",2,0],["أَعضاؤُهُ نَمَت عَلى ما اِستَودَعَت","أَوهامُهُ مِن رِقة وَصَفاءِ",18,"ا",2,0],["أعضلت إذ أرسلت لي مسنداً","عذرك ذا المردود في الانتقاد",19,"د",1,0],["أعضاؤه نهضوا بأقدس واجب","ولهم على كل الأنام أياد",20,"د",1,0],["أعَضتَ غَنيَّهُم والفَقيرَ","بالأهلِ أهلاً وبِالمالِ مالا",21,"ل",2,0],["أعضك اللَه ابا نهشل","بخد ريم شادن أكحل",22,"ل",1,1],["أعضّ على كفي لكشف سرائري","وأقرع من بوحي بها سنّ نادم",23,"م",1,0],["أعضها شوقا وإن","أدى الى اغضابها",24,"ب",3,0],["اعضد السيف بالشجاعة وانظر","ضربات الحسام كيف تكون",25,"ن",1,0],["أَعضاؤُكَ انتحلت وانتَ مُقوَّسُ","وعَياكَ مِحضارٌ وعقلُكَ غائبُ",26,"ب",1,0],["أعضاك رب العرش عمن فقدته","فما زلت غض العمر كمطلع أقمار",27,"ر",1,0],["أَعضاؤُهُ في اِنتفاض وَهُو يَسترها","بالبَعض بعضا فَوا اثما وواحرجا",28,"ج",2,0],["أعضاءه صم الحدود الحداد","أهوت عليه بالبكا والعويل",29,"ل",1,0],["أعضاء جسمى كل فرد فرد","شبهت وجنتي بالتفاح",30,"ح",1,0],["أَعض مِن نَدَم كَفي عَلى زَمَن","مَضى وَمالي بِكُم وَصلٌ وَلا سَبَبُ",31,"ب",1,0],["أعضاؤُها سادةٌ سادوا بحكمتهم","وَفاخروا بالتسامي كل من سلفا",32,"ف",2,0],["أعضل داء قلة الحظ فكم","أعيى الدوا كل طبيب حاذق",33,"ق",1,0],["أعضائها لم تتحد","فالجسم كان محطما",34,"م",2,0],["أَعْضَاْءُ حِزْبِ الْبَعْثِ شَنُّوْا حَمْلَةً","هَمَجِيَّةً ، وَتَغَطْرَسُوْا وَأَسَاْؤُوْا",35,"ا",1,0],["أعضا الوفودِ، تحيّةٌ من شاعر","كالزهر في ثمر وفي أنسام",36,"م",1,0],["أعضاؤها سُبحانَ خالقها","جسدٌ به التكوين ُ مُتسّقُ",37,"ق",1,0],["اعضاء جسم المرء لم تترك سدى","حتى غدت لقلبه كالخدم",38,"م",1,0]]}