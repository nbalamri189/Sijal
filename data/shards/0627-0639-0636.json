{"poems":[[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[63,"من الطوالع من نجد تظلهم","https://www.aldiwan.net/poem45743.html","البسيط"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[72,"قلب ذلول وغادة صعبه","https://www.aldiwan.net/poem18237.html","المنسرح"],[51,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[51,"بحرمة أيري يا كنيزة إنه","https://www.aldiwan.net/poem64070.html","الطويل"],[28,"أعض حمي ساقه السيف بعدما","https://www.aldiwan.net/poem1284.html",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[118,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[133,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[235,"أعضلت علتي فجئت رئيسا","https://www.aldiwan.net/poem19700.html","الخفيف"],[257,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[259,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[278,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[278,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[280,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[377,"البدر يغار إذا سفرا","https://www.aldiwan.net/poem48784.html","المتدارك"],[377,"من منصفي من مفرق في عنفه","https://www.aldiwan.net/poem48821.html","الكامل"],[377,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[400,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"]],"verses":[["أَعَضُّ بَناني إِصبَعاً ثُمَّ إِصبَعاً","عَلى ثامِرٍ مِن فَرعِ مَجدٍ وَوارِقِ",0,"ق",1,0],["أَعُضُّ كَفِّيَ مِن غَيظي فَشيمَتُهُ","أَنْ يُتبِعَ الرَّأسَ مِن أَبنائِهِ الذَّنَبا",1,"ب",2,0],["أَعْضَاؤُهُمْ فِيهَا حُرُوفٌ قُطِّعَتْ","أَثَرُ الْمِدَادِ بِهَا نَجِيعٌ قَانِي",2,"ن",2,0],["أعضايَ في كسوةِ السقامِ بها","ولمتي في المشيب في شهبه",3,"ب",2,0],["أعضاؤها تدعو إلى قطعِها","كأنها مخلوقة من بُظورْ",4,"ر",1,0],["أعضِّي شبا الموسَى بأنفكِ عضةً","فأنفُكِ أولى بالخِتان من البظر",5,"ر",1,0],["أَعَضَّ حُمَيٌّ ساقَهُ السَيفَ بَعدَما","رَأى المَوتَ يَغشى واسِطَ الرَحلِ راكِبُه",6,"ب",2,1],["أعضاؤهم فيها حروف قطعت","أثر المداد بها نجيع قان",7,"ن",1,0],["أعض على الماضي البنان تحسرا","وهل ينفعني اليوم عض بنانيا",8,"ي",2,0],["أعضِ الشبابَ نصيبهُ حيث الزما","ن مطاوعُ واعكف على الصهباءِ",9,"ا",2,0],["أَعْضَلَتْ عِلَّتِي فَجِئْتُ رَئِيسَا","فَاقَ فِي الطِّبِّ أَرِسْطَا طَالِيسَا",10,"س",2,1],["أعضائي الذنبُ لقد هدّمْ","وخميس الخطب فقد أدهمْ",11,"م",1,0],["اعضاء صب ماله الاك","من عينيك واق",12,"ق",1,0],["أَعَضْبَ الدَّوْلَةِ اخْتَرَمَتْكَ مِنّا","يَدٌ ما لِلأَنامِ بِها يَدانِ",13,"ن",1,0],["أَعَضْبَ الدَّوْلَةِ الْمَأْمُولَ صَبْراً","وَكَيْفَ وَهَلْ إِلى صَبْرٍ سَبيلُ",14,"ل",1,0],["أَعضاؤُها مُتَناسِباتٌ في العُلا","مِثلُ الفَرائِدِ زانَهُنَّ نِظامُ",15,"م",1,0],["أَعضاء قَد رَقَت حَتّى","لَو أَضمَرَ شَيئاً ما اِستَتَرا",16,"ر",2,0],["أَعضاؤُهُ نَمَت عَلى أَسرارِهِ","فَبَدَت وَحَتفي كامن في طَرفِهِ",17,"ف",2,0],["أَعضاؤُهُ نَمَت عَلى ما اِستَودَعَت","أَوهامُهُ مِن رِقة وَصَفاءِ",18,"ا",2,0],["أعضلت إذ أرسلت لي مسنداً","عذرك ذا المردود في الانتقاد",19,"د",1,0]]}