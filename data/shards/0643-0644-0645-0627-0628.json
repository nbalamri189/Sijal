{"poems":[[55,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[47,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[51,"طول التعاشر بين الناس مملول","https://www.aldiwan.net/poem63048.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43845","البسيط"],[102,"محنة الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50162",""],[102,"المحكوم عليه","https://www.poetsgate.com/ViewPoem.aspx?id=50352",""],[228,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[255,"أيهذا الأمير قد أشكل المعنى","https://www.aldiwan.net/poem15043.html","الخفيف"],[347,"ما حياتي تعب في ملل","https://www.aldiwan.net/poem55344.html","الرمل"],[443,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[449,"يا عشير الصبا الكريم السجيه","https://www.aldiwan.net/poem56046.html","عموديه"],[469,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199577","المسحوب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145776","الخفيف"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145637","المديد"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133768","الخفيف"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101914","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143883","المتقارب"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48215","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201314","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101597","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216534",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205904","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83506","الخفيف"],[4718,"ياصاح مالي ومال الحب ودروبه","https://www.poetsgate.com/ViewPoem.aspx?id=137246",""],[4869,"نظم الاحاسيس","https://www.poetsgate.com/ViewPoem.aspx?id=151614",""],[5055,"عبارات الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=101657",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5764,"قتلتني","https://www.poetsgate.com/ViewPoem.aspx?id=137059",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["كُلَّما باخَ ضَوؤُها أَقضَموها","بِالقُبَيباتِ مَندَليّاً وَغارا",0,"ر",2,0],["كُلَّما بَكَّرَت عَلَيهِ سَماءٌ","حيكَ إِفرِندُهُ وَصيغَ فَريدُه",1,"د",2,0],["كُل ما بَدا لَكَ فَالآكالُ فانِيَةٌ","وَكُلُّ ذي أُكُلٍ لا بُدَّ مَأكولُ",2,"ل",1,0],["كَلِّم أَباكَ الَّذي يُنادي","وَهوَ مِنَ السُقمِ في نُهوكِ",3,"ك",1,0],["كلّ ما بي أودعته الشعر لكن","في ضميري شعر أنا منه مضنى",4,"ن",2,0],["كلّ ما بينكم سقطّم عراة","وهوى حاملا رداء غسيلا",5,"ل",2,0],["كُلُّ ما بي زَها وَغَنّى وَلكِن","في لِساني تَرَدَّدَ العَندَليبُ",6,"ب",1,0],["كلما باتَ وهو يأمر بالأكل","أتى الفَقرُ مُقبلاً يَنهاني",7,"ن",2,0],["كلما بشّ بوجهي حاضر","ضاع في طياته مستقبلي",8,"ل",2,0],["كلما بأن لغص البان معنى","من معانيك ثناه في التثني",9,"ن",2,0],["كلما بت والكتاب سميري","أتهجى أيامنا المدرسيه",10,"ي",2,0],["كلّما بنتُ عنهُ أدناه فكري","ومطايا الأفكار تدني المزار",11,"ر",1,0],["كلما بغيت غْضاها","ما ذالت وهجعت",12,"ت",1,0],["كلما بالغت جبال بطول","ظهرت من ورائها أكتافي",13,"ي",1,0],["كُلَّمَا بَرْقُ الدُّجَى لَمَعا","هَاجَ فِي تِذْكارِهم وَلَعا",14,"ا",1,0],["كلما باح واجد بهواه","أقبل الفجر مرهف الاذان",15,"ن",1,0],["كلما بان للنواظر سطر","منه أخفي عن النواظر سطرا",16,"ر",2,0],["كلما بادحٍ الحسام عموداً","أعمد الاضطراب في أحشاها",17,"ا",3,0],["كلما بَلْبَلَتْهُما راحةُ التَّج","ميش هاجَتْ سواكنَ البَلْبَالِ",18,"ل",1,0],["كل ما بين الثَنايا وَاللمى","عَن سَبيل الوصل للهجر عدل",19,"ل",1,0],["كلَّما بالغصون قَاسُوهُ قالتْ","مقلتي ما أَصَبْتُمُ في القياس",20,"س",1,0],["كُلَّما بَين المَساعي وَالحِمى","أَخصبت فيهِ سُهولاً وَشِعابا",21,"ب",2,0],["كل ما بي خلقتْه همتي","لم يورثني أبي غيرَ الطموح",22,"ح",1,0],["كُلَّما باشرها الماء جلا","ثَغرها فَانظر لِتَزويج الأَيامى",23,"م",2,0],["كل ما بي في الكون أعمى ومنقا","د على رغمه لأعمى نظيره",24,"ر",2,0],["كِلّ ما بنيت الصبر يِهْدم","واسطول مَعْ صاروخ والغام",25,"م",1,0],["كلما باح جدود وبنون","بِرُؤاهُ، ورجال ونساء",26,"ا",2,0],["كُلُّ ما بي فانٍ وحبُّكِ باقِ","وَدَليلي لَواعجُ الأَشواقِ",27,"ق",1,1],["كل مابغيت اقترب واشوف مطلوبه","يعطيني الكذبه اللي ماتقربني",28,"ن",2,0],["كل مابعدنا زاد هم القراطيس","والحرف يفضح مانكنّه بقافه",29,"ف",2,0],["كلما بديت السرد يعشَبْ ويرويكْ","تستحضرك أرواح من جنة الحور",30,"ر",1,0],["كلما بكيتهم قالوا: الغريق","أو تنفّست لهم صاحوا: الحريق",31,"ق",1,0],["كل مابغيت أروح درت وجيتلك","بودعك لكن مابيك تضمني",32,"ن",2,0],["كل ما بالأمر إني أكتب إحساسٍ رزين","لا رحل فكري إليكم / للغضى / للشاذليه",33,"ي",2,0],["كلما بالرفس يرمي","أنا أرميه بفلةْ",34,"ل",2,0],["كُلَّما بِابتِسامَةٍ يَتَباهَى","مُهَجُ العِشقِ فِي فَمِي تَتَفَطَّرْ",35,"ر",1,0],["كُل ما برد حَمه يوازن لَهيبها","لا ما دَعت جسمي النَحيف هباه",36,"ا",2,0]]}