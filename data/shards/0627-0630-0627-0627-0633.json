8,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[461,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[461,"حمى الله اقبالا حماية دينه","https://www.aldiwan.net/poem15457.html","الطويل"],[461,"ينيخ المسيف النضو منه بممرع","https://www.aldiwan.net/poem15487.html","الطويل"],[461,"لله در غمام سح صيبه","https://www.aldiwan.net/poem15914.html","البسيط"],[461,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[461,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[461,"وقال رواة الحي لا بل غواته","https://www.aldiwan.net/poem16056.html","الطويل"],[461,"بنو المظفر والأيام شاهدة","https://www.aldiwan.net/poem16066.html","البسيط"],[461,"إذا أسبل الصوب اليميني أنبتت","https://www.aldiwan.net/poem16367.html","الطويل"],[461,"أقول وقد ضاقت قوافي مدائحي","https://www.aldiwan.net/poem16433.html","الطويل"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[464,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[468,"رغيفي لا سواه عند نفسي","https://www.aldiwan.net/poem60071.html","الوافر"],[468,"لنا خل موارده ملاء","https://www.aldiwan.net/poem60544.html","الوافر"],[479,"الوافر","https://www.aldiwan.net/poem36955.html","الوافر"],[479,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[493,"إذا استلك الجانون أغمدك الحلم","https://www.aldiwan.net/poem67329.html","الطويل"],[513,"قسمك عليك الدهر نصفا تعتبا","https://www.aldiwan.net/poem67783.html","الطويل"],[515,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[516,"اذا استبق الناس العلا سبقتهم","https://www.aldiwan.net/poem48626.html","الطويل"],[548,"إذا أسهلت خبت وإن أحزنت مشت","https://www.aldiwan.net/poem1182.html",""],[551,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[553,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[562,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[562,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[575,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[586,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"],[586,"متى يعطف الجاني وتقضى وعوده","https://www.aldiwan.net/poem17488.html","الطويل"],[586,"كلفت بحب مستوفي","https://www.aldiwan.net/poem17499.html","مجزوء الوافر"]],"verses":[["إِذا اِستَطلَعتَهُ مِن سِجفِ بَيتٍ","ظَنَنتَ بِأَنَّهُ بَعضُ الغَواني",0,"ي",1,0],["إِذا اِستَجَرَ الضَربُ الدَراكُ تَمَطَّقَت","إِلى الطَعنِ أَفواهُ النُسورِ الحَوائِمِ",1,"م",1,0],["إِذا اِستَطالَت هُمومُهُ سَكِرَت","في كَفِّهِ البيضُ وَاِنتَشى القَلَمُ",2,"م",1,0],["إِذا اِستَبَقَت يَوماً تَراخى تَبيعُها","وَخَلّى لَها الشَأوَ البَعيدَ رَسيلُها",3,"ل",3,0],["إِذا أَسقَطَ السَيرُ العَنيفُ نِعالَها","مِنَ الأَينِ أَحذَتها الدِماءُ نِعالا",4,"ل",2,0],["إِذا اِستَوحَشَت آذانُها مِن تَنوفَةٍ","وَحَمحَمَ وَخدٌ دائِبٌ وَذَميلُ",5,"ل",1,0],["إِذا اِستَهَبّوا سُيوفَهُم أَبَداً","فَلِم أُعِدَ الغُمودُ وَالحُلَلُ",6,"ل",1,0],["إِذا اِسوَدَّ خَطبٌ دونَهُ وَهوَ أَبيَضٌ","يُسَوِّدُ وَاِبيَضَّت عَلَيهِ مَطالِعُه",7,"ع",2,0],["إِذا اِستَرعَفَتهُ هِمَّةٌ مِنكَ غادَرَت","قَوادِمَهُ تَجري وَعيداً وَمَوعِدا",8,"د",2,0],["إِذا اِستُصرِخوا عَصَفوا بِالصَبا","حِ بَينَ الظُبى وَالوُجوهِ الصِباحِ",9,"ح",1,0],["إِذا اِستَقصَينَ غامِضَةَ الدَياجي","فَقَأتُ بِهِنَّ عاشِيَةَ الصَباحِ",10,"ح",1,0],["إِذا اِستَبَقَ القَومُ طُرقَ النَجاءِ","وَذَمَّ الجَبانُ قُعودَ الهَرَب",11,"ب",1,0],["إِذا اِستَنهَضَت هِمَمي عَزمَةٌ","عَصَفتُ بِأَيدي المَطيِّ العِرابِ",12,"ب",1,0],["إِذا اِستَبهَمَت عَلياءُ لا يُهتَدى لَها","قَرَعتُ بِهِ دونَ الأَخِلّاءِ بابَها",13,"ب",3,0],["إِذا اِستَخبَرَ الواشُونَ عَمّا أُسِرُّهُ","حَمَدتُ سُلوى أَو ذَمَمتُ التَّصابِيا",14,"ي",2,0],["إذا استَلَّ مني طارِقُ الخَطْبِ عَزْمَةً","فلابُدّ من نَيْلِ المَعالي أوِ الرّدى",15,"د",2,0],["إذا اسْتَلَبَ النّومُ العِنانَ منَ اليَدِ","عَلِقْتُ بأعْطافِ الخَيالِ المُسَهَّدِ",16,"د",1,1],["إذا اسْتَطارَتْ طِلاعَ الأُفْقِ أرْدَفَها","بالبيضِ عُوِّضْنَ عن أغْمادِها القِمَما",17,"م",2,0],["إذا اسْتَرْقَصَ السّاقي بمَزْجٍ حَبابَها","تَرَدّى بمِثْلِ اللُّؤلُوِ الرَّطْبِ عِقْيانُ",18,"ن",1,0],["إذا اسْتَمْطَرَ العافونَ منْ نَفَحاتِها","تَثَنَّتْ إلَيْهنَّ الغَمائِمُ تَنْتَمي",19,"م",2,0],["إذا استَنامَتْ إِلى العِصيانِ مارِقةٌ","يَأبى لها الحَيْنُ أن تَبقى إِلى حِينِ",20,"ن",1,0],["إِذا اِستَقبَلَتني الريحُ مِن نَحوِ أَرضِها","تَنَشَّقتُها حَتّى تَرِقَّ الخَياشِمُ",21,"م",1,0],["إذا اسْتَشْعَرَتْها النّفْسُ عاهَدَتِ الجَوى","إذا التَمَحَتْها العيْنُ عاقَدَتِ السُّهْدا",22,"د",2,0],["إِذا اِستَقبَلتَ وَجهَ أَبي حُسَينٍ","رَأَيتَ البَدرَ راقَ الناظِرينا",23,"ن",2,0],["إِذا اِستَوزَرتَ فَاِستَوزِر عَلَينا","فَتىً كَالفَضلِ أَو كَاِبنِ العَميدِ",24,"د",1,0],["إِذا اِستَوى بَينَ رِجلَيها اِمرُؤٌ نَطَقَت","بِمُزعِجاتٍ مِنَ الأَصواتِ مُتَّصِلَه",25,"ل",2,0],["إِذا اِستَلأَموا يَومَ النِزالِ حَسِبتَهُم","أُسودَ العَرينِ الغُلبِ في غابَةِ السُمرِ",26,"ر",1,0],["إِذا آسَفَ الثُكلُ اللَبيبَ فَشَفَّهُ","رَأى أَفدَحَ الثَكلَينِ أَن يَهلِكَ الأَجرُ",27,"ر",1,0],["إِذا أَسِفَ الثَكلُ اللَبيبَ فَشَفَّهُ","رَأى أَبرَحَ الثَكلَينِ أَن يَحبِطَ الأَجرُ",28,"ر",1,0],["إِذا استُحفِظَت سِرَّ السُرى جُنحَ لَيلِها","تَناسى النَمومانِ الأُلُوَّةُ وَالنَدُّ",29,"د",1,0],["إِذا أَسهَبَ المُثنونَ فيهِ شَأَتهُمُ","مَراتِبُ عُليا كَلَّ عَن عَفوِها الجُهدُ",29,"د",1,0],["إِذا اِستَقبَلَتها الريحُ حالَ رُغامُها","وَحالَفَ جَولانَ السَرابِ أَرومُها",30,"م",3,0],["إِذا اِستَدبَرَتهُ الريحُ كَي تَستَخِفَّهُ","تَراجَنَ مِلحاحٌ إِلى المَكثِ مُرجفُ",31,"ف",1,0],["إِذا اِستَغشَتِ الأَجوافُ أَجلادُ شَتوَةٍ","وَأَصبَحَ يَحمومٌ بِهِ الثَلجُ جامِدُ",32,"د",1,0],["إِذَا اسْتَعَدَتْ عَلَى الآفَاتِ مِصْرٌ","فَقَدْ نُصِرَتْ بِرَوَّاضِ الصِّعَابِ",33,"ب",1,0],["إِذَا اسْتَوَتِ النُّجُومُ سَنىً وَقَدْراً","فَابْرَزُ مَا نَرَاهُ مَا يُدَانِي",34,"ي",1,0],["إذَا اسْتَأْثَرَ المَرْءُ بِالخَيْرِ دُونَ","أَخِيهِ فَذَلِكَ رَأْيُ الأَفِينْ",35,"ن",1,0],["إِذا اِستَرسَلَ الراعي رَعَتها مَهابَةٌ","إِلى كُلِّ مَيّاسٍ إِلى المَوتِ مُعلِمِ",36,"م",1,0],["إِذا اِستَردَفَ الحادي وَقَد آلَ صَوتُهُ","إِلى النَزرِ وَاِعتَمَّت نَدى قَزَعٍ شُكلِ",37,"ل",1,0],["إِذا اِستَنصَلَ الهَيفُ السَفا بَرَّحتَ بِهِ","عِراقِيَّةَ الأَقياظِ نَجدُ المَرابِعِ",38,"ع",1,0],["إِذا اِستَودَعَتهُ صَفصَفاً أَو صَريمَةً","تَنَحَّتَ وَنَصَّت جيدَها بِالمَناظِرِ",39,"ر",1,0],["إِذا اِستَوجَسَت آذانُها اِستَأَنَسَت لَها","أَناسيُّ مَلحودٍ لَها في الحَواجِبِ",40,"ب",1,0],["إِذا اِستَهلَّت عَلَيهِ غَبيَةٌ أَرِجَت","مَرابِضُ العينِ حَتّى يَأرَجَ الخَشَبُ",41,"ب",1,0],["إذا استبق الأملاك يوماً لغايةٍ","أبيتَ وذاك المجدَ إلاَّ التناهيا",42,"ي",2,0],["إذا استُمطرت في المحل سُحْبُ بنانه","فهنّ لمستجدٍ هَوامٍ هواملُ",43,"ل",1,0],["إذا أستند الوليد عليك لاحت","تصاوير الحَنان مصوَّرات",44,"ت",1,0],["إذا أستَعصى القَفار عليك أكلاً","كفاك من القَراح له أدام",45,"م",1,0],["إِذا أَسفَرَت يَوماً نِساءُ مُجاشِعٍ","بَدَت سَوءَةٌ مِمّا تُجِنُّ البَراقِعُ",46,"ع",1,0],["إِذا اِستُنزِلَت كانَت هَدايا وَطُعمَةً","وَلَم تُختَزَن دونَ العُيونِ النَواظِرِ",47,"ر",1,0],["اذا استَلَبَتهُنَّ الأَمَاعِزُ هَبوَةً","وأعقَبَهَا بالأمعَزِ السَهلِ قَسطَلُ",48,"ل",1,0],["إذا استَحنَكت ظَلمَاءُ أمرش نُجُومُها","غوامضُ لا يَسرِي بِها النَّاسُ أُفَّلُ",48,"ل",1,0],["إِذا اِستَدبَرَتنا الشَمسُ دَرَّت مُتونُنا","كَأَنَّ عُروقَ الجَوفِ يَنضَحنَ عَندَما",49,"م",2,0],["إِذا اِستَبَقَ الناسُ غاياتِهِم","وَجَدتَ الزِبَعرى مَعَ الآخِرِ",50,"ر",1,0],["إذا أسرة الفاروق قامتْ لمفخرٍ","أقرَّت لعلياها السراة جميعها",51,"ع",3,0],["إذا اسْتمسكت منه الأماني بناصرٍ","فبشرى الأماني إنها ليسَ تخذل",52,"ل",1,0],["إذا استخدمت مداحها استخدموا لها","بديع الثنا من محضه عربيّه",53,"ي",2,0],["إذا استشهدتْ ألحاظُهم عند مُنشَدي","شواهدَ وجدٍ إنْ تعاجمتُ أَفْصحا",54,"ح",2,0],["إذا اسْتُكْرهَتْ فهْيَ الصُّوَارُ وَرَاءهُ","مَكَاسِيبُ أمثالُ اليعاسِيبِ تُوسَدُ",55,"د",1,0],["إذا استلقتْ فأثبتُ من فِراشٍ","وإن كُبَّتْ فأثبتُ من سرير",56,"ر",1,1],["إذا استدرَّ في المَشيبِ وَسْوسا","وسوسةَ الحِمِّ إذا تحسحسا",57,"س",2,0],["إذا استأثر المِبطان بَاتوا وأصبحوا","خِماصاً وما ضِيفانُهم بخماص",58,"ص",1,0],["إذا استشاروه جاءَ من كَثبٍ","بزُبدة الرأي دون مخَّاضه",59,"ض",2,0],["إذا استمسكَتْ كفّي بعروة قاسمٍ","فلسْتُ على صرْفِ الزمانِ بهالك",60,"ك",1,0],["إذا استُجيش من الطوفانِ ناجيةً","ما إنْ أرى لي بها حَوْلاً ولا قِبَلا",61,"ل",2,0],["إذا استُنْطِقُوا قالوا وإن سئلوا سالوا","وإن ساوروا نالوا وإن طاولوا طالوا",62,"ل",3,0],["إذا استعرضتْها العينُ دقَّ موشَّحٌ","لها ورَبا ردفٌ وجَلَّ مُخدّمُ",63,"م",1,0],["إذا استعجم التأويل يوماً على امرئٍ","فأعوصُ ما فيه لديك مُتَرْجَمُ",63,"م",1,0],["إِذا اِستُعجِلَت بَعدَ الخُبُوِّ تَرازَمَت","كَهَزمِ الظُؤارِ جُرَّ عَنها حُوارُها",64,"ر",3,0],["إِذا اِستَقبَلَتها الريحُ لَم تَنفَتِل لَها","وَإِن أَصبَحَت شُهبَ الذُرى وَالغَوارِبِ",65,"ب",1,0],["إِذا اِستُكرِهَت في مُعظَمِ البَيضِ أَدرَكَت","مَراكِزَ أَرحاءِ الضُروسِ الأَواخِرِ",66,"ر",1,0],["إِذا اِستَبَقَ الأَقوامُ مَجداً وَجَدتَنا","لَنا مِغرَفا مَجدٍ وَلِلناسِ مِغرَفُ",67,"ف",1,0],["إذا استرسل أو شف","رأيت الحسن عريانا",68,"ن",2,0],["إذا أُسد الثرى شبعت فعفت","رأيت شبابهم عفّوا جياعا",69,"ع",2,0],["إذا أستراح حسام","في الغمد قام حسام",70,"م",1,0],["إذا اسْتَهَلَّ اسْتَهَلّتْ حولَهُ عُصَبٌ","كالحيِّ صِيحَ صَباحاً فيه فاختلفا",71,"ف",2,0],["إِذا اِستَقبَلَت نَفسُ الكَريمِ مُصابَها","بِخُبثٍ ثَنَت فَاِستَدبَرَتهُ بِطيبِ",72,"ب",1,0],["إِذا اِستَعطَيتَهُ ما في يَدَيهِ","فَقَدكَ سَأَلتَ عَن سِرٍّ مُذيعا",73,"ع",2,0],["إِذا أسدَى الكريمُ إليكَ عُرْفاً","فأوَّلُهُ بآخرهِ رهينُ",74,"ن",1,0],["إِذا استيقظتْ نائباتُ الزمان","فكنْ في طوارقها في المنام",75,"م",1,1],["إِذا استيقظتْ عيني رأتْ ما يسُوؤُهَا","وإن هجعتْ لاقت أمرَّ وأوجعَا",76,"ع",2,1],["إِذا استخبَر المرءُ التجاربَ عنهمُ","أرتْهُ بِهاماً رُتَّعاً وذِئَابَا",77,"ب",2,0],["إِذا استاف ضيماً عاده خُنْزُوانةٌ","وشَمَّمَ عِرنينَ الألَدّ المحاربِ",78,"ب",1,0],["إِذا اِستَقَلَّ شَآمِيّاً تَضَرَّعَ في","مُضَرَّمٍ بِالغَمامِ الجَونِ مَسعورِ",79,"ر",1,0],["إِذا اِستَوى الراكِبُ في ظَهرِها","طامَنَتِ المَتنَينِ كَي تُردِفا",80,"ف",2,0],["إِذا اِسوَدَّ فيهِ الشَكُّ كانَ كَواكِباً","وَإِن سارَ فيهِ الخَطبُ كانَ حَبائِلا",81,"ل",2,0],["إِذا اِستَقَلَّتهُ جُردُ الخَيلِ أَقدَمَها","سَبطاً يَفوتُ سِنانَ الصَعدَةِ العالي",82,"ي",1,0],["إِذا اِستُحدِثَت فيكُم زِيادَةُ واحِدٍ","تَدَفَّقَ بَحرٌ أَو تَلاحَقَ نيلُ",83,"ل",1,0],["إِذا اِسوَدَّ مِن خَلفِ تَشبيكِها","تَوَهَّمتَهُ الطُنَّ في الدَوخَلَه",84,"ل",2,0],["إِذا اِستَعرَضتَهُ بِخَفِيِّ لَحظٍ","رَضيتَ مَهَزَّةَ السَيفِ الحُسامِ",85,"م",1,0],["إِذا اِستَعاذَ بِهِ المُستَصرِخونَ رَأَوا","وَجهاً يُجَلّي سَوادَ الظُلمِ وَالظُلَمِ",86,"م",1,0],["إِذا اِستَشرَفَت لَمَعاتِ الثُلوجِ","أَطاعَت لَهُ قَبلَ إِبّانِها",87,"ن",3,0],["إِذا إِستَجَدَّت داراً تَعَلَّقَها","بِالإِلفِ حَتّى كَأَنّها وَطَنُه",88,"ن",2,0],["إِذا اِستَشفَعوا في أَيِّمٍ شَفَعَت لَهُم","ذُراها وَضَرّاتٌ عِظامُ المَحالِبِ",89,"ب",1,0],["إِذا اِستَبَقوا المَكارِمَ أَدرَكوها","بِأَيدٍ مِن بَجيلَةَ غَيرِ عُسرِ",90,"ر",1,0],["إِذا اِستَحمَشوها بِالوَقودِ تَغَيَّظَت","عَلى اللَحمِ حَتّى تَترُكَ العَظمَ بادِيا",91,"ي",2,0],["إذا استودعت حر اللجين سبائكا","تصوب في أحشائها وهو ذائب",92,"ب",1,0],["إذا استقَلَّ أعادَ الأَرْضَ مُعْدَمَةً","واستودَعَ التُّرْبَ نَسْلاً غَيرَ مَعدومِ",93,"م",1,0],["إذا استعجلت في نطقها الريح بشرت","علي بن عبد الله بالنصر عاجلا",94,"ل",2,0],["إذا استدبَرَتْ وانياً في السُّرى","رأيناه وهو بها سابِقُ",95,"ق",1,0],["إذا اسودَّ فيه النَّقْعُ أو مَضَتِ الظُّبا","فغُودِرَ من إيماضِها وهو أبلَقُ",96,"ق",1,0],["إذا اسُتودِعَتْ سِرّاً أذاعَتْ بسِرِّها","تُشِّتتُ أنفاساً بها العَيْشُ يُجمَعُ",97,"ع",1,0],["إذا اسُتودِعَتْ حُرَّ اللُّجَينِ سبائكاً","يُصوَّبُ من أجسامِها وهو ذائبُ",98,"ب",1,0],["إِذا اِستَغنَيتَ عَن شَيءٍ فَدَعهُ","وَخُذ ما أَنتَ مُحتاجٌ إِلَيهِ",99,"ي",2,0],["إِذا اِستَلَّ فيهِ الرَعدُ أَسيافَ بَرقِهِ","فَلَيسَ بِهِ إِلّا دَمُ الزِقِّ يُسفَكُ",100,"ك",1,0],["إِذا اِستَجارَ مالُهُ بِكَفِّهِ","أَدانَهُ الجودَ عَلى ذَهابِهِ",101,"ب",2,0],["إذا أسفرتْ من نقعهِ الشهب في دجىً","رَأَيت لوَجهِ الشمسِ منهُ نِقابا",102,"ب",2,0],["إذا أسْمَعَتْ حسناتِ الغناءِ","شَرِبْنا عليها كؤوسَ الذنوبِ",103,"ب",1,0],["إِذا أَسَروا لَم يَأسِرِ البَأسُ عَفوَهُم","وَلَم يُمسِ عانٍ فيهِمُ وَهوَ كانِعُ",104,"ع",1,0],["إِذا اِستَعزَزَ الذِهنَ الذَكِيَّ وَأَقبَلَت","أَعاليهِ في القِرطاسِ وَهيَ أَسافِلُ",105,"ل",1,0],["إِذا اِستَهَلَّت بِأَرضٍ نَمنَمَت يَدُها","بُرداً مِنَ النَّورِ يَكسُو عارِيَ الأَكَمِ",106,"م",1,0],["إِذا اِستَمطَرتَ مِنهُ غَمامَ رُحمى","أَوِ اِستَنصَرتَ في يَومٍ عَصيبِ",107,"ب",1,0],["إِذا اِستَوقَفَتني في الدِيارِ عَشِيَّةً","تَلَذَّذتُ فيها جيئَةً وَذَهابا",108,"ب",2,0],["إِذا اِستُخبِرَت رُكبانُها لَم يُخَبَّروا","عَلَيهُنَّ إِلّا أَن يَكونَ نِداءُ",109,"ا",2,0],["إذا اسْتَعرَ التِّناحرُ وارتمينا","مَشَوا بين الصُّفوفِ مُذَبْذَبينا",110,"ن",2,0],["إذا استبقَ الرجالُ السُّبلَ شتَّى","فإنّ لنا سبيلَ المُهتَدينا",110,"ن",2,0],["إِذا اِستَصرَخَ الأَقوامَ يَرجو غِياثَهُم","رَأى جَمعَهُم مِن حَولِهِ يَتَفَرَّقُ",111,"ق",1,0],["إِذا اِستَهَلّوا بِها اِرتَجَّت جَوانِبُها","وَاِرتَجَّتِ الأَرضُ ذاتُ العَرضِ وَالطولِ",112,"ل",1,0],["إِذا اِستَصرَخَ المَكروبُ مِنّا مُؤَمَّلاً","أَكَبَّ يُديرُ الرَأيَ ثُمَّتَ هَوَّما",113,"م",2,0],["إِذا اِستَصرَخوا أُسطولَهُم لَم يَكُن لَهُم","مِنَ النَصرِ إِلّا أَن تَثورَ الدَمادِمُ",114,"م",1,0],["إذا استوتِ المراتِبُ وَهْيَ شَتَّى","فما فضلُ اللَّبيبِ على الغَبِيِّ",115,"ي",1,0],["إذا استعجلوها ببيضِ الظُّبَى","فلن يملكَ القومُ إمهالَها",116,"ل",3,0],["إِذا اِستَتَرَت مِنهُ بِكُلِّ كُدايَةٍ","مِنَ الصَخرِ وافاها لَدى كُلِّ مَسرَحِ",117,"ح",1,0],["إِذا اِستُعجِلَت بِالوَحى خِلتَها","بِأَجوازِها قَدَمٌ طارِحَه",118,"ح",2,0],["إِذا اِستَغاثَ مِن سَعيرِ الشَمسِ","أَجابَهُ مُستَخرِجٌ بِرَفسِ",119,"س",1,0],["إِذا اِستَجفَلَتهُ الريحُ جالَت قَذاتُهُ","وَجُرِّدَ مِن أَغمادِهِ فَتَسَلسَلا",120,"ل",2,0],["إِذا اِستَعجَلَتهُ الريحُ حَلَّت نِطاقَهُ","وَهاجَت لَهُ في المُعصِراتِ وَساوِسُ",121,"س",1,0],["إِذا اِستَودَعَت سِرَّها عِندَه","فَأَحسَنُ ما فيهِ أَن يُظهِرَه",122,"ه",1,0],["إذا استقبَلَ الناسُ الرّبيعَ وقد غَدَتْ","مُتونُ الرُّبَى في سُندُسٍ تتلفّع",123,"ع",1,0],["إِذا استَحَثَّتهُ مَجاذيفُهُ","أَعنَقَ فَوقَ الماءِ أَو هَملَجا",124,"ج",2,0],["إِذا اِستَبطَأتُكُم عَنَّفتُموني","وَقُلتُم إِنَّ فيهِ لِذاكَ ضيقا",125,"ق",2,0],["إِذا اِستَدارَت بِكَفِّهِ وَبَدَت","رَأَيتَ فيها كَهَيأَةِ الشُعَلِ",126,"ل",1,0],["إِذا اِستَوعَرَت دارٌ عَلَيهِ رَمى بِها","بَناتِ الصُوى مِنها رَكوبٌ وَمُصعِبُ",127,"ب",1,0],["إِذا اِستَغفَيتُ أَضناني","ضَنا المَحمولِ في الخُشبِ",128,"ب",1,0],["إِذا اِستَعجَلوها عَن سَجِيَّةِ مَشيها","تَتَلَّعُ في أَعناقِها بِالجَحافِلِ",129,"ل",1,0],["إِذا اِستُنزِلوا عَنهُنَّ لِلطَعنِ أَرقَلوا","إِلى المَوتِ إِرقالَ الجِمالِ المَصاعِبِ",130,"ب",1,0],["إِذا آسَيتَني بِشَفاً صَريعاً","فَدَعني كُلُّ ذي أَمَلٍ يَتِبُّ",131,"ب",1,0],["إِذا اِستَعانوا بِأَقداحٍ لَها قِيَمٌ","عَلى المُدامَةِ فَالإِثمُ الَّذي قَدَحوا",132,"ح",3,0],["إِذا اِستَشاروكَ فَاِنَصَحهُم وَإِن غَضِبوا","فَإِن كُفَيتَ وَلَم تُسأَل فَلا تُشِرِ",133,"ر",1,0],["إِذا اِستَثقَلتُ أَثوابي وَنَعلي","فَثِقلي في التَجَرُّدِ وَالتَحَفّي",134,"ي",1,0],["إذا استبَقَتْ خُيولُ المجدِ يوْماً","جرَيْنَ بَوَارِحاً وجرى سَنيحا",135,"ح",2,0],["إِذا اِستَقبَلَتهُ الشَمسُ صَدَّ بِوَجهِهِ","كَما صَدَّ عَن نارِ المُهَوِّلِ حالِفُ",136,"ف",1,0],["إذا أُسْقيتُ فضلَتَهُ","مزجْتُ بريقِهِ ريقي",137,"ق",2,0],["إذا استافَها الرَّجلُ العبقريُّ","تحوَّل كالحيوان الوخِمْ",138,"م",1,0],["إذا استقبلْتها الريحُ طَمَّتْ رفيقةً","وهنّ