{"poems":[[37,"وحديثهن إذا التقين","https://www.aldiwan.net/poem7178.html","مجزوء الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[56,"فوق العيون حواجب زج","https://www.aldiwan.net/poem58474.html","أحذ الكامل"],[97,"يا حبيبي اسقني الأماني واشرب","https://www.aldiwan.net/poem24935.html","الخفيف"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85522","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[85,"صغار في الذهاب وفي الإياب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=500984",""],[160,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[199,"لا تلم ذا الهوى على أن يبوحا","https://www.aldiwan.net/poem45621.html","الخفيف"],[270,"بكرت لتسقي زهر جنتها الندي","https://www.aldiwan.net/poem35447.html","الكامل"],[285,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[328,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[402,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[405,"وإذا ضمت الكفاية قوما","https://www.aldiwan.net/poem50089.html","الخفيف"],[416,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[464,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[468,"لا تعر داعي الخلاعة لحظا","https://www.aldiwan.net/poem59910.html","الخفيف"],[551,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[551,"إن التي حكت الضحى","https://www.aldiwan.net/poem47906.html","مجزوء الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[558,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[558,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["وإذا ضحكن عن العذا","ب لنا المسفّات الثواغرْ",0,"ر",1,0],["وإذا ضربْتَ بِصَفْح سيفك صَاحِباً","خافَ الشَّبَا والموتُ فيه إن انْتَحَى",1,"ح",2,0],["واذا ضيم الشاعر الحر يوما","في بلاد جلاه عنها الاباء",2,"ا",2,0],["وإذا ضَحِكْنَ ضَحكنَ عن بَرَدٍ","عَذْبِ الرُّضَابِ كأنّهُ ثَلْجُ",3,"ج",1,0],["وإذا ضاقت السماء بشجوي","فالسماء التي بعينيك أرحب",4,"ب",1,0],["وإذا ضاقَ منْ تجنِّيك صدري","فمديحي لهُ شفاءُ الصدورِ",5,"ر",1,0],["وإذا ضلَّتِ العُقول على عِلْ","مٍ فماذا تقوله الفُّصَحاءُ",6,"ا",2,0],["وإذا ضيم عند قوم عَداهم","مبدلاً من ذاك المكان مكانا",7,"ن",2,0],["وإذا ضقتِ بالأسى فاستمدي ال","نَوحَ من كل قريةٍ ومدينه",8,"ن",2,0],["وإذا ضنَّ ثدي أمِّك يومًا","بالحيا، جعتُ، والتمستُ غذاءك",9,"ك",1,0],["وإذا ضربوا وسيفك لم يجرَّد","وإذ دخلوا ونعلك في الركاب",10,"ب",1,0],["وإذا ضللتَ بشعرها فبثغرها","هادٍ يدلُّكَ من سناه وميضَ",11,"ض",1,0],["وإذا ضاقتِ الحياةُ بنفسٍ","وجدتُ وادي المماتِ فسيحا",12,"ح",2,0],["وإذا ضَننتِ عليَّ قولي يا فتى","مَهلاً فإني قانعٌ بالموعِد",13,"د",1,0],["واذا ضاق بك الحال فقم","واذكر الله تر الأمر انزوى",14,"و",2,0],["وإذا ضقتُ ساعة بمصاب","فلديها تفريج هذا المصاب",15,"ب",1,0],["وإذا ضَاقَت بنا أرضُهُمُ","لم يضق يَا سيّدي مصرٌ وشامُ",16,"م",1,0],["وإذا ضَمَّتِ الكِفايَةُ قَوماً","في مَضَمِّ البَيانِ لم يَلحَقوا بي",17,"ب",2,1],["وإذا ضَلَّتِ الأَفهام عن فهم مشكلٍ","هدى وعليه في الحقيقة أطلعا",18,"ع",2,0],["وإذا ضلَّ عاشق","في الهوى عزَّ رشده",19,"د",2,0],["وَإِذا ضاعَ لِلدِيانَةِ حَقٌّ","فَاِعتَقِد أَنتَ لِلَّذي ضاعَ حِفظا",20,"ظ",2,0],["وإذا ضُربتُ فأنتُمُ جُنَنِي","وإذا ضَربتُ فأنتُمُ نَصْلي",21,"ي",1,0],["وإذا ضَنِنْتِ فقد أسَأْ","تِ وفي يديكِ بلوغُ حاجِي",22,"ي",1,0],["وَإِذا ضَنِنْتُمْ بِالعَطاءِ فليتَهُ","ما كان إفقارٌ ولا إحواجُ",23,"ج",1,0],["وإذا ضرك لا نافع من","دونه والضر لا إن نفعك",24,"ك",1,0],["وإذا ضاق أو تعسر أمر","ثم أبطا انفساحُه وانبلاجه",25,"ج",2,0],["وإِذَا ضحِكْتُ فلو بَدا لكَ بَاطِني","ويُعيذُكَ الرحمنُ كُنتَ ترى التَّرح",26,"ح",1,0]]}