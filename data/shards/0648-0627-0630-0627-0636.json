{"poems":[[39,"وحديثهن إذا التقين","https://www.aldiwan.net/poem7178.html","مجزوء الكامل"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[58,"فوق العيون حواجب زج","https://www.aldiwan.net/poem58474.html","أحذ الكامل"],[99,"يا حبيبي اسقني الأماني واشرب","https://www.aldiwan.net/poem24935.html","الخفيف"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85522","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[108,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[87,"صغار في الذهاب وفي الإياب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=500984",""],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[203,"لا تلم ذا الهوى على أن يبوحا","https://www.aldiwan.net/poem45621.html","الخفيف"],[275,"بكرت لتسقي زهر جنتها الندي","https://www.aldiwan.net/poem35447.html","الكامل"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[333,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[411,"وإذا ضمت الكفاية قوما","https://www.aldiwan.net/poem50089.html","الخفيف"],[422,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[469,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[473,"لا تعر داعي الخلاعة لحظا","https://www.aldiwan.net/poem59910.html","الخفيف"],[556,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[556,"إن التي حكت الضحى","https://www.aldiwan.net/poem47906.html","مجزوء الكامل"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[563,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[580,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199564","المسحوب"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1769,"","https://poetry.dctabudhabi.ae/diwan/poem/204040","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53180","المديد"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77382","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28605","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88664","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88705","الرمل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32582","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60885","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74192","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66455","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91760","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205565",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206160",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59514","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119410","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136901",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66128","الخفيف"],[4699,"يا مالكةً قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=153978",""],[4755,"كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=187242",""],[4918,"صرخة روح","https://www.poetsgate.com/ViewPoem.aspx?id=32717",""],[5232,"العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=211570",""],[5970,"كن مع الناس تر الناس معك","https://www.poetsgate.com/ViewPoem.aspx?id=130589",""],[5970,"عش غريباً فالعيش محض غريب","https://www.poetsgate.com/ViewPoem.aspx?id=130596",""],[6045,"هدية يوم الأم","https://www.poetsgate.com/ViewPoem.aspx?id=125354",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[6256,"ضاعت حقيبتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65917&r=&rc=5",""]],"verses":[["وإذا ضحكن عن العذا","ب لنا المسفّات الثواغرْ",0,"ر",1,0],["وإذا ضربْتَ بِصَفْح سيفك صَاحِباً","خافَ الشَّبَا والموتُ فيه إن انْتَحَى",1,"ح",2,0],["واذا ضيم الشاعر الحر يوما","في بلاد جلاه عنها الاباء",2,"ا",2,0],["وإذا ضَحِكْنَ ضَحكنَ عن بَرَدٍ","عَذْبِ الرُّضَابِ كأنّهُ ثَلْجُ",3,"ج",1,0],["وإذا ضاقت السماء بشجوي","فالسماء التي بعينيك أرحب",4,"ب",1,0],["وإذا ضاقَ منْ تجنِّيك صدري","فمديحي لهُ شفاءُ الصدورِ",5,"ر",1,0],["وإذا ضلَّتِ العُقول على عِلْ","مٍ فماذا تقوله الفُّصَحاءُ",6,"ا",2,0],["وإذا ضيم عند قوم عَداهم","مبدلاً من ذاك المكان مكانا",7,"ن",2,0],["وإذا ضقتِ بالأسى فاستمدي ال","نَوحَ من كل قريةٍ ومدينه",8,"ن",2,0],["وإذا ضنَّ ثدي أمِّك يومًا","بالحيا، جعتُ، والتمستُ غذاءك",9,"ك",1,0],["وإذا ضربوا وسيفك لم يجرَّد","وإذ دخلوا ونعلك في الركاب",10,"ب",1,0],["وإذا ضللتَ بشعرها فبثغرها","هادٍ يدلُّكَ من سناه وميضَ",11,"ض",1,0],["وإذا ضاقتِ الحياةُ بنفسٍ","وجدتُ وادي المماتِ فسيحا",12,"ح",2,0],["وإذا ضَننتِ عليَّ قولي يا فتى","مَهلاً فإني قانعٌ بالموعِد",13,"د",1,0],["واذا ضاق بك الحال فقم","واذكر الله تر الأمر انزوى",14,"و",2,0],["وإذا ضقتُ ساعة بمصاب","فلديها تفريج هذا المصاب",15,"ب",1,0],["وإذا ضَاقَت بنا أرضُهُمُ","لم يضق يَا سيّدي مصرٌ وشامُ",16,"م",1,0],["وإذا ضَمَّتِ الكِفايَةُ قَوماً","في مَضَمِّ البَيانِ لم يَلحَقوا بي",17,"ب",2,1],["وإذا ضَلَّتِ الأَفهام عن فهم مشكلٍ","هدى وعليه في الحقيقة أطلعا",18,"ع",2,0],["وإذا ضلَّ عاشق","في الهوى عزَّ رشده",19,"د",2,0],["وَإِذا ضاعَ لِلدِيانَةِ حَقٌّ","فَاِعتَقِد أَنتَ لِلَّذي ضاعَ حِفظا",20,"ظ",2,0],["وإذا ضُربتُ فأنتُمُ جُنَنِي","وإذا ضَربتُ فأنتُمُ نَصْلي",21,"ل",2,0],["وإذا ضَنِنْتِ فقد أسَأْ","تِ وفي يديكِ بلوغُ حاجِي",22,"ج",2,0],["وَإِذا ضَنِنْتُمْ بِالعَطاءِ فليتَهُ","ما كان إفقارٌ ولا إحواجُ",23,"ج",1,0],["وإذا ضرك لا نافع من","دونه والضر لا إن نفعك",24,"ك",1,0],["وإذا ضاق أو تعسر أمر","ثم أبطا انفساحُه وانبلاجه",25,"ج",2,0],["وإِذَا ضحِكْتُ فلو بَدا لكَ بَاطِني","ويُعيذُكَ الرحمنُ كُنتَ ترى التَّرح",26,"ح",1,0],["واذا ضربها العقربي قام يلتوي","شرى ليّ الرشيِّ اللّي صديرٍ ورودها",27,"د",3,0],["وَإِذا ضَنَّت دَعا اسمي يَرتَوني","إِذ تَسميني بِتَقبيلِ لَماها",28,"ا",3,0],["وإذا ضاق الخناق فقم","باكياله في الظلم",29,"م",1,0],["وإذا ضرع الغوادي جفَّ في","شتوةٍ واغبرَّت الأرض جَدوبا",30,"ب",2,0],["وإذا ضاقت البلاد بحر","سار عنها إلى مكان جديد",31,"د",1,0],["وإذا ضمها إليهن بالحكم","فلم خالفته في مسعاها",32,"ا",3,0],["وإذا ضَلَّتِ العقُول هَدّاها","لهُدَاها وقد أصَابَ صَوَابه",33,"ب",2,0],["وإذا ضنّ الغمام فلذ","منهما بالعارض الهَطِل",34,"ل",1,0],["وَإِذا ضاقَتِ البَسيطَةُ في عَي","ني فَذِكرُ الإِلَهِ يفرِجُ كَربي",35,"ب",2,0],["وَإِذا ضاقَت عَلَيكُم خُطَّةٌ","عَدِمَ المال بِها وَالوَطَنا",36,"ن",2,0],["واذا ضم يدا في جيبه","خرجت بيضاء تهمي عسجدا",37,"د",2,0],["واذا ضاق بهم رحب الفضا","وَسعت همته كل قبيل",38,"ل",1,0],["وَإِذا ضَفدَعٌ عَلَيهِ إِكافٌ","عَلَّموهُ بَعدَ النِفارِ الرَسيم",39,"م",1,0],["وإذا ضاقت برحلي بلدة","فإلى البدر بن بكر بن علي",40,"ل",2,0],["وَإِذا ضَلَلتم في المَسير لِبابه","فَخُذوا بِجذوة نوره فَستهتدوا",41,"د",3,0],["وَإِذا ضَربتُ فَلا تَخيبُ مَضارِبي","وَإِذا طَعَنتُ فَلا يَروغُ طِعاني",42,"ن",2,0],["وإذا ضممت ضممت غصناً في نقا","كفل خصيب بالنعيم ممرّد",43,"د",1,0],["وَإِذا ضفا ظل كطرّة أَغيدٍ","مِن فَوق خدّ النَهر في بُستانه",44,"ن",2,0],["وإذا ضننت بها رجعت أرودها","في حينما افترقت، ولما نلتقِ",45,"ق",1,0],["وإذا ضحكت فما البكى","بأمضَّ من ضحكي رنينا",46,"ن",2,0],["وإذا ضربت فعضَّ عضَّةَ كادمٍ","ليفي عليك السيف وهو جبانُ",47,"ن",1,0],["وإذا ضاقت المصانع بالسيل","أبى أن يحل الا البطاحا",48,"ح",2,0],["وإذا ضاق موطن الحرّ بالحرّ","فما تنفع البسيطة دارا",49,"ر",2,0],["وإذا ضاقتِ الأُمُورُ يُفَرِّجُها","بِحَزْمٍ كالسَّيْفِ يَشْطُبُ شَطْبا",50,"ب",2,0],["وإذا ضَنَّ فؤادكِ يَومَاً","مَنْ سَتَكُونُ مَلاذ القلب ؟!",51,"ب",1,0],["وإِذا ضَيَّعَ الحُقُوقَ ذَلِيلٌ","فَمِنَ الظُّلمِ أَن يَتُوبَ ظَلُومُ",52,"م",1,0],["واذا ضاقت بي الدنيا نحت من الصخر تمثال","أكحل عيني من جمر القضى لاتفضح علومي",53,"م",2,0],["وإذا ضَحِكتُ تفتَّحتْ أزهارهُ","وسَكرِتُ من ذوب الرَّحيق بفيهِ",54,"ي",2,0],["وإذا ضاقت بك الدنيا فكم","بينهم من همه أن يوسعك",55,"ك",1,0],["وإذا ضاقت الحياة فهون","أمرها فالإله خير منيب",56,"ب",1,0],["وإذا ضحكتُ, ظننتُ وجهك بسمةً","وإذا بكيتُ, كأنّ قلبك باكٍ",57,"ك",1,0],["وإذَا ضَوَّءَ الهِلال","تَهَيَّأَتْ لرُؤْيَاكَ فَوقَ وَجْهِ الهِلالِ",58,"ل",1,0],["وإذا ضياعك هيج الذكرى","ويزيد طولُ الليل قسوتها",59,"ت",3,0]]}