try.dctabudhabi.ae/diwan/poem/146491","الرمل"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131363","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91072","المديد"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128918","الخفيف"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66606","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139405",""],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125870","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72875","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123868","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5302,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201746",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[572,"مَنْ عَذِيري من عَذَارَيْ رشإٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9387&r=&rc=244",""]],"verses":[["وَهْوَ في مَنْجَمِ الفَصاحَةِ مِنْ فَرْ","عَيْ نِزارٍ مُقابَلُ الأَعْراقِ",0,"ق",1,0],["وَهوَ فَتيقُ العِجانِ مُنخَرِقُ المُب","عرِ ما فيهِ لِلمَنيِ مَقَر",1,"ر",1,0],["وهو في الملّة الحنيفية البي","ضاء كفرٌ بربنا ذي الجلاله",2,"ل",2,0],["وهو في الخط خماس","ي وفي اللفظ رباعي",3,"ع",2,0],["وهْو في ذاك ناعمُ البال لا يف","صل بين القتيل والأُسَراءِ",4,"ا",2,0],["وهو فيما دعا إلى صفعه بال","يد والرِّجل دائمُ الإنكماش",5,"ش",1,0],["وَهْوَ في غير طائلٍ","فأغِثْهُ بطائلكْ",6,"ك",1,0],["وَهُوَ في قَلبي مُقيمٌ","أَقرَبُ الناسِ إِلَيهِ",7,"ه",1,0],["وَهُوَ في سِرّي وَجَهري","وَسُكوتي وَكَلامي",8,"م",2,0],["وهو في العرس إن تحجّب أو لم","يحتجب والد العروس المهنا",9,"ن",2,0],["وَهوَ في الأَيدي وَفي قُدرَتِها","لَم يَضِق عَنهُ وَلَم يَعجِز أَحَد",10,"د",1,0],["وَهوَ في الحَياةِ عَلى","كُلِّ خُطوَةٍ رَصَدُ",11,"د",1,0],["وَهوَ في أَعِنَّتِهِ","مُمعِنٌ وَمُطَّرِدُ",11,"د",1,0],["وَهُوَ في حِليَةِ الشَبابِ يُضاهي","جِدَّةَ الرَوضِ مُشرِقَن نُوّارُه",12,"ر",2,0],["وَهو في ذِروة الشبا","بِ وفي خفةِ القَدَم",13,"م",1,0],["وهوَ في حميَرَ الملوكِ عريقٌ","في صَميمِ العلى ومحْضِ النّجارِ",14,"ر",1,0],["وهو في الطِّيبِ وفي الطُّهر معاً","عَبَقُ الفِردوسِ للمُستنِشقِ",15,"ق",1,0],["وهو في النَّحرِ قَضاءٌ آخِذٌ","نافذٌ في كلِّ سَدٍّ مُحكَمِ",16,"م",1,0],["وهَوَ في الحَرِّ والخَرِيفِ وَفي البي","تِ يَجمَعُ الحُطامَ كالجَرَّافه",17,"ف",2,0],["وهو فيه كهرباء","وهو نار وهو نور",18,"ر",1,0],["وهو في الإنسان عقل","وحياة وضمير",18,"ر",1,0],["وهو في الظبي بغام","وهو في الليث زئير",18,"ر",1,0],["وهو في البعض اكتئاب","وهو في البعض سرور",18,"ر",1,0],["وهو في قلبي الَّذي","عانَقَهُ الفَجْرُ إِلَهْ",19,"ا",3,0],["وهو في حَلْبَةِ البيانِ أديبٌ","تسمَعُ السحرَ في رُقَى نَفَثَاته",20,"ت",2,0],["وهو في القصر يحتسي الشعب خمرا","ودما والكؤوس غضبى لوائم",21,"م",1,0],["وهو في القصر يحتسي عرق الشعب","ويروي القيان والغلمانا",22,"ن",2,0],["وهو في الميلِ غيرهُ الصبحَ وحشٌ","هائجٌ ضيِّق الفؤادِ غَضوب",23,"ب",1,0],["وهو في التمكين طود شامخ","وباصحاب الوحا السيف المجرد",24,"د",1,0],["وهو فرد الرجال قطب صدور ال","أولياء العظام عالي المساعي",25,"ع",2,0],["وهو في مظهر العناية نور","غالب ضوءه على الأضواء",26,"ا",2,0],["وهوَ في الأرضِ يَجُرُّ","الرِجلَ تُدميها الصُخور",27,"ر",1,0],["وَهوَ فيما كَفاكَ قَولُ حَسودٍ","نالَها وَالأَنامُ عَنها نِيامُ",28,"م",1,0],["وهو في الشهوة مأخو","ذ بأخلاق معله",29,"ل",2,0],["وَهو فصيحُ القلب واللسانِ","وَهوَ ملقّى سورِ القرآنِ",30,"ن",1,0],["وَهوَ في صدعِها بما أمرَ الجب","بارُ ماضٍ كالسيفِ فيه مضاءُ",31,"ا",2,0],["وَهوَ في قومهِ ينادي وقل","بُ الشركِ أَعمى وأذنهُ صمّاءُ",31,"ا",2,0],["وهو فوقَ القضبانِ بعضُ الدراري","عكسوهُ فسارَ فوقَ الهلالِ",32,"ل",1,0],["وهو فيهم كأنه قمر","وهم في النجوم كالشهب",33,"ب",1,0],["وهو في قومه حسيب نسيب","ذو فخار وسؤدد واصاله",34,"ل",2,0],["وهو في فنه العجيب لقد فا","ز لإبداعه بألف رهان",35,"ن",1,0],["وَهوَ فيها ممتّع ببنيهِ","وَبينهم أشبالِ ليثِ العرينِ",36,"ن",1,0],["وَهوَ فيهِم مهنّأٌ بختانٍ","ثمَّ عرسٍ له السعادةُ حُلّه",37,"ل",2,0],["وهو في حر وخفق مثلما","لعبت ريح الصبا بالقبس",38,"س",1,0],["وَهوَ في بردٍ وخفقٍٍ لا كما","لَعِبت ريحُ الصّبا بالقبسِ",39,"س",1,0],["وَهوَ فالَ لَيسَ يَخفى حُسنُهُ","ساقَهُ الإِلهامُ في طَيِّ الفِكِر",40,"ر",1,0],["وهو فنّ من الزعامة مختا","رٌ وخلق من الزعيم جسام",41,"م",1,0],["وهو فيهم كليلة القدر في الده","ر وكالنور في الظلام الخابي",42,"ب",2,0],["وهو فوق المحدود إذ هو فوق ال","عقل فالعقل شارد في مداه",43,"ه",1,0],["وهو فجرٌ لفّهُ جن","حُ الظلام المدلَهمّ",44,"م",1,0],["وَهوَ في الأَكبادِ حُرٌّ","وَهوَ في الأَفواهِ بَردُ",45,"د",1,0],["وَهوَ في اِستِرجاعِ م","ا وَلّاكَ سَيّارٌ كَسَيرِك",46,"ك",1,0],["وَهوَ فَلا يَنفَعُني نُصحُهُ","كَذاكَ لا يَنفَعُهُ نُصحي",47,"ح",2,0],["وَهُوَ في دين الهَوى أَقوى سَبب","يا دُجى الهَجر الَّذي أَحمى الوَهج",48,"ج",1,0],["وهو في العمر مره فاقضه بالكمال","ووقته بعد ما شوال يبدو الهلال",49,"ل",1,0],["وهو في العدّ ثلاثيّ ومَا","في الذي أوردتُه قطّ غَلَطْ",50,"ط",1,0],["وهو في العلم إمام فاستفد","ما تشا من علمه فناً ففنا",51,"ن",2,0],["وَهْوَ فِي المنجبينَ أَعلى وأزكى","والدٍ أَنْتَ أَكرَمُ الأَولادِ",52,"د",1,0],["وهو فنجوم أشرقت يهتدي بها","وما ضل من قد بات يسري على نجم",53,"م",1,0],["وهو في الحجم أصغر الناس","طرا وهو في الشأن شامخ مثل رب",54,"ب",1,0],["وهو في سجنه الأبُّى على السج","نِ فمنه السَّجينُ والسجان",55,"ن",1,0],["وهو في كلِّ مَحفِلٍ كان يُلقي","مِن خطابٍ كَاللُّؤلُؤِ المَكنُونِ",56,"ن",1,0],["وَهوَ في الفِرْدَوسِ لَمّا","قيلَ قَد حَلَّ الجُبوبا",57,"ب",2,0],["وهو في مكَّتنا كعبتُنا","وبه الجسم كداءٍ وكُدَيّ",58,"ي",1,0],["وهو في أفعاله أجمعها","ظاهرٌ حيٌّ هو القيوم",59,"م",1,0],["وهو في التنزيه عن مخ","لوقه في كل حال",60,"ل",1,0],["وهو في حالة السجود تراه","في هدير بذكره متوالي",61,"ل",2,0],["وهو في الكون عندنا قرآن","لا زبور بقي ولا إنجيل",62,"ل",1,0],["وهو في العلياء واحده","قبل أن يبدو لذي مقل",63,"ل",1,0],["وهو في غيظ وفي فرط أذى","دائماً منه لقبح النطف",64,"ف",1,0],["وهو في أكمل الدنو إلينا","وهو عنا في غاية الإرتفاع",65,"ع",1,0],["وهو فرد الكون واحده","ولئن زالت شواهده",66,"ه",1,0],["وهو في مذهب الحقيقة شخصٌ","كافر لا يرى الغداة نصيرا",67,"ر",2,0],["وهو فان كله أيضا كما","قال إلا وجهه يا من قرا",68,"ر",2,0],["وهو في غيره مجرد وهمٍ","كم به رادت الردى أفواجه",69,"ج",2,0],["وهو فرد حق ونحن كثير","باطل في كلامنا كالسراج",70,"ج",1,0],["وهو في بيت عزة وجلال","لست تلقى إليه غيرك بابا",71,"ب",2,0],["وهو فينا مظاهر ومجالي","إن سلكنا به مسالك حب",72,"ب",1,0],["وهو في العين ساكن فتراه","غينها شين فيه وهو افتراء",73,"ا",2,0],["وهو فناؤكم به ذوقاً فلا","موجود غيره من ابتداء",74,"ا",2,0],["وهو فِعْل إِن غيروا منه حرفاً","وهو اسم مَعْنَاه في الحال يُعْلَم",75,"م",1,0],["وهو فؤادي الحيران","ويستحق الأَلْوانْ",76,"ن",1,0],["وهْو فتاةٌ مُعْصِرٌ","فيكَ وفيهمُ عَانِس",77,"س",1,0],["وهْوَ فَكُّ الأَسير مُحْيي رَميمَ ال","مجدِ قوتُ الثاوين زادُ الرَّكب",78,"ب",1,0],["وهْو في كُلِّ روضةٍ لِلْمعالي","في اقتطافٍ وغيرُه في حَطْبِ",78,"ب",1,0],["وَهُوَ في المُلكِ ابنُ ذي يَزُنٍ","وابنُ داوُدٍ سُلَيمانُ",79,"ن",1,0],["وهو فيكم من مقامي بدلٌ","ويلُ من بَدَّل عهدَ البَدَلِ",80,"ل",1,0],["وَهوَ في مصر للعفاة مَلاذٌ","وَبهم قَلبه مَدى الدَهر رائف",81,"ف",1,0],["وَهوَ في الأَرض وَالسَماء مُقيمٌ","باتفاق الوَرى كَما قَد علمنا",82,"ن",2,0],["وَهوَ في خَوض الغبارِ","قسور يردي طريدهْ",83,"ه",1,0],["وَهوَ في الهَيجا يماني","يَحصد الأعدا حَصيدهْ",83,"ه",1,0],["وَهوَ في أَضيق حَصرِ","كَم نَرى وَالنيل يَجري",84,"ي",1,0],["وَهوَ في ظهر السَعيدِ","واحدِ العَصر الفَريدِ",84,"د",1,0],["وَهوَ في كرٍّ وَفرِّ","دامَ فينا ذا سَدادِ",84,"د",1,0],["وَهوَ فعلٌ إِن رَأسُهُ بانَ عَنه","وَنَبات بِهِ يَزول السقام",85,"م",1,0],["وهو في كل موضع تاجر السو","ق يبيع النفوس فيها ويشري",86,"ر",2,0],["وهو في خصبها يجوع ويعرى","وهو في خصبها يذوب ويبلى",87,"ل",2,0],["وهو في غدوتيه أكثرُ عجزاً","وهو في روحتيه أكبر جهلا",87,"ل",2,0],["وَهوَ فَردٌ لَكنَّهُ في حِسابي","عَدَّهُ النَّاس وَالوَرى بِالأُلوفِ",88,"ف",1,0],["وَهوَ فيهِ يُحيطُ ذاتاً وَفِعلاً","وَصِفاتٍ وَفي المَقالِ الصّوابِ",89,"ب",1,0],["وَهوَ فَردُ الدّهرِ مثلاً عُدِما","لا تَقِسْ فيه اِمرَأً لا تَقسِ",90,"س",1,0],["وَهوَ في الأَيدي يُحَيّونَ بِهِ","وَعَلى الآنافِ طوراً يُستَشَف",91,"ف",1,0],["وهْو فتى عارٍ من الخير لا","سلمه الحادث مِنْ وهْسِه",92,"س",2,0],["وَهوَ فيهِ لِلَّهِ ضَيفٌ وَحاشا","أَن تَخطَّى لِضَيفِهِ الكُرُباتُ",93,"ت",1,0],["وهو في السلم كالفتاة حييى","وهو في معرض اللقاء وقاحُ",94,"ح",1,0],["وَهوَ في آياتِهِ مغتربٌ","وَبِها أَضحى وحيداً مُنفَرِد",95,"د",1,0],["وهو في العالمين افضل عبد","وهو للمرسلين عز وتاج",96,"ج",1,0],["وهو في الفضل له الفضل على","كل من أنكره أو عرفه",97,"ف",2,0],["وهو فوق الرثاءِ مهما نظمنا","فبالفاظه اهتدينا اليقينا",98,"ن",2,0],["وهو في معهد الصحافة صرحٌ","شامخ الرأس ثابت الأركان",99,"ن",1,0],["وهو في قبره الشريف طريّ","من يسلّم عليه ردّ سلامه",100,"م",2,0],["وهو في صدق لهجةٍ كأبي ذرٍّ","وتقوًى تحكي تقى سلمان",101,"ن",1,0],["وهو في المهد موثقٌ يتلظَّى","كأَسيرٍ في الحرب يبغي السلاما",102,"م",2,0],["وهوَ في القلبِ عَلَى الحالين صال","نار وجدٍ باصطباري تذهبُ",103,"ب",1,0],["وهوَ فعلٌ صحَّ فيهِ معنيا","نِ فقل لاحَ وان شئتَ فراح",104,"ح",1,0],["وهو في مقعد صدقٍ","جاره المختار أحمد",105,"د",1,0],["وهو في الراح شعاعٌ لمعا","تتوارى فيه روح المحتسى",106,"س",2,0],["وهو في كل نشأة يتجلى","لذويها بمقتضى منشاها",107,"ا",3,0],["وهو في الشرق مثلما هو في الغر","ب وفي الأرض مثلما في سماها",107,"ا",3,0],["وهو في جيدهن أكثر زهوا","من درار