{"poems":[[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[86,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[43,"أماتكم من قبل موتكم الجهل","https://www.aldiwan.net/poem10131.html","الطويل"],[43,"نرى عظما بالبين والصد أعظم","https://www.aldiwan.net/poem10539.html","الطويل"],[45,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[45,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[28,"لنا عدد يربي على عدد الحصى","https://www.aldiwan.net/poem5090.html","الطويل"],[28,"أيعجب الناس أن أضحكت خيرهم","https://www.aldiwan.net/poem5161.html","البسيط"],[28,"لعمرك ما الأرزاق يوم اكتيالها","https://www.aldiwan.net/poem5195.html","الطويل"],[28,"ألا استهزأت مني هنيدة أن رأت","https://www.aldiwan.net/poem5472.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140860",""],[158,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[202,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["وَلَو ضَمِنَ العِزُّ بَعضَ الوُكورِ","أَغارَت يَداهُ عَلى الطَائِرِ",0,"ر",1,0],["وَلَو ضَرَحوا بِالمَسجِدَينِ لَأَنزَلوا","بِخَيرِ بِقاعِ الأَرضِ خَيرَ رُفاتِ",1,"ت",1,0],["وَلَو ضافَ أَحياءً بِحَزنِ مُلَيحَةٍ","لَلاقى جِواراً صافِياً غَيرَ أَكدَرا",2,"ر",2,0],["وَلَو ضَرَبَتكُم مَنجَنِيقي وَأَصلُكُم","قَوِيٌّ لَهَدَّتكُم فَكَيفَ وَلا أَصلُ",3,"ل",1,0],["وَلَو ضَرَّ مَرءً قَبلَهُ ما يَسُرُّهُ","لاَثَّرَ فيهِ بَأسُهُ وَالتَكَرُّمُ",4,"م",1,0],["وَلَو ضَرَبوا في المَكرُماتِ بِسُهمَةٍ","لَكانَ لَهُم فيها اللَفا وَلَكَ الكُثرُ",5,"ر",1,0],["وَلَو ضُمِنَ المَعروفَ طَيُّ صَحيفَةٍ","تُكادُ عَلَيهِ كانَ عُنوانَها البِشرُ",6,"ر",1,0],["وَلَو ضَمِنَت حَرباً لِخِندِفَ أُسرَةٌ","عَبَأنا لَها مِن خِندِفٍ مَن يُبيرُها",7,"ر",3,0],["وَلَو ضَرَبتُ عَلى عَمدٍ مُقَلَّدَةٍ","لَخَرَّ جُثمانَهُ ما فَوقَهُ شَعَرُ",8,"ر",1,0],["وَلَو ضافَهُ الدَجّالُ يَلتَمِسُ القِرى","وَحَلَّ عَلى خَبّازِهِ بِالعَساكِرِ",9,"ر",1,0],["وَلَو ضاعَ ما قالوا اِرعَ مِنّا وَجَدتَهُم","شِحاحاً عَلى الغالي مِنَ الحَسَبِ الجَزلِ",10,"ل",1,0],["ولو ضر مرءاً قلبه ما يسره","لأثر فيه بأسه والتكرم",11,"م",1,0],["ولو ضرب الإِنسان بالسيف ما درى","لما هو يلقي من سرور بذي اللقيا",12,"ي",2,0],["ولو ضربت بين القبور بنَغمةٍ","لقهقهتِ الموتى لها من قبورِها",13,"ر",3,0],["وَلَوْ ضَربتُ بأدنى الفِكْرِ قُلْتُ لَهُ","قَتَلْتَ في شرّ ضَرْبٍ شَرّ مَضْرُوبِ",14,"ب",1,0]]}