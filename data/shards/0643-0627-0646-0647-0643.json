{"poems":[[56,"كأنه كبش إذا ما بدا","https://www.aldiwan.net/poem28664.html","السريع"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[91,"أضاء ثم تدلى يأفل القمر","https://www.aldiwan.net/poem44783.html","البسيط"],[46,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[76,"رب ابن ليل سقانا","https://www.aldiwan.net/poem12911.html","المجتث"],[50,"شمر شبابك في قتلي وتعذيبي","https://www.aldiwan.net/poem10772.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[235,"يا مولعا بالبهار زرنا","https://www.aldiwan.net/poem4053.html","مخلع البسيط"],[240,"يا ابن الدوامي الذي","https://www.aldiwan.net/poem31778.html","مجزوء الرجز"],[302,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[369,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[376,"ليت الهوى كان علة تعدي","https://www.aldiwan.net/poem57508.html","المنسرح"],[398,"أشكو إليك زمانا ظل يعركني","https://www.aldiwan.net/poem53398.html","البسيط"],[398,"دب العذار على ميدان وجنته","https://www.aldiwan.net/poem53495.html","البسيط"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[572,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[580,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108995","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49549","البسيط"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105864","البسيط"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132173","البسيط"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143781","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86285","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86257","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92059","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199015","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59511","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69920","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28679","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[4755,"ذَاتُ اللذيذَين","https://www.poetsgate.com/ViewPoem.aspx?id=184702",""],[4764,"طعم الجروح","https://www.poetsgate.com/ViewPoem.aspx?id=33890",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5771,"وجهٌ ثُلاثيُّ الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=189540",""],[5981,"غاب فلم يرجع إلى أهله","https://www.poetsgate.com/ViewPoem.aspx?id=186656",""],[572,"ومَلْعَبٍ للخيلِ في قراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9209&r=&rc=66",""]],"verses":[["كَأَنَّهُ كَبشٌ إِذا ما بَدا","لَكِنَّهُ في طَبعِهِ نَعجَه",0,"ه",1,1],["كَأَنَّهُ كُلَمّا اِرفَضَّت حَزيقَتُها","بِالصُلبِ مِن نَهشِهِ أَكفالَها كَلِبُ",1,"ب",1,0],["كَأَنَّهُ كَوكَبٌ في إِثرِ عِفرِيَةٍ","مُسَوَّمٌ في سَوادِ اللَيلِ مُنقَضِبُ",1,"ب",1,0],["كأنه كان فيما كان يرسله","من الاغاريد يشكو ثم يعتذر",2,"ر",1,0],["كَأَنَّهُ كانَ تِربَ الحُبِّ مُذ زَمَنٍ","فَلَيسَ يُعجِزُهُ قَلبٌ وَلا كَبِدُ",3,"د",1,0],["كَأَنّهُ كيسُ فَحمٍ","قَد أوقِدَت فيهِ جَمرَه",4,"ر",2,0],["كَأَنَّهُ كُلَّما حاوَلتُ نائِلَهُ","ذو نَخوَةٍ ناشِئٌ بَينَ الأَعاريبِ",5,"ب",1,0],["كَأَنَّهُ كُرَةٌ مَلْسَاءُ مِنْ أَدَمٍ","خَفِيَّةُ الدَّرْزِ قَدْ عُلَّتْ بِجِرْيالِ",6,"ل",1,0],["كأنه كُحْل عيون الخُرَّد","تخاله فوق الصباح المنجِد",7,"د",1,0],["كأنهُ كَأْسُنا المُدارُ","فَذا زُجَاجٌ وذا عقَارُ",8,"ر",1,0],["كَأَنَّهُ كَفُّكَ لا","يَصلُحُ إِلّا لِلقُبَل",9,"ل",1,0],["كأَنَّه كان مطويّاً على إِحنٍ","فَعِندما غبتُ عنه راح ينتقمُ",10,"م",1,0],["كأنّه كَعبةٌ قد سافَرتْ كَرماً","حتّى قضَى الحَجَّ في الأوطانِ زُوّار",11,"ر",1,0],["كأنه كلما مضى قلم","في يده إذ يُعيدُ أو يُبدي",12,"د",2,0],["كَأَنَّهُ كانَ مَطوِيّاً عَلى احنٍ","وَلم يَكُن من قَديم الدَهرِ أَنشَدَني",13,"ن",2,0],["كَأَنَّهُ كاتِبٌ عَزِّ المداد لَه","أَرادَ يَكتُبُ لاماً فَاِبتَدا أَلِفا",14,"ف",2,0],["كَأنّهُ كَلِمٌ راعتْ وليسَ لَها","مَعْنىً ولَمعةُ برقٍ خلَّبٍ لَمَحا",15,"ح",2,0],["كَأَنَّهُ كَثيبٌ","لَبَّدَهُ الجَليدُ",16,"د",1,0],["كَأَنّهُ كَفُّ فَتىً جَحْجَاحِ","مَبْسُوطَةٌ للبَذْلِ والسَّمَاحِ",17,"ح",1,0],["كأَنَّه كانَ من تَخْفيفِ خُطْوَتِه","يَمْشِي على الْجَمْرِ أَوْ يَسْعى عَلى الإِبَرِ",18,"ر",1,0],["كأنه كوثر تصفو موارده","للداخلين جناناً بابها رحبا",19,"ب",2,0],["كَأنَّهُ كَأسُ يَاقُوتٍ عَلَى فَنَن","مِنَ الزُّمُرُّدِ يَجْلُو تِبْرَ صَهْبَاءِ",20,"ا",2,0],["كأنه كان في الدنيا على ثقةٍ","من الخلود فكفّاها ووفّاها",21,"ا",3,0],["كأنَّه كان ثأراً باتَ يَطْلُبُهُ","حتّى رآه فلم يَعْدِلْ به أحدا",22,"د",2,0],["كأنَّهُ كِسف أُفقٍ مالَهُ حُبُك","أو لازَوَردٌ أو أذ ناب الطَواويسِ",23,"س",1,0],["كأنه كل فلك من محاسنه","خريدة وشيت أثوابها القشب",24,"ب",1,0],["كأنه كان مطوياً على إحنٍ","ولم يكن في ضروب الشعر أنشدني",25,"ن",2,0],["كأنه كان لي بقربكمُ","يمين موسى إذ أَمَّه الخضِر",26,"ر",1,0],["كَأَنَّهُ كَودَنٌ تَدمى دَوابِرُهُ","فيهِ من السوطِ وَالساقَينِ تَربيدُ",27,"د",1,0],["كأنه كاغد الكتاب ما نسيت","أَقلامهم حرف جسم غير منعجم",28,"م",1,0],["كَأَنَّهُ كَعبَة وَالناسِ قاصِدَة","من كُل فَج فَتَأتيهِ بِاِظعان",29,"ن",1,0],["كَأَنَّهُ كَعبَة وَالناسُ ظاعِنَة","تَسعى لَهُ في سِنين اقط وَالجَدب",30,"ب",1,0],["كَأَنه كان في الأَيام مغترباً","وَكل روح غريب في ديار بدن",31,"ن",1,0],["كأنه كوة في حائط نقبت","في ظلمة الليل يأوي جوفها حنش",32,"ش",1,0],["كأنه كوكبٌ مثار","أثاره ماردٌ رجيمُ",33,"م",1,0],["كَأَنَّهُ كانَ في الاعصارِ اجمعَها","وَكُل عَصرٍ لَهُ استنسابُهُ يَدعُ",34,"ع",1,0],["كأنهُ كسرى على كُرسيهِ","وحاجِبٌ بالقَوسِ مِنهُ قد دَنَا",35,"ا",1,0],["كَأَنهُ كانَ يَرقُبُها","فَحينَ عَنَينَهُ فَهِما",36,"م",2,0],["كانه كان يلقى","وفدا لجدواه غادى",37,"د",2,0],["كأنّهُ كان يَدنو كَي يُسائِلَها","هَل مَرَّ قَبلَ مُروري شاعِرٌ ونَجَا؟",38,"ج",2,0],["كأنه كان يتأمل بعد عنوه يوصلني","ولكن خابت اظنونه/ على لأبواب نواحه",39,"ح",2,0],["كأنه كان محروباً وقد سلبت","أموالهُ قبلما خانته أموالُ",40,"ل",1,0],["كأنه كُثُبٌ أَودعْتها غَدَقا","فإن هَفَوتَ لهيفاًِِ صادياً شحا",41,"ح",2,0],["كأنَّهُ .. كُلُّ خلقِ اللهِ تعرِفهُ","كأنَّ فيهِ جميعُ النَّاس قدْ عَبروا",42,"ر",3,0],["كأنه كان يرى حتفه","يوم مضى من شدة الوجد",43,"د",1,0],["كأنّه كَفُّ فتى ً جَحجَاحِ","مَبْذُولَة ٍ للجودِ والسَّمَاحِ",44,"ح",1,0]]}