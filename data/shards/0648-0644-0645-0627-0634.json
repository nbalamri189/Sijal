{"poems":[[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[88,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[72,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[60,"وما سر قلبي مذ شطت بك النوى","https://www.aldiwan.net/poem13280.html","الطويل"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"كأني في روض أرى الماء جاريا","https://www.aldiwan.net/poem8854.html","عموديه"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[91,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[158,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[202,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[259,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[302,"حويدي المطايا كم تقيم مع الصد","https://www.aldiwan.net/poem16864.html","الطويل"],[318,"ولما شربناها ودب دبيبها","https://www.aldiwan.net/poem61743.html","الكامل"],[351,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[364,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[369,"أتاني ما طربت له سرورا","https://www.aldiwan.net/poem57431.html","الكامل"],[399,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[406,"قصر خطوي وحنا صعدتي","https://www.aldiwan.net/poem31665.html","عموديه"],[413,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[429,"يا ملكا وهو بالتقى ملك","https://www.aldiwan.net/poem12362.html","المنسرح"],[438,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[450,"حسبي نفارك عذرا من تجافيك","https://www.aldiwan.net/poem13874.html","البسيط"],[462,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[493,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[504,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[549,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"]],"verses":[["وَلَمَّا شَجاَهُ الُبُعْدُ عَنْكَ وَشَفَّهُ","تَبَدَّى نُحُولُ الشَّوْقِ فَوْقَ هِلاَلِهِ",0,"ل",2,0],["ولمّا شَكا لهُ اللُّهامُ منَ الظَّما","أسالَ لهُ منْ ماءِ أنْمُلِهِ وِرْدا",1,"د",2,0],["وَلَم أَشهَدِ الخَيلَ المُغيرَةَ بِالضُحى","عَلى هَيكَلٍ عَبلِ الجُزارَةِ جَوّالِ",2,"ل",1,0],["ولما شكت لي حُرقةً في فؤادها","ترقرق دمع العين في خدّها يجري",3,"ر",2,0],["ولما شكونا من جمادى زماننا","فضلت على نوء الربيع المحرّم",4,"م",1,0],["ولم أشهد اللذات إلاَّ تكلُّفاً","وأيّ سرورٍ يقتضيهِ التكلّفُ",5,"ف",1,0],["ولما شارفت بغداذ تسري","بنا والليل مَزْرُورُ الجيوبِ",6,"ب",1,0],["ولم أُشرِّفك بها بل أرى","بالحق أني بك شرَّفْتُها",7,"ت",3,0],["ولما شدتُ منك غيرَ مَشِيدٍ","إنَّ ما قلتُ قد يُناغي مشيدَكْ",8,"ك",1,0],["ولَما شهدتُ لهم بغير جليةٍ","ولما رفعتُ بقدرهم موضوعا",9,"ع",2,0],["وَلَمّا شَكَوتُ الوَجدَ وَجدي تَمايَلَت","كَأَنَّ الَّذي أَشكوهُ ضَربٌ مِنَ الخَمرِ",10,"ر",1,0],["وَلَمّا شَأى في المَجدِ سَبقاً تَقَدَّمَت","لَهُ في مَداهُ غُرَّةٌ وَحُجولُها",11,"ل",3,0],["ولَمَا شَهِدْتَ من الوقائع إنّها","أبْقَى من الشِّعْرِ الذي يُتَمثَّل",12,"ل",1,0],["وَلَم أَشك من دنياي إلا ظلامة","وَسهماً إلى قلب العراق مسددا",13,"د",2,0],["ولما شكا الجيش اللهام له الظما","أسال له من ماء أنمله وردا",14,"د",2,0],["ولمّا شكوت الوجد تمايلت","كأنّ الذي أشكوه ضرب من الخمر",15,"ر",1,0],["ولما شم ريح الموت أضحى","يراسل في الرضى والاصطلاح",16,"ح",1,0],["ولم أشتغل عن حُسن وجهك إذ بدا","تقطُّبُه إلا بحُسن عزاءِ",17,"ا",2,0],["ولما شهدت الجود يوجد فيهم","ولم يبق في الأيام إلا ادكاره",18,"ر",2,0],["ولم أشتفي من قرب سلمى ووصلها","وتقبيل خال الخد مستودع العهد",19,"د",1,0],["وَلَمّا شَرِبناها وَدَبَّ دَبيبُها","وَأَطمَعَني الساقي بِوَعدٍ بِهِ يَفي",20,"ف",2,1],["وَلمّا شَمَمنا نَفحة القُرب مِنكُم","سرت مَع نسيمات اللقا بِشَذا العطرِ",21,"ر",1,0],["وَلَمّا شَقَقنا الحُجبَ عَن نورِ وَجهِهِ","شَقَقنا عَلى عاتٍ مِنَ الدَهرِ عاتِمِ",22,"م",1,0],["ولم أشعُر بها حتى استَضاءَت","فدلَّتني على نَظرِ القشوري",23,"ي",1,0],["ولمّا شكوتَ الدهرَ يا خير ماجدٍ","غدوتُ بقلْبٍ من همومي حَرّانِ",24,"ن",1,0],["ولم أشق الجيش لا أختشي","من الردى كالقدر النازل",25,"ل",1,0],["ولم أشِمْ وامض برقٍ لامعاً","إلاَّ ذكرت الثغر والجبينا",26,"ن",2,0],["ولم أُشاهِدْ ولا سَمِعْتُ بِهِ","من قبلِ ذا اليومِ وَقْعَةَ الإِبِلِ",27,"ل",1,0],["ولم أشتغل بالصالحات لأنها","لم يبتغي جنات عدن سلالم",28,"م",1,0],["ولم أشكُ بأني منكِ في خَلَدٍ","وقد أبى اللحظ إِلا نفي تَشكيكي",29,"ي",1,0],["ولما شربناها أتقى سورةَ الدجى","فأضرم نارَ الوجد في فحمة القلب",30,"ب",1,0],["ولما شكوت الهوى قال لي","سحبتَ الرّداءَ ولم تلقه",31,"ق",2,0],["وَلَم أشفِ مِن لُقياكَ قَلبي فَليتَني","لِبَرحِ اشتِيَاقِي لو قَضَيتُ بِهِ نَحبِي",32,"ب",2,0],["وَلَمّا شَرِبتُ الوُدّ منكمْ بسومِكمْ","رجعتُ بكفٍّ بيعُها غيرُ رابحِ",33,"ح",1,0],["ولَم أَشفِ ما بي مِن جَوىً ومضاضةٍ","بِقَرع جبيني أَو غَضيض رَواجبي",34,"ب",2,0],["ولما شربت كؤوس الهوى","وذقت المدامة والقرقفا",35,"ف",2,0]]}