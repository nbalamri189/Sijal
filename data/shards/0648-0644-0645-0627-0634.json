{"poems":[[79,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[79,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[90,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[74,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[62,"وما سر قلبي مذ شطت بك النوى","https://www.aldiwan.net/poem13280.html","الطويل"],[53,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[53,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[93,"كأني في روض أرى الماء جاريا","https://www.aldiwan.net/poem8854.html","عموديه"],[47,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[79,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[93,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[164,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[208,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[266,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[309,"حويدي المطايا كم تقيم مع الصد","https://www.aldiwan.net/poem16864.html","الطويل"],[325,"ولما شربناها ودب دبيبها","https://www.aldiwan.net/poem61743.html","الكامل"],[358,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[371,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[376,"أتاني ما طربت له سرورا","https://www.aldiwan.net/poem57431.html","الكامل"],[408,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[415,"قصر خطوي وحنا صعدتي","https://www.aldiwan.net/poem31665.html","عموديه"],[422,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[438,"يا ملكا وهو بالتقى ملك","https://www.aldiwan.net/poem12362.html","المنسرح"],[447,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[457,"حسبي نفارك عذرا من تجافيك","https://www.aldiwan.net/poem13874.html","البسيط"],[469,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[500,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[511,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[556,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[563,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104480","الوافر"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61023","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204060","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65031","المتقارب"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199189","الوافر"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44761","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71078","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71039","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27844","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28035","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121187","الطويل"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17405","الوافر"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143112","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204433","المتقارب"],[3264,"","https://poetry.dctabudhabi.ae/diwan/poem/198455","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59485","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94840","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94883","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136625",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136509",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33325","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33268","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33681","الطويل"],[4858,"حنين إلى الأهل والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=138206",""],[5264,"أصل الحكاية","https://www.poetsgate.com/ViewPoem.aspx?id=185053",""],[5409,"لا عشت لصاً في ثياب عسيس","https://www.poetsgate.com/ViewPoem.aspx?id=155282",""],[5431,"فلا تسأل سؤالك ليس يجدي!...","https://www.poetsgate.com/ViewPoem.aspx?id=191234",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5464,"يا جبل الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=6672",""],[5691,"رسالة التعليم","https://www.poetsgate.com/ViewPoem.aspx?id=206587",""],[6046,"لا ياس مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=35245",""],[6068,"لو تسألوني عن هوى كبدي -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175855",""],[6131,"وَ غَنَّى الشَّهيدُ الشَّاعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=189277",""],[5309,"قضيت العمر في سكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573569",""],[520,"يا اسد الدين بدت حاجة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577528",""]],"verses":[["وَلَمَّا شَجاَهُ الُبُعْدُ عَنْكَ وَشَفَّهُ","تَبَدَّى نُحُولُ الشَّوْقِ فَوْقَ هِلاَلِهِ",0,"ل",2,0],["ولمّا شَكا لهُ اللُّهامُ منَ الظَّما","أسالَ لهُ منْ ماءِ أنْمُلِهِ وِرْدا",1,"د",2,0],["وَلَم أَشهَدِ الخَيلَ المُغيرَةَ بِالضُحى","عَلى هَيكَلٍ عَبلِ الجُزارَةِ جَوّالِ",2,"ل",1,0],["ولما شكت لي حُرقةً في فؤادها","ترقرق دمع العين في خدّها يجري",3,"ر",2,0],["ولما شكونا من جمادى زماننا","فضلت على نوء الربيع المحرّم",4,"م",1,0],["ولم أشهد اللذات إلاَّ تكلُّفاً","وأيّ سرورٍ يقتضيهِ التكلّفُ",5,"ف",1,0],["ولما شارفت بغداذ تسري","بنا والليل مَزْرُورُ الجيوبِ",6,"ب",1,0],["ولم أُشرِّفك بها بل أرى","بالحق أني بك شرَّفْتُها",7,"ت",3,0],["ولما شدتُ منك غيرَ مَشِيدٍ","إنَّ ما قلتُ قد يُناغي مشيدَكْ",8,"ك",1,0],["ولَما شهدتُ لهم بغير جليةٍ","ولما رفعتُ بقدرهم موضوعا",9,"ع",2,0],["وَلَمّا شَكَوتُ الوَجدَ وَجدي تَمايَلَت","كَأَنَّ الَّذي أَشكوهُ ضَربٌ مِنَ الخَمرِ",10,"ر",1,0],["وَلَمّا شَأى في المَجدِ سَبقاً تَقَدَّمَت","لَهُ في مَداهُ غُرَّةٌ وَحُجولُها",11,"ل",3,0],["ولَمَا شَهِدْتَ من الوقائع إنّها","أبْقَى من الشِّعْرِ الذي يُتَمثَّل",12,"ل",1,0],["وَلَم أَشك من دنياي إلا ظلامة","وَسهماً إلى قلب العراق مسددا",13,"د",2,0],["ولما شكا الجيش اللهام له الظما","أسال له من ماء أنمله وردا",14,"د",2,0],["ولمّا شكوت الوجد تمايلت","كأنّ الذي أشكوه ضرب من الخمر",15,"ر",1,0],["ولمّا شكى لبنان ضجّت أميّة","وجنّت له بغداد والتهبت مصر",16,"ر",1,0],["ولما شم ريح الموت أضحى","يراسل في الرضى والاصطلاح",17,"ح",1,0],["ولم أشتغل عن حُسن وجهك إذ بدا","تقطُّبُه إلا بحُسن عزاءِ",18,"ا",2,0],["ولما شهدت الجود يوجد فيهم","ولم يبق في الأيام إلا ادكاره",19,"ر",2,0],["ولم أشتفي من قرب سلمى ووصلها","وتقبيل خال الخد مستودع العهد",20,"د",1,0],["وَلَمّا شَرِبناها وَدَبَّ دَبيبُها","وَأَطمَعَني الساقي بِوَعدٍ بِهِ يَفي",21,"ف",2,1],["وَلمّا شَمَمنا نَفحة القُرب مِنكُم","سرت مَع نسيمات اللقا بِشَذا العطرِ",22,"ر",1,0],["وَلَمّا شَقَقنا الحُجبَ عَن نورِ وَجهِهِ","شَقَقنا عَلى عاتٍ مِنَ الدَهرِ عاتِمِ",23,"م",1,0],["ولم أشعُر بها حتى استَضاءَت","فدلَّتني على نَظرِ القشوري",24,"ر",2,0],["ولمّا شكوتَ الدهرَ يا خير ماجدٍ","غدوتُ بقلْبٍ من همومي حَرّانِ",25,"ن",1,0],["ولم أشق الجيش لا أختشي","من الردى كالقدر النازل",26,"ل",1,0],["ولم أشِمْ وامض برقٍ لامعاً","إلاَّ ذكرت الثغر والجبينا",27,"ن",2,0],["ولم أُشاهِدْ ولا سَمِعْتُ بِهِ","من قبلِ ذا اليومِ وَقْعَةَ الإِبِلِ",28,"ل",1,0],["ولم أشتغل بالصالحات لأنها","لم يبتغي جنات عدن سلالم",29,"م",1,0],["ولم أشكُ بأني منكِ في خَلَدٍ","وقد أبى اللحظ إِلا نفي تَشكيكي",30,"ك",2,0],["ولما شربناها أتقى سورةَ الدجى","فأضرم نارَ الوجد في فحمة القلب",31,"ب",1,0],["ولما شكوت الهوى قال لي","سحبتَ الرّداءَ ولم تلقه",32,"ق",2,0],["وَلَم أشفِ مِن لُقياكَ قَلبي فَليتَني","لِبَرحِ اشتِيَاقِي لو قَضَيتُ بِهِ نَحبِي",33,"ب",2,0],["وَلَمّا شَرِبتُ الوُدّ منكمْ بسومِكمْ","رجعتُ بكفٍّ بيعُها غيرُ رابحِ",34,"ح",1,0],["ولَم أَشفِ ما بي مِن جَوىً ومضاضةٍ","بِقَرع جبيني أَو غَضيض رَواجبي",35,"ب",2,0],["ولما شربت كؤوس الهوى","وذقت المدامة والقرقفا",36,"ف",2,0],["ولَما شكا جفني القريحُ سُهَادَهُ","ولما شكا قلبي المشوَّقُ نارَا",37,"ر",2,0],["ولما شاقني فيها جنوني","دعوت علي بالسودا عليا",38,"ي",2,0],["وَلَم أَشهَدِ البَأسَ يَومَ الوَغى","عَلَيَّ المُفاضَةُ وَالمِغفَرُ",39,"ر",1,0],["وَلَما شَكَت تلكَ الجِهات أَذى العِدى","وَقَد بَلَغت فيها النُفوس التراقيا",40,"ي",2,0],["ولما شربناها ودب دبيبها","إلى موضع السرار قلت لها قفي",41,"ي",1,1],["ولمّا شَكَوْتُ إِليها الجَوَى","وعَتْهُ لها أُذُنٌ واعِيَهْ",42,"ي",2,0],["وَلَم أَشرَب حُمَيّاً أُمِّ دَفرٍ","وَأَنتَ شَرِبتَها حَتّى سَكِرتا",43,"ت",2,0],["ولما شاب رأس الدهر غيظاً","لما قاساه من فقد الكرام",44,"م",1,1],["وَلَم أُشرِك بِرَبِّ الناسِ شَيئاً","فَقَد أَمسَكتُ بالدينِ الوَثيقِ",45,"ق",1,0],["ولم أَشْفِ من أَرض العدوّ بِغارَة","غليلا ولم أَجْرِ الدِّماءَ صَبيبا",46,"ب",2,0],["ولَما شَعَرْتُ بما شَعَرْتُ به ولا","تَرْجَمْتُ ما أَصْبَحتُ عنه أُتَرْجِمُ",47,"م",1,0],["ولم أشهدِ الأقوام لكن رأيتُهم","سكارى حيارى يطلبون على مثلي",48,"ل",2,0],["ولما شهدناها وجئت إلى منى","بذلت له بالنحر ما كان في وسعي",49,"ع",2,0],["وَلَمّا شَكَت فَقدَ الكِرام إِلَيكُمُ","وَكانَ عَلَيكُم بَعثُها وَنُشورُها",50,"ر",3,0],["ولما شكت اسيافهم حر ظمأها","سقوها دماء من نحور واكبد",51,"د",1,0],["وَلَم أُشرِك بِرَبِّ الناسِ شَيئاً","فَقَد أَمسَكتُ بِالحَبلِ الوَثيقِ",52,"ق",1,0],["ولما شكى داء قديماً بدبره","إلي وداء من فم منه أبخر",53,"ر",1,0],["ولما شُغفت بكل الوجود","تحققت خلقي من كل شي",54,"ي",1,0],["ولم أشك الهجير وقد دعاني","إلى أرجائك الظل الظليل",55,"ل",1,0],["ولما شاءت الأقدار شيئاً","وقال السبط أنت وما تشائي",56,"ا",2,0],["ولما شكى العافون ما حل عندما","بأنيابها عضّتهم ألسنة السنوا",57,"و",2,0],["ولم أشرب الصّرفَ السُّلاف ولم أُنل","مواهبَ يُلحقنَ الفقيرَ بذي المالِ",58,"ل",1,0],["ولما شاهدوا الأنوار عضوا","من التفريط أيديهم ندامى",59,"م",2,0],["ولمّا شرَّف الملك المفدّى","لسوريّا ليوبُلدُ العظيمُ",60,"م",1,1],["ولمّا شدا أرخٌ بمدحٍ أشادها","فحُقٌّ إلى الشكريِّ حمدٌ مع الشكري",61,"ي",1,0],["ولما شكوتُ الوجد جدَّ بهَجره","وأقسم لي أن لا يرِّق لمغُرم",62,"م",1,0],["ولم أشكُ الا من عيونٍ روامقٍ","إلي كما يرنُو فريسَته الذئب",63,"ب",1,0],["ولم أشكُ حتى ذابَ قلبيَ في صدري","ولم يبقَ لي من مقلتي عبرةٌ تجري",64,"ر",2,1],["ولم أشك ما بالقلب مما أرى به","من الشوقِ حتى كاد يخرجُ من صدري",65,"ر",2,0],["ولم أشكُ طولَ الليلِ حتَّى رأيتني","أقلِّبُ طرفاً يَرقُبُ النجمَ باكيا",66,"ي",2,1],["ولمّا شفى الله الرّحيمُ قلوبنا","من الشّوق،عاد الشّوقُ وهو سؤولُ",67,"ل",1,0],["ولما شىء يئلم نفوسنا","كنت بتطيب جروحنا",68,"ن",2,0],["ولما شهدت وفي الحياة عجائبٌ","نفساً تعيش على هلاك نفوسِ",69,"س",1,0],["ولم أشرب بكأس الغل يوما","ولم أُثقل على الخلان ظلا",70,"ل",2,0],["ولما شكت مصرو ناحت فارس","وبكى العراق لوقعه والشام",71,"م",1,0],["ولمّا شكَّ بي جسدي وكادتْ","تُعيّرني المَباهجُ والرِّغابُ",72,"ب",1,0],["ولمْ أشْكُ يوْماً ما ألاقيهِ منْ ضنىً","وما مسَّني كَلٌّ يفِلُّ زنادي !",73,"د",2,0],["ولم أشْكُ للأيّامِ ما كانَ حلَّ بي","فتحسِبَ أنّي ناقمٌ متشائِمُ",74,"م",1,0],["ولِما شققتُ لها شعاع سنا","من إسمها يا حسنه- إسما",75,"م",2,0],["وَ لمَّا شقَّ مائِيَ صَدرَ صخرٍ","ركبتُ الملحَ وَ الأمواجُ يختُ",76,"ت",1,0],["وَلَم أَشرَب عَصيرَ الكَرمِ","أَو صِنفاً مِنَ الخَمرِ",77,"ر",1,0],["ولم أشم وجه القوافي بها","رفعاً لمقدارك عن قدرها",78,"ر",3,0]]}