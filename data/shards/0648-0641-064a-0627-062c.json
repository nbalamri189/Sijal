{"poems":[[95,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114382","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114067","المتقارب"],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""]],"verses":[["وَفِي اجْتِلاءِ الفَتَى مَحَاسِنَهَا","إِنْ يَنْطَلِقْ هَادِيّاً وَإِنْ يَهِمِ",0,"م",1,0],["وفي أجعلتهم شهادَةُ ربٍّ","لهُ خَصَمَت كُلَّ مُختَصَمِ",1,"م",1,0],["وَفِي أجَعَلتُم شَهَادَةُ رَبِّ","لَهُ أنَّهُ خَيرُ أربَابِهَا",2,"ب",3,0],["وفي أجفانهِ آيات سحرٍ","أيا للّه من سحرٍ حلالِ",3,"ل",1,0]]}