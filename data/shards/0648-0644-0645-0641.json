{"poems":[[234,"وجدت فلم لم تجد","https://www.aldiwan.net/poem51158.html","مجزوء المتقارب"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44836","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100374","الكامل"],[4121,"","https://poetry.dctabudhabi.ae/diwan/poem/199830","الوافر"],[6069,"أبت عبرات العين بعدك أن ترقا","https://www.poetsgate.com/ViewPoem.aspx?id=105692",""]],"verses":[["ولِمْ فترتْ مقلتاك","فُتُوراً أمات الجَلَد",0,"د",1,0],["ولمفرقي أبداً يُكلّل تاجها","ولأخمصي أبداً تقدّ نِعالُها",1,"ل",3,0],["ولمفرد الكلم البديع تصوغه","جملاً تفصل آيها تفصيلا",2,"ل",2,0],["ولم فضحت بمعصمها اعتصامي","وأطبقت العقيق على الّلآلي",3,"ل",2,0],["ولم فرقوا بين المنية والنوى","ولم يجدوا في الفعل بينهما فرقا",4,"ق",2,0]]}