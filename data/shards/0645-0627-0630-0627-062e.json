{"poems":[[108,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84488","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20642","الكامل"],[4961,"زهرةُ آخرِالأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=40463",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["ماذا خُلقتَ؟ أكتلةً من أكبدٍ","أم من عواطفَ كالنسيمِ رقاق؟",0,"ق",1,0],["ماذا خُلقت؟ دمًا ولحمًا أم سنًا","وأشعةً؟ آمنتُ بالخَّلاق",0,"ق",1,0],["ماذا خبأتَ لوجه ربّك في غدٍ","ماذا فعلتَ له وأنتَ مُضَيَّعُ",1,"ع",1,0],["ماذا خُصِصتَ بِنِعمَةٍ وَرُزِقتَها","مِن فَضلِ رَبِّكَ مِنَّةَ تَغشاها",2,"ا",3,0],["ماذا خسرتُ وأنتِ شهدُ قافيتي","وبلسمي منكِ أعطى العَالَمَ الطِّبا",3,"ب",2,0],["ماذا خبّأت لعصبة","عبثت بساحتك الأمينة؟",4,"ن",2,0]]}