,""],[5072,"قلب ٌ غزاها","https://www.poetsgate.com/ViewPoem.aspx?id=51897",""],[5183,"ثورة العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185645",""],[5187,"يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=37394",""],[5205,"كتب الجمال بطرس خذك أسطراً","https://www.poetsgate.com/ViewPoem.aspx?id=120995",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5324,"شهادة في حضرة الحب .","https://www.poetsgate.com/ViewPoem.aspx?id=207309",""],[5365,"ياشام","https://www.poetsgate.com/ViewPoem.aspx?id=190818",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""],[5720,"نشيدُ البَيعَة","https://www.poetsgate.com/ViewPoem.aspx?id=201302",""],[5725,"دهم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=177935",""],[5776,"درس الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=199339",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5956,"هي رمزُ عقلانية وتبصر","https://www.poetsgate.com/ViewPoem.aspx?id=193992",""],[5956,"ما أحسن الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=194558",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[6069,"يا باكي الدار بكاظمةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105659",""],[6230,"مِنْ أجْلِهَا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67163&r=&rc=37",""]],"verses":[["هِيَ عِندَهُ سَبَبُ الشَبا","بِ وَعِندَنا سَبَبُ الفِطامِ",0,"م",1,0],["هِيَ عَلَّمَتْهَا مَا الحَيَاةُ وَمَا","يُوحِيهِ مَجْدُ النيلِ وَالهَرَمِ",1,"م",1,0],["هي عادة عذرية من يوم أن","خُلِقَ الهوى تعتاد كلَّ مُتَيَّمِ",2,"م",1,0],["هي عيني ودمعها نضّاح","كل حزن لمائها يمتاح",3,"ح",1,1],["هي عند أرباب العقو","ل أجلّ من حَدَ وغاية",4,"ا",3,0],["هي عادة في الحب قد عاش الأولى","قبلي بها ومضوا إلى الأرماس",5,"س",1,0],["هي عادة من فضل بيتكم الذي","خُلقت مناقبه الحسان تماما",6,"م",2,0],["هي عندي كجودِ فضلِ بن يحيى","غيرَ أنْ ليس تَنْعشُ الفُقراءَ",7,"ا",2,0],["هي عادة حسناء ان لم نحتفل","بجمالها ذهبت الى الاغيار",8,"ر",1,0],["هِيَ عَزمَةٌ كَالسَيفِ إِلّا أَنَّها","جُعِلَت لِأَسبابِ الزَمانِ قَضوبا",9,"ب",2,0],["هي عُدَّةُ الشَّعبِ الضَّعيفِ ليومهِ","وذخيرةُ الوطنِ المُعذَّبِ للغدِ",10,"د",1,0],["هي عندهم للَّهِ أو هم عندها","خُدّامُهُ سبحانه مخدوما",11,"م",2,0],["هِيَ عِصْمَةُ الدِّينِ التي أَوْحَى بِهَا","رَبُّ الْعِبَادِ إِلَى النَّبِيِّ مُحَمَّدِ",12,"د",1,0],["هي عندي شمائل وعطور","وقلوب تهوى ودلّ يفدّى",13,"د",2,0],["هي عصبة الفضلاء في غصاتها","يجري لها بحر الهموم المزبد",14,"د",1,0],["هي عادة فليبتغوا بدلاً بها","ان الخلائق في الانام تعوُّدُ",15,"د",1,0],["هي عندي منك يا ظلام روح","تأمر القلب وتنهى ما تشاء",16,"ا",2,0],["هي عذراءُ وحبّي","ظَلَّ عُذرياً لدَيها",17,"ي",3,0],["هِيَ عَادَةٌ لِلْمُزنِ يَحْفَظُ رَسْمَهَا","حِفْظَ الأَميرِ العَدْل والإِحْسَانا",18,"ن",2,0],["هيَ عينُ الحياة فاِحي بها","روحَ صبٍّ بروحِه يَفديك",19,"ك",1,0],["هي عذراءُ من ملائكةِ الشع","رِ بناتِ الإلهامِ والإيحاءِ",20,"ا",2,0],["هِيَ عِيرٌ مقْطورةٌ فَصَلَتْ لِلْ","لهِ مَذخورةٌ ليومِ الجزّاء",21,"ا",2,0],["هِيْ على الأغصان في الظل الظليل","وأنا مالت غصوني",22,"ي",1,0],["هي عندي ستون عاماً تِبَاعاً","ولهم جنة من الإِمهال",23,"ل",1,0],["هي عند فضلك مثل ضوءِ حباحبٍ","رأد الضحى لكن عفوك وارفُ",24,"ف",1,0],["هي عتب المحب مهما قسا العت","ب فما يأسي الأليم بيأس",25,"س",1,0],["هي عزًّةٌ تعْتادُ كل مُمجَّدٍ","فتقولُ عنه قصائدٌ ورسائل",26,"ل",1,0],["هي عادة الأيَّام تمنع جانباً","وتبيح للمنوع أمنع جانبِ",27,"ب",1,0],["هيَ عادةُ الأيام في أبنائها","والشيءُ ليس بزائلٍ عن عاده",28,"د",2,0],["هي عندي كل المنى","ليت شعر ما عندها",29,"ه",2,0],["هي عند مَن حَمَل الغرا","مَ كثيرةٌ وهي القليلَهْ",30,"ل",2,0],["هي عيشةٌ من بعدها هُلُكٌ","أو صحّةٌ في إثْرها عِلَلُ",31,"ل",1,0],["هي عادةٌ للدّهر واحدةٌ","فَاِصبِرْ لمُرِّ عوائد الدّهرِ",32,"ر",1,0],["هي عندي مكشوفة كشف عين","وهي عندي محجوبة حجب لبس",33,"س",1,0],["هِيَ عُذْرَةُ اللَّذَّاتِ وَال","لَّذَاتُ أَطْيَبُهَا العُذَرْ",34,"ر",1,0],["هي عنده كسيوف من غلبوا العدى","ان ثارت الهيجاء او مثل القنا",35,"ن",2,0],["هي عوراء باليمين وهذا","أعور باليسار وافق شَنَّا",36,"ن",2,1],["هيَ عِلَّةٌ عُذريَّةٌ ما إن يَرى","إن عُولِجَت غَيرَ الشِّفاهِ لَها شِفا",37,"ف",2,0],["هي عَادةٌ لك لم تزل","يا أيها العَوْدُ المكرَّرْ",38,"ر",1,0],["هي عيني إذا نظرتُ وسمعي","وهي ديني وقبلتي وثوابي",39,"ب",2,0],["هيَ عَزمَةُ اللَّيْثِ الْهَصُورِ وماجِدٌ","ثَبْتُ الجَنانِ وصارِمٌ مَقْعُودُ",40,"د",1,0],["هي عين ما نزل الأمين بهِ على ال","هادي الأمين وما سواها زخرفه",41,"ف",2,0],["هي علة أو سكرةٌ لا ترتجي","صحواً وكيفَ وما عدِمتُ الساقي",42,"ق",2,0],["هِيَ عَزمَةٌ بَرَتِ العِدا فَقُلوبُهُم","في غايَةِ الإيجافِ وَالإِضناءِ",43,"ا",2,0],["هِيَ عَزمَةٌ قَد أَنقَتِ الأَمرَ العَلِي","يَ من الأَذى وَسَوادِ مُلكِ الأَعبُدِ",44,"د",1,0],["هي عند الأديب لحنٌ رخيم","أو شراب من السلافة صافي",45,"ف",2,0],["هي عاطتهم لماها ولما","أسكرتهم به سقتهم عقارا",46,"ر",2,0],["هي عدتي في الحشر ميزاني إذا","ما خِفْتُ قمت بها أَمُتُّ فَيَثقُل",47,"ل",1,0],["هِيَ عَينُ فِعلِ الرَّبِّ لا أفعَالُهُم","فَيَصِحُّ عَنهُم عِندَ ذَا نَفيَانِ",48,"ن",1,0],["هِيَ عِندَكُم مِثلُ النُّصُوصِ وَفَوقَهَا","في حُجَّةٍ قَطعِيَّةٍ وَبَيَانٍ",48,"ن",1,0],["هِيَ عَكَّسَتكُم غَايَةَ التَّعكِيسِ وَاق","تَلَعَت دِيَارَكُمُ مِنَ الأركَانِ",48,"ن",1,0],["هِيَ عِصْمةٌ بالله فاعتَصِمُوا","لاَ تَفْرُقُوا فنَصِيرَ لِلْكُرَبِ",49,"ب",1,0],["هي عادةُ الأيام أنْ هي ألْبَسَتْ","سَلَبَتْ فَضَالةَ ذلك السربالِ",50,"ل",1,0],["هِيَ عَين القَذى لِعَين الحَسود","تَربة ما السَما وَلا نَيّراها",51,"ه",2,0],["هى عادة مألوفة","فى الناس منذ الأول",52,"ل",1,0],["هي عهدٌ ختمتهُ شفةٌ","حبذا ختمٌ بحبرِ الريقِ عذبُ",53,"ب",1,0],["هي عندي معنى الحياة.. وعندي","هي معنى الردى.. ومعنى المعنى",54,"ن",2,0],["هي علامات الرَقاق","فانظر إلى الرِقاق",55,"ق",1,0],["هيَ عادةٌ تجري بها ال","دّنيا إِلى غاياتها",56,"ت",3,0],["هي عين إنسان القريض وليتني","لي مخلص ألقى به إنسانها",57,"ن",3,0],["هي عِرسُهُ هيَ أُنسه هيَ إِلفُهُ","هيَ حِبُّهُ صِدقاً بِلا أَدهانِ",58,"ن",1,0],["هي عِدَّةُ الثالوثِ ذي ال","إِكرامِ والمجدِ الرفيعِ",59,"ع",1,0],["هي عدن لكنها 