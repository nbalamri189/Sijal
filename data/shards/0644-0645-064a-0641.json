iwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83458","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123456","الكامل"],[4796,"الى دعد في عامنا الثالث عشر","https://www.poetsgate.com/ViewPoem.aspx?id=34721",""],[4830,"دَمْعُ الصَّبابة","https://www.poetsgate.com/ViewPoem.aspx?id=202359",""],[4862,"ليته في ذلك الليل رقد","https://www.poetsgate.com/ViewPoem.aspx?id=55627",""],[4915,"شريعةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211502",""],[4929,"مرثية الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=204918",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[3591,"خطرت فقلتُ البان ليست عاكباً","https://www.poetsgate.com/ViewPoem.aspx?id=149407",""],[5224,"يا نديمي قم فإن الديك صاح","https://www.poetsgate.com/ViewPoem.aspx?id=121313",""],[5226,"للقدس .. كلام آخر","https://www.poetsgate.com/ViewPoem.aspx?id=27720",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5431,"لك سحنة الخنزير حين تباغتُ","https://www.poetsgate.com/ViewPoem.aspx?id=194352",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5956,"ضياع طفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184565",""],[5956,"أفرحْتِنا فرحاً يعيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=207451",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[520,"يا دار عليك سعد المشتري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577539",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["لَم يُفقَدَ الوُدُّ مِن قَلبي لِمَفقَدِها","لَكِنَّ قَلبي غَداةَ البَينِ قَد فُقِدا",0,"د",2,0],["لَم يَفتَأِ الناسُ حَتّى أَحدَثوا بِدَعاً","في الدينِ بِالرَأيِ لَم يُبعَث بِها الرُسُلُ",1,"ل",1,1],["لم يفقدوا أما وقد فقدوك","فقدوا أباً وأخاً وخير شريك",2,"ك",1,1],["لَم يَفوتونا بِشَيءٍ ساعَةً","غَيرَ أَن وَلَّوا بِجُهدٍ وَفَشَل",3,"ل",1,0],["لَم يَفهَموا ما الشِعرُ إِلّا أَنَّهُ","قَد باتَ واسِطَةً إِلى الإِثراءِ",4,"ا",2,0],["لَم يَفهَموا مَعنى الحَياةِ وَكَنهَها","إِنَّ البَلِيَّةَ أَنَّهُم لَم يَفهَمو",5,"م",2,0],["لَم يَفُه بِالنَوابِغِ الغُرِّ حَتّى","سَبَقَ الخَلقَ نَحوَهُ البُلَغاءُ",6,"ا",2,0],["لَم يَفقِدِ المَرءُ نَفعَ شَيءٍ","سَدَّ لَهُ غَيرُهُ مَسَدَّه",7,"د",2,0],["لم يَفْدِهِ طبٌّ ولمْ يُغنِهِ","علمٌ ولمْ ينفعْهُ حسنُ العلاجْ",8,"ج",1,0],["لَم يَفسُقِ القَومُ غالَتهُم خَبائِثُهُم","في الذاهِبينَ مِنَ الأَقوامِ ما فَسَقوا",9,"ق",3,0],["لَم يَفُتنا بِالوِترِ قَومٌ وَلِلضَي","مِ رِجالٌ يَرضَونَ بِالإِغماضِ",10,"ض",1,0],["لَم يَفعَلُ البَينُ إِلّا ما فَعَلتَ وَما","بَينَ الأَخِلّاءِ إِلّا المَطلُ وَالخُلُفُ",11,"ف",1,0],["لَمْ يُفَضِّلْ عليكَ غيرَكَ لكن","نَ عطاياهُ كَالكُؤوسِ المُدَارَهْ",12,"ر",2,0],["لَم يَفطُنوا لِلجَميلِ بَل جُبِلوا","عَلى قَبيحٍ فَما لَهُم قُبِحوا",13,"ح",3,0],["لَم يَفدِ سابورَ وَلا تُبَّعاً","ما وَجَدا مِن ذَهَبٍ يَملِكان",14,"ن",1,0],["لَم يفكر فيما يصير إليه","قبل أَن يدفن الخَليل الخَليل",15,"ل",1,0],["لَمْ يُفَرِّقُ بَيْنَ النَّبَاتِ وَهَلْ فَرَّقَتِ","الشَّمْسُ حِينَ تَبْعَثُ نُورَا",16,"ر",2,0],["لَم يَفعَلوا فِعلَ آلِ حَنظَلَةٍ","إِنَّهُم جيرِ بِئسَ ما اِئتَمَروا",17,"ر",3,0],["لَمْ يَفُزْ مِنْكَ مَرَُّّةً بِثنَاءٍ","فَنَثَرْتَ الأزْهَارَ فَوْقَ تُرَابِهْ",18,"ب",2,0],["لم يفتَتِنْ بالمكرماتِ امرُؤٌ","والغانياتُ فتنةُ العابد",19,"د",1,0],["لم يفصل التاريخُ يومًا بيننا","لكنه عَقَدَ الصِّلاتِ ووثَّقَا",20,"ق",2,0],["لم يفهم المحتلُّ من خُطَبائنا","فلتُفْهموا المحتلَّ ما لم يَفْهَم",21,"م",1,0],["لم يُفضِّل عليك غيركَ لك","عطاياهُ كَالكُؤُوسِ المُدارَه",22,"ر",2,0],["لم يفتها ترف الظل ولا","نال من أوراكها السير الوجيف",23,"ف",1,0],["لم يفهموا معنى الحياة وكنهها","إنّ البليّة أنّهم لم يفهموا",24,"م",3,0],["لم يفهموا ما للشعرº إلا انه","قد بات واسطة إلى الاثراء",25,"ا",2,0],["لَم يَفد سُهدي دَواء وَصفهُ","يَجلب النَوم إِلى جفن النُجوم",26,"م",1,0],["لم يَفُهْ مثلَها فمٌ بقوافٍ","زانَها من لدبك قولٌ وفعْلٌ",27,"ل",1,0],["لم يفقهوا اللفظ ولم يفهموا ال","معنَى ولا يَدرون ميزانَهُ",28,"ن",2,0],["لَم يُفِد رَأيُ مَن يُصانِعُ بِالشَي","ءِ رَجاءً أَن يَمنَعَ الأَشياءَ",29,"ا",2,0],["لم يُفسد التحريرَ منها اللفُّ","ترسُب في جُلاَّبها وتطفو",30,"ف",2,0],["لم يفارقه في الإقامة والظعن","برغم الكثير من أخطار",31,"ر",1,0],["لم يفز من لقاه قلبي بسهم","وله من لحاظه سهمان",32,"ن",1,0],["لم يفقه الدينَ مَنْ لاثوا عمائَمُهمْ","ولا الأُولى حملتْ أَيديهمُ السبحا",33,"ح",2,0],["لم يفت في البر عبدٌ","ومالكٌ في المدينه",34,"ه",1,0],["لم يفرق بين شيخ هرم","ورضيع في حمى المهد وليد",35,"د",1,0],["لم يفلها الصدا","بل قراع القوارع",36,"ع",1,0],["لَم يَفزِقوا بَينَ المُسَمّي وَاِسمِهِ","وَلِغَيرِ رِسمِ الاِسمِ لَم يَتَعَبَّدوا",37,"د",3,0],["لم يَفُتْنِي منه إلا منظرٌ","هو للأحباب نُورٌ لا سِوَى",38,"س",3,0],["لم يُفدْني تطلُّبي من ثِمادٍ","أبتغيه ورقَّةٍ من جَماد",39,"د",1,0],["لم يفرق ما بينه وديار","أرهقته إن باعدته الديار",40,"ر",1,0],["لم يفجع الدهر أحلامي ويرهقها","إلا وعندي له من قبل حسبان",41,"ن",1,1],["لم يفترش عجزا من الرأي ولا","ساور في الأمر الهوى الظَّنِينا",42,"ن",2,0],["لم يفترعْها خُفُّ يعمَلةٍ","أنهبتُ وجنتَها يدَ الوجنا",43,"ن",2,0],["لم يَفْنَ فَضُّ الربيع فيها","عذراءَ مختومةَ العزالي",44,"ل",2,0],["لم يفت سعيهُ محلٌ من المج","دِ ولم يبق فيضُ كفَّيه محلا",45,"ل",2,0],["لم يفتحن حمدان وابن مناهب","أعطاف عطفيها ولم تتكسر",46,"ر",1,0],["لم يفارق أهل الصعيدين إلا","ولمن فيهما عليه عويل",47,"ل",1,0],["لم يفقدوا بك أردشير وإنما","فقدوا نقيصة دينه المستسمجِ",48,"ج",1,0],["لم يُفِدنا وطريفٌ","خادعٌ يوجبُ مَنّا",49,"ن",2,0],["لم يُفْنِ دهرٌ مَن نأى وله بنا","كَلِمٌ على مرّ الزّمان بواقِ",50,"ق",1,0],["لم يَفدِهِ من صَوْلَةِ ال","أيّام أنْ جمعَ الكنوزا",51,"ز",2,0],["لم يفه يا ذا الوجه فمُ","بك لولا أنني العدمُ",52,"م",1,1],["لَم يَفتَتِن مِن عَثرِهِ بِمَساوِئٍ","كَلّا وَلَم يُغمِطهُ مِن حَسَناتِهِ",53,"ت",2,0],["لم يفزع الدستور من أبنائه","إلا إلى آبائه الرحماء",54,"ا",2,0],["لم يفتنوك وإنما داريتهم","حيناً كما داراهم أهلوكا",55,"ك",2,0],["لم يف الدهر لي ضمانا إلى أن","كنت انت الكفيل والمكفولا",56,"ل",2,0],["لم يفتحوا للرمي منهم أعيُناً","حتى كُحلنَ بكل لدنٍ أسمر",57,"ر",1,0],["لم يفت من ذا الورى أحدُ","قصده جدواه مقصودُ",58,"د",1,0],["لم يفتقر لوجود وهو أوجده","كما أراد على مقدار ما احتكما",59,"م",2,0],["لم يفكروا أو يذكروا بل يشكروا","احسان ذاك الفاضل المتفضلِ",60,"ل",1,0],["لم يفِ قط مذ نشأ حق أمٍّ","قاست الهول فيه منذ الفطامِ",61,"م",1,0],["لم يفُحْ لي مِنْهُ إِلاّ","مِقةٌ مِنْهُ ومُوقُ",62,"ق",1,0],["لم يفت يا قيوم علمك فقري","وانكساري وكيف سوء محلي",63,"ل",2,0],["لم يفْجؤوك بَينّهم ولقد جرى","لك عند زجر الحاجلات الشّحجِ",64,"ج",1,0],["لم يَفُت مصرَ فيه من خطوات","واسعات برأيه المعصومِ",65,"م",1,0],["لم يفتلتك نقيرا عن مخادعة","دهيُ الرجال وللسؤّال تنخدع",66,"ع",1,0],["لم يفهموا معنى الفضيلة والندى","فكأنهم خلقوا بغير فؤاد",67,"د",1,0],["لم يَفِرُ الصهباءَ ريقُك عن شجٍ","صدٍ ولما هذا التباخلُ باللمى",68,"م",2,0],["لم يفهموا عبر الزما","ن وما طوين من الفصول",69,"ل",1,0],["لم يفته في داره عيش عز","فهو يسعى لها نجاء المضيم",70,"م",1,0],["لم يفز ناظري بلقياه حتى","في رقادي وأين مني رقادي",71,"د",2,0],["لم يفته من المكارم إلا","لفظ حرف لم تحوينه الهجاء",72,"ا",2,0],["لم يفارق خيالُ طيفكِ عيني","مذ غدا القلب وهو عَينُ مُقَامك",73,"ك",1,0],["لم يفتني سوى القليل وأني","لاحتواشي جميعهم في اجتهاد",74,"د",1,0],["لم يُفتَقَد منهم سِوى هُدهُدٍ","ومثلُهُ في مثلِها يُفقَدُ",75,"د",1,0],["لم يفرط في ما رآه كفيلاً","أن يكون انتصارهُ مضمونا",76,"ن",2,0],["لم يفتقر في الورى إليهم","لأنه لم يقم جماله",77,"ل",2,0],["لَم يَفجَأِ المُشتَاقَ إلا وَهي دا","خِلةُ السُّتُورِ بِغَيرِ مَا استئِذَانِ",78,"ن",1,0],["لَم يَفهَمِ الثَّقَلاَنِ مِن لَفظٍ كَمَا","فَهِمُوا مِنَ الاخبَارِ وَالقُرآنِ",78,"ن",1,0],["لم يفهم الجهال هذا كله","فأتوا بتأويلات ذي البطلان",78,"ن",1,0],["لم يفتنا الوجد والنوح عليك","أبد الدهر وجذب الحسرات",79,"ت",1,0],["لم يفتها من الكمال سوى يا","قوت لو أنها به تتحلى",80,"ل",2,0],["لم يفهم الناسُ سناك الذي","أطلَّ وهو الصبحُ زاهٍ وسيم",81,"م",1,0],["لَم يَفدنا لَطمنا راحاً بِراح","لا وَلا ينفعنا طُول النِياح",82,"ح",1,0],["لَم يَفده الهيام في كُل واد","إِن يَكُن عَنهُ رزقه مَحبوسا",83,"س",2,0],["لم يفرق ما بين دنيا ودين","في صلاح النفوس والاجساد",84,"د",1,0],["لَم يَفتَقِدهُ أَحَدٌ","غَير بَناتِ البَلَدِ",85,"د",1,0],["لم يفقهوا سر المصيب","ة وهي افتك من حسام",86,"م",1,0],["لم يفتقر موصوله إلى صله","وهو الذي يمنع أن نواصله",87,"ه",1,0],["لمى فيه فيه كم نفوس تنافست","وقد قل أن تلقى سوى متنافس",88,"س",1,0],["لم يفكر بالعقل الا قوي ال","نفس لكن يعيش كالمسكين",89,"ن",1,0],["لم يفدني دعاء رب سميع","أو نداء الطبيعة الصماء",90,"ا",2,0],["لَم يفضل لصحب في فعل وَلا عَمل","وَإنما بِالَّذي في قَلبه وَقرا",91,"ر",2,0],["لم يُفلح البارح مع عرسه","قُلتُ لهم لا يُفلح السّاحر",92,"ر",1,0],["لم يفضحوك ولم يبيحوا حالك ال","مذموم بل أبدوا جميل ثناكا",93,"ك",2,0],["لم يفتتن قطُ بتلكُ المحنَة","والوِلد للأبِ العطوف فتنَه",94,"ه",1,0],["لم يَفُر فيها سِوَى القلب الجسور","ذلكَ القلب الّذي نَالَ المُرَاد",95,"د",1,0],["لم يفعل الخمر في عقل كما فعلت","ورقاء قامت تغنيني على الشجر",96,"ر",1,0],["لم يفتخرْ بزهرة الإماره","بل رامَ بالرعية افتخاره",97,"ه",1,0],["لم يفتن من لا رأى حسنه","ولا سبي يا قوم من لا سباه",98,"ا",2,0],["لم يفتدِ الأَملاكَ بل من جودهِ","افدى الأَنامَ بفِديةٍ تُستعظَمُ",99,"م",1,0],["لَم يَفِد وَفدَهُ الزَمانَ عَلى الأَل","سُنِ مِنهُ عَطفٌ وَلا تَنويلُ",100,"ل",1,0],["لم يفكر بالامر بل سل حالا","خنجرا باليمين ماضي الشفار",101,"ر",1,0],["لم يفعلوا بالشط إذ حضروا","ما تفعل الغيرانةُ الأنفُ",102,"ف",1,0],["لَم يُفِدهُ أن كانَ شَيخاً خَبِيراً","مِن رُؤَى الخَ