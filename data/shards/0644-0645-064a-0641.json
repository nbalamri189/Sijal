{"poems":[[55,"اصرف فؤادك يا عباس ملتفتا","https://www.aldiwan.net/poem26417.html","البسيط"],[57,"لم يفتأ الناس حتى أحدثوا بدعا","https://www.aldiwan.net/poem24650.html","البسيط"],[93,"لم يفقدوا أما وقد فقدوك","https://www.aldiwan.net/poem9851.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"يا أيها الشرق التعيس انظر إلى","https://www.aldiwan.net/poem62698.html","عموديه"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[49,"المرء يشقى بكل أمر","https://www.aldiwan.net/poem62066.html","مجزوء البسيط"],[69,"مات سليمان الطبيب الذي","https://www.aldiwan.net/poem28078.html","السريع"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[52,"غفرت ذنب النوى إذ كنت باخله","https://www.aldiwan.net/poem26824.html","البسيط"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[46,"المرء حتى يغيب الشبح","https://www.aldiwan.net/poem22287.html","المنسرح"],[46,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85336","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1931","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[67,"حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمارهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14533",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[91,"الى الشبان المتفرّجين","https://www.poetsgate.com/ViewPoem.aspx?id=53238",""],[91,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[110,"بت من فكري في حال السقيم","https://www.aldiwan.net/poem16595.html","الرمل"],[129,"قيل لي أنت في مديحك تغلو","https://www.aldiwan.net/poem50545.html","الخفيف"],[143,"قالوا ذر الشعر وكن عائدا","https://www.aldiwan.net/poem58384.html","السريع"],[144,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[186,"ووردة يقصر عنها الوصف","https://www.aldiwan.net/poem14753.html","الرجز"],[222,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[223,"رق لما هواك عقلي فما يقدر","https://www.aldiwan.net/poem55469.html","الخفيف"],[299,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[304,"لا تسألني فروحي","https://www.aldiwan.net/poem57577.html","المجتث"],[329,"لهف نفسي والمنايا تلتظى","https://www.aldiwan.net/poem55052.html","الرمل"],[343,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[350,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[404,"أنا لا أشكو جنايات النوى","https://www.aldiwan.net/poem34170.html","الرمل"],[417,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[454,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[454,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[459,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[465,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[516,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[516,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[528,"ختمت بك العجم الملوك وراجعت","https://www.aldiwan.net/poem45977.html","الكامل"],[552,"قال لجاف كلما سيم","https://www.aldiwan.net/poem47177.html","مجزوء الرمل"],[552,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[552,"إن كنت ترغب في الثواء","https://www.aldiwan.net/poem47757.html","مجزوء الكامل"],[559,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"]],"verses":[["لَم يُفقَدَ الوُدُّ مِن قَلبي لِمَفقَدِها","لَكِنَّ قَلبي غَداةَ البَينِ قَد فُقِدا",0,"د",2,0],["لَم يَفتَأِ الناسُ حَتّى أَحدَثوا بِدَعاً","في الدينِ بِالرَأيِ لَم يُبعَث بِها الرُسُلُ",1,"ل",1,1],["لم يفقدوا أما وقد فقدوك","فقدوا أباً وأخاً وخير شريك",2,"ك",1,1],["لَم يَفوتونا بِشَيءٍ ساعَةً","غَيرَ أَن وَلَّوا بِجُهدٍ وَفَشَل",3,"ل",1,0],["لَم يَفهَموا ما الشِعرُ إِلّا أَنَّهُ","قَد باتَ واسِطَةً إِلى الإِثراءِ",4,"ا",2,0],["لَم يَفهَموا مَعنى الحَياةِ وَكَنهَها","إِنَّ البَلِيَّةَ أَنَّهُم لَم يَفهَمو",5,"م",2,0],["لَم يَفُه بِالنَوابِغِ الغُرِّ حَتّى","سَبَقَ الخَلقَ نَحوَهُ البُلَغاءُ",6,"ا",2,0],["لَم يَفقِدِ المَرءُ نَفعَ شَيءٍ","سَدَّ لَهُ غَيرُهُ مَسَدَّه",7,"د",2,0],["لم يَفْدِهِ طبٌّ ولمْ يُغنِهِ","علمٌ ولمْ ينفعْهُ حسنُ العلاجْ",8,"ج",1,0],["لَم يَفسُقِ القَومُ غالَتهُم خَبائِثُهُم","في الذاهِبينَ مِنَ الأَقوامِ ما فَسَقوا",9,"ق",3,0],["لَم يَفُتنا بِالوِترِ قَومٌ وَلِلضَي","مِ رِجالٌ يَرضَونَ بِالإِغماضِ",10,"ض",1,0],["لَم يَفعَلُ البَينُ إِلّا ما فَعَلتَ وَما","بَينَ الأَخِلّاءِ إِلّا المَطلُ وَالخُلُفُ",11,"ف",1,0],["لَمْ يُفَضِّلْ عليكَ غيرَكَ لكن","نَ عطاياهُ كَالكُؤوسِ المُدَارَهْ",12,"ر",2,0],["لَم يَفطُنوا لِلجَميلِ بَل جُبِلوا","عَلى قَبيحٍ فَما لَهُم قُبِحوا",13,"ح",3,0],["لَم يَفدِ سابورَ وَلا تُبَّعاً","ما وَجَدا مِن ذَهَبٍ يَملِكان",14,"ن",1,0],["لَم يفكر فيما يصير إليه","قبل أَن يدفن الخَليل الخَليل",15,"ل",1,0],["لَمْ يُفَرِّقُ بَيْنَ النَّبَاتِ وَهَلْ فَرَّقَتِ","الشَّمْسُ حِينَ تَبْعَثُ نُورَا",16,"ر",2,0],["لَم يَفعَلوا فِعلَ آلِ حَنظَلَةٍ","إِنَّهُم جيرِ بِئسَ ما اِئتَمَروا",17,"ر",3,0],["لَمْ يَفُزْ مِنْكَ مَرَُّّةً بِثنَاءٍ","فَنَثَرْتَ الأزْهَارَ فَوْقَ تُرَابِهْ",18,"ب",2,0],["لم يفتَتِنْ بالمكرماتِ امرُؤٌ","والغانياتُ فتنةُ العابد",19,"د",1,0],["لم يفصل التاريخُ يومًا بيننا","لكنه عَقَدَ الصِّلاتِ ووثَّقَا",20,"ق",2,0],["لم يفهم المحتلُّ من خُطَبائنا","فلتُفْهموا المحتلَّ ما لم يَفْهَم",21,"م",1,0],["لم يُفضِّل عليك غيركَ لك","عطاياهُ كَالكُؤُوسِ المُدارَه",22,"ر",2,0],["لم يفتها ترف الظل ولا","نال من أوراكها السير الوجيف",23,"ف",1,0],["لم يفهموا معنى الحياة وكنهها","إنّ البليّة أنّهم لم يفهموا",24,"م",3,0],["لم يفهموا ما للشعرº إلا انه","قد بات واسطة إلى الاثراء",25,"ا",2,0],["لَم يَفد سُهدي دَواء وَصفهُ","يَجلب النَوم إِلى جفن النُجوم",26,"م",1,0],["لم يَفُهْ مثلَها فمٌ بقوافٍ","زانَها من لدبك قولٌ وفعْلٌ",27,"ل",1,0],["لم يفقهوا اللفظ ولم يفهموا ال","معنَى ولا يَدرون ميزانَهُ",28,"ن",2,0],["لَم يُفِد رَأيُ مَن يُصانِعُ بِالشَي","ءِ رَجاءً أَن يَمنَعَ الأَشياءَ",29,"ا",2,0],["لم يُفسد التحريرَ منها اللفُّ","ترسُب في جُلاَّبها وتطفو",30,"ف",2,0],["لم يفارقه في الإقامة والظعن","برغم الكثير من أخطار",31,"ر",1,0],["لم يفز من لقاه قلبي بسهم","وله من لحاظه سهمان",32,"ن",1,0],["لم يفقه الدينَ مَنْ لاثوا عمائَمُهمْ","ولا الأُولى حملتْ أَيديهمُ السبحا",33,"ح",2,0],["لم يفت في البر عبدٌ","ومالكٌ في المدينه",34,"ه",1,0],["لم يفرق بين شيخ هرم","ورضيع في حمى المهد وليد",35,"د",1,0],["لم يفلها الصدا","بل قراع القوارع",36,"ع",1,0],["لَم يَفزِقوا بَينَ المُسَمّي وَاِسمِهِ","وَلِغَيرِ رِسمِ الاِسمِ لَم يَتَعَبَّدوا",37,"د",3,0],["لم يَفُتْنِي منه إلا منظرٌ","هو للأحباب نُورٌ لا سِوَى",38,"س",3,0],["لم يُفدْني تطلُّبي من ثِمادٍ","أبتغيه ورقَّةٍ من جَماد",39,"د",1,0],["لم يفرق ما بينه وديار","أرهقته إن باعدته الديار",40,"ر",1,0],["لم يفجع الدهر أحلامي ويرهقها","إلا وعندي له من قبل حسبان",41,"ن",1,1],["لم يفترش عجزا من الرأي ولا","ساور في الأمر الهوى الظَّنِينا",42,"ن",2,0],["لم يفترعْها خُفُّ يعمَلةٍ","أنهبتُ وجنتَها يدَ الوجنا",43,"ن",2,0],["لم يَفْنَ فَضُّ الربيع فيها","عذراءَ مختومةَ العزالي",44,"ل",2,0],["لم يفت سعيهُ محلٌ من المج","دِ ولم يبق فيضُ كفَّيه محلا",45,"ل",2,0],["لم يفتحن حمدان وابن مناهب","أعطاف عطفيها ولم تتكسر",46,"ر",1,0],["لم يفارق أهل الصعيدين إلا","ولمن فيهما عليه عويل",47,"ل",1,0],["لم يفقدوا بك أردشير وإنما","فقدوا نقيصة دينه المستسمجِ",48,"ج",1,0],["لم يُفِدنا وطريفٌ","خادعٌ يوجبُ مَنّا",49,"ن",2,0],["لم يُفْنِ دهرٌ مَن نأى وله بنا","كَلِمٌ على مرّ الزّمان بواقِ",50,"ق",1,0],["لم يَفدِهِ من صَوْلَةِ ال","أيّام أنْ جمعَ الكنوزا",51,"ز",2,0],["لم يفه يا ذا الوجه فمُ","بك لولا أنني العدمُ",52,"م",1,1]]}