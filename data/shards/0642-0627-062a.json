{"poems":[[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[51,"صورته ناعتة خبره","https://www.aldiwan.net/poem61908.html","السريع"],[51,"قينة عند خالد","https://www.aldiwan.net/poem64531.html","مجزوء الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[45,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[45,"غلس الشيب أو تعجل ورده","https://www.aldiwan.net/poem62743.html","الخفيف"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[97,"رب ليلٍ قد صفا الأفق به","https://www.aldiwan.net/poem24358.html","الرمل"],[97,"اذكري ذاك المساء","https://www.aldiwan.net/poem25072.html","مجزوء الرمل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[52,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[19,"ودع لميس وداع الصارم اللاحي","https://www.aldiwan.net/poem326.html",""],[15,"هبت تلوم وليست ساعة اللاحي","https://www.aldiwan.net/poem45277.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202552","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9961","البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/1027","الخفيف"],[117,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[120,"رفقا بنفسك أنني رجل","https://www.aldiwan.net/poem49277.html","أحذ الكامل"],[155,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[160,"من عاش حدث عن أيامه العجبا","https://www.aldiwan.net/poem58910.html","البسيط"],[169,"قالوا الدبيثي ذو قواف","https://www.aldiwan.net/poem1671.html",""],[195,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[199,"نظروا الكأس فقالوا","https://www.aldiwan.net/poem45356.html","مجزوء الرمل"],[199,"هجرتني الملاح من غير ذنب","https://www.aldiwan.net/poem45558.html","الخفيف"],[232,"قاتلي لا برئت من أوزاري","https://www.aldiwan.net/poem14793.html","الخفيف"],[280,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[317,"بئسما ربيته من ولد","https://www.aldiwan.net/poem2033.html","الرمل"],[353,"ويح قلبي كم يقاسي شجنا","https://www.aldiwan.net/poem40017.html","الرمل"],[353,"قاتلي من بشر عنا","https://www.aldiwan.net/poem40173.html","مجزوء الخفيف"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[366,"قاتل بغير سلاح الهجر إن له","https://www.aldiwan.net/poem17115.html","البسيط"],[371,"قاتل فقد وجب الجها","https://www.aldiwan.net/poem57192.html","مجزوء الكامل"],[391,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[393,"عين جودي على الشهيد القتيل","https://www.aldiwan.net/poem53467.html","الكامل"],[402,"قاتلي في هواه من غير ذنب","https://www.aldiwan.net/poem46712.html","الخفيف"],[416,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[441,"على الشهيد الشريف اللوذعي علي","https://www.aldiwan.net/poem14474.html","البسيط"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[461,"ملأ العصر بل الدهر علا","https://www.aldiwan.net/poem15397.html","الرمل"],[464,"سهر البرق من صفات المعنى","https://www.aldiwan.net/poem3428.html","عموديه"],[464,"ومدع تكذبه نفسه","https://www.aldiwan.net/poem3434.html","عموديه"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[479,"أبتي كيف غالك الموت غدرا","https://www.aldiwan.net/poem37049.html","الخفيف"],[505,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[546,"الزق ملك لمن كان له","https://www.aldiwan.net/poem1859.html","مجزوء البسيط"],[564,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قاتَلتُها حَتّى تَمَلَّ وَيَشتَكي","كُرَبَ الغُبارِ رَفيعُها وَوَضيعُها",0,"ع",3,0],["قاتَلتُ فُرسانَهُم حَتّى مَضوا فِرَق","وَالطَعنُ في إِثرِهِم أَمضى مِنَ الأَجَلِ",1,"ل",1,0],["قاتِلٌ لي بِالتَجَنّي ما لَهُ","لَيتَ شِعري أَحَلالٌ ما اِستَحَلّ",2,"ل",1,0],["قاتل المال بالنوال فما أك","ياس أمواله سوى أكفان",3,"ن",1,0],["قاتِلِي الصالحينَ إما افتراساً","ظاهراً منهُمُ وإما دَبيبا",4,"ب",2,0],["قاتَل اللَّه دهرَنا أو رماهُ","باستواءٍ فقد غدا ذا انقلابِ",5,"ب",1,0],["قاتله اللّه فَمَا","أبْعَدَهُ من رَشَدِهْ",6,"د",2,0],["قاتَله الرحمنُ من كاتب","تُخزَنُ فيه الكتبُ الواردَهْ",7,"د",2,0],["قاتل اللَه بردها","والحتوفُ المناجزه",8,"ز",2,0],["قاتلٌ بالصدّ محيي","إن بدا منهُ ابتسامُ",9,"م",1,0],["قاتلن في أجفانهن قلوبنا","فصرعنها وسلمن بالأغماد",10,"د",1,0],["قاتَلَها نَهارَهُ حَتّى بَدا","لِأَهلِها فَلاذوا بِالنَجا",11,"ا",1,0],["قاتِلُ النَفسِ لَو كانَت لَهُ","أَسخَطَ اللَهَ وَلَم يُرضِ البَشَر",12,"ر",1,0],["قاتَلتَنا بِالسِلاحِ تَملِكُهُ","مُعتَزِياً بِالعَديدِ تَنتَخِبُه",13,"ب",2,0],["قاتَلَ اللَهُ قاتِلاتِ الغَواني","بِالغَرامِ المُنبي عَنِ الغَيِّ رُشدُه",14,"د",2,0],["قاتَلَها اللَهُ كَيفَ ضَيَّعتِ ال","عَهدَ وَجاءَت بِاللَّي وَالخُلُفِ",15,"ف",1,0],["قاتِلي سِرُّ ذا الهَوى إِن تَجَنَّي","تُ عَلَيهِ أَم فاضِحي إِعلانُه",16,"ن",2,0],["قاتِل هَواكَ إِذا دَعاكَ لِفِتنَةٍ","قاتِل هَواكَ هُناكَ كُلَّ قِتالِ",17,"ل",1,0],["قاتماتٍ كذئابٍ حُوَّمٍ","جائعاتٍ مثل غربانِ الشجر",18,"ر",1,0],["قاتمات غائمات","يتهادينَ بطاء",19,"ا",2,0],["قاتِلُ الأبطالِ في أدراعها","عصفتْ أقدارُهُ بالبطليْنْ",20,"ن",1,0],["قاتَلَ الناسَ بِعَينَي","نِ وَخَدَّينِ وَجيدِ",21,"د",1,0],["قاتَلَها اللَهُ تَلحاني وَقَد عَلِمَت","أَنّي لِنَفسِيَ إِفسادي وَإِصلاحي",22,"ح",2,0],["قاتَلَها اللَهُ تَلحاني وَقَد عَلِمَت","أَنَّ لِنَفسِيَ إِفسادي وَإِصلاحي",23,"ي",1,0],["قاتلها نهاره حتى بدا","لأهلها الليل فلاذوا بالنجا",24,"ا",1,0],["قاتل حتى خانه المجالُ","وأسلمت دولتها الرجال",25,"ل",1,0],["قاتَلتُ فُرسانَهُم حَتّى مَضوا فِرَقاً","وَالطَعنُ في إِثرِهِم أَمضى مِنَ الأَجَلِ",26,"ل",1,0],["قاتِلي شادِنٌ بَديعُ الجَمالِ","أَعجَمِيُّ الهَوى فَصيحُ الدَلالِ",27,"ل",1,1],["قاتلاتي بِاللَّحظِ بِيضًا وسُمرًا","الغواني كم جَرَّعَتْني الغواني",28,"ي",1,0],["قاتل الذين إذا ثلبتهم","أضنى نفوسهم بك الشغل",29,"ل",1,0],["قَاتِلُ القَومِ كُلَّما أَظلمَ النَّقْ","عُ جَلاهُ بالأَبْيَضِ البَتَّارِ",30,"ر",1,0],["قاتلْ بربّك إِنَّ الجِيشَ قد علموا","غِناك عنهم به فأغمدوا القضَبا",31,"ب",2,0],["قاتَلَكَ اللَهُ كَم تَعامى","وَتَعكِسُ السُنَّةَ القَويمَه",32,"م",2,0],["قاتَلَ الأَرضَ بِالسَنابِكِ حَتّى","أَخَذَت مِن نُسورِهِ المَعزاءُ",33,"ا",2,0],["قاتُ بل ذاكَ فؤادي","ذابَ من نيرانِ حبّي",34,"ي",1,0],["قاتلاتُ النفوسِ حرَّمها اللهُ","وهل من أجلهنَّ تباحُ",35,"ح",1,0],["قاتِلي لا بَرِئتَ مِن أَوزاري","أَيُّ نارٍ لَولا خُدودكَ ناري",36,"ي",1,1],["قاتَلَها اللهُ فَلا بُنُوجُها","تَرْفَعُ بِي رَأْساً وَلا شُشُوشها",37,"ش",3,0],["قاتَلَهُ اللَه ولا","تَقولُ ذاكَ عن قِلى",38,"ل",2,0],["قاتلَ اللهُ غراباً","كم له بالبين نعب",39,"ب",1,0],["قاتَل الأَعمام والخال لهُ","جاهلٌ في الدهرِ في هتكِ النّفَر",40,"ر",1,0],["قاتِلي ذو مُقلة زَرقاء لَم","أَرَها إِلّا وَقَلبي يَخفقُ",41,"ق",1,0],["قاتلي من بشر عنا","ما لِذَنبٍ لَهُ جزا",42,"ز",2,1],["قاتلَ اللهُ أراكاً بالحِمَى","أبداً يُملي على القلْبِ الغراما",43,"م",2,0],["قاتِل بِغَيرِ سِلاحِ الهَجرِ إِنَّ لَهُ","ضَرباً تَسيلُ دُموعي مِنهُ وَهيَ دَمُ",44,"م",1,1],["قاتِل فقَد وَجَبَ الجِها","دُ علَى جفُونكَ يا مُقاتِل",45,"ل",1,1],["قاتل الله من يشيد بناه","أهلك الله كل من يرتديه",46,"ي",2,0],["قاتَلوا اللَهَ وَالنَبِيَّ وَمولا","هُم عَلِيّا اِذ قاتَلوا اِبنَ الرَسولِ",47,"ل",1,0],["قاتلي في هواهُ من غير ذنبٍ","قُلْ لعينيكَ أيّ ذنبٍ لِقَلبي",48,"ي",1,1],["قاتلي من غير ذنبٍ في الهوى","أَنْتَ في قَتْلي رعاك الله آثم",49,"م",1,0],["قاتلت في اللَه من عاداه متكلا","عليه فاسعد بجد منه متكل",50,"ل",1,0],["قاتل المَحْل إذا عزَّ الحَيا","بصدوق الشيم مستن التَّوالي",51,"ل",2,0],["قاتلُ الأقْرانِ في معْركَةٍ","وبيوم السلم قتَّالُ العَدمْ",52,"م",1,0],["قاتل المقلتين والقدِّ في العشَّاق","كم من غارة من الحسن شنَّا",53,"ن",2,0],["قاتله الله أديباً فما","أخفَّه رأساً وما أثقله",54,"ل",2,0],["قاتلٌ قوسُ حاجبيهِ إذا","فوَّقَ سهمَ الجفون من غير نزع",55,"ع",1,0],["قاتل اللّه كل يوم عدى يو","طاب منها الضمير سرا وجهرا",56,"ر",2,0],["قاتلوا فيكَ المُصطَفىْ والمَسيحَ","ما نجَا من أهلِيكَ حتّى الكليمُ",57,"م",1,0],["قاتَلَكِ اللّه من مشروبةٍ","لو أنّ ذا مرَّةٍ عنكِ صَبُورْ",58,"ر",1,0],["قاتل الله من يود شقاقا","بين أبناء جنسه لدنية",59,"ي",2,0],["قاتله الله لقد كافاه","بفعله فيه وقد جازاه",60,"ه",1,0],["قاتلهم حتى إذا أجابوا","للحكم رأى أنهم أنابوا",60,"ب",3,0]]}