[5324,"رسالة إلى حبيبي .","https://www.poetsgate.com/ViewPoem.aspx?id=207630",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5409,"قاتل الله من أمية حزباً","https://www.poetsgate.com/ViewPoem.aspx?id=155490",""],[5431,"طاغوت....","https://www.poetsgate.com/ViewPoem.aspx?id=202911",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5609,"سامحي قسوتي","https://www.poetsgate.com/ViewPoem.aspx?id=215576",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5912,"قاتل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=203621",""],[6013,"هكذا في حبكم أستوجب؟","https://www.poetsgate.com/ViewPoem.aspx?id=181606",""],[6302,"رَجَاحَهْ ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86239&r=&rc=37",""]],"verses":[["قاتَلتُها حَتّى تَمَلَّ وَيَشتَكي","كُرَبَ الغُبارِ رَفيعُها وَوَضيعُها",0,"ع",3,0],["قاتَلتُ فُرسانَهُم حَتّى مَضوا فِرَق","وَالطَعنُ في إِثرِهِم أَمضى مِنَ الأَجَلِ",1,"ل",1,0],["قاتِلٌ لي بِالتَجَنّي ما لَهُ","لَيتَ شِعري أَحَلالٌ ما اِستَحَلّ",2,"ل",1,0],["قاتل المال بالنوال فما أك","ياس أمواله سوى أكفان",3,"ن",1,0],["قاتِلِي الصالحينَ إما افتراساً","ظاهراً منهُمُ وإما دَبيبا",4,"ب",2,0],["قاتَل اللَّه دهرَنا أو رماهُ","باستواءٍ فقد غدا ذا انقلابِ",5,"ب",1,0],["قاتله اللّه فَمَا","أبْعَدَهُ من رَشَدِهْ",6,"د",2,0],["قاتَله الرحمنُ من كاتب","تُخزَنُ فيه الكتبُ الواردَهْ",7,"د",2,0],["قاتل اللَه بردها","والحتوفُ المناجزه",8,"ز",2,0],["قاتلٌ بالصدّ محيي","إن بدا منهُ ابتسامُ",9,"م",1,0],["قاتلن في أجفانهن قلوبنا","فصرعنها وسلمن بالأغماد",10,"د",1,0],["قاتَلَها نَهارَهُ حَتّى بَدا","لِأَهلِها فَلاذوا بِالنَجا",11,"ا",1,0],["قاتِلُ النَفسِ لَو كانَت لَهُ","أَسخَطَ اللَهَ وَلَم يُرضِ البَشَر",12,"ر",1,0],["قاتَلتَنا بِالسِلاحِ تَملِكُهُ","مُعتَزِياً بِالعَديدِ تَنتَخِبُه",13,"ب",2,0],["قاتَلَ اللَهُ قاتِلاتِ الغَواني","بِالغَرامِ المُنبي عَنِ الغَيِّ رُشدُه",14,"د",2,0],["قاتَلَها اللَهُ كَيفَ ضَيَّعتِ ال","عَهدَ وَجاءَت بِاللَّي وَالخُلُفِ",15,"ف",1,0],["قاتِلي سِرُّ ذا الهَوى إِن تَجَنَّي","تُ عَلَيهِ أَم فاضِحي إِعلانُه",16,"ن",2,0],["قاتِل هَواكَ إِذا دَعاكَ لِفِتنَةٍ","قاتِل هَواكَ هُناكَ كُلَّ قِتالِ",17,"ل",1,0],["قاتماتٍ كذئابٍ حُوَّمٍ","جائعاتٍ مثل غربانِ الشجر",18,"ر",1,0],["قاتمات غائمات","يتهادينَ بطاء",19,"ا",2,0],["قاتِلُ الأبطالِ في أدراعها","عصفتْ أقدارُهُ بالبطليْنْ",20,"ن",1,0],["قاتَلَ الناسَ بِعَينَي","نِ وَخَدَّينِ وَجيدِ",21,"د",1,0],["قاتَلَها اللَهُ تَلحاني وَقَد عَلِمَت","أَنّي لِنَفسِيَ إِفسادي وَإِصلاحي",22,"ح",2,0],["قاتَلَها اللَهُ تَلحاني وَقَد عَلِمَت","أَنَّ لِنَفسِيَ إِفسادي وَإِصلاحي",23,"ح",2,0],["قاتلها نهاره حتى بدا","لأهلها الليل فلاذوا بالنجا",24,"ا",1,0],["قاتل حتى خانه المجالُ","وأسلمت دولتها الرجال",25,"ل",1,0],["قاتَلتُ فُرسانَهُم حَتّى مَضوا فِرَقاً","وَالطَعنُ في إِثرِهِم أَمضى مِنَ الأَجَلِ",26,"ل",1,0],["قاتِلي شادِنٌ بَديعُ الجَمالِ","أَعجَمِيُّ الهَوى فَصيحُ الدَلالِ",27,"ل",1,1],["قاتلاتي بِاللَّحظِ بِيضًا وسُمرًا","الغواني كم جَرَّعَتْني الغواني",28,"ن",2,0],["قاتل الذين إذا ثلبتهم","أضنى نفوسهم بك الشغل",29,"ل",1,0],["قَاتِلُ القَومِ كُلَّما أَظلمَ النَّقْ","عُ جَلاهُ بالأَبْيَضِ البَتَّارِ",30,"ر",1,0],["قاتلْ بربّك إِنَّ الجِيشَ قد علموا","غِناك عنهم به فأغمدوا القضَبا",31,"ب",2,0],["قاتَلَكَ اللَهُ كَم تَعامى","وَتَعكِسُ السُنَّةَ القَويمَه",32,"م",2,0],["قاتَلَ الأَرضَ بِالسَنابِكِ حَتّى","أَخَذَت مِن نُسورِهِ المَعزاءُ",33,"ا",2,0],["قاتُ بل ذاكَ فؤادي","ذابَ من نيرانِ حبّي",34,"ب",2,0],["قاتلاتُ النفوسِ حرَّمها اللهُ","وهل من أجلهنَّ تباحُ",35,"ح",1,0],["قاتِلي لا بَرِئتَ مِن أَوزاري","أَيُّ نارٍ لَولا خُدودكَ ناري",36,"ر",2,1],["قاتَلَها اللهُ فَلا بُنُوجُها","تَرْفَعُ بِي رَأْساً وَلا شُشُوشها",37,"ش",3,0],["قاتَلَهُ اللَه ولا","تَقولُ ذاكَ عن قِلى",38,"ل",2,0],["قاتلَ اللهُ غراباً","كم له بالبين نعب",39,"ب",1,0],["قاتَل الأَعمام والخال لهُ","جاهلٌ في الدهرِ في هتكِ النّفَر",40,"ر",1,0],["قاتِلي ذو مُقلة زَرقاء لَم","أَرَها إِلّا وَقَلبي يَخفقُ",41,"ق",1,0],["قاتلي من بشر عنا","ما لِذَنبٍ لَهُ جزا",42,"ز",2,1],["قاتلَ اللهُ أراكاً بالحِمَى","أبداً يُملي على القلْبِ الغراما",43,"م",2,0],["قاتِل بِغَيرِ سِلاحِ الهَجرِ إِنَّ لَهُ","ضَرباً تَسيلُ دُموعي مِنهُ وَهيَ دَمُ",44,"م",1,1],["قاتِل فقَد وَجَبَ الجِها","دُ علَى جفُونكَ يا مُقاتِل",45,"ل",1,1],["قاتل الله من يشيد بناه","أهلك الله كل من يرتديه",46,"ي",2,0],["قاتَلوا اللَهَ وَالنَبِيَّ وَمولا","هُم عَلِيّا اِذ قاتَلوا اِبنَ الرَسولِ",47,"ل",1,0],["قاتلي في هواهُ من غير ذنبٍ","قُلْ لعينيكَ أيّ ذنبٍ لِقَلبي",48,"ب",2,1],["قاتلي من غير ذنبٍ في الهوى","أَنْتَ في قَتْلي رعاك الله آثم",49,"م",1,0],["قاتلت في اللَه من عاداه متكلا","عليه فاسعد بجد منه متكل",50,"ل",1,0],["قاتل المَحْل إذا عزَّ الحَيا","بصدوق الشيم مستن التَّوالي",51,"ل",2,0],["قاتلُ الأقْرانِ في معْركَةٍ","وبيوم السلم قتَّالُ العَدمْ",52,"م",1,0],["قاتل المقلتين والقدِّ في العشَّاق","كم من غارة من الحسن شنَّا",53,"ن",2,0],["قاتله الله أديباً فما","أخفَّه رأساً وما أثقله",54,"ل",2,0],["قاتلٌ قوسُ حاجبيهِ إذا","فوَّقَ سهمَ الجفون من غير نزع",55,"ع",1,0],["قاتل اللّه كل يوم عدى يو","طاب منها الضمير سرا وجهرا",56,"ر",2,0],["قاتلوا فيكَ المُصطَفىْ والمَسيحَ","ما نجَا من أهلِيكَ حتّى الكليمُ",57,"م",1,0],["قاتَلَكِ اللّه من مشروبةٍ","لو أنّ ذا مرَّةٍ عنكِ صَبُورْ",58,"ر",1,0],["قاتل الله من يود شقاقا","بين أبناء جنسه لدنية",59,"ي",2,0],["قاتله الله لقد كافاه","بفعله فيه وقد جازاه",60,"ه",1,0],["قاتلهم حتى إذا أجابوا","للحكم رأى أنهم أنابوا",60,"ب",3,0],["قاتِل بِرَبّك وحدَه إن قاتَلُوا","بسُواعَ أو يغُوثَ أو بِيَعُوقا",61,"ق",2,0],["قاتِلْ عِداكَ وضارِبْهُمْ بِمَكْرُمَةٍ","تَسمُو لَها لا بِبِيْضِ الهِنْدِ والأسَلِ",62,"ل",1,1],["قاتلَ اللهُ كُلَّ ظَبْيٍ خَلِيٍّ","يَتَصدَّى لِقَتْلِ صَبٍّ حَزينِ",63,"ن",1,0],["قاتل المخلوع مقتول","ودم القاتل مطلول",64,"ل",1,0],["قاتلي عش وكلْ هنيئاً مريئاً","إنني عفتُ مَشْربي ولمَاظِى",65,"ظ",2,0],["قاتلتمو إيرانَهُمْ","حيثُ القنا الأضالِعُ",66,"ع",1,0],["قاتلاتٍ ولا جناح عليها","ليسَ غير الجمال عذرُ العذارى",67,"ر",2,0],["قاتَلَها اللَهُ لَقَد","سامَتكُما اِحدى العَضَل",68,"ل",1,0],["قاتلي في أسمرٍ من قدّهِ","كم به لي من شهودٍ صدقتْ",69,"ت",1,0],["قاتل الله مثلهم من يسطو","مفترياً على البيوت القاديمهْ",70,"م",2,0],["قاتَلْتَ عَسْكرَهُ قِتالَكَ واحداً","ولقيتَهُ فَرْداً فظَنَّكَ عَسْكَرا",71,"ر",2,0],["قاتل الله زمانا قاسياً","صيرّ البلبل فينا حجرا",72,"ر",2,0],["قاتَلَ اللَهُ عَريبا","فَعَلَت فِعلاً عَجيباً",73,"ب",2,1],["قاتل الله فؤاداً كلَّما","خفَقَ البرقُ عليه خَفَقا",74,"ق",2,0],["قاتل الله العذول ومن","بفراقِ العاشقين سعى",75,"ع",2,0],["قَاتلَ الله النَّوى من آفة","تسلبُ الوصل وتُضنى العاشقين",76,"ن",1,0],["قاتلاتٌ كواسرٌ ناعساتٌ","أحرمت عين كلّ صبٍّ كراها",77,"ا",3,0],["قاتلى منهم وياليته لو","أجمل الفتك بالحشا أو أقاله",78,"ل",2,0],["قاتَ الوُحوشَ فَأَصبَحَت مَحسوبَةً","فيمَن يُقاتُ لَدَيهِ مِن ضيفانِهِ",79,"ه",1,0],["قاتل الأموال ما أكياسها","ساعة الجدوى سوى أكفانها",80,"ه",2,0],["قاتل الله بأعلى رَامةٍ","رامياً في كبدي منهم نُدُوب",81,"ب",1,0],["قاتِلاتٌ نُفوسَنا مُحيِياتٌ","ضاحِكاتٌ مِن يَأسِنا وَالأَماني",82,"ن",2,0],["قاتل الله أمة رضيت بال","جهل فيها وحببته العبادا",83,"د",2,0],["قاتل اللَه عاذلي فيك حتى","لم تطع ما به سعى وتفوه",84,"و",2,0],["قاتِلُكُم غازي بِغَير شُبهَة","مَقتولكم مُستَشهَد في الجَنَّة",85,"ه",1,0],["قاتل الله قيس عيلان طراً","ما لهم دون غارة من حجاب",86,"ب",1,0],["قاتلتهم بصوارم كانُوا بها","قد قاتلوك وأضمرُوا العداوة",87,"ه",1,0],["قاتِل فداءٌ لكَ أمّي وأبي","دون الكرامِ الطيبينَ النُجُبِ",88,"ب",1,0],["قاتلُها بسيفهِ أحياها","ومِن جوارِ ربّها أدناها",89,"ه",2,0],["قاتَلَهم قتالَ ليثٍ باسلِ","ولم يرعهُ كلّ خطبِ هائل",90,"ل",1,0],["قاتَلهم بها إلا أن قُتِلا","وفازَ بالرُضوانِ من ربّ العُلا",90,"ل",2,0],["قاتَلَكِ اللَهُ مِن مَشروبَةٍ","لَو أَنَّ مِرَّةٍ ذا عَنكِ صَبور",91,"ر",1,0],["قاتلَ اللهُ قربها ما أَلذَّ ال","لَثْمَ منها وضَمَّةَ التقبيلِ",92,"ل",1,0],["قاتل المشركين من بمواضيه","غدا معطس الطغام جديعا",93,"ع",2,0],["قَاتَلَتهُم جُنُودُ رَبٍّ بِأرضٍ","وَسَمَاءٍ وَغَرَّتِ الجِبرِيَاءُ",94,"ا",2,0],["قاتِمُ الجَوِّ أَغدَفَ كَنَفَتهُ","بِلَجاجٍ مِنَ الظَلامِ شُعوبُ",95,"ب",1,0],["قاتلُ النفسِ دونهُ قاتل الجسمِ","فليس النفوسُ كالأجسامِ",96,"م",1,0],["قاتلي والذي أحلك قتلي","أنا راض بقتلتي وحياتك",97,"ك",1,0],["قاتلُ الأجفانِ فاتُرها","بابليٌّ ثغرهُ الشَّنبُ",98,"ب",1,0],["قاتلةٌ كُلُّ نَغْمةٍ لمَعَتْ","في مهْجتي في دمي وفي حدقي",99,"ق",2,0],["قاتِلٌ كُلُّ صَامِتٍ عَن دِماءٍ","ما لَهَا دُونَ صَوتِهِ تَرجَمَاتُ",100,"ت",1,0],["قاتِلُوكَ هُنا وهُنا","كَم نَزَفتَ وكَم قَرَأُوا",101,"ا",1,0],["قاتل الله شادنا أمست الأض","داد فيه الحسين وهي شكول",102,"ل",1,0],["قاتلَ المرتدِّين حتى أفاؤوا","للهدى بعد نكسةٍ وانكسارِ",103,"ر",1,0],["قاتناتٌ تسير بالعز والأج","لال حتى تخالها ملكات",104,"ت",1,0],["قَاتَلَتْنِيْ بِجُيُوشٍ","مِنْ لَظَاهَا أضْرَمَتْهَا",105,"ت",3,0],["قاتل لأجليَ كلّ عرفٍ ظالمٍ...","فلطالما الأعرافُ سادت سيدا",106,"د",2,0],["قاتلوكَ الصِّغارُ نَعْرِفُهُمْ","والكبارَ الذينَ ما عَرَفوا",107,"ف",3,0],["قاتلوا واستشهدوا في معرك","رشفوا كأس الردى فيه شهادا",108,"د",2,0],["قاتل الله من أمية حزباً","نفث السم فيهم الآباء",109,"ا",2,1],["قاتل الحلم إنني أتشظى","كلّ مابي ملغمٌ عفريتُ!!",110,"ت",1,0],["قاتل الله بريقاً بالحمى","أنفذ الأدمع واستبقى الغماما",111,"م",2,0],["قاتل الله من أمية فردا","كمنت في ضميره الشحناء",112,"ا",2,0],["قَاتَلَ اللهُ عِشْقَكُمْ كَمْ لَحَاني","أَيَظُنُّ النَّوَالَ لَيْسَ هَوَاكَ",113,"ك",1,0],["قاتَلا بعْضَهُما بعْضاً فإذْ","واحِدٌ يُرْدي أخاهُ خَصِمَهْ",114,"م",2,0],["قاتل الورد .. كما الروحُ قتلْ","والعنا بالقلب يذكيه الكللْ",115,"ل",1,1],["قاتل الله عذولي مادرى","أن في الأعين أسداً تثب",116,"ب",1,0],["قاتمٌ ميلادُهُ..ذاوٍ أصيلاً","باهتُ اللفْتاتِ إذْ يطوي جَنَاحَهْ",117,"ح",2,0]]}