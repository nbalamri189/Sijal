{"poems":[[90,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[74,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[94,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[47,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[30,"أتنسى بنو سعد جدود التي بها","https://www.aldiwan.net/poem5491.html","الطويل"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[1,"إن امرأ سرف الفؤاد يرى","https://www.aldiwan.net/poem34015.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[234,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[353,"وأصيد ظل يدرك يوم صيد","https://www.aldiwan.net/poem20644.html","الوافر"],[382,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[463,"من بسلع مطلع لي","https://www.aldiwan.net/poem56295.html","مجزوء الرمل"],[563,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53906","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55930","الكامل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101107","السريع"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118154","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95595","الخفيف"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105430","الطويل"],[1973,"","https://poetry.dctabudhabi.ae/diwan/poem/145503","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100405","المديد"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204875","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95361","الكامل"],[4008,"","https://poetry.dctabudhabi.ae/diwan/poem/141909","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105126","الطويل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123853","الكامل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101932","الرجز"],[4650,"","https://poetry.dctabudhabi.ae/diwan/poem/76555","الخفيف"],[4684,"حمحمة الخاء","https://www.poetsgate.com/ViewPoem.aspx?id=201572",""],[4737,"باب النجار مخلع","https://www.poetsgate.com/ViewPoem.aspx?id=212576",""],[4760,"دموع السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=35822",""],[2177,"سعد الفائزون بالنصر يوما","https://www.poetsgate.com/ViewPoem.aspx?id=127093",""],[5111,"فِي لُجِّ الْغِيَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=212357",""],[5431,"موفق...","https://www.poetsgate.com/ViewPoem.aspx?id=195198",""],[5431,"وكل قصيدة عتق...","https://www.poetsgate.com/ViewPoem.aspx?id=208652",""],[5444,"أحلى الأمكنة","https://www.poetsgate.com/ViewPoem.aspx?id=205447",""],[5461,"لوعة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=1322",""],[5525,"مني السلام","https://www.poetsgate.com/ViewPoem.aspx?id=7260",""],[5818,"ماتت","https://www.poetsgate.com/ViewPoem.aspx?id=180632",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5956,"متغزِّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182090",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[6125,"يَغْفو على راحِ القَصِيدِ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=212868",""]],"verses":[["وأصيد مأثور المكارم في الورى","يريك إذا يلقاك وجه فتى حر",0,"ر",1,0],["وَأَصيَدَ نَهّاضاً إِلى السَيفِ صارِماً","إِذا ما دَعا داعٍ إِلى المَوتِ أَرقَلا",1,"ل",2,0],["وأصيد من نسل الملوك إذا انْتدى","رأيت معمًّا في السيادة مخولا",2,"ل",2,0],["وأُصيخُ للصَّمتِ المفكِّرِ هاتفاً","في مِسمعي بغرائبِ الأَنغامِ",3,"م",1,0],["وأُصيخُ للصَّوتِ الإِلهيِّ الَّذي","يُحْيي بقلبي مَيِّتَ الأَصْداءِ",4,"ا",2,0],["وَأَصيَدُ الخَدِّ عَن إِكثارِ عاذِلِهِ","إِنَّ النَدى مِن عَتادِ السادَةِ الصيدِ",5,"د",1,0],["وَأَصيَدَ إِن نازَعتُهُ اللَحظَ رَدَّهُ","كَليلاً وَإِن راجَعتُهُ القَولَ جَمجَما",6,"م",2,0],["وَأَصيَدَ ذي تاجٍ صَدَعنا جَبينَهُ","بِأَسيافِنا وَالنَقعُ لَم يَتَزَيَّلِ",7,"ل",1,0],["وَأُصيبَت لِفَقدِهِ فَلِهَذا","أُلبِسَت بَعدَهُ ثِيابَ حِدادِ",8,"د",1,0],["وَأَصيَدَ نَرجوهُ لِكُلِّ مُلِمَّةٍ","عَلَينا وَيَرجوهُ الهُمامُ المُحَجَّبُ",9,"ب",1,0],["وَأُصيبُ شاكِلَةَ الرِمِيَّةِ إِذ","صَدَّت بِصَفحَتِها عَنِ السَهمِ",10,"م",1,0],["وأَصْيَدَ صَادَيْتُ عَنْ دَائِهِ","ونَارٍ بِبِطْنَتِهِ إِذْ بَطِنْ",11,"ن",1,0],["وَأُصِيبَتْ بِفَقْدِ أَيِّ عَمِيدٍ","أُسْرَةُ المَجْدِ وَالنَّدَى وَالذِّكَاءِ",12,"ا",2,0],["وأصِيخوا لوقعة تملأ الأر","ض عليكم بجحفلٍ جرّار",13,"ر",1,0],["وَأَصيرُ بِمَدفَنٍ","لِلمَخوفاتِ مَجمَعُ",14,"ع",1,0],["وأَصُيَدَ ظَلَّ يُدْرِكُ يومَ صَيْدٍ","طَرائِدَهُ بِجُرْدٍ كالسَّعَالي",15,"ي",1,1],["وأصيخ إذناً نحو صوت رسولها ال","داعي وألقي السمعَ وهو يؤنّب",16,"ب",1,0],["وأصيخوا لصوت قمريّة الحق","ل تغني في داجيات الليالي",17,"ي",1,0],["وأصيلا بالحِمَى نُغِّ","صَ بالعاذل طِيبُهْ",18,"ب",2,0],["وأصيبوا برزايا","هي إحدى السطوات",19,"ت",1,0],["وأصيحُ إنْ هاجت بقلبي زفرةٌ","من ذكرِهِمْ أخْشى بها الإِعْدَامَا",20,"م",2,0],["وأصير في الحرم الشريف مؤمنا","وارى لليلى في الغلائل تنجلي",21,"ل",2,0],["وأصير جارا للحبيب ومن يكن","جار الحبيب فقدره القدر العلي",21,"ل",2,0],["وأصيح من ألم المصيبة منشداً","نحو الشهابيّ الذي عني احتجب",22,"ب",1,0],["وأصيد في حلبات العلى","فات الهمام الأروع الأصيدا",23,"د",2,0],["وأصيل شمسه ما ذهبت","عنه حتى ذهبت عنه الأكاما",24,"م",2,0],["وأصيل من البلابل يشدو","يطرب الكون والخلائق طرَّا",25,"ر",2,0],["وَأُصيَدَ ذي تاجٍ غَلَلنا يَمينَهُ","إَلى الجيدِ في يَومٍ مِن الحَربِ جاحِمِ",26,"م",1,0],["وأصيد نفار عن الضيم لا يرى","غمار المنايا غير تهويم ناعس",27,"س",1,0],["وأصيل معصفر الجيب يجري","ماؤه جري أدمع التوديع",28,"ع",1,0],["وَأُصَيحابُهُ الأُولَى","قَد عَهِدتُم لَهُم وِدَاد",29,"د",1,0],["واصيحابٍ سروا قضباً","كلما لان السرى خشنوا",30,"ن",3,0],["وَأُصَيحاباً لَنا ما","بَدَّلوا عَهداً ذِماما",31,"م",2,0],["وأصيد من بحر القريض فرائداً","عصماء للدر النفيس تحاكي",32,"ك",2,0],["وأصيح يا من ليس يعرفه","أحد مدى الأحقاب والزمن",33,"ن",1,0],["وأصيح في حرماتها","ياللذمام وذمتي",34,"ت",2,0],["وأصيد يغنيه علاه عن الثنا","فسيان فيه ما أقل وأكثر",35,"ر",1,0],["وأصيح والعبرات تحنقني اسى","والحزن يخفي الصوت في انشادي",36,"د",2,0],["وأصيد ذي صولة وهيبة","ترجع عنه القهقري أسد الشرى",37,"ا",1,0],["وَأَصيلٍ كَأنَّهُ مِن صَباحٍ","غَيرَ أَن قَد غَدا رَقيقَ الأَدِيمِ",38,"م",1,0],["وا صيحة القعقاع, هيبة خالدٍ","دخل الخوارج واختفى النّجباءُ",39,"ا",2,0],["وأصيرُ ملاكاً بشرياً","وأطيرُ بأجنحةٍ أربَعْ",40,"ع",1,0],["وأصيغ من نظم القوافي الصعايب","جزله جزيله من جزيل الجزيلات",41,"ت",1,0],["واصيبوا بقرب ورد ظماء","فأصابوا الورود من سبسليبل",42,"ل",1,0],["وأصيرُ مِثْل الوَرْدِ فيْ فَيْنَانِهَا","حسَناءُ من أرِج ِالسَّما تتَعَطّرُ",43,"ر",1,0],["وأصيرُ نبع حكاية قمريّة","فيها الشموس من الحنين ستغرق",44,"ق",1,0],["وأصيرُ من آلائه غدقا","غيما من الأشواق يُشتقُ",45,"ق",1,0],["وأُصيخُ للفلجِ الذي يروي لنا","عزمَ الذي شقَّ الصفا وتَفَنُّنَه",46,"ن",2,0],["واصير بين يدين الأيام مقضوب","والليل يجلد بالسهر موق عيني",47,"ن",2,0],["واصيح لك مَا يسمَع المَوج غرقا","واصيح لك مَا يرجّع المَاضي حسوف",48,"ف",1,0],["وأصيحُ أخرى والبذورُ تصيخُ لي","سبحانَ مَن في كفّهِ الملكوتُ",49,"ت",1,0],["وأصيحُ يا ربّاه غوثكَ إنني","ماعُدتُ أحتملُ الذي لا يُحمَدُ",50,"د",1,0],["وأصير إعصارا على أبوابها","وأكون فارسَها الفتى المقداما",51,"م",2,0],["وأصيب أحلام العدى في المقتلِ","ليعيش شعبي فالبقا للأفضلِ",52,"ل",1,0],["وأصيحُ مهلاً يا فؤادي إنَّني","ما ثَمَّ منِّي غيرَ بعضِ سَوادي",53,"د",2,0]]}