html","السريع"],[375,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[390,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[407,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[407,"يا نسيما أذكى لهيب اشتياقي","https://www.aldiwan.net/poem33624.html","الخفيف"],[420,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[420,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[420,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[420,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[420,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[420,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[420,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[433,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[436,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[436,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[436,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[445,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[447,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[452,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[461,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[461,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[461,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[461,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[461,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[467,"وأنلته عزاً بغير مذلة","https://www.aldiwan.net/poem3180.html","عموديه"],[467,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[468,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[473,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[480,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[503,"يا لفتة الظبي من غربي لعلع في","https://www.aldiwan.net/poem38060.html","البسيط"],[512,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[517,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[518,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[541,"قالوا الفراق غدا فهل يغنيني","https://www.aldiwan.net/poem47594.html","عموديه"],[554,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[554,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[589,"يا راقدا لم يدر عمر الدجى","https://www.aldiwan.net/poem17514.html","السريع"],[589,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216929","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/9","الخفيف"]],"verses":[["هَل عَلى جَمعٍ نُزولٌ","وَعَلى الخَيفِ خِيامُ",0,"م",1,0],["هَل عَهدُنا بَعدَ التَفَرُّقِ راجِعٌ","أَو غُصنُنا بَعدَ التَسَلُّبِ مورِقُ",1,"ق",1,0],["هَل عَرَّقَت فيكُم كَفاطِمَةٍ","أَم هَل لَكُم كَمُحَمَّدٍ جَدُّ",2,"د",1,0],["هَل عَلِمتُم أَيّامَ يُنتَهَبُ النا","سُ غِواراً لِكُلِّ حَيٍّ عُواءُ",3,"ا",2,0],["هَل عيشَةٌ طابَت لَنا إِلّا وَقَد","أَبلى الزَمانُ قَديمَها وَجَديدَها",4,"د",3,0],["هَل عَهِدنا الشَمسَ تَعتادُ الكِلَل","أَم شَهِدنا البَدرَ يَجتابُ الحُلَل",5,"ل",1,1],["هل عجب في عيد تنصيرهم","عدى له أبهج أعيادي",6,"د",2,0],["هَلْ عِظَةٌ أَوْفَى بَلاغاً لِمَنْ","يَحْسَبُ دَارَ الحَرْبِ دَارَ السَّلامِ",7,"م",1,0],["هل عنده وذنوب العذر توبقه","أن الذي قد كساه العز أعراهُ",8,"ا",2,0],["هل عائد زمن أتيتُ مع المها","ما شئت من لعب به ومزاح",9,"ح",1,0],["هل عند منظركَ الشفاف جوهرة","إني إليه فقير اللحظ مضرور",10,"ر",1,0],["هل عليهنَّ في الجروح قصاصٌ","أم مباحٌ لها دم العشاقِ",11,"ق",1,0],["هَل عِندَ نَفسِكَ لِلحِفاظِ بَقِيَّةٌ","تَحمي البَقِيَّةَ مِن حَياةٍ تُسلَبُ",12,"ب",1,0],["هل علينا اذا صبونا الى السحر","كما يدّعى اناس جناح",13,"ح",1,0],["هل علمت انكلترا","أيّ لواء يزدرى",14,"ر",2,0],["هَل عِندَكِ الآنَ شَكٌّ","في رُتبَتي القَعساءِ",15,"ا",2,0],["هَلِعَت دِمَشقُ وَأَقبَلَت في أَهلِها","مَلهوفَةً لَم تَدرِ كَيفَ تَقولُ",16,"ل",1,0],["هَل عَهِدتَهُ","يُمطِرُ الذَهَب",17,"ب",1,0],["هَل عَلِمتُم أُمَّةً في جَهلِها","ظَهَرَت في المَجدِ حَسناءَ الرِداء",18,"ا",2,0],["هل عِبتَ إِن أنصفَت إِلّا أنه","طلبَ العَلاءَ وجدَّ فيه فنالَهُ",19,"ل",2,0],["هل عهْدُنا بِلوَى الشَّقيقَةِ راجِعٌ","فيعودَ لي فيه الوِصالُ شَقيقا",20,"ق",2,0],["هَل عِندَ أَهلِ القُبورِ مِن خَبَرِ","هَيهاتَ ما مِن عَينٍ وَلا أَثَرِ",21,"ر",1,1],["هَل عَلى نَفسِهِ اِمرُؤٌ مَحزونُ","موقِنٌ أَنَّهُ غَداً مَدفونُ",22,"ن",1,1],["هَل عَلِمَ الطَيفُ عِندَ مَسراهُ","أَنَّ عُيونَ المُحِبِّ تَرعاهُ",23,"ا",2,1],["هَل عَلَيهِ في لَثمِ فيهِ جُناحٌ","إِن غَدا مُضمِراً مَحَبَّةَ صِدقِ",24,"ق",1,0],["هَل عَندَمُ الوَجَناتِ رَخَّصَ في دَمي","أَم طَرفِكِ الفَتّاكُ قَد أَفتاكِ",25,"ك",1,0],["هَل عَرَفتَ الغَداةَ مِن أَطلالِ","رَهنِ ريحٍ وَديمَةٍ مِهطالِ",26,"ل",1,1],["هَل عَرَفتَ اليَومَ مِن شَن","باءِ بِالنَعفِ رُسوما",27,"م",2,1],["هَل عَيشُنا بِمِنىً يَعودُ كَعَهدِنا","إِذ لا نُراعُ وَلا يُطاعُ اللُوَّمُ",28,"م",1,0],["هَل عِندَ رَسمٍ بِرامَةٍ خَبَرُ","أَم لا فَأَيَّ الأَشياءِ تَنتَظِرُ",29,"ر",1,1],["هَل عَقَّ مَنبِتَهُ أَو خانَ أُمَّتَهُ","إِلّا اِمرُؤٌ مالَهُ دينٌ وَلا خُلُقُ",30,"ق",1,0],["هل عِندكم أنْ تغشَّتْكُم سَرِيَّتُهُ","للسَّيفِ سَيْفٌ ولِلضِرغَامِ ضِرغامُ",31,"م",1,0],["هل عهد إبراهيم غير صحيفة","قد أشرقت بالعِلْيَة الأَمجادِ",32,"د",1,0],["هَل عَدَتنا ظَعينَةٌ تَطلُبُ العَزْ","زمِنَ الناسِ في الخُطوبِ المَواضي",33,"ض",2,0],["هَل عَرَفتَ الرَبعَ أَجلى","أَهلُهُ عَنهُ فَزالا",34,"ل",2,1],["هَل عَلى عاشِقٍ خَلا بِحَبيبٍ","في اِلتِزامٍ وَقُبلَةٍ مِن جُناحِ",35,"ح",1,0],["هَل عاجِلٌ مِن مَتاعِ الحيِّ مَنظورُ","أَم بَيتُ دومَةَ بَعدَ الإِلفِ مَهجورُ",36,"ر",1,1],["هَلْ عَلَيَّ وَيْحَكُما","إنْ لَهَوْتُ مِنْ حَرَجِ",37,"ج",1,0],["هَل عي فيك عَن البَيان لسانه","أَم هَل لذاكَ السيف بعد مضاء",38,"ا",2,0],["هلعت قلوب القوم في اليابانِ","للبحر حين طغى وَللنيرانِ",39,"ن",1,1],["هَلْ عَاشِقٌ نَالَ مِنْ دَهْمَاءَ حَاجَتَهُ","في الجَاهِليَّةِ قَبْلَ الدِّينِ مَرْحُومُ",40,"م",1,0],["هَلْ عَلى سَالِمِ النَّوَاظِرِ بَأسٌ","مِنْ غِشَاءٍ يَكون فِي المَنْظورِ",41,"ر",1,0],["هَلْ عَجَبٌ فِي عِيد تنصِيرِهمْ","عِنْدي لَهُ أَبْهَجُ أَعْيَادِي",42,"د",2,0],["هَلْ عَجِيبٌ أَنْ يَجْمَعَ الشَّرْقَ وَالغَرْ","بَ مُصَابٌ فِي الْعَبْقَرِيِّ الْفَرِيدِ",43,"د",1,0],["هَل عادَةُ المُشتاقِ لَيلَةَ عيدِهِ","وَصَباحِهِ إِلّا بُكاً وَرَسيسُ",44,"س",1,0],["هل على المفجوعِ في أوطانِه","حَرَجٌ إنْ ردّد الشكوَى وبَاح",45,"ح",1,0],["هل على الهاتفِ بالحسن إذا","ما شدا من حَرجٍ أو عَتَب",46,"ب",1,0],["هل علمتم أنَّ مَنْ واريتُمُ","في حَنايا كلِّ مصريٍ دفين",47,"ن",1,0],["هل عيون الأديب نهر لهيب","أم عيون الأديب نهر أغاني",48,"ن",2,0],["هل عند أنْمُلَةٍ تُحَرِّكُها","باللطفِ إنَّ الدمعَ بالأثر",49,"ر",1,0],["هل عند أنجمك الضواحك ما بي","يا ليل إشراكي وصبح متابي",50,"ب",2,1],["هَل عاقَها ما عايَنَتهُ فَلَم تَسِر","أَم راقَها هَذا الجَنابُ المُمرِعُ",51,"ع",1,0],["هَل عِندَ مَنزِلَةٍ قَد أَقفَرَت خَبَرُ","مَجهولَةٍ غَيَّرَتها بَعدَكَ الغِيَرُ",52,"ر",1,1],["هل علموه فصار يهجرني","رب خذ الحق من معلمه",53,"ه",1,0],["هَل عندَ ذاك السِربِ أَنّا بعدَه","في الحَيِّ مِن آماقِنا نَتَدَفَّقُ",54,"ق",1,0],["هل عائد زمن تضوع نشره","أرجا ورقت بالرضى أسحاره",55,"ر",2,0],["هل عائد لي والمُنى ضلّةٌ","ظلٌ وورد سائغ ريّق",56,"ق",1,0],["هَل عَيشُنا بِلوى الأُجَيرِعِ راجِعٌ","وَمَواقِف قَضَّيتُها في لَعلَعِ",57,"ع",1,0],["هَل عائِدٌ وَالأَماني غَيرَ صادِقَةٍ","أَسحارُ وَصلٍ قَضَيناها وَآصالُ",58,"ل",1,0],["هَل عند مُعتَدِلِ القَوامِ لعاشِقٍ","عَدلٌ وَهَل عِندَ الجميلِ جَميلُ",59,"ل",1,0],["هل عذابي في ملامٍ","أم ملامي في عذابي؟",60,"ب",2,0],["هَل عرس الظاعن المشيم","بالابرق الفرد يا نَسيم",61,"م",1,1],["هَل عهدهم عهدهم بنجد","باق أَم استؤمنوا فَخانوا",62,"ن",3,0],["هَل عطفة منك يا مَولاي تبلغني","منك المراد فَفيك البر مأمول",63,"ل",1,0],["هَل عطفه بجلية حكمية","نبوية صمدية لي منكما",64,"م",2,0],["هَل عندكم علم عَن العلمين أَو","عَن معهد بالرقمتين خراب",65,"ب",1,0],["هَل عِندَ عَمرَةَ مِن بَتاتِ مُسافِرِ","ذي حاجَةٍ مُتَرَوَّحٍ اَو باكِرِ",66,"ر",1,1],["هَل عَهدُ سُعدى كَما قد كان أَم خَفَرت","عهدَ الأَحِبَّة تلك الغادة الخَفِرَه",67,"ر",2,0],["هل عراه طائفٌ من جنةٍ","ليتَ شعري أَم به مسُّ جنون",68,"ن",1,0],["هل على الأرض ناسك عبد الله","ولم يشغل الجمال فؤاده",69,"د",2,1],["هَل عَرَفت الهَوى فَقُلت وَهَل أَن","شَد في غَير فنه ميخانَه",70,"ن",2,0],["هَل عَلى غَير بَيتِهِم نَزل الوَحي","بِجِبريل خادِما مَأمورا",71,"ر",2,0],["هل عنْدَ حَيِّ العامريّةِ قُدرةٌ","أنْ يَفْعلوا فوقَ الَّذي فعلَتْ بنا",72,"ن",2,0],["هل عُصبةُ الإشراكِ تَعلَمُ أَنّها","ما صادَفَتْ من حَدِّ سيفِكَ مأْمَنا",72,"ن",2,0],["هَل عَلَّمَت لَقطَها لِلحَبَّ لَهذَمَها","أَما تَراهُ لِحَبِّ القَلبِ قَد لَقَطا",73,"ط",2,0],["هَل عَرَفْتَ الدارَ أَمْ أَنكَرْتَهَا","بَيْنَ تِبْرَاكٍ فَشَسَّيْ عَبَقُرّْ",74,"ر",1,0],["هل عَلمَ النَّدمانُ لما سُقوا","ما أكسبَ الصَّهباءَ ساقِيها",75,"ه",2,1],["هل عند خُطَّاب العُلى أنني","وكيلُها في طَلب المَهرِ",76,"ر",1,0],["هَل عِندَ غانٍ لِفُؤادٍ صَدِ","مِن نَهلَةٍ في اليَومِ أَو في غَدِ",77,"د",1,1],["هل عندهم عن لوعتي","خبر وهل علموا بأني",78,"ن",2,0],["هل عساها تعود يوماً من الده","ر وتفدى من عمرنا بالبواقي",79,"ق",2,0],["هل عَرَفْتَ الدّيارَ من آل ميٍّ","بعد أن أصْبَحَت طلولاً رماما",80,"ا",1,0],["هل عَلِمْتم بعدما قوَّضتمُ","أنَّ لي من بعدكم نوح الحمام",81,"م",1,0],["هلْ علمْتُمْ في بينكم أنَّ عيني","لم تذق بعدكم لذيذ الرقاد",82,"د",1,0],["هلْ عَجِبْتُمْ والحبُّ أمرٌ عجيبٌ","كيفَ يَستعذبُ العذابَ المهينا",83,"ن",2,0],["هل علمتم أنَّ أحداق المها","خلقت حينئذٍ سحرَ العقول",84,"ل",1,0],["هَل عَرَفْتَ الديار من آل نُعمى","ومحلاًّ عفى لبين ألمَّا",85,"م",2,1],["هل علم الدهر الذي أساءني","أيّ أخي عزم وذي فضل قلى",86,"ا",1,0],["هل عائد لي زمنٌ عبرة بذي الغضا","وهل يريني الدهر ما كنت أرى",86,"ا",1,0],["هل على العهد تراها باقيه","بعدنا أم هل أضاعت عهدنا",87,"ن",2,0],["هل عادَ قلبِيَ بِرْجاساً تُقَارِضُه","نَبْلُ النَّوائبِ عن إِنْبَاضَةِ الزَّمَنِ",88,"ن",1,0],["هل عرفتَ الدارَ قفراً","تتراءى كالسّرابِ",89,"ب",1,0],["هل عندَ ليلِ الشعرِ أني نائمٌ","ولصَبوَتي طرفٌ عليه مسهَّدُ",90,"د",1,0],["هل عامل أعمالها فيرى جزا","أعمالها يوم الجزا عمالها",91,"ل",3,0],["هل عازم أنت طمس بقعتنا","من صفحة الأرض عزم مفترق",92,"ق",1,0],["هل على وجه الثرى من لغة","أحدثت في مسمع الدهر صدى",93,"د",2,0],["هل عند هذا الطلل الماحِلِ","من جلَدٍ يُجِدي على سائلِ",94,"ل",1,1],["هل على باب الأحاظي آذنٌ","أم إلى جاري المقاديرِ رسولُ",95,"ل",1,0],["هل عند ظبي المنحنى","من جائدٍ فيُسألا",96,"ل",2,0],["هل عند ريح الصَّبا من رامةٍ خبرُ","أم طاب أن صاب روضاتِ اللّوى المطرُ",97,"ر",1,1],["هل عند عينيك على غُرّبِ","غرامةٌ بالعارضِ الخُلَّبِ",98,"ب",1,1],["هل عائبٌ للشمس غبيةُ ليلةٍ","أو منكرٌ للبدر أن يتحجّبا",99,"ب",2,0],["هل عند ساكنة الغضا من أضلعي","علمٌ وقد شبّت بها جمرَ الغضا",100,"ض",2,0],["هَل عِشتَ إلا لِهذا؟..أو لأنبَلَ مِن","هذا ؟..فأيَّ اضطِرابٍ كنتَ تَضطربُ؟!",101,"ب",1,0],["هَل عَيشُنا بِكَ في زَمانِكَ راجِعٌ","فَلَقَد تَقاعَسَ بَعدَكَ المُتَعَلِّلُ",102,"ل",1,0],["هل عائدٌ بهِ زمانٌ","لم يَشُبْهُ نكدُهْ",103,"د",2,0],["هل عندهُمْ رحمَةٌ لي إنَّني دَنِفٌ","هم دونَ أَعراضِ هذا الكَوْنِ مَشْغَلَتي",104,"ت",2,0],["هَل عَرَفتَ الغَداةَ رَسماً مَحيلا","دارِساً بَعدَ أَهلِهِ مَجهولا",105,"ل",2,1],["هل عانقَ الشّمسَ إلّا سيفَهُ فلَقٌ","واِستغرَقَ البحرَ إلّا دِرعهُ وشَلُ",106,"ل",1,0],["هل عند محتقر يسير بلية","أن الصغار من الهموم كبار",107,"ر",1,0],["هَل عَطفَةٌ نَحوي إذا مَرَ الصَّبا","لاَ تَنسَها من عَادةٍ لِغُصُونِ",108,"ن",1,0],["هل عودَةٌ لمثلها","فقال لِي ما أهْوَنَهْ",109,"ن",2,0],["هَل عائِدٌ يَنفع من عِلّتِي","أو مُسْعِدٌ ينقع من غُلَّتِي",110,"ي",1,1],["هَلْ عاذِرٌ في الحبِّ لي عَاذٍلٌ","أَو جَابِرٌ ناظِرُهُ الجائِرُ",111,"ر",1,0],["هل عائدٌ والأماني قَلَّما صَدقتْ","دَهْرٌ مَضَى وَمغاني حُسْنِكُمْ أُمَمُ",112,"م",1,0],["هل عَرَفْتَ الدّارَ قَفْراً لمْ تُحل","بينَ أجْمَادٍ خِفافٍ فالرّجلْ",113,"ل",1,1],["هَل عَرَفتَ الدِيارَ عَن أَحقابِ","دارِساً آيُها كَخَطِّ الكِتابِ",114,"ب",1,1]]}