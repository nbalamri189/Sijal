oem3531.html","عموديه"],[466,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[471,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[478,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[501,"يا لفتة الظبي من غربي لعلع في","https://www.aldiwan.net/poem38060.html","البسيط"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[515,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[539,"قالوا الفراق غدا فهل يغنيني","https://www.aldiwan.net/poem47594.html","عموديه"],[552,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[587,"يا راقدا لم يدر عمر الدجى","https://www.aldiwan.net/poem17514.html","السريع"],[587,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["هَل عَلى جَمعٍ نُزولٌ","وَعَلى الخَيفِ خِيامُ",0,"م",1,0],["هَل عَهدُنا بَعدَ التَفَرُّقِ راجِعٌ","أَو غُصنُنا بَعدَ التَسَلُّبِ مورِقُ",1,"ق",1,0],["هَل عَرَّقَت فيكُم كَفاطِمَةٍ","أَم هَل لَكُم كَمُحَمَّدٍ جَدُّ",2,"د",1,0],["هَل عَلِمتُم أَيّامَ يُنتَهَبُ النا","سُ غِواراً لِكُلِّ حَيٍّ عُواءُ",3,"ا",2,0],["هَل عيشَةٌ طابَت لَنا إِلّا وَقَد","أَبلى الزَمانُ قَديمَها وَجَديدَها",4,"د",3,0],["هَل عَهِدنا الشَمسَ تَعتادُ الكِلَل","أَم شَهِدنا البَدرَ يَجتابُ الحُلَل",5,"ل",1,1],["هل عجب في عيد تنصيرهم","عدى له أبهج أعيادي",6,"د",2,0],["هَلْ عِظَةٌ أَوْفَى بَلاغاً لِمَنْ","يَحْسَبُ دَارَ الحَرْبِ دَارَ السَّلامِ",7,"م",1,0],["هل عنده وذنوب العذر توبقه","أن الذي قد كساه العز أعراهُ",8,"ا",2,0],["هل عائد زمن أتيتُ مع المها","ما شئت من لعب به ومزاح",9,"ح",1,0],["هل عند منظركَ الشفاف جوهرة","إني إليه فقير اللحظ مضرور",10,"ر",1,0],["هل عليهنَّ في الجروح قصاصٌ","أم مباحٌ لها دم العشاقِ",11,"ق",1,0],["هَل عِندَ نَفسِكَ لِلحِفاظِ بَقِيَّةٌ","تَحمي البَقِيَّةَ مِن حَياةٍ تُسلَبُ",12,"ب",1,0],["هل علينا اذا صبونا الى السحر","كما يدّعى اناس جناح",13,"ح",1,0],["هل علمت انكلترا","أيّ لواء يزدرى",14,"ر",2,0],["هَل عِندَكِ الآنَ شَكٌّ","في رُتبَتي القَعساءِ",15,"ا",2,0],["هَلِعَت دِمَشقُ وَأَقبَلَت في أَهلِها","مَلهوفَةً لَم تَدرِ كَيفَ تَقولُ",16,"ل",1,0],["هَل عَهِدتَهُ","يُمطِرُ الذَهَب",17,"ب",1,0],["هَل عَلِمتُم أُمَّةً في جَهلِها","ظَهَرَت في المَجدِ حَسناءَ الرِداء",18,"ا",2,0],["هل عِبتَ إِن أنصفَت إِلّا أنه","طلبَ العَلاءَ وجدَّ فيه فنالَهُ",19,"ل",2,0],["هل عهْدُنا بِلوَى الشَّقيقَةِ راجِعٌ","فيعودَ لي فيه الوِصالُ شَقيقا",20,"ق",2,0],["هَل عِندَ أَهلِ القُبورِ مِن خَبَرِ","هَيهاتَ ما مِن عَينٍ وَلا أَثَرِ",21,"ر",1,1],["هَل عَلى نَفسِهِ اِمرُؤٌ مَحزونُ","موقِنٌ أَنَّهُ غَداً مَدفونُ",22,"ن",1,1],["هَل عَلِمَ الطَيفُ عِندَ مَسراهُ","أَنَّ عُيونَ المُحِبِّ تَرعاهُ",23,"ا",2,1],["هَل عَلَيهِ في لَثمِ فيهِ جُناحٌ","إِن غَدا مُضمِراً مَحَبَّةَ صِدقِ",24,"ق",1,0],["هَل عَندَمُ الوَجَناتِ رَخَّصَ في دَمي","أَم طَرفِكِ الفَتّاكُ قَد أَفتاكِ",25,"ك",1,0],["هَل عَرَفتَ اليَومَ مِن شَن","باءِ بِالنَعفِ رُسوما",26,"م",2,1],["هَل عَيشُنا بِمِنىً يَعودُ كَعَهدِنا","إِذ لا نُراعُ وَلا يُطاعُ اللُوَّمُ",27,"م",1,0],["هَل عِندَ رَسمٍ بِرامَةٍ خَبَرُ","أَم لا فَأَيَّ الأَشياءِ تَنتَظِرُ",28,"ر",1,1],["هَل عَقَّ مَنبِتَهُ أَو خانَ أُمَّتَهُ","إِلّا اِمرُؤٌ مالَهُ دينٌ وَلا خُلُقُ",29,"ق",1,0],["هل عِندكم أنْ تغشَّتْكُم سَرِيَّتُهُ","للسَّيفِ سَيْفٌ ولِلضِرغَامِ ضِرغامُ",30,"م",1,0],["هل عهد إبراهيم غير صحيفة","قد أشرقت بالعِلْيَة الأَمجادِ",31,"د",1,0],["هَل عَدَتنا ظَعينَةٌ تَطلُبُ العَزْ","زمِنَ الناسِ في الخُطوبِ المَواضي",32,"ض",2,0],["هَل عَرَفتَ الرَبعَ أَجلى","أَهلُهُ عَنهُ فَزالا",33,"ل",2,1],["هَل عَلى عاشِقٍ خَلا بِحَبيبٍ","في اِلتِزامٍ وَقُبلَةٍ مِن جُناحِ",34,"ح",1,0],["هَل عاجِلٌ مِن مَتاعِ الحيِّ مَنظورُ","أَم بَيتُ دومَةَ بَعدَ الإِلفِ مَهجورُ",35,"ر",1,1],["هَلْ عَلَيَّ وَيْحَكُما","إنْ لَهَوْتُ مِنْ حَرَجِ",36,"ج",1,0],["هَل عي فيك عَن البَيان لسانه","أَم هَل لذاكَ السيف بعد مضاء",37,"ا",2,0],["هلعت قلوب القوم في اليابانِ","للبحر حين طغى وَللنيرانِ",38,"ن",1,1],["هَلْ عَلى سَالِمِ النَّوَاظِرِ بَأسٌ","مِنْ غِشَاءٍ يَكون فِي المَنْظورِ",39,"ر",1,0],["هَلْ عَجَبٌ فِي عِيد تنصِيرِهمْ","عِنْدي لَهُ أَبْهَجُ أَعْيَادِي",40,"د",2,0],["هَلْ عَجِيبٌ أَنْ يَجْمَعَ الشَّرْقَ وَالغَرْ","بَ مُصَابٌ فِي الْعَبْقَرِيِّ الْفَرِيدِ",41,"د",1,0],["هَل عادَةُ المُشتاقِ لَيلَةَ عيدِهِ","وَصَباحِهِ إِلّا بُكاً وَرَسيسُ",42,"س",1,0],["هل على المفجوعِ في أوطانِه","حَرَجٌ إنْ ردّد الشكوَى وبَاح",43,"ح",1,0],["هل على الهاتفِ بالحسن إذا","ما شدا من حَرجٍ أو عَتَب",44,"ب",1,0],["هل علمتم أنَّ مَنْ واريتُمُ","في حَنايا كلِّ مصريٍ دفين",45,"ن",1,0],["هل عيون الأديب نهر لهيب","أم عيون الأديب نهر أغاني",46,"ن",2,0],["هل عند أنْمُلَةٍ تُحَرِّكُها","باللطفِ إنَّ الدمعَ بالأثر",47,"ر",1,0],["هل عند أنجمك الضواحك ما بي","يا ليل إشراكي وصبح متابي",48,"ب",2,1],["هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","رَهْنِ رِيحٍ وَدِيَمَة ٍ مِهْطَالِ",49,"ل",1,1],["هَل عاقَها ما عايَنَتهُ فَلَم تَسِر","أَم راقَها هَذا الجَنابُ المُمرِعُ",50,"ع",1,0],["هَل عِندَ مَنزِلَةٍ قَد أَقفَرَت خَبَرُ","مَجهولَةٍ غَيَّرَتها بَعدَكَ الغِيَرُ",51,"ر",1,1],["هل علموه فصار يهجرني","رب خذ الحق من معلمه",52,"ه",1,0],["هَل عندَ ذاك السِربِ أَنّا بعدَه","في الحَيِّ مِن آماقِنا نَتَدَفَّقُ",53,"ق",1,0],["هل عائد زمن تضوع نشره","أرجا ورقت بالرضى أسحاره",54,"ر",2,0],["هل عائد لي والمُنى ضلّةٌ","ظلٌ وورد سائغ ريّق",55,"ق",1,0],["هَل عَيشُنا بِلوى الأُجَيرِعِ راجِعٌ","وَمَواقِف قَضَّيتُها في لَعلَعِ",56,"ع",1,0],["هَل عائِدٌ وَالأَماني غَيرَ صادِقَةٍ","أَسحارُ وَصلٍ قَضَيناها وَآصالُ",57,"ل",1,0],["هَل عند مُعتَدِلِ القَوامِ لعاشِقٍ","عَدلٌ وَهَل عِندَ الجميلِ جَميلُ",58,"ل",1,0],["هل عذابي في ملامٍ","أم ملامي في عذابي؟",59,"ب",2,0],["هَل عرس الظاعن المشيم","بالابرق الفرد يا نَسيم",60,"م",1,1],["هَل عهدهم عهدهم بنجد","باق أَم استؤمنوا فَخانوا",61,"ن",3,0],["هَل عطفة منك يا مَولاي تبلغني","منك المراد فَفيك البر مأمول",62,"ل",1,0],["هَل عطفه بجلية حكمية","نبوية صمدية لي منكما",63,"م",2,0],["هَل عندكم علم عَن العلمين أَو","عَن معهد بالرقمتين خراب",64,"ب",1,0],["هَل عِندَ عَمرَةَ مِن بَتاتِ مُسافِرِ","ذي حاجَةٍ مُتَرَوَّحٍ اَو باكِرِ",65,"ر",1,1],["هَل عَهدُ سُعدى كَما قد كان أَم خَفَرت","عهدَ الأَحِبَّة تلك الغادة الخَفِرَه",66,"ر",2,0],["هل عراه طائفٌ من جنةٍ","ليتَ شعري أَم به مسُّ جنون",67,"ن",1,0],["هل على الأرض ناسك عبد الله","ولم يشغل الجمال فؤاده",68,"د",2,1],["هَل عَرَفت الهَوى فَقُلت وَهَل أَن","شَد في غَير فنه ميخانَه",69,"ن",2,0],["هَل عَلى غَير بَيتِهِم نَزل الوَحي","بِجِبريل خادِما مَأمورا",70,"ر",2,0],["هل عنْدَ حَيِّ العامريّةِ قُدرةٌ","أنْ يَفْعلوا فوقَ الَّذي فعلَتْ بنا",71,"ن",2,0],["هل عُصبةُ الإشراكِ تَعلَمُ أَنّها","ما صادَفَتْ من حَدِّ سيفِكَ مأْمَنا",71,"ن",2,0],["هَل عَلَّمَت لَقطَها لِلحَبَّ لَهذَمَها","أَما تَراهُ لِحَبِّ القَلبِ قَد لَقَطا",72,"ط",2,0],["هَل عَرَفْتَ الدارَ أَمْ أَنكَرْتَهَا","بَيْنَ تِبْرَاكٍ فَشَسَّيْ عَبَقُرّْ",73,"ر",1,0],["هل عَلمَ النَّدمانُ لما سُقوا","ما أكسبَ الصَّهباءَ ساقِيها",74,"ه",2,1],["هل عند خُطَّاب العُلى أنني","وكيلُها في طَلب المَهرِ",75,"ر",1,0],["هَل عِندَ غانٍ لِفُؤادٍ صَدِ","مِن نَهلَةٍ في اليَومِ أَو في غَدِ",76,"د",1,1],["هل عندهم عن لوعتي","خبر وهل علموا بأني",77,"ن",2,0],["هل عساها تعود يوماً من الده","ر وتفدى من عمرنا بالبواقي",78,"ق",2,0],["هل عَرَفْتَ الدّيارَ من آل ميٍّ","بعد أن أصْبَحَت طلولاً رماما",79,"ا",1,0],["هل عَلِمْتم بعدما قوَّضتمُ","أنَّ لي من بعدكم نوح الحمام",80,"م",1,0],["هلْ علمْتُمْ في بينكم أنَّ عيني","لم تذق بعدكم لذيذ الرقاد",81,"د",1,0],["هلْ عَجِبْتُمْ والحبُّ أمرٌ عجيبٌ","كيفَ يَستعذبُ العذابَ المهينا",82,"ن",2,0],["هل علمتم أنَّ أحداق المها","خلقت حينئذٍ سحرَ العقول",83,"ل",1,0],["هَل عَرَفْتَ الديار من آل نُعمى","ومحلاًّ عفى لبين ألمَّا",84,"م",2,1],["هل علم الدهر الذي أساءني","أيّ أخي عزم وذي فضل قلى",85,"ا",1,0],["هل عائد لي زمنٌ عبرة بذي الغضا","وهل يريني الدهر ما كنت أرى",85,"ا",1,0],["هل على العهد تراها باقيه","بعدنا أم هل أضاعت عهدنا",86,"ن",2,0],["هل عادَ قلبِيَ بِرْجاساً تُقَارِضُه","نَبْلُ النَّوائبِ عن إِنْبَاضَةِ الزَّمَنِ",87,"ن",1,0],["هل عرفتَ الدارَ قفراً","تتراءى كالسّرابِ",88,"ب",1,0],["هل عندَ ليلِ الشعرِ أني نائمٌ","ولصَبوَتي طرفٌ عليه مسهَّدُ",89,"د",1,0],["هل عامل أعمالها فيرى جزا","أعمالها يوم الجزا عمالها",90,"ل",3,0],["هل عازم أنت طمس بقعتنا","من صفحة الأرض عزم مفترق",91,"ق",1,0],["هل على وجه الثرى من لغة","أحدثت في مسمع الدهر صدى",92,"د",2,0],["هل عند هذا الطلل الماحِلِ","من جلَدٍ يُجِدي على سائلِ",93,"ل",1,1],["هل على باب الأحاظي آذنٌ","أم إلى جاري المقاديرِ رسولُ",94,"ل",1,0],["هل عند ظبي المنحنى","من جائدٍ فيُسألا",95,"ل",2,0],["هل عند ريح الصَّبا من رامةٍ خبرُ","أم طاب أن صاب روضاتِ اللّوى المطرُ",96,"ر",1,1],["هل عند عينيك على غُرّبِ","غرامةٌ بالعارضِ الخُلَّبِ",97,"ب",1,1],["هل عائبٌ للشمس غبيةُ ليلةٍ","أو منكرٌ للبدر أن يتحجّبا",98,"ب",2,0],["هل عند ساكنة الغضا من أضلعي","علمٌ وقد شبّت بها جمرَ الغضا",99,"ض",2,0],["هَل عِشتَ إلا لِهذا؟..أو لأنبَلَ مِن","هذا ؟..فأيَّ اضطِرابٍ كنتَ تَضطربُ؟!",100,"ب",1,0],["هَل عَيشُنا بِكَ في زَمانِكَ راجِعٌ","فَلَقَد تَقاعَسَ بَعدَكَ المُتَعَلِّلُ",101,"ل",1,0],["هل عائدٌ بهِ زمانٌ","لم يَشُبْهُ نكدُهْ",102,"د",2,0],["هل عندهُمْ رحمَةٌ لي إنَّني دَنِفٌ","هم دونَ أَعراضِ هذا الكَوْنِ مَشْغَلَتي",103,"ت",2,0],["هَل عَرَفتَ الغَداةَ رَسماً مَحيلا","دارِساً بَعدَ أَهلِهِ مَجهولا",104,"ل",2,1],["هل عانقَ الشّمسَ إلّا سيفَهُ فلَقٌ","واِستغرَقَ البحرَ إلّا دِرعهُ وشَلُ",105,"ل",1,0],["هل عند محتقر يسير بلية","أن الصغار من الهموم كبار",106,"ر",1,0],["هَل عَطفَةٌ نَحوي إذا مَرَ الصَّبا","لاَ تَنسَها من عَادةٍ لِغُصُونِ",107,"ن",1,0],["هل عودَةٌ لمثلها","فقال لِي ما أهْوَنَهْ",108,"ن",2,0],["هَل عائِدٌ يَنفع من عِلّتِي","أو مُسْعِدٌ ينقع من غُلَّتِي",109,"ي",1,1],["هَلْ عاذِرٌ في الحبِّ لي عَاذٍلٌ","أَو جَابِرٌ ناظِرُهُ الجائِرُ",110,"ر",1,0],["هل عائدٌ والأماني قَلَّما صَدقتْ","دَهْرٌ مَضَى وَمغاني حُسْنِكُمْ أُمَمُ",111,"م",1,0]]}