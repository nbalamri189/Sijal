مقتِّلٌ مقتولُ","https://www.poetsgate.com/ViewPoem.aspx?id=196837",""],[5431,"من أطلق الوحشا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=199214",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5596,"العنب","https://www.poetsgate.com/ViewPoem.aspx?id=206378",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5720,"أَيَّامٌ مَعْدُوْدَاتْ","https://www.poetsgate.com/ViewPoem.aspx?id=204641",""],[5720,"يَا قَلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=214076",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5853,"((ناديتني))...على لسان الأنثى","https://www.poetsgate.com/ViewPoem.aspx?id=175647",""],[5956,"معنى آه كنت أجهله","https://www.poetsgate.com/ViewPoem.aspx?id=182143",""],[5956,"منطق العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=192221",""],[5956,"إجازة سعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=194399",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[5977,"جفاء الأصحاب","https://www.poetsgate.com/ViewPoem.aspx?id=213121",""],[5984,"لهف نفسي على الغزال الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=200379",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""],[6082,"اكتبي يا أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=59114",""],[6142,"يا مفعم البئر في بدر أشاوسة","https://www.poetsgate.com/ViewPoem.aspx?id=155712",""],[6236,"إذاً .. فَلْنَقتُل الحُبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81604&r=&rc=2",""],[6243,"سحق الوهم ِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84440&r=&rc=14",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""]],"verses":[["هَل عَلى جَمعٍ نُزولٌ","وَعَلى الخَيفِ خِيامُ",0,"م",1,0],["هَل عَهدُنا بَعدَ التَفَرُّقِ راجِعٌ","أَو غُصنُنا بَعدَ التَسَلُّبِ مورِقُ",1,"ق",1,0],["هَل عَرَّقَت فيكُم كَفاطِمَةٍ","أَم هَل لَكُم كَمُحَمَّدٍ جَدُّ",2,"د",1,0],["هَل عَلِمتُم أَيّامَ يُنتَهَبُ النا","سُ غِواراً لِكُلِّ حَيٍّ عُواءُ",3,"ا",2,0],["هَل عيشَةٌ طابَت لَنا إِلّا وَقَد","أَبلى الزَمانُ قَديمَها وَجَديدَها",4,"د",3,0],["هَل عَهِدنا الشَمسَ تَعتادُ الكِلَل","أَم شَهِدنا البَدرَ يَجتابُ الحُلَل",5,"ل",1,1],["هل عجب في عيد تنصيرهم","عدى له أبهج أعيادي",6,"د",2,0],["هَلْ عِظَةٌ أَوْفَى بَلاغاً لِمَنْ","يَحْسَبُ دَارَ الحَرْبِ دَارَ السَّلامِ",7,"م",1,0],["هل عنده وذنوب العذر توبقه","أن الذي قد كساه العز أعراهُ",8,"ا",2,0],["هل عائد زمن أتيتُ مع المها","ما شئت من لعب به ومزاح",9,"ح",1,0],["هل عند منظركَ الشفاف جوهرة","إني إليه فقير اللحظ مضرور",10,"ر",1,0],["هل عليهنَّ في الجروح قصاصٌ","أم مباحٌ لها دم العشاقِ",11,"ق",1,0],["هَل عِندَ نَفسِكَ لِلحِفاظِ بَقِيَّةٌ","تَحمي البَقِيَّةَ مِن حَياةٍ تُسلَبُ",12,"ب",1,0],["هل علينا اذا صبونا الى السحر","كما يدّعى اناس جناح",13,"ح",1,0],["هل علمت انكلترا","أيّ لواء يزدرى",14,"ر",2,0],["هَل عِندَكِ الآنَ شَكٌّ","في رُتبَتي القَعساءِ",15,"ا",2,0],["هَلِعَت دِمَشقُ وَأَقبَلَت في أَهلِها","مَلهوفَةً لَم تَدرِ كَيفَ تَقولُ",16,"ل",1,0],["هَل عَهِدتَهُ","يُمطِرُ الذَهَب",17,"ب",1,0],["هَل عَلِمتُم أُمَّةً في جَهلِها","ظَهَرَت في المَجدِ حَسناءَ الرِداء",18,"ا",2,0],["هل عِبتَ إِن أنصفَت إِلّا أنه","طلبَ العَلاءَ وجدَّ فيه فنالَهُ",19,"ل",2,0],["هل عهْدُنا بِلوَى الشَّقيقَةِ راجِعٌ","فيعودَ لي فيه الوِصالُ شَقيقا",20,"ق",2,0],["هَل عِندَ أَهلِ القُبورِ مِن خَبَرِ","هَيهاتَ ما مِن عَينٍ وَلا أَثَرِ",21,"ر",1,1],["هَل عَلى نَفسِهِ اِمرُؤٌ مَحزونُ","موقِنٌ أَنَّهُ غَداً مَدفونُ",22,"ن",1,1],["هَل عَلِمَ الطَيفُ عِندَ مَسراهُ","أَنَّ عُيونَ المُحِبِّ تَرعاهُ",23,"ا",2,1],["هَل عَلَيهِ في لَثمِ فيهِ جُناحٌ","إِن غَدا مُضمِراً مَحَبَّةَ صِدقِ",24,"ق",1,0],["هَل عَندَمُ الوَجَناتِ رَخَّصَ في دَمي","أَم طَرفِكِ الفَتّاكُ قَد أَفتاكِ",25,"ك",1,0],["هَل عَرَفتَ الغَداةَ مِن أَطلالِ","رَهنِ ريحٍ وَديمَةٍ مِهطالِ",26,"ل",1,1],["هَل عَرَفتَ اليَومَ مِن شَن","باءِ بِالنَعفِ رُسوما",27,"م",2,1],["هَل عَيشُنا بِمِنىً يَعودُ كَعَهدِنا","إِذ لا نُراعُ وَلا يُطاعُ اللُوَّمُ",28,"م",1,0],["هَل عِندَ رَسمٍ بِرامَةٍ خَبَرُ","أَم لا فَأَيَّ الأَشياءِ تَنتَظِرُ",29,"ر",1,1],["هَل عَقَّ مَنبِتَهُ أَو خانَ أُمَّتَهُ","إِلّا اِمرُؤٌ مالَهُ دينٌ وَلا خُلُقُ",30,"ق",1,0],["هل عِندكم أنْ تغشَّتْكُم سَرِيَّتُهُ","للسَّيفِ سَيْفٌ ولِلضِرغَامِ ضِرغامُ",31,"م",1,0],["هل عهد إبراهيم غير صحيفة","قد أشرقت بالعِلْيَة الأَمجادِ",32,"د",1,0],["هَل عَدَتنا ظَعينَةٌ تَطلُبُ العَزْ","زمِنَ الناسِ في الخُطوبِ المَواضي",33,"ض",2,0],["هَل عَرَفتَ الرَبعَ أَجلى","أَهلُهُ عَنهُ فَزالا",34,"ل",2,1],["هَل عَلى عاشِقٍ خَلا بِحَبيبٍ","في اِلتِزامٍ وَقُبلَةٍ مِن جُناحِ",35,"ح",1,0],["هَل عاجِلٌ مِن مَتاعِ الحيِّ مَنظورُ","أَم بَيتُ دومَةَ بَعدَ الإِلفِ مَهجورُ",36,"ر",1,1],["هَلْ عَلَيَّ وَيْحَكُما","إنْ لَهَوْتُ مِنْ حَرَجِ",37,"ج",1,0],["هَل عي فيك عَن البَيان لسانه","أَم هَل لذاكَ السيف بعد مضاء",38,"ا",2,0],["هلعت قلوب القوم في اليابانِ","للبحر حين طغى وَللنيرانِ",39,"ن",1,1],["هَلْ عَاشِقٌ نَالَ مِنْ دَهْمَاءَ حَاجَتَهُ","في الجَاهِليَّةِ قَبْلَ الدِّينِ مَرْحُومُ",40,"م",1,0],["هَلْ عَلى سَالِمِ النَّوَاظِرِ بَأسٌ","مِنْ غِشَاءٍ يَكون فِي المَنْظورِ",41,"ر",1,0],["هَلْ عَجَبٌ فِي عِيد تنصِيرِهمْ","عِنْدي لَهُ أَبْهَجُ أَعْيَادِي",42,"د",2,0],["هَلْ عَجِيبٌ أَنْ يَجْمَعَ الشَّرْقَ وَالغَرْ","بَ مُصَابٌ فِي الْعَبْقَرِيِّ الْفَرِيدِ",43,"د",1,0],["هَل عادَةُ المُشتاقِ لَيلَةَ عيدِهِ","وَصَباحِهِ إِلّا بُكاً وَرَسيسُ",44,"س",1,0],["هل على المفجوعِ في أوطانِه","حَرَجٌ إنْ ردّد الشكوَى وبَاح",45,"ح",1,0],["هل على الهاتفِ بالحسن إذا","ما شدا من حَرجٍ أو عَتَب",46,"ب",1,0],["هل علمتم أنَّ مَنْ واريتُمُ","في حَنايا كلِّ مصريٍ دفين",47,"ن",1,0],["هل عيون الأديب نهر لهيب","أم عيون الأديب نهر أغاني",48,"ن",2,0],["هل عند أنْمُلَةٍ تُحَرِّكُها","باللطفِ إنَّ الدمعَ بالأثر",49,"ر",1,0],["هل عند أنجمك الضواحك ما بي","يا ليل إشراكي وصبح متابي",50,"ب",2,1],["هَل عاقَها ما عايَنَتهُ فَلَم تَسِر","أَم راقَها هَذا الجَنابُ المُمرِعُ",51,"ع",1,0],["هَل عِندَ مَنزِلَةٍ قَد أَقفَرَت خَبَرُ","مَجهولَةٍ غَيَّرَتها بَعدَكَ الغِيَرُ",52,"ر",1,1],["هل علموه فصار يهجرني","رب خذ الحق من معلمه",53,"ه",1,0],["هَل عندَ ذاك السِربِ أَنّا بعدَه","في الحَيِّ مِن آماقِنا نَتَدَفَّقُ",54,"ق",1,0],["هل عائد زمن تضوع نشره","أرجا ورقت بالرضى أسحاره",55,"ر",2,0],["هل عائد لي والمُنى ضلّةٌ","ظلٌ وورد سائغ ريّق",56,"ق",1,0],["هَل عَيشُنا بِلوى الأُجَيرِعِ راجِعٌ","وَمَواقِف قَضَّيتُها في لَعلَعِ",57,"ع",1,0],["هَل عائِدٌ وَالأَماني غَيرَ صادِقَةٍ","أَسحارُ وَصلٍ قَضَيناها وَآصالُ",58,"ل",1,0],["هَل عند مُعتَدِلِ القَوامِ لعاشِقٍ","عَدلٌ وَهَل عِندَ الجميلِ جَميلُ",59,"ل",1,0],["هل عذابي في ملامٍ","أم ملامي في عذابي؟",60,"ب",2,0],["هَل عرس الظاعن المشيم","بالابرق الفرد يا نَسيم",61,"م",1,1],["هَل عهدهم عهدهم بنجد","باق أَم استؤمنوا فَخانوا",62,"ن",3,0],["هَل عطفة منك يا مَولاي تبلغني","منك المراد فَفيك البر مأمول",63,"ل",1,0],["هَل عطفه بجلية حكمية","نبوية صمدية لي منكما",64,"م",2,0],["هَل عندكم علم عَن العلمين أَو","عَن معهد بالرقمتين خراب",65,"ب",1,0],["هَل عِندَ عَمرَةَ مِن بَتاتِ مُسافِرِ","ذي حاجَةٍ مُتَرَوَّحٍ اَو باكِرِ",66,"ر",1,1],["هَل عَهدُ سُعدى كَما قد كان أَم خَفَرت","عهدَ الأَحِبَّة تلك الغادة الخَفِرَه",67,"ر",2,0],["هل عراه طائفٌ من جنةٍ","ليتَ شعري أَم به مسُّ جنون",68,"ن",1,0],["هل على الأرض ناسك عبد الله","ولم يشغل الجمال فؤاده",69,"د",2,1],["هَل عَرَفت الهَوى فَقُلت وَهَل أَن","شَد في غَير فنه ميخانَه",70,"ن",2,0],["هَل عَلى غَير بَيتِهِم نَزل الوَحي","بِجِبريل خادِما مَأمورا",71,"ر",2,0],["هل عنْدَ حَيِّ العامريّةِ قُدرةٌ","أنْ يَفْعلوا فوقَ الَّذي فعلَتْ بنا",72,"ن",2,0],["هل عُصبةُ الإشراكِ تَعلَمُ أَنّها","ما صادَفَتْ من حَدِّ سيفِكَ مأْمَنا",72,"ن",2,0],["هَل عَلَّمَت لَقطَها لِلحَبَّ لَهذَمَها","أَما تَراهُ لِحَبِّ القَلبِ قَد لَقَطا",73,"ط",2,0],["هَل عَرَفْتَ الدارَ أَمْ أَنكَرْتَهَا","بَيْنَ تِبْرَاكٍ فَشَسَّيْ عَبَقُرّْ",74,"ر",1,0],["هل عَلمَ النَّدمانُ لما سُقوا","ما أكسبَ الصَّهباءَ ساقِيها",75,"ه",2,1],["هل عند خُطَّاب العُلى أنني","وكيلُها في طَلب المَهرِ",76,"ر",1,0],["هَل عِندَ غانٍ لِفُؤادٍ صَدِ","مِن نَهلَةٍ في اليَومِ أَو في غَدِ",77,"د",1,1],["هل عندهم عن لوعتي","خبر وهل علموا بأني",78,"ن",2,0],["هل عساها تعود يوماً من الده","ر وتفدى من عمرنا بالبواقي",79,"ق",2,0],["هل عَرَفْتَ الدّيارَ من آل ميٍّ","بعد أن أصْبَحَت طلولاً رماما",80,"ا",1,0],["هل عَلِمْتم بعدما قوَّضتمُ","أنَّ لي من بعدكم نوح الحمام",81,"م",1,0],["هلْ علمْتُمْ في بينكم أنَّ عيني","لم تذق بعدكم لذيذ الرقاد",82,"د",1,0],["هلْ عَجِبْتُمْ والحبُّ أمرٌ عجيبٌ","كيفَ يَستعذبُ العذابَ المهينا",83,"ن",2,0],["هل علمتم أنَّ أحداق المها","خلقت حينئذٍ سحرَ العقول",84,"ل",1,0],["هَل عَرَفْتَ الديار من آل نُعمى","ومحلاًّ عفى لبين ألمَّا",85,"م",2,1],["هل علم الدهر الذي أساءني","أيّ أخي عزم وذي فضل قلى",86,"ا",1,0],["هل عائد لي زمنٌ عبرة بذي الغضا","وهل يريني الدهر ما كنت أرى",86,"ا",1,0],["هل على العهد تراها باقيه","بعدنا أم هل أضاعت عهدنا",87,"ن",2,0],["هل عادَ قلبِيَ بِرْجاساً تُقَارِضُه","نَبْلُ النَّوائبِ عن إِنْبَاضَةِ الزَّمَنِ",88,"ن",1,0],["هل عرفتَ الدارَ قفراً","تتراءى كالسّرابِ",89,"ب",1,0],["هل عندَ ليلِ الشعرِ أني نائمٌ","ولصَبوَتي طرفٌ عليه مسهَّدُ",90,"د",1,0],["هل عامل أعمالها فيرى جزا","أعمالها يوم الجزا عمالها",91,"ل",3,0],["هل عازم أنت طمس بقعتنا","من صفحة الأرض عزم مفترق",92,"ق",1,0],["هل على وجه الثرى من لغة","أحدثت في مسمع الدهر صدى",93,"د",2,0],["هل عند هذا الطلل الماحِلِ","من جلَدٍ يُجِدي على سائلِ",94,"ل",1,1],["هل على باب الأحاظي آذنٌ","أم إلى جاري المقاديرِ رسولُ",95,"ل",1,0],["هل عند ظبي المنحنى","من جائدٍ فيُسألا",96,"ل",2,0],["هل عند ريح الصَّبا من رامةٍ خبرُ","أم طاب أن صاب روضاتِ اللّوى المطرُ",97,"ر",1,1],["هل عند عينيك على غُرّبِ","غرامةٌ بالعارضِ الخُلَّبِ",98,"ب",1,1],["هل عائبٌ للشمس غبيةُ ليلةٍ","أو منكرٌ للبدر أن يتحجّبا",99,"ب",2,0],["هل عند ساكنة الغضا من أضلعي","علمٌ وقد شبّت بها جمرَ الغضا",100,"ض",2,0],["هَل عِشتَ إلا لِهذا؟..أو لأنبَلَ مِن","هذا ؟..فأيَّ اضطِرابٍ كنتَ تَضطربُ؟!",101,"ب",1,0],["هَل عَيشُنا بِكَ في زَمانِكَ راجِعٌ","فَلَقَد تَقاعَسَ بَعدَ