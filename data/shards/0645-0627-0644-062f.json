{"poems":[[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[259,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[264,"إن قلبي لديغ رقط الفراق","https://www.aldiwan.net/poem35937.html","الخفيف"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[463,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[463,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48559","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64079","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59690","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56176","الرمل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105226","الرمل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31494","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109773","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76062","المديد"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201793","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112535","الرمل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123901","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118000","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86381","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73142","المديد"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83556","الخفيف"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117190","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66152","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66096","الرمل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113832","الخفيف"],[5160,"قد مضينا","https://www.poetsgate.com/ViewPoem.aspx?id=175137",""],[5376,"زانت الحرف في الهوى حسناء","https://www.poetsgate.com/ViewPoem.aspx?id=191837",""],[5376,"قفْ على الأطلالٍ شوقاً وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=202346",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5533,"يا شَهيداً","https://www.poetsgate.com/ViewPoem.aspx?id=176720",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5846,"رجاء..","https://www.poetsgate.com/ViewPoem.aspx?id=123430",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5956,"تركيبة معظم حكامنا","https://www.poetsgate.com/ViewPoem.aspx?id=192217",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6124,"ما لدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=159897",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["ما لدى اللاّتِ أو مُناة أو العز","زى غَنَاءٌ لمن يَقيسُ الأمورا",0,"ر",2,0],["ما لِدُيوني فيكَ مَمطولَةً","أُقضى وَلا تُقضى المَواعيدُ",1,"د",1,0],["ما لدمعي حائر وشْ","مٌ صريحٌ فوق خدي",2,"د",2,0],["ما لدائي من التنائي دواءٌ","غير قرب اللقا وطيب التلاقي",3,"ق",2,0],["ما لدهري قضَى الفراقَ عليها","عذَّبَ اللّهُ بالفراقِ الدهرا",4,"ر",2,0],["ما لدليلٍ نَصَلَتْ ركابُهُ","من الدجى حاملةً شمسَ الضحى",5,"ا",1,0],["ما لدماء الحبِّ مطلولةً","أهكذا فيهنّ دِين الدُّمى",6,"ا",1,0],["ما لداري منك مقفرةٌ","وضميري منك مأهول",7,"ل",1,0],["ما لديكم من سلاح وادأبوا","واعلموا كيف الوغى والمضربُ",8,"ب",1,0],["ما لداليَتي التي حسد الشا","مَ عليها جميعُ أهل العراق",9,"ق",1,0],["ما لدمعي كالعنم","وجفوني لم تنم",10,"م",1,1],["ما لدمعي يسقى به ورد خديك","ومرعاه فوق خدَّي جديب",11,"ب",1,0],["ما لديوان المعالي","والمفاخر من نظير",12,"ر",1,1],["ما لدهر كلما سالمته","أعقب السلم بأشجان وبلوى",13,"و",2,0],["ما لِدُبَيَّةَ مُنذُ العامِ لَم أَرَهُ","وَسطَ الشُروبِ وَلَم يُلمِم وَلَم يَطِفِ",14,"ف",1,1],["ما لِدهري قد مال عنِّى فعنَّا","ني بزارٍ مشاغبٍ نَبَّازِ",15,"ز",1,0],["ما لدهري في الحادثات ومالي","لم يدعني يوماً براحة بالِ",16,"ل",1,1],["ما لِدَمعي ساجِماً كَالغَمام","وَلجسمي ناحِلاً بالسقام",17,"م",1,1],["ما لدينا إلا إليك التجاء","يا إلهي ان خاننا العلماء",18,"ا",2,1],["ما لدى المحنة بدٌ من أسى","يبعث الموتى ليرثوا للحزين",19,"ن",1,1],["ما لدائي اليوم من ط","بّ ولو عاش الجُبَيلي",20,"ل",2,0],["ما لدهر السوء مغرى بالغواني","غِرة يغزو ضعيفات الجنان",21,"ن",1,1],["ما لدمعي في تعاطي ذكركم","لارتياح ما جرى إلا جرى",22,"ر",2,0],["ما لدُرِّ الثَّغرِ منه سِوَى","ذَلكَ الَمرجانِ من صَدَفِ",23,"ف",1,0],["ما لِدارِ التَقريبِ تَدنو وَتَنأى","عَن مُحِبٍّ لَها تَشطُّ مَزارا",24,"ر",2,0],["ما لدُنيا تجفوكَ والذنبُ منها","إنّ هذا منها لخَبٌّ ومكرُ",25,"ر",1,1],["ما لَدَيْها إِلاّ الغلاَمَ رَجاءٌ","تَرْتَجِيهِ أَو مَوْئِلٌ أَوْ عَمِيدُ",26,"د",1,0],["ما لَدَيْنا للعِدَى غيرُ الْعَوالْ","وسيُوفٍ في الوغَى بِيضٍ حِدادْ",27,"د",1,0],["ما لداء الهوى سوى ذاك طب","للمشوق السقيم بعد اعتدال",28,"ل",1,0],["ما لدُنيا قدْ عَمِلنا","نبتغي دارَ الخُلودْ",29,"د",1,0],["ما لداء الأهواء عندي دواء","وهوى بالعشاق ليس يشاء",30,"ا",2,0],["ما لدعواي مكانٌ عندها","بدريَ الوضَّاء ليلا قد أفلْ",31,"ل",1,0],["ما لدنيا الملك اظلم","مت وقد كانت مضيه",32,"ي",2,0],["ما لِدُنْيا أَنْتَ سَاعٍ","بَلْ لقَرْعٍ بالحِرابْ",33,"ب",1,0],["ما لدمعي بعدكم ما صدقا","لو صدقناه لآذى الحدقا",34,"ق",2,1],["مالِدُنيانا بلا بُشرى..غدت","كلّما لاحت يُواريها الرَّدى!!",35,"د",2,0],["ما لديهم عملٌ حرُّ القوَى","مستقلٌّ مستميتٌ في السَّنا",36,"ن",2,0],["ما لديها أي وعي ثاقبٍ","يحرم المحتلَّ من كل المنى",36,"ن",2,0],["ما لديهم أي فعل، رُبَّ سُمٍّ","منهمُ أنفعُ يسقي المذنبا",37,"ب",2,0],["ما لِدَهرِي عَلَيَّ حُكْمٌ فَأُعطِي","هِ يَدَيْ طَاعَةٍ ولا استِذْلاَلا",38,"ل",2,0],["ما لدمعي قد جرى درًّا سخينا","عندما بانتْ سعادُ",39,"د",1,1],["مالدِّينُ إِلاّ هَوَىً في نَفسِ عاشِقِهِ","وَمَن يَبُح بالهَوى يَومَ النَّوى ييُلَمِ",40,"م",1,0]]}