iwan/poem/79867","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69413","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109346","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130757","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93886","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93798","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127389","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201751","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141601","البسيط"],[4718,"الصاحب الساحب","https://www.poetsgate.com/ViewPoem.aspx?id=137159",""],[4883,"والشجرة أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=48376",""],[5198,"الممكن المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=135392",""],[5749,"ماشي غير اجي وقول تنحب بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=180732",""],[5970,"سر هذا الدهر قد أعيا طلابي","https://www.poetsgate.com/ViewPoem.aspx?id=130576",""],[5970,"إيه يا دنيا اخدعي من تخدعين","https://www.poetsgate.com/ViewPoem.aspx?id=130579",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["سَرَّهُ شُكرِيَ إِذ عافى وَلَم","يَدرِ ما غايَةُ صَبري فَابتَلى",0,"ل",2,0],["سره وحيه فلم يأل جهداً","وأبى العجز أن يتم السرور",1,"ر",1,0],["سَرَّهُ مِن أُسامَةَ البَطشُ وَالفَت","كُ فَسَمّى وَليدَهُ بِأُسامَه",2,"م",2,0],["سَرَّهُ جَمعُ شَملِهِ بِلِقاهُمُ","فَقَضى حادِثُ الزَمانِ شَتاتَه",3,"ت",2,0],["سَرَّهُ ذِكرُهُم وَقَد ساءَهُ اللَو","مُ فَأَحياهُ عَذلُهُم وَأَماتَه",3,"ت",2,0],["سرَّه أنَّ كلَّ حسن له الشعرُ","تبيع فالمجدُ حسنٌ وشعرُ",4,"ر",1,0],["سرّه أن هبَّ من أبنائِه","قُضُبُ الهند وآسادُ الأَجَمْ",5,"م",1,0],["سَرَّهُ أن أطلقَ الشركُ بها","من نفوسٍ حُرّةٍ ما قَيَّدا",6,"د",2,0],["سَرَّهُ اللَهُ حَيثُ كانَ فَما كا","نَ أَسَرَّ الدُنيا بِهِ وَأَلَذّا",7,"ذ",2,0],["سِرُّ هَذَا المَزَاجِ وَهْوَ جَدِيدٌ","إِنَّ فِيهِ لِلشَّرْبِ طِيبُ العَتيِقِ",8,"ق",1,0],["سَرَّهُ جُهْدُهُ فَلَمْ يَأْلُ جُهْداً","وَأَبَى العَجْزَ أَنْ يَتِمَّ السُّرُورُ",9,"ر",1,0],["سَرَّهُ حالُهُ وَكَثرَةُ ما يَم","لك وَالبَحرُ مُعرَضاً وَالسَديرُ",10,"ر",1,0],["سره عزما كتمنا","فافشى سرنا",11,"ن",2,0],["سِر هَنيئاً واِذكر هناكَ اِحتياجي","يا شَفيعاً تحتاجهُ الشفَعاءُ",12,"ا",2,0],["سِرُّهُ في الحَشا عَن الخلقِ مَستورٌ","مَستورٌ فَماذا عليه في هَتكِ سِتري",13,"ر",2,0],["سرَّها ما تزيَّنتْ ولأمرٍ","ساءها عجَّلوا عليها السرورا",14,"ر",2,0],["سَرَّها ما عَلِمتْ من خُلُقي","فأرادتْ عِلمَا ما حَسَبي",15,"ب",2,0],["سرُّ هذا الكون في طي العما","نوره المحض الذي لاح جماله",16,"ل",2,0],["سِرُّ هذا الكَوْنِ مِضْمارُ العَما","نقطَةُ الأسلوبِ رُوحُ السُّعَدَا",17,"د",2,0],["سره دب في القلوب فهامت","عندما شاهدت بها سريانه",18,"ن",2,0],["سرها ظاهر بها وخفيٌّ","وهي مدح طوراً وذم ولمز",19,"ز",1,0],["سِرُّهُ فيمَا انْتَحَى من أمرِه","حَسَنُ القَصْدِ مُسَاوٍ للعَلَنْ",20,"ن",1,0],["سره أن أكون فيه حزيناً","فسروري إذا تضاعف حزني",21,"ن",2,0],["سرها يشرح معنى","ادخلوها بسلام",22,"م",1,0],["سره عليه وكم فيه غيب","فيه ذكر يريك عين الجمال",23,"ل",1,0],["سِرُهُم في الكَون دَومي","حُبُهُم راس الشِفا",24,"ف",2,0],["سرَّهمُ سرورُه كأنَّما","لديهم بشراهُ من أعلى المِنن",25,"ن",1,0],["سَرَّها أَنَّها تَسُرُّكَ بِالنَش","وَةِ حَتّى تَبَسَّمَت في القَناني",26,"ن",2,0],["سرُّهُ في المقالِ أنْ كانَ جهراً","لم أفضِّلْهُ عن طنينِ الذباب",27,"ب",1,0],["سرها في خاطري في مسمعي","لك فضل واياد وهمم",28,"م",1,0],["سرُّهُ في القلوبِ دَبَّ دبيباً","كدبيب النعاسِ في الأجفانِ",29,"ن",1,0],["سرِّ هذا الجمال والروض زاهٍ","زاهر فيه زهره البسّام",30,"م",1,0],["سرهم دائما يناديك أن رِدْ","بحر جدوى ندايَ في كل نادي",31,"د",2,0],["سره إن كان سر عسكره","ورمى القرن فنادى يا رمان",32,"ن",1,0],["سرهم سار إلى من دونهم","فسناهم مظهر السرين",33,"ن",1,0],["سره في الروح والروح اختفى","خلف ستر الغيب ما أجهلني",34,"ن",2,0],["سرُّه ملكية قد وهبت","بعضَنا فقراً وبعضاً ترفا",35,"ف",2,0],["سر هذا البؤس أني شاعر","قد أفاد الدهر منى عبقريّا",36,"ي",2,0],["سَرَّ هذا الحَدِيثُ كُلَّ فَرِيقٍ","رَغبَةً في ادِّراءِ ذا الحَدثانِ",37,"ن",1,0],["سرٌه أنه على القلب قلب","مستهام يتلو جواه ويُتلى",38,"ل",2,0],["سرهدته بيدي كالطفل من شفق","كالطفل من شفق سرهدته بيدي",39,"د",2,0],["سره منيع وفي ظروفك يراعي","قدره رفيع وعنده الطيب ماضاع",40,"ع",1,0],["سرّها الظل، يعني نايفة","قلبها العشق، يعني ف ازدهار!",41,"ر",1,0],["سرّها في حدود الممكن المستحيل","سرّها لين عند القوم يُحْمد سراك",42,"ك",1,0],["سر هواها يعرفو لعادي ولبادي","فعيون الناس ولجبين مكتوب هواها",43,"ا",3,0],["سر هذا الدهر قد أعيا طلابي","هل لنفسي أو لغيري من جواب",44,"ب",1,1],["سر هذا العيش أن يقضي وما","فتقت أسراره للعالمين",45,"ن",1,0],["سر هذا العيش أن تشقي به","وتحب العيش حب المغرمين",45,"ن",1,0],["سر هَذا الوجود قَد أَودَعته","في حَريز ائتمانها فوعته",46,"ه",1,0]]}