{"poems":[[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"ياسين إنك بالقلوب مشيع","https://www.aldiwan.net/poem44806.html","الكامل"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[91,"قال السماء كئيبة وتجهما","https://www.aldiwan.net/poem62735.html","عموديه"],[92,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[106,"حرب الرذيلة","https://www.poetsgate.com/ViewPoem.aspx?id=179641",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["أَو غَرَضٍ أَصبَحَت خَواطِرُنا","تُساقِطُ الدُرَّ مِنهُ في الكُتُبِ",0,"ب",1,0],["أَو غادَةٍ كانَت تُريكَ إِذا بَدَت","شَمسَ النَهارِ فَأَصبَحَت كَالآلِ",1,"ل",1,0],["أو غدا الحسن شاعراً ينظم الحبّ","قريضاً أبدى بها التشبيبا",2,"ب",2,0],["أو غيّبوك فإن أمرك حاضر","أو ثبطوك فإن جيشك مسرع",3,"ع",1,0],["أو غدا جائداً كجودك فينا","كانَ كل الأوقات أعياد عامهْ",4,"م",2,0],["أَو غادَةٍ مَسلولَةٍ مُحتاجَةٍ","لِدَمٍ وَتَنفُثُ كُلَما لَهَثَت دَما",5,"م",2,0],["أَو غصوناً أَحنو عليكِ بأَوراقي","حُنُوَّ المدَلَّهِ المتبولِ",6,"ل",1,0],["أَو غيضَ بَحرٌ فَذا بَحرٌ بِمَوضِعِهِ","لِوارِديهِ نَميرٌ ماؤُهُ خَصِرُ",7,"ر",1,0],["أو غازيًا فتح المما","لك عنوةً بمهند",8,"د",1,0],["أو غرَّرت بالعالمين مبادئٌ","تُزْري بإفكِ مُسَيلمٍ وسَجَاجَ",9,"ج",1,0],["أو غارِقٌ مع خالدٍ أو طارقٍ","في الحَرْب بين صَوارمٍ وعوالي",10,"ل",2,0],["أوغَلتُ في أحراجه وكأنني","أصبحت أولَ مرَّةٍ فنّانا",11,"ن",2,0],["أو غَديرٍ جمِّ المساربِ عذبٍ","حَرمَّوه وحلَّلوا شُطْئَانه",12,"ن",2,0],["او غدا الحسن شاعرا ينظم العشق","قريضا ابدى بها التشبيبا",13,"ب",2,0]]}