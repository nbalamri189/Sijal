83915",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5082,"قَبسٌ من ثنيّاتِ الضّياء","https://www.poetsgate.com/ViewPoem.aspx?id=213052",""],[5106,"لَوْ كانَ لي ..","https://www.poetsgate.com/ViewPoem.aspx?id=147584",""],[5150,"العاشقه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204341",""],[5274,"البردوني وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=203259",""],[5376,"أيها الغاصب ....إنها القدس","https://www.poetsgate.com/ViewPoem.aspx?id=188543",""],[5431,"أوغلت بالعشقِ","https://www.poetsgate.com/ViewPoem.aspx?id=183052",""],[5431,"لانهائي العشقِ منك ابتداءُ..","https://www.poetsgate.com/ViewPoem.aspx?id=197606",""],[5431,"إلى أختي أميمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=206056",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5612,"مكاشفة","https://www.poetsgate.com/ViewPoem.aspx?id=185750",""],[5674,"أمشي ودربي غائرة","https://www.poetsgate.com/ViewPoem.aspx?id=186057",""],[5674,"أمشي ودربي عاثرة","https://www.poetsgate.com/ViewPoem.aspx?id=187634",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5829,"آفة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=175412",""],[5956,"أوغلتَ في المنأى","https://www.poetsgate.com/ViewPoem.aspx?id=194277",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6006,"قيامة","https://www.poetsgate.com/ViewPoem.aspx?id=214147",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""]],"verses":[["أَو غَرَضٍ أَصبَحَت خَواطِرُنا","تُساقِطُ الدُرَّ مِنهُ في الكُتُبِ",0,"ب",1,0],["أَو غادَةٍ كانَت تُريكَ إِذا بَدَت","شَمسَ النَهارِ فَأَصبَحَت كَالآلِ",1,"ل",1,0],["أو غدا الحسن شاعراً ينظم الحبّ","قريضاً أبدى بها التشبيبا",2,"ب",2,0],["أو غيّبوك فإن أمرك حاضر","أو ثبطوك فإن جيشك مسرع",3,"ع",1,0],["أو غدا جائداً كجودك فينا","كانَ كل الأوقات أعياد عامهْ",4,"م",2,0],["أَو غادَةٍ مَسلولَةٍ مُحتاجَةٍ","لِدَمٍ وَتَنفُثُ كُلَما لَهَثَت دَما",5,"م",2,0],["أَو غصوناً أَحنو عليكِ بأَوراقي","حُنُوَّ المدَلَّهِ المتبولِ",6,"ل",1,0],["أَو غيضَ بَحرٌ فَذا بَحرٌ بِمَوضِعِهِ","لِوارِديهِ نَميرٌ ماؤُهُ خَصِرُ",7,"ر",1,0],["أو غازيًا فتح المما","لك عنوةً بمهند",8,"د",1,0],["أو غرَّرت بالعالمين مبادئٌ","تُزْري بإفكِ مُسَيلمٍ وسَجَاجَ",9,"ج",1,0],["أو غارِقٌ مع خالدٍ أو طارقٍ","في الحَرْب بين صَوارمٍ وعوالي",10,"ل",2,0],["أوغَلتُ في أحراجه وكأنني","أصبحت أولَ مرَّةٍ فنّانا",11,"ن",2,0],["أو غَديرٍ جمِّ المساربِ عذبٍ","حَرمَّوه وحلَّلوا شُطْئَانه",12,"ن",2,0],["او غدا الحسن شاعرا ينظم العشق","قريضا ابدى بها التشبيبا",13,"ب",2,0],["أو غادةَ غَرّاءُ وا","ضحة الترائبِ والقناعِ",14,"ع",1,0],["أوغلتُ في خوض الهوى أنَفاً","للقلب أن يبقىَ بلا شُغلِ",15,"ل",1,0],["أو غادةٍ تُسْفِر من نِقاب","شَفٍّ كماءٍ راقَ في ثِعاب",16,"ب",1,0],["أَو غادَةٍ شَقَّت صِداراً أَزرَقاً","ما بَينَ ثُغرتها إِلى الأَقرابِ",17,"ب",1,0],["أو غاصتِ الشمسُ تحتَ اللجِّ هاربةً","فما على الناسِ من همٍّ وأكدارِ",18,"ر",1,0],["او غبتم عن ناظري فخيالكم","ابدا بقلبي لا يزال مخيلا",19,"ل",2,0],["أَو غَليمُ الثاني عَلى عَرشِهِ","اللَهُ مِن سَطوَتِهِ أَكبَرُ",20,"ر",1,0],["أَو غسَّلوكَ فَلَن تَزال مُطَهّر ال","أَقوال والأَفعال والأَوصافِ",21,"ف",1,0],["أَو غادَةٌ رؤدٌ غدائِرُها","لَيلٌ وَضوءُ جَبينها فَجرُ",22,"ر",1,0],["أَو غادَةٌ هَيفاءُ مَجدُولَةٌ","قد أَثمرَت قامَتُها بالنُهود",23,"د",1,0],["أو غدرت ورق الحمى","فوق الغصون من الشجر",24,"ر",1,0],["أو غرد الركب الخلي بطيبة","حنوا لمغناها حنين النيب",25,"ب",1,0],["أو غويٌّ تضجُّ منه السماوا","تُ مريدٌ إلّا على الشيطان",26,"ن",1,0],["أو غاية في الجدِّ أدرَكَ غايةً","مِثلي مُعانيه ومثل القاضي",27,"ض",2,0],["أو غازل الغنج في الأجفان ادعجها","وافترّ ثغرٌ يعاطي درُّهُ اللعسا",28,"س",2,0],["أَو غارَ من أَعيادِنا بِكَ فالْتَوَى","بمداهُ حَتَّى كادَ يلحَقُهُ الوَنى",29,"ن",2,0],["أَو غُرَّةٍ جُعِلَتْ لِسَيْفِكَ غرَّةً","إِن لَمْ تَخِرَّ إِلَى جَبينِكَ ساجدَهْ",30,"د",2,0],["أو غِبَّ حمّامٍ فإِنْ تكُ حاذِقاً","جُنِبتَها بتعاقبِ الأجيالِ",31,"ل",1,0],["أو غَدتْ عُطْلاً حَشايا سُرُرٍ","وقَرا الطِرْفِ فانَّ الرَّمْسَ حَالي",32,"ل",2,0],["أو غدتْ مشبهةً مِن لوعتي","نارَها حَرّاً ووَقْداً وضِراما",33,"م",2,0],["أو غمامٍ هو بالما","ءِ الذي فيه دَلوُحُ",34,"ح",1,0],["أو غِبتَ عن نَظَرٍ فقد خلَّفتَ بالتْ","تَأْريخِ ذِكراً في القُلوبِ مُخلَّدا",35,"د",2,0],["أو غير الصلاة عن أوقاته","أو حوّل الفروض عن جهاتها",36,"ه",2,0],["أَو غَفِل الحارسُ في ال","جنَّة حتى سُرِّقَتْ",37,"ت",1,0],["أَو غَدا صالح يَقول اِبتِكاراً","لَكَ في محفل سَما فُضَلاه",38,"ا",2,0],["أَو غَدا صالح يَقول اِبتِكاراً","لَكَ في محفل الرضا وَالتَهاني",39,"ن",2,0],["أَو غَدا قائِلاً لَك السَعد أَرّخ","بِكَ يَزهو الدِيوان يا ذا الفَقار",40,"ر",1,0],["أَو غَدا قائِلاً لي السَعد أَرخ","أَشرَق العيد باجتهاد سَعيد",41,"د",1,0],["أَو غَدا يُنشد قَولي","لِلخديوي كُلُّ قَولِ",42,"ل",1,0],["أو غَاص في الأرض عليهِ نبشا","يسفرُ بقايا اللّيل فيه نمشا",43,"ش",2,0],["أوغى يد الدهر من أحداثه شرفاً","والسيف يمضي مراراً ثم ينقصد",44,"د",1,1],["أو غيورٍ عزمُهُ يَتَّقِدُ","يدرك العون به من يستعين",45,"ن",1,0],["أو غير أقمار السما","سجدت لأقمار الرَّغامْ",46,"م",1,0],["أو غير أغصان الفلا","خضعت لربّات القَوامْ",46,"م",1,0],["أو غادة لبست غريب حلتها","من غير ما حزن منها ولا حرب",47,"ب",1,0],["أو غازلت طرف الغزالة في الضحى","لهوت إليها من محل أرفع",48,"ع",1,0],["أو غاصب متجاسر لم يثنه","عن همّه حد العوالي الشرّع",49,"ع",1,0],["أوغابة قحلاء لا","تحوى سوى شر الأُسود",50,"د",1,0],["أَو غصن بان تثنى","بالريح أزمخشليل",51,"ل",1,0],["أو غصن بان حركته صباً","فاهتز في ورق له نضر",52,"ر",1,0],["أو غادةٌ كلما ماجت روادفها","هزت معاطفها غصناً على علم",53,"م",1,0],["أو غادة فُنُقٌ كأن جبينها","فلقٌ وفاحم شعرها ديجور",54,"ر",1,0],["أو غردت ورقاء رامة هزها","حيٌّ هناك بذي الأراك حلول",55,"ل",1,0],["أو غادة غصنيّة دعصيّة","صبحيّة والليل منها أليل",56,"ل",1,0],["أو غير انتمائنا بولاكم","سبب لارتمائنا ببلاها",57,"ا",3,0],["أَوغدٌ يَسود وَفَردٌ يَعود","وَفي نَفسِهِ اليَأس إِما غَسَق",58,"ق",1,0],["أو غاب سقي الراح عنك ومستقي","ه أبيتُ وحدي المستقي والساقي",59,"ق",2,0],["أو غصن بانٍ لم يَمِلْ مِنَ الطَّرَبْ","معتدلٌ لهُ لسانٌ من ذَهَبْ",60,"ب",1,0],["أو غَيرِه فَيُقالُ هَذَا باطِلٌ","وَعَلَيكُمُ فِي ذَاكَ مَحذُورَانِ",61,"ن",1,0],["أَو غُصنُها المُتَثَنّي","أَو ذَلِكَ الرَجراجُ",62,"ج",1,0],["أوغلت في السرى ومذ ضل عنها","في زحام الحياة قصد المقام",63,"م",1,0],["أو غوالٍ في لآلٍ","أو غشاءٌ بينَ فَجرِ",64,"ر",1,1],["أو غصوناً نواعِماً تتهادى","أو فُرُوعاً على أصُولِ مِلاحِ",65,"ح",1,0],["أوغرّهم ليني فسمى ناقع","تاللَه لا تخطى سهام دعائي",66,"ي",1,0],["أَوْ غارَ من هممي فأَنْحى شأْوَها","فَلَكَ البُرُوجِ مُغرِّباً ومُغَوِّرا",67,"ر",2,0],["أَوغَلَ العَبدُ في العُقوبَةِ وَالشَت","مِ وَأَودى بِطارِفي وَتَليدي",68,"د",2,0],["أو غرة في وجه فحل أدهم","أو باقة من نرجس للمتعة",69,"ه",1,0],["أو غرد الطير في الأحرش من طرب","أو حرقة لغدت تؤسيه آهاتي",70,"ت",2,0],["أو غرك البيت الذي في ضريه","سود ترى أعرابها منصوصا",71,"ص",2,0],["أو غرّدت فعقُولُ القومِ ذاهِلَةٌ","كانما شرِبُوا من بِنتِ عنقُودِ",72,"د",1,0],["أَو غَدا بالنوقِ غادي","نَحوَ سَلعٍ أَو قُباءِ",73,"ا",2,0],["أوغلت عمقاً عمن أخاطبه","فحين أتلومخاطبي غائب",74,"ب",1,0],["أو غصون قطعت من دوحة","كيف بعد الدوح عيش الغصن",75,"ن",1,0],["أَو غصن تاه بجلنار","فَجئته أَسعى بجل ناري",76,"ي",1,0],["او غيره فلك التخيبر في سكن","وان دعت حاجة الا خدام فاختدم",77,"م",1,0],["أو غابَ شخصك يا محمّد عنوة","فعُلاك في أبصارنا يتجسّمُ",78,"م",1,0],["أو غاص في لج بحر العلم مجتلياً","غوامض الكون تعميماً لجدواها",79,"ا",3,0],["أوغلت في قطع الصله","ترك العتاب الحمد له",80,"ل",2,1],["أَو غالَها الساطي فدك","كَ لَها المعاقل وَالحُصونا",81,"ن",2,0],["أوغلت في المغرب الأقصى وأعجزني","نيلُ الرغائب حتى أبت بالندم",82,"م",1,0],["أو غافلٌ عنك مُستريح","إليه شَكواك لا تُفيد",83,"د",1,0],["أو غصب الغاصب ميراثها","فهو نفاقاً يظهر الاعتذار",84,"ر",1,0],["أو غادة ماست جلابيبها","محمرة أو ضمخت في جساد",85,"د",1,0],["أو غاض ماء البشر منه فمن له","بمَعين بشر في الصبا متفجر",86,"ر",1,0],["أوغلت في البين حتى ما لذي وتر","هناك من قلبك الخفَّاق أوزان",87,"ن",1,0],["أو غاصبٌ وضعيف الجاه مغتصبٌ","وقاتل وبريء الذيل مقتول",88,"ل",1,0],["أو غفول بنفسه ظنّ فضلاً","يدّعي الفهم وهو طبل العراق",89,"ق",1,0],["أو غاب عنك فلست تنظر وجهه","طلقاً فقبل أخيك غاب الفرقد",90,"د",1,0],["أوغرتَ قلبي منك بالكلامِ","ووقعُه في القلبِ كالكِلامِ",91,"م",1,0],["أوغاد أهل المرية افترسوا","عرسك يا وغد أهل جيان",92,"ن",1,1],["أو غابةً أو روضةً نضرت","إلا سعت فوراً لتمتثلا",93,"ل",2,0],["أوغلتها في مهجتي","لم يحمها منك ابن نثره",94,"ر",2,0],["أو غدا مفرقاً لكنتم عليه","يا أكاليل عزه تاج مفرق",95,"ق",1,0],["أَو غُرة مِثل النَهار وَطرة","كَاللَيلِ أَو مِن جور قد عادِل",96,"ل",1,0],["أَو غَيرَ جَذلانٍ سَرى بِحَبيبَه","ماءُ الحَيا فاِرتاحَ زَهواً وَاِنثَنى",97,"ن",2,0],["أَو غَيرَ مُنذَهِلٍ لِزينَة مَشهَدٍ","يَتلو بِهِ سورَ الكِتابِ مُحَصِّنا",97,"ن",2,0],["أَو غَيرَ أَفواجٍ تَروحُ وَتَغتَدي","فَمُؤَمِّلاً وَمُؤَمِّناً وَمُؤَمَّنا",97,"ن",2,0],["أَو غَيرَ داعٍ لِلوَزير وَلابنِهِ","وَلآله بِبُلُوغِ غاياتِ المُنى",97,"ن",2,0],["أَو غَدَت خَيلُه صفُوفاً فَكَم ال","بسها النَّقعَ في الهيِاجِ جِلاَلا",98,"ل",2,0],["أَو غدا دِرعُهُ مَضُونا فَكَم غَا","دَرَهُ ما أفاضَ مِنهُ مُذالا",98,"ل",2,0],["أو غدا العلمُ ضايعاً فهو من كان","باخلاقه يُضوع شَذاه",99,"ا",2,0],["اوغرة السيد الإمام أبي الأ","نوار من بالأنام لم يقس",100,"س",1,0],["أو غايَةٌ لِلحُزنِ عَاصَرْتُهَا","حتى تَسَاوَى العُرْسُ والمَأتَمْ",101,"م",1,0],["أو غفى الحلم من إليه صباح","يستثير العطور في كفيك",102,"ك",1,0],["أو غافلٍ ماأدركته يد الحجا","ظن البِلى يغفو على أثوابها",103,"ب",3,0],["أو غادة يبدو لنا من فرعها","وجبينها الإصباح والإمساء",104,"ا",2,0],["أَو غض من أملي مَا سَاءَ من عَمَلي","فَإِن لي حسن ظن فِيك يَكْفِينِي",105,"ن",2,0],["أَو غَرَّ سَارٍ بَهاءُ البَدرِ فِي ظُلَمٍ","سَرَّ النُّفوسَ وَبَعدَ الأُنسِ قَد أَفلا",1