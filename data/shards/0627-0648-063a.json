{"poems":[[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"ياسين إنك بالقلوب مشيع","https://www.aldiwan.net/poem44806.html","الكامل"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[91,"قال السماء كئيبة وتجهما","https://www.aldiwan.net/poem62735.html","عموديه"],[92,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[106,"حرب الرذيلة","https://www.poetsgate.com/ViewPoem.aspx?id=179641",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[126,"يا بتعة فاقت ببهجتها","https://www.aldiwan.net/poem50579.html","مجزوء الكامل"],[140,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[183,"جام حوى في الظرف كل باب","https://www.aldiwan.net/poem14090.html","الرجز"],[191,"أهلا بفجر قد نضا ثوب الدجى","https://www.aldiwan.net/poem12992.html","الكامل"],[197,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[208,"نقل الغرام حديث دمعي مرسلا","https://www.aldiwan.net/poem13420.html","الكامل"],[221,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[295,"هد الحمام لآل عبد مناف","https://www.aldiwan.net/poem33214.html","الكامل"],[295,"شق الدجى عن نحره الفجر","https://www.aldiwan.net/poem33263.html","أحذ الكامل"],[295,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[302,"خذ ما صفا ودع الكدر","https://www.aldiwan.net/poem16879.html","مجزوء الكامل"],[308,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[326,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[369,"إن العيون على القلوب قواض","https://www.aldiwan.net/poem57342.html","الكامل"],[426,"تاالله يا ظبيات الروم إن لعبت","https://www.aldiwan.net/poem39853.html","البسيط"],[436,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[436,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[450,"ما كل وقت للزيارة صالح","https://www.aldiwan.net/poem13880.html","الكامل"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[475,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[560,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"]],"verses":[["أَو غَرَضٍ أَصبَحَت خَواطِرُنا","تُساقِطُ الدُرَّ مِنهُ في الكُتُبِ",0,"ب",1,0],["أَو غادَةٍ كانَت تُريكَ إِذا بَدَت","شَمسَ النَهارِ فَأَصبَحَت كَالآلِ",1,"ل",1,0],["أو غدا الحسن شاعراً ينظم الحبّ","قريضاً أبدى بها التشبيبا",2,"ب",2,0],["أو غيّبوك فإن أمرك حاضر","أو ثبطوك فإن جيشك مسرع",3,"ع",1,0],["أو غدا جائداً كجودك فينا","كانَ كل الأوقات أعياد عامهْ",4,"م",2,0],["أَو غادَةٍ مَسلولَةٍ مُحتاجَةٍ","لِدَمٍ وَتَنفُثُ كُلَما لَهَثَت دَما",5,"م",2,0],["أَو غصوناً أَحنو عليكِ بأَوراقي","حُنُوَّ المدَلَّهِ المتبولِ",6,"ل",1,0],["أَو غيضَ بَحرٌ فَذا بَحرٌ بِمَوضِعِهِ","لِوارِديهِ نَميرٌ ماؤُهُ خَصِرُ",7,"ر",1,0],["أو غازيًا فتح المما","لك عنوةً بمهند",8,"د",1,0],["أو غرَّرت بالعالمين مبادئٌ","تُزْري بإفكِ مُسَيلمٍ وسَجَاجَ",9,"ج",1,0],["أو غارِقٌ مع خالدٍ أو طارقٍ","في الحَرْب بين صَوارمٍ وعوالي",10,"ل",2,0],["أوغَلتُ في أحراجه وكأنني","أصبحت أولَ مرَّةٍ فنّانا",11,"ن",2,0],["أو غَديرٍ جمِّ المساربِ عذبٍ","حَرمَّوه وحلَّلوا شُطْئَانه",12,"ن",2,0],["او غدا الحسن شاعرا ينظم العشق","قريضا ابدى بها التشبيبا",13,"ب",2,0],["أو غادةَ غَرّاءُ وا","ضحة الترائبِ والقناعِ",14,"ع",1,0],["أوغلتُ في خوض الهوى أنَفاً","للقلب أن يبقىَ بلا شُغلِ",15,"ل",1,0],["أو غادةٍ تُسْفِر من نِقاب","شَفٍّ كماءٍ راقَ في ثِعاب",16,"ب",1,0],["أَو غادَةٍ شَقَّت صِداراً أَزرَقاً","ما بَينَ ثُغرتها إِلى الأَقرابِ",17,"ب",1,0],["أو غاصتِ الشمسُ تحتَ اللجِّ هاربةً","فما على الناسِ من همٍّ وأكدارِ",18,"ر",1,0],["او غبتم عن ناظري فخيالكم","ابدا بقلبي لا يزال مخيلا",19,"ل",2,0],["أَو غَليمُ الثاني عَلى عَرشِهِ","اللَهُ مِن سَطوَتِهِ أَكبَرُ",20,"ر",1,0],["أَو غسَّلوكَ فَلَن تَزال مُطَهّر ال","أَقوال والأَفعال والأَوصافِ",21,"ف",1,0],["أَو غادَةٌ رؤدٌ غدائِرُها","لَيلٌ وَضوءُ جَبينها فَجرُ",22,"ر",1,0],["أَو غادَةٌ هَيفاءُ مَجدُولَةٌ","قد أَثمرَت قامَتُها بالنُهود",23,"د",1,0],["أو غدرت ورق الحمى","فوق الغصون من الشجر",24,"ر",1,0],["أو غرد الركب الخلي بطيبة","حنوا لمغناها حنين النيب",25,"ب",1,0],["أو غويٌّ تضجُّ منه السماوا","تُ مريدٌ إلّا على الشيطان",26,"ن",1,0],["أو غاية في الجدِّ أدرَكَ غايةً","مِثلي مُعانيه ومثل القاضي",27,"ض",2,0],["أو غازل الغنج في الأجفان ادعجها","وافترّ ثغرٌ يعاطي درُّهُ اللعسا",28,"س",2,0],["أَو غارَ من أَعيادِنا بِكَ فالْتَوَى","بمداهُ حَتَّى كادَ يلحَقُهُ الوَنى",29,"ن",2,0],["أَو غُرَّةٍ جُعِلَتْ لِسَيْفِكَ غرَّةً","إِن لَمْ تَخِرَّ إِلَى جَبينِكَ ساجدَهْ",30,"د",2,0],["أو غِبَّ حمّامٍ فإِنْ تكُ حاذِقاً","جُنِبتَها بتعاقبِ الأجيالِ",31,"ل",1,0],["أو غَدتْ عُطْلاً حَشايا سُرُرٍ","وقَرا الطِرْفِ فانَّ الرَّمْسَ حَالي",32,"ل",2,0],["أو غدتْ مشبهةً مِن لوعتي","نارَها حَرّاً ووَقْداً وضِراما",33,"م",2,0],["أو غمامٍ هو بالما","ءِ الذي فيه دَلوُحُ",34,"ح",1,0],["أو غِبتَ عن نَظَرٍ فقد خلَّفتَ بالتْ","تَأْريخِ ذِكراً في القُلوبِ مُخلَّدا",35,"د",2,0],["أو غير الصلاة عن أوقاته","أو حوّل الفروض عن جهاتها",36,"ه",2,0],["أَو غَفِل الحارسُ في ال","جنَّة حتى سُرِّقَتْ",37,"ت",1,0]]}