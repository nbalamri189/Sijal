 قد لج فما يقصر","https://www.aldiwan.net/poem14004.html","السريع"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[85,"تم لبعض الناس فيما قد سلف","https://www.aldiwan.net/poem7764.html","الرجز"],[85,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"كان ابن داود يقر","https://www.aldiwan.net/poem8016.html","مجزوء الكامل"],[85,"فأر رأى القط على الجدار","https://www.aldiwan.net/poem8031.html","الرجز"],[62,"إحراقنا البالغ في أول التكليس","https://www.aldiwan.net/poem52226.html","السريع"],[62,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[45,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[58,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem30913.html","السريع"],[49,"وإنما العلم من قياس","https://www.aldiwan.net/poem62166.html","مجزوء البسيط"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[44,"قف بالطلول الدارسات علاثا","https://www.aldiwan.net/poem30565.html","الكامل"],[74,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[105,"ممالك الشرق ما في الحق من باس","https://www.aldiwan.net/poem42109.html","البسيط"],[105,"أنت المثال لكل حر صادق","https://www.aldiwan.net/poem42129.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[81,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[102,"القلب متصل الوجي","https://www.aldiwan.net/poem33128.html","مجزوء الكامل"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[48,"لا تبك بعد تفرق الخلطاء","https://www.aldiwan.net/poem10406.html","الكامل"],[48,"بادر شبابك قبل الشيب والعار","https://www.aldiwan.net/poem63284.html","البسيط"],[48,"كان الشباب مطية الجهل","https://www.aldiwan.net/poem64491.html","الكامل"],[46,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[46,"إن سرور المدام لم يدم","https://www.aldiwan.net/poem23417.html","المنسرح"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54874","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141954","الكامل"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[90,"الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=179088",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[91,"الخطب الفادح","https://www.poetsgate.com/ViewPoem.aspx?id=53037",""],[48,"لا تَبْكِ بَعْدَ تَفَرّقِ الخلطاءِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24841&r=&rc=11",""]],"verses":[["وَالكُحلُ نَوعٌ مِنَ الأَحجارِ تَنظُرُهُ","في أَرضِهِ وَهوَ مُرميٌّ عَلى الطُرُقِ",0,"ق",1,0],["وَآلِكِ الْغُرِّ وَالأَصْحَابِ كُلِّهِم","وَتَابِعِيهِمْ لِيَوْمِ الْحَشْرِ وَالدِّينِ",1,"ن",1,0],["وَالْكَوْنُ أَشْرَاكُ نُفُوسِ الْوَرَى","طُوبَى لِنَفْسٍ حُرَّةٍ فَازَتْ",2,"ت",1,1],["والكُلّ مؤتَمِرٌ وما في ضِمْنِهِ","للّهِ فهْوَ الواحِدُ القَهّارُ",3,"ر",1,0],["والكأسُ تُجْلى عَروساً في مِنَصَّتِها","والرّوْضُ يرْفُلُ في أثْوابِهِ الجُدُدِ",4,"د",1,0],["وَالكَفَّتَانِ تُرَى مِنْ كَفِّهِ طُلِبَا","أَنْ تُخْرِجَا الْعَدَد الْمَجْهُولَ لِلطَّلَبَهْ",5,"ه",1,0],["وَالكُفرُ مُعتَصِمٌ بِسورٍ مُشرِفِ ال","أَبراجِ أُحكِمَ بِالصَفيحِ وَشُيِّدا",6,"د",2,0],["وَالكَفَلِ الرَجراجِ في الحِقابِ","وَالفاحِمِ الأَسوَدِ كَالغُرابِ",7,"ب",1,0],["والكل نرقب ذا المهل","بالسعد والفتح يستهل",8,"ل",1,0],["والكأسُ تطلع شمسها في خدِّهِ","فتكادُ تُعشي بالأشعة والنظرْ",9,"ر",1,0],["والكون قد لاح بمرآته","للعيش وجه شاحب أسفع",10,"ع",1,0],["والكلّ في شغْب لهم دائم","لم يقلعوا عنه ولن يقلعوا",10,"ع",3,0],["والكَاشِفُو المُفظِعِ المُهِمِّ إذا ال","تَفَّ بِتَصدِيرِ أهلِهَا الحَقَبُ",11,"ب",1,0],["والكاشفو المفظع المهم اذا","التفت بتضرير اهلها الحقب",12,"ب",1,0],["والكل بين يديك خادمُ صنعةٍ","ينشي وينشد والزمان مؤاتي",13,"ت",2,0],["والكريمُ الذي بهِ نفق القص","د وراج القريضُ أيّ رواج",14,"ج",1,0],["وآلك والصحب الذين عليهمُ","تحلُّ حُبا مدحٍ ويعقد خنصر",15,"ر",1,0],["والكامل الذات يروي فضل سؤددهِ","عواليَ الفضل عن آبائه الكمل",16,"ل",1,0],["والكأس في يد ساقيها مصوَّرة","تضيء من حول كسرى ضوء بهرام",17,"م",1,0],["والكاتب الأسرار يحبس خطوها","مع أنَّها في صدرِه في مهمهِ",18,"ه",1,0],["والكلبُ من شأنه التعدّي","والكلبُ من شأنه الغلولُ",19,"ل",1,0],["والكلب وافٍ وفيك غدرٌ","ففيك عن قدْره سُفولُ",19,"ل",1,0],["وَالكَأسُ أَجمَلُ في النَوا","ظِرِ إِذ يُرَصِّعُها الحَباب",20,"ب",1,0],["وَالكُلُّ يَسأَلُ كَيفَ حالُ إِمامِنا","ماذا رَأى حُكَماأُنا ما أَخبَروا",21,"ر",3,0],["وَالكُلُّ كَيفَ يَكونُ حالُ بِلادِهِم","مِن بَعدِ ما ماتَ الإِمامُ يُفَكِّرُ",21,"ر",1,0],["وَالكوخُ كَالقَصرِ المَكين","وَالشَوكُ مِثلُ الياسَمين",22,"ن",1,0],["والكونُ من طُهْرِ الحياةِ كأنّما","هو معبدٌ والغابُ كالمحرابِ",23,"ب",1,0],["وَالكَوكَبُ الوَقّاد تَحتَ الدُجى","في أُفقهِ وَالقَمَرُ الأَزهَرُ",24,"ر",1,0],["والكرم قد مدّت له","حول الاراك حبائل",25,"ل",1,0],["والكلب قال قد سألت الباريا","يجعلني في ملك هذا قاضيا",26,"ي",2,0],["والكاهن الثاني أنا أصلّى","لأجلكم فريضتي ونفلي",27,"ي",1,0],["وَالكرمُ المَصريُّ مِما رَسَموا","بِمَصرَ مِن بِرٍّ وَسَنُّوا مِن قِرى",28,"ا",1,0],["وَالكُتبُ تَحتَ جَناحِها","كُتِبَت لَها فيها الكَرامَه",29,"م",2,0],["وَالكَلبُ في حالَتِهِ المَعهودَه","مُستَجمِعاً لِلوَثبَةِ المَوعودَه",30,"ه",1,0],["والكلس إن أدخل آثالنا أل","أبيض روح نخلت بالحرير",31,"ر",1,0],["والكيمياء العويص قد لقي ال","ناس بتدبير أمره نصبا",32,"ب",2,0],["وَالكَريمُ النامي لِأَصلٍ كَريمٍ","حَسَنٌ في العُيونِ يَزدادُ حُسنا",33,"ن",2,0],["والكَرْمُ مُشتَبِكُ الأفنانِ تُوسِعُنا","أجناسُه في تساوي شِرْبِها عَجَبا",34,"ب",2,0],["وَالكُفرُ بِالنِعمَةِ يَدعو إِلى","زَوالِها وَالشُكرُ أَبقى لَها",35,"ل",3,0],["وَالكاتِمُ الأَمرَ لَيسَ يَخفى","كَالمَوقِدِ النارِ بِاليَفاعِ",36,"ع",1,0],["وَالكَوثَرِ العَذبِ زُقوماً وَغِسلينا","كَم خَلوَةٍ هَزَّنا لِلبَحثِ باعِثُنا",37,"ن",2,0],["وَالكَيُّ لا يَرضى الوَريدَ صاحِبا","أَما تَرى الطَيرَ الجَليلَ قَد أَتى",38,"ت",2,0],["وَآلِكَ الغُرَرِ اللّاتي بِها عُرِفَت","سُبلُ الرَشادِ فَكانَت مُهتَدى الفِرَقِ",39,"ق",1,0],["وَالكامِخِيَّةُ لَم تَكُن لي مَنزِلاً","فَمَقابِرُ اللَذّاتِ مِن قَبراثا",40,"ث",2,0],["وَالكَأسُ طِرفٌ أَشقَرٌ قَد جالَ في","عَرقٍ عَلَيهِ مِن الحَبابِ يَسيلُ",41,"ل",1,0],["والكاتبُ الحُرُّ لم يَهْتِكْ حِمَى قَلَمٍ","بالتُّرَّهاتِ ولم يَعْبَثْ بِقِرْطَاسِ",42,"س",1,0],["والكفرُ أجمعُ أن يُساوِمَ خَصْمَهُ","يَبْغِي من الخَطرِ الجليلِ بَديلا",43,"ل",2,0],["وَالكُفرُ أَجمَعُ أَن يُحِبَّ بِلادَهُ","حُرُّ السَريرَةِ مُؤمِنُ الوُجدانِ",44,"ن",1,0],["وَالكائِناتُ قَصيدَةٌ تَروي لَنا","عَنها فُنونَ الوَجدِ وَالتَوَقانِ",44,"ن",1,0],["وَالكُفرُ مُمتَدُّ المَطالِعِ وَالهُدى","مُتَمَسِّكٌ بِذِنابِ عَيشٍ أَغبَرِ",45,"ر",1,0],["وَالكَون نائم","وَالفكر هائم",46,"م",1,0],["وَالكَمأَةُ الصَفراءُ بادٍ حَجمُها","فَبِكُلِّ أَرضٍ مَوسِمٌ لِحَياةِ",47,"ه",1,0],["والكراماتَ منهمُ مُعجزاتٌ","حازَهَا مِنْ نَوَالِكَ الأولياءُ",48,"ا",2,0],["وَالكاتِبِينَ بِسُمْرِ الخَطِّ مَا تَرَكَتْ","أقْلامُهُمْ حَرْفَ جِسْمٍ غَيْرَ مُنْعَجِمِ",49,"م",1,0],["والكُلُّ جَمْعاً بِبَذْلِ المالِ قد خَدَمُوا","وما سَمِعْنَا بهذا غيرَ ذا الحِينِ",50,"ن",1,0],["وَالكوبُ يَضحَكُ كَالغَزالِ مُسَبِّحاً","عِندَ الرُكوعِ بِلَثغَةِ الفَأفاءِ",51,"ا",2,0],["وَالكَأسُ تُمسِكُها مِن أَن تُراعَ فَما","تَنفَكُّ فيها بِإِقبالٍ وَإِدبارِ",52,"ر",1,0],["وَالكَأسُ أَهواها وَإِن رَزَأَت","بُلَغَ المَعاشِ وَقَلَّلَت فَضلي",53,"ل",2,0],["وَالكَفُّ تُقطَعُ إِن خيفَ الهَلاكُ بِها","عَلى الذِراعِ بِتَقديرٍ وَتَسبيبِ",54,"ب",1,0],["وَالكَأسُ مِن كاسَ في التَعَثُّرِ وَال","نُدمانُ لَفظٌ أَتى مِنَ النَدَمِ",55,"م",1,0],["والكِبْرُ والحمْدُ ضِدّانِ اتّفاقُهما","مثْلُ اتّفاقِ فَتَاءِ السّنّ والكِبَرِ",56,"ر",1,0],["والكلبُ في تهوُّرٍ قدِ انغمَسْ","وضُيِّقَ الحَلْقُ عليهِ والنَّفَسْ",57,"س",1,0],["والكتاب الذي من الله قد جا","ء فأدلى به البشير النذيرُ",58,"ر",1,0],["وَالكاشِفُ الكُرَبَ اللاتي يَحُفُّ بِها","إِظلامُ أَمرٍ عَلى البُلدانِ يَنسَدِلُ",59,"ل",1,0],["والكونُ ملحمةٌ كبرى جوانبها","دمٌ ونارٌ وإعصارٌ وظلماءُ",60,"ا",2,0],["والكافرون في قريش والبلد","لم يكن الأمر لهم على خلد",61,"د",1,0],["وَالكِرَامِ الَّذِينَ يُسْعَى إِلَيْهِمْ","وَسَعَوا عَنْ تَفَضُّلٍ وَسَخَاءِ",62,"ا",2,0],["وَالكَفِيَّ الْوَفِيَّ فِي كُلِّ حَالٍ","مُسْتَقِلاًّ بِجَهْدِهِ أَوْ وَزِيرَا",63,"ر",2,0],["وَالكَأْسُ كَالعَذْرَاءِ عَارِيَةٌ","أَلحَاظُها تَسْطُو وتَنْكَسِرُ",64,"ر",1,0],["والكهرباء هنا تشع شموسها","وسراج أكثر من هناك الأنجم ..",65,"م",1,0],["والكون قد شبَّت به جمراتُهُ","فنزلتَ قطرَ ندى على جمراته",66,"ت",2,0],["والكل خَدَّامُ الحِمَى","والعَدْلُ بينهُمُو يسود",67,"د",1,0],["والكاتِبُون لها صَحَائِفَ مَجْدِها","يَوْمَ الكَرِيهَة بالدَّمِ السَّيَّال",68,"ل",1,0],["والكأسُ يجلوها أغنُّ يكاد من","فرْطِ النُعاس يؤدهُ تغميضه",69,"ض",2,0],["والكأسُ عادتْ كأسَ موتٍ ينتشي","زاهي الشبابِ بها ، ويمسحُ شاربا!",70,"ب",2,0],["و\" الكرومُ \" المُعرِّشاتُ حُبالى","مُرضِعاتٌ كرائمَ الأعناب",71,"ب",1,0],["والكلّ يسأل كيف حال إمامنا","ماذا رأى حكمائنا ، ما أخبروا ؟",72,"ر",3,0],["والكوبُ بضحكُ كالغزالِ مسبّحا","عندَ الرُّكوعُ بلَثْغَة ِ الفَأْفَاءِ",73,"ا",2,0]]}