0.html","الكامل"],[556,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[556,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[556,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[556,"إني أنا المكتوب في الطرس","https://www.aldiwan.net/poem34445.html","السريع"],[556,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[556,"قف جانب الدير سل عنها القساسيسا","https://www.aldiwan.net/poem34453.html","البسيط"],[556,"أنتم هي الجوزة في قشرها","https://www.aldiwan.net/poem34468.html","السريع"],[556,"لا خلق أعظم مثل خلق الآخره","https://www.aldiwan.net/poem34472.html","الكامل"],[556,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[556,"قد صرت كلي قلوبا فيه تحتار","https://www.aldiwan.net/poem34523.html","البسيط"],[556,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[556,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[556,"هذا الوجود الحقيقي الواحد الأحد","https://www.aldiwan.net/poem34570.html","البسيط"],[556,"لا رؤية ولا شهود","https://www.aldiwan.net/poem34577.html","مجزوء الرجز"],[556,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[556,"قلب المحقق واجد بل فاقد","https://www.aldiwan.net/poem34597.html","الكامل"],[556,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[556,"الفرق سكر لأن العقل يستجدي","https://www.aldiwan.net/poem34614.html","البسيط"],[556,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[556,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[556,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[556,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[556,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[556,"تب منك حين تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[556,"لا بد للضيق في الدنيا من الفرج","https://www.aldiwan.net/poem34691.html","البسيط"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[556,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[556,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[556,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[556,"للذنب سر عجيب","https://www.aldiwan.net/poem34971.html","المجتث"],[556,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[556,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[556,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[556,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[560,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[560,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[561,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[565,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[573,"يا قاعداً معنا ويزعم","https://www.aldiwan.net/poem2805.html","مجزوء الكامل"],[573,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[573,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"]],"verses":[["وَالكُحلُ نَوعٌ مِنَ الأَحجارِ تَنظُرُهُ","في أَرضِهِ وَهوَ مُرميٌّ عَلى الطُرُقِ",0,"ق",1,0],["وَآلِكِ الْغُرِّ وَالأَصْحَابِ كُلِّهِم","وَتَابِعِيهِمْ لِيَوْمِ الْحَشْرِ وَالدِّينِ",1,"ن",1,0],["وَالْكَوْنُ أَشْرَاكُ نُفُوسِ الْوَرَى","طُوبَى لِنَفْسٍ حُرَّةٍ فَازَتْ",2,"ت",1,1],["والكُلّ مؤتَمِرٌ وما في ضِمْنِهِ","للّهِ فهْوَ الواحِدُ القَهّارُ",3,"ر",1,0],["والكأسُ تُجْلى عَروساً في مِنَصَّتِها","والرّوْضُ يرْفُلُ في أثْوابِهِ الجُدُدِ",4,"د",1,0],["وَالكَفَّتَانِ تُرَى مِنْ كَفِّهِ طُلِبَا","أَنْ تُخْرِجَا الْعَدَد الْمَجْهُولَ لِلطَّلَبَهْ",5,"ه",1,0],["وَالكُفرُ مُعتَصِمٌ بِسورٍ مُشرِفِ ال","أَبراجِ أُحكِمَ بِالصَفيحِ وَشُيِّدا",6,"د",2,0],["وَالكَفَلِ الرَجراجِ في الحِقابِ","وَالفاحِمِ الأَسوَدِ كَالغُرابِ",7,"ب",1,0],["والكل نرقب ذا المهل","بالسعد والفتح يستهل",8,"ل",1,0],["والكأسُ تطلع شمسها في خدِّهِ","فتكادُ تُعشي بالأشعة والنظرْ",9,"ر",1,0],["والكون قد لاح بمرآته","للعيش وجه شاحب أسفع",10,"ع",1,0],["والكلّ في شغْب لهم دائم","لم يقلعوا عنه ولن يقلعوا",10,"ع",3,0],["والكَاشِفُو المُفظِعِ المُهِمِّ إذا ال","تَفَّ بِتَصدِيرِ أهلِهَا الحَقَبُ",11,"ب",1,0],["والكاشفو المفظع المهم اذا","التفت بتضرير اهلها الحقب",12,"ب",1,0],["والكل بين يديك خادمُ صنعةٍ","ينشي وينشد والزمان مؤاتي",13,"ت",2,0],["والكريمُ الذي بهِ نفق القص","د وراج القريضُ أيّ رواج",14,"ج",1,0],["وآلك والصحب الذين عليهمُ","تحلُّ حُبا مدحٍ ويعقد خنصر",15,"ر",1,0],["والكامل الذات يروي فضل سؤددهِ","عواليَ الفضل عن آبائه الكمل",16,"ل",1,0],["والكأس في يد ساقيها مصوَّرة","تضيء من حول كسرى ضوء بهرام",17,"م",1,0],["والكاتب الأسرار يحبس خطوها","مع أنَّها في صدرِه في مهمهِ",18,"ه",1,0],["والكلبُ من شأنه التعدّي","والكلبُ من شأنه الغلولُ",19,"ل",1,0],["والكلب وافٍ وفيك غدرٌ","ففيك عن قدْره سُفولُ",19,"ل",1,0],["وَالكَأسُ أَجمَلُ في النَوا","ظِرِ إِذ يُرَصِّعُها الحَباب",20,"ب",1,0],["وَالكُلُّ يَسأَلُ كَيفَ حالُ إِمامِنا","ماذا رَأى حُكَماأُنا ما أَخبَروا",21,"ر",3,0],["وَالكُلُّ كَيفَ يَكونُ حالُ بِلادِهِم","مِن بَعدِ ما ماتَ الإِمامُ يُفَكِّرُ",21,"ر",1,0],["وَالكوخُ كَالقَصرِ المَكين","وَالشَوكُ مِثلُ الياسَمين",22,"ن",1,0],["والكونُ من طُهْرِ الحياةِ كأنّما","هو معبدٌ والغابُ كالمحرابِ",23,"ب",1,0],["وَالكَوكَبُ الوَقّاد تَحتَ الدُجى","في أُفقهِ وَالقَمَرُ الأَزهَرُ",24,"ر",1,0],["والكرم قد مدّت له","حول الاراك حبائل",25,"ل",1,0],["والكلب قال قد سألت الباريا","يجعلني في ملك هذا قاضيا",26,"ي",2,0],["والكاهن الثاني أنا أصلّى","لأجلكم فريضتي ونفلي",27,"ي",1,0],["وَالكرمُ المَصريُّ مِما رَسَموا","بِمَصرَ مِن بِرٍّ وَسَنُّوا مِن قِرى",28,"ا",1,0],["وَالكُتبُ تَحتَ جَناحِها","كُتِبَت لَها فيها الكَرامَه",29,"م",2,0],["وَالكَلبُ في حالَتِهِ المَعهودَه","مُستَجمِعاً لِلوَثبَةِ المَوعودَه",30,"ه",1,0],["والكلس إن أدخل آثالنا أل","أبيض روح نخلت بالحرير",31,"ر",1,0],["والكيمياء العويص قد لقي ال","ناس بتدبير أمره نصبا",32,"ب",2,0],["وَالكَريمُ النامي لِأَصلٍ كَريمٍ","حَسَنٌ في العُيونِ يَزدادُ حُسنا",33,"ن",2,0],["والكَرْمُ مُشتَبِكُ الأفنانِ تُوسِعُنا","أجناسُه في تساوي شِرْبِها عَجَبا",34,"ب",2,0],["وَالكُفرُ بِالنِعمَةِ يَدعو إِلى","زَوالِها وَالشُكرُ أَبقى لَها",35,"ل",3,0],["وَالكاتِمُ الأَمرَ لَيسَ يَخفى","كَالمَوقِدِ النارِ بِاليَفاعِ",36,"ع",1,0],["وَالكَوثَرِ العَذبِ زُقوماً وَغِسلينا","كَم خَلوَةٍ هَزَّنا لِلبَحثِ باعِثُنا",37,"ن",2,0],["وَالكَيُّ لا يَرضى الوَريدَ صاحِبا","أَما تَرى الطَيرَ الجَليلَ قَد أَتى",38,"ت",2,0],["وَآلِكَ الغُرَرِ اللّاتي بِها عُرِفَت","سُبلُ الرَشادِ فَكانَت مُهتَدى الفِرَقِ",39,"ق",1,0],["وَالكامِخِيَّةُ لَم تَكُن لي مَنزِلاً","فَمَقابِرُ اللَذّاتِ مِن قَبراثا",40,"ث",2,0],["وَالكَأسُ طِرفٌ أَشقَرٌ قَد جالَ في","عَرقٍ عَلَيهِ مِن الحَبابِ يَسيلُ",41,"ل",1,0],["والكاتبُ الحُرُّ لم يَهْتِكْ حِمَى قَلَمٍ","بالتُّرَّهاتِ ولم يَعْبَثْ بِقِرْطَاسِ",42,"س",1,0],["والكفرُ أجمعُ أن يُساوِمَ خَصْمَهُ","يَبْغِي من الخَطرِ الجليلِ بَديلا",43,"ل",2,0],["وَالكُفرُ أَجمَعُ أَن يُحِبَّ بِلادَهُ","حُرُّ السَريرَةِ مُؤمِنُ الوُجدانِ",44,"ن",1,0],["وَالكائِناتُ قَصيدَةٌ تَروي لَنا","عَنها فُنونَ الوَجدِ وَالتَوَقانِ",44,"ن",1,0],["وَالكُفرُ مُمتَدُّ المَطالِعِ وَالهُدى","مُتَمَسِّكٌ بِذِنابِ عَيشٍ أَغبَرِ",45,"ر",1,0],["وَالكَون نائم","وَالفكر هائم",46,"م",1,0],["وَالكَمأَةُ الصَفراءُ بادٍ حَجمُها","فَبِكُلِّ أَرضٍ مَوسِمٌ لِحَياةِ",47,"ه",1,0],["والكراماتَ منهمُ مُعجزاتٌ","حازَهَا مِنْ نَوَالِكَ الأولياءُ",48,"ا",2,0],["وَالكاتِبِينَ بِسُمْرِ الخَطِّ مَا تَرَكَتْ","أقْلامُهُمْ حَرْفَ جِسْمٍ غَيْرَ مُنْعَجِمِ",49,"م",1,0],["والكُلُّ جَمْعاً بِبَذْلِ المالِ قد خَدَمُوا","وما سَمِعْنَا بهذا غيرَ ذا الحِينِ",50,"ن",1,0],["وَالكوبُ يَضحَكُ كَالغَزالِ مُسَبِّحاً","عِندَ الرُكوعِ بِلَثغَةِ الفَأفاءِ",51,"ا",2,0],["وَالكَأسُ تُمسِكُها مِن أَن تُراعَ فَما","تَنفَكُّ فيها بِإِقبالٍ وَإِدبارِ",52,"ر",1,0],["وَالكَأسُ أَهواها وَإِن رَزَأَت","بُلَغَ المَعاشِ وَقَلَّلَت فَضلي",53,"ل",2,0],["وَالكَفُّ تُقطَعُ إِن خيفَ الهَلاكُ بِها","عَلى الذِراعِ بِتَقديرٍ وَتَسبيبِ",54,"ب",1,0],["وَالكَأسُ مِن كاسَ في التَعَثُّرِ وَال","نُدمانُ لَفظٌ أَتى مِنَ النَدَمِ",55,"م",1,0],["والكِبْرُ والحمْدُ ضِدّانِ اتّفاقُهما","مثْلُ اتّفاقِ فَتَاءِ السّنّ والكِبَرِ",56,"ر",1,0],["والكلبُ في تهوُّرٍ قدِ انغمَسْ","وضُيِّقَ الحَلْقُ عليهِ والنَّفَسْ",57,"س",1,0],["والكتاب الذي من الله قد جا","ء فأدلى به البشير النذيرُ",58,"ر",1,0],["وَالكاشِفُ الكُرَبَ اللاتي يَحُفُّ بِها","إِظلامُ أَمرٍ عَلى البُلدانِ يَنسَدِلُ",59,"ل",1,0],["والكونُ ملحمةٌ كبرى جوانبها","دمٌ ونارٌ وإعصارٌ وظلماءُ",60,"ا",2,0],["والكافرون في قريش والبلد","لم يكن الأمر لهم على خلد",61,"د",1,0],["وَالكِرَامِ الَّذِينَ يُسْعَى إِلَيْهِمْ","وَسَعَوا عَنْ تَفَضُّلٍ وَسَخَاءِ",62,"ا",2,0],["وَالكَفِيَّ الْوَفِيَّ فِي كُلِّ حَالٍ","مُسْتَقِلاًّ بِجَهْدِهِ أَوْ وَزِيرَا",63,"ر",2,0],["وَالكَأْسُ كَالعَذْرَاءِ عَارِيَةٌ","أَلحَاظُها تَسْطُو وتَنْكَسِرُ",64,"ر",1,0],["والكهرباء هنا تشع شموسها","وسراج أكثر من هناك الأنجم ..",65,"م",1,0],["والكون قد شبَّت به جمراتُهُ","فنزلتَ قطرَ ندى على جمراته",66,"ت",2,0],["والكل خَدَّامُ الحِمَى","والعَدْلُ بينهُمُو يسود",67,"د",1,0],["والكاتِبُون لها صَحَائِفَ مَجْدِها","يَوْمَ الكَرِيهَة بالدَّمِ السَّيَّال",68,"ل",1,0],["والكأسُ يجلوها أغنُّ يكاد من","فرْطِ النُعاس يؤدهُ تغميضه",69,"ض",2,0],["والكأسُ عادتْ كأسَ موتٍ ينتشي","زاهي الشبابِ بها ، ويمسحُ شاربا!",70,"ب",2,0],["و\" الكرومُ \" المُعرِّشاتُ حُبالى","مُرضِعاتٌ كرائمَ الأعناب",71,"ب",1,0],["والكلّ يسأل كيف حال إمامنا","ماذا رأى حكمائنا ، ما أخبروا ؟",72,"ر",3,0],["والكوبُ بضحكُ كالغزالِ مسبّحا","عندَ الرُّكوعُ بلَثْغَة ِ الفَأْفَاءِ",73,"ا",2,0],["وَالكاس مُذ بانَ عَنها تَشتَكي ظَمأ","وَالرَوض مِن حُزن جَفَت خَمائِلُهُ",74,"ل",2,0],["والكل عمتهم افاضاته","فانظر لفضل غير مخفي",75,"ي",1,0],["والكل في طمس ولولا رشة","من نور قدسك ما بدت الوان",76,"ن",1,0],["والكل في بحر المعا","مع للفناء المحض صائر",77,"ر",1,0],["والكعبة الغرا وزمزم والصفا","والبيت حتى زائر ومزور",78,"ر",1,0],["وآلك الغر أهل البيت سادتنا","والصحب أعظم قادات وشجعان",79,"ن",1,0],["وآلك الغر والصحب الأعاظم ما","إليك ركبان الباب الفحول سعت",80,"ت",1,0],["وآلك الغر والأصحاب وأنشدت","نشر العناية قد هبت نسائمه",81,"م",2,0],["والكاملُ المَجزوءُ يَزهو عندما","سَخَّرتُه لِهَواكِ أشرقَ واكتَملْ",82,"ل",1,0],["والكون غيل لعمري لست فيه أرى","غير السعالى تناجي اليوم غيلا",83,"ل",2,0],["والكذب ملح الفتى والقول أَعيبه","ما كان للصدق متناً في حواشيه",84,"ه",1,0],["والكهلَ شَارِبهُ منا وشارِبه","مِنَّا الذي هُومَا إِن طَرَّ شَارِبُه",85,"ه",1,0],["والكون يبسم ثغره ويتيه في","حللِ الهناء بوجهه المتهللِ",86,"ل",1,0],["والكنزُ أخرج دره","للناس من بعد احتجابْ",87,"ب",1,0],["والكونُ طلقٌ محياهُ وغرتهُ","تربو على الشمس في وقت الضحى وضَحا",88,"ح",2,0],["والكل مرجعهُ الفناءُ وهل ترى","في الكونِ من حال وليس يحولُ",89,"ل",1,0],["وَالكونُ تَمتدُّ حَولي لا نِهايتُهُ","والدُّهرُ يَمتدُّ عُمراً بِالملايينِ",90,"ن",1,0],["والكتب تنشر والمدارس قد زهت","بالعلم فيها والعلوم فنون",91,"ن",1,0],["والكأس تلثم ثغرا عن لآلئها","عجبا وتلبس جلبابا من الشفق",92,"ق",1,0],["وَآلَ كُلثُومَ ساداتِ الأَراقِمِ لَم","يَترُك لَهُم مِن حِمى حامٍ ولا حَرَمِ",93,"م",1,0],["وَالكَرُّ بَعدَ الفَرِّ عادَتُهُ إِذا","ضاقَ المَكَرُّ وَقيلَ بِالإِحجامِ",94,"م",1,0],["وَالكُلُّ كَعكَع كَعِكَع","خَلفي وَمِن حُوَيلَلي",95,"ي",1,0],["وَالكراماتُ كلّها مُعجِزاتٌ","منهُ كانت لَها الغيوب وعاءُ",96,"ا",2,0],["وَالكلُّ نَحلٌ وهوَ عينُ الشهدِ","لَمّا أَتى النورُ إلى أبيهِ",97,"ه",1,0],["والكأسُ في يُمنايَ تَنظرني","شَزراً فأَشربُها على حَذَرِ",98,"ر",1,0],["والكلُّ مغتَبطٌ بيومِ إيابكُم","فَرِحٌ وهذي حالةُ الوَلهانِ",99,"ن",1,0],["والكونُ يبدو مشرقاً مُتَهلّلا","متَبسّما للقائِه مزدانا",100,"ن",2,0],["والكلّ منا بالموائدِ والملابس والأث","اثِ يُفاخِر الأقرانا",100,"ن",2,0],["والكسولُ يتقنى آخراً","بالذي قد علموهُ أولا",101,"ل",2,0],["والكأس فيه يديرها","سَعدٌ من الفَلَك المُدارِ",102,"ر",1,1],["والكأس كالثلج لكن وسطها قبس","هل كنتَ تعرف ثلجاً يألف القبسا",103,"س",2,0],["وآلك والصحب الذين حديثهم","به يبدأ الذكر الجميل ويختم",104,"م",1,0],["وآلك والاصحاب ما هيجت صبا","بلابل مشتاق وما سجعت ورقا",105,"ق",2,0],["وآلك والاصحاب ما هبت الصبا","وما نشقت عرف الشذا حين هبت",106,"ت",1,0],["وآلك الغر والصحب الذين لهم","بنصرة الدين تكبير وتهليل",107,"ل",1,0],["والكون في العين أمسى","حقيقة كالخيال",108,"ل",1,0],["وَالكائِناتُ لَدى الرَدى أُلعوبَةٌ","حَتّى الخُلودُ يَصيرُ من أَلعابِهِ",109,"ب",2,0],["وَالكاهِن المَأجورُ تَم","تَمَ مدة الوَقتِ القَصير",110,"ر",1,0],["والكون يمسك خفقة متنظّرا","قبلاتنا في لهفة وذهول !",111,"ل",1,0],["والكفرُ في شَظَفٍ والدينُ في شَرَف","والجودُ في سَرَفٍ والناس في جَذَلِ",112,"ل",1,0],["والكتاب المبين والنصر بالرع","ب وريح الصبا على الأعداء",113,"ا",2,0],["وَالكَرمُ يَحمِلُ مَرَّتَينِ وَتجتَني","لِتَضاعُفِ البَرَكاتِ في بُستانِ",114,"ن",1,0],["وَالكُفؤُ يَومَ حُنين الثَّبتُ الَّذي","لَمّا تَوَلّوا كانَ غَيرَ جَبانِ",114,"ن",1,0],["وَالكَأسُ يَحكيها نَسيمَ الصَبا","تخجلُ نَشرَ المِسكِ وَالمَندَلِ",115,"ل",1,0],["وَالكَأسُ في يَدِهِ تُدارُ وَبَينَنا","عَتبٌ تَكادُ لَهُ المَسامِعُ تُشرِقُ",116,"ق",1,0],["وَالكَعبَةُ البَيتُ الحَرامُ وَإِن سَمَت","شَرَفاً فَقَومُكَ صيدُها وَكِرامُها",117,"م",3,0],["وَالكُرَماءُ يا بَني ال","آمالِ عادوا رِمَما",118,"م",2,0],["وَالكَأسُ قَد أَعداهُ سُك","رٌ مِن لَواحِظِ حامِلِه",119,"ل",2,0],["وَالْكَرْبُ يَا رَبِّي","غَطَّى سَنَا لُبِّي",120,"ي",1,0],["والكلُّ ظمآنُ يُرَى صادِراً","وما قضى الإِربةَ من وِردهِ",121,"د",2,0],["والكاملُ الملكُ ارتضاكَ لعَزمةٍ","اغنتهُ عن سُمرٍ وبثيضٍ صَوَارِمِ",122,"م",1,0],["والكاملُ الفضلِ السريعُ النَّدَى","والوافرُ العرض البسيطُ البَنَان",123,"ن",1,0],["والكون قلب بالمحبة نابض","شوقا لأحمد...درّة العشّاق",124,"ق",1,0],["والكأسُ تسلبني عقلي وأهون ما","لهوتُ عن ذكره عقلي إذا سلبا",125,"ب",2,1],["والكلب أحسن حالةً","منه وأحفظ منه ذمّه",126,"م",2,0],["والكاتب الفطن الذي لذكائه","صباً غدا الصابي وراح متيما",127,"م",2,0],["والكريم الذي تشح السواري","وأياديه تستقل الدخسيسا",128,"س",2,0],["والكاتبون بلاغة وبراعة","في الدهر كل محرر ومحبر",129,"ر",1,0],["والكونُ يتبعُ أثرها لهدايةٍ","وصيانةٍ منها فلا يتحيّر",130,"ر",1,0],["والكرخُ فيها والرَّصافةُ للعِدَى","ولأهلِها الإزهاقُ والإعدام",131,"م",1,0],["والكلُّ أحظاهُ حظٌ","فالفوزُ يلفى مَليّا",132,"ل",3,0],["وَالكَأسُ في يُمناهُ يَحكي مَركَباً","في مَوجِ بَحرٍ زاخِرٍ هَزهازِ",133,"ز",1,0],["وَالكَأسُ بِالصَهباءِ قَد أَبرَقَت","وَالعودُ بِالأَوتارِ قَد أَرعَدا",134,"د",2,0],["وَالكَأسُ فيها حَبَبٌ ناصِعٌ","يَفترُّ عَن نَظمِ ثَنايا المِلاح",135,"ح",1,0],["وَالكَلبُ إِن ينبَح البَدر المُنير فلَن","يُضيرَهُ وَيُعاني الذُلَّ وَالتَعَبا",136,"ب",2,0],["وَالكَأسُ قَد نَثَرَت عَلى وَجناتِهِ","وَرَقَ الشَقائِقِ فِتنَةً لِلرائي",137,"ا",2,0],["والكوخ أقفر لا أنيس به","وقد ذهب الصحاب",138,"ب",1,0],["وآلِك وَالصحابةِ خيرِ آلٍ","وَصَحبٍ ما شدا شادٍ وغنّى",139,"ن",2,0],["وآلِكَ وَالصحب الكرام أولي النُهى","بهم يُبدأ الذكرُ الجَميل وَيُختَمُ",140,"م",1,0],["وَالكأسُ إِذ تَهوي بها يدُهُ","نجمٌ بجُنح اللَيل مُنقَضُّ",141,"ض",1,0],["وآلِك أَربابِ الطَهارة والتُقى","وَصَحبِكَ أَصحابِ النَزاهة والطُهرِ",142,"ر",1,0],["وَالكَعبةَ الغَرّاء حين رَمى","من فوقها الأَصنامَ بالكسرِ",143,"ر",1,0],["وَآلِك الغرِّ الكرام الألى","لهم أَحاديثُ العلى تُسنَدُ",144,"د",1,0],["والكُوى قد أَغمضتْ أَجفانَها","حينما ضُمّتْ عليهن الستور",145,"ر",1,0],["والكراسي فاتحاتٌ أَذرعاً","وَصدوراً للقا الأَحباب فيحا",145,"ح",2,0],["والكل في فناه","وما لنا سواه",146,"ا",2,0],["والكل جار لبيت اللَه خالقنا","تهوى إليه قلوب العرب والحكم",147,"م",1,0],["وَآلكَ وَالصحبِ الكرامَ سفينة الن","نجاة الّتي نَرجو بِها الفوز والأمنا",148,"ن",2,0],["وَالكلُّ مجتهدٌ فَمُخطِئهم له","أجرٌ كَما لِمُصيبهم أجرانِ",149,"ن",1,0],["وَالكَونُ حفّت بِالسنى حافاتهُ","فَتراهُ مثل الروضِ لمّا نوّرا",150,"ر",2,0],["والكاس دائرة بكف مقرطق","خنث الكلام مفتر الأجفان",151,"ن",1,0],["وَالكَذبُ في بَعضِ الأُمورِ مُحَبَّبٌ","مَنَعا لِضُرٍّ أَو لِنَبلٍ مُباحُ",152,"ح",1