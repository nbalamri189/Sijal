8,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[578,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[646,"","https://poetry.dctabudhabi.ae/diwan/poem/145934","السريع"],[815,"","https://poetry.dctabudhabi.ae/diwan/poem/123316","الكامل"],[989,"","https://poetry.dctabudhabi.ae/diwan/poem/20935","الكامل"],[1057,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"]],"verses":[["وَالكُحلُ نَوعٌ مِنَ الأَحجارِ تَنظُرُهُ","في أَرضِهِ وَهوَ مُرميٌّ عَلى الطُرُقِ",0,"ق",1,0],["وَآلِكِ الْغُرِّ وَالأَصْحَابِ كُلِّهِم","وَتَابِعِيهِمْ لِيَوْمِ الْحَشْرِ وَالدِّينِ",1,"ن",1,0],["وَالْكَوْنُ أَشْرَاكُ نُفُوسِ الْوَرَى","طُوبَى لِنَفْسٍ حُرَّةٍ فَازَتْ",2,"ت",1,1],["والكُلّ مؤتَمِرٌ وما في ضِمْنِهِ","للّهِ فهْوَ الواحِدُ القَهّارُ",3,"ر",1,0],["والكأسُ تُجْلى عَروساً في مِنَصَّتِها","والرّوْضُ يرْفُلُ في أثْوابِهِ الجُدُدِ",4,"د",1,0],["وَالكَفَّتَانِ تُرَى مِنْ كَفِّهِ طُلِبَا","أَنْ تُخْرِجَا الْعَدَد الْمَجْهُولَ لِلطَّلَبَهْ",5,"ه",1,0],["وَالكُفرُ مُعتَصِمٌ بِسورٍ مُشرِفِ ال","أَبراجِ أُحكِمَ بِالصَفيحِ وَشُيِّدا",6,"د",2,0],["وَالكَفَلِ الرَجراجِ في الحِقابِ","وَالفاحِمِ الأَسوَدِ كَالغُرابِ",7,"ب",1,0],["والكل نرقب ذا المهل","بالسعد والفتح يستهل",8,"ل",1,0],["والكأسُ تطلع شمسها في خدِّهِ","فتكادُ تُعشي بالأشعة والنظرْ",9,"ر",1,0],["والكون قد لاح بمرآته","للعيش وجه شاحب أسفع",10,"ع",1,0],["والكلّ في شغْب لهم دائم","لم يقلعوا عنه ولن يقلعوا",10,"ع",3,0],["والكَاشِفُو المُفظِعِ المُهِمِّ إذا ال","تَفَّ بِتَصدِيرِ أهلِهَا الحَقَبُ",11,"ب",1,0],["والكاشفو المفظع المهم اذا","التفت بتضرير اهلها الحقب",12,"ب",1,0],["والكل بين يديك خادمُ صنعةٍ","ينشي وينشد والزمان مؤاتي",13,"ت",2,0],["والكريمُ الذي بهِ نفق القص","د وراج القريضُ أيّ رواج",14,"ج",1,0],["وآلك والصحب الذين عليهمُ","تحلُّ حُبا مدحٍ ويعقد خنصر",15,"ر",1,0],["والكامل الذات يروي فضل سؤددهِ","عواليَ الفضل عن آبائه الكمل",16,"ل",1,0],["والكأس في يد ساقيها مصوَّرة","تضيء من حول كسرى ضوء بهرام",17,"م",1,0],["والكاتب الأسرار يحبس خطوها","مع أنَّها في صدرِه في مهمهِ",18,"ه",1,0],["والكلبُ من شأنه التعدّي","والكلبُ من شأنه الغلولُ",19,"ل",1,0],["والكلب وافٍ وفيك غدرٌ","ففيك عن قدْره سُفولُ",19,"ل",1,0],["وَالكَأسُ أَجمَلُ في النَوا","ظِرِ إِذ يُرَصِّعُها الحَباب",20,"ب",1,0],["وَالكُلُّ يَسأَلُ كَيفَ حالُ إِمامِنا","ماذا رَأى حُكَماأُنا ما أَخبَروا",21,"ر",3,0],["وَالكُلُّ كَيفَ يَكونُ حالُ بِلادِهِم","مِن بَعدِ ما ماتَ الإِمامُ يُفَكِّرُ",21,"ر",1,0],["وَالكوخُ كَالقَصرِ المَكين","وَالشَوكُ مِثلُ الياسَمين",22,"ن",1,0],["والكونُ من طُهْرِ الحياةِ كأنّما","هو معبدٌ والغابُ كالمحرابِ",23,"ب",1,0],["وَالكَوكَبُ الوَقّاد تَحتَ الدُجى","في أُفقهِ وَالقَمَرُ الأَزهَرُ",24,"ر",1,0],["والكرم قد مدّت له","حول الاراك حبائل",25,"ل",1,0],["والكلب قال قد سألت الباريا","يجعلني في ملك هذا قاضيا",26,"ي",2,0],["والكاهن الثاني أنا أصلّى","لأجلكم فريضتي ونفلي",27,"ي",1,0],["وَالكرمُ المَصريُّ مِما رَسَموا","بِمَصرَ مِن بِرٍّ وَسَنُّوا مِن قِرى",28,"ا",1,0],["وَالكُتبُ تَحتَ جَناحِها","كُتِبَت لَها فيها الكَرامَه",29,"م",2,0],["وَالكَلبُ في حالَتِهِ المَعهودَه","مُستَجمِعاً لِلوَثبَةِ المَوعودَه",30,"ه",1,0],["والكلس إن أدخل آثالنا أل","أبيض روح نخلت بالحرير",31,"ر",1,0],["والكيمياء العويص قد لقي ال","ناس بتدبير أمره نصبا",32,"ب",2,0],["وَالكَريمُ النامي لِأَصلٍ كَريمٍ","حَسَنٌ في العُيونِ يَزدادُ حُسنا",33,"ن",2,0],["والكَرْمُ مُشتَبِكُ الأفنانِ تُوسِعُنا","أجناسُه في تساوي شِرْبِها عَجَبا",34,"ب",2,0],["وَالكُفرُ بِالنِعمَةِ يَدعو إِلى","زَوالِها وَالشُكرُ أَبقى لَها",35,"ل",3,0],["وَالكاتِمُ الأَمرَ لَيسَ يَخفى","كَالمَوقِدِ النارِ بِاليَفاعِ",36,"ع",1,0],["وَالكَوثَرِ العَذبِ زُقوماً وَغِسلينا","كَم خَلوَةٍ هَزَّنا لِلبَحثِ باعِثُنا",37,"ن",2,0],["وَالكَيُّ لا يَرضى الوَريدَ صاحِبا","أَما تَرى الطَيرَ الجَليلَ قَد أَتى",38,"ت",2,0],["وَآلِكَ الغُرَرِ اللّاتي بِها عُرِفَت","سُبلُ الرَشادِ فَكانَت مُهتَدى الفِرَقِ",39,"ق",1,0],["وَالكُفْرُ أَشْجَعُ مَا تَأْتِيهِ مِنْ عَمَلٍ","إِذَا رَأَيْتَ دِيَانَاتِ الوَرَى فَنَدَا",40,"د",2,0],["وَالكامِخِيَّةُ لَم تَكُن لي مَنزِلاً","فَمَقابِرُ اللَذّاتِ مِن قَبراثا",41,"ث",2,0],["وَالكَأسُ طِرفٌ أَشقَرٌ قَد جالَ في","عَرقٍ عَلَيهِ مِن الحَبابِ يَسيلُ",42,"ل",1,0],["والكاتبُ الحُرُّ لم يَهْتِكْ حِمَى قَلَمٍ","بالتُّرَّهاتِ ولم يَعْبَثْ بِقِرْطَاسِ",43,"س",1,0],["والكفرُ أجمعُ أن يُساوِمَ خَصْمَهُ","يَبْغِي من الخَطرِ الجليلِ بَديلا",44,"ل",2,0],["وَالكُفرُ أَجمَعُ أَن يُحِبَّ بِلادَهُ","حُرُّ السَريرَةِ مُؤمِنُ الوُجدانِ",45,"ن",1,0],["وَالكائِناتُ قَصيدَةٌ تَروي لَنا","عَنها فُنونَ الوَجدِ وَالتَوَقانِ",45,"ن",1,0],["وَالكُفرُ مُمتَدُّ المَطالِعِ وَالهُدى","مُتَمَسِّكٌ بِذِنابِ عَيشٍ أَغبَرِ",46,"ر",1,0],["وَالكَون نائم","وَالفكر هائم",47,"م",1,0],["وَالكَمأَةُ الصَفراءُ بادٍ حَجمُها","فَبِكُلِّ أَرضٍ مَوسِمٌ لِحَياةِ",48,"ه",1,0],["والكراماتَ منهمُ مُعجزاتٌ","حازَهَا مِنْ نَوَالِكَ الأولياءُ",49,"ا",2,0],["وَالكاتِبِينَ بِسُمْرِ الخَطِّ مَا تَرَكَتْ","أقْلامُهُمْ حَرْفَ جِسْمٍ غَيْرَ مُنْعَجِمِ",50,"م",1,0],["والكُلُّ جَمْعاً بِبَذْلِ المالِ قد خَدَمُوا","وما سَمِعْنَا بهذا غيرَ ذا الحِينِ",51,"ن",1,0],["وَالكوبُ يَضحَكُ كَالغَزالِ مُسَبِّحاً","عِندَ الرُكوعِ بِلَثغَةِ الفَأفاءِ",52,"ا",2,0],["وَالكَأسُ تُمسِكُها مِن أَن تُراعَ فَما","تَنفَكُّ فيها بِإِقبالٍ وَإِدبارِ",53,"ر",1,0],["وَالكَأسُ أَهواها وَإِن رَزَأَت","بُلَغَ المَعاشِ وَقَلَّلَت فَضلي",54,"ل",2,0],["وَالكَفُّ تُقطَعُ إِن خيفَ الهَلاكُ بِها","عَلى الذِراعِ بِتَقديرٍ وَتَسبيبِ",55,"ب",1,0],["وَالكَأسُ مِن كاسَ في التَعَثُّرِ وَال","نُدمانُ لَفظٌ أَتى مِنَ النَدَمِ",56,"م",1,0],["والكِبْرُ والحمْدُ ضِدّانِ اتّفاقُهما","مثْلُ اتّفاقِ فَتَاءِ السّنّ والكِبَرِ",57,"ر",1,0],["والكلبُ في تهوُّرٍ قدِ انغمَسْ","وضُيِّقَ الحَلْقُ عليهِ والنَّفَسْ",58,"س",1,0],["والكتاب الذي من الله قد جا","ء فأدلى به البشير النذيرُ",59,"ر",1,0],["وَالكاشِفُ الكُرَبَ اللاتي يَحُفُّ بِها","إِظلامُ أَمرٍ عَلى البُلدانِ يَنسَدِلُ",60,"ل",1,0],["والكونُ ملحمةٌ كبرى جوانبها","دمٌ ونارٌ وإعصارٌ وظلماءُ",61,"ا",2,0],["والكافرون في قريش والبلد","لم يكن الأمر لهم على خلد",62,"د",1,0],["وَالكِرَامِ الَّذِينَ يُسْعَى إِلَيْهِمْ","وَسَعَوا عَنْ تَفَضُّلٍ وَسَخَاءِ",63,"ا",2,0],["وَالكَفِيَّ الْوَفِيَّ فِي كُلِّ حَالٍ","مُسْتَقِلاًّ بِجَهْدِهِ أَوْ وَزِيرَا",64,"ر",2,0],["وَالكَأْسُ كَالعَذْرَاءِ عَارِيَةٌ","أَلحَاظُها تَسْطُو وتَنْكَسِرُ",65,"ر",1,0],["والكهرباء هنا تشع شموسها","وسراج أكثر من هناك الأنجم ..",66,"م",1,0],["والكون قد شبَّت به جمراتُهُ","فنزلتَ قطرَ ندى على جمراته",67,"ت",2,0],["والكل خَدَّامُ الحِمَى","والعَدْلُ بينهُمُو يسود",68,"د",1,0],["والكاتِبُون لها صَحَائِفَ مَجْدِها","يَوْمَ الكَرِيهَة بالدَّمِ السَّيَّال",69,"ل",1,0],["والكل منها راحل ببضعة","من أجل مقدر على شفا",70,"ا",1,0],["والكوخ في حرق الأسى مترقّب","بشرى ترفّ عليه كالزهرات",71,"ت",1,0],["والكأسُ يجلوها أغنُّ يكاد من","فرْطِ النُعاس يؤدهُ تغميضه",72,"ض",2,0],["والكأسُ عادتْ كأسَ موتٍ ينتشي","زاهي الشبابِ بها ، ويمسحُ شاربا!",73,"ب",2,0],["و\" الكرومُ \" المُعرِّشاتُ حُبالى","مُرضِعاتٌ كرائمَ الأعناب",74,"ب",1,0],["والكلّ يسأل كيف حال إمامنا","ماذا رأى حكمائنا ، ما أخبروا ؟",75,"ر",3,0],["والكون بين الضرّتين مقسّم","فاشهد قبيلا يستبيح قبيلا",76,"ل",2,0],["والكوبُ بضحكُ كالغزالِ مسبّحا","عندَ الرُّكوعُ بلَثْغَة ِ الفَأْفَاءِ",77,"ا",2,0],["والكون في أسراره وكنوزه","للفكر لا لوغى ولا لسلاح",78,"ح",1,0],["وَالكاس مُذ بانَ عَنها تَشتَكي ظَمأ","وَالرَوض مِن حُزن جَفَت خَمائِلُهُ",79,"ل",2,0],["والكل عمتهم افاضاته","فانظر لفضل غير مخفي",80,"ي",1,0],["والكل في طمس ولولا رشة","من نور قدسك ما بدت الوان",81,"ن",1,0],["والكل في بحر المعا","مع للفناء المحض صائر",82,"ر",1,0],["والكعبة الغرا وزمزم والصفا","والبيت حتى زائر ومزور",83,"ر",1,0],["وآلك الغر أهل البيت سادتنا","والصحب أعظم قادات وشجعان",84,"ن",1,0],["وآلك الغر والصحب الأعاظم ما","إليك ركبان الباب الفحول سعت",85,"ت",1,0],["وآلك الغر والأصحاب وأنشدت","نشر العناية قد هبت نسائمه",86,"م",2,0],["والكاملُ المَجزوءُ يَزهو عندما","سَخَّرتُه لِهَواكِ أشرقَ واكتَملْ",87,"ل",1,0],["والكون غيل لعمري لست فيه أرى","غير السعالى تناجي اليوم غيلا",88,"ل",2,0],["والكذب ملح الفتى والقول أَعيبه","ما كان للصدق متناً في حواشيه",89,"ه",1,0],["والكهلَ شَارِبهُ منا وشارِبه","مِنَّا الذي هُومَا إِن طَرَّ شَارِبُه",90,"ه",1,0],["والكون يبسم ثغره ويتيه في","حللِ الهناء بوجهه المتهللِ",91,"ل",1,0],["والكنزُ أخرج 