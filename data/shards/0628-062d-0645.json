tps://www.poetsgate.com/ViewPoem.aspx?id=210875",""],[4862,"الشعر لايهدى إلى متسوّلِ","https://www.poetsgate.com/ViewPoem.aspx?id=55617",""],[4984,"عِيدِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204720",""],[5055,"حدثيني","https://www.poetsgate.com/ViewPoem.aspx?id=120914",""],[5096,"من السخف","https://www.poetsgate.com/ViewPoem.aspx?id=206911",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5370,"مسافره","https://www.poetsgate.com/ViewPoem.aspx?id=87426",""],[5528,"في هيئة العلماء زاد","https://www.poetsgate.com/ViewPoem.aspx?id=201133",""],[482,"شكايةُ الصبَّ إلى الأربُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=111423",""],[5732,"هاجوس قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177909",""],[5746,"زمّار الحيّ","https://www.poetsgate.com/ViewPoem.aspx?id=207098",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[6115,"أخزاك يالحوثي وبيت الله حماه","https://www.poetsgate.com/ViewPoem.aspx?id=196453",""],[2302,"بحمدك اللهم انهي وابتدي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605674",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""]],"verses":[["بِحَمائِلِ المَلِكِ الجَليلِ مُقَلَّدٌ","وَبِخاتَمِ النَبَإِ العَظيمِ مُخَتَّمُ",0,"م",1,0],["بِحَمزَةَ أَمسَيتُ أَلقى الخُطوبَ","وَأَرمي العَدُوَّ وَأَرقى اليَفاعا",1,"ع",2,0],["بحِمَى أبي حَمّو حطَطْتُ رَكائِبي","لمّا اختَبرْتُ اللّيْثَ والعِرّيسا",2,"س",2,0],["بِحَمدِ اللَهِ مُلكُكُمُ كَبيرٌ","وَأَنتُم أَهلُ مَرحَمَةٍ وَجودِ",3,"د",1,0],["بَحَمْدُونُ إِنْ تَنْشَقْ عَلِيلَ نَسِمِيهَا","فَإِنَّ شِفَاءَ النَّفْسِ مَا تَتَنَسَّمُ",4,"م",1,1],["بِحَمّاءَ المَدامِعِ لَم تُكَلِّف","لَها كُحلاً وَتَحسِبُهُ كَحيلا",5,"ل",2,0],["بِحَمدِ الإِلَهِ ما اِجتَباها وَأَهلَها","حَميداً وَقَبلَ اليَومِ مَنَّ وَأَنعَما",6,"م",2,0],["بحمد من شبابك لا يذم","أبا قُرَّان بت على مثالِ",7,"ل",1,1],["بِحَمدِ اللَهِ رَبِّ العالَمينا","وَحَمدِكَ يا أَميرَ المُؤمِنينا",8,"ا",1,1],["بِحُمرَةٍ في خُدودِ البيضِ مُشرَبَةٍ","وَفَترَةٍ في جُفونِ الأَعيُنِ الحورِ",9,"ر",1,0],["بِحَماسَةٍ مَقرونَةٍ بِسَماحَةٍ","وَجَلادَةٍ مَشفوعَةٍ بِجِدالِ",10,"ل",1,0],["بِحُمْرَةٍ في الجُفُونِ تحسبها","نَدَرْتُهَا في الفُؤادِ عَن جرحِ",11,"ح",1,0],["بِحَمدِ اللَهِ لَم تُخلَق كِعابٌ","تَجَنَّبُ كُلَّ مُخزِيَةٍ وَعُنفِ",12,"ف",1,1],["بِحَمدِ إِلَهي أَنَّني لَم أَكُن لَهُم","غُرابَ شَمالٍ يَنتِفُ الرّيشَ حاتِما",13,"م",2,0],["بحمد الله لي نسب علي","سما والى علي قد تعالى",14,"ل",2,0],["بحمد الله يفتتح الكلامُ","ويظفر من يروم بما يرامُ",15,"م",1,1],["بَحَمَاسٍ نرْفَعُ رَايَتَنَا","فَوْقَ الهَامَاتِ تُؤَيِّدُنَا",16,"ن",2,0],["بحمل العاسلات السمر صب","وركض العاديات إلى العداة",17,"ه",1,0],["بحمية في الله تنبى أنه","في ملكه من ربه بمكان",18,"ن",1,0],["بحَمِلي فِي عَقَارِي واكتِسَابي","عَلَى جاهٍ أَسِيرُ بهِ تُجاهِي",19,"ي",1,0],["بحمد سيرتك الامثال قد ضربت","اهذه سير في المجد ام سور",20,"ر",1,0],["بحمد سيرته الامثال قد ضريت","أهذه سيرٌ في المجد ام سور",21,"ر",1,0],["بِحِماكَ مَنشَأُها وَتَحتَ سَوابِغِ","الظِلِّ المَديدِ ثَواؤُها وَمَقامُها",22,"م",3,0],["بِحَمْدِ النَّاسِكِينَ لَهَا علَى مَا","حَوَتْ مِنْ خَصْلَتَيْ نُسْكٍ وَزُهْدِ",23,"د",1,0],["بِحَمْدِ اللهِ أَصْبَحَتِ الَّليَالِي","تَقُودُ لَكَ الأَمَانِي فِي زِمَامِ",24,"م",1,0],["بحمرة وجنته تستدل","على أنه من بني الأصفر",25,"ر",1,0],["بحمد الله يبدأ كلّ شاكرْ","بنُطق لسان أقلام المحابرْ",26,"ر",1,1],["بحمد الله مبتدئاً لهذا","غدا نظماً بمسك الختم عاطر",26,"ر",1,0],["بحَمرائها يوماً وقفتُ مُسلّماً","وأنشَدتُ شِعراً جاشَ مع عَبراتي",27,"ت",2,0],["بحماكم حماه من كل سوء","ربنا ذو الجلال والإكرام",28,"م",1,0],["بِحمدِ إلهي وَالصلاةِ عَلى الّذي","تَنبّا وَما إِن مِن سماءٍ ولا أرضِ",29,"ض",1,1],["بِحَملٍ قَد باعَتِ الشَمسُ الأَسَد","وَكانَ هَذا عِندَنا الرَأيَ الأَسَد",30,"د",1,0],["بحَمّالِ أثقالٍ إذا ارتحَلَ الفتَى","قَطوعِ طِوالٍ يَتَّصلْنَ عِراض",31,"ض",1,0],["بِحُمرَةِ خَدِّهِ لِلشَعرِ خُضرَه","وَقَد زانَ البَياضَ سَوادُ طُرَّه",32,"ر",2,0],["بحمد الله وافتنا التهاني","وناجتنا بما نهوى الاماني",33,"ن",2,1],["بِحَمد اللَهِ أَفنى السُقم جسمي","فَلا أَخشى عَلَيهِ أَن يَذوبا",34,"ب",2,0],["بحمر الحلى سود النواظر حورها","من البيض زرق الماء خضر المرابع",35,"ع",1,0],["بِحَم مَعناهُ وبالنَّجْمِ إذْ هَوى","إلى قَلبهِ المَعْمورِ بالبِرِّ والخَيْرِ",36,"ر",1,0],["بحمدك لا بحمد الناس أضحي","وكيلي ليس يكفيه وكيلُ",37,"ل",1,1],["بحَمَاسٍ وبِمَكرِ","حارسٌ بَابَ المَقَام",38,"م",1,0],["بحَمرائِكَ المُشتَاقُ لُقيَاكَ أهلُهَا","حَللتَ كما قد حلَّ في فصلِه الوَردُ",39,"د",1,0],["بِحَمدِ الإِله وَاِمرئٍ هُوَ دَلَّني","حَوَيتُ النِهابَ مِن قَضيبٍ وَتَحتَما",40,"م",2,1],["بحمد الله من أَلهَم","وعنا قد أزال الهمّْ",41,"م",1,1],["بحمد الله خلاق الوجودِ","توالى كل إنعامٍ وجودِ",42,"د",1,1],["بحمرة خدّ لا تُصابُ بِعارضٍ","وَخَمْرةِ ثَغْر لا تُعافُ لشاربِ",43,"ب",1,0],["بحمد ولي الحمد مسدي الفضائل","أؤلف نظماً فائقاً في المسائل",44,"ل",1,1],["بحمد الله نبدأ في المقال","وذكر الله في كل الفعال",45,"ل",1,1],["بحماك كل الناس أدركت المنى","وشدت حبوراً في رياض سعود",46,"د",1,0],["بحميد عودك قرت العينانِ","يا بهجة الأمصار والاوطان",47,"ن",1,1],["بِحِمى أبي الفضل اِستقرّ مكانه","وَبغابِ ليث الغاب أدركَ مربضا",48,"ض",2,0],["بِحِمى الحُسين السبط سبط المصطفى","نَم يا حميد وفُز بعيش رغيدِ",49,"د",1,0],["بحمدك رَبي قَد بَلغت مَرادي","وَزالَ غَرام كان ملء فُؤادي",50,"ي",1,1],["بِحَمدك قَد بَلّغت جلّ مَقاصِدي","وَنَلت الأَماني في طَريفي وَتالدي",51,"د",2,1],["بحمدك اللهم يا خبيرُ","يا من لهُ في ملكهِ التدبيرُ",52,"ر",1,1],["بِح