{"poems":[[83,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[48,"ترقبن الهواء بلطف رب","https://www.aldiwan.net/poem23100.html","الوافر"],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[357,"نقطة ضعفي","https://www.aldiwan.net/poem960.html",""],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[572,"أسعداني يا مقلتي ونوحا","https://www.aldiwan.net/poem69744.html","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97011","البسيط"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115267","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53219","السريع"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67877","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74048","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120283","الخفيف"],[5038,"الموصل الحدباء","https://www.poetsgate.com/ViewPoem.aspx?id=190135",""],[5092,"قراءة على خد اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=176853",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[572,"أسعِدَاني يا مقلتيَّ فَنُوحَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9204&r=&rc=61",""]],"verses":[["لَوِ اِكتَفى ساطِياً بِهَيبَتِهِ","كَفَتهُ بيضَ السُيوفِ وَالأَسَلا",0,"ل",2,0],["لَواكِ اللَهُ عَنّا حينَ بِتنا","قَريباً مِن صَريمِكِ أَو لِواكِ",1,"ك",1,0],["لو اكتسى الشعرُ لوناً لاقتصرتُ على","شعرٍ بِقاني نجيعِ القلبِ مخضوب",2,"ب",1,0],["لو أكن يا شقائي الضيف","رحيماً غفوراً لأشقاك عنفي",3,"ف",2,0],["لو أكرَمَ البحرُ السّحابَ كوَفدِه","للدُّرِّ عنّا كادَ أن لا يخْزُنا",4,"ن",2,0],["لو أكونُ التُرابَ ما كُنْتُ أَبْلَى","حِيْنَ يَهْدِي إليَّ وَجْهَا مَلِيْحَا",5,"ح",2,0],["لو أكرم الدهر من قبلي الكرام","قنعت من زمني ألا بإكرامي",6,"م",2,0],["لو اكتسبت طباق الأرض من ذهب","لما رأيت به من قربكم عوضا",7,"ض",2,1],["لواكمُ عن سقط رمل اللوى","معتسفاً بالركب عسفانا",8,"ن",2,0],["لو اكتنفتَ النَّضرَ أو مَعدّا","أو اتَّخذتَ البيتَ كهفاً مهدا",9,"د",2,1],["لواك عَلى كلّ المَنازِل خافِق","وَذكرك في كُلِّ المَحافِل عابِقُ",10,"ق",1,1],["لو اكلنا الدنيا لدى نضجها لم","يك فينا ذو تخمة مل طبه",11,"ه",1,1],["لو أكْثروا الْبُهْتانَ فيكَ لأشْرَقتْ","بغْدادُ رغْمَ ظَلامِهِمْ والشّامُ",12,"م",1,0],["لو أكملَ العشّاقُ سطرَ قصيدتي","لَسَجَنْتُ حرفي , لم أكنْ إكمالا",13,"ل",2,0],["لَوْ أَكْرَمَ البَحْرُ السَّحَابَ كَوَفْدِهِ","للدرِ عنا كاد أنْ لا يحزنا",14,"ن",2,0],["لو أكتبك شعر ومشاعر تموتين","خوفي على نفسك وخوفي عليّه",15,"ي",2,1],["لو أكونُ الترابَ ما كنتُ أبلى","حينَ أهْدَى إليَّ وَجْهاً مليحَا",16,"ح",2,0]]}