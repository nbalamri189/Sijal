/www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5505,"ماذا يَهيجُكَ مِن دارٍ بِمَحنِيَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=86279",""],[5538,"أشم النسيم بوقت الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=142639",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5652,"ماملّ منهو يرقب الصبح عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=177965",""],[5664,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=176675",""],[2430,"سل الركب عن ليل الثوية من سرى","https://www.poetsgate.com/ViewPoem.aspx?id=90266",""],[5956,"أشمشم كلَّ النساء","https://www.poetsgate.com/ViewPoem.aspx?id=181870",""],[5956,"أنا والجمال حكاياتُ حُبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=181885",""],[5956,"شمس وغيم","https://www.poetsgate.com/ViewPoem.aspx?id=183187",""],[6134,"أشمس على الأيدي حملتم وسرتم","https://www.poetsgate.com/ViewPoem.aspx?id=169577",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[469,"أشم عفيف العين واليد والمنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574749",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["أَشُمُّ مِنكَ نَسيماً لَستُ أَعرِفُهُ","أَظُنُّ شَمياءَ جَرَّت فيكَ أَردانا",0,"ن",2,0],["أَشُمُّ بِبابِلَ بَوَّ الصَغارِ","وَلَو أَنا بِالرَملِ لَم أَفعَلِ",1,"ل",1,1],["أَشَمُّ كَعالِيَةِ السَمهَريِّ","وَهِمَّتُهُ مِنهُ أَغلى وَأَعلى",2,"ل",2,0],["أشَمُّ المُعَذَّرِ ضافي السّبي","بِ عالي السَّراةِ سَليمُ الشّظى",3,"ا",1,0],["أشَمْسَ الدّينِ لا قُرِنَتْ لقِرْنٍ","فقَرْنُ الشّمسِ معْروفٌ شَهيرُ",4,"ر",1,0],["أَشمَتِّ بي فيكِ العِدا","وَبَلَغتِ مِن ظُلمي المَدى",5,"د",2,1],["أَشَمساً أَشرَقَت مِن عَبدِ شَمسٍ","أَما لَكَ في سِوى قَلبي أُفولُ",6,"ل",1,0],["أَشَمُّ مِنَ الغادينَ في كُلِّ حُلَّةٍ","يَميسونَ في صِبغٍ مِنَ العَصبِ مُتقَنِ",7,"ن",1,0],["أَشَمُّ عَميمٌ في العَمامَةِ أَظهَرَت","حِزامَتُهُ أَجلادَ جِسمٍ يُعينُها",8,"ن",3,0],["أَشَمُّ أَغَرُّ أَزهَرُ هِبرِزِيَّ","يَعُدُّ الراغِبينَ لَهُ عِيالا",9,"ل",2,0],["أشماتاً بالمسلمين وقد دا","رت عليهم بنحسها الأيام",10,"م",1,0],["أَشَمَّ طُوالَ الساعِدَينِ تَرى لَهُ","إِذا القَومُ هابوا القَومَ أَن يَتَقَدَّما",11,"م",2,0],["أَشَمَّ طَويلِ الساعِدينَ سَمَيذَعِ","مُعيدٍ قِراعَ الدارِعينَ مُكَلَّمِ",12,"م",1,0],["أَشمارُ سِرّي إِلَيكَ حَتّى","فَنَيتُ عَنّي وَدُمتَ أَنتَ",13,"ت",1,0],["أَشَمُّ طَويلُ الساعِدَينِ كَأَنَّهُ","يُحاذِرُ خَوفاً عِندَهُ وَيُحاذِرُ",14,"ر",1,0],["اشمط الرأس مثلما سار ماش","تحت شجراء بين ظل وشمس",15,"س",1,0],["أَشُمُّ عَلى طَودٍ أَشَمَّ كِلاهُما","مَنونُ المُفاجي وَالحِمامُ المُرَحِّبُ",16,"ب",1,0],["أَشمَتَ الخُلفُ بِالشَراةِ عِداها","وَشَفى رَبَّ فارِسٍ مِن إِيادِ",17,"د",1,0],["أَشمَتَّ أَعدائي وَأَخرَجتَني","عَن سَيبِكَ المُغدى عَلَيَّ المُراح",18,"ح",1,0],["أشَمُّ تُبدي الحصونُ الشُّمُّ طاعتَه","خوفاً ويَسلَمُ من فيها ويَرتَحِلُ",19,"ل",1,0],["أَشمَتَني بِالصَدِّ بَعدَ شِدَّةٍ","وَمَن تَغَنّى في الهَوى تَهَنّا",20,"ن",2,0],["أَشَمسَ الدينِ كَم مِن شَمسِ فَضلٍ","بِها جَلَّت يَداكَ ظَلامَ ظُلمِ",21,"م",1,0],["أشَمُّ قديمُ تراثِ العُلى","يراجِحُ بالحلم منه شَماما",22,"م",2,0],["أَشَمُّ أَصيَدُ تَكوي الصيدَ غُرَّتُهُ","كَيّاً وَأَشوَسُ يُعشي الأَعيُنَ الشوسا",23,"س",2,0],["أَشَمُّ شَريكِيٌّ يَسيرُ أَمامَهُ","مَسيرَةَ شَهرٍ في كَتائِبِهِ الرُعبُ",24,"ب",1,0],["أَشَمسٌ في غِلالَةِ أُرجُوانِ","وَبَدرٌ طالِعٌ في غُصنِ بانِ",25,"ن",1,1],["أَشمُّ كَأَنَّما حَدَبَت عَلَيهِ","بَنو الأَملاكِ تَكنَّفُها القُيولُ",26,"ل",1,0],["أَشَمُّ كَثيرُ بَوادي النَوال","قَليلُ المَثالِبِ وَالقادِحَه",27,"ح",2,0],["أَشَمُّ طُوالُ الساعِدَينِ كَأَنَّما","يُناطُ نِجاداً سَيفِهِ بِلِواءِ",28,"ا",2,0],["أَشَمساً أَعَرتَ الكَأسَ أَم هِيَ لَمعَةٌ","مِنَ البَرقِ أَم أَقبَلتَ بِالكَوكَبِ السَعدِ",29,"د",1,0],["أَشمَتَّ حُسّادي بِبُغيَتِهِم","وَرَفَعتَهُم وَدَعَوتَهُم بِاِسمي",30,"م",2,0],["أشمِّتها ببوركَ فيك منّى","لتترك فيَشتي رأساً براس",31,"س",1,0],["أَشمَسَ نَهاري كَم خَلَت لَكَ حِجَّةٌ","فَهَل لَكَ مِن خالٍ فَيُعرَفَ أَو عَمِّ",32,"م",1,0],["أَشمِمنا لِبُنى فَقُلنا لُبَينى","بَعدَما أَزمَعَت صُدوداً وَبَينا",33,"ن",2,1],["أَشَمُّ طَوِيلُ السَاعِدَينِ سَمَيدَعٌ","إِذا لَم يَرُح لِلمَجدِ أَصبَحَ غادِيا",34,"ي",2,0],["أشمُّ بأنفاسها رغبةً","ويهتفُ بي جفنُها المنكسرْ",35,"ر",1,0],["أشمّ الأنف أبلج سمهريّ","كأنّ على محيّاه صباحا",36,"ح",2,0],["أَشَمَّ كأَنَّه أَسَدٌ عَبُوسٌ","غَداةَ نَدَى ببَطنِ الجِزعِ غادِي",37,"د",2,0],["أَشمسُ عُلاهُم الزَهراءُ غابَت","أَبحَرُ نَداهُمُ السَلسالُ غاضا",38,"ض",2,0],["أشمست فيه الليالى .. والمدى","يثريات دواليه اتّثح",39,"ح",1,0],["أشمل جسمي واعدي على روس الهضاب","كل ماضيعت وجهي دريت إنه جنوب",40,"ب",1,0],["أشْمَتَّ أعدائي، وَأخرَجْتَني","مِنْ سَيْبِكَ المُغدَى عَليّ المُرَاحْ",41,"ح",1,0],["أشمّ عبيرا من ترابك عاطرا","أمنك استعار العطر والنضرة الترب",42,"ب",1,0],["أشمّ الرمال السمر : في كلّ حفنة","من الرّمل ، دنيا من هوى وطيوب",43,"ب",1,0],["أَشُمُّ النَّدَى في جِراحاتِه","يُعَطِّرُ بِالمِسكِ رُوحي دَمُهْ",44,"ه",1,0],["أشمسَ الحياةِ اغربي","ولا تُمهليني لِغَد",45,"د",1,0],["أشمسَ الحياةِ اسرعي","وغِيبي فأنتِ خَيال",45,"ل",1,0],["أشمسَ الخُلودِ اسطَعي","اليكِ اليكِ المآل",45,"ل",1,0],["أَشَمُّ مِنَ الشُمِّ البَهاليلِ يَنتَمي","إِلى حَسَبٍ في حَومَةِ المَجدِ فاضِلِ",46,"ل",1,0],["أَشمَتَّ بي الأَعداءَ حينَ هَجَرتَني","حاشاكَ مِمّا يُشمِتُ الأَعداءَ",47,"ا",2,0],["أشمُّ طويل الباع مستغزر الّلهى","أغرّ عريض الجاه جمُّ الفضائل",48,"ل",1,0],["أشموسٌ أم بدورُ","أم عيونٌ أم ثغورُ",49,"ر",1,1],["أَشَمُّ هُبَيرِيُّ المَناسِبِ يَعتَزي","إِلى خَيرِ بَيتٍ في أَعَزِّ قَبيلِ",50,"ل",1,0],["أشمال ويحك بلغي تسليمي","من ليس يبلغه لنا تسليم",51,"م",1,1],["أَشَمْسَ الأَنامِ وَمَوْلى الْكِرامِ","وَتِرْبَ الْغَمامِ وَرَبَّ الزِّماعِ",52,"ع",1,0],["أَشَمَّ أَشْوَسَ مَضْرُوباً سُرادِقُهُ","عَلى الْمَالِكِ مُرْخٍ دُونَها الْحُجُبا",53,"ب",2,0],["اِشمَخ بِأَنفٍ شامِخٍ آنِفٍ","فَأَنتَ وَالمَجدَ رَضيعا لِبان",54,"ن",1,0],["أَشَمسُ سَناها في الدُّجُنَّةِ بازغُ","عَلَيها 