37.html","الطويل"],[413,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[413,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[413,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[426,"هو الحب في العشاق ينفذ ما يقضي","https://www.aldiwan.net/poem39881.html","الطويل"],[434,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[434,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[434,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[436,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[436,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[436,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[438,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[438,"وداعا أيها الشهر الوداعا","https://www.aldiwan.net/poem14377.html","الوافر"],[438,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[438,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[438,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[438,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[446,"ألام على الخلاعة إذ شبابي","https://www.aldiwan.net/poem53739.html","الوافر"],[451,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[451,"دماء لا تجف وإن أريقت","https://www.aldiwan.net/poem61750.html","الوافر"],[456,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[456,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[462,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[468,"وما الشعر إلا خطبة من مؤلف","https://www.aldiwan.net/poem4802.html","الطويل"],[475,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[475,"أعيدوا حديث الظاعنين على سمعي","https://www.aldiwan.net/poem15344.html","الطويل"],[480,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[480,"وأعلم حقا أن بعدي عنكم","https://www.aldiwan.net/poem24416.html","عموديه"],[480,"تباعد عني الأصل والوطن الذي","https://www.aldiwan.net/poem24439.html","عموديه"],[504,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[527,"كذا فليكن رزء العلى والعوالم","https://www.aldiwan.net/poem37212.html","الطويل"],[536,"إذا ذكر المثقف من شباب","https://www.aldiwan.net/poem47958.html","عموديه"],[549,"ألا رب أمر بت أحذر غبه","https://www.aldiwan.net/poem47252.html","الطويل"],[549,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[549,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[549,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[549,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[549,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[560,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[574,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"]],"verses":[["وَمَن ذا الَّذي تُمسي مِنَ الدَهرِ جارَهُ","فَيَقبَلَ لِلمِقدارِ إِن رابَهُ عُذرا",0,"ر",2,0],["ومن ذا تُثني الريحُ؟ هل غير واحدٍ؟","وكان هو اللاغي، وسمعُ الذي صغى",1,"غ",2,0],["وَمَن ذا يَرُدُّ المَوتَ أَو يَدفَعُ القَض","وَضَربَتُهُ مَحتومَةٌ لَيسَ تَعثَرُ",2,"ر",1,0],["ومَنْ ذَا لهُ جَدٌّ كجَدِّكَ أوْ أبٌ","إذا عدّدَتْ آباءَهُنّ التّبابِعُ",3,"ع",1,0],["ومنْ ذابِلٍ يحْكي المُحبّينَ رِقّةً","فيَثْني إذا ما هَبَّ عَرْفُ الصَّبا قَدّا",4,"د",2,0],["وَمَنْ ذَا لَهُ فَخٌر كَسَعْدٍ عَلَى الْوَرَى","فَسَعْدٌ وَزِيرٌ للنَّبِيّ وَصَاحِبُ",5,"ب",1,0],["وَمِنْ ذِي مَضَاءٍ وَمِنْ ذِي إِباءٍ","وَمِنْ أَرِيْحِيٍّ جَوَادٍ رَحِيمِ",6,"م",1,0],["وَمَن ذا المُواتي لَهُ دَهرُهُ","وَمَن ذا الَّذي عاشَ لا يُنكَبُ",7,"ب",1,0],["ومن ذكرها في كل عصر وموطن","ستستنشق الأيام أطيب من ورد",8,"د",1,0],["ومن ذي دلال رنّح الحسن عطفه","إلى أن رجا من حسنه عطفه الرفقا",9,"ق",2,0],["ومَن ذَرَفت آماقه الدمعَ لؤلؤاً","ذرفت عليها أدمُعي وهي مَرْجان",10,"ن",1,0],["وَمِن ذُبيانَ تَمَّ لَكُم بِناءَ","عَلى عَلياءِ ذو شَرَفٍ مَشيدُ",11,"د",1,0],["وَمَن ذا الَّذي يَبقى عَلى العَهدِ إِنَّهُم","وَإِن كَثُرَت دَعواهُمُ لَقَليلُ",12,"ل",1,0],["وَمَن ذا يَلُفُّ الجَيشَ مِن جَنَباتِهِ","وَمَن ذا يَقودُ الشُمَّ أَو يَصدُمُ القَلبا",13,"ب",2,0],["ومن ذا الذي يدري حُلا ما أقوله","سواكَ ومن يدري سوايَ حلاكا",14,"ك",2,0],["ومن ذا الذي يعْفُو نداك بشافِعٍ","ويصحبُهُ عند انْتِجاعِكَ مِزْوَدُ",15,"د",1,0],["ومن ذاك ذَمَّ الصالحون أمورَهُ","وقالوا جميعاً صالحُ الدهر فاسدُ",16,"د",1,0],["ومن ذاك ما أَولاكه وهو بادئٌ","ومن ذاك ما أَبلاكه وهو عائدُ",16,"د",1,0],["ومن ذا يُحامي عن ذِماريَ غائباً","أشدَّ محاماةِ امرئٍ عن ذِماره",17,"ر",2,0],["ومن ذا تظلُّ النفسُ عند مغيبه","معلَّقَةً آمالُهما بانتظاره",17,"ر",2,0],["ومن ذا يُدَبِّرنا غيرُهُ","ومن يُبرمُ الأمرَ أو ينقضُ",18,"ض",1,0],["ومن ذا يرى قردة","تُغنّي فلا يسخُف",19,"ف",1,0],["وَمَن ذا الَّذي أَرضى بِهِ لِمَحَبَّتي","فَتَحسُنَ فيهِ لَوعَتي وَحَنيني",20,"ي",1,0],["وَمَن ذا الَّذي أَعتاضُ مِنكُم لِفاقَتي","مِنَ الناسِ طُرّاً ساءَ ما أَتَوَهَّمُ",21,"م",1,0],["وَمَن ذا الَّذي يُرضيكَ مِنهُ فَطانَةٌ","تَقولُ فَيَدري أَو تُشيرُ فَيَفهَمُ",21,"م",1,0],["وَمَن ذا رَأى غابَةً كافَحَت","فَرَدَّت مِن الأَسرِ رِئبالَها",22,"ل",3,0],["وَمَن ذا الَّذي يَقضي حُقوقَكَ كُلَّها","وَمَن ذا الَّذي يُرضي سِوى مَن تُسامِحُ",23,"ح",1,0],["وَمِن ذَكِيِّ المِسكِ بِالدَمالِ","لَو سُرِّحَت في عارِضَي مُحتالِ",24,"ل",1,0],["ومن ذا الذي يرضَى إن اعتاضَ كفُّهُ","يواقيتَ حُمْراً من أنامِلهَا العشْرِ",25,"ر",1,0],["وَمَن ذا يَلومُ البَحرَ أَن باتَ زاخِراً","يَفيضُ وَصَوبَ المُزنِ أَن باتَ يَهطِلُ",26,"ل",1,0],["وَمَن ذا عَلَيها لَيسَ مُستَوحِشاً بِها","وَمُغتَرِباً فيها وَإِن كانَ ذا أَهلِ",27,"ل",1,0],["وَمَن ذا الَّذي يَنجو مِنَ الناسِ سالِماً","وَلِلناسِ قالٌ بِالظُنونِ وَقيلُ",28,"ل",1,0],["وَمَن ذا يَفوتُ المَوتَ وَالمَوتُ مُدرِكٌ","كَذا لَم يَفُت هارونَ ضِدٌّ يُنافِرُه",29,"ر",2,0],["وَمِنذُ رَفَعتَ صَوتَكَ لي دَليلاً","فَكانَ لِنَصبِ قَدرِكَ مِنهُ خَفضُ",30,"ض",1,0],["ومن ذا رأى هيكلاً في الوجود","يُقام على عمدٍ من دموع",31,"ع",1,0],["ومن ذا يردُّ البحرَ عن فَيْضِ مَدّهْ","إذا عبّ منه بالجنائب ما عبّا",32,"ب",2,0],["وَمَن ذا يُداني أَو يُنائي وَهَل فَتىً","يَحُلُّ عُرى التَرحالِ أَو يَتَرَحَّلا",33,"ل",2,0],["وَمَنْ ذَا الَّذِي يَقْوَى عَلَى دَفْعِ مَا أَتَى","بِهِ الْحُبُّ مِنْ جوْرٍ وَسُلْطَانُهُ أَقْوَى",34,"و",2,0],["ومَنْ ذا الذي نرضاهُ بعدَكَ حاكماً","يعزُّ علينا أم بمنْ نتعرَّفُ",35,"ف",1,0],["ومن ذا يشتهِي الموتَ الفظيعا","نساءَ الحيِّ ما صنعَ الرجالُ",36,"ل",1,0],["وَمُنْذُ ألزَمْتُ أفكارِي مَدائِحَهُ","وَجَدْتُهُ لِخَلاَصِي خيرَ مُلْتَزِمِ",37,"م",1,0],["ومن ذاك أضْنيتَ صرفَ الزمان","فلم يُخفِهِ عنْكَ إلا الضّنى",38,"ا",1,0],["وَمَن ذا الَّذي يَنضو لِباسَ بَقائِهِ","نَقِيَّ بَياضٍ لَم يُدَنِّس لَهُ زِرّا",39,"ر",2,0],["ومَن ذا رَبيعُ المُسْلِمينَ يَقُوتُهُم","إِذا النَّاسُ شامُوها بُرُوقا كَواذِبَا",40,"ب",2,0],["وَمَن ذا يَرُدُّ المَوتَ أَو يَدفَعُ القَضا","وَضَربَتُهُ مَحتومَةٌ لَيسَ تَعثَرُ",41,"ر",1,0],["وَمَنْ ذَلَّ خَوْف الْمَوْتِ كَانَتْ حَيَاتُهُ","أَضَرَّ عَلَيْهِ مِنْ حِمَامٍ يَؤُدُّهُ",42,"د",2,0],["ومن ذا يجيبُ القناةَ إذا ما","أهابت بفارسها المدَّخَر؟",43,"ر",1,0],["ومن ذا يطاولُ منهم فتى","بليغَ اليراعةِ، عذبَ اللسان؟",44,"ن",1,0],["ومن ذا له جد كجدك أو أب","إذا عددت آباءهن التتابع",45,"ع",1,0],["ومن ذا يُحامي عن ذِماريَ غائباً","أشدَّ محاماة ِ امرىء ٍ عن ذِماره",46,"ر",2,0],["ومن ذا تظلُّ النفسُ عند مغيبه","معلَّقة ً آمالها بانتظاره",46,"ر",2,0],["ومن ذكر الرحيل وضاء قلبا","يرى عن زخرف الدنيا اشتغالا",47,"ل",2,0],["وَمَن ذا يَمَلُّ الحَربَ مِنّي وَمِنهُمُ","وَيحمدُ في الآفاقِ مِن قَولِ قائِلِ",48,"ل",1,0],["ومن ذا كفخر الدولة اتامها له","وما كلُّ نجم في السماء منيرُها",49,"ر",3,0],["وَمُنذُ دَنَت دارُ المُبيرِ مُبيرِهِم","فَأَمنُهُمُ جَزوٌ وَخَوفُهُمُ مَدُّ",50,"د",1,0],["وَمُنذُ نَصَرتَ الدينَ ذَلَّت جُيوشُهُ","مُظَفَّرَةَ الراياتِ مَنصورَةَ الجُندِ",51,"د",1,0],["وَمُنذُ بَوَّأتَهُم رِضاكَ نَسوا","مَن أَقصَدَتهُ الظُبى بِمَن قَصَدوا",52,"د",3,0],["وَمُنذُ أَخَفتُ الدَهرَ لَم يَعدُ حادِثٌ","وَلَم يَدمَ لِلأَيّامِ نابٌ وَلا ظُفرُ",53,"ر",1,0],["وَمُنذُ اِصطَفاكَ المُلكُ أَلفاكَ مَوئِلاً","لَهُ وَلَنا فيما أَلَمَّ وَمَفزَعا",54,"ع",2,0],["ومن ذا الذي تُعيِيهِ أوجهُ مطلب","تناولها مستشفعاً بمحمد",55,"د",1,0],["ومن ذا الذي يرجو سواك ولم تزل","لفضلك فينا أنعمٌ تتجدد",56,"د",1,0],["ومن ذا الذي غذَّاك تسعة أشهرٍ","وأمُّك لا حس لديها ولا علم",57,"م",1,0],["ومن ذا الذي ربَّاك حولين راضعاً","ولا مشربٌ إلاَّ لبان ولا طعم",57,"م",1,0],["ومن ذا الذي نَجَّاك من شرّة الصبا","وهرك رام ما يصيب له سهم",57,"م",1,0],["ومن ذا الذي ألقى عليك محبةً","تعاورها في حقك لاأب والأم",57,"م",1,0],["ومن ذا الذي أعطاك عقلاً وفطنةً","فشاع لك الوصف المشهر والاسم",57,"م",1,0],["ومن ذا الذي لقَّاك رشدَكَ يافعاً","فأقررت بالتوحيد إذ جحد الخصم",57,"م",1,0],["وَمَن ذا يَعُدُّ الرَملَ في عَرَصاتِهِ","دأبتُ عَلى الإِيرادِ مِن مُعجِزاتِهِ",58,"ه",1,0],["وَمَن ذا يَكيلُ البَحرَ وَالبَحرُ مُزبِدُ","لَقَد خابَ مَن رَدَّتهُ كَفُّ سَماحِهِ",58,"ه",1,0],["ومن ذا مخادع أبدا له","محاله محى له محاله",59,"ل",2,0],["ومن ذا الذي يبقى ليلقى متوجا","إذا سار سار الرعب قدامهشهرا",60,"ر",2,0],["وَمَن ذا الَّذي أَرضى عَطاياهُ أَو أَرى","يُزاحِمُني في سُدَّةِ البابِ حاجِبُهْ",61,"ب",2,0],["وَمن ذا يُسامي مُرَّةً وَبِهِ سَمَت","بَنُو عامِرٍ عِزّاً وَجازَ اِغِتشامُها",62,"م",3,0],["وَمَن ذَلَّ لَم يَعدَم غَشُوماً يَسُومُهُ","أَذىً فَيُرِيهِ النَبعَ خَوفاً ثُمامُها",62,"م",3,0],["وَمِن ذكرِهِ ما يَعجَزُ الدَهرُ سَلبَهُ","وَمِن شُكرهِ في كُلِّ ذي مَنطقٍ فَمُ",63,"م",1,0],["وَمِن ذَخائِرِ أَسرارٍ لَو اِنتَصَفَت","لَزارَها كُلُّ قاصي الدّارِ مُحتَفِلا",64,"ل",2,0],["وَمَن ذاقَ طَعمَيْ حالتيْهِ فَلَم يَكُنْ","لِيَحفلَ لِلأَيّام خِلّاً وَلا خَمرا",65,"ر",2,0],["ومن ذا الذي لولا التجلّد قادرٌ","على منعها وهي اللجوج علوق",66,"ق",1,0],["ومن ذا الذي من حادث الدهر سالم","ومن ذا الذي يحيا إذا الدهر رافع",67,"ع",1,0],["ومن ذا الذي من صاحب ومعاشر","وجدت وفيّا عند دور الدوائر",68,"ر",1,0],["وَمَن ذا رأى في الناسِ شَخصاً مُعادياً","فَتىً بمعالي جدّهِ أنفقَ العمرا",69,"ر",2,0],["وَمَن ذا الّذي يختارُ أرضاً وبيئةً","عَلى روضةٍ صحّ الهواء بها خضرا",70,"ر",2,0],["وَمَن ذا يُطيقُ الفيضَ مِن بحرِ جودهِ","وَحسبُ جميعِ الخلقِ من غيثه نقطُ",71,"ط",1,0],["ومن ذا الذي يَنْهَى المدامعَ بعدما","رأى الموتَ في روض الشبابِ يَرودُ",72,"د",1,0],["ومنذُ طووا فيهِ شبابكِ لم يزلْ","تلوحُ عليهِ مسحةٌ من شبابكِ",73,"ك",1,0],["ومن ذا غرّهُ التحسينُ إني","رأيتُ الشمسَ لا تحتاجُ غازا",74,"ز",2,0],["ومن ذي غنىً يشكو إلى الله أمرهُ","وقد باتَ محتاجاً إلى الناسِ معدما",75,"م",2,0],["ومن ذاتِ خدرٍ لم تجدْ غيرَ كفِها","نقاباً ولم تترك لها النارُ محتمى",75,"م",2,0],["ومن ذا الذي يخشى صروف زمانه","وانت له يوما ولي وناصر",76,"ر",1,0],["ومن ذوائبه ليلا ابان لنا","ومن محياه قد ابدى لنا قمره",77,"ر",2,0],["ومن ذا الّذي يرعاك عنّي بوُدّه","على كلّ غيب أو بكلّ عِيان",78,"ن",1,0],["ومن ذا الذي ناداك للجودِ واعتفى","نَداك فلم يَظْفَرْ بنُجْح ويُرْزَقِ",79,"ق",1,0],["وَمُنْذُ حَلَّبْتُهَا بِدَرِّ مَدْحِكُمُ","لَمْ يَبْقَ فِي الْقَلْبِ لَا رَيْنٌ وَلاَ صَدَأُ",80,"ا",1,0],["ومن ذل خوفاً لا يطيعك رغبة","إذا زالت الاسباب زال المسبَب",81,"ب",1,0],["ومنذ رأى عبد العزيز نساءه","حواليه أغضى عنه وهو يؤنب",81,"ب",1,0],["وَمَن ذا الَّذي أَشكو لَهُ سوءَ فاقَتي","وَيَعلَمُ قَبلَ المُشتَكَى سوءَ حالِيا",82,"ي",2,0],["ومن ذلة بالمرء أن يترك الفلا","مفيحة الأرجاء ويسجن بالمدن",83,"ن",1,0],["ومن ذا الذي إن أنت وفيت عهده","وفالك أو راعيت جانبه رعا",84,"ع",2,0],["ومن ذا يردُّ الموتَ عنهُ وقد سطا","على كلِّ ذي عرشٍ وجيشٍ مدرَّع",85,"ع",1,0],["وَمن ذا يردُّ البحرَ في هَيَجانهِ","إذا اصطخَبت أمواجُهُ فتزّخرا",86,"ر",2,0],["ومِنْ ذَرْوَة البَيْتِ العَتيقِ بِنَاؤُه","عَلَى شَرَفٍ للنّيراتِ مُنَاطِح",87,"ح",1,0],["وَمَنْ ذا يَراكَ فَيَدْعُو سِوا","كَ يَوْماً لِخَطٍْ إِذا يُرْمِضُ",88,"ض",1,0],["وَمَنْ ذا يُجارِيكَ فَضْلاً وَنُبْلاً","وَمَنْ ذا يُساوِيكَ حَلاًّ وَعَقْدا",89,"د",2,0],["وَمَنْ ذا الَّذِي يَأْمَنُ النّائِباتِ","وَقَدْ أَنْشَبَتْ فِيكَ أَظْفارَها",90,"ر",3,0],["وَمَنْ ذا يُكَثِّرُ حُسّادَها","وَمَنْ ذا يُقَلِّلُ أَنْظَارَها",90,"ر",3,0],["وَمَنْ ذا يُطِيلُ قِراعَ الْخُطُو","بِ حَتّى يُقَصِّرَ أَعْمارَها",90,"ر",3,0],["وَمَنْ ذا الّذِي يَحْلُو لهُ الْعَيْشُ بَعْدَما","رَأَتْ كُلُّ نَفْسٍ أَنَّ هذا سَبِيلُها",91,"ل",3,0],["ومن ذا يزيل اللبسَ في متشابهٍ","ومن ذا يزيحُ الشك عن متشابك",92,"ك",1,0],["ومن ذاق ذاك المبسم العذب أو رأى","حلاوة فيه ما يطيب له الصبر",93,"ر",1,0],["ومن ذكرهم أنسنا في الظلام","ونور لنا بين هذا الأنام",94,"م",1,0],["ومن ذا الذي يرجو البقا بعد أحمد","نبي الهدى من نوره يخجل الشمسا",95,"س",2,0],["وَمَن ذُلّل بلقٍ تَرى الصبحَ والدجى","قَدِ اِبتَدراها يَمسحانِ فراً شمطا",96,"ط",2,0],["وَمنذُ رَأته أَحرزها جميعاً","بِرافِع سمكهِ طفقت تحيدُ",97,"د",1,0],["ومن ذا الذي خصصت منك بحكمة","ولم تك قد عممت منك برحمة",98,"ه",1,0],["وَمَن ذا الَّذي يَأبى لَدَيهُنَّ حَتفَهُ","وَكُلُّ قَتيلٌ بَينَهُنَّ شَهيدُ",99,"د",1,0],["وَمِن ذا لَعَمري لا يَقدِرُ قَدرَكُم","وَما ثَمَّ في الدُنيا سِوى الجَدِّ أَحلى لَك",100,"ك",1,0],["وَمَن ذا الَّذي مِن دَأبِهِ بَذل سَعيهِ","بِنَفعِ مُحبّيه كَما هُوَ مِن دَأبي",101,"ب",2,0],["وَمَن ذَا يُجَارِي الشُّهبَ فِي حَلَبَاتِهَا","إذا حَثّها نَحوَ المَغِيبِ خَفوقُ",102,"ق",1,0],["ومِن ذَكْرَةٍ لعهودِ الصِّبا","ومن لَفْتةٍ لسَلوبٍ رَؤوم",103,"م",1,0],["ومن ذوائبِ أنفاسٍ وصَلْتُ بها","ُحشاشةَ اللّمْعِ جُنْحَ اللّيلِ فانتَهضا",104,"ض",2,0],["وَمَن ذا الَّذي يُملا بِهِ خَلوَةُ الهَوى","وَفي رَوضَةِ التَذكارِ ماذا يُفَجَّرُ",105,"ر",1,0],["وَمَن ذا عَلى قَلبِ الحَبيبِ وَدونَهُ","مِنَ الغَيظِ أَغلاقٌ تُرى يَتَسَوَّرُ",105,"ر",1,0],["ومَن ذا الَّذي جَعلَ القائِلي","نَ يَوماً يُقاسونَ بالفاعِلِ",106,"ل",1,0],["وَمُنذُ أَبصَرَ وَرد الرَوض وَجنَتُهُ","بَدا الذُبول عَلى أَوراقِهِ حَسَدا",107,"د",2,0],["وَمِن ذَهَبٍ يَلوحُ عَلى تَريبٍ","كَلَونِ العاجِ لَيسَ بِذي غُضونِ",108,"ن",1,0],["ومن ذا الذي أدعوه وأسأله","ومن أطلبه عند سد الحيل",109,"ل",1,0],["وَمَن ذا يُوَدِّعُ هذا الجنابِ","فَتَهنَؤُهُ بَعده العافِيَه",110,"ي",2,0],["ومن ذرات كثبان الصحارى","إذا زحفت بها كف الهُبوب",111,"ب",1,0],["ومَنْ ذا أَثقل الأَعناقَ حملاً","وخفَّ لِحُزنِه العقلُ الرَّصين",112,"ن",1,0],["ومَنْ ذَا سواه يُرى قائماً","عَلى الحوضِ يَسْقي الوَرى عن يَدِ",113,"د",1,0],["ومَنْ ذا غدا حبُّه في الورى","دَلِيلاً على شرفِ المولدِ",113,"د",1,0],["ومَنْ ذا الّذي قد نابَ عَنيِّ عندَكُمْ","فأبدعَ مَنحوتاً وأغربَبَ مَنجورا",114,"ر",2,0],["ومُنذُ قالَ الوَرى هذا حبيبُهمُ","ما مرَّ يوماً بفكري ما يَريبُهمُ",115,"م",1,0],["ومنذُ قَدِمْتَ مدعوًّا إليها","أَرَحْتَ بما قَدِمْتَ به العبادا",116,"د",2,0],["ومنذُ أطعتُ الحبّ فيه صبابة","عَصَيْتُ عذولي في هواه ولائمي",117,"ي",1,0],["ومن ذا قضى بالظنّ يوماً على امرئٍ","وحسبُك حكمُ الله قاضٍ وفاصل",118,"ل",1,0],["ومن ذا الَّذي يدنو إليك مبارزاً","وأنتَ على أنْ تصرع اللَّيث قادر",119,"ر",1,0],["ومن ذا الَّذي يُرجى سواك ويتَّقى","نزالاً لعمري تارةً ونوالا",120,"ل",2,0],["ومنذُ رأيتُ اليُمن طوعَ يَمينه","وَجَدْتُ يَساري حاصلاً في يساره",121,"ر",2,0],["ومنذ عادوا فقد عادوا لمهلكة","لِما نُهوا عنه من بغيٍ ومن وطر",122,"ر",1,0],["ومنذ تولى أمور العراق","وكفَّ يَدَيْ ظلم عدوانها",123,"ن",3,0],["ومنذُ وجَدتُ من همِّي رسيساً","إلى روحي وأعوزني ارتياحي",124,"ح",2,0],["ومن ذلك الفرع الأثيث بنفسجٌ","حكى خد معشوقٍ تأثر بالعض",125,"ض",1,0],["ومن ذا يستطيع لكم مراما","إلى العليا وشأوكم بعيد",126,"د",1,0],["ومن ذا يستطيع لكم مديحا","إذا ذكرته ياسينُ دنونُ",127,"ن",1,0],["ومن ذا يروم الفخر غيرك إن دعا","دعوت الرسول المصطفى ثمّ حيدرا",128,"ر",2,0],["ومَنْ ذا سواك لرُزْءٍ جليلٍ","تُسَلِّيهِ أو لمقامٍ فَظيعِ",129,"ع",1,0],["ومَنْ ذا لداعِ لا يُجابُ دُعاؤُهُ","سِواكَ وعانٍ لا يُفَكُّ إسارُهُ",130,"ر",2,0],["ومَنْ ذا يَا مليكاً مُسْتَجاراً","سِواءَكَ للغريبِ المُسْتَضَامِ",131,"م",1,0],["ومَنْ ذَعَرَ الأَعْداءَ حَتَّى توهَّمُوا","بِهِ الصُّبحَ جَيْشاً والظَّلامَ لَهُ دَهْيا",132,"ي",2,0],["ومَنْ ذا يُناوِيهَا وأَنت أَميرُها","ومن نسْلِكَ الزاكي الكريمِ وزيرُها",133,"ر",3,0],["ومن ذا لائمي إن رحت ماش","لليلى والنعال ولو خدودي",134,"د",2,0],["ومن ذا فيك لائمنا إذا ما","بكينا بعد فرقتك التياعا",135,"ع",2,0],["ومن ذا لائمي مما ألاقي","ومن لي بالولوع وبالولوق",136,"ق",1,0],["ومن ذا قائد لهمو السبايا","وسائق كل برك ذي هجام",137,"م",1,0],["ومن ذا يتقي عنهم بمال","وروح وهي غالية المسام",137,"م",1,0],["ومن ذا يدفع الجلى بعزم","ورأي كالقضا ماضي العزام",137,"م",1,0],["ومن ذا يرد السحب عن سح مائها","عليك فمنها الحزن قد شق من حزن",138,"ن",1,0],["ومن ذا لائمي إن عشت أبكي","عليك محمد ما دمت حيا",139,"ي",2,0],["ومن ذهبت بجدته الليالى","فلا عجبا اذا أضحى خليعا",140,"ع",2,0],["ومن ذا يُعزّى في النبيين آلهم","وينسى شعوباً حُّظها اليأسُ والخطر",141,"ر",1,0],["ومن ذا الذي منا يؤبن فضله","بأبلغَ من نفحِ الخمائلِ والنَّهر",141,"ر",1,0],["وَمن ذا يغسلُ الأدرانَ عنَّا","وعاراً لا يزول ولا يَخُّف",142,"ف",1,0],["ومن ذا يُرسل الطعنات بكراً","تدف العباثينَ ولا تدف",142,"ف",1,0],["ومن ذا يشترى الخلدَ احتساباً","ولا يدعُ الدماءَ سُدىً تجُّف",142,"ف",1,0],["ومن ذا إن شردتُ يرد","دُ ما أرسلتُ من خُطُمي",143,"م",2,0],["ومَن ذا قائلٌ خذْ أو تحكَّمْ","إذا أنا قلتُ هَب أو قلتُ هاتِ",144,"ت",1,0],["ومن ذا يعي صوتي ويعتدّ نُصرتي","جهاداً وودّي من وشيج المَنَاسبِ",145,"ب",1,0],["ومن ذا الذي يدري أو أن حمامه","وفي أيما قطرٍ من الأرضُ بصرَع",146,"ع",1,0],["وَمَن ذا يَرُدُّ السَهمَ بَعدَ مُروقِهِ","عَلى فوقِهِ إِن عارَ مِن نَزعِ نابِلِ",147,"ل",1,0],["ومَنْ ذا الذي مِن بعدِ جيرانِ ضارجٍ","يُهَوَّنُ وداً ما أراه يهونُ",148,"ن",1,0],["ومَنْ ذا الذي مِن بعدِ جيرانِ حاجرٍ","يحاولُ صدَّي أو يَعِنَّ له منعي",149,"ع",2,0],["ومن ذا الذي يفدي النوى بحمامه","ويبقى مع الحب الخليل مصاحب",150,"ب",1,0],["ومن ذا يطيق الصبر إن هي بدت","على بسط التلوين طورا لظاهر",151,"ر",1,0],["ومن ذا الذي يفدي النوى بحمامه","ويبقى خليلا للحبائب رتعي",152,"ع",2,0],["ومن ذلكَ الترب طابَ النّسيم","نشراً وعمَّ الجنابَ انتشارا",153,"ر",2,0],["ومَنْ ذَا يُرْوِّي الطّالِبينَ بمَشْرَبٍ","مِنْ السُّنَّةِ الْغَرّاءِ عِنْدَ التَّزاحُمِ",154,"م",1,0],["ومَنْ ذَاك للأَصْلَيْنِ يَبْحَثُ فِيهما","مَباحِثَ نقّادِ الْبَصِيرَةِ فَاهِمِ",154,"م",1,0],["ومَنْ ذا إذَا عِلْمُ الْبَيانِ تَوَعَّرَتْ","مسالِكُهُ يَرْقَى لَهُ بالسَّلالِمِ",154,"م",1,0],["ومَن ذا في الأنامِ يُرى عَدُواًّ","له إلا لَئيمٌ أو زَنيمُ",155,"م",1,0],["وَمَن ذا الّذي يُعطي الإدارةَ كلَّها","ومَن ذا الّذي في الأمر لا يُتَلَوَّمُ",156,"م",1,0],["ومَن ذا يُنيلُ الثّأْرَ عفواً أكفّكمْ","وتُظفِركمْ أيّامُه بالممالكِ",157,"ك",1,0],["ومَن ذا الّذي لولاه ذلّلَ صَعْبَتِي","وليَّنَ منّي للشَّموسِ العرائِكا",158,"ك",2,0],["وَمن ذا الّذي تَبقى على الهجرِ والنّوى","مودّتُهُ غيرُ المحبِّ المخالصِ",159,"ص",1,0],["وَمَن ذا الّذي لَولاي آوى سُروحَكمْ","وأنتمْ لآسادِ الخطوب فرائسُ",160,"س",1,0],["وَمن ذا كانَ لِلخلفاءِ مِثلي","وقد مسّتْ أسِرَّتهم ثيابي",161,"ي",1,0],["وَمن ذا الّذي لا يَفتق الدّهر رَتْقَه","وَلا تُنزل الدنيا بِساحتهِ خَطبا",162,"ب",2,0],["ومن ذِهنهِ ماءُ السُّيوفِ وحَدُّها","ومِن عَزمِهِ في النَّائبات حَديدُها",163,"د",3,0],["وَمِن ذُرَى عَلَمٍ ناءٍ مَسافَتُهُ","كَأنَّهُ في حَبابِ الماءِ مَغموسُ",164,"س",1,0]]}