{"poems":[[53,"أيا مرحبا بالغيث تسري بروقه","https://www.aldiwan.net/poem30484.html","الطويل"],[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[3,"إذا كانَ أمر الله أمراً يقدر","https://www.aldiwan.net/poem160.html",""],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[93,"لمصر الجديدة عيد سعيد","https://www.aldiwan.net/poem11327.html","المتقارب"],[54,"أما آن أن يعتب المذنب","https://www.aldiwan.net/poem27661.html","المتقارب"],[88,"أرى بعد نوم طال في الشرق يقظة","https://www.aldiwan.net/poem44423.html","الطويل"],[88,"ذهبت لحي في فروق تزاحمت","https://www.aldiwan.net/poem44452.html","الطويل"],[88,"أما آن أن تنسى من القوم أضغان","https://www.aldiwan.net/poem44992.html","الطويل"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[47,"مصابي جليل والعزاء جميل","https://www.aldiwan.net/poem25177.html","الطويل"],[47,"أتزعم ياضخم اللغاديد أننا","https://www.aldiwan.net/poem25367.html","الطويل"],[72,"أمنزل سعدى بالعذيب سقاكا","https://www.aldiwan.net/poem19440.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[51,"ولا رشد إلا بتوفيقه","https://www.aldiwan.net/poem64976.html","المتقارب"],[51,"تكايدنا شنطف","https://www.aldiwan.net/poem65454.html","مجزوء المتقارب"],[70,"لئن صدقتني في الحديث ظنوني","https://www.aldiwan.net/poem42435.html","الطويل"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[85,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[43,"أدنى ابتسام منك تحيا القرائح","https://www.aldiwan.net/poem9520.html","الطويل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[45,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[49,"تنكبت جهلي فاستراح ذوو عذلي","https://www.aldiwan.net/poem63058.html","الطويل"],[49,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[49,"جرى لك من هارون بالسعد طائره","https://www.aldiwan.net/poem64183.html","الطويل"],[66,"تحجر فيك طبع الشح يبسا","https://www.aldiwan.net/poem38616.html","الوافر"],[97,"غرامك لي معبد طاهر","https://www.aldiwan.net/poem24859.html","المتقارب"],[80,"لها العتب هذا دأبها ولي العتبى","https://www.aldiwan.net/poem31544.html","الطويل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[69,"فراقك للأجساد مفن ومتلف","https://www.aldiwan.net/poem28462.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[46,"هو البر في بحر وإن سكن البرا","https://www.aldiwan.net/poem22605.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30439","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9928","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"غرام يزيد","https://www.poetsgate.com/ViewPoem.aspx?id=179758",""],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[51,"حليفُ سُهادٍ ليلُهُ كنهاره","https://www.poetsgate.com/ViewPoem.aspx?id=29231",""]],"verses":[["وَمَن ذا الَّذي تُمسي مِنَ الدَهرِ جارَهُ","فَيَقبَلَ لِلمِقدارِ إِن رابَهُ عُذرا",0,"ر",2,0],["ومن ذا تُثني الريحُ؟ هل غير واحدٍ؟","وكان هو اللاغي، وسمعُ الذي صغى",1,"غ",2,0],["وَمَن ذا يَرُدُّ المَوتَ أَو يَدفَعُ القَض","وَضَربَتُهُ مَحتومَةٌ لَيسَ تَعثَرُ",2,"ر",1,0],["ومَنْ ذَا لهُ جَدٌّ كجَدِّكَ أوْ أبٌ","إذا عدّدَتْ آباءَهُنّ التّبابِعُ",3,"ع",1,0],["ومنْ ذابِلٍ يحْكي المُحبّينَ رِقّةً","فيَثْني إذا ما هَبَّ عَرْفُ الصَّبا قَدّا",4,"د",2,0],["وَمَنْ ذَا لَهُ فَخٌر كَسَعْدٍ عَلَى الْوَرَى","فَسَعْدٌ وَزِيرٌ للنَّبِيّ وَصَاحِبُ",5,"ب",1,0],["وَمِنْ ذِي مَضَاءٍ وَمِنْ ذِي إِباءٍ","وَمِنْ أَرِيْحِيٍّ جَوَادٍ رَحِيمِ",6,"م",1,0],["وَمَن ذا المُواتي لَهُ دَهرُهُ","وَمَن ذا الَّذي عاشَ لا يُنكَبُ",7,"ب",1,0],["ومن ذكرها في كل عصر وموطن","ستستنشق الأيام أطيب من ورد",8,"د",1,0],["ومن ذي دلال رنّح الحسن عطفه","إلى أن رجا من حسنه عطفه الرفقا",9,"ق",2,0],["ومَن ذَرَفت آماقه الدمعَ لؤلؤاً","ذرفت عليها أدمُعي وهي مَرْجان",10,"ن",1,0],["وَمِن ذُبيانَ تَمَّ لَكُم بِناءَ","عَلى عَلياءِ ذو شَرَفٍ مَشيدُ",11,"د",1,0],["وَمَن ذا الَّذي يَبقى عَلى العَهدِ إِنَّهُم","وَإِن كَثُرَت دَعواهُمُ لَقَليلُ",12,"ل",1,0],["وَمَن ذا يَلُفُّ الجَيشَ مِن جَنَباتِهِ","وَمَن ذا يَقودُ الشُمَّ أَو يَصدُمُ القَلبا",13,"ب",2,0],["ومن ذا الذي يدري حُلا ما أقوله","سواكَ ومن يدري سوايَ حلاكا",14,"ك",2,0],["ومن ذا الذي يعْفُو نداك بشافِعٍ","ويصحبُهُ عند انْتِجاعِكَ مِزْوَدُ",15,"د",1,0],["ومن ذاك ذَمَّ الصالحون أمورَهُ","وقالوا جميعاً صالحُ الدهر فاسدُ",16,"د",1,0],["ومن ذاك ما أَولاكه وهو بادئٌ","ومن ذاك ما أَبلاكه وهو عائدُ",16,"د",1,0],["ومن ذا يُحامي عن ذِماريَ غائباً","أشدَّ محاماةِ امرئٍ عن ذِماره",17,"ر",2,0],["ومن ذا تظلُّ النفسُ عند مغيبه","معلَّقَةً آمالُهما بانتظاره",17,"ر",2,0],["ومن ذا يُدَبِّرنا غيرُهُ","ومن يُبرمُ الأمرَ أو ينقضُ",18,"ض",1,0],["ومن ذا يرى قردة","تُغنّي فلا يسخُف",19,"ف",1,0],["وَمَن ذا الَّذي أَرضى بِهِ لِمَحَبَّتي","فَتَحسُنَ فيهِ لَوعَتي وَحَنيني",20,"ي",1,0],["وَمَن ذا الَّذي أَعتاضُ مِنكُم لِفاقَتي","مِنَ الناسِ طُرّاً ساءَ ما أَتَوَهَّمُ",21,"م",1,0],["وَمَن ذا الَّذي يُرضيكَ مِنهُ فَطانَةٌ","تَقولُ فَيَدري أَو تُشيرُ فَيَفهَمُ",21,"م",1,0],["وَمَن ذا رَأى غابَةً كافَحَت","فَرَدَّت مِن الأَسرِ رِئبالَها",22,"ل",3,0],["وَمَن ذا الَّذي يَقضي حُقوقَكَ كُلَّها","وَمَن ذا الَّذي يُرضي سِوى مَن تُسامِحُ",23,"ح",1,0],["وَمِن ذَكِيِّ المِسكِ بِالدَمالِ","لَو سُرِّحَت في عارِضَي مُحتالِ",24,"ل",1,0],["ومن ذا الذي يرضَى إن اعتاضَ كفُّهُ","يواقيتَ حُمْراً من أنامِلهَا العشْرِ",25,"ر",1,0],["وَمَن ذا يَلومُ البَحرَ أَن باتَ زاخِراً","يَفيضُ وَصَوبَ المُزنِ أَن باتَ يَهطِلُ",26,"ل",1,0],["وَمَن ذا عَلَيها لَيسَ مُستَوحِشاً بِها","وَمُغتَرِباً فيها وَإِن كانَ ذا أَهلِ",27,"ل",1,0],["وَمَن ذا الَّذي يَنجو مِنَ الناسِ سالِماً","وَلِلناسِ قالٌ بِالظُنونِ وَقيلُ",28,"ل",1,0],["وَمَن ذا يَفوتُ المَوتَ وَالمَوتُ مُدرِكٌ","كَذا لَم يَفُت هارونَ ضِدٌّ يُنافِرُه",29,"ر",2,0],["وَمِنذُ رَفَعتَ صَوتَكَ لي دَليلاً","فَكانَ لِنَصبِ قَدرِكَ مِنهُ خَفضُ",30,"ض",1,0],["ومن ذا رأى هيكلاً في الوجود","يُقام على عمدٍ من دموع",31,"ع",1,0],["ومن ذا يردُّ البحرَ عن فَيْضِ مَدّهْ","إذا عبّ منه بالجنائب ما عبّا",32,"ب",2,0],["وَمَن ذا يُداني أَو يُنائي وَهَل فَتىً","يَحُلُّ عُرى التَرحالِ أَو يَتَرَحَّلا",33,"ل",2,0],["وَمَنْ ذَا الَّذِي يَقْوَى عَلَى دَفْعِ مَا أَتَى","بِهِ الْحُبُّ مِنْ جوْرٍ وَسُلْطَانُهُ أَقْوَى",34,"و",2,0],["ومَنْ ذا الذي نرضاهُ بعدَكَ حاكماً","يعزُّ علينا أم بمنْ نتعرَّفُ",35,"ف",1,0],["ومن ذا يشتهِي الموتَ الفظيعا","نساءَ الحيِّ ما صنعَ الرجالُ",36,"ل",1,0],["وَمُنْذُ ألزَمْتُ أفكارِي مَدائِحَهُ","وَجَدْتُهُ لِخَلاَصِي خيرَ مُلْتَزِمِ",37,"م",1,0],["ومن ذاك أضْنيتَ صرفَ الزمان","فلم يُخفِهِ عنْكَ إلا الضّنى",38,"ا",1,0],["وَمَن ذا الَّذي يَنضو لِباسَ بَقائِهِ","نَقِيَّ بَياضٍ لَم يُدَنِّس لَهُ زِرّا",39,"ر",2,0],["ومَن ذا رَبيعُ المُسْلِمينَ يَقُوتُهُم","إِذا النَّاسُ شامُوها بُرُوقا كَواذِبَا",40,"ب",2,0],["وَمَن ذا يَرُدُّ المَوتَ أَو يَدفَعُ القَضا","وَضَربَتُهُ مَحتومَةٌ لَيسَ تَعثَرُ",41,"ر",1,0],["وَمَنْ ذَلَّ خَوْف الْمَوْتِ كَانَتْ حَيَاتُهُ","أَضَرَّ عَلَيْهِ مِنْ حِمَامٍ يَؤُدُّهُ",42,"د",2,0],["ومن ذا يجيبُ القناةَ إذا ما","أهابت بفارسها المدَّخَر؟",43,"ر",1,0],["ومن ذا يطاولُ منهم فتى","بليغَ اليراعةِ، عذبَ اللسان؟",44,"ن",1,0],["ومن ذا له جد كجدك أو أب","إذا عددت آباءهن التتابع",45,"ع",1,0],["ومن ذا يُحامي عن ذِماريَ غائباً","أشدَّ محاماة ِ امرىء ٍ عن ذِماره",46,"ر",2,0],["ومن ذا تظلُّ النفسُ عند مغيبه","معلَّقة ً آمالها بانتظاره",46,"ر",2,0]]}