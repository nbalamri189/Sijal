,"الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141002",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147578","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42685","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55076","المنسرح"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10397","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[50,"أ\"حارثَ\" علِّلني وإنْ كنتُ مسهَبا","https://www.poetsgate.com/ViewPoem.aspx?id=15957",""],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[43,"لكل امرء من دهره ما تعودا","https://www.poetsgate.com/ViewPoem.aspx?id=201",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"عَلِقنا بأسبابِ الوَزِيرِ، وَلمْ نَجِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=32926",""],[45,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[45,"أجِدَّكَ مَا يَنْفَكُّ يَسرِي لزَيْنَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31690",""],[80,"لأمرٍ طويلِ الهمّ نزجي العرامسا","https://www.poetsgate.com/ViewPoem.aspx?id=3315",""],[35,"سقى دمنتينِ لم نجدْ لهما مثلا","https://www.poetsgate.com/ViewPoem.aspx?id=22066",""],[51,"أمامك فانظر أيَّ نهجيك تَنْهُج","https://www.poetsgate.com/ViewPoem.aspx?id=27417",""]],"verses":[["إِذا شِئتَ أَن تَسلى الحَبيبَ فَخَلَّهِ","وَراءَكَ أَيّاماً وَجُرَّ اللَيالِيا",0,"ي",2,0],["إِذا شِئتُ عَنهُ رِحلَةً حَطَّ جودُهُ","حَقائِبَ أَذوادي وَرَدَّ المَثانِيا",0,"ي",2,0],["إِذا شَهِدَ الحَربَ العَوانَ تَدافَعَت","صُدورُ المَواضي في الطُلى وَالجَماجِمِ",1,"م",1,0],["إِذا شِئتَ أَن تَبلو اِمرَأً كَيفَ طَبعُهُ","فَدَعهُ وَسائِل قَبلَها كَيفَ أَصلُهُ",2,"ل",2,0],["إِذا شِئتَ أَن لا تَهجُرَ الهَمَّ فَاِغتَرِب","وَإِن شِئتَ أَن يَأتي الحِمامُ فَفارِقِ",3,"ق",1,0],["إِذا شِمتُ مِنهُ بارِقَ العَزمِ رَدَّني","كَليلَ لِحاظِ الناسِ وَالخَطبِ يَهمَعُ",4,"ع",1,0],["إِذا شِئتَ أَن تَبقى خَلِيّاً مِنَ العِدى","فَعِش عَيشَ خالٍ مِن عَلاءٍ وَمِن وَفرِ",5,"ر",1,0],["إِذا شِئتُ فارَقتُ الحَبيبَ وَبَينَنا","مِنَ الشَوقِ ما يُملي عَلَيَّ وَأَكتُبُ",6,"ب",1,0],["إِذا شِئتَ أَحياناً شَفاكَ مِنَ العِدى","سِنانٌ بَصيرٌ بِالطِعانِ وَمَضرَبُ",6,"ب",1,0],["إِذا شِئتُ قَلَّبتُ الزَمانَ وَصافَحَت","لِحاظي أُموراً كُلُّهُنَّ عُجابُ",7,"ب",1,0],["إِذا شاءَ نابَ القَولُ عَن فَعَلاتِهِ","وَقامَ مَقامَ العَضبِ مِنهُ كِتابُ",7,"ب",1,0],["إِذَا شَبِعوا باتُوا نِياماً وَجَارُهُمْ","يُصارِمُ جَفْنَيْهِ الكَرَى وَيَجُوعُ",8,"ع",1,0],["إِذا شِئتُ لاقاني كَميٌّ مُدَجَّجٌ","عَلى أَعوَجِيٍّ بِالطِعانِ مُسامِحُ",9,"ح",1,0],["إِذا شَكَّت بِنافِذَةٍ يَداهُ","تَعَرَّضَ مَوقِفاً ضَنكَ المُقامِ",10,"م",1,0],["إِذَا شَردَتْ عَنَّي الْقَوَافِي نَوازِعَا","فَلَيْسَ لَهَا إِلاَّ لَدَيْكَ حُلُولُ",11,"ل",1,0],["إذا شِئْتُ أن أحْظى إليْهِ بنظْرَةٍ","تُسكِّنُ ما أوْرى الجَوى منْ زِنادِهِ",12,"د",2,0],["إِذا شِئتُ أَعلَكتُ الجَموحَ إِذا بَدَت","نَواجِذُ لَحيَيهِ بِأَغلَظِ ما عَجَم",13,"م",1,0],["إِذا شِئتَ أَن تَلقى السَعادَةَ بَينَهُم","فَلا تَكُ مِصرِيّاً وَلا تَكُ مُسلِما",14,"م",2,0],["إِذا شَوكَتُ الفاروقُ قامَ مُنادِياً","إِلى الحَقِّ لَبّاهُ نِيازي وَصاحِبُه",15,"ب",2,0],["إِذا شاءَ بَزَّ السُها سِرَّهُ","وَأَدرَكَ مِن جَريِهِ المَقصِدا",16,"د",2,0],["إِذا شَكَوتَ صُداعاً","أَطَلتُ تَسهيدَ جَفني",17,"ي",1,0],["إِذا شَياطينُ بغيٍ خيفَ سورَتُها","فَإِنَّ آراءَهُ في رَجمِها شُهُبُ",18,"ب",1,0],["إِذا شَحَطَت يَوماً بِعَزَّةَ دارُها","عَنِ الحَيِّ صَفقاً فَاِستَمَرَّ مَريرُها",19,"ه",2,0],["إِذا شاءَ أَبكَتهُ مَنازِلُ قَد خَلَت","لِعَزَّةَ يَوماً أَو مَناسبُ قالَها",20,"ل",3,0],["إِذا شَحَطَت دارٌ لِعَزَّةَ لَم أَجِد","لَها في الأولى يَلحَينَ في وَصلِها مِثلا",21,"ل",2,0],["إِذا شَرِبَت بِبَيدَحَ فَاِستَمَرَّت","ظَعائِنُها عَلى الأَنهابِ زورُ",22,"ر",1,0],["إِذا شِئنَ أَن يَسمَعنَ وَاللَيلُ دامِسٌ","أَذالِيلُهُ وَالريحُ تَهوي فُنونُها",23,"ن",3,0],["إِذا شَمَّ أَنفَ البَردِ أَلحَقَ بَطنَهُ","مِراسُ الأَوابي وَاِمتِحانُ الكَوتَمِ",24,"م",1,0],["إِذا شاءَ بَعضَ اللَيلِ حَفَّت لِصَوتِهِ","حَفيفَ الرَحى مِن جِلدِ عَودٍ ثِفالُها",25,"ل",3,0],["إِذا شَفَّ عَن أَجيادِها كُلُّ مُلحَمٍ","مِنَ القَزِّ وَاِحَورَّت إِلَيكَ المَحَاجِرُ",26,"ر",1,0],["إِذا شِئتُ أَبكاني بِجَرعاءِ مالِكٍ","إِلى الدَحلِ مُستَبدىً لِمَيٍّ وَمَحضَرُ",27,"ر",1,0],["إذا شئت أن ترمي القصيَّ من المنى","تدورُ لكَ الأفاكُ مرفوعة القِسِ",28,"س",1,0],["إذا شكوتَ فكلّ الكون ذو وصبٍ","فأنت منه مَكان السمع والبصرِ",29,"ر",1,0],["إذا شئت أن تسري بكافرة الصوى","يدوّي بقطريها هزيم الرواعد",30,"د",1,1],["إذا شرقت شمسي تناسيت ذكره","وأن جنّ ليلي بتّ منه على ذُكر",31,"ر",1,0],["إِذا شِئتُمُ هِجتُم تَميماً فَهِجتُمُ","لُيوثَ الوَغى يَهصِرنَ أَعداءَكُم هَصرا",32,"ر",2,0],["إِذا شاءَوا مَدَدتُ لَهُم حِضاراً","وَتَقريباً مُخالِطُهُ عِزامُ",33,"م",1,0],["إِذا شاعَ السَلامُ بِدارِ قَومٍ","فَلَيسَ عَلى عَزَولاةَ السَلامُ",34,"م",1,1],["إِذا شَرِبوا صَدّوا العَواذِلَ عَنهُمُ","وَكانوا قَديماً يُسكِتونَ العَواذِلا",35,"ل",2,0],["إِذا شِئتَ ناوَيتَ اِمرَأَ السوءِ ما نَز","إِلَيكَ وَلاطَمتَ اللَئيمَ المُلَطَّما",36,"م",2,0],["إذَا شَرَعُوا يَوماً عَلَى الغَيِّ فِتنةً","طَرِيقُهم فِيهَا عَنِ الحَقِّ أنكَبُ",37,"ب",1,0],["إذا شَرَعَت فيهِ الأَسِنَّةُ كَبَّرَت","غُوَاتُهم كلِّ في أَوبٍ وَهلَّلُوا",38,"ل",3,0],["إِذا شِئتَ أَن تَلقى أُسوداً قَساوِرا","لِنُعماهُمُ الصَفوُ الَّذي لَن يُكَدَّرا",39,"ر",2,1],["إِذا شِئتَ جاهَرتُ العَدُوَّ وَلَم أَبِت","أُقَلِّبُ فِكري في وُجوهِ المَكائِدِ",40,"د",1,0],["إِذا شُتِموا بِأُمِّهِمِ تَوَلَّوا","سِراعاً ما يَبينُ لَهُم كَلامُ",41,"م",1,0],["إِذا شَمَّرَت حَربٌ عَوانٌ سَمَوا لَها","بِكُلِّ رُدَينِيٍّ وَأَسمَرَ قارِعِ",42,"ع",1,0],["إِذا شَمَرَت حَربٌ وَهَزَّ هَزيزُها","نَهَضنا مَساعيراً لَها حينَ تُسعَرُ",43,"ر",1,0],["إِذا شَرَّعوا الراياتِ لَم يَتَواكَلوا","وَفيهِم حِفاظِ الأَريَحِيِّ المُظافِرُ",44,"ر",1,0],["إذا شامَ رأياً في الملمات كفها","بأفتك من صرف الزمان وأكيد",45,"د",1,0],["إذا شعراء الذكر قامت بمدحه","فما قدرُ ما تنشي الأنام وتشعر",46,"ر",1,0],["إذا شمت منه طلعةً علويةً","فغالِ الثنا وأرفض سنا الأنجم الزهر",47,"ر",1,0],["إذا شيد في نظمِ امتداحك بيته","فما هو إلا في ذوي النظم قصره",48,"ر",2,0],["إذا شدا الطير شقَّ الزهر من أسفٍ","ثيابه فكأنَّ الطير يرثيكا",49,"ك",2,0],["إذا شدا صوت عافية ومادحهُ","غدا وحاشاه مثل الشارب الثمل",50,"ل",1,0],["إذا شمت تحت الحاجبين جفونه","أرى السحر منها قاب قوسين أو دنا",51,"ن",2,0],["إذا شئت أن أشدو بأوصاف ثغره","بدأت ببسم الله في النظم أوّلا",52,"ل",2,0],["إذا شيم فيه بارقُ الموت أو مَضْت","به صفحةٌ مثلُ العقيقة في الجلبِ",53,"ب",1,0],["إذا شمسُ الأصائلِ عارضَتها","وقد كَرَبَتْ تَوارَى بالحجابِ",54,"ب",1,0],["إذا شيمَ بالأبصار أبرقَ بيضُهُ","بوارقَ لا يَسْطِيعُهُنَّ المُحمِّجُ",55,"ج",1,0],["إذا شئْتُ راقتْ ناظريَّ نظائرٌ","بمُصطبَحي والأدْمُ حولِيَ رُوَّدُ",56,"د",1,0],["إذا شَامَهَا قَرَّتْ قُلُوبٌ مَقرَّهَا","وإن سُلَّ منها فالْفَرائصُ تُرْعَدُ",56,"د",1,0],["إذا شِيمُ الأحرار حالت فأصبحت","إماءً أبى منهن غيرَ الحرائرِ",57,"ر",1,0],["إذا شَنِئَت عينُ الفتى وجهَ نفسه","فعينُ سواه بالشناءة أجدر",58,"ر",1,0],["إذا شام برقاً لاح من نحو أرضه","تَضايقَ عما ضَمَّ من وَجدِه الصبر",59,"ر",1,0],["إذا شئتُ حيِّتني رياحينُ جنّةٍ","على سُوقها في كل حينٍ تَنفَّسُ",60,"س",1,1],["إذا شئتَ نيكَ البيهقيّ وعِرسهِ","فلا تتوسلْ بالوسائل واختبط",61,"ط",1,0],["إذا شئتُ جاريتُ القوافيَ فيكمُ","مداها وما كثَّرتُ حقاً بباطلِ",62,"ل",1,0],["إذا شاخَ قوم شيَّبوا وابن بلبلٍ","تَشيبَن لما شاخَ بالتَّنحلِ",63,"ل",1,1],["إذا شاءا أطافا كلَّ يومٍ","بحيث يخالفُ النَّهمُ الأكولُ",64,"ل",1,0],["إذا شبَّ منها جاد ما هو قادح","بِزَنْدَيْهِ من شدٍّ تَلَهَّبَ فاضطرمْ",65,"م",1,0],["إذا شهدت للقوم في اللّهو مَعرَساً","غدا مأتماً يمحو بأحزانه اللَّهوى",66,"و",2,0],["إِذا شِئتَ أَن تَلهو لِبَعضِ حَديثِها","رَفَعنَ وَأَنزَلنَ القَطينَ المُوَلَّدا",67,"د",2,0],["إِذا شِئتَ أَن تَلقى غُلامَ نَزيعَةٍ","بَنو كاهِلٍ أَخوالُهُ وَالغَواضِرُ",68,"ر",1,0],["إِذا شابَ رَأسُ المَرءِ أَو قَلَّ مالُهُ","فَلَيسَ لَهُ مِن وُدِّهِنَّ نَصيبُ",69,"ب",1,0],["إِذا شَرِبَ الظِمءُ الأَداوى وَنَضَّبَت","ثَمائِلُها حَتّى بَلَغنَ العَزالِيا",70,"ي",2,0],["اذا شئت فابعد عن ذويك او اقترب","فانك موموق على البعد والقرب",71,"ب",1,0],["إذا شاء أمراً قال كن فيكون لا","يرى أبداً في خلق ما شاءه عُسرا",72,"ر",2,0],["إذا شئت لقياك خنت الملي","ك وإن لم اشأ خنت قلبي الكليم",73,"م",1,0],["إذا شاقتكم الأوطان يوما","أو أشتقتم بها أهلا وقوما",74,"م",2,0],["إِذا شَهِداها جَدَّدا هِزَّةَ الصِبا","كَما يَتَصابى ذو ثَمانينَ يَطرُبُ",75,"ب",1,0],["إذا شَجَرُ المودَّةِ لَمْ تَجُدْهُ","سَماءُ البِرِّ أسرعَ في الجَفَافِ",76,"ف",1,0],["إِذا شَدَّ زَندي حُسنُ رَأيِكَ فيهِمِ","ضَرَبتُ بِسَيفٍ يَقطَعُ الهامَ مُغمَدا",77,"د",2,0],["إِذا شِئتُ حَفَّت بي عَلى كُلِّ سابِحٍ","رِجالٌ كَأَنَّ المَوتَ في فَمِها شَهدُ",78,"د",1,0],["إِذا شاءَ أَن يَلهو بِلِحيَةِ أَحمَقٍ","أَراهُ غُباري ثُمَّ قالَ لَهُ اِلحَقِ",79,"ق",1,0],["إِذا شاء أجرَى في التَّصابي إِلى المدَى","ولكنَّه لا ينثني بالشكائمِ",80,"م",1,0],["إِذا شَرُفَتْ نفسُ الفَتى زادَ قَدْرُهُ","على كلِّ أسنَى منه ذِكراً وأمجدِ",81,"د",1,0],["إِذا شارَفَت أَرضَ العِراقِ فَإِنَّهُ","سَيُسنى أَميرُ المُؤمِنينَ بِها البُشرى",82,"ر",2,0],["إِذا شاءَ غادى عانَةً أَو عَدا عَلى","عَقائِلِ سِربٍ أَو تَقَنَّصَ رَبرَبا",83,"ب",2,0],["إِذا شَدَّ عُروَةَ زُنّارِهِ","عَلى سَلحَةٍ ضَخمَةٍ وَاِنتَفَج",84,"ج",1,0],["إِذا شوهِدَت بِالرَأيِ بانَ اِختِيارُها","وَإِن بانَ ذو الرَأيِ اِكتَفَت بِاِنفِرادِها",85,"د",3,0],["إِذا شَهِدوا فاضوا وَيُستَمطَرُ الحَيا","بِأَوجُهِهِم في المَحلِ غَيرَ شُهودِ",86,"د",1,0],["إِذا شَجَروهُ بِالرِماحِ تَكَسَّرَت","عَوامِلُها في صَدرِ لَيثٍ غَضَنفَرِ",87,"ر",1,0],["إِذا شَرَعنا في نَدى كَفِّهِ","أَلحَقنا بِالرِيِّ ذاكَ الشُروع",88,"ع",1,0],["إِذا شِئتَ حازَ الحَظَّ دونَكَ واهِنٌ","وَنازَعَكَ الأَقسامَ عَبدٌ مُجَدَّعُ",89,"ع",1,0],["إِذا شِئتَ أَلّا تَعذُلَ الدَهرَ عاشِقاً","عَلى كَمَدٍ مِن لَوعَةِ الحُبِّ فَاعشَقِ",90,"ق",1,0],["إِذا شَرَعوا في خُطبَةٍ قَطَعَتهُمُ","جَلالَةُ طَلقِ الوَجهِ جانِبُهُ سَهلُ",91,"ل",1,0],["إِذا شِئتُ في حِبتونَ أَدّى خُفارَتي","إِلى الجانِبِ الغَربِيِّ أَروَعُ باسِلُ",92,"ل",1,0],["إِذا شِئتَ أَجرَت أَدمُعي مِن شُؤونَها","رُبوعٌ لَها بِالأَبرَقَينِ وَأَرسُمُ",93,"م",1,0],["إِذا شِئتَ أَن تَستَصغِرَ الخَطبَ فَاِلتَفِت","إِلى سَلَفٍ بِالقاعِ أُهمِلَ نائِمُه",94,"م",2,0],["إِذا شِئتَ فَاندُبني إِلى الراحِ وَانعِني","إِلى الشَربِ مِن ذي خُلَّةٍ وَنَديمِ",95,"م",1,1],["إِذا شِئتُ غَنّاني مِنَ العاجِ قاصِفٌ","عَلى مِعصَمٍ رَيّانَ لَم يَتَخَدَّدِ",96,"د",1,1],["إِذا شَهِدوا يَومَ اللِقاءِ تَضَمَّنوا","مِنَ الطَعنِ أَيّاماً لَهُنَّ مَتالِفُ",97,"ف",1,0],["إِذا شَرِبوا فيها الصَديدَ رَأَيتَهُم","يَذوبونَ مِن حَرِّ الصَديدِ تَمَزُّقا",98,"ق",2,0],["إِذا شَلَّ في صَمّانَةٍ أَوقَدَت لَهُ","حَوافِرُها نيرانَ مَروٍ مُفَلَّقِ",99,"ق",1,0],["إِذا شِئتُ هاجَتني دِيارٌ مُحيلَةٌ","وَمَربِطُ أَفلاءٍ أَمامَ خِيامِ",100,"م",1,1],["إِذا شَرَكُ الطَريقِ تَرَسَّمَتهُ","تَأَوَّدُ تَحتَهُ حَذَرَ الكَلامِ",101,"م",1,0],["إذا شِئْتَ أن تَجتاحَ حَقاً بباطِلٍ","وتُغْرِقَ خَصْماً كانَ غيرَ غَريقِ",102,"ق",1,1],["إذا شِئْتَ أن تُهدي لِغلِّ صدورِهِمْ","فأَغْضِبْهُمُ يَبْدو كُمونُ الكتائفِ",103,"ف",1,0],["إذا شَهَرَ اللَّحْظُ أسيافَهُ","تدرَّعْتُ للصِّبرِ بُرداً قَشيبا",104,"ب",2,0],["إذا شُنَّتْ به الغاراتُ كانت","نفوسُ المُعلَمينَ من النِّهابِ",105,"ب",1,0],["إذا شيمَتْ بوارقُه استهلَّت","سماءٌ من مواهبِه تصوَّبُ",106,"ب",1,0],["إِذا شِئتَ أَن تَستَقرِضِ المالَ مُنفِقاً","عَلى شَهَواتِ النَفسِ في زَمَنِ العُسرِ",107,"ر",1,1],["إِذا شامَ الفَتى بَرقَ المَعالي","فَأَهوَنُ فائِتٍ طيبُ الرُقادِ",108,"د",1,0],["إِذا شَمَّها الناسُ كابَرتُهُم","وَأَقسَمتُ بِالطالِبِ الغالِبِ",109,"ب",1,0],["إِذا شَنَّفَ الأَسماعَ دُرُّ نِظامِهِ","تَيَقَّنَ كُلٌّ أَنَّ مُرسِلَهُ البَحرُ",110,"ر",1,0],["إذا شئتِ هجراناً فما أتعس المدى","من النور للّيل المخيّم للحشر",111,"ر",1,0],["إذا شَرِبتْ وُدّ المؤيّد صيّرَتْ","خلائقَهُ راحاً ورؤيتَهُ نُقْلا",112,"ل",2,0],["إذا شمل القوْلُ حسنَ البديع","فأين المروّي من المرتجِل",113,"ل",1,0],["إذا شئتُ ألقتْ بي على الغرب رجلُها","ونالتْ يدٌ منها بوثبتها الشرقا",114,"ق",2,0],["إذا شاءتِ الرّهبانُ بالضرْبِ أنْطقَتْ","مَعَ الصبحِ والإِمساءِ فيها النَّواقِسا",115,"س",2,0],["إذا شمّها أعطاكَ جُمْلَةَ وصفها","ففي أنفْهِ عِلمُ الفَراسَةِ بالخمرِ",116,"ر",1,0],["إِذا شَرَع الخَطِّيَّ أَغْرَى سِنانَهُ","مِنَ الذِّمرِ مُعتاداً بِجارِحَةِ الحِقدِ",117,"د",1,0],["إذا شئتُ أنْ أرْمي الهلالَ بلحظَةٍ","لمحتُ تَميماً في سماءِ المناقِبِ",118,"ب",1,0],["إِذا شَرَعَت فيهِ اللَيالي بِنَكبَةٍ","تَمَزَّقَ عَنهُ وَهوَ في الشَرعِ شارِعُ",119,"ع",1,0],["إِذا شَفَعوا إِلَيَّ فَلا خُدوداً","يَقونَ مِنَ الهَوانِ وَلا نِعالا",120,"ل",2,0],["إِذا شَجَراتُ العُرفِ جُذَّت أُصولُها","فَفي أَيِّ فَرعٍ يوجَدُ الوَرَقُ النَضرُ",121,"ر",1,0],["إِذا شَبَّ ناراً أَقعَدَت كُلَّ قائِمٍ","وَقامَ لَها مِن خَوفِهِ كُلُّ قاعِدِ",122,"د",1,0],["إِذا شَرَدَت سَلَّت سَخيمَةَ شانِئٍ","وَرَدَّت عُزوباً مِن قُلوبٍ شَوارِدِ",123,"د",1,0],["إِذا شِئنَ بِالأَلوانِ كُنَّ عِصابَةً","مِنَ الهِندِ وَالآذانِ كُنَّ مِنَ الصُغدِ",124,"د",1,0],["إِذاً شَكَرَتكَ مَذحِجُ حَيثُ كانَت","بَنو دَيّانِها وَبَنو الضِبابِ",125,"ب",1,0],["إِذا شِئتَ أَن تُحصي فَواضِلَ كَفِّهِ","فَكُن كاتِباً أَو فَاِتَّخِذ لَكَ كاتِبا",126,"ب",2,0],["إِذَا شَاغَبَتْهُ الرِّيحُ جَاشَ عُبَابُهُ","وَظَلَّ أَعَالِي مَوْجِهِ يَتَجَفَّلُ",127,"ل",1,0],["إِذا شَرَعَت فيهِ فَلَيسَ لِمُلتَقى","مَشافِرِها مِنهُ قِدى الكَفِّ مُسأَرُ",128,"ر",1,0],["إِذا شِئتُ غَنّاني وِشاحٌ وَحِليَةٌ","لَحَسناءَ غَصَّت دُملُجاً وَسِوارا",129,"ر",2,0],["إذا شَرِبوا الكُؤوسَ رَمَى إليهم","بكأسٍ مُرَّةٍ للشّاربينا",130,"ن",2,0],["إذا شَرَعَ الرِّعديدُ في الذُلِّ يَفتدي","دَمَ الجَوْفِ أمْسَى وهو في الدّمِ شارعُ",131,"ع",1,0],["إذا شَهِدَ الكريهةَ يصطليها","فأرسلها دماً وهوى تليلا",132,"ل",2,0],["إِذا شَرَّقَ الإِرشادُ خابَت بَصيرَتي","كَما بَعَثَت شَمسٌ سَراباً مُخادِعا",133,"ع",2,0],["إِذا شَبَّت جَهَنَّمُ ثُمَّ فارَت","وَأَعرَضَ عَن قَوابِسِها الجَحيمُ",134,"م",1,0],["إِذ أَشالَ الحَيُّ أَيلَيَّةً","ذَأَبَتها نِسوَةٌ مِن جُذام",135,"م",1,0],["إِذا شِئتُ بَعدَ النَومِ أَلقَيتُ ساعِداً","عَلى كَفَلٍ رَيّانَ لَم يَتَخَدَّدِ",136,"د",1,0],["إِذا شَمَّها المُشتاقُ خالَ نَسيمَها","سَحيقاً مِنَ الكافورِ شيبَ بِهِ الخَمرُ",137,"ر",1,0],["إِذا شِئتُ أَوقَرتُ البِلادَ حَوافِراً","وَسارَت وَرائي هاشِمٌ وَنِزارُ",138,"ر",1,0],["إِذا شِئتَ كَلَّمَني بِالجُفو","نِ مِن مُقلَةٍ كُحِلَت في الهَوى",139,"ا",1,0],["إذا شِدتَ مَجداً شادَهُ وأتَمَّهُ","وَمِثلُكَ بانٍ لَيسَ يَخلِفُهُ هَدمُ",140,"م",1,0],["إذا شاءَ لم تَمْلِكْ عليه أناتُه","بَوادِرَ عَزْمٍ للقَضاءِ مَوالِك",141,"ك",1,0],["إذا شاءَ قادَ الأعوَجِيّاتِ فيْلَقاً","ومنْ بينِ أيْديها الحِمامُ وفَيْلَقُه",142,"ق",2,0],["إذا شارَفَتْهُ قلتَ سِربُ أجادِلٍ","يُشارِفُ هَضْباً من ثَبيرٍ مُحلِّقُه",142,"ق",2,0],["إذا شَهِدَ الهيجاءَ مَدّتْ لهُ يداً","كأنّ عليها دُمْلُجاً منْهُ أو وقْفا",143,"ف",2,0],["إذا شَدَخَتْه مَشْقَةٌ أنّ مُوقَذاً","حَسيراً كما أنّ الأميمُ المُشدَّخ",144,"خ",1,0],["إِذا شاقَكَ ناقوسٌ","وَشَجوُ النايِ وَالعودُ",145,"د",1,1],["إِذا شِئتُ لَم تَكثُر عَلَيَّ مَلامَةً","وَأَعنُفُ أَحياناً فَيَكثُرُ لُوَّمي",146,"م",2,0],["إِذا شَجَّها الساقي بِماءٍ رَأَيتَها","مُكَلَّلَةَ الأُعلى بِطَوقِ جُمانِ",147,"ن",1,0],["إِذا شَبِعَ الزَيدِيُّ لاعَبَ أُمَّهُ","سَبوقٌ إِلى اللَذّاتِ غَيرَ جَوادِ",148,"د",1,0],["إِذا شِئتَ لاقَيتَ اِمرَأً مِن سَراتِهِم","عَلى أُختِهِ يَحكي لُصوقَ قُرادِ",148,"د",1,0],["إِذا شَهِدوا فَأَنتَ لَهُم دُوارٌ","وَإِن غابوا فَلَيسَ بِكَ اِفتِقادُ",149,"د",1,0],["إِذا شِئتُ راعَتني وَإِن كُنتُ لاهِياً","بِذاتِ خَليلٍ أَو بِعَذراءَ ناهِدِ",150,"د",1,0],["إِذا شِئتَ لاقَيتَهُ رابِضاً","عَلى ظَهرِهِ رَجُلٌ يَسبَحُ",151,"ح",1,0],["إِذا شِئتُ أَبكاني الحَمامُ بِصَوتِهِ","وَهاجَ عَلَيَّ الشَوقُ طولَ سُباتي",152,"ي",1,0],["إِذا شِئتِ تَصَبَّرتُ","وَلا أَصبِرُ إِن شيتُ",153,"ت",1,0],["إِذا شِئتُ غَنَّتني فَتاةٌ بِمِزهَرٍ","عَلى الراحِ أَو غَنَّيتُها بِقَضيبِ",154,"ب",1,0],["إِذا شَبِعَ الزِنجِيُّ سَبَّ إِلَهَهُ","وَأَلَّبَ مِن زِنجٍ عَلَيَّ وَنوبِ",154,"ب",1,0],["إِذا شَبِعا اِحتالا عَلى صاحِبَيهِما","كَما اِحتالَ بِرذَونُ الأَميرُ المُرَطَّبُ",155,"ب",1,0],["إِذا شِئتَ نادى في الأَنامِ بِصَوتِهِ","لِأَرفَعِ ما أَدّى عَريبٌ وَمُعرِبُ",155,"ب",1,0],["إِذا شِئتُ راعَتني مُقيماً وَظاعِناً","مَصارِعُ شُبّانٍ لَدَيَّ وَشيبِ",156,"ب",1,0],["إِذا شِئتُ هاجَ الشَوقُ وَاِقتادَهُ الهَوى","إِلَيكِ مِنَ الريحِ الجَنوبِ هُبوبُ",157,"ب",1,0],["إِذا شِئتَ أَن يَرضى سَجاياكَ رَبُّها","فَلا تُمسِ مِن فِعلِ المَقاديرِ مُغضَبا",158,"ب",2,1],["إِذا شِئتَ يَوماً أَن تُقارِنَ حُرَّةً","مِنَ الناسِ فَاِختَر قَومَها وَنِجارَها",159,"ر",3,0],["إِذا شُهِرَ الإِنسانُ بِالدينِ لَم تَكُن","لَهُ رُتبَةُ المُستَأنِسِ المُتَخَصِّصِ",160,"ص",1,0],["إِذا شَقيتَ فَجِسمٌ نالَهُ نَصَبٌ","وَإِن تُرِفتَ فَماذا يَنفَعُ التَرَفُ",161,"ف",1,0],["إِذا شِئتَ أَن تَرقى جِدارَكَ مَرَّةً","لِأَمرٍ فَآذِن جارَ بَيتِكَ مِن قَبلُ",162,"ل",1,1],["إِذا شِئتَ يَوماً وَصلَةً بِقَرينَةٍ","فَخَيرُ نِساءِ العالَمينَ عَقيمُها",163,"م",3,1],["إِذا شَبَّتِ الشِعرِيانِ الوَقودَ","فَفي الحُكمِ أَنَّهُما تَخبُوانِ",164,"ن",1,0],["إذا شربَتْ رأيْتَ الماءَ فِيها","أُزَيْرِقَ ليس يَسْتُرُهُ الجِرَانُ",165,"ن",1,0],["إذا شَمسُ الضّحَى نَظَرَتْ إليه","أقَرّتْ أنّ حُلّتَها حِدادُ",166,"د",1,0],["إِذا شاءَ يَوماً قادَهُ بِزِمامِهِ","وَمَن يَكُ في حَبلِ المَنيَّةِ يَنقَدِ",167,"د",1,1],["إِذَا شِئتَ أَبصَرتَ مِن عَقبِهِم","يَتامى يُعاجَونَ كَالأَذؤُبِ",168,"ب",1,0],["إذا شاع فيه العلم فالعَيش نافع","وإن لم يشع فالعَيش لَيسَ بِنافع",169,"ع",1,0],["إذا شدّ زندي حسن رأيك في يدي","ضربت بنصلٍ يقطع الهام مغمدا",170,"د",2,0],["إذا شئتِ كان لنا عالَمٌ","يحوط الأنوثةَ فيهِ الجلالْ",171,"ل",1,0],["إذا شتوت فمن توكافه عنتي","وبالحرور إذا ما صفت يقترن",172,"ن",1,0],["إذا شَرِبَ الأُرْفِيَّ مالَ به الكَرى","إلى سِدْرَةٍ أفْنانُها فَوْقَهُ تَغْطو",173,"ط",2,0],["إِذا شَهِدوا هِياجاً قُلتَ أُسدٌ","مِنَ السُمرِ الذَوابِلِ في عَرينِ",174,"ن",1,0],["إِذَا شَابَ رَأْسُ الْمَرْءِ شَابَ فُؤَادُهُ","وَلَمْ يَبْقَ فِيهِ لِلْبَشَاشَةِ مَوْضِعُ",175,"ع",1,0],["إِذَا شِئْتَ أَنْ تَحْيَا سَعِيدَاً فَلا تَكُنْ","لَدُوداً وَلا تَدْفَعْ يَدَ اللِّينِ بِالْقَسْرِ",176,"ر",1,0],["إِذَا شَجَّهَا السَّاقُونَ دَارَ حَبَابُها","عَلَيْهَا كَمَا دَارَ الشَّرَارُ عَلَى الْجَمْرِ",177,"ر",1,0],["إِذَا شَرِبنَا نُخْبَ الحَبِيبِ جَلاَ","لَنَا مُحيَّا الصَّبَاحِ فِي الغَسقِ",178,"ق",1,0],["إِذا شِئتَ ناوَيتَ اِمرَأَ السوءِ ما نَزا","إِلَيكَ وَلاطَمتَ اللَئيمَ المُلَطَّما",179,"م",2,0],["إِذا شَدَّ خِلتَ الأَرضَ تَرمي بِشَخصِهِ","إِلَيها وَيَدعوها لَهُ فَتُجيبُ",180,"ب",1,0],["إِذا شِئْتَ مَجْدَ العُرْبِ في عُنْفَوانِهِ","فَهذِي مَغَانيه وهَذِي مَناثِرُهْ",181,"ر",2,0],["إذا شدا أنصتتْ أُذْنُ الوجودِ له","وللوجودِ كما للناس آذانُ",182,"ن",1,0],["إذا شهوةُ الدنيا دهت عقْلَ عاقلٍ","غدَا وهو أذكى الناسِ شراً من الفدم",183,"م",1,0],["إذا شبَّت الحرب، هبوا قيامًا","وإن قُسِّم الفيء، ظلوا قعودا",184,"د",2,0],["إذا شاء، أعْطَى الحقوقَ احتسابًا","وإن شاءَ من كل حقٍّ حرَمْ",185,"م",1,0],["إذا شرب الناسُ مرَّ الحياةِ","عصرتُ من المرِّ شَهدًا وراحا",186,"ح",2,0],["إذا شابَتْ نواصي اللَّيْثِ، هَمَّتْ","فريستُه عليهِ بالهُجوم",187,"م",1,0],["إِذَا شئْتُ غَادَانِي وخِيمٌ مُلَعَّنٌ","وجنَّبتُ منْ ودِّي لهُ فتجنَّبا",188,"ب",2,0],["إذا شهدوا الوغى كانوا كماة","يدكون المعاقل والحصونا",189,"ن",2,0],["إِذا شَدَّ زَندي حُسنُ رَأيِكَ فيهِمِ","ضَرَبتُ بِنَصْلٍ يَقطَعُ الهامَ مُغمَدا",190,"د",2,0],["إذا شئتُ أنضجتُ الشِّواء","جلوداً تعَّصْت فما تُشتوى",191,"ا",1,0],["إذا شادَ شَيْبَانَ بنَ ثَعْلَبَةَ ارْتضَتْ","رِئاسَةُ عالي البيت يَفرَعُها مَجْدا",192,"د",2,0],["إذا شهدو فاضوا، ويستمطر الحيا","بأوجههم في المحل غير شهود",193,"د",1,0],["إذا شاءَ غَادَى عَانَةً، أو غَدا عَلى","عَقَائِلِ سِرْبٍ، إنْ تقنّصَ رَبرَبا",194,"ب",2,0],["إذا شاءَتِ الرّهْبانُ بالضَرْبِ أنْطَقَتْ",": مع الصبح والإمساءِ فيهعا النواقسا",195,"س",2,0],["إذا شطحتْ دارٌ لعزَّة َ لم أجدْ","لها في الأُولى يَلْحَيْنَ في وَصْلِهَا مِثْلا",196,"ل",2,0],["إذا شيمَ بالأبصار أبرقَ بيضُه","بوارقَ لا يستطيعُهُنَّ المُحمِّجُ",197,"ج",1,0]]}