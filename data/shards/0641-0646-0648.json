[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5443,"العذراء والطبق","https://www.poetsgate.com/ViewPoem.aspx?id=185151",""],[5447,"يمامة","https://www.poetsgate.com/ViewPoem.aspx?id=208356",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""],[5539,"هامة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192687",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5997,"الخل","https://www.poetsgate.com/ViewPoem.aspx?id=214226",""],[6003,"الحب السرمدي","https://www.poetsgate.com/ViewPoem.aspx?id=207313",""],[6082,"رهان خاسر","https://www.poetsgate.com/ViewPoem.aspx?id=59954",""],[231,"يقظة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79175&r=&rc=49",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[6225,"معركة الكرسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80900&r=&rc=169",""],[5064,"ما لم تستطعه المحابر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87512&r=&rc=7",""]],"verses":[["فَنورِدُ يَومَ الرَوعِ خَيلاً مُغيرَةً","وَتورِدُ ناباً تَحمِلُ الكيرَ صَوأَرا",0,"ر",2,0],["فنور مرعى القاصدين وسبلهم","فيا لك في الحالين روضاً منوَّرا",1,"ر",2,0],["فَنورِثُكُم إِنَّ التُراثَ إِلَيكُمُ","حَبيبٌ مَرَبّاتِ الحِمى فَالمَطالِيا",2,"ي",2,0],["فُنونُ رَداكِ يا دُنيا","لَعَمري فَوقَ ما أَصِفُ",3,"ف",1,0],["فنوَّر أكواخها الباليات","وهلَّل في دورها العامره",4,"ر",2,0],["فنورها من ذاك مُسْتَأنَفٌ","كأنّهُ الصحّةُ بعْدَ السّقَم",5,"م",1,0],["فَنَوَّلَ حَتّى لَم يَجِد مَن يُنيلُه","وَحارَبَ حَتّى لَم يَجِد مَن يُحارِبُه",6,"ب",2,0],["فَنَوَّرْتَ ما اظْلَمَّ مِنْ فِكْرَتِي","وقَوَّمْتَ ما اعْوَجَّ من أضْلُعِي",7,"ع",2,0],["فُنونُ الحربِ تَعرفُه عليماً","بأسرارِ الأسنَّةِ والنِّصالِ",8,"ل",1,0],["فَنَوَّرَ الدارَ بِبَعضِ نورِهِ","وَاللَيلُ قَد أُزيحَ مِن سُتورِهِ",9,"ه",1,0],["فَنَوْمِي كُلُّهُ سَهَرٌ","وَعَيْشِي كُلُّهُ أَسَفُ",10,"ف",1,0],["فَنَوَى أُفْعُولةً لَمْ يَنْوِها","غَيْرُهُ مِنْ قَبْلُ مَهْما يَكُ جَسْرَا",11,"ر",2,0],["فُنُونُ ثَقَافَةٍ رُعِيَتْ وَصِينَتْ","فَزَالَ الرِّيبُ وَانْتَعَشَ الرَّجَاءُ",12,"ا",2,0],["فُنونُهم كنّ للأيام مُعْجِزةً","وحُكمهم كان للدنيا قوانينا",13,"ن",2,0],["فَنَوْمِي كُلُّهُ سَهَرٌ","وعَيشِك كلُّهُ أسَفُ",14,"ف",1,0],["فنور البابا وطيب انفسا","واجرى الندا الطامي على كل وارد",15,"د",1,0],["فَنواظِرُ الأَفلاكِ شاهِدَةٌ لَهُ","بِالمَجدِ وَهوَ عَنِ العَيونِ مَحَجَّبُ",16,"ب",1,0],["فنور جبينه برق","وجود يمينه ديم",17,"م",1,0],["فنور جبينه قمَرٌ","وصوبُ يمينه ذهب",18,"ب",1,0],["فُنونُ المَعالي أُكمِلَت لِمُحَمَّدِ","لأثرَتِهِ في الخَلقِ وَالخُلقِ وَالوَصفِ",19,"ف",1,0],["فَنُوحي يا حمامةَ بطنِ وَجٍّ","فقد هَيَّجْتِ مشتاقاً حزينا",20,"ن",2,0],["فَنوحِي يا حَمائِمُ فَوقَ قَبرٍ","سَقَتهُ أَدمُعُ الباكينَ تَتَرى",21,"ر",2,0],["فنور البدر يمحقه التلاقي","ويبدره التباعد والتمام",22,"م",1,0],["فُنونُ جُنونِ الجاهلينَ كثيرةٌ","وَأَقبَحُها قردٌ يَرى نفسهُ بَدرا",23,"ر",2,0],["فنومُك من تحتِ الترابِ مُسَكَّنٌ","وَنَوْميَ من فوقِ التراب شريد",24,"د",1,0],["فَنَوِّلِي منْ قَتَلْتِ مُهجَتَهُ","هدِيَّةً مِنْحَةً على ذاكِ",25,"ك",1,0],["فنوا كلهم سبع مئينا وتسعة","طعام تغداه نسور وأذؤب",26,"ب",1,0],["فنودي من الوادي أنا اللَه فاستمع","لما أنا موح وانطلق برسالة",27,"ه",1,0],["فنوعي في شخصي لأني نتيجة","لشكل قياس عن ضروب عقيمة",28,"ه",1,0],["فنوالها كالريح منقلبٌ","ونعيمها كالظل منتقل",29,"ل",1,0],["فنؤمن أن اللَه عز بقدرة","وخلق وابرام لحكم المشيئة",30,"ه",1,0],["فُنونٌ لذي الأيّامِ أثوابُ مَرّها","إذا أخلقَتْ فينا أجدَّتْ لها فَنّا",31,"ن",2,0],["فنَوْمِيَ من عَيْني وقلبي من الحشا","وجسمي من الأوطانِ كُلٍّ مُشرَّد",32,"د",1,0],["فنواله فيهِ شفاء","لِلقُلوبِ وَلِلصُّدور",33,"ر",1,0],["فنوال ناب عن وبل الحيا","وجمال يخجل البدر التماما",34,"م",2,0],["فنوحي ما بدا لكِ أن تنوحي","فلا عيبٌ عليك ولا منام",35,"م",1,0],["فنويّ أَو مرسى عروسٍ أَو محا","ومحا محلٌّ منه حَلُّ العُقْدةِ",36,"ه",1,0],["فنونُ وصفِك أجنَتْنا غرائِبها","فما لها من نهاهُ بين أفنانِ",37,"ن",1,0],["فنوَّر الليلَ ولي","ست من ليالي التِّمِّ",38,"م",1,0],["فنواحي الهوى وِثاقٌ مصونا","تٌ وفي جانب التواصل ثُلمَهْ",39,"م",2,0],["فنوْمُه عازِبٌ والرأيُ مُقتربٌ","مُصَرَّفٌ بين إِيرادٍ وإصْدارِ",40,"ر",1,0],["فنوالهُ بالأمس بعضُ نوالهِ","في يومه واليوم جزءٌ من غدِ",41,"د",1,0],["فنودي يا هزبر الشعر مهلا","عليك فلا سبيل إلى القيام",42,"م",1,0],["فنوقع في شبه السقاسط عقلنا","ولا تبكين فيهم بكاء التواكل",43,"ل",1,0],["فنوح وعيسى ثم موسى وما لهم","من الفيض ثم الحضرة الإبراهيمية",44,"ي",2,0],["فُنونٌ أخذْناها عن الغَيْبِ في العَما","فلا السَّعيُ مَهْضومٌ ولا الأَجرُ مَمْنونُ",45,"ن",1,0],["فَنَوِّروهُ بالتَّجَلِّي مَنْظَراً","وقَرِّبوهُ بالتَّدَلِّي مَنْزِلا",46,"ل",2,0],["فُنونٌ تدفعُ الأكْدارَ عنَّا","وتُثبتُ في سَرائرنا فَلاحا",47,"ح",2,0],["فنوقنُ كلّما حمَلتْ إماءٌ","بأنّا ما نزالُ مُؤَجّلينا",48,"ن",2,0],["فنورُ مُبينِها جمْعُ الدّراري","وخيرُ مَقالِها الدُرَرُ النِثارا",49,"ر",2,0],["فَنَوبةُ اللّيل قد ولَّتْ كما نَزَلتْ","ونوبةُ الصّبحِ من هذا المشيبِ معي",50,"ع",2,0],["فنور على نور كذا قال ربنا","وذلك مشفوع لديه وشافع",51,"ع",1,0],["فنوالُه جمعَ العُفَاةَ وبَأْسُه","قَدْ شَرَّد الأَعْدَاءَ كُلُّ مُشرَّدِ",52,"د",1,0],["فنورز ألف نيروز سعيداً","رفيع الجد في عيش رفيه",53,"ي",2,0],["فَنُودي بِهُم قَبل التَبدد عُنوة","إِلى سُوء حال في قَرار لحود",54,"د",1,0],["فُنونٌ أَصبَح اِستحكام مَصرٍ","بِها نيرانه ذات اِندِفاع",55,"ع",1,0],["فُنونُ علومٍ حازها اليومَ وحدَه","بِصارمِ جِدٍّ لَمْ يُفَلَّ له حَدَّا",56,"د",2,0],["فنون مراميها ضروب حبالها","تصارعه حيناً وحيناً تخادع",57,"ع",1,0],["فنومي مذ سكنت بها سليب","كأن وسادتي ابر ونار",58,"ر",1,0],["فنوالا سيباً هتوناً هطولا","كالغوادي يسقي قريباً بعيدا",59,"د",2,0],["فنوري شاهد في عظم فضلي","إذا ما في ظلام الليل لعلّعْ",60,"ع",1,0],["فُنونُ أَهْلِ العِشْقِ فَنٌّ إِذا","ما أَغْرَقُوا فيه وفنِّي فُنونْ",61,"ن",1,0],["فنوال فضلكُ سجبه كم قد همى","وبمحض فضلك كم نأى شروهم",62,"م",1,0],["فَنوب النَّوائب","تَزول كَالسَّحائب",63,"ب",1,0],["فنوحُ بنُ منصورٍ طوَتْهُ يدُ الرَّدى","على حسراتٍ ضُمِّنَتْها الجوانِحْ",64,"ح",1,0],["فنوح ولا جدوى ووعد ولا وفا","وصبر ولا اجر فذا صبر مضطر",65,"ر",1,0],["فنواحى القَنَا والقَصرُ والوا","دى إذا ساحَ ماؤهُ وهوَ طامى",66,"م",2,0],["فنوسع سمعك عتباً يكاد","يُثيركَ قبل نِدى الآمرِ",67,"ر",1,0],["فنُؤوِّلْ غير النبي نبياً","فلتؤمل غير الإلِّه إلها",68,"ا",1,0],["فنواظري في جنة من حسنه","لكن قلبي في الجحيم المسعر",69,"ر",1,0],["فنوى رحلته ملتمساً","ان يلاقي في نواه النشبا",70,"ب",2,0],["فنون من الرقص البديع تهزنا","وكم كان في تلك الفنون فتون",71,"ن",1,0],["فنوه بي صنيعك وانتضاني","على أعداء ملكك مشرفيّا",72,"ي",2,0],["فنوء نداك الغمر يروي ركامه","إذا ما غمام أظمأتنا مخائله",73,"ل",2,0],["فنوهت باسمِيَ بعد الخم","ول ولولاك أَعوَزَ تنويهُ ذكري",74,"ر",2,0],["فنوري كنور الزبرقان إذا بدا","ملاء بما يعطيه نورُ ذُكاء",75,"ا",2,0],["فنورُ العلمِ ممدود","ونورُ الحدسِ ما يمسي",76,"س",2,0],["فنورُ الحقِّ ليس به خفاءٌ","على الأفلاكِ من سَعد السُّعودِ",77,"د",1,0],["فنوديتُ من تبغي فقلت وصالَ من","دعاني إليه قبل والرسم قد عفا",78,"ف",2,0],["فنومي على تلك البضائع ضائع","وقلبي على تلك الذوائب ذائب",79,"ب",1,0],["فَنواح الحمام للصب عندي","رقية لَيسَ تَنفَع الملسوعا",80,"ع",2,0],["فنوليني رشفة","أبل فيها كبدي",81,"د",2,0],["فنونا لنا يبدي من الطعن كفه","اذا اصبحت ريح الوقائِع تعصف",82,"ف",1,0],["فَنورها الوَهّاج","يغني عَن المصباح",83,"ح",1,0],["فَنُوافي إليهِ وَهْوَ مِنَ العَجْ","بِ بأنفٍ على الوزارةِ عالي",84,"ل",2,0],["فنورهم منه كالمرآة منعكس","وَكلهم من رَسول اللَه ملتمِس",85,"س",1,0],["فنوه جبريل بمجدك لا فتى","ولا سيف تنويهاً به ملأ الملا",86,"ل",2,0],["فنورها يخرق سبع الحجب","يفوق نور نيرات الشهب",87,"ب",1,0],["فنور طريقي للهداية وارعني","ولا تتركني في مسالكها أعش",88,"ش",1,0],["فنون العُلا في فتح مكة جُمعت","ومن فتحها لا في العدا كلهم رجفا",89,"ف",2,0],["فنويت تسقم مهجتي","ولكل مرءٍ ما نوى",90,"و",2,0],["فنورُ الهُدَى للمُجْتَلي غيْرُ آفِلٍ","ونارُ القِرَى للمُجْتَدي ليسَ تخْبأُ",91,"ا",1,0],["فنورُ الهُدَى لم يحتَجِبْ عندَما بَدا","ونارُ القِرى لم تَخْبُ منْ بعْدِ قدْحِها",92,"ح",3,0],["فَنَوَّبه عَنهُ خديويُّ عَصرِنا","بِأَمر القَضا إِذ قَد رَآهُ امينا",93,"ن",2,0],["فنور ذكاً عم البسيط ولم يبن","لغض جفون أو لفقد النواظر",94,"ر",1,0],["فنور علي قد غشى نور فاطم","فأولدها نجماً واعقبها بدرا",95,"ر",2,0],["فنوا عليها بالقبول ولا حظوا","محبرها العبد الذي خانه الدهر",96,"ر",1,0],["فُنونُ الحُسنِ حاويها وَإِنّي","حَوَيتُ مِنَ الصَبابَةِ كُلَّ فَنّي",97,"ن",2,0],["فنؤمن أن اللَه لا رب غيره","له الملك في الدارين والأمر والأحكم",98,"م",1,0],["فنوَّخَ مستنسَّاً وغارَ هُنيئةً","وأومض في جنحِ الدُّجى وهو ساطع",99,"ع",1,0],["فنوره الأصل في التكوين من أزل","فكل شي له في الكون منتسب",100,"ب",1,0],["فنولي الذي يولي المحبة مثلها","ونمطر من شاء العداء بوابل",101,"ل",1,0],["فنوه باسمه ودعاه حتى","لقد أوطاه فرق الفرقدين",102,"ن",1,0],["فنورها النور وأكمامه","أبصارنا والورق المفخر",103,"ر",1,0],["فنون الورى ضمَّت خزائن صدرهِ","ومجهولها أضحى لديهِ بلا غفرِ",104,"ر",1,0],["فنودي مراديونُ في أرخها هنا","لقد خوَّل المنّانُ خولا مُرادَها",105,"ه",2,0],["فنوديَ لما سرا أرختُ راقياً","أيا نعمةٌ قد نلتَ بالبرّ نعمتي",106,"ي",1,0],["فنٌ وقورٌ تقيٌ بارعٌ وَرِعٌ","نَدبٌ طَهورٌ زَهت طهراً برارتهُ",107,"ت",2,0],["فنونُ الهوَى مجهولةً ليس عارفاً","بشها غيرُ صبِّ مذهبي عندهُ شَرطُ",108,"ط",1,0],["فنوحٌ وإبراهيمُ الذبيحُ ويوسُفُ","ووالده يعقوبُ أيوبُ داودُ",109,"د",1,1],["فنوره من سناك مقتبس","ونوءه من نداك مسترق",110,"ق",1,0],["فنونُ الحواجب لا يزال مرهفا","لخوف سهامٍ إن لمحنا سواقمه",111,"م",2,0],["فَنومي حَرامٌ وحزني مُدامٌ","وَوَجدي سقامٌ ودمعي قطارُ",112,"ر",1,0],["فَنورٌ سَرى في الكَونِ صورَة أَحمَدٍ","بِهِ تَهتَدي لِلَّهِ كُلُّ بَصيرَتي",113,"ي",1,0],["فنور الآفاق في عدله","لذاك جزائح جلى",114,"ل",2,0],["فنون في جنون أي عقل لم يأوَّلها","وأسياف النوى كم قطعت بالهجر أوصالي",115,"ي",1,0],["فنور الحبيب بها ساكن","ومنها الحبيب فلا يخرج",116,"ج",1,0],["فنور محمد يهدي الحيارى","وينقذهم من التيه الخطيرِ",117,"ر",1,0],["فنون الشعر منك إليك سفر","تصاغر دونه الفن الجديد",118,"د",1,0],["فنوحي بشكواكِ شدْواً ووجداً","لدينا من الحزنِ شيءٌ جديدْ",119,"د",1,0],["فَنَوِّرِيْ أَجْمَلَ 