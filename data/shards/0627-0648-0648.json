{"poems":[[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[91,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[85,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[85,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[45,"قصة التل فاسمعها عجابه","https://www.aldiwan.net/poem10889.html","الخفيف"],[45,"قد قلت عن نصح لبرذونة","https://www.aldiwan.net/poem65148.html","السريع"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[48,"يا أيها العاذل دع ملحاتي","https://www.aldiwan.net/poem62460.html","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1942","الطويل"],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[77,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[0,"أمِنْ ذِكرِ سلمَى أنْ نأتْكَ تَنوصُ","https://www.poetsgate.com/ViewPoem.aspx?id=4800",""],[45,"قِصّةُ التّلّ، فاسمَعوها عُجَابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31562",""],[91,"شوق يروح مع الزّمان ويغتدي","https://www.poetsgate.com/ViewPoem.aspx?id=53481",""]],"verses":[["أَو واجِدٍ مَكظومَةٍ زَفَراتُهُ","أَو حاقِدٍ مَنسيَّةٍ شَحناؤُهُ",0,"ا",3,0],["آووْا نصَروا أوذُوا صَبَروا","كانوا لرَسولِ اللّهِ وِقا",1,"ق",2,0],["أو وليّاً يعطي لطَوْريَ حقّاً","ويَرى فضْلَهُ على الأطْوارِ",2,"ر",1,0],["آوَوْهُ فِي الَّروْعِ لَمَّا حَلَّ دَارَهُمُ","وَجَالَدُوا مَنْ عَتَا فِي دِيِنِهِ وَأَبَى",3,"ب",2,0],["أُؤَوِّلُ الحُكمَ عَلى وَجهِهِ","لَيسَ قَضائي بِالهَوى الجائِرِ",4,"ر",1,0],["أَؤوبٌ نَعوبٌ لا يُواكِلُ نُهزُه","إِذا قيلَ سَيرُ المُدلِجينَ نَصيصُ",5,"ص",1,0],["أَو واجِفٍ أَو راجِفٍ مُتَرَجرِجِ","أَو نافِرٍ أَو حائِرٍ مُتَرَدِّدِ",6,"د",1,0],["أووا شيبا وشبانا إليها","تخالهم الصحابة والتِّباعا",7,"ع",2,0],["أَو وَثَبَت فَالنَجمُ مِن تَحتِها","وَالسورُ في أَسرِ أَسيراتِهِ",8,"ت",2,0],["أَو وَجَدتُم حَجِماً إِن حَفَرتُم","رالَ شَكٌّ العِصابَةَ المُرتابَة",9,"ب",2,0],["أَو وَقَفَ العَيرُ عَلى بَولِها","أَنعَمَ أَن يَستافَ أَو يَكرُفا",10,"ف",2,0],["أَو وَراء اِبتِسامَةٍ حُلوةِ الثَغ","ر نَقيّ مفلّجٍ أَقحوانُه",11,"ه",1,0],["أَو وَقفَةٍ في مَحضَرٍ جَرَّت بِهِ","عَصفُ الرِياحِ الهوجِ ذَيلَ عَجاجِ",12,"ج",1,0],["أَو وَقدَ نيرانٍ عَلى الحافاتِ","أَفديكَ خُذها مِن يَدي وَهاتِ",13,"ت",1,0],["أَوْ وِليَمُ الوَافِي بِنَذْرِ اللهِ فِي","مُتطَاحَنِ الأَدْيَانِ وَالأَشْيَاعِ",14,"ع",1,0],["أَؤوبٌ نَعوبٌ لا يُواكِلُ نُهزُها","إِذا قيلَ سَيرُ المُدلِجينَ نَصيصُ",15,"ص",1,0],["أو وجهُ عذراءَ ذَاتِ خِدرٍ","تظنُّ أن السفورَ عار",16,"ر",1,0],["آوَوْه في الرَّوْع لمّا حَلّ دارَهُمْ","وجالَدُ وأمنْ عَتا في دينِهِ وأبا",17,"ب",2,0],["أووب نعوبٌ لا يواكل نهزُها","إذا قيلَ سيرُ المدجلينَ نصيصُ",18,"ص",1,0],["أوْ وَجَدْتُمْ مَحاجِماً، إن حفرْتُمْ،","زَالَ شَكُّ العِصَابَةِ المُرْتَابَهْ",19,"ب",2,0],["أو واجف أو راجف مترجرج","أو ظافر أو حائر متردّد",20,"د",1,0]]}