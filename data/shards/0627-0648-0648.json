64","الكامل"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145394","البسيط"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120437","الكامل"],[4727,"كورونا الجهل","https://www.poetsgate.com/ViewPoem.aspx?id=210833",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4927,"العاشقة المتقلبة","https://www.poetsgate.com/ViewPoem.aspx?id=29622",""],[5081,"مِنْ مَعَانِي الشِّعْر","https://www.poetsgate.com/ViewPoem.aspx?id=186468",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5170,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=175493",""],[5431,"الأنثى(الكلبة)...","https://www.poetsgate.com/ViewPoem.aspx?id=212495",""],[5480,"يا وجد","https://www.poetsgate.com/ViewPoem.aspx?id=35636",""],[5526,"عايش","https://www.poetsgate.com/ViewPoem.aspx?id=193728",""],[5881,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=183810",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5897,"زارنا الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=160573",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5956,"شهر التأشيرة هو شهر النحس","https://www.poetsgate.com/ViewPoem.aspx?id=192787",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[6035,"لاتحْزَنّنَ لأن عمركَ ماضيٌ","https://www.poetsgate.com/ViewPoem.aspx?id=168761",""],[6093,"كوني كمثل قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=207267",""],[6320,"وَخْزُ الرِّمَاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84350&r=&rc=47",""],[5064,"ما لم تستطعه المحابر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87512&r=&rc=7",""]],"verses":[["أَو واجِدٍ مَكظومَةٍ زَفَراتُهُ","أَو حاقِدٍ مَنسيَّةٍ شَحناؤُهُ",0,"ا",3,0],["آووْا نصَروا أوذُوا صَبَروا","كانوا لرَسولِ اللّهِ وِقا",1,"ق",2,0],["أو وليّاً يعطي لطَوْريَ حقّاً","ويَرى فضْلَهُ على الأطْوارِ",2,"ر",1,0],["آوَوْهُ فِي الَّروْعِ لَمَّا حَلَّ دَارَهُمُ","وَجَالَدُوا مَنْ عَتَا فِي دِيِنِهِ وَأَبَى",3,"ب",2,0],["أُؤَوِّلُ الحُكمَ عَلى وَجهِهِ","لَيسَ قَضائي بِالهَوى الجائِرِ",4,"ر",1,0],["أَؤوبٌ نَعوبٌ لا يُواكِلُ نُهزُه","إِذا قيلَ سَيرُ المُدلِجينَ نَصيصُ",5,"ص",1,0],["أَو واجِفٍ أَو راجِفٍ مُتَرَجرِجِ","أَو نافِرٍ أَو حائِرٍ مُتَرَدِّدِ",6,"د",1,0],["أووا شيبا وشبانا إليها","تخالهم الصحابة والتِّباعا",7,"ع",2,0],["أَو وَثَبَت فَالنَجمُ مِن تَحتِها","وَالسورُ في أَسرِ أَسيراتِهِ",8,"ت",2,0],["أَو وَجَدتُم حَجِماً إِن حَفَرتُم","رالَ شَكٌّ العِصابَةَ المُرتابَة",9,"ب",2,0],["أَو وَقَفَ العَيرُ عَلى بَولِها","أَنعَمَ أَن يَستافَ أَو يَكرُفا",10,"ف",2,0],["أَو وَراء اِبتِسامَةٍ حُلوةِ الثَغ","ر نَقيّ مفلّجٍ أَقحوانُه",11,"ه",1,0],["أَو وَقفَةٍ في مَحضَرٍ جَرَّت بِهِ","عَصفُ الرِياحِ الهوجِ ذَيلَ عَجاجِ",12,"ج",1,0],["أَو وَقدَ نيرانٍ عَلى الحافاتِ","أَفديكَ خُذها مِن يَدي وَهاتِ",13,"ت",1,0],["أَوْ وِليَمُ الوَافِي بِنَذْرِ اللهِ فِي","مُتطَاحَنِ الأَدْيَانِ وَالأَشْيَاعِ",14,"ع",1,0],["أَؤوبٌ نَعوبٌ لا يُواكِلُ نُهزُها","إِذا قيلَ سَيرُ المُدلِجينَ نَصيصُ",15,"ص",1,0],["أو وجهُ عذراءَ ذَاتِ خِدرٍ","تظنُّ أن السفورَ عار",16,"ر",1,0],["آوَوْه في الرَّوْع لمّا حَلّ دارَهُمْ","وجالَدُ وأمنْ عَتا في دينِهِ وأبا",17,"ب",2,0],["أووب نعوبٌ لا يواكل نهزُها","إذا قيلَ سيرُ المدجلينَ نصيصُ",18,"ص",1,0],["أوْ وَجَدْتُمْ مَحاجِماً، إن حفرْتُمْ،","زَالَ شَكُّ العِصَابَةِ المُرْتَابَهْ",19,"ب",2,0],["أو واجف أو راجف مترجرج","أو ظافر أو حائر متردّد",20,"د",1,0],["او وافى العاجز حضرته","فشؤُن القدرة تعضده",21,"د",2,0],["أو واد درأة في البحار مصبه","وسواقي ساقي حمرة صباً لما",22,"م",2,0],["أو وَجَدتُ امرَءاً بَصِيراً بِمَعنًى","حَسَنٍ في سلاَسَةِ اللَّفظِ رِيمَا",23,"م",2,0],["أو وردةٌ صاغ الربيع جمالها","لترشّني الأصباح بالأنداء",24,"ا",2,0],["أَو وَمضَةٌ من شُعلَةٍ مُبهَمَه","قُدِّستِ يا غَيبوبَةَ الشاعِرِ",25,"ر",1,0],["أو واردُ سرّ الفتح سرى","بحشاً صبٍّ بالحبّ هجي",26,"ج",2,0],["أوولئك وراث النبي ورهطه","وأولاه بالرغم للمتعامي",27,"م",2,0],["أَووا إِلى كَهفِ سُلَيمى فَجَنّوا","مِن نَحلِها الزاكي بِها أَزكى العَسَل",28,"ل",1,0],["أو وعظ نجم الدين رن كأنه","قدر يحذر في حماسة خلها",29,"ل",3,0],["أو واحدِ الحسناتِ غيرَ مشبَّهٍ","بأخٍ وفردِ الفضل غيرَ ممثَّلِ",30,"ل",1,0],["أو وردَ الناسُ فلم يصدروا","عجزاً فأنت الواردُ الصادرُ",31,"ر",1,0],["أو وجنة ذبلت طراوتها أسى","أو روضة بنوالها لم تذبل",32,"ل",1,0],["أو وَجيهاً أو قاضِياً أو صَديقاً","أو أديباً أو عالماً نِحريرا",33,"ر",2,0],["أو وَجيهاً أو قاضِياً أو نَبيلاً","أو أديباً أو عالماً نِحريرا",34,"ر",2,0],["أَؤوبُ إِلى أُمّي سَليماً مُكَرَّماً","وَغَرسانُ مَقتولٌ بِدارِ هَوانِ",35,"ن",1,0],["أَو وَقعَةً تَجلو عَنِ الدينِ القَذَر","أَو شَرَفاً يُتِمُّ نُوراً قَد زَهَر",36,"ر",1,0],["أو وقفا في موقف شديد","أو بذلا للحرب من مجهود",37,"د",1,0],["أو وَدَّعُوا قَرماً أغَرَّ سُمَيدعاً","مِنهُم فَقد نَصَبُوا الأغَرَّ سُمَيدعا",38,"ع",2,0],["أو وسموني سمة الغدّار","أنا طليق الرّكض والفرار",39,"ر",1,0],["أو واصِل بن عطاء أُعطيَ وَصْلَها","لم يَعْتزلْ عن حُسْنها ولها اعْتَزى",40,"ز",2,0],["أو وجد الصاحب عن","ه معرضاً لا يعتب",41,"ب",1,0],["أو وصفِ وجهٍ مثلِ وَجْهِكِ لم يزلْ","أبداً يفوقُ الشمسَ بالإِشراق",42,"ق",1,0],["أو وجنة حمراء قد","عرقت حياء من مواصل",43,"ل",1,0],["أو وطء أخفاف المطي وقد غدت","تحت الأحبة في الصعيد الاعفر",44,"ر",1,0],["أو وَلو بالوعد داووا سقما","حاله حال عضول مويسِ",45,"س",1,0],["أووردة طرزت بآس","فر فوجدي عليه أوفر",46,"ر",1,0],["أو وثبة ملأت آنافهم شمما","حتى تحكم فيهم ذلك الشمم",47,"م",1,0],["أو ورودُ البشيرِ بالنُّجحِ مِن فَ","كِّ أسيرِ أو يسرُ أمرٍ عسيرِ",48,"ر",1,0],["أو وُشومٌ مِن فَوقِهنَّ وشومٌ","رَجَّعَتها بمِغصَمٍ عَذراءُ",49,"ا",2,0],["أو ورود يفوح منها أريج","يغمر البيد عطره والجبالا",50,"ل",2,0],["آووا طريد نبيهم","طروا الذي آوى فهامه",51,"م",2,0],["أو وَردَةً، تُحسَبُ من حُسنِها","حُوريَّةً وهي من النّاس",52,"س",1,0],["أو واجدا في ومن سعي خفة","أو آخذا لصحيفتي بيسار",53,"ر",1,0],["أو وَاحِدٌ والجَِسمُ حَامِلُ هَذِهِ ال","أوصَافِ حقًّا فأتِ بِالفُرقَانِ",54,"ن",1,0],["اوَوَدَّعوني توديع الْشقيق فما","كان الْفراقُ ولاَ التوديعُ في خِلَدي",55,"د",2,0],["أو وإلا تبت والرح","من من لعب الكعاب",56,"ب",1,0],["أو ولدي عن حبهم قصروا","ضغطتهم بالرغم والهون",57,"ن",1,0],["أو وشاحاً يَجُولُ فَوقَ كَثِيبٍ","بِسَراحٍ وينثني برواحَ",58,"ح",1,0],["أو وَصَلت للموصلي فيما مضى","عند الغِنا بغَيرها لم ينطِقِ",59,"ق",1,0],["أو وَصفِ حمراءِ خُرطُومٍ مُعتَّقَةٍ","أَو مدحِ غِرٍّ عَنِ الأفضَالِ مُنعَزِلِ",60,"ل",1,0],["أو واضعٍ في هوى حزبٍ قريحتَه","تراه كاتب إِلقاءٍ وإِملاء",61,"ا",2,0],["أو وردة حف بها شوكها","والعين من وخزٍ له شاكية",62,"ي",2,0],["أو وِصَل موسى عقب ياسِ","فِيْ حضن أمّه الملهوفه",63,"ف",2,0],["آووا لبعض بيوت الله من فرق","من العدو وللأعداء عدوان",64,"ن",1,0],["أوَوا إِلى جبل آواهُم زَمَناً","وَلَم يَكُن لهم من دونه وزرُ",65,"ر",1,0],["أو وهجتها الشمس من قطعهم","اراكةً تظلها في نهار",66,"ر",1,0],["أَو وِفاقٌ أَو نفاقٌ","أَو رضاء واحتمال",67,"ل",1,0],["أو والهٌ قائم يصلي","إليك بالمدمع الهتون",68,"ن",1,0],["آوو إمام المسلمين محمدا","لما جفاه رئيس آل معمر",69,"ر",1,0],["أو وردةً فوق صدرِ فاتنة","يفضح غصن النقا تأودها",70,"د",3,0],["أو وجد الفرد بغير ثان","مع امتناع الغير والامكان",71,"ن",1,0],["أو وجد الكثير بالتناهي","أو غيره قيل كعلم الله",71,"ه",1,0],["أو وجنة للورد ناصعة","عبث النسيم بها فجرحها",72,"ح",3,0],["أَو وَجدَ شَيخٍ أَضَلَّ ناقَتَهُ","يَومَ رَواحِ الحَجيجِ إِذ دَفَعوا",73,"ع",3,0],["أَو وقفتم على غُلُوّيَ فيكم","قام لي عندكم بذلك سوق",74,"ق",1,0],["آووه وودّوه والاقارب صدّوا","عنه وتصدّوا له أذية حساد",75,"د",1,0],["أو وجه مسفرة تخلله","من وجنتيها مرسل الشعر",76,"ر",1,0],["أَو والَ شطر بني العلياءِ عن أَربٍ","يُبدي عهوداً بِبَذل الروح والمالِ",77,"ل",1,0],["أو ومض برق يستهل لما حل","رمقته من فرح به الأبصار",78,"ر",1,0],["أو وقَقتم ولو كلوث أزارٍ","لشكونا جوىً وداءاً دَخيلا",79,"ل",2,0],["أو وضعه في آلةٍ قد أحدثت","للصوت حفظاً عند قصد حداء",80,"ا",2,0],["أو وجنة وهي جسم ماء","تعود إثر الحياء نارا",81,"ر",2,0],["أو وَنَّة اللّي مُوجِدينَه غِريجِ","أرموه واقفَوا فِيْ بحورٍ لِجايج",82,"ج",1,0],["او وصف خمر او مليح","او رداح تخلب",83,"ب",1,0],["أو واضعٌ قفَّازهُ بيمينهِ","نظروا إليه كأنه مُتَألِّسُ",84,"س",1,0],["او وين زيدن مانفع فيه تطبيب","ومانع اسد غابن عن الغاب قد غاب",85,"ب",1,0],["أَوْ وَلْوَلَتْ - فِيْ لَيَاْلِي الْقَهْرِ - نَاْدِبَةٌ","ثَكْلَىْ تَنُوْحُ عَلَىْ أَغْلَىْ غَوَاْلِيْهَاْ",86,"ي",3,0],["أَوْ وَرْدَةٌ ذَبُلَتْ عَلَىْ دَرْبِ الْهَوَىْ","وَهَوَتْº فَدَاْسَتْ فَوْقَهَا الرُّكْبَاْنُ",87,"ن",1,0],["أَوْ وَرْدَةٌ تُهْدَى لِقَلْبٍ عَاشِقٍ","كَادَ الْفُؤَادُ بِدُونِهَا أَنْ يَنْفَلِقْ",88,"ق",1,0],["أَو وُقِدْتُ فَنَارُهُ مِلْءَ جَمْرِيْ","أَوْ طُفِيْتُ رَمَاْدُهُ فِيْ انْطِفَاْئِيْ",89,"ا",3,0],["او وجد منهو بشروه بمهنا","من عقب ما شاب الشعر حزن والام",90,"م",1,0],["أؤوله خطيئة من أحبوا","وأقرؤه كتابا من سعير",91,"ر",1,0],["((أو وجد قلب ٍ فالهوى ضيّع الود","وأمسى تليف الحال ضايق سبيله))",92,"ل",2,0],["أو وجد .. عود ٍ لا لمح هوج وبروق","اجهش يشوف بنوضها صاحبه ذاك",93,"ك",1,0],["أو وجد .. حرٍ مقيدٍ طرق بسبوق","وغيد الحباري بناظره هدّ وعراك",93,"ك",1,0],["أو وقفةٌ حيرى على عتباته","خذلت خطانا والزمان يطيل",94,"ل",1,0],["أو وجه آمنة الحبيب فإنها","طائية الأوصاف بالإسهابِ",95,"ب",1,0],["أو وابلٌ بالبشر لبى إذ شكت","أحداقها من جفوة الأمطار",96,"ر",1,0],["أو وزغ يجول في سقوفه","أو خنفس في الحش تسعى وتدب",97,"ب",1,0],["أؤوب لأحضانِ نجلي رضيعاً","كسيحاً ومن عطفه أستجِرُّ",98,"ر",1,0],["أو ورقاً مختطفاً بالصبا","مضطرباً منقلباً في القفار",99,"ر",1,0],["أو وُرِّثتْ في الأرضِ مملكةٌ ولا","عن عرشها تتنازل الحكّامُُ",100,"م",1,0],["أو وردةٍ كصبيةٍ","بشفيفِ مدحٍ قدْ أُثيرتْ",101,"ت",1,0],["أَؤُوبُ إِلَى فِرَاشِي تَعْتَرِينِي","عَلَى جَنَبَاتِهِ أَنْكَى جِرَاحِ",102,"ح",1,0],["أَؤوبُ إِلى صَمْتٍ علَى عتباتهِ","ستصعَدُ للمعنَى القَصيِّ المنَابِرُ",103,"ر",1,0]]}