{"poems":[[75,"قد بعثناه ينفع الأعضاء","https://www.aldiwan.net/poem11983.html","الخفيف"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[68,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[68,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[68,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[82,"يا رسولي الذي يحدث سمعي","https://www.aldiwan.net/poem31299.html","الخفيف"],[76,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[50,"اكسر بمائك سورة الصهباء","https://www.aldiwan.net/poem10405.html","الكامل"],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[164,"ردي جفونك عن حشاي قليلا","https://www.aldiwan.net/poem58771.html","الكامل"],[186,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[257,"طرف المحب موكل بعذابه","https://www.aldiwan.net/poem1450.html",""],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[287,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[343,"أيا من تدعي شتمي سفاها","https://www.aldiwan.net/poem68668.html","الوافر"],[376,"كم نهتهم صبابتي وغرامي","https://www.aldiwan.net/poem57128.html","الخفيف"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[463,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[468,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[484,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[574,"أنا مسكين لمن يعرفني","https://www.aldiwan.net/poem52042.html","الرمل"],[580,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18530","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62545","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64732","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77766","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45384","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66250","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125404","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52096","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106887","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93726","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110664","الرمل"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22595","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93861","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65225","الكامل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108082","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""],[3656,"","https://poetry.dctabudhabi.ae/diwan/poem/133926","الكامل"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143027","الخفيف"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136388",""],[4684,"غزة","https://www.poetsgate.com/ViewPoem.aspx?id=202388",""],[4797,"هجن الرئاسة","https://www.poetsgate.com/ViewPoem.aspx?id=133829",""],[4859,"غصون النرجسية!","https://www.poetsgate.com/ViewPoem.aspx?id=209110",""],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[5002,"إلهام","https://www.poetsgate.com/ViewPoem.aspx?id=205827",""],[5092,"أكسوهُ شوقًا","https://www.poetsgate.com/ViewPoem.aspx?id=176854",""],[3591,"من دولة الحسن أم من دولة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=149490",""],[5431,"علّ القلوب من السماحة تلبسُ","https://www.poetsgate.com/ViewPoem.aspx?id=191469",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5438,"عَزْفٌ فِي مَقَامَاتِ الحَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=202093",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5956,"أرملة","https://www.poetsgate.com/ViewPoem.aspx?id=181844",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6052,"رداء السكينة والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=34646",""],[186,"عرجا في ربوعها وسلاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55810&r=&rc=73",""],[463,"هلْ في الشُّموسِ التي تحدى بها العيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60092&r=&rc=148",""],[6252,"أحزانٌ لسيدة الصحو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79805&r=&rc=0",""],[572,"يا عليَّ بَنَ سليمانَ وَيَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9179&r=&rc=36",""]],"verses":[["أَكسَبَتهُ الأَيّامُ بَردَ هَواءٍ","فَهُوَ جِسمٌ قَد صيغَ ناراً وَماءَ",0,"ا",2,0],["أكسوه مدحي طائعاً لا مُحْرجا","عن مِقَةٍ تلقى الضمير مُشْرجا",1,"ج",2,0],["أكسبها الحبَّ أنها صُبغت","صبغة حَبِّ القلوب والحدق",2,"ق",1,0],["أَكسَبتُهُم مالي فَمُذ طَلَبوا دَمي","لَم أَشكُهُم إِلّا إِلى البَيداءِ",3,"ا",2,0],["أَكسَبتَ أُفقَ المُلكِ يا نَجمَ الهُدى","نوراً جَلا ظُلَمَ الخُطوبِ السودا",4,"د",2,0],["أَكسَبتَني بِالقُربِ مَجداً وَعُلاً","فَصُغتُ فيكَ المَدحَ سِرّاً وَعَلَن",5,"ن",1,0],["أكسبتني جفونُها من سقامٍ","عرَضاً ضاق عنه جَوْهَرُ جسمي",6,"م",2,0],["أَكسَبنَني خُلقَ الوَفاءِ وَرُبَّما","أَذكَرنَني بِمَواقِفِ العُشّاقِ",7,"ق",1,0],["اِكسِر بِمائِكَ سَورَةَ الصَهباءِ","فَإِذا رَأَيتَ خُضوعَها لِلماءِ",8,"ا",2,1],["اكسُ ياربِ بلادي رحمة ً","وحناناً مثلما يُكسَى الجنين",9,"ن",1,0],["أكسو قديمي أفوافاً تجدده","وبعض ما تكتسي الأشعار أكفان",10,"ن",1,0],["أكسيْتَني جاهاً غنيتُ بفضلهِ","ومهدت لي في ساحتيْك مقيلا",11,"ل",2,0],["اَكسَبتُهُ الأَيّام حلماً لَو اِرتَدْ","دَ إِلَيها لَم نَشكِ جَهلَ قَضاها",12,"ا",3,0],["أَكسبَت فيها القَلب عِلَّة حُرقَة","مُستأسِداً فاِختالَ في جِلبابِهِ",13,"ب",2,0],["أكْسب حَتَّى الغُيوثَ بُخْلاً","يَشِينُها واللّيوث جُبْنا",14,"ن",2,0],["أَكسَبَهُ فِعالُهُ بَينَ الوَرى","أَجَدَّ مَدحٍ وَأَجَلَّ حَمدِ",15,"د",1,0],["أُكَسِّبُكَ الثَوابَ ببتّ شَتمي","وَأَستَدعي بِهِ إِثماً إِلَيّا",16,"ي",2,0],["أكسَبَتها الأيَّامُ رَونقَ حُسنٍ","ليسَ يَفنَى ولا معَ الأيَّامِ",17,"م",1,0],["إكسيرُك الممدوح عنا مختفٍ","والدانق المحمود في طي الدُغَل",18,"ل",1,0],["أكسد المدحُ فبعناه رخيصاً","وهو فيه سَنةَ الجدبِ يُغالي",19,"ل",2,0],["أُكسبه الحمدَ بين ثاوٍ","من أثرٍ في العلا وخالي",20,"ل",2,0],["أُكسُ وحرمتِنا عندي جَمالَهما","فالجودُ بالمالِ ما لم تَكْسُ مبتورُ",21,"ر",1,0],["أكسف من سماء ساقط أم","كسوف ضحى عشيته خسوف",22,"ف",1,1],["أكسبتم الجد في الدارين مفخرة","ما كان يجمل أن تنسى أياديها",23,"ي",3,0],["إكسِبِ المالَ لِتحظَى","مِن رِفاقٍ بِالتَّداني",24,"ن",2,0],["أَكسبته الورق البيض أَباً","وَلَقَد كان وما يُدعى لأب",25,"ب",1,0],["أُكْسَى وأَخْلعُ أَثوابَ النَّعيم فكَم","جرَّرتُ للتِّيه أَذيالي وأَرداني",26,"ن",2,0],["إِكسَعِ البِصرِيَّ إِن لا قَيتَهُ","إِنَّما يُكسَعُ مَن قَلَّ وَذَل",27,"ل",1,1],["أكسبتها نضارةُ الدهر حسناً","ظاهراً في رشاقة الأبدانِ",28,"ن",1,0],["إكسير كنز المجد شمس ضحى العلا","إنسان عين الوجود ليث الجحفل",29,"ل",1,0],["إكسير كنز المعالي عند جوهرها","فمجده الدر والأكوان لبات",30,"ت",1,0],["أَكْسَبَني نَشْوةً بِطَرْفٍ","سَكِرْتُ مِن خَمرِهِ فَعَرْبدْ",31,"د",1,0],["أَكسَبَني التّجاربا","فكدت أَدري الغائِبا",32,"ب",2,0],["إكسير أَنواع الجَواهر رفعها","من قدر مخشلب إِلى ياقوت",33,"ت",1,0],["أَكسى مِن الكَعبَةِ الزَهراء مِن نَشَبٍ","أَعرى عَلى لبسِهِ العَليا مِنَ الحَجَرِ",34,"ر",1,0],["اكسبها بيمنه مفاخراً","خالدة مدى المدى لا تنفد",35,"د",1,0],["أكسبتها أشعةُ الشمسِ دفئاً","ونمواً ونفحةً من دهانِ",36,"ن",1,0],["أكسبت مصر فخاراً نعم ما وضعت","يداكَ في عالم الأنغام والطَّرَبِ",37,"ب",1,0],["أكسَبَتْ بّدرَ التمَامِ حُسنَهُ","أخذَتْ شمس الضُّحى منها البَها",38,"ه",2,0],["أكسبه الحسنُ معاني الهدى","مغنيةً عن فانات العلوم",39,"م",1,0],["أَكسدت سوق حَياة المُسلمين فَلا","دين يسام وَلا دُنيا لَها ثَمَن",40,"ن",1,0],["أكسني حلة صيف","ما أرى غيرك كاسي",41,"س",2,0],["اِكسُني أَصلَحَكَ الل","هُ قَميصاً وَصِقاعا",42,"ع",2,0],["أكسبته العلى حلى افتخار","بسناه يزهو على كيوان",43,"ن",1,0],["إكسيرُ نفسي في هواك أذبتهُ","أو ما تراها في هواك تصعدُ",44,"د",1,0],["اكسبته يد الطبيعة نقشاً","مثل نقش السجادة الأعجميه",45,"ي",2,0],["اكسبت اسمك حسنا في الشفاه فقد","هامت به الناس حباً حينما ذكرا",46,"ر",2,0],["اكسوك جسمي وروحي ثوب عافية","وصحةٍ راضياً لي بزة السقم",47,"م",1,0],["أكسيت عزاً مذهب الديباج","ومنحت فضلا ما تشا من حاج",48,"ج",1,1],["أكسرى ذا سليمان نبي","من الرحمن أرسله يرود",49,"د",1,0],["اكسبتهم صفر الخدود جدودا","وأبا بيضها دعتهم كراما",50,"م",2,0],["أكسبتنا سقتنا نطفا","خفة الطبع وثقل الألسن",51,"ن",1,0],["أكسبتها العز الكثير محامداً","تبقى فعز بأن تعيش قليلا",52,"ل",2,0],["أكسد المسك طيبهن وأزرى","بالغوالي فهن غير غوال",53,"ل",1,0],["أكسبته شرفا فأنت به","فخر له ولأهله ذخر",54,"ر",1,0],["اكسر حصارك لا تهادن وانتفض","أسرج قناديل القلوب الواجلة",55,"ل",2,0],["اكسرت تيم وخذت سيف السيوف","وللرياسه شلته رمز وهدية",56,"ي",2,0],["‏‎‎‎‎‎‎‎‎‎اِكسري غصن الأنا ذا","ياغصون النرجسية",57,"ي",2,1],["أكسوه من أثوابها حُللاً بها","خجلاً تكاد بفضلها تَخفى عدن",58,"ن",1,0],["إكسيْرُ نَبضِي فكيفَ النَّأْي أَعْتِقهُ","لو حالَ بَيْني وبَيْنَ الشِّعرِ إغْفالي ؟",59,"ل",2,0],["أكسوهُ شوقًا لو تَعَرّى قُبْلةً","هل ذاقَ طعم الشوقِ يومَ كِسائهِ",60,"ا",3,0],["أكسبت ذكرك حسناً في الشفاه فلو","جرى بها هام فيه ناطقّ وسبي",61,"ب",2,0],["اكسر قداحك في بلاط صبابتي","علّ الشظايا بالشغاف ستغرسُ",62,"س",1,0],["اكسر نيوب خديعة","لست الفداء لينحره",63,"ر",2,0],["إِكْسِرْ شِرَاعَكَ فِي ضِفَافِ جُفُونِهَا","بِسُجُونِهَا يَتَحَرَّرُ الأَحْوَازُ",64,"ز",1,0],["أكسير الحب وبلسمه","يجري في عمق شراييني",65,"ن",2,0],["اكسري الأحزان كسراً","إنها أقسى القيودْ",66,"د",1,0],["أكسوف شمس أَمْ هو الإعتامُ","أغشى عيوناً صابها الإظلامُ",67,"م",1,1],["اكسَيْتَ عُمْرَكَ بالرجولةِ والفِدى","وكتبتَ ذكرَكَ في الزمانِ بما شدى",68,"د",2,1],["اكسبته الأيام حلماً لو ارتد","إليها لم نشك جهل قضاها",69,"ا",3,0],["أكسُ وحرمتنا عندي جمالها","فالجودُ بالمالِ ما لمْ تكسُ مبتورُ",70,"ر",1,0],["أُكسِّرها مثل الزجاجِ.. تبعثرتْ","أُجمِّعُها في راحتي وأبوسُها",71,"س",3,0],["أكسَبَتْ شكواكَ قلبي عِلَّة ً","مَا أَراهُ قبلها قَطُّ اكتَسَبْ",72,"ب",1,0]]}