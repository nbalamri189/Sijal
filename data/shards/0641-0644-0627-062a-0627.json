m.aspx?id=177298",""],[307,"جَمَالُ الشّيْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=214156",""],[5376,"أيا مُلهمي بالشعرِ ما قلْتُ عابثا","https://www.poetsgate.com/ViewPoem.aspx?id=197708",""],[5431,"ستنتصر الشعوبُ بلا محالِ","https://www.poetsgate.com/ViewPoem.aspx?id=183074",""],[5431,"وماالنصر إلا من قلوبٍ جسورة","https://www.poetsgate.com/ViewPoem.aspx?id=187798",""],[5431,"إلى الجزائر الحبيبة ....","https://www.poetsgate.com/ViewPoem.aspx?id=190246",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5497,"مصاحبة الأخيار","https://www.poetsgate.com/ViewPoem.aspx?id=207030",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5703,"يابارد الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=211909",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5952,"أقيموا على أخلاقنا اليوم مأتما","https://www.poetsgate.com/ViewPoem.aspx?id=197109",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5997,"وصايا","https://www.poetsgate.com/ViewPoem.aspx?id=214221",""],[6070,"صُرُوفُ الدَّهْرِ دائرةٌ تدورُ","https://www.poetsgate.com/ViewPoem.aspx?id=189069",""],[6082,"تمادت طويلا","https://www.poetsgate.com/ViewPoem.aspx?id=180042",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[242,"ألا ايها القائد المجتبي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563712",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""],[5567,"اعتذار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81824&r=&rc=74",""]],"verses":[["فَلا تَأَمَنِيهِ أَن يُسِرَّ شَماتَةً","فَيُظهِرَها إِن أَعقَبَتهُ العَواقِبُ",0,"ب",1,0],["فلا تأكل طعامك بأزدراد","معاجلةً فيأكلَك الطعام",1,"م",1,0],["فلا تأمنوا الأيام أن صُرُوفها","كما هي إذ أودت بعاد وجُرْهُم",2,"م",1,0],["فَلا تَأمَنُ الأَعداءُ أَسيافَ مازِنٍ","وَلَكِنَّ رَأيَ اِبنَي قُفَيرَةَ قَصَّرا",3,"ر",2,0],["فَلا تَأمَنَنَّ الحَيَّ قَيساً فَإِنَّهُم","بَنو مُحصَناتٍ لَم تُدَنَّس حُجورُها",4,"ر",3,0],["فَلا تَأمَنَنا يا اِبنَ أُمِّ مُجالِدٍ","إِذا لَقِحَت حَربٌ وَأَعصَلَ نابُها",5,"ب",3,0],["فلا تأس للدنيا ولا تغتبط بها","فوهابها سلابها وفجوعها",6,"ع",3,0],["فلا تأنس أبا حسنٍ بحظٍّ","ومَعمرُهُ من الأخيارِ خالي",7,"ل",2,0],["فَلا تَألُ في هَجري فَإِنّي مُتَيَّمٌ","عَلى هِجرَةٍ بالَغتَ فيها فَما آلو",8,"ل",2,0],["فَلا تَأمَني غَزوَ أَفراسِهِ","بَني وائِلٍ وَاِرهَبيهِ جَديلا",9,"ل",2,0],["فَلا تَأمَنَنَّ لَهُ عَثرَةً","فَكَم مِن كَريمٍ بِهِ قَد عَثَر",10,"ر",1,0],["فَلا تَأمَنَنْ مِنهنَّ إن كنتَ حازماً","ولا من هواها المرءَ خبلاً ولا ختلا",11,"ل",2,0],["فلا تأمَنِ الأعداءُ إملاءَ حِلْمِهِ","بتأخيرِ نزْعِ السَّهم يصدَعُ في الصَّخرِ",12,"ر",1,0],["فَلا تَأمَنِ الدُنيا إِذا هِيَ أَقبَلَت","عَلَيكَ فَما زالَت تَخونُ وَتُدبِرُ",13,"ر",1,0],["فَلا تَأْمَنْ عَلَى نَجْوَاكَ صَدْرَاً","فَرُبَّ خَدِيعَةٍ تَحْتَ الأَمَانِ",14,"ن",1,0],["فلا تأخذْ دمشقَ لهل بديلاً","أغيظاً ذاكَ منكَ أمِ انتقاما",15,"م",2,0],["فَلا تَأمَنوا المَرءَ التَقِيَّ عَلى الَّتي","تَسوءُ وَإِن زارَ المَساجِدَ أَو حَجّا",16,"ج",2,0],["فَلا تَأكُلَن ما أَخرَجَ الماءُ ظالِماً","وَلا تَبغِ قوتاً مِن غَريضِ الذَبائِحِ",17,"ح",1,0],["فَلا تَأمَنَن إِن وَفَدَ الحِمامِ","غادٍ عَلى موَجِ القَومِ سارِ",18,"ر",1,0],["فَلا تَأمَل مِنَ الدُنِّيا صَلاحاً","فَذاكَ هُوَ الَّذي لا يُستَطاعُ",19,"ع",1,0],["فَلا تَأمَنوا شامِيَّةً يَمَنِيَّةً","تُعادي فَلا تُبقي خِباءً وَلا فِرقا",20,"ق",2,0],["فَلا تَأسَفَنَّ عَلى مَطلَبٍ","يَفوتُ إِذا بابُهُ أُغلِقا",21,"ق",2,0],["فَلا تَأمُلِ الأَيّامَ لِلخَيرِ مَرَّةً","فَلَيسَت لِخَيرٍ أَن يُظَنَّ بِها أَهلا",22,"ل",2,0],["فَلا تَأسَفَنَّ الشاَةُ إِن أُدنِيَ اِبنُها","لِشَفرَةِ عاتٍ لِلرِجالِ ظَلومِ",23,"م",1,0],["فَلا تَأمَنوا الشَرَّ مِن صاحِبٍ","وَإِن كانَ خالاً لَكُم وَاِبنَ عَم",24,"م",1,0],["فَلا تَأخُذ وَدائِعَ ذاتِ ريشٍ","فَما لَكَ أَيُّها الإِنسانُ بِضنَه",25,"ن",2,0],["فَلا تَأْمَنْ عَلَى سِرٍّ حَبِيباً","فَقَدْ يَأْتِي الْعَدُوُّ مِنَ الْحَبِيبِ",26,"ب",1,0],["فَلا تَأْمَنْ عَلَى سِرٍّ صِحاباً","فَإِنَّهُمُ جَواسِيسُ الْعُيُوبِ",27,"ب",1,0],["فلا تأمَنوا جانب الأقوياءِ","فكم وضَعُوا سُمَّهْم في الدَّسَمْ!",28,"م",1,0],["فلا تأتِ ساحةَ هذي الذئابِ","تُنازِلُها بفمٍ أدرد",29,"د",1,0],["فلا تأكل على ودي وبنانا","ولا تفزع على ما فات نابا",30,"ب",2,0],["فلا تأسَوا على ما فاتَ وادعوا","إلهاً إنه بكمُ رحيمُ",31,"م",1,0],["فَلاَ تَأمَنِ الدَّهرَ في صَرفِهِ","فَلَم يَامنِ الشَّاءُ سِيدَ الغَضَا",32,"ض",2,0],["فَلا تَأمَنِ الرومَ المُظَفَّرَ إِنَّهُ","وَحِيُّ الرَدى إِن هَمَّ وَالغَيثُ إِن هَما",33,"م",2,0],["فلا تأمنن من سخطه أن ترى الرضى","ولا تيأسن من قربه إن يجانب",34,"ب",1,0],["فلا تأسف على ما فات وانهض","بجد منك تدرك ما افتا",35,"ت",2,0],["فلا تاس إن ضنّت عليك بنيلها","لأن الأذى والموت من أدواتها",36,"ت",3,0],["فَلا تَأمَنَنَّ بِالعاذِ وَالخُلفِ بَعدَها","جِوارَ أُناسٍ يَبتَنونَ الحَضائِرا",37,"ر",2,1],["فَلاَ تَأْخُذَنِّي بِقَوْلِ الْعِدَى","وَإِنْ أَكْثَرُوا فِيَّ زُورَ الْكَلاَمْ",38,"م",1,0],["فَلا تَأمَن خَليلك أَن يَخونا","بَنو الأَيّام أَكثرهم خؤونٌ",39,"ن",1,0],["فَلا تَأَمنَنَّ الدَهر يَوماً وَإِن صَفا","فَكُلّ زَمان للكَريم خَصيمُ",40,"م",1,0],["فَلا تَأَمَنونا إِنَّنا رَهَطُ جُندُبٍ","وَصاحِبُ هَمّامٍ بِذاتِ الأَسارِعِ",41,"ع",1,1],["فَلا تَأخُذ إِذا عَربَدتُ يَوماً","عَلَيكَ إِذا جَنَيت عَلَيَّ سَكري",42,"ر",2,0],["فلا تأمنن من قال إنيَ ناطقٌ","وليس له فيه أمانٌ وإيمان",43,"ن",1,0],["فلا تأخذا إلا مقالته التي","تنادي إلى دار النعيم دواعيه",44,"ي",2,0],["فلا تأمن الأَشجان يجذبن قلبها","متى أَتْهَمَ البرقُ اليمانيّ وأنجدا",45,"د",2,0],["فلا تأمن الأَفعى وَإِن لان جلدها","ففي نابها سم وداء مُبرح",46,"ح",1,0],["فلا تاجَ إلا وهو في رُسْغ سابحٍ","ولا رأس إلا وهو في كفِّ قاطعِ",47,"ع",1,0],["فَلا تَأمنوا إنْ كنتُمُ قد أمِنتُمُ","سهامَ الأعادي من سهامِ المقادِرِ",48,"ر",1,0],["فَلا تَأمَنوا مَن نامَ عنكم ضرورةً","فمُقْعٍ إلى أن يُمكن الوثبَ واثبُ",49,"ب",1,0],["فلا تأمل صفاءً أو رفاءً","بلا علم صحيح للبنات",50,"ت",1,0],["فَلا تَأخُذَنَّكُم في الغُواةِ جَهرَةً","وَلَجوا فَعادَ القَرحَ يَنكَأُ بِالقَرحِ",51,"ح",1,0],["فلا تأمن فكَم خِلٍّ مُصِرٍّ","عَلى بُغضٍ يَكيدُ ولا يُكاد",52,"د",1,0],["فلا تأمنن إلى خصبها","أيا من رب الذكاء بخادع",53,"ع",1,0],["فلا تأمنن الدهر طيب لعابه","إليك فسم الأفعوان لعابه",54,"ب",2,0],["فَلا تَأسَفَنَّ عَلى ما مَضى","وَلا يَحزُنَنَّكَ ما يُدبِرُ",55,"ر",1,0],["فلا تأمنَنْ مكرَ العداة فإنهم","همُ الشر والداءُ الدفينُ المدَسَّسُ",56,"س",1,0],["فلا تأتِ حِبَّك في كل حين","وخفْ سخَط الحِبِّ معْ نقْمتِهْ",57,"ه",1,1],["فلا تأسفنَّ على ما مضى","فمن ذا يردّ القضا والقدر",58,"ر",1,0],["فَلا تَأمَن سُؤالَ اللَهِ عَنهُ","بِتَوبيخٍ عَلِمتَ فَهَل عَمِلتا",59,"ت",2,0],["فَلا تَأخُذ بِتَقصيري وَسَهوي","وَخُذ بِوَصِيَّتي لَكَ إِن رَشَدتا",59,"ت",2,0],["فَلا تَأمَنَنَّ خالِداً بَعدَ هَذِهِ","وَعُثمانُ جاءَ بِالدُهَيمِ المعَظَّلِ",60,"ل",1,0],["فلا تأمن على حال دعياً","فليس له على حالٍ وفاء",61,"ا",2,0],["فلا تأمن النفس الزكية علها","على كل من لم يدر ذلك تفخر",62,"ر",1,0],["فلا تاكل ذبائحهم جميعاً","ولا ما أولموه من الثريد",63,"د",1,0],["فَلا تَأمَنِ الضِدَّ الذي قَد وَتَرتَهُ","وَلَو أَنَّهُ أَبدى بَشاشَة باسِمِ",64,"م",1,0],["فلا تاخذِ الأقوالَ من كلِّ قائلِ","وإنْ كان لا يدري الذي قال من هزء",65,"ا",1,0],["فَلا تَأمَنوا أَن تَسمَعوها مَرنَةً","بِقَرعِ العَوالي وَالمُهَنَّدَةِ البُترِ",66,"ر",1,0],["فَلا تأمَننَّ بَياتَ المنونِ","وَكُن حَذِراً حدَّ أَظفارِها",67,"ر",3,0],["فَلا تَأسَي بِذاك عَلى سُقوطٍ","فَنَحنُ اليَوم في عَهد السُقوط",68,"ط",1,0],["فلا تأبَ تلك الكأسَ إن مذاقها","شفاءٌ وكم يشفيك ما أنتَ جاهله",69,"ل",2,0],["فلا تأمنوا يا قوم لين شراكه","فتلك مراميه عليها شواهدُ",70,"د",1,0],["فلا تأمل اليوم منهم صلاحا","فإن الصلاح عدو الهرم",71,"م",1,0],["فلا تأمل الدهر ان امَّلك","وبالسخط بعد الرضا انزلك",72,"ك",1,1],["فلا تأتين هجر الصديق تعمدا","ففي صرف هذا الدهر ما شئت من هجر",73,"ر",1,0],["فلا تأمنوه واركبوا القَصد تسلموا","وكفّوا عن التأنيب تنجوا من الجهل",74,"ل",1,0],["فلا تأسين منها على فائتٍ مضى","ولا تفرحن بما هو آتِ",75,"ت",1,0],["فَلا تابَ الإِلَهُ عَلى جَريرٍ","إِذا عَبدٌ مِنَ السوءاتِ تابا",76,"ب",2,0],["فلا تأكل مع أسدٍ","ولا تشرب مع الصلِّ",77,"ل",1,0],["فلا تأمَنوا أنْ تسمعوا صوتَ فتيةٍ","طِوالِ المَذاكي والقَنا والسّواعدِ",78,"د",1,0],["فَلا تَأسى عَلى ما فات منها","فَخير متاعِها ريٌّ وَقوت",79,"ت",1,0],["فَلا تأمن عواقبَها وَحاذر","فَما أَدنى السرورَ إِلى الكُروب",80,"ب",1,0],["فَلا تَأمَن الأولَى الَّتي قَد تَعَرقَت","فَقَارَك حتَّى عُدتَ ذَا شَيبَةٍ كَهلا",81,"ل",2,0],["فلا تأمن الأنثى وإن خلت عندها","وفاء وإخلاصاً به يضرب المثل",82,"ل",1,0],["فلا تأمننَّ العدوَّ الصغيرْ","وخفْ أن تكون له غائلهْ",83,"ه",1,1],["فَلا تَألَوَنَّ بِرُشدِكَ جَهدا","وَحُضَّ الفَوارِسَ فَرداً فَفردا",84,"د",2,0],["فَلا تَأمَنِ النَوكى وَإِن كانَ دارُهُم","وَراءَ عَدَولاتٍ وَكُنتَ بِقَيصَرا",85,"ر",2,1],["فلا تأمنن بطش الزمان فإنه","إذا لم يراوح بالمنون يبكر",86,"ر",1,0],["فَلاتَ اِقتِدارٌ وَلاتَ اِصطِبارٌ","وَلاتَ اِفتِرارٌ وَمَن يَنبِسُ",87,"س",1,0],["فَلا تأَمن أخا العرفان دهراً","لمرءٍ واتخذ نصحي نَذيرا",88,"ر",2,0],["فلا تأمننَّ الموت طرفة ناظر","ولا تقطع البيدا بغير تزودِ",89,"د",1,0],["فلا تأمن الدهر الخؤون صروفه","حذاراً وان يصفو لك الدهر رونقا",90,"ق",2,0],["فَلَا تَأذَنِي لِلدَّمعِ تَفرِيقَ بَينِنَا","فَقَد يَخرُجُ المُشتَاقُ بالدَّمعِ ثائِرَا",91,"ر",2,0],["فلا تأخذك للأهواء نفس","فمن يتبع هوى نفس أسير",92,"ر",1,0],["فلا تأسف عليه ودعك منه","إذا ما ظنَّ بالفعل القؤول",93,"ل",1,0],["فلا تأمنا مكْرَ الإلهِ بماكرٍ","إذا آنَ ميعادُ الحسابِ لدى غدِ",94,"د",1,0],["فَلاْ تَأْسَفْ عَلَىْ حُبٍّ مُضَاْعٍ","تَذَبْذَبَ بَيْنَ آَلاْفِ الْكِبَاْشِ",95,"ش",1,0],["فَلاْ تَأْبَهِيْº مَهْمَاْ يُقَاْلُº فَإِنَّنِيْ","عَنِ الْحُبِّ وَالْمَحْبُوْبِ لاْ أَتَزَحْزَحُ",96,"ح",1,0],["فلا تأخُذَنَّ به واكتشفْ","حقيقتَه واحذَرِ الغضبَا",97,"ب",2,0],["فلا تأْمَنَنَّ دهورَ زمانٍ","تعقّلْ فغيرُكَ جُنَّ وطاشا",98,"ش",2,0],["فلا تأمنْ لصاريةِ الْجواري","إذا دنياكَ أغْرتْها الرّعودُ",99,"د",1,0],["فَلَا تَأْسَفْ عَلَى شِيْءٍ تَوَلَّى","فَإِنَّ الْعُمْرَ أَوْلَى بِالْتِفَاتِ",100,"ت",1,0],["فلا تأمن المكر من كاشح","ولا تك بالخصم كالآبه",101,"ب",2,0],["فلا تأسي على من تاهَ عُمرا","يقلّبُ ليلهُ أرَقاً وضجرَا",102,"ر",2,0],["فلا تأبى فَدورُ المَوتِ ما صدَ