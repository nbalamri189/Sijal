iwan.net/poem12771.html","الكامل"],[441,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[445,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[445,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[447,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[456,"إني بريء منك يا بدني","https://www.aldiwan.net/poem61586.html","البسيط"],[461,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[464,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[464,"ولما أناخ الدهر كلكل بأسه","https://www.aldiwan.net/poem16369.html","الطويل"],[466,"نعم نعم حدثتني وهي صادقةٌ","https://www.aldiwan.net/poem930.html",""],[467,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[467,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[467,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[467,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[467,"تحدث البرق عن سعدي فما كذبا","https://www.aldiwan.net/poem3430.html","عموديه"],[467,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[467,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[503,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[517,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[517,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[547,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[554,"رم النجاء عن الفحشاء والهون","https://www.aldiwan.net/poem47160.html","البسيط"],[554,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[561,"مسكين يلمع له في الكون برق الحق","https://www.aldiwan.net/poem33510.html","المواليا"],[561,"لمن طلل بين الأجارع بالي","https://www.aldiwan.net/poem33537.html","الطويل"],[561,"لو يكون الحظ السعيد رفيقا","https://www.aldiwan.net/poem34423.html","الخفيف"],[561,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[562,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[565,"المال يفرق بين الأم والولد","https://www.aldiwan.net/poem52953.html","البسيط"],[565,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[570,"من تراه ينصفني من خليل","https://www.aldiwan.net/poem69533.html","الخفيف"],[570,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[570,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[576,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[694,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/117836","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22567","الكامل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"]],"verses":[["لَوَيتُ إِلى وُدِّ العَشيرَةِ جانِبي","عَلى عُظمِ داءٍ بَينَنا مُتَفاقِمِ",0,"م",1,0],["لَوِيَت عَنّي فَيا لِل","ناسِ هَل ضَنَّ الغَمامُ",1,"م",1,0],["لَو يُنصِفوني الهَوى ما كانَ عِندَهُمُ","بَدرُ القُلوبِ وَعِندي الشَوقُ وَالأَرَقُ",2,"ق",1,0],["لَوى عِطفَهُ لَيَّ القَنيِّ رِقابَهُم","وَلَو لِسِواهُ اِستَعطَفوا ما تَعَطَّفوا",3,"ف",3,0],["لَوى عَنّي الخُدودَ مِنَ الغَواني","وَقَطَّعَ دونِيَ الحَدَقَ المِراضا",4,"ض",2,0],["لَو يُفتَدى ذاكَ السَوادُ فَدَيتُهُ","بِسَوادِ عَيني بَل سَوادِ ضَمائِري",5,"ر",2,0],["لَوَى مُعاوِيَةُ ابْنُ الأَكْرَمِينَ أَبَاً","مِنْهُم إِلى المَجْدِ أَبْصاراً وَأَعْناقا",6,"ق",2,0],["لَوَيْتُ على الرُّمْحِ الرُدَيْنِيِّ مِعْصَما","وَزُرْتُ العِدا وَالحَرْبُ فاغِرَةٌ فَما",7,"م",2,1],["لوَيْتُ عنهُ هِناني وهْيَ تَجْمَحُ بي","والبيضُ مُرْتَعِداتٌ في غَواشيها",8,"ي",3,0],["لوَيْتُ عِناني والليالي تَنوشُني","إِلى أرْيَحيٍّ من ذُؤابَةِ عامِرِ",9,"ر",1,0],["لَو يَبيتُ الناسُ كُلُّهُمُ","بِسُهادي بَيَّضَ الحَدَقا",10,"ق",2,0],["لَو يَقسِمُ اللَهُ جُزءاً مِن مَحاسِنِها","في الناسِ طُرّاً لَتَمَّ الحُسنُ في الناسِ",11,"س",1,0],["لَو يَذوقُ المَوتَ أَشجى ال","ناسَ بِالحُبِّ لَذُقتُه",12,"ت",2,0],["لَوى وعْدَهُ لمّا طمِعْتَ بوصْلِهِ","وكمْ موْعِدٍ منْ قبْلِ ذلِكَ قد لَوَى",13,"و",2,0],["لَو يَعلَمُ الأَحياءُ عِلمِي فيهُم","حَقّاً لصَدّقَني الَّذينَ أُمارِي",14,"ر",2,0],["لَو يَنظِمونَ اللَآلي مِثلَ ما نُظِمَت","مُذ غِبتَ عَنّا عُيونُ الفَضلِ وَالأَدَبِ",15,"ب",1,1],["لَو يُخَلّى القَطا لَنامَ وَلَو خُلّ","يتُ لَم أَرمِ عَن وِجاري وَجاري",16,"ر",2,0],["لَو يَفاعُ المَجَرَّةِ اِعتَضَت مِنهُ","راحَ يَدعو ثُبورَهُ المُستَعيضُ",17,"ض",1,0],["لو يَسمَعونَ كَما سَمِعتُ كَلامَها","خَرُّوا لِعَزَّةَ رُكَّعًا وَسُجودا",18,"د",2,0],["لَوى ظِمئَها تَحتَ حَرِّ النُّجوم","يَحبِسُها كَسَلاً أَو عَباثا",19,"ث",2,0],["لو يعقل الإنسان لم يأبه لما","تجرى به سنن النظام القاهر",20,"ر",1,0],["لَوْ يَغْتَدِينَ مُوَشَّبَاتٍ زينَةً","عُجْباً تَدُرُّ القُوْتَ لِلْغَرْثَانِ",21,"ن",1,0],["لَو يَعلَمُ المَغرورُ ماذا حازَ مِن","خِزيٍ لِوالِدِهِ إِذَن لَم يَعبَثِ",22,"ث",1,0],["لَو يَستَطِعنَ إِذا نابَتكَ نائِبَةٌ","وَقَينَكَ المَوتَ بِالآباءِ وَالوَلدَِ",23,"د",1,0],["لو يذوق من ذا الشريبا","الخطيب توريه معان",24,"ن",1,0],["لو يجعل الناس التعاون دأبهم","لتمتّعوا بسعادة العمران",25,"ن",1,0],["لَو يَسمَعونَ بِأَكلَةٍ أَو شَربَةٍ","بِعُمانَ أَصبَحَ جَمعُهُم بِعُمانِ",26,"ن",1,0],["لَو يَقدُرونَ بِغَيرِ ما أَبلَيتَهُم","لَسُقيتَ سَمَّ أَراقِمٍ وَأَساوِدِ",27,"د",1,0],["لَو يَقدِرونَ بِغَيرِ ما أَبلَيتُهُم","لَسُقيتُ كَأسَ مُقَشَّبٍ مَسمومِ",28,"م",1,0],["لَو يَقومُ الفيلُ أَو فَيّالُهُ","زَلَّ عَن مِثلِ مَقامي وَزَحَل",29,"ل",1,0],["لو ينال الكبير في حرفة البي","ع وصرف الأموال بالأموالِ",30,"ل",1,0],["لَو يَدِبُّ الحَولِيُّ مِن وَلَدِ الذَر","رِ عَلَيها لَأَندَبَتها الكُلومُ",31,"م",1,0],["لَو يَنطِقُ التَيسُ ذو الخُصَينِ وَسطَهُمُ","لَكانَ ذا شَرَفٍ فيهِم وَذا شانِ",32,"ن",1,0],["لَو يَرُدُّ الدَمعُ شَيئاً لَقَد","رَدَّ شَيئاً دَمعُكَ الساكِبُ",33,"ب",1,0],["لو يعلم الترك أهلوه بأنيَ قد","شبَّهته البدر ما أبقوا ولا تركوا",34,"ك",3,0],["لوى صدغه كالنون من فوق وجنةٍ","تسعّر ناراً في حشى كلّ مفتون",35,"ن",1,1],["لو يصحُّ اليقينُ ما رَغِبَ الرا","غبُ إلّا إلى مَليكِ السماءِ",36,"ا",2,0],["لو يُناغِي بَيانُها العُجْمَ يوماً","عرَّبَ العُجمَ أيَّما تعريبِ",37,"ب",1,0],["لو يُلمُّ الذي ألمَّ بِرُكني","منه بالشاهقاتِ أضحت كثيبا",38,"ب",2,0],["لو يُحِسُّ السِّنانُ ثِقْلاً من اليعْ","سُوب وافاهُ قَعْبُهُ المقْشُوبُ",39,"ب",1,0],["لو يجمعِ اللهُ اللِّحى","كانت حُدَافَة لحيتِهْ",40,"ه",1,0],["لو يخطِبُ الشمسَ لم ترغب ببهجتها","عن خير من خطب الأزواجَ أو نكحا",41,"ح",2,0],["لو يعلم الأعداء أين تُحِلّني","لَعَدَوَا بأظفارٍ عَلَيَّ حدادِ",42,"د",1,1],["لو يعلم القبر من أتيح له","لا نحفر القبر غير محتَفرِ",43,"ر",1,0],["لو يدومُ الشبابُ مدَّةَ عمري","لم تَدُمْ لي بشاشةُ الأوطارِ",44,"ر",1,1],["لو يشاء انْتحى هناك على كُلْ","ل مُسيئٍ بمنسمٍ رضَّاض",45,"ض",1,0],["لو يستطعن أكلنه","من شهوة ورشفنه",46,"ن",2,0],["لو يُسمَّى بنصفِ كنيتِهِ الأعْ","لى ونِصفِ اسمهِ أصابَ المُسمِّي",47,"م",2,0],["لو يُداوِي نفسَهُ من عِلَّةٍ","لَتَدَاعي بالتَّلاشي والتفاني",48,"ن",2,0],["لو يُجارَى سُكَيْتُ شأوِك أعيا","كلَّ طِرف وفات كل عِنانِ",49,"ن",1,0],["لو يُراعي الرُّسْلَ منكم عاشق","نفسُه عندكُمُ مُرتهَنه",50,"ن",2,0],["لو يئستُ من العُتبَى وفِتنتها","لما حَفِلتُ أطارَ الحظُّ أم وكَنا",51,"ن",2,0],["لو يستطِعن من الإشفاق إذ بَرزتْ","للمشي أَوْطأنَها منهنَّ أجفانا",52,"ن",2,0],["لو يعلمُ ابنُ أبي سُميَّه","كم من شجاع يتقيهِ",53,"ي",2,1],["لَوى رَأسَهُ عَنّي وَمالَ بِوُدِّهِ","أَغانيجُ خَودٍ كانَ قِدماً يَزورُها",54,"ر",3,0],["لَو يَشا طارَ بِهِ ذو مَيَعَةٍ","لاحِقُ الآطالِ نَهدٌ ذو خُصَل",55,"ل",1,0],["لَو يَيسِرونَ بِخَيلٍ قَد يَسَرتُ بِها","وَكُلُّ ما يَسرَ الأَقوامُ مَغرومُ",56,"م",1,0],["لَو يَعقِلُ القَدَرُ الخَأونُ عَزَلتُهُ","وَعَذَلتُهُ لَكِنَّهُ لا يَعقِلُ",57,"ل",1,0],["لَو يُسَمّى السَيفُ ثانِيَةً","باتَ يُدعى مِنقِذَ الأُمَمِ",58,"م",1,0],["لَو يَبعُدُ البُعدُ عَن حَبيبي","ما عَنَّ يَوماً لِمُستَهامِ",59,"م",1,0],["لوَيِنَ النُّحورَ على ذِلَّةٍ","ومُتْنَ وأَحْلامَهُنَّ العِذابْ",60,"ب",1,0],["لو يكون الغِنَى كما قد زعمتم","كانت الكيمياء لا تستحيل",61,"ل",1,0],["لو يجازي المحب عن فرط شوق","لجزيت الكثير عن أشواقي",62,"ق",2,0],["لَو يَطعمُ الطِبُّ الصَناعُ بَيانَهُ","أَو لَو يُسيغُ لِما يَقولُ مَذاقا",63,"ق",2,0],["لَو يَعلَمونَ عَظيمَ ما تُرجى لَهُ","خَرَجَ الشَحيحُ لَها مِنَ الدينارِ",64,"ر",1,0],["لَو يُدفَعُ المَوتُ رَدَّت عَنكَ عادِيَهُ","لِلعِلمِ حَولَكَ عَينٌ لَم تَنَم وَيَدُ",65,"د",1,0],["لَو يُرى اللَهُ بِمِصباحٍ لَما","كانَ إِلّا العِلمَ جَلَّ اللَهُ شانا",66,"ن",2,0],["لَو يُجازى المُحِبُّ عَن فَرطِ شَوقٍ","لَجُزيتُ الكَثيرَ عَن أَشواقِ",67,"ق",1,0],["لَو يُرجَعُ الدَهرُ مَفقوداً لَهُ خَطَرٌ","لَآبَ بِالواحِدِ المَبكِيِّ ثَكلانُ",68,"ن",1,0],["لَو يَفطُنُ المَوتى لَها","سَرَحوا الأَنامِلَ يَنبِشون",69,"ن",1,0],["لَوى نَحرٌ بِها وَاِلتَفَّ بَحرُ","كَما مَلَكَت جِهاتِ الدَوحِ غُدرُ",70,"ر",1,0],["لَو يَعلَمونَ السوقَ ما حَسَناتُها","بيعَ الحَصى في السوقِ بَيعَ الجَوهَرِ",71,"ر",1,0],["لَوَيتُهُ دُملُجاً عَلى عَضُدٍ","لِدَولَةٍ رُكنُها لَهُ والِد",72,"د",1,0],["لَو يَكونُ الَّذي وَرَدتَ مِنَ الفَج","عَةِ طَعناً أَورَدتَهُ الخَيلَ قُبلا",73,"ل",2,0],["لوى دَينهم أيدي النوائب فاقتضوا","بأيدي المهارَى تنفخُ النجحَ والدَّمَا",74,"م",2,0],["لوينَ طويلاً ثم لما اقتضيتُها","أحلْنَ على من يخدعُ الجِدَّ بالهزلِ",75,"ل",1,0],["لَوى عُنُقَ السَيلِ الَّذي اِنحَطَّ مُجلِباً","لِيَصدَعَ كَهفاً في لُؤَيِّ بنِ غالِبِ",76,"ب",1,0],["لَو يوقَدُ المِصباحُ مِنهُ لَسامَحَت","بِضِيائِهِ شِيَةٌ كَضَوءِ الكَوكَبِ",77,"ب",1,0],["لَو يَكرَعُ الظَمآنُ فيهِ لَم يُمِل","طَرفاً إِلى عَذبِ الزُلالِ السائِحِ",78,"ح",1,0],["لَو يُكَلَّفنَ بِالخُلودِ لَقَد كا","نَ قَميناً بِبَعضِهِنَّ الخُلودُ",79,"د",1,0],["لَو يَستَطيعُ وَقاكَ عادِيَةَ الضَنى","أَو تَستَطيعُ وَقَيتَهُ صَرفَ الرَدى",80,"د",2,0],["لَو يَنجَلي لَكَ ذُخرُها مِن نَكبَةٍ","جَلَلٍ لَأَضحَكَكَ الَّذي يُبكيكا",81,"ك",2,0],["لَو يَملِكونَ الضَوءَ بُخ","لاً لَم يَكُن لِلخَلقِ ضَو",82,"و",1,0],["لَوى اِبنُ أَبي الرَقراقِ عَينَيهِ بَعدَما","دَنا مِن أَعالي إيلِياءَ وَغَوَّرا",83,"ر",2,1],["لَو يُبتَلونَ بِغَيرِ سِجنِهِمِ","صَبَروا وَلَو حُبِسوا عَلى الجَمرِ",84,"ر",1,0],["لَو يَعلَموا حَسَبَ المُنيخِ إِلَيهِمُ","وَعَلى بُيوتِهِمُ الطَريقُ اللَهجَمُ",85,"م",1,0],["لَوى كُلُّ مُشتاقٍ مِنَ القَومِ رَأسَهُ","بِمُغرَورِقاتٍ كَالشِنانِ الهَزائِمِ",86,"م",1,0],["لَوْ يَعْلَمُ الرُّكْنُ مَنْ قَدْ جَاءَ يَلْثِمُهُ","لَخَرَّ يَلْثِمُ مِنْهُ مَا وَطَي‌ القَدَمُ",87,"م",1,0],["لوى عُنُقي عنها المَشيبُ وقد أَرى","جَنيبَ الصَّبا فيها أخُبُّ وأُعنِقُ",88,"ق",1,0],["لَو يوزَنونَ عِياراً أَو مُكايَلَةً","مالوا بِرَضوى وَلَم يَعدِلُهُم أُحُدُ",89,"د",1,0],["لَو يَستَطيعُ الناسُ مِن إِجلالِهِ","لَحَذَوا لَهُ حُرَّ الحُجوهِ نِعالا",90,"ل",2,0],["لَو يُرَدُّ الرَدى بِبَذلِ الأَيادي","أَبقَتِ المَكرُماتُ كَعبَ الإِيادي",91,"د",2,1],["لَو يُرَدُّ الرَدى بِقوَّةِ بَأسٍ","لَوَقَيناكَ في الأُمورِ الصِعابِ",92,"ب",1,0],["لَو يَشا أَسَّسَ المَنازِلَ مِن فَو","قِ أَعالي مَنازِلَ الزَبرِقانِ",93,"ن",1,0],["لَو يَنطِقُ العيدُ بِالإِنصافِ قالَ لَنا","لِيَهنِكُم بِالمَليكِ الصالِحِ الظَفَرُ",94,"ر",1,0],["لَو يَكتَبُ اِسمُكَ بِالصَوارِمِ وَالقَنا","أَغنى عَنِ التَضرابِ وَالتَطعانِ",95,"ن",1,0],["لو يستطيعُ مشَى لك الفضلُ الذي","قضيت عمركَ في ارتيادِ شرابِهِ",96,"ب",2,0],["لو يفهم النجم ما نقول","أو يفهم الليل ما نُسر",97,"ر",1,0],["لوينَ الحواجبَ نَزْعَ القسيّ","وأرسلنَ عَنهُنّ نَبْلَ الحَدَقْ",98,"ق",1,0],["لَو يَقدِرُ المِسكينُ مِمّا بِهِ","لَاِستَدخَلَ الفيشَةَ بِالعَرضِ",99,"ض",1,0],["لَو يَعلَمُ الناسُ عِلمي بِالزَمانِ وَما","عاثَت يَداهُ لَما رَبّوا وَلا وَلَدوا",100,"د",3,0],["لَو يَقدِرونَ مَشَوا عَلى وَجَناتِهِم","وَعُيونِهِم فَضلاً عَنِ الأَقدامِ",101,"م",1,0],["لَو يَعلَمُ العافونَ كَم لَكَ في النَدى","مِن لَذَّةٍ وَقَريحَةٍ لَم تُحمَدِ",102,"د",1,0],["لَو يُفاجا رُكنُ النَسيبِ كَثيرٌ","بِمَعانيهِ خالَهُنَّ نَسيبا",103,"ب",2,0],["لَو يَعلَمُ الكُفرُ كَم مِن أَعصُرٍ كَمَنَت","لَهُ العَواقِبُ بَينَ السُمرِ وَالقُضُبِ",104,"ب",1,0],["لو يفطنُ العاتي الظلومُ لحالِهِ","لبكى عليها فهْيَ بئسَ الحالُ",105,"ل",1,1],["لو يُدفَعُ المقدورُ عنكَ دفعتُهُ","جهدي ولكنَّ القضا لا يُدفعُ",106,"ع",1,0],["لَو يُبصِرُ الثَقفُ البَصيرُ جَبينَها","وَصَفاءَ خَدَّيها العَتيقَ لَحارا",107,"ر",2,0],["لَو يَرى الناسُ ما أَرى حينَ أَودى","لَشَرعتُ الصِيامَ يَومَ وَفاتِهْ",108,"ت",2,0],["لَوى الشَكائِمَ وَاِستَشرى لِغايَتِهِ","لا بِالذَلولِ وَلا بِالرَيِّثِ الواني",109,"ن",2,0],["لَو يَبغِيانِ بِها القَرارَ لَصادقا","في غَفلَةِ الحُرّاسِ مِنها ماحِيا",110,"ي",2,0],["لَو يَسمَعُ المَوتى الهُمودُ مَقالَتي","أَسدوا إِلى الأَوطانِ ما يُغنيها",111,"ي",3,0],["لو يعقِلُ الملكُ الغَبيُّ لمَا رأى","رَأْيَ الأُلى ضلّوا السّبيلَ ولا غَوَى",112,"غ",3,0],["لو يَستطيعُ لَمدَّ من أهدابِهِ","سَبباً يُشَدُّ به إليهِ ويُجذَبُ",113,"ب",1,0],["لو يريدُ الأذى بها لم تُطِقْها","مَن يعافُ الأذى ويأبَى العُراما",114,"م",2,0],["لَو يُنادى أَينَ الجَوادُ بِحَقٍّ","قالَ كُلٌّ إِلى الوَزيرِ يُشارُ",115,"ر",1,0],["لَو يَدُبُّ الحَوليُّ مِن وَلَدِ","الذّرِّ عَلَيها لأَندَبَتها الكُلومُ",116,"م",1,1],["لَوى صُدغَهُ كَالنونِ مِن تَحتِ طُرَّةٍ","مُمَسَّكَةٍ تُزهى بِعاجِ جَبينِ",117,"ن",1,0],["لو يَمسُّ النُّضَارَ هُونٌ مِنَ النا","رِ لما اختيرَ للنُّضَارِ الصِّلاءُ",118,"ا",2,0],["لو يَسْتَقِيمُ عليها السالكون بها","كما أمرتَ مشَتْ مَشْيَ المهَا الحُمرُ",119,"ر",1,0],["لَو يَصْدُقُونَ لَمَا أتَت رُسُلٌ لهُمْ","أتَرَى الطَّبِيبَ غَدَا يَزورُ عَلِيلا",120,"ل",2,0],["لَو يُسْتَطاعُ لهُ مِثْلٌ لَجِيء بِهِ","والمُسْتطاعُ مِنَ الأَعمالِ مَفْعُولُ",121,"ل",1,0],["لوْ يَقِرنُ اللّهُ البِلادَ بمِثْلِها","ضاقَتْ بعَزمِكَ والصَّبيرِ الدّاني",122,"ن",2,0],["لو يستطيع هَدى الرّكابَ لقَصْدها","وأنارَ ليلَ الرَّكبِ ضوءُ جبينه",123,"ن",2,0],["لو يَلتَقي الطّوفانُ قبلُ وَجوُدُه","لم يُنْجِ نُوحاً فُلْكُهُ المشْحون",124,"ن",1,0],["لو يستطيعُ البَحْرُ لاستَعدَى على","جَدْوَى يَدَيكَ وإنّهُ لَقَمِين",124,"ن",1,0],["لو يَدَّعِيهِ غيرُ حيٍّ ناطِقٍ","لَغَدَتْ أسودُ الغَابِ فيه تجادل",125,"ل",1,0],["لو يَستطيعُ الليلُ لاستعدى على","مَسراكَ تحتَ قِناعِهِ الحُلكوك",126,"ك",1,0],["لو يَرُدُّ الحزْنُ مَيْتاً هالِكاً","رُدَّ قحطانُ وَأُدُّ بنُ أُدَد",127,"د",1,0],["لو يُعْرَضُونَ على الدُّجُنّة أنكرَتْ","ذاكَ الشحوبَ النُّكْرَ والتلويحا",128,"ح",2,0],["لَو يَطيرُ الفَتى 