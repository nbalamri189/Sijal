كوني خادماً لهمُ","كانوا همُ الرجل إجلالاً وكنتُ حِذا",254,"ذ",2,0],["لو يستطيع وقد ركبت مسلماً","ماعُدتَ إلا والنجوم نثاره",255,"ر",2,0],["لو يستطيع البدرُ جادَك عائداً","واليمَّ أمك بالسماحة مُذعنا",256,"ن",2,0],["لو يباريك عدَّ في المجد والسؤ","دد أهل القصور أهل القصور",257,"ر",1,0],["لو يسير الطيف في أثنائهِ","وهو لطيفُ أو النجمُ لتاها",258,"ا",3,0],["لو ينقلُ البرقُ طرفاً دونها لهوى","أو يعمل النجم طرفاً نحوها لكبا",259,"ا",1,0],["لو يعلم الناس ما الأقدار ما حزنتْ","أمُّ الجبان ولم يفرح أخو البطلِ",260,"ل",1,0],["لو يبلُّ الجوى بكاءٌ طويلٌ","لبكينا تلك الليالي القصارا",261,"ر",2,0],["لو يَسْمحُ الدهرُ بِشمِّ تُربِهم","وإنَّني أظُنُّهُ لم يَسْمحِ",262,"ح",1,0],["لو يعلمُ الكوفي بها لم يزدَري","أو يشعرُ الطائي بها لم يشعرِ",263,"ر",1,0],["لو يُقسمُ الدّاعي بهم يوماً على","صُمّ الجِبالِ لأقبلَتْ تتخزلَجُ",264,"ج",1,0],["لو يكبر الناس في حبري وفي قلمي","ضاعفت أعمارهم بالجمع والضرب",265,"ب",1,0],["لَو يَستَطيع حَماني كلَّ بائقَةٍ","وباعد السّودَ في رأسي عن الجُونِ",266,"ن",1,0],["لَو يَستَطيعُ الّذي يهوى البقاءَ له","فداءَه بالّتِي في جنبِه لفدى",267,"د",2,0],["لو يعرف الباب ما شيء عليه شق","هو الفنا في الوجود المنكشف مشتق",268,"ق",1,0],["لويت عنان الشوق نحو رسومه","فصادفته قفر الجوانب خالي",269,"ل",2,0],["لو يكون الحظ السعيد رفيقاً","قمت من سكر غفلتي مستفيقاً",270,"ا",1,1],["لو يحوزون ذرة من صواب","تركونا وهذه الآيات",271,"ت",1,0],["لَوْ يَبْدو لِلنَّاس ما بَدا لي","قالوا ألاَ إِن ذا عَظيمُ",272,"م",1,0],["لو يجمَعُ اللهُ ما في الأرض قاطبةً","عندَ امرئٍ لم يَقُلْ حَسْبي فلا تَزِدِ",273,"د",1,0],["لَو يفيدُ البُكاءُ وَالنَّوحُ شَيئاً","لَأَقامَتْ خَنساءُ قَبلَكَ صَخرا",274,"ر",2,0],["لَوْ يَرَى مَوَدَّتَهُ فِي الضَّمِيْرِ","لَمْ يَزَلْ يُقَابِلُنِي بِالجَمِيْلِ",275,"ل",1,0],["لو يُبَاريَ سَحْبَانَ في مُحْكَمِ القوْ","لِ لأمْسَى سَحْبَانُ غَيْرَ سَدِيْدِ",276,"د",1,0],["لو يَسْتَطِيعُ لِخِلَّةٍ","فِيهِ بإسْعَافِي شَحِيحَهْ",277,"ح",2,0],["لَو يَستَطيعُ لَجاءَ مُقتَبِساً لَها","مِن أُفقِهِ وَإِذا لَصادَفَ مَقبِسا",278,"س",2,0],["لَو يَعلَموا خُلَّتَي صِدقٍ فَيَستَبِقا","إِلّا اِنتَمَينا إِلى عُلياهُما سَبَبا",279,"ب",2,0],["لو يُذبَحُ الضَّبيُّ بالسيفِ لم تجد","من اللؤمِ للضبيّ لحماً ولا دَما",280,"م",2,1],["لو يعلمُ الغرماءُ منزلتَيهِما","ما حلّفوني بالطلاقِ العاجلِ",281,"ل",1,1],["لَوَيتُ لَهُم في الصَدرِ مِنّي نَصيحَةً","وَوُدّاً كَما تُلوى اليَدانِ إِلى النَحرِ",282,"ر",1,0]]}