ون المِراضِ","https://www.poetsgate.com/ViewPoem.aspx?id=29407",""],[51,"شمسٌ مكوَّنة ٌ في خَلْق جارية ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30757",""],[51,"لو يدومُ الشبابُ مُدَّة َ عمري","https://www.poetsgate.com/ViewPoem.aspx?id=29139",""],[51,"رجلٌ عليه لحية ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=27144",""],[85,"وعصابة ٍ بالخيرِ ألِّف شملهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9666&r=&rc=156",""],[96,"عاشق الزّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66349&r=&rc=25",""]],"verses":[["لَوَيتُ إِلى وُدِّ العَشيرَةِ جانِبي","عَلى عُظمِ داءٍ بَينَنا مُتَفاقِمِ",0,"م",1,0],["لَوِيَت عَنّي فَيا لِل","ناسِ هَل ضَنَّ الغَمامُ",1,"م",1,0],["لَو يُنصِفوني الهَوى ما كانَ عِندَهُمُ","بَدرُ القُلوبِ وَعِندي الشَوقُ وَالأَرَقُ",2,"ق",1,0],["لَوى عِطفَهُ لَيَّ القَنيِّ رِقابَهُم","وَلَو لِسِواهُ اِستَعطَفوا ما تَعَطَّفوا",3,"ف",3,0],["لَوى عَنّي الخُدودَ مِنَ الغَواني","وَقَطَّعَ دونِيَ الحَدَقَ المِراضا",4,"ض",2,0],["لَو يُفتَدى ذاكَ السَوادُ فَدَيتُهُ","بِسَوادِ عَيني بَل سَوادِ ضَمائِري",5,"ر",2,0],["لَوَى مُعاوِيَةُ ابْنُ الأَكْرَمِينَ أَبَاً","مِنْهُم إِلى المَجْدِ أَبْصاراً وَأَعْناقا",6,"ق",2,0],["لَوَيْتُ على الرُّمْحِ الرُدَيْنِيِّ مِعْصَما","وَزُرْتُ العِدا وَالحَرْبُ فاغِرَةٌ فَما",7,"م",2,1],["لوَيْتُ عنهُ هِناني وهْيَ تَجْمَحُ بي","والبيضُ مُرْتَعِداتٌ في غَواشيها",8,"ي",3,0],["لوَيْتُ عِناني والليالي تَنوشُني","إِلى أرْيَحيٍّ من ذُؤابَةِ عامِرِ",9,"ر",1,0],["لَو يَبيتُ الناسُ كُلُّهُمُ","بِسُهادي بَيَّضَ الحَدَقا",10,"ق",2,0],["لَو يَقسِمُ اللَهُ جُزءاً مِن مَحاسِنِها","في الناسِ طُرّاً لَتَمَّ الحُسنُ في الناسِ",11,"س",1,0],["لَو يَذوقُ المَوتَ أَشجى ال","ناسَ بِالحُبِّ لَذُقتُه",12,"ت",2,0],["لَوى وعْدَهُ لمّا طمِعْتَ بوصْلِهِ","وكمْ موْعِدٍ منْ قبْلِ ذلِكَ قد لَوَى",13,"و",2,0],["لَو يَعلَمُ الأَحياءُ عِلمِي فيهُم","حَقّاً لصَدّقَني الَّذينَ أُمارِي",14,"ر",2,0],["لَو يَنظِمونَ اللَآلي مِثلَ ما نُظِمَت","مُذ غِبتَ عَنّا عُيونُ الفَضلِ وَالأَدَبِ",15,"ب",1,1],["لَو يُخَلّى القَطا لَنامَ وَلَو خُلّ","يتُ لَم أَرمِ عَن وِجاري وَجاري",16,"ي",1,0],["لَو يَفاعُ المَجَرَّةِ اِعتَضَت مِنهُ","راحَ يَدعو ثُبورَهُ المُستَعيضُ",17,"ض",1,0],["لو يَسمَعونَ كَما سَمِعتُ كَلامَها","خَرُّوا لِعَزَّةَ رُكَّعًا وَسُجودا",18,"د",2,0],["لَوى ظِمئَها تَحتَ حَرِّ النُّجوم","يَحبِسُها كَسَلاً أَو عَباثا",19,"ث",2,0],["لو يعقل الإنسان لم يأبه لما","تجرى به سنن النظام القاهر",20,"ر",1,0],["لَوْ يَغْتَدِينَ مُوَشَّبَاتٍ زينَةً","عُجْباً تَدُرُّ القُوْتَ لِلْغَرْثَانِ",21,"ن",1,0],["لَو يَعلَمُ المَغرورُ ماذا حازَ مِن","خِزيٍ لِوالِدِهِ إِذَن لَم يَعبَثِ",22,"ث",1,0],["لَو يَستَطِعنَ إِذا نابَتكَ نائِبَةٌ","وَقَينَكَ المَوتَ بِالآباءِ وَالوَلدَِ",23,"د",1,0],["لو يذوق من ذا الشريبا","الخطيب توريه معان",24,"ن",1,0],["لو يجعل الناس التعاون دأبهم","لتمتّعوا بسعادة العمران",25,"ن",1,0],["لَو يَسمَعونَ بِأَكلَةٍ أَو شَربَةٍ","بِعُمانَ أَصبَحَ جَمعُهُم بِعُمانِ",26,"ن",1,0],["لَو يَقدُرونَ بِغَيرِ ما أَبلَيتَهُم","لَسُقيتَ سَمَّ أَراقِمٍ وَأَساوِدِ",27,"د",1,0],["لَو يَقدِرونَ بِغَيرِ ما أَبلَيتُهُم","لَسُقيتُ كَأسَ مُقَشَّبٍ مَسمومِ",28,"م",1,0],["لَو يَقومُ الفيلُ أَو فَيّالُهُ","زَلَّ عَن مِثلِ مَقامي وَزَحَل",29,"ل",1,0],["لو ينال الكبير في حرفة البي","ع وصرف الأموال بالأموالِ",30,"ل",1,0],["لَو يَدِبُّ الحَولِيُّ مِن وَلَدِ الذَر","رِ عَلَيها لَأَندَبَتها الكُلومُ",31,"م",1,0],["لَو يَنطِقُ التَيسُ ذو الخُصَينِ وَسطَهُمُ","لَكانَ ذا شَرَفٍ فيهِم وَذا شانِ",32,"ن",1,0],["لَو يَرُدُّ الدَمعُ شَيئاً لَقَد","رَدَّ شَيئاً دَمعُكَ الساكِبُ",33,"ب",1,0],["لو يعلم الترك أهلوه بأنيَ قد","شبَّهته البدر ما أبقوا ولا تركوا",34,"ك",3,0],["لوى صدغه كالنون من فوق وجنةٍ","تسعّر ناراً في حشى كلّ مفتون",35,"ن",1,1],["لو يصحُّ اليقينُ ما رَغِبَ الرا","غبُ إلّا إلى مَليكِ السماءِ",36,"ا",2,0],["لو يُناغِي بَيانُها العُجْمَ يوماً","عرَّبَ العُجمَ أيَّما تعريبِ",37,"ب",1,0],["لو يُلمُّ الذي ألمَّ بِرُكني","منه بالشاهقاتِ أضحت كثيبا",38,"ب",2,0],["لو يُحِسُّ السِّنانُ ثِقْلاً من اليعْ","سُوب وافاهُ قَعْبُهُ المقْشُوبُ",39,"ب",1,0],["لو يجمعِ اللهُ اللِّحى","كانت حُدَافَة لحيتِهْ",40,"ه",1,0],["لو يخطِبُ الشمسَ لم ترغب ببهجتها","عن خير من خطب الأزواجَ أو نكحا",41,"ح",2,0],["لو يعلم الأعداء أين تُحِلّني","لَعَدَوَا بأظفارٍ عَلَيَّ حدادِ",42,"د",1,1],["لو يعلم القبر من أتيح له","لا نحفر القبر غير محتَفرِ",43,"ر",1,0],["لو يدومُ الشبابُ مدَّةَ عمري","لم تَدُمْ لي بشاشةُ الأوطارِ",44,"ر",1,1],["لو يشاء انْتحى هناك على كُلْ","ل مُسيئٍ بمنسمٍ رضَّاض",45,"ض",1,0],["لو يستطعن أكلنه","من شهوة ورشفنه",46,"ن",2,0],["لو يُسمَّى بنصفِ كنيتِهِ الأعْ","لى ونِصفِ اسمهِ أصابَ المُسمِّي",47,"م",2,0],["لو يُداوِي نفسَهُ من عِلَّةٍ","لَتَدَاعي بالتَّلاشي والتفاني",48,"ن",2,0],["لو يُجارَى سُكَيْتُ شأوِك أعيا","كلَّ طِرف وفات كل عِنانِ",49,"ن",1,0],["لو يُراعي الرُّسْلَ منكم عاشق","نفسُه عندكُمُ مُرتهَنه",50,"ن",2,0],["لو يئستُ من العُتبَى وفِتنتها","لما حَفِلتُ أطارَ الحظُّ أم وكَنا",51,"ن",2,0],["لو يستطِعن من الإشفاق إذ بَرزتْ","للمشي أَوْطأنَها منهنَّ أجفانا",52,"ن",2,0],["لو يعلمُ ابنُ أبي سُميَّه","كم من شجاع يتقيهِ",53,"ي",2,1],["لَوى رَأسَهُ عَنّي وَمالَ بِوُدِّهِ","أَغانيجُ خَودٍ كانَ قِدماً يَزورُها",54,"ر",3,0],["لَو يَشا طارَ بِهِ ذو مَيَعَةٍ","لاحِقُ الآطالِ نَهدٌ ذو خُصَل",55,"ل",1,0],["لَو يَيسِرونَ بِخَيلٍ قَد يَسَرتُ بِها","وَكُلُّ ما يَسرَ الأَقوامُ مَغرومُ",56,"م",1,0],["لَو يَعقِلُ القَدَرُ الخَأونُ عَزَلتُهُ","وَعَذَلتُهُ لَكِنَّهُ لا يَعقِلُ",57,"ل",1,0],["لَو يُسَمّى السَيفُ ثانِيَةً","باتَ يُدعى مِنقِذَ الأُمَمِ",58,"م",1,0],["لَو يَبعُدُ البُعدُ عَن حَبيبي","ما عَنَّ يَوماً لِمُستَهامِ",59,"م",1,0],["لوَيِنَ النُّحورَ على ذِلَّةٍ","ومُتْنَ وأَحْلامَهُنَّ العِذابْ",60,"ب",1,0],["لو يكون الغِنَى كما قد زعمتم","كانت الكيمياء لا تستحيل",61,"ل",1,0],["لو يجازي المحب عن فرط شوق","لجزيت الكثير عن أشواقي",62,"ي",1,0],["لَو يَطعمُ الطِبُّ الصَناعُ بَيانَهُ","أَو لَو يُسيغُ لِما يَقولُ مَذاقا",63,"ق",2,0],["لَو يَعلَمونَ عَظيمَ ما تُرجى لَهُ","خَرَجَ الشَحيحُ لَها مِنَ الدينارِ",64,"ر",1,0],["لَو يُدفَعُ المَوتُ رَدَّت عَنكَ عادِيَهُ","لِلعِلمِ حَولَكَ عَينٌ لَم تَنَم وَيَدُ",65,"د",1,0],["لَو يُرى اللَهُ بِمِصباحٍ لَما","كانَ إِلّا العِلمَ جَلَّ اللَهُ شانا",66,"ن",2,0],["لَو يُجازى المُحِبُّ عَن فَرطِ شَوقٍ","لَجُزيتُ الكَثيرَ عَن أَشواقِ",67,"ق",1,0],["لَو يُرجَعُ الدَهرُ مَفقوداً لَهُ خَطَرٌ","لَآبَ بِالواحِدِ المَبكِيِّ ثَكلانُ",68,"ن",1,0],["لَو يَفطُنُ المَوتى لَها","سَرَحوا الأَنامِلَ يَنبِشون",69,"ن",1,0],["لَوى نَحرٌ بِها وَاِلتَفَّ بَحرُ","كَما مَلَكَت جِهاتِ الدَوحِ غُدرُ",70,"ر",1,0],["لَو يَعلَمونَ السوقَ ما حَسَناتُها","بيعَ الحَصى في السوقِ بَيعَ الجَوهَرِ",71,"ر",1,0],["لَوَيتُهُ دُملُجاً عَلى عَضُدٍ","لِدَولَةٍ رُكنُها لَهُ والِد",72,"د",1,0],["لَو يَكونُ الَّذي وَرَدتَ مِنَ الفَج","عَةِ طَعناً أَورَدتَهُ الخَيلَ قُبلا",73,"ل",2,0],["لوى دَينهم أيدي النوائب فاقتضوا","بأيدي المهارَى تنفخُ النجحَ والدَّمَا",74,"م",2,0],["لوينَ طويلاً ثم لما اقتضيتُها","أحلْنَ على من يخدعُ الجِدَّ بالهزلِ",75,"ل",1,0],["لَوى عُنُقَ السَيلِ الَّذي اِنحَطَّ مُجلِباً","لِيَصدَعَ كَهفاً في لُؤَيِّ بنِ غالِبِ",76,"ب",1,0],["لَو يوقَدُ المِصباحُ مِنهُ لَسامَحَت","بِضِيائِهِ شِيَةٌ كَضَوءِ الكَوكَبِ",77,"ب",1,0],["لَو يَكرَعُ الظَمآنُ فيهِ لَم يُمِل","طَرفاً إِلى عَذبِ الزُلالِ السائِحِ",78,"ح",1,0],["لَو يُكَلَّفنَ بِالخُلودِ لَقَد كا","نَ قَميناً بِبَعضِهِنَّ الخُلودُ",79,"د",1,0],["لَو يَستَطيعُ وَقاكَ عادِيَةَ الضَنى","أَو تَستَطيعُ وَقَيتَهُ صَرفَ الرَدى",80,"د",2,0],["لَو يَنجَلي لَكَ ذُخرُها مِن نَكبَةٍ","جَلَلٍ لَأَضحَكَكَ الَّذي يُبكيكا",81,"ك",2,0],["لَو يَملِكونَ الضَوءَ بُخ","لاً لَم يَكُن لِلخَلقِ ضَو",82,"و",1,0],["لَوى اِبنُ أَبي الرَقراقِ عَينَيهِ بَعدَما","دَنا مِن أَعالي إيلِياءَ وَغَوَّرا",83,"ر",2,1],["لَو يُبتَلونَ بِغَيرِ سِجنِهِمِ","صَبَروا وَلَو حُبِسوا عَلى الجَمرِ",84,"ر",1,0],["لَو يَعلَموا حَسَبَ المُنيخِ إِلَيهِمُ","وَعَلى بُيوتِهِمُ الطَريقُ اللَهجَمُ",85,"م",1,0],["لَوى كُلُّ مُشتاقٍ مِنَ القَومِ رَأسَهُ","بِمُغرَورِقاتٍ كَالشِنانِ الهَزائِمِ",86,"م",1,0],["لَوْ يَعْلَمُ الرُّكْنُ مَنْ قَدْ جَاءَ يَلْثِمُهُ","لَخَرَّ يَلْثِمُ مِنْهُ مَا وَطَي‌ القَدَمُ",87,"م",1,0],["لوى عُنُقي عنها المَشيبُ وقد أَرى","جَنيبَ الصَّبا فيها أخُبُّ وأُعنِقُ",88,"ق",1,0],["لَو يوزَنونَ عِياراً أَو مُكايَلَةً","مالوا بِرَضوى وَلَم يَعدِلُهُم أُحُدُ",89,"د",1,0],["لَو يَستَطيعُ الناسُ مِن إِجلالِهِ","لَحَذَوا لَهُ حُرَّ الحُجوهِ نِعالا",90,"ل",2,0],["لَو يُرَدُّ الرَدى بِبَذلِ الأَيادي","أَبقَتِ المَكرُماتُ كَعبَ الإِيادي",91,"د",2,1],["لَو يُرَدُّ الرَدى بِقوَّةِ بَأسٍ","لَوَقَيناكَ في الأُمورِ الصِعابِ",92,"ب",1,0],["لَو يَشا أَسَّسَ المَنازِلَ مِن فَو","قِ أَعالي مَنازِلَ الزَبرِقانِ",93,"ن",1,0],["لَو يَنطِقُ العيدُ بِالإِنصافِ قالَ لَنا","لِيَهنِكُم بِالمَليكِ الصالِحِ الظَفَرُ",94,"ر",1,0],["لَو يَكتَبُ اِسمُكَ بِالصَوارِمِ وَالقَنا","أَغنى عَنِ التَضرابِ وَالتَطعانِ",95,"ن",1,0],["لو يستطيعُ مشَى لك الفضلُ الذي","قضيت عمركَ في ارتيادِ شرابِهِ",96,"ب",2,0],["لو يفهم النجم ما نقول","أو يفهم الليل ما نُسر",97,"ر",1,0],["لوينَ الحواجبَ نَزْعَ القسيّ","وأرسلنَ عَنهُنّ نَبْلَ الحَدَقْ",98,"ق",1,0],["لَو يَقدِرُ المِسكينُ مِمّا بِهِ","لَاِستَدخَلَ الفيشَةَ بِالعَرضِ",99,"ض",1,0],["لَو يَعلَمُ الناسُ عِلمي بِالزَمانِ وَما","عاثَت يَداهُ لَما رَبّوا وَلا وَلَدوا",100,"د",3,0],["لَو يَقدِرونَ مَشَوا عَلى وَجَناتِهِم","وَعُيونِهِم فَضلاً عَنِ الأَقدامِ",101,"م",1,0],["لَو يَعلَمُ العافونَ كَم لَكَ في النَدى","مِن لَذَّةٍ وَقَريحَةٍ لَم تُحمَدِ",102,"د",1,0],["لَو يُفاجا رُكنُ النَسيبِ كَثيرٌ","بِمَعانيهِ خالَهُنَّ نَسيبا",103,"ب",2,0],["لَو يَعلَمُ الكُفرُ كَم مِن أَعصُرٍ كَمَنَت","لَهُ العَواقِبُ بَينَ السُمرِ وَالقُضُبِ",104,"ب",1,0],["لو يفطنُ العاتي الظلومُ لحالِهِ","لبكى عليها فهْيَ بئسَ الحالُ",105,"ل",1,1],["لو يُدفَعُ المقدورُ عنكَ دفعتُهُ","جهدي ولكنَّ القضا لا يُدفعُ",106,"ع",1,0],["لَو يُبصِرُ الثَقفُ البَصيرُ جَبينَها","وَصَفاءَ خَدَّيها العَتيقَ لَحارا",107,"ر",2,0],["لَو يَرى الناسُ ما أَرى حينَ أَودى","لَشَرعتُ الصِيامَ يَومَ وَفاتِهْ",108,"ت",2,0],["لَوى الشَكائِمَ وَاِستَشرى لِغايَتِهِ","لا بِالذَلولِ وَلا بِالرَيِّثِ الواني",109,"ن",2,0],["لَو يَبغِيانِ بِها القَرارَ لَصادقا","في غَفلَةِ الحُرّاسِ مِنها ماحِيا",110,"ي",2,0],["لَو يَسمَعُ المَوتى الهُمودُ مَقالَتي","أَسدوا إِلى الأَوطانِ ما يُغنيها",111,"ي",3,0],["لو يعقِلُ الملكُ الغَبيُّ لمَا رأى","رَأْيَ الأُلى ضلّوا السّبيلَ ولا غَوَى",112,"غ",3,0],["لو يَستطيعُ لَمدَّ من أهدابِهِ","سَبباً يُشَدُّ به إليهِ ويُجذَبُ",113,"ب",1,0],["لو يريدُ الأذى بها لم تُطِقْها","مَن يعافُ الأذى ويأبَى العُراما",114,"م",2,0],["لَو يُنادى أَينَ الجَوادُ بِحَقٍّ","قالَ كُلٌّ إِلى الوَزيرِ يُشارُ",115,"ر",1,0],["لَو يَدُبُّ الحَوليُّ مِن وَلَدِ","الذّرِّ عَلَيها لأَندَبَتها الكُلومُ",116,"م",1,1],["لَوى صُدغَهُ كَالنونِ مِن تَحتِ طُرَّةٍ","مُمَسَّكَةٍ تُزهى بِعاجِ جَبينِ",117,"ن",1,0],["لو يَمسُّ النُّضَارَ هُونٌ مِنَ النا","رِ لما اختيرَ للنُّضَارِ الصِّلاءُ",118,"ا",2,0],["لو يَسْتَقِيمُ عليها السالكون بها","كما أمرتَ مشَتْ مَشْيَ المهَا الحُمرُ",119,"ر",1,0],["لَو يَصْدُقُونَ لَمَا أتَت رُسُلٌ لهُمْ","أتَرَى الطَّبِيبَ غَدَا يَزورُ عَلِيلا",120,"ل",2,0],["لَو يُسْتَطاعُ لهُ مِثْلٌ لَجِيء بِهِ","والمُسْتطاعُ مِنَ الأَعمالِ مَفْعُولُ",121,"ل",1,0],["لوْ يَقِرنُ اللّهُ البِلادَ بمِثْلِها","ضاقَتْ بعَزمِكَ والصَّبيرِ الدّاني",122,"ن",2,0],["لو يستطيع هَدى الرّكابَ لقَصْدها","وأنارَ ليلَ الرَّكبِ ضوءُ جبينه",123,"ن",2,0],["لو يَلتَقي الطّوفانُ قبلُ وَجوُدُه","لم يُنْجِ نُوحاً فُلْكُهُ المشْحون",124,"ن",1,0],["لو يستطيعُ البَحْرُ لاستَعدَى على","جَدْوَى يَدَيكَ وإنّهُ لَقَمِين",124,"ن",1,0],["لو يَدَّعِيهِ غيرُ حيٍّ ناطِقٍ","لَغَدَتْ أسودُ الغَابِ فيه تجادل",125,"ل",1,0],["لو يَستطيعُ الليلُ لاستعدى على","مَسراكَ تحتَ قِناعِهِ الحُلكوك",126,"ك",1,0],["لو يَرُدُّ الحزْنُ مَيْتاً هالِكاً","رُدَّ قحطانُ وَأُدُّ بنُ أُدَد",127,"د",1,0],["لو يُعْرَضُونَ على الدُّجُنّة أنكرَتْ","ذاكَ الشحوبَ النُّكْرَ والتلويحا",128,"ح",2,0],["لَو يَطيرُ الفَتى لَطِرتُ مِنَ الشَو","قِ مُنيباً إِلى الحَبيبِ المُنيبِ",129,"ب",1,0],["لَو يَنطُقُ اللَيلُ نادى كَم فَرى ظُلَمي","فَجرٌ وَأُدلِجتُ في حاجٍ وَأُسريتُ",130,"ت",1,0],["لَو يَفهَمُ الناسُ ما أَبنائُهُم جَلَبٌ","وَبيعَ بِالفَلسِ أَلفٌ مِنهُمُ كَسَدوا",131,"د",3,0],["لَو يَعقِلونَ لَهَنَّوا أَهلَ مَيِّتِهِم","وَلَم تَقَم لِوَليدٍ فيهُمُ البُشَرُ",132,"ر",1,0],["لَو يُنادى في كُلِّ سوقٍ عَلَيها","ما اِشتَراها أَخو رَشادٍ بِفَلسِ",133,"س",1,0],["لَو يُكَشَّفُ عَّن أَبصارِهِم لَرَأَت","آمالَهُم وَالمَنايا كَيفَ تَصتَرِعُ",134,"ع",1,0],["لَو يَترُكونَ وَهَذا اللُبَّ ما قَبِلوا","مَيناً يُقالُ وَلَكِن شالَتِ الجِذَمُ",135,"م",1,1],["لَو يَنطِقُ السَيفُ نادى لَيسَ لي عَمَلٌ","إِذا قَضى مالِكُ الأَفلاكِ أَنضاني",136,"ن",2,0],["لَوى اللَهُ عِلمَ الغَيبِ عَمَّن سِواءَهُ","وَيَعلَمُ مِنهُ ما مَضى وتأَخَّرا",137,"ر",2,0],["لو يعلمُ الأبلقُ مَن فوقَهُ","لاختالَ عن عُجبٍ به الأبلقُ",138,"ق",1,0],["لَو يصح التَشبيه قلت دموعي","يتبادرن مثل خيل السباق",139,"ق",1,0],["لوى البنفسج جيداً","كأَنَّه غير صاحي",140,"ي",1,0],["لَو يُنسَآنِ لَكانَ هَذا غارِباً","لِلمَكرُماتِ وَكانَ هَذا كاهِلا",141,"ل",2,0],["لو يعلمُ الزهرُ سرَّ عاشقه","أفردَ لي من هواه بستانا",142,"ن",2,0],["لَوَى جِيدَهُ وَانْصَرَفْ","فَمَا ضَرَّهُ لَوْ عَطَفْ",143,"ف",1,1],["لَوَى الرَّكْبُ أَعْنَاقَاً إِلَيْهَا خَوَاضِعَاً","بِزَفْرَةِ مَحْزُونٍ وَنَظْرَةِ وَامِقِ",144,"ق",1,0],["لَوَيْتُ بِهِ كَفِّي وَأَطْلَقْتُ سَاعِدِي","وَقُلْتُ لِدَهْرِي وَيْكَ فَامْضِ عَلَى رِسْلِ",145,"ل",1,0],["لَوْ يَعْلَمُ الْمَرْءُ مَا فِي النَّاسِ مِنْ دَخَنٍ","لَبَاتَ مِنْ وُدِّ ذِي الْقُرْبَى عَلَى دَخَلِ",146,"ل",1,0],["لَوَى قَدَّهَا سُكْرُ الْخَلاعَةِ وَالصِّبَا","فَمَالَتْ بِشَطْرٍ واسْتَقَامَتْ عَلَى شَطْرِ",147,"ر",1,0],["لَوْ يَحْتَذِيهِ الكِرَامُ مِنَا","لاَنْتَشَرَ العِلْمُ فِي السوَادِ",148,"د",1,0],["لَوْ يُجَارِي المُضَلِّليِنَ لأَلْقَى الْ","عِبْءَ عَنْهُ وَعَاشَ جِدَّ سَعِيد",149,"د",1,0],["لَوْ يُشْتَرَى صَوْنُ ذَاكَ الْمُلْكِ مِنْ خَطَرٍ","لَمَا بَخِلْنا وَلَوْ أَبْنَاؤُنَا بِيعُوا",150,"ع",3,0],["لَوَى بِبَنِي عَبْسٍ وأَحْيَاءِ وَائِلٍ","وكَمْ مِنْ دَمٍ بالظُّلْمِ أصْبَحَ يُسْفَكُ",151,"ك",1,0],["لو يعدَم عِلْمٌ أو كَرَم","أيقنتُ بِأَنَّكَ تُوجِدهُ",152,"د",2,0],["لو يعيشُ الإنسانُ عُمْرَ السُلحفا","ةِ لأغنَى هذا الوجودَ وأقنَى",153,"ن",2,0],["لوْ يعلمُ ما في الناس منْ دخنٍ","لَبَاتَ مِنْ وُدِّ ذِي الْقُرْبَى عَلَى دَخَلِ",154,"ل",1,0],["لو يفعلون الخير مح","ضًا كان ذلك أقْوما",155,"م",2,0],["لو يعلمُ الشهداء أجرَ جهادهمْ","ودُّوا لَوَ أنَّ الموت فيه تكرّرا",156,"ر",2,0],["لوْ يرزقُ الإيمانَ طودٌ، لارتقى","بقوادم من ريشه وخواف",157,"ف",1,0],["لو يستطيعُ النيلُ، لاَع","تَصَر المياه من الكروم",158,"م",1,0],["لو يقدرون أدالوا كلَّ ظاهرةٍ","وبّدلوا كلَّ نعماءٍ بغماء",159,"ا",2,0],["لو يعود اليومَ حياً لرأى","مثلَها ألفْاً تهزّ البُلَغاء",160,"ا",2,0],["لو يستطيعُ لَرَدَّ خُضرتَهُ","وبرغْمِ سَفْحَيْهِ تورَّده",161,"د",2,0],["لو يقول الاديب في الشرق \" إن الأرض","تحتي \" لسُميت نظريه!",162,"ي",2,0],["لو يُستجاب رجائي ما رجوتُ سوى","أنّي وشاحٌ على كَشْحيكِ مردود",163,"د",1,0],["لو يعلم الشجرُ الذي أنبتَّهُ","ما حل فيك منَ الأذى ما أورقا",164,"ق",2,0],["لو يَرْعَوي المتنابذونَ وكلُّهم","بهمُومِهم ، وشُعورهم ، أرحام",165,"م",1,0],["لو يبيع الخَمّار دَيناً بدينِ","لاشتراها وباع أخراه وكسْا",166,"س",2,0],["لو يدَّعي الحساد شأوك في العلى","لعريق مجدك يُستَذمُّ عريقه",167,"ق",2,0],["لويعلمُ المغرورُ ماذا حازَ منْ","خزي لوالدهِ ، إذن لم يبعثِ",168,"ث",1,0],["لَوْ يَكُونُ الحِبَاءُ حَسْبَ الذي أنْ","تَ لَدَيْنَا لَهُ مَحَلٌّ وأهْلُ",169,"ل",1,1],["لو يستطيع وقاك عادية الضنى","وتستطيع وقيته صرف الردى",170,"د",2,0],["لوينَ الحواجبَ نزعَ القسيّ","وأرسلنَ عنهنّ نيلَ الحدقْ",171,"ق",1,0],["لو يفهمُ الناسُ، ما أبناؤهم جَلَبٌ","، وبيعَ، بالفَلس، ألفٌ منهمُ كَسدوا",172,"د",3,1],["لو يشاء انْتحى هناك على كُلْ","ل مُسيءٍ بمنسم رضَّاضِ",173,"ض",1,0],["لو يستطِعن من الإشفاق إذ بَرزتْ","للمشي أَوْطأتُها منهنَّ أجفانا",174,"ن",2,0],["لو يدومُ الشبابُ مُدَّة َ عمري","لم تَذُمْ لي بشاشة ُ الأوطارِ",175,"ر",1,1],["لو يجمعِ اللَّهُ اللِّحى","كانت حُذَافَة َ لحيتِهْ",176,"ه",1,0],["لو يطعمُ الطِّبُّ الصناعُ بيانه","أو لو يسسغُ لما يقولُ مذاقا . . .",177,"ق",2,0],["لو يعلم الزّهر سرّ عاشقه","أفراد لي من هواه بستانا",178,"ن",2,0]]}