ك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5397,"هل من ضناي معالج يبريني","https://www.poetsgate.com/ViewPoem.aspx?id=157932",""],[5431,"بلقيس...","https://www.poetsgate.com/ViewPoem.aspx?id=204633",""],[5431,"نفحات الفن ...","https://www.poetsgate.com/ViewPoem.aspx?id=209138",""],[5431,"أما اكتفيت؟","https://www.poetsgate.com/ViewPoem.aspx?id=212797",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5582,"أَهْدَى لَكَ الشَّوْقَ وَالتِّذْكارَ وَالوَصَبا","https://www.poetsgate.com/ViewPoem.aspx?id=63462",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5704,"أم المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=191784",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5956,"سقوط عداي","https://www.poetsgate.com/ViewPoem.aspx?id=185611",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[520,"من استعان بغير الله لم يعن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577661",""],[520,"العلم مذ كان محتاج الى العلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577651",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6264,"مولد النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79129&r=&rc=37",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""]],"verses":[["هَذا أَبي وَالَّذي أَرجو النَجاحَ بِهِ","أَدعوهُ مِنكَ طَليقَ الهَمِّ وَالجَذَلِ",0,"ل",1,0],["هَذا أَبو إِسحَقَ يُغلِقُ رَهنُهُ","هَل ذا يَدٍ أَو مانِعٍ أَو فادِ",1,"د",1,0],["هذا أبو الحسَنِ بْنُ عثمانَ الذي","كرُمَتْ عناصرُهُ وطابَ نِجارُهُ",2,"ر",2,0],["هَذَا ابْنُ هُودٍ بَعْدَ إِرْثِ الْعُلَى","فَازَ بَنُو نَصْر بِأَسْلاَبِهِ",3,"ب",2,0],["هَذا أَبو العَدلِ فَمَن خالَهُ","حَيّاً فَما خالَ سِوى العَكسِ",4,"س",1,0],["هَذا اِبنُ إِسماعيلَ رَب","بِ النيلِ مَن أَغنى وَأَسدى",5,"د",2,0],["هَذا اِبنُ هرونَ الَّذي","في عَصرِنا لا يُفلحُ",6,"ح",1,1],["هَذا اِبنُ كامِل قَد أَودَعتُهُ ذَهباً","صُيّابَةً ما لَها في العَينِ مِقدارُ",7,"ر",1,0],["هذا أبوك وكان جدك أحمد","أمضى الولاة الحاكمين وأعدلا",8,"ل",2,0],["هَذَا ابْنُكَ الْعَلَمُ الأَشَمُّ قَدِ انْطَوَى","فِي بَرْزَخٍ مُتَطَامِنِ الأَرْكَانِ",9,"ن",1,0],["هَذا أَبو القاسِمِ الثاوي بِبَلقَعَةٍ","تَسفي الرِياحُ عَلَيهِ مِن سَوافيها",10,"ي",3,0],["هذا ابن اسحق تنجينا براحته","أقلامه الحمر في أحوالنا السود",11,"د",1,0],["هذا أبا إسحاق موقفُ عائذٍ","بك من نوائبَ لم يَدَعْنَ ثَميلا",12,"ل",2,0],["هذا أبو الصقر فردٌ في كتابتِه","وهو ابن شيبانَ بيْن الطلح والسَّلم",13,"م",1,0],["هذا أبو حسانَ سيفُ الردى","كَلِّمْه إن كنت من الصادقين",14,"ن",1,0],["هَذا أَبو مُسلم التيّاهُ","غرّته في دَولَتِهم دُنياهُ",15,"ه",1,0],["هذا ابنُ عبدِك زارَ بابَكَ راجياً","ظَفَراً لديك فهل ترى أن يَظْفَرا",16,"ر",2,0],["هَذا أَبو الفَضلِ الَّذي صَرُحَ النَدى","في راحَتَيهِ مَشوبُهُ عَن مَحضِهِ",17,"ض",2,0],["هَذا اِبنُ يوسُفُ في سَرعانِ ذي لَجَبٍ","فيهِ الظُبا وَالقَنا وَالكَيدُ وَالحِيَلُ",18,"ل",1,0],["هَذا اِبنُ يوسُفَ في يَدَي أَعدائِهِ","يُجزي عَلى الأَيّامِ بِالأَيّامِ",19,"م",1,0],["هَذا اِبنُ ذاكَ وِلادَةً وَأُخُوَّةً","عِندَ الزَعازِعِ وَالقَنا المُتَزَعزِعِ",20,"ع",1,0],["هَذا اِبنُ خَيرِ عِبادِ اللَهِ كُلِّهِمُ","هَذا التَقِيُّ النَقِيُّ الطاهِرُ العَلَمُ",21,"م",1,0],["هَذا اِبنُ فاطِمَةٍ إِن كُنتَ جاهِلَهُ","بِجَدِّهِ أَنبِياءُ اللَهِ قَد خُتِموا",21,"م",3,0],["هَذَا ابْنُ سَيِّدَةِ النِّسْوَانِ فَاطِمَةٍ","وَابْنُ الوَصِيِّ الَّذِي‌ في‌ سَيْفِهِ نِقَمُ",22,"م",1,0],["هذا ابتداءٌ له عند العُلى خَبَرُ","يُحْكَى فيُصْغي إليْه الشُّهْبُ والبشَرُ",23,"ر",1,1],["هذا ابنُ يحيَى ذو السماح جنابُهُ","مُسْتَهْدَفٌ بِعَزائِمِ القُصّادِ",24,"د",1,0],["هَذا اِبنُ خالِكُمُ يُهدي نَصيحَتَهُ","مَن يُتَّهَم فَهوَ فيكُم غَيرُ مُتَّهَمِ",25,"م",1,0],["هذا أبو لؤلؤةٍ","منهُ خذوا ثأرَ عُمَرْ",26,"ر",1,0],["هَذا أَبو الخَطّابِ قالَت نَعَم","قَد جاءَ مَن نَهوى وَما أَغفَلا",27,"ل",2,0],["هذا أبو بكرٍ مَشَى في صحبِهِ","يلقاكَ مُبتهِجاً ورَكبُكَ قادِمُ",28,"م",1,0],["هذا ابنه جاءه غضبانَ يمسكه","دون المدينةِ للمختارِ ينتصر",29,"ر",1,0],["هذا أبو الحكمِ انجابتْ عَمايتُه","لما قَضى السيفُ وهو الخصم والحكم",30,"م",1,0],["هذا ابنُ حارثةٍ يَطوفُ مُبشّراً","بالنّصر يُخزِي الكافِرينَ ويفضَحُ",31,"ح",1,0],["هَذا أَبو عُثمانَ خَيَّمَ قَدرُهُ","في النَيِّراتِ وَشَخصُهُ بَينَ الوَرى",32,"ر",2,0],["هَذا أَبو بَكرٍ يَقودُ بِوَجهِهِ","جَيشَ الفُتونِ مُطَرَّزَ الراياتِ",33,"ت",1,1],["هَذا أَبو القاسِمِ في نَعشِهِ","قوموا اِنظُروا كَيفَ تَسيرُ الجِبال",34,"ل",1,0],["هذا ابنُ وَحيِ اللّهِ تأخُذُ هَدْيَها","عنهُ الملائكُ بُكْرَةً وأصِيلا",35,"ل",2,0],["هَذا ابنُ نَيبَختٍ لَهُ إِمرَةٌ","صاحِبُ كُتّابٍ وَحُجّابِ",36,"ب",1,0],["هَذا أَبو الهِندِيِّ في","هِ مَشابِهٌ مِن غَيرِ واحِد",37,"د",1,0],["هَذا ابنُ إِسماعيلَ يَبني العُلى","وَيَصطَفي الأَكرَمَ فَالأَكرَما",38,"م",2,0],["هذا أبو بكرٍ يُقَدِّمُ شَيْخَهُ","يهديه إنّ الألمعيَّ لَيَهْتَدِي",39,"د",2,0],["هذا أبو القاسم أعجوبةٌ","لكل من يدري ولا يدري",40,"ي",1,1],["هذا أَبوكَ أَكَنَّ حَسرَتَهُ","لكِنَّ عَينَيهِ بِهِ وَشَتا",41,"ت",2,1],["هذا أَبوكَ المُبتَلى","يَشكو وَيَبكي أَثَرَك",42,"ك",1,0],["هذا ابنُ إِسماعيل فانثُر حولَهُ","دُرَراً تَدُومُ على الزَّمانِ وتُذْخَر",43,"ر",1,0],["هذا ابنُ إبراهيمَ واهبُ قومهِ","نِعَمَ الحياةِ وباعثُ الآمال",44,"ل",1,0],["هذا أبو الأشبالِ سَلْ عنه العُلا","تُنْبِئكَ حقاً مَنْ أبو الأشبال",44,"ل",1,0],["هذا أبو التاريخِ من أضحَى اسمُه","أُنْشودَةَ الأجيال للأجيال",44,"ل",1,0],["هذا أبو الذهبِ الذي غَمَرَ المُنَى","بعوارفِ الإحسانِ الأفضال",44,"ل",1,0],["هذا أبٌ أودى به تَزَقُ ابنه","ماذا تقول لفتية أغرار؟",45,"ر",1,0],["هذا ابن هاني على يُمْنايَ يُنْشدني","وعن يسارِيَ بَشَّارٌ وحمَّاد",46,"د",1,0],["هذا ابن هودٍ بعد إرث العلا","فازَ بنو نصرٍ بأسلابهِ",47,"ب",2,0],["هذا أبو الذهبِ الذي غَمَرَ المُنَى","بعوارِف الإحِسان والأفضال",48,"ل",1,0],["هذاأبُوا العَدْلِفمَنْ خالَه","حَياً فما خَالَ سِوَى العَكْسِ",49,"س",1,0],["هذا ابو العلمين احمد الذي","فخرت به الزهراء والكرار",50,"ر",1,0],["هذا أبو العربِ المشهورُ مَنْصِبُه","كمثل ما اشتهرتْ آياتُ ياسين",51,"ن",1,0],["هذا ابن حجاجٍ تفاقم أمره","وجرى وجر لحد غايته الرسن",52,"ن",1,1],["هَذا اِبنُ جَرّاحٍ أَتاكَ وَهَل لِمَن","أَقصَيتَهُ إِلّا إِلَيكَ عِوادُ",53,"د",1,0],["هَذا ابْنُ خَيْرِ الوَرى مِنْ بَعْدِ خَيْرِهِمُ","هَذا الَّذي كَتَبَتْ لا كَفُّهُ نَعَما",54,"م",2,0],["هذا ابن إسماعيل وافاك فلا","تأس لكسرِ البُعد فهو ينجبر",55,"ر",1,0],["هَذا اِبنُ يوسُفَ مِن بَني الدَبّاسِ قَد","سَقَتِ الدُموعُ ثَراهُ بَردَ مَعينِ",56,"ن",1,1],["هَذا اِبن يوسُفَ مِن بَني الدَبّاسِ قَد","رَوَّت شَآبيبُ الدُموعِ تُرابَهُ",57,"ب",2,1],["هَذا اِبن قُطبِ عُلومِ الشَرقِ عاجَلَهُ","سَهمُ المَنايا فَأََدمى بِعدَهُ المُهَجا",58,"ج",2,1],["هذا ابنُ مَنْ أَدْناهُ منه إلهُه","كالقابِ من قَوْسَيْن في تمثيله",59,"ل",2,0],["هذا ابن من نطق الذراعُ لجَدِّه","إذْ سَمَّه الكفار في مأكوله",59,"ل",2,0],["هذا ابنُ مَنْ دانتِ الدنيا لِهمَّتِه","واستعبدَ الخلقَ من عُرْبٍ ومن عجم",60,"م",1,0],["هذا أبو حسن الذي إحسانُه","ردَّ الأُجاجَ من الحياة زلالا",61,"ل",2,0],["هذا ابن يزداد الذي أيامُه","كست البلادَ بشاشةً وجمالا",61,"ل",2,0],["هذا أبو عبد الإله يمدُّه","شكرُ الإله بفضله المتوالي",62,"ل",2,0],["هذا ابنُ إسماعيل نجماً طالعا","لهدايةِ الساري فحَيِّ على السُرى",63,"ر",2,0],["هذا ابن (آمنة) لاحت بشائره","فأزهر الكون واهتزّت روابيه",64,"ي",2,0],["هَذا اِبنُ جاموس ضَعوا في أَنفِهِ","بُرَةً وَجُرّوهُ إِلى جَرِّ العَجَل",65,"ل",1,1],["هذا ابن يوسف حجة الإسلام","كنز العلوم وروضة الأكمام",66,"م",1,1],["هذا ابن يوسف شيخنا وإمامنا","ودليلنا في الدين والاحكام",66,"م",1,0],["هذا ابن يوسف واحد في عصره","أعظم به من مرشد ومحام",66,"م",1,0],["هذا ابن يوسف ذلك الطود الذي","في وصفه قل عالم الاعلام",66,"م",1,0],["هذا ابن يوسف من بنور علومه","قلل ادخلوا باب الهدى بسلام",66,"م",1,0],["هذا ابن يوسف وابن يوسف ان تشأ","تعريفه قل مركز الاسلام",66,"م",1,0],["هذا ابن يوسف قطب دائرة الهدى","هذا ابن يوسف قدوني وامامي",66,"م",2,0],["هذا ابن يوسف من له صيت علا","هامات ملك العرب والاعجام",66,"م",1,0],["هذا ابن يوسف ذو التصانيف التي","قد أعجزت ذا منطق وحسام",66,"م",1,0],["هذا ابن يوسف فخر كل محقق","وحسام كل معاند متعام",66,"م",1,0],["هَذا اِبنُ أُمّي الَّذي راعيت قربتَه","ما كانَ عِندي بسوء الظنِّ يُتَّهمُ",67,"م",1,0],["هَذا أَبي حين يُعزى سيِّدٌ لأبٍ","هَيهات ما لِلوَرى يا دَهرُ مثل أَبي",68,"ب",2,0],["هذا أبو العباس والملك الذي","فخرت به الخضراء والغبراءُ",69,"ا",2,0],["هذا أبو العباس خير خليفة","شهدت له الشيم التي لا تجهل",70,"ل",1,0],["هَذا أَبو بَكرٍ حازَ الفَضلَ أَجمَعُهُ","وَلَيسَ تَخفى لِذي النورَينِ هِمَّتُهُ",71,"ت",2,0],["هَذا أَبو عَمرو البَدر المُنير هُدىً","جاوَرتهُ فَما عزّي بِهِ الفلكا",72,"ك",2,0],["هذا اِبن بَيت عَتيق","لَدى كَدى وَالمحطم",73,"م",1,0],["هذا اِبن مكة فَاِنظُر","لِمَن لذى البُقعَة اِنضَم",73,"م",1,0],["هذا أَبو الفرحات هذا المُنتَقى","من نسل من لانَت لَهُ الاِحجار",74,"ر",1,0],["هذا ابنُ عَمِّكمُ الذي أضحَتْ له","فُرَجُ الأناملِ مَنْهلاً للوُرَّد",75,"د",1,0],["هَذا أَبو نصر الَّذي ورث العُلى","عَن سادَةٍ نُجُبٍ بِغَير كَلامِ",76,"م",1,0],["هذا ابنُ عمِّكَ في أسرِ الفِرَنجِ له","حولٌ تجرَّم في الأغْلاَلِ والظُّلَمِ",77,"م",1,0],["هذا أبيُّ الضّيم وابنُ أباته","والبض تركع والجماجم تسجد",78,"د",1,0],["هذا ابن اسعد في العلياء رتبتهُ","كأنه علم في ظاهر العلم",79,"م",1,0],["هذا ابن أسعد لا ند يشاكله","المرعب الضد بالهندية الصقل",80,"ل",1,0],["هذا أَبو القاسِمِ المقسومُ نائِلُه","ما السيلُ ما البَحْرُ ما الأَنهارُ ما المَطَر",81,"ر",1,0],["هذا أَبوكَ البحْرُ جارَ على","مالِي وأَجْرَى في الدُّموعِ دمِي",82,"م",2,0],["هذا أبو الفضلِ بدرُ الحُسن قد شهدَتْ","أوصافُه أنه كالبدرِ في الأفُقِ",83,"ق",1,1],["هذا أبو عبد الإلهِ مخلَّدٌ","إنْ كان خُلِّدَ سيّدٌ لسَدادِه",84,"د",2,0],["هذا أبو إسحاق يشكر صنعكم","هل فوق هذا الفخر من مطلوب",85,"ب",1,0],["هذا أبو الأحرار أول صارخ","كم تستنيم لذل حكم غريب",85,"ب",1,0],["هذا ابن مامة والحديث يطوله","ذو خصلة وقد افترعت خصالا",86,"ل",2,0],["هذا ابنُ فاطمةٍ إِن كنتَ تجهلُهُ","بجَدِّهِ أَنبياءُ اللهِ قد خُتِموا",87,"م",3,0],["هذا أَبو العَ