{"poems":[[55,"من معيد لي أيا","https://www.aldiwan.net/poem30672.html","مجزوء الرمل"],[75,"ليهن الهدى إنجاح سعيك في العدا","https://www.aldiwan.net/poem11949.html","الطويل"],[53,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[47,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[47,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[99,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[50,"تفتير عينيك دليل على","https://www.aldiwan.net/poem62498.html","السريع"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/57893","المتقارب"],[53,"عقيدَ النَّدى أطلِقْ مدائح جمّة","https://www.poetsgate.com/ViewPoem.aspx?id=27413",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[159,"زمن مثل زورة الأحباب","https://www.aldiwan.net/poem55798.html","الخفيف"],[203,"يا ليل هيجت أشواقا أداريها","https://www.aldiwan.net/poem45151.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"إلى من يشار بهذا العذل","https://www.aldiwan.net/poem60798.html","المتقارب"],[463,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[463,"ساهرة الليل نؤوم الضحى","https://www.aldiwan.net/poem56309.html","السريع"],[466,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[505,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[520,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[556,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2468","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64937","الوافر"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124186","المنسرح"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137405",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141183","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138699",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35101","الوافر"],[4883,"عتب","https://www.poetsgate.com/ViewPoem.aspx?id=48362",""],[4119,"وحل ذرى العواصم وهي نهبى","https://www.poetsgate.com/ViewPoem.aspx?id=16118",""],[5275,"صرخة من بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=35276",""],[5866,"لا والله الا وصلوها مواصيل","https://www.poetsgate.com/ViewPoem.aspx?id=182873",""],[6124,"رائحة الأنثى","https://www.poetsgate.com/ViewPoem.aspx?id=159879",""],[6124,"رائحة المسك","https://www.poetsgate.com/ViewPoem.aspx?id=159880",""],[6144,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=13798",""]],"verses":[["رائِحاتٍ في جَلابي","بِ الدُجى مُختَمِراتِ",0,"ت",1,0],["رَأى حَطَّها أَولى بِهِ فَأَحَلَّها","حَضيضاً بِكَفرانِ الصَنيعَةِ أَوهَدا",1,"د",2,0],["رأى حسناً لاقاهُ جازٍ بسيِّئٍ","فهلّل إكباراً لذاك وسبَّحا",2,"ح",2,0],["رأى حظِّيَ الحُسَّادُ قبلَ حُصولِهِ","فقد سلَّفوني عضَّهُم بالأباهِمِ",3,"م",1,0],["رائحٌ بالمجدِ غادٍ عليهِ","من ثيابِ الحَمدِ ثَوبٌ رِفَلٌّ",4,"ل",1,0],["رَأى حَوزَ الثَناءِ أَجَلَّ كَسباً","وَحَسبُ المَرءِ مَكسَبَةُ الثَناءِ",5,"ا",2,0],["رائِحٌ مُغتَدٍ بِحِلمٍ ثَقيلٍ","راجِحٍ وَزنُهُ وَفَهمٍ خَفيفِ",6,"ف",1,0],["رائِحٌ مُغتَدٍ وَما مَتَعَ الصُب","حُ إِدِّلاجاً لِلشَحذِ وَالتَطفيلِ",7,"ل",1,0],["رَأيٌ حَمَيتَ بِهِ حُماةَ وَأَهلَها","وَرَعى المَمالِكَ سَعيُكَ المَشكورُ",8,"ر",1,0],["رائحاً في لجة طاغية","غادياً في عاصف مضطربِ",9,"ب",1,0],["رائِحَةُ الخَمرِ وَلَذّاتُها","وَالخَمرُ لا تَخفى لَها رائِحَه",10,"ح",2,0],["رَأَى حَيثُ أَمسى أَطلَسَ اللَونِ بائِساً","حريصاً تُسَمِّيهِ الشَياطِينُ نَهسَرا",11,"ر",2,0],["رأى حلباً بلداً داثراً","فزادَ لإصلاحِها حرصَهُ",12,"ص",2,1],["رأى حسناً لاقاهُ جازٍ بسيءٍ","فَهلّل إكباراً لذاك وسبَّحا",13,"ح",2,0],["رأى حرمات الله لا من يصونها","قوي ولا عدل يرد المبدلا",14,"ل",2,0],["رائِحٌ في العُلى بِراحَةِ جُودٍ","بابُ أَمْوالِهَا بِلا بَوَّابِ",15,"ب",1,0],["رأى حقيقة هذا الحس غامضة","فجاء يظهرها للناس تشبيها",16,"ي",3,0],["رأى حلما حقّقته الحياة","ليشتفَّ أعماق بحر الحياه",17,"ه",1,0],["رأَى حُسْنَ خُلْقِكَ عَصْرُ الرَّبيعِ","فما يَنْبُتُ الوَرْدُ إلاّ خَجَل",18,"ل",1,0],["رأى حربَك النارَ تُذكَي فسا","قَ حَشْداً ليُطْفئَها واحتفالا",19,"ل",2,0],["رائحةٌ في السِّربِ لم تُقْتَنَصْ","ظباؤه إلا بأمر الدُّجَى",20,"ا",1,0],["رأى حضرة العلياء أكثر حاجةً","اِليك من الصَّادي لصوبِ الكنهور",21,"ر",1,0],["رأَى حاسِدي شأني فخامَرَهُ عَمًى","وزاحَمَني وهماً فأقعَدَهُ الهَمُّ",22,"م",1,1],["رأى حِفظَ العُهودِ لساكِنيها","وضيّع قلبَهُ بين المَغاني",23,"ن",2,0],["رأي حقنت به دماء خلائق","ظنت بأن دروعها أكفانها",24,"ن",3,0],["رائِحٌ ما لهُ غدّوٌ وَإمّا","ذو غدوٍّ لكنّه لا يروحُ",25,"ح",1,0],["رائِحاتٍ عَشِيَّةً عَن قُدَيدٍ","وارِداتٍ مَعَ الضُحى عُسفانا",26,"ن",2,0],["رَأَى حُلَلَ المدائحِ ليس تَفْنَى","فأَغْلاها وأَرخَصَ كلَّ حُلَّهْ",27,"ل",2,0],["رأى حمير الشّعير عابرةً","عليه يوماً فظلّ ينشدها",28,"د",3,0],["رأى حسن من يهوى واعيى وصاله","ولم يلف صبرا في الحياة فملها",29,"ه",2,0],["رأى حكمة قدسية لا يشوبها","شوائب أنظار وأدناس أفكار",30,"ر",1,0],["رائحاً غادياً ترنّم كالطي","ر تناغى في ظله الفينان",31,"ن",1,0],["رأى حسن اخلاقٍ وطيب شمائلٍ","ووجهاً منيراً يخجل البدر زاهراً",32,"ر",2,0],["رَأى حَرَكاتِ قامَتِهِ","قَضيبُ البانِ فَاِعتَبَرا",33,"ر",2,1],["رايح الغيم ماله من غدو","تضحك البيد في وجهه وكاد",34,"د",1,0],["رأى حط المكوس عن الرعايا","فأهدر قبل ما أنشاه بعد",35,"د",1,0],["رايح ْ للشغل ْ بلْجي الشغل ْ زين ْ","وأريدج ْ تندِعيلي ْ عل َ الجيّه ْْ",36,"ي",2,0],["رايح تصيبه نكبةً يارجاجيل","لو جابه النكبة بمليون حيلة",37,"ل",2,0],["رائحةُ الأنثى طافتْ حولي","فرفعتُ النَّظَّارةَ أُجلِي",38,"ي",1,1],["رائحةُ المسكِ على الكفِّ البيضاءِ","كانت تغرسُ في المقلةِ وتدًا من فرحةْ",39,"ه",1,1],["رايح واحدة والنبي إنك بايخ","والتانيه قالت يبتليك برزيه !",40,"ه",1,0]]}