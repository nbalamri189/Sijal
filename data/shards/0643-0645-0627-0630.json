{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[66,"دلال يا محمد مستعار","https://www.aldiwan.net/poem67651.html","الوافر"],[42,"أراد اليوم جيرتك الغيارا","https://www.aldiwan.net/poem42293.html","الوافر"],[113,"عذرا لعبدك قد ماتت قرائحه","https://www.aldiwan.net/poem16301.html","البسيط"],[132,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[139,"كما ذا أكاتبكم ولم أر مرة","https://www.aldiwan.net/poem49055.html","الكامل"],[228,"على ذروة بين أطلال صور","https://www.aldiwan.net/poem39710.html","المتقارب"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[366,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[408,"أتعزي في المصاب","https://www.aldiwan.net/poem46436.html","مجزوء الرمل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[438,"لها ناظر في ذرى ناضر","https://www.aldiwan.net/poem12777.html","المتقارب"],[463,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[466,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[487,"تستر ناسوتي بناسوت أهبه","https://www.aldiwan.net/poem24438.html","عموديه"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59537","الخفيف"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96306","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95560","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53232","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100894","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130815",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203473","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109961","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33485","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4680,"دنيا الهباء","https://www.poetsgate.com/ViewPoem.aspx?id=198169",""],[4767,"تحية القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=179541",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""]],"verses":[["كَم أَذكَروني مَعشَراً","كانوا قَراراتِ الكَرَم",0,"م",1,0],["كَما ذَبَّبَت عَذراءُ غَيرُ مُشيحَةٍ","بَعوضَ القُرى عَن فارِسِيٍّ مُرَفَّلِ",1,"ل",1,0],["كَما ذَهَبَ الحِمارُ بِأُمِّ عَمرٍو","فَلا رَجِعَت وَلا رَجَعَ الحِمارُ",2,"ر",1,0],["كَما ذادَ المُنَهنِهُ عَن حِياضٍ","عِذابِ الماءِ صادِيَةً حِرارا",3,"ر",2,0],["كَما ذا يُعاند آمالي وَيَعكسها","بِفعلِهِ فَلَكٌ قَد جالَ رامحهُ",4,"ح",2,0],["كما ذكرُوا بيتاً من الشعر سالفاً","عن العالم الماضى سَمعناهُ يُرْفَعُ",5,"ع",1,0],["كما ذا أكاتبكم ولم أرّ مرةً","منكم مكاتبة فمن لي منجداً",6,"د",2,1],["كَما ذَرَتِ النارُ شَعبَ سَدوم","وَلم يَبقَ من مَجد آثارِهِ",7,"ه",1,0],["كَم أَذلَّ الهَوى عَزيز أُناس","وَهوَ فينا ذو رِفعة وَجَلاله",8,"ل",2,0],["كَم أَذى قد حَملت لكِن أَيا","تي أَراني في ضِمنِها اِحسانَه",9,"ن",2,0],["كَما ذَكَت مَجامِرُ نِجادُهُ","نَشرٌ شَذا مَعَ الهُبوبِ السَرمَد",10,"د",1,0],["كَمْ أذالَتْ من مصونٍ","وأزّالت من حجاب",11,"ب",1,0],["كما ذرَّه مصباحها وفتيلها","فكن مسعدي يا سعد حين انقضائها",12,"ه",2,0],["كما ذُعِر الظبيُ من قانصٍ","ففرّ وكرّر في الإلتِفاتِ",13,"ت",1,0],["كما ذَمَّ مَنْ قبلي ذممتُك عالماً","بأنك موقوفٌ على الذمِّ مِن بعدِي",14,"د",2,0],["كم أذَلْتُ المديحَ في حمْد قومٍ","كان كُفْراً بالمجد ذاكَ الحمدُ",15,"د",1,0],["كما ذقت رفعا للنقيضين عندما","أماط سحاب الغين أنت اجتماعه",16,"ع",2,0],["كم أذلَّ الأُسودَ عبدُ حِماهُ","حين ناداهُ في طُوى الفَيْفاءِ",17,"ا",2,0],["كَم أَذاقَ حِمامَ المَوتِ مِن بَطَلٍ","حامي الحَقيقَةِ لا يُؤتى مِنَ الوَهَلِ",18,"ل",1,0],["كم أذلنا من الدموع مَصُوناً","وشققْنا عند الفراق الجيوبا",19,"ب",2,0],["كما ذاد عن عِرِّبسَةِ الغيل مُخَدِرٌ","يَخافُ الرّدى رُكبانُه وأراجله",20,"ل",2,0],["كما ذكرتني بالعذيب وبارق","بروق ثنايا من غمام يراقع",21,"ع",1,0],["كَمَا ذَكَّرَتْنِي بِالعَقِيقِ مَدَامِعٌ","نَثَرْنَ لآلِي كَالجُمَانِ المُنَظَّمِ",22,"م",1,0],["كما ذَوَى الغصن غضاّ","زكا جناه وطابا",23,"ب",2,0],["كم أذلت نفساً أدلَّت بما نال","ت وكل بحبها مفتون",24,"ن",1,0],["كم أَذُبُّ السُّلوَّ عنه وكم أُمْسِ","ي بنار السلوِّ عنه أذوبُ",25,"ب",1,0],["كم أذلُّوا من ضعيفٍ كابرٍ","يرتضى الموت ويأبى أن يُضاما",26,"م",2,0],["كم اذيقا من الصعاب هواناً","في رضانا وجرعا شر جامِ",27,"م",1,0],["كَم أَذاقَ الهامَ مِنهُم في الوَغى","سَيفَهُ الصَلتَ الَّذي ما وَهَنا",28,"ن",2,0],["كم أذابت من المتاعب روحاً","نثرتها مع الجناح النثير",29,"ر",1,0],["كم اذهَبَ الذَهَبُ الموموق من شرفٍ","سامٍ وكم فضة قد فضت الفكرا",30,"ر",2,0],["كم اذهبوا في الوَرَى تصريع ذي لَمَمِ","واطلَقُوا أَلسُناً من رِبقةِ البَكَمِ",31,"م",1,0],["كم أذقت البوار أبطال قوم","لم يكونوا لولا حسامك بورا",32,"ر",2,0],["كم أذهب المس مس راحته","وكم كفى وكف كفه غيرا",33,"ر",2,0],["كَم أَذَلَّت جَبّارَ قَومٍ وَغَلَّت","مِن طَليقٍ وَأَسلَسَت مِن أَبِيِّ",34,"ي",1,0],["كم أذىً أيها المضرُّ بجِسمي","طولُ هذا يجدُّ شوقي وأبلى",35,"ل",2,0],["كم أذن أصغت له إذ نقرا","فأعطيت ما اعطيته خبرا",36,"ر",2,0],["كما ذهبت شواهقها سنمضي","فما في هذه الدنيا بقاءُ",37,"ا",2,0],["كم أذْهَبَتْ عَن قَلبِ شخصٍ تائبٍ","بِالقُربِ مِن ربٍّ رحيمٍ كلَّ غَمْ",38,"م",1,0],["كم أذلت الدموع حمرا من القلب","كأن الآماق كانت كلوما",39,"م",2,0],["كما ذكر ابن القيم الأوحد الذي","أتى بنفيس العلم في كل ما يبد",40,"د",1,0],["كَمَا ذَوَى بِالضَّيمِ حُبٌّ قَد سَمَا","فَالشُّرُ يأبَى أَنْ يَرَاهُ سَاريَا",41,"ي",2,0]]}