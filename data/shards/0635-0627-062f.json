,""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[5324,"أه ما اشقاك ياقلبي المعنى","https://www.poetsgate.com/ViewPoem.aspx?id=211255",""],[5357,"صادفنّي ثلاث","https://www.poetsgate.com/ViewPoem.aspx?id=15692",""],[5409,"صادف الضبع في الروابي ابن آوى","https://www.poetsgate.com/ViewPoem.aspx?id=155422",""],[5431,"ظبية الروح....","https://www.poetsgate.com/ViewPoem.aspx?id=205363",""],[5434,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=37611",""],[5467,"خوف ورجاء","https://www.poetsgate.com/ViewPoem.aspx?id=199796",""],[5491,"سلطان القلب وسيده","https://www.poetsgate.com/ViewPoem.aspx?id=215445",""],[5497,"مر السحائب","https://www.poetsgate.com/ViewPoem.aspx?id=210555",""],[5732,"انبيك يامن هو عن الحال نشاد","https://www.poetsgate.com/ViewPoem.aspx?id=177870",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5829,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=153128",""],[5894,"صب له عيش الحياة منغص","https://www.poetsgate.com/ViewPoem.aspx?id=131423",""],[5956,"إني لمجنون","https://www.poetsgate.com/ViewPoem.aspx?id=182320",""],[5956,"من فضائل الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192552",""],[5956,"ما العدلُ يمكن أن يسري سواسية","https://www.poetsgate.com/ViewPoem.aspx?id=204193",""],[6052,"ضمير العالم","https://www.poetsgate.com/ViewPoem.aspx?id=34807",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6113,"خلي هجرني","https://www.poetsgate.com/ViewPoem.aspx?id=14618",""],[6113,"الحمد لله بس عدت على خير","https://www.poetsgate.com/ViewPoem.aspx?id=27074",""],[6124,"عصفور الكناري","https://www.poetsgate.com/ViewPoem.aspx?id=201240",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[327,"بانَ الخليطُ فقلبي اليَوْمَ مُختَلَسُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19144&r=&rc=3",""],[6202,"إن تمكري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86708&r=&rc=9",""],[6288,"صدفه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79612&r=&rc=38",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["صادَت فُؤادي مِنهُنَّ جارِيَةٌ","مَكحولَةُ المُقلَتَينِ بِالحَوَرِ",0,"ر",1,0],["صادَت فُؤادِيَ مِكسالٌ مُنَعَّمَةٌ","كَالبَدرِ حينَ بَدا بيضاءُ مِعطارُ",1,"ر",1,0],["صادَت بِعَينٍ وَثَغرٍ رَفَّ لُؤلُؤُهُ","فالعَينُ مُمرِضَةٌ وَالثَغرُ سَحّارُ",1,"ر",1,0],["صادَت فُؤادي بِعَينَي مُغزِلٍ خَذَلَت","تَرعى أَغَنَّ غَضيضاً طَرفُهُ خَرِقا",2,"ق",2,0],["صَادِرَاتٌ فِي وُجْهَةِ الخَيْرِ عَنْ عَقْ","لٍ حَصِيفٍ وَعَنْ فُؤَادٍ رَحِيمِ",3,"م",1,0],["صادف فيه وردة زاهرة","والطلّ كاللؤلؤ فيها انتظم",4,"م",1,0],["صادفتنا أشعة من حياة","فظهرنا وهل لأول مرّة",5,"ر",2,0],["صادَفنَ مِنها غِرَّةً فَأَصَبنَها","إِنَّ المَنايا لا تَطيشُ سِهامُها",6,"م",3,0],["صادفن واديَه المغبوط نازلُه","لا مرتعاً بعُدتْ من حمضه الخُلَلُ",7,"ل",1,1],["صادَقَ الخدّ واسْتحمَّ به الجس","م فآهاً من الصديق الحميم",8,"م",1,0],["صادفوا نكبتي فكانت لديهم","للقلوبِ المِراضِ منهم شفاءَ",9,"ا",2,0],["صادت فؤادي عشيةَ النفرِ","ظبيةُ قصرٍ نأتْ عن القَفْرِ",10,"ر",1,1],["صادفتُ ذكرك كالسرا","ر فقلتُ فيك فصار بدرا",11,"ر",2,0],["صادياً لا أنال رِيّا ومَثوا","ي ببحرٍ بموجِه فيَّاض",12,"ض",1,0],["صادفَ فضلاً من سيِّدٍ فصفا","إلى الهُوينَى ومشتكى فشكا",13,"ك",2,0],["صادفْتُ منه بليغاً في مواهبهِ","تعطي يداه تفاريقَ الغنى جُملا",14,"ل",2,0],["صادمَ حافاتِ حِرٍ كُلُّها","مُكلّلُ الرأسِ ثآليلا",15,"ل",2,0],["صادفوا دونَ ذاك شوكَ القنا اللد","نِ وودُّوا لو كان شوكَ السيالِ",16,"ل",1,0],["صادفْتَه قَشْفاً فكنتَ جلاءَهُ","ورأَيْتَ بي شَعْثاً فكنتَ الداهنا",17,"ن",2,0],["صادفتَ أعلام الثناءِ خسائساً","فجعلتها بالعارفاتِ ثمائنا",17,"ن",2,0],["صادَفَ أَطلَسَ مَشّاءً بِأَكلُبِهِ","إِثرَ الأَوابِدِ ما يَنمي لَهُ سَبَدُ",18,"د",1,0],["صادَت فُؤادي يا بُثَينَ حِبالُكُم","يَومَ الحَجونِ وَأَخطَأَتكِ حَبائِلي",19,"ل",2,0],["صادت فؤاد أصيد","من قبلها لم يكلم",20,"م",1,0],["صادَفَت قُرحَةً يُلائِمُها الصَب","رُ وَتَأبى عَلَيهِ غَيرَ الفَسادِ",21,"د",1,0],["صادَت بِقارِعَةِ الصَعيدِ بَعوضَةٌ","في الجَوِّ صائِدَ بازِهِ وَعُقابِهِ",22,"ب",2,0],["صادِرٌ عَن نَدى يَدٍ مِنكَ لا يَن","صُفُها البَحرُ مَوجُهُ وَعُبابُه",23,"ب",2,0],["صادِقاتِ الوَدادِ تَصدُقُ فيها","ألسُنُ الحَمْدِ وافياتِ الصِّداقِ",24,"ق",1,0],["صادقُ البِشْر ترى ماءَ النَّدى","يرتقي في وَجْهِهِ أو يَنحدِر",25,"ر",1,0],["صادَ القُلوبَ بِمُقلَتَيهِ وَلَم أَخَل","أَنَّ الجَآذِرَ لِلقَساوِرِ تَقنِصُ",26,"ص",1,0],["صادَمتَهُم في نَقعِ لَيلٍ حالِكٍ","طَرفُ المَنِيَّةِ في دُجاهُ أَخوَصُ",26,"ص",1,0],["صادوا فُؤادي وَحِلُّ الصَيدِ مُمتَنَعٌ","لَهُم وَقَد عَلِموا أَنَّ الهَوى حَرَمُ",27,"م",1,0],["صادَ بالبأس عليٌّ صِيدَها","وَثَنى منها عن النصر عِنان",28,"ن",1,0],["صادَتْكَ مهاةٌ لم تُصَدِ","فلواحِظُها شَرَكُ الأُسُدِ",29,"د",1,1],["صادى أَميرَ المُؤمِنينَ بِزَبرَجٍ","في طَيِّهِ حُمَةُ الشُجاعِ الصاري",30,"ر",2,0],["صَادَقْتُ بَعْضَ الْقَوْمِ حَتَّى خَانَنِي","وَحَفِظْتُ مِنْهُ مَغِيبَهُ فَرَمَانِي",31,"ن",2,0],["صَادِقُ الْوُدِّ لا يَخِيسُ بِعَهْدٍ","وَقَلِيلٌ فِي النَّاسِ رَعْيُ الذِّمَامِ",32,"م",1,0],["صَادَ بِاللَّحْظِ فؤَادِي","أَتَرَى الْهُدْبَ حِبَالَهْ",33,"ل",2,0],["صادَ قَلبي اليَومَ ظَبيٌ","مُقبِلٌ مِن عَرَفاتِ",34,"ت",1,1],["صادَتِ القَلبَ إِذ رَمَت","ذاتَ يَومِ المَناصِبِ",35,"ب",1,0],["صادِقَ البأسِ حميّاً أنفُه","يَمْنَعُ الحَوْضَ ويحمِي العلما",36,"م",2,0],["صادِقِ العَزمِ وَالمُروءَةِ يَهوي","كُلُّ عالي الذُرى أَمامَ ثَباتِهْ",37,"ت",2,0],["صادِقِ الإيمانِ يَخشى رَبَّهُ","وَيَرى رِضوانَهُ خَيرَ الجَزاء",38,"ا",2,0],["صادِقُ العَزمِ لا يَضيقُ لَدى الإِق","دامِ ذَرعاً وَلا يُطيقُ رُجوعا",39,"ع",2,0],["صادِقي البأسِ للقلوبِ اتّحادٌ","حِينَ تَمضي وللصُّفوفِ الْتِئَامُ",40,"م",1,0],["صادٍ حَكى شَقَّهُ ضيقاً وَريقَتَهُ","لَوناً كَذا الإِلفِ حالُ الإِلفِ تَتبَعُهُ",41,"ع",2,0],["صادحات على أرائك في الأَيْ","ك يَصِلْنَ الغدوَّ بالآصالِ",42,"ل",1,0],["صادَفَت طِلواً طَويلَ الطَوى","حافِظَ العَينِ قَليلَ السَآم",43,"م",1,0],["صادَ وَصَيفٌ أَسَداً باسِلاً","بِوَثبَةٍ مَنصورَةِ السَطوِ",44,"و",1,1],["صادَفْتُ دُرّاً مِنْ صِفاتِكَ مُثْمَناً","فأَعَرْتُهُ منِّي صفَاتِ مُنَضِّدِ",45,"د",1,0],["صادِراتٍ ذاتَ العِشاءِ عَلى الجَف","رِ سِراعاً لا بَل بَكَرنَ بُكورا",46,"ر",2,0],["صادِ ذا ضِغنٍ إِلى غِرَّتِهِ","وَإِذا دَرَّت لَبونٌ فَاِحتَلِب",47,"ب",1,0],["صادَيتُهُ عَن مُرَّ أَخلاقِهِ","بِحُلوِ أَخلاقي وَلَم أَشغَبِ",48,"ب",1,0],["صادَفَتهُ حَرجَفٌ في تَلعَةٍ","فَسَجا وَسطَ بِلاطٍ مُسبَطِر",49,"ر",1,0],["صادياً شوقاً لِصَدّا طَيْفِكُمْ","جِدَّ مُلْتَاحٍ إلى رؤيا ورَي",50,"ي",1,0],["صادِقاً في الَّذِي يَقُولُ وَإِنْ ضا","قَتْ عَلَيْهِ بِرُحْبِها الدَّهْنَاءُ",51,"ا",2,0],["صَادُوا المُسِئَ وَرَهْطَهُ","صَيْدَ البَوَاسِقِ وَالرَّخَمْ",52,"م",1,0],["صَادِقٌ فِي حِسابِهِ","دُونَ زِيغٍ وَلاَ جَنَفْ",53,"ف",1,0],["صَادِقَةَ العَهْدِ فِي مَوَاعِدِهَا","تَبْدُو وَفِيهَا تَغِيبُ عَنْ بَصَرِي",54,"ر",2,0],["صَادِقُ الْوَعْدِ صِدْقَ حُرٍّ وَلَكِنْ","قَدْ يُرَى وَهْوَ مُخْلِفُ الإِيعَادِ",55,"د",1,0],["صَادقٌ وَالزَّمَانُ غَيْرُ ذَمِيمٍ","صِدْقَهُ وَالزَّمَانُ غَيْرُ حَمِيد",56,"د",1,0],["صَادِقُ الْمِيعادِ لا يَخ","لَقُ وَشْكاً أَوْ وَئِيدا",57,"د",2,0],["صادُ اِنتَهى وَالطِوالُ تَتلو","أَكثَرها إِنَّ ذا اِختَصاصُ",58,"ص",1,0],["صادَتكَ أَشراكُها بِرَغمي","وَالأسدُ يَعتاقُها اِقتِناصُ",58,"ص",1,0],["صادَتكَ قَوسُ الرَدى بِسَهمٍ","وَدَعوَتي دونَكَ الدلاصُ",58,"ص",1,0],["صادِحَ الشَّرْقِ قَدْ سَكَتَّ طَويلاَ","وَعَزِيزٌ عَلَيْهِ أَلا تَقُولاَ",59,"ل",2,1],["صادعُ الجهل هادمُ الظلمِ في","مِصْرَ مُبيدُ القُيودِ والأَغلال",60,"ل",1,0],["صاد الكلابُ فكان صي","دُهم الحمامة والقطاه",61,"ا",2,0],["صادر همومك والاخطار كالحة","ما يلزم الوهن الا الخامل الوكل",62,"ل",1,0],["صَادِرٌ عَنْ نَدَى يَدٍ مِنْكَ لا يُنْ","صِفُها البَحرُ ومَوْجُةُ، وَعُبَابُهْ",63,"ب",2,0],["صادي الجوانح في مطلول أيكته","فما ارتوى بالندى حتّى قطفناه",64,"ا",2,0],["صادفْتَ قَشْفاً فكنتَ جلاءَهُ","ورأَيْتَ بي شَعْثاً فكنتَ الداهنا",65,"ن",2,0],[