{"poems":[[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[75,"ورامشة يشفي العليل نسيمها","https://www.aldiwan.net/poem11851.html","الطويل"],[23,"لقد لقيت قريظة ما سآها","https://www.aldiwan.net/poem21432.html","الوافر"],[23,"ما سبني العوام إلا لأنه","https://www.aldiwan.net/poem21468.html","الطويل"],[74,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[74,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[53,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[14,"أرى أم حسان الغداة تلومني","https://www.aldiwan.net/poem38289.html","الطويل"],[87,"أمير المؤمنين رأيت جسرا","https://www.aldiwan.net/poem63689.html","الوافر"],[47,"نفقت نفوق الحمار الذكر","https://www.aldiwan.net/poem63583.html","الخفيف"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[30,"يزيد أبو الخطاب أخرجه لنا","https://www.aldiwan.net/poem5037.html","الطويل"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[46,"جعلت فداك أنت من لا ندله","https://www.aldiwan.net/poem30370.html","الطويل"],[46,"نوار في صواحبها نوار","https://www.aldiwan.net/poem30523.html","الوافر"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[77,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13662","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[47,"نفقت نفوق الحمار الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=31266",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[112,"غريب وإني في العشيرة والأهل","https://www.aldiwan.net/poem16214.html","الطويل"],[123,"يرى من ستور الغيب حتى كأنما","https://www.aldiwan.net/poem49290.html","الطويل"],[131,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[153,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[172,"منال العلى بالمرهفات القواضب","https://www.aldiwan.net/poem1601.html",""],[207,"مليح القد والحدقه","https://www.aldiwan.net/poem53220.html","مجزوء الوافر"],[214,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[238,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[238,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[238,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[262,"نوافح روض الفيض بالطيب تنفح","https://www.aldiwan.net/poem35941.html","الطويل"],[273,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[285,"سقى الله ديرا فيه نادمت قسيسا","https://www.aldiwan.net/poem32728.html","الطويل"],[288,"بقصر مليكة العليا أقمنا","https://www.aldiwan.net/poem39355.html","الوافر"],[300,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[300,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[300,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[300,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[323,"حنانا أخلائي فقد شفني البعد","https://www.aldiwan.net/poem67159.html","الطويل"],[356,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[367,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[367,"وطالع من مشرق القباء","https://www.aldiwan.net/poem61019.html","الرجز"],[406,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[413,"موفق لسبيل الرشد متبع","https://www.aldiwan.net/poem67529.html","البسيط"],[460,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[460,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[463,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[516,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[577,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[577,"يجود على شح الليالي وبخلها","https://www.aldiwan.net/poem3049.html","الطويل"],[577,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[664,"","https://poetry.dctabudhabi.ae/diwan/poem/202227","الوافر"]],"verses":[["لهُ خَلفَ أَدبارِها أَزمَلٌ","مَكانَ الرَقيبِ مِنَ الياسَرينا",0,"ن",2,0],["لَهُ خُلُقٌ عَذبٌ وَخَلقٌ مُحَسَّنٌ","وَظَرفٌ كَعَرفِ الطيبِ أَو نَشوَةِ الخَمرِ",1,"ر",1,0],["لَهُ خَيلٌ مُجَنَّبَةٌ تَعادى","بِفُرسانٍ عَلَيها كَالصُقورِ",2,"ر",1,0],["لَهُ خَمرَةٌ في بَيتِهِ وَجُرَيرَةٌ","يُبَيِّعُ فيها فَهوَ نَشوانُ سالِحُ",3,"ح",1,0],["له خطىً جازت العليا وما فخرت","وأنمل كفت الدنيا وما بجحت",4,"ت",1,0],["له خالان في دينار خدٍّ","تباع له القلوب بحبتين",5,"ن",1,0],["له خُلقٌ عذبُ المذاق ولن ترى","مِزاج كؤوس الراح كالخُلُق العذبِ",6,"ب",1,0],["له خُلُقا خيرٍ ونفعٍ كلاهما","يُحاذره عاتٍ ويَرجُوه يائس",7,"س",1,0],["لَهُ خَلَّةٌ لا يَدخُلُ الحَقُّ دونَها","كَريمٌ أَصابَتهُ خُطوبٌ تُجَرِّفُ",8,"ف",1,0],["لَهُ خَشَبٌ يَجوعُ السوسُ فيهِ","وَتَمضي الفَأرُ لا تَأوي إِلَيهِ",9,"ي",2,0],["لَهُ خَلَفٌ مِثلُ غَرزِ الجَرا","دِ بَعيدونَ مِن كُلِّ أَمرٍ يَسُر",10,"ر",1,0],["لَهُ خُلُقٌ في الجودِ لا يَستَطيعُهُ","رِجالٌ يَرومونَ العُلا بِالتَخَلُّقِ",11,"ق",1,0],["لَهُ خَضَعَت قَيسٌ وَخِندَفُ كُلُّها","وَقَحطانُ طُرّاً كَهلُها وَوَليدُها",12,"د",3,0],["لَهُ خُلُجٌ تَهوي بِهِ مُتلَئِبَّةٌ","إِلى مَنهَلٍ قاوٍ جَديبِ المُعَرَّجِ",13,"ج",1,0],["لَهُ خُلُقٌ رَحبٌ وَنَفسٌ رَأَيتُها","إِذا رَزَحَت نَفسُ اللَئيمِ تُقِلُّهُ",14,"ل",2,0],["لَهُ خُلُقٌ نَهى القُرآنُ عَنهُ","وَذاكَ عَطاؤُهُ السَرَفُ البِدارُ",15,"ر",1,0],["لَهُ خُلُقٌ سَهلٌ وَنَفسٌ طِباعُها","لَيانٌ وَلَكِن عِرضُهُ مِن صَفاً صَلدِ",16,"د",1,0],["لهُ خُلُقٌ كالرّوضِ يُنْدي تبرُّعاً","إذا ما نَبا بالحُرِّ يوماً تَخَلُّقُه",17,"ق",2,0],["لَهُ خُلُجٌ تَهوي فُرادى وَتَرعَوي","إِلى كُلِّ ذي نيرَينِ بادي الشَواكِلِ",18,"ل",1,0],["لهُ خَدُّ مَيْمُونٍ وأَشْأَمُ سَاحِقٌ","فَأَيَّهُمَا مَا شِئْتُمُ فَتَعَيَّفُوا",19,"ف",3,0],["لَهُ خَطفَةٌ حَذّاءُ مِن كُلِّ ثَلَّةٍ","كَنَشطَةِ أَقنى يَنفُصُ الطَلَّ واقِعِ",20,"ع",1,0],["له خاطِرٌ لَوْ سَابَقَ البَرْقَ في الدُّجَى","لَجَلَّى عَلىَ بَرْقِ السّمواتِ خَاطِرُه",21,"ر",2,0],["له خلف مثل عرز الجرا","د بعيدون من كل مر يسر",22,"ر",1,0],["له خُلُقان من بأْسٍ وجودٍ","يسوس كليهما الرأْيُ الأَسَدُّ",23,"د",1,0],["لَهُ خُلق يَحكي النَسيم وَراحة","عَلى الشُح وَالأَمساك تَحكم بِالقَتل",24,"ل",1,0],["له خاطرٌ يقظان ليس بنائم","يجيش بأصداف اللآلي الكرائم",25,"م",1,0],["له خُلُقٌ عَذْبٌ إذا ما تغيرتْ","إذا قال كلٌّ للمقالةِ سامِعُ",26,"ع",1,0],["لَهُ خُلُقٌ عَذبٌ وَبِرٌّ وَوصلَةٌ","وَصَبرٌ عَلى جَهلِ الجَهولِ وَمُهلَةٌ",27,"ه",1,0],["لَهُ خَضَعَت غُلبُ الرِّقابِ وَأَصبَحت","بِه الأَرضُ تَزهو بَعدَ تِلكَ الغَياهِبِ",28,"ب",1,0],["له خالٌ بوجنته","يقطِّع قلبَ مَن عشِقَه",29,"ق",2,0],["له خصَلٌ ترجو الأسود نظيرها","إذا راعها خطبٌ كهجرك معضل",30,"ل",1,0],["لَهُ خَصرٌ يَجولُ الحُقبُ فيهِ","وَأَردافٌ يَضيقُ بِها الإِزارُ",31,"ر",1,0],["لَهُ خاتَمُ المَبعوثِ أَحمَدَ خاتَمٍ","النُبُوَّةِ مَوروثاً مَعَ السَيفِ وَالبُردِ",32,"د",1,0],["لَهُ خُلُقا بأسِ وَجودٍ إِذا سَقى","بِسِجليهِما لَم يُخشَ جَورٌ وَلا جَدبُ",33,"ب",1,0],["له خلوة التجريد في جلوة الصفا","وفي حلية التوحيد بالوجد يمرح",34,"ح",1,0],["له خُسِفت أرضُ الشآمِ وزَلزلت","وأوشكتِ الأجرامُ أن تَتدَهورا",35,"ر",2,0],["لَهُ خُلُقٌ يُرضي النَبِيَّ مُحَمَّداً","وَيَأتي بِما أَوصى بِهِ قَومَهُ عيسى",36,"س",2,0],["له خلق يفوق الوصف أما","أياديه فمن شبه المحال",37,"ل",1,0],["له خُلقٌ كالرَوضِ يعبقُ نشرُه","وَتفترُّ عن غرِّ السَجايا بواسِمُه",38,"م",2,0],["لَه خُلقٌ كالرَوض غبَّ بها النَدى","وكفُّ سماحٍ لا يُشام لها كفُّ",39,"ف",1,0],["له خَلائقُ لو مَرَّ النَسيمُ بها","أَغنته عَن نَفَحات الرَوضَةِ النَضِرَه",40,"ر",2,0],["له خُلقٌ لَو لامَسَ الصَخرَ لاِغتدى","أَرَقَّ من الخَنساءِ تَبكي عَلى صَخرِ",41,"ر",1,0],["لَهُ خَلقٌ كَالروحِ تُحيي الَّذي بِهِ","وَلُطفٌ وَذَوقٌ مِنهُما يَقطِرُ الشَهدُ",42,"د",1,0],["لَهُ خُلق الكَمال أَفادَ حَمداً","غَدا عَن طيب عُنصره مُبينا",43,"ن",2,0],["له خُطّةُ إقبالٍ","منَ الدّولةِ تُختَطّ",44,"ط",1,0],["له خُطاً قليلةُ الاِخطاء","حكيمةُ الإسراعِ والإبطاء",45,"ا",2,0],["له خلق كالروض باكره الحيا","فيفتر منه ضاحكاً باسم الثغر",46,"ر",1,0],["لَهُ خَلائِقُ بيضٌ لا يُغَيِّرُها","صَرفُ الزَمانِ كَما لا يَصدَأُ الذَهَبُ",47,"ب",1,0],["له خُلُقانِ من الماء ذا","كَ ملحٌ وهذا فُراتٌ نميرُ",48,"ر",1,0],["له خِصبُهُ دوني ولي نَوْطَةٌ به","وعَوْنٌ على أيّامه وهو مُجدِبُ",49,"ب",1,0],["لهُ خَصَرٌ ونسمتهُ اعْتلالٌ","إذا ما اسْتوقد الشِّعْري النهارُ",50,"ر",1,0],["لهُ خِصالٌ بخيطِ الفَجرِ لو نُظِمَتْ","لم ينتظِمْ سبَجُ الدّاجي بثانِيهِ",51,"ي",2,0],["له خَلوةٌ كلُّها تَنْقَضِي","برتْقِ الفُتُوقِ وسَدِّ الثُّلمْ",52,"م",1,0],["له خاطرٌ كالبرق ضوءاً وسُرعةً","فلو لاح أَودَى كُلُّ طرفِ بِخَطْفه",53,"ف",2,0],["له خَاطِرٌ يبدي الجواهرَ بَحرُه","وإِنْ كَان بحراً ما خَبَتْ نارُه وَقْدَا",54,"د",2,0],["له خدع يحار العقل فيها","مموهة مزخرفة بلبس",55,"س",1,0]]}