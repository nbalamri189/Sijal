لشعر أخلطه بجمري!!","https://www.poetsgate.com/ViewPoem.aspx?id=186750",""],[709,"عَرِّجْ عَلَى الْبَانِ وانْشُدْ فِي مَجَانِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2907",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[5582,"أَمِنْ دِمَنٍ مَعالِمُها قِفارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63510",""],[5582,"ثَنَتْ لِوَداعِهِ الأَعْطافَ يُسْرا","https://www.poetsgate.com/ViewPoem.aspx?id=63519",""],[5704,"يا زائرا للحيِّ٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204224",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["لهُ خَلفَ أَدبارِها أَزمَلٌ","مَكانَ الرَقيبِ مِنَ الياسَرينا",0,"ن",2,0],["لَهُ خُلُقٌ عَذبٌ وَخَلقٌ مُحَسَّنٌ","وَظَرفٌ كَعَرفِ الطيبِ أَو نَشوَةِ الخَمرِ",1,"ر",1,0],["لَهُ خَيلٌ مُجَنَّبَةٌ تَعادى","بِفُرسانٍ عَلَيها كَالصُقورِ",2,"ر",1,0],["لَهُ خَمرَةٌ في بَيتِهِ وَجُرَيرَةٌ","يُبَيِّعُ فيها فَهوَ نَشوانُ سالِحُ",3,"ح",1,0],["له خطىً جازت العليا وما فخرت","وأنمل كفت الدنيا وما بجحت",4,"ت",1,0],["له خالان في دينار خدٍّ","تباع له القلوب بحبتين",5,"ن",1,0],["له خُلقٌ عذبُ المذاق ولن ترى","مِزاج كؤوس الراح كالخُلُق العذبِ",6,"ب",1,0],["له خُلُقا خيرٍ ونفعٍ كلاهما","يُحاذره عاتٍ ويَرجُوه يائس",7,"س",1,0],["لَهُ خَلَّةٌ لا يَدخُلُ الحَقُّ دونَها","كَريمٌ أَصابَتهُ خُطوبٌ تُجَرِّفُ",8,"ف",1,0],["لَهُ خَشَبٌ يَجوعُ السوسُ فيهِ","وَتَمضي الفَأرُ لا تَأوي إِلَيهِ",9,"ي",2,0],["لَهُ خَلَفٌ مِثلُ غَرزِ الجَرا","دِ بَعيدونَ مِن كُلِّ أَمرٍ يَسُر",10,"ر",1,0],["لَهُ خُلُقٌ في الجودِ لا يَستَطيعُهُ","رِجالٌ يَرومونَ العُلا بِالتَخَلُّقِ",11,"ق",1,0],["لَهُ خَضَعَت قَيسٌ وَخِندَفُ كُلُّها","وَقَحطانُ طُرّاً كَهلُها وَوَليدُها",12,"د",3,0],["لَهُ خُلُجٌ تَهوي بِهِ مُتلَئِبَّةٌ","إِلى مَنهَلٍ قاوٍ جَديبِ المُعَرَّجِ",13,"ج",1,0],["لَهُ خُلُقٌ رَحبٌ وَنَفسٌ رَأَيتُها","إِذا رَزَحَت نَفسُ اللَئيمِ تُقِلُّهُ",14,"ل",2,0],["لَهُ خُلُقٌ نَهى القُرآنُ عَنهُ","وَذاكَ عَطاؤُهُ السَرَفُ البِدارُ",15,"ر",1,0],["لَهُ خُلُقٌ سَهلٌ وَنَفسٌ طِباعُها","لَيانٌ وَلَكِن عِرضُهُ مِن صَفاً صَلدِ",16,"د",1,0],["لهُ خُلُقٌ كالرّوضِ يُنْدي تبرُّعاً","إذا ما نَبا بالحُرِّ يوماً تَخَلُّقُه",17,"ق",2,0],["لَهُ خُلُجٌ تَهوي فُرادى وَتَرعَوي","إِلى كُلِّ ذي نيرَينِ بادي الشَواكِلِ",18,"ل",1,0],["لهُ خَدُّ مَيْمُونٍ وأَشْأَمُ سَاحِقٌ","فَأَيَّهُمَا مَا شِئْتُمُ فَتَعَيَّفُوا",19,"ف",3,0],["لَهُ خَطفَةٌ حَذّاءُ مِن كُلِّ ثَلَّةٍ","كَنَشطَةِ أَقنى يَنفُصُ الطَلَّ واقِعِ",20,"ع",1,0],["له خاطِرٌ لَوْ سَابَقَ البَرْقَ في الدُّجَى","لَجَلَّى عَلىَ بَرْقِ السّمواتِ خَاطِرُه",21,"ر",2,0],["له خلف مثل عرز الجرا","د بعيدون من كل مر يسر",22,"ر",1,0],["له خُلُقان من بأْسٍ وجودٍ","يسوس كليهما الرأْيُ الأَسَدُّ",23,"د",1,0],["لَهُ خُلق يَحكي النَسيم وَراحة","عَلى الشُح وَالأَمساك تَحكم بِالقَتل",24,"ل",1,0],["له خاطرٌ يقظان ليس بنائم","يجيش بأصداف اللآلي الكرائم",25,"م",1,0],["له خُلُقٌ عَذْبٌ إذا ما تغيرتْ","إذا قال كلٌّ للمقالةِ سامِعُ",26,"ع",1,0],["لَهُ خُلُقٌ عَذبٌ وَبِرٌّ وَوصلَةٌ","وَصَبرٌ عَلى جَهلِ الجَهولِ وَمُهلَةٌ",27,"ه",1,0],["لَهُ خَضَعَت غُلبُ الرِّقابِ وَأَصبَحت","بِه الأَرضُ تَزهو بَعدَ تِلكَ الغَياهِبِ",28,"ب",1,0],["له خالٌ بوجنته","يقطِّع قلبَ مَن عشِقَه",29,"ق",2,0],["له خصَلٌ ترجو الأسود نظيرها","إذا راعها خطبٌ كهجرك معضل",30,"ل",1,0],["لَهُ خَصرٌ يَجولُ الحُقبُ فيهِ","وَأَردافٌ يَضيقُ بِها الإِزارُ",31,"ر",1,0],["لَهُ خاتَمُ المَبعوثِ أَحمَدَ خاتَمٍ","النُبُوَّةِ مَوروثاً مَعَ السَيفِ وَالبُردِ",32,"د",1,0],["لَهُ خُلُقا بأسِ وَجودٍ إِذا سَقى","بِسِجليهِما لَم يُخشَ جَورٌ وَلا جَدبُ",33,"ب",1,0],["له خلوة التجريد في جلوة الصفا","وفي حلية التوحيد بالوجد يمرح",34,"ح",1,0],["له خُسِفت أرضُ الشآمِ وزَلزلت","وأوشكتِ الأجرامُ أن تَتدَهورا",35,"ر",2,0],["لَهُ خُلُقٌ يُرضي النَبِيَّ مُحَمَّداً","وَيَأتي بِما أَوصى بِهِ قَومَهُ عيسى",36,"س",2,0],["له خلق يفوق الوصف أما","أياديه فمن شبه المحال",37,"ل",1,0],["له خُلقٌ كالرَوضِ يعبقُ نشرُه","وَتفترُّ عن غرِّ السَجايا بواسِمُه",38,"م",2,0],["لَه خُلقٌ كالرَوض غبَّ بها النَدى","وكفُّ سماحٍ لا يُشام لها كفُّ",39,"ف",1,0],["له خَلائقُ لو مَرَّ النَسيمُ بها","أَغنته عَن نَفَحات الرَوضَةِ النَضِرَه",40,"ر",2,0],["له خُلقٌ لَو لامَسَ الصَخرَ لاِغتدى","أَرَقَّ من الخَنساءِ تَبكي عَلى صَخرِ",41,"ر",1,0],["لَهُ خَلقٌ كَالروحِ تُحيي الَّذي بِهِ","وَلُطفٌ وَذَوقٌ مِنهُما يَقطِرُ الشَهدُ",42,"د",1,0],["لَهُ خُلق الكَمال أَفادَ حَمداً","غَدا عَن طيب عُنصره مُبينا",43,"ن",2,0],["له خُطّةُ إقبالٍ","منَ الدّولةِ تُختَطّ",44,"ط",1,0],["له خُطاً قليلةُ الاِخطاء","حكيمةُ الإسراعِ والإبطاء",45,"ا",2,0],["له خلق كالروض باكره الحيا","فيفتر منه ضاحكاً باسم الثغر",46,"ر",1,0],["لَهُ خَلائِقُ بيضٌ لا يُغَيِّرُها","صَرفُ الزَمانِ كَما لا يَصدَأُ الذَهَبُ",47,"ب",1,0],["له خُلُقانِ من الماء ذا","كَ ملحٌ وهذا فُراتٌ نميرُ",48,"ر",1,0],["له خِصبُهُ دوني ولي نَوْطَةٌ به","وعَوْنٌ على أيّامه وهو مُجدِبُ",49,"ب",1,0],["لهُ خَصَرٌ ونسمتهُ اعْتلالٌ","إذا ما اسْتوقد الشِّعْري النهارُ",50,"ر",1,0],["لهُ خِصالٌ بخيطِ الفَجرِ لو نُظِمَتْ","لم ينتظِمْ سبَجُ الدّاجي بثانِيهِ",51,"ي",2,0],["له خَلوةٌ كلُّها تَنْقَضِي","برتْقِ الفُتُوقِ وسَدِّ الثُّلمْ",52,"م",1,0],["له خاطرٌ كالبرق ضوءاً وسُرعةً","فلو لاح أَودَى كُلُّ طرفِ بِخَطْفه",53,"ف",2,0],["له خَاطِرٌ يبدي الجواهرَ بَحرُه","وإِنْ كَان بحراً ما خَبَتْ نارُه وَقْدَا",54,"د",2,0],["لَهُ خَلقٌ سَهلٌ وَنَفسٌ أَبِيَّةٌ","وَحَسُنَ خِلالَ دَونِها الرَوضُ مِمرَعا",55,"ع",2,0],["له خُلُقٌ عذبٌ ولا شكَّ انه","إذا ما طغى طاغٍ له خلُقٌ مِلح",56,"ح",1,0],["له خلفاء في الخلاف تخلفوا","وأوفاق وفق خلف كل خليفة",57,"ه",1,0],["له خُلقٌ يحكى النسمَ لطافةَ","يمر على طيبٍ من المسك نافح",58,"ح",1,0],["له خضَعتْ صيدُ الملوكِ مخافةً","وصار لديه كلُّ مسْتصْعبٍ سهلا",59,"ل",2,0],["له خلق لم يخلق مثله","طَوَائِفُ أهْلِ الشِّرْكِ قَدْ أَذْعَنَتْ لَهْ",60,"ه",1,0],["له خطب يقوم بعد قوم","وصولة يقظة ومراغ نوم",61,"م",1,0],["لهُ خلق يحار لديه فكري","وعفو فيه للجاني عِقابُ",62,"ب",1,0],["له خجول المعالي","والمجد والأوضاحُ",63,"ح",1,0],["له خدا يري الورد غضا","جنيّاً لودنا من كف جاني",64,"ن",2,0],["له خلق كروض الحزن راضت","نواحيه أهاضيب الرهامِ",65,"م",1,0],["له خال يبي له فؤادي","من الوجد المبرح غير خالي",66,"ل",2,0],["له خلقٌ لنائلهِ يحاكي","رِياض الجرنِ إِبهاجاً ونشرا",67,"ر",2,0],["له خفة الفكر فهو بكل","مكانٍ من الأرض عينٌ ترى",68,"ر",2,0],["له خدع يحار العقل فيها","مموهة مزخرفة بلبس",69,"س",1,0],["لهُ خِلالُ بالسَّعْدِ مُشْرِقَةٌ","أَحْلَى مِنَ الماءِ عِنْدَ ذي الشَّرَقِ",70,"ق",1,0],["له خير خلق حبذا من رأى له","له حسن خلق دونه نسه السحي",71,"ي",1,0],["له خلال من التقوى وعترته","على محجته ساروا رقوا قننا",72,"ن",2,0],["له خلق علا فازداد نورا","على نور له حسن ابتسام",73,"م",1,0],["له خلقة قد جمل اللَه كلها","وأجمل اخلاق سمت كل من عدا",74,"د",2,0],["له خفض الجناح وشرح صدر","له كل الكمال وخير معلم",75,"م",1,0],["لَهُ خُلُقٌ يَحكي النَسيمَ لطافةً","بِنَفسِيَ ممّا يشتَكيهِ أُفدِّيهِ",76,"ي",2,0],["له خلص الثناءُ على مجيدٍ","به وجد السبيلُ إلى الخلاص",77,"ص",1,0],["له خوارق عادات يضن بها","ليست كدرهمه المعطى وديناره",78,"ر",2,0],["له خيل الى الهيجا جماح","وللاعدا عن الحرب انكساح",79,"ح",1,0],["له خيل الى الهجاء ورجل","لها ورد الدما أبدا مباح",79,"ح",1,0],["له خَلَوَاتٌ بالنفوسِ وإن جَنَتْ","عليها الليالي والتقى دونه الحَفْل",80,"ل",1,0],["له خلق أزهى من الروض ضاحكا","وفهم لسحنون يلى هو أفهم",81,"م",1,0],["له خلقان فأدناهما","لذيذ المذاقة والمطعم",82,"م",1,0],["له خُلُقٌ كنشرِ الرّوضِ غضّا","لطَافتُه تَلينُ لها الصّخُورُ",83,"ر",1,0],["له خلق خلق الجانبين","وطبعٌ به طبع الأغبياء",84,"ا",2,0],["له خط بلا قلم ونطّ","بلا قدم وبسط وانطواء",85,"ا",2,0],["له خُلُقٌ أضْوا من الشمسِ في الضحى","وأنور للساري من البدر فى الجُنْحِ",86,"ح",1,0],["له خيلٌ إِذا شِمْنَ ال","عِدَى طيرٌ أبابيلُ",87,"ل",1,0],["لَهُ خِدمَةٌ تَشفي النُفوسَ كَما شَفى","غَليلَ الصَدى عَذبٌ مِنَ الماءِ بارِدُ",88,"د",1,0],["لَهُ خُلُقٌ في المَحلِ غَيثٌ وَفي الصَّبا","نَسيمٌ وَفي جُنحِ الدُّجا غُرَّةُ الفَجرِ",89,"ر",1,0],["له خضعت أبناء كل فضيلة","قصوراً وردت نكصاً عن معاليه",90,"ي",2,0],["له خِدمتي ما دمتُ حيّاً، فإنْ أمُتْ","فخُطّوا على قَبري لمن أعتقَ الوَلا",91,"ل",2,0],["له خُلُقٌ كَالماءِ لُطفاً شَرابُهُ","غَدا سائِغاً لِلوارِدِ المُتَرَشِّفِ",92,"ف",1,0],["له خلق مثل قطر الندى","ورأي يصدع صم الصفا",93,"ف",2,0],["له خالٌ حكى حسنا ولونا","سواد العين أو حبّ القلوب"