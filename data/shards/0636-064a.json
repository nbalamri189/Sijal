{"poems":[[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[73,"أشمت بي فيك العدا","https://www.aldiwan.net/poem11893.html","مجزوء الكامل"],[54,"يا تارك البيت على الضيف","https://www.aldiwan.net/poem27523.html","السريع"],[54,"أهلا وسهلا بالمشيب","https://www.aldiwan.net/poem27622.html","الكامل"],[72,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[72,"ضيعتكم قد أشبهت ليلتي","https://www.aldiwan.net/poem18518.html","السريع"],[51,"حجر الرجل وجهه","https://www.aldiwan.net/poem62976.html","مجزوء الخفيف"],[51,"إن كفيك لقفل","https://www.aldiwan.net/poem64924.html","مجزوء الرمل"],[51,"قصرت شنطف وقلت وذلت","https://www.aldiwan.net/poem65894.html","الطويل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"من عذيري من الخلائف حلوا","https://www.aldiwan.net/poem66066.html","الخفيف"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[70,"نزل المشيب وإنه","https://www.aldiwan.net/poem42732.html","مجزوء الكامل"],[70,"دعوا الوشاة وما قالوا وما نقلوا","https://www.aldiwan.net/poem42743.html","البسيط"],[92,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[78,"وشمعة تنفي ظلام الدجى","https://www.aldiwan.net/poem14055.html","السريع"],[89,"أبكي ومثلي بالبكاء حقيق","https://www.aldiwan.net/poem44893.html","الكامل"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"هذه أول خطوه","https://www.aldiwan.net/poem8064.html","مجزوء الرمل"],[85,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[62,"ضيف سرى والليل ينفض صبغه","https://www.aldiwan.net/poem52365.html","الكامل"],[45,"أترى حمولة لا يحمل نفسه","https://www.aldiwan.net/poem63463.html","الكامل"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[45,"ملنا أم نبا بنا أم جفانا","https://www.aldiwan.net/poem66784.html","الخفيف"],[28,"ضيع أمري الأقعسان فأصبحا","https://www.aldiwan.net/poem1261.html",""],[28,"ضيع أولاد الجعيدة مالك","https://www.aldiwan.net/poem5069.html","البسيط"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[58,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[49,"جدوا فإن الأمر جد","https://www.aldiwan.net/poem62047.html","مجزوء الكامل"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[97,"حان الشفاء فودع الألما","https://www.aldiwan.net/poem24997.html","أحذ الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"وأخ أملى عليه اختلاط ال","https://www.aldiwan.net/poem29717.html","الخفيف"],[44,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"مت لتحيا ولا تردها حياة","https://www.aldiwan.net/poem43410.html","الخفيف"],[105,"رفيدة علمي الناس الحنانا","https://www.aldiwan.net/poem44070.html","الوافر"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[50,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[46,"أدنياي اذهبي وسواي أمي","https://www.aldiwan.net/poem23401.html","الوافر"],[46,"ما رقش الخط في درج ولا صحف","https://www.aldiwan.net/poem23523.html","البسيط"],[46,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21004","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"أتَرَى حَمولَةَ لا يُحَمّلُ نَفسَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32869",""],[17,"نطفة ما منيتُ يومَ منيتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19172&r=&rc=5",""],[20,"تضيف الحزن فانجابت عقيقته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70021&r=&rc=43",""]],"verses":[["ضَيغَماً يَخبِطُ السُروبَ طَروباً","كُلَّما مَرَّ بِالعَقيرَةِ كَرّا",0,"ر",2,0],["ضَيَّعتِ عَهدَ مَحَبَّةٍ","كَالوَردِ سامَرَهُ النَدى",1,"د",2,0],["ضَيفُكَ قَد جاءَ بِزادٍ لَهُ","فَاِرجِع فَكُن ضَيفاً عَلى الضَيفِ",2,"ف",1,0],["ضَيفٌ أَحَلَّ بي النُهى فَقَرَيتُهُ","رَفضَ الغَوايَةِ وَاِقتِصادَ المَنهَجِ",3,"ج",1,0],["ضيقِ العينِ إن رنا واسْتمحنا","وعناء تسمح البخلاء",4,"ا",2,0],["ضيعتكم قد أشبهت ليلتي","مخوفةً مسوَدَّةً كالحه",5,"ه",1,1],["ضيّق اللَّه عينه","حسْب توسيع جُحرهِ",6,"ر",2,0],["ضيِّق الصدر بخيلٍ","ضيَّقَ اللَهُ معاشه",7,"ش",2,0],["ضُيِّقتْ عينُها ووُسِّع فُوها","ومشقُّ استِها وثَقبُ المبال",8,"ل",1,0],["ضئيلُ شأنٍ أصابَ عارِفةً","ففخَّمتْ كِبرهُ وما فخما",9,"م",2,0],["ضيّعوا حُرمة الخلافة جهلاً","ورعوا حرمة العظام الرميمِ",10,"م",1,0],["ضئيلٌ شأنُهُ شأنٌ نبيلٌ","يَطُوعُ لأمره الجيشُ اللُّهامُ",11,"م",1,0],["ضِيمَ أَحرارُنا وَريعَ حِمانا","وَسَكَتنا وَالصَمتُ لِلجُبَناءِ",12,"ا",2,0],["ضَيَّعتُ عِندَ الواعِظينَ سَعادَتي","وَوَجَدتُها في واعِظٍ لَم يَنطُقِ",13,"ق",1,0],["ضَيفٌ أَخَفَّ عَلى الهَواءِ مِنَ الهَوا","لَكِنَّهُ في الأَرضِ مِنها أَثقَلُ",14,"ل",1,0],["ضَيفَ سالونيكَ ما لَكَ في","سِجنَها ضَيفٌ سِوى السَأَمِ",15,"م",1,0],["ضيمَ في أَحرارِهِ وَاِهتُضِما","وَوَقَفتُمُ مِن بَعيدٍ تَنظُرون",16,"ن",1,0],["ضَيَّعتَ ذا الزَمَن الطَوي","لَ وَلَم تَفُز مِنهُ بِطائِل",17,"ل",1,0],["ضَيَّعتَ عُمرَكَ فَاِحزَن إِن فَطِنتَ لَهُ","فَالعُمرُ لا عِوَضٌ عَنهُ وَلا بَدَلُ",18,"ل",1,0],["ضَيَّعَ الدَّهْرُ مَجْدَ شَعْبي ولكِنْ","سَتَرُدُّ الحَيَاةُ يوماً وِشَاحَهْ",19,"ح",2,0],["ضياؤُها لا شَكَّ مِن وَجهِهِ","وَحَرُّها مِن حَرّ أَنفاسي",20,"س",2,0],["ضيم العراق فهل قضت ابناؤه","ام هل لابناء العراق عقوق",21,"ق",1,0],["ضيفا على البلد الكريم وطالما","هتف النزيل به وغنى الجار",22,"ر",1,0],["ضَيَّعَ الكُلُّ حَيائي","وَعَفافي وَالمُرُوَّه",23,"و",2,0],["ضِياءٌ لِلعُيونِ تَلا ضِياءً","يَفيضُ مَيامِناً وَهُدىً عَميما",24,"م",2,0],["ضَيَّعَت قَيصَرَ البَرِيَّةِ أُنثى","يا لَرَبّي مِمّا تَجُرُّ النِساءُ",25,"ا",2,0],["ضَيفٌ أَلَمَّ بِرَأسي غَيرَ مُحتَشِمِ","وَالسَيفُ أَحسَنُ فِعلاً مِنهُ بِاللِمَمِ",26,"م",1,1],["ضَيفٌ سَرى والليلُ ينفُض صِبْغَهُ","فوق الجَنوبِ بجُنْحِه الفَضْفَاضِ",27,"ض",1,1],["ضَيَّعتَ مِنّي خُلَّةً في حِفظِها","كَبتُ العَدُوِّ وَرَغمُ أَنفِ الحاسِدِ",28,"د",1,0],["ضَيفٌ لَهُم يَقري الضُيوفَ وَنازِلٌ","مُتَكَفِّلٌ عَنهُم بِبِرِّ النُزَّلِ",29,"ل",1,0],["ضَيِّقَ العُذرَ في الضَراعَةِ أَنّا","لَو قَنِعنا بِقِسمِنا لَكَفانا",30,"ن",2,0],["ضَيَّعَ أَمري الأَقعَسانِ فَأَصبَحا","عَلى نَدِبٍ يَدمى مِنَ الشَرِّ غارِبُه",31,"ب",2,1],["ضَيَّعَ أَولادَ الجُعَيدَةِ مالِكٌ","خَناطيلَ مِنها رازِمٌ وَحَسيرُ",32,"ر",1,1],["ضَيفٌ بِعَينِ أَباغٍ لا يَزالُ لَهُ","لَحمٌ لِمُغتَصِبٍ لِلقَومِ غَرثانا",33,"ن",2,0],["ضَيفٌ أَلَمَّ إِلَيكَ لَم تَحفَل بِهِ","فَتَرى لَهُ أَسَفاً وَدَمعاً يَسكُبُ",34,"ب",1,0],["ضَيَّعتُ ما لا بُدَّ لي","مِنهُ بِما لِيَ مِنهُ بُدُّ",35,"د",1,0],["ضَيَّعتَ بَعضَ العُمرِ مُشتَغِلاً","أَفَلا خَلَفتَ العَيشَ بِالبَعضِ",36,"ض",1,0],["ضَيَّع كُنوزَ المُلكِ وَاِبقِ لَنا","راحاً إِلى راحاتِها تُفضي",36,"ي",1,0],["ضيف من السلوان حل بنا","حدب اليدين مبارك قدما",37,"م",2,0],["ضيفٌ أتَاكَ به لتعرفَ حَقّهُ","فَلُكٌ بقدرةِ ربّهِ دَوّارُ",38,"ر",1,0],["ضِئضِئي مِن بَني عَدِيِّ بنِ عَمرٍو","غَيرَ أَنّي في مِثلِها مِن ثَقيفِ",39,"ف",1,0],["ضَيفاً وَلَكِن لا أَقولُ لَهُ","أَهلاً بِمَثواهُ وَلا رَحبا",40,"ب",2,0],["ضَيَّعتَ ما حَفِظَ الحُماةُ فَلَم يَضِع","وَهَدَمتَ ما رَفَعَ البُناةُ فَطالا",41,"ل",2,0],["ضَيعَةُ النَفسِ في اِحتِفاظِكَ بِالنَف","سِ وَعارٌ عَلى الفَتى أَن يَضيعا",42,"ع",2,0],["ضُيوفُ اللَّهِ عِندَكِ في مَحَلٍّ","تُذكِّرُنا مَحاسِنُه الجِنانا",43,"ن",2,0],["ضَيِّقُ الصَدرِ بِالأَمانَةِ لايُف","جِعُ فَقري أَمانَتي ما بَقيتُ",44,"ت",1,0],["ضَيَّعَ الحَزْمَ وفيه شباب","وأتى مُعْتَذِراً حِينَ شابا",45,"ب",2,0],["ضيِاءُ مظُلمةِ الأيّامِ داجِيَةٍ","وغيْثُ مُمْحِلَةِ الأكنافِ جارود",46,"د",1,0],["ضيقها والرَحب من منكحِها","أحرزت والدهر في كفّ الخنَن",47,"ن",1,0],["ضَيفٌ إِذا ما اِنتَظَرتُ جَيئَتَهُ","يَوماً فُواقاً أَقامَ كَالوَتِدِ",48,"د",1,0],["ضَيِّقُ المَسكِ وَلَو أَحمَيتَهُ","لَم يَذُب جوداً وَلَكِن جَمَدا",49,"د",2,0],["ضَيعَةُ النَفسِ وَاِدِّلاجٌ عَلى القَص","دِ وَما خَيرُ مُدلِجٍ غَيرِ هادِ",50,"د",1,0],["ضَيَّعَ حَرثي رَجُلٌ هالِكٌ","موقاً وَنِعمَ الحَرثُ وَالحارِثُ",51,"ث",1,0],["ضِياءٌ لَم يَبِن لِعُيونِ كُمهٍ","وَقَولٌ ضاعَ في آذانِ صُمِّ",52,"م",1,0],["ضَيفانِ لِلدَهرِ ميلادٌ وَمُختَرَمٌ","وَنَحنُ بَينَهُما أَشباهُ ضيفانِ",53,"ن",1,0],["ضُيوفٌ ما قَراها اللَهُ عَفواً","وَلَكِن مِن نَوائِبِها قَراها",54,"ا",3,0],["ضَيفٌ بَغيضٌ لا أَرَى لي عُصرَةً","مِنهُ هَرَبتُ فَلم أَجِد لي مَهرَبَا",55,"ب",2,0],["ضِيَافَةُ يُوسُفِ لُطْفاً","وَظَرْفاً مِنْ مُنَى الْعُمْرِ",56,"ر",1,0],["ضَيْغمٌ مِنْ سَوْرَةِ الحُمَّى وَمِنْ","ثوْرَةِ الحَمْيِ بِهِ يَزْأَرُ زَأْرَا",57,"ر",2,0],["ضَيَّعَ لا كانَ فيكَ حَقّي","وَغَرَّهُ جِسمُهُ العَريضُ",58,"ض",1,0],["ضيفٌ ألمَّ بها؛ فأصبح ربَّها","ثم استباحَ كرامةَ المِضْياف",59,"ف",1,0],["ضيَّقوا رقعة البسيطة حتى","لم يعد يشتكي بنوها اغترابا",60,"ب",2,0],["ضيَّعها نجليَ الصغيرُ، وكم","حمَّلني من خسارةِ ولَدي",61,"د",2,0],["ضيع القلب، واستحال جذوعاً","ترتدي آدميةً مستعاره",62,"ر",2,0],["ضيفَ العراق نعمتَ من خيراتهِ","وحَمِدْتَ فيه قرارةً وهجوعا",63,"ع",2,0],["ضيفٌ على رِمَمٍ شتَّى طبائعُها","ما كانَ يجمعُها حالٌ وإياه",64,"ا",2,0],["ضيَّقت مُلتقى نهودكِ","والكشْحَين منه وشمرَّت أردانه",65,"ن",2,0],["ضَيّعْتُ منّي خِلّةً في حِفْظِهَا،","كنتُ العدُوّ وَرُغْمَ أنفِ الحاسدِ",66,"د",1,0],["ضيقُ الصدرِ بالأمانة ٍ لا","قُصُ فَقْرِي أمَانَتِي ما بَقِيتُ",67,"ت",1,0],["ضَيِفَ الحُزنَ فَاِنجابَت عَقيقَتُهُ","فيها خِناذٌ وَتَقريبٌ بِلا تِيَمِ",68,"م",1,1]]}