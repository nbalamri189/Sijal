ابك أيها البستاني","https://www.aldiwan.net/poem61801.html","الكامل"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[461,"يبذل المال فان حل به","https://www.aldiwan.net/poem15666.html","الرمل"],[464,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[464,"يا سادة كنت أرجو","https://www.aldiwan.net/poem3544.html","عموديه"],[477,"كم يذهب هذا العمر في الخسران","https://www.aldiwan.net/poem15365.html","الدوبيت"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[514,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[538,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[538,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[544,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[544,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[551,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[562,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"],[567,"بالحرص في الرزق يذل الفتى","https://www.aldiwan.net/poem69739.html","الرجز"],[575,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"]],"verses":[["ضَيغَماً يَخبِطُ السُروبَ طَروباً","كُلَّما مَرَّ بِالعَقيرَةِ كَرّا",0,"ر",2,0],["ضَيَّعتِ عَهدَ مَحَبَّةٍ","كَالوَردِ سامَرَهُ النَدى",1,"د",2,0],["ضَيفُكَ قَد جاءَ بِزادٍ لَهُ","فَاِرجِع فَكُن ضَيفاً عَلى الضَيفِ",2,"ف",1,0],["ضَيفٌ أَحَلَّ بي النُهى فَقَرَيتُهُ","رَفضَ الغَوايَةِ وَاِقتِصادَ المَنهَجِ",3,"ج",1,0],["ضيقِ العينِ إن رنا واسْتمحنا","وعناء تسمح البخلاء",4,"ا",2,0],["ضيعتكم قد أشبهت ليلتي","مخوفةً مسوَدَّةً كالحه",5,"ه",1,1],["ضيّق اللَّه عينه","حسْب توسيع جُحرهِ",6,"ر",2,0],["ضيِّق الصدر بخيلٍ","ضيَّقَ اللَهُ معاشه",7,"ش",2,0],["ضُيِّقتْ عينُها ووُسِّع فُوها","ومشقُّ استِها وثَقبُ المبال",8,"ل",1,0],["ضئيلُ شأنٍ أصابَ عارِفةً","ففخَّمتْ كِبرهُ وما فخما",9,"م",2,0],["ضيّعوا حُرمة الخلافة جهلاً","ورعوا حرمة العظام الرميمِ",10,"م",1,0],["ضئيلٌ شأنُهُ شأنٌ نبيلٌ","يَطُوعُ لأمره الجيشُ اللُّهامُ",11,"م",1,0],["ضِيمَ أَحرارُنا وَريعَ حِمانا","وَسَكَتنا وَالصَمتُ لِلجُبَناءِ",12,"ا",2,0],["ضَيَّعتُ عِندَ الواعِظينَ سَعادَتي","وَوَجَدتُها في واعِظٍ لَم يَنطُقِ",13,"ق",1,0],["ضَيفٌ أَخَفَّ عَلى الهَواءِ مِنَ الهَوا","لَكِنَّهُ في الأَرضِ مِنها أَثقَلُ",14,"ل",1,0],["ضَيفَ سالونيكَ ما لَكَ في","سِجنَها ضَيفٌ سِوى السَأَمِ",15,"م",1,0],["ضيمَ في أَحرارِهِ وَاِهتُضِما","وَوَقَفتُمُ مِن بَعيدٍ تَنظُرون",16,"ن",1,0],["ضَيَّعتَ ذا الزَمَن الطَوي","لَ وَلَم تَفُز مِنهُ بِطائِل",17,"ل",1,0],["ضَيَّعتَ عُمرَكَ فَاِحزَن إِن فَطِنتَ لَهُ","فَالعُمرُ لا عِوَضٌ عَنهُ وَلا بَدَلُ",18,"ل",1,0],["ضَيَّعَ الدَّهْرُ مَجْدَ شَعْبي ولكِنْ","سَتَرُدُّ الحَيَاةُ يوماً وِشَاحَهْ",19,"ح",2,0],["ضياؤُها لا شَكَّ مِن وَجهِهِ","وَحَرُّها مِن حَرّ أَنفاسي",20,"س",2,0],["ضيم العراق فهل قضت ابناؤه","ام هل لابناء العراق عقوق",21,"ق",1,0],["ضيفا على البلد الكريم وطالما","هتف النزيل به وغنى الجار",22,"ر",1,0],["ضَيَّعَ الكُلُّ حَيائي","وَعَفافي وَالمُرُوَّه",23,"و",2,0],["ضِياءٌ لِلعُيونِ تَلا ضِياءً","يَفيضُ مَيامِناً وَهُدىً عَميما",24,"م",2,0],["ضَيَّعَت قَيصَرَ البَرِيَّةِ أُنثى","يا لَرَبّي مِمّا تَجُرُّ النِساءُ",25,"ا",2,0],["ضَيفٌ أَلَمَّ بِرَأسي غَيرَ مُحتَشِمِ","وَالسَيفُ أَحسَنُ فِعلاً مِنهُ بِاللِمَمِ",26,"م",1,1],["ضَيفٌ سَرى والليلُ ينفُض صِبْغَهُ","فوق الجَنوبِ بجُنْحِه الفَضْفَاضِ",27,"ض",1,1],["ضَيَّعتَ مِنّي خُلَّةً في حِفظِها","كَبتُ العَدُوِّ وَرَغمُ أَنفِ الحاسِدِ",28,"د",1,0],["ضَيفٌ لَهُم يَقري الضُيوفَ وَنازِلٌ","مُتَكَفِّلٌ عَنهُم بِبِرِّ النُزَّلِ",29,"ل",1,0],["ضَيِّقَ العُذرَ في الضَراعَةِ أَنّا","لَو قَنِعنا بِقِسمِنا لَكَفانا",30,"ن",2,0],["ضَيَّعَ أَمري الأَقعَسانِ فَأَصبَحا","عَلى نَدِبٍ يَدمى مِنَ الشَرِّ غارِبُه",31,"ب",2,1],["ضَيَّعَ أَولادَ الجُعَيدَةِ مالِكٌ","خَناطيلَ مِنها رازِمٌ وَحَسيرُ",32,"ر",1,1],["ضَيفٌ بِعَينِ أَباغٍ لا يَزالُ لَهُ","لَحمٌ لِمُغتَصِبٍ لِلقَومِ غَرثانا",33,"ن",2,0],["ضَيفٌ أَلَمَّ إِلَيكَ لَم تَحفَل بِهِ","فَتَرى لَهُ أَسَفاً وَدَمعاً يَسكُبُ",34,"ب",1,0],["ضَيَّعتُ ما لا بُدَّ لي","مِنهُ بِما لِيَ مِنهُ بُدُّ",35,"د",1,0],["ضَيَّعتَ بَعضَ العُمرِ مُشتَغِلاً","أَفَلا خَلَفتَ العَيشَ بِالبَعضِ",36,"ض",1,0],["ضَيَّع كُنوزَ المُلكِ وَاِبقِ لَنا","راحاً إِلى راحاتِها تُفضي",36,"ي",1,0],["ضيف من السلوان حل بنا","حدب اليدين مبارك قدما",37,"م",2,0],["ضَيْفَاً لَدَى الله لاقى عند سدرته","قِرىً فَضَاقَ بِمَا أَمْسَى لَدَيْهِ لَدَى",38,"د",2,0],["ضيفٌ أتَاكَ به لتعرفَ حَقّهُ","فَلُكٌ بقدرةِ ربّهِ دَوّارُ",39,"ر",1,0],["ضِئضِئي مِن بَني عَدِيِّ بنِ عَمرٍو","غَيرَ أَنّي في مِثلِها مِن ثَقيفِ",40,"ف",1,0],["ضَيفاً وَلَكِن لا أَقولُ لَهُ","أَهلاً بِمَثواهُ وَلا رَحبا",41,"ب",2,0],["ضَيَّعتَ ما حَفِظَ الحُماةُ فَلَم يَضِع","وَهَدَمتَ ما رَفَعَ البُناةُ فَطالا",42,"ل",2,0],["ضَيعَةُ النَفسِ في اِحتِفاظِكَ بِالنَف","سِ وَعارٌ عَلى الفَتى أَن يَضيعا",43,"ع",2,0],["ضُيوفُ اللَّهِ عِندَكِ في مَحَلٍّ","تُذكِّرُنا مَحاسِنُه الجِنانا",44,"ن",2,0],["ضَيِّقُ الصَدرِ بِالأَمانَةِ لايُف","جِعُ فَقري أَمانَتي ما بَقيتُ",45,"ت",1,0],["ضَيَّعَ الحَزْمَ وفيه شباب","وأتى مُعْتَذِراً حِينَ شابا",46,"ب",2,0],["ضيِاءُ مظُلمةِ الأيّامِ داجِيَةٍ","وغيْثُ مُمْحِلَةِ الأكنافِ جارود",47,"د",1,0],["ضيقها والرَحب من منكحِها","أحرزت والدهر في كفّ الخنَن",48,"ن",1,0],["ضَيفٌ إِذا ما اِنتَظَرتُ جَيئَتَهُ","يَوماً فُواقاً أَقامَ كَالوَتِدِ",49,"د",1,0],["ضَيِّقُ المَسكِ وَلَو أَحمَيتَهُ","لَم يَذُب جوداً وَلَكِن جَمَدا",50,"د",2,0],["ضَيعَةُ النَفسِ وَاِدِّلاجٌ عَلى القَص","دِ وَما خَيرُ مُدلِجٍ غَيرِ هادِ",51,"د",1,0],["ضَيَّعَ حَرثي رَجُلٌ هالِكٌ","موقاً وَنِعمَ الحَرثُ وَالحارِثُ",52,"ث",1,0],["ضِياءٌ لَم يَبِن لِعُيونِ كُمهٍ","وَقَولٌ ضاعَ في آذانِ صُمِّ",53,"م",1,0],["ضَيفانِ لِلدَهرِ ميلادٌ وَمُختَرَمٌ","وَنَحنُ بَينَهُما أَشباهُ ضيفانِ",54,"ن",1,0],["ضُيوفٌ ما قَراها اللَهُ عَفواً","وَلَكِن مِن نَوائِبِها قَراها",55,"ا",3,0],["ضَيفٌ بَغيضٌ لا أَرَى لي عُصرَةً","مِنهُ هَرَبتُ فَلم أَجِد لي مَهرَبَا",56,"ب",2,0],["ضِيَافَةُ يُوسُفِ لُطْفاً","وَظَرْفاً مِنْ مُنَى الْعُمْرِ",57,"ر",1,0],["ضَيْغمٌ مِنْ سَوْرَةِ الحُمَّى وَمِنْ","ثوْرَةِ الحَمْيِ بِهِ يَزْأَرُ زَأْرَا",58,"ر",2,0],["ضَيَّعَ لا كانَ فيكَ حَقّي","وَغَرَّهُ جِسمُهُ العَريضُ",59,"ض",1,0],["ضيفٌ ألمَّ بها؛ فأصبح ربَّها","ثم استباحَ كرامةَ المِضْياف",60,"ف",1,0],["ضيَّقوا رقعة البسيطة حتى","لم يعد يشتكي بنوها اغترابا",61,"ب",2,0],["ضيَّعها نجليَ الصغيرُ، وكم","حمَّلني من خسارةِ ولَدي",62,"د",2,0],["ضيع القلب، واستحال جذوعاً","ترتدي آدميةً مستعاره",63,"ر",2,0],["ضيفَ العراق نعمتَ من خيراتهِ","وحَمِدْتَ فيه قرارةً وهجوعا",64,"ع",2,0],["ضيفٌ على رِمَمٍ شتَّى طبائعُها","ما كانَ يجمعُها حالٌ وإياه",65,"ا",2,0],["ضيَّقت مُلتقى نهودكِ","والكشْحَين منه وشمرَّت أردانه",66,"ن",2,0],["ضَيّعْتُ منّي خِلّةً في حِفْظِهَا،","كنتُ العدُوّ وَرُغْمَ أنفِ الحاسدِ",67,"د",1,0],["ضيقُ الصدرِ بالأمانة ٍ لا","قُصُ فَقْرِي أمَانَتِي ما بَقِيتُ",68,"ت",1,0],["ضَيِفَ الحُزنَ فَاِنجابَت عَقيقَتُهُ","فيها خِناذٌ وَتَقريبٌ بِلا تِيَمِ",69,"م",1,1],["ضيعت عمري لاهيا في غفلة","يا حسرتا وبضاعتي العصيان",70,"ن",1,0],["ضيف رفاعي الحمى جده","بمشهد بالنور معمور",71,"ر",1,0],["ضياءِ ذكاءِ من سنا نورِ وجهه","فما في الورى وجهٌ كوجْهِ محمدِ",72,"د",1,0],["ضَيفُ البكَايِ إِذَا لَم يَكُن مَلَكَا","أو تَاجِراً فَاجِراً فَهبهُ قَد هَلَكَا",73,"ك",2,1],["ضيوفُ ابن فَضلانٍ سواءٌ نهارُهم","وليلُهمُ صوما من الشّرب والأكلِ",74,"ل",1,1],["ضياءٌ هدانى فاهتديتُ لماجدٍ","سُهولُ المعانى طُرقُه ووُعورُها",75,"ر",3,0],["ضيفٌ له نزل لديّ كرامة","كبدٌ شواها البعد في جمر الجفا",76,"ف",2,0],["ضياءٌ لِمَن يَرنو وَحكمٌ لِمَن يَعي","وَرَوحٌ لِمَن يَشكو وَروحٌ لِمَن يَقضي",77,"ي",1,0],["ضياءٌ إِذا ما الجَهل أَظلَمَ سُدفَةً","حَليمٌ إِذا طاشَت يَدُ الطَودِ خِفَّةً",78,"ه",1,0],["ضِياؤُها في الكأَسِ ياقوتَةٌ","تَضْحَكُ في أَحشاءِ بَلُّورِ",79,"ر",1,0],["ضياعهم الكروم وهم كرام","على التأكيد في لفظ الخلاف",80,"ف",1,0],["ضَيفاً له وهوَ الكريمُ المكرمُ","بحياتهِ صلّوا عليهِ وَسلّموا",81,"م",3,0],["ضئيلات عِقْصيه بمتنيه تلتوي","وواوات صُدغيه تمنتهما الكُتْبُ",82,"ب",1,0],["ضَيَّعتُ في هِضَ