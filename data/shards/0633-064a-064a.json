{"poems":[[72,"وليلة قد بتها","https://www.aldiwan.net/poem42674.html","مجزوء الرجز"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[111,"تكب على دنياك وهي تبيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66836&r=&rc=15",""],[33,"لإتني، إن كنتَ ثقفاً شاعراً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18961&r=&rc=224",""],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[469,"لا تلمني فليس يجدي الملام","https://www.aldiwan.net/poem3627.html","عموديه"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46548","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132747","الرمل"]],"verses":[["سَيِّئَةٌ ما تَرَكَت","لِلدَهرِ عِندي حَسَنَه",0,"ن",2,0],["سِيئَتْ بما سَرَّنا الكُفَّارُ منه وَقد","أفْنَى سَراتَهُمُ أَسْرٌ وتَقْتِيلُ",1,"ل",1,0],["سييتم أطفال عليك أعزة","ويفضي بزيد ما عليه يزيد",2,"د",1,0],["سيىء ِ السحنة ِ، كابٍ لونه،","مِثْلِ عُودِ الخِرْوَعِ البَالِي القَصِفْ",3,"ف",1,0],["سَيِّئَاتٌ تَجَسَّمَت فَأَتَت في","صُورَةِ القِردِ ثم حَاكَتهُ سِيمَا",4,"م",2,0],["سيّئ عن جماله طلبُ الصبر","جميلٌ فيه الأسى والغرام",5,"م",1,0],["سيئة الخلق لها","مقابح لا تحصر",6,"ر",1,0],["سَيئة الأَخلاق","زائِدَة النِّفاق",7,"ق",1,0],["سيئاتي شتى ووزري عظيم","وسوى ذاك إن يكن فهو واهي",8,"ا",3,0],["سيئات وضعتني عندكم","حسنات عنده ترفعني",9,"ن",2,0]]}