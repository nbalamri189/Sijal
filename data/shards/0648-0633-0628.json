الخفيف"],[379,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[400,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[400,"نعم قد قضى ربي بما هو كائن","https://www.aldiwan.net/poem34099.html","الطويل"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[406,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[429,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[436,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[438,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[446,"وسبحة قد ظللت أحصي","https://www.aldiwan.net/poem53785.html","مخلع البسيط"],[446,"وسبحة كثغور الملامح","https://www.aldiwan.net/poem53787.html","المجتث"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[456,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[456,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[456,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[459,"يا جوادا محرزا سبق العلى","https://www.aldiwan.net/poem16137.html","الرمل"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[462,"طرقت ريح الصبا ميثاء وهنا","https://www.aldiwan.net/poem3594.html","عموديه"],[462,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[466,"أسير القطر قد أضحى طليقا","https://www.aldiwan.net/poem59803.html","الوافر"],[496,"الله حسبك والسبع الحواميم","https://www.aldiwan.net/poem3698.html","البسيط"],[498,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[527,"قبيح لا يماثله قبيح","https://www.aldiwan.net/poem37124.html","الوافر"],[527,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[534,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[549,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[556,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[559,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[560,"يا أيها الناس هذا مولد القمر","https://www.aldiwan.net/poem52829.html","البسيط"],[561,"أتيناك نوكى مرملين فواسنا","https://www.aldiwan.net/poem13611.html","الطويل"],[573,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"]],"verses":[["وَسَبَقتَ العِلّاتِ لَم تَنتَظِرها","وَلَو شِئتَها لَكانَت كِثارا",0,"ر",2,0],["وَسَبَتكَ حينَ تَبَسَّمَت","بَينَ الأَريكَةِ وَالسِتارَه",1,"ر",2,0],["وَسَبيئةٍ مِمّا تُعَتَّقُ بابِلٌ","كَدَمِ الذَبيحِ سَلَبتُها جِريالَها",2,"ل",3,0],["وَسَبيٍ كَآرامِ الصَريمِ تَرَكتَهُ","خِلالَ دِيارٍ مُستَكيناً عَواطِلُه",3,"ل",2,0],["وَسِبطا أَحمَدٍ وَبَنو بَنيهِ","أولَئِكَ سادَتي آلُ الرَسولِ",4,"ل",1,0],["وَسَبَوا فَواحَزَني بَناتِ مُحَمَّدٍ","عَبرى حَواسِرَ ما لَهُنَّ لَبوسُ",5,"س",1,0],["وسبح الناس بدرّيهما","حباً فيا لله من ذي السبح",6,"ح",1,0],["وسبع ليال دائراتٍ على الورى","بنوع افتراس فيهمو ليس يشبع",7,"ع",1,0],["وسبرت أخلاق الكرام فلم أجد","في الفضل للملك المؤيد ثاني",8,"ي",1,0],["وسبقنا في ميادي","نك أصحاب السباق",9,"ق",1,0],["وَسَبَقتَ كُلُمبوسَ مُكتَشِفاً","وَشَأَوتَ آديسونَ مُعتَزِما",10,"م",2,0],["وَسَبقٍ تَعظُمُ الأَخطارُ فيهِ","وَيَحسُرُ جَريُهُ البَطَلُ البَطينا",11,"ن",2,0],["وسَبيلُ الحياةِ رحْبٌ وأنتنّ","اللواتي تَفْرُشْنَهُ بالوُرودِ",12,"د",1,0],["وسبحت حتى كل مني ساعدي","ادعو الاله واتقي واناجي",13,"ي",1,0],["وسبقت فيك القائلين لمنبر","عال عليهم خالد الأعواد",14,"د",1,0],["وَسَبَقنَ فيها المُعلَمي","نَ إِلى الكَريهَةِ مُعلَماتِ",15,"ت",1,0],["وَسِباعُ السَماءِ وَالأَرضِ وَالأَر","حامُ وَالأُمَّهاتُ وَالآباءُ",16,"ا",2,0],["وَسَبَت أَمرَدَ المُلوكِ فَرَدَّت","هُ وَما فيهِ لِلرَعايا رَجاءُ",16,"ا",2,0],["وسَبِيلُه أن يَستَبِلَّ وقَد رأَى","شَملَ الشَّبابِ طَريدَ شَيبٍ زَائلِ",17,"ل",1,0],["وَسبطا أَحمَدٌ وَلَداي مِنها","فَمَن منكم لَهُ سَهمٌ كَسَهمي",18,"ي",1,0],["وَسَبَكتُ مَدحَكَ في بَواطِقِ فِكرَتي","إِذ في البَواطِقِ يُسبَكُ الإِبريزُ",19,"ز",1,0],["وسبقتُ فمنْ ذا يلحقني","في مدح عُلا الحسنِ الحسنا",20,"ن",2,0],["وَسَبَتْهُ قُضُبٌ في كُثُبٍ","مالتِ الأكفالُ منها بالقُدود",21,"د",1,0],["وسبيَّةٍ بصوارمٍ من عسجدٍ","قد صافَحَتْ منها العلوجَ صفاحُ",22,"ح",1,0],["وسبعينَ عاماً ترى شمسَها","بعينك طالعةً غاربه",23,"ب",2,0],["وسبيلُ منْ لم يعلموا أنْ يحسنوا","ظنّاً بأهلِ العلمِ دونَ نفارِ",24,"ر",1,0],["وَسِبطٌ صُفوفٌ يَنظُرونَ قَضاءَهُ","يُصيخونَ بِالإِسماعِ لِلوَحيِ رُكَّدُ",25,"د",1,0],["وَسَبَّحَهُ النَينانُ وَالبَحرُ زاخِراً","وَما طَمَّ مِن شَيءٍ وَما هُوَ مُقَلِدُ",25,"د",1,0],["وَسَبَّحَ القَومُ لَمّا أَن رَأَوا عَجَباً","نوراً مِنَ الماءِ في نارٍ مِنَ العِنَبِ",26,"ب",1,0],["وَسِبطاهُ جَدُّهُما أَحمَدٌ","فَبَخَّ لِجَدِّهِما وَالأَبِ",27,"ب",1,0],["وَسَبسَبٍ قَد عَلَوتُ طامِسَهُ","بِناقَةٍ فوقَةٍ مِنَ النوقِ",28,"ق",1,0],["وَسَبعَةٌ مِن بَني البَطّالِ قَيِّمُهُم","رِداؤُهُ اليَومَ فَوقَ الرِجلِ يَضطَرِبُ",29,"ب",1,0],["وَسَبتُكَ الشَعَرَ الغِربيبَ تَطرَحُهُ","ما رَغَّبَ الشَيخُ في البادي مِنَ النَزَعِ",30,"ع",1,0],["وَسَبَتكَ ناعِمَةٌ صَفِيُّ نَواعِمٍ","بيضٍ غَرائِرَ كَالظِباءِ العيسِ",31,"س",1,0],["وَسَبَحنا فوق وادٍ من لجينْ","تحت أفقٍ من غماخم وسَنى",32,"ن",2,0],["وَسَبْحَةٌ لِلزَّمَانِ كرَّت","مَا بَيْنَ عُرْسٍ وَبَيْنَ عُرْسِ",33,"س",1,0],["وَسَبْكٌ يُعِيدُ اللَّفْظَ لحْناً مُوَقَّعاً","وَيُبْدِي لنَا المَعْنَى الْخَفِيَّ مجَسدَا",34,"د",2,0],["وَسِبطَي رَسولِ اللَهِ وَاِبَني وَصِيَّهِ","وَوارِثِ عِلمِ اللَهِ وَالحَسَناتِ",35,"ت",1,0],["وسبَقْنا دَقَّ البشائرِ شَوْقاً","وبعثْنا السُؤالَ إِثْرَ السُؤال",36,"ل",1,0],["وسبَب العمران الخَرَاب","عُذُوبة الحب من العَذَاب",37,"ب",1,0],["وسبقتُ فمنْ ذا يلحقني","في مدح عُلى الحسنِ الحسنا",38,"ن",2,0],["وسبقت ((كولمبوس)) مكتشفا","وشأوت ((آديسون)) معتزما",39,"م",2,0],["وسباع الغابات قد عمت ال","بر زئيراً وامتد ستر الوقار",40,"ر",1,0],["وسبيل إلى الوصول إلى اللَ","ه وباب لكل خير عظيم",41,"م",1,0],["وسبطي رسول اللَه أعنى حسينهم","كذا الحسن الموصوف بالعلم والشكر",42,"ر",1,0],["وسبحة حباتها تزيد","على مصابي بك يا عبود",43,"د",1,0],["وسبرت أغوار السراة","وقستهم بالسرسرية",44,"ي",2,0],["وَسَبِّح اِسمَ رَبِّكَ الأعلَى الذي","والشَّمسَ أَو مِثلَهَا في المأخذ",45,"ذ",1,0],["وسَبوحا قَوداءَ تحتلب الجِر","يةَ في حافرٍ كمثلِ القعبِ",46,"ب",1,0],["وَسَبَقتَ قَولَكَ بِالفَعالِ وَلَم تَدَع","شَرَفاً لِقَوّالٍ وَلا فَعّالِ",47,"ل",1,0],["وسباسب تذر الدليل مرددا","انظر إلى أثر المطي كليلا",48,"ل",2,0],["وسبحان الذي يُعصى","فيعفو وهو مقتدر",49,"ر",1,0],["وسب إله العرش فيهم وسبهم","وأعلن بالقول القبيح وبالنكر",50,"ر",1,0],["وسبق أبي هر إليك لحرصه","عليها لحفظ المسندات الكثائر",51,"ر",1,0],["وسببت قوما في الجزي","رة وانتسبت بذل عرّه",52,"ر",2,0],["وسببت أهل محلتي","يا قبح فعلي ما أمرّه",52,"ر",2,0],["وَسَبَتهُ بِناصِعِ اللَونِ حُرٍّ","وَثَنايا مُفَلَّجاتٍ وَاِجتِنابِ",53,"ب",1,0],["وسُبوغُ سيِّدِنا الأجلِّ مراتباً","مَدَّت على الملك الأجلِّ جلالا",54,"ل",2,0],["وسبحنا وللجمال خيال","آه من فتنتي بذاك الخيال",55,"ل",1,0],["وَسُبحَةُ النُفوسِ في العَذابِ","تُجمَعُ في سِلكٍ من الأَهدابِ",56,"ب",1,0],["وسبّل بئراً ماؤها ينقع الصدى","وجهّز جيشاً وهو بالعسر مدقع",57,"ع",1,0],["وَسَِبيلُ مَنْ يَخْشَى مِنَ الْجَبَّارِ","فَانْهَضْ لِدِينِكَ فَاعْتَمِدْ تَصْحِيحَهُ",58,"ه",1,0],["وسَبّاقِ غايات البَلاغَةِ وَالنُهى","وَذو الخَصل مِنها ان شده أَو أَزوى",59,"و",2,0],["وَسُبحان من تعنو الوجوه لِوَحهِهِ","ومن كل ذي عز له يَتَذَلل",60,"ل",1,0],["وَسُبحانك اللهم تَسبيح شاكِر","لمعروفك المَعروف ياذا المَراحِم",61,"م",1,0],["وَسَبقتَ أملاكاً ذوي خطرٍ بها","لَم يَشأنوا مِنها لذاك الشانِ",62,"ن",1,0],["وَسبّحت وسطها صمُّ الحَصى ورمت","بِها جيوشاً فخرّوا جثّماً وعموا",63,"م",3,0],["وَسَبانا العُقولُ حينَ تَجلي","مُثنِياً قامَةً وَأَيَّةَ قامَه",64,"م",2,0],["وسبحنا في رحاب ال","جو والجو هباء",65,"ا",2,0],["وَسَبيلُ النَجاةِ صَعبٌ وَلا","يُبلَغُ إِلّا بِحَملِ صَعبٍ مُشَقِّ",66,"ق",1,0],["وَسبحة درّها المَكنون قامَ بِهِ","يسبح الجيد مِنها الواحد الصَمدا",67,"د",2,0],["وَسَبّحَ لِلّه الحَصى وَطَعامُهُ","وَكَلَّمَهُ ضَبٌّ وَنحلٌ وَرَبرَبُ",68,"ب",1,0],["وَسَبانا بِجَبهَة وَلِحاظ","تِلكَ سِيافة وَذي طعانه",69,"ن",2,0],["وسَبِقتَ من شَوْقٍ إلى عَيْني الكَرَى","عَجَباً وأنت من الظِّباءِ خَذول",70,"ل",1,0],["وَسَبَّحتُ رَبَّ العالَمينَ لِأَنَّني","رَأَيتُهُم مُستَجمِعينَ بِلا حَشرِ",71,"ر",1,0],["وسَبيلُ مَن أَمسى بِمِثلِ بَنانِه","تَرَفاً يكونُ من الفِراقِ مَلولا",72,"ل",2,0],["وسَبينَ بشهوةِ الجسم شوقاً","وغراماً يُحيلُ أشكالهنه",73,"ن",2,0],["وَسَبَّتني بِناتُ نَخلَةَ لَو كُن","تُ قَريباً أَلَمَّ بي إِلمامُ",74,"م",1,0],["وَسَبَّ أمير المؤمنين مُجَاهِراً","وألزم أن يُمْلَى على كل مِنْبَرِ",75,"ر",1,0],["وسبق القضا لا يقتضي الجبر هل ترى","إلهَكَ مجبوراً لسبق القضية",76,"ه",1,0],["وسباع الوحش تعدو خلفه","لتطفي من عداه السغبا",77,"ب",2,0],["وسبيلُ السُّلوِّ بادٍ لِعَينيْ","يَ ولكنْ مالِي إليه سَبيلُ",78,"ل",1,0],["وسبقْتَ قوماً جئتَ بعدهُمُ","فَدَعِ الذينَ أَتيتَهُمْ قَبْلا",79,"ل",2,0],["وسبطانِ من أَملاكِ يعرُبَ أَقْدَما","بأَجنادِها كالنجمِ يَقْدُمُهُ النَّطْحُ",80,"ح",1,0],["وسبعون ألفاً من الحور تأتي","لكل ولي موال معاد",81,"د",1,0],["وسبحة قد ظللت أحصي","بها ثنائي على الحبيب",82,"ب",1,1],["وسبحة كثغور ال","ملاح مبتسمات",83,"ت",1,1],["وسبت لبه حُبابة واسته","وته حتى أباح فيها اشتهاره",84,"ر",2,0],["وسبقنَ طيَّتها الشّمال كأنّما","خلَّفنها خلفَ الأيانقِ حادِيا",85,"ي",2,0],["وسُبوغِ أفياءِ الوصا","لِ عشيَّةً فيها وغُدْوَهْ",86,"و",2,0],["وسبَّب لي هذا المُقامَ تروُّعي","وقد كنتُ عنه ساهياً أو مغفَّلا",87,"ل",2,0],["وسبقْتَ الرُّمْحَ عَزْماً ماضياً","وفضَلْتَ الطَّوْدَ صبراً ووقَارا",88,"ر",2,0],["وسبحان الذي أحكامه كلّ","ها بالعدل تجري لا تحيف",89,"ف",1,0],["وسبرتُ الخلق حتى لم أجد","للعزيز الملك غير الغيث خدنا",90,"ن",2,0],["وسبوا بدور التمّ ثمّ تخيّروا","لتقلّها الأغصانُ في الأنقاء",91,"ا",2,0],["وَسُبلُ الجَوِّ مَن يَطلُبُ غَماما","تَجِد مِنهُ بِها الرَطبَ الرَفيقا",92,"ق",2,0],["وسبعة الشُهبِ لم تَحفل بها ثقةً","بوعد ربك هيهات التَنَاجِيم",93,"م",1,0],["وسبرنا نظامه جعفَرياً","ونظمنا أسلوبه كاظميّا",94,"ي",2,0],["وسَبُّوا لاَرُعُوا أصْحابَ طَهَ","وَعادَوا مَنْ عَدَاهُمْ أجْمَعِينا",95,"ن",2,0],["وسَبِيلُ الْخَيْرِ مَفْتُوحٌ لِمَنْ","رَامَ يَسْلُكَ خَيْرَ السُّبُلِ",96,"ل",1,0],["وَسُبلُ اللَهِ مُلبَسَةٌ ظَلاماً","فَأَسفَرَ بِالنَبِيِّ لَهُ الظَلامُ",97,"م",1,0],["وسُبْلُ اليأسِ واضحةٌ لدينا","ولكنْ ربّما طمع الطَّموعُ",98,"ع",1,0],["وسبتني بطلعة","لم يقم بعدها الدجا",99,"ج",2,0],["وَسَبَلاتي وَبِجَنبي لِمَّتي","أَصبحَ قَومي يَحفِرونَ حُفرَتي",100,"ت",2,0],["وَسَبَطٌ أَميَلُ مَيلانِيُّ","حَيثُ اِنثَنَى ذو اللِمَّةِ المَحنِيُّ",101,"ي",1,0],["وسَبَّحَتْ خُطَباءُ الناسِ حاكيةً","مَلائكَ العَرْشِ في الآصالِ والبُكَرِ",102,"ر",1,0],["وَسَبقِ أَبٍ ميلادُهُ مَولِدَ اِبنِهِ","بِخَمس وَسِتّ ما عُزَزنَ بِسابِعِ",103,"ع",1,0],["وسَبرتُ عَزْمَ العِشْقِ فيه","فلم أَجِدْ لِلْعِشْقِ عَزْما",104,"م",2,0]]}