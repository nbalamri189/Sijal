"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5756,"لا قبلك ولا بعدك سعد","https://www.poetsgate.com/ViewPoem.aspx?id=5368",""],[402,"مر في بالنا فأحيانا","https://www.poetsgate.com/ViewPoem.aspx?id=36528",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5848,"محاولة قتل","https://www.poetsgate.com/ViewPoem.aspx?id=53462",""],[5917,"ما لنا قط غير ما شرع الله","https://www.poetsgate.com/ViewPoem.aspx?id=106537",""],[5952,"مُثمَلٌ دون سُلافِ","https://www.poetsgate.com/ViewPoem.aspx?id=203586",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""],[5956,"الخيال وأفراح الإفراج","https://www.poetsgate.com/ViewPoem.aspx?id=194699",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6045,"قُبلة من فم الأيّام","https://www.poetsgate.com/ViewPoem.aspx?id=125345",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6355,"مناجاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66603&r=&rc=63",""]],"verses":[["مَا لنا غَيْرُ تِلْكَ رَائِعَةٌ","فِي زَمَانِ العَزِيزِ مَوْلانَا",0,"ن",2,0],["ما لَنا وَالخُطوبُ تَأخُذُ مِنّا","نَتَلَهّى كَأَنَّنا في رَخاءِ",1,"ا",2,0],["ما لَنا يَأخُذُ مِنّا الطَرَبُ","كُلَّما عامٌ تَلاشى وَاِضمَحَل",2,"ل",1,0],["ما لِنَفسي لا تُبالي الطَرَبا","أَينَ ذاكَ الزَهوُ أَينَ الكَلَفُ",3,"ف",1,0],["مَا لنا والكؤوس نَطْلُبُ منها","نشوةً والغَرامُ سِحْرٌ وسُكْرُ",4,"ر",1,0],["مالَنا في النَدى عَلَيكَ اِختِيارٌ","كُلُّ ما يَمنَحُ الشَريفُ شَريفُ",5,"ف",1,0],["مالَنا كُلُّنا جَوٍ يا رَسولُ","أَنا أَهوى وَقَلبُكَ المَتبولُ",6,"ل",1,1],["ما لَنا مِن أَبي المُعَمَّرَ إِلّا","بُعدُهُ عَن عُيونِنا وَاِحتِجابُه",7,"ب",2,1],["ما لِنَدى في سِواكَ غَيرُ حَديثٍ","مِن أُناسٍ بادوا وَفِعلٍ ماضِ",8,"ض",1,0],["ما لَنا نَعبُدُ العِبادَ إِذا كا","نَ إِلى اللَهِ فَقرُنا وَغِنانا",9,"ن",2,0],["ما لَنا بَعدَ أُنسِهِ وَوِدادٍ","وَتَصافٍ في السِرِّ وَالإِعلانِ",10,"ن",1,0],["ما لنا؟ مالنا نلوم حزيران","وفي الإثم كلنا شركاء؟",11,"ا",2,0],["ما لَنا لانَتَفَكَّر","أَينَ كِسرى أَينَ قَيصَر",12,"ر",1,1],["ما لَنا نَستَطيعُ أَن نَجمَعَ الما","لَ وَرَدَّ المَماتِ لا نَستَطيعُ",13,"ع",1,0],["ما لَنا نَأمَنُ المَنايا كَأَنّا","لا نَراهُنَّ يَهتَدينَ إِلَينا",14,"ن",2,0],["ما لنا لسنا نغني للحجر","للجمارات التي ليست تعي",15,"ي",1,0],["ما لنا نتبعُ الأمانيّ هلّا","عَقَلَتْنا عن الأَماني العقولُ",16,"ل",1,0],["ما لِنَورِ الرَبيعِ في غَيرِ حُسنٍ","ما لَهُم مِن تَغَيُّرِ الأَلوانِ",17,"ن",1,0],["ما لنا من هذه الدُّنيا سِوَى","غارةِ العادِي وعَسفِ المُحتكِمْ",18,"م",1,0],["ما لِنفسٍ قُوَّةٌ في مُلكِهِ","جَلَّ ذو القُوَّةِ وَالحَولِ المَتينْ",19,"ن",1,0],["ما لِنَفسي فيكَ ما تَملِكُهُ","غَيرَ ما تَملِكُ نَفسُ المُؤمِنِ",20,"ن",1,0],["ما لِنَفْسٍ من غِبْطَةٍ أو سُرورٍ","بمتاعٍ تَخْشَى عليهِ النَّفادا",21,"د",2,0],["ما لِنَفسي بَينَ النُفوسِ مُعَنّا","ةً إِذا لَم تَفُز بِطَوقٍ وَسَلسِ",22,"س",1,0],["ما لَنا فيها حُصونٌ غَيرُ ما ال","مُقرَباتِ الجُردِ تَردي بِالرِجالِ",23,"ل",1,0],["ما لنا إلاَ نهُوضٌ بالشبابْ مِنْ أَمَلْ","قَوَةُ الأوطانِ عقلُ ويدُ",24,"د",1,0],["ما لنا غيرَ أن نقولَ حيارى","بلسان الدموع كانُوا وكُنَّا",25,"ن",2,0],["ما لنا كلما نظمنا قصيدًا","نعتونا بمُفلقٍ ومُجيد؟",26,"د",1,0],["ما لنا نسبق الحمام إلينا","وهو أمضى يدا وأحنى بنانا ؟",27,"ن",2,0],["ما لنا في مديحه غيرُ نظمٍ","للمساعي التي سعاها ووَصْفِ",28,"ف",1,0],["ما لنفسي تخشى لقاء المنايا","ولماذا يروع هذا اللقاء",29,"ا",2,0],["ما لنا نلمحُ في مشيتهِ","مخلبَ الذئبِ وجلدَ الثعلبِ؟",30,"ب",1,0],["ما لنا غير ذلك الصدر مأوى","أو معاذ وجل ذاك وقلا",31,"ل",2,0],["مالٌ نَداكَ عَدُوُّهُ لا يَحتَمي","مُلكٌ سُطاكَ عِقالُهُ لَن يَشرُدا",32,"د",2,0],["ما لَنا وَلِلأَبَد","إِن سَرَّهُ عَميق",33,"ق",1,0],["مالنا واشٍ سِوى حس","نِك يا حِبِّي وأُنْسي",34,"س",2,0],["مالنفسي لا تبالي","رغم ماتخفيه رغما",35,"م",2,0],["ما لِنَفسي معين","عند خطب عناها",36,"ا",3,0],["ما لنا من أَمرِنا حتى","ولا مثل قلامه",37,"م",2,0],["ما لنا في ساحة الحرب معين","لا زعيم لا مليك لا قضاء",38,"ا",2,0],["ما لِنَومي كأنَّه كانَ في أَو","وَلِ دَمعي جَرى مِن الآماقِ",39,"ق",1,0],["مالنار بنا معطي سواك","مالنا من هدى الأهداك",40,"ك",1,0],["مالنا من شفا الأشفاك","جد لمن لا له في شيء يدان",40,"ن",1,0],["مالنا في كل أمر هالنا","أو عرانا اودهانا الأنداك",41,"ك",1,0],["ما لنا غير كسبنا","موجب الحزن والفرح",42,"ح",1,0],["ما لنفسي أرب في غيركم","قربكم طول المدى أقصى مناها",43,"ا",3,0],["مال نحوي بعطفه الاشفاق","فتلقيته بفيض المآقي",44,"ق",2,1],["مالنا وللغواني والهوى","واحتسا الصهباء من جوف الدنان",45,"ن",1,0],["ما لنا في الإمكان أبدع مما","كان في أم حضرة الأعيان",46,"ن",1,1],["ما لَنَا والْكَدْحِ في قَوْلِ امْرِىءٍ","مِثْلِنا في عِلْمِهِ والْعَمَلِ",47,"ل",1,0],["مَا لَنا عَنْ مَنْهَجِ الْتَحْ","قيقِ والْحَقِّ نَحُولُ",48,"ل",1,0],["ما لَنا والرّأْي إنَّ ال","رَّأيَ في الدِّينِ فُضُولُ",48,"ل",1,0],["ما لَنا عنهُ مَحيدُ","إنَّه رأىٌ سَديدُ",49,"د",1,0],["ما لنا مَجْزعٌ ولو أنّه كا","ن لحوشيتَ أن تكون جَزوعا",50,"ع",2,0],["مالنا والجهول يبحث عنا","بكلام واه وعقل خسيس",51,"س",1,0],["ما لنا عنها غناء أبداً","هل يقوم الظل من غير عمود",52,"د",1,0],["ما لَنا نَعشَقُ الحِسانَ وَنَردى","أَنَّ حُمرَ الخُدودِ مَوتٌ أَحمَر",53,"ر",1,0],["ما لَنا يارِفاقُ زَعزَعَنا الشَّو","قُ وَلِلعيسِ تضحتَنا إرزام",54,"م",1,0],["ما لنا لسنا نرى أولادها","غير جِبْسٍ أو لَئيمٍ زُكَأَه؟",55,"ا",2,0],["ما لَنا عَنهُ غِنى","قَلبُهُ غَطَّى القُلوبْ",56,"ب",1,0],["ما لَنا في الهَوى عَلَيكم حُقوقٌ","بَلْ لَكمْ سادَتي عَلَينا الْحقُوقُ",57,"ق",1,0],["ما لناظِري كُحْلٌ","غيرَ هذهِ الطَّلعَهْ",58,"ع",2,0],["مالَ نشوان عَلَينا","لين العَطف وَصاح",59,"ح",1,0],["ما لنا منصف سواك فيشكى","أنت كالنصل والملوك قرابُ",60,"ب",1,0],["ما لنفسي لا حزم أحرز دنيا","ها ولا شك محرز أُخراها",61,"ا",3,0],["ما لنفسي غير السؤال شفيع","حسبها إن أجبتم وكفاها",61,"ا",3,0],["ما لنا من أحَدٍ نرجوه في","كشفِ ذا الكَرب سواكَ يا أحد",62,"د",1,0],["ما لَنا في الرسل أَعلى رتبة","منك فاطلب فضلنا تعط الأمل",63,"ل",1,0],["ما لنا واللَه في النا","س جميعاً من ضريب",64,"ب",1,0],["مالنا في وطء البسيطة حظٌ","لا ولا في نشق الهواء نصيب",65,"ب",1,0],["ما لنهاري كأَنَّهُ الغَسَقُ","وما لليلي ما شَقَّهُ الفَلَقُ",66,"ق",1,1],["ما لنا منه سوى ما","قد علمتم من سِمات",67,"ت",1,0],["ما لنفسي وللسلو وهذا","دمعها أهرقته سرب دماها",68,"ا",3,0],["ما لنا والحروب نحن أناسٌ","ما لنا طاقةٌ بشيءٍ يضيم",69,"م",1,0],["ما لنا يا رفَاقُ زعزعَنا الش","وقُ وللعِيس تَحُتنَا إرزامُ",70,"م",1,0],["ما لنا يا خو الغزالة ما لنا","قد نفدنا في هواكم مالنا",71,"ن",2,0],["ما لَنا شَيءٌ مِنَ الأش","ياءِ إِلّا ما يَشاؤوا",72,"ا",1,0],["ما لنفسي في الدجى لا تسكنُ","ولها في كل واد موطن",73,"ن",1,1],["مالنفس إلا كدرة","في صفو روحك تغتدي",74,"د",2,0],["ما لنا لم نر فيك ال","يوم شخصاً مستعدا",75,"د",2,0],["مالنا بعد ذا سوى عضّ كفٍّ","لو كفى بالفقيد عضُّ الكفوفِ",76,"ف",1,0],["ما لنفسي من صديق كالأسى","يصدق الوعد ولا ينكث عهدا",77,"د",2,0],["ما لَنا والبُكاءِ من ألمِ الحر","بِ ونحنُ القَنا ونحنُ السيوفُ",78,"ف",1,0],["ما لنا عز وجاه","غير من نرجو رضاه",79,"ا",2,1],["ما لنارِ الشوقِ تَذْكُو كلما","سال دمعي مَا خَباها قَطُّ نَضْح",80,"ح",1,0],["ما لنمرود عاذلي وفؤاد","في نعيم بنار إبراهيما",81,"م",2,0],["ما لَنا نَحن ضَعِفنا وَقووا","أَوَ لَسنا كلّنا طيناً وَماءَ",82,"ا",2,0],["ما لَنا يا ضَعيفَ الوِدَادِ","غير فَرطِ الأَسى وطُولِ السُّهادِ",83,"د",1,1],["ما لنا بعد جحد يوم الغدير","واغتصاب الوصي يوم سرور",84,"ر",1,1],["ما لنا نرجو وَفا زمنٍ","حذّرتنا غدرَه الحُكَما",85,"م",2,1],["مالنا وَالفكر أَكبرُ ناهٍ","نَجهل الأَمر الجلي وَهوَ عامْ",86,"م",1,0],["ما لنا فيها سِوى ما","خلّفَ الفاني لتاركْ",87,"ك",1,0],["ما لنا عيب سوى بع","دك فامنن بحضور",88,"ر",1,0],["ما لَنا فيكَ اشتراك","جَلَّ رَبٌّ قَد بَرَاك",89,"ك",1,0],["ما لنا غير أن نكر سريعا","نرد الحتف أو نعيش جميعا",90,"ع",2,0],["ما لَنَعَم عِندَهُ مَخالَفَةٌ","مِثلَ اِختِلافِ الصُعودِ وَالصَبَبِ",91,"ب",1,0],["مالَنا وَالزَمنِ الماضي السَحيق","نَحنُ في عَهدٍ قَد اِفتَرَّ لَنا",92,"ن",2,0],["ما لنفسي ذابت وطارت شعاعاً","ولقلبي إثر الأحبة ضاعا",93,"ع",2,1],["ما لنا ملجأ سواك اذا ما","دهمتنا الخطوب والحال حالا",94,"ل",2,0],["ما لنقص حاشاه في قدره ما","كان منهم له من الايذاء",95,"ا",2,0],["ما لنا سائق الرواحل قدم","فركبناه زائراً زئر ضيغم",96,"م",1,1],["ما لنطقي قد أبى لفظ الكلام","ما لصافي العيش أغشاه الكَدَر",97,"ر",1,0],["ما لناغي الحيّ قد أضحى أتوف","ما لروضي صار معدوم الثمَر",97,"ر",1,0],["ما لنطقي في ثنا الذكر انقطاع","بات جسمي في سعير وَعِبَر",97,"ر",1,0],["ما لَنا دُون ذا اِحتِيال فَإِن اللَ","ه في عِلمِهِ الشُؤون الدقاق",98,"ق",1,0],["ما لنور الأَخلاقِ هَل غَشيتهُ","ظُلُماتٌ أَودَت بكلّ خَلاقِ",99,"ق",1,0],["ما لنجوم الليل لا تسري","هل ليل من أهوى بلا فجر",100,"ر",1,1],["ما لِنَجمٍ عَكَفَت عَيني عَلى","رَعيِهِ لَيسَ يَرِيمُ الأُفُقا",101,"ق",2,0],["ما لنا كلما دعوناه عنا","صكَّ سمعاً ودام منا النداء",102,"ا",2,0],["ما لنا غيره فمَن لشعوبٍ","ضيّعتها الحروب والتشريدُ",103,"د",1,0],["مالنا غير حرقة ٍوعذابٍ","ودموعٍ تسحّ والقلبُ يشدو",104,"د",2,0],["ما لَنا نَهْوِي وما مِن","عاقِلٍ أو مُستَنِيرِ!",105,"ر",1,0],["ما لَنا نَعدُو ونَعدُو","دُونَ تَقدِيرِ المَسِيرِ!",105,"ر",1,0],["ما لنا فيهم / حسافة كل شي اليوم ضاع","اتركي عنك نداهم ما لنا في القوم/سيره",106,"ر",2,0],["ما لنا غيركم أئمةُ رشدٍ","ليس فينا لمن سواكم ولاءُ",107,"ا",2,1],["‏ما لناسي وحدهم ذنبٌ سوى","منهم الظلمُ ومن روحي الرضا",108,"ض",2,1],["ما لنا غير المصطفى ذخرٌ","فهو أرجى من نحوه ينحى",109,"ح",2,0],["ما لنا غير علاكم","أيه النجيب الفخام",110,"م",1,0],["مالنا مالنا سوى الله ربٌ","مات عصر الأصنام والأوثانِ",111,"ن",1,0],["ما لنا غير أننا نتمنى","ونمني النفوس بالتعليل",112,"ل",1,0],["ما لنفسي ذابت وطارت شعاعا","ولقلبي إثر الضعائن ضاعا",113,"ع",2,1],["ما لنا هذا وهذا لست عائل","لستُ منسوباً لكعبٍ أو لوائل",114,"ل",1,0],["مالنا نرخص الدموع إذا ما","سفكت قطرة على شاطئيهِ",115,"ي",2,0],["ما لنا في أخذه من مأربٍ","أنت قد أذعنت والعذل أبى",116,"ب",2,0],["ما لنا إذْ نظرةٌ قد جمَّعتنا","رعشةٌ فينا سَرَتْ في الخلايا",117,"ا",3,0],["ما لنُعاماك تعامى موضعي","أذاك عمداً منك أم كان 