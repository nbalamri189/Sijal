{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[96,"المعبد المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15623",""],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[466,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96632","الرمل"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[5074,"الضَّيغم الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5616,"غُربة... إلى أصحاب الحقائب المسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=204850",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5725,"صبريني","https://www.poetsgate.com/ViewPoem.aspx?id=202933",""],[5956,"طيوف الشقيق الباسمة","https://www.poetsgate.com/ViewPoem.aspx?id=192920",""]],"verses":[["أيّها الضوء الذي أبصرته","لم يثر ولم ينفث دخانا",0,"ن",2,0],["أيُّها الضرس الذي أرَّقني","بعد ما اعتادت جفوني أن تناما",1,"م",2,0],["أيّها الضاحك الطّروب ألا تأسى","لهذي الدموع في عينيّا",2,"ي",2,1],["أيها الضاحكون في مأتم الجسم","سلاماً من ضاحكٍ مجهول",3,"ل",1,0],["أيُّها الضَّرْمةُ مِن نارِ العُلى","خَمدتْ بعد عَلَوٍّ واشْتِعالِ",4,"ل",1,0],["أيّها الضارب هامات العدا","بمواضٍ عربيّاتٍ حدادِ",5,"د",1,0],["أيها الضارب ستراً عبثا","ليس بالستر الهوى يستتر",6,"ر",1,0],["أيُّها الضَّيغمُ الجريحُ المُدَمَّى","فُجِعَتْ بعدَ عزِّكَ البَيْدَاءُ",7,"ا",2,0],["أيها الضاحكون والشعب يبكي","أيها الرافهون ... والشعب يجلد",8,"د",1,0],["أَيُّها الضَّارِبُ هاماتِ العِدَى","بِمَواضٍ عَرَبِيَّاتٍ حِدادِ",9,"د",1,0],["أيُّها الضاربونَ في كبدِ الصحْ","راءِ.. عودوا فليسَ فيكم جياعُ",10,"ع",1,0],["أيها الضاربون في ظلمة الليل","الى غير منتهى أو قرار",11,"ر",1,0],["ايها الضامر الحشا في هزال","اغمد القد بعد حربٍ ضروسِ",12,"س",1,0],["أيها الضاحك جدّاً","تبتغينا نَتَهنَّا بالصفاءْ",13,"ا",2,1]]}