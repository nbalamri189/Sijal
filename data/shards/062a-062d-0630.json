{"poems":[[87,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[63,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[42,"تطاول أيامي وليلي أطول","https://www.aldiwan.net/poem42283.html","الطويل"],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[240,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[406,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[422,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[553,"تحُذرني كي أحذر العام خثعما","https://www.aldiwan.net/poem1187.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138365",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128695","الخفيف"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35839","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131082",""],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101153","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4741,"رَأَيْتُ أنِيسَ الرُّوحِ","https://www.poetsgate.com/ViewPoem.aspx?id=130125",""],[4797,"تحذرو من بايعين الحباري","https://www.poetsgate.com/ViewPoem.aspx?id=178133",""],[5302,"أقمت على نهري","https://www.poetsgate.com/ViewPoem.aspx?id=200064",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""]],"verses":[["تحذو على مصطفى وتبنى","جيلا من الحق أقوياء",0,"ا",2,0],["تُحَذِّرُني مِن قَومِها التُركِ زَينَبُ","وَتُعجِمُ في وَصفِ اللُيوثِ وَتُعرِبُ",1,"ب",1,0],["تحذِّرُني أجَلي في السُّرى","وهل كنتُ آمِنَه في الثواءِ",2,"ا",2,0],["تُحَذِّرُها في مَشيها الأَعيُنَ الَّتي","بِها إِن رَأَتها عِندَ ذي الضَغنِ تَجمُلُ",3,"ل",1,0],["تحذلق بالتمويه مكراً وخدعة","ولا شيء مما تدعيه سديد",4,"د",1,0],["تحذرني اللئام وحسو سم","مقاربة الكرام من اللئام",5,"م",1,0],["تَحذو قَوائِمَها التِبرَ النُضارَ فَمِن","نِعالِها لِلمُلوكِ الصيدِ تيجانُ",6,"ن",1,0],["تُحَذِّر مِن مُواقَعَةِ المَعاصي","وَتَنْهَى عَن مُتابَعَة الغُرورِ",7,"ر",1,0],["تَحذِّرنا من الباغي علين","ومن أَتْباع نَهْجِ (أبي رِغالِ)",8,"ل",1,0],["تحذّرنا صرف المنون نزولها","وتنذرنا في كلّ يوم بمنذر",9,"ر",1,0],["تُحَذِّرُني كَي أَحذَرَ العامَ خَثعَما","وَقَد عَلِمت أَنّي اِمرؤٌ غَيرُ مُسلَمِ",10,"م",1,1],["تحذو العواهل حذوه إذا انه","يقضي بصلح في الانام ويفصل",11,"ل",1,0],["تحذر بالإغراء أحشاء مهجتي","ويا ليتها غذ حذرت لم تكن تغرى",12,"ر",2,0],["تحذر الأسد من سطاها ويخشى ال","غصن أن تستميل منه قوامه",13,"م",2,0],["تُحَذَّر مِنَ الأَضدادِ ما اِسطَعتَ","لَدَيَّ عَلى التَحقيقِ شَرَّ العَقارِبِ",14,"ب",1,1],["تحذرنا من شقاء الغرام","وأهواله وهني لا تجذر",15,"ر",1,0],["تحذرني غدر الزمان وما درت","باني الذي مالان للدهر جانبه",16,"ب",2,0],["تحذرني مشافهة بلاها","ويعطفني الغرور إلى هواها",17,"ه",2,0],["تَحَذْتُكَ حُبَّاً في الحَشَا وَرَويتَهُ","علي مُنْتَهَي شَوْقِي دمُوْعَاً حَوَارِقَا",18,"ق",2,0],["تحذروا من بايعين الحباري","وتحملوا من غشهم ياصقاقير",19,"ر",1,1],["تحذرني من أن أتوق لمطمح","غريب ولا أعدو إليها كتمساح",20,"ح",1,0],["تحذرني السعاة وانت جافٍ","ويسعى بينك الواشي وبيني",21,"ن",2,0]]}