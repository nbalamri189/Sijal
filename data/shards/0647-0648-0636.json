{"poems":[[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38170","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56623","الكامل"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138025","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104806","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109512","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89201","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131133",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131207",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5186,"منبت الشاعر الكبير ثراها","https://www.poetsgate.com/ViewPoem.aspx?id=156467",""],[5431,"حول المذابح كم يطيب المرقصُ","https://www.poetsgate.com/ViewPoem.aspx?id=185558",""],[6001,"بنت العز","https://www.poetsgate.com/ViewPoem.aspx?id=376",""]],"verses":[["هُوَ ضِنَّةُ المُثري مِنَ ال","أَخلاقِ أَو مالُ العَديمِ",0,"م",1,0],["هو ضالة الأدباء فانشدها تجد","ما كنت من أمد مديد فاقدا",1,"د",2,0],["هوَ ضارِبٌ بِالصّولَجانِ كراته","لَكنَّها هيَ جَوهَرٌ أَو عسجَدُ",2,"د",1,0],["هو ضجعة ما أعقبتها نهضة","فقضى الضجيع كما أقض المضجع",3,"ع",1,0],["هوَ ضارِبٌ وسُيوفُهُ كثَواقِبٍ","هوَ مُطْعِمٌ وجِفانُهُ كَجِوابي",4,"ب",2,0],["هُوض المَحمُودُ فِى المَلإِ المُعَلَّى","هُوَ المَتلُو بشحَىِّ على الفَلاَحِ",5,"ح",1,0],["هو ضيفك الراجي مكارمك التي","عمت ذوي التقوى وهذا منهم",6,"م",1,0],["هو ضد الهوى يصد وينهى","عنه والقلب بالهوى مفنون",7,"ن",1,0],["هو ضمن أكفانٍ أتى لضريحه","خطاً شريفاً مثبتاً بطروس",8,"س",1,0],["هو ضخم كالدّب من غير فرق","وهي هيفاء تشبه الغصن رطبا",9,"ب",2,1],["هو ضربٌ من العقاب ومن يس","طيع يوماً لما قضيت مرداً",10,"د",2,0],["هُوَ ضَمَّ الكَونَ وعيًا وأتَى","مِنْ إلهِ الكَونِ فِي ضَمِّ الأصابِعْ",11,"ع",1,0],["هو ضلع الفن الضليع فلا غر","وإذا هاج ذكره الأضلاعا",12,"ع",2,0],["هو ضيغمٌ قنص الفؤاد بنابه","بين النياب هو السعيدُ المخلصُ",13,"ص",1,0],["هو ضيا عيوني ولو يقرب ويبعد","راضي بحبه وهو أغلى الأماني",14,"ن",2,0]]}