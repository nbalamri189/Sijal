{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[24,"أمن دمنة قفر تعاورها البلى","https://www.aldiwan.net/poem21859.html","الطويل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[54,"حنطته يا نصر بالكافور","https://www.aldiwan.net/poem27398.html","الكامل"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[88,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[49,"ألا من لمهموم الفؤاد حزينه","https://www.aldiwan.net/poem63167.html","الطويل"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[31,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[31,"صحا القلب عن ذكر أم البني","https://www.aldiwan.net/poem42498.html","المتقارب"],[105,"أدنو ويجمح بي الإباء فأعزب","https://www.aldiwan.net/poem43398.html","الكامل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[52,"أأسمع ما قال الحمام السواجع","https://www.aldiwan.net/poem26857.html","الطويل"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[50,"هل لك في مالي وعرضي معاً","https://www.aldiwan.net/poem24444.html","السريع"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6126","المتقارب"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[77,"أثار سناها والديار نوازح","https://www.poetsgate.com/ViewPoem.aspx?id=33819",""],[13,"وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=180781",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""]],"verses":[["وَاِذهَب بِنَفسِكَ أَن يُقالَ سَلا","وَصَفا لِداعي العَذلِ وَالفَنَدِ",0,"د",1,0],["وأذْهَبُ منْ صَبْري الى كلِّ مذْهَب","وكُلُّ كريمٍ لا يُقيمُ علَى خسْفِ",1,"ف",1,0],["وأذْهَبَ لَيْلَ الشّكّ صُبْحُ يَقينِهمْ","فأسْفَرَ منْ وَجْهِ الحَقائِقِ واضِحُ",2,"ح",1,0],["وَإِذ هِيَ كَغُصنِ البانِ خَفَّاقَةَ الحَشى","يَروعُكَ مِنها حُسنُ دَلٍّ وَطيبُها",3,"ب",3,0],["وَإِذ هَصَرنا فُنونَ الوَصلِ دانِيَةً","قِطافُها فَجَنَينا مِنهُ ما شينا",4,"ن",2,0],["وَإِذ هِيَ سَوداءُ مِثلُ الفُحَيمِ","تَغَشّى المَطانِبَ وَالمَنكِبا",5,"ب",2,0],["وَإِذ هِيَ تَمشي كَمَشيِ النَزي","فِ يَصرَعُهُ بِالكَثيبِ البُهُر",6,"ر",1,0],["وَاِذهَب كَما ذَهَبَ الوَفاءُ فَإِنَّهُ","عَصَفَت بِهِ ريحا صَباً وَدَبورِ",7,"ر",1,0],["وَإِذ هُنَّ أَكتادٌ بِحَوضى كَأَنَّما","زَها الآلُ عِندانَ النَخيلِ البَواسِقِ",8,"ق",1,0],["واذهبوا به كل مذهب","فالقدر يمسك عنين",9,"ن",1,0],["واذهب إلى عمانويل الذي","دبّ البلى في مجده فاندثر",10,"ر",1,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ تَرتَعي","بِمُندَفَعِ الوادي أَراكاً مُنَظَّما",11,"م",2,0],["وَإِذ هُوَ حَولَكَ حَسَنُ القُصورِ","وَطيبُ الرِياضِ وَصَفوُ الزَمَن",12,"ن",1,0],["وَإِذ هُوَ كَالشِبلِ يَحكي الأُسودَ","أَدَلَّ بِمِخلَبِهِ وَاِفتَتَن",12,"ن",1,0],["وإذ هو كاليَماني العَضْبِ يَسطُو","فيَنقَعُ غُلَّةَ العَضْبِ اليَماني",13,"ي",1,0],["وَإِذ هُوَ لا يَدري لَعَلَّ كِتابَهُ","سَيُعطاهُ مَنشوراً بِغَيرِ يَمينِهِ",14,"ن",2,0],["وَإِذ هَصَرنا غُصونَ الأُنسِ دانِيَةً","قُطوفُها فَجَنَينا مِنهُ ما شينا",15,"ن",2,0],["وَإِذ هُوَ مُطلِقُ كَبلِ المَصيفِ","وَإِذ هُوَ مِفتاحُ قَيدِ الشِتاءِ",16,"ا",2,0],["وَإِذ هِيَ شَأنُكَ تُعنى بِهِ","وَإِذ غَيرُها لَيسَ مِن شانِكا",17,"ك",2,0],["وَإِذ هِيَ تِربُكَ تِربُ الصَفاءِ","وَخِدنُكَ مِن دونِ أَخدانِكا",17,"ك",2,0],["وَإِذ هِيَ حَوراءُ رُعبوبَةٌ","ثِقالٌ مَتى ما تَقُم تَنبَتِر",18,"ر",1,0],["وَاِذهَب بِجُندِكَ في المَمالِكِ غازِياً","مُلكي أَعَزُّ حِمىً وَجُندي أَغلَبُ",19,"ب",1,0],["وَإِذ هُم لا لَبوسَ لَهُم تَقيهِم","وَإِذ صَمُّ السِلامِ لَهُم رِطابُ",20,"ب",1,0],["وَإِذ هِيَ مِثلُ البَدرِ يَفضَحُ لَيلَهُ","وَإِذ أَنا مُسوَدُّ المَفارِقِ يافِعُ",21,"ع",1,0],["وَإِذ هُوَ لا يَستَبُّ خِصمانِ عِندَهُ","وَلا الصَوتُ مَرفوعٌ بِجِدٍّ وَلا هَزلِ",22,"ل",1,0],["وَاِذهَب إِلى أَبعَدِ ما يُنتَوى","لا رَدَّكَ اللَهُ وَلا مالِيَه",23,"ه",1,0],["وَإِذ هِيَ مِثلُ الرَئمِ صيدَ غَزالُها","لَها نَظَرٌ ساجٍ إِلَيكَ تُواغِلُه",24,"ل",2,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ طَفلَةٌ","كَمِثلِ مَهاةٍ حُرَّةٍ أُمِّ فَرقَدِ",25,"د",1,0],["واذهَبي يا أُمَيمَ إن يَشَأ اللَّ","هُ يُنَفِّس مِن أَزمِ هَذا الخِناقِ",26,"ق",1,0],["وَإِذ هِيَ تَضحَكُ عَن نَيِّرٍ","لَذيذِ المُقَبَّلِ عَذبٍ خَصِر",27,"ر",1,0],["وَإِذ هِيَ مِثلُ مَهاةِ الكَثي","بِ تَحنو عَلى جُؤذَرٍ في خَمَر",27,"ر",1,0],["وَإِذ هُنَّ يَلحَظنَ العُيونَ سَوافِراً","وَيَستُرنَ بِالأَيدي عَلى الوَجَناتِ",28,"ت",1,0],["واذْهبْ كما ذَهب الشباب مُشَيَّعاً","بِدم الجُفونِ وحُرْقة الأكْباد",29,"د",1,0],["وإذ هم بأكناف الخنادق مالهم","مضاجع غيرُ التُّرب لو نَفَعَ الترب",30,"ب",1,0],["وأذهب ليل الشك صبح يقينهم","فأسفر من فجر الحقائق واضح",31,"ح",1,0],["وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","صَغْوَا وَحُلَّنْ بِالْجَمِيعِ الْحَوْشَبَا",32,"ب",2,1],["وإذ هنَّ أكتادٌ بحوضى كأنما","زها الآلُ عيدانَ النَّخيلِ البواسقِ",33,"ق",1,0]]}