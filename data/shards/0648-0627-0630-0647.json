ctabudhabi.ae/diwan/poem/117202","الطويل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130266","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[1901,"وداعاً بَني أُمي فَقدْ آنَ أنْ أَمضِي","https://www.poetsgate.com/ViewPoem.aspx?id=160417",""],[4859,"دعوني","https://www.poetsgate.com/ViewPoem.aspx?id=186774",""],[4119,"مررنا بجو فهاج الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=16054",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5582,"سَرَتْ بَعْدَما خامَرَ القَلْبَ ياسُ","https://www.poetsgate.com/ViewPoem.aspx?id=187156",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[5582,"نَعِيمٌ تَقَضَّى مُسْرِعاً فِي انْفِلاتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186755",""],[5751,"أميرة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214765",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""]],"verses":[["وَاِذهَب بِنَفسِكَ أَن يُقالَ سَلا","وَصَفا لِداعي العَذلِ وَالفَنَدِ",0,"د",1,0],["وأذْهَبُ منْ صَبْري الى كلِّ مذْهَب","وكُلُّ كريمٍ لا يُقيمُ علَى خسْفِ",1,"ف",1,0],["وأذْهَبَ لَيْلَ الشّكّ صُبْحُ يَقينِهمْ","فأسْفَرَ منْ وَجْهِ الحَقائِقِ واضِحُ",2,"ح",1,0],["وَإِذ هِيَ كَغُصنِ البانِ خَفَّاقَةَ الحَشى","يَروعُكَ مِنها حُسنُ دَلٍّ وَطيبُها",3,"ب",3,0],["وَإِذ هَصَرنا فُنونَ الوَصلِ دانِيَةً","قِطافُها فَجَنَينا مِنهُ ما شينا",4,"ن",2,0],["وَإِذ هِيَ سَوداءُ مِثلُ الفُحَيمِ","تَغَشّى المَطانِبَ وَالمَنكِبا",5,"ب",2,0],["وَإِذ هِيَ تَمشي كَمَشيِ النَزي","فِ يَصرَعُهُ بِالكَثيبِ البُهُر",6,"ر",1,0],["وَاِذهَب كَما ذَهَبَ الوَفاءُ فَإِنَّهُ","عَصَفَت بِهِ ريحا صَباً وَدَبورِ",7,"ر",1,0],["وَإِذ هُنَّ أَكتادٌ بِحَوضى كَأَنَّما","زَها الآلُ عِندانَ النَخيلِ البَواسِقِ",8,"ق",1,0],["واذهبوا به كل مذهب","فالقدر يمسك عنين",9,"ن",1,0],["واذهب إلى عمانويل الذي","دبّ البلى في مجده فاندثر",10,"ر",1,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ تَرتَعي","بِمُندَفَعِ الوادي أَراكاً مُنَظَّما",11,"م",2,0],["وَإِذ هُوَ حَولَكَ حَسَنُ القُصورِ","وَطيبُ الرِياضِ وَصَفوُ الزَمَن",12,"ن",1,0],["وَإِذ هُوَ كَالشِبلِ يَحكي الأُسودَ","أَدَلَّ بِمِخلَبِهِ وَاِفتَتَن",12,"ن",1,0],["وإذ هو كاليَماني العَضْبِ يَسطُو","فيَنقَعُ غُلَّةَ العَضْبِ اليَماني",13,"ن",2,0],["وَإِذ هُوَ لا يَدري لَعَلَّ كِتابَهُ","سَيُعطاهُ مَنشوراً بِغَيرِ يَمينِهِ",14,"ن",2,0],["وَإِذ هَصَرنا غُصونَ الأُنسِ دانِيَةً","قُطوفُها فَجَنَينا مِنهُ ما شينا",15,"ن",2,0],["وَإِذ هُوَ مُطلِقُ كَبلِ المَصيفِ","وَإِذ هُوَ مِفتاحُ قَيدِ الشِتاءِ",16,"ا",2,0],["وَإِذ هِيَ شَأنُكَ تُعنى بِهِ","وَإِذ غَيرُها لَيسَ مِن شانِكا",17,"ك",2,0],["وَإِذ هِيَ تِربُكَ تِربُ الصَفاءِ","وَخِدنُكَ مِن دونِ أَخدانِكا",17,"ك",2,0],["وَإِذ هِيَ حَوراءُ رُعبوبَةٌ","ثِقالٌ مَتى ما تَقُم تَنبَتِر",18,"ر",1,0],["وَاِذهَب بِجُندِكَ في المَمالِكِ غازِياً","مُلكي أَعَزُّ حِمىً وَجُندي أَغلَبُ",19,"ب",1,0],["وَإِذ هُم لا لَبوسَ لَهُم تَقيهِم","وَإِذ صَمُّ السِلامِ لَهُم رِطابُ",20,"ب",1,0],["وَإِذ هِيَ مِثلُ البَدرِ يَفضَحُ لَيلَهُ","وَإِذ أَنا مُسوَدُّ المَفارِقِ يافِعُ",21,"ع",1,0],["وَإِذ هُوَ لا يَستَبُّ خِصمانِ عِندَهُ","وَلا الصَوتُ مَرفوعٌ بِجِدٍّ وَلا هَزلِ",22,"ل",1,0],["وَاِذهَب إِلى أَبعَدِ ما يُنتَوى","لا رَدَّكَ اللَهُ وَلا مالِيَه",23,"ه",1,0],["وَإِذ هِيَ مِثلُ الرَئمِ صيدَ غَزالُها","لَها نَظَرٌ ساجٍ إِلَيكَ تُواغِلُه",24,"ل",2,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ طَفلَةٌ","كَمِثلِ مَهاةٍ حُرَّةٍ أُمِّ فَرقَدِ",25,"د",1,0],["واذهَبي يا أُمَيمَ إن يَشَأ اللَّ","هُ يُنَفِّس مِن أَزمِ هَذا الخِناقِ",26,"ق",1,0],["وَإِذ هِيَ تَضحَكُ عَن نَيِّرٍ","لَذيذِ المُقَبَّلِ عَذبٍ خَصِر",27,"ر",1,0],["وَإِذ هِيَ مِثلُ مَهاةِ الكَثي","بِ تَحنو عَلى جُؤذَرٍ في خَمَر",27,"ر",1,0],["وَإِذ هُنَّ يَلحَظنَ العُيونَ سَوافِراً","وَيَستُرنَ بِالأَيدي عَلى الوَجَناتِ",28,"ت",1,0],["واذْهبْ كما ذَهب الشباب مُشَيَّعاً","بِدم الجُفونِ وحُرْقة الأكْباد",29,"د",1,0],["وإذ هم بأكناف الخنادق مالهم","مضاجع غيرُ التُّرب لو نَفَعَ الترب",30,"ب",1,0],["وأذهب ليل الشك صبح يقينهم","فأسفر من فجر الحقائق واضح",31,"ح",1,0],["وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","صَغْوَا وَحُلَّنْ بِالْجَمِيعِ الْحَوْشَبَا",32,"ب",2,1],["وإذ هنَّ أكتادٌ بحوضى كأنما","زها الآلُ عيدانَ النَّخيلِ البواسقِ",33,"ق",1,0],["وَإِذ هَبَ مِن حُزن الغِواية وَالهَوى","وَاِرتَع في رَوض المَواهب وَالأَجر",34,"ر",1,0],["واذهل عني لا اكاد ارى سوى","خيال حبيبي في شهودي وفي طوري",35,"ر",2,0],["واذ هل ان ابصرت دمعة عاشق","حذارا وخوفا ان تكون لحبه",36,"ب",2,0],["وأذهل إن صدفتك في طريق","إلى أن يستقر بي المقام",37,"م",1,0],["واذهب ودعني أستضيء","بنور راقصة الظلام",38,"م",1,0],["واذهبوا لا تندُبوه فهو شعبٌ","ميتٌ ليس يُفيق",39,"ق",1,0],["واذهبي بي عن موامي وحدتي","واسحقي ذاتي كما يهوى العليم",40,"م",1,0],["وَأَذهَبَ كُلَّ ما أَحوي ضَياعاً","فَها أَنا ذا بِنارِ الفَقرِ صالِ",41,"ل",1,0],["وأذهب الجور حتى لا يرى أثراً","له لديك ولا يلقى له خبراً",42,"ر",2,0],["وأذهلت كلَّ شخص عن سجيتهِ","حتى استوى في الاسا الجهالُ والعقلا",43,"ل",2,0],["وأَذهَبُ غَضبَاناً وأرجِعُ راضياً","وأُقسِمُ ما أَرضَيتِنى بَينَ ذلكِ",44,"ك",1,0],["وَإِذ هِيَ خَودٌ يَكادُ الحَلي","مُ مِن حُسن بَهجَتِها يُشغَفُ",45,"ف",1,0],["واذهل حتى لا ارى متغزلا","بغزلان قيس او ظباء بني ذهل",46,"ل",1,0],["وَإِذ هيَ سَوداءُ مِثلُ الجَنا","حِ تَغَشّى المَطانِبَ وَالمَنكَبا",47,"ب",2,0],["وَأذهبتُ في أَعطافِ مجدك حلّةً","طَوى حُسنَها من مذهبات الألى نشرا",48,"ر",2,0],["وأذهلهُ أن أيّامَه","زوارقُ لا تعرفُ المرفَأ",49,"ف",2,0],["وأذهلته رؤاه","فلم يعُد كالقلوب",50,"ب",1,0],["واذهب إليه وصف أسا","ي وما أحلّ بجسميه",51,"ي",2,0],["وَإِذ هِمَّتِي تُثنَى إلى غَيرِ هَمِّها","وَلا أنا مأخُوذٌ عَلَيَّ طَرِيقُ",52,"ق",1,0],["وأُذهلَتِ المَرَاضِعُ عَن بَنِيهَا","وَأنسِيَ أمَّهُ الضَّرعَ التَّبِيعُ",53,"ع",1,0],["وأذهَلَنا إليه اليومَ شوقٌ","فكِدْنا أن نصيرَ بلا عقول",54,"ل",1,0],["وأَذْهَلَهُمْ جَدْوَاكَ عن كلِّ مَفْخَرٍ","وإِنْ فَخَرَتْ ذُهْلٌ بِهَا واللَّهَازِمُ",55,"م",1,0],["واذهب بسيرته لربك خاشعاً","ونصيبك الإعزاز والإقبال",56,"ل",1,0],["وأذهلَهَا عَن حَالِهَا فَرطُ وَجدِهَا","عَليهِ وَقَد يُستَسهَلُ الصَّعبُ لِلصَّعبِ",57,"ب",1,0],["وَاِذ هُنَّ يُدنين الكَريم بودِّه","لَهن وَيرفُضن الدَقيق المُلّوما",58,"م",2,0],["وَاِذهَب إِلى عَرَبٍ تَرضى بِنِسبَتِهِم","إِنّي أَرى لَكَ خَلقاً يُشبِهُ العَرَبا",59,"ب",2,0],["واذهب يا كأس فإنك من","وهم تمضي طورا وتجي",60,"ج",2,0],["وأذهبوا دينهم فزالا","وانقلبوا لغيهم ضلالا",61,"ل",2,0],["وأَذهبَ سخطَك عني رِضاك","فنغَّص بُعْدُك ذاك الرِّضا",62,"ض",2,0],["واِذهَب فذِكرُكَ بيننا","باقٍ وحسن ثناكَ دائِم",63,"م",1,0],["وأذهبت نفسي للحقائق ذاهبا","فألفيتني قلباً يدبر قالبا",64,"ب",2,0],["وَأَذهَب عَنهُ زادَ عُلاه سقماً","يُساق عَلى الدَوام إِلى الأَعادي",65,"د",2,0],["وَأَذهب عَنها الرُعبَ حَيث أَمدّها","بِأَمن حَليف لِلدَوام بِلا فَصل",66,"ل",1,0],["وإذ هزّت الأرض غارت مذاخر","وقد قل ماء هناك لذاخر",67,"ر",1,1],["وأُذْهِلُِ نَفْسِي في هَوَى عِيْسَوِيَّةٍ","بها ضَلَّتِ النَّفْسُ الحَنِيْفَيَّةُ الهَدْيَا",68,"ا",1,0],["وأَذْهَلَها داعِي النَّوَى عن تَنَقُّبٍ","فَحَيَّا مُحَيَّاهَا بِتُفَّاحِ لُبْنَانِ",69,"ن",1,0],["وَأذْهَبَ عَقْلِي مِنْهُ ثَغْرٌ مُفَضَّضٌ","فَلِلَّهِ عَقْلٌ بِالْمُفَضَّضِ مُذْهَبُ",70,"ب",1,0],["وأذهب بالخيف المخوف وفي مني","أقضي لباناتي وأهدي وأوسم",71,"م",1,0],["وأذهب بالصفراء صفر قطيعة","تقطع منها القلب فهو متيم",71,"م",1,0],["وَإِذ هيَ مِن حُسنها كالسرا","جِ لَم يعش منه الضياء نحاسُ",72,"س",1,0],["وَاِذهَب كَما ذَهَبَ الشَبابُ فَإِنَّهُ","قَد كانَ خَيرَ مُصاحِب وَعَشير",73,"ر",1,0],["وَأَذْهَبْتَ عَنَّا فِتْنَةً جَاهِلِيَّةً","لَهَا فِي حَشَى الإسْلاَمِ أَيُّ تَوَقُّدِ",74,"د",1,0],["وَاِذهَب بِنَفسِكَ أَن ترى","إِلّا عَدُواً أَو صَديقا",75,"ق",2,0],["وأذهلهمْ حبُّ التُراثِ فكفكفوا","به زفرةً تعتادُ أو عَبْرةً تجري",76,"ر",2,0],["وأذهب في بحرها ثمدها","وغرق في اللج أوشالها",77,"ل",3,0],["واذ هجرت متيماً","غادرته غرض المحن",78,"ن",1,0],["وأذهب الوجد عن قلب الشجي ولي","قلب به الوجد يقضي شهوة الضاري",79,"ر",2,0],["وَإِذ هي أَمّا نَفسُها فَأَرِيبَةٌ","لِلهوٍ وَأَمّا عَن صِبا فَتذودُها",80,"د",3,0],["وَإِذ هِيَ كَالبِكرِ الهِجانِ إِذا مَشَت","أَبى لا يُماشيها القِصار الدرادِحُ",81,"ح",1,0],["وَإِذ هِيَ عَذبَةُ الأَنيابِ خَودٌ","تُعيشُ بِريقِها العَطِشَ المَجودا",82,"د",2,0],["وَإِذ هِيَ خَودٌ كَالوَذيلَةِ بادِنٌ","أَسيلَةُ ما يَبدو مِنَ الجَيبِ وَالنَحرِ",83,"ر",1,0],["واذهب بنفس لم تضع لتحلها","حيث احتللت بها وأنت عليمُ",84,"م",1,0],["وإذ هداه نشرها جاءنا","يطوي قصى الأرض طي القريب",85,"ب",1,0],["وإذ هي عبقريّتي التي لا","تحيط بها العوام ولا الخواص",86,"ص",1,0],["وأذهب للتنزه في اختيال","وأعرج بين أنواع الجمال",87,"ل",1,0],["وأذهل سكرة من فرط حُب","وَكم أهْدى النسيم إِلَيّ عطرا",88,"ر",2,0],["واذهب عقلي الحزن من ولهي وعن","صبابةِ أشواقي رقيقُ الهوى يُنبي",89,"ب",2,0],["وَاِذهب بإنجيلك نحوَ السما","وَعد إِلى الأَرض بقرآنِ",90,"ن",1,0],["واذهب لشأنك ان مقلتها","سبقت ببابل قهوة السحر",91,"ر",1,0],["وَاِذ هصرنا غُصونُ البان دانِيَةً","قُطوفُها فَجَنينا مِنهُ ما شينا",92,"ن",2,0],["واذهب إليه في الأصيل وفي الضحى","تلقى جميل أصيله وضحاه",93,"ا",2,0],["واذ هاجني ذكراكِ غابت وعنهم","لانجم غربي من عيوني مطلعُ",94,"ع",1,0],["واذهب عنهم كل رجسٍ كرامةً","وطهّرهم أنعم بهذا العطا الجزل",95,"ل",1,0],["وأذهلت المراضعُ عن بنيها","لحيرتها وعطلت العشار",96,"ر",1,0],["وإذْ هي صفراءُ الترائبِ غادة","تحفُّ بها الغيدُ الغَواني الأوانسُ",97,"س",1,0],["وأذهلَهُ ما رأى ما لها","وقد رأتِ النفسُ أوحالها",98,"ل",3,0],["وأذهبِ الفيرانَ ليلاً والنهارْ","عنّا جميعاً يا محيطُ قهَّارْ",99,"ر",1,0],["وَاِذهَب إِلى فرسايَ إِنَّ قُصورَها","فيها اِعتِبارٌ لِلمُلوكِ تَجَسَّما",100,"م",2,0],["وأَذهل حتى أَحسب الصَدَّ والنوى","بمُعْتَرَك الذكرى وِصالاً ومُلْتقى",101,"ق",2,0],["وأذَهلني حتى وقفتُ كأننيّ","أناجيكَ بالاشواق من حَيث تسمع",102,"ع",1,0],["وَأَذهِب بمحض الفَضلِ حيرَتي الَّتي","ضَللت بِها رُشدي وَزادَ التحيُّرُ",103,"ر",1,0],["وإذ هيَ لا تعتَلُّ عنّي برقبَةٍ","ولا خوفِ عينٍ من وشاةٍ ولا بعلِ",104,"ل",1,0],["وأذهل عن داري وأجعل نهبها","لعرضي من باقي المذلة حالبا",105,"ب",2,0],["وأُذهِلَت الأصولُ وواضعوها","ذهولَ الضب أخرجه الوِجار",106,"ر",1,0],["وأَذهب مَجروماً عليَّ وجارِ ما","وأمري إلى رب المسواتِ والأرضِ",107,"ض",1,0],["وأذهب للبراءة دون زيفٍ","يقود مشاعري نحو الجنونِ",108,"ن",1,0],["وأذهلني الوجد عنها فما","ذكرت سوى عهدكم في سوى",109,"و",2,0],["وأذهل عن الآم نفسي ولؤمها","وأشرب كأس الوصل وهو ضريب",110,"ب",1,0],["وَإِذْ هِيَ مِنْ حُسْنِها كالسِّرا","جِ لَمْ يَغْشَ مِنْهُ الضِّياءَ نُحاسُ",111,"س",1,0],["وَإِذْ هِيَ لَمْ تَبْخَلْ عَلَيَّ بِوَصْلِها","وَلا صَفْوُ حَوْضِي عِنْدَها يَتَكَدَّرُ",112,"ر",1,0],["[ وَإِذْ هوَ كالغُصْنِ الَّذِي هوَ ماؤُهُ","تَجارَى بِهِ فَاهْتَزَّ فِي نَضَراتِهِ ]",113,"ت",2,0],["وأذهلَهُ تدلُّلُها عليهِ","فألْقَتْ فيهِ أشْرِعَةً عنيدَهْ",114,"د",2,0],["واذهبْ يا إلهي كل غمٍّ","ففي الأمصار معتّرٌ وزاهدْ",115,"د",1,0],["وَاذهَبْ بِسَمعِكَ حَيثُ جُلُّ حَديثِهمْ","جَلَلٌ ، وَحاذِرْ أنْ تَكيلَ سِجالا",116,"ل",2,0],["وأذهب مدرستي وتُقيم ال","بناتُ لعرشِ صفائي احتفالا",117,"ل",2,0],["واذهب إليه أنت واملأ بالرؤى","سنَماً تخَزِّن فيه ناجي النورِ",118,"ر",1,0],["وأذهب قد ملكت العمرَ شيئاً","يظلُّ بوحشتي انسي وسعدي",119,"د",2,0],["وأذهل هاتيك النفوس فخفضت","من البهر والإعياء دقات طافر",120,"ر",1,0],["وأذهل هاتيك النفوس فخفضت","ز من البهر والإعياء دقات طافر",120,"ر",1,0],["وإذْ هَيّاتْ للنوم ِ أجفانَ قَريَتي","تباشِيرُ أحلام ٍ مِن الفجر ألطَفُ",121,"ف",1,0]]}