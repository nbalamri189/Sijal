{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[24,"أمن دمنة قفر تعاورها البلى","https://www.aldiwan.net/poem21859.html","الطويل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[54,"حنطته يا نصر بالكافور","https://www.aldiwan.net/poem27398.html","الكامل"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[88,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[49,"ألا من لمهموم الفؤاد حزينه","https://www.aldiwan.net/poem63167.html","الطويل"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[31,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[31,"صحا القلب عن ذكر أم البني","https://www.aldiwan.net/poem42498.html","المتقارب"],[105,"أدنو ويجمح بي الإباء فأعزب","https://www.aldiwan.net/poem43398.html","الكامل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[52,"أأسمع ما قال الحمام السواجع","https://www.aldiwan.net/poem26857.html","الطويل"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[50,"هل لك في مالي وعرضي معاً","https://www.aldiwan.net/poem24444.html","السريع"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6126","المتقارب"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[77,"أثار سناها والديار نوازح","https://www.poetsgate.com/ViewPoem.aspx?id=33819",""],[13,"وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=180781",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""],[110,"أما آن أن تصحو العقول من السكر","https://www.aldiwan.net/poem16683.html","الطويل"],[116,"اذا ما اتى ريم الغوير بخاطري","https://www.aldiwan.net/poem41103.html","عموديه"],[116,"خذا من صبا نجد امانا لقلبه","https://www.aldiwan.net/poem41232.html","عموديه"],[116,"غرام لا يقابل غرام","https://www.aldiwan.net/poem41659.html","الوافر"],[125,"لما وجدت مكارم الأخلاق","https://www.aldiwan.net/poem23750.html","مجزوء الكامل"],[130,"كفنوه وادفنوه أسكنوه","https://www.aldiwan.net/poem67458.html","الرمل"],[133,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[144,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[161,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[161,"ما خيب الله فيه للورى أملا","https://www.aldiwan.net/poem58899.html","البسيط"],[182,"قفى يا اميم القلب نقض لبانة","https://www.aldiwan.net/poem59092.html","الطويل"],[196,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[249,"خلقت امرأ لا أخلط الجد بالهزل","https://www.aldiwan.net/poem1317.html",""],[294,"أيا هند لا تنكحي بوهةً","https://www.aldiwan.net/poem411.html",""],[306,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[329,"المجتث","https://www.aldiwan.net/poem55010.html","المجتث"],[329,"يا ليل قد طلع الصباح","https://www.aldiwan.net/poem55076.html","مجزوء الكامل"],[358,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[358,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[417,"ألا يا سيد العلماء طرا","https://www.aldiwan.net/poem53869.html","الوافر"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[501,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[517,"اذا البيض لا يأتين في الحب رقة","https://www.aldiwan.net/poem48596.html","الطويل"],[554,"بنو حنيفة لا يرضى الدعي بهم","https://www.aldiwan.net/poem68389.html","البسيط"],[559,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"]],"verses":[["وَاِذهَب بِنَفسِكَ أَن يُقالَ سَلا","وَصَفا لِداعي العَذلِ وَالفَنَدِ",0,"د",1,0],["وأذْهَبُ منْ صَبْري الى كلِّ مذْهَب","وكُلُّ كريمٍ لا يُقيمُ علَى خسْفِ",1,"ف",1,0],["وأذْهَبَ لَيْلَ الشّكّ صُبْحُ يَقينِهمْ","فأسْفَرَ منْ وَجْهِ الحَقائِقِ واضِحُ",2,"ح",1,0],["وَإِذ هِيَ كَغُصنِ البانِ خَفَّاقَةَ الحَشى","يَروعُكَ مِنها حُسنُ دَلٍّ وَطيبُها",3,"ب",3,0],["وَإِذ هَصَرنا فُنونَ الوَصلِ دانِيَةً","قِطافُها فَجَنَينا مِنهُ ما شينا",4,"ن",2,0],["وَإِذ هِيَ سَوداءُ مِثلُ الفُحَيمِ","تَغَشّى المَطانِبَ وَالمَنكِبا",5,"ب",2,0],["وَإِذ هِيَ تَمشي كَمَشيِ النَزي","فِ يَصرَعُهُ بِالكَثيبِ البُهُر",6,"ر",1,0],["وَاِذهَب كَما ذَهَبَ الوَفاءُ فَإِنَّهُ","عَصَفَت بِهِ ريحا صَباً وَدَبورِ",7,"ر",1,0],["وَإِذ هُنَّ أَكتادٌ بِحَوضى كَأَنَّما","زَها الآلُ عِندانَ النَخيلِ البَواسِقِ",8,"ق",1,0],["واذهبوا به كل مذهب","فالقدر يمسك عنين",9,"ن",1,0],["واذهب إلى عمانويل الذي","دبّ البلى في مجده فاندثر",10,"ر",1,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ تَرتَعي","بِمُندَفَعِ الوادي أَراكاً مُنَظَّما",11,"م",2,0],["وَإِذ هُوَ حَولَكَ حَسَنُ القُصورِ","وَطيبُ الرِياضِ وَصَفوُ الزَمَن",12,"ن",1,0],["وَإِذ هُوَ كَالشِبلِ يَحكي الأُسودَ","أَدَلَّ بِمِخلَبِهِ وَاِفتَتَن",12,"ن",1,0],["وإذ هو كاليَماني العَضْبِ يَسطُو","فيَنقَعُ غُلَّةَ العَضْبِ اليَماني",13,"ن",2,0],["وَإِذ هُوَ لا يَدري لَعَلَّ كِتابَهُ","سَيُعطاهُ مَنشوراً بِغَيرِ يَمينِهِ",14,"ن",2,0],["وَإِذ هَصَرنا غُصونَ الأُنسِ دانِيَةً","قُطوفُها فَجَنَينا مِنهُ ما شينا",15,"ن",2,0],["وَإِذ هُوَ مُطلِقُ كَبلِ المَصيفِ","وَإِذ هُوَ مِفتاحُ قَيدِ الشِتاءِ",16,"ا",2,0],["وَإِذ هِيَ شَأنُكَ تُعنى بِهِ","وَإِذ غَيرُها لَيسَ مِن شانِكا",17,"ك",2,0],["وَإِذ هِيَ تِربُكَ تِربُ الصَفاءِ","وَخِدنُكَ مِن دونِ أَخدانِكا",17,"ك",2,0],["وَإِذ هِيَ حَوراءُ رُعبوبَةٌ","ثِقالٌ مَتى ما تَقُم تَنبَتِر",18,"ر",1,0],["وَاِذهَب بِجُندِكَ في المَمالِكِ غازِياً","مُلكي أَعَزُّ حِمىً وَجُندي أَغلَبُ",19,"ب",1,0],["وَإِذ هُم لا لَبوسَ لَهُم تَقيهِم","وَإِذ صَمُّ السِلامِ لَهُم رِطابُ",20,"ب",1,0],["وَإِذ هِيَ مِثلُ البَدرِ يَفضَحُ لَيلَهُ","وَإِذ أَنا مُسوَدُّ المَفارِقِ يافِعُ",21,"ع",1,0],["وَإِذ هُوَ لا يَستَبُّ خِصمانِ عِندَهُ","وَلا الصَوتُ مَرفوعٌ بِجِدٍّ وَلا هَزلِ",22,"ل",1,0],["وَاِذهَب إِلى أَبعَدِ ما يُنتَوى","لا رَدَّكَ اللَهُ وَلا مالِيَه",23,"ه",1,0],["وَإِذ هِيَ مِثلُ الرَئمِ صيدَ غَزالُها","لَها نَظَرٌ ساجٍ إِلَيكَ تُواغِلُه",24,"ل",2,0],["وَإِذ هِيَ حَوراءُ المَدامِعِ طَفلَةٌ","كَمِثلِ مَهاةٍ حُرَّةٍ أُمِّ فَرقَدِ",25,"د",1,0],["واذهَبي يا أُمَيمَ إن يَشَأ اللَّ","هُ يُنَفِّس مِن أَزمِ هَذا الخِناقِ",26,"ق",1,0],["وَإِذ هِيَ تَضحَكُ عَن نَيِّرٍ","لَذيذِ المُقَبَّلِ عَذبٍ خَصِر",27,"ر",1,0],["وَإِذ هِيَ مِثلُ مَهاةِ الكَثي","بِ تَحنو عَلى جُؤذَرٍ في خَمَر",27,"ر",1,0],["وَإِذ هُنَّ يَلحَظنَ العُيونَ سَوافِراً","وَيَستُرنَ بِالأَيدي عَلى الوَجَناتِ",28,"ت",1,0],["واذْهبْ كما ذَهب الشباب مُشَيَّعاً","بِدم الجُفونِ وحُرْقة الأكْباد",29,"د",1,0],["وإذ هم بأكناف الخنادق مالهم","مضاجع غيرُ التُّرب لو نَفَعَ الترب",30,"ب",1,0],["وأذهب ليل الشك صبح يقينهم","فأسفر من فجر الحقائق واضح",31,"ح",1,0],["وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","صَغْوَا وَحُلَّنْ بِالْجَمِيعِ الْحَوْشَبَا",32,"ب",2,1],["وإذ هنَّ أكتادٌ بحوضى كأنما","زها الآلُ عيدانَ النَّخيلِ البواسقِ",33,"ق",1,0],["وَإِذ هَبَ مِن حُزن الغِواية وَالهَوى","وَاِرتَع في رَوض المَواهب وَالأَجر",34,"ر",1,0],["واذهل عني لا اكاد ارى سوى","خيال حبيبي في شهودي وفي طوري",35,"ر",2,0],["واذ هل ان ابصرت دمعة عاشق","حذارا وخوفا ان تكون لحبه",36,"ب",2,0],["وأذهل إن صدفتك في طريق","إلى أن يستقر بي المقام",37,"م",1,0],["واذهب ودعني أستضيء","بنور راقصة الظلام",38,"م",1,0],["واذهبوا لا تندُبوه فهو شعبٌ","ميتٌ ليس يُفيق",39,"ق",1,0],["واذهبي بي عن موامي وحدتي","واسحقي ذاتي كما يهوى العليم",40,"م",1,0],["وَأَذهَبَ كُلَّ ما أَحوي ضَياعاً","فَها أَنا ذا بِنارِ الفَقرِ صالِ",41,"ل",1,0],["وأذهب الجور حتى لا يرى أثراً","له لديك ولا يلقى له خبراً",42,"ر",2,0],["وأذهلت كلَّ شخص عن سجيتهِ","حتى استوى في الاسا الجهالُ والعقلا",43,"ل",2,0],["وأَذهَبُ غَضبَاناً وأرجِعُ راضياً","وأُقسِمُ ما أَرضَيتِنى بَينَ ذلكِ",44,"ك",1,0],["وَإِذ هِيَ خَودٌ يَكادُ الحَلي","مُ مِن حُسن بَهجَتِها يُشغَفُ",45,"ف",1,0],["واذهل حتى لا ارى متغزلا","بغزلان قيس او ظباء بني ذهل",46,"ل",1,0],["وَإِذ هيَ سَوداءُ مِثلُ الجَنا","حِ تَغَشّى المَطانِبَ وَالمَنكَبا",47,"ب",2,0],["وَأذهبتُ في أَعطافِ مجدك حلّةً","طَوى حُسنَها من مذهبات الألى نشرا",48,"ر",2,0],["وأذهلهُ أن أيّامَه","زوارقُ لا تعرفُ المرفَأ",49,"ف",2,0],["وأذهلته رؤاه","فلم يعُد كالقلوب",50,"ب",1,0],["واذهب إليه وصف أسا","ي وما أحلّ بجسميه",51,"ي",2,0],["وَإِذ هِمَّتِي تُثنَى إلى غَيرِ هَمِّها","وَلا أنا مأخُوذٌ عَلَيَّ طَرِيقُ",52,"ق",1,0],["وأُذهلَتِ المَرَاضِعُ عَن بَنِيهَا","وَأنسِيَ أمَّهُ الضَّرعَ التَّبِيعُ",53,"ع",1,0],["وأذهَلَنا إليه اليومَ شوقٌ","فكِدْنا أن نصيرَ بلا عقول",54,"ل",1,0],["وأَذْهَلَهُمْ جَدْوَاكَ عن كلِّ مَفْخَرٍ","وإِنْ فَخَرَتْ ذُهْلٌ بِهَا واللَّهَازِمُ",55,"م",1,0],["واذهب بسيرته لربك خاشعاً","ونصيبك الإعزاز والإقبال",56,"ل",1,0],["وأذهلَهَا عَن حَالِهَا فَرطُ وَجدِهَا","عَليهِ وَقَد يُستَسهَلُ الصَّعبُ لِلصَّعبِ",57,"ب",1,0],["وَاِذ هُنَّ يُدنين الكَريم بودِّه","لَهن وَيرفُضن الدَقيق المُلّوما",58,"م",2,0],["وَاِذهَب إِلى عَرَبٍ تَرضى بِنِسبَتِهِم","إِنّي أَرى لَكَ خَلقاً يُشبِهُ العَرَبا",59,"ب",2,0],["واذهب يا كأس فإنك من","وهم تمضي طورا وتجي",60,"ج",2,0],["وأذهبوا دينهم فزالا","وانقلبوا لغيهم ضلالا",61,"ل",2,0],["وأَذهبَ سخطَك عني رِضاك","فنغَّص بُعْدُك ذاك الرِّضا",62,"ض",2,0]]}