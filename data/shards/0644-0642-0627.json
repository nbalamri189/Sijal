https://www.poetsgate.com/ViewPoem.aspx?id=59738",""],[5277,"حذارِ","https://www.poetsgate.com/ViewPoem.aspx?id=185745",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5376,"دخلْتُك آمناً ولك ائتلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188462",""],[5457,"قاضي الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213338",""],[5809,"أشعر بيت","https://www.poetsgate.com/ViewPoem.aspx?id=205096",""],[5845,"أيرجعُلي قربُ الحبيبِ المعاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198432",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5969,"شَهدٌ بثغرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=199205",""],[5975,"الرسم الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=52992",""],[6068,"لأحلام في جوّ الغرام تردّدُ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175842",""],[6124,"يشاطر الهدب دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=121832",""],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[6277,"عبود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64440&r=&rc=3",""]],"verses":[["لِقاؤُكَ جَرَّ عَلَيَّ الفِراقا","وَما زادَني القُربُ إِلّا اِشتِياقا",0,"ق",2,1],["لِقاؤُهُما يُطَهِّرُ مِن جَناني","وَيَدرَأُ عَن رِدائي كُلَّ عابِ",1,"ب",1,0],["لَقانِعٌ بِالسَلامِ يَبلُغُني","أَشفي غَليلي بِهِ مِنَ الكَمَدِ",2,"د",1,0],["لَقالَ المُعوِلاتُ عَلَيهِ مِنهُم","لَقَد حانَت مَنِيَّتُهُ وَحانا",3,"ن",2,0],["لَقَالَ فِي بَدْءِ كُلِّ شَيءٍ","يَا لَيْتَ لِي هَذِهِ العُيُونَا",4,"ن",2,0],["لَقالوا هُوَ الموفي بِخُفرَةِ جارِهِ","وَذِمَّتِهِ يَوماً إِذا ما تَذَمَّما",5,"م",2,0],["لقاضي قضاة المسلمين عليّها","ندًى ويدٍ كالبارق المتهلّل",6,"ل",1,0],["لقاءُ جانٍ إلى العافينَ مُعتذرٍ","وفعلُ مُجْنٍ جنىً أحلى من الضَّرَبِ",7,"ب",1,0],["لقاؤك للأبدان روح وراحةٌ","وما كل من تلقاهُ بعدك ذا لُبِّ",8,"ب",1,0],["لقاء عليٍّ فيه عند اختبارهِ","وحزم أبي حفص وعدل أبي بكر",9,"ر",1,0],["لقاسم في كل حالاته","شمائل السيف وأخلاقه",10,"ق",2,0],["لَقالَ الأَباعِدُ وَالشامِتو","نَ كانَت كَلَيلَةِ أَهلِ الهُزَر",11,"ر",1,0],["لقاء الموت غاية كل حى","ولكن للحياة هوى مضل",12,"ل",1,0],["لقاءُ الأمانِي في ضمان القَواضِبِ","ونيلُ المعالي في ادِّراعِ السَّبَاسِبِ",13,"ب",1,1],["لَقاسَينَ لَيلاً دونَ قاسانَ لَم تَكَد","أَواخِرُهُ مِن بُعدِ قُطرَيهِ تُلحَقُ",14,"ق",1,0],["لَقالوا اِخسَآ يا اِبنَي خانٍ فَإِنَّكُم","لِئامٌ وَشَرّابونَ سُؤرَ المَشارِبِ",15,"ب",1,0],["لَقالوا إِنَّهُ مِلحٌ أُجاجٌ","أَرادَ بِهِ لَنا إِحدى الهَناتِ",16,"ت",1,0],["لِقاؤُكِ في حَيثُ اِلتَقَينا وَإِنَّما","أَطَعتُ مَواثيقَ الجَرِيِّ المُكَرَّرا",17,"ر",2,0],["لَقالا لَكُم كَنَت هَوازِنُ حِقبَةً","عَلى عَهدِ أَكّالِ المُرارِ القُماقِمِ",18,"م",1,0],["لَقالوا لَكُم كانَت هَوازِنُ حِقبَةً","عَلى عَهدِ أَكّالِ المِرارِ القُماقِمِ",19,"م",1,0],["لِقاؤُكَ مَخلوقاً عَصى اللَهَ لِلغِنى","وَلَم تَرَ مَخلوقاً عَصى اللَهَ لِلفَقرِ",20,"ر",1,0],["لَقامَ بِنَصرِهِ مِنّا رِجالٌ","تُزَرُّ عَلى دُروعِهِمُ القُلوبُ",21,"ب",1,0],["لقاؤه مُرْدٍ لأقرانه","إذا تلاقتْ حلقات البطان",22,"ن",1,0],["لَقامَ عَلَيهِم مِنجَنيقٌ يُظِلّهُمْ","بِصمّ مرادٍ ما لِما كَسَرَتْ جَبرُ",23,"ر",1,0],["لَقاحٌ فَلَم تَخدِجهُ بِالضَيمِ مِنَّةٌ","وَلا نالَ أَنفاً مِنهُ بِالذُلِّ نائِلُ",24,"ل",1,0],["لَقالَ صادِقُهُم أَن قَد بَلى جَسَدي","لَكِنَّ نارَ الهَوى في القَلبِ تَلتَهِبُ",25,"ب",1,0],["لَقامَ لا يَمنَعُهُ","مِمّا أَشاءُ الحَدَقُ",26,"ق",1,0],["لِقاؤُكَ مافيهِ لِمِثلِيَ خيرَةٌ","وَلا لَكَ فَاِنظُر أَينَ يُلتَمَسُ الشَبرُ",27,"ر",1,0],["لِقاءُ الناسِ أَلّجَأَني بِرُغمي","إِلى حُسنِ التَجَّمُّلِ وَالنِفاقِ",28,"ق",1,1],["لِقاكِ ماحٍ للذنو","ب كيف لي أن أعتبا",29,"ب",2,0],["لقاؤكما قد كان حُلمَ زماني","وعهدُكما للشرق فجرُ أماني",30,"ن",2,1],["لِقاءُ مَن عَلَّني نواهُ","بُرئي فَيا حَبَّذا الرَحيلُ",31,"ل",1,0],["لَقالوا اخْسَآ يا بنَيْ دُخانٍ فإنّكُمْ","لِئَامٌ وَشَرّابُونَ سُؤرَ المَشَارِبِ",32,"ب",1,0],["لَقالا لَكُمْ كانَتْ هَوَازنُ حِقْبَةً","على عَهْدِ أكّالِ المُرَارِ القُماقِمِ",33,"م",1,0],["لقاب قوسين أو أدنى دنا ولقد","رأى جناباً من الجبار رحماني",34,"ن",2,0],["لقائل من هو يا عربيد","هذا الذي بذكره تشيد",35,"د",1,1],["لِقَاؤُكَ يا عَبدَ الإِلهِ هُوَ الشِّفَا","لِنَفسَى مِن دَاءٍ لَهُ في الحَشَا إختَفَا",36,"ف",2,1],["لقاؤك يا لُبنَى خَيالِ","فما منكما إلا غريمُ مِطالِ",37,"ل",1,1],["لقا جبلة وهي الأمر مذاقه","وفقدُ زبيد والحياة زبيدُ",38,"د",1,0],["لقاه احسن من بشرى يحل بها","قيد الأسير ويكسي بعدها الحللا",39,"ل",2,0],["لِقاؤُكَ عامُهُ يَومٌ قَصيرٌ","لَدَيَّ وَيَومَ لا أَلقاكَ عامُ",40,"م",1,1],["لقاؤكُم وقربُكُم","مُنَى نفسي وآمالي",41,"ل",2,0],["لَقارَعَ عَنها بِالصَوارِمِ وَالقَنا","أَبٌ نافِذُ السُلطانِ مُمتَثَلُ الأَمرِ",42,"ر",1,0],["لقائلها عَبد الرَحيم بن أَحمد","وَصاحبه عانى الذنوب ابن راشد",43,"د",1,0],["لِقاؤُكَ خَيرٌ مِن ضَمانٍ وَفِتنَةٍ","وَقَد عِشتُ أَيّاماً وَعِتُ لَيالِيا",44,"ي",2,0],["لقاء رب كريم","فرد لطيف خبير",45,"ر",1,0],["لَقال رسولُ اللّه للصحب مخبراً","بِحزبِ الوليّ الشاذلي سرّ آيةِ",46,"ه",1,0],["لقاصد من وجهه نظرة الرِضا","وَمن لَفظه البُشرى وَمن لحظه البَشر",47,"ر",1,0],["لقاؤكَ شاغلي عن ذكْرِ نَأْيٍ","سُروراً لي بقُربكَ واحْتِشاما",48,"م",2,0],["لِقاؤكَ هذا وهْو أكبَرُ نِعمة","على الدّينِ والدُّنيا منَ الله لو يُدْرى",49,"ر",2,0],["لَقَاظَ بجانبِ الشَّروَينِ منكم","جماجمُ تُحسَبُ الرَّخَمَ الوُقُوعا",50,"ع",2,0],["لِقاءٌ بِهِ إِلقاؤُنا لِعَصا السُرى","وَعِتقُ عِتاقِ الناجِياتِ الرَواسِمِ",51,"م",1,0],["لِقاءٌ هُو الماءُ لا","حَ لِلوارِدِ الحائِمِ",52,"م",1,0],["لقاءٌ في ظِلال الشرع، تحلو","به الدنيا، ويبتهج الرَّفيقُ",53,"ق",1,0],["لقاؤُكَ يُدني مُنى المُرْتَجي","ويفتَحُ بابَ الهَوى المُرْتَجِ",54,"ج",1,1],["لقاءُ أكثرِ مَنْ يلقاكَ أوزارُ","فلا تُبالِ أصَدُّوا عنكَ أوْ زاروا",55,"ر",3,1],["لقابَلْتُهُ بوجوهِ الوصالِ","ولاحظتُهُ بعيونِ الرضا",56,"ض",2,0],["لقالكم من عاثرين ولا لما","لغيركم من عاثر بظبا الدهر",57,"ر",1,0],["لقاءَكَ مَا لُقِّيتَ إلّا تَصَبُّراً","وحملَكَ مَا حُمِّلتَ إلّا تَجَلُّدا",58,"د",2,0],["لقامَ بها من لم يكن طالباً لها","يدافعُ قومٌ دونها وهو يدفعُ",59,"ع",1,0],["لقاءٌ على نَعمانَ كان غنيمةً","وهيهات يدنو بعد أن فات نازحا",60,"ح",2,0],["لقام إلى الدنيا فقام بأمرها","على فترة جَلْدُ الحصا وصليبُها",61,"ب",3,0],["لَقاحِ فلا سيفُ الخطوب بصارمٍ","جَريٍّ ولا سهمُ الرزايا براشقِ",62,"ق",1,0],["لِقاحٍ إذا أمسوا تَعيمُ ضُيوفُهمْ","إلى والجٍ تحت الطِّرافِ مُظَلَّلِ",63,"ل",1,0],["لَقالوا حَسَوْنا نَغْبَةً ووَرءاها","غَطامِطُ يَمٍّ لا يُكَفُّ بِساحِلِ",64,"ل",1,0],["لَقالَ قائِلُنا خُذ كلَّ جارحةٍ","لنا والْحَقْ بها الدُّنيا وما فيها",65,"ي",3,0],["لقاؤكِ يا سلمى وإنْ كان دائماً","يعزّ علينا أنْ يكون لماما",66,"م",2,1],["لِقاءٌ بجنحِ اللّيلِ طَلْقٌ محلُّهُ","وفي الصّبحِ محظورٌ عليَّ حَرامُ",67,"م",1,0],["لقاءٌ شفى بعض الغليل ولم أكنْ","عليه وإن كنتُ القديرَ قديرا",68,"ر",2,0],["لقاء جميل الوجه عنه أميط من","جميعي حجاب فهو بي متلالي",69,"ل",2,0],["لِقاؤُهُ في عُيونِ الكاشِحينَ قَذىً","ولَفظُهُ في صُدُورِ الحاسِدينَ شَجا",70,"ج",2,0],["لقاب اقتراب القرب حيث يسره","ولي غالب يقضي على الأمر أمره",71,"ه",1,0],["لقال لي وبديع القول يشهد لي","بمذود ببليغ النظم نطاق",72,"ق",1,0],["لقاب قَوسَينِ أَو أَدنى عَلا وَدَنا","وَقَلبُ حاسِدِهِ المضنى غَدا هَدَفا",73,"ف",2,0],["لقام يبحَرُ تيها","كالجاب في غُلُوائه",74,"ا",3,0],["لقال رُهباً ورُعباً يجمعان معاً","غُنمُ الحياةِ وهولُ النفس والشفق",75,"ق",1,0],["لِقاً لكَ يا ابنَ الأَكرَمينَ لِقاً لَكا","وَنَفسِيَ مِمّا تَشتَكيهِ فِداً لَكا",76,"ك",2,1],["لقال تدبيره الموحَي","لا تبرحوا أو تشاهدوه",77,"ه",1,0],["لقالوا إنني عبد لطه","وحسبي أن يكون لك استنادي",78,"د",2,0],["لِقاء وَتَوديع مَعاً في اِعتِناقة","كَأَن لَم يَكُن ذاكَ التلاقي تَلاقيا",79,"ي",2,0],["لقاءك أَملت يا سَيدي","وَلَو لَم ألاقك لَم أرشد",80,"د",1,1],["لقاً بأعالي الرمل من حصن سامةٍ","مستجىً على يأس الرجا من حياتيا",81,"ي",2,0],["لقانع بالسلام يبلغني","عنك فيشفي حرارة الكبد",82,"د",1,0],["لقاؤكَ أغلى من رُقادي على جفني","وقُرْبُكَ أَحلى من مُصاحَبة الأمن",83,"ن",1,1],["لِقاؤُها فراق","وَعُرسها طَلاق",84,"ق",1,0],["لقاؤكَ يحكي قضاءَ الحوائِجْ","ووجهُكَ للهمِّ والغمِّ فارِجْ",85,"ج",1,1],["لقاؤهُ أشهى من البارد ال","عَذْبِ إلى عطشانِ غصانِ",86,"ن",1,0],["لقام يهتز كالبان فتى","اغر أقنى في أنفه شمم",87,"م",1,0],["لِقاءً لِقاءً إِن لَقوا وَوَفادَةً","وَفِ