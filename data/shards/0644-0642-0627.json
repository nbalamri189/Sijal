{"poems":[[53,"لقاؤك جر علي الفراقا","https://www.aldiwan.net/poem29933.html","المتقارب"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[55,"إني وإن كنت لا أراك ولا","https://www.aldiwan.net/poem26410.html","المنسرح"],[9,"ألا من مبلغ عني حريثا","https://www.aldiwan.net/poem21987.html","الوافر"],[93,"لو قيل للحسن كيف تهوى","https://www.aldiwan.net/poem11207.html","مخلع البسيط"],[23,"أعين ألا ابكي سيد الناس واسفحي","https://www.aldiwan.net/poem21352.html","الطويل"],[72,"خليلي والأشواق تروي حديثها","https://www.aldiwan.net/poem19557.html","الطويل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"أبا حسن لا زلت منا على قرب","https://www.aldiwan.net/poem8326.html","الطويل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[26,"عرفت الديار لأم الرهين","https://www.aldiwan.net/poem24082.html","المتقارب"],[85,"بنى عبد السلام على أبيكم","https://www.aldiwan.net/poem7142.html","الوافر"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[28,"إن هجاء الباهلين دارماً","https://www.aldiwan.net/poem1280.html",""],[28,"ولو أسقيتهم عسلا مصفى","https://www.aldiwan.net/poem4962.html","الوافر"],[28,"وآلفة برد الحجال احتويتها","https://www.aldiwan.net/poem5224.html","الطويل"],[28,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[28,"سيبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5575.html","الطويل"],[58,"دليلك أن الفقر خير من الغنى","https://www.aldiwan.net/poem31043.html","الطويل"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[33,"لو سيل أهل الهوى من بعد موتهم","https://www.aldiwan.net/poem26021.html","البسيط"],[48,"علقت من علقني","https://www.aldiwan.net/poem64448.html","مجزوء الرجز"],[46,"جرى المين فيهم كابرا بعد كابر","https://www.aldiwan.net/poem22513.html","الطويل"],[46,"لقاء الناس ألجأني برغمي","https://www.aldiwan.net/poem23056.html","الوافر"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[28,"إن هجاء الباهليين دارما","https://www.poetsgate.com/ViewPoem.aspx?id=21710",""],[28,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[116,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[125,"لقائل من هو يا عربيد","https://www.aldiwan.net/poem23711.html","الرجز"],[133,"لقاؤك يا عبد الإله هو الشفا","https://www.aldiwan.net/poem54799.html","الطويل"],[143,"لقاؤك يا لبنى خيال","https://www.aldiwan.net/poem58405.html","الطويل"],[161,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[161,"والله ما صدق الواشي الذي نقلا","https://www.aldiwan.net/poem58999.html","البسيط"],[170,"لقاؤك عامه يوم قصير","https://www.aldiwan.net/poem1672.html",""],[230,"تغير بعدكم حالي","https://www.aldiwan.net/poem50843.html","مجزوء الوافر"],[236,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[272,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[301,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[305,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[306,"لك الحمد يا من خص أهل الطريقة","https://www.aldiwan.net/poem56591.html","الطويل"],[362,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[365,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[365,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[366,"قلت لعير جرم لا تراعي","https://www.aldiwan.net/poem44495.html","الوافر"],[367,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[372,"أنام وما لائمي","https://www.aldiwan.net/poem57105.html","مجزوء المتقارب"],[401,"على طريق العفاف","https://www.aldiwan.net/poem6793.html","عموديه"],[406,"لقاؤك يدني منى المرتجي","https://www.aldiwan.net/poem49620.html","المتقارب"],[406,"لقاء أكثر من يلقاك أوزار","https://www.aldiwan.net/poem49918.html","البسيط"],[433,"نضا من شبيبته ما نضا","https://www.aldiwan.net/poem12653.html","المتقارب"],[438,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[440,"فداؤك من لو كان في وسعه الفدا","https://www.aldiwan.net/poem34785.html","الطويل"],[459,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[459,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[462,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[462,"سألت إلهي أن يعيش بغبطة","https://www.aldiwan.net/poem16424.html","الطويل"],[501,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[552,"لقاؤك يا سلمى وإن كان دائما","https://www.aldiwan.net/poem47228.html","الطويل"],[552,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[552,"تزوريننا وهنا ولو زرت في الضحى","https://www.aldiwan.net/poem47798.html","الطويل"],[559,"لمن طلل بين الأجارع بالي","https://www.aldiwan.net/poem33537.html","الطويل"],[563,"قف بالديار إذا الليل البهيم سجا","https://www.aldiwan.net/poem52900.html","البسيط"]],"verses":[["لِقاؤُكَ جَرَّ عَلَيَّ الفِراقا","وَما زادَني القُربُ إِلّا اِشتِياقا",0,"ق",2,1],["لِقاؤُهُما يُطَهِّرُ مِن جَناني","وَيَدرَأُ عَن رِدائي كُلَّ عابِ",1,"ب",1,0],["لَقانِعٌ بِالسَلامِ يَبلُغُني","أَشفي غَليلي بِهِ مِنَ الكَمَدِ",2,"د",1,0],["لَقالَ المُعوِلاتُ عَلَيهِ مِنهُم","لَقَد حانَت مَنِيَّتُهُ وَحانا",3,"ن",2,0],["لَقَالَ فِي بَدْءِ كُلِّ شَيءٍ","يَا لَيْتَ لِي هَذِهِ العُيُونَا",4,"ن",2,0],["لَقالوا هُوَ الموفي بِخُفرَةِ جارِهِ","وَذِمَّتِهِ يَوماً إِذا ما تَذَمَّما",5,"م",2,0],["لقاضي قضاة المسلمين عليّها","ندًى ويدٍ كالبارق المتهلّل",6,"ل",1,0],["لقاءُ جانٍ إلى العافينَ مُعتذرٍ","وفعلُ مُجْنٍ جنىً أحلى من الضَّرَبِ",7,"ب",1,0],["لقاؤك للأبدان روح وراحةٌ","وما كل من تلقاهُ بعدك ذا لُبِّ",8,"ب",1,0],["لقاء عليٍّ فيه عند اختبارهِ","وحزم أبي حفص وعدل أبي بكر",9,"ر",1,0],["لقاسم في كل حالاته","شمائل السيف وأخلاقه",10,"ق",2,0],["لَقالَ الأَباعِدُ وَالشامِتو","نَ كانَت كَلَيلَةِ أَهلِ الهُزَر",11,"ر",1,0],["لقاء الموت غاية كل حى","ولكن للحياة هوى مضل",12,"ل",1,0],["لقاءُ الأمانِي في ضمان القَواضِبِ","ونيلُ المعالي في ادِّراعِ السَّبَاسِبِ",13,"ب",1,1],["لَقاسَينَ لَيلاً دونَ قاسانَ لَم تَكَد","أَواخِرُهُ مِن بُعدِ قُطرَيهِ تُلحَقُ",14,"ق",1,0],["لَقالوا اِخسَآ يا اِبنَي خانٍ فَإِنَّكُم","لِئامٌ وَشَرّابونَ سُؤرَ المَشارِبِ",15,"ب",1,0],["لَقالوا إِنَّهُ مِلحٌ أُجاجٌ","أَرادَ بِهِ لَنا إِحدى الهَناتِ",16,"ت",1,0],["لِقاؤُكِ في حَيثُ اِلتَقَينا وَإِنَّما","أَطَعتُ مَواثيقَ الجَرِيِّ المُكَرَّرا",17,"ر",2,0],["لَقالا لَكُم كَنَت هَوازِنُ حِقبَةً","عَلى عَهدِ أَكّالِ المُرارِ القُماقِمِ",18,"م",1,0],["لَقالوا لَكُم كانَت هَوازِنُ حِقبَةً","عَلى عَهدِ أَكّالِ المِرارِ القُماقِمِ",19,"م",1,0],["لِقاؤُكَ مَخلوقاً عَصى اللَهَ لِلغِنى","وَلَم تَرَ مَخلوقاً عَصى اللَهَ لِلفَقرِ",20,"ر",1,0],["لَقامَ بِنَصرِهِ مِنّا رِجالٌ","تُزَرُّ عَلى دُروعِهِمُ القُلوبُ",21,"ب",1,0],["لقاؤه مُرْدٍ لأقرانه","إذا تلاقتْ حلقات البطان",22,"ن",1,0],["لَقامَ عَلَيهِم مِنجَنيقٌ يُظِلّهُمْ","بِصمّ مرادٍ ما لِما كَسَرَتْ جَبرُ",23,"ر",1,0],["لَقاحٌ فَلَم تَخدِجهُ بِالضَيمِ مِنَّةٌ","وَلا نالَ أَنفاً مِنهُ بِالذُلِّ نائِلُ",24,"ل",1,0],["لَقالَ صادِقُهُم أَن قَد بَلى جَسَدي","لَكِنَّ نارَ الهَوى في القَلبِ تَلتَهِبُ",25,"ب",1,0],["لَقامَ لا يَمنَعُهُ","مِمّا أَشاءُ الحَدَقُ",26,"ق",1,0],["لِقاؤُكَ مافيهِ لِمِثلِيَ خيرَةٌ","وَلا لَكَ فَاِنظُر أَينَ يُلتَمَسُ الشَبرُ",27,"ر",1,0],["لِقاءُ الناسِ أَلّجَأَني بِرُغمي","إِلى حُسنِ التَجَّمُّلِ وَالنِفاقِ",28,"ق",1,1],["لِقاكِ ماحٍ للذنو","ب كيف لي أن أعتبا",29,"ب",2,0],["لقاؤكما قد كان حُلمَ زماني","وعهدُكما للشرق فجرُ أماني",30,"ن",2,1],["لِقاءُ مَن عَلَّني نواهُ","بُرئي فَيا حَبَّذا الرَحيلُ",31,"ل",1,0],["لَقالوا اخْسَآ يا بنَيْ دُخانٍ فإنّكُمْ","لِئَامٌ وَشَرّابُونَ سُؤرَ المَشَارِبِ",32,"ب",1,0],["لَقالا لَكُمْ كانَتْ هَوَازنُ حِقْبَةً","على عَهْدِ أكّالِ المُرَارِ القُماقِمِ",33,"م",1,0],["لقاب قوسين أو أدنى دنا ولقد","رأى جناباً من الجبار رحماني",34,"ن",2,0],["لقائل من هو يا عربيد","هذا الذي بذكره تشيد",35,"د",1,1],["لِقَاؤُكَ يا عَبدَ الإِلهِ هُوَ الشِّفَا","لِنَفسَى مِن دَاءٍ لَهُ في الحَشَا إختَفَا",36,"ف",2,1],["لقاؤك يا لُبنَى خَيالِ","فما منكما إلا غريمُ مِطالِ",37,"ل",1,1],["لقا جبلة وهي الأمر مذاقه","وفقدُ زبيد والحياة زبيدُ",38,"د",1,0],["لقاه احسن من بشرى يحل بها","قيد الأسير ويكسي بعدها الحللا",39,"ل",2,0],["لِقاؤُكَ عامُهُ يَومٌ قَصيرٌ","لَدَيَّ وَيَومَ لا أَلقاكَ عامُ",40,"م",1,1],["لقاؤكُم وقربُكُم","مُنَى نفسي وآمالي",41,"ل",2,0],["لَقارَعَ عَنها بِالصَوارِمِ وَالقَنا","أَبٌ نافِذُ السُلطانِ مُمتَثَلُ الأَمرِ",42,"ر",1,0],["لقائلها عَبد الرَحيم بن أَحمد","وَصاحبه عانى الذنوب ابن راشد",43,"د",1,0],["لِقاؤُكَ خَيرٌ مِن ضَمانٍ وَفِتنَةٍ","وَقَد عِشتُ أَيّاماً وَعِتُ لَيالِيا",44,"ي",2,0],["لقاء رب كريم","فرد لطيف خبير",45,"ر",1,0],["لَقال رسولُ اللّه للصحب مخبراً","بِحزبِ الوليّ الشاذلي سرّ آيةِ",46,"ه",1,0],["لقاصد من وجهه نظرة الرِضا","وَمن لَفظه البُشرى وَمن لحظه البَشر",47,"ر",1,0],["لقاؤكَ شاغلي عن ذكْرِ نَأْيٍ","سُروراً لي بقُربكَ واحْتِشاما",48,"م",2,0],["لِقاؤكَ هذا وهْو أكبَرُ نِعمة","على الدّينِ والدُّنيا منَ الله لو يُدْرى",49,"ر",2,0],["لَقَاظَ بجانبِ الشَّروَينِ منكم","جماجمُ تُحسَبُ الرَّخَمَ الوُقُوعا",50,"ع",2,0],["لِقاءٌ بِهِ إِلقاؤُنا لِعَصا السُرى","وَعِتقُ عِتاقِ الناجِياتِ الرَواسِمِ",51,"م",1,0],["لِقاءٌ هُو الماءُ لا","حَ لِلوارِدِ الحائِمِ",52,"م",1,0],["لقاءٌ في ظِلال الشرع، تحلو","به الدنيا، ويبتهج الرَّفيقُ",53,"ق",1,0],["لقاؤُكَ يُدني مُنى المُرْتَجي","ويفتَحُ بابَ الهَوى المُرْتَجِ",54,"ج",1,1],["لقاءُ أكثرِ مَنْ يلقاكَ أوزارُ","فلا تُبالِ أصَدُّوا عنكَ أوْ زاروا",55,"ر",3,1],["لقابَلْتُهُ بوجوهِ الوصالِ","ولاحظتُهُ بعيونِ الرضا",56,"ض",2,0],["لقالكم من عاثرين ولا لما","لغيركم من عاثر بظبا الدهر",57,"ر",1,0],["لقاءَكَ مَا لُقِّيتَ إلّا تَصَبُّراً","وحملَكَ مَا حُمِّلتَ إلّا تَجَلُّدا",58,"د",2,0],["لقامَ بها من لم يكن طالباً لها","يدافعُ قومٌ دونها وهو يدفعُ",59,"ع",1,0],["لقاءٌ على نَعمانَ كان غنيمةً","وهيهات يدنو بعد أن فات نازحا",60,"ح",2,0],["لقام إلى الدنيا فقام بأمرها","على فترة جَلْدُ الحصا وصليبُها",61,"ب",3,0],["لَقاحِ فلا سيفُ الخطوب بصارمٍ","جَريٍّ ولا سهمُ الرزايا براشقِ",62,"ق",1,0],["لِقاحٍ إذا أمسوا تَعيمُ ضُيوفُهمْ","إلى والجٍ تحت الطِّرافِ مُظَلَّلِ",63,"ل",1,0],["لَقالوا حَسَوْنا نَغْبَةً ووَرءاها","غَطامِطُ يَمٍّ لا يُكَفُّ بِساحِلِ",64,"ل",1,0],["لَقالَ قائِلُنا خُذ كلَّ جارحةٍ","لنا والْحَقْ بها الدُّنيا وما فيها",65,"ي",3,0],["لقاؤكِ يا سلمى وإنْ كان دائماً","يعزّ علينا أنْ يكون لماما",66,"م",2,1],["لِقاءٌ بجنحِ اللّيلِ طَلْقٌ محلُّهُ","وفي الصّبحِ محظورٌ عليَّ حَرامُ",67,"م",1,0],["لقاءٌ شفى بعض الغليل ولم أكنْ","عليه وإن كنتُ القديرَ قديرا",68,"ر",2,0],["لقاء جميل الوجه عنه أميط من","جميعي حجاب فهو بي متلالي",69,"ل",2,0],["لِقاؤُهُ في عُيونِ الكاشِحينَ قَذىً","ولَفظُهُ في صُدُورِ الحاسِدينَ شَجا",70,"ج",2,0]]}