{"poems":[[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[164,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[482,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136326","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[4691,"إهداء لزياد بنجر","https://www.poetsgate.com/ViewPoem.aspx?id=170289",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5789,"ينابيع الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=201411",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["يُوَزِّعُ بِالأَمراسِ كُلَّ عَمَلَّسٍ","مِنَ المُطَعَماتِ الصَيدَ غَيرِ الشَواحِنِ",0,"ن",1,0],["يوزع الأوقات في كسب العلا","كل لياليه ليالي قدر",1,"ر",1,0],["يوزَّعهُ البينُ المشتَّتُ ظالماً","على جيرةٍ بالمنحنى وربوعِ",2,"ع",1,0],["يوزع في طاعات مولاه عمره","بجد وفي مرضاته يسرد الصوما",3,"م",2,0],["يؤزره من خلفه متعمق","بحجة ذاك الملحف المتعمق",4,"ق",1,0],["يوزّعُ أطيافَ الفرائد منصفًا","فأكرمْ بهِ لم نلقَ شرواهُ أعدلا",5,"ل",2,0],["يوزع خلف مَتْرَسِه المنايا","على المحتل ميمنةً يسا را",6,"ر",2,0],["يوزع فينا السم لا نحن نتقي","ولا هو يرعى حقنا فيثوب",7,"ب",1,0],["يُوزّعُكَ الحِسُّ الشَّآمِيُّ في دَمِي","ِحُرُوفاً يُطِيلُ الصَّمتَ..فِيهَا جَوَابُهُ",8,"ب",2,0],["يؤزّه في اللظى غمزي، ويُذهلُهُ","عن الجحيم، وما فيه، ومَنْ فيهِ",9,"ي",2,0]]}