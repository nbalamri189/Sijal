{"poems":[[53,"ناك أبو العباس نيك الغت","https://www.aldiwan.net/poem8718.html","الرجز"],[53,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[47,"لابس من شبيبة أم ناض","https://www.aldiwan.net/poem64634.html","الخفيف"],[47,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[50,"ناك أبو العباس برك الفتناك","https://www.aldiwan.net/poem66236.html","الرجز"],[52,"ليس النعيم وإن كنا نزن به","https://www.aldiwan.net/poem63928.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[102,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[47,"لابِسٌ مِنْ شَبِيبَةٍ أمْ نَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=31132",""],[259,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[543,"سائلي عنه وعن سيرته","https://www.aldiwan.net/poem48201.html","عموديه"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61162","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205024","المنسرح"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68010","الخفيف"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95357","الرمل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32459","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4702,"مارد وشيطانيه","https://www.poetsgate.com/ViewPoem.aspx?id=155200",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[6093,"يا لشهد ليتني من رشفه","https://www.poetsgate.com/ViewPoem.aspx?id=203797",""],[6201,"تشكّلٌ أولي لزهرة ..على شاهد قبر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87488&r=&rc=12",""]],"verses":[["ناكَ أبو العباس نَيْكَ الغَتِّ","ناك على السَّمتِ وغير السَّمتِ",0,"ت",1,1],["ناكها ثم قال عُلْ ولديها","ذاك حكم العزيز في المعزوز",1,"ز",1,0],["نأكل اللحم ونرمي","بكراديس العُراق",2,"ق",1,0],["ناكرني ظالماً فناكره","صاحبُه فاستقادَ وانتقما",3,"م",2,0],["ناكَرَت لِمَّتي وَناكَرتُ مِنها","سوءَ هَذا الأَخلافِ وَالأَعواضِ",4,"ض",1,0],["ناكَرَتهُ الحَسناءُ أَبيَضَ بَضّاً","وَهَواها لَو كانَ أَسوَدُ وَحفُ",5,"ف",1,0],["ناكَ أبو العبّاسِ بركَ الفَتّ","ناكَ على السَمتِ وغير السمتِ",6,"ت",1,1],["ناكا وَنيكا إِلى أَن حَلَّ شَيبُهُما","في غَفلَةٍ عَن نَبِيِّ الرَحمَةِ الهادي",7,"د",2,0],["نَاكِسِي الهَامَاتِ حَتَّى يُشْهَدُوا","فِي لِقَاءِ القَادِرِينَ الصُّعْرِ صُعْرَا",8,"ر",2,0],["نَأْكلُ الأَرْضَ ثُمَّ تَأْكُلُنَا","الأَرْضُ دَوَالَيْكَ أفْرُعاً وَأُصُولاَ",9,"ل",2,0],["نأكل الجوع ونستسقي الظما","وننادي \" يحفظ الله الإماما \"",10,"م",2,0],["ناكَرَتْ لِمّتي، وَناكَرْتُ مِنها","سوءِ الأخلافِ وَالأعْوَاضِ",11,"ض",1,0],["ناكرٌ ذاك الحبيبُ","عندهُ، مالي نصيبُ",12,"ب",1,1],["ناكروا حلمي فجاهلتهمُ","فإذا أُحرِج ذو الحلم جَهِلْ",13,"ل",1,0],["ناكثُ العهدِ خَئونٌ غادِرٌ","فاجرُ الأيمانِ أفَّاكٌ أشِر",14,"ر",1,0],["نَأكله حلا عَلى بغضنا","فيهِ لما يعقب من ضير",15,"ر",1,0],["نأكل ثمنحن في انصرام","عن شكر ذي الجلال والإكرام",16,"م",1,0],["نأكل لا عن سغب وجوع","نشرب شرب الهيم من ينبوع",16,"ع",1,0],["نأكل خبز البر والفطيرا","أكلاً ذريعاً لم ندع تقصيرا",16,"ر",2,0],["ناكصات دونه للجحف","كم على الدهر له من وثبات",17,"ت",1,0],["نأكل عشب الثرى وترضعني","درا وتكسو بالصوف لي جسدا",18,"د",2,0],["ناكس الرأس خيفة من خطاه","ومساويه وهو صفر الأيادي",19,"ي",1,0],["نأكل الدَّسْمَ والغَريضَ ونسقي","أَكرمَ القوم مَحْض دَرِّ وخاثر",20,"ر",1,0],["نا كمن يشرب المدام دواما","أين مني من بالغرام تزيّا",21,"ي",2,0],["ناكصاً يخبط في عم","ياء لا يهدى السبيلا",22,"ل",2,0],["ناكَ وَاللَهِ جَوهَرَ الصَحّافُ","وَعَلَيها قَميصُها الأَفوافُ",23,"ف",1,1],["ناكَها ضَيفُها وَقَبَّلَ فاها","يا لِقَومي لَقَد طَغى الأَضيافُ",23,"ف",1,0],["ناكثا ثغرا لحامي الثغر وال","آية العظمى ومصباح الهدى",24,"ا",1,0],["ناكل ملذات من","خيرات بستانيه",25,"ن",3,0],["نأكل الفول وعدساً مهلكاً","والطحينية همّ أثقل",26,"ل",1,0],["نأكل الأيدي لتحيا دارنا","هكذا الحب بصدق لا كذب",27,"ب",1,0],["ناكِرٌ ما كانَ في عَهْدِ الصِّبَا","ربما أنكرَ مَنْ قدْ عَرَفَهْ",28,"ف",2,0],["ناكرًا إحسانَهُ أبدًا","هل يمنُّ النهرُ بالقطرَةْ ؟!",29,"ر",2,0]]}