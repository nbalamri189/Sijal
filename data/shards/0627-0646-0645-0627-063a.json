{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[90,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130076","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62868","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128889","الخفيف"],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5759,"غيا يتوب فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=213396",""],[5956,"كلُّ هاوٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181846",""]],"verses":[["إِنَّما غَرسُكَ نَبعٌ","وَمِنَ الغَرسِ ثُمامُ",0,"م",1,0],["إنما غايتي من الشعر معنىً","واضح يأمن اللبيب التباسه",1,"س",2,0],["إِنَّما غُصنٌ خَفيفٌ ناحِلٌ","تَلعَبُ الأَهواءُفيهِ كَهَواها",2,"ا",3,0],["إنّما غايةُ نفسي أن ترى","مَعهداً للبنت مرفوع العمَد",3,"د",1,0],["انَّما غَيرة عليكَ وبُقيا","صُنْتُهُ عن عيادةِ العُوَّادِ",4,"د",1,0],["انما غايتي وكل مرادي","نفع قومي جميعهم طول عمري",5,"ي",1,0],["انما غايتي رثاء امام","يقصر الشعر عنه والشعراء",6,"ا",2,0],["إنّما غَياً يتوبُ فُؤادي","أَمِنَ الرُشدِ تتوبُ قُلوبُ",7,"ب",1,0],["إنما غَيْرتك الكبرى مكان","نحوه يعدو ازدرائي حيثُ غِرْتِ..",8,"ت",1,0]]}