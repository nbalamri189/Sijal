{"poems":[[32,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[422,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[447,"قرعت على ليلى الشريفة بابها","https://www.aldiwan.net/poem14323.html","الطويل"],[463,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[500,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53255","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90019","الطويل"]],"verses":[["كَأَنَّ مَطايانا بِكُلِّ مَفازَةٍ","قَراقيرُ في صَحراءِدِجلَةَ تَسبَحُ",0,"ح",1,0],["كأَنَّ مطيَّ الركب في الشعب أصبحتْ","لها عند ذاك الشعب قلب مضيَّع",1,"ع",1,0],["كأن مطا الربداء للعيس كاغد","تحد حفاف اليعملات كتابها",2,"ب",3,0],["كأنّ مُطيباً قال للعِترةِ افتقى","يقول لها جُرِّي الذيولَ وضُوعي",3,"ع",2,0],["كأن مطايانا شفار كأنما","تمد إليهن الفلا كف سارق",4,"ق",1,0],["كأن مطايانا سماء كأننا","نجوم على أقتابها برجها الرحل",5,"ل",1,0],["كأن مطارح الحانات باتت","تثج على معاطفها المداما",6,"م",2,0],["كأَنَّ مُطاعينَ القنا وَهو مُشبهٌ","لَها سامَت القرطاسَ يأَخذُ بالوتر",7,"ر",1,0],["كأنّ مطاف الحادثات بشاهق","منيف الذري للفتح فيه مطارُ",8,"ر",1,0]]}