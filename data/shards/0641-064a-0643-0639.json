{"poems":[[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[325,"يا لائما لا مني في السهد مقترفا","https://www.aldiwan.net/poem61753.html","البسيط"],[371,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138387",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38016","السلسلة"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59297","البسيط"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105589","الرمل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139747",""],[5431,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=185085",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""]],"verses":[["فيكَ عَذولي عَذَرا","وَلائِمي قَد أَقصَرا",0,"ر",2,1],["في كَعبَةِ الحُسنِ وَأَعذَرَني عَلى سَهَري","وَاِجعَل مُناكَ الصَفا إِن شِئتَ مُبتَهِجاً",1,"ا",1,0],["في كَعبَةٍ لِلنَدى لَو حَلَّها مَلِكٌ","تَهَيَّبَ النُطقَ حَتّى قيلَ ذا حَجَرُ",2,"ر",1,0],["في كعبة العليا معلقة له","تنبى بأن الصنع منه عظيم",3,"م",1,0],["في كَعبَةِ فَهمٍ بِها تطوفُ فُهومٌ","في قبلَةِ قَصدٍ لَها تُوَجَّه آمال",4,"ل",1,0],["فِي كَعْبَةِ الحُبَ أوْ فِي شَوْقِ معلمة","نَحْنُ المُصَلُّونَ أمْ نَحْنُ المزكُّونَا",5,"ن",2,0],["فيك عنا رحل الهم وزال","فغدا يجمعنا فيك الوصال",6,"ل",1,0],["في كَعبَةٍ شادَها بانٍ وَزَيَّنَها","فيها ذُبالٌ يُضيءُ اللَيلَ مَفتولُ",7,"ل",1,0],["في كعبه كعب المعيشة سافل","وبصدره صدر المنية عال",8,"ل",1,0],["فيك على الصنفين كم رحمةٍ","أفاض مَن لا زال رحمانا",9,"ن",2,0],["فيك عمري وانتمائي","منك همي والشكايا",10,"ا",3,0],["في كعْبةِ اللهِ كَانَ المَهدُ يحمِلُك","حتّى تَراءَى بِشَقٍّ صَارَ يَمتَشِقُ",11,"ق",1,0],["16- فيكِ عِنادٌ باردٌ","مَثلَ الشِّتا ما أطوَلَهْ",12,"ل",2,0]]}