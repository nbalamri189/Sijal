{"poems":[[65,"سقيا لكوفن من أرض إذا ذكرت","https://www.aldiwan.net/poem45919.html","البسيط"],[24,"لقد ولى أليته جؤي","https://www.aldiwan.net/poem21889.html","الوافر"],[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[90,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[93,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[47,"عمرت أبا إسحاق ما صلح العمر","https://www.aldiwan.net/poem63637.html","الطويل"],[30,"فإن تهدموا داري فإن أرومتي","https://www.aldiwan.net/poem5488.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/14439","الخفيف"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[119,"تدارك رسول الله بالستر والرضى","https://www.aldiwan.net/poem42175.html","الطويل"],[139,"من لي إذا ما استقل الركب أو سارا","https://www.aldiwan.net/poem48842.html","البسيط"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[228,"ما أرى إن ما أراه وجيع","https://www.aldiwan.net/poem41635.html","الخفيف"],[285,"يا بن من شاد المعالي جوده","https://www.aldiwan.net/poem60768.html","الرمل"],[289,"قد مررنا بمالك فوجدناه","https://www.aldiwan.net/poem44342.html","الخفيف"],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[333,"فلسطين يا كعبة العالمين","https://www.aldiwan.net/poem54916.html","المتقارب"],[369,"ما كان لي في الخوز شيء سوى","https://www.aldiwan.net/poem60882.html","الطويل"],[376,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[409,"وأما شيوخي في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[438,"تعلق قلب المستهام بحبكم","https://www.aldiwan.net/poem12746.html","الطويل"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[498,"ونرجس لم يعد مبيضه","https://www.aldiwan.net/poem67401.html","السريع"],[505,"عليكم وإلا فالبكاء مضيع","https://www.aldiwan.net/poem37981.html","الطويل"],[510,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[580,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87067","الخفيف"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49904","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77590","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62449","الرمل"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100566","الرجز"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/145938","السريع"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80231","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126185","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109157","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115871","المديد"],[1493,"","https://poetry.dctabudhabi.ae/diwan/poem/202228","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52112","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118350","الخفيف"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20379","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109296","الرمل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124773","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88690","الوافر"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[3105,"","https://poetry.dctabudhabi.ae/diwan/poem/46010","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132727","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132168","المتقارب"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36745","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128912","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76447","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81264","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73245","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72491","الهزج"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130266","الطويل"],[4691,"فديتكِ غادة ً","https://www.poetsgate.com/ViewPoem.aspx?id=209106",""],[4859,"أحضان الأنا","https://www.poetsgate.com/ViewPoem.aspx?id=187570",""],[5700,"خَفقَة","https://www.poetsgate.com/ViewPoem.aspx?id=191217",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5957,"هويتكَ..2","https://www.poetsgate.com/ViewPoem.aspx?id=24479",""],[6124,"فتنة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=194524",""],[231,"لماذا أحبك !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79161&r=&rc=35",""]],"verses":[["فَإِنَّ تُهِبْ عِنْدَ إِظْلال الخُطوبِ بِهِ","يُشَمِّرِ الذَّيلَ حَتّى يَنْصُفَ السّاقا",0,"ق",2,0],["فَاِن تَهلِك جُؤيُّ فَكُلُ نَفسٍ","سَيَجلِبُها كَذلِكَ جالِبوها",1,"و",3,0],["فَاِنتَهَزَت أَعداؤُنا نُهزَةً","فينا وَما كانَت لَهُم تَسنَحُ",2,"ح",1,0],["فأنت هديتهم سبل المعالي","كما جنّبتهم طرق المخازي",3,"ز",2,0],["فَانْتَهى حاطبٌ عَلَيَّ وإلّا","فعليه هَشِيمُهُ المحْطُوبُ",4,"ب",1,0],["فانتهى المنتهون قبل عُرامي","وركوبي الفنونَ بعد الفنون",5,"ن",1,0],["فَاِنتَهى التاجُ إِلى مُعتَسِفٍ","لَم يَزَل بِالتاجِ حَتّى نَثَّرَه",6,"ر",2,0],["فَإِن تُهدِ ميخائيلَ تُرسِل بِتُحفَةٍ","تَقَضّى لَها العُتبى وَيُغتَفَرُ الوِزرُ",7,"ر",1,0],["فَإِن تَهدِموا داري فَإِنَّ أَرومَتي","لَها حَسَبٌ لا اِبنَ المَراغَةِ نائِلُه",8,"ل",2,1],["فَإِن تُهمِلا كُلَّ ما تَخزُنانِ","فَلَم يَأتِ بِالخَزيِ ما تَخزُوانِ",9,"ن",1,0],["فَاِنتَهِز فُرصَةَ الزَمانِ فَليسَ ال","مَرءُ مِن جَورِ صَرفِهِ في أَمانِ",10,"ن",1,0],["فانتهت فاطميّة هي (( أروى))","ظاهرا خلفه سجل وسيره",11,"ر",2,0],["فأنت هو المندوب في كل مدهش","وأنت لدى الرحمن خير من ارتضى",12,"ض",2,0],["فإن تهتكت في آثارهِ شغفاً","فليس ذلك في شرع الهوى عارا",13,"ر",2,0],["فَإِن تَهنوا تَضحَوا رَغيغَةَ ماضِغٍ","تُلَوِّقُها مَرثاً أَنامِلُ مارِثِ",14,"ث",1,0],["فَاِنتَهى في الدُجى إِلَيَّ لَطيفاً","وَلَطيفٌ صَوت الحَبيبِ المُطيعُ",15,"ع",1,0],["فَانْتَهِزْها فُرْصَةً مُمْكِنَةً","قَلَّ ما يُوجَدُ مَجْدٌ مُمْكِنا",16,"ن",2,0],["فَاِنتَهَينا إِلى سَعيدِ بنِ سَلمٍ","فَإِذا ضَيفَهُ مِنَ الجوعِ يَرمي",17,"م",2,0],["فإِنْ تهافتَ حول الزهرِ رفرفة","حسبته شرراً من زند قدّاح",18,"ح",1,0],["فأنت هوى الشرق أنت الحجاز","وروح العراق وقلب الشآم",19,"م",1,0],["فانتَهبَ العَسكرُ داري بها","واحتَبَس الكُتّابُ إدراري",20,"ر",2,0],["فانتَهى طائِعاً لهنَّ وقَد با","نَ علَيه الحَياءُ والإطراقُ",21,"ق",1,0],["فإن تهتدوا فالأجر بيني وبينكم","وإلا فإن الأجر لي لتوحُّدي",22,"د",2,0],["فإنْ تهجروا المشتاقَ فالقلبُ خائفٌ","وإن تصلوْهُ فهو في غايةِ الأمنِ",23,"ن",1,0],["فانتهى والريحُ في أعقابه","حَيرَةً تسألُ مُجريها الإقالَهْ",24,"ل",2,0],["فأنّتُه لكِ بين القلوب","إذا اشتبهت أنة الموجَعِ",25,"ع",1,0],["فَاِنتَهِز الفُرصَةَ في قُربِهِ","وَكُن إِلى اللَذّاتِ مُرتاحا",26,"ح",2,0],["فإنْ تَهْجُرُوني للرِّحابِ مُلازمٌ","وإنْ تَنْدُبوني سامعٌ ومُطيعُ",27,"ع",1,0],["فانتهى بي عبدُ الهوى بينَهنَّ","دونما استئْذانٍ كغُفلٍ تبلَّهْ",28,"ل",2,0],["فأَنتَ هَواها لا تسلَّت عن الهَوَى","وأَنْتَ مُنَاها لا تخلَّت عن المُنىَ",29,"ن",2,0],["فَانتهز فُرصة الصَفا وَتهنّأ","بِمقام في دَولة السَعد أَعظَم",30,"م",1,0],["فانتهبوا لبي ولم يقنعوا","باللب حتى أخذوا قلبي",31,"ي",1,0],["فَانتهز الفُرصَةَ إِنَّ الفُرصَه","تَصير إِن لَم تَنتهزها غُصَّه",32,"ه",1,0],["فانتهى أمرُ المقابيل إلى","هرب كم من شجاع هربا",33,"ب",2,0],["فانتهى والحمد والشكر لمن","خلق الخلق على ما وهبا",33,"ب",2,0],["فانتهيا إلى الوصي المرتضى","لأمرة الدين بحق لاحبا",34,"ب",2,0],["فانتهزِ الفرصةَ في غَفلةٍ","من حَاسدٍ أو كَاشحٍ أو رَقيبْ",35,"ب",1,0],["فَاِنتَهى عُمرُ هَواها عِندَهُ","كُلُّ شَيءٍ في البَرايا لِلنجازِ",36,"ز",1,0],["فأنت هو الذي أعطاك سراً","وجللك المهابة بالخفاء",37,"ا",2,0],["فانتهضت متعمداً ملتقاهم","هاتفاً من تحيرّي لا حولا",38,"ل",2,0],["فانتهينا حتى لديوان والٍ","حاز بين الولاة قدراً جليلا",38,"ل",2,0],["فانتهجت السرى وجديت فوراً","حيث أعطيت للثناء سبيلا",38,"ل",2,0],["فإن تهنأ فهذا كل مطلبنا","وإن نهنيء فهذا بعضُ ما يجب",39,"ب",1,0],["فانتهِ منطول عَذلِكَ لى","يا عَذُولى فى محبَّته",40,"ت",2,0],["فإن تهلكوا نهلك وتهلك مواسم","يعاش بها قول امرئٍ غير كاذب",41,"ب",1,0],["فانتهت مثل ما ابتدت","ليلة الوصل بالجزع",42,"ع",1,0],["فانتهى القول عند هذا وتاقت","كل أذن لصدمة الميعاد",43,"د",1,0],["فانتهز فرصة السرور فما تد","ري ايوما تنالها ام دهورا",44,"ر",2,0],["فَاِنتَهوا إِنَّ لِلشَدائِد أَهلاً","وَذَروا ما تُزَيِّنُ الأَهواءُ",45,"ا",2,0],["فانتهزها فرصة تنفي العثار","وصل المغبق بالمطبح",46,"ح",1,0],["فانتهى منتهى به قد تناهى","بالقضايا مطالب الطلاب",47,"ب",1,0],["فأنت هنا تسطيع رد ظلامة","ويعجزك الدينار والفلس في غد",48,"د",1,0],["فان تهلك ربيعة فهو شيخ","وان سلمت غدا من بعض ربعي",49,"ي",1,0],["فانتهكت حرمتهُ الموالي","وأحجمت عن ظعنها العوالي",50,"ي",1,0],["فَأنتَ هُرمُوزيُّ أو مُكرَاني","بالكُوسِ فَآفهَم وَآعرِفِ المكانِ",51,"ن",1,0],["فَإِن تُهلِكوا تُصبِح شَنوءَةُ بَعدَكُم","تَحِنُّ قواصيها حَنينَ الأَباعِرِ",52,"ر",1,0],["فإن تهدموا دار الضيافة والفرى","فإن بناء الحمد لا يتهدم",53,"م",1,0],["فَاِنتَهِج لِلجِدِّ سُبُلاً تَستَقم","اِذ بِهِ قَد تَكتَفي شَرَّ الخَطَل",54,"ل",1,0],["فأنتِ هنالك رهنُ الخريف","إذا نقص الحب لم تشبعي",55,"ع",2,0],["فَإِن تَهبَّ بِما لا تَشتَهي فَلَقَد","تَجري الرِياح بِما لا تَشتَهي السُفُنُ",56,"ن",1,0],["فانتهى سيره الى دار من أهوى","وقد كان ذاك قبل العشاء",57,"ا",2,0],["فانتهينا لنينوى فشهدنا","ما شهدناه من صروح الجلال",58,"ل",1,0],["فان تهمليها فقد داسنا","بنو الغرب في شعبنا الأزهر",59,"ر",1,0],["فَاِنتَهَزَ الفُرصَةَ فاريسُ وَقَد","أُشغِلَ أوريفيلُ في تِلكَ العُدَد",60,"د",1,0],["فَاِنتَهي يا حَياة مِن قَنص الطَ","ير وَفَكي الشِراك مِن عَصفوره",61,"ر",2,0],["فانتهز الفرصةَ من أمري لَعلَّ","ني بما تُسدي إليَّ مُفتخِر",62,"ر",1,0],["فانتهكت أستارها وافتضحت","رموزها واتضحت لمن نظر",63,"ر",1,0],["فإن تهدموا بالغدر داري فإنها","تراث كريم لا يبالي العواقبا",64,"ب",2,0],["فأنتِ هي المعارك كان قلبي","غنيمة طفلةٍ تهوى جهاده",65,"د",2,0],["فانتهى العمر وقلبي لم يزل","في بلادِ الوهمِ يبني الوطنا !",66,"ن",2,0],["فَانتِهَاءُ الشَقاءِ يُضحِيْ ابتِدَاءً","وَ ابتِدَاءُ السُرورِ يُمسِيْ أَخِيرََا",67,"ر",2,0],["فانتهض لاكتساب خير ودع ما","ليس يعنيك واقتن الطاعات",68,"ت",1,0],["فانتهجْ مدحاً وذماً معَ بعض","فهو نهجٌ لجميع المؤمنينْ",69,"ن",1,0],["فأنت هواء الحياة لقلبي","صداً يتهادى بسحر نضرْ",70,"ر",1,0],["فَانْتَهَيْتُ اليَوْمَ مِنْ عُودٍ لِعُوْدِ","أَسْكُبُ الدَّمْعَ الَّذِي غَطَّى شُجُونِي",71,"ن",2,0],["فأنت هنا فرحة تمرحين","وأنت هنا نشوة تقفزين",72,"ن",1,0]]}