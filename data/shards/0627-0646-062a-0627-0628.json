n/poem/128403","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129470","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125924","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46018","الكامل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124641","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205904","الرمل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114639","البسيط"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69284","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54393","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72560","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72961","البسيط"],[4701,"رام الله","https://www.poetsgate.com/ViewPoem.aspx?id=176659",""],[4767,"وردتي","https://www.poetsgate.com/ViewPoem.aspx?id=175104",""],[4767,"لو يراك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=210250",""],[4818,"ثاني الجنتين","https://www.poetsgate.com/ViewPoem.aspx?id=203511",""],[5120,"مِنْ بَعْدِهَا،لَا يَنْتَهِي السَّفَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181582",""],[5121,"صحبة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36287",""],[5152,"رسالة للأشاوس في اليمن السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=184990",""],[5186,"والليالي ميدان ذا الدهر فيه","https://www.poetsgate.com/ViewPoem.aspx?id=156470",""],[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5351,"الكرار من جديد","https://www.poetsgate.com/ViewPoem.aspx?id=202211",""],[5353,"محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212456",""],[5374,"تراتيل مؤجلة","https://www.poetsgate.com/ViewPoem.aspx?id=199712",""],[5616,"قنديل","https://www.poetsgate.com/ViewPoem.aspx?id=205034",""],[5751,"طيلسان الريح","https://www.poetsgate.com/ViewPoem.aspx?id=214790",""],[6262,"هل تَرْسُمينَ الآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80110&r=&rc=8",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["أَنتَ اِبنُ مَن مَجدَ المُلوكَ فَإِن يَكُن","لِلمَجدِ عَينٌ فَهُوَ مِنها ناظِرُ",0,"ر",1,0],["أنت ابن فقر إلى أمور","بهنّ تدعى يا ابن الثراء",1,"ا",2,0],["أَنتَ اِبنُ بَرزَةَ مَنسوباً إِلى لَجَإِ","عَبدُ العُصارَةِ وَالعيدانُ تَعتَصَرُ",2,"ر",1,0],["أَنتَ اِبنُ عَبدِ العَزيزِ الخَيرِ لا رَهِقٌ","غَمرُ الشَبابِ وَلا أَزرى بِكَ القِدَمُ",3,"م",1,0],["أَنتَ اِبنُ مُعتَلَجِ الأَباطِحِ فَاِفتَخِر","مِن عَبدِ شَمسَ بِذِروَةٍ وَصَميمِ",4,"م",1,0],["أنت ابن جُؤْذُرٍ الذي فَرَع العلا","حتى لخَالتْهُ الفَراقدُ فرقدا",5,"د",2,0],["أنت أبَّدْتَ في المعاني فأبَّد","نا الأماديح نقتفي تأْبيدَكْ",6,"ك",1,0],["أنت أبدعْتَ من طريف المعاني","ما تَحلَّى به فجازَ تليدَكْ",6,"ك",1,0],["أنت ابنه غيرَ شكٍّ يا أبا حسنٍ","فاذهبْ ظفرتَ بما لم يأمل الظَّفر",7,"ر",1,0],["أنت ابن كسرى وما تَباعَدت ال","روم بأنسابها عن الفُرُس",8,"س",1,0],["أنت أبن رأى للطبي","عة فيك غير مبدل",9,"ل",1,0],["أنت أَبا العَبّاسِ عَبّاسُها","إذا اسْتَطَار الحَدثُ المُعْضِلُ",10,"ل",1,0],["أَنتَ اِبنُ عَلقَمَةَ المَحمودُ نائِلُهُ","وَخالُكَ السِعرُ سِعرُ المِصرِ وَالبادي",11,"د",2,0],["أَنتَ اِبنُ مُعتَرِكِ البِطاحِ وَمِن","أَعياصِها في طَيِّبٍ نَضرِ",12,"ر",1,0],["أَنتَ اِبنُ أُمِّ اِمرِئٍ تَنمي إِذا نُسِبَت","حَيثُ اِنتَمَت بِأَبيها بِنتُ حَسّانا",13,"ن",2,0],["أَنتَ اِبنُ بَدرٍ وَشَمسٍ","ما أَنتَ مِن إِنسانِ",14,"ن",1,0],["أَنتَ اِبنُ أكّارِ نَهيجُ أَكّار","مُضطَهَدُ الوالِدِ نَيفُ المِشوار",15,"ر",1,0],["أَنتَ اِبنُ وَقتِكَ وَالماضي حَديثُ كَرىً","وَلا حَلاوَةَ لِلباقي الَّذي غَبَرا",16,"ر",2,0],["إِن تابَ إِبليسُ يَوماً تابَ عابِدُكُم","مِنَ الضَلالِ وَلَن تُلقوا فَتىً فُتِنا",17,"ن",2,1],["إِنَّ تَأبينَهُ الَّذي هُوَ دَأبي","حَرَّمَ المَدحَ بَعدَهُ وَالنَسيبا",18,"ب",2,0],["أنت ابنُ عِرْسٍ، يا محم","د في الوغى، لا ابن الثَّرى",19,"ر",2,0],["أنت ابن فلس، وما تنفك مفتخراً","فكيف تصنع لو كنت ابن دينار",20,"ر",1,1],["أنتَ ابنُ أُمّ امرِىءٍ تَنمي إذا نُسبَتْ","حَيثُ انتمَتْ بأبيها بِنْتُ حَسّانَا",21,"ن",2,0],["أنت ابن كسرى وما تَباعَدت الرْ","رُوم بأنسابها عن الفُرُس",22,"س",1,0],["أَنتَ اِبتَدَعتَ بِهَذِهِ الشِيَمِ العُلى","فَمَنِ اِهتَدى في سُبلِها فَبِكَ اِقتَدا",23,"د",2,0],["أنتَ ابنُ من نَصر الخلافةَ عزمُه","بالسيف بين مُنافق ومُداج",24,"ج",1,0],["أنتَ ابنُ من ركب البُراق إلى العُلا","ليلا يَؤمُّ عيانُها الأعيانا",25,"ن",2,0],["أَنتَ ابنَهُم بُنِيَت عَلَيكَ بُيوتُهُم","في قاهِرٍ لِذَوي الضَغائِنِ مُعتَلِ",26,"ل",1,0],["أَنتِ اِبنَةُ الشَرقِ المُكَلَّلِ رَأسه","بورودِ أُمكِ أَو سُيوفِ أَبيكِ",27,"ك",1,0],["أَنتِ اِبنَةُ الكَرمِ المورثِ من قِدَمٍ","وَحَيثُ تَأوي ظِبى المرديتِ مَأواكِ",28,"ك",1,0],["أنت أبوه فهو يُنمي إلى","كتابةٍ يوجبها محتدهُ",29,"د",2,0],["أَنت أَبديتَ لي بوجه","ك عُذراً إلى الورى",30,"ر",2,0],["أَنتَ اِبنُ مَجدٍ غَيرَ أَنَّكَ بِالحِجى","وَالفَضلُ زِدتُ رِعايَةً وَتَشَرُّفا",31,"ف",2,0],["أَنتَ اِبنُ عاتِكَةَ المَيمونِ طائِرُها","أُمُّ المُلوكِ بَني الغُرِّ المَناجيبِ",32,"ب",1,0],["أنت ابراهيم روح حائر","حيرة الناسك يدعو من أنا",33,"ن",2,0],["أَنتَ ابنُ حَمْدانَ الذي آدابُهُ","يُعْزَى ابنُ حَمْدانٍ لها وفِراسُهُ",34,"ه",1,1],["أَنتَ أَبهى الناس عِندي","أَثَراً يَحلو وَعَينا",35,"ن",2,0],["أَنتَ اِبن مَن لَو رَأتهُ الشَمس لاِحتجبت","مِنَ الجَلال عَن الأَعيان في حجبِ",36,"ب",1,0],["أَنتَ اِبن سيط رَسول اللَهِ كَيفَ تَرى","ضيما وَربك قَد أَعطى لَكَ المَدَدا",37,"د",2,0],["أنتَ ابتَدأتَ وما صَبرتَ ولَم يكُن","ليَهيجَ قَولي أَو تَهيجَ بَلابِلي",38,"ل",2,0],["أنت ابني الإبن الوحيد وأنت لي","مجدٌ وفيك المجد قام بعَرشهِ",39,"ش",2,0],["أنت ابني المولى العظيم المجتبى","قلبي بحبك لم يحل عن عَرشهِ",39,"ش",2,0],["أنت أبو الغيث الذي كفه","من جوده جاد الخلا المقفر",40,"ر",1,0],["أنتَ أبكيتَ بالمُضرّةِ عيني","أضحكُ الله بالمسرّة سنّكْ",41,"ك",1,1],["أنت ابنها البر لا تنسيك منزلة","حقّا عليك ولا كر لأزمان",42,"ن",1,0],["أنتَ ابنُ عزم الليل إن صحبتَني","على تباريح الكَلالِ والسأمْ",43,"م",1,0],["أنت ابن بيت في السماء مكانه","سقفاً وفوق المشتري معراجه",44,"ج",2,0],["أنت ابتدأت بميعادي فأوف به","ولا تربص به صرف المقادير",45,"ر",1,1],["أَنْتَ أبو عُذْرَةِ ما صُغْتَهُ","يَا أيُّها البُرْهانُ في ذا المقَالْ",46,"ل",1,0],["أَنتَ ابنُ مُسلَنطَحِ البَطحاءِ مَنبَتُكُم","بَطحاءُ مكّةَ لا روسُ القَراديدِ",47,"د",1,0],["أَنتَ اِبنُ الأَشياخِ الَّذينَ لَهُم","في بَطنِ مَكَّةَ عِزَّةُ الأَصلِ",48,"ل",1,0],["أَنتَ اِبنُ مُسلَنطِحِ البِطاحِ وَلَم","تَعطِف عَلَيكَ الحُنِيُّ وَالوُلُجُ",49,"ج",1,1],["أَنتَ اِبنُ مُعتَلِجِ البِطا","حِ كُدَيِّها فَكَدائِها",50,"ا",3,1],["انت ابن مصر بذلت نفسك دونها","طوعا وهل حاكى الدخيل اصيلا",51,"ل",2,0],["انت ابن عاهل خير مملكة سمت","بالعدل في أوج الفخار العالي",52,"ل",2,0],["أنت ابنُ عمّي الذي قد كان بعدَ أبي","إذا غابَ عني أبي لي حاضِنا وأَبا",53,"ب",2,1],["أنت ابن بنتِ محمدٍ","حَذواً خُلقتَ على مِثالِهْ",54,"ل",2,0],["أنت ابن موسى من بنو الدنيا له","في الدين كان ذهابها وإيابها",55,"ب",3,0],["أنت أبا عبد الإله امرؤٌ","سابقُ مجدٍ غيرُ مسبوق",56,"ق",1,0],["أَنْتَ ابْنُ كُلِّ مُنْتَضىً قَرِيعِ","تَمَّ تَمامَ البَدْرِ فِي سَنِيعِ",57,"ع",1,0],["أَنْتَ ابْنُ كُلِّ سَيِّدٍ خِضَمِّ","ضَخْمِ الدَسِيعِ مِفْضَلٍ لِهَمِّ",58,"م",1,0],["أَنْتَ ابْنُ كَلِّ مُصْطَفىً سراجِ","سَهْلِ المُحَيَّا خالِصِ الدِيباجِ",59,"ج",1,0],["أَنْت ابْن أَعْلامِ الهُدَى وَعَلَمُهْ","أَبُوكَ وَالنامِي إِلَيْه أَكْرَمُهْ",60,"م",2,0],["أنت ابني المولود خير ولادة","مني سمت إدراك فهم العاقلِ",61,"ل",1,0],["أَنتَ اِبنُ بردٍ مِثلُ بر","دٍ في النَّذالَةِ وَالرَّذالَه",62,"ل",2,0],["أَنتَ أَبكم لَيسَ تفهم","ما يترجم أَم معادِ",63,"د",1,0],["أَنتَ ابنُ يومِكَ فَاِستَوفِر مَنافِعَهُ","مالاً عُلوماً فَنوناً كُلَّ مَحمودِ",64,"د",1,0],["أنت ابن بيت الوحي دمت لشهره","ولكل شهرٍ كوكباً لا يمحق",65,"ق",1,0],["أنت ابن ياسين بيت اللَه يعرفكم","يا آل ياسين والأقلام والكتب",66,"ب",1,0],["أنت ابن سامي لو يساميك السهى ال","سامي لأخجله علاك الأوحد",67,"د",1,0],["أنت ابن طه لا نرى بشراً","أولى وأجدر منك بالرتب",68,"ب",1,0],["أنت أبٌ لي ولهمْ عاطفٌ","رُبَّ ابنِ خمسين له والد",69,"د",1,0],["أَنتَ اِبنُ من زانَتِ الدُنيا مَكارِمُهُم","وَأَصبَحوا مَجدَهُم بَينَ الوَرى مَثَلا",70,"ل",2,0],["انت ابن بجدتها وانت","سراج مشكاة المفاخر",71,"ر",1,0],["أنتَ ابنُ ذاك ومشهور كذاك ومِنْ","ذاك السحابُ توالتْ هذه الديمُ",72,"م",1,0],["أَنتَ اِبن بَجدَتها الَّذي","قَد أَيَّد الخُبرُ اِقتِداره",73,"ر",2,0],["انت ابن باريس التي ابطالها","ردوا اعاديهم بصفقة خاسر",74,"ر",1,0],["أنت ابو المجد الذي لم تزلذ","كل رجال المجد اتباعه",75,"ع",2,0],["أَنتَ اِبنُ مُسلَنطَحِ البِطاح وَلَم","تُطرِقُ عَلَيكَ الحُنِيُّ وَالوُلُجُ",76,"ج",1,1],["أنت ابن تربية له فيما مضى","وجليل بنته شاهد بولائه",77,"ا",3,0],["أنت ابن أخزمها جودا واحنفها","حلما سحبانها نطقاً وتبيانا",78,"ن",2,0],["أنت ابتسامة غادة","لقدوم صب زائر",79,"ر",1,0],["أنتاب أطلالَ الدِّيارِ بِمُهجَةٍ","تَرَكت ذَخائِرَها النوى أَطلالا",80,"ل",2,0],["أنتَ ابنُنا مَا اجتَمَعنَا قَطُّ في رجُلٍ","فَيَستَطِيعُ لَهُ السَّاعُونَ إِدرَاكَا",81,"ك",2,0],["إن تَأَبَّ أن تراه بيِّنًا","فالتمسه بالخيال المغرب",82,"ب",1,0],["أنت ابن كل البرايا لكن اقتصروا","على اسم حمزة وصفا غير تشميخ",83,"خ",1,1],["أَنتَ ابنُ ساداتٍ لأجمعهم","في بَطنِ مَكَّةَ عِزَّةُ الأَصلِ",84,"ل",1,0],["أَنتَ ابنُ عمِّ المصطفى وسميُّه","أَبشرْ فإنّكَ بعدَهُ خيرُ البشرْ",85,"ر",1,0],["أنت ابن شمس هدى عزت نظاهره","ما أنت بابن نجيم رب أشباه",86,"ا",2,0],["أنت ابنُ شمسِ هدىً عزت نظائرهُ","ما أنت بابنِ نجيم رب أشباهِ",87,"ا",2,0],["أنتَ ابنُ عمِّ الآخرينَ.. وربَّما","كنتَ ابنَ عمي قبلَ ألفِ جِبِلّةْ",88,"ل",2,0],["أنت أبياتيَ التي قلت شعراً","أنت مِما أقول أحلى نشيد",89,"د",1,0],["أنتِ أبديتِ كلَّ زينٍ تجلَّى","وهو أبدَى لنا من الزينِ شينَه",90,"ن",2,0],["أنتِ ابتهالي والقَصيدُ حبيبتي","وبكِ التّعوذُ ثمْ تأتي البَسْمَلة",91,"ل",2,0],["أَنْتِ ابْتِسَامُ صَبَاحِ الْعِيدِ،أَنْتِ مُنًى","بِهَا يَجِيئُ صَبَاحُ الْعِيدِ يَنْتَشِرُ",92,"ر",1,0],["أَنْتَ (ابنُ بُوشُو) رَحيِقَ الرُّوحِ تَسْجِلُهُ","يَرْوِي عَطَاشَى الْهَوَى بِالْشَّهْدِ وَالْحُبِّ",93,"ب",1,0],["أنتِ ابتساماتُ الحياةِ وأنتِ في","ليلِ المَهَالِك مَكْمَنُ الحَرْبِ الضَرُوسْ",94,"س",1,0],["أنت أبقى آمالنا أنت درع","يوم نبغي للمعضلات دراعا",95,"ع",2,0],["أنتَ ابنُ مِصرَ وما أراكَ عَقَقْتَها","بلْ كُنتَ بَرّاً واصِلاً ومُجاهِدا",96,"د",2,0],["أنت ابن مكة وابن سيدها وهم","فيها هم الدخلاء والأغرابُ",97,"ب",1,0],["أنت ابتكرتَ الرّيحَ زاداً هل ترى","عَدْلا ً تجوع ُبأرضِكَ الهيجاءُ",98,"ا",2,0],["أنت ابتهالاتي التي رتلتُها","قبلَ الضياعِ فهل ترى ألغيها",99,"ي",3,0],["إن تأبَّت عليَّ هندٌ أَتتني","ألفُ هندٍ.. وحبلُهنَّ طويلُ",100,"ل",1,0],["أنتِ ابتسامةُ وردٍ في مدى ألَقِ","راحتْ تَنُثُّ ندى الأشواقِ في الأفقِ",101,"ق",1,1],["أنتِ ابتدعتِ الصبحَ، أربكتَ المدى","والنارُ تصهلُ في مفازاتي وحيده",102,"د",2,0],["أنتِ ابتهَالُ محارِيبِي الزَّمانِيَّةْ","لمَّا دخَلتُ زوَايَاكِ المكانِيَّةْ",103,"ي",2,1]]}