wPoem.aspx?id=208598",""],[5431,"وأعشقه وأعشقها عيوبه","https://www.poetsgate.com/ViewPoem.aspx?id=186133",""],[5431,"وحي الأنهار...منسرح","https://www.poetsgate.com/ViewPoem.aspx?id=206272",""],[5518,"نور الحياة (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=196535",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5690,"للقاك يوم جاء كالسمك أسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=172145",""],[5704,"لبيك يا أقصى","https://www.poetsgate.com/ViewPoem.aspx?id=191599",""],[5704,"القدس لنا","https://www.poetsgate.com/ViewPoem.aspx?id=194471",""],[5736,"للقلب أحكامه","https://www.poetsgate.com/ViewPoem.aspx?id=203815",""],[5736,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=208426",""],[5739,"عش ٍ من القش","https://www.poetsgate.com/ViewPoem.aspx?id=126423",""],[5747,"بين فرح وبين جرح","https://www.poetsgate.com/ViewPoem.aspx?id=61682",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5776,"بابي إلى ربّ البريّة أحمدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199421",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5899,"قبلة","https://www.poetsgate.com/ViewPoem.aspx?id=31778",""],[5957,"لأني أحبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=51200",""],[5976,"قصّة غَرَق .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30528",""],[6075,"نهر اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=201155",""],[6093,"غابُوا وإنْ حَضَرُوا","https://www.poetsgate.com/ViewPoem.aspx?id=190632",""],[6115,"شعر النظم أحساس شاعر وفكره","https://www.poetsgate.com/ViewPoem.aspx?id=196452",""],[6142,"هي المضامير إن توجف مذاكيها","https://www.poetsgate.com/ViewPoem.aspx?id=155708",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[3216,"أواه.. يا كسلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67793&r=&rc=2",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["لَلُقّينا مِنَ الواشينِ حَتّى","رَضينا الرُسلَ أَنفاسَ الرِياحِ",0,"ح",1,0],["لِلقَرِيبِينَ من نَدَىً والبَعِيدِي","نَ من الجَورِ في عُرى الأَحكَامِ",1,"م",1,0],["لِلِقا العِدى بيضُ السُيو","فِ وَلِلنَدى حُمرُ النَعَم",2,"م",1,0],["لَلَقينَكُم يَحمِلنَ كُلَّ مُدَجَّجٍ","حامي الحَقيقَةِ ماجِدِ الأَجدادِ",3,"د",1,0],["للقمرين وجهه مطالع","فهي ثلاث ما لهنَّ رابع",4,"ع",1,0],["لِلْقوافي في وصفِ أمِّكَ شُغْلٌ","يا ابن بوران عن صفاتِ الرسوم",5,"م",1,0],["لِلقَصرِ يَخلُقُهُ خَيالَكَ رَوعَةٌ","كَالقَصرِ مِن جُدُرٍ وَمِن آسِ",6,"س",1,0],["لِلقائِلِ الفَيءُ وَلِلسامِعِ","التَغريدُ وَالزَهرَةُ لِلمُجتَني",7,"ي",1,0],["للقوم عرف فمن يفطن له ظفرت","يداه أو لا فلا ينفكّ في خسرِ",8,"ر",1,0],["لِلقَلبِ فيها قَرارٌ","وَقُرَّةٌ لِلعُيونِ",9,"ن",1,0],["للقومِ من أعناقِهم وبَنانِهم","نارٌ تُرِيكَ الدّاءَ كيف يُبرَّحُ",10,"ح",1,0],["لِلقورِ في رَقراقِها تَرَدّي","زَوراءَ تُخفي عَجَباً وَتُبدي",11,"د",2,0],["لِلقَلبِ راعٍ إِلَيها لا يُفارِقُهُ","وَفي الضَميرِ مِنَ الحُبِّ الأَعاجيبُ",12,"ب",1,0],["لِلقَوم أَحقادُ","عليّ تَزدادُ",13,"د",1,0],["للقبر كي يبكي على القبرِ","رحماكِ إنّ الدمع يؤذيه",14,"ه",1,0],["للقائد الأعلى الموشّح بالسنا","علم الفتوح وقاهر المستعمر",15,"ر",1,0],["للقُريَّاتِ عالَمٌ مُستقلٌّ","هو عن عالَمٍ سواه غريب",16,"ب",1,0],["للقُرى روعةٌ وللقرويِّين","إذا صابَ أرضهم شُؤبوب",16,"ب",1,0],["للقماري به غناء وللرو","ض ابتسامٌ وللغيوم عبوس",17,"س",1,0],["للقائدِ المولى الأَجلِّ به","ذِكرُ يوَقِّيه من العَدَم",18,"م",1,0],["للقدسِ سارَ بليلةٍ","كانَت بوجهِ الدهرِ نَقشا",19,"ش",2,0],["للقرب كالبعد معنى في مخاطره","والنار في القرب أقوى حين تندلع",20,"ع",1,0],["للقلبِ إن طالَ البعادُ تقرُّبُ","ولهُ إذا حالَ الودادُ تجنُّبُ",21,"ب",1,1],["لِلْقَلبِ حَالُ الشَّمْلِ يَوْمَ نَعِيِّهِ","كُلٌّ علَى حُكمِ الرَّدَى مَصْدُوعُ",22,"ع",1,0],["لِلقُدسِ مِن مَكَّةَ قَد سَرَت مُنتَبِها","لِتَشهَدَنَّ مِنَ الآياتِ أَعجَبَها",23,"ه",2,0],["لِلقُربِ مِنكُم ذاكِرُ بِعادُهُ","ذِكرَ الصِبا يُسنَدُ طولَ المُسنَدِ",24,"د",1,0],["للقاصدينَ مالُه وجاهُه","فرِجلُه تعلو على شَوى العِدا",25,"ا",1,0],["للقاسِمِ القائِمِ الهادي الَّذِي هُديَتْ","إِلَيْهِ طاعتُنا سِرّاً وَإِعْلانا",26,"ن",2,0],["للقمرِ الفردِ وهل مالكٌ","في الأفْق غيرُ البدرِ أن يُفردَا",27,"د",2,0],["لِلقُمرِ مِن كُلِّ فَلاً نالَهُ","غَمغَمَةٌ يَقزَعنَ كَالحَنظَلِ",28,"ل",1,0],["للقلبِ في سَبْكِ الحُروفِ معانِ","كالنُّورِ يُبْدي رونَقَ الأَلوَانِ",29,"ن",1,1],["للقومِ في حضرَةِ التَّصريفِ ديوانُ","به مُلوكٌ وقُوَّادٌ وفُرْسانُ",30,"ن",1,1],["للقلبِ حالٌ بَيِّنٌ","عن كلِّ شيءٍ شاغِلُ",31,"ل",1,0],["للقلْبِ من حُكمِ الهَوى","نحْوَ الحبيبِ بَواعثُ",32,"ث",1,1],["لِلقَصفِ مُتَّكِئينَ فَوقَ نَمارِقٍ","يُسقَونَ بِالطاسِ الرَحيقَ زُلالا",33,"ل",2,0],["للقِرَى شُبَّتْ قديماً نارُها","وهِيَ لا تُطْفى على طولِ السنينْ",34,"ن",1,0],["لِلقِسرِ ذو أُبَّهَةٍ عَصِيُّ","ذو نَخوَةٍ حُمارِسٌ عُرضِيُّ",35,"ي",1,0],["للقسائم المهدي في زماننا","صاحبها يدعو إلى إمامنا",36,"ن",2,0],["لِلِقاءِ اِبنِ جَعفَرٍ ذي الجَناحَي","نِ الكَريمِ النِصابِ في الأَسلافِ",37,"ف",1,0],["للقسط أفراد بمصر تألقا","من وجههم نور الصلاح وأشرقا",38,"ق",2,1],["للقوسِ في كفِّ رامٍ","سهمٌ إليها سديد",39,"د",1,0],["للقوم أعذارهم في كل منقلب","إن أخطأ القوم أو كانوا مصيبينا",40,"ن",2,0],["للقدس عندك حقُّ وافٍ عاتبٍ","لو لم يعده الحج عام آجل",41,"ل",1,0],["للقوم من ثمر الوادي نصيبهمُ","وحظُّهم من رحيق فيه مورود",42,"د",1,0],["لِلقُدسِ فَخرٌ بِما تَحويهِ مِن حَرمٍ","كَما تَبدّى بِهِ فَخرٌ لِدامونِ",43,"ن",1,0],["لِلقط وَالفار حكايه","وَلِّفتها مِن فنوني",44,"ي",1,1],["لِلْقَانِ يُنْسَبُ خَدُّهُ فَلأجْلِ ذَا","تُفَّاحُهُ بِدَمِ الْقُلُوبِ مُخَضَّبُ",45,"ب",1,0],["للقُطْب أطفالْ فِي مَكَاتِبْ الأدْوَاحْ","والقَمَرْ مُؤَدّبْهَا الذِي عَلِّمْهَا",46,"ه",2,0],["للقاء وَجهك فَليك الترحال","وَلقصد مَجدك يعمل الأَرقال",47,"ل",1,1],["للقومِ سرٌ مع المحبوب ليس لهُ","حدٌّ وليس سوى المحبوب يحصيهِ",48,"ي",2,0],["للقاك في مغناك يا خير البشر","طال النشوق فاسعفنا بالبُشر",49,"ر",1,1],["للقبض مع كف عروضه وقد","قلنا لخرب سوف للشتر ورد",50,"د",1,0],["لِلقِردِ بَشّارِ بنِ بُردٍ وَلا","تَحفِل بِرَغمِ القِردِ أَو تَعسِهِ",51,"س",2,0],["لِلقِردِ بِاللَّيثِ اِغتِرارٌ بِهِ","فَما الَّذي أَدناكَ مِن مَسِّهِ",51,"س",2,0],["للقاء بيض الظبى","وقراع الدارعين",52,"ن",1,0],["لِلقَلب صاحَت","فالقَلب مجنون",53,"ن",1,0],["للقيت الحمام قبل أواني","وسقى نفسي الردى ورواها",54,"ا",3,0],["للقلب عدل إليها بعد معرفة","فكيف عنها مع الوضعين ينصرف",55,"ف",1,0],["لِلقارِياتِ مِنَ القَطا نَقرٌ","في حافَتَيهِ كَأَنَّها الرَقمُ",56,"م",1,0],["للقُمرِ ثمَّ العارضِ المنقادِ","ومَن يكن بينهما محاذي",57,"ي",1,0],["لِلقُربِ هَلَّلَ شَعبُ اللَهِ مُغتَبِطاً","يَشدو بأُنشودَةٍ وَالرَكبُ مُختالُ",58,"ل",1,0],["للقصر أقبلوا به","لهفي له يشكو الظما",59,"م",2,0],["لِلِقاكَ العودُ يَبكي","وَأَتاكَ العودُ يَشكى",60,"ك",2,0],["للقبة الحمراء في تاجها","وهجٌ وللمأذنة اللامعه",61,"ه",1,0],["لِلقآئِهِ في الاوج صَفقةُ جاذِلٍ","وَلِفَقدِهِ في الارض صَفقةُ لاطمِ",62,"م",1,0],["لِلْقُضْبِ بِالزَّهْرِ أَجْيَابٌ وَأَجْيَادُ","تَدْنُو إِلَيْكَ وتَنْأَى حِينَ تَنْآدُ",63,"د",1,1],["للقلب في وجناته","روض بشوقي يوقدُ",64,"د",1,0],["للقُطْرِ تفتَحُهُ للأمْنِ تمْنَحُهُ","للعزّ توفِدُهُ للنّصْرِ تُقدِمُهُ",65,"م",2,0],["للقلب في دار السَّلام تقلّبٌ","والجسم بالنيران في إيران",66,"ن",1,0],["للقصيبيِّ انتَمى عنصره","فاق أهل العصر فينا بالأدب",67,"ب",1,0],["للقوم سر مع المحبوب ليس له","من رتبة يرتقيها غير أهليه",68,"ي",2,0],["للقلب ما شاء الغَرامْ","والجسم حِصَّتُه السَّقامْ",69,"م",1,1],["للقرد فيك ملامح","فعساك لا تلدين قردا",70,"د",2,0],["لِلقَلْبِ أَسْرٌ وَالدُّموعِ إطْلاقْ","فِي حُبِّها فَالدَّمْعُ جارٍ سَبّاقْ",71,"ق",1,0],["للقَفْر لا للفَقْر هبها إنَّما","مَغناك ما أَغناك أَن تَتَوسَّلا",72,"ل",2,0],["للقاء هكطورٍ وخرقٍ سرى","تلك الكتائب صبره نفدا",73,"د",2,0],["لِلًقائي بالحَربِ يَوماً تَرَبَّص","كادَ يُصمَى لكِن نَجا وتَمَلًّص",74,"ص",1,0],["للقادر العبدان هذا في دمش","ق وذاك باز اللَه في بغداد",75,"د",1,0],["للقدس قد اهدت حماة الشام من","ذرية الوزراء شمس معارف",76,"ف",1,1],["لِلقانتين بِهِ زَئيرٌ كُلَّما","مُدّت مِن اللَيل البَهيم سُدولُهُ",77,"ل",2,0],["للقُدسِ أُزَيّنُ قافِيَتي","وأبوح بلَهْفي لثَراها",78,"ا",3,1],["للقادمينَ عُيونُ الريحِ .. فاستترى","فإنّ عَرْفكِ يُغنيني عن النظرِ",79,"ر",1,1],["للقادمينَ ربيعُ الحبّ فانتظري","دفءَ المغاربِ أو ترنيمة السَّحرِ",79,"ر",1,0],["للقوم تعبير به يسبي النّهى","طرباً ويثني الصبّ عن أحبابه",80,"ب",2,0],["للقريه اللي لابسه (( مخنق )) اجبال","وثوبٍ من الحنطه ويحشمك طوله",81,"ل",2,0],["للقُدسِ دربُكَ يا مُحِبَّ خلاصِها","من قاهريها قد أُحيطَ سدُودا",82,"د",2,0],["للقائه في لحمِ جسمي رقصةٌ","تنابني بالوهنِ والإرهاق",83,"ق",1,0],["للقلب باب لو تواربه احتمل","من قد تسلل خُفية أو هَبَّا",84,"ب",2,0],["للقلب أن يصطفي ما شاء من لغة","يحتلها واحدٌ في عمقها باقي",85,"ق",2,0],["للقلب جعلتك مالكةً","ونقشتكِ نقشاً في رئتي.",86,"ت",2,0],["للقلب عين وانت للعين مغري","يامحٌرح القمرا بسود مظاليل",87,"ل",1,0],["لِلْقَلْبِ لِلأَنْفَاسِ لِلرُّوحِ الرِّوَى","فِي جَعْبَةِ الْعَطْشَانِ طَافَ بِلاَلاَ",88,"ل",2,0],["للقَناديل التي لم تَشتعل","قد أعاروا زَيْتَها جَمْرَ السَمَار",89,"ر",1,0],["لَلَقى ابنَ جَوشَنَ فَوقَ صَدْرِكَ جالِساً","ما إِنْ يَحُزُّ وَيَعْتَلي التَّكْبيرُ",90,"ر",1,0],["للقدسِ نصرُ اللهِ حتمٌ إنَّهُ","وعدٌ على مدِّ المدى مضمونُ",91,"ن",1,0],["للقلب بالنظر الذي هو وصفه","والعلم بالخطرات في الأحوال",92,"ل",1,0],["للقصايد مع إني حافظ أرداهن \"","\"إرتبكت وعجزت أتذكر أروعهن",93,"ن",1,0],["للقدس برونقةٍ جمعت","بدمائي وهجة مشتعل",94,"ل",1,0],["للقدس عين من الاشواق لم تنم","أرخت سدائلها في قلب محتدم",95,"م",1,1],["للقدس فجر وان طالت مشارقه","بالهم لو حبلت زادت من الورم",95,"م",1,0],["للقدسِ اغنيةٌ غنَّتْ بها شفةٌ","فمات ضيغمُها من شدَّةِ الحَزَنِ",96,"ن",1,0],["للقدس قولوا لم أنمْ من ليلتي","أدْمتْ بنا لوعاتُنا وقلوبُ",97,"ب",1,0],["للقدسِ اقصىً هل يُعافَ مدنساً","لا الشجبُ ينفعُ منك والتقطيبُ",97,"ب",1,0],["للقدسِ أهلٌ لن تنازعَ ملكهم","فاظفرْ بروحِك لا تكنْ جثمانا",98,"ن",2,0],["للقدسِ أهلٌ ما توانوا نصرها","قالوا هوينا الموتَ وهو هوانا",98,"ن",2,0],["للقلبِ في أحْزانَه أنَّاتُ","ولواعجٌ هياجةٌ وثباتُ",99,"ت",1,1],["للقدسِ قامتْ ما استكانت وهلة ً","والعمر تحملُ أنةً وعذابا",100,"ب",2,0],["للقدس شعبٌ لا 