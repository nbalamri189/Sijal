{"poems":[[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[47,"إنا إذا اشتد الزمان","https://www.aldiwan.net/poem25157.html","مجزوء الكامل"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[66,"ما حلة ابن دبيس","https://www.aldiwan.net/poem40655.html","المجتث"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"يا طيب سيان عندي أنت والطيب","https://www.aldiwan.net/poem64855.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141967","الطويل"],[100,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[142,"ملكتني المدامة الخندريس","https://www.aldiwan.net/poem2364.html","عموديه"],[186,"يا دار ماذا فيك من ملح","https://www.aldiwan.net/poem14665.html","أحذ الكامل"],[190,"خير البلاد علا وعيشا","https://www.aldiwan.net/poem35161.html","مجزوء الكامل"],[212,"هذا خطاب بوحي الحب تكتبه","https://www.aldiwan.net/poem46595.html","البسيط"],[271,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[276,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[365,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[433,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[440,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[459,"ليتك لما تكن مسعدا","https://www.aldiwan.net/poem56237.html","السريع"],[476,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[501,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[501,"للقوم في حضرة التصريف ديوان","https://www.aldiwan.net/poem37765.html","البسيط"],[501,"حسد الولي الجاهل","https://www.aldiwan.net/poem37807.html","مجزوء الكامل"],[501,"للقلب من حكم الهوى","https://www.aldiwan.net/poem38051.html","مجزوء الكامل"],[554,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[560,"مل بنا يا سعد وانزل بالحجون","https://www.aldiwan.net/poem69342.html","الرمل"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَلُقّينا مِنَ الواشينِ حَتّى","رَضينا الرُسلَ أَنفاسَ الرِياحِ",0,"ح",1,0],["لِلقَرِيبِينَ من نَدَىً والبَعِيدِي","نَ من الجَورِ في عُرى الأَحكَامِ",1,"م",1,0],["لِلِقا العِدى بيضُ السُيو","فِ وَلِلنَدى حُمرُ النَعَم",2,"م",1,0],["لَلَقينَكُم يَحمِلنَ كُلَّ مُدَجَّجٍ","حامي الحَقيقَةِ ماجِدِ الأَجدادِ",3,"د",1,0],["للقمرين وجهه مطالع","فهي ثلاث ما لهنَّ رابع",4,"ع",1,0],["لِلْقوافي في وصفِ أمِّكَ شُغْلٌ","يا ابن بوران عن صفاتِ الرسوم",5,"م",1,0],["لِلقَصرِ يَخلُقُهُ خَيالَكَ رَوعَةٌ","كَالقَصرِ مِن جُدُرٍ وَمِن آسِ",6,"س",1,0],["لِلقائِلِ الفَيءُ وَلِلسامِعِ","التَغريدُ وَالزَهرَةُ لِلمُجتَني",7,"ي",1,0],["للقوم عرف فمن يفطن له ظفرت","يداه أو لا فلا ينفكّ في خسرِ",8,"ر",1,0],["لِلقَلبِ فيها قَرارٌ","وَقُرَّةٌ لِلعُيونِ",9,"ن",1,0],["للقومِ من أعناقِهم وبَنانِهم","نارٌ تُرِيكَ الدّاءَ كيف يُبرَّحُ",10,"ح",1,0],["لِلقورِ في رَقراقِها تَرَدّي","زَوراءَ تُخفي عَجَباً وَتُبدي",11,"د",2,0],["لِلقَلبِ راعٍ إِلَيها لا يُفارِقُهُ","وَفي الضَميرِ مِنَ الحُبِّ الأَعاجيبُ",12,"ب",1,0],["لِلقَوم أَحقادُ","عليّ تَزدادُ",13,"د",1,0],["للقبر كي يبكي على القبرِ","رحماكِ إنّ الدمع يؤذيه",14,"ه",1,0],["للقائد الأعلى الموشّح بالسنا","علم الفتوح وقاهر المستعمر",15,"ر",1,0],["للقُريَّاتِ عالَمٌ مُستقلٌّ","هو عن عالَمٍ سواه غريب",16,"ب",1,0],["للقُرى روعةٌ وللقرويِّين","إذا صابَ أرضهم شُؤبوب",16,"ب",1,0],["للقماري به غناء وللرو","ض ابتسامٌ وللغيوم عبوس",17,"س",1,0],["للقائدِ المولى الأَجلِّ به","ذِكرُ يوَقِّيه من العَدَم",18,"م",1,0],["للقدسِ سارَ بليلةٍ","كانَت بوجهِ الدهرِ نَقشا",19,"ش",2,0],["للقرب كالبعد معنى في مخاطره","والنار في القرب أقوى حين تندلع",20,"ع",1,0],["للقلبِ إن طالَ البعادُ تقرُّبُ","ولهُ إذا حالَ الودادُ تجنُّبُ",21,"ب",1,1],["لِلْقَلبِ حَالُ الشَّمْلِ يَوْمَ نَعِيِّهِ","كُلٌّ علَى حُكمِ الرَّدَى مَصْدُوعُ",22,"ع",1,0],["لِلقُدسِ مِن مَكَّةَ قَد سَرَت مُنتَبِها","لِتَشهَدَنَّ مِنَ الآياتِ أَعجَبَها",23,"ه",2,0],["لِلقُربِ مِنكُم ذاكِرُ بِعادُهُ","ذِكرَ الصِبا يُسنَدُ طولَ المُسنَدِ",24,"د",1,0],["للقاصدينَ مالُه وجاهُه","فرِجلُه تعلو على شَوى العِدا",25,"ا",1,0],["للقاسِمِ القائِمِ الهادي الَّذِي هُديَتْ","إِلَيْهِ طاعتُنا سِرّاً وَإِعْلانا",26,"ن",2,0],["للقمرِ الفردِ وهل مالكٌ","في الأفْق غيرُ البدرِ أن يُفردَا",27,"د",2,0],["لِلقُمرِ مِن كُلِّ فَلاً نالَهُ","غَمغَمَةٌ يَقزَعنَ كَالحَنظَلِ",28,"ل",1,0],["للقلبِ في سَبْكِ الحُروفِ معانِ","كالنُّورِ يُبْدي رونَقَ الأَلوَانِ",29,"ن",1,1],["للقومِ في حضرَةِ التَّصريفِ ديوانُ","به مُلوكٌ وقُوَّادٌ وفُرْسانُ",30,"ن",1,1],["للقلبِ حالٌ بَيِّنٌ","عن كلِّ شيءٍ شاغِلُ",31,"ل",1,0],["للقلْبِ من حُكمِ الهَوى","نحْوَ الحبيبِ بَواعثُ",32,"ث",1,1],["لِلقَصفِ مُتَّكِئينَ فَوقَ نَمارِقٍ","يُسقَونَ بِالطاسِ الرَحيقَ زُلالا",33,"ل",2,0],["للقِرَى شُبَّتْ قديماً نارُها","وهِيَ لا تُطْفى على طولِ السنينْ",34,"ن",1,0],["لِلقِسرِ ذو أُبَّهَةٍ عَصِيُّ","ذو نَخوَةٍ حُمارِسٌ عُرضِيُّ",35,"ي",1,0],["للقسائم المهدي في زماننا","صاحبها يدعو إلى إمامنا",36,"ن",2,0]]}