{"poems":[[53,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[68,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[151,"أبى القلب أن ينسى المعاهد من برسا","https://www.aldiwan.net/poem47636.html","الطويل"],[156,"قال الطبيب","https://www.aldiwan.net/poem17099.html","عموديه"],[285,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[369,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[406,"عندما يكون العتاب دليلاً على الحب","https://www.aldiwan.net/poem6750.html","عموديه"],[406,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[447,"أيا أهل القبور فما جواب","https://www.aldiwan.net/poem14369.html","الوافر"],[556,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122589","الطويل"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/198794","الوافر"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138166",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49609","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125361","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28007","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74234","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[5569,"النبض والنبض الآخر","https://www.poetsgate.com/ViewPoem.aspx?id=60535",""]],"verses":[["وكيف جُحُود الناس نعماءَ مُنْعِمٍ","تَنَاغَى بها أطفَالُهُمْ في مُهُودها",0,"د",3,0],["وَكَيفَ جارَ عَلَيكَ الدَهرُ مُعتَدِياً","أَما تَعَلَمَّ مِنكَ العَدلَ يا عُمَرُ",1,"ر",1,0],["وَكَيفَ جَرَرنا طِوالَ القنا","عَلى كُلِّ طَرفٍ سَليمِ الشَظى",2,"ظ",2,0],["وكيف جكركة بعدنا وقصورها","تراها الثريا إذ توسطت القوسا",3,"س",2,0],["وكَيفَ جِئتُ إلى الدُّنيا، وكَيف نَمَتْ","مَطامِحي، وارتَقَتْ عَن عَالمِ الدُّونِ",4,"ن",1,0],["وَكَيْفَ جُحُودُ مَعُرُوفٍ تَوالى","فَكانَ مِنَ الْخُطُوبِ دَواء دائي",5,"ي",1,0],["وكيف جُحودُ ما صنَع المطايا","وقد حَجّتْ بنا حَرَمَ المكارم",6,"م",1,0],["وكيف جعلت ربيع المنى","خريفا\" وقد كنت كالجدول؟",7,"ل",1,0],["وكيف جاءَ إلى السَّاحاتِ محتملاً","أقسى المعاناةِ إقداماً وإصرارا؟",8,"ر",2,0],["وكيف جوابكم لما سئلتم","إلى الملكين منكر أو نكير",9,"ر",1,0],["وَكيفَ جَحدتُمُ لهمُ حقوقاً","تَبين على رقابكُمُ اِختطاطا",10,"ط",2,0],["وكيف جاز للذي قدمتم","أن ينصب الثاني كما ذكرتم",11,"م",1,0],["وكيف جبالُ الأرُقَين أشيحُها","ذوائبُه تَهفُو على عِذَبِ الرَّندِ",12,"د",1,0],["وكيف جعلتَ من نفطٍ سلاحاً","وَقَيْتَ العُرْب فيه من الأعادي",13,"د",2,0],["وكيف جرت فيه المنى وتدفقت","جداولها من بعد ما انحسر الورِد",14,"د",1,0],["وكيف جاءوك بشمسِ الضحى","والليلَ في أثوابهِ الجون",15,"ن",1,0],["وكيف جرَّدتهُ والأُسدُ رابضَةٌ","تحمي العرينَ وجمرُ اللحظِ يستَعِرُ",16,"ر",1,0],["وكيف جاءتْ لتشقيقٍ وإنَّ لها","تسبيحَ خالِقها حقَّاً بتصديقِ",17,"ق",1,0],["وَكَيف جالَت عَلى اليَرموك وَانتَشَرت","في أَرض كِسرى وَحَلت قَصر تَيماء",18,"ا",2,0],["وَكَيفَ جثا جدّه للخطوب","وَفي جدّه أُمَم جاثيَه",19,"ي",2,0],["وكيف جازت لك النبوةُ في الح","سن وقد قيل لم ينلها صبي",20,"ب",2,0],["وكيف جالت يد الجُهَّالِ تعسفنا","فانبثَّ نبضٌ خؤونٌ ضيَّع الهَدَفا",21,"ف",2,0]]}