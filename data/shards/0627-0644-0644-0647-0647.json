{"poems":[[51,"الله هون عندك الدنيا","https://www.aldiwan.net/poem64257.html","مجزوء الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105564","السريع"],[4929,"لغزة الله","https://www.poetsgate.com/ViewPoem.aspx?id=204593",""],[4929,"الحق ورايته (اكناف بيت المقدس)","https://www.poetsgate.com/ViewPoem.aspx?id=208723",""],[5438,"عَزْفٌ فِي مَقَامَاتِ الحَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=202093",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[6260,"جيش الحبائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68361&r=&rc=53",""]],"verses":[["اللَهُ هَوَّنَ عِندَكَ الدُنيا","وَبَغَّضَها إِلَيكا",0,"ك",2,1],["اللَهُ هَدَّ كِيانَكُم بِكَتائِبٍ","يَرمي بِها فَيَهُدَّ كُلَّ كِيانِ",1,"ن",1,0],["اللَهُ هَيَّأَ مِن حَظيرَةِ قُدسِهِ","نَزُلاً لِذاتِكَ لَم يَجُزهُ عَلاءُ",2,"ا",2,0],["الله, هب لي المقلة التي ترى","خلف تشَتُّتِ الشكول والصور",3,"ر",1,0],["اللَه هل لك من عودةٍ","تحيي رمام الدنف الواجد",4,"د",1,0],["اللهُ هيأهُم للظلمِ قارعةً","وشاظ فيهم على من أجرموا رجزَه",5,"ز",2,0],["الله هيأهم للعزِّ أوتِدةً","وشاظهم فوق شيطانِ الحمى رُجُمَا",6,"م",2,0],["اللهُ ... ! هَذَا الدَمْعُ شَلّالٌ هَمَى","حَدَقِي المُذَبَّحُ هدَّهُ الإفِرْازُ",7,"ز",1,0],["اللهُ هَيَّأهُ عَدلاً لأُمَّتِهِ","حَتَّى غَدَتْ مَثَلاً فِي سَائِرِ الأُمَمِ",8,"م",1,0],["الله هل سمر القنا مالت وأض","حى القلب في تقبيلهن الراغبا",9,"ب",2,0]]}