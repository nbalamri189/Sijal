{"poems":[[64,"إن الهواء به الحياة","https://www.aldiwan.net/poem52230.html","مجزوء الكامل"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[107,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[131,"لك منزل في القلب لا يتغير","https://www.aldiwan.net/poem50594.html","الكامل"],[202,"كل يقول شقينا","https://www.aldiwan.net/poem45405.html","المجتث"],[331,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[481,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"]],"verses":[["يرث الحرارة والرطو","بة لا يحسّ له ضريب",0,"ب",1,0],["يَرْثُونَ لِلوطنِ الجريحِ وقد غَدَوْا","حَرباً على الوطنِ الجريحِ عَوانا",1,"ن",2,0],["يَرثُونَ ما في الحورِ وال","ولدانِ من حُسْنٍ وطيبْ",2,"ب",1,0],["يرْثي فيحتبِسُ البكاءُ بصَوْتِه","أينَ الرَّخِيمُ الْعَذْبُ مِنْ أصْوَاتِه",3,"ت",2,0],["يرث ابن هند في أصالة رأيه","أو خالدًا في عزمه المتوقد",4,"د",1,0],["يرث الممالك والمفاخر والعلا","سيفُ بن سلطان الإمامُ الأطهرُ",5,"ر",1,0],["يرثي لمن ليسَ منهُ","وموتُ أهليهِ عرسهْ",6,"س",2,0],["يرثى لكل الناس في حزنهم","ويحتفى بعرسهم إن عبر",7,"ر",1,0],["يرثي لحالهما العدو","وويشتكي منها الصديق",8,"ق",1,0]]}