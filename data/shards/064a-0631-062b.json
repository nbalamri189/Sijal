{"poems":[[64,"إن الهواء به الحياة","https://www.aldiwan.net/poem52230.html","مجزوء الكامل"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[107,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[132,"لك منزل في القلب لا يتغير","https://www.aldiwan.net/poem50594.html","الكامل"],[203,"كل يقول شقينا","https://www.aldiwan.net/poem45405.html","المجتث"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[484,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83336","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64250","الكامل"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/145939","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109073","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109041","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205058","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204998","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77098","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4690,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=181349",""],[5363,"رثاء الشيخ البروفسور إبراهيم الكندي","https://www.poetsgate.com/ViewPoem.aspx?id=199950",""],[5861,"أيوب آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=190702",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["يرث الحرارة والرطو","بة لا يحسّ له ضريب",0,"ب",1,0],["يَرْثُونَ لِلوطنِ الجريحِ وقد غَدَوْا","حَرباً على الوطنِ الجريحِ عَوانا",1,"ن",2,0],["يَرثُونَ ما في الحورِ وال","ولدانِ من حُسْنٍ وطيبْ",2,"ب",1,0],["يرْثي فيحتبِسُ البكاءُ بصَوْتِه","أينَ الرَّخِيمُ الْعَذْبُ مِنْ أصْوَاتِه",3,"ت",2,0],["يرث ابن هند في أصالة رأيه","أو خالدًا في عزمه المتوقد",4,"د",1,0],["يرث الممالك والمفاخر والعلا","سيفُ بن سلطان الإمامُ الأطهرُ",5,"ر",1,0],["يرثي لمن ليسَ منهُ","وموتُ أهليهِ عرسهْ",6,"س",2,0],["يرثى لكل الناس في حزنهم","ويحتفى بعرسهم إن عبر",7,"ر",1,0],["يرثي لحالهما العدو","وويشتكي منها الصديق",8,"ق",1,0],["يَرِثُ الفَناءَ وَقَد يَرى مَن لَم يَرِثِ","شَيئاً سِوى ذا المَوتُ عَن أَجدادِهِ",9,"د",2,0],["يرثي نفوساً لو تطيقُ إِبانةً","لرثتْ له من طولِ ما يرثيها",10,"ي",3,0],["يَرْثى له أبداً مَن كان يَحسُدُه","على الشبَابِ لحالٍ كُلُهُ عِبَرُ",11,"ر",1,0],["يرثى لقتلاهم ويندب حظهم","ويعالج الجرحى ويأسو المِنكلا",12,"ل",2,0],["يرثيه غيرَ محاذر فلقد مضى","من كان للأدباءِ بالمرصاد",13,"د",1,0],["يرثيك لكن في لسان قريحتي","بشجون والهة ونوح ثكول",14,"ل",1,0],["يرثون ميتهم بشعر ميت","قد كان أولى منهم برثاء",15,"ا",2,0],["يرثي الأنام لحالتي إما رأوا","بؤسي وأنظر حالتي متبسما",16,"م",2,0],["يرث المراتب بالطعان وعنده","أن الغنى بسوى القنا لم يسأل",17,"ل",1,0],["يُرثي لي الكاشِحُ المُرتابُ حَيثُ يَرى","ما بي مِنَ الوُجدِ ما أَعمى وَما أَصمى",18,"م",2,0],["يرثي لحالي فيبقى في تحيره","مني ويجهضه حالي فيجتهض",19,"ض",1,0],["يرثي أمير قَريضٍ شَفّهُ وَطَنٌ","غَنّى لِتُرْبَتِه واخْتالَ يَنْتَسِبُ",20,"ب",1,0],["يرثُ الذين ترحّلوا عنا هدى","يا حيّ يا قيوم غوثاً عاجلا",21,"ل",2,0],["يَرثي الإمامَ زمانُه وزماني","والقلبُ يدفقُ دمعةَ الاحزانِ",22,"ن",1,1],["يَرِثُ الأَرْضَ وَالْبِلَاد ، فَقَالَتْ","كُلُّكُمْ ثَائِرٌ عَلَى الثَّائِرِينَا",23,"ن",2,0],["يرثون الشعب إرثاً رخيصاً","دون كد ودون بذل جهود",24,"د",1,0]]}