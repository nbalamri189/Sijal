{"poems":[[31,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[47,"بقيت مسلما للمسلمينا","https://www.aldiwan.net/poem66692.html","الوافر"],[30,"وما عن قلى عاتبت بكر ابن وائل","https://www.aldiwan.net/poem5507.html","الطويل"],[82,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[82,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[76,"ومثلك مد يمين الندى","https://www.aldiwan.net/poem12937.html","المتقارب"],[41,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[50,"رضينا بالأمين عن الزمان","https://www.aldiwan.net/poem66137.html","الوافر"],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[113,"زعموا بأن الواقدي قد اشتكى","https://www.aldiwan.net/poem16540.html","الكامل"],[146,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[234,"إذا استخدمتني في طلاب العلا همم","https://www.aldiwan.net/poem50819.html","الطويل"],[285,"سواي لمن لم يعشق المجد عاشق","https://www.aldiwan.net/poem60578.html","الطويل"],[285,"خليلي إن لم تسعدا فذارني","https://www.aldiwan.net/poem60776.html","الطويل"],[287,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[369,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[372,"ثم إن ينزع إلى أقصاهما","https://www.aldiwan.net/poem4616.html","الرمل"],[384,"ترعى سميراء إلى أرمامها","https://www.aldiwan.net/poem4582.html","الرجز"],[447,"إذا ظفرت نفسي إليك تقاصد","https://www.aldiwan.net/poem14303.html","الطويل"],[466,"ينيخ المسيف النضو منه بممرع","https://www.aldiwan.net/poem15487.html","الطويل"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63856","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38121","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70746","البسيط"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216851",""],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20586","الهزج"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108930","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74174","البسيط"],[3168,"","https://poetry.dctabudhabi.ae/diwan/poem/35042","البسيط"],[3666,"","https://poetry.dctabudhabi.ae/diwan/poem/29394","الوافر"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105561","الرمل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90802","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4238,"","https://poetry.dctabudhabi.ae/diwan/poem/147738","المنسرح"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35116","الطويل"],[5055,"نفحة الأرطا","https://www.poetsgate.com/ViewPoem.aspx?id=106745",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"الدويّ الحيران","https://www.poetsgate.com/ViewPoem.aspx?id=180175",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""]],"verses":[["بازٌ تَظَلُّ عِتاقُ الطَيرُ خاشِعَةً","مِنهُ وَتَمتَصِعُ الكِروانُ وَاللُبَدُ",0,"د",1,0],["بِأَزهَرَ تُنسي الشِعرَ أَخبارُ سُؤدُدٍ","لَهُ لا تَزالُ الدَهرَ تُؤثَرُ أَو تُروى",1,"و",2,0],["بِأَزهَرَ مِن بَني ساسانَ يَلقى","بِهِ اللّاقونَ عِلقَهُمُ الثَمينا",2,"ن",2,0],["بِأَزكى هاشِمٍ حَسَباً وَأَعلا","هُمُ شَرَفاً وَأَنداهُم يَمينا",3,"ن",2,0],["بَأَزدِ عُمانٍ إِخوَةٌ دونَ قَومِهِم","لَقَد زَعَموا في رَأيِهِم غَيرَ مَرغَمِ",4,"م",1,0],["بأزْرَقَ في أسمرٍ لم يَزَلْ","دمُ الذِّمْرِ كالكحلِ في زرقته",5,"ت",2,0],["بأزهرَ يجلو اللهوُ فيه عرائساً","كراسيّها أيدي الكرامِ من الشَّربِ",6,"ب",1,0],["بِأَزرَقَ سالَت بِهِ صُفرَةٌ","كَما طَرَّزَ البَرقُ ثَوبَ السَحَر",7,"ر",1,0],["بازٍ غَدا يَنفُضُ عَن مَتنِهِ","نَضحَ سَماءٍ غِبَّ إِرذامِها",8,"م",3,0],["بِأَزهَرَ مِن بَني المَنصورِ تُنمى","إِلَيهِ وِلادَتانِ لَهُ اِثنَتانِ",9,"ن",1,0],["بإزاءِ آخَرَ جائشٍ متلاطمٍ","يَرغو إذا ما انصبَّ نحوَ مَسيله",10,"ل",2,0],["بِازاءِ عَرش اللَهِ جَلَّ جَلالُهُ","رزق الوَرى بِخَزائن مَخزون",11,"ن",1,0],["بازلُ عامين ارتضَى وخدَه","في طَرْقه العزَّ وإقبالَهْ",12,"ل",2,0],["بأزرقَ يَرمي الطيرَ منه بِمُقْلَةٍ","تكاد تَرَى ما يَستُر الثوبُ في الظُّلَمْ",13,"م",1,0],["بِأَزْهَرَ لَوْ أَلْقَى عَلى الْبَدْرِ مَسْحَةً","بِبَهْجَتِهِ لَمْ يَمْحَقِ الْبَدْرَ ماحِقُ",14,"ق",1,0],["بِأَزْهَرَ وَضَّاحِ الْجَبينِ مُهَذَّبٍ","جَمِيلِ الْحَيا ماضٍ أَغَرَّ هِجانِ",15,"ن",1,0],["بازِلُ المالِ صائِنُ العِرضِ مُهتم","مٌ بِتَحصينِ بَيضَةِ الإِسلامِ",16,"م",1,0],["بأزمانِ نُوشَرْوانَ فاخرَ أَحمدٌ","نَبِيُّ الهُدى لمّا تلاقَتْ سُعودها",17,"د",3,0],["بازِلٌ أَو أَخلَفَت بَازِلَها","عاقِرٌ لَم يُحْتَلَب مِنها فُطُرْ",18,"ر",1,0],["بأزل عام او سديس عاما","كان فوق المتن من سنامها",19,"م",3,0],["بازكي مقامي عنك واللَه شاهد","كأني على ضيقي بكفة صايد",20,"د",1,0],["بأزْهرَ ظُهْريِّ الجبين كأنهُ","سَنا الجوْنة الغراء غِبَّ المَواطرِ",21,"ر",1,0],["بازغٌ شمس فكرهِ عندما يصلد","في الداجيات قدحُ الزند",22,"د",1,0],["بازيكَ هذا من رفيعِ البَزِّ","طرازُهُ شاهدُهُ في الطُّرْزِ",23,"ز",1,1],["بِأَزواجِهِ خَير النّساء وإنّه","لعائشة قَد كانَ مِن زائدي الوُدِّ",24,"د",1,0],["بازي الحروبِ لَهُ الأَسيافُ أَجنِحَةٌ","إِن مَدَّها خِلتَ أسْدَ الحربِ كالرَّخَمِ",25,"م",1,0],["بازٍ لديه بُزاةُ الحرب حاصلةٌ","حاشاه عن ذكر بِيزانِ العصافير",26,"ر",1,0],["بازرَع التّفاح مِيراكم","قور تين وخَلط زَيتونا",27,"ن",2,0],["بِأَزكى مِن بَني رَيطَ","ةٍ أَو أَوزنَ في الحِلمِ",28,"م",1,0],["باز الإله الأشهب المتناول ال","حمد المطيب من ربى الأذهان",29,"ن",1,0],["بأَزكَى وَأوفى بَل وَأعلاَ تَحِيَّةٍ","وَقالَ لَهُ ادنُ فَقَد نِلتَ مَقصِدَا",30,"د",2,0],["باز يَصيد الكماة الصيد عَن حنق","وَسائر الناس في الهَيجا عَصافير",31,"ر",1,0],["بازٌ جَرِيءٌ عَلى الحِزّانِ مُقتَدِرٌ","وَمِن حَبابيرِ ذي ماوانَ يَرتَزِقُ",32,"ق",1,0],["بأزهر من سُراة بني أؤى","كبدر الليل راق على النجوم",33,"م",1,0],["بأزج مثل أجفان الظبا","وثنايا مثل أجفان الأقاح",34,"ح",1,0],["بازغاً للعيون يبدو بوجه","شق من نوره المشع الظلاما",35,"م",2,0],["باز إذا بجناح منه أنجدني","فالطير تعجب مني كيف لم أطر",36,"ر",1,0],["بأزكى وأَذكى منكَ حُسْناً وإنّما","بحسناكَ لا بالرَّوضِ للعائذِ الغَبْطُ",37,"ط",1,0],["بازية بنت بازيين ولم","تخلق بغاثاً أمي ولا رخمه",38,"م",2,0],["بِأَزرَقَ سَلّالِ الحُسامِ وَقَد بَدا","يُداعِبُ في كَأسٍ تَحَرَّكُ لِلرَّقصِ",39,"ص",1,0],["بازٍ بعد قرناس للحر شاهين","والصيد في يدي وانا ابه أماري",40,"ر",2,1],["بأزواجه بالآل بالصحب إنهم","هم الحائزون المجد والمفخر الفخا",41,"خ",2,0],["بازل نجّذته قبل الليالي","صرخات من هائب أو مهيب",42,"ب",1,0],["بأزبال أفكاره الغواة ذوي الردى","وقد ألفوا في محو أعلامها كفرا",43,"ر",2,0],["بازغ في سما الجنان بهيّ","نوَّر الزهدُ وجهه والحياء",44,"ا",2,0]]}