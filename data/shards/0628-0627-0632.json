{"poems":[[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[45,"بقيت مسلما للمسلمينا","https://www.aldiwan.net/poem66692.html","الوافر"],[28,"وما عن قلى عاتبت بكر ابن وائل","https://www.aldiwan.net/poem5507.html","الطويل"],[80,"وذي أربع كخوافي العقاب","https://www.aldiwan.net/poem31532.html","المتقارب"],[80,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[74,"ومثلك مد يمين الندى","https://www.aldiwan.net/poem12937.html","المتقارب"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[48,"رضينا بالأمين عن الزمان","https://www.aldiwan.net/poem66137.html","الوافر"],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[110,"زعموا بأن الواقدي قد اشتكى","https://www.aldiwan.net/poem16540.html","الكامل"],[143,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[230,"إذا استخدمتني في طلاب العلا همم","https://www.aldiwan.net/poem50819.html","الطويل"],[281,"سواي لمن لم يعشق المجد عاشق","https://www.aldiwan.net/poem60578.html","الطويل"],[281,"خليلي إن لم تسعدا فذارني","https://www.aldiwan.net/poem60776.html","الطويل"],[283,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[365,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[368,"ثم إن ينزع إلى أقصاهما","https://www.aldiwan.net/poem4616.html","الرمل"],[380,"ترعى سميراء إلى أرمامها","https://www.aldiwan.net/poem4582.html","الرجز"],[442,"إذا ظفرت نفسي إليك تقاصد","https://www.aldiwan.net/poem14303.html","الطويل"],[462,"ينيخ المسيف النضو منه بممرع","https://www.aldiwan.net/poem15487.html","الطويل"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"]],"verses":[["بازٌ تَظَلُّ عِتاقُ الطَيرُ خاشِعَةً","مِنهُ وَتَمتَصِعُ الكِروانُ وَاللُبَدُ",0,"د",1,0],["بِأَزهَرَ تُنسي الشِعرَ أَخبارُ سُؤدُدٍ","لَهُ لا تَزالُ الدَهرَ تُؤثَرُ أَو تُروى",1,"و",2,0],["بِأَزهَرَ مِن بَني ساسانَ يَلقى","بِهِ اللّاقونَ عِلقَهُمُ الثَمينا",2,"ن",2,0],["بِأَزكى هاشِمٍ حَسَباً وَأَعلا","هُمُ شَرَفاً وَأَنداهُم يَمينا",3,"ن",2,0],["بَأَزدِ عُمانٍ إِخوَةٌ دونَ قَومِهِم","لَقَد زَعَموا في رَأيِهِم غَيرَ مَرغَمِ",4,"م",1,0],["بأزْرَقَ في أسمرٍ لم يَزَلْ","دمُ الذِّمْرِ كالكحلِ في زرقته",5,"ت",2,0],["بأزهرَ يجلو اللهوُ فيه عرائساً","كراسيّها أيدي الكرامِ من الشَّربِ",6,"ب",1,0],["بِأَزرَقَ سالَت بِهِ صُفرَةٌ","كَما طَرَّزَ البَرقُ ثَوبَ السَحَر",7,"ر",1,0],["بازٍ غَدا يَنفُضُ عَن مَتنِهِ","نَضحَ سَماءٍ غِبَّ إِرذامِها",8,"م",3,0],["بِأَزهَرَ مِن بَني المَنصورِ تُنمى","إِلَيهِ وِلادَتانِ لَهُ اِثنَتانِ",9,"ن",1,0],["بإزاءِ آخَرَ جائشٍ متلاطمٍ","يَرغو إذا ما انصبَّ نحوَ مَسيله",10,"ل",2,0],["بِازاءِ عَرش اللَهِ جَلَّ جَلالُهُ","رزق الوَرى بِخَزائن مَخزون",11,"ن",1,0],["بازلُ عامين ارتضَى وخدَه","في طَرْقه العزَّ وإقبالَهْ",12,"ل",2,0],["بأزرقَ يَرمي الطيرَ منه بِمُقْلَةٍ","تكاد تَرَى ما يَستُر الثوبُ في الظُّلَمْ",13,"م",1,0],["بِأَزْهَرَ لَوْ أَلْقَى عَلى الْبَدْرِ مَسْحَةً","بِبَهْجَتِهِ لَمْ يَمْحَقِ الْبَدْرَ ماحِقُ",14,"ق",1,0],["بِأَزْهَرَ وَضَّاحِ الْجَبينِ مُهَذَّبٍ","جَمِيلِ الْحَيا ماضٍ أَغَرَّ هِجانِ",15,"ن",1,0],["بازِلُ المالِ صائِنُ العِرضِ مُهتم","مٌ بِتَحصينِ بَيضَةِ الإِسلامِ",16,"م",1,0],["بأزمانِ نُوشَرْوانَ فاخرَ أَحمدٌ","نَبِيُّ الهُدى لمّا تلاقَتْ سُعودها",17,"د",3,0],["بازِلٌ أَو أَخلَفَت بَازِلَها","عاقِرٌ لَم يُحْتَلَب مِنها فُطُرْ",18,"ر",1,0],["بأزل عام او سديس عاما","كان فوق المتن من سنامها",19,"م",3,0],["بازكي مقامي عنك واللَه شاهد","كأني على ضيقي بكفة صايد",20,"د",1,0],["بأزْهرَ ظُهْريِّ الجبين كأنهُ","سَنا الجوْنة الغراء غِبَّ المَواطرِ",21,"ر",1,0],["بازغٌ شمس فكرهِ عندما يصلد","في الداجيات قدحُ الزند",22,"د",1,0]]}