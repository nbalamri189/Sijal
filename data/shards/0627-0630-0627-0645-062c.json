{"poems":[[53,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[47,"وذي راحة مثل صوب الغمام","https://www.aldiwan.net/poem64581.html","المتقارب"],[189,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[190,"إذا مجن الثقيل رأيت فيلا","https://www.aldiwan.net/poem43527.html","الوافر"],[463,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53147","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18811","البسيط"],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""]],"verses":[["إذا مجَّ مجاتٍ من الأَري أَعْقبت","بأقصى سهام في أحدِّ حُماتِ",0,"ت",1,0],["إِذا مَجَّهُ بَلَدٌ بَسبَسُ","تَلَقَّمَهُ بَلَدٌ بَسبَسُ",1,"س",1,0],["إذا مَجَّه الغِمدُ اسْتنارَ كأنه","شبابٌ له بعد الهُدوء وقُود",2,"د",1,0],["إذا مجن الثقيل رأيت فيلا","يلاعب كركدنا في مضيق",3,"ق",1,1],["إذا مجَّ سمعيَ قولَ الوشاةِ","تعلَّقَ في أُذنيها شُنوفا",4,"ف",2,0],["إذا مَجَّتِ الأنواء فيها رضابها","فثغر أقاحيها له يترشف",5,"ف",1,0],["إِذا مَجاسِدُها اِغتالَت فَواضِلَها","مِنها رَوادِفُ فَعماتٌ وَمُؤتَزَرُ",6,"ر",1,0],["إذا مجّها في أسودِ اللّيلِ سبسبٌ","تعلّقها مع أبيض الصبح سبْسبُ",7,"ب",1,0]]}