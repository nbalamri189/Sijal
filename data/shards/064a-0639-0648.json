.com/ViewPoem.aspx?id=194595",""],[5957,"نصوغ الحزن ريحانا","https://www.poetsgate.com/ViewPoem.aspx?id=177066",""],[5957,"أمد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=204477",""],[4442,"أيا ريحانتي برياض أني","https://www.poetsgate.com/ViewPoem.aspx?id=171216",""],[6079,"أمِن بأسِ الفواجعِ تدمعينا","https://www.poetsgate.com/ViewPoem.aspx?id=208563",""],[6093,"فَلْسَفَةُ المَوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=179845",""],[6093,"لولا المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=191822",""],[3779,"تسل عن كل شيء بالحياة فقد","https://www.poetsgate.com/ViewPoem.aspx?id=105383",""],[6189,"ما تبقى من أحزان الرجال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83551&r=&rc=18",""],[6225,"شكوى وأمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78024&r=&rc=109",""],[6225,"أنِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81027&r=&rc=264",""],[463,"إذا رفعتْ من شرافَ الخدورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60064&r=&rc=120",""],[463,"رعتْ منْ تبالة َ جعداً خفيفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60146&r=&rc=202",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["يَعوجُ عَليكَ فَلا يَنثَني","وَيَشرَبُ مِنكَ فَلا يَنقَعُ",0,"ع",1,0],["يَعودونَ قَد رَدّوا العَظيمَةَ عَن يَدٍ","وَقَد أَغلَقوا بابَ الطُلاطِلَةِ البِكرِ",1,"ر",1,0],["يَعوذُ مِنَ الهِجرانِ أَن يَكتوي بِهِ","فَلم أَرَ إِلّا المَوتَ شَيئاً يُعادِلُه",2,"ل",2,0],["يَعُودُ فُؤَادِي ذِكْرُ مَنْ سَكَنَ الْغَضَا","فَيُقْعِدُهُ فَوْقَ الْغَضى وَيُقِمُهُ",3,"م",2,0],["يَعودُ عَلى مَولاهُ مِنهُ بِرَأفَةٍ","إِذا ما المَوالي مِن أَخيها تَخَلَّتِ",4,"ت",1,0],["يُعَوِّضُهُ الأُلوفُ مُصَتَّماتٍ","مَعَ البيضِ الكَواعِبِ وَالحِلالا",5,"ل",2,0],["يَعودُ الحِلمُ مِنكَ عَلى قُرَيشٍ","وَتَفرِجُ عَنهُمُ الكُرَبَ الشِدادا",6,"د",2,0],["يَعودُ وَكانَ الخُبثُ مِنهُ سَجِيَّةً","وَإِن قالَ إِنّي مُعتِبٌ غَيرُ عائِدِ",7,"د",1,0],["يَعوذونَ بِالسُلطانِ مِنّا وَفَلُّهُم","كَذي الغارِبِ المَنكوبِ أَوجَعَهُ الوِقرُ",8,"ر",1,0],["يَعودُ مِن كُلِّ فَتحٍ غَيرَ مُفتَخِرٍ","وَقَد أَغَذَّ إِلَيهِ غَيرَ مُحتَفِلٍ",9,"ل",1,0],["يَعودُ وِسادي وَهوَ جَذلانُ ناعِمٌ","وَيَرجِعُ عَنّي وَهوَ أَسوانُ لاهِفُ",10,"ف",1,0],["يَعودُ لِلصَبِّ بَرحُ لَوعَتِهِ","إِن عاوَدَ الصَبَّ في دَدٍ دَدَنُه",11,"ن",2,0],["يَعودُ عَلى المَولى نَداهُ وَمالُهُ","وَقَد عَزَّ وَسطَ القَومِ مَن هُوَ ناصِرُه",12,"ر",2,0],["يَعودُ إلى الرُّمحِ الرُّدَينيِّ ماؤُه","ويُورِقُ إن ضُمَّتْ عليه أصابِعُه",13,"ع",2,0],["يُعَوَّمُ فيها كُلُّ جامٍ كَأَنَّما","تَضَمّنَ رُوحُ الشَّمسِ في جَسَدِ البَدرِ",14,"ر",1,0],["يَعُودُ بأهلِهِ ويُزادُ مالاً","على مالٍ من الإبلِ الهِجانِ",15,"ن",1,0],["يُعَوَّذُ من مكحولةِ الخِشفِ إن بدا","ويُنضَحُ نفْتَ الراقياتِ ويُنْضَخ",16,"خ",1,0],["يَعوذُ بِاللَهِ إِن أَصبَحتَ ذا عَدَمٍ","وَلَيسَ مِنكَ إِذا تُثري بِمُعتاذِ",17,"ذ",1,0],["يَعودُ فَنيدُ المُلكِ إِن عادَ جَدُّهُ","مُعَدٌّ إِلَيكُم أَو أَبوهُ نِزارُ",18,"ر",1,0],["يَعودُ أَخوكَ إِلى غَيِّهِ","وَإِن حَجَّ مِن نُسكِهِ وَاِعتَمر",19,"ر",1,0],["يَعومُ في اللُجِّ رَكبٌ يَمتَطي سُفُناً","وَيَجنُبُ الخَيلَ سارٍ يَركَبُ الإِبِلا",20,"ل",2,0],["يعود منك إلى بغداد شوكتها","مما مضى عهده في سالف الحقب",21,"ب",1,0],["يعود إلى بدءٍ له كل ذاهب","وليس لأيام الشبيبة من عود",22,"د",1,0],["يعود عن غيمك من شامه","وهو شديد ظمؤُه مخفق",23,"ق",1,0],["يَعُودُهُ النَّاسُ إِنْ مَرَّ النَّسِيمُ بِهِ","وَلا يَعُودُ مِنَ الإِشْفَاقِ مَنْ عَادَا",24,"د",2,0],["يعود في الكون كلُّ شيءٍ","وذاهب العمر لن يعودَا",25,"د",2,0],["يعود ينهي الكأس ، من بدئها","فيبتدي قبل الشراب الحمار",26,"ر",1,0],["يُعوزُ الشعبَ كي يسيرَ إلى المجد","حثيثاً وكي يُوَقَّى العِثارا",27,"ر",2,0],["يعود منه الطَّولُ والإنعام","إذ كلُّ غَيْث عوْدُهُ جَهامُ",28,"م",1,0],["يعوي عبيدُ اللَّه من إضباعها","واسعة ُ الخرق على رُقَّاعها",29,"ع",3,0],["يعود بما يصحى من السكر ملكه","وينهاه عن ذكر المحال ويردع",30,"ع",1,0],["يَعودُ إِلَيكُم بِالبَقاءِ وَعَيشُكُم","رَقيقُ الحَواشي وارِفُ الظِلِّ أَغيَدُ",31,"د",1,0],["يَعودُ فيهم روَيداً غَيرَ مُكتَرِثٍ","بِهِم وَقَد كَرَّ فيهم غَيرَ مُحتَفِلِ",32,"ل",1,0],["يُعَوِّلُ مِنْهُ الْعَسْكَرُ الدَّهْمُ فِي الْوَغى","عَلَى واحِدٍ كَمْ فيهِ مِنْ عَسْكَرٍ دَهْمِ",33,"م",1,0],["يَعودُ البَدرُ عَنها ذا مِحاقٍ","إِذا نَظَرَت إِلَيهِ في الكَمالِ",34,"ل",1,0],["يَعودُ بِالتَّهليلِ أَعداؤُهُ","إِذا رَأَوهُ في الوَغى كَبَّرا",35,"ر",2,0],["يعود الربيع قشيب الثياب","فيزهو به الروض والبلقع",36,"ع",1,0],["يَعوي عواءَ الكَلبِ","من شِدَّةٍ وكَربِ",37,"ب",1,0],["يَعومُ ذِراعاها وَعَضدانِ مارَتا","فَكُلٌّ لَهُ جافٍ عَنِ الدِفِّ مِرفَقُ",38,"ق",1,0],["يَعوذُ المُسلِمونَ بِحَقوَتَيهِ","إِذا ما كانَ خَوفٌ أَو رَجاءُ",39,"ا",2,0],["يَعودُ إلى خَدِّ الندّيمِ خِضابُها","إذا هو من كَفِّ المُديرِ لها نَضا",40,"ض",2,0],["يَعودُ عَليلاً لا يَعودُ شِفاؤُهُ","لَعَمري لَقَد زِدتُم جَريحَكُمُ جَرحا",41,"ح",2,0],["يعود كما قد كان من قبل سَقطةٍ","متى كان في الفردوس آدمُ يرتع",42,"ع",1,0],["يَعوي لِتَنَبحه الكِلاب كَما عَوى","ذيب بِأَعلى قُلَّة الصَمّانِ",43,"ن",1,0],["يَعومُ بِهِ في غمَرةِ الحَربِ سابِحٌ","يُقَرِّبُ بُعدَ الهم حينَ يقربُ",44,"ب",1,0],["يعود ما فات من عهد الشباب بها","يشبّ فيها معاطيها ولم يشب",45,"ب",1,0],["يعود زمان مرَّ حلوُ مذاقه","وشمل أحبَّائي كما كانَ يجمع",46,"ع",1,0],["يعودُك والعيد من بعدِهِ","متى فارقا فلسعدٍ مقيمِ",47,"م",1,0],["يعود العيدُ دارَك ألفَ شمسٍ","عليك غروبُها وبك الشروقُ",48,"ق",1,0],["يعود بها الفحلُ نِضواً أجب","بَ يألم جِرَّتهُ والصريفا",49,"ف",2,0],["يعود بأوّلِ نِصفيْه لي","إذا قلتُ كاد وجاء الأخيرُ",50,"ر",1,0],["يعود إذا تغرَّب في العطايا","ويُقلع في الهَناتِ فلا يعودُ",51,"د",1,0],["يعولُ الأرضَ ما كسبَتْ يَدَاهُ","وما كلُّ ابنِ مَرْقَبَةٍ كسوبُ",52,"ب",1,0],["يعودكَ منْ هَواها عيدُ مَدْحٍ","كما يعتادُكَ الضَّيْفُ الطَّروقُ",53,"ق",1,0],["يعودُ بها المُثْري ضَريكاً وينْثني","لها المُترفُ المجدودُ خصمانَ عافيا",54,"ي",2,0],["يعودُ إلى النهَّج القويم من العلى","وناهيك والبيت السليم من اللّحن",55,"ن",1,0],["يَعوجُ بِهِ عَلى الأَهوالِ عَزمٌ","يُضيءُ لَهُ إِذا اِعتَكَرَ العَجاجُ",56,"ج",1,0],["يعوجُ عليها وهي قفرٌ وما بها","سوى طللٍ بادٍ لعينيهِ ماثلُه",57,"ل",2,0],["يعودُ له بدرُ السماءِ إذا بدا","له ورآه خاسئَ الطرفِ خاشعا",58,"ع",2,0],["يعودُ بالطُّعْمِ حينَ يُمسِي","بحاجة الصّوتِ للنّجاحِ",59,"ح",1,0],["يعود من الكمال إلى انتقاص","ويصحبك الكمال على الدوام",60,"م",1,0],["يَعودُ الفتى أغنى الوَرى ولَطالَما","قد باتَ مَنفوضَ الجِراب عَديما",61,"م",2,0],["يَعودُ بِما شِئتَ شوقاً إليك","مراراً وإنْ لم تُعِره اِنتظارا",62,"ر",2,0],["يعود لعبد اللَه حسب مراده","عبادة عبد الله عند عباده",63,"ه",1,0],["يعودُ من وجهها ليلُ الظلام ضحىً","والصبحُ من فرعها ليلاً بهِ قمرُ",64,"ر",1,0],["يعودني إن مرضت سكرا","عودني بالوفا عوائد",65,"د",1,0],["يُعَوِّدُ تخضيْبَ النُّصُوْلِ وإنْ رَأَى","نُصُوْلَ خِضابٍ فالدِّماءُ برايئُ",66,"ا",1,0],["يُعوضُني شقراءَ شَمليلَ كَرَّةً","تُزيلُ مُهِمّا في فؤاديَ ثاويا",67,"ي",2,0],["يعوذ بالملك الشعب الحفي به","من الرزيئة في أحراره الصيد",68,"د",1,0],["يَعودُ عَلَيهِ غَير راضٍ بِضَعفِهِ","وَسَلبِ الّذي أَولى فَتوهى أُمورهُ",69,"ر",2,0],["يُعَوِّقُنِي عَنْهَا التّخَلُّفُ وَالشَّفَا","مُحِبٌّ تَمَنَّى أَنْ يَتِمَّ لَهُ الأمَلْ",70,"ل",1,0],["يعود لا يرى يوما له كفل","في غارة فهو يوم الروع هاديهِ",71,"ي",2,0],["يعودك عاد عود الجود غضا","وأصعبت المنى بعد الحرانِ",72,"ن",1,0],["يَعود على وفّاده كلّ سابحٍ","وكلّ أمون الظهر وجناء جلعدِ",73,"د",1,0],["يعود من العراك وفي يديه","تورّد من دم القوم الخضابُ",74,"ب",1,0],["يَ عْوِضي عن ماضي اسلافي","قَبل حبي لاَوّلي وينه",75,"ن",2,0],["يُعَوِّدُ راحَتَيهِ البَسطَ إِلّا","عَلى إِمساكِ سَيفٍ أَو عِنانِ",76,"ن",1,0],["يعودانِ زُعراً بالخَميلَةِ دَردَقاً","ومَرصوصَ بيضٍ حولَها لم يُنتَّجِ",77,"ج",1,0],["يعود إليه بعد ما يورث عداه","ويجمع الأمر في كف البيان",78,"ن",1,0],["يَعودُ عَلى ذي الجَهلِ بِالحِلمِ وَالنُهى","وَلَم يَكُ فَحّاشاً عَلى الجارِ ذا عَذمِ",79,"م",1,0],["يَعوذونَ مِنّا بِمَولاهُم","وَمَولاهُمُ عاذَ بِالزَّورَقِ",80,"ق",1,0],["يعود ذليلاً بين من يجهلونه","ويغدو زرياً لا يروق بمنظر",81,"ر",1,0],["يَعولونَهُم فَضلاً وَلا صِهرَ بَينَهُم","وَلا نَسَبٌ يُدنيهِمُ أَو تَعارُفُ",82,"ف",1,0],["يَعودُ شَبابُهُ في كُلِّ فَجرٍ","وَيَأبى لي شَبابي ما يَعودُ",83,"د",1,0],["يعودُ للخَنِّ بكلِّ شَهرِ","