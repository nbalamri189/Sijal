{"poems":[[55,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[29,"أتزور أم محمد أم تهجر","https://www.aldiwan.net/poem5738.html","الكامل"],[74,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[87,"أعطى البرية إذ أعطاك باريها","https://www.aldiwan.net/poem7922.html","البسيط"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[275,"هلا التفت لكي نحييك","https://www.aldiwan.net/poem35361.html","أحذ الكامل"],[285,"أنت للمسلمين حصن وحرز","https://www.aldiwan.net/poem60691.html","الخفيف"],[382,"أيلام بشر بالهوى وهو الفتى","https://www.aldiwan.net/poem66983.html","الكامل"],[435,"بشراك يا مجد العلى بشراكا","https://www.aldiwan.net/poem41438.html","الكامل"],[447,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[447,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[484,"للّه بيتا بنيت فابشر","https://www.aldiwan.net/poem36892.html","مخلع البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2408","المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138278",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119949","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80169","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56379","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56338","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112858","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112738","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79877","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77249","الكامل"],[2677,"","https://poetry.dctabudhabi.ae/diwan/poem/147749","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79713","الخفيف"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31698","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[4767,"تبت يداك","https://www.poetsgate.com/ViewPoem.aspx?id=181315",""],[4869,"احبك لحالك","https://www.poetsgate.com/ViewPoem.aspx?id=151550",""],[4869,"احتفال اليوم الوطني السعودي في الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151631",""],[5010,"اَلْوَيْلُ لِلشُّعَرَاءِ أَرْبَابِ الْحِيَل","https://www.poetsgate.com/ViewPoem.aspx?id=190353",""],[5106,"هذا حَبيبي بِوجهِ الفَجرِ ينتظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=139107",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5277,"رسالة منها...","https://www.poetsgate.com/ViewPoem.aspx?id=190741",""],[5277,"زهرة البيتونيا","https://www.poetsgate.com/ViewPoem.aspx?id=190958",""],[5277,"أنتِ البسيط","https://www.poetsgate.com/ViewPoem.aspx?id=191076",""],[5277,"أميرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192119",""],[5277,"دعني أراك","https://www.poetsgate.com/ViewPoem.aspx?id=194543",""],[5277,"ريحانةُ بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=205643",""],[5281,"رحلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=199222",""],[5431,"على لسان الحرية...","https://www.poetsgate.com/ViewPoem.aspx?id=209177",""],[5518,"هو المختار (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5525,"ما لي على الحب سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=7263",""],[5628,"حب بلا حدود","https://www.poetsgate.com/ViewPoem.aspx?id=191439",""],[5720,"مَنْ أُعطيَ جوامعَ القولِﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=201565",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5853,"دموعٌ وتوجع","https://www.poetsgate.com/ViewPoem.aspx?id=175615",""],[5861,"ارفق فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=188295",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[6106,"سيدنا الإمام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=6315",""],[6134,"أنت البشير الذي جبريل ماثله","https://www.poetsgate.com/ViewPoem.aspx?id=169559",""],[6185,"أنت البلاد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86940&r=&rc=0",""],[5567,"في صمتها الطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69065&r=&rc=5",""]],"verses":[["أَنتَ أَلبَستَني العُلى فَأَطِلها","أَحسَنُ اللِبسِ ما يُجَلِّلُ عَقبي",0,"ب",2,0],["أَنتَ البَعيثُ تَبينُ فيهِ عُبودَةٌ","وَأَبوكَ عَبدُ بَني زُراةَ بَغثَرُ",1,"ر",1,0],["أنت البداوة في التركِ الأولى نشأوا","مع الضراغم في الأغيال تشترك",2,"ك",1,0],["أَنتَ البَرِيَّةُ فَاِهنَأ وَهيَ أَنتَ فَمَن","دَعاكَ يَوماً لِتَهنا فَهوَ داعيها",3,"ي",3,0],["أَنتَ البَشيرُ بِهِ وَقَيِّمُ قَصرِهِ","وَمُقَدِّمُ النُبَلاءِ مِن حُجّابِهِ",4,"ب",2,0],["أنتِ البريّةُ لي فلا عجبٌ","وجمالها مُتجمِّعٌ فيك",5,"ك",1,0],["أَنْتَ أَلْبَسْتَنِي مَلابِسَ نُعْمى","خَشِنٌ عِنْدَهُنَّ خَزُّ وَقَزُّ",6,"ز",1,0],["أنت البَرَى ولذا تصير إلى البَرى","لا تطمعنْ بسلامةٍ وبَراء",7,"ا",2,0],["أنت البشير إلى البرايا بالمنى","ونصيرهم يا سيعد من والاكا",8,"ك",2,0],["أنت البصير بنا السميع القاهر","قهار مقتدر ربنا",9,"ن",2,0],["أنت البصير بلا عين مصورة","أنت السميع ولا أذن بها سمعا",10,"ع",2,0],["أنت البشير التقى الحسيني","فليفتخر بيتك الفخيم",11,"م",1,0],["أَنتَ البِطاحِيُّ مِن أُمَيَّةَ في ال","بَيتِ الَّذي عَزَّ ساكِنَ الحَرَمِ",12,"م",1,0],["أنت البليغ الذي من قوله حجج","إن كان منتظما أو كان منتثرا",13,"ر",2,0],["أنت البلادة خلقةً","مع ما حويت من البلاده",14,"د",2,1],["أنْتَ ألْبَسْتَنِي مَلاَبِسَ نُعْمَى","قَلَّدَتْ بِالعُقُودِ صَفْحَةَ جِيدِي",15,"د",2,0],["أَنتَ البَليغُ الَّذي أَلفاظُهُ دُرَرٌ","تَهدى فَتحفظها في جيدِها الحِقَبُ",16,"ب",1,0],["أنت البشير الذي في","سناه ضاء الرشادُ",17,"د",1,0],["أنت البشير الذي ترجى حمايتهُ","والمستغاث به في حادث النوبِ",18,"ب",1,0],["أنت البديع الخُلق والاخلاق مكثار","العطا فاق البدور ضياكا",19,"ك",2,0],["أنت البديع الباقي فاجزل للعطا","لجميعنا متواتر الارسال",20,"ل",1,0],["أنت البغاثُ لمعشرٍ","فعلامَ صرت عليَّ صقرا",21,"ر",2,0],["أَنتِ البَقِيَّةُ مِن مَعالِيَ أُمَّةٍ","دَرجَت وَإِرثِ مملَكينَ عِظامِ",22,"م",1,0],["أنت البريء من الإساءة كلها","ولك الرضى وأنا المسيء المذنب",23,"ب",1,0],["أنت ألبستهم من الخلد ثوباً","لا يجيز الآلام والأسقاما",24,"م",2,0],["أًنْتَ البَعوضَةُ قِلَّةً","وكَأَنَّها جَمَلُ الضَّحيَّه",25,"ي",2,0],["أَنتَ البِلادُ وَما تُقلّ","أَنتَ الأَعزّ بِها الأَجَلُّ",26,"ل",1,1],["أنت البلاء وأنت مَن","في القول قد ساء الأدب",27,"ب",1,0],["انت البدر يآآآمن يكفي هلآلك","ولغير حُبك مآلي ايّآت ملّه",28,"ل",2,0],["انت البر وانت البحْر وايضاً","انت الجو وحنّا اللي اعتلينا",29,"ن",2,0],["أَنتِ الْبَهَاءُ لِكِلِّ ( بَاءٍ ) ، فَأْمَنِيْ","لَا تَقْلَقِيْ أَبدًا لِشَيْءٍ مَا حَصَلْ",30,"ل",1,0],["أَنْتِ البَقَاْءُ عَلَىْ الدَُّنْيَاْ يُدَلِّلُنِيْ","يَكْفِيْ بِهَٰذَاْ مِنَ الدُّنْيَاْ . أَجَلْ . نَعَمُ",31,"م",1,0],["أنت البليغ وعين الضاد شاهدة","يحدوك منها إليها الدهرَ نشدان",32,"ن",1,0],["أنتَ البهاءُ وما سواكَ يطيبُ لي","بدرٌ يُضيءُ الأفقَ سحرُ سناكا",33,"ك",2,1],["أنتِ البعيدة عنْ رُوحي..وعنْ جَسَدي","قدْ خفتُ يَمْنعني منْك الغداة رَدى",34,"د",2,0],["أنت البسيطُ عروضٌ راح متئدا","يحكي من القلبِ سراً فيه نودعهُ",35,"ع",2,0],["أنت البهاءُ وما سواك يطيبُ لي","بدرٌ يُضيءُ الأفقَ سحرُ سناكِ",36,"ك",1,1],["أنتِ البهاءُ وحسنُ وجهك شفَّني","حتى سكنتِ مكامنَ الأحشاء",37,"ا",2,0],["أنتِ البنفسجُ والريحانُ والفُلُّ","وأنت مِسْكُ الهوى العذريّ , والأهْلُ",38,"ل",1,1],["أنتَ البَشِيرُ وأَنتَ الخَيرُ أَجمَعُهُ","أنتَ المحبَّةُ عَذبُ الذِّكرِ ذِكْرَاهَا",39,"ا",3,0],["أنت البهيّ كنوز الأرض رفعتها","أما العبيد فما ساووا بها فلسا",40,"س",2,0],["أنت البشير لهم، وأنت نذيرهم","نعم البشارةُ منك والإنذار",41,"ر",1,0],["أنت البخيل ابمنتك وقت الاحسان","وانت الذي لطفه يسابق عطاياه",42,"ا",2,0],["أنت ِ البدايةُ والنهايةُ والهوى","قدري وإنّي الميّتُ المولودُ",43,"د",1,0],["أنتَ البلاغةُ نرجوهَا فنَلْمَسُهَا","ما بينَ هَديٍ أزاحَ الَّلبْسَ فاتَّضَحَا",44,"ح",2,0],["أنت البشير برحمة أزلية","أبدية للمبتغين صلاحا",45,"ح",2,0],["أنتِ البريئةُ من دمائي إنما","بسهامِ عينكِ يا مها مقتولُ",46,"ل",1,0],["أنت البنفسج والذي من عطره","فاح النسيم وفاح منه العودُ",47,"د",1,0],["أنت البصير بحالنا وقد استوى","في علمك الإعلان والإخفاءُ",48,"ا",2,0],["أنت البخيل برؤيتي","وأنا بأفئدتي معكْ",49,"ك",1,0],["أنت البلاغة بل منكم منابعها","أنت الفصاحة ترمي الكل بالبكم",50,"م",1,0],["أنت البشير الذي جبريل ماثله","فكنت تحكيه في حسن وفي طهر",51,"ر",1,1],["أنتِ البلادُ جميعًا كلُّ أُغنِيَةٍ","قيلتْ لغيرِكِ عادتْ في فميْ حجَرَا",52,"ر",2,0],["أنت البداية منذ كان الزمان فتى","أسرفت في الحسن أنت الفتنة العجبُ",53,"ب",1,0]]}