{"poems":[[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[92,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[96,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[275,"مني تحب البنات","https://www.aldiwan.net/poem35261.html","المجتث"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107032","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76072","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112655","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94533","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[5072,"هو عيدكم","https://www.poetsgate.com/ViewPoem.aspx?id=51804",""],[5111,"القَلمُ المُرَابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=212648",""],[5351,"عشر همسات وهمسة","https://www.poetsgate.com/ViewPoem.aspx?id=202051",""]],"verses":[["نَاغَيْتُهَا بِلِسَانِ الشَّوْقِ فَازْدَهَرَتْ","لِلْحُسْنِ في وَجْنَتَيْهَا وَرْدَتَا خَفَرِ",0,"ر",1,0],["ناغي خيالُكِ \" أطفالي \" فيقظتُهم","ذكرى ، وطيفُكِ مغناهم إذا هجعوا",1,"ع",3,0],["ناغيت \" لُبناناً \" بشِعريَ جِيلا","وضفرته لجبينهِ إكليلا",2,"ل",2,1],["ناغيتُ \" لُبناناً \" وهل أبقى الهوى","بُقيىً على قيثارتي لتقولا",2,"ل",2,0],["نا غاب عن أعراسنا أهلنا","ألشمس والأنجم في المهرجان",3,"ن",1,0],["ناغيتُ بعضَ العذارى","وهنَّ لي عاذِرات",4,"ت",1,0],["ناغي المسيح في الصبا بعهده","كأنه كان رضيع مهده",5,"ه",1,0],["ناغِشُ الطَرفِ ناعِسٌ بذبُولٍ","مُفعَمُ الرِدفِ كَشحُهُ مَهضومُ",6,"م",1,0],["ناغاهُ جبرئيلُ عند مهدِهِ","وكان يمتَصُّ لسانَ جدّهِ",7,"ه",1,0],["ناغت بلابل روض لبنانٍ بهِ","طرباً وتصدح بالليالي كالسحر",8,"ر",1,0],["ناغت سواجع عصرهِ في أمنهِ","أسَّ السياسة قد أشاد وعدَّلا",9,"ل",2,0],["ناغَت سواجعها وصاح هَزارُها","وَالغصنُ ماس كذا الجمادُ لَقَد شَدا",10,"د",2,0],["ناغى بِها الأصداءَ كُلُّ سابِقٍ","لَم يُبقِ مِنهُ جَوبُها غَيرَ صَدى",11,"ا",1,0],["ناغيت ُ هذا الصبح َ إذ قفل َ الضحى","ورجوت ُ طير َ الشعر ِ كي يأتي الغِّنا",12,"ن",2,0],["نَاغَيْتُهمْ عَبْرَ الدُّرُوسِ بِبَسْمَةٍ","فَتَرَاقَصَتْ لغَةُ الهَوى إقْبَالاَ",13,"ل",2,0],["ناغيتُ صمتهما بشجو عواطفي","فعرفت ُ سرهما وما معناهما",14,"م",2,0]]}