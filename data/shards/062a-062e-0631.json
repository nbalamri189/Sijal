"","https://poetry.dctabudhabi.ae/diwan/poem/122392","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83248","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116498","الطويل"],[2820,"","https://poetry.dctabudhabi.ae/diwan/poem/29510","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100720","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46914","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62863","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127004","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86293","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114298","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77060","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136926",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54399","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105505","الوافر"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33819","المنسرح"],[4830,"أبا الفضل","https://www.poetsgate.com/ViewPoem.aspx?id=206564",""],[5008,"الضيقة","https://www.poetsgate.com/ViewPoem.aspx?id=27301",""],[585,"لك الله من منقض قصرٍ لدى القفر","https://www.poetsgate.com/ViewPoem.aspx?id=161871",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5224,"تجلى حسنه من معدن النور","https://www.poetsgate.com/ViewPoem.aspx?id=121298",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5909,"وقلتَ له بأنك لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=210577",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5956,"مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=192324",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""],[572,"تخَرَجَتْ اَقبَحَ المخارجِ مِنْهٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9436&r=&rc=293",""]],"verses":[["تَخرُجُ النَبأَةُ مِنهُ وَثبَةً","مَضرَبَ الريحِ عَلى الطَودِ الإِزارا",0,"ر",2,0],["تَخُرُّ لِنَهضِهِ الحِربا","ءُ ساجِدَةً يَعافِرُه",1,"ر",2,0],["تَخِرُّ على الأذْقانِ في عَرَصاتِهِ","ملوكٌ يَرَوْنَ العِزَّ تَحتَ هَوانِ",2,"ن",1,0],["تخرّموا لمْ يكُنْ في الأرضِ منْحَدَرٌ","يَقي المَنونَ ولا في الجوِّ مُنْعَرَجُ",3,"ج",1,0],["تُخرِجُ الشَيخَ مِن بَنيهِ وَتُلوي","بِلَبونِ المِعزابَةِ المِعزالِ",4,"ل",1,0],["تُخرِجُهُ إِلى الكِناسِ إِذا اِل","تَجَّ ذُبابُ الأَيكَةِ الأَطحَل",5,"ل",1,0],["تُخرِجُ الوِدَّ إِذا ما أَشجَذَت","وَتُواريهِ إِذا ما تَشتَكِر",6,"ر",1,0],["تَخرُج خُزاعَةُ مِن لُؤمٍ وَمِن كَرَمٍ","فَلا تَعُدُّ لَها لُؤماً وَلا كَرَما",7,"م",2,0],["تَخِرَّ لَنا تِلكَ المَعاقِلُ سُجَّداً","وَتَرمي لَنا بِالأَهلِ تِلكَ المَطامِرُ",8,"ر",1,0],["تَخِرُّ عَلى مَتنِ الكَثيبِ وَمَتنُهُ","رَذاذٌ هَوى مِن ديمَةٍ غَيرِ وابِلِ",9,"ل",1,0],["تُخرج أصناف الثمر","تنبت أجناس الزهر",10,"ر",1,0],["تَخرِقونَ الجُيوشَ جَيشاً فَجَيشاً","مِثلَما يَخرِقُ الخَواءَ الغَمامُ",11,"م",1,0],["تَخِرُّ لَهُ القَبائِلُ ساجِداتٍ","وَتَحمَدُهُ الأَسِنَّةُ وَالشِفارُ",12,"ر",1,0],["تخرج منها وعلى رأسك التاج","الذي ليس له عِدلُ",13,"ل",1,0],["تَخرَّقَ في ابتذالِ الوَفْرِ حتَّى","توهَّمْناه مخروقَ البَنانِ",14,"ن",1,0],["تَخْرُقُ المُزْنَ والتُّرابَ إلى الما","ءِ بتلكَ الفُروعِ والأعراقِ",15,"ق",1,0],["تَخِرّ رؤوسُ العدى في الوغَى","لها سُجّداً يا لَه مِن سُجودِ",16,"د",1,0],["تَخَرّقَ فيها لمعُ برْقٍ كأنّما","يَشُبّ ويَخبُو من سَنَاهُ سراجُ",17,"ج",1,0],["تَخَرُّصاً وَأَحاديثاً مُلَفَّقَةً","لَيسَت بِنَبعٍ إِذا عُدَّت وَلا غَرَبِ",18,"ب",1,0],["تَخرُجُ مِن دَنِّها وَقَد حَدِبَت","مِثلَ هِلالٍ بَدا بِتَقويسِ",19,"س",1,0],["تَخرُجُ إِمّا سَفَرَت حاسِراً","تُدِلُّ بِالحُسنِ وَلا تَنتَقِب",20,"ب",1,1],["تَخَرَّصَ القَومُ في الأَخبارِ أَو مُسِخوا","فَبُدِّلوا بَعدَ إِنسٍ جيلَ نَسناسِ",21,"س",1,0],["تخرّ الرفاق المعتفون عليهم","سقوط القطا الكدري في نطف البحر",22,"ر",1,0],["تَخِرُّ حِظَاءُ النَّبْعِ تَحْتَ جَبِينِهِ","إِذَا سَنَحَتْ أَيْدِي المُفِيضينَ صَدَّرَا",23,"ر",2,0],["تَخَرَّمَ خَفَّانَيْنَ والَّليْلُ كَانِعٌ","وكَشْحاً وآلاتٍ تُغَاوِلُ مِعْضَدا",24,"د",2,0],["تخرُّ العروشُ وتَهوي الشموسُ","ولي عرشيَ الخالدُ الأبدُ",25,"د",1,0],["تخرج الألفاظ معذوذبِةً","من فم حلو اللمى معذوذب",26,"ب",1,0],["تُخَرِّجُ عُذراً يُسلّي أخاً","فأنت المدِلُّ به المُنعِم",27,"م",1,0],["تخرجُ الودّ إذا ما أشجذت","وتورايهِ إذا ما تشتكر",28,"ر",1,0],["تخرس الأنباء ممّا حملت","فهي همس في شفاه السّفراء",29,"ا",2,0],["تَخر لَها الضَمائر ساجِدات","وَتَلثم ترب مَوطئها الأَماني",30,"ن",2,0],["تَخِرُّ لها القَصائدُ ساجِداتٍ","برغم البُعدِ، ليست بالبعيدةْ",31,"د",2,0],["تخرَّمه ورُواءُ الشبا","بِ لم يدرِكم طولُه الذارعُ",32,"ع",1,0],["تَخِرُّ بِهِ شُمُّ الجماجم سُجَّدا","ويخشَعُ فيه كلُّ ذى خُلُق جاسِ",33,"س",1,0],["تخِرُّ له الأقْرانُ في الحربِ سُجَّدَاً","إذا قدَّ هاماتِ الرِّعالِ نِصَالُ",34,"ل",1,0],["تَخرِقُ البَحرَ وَالمَواثيقَ وَالعَه","دَ جِهاراً وَذِمَّةَ الجيرانِ",35,"ن",1,0],["تَخِرُّ نِعالُها وَلَها نَفِيٌّ","نَفِيَّ الحَبِّ تَطحَرُهُ المِلالُ",36,"ل",1,0],["تَخِرُّ نِعالُها وَلَها نَفِيٌّ","مِنَ المَعزاءِ مِثلُ حَصى الخِذافِ",37,"ف",1,0],["تُخُرِّمُوا بِابْنِ عَبْدِ الحَقِّ واصْطُلِمُوا","وَقَبْلَها ما اسْتُبِيحُوا بِابْنِ زَيَّانا",38,"ن",2,0],["تَخريبُ بَيْتِ المالِ عادَةُ جُودِه","وحَصَانَةُ العَلياءِ في تَخْريبِهِ",39,"ب",2,0],["تَخَرّمَهُ الحِمامُ وَكُلُّ حَيٍّ","عَلَى حُكْمِ الْحِمامِ لَهُ نُزُولُ",40,"ل",1,0],["تُخرِّبون بأيديكم بيوتكمُ","جهلاً أكلُّكُمُ يا (عربُ) أغمار",41,"ر",1,0],["تُخرِجُ مِن أفواهِها","ما أدخلَت آذانُها",42,"ن",3,0],["تَخَرَّمَها العَطاءُ فَكُلَّ يَومٍ","يُجاذِبُ راكِبٌ مِنها قَرينا",43,"ن",2,1],["تَخَرَّمَ ثَفرها أَيَّامَ حلَّت","على نَمَلى فَجِيبَ لَهَا أَدِيمُ",44,"م",1,1],["تَخِرُّ غداة الرَوعِ في الطِرسِ سُجَّدا","فَبيضٌ كَبيضِ الهِندِ في الهامِ رُكَّعا",45,"ع",2,0],["تَخرُّ لَهُ الأَملاك إِن بَصَروا بِهِ","سُجوداً وَلَو أَنَّ القَنا مُتشاجِرُ",46,"ر",1,0],["تَخُرُّ لَهُ الأَملاك في الأَرضِ سُجَّدا","وَقَلَّ لَهُ تَعفيرَها وَسُجودَها",47,"د",3,0],["تخرَّمَتِ الأيامُ أهلَ مودَّتي","فَنَفْسي عَن أُنْسِ المسرَّاتِ ناشِزُ",48,"ز",1,1],["تخرُّ لك الأقلام في الطرسِ سُجَّداً","لما أنتَ تمليه وما أنتَ كاتبُ",49,"ب",1,0],["تخرّمَهُ الدهرُ المُخاتِلُ صائداً","فخلّف حتى الرِّيَّ في الماءِ صاديا",50,"ي",2,0],["تخرجت عني في القوافي مساجلا","فمني لها شطر ومنك لها شطر",51,"ر",1,0],["تخِرُّ له الأقلامُ وهيَ نَواكِسٌ","فيُكسبُها فخراً على أنفَذِ النَبْلِ",52,"ل",1,0],["تُخْرِجُ السَّاكنين منه ورَبُّ","البيتِ في بَيْتِه أَحقُّ بسُكْنَى",53,"ن",2,0],["تَخِرُّ لديه رهْبَةً مِنْهُ سجَّدا","ملُوك البَرايَا من فَصِيحٍ وأَعجم",54,"م",1,0],["تَخِرُّ له الأَملاَكُ ذُلاًّ وإِنَّما","تَعِزُّ إِذا خرَّت لَديه مِن الذُّلِّ",55,"ل",1,0],["تَخِرُّ الجِبَالُ الشُمُّ خوفَ خُيولِه","وتندكُّ رُعْباً قَبْلَ وَقْعِ الحَوافِر",56,"ر",1,0],["تَخَرَّمَ كِسرى كاسِراً حَدَّ بِطشِهِ","وَقَيصَرَ أَردى ما وَقَتهُ مَقاصِرُه",57,"ر",2,0],["تَخَرَّمَها لا يَرهَبُ البَأسُ مِن حِمى","وَزيرَ وَفَت أَسيافِهِ وَعَوامِلُهُ",58,"ل",2,0],["تخر الجبال الراسيات عليكم","ولا تنقضي هذي الخلافة والملك",59,"ك",1,0],["تخرُّ الظُّبا فيها سجوداً وإِنما","سجودُ الظُّبا في هامِهمْ وركوعها",60,"ع",3,0],["تَخَرَّفْتَ رقاعاتٍ","فما تصلحُ للرَّقْع",61,"ع",1,0],["تَخرج مِن دِيارهم سَليما","وَرُبَّما صرت لَهُم نَديما",62,"م",2,0],["تخر لذكراه الملائك سُجَّدا","كما لاسْمِه في الأرض تَعنُو القبائل",63,"ل",1,0],["تخرب الدار وهي دار بقاء","وهو يبنى عما قليل خرابه",64,"ب",2,0],["تخرصٌ وأراجيفٌ ملفقةٌ","وقول زور عرفنا كيف ندفعه",65,"ع",2,0],["تُخرّم ريب الحادثات حُماتها","وللناس من أيامها العرْف والنكر ُ",66,"ر",1,0],["تَخِرُّ الوُفودُ لَها سُجَّداً","إِذا ما تَجَلَّت لِأَبصارِها",67,"ر",3,0],["تخرجُ الحبَّ والثمارَ وتزهو","فلي عقيقٍ ولؤلؤٍ وجمانِ",68,"ن",1,0],["تُخرسُ عنكم أَلسُنا","لُدّاً وتُذكي أَلسُنا",69,"ن",2,0],["تخرُّ طوعاً إِذا غارت سلاهبه","على الربوع الأعادي من صَياصِيها",70,"ي",3,0],["تخر له القبائل ساجدات","وترهبه المنية حيث عنَّا",71,"ن",2,1],["تُخُرِّمَ الصالحونَ المُقتَدى بهمُ","وَقامَ منهُم مقامَ المُبتَدا الخَبَرُ",72,"ر",1,0],["تَخَرَّمَتهُ مَفصَلاً مَفصَلاً","خُطوبُ أَحداثٍ مُلِمّاتِ",73,"ت",1,0],["تُخَرِّبُ حيطانَنا بِالنُق","وبِ وَتَقرِضُ أَثوابَنا جاهِدَه",74,"د",2,0],["تخرم داء القلب خافقَ قلبها","فأوسعه يأساً وسقماً وأجهدا",75,"د",2,0],["تخرَّم بردُ الداجيات عظامه","وأَكثَر حرُّ اللافحات احتراقه",76,"ق",2,0],["تَخَرَّمَ في عِزِّهِ كَالذَليلِ","وَأَسلَمَ في جَمعِهِ كَالفَريدِ",77,"د",1,0],["تخرّبُ ما يبقى وتعمر فانياً","فلا ذاك موفورٌ ولا ذاك عابرُ",78,"ر",1,0],["تَخَرَّجتُ مِن كُلِّيَّةِ الدَهرِ جاهِداً","فَيا لَيتَ مَن أَعنيهِ فيها تَخَرَّجا",79,"ج",2,1],["تخر له زهر الدراري كواسفا","وتنزل من اوج العلا وهي خضع",80,"ع",1,0],["تَخَرَّمَ الدَهرُ إِخواني وَغادَرَني","كَما يُغادَرُ ثورُ الطارِدِ الفَئِدُ",81,"د",1,1],["تخرّج منه الفاتحون لارضه","فماجت به بطحاؤه وسباسبه",82,"ب",2,0],["تَخَرَّمَهُ مَوْلىً يُجيرُ وَمَوْئِلاً","فَمَنْ نَرْتَجِي كَهْفاً ومَنْ نَرتَجي حِصْنا",83,"ن",2,0],["تَخِرُّ الجبالُ الشُّمُ عند ندَائِهم","وتقصُرُ عن أَعناقهم والمناكِبِ",84,"ب",1,0],["تخر له النفوس اذا ترائي","وميض سناه كالبرق اللموع",85,"ع",1,0],["تَخرُّ لَهُ المُستَصعَبات كَاِنَّها","تصلي لَهُ خمساً بِهاماتِ مَسجِد",86,"د",1,0],["تَخْرِيبُ مُلْكِيَ فِي التَّقْرِيبِ فيكَ حَلاَ","وَلَذَّ لِي وَانْجَلَى بِنَاظِرِي كَحَلا",87,"ل",2,1],["تَخْرِيبٌ انْتَجَ تَعْمِيراً وَمَا وَجَدَتْ","نَفْسٍي سِوَاهُ سَبِيلاً لاَ أقُولُ خَلا",87,"ل",2,0],["تَخر لَهُ المُلوكِ عَلى النَواصي","وَتَلقى بِاليَمينِ وَبِالشِمالِ",88,"ل",1,0],["تخرُّصاً واحاديثاً ملفقةً","لا شيء في الكون عن لبنان يسلينا",89,"ن",2,0],["تُخرجُهُ من ليلِ وسواسهِ","بطلعةٍ تشرقُ كالشّمسِ",90,"س",1,0],["تخرُّ على الأذقان تبدي سجودها","توحّد أقنوماً تَسامت مناقبُه",91,"ب",2,0],["تخر متى تلوح لها سجوداً","كأنك بعض آيات السجود",92,"د",1,0],["تَخرُجُ مِن زِقاقٍ","لَها إِلى زَقاقِ",93,"ق",1,1],["تخرُّ كنجمٍ بجنبِ الفُراتِ","ونهرُ المجرَّةِ فيكَ ارتقى",94,"ق",2,0],["تخرب لي جوي ويتعكّر هوايا","وبأسبابه كبدي من قهرها تبي تفوح",95,"ح",1,0],["تخر كثكلى فوق قبر فقيدها","وقد نسيت ما في التجلد من أجر",96,"ر",1,0],["تخرج الصبح مع \" الزل\" لها","وقفة في كل متر تسعل",97,"ل",1,0],["تخرس الألسن انعقادا عليها","وتحول الوجوه رسما محيلا",98,"ل",2,0],["تخرب في هواه دار جسمي","ولكن بيت قلبي في معمور",99,"ر",1,0],["تخر له ملوك الأرض طوعاً","وتخضع دون عزته الرقاب",100,"ب",1,0],["تخرُّ له غرُّ الجباهِ من العدى","ويا كمْ سنامٍ من معاليهمِ جبّا",101,"ب",2,0],["تخرّ جوارحي شوقا وليست","على شيء إذا حُرمت حماكا",102,"ك",2,0],["تخرُّ كلُّ ملوكِ الشِّعْر ساجدةً","لي في الرِّواقِ إذاما فُحْتُ منتشِدا",103,"د",2,0],["تخرق القانونَ ليست ترعوي","أن تجرَّ الكون حتى يُصلبا",104,"ب",2,0],["تخرصات بها فاهت معطلةٌ","وجه الحقيقة منها ذائبٌ خجلا",105,"ل",2,0],["تخرُّ غداة الروع في الطرس سجداً","لبيض كبيض الهند في الهام ركعا",106,"ع",2,0],["تخَرَجَتْ اَقبَحَ المخارجِ مِنْهٌ","لِحْيَة ٌ قُوبِلَتْ بغيرِ الجَميلِ",107,"ل",1,1]]}