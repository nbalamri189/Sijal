,150,"م",1,0],["تَذَكَّرتُ أَينَ الجابِرونَ قَناتَنا","فَقُلتُ بَني عَمّي أَبانَ اِبنِ دارِمِ",151,"م",1,1],["تَذَكَّرَ أَينَ الجابِرونَ قَناتَهُ","فَقالَ بَنو عَمّي أَبانُ اِبنُ دارِمِ",152,"م",1,0],["تَذَبذَبُ في المِخلاةِ تَحتَ بُطونِها","مُحَذَّفَةَ الرَذنابِ جُلحَ المَقادِمِ",153,"م",1,0],["تَذَكَّرَ أيامَه الخالِيه","فما رَقَأت عَبرةٌ جَاريه",154,"ي",2,1],["تذكَّرتُ إذ أنتَ سِترٌ لَنا","وإذ نحنُ حِصنُك والمعقَلُ",155,"ل",1,0],["تُذَكِّرُني العَفافَ وليس هذا","أوانَ العَفوِ عنك ولا العَفافِ",156,"ف",1,0],["تذكَّرَ نَجداً فحنَّ ادِّكارا","وأرَّقَه البرقُ لَمَّا استطارَا",157,"ر",2,1],["تُذالُ مصوناتُ الدموعِ إزاءَها","وتَمشي حُفاةً حولَها الرَّجْلُ والرَّكْبُ",158,"ب",1,0],["تذكَّرتُ إذا سَهْمُ الهَوى غيرُ طائشٍ","وإذ أسهُمُ الأيامِ طائشةُ المَهوى",159,"ا",1,0],["تَذُمُّ دُنياكَ ذَمّا ما تَبوحُ بِهِ","إِلّا وَأَنتَ لَها في ذاكَ مُعتَنِقُ",160,"ق",1,0],["تُذِلُّ هَذا لِهَذا بَعدَ عِزَّتِهِ","وَقَد تَرى ذا لِهَذا مَرَّةً خَوَلا",161,"ل",2,0],["تَذَكَّر وَلا تَنسَ المَعادَ وَلا تَكُن","كَأَنَّكَ مُخلاً لِلمَلاعِبِ مُمرَجُ",162,"ج",1,0],["تَذَكَّر أَمينَ اللَهِ حَقّي وَحُرمَتي","وَما كُنتَ تولِيني لَعَلَّكَ تَذكُرُ",163,"ر",1,0],["تَذَكَّر أَمِرَ المُؤمِنينَ قَرابَتي","فَدَيتُكَ مِن ذي قُربَةٍ مُتَذَكِّرِ",164,"ر",1,0],["تَذَكَّرَت آكامَ دَربَنداتِها","وَعافَتِ الأَجامَ وَالمَراحِلا",165,"ل",2,0],["تُذكى لَدى مَلِكٍ يُرَجّى جودُهُ","وَتَخافُ مِن سَطَواتِهِ أُسدُ الشَرى",166,"ر",2,0],["تَذكارُها أَحدَثَ في الحَلقِ شَجاً","وَفي الحَشا قَرحاً وَفي القَلبِ شَجَن",167,"ن",1,0],["تذكار والدك المحبّ وديعةً","فإذا ذكرت فهذه أمنيتي",168,"ي",1,0],["تذرف العينُ منه جريةَ ماءٍ","تطأُ الخدّ وهي جمرةُ كيِّ",169,"ي",1,0],["تذيقُ خفيّ السمّ من وَخْزِ إبرةٍ","إذا لَسَبَتْ ماذا يلاقي لسيبها",170,"ب",3,0],["تَذَكَّر وَفَكِّر في الَّذي أَنتَ صائِرٌ","إِلَيهِ غَداً إِن كُنتَ مِمَّن يُفَكِّرُ",171,"ر",1,0],["تَذَكَّرتُ خُضرَةَ ذاكَ الزَمانِ","لَدَيهِ وَعُمرانُ ذاكَ الفِناءِ",172,"ا",2,0],["تَذَرُ الفَتِيَّ مِنَ الرَجاءِ وَراءَها","وَتَرودُ في كَنَفِ الرَجاءِ القَشعَمِ",173,"م",1,0],["تَذ