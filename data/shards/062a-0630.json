ى يا لَيتَها لَم تَرَنَّمِ",196,"م",1,0],["تُذَكِّرُني وَالحَبس داري وَرُبَّما","يَهِيجُ الحِجازي ذِكرَةُ المُتَهِّمِ",196,"م",1,0],["تَذَكَّرتُ فيها الجَهلَ حَتّى تَبادَرَت","دُموعي وَأَصحابي عَلَيَّ وُقوفُ",197,"ف",1,0],["تَذَكَّرتُ هِنداً فَالفُؤادُ عَميدُ","وَشَطَّت نَواها فَالمَزارُ بَعيدُ",198,"د",1,0],["تَذَكَّرتُها فَاِرفَضَّ دَمعي كَأَنَّهُ","نَثيرُ جُمانٍ بَينَهُنَّ فَريدُ",198,"د",1,0],["تَذَكَّرتُ هِنداً مِن وَراءِ تِهامَةٍ","وَوادي القُرى بَيني وَبَينَكَ مُنصِفُ",199,"ف",1,0],["تَذَكَّرَ لَمّا ضاقَ بِالهَمِّ صَدرُهُ","وَأَدبَرَ عَنهُ كُلُّ مَولىً وَناصِرِ",200,"ر",1,1],["تذوبُ لقُرْبِ الماءِ لولا جَمادُها","وتُحرق فيها الشمس لولا الصفا الصَّلد",201,"د",1,0],["تَذُبُّ بِها يَدُ المَعروفِ عَنّا","وَتَصبِرُ لِلحُقوقِ اللازِماتِ",202,"ت",1,0],["تَذَكَّر أَخي ما قَد مَضى مِن شَبابِهِ","وَنِلهُ عَلى تِلكَ الخِيالَةِ وَالذِكرِ",203,"ر",1,0],["تَذَكَّر أَميرَ اللَهِ وَالعَهدُ يُذكَرُ","مَقامي وَإِنشاديكَ وَالناسُ حُضَّرُ",204,"ر",1,1],["تُذيقُ الهَجرَ مَن لَيسَت","لَهُ بِالهَجرِ مِن طاقَه",205,"ق",2,0],["تُذَكِّرُني حَيّاً حِلالاً بِقَفرَةٍ","وَآخِيَّةٍ شُدَّت بِفِهرٍ وَجَندَلِ",206,"ل",1,0],["تَذَرُ المَطِيَّ وَرائَها فَكَأَنَّها","صَفٌّ تَقَدَّمَهُنَّ وَهيَ إِمامُ",207,"م",1,0],["تَذَكَّرتُ يَوماً بِالجُرَيدِ وَلَيلَةً","بِذاتِ الغَضا طابَت وَأُخرى عَلى العِدِّ",208,"د",1,0],["تَذَكَّرَت عيشَةً بِذي سَلَمٍ","عِشنا بِها نَجتَني وَنَحتَلِبُ",209,"ب",1,0],["تَذَكَّرُ مَن أَحبَبتَ إِذ أَنتَ يافِعٌ","غُلامٌ فَمَغناهُ إِلَيكَ حَبيبُ",210,"ب",1,0],["تَذَكَّرَ أَنّى يَجعَلُ اللَهُ جُنَّةً","فَيُصبِحَ ذا مالٍ وَيَقتُلَ واتِرَه",211,"ر",2,0],["تَذيعُ السِرَّ مِن حُرٍّ وَعَبدٍ","وَتُعرَبُ عَن كَنائِزَ مُعجَماتِ",212,"ت",1,0],["تُذالُ كَراسِيَّ المُلوكِ وَطالَما","غَدَت وَهِيَ تُحمى بِالعَوالي مُروجُها",213,"ج",3,0],["تُذادُ عَنِ الحَوضِ الغَرائِبُ ضِنَّةً","وَحَوضُ الرَدى ما دونَهُ كَفُّ ذائِدِ",214,"د",1,0],["تُذَكِّرُنا الأَيّامُ أَمراً فَنَنطَوي","عَلَيهِ زَماناً ثُمَّ لا بُدَّ أَن تُنسي",215,"س",2,0],["تَذَرُّ الحازِمَ الحَصيفَ مِنَ القَو","مِ غَويّاً كَأَنَّهُ حِلفُ أَلسِ",216,"س",1,0],["تَذوبُ حِذارَهُ زُرقُ الأَعادي","وَيَسخى بِالحَياةِ حَليفُ ضَنِّ",217,"ن",1,0],["تُذَكِّرُني راحَةَ أَهلِ البِلى","أَرواحُ لَيلٍ بِخُزامى هَبَبنَ",218,"ن",1,0],["تُذَكّرُكِ الثَّوِيَةَ مِنْ ثُدَيٍّ","ضَلالٌ ما أرَدْتِ به ضَلالا",219,"ل",2,0],["تَذُودُ عُلاكَ شُرّادَ المَعاني","إليّ فمَنْ زُهَيرٌ أو زِيادُ",220,"د",1,0],["تَذكّرْنَ من ماءِ العواصِمِ شَرْبَةً","وزُرْقُ العَوالي دونَ زُرْقِ جِمامهِ",221,"م",2,0],["تَذكُرونَ إِذ نُقاتِلُكُم","لا يَضُرُّ مُعدِماً عَدَمُه",222,"م",2,0],["تَذَكَّرَ عَيناً مِن غُمازَةَ ماؤُها","لَهُ حَبَبٌ تَستَنُّ فيهِ الزَخارِفُ",223,"ف",1,0],["تَذَكَّرتُ أَهلي الصالِحينَ بِمَلحوبِ","فَقَلبي عَلَيهِم هالِكٌ جِدَّ مَغلوبِ",224,"ب",1,1],["تَذَكَّرتُ أَهلَ الخَيرِ وَالباعِ وَالنَدى","وَأَهلَ عِتاقِ الجُردِ وَالبِرِّ وَالطيبِ",224,"ب",1,0],["تَذَكَّرتُهُم ما إِن تَجِفُّ مَدامِعي","كَأَن جَدوَلٌ يَسقي مَزارِعَ مَخروبِ",224,"ب",1,0],["تَذَكَّرَ شَيئاً قَد مَضى لِسَبِيِلِهِ","وَمِن حاجَةِ المَحزُونِ أَن يَتَذَكَّرا",225,"ر",2,0],["تَذَكَّرتُ والذِّكرى تَهِيجُ لِذي الهَوى","وَمِن حاجَةِ المَحزونِ أَن يَتَذَكَّرا",226,"ر",2,0],["تَذَكَّرتُ وَالذّكرَى تُهيِّجُ للفَتَى","وَمِن حَاجَةِ المَحزُونِ أَن يَتَذَكَّرا",227,"ر",2,1],["تذكّرتُ ذِكرىً مِن أُميمةَ بَعدَما","لَقِيتُ عَناءً مِن أُمَيمَةَ عانِيا",228,"ي",2,0],["تذكرت لَيلى وأَيامها","وآمال نفسي وأَحلامها",229,"ه",2,1],["تذرع البيد وانيات مهازي","لُ وَهَل يحمد السرى المَهزول",230,"ل",1,0],["تُذيبُ اللحنَ في جفنْي","كِ والأشجانَ في صدري",231,"ي",1,0],["تذكُرُ القُرْبى وتسْتدني بها","مَشرق الآمال في مطلع عامِ",232,"م",1,0],["تذوب حولك إما طرتَ في أفقٍ","غلالةُ الأرجوان الشاحب الساجي",233,"ي",1,0],["تذوِي الأزاهيرُ وتذوي الشفاه","وهو ربيعُ الأنفس الواجِدهْ",234,"ه",1,0],["تَذَكَّرتُ لَيلى فَالفُؤادُ عَميدُ","وَشَطَّت نَواها فَالمَزارُ بَعيدُ",235,"د",1,0],["تَذَكَّرتُ الصِبا وَاِشتَقتُ لَمّا","رَأَيتُ حُمولَها أُصُلاً حُدينا",236,"ن",2,0],["تذكّرت أني هالكٌ وابن هالكٍ","فهانت عليّ الأرض والثّقلان",237,"ن",1,0],["تذكَّرْتُ البِداوَةَ في أُناسٍ","تَخالُ رَبيعَهُمْ سَنَةً جَمادا",238,"د",2,0],["تذَكّرْنَ مُرّاً بالمَناظِرِ آجِناً","عليه من الأرْطَى فُرُوعُ هَدال",239,"ل",1,0],["تَذَكَّرُ إنْ خافَتْ من الموْتِ أفْرُخاً","بِيَهْماءَ لم يُمْكِنْ أصاغرَها اللقْط",240,"ط",1,0],["تذكُرُ كَمْ لَيْلَةٍ لَهَوْنا","في ظِلِّهَا والزَّمَانُ عِيدُ",241,"د",1,0],["تَذَكَّرَ رَوْضاً مِن شَوِىٍّ وباقِرٍ","تَوَلَّتْه أَحْراسٌ مِن الذُّعْرِ تُحْرَسُ",242,"س",1,0],["تُذَكِّرُني لَيلى عَلى بُعدِ دارِها","وَلَيلى قَتولٌ لِلرِجالِ خَلوبُ",243,"ب",1,0],["تَذُودُ عَنِ الْقَلْبِ أَحْزَانَهُ","وَتَنْفِي عَنِ الْعَيْنِ شَوْبَ الْقَذَى",244,"ذ",2,0],["تَذَكَّرْتُ عَهْداً خَالِياً فَبَكَيْتُهُ","وَهَيْهَاتَ طِيبُ العَيشِ بَعْدَ شَبَابِ",245,"ب",1,0],["تَذْهَلُ أُمُّ الْوُلْدِ عَنْ وُلْدِهَا","وَتَسْتَخِفُّ الرِّيْبَةَ المُعْصِرُ",246,"ر",1,0],["تَذْبُلُ فِيه حَتى تمُوتَ وَمَا","تزُولُ لكِنْ يَبْقَى لَهَا أَثَرُ",247,"ر",1,0],["تذكُّرَ قَومٍ أتاني لَهَمُ","أحاديثُ في الزَمَنِ الأَعْوَجِ",248,"ج",1,0],["تَذَكَّرَت نَفسي رياحينَها","فَيا خَليلَيَّ رَيا حينَها",249,"ن",3,1],["تذكّرتُ أيامَ من قد مَضى","فهاجَ لي الدمعَ سحّاً هتونا",250,"ن",2,1],["تَذَكَّر أُلاَّفاً أَلَمُّوا فَودَّعُوا","كطَيْفِ خَيالٍ أَرَّقَ الصَّبَّ زَائِرُه",251,"ر",2,0],["تذوبُ حُشاشاتُ العواصمِ حسرةً","إذا دَمِيَتْ من كفِّ بغداد إصْبع",252,"ع",1,0],["تذكرُ آلاءَ الرسولِ، وما أرى","لَها محصياً نفسي ، فنفسي تبلدُ",253,"د",1,0],["تَذكَّروا أمس واستوُحوا مَساوئهُ","فقدْ تكونُ لَكُمْ في طَيَّه عِبَر",254,"ر",1,0],["تذكَّرْ لعل ادكارَ العُهود","يُراح به نَفَسٌ رازح",255,"ح",1,0],["تُذَرَّى على الضَّيْمِ ذَرْوَ الهشيمِ","ويَعرقُها الذُّلُّ عَرْقَ اللِّحا",256,"ا",1,0],["تُذْهلْ لمغتصَبٍ على مَضض","أمسى يقلَّبُ في يَدَيْ أشِر",257,"ر",1,0],["تذكر محزوناً، وأني له الذكرى","وفاضت بغزو الدمع مقلته العبري",258,"ر",2,1],["تذكرتُ الصبا واشتقتُ لما","رأيتُ حموكها أصلاً حُدينا",259,"ن",2,0],["تذكَّرُ إخواناً مضوا فتتابعوا","وشيبٌ علا منكَ المفارقَ شاملُ",260,"ل",1,0],["تَذَكّرْتُ أيْنَ الجَابِرُونَ قَنَاتَنَا،","فقُلْتُ بَني عَمّي أبَانَ بنِ دارِمِ",261,"م",1,1],["تَذَكّرَ أيْنَ الجَابِرُونَ قَنَاتَهُ،","فَقَال: بَنُو عَمّي أبانُ بنُ دارِمِ",262,"م",1,0],["تُذيقوني حتى إذا ما تَشَوَّقَتْ","مُنايَ بدا لي مُنْكُ ما بدا ليا",263,"ل",3,0],["تذودونهم عن حوضهم بسيوفكم","ويَشْرع فيه أَرتبيلُ وأبلجُ",264,"ج",1,0],["تَذأبُ ريحُ المسكِ فيه، وإنما","بهِ المسكُ وإن مرتْ به ذيلها جملُ",265,"ل",1,0],["تذكرَ منها القلبُ، ما ليسَ ناسياً- ملاحة َ قولٍ، يومَ قالتْ، ومعهدا","فإن كنتَ تهوى أوْ تريدُ لقاءنا- على خلوة ٍ، فاضربْ، لنا منكَ، موعدا",266,"د",2,1],["تَذَكَّرْتُ بَکلشَّرْيِ أَيّامَها","وَأَيَّامَنَا بِكَثيبِ الأَمْرْ",267,"ر",1,0],["تذكرتهم زاد الفؤاد نزاعا","أبيت وما أقوى الهموم بمضجع",268,"ع",1,0],["تذكري نعماتٍ ههنا وهنا","من لحنِ شادية ٍ في الدَّوحِ أَو شادي",269,"د",2,0],["تذكرين ليلى على بعد دارها","رواجف قلب مات وهو حزين",270,"ن",1,0],["تذكَّرتُ إذ سَهْمُ الهَوى غير طائشٍ","وإذ أسهُمُ الأيامِ طائشة ُ المَهوى",271,"ا",1,0]]}