ules.php?name=Sh3er&doWhat=shqas&qid=9670&r=&rc=160",""],[33,"ألاَ يَا حَمَامَاتَ الحِمَى عُدْنَ عَوُدَة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14157&r=&rc=91",""],[61,"رويدَكَ عن تفنيدِ ذي المُقلَة ِ العَبْرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59467&r=&rc=0",""]],"verses":[["تَذَكَّرتُ أَيّاماً بِذي الأَثلِ بَعدَما","تَقَضّى أَواني في الصِبا وَأَوانُها",0,"ن",3,0],["تَذوبُ عَلى مَنازِلِكَ الغَوادي","وَيَركُضُ في حَدائِقِكَ النَسيمُ",1,"م",1,0],["تَذَكَّرتُ بَينَ المَأزِمَينِ إِلى مِنىً","غَزالاً رَمى قَلبي وَراحَ سَليما",2,"م",2,1],["تَذارَعنَ بِالأَيدي مِنَ الغَورِ بَعدَما","تَقَدَّمَ عِرنينٌ مِنَ اللَيلِ مائِلُ",3,"ل",1,1],["تُذَكِّرُني بِسالِفَةِ اللَيالي","وَسالِفَةِ الغَزالَةِ وَالغَزالِ",4,"ل",1,0],["تَذَكَّرتُكُمُ وَالدَم","عُ لا وَبلٌ وَلا طَلُّ",5,"ل",1,0],["تَذَكَّرتُ أَيّامَ القَرينَةِ وَالهَوى","يُجَدِّدُ أَقراناً لَنا وَحِبالا",6,"ل",2,0],["تَذَكَّري رَملَ النَقا وَاِشتاقي","وَبَردَ ماءِ أَلعَسٍ وَساقي",7,"ي",1,0],["تَذَكَّرَ جَوناً بِالبِطاحِ تَلُفُّهُ","بِمُنتَضِدِ الدَوحِ الغَمامُ المُواطِرُ",8,"ر",1,0],["تُذَكِّرُني ما حالَتِ الأَرضُ دونَهُ","أَلا إِنَّما سَوَّلتَ لِلدَمعِ أَن يَجري",9,"ر",2,0],["تُذَلّلُكُم لُقيايَ بِاليَأسِ مِنكُمُ","وَلَم أَتَذَلّل للمِطالِ المُلابِثِ",10,"ث",1,0],["تُذَكِّرُ أَيّاماً مَضَينَ وَلَو فَدَت","بِنانُ يَدي تِلكَ اللَيالي لَفُلَّتِ",11,"ت",1,0],["تُذَكِّرُهُم بِذي قارٍ طِعاناً","وَما جَرَّ القَنا يَومَ الكُلابِ",12,"ب",1,0],["تَذَكَّر عَواقِبَ موبي النَباتُ","وَلا تُتبِعِ العَينَ مَرعىً خَصيبا",13,"ب",2,0],["تَذَكَّرتُها وَاللَّيلُ يُسبِلُ ظِلَّهُ","فَبِتُّ أريقُ الدَّمعَ حَتَّى بَدا الفَجرُ",14,"ر",1,0],["تَذَكَّرتُها وَالرَّكبُ مُغفٍ وَساهِرٌ","وَهاجَ مَطاياهُم حَنيني فَحَنَّتِ",15,"ت",1,0],["تذكّرَ الوصْلَ فارْفَضّتْ مَدامِعُهُ","واعْتادَهُ الشّوقُ فانْقَضّتْ أضالِعُهُ",16,"ع",2,1],["تُذيلُ دُموعَ العَيْنِ وهْيَ مَصونَةٌ","وأُرْخِصُها في الحُبِّ وهْيَ غَوالِ",17,"ل",1,0],["تَذودُ الكَرى عنّا تِلاوَةُ مَدْحِهِ","فَيرْنو إلَيْنا مُصْغِياتٍ وتَصْهَلُ",18,"ل",1,0],["تَذودُ العِدا عنْ دَوْلَةٍ أرْعَدَتْ لَها","فَرائِصُ تَسْتَشْري عليها الهَزاهِزُ",19,"ز",1,0],["تُذْري دُموعَهُمُ الذِّكرى إذا خَطَرَتْ","رُوَيْحَةُ الحَزْنِ تَمري دِرّةَ المُزُنِ",20,"ن",1,0],["تَذَكّرْتُهُ والليلُ رَطْبٌ ذُيولُهُ","فَما افْتَرَّ إلا عَن بَنانِيَ دامِيا",21,"ي",2,0],["تَذَكَّرتُ أَزمانَ كانَ الهَوى","وَكُنتُ لَعَمري كَما تَتَّهِم",22,"م",1,0],["تَذَكَّرتُ هَذا الشَهرَ في عامِنا الخالي","وَكُنّا عَلى حالٍ سِوى هَذِهِ الحالِ",23,"ل",1,1],["تَذَكَّرتُ بِالتُفّاحِ مِنكِ سَوالِفاً","وَبِالراحِ طَعماً مِن مُقَبَّلَكِ العَذبِ",24,"ب",1,0],["تذكّرْتُ عهْداً للشّبابِ الذي ولّى","فَصابَ لهُ تسْكابُ دَمْعيَ وانْهَلاّ",25,"ل",2,1],["تَذْكُو لَدَيَّ مِنْ الْبَيَانِ شَرَارَة","وَتُشَامُ بَارِقَةٌ مِنْ الْعِرْفُانِ",26,"ن",1,0],["تَذَامَرَ أَقْوَامٌ إِلَيْهَا وَضَمَّرُوا","مُخَيَّسَةً تَهْوِي بِأَجْنِحَةِ الْعَزْمِ",27,"م",1,0],["تَذَكَّرْتُ لَيْلاً بِالْحَبِيبِ قَطَعْتُهُ","وَشَمْلِي عَلَى كُلِّ الأَمَانِي اشْتِمَالُهُ",28,"ل",2,0],["تَذَكَّرْتُ عَهْداً كَانَ أَحْلَى مِنَ الْكَرَى","وَأَقْصَرَ مِنْ إِلْمَامِ طَيْفِ خَيَالِهِ",29,"ل",2,0],["تَذَكَّرَتِ الْعَهْدَ الَّذِي اخْتُرِعَتْ بِهِ","وَحَنَّتْ فَمَا تَنْفَكُّ سَاجِعَةً تَبْكِي",30,"ي",1,0],["تذكّرْتُ بيْتاً في العِذارِ لبَعْضِهِمْ","لهُ مثَلٌ بالحُسْنِ في الأرْضِ سائِرُ",31,"ر",1,0],["تذكّرْتُ عهْداً طالَ بعْدَ انْصِرامِهِ","عليْهِ الأسى وانجابَ وهْوَ قصيرُ",32,"ر",1,0],["تذكّرْتُهُ فرْخَ القَطاةِ فأسْرعَتْ","دُموعيَ تهْمي ويْلَها لانْفِرادِهِ",33,"د",2,0],["تذكّرْتُ قُسّاً قائِماً في عُكاظِهِ","وقدْ غَصّ بالشُّمِّ الأنوفِ الجَحاجِحُ",34,"ح",1,0],["تَذُودُ عَنِ الأَحْرَارِ كُلَّ هَضِيمَةٍ","وَكَمْ مِنْ مَعَالٍ قَدْ حَوَيْتَ عَظِيمَة",35,"ه",1,0],["تَذَكَّرُ تَيّا وَأَنّى بِها","وَقَد أَخلَفَت بَعضَ ميعادِها",36,"د",3,0],["تَذَكَّرتَ عَذبَ النيلِ وَالنَفسُ صَبَّةٌ","إِلى نَهلَةٍ مِن كوبِ ماءٍ مُشَعشَعِ",37,"ع",1,0],["تُذكي الدِياراتُ مِنهُ","ناراً كَنارِ المَجوسِ",38,"س",1,0],["تَذَكَّرَ زَينَ العابِدينَ وَجَدَّهُ","وَما كانَ مِن قَولِ الفَرَزدَقِ فيهِما",39,"م",2,0],["تَذَكَّرتُ أَيّامي بِها فَتَبادَرَت","دُموعٌ كَما خانَ الفَريدَ نِظامُ",40,"م",1,0],["تَذَكَّرتُ الصِبا وَاِشتَقتُ لَمّ","رَأَيتُ حُمولَها أُصُلاً حُدينا",41,"ن",2,0],["تَذَكَّرتُ أَهلي الصالِحينَ وَقَد أَتَت","عَلى خَمَلى خوصُ الرِكابِ وَأَوجَرا",42,"ر",2,0],["تَذَكَّرتُ أَيّاماً خَلَت وَلَيالِياً","بِها الأَمنُ فيها العَدلُ كانَت تَكونُها",43,"ن",3,0],["تَذَكَّرتُ أَتراباً لِعَزَّةَ كَالمَها","حُبينَ بِليطٍ ناعِمٍ وَقَبولُ",44,"ل",1,0],["تَذَكَّرتُ مِنهُ بَعدَ أَوَّلِ هَجعَةٍ","مَساعِيَ لا أَدري عَلى مَن أُحيلُها",45,"ل",3,0],["تَذَكَّرُ إِخواناً مَضوا فَتَتابَعوا","وَشَيبٌ عَلى مِنكَ المَفارِقَ شامِلُ",46,"ل",1,0],["تَذَكَّرتَ فَاِنهَلَّت لِعَينِكَ عَبرَةٌ","يَجودُ بِها جارٍ مِنَ الدَمعِ وابِلُ",47,"ل",1,0],["تَذَكَّرتُ أَنَّ النَفسَ لَم تَسلُ عَنكُمُ","وَلَم تَقضِ مِن حُبّي أُمَيَّةَ بالَها",48,"ل",3,0],["تَذَكَّرتُ سُعدَى وَالمُطيُّ كأَنَّهُ","بِآكامِ ذِي رَيطٍ غَطاطٌ قَوارِبُ",49,"ب",1,0],["تَذَكَّرتُ صَخراً إِذ تَغَنَّت حَمامَةٌ","هَتوفٌ عَلى غُصنٍ مِنَ الأَيكِ تَسجَعُ",50,"ع",1,1],["تُذَكِّرُني صَخراً وَقَد حالَ دونَهُ","صَفيحٌ وَأَحجارٌ وَبَيداءُ بَلقَعُ",50,"ع",1,0],["تذكر الطفل الذي كنته","وحاش ذاك الخلق أن يبدلا",51,"ل",2,0],["تَذْكُرُ مَا يَخْطُرُ فِي بَالِهَا","فِي كَلِمٍ مَعْدُودَةٍ حَافِلَهْ",52,"ل",2,0],["تذَكُرُ العُرْبُ وَالأَحْداثُ مُنْسِيَةُ","مَا كَانَ إذْ مَلَكُوا الدُّنْيَا لَهُْمْ خِيمَا",53,"م",2,0],["تُذَكِّرُهُم قَتلى بِبَدرٍ تَنوشُهُم","سِباعٌ وَطَيرٌ مِن سِباعِ بَوارِكِ",54,"ك",1,0],["تَذَكَّرَ سَلمى وَهيَ نَازِحَةٌ فَحَنّ","وهَل تَنفَعُ الذِكرَى إِذَا اغتَرَبَ الوَطَن",55,"ن",1,0],["تَذَكَّرَتِ المنازلَ مِن شَعُوب","وَحيّاً أَصبَحُوا قُطِعُوا شُعُوبا",56,"ب",2,0],["تَذَكُّرَ أَلاّفٍ أَتى الدَهرُ دونَها","وَما الدَهرُ وَالألافُ إِلاّ كَذلِكِ",57,"ك",1,0],["تَذَّكُرَ دَهرٍ كانَ يَطوي نَهارَهُ","رِقاقُ الثَنايا غافِلاتُ الطَلائِعِ",58,"ع",1,0],["تَذَكَّرنَ ماءً عُجمَةُ الرَملِ دونَهُ","فَهُنَّ إِلى نَحوِ الجَنوبِ صَواقِعُ",59,"ع",1,0],["تُذَكِّرُني مَيّاً مِنَ الظَّبي عَينُهُ","مِراراً وَفاها الأُقحوانُ المُنَوِّرُ",60,"ر",1,0],["تَذَكَّرتُ مَيّا بَعدَ ما حالَ دوَنها","سُهوبٌ تَرامى بِالمَراسيلِ