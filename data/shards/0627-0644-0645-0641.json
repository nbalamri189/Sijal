{"poems":[[91,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[47,"طيف ألم فحيا عند مشهده","https://www.aldiwan.net/poem62737.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[47,"طَيفٌ ألَمّ، فحَيّا عندَ مَشهَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32938",""],[203,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[226,"قطع الدهر حبال الأمل","https://www.aldiwan.net/poem55298.html","الرمل"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[358,"يا راحلين بقلبي والنهى أفلا","https://www.aldiwan.net/poem39587.html","البسيط"],[358,"ذكر المعاهد والوقوف على الصفا","https://www.aldiwan.net/poem40038.html","الكامل"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[376,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[422,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216442",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49551","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199808","المسحوب"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124054","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60935","الطويل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102192","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89105","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89426","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[3741,"","https://poetry.dctabudhabi.ae/diwan/poem/121160","المتقارب"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59459","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135767","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45093","المجتث"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135120","الرجز"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116094",""],[4767,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=179611",""],[4869,"المفارق قسمتي","https://www.poetsgate.com/ViewPoem.aspx?id=151619",""],[5829,"من باحة الأموي للزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=150259",""],[5926,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=214037",""],[6127,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=204476",""]],"verses":[["الم فيه لذة وسرور","فيه حزن بالقلب منه ندوب",0,"ب",1,0],["المُفتَدي وَمُلوكُ العُجمِ خاضِعَةٌ","لِفَرعِهِ المُعتَلي فيهِم وَمَحتِدِهِ",1,"د",2,0],["ألم فعم الكفر في عصرنا الورى","ولم يبق بالديان يؤمن إنسان",2,"ن",1,0],["المفتدَى بحده من مظلمهْ","والمهتدي بنوره في المظلمه",3,"ه",1,0],["أَلمفْتَدِي الْوَطَنَ الْعزِيزَ بِرُوحِهِ","هَلْ يَرْتَقِي وَطَنٌ بِغَيْرِ فِدَاءِ",4,"ا",2,0],["المفتدي ملوك العجم خاضعة","لفرعه المعتلي فيهم ومحتده",5,"د",2,0],["المفزعِ الدنيا بسمرِ القنا","والضاربِ الآفاقِ بالباترِ",6,"ر",1,0],["ألم في النفس لا أحمله","وعذابي ليس بالمحتمل",7,"ل",1,0],["أَلَمَّ فَداوى القَلبِ مِن أَلَمِ الجَوى","وَأَسرى فَسَرّى مِن غَرامي وَمِن وَجدي",8,"د",2,0],["المُفرَد الأَوحَدُ الأَسخى يَداً ونَدىً","وَالماجد الأَمجدُ الأَسمى تقىً وَعُلى",9,"ل",2,0],["المُفرد العلم الَّذي في أَرضنا","ما كانَ مَجهولاً لِكَي يتعرَّفا",10,"ف",2,0],["المفحم الفصحاء فصل خطابه","من ذي الروية فيهمُ والمِبده",11,"ه",1,0],["ألمَّ فأذكَرَهُ ما نَسي","خَيالُكَ في غَسقِ الحِندِسِ",12,"س",1,1],["المفسدون بأرض ينزلون بها","والبارزون بقبح الفعل والصور",13,"ر",1,0],["المفيتون في الحروب طعانا","والمقيتون في الجدوب طعاما",14,"م",2,0],["المفضِلون إذا الورى بخلوا","والمقدِمون إذا هُمُ نَكلَوا",15,"ل",3,0],["المفرد العلم ابن المفرد العلم","ابن المفرد العلم ابن المفرد العلمِ",16,"م",1,0],["المفارَق شين تَدْيُوره","وآهَنِيِّ اللّي منهْ سالي",17,"ل",2,0],["ألمفزعون جفونا في الصباح وعى ال","مفزعون جفانا في المسا كرما",18,"م",2,0],["ألمّ فحيَّا بين رُقْبَى وَرَقْبَةٍ","ولا شَيْءَ أحلى من دُنُوٍّ على بُعْد",19,"د",1,0],["ألمَّ فأعْدَاني ضَنَاهُ وَسُهْدُهُ","وقد كان هذا الشوقُ أولى بأن يُعْدِي",19,"د",2,0],["المفدى زاير الثاني","بو خليفه ماجد اعصوره",20,"ر",2,0],["ألمّ فهاج الهمّ عند وداعه","وأوقد نار الشوق بين الجوانح",21,"ح",1,0],["ألمّ فأهدى لي المنام سلامه","ولو لم يَزُرْ مَا بتُ إلاّ مُسَهّدا",22,"د",2,0],["ألم في قلب الهدى","وللقلوب ألما",23,"م",2,0],["المفرد العلَمُ الشهير بوصفه","في غاية الحسنى ووسع الصدر",24,"ر",1,0],["المفرد الشهم الذي شرفت","به المعالي إن بدا آتيا",25,"ي",2,0],["أَلمفسدونَ العائثونَ المُلتَوُو","نَ الآبقونَ العُصبةُ الفُجَّارُ",26,"ر",1,0],["ألم فطار فؤادي شعاعا","وما عدت أدري الذي أصنعه",27,"ع",2,0],["ألمَّ فَلمَّ صدعاً في فؤادي","وأطفأ لَوعتي بَعدَ الوَقُود",28,"د",1,0],["ألَمَّ في القلوبِ والأسرارِ","يوقدُ بالعرفان والأنوارِ",29,"ر",1,0],["المُفتي الهُمامُ المُفَدّى","الفَذّ البَليغُ اللَطيفُ",30,"ف",1,0],["المفرد السميدع الجليل","الوحد الغشمشم النبيل",31,"ل",1,0],["المفرد العلم الأسمى علا شرفا","وفاض بحرا فكم ترجوه وراد",32,"د",1,0],["المفزع أنت لمعضلة","في وقت الشدة والهون",33,"ن",1,0],["المفآرق قسمتي واللي حداني قد حدآهآ","مُهرتي رآآآحت وخلّت من بقآيآهآ رسنهآ",34,"ن",3,0],["المفسدون إذا تضافر شرهم","يتكاثر الجرثوم في الأجواء",35,"ا",2,0],["ألمُّ فيك شتاتي كل ثانية","إذا الزمان قسى نحوي وبعثرني",36,"ن",2,0],["ألَمَّ فراقٌ والرزايا تحفّهُ","على الجسر، والأهلون حُلْمٌ يراجِعُ",37,"ع",1,0]]}