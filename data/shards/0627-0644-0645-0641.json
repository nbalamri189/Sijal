{"poems":[[91,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[47,"طيف ألم فحيا عند مشهده","https://www.aldiwan.net/poem62737.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[47,"طَيفٌ ألَمّ، فحَيّا عندَ مَشهَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32938",""],[203,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[225,"قطع الدهر حبال الأمل","https://www.aldiwan.net/poem55298.html","الرمل"],[239,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[357,"يا راحلين بقلبي والنهى أفلا","https://www.aldiwan.net/poem39587.html","البسيط"],[357,"ذكر المعاهد والوقوف على الصفا","https://www.aldiwan.net/poem40038.html","الكامل"],[373,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[375,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[420,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[467,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[554,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"]],"verses":[["الم فيه لذة وسرور","فيه حزن بالقلب منه ندوب",0,"ب",1,0],["المُفتَدي وَمُلوكُ العُجمِ خاضِعَةٌ","لِفَرعِهِ المُعتَلي فيهِم وَمَحتِدِهِ",1,"د",2,0],["ألم فعم الكفر في عصرنا الورى","ولم يبق بالديان يؤمن إنسان",2,"ن",1,0],["المفتدَى بحده من مظلمهْ","والمهتدي بنوره في المظلمه",3,"ه",1,0],["أَلمفْتَدِي الْوَطَنَ الْعزِيزَ بِرُوحِهِ","هَلْ يَرْتَقِي وَطَنٌ بِغَيْرِ فِدَاءِ",4,"ا",2,0],["المفتدي ملوك العجم خاضعة","لفرعه المعتلي فيهم ومحتده",5,"د",2,0],["المفزعِ الدنيا بسمرِ القنا","والضاربِ الآفاقِ بالباترِ",6,"ر",1,0],["ألم في النفس لا أحمله","وعذابي ليس بالمحتمل",7,"ل",1,0],["أَلَمَّ فَداوى القَلبِ مِن أَلَمِ الجَوى","وَأَسرى فَسَرّى مِن غَرامي وَمِن وَجدي",8,"د",2,0],["المُفرَد الأَوحَدُ الأَسخى يَداً ونَدىً","وَالماجد الأَمجدُ الأَسمى تقىً وَعُلى",9,"ل",2,0],["المُفرد العلم الَّذي في أَرضنا","ما كانَ مَجهولاً لِكَي يتعرَّفا",10,"ف",2,0],["المفحم الفصحاء فصل خطابه","من ذي الروية فيهمُ والمِبده",11,"ه",1,0],["ألمَّ فأذكَرَهُ ما نَسي","خَيالُكَ في غَسقِ الحِندِسِ",12,"س",1,1],["المفسدون بأرض ينزلون بها","والبارزون بقبح الفعل والصور",13,"ر",1,0],["المفيتون في الحروب طعانا","والمقيتون في الجدوب طعاما",14,"م",2,0],["المفضِلون إذا الورى بخلوا","والمقدِمون إذا هُمُ نَكلَوا",15,"ل",3,0],["المفرد العلم ابن المفرد العلم","ابن المفرد العلم ابن المفرد العلمِ",16,"م",1,0]]}