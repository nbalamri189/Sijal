{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[59,"عفوا تعف نساؤكم في المحرم","https://www.aldiwan.net/poem24638.html","الكامل"],[29,"إذا شاع السلام بدار قوم","https://www.aldiwan.net/poem6016.html","الوافر"],[45,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[46,"لم يبق للصيف لا رسم ولا طلل","https://www.aldiwan.net/poem29688.html","البسيط"],[22,"من يزرع الخير يحصد ما يسر به","https://www.aldiwan.net/poem22059.html","البسيط"],[69,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[50,"من يزدري الكبش في الدنيا ويحقره","https://www.aldiwan.net/poem63382.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140862",""],[189,"مجد تقاصر عن سماه الفرقد","https://www.aldiwan.net/poem14509.html","الكامل"],[358,"يا صاح إن جمال المرء ليس سوى","https://www.aldiwan.net/poem40035.html","البسيط"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[563,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53733","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27460","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28027","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204884","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121865","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121830","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/142548","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66137","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[5219,"إلى أرض الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=194989",""],[5561,"شكرا لأنَّكِ .....","https://www.poetsgate.com/ViewPoem.aspx?id=192743",""],[5561,"نوحُ حُرّة","https://www.poetsgate.com/ViewPoem.aspx?id=194931",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5853,"بيادق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188365",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[2220,"كلُّ ما يحويه ميزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11805&r=&rc=675",""]],"verses":[["مَن يَزجُرُ الدَهرَ الغَشو","مَ وَيَكشِفُ الخَطبَ الجَليلا",0,"ل",2,0],["مَن يَزنِ يُزنَ بِهِ وَلَو بِجِدارِهِ","إِن كُنتَ يا هَذا لَبيباً فَاِفهَمِ",1,"م",1,0],["مُنَيزِلَةٌ تَبَرّى اللَهُ مِنها","بِها مِن مازِنٍ نَفَرٌ لِئامُ",2,"م",1,0],["مَن يَزُرهُ يَزُر سُلَيمانَ في المُل","كِ جَلالاً وَيوسُفاً في الجَمالِ",3,"ل",1,0],["مَن يَزعَمُ الصَيفَ لَم تَذهَب بَشاشَتُهُ","فَغَيرُ ذَلِكَ أَمسى يَزعُمُ الجَبَلُ",4,"ل",1,0],["مَن يَزرَعِ الخَيرِ يَحصُد ما يُسَرُّ بِهِ","وَزارِعُ الشَرِّ مَنكوسٌ عَلى الراسِ",5,"س",1,1],["مَنْ يَزُرْهُ مُثقَلاً بالخَطايا","عادَ مَغْفُورَ الخطايا مُثابا",6,"ب",2,0],["مَن يَزدَري الكَبشَ في الدُنيا وَيَحقِرُهُ","فَإِنَّهُ رَأسُ أَهلِ النارِ في النارِ",7,"ر",1,1],["من يزره يزر سليمان في المل","لك جلالاً ويوسفاً في الجمال",8,"ل",1,0],["من يزرعِ المعروفَ زَرْعَك للنَّدى","لا شكَّ مثلَ حصيدِ سَعْدِك يَحْصُد",9,"د",1,0],["مَن يَزرَع العُمر في أَرض الجَهالة لا","يَجني سِوى الهَمّ وَالأَحزان مِن أَسفِه",10,"ه",1,0],["مَنْ يَزْرَعِ الشَّرَّ يَحصُدْ في عواقبِهِ","نَدامَةً ولِحَصدِ الزَّرْعِ إبّانُ",11,"ن",1,0],["من يزرني يزر أشعة نور ال","مصطفى ضمها ضريح نحيت",12,"ت",1,0],["من يزرنا يجد شِوَاء حبارى","وقديداً رخصاً وخمراً عتيدا",13,"د",2,0],["من يزرعِ المنعَ لم يحصدْ سوى عدمٍ","والجودُ يزرعُ والايجادُ لله",14,"ل",2,0],["من يزن أعماله ههنا","ما له في الحشر ميزان",15,"ن",1,0],["من يزد عقله رأى الكون عقلاً","ورأى كل نظرة ايمانا",16,"ن",2,0],["مَن يزْرع العِتابَ يَحْصُدِ الفِراقْ","وغِيرةُ الْحَمْقاءِ مِفْتاحُ الطَّلاقْ",17,"ق",1,0],["مَن يَزْنِ في حُلْمٍ يكُنْ جَزاؤُه","في حُكْمِ أهل الشَّرْعِ يُجْلَد ظِلُّهُ",18,"ه",1,1],["من يزرعِ الضّربَ يحصدْ طاعةً عَجَباً","ومن يربِّ العُلا يأمنْ من الثكَلِ",19,"ل",1,0],["من يَزرَع الشَرَّ يَحصُد في عَواقِبِهِ","شَرّاً فَاِن فَعال الشَر عِصيان",20,"ن",1,0],["من يزرع النخيلَ في فضاءٍ","يموج بالمُعَطَّرِ البليل",21,"ل",1,0],["من يز منك وقارك","حتى صحبت الأداني",22,"ي",1,0],["مَنْ يَزْرَعِ الصَّبْرَ يُحْصُدْ بَعَدَهُ فَرَجاً","ومَنْ يَلَجَّ فَغِبُّ اللَّجِّ حِرْمانُ",23,"ن",1,0],["مَنْ يُزْهَ مُخْتالا عَلَى الناسِ هَوَى","بهِ شَمُوسُ الكِبْرِ مِنْ عالي الرُّبا",24,"ا",1,0],["من يزدرى الناس فيما يزدرون به","كأنه شعرة في رجل منتعل",25,"ل",1,0],["من يزرع الخلق الكريم فقل له","الحب إن طال المدى تجنيه",26,"ي",2,0],["مَنْ يزرع الكرهَ لم يَسلمْ عواقبَه","إنّ المُحبَّ بليلِ الكُرهِ كالقمر",27,"ر",1,0],["من يزرع الظلم يجني الويلَ في نصبٍ","والحقُّ يُنصرُ في يوم بأنصار",28,"ر",1,0],["مَنْ يزرع الحبّ السليم مكللٌ","برضا الرحيم، حصاده الإعمارُ",29,"ر",1,0],["من يزرع الشر حتما سوف يحصده","والحب أولى وفعل الخير أراقاه.",30,"ا",2,0],["من يزرع الحسن قولوا غير من عملوا","لله ما منوا أو مرة ظهروا؟",31,"ر",3,0],["من يزرع الحسن قولوا غير من عرفوا","حقيقة الأمر فاهتموا لينتصروا؟",31,"ر",3,0],["من يزرع الحسن قولوا غيرمن نذروا","أرواحهم فمضوا يعطون ما نذروا؟",31,"ر",3,0],["منْ يزنْ أعمالهُ ها هنا","ما له في الحشر ميزان",32,"ن",1,0]]}