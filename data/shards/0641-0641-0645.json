{"poems":[[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124734","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87368","الخفيف"]],"verses":[["ففمٌ شاربٌ رحيقاً وطَرفٌ","شاربٌ ماءَ لَبّةٍ وسِخابِ",0,"ب",1,0],["ففم وصفت حنثٌ بعد حنثٍ","فكن مما وصفت على يقين",1,"ن",1,0],["فَفمٌ باسِمٌ لنا وَلِسانٌ","هاتِفٌ يُنشِدُ الثنا انشادا",2,"د",2,0]]}