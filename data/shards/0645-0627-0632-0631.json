{"poems":[[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[47,"متعت منك بغير الهجر والغضب","https://www.aldiwan.net/poem11478.html","البسيط"],[48,"خلصت من سبرات في السباريت","https://www.aldiwan.net/poem22206.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[147,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[190,"في عينها زرقة فقلت لهم","https://www.aldiwan.net/poem44080.html","المنسرح"],[435,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[580,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38240","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119871","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126158","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48958","الكامل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142813","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60834","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132597","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97921","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138542",""],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142888","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86364","البسيط"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35043","الكامل"],[4988,"شعيب المعنّى","https://www.poetsgate.com/ViewPoem.aspx?id=182804",""],[4119,"إن كان لا بد من السكر","https://www.poetsgate.com/ViewPoem.aspx?id=16162",""],[5038,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=190197",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5672,"عطر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206437",""],[5703,"صوت السجينة","https://www.poetsgate.com/ViewPoem.aspx?id=206101",""],[5764,"سوء حظي شاعره","https://www.poetsgate.com/ViewPoem.aspx?id=137075",""],[5776,"فَصْلٌ..... لمْ يَقُلْهُ ال...بُكَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199340",""],[6024,"قوس الحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=186344",""]],"verses":[["ما زُرتُ آلَ أَبي خُبَيبٍ وافِداً","يَوماً أُريدُ لِبَيعَتي تَبديلا",0,"ل",2,0],["ما زُرتُ أَهلَكِ أَستَشفي بِرُؤيَتِهِم","إِلّا اِنقَلَبتُ وَقَلبي غَيرُ مُنقَلِبِ",1,"ب",1,0],["ما زُرتُ دارَكَ حَتّى شَفَّني تَعَبي","وَخارَت العيسُ في آثارِ خِرّيتِ",2,"ت",1,0],["ما زرعتم في عقل ناشئة العص","رِ نفاقاً إلا حصدتم خسارا",3,"ر",2,0],["ما زُرتَها إِلّا لِيَأمَنَ خائِفٌ","وَيُغاثَ مَلهوفٌ وَيُثرِيَ مُعدِمُ",4,"م",1,0],["ما زرقةُ العين مثل كحلتها","كم بين فيروزج إلى سبحَه",5,"ه",1,0],["ما زرت بعاولاً أمسيت في بلدٍ","إلا وأصبح خصباً موضع القدمِ",6,"م",1,0],["ما زرّها جبن عليكَ وإنما","حكموا بفضل الحزم للمستلئمِ",7,"م",1,0],["ما زرتَ إلّا خداعاً أيّها السّاري","ثمّ اِنقَضيتَ وما قضّيتُ أوطاري",8,"ر",2,1],["مَا زُرْتَنِي ضَيْفاً وكَم زُرتَني","طَيْفاً فأَهلاً بك مِن زَائِر",9,"ر",1,0],["ما زُرتُها خِفيَةً خَوفاً وَلا فزعاً","عليَّ مِن قَومِها قَتلاً ولا أسْراً",10,"ر",2,1],["ما زرت ربع أبي المظفر مادحا","إلا لأكرم والكريم يزار",11,"ر",1,0],["مازرتهم يوماً لضر مسَّني","إلا وزال الضر عني وانتفى",12,"ف",2,0],["ما زرتهُ إلاّ وجدت بشارةً","لحوائجي من يسرهِ بمخائلِ",13,"ل",1,0],["ما زرتَه وبرحتَ منزلهُ","إلا وأنتَ من الرّضى طَرِبُ",14,"ب",1,0],["ما زرتُ أطلب ما في الثغر من شَبَمِ","إلاّ رجعتُ بما في الطرف من سقَمِ",15,"م",1,0],["مَا زرتُه قطَّ إلاَّ خِلْتُ راحتَه","في منزلي وصلَتْ من قبلَ مَا أصِلِ",16,"ل",1,0],["ما زرت ربعاً شيقاً الا وقد","فرش المزور خدوده للزائر",17,"ر",1,0],["ما زُرته مستعطياً","أترى تذكر فانزعج",18,"ج",1,0],["ما زر جيب علاهم","إلا على غر المناقب",19,"ب",1,0],["ما زرته إلا وجدتُ بشاشةً","في عذب مبتسَمٍ وحسنِ تلطفِ",20,"ف",1,0],["ما زر إلا على جيش مطارفه","وبشره شق زهر الروض مرهوما",21,"م",2,0],["ما زرتَها زادت لِعينك رونقاً","كالمِسكِ ما كرّرته يَتضوّعُ",22,"ع",1,0],["ما زرعت الغياب ولا بغيته يغيب","ليه يجرح حنيني بالغياب ويجنّى",23,"ن",2,0],["ما زرتها إلا وباتت يدي","أولى من الزنار بالخصر",24,"ر",1,0],["ما زُرْتُ يَوماً في رُبوعِكِ حانَةً","لكِنَّني مِنْ عَذْبِ ثَغْرِكِ أَسْكَرُ",25,"ر",1,0],["ما زرعنا غير الشقاق فلسنا","نتوخى غير الشقا من حصيد",26,"د",1,0],["مازرعت البذر قبل احصد ثمار","ولا اواكب صحبت ابليس ونعيمه",27,"م",2,0],["ما زرتهم اﻻ بطيف حاضرِ","لكن طيف خيالهم .... لم يحضرِ",28,"ر",1,0],["مازُرْتُ يَوماً رَوضةً كُنّا بها","إلاّ وَأبكاني بها التذكارُ",29,"ر",1,0],["مآزرع في دآخلي قلبك سرور","صآبره لأني بدونك صآبره",30,"ر",2,0],["مَآزرُ هذا الغَيبِ تَحْتَاجُ قدّهم","وتمزيقَ اشلاءِ الصّموتِ إذا اشتكى!",31,"ك",2,0],["ما زرت ذاك الخدر إلا والردى","يطلبني فكنت عين الطالب",32,"ب",1,0]]}