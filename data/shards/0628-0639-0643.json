{"poems":[[722,"","https://poetry.dctabudhabi.ae/diwan/poem/97792","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76163","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""]],"verses":[["بِعكاظ يعشي الناظِري","نَ إِذا هم لَمحوا شعاعه",0,"ع",2,0],["بِعَكسِ أوسَاخِ بُرُورش العَرَبِ","ذَاكَ يَبِينُ ظاهِراً وَذَا غَبي",1,"ي",1,0],["بِعَكس وَهوَ كُلّ وَجزء جَمعه","بإبدالِ عَين حازَ فيهِ التَناهيا",2,"ي",2,0],["بعكاظ إِن شِئتَ اِدعُها","أَو فاِدعُها نادي الطرب",3,"ب",1,0],["بعكس الريح قد دارتْ رحانا","وياليت الهوى فينا يدورُ",4,"ر",1,0]]}