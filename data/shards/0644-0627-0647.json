{"poems":[[53,"يا روض ذي الأثل من شرقي كاظمة","https://www.aldiwan.net/poem29733.html","البسيط"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[24,"أنى ألم بك الخيال يطيف","https://www.aldiwan.net/poem21870.html","الكامل"],[86,"قد مر عام يا سعاد وعام","https://www.aldiwan.net/poem10672.html","الكامل"],[86,"لاهم إن الغرب أصبح شعلة","https://www.aldiwan.net/poem10678.html","الكامل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[88,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[47,"ولقد أبيت وجل ما أدعو به","https://www.aldiwan.net/poem25237.html","الكامل"],[51,"دخلت على خالد مرة","https://www.aldiwan.net/poem65421.html","المتقارب"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"سلك لآل من بني الأعمام","https://www.aldiwan.net/poem7910.html","الرجز"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[58,"لا هم إن الحارث بن صمه","https://www.aldiwan.net/poem30868.html","الرجز"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[105,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[105,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[105,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[48,"قل للعذول بحانة الخمار","https://www.aldiwan.net/poem63293.html","الكامل"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[46,"يتلون أسفارهم والحق يخبرني","https://www.aldiwan.net/poem23165.html","البسيط"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8241","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"حسن ترقى","https://www.poetsgate.com/ViewPoem.aspx?id=179749",""],[106,"تقليد","https://www.poetsgate.com/ViewPoem.aspx?id=179377",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[32,"وآخر عهدي بها","https://www.poetsgate.com/ViewPoem.aspx?id=114",""]],"verses":[["لا هِجتُ لي قَنَصاً مِن بَعدِ بَينِهِمُ","وَلا ذَعَرتُ عَنِ الأَطلاءِ غِزلانا",0,"ن",2,0],["لا هَمَّ قَلبي بِرُكوبِ العُلى","يَوماً وَلا بَلَّ يَدَيَّ السَماح",1,"ح",1,0],["لا هالِكٌ جَزَعاً عَلى ما فاتَني","وَلِما ألَمَّ مِنَ الخُطوبِ عَروفُ",2,"ف",1,0],["لاهُمَّ أَحيِ ضَميرَهُ لِيَذوقَها","غُصَصاً وَتَنسِفَ نَفسَهُ الآلامُ",3,"م",1,0],["لاهُمَّ إِنَّ الغَربَ أَصبَحَ شُعلَةً","مِن هَولِها أُمُّ الصَواعِقِ تَفرَقُ",4,"ق",1,1],["لاهُمَّ جَدِّد قُوانا","لِخِدمَةِ الأَوطانِ",5,"ن",1,0],["لا هُمَّ، هَبْ لي بياناً أستَعينُ به","على قضاءِ حُقوقٍ نامَ قاضِيها",6,"ي",3,0],["لِأَهلِ الوُدِّ وَالقُربى عَلَيهِ","صَنائِعُ بَثَّها بَرٌّ وَصولُ",7,"ل",1,0],["لأهل الرافدين عليك حزن","له بقلوبهم فضل ارتكاز",8,"ز",1,0],["لا هَؤلاءِ اجتَوَت ولا نَكِرت","ولاَ عَلَى هؤُلاكَ تَنتَحِبُ",9,"ب",1,0],["لاَ هُم مَفَارِيحُ عند نَوبَتِهم","ولا مَجَازِيعُ إِن هُمُ نُكِبُوا",9,"ب",3,0],["لأهلِ العَمَى فِيهِم شِفَاءٌ من العَمَى","مع النُّصحِ لو أنَّ النَّصِيحَةَ تُقبَلُ",10,"ل",1,0],["لا هؤلاء اجتوت ولا ذكرت","ولا على هؤلائك تنتحب",11,"ب",1,0],["لاهَمُّ إِنَّ أَخي لَدَيكَ وَديعَةٌ","مِنّي وَلَيسَ يَضيعُ ماتَستَودِعُ",12,"ع",1,0],["لأهل الجرائم وضع الصدو","ر لا لي والمصرع الأضرع",13,"ع",1,0],["لَأَهجُرِ الناسَ فَأَصنافُ الوَرى","مِنَ السَلاطينِ إِلى المَوالي",14,"ي",1,0],["لاهِياً يَذكُرُ أَيّامَ الصَباء","وَلَياليهِ وَفي الثَغرِ اِبتِسام",15,"م",1,0],["لاهُمَّ عفوا عن عُبي","د مستجير مجرم",16,"م",1,0],["لِأَهلِها فيهم هَوى وَنارُ","وَفي مَهَبِّ الريح تَقوى النارُ",17,"ر",1,0],["لا هَناكَ الشُغلُ الجَديدُ بِحُزوى","عَن رُسومٍ بِرامَتَينِ قِفارِ",18,"ر",1,0],["لا همّ إِنَ الحارِثَ بِنَ صَمَّه","أَهلُ وَفاءٍ صادِقٍ وَذِمّه",19,"م",2,1],["لِأَهلِ نَجدٍ عِندي عُهودُ صِباً","يَحفَظُها القَلبُ كُلَّما بَخِلا",20,"ل",2,0],["لا هَزَّني أَمَلٌ وَقَد حَلَّ الرَدى","بِأَبي مُحَمَّدٍ المَحَلَّ النائي",21,"ا",2,0],["لاهُمَّ جنّبنا المجاهلَ واهْدِنا","هذا السّبيلَ المُعلَمَ الموسوما",22,"م",2,0],["لاَهُمَّ أدرِكْ حُماةَ الحقِّ مُنتصرِاً","إنّ الكنانةَ بالأحداثِ تَزدحِمُ",23,"م",1,0],["لاهُمَّ أدرِكْ شُعوباً بَاتَ يُرمِضُها","عَيْشٌ لها في رُبوعِ الشّرقِ مملولُ",24,"ل",1,0],["لاهُمَّ إن تكُنِ العُقبَى لِمُحتسِبٍ","فَهَبْ لنا الصّبرَ حتّى يُدرَكَ السُّولُ",24,"ل",1,0],["لأهلِ المُفَصَّلِ من آيهِ","مَوَارِدُ يُسقَوْنَ سِلْسَالَها",25,"ل",3,0],["لا هُمَّ غَوْثَكَ إنّ الحقَّ مطلبُنا","وأنت أعلمُ بالقوم الألَى ظلموا",26,"م",3,0],["لا هُمَّ إن تَهلكْ فما لك عابدٌ","يغدو على الغبراء أو يَتروَّحُ",27,"ح",1,0],["لا هُمَّ إِلّا أَن تَكونَ مُضَمِّناً","دَيناً لِصاحِبِ حانَةٍ خَمّارِ",28,"ر",1,0],["لاهِياً عَن كُلِّ ساقٍ","وَأَكيلٍ وَشَريبِ",29,"ب",1,0],["لَأَهجُرَنَّكَ لا عَن بِغضَةٍ سَلَفَت","بَل شيمَةٌ حَمَّها قَدرٌ وَسَوَّلَها",30,"ل",3,0],["لأَهلِيَ حَتّى لامَني كُلُّ ناصِحٍ","وَإِنّي لأَعصي نَهيُهُم حينَ أزجرُ",31,"ر",1,0],["لاهِيَاتٍ مُغرِبَاتٍ ضَحِكاً","آمِناتٍ لَمَحَاتِ الرَّيْبِ طُهْرَا",32,"ر",2,0],["لاهِياً بِالناسِ قتالاً لِمَنْ","شَاءَ فَعَّالاًّ لِمَا اسْتَحْسَنَ جَبْرَا",32,"ر",2,0],["لاهثا في الحديد رنحهُ الظلم","كما رعت حالما فاستفاقا",33,"ق",2,0],["لا هَنى عَينَيَّ نَومُهُما","وَهناكَ الحُزنُ وَالخُلُدُ",34,"د",1,0],["لا هَناني دَرُّ الحَلوبَةِ مِن بَع","دِكَ يَوماً وَلا ضَرامُ المجَزِّ",35,"ز",1,0],["لا هُمّ حكمك في الورى جارٍ وما","من حيلةٍ للعبد في جريانه",36,"ن",2,0],["لا همَّ، هب لي الجهلَ إنْ","الجهلَ خيرٌ لي وأَبقى",37,"ق",2,0],["لا هُمَّ، أَمْدِدْنَا ببعض نَشَاطِه","ومعاذَ ربيِّ أن أكونَ حَسُودا!",38,"د",2,0],["لا هُمَّ، إن حماةَ الأمنِ قد جَحَدوا","مصرًا، ولو أيَّدتْها قوةٌ دانوا",39,"ن",3,0],["لاهُمَّ قد أصبحت أهواؤنا شيعًا","فامنن علينا براعٍ أنت ترضاه",40,"ا",2,0],["لاهُمَّ عفَوكَ ، لا الشجونُ قليلةٌ","عندي ، ولا أنا أخرسٌ تَمتام",41,"م",1,0],["لاهُم ْ ما قَدْرُ البيان إذا انزوى","عنه الضميرُ ، وعَقَّه الإِلهام",41,"م",1,0],["لأهل الهوى ياليل فيك سرائر","عجاب وغدر ان ينمَّ صباح",42,"ح",1,0],["لأهليَ حتى لامني كل ناصح","شفيق له قربى لدينا وأيصر",43,"ر",1,0]]}