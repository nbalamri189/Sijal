د بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5324,"كفى للعنف .","https://www.poetsgate.com/ViewPoem.aspx?id=207662",""],[5327,"وَصَماتُ الغَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=144598",""],[5343,"امسح دموعك،","https://www.poetsgate.com/ViewPoem.aspx?id=132672",""],[5394,"لاه بغانية وَرَاح","https://www.poetsgate.com/ViewPoem.aspx?id=191222",""],[5453,"أم(بك)وت","https://www.poetsgate.com/ViewPoem.aspx?id=28016",""],[5461,"لا هنت","https://www.poetsgate.com/ViewPoem.aspx?id=8541",""],[5537,"قصيدة_حب","https://www.poetsgate.com/ViewPoem.aspx?id=214726",""],[5539,"الطبيعه","https://www.poetsgate.com/ViewPoem.aspx?id=192484",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5629,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=184606",""],[5629,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=184608",""],[5632,"يا سهل....","https://www.poetsgate.com/ViewPoem.aspx?id=177817",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5648,"الزمان الشين","https://www.poetsgate.com/ViewPoem.aspx?id=156245",""],[5652,"الا السهر مع حضرتك شي ثاني ..!","https://www.poetsgate.com/ViewPoem.aspx?id=152989",""],[5652,"لاهو ب رجالٍ ولاهو رجيجيل","https://www.poetsgate.com/ViewPoem.aspx?id=198328",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[5718,"داو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214404",""],[5720,"القَوْز","https://www.poetsgate.com/ViewPoem.aspx?id=200188",""],[5721,"ينابيع البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=214506",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[6019,"حَجٌّ إِلَيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=176029",""],[6032,"عهود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181520",""],[161,"أنشودة للصغار / وصف هررة صغار","https://www.poetsgate.com/ViewPoem.aspx?id=164385",""],[6056,"راسي يافهد شابي","https://www.poetsgate.com/ViewPoem.aspx?id=130323",""],[6056,"ديار الدروزي","https://www.poetsgate.com/ViewPoem.aspx?id=130350",""],[6056,"عيونه الخرسا","https://www.poetsgate.com/ViewPoem.aspx?id=130503",""],[6068,"نصرنا الحق حتى صار فينا -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175884",""],[6093,"إليْكَ يا بَحْرُ طِفْلُ الشَّامِ قَدْ هَرَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=177749",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[6147,"إبحار في متاهات أنفاسها","https://www.poetsgate.com/ViewPoem.aspx?id=151482",""],[5309,"أنا من سكر هواهم ثمل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573771",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""],[6336,"الدوحة الباكية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73554&r=&rc=15",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["لا هِجتُ لي قَنَصاً مِن بَعدِ بَينِهِمُ","وَلا ذَعَرتُ عَنِ الأَطلاءِ غِزلانا",0,"ن",2,0],["لا هَمَّ قَلبي بِرُكوبِ العُلى","يَوماً وَلا بَلَّ يَدَيَّ السَماح",1,"ح",1,0],["لا هالِكٌ جَزَعاً عَلى ما فاتَني","وَلِما ألَمَّ مِنَ الخُطوبِ عَروفُ",2,"ف",1,0],["لاهُمَّ أَحيِ ضَميرَهُ لِيَذوقَها","غُصَصاً وَتَنسِفَ نَفسَهُ الآلامُ",3,"م",1,0],["لاهُمَّ إِنَّ الغَربَ أَصبَحَ شُعلَةً","مِن هَولِها أُمُّ الصَواعِقِ تَفرَقُ",4,"ق",1,1],["لاهُمَّ جَدِّد قُوانا","لِخِدمَةِ الأَوطانِ",5,"ن",1,0],["لا هُمَّ، هَبْ لي بياناً أستَعينُ به","على قضاءِ حُقوقٍ نامَ قاضِيها",6,"ي",3,0],["لِأَهلِ الوُدِّ وَالقُربى عَلَيهِ","صَنائِعُ بَثَّها بَرٌّ وَصولُ",7,"ل",1,0],["لأهل الرافدين عليك حزن","له بقلوبهم فضل ارتكاز",8,"ز",1,0],["لا هَؤلاءِ اجتَوَت ولا نَكِرت","ولاَ عَلَى هؤُلاكَ تَنتَحِبُ",9,"ب",1,0],["لاَ هُم مَفَارِيحُ عند نَوبَتِهم","ولا مَجَازِيعُ إِن هُمُ نُكِبُوا",9,"ب",3,0],["لأهلِ العَمَى فِيهِم شِفَاءٌ من العَمَى","مع النُّصحِ لو أنَّ النَّصِيحَةَ تُقبَلُ",10,"ل",1,0],["لا هؤلاء اجتوت ولا ذكرت","ولا على هؤلائك تنتحب",11,"ب",1,0],["لاهَمُّ إِنَّ أَخي لَدَيكَ وَديعَةٌ","مِنّي وَلَيسَ يَضيعُ ماتَستَودِعُ",12,"ع",1,0],["لأهل الجرائم وضع الصدو","ر لا لي والمصرع الأضرع",13,"ع",1,0],["لَأَهجُرِ الناسَ فَأَصنافُ الوَرى","مِنَ السَلاطينِ إِلى المَوالي",14,"ي",1,0],["لاهِياً يَذكُرُ أَيّامَ الصَباء","وَلَياليهِ وَفي الثَغرِ اِبتِسام",15,"م",1,0],["لاهُمَّ عفوا عن عُبي","د مستجير مجرم",16,"م",1,0],["لِأَهلِها فيهم هَوى وَنارُ","وَفي مَهَبِّ الريح تَقوى النارُ",17,"ر",1,0],["لا هَناكَ الشُغلُ الجَديدُ بِحُزوى","عَن رُسومٍ بِرامَتَينِ قِفارِ",18,"ر",1,0],["لا همّ إِنَ الحارِثَ بِنَ صَمَّه","أَهلُ وَفاءٍ صادِقٍ وَذِمّه",19,"م",2,1],["لِأَهلِ نَجدٍ عِندي عُهودُ صِباً","يَحفَظُها القَلبُ كُلَّما بَخِلا",20,"ل",2,0],["لا هَزَّني أَمَلٌ وَقَد حَلَّ الرَدى","بِأَبي مُحَمَّدٍ المَحَلَّ النائي",21,"ا",2,0],["لاهُمَّ جنّبنا المجاهلَ واهْدِنا","هذا السّبيلَ المُعلَمَ الموسوما",22,"م",2,0],["لاَهُمَّ أدرِكْ حُماةَ الحقِّ مُنتصرِاً","إنّ الكنانةَ بالأحداثِ تَزدحِمُ",23,"م",1,0],["لاهُمَّ أدرِكْ شُعوباً بَاتَ يُرمِضُها","عَيْشٌ لها في رُبوعِ الشّرقِ مملولُ",24,"ل",1,0],["لاهُمَّ إن تكُنِ العُقبَى لِمُحتسِبٍ","فَهَبْ لنا الصّبرَ حتّى يُدرَكَ السُّولُ",24,"ل",1,0],["لأهلِ المُفَصَّلِ من آيهِ","مَوَارِدُ يُسقَوْنَ سِلْسَالَها",25,"ل",3,0],["لا هُمَّ غَوْثَكَ إنّ الحقَّ مطلبُنا","وأنت أعلمُ بالقوم الألَى ظلموا",26,"م",3,0],["لا هُمَّ إن تَهلكْ فما لك عابدٌ","يغدو على الغبراء أو يَتروَّحُ",27,"ح",1,0],["لا هُمَّ إِلّا أَن تَكونَ مُضَمِّناً","دَيناً لِصاحِبِ حانَةٍ خَمّارِ",28,"ر",1,0],["لاهِياً عَن كُلِّ ساقٍ","وَأَكيلٍ وَشَريبِ",29,"ب",1,0],["لَأَهجُرَنَّكَ لا عَن بِغضَةٍ سَلَفَت","بَل شيمَةٌ حَمَّها قَدرٌ وَسَوَّلَها",30,"ل",3,0],["لا هم قد أصبحت أهواؤنا شيعاً","فامنن علينا براع أنت ترضاه",31,"ا",2,0],["لأَهلِيَ حَتّى لامَني كُلُّ ناصِحٍ","وَإِنّي لأَعصي نَهيُهُم حينَ أزجرُ",32,"ر",1,0],["لاهِيَاتٍ مُغرِبَاتٍ ضَحِكاً","آمِناتٍ لَمَحَاتِ الرَّيْبِ طُهْرَا",33,"ر",2,0],["لاهِياً بِالناسِ قتالاً لِمَنْ","شَاءَ فَعَّالاًّ لِمَا اسْتَحْسَنَ جَبْرَا",33,"ر",2,0],["لاهثا في الحديد رنحهُ الظلم","كما رعت حالما فاستفاقا",34,"ق",2,0],["لا هَنى عَينَيَّ نَومُهُما","وَهناكَ الحُزنُ وَالخُلُدُ",35,"د",1,0],["لا هَناني دَرُّ الحَلوبَةِ مِن بَع","دِكَ يَوماً وَلا ضَرامُ المجَزِّ",36,"ز",1,0],["لا هُمّ حكمك في الورى جارٍ وما","من حيلةٍ للعبد في جريانه",37,"ن",2,0],["لا همَّ، هب لي الجهلَ إنْ","الجهلَ خيرٌ لي وأَبقى",38,"ق",2,0],["لا هُمَّ، أَمْدِدْنَا ببعض نَشَاطِه","ومعاذَ ربيِّ أن أكونَ حَسُودا!",39,"د",2,0],["لا هُمَّ، إن حماةَ الأمنِ قد جَحَدوا","مصرًا، ولو أيَّدتْها قوةٌ دانوا",40,"ن",3,0],["لاهُمَّ عفَوكَ ، لا الشجونُ قليلةٌ","عندي ، ولا أنا أخرسٌ تَمتام",41,"م",1,0],["لاهُم ْ ما قَدْرُ البيان إذا انزوى","عنه الضميرُ ، وعَقَّه الإِلهام",41,"م",1,0],["لأهل الهوى ياليل فيك سرائر","عجاب وغدر ان ينمَّ صباح",42,"ح",1,0],["لأهليَ حتى لامني كل ناصح","شفيق له قربى لدينا وأيصر",43,"ر",1,0],["لاهل الهدى في ساحة البر برزخ","علا ولنا في وهدة اللهو برزخ",44,"خ",1,0],["لأهل الجهل إحسان ووصل","وللفضلاء فقرٌ وانفصام",45,"م",1,0],["لأهلي وأولادي وحزب أقاربي","محبة قلب مازجت لب أعظمي",46,"ي",1,1],["لاه اِبنُ عَمِّكَ أَفضَلتَ في حَسَبٍ","عَنّى وَلا أَنتَ دَيّاني فَتَخزوني",47,"ن",2,0],["لأهلِ الهَوى في الدَّمع والسُّهدِ لَذَّةٌ","إذا اختُبرَت لم تُبقِ حِسّاً ولا عَقلا",48,"ل",2,1],["لِأَهلِ التُقى وَالبِرِّ يُذخَرُ قُربُهُ","وَأَنّي لِمِثلي أَن يَكونَ لَهُ أَهلا",49,"ل",2,0],["لِأَهلِ الهَوى فيهِ مَجازُ طَريقَةٍ","نَسَخناهُ مِن تَصميمِنا بِحَقيقَةٍ",50,"ه",1,0],["لاهم فدوني ولا في الموت شاركني","منهم صديق ولا في حفرتي دخلا",51,"ل",2,0],["لاهِ ابنُ عمِّك لا أنساكَ من رجُلٍ","حتى يجئ من القبرِ ابنُ ميّادِ",52,"د",1,0],["لأَهُزَّ منكَ بها كريماً أروعا","هزَّ المدَجَّجِ في الوغى للأسمر",53,"ر",1,0],["لأهجُرَ أرضي واصلاً دَرَجَ الس