{"poems":[[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[63,"هلم فقد بردت راحنا","https://www.aldiwan.net/poem51414.html","المتقارب"],[63,"كيف خلاصي من العراق وقد","https://www.aldiwan.net/poem51448.html","المنسرح"],[63,"ألبرق سرى بأعلى البراق","https://www.aldiwan.net/poem51520.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[463,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82804","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203784","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64892","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48214","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34714","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100883","الوافر"],[3215,"","https://poetry.dctabudhabi.ae/diwan/poem/147369","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129342","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129365","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115328","البسيط"],[4680,"يا شام يا درّة التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=185022",""],[4690,"عمّي الفَلاّح / أدب الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=120388",""],[4883,"الفلوجة دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=48356",""],[3271,"فقراء","https://www.poetsgate.com/ViewPoem.aspx?id=128734",""],[5136,"بشرى فقد أشرق وجه الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=121760",""],[5277,"دعاءٌ بنيةِ الاستجابة..","https://www.poetsgate.com/ViewPoem.aspx?id=195174",""],[5362,"طرف ما استهل مهنده","https://www.poetsgate.com/ViewPoem.aspx?id=170383",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5431,"وهو القريب إليك حتى تُبصره!","https://www.poetsgate.com/ViewPoem.aspx?id=196901",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5751,"المختلف","https://www.poetsgate.com/ViewPoem.aspx?id=214782",""],[5758,"اعتذار لأبي العلاء المعرّي","https://www.poetsgate.com/ViewPoem.aspx?id=200503",""],[5776,"البُردةُ اليمانيةُ الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=199545",""],[5861,"هسيس الروح","https://www.poetsgate.com/ViewPoem.aspx?id=215789",""],[5952,"تضوع عطراً","https://www.poetsgate.com/ViewPoem.aspx?id=202703",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["تَخْضَلُّ منهنُّ عينٌ فهي باكيةٌ","ويستحِرُّ فؤاد وهو هيمان",0,"ن",1,0],["تُخَضَّبُ بالكأسِ أَيمانُنا","وتُصبَغُ بالدَّمِ أرماحُنا",1,"ن",2,0],["تَخْضِبُ بالرَّاحِ شَيبَه عَبَثاً","أناملٌ مثلُ حُمرَةِ العَنَمِ",2,"م",1,0],["تَخْضِبُ الكَفَّ بالمُدامِ وطَوْراً","تَخْضِبُ الكّفَّ من دَمٍ مُهْراقِ",3,"ق",1,0],["تخضبُ كفَّاه النضيرَ الوريف","ورْساً وتُدمِي الزنبقَ الأبيضا",4,"ض",2,0],["تَخضرّ أكنافهم للّائذينَ إِذا","اِغبرّت مَسالكهم وَاِحمرّ أفقهمُ",5,"م",1,0],["تَخضَعُ طوراً وَتَطفو كُلَّما طَحَرَت","مِثلَ اليَعاسيبِ في آذانِها غَضَفُ",6,"ف",1,0],["تخضَعُ منها لصورةٍ فُطِرتْ","ويَخضَعُ المخبِتونَ للفاطرْ",7,"ر",1,0],["تَخُضْ في جَميمٍ يَعمُّ السنامَ","وينصُفُهُ العُنقُ المسفِرُ",8,"ر",1,0],["تَخضر نامية مِن حَولِها وَمِن","إِذا تَتابع وَبل وَهِيَ صَفراء",9,"ا",2,0],["تخضب السيف ، تُشبع الطير تُعلي","راية من دم الطواغيت حَمْرا",10,"ر",2,0],["تَخْضعُ أَعْناقُها لهُ جَزَعاً","يَطْرُدُ فُرْسانَها عن العَنَقِ",11,"ق",1,0],["تَخضِمُ إما شِيحةً أو إلى","بَشامةٍ تدنو فترعاها",12,"ا",3,0],["تَخْضَرُّ من كرمٍ إِذ جابَ الفَلا","فتُخالُ كالجنَّاتِ وهي جُروُزُ",13,"ز",1,0],["تخضر أطراف خز من مطارفها","على الحدوج فتجلو ظلمة الجبن",14,"ن",1,0],["تُخَضِّبُ الإِصبَعَ وَالثَ","وبَ دَماً مِن دامِيات",15,"ت",1,0],["تخضبها دماءً الكأس بكرا","وتُنحلها بنانُ الغيد عِينا",16,"ن",2,0],["تخضب كفّاً بتكْتْ من زندها","فتخضب الحناء من مسودِّها",17,"ه",2,1],["تخضب من حنا الدماء فلم ينم","له ثائر حتى تخضب خاضبه",18,"ب",2,0],["تخضب قتلاها الدماء وان ترد","عبيرا فمن مسك القتام عبيرها",19,"ر",3,0],["تَخَضَّبَت دَماً بِنَقعٍ فائِرِ","مِن دَورِ دولابٍ وَوَقعِ حافِرِ",20,"ر",1,0],["تخضِبُ مرواً دماً نجيعاً","من فَط ما تُنكَبُ الحَوامي",21,"ي",1,1],["تخضلُّ فيها ضفاف الياسمين ندىً","ويستحقُّ الهوى عزّاً وتبجيلا",22,"ل",2,0],["تَخْضَرُّ الأرْضُ على يَدِهِ","رُمَّانًا تُفًّاحًا تينًا",23,"ن",2,0],["تخضّبي دم وصخب والبسيّ خمار","وتراقصي بين الرضا والتباشير",24,"ر",1,0],["تخضلُّ نظرتهُ وتُورقُ نارُهُ","وتميل كرمتُهُ على أكوابهمْ",25,"م",1,0],["تخضبت بالورد وجوها إذا","خضبت صفح السيف بالأرجوان",26,"ن",1,0],["تخضرُّ أدعيتي نشوى فأطعمُها","دمعَ الغيابِ وكفّي للسمواتِ",27,"ت",1,1],["تخضر الارض بأدمعه","ويزيل الطود تنهده",28,"د",2,0],["تخضب من فيض الشهادة وجهه","دما ناب فيه السيف عن كل خاضب",29,"ب",1,0],["تخضرُ من ذكر الإله وشكره","مطرٌ بروحيَ هاطلٌ كي أشكره !",30,"ر",2,0],["تُخَضِبُ أعْنَاقَ الْجِيَادِ دِمَاْئُهُمْ","تُزَيِّنُهَا حَتَّى يُزَفُوا لِعُرْسِكِ",31,"ك",1,0],["تخضرُّ بالأحزانِ دمعتهُ","وتُضاءُ من أوجاعهِ السدفُ",32,"ف",1,0],["تَخْضَرُّ في شَفتي أَسْرارُ أمْنيةٍ","منْ أين يأتي تُراهُ الحُبّ يُخْتطَفُ",33,"ف",1,0],["تخضرّ روحي كما اخضرّ الزمانُ فكمْ","في يومِ ميلادكَ انكفأت خطاياها",34,"ا",3,0],["تخضّبتِ الأنبارُ حنّاؤها دمٌ","وما عُرسُها إلّا بكرٍّ ولا فرِّ",35,"ر",1,0],["تخضوضرُ القِفارُ ..إن مرَّتْ بها","تغدو جِناناً ذاتَ عُشبٍ مُورِقِ",36,"ق",1,0],["تخضرُّ ربيعاً في عينٍ","تدعوكَ وتسميكَ الواهبْ",37,"ب",1,0],["تخضبُ الكفَّ وهي بيضاءُ فيها","وتريكَ الهلاَلَ فوقَ بنانِكْ",38,"ك",1,0]]}