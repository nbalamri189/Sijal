{"poems":[[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"يا من غدا بين تأميل وإشفاق","https://www.aldiwan.net/poem65508.html","البسيط"],[85,"مدينة العلم أم دار مباركة","https://www.aldiwan.net/poem7352.html","البسيط"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[45,"العيش في ليل داريا إذا بردا","https://www.aldiwan.net/poem63497.html","البسيط"],[28,"إما دخلت الدار دارا بإذنها","https://www.aldiwan.net/poem5614.html","الطويل"],[81,"من منصفي من سقيم الطرف ذي حور","https://www.aldiwan.net/poem61520.html","البسيط"],[48,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[46,"حيران أنت فأي الناس تتبع","https://www.aldiwan.net/poem22940.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[119,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4356.html","البسيط"],[132,"إن كان ربي أخفى الشيخ عن زمر","https://www.aldiwan.net/poem54644.html","البسيط"],[133,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4240.html","البسيط"],[143,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[169,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[186,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[280,"مولاي تصبر عن أديبك","https://www.aldiwan.net/poem60571.html","مجزوء الكامل"],[280,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[298,"أمده الدمع حتى غاض جائده","https://www.aldiwan.net/poem36819.html","عموديه"],[364,"لم يدر ناعيك من إلي نعى","https://www.aldiwan.net/poem60847.html","المنسرح"],[366,"لو كان منه باسما لي الصباح","https://www.aldiwan.net/poem16959.html","السريع"],[416,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[575,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"]],"verses":[["إِمَّا دَعَا الدَّاعِي وَثَوَّبَ صَارِخا","ثَابُوا وَأمُّوا حَوْمَةَ التَّثْوِيبِ",0,"ب",1,0],["أَمَّا دُعَاؤُكَ لِي فعلمي أنه","ما أن له إلا العناية موجب",1,"ب",1,0],["أمَّا دمشق فقد هزَّت لمقدمكم","من بعد عطف دليل عطف مختال",2,"ل",1,0],["أما دمشق فقد فازت بما ارْتقبت","من طارفِ السعد أو من تالد الأمل",3,"ل",1,0],["أما درى أن ما عظَّمت قيمتهُ","فهو العظيم وما حَقَّرت محتقر",4,"ر",1,0],["أما درى من جار في حكمه","من ملك أني أرى خلعه",5,"ع",2,0],["أما دبسيَّة الكبرى بحضرتكم","تحدو الكؤوس بماخوري إسحاق",6,"ق",1,0],["أم أدركت أمِرِيكا وهي محسنة","أن المعارف في أهل النهى ذمم",7,"م",1,0],["أما درتِ الأيامُ أنّيَ في حِمَى","وليِّ أميرِ المؤمنين مُمَنَّعُ",8,"ع",1,0],["إِمّا دَنَوتُ مِنَ السُلُوِّ مُرَوِّياً","فيهِ وَبِعتُ مِنَ الشَبابِ نَصيبي",9,"ب",2,0],["أَمّا دِمَشقُ فَقَد أَبدَت مَحاسِنَها","وَقَد وَفى لَكَ مُطريها بِما وَعَدا",10,"د",2,0],["إِمّا دَخَلتُ الدارَ داراً بِإِذنِها","فَدارُ أَبي ثَورٍ عَلَيَّ حَرامُ",11,"م",1,1],["أَما دَرى السَيفُ أَن نيطَت حَمائِلُهُ","مِنهُ عَلى ما اِزدَرى بِالصارِمِ الذِكرِ",12,"ر",1,0],["أَما دونَ مِصرٍ لِلغِنى مُتَطَلَّبٌ","بَلى إِنَّ أَسبابَ الغِنى لَكَثيرُ",13,"ر",1,0],["أَمّا دَعاويكَ فَهِيَ الآنَ مُضحِكَةٌ","وَما لِنَفسِكَ مِن أَطماعِها شِبَعُ",14,"ع",1,0],["أما دمشق فإنها عربية","رفعت لواء السلم والإسلام",15,"م",1,0],["أما دمشق فمقرّ الملك","ومقعد التاج ونظم السلك",16,"ك",1,0],["أما درى لا درى عقبى عداوتكم","كلٌّ بحدِّ حُسامِ الحقِّ محصُودُ",17,"د",1,0],["أما دروا أنه والظلم يمهله","وأخذه يوم يأتى أخذ مقتدر",18,"ر",1,0],["أما دروا أنَّ للاشياخ منتصرا","ما غاب أم حسبوه غير منتصرِ",18,"ر",1,0],["أما درى لا درى عُقبى عداوتهم","كل بحدِّ حسامِ الحقِّ محصُودُ",19,"د",1,0],["أَمّا دِمَشقُ فَقَد أَسلَفتَ نُصرَتَها","في سالِفِ الدَهرِ إِذ أَنصارُها غَيَبُ",20,"ب",1,0],["أَما دَرَوا أَنَّ بَدرَ الدِّينِ لَو رُدِيَت","بِهِ الشَواهِقُ لَم يَعقِل بِها وَعَلُ",21,"ل",1,0],["أمادليلٌ إلى أرض بها كرمٌ","أو عند سكانها للحرّ مرتفق",22,"ق",1,0],["أَمّا دِمَشْقُ فَقَدْ حَوَتْ","قَمَراً تَطَلَّعَ مِنْ جُيُوبِكْ",23,"ك",1,0],["أَمّا دِمَشْقُ فَقَدْ حَوَتْ بِكَ عِزَّةً","كَرُمَتْ بِها عَنْ أَنْ تَكُونَ الأَبْلَقا",24,"ق",2,0],["أما دمشقُ فلا ترجو لنجدتِها","سوى فتاها الذي شاعت محامده",25,"د",2,0],["أما درَى أنّهم إذا وضَعوا","تاجَ مليكٍ فاللاّبسُ اتّضعا",26,"ع",2,0],["أَمّا دُموعي وَجُفوني فَلا","أَعلَمُها إِلّا دَماً مِن جِراح",27,"ح",1,0],["أمْ ادَّكَرَتْ أحبَّتُها بسلع","فهيَّجها بذات الأثلِ عهد",28,"د",1,0],["أَمّا دِيارُ السّاكِنين إِلى","نَجواكِ فهْيَ الدُرَّسُ المُلْدُ",29,"د",1,0],["أَمَّا دُمُوعِي وخَوْفي مَعْ مُراقَبَتي","فمن ذُنُوبي وطُغْياني وعِصْياني",30,"ي",1,0]]}