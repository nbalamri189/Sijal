{"poems":[[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[74,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[74,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[53,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[53,"يا من غدا بين تأميل وإشفاق","https://www.aldiwan.net/poem65508.html","البسيط"],[87,"مدينة العلم أم دار مباركة","https://www.aldiwan.net/poem7352.html","البسيط"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[47,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[47,"العيش في ليل داريا إذا بردا","https://www.aldiwan.net/poem63497.html","البسيط"],[30,"إما دخلت الدار دارا بإذنها","https://www.aldiwan.net/poem5614.html","الطويل"],[83,"من منصفي من سقيم الطرف ذي حور","https://www.aldiwan.net/poem61520.html","البسيط"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"حيران أنت فأي الناس تتبع","https://www.aldiwan.net/poem22940.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[123,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4356.html","البسيط"],[136,"إن كان ربي أخفى الشيخ عن زمر","https://www.aldiwan.net/poem54644.html","البسيط"],[137,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4240.html","البسيط"],[147,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[190,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[285,"مولاي تصبر عن أديبك","https://www.aldiwan.net/poem60571.html","مجزوء الكامل"],[285,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[303,"أمده الدمع حتى غاض جائده","https://www.aldiwan.net/poem36819.html","عموديه"],[369,"لم يدر ناعيك من إلي نعى","https://www.aldiwan.net/poem60847.html","المنسرح"],[371,"لو كان منه باسما لي الصباح","https://www.aldiwan.net/poem16959.html","السريع"],[422,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[580,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122560","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86850","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62506","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62527","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115887","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11915","البسيط"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106718","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89542","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28555","الكامل"],[2375,"","https://poetry.dctabudhabi.ae/diwan/poem/130705","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129910","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130024","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75962","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58372","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/47021","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141897","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216834","الوافر"],[4680,"أرض الأعاجيب","https://www.poetsgate.com/ViewPoem.aspx?id=185013",""],[4840,"هو العلم ضاءت من سناه المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=129155",""],[4852,"دعاء رخا","https://www.poetsgate.com/ViewPoem.aspx?id=215900",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5363,"كحِّل عيونك إن البدر مكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=144466",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5701,"إفريقيا لبني الفرنج فطيرة","https://www.poetsgate.com/ViewPoem.aspx?id=164611",""],[5764,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192428",""],[5939,"يا لها","https://www.poetsgate.com/ViewPoem.aspx?id=195295",""]],"verses":[["إِمَّا دَعَا الدَّاعِي وَثَوَّبَ صَارِخا","ثَابُوا وَأمُّوا حَوْمَةَ التَّثْوِيبِ",0,"ب",1,0],["أَمَّا دُعَاؤُكَ لِي فعلمي أنه","ما أن له إلا العناية موجب",1,"ب",1,0],["أمَّا دمشق فقد هزَّت لمقدمكم","من بعد عطف دليل عطف مختال",2,"ل",1,0],["أما دمشق فقد فازت بما ارْتقبت","من طارفِ السعد أو من تالد الأمل",3,"ل",1,0],["أما درى أن ما عظَّمت قيمتهُ","فهو العظيم وما حَقَّرت محتقر",4,"ر",1,0],["أما درى من جار في حكمه","من ملك أني أرى خلعه",5,"ع",2,0],["أما دبسيَّة الكبرى بحضرتكم","تحدو الكؤوس بماخوري إسحاق",6,"ق",1,0],["أم أدركت أمِرِيكا وهي محسنة","أن المعارف في أهل النهى ذمم",7,"م",1,0],["أما درتِ الأيامُ أنّيَ في حِمَى","وليِّ أميرِ المؤمنين مُمَنَّعُ",8,"ع",1,0],["إِمّا دَنَوتُ مِنَ السُلُوِّ مُرَوِّياً","فيهِ وَبِعتُ مِنَ الشَبابِ نَصيبي",9,"ب",2,0],["أَمّا دِمَشقُ فَقَد أَبدَت مَحاسِنَها","وَقَد وَفى لَكَ مُطريها بِما وَعَدا",10,"د",2,0],["إِمّا دَخَلتُ الدارَ داراً بِإِذنِها","فَدارُ أَبي ثَورٍ عَلَيَّ حَرامُ",11,"م",1,1],["أَما دَرى السَيفُ أَن نيطَت حَمائِلُهُ","مِنهُ عَلى ما اِزدَرى بِالصارِمِ الذِكرِ",12,"ر",1,0],["أَما دونَ مِصرٍ لِلغِنى مُتَطَلَّبٌ","بَلى إِنَّ أَسبابَ الغِنى لَكَثيرُ",13,"ر",1,0],["أَمّا دَعاويكَ فَهِيَ الآنَ مُضحِكَةٌ","وَما لِنَفسِكَ مِن أَطماعِها شِبَعُ",14,"ع",1,0],["أما دمشق فإنها عربية","رفعت لواء السلم والإسلام",15,"م",1,0],["أما دمشق فمقرّ الملك","ومقعد التاج ونظم السلك",16,"ك",1,0],["أما درى لا درى عقبى عداوتكم","كلٌّ بحدِّ حُسامِ الحقِّ محصُودُ",17,"د",1,0],["أما دروا أنه والظلم يمهله","وأخذه يوم يأتى أخذ مقتدر",18,"ر",1,0],["أما دروا أنَّ للاشياخ منتصرا","ما غاب أم حسبوه غير منتصرِ",18,"ر",1,0],["أما درى لا درى عُقبى عداوتهم","كل بحدِّ حسامِ الحقِّ محصُودُ",19,"د",1,0],["أَمّا دِمَشقُ فَقَد أَسلَفتَ نُصرَتَها","في سالِفِ الدَهرِ إِذ أَنصارُها غَيَبُ",20,"ب",1,0],["أَما دَرَوا أَنَّ بَدرَ الدِّينِ لَو رُدِيَت","بِهِ الشَواهِقُ لَم يَعقِل بِها وَعَلُ",21,"ل",1,0],["أمادليلٌ إلى أرض بها كرمٌ","أو عند سكانها للحرّ مرتفق",22,"ق",1,0],["أَمّا دِمَشْقُ فَقَدْ حَوَتْ","قَمَراً تَطَلَّعَ مِنْ جُيُوبِكْ",23,"ك",1,0],["أَمّا دِمَشْقُ فَقَدْ حَوَتْ بِكَ عِزَّةً","كَرُمَتْ بِها عَنْ أَنْ تَكُونَ الأَبْلَقا",24,"ق",2,0],["أما دمشقُ فلا ترجو لنجدتِها","سوى فتاها الذي شاعت محامده",25,"د",2,0],["أما درَى أنّهم إذا وضَعوا","تاجَ مليكٍ فاللاّبسُ اتّضعا",26,"ع",2,0],["أَمّا دُموعي وَجُفوني فَلا","أَعلَمُها إِلّا دَماً مِن جِراح",27,"ح",1,0],["أمْ ادَّكَرَتْ أحبَّتُها بسلع","فهيَّجها بذات الأثلِ عهد",28,"د",1,0],["أَمّا دِيارُ السّاكِنين إِلى","نَجواكِ فهْيَ الدُرَّسُ المُلْدُ",29,"د",1,0],["أَمَّا دُمُوعِي وخَوْفي مَعْ مُراقَبَتي","فمن ذُنُوبي وطُغْياني وعِصْياني",30,"ن",2,0],["أمادِحُها لغواً ويَرجع خاطري","عَلَيَّ بلومٍ أنَّني لم أهاجِها",31,"ج",3,0],["أَما دَرى أَن أَيام الوَرى دول","وَهَكَذا الدَهر إِقبال وَادبار",32,"ر",1,0],["أَما دَرى أَنَّ عكّا لا يُشبِّهُها","بِذاكَ إِلّا سَخيفُ العَقلِ مَخبولُ",33,"ل",1,0],["أَما دَرى أَنّ عَكّا نارُها كَثُرت","وَمَن نَوى أَخذَها بِالنارِ مَشعولُ",33,"ل",1,0],["أَما دَرى أَنَّ خَيرَ الرُّسلِ قاطِبةً","في بابِها وَهوَ مَفتوحٌ وَمَقفولُ",33,"ل",1,0],["أَما دَرى بِأَبي السِّبطَينِ سَيّدنا","في بُرجِهِ سَلَّ سَيفاً وَهوَ مَصقولُ",33,"ل",1,0],["أَما دَرَى أن أُسْدَ الغابِ داخلَها","وَأَنّ عَكّا لِآسادِ الوغى غيلُ",33,"ل",1,0],["أَما دَرَى أَنّ فيها ضَيغَماً بطلاً","ثَبتَ الفُؤادِ وَلَم يُزعِجْه تَهويلُ",33,"ل",1,0],["أما دريتم أنني","حقاً إمامُ التوريهْ",34,"ي",2,0],["أما دُهيمان السبوق إذا","دهم المهمُّ فيكشف الخطبا",35,"ب",2,0],["أمّا دِمشقُ فلا أرضٌ تُقاسُ بهال","ولا يُماثلُها فى طيبها بلدُ",36,"د",1,0],["أَما دِمَشقُ فَجَنّاتٌ مُعَجَّلَةٌ","لِلطالِبينَ بِها الوِلدانُ وَالحورُ",37,"ر",1,0],["أَما دَرَوا أَنَّ هَذا الأَمرَ لَيسَ لَهُ","إِلّا قُريشٌ وَفيها السِرُّ مَقصودُ",38,"د",1,0],["اما درى من جهله المركب","بان سوى الحمى لم يركب",39,"ب",1,0],["أَما دَرَوا وَيلَهُم أَنَّ الأُسودَ لها","إِغضاءُ مُستَصغِرٍ لِلضِدِّ مُحتَقِرِ",40,"ر",1,0],["أَمّا دِمَشقُ فَإِنَّها بِكَ رَوضَةٌ","ما تَحتَوي وَسَحابَةٌ ما تُخلِفُ",41,"ف",1,0],["أما درى انها تذوي على عجل","وعن قريب يرى في باطن الحفر",42,"ر",1,0],["أمّا دمشقُ فما في الأرض مشبِهُها","جنّاتُ عدنٍ بها ما يشتهي البشرُ",43,"ر",1,1],["أما دمشق فقد ألقت أزمتها","على يديك على حسن وتحصينِ",44,"ن",1,1],["أَما دَرَوا أَنَّني لَو شِئتُ أَفضَحُهُم","بِمُفصِحاتٍ وَإِن أَبصَرتَها خُرُسا",45,"س",2,0],["أما دَمعي على وجدي دليلٌ","يسيل على غَزاليَ كالغزالِ",46,"ل",1,0],["أما درى العاذلون عذلهمُ","يُغري بي الحبُّ كلّما كثرُوا",47,"ر",3,0],["أما درى أن الذي","أمّ الردى لا يصرَخُ",48,"خ",1,0],["أما درى الشرق من خلَّفتَ وهو له","صابونُ أحزانه ما الحزن غير درن",49,"ن",1,0],["أما دنا قبلة الإقبال والقبل","أم بان روضٍ مريع مرتع المقل",50,"ل",1,0],["أم ادخر الظلام لنا متاعاً","يضن بلمحه الحلم الكذوب",51,"ب",1,0],["أمْ أدركتها خيول الغاصبين وما","أودى بها رَهَبٌ في طيّه رَهَبُ",52,"ب",1,0],["إما دعا ركب النجابة فانثنى","إليه وجاءت بالكمال المحامل",53,"ل",1,0],["أما (دعاء رخا) .. لو مرةً عشقتْ","روح وقد عشقت .. عينا .. وآذانا",54,"ن",2,0],["أما دجى الخطب وقعا في الرهان ففي","آل المعز جلاء من غواشيه",55,"ي",2,0],["أما دواء سيكفي علةً عضلت","وعنك يبعد هذا الداء يعتضلُ ​",56,"ل",1,0],["أما دعاة المسلمين فهمهم","أن تكثر الأموال والأولاد",57,"د",1,0],["أما دم الأحرار من أبنائها","فلقد جرى عسلا لهم من فوقها",58,"ق",3,0],["‏أما دموعي ماتجي له خسارى","‏بكيت من طيبه ولا ادري وش اهديه",59,"د",3,0],["أما دَرَتْ أنَّ صمتَها","إذا سَرَى، ضاعَ وانتهى؟",60,"ه",2,0]]}