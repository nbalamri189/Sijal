{"poems":[[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[47,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[47,"أَيُّمَا خُلَّةٍ وَوَصْلُ قَدِيمِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31880",""],[164,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[264,"سبق الحكم قبل في تكوينك","https://www.aldiwan.net/poem35822.html","الخفيف"],[382,"يا نسيما نراه يروي الغليلا","https://www.aldiwan.net/poem59174.html","الخفيف"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[532,"كلم هي الأمثال إلا أنها","https://www.aldiwan.net/poem46011.html","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132304","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202510","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69955","الرمل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75691","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76764","الكامل"],[4702,"قماش الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=155162",""],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4791,"مجرد التفكير","https://www.poetsgate.com/ViewPoem.aspx?id=36906",""],[4791,"اهل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=34896",""],[5121,"باسم قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213931",""],[5264,"عذاب","https://www.poetsgate.com/ViewPoem.aspx?id=177738",""],[5335,"من فمك يقطر عسلها","https://www.poetsgate.com/ViewPoem.aspx?id=36042",""],[5526,"تبّ الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=202656",""],[5606,"أنا على عهدالوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=194981",""],[5606,"يالله ياعالم بما تخفي السريره","https://www.poetsgate.com/ViewPoem.aspx?id=196891",""],[5691,"ليوث الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=206859",""],[5694,"انصروا نبيكم","https://www.poetsgate.com/ViewPoem.aspx?id=129912",""],[5739,"جاوبيني","https://www.poetsgate.com/ViewPoem.aspx?id=126426",""],[5739,"ديرة الزلّه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131546",""],[5848,"الله لا يهينك","https://www.poetsgate.com/ViewPoem.aspx?id=53368",""],[6133,"قولة أهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=33826",""]],"verses":[["كُلُّ مَهاةٍ كَأَنَّ مُقلَتَها","تَقولُ إِيّاكُمُ وَإِيّاها",0,"ا",3,0],["كُلُّ مَهزوزَةِ المِقَذَّينِ تُلفى","رَوحَةَ الجَأبِ خَلفَها وَالظَليمِ",1,"م",1,0],["كلُّ مَهْدٍ يَصيرُ مِنْ بَعْد حينٍ","قَصُرَ العُمْرُ أو تَطَاولَ لَحْدَا",2,"د",2,0],["كُلُّ مَهْزُوزَةِ المَقَذّينِ، تَلْغَى","رَوْحةَ الجأبِ خَلفَها، وَالظّليمِ",3,"م",1,0],["كلمهُ في جفنهِ مغمداً","لو سلَّ ما في الجفنِ ما سَلَما",4,"م",2,0],["كلمة الحقّ قد جعلت هي العل","يا بنصٍّ نتلوه في تبيينك",5,"ك",1,0],["كلْمة اللَه جاء يولد منها","هكذا اللَه أورد التنزيلا",6,"ل",2,0],["كلُّ مهاةٍ تضيءُّ طلعتها","وهنا وستُر الظلام مسدول",7,"ل",1,0],["كلُّ مهاةٍ كأَّنما نشرها في","ك بأنفاس فيك معلول",7,"ل",1,0],["كلم هي الأمثال إلا أنها","في الناس قد اضحت بلا أمثالِ",8,"ل",1,1],["كلمة لا إله إلا الله","حصني ومن ذكرها فالله",9,"ه",1,0],["كَلّمهُ الشاهُ بِرِفق القَول","مِن غَير إِكراه وَغير عَولِ",10,"ل",1,0],["كلمةٌ منك لي تعيد شبابي","فأُعيد الهوى ولو بعد دهر",11,"ر",1,0],["كلمةُ اللَهِ المنادي بالامان","فاستنارَ الرسل مِن ذاكَ الجنان",12,"ن",1,0],["كلم هي السحر الحَلال وَإِنَّما","هاروت يمليها عليها فأنظم",13,"م",1,0],["كَلمٌ هو السحر الحلال وما راوا","سحراً حلالاً غير سحر بيان",14,"ن",1,0],["كلٍّ مهرها تغض الطرف وتْدّاري","لكن غطّن على اللي وافقن عوبه",15,"ب",2,0],["كلمةٍ بالحق تكفيه عن بصمة بنان","كان بعض الناس تلحق وراه الأحمرين",16,"ن",1,0],["كلمه غطاها طول الأيام منها","وكلمه دوافعها كبار وخفيات",17,"ت",1,0],["كلمة غلا في مكاتيبك","مفادها ان الهوى غلاب",18,"ب",1,0],["كِلْمَةٌ فِي أوَاخِر السَطْرِ تُغْنِي","وَهْيَ إِنِّي أَحْبَبْتُ فِيك الْكَيَانَا",19,"ن",2,0],["كلمة غالى لو تقوليها","تسعد قلبى وبيها يعيش",20,"ش",1,0],["كلمه وتروي ضماي أيام وشهور","عيديةٍٍ من فمك يقطر عسلها",21,"ل",3,0],["كلمه ولكن ترجمَتها ب سمعه","ماعاد باقي بجعبتك غير الأطلال",22,"ل",1,0],["كلمه بسيطه لو تقولينها طرت","ومن فرحي أ نسى كل هم مضى لي",23,"ل",2,0],["كلمة الشاعر معانيها كثيره","وأدري انها مزح لكنها ثقيله",24,"ل",2,0],["كِلْمَة ٌ ساحرة ٌ تحْمِلُنا","في مُتون الريح فوق السحبِ",25,"ب",1,0],["كلمة البابا على وزن ، بابا بابهيم","من مساوي خاوي الفكر ملتوي اللسان",26,"ن",1,0],["كلمة ٍ وحده وعندك تاجها.","أرسليها فوق حرف ٍ لي يزور.",27,"ر",1,0],["كلمة خطآ عارف ٍ قلبك مواجعها.","يسري بها لسان ليلك يم عدوانك.",28,"ك",1,0],["كلمةٍ منك ما تجرح سنينك","لا تعاهد وتخلف فالعهود",29,"د",1,0],["كلمة تكون في طول نخلاتك","أهلاً مرحب بيك وعوافي",30,"ف",2,0],["كلمة بسيطة فريع وسبيطة","محنة وهيطة وبلسم شافي",30,"ف",2,0]]}