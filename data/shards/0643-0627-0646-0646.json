abi.ae/diwan/poem/85436","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85420","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55069","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54769","المتقارب"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141991","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13457","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43735","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54278","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[106,"قطان","https://www.poetsgate.com/ViewPoem.aspx?id=179571",""],[106,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[77,"قلبي وسمعي في شغل عن الفند","https://www.poetsgate.com/ViewPoem.aspx?id=33815",""],[77,"كأني قرص الشمس عند طلوعها","https://www.poetsgate.com/ViewPoem.aspx?id=34121",""],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[91,"لارفعن للسما احتجاجي","https://www.poetsgate.com/ViewPoem.aspx?id=52995",""],[46,"أقاتِليَ الزّمانُ، قِصاصَ عَمْدٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=20196",""],[64,"التلبية","https://www.poetsgate.com/ViewPoem.aspx?id=3094",""]],"verses":[["كَأَنَّني لَم تَبكِ قَبلي فارِساً","عَينٌ وَلا حَنَّ فَتىً قَبلي وَأَن",0,"ن",1,0],["كَأَنَّني لَم أَدَع في الأَرضِ يَومَ ثَوى","مُوَدِّعاً شَطرَ أَعضائي وَأَوصالي",1,"ي",1,0],["كَأَنَّني يَومَ أَستَعطي نَوالَكُمُ","دانٍ مِنَ الصَخرَةِ الصَمّاءِ يَغتَرِفُ",2,"ف",1,0],["كَأَنَّني يَومَ أَستَدريكَ مِن حَذَرٍ","جاني دَمٍ طاحَ لامَنجى وَلا وَزَرُ",3,"ر",1,0],["كانَ نَثرُ المِسكِ باقي عَهدِهِم","وَعُهودُ الناسِ دِمناً وَذِئارا",4,"ر",2,0],["كَأَنَّني أَبعَثُها","فيهِم ثَنى وَمَوحِدا",5,"د",2,0],["كَأَنَّني رَوعاءُ مَطرودَةٌ","يَزوَرَّ عَنها جانِبُ الوادي",6,"ي",1,0],["كَأَنَّ نِزاراً وَالخُمولُ رِداؤُهُ","غَداةَ بَغى جَهلاً عَلَيَّ وَأَجلَبا",7,"ب",2,1],["كَأَنَّني كُلُّ يَومٍ","قَلبي إِلَيكِ أَصَبُّ",8,"ب",1,0],["كأنّ نُجومَ الأفقِ يَتْبَعْنَ أمْرَهُ","فلَوْ خالَفَتْهُ عادَ ذو الرُّمْحِ أعْزَلا",9,"ل",2,0],["كأنّ نَفِيَّ جِلْدَتِهِ بَقايا","دِلاصٍ فَضّها المَلَوانِ سَرْدِ",10,"د",1,0],["كأنّني في كفّه","عرض الكريم بكفّ وغد",11,"د",1,0],["كَأَنَّني وَالهَوى في الأَرضِ يَطرُدُني","مِن قَومِ موسى الأُلى كانوا يَتيهونا",12,"ن",2,0],["كَأَنَّني يَومَ وَلَّت ما تُكَلِّمُني","أَخو هِيامٍ مُصابُ القَلبِ مَسلولُ",13,"ل",1,0],["كأنّني كوْكَبُ الصّباحِ بدَا","علَى جَبينِ الغَنِيِّ باللّهِ",14,"ه",1,0],["كَأَنَّنِي لِمَبَانِي المُلْكِ أَجْمَعِهَا","عَيْنٌ وَمَوْلاَيَ كَالإِنْسَانِ فِي عَيْنِي",15,"ن",2,0],["كأن نَسيمي والهَجيرُ مطَنِّبٌ","حديثُ وِصالٍ جاءَ في زمَنِ الهَجْرِ",16,"ر",1,0],["كأنّ نَضيرَ الغُصْنِ جيدٌ مُنعَّمٌ","يرفُّ منَ الزّهْرِ الجَنيِّ بهِ عِقْدُ",17,"د",1,0],["كأنَّني كُلَّما رَدَّدتُه بِفَمِي","أَسْتَنْشِقُ الْمِسْكَ أَو اسْتَطْعِمُ الضَّرَبَا",18,"ب",2,0],["كَأَنَّ نَعامَ الدُوُّباضَ عَلَيهِمُ","إِذا ريعَ شَتّى لِلصَريخِ المُنَدِّدِ",19,"د",1,0],["كَأَنَّ نُجومَها رُبِطَت بِصَخرٍ","وَأَمراسٍ تَدورُ وَتَستَريدُ",20,"د",1,0],["كَأَنَّ نَخيلَ الشَطِّ غِبَّ حَريقِهِ","مَآتِمُ سودٌ سَلَّبَت عِندَ مَأتَمِ",21,"م",1,0],["كانَ نَساهُ شِرعَةٌ وَكَأَنَّهُ","إِذا ما تَمَطّى وِجهَةَ الريحِ مَحمَلُ",22,"ل",1,0],["كَأَنَّني عِندَ ذِكري ما أَلَمَّ بِها","قَرمٌ تَرَدَّدَ بَينَ المَوتِ وَالهَرَبِ",23,"ب",1,0],["كَأَنَّنا لَم نَبِت وَالوَصلُ ثالِثُنا","وَالسَعدُ قَد غَضَّ مِن أَجفانِ واشينا",24,"ن",2,0],["كَأَنَّنِي أَنْظُرُ مِنْ حَيْثُمَا","أَرْسَلْتِ تِلْكَ الدُّرَر الغَالِيهْ",25,"ي",2,0],["كَأَنَّنِي بِكِ فِي النَّادِي مُرَفْرِفَةً","حِيَالَنَا وَكَأَنَّ الصَّوْتَ لَمْ يَرِمِ",26,"م",1,0],["كَأَنَّني رُحتُ مِنهُ حينَ نَوَّلَني","بِمُدمَجِ الصَدرِ مِن مَتنَيهِ مَقدودِ",27,"د",1,0],["كَأَنَّني مِن هَوى خَرقاءَ مُطَّرَفٌ","دامي الأَظَلِّ بَعيدُ السَأوِ مَهيومُ",28,"م",1,0],["كَأَنَّنا وَالقِنانَ القودَ تَحمِلُنا","مَوجُ الفُراتِ إِذا اِلتَجَّ الدِياميمُ",28,"م",1,0],["كَأَنَّ نِعاجَ الرَملِ تَحتَ خُدورِها","بِوَهبينَ أَو أَرطى رُماحَ مَقيلُها",29,"ل",3,0],["كَأَنَّني نازِعٌ يَثنيهِ عَن وَطَنٍ","صَرعانِ رائِحَةٍ عَقلٌ وَتَقييدُ",30,"د",1,0],["كأنني سارق مال مُفتَقَد","ما أنا ممَن جرّ جرماً فشَرد",31,"د",1,0],["كأنني في بلادي إذ نزلت بها","نزلت منها ببيت غيرِ مسكون",32,"ن",1,0],["كأنّ نجوم الليل عند ارتجافها","تُصيخ غلى ذاك الأنين المُجَمْجَم",33,"م",1,0],["كأن نجم السها أديب","في أرض بغداد ذو ثواء",34,"ا",2,0],["كَأَنَّ نَقيقَ الحَبِّ في حاوِيائِهِ","نَقيقُ الأَفاعي أَو نَقيقُ العَقارِب",35,"ب",1,1],["كَأَنَّ نَشرَ الخُزامى في مَلاحِفِها","قَد بَلَّ أَجرَعَها طَلٌّ وَتَهميمُ",36,"م",1,0],["كَأَنَّ نِعاجاً مِن هَجائِنِ عازِفٍ","عَلَيها وَآرامَ السُلِيِّ الخَواذِلا",37,"ل",2,0],["كَأَنَّنا لَمّا اِستَتَبَّ العَبرُ","أُسرَةُ موسى يَومَ شُقَّ البَحرُ",38,"ر",1,0],["كَأَنَّ نَدي بنَ جَعفَرَ قادَ مِنهُم","هَدايا لَم يُرِغ عَنها ثَوابا",39,"ب",2,0],["كأنَّني لوجوهِ الغيدِ معتكفٌ","ما بينَ أصداغِ شعرٍ كالمحاريب",40,"ب",1,0],["كأنَّني الشمعُ لما باتَ مشتعلَ ال","فؤاد قال لأحشائي الأسى ذُوبي",40,"ب",2,0],["كأنَّ نغمةَ عافيهِ بمسمعه","أصواتُ معبدَ في الثاني من الهزج",41,"ج",1,0],["كأنَّني محراكُ فرنٍ إذاً","قالوا عجينُ الثلج في الأرضِ طخ",42,"خ",1,0],["كأنني بفتى المنصور ممتطياً","جيادها الغرّ في فرسانه النجد",43,"د",1,0],["كأنَّني أبصرُ بين الفلا","حماهُ يستدعي إلى رفده",44,"د",2,0],["كأنني لم أغنِّي الليل من طربٍ","ليل الحمى بات بدري