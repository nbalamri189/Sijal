{"poems":[[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[70,"أجارتنا حق الجوار عظيم","https://www.aldiwan.net/poem42700.html","الكامل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[46,"تمنيت أني من هضاب يلملم","https://www.aldiwan.net/poem23362.html","الطويل"],[132,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[141,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[141,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[148,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[167,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[268,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[362,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[362,"سلا حادي الأنضاء أين يريد","https://www.aldiwan.net/poem60957.html","الطويل"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[475,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[480,"ونقطة باء في الحقيقة عينه","https://www.aldiwan.net/poem24329.html","عموديه"],[498,"يربي الحكم حقا ثم بطلا","https://www.aldiwan.net/poem37553.html","الوافر"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[556,"وجود حقيقي هو الغيب مطلق","https://www.aldiwan.net/poem34303.html","الطويل"],[584,"سلوي عن هواكم لا يجوز","https://www.aldiwan.net/poem17552.html","الوافر"],[585,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["فَميطي تَميطي بِصُلبِ الفُؤادِ","وَصولِ حِبالٍ وَكَنّادِها",0,"د",3,0],["فمياهي هي انسكاب دموعي","وخريري هو البكا والنواح",1,"ح",1,0],["فَميعادُ دَمعي أَن تَنوحَ حَمامَةٌ","وَميعادُ شَوقي أَن يَهُبَّ نَسيمُ",2,"م",1,0],["فميدي كما شئتِ فوقَ الحقولِ","بحُلْوِ الثِّمارِ وغضِّ الزَّهَرْ",3,"ر",1,0],["فَمي تَحَدَّثَ عَن سِرّي فَما ظَهَرَت","سَرائِرُ القَلبِ إِلّا مِن حَديثِ فَمي",4,"م",2,0],["فَمِئْذَنَةٌ في الجوِّ تُشْرِقَ في الدُّجَى","عليها هُدىً لِلْعَالمينَ وَنُورُ",5,"ر",1,0],["فَمي أَخَذَت مِنهُ اللَيالي وَإِنَّني","لَأَشرَبُ مِنهُ في إِناءٍ مُثَلَّمِ",6,"م",1,0],["فَميلوا عَلَينا كُلّكُم إِنَّ مَيلَكُم","سَواءٌ عَلَينا وَالرِياحُ بِهاطِلِ",7,"ل",1,0],["فَمَيِّز مَديحاً لَن يَزالَ صَريحُهُ","عَلى ذي العُلا ما عاشَ شاعِرُهُ وَقفا",8,"ف",2,0],["فَمَيِّز خاطِراً يَأبى الدَنايا","وَشِعراً ما تَبَذَّلَ مُنذُ صينا",9,"ن",2,0],["فَمي لَدى يَثرِبٍ أَضحى هَوى كُلِّ مُسلِمِ","فَهُم نَحوَها دَبّاً كَما دَبَّتِ النَملُ",10,"ل",1,0],["فَمِيلُوا عَلَيها بِالسِياطِ وَعَرِّفُوا","ذَوي الجَهلِ مِنّا كَيفَ تَحوي الوَسائِقُ",11,"ق",1,0],["فميتَتُكِ الحُسنى على النورِ نعمةٌ","وحولكِ قد جلَّى الصباحُ قتاما",12,"م",2,0],["فمِيلا بأعناقِ المَطيِّ رواسِماً","عسى مَنْزِلٌ بالجِزْعِ أنْ يُتَرَسّما",13,"م",2,0],["فمِيلوا إليها بالمطايا فَدُونَنا","تهائمُ يُطْوَى عَرْضُها ونُجود",14,"د",1,0],["فمياهِ أَو الشَّوْلِ من أَفيائِها","فمسارِحِ الأَغنامِ عند العَرْبَةِ",15,"ه",1,0],["فمُيِّز من أعدائهم أولياؤُهم","إذا انتقموا يوم الجزاءِ وأنعموا",16,"م",3,0],["فميعادُ شوقي أن تلوحَ على الحمى","خيامُهمُ أو أن تَهُبَّ جَنُوبُ",17,"ب",1,0],["فميم وجاء ثم ميم وحاؤه","هي النقطة الكبرى ففكر بحولتي",18,"ت",2,0],["فميمنةٌ وميسرةٌ طواها","طوى ميزانه في كفَّتيه",19,"ي",2,0],["فميتةُ بارحيْ حظُّ الطويلِ","وأمّا اليومَ فالمحْظوظُ وافِرْ",20,"ر",1,0],["فميز وجود الحق من عدم السوى","تكن رجلاً عند الورى بك يوثق",21,"ق",1,0],["فَميِّتُ حُبِّهِ يَرْجُو نُشُوراً","إِذَا لَمْ يَأْتِ مِنْ خَلْقٍ نُشُوزُ",22,"ز",1,0],["فميلها أخرى وكانت مريضة","وقد صابني هم شديد عصبصب",23,"ب",1,0],["فميل يسر العين مني بميله","وميل من عثمان من كان يصحب",24,"ب",1,0]]}