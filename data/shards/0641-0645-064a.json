{"poems":[[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[70,"أجارتنا حق الجوار عظيم","https://www.aldiwan.net/poem42700.html","الكامل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[46,"تمنيت أني من هضاب يلملم","https://www.aldiwan.net/poem23362.html","الطويل"]],"verses":[["فَميطي تَميطي بِصُلبِ الفُؤادِ","وَصولِ حِبالٍ وَكَنّادِها",0,"د",3,0],["فمياهي هي انسكاب دموعي","وخريري هو البكا والنواح",1,"ح",1,0],["فَميعادُ دَمعي أَن تَنوحَ حَمامَةٌ","وَميعادُ شَوقي أَن يَهُبَّ نَسيمُ",2,"م",1,0],["فميدي كما شئتِ فوقَ الحقولِ","بحُلْوِ الثِّمارِ وغضِّ الزَّهَرْ",3,"ر",1,0],["فَمي تَحَدَّثَ عَن سِرّي فَما ظَهَرَت","سَرائِرُ القَلبِ إِلّا مِن حَديثِ فَمي",4,"م",2,0],["فَمِئْذَنَةٌ في الجوِّ تُشْرِقَ في الدُّجَى","عليها هُدىً لِلْعَالمينَ وَنُورُ",5,"ر",1,0],["فَمي أَخَذَت مِنهُ اللَيالي وَإِنَّني","لَأَشرَبُ مِنهُ في إِناءٍ مُثَلَّمِ",6,"م",1,0]]}