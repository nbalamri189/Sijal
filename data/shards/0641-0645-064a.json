كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130719","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122571","الخفيف"],[748,"","https://poetry.dctabudhabi.ae/diwan/poem/131362","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137595",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70745","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64922","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1833,"","https://poetry.dctabudhabi.ae/diwan/poem/111110","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118361","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100452","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27781","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27207","البسيط"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134085","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112317","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118014","الرجز"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124273","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70168","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199065","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133096","الوافر"],[4679,"أيدري الدهر ما فعلت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=142734",""],[4767,"مسحة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=210249",""],[4978,"مع منى سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=177219",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[404,"اعتزالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191816",""],[5616,"زناد","https://www.poetsgate.com/ViewPoem.aspx?id=203483",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""]],"verses":[["فَميطي تَميطي بِصُلبِ الفُؤادِ","وَصولِ حِبالٍ وَكَنّادِها",0,"د",3,0],["فمياهي هي انسكاب دموعي","وخريري هو البكا والنواح",1,"ح",1,0],["فَميعادُ دَمعي أَن تَنوحَ حَمامَةٌ","وَميعادُ شَوقي أَن يَهُبَّ نَسيمُ",2,"م",1,0],["فميدي كما شئتِ فوقَ الحقولِ","بحُلْوِ الثِّمارِ وغضِّ الزَّهَرْ",3,"ر",1,0],["فَمي تَحَدَّثَ عَن سِرّي فَما ظَهَرَت","سَرائِرُ القَلبِ إِلّا مِن حَديثِ فَمي",4,"م",2,0],["فَمِئْذَنَةٌ في الجوِّ تُشْرِقَ في الدُّجَى","عليها هُدىً لِلْعَالمينَ وَنُورُ",5,"ر",1,0],["فَمي أَخَذَت مِنهُ اللَيالي وَإِنَّني","لَأَشرَبُ مِنهُ في إِناءٍ مُثَلَّمِ",6,"م",1,0],["فَميلوا عَلَينا كُلّكُم إِنَّ مَيلَكُم","سَواءٌ عَلَينا وَالرِياحُ بِهاطِلِ",7,"ل",1,0],["فَمَيِّز مَديحاً لَن يَزالَ صَريحُهُ","عَلى ذي العُلا ما عاشَ شاعِرُهُ وَقفا",8,"ف",2,0],["فَمَيِّز خاطِراً يَأبى الدَنايا","وَشِعراً ما تَبَذَّلَ مُنذُ صينا",9,"ن",2,0],["فَمي لَدى يَثرِبٍ أَضحى هَوى كُلِّ مُسلِمِ","فَهُم نَحوَها دَبّاً كَما دَبَّتِ النَملُ",10,"ل",1,0],["فَمِيلُوا عَلَيها بِالسِياطِ وَعَرِّفُوا","ذَوي الجَهلِ مِنّا كَيفَ تَحوي الوَسائِقُ",11,"ق",1,0],["فميتَتُكِ الحُسنى على النورِ نعمةٌ","وحولكِ قد جلَّى الصباحُ قتاما",12,"م",2,0],["فمِيلا بأعناقِ المَطيِّ رواسِماً","عسى مَنْزِلٌ بالجِزْعِ أنْ يُتَرَسّما",13,"م",2,0],["فمِيلوا إليها بالمطايا فَدُونَنا","تهائمُ يُطْوَى عَرْضُها ونُجود",14,"د",1,0],["فمياهِ أَو الشَّوْلِ من أَفيائِها","فمسارِحِ الأَغنامِ عند العَرْبَةِ",15,"ه",1,0],["فمُيِّز من أعدائهم أولياؤُهم","إذا انتقموا يوم الجزاءِ وأنعموا",16,"م",3,0],["فميعادُ شوقي أن تلوحَ على الحمى","خيامُهمُ أو أن تَهُبَّ جَنُوبُ",17,"ب",1,0],["فميم وجاء ثم ميم وحاؤه","هي النقطة الكبرى ففكر بحولتي",18,"ت",2,0],["فميمنةٌ وميسرةٌ طواها","طوى ميزانه في كفَّتيه",19,"ي",2,0],["فميتةُ بارحيْ حظُّ الطويلِ","وأمّا اليومَ فالمحْظوظُ وافِرْ",20,"ر",1,0],["فميز وجود الحق من عدم السوى","تكن رجلاً عند الورى بك يوثق",21,"ق",1,0],["فَميِّتُ حُبِّهِ يَرْجُو نُشُوراً","إِذَا لَمْ يَأْتِ مِنْ خَلْقٍ نُشُوزُ",22,"ز",1,0],["فميلها أخرى وكانت مريضة","وقد صابني هم شديد عصبصب",23,"ب",1,0],["فميل يسر العين مني بميله","وميل من عثمان من كان يصحب",24,"ب",1,0],["فميَّز النعت بالتوكيد لا بدل","عن اعتقادي وحالي بالخلوص عطف",25,"ف",1,0],["فمئين الألوفِ تُمطرُ مِن كَفَّ","يهِ رِفداً كأنَّها آحاد",26,"د",1,0],["فميسوركم ميسوره غير ماعك","ومعسركم المحفوظ من كل ناهك",27,"ك",1,0],["فميل القلوب ولا حرج","من البدء منصرف للأذى",28,"ذ",2,0],["فميِّزْ إذا ما عارضتْك قصيدةٌ","فِللَّيْث صوتٌ والثُّعَيْلِبُ ضابحُ",29,"ح",1,0],["فمِيماتُ أَوْصافِهِ أَرْبَعٌ","قَرَنْتُ بَمعْدودِها شَكْلَهُ",30,"ل",2,0],["فمياههم فوق البحار دماؤهم","ودماؤهم فوق التراب مياه",31,"ا",2,0],["فميتكم ذكره نحو السماء سما","وحيكم نوره في الأرض منتشر",32,"ر",1,0],["فميمونة لا زال يلقى يعاعه","بها وبمغناها البوارق تومض",33,"ض",1,0],["فمى الردى صدع الهدى","فالصدع فيه اليوم يجبر",34,"ر",1,0],["فميزه عني الذي فيه من غنى","وميزني عنه الذي بي من الفقر",35,"ر",1,0],["فميز الحال إذ تراه","في مركب القدس في الغوادي",36,"د",2,0],["فَميثُ عُرَيناتٍ بِها كُلُّ مَنزِلٍ","كَوَشمِ العَذارى ما يُكَلَّمُ سائِلُه",37,"ل",2,0],["فَمِيلَ عَنهَا يُمنَةً أو يُسرَه","مِنهَا إلى المَاشِيَةِ القُطبُ المَجرَى",38,"ر",2,0],["فميلاد عيسى بدا عيده","ختاماً لتاسع عشر القرون",39,"ن",1,0],["فميَاهُ الذلّ لا أشربها","تخصبُ الأرض فَلا أقرَبها",40,"ه",2,0],["فميلهن حاصل من النظر","ضرورة إذ ذاك من طبع البشر",41,"ر",1,0],["فميزوا المبهم من حالي ومن","ذاتي ومن كم وكأي وكذا",42,"ذ",2,0],["فَميدونُ كانَ فَتىً رَبَّ باسِ","لِويلوسَ مِن غَيرِ أُمِّ أَياسِ",43,"س",1,0],["فمِينَستِسُ مَن بأَرنا وُلِد","لآرِيشُسَ المَلِكِ المُعتَضِد",44,"د",1,0],["فمي وما إن خضت تلك الوهاد","كيف وفي الخيمة إلفي يرى",45,"ر",2,0],["فَم يُسمع بِهِ صَوت التَهاني","وَلَم نَرَ فيهِ للافراح أَثَرا",46,"ر",2,0],["فميزان أفكار الرجال تقيمه","ضوابط من بحر البراهين لو تدري",47,"ر",2,0],["فميِّزْ مكانَ المخلصين فإنّما ال","أَعادي أُناسٌ في رؤُوسهمُ خَلْطُ",48,"ط",1,0],["فميزانٌ يقوم مع حسابٍ","على القطمير والصنو النقير",49,"ر",1,0],["فميخائيل ناداه إليه","رئيسُ جنود ربي في علاهُ",50,"ا",2,0],["فمياهُ الحب مِمَّن ملكتْ","نبعَه، عني بلا عذرٍ زوَت",51,"ت",1,0],["فمي تذوق منك الحلو في صغري","ها قد كبرت، بحسي ضاقت الجمل",52,"ل",1,0],["فمي أبان بسري فالعتاب على","نفسي وتصدير لومي في حديث فمي",53,"م",2,0],["فميْمنتي وميْسرتي قصيدٌ","ومُتَّخذًا من الشِّعْرِ الركائبْ",54,"ب",1,0],["فمي بوحٌ وفي عينيك بوح","وشيءٌ في دمي يغفو ويصحو",55,"ح",2,1],["فمينائي له سكنٌ","جراري ما لها ثانِ",56,"ن",1,0]]}