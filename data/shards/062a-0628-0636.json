{"poems":[[55,"نعوه على ضن قلبي به","https://www.aldiwan.net/poem29746.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39608","المتقارب"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"]],"verses":[["تَبِضُّ إِلى اليَومِ آثارُها","بِأَحمَرَ مِن عانِدٍ الطَعنَ قاني",0,"ن",2,0],["تَبِضُّ ترائبُها لوعةً","وتخفقُ لا عن ضَنىً أو كلالْ",1,"ل",1,0],["تُبضِعُكم جوهرَها","أكسدَ فيكم أو نَفقْ",2,"ق",1,0],["تَبضَع المجاسِدَ عن صفائحَ فِضةٍ","ذُلقٍ ترى صفحاتِهِنَّ حسانا",3,"ن",2,0]]}