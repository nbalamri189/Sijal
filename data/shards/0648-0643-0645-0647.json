5121,"دَوْلَةُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=59598",""],[592,"معاني مبانيها الطوامح في العلا","https://www.poetsgate.com/ViewPoem.aspx?id=128851",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5431,"ديك مدجن","https://www.poetsgate.com/ViewPoem.aspx?id=205542",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5452,"بلادي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=111448",""],[5561,"حُكْمُ القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=192908",""],[5561,"لملمْ عصورَكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197720",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"أَتَعْرِفُ أَطْلالاً لِهِنْدٍ غَوارِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186765",""],[5582,"خلّ المتيّم في نهج الغواياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63473",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5704,"قف بالرِّكابِ ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202821",""],[5818,"تعلّمت أنّ الأمور الكبيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=193177",""],[5845,"عسى منْ خفي اللطفِ سبحانهُ لطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=15452",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""]],"verses":[["وَكَم هَوى بِعَظيمٍ في عَشيرَتِهِ","مِطعامِ أَندِيَةٍ طَعّانِ أَبطالِ",0,"ل",1,0],["وَكَم هَزَأَت بِعاجِمَةٍ","عَلى طَمَعٍ مَكاسِرُه",1,"ر",2,0],["وَكَمْ هِجْرَةٍ قَدْ ذُقْتَ أَلْوَانَ ضَيْمِهَا","وَأَسْوَغُ مِنْهَا أَنْ تُحَزَّ الغَلاصِمُ",2,"م",1,0],["وكم هلالٍ لقوسٍ كلَّما نبضتْ","ترى النجومَ رجوماً في مراميها",3,"ي",3,0],["وكم هين الأخلاقِ أو متغلبٍ","نفاهُ بحتمٍ غالب غير مغلوب",4,"ب",1,0],["وكم هَدآتٍ للأرِيبِ أَريبةٍ","يخالُ الأعادي أنها فَتَرَاتُ",5,"ت",1,0],["وكم هدَّ من طَوْدٍ مُنيفٍ عانهُ","وكم قضَّ من قَصْرٍ مُنيفٍ وكم وكمْ",6,"م",1,0],["وكم هنالك ابليساً يحاول ان","يزيحني بخداع من فراديسي",7,"ي",1,0],["وَكَم هَدَّتِ الأَيّامُ مِن جَبَلٍ لَنا","وَسابِغَةٍ زَغفٍ وَأَبيَضَ ذي أَثرِ",8,"ر",1,0],["وَكَم هالِكٍ بِالشَيءِ مِمّا يَلُذُّهُ","وَكَم مِن مُعافاً خَرَّ مِن جَبَلٍ راسِ",9,"س",1,0],["وَكَم هَدَمَت حِمى قَومي خُطوبٌ","تَهُدُّ الراسِياتِ وَأَنتَ عالي",10,"ل",2,0],["وَكَم هَمَّت كِلابُ الحَيِّ نَهضاً","وَقَد حَمَتِ الأُسودُ حِمى الغَزالِ",10,"ل",1,0],["وكم هَزَّ الممالكَ في عُلاها","فَتىً ما هزَّ سَيفاً أو سِنانا",11,"ن",2,0],["وَكَم هُناكَ والِجاً كَريما","وَراجِعاً مُدَفَّعاً مَظلوما",12,"م",2,0],["وَكَم هَجيرٍ وَقَتني","مِن حَرِّ شَمسٍ ذَكِيَّه",13,"ي",2,0],["وكم هاجعٍ ليلَ البَياتِ اهتَبَلتَه","فصَبّحتَه كأسَ المنيّةِ مُصْبِحا",14,"ح",2,0],["وَكَم هُدَّ مِن ثَهَلانَ شامِخُ طَودِهِ","وَلَكِن تَرى ثَهلانَ لَم يَتَضَعضَعِ",15,"ع",1,0],["وكم هُضمت ببلدتكم نفوس","فطاب لكم عن النصر القعود",16,"د",1,0],["وَكم هنالك نذلاً في صحيفته","يسبني بلسان بارز قذر",17,"ر",1,0],["وكم هَمّ نِضْوٌ أن يَطيرَ مع الصَّبا","إلى الشأمِ لولا حَبْسُهُ بعِقال",18,"ل",1,0],["وَكَمْ هَالِكٌ دَامِي الجَوَانِبِ تَنْحَنِي","إِلَى قَدَمَيْهِ ذَاتُ رَأْسٍ تُكَلَّلِ",19,"ل",1,0],["وكم همست بِمسمعه غصونٌ","فردَّد همسَها وَلَهاً ووجدا",20,"د",2,0],["وكم هبةٍ تُحْيي من الموت أنفسًا","على قدميْ هيفاءَ ينشرها حِبُّ",21,"ب",1,0],["وكم هلَّلت إذ رأتني، وكانت","لبُشرى قُدومِي الرسُولَ الأمين",22,"ن",1,0],["وكم هزّني طيفها في الدجا","وكم هزّ قيثاري الملهما",23,"م",2,0],["وكم هاجَ في شدوهِ الأعجمي","خواطرَ أعجزتِ المُفصحينا",24,"ن",2,0],["وكم هاجت رسوم دارساتٌ","هموما للمشوق المستهام",25,"م",1,0],["وكم هامةٍ ذاك النهار قددتها","بحدّ حسامي والقنا طعنه شوى",26,"و",2,0],["وكم هجرا لبعدك من مهاد","وغصَّا فيه بالماء القراح",27,"ح",1,0],["وكم هاجرت نحو الطلا من عمودها","لتغسل غدرا أو تطهّر مأثما",28,"م",2,0],["وَكَم هامَةٍ حَسناءَ راحَت جِباهُها","نِعالاً لِأَيدي خَيلِهِ في المَلاحِمِ",29,"م",1,0],["وكم هَمَعَتْ لنكبَتِنا مآقٍ","عزائمُنا تجلّت في شقاقٍ",30,"ق",1,0],["وكم هارب من ريب دهر أجرته","وأمنته من ريبه المتعاظم",31,"م",1,0],["وَكَم همّ كفّارُ اليهودِ بغدرهِ","فَخابوا وَما نالوا منَ الظفَرِ الظُفرا",32,"ر",2,0],["وَكَم هالكٍ في الكافرين عدادهُ","وَإِن كانَ بينَ المسلمينَ حَمى قَبرا",32,"ر",2,0],["وكم هَفَت وَصَبَت نفسي إلى حُلُمٍ","مُجنّحٍ راقصٍ في النورِ نَشوانِ",33,"ن",1,0],["وكم هتفت به رُهُنُ الأماني","لُطْلِقها ونادته الوفود",34,"د",1,0],["وكم هام قلبي لارتشاف رُضابها","فأعرَب عن تفضيل نَحوِ المُبَرِّدِ",35,"د",1,0],["وَكَم هنالك من حاج وَمُعتَمر","بغير سعي واحرام واهلال",36,"ل",1,0],["وَكَم هم صرف الدهر يصرف غابه","عَليّ فَجاء الغوث وانصرف الصرف",37,"ف",1,0],["وَكَم هَتفت يَوماً بِأَوصاف أَحمَد","هَواتف ما أَربى عَلَيهنّ مطربُ",38,"ب",1,0],["وَكَم همام وَكَم قرم وَكَم ملك","تحت التُراب وَكم شهم وَكَم بَطَل",39,"ل",1,0],["وكم هَممْتُ أن أُقيمَ ساكناً","وسالِكاً طريقةَ المُخَفَّف",40,"ف",1,0],["وَكَم هَرَبَت مَطالِبُنا حَياءً","فَناداها نَداها لا نَجاءَ",41,"ا",2,0],["وكم هلكت بها جهلاً نفوسٌ","وقد تاهت بمن قد تاه قدرا",42,"ر",2,0],["وكم هِمتُ فيهمْ والزّمان مُساعدٌ","وصرفُ القضا يُجْري الأُمور على قصْدي",43,"د",2,0],["وكم هَدَرَتْ دماءٌ من أُناسٍ","وأموالٌ لهم نَفِدَت نفادا",44,"د",2,0],["وكم هَيَّجَتْ بي زفرةً بعد زفرةٍ","لنيرانها في مضمر القلب إشعال",45,"ل",1,0],["وكم همٍ أساءَ إلى فؤادي","وطال مع الزمان به عتابي",46,"ب",2,0],["وكم هجرت موطناً من أهله","والدار من سكانها قد تجتوى",47,"ا",1,0],["وكم هزّ بالشعرِ من نائمٍ","إذا هُزَّ بالسيفِ لم يشعُرِ",48,"ر",1,0],["وكم هجرةٍ لم تتفِقْ عن ملالةٍ","وصدٍّ يريبُ الحبَّ وهو تدلُّلُ",49,"ل",1,0],["وكم هزَّنا شرخ الشباب وسرنا","تجمعنا لو دام ذاك التجمُّع",50,"ع",1,0],["وكم هزَّ من عطفيَّ في الإيكِ صادحٌ","ولولا الهوى ما هزَّ عطفي صادح",51,"ح",1,0],["وَكَم هَجْرٍ من الوصلِ","وكم جِدٍّ من اللّعْبِ",52,"ب",1,0],["وكم هاربٍ مِنْ أنْ يلاقِيَهُ الرّدى","مُغذٍّ ولكنْ لا نجاءَ لهاربِ",53,"ب",1,0],["وكم هامت عليك ظلال قلبي","وفي عينيك كم سبحت شراعي",54,"ع",2,0],["وكم هجر أراه وكم دلالُ","وصبري عنكمو شيء محالُ",55,"ل",1,0],["وكم هجعنا على زهر الرياض إِلى","أن نبهتنا عصافير على القضب",56,"ب",1,0],["وَكَم هال مِن بربيطة رعدُ مدفع","وَزعزع أَركان العَدوّ بصدمة",57,"ه",1,0],["وَكَم هَزمت مِن جُيوش لِلوَبا","بِهمة وَمَهرُ فكري ما كَبا",58,"ب",2,0],["وكم هاتك بين الورى ستر غيره","وسوءته في أعين الناسِ ظاهره",59,"ر",2,0],["وكم هددتني بالليالي جحافلٌ","من العسر تعدو بالشتات سباسبه",60,"ب",2,0],["وكم هووا وهوا أهواء واطرحوا","أوامر الرسل والاسراء والحكم",61,"م",1,0],["وكم همام بضرب السيف جدّله","وكم شجاع بطعن الرمح أرداه",62,"ا",2,0],["وكم هزمت الكفر في فتية","لولاك ما انقادوا لدين السلام",63,"م",1,0],["وَكَم هزمت منه الكتائبَ كتبهُ","صَحيفتها تثني حدود الصفائحِ",64,"ح",1,0],["وَكم هذّبتني النائبات وأشحذت","شبا نجدتي واستخرجت نار لوعتي",65,"ت",2,0],["وَكَم هامَ وجدي من أُميمة مربع","تعفّيه مرّ الرامسات وتمصحُ",66,"ح",1,0],["وَكم همى منك غيث الجود مُنسكباً","عَن أنملٍ حاتميّات سجيّاتِ",67,"ت",1,0],["وكم هارب تحت الظلام بروحه","وآخر ملقى في جوارحه بتر",68,"ر",1,0],["وكم هنَّيت في ملقى خليلٍ","أميرٌ جوده قد راق وِردا",69,"د",2,0],["وكم هصرت بها الأعطاف مائلة","كالغصن مهتزة من رقة الميد",70,"د",1,0],["وكم هالك يبكي بحزن وعبرة","ولا مثل زاد المال حين نقيسُ",71,"س",1,0],["وكم هتكوا منكم خباءً لحرّةٍ","عِناداً ودقّوا منكم عنقَ أصيد",72,"د",1,0],["وكم هيض من أطيار دوحك في الحمى","جناحٌ به غصن الصّبابة ما ماسا",73,"س",2,0],["وكمْ هزّني منكَ فعلٌ كريمٌ","رفعْتَ به الشّعرَ فوقَ الِقمَمْ",74,"م",1,0],["وكم هبت صعبا والمصارع ان دهى","بها كل نقص علم عثمان منجدى",75,"د",2,0],["وَكَم هَجعت لي فيكَ عَين وَلم يَكُن","يُرنّق جفنيها كَرى وهجوع",76,"ع",1,0],["وكم هام في عاليه قوم فعيشها","رغيد وفيها الماء منفجر برد",77,"د",1,0],["وكم هزموا الأعداء قسرا وعنوة","ببيض المواضي والردينة السمر",78,"ر",1,0],["وكم هدمت حصون العلم فانبعثت","أحزاننا خلا عن أنسه الوطن",79,"ن",1,0],["وكم هِمَّةٍ لَو تَحمِلُ الشُّمُّ بَعضَها","لَعادَت بِحالِ الخاشِعِ المُتَصَدِّعِ",80,"ع",1,0],["وكم هوتْ وهي حيرى وسْطَ أوديةٍ","حتى اكتست من صماخ الاذن قمصانا",81,"ن",2,0],["وكم هربٍ لي بعد حرب أثرتها","وكم ليَ بعد الفرِّ في الحرب من كرِّ",82,"ر",1,0],["وكم هدى العطر ضلالا وقد سلكوا","قفرا من البعد لما أبعدوا المسرى",83,"ر",2,0],["وَكَم هشمت في مَكة كَف هاشم","ثَريداً وَحر الجدب قَد زادَ وَاشتَدا",84,"د",2,0],["وكم هتكوا خدرا على ذات عفة","نقية جيب الصون زاكية الجد",85,"د",1,0],["وكم هددتني بقول صريح","بامر يجر اليَّ الشنارا",86,"ر",2,0],["وكم هرعت لتلك وكم أقامت","بسوق اللهو طارحةً عصاها",87,"ا",3,0],["وكم هززنَ قُدود السُّمرِ يوم وغىً","يَمْرُقن بَيْنَ ضلوعِ البُهْم والسُّدُد",88,"د",1,0],["وكَم هَيّجَت قَلبَ المَشوقِ حَمامةٌ","بتغريدها من فوقِ أغصَانَها الخُضرِ",89,"ر",1,0],["وكم همّ أن يعدو مرارا فرعته","فأبقى، ولولا فرق بأسك ما أبقى",90,"ق",2,0],["وكم همم للسها سروها","لها سودد سرها أطلعا",91,"ع",2,0],["وكم همتِ في رحبه طفلة","كما انطلق الصيدح الطائر",92,"ر",1,0],["وكم هفوت إلى الأفياء من شجرٍ","حنا عليك زمان اللهو واللعب",93,"ب",1,0],["وكم هتكت ستر الهوا أعين المها","وهاجت لي الشوق الديار البلاقع",94,"ع",1,0],["وكم هدَّمت أركان صرحٍ مُمرَّدٍ","من السُرّ بالضراءِ فعل الخوالبِ",95,"ب",1,0],["وكم همامٍ لقد أَمسى بلا هِمَمٍ","أوهت عزائمهُ بالهمّ أكدارُ",96,"ر",1,0],["وكم هَيَّجت برقا إذا ما تبسَّمت","بثغرٍ حكى درّاً بعقدٍ مزَرَّدِ",97,"د",1,0],["وكم هَجَّرتْ في القيظِ تحكي دوارعاً","عذارى دوارٍ في المُلاءِ المُذَيَّا",98,"ي",2,0],["وَكَم هِلالٍ من الأطواقِ مَطلعُةُ","ذوائِبُ الشَّعرِ في بَيتٍ من الشَّعرِ",99,"ر",1,0],["وَكَم هاتِفٍ بِالخُلدِ مِنهُم وَشِعرُهُ","تُوفيَ سِقطاً قَبلَ عَقد العَصائِبِ",100,"ب",1,0],["وكم هجموا في وقعة بعد وقعة","وخاضوا المنايا دون خشية اوهال",101,"ل",1,0],["وَكَم هِجتُ ناراً لِلوَغى بَينَ أَضلُعي","وَبَيني وَبَينَ الغَيرِ وَالأَمرُ شائِعُ",102,"ع",1,0],["وكم هامَ بالحُبِّ قبلي، وكم","رُؤُوسًا على بابِهِ طَأطَؤُوا",103,"ا",1,0],["وكم هنالك دجالٌ له زبدٌ","من فوق شدقيه يخفى الدجل إتقانا",104,"ن",2,0],["وكم هززتك بالأقلام شادية","وبالمهارق فيها الوشي والطرف",105,"ف",1,0],["وَكَمْ هُوَ صَعْبٌ أَنْ يُلاَقِي رَبِيِعَهُ","إذَا كَتَّفَ الأَزْهَارَ فِي قَبْضَةِ الْجَحْدِ",106,"د",1,0],["وكم هدموا بنيان شرك قد اعتلى","وشادوا من الإسلام كل الشعائر",107,"ر",1,0],["وكم هويت من الغزلان ناعسةً","وعزْفَ لحنٍ على ناي الهوى عودي",108,"د",2,0],["وكم هزّه صوتٌ بأنك واهنٌ","قضى وقته رهن الهواجس مُحبسا",109,"س",2,0],["وكم همّ لاستسقاء مهجة ثائرٍ","تضرّمها رغم الهطول يُساخنه",110,"ن",2,0],["وكم هدمت من مسجد ومدارس","وكم قتلت ظلما شعوبا تريبها",111,"ب",3,0],["وكم هَرَبَتْ تسعى لغيرِ مقاصدٍ","هواجسُ قلبي والمزارُ قريب",112,"ب",1,0],["وكم همى الدمعُ من عينيكَ تفضحهُ","شهْقاتُ رُوحِكَ كالأنسامِ تَنهملُ",113,"ل",1,0],["وَكَمْ هاجَ وَجْدِي مِنْ أُمَيْمَةَ مَرْبَعٌ","يُعَفِّيهِ مَرُّ الرَّامِساتِ وَيَمْصَحُ",114,"ح",1,0],["وَكَمْ هُزِمَتْ أَعْداهُ مِنْهُ بِطَلْعَةٍ","كَما هَزَمَتْ شُهْبُ البُزاةِ الأَباغِثَا",115,"ث",2,0],["وَكَمْ هَمَى مِنْكَ غَيْثُ الجُودِ مُنْسَكِباً","عَنْ أَنْمُلٍ حاتِمِيَّاتٍ سَخِيَّاتِ",116,"ت",1,0],["وَكَمْ هَذَّبَتْني النَّائِباتُ وَأَشْحَذَتْ","شَبا نَجْدَتِي وَاسْتَخْرَجَتْ نَارَ عَزْمَتِي",117,"ت",2,0],["وكم هنالك من سيف ومن قصْب","مدت لأكبادنا من غير ما سبب",118,"ب",1,0],["وكم هتفنا طويلاً بالحياة لهم","وكم ذرفنا دموعا من مآقينا",119,"ن",2,0],["وكم هالك ٍ في الحياةِ شقيٍّ","ليحيا عليها أمات ضميرهْ",120,"ر",2,0],["وكمْ همَّ صرفُ الدهرِ يصرفُ نابهَُ","عليَّ فجاء الغوتُ وانصرفَ الصرفُ",121,"ف",1,0],["وكم هاتف باسمه هده","شبا الموت عن صوت من يهتف",122,"ف",1,0]]}