{"poems":[[53,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[72,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[28,"ليبك وكيعا خيل حرب مغيرة","https://www.aldiwan.net/poem5071.html","الطويل"],[49,"خذ الناس أو دع إنما الناس بالناس","https://www.aldiwan.net/poem62127.html","الطويل"],[66,"إذا علم العدا عنك انتقالي","https://www.aldiwan.net/poem40101.html","الوافر"],[105,"رفيدة علمي الناس الحنانا","https://www.aldiwan.net/poem44070.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"كم غدوة وعشيه","https://www.aldiwan.net/poem26570.html","المجتث"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[46,"لعمري لقد أوضعت في الغي برهة","https://www.aldiwan.net/poem22958.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85478","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55120","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[106,"أسف بالغ","https://www.poetsgate.com/ViewPoem.aspx?id=179387",""],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[100,"نجوى","https://www.poetsgate.com/ViewPoem.aspx?id=50157",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[132,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[147,"توسد بمهد الأمن قد مرت النوى","https://www.aldiwan.net/poem47688.html","الطويل"],[150,"أطع مولاك تظفر بالنجاح","https://www.aldiwan.net/poem68533.html","الوافر"],[160,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[169,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[178,"الزفت","https://www.aldiwan.net/poem50700.html","الوافر"],[186,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[197,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[229,"ليهن الملك مالكه الجديد","https://www.aldiwan.net/poem51155.html","الوافر"],[250,"دع اللوم أو لمني فلست بسامع","https://www.aldiwan.net/poem14947.html","الطويل"],[271,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[271,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[353,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[361,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[364,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[366,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[377,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[402,"نسيم الصبا كيف المنازل من نجد","https://www.aldiwan.net/poem46424.html","الطويل"],[416,"محوت بسيف سطوتك الفسادا","https://www.aldiwan.net/poem53896.html","الوافر"],[416,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[416,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[432,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[464,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[464,"سلوا بالحمى أين الظباء السوانح","https://www.aldiwan.net/poem3587.html","عموديه"],[551,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[551,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[552,"في رحاب الحب","https://www.aldiwan.net/poem24828.html","عموديه"],[558,"فؤادي قد أضر به الغرام","https://www.aldiwan.net/poem34183.html","الوافر"]],"verses":[["وَكَم هَوى بِعَظيمٍ في عَشيرَتِهِ","مِطعامِ أَندِيَةٍ طَعّانِ أَبطالِ",0,"ل",1,0],["وَكَم هَزَأَت بِعاجِمَةٍ","عَلى طَمَعٍ مَكاسِرُه",1,"ر",2,0],["وَكَمْ هِجْرَةٍ قَدْ ذُقْتَ أَلْوَانَ ضَيْمِهَا","وَأَسْوَغُ مِنْهَا أَنْ تُحَزَّ الغَلاصِمُ",2,"م",1,0],["وكم هلالٍ لقوسٍ كلَّما نبضتْ","ترى النجومَ رجوماً في مراميها",3,"ي",3,0],["وكم هين الأخلاقِ أو متغلبٍ","نفاهُ بحتمٍ غالب غير مغلوب",4,"ب",1,0],["وكم هَدآتٍ للأرِيبِ أَريبةٍ","يخالُ الأعادي أنها فَتَرَاتُ",5,"ت",1,0],["وكم هدَّ من طَوْدٍ مُنيفٍ عانهُ","وكم قضَّ من قَصْرٍ مُنيفٍ وكم وكمْ",6,"م",1,0],["وكم هنالك ابليساً يحاول ان","يزيحني بخداع من فراديسي",7,"ي",1,0],["وَكَم هَدَّتِ الأَيّامُ مِن جَبَلٍ لَنا","وَسابِغَةٍ زَغفٍ وَأَبيَضَ ذي أَثرِ",8,"ر",1,0],["وَكَم هالِكٍ بِالشَيءِ مِمّا يَلُذُّهُ","وَكَم مِن مُعافاً خَرَّ مِن جَبَلٍ راسِ",9,"س",1,0],["وَكَم هَدَمَت حِمى قَومي خُطوبٌ","تَهُدُّ الراسِياتِ وَأَنتَ عالي",10,"ي",1,0],["وَكَم هَمَّت كِلابُ الحَيِّ نَهضاً","وَقَد حَمَتِ الأُسودُ حِمى الغَزالِ",10,"ل",1,0],["وكم هَزَّ الممالكَ في عُلاها","فَتىً ما هزَّ سَيفاً أو سِنانا",11,"ن",2,0],["وَكَم هُناكَ والِجاً كَريما","وَراجِعاً مُدَفَّعاً مَظلوما",12,"م",2,0],["وَكَم هَجيرٍ وَقَتني","مِن حَرِّ شَمسٍ ذَكِيَّه",13,"ي",2,0],["وكم هاجعٍ ليلَ البَياتِ اهتَبَلتَه","فصَبّحتَه كأسَ المنيّةِ مُصْبِحا",14,"ح",2,0],["وَكَم هُدَّ مِن ثَهَلانَ شامِخُ طَودِهِ","وَلَكِن تَرى ثَهلانَ لَم يَتَضَعضَعِ",15,"ع",1,0],["وكم هُضمت ببلدتكم نفوس","فطاب لكم عن النصر القعود",16,"د",1,0],["وَكم هنالك نذلاً في صحيفته","يسبني بلسان بارز قذر",17,"ر",1,0],["وكم هَمّ نِضْوٌ أن يَطيرَ مع الصَّبا","إلى الشأمِ لولا حَبْسُهُ بعِقال",18,"ل",1,0],["وَكَمْ هَالِكٌ دَامِي الجَوَانِبِ تَنْحَنِي","إِلَى قَدَمَيْهِ ذَاتُ رَأْسٍ تُكَلَّلِ",19,"ل",1,0],["وكم همست بِمسمعه غصونٌ","فردَّد همسَها وَلَهاً ووجدا",20,"د",2,0],["وكم هبةٍ تُحْيي من الموت أنفسًا","على قدميْ هيفاءَ ينشرها حِبُّ",21,"ب",1,0],["وكم هلَّلت إذ رأتني، وكانت","لبُشرى قُدومِي الرسُولَ الأمين",22,"ن",1,0],["وكم هزّني طيفها في الدجا","وكم هزّ قيثاري الملهما",23,"م",2,0],["وكم هاجَ في شدوهِ الأعجمي","خواطرَ أعجزتِ المُفصحينا",24,"ن",2,0],["وكم هاجت رسوم دارساتٌ","هموما للمشوق المستهام",25,"م",1,0],["وكم هامةٍ ذاك النهار قددتها","بحدّ حسامي والقنا طعنه شوى",26,"و",2,0],["وكم هجرا لبعدك من مهاد","وغصَّا فيه بالماء القراح",27,"ح",1,0],["وكم هاجرت نحو الطلا من عمودها","لتغسل غدرا أو تطهّر مأثما",28,"م",2,0],["وَكَم هامَةٍ حَسناءَ راحَت جِباهُها","نِعالاً لِأَيدي خَيلِهِ في المَلاحِمِ",29,"م",1,0],["وكم هَمَعَتْ لنكبَتِنا مآقٍ","عزائمُنا تجلّت في شقاقٍ",30,"ق",1,0],["وكم هارب من ريب دهر أجرته","وأمنته من ريبه المتعاظم",31,"م",1,0],["وَكَم همّ كفّارُ اليهودِ بغدرهِ","فَخابوا وَما نالوا منَ الظفَرِ الظُفرا",32,"ر",2,0],["وَكَم هالكٍ في الكافرين عدادهُ","وَإِن كانَ بينَ المسلمينَ حَمى قَبرا",32,"ر",2,0],["وكم هَفَت وَصَبَت نفسي إلى حُلُمٍ","مُجنّحٍ راقصٍ في النورِ نَشوانِ",33,"ن",1,0],["وكم هتفت به رُهُنُ الأماني","لُطْلِقها ونادته الوفود",34,"د",1,0],["وكم هام قلبي لارتشاف رُضابها","فأعرَب عن تفضيل نَحوِ المُبَرِّدِ",35,"د",1,0],["وَكَم هنالك من حاج وَمُعتَمر","بغير سعي واحرام واهلال",36,"ل",1,0],["وَكَم هم صرف الدهر يصرف غابه","عَليّ فَجاء الغوث وانصرف الصرف",37,"ف",1,0],["وَكَم هَتفت يَوماً بِأَوصاف أَحمَد","هَواتف ما أَربى عَلَيهنّ مطربُ",38,"ب",1,0],["وَكَم همام وَكَم قرم وَكَم ملك","تحت التُراب وَكم شهم وَكَم بَطَل",39,"ل",1,0],["وكم هَممْتُ أن أُقيمَ ساكناً","وسالِكاً طريقةَ المُخَفَّف",40,"ف",1,0],["وَكَم هَرَبَت مَطالِبُنا حَياءً","فَناداها نَداها لا نَجاءَ",41,"ا",2,0],["وكم هلكت بها جهلاً نفوسٌ","وقد تاهت بمن قد تاه قدرا",42,"ر",2,0],["وكم هِمتُ فيهمْ والزّمان مُساعدٌ","وصرفُ القضا يُجْري الأُمور على قصْدي",43,"ي",1,0],["وكم هَدَرَتْ دماءٌ من أُناسٍ","وأموالٌ لهم نَفِدَت نفادا",44,"د",2,0],["وكم هَيَّجَتْ بي زفرةً بعد زفرةٍ","لنيرانها في مضمر القلب إشعال",45,"ل",1,0],["وكم همٍ أساءَ إلى فؤادي","وطال مع الزمان به عتابي",46,"ي",1,0],["وكم هجرت موطناً من أهله","والدار من سكانها قد تجتوى",47,"ا",1,0],["وكم هزّ بالشعرِ من نائمٍ","إذا هُزَّ بالسيفِ لم يشعُرِ",48,"ر",1,0],["وكم هجرةٍ لم تتفِقْ عن ملالةٍ","وصدٍّ يريبُ الحبَّ وهو تدلُّلُ",49,"ل",1,0],["وكم هزَّنا شرخ الشباب وسرنا","تجمعنا لو دام ذاك التجمُّع",50,"ع",1,0],["وكم هزَّ من عطفيَّ في الإيكِ صادحٌ","ولولا الهوى ما هزَّ عطفي صادح",51,"ح",1,0],["وَكَم هَجْرٍ من الوصلِ","وكم جِدٍّ من اللّعْبِ",52,"ب",1,0],["وكم هاربٍ مِنْ أنْ يلاقِيَهُ الرّدى","مُغذٍّ ولكنْ لا نجاءَ لهاربِ",53,"ب",1,0],["وكم هامت عليك ظلال قلبي","وفي عينيك كم سبحت شراعي",54,"ي",1,0],["وكم هجر أراه وكم دلالُ","وصبري عنكمو شيء محالُ",55,"ل",1,0]]}