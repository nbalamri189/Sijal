{"poems":[[108,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[10,"ما بال عينيك منها دمعها سرب","https://www.aldiwan.net/poem20949.html","البسيط"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[83,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[70,"أمذكري عهد الصبا","https://www.aldiwan.net/poem42826.html","مجزوء الكامل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[81,"لام العذار لتوكيد الهوى خلقت","https://www.aldiwan.net/poem61370.html","البسيط"],[46,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[46,"أكرم نزيلك واحذر من غوائله","https://www.aldiwan.net/poem23478.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[136,"يا صاح قل لي على تلك البراعات","https://www.aldiwan.net/poem49033.html","البسيط"],[199,"ومرنة قدحت زناد صبابتي","https://www.aldiwan.net/poem51939.html","الكامل"],[200,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[204,"ما بال عينك قد أزرى بها السهد","https://www.aldiwan.net/poem68168.html","البسيط"],[212,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[362,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[372,"أنى يغير عهدك القدم","https://www.aldiwan.net/poem57113.html","الكامل"],[378,"أمذكري زمن الصبا","https://www.aldiwan.net/poem59342.html","مجزوء الكامل"],[444,"أشعة نسجت من عنصر الزور","https://www.aldiwan.net/poem55939.html","عموديه"],[444,"أشمة نسجت من معدن النور","https://www.aldiwan.net/poem55941.html","عموديه"],[465,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[559,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"]],"verses":[["أم ذلك الطبع غلابٌ لمن ألفت","عيناه كل محبٍ شفّه السقمُ",0,"م",1,0],["أَم ذِكرُ صَخرٍ بُعَيدَ النَومِ هَيَّجَها","فَالدَمعُ مِنها عَلَيهِ الدَهرَ يَنسَكِبُ",1,"ب",1,0],["أَمذكُري دارَ الصبابة والهوى","حيث الشبابُ يرفُّ غصن نُضارِ",2,"ر",1,0],["أمذكّري غرناطةً حلّت بها","أيدي السحابِ أَزرةَ النُوَّارَ",3,"ر",1,0],["أمذكري عهدَ الشبيبة جادَهُ","صوبُ العهاد بواكف هَطَالِ",4,"ل",1,0],["أَمَذْحجُ أحْسنْتِ النضالَ فأبشِري","بِشُكرِكِ عند اللّه والقَرْضُ يُشْكَدُ",5,"د",1,0],["أَمُذَكِّري عَهدَ الصِبا","بَعدَ الإِنابَةِ وَالرُجوعِ",6,"ع",1,1],["أَم ذُناباهُ إِذا حَرَّكَهُ","يَزِنُ الجِسمَ هُبوطاً وَقِياما",7,"م",2,0],["أَم ذاكَ مِن هِمَمٍ جاشَت فَكَم ضَعَةٍ","أَدّى إِلَيها عُلُوُّ القَومِ في الهِمَمِ",8,"م",1,0],["أَمُذلِّلَ الأحداثِ أنتَ جَعلتَها","مِنّا بمنزلةِ الذَّلولِ الطيِّعِ",9,"ع",1,0],["أم ذِي لِتَعرِيفِ وَجدِي أم لجَحدِ دمِ","خُيُولُهُ مِن مَجَارِي أدمُعِي استَبَقَت",10,"ت",1,0],["أم ذِي لِتَعلِيلِ قَلبِي بِالزّيارَةِ أم","للأمرِ أن تَسكُبَ العَينانِ فَاندَفَعَت",10,"ت",1,0],["أم ذِي لِتَارِيخِ شهرِ اللَّحظِ صارِمَهُ","أم ذِي لِجِنسِ جَوَارِي أدمُعِي دَفِقَت",10,"ت",1,0],["أَمُذهَبَةَ التِراسِ لِرَدِّ كَيدٍ","صُروفُ الدَهرِ مُذهَبَةُ التِراسِ",11,"س",1,1],["أَم ذَلِكَ العالَمُ الحَسّاسُ خالِصَةً","فَيَستَحِقّونَ حَمداً أَو يُذامونا",12,"ن",2,0],["أم ذاك جندولُ الحَبي","بِ إلى لياليهِ حَنَنْتْ",13,"ت",1,0],["أم ذا كتاب لنا ألفاظُه كشفت","عن المحجب من فنِّ الجراحات",14,"ت",1,0],["أم ذلك الخِشْفُ الذي بجوانحي","مثواهُ لكن بالمشقَّرِ داره",15,"ر",2,0],["أم ذكاءُ ما برحتْ","تجتلي وتحتجبُ",16,"ب",1,0],["أَم ذاكَ مِن شَغبِ قَومٍ لا جَداءَ بِهِم","إِذ الحُروبُ تَلَظَّت نارُها تَقِدُ",17,"د",1,0],["أم ذاك روح مريدٌ","يصول في قلب ساحر",18,"ر",1,0],["أَم ذاكَ بُلبُل فَضل","عَن المَحاسِنَ تَرجَم",19,"م",1,0],["أَم ذاكَ عَهد المَصلى","نَحا العَذيب وَيمم",19,"م",1,0],["أم ذا لِعارِفةٍ بَدأتَ بِها","زَلَّت بِنا عَن أهلِها القَدَمُ",20,"م",1,0],["أمُذكِّري زمنَ الصبا","والعيشَ في تلك الربوعِ",21,"ع",1,1],["أم ذاك سحرك يا مرسيّ تخدعنا","لسلب أموالنا يا شر مذكور",22,"ر",1,0],["أم ذاك سحرك يا مرسي تعجزنا","أرخصت الماسنا يا خير مذكور",23,"ر",1,0],["أمذكري تلك العهود ترفُّقنا","أأعدت ذكراً أم أدرت شمولا",24,"ل",2,0],["أم ذاك مشهود الذي جاءني","فإنه كيف يشا يشهد",25,"د",1,0]]}