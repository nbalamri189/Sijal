{"poems":[[10,"ما بال عينيك منها دمعها سرب","https://www.aldiwan.net/poem20949.html","البسيط"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[83,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[70,"أمذكري عهد الصبا","https://www.aldiwan.net/poem42826.html","مجزوء الكامل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[81,"لام العذار لتوكيد الهوى خلقت","https://www.aldiwan.net/poem61370.html","البسيط"],[46,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[46,"أكرم نزيلك واحذر من غوائله","https://www.aldiwan.net/poem23478.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"]],"verses":[["أَم ذِكرُ صَخرٍ بُعَيدَ النَومِ هَيَّجَها","فَالدَمعُ مِنها عَلَيهِ الدَهرَ يَنسَكِبُ",0,"ب",1,0],["أَمذكُري دارَ الصبابة والهوى","حيث الشبابُ يرفُّ غصن نُضارِ",1,"ر",1,0],["أمذكّري غرناطةً حلّت بها","أيدي السحابِ أَزرةَ النُوَّارَ",2,"ر",1,0],["أمذكري عهدَ الشبيبة جادَهُ","صوبُ العهاد بواكف هَطَالِ",3,"ل",1,0],["أَمَذْحجُ أحْسنْتِ النضالَ فأبشِري","بِشُكرِكِ عند اللّه والقَرْضُ يُشْكَدُ",4,"د",1,0],["أَمُذَكِّري عَهدَ الصِبا","بَعدَ الإِنابَةِ وَالرُجوعِ",5,"ع",1,1],["أَم ذُناباهُ إِذا حَرَّكَهُ","يَزِنُ الجِسمَ هُبوطاً وَقِياما",6,"م",2,0],["أَم ذاكَ مِن هِمَمٍ جاشَت فَكَم ضَعَةٍ","أَدّى إِلَيها عُلُوُّ القَومِ في الهِمَمِ",7,"م",1,0],["أَمُذلِّلَ الأحداثِ أنتَ جَعلتَها","مِنّا بمنزلةِ الذَّلولِ الطيِّعِ",8,"ع",1,0],["أم ذِي لِتَعرِيفِ وَجدِي أم لجَحدِ دمِ","خُيُولُهُ مِن مَجَارِي أدمُعِي استَبَقَت",9,"ت",1,0],["أم ذِي لِتَعلِيلِ قَلبِي بِالزّيارَةِ أم","للأمرِ أن تَسكُبَ العَينانِ فَاندَفَعَت",9,"ت",1,0],["أم ذِي لِتَارِيخِ شهرِ اللَّحظِ صارِمَهُ","أم ذِي لِجِنسِ جَوَارِي أدمُعِي دَفِقَت",9,"ت",1,0],["أَمُذهَبَةَ التِراسِ لِرَدِّ كَيدٍ","صُروفُ الدَهرِ مُذهَبَةُ التِراسِ",10,"س",1,1],["أَم ذَلِكَ العالَمُ الحَسّاسُ خالِصَةً","فَيَستَحِقّونَ حَمداً أَو يُذامونا",11,"ن",2,0],["أم ذاك جندولُ الحَبي","بِ إلى لياليهِ حَنَنْتْ",12,"ت",1,0]]}