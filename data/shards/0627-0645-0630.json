8",""],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127922","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83168","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104536","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66165","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57972","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136422",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120461","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4726,"ام ذي عقود في سموط بلاغة","https://www.poetsgate.com/ViewPoem.aspx?id=146657",""],[4778,"ماذا أقول إذا الخليفة سائلي","https://www.poetsgate.com/ViewPoem.aspx?id=188146",""],[4830,"حكاية الاصيل","https://www.poetsgate.com/ViewPoem.aspx?id=193540",""],[4852,"بلوغ السحر","https://www.poetsgate.com/ViewPoem.aspx?id=214537",""],[4935,"بدر السموات ازدهر","https://www.poetsgate.com/ViewPoem.aspx?id=129527",""],[4984,"\" ليس الأدل \" 1","https://www.poetsgate.com/ViewPoem.aspx?id=175797",""],[5120,"لَيْلَةٌ فِي اَلْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=179956",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5150,"الرسام ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202939",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5431,"أما اكتفيت؟","https://www.poetsgate.com/ViewPoem.aspx?id=212797",""],[4615,"ألاَجرعٍ تحتلهُ هِندُ","https://www.poetsgate.com/ViewPoem.aspx?id=17838",""],[5970,"أنا في الحب غلام لم أزل","https://www.poetsgate.com/ViewPoem.aspx?id=130642",""],[4442,"وجهك أم بدر السماء إتلق","https://www.poetsgate.com/ViewPoem.aspx?id=171023",""],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""],[469,"أمذكري ظبيات سلع والنقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574810",""],[4115,"أنسيم روض عاطر النفح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607499",""]],"verses":[["أم ذلك الطبع غلابٌ لمن ألفت","عيناه كل محبٍ شفّه السقمُ",0,"م",1,0],["أَم ذِكرُ صَخرٍ بُعَيدَ النَومِ هَيَّجَها","فَالدَمعُ مِنها عَلَيهِ الدَهرَ يَنسَكِبُ",1,"ب",1,0],["أَمذكُري دارَ الصبابة والهوى","حيث الشبابُ يرفُّ غصن نُضارِ",2,"ر",1,0],["أمذكّري غرناطةً حلّت بها","أيدي السحابِ أَزرةَ النُوَّارَ",3,"ر",1,0],["أمذكري عهدَ الشبيبة جادَهُ","صوبُ العهاد بواكف هَطَالِ",4,"ل",1,0],["أَمَذْحجُ أحْسنْتِ النضالَ فأبشِري","بِشُكرِكِ عند اللّه والقَرْضُ يُشْكَدُ",5,"د",1,0],["أَمُذَكِّري عَهدَ الصِبا","بَعدَ الإِنابَةِ وَالرُجوعِ",6,"ع",1,1],["أَم ذُناباهُ إِذا حَرَّكَهُ","يَزِنُ الجِسمَ هُبوطاً وَقِياما",7,"م",2,0],["أَم ذاكَ مِن هِمَمٍ جاشَت فَكَم ضَعَةٍ","أَدّى إِلَيها عُلُوُّ القَومِ في الهِمَمِ",8,"م",1,0],["أَمُذلِّلَ الأحداثِ أنتَ جَعلتَها","مِنّا بمنزلةِ الذَّلولِ الطيِّعِ",9,"ع",1,0],["أم ذِي لِتَعرِيفِ وَجدِي أم لجَحدِ دمِ","خُيُولُهُ مِن مَجَارِي أدمُعِي استَبَقَت",10,"ت",1,0],["أم ذِي لِتَعلِيلِ قَلبِي بِالزّيارَةِ أم","للأمرِ أن تَسكُبَ العَينانِ فَاندَفَعَت",10,"ت",1,0],["أم ذِي لِتَارِيخِ شهرِ اللَّحظِ صارِمَهُ","أم ذِي لِجِنسِ جَوَارِي أدمُعِي دَفِقَت",10,"ت",1,0],["أَمُذهَبَةَ التِراسِ لِرَدِّ كَيدٍ","صُروفُ الدَهرِ مُذهَبَةُ التِراسِ",11,"س",1,1],["أَم ذَلِكَ العالَمُ الحَسّاسُ خالِصَةً","فَيَستَحِقّونَ حَمداً أَو يُذامونا",12,"ن",2,0],["أم ذاك جندولُ الحَبي","بِ إلى لياليهِ حَنَنْتْ",13,"ت",1,0],["أم ذا كتاب لنا ألفاظُه كشفت","عن المحجب من فنِّ الجراحات",14,"ت",1,0],["أم ذلك الخِشْفُ الذي بجوانحي","مثواهُ لكن بالمشقَّرِ داره",15,"ر",2,0],["أم ذكاءُ ما برحتْ","تجتلي وتحتجبُ",16,"ب",1,0],["أَم ذاكَ مِن شَغبِ قَومٍ لا جَداءَ بِهِم","إِذ الحُروبُ تَلَظَّت نارُها تَقِدُ",17,"د",1,0],["أم ذاك روح مريدٌ","يصول في قلب ساحر",18,"ر",1,0],["أَم ذاكَ بُلبُل فَضل","عَن المَحاسِنَ تَرجَم",19,"م",1,0],["أَم ذاكَ عَهد المَصلى","نَحا العَذيب وَيمم",19,"م",1,0],["أم ذا لِعارِفةٍ بَدأتَ بِها","زَلَّت بِنا عَن أهلِها القَدَمُ",20,"م",1,0],["أمُذكِّري زمنَ الصبا","والعيشَ في تلك الربوعِ",21,"ع",1,1],["أم ذاك سحرك يا مرسيّ تخدعنا","لسلب أموالنا يا شر مذكور",22,"ر",1,0],["أم ذاك سحرك يا مرسي تعجزنا","أرخصت الماسنا يا خير مذكور",23,"ر",1,0],["أمذكري تلك العهود ترفُّقنا","أأعدت ذكراً أم أدرت شمولا",24,"ل",2,0],["أم ذاك مشهود الذي جاءني","فإنه كيف يشا يشهد",25,"د",1,0],["ام ذا سنى احمد الأسنى اضاء لنا","من غرة في جبين الدهر قد نصعت",26,"ت",1,0],["ام ذا محيا فؤاد القطر من سطعت","أنواره فاستضاءت مصر والقطر",27,"ر",1,0],["أم ذي ملائكة هبطن من السما","أم في الجنان خالدات جنود",28,"د",1,0],["ام ذي شموس المنى في لندنٍ بزغت","وقد اضاءت بنور اليمن اكوانا",29,"ن",2,0],["أم ذا سنى اثناسيوس الحبر من","تاهت به بين الملا الأحبار",30,"ر",1,0],["أم ذي الدراري النيرات تألقت","في أفقنا وتلألأت ببهاء",31,"ا",2,0],["أم ذا اقتران البشر باللطف الذي","قد جاء مقرونا بالاستبشار",32,"ر",1,0],["أم ذا زفاف اليمن بالبركات قد","غمرته من كرم يمين الباري",32,"ر",2,0],["ام ذا حنين صميم قلب من جرى","ترديده هتف الاصم الابكم",33,"م",1,0],["ام ذلك الفضل العظيم أرى له","شبها فلست أظن أو اتوهم",34,"م",1,0],["أَم ذَلِكَ الفلك الأَعلى كَواكبُه","في الأَرض لاحَت وَما في الأُفق ثانيها",35,"ي",3,0],["أَم ذَلِكَ الشَهم شاهين الجُيوش بَنى","داراً بِمصر علت قَدراً بِبانيها",35,"ي",3,0],["أَم ذاكَ وَابور المَسرّة مدَّه","صَدرُ البَرية أَسَعد السَعداء",36,"ا",2,0],["أَم ذا يكاثر بي الذي","بالشعرِ جاءَ يُكاثره",37,"ر",2,0],["أم ذا سؤال مَن غدا","له الصفاء مذهبا",38,"ب",2,0],["أم ذاك خوف منه حين علا على","صهواته ارتعدت فرائصُه وَجَلْ",39,"ل",1,0],["أم ذاته أم لإِسرائيل نسبته","أم فرَّ من حُور عَدْنٍ نحونا وسعى",40,"ع",2,0],["أم ذا سؤال سال من","رشفاته صُمُّ الحجر",41,"ر",1,0],["أمذكري تلك العهود ترفُّقا","أأعدت ذكراً أم أدرت شمولا",42,"ل",2,0],["أمذل دولة من تمرد واعندى","بحسامه ومعز دولة هاشمِ",43,"م",1,0],["أمْ ذَاكَ عَسَّاكٌ لَهُ مِنْ طرفك ال","وَسْنَانِ يَا غُصْنَ الأرَاكِ سِنَانُ",44,"ن",1,0],["أمُذِلٌ دُراً نفيساً مُعِزٌ","صَدَفاً هيناً خسيساً أريب",45,"ب",1,0],["أَمذيبةَ الأَكباد في","حَرِّ الغَرام مُضرَّما",46,"م",2,0],["أَمذيب حشاي عَلى شَحط","هَلا وَمَزارك مُقترب",47,"ب",1,0],["أم ذا طبيبٌ دنا يشفي لعلتنا","أم أقبل الحبر جبرائيل بالظفر",48,"ر",1,0],["أم ذاك طيف خيال حبة ناظري ال","ساهي بمرآة الجمال المفرد",49,"د",1,0],["أم ذاك خير الدين والدنيا الذي","ثنّى سناه لنا سنا ابن ذكاء",50,"ا",2,0],["أَم ذكرتُنَّ مألفاً وغريبُ الد","دارِ يشجُوه تَذَكُّرُ الأوطانِ",51,"ن",1,0],["أم ذَا بَرِيقٌ لِلثَّنايا يُجتَلَى","يا حَبَّذَاكَ المُجتَلَى وَلمَاها",52,"ا",3,0],["أم ذِى لُييلَى الأخيَلِيةُ أَسفَرَت","عَن وَجهِها فَمَحى الظَّلاَمَ ضِياها",52,"ا",3,0],["أم ذِى زَوَاهِرُ لُؤلُؤ قَد نُظِّمَت","فِى سِمطِ عِقدِ فَخارِها وَعُلاَها",52,"ا",3,0],["أم ذِى لَطائِفُ أحرُفٍ قَد أَطلَعَت","بَدرَ المَحاسِنِ فِى سَماءِ حُلاَها",52,"ا",3,0],["أَم ذَا نَسِيمٌ فاحَ مِن وَادِى قُبا","يُهدِى إِلى القَلبِ الشَّجِى أَفرَاحَا",53,"ح",2,0],["أمذيب قلبي كفَّ عنه يد الأسى","فبه من الوجد المبرح ما كفى",54,"ف",2,0],["أم ذاكرون لما بيني وبينهم","من المواثيق والايمان والصحب",55,"ب",1,0],["أم ذاك الخال بذاك الخدِّ","فتيتُ الندِّ على مجمر",56,"ر",1,0],["أَم ذَهَلنا وَتَمادى لَيلُنا","فَتَوَهَّمنا العِشاء السَّحَرا",57,"ر",2,0],["أم ذاك اسم بلا جسم وليس له","كالغول عين ترى أم كان واحتجبا",58,"ب",2,0],["أم ذي جواهر نظمت لمحبر","أم ذي غصون الروض والدوحات",59,"ت",1,0],["أم ذلك الظبي الغرير قد ازدهى","حسنا وليس الظبي من أنداده",60,"د",2,0],["أم ذى الدراري ف يالعقود تنظمت","أم أنجم سطعت فما المشكات",61,"ت",1,0],["أم ذي عيون كواعبٍ صفت لكي","تغتال أسداً وهي سرب ظباء",62,"ا",2,0],["أم ذي مبان أشرقت بمحاسن","بك يا محمد لا محاسن بعدها",63,"د",3,0],["أم ذي دراري النجم قد","صيغت لشانات سنيه",64,"ي",2,0],["أم ذي حلى ملك كريم قد بدا","للناظرين بصورة الإنسان",65,"ن",1,0],["أم ذي ثنايا مهاة أنس","كناسها دونه عرين",66,"ن",1,0],["أم ذا جميل ثناء عن بهى حلى","قد أسفرت عن معاليه مدائحه",67,"ح",2,0],["أم ذي دراري النجوم الزهر سارية","لكنها في سماء الطرس قد رصدت",68,"ت",1,0],["أم ذي بوارق طيبة","لاحت تهيج العاشقين",69,"ن",1,0],["أم ذا عبير من نسيم الصبا","شميم رياه لسقمي طبيب",70,"ب",1,0],["أم ذي عقود عقائد","نظمت صحاح الجوهر",71,"ر",1,0],["أم ذا نشان علو الشاني قد سطعت","أنوار جوهره تحكي سنا الشهب",72,"ب",1,0],["أم ذي علالي جنان عدن","فيهن عين زهت وحور",73,"ر",1,0],["أم ذي نسيمات الصبا","مرت بهاتيك الخيام",74,"م",1,0],["أم ذي أثار عبرات","بمآثرها متبارية",75,"ر",3,0],["أم ذاك غمدان سمت أفلاكه","وأحاط عرش كرومه بالكرسي",76,"س",2,0],["أم ذي تباشير الصباح تنفست","وجلت أشعتها دجى الديجور",77,"ر",1,0],["أم ذا نشان معالي الشان منذ زها","سنا جواهره أزرى بذي النجم",78,"م",1,0],["أم ذنبه أنه طير وأن له","لحنا ينوح على طير وأزهار",79,"ر",1,0],["أَم ذاك واصلُ صَوم","أَم ذاكَ قاطِعُ رَحْمِ",80,"م",1,0],["أم ذاك منك خيال في الحياة وكم","حيرتنا بخيال فيك جبار",81,"ر",1,0],["ام ذاك امر بها طبيعي","اذا دعاها الهوى تجيب",82,"ب",1,0],["ام ذاك عنوان الوصول كرامة","قبل الوقوف إلى على الجنات",83,"ت",1,0],["أم ذلك السيف قد هزت مضاربه","فأنت تحدق في متن وفي شطب",84,"ب",1,0],["أم ذا طراز للغواني أم طرا","زك رصّعته أنامل الأفكار",85,"ر",1,0],["أم ذاك باكورة الروض التي ابتهجت","بها النفوس وسرَّت خاطر الأمل",86,"ل",1,0],["أَم ذا القَطينَ أَصابَ مَقتَلَهُ","مِنهُ وَخانوهُ إِذا اِحتَمَلوا",87,"ل",3,0],["أم ذاك نور قد بدا لامعاً","من قبر مولىً للتقى كاسِ",88,"س",1,0],["أم ذلك السلك قد لاحت به درر","أم مندل الطّيب قد فاحت مجامره",89,"ر",2,0],["ام ذاك ترهيبٌ وتر","غيبٌ تَداخَلَ في حَواسِك",90,"ك",1,0],["أَم ذا ابنُ نُونٍ جائزُ الأُردُنِّ بال","تابوتِ فالأمواهُ ذاتُ توقُّفِ",91,"ف",1,0],["ام ذاكَ أَليَشَعُ النبيُّ وشانهُ","صلحُ المياهِ من الفَسادِ المُتلِفُ",91,"ف",1,0],["أَم ذِكرُ إِخوانٍ فجعتَ بِهِم","سَلَكوا سَبيلَهُمُ عَلى قَدرِ",92,"ر",1,0],["أَم ذا رَسولٌ للخواطر بَينَنا","فتراه يستبق الخواطرَ نائي",93,"ا",2,0],["أَم ذا كِتابٌ قَد حَوى في ظَرفه","مَعنى الحُميّا في مُحيّا الناهدِ",94,"د",1,0],["أم ذاك روح أطلقو","ه في الدُّنى محيَّرا",95,"ر",2,0],["أم ذي السويد فوق وجنته","خال تعشق موضع الجمر",96,"ر",1,0],["أم ذاك شاد شادن","حلو اللقا مر الصدور",97,"ر",1,0],["أَمُذ كُنتَ هَكطورَ تَسمو بِعَزمِك","زَعَمتَ بِأَنَّكَ فُقتَ بِعِلمِك",98,"ك",1,0],["ام ذات بولس حبرنا السامي الذرى","زارَ البَنين تَنازلاً كَي يَرتَقوا",99,"ق",3,0],["أم ذاك طرف حار فيه الحور","أم ساحر بكل لب يسحر",100,"ر",1,0],["أم ذا سنان رمح ذاك القد","وما أرى في خدك اليسار",100,"ر",1,0],["أَم ذا جَزاؤُكَ لِلمُجِدِّ بِسَعيِ