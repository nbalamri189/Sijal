{"poems":[[74,"يا طائرا بالحمى يشدو على فتن","https://www.aldiwan.net/poem20283.html","البسيط"],[53,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[64,"تحاكمنا إلى نوب الليالي","https://www.aldiwan.net/poem52486.html","الوافر"],[47,"وجدنا خلال أبي صالح","https://www.aldiwan.net/poem63487.html","المتقارب"],[63,"أغرتك الشهاب أم النهار","https://www.aldiwan.net/poem51685.html","الوافر"],[89,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[35,"دعوت إلهي دعوة ما جهلتها","https://www.aldiwan.net/poem25926.html","الطويل"],[13,"وكادت وبيت الله أطناب ثابت","https://www.aldiwan.net/poem2190.html","الطويل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54569","الوافر"],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[189,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[197,"جفون قد تملكها السهاد","https://www.aldiwan.net/poem13020.html","الوافر"],[228,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[286,"رعاك الله ذا الأجر الجزيل","https://www.aldiwan.net/poem1383.html",""],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[409,"سؤالكم وافى لتحقيق مشكل","https://www.aldiwan.net/poem33470.html","الطويل"],[412,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[412,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[443,"أبى الدهر إلا أن تلم نوازله","https://www.aldiwan.net/poem2576.html","الطويل"],[463,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[463,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[469,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[534,"أيا رب هل من نصرة لشريعة","https://www.aldiwan.net/poem37394.html","الطويل"],[580,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[580,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[592,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[592,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122615","الطويل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143275","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53916","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96652","الطويل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77441","الطويل"],[1590,"","https://poetry.dctabudhabi.ae/diwan/poem/98057","الطويل"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121932","البسيط"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114965","الطويل"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198992","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28476","السريع"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121177","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93699","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123880","المتقارب"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206256","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37522","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99241","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76441","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81699","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136485",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117252","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72439","المتقارب"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116073","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[5121,"بَاقِيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=33575",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5582,"فَما كُنْتُ أَدْرِي أَنْ يَكُونَ سَعِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186978",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6079,"أيُبكيكَ رَسمٌ في الشآم عليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207850",""],[6093,"نفاق درب","https://www.poetsgate.com/ViewPoem.aspx?id=203742",""],[5190,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78322&r=&rc=35",""]],"verses":[["فقد شفاني دوا نعماكَ منشدة","هذا بذاك ولا عتبٌ على الزمن",0,"ن",1,0],["فقد شك في حالي لديك معاشر","وفي مثل حالي للشكوك مواضع",1,"ع",1,0],["فقد شهِدتْ له بالزور بِيضٌ","طوالِعُ في عِذاري لا تغيبُ",2,"ب",1,0],["فَقَد شارَفَ النُجحَ مِن سَيِّدٍ","إِذا جادَ بِالعُرفِ لَم يُكدِهِ",3,"د",2,0],["فقد شَهِدَتْ وما حابَتْكِ طيٌّ","بِأنَّ الجُودَ مَعدِنُه نِزارُ",4,"ر",1,0],["فَقَدْ شَبَّ الْهَوَى مَنْ رَامَ نُصْحِي","وَأَغْرَى فِي الْمَحَبَّةِ مَنْ نَهَانِي",5,"ن",2,0],["فَقَد شاعَتِ الأَخبارُ أَن قَد تَزَوَّجَت","فَهَل يَأتِيَنّي بِالطَلاقِ بَشيرُ",6,"ر",1,0],["فَقَد شَدَّ في إِحدى يَدَيهِ كِنانَةً","تَداوى لَها في أَسوَدِ القَلبِ قادِحُ",7,"ح",1,0],["فقد شهِدتُ له بالمُعجِزاتِ كما","شَهِدْتُ للّهِ بالتّوحيدِ والأزَل",8,"ل",1,0],["فقُدْ شراعكَ لا تُسلِم أزمَّته","لغير كفّكَ إنَّ الريحَ هوجاءُ",9,"ا",2,0],["فَقَدْ شَهِدَتْ فِعَالَكَ يَا فَتَاهَا","وَكَانَ أَقلُّ مَا شَهِدَتْ عَجِيبَا",10,"ب",2,0],["فَقَد شاوَرتُ يا رَعناءُ عَزمي","مِراراً في الخُمولِ وَقَد نَهاني",11,"ن",2,0],["فقد شامَ منك الشامُ بَرْقا سيحتوِي","على مُلْك قُسْطَنْطِينَ من سَيْلِه مَدّ",12,"د",1,0],["فقد شكرتْ آثارَ سيِفك فيهمُ","قَشاعُم تَتْلوها مُحَلْحَلة عِقْد",12,"د",1,0],["فَقَد شَطّت بِنا وَبِهم دِيارٌ","وَفَرّق جامِعَ الشَملِ البِعادُ",13,"د",1,0],["فَقَد شَهِدَت صُخورُ الغابِ يا اِبني","بِأَنَّكَ فارِسُ الأَعرابِ طُرّا",14,"ر",2,0],["فَقَدْ شَفَى الدينَ والدّنيا مُهَنَّدُهُ","كَما شَفَى مِن صَدَى الإمْحالِ هَطَّالُ",15,"ل",1,0],["فقد شمل الجميعَ شمولَ حزن","نصيرُ به عليه بلا شمول",16,"ل",1,0],["فقد شهدَ الذكرُ المبينُ بفضله","وَطيبةُ وَالبيتُ العَتيقُ وَزَمزَمُ",17,"م",1,0],["فقد شخص أبرّ كفأيه قبر","لك منه عنه تسلّي مثابِ",18,"ب",1,0],["فقد شرطوا عند التناقض وحدة ال","زّمان فما استشكلته غير مشكل",19,"ل",1,0],["فَقَد شَرَّد الأَموال نَفياً كَأَنَّما","تَألّى يَميناً أَنَّها لا تُجاوِرُهُ",20,"ر",2,0],["فَقَد شفَّ مِن تَحتِ البَراقِعِ وجهها","كَما شَفَّ مِن تَحتِ الجَهامَةِ كَوكَبُ",21,"ب",1,0],["فقد شتّ شمل الدين بعد اجتماعهِ","وربع الندى أضحت خلاءً منازله",22,"ل",2,0],["فقد شكّ ربُّ الكلام البليغ","أيكسد عندك أم يَنفُقُ",23,"ق",1,0],["فقد شهِد المجدُ إلا شبيهاً","لفضلك فيهم وإلا قريعا",24,"ع",2,0],["فقد شنف الأسماع وقعُ رذاذه","وجرَّ ذيولاً من مطارفه الدُّكن",25,"ن",1,0],["فَقَدْ شَرعُوا في هَدْمِ شِرْعَةِ أحْمَدٍ","وأنْتَ لَها يا رَبِّ تَحْمِي وتنْصُرُ",26,"ر",1,0],["فقد شقُّوا بها القُمْصَ","وقد باعوا البَقَايير",27,"ر",1,0],["فقَد شُغِل الأَملاكُ عن شكرِ رَبِّهم","سوى أَنْتَ بالرَّيحانِ والرَّاح والنّقْلِ",28,"ل",1,0],["فقد شاد أعلام الشريعة واقتفى","بآثار آباء كرام المساعيا",29,"ي",2,0],["فقد شرع الله اتباع محمد","وإخوانه والله أعدل حاكم",30,"م",1,0],["فقد شَهدَت غُر القصائِدِ أنَّني","فِرزدَقُها إن حُصِّلت وجَريرُها",31,"ر",3,0],["فقد شَمِطتْ ذَوائبُها وليستْ","على أمرٍ سِوى فَتلِ العِقاص",32,"ص",1,0],["فقد شيّبتْ هذي البُشُرَّاتُ مفرقي","وسنّي كما تدرون سنُّ غُلامِ",33,"م",1,0],["فَقَد شَرقت شمسُ اليقينِ وخلّفت","بروق رجونا نفعها ورعودُ",34,"د",1,0],["فَقَد شاقَني مِن نَحو طيبَةَ بارِقٌ","يُنَسّي مَشُوق الروح ما قَد تَعوّدا",35,"د",2,0],["فَقَد شفّ قَلبي بعدَ طولِ تجلّدي","أَحاديث مِن يَحيى تُشيبُ النواصِيا",36,"ي",2,0],["فَقَد شَقِيت رُكبانُ بَكرِ بنِ وائِلٍ","وَصُبَّ عَلَيهِنَّ الجُرافُ المُجَرَّفُ",37,"ف",1,0],["فقد شكر الإسلام منك مواقفاً","كشفت بها عن وجهه ظلمة الكفر",38,"ر",1,0],["فقد شربت بكاس من عتابكمو","حلو المذاق ولكن هاج لى كربى",39,"ب",2,0],["فقد شهرَتني مرّةً بعدَ مرّةٍ","وأبدَت برغمي خافيات سرائري",40,"ي",1,0],["فقد شملتنا من رضاك ملابس","وسح علينا من نداك معين",41,"ن",1,0],["فَقَد شَفى الغُلَّةَ مِن يوسُفٍ","بَعدَ طَويلِ الحُزنِ يَعقوبُ",42,"ب",1,0],["فقد شكر الرحمن سعيك فيهم","وعوضكم عن كل بيت بها قصرا",43,"ر",2,0],["فَقَد شَكى مِن دَقيق الدرز تاليما","نَشاط صَبوتِهِ يمشيه مبتدرا",44,"ر",2,0],["فقد شاع من ذكره في الأنام","سوى ما ضمن طي الكتب",45,"ب",1,0],["فقد شفعت إلى ما تبتغيه","لك الأقدار والفلك المدار",46,"ر",1,0],["فقد شرَّف الرحمنُ بالآيِ قبرَهُ","وأَتأَرَهُ بالمُعجِزات وأَيَّدا",47,"د",2,0],["فقد شامَ سيفَ النّصْرِ أَروعُ باسِلٌ","يهونُ عليه أن يُصيبَ العِدا وِتْر",48,"ر",1,0],["فقد شابَ زنجيُّ الدجى حين أشْرَقَتْ","على عَنْبرِ الظلماءِ كافورةُ الفَجْرِ",49,"ر",1,0],["فَقَد شاهدت عَيناي بنتا جَميلة","وَدمعتها من عينها تَتَنازَل",50,"ل",1,0],["فقد شملتهمْ للسَّماح شمائلٌ","أميريةُ الأَعراق حفصيَّة النجر",51,"ر",1,0],["فقد شحذت شباكَ وأنت سيفٌ","وإن قطعت حشاكَ عليه إريا",52,"ي",2,0],["فقد شمت من تلقاء يثرب بارقاً","وقد طاب عيشى بالحبيب وأخصبا",53,"ب",2,0],["فقد شاقها للحمى شائق","فجدِّت لمغنى يقرِّ النزيل",54,"ل",1,0],["فقد شاركَتنا فيه كفُّك إِذ غَدت","عليه لنا عند العطاءِ تُعينُ",55,"ن",1,0],["فقد شفعت فيها وفي الناس باريس","فلا فرق في الدون والدون في القضا وأرّيسهم في الأمر والنهي أرَّيس",56,"س",1,0],["فَقَدْ شَاءَ قَلْبِي نِظَاماً بِصَرْحِي","وَمَا كُنْتُ أَدْرِي بِهَوْلِ انْحِدَارِي",57,"ر",2,0],["فَقَدْ شاهدتُ عَاطِفةً","قديماً ما شَهِدْناها",58,"ا",3,0],["فَقَدْ شَربت بِأَيديكُم كُؤوساً","تفيض بكل مر والسقام",59,"م",1,0],["فقد شتمت أعني قريشاً محمداً","فقالوا بصرف الله عنه مذمما",60,"م",2,0],["فقد شاع في غرب البلاد وشامها","وفي اليمن الميمون والسند والهند",61,"د",1,0],["فَقَدْ شَرَقَتْ شَمْسُ اليَقِينِ وَأَخْلَبَتْ","بُرُوقٌ رَجَوْنا نَفْعَها وَرُعُودُ",62,"د",1,0],["...فَقدْ شَدَّ الرِّحالَ إلى كريمٍ","وظلَّ بِما أشاعَ مِنَ البَهاءِ",63,"ا",2,0],["فقد شَبّهتُ حالكمو بحالي","كلانا في السقامِ مشى كسيرا",64,"ر",2,0],["فقد شَاقهُ الوعدُ ، يغدُو سرابًا","ودَربُ الوفَا في حِدادِ الظَّلَامِ",65,"م",1,0],["فقد شابَ جسمي بالشّباب وإنه","من الغمّ والداء العضال هزيلُ",66,"ل",1,0],["فقد شاختْ دروبٌ لا تؤدي","إلى حلمي وعقَّتني عقوقَا",67,"ق",2,0],["فقد شربتُ كؤوسَ الإنتظارِ ‘ وما","هلَََََّت حبيبةُ قلبي ، مُهجتى ،عُمُري",68,"ر",2,0]]}