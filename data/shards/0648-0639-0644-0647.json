{"poems":[[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[49,"وعلة لم تدع قلبا بلا ألم","https://www.aldiwan.net/poem25379.html","البسيط"],[79,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[302,"وسائل لي عن أشياء كيف أتت","https://www.aldiwan.net/poem33338.html","البسيط"],[438,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[447,"الصبر من كرم الأخلاق فاصطبر","https://www.aldiwan.net/poem14368.html","البسيط"],[458,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[458,"عصابة من لصوص أمنها خطر","https://www.aldiwan.net/poem61283.html","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112780","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79798","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108584","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27417","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27727","البسيط"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97988","المجتث"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110049","السريع"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81922","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81923","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58135","البسيط"],[3591,"أشد عوادي الدهر خلق لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=149432",""],[5282,"قالوا تغزل","https://www.poetsgate.com/ViewPoem.aspx?id=214653",""],[5626,"سهم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=189494",""],[6286,"وسائلٍ ليَ عن أشياءَ كيف أتت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27553&r=&rc=2",""]],"verses":[["وعِلّةُ هَذا الكوْنِ أنْتَ وكلّما","أعادَ فأنْتَ القصْدُ فيهِ وما أبْدى",0,"د",2,0],["وَعِلَّةٌ لِلبِغا مُحَلّلَةٌ","مَعاقِدَ الأُزرِ مِن وَرا النُقبِ",1,"ب",1,0],["وعله جائب ما أبصرا","في صور من أمهات القرى",2,"ر",2,0],["وَعِلَّةٍ لَم تَدَع قَلباً بِلا أَلَمٍ","سَرَت إِلى طَلَبِ العَليا وَغارِبَها",3,"ب",3,1],["وعلة هذا الكون أنت وكلما","أعاد فأنت القصد فيه وما أبدا",4,"د",2,0],["وعلَّةُ المَنعِ فيها عنده أَلِفُ الت","تأنيثِ وهوَ جَوابٌ فيه إِرضاءُ",5,"ا",2,0],["وعلَّةُ المَنعِ فيها أَنَّ آخرَها","مدٌّ كَما مُنِعت للمدِّ صَحراءُ",5,"ا",2,0],["وعلَّهُ في رماح الخطّ يمنعُها","من أنْ تُقاسَ بها أشكالُها القصَبُ",6,"ب",1,0],["وعلها رحمة في الحشر تنعشني","عن هوة الوزر شداداً بها أزري",7,"ر",2,0],["وعلها اليوم في ذكرى لثورتها","لا تكتفي بازدراء أو بنسيان",8,"ن",1,0],["وعلهم بالدم الغالي لأمتهم","يروون قدوة من ثاروا ومن ثأروا",9,"ر",3,0],["وَعِلَّةُ هَذا الكَونِ لَولاهُ ما سَمَت","سَماءٌ وَلا غاضَت طَوافِحُ طوفانِ",10,"ن",1,0],["وعله علم الخلائق كلهم","وضاعفه فيه بفضل ورحمة",11,"ه",1,0],["وعلة قامت كعلتين","في ألف التأنيث والجمعين",12,"ن",1,0],["وعلّة أطلق وللإنكار","والردف والإشباع والتذكار",12,"ر",1,0],["وعلَّةُ المرءِ أرى بُرءها","أرجى لذي العلَّةِ من خَلقه",13,"ق",2,0],["وعلة استعفاء صدر العلى","ما غادرت في العين غير السهاد",14,"د",1,0],["وعلة هذا الأمرِ أنْ ليس فاعلٌ","سواه وأنَّ الحقَّ بالحقِّ يفعل",15,"ل",1,0],["وعلة هذا أنهم جحدوا الذي","أتتهم به أرساله وتعللوا",15,"ل",3,0],["وعلة التكثير أحكامها","لأعيننا فكوننا كونه",16,"ه",1,0],["وعلة هذا الفرق تبدو بداهة","وفي جس نبض الملتين نراها",17,"ا",3,0],["وعله إن يردد","نغمائنا يله معنا",18,"ن",2,0],["وعِلَّةٌ عَلَّت فُؤَاداً ولم","يَظفَر ببُرءٍ داؤُها المُعضِلُ",19,"ل",1,0],["وَعَلَّها تُصدِّقُني","في سِرِّها وَالسَببِ",20,"ب",1,0],["وعلة توجد المعلول من عللٍ","واللّهُ يشهد والأملاك قد شهدوا",21,"د",3,0],["وعلة لوجود الخلق من عدمٍ","لولا تفضله في الخلق ما خلقا",22,"ق",2,0],["وعلةُ الذنبِ في أعضائه كمنَتْ","أنتَ الطبيبُ الذي تُبْرِي من السَّقَم",23,"م",1,0],["وعلة نكران الصنيعة أنه","عديمٌ من الحسنى لضيم عديم",24,"م",1,0],["وعِلَّةُ الصَبِ قد تَغتالُ مُهجَتَهُ","فالبوحُ خيرُ وفيه يُحمَدُ العَجَلُ",25,"ل",1,0],["وَعَلَّها بِمَسيرِ النَّجْمِ قَدْ حَظيَتْ","يَوْماً عَساها رأَتْ نَجْمَ دُنْياكِ",26,"ك",1,0],["وعلَّة ُ المَنعِ فيها عنده ألِفُ ال","تَّأنيثِ وهو جَوابٌ فيه إرضاءُ",27,"ا",2,0]]}