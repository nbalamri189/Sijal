8.html","السريع"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[15,"بان الخليط الؤولى شاقوك إذ شحطوا","https://www.aldiwan.net/poem45261.html","البسيط"],[8,"تذكرت والذكرى تهيج للفتى","https://www.aldiwan.net/poem21786.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85830","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141035",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39538","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30463","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199475","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117002","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[84,"ولرب حان قد أدرت بديره","https://www.poetsgate.com/ViewPoem.aspx?id=26328",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[45,"سَقَى رَبْعَها سَحُّ السّحابِ وَهَاطِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31871",""],[39,"إنَّ الفؤادَ هفَا للبائنِ الغردِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7469&r=&rc=9",""],[88,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[85,"قبرَ الوزيرِ، تحيَّة ً وسَلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9624&r=&rc=114",""],[92,"لا ينهضُ الشعبُ إلاَّ حينَ يدفعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14609&r=&rc=54",""]],"verses":[["وَأَلقى مِنَ الأَحبابِ ما لَو لَقيتُهُ","مِنَ الناسِ سَلَّطتُ الظُبى وَالعَوالِيا",0,"ي",2,0],["وَأَلقى عَلى بُعدٍ مِنَ الدارِ نَفحَةً","تَذُمُّ عَلى عَيني مِنَ الهَمَلانِ",1,"ن",1,0],["وَأَلقابُ قَومٍ إِذا بُرتَها","تَبايَنُ أَلفاظُها وَالمَعاني",2,"ي",1,0],["وَالقُربُ في الوُدِّ عَلى نَأيِنا","أَحسَنُ مِن قُربِ العِدا بِالجُسوم",3,"م",1,0],["وَالقَولُ يَعرِضُ كَالهِلالِ فَإِن مَشى","فيهِ الفَعالُ فَذاكَ بَدرُ تَمامِ",4,"م",1,0],["وَأَلقى التَحِيّاتِ مِن مَعشَرٍ","كَما اِرتَجَمَ الحَيُّ بِالجَندَلِ",5,"ل",1,0],["وَالقائِدُ الفَيلَقَ تَن","قادُ لَهُ القَبائِلُ",6,"ل",1,0],["وَالقاذِفُ النَفسِ في حَمراءَ إِن خَفِيَت","بِالنَقعِ نَمَّ عَلى ضَوضائِها الشَرَرُ",7,"ر",1,0],["وَالقائِدُ الخَيلَ يَمطو في أَعِنَّتَها","مَطوَ النَعامِ أَضَلَّتها القَراديدُ",8,"د",1,0],["وَأَلقَتْ قِناعَ الفَجرِ قَبلَ أَوانِهِ","فَهبَّ حَمامُ الأَيكِ وَهيَ هُجودُ",9,"د",1,0],["والقولُ إنْ لم يَقْرُنِ الفِعْلُ بهِ","تَصْديقَهُ فهْوَ الحديثُ المُفْتَرى",10,"ا",1,0],["والقارِحُ المُتَمَطّي في عُلالَتِهِ","يَشوبُ في الحُضْرِ تَصْعيداً بتَصْويبِ",11,"ب",1,0],["والقَدُّ منْ مَرَحِ الصِّبا مُتأوِّدٌ","والطَّرْفُ منْ تَرَفِ النّعيمِ عَليلُ",12,"ل",1,0],["والقِرْنُ يرْكَبُ رَدْعَهُ ثَمِلَ الخُطا","والأعْوَجيَّةُ بالجَماجِمِ تَعْثُرُ",13,"ر",1,0],["والقِرْنُ قَلقَلَ جأْشَهُ حَذَرُ الرّدى","فأُعيرَ نَفْرتَهُ النَّعامُ الجافِلُ",14,"ل",1,0],["وألْقِحِ الرّأيَ يُنتِجْ حادِثاً جَللاً","إنّ الحَوامِلَ قدْ همّتْ بإخْداجِ",15,"ج",1,0],["وألْقَى بمُسْتَنِّ الأيادي رِحالَهُ","فنَكَّبَ أذْراءَ الخَليطِ الأشائِبِ",16,"ب",1,0],["وَالقَومُ قَد آنوا وَكَلَّ مَطِيُّهُم","إِلّا مُواشِكَةَ النَجا بِالهَودَجِ",17,"ج",1,0],["والقوتُ قُلِّصَ للنّفادِ ظِلالُهُ","والأزْلُ قدْ شمَلَ النّفوسَ حِصارُهُ",18,"ر",2,0],["وألقَى بأخْلافِ الشِّياهِ يَمينَهُ","فجادَتْ بهِ وهْيَ الضّروعُ الشّحائِحُ",19,"ح",1,0],["وَالقارِحَ العَدّا وَكُلَّ طِمِرَّةٍ","ما إِن تَنالُ يَدُ الطَويلِ قَذالَها",20,"ل",3,0],["وَالقائِدُ الخَيلَ العِتا","قَ ضَوامِراً لُخنَ الأَياطِل",21,"ل",1,0],["وَالقَومُ في مِصرَ كَالإِسفِنجِ قَد ظَفِرَت","بِالماءِ لَم يَترُكوا ضَرعاً لِمُحتَلِبِ",22,"ب",1,0],["وَالقُطرُ في شَوقٍ لِأَندَلُسِيَّةٍ","شَوقِيَّةٍ تَشفيهِ مِن أَشجانِهِ",23,"ن",2,0],["وَالقَومُ بَينَ مُرَدَّعٍ بِدِمائِهِ","وَمُعَرَّدٍ بِذَمائِهِ مُنصاعِ",24,"ع",1,0],["وَأَلقى بِصَحراءِ الغَبيطِ بَعاعَهُ","نُزولَ اليَماني ذي العِيابِ المُخَوَّلِ",25,"ل",1,0],["وَأَلقى بِبَيسانَ مَعَ اللَيلِ بَركَهُ","فَأَنزَلَ مِنهُ العَصمَ مِن كُلِّ مَنزِلِ",25,"ل",1,0],["وَأَلقَحَ القَومُ حَرباً لَيسَ يُلقِحُها","إِلّا المَساعيرُ أَبناءُ المَساعيرِ",26,"ر",1,0],["والقوم إن صدقوا الهوى أيمانهم","فمرادهم أبد الأبيد مراد",27,"د",1,0],["وَأَلقوا دِرَاكاً بِكَاسَاتِهَا","تُهَاضُ وَلا تَعْصِمُوا دِنَّهَا",28,"ن",3,0],["وَالْقَائِمِينَ بِتَثْقِيفِ الْبَنِينَ عَلَى","أَجَلِّ مَا يُبْتَغَى تَثْقِيفُ فِتْيَانِ",29,"ن",1,0],["وَالقَوْلِ شَفَّ بِهِ الْقَرِي","بُ عَنِ الْبَعِيدِ مِنَ المَعَانِي",30,"ي",1,0],["وَالْقَوْمُ جَاثُونَ لَدَى حُسْنِهَا","سُجُودَ حُبٍّ صَادِقٍ وَاحْتِشَامْ",31,"م",1,0],["وَأَلْقَى رُكْبَتَيْهِ عَلَى صَعِيدٍ","يُمَازِجُ تُرْبَهُ الدَّمُ وَالحُطامُ",32,"م",1,0],["وَالقَ ابنَ مَروانَ الَّذِي قَد هَزَّهُ","عِرقُ المكَارِمِ والنَّدَى فَأَقَلَّهُ",33,"ل",2,0],["وَأَلقَ اِمرَءاً لا تَنتَحي بَينَ مالِهِ","وَبَينَ أَكُفِّ السائِلينَ المَعاذِرُ",34,"ر",1,0],["وَالقائِدَ الخَيلَ تَمطُو في أَعِنَّتِها","إِجذامَ سَيرٍ إِلى الأَعداءِ مُنجَرِدِ",35,"د",1,0],["وَأَلقوا لِأَحرارِ الوُجوهِ عَلى الحَصى","جَدائِلَ مَلوِيّاً بِهِنَّ السَواعِدُ",36,"د",1,0],["وَالقِنعَ أَصلالاً وَأَيكا أَحصَدا","حَتّى إِذا شَمَّ الصَبا وَأَبرَدا",37,"د",2,0],["وَالقُرطُ فُي حُرّةِ الذِفرى مُعَلَّقُهُ","تَباعَدَ الحَبلُ مِنهُ فَهوَ يَضطَرِبُ",38,"ب",1,0],["والقضبُ مالتْ للعناق كأنها","وفد الأحبة قادمين من السَفَرْ",39,"ر",1,0],["والقادسية عن سعد مِحدثة","يقتل رستم ربّ العسكر الجِب",40,"ب",1,0],["وألقت جُيوش الفاخرين سلاحها","إذا خفقت راياتها بالمفاخر",41,"ر",1,0],["وألْقِيه بصدريَ وأنظريني","ترىْ قلبي الجريح به ندوب",42,"ب",1,0],["وَالقَومُ فَوقَ يَعمَلاتٍ شُدقِ","إِذا تَبارَينَ بِسَيرٍ دَفقِ",43,"ق",1,0],["وَالقِدرُ تَنهِمُ بِالمَحالِ وَتَرتَمي","بِالزَورِ هَمهَمَةَ الحِصانِ الأَدهَمِ",44,"م",1,0],["وَأَلقى تَكَنّيهِ الشُجاعُ اِستِكانَةً","مِنَ الجوعِ صُمتاً لا يُمِرُّ وَلا يُحلي",45,"ل",2,0],["وألقِي فِضَالَ الشَّكِ عَنكِ بِتَوبَةٍ","حَوَارِيَّةٍ قَد طَالَ هَذَا التَفَضُّلُ",46,"ل",1,0],["وألقَيتُم إِليَّ دِلاَءَ قَوم","بِمَا رَفَعَت دِلاَؤُكُمُ عَمِينَا",47,"ن",2,0],["وَالقَومُ خَلفَكَ قَد تَرَكتَ قِتالَهُم","تَرجو الجَناءَ فَلَيسَ حينَ ذَهابِ",48,"ب",1,0],["وَالقَومُ إِن نَزَروا فَزِد في نَزرِهِم","لا تَقعُدَنَّ خِلالَهُم تَتَسَمَّعُ",49,"ع",1,0],["وَأَلقوا رَمَدَ الكيرِ يَعرِفُ وَسطَكُم","لَدى مَجلِسٍ مِنكُم لَئيمٍ وَمَفجَعِ",50,"ع",1,0],["والقابلين بجودِهم سِلعَ الثنا","فإلى سوى أبوابهِم لا تجلب",51,"ب",1,0],["وألقي به ثوبَ المشيب مطبقاً","فأغسله بالدمعِ والطبعُ أغلب",52,"ب",1,0],["والقائل الكلمات يقدر قدرها","سوَر الكلام كأنهنَّ فواتح",53,"ح",1,0],["والقول من مسند سحبانهِ","والفعل من مسند حمَّاد",54,"د",1,0],["والقهُ للعلومِ أو للعطايا","تلقى ملكاً يقري الضيوف ويقري",55,"ي",1,0],["والقضب تخفض للسلام رؤوسها","والزهر يرفع زائريه على الحدق",56,"ق",1,0],["والْقَ منه الصَّفا فما هو ممَّن","يتولى عن مادحيه بركنه",57,"ه",1,0],["والقلب قد أشكر الله الحبيب بهِ","فما الملام على حالي بمخليه",58,"ي",2,0],["والقومُ لاقَوْكَ فأعْدِدْ لهم","ما يَرْتضي الآكِلُ والشاربُ",59,"ب",1,0],["وألقتْ جُنحَ مغْربها شُعاعاً","مريضاً مثل ألحاظ الكَعابِ",60,"ب",1,0],["والقراطيسُ خافقاتٌ بأيْدِي","هِمْ كمرْهُوبِ خافقاتِ البُنُودِ",61,"د",1,0],["والقحطبي إذا غناك مرتجلاً","فقل خريت وقم عن مُطَّلٍ بخر",62,"ر",1,0],["والقَسُّ فيّالي فكم","أكسبتُهُ جَذرا وجُدرا",63,"ر",2,0],["وألقاك مهزوزاً به وكأنما","ألاقيكَ مشحُوذاً عليَّ مُحرَّضا",64,"ض",2,0],["والقوافي الغِضابُ يفعلن في الأع","راض فعلَ السهام في الأغراض",65,"ض",1,0],["والقوافي إذا طلبنك يوماً","غيرُ ما معجزٍ لهن لَحاقُك",66,"ك",1,0],["والقول ما أنيكَهُ","أحسنُ من ما أنوكهْ",67,"ك",2,0],["والقوافي يشهدْنَ لي صادقاتٍ","باضطلاعي بهن واستقلالي",68,"ل",2,0],["والقناطيرُ لا تَصِلُّ ولكنْ","منعها الحقَّ أيُّما اسْتذمام",69,"م",1,0],["والقربِ منك لقد غشَّشتَ مُنتصحاً","مِنْ محضَري ولقد خَوَّنتَ مؤتَمنا",70,"ن",2,0],["وَالقَومُ تَختَلِفُ الأَسِنَّةُ بَينَهُم","يَكبونَ بَينَ سَوافِلٍ وَعَوالِ",71,"ل",1,0],["وَالقَومُ زَأرُهُمُ وَأَعلى صَوتِهِم","تَحتَ السُيوفِ غَماغِمٌ وَهَريرُ",72,"ر",1,0],["وَأَلقَت إِلَيكَ مَقاليدَها","نُفوسٌ تَخَيَّرَتِ الأَنسُبا",73,"ب",2,0],["وَأُلقي إِلَيها السَمعَ ما طالَ هَمسُها","كَذَلِكَ يَستَرعي الأَذانُ المُوَحَّدا",74,"د",2,0],["وَالقَناني صُوَرٌ باهِتَةٌ","وَالأَغاني عالَمٌ مُندَثِرُ",75,"ر",1,0],["وَالقَومُ واجِفَةٌ قُلوبُهُمُ","قَلَقاً كَأَنَّهُم عَلى الجَمرِ",76,"ر",1,0],["وَالقَومُ في لَهو وَفي طَرَبٍ","يَتَناشَدونَ أَطايِبَ الشِعرِ",76,"ر",1,0],["وَأَلقَت عَلَيهِ الشَمسُ نَظرَةَ عاشِقٍ","غَيورٍ تَلَقّاها بِنَظرَةِ مُشفِقِ",77,"ق",1,0],["وَالقُنوطَ الَّذي يُعَرّي مِنَ الأَو","راقِ في نَشوَةِ الرَبيعِ الغُصونا",78,"ن",2,0],["والقَيْدُ يأْلَفُهُ الأَمْواتُ مَا لَبِثُوا","أَمَّا الحَيَاةُ فيُبْلِيها وتُبْليهِ",79,"ي",2,0],["والقويُّ الظَّلومُ يَعْصِرُ مِنْ","آلامها السُّودِ لَذَّةً ومُدَاما",80,"ا",1,0],["والقَضَاءُ الأَصَمُّ يَعْتَسِفُ النَّاسَ","ويقضي مَا بَيْنَ سَيْفٍ وقَوْسِ",81,"س",1,0],["وأَلقى عليها الأَسَى ثَوْبَهُ","وأَقبرَها الصَّمْتُ والإكْتِئابْ",82,"ب",1,0],["والقتل من اجل الحيا","ة بكل ارض مستحر",83,"ر",1,0],["والقيد خلخالا لمن","يشقى به والغل عقدا",84,"د",2,0],["وألقِ سِبال ذقنك فيه وأنشق","تراب الساحة الكبرى ذكيا",85,"ي",2,0],["والقيد لو كان الجما","ن منظما لم يحمل",86,"ل",1,0],["وألقى النازلات بحدّ عزم","يفل النازلات ولا يفل",87,"ل",1,0],["والقَ ما شئت من حفاوة شمس","تُكبر الشمس عرشها إكبارا",88,"ر",2,0],["والقوم في مصر ما طافوا بملعبها","إلا كما شهد الغر الروايات",89,"ت",1,0],["والقلب ما بينهما حائر","من بلدة يسرى إلى بلدة",90,"ه",1,0],["والقصر نور وآفاق الوجود سنا","والصفو بينهما زهو لمرتقب",91,"ب",1,0],["والقلب مخفوض الجنا","ح يهيم فيه على جناك",92,"ك",1,0],["والقلب قوّام على أضلعي","كأنه الناقوس في الهيكل",93,"ل",1,0],["وَأَلقاكَ بِإِخوانٍ","يُدانونَكَ في السِنِّ",94,"ن",1,0],["وَالقِطُّ بَينَ يَدَيهِ","يَلهو بِعَظمَةِ فارِ",95,"ر",1,0],["وَالقَومُ حَولَكَ يا اِبنَ غالي خُشَّعٌ","يَقضونَ حَقّاً واجِباً وَذِماما",96,"م",2,0],["وَأَلقى عَلى الرَملِ أَرواقَهُ","وَأَرسى عَلى الأَرضِ أَثقالَها",97,"ل",3,0],["وَأَلقَت بِهِم في غِمارِ الخُطوبِ","فَخاضوا الخُطوبَ وَأَهوالَها",97,"ل",3,0],["وَأَلقى رِقاباً إِلى الضارِبي","نَ وَضَنَّ بِأُخرى فَلَم تُضرَبِ",98,"ب",1,0],["وَالقَولُ إِن عَفَّ أَو ساءَت مَواقِعُهُ","صَدى السَريرَةِ وَالآدابِ يَحكيها",99,"ي",3,0],["وَالقُصورُ مَسرَحُها","لا الرِمالُ وَالعُشُبُ",100,"ب",1,0],["وَالقَلبُ لا يَنشَقُّ عَمّا تَحتَهُ","حَتّى تَحُلَّ بِهِ لَكَ الشَحناءُ",101,"ا",2,0],["وَأَلقى الفَمَ الضَحّاكَ أَعلَمُ أَنَّهُ","قَريبٌ بِذي الكَفِّ المُفَدّاةِ عَهدُهُ",102,"د",2,0],["وَالقَومُ في أَعيانِهِم خَزَرٌ","وَالخَيلُ في أَعيانِها قَبَلُ",103,"ل",1,0],["وَأَلقى الشَرقُ مِنها في ثِيابي","دَنانيراً تَفِرُّ مِنَ البَنانِ",104,"ن",1,0],["وَالقَومُ خَرقى ما تُطُلِّبَ رُشدُهُم","وَأُديرَ أَمرُهُم بِعَزمَةِ أَخرَقِ",105,"ق",1,0],["وَأَلقَيتُ أَمري في مُهِمٍ أُمورِهِ","لِيَحمِلَ رَضوى ماتَعَمَّدَ كاهِلُه",106,"ل",2,0],["وَالقائِدونَ إِذا الجِيادُ تَرَوَّحَت","وَمَضَينَ بَعدَ وَجىً عَلى الحِزوارِ",107,"ر",1,0],["وَالقائِلُ الفاعِلُ المَيمونُ طائِرُهُ","وَالمانِعُ الضَيمَ أَن يَدنو إِلى الجارِ",108,"ر",1,0],["وَالقَومُ لَو بادَروكَ المَجدَ لَاِعتَرَفوا","عَلَيهِمُ في يَدَيكَ الشَمسَ وَالقَمَرا",109,"ر",2,0],["وَأَلقَيتُ عَن ظَهرَيهِما شِملَتَيهِما","بِأَردِيَةِ العَصبِ اليَماني المُلَفَّقِ",110,"ق",1,0],["وَأَلقَيتَ مِن كَفَّيكَ حَبلَ جَماعَةٍ","وَطاعَةَ مَهدِيٍّ خَديدِ النَقائِمِ",111,"م",1,0],["والقرن عنه مول وجهه أبدا","كأنه عن طلاب الثأر مشغول",112,"ل",1,0],["وألقاكَ بالبِشْرِ الجميلِ مُداهِناً","فَلي منكَ خُلٌّ ما عَلِمْتُ مُداهِنُ",113,"ن",1,0],["وَالْقَ الهوَى غضَّاً بفِطرِك والمُنى","مجموعةً لك والسُّرور مُتمَّما",114,"م",2,0],["والقصرُ يَبسِمُ في وَجهِ الضُّحىفتَرى","وجهَ الضُّحى عندما أبدى لنا شَحَبا",115,"ب",2,0],["وَاَلقَ عَدُوَّكَ بِالتَحِيَةِ لا تَكُن","مِنهُ زَمانَكَ خائِفاً تَتَرَقَّبُ",116,"ب",1,0],["وَأَلقَيتَ جِلبابَ الحَيا عَنكَ ضِلَّةً","فَأَصبَحتَ مُختالاً فَخوراً وَأَمسَيتا",117,"ت",2,0],["وَالقَولُ أَبلَغُهُ ما كانَ أَصدَقَهُ","وَالصِدقُ في مَوقِفٍ مُستَسهَلٍ عالِ",118,"ل",1,0],["وَأَلقَت عَلى الضِد","دِ قَولاً ثَقيل",119,"ل",1,0],["وَالقُضبُ مالَت لِسَجعِها طَرَباً","وَنَحنُ مِنها أَحَقُّ بِالطَرَبِ",120,"ب",1,0],["وَأَلقى الشُعاعُ عَلى الجَدوَلِ","مِلاءً مِنَ التِبرِ",121,"ر",1,0],["وَالقُضبُ دانِيَةٌ عَلَيَّ ظِلالُها","وَالزَهرُ تاجاتٌ عَلى هامَتِها",122,"ت",3,0],["وَالقُبَّةُ العَلياءُ وَالطَيرُ الَّذي","مِن حَولِهِ راياتُ نَصرٍ تَخفُقُ",123,"ق",1,0],["وَاِلقَ العَدُوَّ بِجَأشٍ غَيرِ مُحتَرِسٍ","مِنَ المَنايا وَجَيشٍ غَيرَ مُحتَرِزِ",124,"ز",1,0],["والقوم أهل والقرى","وطن عطوف والمدن",125,"ن",1,0],["وألْقَتْ حُلاها من يديها وعَطّلَتْ","من الحلي فيه جيدَ رئم تَشَوّفا",126,"ف",2,0],["وَأَلقاهُ بِلَطمٍ يَه","تِكُ الأَبصارَ وَالسَمعا",127,"ع",2,0],["وَالقَهوَةُ الصَهباءُ ظَلَّت تُستَقى","مِن طَيِّباتِ المُجتَنى وَحَلالِهِ",128,"ل",2,0],["وَأَلقى بَياضَ الصُبحِ يَسوَدُّ وَحشَةً","فَأَحسِبُني أُمسي عَلى حينَ أُصبِحُ",129,"ح",1,0],["وَأَلقَت إِلَيهِ بِالمَقادَةِ قادَةٌ","تَطامَنَ مِن أَعناقِها ماتَرَفَّعا",130,"ع",2,0],["وَأَلقى مِنَ الحُبِّ المُبَرِّحِ سَورَةً","لَها بَينَ جِلدي وَالعِظامِ دَبيبُ",131,"ب",1,0],["وَأَلقى مِنَ الحُبِّ المُبَرِّحِ لَوعَةً","لَها بَينَ جِلدي وَالعِظامِ دَبيبُ",132,"ب",1,0],["والقومُ إن عَصَفتْ بهم أهواؤُهم","هَفَتِ العقولُ وطاشتِ الأحلامُ",133,"م",1,0],["والقولُ مُستلَبُ المحاسنِ عاطلٌ","حتّى يقولَ العبقريُّ المُفلِقُ",134,"ق",1,0],["والقاذفاتُ من الجحيم صواعقاً","هي للممالكِ والشُّعوبُ حصادُ",135,"د",1,0],["وَالقَ الخَليفَةَ قَد تَهَلَّلَ وَجهُهُ","بِشراً وَخَفَّ إِلَيكَ وَهوَ رَصينُ",136,"ن",1,0],["وألقَى بصاعقةٍ تستطير","على جَانِبَيْها بُروقُ الشَّرَرْ",137,"ر",1,0],["وألْقَوْا بالسِّلاحِ وما أصابوا","من الأموالِ جَمعاً واكتسابا",138,"ب",2,0],["وألقَى بالشَّهيدِ فَغيَّبتْهُ","طَباقُ الأرضِ كَنزاً من لآلِ",139,"ل",1,0],["والقفر أكرم لا يغيض عطاؤه","حينا .. ويصغي للوشاة فينضب",140,"ب",1,0],["والقفر أصدق من خليل وده","متغير .. متلون .. متذبذب",140,"ب",1,0],["وَالقَلبُ يَرغَبُ أن يُصَيَّر سَاعِداً","لِيَفُوزَ بِالآمَالِ مِن ضَمَّاتِهِ",141,"ت",2,0],["وَأَلقَينا بِساحَتِها حُلولاً","حُلولاً للإِقامَةِ ما بَقينا",142,"ن",2,0],["وَأَلقَينا الرِماحَ وَكانَ ضَربٌ","يُكَبُّ عَلى الوجوهِ الدارِعينا",142,"ن",2,0],["وَالقَينُ لَم يَبقَ مِنهُ عِندَ كَبرَتِهِ","إِلّا كَما أَبقَتِ الأَيّامُ مِن لُبَدِ",143,"د",1,0],["وَالقَينُ إِن يَلقَ مِن أَيّامِهِ عنتاً","يَسقُط بِهِ الأَمرُ في مُستَحكِمِ السَنَدِ",143,"د",1,0],["وَالقَيضَ أَجنُبُهُ كَأَنَّ حُطامَهُ","فِلَقُ الحَواجِلِ شافَهُنَّ الموقِدُ",144,"د",1,0],["وَأَلقَت سِباطاً راشِفاتٍ كَأَنَّها","مِنَ السِبتِ أَسماطٌ دِقاقٌ خُصورُها",145,"ر",3,0],["وَالقُبَّةُ العَلياءُ وَالأُترُجَّه","مَلَكَ فيها أَربَعينَ حِجَّه",146,"ه",1,0],["وَالقَرمَطِيّونَ ذَوُو الآجامِ","صَغَوا فَقَد باؤوا مَعَ الآثامِ",146,"م",1,0],["وَالقَومُ مِن مُستَيقِظٍ نَشوانِ","أَو غَرِقٍ في نَومِهِ وَسنانِ",147,"ن",1,0],["والقُبةُ البَيضاءُ طائِرَةٌ بهِ","تَهوي بمُنخَرقِ الصَّبا أعنانُها",148,"ن",3,0],["والقوافي كالمطايا لمْ تَكُنْ","تَنبري إذ تنتحي إلاّ بِحاد",149,"د",1,0],["وَالقَومُ إِخوانُ صِدقٍ بَينَهُم نَسَبٌ","مِنَ المَوَدَّةِ ما يَرقى لَهُ نَسَبُ",150,"ب",1,0],["وَأَلقَيتُ عَنّي ثِيابَ الهُدى","وَخُضتُ بُحوراً مِنَ المِنكَرِ",151,"ر",1,0],["وَالقَلبُ قَلبُ مُعَنّىً","وَالجِسمُ جِسمٌ عَليلُ",152,"ل",1,0],["وَالقُرطُ في مَهلوكَةٍ","مَجراهُ مِن جَبَلٍ بَعيدُ",153,"د",1,0],["وَالقَلبُ عِندَكِ مَأخوذٌ مَسامِعُهُ","فَلا يُرَوِّعُهُ مَن قامَ أَو قَعَدا",154,"د",2,0],["وَاِلقَ مَن قَد ذاقَ فيما لَم يَذُق","لا يُداوي السُقمَ إِلّا مَن يَطِب",155,"ب",1,0],["وَالقَولُ كَالخَلقِ مِن سَيءٍ وَمِن حَسَنٍ","وَالناسُ كَالدَهرِ مِن نورٍ وَظَلماءِ",156,"م",3,0],["وَأَلقى عَلى الأَرضِ الفَراقِدَ فَاِرتَعَت","مَعَ الفَرقَدِ الوَحشيِّ تَرتَقِبُ الأَلبا",157,"ب",2,0],["وَأَلقَيتُ الفَصاحَةَ عَن لِساني","مُسَلَّمَةً إِلى العُربِ اللُبابِ",158,"ب",1,0],["وَأَلقاكَ فيها والِداكَ فَلا تَضَع","بِها وَلَداً يَلقى الشَدائِدَ وَالنُكرا",159,"ر",2,0],["وَالقَلبُ يَغرى بِما تُهدي الرِياحُ لَهُ","كَحَملِها الريحَ مِن زَيدٍ إِلى عُمَرا",160,"ر",2,0],["وَالقَولُ يُوَجِعُ وَالعِتابُ ضَغينَةٌ","وَالهَجرُ مُشتَقٌّ عَنِ الإِهجارِ",161,"ر",1,0],["وَالقَومُ شُرٌّ فَلا يَسرُركَ إِن بَسَطوا","لَكَ الوُجوهَ وَلا يُحزِنكَ إِن عَبَسوا",162,"س",3,0],["وَأَلقى إِلَيَّ اللُبَّ عَهداً حَفِظتُهُ","وَخالَفتُهُ غَيرَ المَلولِ وَلا الناسي",163,"ي",1,0],["وَالقَوتُ فيها لَنا مُباحٌ","لَو أَنَّهُ مِن دَمٍ عَبيطُ",164,"ط",1,0],["وَالقَولُ إِن يَبقَ يُحسَبُ لِلفَتى أَثَراً","فَلا تَشينَنكَ بَعدَ المَوتِ أَقوالُ",165,"ل",1,0],["وَأَلقَتكَ عَن جَهدٍ وَأَلقاكَ لِذَّةً","وَضَمَّت وَشَمَّت مِثلَما ضَمَّ أَو شَمّا",166,"م",2,0],["وَآلُ قابوسَ أَهلُ مَملَكَةٍ","حامِلَةٍ رَفدَها رَعاشِنُها",167,"ن",3,0],["وَالقَومُ يَردونَ مَن لاقَوا بِأَردِيَةٍ","أَعلامُها الدَمُ لَم تُكفَف حَواشيها",168,"ي",3,0],["وَأَلقَت هَذِهِ الأَيّامُ عِلماً","إِلَيكَ فَلَم تُصادِفُ مِنكَ وَعيا",169,"ع",3,0],["والقَلْبُ مِنْ أهوائِهِ عابِدٌ","ما يَعْبُدُ الكافرُ من بُدّهِ",170,"د",2,0],["والقائِديهَا مع الأضيافِ تتْبعُها","أُلاّفُها وأُلوفُ اللأمِ والبِدَرِ",171,"ر",1,0],["وألْقى الموْتَ لم تَخِدِ المَطايا","بحاجاتي ولم تَجِفِ الجِيادُ",172,"د",1,0],["وَالقَرارُ بَطنُهُ غَدَقٌ","زَيَّنَت جَلهاتِهِ أَكَمُه",173,"م",2,0],["وَالقائِلو الفَصلِ لا تَنآدُ طينَتُهُم","وَما لِقَولِهِمُ خَلفٌ وَلا مَيَطُ",174,"ط",1,0],["وَأُلقي عَلى جِيرانِها مَسحةَ الهَوى","وَإِن لَم يَكُونُوا لي قَبيلاً وَمَعشَرا",175,"ر",2,0],["والقول بالآجال فهي","إذا أتت بطل الحذر",176,"ر",1,0],["وَالقَلب منيَ كأس","للبين فيها صدوع",177,"ع",1,0],["وَالقحف بعد المخّ قد أَبلى الثرى","أَجزاءه صدف من الأصداف",178,"ف",1,0],["والقمر الفضيُّ بين الغيوم","يخفق كالمنديل عند الوداع",179,"ع",1,0],["والقوم في أعيانهم خزرٌ","والخيل في أعناقها قبل",180,"ل",1,0],["والقلبُ في كفِّ القضاءِ فراشةٌ","رفّافةٌ والعمر وشكَ نفَاد",181,"د",1,0],["والقمرُ الطالع الصغيرُ","أزاح عن وجهه السّحابا",182,"ب",2,0],["وألقتْ بأنداءِ الصباحِ شفاهُها","على قدميكَ العذبَ من قُبلاتِها",183,"ت",3,0],["والقادسيّةُ أدّتْها إلى نَفَرٍ","طافوا بها فأناخوها بجَعْجاعِ",184,"ع",1,0],["والقوْمُ كالأنْعامِ إنْ عوتِبُوا","تَسْمَعُ ما قِيلَ ولا تَفْهَمُ",185,"م",1,0],["وألْقَيْنَ لي دُرّاً فلما عدَدْتُه","غِنىً مسَختْه شِقوَةُ الجَدّ أدمُعي",186,"ع",2,0],["وَالقَلبُ ما بَينَهُما حائِرٌ","مِن بَلدَةِ أَسرى إِلى بَلدَةِ",187,"ه",1,0],["والقسُّ ممَّا شاءَ طُولَ مُقامنا","يدعو يُعَوِّذ حَوْلَنا بِزَبُورِه",188,"ر",2,0],["والقَوْمُ قد أَمنُوا تغيُّرَ حُسْنِها","فَتَعَمَّمُوا بجَمالِها وتأَزَّرُوا",189,"ر",3,0],["والقَصْرُ قَصْرُ بَني أُمَيّةَ وافِرٌ","من كُلِّ أَمْر والخِلافةُ أَوْفَرُ",189,"ر",1,0],["وَالقُطْنُ بَيْنَ مُلَوِّزٍ وَمُنَوِّرٍ","كَالْغادَةِ ازْدَانَتْ بِأَنْوَاعِ الْحُلَى",190,"ا",1,0],["وَالقَائِمِينَ الجَاثِمِينَ","وَمَنْ يَكُرُّ وَمَنْ يَهُمّْ",191,"م",1,0],["وَالْقَاطِرَاتُ بِهَا نَشِي","شٌ لِلتَّحَرُّكِ وَاصْطِخَابُ",192,"ب",1,0],["وَالْقَوْلُ عِيٌّ إِلَيْهِ","تَقَاصُرُ الْفَهْمِ لاَجِي",193,"ي",1,0],["وَالقَضَاءُ الرَّفِيعُ يَصْدُرُ عَنْ رَأْيٍٍ","حَصِيفٍ وَعَنْ تقىً وَعَفافِ",194,"ف",1,0],["وَأَلْقَتْ بِسَمْعٍ ظِلاَلُ الريَا","ضِ لِنَجْوَى قُلوبٍ بِهِنَّ تُطِيفْ",195,"ف",1,0],["وَالْقِ قَدَّمَتْ يَداكَ مِنَ الْخيْرِ","فَعِنْدَ الرِّحْمَنِ خَيْرُ الجَزَاءِ",196,"ا",2,0],["وَالْقُطْنُ مُوفٍ ضَاحِكٌ بِبَياضِهِ","وَصَفَائِهِ مِنْ كُدْرَةِ الْغَبْرَاءِ",197,"ا",2,0],["وَالقَوْمُ فِي ظَمَإ وَوَعْدُكَ مُطْمِعٌ","لَكِنْ يَرَوْنَ لَهُ رَفِيف الآلِ",198,"ل",1,0],["وَأَلْقَتْ بِآدَمٍ فِي السَّرِيرِ","لاِجْتِرَاحِ الْكُبْرَى مِنَ المُعْجِزَاتِ",199,"ت",1,0],["وَالقَلِيلُ النَّزْرُ فِي الأَزْمَةِ مَنْ","خَانَهُ الصَّبْرُ وَجَافاهُ الثَّبَاتُ",200,"ت",1,0],["والقفر أكرم لايفيض عطاؤه","حينا .. ويصغي للوشاة فينضب",201,"ب",1,0],["وَالقَيرَوانُ حِمى أَبيكَ وَما نَأى","إِلّا وَربعُ القَيرَوانُ دَرِيسُ",202,"س",1,0],["والقَهم مِنكَ بِبِشرٍ ثُمَّ كُن","لِلذِي تَسمَعُ مِنهُم مُغتَفِر",203,"ر",1,0],["والقُطُرُ يهتفُ أن يعيشَ فؤادُهُ","والشَّعْبُ يجهَرُ بالدعاءِ وَيَجأَر",204,"ر",1,0],["والقلبُ بعدك لجَّ في خفقانه","فمن الطَّبيبُ لقلبيَ الخفَّاق؟",205,"ق",1,0],["والقوم أفواههم في الحفل فاغرةٌ","وأنت أثبتُ وَسْطَ الحفل من جبل",206,"ل",1,0],["والقس مما شاء طول مقامنا","يدعو بعود حولنا بزبوره",207,"ر",2,0],["والقانعينَ مِن الحياة رخيَّةً","بلُماظَةٍ ، ومن الكَرى بغرِار",208,"ر",1,0],["والقوافي يَلَذُّها السَمْعُ من دونِ","قوافٍ تشدو بحسن سواك",209,"ك",1,0],["وألقتْ عليها الغيومُ اللطافُ","نَسْجاً كعهدِ الغواني وهى",210,"ا",1,0],["وأُلقِيَ ذاكَ التُّراثُ العظيمُ","لِثقلِ التّراب وضغطِ الحَجر",211,"ر",1,0],["والقول ما نَّمقْتَ ، والشعر الذي","يوحي إليك ، فصاحةٌ وبيان",212,"ن",1,0],["و\" القُرَيَّاتُ \" كالعرائس تُجْلى","كلَّ آنٍ تلوحُ في جِلباب",213,"ب",1,0],["وألقَيْتُ أمْرِي في مُهِمّ أُمُورِهِ،","ليَحمِلَ رَضْوَى ما تَغَمّدَ كاهِلُهْ",214,"ل",2,0],["والقَيْنُ إِنْ يَلْقَ منْ أيَّامِهِ عَنَتاً","يسقطْ بهِ الأمرُ في مستحكمِ العقدِ",215,"د",1,0],["وألقيتُ في غير المديح المَراسيا","وقلتُ أعصني يا شعرُ في المدح إنني",216,"ي",1,0],["والقومُ حَوْلَكَ يا بن غالي خُشَّعٌ","يقضونَ حقّاً واجباً وذماما",217,"م",2,0],["والقيدُ يأَلَفُهُ الأمواتُ، ما لَبِثوا","أمَّا الحيَاة ُ فيُبْلها وتُبْليهِ",218,"ي",2,0]]}