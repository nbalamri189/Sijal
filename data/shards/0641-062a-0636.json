tps://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5493,"أمي غادرتُها","https://www.poetsgate.com/ViewPoem.aspx?id=197573",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5736,"وطني المسجى في غياهب حزنه","https://www.poetsgate.com/ViewPoem.aspx?id=208183",""],[5736,"محراب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208492",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[5943,"الضاد تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=34803",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[6177,"رَجْعُ الغِياَب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79067&r=&rc=14",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""]],"verses":[["فتضاءَلَتْ كُوَرُ الجِبالِ لِفَقْدِهِ","غُبْرَ الفِجاجِ خَواشِعَ الأعْلامِ",0,"م",1,0],["فَتَضاحَكَت عَجَباً وَقالَت يا فَتى","لا خَيرَ فيكَ كَأَنَّها لَم تَحفِلِ",1,"ل",1,0],["فَتَضَعضَعَ النِسوانُ وَال","نِسوانُ لَيسَ لَهُنَّ مُنَّه",2,"ن",2,0],["فَتَضَيَّفا ماءً بِدَحلٍ ساكِناً","يَستَنُّ فَوقَ سَراتِهِ العُلجومُ",3,"م",1,0],["فتضاحكْنَ هازئاتٍ وماذا","يُونِقُ البِيضَ من سوادٍ جَليبِ",4,"ب",1,0],["فَتُضحي جزوعاً إن أصابتْ مصيبةٌ","وتُمسي هلوعاً إن تَعذَّرَ مَطلبُ",5,"ب",1,0],["فَتَضايَقَ قَلبي وَاِضطَرَبا","وَاِرتَجَّت روحي في صَدري",6,"ي",1,0],["فَتَضايَقَ القَلبُ السَجينُ وَقالَ لي","يا أَيُّها الجاني قَتَلتَ هَيامي",7,"م",2,0],["فتضاحكَتْ خَجَلاً وقالتْ يا فَتى","لَوْ لَمْ أَدْعكَ تَنَامُ بِي لَمْ تَحْلُمِ",8,"م",1,0],["فتضرَّجَتْ تلك البِطاحُ به دماً","وتضرَّمَتْ تلك الفِجاجُ حَريقا",9,"ق",2,0],["فَتَضاحَكنَ وَقَد قُلنَ لَها","حَسَنٌ في كُلِّ عَينٍ مَن تَوَد",10,"د",1,0],["فتضربهم ما دام للسيف قائم","وتطعنهم ما دام للرمح عامل",11,"ل",1,0],["فَتُضحي مِنَ المَردِ مَردِيَّةً","وَتُمسي مِنَ الرَدى مَردِيَّه",12,"د",3,0],["فَتَضْرِبَ ضَرْبَةً يَسْمُو إليها","حَدِيثُ القَوْمِ في الرُّفقِ العجالِ",13,"ل",1,0],["فَتَضَاحَكْنَ مِنْ مَقَالَةِ هِنْدِ","وَتَمَايَلْنَ عَنْ أَفَانِينَ رَنْدِ",14,"د",1,0],["فَتضنقُص أو تَزيدُ فَسَمِّ هذا","خَطأَ الكَفّات لا أَخطََت فِعلا",15,"ل",2,0],["فَتُضحِى في الرَّوابشى والتَناهِى","تناويرُ الأزاهرِ كالزرابي",16,"ب",2,0],["فتُضحِى مكارمُه كالمطىّ","ونغْمةُ سائله كالحُداءِ",17,"ا",2,0],["فَتَضَمَّنَت أَبطالُها إِبطالَها","خُدَعَ المُنى وَتَوَهُّمَ المُتَوَهِّمِ",18,"م",1,0],["فتضرّجا عند العتا","ب له فأعتب واستحدّا",19,"د",2,0],["فتَضَرّمَتْ مِنْ لَوْعَةٍ أنْفاسُهُ","وتصَرَّمَتْ في حَسْرَةٍ آمَادُهُ",20,"د",2,0],["فَتَضاعَفَ الشَوق اللجوج وَشَفَني","وَجدٌ دَخيلٌ بِالفُؤاد لَصيق",21,"ق",1,0],["فتضيع ترجمتي وما ألفته","كضياع عمري في ارتكاب مناهي",22,"ي",1,0],["فتُضحي أباة الذُّل والفقر عارقٌ","غِنيِّينَ منه عن شَرابٍ ومطْعَمِ",23,"م",1,0],["فتضاحكت منه الرجال وأعرضوا","عنه وقالوا العبد عبد مجون",24,"ن",1,0],["فتضمحل رسوم الكائنات ولا","عقل هناك ولا حس فيغترف",25,"ف",1,0],["فتضمر العناد لي","والموت فيما تضمر",26,"ر",1,0],["فتضحكُ أدلالاً وتبكي تأسُّفاً","فأعجبُ من دُرينِ في النظمِ والنثرِ",27,"ر",1,0],["فتضاحك الحبشي من","ه وقال لا تسمع كلامه",28,"م",2,0],["فتضاحكت فبكيت من فرط الجوى","شوقاً فما رقت لرقة حالي",29,"ل",2,0],["فَتَضاحَكَت مِنّي وَقالَت هكَذا","لَو لَم أَدَعكَ تَنامُ بي لَم تَحلُمِ",30,"م",1,0],["فتّضاكُ لحظكِ سهمٌ قد فرى كبدي","ولم يفد فيهِ ما أجهدتُ من حذَرِ",31,"ر",1,0],["فتضعضع العقال في خلواته","وتحير الرهبان في أدياره",32,"ر",2,0],["فَتضَمَّنَت أصلَين قَامَ علَيهِمَا ال","إسلاَمُ والإِيمَان كالبُنيَانِ",33,"ن",1,0],["فتضحي مصونات الدموع مذالة","ونحن على طرف من الدهر أبلق",34,"ق",1,0],["فَتَضجَرُ مِنهُم أَنفُسٌ رُبّما بَكَت","بُكىً هُوَ لِلصُمِّ الجَلاميدِ إِبكاءُ",35,"ا",2,0],["فتضاحكوا وتغامزوا","من كربتي وتجملي",36,"ل",2,0],["فتضوعت ازهار كل خميلة","تجزيك بالنعماء حمد الشاكر",37,"ر",1,0],["فتَضافروا أبناءَ وا","دي النيل في مجدٍ يُعاد",38,"د",1,0],["فَتَضْرِبُ بالبيضِ ذاتَ اليَمينِ","وَتَطعن بالسُّمرِ ذاتَ الشِّمالِ",39,"ل",1,0],["فَتضمُّهُ ضَمَّ الحَبيب قُلوبُها","يَومَ الوَغى وَهوَ العَدوُّ الأَزرَقُ",40,"ق",1,0],["فتضج في الست الجهات نعاته","ويطبق الدنيا شجى المامها",41,"م",3,0],["فتضرجَّت أثوابُهُ بدِمائِهِ","فكأَنَّها من ذاك ثوبٌ مُعلَمُ",42,"م",1,0],["فتضاعفت أحزانه","وتورست ألوانه",43,"ن",2,0],["فتضعضعتْ عني الفوارسُ إذ رأتْ","حملاتِ حيدرَ في غزاة هوازن",44,"ن",1,0],["فَتضسبَحُ من عَيِّها عَرَقاً","بِجَرِّكُمُ في عِجالِ الخُطُوبِ",45,"ب",1,0],["فتضحي الأماني قد بلغن بي المنا","فحققت الوهم الذي أظهر القولا",46,"ل",2,0],["فتضاحكتُ شامتاً وكأن ال","صبح جيبُ على الدجا مشقوق",47,"ق",1,0],["فتضحى باقدام لبسط وفرحة","وتمسي بأحجام لقبض واحزان",48,"ن",1,0],["فتضَلّع منه واشرب هانئاً","شَربةً فيها شفاءُ المتعبِ",49,"ب",1,0],["فَتَضْطَرِبُ الأَحْوَاْلُ فِيْ كُلِّ بُقْعَةٍ","وَتَسْرَحُ قُطْعَاْنُ الْقُرُوْدِ، وَتَمْرَحُ",50,"ح",1,0],["فَتَضَمَّخَ الْوِجْدَانُ مِنْ مَسْرَى شَرَا","يينِيْ رُؤَىً سَكْرَى تَهِيمُ تَرَنُّمَا",51,"م",2,0],["فَتُضْمِرُهَا عَلَى مَضَضٍ وتَلْوِيْ","وَتَمْضِي مُثْقَلًا وَرُؤَاكَ شَتَّى",52,"ت",2,0],["فتضج ألسنة الورى في نقلها","يوما لشام في الربى ويمان",53,"ن",1,0],["فتضج صرخاتي إذا استلقى وما","أمسى زمام الصمت في متناولي",54,"ل",2,0],["فَتضمُّنِي حتّى ضُلوعِي تَنتَشِي","\"نِعْمَ الصَّباحُ صَباحُنا تَرْنِيمُ\"",55,"م",1,0],["فتضمهم بعد الفراق لصدرها","وتزفهم بالعطر والكافور",56,"ر",1,0],["فتضمد الجرحَ السحيقَ يسارُهُ","وبكفه الأخرى يحقق وعدَهُ",57,"د",2,0],["فتضطرمُ المشاعرُ في فؤادي","وتبدي العينُ ما تخفي الضلوعُ",58,"ع",1,0],["فتضخ الشهد بأوردتي","والقلب بحكم المستعمر",59,"ر",1,0],["فتضوَّعت أجواؤنا من عطره","وسرى بثورتنا ضياءً يسطعُ",60,"ع",1,0],["فتضمُّه لحنَانِهَا في حَيْرَةٍ","منْ أمرِها..وتطيرُ قبلَ تَلَبُّسِ..",61,"س",1,0],["فتضطرب الجوانحُ مثلَ طيرٍ","أسيرٍ رامَ وُدّ المستحيلِ",62,"ل",1,0],["فتضاحكت زُهر النجوم","وعانقت للصبح نهده.",63,"د",2,0],["فتضربها الرعاة على قفاها","وتربض فوقها حممٌ عتية",64,"ي",2,0]]}