{"poems":[[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[86,"خرج الغواني يحتججن","https://www.aldiwan.net/poem10677.html","مجزوء الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"أرى الصبر محمودا وعنه مذاهب","https://www.aldiwan.net/poem8316.html","الطويل"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[56,"مرت فقلت لها تحية مغرم","https://www.aldiwan.net/poem58460.html","الطويل"],[61,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[31,"ليت هندا أنجزتنا ما تعد","https://www.aldiwan.net/poem42576.html","الرمل"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[46,"مجوسية وحنيفية","https://www.aldiwan.net/poem23620.html","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72221","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[109,"وللكفات في المجهول وجه","https://www.aldiwan.net/poem2366.html","الرجز"],[130,"رقاب العقل لو تدرين ما بي","https://www.aldiwan.net/poem54880.html","الوافر"],[140,"نظرت ولم أبغ إلا شفائي","https://www.aldiwan.net/poem58423.html","المتقارب"],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[184,"أهدى المليح إلي وردا","https://www.aldiwan.net/poem43971.html","مجزوء الكامل"],[273,"ما حال من جثمانه وفؤاده","https://www.aldiwan.net/poem25577.html","الكامل"],[377,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[400,"هذي الطريقة ليت شعري ما هي","https://www.aldiwan.net/poem33361.html","الكامل"],[459,"يرجى نداه في القطوب وجوده","https://www.aldiwan.net/poem16133.html","الكامل"],[556,"حاولت في المرآة أنظر من أنا","https://www.aldiwan.net/poem33771.html","الكامل"],[556,"العين واحدة والحكم مختلف","https://www.aldiwan.net/poem34344.html","البسيط"]],"verses":[["فتضاءَلَتْ كُوَرُ الجِبالِ لِفَقْدِهِ","غُبْرَ الفِجاجِ خَواشِعَ الأعْلامِ",0,"م",1,0],["فَتَضاحَكَت عَجَباً وَقالَت يا فَتى","لا خَيرَ فيكَ كَأَنَّها لَم تَحفِلِ",1,"ل",1,0],["فَتَضَعضَعَ النِسوانُ وَال","نِسوانُ لَيسَ لَهُنَّ مُنَّه",2,"ن",2,0],["فَتَضَيَّفا ماءً بِدَحلٍ ساكِناً","يَستَنُّ فَوقَ سَراتِهِ العُلجومُ",3,"م",1,0],["فتضاحكْنَ هازئاتٍ وماذا","يُونِقُ البِيضَ من سوادٍ جَليبِ",4,"ب",1,0],["فَتُضحي جزوعاً إن أصابتْ مصيبةٌ","وتُمسي هلوعاً إن تَعذَّرَ مَطلبُ",5,"ب",1,0],["فَتَضايَقَ قَلبي وَاِضطَرَبا","وَاِرتَجَّت روحي في صَدري",6,"ي",1,0],["فَتَضايَقَ القَلبُ السَجينُ وَقالَ لي","يا أَيُّها الجاني قَتَلتَ هَيامي",7,"ي",1,0],["فتضاحكَتْ خَجَلاً وقالتْ يا فَتى","لَوْ لَمْ أَدْعكَ تَنَامُ بِي لَمْ تَحْلُمِ",8,"م",1,0],["فتضرَّجَتْ تلك البِطاحُ به دماً","وتضرَّمَتْ تلك الفِجاجُ حَريقا",9,"ق",2,0],["فَتَضاحَكنَ وَقَد قُلنَ لَها","حَسَنٌ في كُلِّ عَينٍ مَن تَوَد",10,"د",1,0],["فتضربهم ما دام للسيف قائم","وتطعنهم ما دام للرمح عامل",11,"ل",1,0],["فَتُضحي مِنَ المَردِ مَردِيَّةً","وَتُمسي مِنَ الرَدى مَردِيَّه",12,"د",3,0],["فَتَضْرِبَ ضَرْبَةً يَسْمُو إليها","حَدِيثُ القَوْمِ في الرُّفقِ العجالِ",13,"ل",1,0],["فَتَضَاحَكْنَ مِنْ مَقَالَةِ هِنْدِ","وَتَمَايَلْنَ عَنْ أَفَانِينَ رَنْدِ",14,"د",1,0],["فَتضنقُص أو تَزيدُ فَسَمِّ هذا","خَطأَ الكَفّات لا أَخطََت فِعلا",15,"ل",2,0],["فَتُضحِى في الرَّوابشى والتَناهِى","تناويرُ الأزاهرِ كالزرابي",16,"ي",1,0],["فتُضحِى مكارمُه كالمطىّ","ونغْمةُ سائله كالحُداءِ",17,"ا",2,0],["فَتَضَمَّنَت أَبطالُها إِبطالَها","خُدَعَ المُنى وَتَوَهُّمَ المُتَوَهِّمِ",18,"م",1,0],["فتضرّجا عند العتا","ب له فأعتب واستحدّا",19,"د",2,0],["فتَضَرّمَتْ مِنْ لَوْعَةٍ أنْفاسُهُ","وتصَرَّمَتْ في حَسْرَةٍ آمَادُهُ",20,"د",2,0],["فَتَضاعَفَ الشَوق اللجوج وَشَفَني","وَجدٌ دَخيلٌ بِالفُؤاد لَصيق",21,"ق",1,0],["فتضيع ترجمتي وما ألفته","كضياع عمري في ارتكاب مناهي",22,"ي",1,0],["فتُضحي أباة الذُّل والفقر عارقٌ","غِنيِّينَ منه عن شَرابٍ ومطْعَمِ",23,"م",1,0],["فتضاحكت منه الرجال وأعرضوا","عنه وقالوا العبد عبد مجون",24,"ن",1,0],["فتضمحل رسوم الكائنات ولا","عقل هناك ولا حس فيغترف",25,"ف",1,0]]}