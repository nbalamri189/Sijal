ttps://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[87,"سَمَا الْمُلْكُ مُخْتَالاً بِمَا أَنْتَ فَاعِلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22587",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"ومستضحك من عبراتي وبكائي","https://www.poetsgate.com/ViewPoem.aspx?id=32826",""],[45,"إنّ السّماحَةَ، والتَّكُرُّمَ، والنّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=32038",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[45,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[45,"ما لِذا الظّبْيِ لا ينالُ اقتِنَاصُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31146",""],[80,"تَغَنَّتْ قيانُ الوُرْقِ في الوَرَق الخُضْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3226",""],[80,"طربتُ متى كنت غير الطروب؟","https://www.poetsgate.com/ViewPoem.aspx?id=2991",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[101,"يا خَلِيلَيّ خَلِّيانِي وَما بِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62430&r=&rc=22",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["بَسَطوا إِلَيَّ أَنامِلاً مَغروسَةً","في اللُؤمِ لَم يَعرَق لَهُنَّ عِنانُ",0,"ن",1,0],["بَسالَةُ هانِئٍ في حَيِّ بَكرٍ","وَحَنظَلَةَ الَّذي قَطَعَ الوَضينا",1,"ن",2,0],["بَسَطوا الوُجوهَ وَفي ضُلوعِهِمُ","حُرَقُ الجَوى وَمَآلِمُ الكَلمِ",2,"م",1,0],["بِسِنانِ رُمحِكَ أَو لِسانِكَ موسِعاً","طَعناً يَشُقُّ عَلى العِدا وَجِدالا",3,"ل",2,0],["بِسُمرٍ مُثَقَّفَةٍ لِلطِعانِ","وَجُردٍ مُسَوَّمَةٍ لِلغِوارِ",4,"ر",1,0],["بَسَطوا لَنا أَيدي النَوا","لِ وَما نَرى مِنهُم جَوادا",5,"د",2,0],["بَسَطتُ يَدي حَتّى ظَنَنتُكَ قابِضاً","يَدَ الدَهرِ عَنّي وَهوَ أَزوَرُ أَكلَحُ",6,"ح",1,0],["بِسَوافي التُرُبِ البا","رِحِ وَالتُربِ الغَريبِ",7,"ب",1,0],["بَسَطْنها لِوَداعِي حينَ فارَقَني","لَيْلُ الشَّبابِ وَصُبْحُ الشَّيبِ قَدْ وافَى",8,"ف",2,0],["بَسَمَت فَلاحَ ضِياءُ لُؤلُؤِ ثَغرِه","فيهِ لِداءِ العاشِقينَ شِفاءُ",9,"ا",2,0],["بِسُلطانٍ عَلى جِسمي","فَما يُبقي وَلا يَذَرُ",10,"ر",1,0],["بِسَاطٌ طَوَاهُ الدَّهْرُ إِلاَّ تَذَكّراً","فَمَا تَنْقَعُ الرَّمْضَاءُ غُلَّةَ ظَمْآنِ",11,"ن",1,0],["بَسَمَتْ أُقْحُوَانَةً وَتَثَنَّتْ","بَانَةً ثُمَّ لاَحَظَتْنِي غَزَالَهْ",12,"ل",2,0],["بِسَيرِ مَن يَقطَعُ المَفاوِزَ وَال","بُعدَ إِلى مَن يُثيبُهُ الإِبلا",13,"ل",2,0],["بَسَطَت تَحتَهُ أَكُفّاً تَلَقَّت","هُ وَحاطَتهُ رَغمَ أَنفِ الحِمامِ",14,"م",1,0],["بَسلٌ عَلى شُعَرائِنا أَن يَنطِقوا","قَبلَ المُثولِ لَدَيهِ وَاِستِئذانِهِ",15,"ن",2,0],["بَسَمَت لِلذِهنِ فَاِستَهوَت نُهى","مُغرَمِ الفَضلِ وَصَبِّ الأَدَبِ",16,"ب",1,0],["بَسّامُ ثَغرِ البِشرِ إِن عَقَدَ الحُبا","فَرَأَيتَ وَضّاحاً هُناكَ مَهيبا",17,"ب",2,0],["بِسُمرٍ مِن قَنا الخَطِّيِّ لُدنٍ","ذَوابِلَ أَو بِبيضٍ يَختَلينا",18,"ن",2,0],["بِسَيرٍ يَضُجُّ العَودُ مِنهُ يَمُنُّهُ","أَخو الجَهدِ لا يُلوي عَلى مَن تَعَذَّرا",19,"ر",2,0],["بَسَطتَ لِباغي العُرفِ كَفّاً بَسيطَةً","تَنالُ العِدى بَلهَ الصَديقَ فضولُها",20,"ل",3,0],["بِسَجلٍ مِنكِ مُنحَدِرٍ عَلَيهِ","فَما يَنفَكَّ مِثلَ عَدا الفَريدِ",21,"د",1,0],["بَسَمَ الأُفْقَيْنِ فِي آنٍ بَدَتْ","آيَتَا الإِحْسَانِ وَالحُسْنِ المُبِينْ",22,"ن",1,0],["بَسْطَةُ اللهِ فِي الثَّرَاءِ لَهُ","أَجْمَلَتْ شُكْرَهَا يَدَا فَمِنِ",23,"ن",1,0],["بَسَطَتْ عَلَى العَبْرَيْنِ رَايَةَ فَخْرِهَا","وَعَدَا الأَجَارِعَ فَيْئُهَا وَتَرَامَى",24,"م",2,0],["بسط اللّه في افتدارك","بذك الذات الشهيرا",25,"ر",2,0],["بسهام من لحظ ان احور","وشفار ان با بليّا