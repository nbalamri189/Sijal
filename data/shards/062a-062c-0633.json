{"poems":[[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[76,"لله نورية المحيا","https://www.aldiwan.net/poem13275.html","مجزوء البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[111,"لا تترك الأنفاس في الهزل سدى","https://www.poetsgate.com/ViewPoem.aspx?id=532",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[124,"أجوب فيافي العيش سدمان حئرا","https://www.aldiwan.net/poem49282.html","الطويل"],[226,"أتنآى ورجلاك فوق الثرى","https://www.aldiwan.net/poem55300.html","المتقارب"],[234,"لقد نطق العود عن سره","https://www.aldiwan.net/poem51218.html","المتقارب"],[275,"الخمر في كأسها الياقوت والماس","https://www.aldiwan.net/poem35295.html","البسيط"],[519,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[569,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38272","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38212","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56572","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87827","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109370","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122468","البسيط"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76544","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88944","الوافر"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199107","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199064","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72466","السريع"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132191","الطويل"],[4679,"لعمرك ما السعادة للشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=142729",""],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4832,"أروم العلى والدهر يثني مراميا","https://www.poetsgate.com/ViewPoem.aspx?id=166713",""],[4927,"كَوَاْرِثُ الْحُبِّ الإلِيْكِتْرُوْنِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=29956",""],[5183,"صفو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186608",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5351,"موعد الله","https://www.poetsgate.com/ViewPoem.aspx?id=202649",""],[5431,"رحلة ضوئية ....","https://www.poetsgate.com/ViewPoem.aspx?id=210418",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5628,"صورة مؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=178520",""]],"verses":[["تجس نبض العود احيانا","بايد ماهره",0,"ر",2,0],["تَجَسَّمَ النورُ فيهِ نَوراً","فَكُلُّ غُصنٍ بِهِ ثُرَيّا",1,"ي",2,0],["تجسس من بعد الزَعامة للعدى","وَما كانَ منهم أَجره بِزَهيد",2,"د",1,0],["تجسم النور على طباقه","فلاح فيها جوهرا مفصلا",3,"ل",2,0],["تجسم ما تعطي من الفضل جوهراً","فكل رثائي الجوهر المتجسم",4,"م",1,0],["تجسمت تلك الطيور عسجداً","ورصع الياقوت في منقارها",5,"ر",3,0],["تجسم لي وهمي به فسحبتني","أرى حلماً تنهار منه عقول",6,"ل",1,0],["تجسمت لطفا فما ضرنا","لو أنك فوق المآقي تدوس",7,"س",1,0],["تجسُّ الأناملُ دَسْتانه","كما جَسّ عِرقَ العليلِ الطبيب",8,"ب",1,0],["تجسُّ كفّي معرَّاها فيتبعُها","فمي الذي هو لثّامٌ وهمّاس",9,"س",1,0],["تجسّم ضَنْكُه فرداً فولّى","جموحُ الأُسْدِ واِنفرجَ الزِّحامُ",10,"م",1,0],["تجسم الجود حتى خلته بشراً","وذاك أنت وذي علياك علياء",11,"ا",2,0],["تجسم مغناها بكل روية","وشبهتها تطوى بكل طوية",12,"ه",1,0],["تَجَسّمَ مِن وَجدٍ تَربّى مِنَ الهوى","تَوَلَّد مِن عِشقٍ يَطولُ عَلى الشَّرحِ",13,"ح",1,0],["تَجَسَّمت وَهيَ روحٌ لا اِرتِيابَ بها","مِن أَكمَلِ الحسنِ في حَلْيٍ وفي حللِ",14,"ل",1,0],["تَجَسّمَ مِن لُطفٍ وَذَوقٍ وَرقّة","بِطَبعٍ وَمَعروفٍ وَخَيرٍ لَهُ يُسدي",15,"د",2,0],["تَجَسَّمَ مِنْ عَدْلٍ لِنَصْرٍ مُنَزَّهٍ","وَهَلْكٍ حُلُولِيّ وَقَتْلٍ مُحَتَّمِ",16,"م",1,0],["تجسسوا إنما تجسسكم","بمثلكم لا بمثلنا قمن",17,"ن",1,0],["تجسمت فأصبحت جبالا","واستوثقت حتى غدت حبالا",18,"ل",2,0],["تجسسوا عنهم فمن تَجَسَّسَا","تَتَبَّعَ الخطوَ وأحصَى النفسَا",19,"س",2,0],["تَجَسَّمَ طَيفُ الشَكِّ حَتّى لَو اِنَّني","تَلَمَّستُهُ بِالكَفِّ هانَ عَلى اللَمسِ",20,"س",1,0],["تجسَّم من روح الكمال وقد غدا","عليه طراز للمهابة مذهب",21,"ب",1,0],["تجسَّمَ الفخرُ في تلكَ المعاقِلِ والإج","لالُ والعزمُ والسُّلطانُ والباسُ",22,"س",1,0],["تَجَسَّمَ فِيهِ النُورُ نَوراً يَعُلُّهُ","زُلالٌ وَجِريالٌ وَشَهدٌ وَعَنبَرُ",23,"ر",1,0],["تجسم من هيولي اللطف لكن","قليلٌ مثل صورته تقوم",24,"م",1,0],["تَجسَّدَ الحَقُّ فِي أَثناءِ بُرْدَتِهِ","وَتُوِّجَتْ بِاسْمِهِ العالي مَنابِرُهُ",25,"ر",2,0],["تجسمت فيك أخلاقا مهذبة","فأنت للمجد قلب بل وعينان",26,"ن",1,0],["تجسم فيها الفضل والعز والندى","ممنعة من دونها مسلك وعر",27,"ر",1,0],["تجسمت روح المعاني به","لما حوى روح بيان المقال",28,"ل",1,0],["تجسم من ماء الملاحة خده","وماء الحيا فيه ترجرج مائعه",29,"ع",2,0],["تجسد ماحياً عنا الخطايا","بسفك دمائه فوق الصليب",30,"ب",1,0],["تَجَسّدَ معْنى الصّدقِ مِنْ لَمَحَاتِهِ","تخيَّرهُ ثوباً تزيَّاهُ وَ ارْتدى",31,"د",2,0],["تجسمت لكن من أمان عظائم","فلو حللوني لاستحلت أمانيا",32,"ي",2,0],["تُجَسِّدُ إِخْلاصاً، وَ تُحْيِيْ مَحَبَّةً","وَيَنْفثُ \\\"مِيكْرُوْبَ\\\" الْوِشَاْيَةِ نَاْفِثُ",33,"ث",1,0],["تجسدت فيه آيات الغرام على","شفاهه الحمر فاستجدى يد اللعب",34,"ب",1,0],["تجسمت من هنئ العيش واتخذت","رياشها من نعيم بارد عذبا",35,"ب",2,0],["تجسدت منهُ في أخلاقنا قيمٌ","وقد لمسناهُ قلبا نبضهُ فينا",36,"ن",2,0],["تجسّمت لحظةٌ للوقت عابرة","وبادرت بفمٍ من دهشةٍ شهقا !!",37,"ق",2,0],["(تجسَّدَ الجدُّ في أحشائِه، فغَدا","والنجمَ في الأُفُقِ العُلْويِّ) قد قُرِنا",38,"ن",2,0],["تجسّدتْ عندها المأساةُ وارتَسَمتْ","فيها الحقيقةُ لمْ تُنسَبْ إلى فَنَد ِ(2)",39,"د",1,0]]}