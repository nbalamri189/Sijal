{"poems":[[108,"أذن بمن في السرى","https://www.shoaraa.com/p11793",""],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[93,"على شبابك يبكى","https://www.aldiwan.net/poem11128.html","المجتث"],[30,"أمنزلتي مي سلام عليكما","https://www.aldiwan.net/poem29573.html","الطويل"],[88,"وقفت عليكن قلبي الذي","https://www.aldiwan.net/poem44417.html","المتقارب"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"حجبت ولم أحسب سنا البدر يحجب","https://www.aldiwan.net/poem18243.html","الطويل"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[28,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[80,"دم الكرم في الكاس أم عندم","https://www.aldiwan.net/poem31306.html","المتقارب"],[13,"تقول سليمى لجاراتها","https://www.aldiwan.net/poem2210.html","المتقارب"],[48,"أحسن من وقفة على طلل","https://www.aldiwan.net/poem64505.html","المنسرح"],[48,"أبت عيناي بعدك أن تناما","https://www.aldiwan.net/poem65228.html","الوافر"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43708","السريع"],[133,"على شرب الأتاي القلب مالا","https://www.aldiwan.net/poem54772.html","الطويل"],[143,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[167,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[205,"يا من يجل عن المقدار والخطر","https://www.aldiwan.net/poem53137.html","البسيط"],[208,"تقطع باقي وصل أم مؤمل","https://www.aldiwan.net/poem27930.html","الطويل"],[236,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[250,"تعنى القلب من سلمى عناء","https://www.aldiwan.net/poem2133.html","الوافر"],[257,"يا ذا الذي جاء بحر له","https://www.aldiwan.net/poem48426.html","السريع"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[272,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[283,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[305,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[329,"على شاطىء فوق الحياة تمددت","https://www.aldiwan.net/poem54973.html","الطويل"],[378,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[410,"ما منهم لك معتاض ولا خلف","https://www.aldiwan.net/poem32425.html","البسيط"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[459,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[459,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[466,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[478,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[496,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[503,"أعيني جودا بدمع درر","https://www.aldiwan.net/poem2065.html","المتقارب"],[516,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[552,"على شجر الأراك بكيت لما","https://www.aldiwan.net/poem48079.html","الوافر"],[563,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"]],"verses":[["على شعائرها صِينت شرائعنا","وفي محارمها يربو حوارينا",0,"ن",2,0],["عَلى شَريقَيَّ نَجدٍ","مَرعىً لِعَينِكَ جَدبُ",1,"ب",1,0],["عَلى شيمَةٍ لَيسَت بِجدِّ طَليقَةٍ","إِلَينا وَلا مَقلِيَّةٌ مِن شَمالِها",2,"ل",3,0],["عَلَى شَبَابِكِ يُبْكَى","يَا حُرَّةً يَا نَبِيلَهْ",3,"ل",2,1],["عَلى شَمَّرِيّاتٍ مَراسيلَ وَاِسَقَت","مَواخيدَهُنَّ المُعنِقاتُ الذَوارِعُ",4,"ع",1,0],["على شفتَيها يلوح اللمى","فيضرم في الصبّ نار الجوى",5,"ج",3,0],["عَلَى شُمِّ الأُنُوفِ أَبُو إِياد","أَبُوهُم مُتلِفِينَ ومُخلِفِينَا",6,"ن",2,0],["على شرفِ الأخلاقِ بعدكَ والوفا","سلامٌ كوجه الروض والروضُ معجب",7,"ب",1,0],["عَلى شَرائِعِها غَرثانُ مُرتَقِبٌ","إِبصارَها خائِفٌ إِدبارَها كَمِدُ",8,"د",1,0],["عَلى شِبهِ السُهولِ مِنَ المِياهِ","تُحيطُ بِكَ الجَزائِرُ كَالشِياهِ",9,"ه",1,0],["عَلى شيمَتِهِ الأولى","وَفي مَذهَبِهِ الأَوَّل",10,"ل",1,0],["عَلى شَدَنِيّاتٍ كَأَنَّ رُؤوسَها","فُؤوسٌ إِذا راحَت رَواجِفُ في نُصبِ",11,"ب",1,0],["عَلى شَأوِ أَولاهُنَّ حَتّى تَنازَعَت","بِهِنَّ رُواةٌ مِن تَنوخٍ وَغافِقِ",12,"ق",1,0],["على شدواتِ طيورٍ فصاحٍ","على أنّ أفْصَحَها أعْجَمُ",13,"م",1,0],["عَلى شَيمِ نارٍ تَنَوَّرتُها","فَبُتُّ لَها مُدبِراً مُقبِلا",14,"ل",2,0],["عَلى شَبابٍ ما فيهِمُ خَرِقٌ","وَلا سَفيهٌ وَلا أَخو زَلَلِ",15,"ل",1,0],["عَلى شَطِّ الشَآمِ وَساكِنيهِ","سَلامُ مُسَلِّمٍ لَقِيَ الحِماما",16,"م",2,0],["على شَدْقمِيّاتٍ كأنّ حُداتَها","إذا عَرّسَ الرّكْبانُ شُرّابُ مُرقِدِ",17,"د",1,0],["على شطٍّ من الأحْلا","مِ والأنغامِ والزَّهرِ",18,"ر",1,0],["عَلَيَّ شَيْمُ الْغَوَادِي كُلَّمَا بَرَقَتْ","وَمَا عَلَيَّ إِذَا ضَنَّتْ بِرَقْرَاقِ",19,"ق",1,0],["عَلى شَفاً فيكَ بنيت المُنى","ما لَبِثَ البُنيانُ أَن هارا",20,"ر",2,0],["على شِربِ الأَتَايِ القَلبُ مَالاَ","فَلاَ نُوقاً نُرِيدُ ولاَ جِمَالا",21,"ل",2,1],["على شِيمَ النَّعَم الراتعا","تِ يُعقَر هذا وهذا يُسامُ",22,"م",1,0],["على شِفاهِكِ دَيني وهْيَ تُمْطلني","فأبشري بغَريمٍ في الهوى محكِ",23,"ك",1,0],["على شمائل في تركيبها بِدَعٌ","صِيغت من النور والآيات للعِبَرِ",24,"ر",1,0],["عَلى شُخَّصِ الأَبصارِ تَحسِبُ بَينَها","إِذا هِيَ جالَت في مَراوِدِها عَزفا",25,"ف",2,0],["عَلى شَفا جَدوَلٍ في أَبرَدَيهِ إِذا اِع","تَلَّ النَسيمُ لَأَدواءِ الهُمومِ شَفا",26,"ف",2,0],["عَلى شُعثٍ تَخُبُّ عَلى وَجاها","كَما خَبَّت مُجَوِّعَةً ضِراءُ",27,"ا",2,0],["عليَّ شغل بالمهم الذي","تراه فاطلب نايكاً غيري",28,"ي",1,0],["على شرفٍ أودى فشرّفَ أُمَّةً","وقدَّسَ أرضاً حجَّبت منهُ محسرا",29,"ر",2,0],["عَلى شفا جرف هار فأنقذها","لما أقل بحسن البشر من عثرا",30,"ر",2,0],["عَلى شَرخِ الشَّبابِ أَلَحَّ شَيبي","بِنابٍ لَيسَ عَن فَتكٍ بِنابي",31,"ب",2,0],["على شهوات كانت النفس أقدامت","عليها بطبع مستحث وغالب",32,"ب",1,0],["على شاطىء فوق الحياة تمدّدت","على رمله الأحلام صاحية سكرى",33,"ر",2,1],["على شطه ألقى المسيح وشاحَه","وكان لثوب النور أحسنَ مُرتَد",34,"د",1,0],["على شَفَا جُرُفٍ من شَوقِه وأرى","أن سَوف يَنْهَارُ من وجدٍ به الجرُفُ",35,"ف",1,0],["على شَدَنِيَّاتٍ تَطيرُ بِرُكْنِها","إِلَيْكَ خُطوبٌ فِي القلوبِ جَوَاثِمُ",36,"م",1,0],["على شَرَفٍ ظباءٌ مطمعاتٌ","وما قُيِّضْنَ قطُّ لسهمِ رامي",37,"م",2,0],["على شَرْطِ عزٍّ لا تحولُ رسومُهُ","وسَرحِ نعيمٍ لا تُراعُ سُروبُهُ",38,"ب",2,0],["على شِفاهيَ مَبْهورَين.. وابتَدأتْ","سِيماكَ مِن ذروَةِ الجَوزاءِ تَنكَشِفُ",39,"ف",1,0],["على شُعَبِ الأكوارِ منهنَّ فتيةٌ","قريبونَ مِن مدحٍ بعيدونَ مِن ذمَّ",40,"م",1,0],["على شفتيهما ضحك التهاني","وفي كبديهما وخزُ الأشافي",41,"ف",2,0],["عَلى شيبةِ الحمدِ ذي المَكرمات","وَذِي المجدِ وَالعزّ وَالمُفتخر",42,"ر",1,0],["على شاكر بل ماكر من سحابه","منائح إن يسخط بهن مذابح",43,"ح",1,0],["عَلى شَجَرِ الأراكِ بَكيتُ لمّا","مَررتُ بِهِ فَجاودتُ السّحابا",44,"ب",2,1],["عليَّ شُكرُكَ مفروضٌ أَقومُ بهِ","يا مَن عليهِ مَديحي غيرُ مندوبِ",45,"ب",1,0]]}