3er&doWhat=shqas&qid=82953&r=&rc=3",""],[6336,"في ليلة غائمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73558&r=&rc=19",""]],"verses":[["على شعائرها صِينت شرائعنا","وفي محارمها يربو حوارينا",0,"ن",2,0],["عَلى شَريقَيَّ نَجدٍ","مَرعىً لِعَينِكَ جَدبُ",1,"ب",1,0],["عَلى شيمَةٍ لَيسَت بِجدِّ طَليقَةٍ","إِلَينا وَلا مَقلِيَّةٌ مِن شَمالِها",2,"ل",3,0],["عَلَى شَبَابِكِ يُبْكَى","يَا حُرَّةً يَا نَبِيلَهْ",3,"ل",2,1],["عَلى شَمَّرِيّاتٍ مَراسيلَ وَاِسَقَت","مَواخيدَهُنَّ المُعنِقاتُ الذَوارِعُ",4,"ع",1,0],["على شفتَيها يلوح اللمى","فيضرم في الصبّ نار الجوى",5,"ج",3,0],["عَلَى شُمِّ الأُنُوفِ أَبُو إِياد","أَبُوهُم مُتلِفِينَ ومُخلِفِينَا",6,"ن",2,0],["على شرفِ الأخلاقِ بعدكَ والوفا","سلامٌ كوجه الروض والروضُ معجب",7,"ب",1,0],["عَلى شَرائِعِها غَرثانُ مُرتَقِبٌ","إِبصارَها خائِفٌ إِدبارَها كَمِدُ",8,"د",1,0],["عَلى شِبهِ السُهولِ مِنَ المِياهِ","تُحيطُ بِكَ الجَزائِرُ كَالشِياهِ",9,"ه",1,0],["عَلى شيمَتِهِ الأولى","وَفي مَذهَبِهِ الأَوَّل",10,"ل",1,0],["عَلى شَدَنِيّاتٍ كَأَنَّ رُؤوسَها","فُؤوسٌ إِذا راحَت رَواجِفُ في نُصبِ",11,"ب",1,0],["عَلى شَأوِ أَولاهُنَّ حَتّى تَنازَعَت","بِهِنَّ رُواةٌ مِن تَنوخٍ وَغافِقِ",12,"ق",1,0],["على شدواتِ طيورٍ فصاحٍ","على أنّ أفْصَحَها أعْجَمُ",13,"م",1,0],["عَلى شَيمِ نارٍ تَنَوَّرتُها","فَبُتُّ لَها مُدبِراً مُقبِلا",14,"ل",2,0],["عَلى شَبابٍ ما فيهِمُ خَرِقٌ","وَلا سَفيهٌ وَلا أَخو زَلَلِ",15,"ل",1,0],["عَلى شَطِّ الشَآمِ وَساكِنيهِ","سَلامُ مُسَلِّمٍ لَقِيَ الحِماما",16,"م",2,0],["على شَدْقمِيّاتٍ كأنّ حُداتَها","إذا عَرّسَ الرّكْبانُ شُرّابُ مُرقِدِ",17,"د",1,0],["على شطٍّ من الأحْلا","مِ والأنغامِ والزَّهرِ",18,"ر",1,0],["عَلَيَّ شَيْمُ الْغَوَادِي كُلَّمَا بَرَقَتْ","وَمَا عَلَيَّ إِذَا ضَنَّتْ بِرَقْرَاقِ",19,"ق",1,0],["عَلى شَفاً فيكَ بنيت المُنى","ما لَبِثَ البُنيانُ أَن هارا",20,"ر",2,0],["على شِربِ الأَتَايِ القَلبُ مَالاَ","فَلاَ نُوقاً نُرِيدُ ولاَ جِمَالا",21,"ل",2,1],["على شِيمَ النَّعَم الراتعا","تِ يُعقَر هذا وهذا يُسامُ",22,"م",1,0],["على شِفاهِكِ دَيني وهْيَ تُمْطلني","فأبشري بغَريمٍ في الهوى محكِ",23,"ك",1,0