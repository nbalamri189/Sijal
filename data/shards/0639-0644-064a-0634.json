{"poems":[[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[93,"على شبابك يبكى","https://www.aldiwan.net/poem11128.html","المجتث"],[30,"أمنزلتي مي سلام عليكما","https://www.aldiwan.net/poem29573.html","الطويل"],[88,"وقفت عليكن قلبي الذي","https://www.aldiwan.net/poem44417.html","المتقارب"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"حجبت ولم أحسب سنا البدر يحجب","https://www.aldiwan.net/poem18243.html","الطويل"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[28,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[80,"دم الكرم في الكاس أم عندم","https://www.aldiwan.net/poem31306.html","المتقارب"],[13,"تقول سليمى لجاراتها","https://www.aldiwan.net/poem2210.html","المتقارب"],[48,"أحسن من وقفة على طلل","https://www.aldiwan.net/poem64505.html","المنسرح"],[48,"أبت عيناي بعدك أن تناما","https://www.aldiwan.net/poem65228.html","الوافر"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43708","السريع"],[132,"على شرب الأتاي القلب مالا","https://www.aldiwan.net/poem54772.html","الطويل"],[142,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[166,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[204,"يا من يجل عن المقدار والخطر","https://www.aldiwan.net/poem53137.html","البسيط"],[207,"تقطع باقي وصل أم مؤمل","https://www.aldiwan.net/poem27930.html","الطويل"],[235,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[249,"تعنى القلب من سلمى عناء","https://www.aldiwan.net/poem2133.html","الوافر"],[256,"يا ذا الذي جاء بحر له","https://www.aldiwan.net/poem48426.html","السريع"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[271,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[282,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[304,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[328,"على شاطىء فوق الحياة تمددت","https://www.aldiwan.net/poem54973.html","الطويل"],[377,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[409,"ما منهم لك معتاض ولا خلف","https://www.aldiwan.net/poem32425.html","البسيط"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[465,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[477,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[495,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[502,"أعيني جودا بدمع درر","https://www.aldiwan.net/poem2065.html","المتقارب"],[515,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[551,"على شجر الأراك بكيت لما","https://www.aldiwan.net/poem48079.html","الوافر"],[562,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"]],"verses":[["عَلى شَريقَيَّ نَجدٍ","مَرعىً لِعَينِكَ جَدبُ",0,"ب",1,0],["عَلى شيمَةٍ لَيسَت بِجدِّ طَليقَةٍ","إِلَينا وَلا مَقلِيَّةٌ مِن شَمالِها",1,"ل",3,0],["عَلَى شَبَابِكِ يُبْكَى","يَا حُرَّةً يَا نَبِيلَهْ",2,"ل",2,1],["عَلى شَمَّرِيّاتٍ مَراسيلَ وَاِسَقَت","مَواخيدَهُنَّ المُعنِقاتُ الذَوارِعُ",3,"ع",1,0],["على شفتَيها يلوح اللمى","فيضرم في الصبّ نار الجوى",4,"ج",3,0],["عَلَى شُمِّ الأُنُوفِ أَبُو إِياد","أَبُوهُم مُتلِفِينَ ومُخلِفِينَا",5,"ن",2,0],["على شرفِ الأخلاقِ بعدكَ والوفا","سلامٌ كوجه الروض والروضُ معجب",6,"ب",1,0],["عَلى شَرائِعِها غَرثانُ مُرتَقِبٌ","إِبصارَها خائِفٌ إِدبارَها كَمِدُ",7,"د",1,0],["عَلى شِبهِ السُهولِ مِنَ المِياهِ","تُحيطُ بِكَ الجَزائِرُ كَالشِياهِ",8,"ه",1,0],["عَلى شيمَتِهِ الأولى","وَفي مَذهَبِهِ الأَوَّل",9,"ل",1,0],["عَلى شَدَنِيّاتٍ كَأَنَّ رُؤوسَها","فُؤوسٌ إِذا راحَت رَواجِفُ في نُصبِ",10,"ب",1,0],["عَلى شَأوِ أَولاهُنَّ حَتّى تَنازَعَت","بِهِنَّ رُواةٌ مِن تَنوخٍ وَغافِقِ",11,"ق",1,0],["على شدواتِ طيورٍ فصاحٍ","على أنّ أفْصَحَها أعْجَمُ",12,"م",1,0],["عَلى شَيمِ نارٍ تَنَوَّرتُها","فَبُتُّ لَها مُدبِراً مُقبِلا",13,"ل",2,0],["عَلى شَبابٍ ما فيهِمُ خَرِقٌ","وَلا سَفيهٌ وَلا أَخو زَلَلِ",14,"ل",1,0],["عَلى شَطِّ الشَآمِ وَساكِنيهِ","سَلامُ مُسَلِّمٍ لَقِيَ الحِماما",15,"م",2,0],["على شَدْقمِيّاتٍ كأنّ حُداتَها","إذا عَرّسَ الرّكْبانُ شُرّابُ مُرقِدِ",16,"د",1,0],["على شطٍّ من الأحْلا","مِ والأنغامِ والزَّهرِ",17,"ر",1,0],["عَلَيَّ شَيْمُ الْغَوَادِي كُلَّمَا بَرَقَتْ","وَمَا عَلَيَّ إِذَا ضَنَّتْ بِرَقْرَاقِ",18,"ق",1,0],["عَلى شَفاً فيكَ بنيت المُنى","ما لَبِثَ البُنيانُ أَن هارا",19,"ر",2,0],["على شِربِ الأَتَايِ القَلبُ مَالاَ","فَلاَ نُوقاً نُرِيدُ ولاَ جِمَالا",20,"ل",2,1],["على شِيمَ النَّعَم الراتعا","تِ يُعقَر هذا وهذا يُسامُ",21,"م",1,0],["على شِفاهِكِ دَيني وهْيَ تُمْطلني","فأبشري بغَريمٍ في الهوى محكِ",22,"ك",1,0],["على شمائل في تركيبها بِدَعٌ","صِيغت من النور والآيات للعِبَرِ",23,"ر",1,0],["عَلى شُخَّصِ الأَبصارِ تَحسِبُ بَينَها","إِذا هِيَ جالَت في مَراوِدِها عَزفا",24,"ف",2,0],["عَلى شَفا جَدوَلٍ في أَبرَدَيهِ إِذا اِع","تَلَّ النَسيمُ لَأَدواءِ الهُمومِ شَفا",25,"ف",2,0],["عَلى شُعثٍ تَخُبُّ عَلى وَجاها","كَما خَبَّت مُجَوِّعَةً ضِراءُ",26,"ا",2,0],["عليَّ شغل بالمهم الذي","تراه فاطلب نايكاً غيري",27,"ي",1,0],["على شرفٍ أودى فشرّفَ أُمَّةً","وقدَّسَ أرضاً حجَّبت منهُ محسرا",28,"ر",2,0],["عَلى شفا جرف هار فأنقذها","لما أقل بحسن البشر من عثرا",29,"ر",2,0],["عَلى شَرخِ الشَّبابِ أَلَحَّ شَيبي","بِنابٍ لَيسَ عَن فَتكٍ بِنابي",30,"ب",2,0],["على شهوات كانت النفس أقدامت","عليها بطبع مستحث وغالب",31,"ب",1,0],["على شاطىء فوق الحياة تمدّدت","على رمله الأحلام صاحية سكرى",32,"ر",2,1],["على شطه ألقى المسيح وشاحَه","وكان لثوب النور أحسنَ مُرتَد",33,"د",1,0],["على شَفَا جُرُفٍ من شَوقِه وأرى","أن سَوف يَنْهَارُ من وجدٍ به الجرُفُ",34,"ف",1,0],["على شَدَنِيَّاتٍ تَطيرُ بِرُكْنِها","إِلَيْكَ خُطوبٌ فِي القلوبِ جَوَاثِمُ",35,"م",1,0],["على شَرَفٍ ظباءٌ مطمعاتٌ","وما قُيِّضْنَ قطُّ لسهمِ رامي",36,"ي",1,0],["على شَرْطِ عزٍّ لا تحولُ رسومُهُ","وسَرحِ نعيمٍ لا تُراعُ سُروبُهُ",37,"ب",2,0],["على شِفاهيَ مَبْهورَين.. وابتَدأتْ","سِيماكَ مِن ذروَةِ الجَوزاءِ تَنكَشِفُ",38,"ف",1,0],["على شُعَبِ الأكوارِ منهنَّ فتيةٌ","قريبونَ مِن مدحٍ بعيدونَ مِن ذمَّ",39,"م",1,0],["على شفتيهما ضحك التهاني","وفي كبديهما وخزُ الأشافي",40,"ي",1,0],["عَلى شيبةِ الحمدِ ذي المَكرمات","وَذِي المجدِ وَالعزّ وَالمُفتخر",41,"ر",1,0],["على شاكر بل ماكر من سحابه","منائح إن يسخط بهن مذابح",42,"ح",1,0],["عَلى شَجَرِ الأراكِ بَكيتُ لمّا","مَررتُ بِهِ فَجاودتُ السّحابا",43,"ب",2,1],["عليَّ شُكرُكَ مفروضٌ أَقومُ بهِ","يا مَن عليهِ مَديحي غيرُ مندوبِ",44,"ب",1,0]]}