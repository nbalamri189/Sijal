87","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44907","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86455","الرمل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93316","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81276","الخفيف"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67637","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135098","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73322","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83139","الرمل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119559","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139693",""],[4702,"المشكلة بعد المنايا .. مرثية أبوي","https://www.poetsgate.com/ViewPoem.aspx?id=155205",""],[4764,"قلت لي مبروك","https://www.poetsgate.com/ViewPoem.aspx?id=25597",""],[4791,"عين أشقر","https://www.poetsgate.com/ViewPoem.aspx?id=28406",""],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""],[4984,"الجرْس ( وحي العيد )","https://www.poetsgate.com/ViewPoem.aspx?id=180973",""],[5083,"قهوةُ صيدا","https://www.poetsgate.com/ViewPoem.aspx?id=53728",""],[5111,"قُرْبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212513",""],[5183,"عالي الجناب","https://www.poetsgate.com/ViewPoem.aspx?id=186607",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5376,"ولد الحبيب فنوره وضَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=188484",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5561,"بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=211443",""],[5573,"العمر ينقضي بالوفا والتمام","https://www.poetsgate.com/ViewPoem.aspx?id=204529",""],[5605,"كل يوم بما أردت تعودي !","https://www.poetsgate.com/ViewPoem.aspx?id=191378",""],[5701,"إن تشيبي فإنني كيفما كن","https://www.poetsgate.com/ViewPoem.aspx?id=164673",""],[5747,"دهاليز الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=61678",""],[5764,"قويٌ لا رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=175604",""],[5770,"يا جيرةَ الحرمِ المكيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=178684",""],[6113,"ان بعض الظن اثم","https://www.poetsgate.com/ViewPoem.aspx?id=26374",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[1100,"لا تحققت يا حلم فتساويت والعدم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613000",""]],"verses":[["لكَ عاذِلٌ بثَقيلِهِ وخَفيفِه","بيْنَ النِّدامِ غَبوقُهُ وصَبوحُهُ",0,"ه",1,1],["لك عين ترى السها في الدياجي","وعن الشمس في الضحا تتعامى",1,"م",2,0],["لك عارضٌ لدموع عيني ممطر","فدَعِ الجفاءَ فلست ممن يصبر",2,"ر",1,1],["لك عزم أجرى السحاب بفضلٍ","قد غدا ساحباً من الحمد خزّه",3,"ز",2,0],["لكَ عين وقامة كل يوم","تلك غزَّالة وذي فتَّاله",4,"ه",1,0],["لك عندِي صدقات","وإفادات خفيَّه",5,"ي",2,0],["لك عندي صَنيعةٌ ما سقاها","غيرُ وَسْميِّك القديمِ سحابُ",6,"ب",1,0],["لك عدلُ ذي تقوى وظلم أخي ندى","لا ظلم غصّابٍ ولا بخّاس",7,"س",1,0],["لك عرض ليس من عاداته","أن يرى فيه من الذم طبع",8,"ع",1,0],["لك عادةٌ في القُطن غيرُ ذميمةٍ","وهو الرياش وأنت إبراهيمُ",9,"م",1,0],["لكَ عُذرٌ أن لا تنام لعمري","أنا أدهى من أن ينام سليمي",10,"م",2,0],["لك عرفٌ لم يُحِط شكري به","جَلَّ ركناً حَضَنٌ أن يُحتَضن",11,"ن",1,0],["لَكَ عِندَ اِبنَي أَو عِندي يَدٌ","لَستُ آلوها اِدِّكاراً أَو صِيانا",12,"ن",2,0],["لَكَ عِنْدي مِن طَيِّبِ الوَرْدِ أَطْبَا","قٌ تُدْنِي بَعِيدَ سُرورِكْ",13,"ك",1,1],["لَكَ عادَةٌ أَلّا تَزالَ شَريكَهُ","مِمّا عَناهُ مُرافِقاً أَو مُسعِدا",14,"د",2,0],["لَكِ عَهدٌ لَدَيَّ غَيرُ مُضاعِ","باتَ شَوقي طَوعاً لَهُ وَنِزاعي",15,"ع",2,1],["لَكِ عَينٌ إِن يَنبعِ السحرُ منها","فهو بالخَبْلِ في العقول يغورُ",16,"ر",1,0],["لَكَ عِلمٌ بِعَبرَتي وَاِشتِياقي","وَالَّذي بي مِن لَوعَةٍ وَاِحتِراقِ",17,"ق",1,1],["لك عند قومِكَ ما تحبُّ وتَشتهِي","في ذلكَ الحَرمِ المُمنَّعِ والحِمَى",18,"م",2,0],["لَكَ عِندِيَ عَتقٌ مِنَ الدَمعِ إِن صَح","حَ الَّذي قُلتِهِ وَلَو بَعدَ شَهرِ",19,"ر",1,0],["لَكَ عِندَ البِرِّ في مَلجَئِهِ","حَيثُ تَأوي خاطِرٌ لَن يُكسَرا",20,"ر",2,0],["لَكَ عِرْضٌ أَرَقُّ نَسْجَاً مِنَ الرِّي","حِ وَأَوْهَى مِنْ طَيْلَسانِ ابْنِ حَرْبِ",21,"ب",1,0],["لك عند رب العرش أجر مجاهدٍ","فانعم برحمته وعدن جنانه",22,"ن",2,0],["لَكَ عُمْرُ النَّدَى يَطِيرُ مَعَ الشَّمْسِ","وَعُمْرُ الْبُرُوقِ بَيْنَ السَّحابِ",23,"ب",1,0],["لك: عدوُ الظباء سارت خفاقًا","وزئيرُ الأسودِ ثارت غضابا",24,"ب",2,0],["لَك عند النجوم إرثٌ مُضاعٌ","لا تقل: كيف أستطيعُ الصُّعُودا؟",25,"د",2,0],["لك عرش العلم في أبهته","وله سلطانه في الملل",26,"ل",1,0],["لك عند الجُرْدِ الاصائلِ دَيْنٌ","مستَحقُّ الأداءِ في النَسل لازِم",27,"م",1,0],["لك عمٌّ احيا مزايا ذويه","وأرانا الجدودَ تنفُضُ رمْسا",28,"س",2,0],["لك عند ابْنِيَ أَو عندي يدٌ","لستُ آلوها ادكاراً وصِيانا",29,"ن",2,0],["لَكَ عِندي مِن الحُقوق عُهود","باقِيات وَنعمة لَيسَ تَنسا",30,"س",2,0],["لَكَ عَزمة في النائِبات وَسودد","كَعُلى الكِرار في صَفينِهِ",31,"ن",2,0],["لك عند عبدك موطن في قلبه","بحضوره رحب الحمى وبسلبه",32,"ه",1,1],["لَكَ عَزمَةٌ كَالسَيفِ بَل أَمضى شَباً","مِن رُتبَةٍ كَالشَمسِ بَل هِيَ أَرفَعُ",33,"ع",1,0],["لك عِلمٌ بأنَّني بك أَلهُو","أنا واللَهِ فوق شوق المَشُوقِ",34,"ق",1,0],["لك عينٌ هي سحر وفتون","يرجع الصب إليها يرجع",35,"ع",1,0],["لك عقل لا كالعقول ونفس","لأجل الميول كالميدان",36,"ن",1,0],["لك عزم من القضاء وذكر","مشرق في الزمان إشراق شمس",37,"س",1,0],["لَكِ عِندي وَصيَّةٌ فَاِحفَظيها","هيَ بَعد المَماتِ أَن تَنسيني",38,"ن",2,0],["لك عندي فقَرَّ عينا من المُكْ","نَة ما لا تُحْصِيه مِنّي القوافي",39,"ف",2,0],["لك عند الزمانِ عهدٌ جميلٌ","ولَدَى المَكْرُمات حسنُ بلاء",40,"ا",2,0],["لَكَ عِفَّةٌ في قُدرَةٍ وَتَواضُعٌ","في عِزَّةٍ وَشَراسَةٍ في لينِ",41,"ن",1,0],["لكَ عبرةٌ ونهىً من الدولِ التي","تبغي وتفتكُ أو تروغُ وتمكر",42,"ر",1,0],["لَكَ عِندي مودَّةٌ أَحكمَتها","يَدُ صِدقٍ وثيقةُ الأَسبابِ",43,"ب",1,0],["لكَ عندي نِعَمٌ أَيسرها","طاهرُ الحبِ وعطفُ الأَبوين",44,"ن",1,0],["لك عن حِماكَ دفاعُ لَيْثٍ مُشبِلٍ","ولِمَنْ رجَاك قطارُ غَيْثٍ مُسْبِل",45,"ل",1,0],["لَكَ عِندي يَدٌ وَما لِلِساني","بِيَدٍ تَملَأُ الرُءوسَ يَدانِ",46,"ن",1,1],["لكعبة الحسن ركنٌ خالهُ فإذا","تعذّرَ اللثم بالإيماءِ نلثمهُ",47,"ه",1,0],["لك عهد في القلب غير مضاع","بوداد للغانيات وثيق",48,"ق",1,0],["لك عرض لا يعروه قذى","ومقال قورن بالسدد",49,"د",1,0],["لكَ عندي مننٌ واضحةٌ","في جلابيبٍ من الأيام دكن",50,"ن",1,0],["لَكَ عِندي مينا مِنَ الهَليونِ","حَولَهُ عَسجَدٌ مِنَ الطَردينِ",51,"ن",1,1],["لَكَ عِندي دَستيجَةٌ مَختومَه","وَبَلَسقِيَّةٌ لَها أَلفُ قيمَه",52,"م",2,1],["لك عونان بالحقوق وضعفي","ولهذا قد انتصرت عليا",53,"ي",2,0],["لكَ عَزمٌ في حَضرةِ الصِّدقِ أبْدَى","سِرَّ قُدْسٍ بُرْهانُهُ مَوْصوفُ",54,"ف",1,0],["لك عِبرَةٌ فيمنْ عَرَتْ","هُ وعبرةٌ فيمن عَراها",55,"ا",3,0],["لك عينان عين غيب تراه","وتراه الأخرى فتصرف صرفا",56,"ف",2,0],["لكعبة الوصف ذات قبلها ذاتُ","فهي الذوات ثلاث المستعزاتُ",57,"ت",1,1],["لك عندي في الكل صورة وجه","جل عن كل صورة بالتفات",58,"ت",1,0],["لكَ عندَنا شوقٌ يطُولُ فهلْ لنا","صَبرٌ يطولُ عليهِ إنْ طالَ المَدَى",59,"ا",1,0],["لكَ عبد المجيد آيات فضلٍ","عادَ عن وَصفِها لِساني كليلا",60,"ل",2,1],["لَكَ عِندي رِفدانِ رِفد من الما","لِ ومن جاهِكَ المُعظَّمِ رِفد",61,"د",1,0],["لك عندها ما للمنجِّي المفتدي","من واجب عند الوفي الناجي",62,"ج",2,0],["لك عند كسرى ما لذي قرباه أو","أعلى وحسبك ما ترى تقديرا",63,"ر",2,0],["لك عنده الحق المبين وقد مضى","جبروته والتيه والتهويل",64,"ل",1,0],["لك عفوي ولن ينالك حبي","فعسير عليّ حب المذممْ",65,"م",1,0],["لَكَ عَبْدٌ كَساكَ فاخِرَ مَدْحٍ","رَائِقِ لُبْسُهُ لِبَاسَ الخُزُوز",66,"ز",1,0],["لَكَ عَبْدٌ مَسَّهُ بَعْدَكُ مَا","وَكَّلَ الْجِسْمَ بِدَاءٍ مُحْرِضِ",67,"ض",1,0],["لك عهد في عنقي ما عشت","أبث مراثيك الغررا",68,"ر",2,0],["لك عادة حسناء في","نا لم تزل تتسلسلُ",69,"ل",1,0],["لك عند الحياة من","نة من يمطر الديم",70,"م",1,0],["لك عندي عقدان دمعي وشعري","فتخير والدمع لا ريب أغلى",71,"ل",2,0],["لك عبدٌ عبيده فوق مولا","ك ومولاك ليس ينكر ذاكا",72,"ك",2,0],["لك عزم بأن أكون قتيلاً","فيك والصبر عنك مالا يكون",73,"ن",1,0],["لكَ عندي واللهِ إن رَضيَ","الفضَلُ غلامٌ يُرضيكَ أو بِرذَوُنُ",74,"ن",1,0],["لك عفّة وبسَالة وسماحةٌ","ورجاحة ونُهىً فأنت الكاملُ",75,"ل",1,0],["لك عندى مودة لم تنلها","يد دهر نراه بالمرصادِ",76,"د",1,0],["لكعبة بيتها حجي وقصدي","لأشرف مرسل كنز اعتقادي",77,"د",2,0],["لكعبة حسنها أسلمت وجهي","وقبلة حاجبيها الأزهرين",78,"ن",1,0],["لكَ عرَّضتهُ فاعرضتَ عنهُ","يا خليلي فهل رأَيتَ اعتراضا",79,"ض",2,0],["لك عهد ود سابق","لا تنس يا مولاي عهدك",80,"ك",1,0],["لك عبد إذا شجته الخطايا","يتسلى بأنه لك يعزى",81,"ز",2,0],["لك عندي ما عشت يا ابن رسو","ل اللَه حزن يفي بحق ودادي",82,"د",2,0],["لك عمر أحلام الورود وعمر","أقمار الخلود تزفها الأكوانُ",83,"ن",1,0],["لك عرش بكل قلب وفي كل","ل يد سيف تجد مصقول",84,"ل",1,0],["لكَ عبرةٌ بي لو فقهت صبابتي","ودرستَ في عهدِ الغرام كتابي",85,"ب",2,0],["لك عند الإله وجه وجيهٌ","ما عدته طلاقة وحياء",86,"ا",2,0],["لك عاد بطن الأرض أفسح منزل","والكون بعدك ضاق رحب فضائه",87,"ا",3,0],["لك عزمة الشاهين حقا يا ابنه","وسطا العقاب بكل أخيل زاق",88,"ق",1,0],["لك عفة اشبهت فيها يوسفاً","وطهارة اشبهت فيها مريما",89,"م",2,0],["لك عزم حكى الحسام انتضاء","وبايماضه حكى آرائك",90,"ك",1,0],["لك عند ربك الف اجر","مجاهد في الكافره",91,"ر",2,0],["لك عين دعجة لو لم يكن","لحظها السيف لما قدَّ المجنَّا",92,"ن",2,0],["لك عينتُ يوم لقيا وعنه","سل بريدا ما بين قلبي وقلبك",93,"ك",1,0],["لك عند ربك شأو منزلة سمت","في الجنة العليا لها التخليد",94,"د",1,0],["لك عندَنا ذكرٌ يهبُّ نسيمُهُ","فَيُسيلٌ مِن سُحُبِ الدموع سُيولا",95,"ل",2,0],["لَكَ عَارضٌ لَمَّا أَعْتَرَضْتُ رَأَي","إِطْلاَقَ جَارِي الدَّمْعِ في نَقْدِي",96,"د",2,0],["لك عينُ غرندل قائلة","إنا أعطيناك الكوثر",97,"ر",1,0],["لك عابد الرحمن بيك مظهرٌ","ما النجم إلا تحت موطئ نعله",98,"ل",2,0],["لك عيني سوادها ابيض لما","غساته حزنا بماء البكاء",99,"ا",2,0],["لك عند الآله جاه وجيه","حيث أنت الأواه أنت المنيب",100,"ب",1,0],["لك عندي وإن تناسيت عهد","في صميم الفؤاد غير نكيث",101,"ث",1,0],["لك عهدٌ علىَّ ان ليس شيء","لك يا مال في الدّنى بكفاء",102,"ا",2,0],["لك عقل سناه يهدي الحيارى","لك عزم ماضٍ بكل قضيه",103,"ه",1,0],["لك عن