{"poems":[[77,"لك عاذل بثقيله وخفيفه","https://www.aldiwan.net/poem36629.html","الكامل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[72,"لك عارض لدموع عيني ممطر","https://www.aldiwan.net/poem18775.html","الكامل"],[72,"رشقتني من اللحاظ بغمزه","https://www.aldiwan.net/poem19000.html","الخفيف"],[72,"لا تخف عيلة ولا تخش فقرا","https://www.aldiwan.net/poem19600.html","الخفيف"],[72,"لا وخمر بابليه","https://www.aldiwan.net/poem20560.html","مجزوء الرمل"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[56,"لك عندي من طيب الورد أطبا","https://www.aldiwan.net/poem58539.html","الخفيف"],[45,"نعتد أنحسنا بعزك أسعدا","https://www.aldiwan.net/poem62770.html","الكامل"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[44,"لك علم بعبرتي واشتياقي","https://www.aldiwan.net/poem30201.html","الخفيف"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[52,"قد سقتني خمرا وريقا كخمر","https://www.aldiwan.net/poem27022.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42536","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[85,"خُذوا القمَّة َ علماً وبيانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9587&r=&rc=77",""],[110,"أترى أين حل أم أين أمسى","https://www.aldiwan.net/poem16243.html","الخفيف"],[110,"من لي به والسحر ملئ جفونه","https://www.aldiwan.net/poem16259.html","الكامل"],[116,"لك عند عبدك موطن في قلبه","https://www.aldiwan.net/poem40937.html","عموديه"],[144,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[205,"لم إذا ما مررت تهت علينا","https://www.aldiwan.net/poem53215.html","الخفيف"],[212,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[222,"قد عشقناك لا لأنك أنثى","https://www.aldiwan.net/poem55278.html","الخفيف"],[222,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[224,"أسمعيني لحن الردى أسمعيني","https://www.aldiwan.net/poem41621.html","الخفيف"],[230,"ما محا الذنب عن ذوي الاقتراف","https://www.aldiwan.net/poem50947.html","الخفيف"],[230,"لست أدرى من المعلى المهنا","https://www.aldiwan.net/poem51270.html","الخفيف"],[236,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[271,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[298,"نفحتنا بنشرها المستطاب","https://www.aldiwan.net/poem33332.html","الخفيف"],[299,"أمل تدركه العين وأين","https://www.aldiwan.net/poem36859.html","عموديه"],[365,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[367,"لك عندي يد وما للساني","https://www.aldiwan.net/poem17284.html","الخفيف"],[430,"واحر قلباه من ظبيٍ أخي ميس","https://www.aldiwan.net/poem39887.html","البسيط"],[438,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[438,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[465,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[469,"لك عندي مينا من الهليون","https://www.aldiwan.net/poem59607.html","الخفيف"],[469,"لك عندي دستيجة مختومه","https://www.aldiwan.net/poem59675.html","الخفيف"],[480,"أنا فرد لا اثنان ما دمت حيا","https://www.aldiwan.net/poem36876.html","الخفيف"],[501,"أنت أهل المعروف يا معروف","https://www.aldiwan.net/poem37952.html","الخفيف"],[552,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[559,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[559,"لكعبة الوصف ذات قبلها ذات","https://www.aldiwan.net/poem34712.html","البسيط"],[559,"ليت شعري مذ كررت نظراتي","https://www.aldiwan.net/poem34727.html","الخفيف"],[563,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"]],"verses":[["لكَ عاذِلٌ بثَقيلِهِ وخَفيفِه","بيْنَ النِّدامِ غَبوقُهُ وصَبوحُهُ",0,"ه",1,1],["لك عين ترى السها في الدياجي","وعن الشمس في الضحا تتعامى",1,"م",2,0],["لك عارضٌ لدموع عيني ممطر","فدَعِ الجفاءَ فلست ممن يصبر",2,"ر",1,1],["لك عزم أجرى السحاب بفضلٍ","قد غدا ساحباً من الحمد خزّه",3,"ز",2,0],["لكَ عين وقامة كل يوم","تلك غزَّالة وذي فتَّاله",4,"ه",1,0],["لك عندِي صدقات","وإفادات خفيَّه",5,"ي",2,0],["لك عندي صَنيعةٌ ما سقاها","غيرُ وَسْميِّك القديمِ سحابُ",6,"ب",1,0],["لك عدلُ ذي تقوى وظلم أخي ندى","لا ظلم غصّابٍ ولا بخّاس",7,"س",1,0],["لك عرض ليس من عاداته","أن يرى فيه من الذم طبع",8,"ع",1,0],["لك عادةٌ في القُطن غيرُ ذميمةٍ","وهو الرياش وأنت إبراهيمُ",9,"م",1,0],["لكَ عُذرٌ أن لا تنام لعمري","أنا أدهى من أن ينام سليمي",10,"م",2,0],["لك عرفٌ لم يُحِط شكري به","جَلَّ ركناً حَضَنٌ أن يُحتَضن",11,"ن",1,0],["لَكَ عِندَ اِبنَي أَو عِندي يَدٌ","لَستُ آلوها اِدِّكاراً أَو صِيانا",12,"ن",2,0],["لَكَ عِنْدي مِن طَيِّبِ الوَرْدِ أَطْبَا","قٌ تُدْنِي بَعِيدَ سُرورِكْ",13,"ك",1,1],["لَكَ عادَةٌ أَلّا تَزالَ شَريكَهُ","مِمّا عَناهُ مُرافِقاً أَو مُسعِدا",14,"د",2,0],["لَكِ عَهدٌ لَدَيَّ غَيرُ مُضاعِ","باتَ شَوقي طَوعاً لَهُ وَنِزاعي",15,"ع",2,1],["لَكِ عَينٌ إِن يَنبعِ السحرُ منها","فهو بالخَبْلِ في العقول يغورُ",16,"ر",1,0],["لَكَ عِلمٌ بِعَبرَتي وَاِشتِياقي","وَالَّذي بي مِن لَوعَةٍ وَاِحتِراقِ",17,"ق",1,1],["لك عند قومِكَ ما تحبُّ وتَشتهِي","في ذلكَ الحَرمِ المُمنَّعِ والحِمَى",18,"م",2,0],["لَكَ عِندِيَ عَتقٌ مِنَ الدَمعِ إِن صَح","حَ الَّذي قُلتِهِ وَلَو بَعدَ شَهرِ",19,"ر",1,0],["لَكَ عِندَ البِرِّ في مَلجَئِهِ","حَيثُ تَأوي خاطِرٌ لَن يُكسَرا",20,"ر",2,0],["لَكَ عِرْضٌ أَرَقُّ نَسْجَاً مِنَ الرِّي","حِ وَأَوْهَى مِنْ طَيْلَسانِ ابْنِ حَرْبِ",21,"ب",1,0],["لك عند رب العرش أجر مجاهدٍ","فانعم برحمته وعدن جنانه",22,"ن",2,0],["لَكَ عُمْرُ النَّدَى يَطِيرُ مَعَ الشَّمْسِ","وَعُمْرُ الْبُرُوقِ بَيْنَ السَّحابِ",23,"ب",1,0],["لك: عدوُ الظباء سارت خفاقًا","وزئيرُ الأسودِ ثارت غضابا",24,"ب",2,0],["لَك عند النجوم إرثٌ مُضاعٌ","لا تقل: كيف أستطيعُ الصُّعُودا؟",25,"د",2,0],["لك عرش العلم في أبهته","وله سلطانه في الملل",26,"ل",1,0],["لك عند الجُرْدِ الاصائلِ دَيْنٌ","مستَحقُّ الأداءِ في النَسل لازِم",27,"م",1,0],["لك عمٌّ احيا مزايا ذويه","وأرانا الجدودَ تنفُضُ رمْسا",28,"س",2,0],["لك عند ابْنِيَ أَو عندي يدٌ","لستُ آلوها ادكاراً وصِيانا",29,"ن",2,0],["لَكَ عِندي مِن الحُقوق عُهود","باقِيات وَنعمة لَيسَ تَنسا",30,"س",2,0],["لَكَ عَزمة في النائِبات وَسودد","كَعُلى الكِرار في صَفينِهِ",31,"ن",2,0],["لك عند عبدك موطن في قلبه","بحضوره رحب الحمى وبسلبه",32,"ه",1,1],["لَكَ عَزمَةٌ كَالسَيفِ بَل أَمضى شَباً","مِن رُتبَةٍ كَالشَمسِ بَل هِيَ أَرفَعُ",33,"ع",1,0],["لك عِلمٌ بأنَّني بك أَلهُو","أنا واللَهِ فوق شوق المَشُوقِ",34,"ق",1,0],["لك عينٌ هي سحر وفتون","يرجع الصب إليها يرجع",35,"ع",1,0],["لك عقل لا كالعقول ونفس","لأجل الميول كالميدان",36,"ن",1,0],["لك عزم من القضاء وذكر","مشرق في الزمان إشراق شمس",37,"س",1,0],["لَكِ عِندي وَصيَّةٌ فَاِحفَظيها","هيَ بَعد المَماتِ أَن تَنسيني",38,"ن",2,0],["لك عندي فقَرَّ عينا من المُكْ","نَة ما لا تُحْصِيه مِنّي القوافي",39,"ف",2,0],["لك عند الزمانِ عهدٌ جميلٌ","ولَدَى المَكْرُمات حسنُ بلاء",40,"ا",2,0],["لَكَ عِفَّةٌ في قُدرَةٍ وَتَواضُعٌ","في عِزَّةٍ وَشَراسَةٍ في لينِ",41,"ن",1,0],["لكَ عبرةٌ ونهىً من الدولِ التي","تبغي وتفتكُ أو تروغُ وتمكر",42,"ر",1,0],["لَكَ عِندي مودَّةٌ أَحكمَتها","يَدُ صِدقٍ وثيقةُ الأَسبابِ",43,"ب",1,0],["لكَ عندي نِعَمٌ أَيسرها","طاهرُ الحبِ وعطفُ الأَبوين",44,"ن",1,0],["لك عن حِماكَ دفاعُ لَيْثٍ مُشبِلٍ","ولِمَنْ رجَاك قطارُ غَيْثٍ مُسْبِل",45,"ل",1,0],["لَكَ عِندي يَدٌ وَما لِلِساني","بِيَدٍ تَملَأُ الرُءوسَ يَدانِ",46,"ن",1,1],["لكعبة الحسن ركنٌ خالهُ فإذا","تعذّرَ اللثم بالإيماءِ نلثمهُ",47,"ه",1,0],["لك عهد في القلب غير مضاع","بوداد للغانيات وثيق",48,"ق",1,0],["لك عرض لا يعروه قذى","ومقال قورن بالسدد",49,"د",1,0],["لكَ عندي مننٌ واضحةٌ","في جلابيبٍ من الأيام دكن",50,"ن",1,0],["لَكَ عِندي مينا مِنَ الهَليونِ","حَولَهُ عَسجَدٌ مِنَ الطَردينِ",51,"ن",1,1],["لَكَ عِندي دَستيجَةٌ مَختومَه","وَبَلَسقِيَّةٌ لَها أَلفُ قيمَه",52,"م",2,1],["لك عونان بالحقوق وضعفي","ولهذا قد انتصرت عليا",53,"ي",2,0],["لكَ عَزمٌ في حَضرةِ الصِّدقِ أبْدَى","سِرَّ قُدْسٍ بُرْهانُهُ مَوْصوفُ",54,"ف",1,0],["لك عِبرَةٌ فيمنْ عَرَتْ","هُ وعبرةٌ فيمن عَراها",55,"ا",3,0],["لك عينان عين غيب تراه","وتراه الأخرى فتصرف صرفا",56,"ف",2,0],["لكعبة الوصف ذات قبلها ذاتُ","فهي الذوات ثلاث المستعزاتُ",57,"ت",1,1],["لك عندي في الكل صورة وجه","جل عن كل صورة بالتفات",58,"ت",1,0],["لكَ عندَنا شوقٌ يطُولُ فهلْ لنا","صَبرٌ يطولُ عليهِ إنْ طالَ المَدَى",59,"ا",1,0]]}