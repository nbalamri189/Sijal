"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5145,"وفد الربيع مبشّراً فاستبشر","https://www.poetsgate.com/ViewPoem.aspx?id=108052",""],[5183,"روضة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=180198",""],[5295,"سنا مجدِنا","https://www.poetsgate.com/ViewPoem.aspx?id=177366",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"على لسان الحرية...","https://www.poetsgate.com/ViewPoem.aspx?id=209177",""],[5436,"لي فيك شكوى / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177539",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[5564,"يالله بليلة من خيار الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=186846",""],[5582,"إِلَى التِّيهِ مالَتْ لَها أَنْ تَمِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5725,"لي فيك شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=177419",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5843,"خيل الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=51277",""],[5851,"شهقة السنديان","https://www.poetsgate.com/ViewPoem.aspx?id=175298",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[6115,"يشهد له اهل المعرفه والصحافه","https://www.poetsgate.com/ViewPoem.aspx?id=196468",""]],"verses":[["صُقِلَت نُصولُ خُدودِهِم بيدِ الصِبا","مُردُ العَوارِضِ في زَمانٍ أَمرَدِ",0,"د",1,0],["صَقيلَينِ تَستَلُّنا النائِباتُ","فَتُثلَمُ فيهِنَّ وَالدَهرُ نابِ",1,"ب",1,0],["صَقيلُ الطَبعِ رَقراقُ الحَواشي","كَما اِصطَفَقَت عَلى الرَوضِ الأَضاءُ",2,"ا",2,0],["صَقيلُ الحَواشي مَسْرَحُ الحَمْدِ عندَهُ","رَحيبٌ وما فيهِ مُعَرَّسُ ذامِ",3,"م",1,0],["صَقرٌ يَصيدُ بِظُفرِهِ وَجَناحِهِ","فَإِذا أَصابَ حَمامَةً بِالعَوسَجِ",4,"ج",1,0],["صَقَعنا بِها الحِزّانَ حَتّى تَواضَعَت","قَراديدُها إِلاّ فُروعَ الحَوارِكِ",5,"ك",1,0],["صَقعَبُ والِدٌ لِأَبيكَ قَينٌ","لَئيمٌ حَلَّ في شُعَبِ الأُرومِ",6,"م",1,1],["صَقراً تَوَسَّطَ في الأَنصارِ مَنصِبُهُ","حُلوَ السَجِيَّةِ مَحضاً غَيرَ مُؤتَشَبِ",7,"ب",1,0],["صقيل الخدِّ أبصر من رآه","سواد العين فيه فخال خالا",8,"ل",2,0],["صقيلٌ صقال الطبع لم يُكسَ غيرُهُ","صقالاً ولم يَعْهدهُ مذ قُدَّ مِدْوَسُ",9,"س",1,1],["صَقَلَت مُكافَحَةُ الشَدائِدِ نَفسُهُ","وَالرَوضُ تَجلو حُسنُهُ الأَمطارُ",10,"ر",1,0],["صَقر وَوَرقاء وَمِن عَجَبٍ","أَن تَحتَمي الوَرقاءُ بِالصَقرِ",11,"ر",1,0],["صُقِلَ الزمانُ فعادَ في أيامِه","كالبُردِ في تفويفِه وصِقالِه",12,"ل",2,0],["صُقِلَتْ سَلاسِلُهُ وكُسِّرَتْ","بأناملٍ مثلِ اللُّجينِ سِباطِ",13,"ط",1,0],["صقيل أديم الجسم بالقسر سعيه","وليس له روح وليس له نفس",14,"س",1,0],["صَقَلَت تَجاريبُ الأُمورِ مُتونَها","كَالسَيفِ يُصلِحُهُ الصِقالُ وَيُخلِصُ",15,"ص",1,0],["صقليَّةٌ كاد الزمانُ بلادها","وكانت على أهلِ الزّمان محارسا",16,"س",2,0],["صَقَلَتْ مَتْنَهُ مداوسُ شمسٍ","مِن خِلالِ الغُصونِ صَقلاً مُجدَّد",17,"د",1,0],["صَقيلٍ تَخالُ بِهِ بَيضَةً","تَروقُكَ تَحتَ جَناحِ الظَلامِ",18,"م",1,0],["صَقرٌ يَصيدُ إِذا غَدا بِجَناحِهِ","وَبِخَطمِهِ وَيَصيدُ بِالأَظفارِ",19,"ر",1,0],["صقيلاتُ أبْشارِ البُرُوقِ كأنّمَا","أُمِرّتْ عليها بالسَّحابِ المَداوك",20,"ك",1,0],["صقيلُ النُّهى لا ينكثُ السيفُ عهدَه","إذا غرّتِ القومَ العهودُ النكائث",21,"ث",1,0],["صَقَعتُكَ بِالغُرِّ الأَوابِدِ صَقعَةً","خَضَعتَ لَها فَالقَلبُ مِنكَ جَريضُ",22,"ض",1,0],["صَقْرٌ على كَفهِ صَقْرٌ يُؤلّفُهُ","ذا فوقَ بَغْلٍ وَهَذا فَوقَ قُفَّازِ",23,"ز",1,0],["صقعت ابن ثوب صقعة لاحجى لها","يولول منها كل آس وعائد",24,"د",1,0],["صقر قريش منعوه جلقا","فطار في قرطبة وحلقا",25,"ق",2,0],["صقرٌ حسامٌ بكف العربُ منْصَلِتٌ","ماضي الغرار، إذا حَدُّ الحُسَام نبا",26,"ب",2,0],["صقرٌ هو الصقر في جوِّ السماء، إذا","ما أصبح الصقرُ في جو السماءِ دَبي",26,"ب",2,0],["صقر ومَن مثلُ صقر في أرومته؟","هو المنسَّبُ خالاً، والكريم أبا",26,"ب",2,0],["صقر أميرًا، وصقر سوقةً، رجلٌ","يعيش رأسًا، أشمَّ الأنف، لا ذَنَبا",26,"ب",2,0],["صَقْرٌ يضيق مَطارُه بجناحه","حتى يخالُ الجوَّ غيرَ وسيع",27,"ع",1,0],["صَقَلتَني يَد التَجارُب حَتّى","صَحَ عَزمي وَطابَ مِنهُ الغرارُ",28,"ر",1,0],["صقلوا الشعور ومسدوا أثوابهم","ومن البطالة فوقهم أثقال",29,"ل",1,0],["صقيلٌ كخد الصبح سمحٌ كنوره","نقيٌّ كصوب العارض المتراكم",30,"م",1,0],["صقَل الرأى بالتجاربِ حتى","هو أنقى مَتنٍ وأذلقُ غربِ",31,"ب",1,0],["صقيل طراز المجد أروع باسل","له نشوة عند السطا والمكارم",32,"م",1,0],["صقيعٌ في مرافي الرّوحِ يرسو","بوخزِ الثلجِ يجرحُ ثم يقسو",33,"و",1,1],["صقلية في البحر أيضا رأيتها","فأقبل ماء العين من حزنه يجرى",34,"ر",2,0],["صِقالُ سَوالِفِ وَجهِ الحَبيبِ","أَراني بِها هُدبَ عَيني عَذارا",35,"ر",2,1],["صَقَل البِشْرُ مُحَيّا وجهه","فَجلا عن ناظرِ الحُرِّ القَتاما",36,"م",2,0],["صَقيلٌ حَدُّ صارِمِه ولكنْ","يُدِبُّ فِرِنْدُهُ فيه النِّمالا",37,"ل",2,0],["صقيلُ مضارب العزمات ماضٍ","فلا فُلَّت مضاربُه الصّقال",38,"ل",1,0],["صَقَلَتْنِي الخطوبُ والسيفُ يَخْفَى","عَيْبُهُ في صَدَاهُ قَبْلَ الصِّقالِ",39,"ل",1,0],["صُقِلَتْ صَفْحَتَا صِقِلِّيِةٍ مِنْ","كَ فوافَتْ كالصَّارمِ البَتَّارِ",40,"ر",1,0],["صقيلاتُ أبشارِ البروقِ كأنّما","أُمرَّتْ عليها بالشموسِ المداوكُ",41,"ك",1,0],["صقورٌ إن هوَتْ والقافُ فاءٌ","إذا ما وُقّفَتْ والراءُ نونُ",42,"ن",1,0],["صقَلتْهُ النسيمُ حتى بدتْ في","هِ ازوِراراً أَسِرَّةُ الانقباضِ",43,"ض",1,0],["صقيل الصفح لا يعلوه غش","طرير الحد ليس به فلول",44,"ل",1,0],["صقيلة حيث السجاب صدأ","وكلف في وجنتي زمانها",45,"ن",3,0],["صقور جيادٍ والمواضي مخالبٌ","لها وأسودٌ والذوابل غيل",46,"ل",1,0],["صَقرٌ إِذا مَعشَرٌ يَوماً بَدا لَهُمُ","مِنَ الأَنامِ وَإِن عَزّوا وَإِن مَجَدوا",47,"د",3,0],["صقلَتْ ذِهنَهُ التّجاربُ حتّى","صُوَرُ الكائِناتِ فيهِ رآها",48,"ا",3,0],["صقلَ الإلهُ حسامَه وأزارَه","طَلْقاً بكلِّ تهلُّلٍ وتألُّق",49,"ق",1,0],["صُقْعٌ لآلِ اللّه آلِ نَبيّهِ","سجدتْ له الأقطارُ والأصقاعُ",50,"ع",1,0],["صَقَلتُم مَجدَ أَجسامٍ عِجافِ","مُهَذَّبَةٍ بِأحسابٍ سِمانِ",51,"ن",1,0],["صَقَلَتكَ حَتَى أرهفَتكَ ولَم تَزل","قِطَعُ الضَّريبَةِ بالحُسامِ المُرهَفِ",52,"ف",1,0],["صقيل لأهل الهند ينسب طبعه","ولكن فعالى غير ما تفعل الهند",53,"د",1,0],["صقالا لما قد حبيتن من","هبات الكريم كريم شعور",54,"ر",1,0],["صقَلَته صَقلَ ذي جدّ وَمُجتَهدٍ","حَتّى صَفا وَبَدَت فيهِ اِستِناراتُ",55,"ت",1,0],["صقرُ الخليج إذا كان الصِّيَال بَدا","له علَى حاسديه النصرُ والغَلَبُ",56,"ب",1,0],["صقيل حواشي الحزم والعزم والعلي","ثقيل حصاة الحلم أغلب ساميا",57,"ي",2,0],["صَقَلَ الصَبا أَعرافَهُنَّ وَمَسَّحَت","مِنها المُتونَ مِنَ البَوارِقِ أَلسُنُ",58,"ن",1,0],["صَقْعاً تَخِرُّ البُزلُ مِنْهُ صَعَقا","فِي رَأسِ رَأَّاسٍ إِذَا ما أَطْبَقا",59,"ق",2,0],["صقراً يصيد أهلةً يلمعن من","أعلى بدورٍ تحتهن بحور",60,"ر",1,0],["صقرٌ يمد الصقور جناحه","فتخالها في الجو سرب حمامِ",61,"م",1,0],["صَقيلُ حُسَامِ الفِكْرِ يَلْقاكَ رَأْيُهُ","لمّا غابَ عَنْ أَلْحاظِهِ كَالمُشاهِدِ",62,"د",1,0],["صقيلات ما فوق الظهور إلى الطلى","وما خطت الأعناق فوق الترائب",63,"ب",1,0],["صقلت به الأيَّامُ غرَّتها","وجلت وجوهَ سعودِها الغُرّ",64,"ر",1,0],["صَقتَ وبلغتَ الرسالةَ صادقاً","ومَت صليب العودِ أبلج صافيا",65,"ي",2,0],["صقور أبو بدور أو بحور","وإن لم تلق مثلهم رجالا",66,"ل",2,0],["صقيلَ المتنِ رَوْنَقُهُ الأماني","وماضي الحدِّ جَوْهرُه المنون",67,"ن",1,0],["صُقورٌ أو بدورٌ أو بحورٌ","وإنْ لم تلقَ مثلَهُمُ رجالا",68,"ل",2,0],["صَقرٌ أَحَمُّ غَذا بِلَحمٍ أَفرُخاً","في ذي شَواهِقَ مِن ذُرى مِحراجِ",69,"ج",1,0],["صقلتم نُهانا فلانت لنا","صعابُ الأماني بفضلِ الإله",70,"ه",1,0],["صَقَلٌوا بعلمهم النُّهى","هذا هو الفضلُ المُبين",71,"ن",1,0],["صقيل رداء العرض من غدر خلة","وطاهر ماء الوجه من رد عادم",72,"م",1,0],["صقلوا حاشية الدهر فتى","وأقاموا من خدود المصعرين",73,"ن",1,0],["صقيلُ فِرَنْدٍ لا يرينُ لقادحٍ","ولا ثالبٍ منه قَذى العار عاركُ",74,"ك",1,0],["صقورُ البوادِي من لحومِ عُداتهِ","عليهِ ومن والاه يُثْني بإخلاصِ",75,"ص",1,0],["صقيلَ النهى لا يُسْتَرابُ من اقتدى","بمحضِ ثنائي للأجلِّ وإِخلاصي",75,"ص",2,0],["صقلتهم الآداب صقل مهند","لكن لهم كرم الطباع مضاء",76,"ا",2,0],["صَقَعَ البُغاةَ فَأَصبَحَت فُرسانُهُم","صَرعَى كَزَرعٍ صابَهُ إِعصارُ",77,"ر",1,0],["صَقَلَتنا فَاِرتَفَعنا عِزَّةً","وَاِستَرَقَّ الطَبعُ فينا شَمَما",78,"م",2,0],["صَقَلْتَ العُلى بالمَكْرُماتِ وإِنّما","تَنِمّ بأَسرار السّيوفِ الصَّياقِلُ",79,"ل",1,0],["صقلت بك البيض القوافي متونها","ويبرز افرند الحسام على الصقل",80,"ل",1,0],["صقرين طارا للعلاء فحلقا","حتى إذا وقفا على غاياتها",81,"ت",3,0],["صقيل محيا ماج ماء جماله","ومن موجه في خده ذكي الجمر",82,"ر",1,0],["صقلت ذهنه التجاربُ حتى","مثل الغيبَ ذهنهُ فتمثل",83,"ل",1,0],["صقيل خدوده مرآت قلبي","وماء الحسن رق به وراقا",84,"ق",2,1],["صَقيلُ صفحٍ يزِلُّ الماءُ عنهُ إِذا","جَرى به عَرَقٌ من خدكِ القاني",85,"ن",2,0],["صقلته فتجلى","بلمعة تتموج",86,"ج",1,0],["صقلوا بالجِلادِ والقَينُ يُعطي","كَ فِرِنْدَ الحُسامِ بعدَ الصِّقالِ",87,"ل",1,0],["صقيل لو قذفت به اللَّيالي","لشبَّ دجاه نار ذكا وأذكا",88,"ك",2,0],["صقرٌ هي العنقاءُ من دونهِ","قد صادهُ الدهرُ بشِصّ الودى",89,"د",2,0],["صقيلات الترائب ناعمات","كأغصان على كثب دعاص",90,"ص",1,0],["صقيلة جلدٍ تنثني إن ثنيتها","فتوشك أن تبدو لديك بلا حجم",91,"م",1,0],["صقيل السَّراةِ جميلَ القَطاة","سليم الشَّظاة من البربرِ",92,"ر",1,0],["صقر توسّط من كعب اذا نسبوا","بحبوحة المجد والشمّ الرفيعات",93,"ت",1,0],["صقيل الخد زينه بصدغ","معثكل جعده زان المتونا",94,"ن",2,0],["صقيلاً جاءَ للمظلوم نوراً","وللظلام ناراً لا تبادُ",95,"د",1,0],["صقرٌ جناحاهُ إذا رامَ الذُّرى","إسلامهُ والهِمَّةُ العَرْبَاءُ",96,"ا",2,0],["صُقِلتْ بِضَرْبٍ قد أبى أن تكتسي","أَغمادَها أو تكتسي أصداءها",97,"ا",3,0],["صَقرُ قُرَيشٍ فيهِمُ قادِمٌ","لِلَّهِ ذا الداخِل وَالقادِمُ",98,"م",1,0],["صقور في الفضا الرحب","تزجيها الشياطين",99,"ن",1,0],["صَقَلَتهُ بِقَضيبٍ ناضِرٍ","مِن أَراكٍ طَيِّبٍ حَتّى نَصَع",100,"ع",1,0],["صقيل كمثل السيف أخضر مثله","يبيت ولكن من فؤاديَ في غمد",101,"د",1,0],["صقَلَتهُ أنفاسُ النَّسي","مِ بمرِّهِنَّ فليس يَصدَا",102,"د",2,0],["صقيلٌ نضت منه كفُّ العلا","حساماً صقيلاً ورمحاً كعوبا",103,"ب",2,0],["صقرٍ اليا منه كفخ يضرب بمخلابٍ حديد","تشوف عجة مخلبه لاجابها بترابها",104,"ب",3,0],["صقيلة خد دون سلسال ثغرها","يري كل صب هايم القلب صاديا",105,"ي",2,0],["صَقِيِعٌ بِجِسْمِي وَوَخْزٌ بِدَمْعِي","فَقَدْ كُنْتَ جَوِّي ثُلُوجِي وَنَارِي",106,"ر",2,0],["صقيل المحيا لا من الداء طعمها","له بين أثناء الفؤاد مقيل",107,"ل",1,0],["صقل الهواء فراق نوراً بعدما","فرش ال