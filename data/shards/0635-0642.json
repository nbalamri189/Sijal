{"poems":[[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[53,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[6,"طرق الخيال ولا كليلة مدلج","https://www.aldiwan.net/poem384.html",""],[30,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[23,"صقعب والد لأبيك قين","https://www.aldiwan.net/poem21391.html","الوافر"],[23,"يا عين جودي بدمع منك منسكب","https://www.aldiwan.net/poem21464.html","البسيط"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[51,"صقيل صقال الطبع لم يكس غيره","https://www.aldiwan.net/poem64688.html","الطويل"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[61,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[66,"وما اسم له شطر صحيح منطق","https://www.aldiwan.net/poem38427.html","الطويل"],[66,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[80,"لأمر طويل الهم نزجي العرامسا","https://www.aldiwan.net/poem31418.html","الطويل"],[80,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[74,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[75,"لمن صولجان فوق خدك عابث","https://www.aldiwan.net/poem69097.html","الطويل"],[15,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem45262.html","الطويل"],[76,"خرجت أجتاز قفرا غير مجتاز","https://www.aldiwan.net/poem39289.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[109,"لم تمل بي عن العفاف العقار","https://www.aldiwan.net/poem16460.html","الخفيف"],[115,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[120,"يرى من ستور الغيب حتى كأنما","https://www.aldiwan.net/poem49290.html","الطويل"],[142,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[160,"شهدت لقد أعليت كعب المكارم","https://www.aldiwan.net/poem58777.html","الطويل"],[178,"الزفت","https://www.aldiwan.net/poem50700.html","الوافر"],[211,"سلام على البحر الخضم وموجه","https://www.aldiwan.net/poem46233.html","الطويل"],[349,"صقال سوالف وجه الحبيب","https://www.aldiwan.net/poem15658.html","المتقارب"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[364,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[416,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[432,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[432,"سفرت عنك أوجه الأسفار","https://www.aldiwan.net/poem12416.html","الخفيف"],[432,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[432,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[452,"خفقت نسمة الصبا في الرياض","https://www.aldiwan.net/poem13822.html","الخفيف"],[464,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[464,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[464,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[470,"يحمي ذمارهم في كل مفظعة","https://www.aldiwan.net/poem4669.html","البسيط"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[551,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[551,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"]],"verses":[["صُقِلَت نُصولُ خُدودِهِم بيدِ الصِبا","مُردُ العَوارِضِ في زَمانٍ أَمرَدِ",0,"د",1,0],["صَقيلَينِ تَستَلُّنا النائِباتُ","فَتُثلَمُ فيهِنَّ وَالدَهرُ نابِ",1,"ب",1,0],["صَقيلُ الطَبعِ رَقراقُ الحَواشي","كَما اِصطَفَقَت عَلى الرَوضِ الأَضاءُ",2,"ا",2,0],["صَقيلُ الحَواشي مَسْرَحُ الحَمْدِ عندَهُ","رَحيبٌ وما فيهِ مُعَرَّسُ ذامِ",3,"م",1,0],["صَقرٌ يَصيدُ بِظُفرِهِ وَجَناحِهِ","فَإِذا أَصابَ حَمامَةً بِالعَوسَجِ",4,"ج",1,0],["صَقَعنا بِها الحِزّانَ حَتّى تَواضَعَت","قَراديدُها إِلاّ فُروعَ الحَوارِكِ",5,"ك",1,0],["صَقعَبُ والِدٌ لِأَبيكَ قَينٌ","لَئيمٌ حَلَّ في شُعَبِ الأُرومِ",6,"م",1,1],["صَقراً تَوَسَّطَ في الأَنصارِ مَنصِبُهُ","حُلوَ السَجِيَّةِ مَحضاً غَيرَ مُؤتَشَبِ",7,"ب",1,0],["صقيل الخدِّ أبصر من رآه","سواد العين فيه فخال خالا",8,"ل",2,0],["صقيلٌ صقال الطبع لم يُكسَ غيرُهُ","صقالاً ولم يَعْهدهُ مذ قُدَّ مِدْوَسُ",9,"س",1,1],["صَقَلَت مُكافَحَةُ الشَدائِدِ نَفسُهُ","وَالرَوضُ تَجلو حُسنُهُ الأَمطارُ",10,"ر",1,0],["صَقر وَوَرقاء وَمِن عَجَبٍ","أَن تَحتَمي الوَرقاءُ بِالصَقرِ",11,"ر",1,0],["صُقِلَ الزمانُ فعادَ في أيامِه","كالبُردِ في تفويفِه وصِقالِه",12,"ل",2,0],["صُقِلَتْ سَلاسِلُهُ وكُسِّرَتْ","بأناملٍ مثلِ اللُّجينِ سِباطِ",13,"ط",1,0],["صقيل أديم الجسم بالقسر سعيه","وليس له روح وليس له نفس",14,"س",1,0],["صَقَلَت تَجاريبُ الأُمورِ مُتونَها","كَالسَيفِ يُصلِحُهُ الصِقالُ وَيُخلِصُ",15,"ص",1,0],["صقليَّةٌ كاد الزمانُ بلادها","وكانت على أهلِ الزّمان محارسا",16,"س",2,0],["صَقَلَتْ مَتْنَهُ مداوسُ شمسٍ","مِن خِلالِ الغُصونِ صَقلاً مُجدَّد",17,"د",1,0],["صَقيلٍ تَخالُ بِهِ بَيضَةً","تَروقُكَ تَحتَ جَناحِ الظَلامِ",18,"م",1,0],["صَقرٌ يَصيدُ إِذا غَدا بِجَناحِهِ","وَبِخَطمِهِ وَيَصيدُ بِالأَظفارِ",19,"ر",1,0],["صقيلاتُ أبْشارِ البُرُوقِ كأنّمَا","أُمِرّتْ عليها بالسَّحابِ المَداوك",20,"ك",1,0],["صقيلُ النُّهى لا ينكثُ السيفُ عهدَه","إذا غرّتِ القومَ العهودُ النكائث",21,"ث",1,0],["صَقَعتُكَ بِالغُرِّ الأَوابِدِ صَقعَةً","خَضَعتَ لَها فَالقَلبُ مِنكَ جَريضُ",22,"ض",1,0],["صَقْرٌ على كَفهِ صَقْرٌ يُؤلّفُهُ","ذا فوقَ بَغْلٍ وَهَذا فَوقَ قُفَّازِ",23,"ز",1,0],["صقر قريش منعوه جلقا","فطار في قرطبة وحلقا",24,"ق",2,0],["صقرٌ حسامٌ بكف العربُ منْصَلِتٌ","ماضي الغرار، إذا حَدُّ الحُسَام نبا",25,"ب",2,0],["صقرٌ هو الصقر في جوِّ السماء، إذا","ما أصبح الصقرُ في جو السماءِ دَبي",25,"ب",2,0],["صقر ومَن مثلُ صقر في أرومته؟","هو المنسَّبُ خالاً، والكريم أبا",25,"ب",2,0],["صقر أميرًا، وصقر سوقةً، رجلٌ","يعيش رأسًا، أشمَّ الأنف، لا ذَنَبا",25,"ب",2,0],["صَقْرٌ يضيق مَطارُه بجناحه","حتى يخالُ الجوَّ غيرَ وسيع",26,"ع",1,0],["صَقَلتَني يَد التَجارُب حَتّى","صَحَ عَزمي وَطابَ مِنهُ الغرارُ",27,"ر",1,0],["صقلوا الشعور ومسدوا أثوابهم","ومن البطالة فوقهم أثقال",28,"ل",1,0],["صقيلٌ كخد الصبح سمحٌ كنوره","نقيٌّ كصوب العارض المتراكم",29,"م",1,0],["صقَل الرأى بالتجاربِ حتى","هو أنقى مَتنٍ وأذلقُ غربِ",30,"ب",1,0],["صقيل طراز المجد أروع باسل","له نشوة عند السطا والمكارم",31,"م",1,0],["صقيعٌ في مرافي الرّوحِ يرسو","بوخزِ الثلجِ يجرحُ ثم يقسو",32,"و",1,1],["صقلية في البحر أيضا رأيتها","فأقبل ماء العين من حزنه يجرى",33,"ر",2,0],["صِقالُ سَوالِفِ وَجهِ الحَبيبِ","أَراني بِها هُدبَ عَيني عَذارا",34,"ر",2,1],["صَقَل البِشْرُ مُحَيّا وجهه","فَجلا عن ناظرِ الحُرِّ القَتاما",35,"م",2,0],["صَقيلٌ حَدُّ صارِمِه ولكنْ","يُدِبُّ فِرِنْدُهُ فيه النِّمالا",36,"ل",2,0],["صقيلُ مضارب العزمات ماضٍ","فلا فُلَّت مضاربُه الصّقال",37,"ل",1,0],["صَقَلَتْنِي الخطوبُ والسيفُ يَخْفَى","عَيْبُهُ في صَدَاهُ قَبْلَ الصِّقالِ",38,"ل",1,0],["صُقِلَتْ صَفْحَتَا صِقِلِّيِةٍ مِنْ","كَ فوافَتْ كالصَّارمِ البَتَّارِ",39,"ر",1,0],["صقيلاتُ أبشارِ البروقِ كأنّما","أُمرَّتْ عليها بالشموسِ المداوكُ",40,"ك",1,0],["صقورٌ إن هوَتْ والقافُ فاءٌ","إذا ما وُقّفَتْ والراءُ نونُ",41,"ن",1,0],["صقَلتْهُ النسيمُ حتى بدتْ في","هِ ازوِراراً أَسِرَّةُ الانقباضِ",42,"ض",1,0],["صقيل الصفح لا يعلوه غش","طرير الحد ليس به فلول",43,"ل",1,0],["صقيلة حيث السجاب صدأ","وكلف في وجنتي زمانها",44,"ن",3,0],["صقور جيادٍ والمواضي مخالبٌ","لها وأسودٌ والذوابل غيل",45,"ل",1,0],["صَقرٌ إِذا مَعشَرٌ يَوماً بَدا لَهُمُ","مِنَ الأَنامِ وَإِن عَزّوا وَإِن مَجَدوا",46,"د",3,0],["صقلَتْ ذِهنَهُ التّجاربُ حتّى","صُوَرُ الكائِناتِ فيهِ رآها",47,"ا",3,0],["صقلَ الإلهُ حسامَه وأزارَه","طَلْقاً بكلِّ تهلُّلٍ وتألُّق",48,"ق",1,0],["صُقْعٌ لآلِ اللّه آلِ نَبيّهِ","سجدتْ له الأقطارُ والأصقاعُ",49,"ع",1,0]]}