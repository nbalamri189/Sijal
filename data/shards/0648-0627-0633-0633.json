{"poems":[[9,"ذريني لك الويلات آتي الغوانيا","https://www.aldiwan.net/poem21989.html","الطويل"],[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[90,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[90,"أرى مستقبل الأيام أولى","https://www.aldiwan.net/poem45027.html","الوافر"],[107,"جرى سعدا ومر بنا يمينا","https://www.aldiwan.net/poem42092.html","الوافر"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[139,"بدا علم الإنسان في عالم الحس","https://www.aldiwan.net/poem49035.html","الطويل"],[227,"قل للمهندس أترك برجل العذل","https://www.aldiwan.net/poem55394.html","البسيط"],[290,"ولما أن رجعنا للديار","https://www.aldiwan.net/poem39339.html","الوافر"],[408,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[409,"لك الحمد حمدا باللغات جميعها","https://www.aldiwan.net/poem33400.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86763","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130210","البسيط"],[771,"","https://poetry.dctabudhabi.ae/diwan/poem/198793","المتقارب"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48204","الوافر"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105078","الطويل"],[3372,"","https://poetry.dctabudhabi.ae/diwan/poem/198805",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48291","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86292","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45737","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45806","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77067","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125834","البسيط"],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"مناضلٌ هاجم العدوانُ شوكتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194194",""]],"verses":[["وَآسِ سَراةَ الحَيِّ حَيثُ لَقيتَهُم","وَلا تَكُ عَن حَملِ الرِباعَةِ وانِيا",0,"ي",2,0],["وَأَسِّسوا داراً لِنُوّابِكُم","لِلرَأيِ فيها وَالحِجا أَفسِحوا",1,"ح",3,0],["وأسّسوها على الأعمال قائمة","مُمهِّدين إلى المَحْيا بها سُبُلا",2,"ل",2,0],["وأسّس في بنائك كل مجدٍ","طريف واترك المجد التليدا",3,"د",2,0],["وأسَستَ الحضارةَ زاهياتٍ","معالمُها تسرُّ النّاظرينا",4,"ن",2,0],["وأسس على تقوى من الله توبة","نصوحا على قطب الكمال تدور",5,"ر",1,0],["وأسس بنيان العلوم ولم يكن","ليرفع مبنىً لم يُثبّت على أسِ",6,"س",1,0],["وأسس القلب من ضلعيه زاوية","وقفاً على حرق الاشجان من قبل",7,"ل",1,0],["وأسسنا بها للطبع دارا","وللأسد اقتداء بالخيار",8,"ر",1,0],["وأسِّسُوا ظُلْمَهُمْ فكَمْ هُتِكَتْ","من حُرَمٍ للنّبيِّ في الحَرَمِ",9,"م",1,0],["وأسست أقوالاً وشدت قواعداً","إذا لم تكن تقوى الإِله لها ركنا",10,"ن",2,0],["وَأَسس فيها كُل حصن وَقَلعة","بِرأي لَهُ في كل أَمر مسدد",11,"د",1,0],["وأسسوا بيت مجد فوق أعمدة","من فضلهم بأيادي الجود قد عمرا",12,"ر",2,0],["وأسّستَ بالعدل حُكماً رشيداً","فساد الرخاء وعمَّ الوئام",13,"م",1,0],["وآسٍ سندسيِّ اللونِ تهْفُو","غلائلُه إِذا رِيحٌ أمادَهْ",14,"د",2,0],["وأسس ربع المجد بعد انطماسه","وشيد ما قد كان غير مشيد",15,"د",1,0],["وأسست معجزة للزمان","ترد بصاعين عن كل صاعِ",16,"ع",1,0],["وأسّس مَبْناها بكفٍّ كريمَةٍ","سحابُ نَداها للعُفاةِ انهمارُها",17,"ر",3,0],["وَأَسِّس ما أَرَدت بِناهُ وَاِعلَم","بِدون الأُسِّ لا تَقوى البِنايَه",18,"ا",3,0],["وَأَسس فيها مُلكَهُ فَتَشَرَفَت","وَطاول مِنهَ الفرقدين بِناءُ",19,"ا",2,0],["وَأَسَست أَركان العلى وَرُبوعَها","وَشَيَدتُها تَشييد ماضي العَزائم",20,"م",1,0],["وأسس في السفح المبارك مسجداً","به طاف ولدان الجنان وحورها",21,"ر",3,0],["وَأَسَّستَ مَجداً يا حَبيبَ مُؤثَلا","لِآلِ عَمير جاءَ ظِلا مُمَدَّدا",22,"د",2,0],["وأسَّسُوا دولةً بالظلم قائمةً","بها الذي وقَّعَ الميثاقَ معترف",23,"ف",1,0],["وَأَسَّسَ بِالفَضْلِ فِي قَوْمِهِ","بِحَيْثُ اصْطَفَى أَصْلَ سِيسانِهِ",24,"ن",2,0],["وأسس دين الله بالحكمة التي","لها سجدت أفكار أهل البسيطتي",25,"ت",2,0],["وأسس شرع الله في الأرض وانزوت","لديه عقول ماردات أبيتي",25,"ت",2,0],["وأسس الفضلَ عبدُ الله رائدُنا","أبو الزويرِ الذي يسعى لتطويري",26,"ر",2,0]]}