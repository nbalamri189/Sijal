{"poems":[[9,"ذريني لك الويلات آتي الغوانيا","https://www.aldiwan.net/poem21989.html","الطويل"],[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[90,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[90,"أرى مستقبل الأيام أولى","https://www.aldiwan.net/poem45027.html","الوافر"],[107,"جرى سعدا ومر بنا يمينا","https://www.aldiwan.net/poem42092.html","الوافر"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[139,"بدا علم الإنسان في عالم الحس","https://www.aldiwan.net/poem49035.html","الطويل"],[226,"قل للمهندس أترك برجل العذل","https://www.aldiwan.net/poem55394.html","البسيط"],[289,"ولما أن رجعنا للديار","https://www.aldiwan.net/poem39339.html","الوافر"],[406,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[407,"لك الحمد حمدا باللغات جميعها","https://www.aldiwan.net/poem33400.html","الطويل"]],"verses":[["وَآسِ سَراةَ الحَيِّ حَيثُ لَقيتَهُم","وَلا تَكُ عَن حَملِ الرِباعَةِ وانِيا",0,"ي",2,0],["وَأَسِّسوا داراً لِنُوّابِكُم","لِلرَأيِ فيها وَالحِجا أَفسِحوا",1,"ح",3,0],["وأسّسوها على الأعمال قائمة","مُمهِّدين إلى المَحْيا بها سُبُلا",2,"ل",2,0],["وأسّس في بنائك كل مجدٍ","طريف واترك المجد التليدا",3,"د",2,0],["وأسَستَ الحضارةَ زاهياتٍ","معالمُها تسرُّ النّاظرينا",4,"ن",2,0],["وأسس على تقوى من الله توبة","نصوحا على قطب الكمال تدور",5,"ر",1,0],["وأسس بنيان العلوم ولم يكن","ليرفع مبنىً لم يُثبّت على أسِ",6,"س",1,0],["وأسس القلب من ضلعيه زاوية","وقفاً على حرق الاشجان من قبل",7,"ل",1,0],["وأسسنا بها للطبع دارا","وللأسد اقتداء بالخيار",8,"ر",1,0],["وأسِّسُوا ظُلْمَهُمْ فكَمْ هُتِكَتْ","من حُرَمٍ للنّبيِّ في الحَرَمِ",9,"م",1,0],["وأسست أقوالاً وشدت قواعداً","إذا لم تكن تقوى الإِله لها ركنا",10,"ن",2,0]]}