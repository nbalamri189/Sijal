{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"أشرق أم أغرب يا سعيد","https://www.aldiwan.net/poem63460.html","الوافر"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[102,"أنا وأنت","https://www.poetsgate.com/ViewPoem.aspx?id=50199",""],[168,"فنن على دعص تألق فوقه","https://www.aldiwan.net/poem67858.html","الكامل"],[242,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[303,"كم في أزاهير الرياض لناظر","https://www.aldiwan.net/poem36839.html","عموديه"],[347,"تأملاتي تموج في عجب","https://www.aldiwan.net/poem55348.html","المنسرح"],[409,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[505,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[565,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48558","الطويل"],[1583,"","https://poetry.dctabudhabi.ae/diwan/poem/142521","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93657","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45854","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132023","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91293","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117898","الكامل"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45543","الوافر"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75834","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22588","الكامل"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20660","البسيط"],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[1043,"الممثل","https://www.poetsgate.com/ViewPoem.aspx?id=92991",""],[5431,"لأنك مثل الصقر حرٌ وشامخٌ","https://www.poetsgate.com/ViewPoem.aspx?id=189012",""],[5638,"عندما بكى وبكيته الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=198127",""],[5704,"رحيل الأهل ...","https://www.poetsgate.com/ViewPoem.aspx?id=191697",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[6225,"القطار المُحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80899&r=&rc=168",""]],"verses":[["فَنَنظُر كَيفَ نُعتِبُهُم وَإلاَّ","فَآدِمَةٌ عَلَى بَللٍ طُوِينَا",0,"ن",2,0],["فَنَنظُرَ أَيَّنا يُضحي وَيُمسي","لَهُ هَذي المَواكِبُ وَالعَبيدُ",1,"د",1,0],["فننال نزر العيش بين فلائق","غبر وبين جماجم أفلاق",2,"ق",1,0],["فننادي هذا هجين وهذا","فرقديّ الجدود الخؤولة",3,"ل",2,0],["فَنَنٌ عَلى دِعصٍ تَأَلَّقَ فَوقَهُ","بَدرٌ يُضيءُ بِهِ الظَلامُ العاكِفُ",4,"ف",1,1],["فَنَنْظِمُ فِيهِ الْقَصِيدْ","وَكُلَّ كَلاَمٍ مُفِيدْ",5,"د",1,0],["فَنَنٌ يرنِّحه النسيمُ كأنه","نشوانُ من نَفَسٍ بَرودٍ عاطر",6,"ر",1,0],["فننثني لا ننال من ارب","حتى نحث الخطى إلى أرب",7,"ب",1,0],["فننزل في منازلنا اللواتي","يخال بأنها غرف الجنان",8,"ن",1,0],["فنُنْهِضُ أسْراراً إلى اللهِ بالهُدى","ونوقِظُ من هُمْ عنهُ بالوَهْمِ نُوَّمُ",9,"م",1,0],["فننساها ونُمعِنُ في التعاميْ","يُسامِحُنا اليقينُ ولا نتوبُ",10,"ب",1,0],["فنندب كالثكلى أضاعت وحيدها","ولم نلق ذا رفق بنا أو مواسيا",11,"ي",2,0],["فنُنبت الرحمة في","قسوته، ونُزهِر",12,"ر",1,0],["فَننشر عَتباً وَالعِناق يَلفنا","فَيا حَبَّذا لَو دامَ لي النَشر وَاللَف",13,"ف",1,0],["فَننعم في فَضل الكَريم وَفَيضِهِ","وَنَرجوهُ تَوفيقاً يَدوم وَإِحسانا",14,"ن",2,0],["فننا فن جميل","علمنا علم جزيل",15,"ل",1,0],["فننا فن جميل","نعم ما أبقى العرب",15,"ب",1,0],["فننزل في سهلٍ فنطوي بساطَه","وَنعلو ذرى طورٍ فندهى الدَواهما",16,"م",2,0],["فننال جم هباتهم","ونحل دورهم الفساح",17,"ح",1,0],["فَنَنظُرُ ما لَدَيكَ إِذا اِلتَقَينا","وَتَنزِعُ إِن جَرَيتَ وَأَنتَ وانِ",18,"ن",1,0],["فننحرها ونخلطها بأخرى","كأن سراتها نصع دفين",19,"ن",1,1],["فننزلها من دارنا خير منزل","ونبدلها حزن المعيشة بالسهل",20,"ل",1,0],["فَنَنالُ في سَلَفَي نُتَيلَةَ ثارنا","فيما يُنالُ وَنُدرِكُ الأَوتارا",21,"ر",2,0],["فَنَنحَرُ الكوم عَبطاً في أَرومَتِنا","لِلنازِلينَ إِذا ما أُنزِلوا شَبِعوا",22,"ع",3,0],["فننسى المواقيت من كل ليل","بها للقيام صلاة وذكر",23,"ر",1,0],["فننظر في آن عصورا طويلة","تمر كما مرّ الخيال الميمم",24,"م",1,0],["فننزع أشواك اللئام بحكمة","ونمضي جنود الحق ..والدين راسخ",25,"خ",1,0],["فَنَنْسَى الْجِرَاحَ وَهَذَا الأَسَى","وَنَحْيَا مَعًا دَائِمًا قُرَنَاءْ",26,"ا",2,0],["فننسى البين نحييها ليالٍ","ونشرب نخب وصلٍ بارتواء",27,"ا",2,0],["فننظر من كان منا على","صوابٍ ومن حلّ دار السّلام",28,"م",1,0],["فننعمُ بعضاً من الوقت ثم","نعودُ ، يعودُ الشقا والأرقْ",29,"ق",1,0]]}