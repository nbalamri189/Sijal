{"poems":[[53,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[53,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[42,"لست وإن عز الشراب بمفطر","https://www.aldiwan.net/poem50443.html","الطويل"],[35,"سأتك وقد أجد بها البكور","https://www.aldiwan.net/poem39147.html","الوافر"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[47,"وما نعمة مشكورة قد صنعتها","https://www.aldiwan.net/poem25292.html","الطويل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[28,"رأيتك قد نضلت وأنت تنمي","https://www.aldiwan.net/poem5433.html","الوافر"],[61,"خليلي إن الغيث أوله قطر","https://www.aldiwan.net/poem51606.html","الطويل"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[105,"سأتبع يوم السبت ما عشت لعنة","https://www.aldiwan.net/poem42139.html","الطويل"],[48,"سأترك خالدا لهوى جنان","https://www.aldiwan.net/poem65317.html","الوافر"],[50,"أبا خالد دعني وزنجي خالد","https://www.aldiwan.net/poem63902.html","الطويل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"سئمت الكون في مصر وكفر","https://www.aldiwan.net/poem22677.html","الوافر"],[46,"لقد صدئت أفهام قوم فهل لها","https://www.aldiwan.net/poem23200.html","الطويل"],[45,"أجِدَّكَ مَا يَنْفَكُّ يَسرِي لزَيْنَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31690",""],[133,"أحسن الأيام أيام التلاق","https://www.aldiwan.net/poem49117.html","الرمل"],[141,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[158,"أبى الله أن يشقى بنصحك ناصح","https://www.aldiwan.net/poem58983.html","الطويل"],[183,"توالى عذابي من عذاب المراشف","https://www.aldiwan.net/poem14600.html","الطويل"],[197,"ساترة ولبدر لا ينقب","https://www.aldiwan.net/poem45218.html","الرجز"],[209,"أهاجر وحدي آه كيف أهاجر","https://www.aldiwan.net/poem46625.html","الطويل"],[268,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[268,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[279,"أتعتبني عمادي عمد عين","https://www.aldiwan.net/poem1395.html",""],[336,"سأترك هذا الباب مادام إذنه","https://www.aldiwan.net/poem68627.html","الطويل"],[413,"زماني على رغم الحسود مسالمي","https://www.aldiwan.net/poem53996.html","الطويل"],[413,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[438,"دع الخمول وخل المقت والكبلا","https://www.aldiwan.net/poem14430.html","البسيط"],[513,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[534,"أجدك ما لعينك لا تنام","https://www.aldiwan.net/poem23869.html","الوافر"],[535,"ألم ترني ودعت ما كنت أشرب","https://www.aldiwan.net/poem69406.html","الطويل"],[535,"أتوب إِلى الله الرحيم فإنه","https://www.aldiwan.net/poem69410.html","الطويل"]],"verses":[["سَأَترُكُ في سَمعِ الزَمانِ دَوِيَّها","بِقَرعي ضِرابٍ صادِقٍ وَطِعانِ",0,"ن",1,0],["سَأَترُكُ هَذا الدَهرَ يَرغو رُغاؤُهُ","وَتَصرُفُ مِن غَيظي بَوادي نُيوبِهِ",1,"ب",2,0],["سَأَترُكُ ما أَخشى عَليَّ أَذاتَهُ","وَأَشرَبُ مِمّا تَجمَعُ النَحلُ والنوقُ",2,"ق",1,0],["سَأَتكَ وَقَد أَجَدَّ بِها البُكورُ","غَداةَ البَينِ مِن أَسماءَ عيرُ",3,"ر",1,1],["سَأَترُكُ لِلزُوّارِ هِنداً وَأَبتَغي","طَبيباً فَيَبغيني شِفاءً لِما بِيا",4,"ي",2,0],["سَآتي جَميلاً ما حَيِيتُ فَإِنَّني","إِذا لَم أُفِد شُكراً أَفَدتُ بِهِ أَجرا",5,"ر",2,0],["سأتخذ الزَّماعَ خليل صدقٍ","يرادفني على وجناءَ عَنس",6,"س",1,0],["ساتَيدَما وَسُيوفُنا في هَضبِهِ","يَفرى إِياسُ بِها الطُلى وَالسوقا",7,"ق",2,0],["سَأَترُكُ باقِياً لَكَ مِن ثَنائي","بِما أَولَيتَ في الحِقَبِ الخَوالي",8,"ي",1,0],["سأتُرُكُ مَنْ أهوى بما هو أهلُه","ولو كانَ مَنْ أهوى يُشاكِلُه البَدرُ",9,"ر",1,0],["سَأَت ظُنونُ الحُسّادِ فيَّ بِهِ","لَمّا غَدا الجُفنُ جافِياً وَسَنَه",10,"ن",2,0],["سأُتبع يومَ السَّبتِ ما عِشتُ لعنةً","يَطيرُ بها عادٍ من الدّهرِ ضابحُ",11,"ح",1,1],["سَأَترُكُ خالِداً لِهَوى جِنانِ","وَإِن جَلَّ الَّذي عَنهُ أَتاني",12,"ي",1,1],["سَأَترُكُ إِبراهيمَ إِذ خَبَتِ اِستُهُ","وَلا خَيرَ في المَستوهِ حُرّاً وَلا عَبدا",13,"د",2,0],["سَأَترُكُ الغُرَّ لِلعُيونِ وَلا","أَترُكُ شُربَ الصَهباءِ وَالغَرَبا",14,"ب",2,0],["سَأَترُكُها مُوَفَّرَةً لِقومٍ","وَهَل سَمَحَت لِمُرتَحِلٍ بِوَفرِ",15,"ر",1,0],["سَأَتبَعُ مَن يَدعو إِلى الخَيرِ جاهِداً","وَأَرحَلُ عَنها ما إِمامي سِوى عَقلي",16,"ي",1,0],["سأتني فُؤَادي عَنكِ، أو أتبَعُ الهَوَى","إلَيكِ، إنِ استَعصَى فُؤاديَ أوْ أبَى",17,"ب",2,0],["ساتر العورةِ أغلى ملبْسٍ","ومقيتَ الروحِ أحلى ما يذاقْ",18,"ق",1,0],["سَأَترُكُ ذي البِلادِ بِلا اِختِيارٍ","وَأَهجُرُ أَهلَها لا عَن تَقالِ",19,"ل",1,0],["ساتعب من بعدي وانسى بمن مضا","متى تصطنعني فالسجايا مرائح",20,"ح",1,0],["سأَتبَع عزمي حيث أمً وأنْتَحِى","وجوهَ المنايا في ظهور الَمخاوف",21,"ف",1,0],["ساترةٌ ولبدرُ لا ينقبُ","وليسَ إلا في القلوبِ تحجبُ",22,"ب",1,1],["سأتركهم عمدا إلى اللَه وحده","وما أنا في هذا بعهدي غادر",23,"ر",1,0],["سأتبعُ من أبي دلفٍ طَريقاً","فلا تحمي الدّروبَ ولا الثُغُورا",24,"ر",2,0],["سأتركُ دلّها لأبٍ وأمٍّ","وخطّيبٍ تُذَوِّبُهُ نُفُورا",24,"ر",2,0],["سَأتبعُ ظلَّ الموتِ بينَ الكتائبِ","لعلَّ شفاءً من شِفارِ القواضِبِ",25,"ب",1,1],["سأتبعُ شرعكَ الأعلى أتباعاً","واشرع عند عذب المشرعين",26,"ن",1,0],["سَأَترُكُ هَذا البابَ مادامَ إِذنُهُ","كَعَهدي بِهِ حَتّى يَخِفَّ قَليلا",27,"ل",2,1],["سأتلو على علياك غرَّ قصائدي","وكم ناثر مثلي لديك وناظم",28,"م",1,0],["سأترك للنياق بكلِّ أرضٍ","ذميلاً من توقُّصِها ووخدا",29,"د",2,0],["سأترك ظهر الأرض مفلولة الشبا","صياقلها والعقرب الوخد قودها",30,"د",3,0],["سأَترك العيس حَسرى في إمارتها","رواعفاً في براها سجّدا ذملا",31,"ل",2,0],["ساتر العيب حافظ الغيب نرجو","وبل إحسانه ونخشى وباله",32,"ل",2,0],["سَأَتبَعُ هَديَهُ مادُمتُ حَيّاً","طَوالَ الدَهرِ ما سَجَعَ الحَمامُ",33,"م",1,0],["سأتركُها للهِ ثم أذُّمها","وأهجرُها في بيتها حيثُ تُشرَبُ",34,"ب",1,0],["سأترُكُها مَذمومةً لا أذوقُها","وإِن رَغِمَت فيها أنوفُ حواسدي",35,"ي",1,0]]}