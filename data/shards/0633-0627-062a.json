اً وماؤكَ ناضبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215559",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5431,"امرأة ترغب بالانفصال...","https://www.poetsgate.com/ViewPoem.aspx?id=202032",""],[5431,"زرياب وآلته ...","https://www.poetsgate.com/ViewPoem.aspx?id=205152",""],[5491,"سأترك الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215020",""],[5509,"محاولات لاصطياد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=93490",""],[5589,"يباب","https://www.poetsgate.com/ViewPoem.aspx?id=187959",""],[5760,"رأيت الخمر طيبة وفيها","https://www.poetsgate.com/ViewPoem.aspx?id=81245",""],[5760,"تركت الرَّاح إذا أبصرت رُشدي","https://www.poetsgate.com/ViewPoem.aspx?id=81249",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5861,"حكاية من الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=188299",""],[5956,"عَجيبٌ أنت يا إكليلَ ورد","https://www.poetsgate.com/ViewPoem.aspx?id=182511",""],[5956,"العمق","https://www.poetsgate.com/ViewPoem.aspx?id=183933",""],[5956,"أستأذنك لحظة يا شقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=192472",""],[5956,"نلملمُ أشلاءنا","https://www.poetsgate.com/ViewPoem.aspx?id=192808",""],[5956,"أقصوصة شغالتين ظالمتين لإنسانية سيدهما الألماني العجوز:","https://www.poetsgate.com/ViewPoem.aspx?id=207868",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6173,"مُقادًا بقلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86797&r=&rc=11",""],[6342,"رذيلة الطيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85939&r=&rc=24",""]],"verses":[["سَأَترُكُ في سَمعِ الزَمانِ دَوِيَّها","بِقَرعي ضِرابٍ صادِقٍ وَطِعانِ",0,"ن",1,0],["سَأَترُكُ هَذا الدَهرَ يَرغو رُغاؤُهُ","وَتَصرُفُ مِن غَيظي بَوادي نُيوبِهِ",1,"ب",2,0],["سَأَترُكُ ما أَخشى عَليَّ أَذاتَهُ","وَأَشرَبُ مِمّا تَجمَعُ النَحلُ والنوقُ",2,"ق",1,0],["سَأَتكَ وَقَد أَجَدَّ بِها البُكورُ","غَداةَ البَينِ مِن أَسماءَ عيرُ",3,"ر",1,1],["سَأَترُكُ لِلزُوّارِ هِنداً وَأَبتَغي","طَبيباً فَيَبغيني شِفاءً لِما بِيا",4,"ي",2,0],["سَآتي جَميلاً ما حَيِيتُ فَإِنَّني","إِذا لَم أُفِد شُكراً أَفَدتُ بِهِ أَجرا",5,"ر",2,0],["سأتخذ الزَّماعَ خليل صدقٍ","يرادفني على وجناءَ عَنس",6,"س",1,0],["ساتَيدَما وَسُيوفُنا في هَضبِهِ","يَفرى إِياسُ بِها الطُلى وَالسوقا",7,"ق",2,0],["سَأَترُكُ باقِياً لَكَ مِن ثَنائي","بِما أَولَيتَ في الحِقَبِ الخَوالي",8,"ل",2,0],["سأتُرُكُ مَنْ أهوى بما هو أهلُه","ولو كانَ مَنْ أهوى يُشاكِلُه البَدرُ",9,"ر",1,0],["سَأَت ظُنونُ الحُسّادِ فيَّ بِهِ","لَمّا غَدا الجُفنُ جافِياً وَسَنَه",10,"ن",2,0],["سأُتبع يومَ السَّبتِ ما عِشتُ لعنةً","يَطيرُ بها عادٍ من الدّهرِ ضابحُ",11,"ح",1,1],["سَأَترُكُ خالِداً لِهَوى جِنانِ","وَإِن جَلَّ الَّذي عَنهُ أَتاني",12,"ن",2,1],["سَأَترُكُ إِبراهيمَ إِذ خَبَتِ اِستُهُ","وَلا خَيرَ في المَستوهِ حُرّاً وَلا عَبدا",13,"د",2,0],["سَأَترُكُ الغُرَّ لِلعُيونِ وَلا","أَترُكُ شُربَ الصَهباءِ وَالغَرَبا",14,"ب",2,0],["سَأَترُكُها مُوَفَّرَةً لِقومٍ","وَهَل سَمَحَت لِمُرتَحِلٍ بِوَفرِ",15,"ر",1,0],["سَأَتبَعُ مَن يَدعو إِلى الخَيرِ جاهِداً","وَأَرحَلُ عَنها ما إِمامي سِوى عَقلي",16,"ل",2,0],["سَأَتْرُكُ لِلظَّنِّ مَا بَعْدَهُ","ومَنْ يَكُ ذَا أُرْبَةٍ يَسْتَبِنْ",17,"ن",1,0],["سأتني فُؤَادي عَنكِ، أو أتبَعُ الهَوَى","إلَيكِ، إنِ استَعصَى فُؤاديَ أوْ أبَى",18,"ب",2,0],["ساتر العورةِ أغلى ملبْسٍ","ومقيتَ الروحِ أحلى ما يذاقْ",19,"ق",1,0],["سَأَترُكُ ذي البِلادِ بِلا اِختِيارٍ","وَأَهجُرُ أَهلَها لا عَن تَقالِ",20,"ل",1,0],["ساتعب من بعدي وانسى بمن مضا","متى تصطنعني فالسجايا مرائح",21,"ح",1,0],["سأَتبَع عزمي حيث أمً وأنْتَحِى","وجوهَ المنايا في ظهور الَمخاوف",22,"ف",1,0],["ساترةٌ ولبدرُ لا ينقبُ","وليسَ إلا في القلوبِ تحجبُ",23,"ب",1,1],["سأتركهم عمدا إلى اللَه وحده","وما أنا في هذا بعهدي غادر",24,"ر",1,0],["سأتبعُ من أبي دلفٍ طَريقاً","فلا تحمي الدّروبَ ولا الثُغُورا",25,"ر",2,0],["سأتركُ دلّها لأبٍ وأمٍّ","وخطّيبٍ تُذَوِّبُهُ نُفُورا",25,"ر",2,0],["سَأتبعُ ظلَّ الموتِ بينَ الكتائبِ","لعلَّ شفاءً من شِفارِ القواضِبِ",26,"ب",1,1],["سأتبعُ شرعكَ الأعلى أتباعاً","واشرع عند عذب المشرعين",27,"ن",1,0],["سَأَترُكُ هَذا البابَ مادامَ إِذنُهُ","كَعَهدي بِهِ حَتّى يَخِفَّ قَليلا",28,"ل",2,1],["سأتلو على علياك غرَّ قصائدي","وكم ناثر مثلي لديك وناظم",29,"م",1,0],["سأترك للنياق بكلِّ أرضٍ","ذميلاً من توقُّصِها ووخدا",30,"د",2,0],["سأترك ظهر الأرض مفلولة الشبا","صياقلها والعقرب الوخد قودها",31,"د",3,0],["سأَترك العيس حَسرى في إمارتها","رواعفاً في براها سجّدا ذملا",32,"ل",2,0],["ساتر العيب حافظ الغيب نرجو","وبل إحسانه ونخشى وباله",33,"ل",2,0],["سَأَتبَعُ هَديَهُ مادُمتُ حَيّاً","طَوالَ الدَهرِ ما سَجَعَ الحَمامُ",34,"م",1,0],["سأتركُها للهِ ثم أذُّمها","وأهجرُها في بيتها حيثُ تُشرَبُ",35,"ب",1,0],["سأترُكُها مَذمومةً لا أذوقُها","وإِن رَغِمَت فيها أنوفُ حواسدي",36,"د",2,0],["سأترككم حتى يلين حجابكم","على أنه لا بد أن سيلين",37,"ن",1,1],["سأتركُ مالا تتركُ النفسُ مِثله","من المالِ والأولادِ والخالِ والصِّهرِ",38,"ر",1,0],["سأترك هذا الوجد يتلف مُهجتي","فإن غريم الشوق لا شك مُعسر",39,"ر",1,0],["سأتركها نجلاء ما الرمحُ بعدها","يغادرُ نحراً بالطعان سليماً",40,"م",2,0],["سأتلوها إِذا غضبت وَراحَت","كمثل اللَيل يَتلوه النَهار",41,"ر",1,0],["سأترك ثغر الري ما كنت والياً","عليه لأمر غالني وشجاني",42,"ن",2,1],["ساتْرُك في صدْري شَجَى الهَمّ سائغاً","إذا شَجِيَتْ باليَعْملاتِ الصَّحاصِحُ",43,"ح",1,0],["ساترك منّي غربَ كلَّ تنوفةٍ","بها من رسيم اليعملات فُلولُ",44,"ل",1,0],["سأتبعهُ حتى يرى الناسُ انني","وفيٌّ بعهدي والحوادثُ تغتالُ",45,"ل",1,0],["ساتراً عقربَ صدغٍ لسعا","قلبَ صبٍّ ان رآهُ وجفا",46,"ف",2,0],["سأترك نفس وما تشتهيه","فإما عليها وإما لها",47,"ل",3,1],["سأترك حبكم من غير بغض","وذاك لكثرة الشركاء فيه",48,"ه",1,1],["ساتر للعيوب في كلّ حال","دائماً بالجميل للضرّ راقي",49,"ق",2,0],["سأتركه لراميةِ المآقى","عساه يتوب أو يلقى الصَّوابا",50,"ب",2,0],["سأترك عنه للدنيا كتاباً","وأحمل عنه للأخرى كتابا",50,"ب",2,0],["سأترك الحبَّ يُوهيني وينحلني","حتى أجولَ ومَا تدري مع النَّفَسِ",51,"س",1,0],["سَأتركه تَركَ الغَزالِ لظله","وَأُتبِعُه هَجراً وَأُوسِعُه نَأيا",