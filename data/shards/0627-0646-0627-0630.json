{"poems":[[77,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"إن خيرا من أن ترى في أن قد","https://www.aldiwan.net/poem62989.html","الخفيف"],[91,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[70,"أنا ذا زهيرك ليس","https://www.aldiwan.net/poem42428.html","مجزوء الكامل"],[70,"ورد الكتاب وإنه","https://www.aldiwan.net/poem42723.html","مجزوء الكامل"],[78,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[44,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[44,"كفي وغاك فإنني لك قالي","https://www.aldiwan.net/poem30376.html","الكامل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85469","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"كذب الخائفون","https://www.poetsgate.com/ViewPoem.aspx?id=179012",""],[51,"إن خيراً من أن ترى فيَّ أن قد","https://www.poetsgate.com/ViewPoem.aspx?id=29092",""],[78,"كَذبَتْ مُناكُم، صَرّحوا أَو جَمْجِموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86640&r=&rc=135",""],[90,"كذب الخائفون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64277&r=&rc=56",""],[147,"أنا حق أنا خلق","https://www.aldiwan.net/poem47618.html","مجزوء الرمل"],[160,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[174,"أعذر لفظ المحب بالعذر","https://www.aldiwan.net/poem46048.html","البسيط"],[189,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[211,"عند هذا المساء يلقاك روح","https://www.aldiwan.net/poem46269.html","الخفيف"],[222,"دعاك الهوى فاجب من دعاك","https://www.aldiwan.net/poem55466.html","المتقارب"],[328,"مجالي الصبا لا طواك الزمن","https://www.aldiwan.net/poem55036.html","المتقارب"],[328,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[353,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[396,"إنا ذممنا على ما خيلت","https://www.aldiwan.net/poem626.html",""],[441,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[441,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[452,"برح الخفاء فما لجدك معمل","https://www.aldiwan.net/poem13876.html","الكامل"],[453,"باق نعم أنا في ولائي الباقي","https://www.aldiwan.net/poem61566.html","الكامل"],[458,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[458,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[458,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[458,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[458,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[458,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[458,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[468,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[479,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[500,"هل البرق نجدي أم البرج متكين","https://www.aldiwan.net/poem37764.html","الطويل"],[500,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[515,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[544,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[551,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[558,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[558,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[586,"هات قل لي كم الجفا والدلال","https://www.aldiwan.net/poem17650.html","الخفيف"]],"verses":[["أنا ذا أخلع الأنام عذاراً","شاب والله للفراق عذاري",0,"ي",1,0],["أنا ذا أبو مَثْواهُ مَن يحْمي الحِمَى","لَيْثاً ويُعْلِمُ بالزّئِيرِ الخيسا",1,"س",2,0],["أنا ذو القصد غير أني متى آ","نَستُ جوراً رأيتَ لي غلُواءَ",2,"ا",2,0],["أنا ذو صفحتين ملساءَ حسنا","ءَ وأخرى تَمَسُّها خَشْناءَ",2,"ا",2,0],["أنا ذاك الذي سَقَتْهُ يدُ السُّقْ","م كؤوساً من المُرارِ رِواءَ",2,"ا",2,0],["أنا ذاك الذي عهدتَ وإنْ نف","فرتَ جأشي فكان مني نِفارُ",3,"ر",1,0],["أنا ذلكَ الولدُ الذي","دُنياه كانت ههنا!",4,"ن",2,0],["أَنا ذا زُهَيرُكَ لَيسَ","إِلّا جودُ كَفِّكَ لي مُزَينَه",5,"ن",2,1],["أَنا ذَلِكَ الصَبُّ الَّذي","أَبَداً بِذِكرُكُمُ يَهيمُ",6,"م",1,0],["أَنا ذَلِكُم لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَنيعَة يُهدَمُ",7,"م",1,0],["أَنا ذو مَنطِقٍ شَريفٍ لِإِعطا","ءٍ وَذو مَنطِقٍ لِمَنعٍ عَفيفِ",8,"ف",1,0],["أَنا ذو عَرَفتِ فإِن عَرَتكِ جَهالَةٌ","فَأَنا المُقيمُ قِيامَةَ العُذّالِ",9,"ل",1,0],["أَنا ذو كَساكَ مَحَبَّةً لا خَلَّةً","حِبَرَ القَصائِدِ فُوِّفَت تَفويفا",10,"ف",2,0],["إِنَّ أَذاها مِثلُ أَفعالِنا","ماضٍ وَفي الحالِ وَمُستَقبَلُ",11,"ل",1,0],["أَنا ذاكَ السَعيد يوم أَراني","لَيسَ إِلّا مني عليّ أَمير",12,"ر",1,0],["أَنا ذَلك العصفور جاءَ يروعني","والي العراق ببطشه المَشهور",13,"ر",1,0],["أنا ذاك الشادي الذي نسلتْ","ريشَ جناحيه هبَّهُ العاصفاتِ",14,"ت",1,0],["أنا ذاك الشريد في صحراء ال","عيش ضلَّ السبيلَ في الفلواتِ",14,"ت",1,0],["أنا ذا أمامَكَ ماثلاً متَجبِّراً","أطأ الطُغاة بشسعِ نعليَ عازبا",15,"ب",2,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشام",16,"م",1,0],["أنا ذاك الذي عهدتَ وإنْ","نفَّرت جأشي فكان مني نِفارُ",17,"ر",1,0],["أَنا ذَاكُم، لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَّنيعَةِ يُهدَمُ",18,"م",1,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشاما",19,"م",2,0],["أنا ذاتٌ أنا وصفٌ","أنا قربٌ أنا بعد",20,"د",1,0],["أنا ذا على شط فكيف تيممى","والشط تضرب حافتيه الموجة",21,"ه",1,0],["إِنْ أَذِنَ اللهُ فِي الرَّحِيلِ فَقَدْ","أَعِيدَ طَيُّ السُّرُورِ ذَا نَشْرِ",22,"ر",1,0],["أَنا ذا أشدو بسلعٍ والنقا","وَرَوابي حاجرٍ والمُنحنى",23,"ن",2,0],["إن أذق ثغرك الرشوف مساء","سكرت مهجتي وثار الغليل",24,"ل",1,0],["أنا ذلك العبد فامنن برقي","وجد للمشوق بأنس لقاك",25,"ك",1,0],["أنا ذلك اللغز لما يحَلّ","ومظهره الفرد صوت الهوان",26,"ن",1,0],["أنا ذلك الفجر المحير","ليس يهديه سناه",27,"ه",1,0],["أَنا ذو الحلم فَلا قَرع العَصا","ردّني عَن خطأ صَوب صَوابي",28,"ي",1,0],["إنا ذممنا على ما خَيَّلت","سعد بن زيد وعمرو من تميم",29,"م",1,1],["أنا ذو حرمت وقد أتيتك تائباً","فارحم عبيدك مذ أتاك وما جنى",30,"ن",2,0],["أنا ذو لقيت بذا الزمان وأهله","كبقا الجبا بمعاطن إدراسي",31,"ي",1,0],["أنا ذلك الغرّيدُ أرْوَضَ جانبي","فازدانَ منّي بالثناءِ المِقْوَلُ",32,"ل",1,0],["أنا ذلك البحر الخضم وإن أكن","بوداعتي كالجدول الرقراق",33,"ق",1,0],["أنا ذا لَحْمِيَ أطعمتُ الهوى","فهْيَ نفسي فوق أظفاري تسيلُ",34,"ل",1,0],["أنا ذاك المِخذمُ القاطعُ لا","صدَئي نقصٌ ولا فرطُ انفلالي",35,"ي",1,0],["أنا ذاك العضبُ لا تمنعه","قلّة التصميم في يوم الحقيقَهْ",36,"ق",2,0],["أنا ذاك أطعمتُ الهوى","لحمي فبات يمزِّقُهْ",37,"ق",2,0],["أنا ذاك اعتبدتُ قلبي وأنفق","تُ دموعي عليكُمُ تبذيرا",38,"ر",2,0],["أنا ذلك المولى المقيمُ على","صدقِ الهوى وسلامةِ الصدرِ",39,"ر",1,0],["أنا ذاك الحرُّ الذي صيَّرتْه","لك أخلاقُك السواحرُ عبدا",40,"د",2,0],["أنا ذاك جانيها فهل أنا آخذٌ","غيري بها وهو الذي لم ياتِها",41,"ت",3,0],["أنا ذاك لم تكفِ أشتياقيِ زَورةٌ","بَلَى زادني بالبعدِ شَجْواً تقرُّبي",42,"ي",1,0],["أَنا ذاكَ أُعطي اللَهوَ ما عِشتُ مِقوَدي","وَأَعدَلُ عَن تَفنيدِ كُلِّ مُفَنِّدِ",43,"د",1,0],["أنا ذلك المبعوث فيهم قائم","بالواجبات مكلف بمثوله",44,"ل",2,0],["أَنا ذلك العبدُ الَّذي دانَ حُبَّكم","وأَنتم كما شئتُمْ أحِبَّتَنا كُنوا",45,"ن",3,0],["أَنا ذلك الطِفْلُ الَّذي قمتُمْ به","ولكُمْ عليه بكلِّ آونَةٍ يَدُ",46,"د",1,0],["أنا ذلك الصب الذي قطعت به","صلة الغرام مطامع السلوان",47,"ن",1,0],["أنا ذا أسوقُ الرُّوحَ نحو منابعِ ال","تقوَى فروحيَ وردةٌ تَتَصَحَّرُ",48,"ر",1,0],["أنَا ذلك المحضُ الّذي جرّبتُمُ","أبداً أوالِي فيكُمُ وأعادِي",49,"ي",1,0],["انا ذو العيون وذو الوجو","ه وذو النفوس بلا تناهي",50,"ا",3,0],["أنا ذلك الفرد الذي","أدرى فهل أحد يباهي",50,"ا",3,0],["أنا ذاتيْ والصفات كذا","سائر الأقوال والأفعال",51,"ل",1,0],["أَنا ذاك الَّذي عَهِدْتَ وَإِنْ حَا","لَ تَجَنِّيكَ بَيْنَنا وَالمَلالُ",52,"ل",1,0]]}