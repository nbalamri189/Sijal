ps://www.poetsgate.com/ViewPoem.aspx?id=53459",""],[5939,"طوفان لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=178596",""],[5956,"ذاهبٌ للشغل","https://www.poetsgate.com/ViewPoem.aspx?id=192475",""],[5956,"أنا ذاهبٌ لجنانِ عدْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193338",""],[5956,"لبيكِ يا خطيبتي ثم قرينتي رفاه","https://www.poetsgate.com/ViewPoem.aspx?id=208836",""],[6070,"بثوبٍ مِنَ الثَّلجِ البَريءِ تلحَّفا","https://www.poetsgate.com/ViewPoem.aspx?id=197532",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[6134,"إنا ذلك الصب المقيم على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=169532",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[463,"يا ديارَ الحيِّ منْ جنبِ الحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60162&r=&rc=218",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""],[4222,"يوم أهب صبا الهبات صباحه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52748&r=&rc=40",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["أنا ذا أخلع الأنام عذاراً","شاب والله للفراق عذاري",0,"ر",2,0],["أنا ذا أبو مَثْواهُ مَن يحْمي الحِمَى","لَيْثاً ويُعْلِمُ بالزّئِيرِ الخيسا",1,"س",2,0],["أنا ذو القصد غير أني متى آ","نَستُ جوراً رأيتَ لي غلُواءَ",2,"ا",2,0],["أنا ذو صفحتين ملساءَ حسنا","ءَ وأخرى تَمَسُّها خَشْناءَ",2,"ا",2,0],["أنا ذاك الذي سَقَتْهُ يدُ السُّقْ","م كؤوساً من المُرارِ رِواءَ",2,"ا",2,0],["أنا ذاك الذي عهدتَ وإنْ نف","فرتَ جأشي فكان مني نِفارُ",3,"ر",1,0],["أنا ذلكَ الولدُ الذي","دُنياه كانت ههنا!",4,"ن",2,0],["أَنا ذا زُهَيرُكَ لَيسَ","إِلّا جودُ كَفِّكَ لي مُزَينَه",5,"ن",2,1],["أَنا ذَلِكَ الصَبُّ الَّذي","أَبَداً بِذِكرُكُمُ يَهيمُ",6,"م",1,0],["أَنا ذَلِكُم لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَنيعَة يُهدَمُ",7,"م",1,0],["أَنا ذو مَنطِقٍ شَريفٍ لِإِعطا","ءٍ وَذو مَنطِقٍ لِمَنعٍ عَفيفِ",8,"ف",1,0],["أَنا ذو عَرَفتِ فإِن عَرَتكِ جَهالَةٌ","فَأَنا المُقيمُ قِيامَةَ العُذّالِ",9,"ل",1,0],["أَنا ذو كَساكَ مَحَبَّةً لا خَلَّةً","حِبَرَ القَصائِدِ فُوِّفَت تَفويفا",10,"ف",2,0],["إِنَّ أَذاها مِثلُ أَفعالِنا","ماضٍ وَفي الحالِ وَمُستَقبَلُ",11,"ل",1,0],["أَنا ذاكَ السَعيد يوم أَراني","لَيسَ إِلّا مني عليّ أَمير",12,"ر",1,0],["أَنا ذَلك العصفور جاءَ يروعني","والي العراق ببطشه المَشهور",13,"ر",1,0],["أنا ذاك الشادي الذي نسلتْ","ريشَ جناحيه هبَّهُ العاصفاتِ",14,"ت",1,0],["أنا ذاك الشريد في صحراء ال","عيش ضلَّ السبيلَ في الفلواتِ",14,"ت",1,0],["أنا ذا أمامَكَ ماثلاً متَجبِّراً","أطأ الطُغاة بشسعِ نعليَ عازبا",15,"ب",2,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشام",16,"م",1,0],["أنا ذاك الذي عهدتَ وإنْ","نفَّرت جأشي فكان مني نِفارُ",17,"ر",1,0],["أَنا ذَاكُم، لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَّنيعَةِ يُهدَمُ",18,"م",1,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشاما",19,"م",2,0],["أنا ذاتٌ أنا وصفٌ","أنا قربٌ أنا بعد",20,"د",1,0],["أنا ذا على شط فكيف تيممى","والشط تضرب حافتيه الموجة",21,"ه",1,0],["إِنْ أَذِنَ اللهُ فِي الرَّحِيلِ فَقَدْ","أَعِيدَ طَيُّ السُّرُورِ ذَا نَشْرِ",22,"ر",1,0],["أَنا ذا أشدو بسلعٍ والنقا","وَرَوابي حاجرٍ والمُنحنى",23,"ن",2,0],["إن أذق ثغرك الرشوف مساء","سكرت مهجتي وثار الغليل",24,"ل",1,0],["أنا ذلك العبد فامنن برقي","وجد للمشوق بأنس لقاك",25,"ك",1,0],["أنا ذلك اللغز لما يحَلّ","ومظهره الفرد صوت الهوان",26,"ن",1,0],["أنا ذلك الفجر المحير","ليس يهديه سناه",27,"ه",1,0],["أَنا ذو الحلم فَلا قَرع العَصا","ردّني عَن خطأ صَوب صَوابي",28,"ب",2,0],["إنا ذممنا على ما خَيَّلت","سعد بن زيد وعمرو من تميم",29,"م",1,1],["أنا ذو حرمت وقد أتيتك تائباً","فارحم عبيدك مذ أتاك وما جنى",30,"ن",2,0],["أنا ذو لقيت بذا الزمان وأهله","كبقا الجبا بمعاطن إدراسي",31,"س",2,0],["أنا ذلك الغرّيدُ أرْوَضَ جانبي","فازدانَ منّي بالثناءِ المِقْوَلُ",32,"ل",1,0],["أنا ذلك البحر الخضم وإن أكن","بوداعتي كالجدول الرقراق",33,"ق",1,0],["أنا ذا لَحْمِيَ أطعمتُ الهوى","فهْيَ نفسي فوق أظفاري تسيلُ",34,"ل",1,0],["أنا ذاك المِخذمُ القاطعُ لا","صدَئي نقصٌ ولا فرطُ انفلالي",35,"ل",2,0],["أنا ذاك العضبُ لا تمنعه","قلّة التصميم في يوم الحقيقَهْ",36,"ق",2,0],["أنا ذاك أطعمتُ الهوى","لحمي فبات يمزِّقُهْ",37,"ق",2,0],["أنا ذاك اعتبدتُ قلبي وأنفق","تُ دموعي عليكُمُ تبذيرا",38,"ر",2,0],["أنا ذلك المولى المقيمُ على","صدقِ الهوى وسلامةِ الصدرِ",39,"ر",1,0],["أنا ذاك الحرُّ الذي صيَّرتْه","لك أخلاقُك السواحرُ عبدا",40,"د",2,0],["أنا ذاك جانيها فهل أنا آخذٌ","غيري بها وهو الذي لم ياتِها",41,"ت",3,0],["أنا ذاك لم تكفِ أشتياقيِ زَورةٌ","بَلَى زادني بالبعدِ شَجْواً تقرُّبي",42,"ب",2,0],["أَنا ذاكَ أُعطي اللَهوَ ما عِشتُ مِقوَدي","وَأَعدَلُ عَن تَفنيدِ كُلِّ مُفَنِّدِ",43,"د",1,0],["أنا ذلك المبعوث فيهم قائم","بالواجبات مكلف بمثوله",44,"ل",2,0],["أَنا ذلك العبدُ الَّذي دانَ حُبَّكم","وأَنتم كما شئتُمْ أحِبَّتَنا كُنوا",45,"ن",3,0],["أَنا ذلك الطِفْلُ الَّذي قمتُمْ به","ولكُمْ عليه بكلِّ آونَةٍ يَدُ",46,"د",1,0],["أنا ذلك الصب الذي قطعت به","صلة الغرام مطامع السلوان",47,"ن",1,0],["أنا ذا أسوقُ الرُّوحَ نحو منابعِ ال","تقوَى فروحيَ وردةٌ تَتَصَحَّرُ",48,"ر",1,0],["أنَا ذلك المحضُ الّذي جرّبتُمُ","أبداً أوالِي فيكُمُ وأعادِي",49,"د",2,0],["انا ذو العيون وذو الوجو","ه وذو النفوس بلا تناهي",50,"ا",3,0],["أنا ذلك الفرد الذي","أدرى فهل أحد يباهي",50,"ا",3,0],["أنا ذاتيْ والصفات كذا","سائر الأقوال والأفعال",51,"ل",1,0],["أَنا ذاك الَّذي عَهِدْتَ وَإِنْ حَا","لَ تَجَنِّيكَ بَيْنَنا وَالمَلالُ",52,"ل",1,0],["أَنا ذا مَلَّكتُ نَفسي قاتِلي","عَلَّني أَفعَلُ ما لَم يَفعَلِ",53,"ل",1,0],["أنا ذلك الصب الذي قد ما صبا","بصبا الصبى وإلى الغرام حنيني",54,"ن",2,0],["أَنا ذَلِكَ الخل الَّذي جَرَّبتني","وَعَرَفت أَخلاقي وَحسن سجيتي",55,"ي",1,0],["إنّ أذني تملّ طول كلامه","وفؤادي يملّ طول مقامه",56,"ه",1,1],["أنا ذاك الآبي احتراشَ الغواني","لُبَّهُ واللبيبُ يأبى احتراشا",57,"ش",2,0],["إِن آذار لم يذرْ تحتَ بطنِ ال","أرضِ شيئاً أكنَّه كانون",58,"ن",1,0],["أنا ذا أُضْمِرُ اللقاءَ فألاَّ","منعونا اللقاءَ بالإِضمار",59,"ر",1,0],["أَنا ذو القُصورِ وَأَنتَ مِن غيرِ اِمتِرا","مُستَوجب التّبجيلِ والإِكرامِ",60,"م",1,0],["أنا ذاك َصوت ُالريح ِعابسة","ألهُو بإطفائي ومتقدي",61,"د",2,0],["أنا ذلك الظمآنُ للمشروع الذي","يصول على لفح الهجير شروعه",62,"ع",2,0],["أنا ذاكمُ المضني المصابُ بحبكم","ورضاكمُ مأمُولنا والمقصد",63,"د",1,0],["أنا ذلك المأثور حفظَ عهوده","لمعهد ربْع ساعدْتنا به سعدى",64,"د",2,0],["أنا ذلك المضني بحبك كلما","تُذُوكر إلفٌ بالوداد خليق",65,"ق",1,0],["أنا ذو همٍّ وتيمور متى","جئتهُ فالهمّ عني اندحضا",66,"ض",2,0],["أنا ذوحاجة وأنت جواد","وراينا الجواد يولي الجميلا",67,"ل",2,0],["أنا ذو فاقة وأنت غني","وعهدنا الغني يعطي الجزيلا",67,"ل",2,0],["أنا ذو فاقة وأنت غني","وسبيل الغنى إعطا الفقير",68,"ر",1,0],["أنا ذو حيرة وأنت دليل","وعهدنا الدليل يهدي الحيارى",69,"ر",2,0],["أنا ذو فاقة وأنت غني","وشهدنا الغمام يسقي القفارا",69,"ر",2,0],["أنا ذو عسرة وأنت كريم","فأولني باليمين منك اليسارا",69,"ر",2,0],["أَنا ذَلِكَ المُشتاق أَعدمني النَوى","بَعدَ اللُقا جَوراً عَدمتَ نَواكا",70,"ك",2,0],["أَنا ذَلِكَ الأَعمى الَّذي قَد أَبصرت","عَيناي هَذا اليَوم بَدري مُسفِرا",71,"ر",2,0],["أَنا ذَلِكَ العَبد القَديمُ عَلى الوَفا","أَبَداً أَقيمُ الدَهرَ لَن أَتَغَيَّرا",71,"ر",2,0],["أَنا ذَلِكَ الغادي وَراءَكَ في الفَلا","أَينَ الفَرار مِن الغَرام الغادي",72,"د",2,0],["أنا ذلك الغرض الأناني الذي","في كل نفس لم أزل متأصلا",73,"ل",2,0],["أنا ذو منعت جفونه أن ترقدا","وتركته ليل التمام مسهدا",74,"د",2,0],["انا ذا فان لم تعرفيني بعد ذا","فانا ابن وهب ذو السماحة والندا",74,"د",2,0],["أنا ذو لم يزل يهون على الند","مان ان عز جانب الندمان",75,"ن",1,0],["إن أَذنَبوا فعتابي غيرُ مُستمع","وإن هَفَوتُ فَذَنبي غيرُ مُغتَفر",76,"ر",1,0],["أنا ذاكم الرجل الذي وافيته","ليلاً أخوض من النجيع عباعبا",77,"ب",2,0],["أنا ذاك الغريد فوق الغصون","بنواحي أبكيت عين الجماد",78,"د",1,0],["أنا ذلك المثنى بأنعمك التي","قلدتني قدما قلائد برها",79,"ر",3,0],["أنا ذاك المعْنَى المُقاد برسمٍ","رغم جسمٍ يعود مني رُغاما",80,"م",2,0],["أَن