{"poems":[[77,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"إن خيرا من أن ترى في أن قد","https://www.aldiwan.net/poem62989.html","الخفيف"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[70,"أنا ذا زهيرك ليس","https://www.aldiwan.net/poem42428.html","مجزوء الكامل"],[70,"ورد الكتاب وإنه","https://www.aldiwan.net/poem42723.html","مجزوء الكامل"],[78,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[44,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[44,"كفي وغاك فإنني لك قالي","https://www.aldiwan.net/poem30376.html","الكامل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85469","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"كذب الخائفون","https://www.poetsgate.com/ViewPoem.aspx?id=179012",""],[51,"إن خيراً من أن ترى فيَّ أن قد","https://www.poetsgate.com/ViewPoem.aspx?id=29092",""],[78,"كَذبَتْ مُناكُم، صَرّحوا أَو جَمْجِموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86640&r=&rc=135",""],[90,"كذب الخائفون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64277&r=&rc=56",""]],"verses":[["أنا ذا أخلع الأنام عذاراً","شاب والله للفراق عذاري",0,"ي",1,0],["أنا ذا أبو مَثْواهُ مَن يحْمي الحِمَى","لَيْثاً ويُعْلِمُ بالزّئِيرِ الخيسا",1,"س",2,0],["أنا ذو القصد غير أني متى آ","نَستُ جوراً رأيتَ لي غلُواءَ",2,"ا",2,0],["أنا ذو صفحتين ملساءَ حسنا","ءَ وأخرى تَمَسُّها خَشْناءَ",2,"ا",2,0],["أنا ذاك الذي سَقَتْهُ يدُ السُّقْ","م كؤوساً من المُرارِ رِواءَ",2,"ا",2,0],["أنا ذاك الذي عهدتَ وإنْ نف","فرتَ جأشي فكان مني نِفارُ",3,"ر",1,0],["أَنا ذَلِكَ الوَلَدُ الَّذي","دُنياهُ كانَت هَهُنا",4,"ن",2,0],["أَنا ذا زُهَيرُكَ لَيسَ","إِلّا جودُ كَفِّكَ لي مُزَينَه",5,"ن",2,1],["أَنا ذَلِكَ الصَبُّ الَّذي","أَبَداً بِذِكرُكُمُ يَهيمُ",6,"م",1,0],["أَنا ذَلِكُم لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَنيعَة يُهدَمُ",7,"م",1,0],["أَنا ذو مَنطِقٍ شَريفٍ لِإِعطا","ءٍ وَذو مَنطِقٍ لِمَنعٍ عَفيفِ",8,"ف",1,0],["أَنا ذو عَرَفتِ فإِن عَرَتكِ جَهالَةٌ","فَأَنا المُقيمُ قِيامَةَ العُذّالِ",9,"ل",1,0],["أَنا ذو كَساكَ مَحَبَّةً لا خَلَّةً","حِبَرَ القَصائِدِ فُوِّفَت تَفويفا",10,"ف",2,0],["إِنَّ أَذاها مِثلُ أَفعالِنا","ماضٍ وَفي الحالِ وَمُستَقبَلُ",11,"ل",1,0],["أَنا ذاكَ السَعيد يوم أَراني","لَيسَ إِلّا مني عليّ أَمير",12,"ر",1,0],["أَنا ذَلك العصفور جاءَ يروعني","والي العراق ببطشه المَشهور",13,"ر",1,0],["أنا ذاك الشادي الذي نسلتْ","ريشَ جناحيه هبَّهُ العاصفاتِ",14,"ت",1,0],["أنا ذاك الشريد في صحراء ال","عيش ضلَّ السبيلَ في الفلواتِ",14,"ت",1,0],["أنا ذا أمامَكَ ماثلاً متَجبِّراً","أطأ الطُغاة بشسعِ نعليَ عازبا",15,"ب",2,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشام",16,"م",1,0],["أنا ذاك الذي عهدتَ وإنْ","نفَّرت جأشي فكان مني نِفارُ",17,"ر",1,0],["أَنا ذَاكُم، لا البَغيُ يُثمِرُ غَرسُهُ","عِندي وَلا مَبنى الصَّنيعَةِ يُهدَمُ",18,"م",1,0],["انا ذاك الحر العراقي إمّا","حَنَّ يستنهضُ العراقُ الشاما",19,"م",2,0]]}