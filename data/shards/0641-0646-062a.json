{"poems":[[87,"الفن روض يمر القاطفون به","https://www.aldiwan.net/poem7052.html","البسيط"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[207,"عجبت لفخر الأوس والحين دائر","https://www.aldiwan.net/poem68163.html","الطويل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[382,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[469,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67824","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203688","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46513","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64564","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65948","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200012","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70168","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94592","البسيط"],[4782,"شطر الخامسة","https://www.poetsgate.com/ViewPoem.aspx?id=198465",""]],"verses":[["فن تعطل منه الشرق آونة","وكان شغل بني العباس أزمانا",0,"ن",2,0],["فَنَتّجنا قَناعِساً رَعَتِ الحَوَّةَ","أَو جَوشَ فَهيَ قُعسٌ نِواءُ",1,"ا",2,0],["فَنَترُك صَرعى تَعصِبُ الطَيرُ حَولَهُم","وَلَيسَ لَهُم إِلّا الأَمانِيُّ ناصِرُ",2,"ر",1,0],["فَنتائجُ الحبّ التزاحُمُ في الهبا","وَالإفتخار به وما يستتبعُ",3,"ع",1,0],["فنتائج الأفهام فهمٌ ثاقبٌ","والفكر متقدٌ يُري الآراء",4,"ا",2,0],["فنتيجة الدنيا ثنا","ءٌ بعد قائله مؤبد",5,"د",1,0],["فَنِتُّ مِنَ الْبَلْوى بِقَلْبِ مُتَيَّمَ","تَرى نَلْتَقِي بَيْنَ الْمَقَامِ وَزَمْزَمِ",6,"م",1,0],["فنترك من مات نهب النسور","وندفن أحياءنا أوَّلا.",7,"ل",2,0],["فَنَتَجَت بَعض العِشار سَقباً","وَمَلأت بَعدَ الرِّضاع وَطبا",8,"ب",2,0],["فن تغني يا ذا الطول دام له الغنى","وفقر الذي أفقرت لن يتحولا",9,"ل",2,0],["فنترك دار من سرنا إليه","تأنُّ لدى القفول بنا أنينا",10,"ن",2,0],["فنَّتقى بك يا هارون سَورتَها","ونهتدى بالقوافى الحافظياتِ",11,"ت",1,0],["فنتركهم وغرا ونضرب هامهم","ونقصرهم حتى يجودوا بما أدوا",12,"د",3,0],["فنتاج أرضي والسماء تجودها","شعر يغذيني مدى الأعوام",13,"م",1,0],["فَنتشحُ المَجالسُ فيهِ حَتّى أَل","كواغد حاقها يُمنى وَيُسرى",14,"ر",2,0],["فنٌّ تفنَّن والأفنان يانعةٌ","لديك من كل فنٍّ يفحم العُلما",15,"م",2,0],["فنتّشحُ السيوفَ بلا حروبٍ","ونقتحم البحورَ بلا سفين",16,"ن",1,0]]}