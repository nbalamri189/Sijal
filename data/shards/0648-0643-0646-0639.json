{"poems":[[31,"محا رسم دار بالصريمة مسبل","https://www.aldiwan.net/poem6164.html","الطويل"],[72,"إذا كنت مشغولا وذا يوم جمعة","https://www.aldiwan.net/poem42757.html","الطويل"],[45,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[64,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[46,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85367","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[132,"ألا إنما دنياكم مثل حية","https://www.aldiwan.net/poem50483.html","الطويل"],[164,"بقلبي وجد ما عليه مزيد","https://www.aldiwan.net/poem58908.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[203,"بنوه على تلك اللحاظ الفواتك","https://www.aldiwan.net/poem45368.html","الطويل"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[309,"سقلى الله ربعا حل فيه الذي أهوي","https://www.aldiwan.net/poem16892.html","الطويل"],[354,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[358,"حافظ على العهد يا خليلي","https://www.aldiwan.net/poem40581.html","مخلع البسيط"],[396,"عليك بذكر الله يا طالب الأجر","https://www.aldiwan.net/poem54572.html","عموديه"],[396,"سلام على أهل الظنون الجميلة","https://www.aldiwan.net/poem54605.html","عموديه"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[473,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[505,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[563,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"حرارة عشقه تعطي بروده","https://www.aldiwan.net/poem34565.html","الوافر"],[572,"أخي لا تروعني بميل إلى أخ","https://www.aldiwan.net/poem69636.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70684","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59431","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56223","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115983","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95515","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48939","المتقارب"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123163","الوافر"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27667","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124783","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124784","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124773","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124757","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124762","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83239","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118786","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65284","المتقارب"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145066","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145061","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91305","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133286","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135506","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70152","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94623","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67648","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135068","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133140","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133070","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58078","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58034","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33280","السريع"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4973,"حكم","https://www.poetsgate.com/ViewPoem.aspx?id=188674",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[5074,"إلى ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=153514",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5277,"حذام","https://www.poetsgate.com/ViewPoem.aspx?id=188398",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""]],"verses":[["وَكُنَّ عَلى أَحيانِهِنَّ يَصِدنَني","وَهُنَّ مَنايا لِلرِجالِ وَغولُ",0,"ل",1,0],["وَكُن عالِماً أَنّي وَلا بُدَّ قائِلٌ","وَقَد قُلتُ فَاِجعَلني فَدَيتُكَ في حِلِّ",1,"ل",1,0],["وَكُن عَلى حَذَرٍ لِلناسِ تَستُرُهُ","وَلا يَغُرُّكَ مِنهُم ثَغرُ مُبتَسِمُ",2,"م",1,0],["وكن على نفسك مستحفظا","واحذر جوار الأنفس الحائره",3,"ر",2,0],["وَكُنَّ عَتادَ إِمّا فَكِّ عانٍ","وَإِمّا قَتلِ طاغِيَةٍ عَنودِ",4,"د",1,0],["وَكُن عَلى نفسك دو","ن غيرها معتمدا",5,"د",2,0],["وَكُنْ عَلَى حَذَرٍ تَسْلَمْ فَرُبَّ فَتىً","أَلْقَى بِهِ الأَمْنُ بَيْنَ الْيَأْسِ وَالْوَجَلِ",6,"ل",1,0],["وكنْ عالماً فيها ولا تكُ جاهلاً","بأحوالها من أن تمرَّسَ فيها",7,"ي",3,0],["وكن عونَه واحرسهُ وانصر جيوشَهُ","فما حفظُ شيء عليكَ يؤودُ",8,"د",1,0],["وكن عالِمَ الشرِّ لا عامِلا","لتَخلُصَ من مُوبِقات المَرام",9,"م",1,0],["وكنَّ على قلبي الجلالةَ والتقى","فأصبحتُ منها بينَ ناسٍ وناسكِ",10,"ك",1,0],["وَكن عصمَتي من جور دهر معاند","به الحر عبدو الصدوق كَذوب",11,"ب",1,0],["وكن عاملاً للَه بالطاعة التي","هي الزاد للأخرى ودع كل ما ألوى",12,"و",2,0],["وَكُن عالَماً أَن لا فِرارَ مِنَ القَضا","وَأَينَ يَفِرُّ المَرءُ مِمَّن لَهُ الأَمرُ",13,"ر",1,0],["وَكُن عَلى البُعد وَالتَداني","مُتّصل الودّ وَالمَحبَّه",14,"ب",2,0],["وكن عاملا بالعلم تحظى بنوره","وتعلو به مادمت حيا وفي النشر",15,"ر",1,0],["وكن عامر القلب بالخير والتقى","وبالذكر والفكر الصحيح المثبت",16,"ت",1,0],["وكُنْ على الدَّهر مِعواناً لذي أمَلٍ","يَرجو نَداكَ فإنَّ الحُرَّ مِعْوانُ",17,"ن",1,0],["وَكُن عَن جَميعِ العالَمينَ بِمَعزِلٍ","فَما مِنهُم حُرٌّ وَلا مَن لَهُ عَهدُ",18,"د",1,0],["وكن عن عيب ذي الدنيا سموحاً","فحيناً يغلب الهمَّ السماحُ",19,"ح",1,0],["وكن عاجزاً عنها تكن قادراً بها","فعدلك عنها منك نحو السوى ظلم",20,"م",1,0],["وكن عبده لا عبد حظ وشهوة","فما أنت ناويه على القلب طابع",21,"ع",1,0],["وكن عبداً ولاتك فيه ربّاً","على شيء له تصلى وقوده",22,"د",2,0],["وَكُنْ عَالِمَاً أَنِّي أَغَارُ عَلَى أَخِي","وَخِلِّي كَمَا أَنِّي أَغَارُ عَلَى عِرْسِي",23,"س",2,0],["وكن عالماً أن التيمم رافع","يصلى به كالماء كل التعبد",24,"د",1,0],["وكن عالماً أن الكلام إذا أتى","فأصغ له سمعاً وعي العلم ترشد",24,"د",1,0],["وكنْ عارفا كيدَ الزمانِ وأهلِه","وكنْ حازما إنْ كان فيك تفَرُّس",25,"س",1,0],["وكن على حذر من كيدهم فلهم","على معاداة أهل الحق عاداتُ",26,"ت",1,0],["وكن عبد رق ذل في عز حبه","تناجى على طور عزيز مقدس",27,"س",1,0],["وكن عونه في المعضلات وصن به ال","خلافة وامنحه المهابة والنصرا",28,"ر",2,0],["وكن على النفس وافي الحرص منتبها","فما عليك إذا أذنبت من بأسِ",29,"س",1,0],["وكن عالماً علما يقينا بان ذا","عظيم منال لا يقوم بالدر",30,"ر",1,0],["وَكُن عَلى أَعدائهم","كَالسيف مِن وَرائهم",31,"م",1,0],["وكنعم على الثلاث إي أجل","تصديق أو كحسب أو تكفي بجد",32,"د",1,0],["وكن عادلا فى الحُكم ما دُمتَ حاكماً","علىَّ فما أولى اعتدالِك بالعدل",33,"ل",1,0],["وكن عَكوفاً علىالإصلاح متَّخذاً","عزيمةً لاتنى يامن أنَبنَاهُ",34,"ن",3,0],["وكن عادلاً حازماً صارماً","فإن التراخي يَجُرُّ الدَّمار",35,"ر",1,0],["وكُن عن وصل صبّك غير آب","ورُدّ عليه قلباً فيك آبق",36,"ق",1,0],["وكن عارفا للدرس في كل حالة","ليصرف عند الله جائحة الوزر",37,"ر",1,0],["وكن عند ظني لا تخيبه إنه","من أكرمِ مطلوبٍ وأفقر طالبِ",38,"ب",1,0],["وكن عالما أن النسا لعب لنا","فحسن إذن مهما استطعت وجود",39,"د",1,0],["وكن عالما أن الفروض تقسمت","بعين كصوم مع صلاة تعبد",40,"د",1,1],["وكن عاملا بالعلم فيما استطعته","ليهدى بك المرء الذي بك يقتدي",40,"د",2,0],["وكن عالما أنّ القضاة ثلاثة","فقاض قمين بالنعيم المخلّد",41,"د",1,1],["وكن عالما أن القضاء فضيلة","وأجرٌ عظيم للمحق المؤيّد",41,"د",1,0],["وكن عن كل فاحشة جبانا","وكن في الخير مقداما نجيبا",42,"ب",2,0],["وكن عالما أن الذنوب جميعها","بكبرى وصغرى قسمت في المجوّد",43,"د",1,1],["وكن عالما أن السلام لسنّة","وردّك فرض ليس ندبا بأوطد",44,"د",1,1],["وكن عالما أن الشهادة منصب","من الدين حفظا للحقوق من الرد",45,"د",1,0],["وكن عالما أن الختان لواجب","مع الأمن في الأقوى وحتم التعبّد",46,"د",1,1],["وَكُن عَبدَ الحَيمدِ عَلى اللَيالي","مُجِدّاً في اللَيالي الباقِياتِ",47,"ت",1,0],["وكن عبيداً لهم لا تعترض أبداً","واضمم جناحك مع هذا من الرهبِ",48,"ب",1,0],["وكن عاطفا يا قضيب النّقا","فإنّ قضيب النّقا ينعطف",49,"ف",1,0],["وكن على البغي حربا لا تكن سلما","فالنصر للحرب ليس النصر للسلم",50,"م",1,0],["وكن عبدا لها واطلب رضاها","ولو بالصبر والذل المرير",51,"ر",1,0],["وكُن على طهارة موَظَفه","وفي ثيابٍ جدد منظّفَه",52,"ه",1,0],["وَكُن عَلى الدَهر معواناً لِذي امل","وَلا يَكُن مِنكَ لِلعافينَ حِرمان",53,"ن",1,0],["وَكُن عَلَيهِ مَدى الاِيامَ مُعتَمِداً","فَاِنَّهُ الرُكن ان خانَتكَ اِركان",53,"ن",1,0],["وَكُن عِندَ الخَلاعة ظَبيَ أنس","وَإِنك للوغى لَيثٌ وَأَجرأْ",54,"ا",1,0],["وكن عضدا لأهل العلم طرا","فباعك في الورى باع طويل",55,"ل",1,0],["وكن على الله في الأمور متَّكلاً","تنل بذاك العلا ونفي إقلالِ",56,"ل",1,0],["وَكُن عَلى شبهِ ملكيصادق ابداً","في رغد عيشٍ بِعَونِ اللَهِ معتضدا",57,"د",2,0],["وكن عاذري إني لشكري لشاكرٌ","ولا تكُ من عصر توارت ثواقبُه",58,"ب",2,0],["وكن عندما نرجوه منك فإننا","جميعاً لما أوليت من حسن أهل",59,"ل",1,0],["وكن عن الخلق مهما اسطعت مجتنبا","فان قربهم ضرب من الشلل",60,"ل",1,0],["وكن عداك الونا في العلم مجتهداً","تحظ بنيل العلا فاحلل بناديها",61,"ي",3,0],["وكن عوننا في كل حالٍ وعافنا","من الشر والأشرار بالحفظ والحرس",62,"س",1,0],["وكن عوني وأختم لي بخيرٍ","ومهد لي من الفردوس دارا",63,"ر",2,0],["وكن عالماً بالعلمِ واحذرْ بأن تُرَى","غداً حجةً كبرى عليكَ وتَدْفَعُ",64,"ع",1,0],["وكنْ عطوفاً على كلِّ الورى بهمُ","بَرّاً ولا سيما من عاش في الكِبَرِ",65,"ر",1,0],["وكُن على قدركَ لي واصلاً","لا زلتَ واهجرني على قدرِي",66,"ر",2,0],["وَكُن عِندَهُ كَالمَيتِ عِندَ مُغَسِّلٍ","يُقَلِّبُهُ ما شاءَ وَهوَ مُطاوِعُ",67,"ع",1,0],["وكن على حذر ٍ ممن تُؤمّنهُ","إن السلامة َ لا تحيا بلا حذر ِ",68,"ر",1,0],["وكن على خير صراط تجد","في جنَّة الله غدا مقعدا",69,"د",2,0],["وَكُنْ عَزِيْزَاً رَضِيَّ النَّفْسِ مُغْتَبِطَاً","واسْلُكْ طَرِيْقَ الهُدَى كَيْ يَكْبُرَ الحُلُمُ",70,"م",1,0],["وكن عونه في نيله كل سؤله","ودفعك ما يخشى ويحذر عقباه",71,"ا",2,0],["وكنْ عدلاً إذا ما جارَ يوماً","عدوٌّ..في مقاضاةِ الذمام",72,"م",1,0],["وكن على الله في مسعاك متكلاً","فالله يشفيك لا طب المداوينا",73,"ن",2,0],["وكن عاقلا يومي إليك بأنمل","كذا الباذل المعروف قد عز جانبه",74,"ب",2,0]]}