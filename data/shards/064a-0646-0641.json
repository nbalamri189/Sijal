iewPoem.aspx?id=174645",""],[4830,"حَوالِكُ النأي","https://www.poetsgate.com/ViewPoem.aspx?id=211128",""],[4578,"مرسلٌ فوق نجيل الخصر شد","https://www.poetsgate.com/ViewPoem.aspx?id=49408",""],[4927,"حَيَاْتُكَ تَمْثِيْلٌ، وَوَهْمٌ، وَمَسْرَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=4578",""],[460,"صرمت سعيدة ُ ودَّها وخلالها","https://www.poetsgate.com/ViewPoem.aspx?id=22229",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5183,"حلبة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180215",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5994,"كلام في الظل","https://www.poetsgate.com/ViewPoem.aspx?id=184662",""],[5997,"بيّاع الأضاحي","https://www.poetsgate.com/ViewPoem.aspx?id=215045",""],[6093,"آكل الناس بغيبٍ لم يَجد (الرَّمل)","https://www.poetsgate.com/ViewPoem.aspx?id=176083",""],[6102,"عَيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182765",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["يَنفونَ شائِبَها كَما","عَكَفَت عَلى البيضِ القُيونُ",0,"ن",1,0],["يَنفَضُّ جُمّاعُهُم عَن كُلِّ نائِبَةٍ","كَما تَهالَكَ تَحتَ الميسَمِ الوَبَرُ",1,"ر",1,0],["يَنفُرُ نَومي كَأَنَّ مُقلَتَهُ","تُشرَجُ أَجفانُها عَلى ضَمَدِ",2,"د",1,0],["يُنَفِّذُ حاجاتِ الرِجالِ وَحاجَتي","كَداءِ الجَوى في جَوفِهِ لا يُزايلُه",3,"ل",2,0],["يَنفينَ عَن ليطِ السَماءِ","ظَلائِلاً وَالماءُ جامِد",4,"د",1,0],["يَنفَحنَ أَشكَلَ مَخلوطا تَقَمَّصَهُ","مَناخِرُ العَجرَفِيَّاتِ المَلاجيجِ",5,"ج",1,0],["يُنَفِّشونَ لِحاهُم بَعدَ جارِهِمُ","لا بارَكَ اللَهُ في تِلكَ العَثانينِ",6,"ن",1,0],["ينفضج الجُود من يديه كما","ينفِضج الجود حين ينسَكِبُ",7,"ب",1,0],["ينفرّ من قد عطَّفته كأنما","تصحف لي معنى السرور شرورا",8,"ر",2,0],["ينفق إيري كلما حصلت","يدايَ من برّا إلى برّا",9,"ر",2,0],["ينفح عن راحتيه نشر ندى","كأنما الزهر حشو أكمامه",10,"م",2,0],["ينفسح الطرف حين تبدو","غُرتُه أيَّما انفساحِ",11,"ح",1,0],["ينفذ أقطارَ كلِّ منخرقٍ","تحمي الرياحَ النَّفوذ أقطاره",12,"ر",2,0],["يُنَفِّشون حقيراً من أمورهمُ","ولا ترى قدرهم في وزن تنفيش",13,"ش",1,0],["ينفِّرُ هذا كل صيدٍ محصَّلٍ","ويصطادُ هذا كل صيدٍ تعرّضا",14,"ض",2,0],["ينفضُونَ الغُيوبَ بالحدْس نَفْضاً","حين تَعْمَى بصائرُ النُفَّاض",15,"ض",1,0],["ينفي مناعِسَهُ بنفسٍ شهْمةٍ","وُيشاهدُ الهيجا بجأشٍ رابط",16,"ط",1,0],["يَنفي التُرابَ بِرَوقَيهِ وَكَلكَلِهِ","كَما اِستَمازَ رَئيسُ المِقنَبِ النَفَلا",17,"ل",2,0],["يَنفي أَعادِيَها عَن حُرِّ مَجلِسِها","عَمروُ بنُ غَنمٍ بِزارِ العِزِّ ذي الأَشَبِ",18,"ب",1,0],["يَنفُثنَ في الفِتيانِ مِن","روحِ الشَجاعَةِ وَالثَباتِ",19,"ت",1,0],["يَنفُضُ الرَوعُ أَيدِياً لَيسَ تَدري","أَسُيوفاً حَمَلنَ أَم أَغلالا",20,"ل",2,0],["يَنفي الهُوَينى حَزمُهُ","وَيَحوطُ دينَ اللَهِ جِدُّه",21,"د",2,0],["ينفي الصدى عن جنة نفحاتها","أرج وبرد يشفيان من الصدى",22,"د",2,0],["يَنفُرُ كَالريمِ أَلا فَاِنظُروا","إِلى بَخيلٍ وَهوَ عِندي كَريم",23,"م",1,0],["ينفض عن عينه كراهُ","ويقبل الراقد المسجَّى",24,"ج",2,0],["يَنفُرنَ عَن أُمِّ هاماتِ الرِجالِ بِها","وَالحَربُ يَفتَرِسُ الأَقرانَ صاليها",25,"ي",3,0],["يُنفِذُ في الآجالِ أَحكامَهُ","أَمرَ مُطاعِ الأَمرِ في طائِعِ",26,"ع",1,0],["يَنْفِي دبيبَ النومِ حين تَحسُّهُ","همٌّ يثورُ ولوعةٌ تنساقُ",27,"ق",1,0],["يَنفُضون الترابَ مَن مَسَّ منّا","كُلَّ وجهٍ فَردَّهُ مَعفورا",28,"ر",2,0],["يَنفي لِيَ الحالَ وَلَكِنَّهُ","يُدخِلُ لا في كُلِّ مُستَقبَلِ",29,"ل",1,0],["يَنفَعُ الطَيِّبُ القَليلُ مِنَ الرِز","قِ وَلا يَنفَعُ الكَثيرُ الخَبيتُ",30,"ت",1,0],["يَنفي الحَصى بِحافِرٍ","كَالقَدَحِ المَكبوبِ",31,"ب",1,0],["ينفجر الموت من صوارمها","والعسجد النضر من أناملها",32,"ل",3,0],["يُنَفِّسُ غَمَّهُ نَظَرٌ إِلَيها","وَيَقتُلُ داخِلَ الشَوقِ الجِوارُ",33,"ر",1,0],["يَنفيهِ أَصحابُهُ مِنهُم إِذا حَضَروا","وَإِن أَتانا وَهَبناهُ لِمُرتادِ",34,"د",1,0],["يَنفي مُواهِبُهُ النَوافِذَ كُلَّها","مِن سَيبِ مُشتَرَكِ النَدى وَهّابِهِ",35,"ب",2,0],["يُنَفَّقُ فِكري عَلَيَّ التُقى","وَيَأبى لَهُ الطَبعُ إِلّا كَسودا",36,"د",2,0],["يُنَفِّرُ طَيرَ الماءِ مِنها صَريفُها","صَريفَ مَحالٍ أَقلَقَتهُ الخَطاطِفُ",37,"ف",1,0],["يَنفي بِأَطرافِ الأَلاءِ شَفيفَها","فَغَدا وَكُلُّ خَصيلِ عُضوٍ يُرعَدُ",38,"د",1,0],["يُنْفِذُ الفكر في مجاهل دنيا","هُ فيبدو له الخفيُّ المغيّبْ",39,"ب",1,0],["يَنْفِرُ عنها ضَبُّ العَذاةِ كما","يَهابُ نَقْعاً من بارِدٍ شَبِم",40,"م",1,0],["ينفكُّ منها وافرٌ وكاملُ","وثالثٌ قد حارَ فيه الجاهلُ",41,"ل",1,0],["ينفكُّ منها مِثلُ ما ينفكُّ","من تلك حقاً ليس فيه شكُّ",41,"ك",1,0],["ينفكُّ منها ستَّةٌ مَقُولَه","مِن بينها ثلاثةٌ مَجْهُولَهْ",41,"ه",1,0],["ينفكُّ منها شَطْره وشَطْرُ","لم يأتِ في الأَشعارِ منه الذِّكرُ",41,"ر",1,0],["يَنفَحُ مِن أَردانِه المِسكُ وال","عَنبَرُ والغَارُ وَلبنَى قَفُوص",42,"ص",1,0],["يَنفُذُ القَضاءُ عَلى","مَن أَحَبَّ أَو كَرِها",43,"ر",3,0],["يُنْفقُون القِنْطارَ في تَرَفِ العَيْشِ","ولا يُحْسنون بالمِثْقالِ",44,"ل",1,0],["ينفث روح العلم من ثغوره","كنفث روح القدس للوحي \" علا\"",45,"ل",2,0],["ينفق في اهانتي صروفه","وانفق العزم وانفاقي زكى",46,"ا",1,0],["ينفي مواهبه النوافذ كلها","منْ سَيْبِ مُشْرك النَّدى وهَّابِه",47,"ب",2,0],["ينفحُ العَطر جِلدُها ويسيلُ الدِفءُ","في عِرْقها لذيذاً شهيّا",48,"ي",2,0],["يُنَفَّذُ ما تَبغي وتَنهى \" عقائلٌ \"","وتَعزِلُ فينا \" غانياتٌ \" وتَنصِب",49,"ب",1,0],["يَنْفي الهُوَيْنَا حَزْمُهُ،","وَيَحُوطُ دِينَ الله جِدّهْ",50,"د",2,0],["ينفِّرُ هذ كل صيدٍ محصَّلٍ","ويصطادُ هذا كل صيدٍ تعرّضا",51,"ض",2,0],["يَنفَحُ مِ، أَردانِه المِسكُ وال","عَنبَرُ والغَارُ وَلبنَى قَفُوص",52,"ص",1,0],["يَنفُحُ مِن أَردانِكَ المِسكُ وال","هِندِيُّ وَالغارُ وَلُبنى قُفوص",53,"ص",1,0],["ينفد الليل وإن طال وما","لعباب الهم ذي اللج نفد",54,"د",1,0],["ينِفُثُ في أطرافِها رُقيةً","تعالجُ العِىَّ وأغلالَهْ",55,"ل",2,0],["يَنفي الظُلامَةَ بِالحَديدِ مُذَلَّقاً","أَبَداً وَيَجتابُ الحَديدَ مُسَرَّدا",56,"د",2,0],["ينفذ في الأَعداء أمر رماحه","ويحكم فيهم الذي شاء نصلهُ",57,"ل",2,0],["يَنفَكُّ مِنها ما أَقامَ يَلَملَمٌ","أَو ما أَقامَ مَكانَهُ رَألانُ",58,"ن",1,1],["يَنفَدُ الدَهرُ وَكَم مِن أَثَرٍ","لَكُمُ باقٍ عَلى أَركانِها",59,"ن",3,0],["يَنْفُِرُ تِيهاً ثُمَّ يَثْنِيهِ مَا","يُبْصِرُ من وَجْدِي علَى نَفْرَتِهِ",60,"ت",2,0],["يَنفَضُ الرَأسَ مِنهُ مِن شِدَّةِ الجو","ع وَعَيشٌ فيهِ أَذى وَمَرارَةِ",61,"ر",2,0],["يَنفي الوَبا عن مائِها وهوائِها","وَترابِها ما صَحَّ من تَركيبها",62,"ب",3,0],["يَنفَعُ المَزكومَ مِنها ريحُها","ثُمَّ تَشفي داءَهُ إِن لَم تُنَش",63,"ش",1,0],["ينفّض أذيال الرضا عن تذكري","لأيامه اللائي بدأت بها العمرا",64,"ر",2,0],["ينفد المال والمكارم لا تن","فد والمجد للشجاع الصمود",65,"د",1,0],["يَنفي الجِحاشَ كَما يُشِذُّ بِكارَهُ","قِرمٌ يُنَهِّزُها يَعُضُّ حِقاقا",66,"ق",2,0],["ينَفُضُ لِبْدَتَه ضَيغَمٌ","ويَنظرُ في عِطْفِه سوذَنيق",67,"ق",1,0],["يَنْفِي العِدا عنه وما ضَرب الهُدى","بجِرانِه إلاّ بضَرْبِ الهادي",68,"د",2,0],["يُنفِقُ المالَ كلَّه في مُهِمَّا","تِ المَعالي فيُحرِزُ المَجدَ كلَّه",69,"ل",2,0],["ينفق العمر خائفاً","خوف من بات مُنفقا",70,"ق",2,0],["ينفعك في حين تلحد","وليس يبقى سوى الله",71,"ه",1,0],["ينفعون الورى في كل شيء ما يضرون","هل ترانا نراهم أو بنا يوم يرضون",72,"ن",1,0],["يُنفقون الأَموال حبًّا لوجه الل","ه منهم ويطعمون الطَّعاما",73,"ا",1,0],["ينفّس كلَّ كاربة بكَرٍّ","لدى يومٍ يضيقُ به المجال",74,"ل",1,0],["يَنْفُثُ صِلُّ اليَرَاعِ في يَدِهِ","سُمًّا غَدَا فيه كُلُّ دِرْيَاقِ",75,"ق",1,0],["ينفُض بعضَ ليلهِ","بها الغويرَ كُلَّهْ",76,"ل",2,0],["ينفُث في عَقد الجدو","بِ مزنةً منهلَّهْ",76,"ل",2,0],["ينفض طُرقَ الكرى بصيراً","بها وطُرْقي بلا دليلِ",77,"ل",1,0],["ينفض الونيةَ عن أعطافه","منفض المعقول لاقى مَنشَطا",78,"ط",2,0],["ينفُثُ فيها شجوَه كما اشتفى ال","مدنَفُ بالشكوى إلى العُوّادِ",79,"د",1,0],["ينْفَذُ ما كان لهُ آخِرٌ","ما أقْربَ المَهْدَ مِنَ اللَّحْدِ",80,"د",1,0],["ينفذُ قلباً والحديد قاصرٌ","ومقلةً والنقعُ ليلٌ مُظلم",81,"م",1,0],["يَنفُخُ في ناديهِ فَيَغدو","كَأَنَّهُ بَربَخُ الكَنيفِ",82,"ف",