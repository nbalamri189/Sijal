َيْرُ مُجِيبِ",2,"ب",1,0],["وإذا أسكرت نهى القوم مي","بكلام هل بعدها لي كلام",3,"م",1,0],["وإذا استريب بما أقول فشاهدي","هذا البناء ومن حماه ومن بنى",4,"ن",2,0],["وإذا أسكت المقاويل حزنٌ","ترجمت عنهم دموع تسيل",5,"ل",1,0],["وإذا اسْتشار الملك رأيك في دجى","أمرٍ ثنيت الصبح في الإسراف",6,"ف",1,0],["وإذا استعارَ الحمدَ يو","ماً معشرٌ ملَكُوا رقابهْ",7,"ب",2,0],["وإذا أُسخطوا رأوا ذم سابو","ر ولو كان ينزع الأكتافا",8,"ف",2,0],["وَإِذا اِستَقَلَ عَلى الجَوادِ كَأَنَّهُ","ظامٍ وَقَد ظَنَّ المَجَرَّةَ مَورِدا",9,"د",2,0],["وَإِذا اِستَجاشَ رَفَدتُهُ وَنَصَرتُهُ","وَإِذا تَصَعلَكَ كُنتُ مِن قُرَنائِهِ",10,"ا",3,0],["وإذا استجابوا للزَّمانِ تَناكروا","وتَراشَقوا بالشَّوكِ والأحْصابِ",11,"ب",1,0],["وإذا استقَلَّ الشيءُ قام بذاتهِ","وكذا ضياءُ الشمسِ يذهبُ باطِلا",12,"ل",2,0],["وَإِذا اِستَهَلَّ أَبو عَلِيٍّ لِلنَدى","جاءَ الغَمامُ المُستَهِلُّ بِسَكبِهِ",13,"ب",2,0],["وَإِذا اِستَصعَبَت مَقادَةُ أَمرٍ","سَهَلَّتها أَيدي المَهارى القودِ",14,"د",1,0],["وَإِذا اِسطُرفَت سِيادَةُ قَومٍ","بِنتَ بِالسُؤدُدِ الطَريفِ التَليدِ",14,"د",1,0],["وَإِذا اِستَعانَ بِخَطرَةٍ مِن فِكرِهِ","عَنَنٍ فَسِترُ الغَيبِ لَيسَ بِمُسجِفِ",15,"ف",1,0],["وَإِذا أَسرى فاحِشَةً","أَخَذَ المَرفوعَ أَو سارَ العَنَق",16,"ق",1,0],["وَإِذا اَستَقالَكَ ذو الإِساءَةٍ عَثرَةً","فَأَقِلهُ إِنَّ ثَوابَ ذَلِكَ أَوسَعُ",17,"ع",1,0],["وَإِذا اِستَحالَ بِأَهلِهِ زَمَنٌ","كَثُرَ القَذى وَتَكَدَّرَ الصَفوُ",18,"و",1,0],["وَإِذا اِستَغاثَ المُستَغيثُ تَسَرَّعوا","وَإِذا اِستَجارَ المُستَجيرُ تَرَفَّقوا",19,"ق",3,0],["وإذا أُسِيءَ فإن أس","مى الحبّ أن يُبدي رضاءه",20,"ه",1,0],["وإذا استشهد منكم بطل","جاده الغيث وحيته الديم",21,"م",1,0],["وَإِذا استَحْيَتْ مِنَ المَجدِ أتَى","مُعْرِباً عَنها لِسانُ المُنشِدِ",22,"د",1,0],["وإذا أساءَ وفيكَ حملٌ فاحتملْ","إنَّ احتمالكَ أعظمُ الأنصارِ",23,"ر",1,0],["وَإِذا اِستَبَدَّ الغاصِبونَ بِأُمَّةٍ","مُسِخَت وَبُدِّلَ خَلقُها تَبديلا",24,"ل",2,0],["وإذا استخرجوهُ يَسْتَخْرجُ الدُّر","رَ نَفِيساً مِنْ بَحْرِهِ المَسْجورِ",25,"ر",1,0],["وإذا اسْتَضاءَ شِهابَهُ بطَلٌ رأى","صُوَرَ الوقائعِ فوقه تَخْييلا",26,"ل",2,0],["وإذا استكانَ منَ النّوَى وعذابِها","فإلى لسانٍ في الثناء كمِفرَص",27,"ص",1,0],["وإذا اِسودَّت الليالي على النا","س تساوي الأعمى بها والبصير",28,"ر",1,0],["وإذا اِستَكانَت أُمَّة","فاحكم عليها بانقراض",29,"ض",1,0],["وإِذا اسْتَنْجَزْتُ يَوْماً وَعْدَه","قالَ لي يَمْطُلُ ذَكِّرْنِي غَدا",30,"د",2,0],["وَإِذَا اسْتَوى كِسْرَى وَأَجْلَسَ دُونَهُ","قُوَّادَهُ الْبُسَلاَءَ وَالأَقْيَالاَ",31,"ل",2,0],["وَإِذا اِستَيقَظَ مِن نَومَتِهِ","زادَتِ الأَوصابُ وَاِشتَدَّ القَلَق",32,"ق",1,0],["واذا استعطفه القلب على","فعل عينيه تعاطى فعقر",33,"ر",1,0],["وإذا استعنت الله واستنجدته","استنجدوا الصلبان والأصناما",34,"م",2,0],["وإذا استَوَى فيه الثَّكولُ وغيرُهُ","والساهرونَ الليلَ والنُّوام",35,"م",1,0],["وإذا أسِفتُ لمؤسِفٍ فلأنَّه","خِصْبُ الثَّرى يُشجيكَ فرطُ مُحوله",36,"ل",2,0],["وإذا أسْرَى إلى فاحِشَةٍ،","أخَذَ المَرْفُوعَ، أوْ سَارَ العَنَقْ",37,"ق",1,0],["وَإذا استُطْرِفَتْ سِيادَةُ قَوْمٍ،","بِنْتَ بالسّؤدَدِ الطّرِيفِ التّليدِ",38,"د",1,0],["وإذا استفزّك عابثٌ","يوماً كفاناً اللهُ شرّكْ",39,"ك",1,0],["وإذا أسرت مننت عن متجور","قتل امرءا للعجز الفي باليد",40,"د",1,0],["وَإِذا أسلمَ الفَتى فأبوهُ","مِنهمُ عندهُ وكلبٌ سواءُ",41,"ا",2,0],["وإذا استزادك زده واسجد","واقترب لا عاش من لم",42,"م",1,0],["وإذا استعنتَ فبالتجاربِ إنها","للنفسِ كالأضراسِ للأضراسِ",43,"س",1,0],["واذا استمطرت يمناه همى","وابل الغيث ومنها همعا",44,"ع",2,0],["وإذا استغرق المفكر في أحوال","دنياه لاعتراه ذهول",45,"ل",1,0],["وإذا اِستَسقَيتَ فاِستَسقِ له","بدل السُحب الغوادي مُقلتَي",46,"ي",1,0],["وَإِذا أَساءَ إِليّ مثلك أَنشَدَت","لا تعتب الوَغد اللَئيم إِذا أَسا",47,"س",2,0],["وإذا استُنْصِرَ الهُمامُ أَبو نَصْ","رٍ أَطاعَتْ لنا اللّيالي العَواصي",48,"ص",2,0],["وَإِذا اِستَغاثَ القَلبُ فيكَ بِمُفصِحٍ","لَبَّتهُ تَلبِيَةَ الصَدى أَجفاني",49,"ن",2,0],["وإذا استغاث إليه منه ماله","كانت إغاثته له صهٍ أو مهِ",50,"ه",1,0],["وإذا استجارَ فلا تُجِرهُ من النوى","واعلَم بأنَّ المُستَجيرَ الجائِرُ",51,"ر",1,0],["وإذا استُعْطِفَ المُلو","لُ تجنَّى وأَعرضَا",52,"ض",2,0],["وإذا استَمَحتُ به النَّوال وجدْتُه","غَيثاً يسِحُّ ومنهلاً مورودا",53,"د",2,0],["وإذا استلَّ ظُباً أَغْمدها","ثَمَّ في قمَّة مقدام وهام",54,"م",1,0],["وإِذا استشارَ سِوى عزائمِهِ","فالطِّرْفَ والخَطِّيِّ والنَّصْلا",55,"ل",2,0],["وإِذا اسْتعادَكَ ما رَأَيْتَ فقُلْ له","هُو في الهَوَى مَثَلٌ لَعَمْرُكَ سائِرُ",56,"ر",1,0],["وإذا اسودّتِ الهمومُ أزلْها","بحريقٍ زنادُهُ الراووقُ",57,"ق",1,0],["وإذا استغاثت من مخازن قعرها","طلعت جبالاً بئسها وجبالها",58,"ل",3,0],["وإذا استرضيته يغضب","وإذا صدّقته يكذب",59,"ب",1,0],["وإذا استطعت فكن لك جريمة","مستنكراً واستكف بالأوراق",60,"ق",1,0],["وإِذا استبلْ فإِنَّ ذكراه الهوى","مغنيطسُ النشوات للأرواح",61,"ح",1,0],["وإذا استرهفتُ خِلّاً فكأني","منه جرَّدتُ على عُنْقي حُساما",62,"م",2,0],["وإذا استتم فليلةٌ من شهره","نصفٌ وشهرك كلّه أنصافُ",63,"ف",1,0],["وإذا استُصرخوا لعضَّةِ عامٍ","ركبوا الجودَ يطردون الفقرا",64,"ر",2,0],["واذا استمرَّ المحْلُ يشفعُ شرَّهُ","خَصَرٌ يُرَذُّ له الحَصى والجندل",65,"ل",1,0],["وإذا اسودَّت المنى كان وريُ","القدح في شيمهِ وقورَ القداح",66,"ح",1,0],["وَإِذَا أسَرَّ هَوَاهُ يُعلِنُهُ الأسَى","هَل يَستَوِي الإسرَارُ وَالإعلاَنُ",67,"ن",1,0],["وإذا استُصرِخَ بِاسمي","لم أَكُن بالمُتَوانِي",68,"ن",2,0],["وإذا اِستُلّتِ الجيادُ وأبْكَيْ","ن جلوداً أَو اِعتَصرن حميما",69,"م",2,0],["وَإِذا اِستمعتَ فلا تُصِخْ إلّا إلى","كَلِمٍ جلبن على الورى من منطقي",70,"ق",2,0],["وَإِذا اِستَغاثَ بِهمْ جري","حٌ في وغىً سدّوا الفضا",71,"ض",2,0],["وَإِذا أَسال من الكَميّ نَجيعَه","غِبَّ الطّعانِ أسالَ كالفِرصادِ",72,"د",1,0],["وَإِذا اِسْتَرَبْتَ بِمنْ خَبَرْتَ فلا تَنَمْ","فَالدّاءُ يُعدِي والقليلُ يزيدُ",73,"د",1,0],["وَإِذا اِستمدَّ فَمِن أَكُف","فٍ بِالعَطايا باخِلاتِ",74,"ت",1,0],["وَإِذا اِستَعان على خُطو","بٍ أو كروبٍ كارثاتِ",74,"ت",1,0],["وإِذَا أَسعَد الزَّمانَ بلقيا","كَ فإِنِّي كَما يُقالُ السَّعِيد",75,"د",1,0],["وَإذَا اسْتَعَنْتَ بِهِمْ عَلى كَيْدِ العِدا","نَهضُوا بِأَبْطالٍ عَلى إِبْطَالِهِ",76,"ل",2,0],["وإذا استطاع الخلق آثر منحه","اعماره حتى يدوم بذى الدنى",77,"ن",2,0],["وإذا استتبَّ الأمن في طرق لنا","لا بد للمهجور من أن يعمرا