حيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[541,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[564,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[565,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[565,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216860","الخفيف"],[859,"","https://poetry.dctabudhabi.ae/diwan/poem/132486","الطويل"]],"verses":[["فَيَشتَفي مِمّا بِهِ الحَزينُ","دارَت عَلى القَومِ رَحى المَنونِ",0,"ن",1,0],["في شَبابٍ كَمَصابيحِ الدُجى","ظاهِرُ النِعمَةِ فيهِم وَالفَرَح",1,"ح",1,0],["في شِقِّهِ وَمَراميهِ وَريقَتِهِ","ما في الأَساطيلِ مِن بَطشٍ وَمِن عَطَبِ",2,"ب",1,0],["في شِعرِ شَوقي وَصَبري ما نَتيهُ بِهِ","عَلى نَوابِغِهِم دَع شِعرَ مُطرانِ",3,"ن",1,0],["فَيَشرَبنَ أَنفاساً وَهُنَّ خَوائِفٌ","وَتَرعُدُ مِنهُنَّ الكُلى وَالفَريصُ",4,"ص",1,0],["فِي شِعْرِهِ نَفَحَاتُ طِيبٍ خَالِدٍ","لَمْ يُؤْتِهَا وَرْدٌ وَلا رَيْحَانُ",5,"ن",1,0],["فَيَشْكُرُ مَظْلُومٌ كَفَاحَكَ دُونَهُ","بِمَا بِكَ مِنْ حَوْلٍ وَيَشْكُوهُ ظَالِمُ",6,"م",1,0],["في شعره حكمة مهذّبة","وروعة بالذكاء مشتعلة",7,"ل",2,0],["فَيَشفينَ مَن لا يُستَطاعُ شِفاؤُهُ","وَيَبقَينَ ما تَبقى الجِبالُ الخَوالِدُ",8,"د",1,0],["فيشهد نجمُ تلك ونجمُ هذي","ويجري من يديهِ ندىً وماء",9,"ا",2,0],["في شهرِ كانونَ وافاهُ الحمامُ لقد","أحرقتَ بالنارِ يا كانونُ أحشائِي",10,"ي",1,0],["في شعرِ مولانا السنا العالي وفي","إنشائِه الأشهى مزاج القهوة",11,"ه",1,1],["في شرعة البين وحكم الأسى","جفنٌ نزوحٌ وغرامٌ مقيم",12,"م",1,0],["في شِيْمَتَيْهٍ صرامة وسلامة","فهناك حَدَّا مُنْصُلٍ وصِفاحُه",13,"ح",2,0],["فَيَشُبُّ آوِنَةً بُرُوقاً لُمَّحاً","ويَصُبُّ آونةً غُرُوباً نُضَّجا",14,"ج",2,0],["فيشقَى بيَ الثورُ القَصِيُّ مكانُهُ","بحيث يراعيه الأَصَلُّ الخَفَيْدَدُ",15,"د",1,0],["في شيعة كالنجوم الزهر معتمة","أحدقن بالبدر أشباها وألافا",16,"ف",2,0],["فيشتري عالي الثناء ولو","أملق من ماله سوى العُلَق",17,"ق",1,0],["فيشهد اللَّهُ لقد أصبحتْ","إلى أيور الخلقِ مسكينَهْ",18,"ن",2,0],["فيَشفي جواهُ أو يُنفِّس كَربه","تظنِّيهِ أنْ قد شقَّني وعنانيا",19,"ي",2,0],["في شهقةِ الباكي","يُؤجِّجُها نُواحُ النَّادبهْ",20,"ه",1,0],["في شِعَابِ الزَّمان والموت أَمشي","تحتَ عبءِ الحَيَاة جَمَّ القيودِ",21,"د",1,0],["في شكل مرتفع منها ومنخفض","كأنما هي كثبان ووهدان",22,"ن",1,0],["في شرخ نيسان الجميل تفتحت","ازهاره يا حبذا نيسان",23,"ن",1,0],["في شُعاعِ الضُحى يَعودانِ ماساً","وَعَلى لَمحَةِ الأَصائِلِ تِبرا",24,"ر",2,0],["في شِدَّةٍ نُقِلَت أَناةُ كُهولِهِ","فيها وَحِكمَتُهُم إِلى فِتيانِهِ",25,"ن",2,0],["في شانِهِ وَلِسانِهِ وَبَنانِهِ","وَجَنانِهِ عَجَبٌ لِمَن يَتَفَقَّدُ",26,"د",1,0],["في شُعلَةٍ كَالشَيبِ لاحَ بِمَفرِقي","غَزِلٍ لَها عَن شَيبِهِ بِغَرامِهِ",27,"م",2,0],["فيشلة كالنجم منصبّة","على عجان الشيخ منقضّه",28,"ض",2,0],["في شطوط النيل مهد ال","فن مهد المعجزات",29,"ت",1,0],["في شبابٍ بهجٍ وفّى لها","وثنى ريعانَهُ عنّي فخان",30,"ن",1,0],["فَيَشرَبُ مِنها سَكرَةً عِنَبِيَّةً","تُنَّوِمُ عَيْنَ الصَّحوِ مِنهُ وما يَدري",31,"ر",2,0],["في شامَتَينَ هُوَ الشَريُ الجَنِيُّ لَهُم","وَالصابُ وَالشَرَقُ المَسمومُ وَالجَرَضُ",32,"ض",1,0],["فِي شِعَارٍ مِنَ الضَّنَى نَسَجَتْهُ","بِخُيُوطِ الدُّمُوعِ أَيْدِي الْغَرَامِ",33,"م",1,0],["فيشفعُ فيك الحسنُ والحسنُ شافعٌ","فأغضي حياءً أنْ يواجهَ بالردِّ",34,"د",1,0],["فَيُشهِرُ الحَمدُ مَا أخفَاهُ من مِنَنٍ","ويَكتُمُ الضَّربُ بِيض الهِندِ في القُلَلِ",35,"ل",1,0],["في شَناظي أُقَنٍ بَينَها","عُرَّةُ الطَيرِ كَصَومِ النَعام",36,"م",1,0],["في شَجِّها حيناً وفي طَعنِها","سينقضي العمرُ وأين الفرار",37,"ر",1,0],["في شذاكِ السريِّ ينشقُ منه ال","قلب ريَّا فردوسه المفقودِ",38,"د",1,0],["في شاطئٍ وقف العدوُّ إزاءَهُ","يبغي العبورَ ودونه أشبارُ",39,"ر",1,0],["في شاطئٍ قاني المياهِ كأنها","مصبُوغةٌ بدَمِ النهار الفَادي",40,"د",2,0],["في شرعة القول هو النميرُ","وهو على عيونه الأميرُ",41,"ر",1,0],["فِي شدْوِهِ وَنُوَاحِهِ رَجْعٌ لِمَا","طَوِيَتْ عَلَيْهِ سَرَائِرُ الأَحْيَاءِ",42,"ا",2,0],["فِي شُكْرِهِ لِلْمَانِعِينَ حِياَضَهَا","وَحُمَاةِ بَيْضَتِهَا مِنَ الشُّهَدَاءِ",42,"ا",2,0],["في شاطئ النيل: أهلوكم، وموطِنُكم","وفي الشآم لنا، أهلٌ، وأوطان",43,"ن",1,0],["في شعب «فِتْنَامَ» الأَبِيِّ","المُسْتَمِيتِ لنا بصائر",44,"ر",1,0],["في شرة السهو أجري سادرا نزقا","لا أرعوي عن غواياتي لمزدجر",45,"ر",1,0],["فيشيد مملكة ، ويستولي على","أسمى الرؤوس ، وأعرض الأكتاف",46,"ف",1,0],["فيشم خطى الفجر الآتي","في منتصف الليل الأليل",47,"ل",1,0],["فيشكو إلى من ؟ وما حوله","سوى اللّيل أو وحشة المخدع",48,"ع",1,0],["في شكل وجهك أقرا","شكل الإله الجميل..",49,"ل",1,0],["في شطرِ كوز صُنْعِ طَبٍّ أُفنون","أخضرَ في حُضْرة ِ جِرْو اليقطين",50,"ن",1,0],["فَيَشُبُّ آوِنَة ً بُرُوقاً لُمَّحاً","ويَصُبُّ آونة ً غُرُوباً نُضَّحا",51,"ح",2,0],["في شهر تموز صادفنا لما وعدت","بيض الصوارم بالدستور تنجيزا",52,"ز",2,0],["في شهرِ ذي القعدةِ الميمون قد ظهرت","فبان درٌ من الأصدافِ مكنونُ",53,"ن",1,0],["في شَتوةٍ شمطاءَ عانسةٍ","عزَّ الرَّضاعُ بها على الطفلِ",54,"ل",1,0],["في شَرف الدّين عن معروفكم عِوضٌ","كرامةُ الجارِ والإيثارُ بالزادِ",55,"د",1,0],["في شَتوةٍ شَمِطَ الليلُ البهيمُ بها","تُضاحِك الريحَ ما هبَّتْ بصَرَّادِ",55,"د",1,0],["في شأن يوسف إن فكّرت معتبرٌ","وهو الدليل الذي ما فيه معترض",56,"ض",1,0],["في شهركم هذا مواسم رحمةٍ","كُتبت لصائمه على الإِلزام",57,"م",1,0],["في شامخٍ أيِستْ وفودُ الريح من","جرِّ الذُّيولِ بصحنِهِ المسكونِ",58,"ن",1,0],["فَيَشْتَكِيانِ الوجْدَ ثُمَّتَ أَشْتكي","لأَضْعَفَ وَجْدي فوقَ ما يَجِدانِ",59,"ن",1,0],["في شَجْبِنا خُطَبٌ مُزَمْجِرةٌ","تَسْلو الحِمى وتِعِزُّ سُلْطانا",60,"ن",2,0],["في شعرِكِ الليلُ قد أرخى عباءتهُ","فانثالَ فوق الهوى مسترسلَ النسقِ",61,"ق",1,0],["في شِدَّةِ العَقدِ وَالحِلمِ الرَزينِ وَفي","القَولِ الثَبيتِ إِذا ما اِستُنَّتِ الكَلِمُ",62,"م",1,0],["فيشِبّ والفحشاءُ ضرعُ لبانهِ","والذِنبُ ذنبُ رجالنا ونِسانا",63,"ن",2,0],["فَيَشفوا النُفوسَ بِأَوتارِها","بِقَتلى أُصيبَت مِنَ الخَزرَجِ",64,"ج",1,0],["فيشفي قلوبَ السائلينَ مُجاوباً","كما يختم الأفواه إن كانَ سائلا",65,"ل",2,0],["في شَواطي النيلِ السَعيدِ مِياهٌ","فَاِسأَليها غَداً زَلالاً شَهِيّا",66,"ي",2,0],["في شِغافِ القلب، صوني","عِزَّتي: حُبِّي الأمينِ",67,"ن",1,0],["فيشرف كلُّ المسلمينَ تعرُّباً","كما شرفوا بالشّرعةِ الأحمدية",68,"ه",1,0],["فَيُشرِّدُ الأعلاجَ عن أرباضِنا","وثُغورِنا بعدَالمنامِ الشارد",69,"د",1,0],["فيَشكُرَ كلُّ مظلومٍ فقيرٍ","مساعدةً من الشهّمِ السخي",70,"ي",1,0],["في شُربِها مِن كُلِّ قَلبٍ شَهوَةٍ","فَكَأَنَّها خُلِقَت مِنَ الأَهواءِ",71,"ا",2,0],["فَيَشتَري رَيحانا","بدرهمٍ مجّانا",72,"ن",2,0],["في شيمة البَخيل","وَدائِه الدَخيلِ",72,"ل",1,0],["فيشتَفي قَلبيَ المُعنّى","وَيكتَسي جسميَ النَحيلُ",73,"ل",1,0],["فيشفع مقبول الشفاعة والورى","بجملتهم ما بين باك وحائر",74,"ر",1,0],["في شَهرِ مَولِدِ طَهَ","ذاكَ الحَبيبُ المُقَرَّبُ",75,"ب",1,1],["فيشرع من ناظريه المُدى","ليقطع عنها سبيل النجاه",76,"ه",1,0],["في شاشة الفن الجميل","وشاشة الموت الصفيقه",77,"ه",1,0],["فيشلة هدلاء ذات شعشق","مشرفة اليانوخ والمحوق",78,"ق",1,1],["في شَرِقِ اِسمِ الحُبِّ أَهلُ الهَوى","شِركي وَبي مَعناهُ مَخصوصُ",79,"ص",1,1],["في شادنٍ خمرةُ أجفانِه","تجتمعُ الناسُ لها دَسكَرَه",80,"ر",2,0],["فيشبه اللَه وهو عبدٌ","لأنه زاد في الرغاب",81,"ب",1,0],["فَيَشُكُ حَبات القُلو","ب بِمثلِ أَطرافِ العَوالي",82,"ل",2,0],["فيشتغل بالعاجله وبالفان","ويترك التقوى سبيل الأبرار",83,"ر",1,0],["في شاهق قد علا على زحل","ينطح أفق السما بالذقن",84,"ن",1,0],["في شِيعَةٍ مَلأَتْ ذُلّاً قُلُوبَهُمُ","نُهُوجُ سُبْلٍ إِلَيْها لِلْقَنَا ذُلُلِ",85,"ل",1,0],["فِي شِيعَةٍ أَمَّتْ إِلَيْكَ وَقَدْ رَأَتْ","أَنَّ الخضوعَ إِلَيْكَ خَيْرُ سِلاحِها",86,"ح",3,0],["فِي شِيعَةٍ بَيَّنَ الخزيُ المحيطُ بهم","عن غِبِّ مَا اجْتَرَحُوا غَدْراً وَمَا اقْتَرَفُوا",87,"ف",3,0],["في شَبَاها حُتُوفُ كلِّ محبٍّ","ينتجيها ولات حين مَناصِ",88,"ص",1,0],["فيشرُفُ السيفُ بمن شامه","ويفخَرُ المقتولُ بالقاتلِ",89,"ل",1,0],["فيشهدُ بالفضيلةِ غيرَ زورٍ","لهمتَّكَ التَّكَرُّمُ والحَياءُ",90,"ا",2,0],["فيشْقى الدارِ عُونَ به صباحاً","وكومٌ تحت جُنْحِ الليلِ روقُ",91,"ق",1,0],["في شخصك الأمة السمحاء قد برزت","تختال بالنصر في أثوابها القشب",92,"ب",1,0],["فيشاهد أن ليس ثم سوى ما","قد أراد مربي الحدثان",93,"ن",1,0],["فيشهدهم معنى الرقائق حيث ما","تجلت فلا ينكرن شأني وحاليا",94,"ي",2,0],["فِي شكَّةِ الحَربِ قَد تَبَدَّى","يَرجُمُهُ وَهمَهَا الظُّنُونُ",95,"ن",1,0],["في شكر نعمتك الأولى التي سلفت","شغل فكيف إذا انضافت لها أخر",96,"ر",1,0],["فَيَشْرَبُ مِنْ مَعينِ النَّصِّ حَتّى","يقُولَ لَقَدْ رَويتُ بما رَوَى لِي",97,"ل",2,0],["في شخصِ فاطمةٍ نُحيِّي النِّيلا","وَبَنيهِ والعَربَ الكرامَ الأولى",98,"ل",2,1],["في شَهوةٍ يا فاجِرَ الفُجَّارِ","تُجزَى جزاءَ الصَّابرينَ وأجرَهُم",99,"م",1,0],["في شَعشَعانِ عُنُقِ يَمخورِ","حابي الحُيودِ فارِضِ الحُنجورِ",100,"ر",1,0],["في شَخصِهِ الدِّينُ والدُّنيا قدِ اجتَمَعا","وذاك يَندُرُ أنْ تحظَى بهِ البَشَرُ",101,"ر",1,0],["فيُشرِقُ منهُ بالتاريخِ صُبحٌ","يقولُ اليومَ صارَ الشَرْقُ شَرْقا",102,"ق",2,0],["في شبابٍ يُحِبُّهُمْ من عراهمْ","يدفعون المكروه بالحسناتِ",103,"ت",1,1],["فَيَشمَتَ بالمَرأَينِ مَرءٌ تَخَطَّيَا","إلَيهِ قَرابَاتٍ شَدِيداً حِجَابُهَا",104,"ب",3,0]]}