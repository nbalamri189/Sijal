ه","https://www.aldiwan.net/poem67129.html","المجتث"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[329,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[334,"فيشلة هدلاء ذات شعشق","https://www.aldiwan.net/poem1118.html",""],[350,"في شرق اسم الحب أهل الهوى","https://www.aldiwan.net/poem15748.html","السريع"],[372,"حكم الهوى جر عليك الجرة","https://www.aldiwan.net/poem57449.html","السريع"],[378,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[381,"طلل عكف عليه بأني","https://www.aldiwan.net/poem49201.html","مجزوء الكامل"],[392,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[404,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[440,"إليك منك فرار الخائف الوجل","https://www.aldiwan.net/poem34809.html","البسيط"],[440,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[440,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[453,"يا لقلب إلى الهوى يتداعى","https://www.aldiwan.net/poem13817.html","الخفيف"],[459,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[462,"بهاء الدين دعوة ذي ولاء","https://www.aldiwan.net/poem15429.html","الوافر"],[462,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[480,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[483,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[483,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[507,"يا خير خل فدته نفسي","https://www.aldiwan.net/poem2460.html","مخلع البسيط"],[516,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[530,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[539,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[539,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[562,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[563,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[563,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"]],"verses":[["فَيَشتَفي مِمّا بِهِ الحَزينُ","دارَت عَلى القَومِ رَحى المَنونِ",0,"ن",1,0],["في شَبابٍ كَمَصابيحِ الدُجى","ظاهِرُ النِعمَةِ فيهِم وَالفَرَح",1,"ح",1,0],["في شِقِّهِ وَمَراميهِ وَريقَتِهِ","ما في الأَساطيلِ مِن بَطشٍ وَمِن عَطَبِ",2,"ب",1,0],["في شِعرِ شَوقي وَصَبري ما نَتيهُ بِهِ","عَلى نَوابِغِهِم دَع شِعرَ مُطرانِ",3,"ن",1,0],["فَيَشرَبنَ أَنفاساً وَهُنَّ خَوائِفٌ","وَتَرعُدُ مِنهُنَّ الكُلى وَالفَريصُ",4,"ص",1,0],["فِي شِعْرِهِ نَفَحَاتُ طِيبٍ خَالِدٍ","لَمْ يُؤْتِهَا وَرْدٌ وَلا رَيْحَانُ",5,"ن",1,0],["فَيَشْكُرُ مَظْلُومٌ كَفَاحَكَ دُونَهُ","بِمَا بِكَ مِنْ حَوْلٍ وَيَشْكُوهُ ظَالِمُ",6,"م",1,0],["في شعره حكمة مهذّبة","وروعة بالذكاء مشتعلة",7,"ل",2,0],["فَيَشفينَ مَن لا يُستَطاعُ شِفاؤُهُ","وَيَبقَينَ ما تَبقى الجِبالُ الخَوالِدُ",8,"د",1,0],["فيشهد نجمُ تلك ونجمُ هذي","ويجري من يديهِ ندىً وماء",9,"ا",2,0],["في شهرِ كانونَ وافاهُ الحمامُ لقد","أحرقتَ بالنارِ يا كانونُ أحشائِي",10,"ي",1,0],["في شعرِ مولانا السنا العالي وفي","إنشائِه الأشهى مزاج القهوة",11,"ه",1,1],["في شرعة البين وحكم الأسى","جفنٌ نزوحٌ وغرامٌ مقيم",12,"م",1,0],["في شِيْمَتَيْهٍ صرامة وسلامة","فهناك حَدَّا مُنْصُلٍ وصِفاحُه",13,"ح",2,0],["فَيَشُبُّ آوِنَةً بُرُوقاً لُمَّحاً","ويَصُبُّ آونةً غُرُوباً نُضَّجا",14,"ج",2,0],["فيشقَى بيَ الثورُ القَصِيُّ مكانُهُ","بحيث يراعيه الأَصَلُّ الخَفَيْدَدُ",15,"د",1,0],["في شيعة كالنجوم الزهر معتمة","أحدقن بالبدر أشباها وألافا",16,"ف",2,0],["فيشتري عالي الثناء ولو","أملق من ماله سوى العُلَق",17,"ق",1,0],["فيشهد اللَّهُ لقد أصبحتْ","إلى أيور الخلقِ مسكينَهْ",18,"ن",2,0],["فيَشفي جواهُ أو يُنفِّس كَربه","تظنِّيهِ أنْ قد شقَّني وعنانيا",19,"ي",2,0],["في شهقةِ الباكي","يُؤجِّجُها نُواحُ النَّادبهْ",20,"ه",1,0],["في شِعَابِ الزَّمان والموت أَمشي","تحتَ عبءِ الحَيَاة جَمَّ القيودِ",21,"د",1,0],["في شكل مرتفع منها ومنخفض","كأنما هي كثبان ووهدان",22,"ن",1,0],["في شرخ نيسان الجميل تفتحت","ازهاره يا حبذا نيسان",23,"ن",1,0],["في شُعاعِ الضُحى يَعودانِ ماساً","وَعَلى لَمحَةِ الأَصائِلِ تِبرا",24,"ر",2,0],["في شِدَّةٍ نُقِلَت أَناةُ كُهولِهِ","فيها وَحِكمَتُهُم إِلى فِتيانِهِ",25,"ن",2,0],["في شانِهِ وَلِسانِهِ وَبَنانِهِ","وَجَنانِهِ عَجَبٌ لِمَن يَتَفَقَّدُ",26,"د",1,0],["في شُعلَةٍ كَالشَيبِ لاحَ بِمَفرِقي","غَزِلٍ لَها عَن شَيبِهِ بِغَرامِهِ",27,"م",2,0],["فيشلة كالنجم منصبّة","على عجان الشيخ منقضّه",28,"ض",2,0],["في شطوط النيل مهد ال","فن مهد المعجزات",29,"ت",1,0],["في شبابٍ بهجٍ وفّى لها","وثنى ريعانَهُ عنّي فخان",30,"ن",1,0],["فَيَشرَبُ مِنها سَكرَةً عِنَبِيَّةً","تُنَّوِمُ عَيْنَ الصَّحوِ مِنهُ وما يَدري",31,"ر",2,0],["في شامَتَينَ هُوَ الشَريُ الجَنِيُّ لَهُم","وَالصابُ وَالشَرَقُ المَسمومُ وَالجَرَضُ",32,"ض",1,0],["فِي شِعَارٍ مِنَ الضَّنَى نَسَجَتْهُ","بِخُيُوطِ الدُّمُوعِ أَيْدِي الْغَرَامِ",33,"م",1,0],["فيشفعُ فيك الحسنُ والحسنُ شافعٌ","فأغضي حياءً أنْ يواجهَ بالردِّ",34,"د",1,0],["فَيُشهِرُ الحَمدُ مَا أخفَاهُ من مِنَنٍ","ويَكتُمُ الضَّربُ بِيض الهِندِ في القُلَلِ",35,"ل",1,0],["في شَناظي أُقَنٍ بَينَها","عُرَّةُ الطَيرِ كَصَومِ النَعام",36,"م",1,0],["في شَجِّها حيناً وفي طَعنِها","سينقضي العمرُ وأين الفرار",37,"ر",1,0],["في شذاكِ السريِّ ينشقُ منه ال","قلب ريَّا فردوسه المفقودِ",38,"د",1,0],["في شاطئٍ وقف العدوُّ إزاءَهُ","يبغي العبورَ ودونه أشبارُ",39,"ر",1,0],["في شاطئٍ قاني المياهِ كأنها","مصبُوغةٌ بدَمِ النهار الفَادي",40,"د",2,0],["في شرعة القول هو النميرُ","وهو على عيونه الأميرُ",41,"ر",1,0],["فِي شدْوِهِ وَنُوَاحِهِ رَجْعٌ لِمَا","طَوِيَتْ عَلَيْهِ سَرَائِرُ الأَحْيَاءِ",42,"ا",2,0],["فِي شُكْرِهِ لِلْمَانِعِينَ حِياَضَهَا","وَحُمَاةِ بَيْضَتِهَا مِنَ الشُّهَدَاءِ",42,"ا",2,0],["في شاطئ النيل: أهلوكم، وموطِنُكم","وفي الشآم لنا، أهلٌ، وأوطان",43,"ن",1,0],["في شعب «فِتْنَامَ» الأَبِيِّ","المُسْتَمِيتِ لنا بصائر",44,"ر",1,0],["فيشيد مملكة ، ويستولي على","أسمى الرؤوس ، وأعرض الأكتاف",45,"ف",1,0],["فيشم خطى الفجر الآتي","في منتصف الليل الأليل",46,"ل",1,0],["فيشكو إلى من ؟ وما حوله","سوى اللّيل أو وحشة المخدع",47,"ع",1,0],["في شكل وجهك أقرا","شكل الإله الجميل..",48,"ل",1,0],["في شطرِ كوز صُنْعِ طَبٍّ أُفنون","أخضرَ في حُضْرة ِ جِرْو اليقطين",49,"ن",1,0],["فَيَشُبُّ آوِنَة ً بُرُوقاً لُمَّحاً","ويَصُبُّ آونة ً غُرُوباً نُضَّحا",50,"ح",2,0],["في شهر تموز صادفنا لما وعدت","بيض الصوارم بالدستور تنجيزا",51,"ز",2,0],["في شهرِ ذي القعدةِ الميمون قد ظهرت","فبان درٌ من الأصدافِ مكنونُ",52,"ن",1,0],["في شَتوةٍ شمطاءَ عانسةٍ","عزَّ الرَّضاعُ بها على الطفلِ",53,"ل",1,0],["في شَرف الدّين عن معروفكم عِوضٌ","كرامةُ الجارِ والإيثارُ بالزادِ",54,"د",1,0],["في شَتوةٍ شَمِطَ الليلُ البهيمُ بها","تُضاحِك الريحَ ما هبَّتْ بصَرَّادِ",54,"د",1,0],["في شأن يوسف إن فكّرت معتبرٌ","وهو الدليل الذي ما فيه معترض",55,"ض",1,0],["في شهركم هذا مواسم رحمةٍ","كُتبت لصائمه على الإِلزام",56,"م",1,0],["في شامخٍ أيِستْ وفودُ الريح من","جرِّ الذُّيولِ بصحنِهِ المسكونِ",57,"ن",1,0],["فَيَشْتَكِيانِ الوجْدَ ثُمَّتَ أَشْتكي","لأَضْعَفَ وَجْدي فوقَ ما يَجِدانِ",58,"ن",1,0],["في شَجْبِنا خُطَبٌ مُزَمْجِرةٌ","تَسْلو الحِمى وتِعِزُّ سُلْطانا",59,"ن",2,0],["في شعرِكِ الليلُ قد أرخى عباءتهُ","فانثالَ فوق الهوى مسترسلَ النسقِ",60,"ق",1,0],["في شِدَّةِ العَقدِ وَالحِلمِ الرَزينِ وَفي","القَولِ الثَبيتِ إِذا ما اِستُنَّتِ الكَلِمُ",61,"م",1,0],["فيشِبّ والفحشاءُ ضرعُ لبانهِ","والذِنبُ ذنبُ رجالنا ونِسانا",62,"ن",2,0],["فَيَشفوا النُفوسَ بِأَوتارِها","بِقَتلى أُصيبَت مِنَ الخَزرَجِ",63,"ج",1,0],["فيشفي قلوبَ السائلينَ مُجاوباً","كما يختم الأفواه إن كانَ سائلا",64,"ل",2,0],["في شَواطي النيلِ السَعيدِ مِياهٌ","فَاِسأَليها غَداً زَلالاً شَهِيّا",65,"ي",2,0],["في شِغافِ القلب، صوني","عِزَّتي: حُبِّي الأمينِ",66,"ن",1,0],["فيشرف كلُّ المسلمينَ تعرُّباً","كما شرفوا بالشّرعةِ الأحمدية",67,"ه",1,0],["فَيُشرِّدُ الأعلاجَ عن أرباضِنا","وثُغورِنا بعدَالمنامِ الشارد",68,"د",1,0],["فيَشكُرَ كلُّ مظلومٍ فقيرٍ","مساعدةً من الشهّمِ السخي",69,"ي",1,0],["في شُربِها مِن كُلِّ قَلبٍ شَهوَةٍ","فَكَأَنَّها خُلِقَت مِنَ الأَهواءِ",70,"ا",2,0],["فَيَشتَري رَيحانا","بدرهمٍ مجّانا",71,"ن",2,0],["في شيمة البَخيل","وَدائِه الدَخيلِ",71,"ل",1,0],["فيشتَفي قَلبيَ المُعنّى","وَيكتَسي جسميَ النَحيلُ",72,"ل",1,0],["فيشفع مقبول الشفاعة والورى","بجملتهم ما بين باك وحائر",73,"ر",1,0],["في شَهرِ مَولِدِ طَهَ","ذاكَ الحَبيبُ المُقَرَّبُ",74,"ب",1,1],["فيشرع من ناظريه المُدى","ليقطع عنها سبيل النجاه",75,"ه",1,0],["في شاشة الفن الجميل","وشاشة الموت الصفيقه",76,"ه",1,0],["فيشلة هدلاء ذات شعشق","مشرفة اليانوخ والمحوق",77,"ق",1,1],["في شَرِقِ اِسمِ الحُبِّ أَهلُ الهَوى","شِركي وَبي مَعناهُ مَخصوصُ",78,"ص",1,1],["في شادنٍ خمرةُ أجفانِه","تجتمعُ الناسُ لها دَسكَرَه",79,"ر",2,0],["فيشبه اللَه وهو عبدٌ","لأنه زاد في الرغاب",80,"ب",1,0],["فَيَشُكُ حَبات القُلو","ب بِمثلِ أَطرافِ العَوالي",81,"ل",2,0],["فيشتغل بالعاجله وبالفان","ويترك التقوى سبيل الأبرار",82,"ر",1,0],["في شاهق قد علا على زحل","ينطح أفق السما بالذقن",83,"ن",1,0],["في شِيعَةٍ مَلأَتْ ذُلّاً قُلُوبَهُمُ","نُهُوجُ سُبْلٍ إِلَيْها لِلْقَنَا ذُلُلِ",84,"ل",1,0],["فِي شِيعَةٍ أَمَّتْ إِلَيْكَ وَقَدْ رَأَتْ","أَنَّ الخضوعَ إِلَيْكَ خَيْرُ سِلاحِها",85,"ح",3,0],["فِي شِيعَةٍ بَيَّنَ الخزيُ المحيطُ بهم","عن غِبِّ مَا اجْتَرَحُوا غَدْراً وَمَا اقْتَرَفُوا",86,"ف",3,0],["في شَبَاها حُتُوفُ كلِّ محبٍّ","ينتجيها ولات حين مَناصِ",87,"ص",1,0],["فيشرُفُ السيفُ بمن شامه","ويفخَرُ المقتولُ بالقاتلِ",88,"ل",1,0],["فيشهدُ بالفضيلةِ غيرَ زورٍ","لهمتَّكَ التَّكَرُّمُ والحَياءُ",89,"ا",2,0],["فيشْقى الدارِ عُونَ به صباحاً","وكومٌ تحت جُنْحِ الليلِ روقُ",90,"ق",1,0],["في شخصك الأمة السمحاء قد برزت","تختال بالنصر في أثوابها القشب",91,"ب",1,0],["فيشاهد أن ليس ثم سوى ما","قد أراد مربي الحدثان",92,"ن",1,0],["فيشهدهم معنى الرقائق حيث ما","تجلت فلا ينكرن شأني وحاليا",93,"ي",2,0],["فِي شكَّةِ الحَربِ قَد تَبَدَّى","يَرجُمُهُ وَهمَهَا الظُّنُونُ",94,"ن",1,0],["في شكر نعمتك الأولى التي سلفت","شغل فكيف إذا انضافت لها أخر",95,"ر",1,0],["فَيَشْرَبُ مِنْ مَعينِ النَّصِّ حَتّى","يقُولَ لَقَدْ رَويتُ بما رَوَى لِي",96,"ل",2,0],["في شخصِ فاطمةٍ نُحيِّي النِّيلا","وَبَنيهِ والعَربَ الكرامَ الأولى",97,"ل",2,1],["في شَهوةٍ يا فاجِرَ الفُجَّارِ","تُجزَى جزاءَ الصَّابرينَ وأجرَهُم",98,"م",1,0],["في شَعشَعانِ عُنُقِ يَمخورِ","حابي الحُيودِ فارِضِ الحُنجورِ",99,"ر",1,0],["في شَخصِهِ الدِّينُ والدُّنيا قدِ اجتَمَعا","وذاك يَندُرُ أنْ تحظَى بهِ البَشَرُ",100,"ر",1,0],["فيُشرِقُ منهُ بالتاريخِ صُبحٌ","يقولُ اليومَ صارَ الشَرْقُ شَرْقا",101,"ق",2,0]]}