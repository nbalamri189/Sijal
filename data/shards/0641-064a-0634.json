r&doWhat=shqas&qid=1620&r=&rc=1",""],[6229,"إنسان أي إنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65211&r=&rc=34",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""],[6302,"تَلاهِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86230&r=&rc=28",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""],[6343,"تهويمات في وجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1971&r=&rc=1",""],[6346,"أَقْبَلَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84886&r=&rc=11",""]],"verses":[["فَيَشتَفي مِمّا بِهِ الحَزينُ","دارَت عَلى القَومِ رَحى المَنونِ",0,"ن",1,0],["في شَبابٍ كَمَصابيحِ الدُجى","ظاهِرُ النِعمَةِ فيهِم وَالفَرَح",1,"ح",1,0],["في شِقِّهِ وَمَراميهِ وَريقَتِهِ","ما في الأَساطيلِ مِن بَطشٍ وَمِن عَطَبِ",2,"ب",1,0],["في شِعرِ شَوقي وَصَبري ما نَتيهُ بِهِ","عَلى نَوابِغِهِم دَع شِعرَ مُطرانِ",3,"ن",1,0],["فَيَشرَبنَ أَنفاساً وَهُنَّ خَوائِفٌ","وَتَرعُدُ مِنهُنَّ الكُلى وَالفَريصُ",4,"ص",1,0],["فِي شِعْرِهِ نَفَحَاتُ طِيبٍ خَالِدٍ","لَمْ يُؤْتِهَا وَرْدٌ وَلا رَيْحَانُ",5,"ن",1,0],["فَيَشْكُرُ مَظْلُومٌ كَفَاحَكَ دُونَهُ","بِمَا بِكَ مِنْ حَوْلٍ وَيَشْكُوهُ ظَالِمُ",6,"م",1,0],["في شعره حكمة مهذّبة","وروعة بالذكاء مشتعلة",7,"ل",2,0],["فَيَشفينَ مَن لا يُستَطاعُ شِفاؤُهُ","وَيَبقَينَ ما تَبقى الجِبالُ الخَوالِدُ",8,"د",1,0],["فيشهد نجمُ تلك ونجمُ هذي","ويجري من يديهِ ندىً وماء",9,"ا",2,0],["في شهرِ كانونَ وافاهُ الحمامُ لقد","أحرقتَ بالنارِ يا كانونُ أحشائِي",10,"ي",1,0],["في شعرِ مولانا السنا العالي وفي","إنشائِه الأشهى مزاج القهوة",11,"ه",1,1],["في شرعة البين وحكم الأسى","جفنٌ نزوحٌ وغرامٌ مقيم",12,"م",1,0],["في شِيْمَتَيْهٍ صرامة وسلامة","فهناك حَدَّا مُنْصُلٍ وصِفاحُه",13,"ح",2,0],["فَيَشُبُّ آوِنَةً بُرُوقاً لُمَّحاً","ويَصُبُّ آونةً غُرُوباً نُضَّجا",1