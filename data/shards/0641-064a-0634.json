Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""]],"verses":[["فَيَشتَفي مِمّا بِهِ الحَزينُ","دارَت عَلى القَومِ رَحى المَنونِ",0,"ن",1,0],["في شَبابٍ كَمَصابيحِ الدُجى","ظاهِرُ النِعمَةِ فيهِم وَالفَرَح",1,"ح",1,0],["في شِقِّهِ وَمَراميهِ وَريقَتِهِ","ما في الأَساطيلِ مِن بَطشٍ وَمِن عَطَبِ",2,"ب",1,0],["في شِعرِ شَوقي وَصَبري ما نَتيهُ بِهِ","عَلى نَوابِغِهِم دَع شِعرَ مُطرانِ",3,"ن",1,0],["فَيَشرَبنَ أَنفاساً وَهُنَّ خَوائِفٌ","وَتَرعُدُ مِنهُنَّ الكُلى وَالفَريصُ",4,"ص",1,0],["فِي شِعْرِهِ نَفَحَاتُ طِيبٍ خَالِدٍ","لَمْ يُؤْتِهَا وَرْدٌ وَلا رَيْحَانُ",5,"ن",1,0],["فَيَشْكُرُ مَظْلُومٌ كَفَاحَكَ دُونَهُ","بِمَا بِكَ مِنْ حَوْلٍ وَيَشْكُوهُ ظَالِمُ",6,"م",1,0],["في شعره حكمة مهذّبة","وروعة بالذكاء مشتعلة",7,"ل",2,0],["فَيَشفينَ مَن لا يُستَطاعُ شِفاؤُهُ","وَيَبقَينَ ما تَبقى الجِبالُ الخَوالِدُ",8,"د",1,0],["فيشهد نجمُ تلك ونجمُ هذي","ويجري من يديهِ ندىً وماء",9,"ا",2,0],["في شهرِ كانونَ وافاهُ الحمامُ لقد","أحرقتَ بالنارِ يا كانونُ أحشائِي",10,"ي",1,0],["في شعرِ مولانا السنا العالي وفي","إنشائِه الأشهى مزاج القهوة",11,"ه",1,1],["في شرعة البين وحكم الأسى","جفنٌ نزوحٌ وغرامٌ مقيم",12,"م",1,0],["في شِيْمَتَيْهٍ صرامة وسلامة","فهناك حَدَّا مُنْصُلٍ وصِفاحُه",13,"ح",2,0],["فَيَشُبُّ آوِنَةً بُرُوقاً لُمَّحاً","ويَصُبُّ آونةً غُرُوباً نُضَّجا",14,"ج",2,0],["فيشقَى بيَ الثورُ القَصِيُّ مكانُهُ","بحيث يراعيه الأَصَلُّ الخَفَيْدَدُ",15,"د",1,0],["في شيعة كالنجوم الزهر معتمة","أحدقن بالبدر أشباها وألافا",16,"ف",2,0],["فيشتري عالي الثناء ولو","أملق من ماله سوى العُلَق",17,"ق",1,0],["فيشهد اللَّهُ لقد أصبحتْ","إلى أيور الخلقِ مسكينَهْ",18,"ن",2,0],["فيَشفي جواهُ أو يُنفِّس كَربه","تظنِّيهِ أنْ قد شقَّني وعنانيا",19,"ي",2,0],["في شهقةِ الباكي","يُؤجِّجُها نُواحُ النَّادبهْ",20,"ه",1,0],["في شِعَابِ الزَّمان والموت أَمشي","تحتَ عبءِ الحَيَاة جَمَّ القيودِ",21,"د",1,0],["في شكل مرتفع منها ومنخفض","كأنما هي كثبان ووهدان",22,"ن",1,0],["في شرخ نيسان الجميل تفتحت","ازهاره يا حبذا نيسان",23,"ن",1,0],["في شُعاعِ الضُحى يَعودانِ ماساً","وَعَلى لَمحَةِ الأَصائِلِ تِبرا",24,"ر",2,0],["في شِدَّةٍ نُقِلَت أَناةُ كُهولِهِ","فيها وَحِكمَتُهُم إِلى فِتيانِهِ",25,"ن",2,0],["في شانِهِ وَلِسانِهِ وَبَنانِهِ","وَجَنانِهِ عَجَبٌ لِمَن يَتَفَقَّدُ",26,"د",1,0],["في شُعلَةٍ كَالشَيبِ لاحَ بِمَفرِقي","غَزِلٍ لَها عَن شَيبِهِ بِغَرامِهِ",27,"م",2,0],["فيشلة كالنجم منصبّة","على عجان الشيخ منقضّه",28,"ض",2,0],["في شطوط النيل مهد ال","فن مهد المعجزات",29,"ت",1,0],["في شبابٍ بهجٍ وفّى لها","وثنى ريعانَهُ عنّي فخان",30,"ن",1,0],["فَيَشرَبُ مِنها سَكرَةً عِنَبِيَّةً","تُنَّوِمُ عَيْنَ الصَّحوِ مِنهُ وما يَدري",31,"ر",2,0],["في شامَتَينَ هُوَ الشَريُ الجَنِيُّ لَهُم","وَالصابُ وَالشَرَقُ المَسمومُ وَالجَرَضُ",32,"ض",1,0],["فِي شِعَارٍ مِنَ الضَّنَى نَسَجَتْهُ","بِخُيُوطِ الدُّمُوعِ أَيْدِي الْغَرَامِ",33,"م",1,0],["فيشفعُ فيك الحسنُ والحسنُ شافعٌ","فأغضي حياءً أنْ يواجهَ بالردِّ",34,"د",1,0],["فَيُشهِرُ الحَمدُ مَا أخفَاهُ من مِنَنٍ","ويَكتُمُ الضَّربُ بِيض الهِندِ في القُلَلِ",35,"ل",1,0],["في شَناظي أُقَنٍ بَينَها","عُرَّةُ الطَيرِ كَصَومِ النَعام",36,"م",1,0],["في شَجِّها حيناً وفي طَعنِها","سينقضي العمرُ وأين الفرار",37,"ر",1,0],["في شذاكِ السريِّ ينشقُ منه ال","قلب ريَّا فردوسه المفقودِ",38,"د",1,0],["في شاطئٍ وقف العدوُّ إزاءَهُ","يبغي العبورَ ودونه أشبارُ",39,"ر",1,0],["في شاطئٍ قاني المياهِ كأنها","مصبُوغةٌ بدَمِ النهار الفَادي",40,"ي",1,0],["في شرعة القول هو النميرُ","وهو على عيونه الأميرُ",41,"ر",1,0],["فِي شدْوِهِ وَنُوَاحِهِ رَجْعٌ لِمَا","طَوِيَتْ عَلَيْهِ سَرَائِرُ الأَحْيَاءِ",42,"ا",2,0],["فِي شُكْرِهِ لِلْمَانِعِينَ حِياَضَهَا","وَحُمَاةِ بَيْضَتِهَا مِنَ الشُّهَدَاءِ",42,"ا",2,0],["في شاطئ النيل: أهلوكم، وموطِنُكم","وفي الشآم لنا، أهلٌ، وأوطان",43,"ن",1,0],["في شعب «فِتْنَامَ» الأَبِيِّ","المُسْتَمِيتِ لنا بصائر",44,"ر",1,0],["فيشيد مملكة ، ويستولي على","أسمى الرؤوس ، وأعرض الأكتاف",45,"ف",1,0],["فيشكو إلى من ؟ وما حوله","سوى اللّيل أو وحشة المخدع",46,"ع",1,0],["في شطرِ كوز صُنْعِ طَبٍّ أُفنون","أخضرَ في حُضْرة ِ جِرْو اليقطين",47,"ن",1,0],["فَيَشُبُّ آوِنَة ً بُرُوقاً لُمَّحاً","ويَصُبُّ آونة ً غُرُوباً نُضَّحا",48,"ح",2,0],["في شهر تموز صادفنا لما وعدت","بيض الصوارم بالدستور تنجيزا",49,"ز",2,0]]}