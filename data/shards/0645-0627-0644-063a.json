{"poems":[[68,"ألهم الله غنج ألحاظك العد","https://www.aldiwan.net/poem39915.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[422,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[473,"ما لغياث من غياث إذا","https://www.aldiwan.net/poem59780.html","السريع"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120007","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46711",""],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6757","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145745","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127280","الخفيف"],[5186,"يا هنائي ساعة اللقيا وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156511",""],[5848,"بلاوي متلتلة","https://www.poetsgate.com/ViewPoem.aspx?id=50611",""],[5848,"فتنة الريم","https://www.poetsgate.com/ViewPoem.aspx?id=48955",""],[1333,"قد بلغت الستين ويحك فاعلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56030&r=&rc=8",""]],"verses":[["ما لِغُصنِ الأَراكِ إِذ حَمَلَ الوَر","دَ غَدا وَهوَ مولَعٌ بِالخِلافِ",0,"ف",1,0],["ما لِغُصنِ النَعيمِ أَصبَحَ لَدناً","لَيسَ يَهتَزُّ وَهو لَدنُ المهزِّ",1,"ز",1,0],["مال غصنُ البان تيهاً وانثنى","في هواها مَيَلانَ الثمِلِ",2,"ل",1,0],["ما لغريمي قادراً واجداً","يمطُلُ مطلَ الفاجر المملقِ",3,"ق",1,0],["ما لغزلانٍ تصافيني الهوى","ما استطاعتْ وأُجازيها الكَدَرْ",4,"ر",1,0],["ما لِغِياثٍ مِن غِياثٍ إِذا","أَدَرتَهُ في لَولَبِ الصَكِّ",5,"ك",1,1],["ما لِغيري مثلُ الّذي لِيَ منهمْ","من صنوفِ الإعظامِ والإكرامِ",6,"م",1,0],["ما لغيري إن بِعتُكَ الوَشي بالوش","ي يَبيعُ الأشعار بالأشعار",7,"ر",1,0],["ما لغرامي به اكتتام","منذ وشي الدمع بافتضاحي",8,"ح",2,0],["ما لغرابِ البَين لا كانا","أضحكَ أقواماً وأبكانا",9,"ن",2,1],["ما لِغُصني ذَوى وَكانَ نَضيراً","وَلِظَهري اِنحَنى وَكانَ مُقَوَّم",10,"م",1,0],["ما لغرامي بكم ناشئاً","وما لصبري شائب المفرق",11,"ق",1,0],["ما لغُصْنِ النّوى وقد مالَ زهْواً","لوْ أقامَتْ ريحُ الصَّبا نَشْوانَهْ",12,"ن",2,0],["ما لغزالِ السِّرْبِ حظٌ إذا","ما عزّه المكروهُ بالفهْدِ",13,"د",1,0],["مال غصنا وفاح وردا نظيراً","وشدا بلبلا رقيق اللحون",14,"ن",1,0],["ما لغير الروح حب، وهوى","اللطف والأخلاق للشهم الأمين",15,"ن",1,0],["مال غصن وسمعت من الحمام :","فيه قلبٍ خلي من الوله !",16,"ل",2,0],["مال غصن الحكي بما لذ منها وطاب","فتنةٍ ... تستفز الغيم قبل القلوب !",17,"ب",1,1],["ما لغصني ذوى وكان نظيرا","ولظهري انحنى وكان مقوم",18,"م",1,0]]}