{"poems":[[29,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[40,"بدا يوم رحنا عامدين لأرضها","https://www.aldiwan.net/poem7838.html","الطويل"],[79,"ما غض مني أن أخلفت موعود","https://www.poetsgate.com/ViewPoem.aspx?id=33900",""],[124,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[203,"إذا ما بكيت فنح يا حمام","https://www.aldiwan.net/poem45592.html","المتقارب"],[422,"زارت وجنح الدجى يا سعد معتكر","https://www.aldiwan.net/poem53872.html","البسيط"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77658","الرجز"],[1488,"","https://poetry.dctabudhabi.ae/diwan/poem/145007","المجتث"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116542","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27977","السريع"],[2367,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102403","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92440","المجتث"],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""]],"verses":[["وَقالَ صِحابي ما لَهُ قُلتُ حاجَةٌ","تَهيجُ صُدوعَ القَلبِ بَينَ الحَيازِمِ",0,"م",1,0],["وَقالَ صِحابي قَد غُبِنتَ وَخِلتُني","غَبَنتُ فَلا أَدري أَشَكلُهُمُ شَكلي",1,"ل",2,0],["وَقالَ صَحابي هُدهُدٌ فَوقَ بانَةٍ","هُدىً وَبَيانٌ بِالنَجاحِ يَلوحُ",2,"ح",1,0],["وقال صوت عذار فوق صفحته","سفينة الحسن قد حطت على الجود",3,"د",1,0],["وقال صف ليلتي هذي مجملها","نفسي فداؤك من راجٍ ومنان",4,"ن",1,0],["وقالَ صحابي خذ في المنى","فقلتُ أراهُ ولو في المنامْ",5,"م",1,0],["وقال صَحْبيَ ممَّا راح يدهِشُهُمْ","أصْبَحْتَ في هذه الظلماء إصباحا",6,"ح",2,0],["وقال صبراً وانتظر صبحَ غدٍ","تُدني السماءُ بدرَها المحلِّقا",7,"ق",2,0],["وَقالَ صَوتي يُستَعار لِلغِنا","وَإِن يَكُن مِن مُعجب فَهوَ أَنا",8,"ن",2,0],["وقال صحبي: تنبّا","وكلمته الغزاله",9,"ه",1,0],["وقال صاحبك الصديق كيف بنا","ونحن منهم بمرأى الناظر العجل",10,"ل",1,0],["وقال صُنِ وَصِيَّتَة بنُصحٍ","فانَّ النُّصح حَليٌ للوصايا",11,"ا",3,0],["وقال صديق به عجزه","درك له كذا روى الأوّل",12,"ل",1,0],["وَقالَ صِحابي إِنَّكَ اليَومَ كائِنٌ","عَلَينا كَما عَفّى قُدارٌ عَلى إِرَم",13,"م",1,0],["وقال صلى الله مع سلامِ","عليه فى تحقيقِ ذا المقلمِ",14,"م",1,0],["وقال صحابي هدهد فوق بأنة","هوىً وبيانٌ بالنجاح يلوحُ",15,"ح",1,0],["وقال صفوُ التداني","يدومُ هذا الودادْ",16,"د",1,0],["وقال صواباً يرتضيه ذوو النهى","وهيهات العقيق ومن نزل",17,"ل",1,0]]}