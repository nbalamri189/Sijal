حُسّادَ مِنّي شَماتَةً","فَفِعلُكَ مَحمودٌ وَأَنتَ مُحَمَّدُ",4,"د",1,0],["فَلا تَبعَدَن إِنَّ المَنِيَّةَ غايَةٌ","إِلَيها التَناهي طالَ أَو قَصُرَ العُمرُ",5,"ر",1,0],["فَلا تَبعَدن فَكُلُّ فَتى سَيَأتي","عَليهِ الموتُ يَطرُقُ أَو يُغادي",6,"د",2,0],["فلا تَبعُدن تَحتَ الضَريحَةِ أَعظُمُ","رَميمٌ وَأَثوابٌ هُناكَ جُرودُ",7,"د",1,0],["فلا تَبخسَنْ حق المعلّم أنه","عظيم كحقّ الوالدين وأعظم",8,"م",1,0],["فلا تُبدِ منِ زير النساء تعجُباً","ولا تغترر بالزاهد المتنسِّك",9,"ك",1,0],["فَلا تَبغِيَنّي إِن أَخَذتَ وَسيقَةً","مِنَ الأَرضِ إِلّا حَيثُ تُبغى الجَعافِرُ",10,"ر",1,0],["فَلا تَبعَدَن إِنَّ المَنِيَّةَ مَوعِدٌ","عَلَيكَ فَدانٍ لِلطُلوعِ وَطالِعُ",11,"ع",1,0],["فلا تبكِ العراصَ ودمنتيها","بناظرةٍ ولا فَلْكَ الأميلِ",12,"ل",1,1],["فلا تبتذلْهُ في المَغاضب ظالماً","فلم تؤتَ وجهاً مثله للمغاضبِ",13,"ب",1,0],["فلا تبخل بعرضك حين تُهجَى","فإنك منه في خَلقٍ دريس",14,"س",1,0],["فلا تبعثْ عليكَ لسانَ حفلٍ","وحفلٍ بعد حفلٍ واحتفالِ",15,"ل",1,0],["فَلا تَبكوا رَجاءَ بَني تَميمٍ","فَما لَكُمُ وَلا لَهُمُ تَلاقي",16,"ق",2,0],["فَلا تُبصِرونَ ضَحايا الطَوى","وَلا يُبصِرونَ الَّذي تَصنَعون",17,"ن",1,0],["فَلا تَبعَثوا لي في النَسيمِ تَحِيَّةً","فَيَرتابُ مِن طيبِ النَسيمِ جَليسي",18,"س",2,0],["فلا تُبالي بقومِ","الحقُّ فيهمْ صَريعُ",19,"ع",1,0],["فلا تُبالِ إِذا مَا","أعْطوا نِداكَ ازْوِرارا",20,"ر",2,0],["فَلا تُبلِغاهُ ما أَقولُ فَإِنَّهُ","شُجاعٌ مَتى يُذكَر لَهُ الطَعنُ يَشتَقِ",21,"ق",1,0],["فَلا تَبعَد فَما كانَ المُرَجّى","نَوالَكَ مِن نَوالِكَ بِالبَعيدِ",22,"د",1,0],["فَلا تَبرَح تَتِمُّ عَلَيكَ نُعمى","وَلا تَبرَح يَدومُ لَكَ السُرورُ",23,"ر",1,0],["فَلا تَبعَد لَيالينا الخَوالي","وَفائِتُ عَيشِنا العَذبِ المَذاقِ",24,"ق",1,0],["فلا تُبعِدْ سيوفَكَ من سيوفٍ","فكم فتكَتْ بجبّارٍ عَنيدِ",25,"د",1,0],["فَلا تَبكِيَنَّ عَلى هالِكٍ","فَإِنَّ قُصاراكَ أَن تَهلِكا",26,"ك",2,0],["فَلا تَبعَد فَكُلٌّ سَوفَ يَلقى","شَعوباً يَستَديرُ بِها المَدارُ",27,"ر",1,0],["فَلا تَبعُدَنَ مِنّي قَريباً فَطالَما","طُلِبتَ فَلَم تَبعُد وَأَنتَ بَعيدُ",28,"د",1,0],["فَلا تَبْتَئِسْ إِنْ فَاتَ حَظٌّ فَرُبَّمَا","أَضَاءَتْ مَصَابِيحُ الدُّجَى وَهْيَ أُفَّلُ",29,"ل",1,0],["فَلا تَبتَئِس إِنّي مَعَ الصُبحِ باكِرٌ","أُوافي غَدَاً نَحوَ الحَجِيجِ الغَوادِيا",30,"ي",2,0],["فَلاَ تَبْتَئِسْ إنْ وَسَّعَ اللهُ في الْهُدَى","مذاهبَنا بالعلمِ واللهُ واسعُ",31,"ع",1,0],["فَلا تَبعُد فَكُلُّ فَتىً سَيَأتي","عَليهِ المَوتُ يَطرُقُ أَو يُغادي",32,"د",2,1],["فَلا تَبعَدَن إِنَّ المَنِيَّةَ مَوعِدٌ","وَكُلُّ اِمرِئٍ يَوماً بِهِ الحالُ زائِلُ",33,"ل",1,0],["فَلا تَبكُرَن يَوماً بِكَفِّكَ مُديَةٌ","لِتُهلِكَ فَرخاً في مَواطِنِهِ دَجّا",34,"ج",2,0],["فَلا تَبتَئِس لِلرِزّقِ إِن بَضَّ فاتِراً","وَلا تَغتَبِط إِن جاشَ رِزقُكَ أَو ثَجّا",34,"ج",2,0],["فَلا تُبرِ في مَأثَمٍ ناقَةً","فَرَبُّكَ إِمّا يُعاقِب يُبِر",35,"ر",1,0],["فَلا تَبخَلَنَّ يَدٌ كَزَّةٌ","عَلى المُستَميحِ بِقيراطِها",36,"ط",3,0],["فَلا تُبِنَّ لِمَجرى السَيلِ أَخبِيَةً","فَالحَزمُ يُنزِلُكَ الأَخيافَ وَالقُبُلا",37,"ل",2,0],["فَلا تَبني خِيامَكَ في مَحَلٍّ","فَإِنَّ القاطِنينَ عَلى اِحتِمالِ",38,"ل",1,0],["فَلا تَبكِ جَمَلاً إِن رَأَيتَ جِمالَها","تَسَنَّمنَ مِن رَملِ الغَضا ما تُسُنَّما",39,"م",2,0],["فَلا تَبْذُلْ هَوَاكَ إِلَى خَلِيلٍ","تَظُنُّ بِهِ الْوَفَاءَ وَلا تُعَادِ",40,"د",1,0],["فَلا تَبْرَحُوا أَوْ تَسْأَلُوهَا فَرُبَّمَا","أَعَادَتْهُ أَوْ جاءَتْ بِوَعْدٍ مُقَارِبِ",41,"ب",1,0],["فَلا تَبْتَئِسْ بِالأَمْرِ تَخْشَى وُقُوعَهُ","فَقَدْ يَأْمَنُ الإِنْسَانُ مِنْ حَيثُ يَفْرَقُ",42,"ق",1,0],["فَلا تَبْكِ مَيْتاً حَانَ يَوْمُ رَحِيلِهِ","فَلِلْمَوْتِ مَا يَمْضِي الْفَتَى وَيَرُودُ",43,"د",1,0],["فَلا تَبْتَئِسْ وَهْوَ ذَاكَ النُّضَارُ","إِذَا ما رَأَيْنَا لَهُ نُقَّدَا",44,"د",2,0],["فلا تبعد وهيهات التداني","بمن سطت به ريب المنون",45,"ن",1,0],["فلا تبتئسْ ان طاولتك قصائر","وناطحتك الكبشُ الخفاء قرونه",46,"ن",2,0],["فلا تبخلوا أنْ تزوروا أباً","جريرتُه أنَّ ذُّلاً أبى",47,"ا",1,0],["فلا تَبعُدا إن شأنَ الزمانِ","أنْ يُعقِبَ الصفوُ منه الكَدَر",48,"ر",1,0],["فلا تبتئس أن آلمتك حوادث","فأن قصارى الحر ان يتالما",49,"م",2,0],["فَلا تَبْرَحْ تُتِمُّ عَلَيْنا نُعْمَى،","وَلا تَبرَحْ يَدُومُ لكَ السّرُورُ",50,"ر",1,0],["فلا تَبكُرنْ يوماً، بكفّك مُدْيةٌ،","لتُلِكَ فَرخاً في مواطِنهِ دجّا",51,"ج",2,0],["فلا تُبَهْرجْ فتسوءُ الناقدا","فازت يدٌ تُضحِي لها مُعاقدا",52,"د",2,0],["فلا تبعد وهيهات التداني","بمن شطت به ريب المنون",53,"ن",1,0],["فلا تبكى ميتاً حانَ يومُ رحيلهِ","فَلِلْمَوْتِ مَا يَمْضِي الْفَتَى وَيَرُودُ",54,"د",1,0],["فلا تَبهَتي","غَرامانِ لي في الدُجى والنهار",55,"ر",1,0],["فلا تبتهج بعاجل الأمر فيهمُ","فسوف تَرى في أخدَعيْك المَشارِطا",56,"ط",2,0],["فلا تُبرِقْ لىَ الحسناءُ ثَغر","ولا تُرِسلْ على المَنيْنْ جَثْلا",57,"ل",2,0],["فلا تبغِ إتلافي فما لي طاقةٌ","على الصبر يا روحي ولست له أقوى",58,"و",2,0],["فَلا تَبخَلَن عَنّي بِما أَنا أَهلُهُ","فَكُلُّ نَفيسٍ أَنتَ لا بُدَّ واهِبُهْ",59,"ب",2,0],["فلا تَبتئس بالدَهر إن سَرَّ معشَراً","فنحسُهُم فيه على قدَر السّعد",60,"د",1,0],["فَلا تُبقِ في الإِحسانِ جُهداً فَإِنَّني","بَذَلتُكَ في التَقريظِ غايَةَ مَجهودي",61,"د",2,0],["فلا تبصر بمجلسهم رئيساً","سوى نذل تصدّر بالمصادر",62,"ر",1,0],["فَلا تَبعُد نُعَيمُ فَكُلُّ حَيٍّ","سَيَلقى مِن صُروفِ الدَهرِ حَينا",63,"ن",2,0],["فَلا تبعَد فَقد لاقيتَ حرّاً","يَرى ويقرُّ أَن أبلغتَ عُذرا",64,"ر",2,0],["فلا تبكِ بَعدي للكريمِ ندامةً","على حينَ لا يُوفي قَتيلٌ ببِسطام",65,"م",1,0],["فلا تِبْرَ إلاّ هانَ حينَ حوَيْتَه","فَناقَضَ حتّى عَزَّ حينَ حَواكا",66,"ك",2,0],["فلا تَبعد لقد لاقيتَ حُرّاً","يُحاذِرُ أن يُعابَ فَمُتَّ حُرّا",67,"ر",2,0],["فَلا تَبعَث الفَجرَ قَبلَ العِشاءِ","وَلا تُتبِع الأَوَّلَ الآخِرا",68,"ر",2,0],["فَلاَ تبتئِسْ وابشر فسعدك مقبلٌ","سيأتيك ما تَهوَى وإنْ رغُمَ الشاني",69,"ن",2,0],["فلا تَبتئِسْ بصُروفِ الزَّمانِ","ودَعْني فإنَّ يَقيني يَقيني",70,"ي",1,0],["فلا تبُحِ العنايةُ دون شيحٍ","مطيتُه ثلاثونَ الغُلام",71,"م",1,0],["فلا تَبِتْ أسوانَ في غَمرةٍ","ضاقَ بها ذرعكَ والصَّدرُ",72,"ر",1,0],["فَلا تُبقِني اليَومَ مُستَوحِشاً","بِرَبٍّ يُمَلّيكَ طولَ البَقا",73,"ق",2,0],["فلا تُبارِحْ بابَنا مَدى المَدَى","وسِرْ إذا آنَ السُّرى بركْبِنا",74,"ن",2,0],["فلا تبغِ إِلاَّ اللهَ والْزَمْ طَريقَتي","ودعْ زُمَرَ الحُسَّادِ أنَّى مالوا",75,"ل",3,0],["فلا تُبارِح