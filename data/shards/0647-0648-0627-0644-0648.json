px?id=215820",""],[5285,"هو وطني","https://www.poetsgate.com/ViewPoem.aspx?id=203189",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5518,"حين تسجد الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=201119",""],[5690,"اللّه أكبرُ هذا عصر تجديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=172153",""],[5720,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=210881",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6152,"القلوب أوطان","https://www.poetsgate.com/ViewPoem.aspx?id=203168",""],[2220,"ما إنْ علمتُ بأمرٍ فيهِ منْ عددٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11338&r=&rc=212",""]],"verses":[["هُوَ الواهِبُ الأَلفِ الَّتي لَو تَسومُها","قَبيلاً فَداها بِالجَديلِ وَداعِرِ",0,"ر",1,0],["هُوَ الوالِجُ العادي الَّذي لا يَروعُهُ","مِنَ البابِ بَيّابٌ عَلَيهِ وَحاجِبُ",1,"ب",1,0],["هُوَ الواهِبُ المِئَةَ المُصطَفا","ةَ إِمّا مِخاضاً وَإِمّا عِشارا",2,"ر",2,0],["هُوَ الواهِبُ الكومَ الصَفايا لِجارِهِ","يُشَبَّهنَ دَوماً أَو نَخيلاً مُكَمَّما",3,"م",2,0],["هُوَ الواهِبُ المِئَةَ المُصطَفا","ةَ كَالنَخلِ طافَ بِها المُجتَرِم",4,"م",1,0],["هُوَ الواهِبُ المِئَةَ المُصطَفا","ةَ كَالنَخلِ زَيَّنَها بِالرَجَن",5,"ن",1,0],["هُوَ الواهِبُ المُسمِعاتِ الشُرو","بَ بَينَ الحَريرِ وَبَينَ الكَتَن",5,"ن",1,0],["هُوَ الوَصْفُ العَجِيبُ وَلَيسَ تَلقَى","لَهُ وَجْهاً سِوَى الوَجْهِ القَسِيمِ",6,"م",1,0],["هُوَ الوافِدُ المَجبورُ وَالحامِلُ الَّذي","إِذا النَعلُ يَوماً بِالعَشيرَةِ زَلَّتِ",7,"ت",1,0],["هو الواهِبُ السلوانَ والصبرَ وحْدَهُ","لذي الرُّزْءِ والمُهْدِي الشِّفاء لذي السقمْ",8,"م",1,0],["هُوَ الوَفِيُّ وَلَكِنّي ذَكَرتُ لَهُ","مَوَدَّةً فَهوَ يَبلوها وَيَمتَحِنُ",9,"ن",1,0],["هُوَ الوَسمِيِّ جادَ فَكُن وَلِيّاً","فَما الوَسمِيُّ إِلّا بِالوَلِيِّ",10,"ي",1,0],["هو الوَجدُ حتّى ما تجفُّ المدامِعُ","ولا تَشتَفِي ممّا تُجِنُّ الأضالِعُ",11,"ع",1,0],["هُوَ الواهِبُ الكومَ الصَفايا لِجارِهِ","يَروحُ بِها العِبدانُ في عازِبٍ نَدي",12,"د",2,0],["هُوَ الواهِبُ الكومَ الصَفايا لِجارِهِ","وَكُلَّ عَتيقِ الحُرَّتَينِ أَسيلِ",13,"ل",1,0],["هو الواهِبُ المُقرَباتِ الجيادَ","صَواهِلَ واليَعمَلاتِ الرُّسُم",14,"م",1,0],["هو الوارثُ الدُّنيا ومن خُلقتْ لهُ","من الناس حتى يلتقي القُطرُ والقُطر",15,"ر",1,0],["هو الوارثُ الأرضَ عن أبوين","أبٍ مُصْطفى وأبٍ مُرتَضَى",16,"ا",1,0],["هُوَ الواهِبُ العِلقَ عَينَ النَفي","سِ وَالمُتَعَلِّي عَلى الواهِبِ",17,"ب",1,0],["هو الوارث النور الذي كان آية","لأبانه الماضين من عهد إلياس",18,"س",1,0],["هُوَ الوَجدُ أَرضانا بِأَدنى نَوالِكُم","وَأَقصى مُنانا أَن تَقارَبَ أَرضانا",19,"ن",2,0],["هو الورى وهي الدنيا وساعتُها","عُمْرٌ وزائرُها للأمن في حَرَم",20,"م",1,0],["هوَ الوثنُ الأعلى الّذي عمّ شرّهُ","فَما اللات وَالعزّى وثالثةٌ أخرى",21,"ر",2,0],["هو الواهب الآمال قبل اختلاسها","ظنوني ولم يشرق بهن ضميري",22,"ر",2,0],["هو الوقتُ يمضي والأمانيُّ تنطوي","وأيامُنا مَوصُولةٌ بالنَّوائب",23,"ب",1,0],["هَوَ الواهِبُ المِئَةَ المُصطَفاةَ","تُجاوِبُ مِنها العِشارُ الفِصالا",24,"ل",2,0],["هو الوزيرُ الذي يأوِي إلى وَزَرٍ","منهُ الأنامُ فَيُكْفَوا كلَّ ما كَلِفُوا",25,"ف",3,0],["هو الوَجْدُ يا ظمياءُ منكِ وَجَدْتُه","يحمِّلني في الحبّ ما لا أُطيقُه",26,"ق",2,1],["هو الوقت فانهب من زمانك خيره","فقد يك آت رحت ترجوه دونه",27,"ن",2,0],["هو الوهوبُ وسحب الجو باخلةٌ","والمستغاثُ وحامي الحي في شُغلِ",28,"ل",1,0],["هو الوارثُ العلياءَ عن كل كابرٍ","مُطاعٍ ومَسْعاهُ مُبِرٌّ وفاضلُ",29,"ل",1,0],["هو الواقف البأس المُمنَّع والغنى","على عاجليْ أِحسانه النصر والرفد",30,"د",1,0],["هو الوزير الذي سَحْناءُ غُرَّتهِ","وجودُه يَطْرُدان الفقر والغَسقا",31,"ق",2,0],["هو الواضع المعروفَ في كل معدِمٍ","كما يضعُ الهنديَّ في كلِّ باسِلِ",32,"ل",1,0],["هو الوزير الذي إِشراقُ غُرَّتهِ","يجلو ظلام اللَّيالي وهو عُلْجومُ",33,"م",1,0],["هو الواسع الأعطان للوفد والقرى","إذا كفَّهم صدرٌ من العام ضيق",34,"ق",1,0],["هو الواهب الحصداء ضاف لبوسها","مع الشطبة الجرداء صاف أديمها",35,"م",3,0],["هو الواهب الخيل قب الكلى","ظماء الفصوص إلى العيس قودا",36,"د",2,0],["هو الوابلُ الجودُ الذي لجُّ صدره","يعبُّ بفيضٍ لا بكيء ولا رشح",37,"ح",1,0],["هو الوجدُ ما بالي أنؤُ بحملِه","ضلالاً كأنَّي ما مُنيتُ بمثلِهِ",38,"ل",2,1],["هو الوَجْدُ لا شيلٌ هُناكَ ولا حَطُّ","ولا الحزبُ يُغْني حينَ يَعْدو ولا الرَّهْطُ",39,"ط",1,1],["هو الواضع الأولى لكل فضيلةٍ","فيوضع منه الشرع والكفر يرفع",40,"ع",1,0],["هو الولَدُ الّذي بأبيهِ نالَتْ","خُلودَ الأمْنِ أفئِدَةُ الرّجالِ",41,"ل",1,0],["هو الوكر طرنا منه والرّيش وافدٌ","وعدنا إليه الآن والرّيش ذاهب",42,"ب",1,0],["هُوَ الْوَقْف ما بَيْن الطّريقَيْن حيرَةً","فما عِلْمُ مَنْ لَمْ يَلْقَ غَيْرَ التّحَيُّرِ",43,"ر",1,0],["هو الوطنُ المحبوبُ يَرجو منَ أهلِهِ","سَماعاً لِشَكواهُ وأهلهُ أَنتُمُ",44,"م",1,0],["هو الوارد القدسيُّ كالسيل يحطمُ","فلا يستطيع القلب ذلك يكتمُ",45,"م",1,1],["هو الوجود القديم المحض جل ولم","أزل مُقَدَّرَهُ والحادثَ العدما",46,"م",2,0],["هو الوجود الحق لا أحد","سواه لا نار ولا نور",47,"ر",1,0],["هو الوجود له منه الرسول أتى","مبشراً ونذيراً صادق الخبر",48,"ر",1,0],["هو الوجود ومعلوماته ظهرت","من علمه فيه لا يحصى له عدد",49,"د",1,0],["هُوَ الوزيرُ الذي أضحَى يُشَدُّ بهِ","أزْرُ الكرامِ ويُرجَى عِندَهُ الوَطَرُ",50,"ر",1,0],["هوَ الوارِثُ الفَضلَ النَبيئِيِّ خالِصاً","مِنَ العِلمِ وَالعُليا وَمِن طيبِ مَحتِدِ",51,"د",1,0],["هو الوجهُ ساقَ النَّاسَ بالسيف لا العصا","وذلك سيفٌ للِّحاظ يماني",52,"ن",2,0],["هُوَ الوَزيرُ الَّذي ما شِئتَ مِن وَزرِ","مِنهُ عَلى دَهرِنا أَلفَيتَ مِن وَزرِ",53,"ر",1,0],["هو الوصيّ وليّ العهد قد شكرت","بنو العراق أياديه بما صَنعا",54,"ع",2,0],["هو الورد على خدي","ك بالنضرة يسبيني",55,"ن",2,0],["هو الوائل الفياض أجرى شريعة","زلالاً على أمثالها يعذب الورد",56,"د",1,0],["هو الوالد المعدود في الناس أمة","يحوز سجايا الأكرمين إذا عدا",56,"د",2,0],["هو الوابل الهطال والأسد الذي","إذا ما رآه الفقر مات بجلده",57,"د",2,0],["هُوَ الوَزيرُ الّذي أَضحَت وِزارَتُهُ","بَدر الوِزارَةِ مِن جَوزائِها نجَما",58,"م",2,0],["هُوَ الوَرِعُ النَّسّاكُ وَالعابِدُ الّذي","خَلا أَنّه يَحكيهِ ذا الآنَ عابِدُ",59,"د",1,0],["هو الوالدُ الزاكي الشفيق الذي أرى","علىَّ له بين الورى كلَّ واجب",60,"ب",1,0],["هُوَ الوَاحِدُ العَالِي عَلَى جِنْسِهِ وَمَنْ","يَرُمْ شِبْهَ علياهُ يَضَلَّ وَيَظْلِمِ",61,"م",1,0],["هو الوجه وجه الله والجنب جنبه","من الوحي قد قامت عليه الدلائل",62,"ل",1,0],["هو الوهم حتى قارب الحق ضده","وكادا على الافهام يشتبهان",63,"ن",1,0],["هو الوحي الذي قد كان يوحي","إلى الهادي على يد جبرئيل",64,"ل",1,0],["هو الوجد لولا ما تجن الجوانح","لما روت السفح الدموع السوافح",65,"ح",1,1],["هو الورع الذي امتحنون قدما","فألفوه عليما لا غبيا",66,"ي",2,0],["هوَ الوجدُ حتى لا يَجفُّ النواظرُ","وحتى تغيب الروحُ والجسمُ حاضرُ",67,"ر",1,1],["هو الوجودُ الذي جلَّت عوارفه","ستور أغطيةٍ عنه بأشباه",68,"ه",1,0],["هو الوجودُ فما تنفك صورته","مع الجمالِ الذي به تعشقه",69,"ق",2,0],["هو الواحد المعبود في كلِّ صورةٍ","تكون له مجلى فذلكم الله",70,"ل",2,0],["هو الوجودُ فما في الكون من عدد","والقول بالكثر في الأكوان بهتان",71,"ن",1,0],["هو الوجود ولكن ما حكمت به","فإنه عين أعيانٍ بدتْ فيه",72,"ف",3,0],["هو الوجودُ الذي في كونه سندٌ","لخلقه وله سمع هو البصر",73,"ر",1,0],["هو الوجود الذي الأعيان صورته","وإنَّ صاحبه مشارك النكد",74,"د",1,0],["هو الوجودُ الذي بالجودِ تعرفه","نفوسنا ولهذا الأمر قد عبدا",75,"د",2,0],["هو الوزيرُ ابن مسعودٍ أبو حسنٍ","قُطبُ المعالي الكريم الذات والسِّيَرِ",76,"ر",1,0],["هوَ الوَزير الَّذي عَمَّت مَواهبُه","بَني البَرية قاصيها وَدانيها",77,"ي",3,0],["هو الوطني الحر والمحسن الذي","على جوده قد قام الف دليل",78,"ل",1,0],["هو الوزير الذي شاعت مآثره","في المجد لا يبرح التاريخ يرويها",79,"ي",3,0],["هو الوقت فان كل ما فيه زائل","سريعاً ولو بث السرور ولو درا",80,"ر",2,0],["هو الواهب المعطي فليس عطاؤه","يُعَدُّ ولا يحصى وليس يزول",81,"ل",1,0],["هو الوهم مفتاح السرور لكادح","ومنجاته اما هوى في المضايق",82,"ق",1,0],["هو الوزير الذي أوصافه شهدت","لها البرية ان لا وصمة فيها",83,"ي",3,0],["هو الوطن الأسمى وإن كان مولدي","بعاملة أعلى الشئام رواسيه",84,"ي",2,0],["هُوَ الوَردُ طيباً وازدهآءً ومنظراً","وزهرتُهُ منهُ على ذلك الخَدِّ",85,"د",1,0],["هو الولي المرتضى أبو الحسن","أخلاقه تجلو عن القلب الحزين",86,"ن",1,0],["هو الوعدُ نصرُ الله والفتحُ أقبلا","لينفذ حُكم كان في الوعد يُفْقَهُ",87,"ه",1,0],["هو الورد من روض بخدي جنيته","وورد خدودي كل وقت أوانه",88,"ن",2,0],["هو الوجد يذكيه الجوى في الجوانح","فيجري بمنهل الدموع السوافح",89,"ح",1,1],["هو الواردُ المرغوبُ عنهُ فكلّما","ألمّ بفَوْدٍ وفْدُهُ يتألّمُ",90,"م",1,0],["هو الوفاق وتطهير الجنان وتَق","ييد اللسان فلا غلٌّ ولا غيب",91,"ب",1,0],["هو الواهب الاموال في كف حاتم","ولم تدرِ يمناه بمنح شماله",92,"ل",2,0],["هوَ الوَسيلة للرحمن فاسع له","يا طالب الصفح عن ذَنب بغفران",93,"ن",1,0],["هُوَ الوَردُ مِن قَبلُ وَقَتَ الصِبا","صَبَوتُ بِهِ صَبوَةَ العَندَليبِ",94,"ب",1,0],["هو الواحد الحي القديم له البقا","مليك يولي من يشاء ويعزل",95,"ل",1,0],["هو الوسيلة والجاه العظلم لمن","رام النجاة إذا ما انتابت النوب",96,"ب",1,0],["هو الوَرع الاوّاه شَيخي مُحَمَّد","هُوَ القانِت السجاد في جنح فاحم",97,"م",1,0],["هُوَ الوَزيرُ الَّذي تَأبى مَناقِبَه","عَن أَن يُحيطُ بِها الحَسّابُ بِالعَدَد",98,"د",1,0],["هو الوجيه بن الوجيه الذي","بدر الدجى من جيبه يطلع",99,"ع",1,0],["هو الوامق الموموق من كل فطرةٍ","وزيرٌ أتى للكون من جودة الدهرِ",100,"ر",1,0],["هو الواهب الآمال في كل بغيةٍ","هو المانح اللاجين من مالهِ الدثر",100,"ر",1,0],["هو الواحد القَهّار والمصدِر الورى","وكلٌّ إليهِ عَودهُ ومناصبُه",101,"ب",2,0],["هو الواحد الفرد الذي باسمه غدت","منابر أهل الفضل تحيا إلى الحشر",102,"ر",1,0],["هو الوَقتُ كالسَّيفِ، يَحتَاجُ صَقْلا","فَكُن _قَبلَ أَن تَطلُبَ الخُبزَ_ حَقلا",103,"ل",2,1],["هو الوطن الأم ما اختاره","ليُخلَقَ فيه ليقطنه",104,"ن",2,0],["هو الوطنُ الذي نهوى","وعِشنا في حناياه",105,"ا",2,0],["هو الورعُ المعششُ قلبَ حرٍّ","بتقوى الله لم يظلم خليله",106,"ل",2,0],["هو الوقت إذْ يُبدي جليّا خصاله","بيانا بقدرٍ أو برخصٍ معادنه",107,"ن",2,0],["هُوَ الوَجْهُ الذي نُسِبَتْ إِلَيْهِ","مَصَابِيحُ الحَيَاةِ رُفِعْنَ رَفْعَا",108,"ع",2,0],["هو الوفيق الذي شاعت مناقبهُ","في الشرق والغرب في فضل وتمجيدِ",109,"د",1,0],["هو الوزير الذي تعلو مراتبهُ","بالجد لا بسخاء غير محمودِ",109,"د",1,0],["هو الوطنُ الداعي لشرعِ محمدٍ","لشرعِ الذي في حبهِ القلبُ يَأْلَفُ",110,"ف",1,0],["هو الوطنُ المنصورُ باللهِ حيثُما","دعا دعوةً قامتْ له الأرضُ تَهتِفُ",110,"ف",1,0],["هو الواهبُ الحصداءَ والبيضَ والقنا","وحُمرَ الوطايا والمطهّمةَ القبّا",111,"ب",2,0],["هُوَ (الودودُ )و(الحقُّ) ، رَحمتُهُ","فاقَتْ حُدُودَ الوَصفِ والكَلِمِ",112,"م",1,0],["هُوَ الواقِعُ المَهزُومُ أَرخَى ظِلالَهُ","عَلَيكَ , وَما أَرخَى سَتائِرَهُ النَّصرُ",113,"ر",1,0],["هو الوطن الذي أنست فيه","أماني والسكينة والغراما",114,"م",2,0],["هو الوجود الذي الأعيان صورته","وإنَّ صاحبه مشاركث النكدِ",115,"د",1,0]]}