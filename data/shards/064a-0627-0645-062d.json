w.aldiwan.net/poem50502.html","الكامل"],[126,"الموت أبكى جملة الأقوام","https://www.aldiwan.net/poem50524.html","الكامل"],[141,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[183,"يا محل الروح من جسدي","https://www.aldiwan.net/poem14498.html","أحذ الكامل"],[227,"لا تردى بالسلامه","https://www.aldiwan.net/poem50783.html","مجزوء الرمل"],[269,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[280,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[280,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[295,"جلا الكؤوس فجلى ظلمة السدف","https://www.aldiwan.net/poem33219.html","البسيط"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[362,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[388,"يا محمد إذا شيت الهنا والمبره","https://www.aldiwan.net/poem54432.html","عموديه"],[388,"يا محمد لقينا الخير كله في الخير","https://www.aldiwan.net/poem54579.html","عموديه"],[402,"يا محب النجاة أصغ لقولي","https://www.aldiwan.net/poem49424.html","الخفيف"],[413,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[434,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[434,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[438,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[438,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[451,"الياس عساف لم تبرح روائعه","https://www.aldiwan.net/poem61731.html","البسيط"],[459,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[513,"يا محباً من النجوم الزبانا","https://www.aldiwan.net/poem12074.html","الخفيف"],[549,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[556,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[584,"أيها الهاجر حدث","https://www.aldiwan.net/poem17528.html","مجزوء الرجز"]],"verses":[["يَا مَحَلاًّ لِخُلَّتِي وَانْتِخَائِي","لَمْ يُبِحْ لِي الْخُرُخجَ بَابُ الرَّخَاءِ",0,"ا",2,1],["يا مُحِبَّ الجِدالِ نَم مُستَريحاً","لَيسَ في المَوتِ مَنفَذٌ لِلجِدالِ",1,"ل",1,0],["يا مُحِلّي يَفاعَ حالٍ مَكانُ النَ","جمِ مَهما يُقَس إِلَيهِ حَضيضُ",2,"ض",1,0],["يَا مُحِبِّي مُحَمَّدٍ وَهُمُ صَفْ","وَةُ مِصْرَ التَقَتْ بِهَذَا المَقَامِ",3,"م",1,0],["يا مُحكَمِ بنُ طُفَيلٍ قَد أُتيحَ لَكُم","لِلَّهِ دَرُّ أَبيكُم حَيَّةُ الوادي",4,"ي",1,1],["يا محسن الظنّ هذا نحو أنعمه","بمفرد الفضل قد نادى مناديه",5,"ي",2,0],["يا محسناً إن أساءَ الزمانُ وإن","مزّق حال الفتى فمر فيه",6,"ف",3,1],["يا محيِيَ الشعر والسماح وقد","كانا جميعاً مُضَمَّنَي جدف",7,"ف",1,0],["يا محبَّ الجمالِ ليس جميلاً","بجميلٍ ألّا يريك جمالهْ",8,"ل",2,0],["يا مُحِيَ مُهجَتي وَيا مُتلِفَها","شَكوى كَلَفي عَساكَ أَن تَكشِفَها",9,"ه",2,1],["يامُحيِيَ مُهجَتي وَيا مُتلِفَها","شَكوى كَلَفي عَساكَ أَن تَكشِفَها",10,"ه",2,1],["يا محسناً للعينِ في إقباله","ما تنتهي العينانِ من إحسانِه",11,"ن",2,0],["يا مُحِبَّ الإِحسانِ في زَمَنٍ أَص","بَحَ فيهِ الإِحسانُ وَهوَ بَغيضُ",12,"ض",1,0],["يا مُحسِناً حَسَناً قَد صَالَ مَنظَرُهُ","عَلَى البُدُورش وَيُمنَاهُ عَلَى البِدَرِ",13,"ر",1,1],["يا مُحِلَّ السَقامِ بي","خُذ مِنَ الحُبِّ ما بَقي",14,"ي",1,0],["يا مَحَلّي عَلَيكَ مِنّي سَلامٌ","سَوفَ أَمضي وَيُنجِزُ المَوعودُ",15,"د",1,0],["يا مُحبِيَ مُهجَتي ويا مُتْلِفَهَا","شكوى كَلَفِي عَساكَ أن تَكْشِفَها",16,"ه",2,1],["يَا مُحْتَفِينَ بِفاضِلٍ قَمِنٍ","أَنْ توسِعُوهُ لِفَضْلِهِ شُكْرَا",17,"ر",2,0],["يَا مُحْيِياً فَنا وَمَيْتاً دُونَهُ","يَا لَيْتَ حَظَّكَ مِنْهُ كَانَ قَلِيلاَ",18,"ل",2,0],["يَا مُحْسِنونَ جَزَاكُمُ المَوْلى بَمَا","يَرْبُو عَلى مَسْعَاكُمُ المَحْمُودِ",19,"د",1,0],["يَا مَحْفِلاً هُوَ لِلفُؤَادِ مَسَرَّةٌ","فِي لَيْلَةٍ هِيَ قُرَّةٌ لِلنَّاظِرِ",20,"ر",1,0],["يَا مُحْرِزاً بِدُؤُوبِهِ وَبِجَدِّهِ","أَسْمَى مَكَانٍ لِلْمُجِدُّ الدََّائِبِ",21,"ب",1,0],["يَا محْتَفِينَ تفَضُّلاً بِأَخٍ","يَهْفُو إِلَيْكُمْ منْذُ آمادِ",22,"د",1,0],["يا محلاَّ لخُلّتي وانتخائي","لم يُبح لي الخروجَ بابُ الرَّخاء",23,"ا",2,1],["يا محنة المحب قد اقلقه","كما تريد حسنك نفتان",24,"ن",1,0],["يا محيَ الكرم الكثير بمالهِ","بَلْ مُهلك الأعداء والإعدامِ",25,"م",1,0],["يا محييَ السيْبِ الكثيرِ بجودِه","بل يا مميتَ الفقرِ والإعدامِ",26,"م",1,0],["يا مُحرِزَ المَجدِ مَوروثاً وَمُبتَدَعاً","وَحائِزَ الفَضلِ مَولوداً وَمُكتَسَبا",27,"ب",2,0],["يا محلَّ الروحِ من جَسَدي","وحُسامي في العِدَا ويَدِي",28,"د",2,1],["يا محَلاًّ حلَّه الوح","شُ وأعطاه زِمامَه",29,"م",2,0],["يا محسنا بالزَمان ظنا","لم تدر ما يفعل الزَمان",30,"ن",1,0],["يا مُحييَ الدينِ وَالآدابِ لا جَرَتِ ال","أَفلاكُ إِلّا بِما تَهوى وَتَرضاهُ",31,"ا",2,0],["يا مُحيي الدينِ اِبقَ في سَعادَةٍ","ما سارَ في البِلادِ رَكبٌ وَقَفَل",32,"ل",1,0],["يا محسنَ الوصف إِن رمت النسيبَ فصِف","لنا محاسنَ هَذا الشادن الصَلِفِ",33,"ف",1,0],["يا مُحسِناً كُلَّنا نَرجو سَماحَتُهُ","يا خَيرَ مَن يَمَّمَ العافونَ ساحَتَهُ",34,"ه",1,0],["يا مُحسناً بيَدِ النّدى بين الورى","تَقليد جيدِ الهمّةِ العَلياء",35,"ا",2,0],["يا محمد إذا شيت الهنا والمبره","والسلامة وتكفي من جميع المضره",36,"ر",2,1],["يا محمد لقينا الخير كله في الخير","والهنا والسرور في الخير لا غير لا غير",37,"ر",1,1],["يا محبّ النجاةِ أَصغِ لقولي","تلقَ خيراً وتنجُ من كل مَقتِ",38,"ت",1,1],["يا مُحِلاًّ في الهوى منِّي دماً","سيف عينيه وما كانَ حلالا",39,"ل",2,0],["يا محلاوي ترفق بصبّ","قد يراه لما نابت الغرام",40,"م",1,0],["يا محلّا دمي ترفّق بصب","بعض هذا الصدد وغاير مطيق",41,"ق",1,0],["يا محسناً لمسيء جاء معتذراً","يا مالك العبد آب العبد مذ أبقا",42,"ق",2,0],["يا محسناً بمسيء جاء معتذراً","وطالب الخير لما صار مملوقا",43,"ق",2,0],["يا مُحرقاً قلبه قربانَ أمته","هَون عليكَ ورفقاً بالمجانينِ",44,"ن",1,0],["يا محرز الفخر عن سعي وعن نسب","وفاعل الخير في سِرٍّ وفي عَلَنِ",45,"ن",1,0],["يا محباً من النجوم الزبانا","ومن الأرض زبرة الحداد",46,"د",1,1],["يا محلّاً أَبْلَتْه هوجُ اللّيالي","وَغَرامي بِساكنيهِ قَشيبُ",47,"ب",1,0],["يا محباً أحب ثوب حبيبٍ","أعط نفس الحبيب بعض التفاتِكْ",48,"ك",1,0],["يا مُحيَّاهُ أنارَ ال","لَهُ في العَالمِ بَدْرَكْ",49,"ك",1,0]]}