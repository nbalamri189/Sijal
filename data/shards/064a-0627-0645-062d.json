51619",""],[4899,"الوصايا","https://www.poetsgate.com/ViewPoem.aspx?id=177222",""],[5005,"هوّن عليك..","https://www.poetsgate.com/ViewPoem.aspx?id=204897",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5064,"محاولات تيه متشرّد","https://www.poetsgate.com/ViewPoem.aspx?id=199152",""],[5136,"يا محرقاً لكتابه","https://www.poetsgate.com/ViewPoem.aspx?id=121516",""],[5136,"يا من هو كل ساعة في شأن","https://www.poetsgate.com/ViewPoem.aspx?id=121730",""],[5145,"يا أكرم الناس لا مستثنياً أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=108251",""],[5153,"تشطير أبيات (أخفي الهوى )لابن الفارض","https://www.poetsgate.com/ViewPoem.aspx?id=202452",""],[5463,"من قصيدة نوره","https://www.poetsgate.com/ViewPoem.aspx?id=26995",""],[5573,"نامت عيون الجاهل الي ماعرف درب الرواه","https://www.poetsgate.com/ViewPoem.aspx?id=205469",""],[5595,"وطن الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=157415",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[5628,"الى صاحب برج العذراء في ليلة زفافه","https://www.poetsgate.com/ViewPoem.aspx?id=178467",""],[5701,"يا محيطا أهدى إليّ بحورا","https://www.poetsgate.com/ViewPoem.aspx?id=164701",""],[402,"مهما تقل ثمالة الموجود","https://www.poetsgate.com/ViewPoem.aspx?id=35438",""],[402,"لبيكم يا رفقة النادي","https://www.poetsgate.com/ViewPoem.aspx?id=35474",""],[5830,"يا وهم مالي ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=201912",""],[5855,"وقف العذار على أوائل خده","https://www.poetsgate.com/ViewPoem.aspx?id=201487",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[5956,"يا مُحْدِثاً أقوى اختراق","https://www.poetsgate.com/ViewPoem.aspx?id=194556",""],[6031,"يا مُحْرقَ مُهْجتِي بِنَارِ الصَّدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=46314",""],[6115,"أفعالهم حقره وغيض ودناوي","https://www.poetsgate.com/ViewPoem.aspx?id=196473",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[520,"يا محبا من النجوم الزباني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577484",""],[5014,"تناقض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76216&r=&rc=12",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""]],"verses":[["يَا مَحَلاًّ لِخُلَّتِي وَانْتِخَائِي","لَمْ يُبِحْ لِي الْخُرُخجَ بَابُ الرَّخَاءِ",0,"ا",2,1],["يا مُحِبَّ الجِدالِ نَم مُستَريحاً","لَيسَ في المَوتِ مَنفَذٌ لِلجِدالِ",1,"ل",1,0],["يا مُحِلّي يَفاعَ حالٍ مَكانُ النَ","جمِ مَهما يُقَس إِلَيهِ حَضيضُ",2,"ض",1,0],["يَا مُحِبِّي مُحَمَّدٍ وَهُمُ صَفْ","وَةُ مِصْرَ التَقَتْ بِهَذَا المَقَامِ",3,"م",1,0],["يا مُحكَمِ بنُ طُفَيلٍ قَد أُتيحَ لَكُم","لِلَّهِ دَرُّ أَبيكُم حَيَّةُ الوادي",4,"ي",1,1],["يا محسن الظنّ هذا نحو أنعمه","بمفرد الفضل قد نادى مناديه",5,"ي",2,0],["يا محسناً إن أساءَ الزمانُ وإن","مزّق حال الفتى فمر فيه",6,"ف",3,1],["يا محيِيَ الشعر والسماح وقد","كانا جميعاً مُضَمَّنَي جدف",7,"ف",1,0],["يا محبَّ الجمالِ ليس جميلاً","بجميلٍ ألّا يريك جمالهْ",8,"ل",2,0],["يا مُحِيَ مُهجَتي وَيا مُتلِفَها","شَكوى كَلَفي عَساكَ أَن تَكشِفَها",9,"ه",2,1],["يامُحيِيَ مُهجَتي وَيا مُتلِفَها","شَكوى كَلَفي عَساكَ أَن تَكشِفَها",10,"ه",2,1],["يا محسناً للعينِ في إقباله","ما تنتهي العينانِ من إحسانِه",11,"ن",2,0],["يا مُحِبَّ الإِحسانِ في زَمَنٍ أَص","بَحَ فيهِ الإِحسانُ وَهوَ بَغيضُ",12,"ض",1,0],["يا مُحسِناً حَسَناً قَد صَالَ مَنظَرُهُ","عَلَى البُدُورش وَيُمنَاهُ عَلَى البِدَرِ",13,"ر",1,1],["يا مُحِلَّ السَقامِ بي","خُذ مِنَ الحُبِّ ما بَقي",14,"ق",2,0],["يا مَحَلّي عَلَيكَ مِنّي سَلامٌ","سَوفَ أَمضي وَيُنجِزُ المَوعودُ",15,"د",1,0],["يا مُحبِيَ مُهجَتي ويا مُتْلِفَهَا","شكوى كَلَفِي عَساكَ أن تَكْشِفَها",16,"ه",2,1],["يَا مُحْتَفِينَ بِفاضِلٍ قَمِنٍ","أَنْ توسِعُوهُ لِفَضْلِهِ شُكْرَا",17,"ر",2,0],["يَا مُحْيِياً فَنا وَمَيْتاً دُونَهُ","يَا لَيْتَ حَظَّكَ مِنْهُ كَانَ قَلِيلاَ",18,"ل",2,0],["يَا مُحْسِنونَ جَزَاكُمُ المَوْلى بَمَا","يَرْبُو عَلى مَسْعَاكُمُ المَحْمُودِ",19,"د",1,0],["يَا مَحْفِلاً هُوَ لِلفُؤَادِ مَسَرَّةٌ","فِي لَيْلَةٍ هِيَ قُرَّةٌ لِلنَّاظِرِ",20,"ر",1,0],["يَا مُحْرِزاً بِدُؤُوبِهِ وَبِجَدِّهِ","أَسْمَى مَكَانٍ لِلْمُجِدُّ الدََّائِبِ",21,"ب",1,0],["يَا محْتَفِينَ تفَضُّلاً بِأَخٍ","يَهْفُو إِلَيْكُمْ منْذُ آمادِ",22,"د",1,0],["يا محلاَّ لخُلّتي وانتخائي","لم يُبح لي الخروجَ بابُ الرَّخاء",23,"ا",2,1],["يا محنة المحب قد اقلقه","كما تريد حسنك نفتان",24,"ن",1,0],["يا محيَ الكرم الكثير بمالهِ","بَلْ مُهلك الأعداء والإعدامِ",25,"م",1,0],["يا محييَ السيْبِ الكثيرِ بجودِه","بل يا مميتَ الفقرِ والإعدامِ",26,"م",1,0],["يا مُحرِزَ المَجدِ مَوروثاً وَمُبتَدَعاً","وَحائِزَ الفَضلِ مَولوداً وَمُكتَسَبا",27,"ب",2,0],["يا محلَّ الروحِ من جَسَدي","وحُسامي في العِدَا ويَدِي",28,"د",2,1],["يا محَلاًّ حلَّه الوح","شُ وأعطاه زِمامَه",29,"م",2,0],["يا محسنا بالزَمان ظنا","لم تدر ما يفعل الزَمان",30,"ن",1,0],["يا مُحييَ الدينِ وَالآدابِ لا جَرَتِ ال","أَفلاكُ إِلّا بِما تَهوى وَتَرضاهُ",31,"ا",2,0],["يا مُحيي الدينِ اِبقَ في سَعادَةٍ","ما سارَ في البِلادِ رَكبٌ وَقَفَل",32,"ل",1,0],["يا محسنَ الوصف إِن رمت النسيبَ فصِف","لنا محاسنَ هَذا الشادن الصَلِفِ",33,"ف",1,0],["يا مُحسِناً كُلَّنا نَرجو سَماحَتُهُ","يا خَيرَ مَن يَمَّمَ العافونَ ساحَتَهُ",34,"ه",1,0],["يا مُحسناً بيَدِ النّدى بين الورى","تَقليد جيدِ الهمّةِ العَلياء",35,"ا",2,0],["يا محمد إذا شيت الهنا والمبره","والسلامة وتكفي من جميع المضره",36,"ر",2,1],["يا محمد لقينا الخير كله في الخير","والهنا والسرور في الخير لا غير لا غير",37,"ر",1,1],["يا محبّ النجاةِ أَصغِ لقولي","تلقَ خيراً وتنجُ من كل مَقتِ",38,"ت",1,1],["يا مُحِلاًّ في الهوى منِّي دماً","سيف عينيه وما كانَ حلالا",39,"ل",2,0],["يا محلاوي ترفق بصبّ","قد يراه لما نابت الغرام",40,"م",1,0],["يا محلّا دمي ترفّق بصب","بعض هذا الصدد وغاير مطيق",41,"ق",1,0],["يا محسناً لمسيء جاء معتذراً","يا مالك العبد آب العبد مذ أبقا",42,"ق",2,0],["يا محسناً بمسيء جاء معتذراً","وطالب الخير لما صار مملوقا",43,"ق",2,0],["يا مُحرقاً قلبه قربانَ أمته","هَون عليكَ ورفقاً بالمجانينِ",44,"ن",1,0],["يا محرز الفخر عن سعي وعن نسب","وفاعل الخير في سِرٍّ وفي عَلَنِ",45,"ن",1,0],["يا محباً من النجوم الزبانا","ومن الأرض زبرة الحداد",46,"د",1,1],["يا محلّاً أَبْلَتْه هوجُ اللّيالي","وَغَرامي بِساكنيهِ قَشيبُ",47,"ب",1,0],["يا محباً أحب ثوب حبيبٍ","أعط نفس الحبيب بعض التفاتِكْ",48,"ك",1,0],["يا مُحيَّاهُ أنارَ ال","لَهُ في العَالمِ بَدْرَكْ",49,"ك",1,0],["يا مُحسناً جادَ على محسنٍ","بجودهِ والجودُ شأن الكِرام",50,"م",1,0],["يا محنة الدهر كفّي","إن لم تكفي فخفي",51,"ف",2,1],["يا محرقاً قلبي بنار صدورهم","رفقاً، ففيه نار شوق تضرم",52,"م",1,0],["يا مُحيي ذكرِ الإِسكندرْ","في الكَون بِتَنظيم العَسكَرْ",53,"ر",1,0],["يا محلَّ العُلَى وقُطْبَ السَّعادَهْ","قابلَ الله عِزَّكمْ بالزِّيَادَهْ",54,"د",2,1],["يا محييَ العيدين في ال","قطرين دمت لكل عام",55,"م",1,0],["يا مُحرجي بالقولُ واللَهِ الذي","خَضَعت لعزَّتهِ جباهُ السُّجَّدِ",56,"د",1,0],["يا محتد المجد الذي","ما فض منتقض ختامه",57,"م",2,0],["يا مِحنةَ العشاق هلا عطفةٌ","أو زوْرةٌ تقضي لنا بتلاق",58,"ق",1,0],["يا محرزاً جمل الحمد الجزيل له","وجائزاً من صفات المجد أجملها",59,"ل",3,0],["يا محيي الأنصار مهلا فقد","أنطقت بالإحسان حسانا",60,"ن",2,0],["يا محسنا لم يقتصر","في مدحه حسانه",61,"ن",2,0],["يا محصي الأنفاس يا عالم","الأسرار يا باري البرا والنعام",62,"م",1,0],["يا محكم التصوير في ظلم الحشا","خلقا وخلقا من جليل أو ذميم",63,"م",1,0],["يا محيي الانسان ثم مميته","ومعيده من بعد ما يمسي رميم",63,"م",1,0],["يا محصي الأنفاس من أنس ومن","جن أو من ملك كريم أو بهيم",63,"م",1,0],["يا محصي الأنفاس مهما صعت","أو صويت في هيكل متململ",64,"ل",1,0],["يا محرقاً كبدي بجمرة فقدهِ","قل لي عليك الصبر كيف يكونُ",65,"ن",1,1],["يا محمد المكتوم روح النشايد","بك تقتبس وَمْضة ضيا من سجاياك",66,"ك",1,0],["يا مْحَوّلٍ صَحْرا الإِمارات واحات","لين اصبحت ترقص طرَب وَآحَلاها",67,"ا",3,0],["يا محرقاً بالنار وجه محبه","مهلاً فإن مدامعي تطفيه",68,"ه",1,1],["يا محيي الدين كم غادرت من كبد","حرى عليكَ وعين دمعها هطل",69,"ل",1,0],["يا محنةَ النَفس بمألوفها","من أجلها قد كان هذا الصراع",70,"ع",1,0],["يا مَحَلَّ المُلوكِ أَينَ ملوكٌ","ظافَرتهُم خِلالَكَ النعماءُ",71,"ا",2,1],["يا محتداً عرف الزمان سناءه","وعليه هذا الدهر جدُّ أمينِ",72,"ن",1,0],["يا محرم الحرمات يا مسعى الهدى","يا بيت يا عرفات يا شاطي منى",73,"ن",2,0],["يا محيطاً علماً بأعلى الثُّرَيّا","مثلما قد أحاط تحت ثراها",74,"ا",3,0],["يا مُحِبِّينَ لِلنَّبِى","أُترُكُوا الأَهلَ وَالودَاد",75,"د",1,0],["يا مُحسِناً عَمَّ الأنامَ نَوالَهُ","وَهُوَ الغَنِىُّ عَنِ الجَميعِ كما ذَكَر",76,"ر",1,0],["يا محرز العلياء من جحاجح","هم أطفؤوا ما شبَّ من نار الدول",77,"ل",1,0],["يا محرز العلياء بالسعي الذي","أحيا العلا بذلك الإحراز",78,"ز",1,0],["يا محبي عوج لا نجافي","وانتهل صافي مواريد",79,"د",1,0],["يا محب الخير لانساني","والرئيس اللي دوره",80,"ر",2,1],["يا محبّي ذاك لي رايس","فيك سهم الحبّ من يوره",81,"ر",2,0],["يا محييَ الإتقانِ بعد دروسه","ومحلّيَ الأذهان بالإيقانِ",82,"ن",1,0],["يا مُحْيِيَ الإِحيا لِيَهْنَكَ مَغنماً","عُمُرٌ بإحياء العلوم ختمتَه",83,"ت",2,0],["يا مِحنَةَ الإسلاَمِ والقرآنِ مِن","جَهلِ الصَّدِيقِ وبَغيِ ذِي طُغيَانِ",84,"ن",1,0],["يا محسِن أبغي منْك تَثْبِيت","مِ الدار هذي وين هو راح",85,"ح",1,0],["يا محيي الدين الحنيف تلافه","فالدين أوشك أن يموت بدائه",86,"ا",3,0],["يا مُحرزاً أسرارَ طَاها المُصطفى","بأسرها وللضلال مُدحِضا",87,"ض",2,0],["يا محسناً لَم أَعب دهراً أَراك بِهِ","فَإنَّ حسنك قَد غطَّى مساويه",88,"ي",2,0],["يا محييَ الشعب من عُدمٍ ومن عَدمٍ","ومنقذَ الشعب من ضيق ومن كُربِ",89,"ب",1,0],["يا محجل القمرين في أفقيهما","ما نال عشر جمالك القمران",90,"ن",1,0],["يا محترساً لحذره لا يذر","من مامنه سلمت يؤتي الحذر",91,"ر",1,1],["يا محرقين بنيران الجوى كبدي","ما غير الهجر قلبي بعد هجرته",92,"ت",2,0],["يا محرزاً قصب العوالي","الصم بالقصب المجوف",93,"ف",1,0],["يا محنة أكل الشقاء شبيبتي","فيها ومزّقت الخطوب جناحي",94,"ح",2,0],["يا محنة الأدب الرفيع بمعشر","جعلوا السفاهة آية الإفصاح",94,"ح",1,0],["يا محنةٌ أكل الشقاء شبيبتي","فيها وهجّنت الخطوب عريقي",95,"ق",2,0],["يا محنة ال