{"poems":[[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[90,"أسمعي لي قبل الرحيل كلاما","https://www.aldiwan.net/poem44407.html","الخفيف"],[90,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[93,"أي خطب دها فبات المهجر","https://www.aldiwan.net/poem8965.html","عموديه"],[68,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[46,"قد قصرنا دونك الألحا","https://www.aldiwan.net/poem30280.html","مجزوء الرمل"],[46,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[89,"حيَّ مغنى الهوى بوادي الشآمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23779&r=&rc=41",""],[119,"مرض الطرف زاد لي أمراضي","https://www.aldiwan.net/poem41656.html","الخفيف"],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[132,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[190,"يا بعيد المزار أنت قريب","https://www.aldiwan.net/poem43895.html","الخفيف"],[214,"راح يرنو مرنح الاعطاف","https://www.aldiwan.net/poem13327.html","الخفيف"],[240,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[314,"كلما زيد صاحب المال مالا","https://www.aldiwan.net/poem50253.html","الخفيف"],[366,"سيدي بالذي أمدك بالحسن","https://www.aldiwan.net/poem68074.html","الخفيف"],[369,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[376,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[398,"كلما زدت عتابا","https://www.aldiwan.net/poem53601.html","مجزوء الرمل"],[406,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[408,"أأطيع العذول في السلوان","https://www.aldiwan.net/poem46429.html","الخفيف"],[422,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[422,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[422,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[473,"يا شريف الأغراس والأغراق","https://www.aldiwan.net/poem59811.html","الخفيف"],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122580","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64315","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38336","الرمل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203746",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79873","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48980","الخفيف"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96188","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60927","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87813","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201769","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201742","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204500","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204591","الخفيف"],[3033,"","https://poetry.dctabudhabi.ae/diwan/poem/146113","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74051","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205948","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135352","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95375","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76495","الرمل"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143815","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105527","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73088","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72356","الخفيف"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4702,"كلما زاد عمرك يابن آدم نقص","https://www.poetsgate.com/ViewPoem.aspx?id=154552",""],[4755,"تُومْ وجيري","https://www.poetsgate.com/ViewPoem.aspx?id=184084",""],[4782,"طال صبري","https://www.poetsgate.com/ViewPoem.aspx?id=201306",""],[4797,"بكرتي ماهي تروح فالغبار","https://www.poetsgate.com/ViewPoem.aspx?id=178131",""],[4830,"آيةُ التبليغ","https://www.poetsgate.com/ViewPoem.aspx?id=206138",""],[4987,"ويش استفيد","https://www.poetsgate.com/ViewPoem.aspx?id=49581",""],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5370,"الهموم الكثيرة","https://www.poetsgate.com/ViewPoem.aspx?id=85524",""],[5376,"لا تسلْ عني فأنِّي عاشقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197711",""],[5410,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=144511",""],[5410,"والتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=152249",""],[5461,"يوم انا طالب","https://www.poetsgate.com/ViewPoem.aspx?id=5237",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[5704,"طلع البدر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=202941",""],[5848,"آل ثاني والدوحه وحبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53199",""],[5957,"ما الذي يأخذني مني إليك","https://www.poetsgate.com/ViewPoem.aspx?id=208812",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6102,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=182847",""],[6142,"جاء في مثل ما به جاءت الر","https://www.poetsgate.com/ViewPoem.aspx?id=155702",""],[6184,"أعيدي اسمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78615&r=&rc=7",""],[6336,"الدوحة الباكية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73554&r=&rc=15",""]],"verses":[["كُلَّما زيدَ غُمَّةً زادَ صَبراً","ضَرَمُ الزِندِ كُلَّما لُزَّ أورى",0,"ر",2,0],["كُلَّما زادَ عُلُوّاً فَرعُها","زادَ مَسراها قَراراً وَوَطَد",1,"د",1,0],["كلما زاد عاذلي فيك عذلاً","زدت في حسنك البديع هياما",2,"م",2,0],["كلما زدت أنت نصراً لدين الل","ه بالحق زادك اللّه نصرا",3,"ر",2,0],["كُلَّما زادَ فَركُهُ يَتَأَرَّج","وَكَنَجمٍ في بُرجِهِ يَتَوَهَّج",4,"ج",1,0],["كُلَّما زادَتِ البَصائِرُ نَقصاً","خَطَبوها بِوافِدِ الأَثمانِ",5,"ن",1,0],["كُلَّما زِدناكَ لَحظاً","زِدتَنا حُسناً وَطيبا",6,"ب",2,0],["كُلَّما زُرتُهُ وَجَدتُ لَدَيهِ","نَسَباً ظاعِناً وَمَجداً مُقيما",7,"م",2,0],["كُلَّمَا زَحْزَحَتْ بَنَانَةُ فِكْريَ","عَنْهُ سِتْرَ الْخَيَالِ لاح أَمَامِي",8,"م",2,0],["كَلَّمَا زِيدَ رُتْبَةً أَوْ وِسَاماً","لَمْ تُفْرِّحُهُ رتبة أَوْ وِسَامُ",9,"م",1,0],["كُلَّما زِيدَ نَدىً أَعْط","تْ مَجَانِيَةُ مَزِيدا",10,"د",2,0],["كُلَّمَا زَحزَحَتْ بَنَانَة ُ فِكْرِي","عنهُ سترَ الخيالِ لاخ أمامي",11,"م",2,0],["كلما زدته خضوعاً تعالى","ورماني بعضب طرف ماضي",12,"ض",2,0],["كلّما زدتُ ذلَّةً وخضوعا","رادَ تيها علىّ في خيُلائِه",13,"ا",3,0],["كلما زادَ جفوةً زدتُ حبّاً","هكذا فعل من يعزُّ اقتدارُه",14,"ر",2,0],["كُلَّما زادَ عَذلُهُ زادَ وَجدي","وَكِلانا في شَأنِهِ قَد تَمادى",15,"د",2,0],["كلما زدت بالتباعد حبي","ك أعاد البعاد حبّا جديدا",16,"د",2,0],["كلما زدت رقة في هواه","زادني من صدوده والتجافي",17,"ف",2,0],["كُلَّما زادَ جَفاءً","زادَ مِن قَلبي حُظوَه",18,"و",2,0],["كُلَّما زيدَ صاحِبُ المالِ مالاً","زيدَ في هَمِّهِ وَفي الإِشتِغالِ",19,"ل",1,1],["كُلَّما زادَ عاشِقوكَ اِنمِحاقا","زِدت يا بَدر في العُيون كَمالا",20,"ل",2,0],["كُلّما زُرتُها تَخالُ خَيالاً","زار منّي فَتَكْسِرُ الطَّرْفَ ظَرفا",21,"ف",2,0],["كلّما زادَ سِر وجْدي ظُهوراً","لابنةِ العامريِّ زادَتْ جُحودا",22,"د",2,0],["كُلَّما زُرتُه وجدتُ المَعالي","شيدَ مِنها بَيتٌ ومُدَّ رِواقُ",23,"ق",1,0],["كُلَّما زِدتَ عتاباً","زدتُ في هَجوِكَ بَيتا",24,"ت",2,1],["كلما زدت صدودا وابتعادا","زاد قلبي لك شوقا وامتثالا",25,"ل",2,0],["كلّما زاد عنْ وصالي بُعداً","زِدْتُ فيهِ بُعداً عنِ السّلوانِ",26,"ن",1,0],["كلَّما زادَ وميضاً برقه","زادني من لوعة الوجد اشتعالا",27,"ل",2,0],["كلَّما زادَ وقاراً زدته","مِدَحاً تُتلى مدى الدهر وتنشد",28,"د",1,0],["كلما زدت بالعلوم اطّلاعاً","زادك الله رفعة ووقارا",29,"ر",2,0],["كُلَّما زَفَّها الغُلامُ جَلاها","في ثِيابٍ مِنَ الرُقاقِ رِقاقِ",30,"ق",1,0],["كلّما زِدتُهُمُ من جميلٍ","زدتُهمْ مَقْلِيَةً وشِقاقا",31,"ق",2,0],["كُلَّما زادَ رَغبَةٌ في اكتِساب ال","حَمدِ بالمالش زادَ بالمالِ زُهدا",32,"د",2,0],["كُلَّما زُرتِ زورةً في خَفاءٍ","وأَرى البَدرَ لا يكونُ خَفِيَّا",33,"ي",2,0],["كُلّما زادَ النّوى","في فُؤادي توقدُ",34,"د",1,0],["كلّما زادت عطاء","كلما ازددتُ ظما",35,"م",2,0],["كلّما زدتَ فى ملامى وعَذلى","زِدتَ فى لوعتى وفى بَلبالى",36,"ل",2,0],["كلَّما زرَّ نورُها الغضّ جيباً","عنه حلَّت يد الصَبا الأزرارا",37,"ر",2,0],["كلَّما زادكَ المحبُّ اقترابا","زدتَ عنه تباعداً واجتنابا",38,"ب",2,1],["كلما زِيدَ كربةً زاد عَزماً","فكأن الأسى لديه شَمُول",39,"ل",1,0],["كلما زادوا عذابا","زادهم صبرا عجيبا",40,"ب",2,0],["كلما زرته تهلّلَ بِشْراً","كلما عدتُ عادَ لي منه جودُ",41,"د",1,0],["كُلَّما زادَ بُعاداً","زادَهُ البُعد هِياما",42,"م",2,0],["كلما زاد للأنام اقترابي","زاد عنهم تباعدي واغترابي",43,"ب",2,1],["كلمّا زادني الحبيب صدوداً","لم أعاتبه بل أعاتب قلبي",44,"ب",2,0],["كلما زاد ظلمةً زدت نوراً","فلنوري بقلب دهري رماح",45,"ح",1,0],["كلما زادني الزمان عذابا","زاد في متعتي فعاد بنكس",46,"س",1,0],["كلما زيد غذاءً","زاده شراً غذاؤه",47,"ه",1,0],["كُلَّما زِدتَني ملاماً تَراني","زاد وَجدي وَلَوعَتي وَغَرامي",48,"م",2,0],["كُلُّ مازِنٍ","طوعه خُطم",49,"م",1,0],["كُلَّما زاده الطَبيب عِلاجاً","زادَه طبّه ضنىً واِعتِلالا",50,"ل",2,0],["كلما زاد بالمواسم عدًّا","خلته قل بالحياة وصحَّا",51,"ح",2,0],["كلّما زدت زاد ردفاً فردفا","وارتدافاً يتلوه منه رديفُ",52,"ف",1,0],["كلما زادك الاله جلالا","ردت جودا على الورى ونوالا",53,"ل",2,1],["كلما زدناه نصحا لامنا","او افقناه تغطي ورقد",54,"د",1,0],["كلما زدت رعيه","زادني من سواده",55,"د",2,0],["كلما زجها يجذب ودفع","مارج في فؤادها من نار",56,"ر",1,0],["كلما زلفت خبت أججتها","بوقود من فاحم الأحجار",56,"ر",1,0],["كُلمَّا زادَ في المعالي عُلُوّاً","زادَ كيوانٌ مِن عُلاهُ استِفالا",57,"ل",2,0],["كلما زرتها أقول لعيني","هذه كعبة الجلال فطوفي",58,"ف",2,0],["كلما زادت في النشيد دعاءً","رددت صوتها الربى والوهادُ",59,"د",1,0],["كلما زاد عمرك يابْن آدم نقص","لا تغرك حياتك دامها سالمه",60,"م",2,0],["كُلَّما زِدْتُمْ ثَأَرْنا","مِن \"زَبيدٍ\" أو \"خَدِيرِ\"",61,"ر",1,0],["كلما زاد احتمالي سامَهُ","رازئٌ يُحيي بجنبيَّ العنا",62,"ن",2,0],["كل مازاحو من الدرب الستار","رحت اساقط واتعدى الاولين",63,"ن",1,0],["كلّما زادَ عُتاتُ القومِ بُغضاً","زادَ حُبُّ المرتضى شيئا فشيّا",64,"ي",2,0],["كل مازاد تعذيبك ذنوبك تزيد","الله اعلم صلاتك باطله كلها",65,"ل",3,0],["كلما زادني الغرام ولوعا","فهو يزداد منعة ومطالا",66,"ل",2,0],["كل ما زاد همي... شان حالي ونِقَصت","والهموم الكثيرة تبري حالي بَرِي",67,"ر",2,1],["كلما زدْتِ بعاداً في النوى","زادني الوجدانُ جأشاً وتنامى",68,"م",2,0],["كلما زاده الزمان صموداً","هاجم الشوكُ سفحَهُ والقرارا",69,"ر",2,0],["كلما زادها الجناحُ علوّاً","شدها الشوقُ للإياب المُلاقي",70,"ق",2,0],["كلما زادنا الرحيل ابتعاداً","ضمنا الشوق في رباط الوفاق ِ",70,"ق",1,0],["كلما زادنا الرباط وثوقاً","أطلق الحبُّ روحَنا في انعتاقِ",70,"ق",1,0],["كلما زادت مواجيعي صبرت","بين ثلج وبين جمرات الغضاه",71,"ا",2,0],["كُلَّما زدْنا صُموداً كُلَّما","كَشَّرَ المُحْتَلُّ عَنْ أنْيابِهِ !",72,"ب",2,0],["كلما زدت اقترابا","نحوكم يا خيرَ راعْ",73,"ع",1,0],["كل ما زالت جروحه قلت : ما زالت جروحه","تستثير الدمع وتغلّف بالاحزان الثواني",74,"ن",2,0],["كلما زارت فؤادي فرحة ٌ","شغف القلب تحرى ناظريك",75,"ك",1,0],["كلَما زاد حنيني","قلّ عمري منه خُمْسا",76,"س",2,0],["كُلَّما زِدتِ فِي عِناقِيَ تَلقِي","فَوقَ خَدَّيكِ قُبلَتِي تَتَقَلَّبْ",77,"ب",1,0],["كلما زدت وجهه نظرة زا","دك حسناً سبحانه من مزيد",78,"د",1,0],["كلّما زادت تباريح الجوى","زدت ِ بُعداً عن جراحاتي الطريّهْ",79,"ي",2,0],["كلما زاد انطلاقاً في الفضا","زاده الجذرُ التصاقاً بالحجر",80,"ر",1,0]]}