{"poems":[[55,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[57,"أيا غزال الذهب","https://www.aldiwan.net/poem26521.html","مجزوء الرجز"],[49,"أيا قلبي أما تخشع","https://www.aldiwan.net/poem25231.html","الهزج"],[49,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[53,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[80,"يا صفوتي من البشر","https://www.aldiwan.net/poem13980.html","مجزوء الرجز"],[51,"أيا غمي لغمك يا خليلي","https://www.aldiwan.net/poem64302.html","الوافر"],[101,"معها .. في باريس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68729&r=&rc=281",""],[133,"وقفت وقد ضاق بي","https://www.aldiwan.net/poem67448.html","مجزوء الكامل"],[136,"واسكب مدمع العينين وأذر","https://www.aldiwan.net/poem54820.html","الوافر"],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[154,"أأسلوا وقد غبت عن ناظري","https://www.aldiwan.net/poem68478.html","المتقارب"],[208,"أيا غصنا من تحت بدر على نقا","https://www.aldiwan.net/poem53262.html","الطويل"],[266,"أيا غاديا والدهر يغذي بلحمه","https://www.aldiwan.net/poem38236.html","الطويل"],[285,"عسى باخل بلقاء يجود","https://www.aldiwan.net/poem60553.html","المتقارب"],[287,"أيا غائبا من بعده الأنس ما حضر","https://www.aldiwan.net/poem32780.html","الطويل"],[321,"إذا ما علا في الصدر والنهى والأمر","https://www.aldiwan.net/poem69440.html","الطويل"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[369,"أيا غائب الشخص عن ناظري","https://www.aldiwan.net/poem60904.html","المتقارب"],[371,"وإني لأدنى ما أكون أمانيا","https://www.aldiwan.net/poem17061.html","الطويل"],[371,"وإن أمرا أنفاسه نحو قبره","https://www.aldiwan.net/poem17761.html","الطويل"],[415,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[567,"لانطون المدور لوح رمس","https://www.aldiwan.net/poem52683.html","الرمل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110388","الوافر"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110438","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39012","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59672","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62547","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59399","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96628","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136277","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136294","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124311",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115932","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115844","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74995","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123094","الطويل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126378","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103758","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202870","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65494","الوافر"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216351","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130376","الطويل"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143946","المتقارب"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121405","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89025","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89438","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91439","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135752","الرجز"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111044","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94557","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94387","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104883","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139575",""],[4691,"بشعر الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=216026",""],[4984,"سهام الشروق","https://www.poetsgate.com/ViewPoem.aspx?id=175750",""],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5690,"غريبٌ فقده أبكى","https://www.poetsgate.com/ViewPoem.aspx?id=172278",""],[5781,"نورُكَ شمسٌ آفِلة","https://www.poetsgate.com/ViewPoem.aspx?id=202849",""],[5956,"وأسعى إلى الغمض عنك وأعيا","https://www.poetsgate.com/ViewPoem.aspx?id=194597",""],[6066,"مَأْسَاتِيْ فِيْ جُوَانْتَانَامُو","https://www.poetsgate.com/ViewPoem.aspx?id=12669",""]],"verses":[["أَيا غِياثَ الخَلقِ إِن أَجدَبوا","وَيا قِوامَ الدينِ إِن قُوِّضا",0,"ض",2,0],["أَيا غُدوَةً ساءَ الحُسَينَ صَباحُها","وَسَرَّ العِدى فيها الزَمانُ المُعانِدُ",1,"د",1,0],["أَيا غَزالَ الذَهَبِ","تَرَكتَني في تَعَبِ",2,"ب",1,1],["أَيا غَوَثاهُ بِاللا","هِ هَذا الأَمرُ ما أَفظَع",3,"ع",1,0],["أَيا غَفلَتا كَيفَ لا","أُرَجّي الَّذي أَحذَرُ",4,"ر",1,0],["أيا غُرَّة العلْيَا ويا عينَها اليمنى","ويا صفوة الدنيا ويا حاصل المَعْنَى",5,"ن",2,1],["أيا غلطاً في الخلقِ لا من إلهه","ولكن من الدهر الذي رُبَّما غَلِط",6,"ط",1,0],["أَيا غُصنا إِذا مَشى","يا رَشأ إِذا نَظَرْ",7,"ر",1,0],["أَيا غَمّي لِغَمِّكَ يا خَليلي","وَيا وَيلي عَلَيكَ وَيا عَويلي",8,"ل",2,1],["أيا غَمَامةَ مُوسيقى .. تُظلِّلُني","كذا يُنَقّطُ فوق الجنّةِ المطرُ",9,"ر",1,0],["أيا غافراً أَرحَما","يرى ذلَّ أمسي وَغَد",10,"د",1,0],["أيَا غَيثَ الضِّعَافِ ومَن نَدَاهُ","كمَوجِ البَحرِ بل بِالبَحرِ يُزرِى",11,"ر",2,0],["أيا غرابا قد نعقتَ بهِمُ","فكن على آثارهم بي ناعقا",12,"ق",2,0],["أيا غائباً حاضراً في الحشا","ويا واصلاً في حلى هاجر",13,"ر",1,0],["أيا غصناً من تحت بدرٍ على نقاً","على كثُبٍ قد انكَسف البَدرُ",14,"ر",1,1],["أيا غادياً والدهر يغذي بلحمه","أسير الأماني والمنية أسرع",15,"ع",1,1],["أَيا غُرْمَ ما أَتْلَفَتْ مُقْلَتاهُ","وَقَدْ يَحْمِلُ الثَّأْرَ مَنْ لا يُقِيدُ",16,"د",1,0],["أَيا غائِباً مِن بَعدِهِ الأُنسُ ما حَضَر","وَلا فارَقَت عَينايَ في ليلِيَ السَهَر",17,"ر",1,1],["أيا غرة الدهر ائتنف غرة الشهر","وقابل هلال الفطر في ليلة الفطر",18,"ر",1,0],["أيا غُرّةً بيضاءَ زانَ مكانَها","ولولاه كان النّاسُ جِلْدةَ أَدْهَم",19,"م",1,0],["أيا غائبَ الشّخصِ عن ناظري","على أنّ نعمتَهُ حاضِرَهْ",20,"ر",2,1],["أَيا غائِباً لَم أَحتَسِب بُعدَ دارِهِ","فَأَلبَسَ قَلباً لِلمَصائِبِ حامِلا",21,"ل",2,0],["أَيا غافِلاً يُسري بِهِ وَهوَ لا يَسري","وَيا جارِياً أَمسى إِلى أَمَدٍ يَجري",22,"ر",2,0],["أيا غائباً يدنيهِ شَوقي على النّوى","لأَنْتَ إلى قَلبي من الفِكْرِ أقربُ",23,"ب",1,1],["أيا غُصنَ النَّقا إنَّ المنايا","كما أرَّختُ قاصِفةُ الغُصونِ",24,"ن",1,0],["أَيا غصنَ النقا قصفتكَ ظلماً","يدٌ في لفتك ساعِدُها شديدُ",25,"د",1,0],["أَيا غصنَ بانٍ قد بَغَى البين كسرَهُ","ويا قمراً أخفَتهُ سحب النوائبِ",26,"ب",1,0],["أيا غَائِباً عن حَضرةِ القُدسِ قد نَبا","به الطَّبعُ أن يأْتي هُدىً أو يُواتِيا",27,"ي",2,0],["أيا غافلاً عني ولست بغافل","ويا قاطعاً حبلي بوصل عواذلي",28,"ل",2,1],["أيا غارس الفضل في أرضه","ويا صاحب الصَّافنات الجيادْ",29,"د",1,1],["أيَا غَوْثَ الفَقِيرِ أجِبْ فَإنّي","دَعَوتُكَ بافْتِقَارٍ يَا كَرِيمُ",30,"م",1,1],["أيا غافلا عما يراد به انتبه","وراجع إلى التقوى وبادر وسارع",31,"ع",1,0],["أَيا غاصباً كم قد سرت بي وهجّرت","ظهور المطايا في ظهورِ الصحاصحِ",32,"ح",1,0],["أيا غاديا عرج على الحي إن في","ثرى تربه مسك المحبة والفضل",33,"ل",1,0],["أيا غايبا اقصاه عن مشهد الغنا","عوايق قلب قد اضربه الخبل",34,"ل",1,0],["أيا غاوياً بعد النبي محمدٍ","فما إِن أرى عنك الغواية تنجلي",35,"ل",2,0],["أيا غائباً إلاَّ عن القلب والفِكرِ","ومَن لم أزل ما عِشتُ منهُ على ذُكرِ",36,"ر",1,1],["أيا غائباً شطَّت به غُربةُ النَّوى","وكان قريباً فانطوى سببُ القُربِ",37,"ب",1,1],["أَيا غرر الأزمان ما الصبر عنكم","وَمن غيركم من شاء يستعمل الضرا",38,"ر",2,0],["أيا غافلاً في اللهو يمرح ساهياً","أتحسب أن الموت يسهو ويغفل",39,"ل",1,1],["أيا غادراً خانت مواثيق عهده","لقد جُرتَ في حكم الغرام على الصب",40,"ب",1,1],["أيا غائباً لم يغب ذكرُه","ولا حال عن وده حائلُ",41,"ل",1,1],["أيا غصناً من الأزهار غضّاً","قطعتَ وعشتَ عندي كالغريب",42,"ب",1,1],["أيا غصنا لها زد في التثني","ويا ردفا ترفق بالخصير",43,"ر",1,0],["\"أيا غاية الآمال من أنت أنسه\"","فكل بلاء عنده يستطيبه",44,"ب",2,0],["أيا غربة الإسلام في قرن عاشر","ومن لغريب الدار من رحمائها",45,"ا",3,0],["أيا غائباً حاضراً في الفؤاد","سلام على الغائب الحاضر",46,"ر",1,0],["أيا غامصين المزايا الجليله","من المرتضى والسجايا الجميله",47,"ل",2,1],["أيا غصناً عليه طير قلبي","من الإشفاق خفاق الجناح",48,"ح",1,0],["أيا غاية الحسن التي تقصر النهى","وإن جمعت أنواع علم الهوى فيه",49,"ي",2,1],["أَيا غُصنَ بانٍ كلّما مادَ وَاِنثَنى","وَيا ظبي إِنس ناعسَ اللحظ ما رنا",50,"ن",2,1],["أيا غفورُ يا عفوُّ فاغفرا","ذنوبَنا واعفُ وعافِ واستُرا",51,"ر",2,0],["أيا غادياً يطوي الفلا بأمونة","إذا جئت من كالشمس شعت مناقبه",52,"ب",2,0],["أيا غائباً قد عاد فالعود أحمدٌ","قدومُك موكولٌ بِحَلِّ المشاكل",53,"ل",1,0],["أيا غاشما أغشى الغزالة في الضحى","غياهب برد أغربتها بِغُربةِ",54,"ه",1,0],["أيا غافلاً صحواً وذر حال غفلةِ","تنبَّه ودع ذا اللهو وارجع ليقظةِ",55,"ه",1,1],["أَيا غادِري لبنانَ عَوداً وَعايَنوا","نعيماً بهِ الأعيان لم تُلفِ عانيا",56,"ي",2,0],["أيا غزال المنحنى قدك فقد","جرت على العشاق في لحظ وقد",57,"د",1,1],["أيا غيثاً لكل علاً وفضلٍ","ملاذٌ جوده ولنا غياثُ",58,"ث",1,1],["أيا غيداء أحييت القوافي","وأصبح شاعرا من ليس يشعر",59,"ر",1,0],["أيا غزة المجد ركن التصدي","تحديتِ ما دبَّروا من خروق",60,"ق",1,0],["أيا غصنًا تلاقيني","بذي الأشْعارِ أعناقا",61,"ق",2,0],["أيا غصناً ذوى لكن","زهى في روضة الربِ",62,"ب",1,0],["أَيا غائِباً عَنَّا حنَانَيْكَ فَلْتَجُدْ","بِطَرْفَةِ عَيْنٍ فَالقُلوبُ بِها جَمْرُ",63,"ر",1,0],["أ يا غيمة في السماءِ تهل","على الأرضِ دُمت الهنيّا القويّا",64,"ي",2,0],["ايا غوانتانامو لست ارض عدالة","تخيب مساعيها ويسقط اسمها",65,"م",3,0]]}