{"poems":[[290,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[309,"يا بهجة الحسن هل أراك","https://www.aldiwan.net/poem16810.html","مخلع البسيط"],[376,"من أين جئت غراما","https://www.aldiwan.net/poem57516.html","المجتث"],[563,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63985","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26521","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121614","الرجز"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199175","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5376,"شام","https://www.poetsgate.com/ViewPoem.aspx?id=214184",""],[6070,"على نسماتِها غنى البَهاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188125",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""]],"verses":[["على أغصان زيتون","بشعب فائح الزهر",0,"ر",1,0],["على اغترابي على اكترابي","على اجتنابي في ذا الشراك",1,"ك",1,0],["على اغترابٍ وعُدمٍ","إرجع فما جاء وقتُك",2,"ك",1,0],["عَلِي أغا نزلنا في","حِماهُ ذلك الأكرمْ",3,"م",1,0],["علِّي أغيظُ اليومَ أربابَ الغنى","بغنىً لأربابِ الغنى غَيَّاظ",4,"ظ",1,0],["عَلى أَغَرَّ واضِحِ الحُجولِ","حَتّى إِذا أَصحَرَ لِلمَخذولِ",5,"ل",1,0],["على أغَرِّ أدْهَمٍ قد طلَعتْ","مِن وجهِه في ظُلْمةِ الليل ذُكَا",6,"ا",1,0],["عليٌّ أغات الينكجريّة الذي","توفي ثاني عيد فطر له غنم",7,"م",1,0],["عَلى أَغَمَمنُونَ قَد حَقَدا","وَعنَّا لَدى فُلكِهِ انفَردا",8,"د",2,0],["على أغصن الليمون غنّى خيالُهُ","فضاعت بأحلامي لديهِ المجامرُ",9,"ر",1,0],["على أغصانها آياتُ وجدٍ","يئن العشقَ فيها عندليبُ",10,"ب",1,0],["على أغصانِها الخضراءِ عمْرٌ","تغازلهُ المجرةُ والسّماءُ",11,"ا",2,0],["على أغرّ ، عوده صليد","إرقاله سيان والوخيد",12,"د",1,0]]}