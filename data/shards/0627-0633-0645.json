.net/poem13164.html","عموديه"],[529,"اسم الذي تيمني","https://www.aldiwan.net/poem37506.html","مجزوء الرجز"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[544,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[551,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[551,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[551,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[558,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[558,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[558,"أسماء ربي مزايا عقدها حلت","https://www.aldiwan.net/poem34698.html","المواليا"],[558,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[562,"أسما قرينة أسعد بن خلاط قد","https://www.aldiwan.net/poem52533.html","الكامل"],[562,"فعلت كما فعلت سلاف الساقي","https://www.aldiwan.net/poem52920.html","الكامل"],[575,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[575,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[575,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[586,"اسم حبيبي وما يعاني","https://www.aldiwan.net/poem17447.html","مخلع البسيط"],[586,"فرق بيني وبين مصطبري","https://www.aldiwan.net/poem17538.html","المنسرح"]],"verses":[["أَسمَحَتِ الدُنيا لَكُم وَأَعرَضَت","صَنائِعٌ لَم تُحسِنوا اِصطِناعَها",0,"ع",3,0],["أَسمَعَ الحادِيانِ وَاِستَعجَلَ الرَك","بُ زِماعاً إِلى المَنونِ وَنَفرا",1,"ر",2,0],["أَسَمعي ذُؤابَةَ هَذا الأَنامِ","دُعاءٌ يَجُرُّ عَلَيَّ الجِهارا",2,"ر",2,0],["أَسَمْراءُ عَهْدي بالخُطوبِ قَرِيبُ","وَعُودي بأَيْدي النَّائِباتِ صَلِيبُ",3,"ب",1,1],["أسَمْراءُ كَمْ منْ نَظْرَةٍ فُلَّ غَرْبُها","بوَطْفاءَ يَطْغى دَمْعُها المُتَحيِّرُ",4,"ر",1,0],["أسْمَعَها الرَّعْدُ بإرْزامِهِ","إهابَةَ الحادي وَراءَ اللِّقاحْ",5,"ح",1,0],["أَسَمِيَّ ذِي النُّورَيْن وَجْهُكَ فِي الْوَغَى","شمسُ الضُّحَى حَلَّت بِلَيْث عَرِينِ",6,"ن",1,1],["اسمع مقالة من لا يبتغي عوضاً","من ضيعة لا ولا جاه ولا مال",7,"ل",1,0],["أَسْمِعْهُ مَا يُرْضِيهِ مِنْ تَحْتِ الثَّرَى","وَاللهُ يُسْمِعُكَ الَّذِي يُرْضِيكَا",8,"ك",2,0],["أَسمَعتَهُم مِن نَسيبِ القَومِ فَاِنطَلَقَت","شُؤونُ كُلِّ شَجِيِّ القَلبِ وَلهانِ",9,"ن",1,0],["اِسمانِ وَاِسمٌ وَفِعلٌ","إِن شِئتَ مِن غَيرِ نُكرِ",10,"ر",1,0],["إِسمَع وَقاكَ إِلهي ما تُحاذِرُهُ","فَخَيرُ ما وَقِيَ الإِنسانُ ما حَذِرا",11,"ر",2,1],["أَسمى لِرِزقٍ في البِلادِ مُفَرَّقٍ","وَمِنَ البَلِيَّةِ أَن يَكونَ مُقتَرّا",12,"ر",2,0],["أَسَمِعْتَ حُسْنَ أَدَائِهِمْ","إِمَّا سُؤَالاً أَوْ جَوَابَا",13,"ب",2,0],["اسمع شكاتي فهي إن لم تفد","حالاً ففيها النفع مستقبلا",14,"ل",2,1],["أَسْمَرُ اللَّوْنِ يَعْتَرِيهِ شُحُوبٌ","قَدْ تُرَى فِيهِ صُهْبَةُ الضِّرْغَامِ",15,"م",1,0],["إِسْمَعْ مِنَ الغَيْبِ الَّذِي أَنَا قَائِلٌ","بِلِسَانِهِ لِلجَائِرِ المُتَنَعمِ",16,"م",1,0],["أسْمَى فِعَالِكَ آسِياً وَمُدَاوِياً","تَصْحِيحُ رَأْيِ الشَّرْقِ وَهْوَ سَقِيمُ",17,"م",1,0],["أَسمَرُ يَطرُدُ ما لاقى وَمُنعَقِدٌ","في الرَأسِ قَرنٌ جَديدٌ غَيرُ مَسمورِ",18,"ر",1,0],["أسمتهُمُ الملّة السمحاءُ تكرمةً","أنصارَها وبهم عزّتْ أواليها",19,"ي",3,0],["أسمعي لي قبل الرحيل كلاما","ودعيني أموت فيك غراما",20,"م",2,1],["أسماء ليس لنا سوى ألفاظها","أما معانيها فليست تعرف",21,"ف",1,0],["أسمعته فيك الثناءَ مخبراً","فانظر لمن سمعَ الأصمُّ ثناءَه",22,"ه",1,0],["اسم حبِّي فيه قد أمسى سمر","للحسنِ شمسٌ وهو للعقلِ قمر",23,"ر",1,1],["إسمٌ حروف المعالي فيه واضحة","وكلّ عالٍ سواكم حرف إدغام",24,"م",1,0],["أسمح منه بما حوته يده","في يومهِ والسحاب في عامه",25,"م",2,0],["إسمها مع فعلها مع وصفها","ليَ ريحانٌ وروحٌ ونعيم",26,"م",1,0],["اِسمٌ مَعَ الخَلقِ قَد تاهوا بِهِ وَلَهاً","لِيَعلَموا مِنهُ معنىً مِن مَعانيهِ",27,"ه",1,1],["اسمعي نوح الحزانى واطرب","وانظري دمع اليتامى وابسمي",28,"م",2,0],["أسماؤهنّ هجاؤهنّ ومن يقل","أفعى يُبِنْ لا شَكَّ عن صَمَّاءِ",29,"ا",2,0],["أسْمَعْت يا حَسنَ المكارم فاستمعْ","واكبِتْ عدوَّك أُسْمِعَتْ أنواحُه",30,"ح",2,0],["أَسمِيَّ مَنْ أمَرَ الإِلهُ بِذَبْحِهِ","حتَّى إذا أشْفَى نَهَى أنْ يُذْبَحَا",31,"ح",2,0],["أسمرُ ما شاب لونَه برص ال","جَصِّ ولامس جلدُهُ وضَرَه",32,"ر",2,0],["أسمحُ مني وقد وهبتُ له","مملكةً بعد حالِ كدَّاش",33,"ش",1,0],["أسمعتُ إنباضتي أبا حسن","والنصحُ لا شكَّ نُصحُ من مَحضا",34,"ض",2,0],["أسمعنيها سيدٌ ماجدٌ","يفوز بالمجد لدى القرعه",35,"ع",2,0],["أسمعتِنا سوءاً فأُسمعتِهِ","فاستمعي إن كنت سمّاعه",36,"ع",2,0],["أسمعتَهُ شكرَ الرعيَّةِ بعدما","جارَ الولاةُ فأسمعوه عويلا",37,"ل",2,0],["أسمحُ من تعلمونَ حاتِمُكُم","وإنما كان يمنح النَّعما",38,"م",2,0],["أَسمَعتُكُم يَومَ أَدعو في مُوَدَّأَةٍ","لَولاكُمُ شَعَّ لَحمي عِندَها وَدَمي",39,"م",2,0],["أَسمَعتُها وَصفَ الصَبابَةِ فَاِنثَنَت","وَكَأَنَّما وَطِئَ الحُفاةُ صُرودا",40,"د",2,0],["أَسمى الكَلامِ الشِعرُ إِلّا أَنَّهُ","أَسماهُ ما أَعيا الفَتى تَصويرُهُ",41,"ر",2,0],["إِسمَع فَهَذا وَتَرٌ نائِحٌ","وَاِنظُر فَهَذا خَشَبٌ مُستَهام",42,"م",1,0],["إِسمَع مَقالَةَ حَقٍّ","وَكُن بِحَقِّكَ عَوني",43,"ي",1,1],["أَسَمِعْتَ نَوْحَ العاشِقِ الوَلْهانِ","مَا بَيْنَ القُبُورْ",44,"ر",1,0],["اسمعوا من محمد شدوه","فهو امام في فنه ذو ابتكار",45,"ر",1,0],["اسمحي ان نتملى ضوءها","قبل ان نغمض منا الاعينا",46,"ن",2,0],["اسمى رجال العصر ان احصيتهم","هو مصطفى الوثابة المقدام",47,"م",1,0],["اسمع عزيز يا أخي","أنا وأنت لا نرث",48,"ث",1,0],["اسمع أخي عزيز أنتم أسرة","لم يبق من وجودها إلا شفا",49,"ا",1,0],["إسمع حديث جُناتها وصلاتها","هل كان فيها للديانة موضع",50,"ع",1,0],["اسمع فرب مفصل","لك لم يفدك كمجمل",51,"ل",1,0],["اسمعنا بارنج في صدّه","قولا غريب الشكل في حدّه",52,"د",2,1],["اِسمَع نَفائِسَ ما يَأتيكَ مِن حِكَمي","وَاِفهَمهُ فَهمَ لَبيبٍ ناقِدٍ واعي",53,"ي",1,1],["أَسِمُ العُصورَ بِحُسنِهِ وأَنا الَّذي","يَروي فَيَنتَظِمُ العُصورَ كَلامي",54,"م",2,0],["اِسمُ الجَلالَةِ في بَديعِ حُروفِهِ","أَلِفٌ هُنالِكَ وَاِسمُ طَهَ الباءُ",55,"ا",2,0],["أَسَماءُ النيلِ أَيضاً حَرَمٌ","مِن طَريقِ الهِندِ أَم جَوٌّ مُباح",56,"ح",1,0],["أَسَمِعتَ بِالحَكَمَينِ في ال","إِسلامِ يَومَ الجَندَلِ",57,"ل",1,0],["أَسمَعُ أَحياناً وَحيناً أَرى","مَدرَسَةً في كُلِّ حَيٍّ تُشاد",58,"د",1,0],["أَسمَعتِني وَدَوائي ما أَشَرتِ بِهِ","فَإِن غَفِلتُ فَدائي قِلَّةُ الفَهَمِ",59,"م",1,0],["اِسمَع لِغَضبانٍ تَثَبَّتَ ساعَةً","فَبَداكَ قَبلَ هِجائِهِ بِعِتابِهِ",60,"ب",2,0],["اِسمَع هُديتَ أَبا يَحيى مَقالَ أَخٍ","يُصفي لَكَ الوُدَّ في سِرٍّ وَإِجهارِ",61,"ر",1,1],["أَسَمِعتُ عاذِلَةً فَهَل طاوَعتُها","وَرَأَيتُ شانِئَةً فَهَل مِن باسِ",62,"س",1,0],["إِسمَعهُ مِن قَوّالِهِ تَزدَد بِهِ","عُجباً وَطيبُ الوَردِ في أَغصانِهِ",63,"ن",2,0],["إِسمَع مَديحِيَ في كَعبٍ وَما وَصَلَت","كَعبٌ فَثَمَّ مَديحٌ ما لَهُ ثَمَنُ",64,"ن",1,1],["اِسمَع ثَنائي فَإِنّي لَستُ مُمتَدِحاً","إِلّا اِمرَأً مِن يَدَيهِ الخَيرُ يُنتَظَرُ",65,"ر",1,1],["أَسَمِعْتُما أن الجِبالَ تُضامُ","وعَلِمْتُما مَنْ غَالَتِ الأيَّامُ",66,"م",1,1],["أَسَمِيَّ مُرهَفَةِ السُّيوفِ فَضَلْتَها","شِيَماً إذا جَدَّ القِراعُ وَخيما",67,"م",2,0],["إِسمَع فَقَد آذَنَكَ الصَوتُ","إِن لَم تُبادِر فَهُوَ الفَوتُ",68,"ت",1,1],["اِسمُ العَزيزِ ذَليلٌ عِندَ ميتَتِهِ","وَاِسمُ الجَديدِ بُعَيدَ الجِدَّةِ الخَلَقُ",69,"ق",1,0],["إِسمَع إِلى الأَحكامِ تَحمِ","لُها الرُواةُ إِلَيكَ عَنكا",70,"ك",2,1],["إِسمَع مُخاطَبَةَ الجَليسِ وَلا تَكُن","عَجِلاً بِنُطقِكَ قَبلَما تَتَفَهَّمُ",71,"م",1,1],["أَسمَرُ كَالرِمحِ لَهُ عامِلٌ","إِعمالُهُ حَطَّمَ سُمرَ الصِعاد",72,"د",1,0],["أَسمى المُلوكِ مُحَمَّدُ ال","مَجبولُ مِن كَرَمٍ وَجودِ",73,"د",1,0],["أسمعَ الرعدُ فيه صرخةَ حُزْنٍ","ملْءُ ليل الحزين فيه أَليلُ",74,"ل",1,0],["إِسمَع أَقامَت في دِيارِكَ نِعمَةٌ","خَضراءُ ناضِرَةٌ تَرُفُّ رَفيفا",75,"ف",2,0],["أُسَمّيها لِتُكتَمَ بِاِسمِ نُعمٍ","وَيُبدي القَلبُ عَن شَخصٍ حَبيبِ",76,"ب",1,0],["أَسَمِعْتُمْ صادحَ الأمسِ وما","قال في الخمرِ يُغنِّي الشَّارِبينْ",77,"ن",1,0],["أَسْمَعَتْ بلفورَ نجوى وعدِه","ترتمِي حُزناً وتمضي نَدَما",78,"م",2,0],["اسمعْ دُرَيْدُ فقد أهابَ محمدٌ","يحنو على النشءِ الضّعيفِ ويَحدِبُ",79,"ب",1,0],["اسمٌ سَمَا لَفظُهُ وازدَانَ مَعناهُ","حَلّاكِ رَبُّكِ بالحُسْنَى وحَلّاهُ",80,"ا",2,1],["أَسمَعُ ذا عَنكَ في مُخافَتَةٍ","لَيسَ 