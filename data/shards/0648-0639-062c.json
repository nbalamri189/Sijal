m2957.html","الكامل"],[573,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[584,"لما حدا بالأيمنين يسار","https://www.aldiwan.net/poem17510.html","الكامل"],[584,"وفقيه كالبدر زار بليل","https://www.aldiwan.net/poem17659.html","الخفيف"]],"verses":[["وَعَجَّلتُ النَوى لَمّا","فَشا اللَأواءُ وَالأَزلُ",0,"ل",1,0],["وَعَجاجَةٍ تَلقى السَماءَ بِمِثلِها","عِظَماً كَما مَدَّ الغَمامُ المُثقَلُ",1,"ل",1,0],["وَعَجاجٌ مُجَرِّرُ الذَيلِ تَخطو","هُ حَيارى نَواظِرُ الأَحداقِ",2,"ق",1,0],["وَعُج بِالحِمى عَيناً فَلَستَ بِرامِقٍ","طَوالَ اللَيالي ذَلِكَ العَلَمَ الفَردَ",3,"د",1,0],["وَعَجائِبٍ ما كُنَّ في فِكَري","وَغَرائِبٍ ما دُرنَ في خَلَدي",4,"د",2,0],["وَعَجيبٌ أَنّي قَلَيتُ بَني مَر","وانَ طُرّاً وَأَنَّني ما قَلَيتُك",5,"ك",1,0],["وَعُجنا العيسَ توسِعُنا حَنيناً","تُغَنّينا وَنوسِعُها بُكاءَ",6,"ا",2,0],["وعُجْمُ مَهاً ماعرَفْنَ الكلامَ","عَذارَى بُنيّاتُ أمٍّ وَلودْ",7,"د",1,0],["وَعَجِبتُ للدُنيا وَرَغبَةِ أَهلِها","وَالرِزقُ فيما بَينَهُم مَقسومُ",8,"م",1,0],["وَعَجَزتُ عَن شُكرِ الَّذينَ تَجَرَّدوا","لِلباقِياتِ وَصالِحِ الأَعمالِ",9,"ل",1,0],["وعجائب العلمِ التي من بحرها","ماس اليراع بطرسه إعجابا",10,"ب",2,0],["وعجت لأوطان الشآم فأشرقت","كأنكَ ما بينَ المنازلِ كوكب",11,"ب",1,0],["وعجّزت مدحي لُهاك التي","مدحتها بالعجز ثم اكتنيت",12,"ت",1,0],["وعجّل معلومي وما كنت واصلاً","إلى ربعه والشهر للشهر رابع",13,"ع",1,0],["وعجَّل لراجي بابه كلّ ساعة","مطالبه أو للشقيّ مهالكه",14,"ك",2,0],["وعجيبٌ تعجُّبٌ من نَداه","إن جرى لانقطاعنا وامتدادِهْ",15,"د",2,0],["وعجِّل الندّ وليكن عبقَ ال","نفحة يذكو وإن خبتْ ناره",16,"ر",2,0],["وعجيبٌ من الحوافلِ أن تج","مع بين التعجيلِ والإجزالِ",17,"ل",1,0],["وَعَجيبٌ أَن يُخلَقَ المَرءُ حُرّاً","ثُمَّ يَأبى لِنَفسِهِ الحُرِيَّه",18,"ي",2,0],["وَعَجيبٌ ما بُليتُ بِهِ","أَنا مَعذورٌ وَمَعذولُ",19,"ل",1,0],["وَعَجِيزَةٌ رَيَّا وسَاقٌ خَدلَة","بَيضَاءُ تُسكِتُ مَنطِقَ الخَلخَالِ",20,"ل",1,0],["وَعَجيبٌ لا يَأخُذُ السَيفُ مِنكُم","وَيَنالُ الطَوى وَيُعطى الأُوامُ",21,"م",1,0],["وَعَجيبٌ خُلِقتَ لِلحَربِ لَبثاً","وَسَجاياكَ كُلُّهُنَّ سَلامُ",21,"م",1,0],["وَعَجاجَةً تَرَكَ الحَديدُ سَوادَها","زِنجاً تَبَسَّمُ أَو قَذالاً شائِبا",22,"ب",2,0],["وَعَجِبتُ مِن أَرضٍ سَحابُ أَكُفِّهِم","مِن فَوقِها وَصُخورُها لا تورِقُ",23,"ق",1,0],["وَعَجِبتُ كُلَّ تَعَجُّبي مِن بُخلِهِ","وَالجودُ أَجمَعُ ساعَةٌ مِن رائِهِ",24,"ا",3,0],["وَعَجِبتُ لِاِبنِ المَزرُبانِ وَجَحدِهِ","إِيّايَ حُسنَ مَواقِفي وَمَشاهِدي",25,"د",2,0],["وَعَجيبٌ طَريفُ ذا الشَعرِ الأَب","يَضِ أَبدى خُلوقَةً مِن تَليدِه",26,"د",2,0],["وَعَجِبتُ لِلمَحدودِ يُحرَمُ ناصِباً","كَلِفاً وَلِلمَجدودِ يَغنَمُ قاعِدا",27,"د",2,0],["وَعَجَّلنَ قَتلَ النازِكِيِّ بِضَربَةٍ","أَرَتهُ المَنايا وَهيَ جِدَّ عِجالِ",28,"ل",1,0],["وَعَجيبٌ أَنَّ الغُيوثَ يُرَجّي","هِنَّ مَن لا يَرى مَكانَ الغُيومِ",29,"م",1,0],["وعَجِبتُ من وَسَخٍ على أطرافِه","لو أُعمِلَت فيه المباردُ ما انجلُى",30,"ل",2,0],["وَعَجِبتُ إِذ نَسي الحِمامَ وَلَيسَ مِن","دونِ الحِمامِ وَإِن تَأَخَّرَ مُنتَهى",31,"ا",1,0],["وَعَجِبتُ إِذ عِلَلُ الحُتوفِ كَثيرَةٌ","وَالناسُ عَن عِلَلِ الحُتوفِ نِيامُ",32,"م",1,0],["وَعَجِّل بِالتَفَضُّلِ أَو أَرِحنا","بِمَنعِكَ عَن عَناءِ الاِنتِظارِ",33,"ر",1,0],["وعجيبٌ إليكَ يمَّمتُ وجهي","إذ مللتُ الحياةَ والأحياءَ",34,"ا",2,0],["وعجيبٌ قد كنتَ لي حسدَ الحسّا","دِِ فيها وكنتَ أنت التمائم",35,"م",1,0],["وعجبتَ من خطّافِ عسجده الّتي","حامتْ لتبني في ذراه وكورا",36,"ر",2,0],["وَعَجاجَةٍ كَسحابَةٍ مُلْتَفّةٍ","فوْقَ الرُؤوسِ على بُروقِ بَواتِرِ",37,"ر",1,0],["وعُجْمُها أكثرُها","وعُرْبها أقلُّها",38,"ل",3,0],["وَعُجتَ عَلَيهِ عَوجَةَ الصَبِّ شاقَهُ","بَريقٌ تَراءى آخِرَ اللَيلِ يَلمَعُ",39,"ع",1,0],["وَعُجِ المَطِيَّ عَلى الوَدادِ وَحَيِّهِ","طَلَلاً عَلى حُكمِ الزَمانِ مُحيلا",40,"ل",2,0],["وَعُجتُ المَطايا حَيثُ هاجَ بِيَ الهَوى","فَحَيَّيتُ مابَينَ الكَثيبِ إِلى الحِمى",41,"م",2,0],["وَعَجِبتُ لِلشُّهداءِ حَولَ زَعيمهم","جَزَعَ الرَّدَى ونفوسُهم لم تجزعِ",42,"ع",1,0],["وعجيبٌ إذا بَدا الحقُّ طَلْقاً","أن تَضِلَّ العقولُ والأحلامُ",43,"م",1,0],["وَعَجيب مِن العَجائب أَن يَط","لب حُكماً وَدَهرَهُ مَحكوم",44,"م",1,0],["وعَجاجَةٌ شَقَّتْ سيوفُ الهِندِ من","أكمامِها فكأنّمَا هي خَيْعَل",45,"ل",1,0],["وَعُج بِنا نَصطَبِح صَفراءَ واقِدَةً","في حُمرَةِ النارِ أَو في رِقَّةِ الآلِ",46,"ل",1,0],["وَعُج إِلى النَرجِسِ عَن عوسَجٍ","وَالآسِ عَن شيحٍ وَقَيصومِ",47,"م",1,0],["وَعُج بِنا نَجتَلي مُخَدَّرَةً","نَسيمُها ريحُ عَنبَرٍ ضَرِمِ",48,"م",1,0],["وَعُج بِنا نَصطَبِح مُعَتَّقَةً","مِن كَفِّ ظَبيٍ يَسقيكَها فَطِنِ",49,"ن",1,0],["وعج بنا نعترض مخدّرةً","عذراءَ لم تُفترع ولم تُنكح",50,"ح",1,0],["وعَج عن نعتِ أروى أو لُبَيني","بعبدِ يشوع فاعدل عن أوارى",51,"ر",2,0],["وَعَجرَدٌ كانَ وَشّاءً وَكانَ لَهُ","عِلمُ المُباهي بِوَضعِ الوَشي وَالنيرِ",52,"ر",1,0],["وَعَجرَدٌ يَنزو عَلى أُمِّهِ","خِنزيرَةٌ يَرغِثُها راغِثُ",53,"ث",1,0],["وَعَجيبٌ نَكثُ الكَريمِ وَلِلنَفسِ","مَعادٌ وَلِلحَياةِ اِنقِضاءُ",54,"ا",2,0],["وَعَجيبٌ فَرَحُ النَفسِ إِذا","شاعَ في الأَرضِ ثَناها وَاِنتَشَر",55,"ر",1,0],["وعجيبٌ أمرُ حبٍّ لم يَهُن","هو لَو هانَ على نفسي لَهُنتِ",56,"ت",1,0],["وعجبتُ منك ومن إبائكَ في","أسرِ الجمالِ وربقةِ الحبِّ",57,"ب",1,0],["وعجيبٌ صُنْعُهم في زمنٍ","أبصر الأعمى به والمتعامي",58,"م",2,0],["وعجوزٌ بالصِّبا موعودةٌ","وبعمرِ الدهر موعودٌ صباها",59,"ا",3,0],["وعجِزَ الرأيُ وأعيا الحلمُ","وخُطبتْ بالمُرْهَفاتِ السِّلمُ",60,"م",1,0],["وعَجيبٌ أن يفرحَ النْاسُ في كَهْ","فِ اللَّيالي بِحُزْنِها المَشْبوبِ",61,"ب",1,0],["وَعجِيبٌ هَدِيرُ مَجْرَاكَ لَكِن","رُب مَجْدٍ تَرْتِيلُهُ بِهَدِيرِ",62,"ر",1,0],["وَعَجِيبٌ جَمْعُ المُهَيْمِنِ فِيهَا","عِزَّةَ الوَرْدِ وَاتِّضَاعَ الْبَنَفْسَجْ",63,"ج",1,0],["وَعَجِبْتُ لِلأَدَبِ الرَّفِيعِ تُجِيدُه","لَهْواً وَجِدُّ سِوَاكَ فِيهِ صَنائِعُ",64,"ع",1,0],["وعجيبٌ يزيدُ في كلِّ شهرٍ","ثمّ يُدْعَى برغم ذاك هِلالا",65,"ل",2,0],["وعجاف البغاث تدفعه","بالمخلب الغض والجناح القصير",66,"ر",1,0],["وعجم مهى ما عرفن الكلام","عذارى بنيات أم ولود",67,"د",1,0],["وعجوزٌ هنا لِكُمْ حسبُها من رحمةِ","الدهرِ أنْ ستفقِد إبْنا",68,"ن",2,0],["وعَجبِتُ ممن لستُ أبلغُ شأوَه","في الموبقات توغُّلاً وتعرُّضا",69,"ض",2,0],["وَعَجبتُ لابنِ المَرْزُبانِ وَجَحدِهِ","إيّايَ حُسنَ مَوَاقفي وَمَشاهِدِي",70,"د",2,0],["وعجِّلِ الندّ