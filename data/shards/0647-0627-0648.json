{"poems":[[79,"من طلب الود من سلاوي","https://www.aldiwan.net/poem35838.html","مخلع البسيط"],[48,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[48,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[347,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[354,"ما الحكم في الناس إلا","https://www.aldiwan.net/poem15886.html","المجتث"],[466,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[487,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131718",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199672","الكامل"],[5026,"أيقونة على شاشة الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213509",""],[5285,"وللتذكرِ مبتدا","https://www.poetsgate.com/ViewPoem.aspx?id=203188",""],[5956,"إخلاصه الجم يسقي حقل موهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=193723",""],[5957,"يا شجي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=53772",""],[6088,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=207606",""],[6102,"لا نامت أعين الجبناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=184861",""]],"verses":[["هاويَةٌ أمُّهُ وفِيها","أبوهُ منْ بعْدِ ذاكَ هاوِي",0,"ا",3,0],["هاوٍ إِلى وَهدٍ يُخالِفُهُ","راقي الهِضابِ كَأَنَّهُ وَبرُ",1,"ر",1,0],["هاوِيَةٌ نَفسُكَ ما ساءَها","فَلتَخشَ أَن تُلقى إِلى الهاوِيَه",2,"و",3,0],["هاويات فوق رأسي","نا كما تهوي علينا",3,"ن",2,0],["هاوٍ إِلى أَعوَجَ الخَطِّ","مِن ذُرىً مُستَقمَه",4,"م",2,0],["هاوي المكارم قالي كلِّ مَلأمَةٍ","فالمجدُ والعارُ موصولٌ ومصرومُ",5,"م",1,0],["ها واش من أهيل الحي يشتمني","من جيره قد غدوا في",6,"ي",1,0],["هاوٍ إِلى المَوتِ في الجَنوبِ لَدى","بَحرٌ وَلا كَالبِحارُ يَحتَضِرُ",7,"ر",1,0],["ها والسبب دين الاسلام فيه وقع تفريط","وملة الكفر قامت ما بقى إسلام",8,"م",1,0],["هاوكأنما الإسكندرية مكةٌ","والرفق والتوفيق زاد رفاقها",9,"ق",3,0],["ها وشيُ *خولةَ يا ابنَ العبدِ* تَنْسِجُه","هذي البِلادُ لتُحيي الرسْمَ والدِمَنا",10,"ن",2,0],["هاوٍ من العلياء تلقَفُهُ الحِدا","ناءٍ عن الأحبابِ يهواهُ الردى",11,"د",2,1],["هاوٍ لكل المؤمنين يعينهم","لكنه الشانىء العاتي على الفسُقِ",12,"ق",1,0],["ها وقد غبتَ فَذابت وردتي","واستحالَ الشعر أن يطربنا",13,"ن",2,0],["ها واسألا الأهل هل ما زال عنترة","حيّا وهل سيفه ما انفكّ مسلولا",14,"ل",2,0],["ها واسألا الضاد هل ما زال مؤتلقا","حرفا ومؤتلقا معنى ومدلولا",14,"ل",2,0],["ها واسألاني هل ما زلت ابن أبي","على مبادئه السمحاء مجبولا",14,"ل",2,0],["هَاؤُم بَنُو الأُمَّةِ العَظِيمَةِ قَد","سَارُوا لِمُستَنقَعٍ فَغاصَ بِنا",15,"ن",2,0]]}