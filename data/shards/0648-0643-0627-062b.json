{"poems":[[85,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[85,"لمن ذلك الملك الذي عز جانبه","https://www.poetsgate.com/ViewPoem.aspx?id=486",""],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[458,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[458,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[458,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"]],"verses":[["وَكاثَرَ في البَرِّ الحَصى مَن يَجوبُهُ","وَكاثَرَ مَوجَ البَحرِ راكِبُه",0,"ب",2,0],["وَكاثَرتُ أَوضاحَ النُجومِ عَلى السَرى","بِغُرٍّ كِرامٍ فَوقَ غُرٍّ كَرائِمِ",1,"م",1,0],["وَكاثَرَ في البَرِّ الحَصى مَن يَجوبُهُ","وَكاثَرَ مَوجَ في البَحرِ راكِبُه",2,"ب",2,0],["وكاثِروا كواكبَ الأفقِ به","مباهلين واستقِلُّوا الأُصُلا",3,"ل",2,0],["وكاثرني مجالسَه تجدني ال","تَمَام لما حوته من جمَالِ",4,"ل",1,0],["وكاثرتُ مُتعةَ لذّاته","فلم أر ذلك إلا متاعا",5,"ع",2,0],["وكاثرَ الناسَ بإحسانِهِ","فلم يحزْهُ عددُ الحاسبِ",6,"ب",1,0]]}