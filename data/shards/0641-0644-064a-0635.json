{"poems":[[53,"تأمل العيب عيب","https://www.aldiwan.net/poem8304.html","المجتث"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[53,"عسرت علينا دعوة السمك","https://www.aldiwan.net/poem65756.html","أحذ الكامل"],[53,"لما استقل بك الطريق إلى العدا","https://www.aldiwan.net/poem65767.html","الكامل"],[53,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[50,"شغلت خداشا عن مساعي مخلد","https://www.aldiwan.net/poem63244.html","الكامل"],[70,"ما بين معترك الأحداق والمهج","https://www.aldiwan.net/poem1488.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[147,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[215,"تفننت في اغتيابي عصبة عجزت","https://www.aldiwan.net/poem46300.html","البسيط"],[215,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[369,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[408,"نقضت بعد النوى عهدي وميثاقي","https://www.aldiwan.net/poem46540.html","البسيط"],[520,"يا باذلاً رزق الورى ومانعا","https://www.aldiwan.net/poem12169.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136155","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53229","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87749","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67985","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135108","الطويل"],[1901,"لا تعجبوا إن قلتُ بانتْ سعادْ","https://www.poetsgate.com/ViewPoem.aspx?id=160414",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""]],"verses":[["فليصفح الناسُ عنه","فطعنهم فيه غَيْبُ",0,"ب",1,0],["فَلْيصنع العَزْلُ والتَّأميرُ ما صنعا","فأنت ما عشْتَ والي إمْرَةِ الجُودِ",1,"د",1,0],["فليصطد الصيادُ حاجتنا","تصطدْ مودَّتنا بلا شركِ",2,"ك",1,0],["فلْيَصرِفِ الصَّفَّار عنك عِنانَهُ","وليترِك الغيَّ المبينَ مُتْرَّكا",3,"ك",2,0],["فليصلْ كفي الأميرُ بحبلٍ","عاصمٍ من حباله المجدولهْ",4,"ل",2,0],["فَلْيَصْبِرِ القومُ إنّ اللهَ مُظهِرُه","على الممالكِ والأديانِ والنِّحَلِ",5,"ل",1,0],["فَلَيُصبِحَنَّ مِنَ الدَراهِمِ مُفلِساً","وَلِيُمسِيَنَّ مِنَ النَدى صِفرَ اليَدِ",6,"د",1,0],["فلْيَصْنَع الرّكْبُ ما شاؤوا بأنفسهِم","هم أهلُ بدرٍ فلا يخشونَ من حرَجِ",7,"ج",1,0],["فليصخبِ البحرُ ولتئنّ به","رمالهُ وليثرثرِ الشجَرُ",8,"ر",1,0],["فَلْيَصْرِفِ اللَّوْمَ عَنِّي مَنْ بَرِمْتُ بِهِ","فَلَيْسَ لِلْقَلْبِ فِي غَيْرِ الْهَوَى شُغُلُ",9,"ل",1,0],["فَلْيَصُنِ اللهُ لَنَا مُهْجَتَهُ","فِي نِعَمةٍ إِلى مَدى طَوِيلِ",10,"ل",1,0],["فَليُصحِبوا لَكَ رَغبَةً أَو رَهبَةً","فَلَطالَما ضَرَّ الجَوادَ حِرانُهُ",11,"ن",2,0],["فليصنعوا مثل صنعى وهو في حلل","من البدائع قد صيغت من الذهب",12,"ب",1,0],["فليصنع الحسن ما يريدُ","إني له حاضرٌ عتيدُ",13,"د",1,0],["فَلي صَحائف بالوزار قَد ملئت","واخجلتي من كِتابي حينَ أَلقاه",14,"ا",2,0],["فَلْيصُمْ أمثالُه في نِعمةٍ","وعُلاَ تَبقَى بقاءَ الرّافدَين",15,"ن",1,0],["فلْيصْنَعِ الدّهر ما شاءتْ نوائبُهُ","فما عساني مِن بعد النوى لاقي",16,"ق",2,0],["فليصح من خمر الهوى مخامر","إن كان حلم عن سفاه رادعا",17,"ع",2,0],["فليصنعوا المعروف يذكره لهم","بعد الجلاء المعشر المتشائم",18,"م",1,0],["فليصغ أهل الحق من أهل النهى","للطايف ابدا لهن الواجد",19,"د",1,0],["فلي صبابات به يهيجها","مجتمع الأفياء والغصون",20,"ن",1,0],["فَليُصلحوا وُجهتهم قَبل أَن","يَدعوا إِلى الإِصلاح مِن وُجهتك",21,"ك",1,0],["فلي صحبة شَما وإن عَزَّ صاحبي","تلبَّسْتُها بُرْداً كما يلبس الخال",22,"ل",1,0],["فلي صيتة في الخافقين جسيمة","كفاني دعيت اليوم بالقمران",23,"ن",1,0],["فليصلح الله إذنْ بالَها","وليهنِ جفنيها لذيذُ الرقاد",24,"د",1,0],["فَلْيُصْغِ نَاظِمُهَا فالذَّنْبُ أَرْهَقَهُ","يَنْأى بلا وَطَنٍ لا الذَّنْبُ يُغْتَفَرُ",25,"ر",1,0],["فلى صحائفُ في الأوزارِ قدْ ملئتْ","واخجلتي منْ كتابيِ حينَ أقراهُ",26,"ا",2,0]]}