{"poems":[[73,"ما اسم إذا قطعوه كان أربعة","https://www.aldiwan.net/poem3870.html","البسيط"],[60,"فاطم يا بنت النبي أحمد","https://www.aldiwan.net/poem31081.html","الرجز"],[96,"تحيّة الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=15667",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63831","المنسرح"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113737","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117212","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33490","المجتث"],[4509,"","https://poetry.dctabudhabi.ae/diwan/poem/100517","الكامل"],[4830,"قاريء الكَفّ","https://www.poetsgate.com/ViewPoem.aspx?id=198916",""],[4858,"بأيّة حالٍ عُدْتَ يا عيدُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=33673",""],[5277,"شراعُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=190352",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5883,"اسامة","https://www.poetsgate.com/ViewPoem.aspx?id=17912",""],[5943,"أسيرُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=11280",""],[5957,"الحب يا خلّي اقدسهُ","https://www.poetsgate.com/ViewPoem.aspx?id=36267",""]],"verses":[["هذا اِسمُ ذي غُنُجٍ ما إِن يُفَسِّرُهُ","إِلّا اِمرُؤٌ بارِعٌ في العِلمِ وَالأَدَبِ",0,"ب",1,0],["هَذا أَسيرٌ جاءَ لَيسَ يَهتَدي","مُكَبَّلٌ في قَيدِهِ المُقَيِّدِ",1,"د",1,0],["هذا أسيرك يا مذاهب ملّه","عضّ القيود ، ألم يئن إفلاته ؟",2,"ت",2,0],["هذا أُسَيْدٌ فقفْ على غدْرِهْ","غَلَيِّمٌ قد أُصيب في دُبْرِهْ",3,"ر",2,1],["هذا أَسيلُ الخَدِّ أقنى الأنف أز","هى القَدِّ يحكيهِ القَضيبُ الأزهرُ",4,"ر",1,0],["هَذَا أسَاسُ الفِسقِ وَالحَرفُ الذِي","وَضَعُوا أسَاسُ الكُفرِ والهَذَيَانِ",5,"ن",1,0],["هَذا أَسير هَواك لَو أَطلقته","أَطلقت خير فَتى بحبّك مصفدِ",6,"د",1,0],["هذا أسير بعادكم أجفانه","تحكى بفيض الدمع سحب عهاد",7,"د",1,0],["هذا استراح وهذا","نالَ المنى فتملَّى",8,"ل",2,0],["هذا أسير هواك مذ خلق الهوى","والشاهدان مدامعي وسهادي",9,"د",2,0],["هذا استوفى من آماقي","والآخرُ قد يُخفي الأدهى",10,"ا",1,0],["هذا أسيرٌ، وقَيْدُ البَغْيِ يُؤْلِمهُ","وذا شهيدٌ بدارِ الخُلْدِ غِرِّيدُ",11,"د",1,0],["هذا أسيرٌ، يذوقُ المرَّ وا أسفا","وذا طليق، ولكن دُونَه البيدُ",11,"د",1,0],["هذا اسمراري فيكِ أعرفُ وقعَهُ","وأجيدُ كلّ لغاتهِ ببياني",12,"ن",2,0],["هذا أسامة ُ موصوف ٌ بخطبته","يجلو المعاني تفسيراً وتبيانا",13,"ن",2,0],["هذا أسامةُ لمْ أشهدْ ولادتَهُ","لهفي عليهِ ، ولا قبلتهُ سَعِدَا",14,"د",2,0],["هذاأسير الهوى بالمسِّ نشوتُه","والفكرُ تاهَ بهِ والصوتُ نبَّاحُ",15,"ح",1,0],["هذا اسمكم في نطقه فرحي","يا لحن روحي أنت موالي",16,"ل",2,0]]}