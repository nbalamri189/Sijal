{"poems":[[55,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[84,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[53,"كأن الكأس في يدها وفيها","https://www.aldiwan.net/poem65748.html","الوافر"],[47,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[47,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[63,"دعانا إلى اللهو داعي السرور","https://www.aldiwan.net/poem51638.html","المتقارب"],[63,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[82,"وصفراء كالشمس تبدو لنا","https://www.aldiwan.net/poem31464.html","المتقارب"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[54,"عناني صوت مسمعة وراح","https://www.aldiwan.net/poem27148.html","الوافر"],[77,"وقد كان لي منه شفيع مشفع","https://www.aldiwan.net/poem68933.html","الكامل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[50,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[50,"أسير الهم نائي الصبر عان","https://www.aldiwan.net/poem65309.html","الوافر"],[47,"مُغَنّيكَ، للبُغضِ، فيهِ سِمّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32047",""],[391,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[466,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[572,"أبى الدهر إلا فعالا خسيسا","https://www.aldiwan.net/poem69635.html","المتقارب"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129526","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16972","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113951","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69317","الوافر"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201714","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45505","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28058","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93439","الوافر"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93351","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205031","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204580","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91601","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91642","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91612","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32920","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204183","المتقارب"],[4715,"قلبي على الرمثا وعلى من سكنها","https://www.poetsgate.com/ViewPoem.aspx?id=204455",""],[4935,"سلام الله يا ابن الأكرمينا","https://www.poetsgate.com/ViewPoem.aspx?id=129306",""],[4978,"رد على قصيدة خريطة","https://www.poetsgate.com/ViewPoem.aspx?id=177229",""],[5030,"فلازم رجلها","https://www.poetsgate.com/ViewPoem.aspx?id=215815",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5268,"سيمرُّ في دَمِنا الرَصاصُ","https://www.poetsgate.com/ViewPoem.aspx?id=207018",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5376,"أتى في صبحه مرحا","https://www.poetsgate.com/ViewPoem.aspx?id=198237",""],[5956,"أسفي لقد مات القريب النضْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=194076",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""]],"verses":[["كَأَنَّ الكَرى يَقتَصُّ مِن طولِ نومِهِم","فَيُسهِرُ مِنهُ بِالقَنا كُلَّ نائِمِ",0,"م",1,0],["كأن الكوكب الدري كأس","وقد رق الزجاجة والمدام",1,"م",1,0],["كأن الكأس في يدها وفيها","عقيق في عقيق في عقيق",2,"ق",1,1],["كانَ الكَرى حَظَّ العُيونِ وَلَم أَخَل","أَنَّ القُلوبَ لَهُنَّ حَظٌّ في الكَرى",3,"ر",2,0],["كَأَنَّ الكَشوتَ عَلى شَوكِهِ","تَعَقُّفُ لِحيَتِهِ المُجرِمَه",4,"م",2,0],["كأنَّ الكؤوسَ وقد كُلَّلَتْ","بِفَضْلاتِها بأكاليلِ نُورِ",5,"ر",1,0],["كأنَّ الكُماةَ لإشراقِها","تَناهَبُ أعضاءَ شمسِ الضَّحاءِ",6,"ا",2,0],["كَأنَّ الكؤُوسَ بِأَيدي السَّقاةِ","خُيولٌ عَلى الهَمِّ مِنَّا مُغيرَه",7,"ر",2,0],["كأنّ الكيمياءَ تَسُلُّ منه","عجائبَ سرِّها للعارفينا",8,"ن",2,0],["كَأَنَّ الكَأسَ في يَدِهِ عَروسٌ","لَها مِن لُؤلُؤٍ رَطبٍ وِشاحُ",9,"ح",1,0],["كأن الكحيل الجون والروض وقد","مجامره مسك عليها وعنبر",10,"ر",1,0],["كأنّ الكُماةَ الصِّيدَ لمّا تغَشْمَرَتْ","حوالَيْهِ أُسْدُ الغِيلِ لا تتكعكَع",11,"ع",1,0],["كانَ الكَثيرُ رَجائي","فَفاتَ مِنّي القَليلُ",12,"ل",1,0],["كَأَنَّ الكَأسَ تَسحَبُ ذَيلَ دُرٍّ","كَسَتها الخَمرُ حُلَّةَ زَعفَرانِ",13,"ن",1,0],["كأنّ الكُشُوثَ عَلى شَوْكِهِ،","تَعَقُّفُ لِحْيَتِهِ المُجْرِمَهْ",14,"م",2,0],["كَأَنَّ الكورَ وَالأَنساعَ مِنها","عَلى قَرواءَ ماهِرَةٍ دَهينِ",15,"ن",1,0],["كان الكمالُ معوِزا","فصار فيك ممكِنا",16,"ن",2,0],["كأنَّ الكُماة الدارعين لدى الوغى","وقيْمازُ يُرْدي آخراً بعد أوَّلِ",17,"ل",1,0],["كَأَنَّ الكُؤُوَس بِأَيْدِيهِمُ","نُجُومُ سَمَاءٍ تُلاَقِي شُمُوسَا",18,"س",2,0],["كأن الكرى سر كأن الدجا حشا","كأن المنى طفل كأن الرجا مهد",19,"د",1,0],["كَأَنَّ الكَأسَ في يَدِهِ وَفيهِ","عَقيقٌ في عَقيقٍ في عَقيقِ",20,"ق",1,0],["كأَن الكرى مستحكم في جفونهم","ومَن يَرَ تحكيماً بأمرٍ تَحكَّما",21,"م",2,0],["كانَ الكَديدُ من آلِ الأصفَرِ آهِلاً","واليومَ أوحَشَ بعدَ آلِ الأصفَرِ",22,"ر",1,0],["كَأَنَّ الكُدرَ باتَت حَيثُ باتَت","تُلَبِّدُ في مَبارِكِها الرِمالا",23,"ل",2,0],["كأنَّ الكرى صب كأني رقيبه","كأنَّ الدُّجى قلب كأني به وجد",24,"د",1,0],["كانَ الكَمِيُّ مَعَ الرَسولِ كَأَنَّهُ","أَشِرٌ بِمأقَتِهِ مُدِلٌّ مُلحِمُ",25,"م",1,1],["كَأَنَّ الكُهولَ الشُمطَ في حَجَراتِها","تَعاطَسُ في تَيّارِها حينَ تَحفِلُ",26,"ل",1,0],["كَأَنَّ الكوسَ إِذ حُثَّت بِإِثري","كَواكبُ إِثرَ شَيطانٍ رَجيمِ",27,"م",1,0],["كَأَنَّ الكُتبَ أَجيادُ الغَواني","تَبَدَّت مِن سُطورٍ في عُقُودِ",28,"د",1,1],["كأن الكون أنت فحين أرنو","اليه لا أرى شيئا سواكا",29,"ك",2,0],["كان الكتاب صديقاً","لديّ غير مرائي",30,"ي",1,0],["كَأَنّ الكَأس فَاغر فاه طفلٌ","وَيَرضع ثَديَ مفروغٍ نَكيس",31,"س",1,0],["كَأَن الكَأس من خدّيهِ تَسقي","فَنشرب صِرفَها عبّاً وريّا",32,"ي",2,0],["كَأَنّ الكؤوسَ المترعاتِ مراحلٌ","تدانى بِها ربعٌ وَتَنأى مشائغُ",33,"غ",1,0],["كانَ الكِرامُ وَأَبناءُ الكِرامِ إِذا","تَسامَعوا بِكَريمٍ مَسَّهُ عَدمُ",34,"م",1,1],["كأن الكؤوس بأيدي السقاة","سيوفٌ لها بالدماء احمرارُ",35,"ر",1,0],["كان الكرامه والكرم تشبع حلوق","ليت الزمن يرجع نعيش بزمنها",36,"ن",3,0],["كان الكون أجمعه إليه","له تعنو جباه المالكينا",37,"ن",2,0],["كأنّ الكلام كؤوس المدامِ","وما تحتوي من شراب فصابْ",38,"ب",1,0],["كأن الكونَ لم يفقدْ سواها","فكل الحسنِ من سيماهُ زالا",39,"ل",2,0],["كَأنَّ الكَفَّ مِنْهُ البَحرُ جَدوَى","لِبَحرٍ مَدَّ بَحْرًا عَسْجَدِيَّا",40,"ي",2,0],["كانَ الكِتابُ هُناكَ واسمُكِ ظاهِرٌ","قدْ أعربوهُ فأخطأوا إعرابَهْ",41,"ب",2,0],["كان الكرام به الأجواد من مضرٍ","واليوم يؤوي به من ضرّ أو بخلا",42,"ل",2,0],["كأن الكون يلحقه","على عزف به صدحا",43,"ح",2,0],["كان الكريمَ العاطفيّ المُجتبى","يُجْدي على الدنيا وليس يضرُّ",44,"ر",1,0],["كان الكنانيْ، وكان الأصمعيْ، وعليْ","نصرٍ، وعاصمُ من طلاَّبه الصِّيدِ",45,"د",1,0],["كان الكسائي وهارونٌ وغيرُهما","مِن قادة الفكر طلابَ الفراهيدي",45,"د",2,0],["كان الكرامة والشها","مة للرجولة أسطرا",46,"ر",2,0],["كان الكريم بأ مة","دأبت تقاوم مُفتَرى",46,"ر",2,0]]}