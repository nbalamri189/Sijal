{"poems":[[53,"يا قاتل السنور والديك","https://www.aldiwan.net/poem65828.html","الطويل"],[52,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[52,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82302","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33066","الكامل"]],"verses":[["عَرْدٌ عليه فيشة ضخمةٌ","كأنها بعضُ المكاكيك",0,"ك",1,0],["عَرَّدتَ عَن قَرمِ بَني هاشِمٍ","وَالمَوتُ يَحدوكَ بِهِ الحادي",1,"د",2,0],["عَردٌ إِذا خَرِسَ المَطِيُّ كَأَنَّما","يَغدو يُجَرجِرُ دارِسٌ في نابِهِ",2,"ب",2,0],["عَردٌ كَقائِمَةِ السَري","رِ يُبيلُها عِندَ الرِّطامِ",3,"م",1,0],["عَردُ المَجَسِ بِمَتنِهِ عُجَزٌ","في جِذرِهِ عَن فَخذِهِ جَنَفُ",4,"ف",1,0]]}