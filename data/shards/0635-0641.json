diwan/poem/24724","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"على دربند","https://www.poetsgate.com/ViewPoem.aspx?id=179051",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[45,"مُحَمّدُ! مَا آمَالُنَا بكَوَاذِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31597",""],[45,"أقْصِرَا! ليس شأنيَ الإقْصَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=31344",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[101,"تَبَلّجَ بالْبُشْرَى وَلاحَتْ مَوَاكِبُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62442&r=&rc=34",""],[88,"إياك والبصرَّة المُضنى توطُّنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19576&r=&rc=79",""]],"verses":[["صَفا العَيشُ مِن بَعدي لَحَيٍّ عَلى النَقا","حَلَفتُ لَهُم لا أَقرَبُ الماءَ صافِيا",0,"ي",2,0],["صَفَحنَ إِلينَ عَن خُدودٍ أَسيلَةٍ","دُنوَّ العَواطي مِن ظِباءِ الصَرائِمِ",1,"م",1,0],["صُفَّت نِطافُ المُنى فَقُلتُ لَها","ما أَجنَت في دِيارِنا النِعَمُ",2,"م",1,0],["صَفَوتُ لَكُم فَرَنَّقتُم غَديري","وَأَيُّ مُضاغِنٍ رَجَعَ المُصافي",3,"ي",1,0],["صِفاحُ خُدودٍ كَالذَوابِلِ طَلقَةٍ","يُبادونَ بِالظَلماءِ لَحماً مُبَضَّعا",4,"ع",2,0],["صَفَحتُ وَقَد كانَ التَغَصُّصُ ذادَني","عَنِ الصَفحِ لَكِن أَنتَ مِن كَرَمِ البَحرِ",5,"ر",1,0],["صَفقَةُ غُبنٍ في الهَوى","بَيعُ بَهيمٍ بِأَغَرّ",6,"ر",1,0],["صَفَحَ الثَرى عَن حُرِّ وَجهِكَ أَنَّهُ","مُغرىً بِطَيِّ مَحاسِنِ الأَمجادِ",7,"د",1,0],["صَفَداتُ مالِ اللَهِ مِلءُ أَكُفُّها","وَأَكُفُّ آلِ اللَهِ في أَصفادِها",8,"د",3,0],["صَفَحتُ عَن دَمِ قَلبٍ طَلَّهُ هَدراً","بُقياً عَليهِ فَما أَبقى وَلا صَفَحا",9,"ح",2,0],["صَفَتْ بكَ دُنيا كدّرَتْها عِصابَةٌ","تمرَّدَ غاويها وعَزَّ ذَليلُها",10,"ل",3,0],["صَفا فُؤادي لَكُمُ","فَاِقتَسِمي وَاِنتَهِبي",11,"ي",1,0],["صُفْرٌ كالشّمْسِ إذا جنَحَتْ","حُمْرٌ قد أُلْبِسَتِ الشّفَقا",12,"ق",2,0],["صَفيحَةً قد تدلّتْ","منْ خلْفِ حافِرِ عيْرِ",13,"ر",1,0],["صفر الملابس في شكل وفي أرج","كأنها مذهبات العنبريات",14,"ت",1,0],["صَفْرَاءُ نُسْفِرُ عَنْ حَبَابِ كُؤُوسِهَا","رَقَّتْ فَرَاقَ لَنَا الزَّمَانُ بِذَاتِهَا",15,"ت",3,0],["صَفحتُ لَهُ بَعدَ الأَناةِ فَرُعتُهُ","بِحَرباءَ لَم يعلم لَها كَيفَ أَرصَدا",16,"د",2,0],["صَفَحتُ لَهُ صَفحاً طَويلاً كَصَفحِهِ","وَعَيني وَلا يَدري عَليهِ وَأَحراسي",17,"ي",1,0],["صَفراءُ آنِسَةُ الحَديثِ بِمِثلِها","يَشفي غَليلَ فُؤادِه المَلهوفُ",18,"ف",1,0],["صَفحَةُ البَرقِ أَومَضَت في الغَمامِ","أَم شِهابٌ يَشُقُّ جَوفَ الظَلامِ",19,"م",1,1],["صَفِيَّةُ قادَتكُنَّ لِلمَجدِ وَالعُلا","كَما كانَ سَعدٌ قائِدَ السَرَواتِ",20,"ت",1,0],["صَفَوتُ فَأَدلَلتُ في عَرضِها","وَمَن يَصفُ مِنهُ الهَوى فَليُدِلّ",21,"ل",1,0],["صَفوحٌ فَما تَلقاكَ إِلَّا بخيلَةً","فَمَن مَلَّ مِنها ذَلِكِ الوَصلَ مَلَّتِ",22,"ت",1,0],["صَفَاءُ العَيشِ فِي شَملٍ جَمِيعٍ","لَهُ الجَنَّاتِ وَالصَّرحُ المُهيَّا",23,"ي",2,1],["صَفَى لِمَنْ صَافَى وَفَى لِمَنْ وَفَى","غَفُورٌ لِمَنْ يَغْتَابُهُ وَيَخُونُ",24,"ن",1,0],["صَفْوَ النُّهَى حُرٍّا عَلَى مَا تَبْتَغِي","فِطَنُ الدُّهَاةِ وَهِمَّةُ الشُّجْعَانِ",25,"ن",1,0],["صِفْ ذَلِكَ اللُّطْفَ لَوْ عَزَّتْ بِهِ أُمَمٌ","يَوْماً لَعَزَّتْ بِهِ مِصْرٌ عَلَى الأُمَمِ",26,"م",1,0],["صِفْ ذَلِكَ الأُنْسَ يَجْرِي مِنْ مَنَابِعِهِ","عَذْبَ المَنَاهِلِ مَبْذُولاً لِكُلِّ ظَمِي",26,"م",2,0],["صِفْ ذَلِكَ الرِّفْقِ يَقْضِي فِي تَرَقْرُقِهِ","مَا لَيْسَ رِقَاقُ السُّمْرِ وَالخُذُمِ",26,"م",1,0],["صِفْ مَا يَشَاءُ جَمَالُ الطَّبْعِ مِنْ دَعَةٍ","وَمَا يَشَاءُ حَلالُ النَّفْسِ مِنْ كَرَمِ",26,"م",1,0],["صَفِيَّةَ الطُّهْرِ آتَاكَ الجِهَادُ حِلىً","لَمْ تُؤْتِهَا فِي الْخُدُورِ الأَنْفُسُ السُّقَمُ",27,"م",1,0],["صَفَا جَوُّهَا فَالشَّمْسُ فِيهِ سَلامَةٌ","تُصَبُّ عَلَى الأَبْدَانِ وَالبَدْرُ بَلْسَمُ",28,"م",1,0],["صَفَا ذِهْنُهُ حَتَّى لَيُبْصِرُ فِكْرُهُ","خِلالَ سُجُوفِ الرَّيْبِ مَا الْغَيْبُ كَاتِمُ",29,"م",1,0],["صَفِيَّ أَميرِ المُؤمِنينَ وَخالَهُ","سَمِيَّ خَليلِ اللَهِ وَاِبنَ هِشامِ",30,"م",1,0],["صَفَضنَ الخُدودَ وَالنُفوسُ نَواشِزٌ","عَلى شَطِّ مَسجورٍ صَخوبِ الضَفادِعِ",31,"ع",1,0],["صَفَحنَ لِلأَزرارِ بِالخُدودِ","يَتبَعنَ مِثلَ الصَخرَةِ الصَيخودِ",32,"د",1,0],["صُفَّتْ عليه للفواكه كُلُّ ما","قد عاهدته بدوحها المتعوّدِ",33,"د",1,0],["صفحات من الغرام تراها","ظاهراتٍ في صوتها للعيان",34,"ن",1,0],["صفت المحبّة في قرار نفوسنا","لهما صفاء الخمر في الراووق",35,"ق",1,0],["صفا ماء الشباب بوجنتيها","فحامت حول رَوْنقه القلوب",36,"ب",1,0],["صَفَقتُم لِلبُزاةِ حُبارِياتٍ","فَأَخزى الخُنثَيَينِ مُنى الضَلالِ",37,"ل",1,0],["صَفَت لَكَ بَيعَةٌ بِثَباتِ عَهدٍ","فَوَزنُ العَدلِ أَصبَحَ لا يَميلُ",38,"ل",1,0],["صَفَائِحُ بِيضٌ جَلَتهَا القُيُو","نُ مما تُخُيِّرنَ من يَثرِبِ",39,"ب",1,0],["صَفاؤُكَ في البُعدِ مِثلُ الدُنُوِّ","وَوُدُّكَ في القَلبِ مِثلُ اللِسانِ",40,"ن",1,0],["صِفنا بِخَرشَنَةٍ وَقَطَّعنا الشَتا","وَبنو البَوادي في قُمَيرَ حِلالا",41,"ل",2,0],["صَفوحٌ عِندَ قُدرَتِهِ كَريمٌ","قَليلُ الصَفحِ مابَينَ الصِفاحِ",42,"ح",1,0],["صفيَّ الله يا أزكى البرايا","بحبك من عقائدنا الصفاء",43,"ا",2,0],[