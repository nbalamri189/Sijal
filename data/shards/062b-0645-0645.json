=208736",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5956,"نحن أرواح","https://www.poetsgate.com/ViewPoem.aspx?id=182625",""],[5956,"أمّ فلسطينية","https://www.poetsgate.com/ViewPoem.aspx?id=192336",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6124,"هديل","https://www.poetsgate.com/ViewPoem.aspx?id=159668",""],[6152,"أصعب الأشياء كتمان الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=213344",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""]],"verses":[["ثُمَ مِلنا عَلى تَميمٍ فَأَحرَم","نا وَفينا بَناتُ مُرٍّ إِماءُ",0,"ا",2,0],["ثُمَّ ما كاؤوا وَلَكِن قَدَّموا","كَبشَ غاراتٍ إِذا لاقى نَطَح",1,"ح",1,0],["ثُمَّ مُرّوا بِرُفاتي","في القُبورِ الدارِساتِ",2,"ت",1,0],["ثمَّ من معشرٍ يَدِبُّونَ بالإفْ","ساد للحال واللَّئيمُ دَبُوبُ",3,"ب",1,0],["ثم مِن أحلف خلقِ ال","لَهِ أن لا يتغدَّى",4,"د",2,0],["ثمّ من أقبح البريّة طُرّاً","زَفَّها عاجِلاً إلى القبرِ نعشُ",5,"ش",1,0],["ثم مضتْ مهملةً بلا ملكْ","تسيرُ في الغيِّ الوجيف والرتَكْ",6,"ك",1,0],["ثمَّ ماذا هذا أنا صرتُ في الدُّن","يا بعيداً عن لهوِها وغِنَاها",7,"ه",2,0],["ثمَّ من وَصْلِهِ الجَمي","لِ غَدا القَلْبُ مُمْلِقا",8,"ق",2,0],["ثمَّ مالَتْ لِغُروبٍ","بَعْدَ إضْرامِ الكِفاحِ",9,"ح",1,0],["ثم من بعد ان اقيم بقبري","لا ارى من شمس النهار شعاعا",10,"ع",2,0],["ثم مضت ولم أكن","قضيت منها أرَبي",11,"ي",1,0],["ثم مدِّى من بنيهم سرحة","تملأ النيل قراه وبلاده",12,"د",2,0],["ثُمَّ مَضى مِن فَورِهِ يَصيحُ","قَطَعتُهُ لِأَنَّهُ فَصيحُ",13,"ح",1,0],["ثُمَّ مَضى لِما عَلَيهِ صَمَّما","وَعاهَدَ الأُمَّ عَلى أَن تَكتُما",14,"م",2,0],["ثُمَّ مَضى لا عادَ مِن مُفارِقِ","بِقائِدٍ مِن ذَوبِهِ وَسائِقِ",15,"ق",1,0],["ثُمَّ مُر طَرفَكَ الصَحيحَ بِأَن يَأ","خُذَ مِن طَرفِهِ السَقيمِ بِوِترِ",16,"ر",1,0],["ثُمَّ ماتتْ فجسمُها","جوهرٌ زالَ بالعرضْ",17,"ض",1,0],["ثُمَّ ما نِمتُ بَعدَكُم مِن مَنامٍ","مُنذُ فارَقتُ أَرضَكُم مُطمَئِنّا",18,"ن",2,0],["ثُمَّ ما تُذكَرينَ لِلقَلبِ إِلّا","زيدَ شَوقاً إِلَيكُمُ وَاِستُجِنّا",18,"ن",2,0],["ثُمَّ مَضى يُعشى بِهِ خاطِري","ناراً وَيُغشى ناظِري نورا",19,"ر",2,0],["ثُمَّ مَضى أَحسِبُهُ كَوكَباً","مُنكَدِراً أَو بارِقاً مومِضا",20,"ض",2,0],["ثُمَّ مَضى يَعِدُ بِالبُكورِ","وَهَزَّ رَأسَ فَرِحٍ مَسرورِ",21,"ر",1,0],["ثَمَّ مَعْنىً وصورَةً فَهْوَ في الحا","لَيْنِ مِلْءُ العُيونِ مِلءُ الصُّدورِ",22,"ر",1,0],["ثمَّ مَضَوْا في حَرْبهم أيّاما","حتَّى بدا الموتُ لهم زُؤاما",23,"م",2,0],["ثمَّ مَضى يستنزِلُ الحُصونا","ويَبعثُ الطِّلاعَ والعُيونا",23,"ن",2,0],["ثم مَضى المُظَفَّرُ المنصورُ","على جَبِينه الهدى والنُّورُ",23,"ر",1,0],["ثمَّ مَضَوْا والعِلجُ يَحْتذيهِمُ","بجيْشهِ يَخشى ويَقْتفيهمُ",23,"م",1,0],["ثمّ مَضى اللّيثُ إليهم زحفاً","يَختطِفُ الأَرواحَ منْهم خَطْفا",23,"ف",2,0],["ثمّ مَضى القائدُ بالتأييدِ","والنَّصر في ذِي العَرْش والتَّسديدِ",23,"د",1,0],["ثمّ مَضَى بالعزِّ والتَّمكينِ","وناصراً لأهلِ هذا الدِّينِ",23,"ن",1,0],["ثم مَضى يُثْني على سيّدٍ","كاللّيْث إلا أنّه أحْزمُ",24,"م",1,0],["ثم مَجِّدْ مُحمَّداً جَدَّ إسْمَا","عيلَ واصْعَدْ ما شئتَ في التَّمْجيدِ",25,"د",1,0],["ثم ملنا على تميمٍ فأحر","نا وفينا نبات قومٍ إماء",26,"ا",2,0],["ثم ماذا ..؟ ورصيف مثقل","برصيف .. يحسب الصمت حصافه",27,"ف",2,0],["ثم ماذا ؟ أسمت (سعيدا ) (نبيلا)","ودعت (شعلة) (هدى) أو (سميره)",28,"ر",2,0],["ثم مرت بالروض تنصت فيه","لأغاريد البلبل الصداح",29,"ح",1,0],["ثمّ ملنا على تميمٍ فأحرمْ","وَفِينَا بَنَاتُ قَوْمٍ إمَاءُ",30,"ا",2,0],["ثُمَّ مَدَّت إِلَيَّ كَفّاً مِنَ اللُؤ","لُؤِ فيها أَنامِلٌ مِن عَقِيقِ",31,"ق",1,0],["ثم ما يخفيه حالي فوق ما","أخذت تبدى لمن يجهله",32,"ل",2,0],["ثم مآل كل من ترى به","شبا وشبانا إِلى ترابه",33,"ب",2,0],["ثُمَّ مُنُّوا بِلقَائِي","وَسَلُونِي عَن حَدِيثِ",34,"ث",1,0],["ثمّ مِن بعدِ ودّع الأحبابا","وَدعاهُ إلههُ فَأَجابا",35,"ب",2,0],["ثمَّ ماتَت خَديجةٌ فأتاهُ","أيُّ رُزءٍ جلَّت به الأرزاءُ",36,"ا",2,0],["ثمّ ماتَ النبيُّ بَل أفلَت شَم","سُ الهُدى واِستمرّت الظلماءُ",36,"ا",2,0],["ثُمَّ مِن بَعدِ لَحظَة تَوَرَّثَ اليُس","رُ وَعرض مُهذب مَوفور",37,"ر",1,0],["ثم مازالتِ المشايخُ حتى","علموها الدلالَ في الكُتَّابِ",38,"ب",1,0],["ثم من عاشَ بعدَ ذلكَ فقد عا","شَ ليبكي مما بهِ أو ينوحا",39,"ح",2,0],["ثمم جفتْ عروقُها","وتجافتْ جنوبُها",40,"ب",3,0],["ثم ميزتُ كل شيءٍ أراه","وعرفتُ الضيا ولونَ الظلام",41,"م",1,0],["ثم ما يحدث في النفس","اذا الضوء انتشر",42,"ر",1,0],["ثم مالي وجه إليك سواه","فاجعلن التقوى لباسي وريشي",43,"ش",2,0],["ثمّ مزّق ثوب الخلاعة سكراً","وتلافى تلافَه بالرقاع",44,"ع",1,0],["ثم مدَّت يمينَها فأرَتني","زنبقاً فاحَ في الغياضِ بليلا",45,"ل",2,0],["ثمَّ مهوى القلب داراتُ الهوى","منزل الأَهلِ حمى المستضعفين",46,"ن",1,0],["ثُمَّ مَن ذا قَد حَرَّكَ النَصراني","وَاِستَفَزَّ الأَسبانُ وَالعُثماني",47,"ي",1,0],["ثم مضت كأنها لم تكن","تملأ من حينٍ عليّ الوجود",48,"د",1,0],["ثم مال الزمان يوما بحظّي","فإذاه في الروع أول رام",49,"م",1,0],["ثم ماذا صمت وعيٌّ وعجزٌ","وظلام وحيرةٌ وعمايه",50,"ه",1,0],["ثم مضت نجواك في إثرها","صبابة تلهبُ كأس الزمان",51,"ن",1,0],["ثم ماذا ثم مات","الصبر ما بين يدينا",52,"ن",2,0],["ثم ميلي كيف شئت","واخطفي مني اللهيب",53,"ب",1,0],["ثُمّ من بعدِ أن تُزرَّرَ يُكسا","ها الفتَى وهو أظرَفُ الأشيْاء",54,"ا",2,0],["ثُمَّ مَحَّت آثارُهُم وَتَفانَت","بَعدَهُم وَاللِقاءُ بِالأَخبارِ",55,"ر",1,0],["ثم من كان يؤمن بالرحيم","فليقل خيرا ويصمت يصان",56,"ن",1,0],["ثم مولى الدويله والوجيه الذي عم","نوره الأرض والسكران وابنه ومن لم",57,"م",1,0],["ثم مطلوبي وغايته","نيل ما في القلب في عجل",58,"ل",1,0],["ثم ما قال غير هذا فهل عن","دك رأي يجلو دجى الإِظلام",59,"م",1,0],["ثم من ناظر أو جادل أو","رام كشفاً للذي لم ينْجَلِ",60,"ل",1,0],["ثم ما راعنا سوى قول شخص","لخليل له يسر المقاله",61,"ل",2,0],["ثم من السنة ثم عنه وقل","كانوا وكنا مقيداً بخبر",62,"ر",1,0],["ثم مضى يُعقِبُ في","ه نَجلَهُ فنجلَهْ",63,"ل",2,0],["ثمَّ مُنتَظِرٌ لِحَفلٍ دَنَا وَق","تُه والوَقتُ ثَمَّ جِدُّ ثَمينِ",64,"ن",1,0],["ثمَّ مُذ فارَقتُموهُ","لم يَذُق للنَّومِ طَعما",65,"م",2,0],["ثم من بعد قال إلا كبيراً","علَّهم يرجعون عنهم لديه",66,"ي",