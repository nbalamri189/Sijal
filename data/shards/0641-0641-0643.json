{"poems":[[57,"بعثت إلي صحيفة مختومة","https://www.aldiwan.net/poem26527.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[29,"غزا نمر وقاد بني تميم","https://www.aldiwan.net/poem5719.html","الوافر"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[64,"تطهر بماء الحياة الذي","https://www.aldiwan.net/poem52198.html","المتقارب"],[64,"لنا أرض نشمسها زمانا","https://www.aldiwan.net/poem52218.html","الوافر"],[64,"إذا أرواحنا بالطبخ يوما","https://www.aldiwan.net/poem52224.html","الوافر"],[30,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[136,"أبرق ما لمحت له ائتلاقا","https://www.aldiwan.net/poem54791.html","الوافر"],[177,"وهيهات مشن ريب الزمان وريحه","https://www.aldiwan.net/poem4393.html","عموديه"],[408,"لعدلك قد وجهت يا بن محمد","https://www.aldiwan.net/poem46922.html","الطويل"],[438,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[473,"لنا ذهب بواتقه الكؤوس","https://www.aldiwan.net/poem59962.html","الكامل"],[482,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77503","المنسرح"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112830","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6771","السريع"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202064","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124764","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93984","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204701","المتقارب"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97880","المجتث"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146487","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89041","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110084","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91051","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114272","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44722","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[4459,"","https://poetry.dctabudhabi.ae/diwan/poem/97715","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58119","الطويل"],[4767,"قوافي الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=181926",""],[4978,"رد على قصيدة من الإخوانيات","https://www.poetsgate.com/ViewPoem.aspx?id=177245",""],[4984,"أفكارنا","https://www.poetsgate.com/ViewPoem.aspx?id=180121",""],[5246,"إذا لم يساعدني لإسعاف صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=187057",""],[5829,"حينا فحينا","https://www.poetsgate.com/ViewPoem.aspx?id=214903",""],[5937,"كأسٌ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=211827",""],[6102,"أَفكارٌ هارِبَةٌ!!","https://www.poetsgate.com/ViewPoem.aspx?id=185364",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""]],"verses":[["فَفَكَكتُها فَقَرَأتُ ما قَد حَبَّرَت","فَإِذا مَقالَةُ مُستَزيرٍ عاتِبِ",0,"ب",1,0],["فَفَكَّ عَن مِئَةٍ مِنهُم وِثاقَهُمُ","فَأَصبَحوا كُلَّهُم مِن غُلَّةِ خُلِعا",1,"ع",2,0],["فَفَكَّ الغُلَّ عَن تَيمِ بنِ قُنبٍ","وَتَيمٌ في السَلاسِلِ وَالقُيودِ",2,"د",1,0],["ففككت البخيلَ من غُلّ بُخلٍ","وفككتَ الخليل من سوءِ حالِ",3,"ل",1,0],["ففكَكْتَ البخيلَ من غُلّ بُخلٍ","وفككتَ الفقيرَ من سوءِ حالِ",4,"ل",1,0],["ففكَّهُ فكَّ حُرٍّ عن مُقَلَّده","صلتُ الجبينِ أشَمُّ الأنفِ عَليان",5,"ن",1,0],["ففكر لتعرف ما قد ذكرت","ففيه فوائد لا تحصرُ",6,"ر",1,0],["ففكر في الذي قلناه واصبر","عليه تستفد رمزاً جميلا",7,"ل",2,0],["ففكر تستفد كنزاً دفيناً","فحلمتنا هي الكنز الثمين",8,"ن",1,0],["فَفَكَّ مِنَ الأَغلالِ بَكرَ بنَ وائِلٍ","وَأَعطى يَداً عَنهُم لَهُم مِن غَلائِها",9,"ا",3,0],["فَفكِّرُوا واذكرُوا آلاء سَيِّدكم","فهو الإمامُ الكريمُ الباسلُ النمرُ",10,"ر",1,0],["فَفكَّ وَثَاقَهُ فَلَهُ وُثُوقٌ","بِفَكِّكَ عَن مَعَاصِمِهِ الوَثَاقَا",11,"ق",2,0],["فَفُكُوا إِسَارِي مِن إِحَالَةِ مُعسِرٍ","فَإِنِّي وَرَبِّ المَكرُمَاتِ لَعَانِ",12,"ن",1,0],["فَفُكَ بأيْدي الجودِ أسريَ مُنْعِماً","عليّ فإنّي من ديُوني في كبْل",13,"ل",1,0],["فَفَكَكْتُ طَرْفِي مِنْ عِقَالِ جَمَالِه","وَتَرَكْتُ قَلْبِي عِنْدَهُ مَأْسُورا",14,"ر",2,0],["فَفُكَّ بِزَورَةٍ أَقداحَ قَومٍ","أَكُفُّهُمُ لِأَسراها حُبوسُ",15,"س",1,0],["ففكري تقصرُ الأفكارُ عنه","وشِعري لايُشَقُّ له غبارُ",16,"ر",1,0],["ففكر بعضهم حينا وألقى","وقد ذهلوا إليهم بالزمام",17,"م",1,0],["فَفَكر السَبع في هَواه","وَقالَ وَالحال ترجمان",18,"ن",1,0],["ففكروا في التين والزيتون","واستكشفوا عن سره المكنون",19,"ن",1,0],["ففك اسرى وهب نصرا عزيزا","وحفظا أن ارادتني الولاة",20,"ه",1,0],["فَفَكروا في أَمرِهِ وَقالوا","أَنطقه بِما سَمعنا المال",21,"ل",1,0],["فَفَكِّروا في هَولِها وَاِحذَروا","ما حَذَّرَ اللَهُ مِنَ النارِ",22,"ر",1,0],["ففكر كنجم في الدجى متوقد","وقلب إذا شئت قلت حديد",23,"د",1,0],["ففكّر وراع في العيادة حال من","تعود ولا تكثر سؤالا تنكد",24,"د",1,0],["فَفَكَّرتُ وَهناً أَيُّها أَنا ناظِمٌ","وَسامرتُها أَختارُ مِنها وَأَنتَقِي",25,"ق",2,0],["ففككه واستخرج وبالسبب ابتدى","تجدها فروعاً ستة فادر يا تقي",26,"ق",2,0],["ففكّر بعقلك مثلي تنل","من الناس مثليَ هذي الصفة",27,"ف",2,0],["ففكَّ أغلال نفسي","والعيدُ يومَ الفكاك",28,"ك",1,0],["ففكِّر إذا ما رُمتَ إفشاء سِره","فها أنا قد أظهرتُه وهو مُضمَر",29,"ر",1,0],["ففكرٌ إلى علمٍ ونفسٌ إلى تقىً","ووجهٌ إلى وفدٍ وكفٌّ إلى رفد",30,"د",1,0],["ففكَ رقابَ اليُتمِ من أَسْرِ حميرٍ","فتىً بأسهُ فيهم كنائلِة الغَمْرِ",31,"ر",1,0],["ففكَّرتُ في الخاطي المُصِرِّ وحتفهِ","فيبكي ولكن لا على الذَنبِ والجُرمِ",32,"م",1,0],["فَفكّر لتبصر غير ما أَنتَ مُبصرٌ","وَبادر لِتنجو قَد أَحاطَت كَوارث",33,"ث",1,0],["ففككت أَستار الجُموع وَلم تذر","باباً بدا إِلا وَفيهِ ضَيغم",34,"م",1,0],["فَفِكرُكَ فِيهَا اعمَل لإِخرَاجِ خَبئِهَا","وَرَبُّكَ فَتَّاحٌ عَلِيمٌ وَذُو حَوطِ",35,"ط",1,0],["فَفَكَّرَ المَغرورُ ذات يَومِ","إِن يَجمَعَنَّ أَنصارهُ في الظُلمِ",36,"م",1,0],["فَفُكَّ رَسولَ اللَهِ حلقةَ أَزمَتي","بِسابِغ إِنعامٍ فَفَضلُكَ باهِرُ",37,"ر",1,0],["فَفكّوا دريداً من إسار مخارقٍ","وَلا تَجعلوا البؤسى إِلى الشرّ سلَّما",38,"م",2,0],["ففَكُّوا عَنِ الأَيْدِي القُيُودِ وَحَطَّمُوا","سَلاَسِلَ في الأَعْناقِ يُؤْذي حَديدُها",39,"د",3,0],["ففكِّرْ تجد ما قلتُه ليس مِثْلَهُ","رياحٌ ولا شمسٌ تسيرُ وتأمُلُ",40,"ل",1,0],["ففكر ملياً بما قد مضى","وإن لم تفكر فلا تشطح",41,"ح",1,0],["(ففكري زلال به سلسبيلٌ )","وبستان حرفي قطوف الذرى",42,"ر",2,0],["ففكرة ماتت بلا غاية","ليس لها إلا الرجا باعث",43,"ث",1,0],["ففكرت في أني أحيل إليكم","سؤال أبي إدريس نالكم الأجر",44,"ر",1,0],["ففكِ القيدَ قدْ آلمتَ قلبي","وصارَ القلبُ في صدري سجينا",45,"ن",2,0],["ففكي لثامك كي لا أضيع","وفكيه ، حتى يضعنَ الصّبايا",46,"ا",3,0],["فَفُكَّا لِي إِذا ما لُمتُمانِي","قُيُودَ أُبُوَّتِي... لِأَمُوتَ حُرَّا",47,"ر",2,0],["ففك من وتدي المعقود حبل منى","فرفّ مني شراع كان يعليها",48,"ي",3,0]]}