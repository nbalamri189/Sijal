","https://poetry.dctabudhabi.ae/diwan/poem/86502","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69967","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147649","الكامل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101161","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127257","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123488","الكامل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21553","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90893","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90828","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54370","المجتث"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135097","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73416","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72855","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205461","الكامل"],[3464,"بشرى سيوط لها المقام الأصعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158749",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5183,"مصيبة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180257",""],[5210,"أتظن أني بعد بعدك باقي","https://www.poetsgate.com/ViewPoem.aspx?id=169358",""],[307,"وجوه في المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=214163",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5431,"قد غاب عني _في رثاء ثائر العجلوني","https://www.poetsgate.com/ViewPoem.aspx?id=197874",""],[709,"أَمِنَ الْبُرُوجِ تُعَدُّ أَكْنَافُ الْحِمَى","https://www.poetsgate.com/ViewPoem.aspx?id=2919",""],[709,"عَرِّجْ عَلَى الْبَانِ وانْشُدْ فِي مَجَانِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2907",""],[709,"كتمَ الهوى فوشى النّحولُ بسرّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2905",""],[5497,"عزفٌ على العود","https://www.poetsgate.com/ViewPoem.aspx?id=205947",""],[5497,"سيد الكونين","https://www.poetsgate.com/ViewPoem.aspx?id=208611",""],[5582,"بَكَرَ الخَلِيطُ مِنَ الدِّيارِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186853",""],[5582,"طَرَقَ الخَيالُ دُجَىً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186905",""],[5582,"هَلْ ذاكَ بَدْرٌ لاحَ تَحْتَ غَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63579",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5596,"مكة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=206716",""],[5660,"حَيِّ الجَمَالَ مَتى رَأَيتَ الأَسمَرا","https://www.poetsgate.com/ViewPoem.aspx?id=35369",""],[5908,"يا دار علوة حياك الحيا الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=170977",""],[519,"ما الرّاحُ إلا روحُ كلِّ حزينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9751&r=&rc=7",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""],[6338,"بشير يوم بملك دهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52549&r=&rc=11",""],[572,"كأَنّمَّا الرّاووقُ وانتصابُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9178&r=&rc=35",""],[572,"غَيْثٌ أتانا مؤذنٌ بخَفضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9360&r=&rc=217",""]],"verses":[["غَيثانِ ذا جامِدٌ تَخفى مَشائِلُهُ","عَنِ العُيونِ وَذا بادي الذَرى هامي",0,"م",2,0],["غيْثُ النّوالِ إذا الغَمامُ حَلوبَةٌ","مثَلَتْ بأيْدي الحالِبينَ بَسوسا",1,"س",2,0],["غيْثاً وما غيرُ النّوالِ سَحابةٌ","ليْثاً وما غيرُ الظُّبا أظْفارُ",2,"ر",1,0],["غَيثُ الأَرامِلِ وَالأَيتامِ كُلِّهِمُ","لَم تَطلُعِ الشَمسُ إِلّا ضِرَّ أَو نَفَعا",3,"ع",2,0],["غَيثُ العَشيرَةِ كُلُّها","الغائِرينَ وَمَن جَلَس",4,"س",1,0],["غيث الشآم ونيل مصر إذا شتت","يوماً وضاقت رحلةُ الإيلاف",5,"ف",1,0],["غيثٌ إذا اسْتَمطرتَهُ","ألفيتَ من ذَهبٍ ذِهابهْ",6,"ب",2,0],["غيث أظلَّ فبشَّرتْك برُوقُه","وَمَرَتْ لك النفحاتِ منه رياحُه",7,"ح",2,0],["غيثِ الورى من حاضر ومن بادْ","ذو عارضٍ يمطر قبل الإرعادْ",8,"د",1,0],["غيث نعيش بصوبه ونرى العدى","ضعفين تحت لهيبه ورجيفه",9,"ف",2,0],["غيث مغيث عرفُه ودقُه","وبشره بالناس إبراقه",10,"ق",2,0],["غيث مغيث ضامنٌ للحيا","وليس بالمأمون إصعاقه",10,"ق",2,0],["غيثُ الأنام إذا الغُيو","ثُ بخلن في السَّنة الأزوم",11,"م",1,0],["غَيثُ مُزنٍ غامِرٌ حيثُ يُجدِي","وَإِذا يَسطُو فَلَيثٌ أَبَلُّ",12,"ل",1,0],["غَيْثٌ تَرى الأرضَ على وَبْلِهِ","تَضْحَكُ إِلاَّ أَنّهُ يَهْمُلُ",13,"ل",1,0],["غَيثٌ يُبَيِّنُ لِلنُظّارِ مَوقِعُهُ","أَنَّ الغُيوثَ بِما تَأتيهِ جُهّالُ",14,"ل",1,0],["غَيثٌ أَذابَ البَرقُ شَحمَةَ مُزنِهِ","فَالريحُ تَنظِمُ فيهِ حَبَّ الجَوهَرِ",15,"ر",1,0],["غَيثٌ تَدَفَّقَ وَاللُجَينُ رِهامُهُ","فينا وَلَيثٌ وَالرِماحُ غَريفُهُ",16,"ف",2,0],["غَيثُ السَماءِ اِستَهَلَّ بارِقُهُ","وَلَيسَ بَدرُ السَماءِ في أُفقِه",17,"ق",2,1],["غَيثُ العُفاةِ وَفَكّاكُ العُناةِ وَقَت","تالُ العُداةِ غَداةَ الرَوعِ وَالوَهَلِ",18,"ل",1,0],["غَيثانِ أَصبَحَتِ العِراقُ لِواحِدٍ","وَطَناً وَغَرَّبَ آخَراً فَتَشأَما",19,"م",2,0],["غَيثٌ تَحَمَّلَ عَنهُمُ مُتَوَجِّهاً","مِن غَربِهِم لِمَشارِقِ البُلدانِ",20,"ن",1,0],["غيث تحث الأريحية مزنه","حتى يعم أقاربا وأباعدا",21,"د",2,0],["غَيثٌ تحلَّبَ في الآفاقِ رَيِّقُه","على العُفاةِ ومَنشَى مُزْنِه حلَبُ",22,"ب",1,0],["غيثٌ هو المَحْلُ ما احمرَّت سَحائبُه","إلا تراجَعَ مصفرّاً به العُشُبُ",22,"ب",1,0],["غَيثُ جودٍ إِن هَمَّ لِلقَصدِ راجٍ","وَوَبالٌ إِن هَمَّ بِالجَورِ باغِ",23,"غ",1,0],["غَيثٌ يُريكَ مِنَ السُيوفِ بَوارِقاً","وَمِنَ الجِيادِ زَلازِلاً وَرُعودا",24,"د",2,0],["غيث على القفر حيّانا وأحيانا","يا شاعر الجيل كان الجيل ظمآنا",25,"ن",2,1],["غَيثٌ حَوى كَرَمَ الطَبائِعِ دَهرَهُ","وَالغَيثُ يَكرُمُ مَرَّةً وَيَلومُ",26,"م",1,0],["غَيثانِ فَالأَنواءُ غَيثٌ ظاهِرٌ","لَكَ وَجهُهُ وَالصَحوُ غَيثٌ مُضمَرُ",27,"ر",1,0],["غْيثُ العُفاةِ تَلُوذُ منه وفُودُهمْ","بأخي السّماحِ وخِلّهِ وخَدينِه",28,"ن",2,0],["غَيْثُ البلادِ إذا اكفَهَرَّ تجهُّماً","في أوجُهِ الرُّوّادِ عامٌ مُمحِل",29,"ل",1,0],["غَيثُ الزَواني إِذا أَمسى بِعَقوَتِهِ","وَآفَةُ المالِ بَينَ الزِقِّ وَالعودِ",30,"د",1,0],["غيثَتِ الخُدودُ بِعَب","دِ الغنيّ مُمطِرِها",31,"ر",3,0],["غَيْثَانِ إنْ جَدْبٌ تَتَابَعَ أقْبَلا،","وَهُمَا رَبيعُ مُؤمِّلٍ، وَخَرِيفُهُ",32,"ف",2,0],["غَيْثُ العُفَاةِ ،وفَكَّاكُ العُنَاةِ ، وقَتَّالُ","العُداةِ غَدَاةَ الرُّوعِ والوَهَلِ",33,"ل",1,0],["غَيثانِ، أصْبحتِ العرَاقُ لوَاحِدٍ","وَطَناً، وَغرّبَ وآخَرٌ ، فتَشَأمَا",34,"م",2,0],["غيثِ الورى من حاضر ومن باد","ذوي عارضٍ يمطر قبل الإرعاد",35,"د",1,0],["غَيثٌ أَغاثَ بِهِ المُهيمن خلقهُ","مُتَفضِلاً وَقَضى لَهُ بِقَضائِهِ",36,"ا",3,0],["غيث يغيث اللائذين وسيد","كم فاض عن كرم ببحر طام",37,"م",1,0],["غيث إذا ما الغيثُ ضَنَّ بمائه","ونواله يزرى على الدأْماءِ",38,"ا",2,0],["غيثٌ إذا يمم الطلابُ ساحتهُ","غيثُ من الجودِ يروي كل ظمآنِ",39,"ن",1,0],["غيث هَما جوده ما بعده عدم","ليث الشرى نحن منه الدهر في حرم",40,"م",1,0],["غَيثٌ خَصيبٌ وَعِزٌّ يُستَغاثُ","إِذا أَتاهُ طَريدٌ خائِفٌ وَأَلا",41,"ل",2,0],["غيث اذا استمطرت سحب نواله","اياك من طوفانها لا تغرق",42,"ق",1,0],["غيث المواهب والندى يهيم على","أفنان غض نباته ويجود",43,"د",1,0],["غَيْثِ الْو