0,"","https://poetry.dctabudhabi.ae/diwan/poem/122453","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204468","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34647","المتقارب"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113823","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120520","الطويل"],[5111,"غَيْمُ الْخَلِيجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212608",""],[5135,"زراعة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=202141",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5431,"ولكن طبعي بالغرام ملولُ","https://www.poetsgate.com/ViewPoem.aspx?id=189852",""],[5459,"غفوة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=202683",""],[5538,"عشق الحبيب وما هجر","https://www.poetsgate.com/ViewPoem.aspx?id=142631",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5809,"سجال","https://www.poetsgate.com/ViewPoem.aspx?id=205090",""],[5827,"اعمل على وأدِ الهوى في مهدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207776",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5956,"لمن تثور العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=181909",""],[5956,"سيذكرك ..‏","https://www.poetsgate.com/ViewPoem.aspx?id=182161",""],[5956,"شهيد فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192359",""],[5969,"طقوس العز","https://www.poetsgate.com/ViewPoem.aspx?id=198911",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["سَيَذكُروني إِن نَبا جانِبٌ","مِنَ العِدا وَاِنحَلَّ عَقدُ الزِمام",0,"م",1,0],["سَيَذكُرُني قَومي إِذا الخَيلُ أَقبَلَت","وَفي اللَيلَةِ الظَلماءِ يُفتَقَدُ البَدرُ",1,"ر",1,0],["سَيَذهَبُ أَقوامٌ كِرامٌ لِوَجهِهِم","وَتُترَكُ قَتلى وُرَّمُ الكَمَراتِ",2,"ت",1,0],["سَيَذكُرُني قَومي إِذا جَدَّ جِدُّهُم","وَفي اللَيلَةِ الظَلماءِ يُفتَقَدُ البَدرُ",3,"ر",1,0],["سَيَذكُرُ ما يَجري لَنا مِن وَقائِعٍ","مَشايِخُ تَبقى بَعدَنا وَعَجائِزُ",4,"ز",1,0],["سيذبُل هذا الخد وهو مورَّدٌ","ويكمَد هذا الطرف وهو كحيل",5,"ل",1,0],["سيذكُرهُ ذِكْرَ الطّرِيدِ محلَّهُ","عُرَى المُلْكِ مُنْحَلَّاً بهن المعاقدُ",6,"د",1,0],["سيَذهَلُ عن فُنونِ الرَّقْصِ هَمّاً","إذا رقَّصْتُ منه حَشَاً مَرُوعا",7,"ع",2,0],["سَيَذَّكَّرُ مَن يَخشى","وَيَتَجَنَّبُها الأَشقى",8,"ق",2,0],["سيذكر ملتقانا النيلُ يوماً","غداةَ تُعَدُّ أيام الصفاء",9,"ا",2,0],["سَيَذكُرُني قَومي إِذا الخَيلُ أَصبَحَت","تَجولُ بِها الفُرسانُ بَينَ المَضارِبِ",10,"ب",1,0],["سَيَذْكُرُنِي بِالشِّعْرِ مَنْ لَمْ يُلاقِنِي","وَذِكْرُ الفَتَى بَعْدَ الْمَمَاتِ مِنَ الْعُمْرِ",11,"ر",1,0],["سيذكرني الناسون يوم تشوكهم","شمائل من بعض الخلائق سود",12,"د",1,1],["سيذكرني الناسون يوم تروعهم","صنائع من ذكرى هواي شهود",12,"د",1,0],["سيذكرني الناسون حين تروعهم","صنائع من ذكرى هوايَ شهود",13,"د",1,0],["سيذكرني قومٌ لديك عهدتُهُم","يحبّون ظلّامين ضرّى وإيذائي",14,"ي",1,0],["سَيَذكُرُكُم بِالجَميلِ إِذا ما","نَأى وَأَرادَ القَضا بُعدَه",15,"د",2,0],["سَيذكُرُكَ الخَليفَةُ غَيرَ قال","إِذا هُوَ بالأُمورِ بَلا الرِجالا",16,"ل",2,0],["سَيَذهَبُ ما ضُمَّت عَلَيهِ أَكُفُّهُمُ","وَيَبقى لَهُم في الناسِ ذَمٌّ مُخَلَّدُ",17,"د",1,0],["سيذبل روض الشعر من بعد يومه","فلا عاش ذوايه ولا أخضر ذابله",18,"ل",2,0],["سيذكركَ الناسُ ذِكراً يسودُ","كما ذكرُ يوسفَ في مِصرَ ساد",19,"د",1,0],["سيذكر ما خلبتنا الصقور","وما ذكر الغار والسوسن",20,"ن",1,0],["سيذكره السلام إذا اضمحلت","قواعده وكاد بها يميل",21,"ل",1,0],["سيذكُر الناس والتاريخ منفعة","تفيض منه كغيثِ جدِّ هتانِ",22,"ن",1,0],["سيذكر العرب عبد اللَه ما لهجوا","باسم امرئ القيس أو باسم ابن ذبيان",23,"ن",1,0],["سيذكر الناسُ من فى مصرٍ صنائعَهم","ويظهر الدهرُ بعد اليوم ما كتموا",24,"م",3,0],["سيذكرني قومي إذا ضمني الثرى","ويقرع سمع الكائنات عويل",25,"ل",1,0],["سيذكرني روض به كنت بلبلا","اردد شعري والغصون تميل",25,"ل",1,0],["سيذهبُ القلبُ إن سافرتَ متَّبِعا","آثارض مِزهَرِكَ الرَّنَّانِ يا يَّادُو",26,"د",2,0],["سيذهب ذياك الطلاء وينجلي","لنا الوهم عرياناً بكل خلاء",27,"ا",2,0],["سيذكرُ من بانَ أوطانه","ويبكي المقيمين من لم يُقم",28,"م",1,0],["سيذكرنا منكم حجيج إذا أتى","لعمرة أو حج يقوم على البر",29,"ر",1,0],["سيذكر قوم بعد قوم صنيعه","وينبئ جيل عن صنائعه جيلا",30,"ل",2,0],["سَيَذْكُرُنَا الْخَلِيجُ غَدًا بِأنَّا","زَرَعْنَا النُّورَ آيَاتٍ وَصِدْقَا",31,"ق",2,0],["سَيُذْهِبُ الله هذا الْحُزْنَ يُبْعِدُهُ","وتُبْصِرُ الْقلْبَ بالْإِيْمانِ يَنْشَرِحُ",32,"ح",1,0],["سيذكرُني من الشعراءِ جيلٌ","كرمزٍ تزدهي فيه القصيدَهْ",33,"د",2,0],["سيذكر هذا الجيل اصدق شاعر","شدا في ضفاف الرافدين فأغربا",34,"ب",2,0],["سيذهبُ الداءُ لكن بعده محنٌ","حين الحياة علاها الظلمُ والكذبُ",35,"ب",1,0],["سيذكرني قومي اذا كنت ثاويا","وشعري اذا رمْت ُالأنامَ مراميا",36,"ي",2,1],["سيذكرهم قلبي كأحلى قصيدة","ولكنَّ طبعي بالغرام ملولُ",37,"ل",1,0],["سيَذكرُ الجيل بعد الجيل ملحمةً","كنّا بها أسطُرًا بالفخر مُنسابه ..",38,"ب",2,0],["سيذوق مر غرامها","وينوح في جنح السحر",39,"ر",1,0],["سَيَذُوبُ هَذَا السِّحْرُ وَالْعِطْرُ","وَيَجِفُّ هَذَا الثَّغْرُ وَالصَّدْرُ",40,"ر",1,1],["ِسيذكرُني قومي اذا قالَ شاعرٌ","بليغٌ بديعُ القولِ : هل من مُساجلِ؟",41,"ل",1,1],["سيذيقهم بعضَ الحلا لكنَّهُ","يخفي مَرَارًا خلفَهُ وهوانا",42,"ن",2,0],["سيذْكُرُنيْ التاريخُ والشعرُ شاهدٌ","ويهملُ غيري حين يمضي ويحْذِفُ",43,"ف",1,0],["سيذيعها الجيرانُ دون ملاطفَةْ","للناس والأسرار تمسي كاشفةْ",44,"ف",2,0],["سيذكركِ العشب والشجرُ","ويذكركِ النجم والقمرُ",45,"ر",1,1],["سيذكرك الشعب حراً أبياً","فسل دمعهُ هل يكفكف سكبا",46,"ب",2,0],["سَيذكُرُ أَهلَهُ وَصِحابَ عُمرٍ","وَطِفلَتَهُ التي تَرجو لِقاهُ",47,"ا",2,0],["سَيذكُرُ رَبَّهُ في كُلِ ظُلمٍ","وَيَذكُرُ شَيبَهُ وَكذا صِباهُ",47,"ا",2,0],["سَيَذْكُرُكَ الخَلِيفَة غَيْرَ قَالٍ","إذا هوفي الأمور بلا الرجالاَ",48,"ل",2,0],["سيذبلُ الوردُ في خدِّيكِ مكتئباً","إنْ لمْ تفيضي عليَّ اليومَ جدواكِ",49,"ك",1,0]]}