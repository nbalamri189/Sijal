{"poems":[[79,"ما غض مني أن أخلفت موعودي","https://www.aldiwan.net/poem36582.html","البسيط"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[90,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[74,"شكت وقد سارقتها قبلة","https://www.aldiwan.net/poem18625.html","السريع"],[74,"العيد أنت وهذا عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[53,"خدن أبي المستهل خبرني","https://www.aldiwan.net/poem8690.html","المنسرح"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[53,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[72,"مالي على الغبن قدره","https://www.aldiwan.net/poem42870.html","المجتث"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[58,"إن الرسول لم يزل يقول","https://www.aldiwan.net/poem58534.html","الرجز"],[64,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[50,"رأى بخديه منبتا زغبا","https://www.aldiwan.net/poem66278.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[168,"عفظير إنا اختلفنا","https://www.aldiwan.net/poem67829.html","المجتث"],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[173,"أبت لك العزة القعساء والكرم","https://www.aldiwan.net/poem1674.html",""],[325,"بنى النجيب أبو إسماعيل بهجتنا","https://www.aldiwan.net/poem61634.html","الكامل"],[333,"المجتث","https://www.aldiwan.net/poem55010.html","المجتث"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[409,"وأبله وافى إلى حضرتي","https://www.aldiwan.net/poem33940.html","السريع"],[482,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[534,"محب جفاني مرة ثم زارني","https://www.aldiwan.net/poem37351.html","الطويل"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[556,"أتاركي أتلافى اليأس بالأمل","https://www.aldiwan.net/poem47294.html","الطويل"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[563,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77663","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77651","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77611","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77539","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77673","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77601","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70837","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138105",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109255","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79808","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108757","البسيط"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130682","البسيط"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130678","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[2117,"","https://poetry.dctabudhabi.ae/diwan/poem/111328","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201750","المجتث"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112652","الرجز"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144910","السريع"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91485","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216781","الرجز"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135075","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136708",""],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33787","البسيط"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5616,"نسر","https://www.poetsgate.com/ViewPoem.aspx?id=203494",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""]],"verses":[["وقال قوْسُ عِذارٍ فوقَ صَفْحَتِهِ","سَفينَةُ الحُسْنِ قد حطّتْ على الجودي",0,"ي",1,0],["وقال قَوَلَةَ حَقٍّ أصبَحَتْ مَثَلاً","وأصَبَحَ الجيلُ بعدَ الجيلِ يَرويها:",1,"ي",3,0],["وقال قول الكلف المغرم","في حبّ ذات النظر الساحر",2,"ر",1,0],["وقال قوم رشفة أغضبت","فقلت هذي غضبةٌ بارِده",3,"ه",1,0],["وقالَ قوم بما قد نلت تقدمة","فقلت مذ أمر السلطان ديواني",4,"ن",2,0],["وقال قَدْ والإلهِ غَيَّبْتُ غُرْ","مُوليَ في فَرجها وفَقْحتِهِ",5,"ت",2,0],["وقال قولاً بغير معرفةٍ","إفكاً فما حلَّ إفكُهُ عُقَدَهْ",6,"د",2,0],["وقال قومٌ عَهِدْنا","كَ لا تُرامُ فتُغضي",7,"ض",2,0],["وقال قومٌ وما تعدَّوا","كأنه رأسُ شِيقبرقمْ",8,"م",1,0],["وَقالَ قَومٌ خَبَلَتهُ الطِلا","وَقالَ قَومٌ صارَ مَعتوها",9,"ه",2,0],["وَقالَ قَومٌ وَما لي","بِما يَقولونَ خِبرَه",10,"ر",2,0],["وقال قولا مقنعا","أثبت فيه ما ادّعى",11,"ع",2,0],["وقالَ قَدْ قَضَى إلهُكَ العَلي","بِأَنْ تُزَوَّجَ البَتُولُ بِعَلي",12,"ي",1,0],["وقال قوم جهلوا ال","حكمة ذا قول ردي",13,"د",2,0],["وقال قائلُهُم أسرفتَ من بطلٍ","ما كان أحسنه لو جَانَبَ السَّرَفا",14,"ف",2,0],["وَقالَ قَوْمٌ لَقَدْ أَحْصَى مَنالَهُمْ","وَقامَ فِيها بَمَفْروضِ وَمَسْنُونِ",15,"ن",1,0],["وقال قد صرتُ يا فتى رجلاً","وذا قبيحٌ أراهُ بالرجُلِ",16,"ل",1,0],["وقال قومٌ خالف الأترابا","وحالف الثراء والإترابا",17,"ب",2,0],["وقال قومٌ ذاك مُسلِمٌ نقِمْ","حكومةَ القرآنِ فهو منتقِمْ",18,"م",1,0],["وقال قضَى عبدُ العزيزِ ولم يكُنْ","نصيبُ امرىءٍ في الرِّزْءِ فوقَ نَصيبي",19,"ب",2,0],["وقَالَ قَفَوتُ الطَّرِيقَ الذي","به أمَرَ اللهُ أهلَ الصَّفَا",20,"ف",2,0],["وقال قضى أن ليس يعبد غيره","فمن شئت فاعبد فهو رب السما الأعلى",21,"ل",2,0],["وقال قضى ان ليس يعبد غيره","فمن شئت فاعبده تصب أو تصوب",22,"ب",1,0],["وَقالَ قَومٌ يُعَدّى","بِمُلتَقى الساكِنَينِ",23,"ن",1,0],["وَقالَ قَومٌ تَوَلّى المُلكَ مُنصَرِفاً","عَن أَهلِهِ وَكَذا الدُولاتُ تَنتَقِلُ",24,"ل",1,0],["وَقالَ قَومٌ تَوَلّى المُلكَ مُنصَرِفاً","عَن آلِ فَضلٍ لَقَد ضَلّوا وَقَد وَهِمُوا",25,"م",3,0],["وَقالَ قَولاً يُراعُ المَجدِ أَرخَهُ","هَذي السَرايَ لِإِبراهيمِ أَوجَ شَرَفُ",26,"ف",1,0],["وقال قلبي له","أيّان فقدُ المُنى",27,"ن",2,0],["وقال قولاً لهمُ ثانياً","ليَحْمَدوا في الدَّهر عُقْباه",28,"ا",2,0],["وقال قد أقلقني هزلهم","فقلت لا تهزل مع من يجد",29,"د",1,0],["وقالَ قومٌأذاعَ السرَّ بعدهمُ","وكنتُ لولا النوى في الحبَّ مؤتَمنا",30,"ن",2,0],["وقال قَليلٌ قُلْتُ عندي زيادةٌ","أضَفْتُ إليها ثُلْثَ سُبْع الذي مَضَى",31,"ض",2,0],["وقال قومٌ أعطى فقلتُ لكمْ","إِنْ كانَ أَعطى فطالما حرما",32,"م",2,0],["وقال قُدْنِي إلى ماشئتَ أسْعَ له","يا مالكاً مالكَ الأرقابِ والدُّوَلِ",33,"ل",1,0],["وقال قل له كذا","عني لفرط التحنين",34,"ن",1,0],["وقال قوم بأن الجسم ذلك ذو","طول وعرض وعمق قولُ أهلِ رَدى",35,"د",2,0],["وقال قوم إنما أوصاه","بأهله إذ جاءه قضاه",36,"ه",1,0],["وقال قوم نحن لسنا ندري","أوصاه أو لم يوصه بالأمر",36,"ر",1,0],["وقال قوم لم تكن وصية","منه إلى خلق من البرية",36,"ه",1,0],["وقال قوم لهم إدارة","أشار فيهم نحوه إشارة",36,"ه",1,0],["وقال قوم لم يكن أشار","ولم يكن أمر أن يختارا",36,"ر",2,0],["وقال قوم لم نكن ندري بما","كان النبي عند ذاك حكما",36,"م",2,0],["وقال قوم كان من أسامة","إليه قول وحكوا كلامه",36,"ه",1,0],["وقال قوم كان هذا لسبب","وزعموا بأنه كان ارتكب",36,"ب",1,0],["وقال قوم هذه الحكاية","كمثل قول الله في الولاية",36,"ه",1,0],["وقال قوم منهم قد شكا","إذ قبل الحكم وإذ تلكا",36,"ك",2,0],["وقال قوم حكم الكفارا","فأنجد الجهل بهم وغارا",36,"ر",2,0],["وقال قوم إنه استحقها","بعد الحسين إذ تولى حقها",36,"ه",2,0],["وقال قد مات وأوصى ولده","يريد عبد الله لما فقده",36,"ه",1,0],["وقال قوم منهم بل قد هلك","ولم يكن أوصى بما كان ترك",36,"ك",1,0],["وَقالَ قسمَة قَسمتموها","تِلكَ إِذاً ضيزي فَأَرجِعوها",37,"ه",2,0],["وَقالَ قُل لي يا اِبن وُدّي إِني","في نَغَص مِن صنعَتي وَفَني",38,"ي",1,0],["وَقالَ قَبلَ أَن نَروحَ نفطرُ","وَاِجتَمَع الناس بِهِ وَحَضَروا",39,"ر",3,0],["وَقالَ قَد رَأَيت في المَراعي","غَنيمَةً لَيسَ عَلَيها راعي",40,"ي",1,0],["وَقالَ قَد سَمعت ما تَقول","وَشاهدي مِن جسميَ النُحولُ",41,"ل",1,0],["وَقالَ قَوم عَسَس لَنا اِفتَحوا","قالوا لَهُ رَأيك لَيسَ يفلح",42,"ح",1,0],["وقال قولا صحيحا في المقالةِ لو","بقوله قال ذو البهتان قلْ صَدَقا",43,"ق",2,0],["وقال قم فالدجى قد حان مصرعه","بادر صبوحك ان الديك دعّاء",44,"ا",2,0],["وَقالَ قَول وَاله كَئيب","شر الخلال بغضة الغريب",45,"ب",1,0],["وَقالَ قُل للملك العَظيم","قَد تبت مِن مَقالي الأَثيم",45,"م",1,0],["وقال قولي لم ينطق به بشرٌ","نعم فقد قلت عنه أنه صدقا",46,"ق",2,0],["وقال قولي ما أشدّ الحرا","بالنصب في الدال الثقيل والرا",47,"ر",2,0],["وقال قوم تسقط المصرعّه","وهو حر من دونها أن تتبعه",48,"ه",1,0],["وقال قفي يا نفسُ وقفةَ واردٍ","حياضَ الردى لا وقفة المتردّدِ",49,"د",1,0],["وقال قولتهم لا عاش من غضب ال","والي عليه وعن إرضائه امتنعا",50,"ع",2,0],["وقال قد سار فادع اللّه يحفظه","فقلت لي في البكا عن ذا كم شغل",51,"ل",1,0],["وقال قوم دع الشكوي فما هجرت","الا لقتلك او صدت بلا سبب",52,"ب",1,0],["وقال قومٌ له تمرٌ فجوزه","وذاك شرطم ورأيٌ فيهما ضعفُ",53,"ف",1,0],["وقال قوم بل له شروط","ثالثها العود به مخلوط",54,"ط",1,0],["وقال قائلٌ فقد تكونُ","قُرَّتُها بها فشىءُ هَونُ",55,"ن",1,0],["وقال قوم هو النثر","صاغه الفكر نظما",56,"م",2,0],["وقال قوم بمحو اللّه من صحف","ما شا ويبعث ما يخار من كلم",57,"م",1,0],["وقالَ قد هوّنَ مابي نَزَلا","كانَ بعينِ اللَهِ جلا وعلا",58,"ل",2,0],["وقال قوم قد غدا شاعراً","والشعر لا يعرف للمفحم",59,"م",1,0],["وقال قوم انها تسمى","جميع ما تبصره من نجم",60,"م",1,0],["وقال قوم لم يقولوا كذبا","ان الاعاريب تسميها الخبا",60,"ب",2,0],["وقال قوم بامتناع الوقف","في اللفظة الأولى فتابع وصفي",61,"ي",1,0],["وَقال قائلُهم وَالمَوتُ يَطلبُهُ","ما لي بِعاديةِ الأَيّام مِن قِبَلِ",62,"ل",1,0],["وَقال قومٌ لواحٍ لا خَلاقَ لهم","اسْلُ المُنائينَ وَاخْلِ القَلبَ عن كدر",63,"ر",1,0],["وقال قل للصاحب الصديق","لا يكسر المرآة بالتحديق",64,"ق",1,0],["وقال قلبك معتل فقلت له","للغير حقا واما في هواك فلا",65,"ل",2,0],["وقال قد أسرفت في الأكل ولم","يَسمع وألوى الشيخُ من أعجابه",66,"ب",2,0],["وَقالَ قَد خَصَّني حَبيبي","بِنِعمَةٍ ما لَها ثَوابُ",67,"ب",1,0],["وقال قائدهمْ إنا لمهلكهم","جئنا ولن نكتفي منهم بسفك دم",68,"م",1,0],["وقال قد قام طليق لنا","مرغِّباً ومرهِباً سيطرا",69,"ر",2,0],["وقال قولة ذي غيظ وذي حنق","والغيظ للنفس من أعدى عواديها",70,"ي",3,0],["وقال قد بلغت بي الحال ما بلغت","وأنت تدرين من حال أقاصيها",70,"ي",3,0],["وقال قم فأت هذا الخلق تنذرهم","فعقلهم عن سراج الحق معقول",71,"ل",1,0],["وقال قائلهم هوَّن عليك أسى","فقلتُ دعْني وشأني يرعْكَ الله",72,"ه",1,0],["وقال قولة طفلٍ طالما صَدَقَتْ","كطائرٍ يزفر النايات والصُّعَداً :",73,"د",2,0]]}