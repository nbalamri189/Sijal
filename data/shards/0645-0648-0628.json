{"poems":[[52,"يا مالك الناس في مسيرهم","https://www.aldiwan.net/poem64869.html","المنسرح"],[190,"لو رأى الناس مسير ال","https://www.aldiwan.net/poem43863.html","مجزوء الرمل"],[325,"يا خبرا قد رن فينا وطن","https://www.aldiwan.net/poem61658.html","الطويل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103094","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108492","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[4764,"طفل الرصيف","https://www.poetsgate.com/ViewPoem.aspx?id=30574",""],[4902,"ما قلت أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=4948",""],[5168,"حجتلي شكد عليك","https://www.poetsgate.com/ViewPoem.aspx?id=33617",""],[5608,"العيد من دونه","https://www.poetsgate.com/ViewPoem.aspx?id=33322",""],[5815,"تَكَهّفْ","https://www.poetsgate.com/ViewPoem.aspx?id=192613",""],[5889,"قلب المحب لحبه ثمن","https://www.poetsgate.com/ViewPoem.aspx?id=212598",""]],"verses":[["مُؤَبَّدُ البَيتِ وَالقَرارَةِ وَال","تَلعَةِ في عُجمِهِ وَفي عَرَبِه",0,"ب",2,0],["موبقات واضحات","مثبتات كالسطور",1,"ر",1,0],["مُؤَبَّدُ الأَبعادِ عَن خِدمَةٍ","كانَ لَهُ فيها عَظيمُ المِنَنِ",2,"ن",1,0],["مُؤبَذُ نارِ قُدسِها المَعنى الَّذي","لِقَّبَهُ الحِكمَةِ بِالهِندِ اِعتَمَر",3,"ر",1,0],["مؤبد في بقاء ما له أمل","معمر في زمان دوره حُقُب",4,"ب",1,0],["موبير يا نذل الرجال ظلمتني","وحسبت ما فعلت يداك قليلا",5,"ل",2,0],["مؤبد تختال في","حَلْي الثناء والحلل",6,"ل",1,0],["مو بكيفي ،، وربنا ، قلبٍ عطانا","والزمن يضمر ،، واعصاره كثيف",7,"ف",1,0],["مو بس أحبك أنا والله من حبك","أحب حتى ثرى الأرض اللي تطاها",8,"ا",3,0],["مو بيدي احبك خل يكولون","حذرنه شكثر بس ما تحذر",9,"ر",1,0],["مو بس احبه .. واعشقه سيد الغيد","أحب حتى النوم .. لا غطه اجفونه",10,"ن",2,0],["مَوْبُوءٌ يَمْتَصّ دِمَائِي","يَتَوَارَى في سَقْفِ الدَّارِ",11,"ر",1,0],["موبوءة وأنا بها كلِفٌ","قلبُ المحبِّ لحبِّهِ ثَمنُ",12,"ن",1,0]]}