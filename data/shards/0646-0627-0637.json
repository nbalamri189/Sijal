{"poems":[[55,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"يا شريفا لقرنه إشراف","https://www.aldiwan.net/poem65478.html","الخفيف"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[87,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[54,"قل لمشيبي إذ بدا","https://www.aldiwan.net/poem26784.html","مجزوء الرجز"],[50,"دعت الهموم إلى شغاف فؤادي","https://www.aldiwan.net/poem62563.html","الوافر"],[15,"بان الخليط الؤولى شاقوك إذ شحطوا","https://www.aldiwan.net/poem45261.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54913","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[108,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[354,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[369,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[409,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[438,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[449,"ناظم الفضل النا قد غدونا","https://www.aldiwan.net/poem56023.html","عموديه"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[469,"ما جماد يفيد مالاً وعدماً","https://www.aldiwan.net/poem3460.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122309","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119893","المنسرح"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96208","الكامل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119216","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[3005,"","https://poetry.dctabudhabi.ae/diwan/poem/34710","الرجز"],[3378,"","https://poetry.dctabudhabi.ae/diwan/poem/203985",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35067","الكامل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21406","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131221",""],[4788,"خلاص جزنا من المحبه وتبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132246",""],[835,"بات ساجي الطرف والشوق يلح","https://www.poetsgate.com/ViewPoem.aspx?id=40614",""]],"verses":[["ناطِحَةً بِالجُمِّ هامَ القِرنِ","نِطاحَ رَوقِ الجازِىءِ الأَغَنِّ",0,"ن",1,0],["ناطح الأيِّل المقرَّن والكب","ش مع الكركدن ليس تخافُ",1,"ف",1,0],["ناطقا بالبرهان في حق مصر","ولقد كان قاطعا برهانك",2,"ك",1,0],["ناطَحَ النَجمَ فَتىً عَلَّمتُهُ","في حَياةٍ حُرَّةٍ كَيفَ النِطاح",3,"ح",1,0],["ناطِقَةٍ لَكِنَّها","كاسِفَةٌ لا تَنطِقُ",4,"ق",1,0],["ناطَت بِعاتِقِها الوِشاحَ كَما تَرى","بَطَلاً يُحاوِلُ نَجدَةً بِنِجادِ",5,"د",1,0],["ناطوا الرِعاثَ لِمَهوىً لَو يَزِلُّ بِهِ","لَاِندَقَّ دونَ تَلاقي اللَبَّةِ القُرُطُ",6,"ط",1,0],["نَاطَ الفُؤَادَ مَنَاطاً لاَ يُلاَئِمُهُ","حَيَّانِ دَاعٍ لإِصْعَادٍ ومُنْدَفِعُ",7,"ع",1,0],["نَاطَ بِالعَقلِ أَمرَهُ كُلَّهُ وَالعَقلُ","خَيرٌ فِي كُلِّ حَالٍ مُشِيرَا",8,"ر",2,0],["ناطَتْ رجَاءً بِهِ مِصْرٌ فحَقَّقَهُ","قَبْلَ اْلأَوَانِ بِصِدْقِ العَزْمِ وَالنَّظَرِ",9,"ر",1,0],["ناطقة بالصواب، إن سُئِلَتْ","إن قلتُ: كم؟ لم تَنْقُصْ ولم تزد",10,"د",1,0],["ناطِقٌ صامِتٌ مُبينٌ مُعمى","ساتِرٌ كاشِفٌ قَريبَ نائي",11,"ي",1,0],["ناط الإمامُ بسَعْيهِ وبرأيِه","أَمراً بقاصيةِ السّعادةِ مُؤْذِنا",12,"ن",2,0],["ناطقاً عن فصاحة وبيان","كاشفاً للدقائق الفلسفيه",13,"ي",2,0],["ناطقٌ بالصوابِ إن أخطأ القو","مُ مُبينٌ إن أشكلَ التحقيقُ",14,"ق",1,0],["ناطم العدل والمحامد أنا","مسنا الضر والظلوم استطالا",15,"ل",2,0],["ناطوا بك الأمرَ فما","ليموا ولا تألّموا",16,"م",3,0],["ناطقةً في الصُّحْف عن آياتها","على البعاد صامتاتٍ قُوَّلا",17,"ل",2,0],["ناطوا بها وقد التوت منشورةً","من حسن رأيك ساعداً وقبالا",18,"ل",2,0],["ناطوا منازلهم بالهُضْب نازِحةً","فقطّعوا وحشةً من قلبي النَّيَطا",19,"ط",2,0],["ناطقاتٌ بكلّ معنى يضاهي","نكت السحر في عيون الملاح",20,"ح",1,0],["ناطقٌ وهو صامتٌ يهبُ ال","مال جزيلاً ويمنح الوقلُ جزلا",21,"ل",2,0],["ناطَ أَبطال الجُنودِ","وَهمُ أَبناء مصرِ",22,"ر",1,0],["ناطقاً عني بالفضل الذي","ان يبارى فله في الفوز قدح",23,"ح",1,0],["ناط الامور الأمام منه إلى","طَبَّ مادواء مثلهم ماهرُ",24,"ر",1,0],["ناطوا بمعقد خصره","سيفا ومنطقة تؤوذه",25,"ه",1,0],["ناطَ أَمرُ الضِعافِ وَاِجتَعَلَ اللَي","لُ كَحَبلِ العادِيَّةِ المَمدودِ",26,"د",1,0],["ناط الحمائل في ليث وفي قمر","وفي الحمائل قد نيطت به الهمم",27,"م",1,0],["ناطت ببدر الدين من آياتها","ما لا تضيق بهمة هماته",28,"ت",2,0],["ناطِقَةٍ وَما أَحارَت نُطقا","تُخبِرُ عَن حُبٍّ لَهُ اِستَرقا",29,"ق",2,0],["ناطق عن جميع أع","ضاءها شاهد الكبر",30,"ر",1,0],["ناطقات صوامت وسواري","قائمات وغيب حضار",31,"ر",1,0],["ناطوا أُمورَهُمُ بِأَمرِ أَخٍ لَهُم","فَرَمى بِهِم قحمَ الطَريقِ اللاحِبِ",32,"ب",1,0],["ناطوا إِلى قَمَرِ السَماءِ أُنوفَهُم","وَعَنِ التُرابِ خُدودُهُم لا تُرفَعُ",33,"ع",1,1],["ناطوا الوسام بصدره فاستكبرا","ومشى الهوينى عابساً متنمرا",34,"ر",2,1],["ناطى على غاربه ويذوق غبنا","وليا سلم من ناب يبشر له بناب",35,"ب",1,0],["ناطق عني بالفضل الذي","إن يبارى فلهُ في الفوزِ قدحُ",36,"ح",1,0]]}