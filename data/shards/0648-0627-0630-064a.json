{"poems":[[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[95,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[85,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[87,"آشيم يا من بحبه نعلو","https://www.aldiwan.net/poem7804.html","المنسرح"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[52,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54895","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[92,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[132,"صب تحرقه أسى لرعاته","https://www.aldiwan.net/poem50654.html","الكامل"],[136,"بذات الدخن أدورة بوال","https://www.aldiwan.net/poem54764.html","الوافر"],[201,"أوقديها وذريها في حشايا","https://www.aldiwan.net/poem39942.html","الرمل"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[262,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[325,"اشكر لتوكيل البحيرة مصطفى","https://www.aldiwan.net/poem67205.html","الكامل"],[411,"كأنما النيلوفر الغض إذ","https://www.aldiwan.net/poem49559.html","السريع"],[415,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[435,"عوفي الندى والمجد والأدب","https://www.aldiwan.net/poem40710.html","أحذ الكامل"],[469,"سلوا بالحمى أين الظباء السوانح","https://www.aldiwan.net/poem3587.html","عموديه"],[563,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[580,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[599,"","https://poetry.dctabudhabi.ae/diwan/poem/100444","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122672","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203688","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64883","الهزج"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101044","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[2067,"","https://poetry.dctabudhabi.ae/diwan/poem/198243","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137960",""],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131732",""],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102394","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45257","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91793","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111489","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101371","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18828","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4478,"باتتْ لعينكَ عبرة ٌ وسجومُ","https://www.poetsgate.com/ViewPoem.aspx?id=15134",""],[5210,"جدد التذكار للصب المعنى","https://www.poetsgate.com/ViewPoem.aspx?id=169360",""],[5353,"مخاض من الغيظ","https://www.poetsgate.com/ViewPoem.aspx?id=214898",""],[5419,"لويُنسى شعري","https://www.poetsgate.com/ViewPoem.aspx?id=35572",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[402,"إلى أهلها تنعى النهى والعزائم","https://www.poetsgate.com/ViewPoem.aspx?id=36218",""],[402,"وَغايَةُ الرّوح طَيَّ الرّوح قَد خَفيت","https://www.poetsgate.com/ViewPoem.aspx?id=5534",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[5957,"فراشة النبع(هديل)","https://www.poetsgate.com/ViewPoem.aspx?id=204890",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[6033,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215798",""],[6102,"وَ هُوَ المَطلُوب !!","https://www.poetsgate.com/ViewPoem.aspx?id=185324",""],[201,"أوقديها وذريها في حشايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65300&r=&rc=9",""],[6315,"بيروت وأحاديث العرَّاف ... قراءة لأقداح الأنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87583&r=&rc=8",""],[6344,"مُرافعةُ مِصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87962&r=&rc=2",""]],"verses":[["وَأُذيقُها طَعناً تَذِلُّ لِوَقعِهِ","ساداتُها وَيَشيبُ مِنهُ رَضيعُها",0,"ع",3,0],["وَإِذ يُبرِىءُ القَرحى المِراضَ حَديثُها","وَتَسمو بِأَسماءَ القُلوبُ الصَحائِحُ",1,"ح",1,0],["وَإِذ يَتَحاكَمُ الساداتُ طُرّاً","إِلى أَبياتِنا وَذَوُو الحُقوقِ",2,"ق",1,0],["وَإِذْ يَفِدُ الضَّيفَانُ مِنْ كُلِّ جَانِبٍ","إِلَيْهَا يُلاقِي بَارِحَ الرَّكْبِ قَادِمُ",3,"م",1,0],["وإذي تيدان تشبيه","فتقول عنّه وصائف",4,"ف",1,0],["وأذيع شكواه وإن لم يُشكِنِي","إنزارُهُ صَفَدِي ولا إيتَاحُه",5,"ح",2,0],["وإذ يدب الغرام مجتهدا","ونحن لا فكرة ولا عقل",6,"ل",1,0],["وآذى زجارَ فَتْح رَيّو وقُطْرُها","يَهُدّ قُوَاهُ من صقليّةٍ قطرُ",7,"ر",1,0],["وَإِذ يُصبِحُ الغَيرانُ تَغلي قُدورُهُ","عَلَينا وَإِذ غُصنُ الشَبابِ رَطيبُ",8,"ب",1,0],["وَإِذْ يَرَى أَبْعَدَ مَجْدٍ عَلَى","أَدْنَى مَدىً مِنْ فِكْرِكَ الوَاسِعِ",9,"ع",1,0],["وَإِذْ يَنْجَلِي نِبْرَاسُهَا ثمَّ يَخْتَفِي","فَآناً لهُ زهْوٌ وَآناً يُكوِّرُ",10,"ر",1,0],["وَإِذْ يَثِبُ الفِكْرُ الْبَطِيءُ فَيَرْتَقِي","إِلى الأَوْجِ لاَ يَثْنِيهِ عَنهُ لُغُوبُ",11,"ب",1,0],["وإذ يستقلُّ بِضَبْعِي فتىً","يَرى الغُنْمَ في العيش كسب الثنا",12,"ا",1,0],["وإذْ يُركِبُ النَفْسَ حَدَّ الرَّدى","عِنانٌ من الشرِّ لا تُكبَح",13,"ح",1,0],["وإذْ يعْصُرُ القلبَ حُبُّ الحياة!","وكأبوسُ حِرمانها المُفْدِح",13,"ح",1,0],["وأُذيبَ قلبَ الحاسدين بمدحكم","وأُذِلَّ مَن لعبت به شبهاتُه",14,"ت",2,0],["وأذيَالُ الرَّوَامِسِ عُوِّضَتهَا","مِن أذيَالٍب لِرَبَّاتِ الحِجَالِ",15,"ل",1,0],["وأذى الناسِ وأوصابُ الصدى","لا تُعيريها اهتِماماً وازدَريها",16,"ه",2,0],["وأذيقَهمْ كأسَ المنِيْ","يَة بالغُدُوِّ وبالعَشِيّه",17,"ي",2,0],["وَإِذ يَكادُ حُسنُ المَكانِ البَهيج","أَن يُحيينا",18,"ن",2,0],["وَأُذيعَ ذِكرُكَ عاطِراً أَظَهَرَتهُ","بِالجِدِّ حَتّى صارَ أَشهَرَ مَن قَفا",19,"ف",2,0],["وإذْ يُراعي طلعَةَ الشَّمسِ كي","يفتحَ أحداقاً من التِّبْرِ",20,"ر",1,0],["وأُذِيلَنّ دُموعاً لو رأتْ","فَيضَهُنَّ المزنُ خَالَتْهُنَّ مُزْنَا",21,"ن",2,0],["وأُذيلت الأعراض عن قمرٍ","عن أفق قلبي ليس ينجب",22,"ب",1,0],["وأذيالَ معطارٍ تمسّكتِ الرّبى","بهنَّ وهذا نشرها المتفاوح",23,"ح",1,0],["وأذيعوا السر واكتتموا","صرتُ في الأعتاب مرتميا",24,"ي",2,0],["وأُذيقُهم هَجْراً وأُس","مِعُهم من الكلماتِ هُجْرَا",25,"ر",2,0],["وأذيق العصاة جر عذاب","واستحقوا المصير للنيران",26,"ن",1,0],["وأذيعُ نِعمَتَكَ الَّتي لَو أخفيَت","كانَت كَمُنبَلَجِ الصَّباحِ طُلوعا",27,"ع",2,0],["وأذيالَ ليلٍ طويل قَذِرْ","ويسمع من راح يشكو الصمّمْ...",28,"م",1,0],["وإِذْ يُسكرنُي ريقُ","كَ مِنْ خَمْرِتِهِ الصِّرفِ",29,"ف",1,0],["وإذ يدعو العشيرة يوم جمع","لينذر في رسالته الأناما",30,"م",2,0],["وإذ ينقضي النسيب كهذا","فتخلّص للقصد وهو الثناء",31,"ا",2,0],["وأذيالُه فوقَ الكَواكبِ تُسحَبُ","إلى أن تبَدَّت رايَةُ الفَجرِ تزحفُ",32,"ف",1,0],["وإذ يقول لي العواد إذ حضروا","لا تأس أبشر أبا حبان لا تاسى",33,"س",2,0],["وأذيعوا في الخافقين صداها","يذرعُ البرَّ ثم يجتازُ بحره",34,"ر",2,0],["وأذيت الخلق وما","كان لي حاجه يأسي",35,"س",2,0],["وَأَذى كُلِّ حاسِدٍ وَمُعادِ","لَسْتُ أنْسَى الْحُسَيْنَ حينَ يُنادي",36,"ي",1,0],["واذ ينادى فلان كنت تأمرنا","ايضا وتزجرنا عن سيىء الجرم",37,"م",1,0],["وإذ يتجنين الذنوب ومالنا","اليهن إلا ودهن ذنوب",38,"ب",1,0],["وَإِذ يَقولونَ لَيتَ اللَهُ يُهلِكُهُم","وَاللَهُ يَعلَمُ لَو زِلَّت بِهِم قَدَمُ",39,"م",1,0],["وَإِذ يَعتلُّ في رَوضٍ نَسيمٌ","أَرى أَنّ اغتنام الأُنس صحّا",40,"ح",2,0],["وَأُذِيسُ ثَمَّةَ كُلَّما قُتِلَ امرُؤٌ","عقَبِيهِ يَقبِضُ وَالطَّرِيقَ يُوَسِّعُ",41,"ع",1,0],["وَأُذِيسُ حَلَّ الخَيلَ يَقرِنُها بِمض","مَدِها وَجَدَّ بها يَسيرُ وَيُقلِعُ",41,"ع",1,0],["وَاُذِيسُ ذَيَّاكَ الهُمَامُ أَخُو النُّهَى","مَن لاِختِراقِ سُرَى العُدَاةِ تَحَدَّما",42,"ا",1,0],["وأُذِيسَ مِريُونٌ أعارَ سِلاحَهُ","قَوساً وجُعبَتَهُ وَسَيفاً مِخذَما",42,"ا",1,0],["وأَذِيساً وفُرسُفِينا تُنَادي","أَن يُذِيقا ابنَها حِماماً أَشَرَّا",43,"ا",1,0],["واذيال المعاسير الحيارى","بها كم لاذ أرباب الثراء",44,"ا",2,0],["وأذيعَ ذِكرُك في البلاد وفي ال","زيزاء حيث يُرَنّ‍َح الأَثلُ",45,"ل",1,0],["وأذى الفتنتين يدفع عنى","اذ برمسى خلوت عن مجتاز",46,"ز",1,0],["وأذى فراخ ضاق بي أوكارها","وكذا البغاث كثيرة الأولاد",47,"د",1,0],["وأذى خراج لو سرى لأدائه","غرر الليالي عدن وهي دآدي",47,"د",2,0],["وَأَذَيتِهِ زَمَناً فَعادَ بِحِلمِهِ","إِنَّ المُحِبَّ عَنِ الحَبيبِ حَليمُ",48,"م",1,0],["واذيقه من حز هذا القول ما","ينفي حزازة قلبه المتقطع",49,"ع",1,0],["وأذيتهِ زمناً فعادَ بحمله","أنَّ المحبَّ عن الحبيب حليمُ",50,"م",1,0],["وأذيعن هواكم شاكيا","للذي شاد العلى والفخر سنا",51,"ن",2,0],["وإذ يستحي السّيفُ حيناً يُرَاح ْ","وفي قبضهِ الموتُ غِلٌّ وغَمْ",52,"م",1,0],["وأذيبي روحَكِ في روحي","لتجيدَ عيونُكِ تهدئتي",53,"ت",2,0],["وإذ يلاقي الراءَ بيَِن ذا وذا","في مثل ذَرْ ونذرتُ للرحمنِ",54,"ن",1,0],["وأذيب المنى بأدمع عينٍ","كحّل الوجد جفنها إسقاما",55,"م",2,0],["وإذ يفد الضيفان منك جانب","إليها يلاقي بارح الركب قادم",56,"م",1,0],["وَإِذ يَقولُ هِيَ الأَجسامُ إِن هَجَعَت","لَم يَبقَ في الرّوحِ تَهويمٌ وَلا سَمَرُ",57,"ر",1,0],["وآذيتِ الذي يَهواكِ حتّى","تَخيّلْتِ الغَرامَ غَدَا غَريما؟",58,"م",2,0],["وإذ يفوه الثغرُ في ذكرها","يفوح من إذكارها العنبرُ",59,"ر",1,0],["واذيه سُواته هذاك الغلام","من خان دينه مب ظني دينه ثبت",60,"ت",1,0],["وأُذيقها كأساً عصرتُ مدامَها","مِنْ أعذبِ الأعنابِِ والإطراء؟",61,"ا",2,0],["وَ أُذِيعُ بَينَ النَّاسِ : ( إِنِّي غالِبٌ )","وَ أَنا - وَ يَعلَمُ رَبُّنا - مَغلُوبُ",62,"ب",1,0],["وأذى الناس وأوصاب الصدى","ولا تعيريها اهتماما وازدريها",63,"ا",1,0],["وإذ يَعْبُرُ العرَّاف رؤياي قابضاً","على جمرة التأويل .. يستبطن العُمرا",64,"ر",2,1],["وَأُذِيبُ شَمْعِيَ كُلَّمَا انْطَفَأَتْ","تَلْوِيحَةُ الإِصْبَاحِ فِي حَدَقِي",65,"ق",2,0]]}