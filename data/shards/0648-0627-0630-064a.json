{"poems":[[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[35,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[85,"آشيم يا من بحبه نعلو","https://www.aldiwan.net/poem7804.html","المنسرح"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[50,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54895","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""]],"verses":[["وَأُذيقُها طَعناً تَذِلُّ لِوَقعِهِ","ساداتُها وَيَشيبُ مِنهُ رَضيعُها",0,"ع",3,0],["وَإِذ يُبرِىءُ القَرحى المِراضَ حَديثُها","وَتَسمو بِأَسماءَ القُلوبُ الصَحائِحُ",1,"ح",1,0],["وَإِذ يَتَحاكَمُ الساداتُ طُرّاً","إِلى أَبياتِنا وَذَوُو الحُقوقِ",2,"ق",1,0],["وَإِذْ يَفِدُ الضَّيفَانُ مِنْ كُلِّ جَانِبٍ","إِلَيْهَا يُلاقِي بَارِحَ الرَّكْبِ قَادِمُ",3,"م",1,0],["وإذي تيدان تشبيه","فتقول عنّه وصائف",4,"ف",1,0],["وأذيع شكواه وإن لم يُشكِنِي","إنزارُهُ صَفَدِي ولا إيتَاحُه",5,"ح",2,0],["وإذ يدب الغرام مجتهدا","ونحن لا فكرة ولا عقل",6,"ل",1,0],["وآذى زجارَ فَتْح رَيّو وقُطْرُها","يَهُدّ قُوَاهُ من صقليّةٍ قطرُ",7,"ر",1,0],["وَإِذ يُصبِحُ الغَيرانُ تَغلي قُدورُهُ","عَلَينا وَإِذ غُصنُ الشَبابِ رَطيبُ",8,"ب",1,0],["وَإِذْ يَرَى أَبْعَدَ مَجْدٍ عَلَى","أَدْنَى مَدىً مِنْ فِكْرِكَ الوَاسِعِ",9,"ع",1,0],["وَإِذْ يَنْجَلِي نِبْرَاسُهَا ثمَّ يَخْتَفِي","فَآناً لهُ زهْوٌ وَآناً يُكوِّرُ",10,"ر",1,0],["وَإِذْ يَثِبُ الفِكْرُ الْبَطِيءُ فَيَرْتَقِي","إِلى الأَوْجِ لاَ يَثْنِيهِ عَنهُ لُغُوبُ",11,"ب",1,0],["وإذ يستقلُّ بِضَبْعِي فتىً","يَرى الغُنْمَ في العيش كسب الثنا",12,"ا",1,0],["وإذْ يُركِبُ النَفْسَ حَدَّ الرَّدى","عِنانٌ من الشرِّ لا تُكبَح",13,"ح",1,0],["وإذْ يعْصُرُ القلبَ حُبُّ الحياة!","وكأبوسُ حِرمانها المُفْدِح",13,"ح",1,0]]}