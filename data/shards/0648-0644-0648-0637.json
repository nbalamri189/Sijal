{"poems":[[90,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[29,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[53,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"ولوطي قدام وخلف عذلته","https://www.aldiwan.net/poem65479.html","الطويل"],[87,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[51,"ألا من لنفس في الهوى قد تمادت","https://www.aldiwan.net/poem10840.html","الطويل"],[77,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"غدا رمضاني ليس عني بمنقض","https://www.aldiwan.net/poem22643.html","الطويل"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[70,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[70,"شربنا على ذكرِ الحبيبِ مدامة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15405&r=&rc=11",""],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[203,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[230,"ألا يا تجار العصر هل فيكم امرؤ","https://www.aldiwan.net/poem55093.html","الكامل"],[234,"غدا عامر الأوطان في مقلتي قفرا","https://www.aldiwan.net/poem51110.html","الطويل"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[253,"اغالط مهما سميت ام خالد","https://www.aldiwan.net/poem1318.html",""],[266,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[445,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[484,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[541,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[563,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122619","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122641","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77595","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70676","الطويل"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19941","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62691","المتقارب"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105448","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96743","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27884","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93643","الوافر"],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134214","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99457","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74213","الوافر"],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62772","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129339","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118009","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3979,"","https://poetry.dctabudhabi.ae/diwan/poem/114845","المتقارب"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105145","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4618,"","https://poetry.dctabudhabi.ae/diwan/poem/203978","الطويل"],[4739,"إحساس العالم","https://www.poetsgate.com/ViewPoem.aspx?id=28037",""],[4750,"عيد الله عليك يعود","https://www.poetsgate.com/ViewPoem.aspx?id=180443",""],[4859,"صفو العمر!","https://www.poetsgate.com/ViewPoem.aspx?id=207686",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5246,"إذا لم يساعدني لإسعاف صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=187057",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5431,"لقد آنس الأرواح حزنٌ مقعرُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198970",""],[5433,"الطريق المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=36118",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5848,"يامرحبا باالموت في الفلوجه","https://www.poetsgate.com/ViewPoem.aspx?id=53206",""],[5938,"لقد عرفتك الحادثات نفوسها","https://www.poetsgate.com/ViewPoem.aspx?id=181420",""]],"verses":[["ولو طلَبت نفسي الغنى بامتهانها","لأصبحتُ في المثرين أطولهم يدا",0,"د",2,0],["وَلَو طَرَقَ الزُبَيرُ بَني عَلِيٍّ","لَقالوا قَد أَمِنتَ فَلَن تُكادا",1,"د",2,0],["ولو طال مدحي فيه وانكدَّ لم تجز","إطالتي المكتوبَ من حسناتِهِ",2,"ت",2,0],["وَلَوْ طَعِمَتْ في عطْفِه وَوِصَالِهِ","أبَاحَتْهُ منْها مَرْشفاً لا يُصَرَّدُ",3,"د",1,0],["ولوطيِّ قُدَّامٍ وخلفٍ عذلته","فقال أخو العوجاء قولاً مثقفا",4,"ف",2,1],["وَلَو طَلَعوا عَلَيها عالَجوها","بِهِمَّةِ أَنفُسٍ عَظُمَت مُرادا",5,"د",2,0],["وَلَو طَلَبتُ سِوى نُعماكَ لي لَجَأً","لَظَلتُ أَطلُبُ شَيئاً غَيرَ مَوجودِ",6,"د",1,0],["وَلَو طابَ لي غَرسي لَطابَت ثِمارُهُ","وَلَو صَحَّ لي غَيبي لَسَحَّت شَهادَتي",7,"ت",2,0],["ولوْ طَعَنَتْ قبلَ الرّماحِ أكُفُّهُمْ","ولوْ سَبَقَتْ قبل الأكفّ المَعاصمُ",8,"م",1,0],["ولو طُلِبَتْ في الغيثِ منكَ سجيّةٌ","لقد عَزّ موجودٌ وعزّ وُجود",9,"د",1,0],["وَلَو طارَ جِبريلٌ بَقِيَّةَ عُمرِهِ","عَنِ الدَهرِ ما اِسطاعَ الخُروجَ مِنَ الدَهرِ",10,"ر",1,0],["ولو طَرِبَ الجَمادُ لكَانَ أوْلى","شُرُوبِ الرّاحِ بالطّرَبِ الدّنانُ",11,"ن",1,0],["ولو طَلَعَ الصّباحُ لفُكّ عنه","مِن الظّلْماءِ غُلُّ أو صِفادُ",12,"د",1,0],["ولو طَرَحُوا في فَيءِ حائطِ كَرْمِها","عليلاً وقد أشفى لفَارَقَهُ السّقم",13,"م",1,0],["ولو طريقُ حبّه","على القتاد والظُّبا",14,"ب",2,0],["ولو طاوَعْتَهُنّ لَجِئْنَ يوْماً","بأُخْتِ الغُولِ والنَّصَفِ الضِّفَنّه",15,"ن",2,0],["وَلَو طابَتِ الأَيّامُ بَعدَ مَذاقهُ","لَما شَرِبَت لِلحرِّ بَعد ليانِ",16,"ن",1,0],["ولو طرحوا في فئِ حائطِ كرمها","عليلاً وقدْ أشفى لفارقهُ السُّقمُ",17,"م",1,0],["وَلَو طَرَقت لَيلاً قُصَيّاً عَظيمَةٌ","إِذاً ما لَجَأنا دونَهُم في المَداخِلِ",18,"ل",1,0],["ولو طلبت عيناك في الارض مشبهاً","مثالاً سماويًّا لا شبههُ جدَّا",19,"د",2,0],["وَلَو طاوَعَتني كلُّ عَينٍ قَريحةٍ","لما ذابَ بعضُ الثاكِلين بُكاءَ",20,"ا",2,0],["ولو طار مِن قبلي مَشُوقٌ لشائقٍ","لِطرتُ بشوق يقطع القلب والصدرا",21,"ر",2,0],["ولو طلب العفَو قبل الحروب","لكنتَ له غافراً ما مضى",22,"ا",1,0],["ولو طوعت لي النفس كتمان حبها","لنم علي الدمع والجسد الضو",23,"و",1,0],["ولو طلقتها ذات اضطراب","لما صحب الحراك بها السكون",24,"ن",1,0],["ولو طلبوا مثلي لَعَزَّ وجوده","وما وَجَدوا مثلي وأنَّى لهم مثلي",25,"ل",2,0],["ولو طارَتْ بِهِ أَلفا عُقابٍ","يَرُمْنَ بنفسِهِ خَرْقَ الهواءِ",26,"ا",2,0],["ولو طارت عددناها بغاثا","ولو لمعت حسبناها سرابا",27,"ب",2,0],["ولو طرحت بمزبلة لصدت","عن الجيف المدنسة الغرابا",27,"ب",2,0],["وَلَو طُحِلوا إِذا طُحِلوا","لَكانَ بَلاؤُهُم جَلَلا",28,"ل",2,0],["ولوطاً لقد طورت أيضاً وصالحاً","أتيت إلى قومي لإبلاغ دعوتي",29,"ي",1,0],["ولَو طُلبَت بحُكمِ الحَربِ عادَت","بحَربٍ دُونَها حَربُ الفِجار",30,"ر",1,0],["ولو طَلَب الأنامُ له نَظيرا","مِن الثقلَين ما وَجدُوا نظيرا",31,"ر",2,0],["ولَو طَهَّرتَ طُولَ الدَّهرِ كَلبا","بأمواهِ البَسيطَةِ فَهُو نَجس",32,"س",1,0],["وَلَو طَلَعت أَو نَزَلتَ يَوما","وَلَو صَدَدتَ أَو وَصَلتَ قَوما",33,"م",2,0],["ولو طلبَ الدنيا لحازَ جميعَها","وحُكِّمَ فيما يشْتهيه وما يهوى",34,"و",2,0],["ولو طلبت مني على ذاك في الهوى","زيادة حب لم أجد ما أزيدها",35,"د",3,0],["ولو طلبت زحلاً نالتِ","ونفسك تفعل ما قالتِ",36,"ت",1,0],["ولو طرحوا منه حرفاً على","لهيب لظىً لاغتدى منه هامد",37,"د",1,0],["وَلو طور سينا يلقى ما تأوّبني","لاِندكَّ ممّا أُلاقي طور سينيني",38,"ن",2,0],["ولو طمعت بكوني فيّ دونكمُ","خابتْ لديّ على التحقيقِ أطماعي",39,"ع",2,0],["وَلو طَنت خلاف الخَير فيهم","لَما غذّتهم لبن الرضاع",40,"ع",1,0],["ولو طار إنسان من الناس قبلهم","لطاروا سروراً يعلم الله في سري",41,"ر",2,0],["ولو طلبوا رغمي وقد كنت صاديا","على الماء لم اشربه بعدا عن الرغم",42,"م",1,0],["ولو طواها الدجى عنا لأظهرها","برق الثنايا وعطر النحر والنفس",43,"س",1,0],["وَلَو طعنت أَسنته الرَّواسي","لَصارَ سَنامها العالي مهالا",44,"ل",2,0],["ولو طيئ راءت سماحة بيته","طوت ذكر جود في عدي بن أخزما",45,"م",2,0],["ولَو طَلَبَ الناسُ المكارمَ كلُّهم","لكانَ الغِنى كالفَقْرِ والعَبدُ كالرّبِّ",46,"ب",1,0],["ولو طبعت اخلاقه الغر لم تكن","بأفلاك لوح المجد إلا كواكبا",47,"ب",2,0],["ولو طلبت فتاة الحي روحي","لكنت بها ولم أحفل سخيّا",48,"ي",2,0],["ولو طال بالمعروف عمر مجاهد","لعاش بكم أهل الجهاد إلى الحشر",49,"ر",1,0],["ولو طلبت يَدُهُ مَسَّها","لدانت لهُ وَدَنت طائعَه",50,"ع",2,0],["ولو طلبوا في الهوى من مزيد","لما وجدوا فوق ما بي مزيدا",51,"د",2,0],["ولو طعمت غراما ما طمعت اذا","بالمغرمين أذى بل ذدت ما آذى",52,"ذ",2,0],["ولو طلب الإنسان من صون دهره","دوام الذي يخشى لأعياه ما طلب",53,"ب",1,0],["ولو طالت مسافاتك على دربك تسير خطاي","ينور دربك احساسي .. يوصلني عناوينك",54,"ك",1,0],["ولو طولت فرقاك قلبي رعاة الدود","فخطر علي ادخل شهار المجانيني",55,"ن",2,0],["ولو طلب الفؤادَ لطرتُ سعداً","فروحي والمنى ملكٌ لديهِ!",56,"ي",2,0],["ولو طاولتك الشهب وهي بافقها","ببعض سجاياهم أفلن نواصعه",57,"ع",2,0],["ولو طرفة بن العبد أدرك عصرها","وجرول لم يسمع لناقتهم ذكر",58,"ر",1,0],["ولو طلعت شمس من الحق لم يكن","ليضحى لها من حيرة الجهل والعمى",59,"م",2,0],["ولو طُبقَ الاسلام حقا رأيتنا","نُغاثُ بمزن الراحمين ونزهرُ",60,"ر",1,0],["ولو طالت مشاوير الطريق المظلم المهجور","انا لامن ذكرتك قلت،احبك يامشاويري",61,"ر",2,0],["وَلَوْ طالَبَ الخَضْرا خَراجاً لَسَلَّمَتْ","إِلَيْهِ تُخُومَ الأَرْضِ وَالشَّمْسَ وَالبَدْرا",62,"ر",2,0],["ولو طال العمر فاني وترى عمر الفتى محدود","وكلٍ يطلب المولى يبيحه يحسن ختامه",63,"م",2,0],["ولو طاح لاعب كلنا صايحنا","يا كلب يابن الكلب وش ذا الشوته",64,"ت",2,0],["ولو طلب الإنسان من صرف دهره","دوام الذي يخشى لأعياه ما طلب",65,"ب",1,0]]}