{"poems":[[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[27,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[51,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"ولوطي قدام وخلف عذلته","https://www.aldiwan.net/poem65479.html","الطويل"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[49,"ألا من لنفس في الهوى قد تمادت","https://www.aldiwan.net/poem10840.html","الطويل"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[46,"غدا رمضاني ليس عني بمنقض","https://www.aldiwan.net/poem22643.html","الطويل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[68,"شربنا على ذكرِ الحبيبِ مدامة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15405&r=&rc=11",""],[132,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[197,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[223,"ألا يا تجار العصر هل فيكم امرؤ","https://www.aldiwan.net/poem55093.html","الكامل"],[227,"غدا عامر الأوطان في مقلتي قفرا","https://www.aldiwan.net/poem51110.html","الطويل"],[227,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[246,"اغالط مهما سميت ام خالد","https://www.aldiwan.net/poem1318.html",""],[259,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[413,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[436,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[477,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[534,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"]],"verses":[["ولو طلَبت نفسي الغنى بامتهانها","لأصبحتُ في المثرين أطولهم يدا",0,"د",2,0],["وَلَو طَرَقَ الزُبَيرُ بَني عَلِيٍّ","لَقالوا قَد أَمِنتَ فَلَن تُكادا",1,"د",2,0],["ولو طال مدحي فيه وانكدَّ لم تجز","إطالتي المكتوبَ من حسناتِهِ",2,"ت",2,0],["وَلَوْ طَعِمَتْ في عطْفِه وَوِصَالِهِ","أبَاحَتْهُ منْها مَرْشفاً لا يُصَرَّدُ",3,"د",1,0],["ولوطيِّ قُدَّامٍ وخلفٍ عذلته","فقال أخو العوجاء قولاً مثقفا",4,"ف",2,1],["وَلَو طَلَعوا عَلَيها عالَجوها","بِهِمَّةِ أَنفُسٍ عَظُمَت مُرادا",5,"د",2,0],["وَلَو طَلَبتُ سِوى نُعماكَ لي لَجَأً","لَظَلتُ أَطلُبُ شَيئاً غَيرَ مَوجودِ",6,"د",1,0],["وَلَو طابَ لي غَرسي لَطابَت ثِمارُهُ","وَلَو صَحَّ لي غَيبي لَسَحَّت شَهادَتي",7,"ي",1,0],["ولوْ طَعَنَتْ قبلَ الرّماحِ أكُفُّهُمْ","ولوْ سَبَقَتْ قبل الأكفّ المَعاصمُ",8,"م",1,0],["ولو طُلِبَتْ في الغيثِ منكَ سجيّةٌ","لقد عَزّ موجودٌ وعزّ وُجود",9,"د",1,0],["وَلَو طارَ جِبريلٌ بَقِيَّةَ عُمرِهِ","عَنِ الدَهرِ ما اِسطاعَ الخُروجَ مِنَ الدَهرِ",10,"ر",1,0],["ولو طَرِبَ الجَمادُ لكَانَ أوْلى","شُرُوبِ الرّاحِ بالطّرَبِ الدّنانُ",11,"ن",1,0],["ولو طَلَعَ الصّباحُ لفُكّ عنه","مِن الظّلْماءِ غُلُّ أو صِفادُ",12,"د",1,0],["ولو طَرَحُوا في فَيءِ حائطِ كَرْمِها","عليلاً وقد أشفى لفَارَقَهُ السّقم",13,"م",1,0],["ولو طريقُ حبّه","على القتاد والظُّبا",14,"ب",2,0],["ولو طاوَعْتَهُنّ لَجِئْنَ يوْماً","بأُخْتِ الغُولِ والنَّصَفِ الضِّفَنّه",15,"ن",2,0],["وَلَو طابَتِ الأَيّامُ بَعدَ مَذاقهُ","لَما شَرِبَت لِلحرِّ بَعد ليانِ",16,"ن",1,0],["ولو طرحوا في فئِ حائطِ كرمها","عليلاً وقدْ أشفى لفارقهُ السُّقمُ",17,"م",1,0],["وَلَو طَرَقت لَيلاً قُصَيّاً عَظيمَةٌ","إِذاً ما لَجَأنا دونَهُم في المَداخِلِ",18,"ل",1,0],["ولو طلبت عيناك في الارض مشبهاً","مثالاً سماويًّا لا شبههُ جدَّا",19,"د",2,0],["وَلَو طاوَعَتني كلُّ عَينٍ قَريحةٍ","لما ذابَ بعضُ الثاكِلين بُكاءَ",20,"ا",2,0],["ولو طار مِن قبلي مَشُوقٌ لشائقٍ","لِطرتُ بشوق يقطع القلب والصدرا",21,"ر",2,0],["ولو طلب العفَو قبل الحروب","لكنتَ له غافراً ما مضى",22,"ا",1,0],["ولو طوعت لي النفس كتمان حبها","لنم علي الدمع والجسد الضو",23,"و",1,0],["ولو طلقتها ذات اضطراب","لما صحب الحراك بها السكون",24,"ن",1,0],["ولو طلبوا مثلي لَعَزَّ وجوده","وما وَجَدوا مثلي وأنَّى لهم مثلي",25,"ي",1,0],["ولو طارَتْ بِهِ أَلفا عُقابٍ","يَرُمْنَ بنفسِهِ خَرْقَ الهواءِ",26,"ا",2,0],["ولو طارت عددناها بغاثا","ولو لمعت حسبناها سرابا",27,"ب",2,0],["ولو طرحت بمزبلة لصدت","عن الجيف المدنسة الغرابا",27,"ب",2,0],["وَلَو طُحِلوا إِذا طُحِلوا","لَكانَ بَلاؤُهُم جَلَلا",28,"ل",2,0],["ولوطاً لقد طورت أيضاً وصالحاً","أتيت إلى قومي لإبلاغ دعوتي",29,"ي",1,0]]}