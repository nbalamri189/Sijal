{"poems":[[37,"حي المنازل قد عفت أطلالها","https://www.aldiwan.net/poem39103.html","الكامل"],[37,"أقوى وأقفر من ماوية البرق","https://www.aldiwan.net/poem39126.html","البسيط"],[95,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[90,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[63,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[33,"أوقفت من طلل على رسم","https://www.aldiwan.net/poem41324.html","الكامل"],[76,"أقوى محل من شبابك آهل","https://www.aldiwan.net/poem13278.html","الكامل"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[42,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[42,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[102,"خطرات","https://www.poetsgate.com/ViewPoem.aspx?id=50194",""],[7,"عوجوا ، فحيوا لنعمٍ دمنة َ الدارِ ،","https://www.poetsgate.com/ViewPoem.aspx?id=17560",""],[113,"من مبلغ قصر الأمير بأنه","https://www.aldiwan.net/poem16370.html","الكامل"],[132,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[215,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[234,"ألقى الكمى ولا أهاب لقاءه","https://www.aldiwan.net/poem50771.html","الكامل"],[406,"يا قبة المسجد الأقصى","https://www.aldiwan.net/poem6723.html","عموديه"],[466,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[482,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[567,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48742","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138139",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96720","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28000","الكامل"],[2283,"","https://poetry.dctabudhabi.ae/diwan/poem/202194","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201140","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205589","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59493","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40128","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73132","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73257","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136444",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35150","الكامل"],[4701,"رام الله","https://www.poetsgate.com/ViewPoem.aspx?id=176659",""],[4797,"غالي وبخيل","https://www.poetsgate.com/ViewPoem.aspx?id=50248",""],[5213,"إذا ما جئت قبر أبي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=170401",""],[5277,"ربابٌ بلا وتر","https://www.poetsgate.com/ViewPoem.aspx?id=186503",""],[5431,"واحمل جراحك الواحا مخلدة","https://www.poetsgate.com/ViewPoem.aspx?id=190534",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5956,"أنا والشعر والعالم","https://www.poetsgate.com/ViewPoem.aspx?id=185582",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""],[5956,"حمْداً لِخالقِ فيصلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194670",""],[5956,"طوبَى للمحامية هالة خضر المحمد","https://www.poetsgate.com/ViewPoem.aspx?id=214190",""]],"verses":[["أَقوى الغَياطِلُ مِن حِراجِ مَبَرَّةٍ","فَخُبوتُ سَهوَةَ قَد عَفَت فَرِمالُها",0,"ل",3,0],["أَقوى وَأَقفَرَ مِن ماوِيَّةَ البرَقُ","فَذو مُراخٍ فَقَفرُ العَلقِ فَالحُرَقُ",1,"ق",1,1],["أَقَوِيٌّ وَبَعْدَ آنٍ ضَعِيفٌ","أَصَحِيحٌ وَفِي ثَوَانٍ سَقِيمٌ",2,"م",1,0],["أقوى مصيف القوم والمربع","فالدار قفر بعدهم بلقع",3,"ع",1,1],["أَقوى وَعُرِّيَ واسِطٌ فَبَرامُ","مِن أَهلِهِ فَصُوائِقٌ فَخِزامُ",4,"م",1,1],["أَقوى وَعُطِّلَ مِنهُمُ فَكَأَنَّهُ","بَعدَ البِلى آيُ الكِتابِ المُجمَلِ",5,"ل",1,0],["أقوى وفيه من العديدِ تَدافُعٌ","وخَلا وفيه من الأنيسِ زِحَامُ",6,"م",1,0],["أَقوى وَأَقفَرَ بَعدَ ساكِنِهِ","غَيرَ النَعامِ يَرودُ وَالأُدمِ",7,"م",1,0],["أَقوى مَحَلٌّ مِن شَبابِكَ آهِلٌ","فَوَقَفتُ أَندُبُ مِنهُ رَسماً عافِيا",8,"ي",2,1],["أَقوى وَغَيَّرَهُ اِختِلا","فُ تَناسُخِ الحِجَجِ النَواسِل",9,"ل",1,0],["أَقوى مِنَ آلِ ظُلَيمَةَ الحُزمُ","فَالغَمرَتانِ فَأَوحَشَ الخَطمُ",10,"م",1,1],["أَقوى مِن آل جُبَيرَةَ القَصرُ","فَقِرانُها فَتِلاعُها العُفرُ",11,"ر",1,0],["أقوى المُحَصَّبُ من هادٍ ومن هِيدِ","وودّعونَا لِطيّاتٍ عَباديدِ",12,"د",1,1],["أَقوى وَعُطِّلَ مِن فُرّاطَةَ الثَمَدُ","فَالرَبعُ مِنكِ وَمِن رَيّاكِ فَالسَنَدُ",13,"د",1,1],["أَقوى وَأَقفَرَ مِن نُعمٍ وَغَيَّرَهُ","هوجُ الرِياحِ بِهابي التُربِ مَوّارِ",14,"ر",1,0],["أقوى بيوت العرب التئاما","وخيرها بيتهمو وئاما",15,"م",2,0],["أقوياء تفنى الضّعاف وتدعو","خسّة الغالبين نصرا وكسبا",16,"ب",2,0],["أقوى ، وأقفَرَ من نُعمٍ، وغيّرهَ","هُوجُ الرّياحِ بها والتُّربِ، مَوّارِ",17,"ر",1,0],["أَقوى فَغشيت كُل قَصر وَحشة","وَنَأى فَكُل قَد عَراهُ أَنينُ",18,"ن",1,0],["أقوى إذا ذُكر اسمُه في مجلس","فكأنَّمَا طفلُ الشبابٍ حَبا لِي",19,"ل",2,0],["أقوى من الجاه والسلطان والمال","يا ليل يا ليلى يا ليل",20,"ل",1,0],["أَقَوى على مَضَضِ الشّدائِدِ والوَغَى","وأَذوبُ عند معَاتِبِ الإِخوانِ",21,"ن",1,0],["أقوى منَ الشَّمسِ في الآفاقِ إشراق","دينٌ حنيفٌ يُرينا الحقَّ برَّاقا",22,"ق",2,1],["أقوى منَ الوَهمِ في عقلٍ بلا رشدٍ","حقٌّ يزيدُ مع الأيامِ إحقاقا",22,"ق",2,0],["أقوى منَ الظالم المقطوعِ دابرُهُ","شعبٌ تحمَّلَ في مولاهُ ما لاقى",22,"ق",2,0],["أقوى من العاديِّ عند كَرامتي","والزَّعْزعِ الهوجاء إنْ لم أُكرمِ",23,"م",1,0],["أقوى مِنَ الظَبَياتِ الآنساتِ بهِ","ترنو وتعطو بأحداقٍ وأجيادِ",24,"د",1,0],["أقوَى الوَرَى سَنداً أعلى الذُرَى عُمُداً","أنَدى الكِرامِ يداً خيرُ الأنامِ أبا",25,"ب",2,0],["أقوى من الجيش والأسطول رفقتكم","بالناس ترجونهم أهلاً وجيرانا",26,"ن",2,0],["أقوى الورى في العيش أضعفهم إذا","غلت يديه حبائل الشيطان",27,"ن",1,0],["أَقوى وما مرّت عليه شهوره","أَبداً فكيفَ إِذا اِنقضت أعوامهُ",28,"م",2,0],["أَقوى خَمائِلَها الهَزارُ فَما تَعي","إِلّا نَعيبَ البومِ فَوقَ خَرابِها",29,"ب",3,0],["أقوى الورى واشدّهم في عقده","من صيَّر الأصنامَ فيه جُذاذا",30,"ذ",2,0],["أقوى الوجيف مغانيه فقد سلفت","له هنيدة لم تسهل لرواد",31,"د",1,0],["اقوّى ضعيفاً منهمُ وأمدُّه","بعزمي حتى يبلغ الرشد والفّنا",32,"ن",2,0],["أقوى تَمَدُّنهم وَبُدِّدَ شَملُهُم","وَلِكُلِّ شَملٍ لائِمٍ تَبديدُ",33,"د",1,0],["أقوى بني الإنسان في بأسه","من يرحم الضعف ويأسو الحزينْ",34,"ن",1,0],["أقوى الكماة شكيمة أسمى الذوا","ئب مفخراً ركن الفضائل والعمود",35,"د",1,0],["أقوى سوى نؤي وأشعثَ مُفَردٍ","ومناصبٍ سُفعٍ وأوْرَقَ محولِ",36,"ل",1,0],["أقوى وأقفر غيرَ سُفعٍ جُثَّمٍ","هِجن الهُمومَ واورقِ ومُشجَّجِ",37,"ج",1,0],["أَقْوَى الضَّلالُ وأقْفَرَتْ عَرَصَاتُهُ","وعَلا الهدى وتبلَّجَتْ قسماتُهُ",38,"ت",2,1],["أقوى الِحمَى من ساكنيهِ وكانَ لي","مَغدىً على أكنافِه ومَراحُ",39,"ح",1,0],["أقوى لبُعدِكُم الحِمَى","وَذُرا الأَراكِ وَلَيسَ يُجدي",40,"د",2,0],["اقوى دليل يكتفي","ذو العلم فيه عن الزياده",41,"د",2,0],["أَقوى مَحلٌ مِن شَبابِكَ آهِلٌ","فَأَقَمتُ أَندُبُ مِنهُ رَسماً عافِياً",42,"ي",2,1],["أقوى انتصاراتِ الحديدِ.. هزيمةٌ","والبندقيّةُ مومسٌ مُنحلّةْ",43,"ل",2,0],["أقوى رياح العذل ماتقدر تهده","والا الجفا لو تنفس هدم ابراجه",44,"ج",2,0],["أقوى لزائريه ألا فطوفوا","بقبر أبى التقي بخير مرقد",45,"د",1,0],["أقويتُ قافيتي بفقد أحبتي","فالشعر ماتَ اليوم في إقوائه",46,"ا",3,0],["أقوى من الصبر أمضى من تهكمه","امضغ جراحك واشرب نزفها شغفا",47,"ف",2,0],["أقوى من النزف لم تؤلمه عاهرة","غزت أظافرها في جرحه شبقا",48,"ق",2,0],["أَقْوَى مَعالِمَها وَعَفَّى رَسْمَها","دِيَمُ الغَوادِي قَطْرُها وَأَتِيُّها",49,"ي",3,0],["أقوّي الجانبَ الخيريَّ فيهم","وأضعِفُ جانبَ الشرِّ الرهيبِ",50,"ب",1,0],["أقوى الروابط طرّاً وَحدةٌ ربطت","ما بين قلبي وقلب الناس بالنغمِ",51,"م",1,0],["أقوى شواغلك انتهاءُ تعاستي","وبكل ممنونيّة تتجشَّمُ..",52,"م",1,0],["أقوى سلاح عقْلَهُ","في عالم مُتَزَلزِلِ",53,"ل",1,0],["أقوى محاميةٍ، وخيرُ طبيبة","مِن عقلها تستخرج الأدواءُ",54,"ا",2,0]]}