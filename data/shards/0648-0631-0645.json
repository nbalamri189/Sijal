,135,"ب",1,0],["ورمت بالجلمد المشتعل","فإذا الترب لمن كانوا به",136,"ه",1,0],["ورمى الهوى بي فارتميت","وكان نهداها المخدّه",137,"د",2,0],["ورموا بها أم الزمان، فأنجبت","غرر الملوك وقادة القواد",138,"د",1,0],["ورمَى الاحتلالَ حرّاً جريئاً","وتحدَّى العميدَ ثَبْتَ الْجَنانِ",139,"ن",1,0],["وَرَمَوْا مَعاقِلَهُ وإنْ لم تَسْتَجِبْ","لسهامهم. سَلِمَتْ يمين الرامي!",140,"م",2,0],["ورمَتْ مدافَعها المُبيدةَ جانبًا","وتسلَّحتْ من خُلقها بسلاح",141,"ح",1,0],["ورم بالشكر من أعطاك ستره","فإن الشكر مفتاح المزيد",142,"د",1,0],["ورمى إليك مقاليد الأمر الذي","تركت إليك فروعه وأصوله",143,"ل",2,0],["وَرَمْلِ عَزِيفُ الْجِنِّ فِي عَقِدَاتِهِ","هزيزٌ كتضرابِ المغنّينَ بالطَّبلِ",144,"ل",1,0],["ورَمَى به شُكراً لإسرائيلاً","ألفَيْتَهُ بِدَمِ العِدَا مَغْسولا",145,"ل",2,0],["ورمَتْ له يقظانَ مِن مُتَعٍ","ما نحنُ في الأحلامِ نَنشُده",146,"د",2,0],["ورمْت بكلكلِها عليك فوادحٌ","مما تجنّى \" السادرون \" ، جسام",147,"م",1,0],["ورمى الخيالَ بمعجزٍ من حُسْنِهِ","في حالتَه كاسياً عُرْيانا",148,"ن",2,0],["ورميتُ أثقال المطامحِ جانباً","ووجدت عن خُدُعاتِها سُلوانا",148,"ن",2,0],["ورَمى نَسْرُ قُرَيشٍ فوقَهم","من جَناحَيه الحبيبَيْن ظِلالا",149,"ل",2,0],["وَرَمَتْ سَوَادَ القَلبِ حينَ دنَتْ على","عَجَلٍ، فأصْمَتْهُ بطَرْفٍ أصْيَدِ",150,"د",1,0],["وَرَمَى سَوَادَ الأرمَننينَ، وَقَدْ عَدا","في عُقْرِ دارِهِمِ قَدارُ ثَمُودِ",151,"د",1,0],["وَرَمَى بنَبْهَانَ بنِ عَمْروٍ مُبعِداً،","فأصَابَ في أقْصَى البِلادِ تَمِيمَا",152,"م",2,0],["ورمت بسهم جال فيه جولة ً","حتى استقر ، فرنَّ فيه زنينا",153,"ن",2,0],["ورُمحي ما طعنْتُ به طَعيناً","فعادَ بعينيهِ نظرَ الرشادا",154,"د",2,0]]}