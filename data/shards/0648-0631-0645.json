s://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[45,"شُغْلانِ مِنْ عَذْلٍ وَمِنْ تَفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31609",""],[45,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[85,"مَنْ صَوَّرَ السِّحْرَ المُبينَ عيونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9570&r=&rc=60",""],[3,"أُعادي صَرْفَ دَهْرٍ لا يُعادى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10677&r=&rc=31",""]],"verses":[["وَرَمى بِشَخصي حَرَّ كُلَّ مَفازَةٍ","لا يَستَقِلُّ بِها مَطِيُّ جَبانِ",0,"ن",1,0],["وَرَمى بِهِ غَرَضَ الرَدى","عُريانَ قَد خَلَعَ النَعيما",1,"م",2,0],["وَرَموا إِلَيهِ نَواظِراً","كَأَسِنَّةِ اليَزَنيِّ شوسا",2,"س",2,0],["وَرَمَت بِهِ العَيّوقَ هِمَّتُهُ","فَوَطي رِقابَ الأَنجُمِ الزُهرِ",3,"ر",1,0],["وَرُمحي إِلى الأَعداءِ كَيدي وَصارِمي","جَنانِيَ يَومَ الرَوعِ وَالصَبرُ جُنَّتي",4,"ي",1,0],["وَرُمحٌ تَستَطيلُ بِهِ المَنايا","وَصَمصامٌ تُشافِهُهُ الدِماءُ",5,"ا",2,0],["وَرِماحُهُ سُفَراؤُهُ وَسُيوفُهُ","خُفَراؤُهُ وَجِيادُهُ نُدَماؤُهُ",6,"ا",3,0],["وَرَمى سِنيهِ إِلى الحِمامِ كَأَنَّما","أَلقى بِها عَن مَنكِبَيهِ رِداءَ",7,"ا",2,0],["ورِمّةِ كَعْبٍ إنّ مالاً أُصيبُهُ","لِجاري وقد يُعْشَى إِلى ضَوْءِ نارِهِ",8,"ر",2,0],["ورِماحُهُ تُوِّجْنَ منْ هامِ العِدا","ولخَيْلِهِ بدِمائِهمْ تَنْعيلُ",9,"ل",1,0],["ورُمنا عِناقاً نَهْنَهَتْ عنهُ عِفّةٌ","شَديدٌ بِها عَقْدُ النِّطاقِ على الخَصْرِ",10,"ر",1,0],["ورَمى المَشارِقَ بالمَذاكِي فارْتَدى","بِعَجاجِها المَلْمومَةُ الشَّهْباءُ",11,"ا",2,0],["وَرِماحُنا تَكِفُ النَجيعَ صُدورُه","وَسُيوفُنا تَخلي الرِقابَ فَتَختَلي",12,"ل",2,0],["وَرُمحي ما طَعَنتُ بِهِ طَعين","فَعادَ بِعَينِهِ نَظَرَ الرَشادا",13,"د",2,0],["وَرُمحي إِذا ما اِهتَزَّ يَومَ كَريهَةٍ","تَخِرُّ لَهُ كُلَّ الأُسودِ القَناعِسِ",14,"س",1,0],["وَرَمَيتُ مُهري في العَجاجِ فَخاضَهُ","وَالنارُ تَقدَحُ مِن شِفارِ الأَنصُلِ",15,"ل",1,0],["ورمَى بالكِتابِ ضُعْفَ اهْتِبالٍ","قُلْتُ يَحْيى خذِ الكِتابَ بقوهْ",16,"ه",1,0],["وَرَمَتْنِي فَقُلْ لِعَرَّافِ نَجْدٍ","إِنْ تَخَلَّصْتُ فَدُونَكَ مَا لَهْ",17,"ل",2,0],["وَرَمَى بِنَا الْبَحْرُ الْمُحِيطُ وَلَوْ دَرَى","مِنْ دُونِهِ مَرْمَىً لَقَالَ لَنَا ارْحَلُوا",18,"ل",3,0],["وَرَمَيْتَهَا بِعَزِيمَةٍ نَصْرِيَّةٍ","كَادَتْ لَهَا شُمّ الْهِضَابِ تَزُولُ",19,"ل",1,0],["وَرَمَى إِلَيْكَ مَقَالِدَ اَلأَمْرِ الَّذِي","تُرِكَتْ إِلَيْكَ فُرُوعُهُ وَأُصُولُهُ",20,"ل",2,0],["ورُمْتُ نُهوضاً واعْتَزَمْتُ موَدِّعا","فصَدّنيَ المِقْدارُ عنْ وجْهَتي صَدّا",21,"د",2,0],["وَرَمَيْتَ دِينَ اللهِ مِنكَ بِفَادِحٍ","عَمَّ البَسِيطَةَ مِشْرِقَاً أَوْ مَغْرِبَا",22,"ب",2,0],["وَرَمَيْتَهَا مِنْهُمْ بِكلِّ مُجَرِّبٍ","ذَلَّتْ لَهُ الأَقْرَانُ وَهْيَ صِعَابُ",23,"ب",1,0],["وَرَماهُمُ بِمُجَلَّدَينِ رَمَوهُما","في رُتبَةِ الأَصفارِ لا الأَسفارِ",24,"ر",1,0],["وَرَمى عَلى أَرضِ الكِنانَةِ جِرمَهُ","بِالنازِلاتِ السودِ حَتّى أَرهَقا",25,"ق",2,0],["وَرَميُكَ شَعباً بِالتَعَصُّبِ غافِلاً","وَتَصويرُكَ الشَرقِيَّ غِرّاً مُجَرَّدا",26,"د",2,0],["ورُمتَ تَفقيهَهُم في دينِيهِم فإذا","بالشَّربِ قد بَرَعُوا الفاروقَ تَفقيها",27,"ي",3,0],["وَرَمى جَديدَهُمُ فَخَرَّ بِناؤُهُ","بِرُواءِ زُخرُفِهِ وَبَرقِ دِهانِهِ",28,"ن",2,0],["وَرُمتَ تَفقيهَهُم في دينِهِم فَإِذا","بِالشَربِ قَد بَرَعوا الفاروقَ تَفقيها",29,"ي",3,0],["وَرَمَوكَ بِالسَلوى وَلَو شَهِدوا الَّذي","تَطويهِ في تِلكَ الضُلوعِ لَأَشفَقوا",30,"ق",3,0],["وَرَمَتنِيَ الأَقدارُ مِنكَ بِلَوعَةٍ","باتَت تَأَجَّجُ في صَميمِ فُؤادي",31,"ي",1,0],["وَرَملٍ عَزيفُ الجِنِّ في عَقِداتِهِ","هُدوءاً كَتَضرابِ المُغَنّينَ بِالطَبلِ",32,"ل",1,0],["وَرَملٍ كَأَوراكِ العَذارى قَطَعتُهُ","إِذا جَلَّلَتهُ المُظلِماتُ الحَنادِسُ",33,"س",1,0],["ورمى إليك ببدره ونجومه","يُهديك منه التَاج والإكليلا",34,"ل",2,0],["ورمحك مرتاح المعاطف هِزَّةٌ","كَأَنْ قد سقته من دم الكفر قَرْقَفُ",35,"ف",1,0],["ورمى القضيب دراهماً من نوْرِهِ","فاعتاض من طل الغمام بها دُرَرْ",36,"ر",1,0],["ورمى البزاةَ على القناة يصيده","صيد الخليفة شارِدَ الأعداءِ",37,"ا",2,0],["ورُم العَلاء مخاطراً","فيما تحاول من لُبابه",38,"ب",2,0],["وَرَمَوا بِهِنَّ سَواهِماً عُرضَ الفَلا","إِن مُتنَ مُتنَ وَإِن حُيِينَ حُيِينا",39,"ن",2,0],["وَرَمَيتَ هَضبَتَنا بِأَفوَقَ ناصِلٍ","تَبغي النِضالَ فَقَد لَقيتَ نِضالا",40,"ل",2,0],["وَرَمى دَوابِرَها السَفا وَتَهَيَّجَت","ريحُ المَصايِفِ سَومُها وَسِهامُها",41,"م",3,0],["ورُمْهُ إن طاشت الأيام أو بخلت","فالحلم والجود في ناديه مقتسم",42,"م",1,0],["ورمتني من العيونِ سهامٌ","ذات نصلٍ كما ترى مسموم",43,"م",1,0],["ورماه الزمان في شُقَّة النف","سِ فأَصْمَى فؤادَه إصْماءَ",44,"ا",2,0],["ورمى بالإخاء من رأس عَلْيا","ءَ إلى مُدْلَهِمَّة ظَلْماءِ",45,"ا",2,0],["ورمى نحور الخائنين بسهمهِ","وتِراسُهم قَدَرُ البقاءِ فما نبا",46,"ب",2,0],["ورمى بالفقر من بخلتْ","كفُّه بالعُرف عن أحدِ",47,"د",1,0],["ورمته إذ وضع السلاح وطال ما","هابته وهو لنبلها مستهدف",48,"ف",1,0],["ورمتُك فاستطلْتُ بلا نوالٍ","فما لنزاهتي لا تستطيل",49,"ل",1,0],["ورمَيْتَ الذين ترمي فكانت","لك آجالهُم قِسِيّاً ونَبلا",50,"ل",2,0],["وَرَمَيتَني يا لَيلُ بِالهَمِّ الَّذي","يَفري الحَشا وَالهَمُّ أَعسَرُ داءِ",51,"ا",2,0],["ورمتْني بمَهْمَهٍ قاتِمٍ قفرٍ","تُغَشِّيهِ داجِياتُ الغَمامِ",52,"م",1,0],["وَرَمَتْها مِنْ سَمَاها بِرُجُومْ","تَسْكُبُ الأَحْراقْ",53,"ق",1,0],["ورمَيْتَني مِنْ حالقٍ","وسَخِرْتَ منِّي أَيَّ سُخْرِ",54,"ر",1,0],["ورَمَتْ للوهادِ أفنانيَ الخضْرَ","وظلّتْ في الثَّلْجِ تحفر لَحْدي",55,"د",2,0],["ورمى نفسه بليل","من السطح وانتحر",56,"ر",1,0],["ورمى فحط البدر عن عليائه","رام يصيب الشمس في الآراد",57,"د",1,0],["وَرَمَت بِهِ في الجَوِّ لَم","تَحرِص وَلَم تَستَوثِق",58,"ق",1,0],["وَرَمى بِالنَفسِ في بُركانِها","فَتَلَقّى أَوَّلَ الناسِ لَظاها",59,"ا",3,0],["وَرَمَت طَرفاً إِلى البَحرِ تَرى","مِن وَراءِ الدَمعِ أَسرابَ السَفين",60,"ن",1,0],["وَرَمى أُذَنيهِ في ناحِيَةٍ","يَخلِسُ الأَصواتَ خَلسَ البَبَّغاء",61,"ا",2,0],["وَرَمَت بِسَهمٍ جالَ فيهِ جَولَةً","حَتّى اِستَقَرَّ فَرَنَّ فيهِ رَنينا",62,"ن",2,0],["وَرَمى العِدى وَرَمَيتِهِم بِجَهَنَّمٍ","مِمّا يَصُبُّ اللَهُ لا الأَقوامُ",63,"م",1,0],["وَرَمى وَما رَمَتا يَداهُ فَصابَني","سَهمٌ يُعَذِّبُ وَالسِهامُ تُريحُ",64,"ح",1,0],["وَرَميُكَ اللَيلَ بِالجُنودِ وَقَد","رَمَيتَ أَجفانَهُم بِتَسهيدِ",65,"د",1,0],["وَرُمحي لَأَنتَ الرُمحُ لا ما تَبُلُّهُ","نَجيعاً وَلَولا القَدحُ لَم يُثقِبِ الزَندُ",66,"د",1,0],["ورمز بليناس وهو الذي","تضمنه السَّرَب المعقلُ",67,"ل",1,0],["ورمزنا على الطبائع رمزاً","زيده بالذكاء والفكر نورا",68,"ر",2,0],["ورموزنا فيها يطو","ل لطولها تعدادها",69,"د",3,0],["ورمَى بسهمَيْ مقلةٍ ويَدٍ","نحرَ الغزالِ وقلبَ من عَشِقَا",70,"ق",2,0],["ورمَى فنازعَه الإصابةَ مقلةٌ","من أقصدتْهُ سهامُها لم يُنْعَشِ",71,"ش",1,0],["ورمى القضاء إليك طاعتَهُ","تختارُ ما تهوى وتنتَخِبُ",72,"ب",1,0],["وَرَمَت بِنا سَمتَ العِراقِ أَيانِقٌ","سُحمُ الخُدودِ لُغامُهُنَّ الطُحلُبُ",73,"ب",1,0],["وَرَمى بِثُغرَتِهِ الثُغورَ فَسَدَّها","طَلقَ اليَدَينِ مُؤَمَّلاً مَرهوبا",74,"ب",2,0],["وَرَمَت سَوادَ القَلبِ حينَ رَنَت عَلى","عَجَلٍ فَأَصمَتَهُ بِطَرفٍ أَصيَدِ",75,"د",1,0],["وَرَمى العَدُوَّ فَلَم يُقَصِّر سَهمُهُ","حَتّى تَخَضخَضَ في رَمِيٍّ مُقصَدِ",75,"د",1,0],["وَرَمى سَوادَ الأَرمَنينَ وَقَد عَدا","في عُقرِ دارِهِمِ قُدارُ ثَمودِ",76,"د",1,0],["وَرَموا إِلى شُعَبِ الرِحالِ بِأَعيُنٍ","يَكسِرنَ مِن نَظَرِ النُعاسِ الفاتِرِ",77,"ر",1,0],["وَرِمَّةُ الصَفّارِ مَتروكَةٌ","رَهناً لِإِحدى عَلقاتِ العُلوق",78,"ق",1,0],["وَرَمى بِنَبهانَ بنِ عَمرٍ مُبعِداً","فَأَصابَ في أَقصى البِلادِ تَميما",79,"م",2,0],["ورَمَتْ طَسْماً فُقلْ في غَرَضٍ","تَتحَدَّاهُ يداها بشُعَلْ",80,"ل",1,0],["ورمَى بِلادَ الرُّومِ بالعَزْمِ الذي","ما زالَ صُبحاً في الظَّلامِ فَتِيقا",81,"ق",2,0],["ورمَتْ به شقراءُ تَحْسِبُ بُردَها","يَنقَدُّ من شِيَةِ الجَوادِ الأشقَرِ",82,"ر",1,0],["ورميتُما المِسكَ الذَكيذَ بغَيْبةٍ","وذَكاؤه يُربي على المُغتابِ",83,"ب",1,0],["وَرَميتُ نَحوَ سَماءِ جودِكَ ناظِري","أَرعى مَخايِلَ بَرقِهِ وَأَشيمُ",84,"م",1,0],["وَرُمتُ سُلواني","عُذري يَقوم",85,"م",1,0],["وَرَمَيتَ الجِمارَ في كَبِدِ الأَع","داءِ لَمّا رَمَيتَ بِالجَمَراتِ",86,"ت",1,0],["وَرَماهُمُ مِن بَعدِ ذاكَ بِحَرَّةٍ","نارُ الهَواجِرِ فَوقَها تَتَضَرَّمُ",87,"م",1,0],["وَرَمى بَينَنا العَداوَةَ إِنّي","نِلتُ ما نالَ فَهوَ نِدّي وَضِدّي",88,"ي",1,0],["وَرَمانا مِن غَدرِهِ بِسِهامٍ","نَشِبَت في القُلوبِ وَالأَكبادِ",89,"د",1,0],["ورَمَتْكَ بمقلةِ خاذلةٍ","هَجَرَتْكَ وعاوَدتِ ا