{"poems":[[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[53,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[53,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138370",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62492","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72311","المنسرح"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86311","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"]],"verses":[["بل ظل يُوزنُ بالقسطاس مأخذُهُ","مُجاوزاً عَتَباً منه إلى عَتَبِ",0,"ب",1,0],["بل ظلتَ تستعرضُ البقاعَ ولا","تسخى بتعريجةٍ إلى سكنِكْ",1,"ك",1,0],["بل ظل يهضمها وظل","لت منه شاكية شجاها",2,"ا",3,0],["بل ظل يُوزنُ بالقسطاط مأخذُهُ","مُجاوزاً عَتَباً منه إلى عَتَبِ",3,"ب",1,0],["بل ظل ينشرني ويطويني إلى","أن أصبح الجسم الضعيف جديلا",4,"ل",2,0],["بِلظى طوبٍ وَجمرِ","مِن أَعاديها المبيدهْ",5,"ه",1,0],["بلظى خدَّيه نُصْلى","بظُبا عينيه تُبْلى",6,"ل",2,0],["بل ظن إن الحق المبين سيأ","تيه بما ينبغي على مهل",7,"ل",1,0],["بلظاة صورتها قلما","قدرة الخلاق حرب الظالمين",8,"ن",1,0],["بَل ظَنَّ اِنَّكَ عَن غَرامِكَ تَنثَني","اِذ لَجَّ في بُهتانِهِ وَنَهاكا",9,"ك",2,0],["بل ظنه حيّاً أتى الأبوابا","فينثني ويحسن المآبا",10,"ب",2,0]]}