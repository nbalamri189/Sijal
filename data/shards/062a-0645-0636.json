ُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["تَمضي المُلوكُ وَأَنتَ طَودٌ ثابِتٌ","يَنجابُ عَنكَ مُتَوَّجٌ وَمُعَمَّمُ",0,"م",1,0],["تَمضي اللَيالي بِكَ وَال","مِقدارُ عَنكَ غافِلُ",1,"ل",1,0],["تَمضي وَنَحوَكُمُ تَلَفُّتُها","وَإِلى لِقائِكُمُ تَشَوُّفُها",2,"ف",3,0],["تَمضي العُلى وَإِلى ذَراكُم تَرجِعُ","شَمسٌ تَغيبُ لَكُم وَأُخرى تَطلُعُ",3,"ع",1,1],["تَمضي المَنايا بِما شاءَت أَسِنَّتُهُ","إِذا القَنا بَينَ فُرسانِ الوَغى اِشتَجَرا",4,"ر",2,0],["تَمْضِي وَذِكْرُكَ مِلءُ كُلِّ جَنَانِ","لِلهِ دَرُّكَ من بَعِيدٍ دَانِ",5,"ن",1,1],["تَمْضِي وَأنْتَ مَضَنَّةُ الأَوْطَانِ","وَدَرِيئَةٌ ذُخِرَتْ لَهذَا الآنِ",6,"ن",1,1],["تَمْضِي الرِّجَالُ وَتَنْمَحِي آثَارُهَا","وَيُقِيمُ ذِكْرُ السَّيِّدِ الرَّحْمَانِي",7,"ن",2,0],["تَمْضِي الدهُورُ وَمِصْرُ لا تَنْسَاكُمُ","وَوَلاؤُهَا عَهْدٌ لَكُمْ وَذِمَامُ",8,"م",1,0],["تَمضي الحياة طريّة في ظلها","والعيش أخضر والزمان أنيقا",9,"ق",2,0],["تَمضي الشهور عليك وهي أنيسةٌ","وتَمُرّ باسمةً بك الساعات",10,"ت",1,0],["تَمضي أَسِنَّتُنا وَتَعلَمُ مالِكٌ","أَن قَد مَنَعتُ حُزونَتي وَرِمالي",11,"ل",2,0],["تَمضي الحَيَاةُ بماضيها وحاضرِها","وتذهَبُ الشَّمْسُ والشُّطْآنُ والقِممُ",12,"م",1,0],["تمضي بها عن قريب","من الزمان المنايا",13,"ا",3,0],["تَمضي اللَيالي لا تَنالُ كَمالَهُ","بِمَعيبِ نَقصٍ أَو مَشينِ سِرارِ",14,"ر",1,0],["تَمضي المَواكِبُ وَالأَبصارُ شاخِصَةٌ","مِنها إِلى المَلِكِ المَيمونِ طائِرُهُ",15,"ر",2,0],["تمضي الأمورُ على إرادتِه","فتكادُ قبلَ الفِعل تنفعلُ",16,"ل",1,0],["تُمضي صَريمَتَهُ وَتوقِدُ رَأيَهُ","عَزَماتُ جوذَرزٍ وَسَورَةُ بيبِ",17,"ب",1,0],["تَمضي اللَيالي وَالشُهورُ وَحُبُّنا","باقٍ عَلى قِدَمِ الزَمانِ الفاني",18,"ن",2,0],["تمضي لها الأبصارُ والهةَ الهوى","وتحولُ عنها ما تطيقُ لقاهَا",19,"ا",3,0],["تمضي كما مضتِ الليالي قبلها","لا أنتِ ذاكرةٌ ولا أنا نَاسِ",20,"س",1,0],["تمضي وراءَ سحابة","تحنو عليك وتلثُمك",21,"ك",1,0],["تمضي لها الأبصار مُشعلة الهوى","وتحول عنها ما تُطيق لقاهَا",22,"ا",3,0],["تمضي وتجهل كيف أكبرها","إذ تختفي في حالك الظلم",23,"م",1,0],["تَمضي الخطوبُ فَتُنْسَى بَعدَ شِدَّتِها","وما لِخطبِ بني الفاروقِ مِن ناسِ",24,"س",1,0],["تمضِي جَوافلُها بأغبرَ مُوحَشٍ","تَنسابُ فيه نواعبُ الغِربانِ",25,"ن",1,0],["تَمضي السُيوفُ فَما تُجاوِرُ مَقتَلاً","إِلّا حَماهُ تَعَصُّبُ الجيرانِ",26,"ن",1,0],["تُمضيكَ مِنهُ عَزيمَةٌ مِن دونِها","يَقِفُ الزَمانُ وَيَرجُفُ الثَقَلانِ",26,"ن",1,0],["تَمضي الفَيالِقُ وَالمَنايا تارَةً","تَطَأُ الصَعيدَ وَتارَةً تَنطادُ",27,"د",1,0],["تَمضِي أباطيلُ الحياةِ ولن ترى","لِسوَى الحقائقِ في الزّمانِ دَواما",28,"م",2,0],["تَمضي على المُثْلَى وكلٌّ يَقتَفِي","وَتَجِيءُ بالفُضلَى وكُلٌّ يَتْبَعُ",29,"ع",1,0],["تمضي البشائرُ جُوّلاً وتجولُ في","دمهِ السُّمومُ فجِلدُهُ يَتمزَّعُ",30,"ع",1,0],["تَمضي عَلى سنن الفولاذ جامِحَة","وَجذوة الشَوق تَزجيها وَتَرجيني",31,"ن",2,0],["تَمْضِي اللَّيالِي وَلا يَدْرُونَ عِدَّتها","ما لَمْ تَكُنْ مِنْ لَيالِي الأَشْهُرِ الحُرُمِ",32,"م",1,0],["تَمْضي ويَتبَعُكَ الغَمامُ بوَبْلِهِ","فكأنّهُ لك حيثُ كنتَ مُساجل",33,"ل",1,0],["تَمضي عَلى هَيئَةِ الشَخصِ الَّذي سَكَنَت","فيهِ إِلى دارُ نُعمى أَو شَقاواتِ",34,"ت",1,0],["تَمضي الحَياةُ وَما لي إِثرَها أَسَفٌ","وَدَدتُ أَنَّ مُعيرَ العَيشِ لَم يُعِرِ",35,"ر",1,0],["تَمضي الحَوادِثُ بِالحَوراءِ رائِعَةً","بَينَ الحَمائِلِ وَالجَوزَاءُ في الأُفُقِ",36,"ق",1,0],["تَمضي بآرائهِ سُيوفٌ","يستبقُ الموتُ في ظُباها",37,"ا",3,0],["تَمضي حَلاوتها الحَيا","ةُ وإنما تَبقى المَراره",38,"ر",2,0],["تمضي السنون وأنتمو من وعده","تَتَقلبون على ظهور أراجحِ",39,"ح",1,0],["تمْضِي اللَّيَالِي وَيَدْنُو يَوْمُ صَرْعَتِكم","بِمَا فَسَدْتَ عَلَى الدُّنْيَا وَمَا فَسَدُوا",40,"د",3,0],["تَمْضِي فَتَطْلُبُهَا بِحَيْثُ تعَسَّفَتْ","فِيهَا الرُّوَاةُ وَطَاشَتِ الأَخْبَارُ",41,"ر",1,0],["تَمْضي لِواجبِها حتى إِذا انْصَرَفَتْ","فَلَيْسَ يَشْغَلُها إِلاَّ فُؤَاداها",42,"ا",3,0],["تمضي الليالي، وهو من","نعمائها قاص ٍ ودانْ!!",43,"ن",1,0],["تَمْضِي فلا تَقِف الْعَوَائِقُ حائِلاً","وتَمُرُّ بَيْنَ الصَلْدِ والصُّفّاحِ",44,"ح",1,0],["تَمْضِي كما يَمْضِي الشّهابُ مُجِدَّةً","لا يبلغُ الشأوَ البعيدَ مُقَصِّر",45,"ر",1,0],["تمضي الحياةُ، فلا تعودُ إذا مضت","وأراك تختتم الحياةَ وتبتدي",46,"د",2,0],["تمضي وتترك هذا الدين في جزع","والأرض مظلمة والدهر في خبل",47,"ل",1,0],["تمضي وترسلها العراك مروعة","والليل داج والذئاب ضواري",48,"ر",2,0],["تمضي وتأتي والبلاد وأهلها","في ناظريك كما عهدت وتعهد",49,"د",1,0],["تمضي السنون وأنتمو من وعده","تتقبلون على ظهور أراجح",50,"ح",1,0],["تمضي العصور عليهم وهي واحدة","اليوم كالأمس فيها ضاحك هاني",51,"ن",2,0],["تمضي الرجال على خيال ذعومها","وكذا فلان شأنه وفلان",52,"ن",1,0],["تمضي الكرام على بساط مومها","ويد القلى فيهم تحل وتعقد",53,"د",1,0],["تمضي المقادير فينا الحكم عادلة","ويقسم اللَه أرزاقاً وأقواتا",54,"ت",2,0],["تمضي الليالي ولكن لا أحس لها","ما كنت أعهد من نور وظلماء",55,"ا",2,0],["تُمضى الوَسائِلُ في ذَراهُ لِطالِبِ ال","جَدوى وَتُقضى عِندَهُ الآرابُ",56,"ب",1,0],["تَمضي بِحَيثُ تُرى السُيوفُ كَليلَةً","وَتَطولُ حَيثُ تَرى الرِماحُ قِصارا",57,"ر",2,0],["تمضى وتترك في الرقاب صنائعا","والشكر منها في الرقاب ديون",58,"ن",1,0],["تَمضُغُ الأَيّامُ لَحمي عَبَثاً","لَيسَ بَعدَ المَضغِ غَيرُ الإِزدِرادِ",59,"د",1,0],["تَمضي النُفوس كَبيرُها وَصَغيرُها","طُرّاً فَتِلكَ إِلى الفَناءِ مَصيرُها",60,"ر",3,1],["تَمْضي بِحُلْمِكَ بِالإصْرارِ تَجْعَلُهُ","رأيَ العِيانِ لَكَ الأحلامُ تَمْتَثِلُ",61,"ل",1,0],["تمضى الليالي طوالاً لا أذوق بها","غير المرارة من آلام حرماني",62,"ن",2,0],["تَمضي قَضاياهُ عَلى سُرعَةٍ","واحِدَةٍ في اّلسِرِّ وَالجَهرِ",63,"ر",1,0],["تمضي لياليه وأيامه","وسره فيك كإعلانه",64,"ن",2,0],["تمضي يراعك في أمر يراع له","كل سواك وعنه كلت القضب",65,"ب",1,0],["تمضي إذا ما القضاءُ الحتم أرسلَها","فتنفذُ اللأمة القضَّاء والحَجفا",66,"ف",2,0],["تمضي على سبل كانوا لها سلكوا","أسلافنا فهم للَه أجناد",67,"د",1,0],["تَمضي وتُبقي في النفوس مرارةً","ويذوب قلبُ قتيلها من مَضِّه",68,"ض",2,0],["تُمضي بَنو هندٍ سُيوف الهِندِ في","أَوداجِ أَولادِ النَبِيِّ وَتَعتَلي",69,"ل",2,0],["تمضي بنا الأعوامُ ، يطوي بعضه","بعضاً ، ويطوي طيُّها الإنسانا",70,"ن",2,0],["تمضي الليالي وأفكاري مشتتة","مما أشاهده مما أنت عارفه",71,"ف",2,0],["تَمضي أَسِنَّتُهُ وَيُسفِرُ وَجهُهُ","في الرَوعِ عِندَ تَغَيُّرِ الأَلوانِ",72,"ن",1,0],["تمضي حوادثه فلا ضرَّاؤه","تبقى على أحدٍ ولا سرَّاؤه",73,"ا",3,0],["تمضي متى أَمْضَيْتَها فكأَنما","تأْتي على قَدَرٍ مع الأَقدار",74,"ر",1,0],["تمضي الحياة بنا ونحن كما ترى","ما بين كأس مدامة وعناق",75,"ق",1,0],["تمضِي الحجورُ بها تصاهِلُها","منها شخوصٌ تُحسب الحُصْنا",76,"ن",2,0],["تمضِي حدودَ القتلِ والقطعِ يدٌ","فيهم وليست لهمُ جرائمُ",77,"م",1,0],["تمضي أذيّتَها إذا هي جُرِّدتْ","في حيث لا تجدُ السيوفُ توغُّلا",78,"ل",2,0],["تمضي على حكمه الأفلاكُ دائرةً","فكلّ سعد جرى فيهن طالعُهُ",79,"ع",2,0],["تمضي فلا يملك الإعتابُ رجعتَها","ومن يردّ عقيلاً بعد ما انتشطا",80,"ط",2,0],["تمضي حنايا ذُبَّلاً شخوصُها","سهامُها تُنفَضُ أو أوتارُها",81,"ر",3,0],["تمضي عزوفاً لا تُغَرّ ببوّها","يُلقى السقائطَ بالفلاةِ ويَطرَحُ",82,"ح",1,0],["تمْضي على الهَوْلِ المَخوفِ","كأنَّ عَزْمكَ منْ نِصالِكْ",83,"ك",1,0],["تمضي بكلّ فؤادٍ وهي مغمدةٌ","وكيف يمضي حسامٌ ليس ينتصل",84,"ل",1,0],["تَمضي بِقاتِل لَهْفِهمْ أوقاتهُمْ","سِرًّا وهُمْ عَلَناً على اسْتِبْشارِ",85,"ر",1,0],["تُمضي الزمانَ بعقْرِ بيتِكَ كلَّهُ","وتُماطُ عنك بكلِّهِ أَجْزاءُ",86,"ا",2,0],["تمضي إذا نبت الظبي وتطول إن","قصر القنا وتفل غرب الفيلق",87,"ق",1,0],["تَمضِي إِلى القومِ الأُلى لَم تَزلْ","تَجعلهم في الظّلماتِ الهُدى",88,"ا",1,0],["تَمضي عَلى نَهجِ الإِمامِ وَتارَةً","تَستَنُّ في الغاراتِ غَيرَ الأَحيَدِ",89,"د",1,0],["تَمضي المَنايا كَما تَمضي أَسِنَّتُهُ","كَأَنَّ في سِرجِهِ بَدراً وَضِرغاما",90,"م",2,0],["تَمضي الليالي ولا تُلقِي بها أثراً","إلاّ كما أثَّرَ الصمْصامُ في الدَّرَقِ",91,"ق",1,0],["تمضي الملوك ومصر في تقلبها","كأنها روضة للأنس غناء",92,"ا",2,0],["تَمْضِي بِلَيْلٍ فَإِذَا أَقْبَلَتْ","أَقْبَلَتْ الشَّمْسُ بِإِقْبَالِهَا",93,"ل",3,0],["تَمْضِي لَواحِظُنا إِلى وَجَنَاتِهِ","إِنْ لاحَ ماءُ شَبابِه المُتَرقْرِقُ",94,"ق",1,0],["تمضى الشهور بقربهن سريعة","فتمر كالساعات تلك الاشهر",95,"ر",1,0],["تَمضي لَها في الغَزلِ بيضُ أَنامِلٍ","ظَلَمَ الَّذي هُوَ بِالحَريرِ يَقيسُها",96,"س",3,0],["تَمضي الحَياةُ كَأَن ل