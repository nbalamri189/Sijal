دَهُمُ فَجارا",109,"ر",2,0],["وَعُدَّ مِن بَعدِ عُثمانٍ أَبا حَسَنٍ","فَإِنَّ فَضلَهُما يُروى وَيُدَّكَرُ",110,"ر",1,0],["وَعَدتَ جَميلاً ثُمَّ أَخلَفتَ مَوعِدي","فَما بالُ وَعدِ الهَجرِ عِندَكَ لا يُلوى",111,"و",2,0],["وَعَدتَني في مَنامي ما وَثِقتُ بِهِ","مَعَ التَقاضي بِمَدحٍ فيكَ مُنتَظِمِ",112,"م",1,0],["وَعَدتُم وَأَعطَيتُم مَدى المَطلِ حَقَّهُ","عَلى قَدرِهِ حَتّى سَئِمنا التَمادِيا",113,"ي",2,1],["وَعدُكُم بِالنَدى سَقيمُ","وَأُمُّ آمالِنا عَقيمُ",114,"م",1,1],["وَعُدتُ النَدامى بِالمُدامِ فَلَم أَجِد","مُنى النَفسِ وَاِستَحيَيتُ مِن كَثرَةِ المَطلِ",115,"ل",1,1],["وَعَدوُّ مُلكِكَ هائِماً","وَسَحابُ جودِكَ هامِيَه",116,"م",3,0],["وَعَدَ الزَمانُ بِأَن نَرى فيكَ المُنى","وَالآنَ قَد أَوفى الزَمانُ بِوَعدِهِ",117,"د",2,0],["وَعَدَ الصَوارِمَ أَن يَقُدَّ بِها الطَلا","وَعَداً أَراهُ لِلعُداةِ وَعيدا",118,"د",2,0],["وَعَدتَ جَميلاً وَأَخلَفتَهُ","وَذَلِكَ بِالحُرِّ لا يَجمُلُ",119,"ل",1,1],["وَعُدنا إِلى هالَةٍ أَطْلَعَتْ","عَلَى قُضُبِ البانِ أقمارَها",120,"ر",3,0],["وعدتم وللفتحِ المبينِ تباشرَتْ","وقدْ حُطِّمَتْ في الدارعينَ العواملُ",121,"ل",1,0],["وعدوني بسوى القرب فقد","شفَّني الهجرانُ منكم والوصال",122,"ل",1,0],["وَعُدنَ بِقَرقارِ الهَديرِ كَأَنَّما","شَرِبنَ مُداماً أَو بِهِنَّ جُنونُ",123,"ن",1,0],["وَعَدِّ سَواءَ الحُبِّ وَاِترُكهُ خالِياً","وَكُن رَجُلاً وَاِجمَح كَما هُوَ جامِحُ",124,"ح",1,0],["وَعُدِ العَليلَ مُؤاسِياً وَمُعَلِّلاً","إِنَّ العَليلَ تُريحُهُ العُوّادُ",125,"د",1,0],["وَعُدْتَ لا مَجْدَ إلا","أراهُ يَحْسُدُ مَجْدَكْ",126,"ك",1,0],["وَعْدٌ وَفَى لإمامِ المرسلينَ به","واللَّهُ إن وَعَدَ الرُّسْلَ الكِرامَ وَفَى",127,"ف",2,0],["وَعَد الإسلامُ خيراً مَن عفَى","إنّ حُسنَ العفوِ ممّا شَرعا",128,"ع",2,0],["وَعَدت عَن القَبر في العائِدين","أَمامي نَحيبٌ وَخَلفي نَحيب",129,"ب",1,0],["وَعَد بَلفور دَكّها فَلِماذا","تَجعَلون الأَنقاض مِنها رَمادا",130,"د",2,0],["وَعَدُوٍّ يُريدُ قَتلي وَلَكِن","يَدُ صُنعٍ مِنهُم تَرُدُّ يَدَيهِ",131,"ي",2,0],["وَعَدونا فَوقَ مَتنِ نِياقٍ","تَأخُذُ الأَرضَ بِأَيدٍ عِجالِ",132,"ل",1,0],["وَعَدَونا عَلى الجِيادِ وَما حو","بِيَتِ الخَيلُ إِذ تُسَمّى جِيادا",133,"د",2,0],["وَعِداً صَبَّحتُهُم بِرَحى جَي","شٍ رُكامٍ مِثلِ الدَبى المَجلوبِ",134,"ب",1,0],["وَعَدَت جِيادُهُمُ بِكُلِّ فَتىً","يَعصى بِقائِمِ مُنصُلٍ عَضبِ",135,"ب",1,0],["وَعَدَتْنِي ازْدِيَارَهُ العامَ وَجْنا","ءٌ وَمَنَّتْ بِوَعْدِها الوجْناءُ",136,"ا",2,0],["وَعَدَّ ما حَوَتِ الأُشْجَارُ منْ وَرَقٍ","وكُلِّ حَرْفٍ غَدَا يُتْلَى وَيُستَطَرُ",137,"ر",1,0],["وَعَدَّ وَزْنَ مَثاقِيلِ الْجِبالِ كَذَا","يلِيهِ قَطْرُ جَمِيعِ الماءِ والمَطَرُ",137,"ر",1,0],["وعَدَّ نَعْمَائِكَ اللاتِي مَنَنْتَ بِهَا","عَلَى الخلائِقِ مُذْ كانُوا وَمُذْ حُشِرُوا",137,"ر",3,0],["وعَدَّ مِقْدَارِهِ السَّامِي الَّذي شَرُفَتْ","بهِ النَّبِيُّونَ والأمْلاكُ وافْتَخَرُوا",137,"ر",3,0],["وعَدَّ ما كانَ في الأكْوانِ يا سَنَدِي","وما يَكُونُ إلَى أنْ تُبْعَثَ الصُّوَرُ",137,"ر",1,0],["وَعَدَّ أَضْعَافِ مَا قَدْ مَرَّ مِنْ عَدَدٍ","مَعْ ضِعْفِ أَضْعافِهِ يَا مَنْ لَهُ الْقَدَرُ",137,"ر",1,0],["وعَدَتْني الدّنْيا كثيراً فلم أظ","فَرْ بغَيرِ المِطالِ والتسويف",138,"ف",1,0],["وَعَدَتني قُبلَةً مِن سَيِّدي","فَتَعاضَت سَيِّدي حينَ فَعَل",139,"ل",1,0],["وَعَدَت إِلى قَيسٍ وَعَدَّت قَوسَها","سُبِيَت تَميمُ وَجَمعُهُم مَهزومُ",140,"م",1,0],["وَعُدتُ إِلى العِراقِ بِرَغمِ أَنفي","وَفارَقتُ الجَزيرَةَ وَالشَآما",141,"م",2,0],["وَعَدتَ وَلَم تُكرَه وَأَخلَفتَ طائِعاً","لَعَمري لَقَد بالَغتَ في البُخلِ وَالجَهلِ",142,"ل",1,0],["وَعَدتَ فَلَم تَصدُق وقُلتَ غَداً غَداً","كَما وُعِدَ الكَمّونُ شُرباً مُؤَخَّرا",143,"ر",2,0],["وَعَدتِني ثُمَّ لَم توفي بِمَوعِدَتي","فَكُنتِ كَالمُزنِ لَم يُمطِرُ وَقَد رَعَدا",144,"د",2,1],["وَعَدتِني ثُمَّ لَم توفي بِمَوعِدَةٍ","فَكُنتِ كَالمُزنِ لَم يَمطُر وَقَد رَعَدا",145,"د",2,0],["وَعُدِدتَ مِن عُمّارِ مَكَّةَ بَعدَما","كُنتَ المَريدَ يُعَدُّ في العُمّارِ",146,"ر",1,0],["وَعَدَتنا الأَيّامُ كُلَّ عَجيبٍ","وَتَلَونَ الوعودَ بِالإِنجازِ",147,"ز",1,0],["وَعْدٌ لهُ هاجِسٌ في القَلْبِ قد بَرِمَتْ","أَحْشاءُ صَدْري بِهِ مِنْ طُولِ ما هَجسا",148,"س",2,0],["وعدوا من الأسباب وهي كثيرة","لديهم حجاب المسلمات واعظموا",149,"م",3,0],["وَعدوني اللقاء بعد قَليل","حبذا الوعد لَم يكن ممطولا",150,"ل",2,0],["وعدها بالإصلاح جم ولكن","لا يجوز الإصلاح حد الكلام",151,"م",1,0],["وَعدن صواعداً متقلبات","وَلَيسَ صعودهن بلا عناء",152,"ا",2,0],["وَعد الأحلاف فَلَم يوفوا","يوماً بالوعد وَلا ادَّكروا",153,"ر",3,0],["وعدت بي للأرض أرض السَّراب","والليل جهمٌ كجناح الغراب",154,"ب",1,0],["وعُدت فأبصرت الصبيَّ مُعرِّجاً","ليدخل داراً بابها مُتَضعضِع",155,"ع",1,0],["وعدوتُ نحو الماءِ وهو مقاربي","فنأى وردَّ إلى السرابِ ظنوني",156,"ي",1,0],["وعَدتَ الشعوب بحقِّ المصير","فما لك تقضي وتُملي ارتجالا",157,"ل",2,0],["وعدت كئيبا إلى غرفتي","أراعي الكواكبَ من شرفتي",158,"ي",1,0],["وعُدتُ كما ترينَ صريعَ كأسٍ","أنا الظمآنُ لم يُطفىءْ غليلَهْ",159,"ل",2,0],["وَعَدَوا إِلى الحُسنى كَما","تَعدو المُطَهَّمَةُ العِراب",160,"ب",1,0],["وعَدْتَني يا بَدْرَها شمسَ الضّحى","والوَعدُ لا يُشْكَرُ إنْ لم يُنْجَزِ",161,"ز",1,0],["وَعُدنا بِالنِهابِ وَبِالسَبايا","وَبِالأَسرى تُكَبَّلُ بِالصِفادِ",162,"د",1,0],["وعِداتي شَمِتَت أَعجَبَهُمُ","أَنَّني غُيِّبتُ عَنهُم في أَسار",163,"ر",1,0],["وَعُداتي شُمَّتٌ أَعجَبَهُم","أَنّني غُيِّبتُ عَنهُم في قَرَن",164,"ن",1,1],["وَعَدِّ سِواهُ القُولَ واعَلم بأَنَّهُ","مَتَى ما يُبِن في اليَومِ يَصرمِكَ في غَدِ",165,"د",1,0],["وعَدَتني ومَنَّتِ الخُلدَ مِنها","قَد تُواتيكَ أو تَجيءَ يَسيرا",166,"ر",2,0],["وَعَدْتُ مَنْ فِي يَدَيْهِ رُوْحِيَ لاَ","أَذُوقُهَا والْوَفَاءُ مَا أَعِدُ",167,"د",1,0],["وَعُدْتُ أَشْتَاقُ أَنْ أَرَى زُمَراً","تَعُبُّهَا كَالْعِطَاشِ إِنْ وَرَدُوا",167,"د",3,0],["وَعُدْتُ إِلى هُدَاكِ أَرُدُّ أَمْرِي","إِلى الرَأْي الْخَلِيقِ بِكُل حُرِّ",168,"ر",1,0],["وُعِدَ الصَّابِرُونَ بِالفَوْزِ وَعْداً","حَقَّقَتْهُ أَنْبَاؤُهُمْ بِاطرَادِ",169,"د",1,0],["وَعِدَادَ اللِّحَاظِ نَصْفُو وَنشْقى","بِجِوارٍ فَفُرْقةٍ فَجِوَارِ",170,"ر",1,0],["وَعُدْ إِلى فنِّكَ فَانْظِمْ لَهَا","أَنْفَسَ مَا يَمْلِكُهُ المهْدِي",171,"ي",1,0],["وَعْدُ المُهَيْمِنِ بِالسَّعَادَةِ","لَيْسَ بِالْوَعْدِ الكِذَابْ",172,"ب",1,0],["وَعَدْنَا أبا سُفْيَانَ بَدْراً فَلَمْ نَجِدْ","لِمِيعَادِهِ صِدقاً وَمَا كَانَ وَافِيَا",173,"ي",2,1],["وعدتُ من المعارك.. لستُ أدري","علامَ أضعتُ عُمري في النزالِ",174,"ل",1,0],["وَعداً عَلى المُصطَفى لا بُدَّ مِنهُ وَلَو","أَقسَمتُ فيهِ أَبَرَّ اللَه إِقسامي",175,"ي",1,0],["وَعَدَت فيكَ الأَماني فَمانَت","وَعَدَت قُسَّ الزَمانِ القَصِيِّ",176,"ي",1,0],["وعدَت بِالتَمامِ فيهِ الأَماني","فَإِذا مَوعِدُ الأَمانِيِّ إِفكُ",177,"ك",1,0],["وَعَدّوا عَلِيّاً ذا المَناقِبِ وَالعُلا","وَفاطِمَةَ الزَهراءِ خَيرَ بَناتِ",178,"ت",1,0],["وَعَدتَ النَعلَ ثُمَّ صَدَفتَ عَنها","كَأَنَّكَ تَشتَهي شَتماً وَقَذفا",179,"ف",2,1],["وعُدْتَ وفي يُمْنَاكَ أَسْمَى شَهادةٍ","وأَشْرَفُ عُنْوانٍ لمِصْرَ وأَرْفَع",180,"ع",1,0],["وَعَدَتْ كَفُّه عَلَى دَوْحةٍ كا","نتْ تَمُدُّ الظِّلالَ في مِصْرَ مَدّا",181,"د",2,0],["وَعَدَتْ على الماء القراحِ جُيوشُها","فغدا النميرُ العذْبُ غيرَ قراح",182,"ح",1,0],["وعُدْت زعيمَ الفاتحين تقودُه","يدُ اللّهِ مِنْ غُنْمٍ لمصرَ إلى غُنْمِ",183,"م",1,0],["وعدَا عَلَى رَوْضِ الشَّبَابِ وظِلِّهِ","فَغَدَا بِه رَوْضُ الشَّبَابِ حُطَاما",184,"م",2,0],["وعدا اليوم حصاناً","فيه شيء من نفارك",185,"ك",1,0],["وعدت فلم تصدق وقلت غداً غداً","كما وُعد الكمون شُرْباً مُؤخر",186,"ر",1,0],["وعدت كما ترين صريع كأس","أنا الظّمآن لم يطفئ غليله",187,"ل",2,0],["وعُدتُ مليء الصدَّرِ حِقداً وقُرحةً","وعادت يدي من كلِّ ما أمَّلَتْ صِفرا",188,"ر",2,0],["وَعَدَتْنَا، فما وعفَتْ بِوِصَالٍ،","وَوَفَتْ، حين أوْعَدَتْ أنْ تَصُدّا",189,"د",2,0],["وعد الاله المحسنين ببرّه","وكما علمتم ، وعده تنويل",190,"ل",1,0],["وعداني أن أستخِصَّك مدحي","يابن يحيى وتلك خُطة ُ خسف",191,"ف",1,0],["وَعَدِّ سَواءَ القَولِ وَاِعلَم بِأَنَّهُ","إِذا لَم يَبِن في اليَومِ يَصرِمكَ في الغَدِ",192,"د",1,0],["وعدتُّ مخضباً بدَم الأعادي","وكَربُ الرَّكض قد خضَبَ الجودا",193,"د",2,0]]}