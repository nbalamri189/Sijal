bi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10143","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[104,"جمرة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=37412",""],[50,"أبا عمرٍ ما في طلابيك حاجة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30836",""],[96,"سؤال وجواب","https://www.poetsgate.com/ViewPoem.aspx?id=17492",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"بِتُّ أُبْدي وَجْداً وَأكْتُمُ وَجْدا","https://www.poetsgate.com/ViewPoem.aspx?id=32950",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[3,"أُعادي صَرْفَ دَهْرٍ لا يُعادى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10677&r=&rc=31",""]],"verses":[["وَعُدنَ وَفي حَقائِبِهِنَّ هامٌ","لَقينَ مِنَ الصَوارِمِ ما لَقينا",0,"ن",2,0],["وَعُدنَ وَقَد وَهى سِلكُ الثَرَيّا","وَكَرَّ الصُبحُ في طَلَبِ النُجومِ",1,"م",1,0],["وَعُدنا بِها وَاللَيلُ يَنفُضُ طَلَّهُ","سِقاطَ اللَآلي وَالنَسيمُ عَليلُ",2,"ل",1,0],["وَعدٌ لِعَينَيكِ عِندي ما وَفَيتِ بِهِ","يا قُربَ ما كَذَبَت عَينيَّ عَيناكِ",3,"ك",1,0],["وَعُدنا بِها حُمراً تَقيءُ صُدورُها","دِماءَ العِدى قَطرَ الأُنوفِ الرَواعِفِ",4,"ف",1,0],["وَعُدتَ بِهَ تُساوِكُ مِن وَجاها","دَبيبَ النَملِ يَنتَعِلُ البَلاطا",5,"ط",2,0],["وَعَدِمنَ كُلِّ مَفازَةٍ مَرهوبَةٍ","وَأَمِنَّ كُلَّ مُخاطِرٍ عَقّارِ",6,"ر",1,0],["وَعُدنا بِها مَمغوطَةً بِنُسوعِها","كَما صافَحَ الأَرضَ السَراءُ المُعَبِّبُ",7,"ب",1,0],["وَعَدتَ يا دَهرُ شَيئاً بِتُّ أَرقُبُهُ","وَما أَرى مِنكَ إِلّا وَعدَ عُرقوبِ",8,"ب",1,0],["وَعُدتُ وَقَد خَبَأتُ الحَربَ عَنهُ","إِلى سِلمِ الرَغائِبِ وَالعَطاءِ",9,"ا",2,0],["وَعَدتِ وَالخِلُّ مَوفِيٌّ لَهُ زُفَراً","بابنِ الغَمامِ مَشوباً بابنَةِ العِنَبِ",10,"ب",1,1],["وَعدتُم وَأَخلَفتُمُ وَالفَتى","إِلى ما يَلينُ بِهِ مُنجَذِبْ",11,"ب",1,1],["وعَدَتنيَ الأيّامُ عنكَ برُتْبَةٍ","ووَفورِ حَظٍّ منكَ غَيرَ طَفيفِ",12,"ف",1,0],["وعُدْتَ وتحتَ رايتك العَوالي","تُحدِّثُ عن حِماهُ المُسْتَباحِ",13,"ح",1,0],["وعُدْتُ أكُفُّ المَشْيَ مِن حَذَرِ العِدا","على قَدَمٍ يُخْفي مَواطِئَها المِرْطُ",14,"ط",1,0],["وَعُدتُ مُخَضَّباً بِدَمِ الأَعادي","وَكَربُ الرَكضِ قَد خَضَبَ الجَوادا",15,"د",2,0],["وَعُدنا وَالفَخارُ لَنا لِباسٌ","نَسودُ بِهِ عَلى أَهلِ الزَمانِ",16,"ن",1,0],["وَعَداوَةُ الشُعَراءِ داءٌ مُعضِلٌ","وَلَقَد يَهونُ عَلى الكَريمِ عِلاجُهُ",17,"ج",2,0],["وعدَلنَ عنْ جهْرِ السّلامِ مخا","فَةَ الواشي فجِئْنَ بلَفْظِه مهْموسا",18,"س",2,0],["وعُدْتَ يجُرُّ المُلْكُ خلْفَكَ ذَيْلَهُ","وفي حُكْمِكَ العُلْيا تَروحُ وتَغْتَدي",19,"د",2,0],["وَعَدا المَوتُ عَلى أَقمارِنا","فَتَهاوَوا قَمَراً بِعدَ قَمَر",20,"ر",1,0],["وَعَدا القَضاءُ عَلى القَضا","ءِ فَصابَهُ في المَقتَلِ",21,"ل",1,0],["وَعُدتَ إِلَيها حينَ ناداكَ نيلُها","أَقِل عَثرَتي فَالقَومُ في الظُلمِ أَبدَعوا",22,"ع",3,0],["وَعَدَلتُمُ فَمَلَكتُمُ ال","دُنيا وَفي العَدلِ الكِفايَه",23,"ا",3,0],["وَعَدّوا عَلَيهِ مِنَ السَيِّئاتِ","أُلوفاً تَدورُ مَعَ الأَحقُبِ",24,"ب",1,0],["وَعُدتَ فَقَرَّت عَينُ مِصرٍ وَأَصبَحَت","رِياضُ القَوافي في رَبيعٍ مُوَشَّعِ",25,"ع",1,0],["وَعُد إِلى الشَرقِ عَودَ الفاتِحينَ لَهُ","وَخُذ مَكانَكَ فيهِ فَوقَ كيوانِ",26,"ن",1,0],["وَعَدِمتُ بَعدَكَ لَذَّةَ الدُنيا فَقَد","أُنسيتُها حَتّى نَسيتُ رُقادي",27,"ي",1,0],["وَعَدَلتَ حَتّى لَم تَجِد مُتَظَلِّماً","وَأَخَفتَ حَتّى صاحَبَ الذِئبَ الطَلا",28,"ل",2,0],["وَعُدنا إِلى القَصرِ الَّذي هُوَ كَعبَةٌ","يُغاديهِ مِنّا ناظِرٌ أَو مُطَرَّفُ",29,"ف",1,0],["وَعَدَّت نَحوَ أَيمَنِها وَصَدَّت","عَنِ الكُثبانِ مِن صُعدِ وَخالِ",30,"ل",1,0],["وَعُدتَ عَلَيهِم بَعدَ بُؤسى بِأَنعُمٍ","فَكُلُّهُمُ تُعنى بِهِ وَتُواصِلُه",31,"ل",2,0],["وعد جحشاً خفيفاً","على الحمول الثقال",32,"ل",1,0],["وَعُدَّ ذَنْباً عَلَيْنَا مَا يُشَرِّفُنَا","وَعُدَّ رَفْعاً لَنَا مَا بَاتَ يُدْنِينَا",33,"ن",2,0],["وَعَدِمْتُ لَذَّاتِ الرُّؤى","وَعَدِمْتُ لَذَّاتِ التَّمَنِّي",34,"ن",2,0],["وَعداً بِأُخرى عَزَّ مَطلَبُها","صَبّاً يَطا مِن دونِها الحَسَكا",35,"ك",2,0],["وعدَّت لقاء السحب عيداً وموسماً","لذاك اغتدت بالزَّمرِ تُلهي الغواديا",36,"ي",2,0],["وعدتُ لقُطري شاكراً ما بلّوتُهُ","من الخُلُقِ المحمودِ والحَسَبِ العِدِّ",37,"د",1,0],["وعدوكم من قبل مملكة العُرْ","ب اجتلَوْها بالمَيْن وافترضوها",38,"و",3,0],["وعَدَت فأمسى القوم بين مشّكِك","ومنتظر الإنجاز منشرح الصدر",39,"ر",1,0],["وعَدُّوهنّ أضعف من ذباب","بلا جنح وأهون من َشذاة",40,"ه",1,0],["وعدَّ الرقيبُ خِصالَ الضريب","لا عن أفانين وكْسا قِمارا",41,"ر",2,1],["وَعُدتُ كَريمَ البَطشِ وَالعَفوُ ظافِراً","أُحَدِّثُ عَن يَومٍ أَغَرَّ مُحَجَّلِ",42,"ل",1,0],["وَعُدتُ أَجَرُّ رُمحي عَن مَقامٍ","تُحَدِّثُ عَنهُ رَبّاتُ الحِجالِ",43,"ل",1,0],["وَعُدتُ وَقَلبي في سِجافِ غَبيطَهُ","وَلي لَفَتاتٌ نَحوَ هَودَجِهِ كُثرُ",44,"ر",1,0],["وَعِدّاً خَطيباً لا يُطاقُ جَوابُهُ","وَذا أُربَةٍ في شِعرِهِ مُتَنَخِّلا",45,"ل",2,0],["وعدت بطيف خيالها هيفاءُ","إن كان يمكن مقلتي إغفاء",46,"ا",2,1],["وعدّ البرايا حسنها فهو أوَّلٌ","وشمس الضحى والبدر ثانٍ وثالث",47,"ث",1,0],["وعدت في نظم إلى سبّقٍ","يعرفها النظَّام من غاد",48,"د",1,0],["وعدت مشكور الثنا والسنا","كذاك عودُ البدرِ في سعده",49,"د",2,0],["وعِدى الفضل ناقصون ولكن","نحرهم جائز الضحايا مفيد",50,"د",1,0],["وعداك أرضى أن تعيش فإنها","ببقاك في عيش أمرّ من الردى",51,"د",2,0],["وعدت بيسرتي فازددت عسراً","فلا أدري أوعدٌ أو وعيد",52,"د",1,0],["وعدنا لودٍّ يملأ القلب عوده","بشحمٍ كهدَّاب الدَّمقس المفتل",53,"ل",1,0],["وعدمنا نحن الندى ولقينا","يتقاضى وفد الرجاء جلاله",54,"ل",2,0],["وعدتَ إلى أوطان يثرب غانماً","وفي كلّ أرضٍ من نداك مغانم",55,"م",1,0],["وعدهُ مثل خصره من جفاءٍ","باطنيٌّ يقول بالمعدوم",56,"م",1,0],["وعدتَ ع