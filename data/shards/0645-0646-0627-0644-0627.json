ttps://www.poetsgate.com/ViewPoem.aspx?id=208587",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5409,"علاك يقصر عن إدراكه الكلم","https://www.poetsgate.com/ViewPoem.aspx?id=155497",""],[5452,"عذابي","https://www.poetsgate.com/ViewPoem.aspx?id=120639",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""],[5595,"دُمْ في عُلاكَ مُعلّماً كلَّ الورى","https://www.poetsgate.com/ViewPoem.aspx?id=144653",""],[243,"رثاء القطيع","https://www.poetsgate.com/ViewPoem.aspx?id=50482",""],[5674,"نزف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=196438",""],[5748,"أرض منمنمة وظل سجسج","https://www.poetsgate.com/ViewPoem.aspx?id=26140",""],[402,"أهدى غلأي عصا صديقي طاهر","https://www.poetsgate.com/ViewPoem.aspx?id=36455",""],[5790,"لك الله إن العفو أقرب للتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=111926",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[4615,"لو جئتَ نارَ الهُدى من جانبِ الطُّوْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=17845",""],[5820,"من الأكرمين البيض من آل هاشم","https://www.poetsgate.com/ViewPoem.aspx?id=201349",""],[5845,"حروفُ معانٍ أو عقودُ جوا","https://www.poetsgate.com/ViewPoem.aspx?id=16707",""],[5848,"كاس الما","https://www.poetsgate.com/ViewPoem.aspx?id=48961",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5956,"شهامةُ المرء تبدو من مواقفِهِ *","https://www.poetsgate.com/ViewPoem.aspx?id=182927",""],[5956,"كم أنشأتُ قصرا","https://www.poetsgate.com/ViewPoem.aspx?id=183887",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6058,"الأنفاس","https://www.poetsgate.com/ViewPoem.aspx?id=192258",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6189,"خصوصية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83572&r=&rc=39",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""],[2220,"الله أكبر ما بالدارِ من أحدٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11332&r=&rc=206",""]],"verses":[["مِن أَلالٍ حَفَزوا العي","سَ كَما ريعَ النَعامُ",0,"م",1,0],["مِنَ الأَسوَدِ الساري وَإِن كانَ ثائِراً","عَلى حَدِّ نابَيهِ السَمامُ المُثَمَّلُ",1,"ل",1,0],["مِنَ الأَوانِسِ حَلّاها يَراعُ فَتىً","صافي القَريحَةِ صاحٍ غَيرِ نَشوانِ",2,"ن",1,0],["مِن آلِ أَيّوبَ أَغنَتنا عَوارِفُهُ","في كالِحِ الجَدبِ أَن نَستَنزِلَ المَطَرا",3,"ر",2,0],["مِنْ الآسِ إنِّي وقد زَانَتْ يَدِي","فَإنِّي بِإيفاءِ الجَمِيلِ مُدَانِ",4,"ن",1,0],["مِنَ الأَصحَّاءِ وَالعِلاَّتِ تَكْنُفُهُمْ","ألسَّالِمِينَ بِأَخْلاقٍ وَأَبْدَانِ",5,"ن",1,0],["مِنَ الأُولَى مَا وَنَوْا عَن وَاجِبٍ فَبَنَوْا","لِعِزِّ مِصْرَ طِرافاً كَانَ مَهْدُومَا",6,"م",2,0],["مِنَ الأُولَى صَبَرُوا الصَّبْرَ الجَمِيلَ وَقَدْ","ذَاقُوا الكَرِيهَيْنِ تَقْتِيلاً وَتَكْلِيمَا",7,"م",2,0],["مِن آلِ أَبي موسى تَرى الناسَ حَولَهُ","كَأَنَّهُمُ الكِروانُ أَبصَرنَ بازيا",8,"ي",2,0],["مِن الأُدَمى وَالرَملِ حَتّى كَأَنَّها","قِسِيٌّ بَرايا بَعدَ خَلقٍ ضُبارِمِ",9,"م",1,0],["مِنَ الأَشرَفاتِ البيضِ في غَيرِ مُرهَةٍ","ذَواتِ الشِفاهِ الحُوِّ وَالأَعيُنِ النُجلِ",10,"ل",1,0],["مِنَ الأَخدَرِيّاتِ اللَواتي حَياتُها","عُيونُ العِراقِ فَيضُهُ وَجَداوِلُه",11,"ل",2,0],["مِنَ الأُدَمى أَتَينَكَ مُنعَلاتٍ","يُقَطِّعنَ السَرائِحَ وَالخِداما",12,"م",2,0],["مِنَ الأَصلابِ يَنزِلُ لُؤمُ تَيمٍ","وَفي الأَرحامِ يُخلَقُ وَالمَشيمِ",13,"م",1,0],["من الأرحَبِيَّاتِ العِتَاقِ كأنَّها","شَبُوبٌ صِوَارٍِ فَوقَ عَلياءَ قَرهَب",14,"ب",1,0],["من الأولادِ خمسٌ حولَ أمٍّ","فوا حرباه من خمسٍ وستّ",15,"ت",1,0],["من الأريحياتِ التي تُمتَرى الندى","فتَنْدَى وتلقَى غمرةً فتقحَّمُ",16,"م",1,0],["مِنَ الأَعارِبِ لَكِن حينَ أُنشِدُهُ","جَواهِرَ الشِعرِ أَلقاهُ مِنَ العَجَمِ",17,"م",1,0],["مِن الأَوانِسِ مِكسالٌ مُبَتّلة","خَودٌ غَذَاها بلِين العَيشِ غاذيها",18,"ي",3,0],["من الأمراء العسكريين دأبه","صيان الحمى أكرم بذلك من دأب",19,"ب",1,0],["مِنَ الإِناثِ سِوى أَنَّ الزَمانَ لَها","عَبدٌ وَأَنَّ المَلا خُدّامُ ناديها",20,"ي",3,0],["مِن آلِ إِسماعيلَ لا العَمّاتُ قَد","قَصَّرنَ عَن كَرَمٍ وَلا الأَعمامُ",21,"م",1,0],["مِنَ الأَمعُزِ اللاتي وَرِثتَ كِلابَها","وَأَرباقَها كَلباً قَصيرَ القَوائِمِ",22,"م",1,0],["مِنَ الأَكرَمينَ مَنصِباً وَضَريبَةً","إِذا ما شَتا تَأوي إِلَيهِ الأَرامِلُ",23,"ل",1,0],["مِن الأَسدِ قَد أَحمى العَرينِ مَهابَةً","تفادى سِباعَ الأَرضِ مِنهُ تَفاديا",24,"ي",2,0],["مِنَ الأَربِعاءِ إِلى الأَربِعاءِ","إِلى الأَربِعاءِ إِلى الأَربِعاءِ",25,"ا",2,0],["مِنَ الإِثنَينِ إِلى الإِثنَينِ","إِلى الإِثنَينِ إِلى الإِثنَينِ",26,"ن",1,0],["مِنَ الأَحَد إِلى الأَحَد","إِلى الأَحَد إِلى الأَحَد",27,"د",1,0],["مِن آلِ أَيّوبَ الَّذينَ سَماحُهُم","بِحرٌ بِأَمواجِ النَدى مَسجورُ",28,"ر",1,0],["مِن آلِ أَيّوبَ الَّذينَ أَصبَحوا","كَواكِباً بِها الأَنامُ تَهتَدي",29,"د",2,0],["مِن آلِ أَيّوبٍ الَّذينَ لَهُم","حَماسَةٌ بِالسَماحِ مُقتَرِنَه",30,"ن",2,0],["مِن آلِ أُرتُقٍ الصيدِ الأُلى رَتَقوا","فَتقَ العُلى بَعدَما حالَت بِها الغِيَرُ",31,"ر",1,0],["مِن آلِ أُرتُقٍ المَشهورِ ذِكرُهُمُ","إِذ كانَ كَالمِسكِ إِن أَخفَيتَهُ ظَهَرا",32,"ر",2,0],["من الأدب العالي إذا راح سيد","غدا آخر نحو اللواء فما ونى",33,"ن",2,0],["مِنَ الأَنواءِ مُنهَمِرٌ مُلِتٌّ","لِفَودَيهِ الكَثافَةُ وَالهُدوبُ",34,"ب",1,0],["مِنَ الأُلى نَستَجيرُ مِن شَرَقِ الدَه","رِ بِهِم إِن أَلَمَّ أَو جَرَضِه",35,"ض",2,0],["مِن آلِ المُغيرَةِ لا يَشهَدو","نَ عِندَ المَجازِرِ لَحمَ الوَضَم",36,"م",1,0],["مِنَ الأُدمِ تَعطو بِالعَشِيِّ وَبِالضُحى","مِنَ الضالِ غَضّاً ناعِمَ النَبتِ مورِقا",37,"ق",2,0],["مِن آلِ أَبي بَكرَةَ الأَكرَمينَ","خَصَصتُ بِوِدّي فَأَصفَيتُها",38,"ت",3,0],["مِنَ الأناسيِّ إلا أنّها مَرَدتْ","فالجنُّ تَنظرُ من ساهٍ ومسحورِ",39,"ر",1,0],["مِنَ الأَيّامِ لا أَلقاكَ عَشرٌ","أَطَلتُ بِها عَلى الزَمَنِ العِتابا",40,"ب",2,1],["مَنَّ الإِلاهُ عَلَيكَ فَاِحمِل مَنَّهُ","وَوَسيلَةٌ لَكَ في جَديلَةَ فَاِذهَبِ",41,"ب",1,0],["مِنَ الأَدم يعطُو بِالعَشِيِّ وَبِالضُحى","مِنَ الضالِ غُصناً ناعِمَ النَبتِ مُرِقا",42,"ق",2,0],["مِنَ الآن فَاترُك طِلاب الَّذي","تَوَلّى مِنَ الأَمرِ إِذ أَصبَحُوا",43,"ح",3,0],["منَ الأعْوَجيّاتِ التي ترزُقُ الغِنى","وتَضْمَنُ أقواتَ النُّسورِ القشاعم",44,"م",1,0],["من آل أحمدَ كلُّ فخْرٍ لم يكُنْ","يُنْمَى إليهم ليس فيه فَخار",45,"ر",1,0],["من آلِ أعوَجَ والصريح وداحسٍ","فيهنَّ منْها مِيسَمٌ ونِجار",45,"ر",1,0],["مِنَ الأَعرابِ قَد مَحَشَت","ضَواحي جِلدِهِ النُجُدُ",46,"د",1,0],["مِنَ الإِوَزِّ الخانِساتِ تَقفِرُه","صَكّاً إِذا جَدَّ بِهِ تَقَدُّرُه",47,"ر",2,0],["مِنَ الإِحسانِ والإِكرامِ فِعلاً","يُزانُ بهِ إلَى يَومِ النُّشُورِ",48,"ر",1,0],["مَنالُ السَّلاَمَةِ دَانٍ لِمَنْ","تُعِينُونَ فِي حَضَرٍ أَوْ سَفَرْ",49,"ر",1,0],["مِنَ الأَمَاجِدِ الأُلَى وُدُّهُمْ","ثَبُتَ بِرَغْمِ الزَّمَنِ الحُوُّلِ",50,"ل",1,0],["مِنَ الأَثلِ أَمّا طَلُّها فَهوَ بارِزٌ","أَثيثٌ وَأَمّا نَبتُها فَأَنيقُ",51,"ق",1,0],["من الأعاب لكن أنشده","جواهر الشّعر ألقاه من العجم",52,"م",1,0],["مِنَ الأمْعُزِ اللاّتي ورِثْتَ كِلابَهَا","وَأرْبَاقَهَا، تَيْساً قَصِيرَ القَوَائِمِ",53,"م",1,0],["من الأدب العالي ذا راح سيد","غدا آخر نحو اللواءِ فما ونى",54,"ن",2,0],["من الألى شمخت في المجد همتهم","مراتب الشهب عدوها لهم خططا",55,"ط",2,0],["مِنَ الأُدْمِ تَعْطو بِکلْعَشِيِّ وَبِالضُّحَى","مِنَ الضَّالِ، غُصناً نَاعِمَ النَّبْتِ مُورِقا",56,"ق",2,0],["من آلِ إسماعيلَ، ولا العمَّاتُ قد","قصَّرن عن كرم، ولا الأعمام",57,"م",1,0],["من الاحمديين الذين تتوجت","باذيالهم في برجها هامة النسر",58,"ر",1,0],["من الاحمديين الذين لبيتهم","رفيع المباني في بيوت الحقيقة",59,"ه",1,0],["مِنَ الأَكرَمينَ في لؤيِّ بنِ غالِب","إِذا سيمَ خَسفاً وَجهُهُ يَتَرَبَّدُ",60,"د",1,0],["مِنَ الأُلى هَذَّبَتهُم ذي العُلى فَحَوَوا","حَظّاً مِن الجودِ وَالإِقدامِ وَالأَدَبِ",61,"ب",1,0],["مِنَ الأُلى غَيرَ ضُمَّرِ الخَيلِ ما","قادوا وَغيرَ الكُماةِ ما ضَرَبوا",62,"ب",3,0],["مِنَ الأُسَرِ الَّتي أَلوَت بِكِسرى","وَذاكَ وَمَن سِلاحُهُمُ الجَريدُ",63,"د",1,0],["مِنَ الأُسرَةِ الشُمِّ الَّذينَ تَحَمَّلوا","إِلى كُلِّ ذِكرٍ طَيِّبٍ كُلَّ ما شَقّا",64,"ق",2,0],["من الإله لهم قال افعلوا وذروا","ما شئتم لكم أوجبت غفرانا",65,"ن",2,0],["مِنَ الأَبِ أَحنىَ بَل مِنَ الأُمِّ أَرحَمُ","جَميلٌ جَليلٌ في القُلوبِ مُعَظَّمُ",66,"م",1,0],["من الآن صار الملك لابن ورا أب","ولم يبق فيه مطمع للأخوة",67,"ه",1,0],["مِنَ الأُلى جَوهَرُهُم إِذا اِعتَزَوا","مِن جَوهَرٍ مِنهُ النَبِيُّ المُصطَفى",68,"ا",1,0],["مَنالُ العُلى بِالمُرهفاتِ القَواضِبِ","وَسُمرِ العَوالي وَالعِتاقِ الشَوازِبِ",69,"ب",1,1],["مِن الأُمرا الشهابيين غُصنٌ","ثَوى في اللَحدِ مِعطَفُهُ النَضيرُ",70,"ر",1,1],["مِن آلِ أَرقشَ راحلٌ لَمّا مَضى","أَدمى عُيونَ الباكياتِ رَحيلُهُ",71,"ل",2,1],["مِن آلِ أَزرَقَ قَد أَفاضَ مياهَهُ","بيضاً يُصافِحُها النَباتُ الأَخضرُ",72,"ر",1,0],["من آلِ أعوجَ ما عَهدْنا قبْلَهُ","وقد انتمى بَرْقاً نماهُ أعوج",73,"ج",1,0],["مِنَ الأَيّامِ لَم تَسمَع كَيَومٍ","وَلَم يَسمَع بِهِ قَومٌ ذُكورُ",74,"ر",1,0],["من الاكرمين السابقين إلى العلا","من الصفوة الانجاب والسادة الغر",75,"ر",1,0],["مِنَ الأَرضِ أَنشقُ أَعرافَ شِعرِك","رَيّانَةً كَالنَدى صافِيَه",76,"ي",2,0],["منال المنى بالعجز غير يسير","ومغنى الغنى بالذل بيت فقير",77,"ر",1,1],["من الأقداحِ والأحداقِ سكري","فدع للنوكِ تجميعَ النقود",78,"د",1,0],["مِن الإفرَنجِ لاَ يُرجى حياءٌ","فصونوا نضرةَ الوجهِ الحيي",79,"ي",1,0],["من الازل استفتاحها مستمرة","الى أَبد الآباد آخر آخر",80,"ر",1,0],["مِنَ الأنسِ إلّا أنّ لِلجنّ فيهمُ","مشابهَ يُبديها شواظُ الوَغى قَعطا",81,"ط",2,0],["مِنَ الأُسد الكِرامِ إِن حَلَّ جارُ","فمعَ النَجم لا يضخاف عَريبا",82,"ب",