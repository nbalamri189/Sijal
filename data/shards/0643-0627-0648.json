{"poems":[[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[475,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"]],"verses":[["كَأَوَّلِ نَبْتِ الحَقْلِ يَجْمُلُ نَامِيَا","وَلاَ تَفْرُقُ العينُ الغَرِيب المُضَاهِيَا",0,"ي",2,0],["كأُويسٍ إذا دعا في تُقاه","وإياسٍ إذا قضىَ في الذّكاء",1,"ا",2,0],["كَأَوبِ الدَبرِ غامِضَةٍ وَلَيسَت","بِمُرهفَةِ النِصالِ وَلا سِلاطِ",2,"ط",1,0]]}