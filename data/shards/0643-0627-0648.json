{"poems":[[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[480,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54020","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88559","المتقارب"],[5577,"هجرة","https://www.poetsgate.com/ViewPoem.aspx?id=176246",""]],"verses":[["كَأَوَّلِ نَبْتِ الحَقْلِ يَجْمُلُ نَامِيَا","وَلاَ تَفْرُقُ العينُ الغَرِيب المُضَاهِيَا",0,"ي",2,0],["كأُويسٍ إذا دعا في تُقاه","وإياسٍ إذا قضىَ في الذّكاء",1,"ا",2,0],["كَأَوبِ الدَبرِ غامِضَةٍ وَلَيسَت","بِمُرهفَةِ النِصالِ وَلا سِلاطِ",2,"ط",1,0],["كأولي العلوم الغرّ من أسلافه","النازلين من العلى بروابِ",3,"ب",1,0],["كأو على بل مع جماعة كأم","ضارع وصغر رب ثمن والقسم",4,"م",1,0],["كَأَورَقَ ذَلَّ لَيسَ لَهُ جَناحٌ","عَلى عودَينِ يَلعَبُ بِالهَديلِ",5,"ل",1,0],["كَأَوْبَةِ أَحْبابِهِ عِنْدَهُ","حُلُولُ وُفُودٍ يليهِمْ وُفُودُ",6,"د",1,0],["كأوظفة الفالج الموصلى","لا هو رِيضَ ولم يرحَل",7,"ل",1,0],["كأوهن فكرةٍ نسجتْ علينا","تؤلف بيننا جرحًا وبؤسا !!",8,"س",2,0]]}