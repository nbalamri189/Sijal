{"poems":[[54,"سرى ليلة حتى أداء عمودها","https://www.aldiwan.net/poem27134.html","الطويل"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[119,"بعسكر ليلي جئت بالذل راجيا","https://www.aldiwan.net/poem42001.html","الطويل"],[412,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131329","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"]],"verses":[["بِعَسكَرِ أَبطالٍ تَبيتُ كُماتُهُ","وَإِن نَزَحَت عَنهُ قَليلاً هُجودُها",0,"د",3,0],["بِعَسكَرٍ ظَلَّت عَناجيجُهُ","في القودِ مِن طِرفٍ وَمِن سَلهَبِ",1,"ب",1,0],["بعسكر ليلي جئت بالذل راجيا","بلوغ الأماني ثم أصبحت لاجيا",2,"ي",2,1],["بِعَساكِرٍ مِن جُندِهِ وَعَساكِرٍ","مِن بَأسِهِ وَعَساكِرٍ مِن رائِهِ",3,"ا",3,0],["بِعَسْكَرٍ منْ أَحْسَنِ الخَلائقِ","وقد حوى لأَحْسَنِ الخَلائقِ",4,"ق",1,0],["بِعَسَاكِرِ الوَحيَينِوالفِطَرَات وال","مَعقُولِ وَالمَنقُولِ بِالإحسَانِ",5,"ن",1,0],["بعسكر ساقه والنصر قائده","كصيب من خلال المزن منصب",6,"ب",1,0]]}