{"poems":[[53,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[63,"إذا زم للبين الغداة جمال","https://www.aldiwan.net/poem46158.html","الطويل"],[35,"هو التيس لؤما وهو إن راء غفلة","https://www.aldiwan.net/poem39617.html","الطويل"],[30,"أمن دمنة بالجو جو جلاجل","https://www.aldiwan.net/poem29571.html","الطويل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[51,"ومونقة الرواد مهتزة الربا","https://www.aldiwan.net/poem9395.html","الطويل"],[51,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[45,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[87,"ألم يأن أن يرضى عن الدهر مغرم","https://www.aldiwan.net/poem8248.html","الطويل"],[46,"إذا مدحوا آدميا مدح","https://www.aldiwan.net/poem23438.html","المتقارب"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42713","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"أتَارِكِي أنْتَ أمْ مُغْرًى بتَعْذيبي","https://www.poetsgate.com/ViewPoem.aspx?id=31689",""],[158,"لنا بهواه حرمة وذمام","https://www.aldiwan.net/poem58939.html","الطويل"],[158,"أتتنا ما جردت صارمك البشرى","https://www.aldiwan.net/poem58956.html","الطويل"],[158,"يغر بحسن الرأى راج ويخدع","https://www.aldiwan.net/poem58992.html","الطويل"],[183,"ولله مجرى النيل فيها إذا الصبا","https://www.aldiwan.net/poem14794.html","الطويل"],[269,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[362,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[362,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[402,"إذا مدح الأقوام قرما بسؤدد","https://www.aldiwan.net/poem49811.html","الطويل"],[406,"ما وجد من فارق أحبابه","https://www.aldiwan.net/poem32344.html","السريع"],[413,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[426,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[429,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[459,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[459,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[493,"أعددت للضيف بيتا","https://www.aldiwan.net/poem10224.html","المجتث"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"]],"verses":[["إِذا مَدَّ بِالأَعناقِ قَعقَعَ رَعدُهُ","كَعودِ المَلا إِن عَضَّهُ العِبُّ جَرجَرا",0,"ر",2,0],["إِذا مَدَحتُكَ لَم أَمنُن عَلَيكَ بِهِ","فَالمَدحُ بِاِسمِكَ وَالمَعنى بِهِ نَسَبي",1,"ب",2,0],["إِذا مُدَّتِ النارُ باعَ الشُعاعِ","مَدَدنا إِلَيها ذِراعَ القِرى",2,"ا",1,0],["إذا مَدَّ منْ نَبَراتِ الصّهيلِ","ثَنى مِسْمَعَيْهِ لهُ المُعْرِبُ",3,"ب",1,0],["إذا مَدَّ مِنْ أثْناءِ خُطْوَتِهِ المَدى","فليسَ يُناجي أخْمَصَيْهِ كَلالُ",4,"ل",1,0],["إِذا مَدَحَ البَكريُّ عِندَكَ نَفسَهُ","فَقُل كَذَب البَكرِيُّ وَهوَ كَذُوبُ",5,"ب",1,0],["إِذا مُدَّ حَبلانا أَصَرَّ بِحَبلِنا","هِشامٌ فَأَمسى في قُواهُ قَطوعُ",6,"ع",1,0],["إِذا مَدَّ أَصحابُ الصِبا بِأَكُفِّهِم","إِلَيها لِيُصبوها أَتَتهُم بِها صِفرا",7,"ر",2,0],["إِذا مُدَّ غَلوُ الجَريِ طاحَ اِبنُ فَرتَنى","وَجَدَّ التِجاري فَالفَرَزدَقُ ظالِعُ",8,"ع",1,0],["إِذا مَدّوا بِحَبلِهِمُ مَدَدنا","بِحَبلٍ ما لِعُروَتِهِ اِنفِصامُ",9,"م",1,0],["إذا مدّها المهموم في صُعدائه","إلى قلبه انساحت عليه الجوانحُ",10,"ح",1,0],["إذا مدحَ المادحُ الناقصي","نَ ذكَّرهُم فوزَةَ الفاضلِ",11,"ل",1,0],["إِذا مَدَدنَ إِلى إِعراضِهِ سَبَباً","وَقَينَ مِن كُرهِهِ الشُبّانَ بِالشَيبِ",12,"ب",1,0],["إِذا مَدَحتُهُمُ كانوا بِأَكذَبِ ما","وَأَوهُ أَخلَقَ أَقوامٍ بِتَكذيبي",12,"ب",2,0],["إذا مُدِحَ الأملاك قام بمدحِهِ","لهُ قَدَمُ الدنيا على قَدَمِ الفخرِ",13,"ر",1,0],["إِذَا مَدَّ مِنْ أَنْفَاسِهِ لاحَ بَارِقٌ","وَإِنْ حَلَّ مِنْ أَجْفَانِهِ فَاضَ خِضْرِمُ",14,"م",1,0],["إِذا مَدَحوا آدَمِيّاً مَدَح","تُ مَولى المَوالي وَرَبَّ الأُمَم",15,"م",1,1],["إِذا مَدَّت رَوامِقَها إِلَيها","قَوابِسَ لَم يَعُجنَ بِما قَبَسنَه",16,"ن",2,0],["إِذَا مَدَّ مِنْ صَوْتٍ وَرَجَّعَ أَقْبَلَتْ","عَلَيْنَا وُجُوهُ الْعَيْشِ وَهْوَ رَقِيقُ",17,"ق",1,0],["إِذا مَدَّ زَنْدَ العَزْمِ في إِثْرِ مَطْلَبٍ","تَدَانَتْ أَقَاصِيه ولاَنَتْ مَصَاعِبُه",18,"ب",2,0],["إذا مدَّ كفّاً له ناكث","تصدَّى ليقطَعها مُبْرِم",19,"م",1,0],["إذا مَدَحْتُهُمُ كانُوا، بأكاذبِ ما","وَأوْه، أخْلَقَ أقْوَامٍ بتَكْذِيبي",20,"ب",2,0],["إذا مدّ للعلياء باعاً تخاضعت","من الشهب أعناق وطؤطئ هامُ",21,"م",1,0],["إذا مد منهم نحوها الطرف عاشق","أعادته من اعراضها النظر الشزرا",22,"ر",2,0],["إذا مد نحوى كفه قلت كفها","فإني عليم أن عدت كيف تقطع",23,"ع",1,0],["إذا مد ناس نحوها الطرف رده","خيال سنان بين عينيه يلمع",23,"ع",1,0],["إذا مَدَّحاكَي الوردَ غَضّا وإنْ صَفا","حَكَى ماءَه لونا ولم يَعْدُه شبرا",24,"ر",2,0],["اذا مدح الشعراء أَرباب عصرهم","مدحت الَّذي من نوره الكون ينهج",25,"ج",1,0],["إذا مدَحْنا جمالَ الدّينِ أطْرَبنا","إهداءُ مَدْحٍ له بالصِّدْقِ مُقْتَرِن",26,"ن",1,0],["إذا مَدَّتِ الأعناقَ أجمالُ سائرٍ","إليه تَلقّتْهُنّ أجمالُ آئب",27,"ب",1,0],["إذا مدحَ الأقوامُ قَرْماً بسؤْددٍ","وأعلَوْا لهُ ذِكْرا ونَثُّوا لهُ فَضْلا",28,"ل",2,1],["إذا مَدَحْنا ماجداً غَيرَه","فَما أردَنا بمديحٍ سِواهُ",29,"ا",2,0],["إذا مُدَّتْ الأَيدي إليه أمدَّها","بجدوى يَمين تُورِثُ الأَبحرَ المدَّا",30,"د",2,0],["إذا مدّ قرطاسا وانشا رسالة","يجر على سحبان اردية الستر",31,"ر",1,0],["إذا مدّ ممتنّاً عليك جناحَهُ","فنادِ صُروفَ الدّهرِ هل من يكافح",32,"ح",1,0],["إذا مَدَّ إظلامُ الأسى ظُلَمَ الدُّجى","تَمَثَّلَ لي من نورِ وجهِكَ مِصباحُ",33,"ح",1,0],["إذا مدحتُ مُعزَّ الدين آونةً","فما زهيرٌ بمذكورٍ ولا هرمُ",34,"م",1,1],["إِذا مَدَّ دُفَّاعُ الجِراحِ بقفرةٍ","فصوَّانُها مُغْروْرقٌ وسِلامُها",35,"م",3,0],["إذا مددت إليه","يمناي آبت بعضّه",36,"ض",2,0],["إذا مدحتُك لم أقرعْ بلائمةٍ","وبات يعذرني من بات يعذُلني",37,"ي",1,0]]}