{"poems":[[55,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[55,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[65,"إذا زم للبين الغداة جمال","https://www.aldiwan.net/poem46158.html","الطويل"],[37,"هو التيس لؤما وهو إن راء غفلة","https://www.aldiwan.net/poem39617.html","الطويل"],[32,"أمن دمنة بالجو جو جلاجل","https://www.aldiwan.net/poem29571.html","الطويل"],[32,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[29,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[53,"ومونقة الرواد مهتزة الربا","https://www.aldiwan.net/poem9395.html","الطويل"],[53,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[47,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[82,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[89,"ألم يأن أن يرضى عن الدهر مغرم","https://www.aldiwan.net/poem8248.html","الطويل"],[48,"إذا مدحوا آدميا مدح","https://www.aldiwan.net/poem23438.html","المتقارب"],[48,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42713","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[47,"أتَارِكِي أنْتَ أمْ مُغْرًى بتَعْذيبي","https://www.poetsgate.com/ViewPoem.aspx?id=31689",""],[164,"لنا بهواه حرمة وذمام","https://www.aldiwan.net/poem58939.html","الطويل"],[164,"أتتنا ما جردت صارمك البشرى","https://www.aldiwan.net/poem58956.html","الطويل"],[164,"يغر بحسن الرأى راج ويخدع","https://www.aldiwan.net/poem58992.html","الطويل"],[189,"ولله مجرى النيل فيها إذا الصبا","https://www.aldiwan.net/poem14794.html","الطويل"],[276,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[369,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[369,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[411,"إذا مدح الأقوام قرما بسؤدد","https://www.aldiwan.net/poem49811.html","الطويل"],[415,"ما وجد من فارق أحبابه","https://www.aldiwan.net/poem32344.html","السريع"],[422,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[435,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[438,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[445,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[466,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[466,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[500,"أعددت للضيف بيتا","https://www.aldiwan.net/poem10224.html","المجتث"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122786","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122622","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129535","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62447","المتقارب"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112745","الطويل"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128301","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26670","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52089","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69366","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53181","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111251","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137060",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93813","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100292","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100834","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112694","الوافر"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129463","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102949","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58015","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58140","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58009","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136397",""],[5650,"ليسَ غيرُ التّيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=181696",""],[469,"ولو يملك الملك الأهلة عنده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574823",""]],"verses":[["إِذا مَدَّ بِالأَعناقِ قَعقَعَ رَعدُهُ","كَعودِ المَلا إِن عَضَّهُ العِبُّ جَرجَرا",0,"ر",2,0],["إِذا مَدَحتُكَ لَم أَمنُن عَلَيكَ بِهِ","فَالمَدحُ بِاِسمِكَ وَالمَعنى بِهِ نَسَبي",1,"ب",2,0],["إِذا مُدَّتِ النارُ باعَ الشُعاعِ","مَدَدنا إِلَيها ذِراعَ القِرى",2,"ا",1,0],["إذا مَدَّ منْ نَبَراتِ الصّهيلِ","ثَنى مِسْمَعَيْهِ لهُ المُعْرِبُ",3,"ب",1,0],["إذا مَدَّ مِنْ أثْناءِ خُطْوَتِهِ المَدى","فليسَ يُناجي أخْمَصَيْهِ كَلالُ",4,"ل",1,0],["إِذا مَدَحَ البَكريُّ عِندَكَ نَفسَهُ","فَقُل كَذَب البَكرِيُّ وَهوَ كَذُوبُ",5,"ب",1,0],["إِذا مُدَّ حَبلانا أَصَرَّ بِحَبلِنا","هِشامٌ فَأَمسى في قُواهُ قَطوعُ",6,"ع",1,0],["إِذا مَدَّ أَصحابُ الصِبا بِأَكُفِّهِم","إِلَيها لِيُصبوها أَتَتهُم بِها صِفرا",7,"ر",2,0],["إِذا مُدَّ غَلوُ الجَريِ طاحَ اِبنُ فَرتَنى","وَجَدَّ التِجاري فَالفَرَزدَقُ ظالِعُ",8,"ع",1,0],["إِذا مَدّوا بِحَبلِهِمُ مَدَدنا","بِحَبلٍ ما لِعُروَتِهِ اِنفِصامُ",9,"م",1,0],["إذا مدّها المهموم في صُعدائه","إلى قلبه انساحت عليه الجوانحُ",10,"ح",1,0],["إذا مدحَ المادحُ الناقصي","نَ ذكَّرهُم فوزَةَ الفاضلِ",11,"ل",1,0],["إِذا مَدَدنَ إِلى إِعراضِهِ سَبَباً","وَقَينَ مِن كُرهِهِ الشُبّانَ بِالشَيبِ",12,"ب",1,0],["إِذا مَدَحتُهُمُ كانوا بِأَكذَبِ ما","وَأَوهُ أَخلَقَ أَقوامٍ بِتَكذيبي",12,"ب",2,0],["إذا مُدِحَ الأملاك قام بمدحِهِ","لهُ قَدَمُ الدنيا على قَدَمِ الفخرِ",13,"ر",1,0],["إِذَا مَدَّ مِنْ أَنْفَاسِهِ لاحَ بَارِقٌ","وَإِنْ حَلَّ مِنْ أَجْفَانِهِ فَاضَ خِضْرِمُ",14,"م",1,0],["إِذا مَدَحوا آدَمِيّاً مَدَح","تُ مَولى المَوالي وَرَبَّ الأُمَم",15,"م",1,1],["إِذا مَدَّت رَوامِقَها إِلَيها","قَوابِسَ لَم يَعُجنَ بِما قَبَسنَه",16,"ن",2,0],["إِذَا مَدَّ مِنْ صَوْتٍ وَرَجَّعَ أَقْبَلَتْ","عَلَيْنَا وُجُوهُ الْعَيْشِ وَهْوَ رَقِيقُ",17,"ق",1,0],["إِذا مَدَّ زَنْدَ العَزْمِ في إِثْرِ مَطْلَبٍ","تَدَانَتْ أَقَاصِيه ولاَنَتْ مَصَاعِبُه",18,"ب",2,0],["إذا مدحت بني ذبيان اخوتنا","أظهرت شمسا لها في العين برهان",19,"ن",1,0],["إذا مدَّ كفّاً له ناكث","تصدَّى ليقطَعها مُبْرِم",20,"م",1,0],["إذا مَدَحْتُهُمُ كانُوا، بأكاذبِ ما","وَأوْه، أخْلَقَ أقْوَامٍ بتَكْذِيبي",21,"ب",2,0],["إذا مدّ للعلياء باعاً تخاضعت","من الشهب أعناق وطؤطئ هامُ",22,"م",1,0],["إذا مد منهم نحوها الطرف عاشق","أعادته من اعراضها النظر الشزرا",23,"ر",2,0],["إذا مد نحوى كفه قلت كفها","فإني عليم أن عدت كيف تقطع",24,"ع",1,0],["إذا مد ناس نحوها الطرف رده","خيال سنان بين عينيه يلمع",24,"ع",1,0],["إذا مَدَّحاكَي الوردَ غَضّا وإنْ صَفا","حَكَى ماءَه لونا ولم يَعْدُه شبرا",25,"ر",2,0],["اذا مدح الشعراء أَرباب عصرهم","مدحت الَّذي من نوره الكون ينهج",26,"ج",1,0],["إذا مدَحْنا جمالَ الدّينِ أطْرَبنا","إهداءُ مَدْحٍ له بالصِّدْقِ مُقْتَرِن",27,"ن",1,0],["إذا مَدَّتِ الأعناقَ أجمالُ سائرٍ","إليه تَلقّتْهُنّ أجمالُ آئب",28,"ب",1,0],["إذا مدحَ الأقوامُ قَرْماً بسؤْددٍ","وأعلَوْا لهُ ذِكْرا ونَثُّوا لهُ فَضْلا",29,"ل",2,1],["إذا مَدَحْنا ماجداً غَيرَه","فَما أردَنا بمديحٍ سِواهُ",30,"ا",2,0],["إذا مُدَّتْ الأَيدي إليه أمدَّها","بجدوى يَمين تُورِثُ الأَبحرَ المدَّا",31,"د",2,0],["إذا مدّ قرطاسا وانشا رسالة","يجر على سحبان اردية الستر",32,"ر",1,0],["إذا مدّ ممتنّاً عليك جناحَهُ","فنادِ صُروفَ الدّهرِ هل من يكافح",33,"ح",1,0],["إذا مَدَّ إظلامُ الأسى ظُلَمَ الدُّجى","تَمَثَّلَ لي من نورِ وجهِكَ مِصباحُ",34,"ح",1,0],["إذا مدحتُ مُعزَّ الدين آونةً","فما زهيرٌ بمذكورٍ ولا هرمُ",35,"م",1,1],["إِذا مَدَّ دُفَّاعُ الجِراحِ بقفرةٍ","فصوَّانُها مُغْروْرقٌ وسِلامُها",36,"م",3,0],["إذا مددت إليه","يمناي آبت بعضّه",37,"ض",2,0],["إذا مدحتُك لم أقرعْ بلائمةٍ","وبات يعذرني من بات يعذُلني",38,"ن",2,0],["إذا مَدَّ السِّماطَ فَلا عَبُوسٌ","وَلا نَزِقٌ إذا خَطَرَ الخِوانُ",39,"ن",1,0],["إذا مُدِحتَ بآياتِ الكتابِ وبال","تَّوراةِ ماذا عسى سَجعي وأشعاري",40,"ر",2,0],["إذا مد نحوي شيخ الإسلام طرفه","بلغت المنى واستسهلت لي وعورها",41,"ر",3,0],["إذا مَدَّ لي الليثُ باعَ الأمان","فلا خوفَ إن نبحتْني الكلابْ",42,"ب",1,0],["إذا مددت البأساء إلينا يداً فلا","تنل واكففوها بالنبي بن غالب",43,"ب",1,0],["إذا مدها فوق الريح منشئها","فسبحت وهي فوق الماء في ميد",44,"د",1,0],["إذا مدحتُ ففي لخمٍ وسيّدها","عن الأنامِ وعمّا زخرفوا شُغَل",45,"ل",1,0],["إذا مَدَحَتْهُ الآيُ قَبلِي فما عَسَى","يُخَمِّنُ قَلبِي أو يَقُولُ لِسانِي",46,"ن",2,0],["إِذا مَدَّت بُغاةُ المَجدِ يَدّاً","إِلى طَلَبِ العَلاءِ مَدَدتَ باعا",47,"ع",2,0],["إذا مدّ الطراد رواق تقع","تعمد ضرب أعناق الرجال",48,"ل",1,0],["إذا مددت اليها الكف تحسبها","ريش النعامة أو ما خف من زغب",49,"ب",1,0],["اذا مد باعاً لصيد النجوم","هوى النسر منها لتحت الثرى",50,"ر",2,0],["إذا مدَّ بيضَ الهند تحتَ عَجَاجةٍ","تطاير فى فحمِ الظلامِ لهِيب",51,"ب",1,0],["إذا مدحت بنيه كدت أغضبه","كأنه ليس يرضى القول بالكذب",52,"ب",1,0],["إذا مدّت الأجياد قلن جآذر","عواطٍ ولكن أين منها الجآذر",53,"ر",1,0],["إذا مدوا حبال السوء يوما","فان اللَه يومئذ شهيد",54,"د",1,0],["إذا مدح الفتى شخصا سواكم","فإن مديحه هزل وغث",55,"ث",1,0],["إذا مدح أو بالعطاء وجهته","أتاك سريعا مظهرا للمحبة",56,"ه",1,0],["إذا مد كفا بالعطاء لوفده","أقام عطاه في تلاف الدراهم",57,"م",1,0],["إذا مد عند المشي رجلاً أمامه","توهمت عنها أختها تتوقف",58,"ف",1,0],["إذا مدح المثنون قوما فليس لي","بغيرهم في نظم سمط الثنا قصد",59,"د",1,0],["إذا مُدَّتِ الأَيْدِي إلى المجدِ والعُلاَ","فما خَفَفَتْ إِلاَّ بمجدٍ بُنُودُها",60,"د",3,0],["إذا مدحوا أهلُ القريض ملوكَهُمْ","رجاءً لنَيْل منهمُ حينَ يُوفَدُ",61,"د",1,1],["إذا مَدَحُو أهلُ المديح ملوكَهم","فهجرِي لنفسي عادتِي ونظامي",62,"م",2,0],["إذا مدحوا أهلُ القريضِ ملوكَهمْ","فإني بحمد الله للهِ حامد",63,"د",1,1],["إذا مدحناه نرى مدحه","كقولنا ان السما ساميه",64,"ي",2,0],["إذا مُدّتْ لهُ الطّرُقاتُ للتيهِ","سَيمضي شامخاً حتّى يُلاقيهِ",65,"ي",2,0],["إذا مدَّ جيشاً للعدوّ تلاعَبتْ","ثعالبُ أطرافِ الرّماح بأُسْدِهِ",66,"ه",1,0]]}