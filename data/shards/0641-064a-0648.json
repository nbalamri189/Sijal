{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[53,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"كذا يهجم القدر الغالب","https://www.aldiwan.net/poem30740.html","المتقارب"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[53,"كريم له يومان قد كفلا له","https://www.aldiwan.net/poem30770.html","الطويل"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[35,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[88,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[27,"عرفت منازلاً بلوى الثماني","https://www.aldiwan.net/poem4450.html","الوافر"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[27,"إليك كلفنا كل يوم هجيرة","https://www.aldiwan.net/poem5963.html","الطويل"],[27,"أجدك لا يصحو الفؤاد المعلل","https://www.aldiwan.net/poem5970.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[72,"أهواه فتان اللواحظ أغيدا","https://www.aldiwan.net/poem18548.html","الكامل"],[72,"ما يقول المقام أيده الله","https://www.aldiwan.net/poem19002.html","الخفيف"],[72,"بستان حسن لا عدمت قطافه","https://www.aldiwan.net/poem19305.html","الكامل"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[14,"أقلي علي اللوم يا بنت منذر","https://www.aldiwan.net/poem38304.html","الطويل"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[70,"سكنت قلبي وفيه منك أسرار","https://www.aldiwan.net/poem42904.html","البسيط"],[92,"يا صميم الحياة إني وحيد","https://www.aldiwan.net/poem38927.html","الخفيف"],[89,"خطبت تؤبنك الدموع","https://www.aldiwan.net/poem44716.html","مجزوء الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[43,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52220.html","السريع"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[28,"تزود فما نفس بعاملة لها","https://www.aldiwan.net/poem5012.html","الطويل"],[99,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[61,"مال كغصن بانة","https://www.aldiwan.net/poem51356.html","مجزوء الرجز"],[61,"فؤادي بك مشغوف","https://www.aldiwan.net/poem51550.html","الهزج"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[61,"أتظن أن الدهر يسعف طالبا","https://www.aldiwan.net/poem51807.html","الكامل"],[49,"أضيع من العمر ما في يدي","https://www.aldiwan.net/poem62043.html","المتقارب"],[66,"بكيت دما لو كان سكب الدما يغني","https://www.aldiwan.net/poem40131.html","الطويل"],[66,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[66,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[97,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[97,"كل الورى يدعون حبك","https://www.aldiwan.net/poem25066.html","مجزوء البسيط"],[80,"طربت متى كنت غير الطروب","https://www.aldiwan.net/poem31567.html","المتقارب"],[87,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[87,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[81,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[13,"أقسمت لا أنسى وإن طال عيشنا","https://www.aldiwan.net/poem2209.html","الطويل"],[52,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"أربع البلى إن الخشوع لباد","https://www.aldiwan.net/poem62604.html","الطويل"],[48,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[46,"رأيتك مفقود المحاسن غابرا","https://www.aldiwan.net/poem23504.html","الطويل"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"طعام من لست له ذاكرا","https://www.aldiwan.net/poem39320.html","البسيط"],[76,"تجنب لباس الخز إن كنت عاقلا","https://www.aldiwan.net/poem39443.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85568","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/41638","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54890","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141967","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[90,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[45,"هذي المَعاهِدُ مِنْ سُعَادَ، فَسَلِّمِ","https://www.poetsgate.com/ViewPoem.aspx?id=32084",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[43,"فديناك من ربع وإن زدتنا كربا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5442&r=&rc=13",""]],"verses":[["فَيَومٌ أَنتَ غُرَّتُهُ جَوادٌ","يَبُذُّ بِشَأوِهِ طَلقَ القِرانِ",0,"ن",1,0],["فَيَوماً يَعودُ بِجَدٍّ عَلَيٍّ","وَيَوماً يَعودُ بِقِدحٍ مُعَلّى",1,"ل",2,0],["فَيَوماهُ يَومٌ بِالمَواهِبِ غائِمٌ","عَلَينا وَيَومٌ بِالقَواضِبِ شامِسُ",2,"س",1,0],["فَيَوماً رَزايا في صَديقٍ مُصادِقٍ","وَيَوماً رَزايا في قَريبٍ مُقارِبِ",3,"ب",1,0],["فَيَومُ النُهى مُشرِقٌ شامِسٌ","وَيَومُ النَدى ماطِرٌ ساكِبُ",4,"ب",1,0],["فَيَومٌ حُسامُكَ فيهِ الخَطيبُ","وَيَومٌ لِسانُكَ فيهِ الخَطيبُ",5,"ب",1,0],["فَيَومُ نِزالٍ مُشمِسٌ مِن سُيوفِهِ","وَيَومُ نَوالٍ ماطِرٌ مِن عَطائِهِ",6,"ه",1,0],["فَيَومٌ لِلمَكارِمِ وَالعَطايا","وَيَومٌ لِلحَمِيَّةِ وَالإِباءِ",7,"ا",2,0],["فَيُومِضُ مِنْ بِيضِ الظَّبَا بِبَوَارِقٍ","وَيَقْذِفُ مِنْ سُمْرِ الرِّمَاحِ بِشُهْبَانِ",8,"ن",1,0],["فَيَوماً عَلى سِربٍ نَقِيِّ جُلودُهُ","وَيَوماً عَلى بَيدانَةٍ أُمِّ تَولَبِ",9,"ب",1,0],["فَيُؤخَذُ مِنّا العَقلُ دونَ دِمائِنا","وَنَأبى فَلا نَستاقُ مِن دمنا عَقلا",10,"ل",2,0],["فِي وَجْدِهِ مَا يَنْثَنِي","عَنْهُ بِفَضْلِ كُلِّ عَادِمْ",11,"م",1,0],["في وقار الحليم تجعلنا طو","راً وطوراً في خفّة النشوان",12,"ن",1,0],["فَيَومَ الشِعبِ قَد تَرَكوا لَقيطاً","كَأَنَّ عَليهِ خَملَةَ أَرجُوانِ",13,"ن",1,0],["فَيوماً سَرابيلُ الحَديدِ عَليهِمُ","وَيَوماً تَرى خَزّاً وَعَصباً مُنَيَّرا",14,"ر",2,0],["فَيَومانِ مِن عَبدِ العَزيزِ تَفاضَلا","فَفي أَيِّ يَومَيهِ تَلومُ عَواذِلُه",15,"ل",2,0],["فَيَومٌ تَحوطُ المُسلِمينَ جِيادُهُ","وَيَومٌ عَطاءٌ ما تُغِبُّ نَوافِلُه",15,"ل",2,0],["فَيَوماً يُجارينَ الهَوى غَيرَ ما صِباً","وَيَوماً تَرى مِنهُنَّ غولاً تَغَوَّلُ",16,"ل",1,0],["فَيَوماً عُناةٌ في الحَديدِ يَفُكُّهُم","وَيَوماً جِيادٌ مُلجَماتٌ قَوافِلُ",17,"ل",1,0],["في وجهه للملكِ نورُ سعادةٍ","تعشو له الآمالُ واجدةً هدى",18,"د",2,0],["في وليّ ببابه ترك الخ","لق ووافى يجوز أم لا يجوز",19,"ز",1,0],["في وصفه الأغزال خصّ مديحها","ملك البسيطة لا تريد خلافَهُ",20,"ف",2,0],["في وجهه روضة للحسن مونِقةٌ","ما راد في مثلها طرفٌ ولا سَرحا",21,"ح",2,0],["في وجناتٍ تحْمَرُّ من خجلٍ","كأن ورد الربيع حمَّرها",22,"ر",3,0],["في وعده من نواله عِوضٌ","أملأُ شيء لكفّ معتاضه",23,"ض",2,0],["في وجهها من أنفها روْشنٌ","أما يراه صاحبُ الشُرطه",24,"ط",2,0],["فيوسعُ رأيكَ المحمود ذمّاً","ويطعنُ في اختياركَ غيرَ آلي",25,"ي",1,0],["في وجهها سيما وفي ساقها","من فعلها تلك الأفاعيلا",26,"ل",2,0],["في وَجهِهِ صُفرَةٌ حارَ الطَبيبُ بِها","ما يَصنَعُ الطُبُّ فيمَن دائُهُ الخَبَلُ",27,"ل",1,0],["فَيَوماً عَلى نَجدٍ وَغاراتِ أَهلِها","وَيَوماً بِأَرضٍ ذاتِ شَتٍّ وَعَرعَرِ",28,"ر",1,0],["في وَجهِكَ لِلرِضى دَليلٌ","ماتَكذِبُ هَذِهِ المَخائِل",29,"ل",1,0],["في وَجنَتَيهِ وَحَدِّث عَنهُما عَجَبٌ","ماءٌ وَنارٌ وَلا ماءٌ وَلا نارُ",30,"ر",1,0],["في وجودٍ مُكَبَّلٍ بقيودٍ","تائهٍ في ظلامِ شَكٍّ ونحسِ",31,"س",1,0],["في وحدة عربية","للذود في دمها نزوع",32,"ع",1,0],["في واضِحٍ لَحبِ الطَري","قِ مِنَ المَذاهِبِ مُستَقيمِ",33,"م",1,0],["فَيَوماً بِخَيلٍ تَطرُدُ الرومَ عَنهُمُ","وَيَوماً بِجودٍ يَطرُدُ الفَقرَ وَالجَدبا",34,"ب",2,0],["في وَحدَةِ الرُهبانِ إِلّا أَنَّهُ","لا يَعرِفُ التَحريمَ وَالتَحليلا",35,"ل",2,0],["في وَجهِهِ مِن نورِ خالِقِهِ","قَدَرٌ هِيَ الآياتُ وَالرُسُلُ",36,"ل",1,0],["في وسط البحر ومن تحتها","نار حضان أبداً تسعرُ",37,"ر",1,0],["فَيُؤَدّي رِسالَةً عَن مُطاعٍ","لَم يَعُقنا عَن بُغيَةٍ تَقصيرُه",38,"ر",2,0],["في وَقعَةٍ أَبقى عَلَيهِم غِبُّها","رَخَمَ الفَيافي وَالنُسورَ وُقوعا",39,"ع",2,0],["في وَقعَةٍ وَلِيَت غَنِيٌّ حَدَّها","بِأَجَشَّ مِن زَجَلِ الحَديدِ مُلَملِمِ",40,"م",1,0],["فَيوشِكَ نَفسٌ أَن تَكونَ حَياتُها","وَإِن مَسَّها مَوتٌ طَويلاً خُلودُها",41,"د",3,0],["في وجهك العربي، في الثغر الذي","ما زال مختزناً شموس بلادي",42,"ي",1,0],["في وجهه ديباجة","عارضه طرازها",43,"ه",2,0],["فيومَ الجُودِ بَسَّامٌ","ويومَ الرَّوْعِ غِطريفُ",44,"ف",1,0],["فيومَ الحربِ تُطرِبُكَ المذاكي","ويومَ السِّلمِ يُطرِبُكَ النَّشيدُ",45,"د",1,0],["فيؤوبَ مغلوباً لديك مذمَّماً","وتؤوبَ محمودَ السجيَّةِ غالبا",46,"ب",2,0],["فَيوشِكُ عَمّا قَليلٍ أَكو","نُ مِنهُنَّ في البَرزَخِ الأَبعَدِ",47,"د",1,0],["فَيُؤنِسُني تَرتيبُ نَفلِكَ في الضُحى","وَيُطرِبُني تَرتيلُ وِردِكَ في الوَهنِ",48,"ن",1,0],["في وَقعَةٍ تُسلَبُ العُقولُ بِها","وَأَنفُسُ الدارِعينَ تُختَرَمُ",49,"م",1,0],["في وَصفِنا لَكَ بِالإِنعامِ سَوءُ ثَناً","وَالغَيثُ يُنقِصُهُ إِن قيلَ قَد سَمَحا",50,"ح",2,0],["في وجنتيكِ توهجٌ وضرامُ","وبمقلتيكِ مدامعٌ وذهولُ",51,"ل",1,0],["في وثبه هيهات يس","أل ما يكون وراءها",52,"ه",2,0],["في واضح النور جنح ليل","وفي الرحاب الفساح ضيق",53,"ق",1,0],["فيوْماً إلى سَبْيِ زقّ رَويٍّ","ويوْماً إلى صَيْدِ ظبْيٍ ربيبِ",54,"ب",1,0],["فِي وَجْهِهِ سِمَةٌ لِلْغَدْرِ بَيِّنَةٌ","وَبَيْنَ جَنْبَيْهِ أَحْقَادٌ وَأَوْغامُ",55,"م",1,0],["فِي وِعَاءٍ يَحْدُونَهُ بِدُعَاءٍ","لِجَلالِ الْمُهَيْمِنِ الْعَلَّامِ",56,"م",1,0],["فَيَومانِ يَومٌ في الأَنيسِ مُرَنَّقٌ","وَيَومَ أُباري الرائِحاتِ الجَوارِيا",57,"ي",2,0],["في وَجهِهِ وَبَنانِهِ وَبَيانِهِ","ما في الكَواكِبِ وَالسَحائِبِ وَالرُبى",58,"ب",2,0],["فَيَوماً بِغُزّاءٍ وَيَوماً بِسُريَةٍ"