"],[429,"ألا ثكلتك أمك عبد عمرٍو","https://www.aldiwan.net/poem775.html",""],[430,"كم اكتم الوجد والأجفان تعلنه","https://www.aldiwan.net/poem40510.html","البسيط"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[440,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[459,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[459,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[459,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[459,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[459,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[459,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[459,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[459,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[459,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[459,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[459,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[459,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[462,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[462,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[462,"صيغت دواتك من يوميك فاشتبهت","https://www.aldiwan.net/poem15340.html","البسيط"],[462,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[462,"رويدكم فالفتح يصغره القدر","https://www.aldiwan.net/poem16340.html","الطويل"],[462,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[462,"يدر بلاغات اللسان مديحه","https://www.aldiwan.net/poem16358.html","الطويل"],[462,"تميس الدولة الغراء تيها","https://www.aldiwan.net/poem16383.html","الوافر"],[462,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[462,"لا أوحش الله من جود أسر به","https://www.aldiwan.net/poem16426.html","البسيط"],[467,"وحنت قلوصي بعد هدء صبابة","https://www.aldiwan.net/poem50378.html","الطويل"],[469,"يا من أودع منه","https://www.aldiwan.net/poem60342.html","المجتث"],[469,"قد شمرت أطنابها الظلماء","https://www.aldiwan.net/poem60531.html","البسيط"],[472,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[478,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[480,"سكن الهوى في القلب حيث أجله","https://www.aldiwan.net/poem37061.html","الكامل"],[483,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[496,"أقضي العمر تشبيها","https://www.aldiwan.net/poem10287.html","الهزج"],[506,"جدِّدْ","https://www.aldiwan.net/poem61090.html","مجزوء الرجز"],[515,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[516,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[516,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[516,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[539,"مقلة عيني نظرت","https://www.aldiwan.net/poem48128.html","عموديه"],[552,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[552,"يا رب لا تجعل المنظور من أجلي","https://www.aldiwan.net/poem47291.html","البسيط"],[552,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[559,"أحرف في سكونها الإعدام","https://www.aldiwan.net/poem33863.html","الخفيف"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[568,"أدن من الدن بي فداك أبي","https://www.aldiwan.net/poem69456.html","مجزوء البسيط"],[568,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[568,"قم فاعقر الهم بالعقار","https://www.aldiwan.net/poem69658.html","مخلع البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["فَيَومٌ أَنتَ غُرَّتُهُ جَوادٌ","يَبُذُّ بِشَأوِهِ طَلقَ القِرانِ",0,"ن",1,0],["فَيَوماً يَعودُ بِجَدٍّ عَلَيٍّ","وَيَوماً يَعودُ بِقِدحٍ مُعَلّى",1,"ل",2,0],["فَيَوماهُ يَومٌ بِالمَواهِبِ غائِمٌ","عَلَينا وَيَومٌ بِالقَواضِبِ شامِسُ",2,"س",1,0],["فَيَوماً رَزايا في صَديقٍ مُصادِقٍ","وَيَوماً رَزايا في قَريبٍ مُقارِبِ",3,"ب",1,0],["فَيَومُ النُهى مُشرِقٌ شامِسٌ","وَيَومُ النَدى ماطِرٌ ساكِبُ",4,"ب",1,0],["فَيَومٌ حُسامُكَ فيهِ الخَطيبُ","وَيَومٌ لِسانُكَ فيهِ الخَطيبُ",5,"ب",1,0],["فَيَومُ نِزالٍ مُشمِسٌ مِن سُيوفِهِ","وَيَومُ نَوالٍ ماطِرٌ مِن عَطائِهِ",6,"ه",1,0],["فَيَومٌ لِلمَكارِمِ وَالعَطايا","وَيَومٌ لِلحَمِيَّةِ وَالإِباءِ",7,"ا",2,0],["فَيُومِضُ مِنْ بِيضِ الظَّبَا بِبَوَارِقٍ","وَيَقْذِفُ مِنْ سُمْرِ الرِّمَاحِ بِشُهْبَانِ",8,"ن",1,0],["فَيَوماً عَلى سِربٍ نَقِيِّ جُلودُهُ","وَيَوماً عَلى بَيدانَةٍ أُمِّ تَولَبِ",9,"ب",1,0],["فَيُؤخَذُ مِنّا العَقلُ دونَ دِمائِنا","وَنَأبى فَلا نَستاقُ مِن دمنا عَقلا",10,"ل",2,0],["فِي وَجْدِهِ مَا يَنْثَنِي","عَنْهُ بِفَضْلِ كُلِّ عَادِمْ",11,"م",1,0],["في وقار الحليم تجعلنا طو","راً وطوراً في خفّة النشوان",12,"ن",1,0],["فَيَومَ الشِعبِ قَد تَرَكوا لَقيطاً","كَأَنَّ عَليهِ خَملَةَ أَرجُوانِ",13,"ن",1,0],["فَيوماً سَرابيلُ الحَديدِ عَليهِمُ","وَيَوماً تَرى خَزّاً وَعَصباً مُنَيَّرا",14,"ر",2,0],["فَيَومانِ مِن عَبدِ العَزيزِ تَفاضَلا","فَفي أَيِّ يَومَيهِ تَلومُ عَواذِلُه",15,"ل",2,0],["فَيَومٌ تَحوطُ المُسلِمينَ جِيادُهُ","وَيَومٌ عَطاءٌ ما تُغِبُّ نَوافِلُه",15,"ل",2,0],["فَيَوماً يُجارينَ الهَوى غَيرَ ما صِباً","وَيَوماً تَرى مِنهُنَّ غولاً تَغَوَّلُ",16,"ل",1,0],["فَيَوماً عُناةٌ في الحَديدِ يَفُكُّهُم","وَيَوماً جِيادٌ مُلجَماتٌ قَوافِلُ",17,"ل",1,0],["في وجهه للملكِ نورُ سعادةٍ","تعشو له الآمالُ واجدةً هدى",18,"د",2,0],["في وليّ ببابه ترك الخ","لق ووافى يجوز أم لا يجوز",19,"ز",1,0],["في وصفه الأغزال خصّ مديحها","ملك البسيطة لا تريد خلافَهُ",20,"ف",2,0],["في وجهه روضة للحسن مونِقةٌ","ما راد في مثلها طرفٌ ولا سَرحا",21,"ح",2,0],["في وجناتٍ تحْمَرُّ من خجلٍ","كأن ورد الربيع حمَّرها",22,"ر",3,0],["في وعده من نواله عِوضٌ","أملأُ شيء لكفّ معتاضه",23,"ض",2,0],["في وجهها من أنفها روْشنٌ","أما يراه صاحبُ الشُرطه",24,"ط",2,0],["فيوسعُ رأيكَ المحمود ذمّاً","ويطعنُ في اختياركَ غيرَ آلي",25,"ل",2,0],["في وجهها سيما وفي ساقها","من فعلها تلك الأفاعيلا",26,"ل",2,0],["في وَجهِهِ صُفرَةٌ حارَ الطَبيبُ بِها","ما يَصنَعُ الطُبُّ فيمَن دائُهُ الخَبَلُ",27,"ل",1,0],["فَيَوماً عَلى نَجدٍ وَغاراتِ أَهلِها","وَيَوماً بِأَرضٍ ذاتِ شَتٍّ وَعَرعَرِ",28,"ر",1,0],["في وَجهِكَ لِلرِضى دَليلٌ","ماتَكذِبُ هَذِهِ المَخائِل",29,"ل",1,0],["في وَجنَتَيهِ وَحَدِّث عَنهُما عَجَبٌ","ماءٌ وَنارٌ وَلا ماءٌ وَلا نارُ",30,"ر",1,0],["في وجودٍ مُكَبَّلٍ بقيودٍ","تائهٍ في ظلامِ شَكٍّ ونحسِ",31,"س",1,0],["في وحدة عربية","للذود في دمها نزوع",32,"ع",1,0],["في واضِحٍ لَحبِ الطَري","قِ مِنَ المَذاهِبِ مُستَقيمِ",33,"م",1,0],["فَيَوماً بِخَيلٍ تَطرُدُ الرومَ عَنهُمُ","وَيَوماً بِجودٍ يَطرُدُ الفَقرَ وَالجَدبا",34,"ب",2,0],["في وَحدَةِ الرُهبانِ إِلّا أَنَّهُ","لا يَعرِفُ التَحريمَ وَالتَحليلا",35,"ل",2,0],["في وَجهِهِ مِن نورِ خالِقِهِ","قَدَرٌ هِيَ الآياتُ وَالرُسُلُ",36,"ل",1,0],["في وسط البحر ومن تحتها","نار حضان أبداً تسعرُ",37,"ر",1,0],["فَيُؤَدّي رِسالَةً عَن مُطاعٍ","لَم يَعُقنا عَن بُغيَةٍ تَقصيرُه",38,"ر",2,0],["في وَقعَةٍ أَبقى عَلَيهِم غِبُّها","رَخَمَ الفَيافي وَالنُسورَ وُقوعا",39,"ع",2,0],["في وَقعَةٍ وَلِيَت غَنِيٌّ حَدَّها","بِأَجَشَّ مِن زَجَلِ الحَديدِ مُلَملِمِ",40,"م",1,0],["فَيوشِكَ نَفسٌ أَن تَكونَ حَياتُها","وَإِن مَسَّها مَوتٌ طَويلاً خُلودُها",41,"د",3,0],["في وجهك العربي، في الثغر الذي","ما زال مختزناً شموس بلادي",42,"د",2,0],["في وجهه ديباجة","عارضه طرازها",43,"ه",2,0],["فيومَ الجُودِ بَسَّامٌ","ويومَ الرَّوْعِ غِطريفُ",44,"ف",1,0],["فيومَ الحربِ تُطرِبُكَ المذاكي","ويومَ السِّلمِ يُطرِبُكَ النَّشيدُ",45,"د",1,0],["فيؤوبَ مغلوباً لديك مذمَّماً","وتؤوبَ محمودَ السجيَّةِ غالبا",46,"ب",2,0],["فَيوشِكُ عَمّا قَليلٍ أَكو","نُ مِنهُنَّ في البَرزَخِ الأَبعَدِ",47,"د",1,0],["فَيُؤنِسُني تَرتيبُ نَفلِكَ في الضُحى","وَيُطرِبُني تَرتيلُ وِردِكَ في الوَهنِ",48,"ن",1,0],["في وَقعَةٍ تُسلَبُ العُقولُ بِها","وَأَنفُسُ الدارِعينَ تُختَرَمُ",49,"م",1,0],["في وَصفِنا لَكَ بِالإِنعامِ سَوءُ ثَناً","وَالغَيثُ يُنقِصُهُ إِن قيلَ قَد سَمَحا",50,"ح",2,0],["في وجنتيكِ توهجٌ وضرامُ","وبمقلتيكِ مدامعٌ وذهولُ",51,"ل",1,0],["في وثبه هيهات يس","أل ما يكون وراءها",52,"ه",2,0],["في واضح النور جنح ليل","وفي الرحاب الفساح ضيق",53,"ق",1,0],["فيوْماً إلى سَبْيِ زقّ رَويٍّ","ويوْماً إلى صَيْدِ ظبْيٍ ربيبِ",54,"ب",1,0],["فِي وَجْهِهِ سِمَةٌ لِلْغَدْرِ بَيِّنَةٌ","وَبَيْنَ جَنْبَيْهِ أَحْقَادٌ وَأَوْغامُ",55,"م",1,0],["فِي وِعَاءٍ يَحْدُونَهُ بِدُعَاءٍ","لِجَلالِ الْمُهَيْمِنِ الْعَلَّامِ",56,"م",1,0],["فَيَومانِ يَومٌ في الأَنيسِ مُرَنَّقٌ","وَيَومَ أُباري الرائِحاتِ الجَوارِيا",57,"ي",2,0],["في وَجهِهِ وَبَنانِهِ وَبَيانِهِ","ما في الكَواكِبِ وَالسَحائِبِ وَالرُبى",58,"ب",2,0],["فَيَوماً بِغُزّاءٍ وَيَوماً بِسُريَةٍ","وَيَوماً بِخَشخاشٍ مِنَ الرَجلِ هَيضَلِ",59,"ل",1,0],["في وَجهِها وَرَقُ النَعيمِ مَلا العُيو","نَ مَلاحَةً وَظَرافَةً وَجَمالا",60,"ل",2,0],["فيومُكُمُ مثلُ دهرِ الملوكِ","وطِفلُكُمُ مثلُ كهلِ الوَرى",61,"ا",1,0],["فَيومٌ لِإِلحاقِ اَلفَقيرِ بِذي الغِنى","وَيومُ رِقابٍ بوكِرَت لِحَصادِ",62,"د",1,0],["في وَجهِهِ مِن حُمَمٍ جالِبٌ","كَأَنَّما عُلَّ بِأَلياقِ",63,"ق",1,0],["فَيَومُ نَوىً قَصَّرنَ فيهِ عَنِ النَوى","وَيَومُ فِراسٍ دُسنَهُ بِالفَراسِنِ",64,"ن",1,0],["فَيوشِكُ أَن يَراكَ لَهُ عَدُوّاً","عَداوَةَ مَن يُلاطِمُ أَو يُناصي",65,"ص",2,0],["فِي وُجُوهٍ شُمِّ العَرانِينِ أَمثا","لِ الَدنانِيرِ شُفنَ بِالمِثقالِ",66,"ل",1,0],["في وجههِ من نُورهِ برهانُ","وكفُّه تقْبيلُها قُرْبانُ",67,"ن",1,0],["في وجههِ من لؤمهِ شاهدٌ","يكفي به الشاهدُ أن يُخبرا",68,"ر",2,0],["فَيَوْماً تَراهُ تَحْتَ سَوْطٍ مُجَرَّداً","ويَوماً تَراهُ فَوْقَ سَرْجٍ مُنَضَّدِ",69,"د",1,0],["في وجهه غضباً على ال","أيام إذ كذبت قطوب",70,"ب",1,0],["في وحدة عربية","ليست تهدد بانفصام",71,"م",1,0],["في واحةٍِ يرسو عليها الغريب","فكلُّ ما فيها لديه غريب",72,"ب",1,0],["في وقفةِ الذّاهلِ ألقى عصاهْ","مُولّيَ الجبهةِ شطرَ الفضاءْ",73,"ا",2,0],["في وصفها أو في ثنا ابن جماعة","أضحى فريداً في القريض مباني",74,"ن",2,0],["فِي وَجْهِكَ الْبَاسِمِ عَنْ زخْرُفٍ","بًشْرَى بِآمَالٍ كِبَارٍ تُشادْ",75,"د",1,0],["فِي وَصْفَهِ النْعَمَ التِي خصت بِهَا","مِن حُسْنِ مُرْتَبُعٍ وَطِيبِ هَوَاءِ",76,"ا",2,0],["فِي وَصْفِهِ الآيَاتِ مِمَّا أبْدَعَتْ","أُممٌ يَقِظْنَ وَنَحْنُ فِي إِغْفَاءِ",76,"ا",2,0],["فِي وَصْفِ مَعْرِضِنا الزِّرا","عِي الصِّناعِيِّ الأَخِيرِ",77,"ر",1,0],["في وجهه الذواي من القهر","كوني له أختاً وعزيه",78,"ه",1,0],["في وجهه الجهم حسنٌ","من روحهِ المتسكنّ",79,"ن",1,0],["في وَجْهِهِ قَسَمات قَدْ دَلَلْنَ عَلَى","ما ضَمَّهُ القَلْبُ مِنْ نُبْلٍ وإِيمان",80,"ن",1,0],["في وَقْعَةٍ ليسَ لها كاشفٌ","وصَيْحَةٍ ليسَ لها من فَواقْ",81,"ق",1,0],["في وقت تقرير المصي","رِ، وَوَقِت تحرير الرقاب",82,"ب",1,0],["في وادٍ للاستعمار قاعدةٌ","لها أساسان: تخريب وإفساد",83,"د",1,0],["فيولد في قلبه كلّ يوم","ويحمل في شفتيه ضريحه",84,"ح",2,0],["في وجهها وقفوا وهم عزّلٌ وما","لبسوا سوى ثوب الهداية مغفرا",85,"ر",2,0],["\" فيومٌ علنا ويوم لنا","ويوم نُساء ويوم نُسر \"",86,"ر",1,0],["في وَقْعَةٍ، وَلّيْتَ عَنّي حَدّها","بأجَشّ مِنْ زَجَلِ الحَديدِ مُلَملَمِ",87,"م",1,0],["في وقفة ٍ من مُخبرٍ أو سائل","لا بل دعِ الهزلَ لكلّ هازل",88,"ل",1,0],["في وجهها يدور .. كالبرعم","بمثله الأحلام لم تحلم",89,"م",1,1],["فيَوْماً بخَيْلٍ تَطْرُدُ الرّومَ عنهُمُ","وَيَوْماً بجُودٍ تطرُدُ الفقرَ وَالجَدْبَا",90,"ب",2,0],["فيوم بوادي السير تصبيه ظبية","ويوم بهذا الثغر يصبيه ربرب",91,"ب",1,0],["في واحد من غشتَ بالفرعُ المقد","