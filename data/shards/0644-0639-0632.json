{"poems":[[65,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[73,"أبعد مقامي في دباوند أبتغي","https://www.aldiwan.net/poem3994.html","الطويل"],[37,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[37,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[37,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[74,"قدمت كما ترضى السيادة والعلى","https://www.aldiwan.net/poem18287.html","الطويل"],[74,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[46,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[37,"عفا السَّفحُ من أمِّ الوليدِ فكبكبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20654&r=&rc=8",""],[119,"اسوق جنائبي والركب مضني","https://www.aldiwan.net/poem40421.html","عموديه"],[154,"لعزك ذلت الأمم","https://www.aldiwan.net/poem68499.html","مجزوء الوافر"],[170,"ومهمه يتراءى آله لججا","https://www.aldiwan.net/poem47131.html","البسيط"],[287,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[325,"لعزمك أمض اليوم دون تردد","https://www.aldiwan.net/poem61758.html","الطويل"],[353,"وميض البرق أم ثغر يلوح","https://www.aldiwan.net/poem19945.html","الوافر"],[369,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[376,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[412,"ظفر الأسى بمتيم لم يظفر","https://www.aldiwan.net/poem50162.html","الكامل"],[445,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[445,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[567,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104015","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64799","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136230","الطويل"],[1340,"","https://poetry.dctabudhabi.ae/diwan/poem/105888",""],[1598,"","https://poetry.dctabudhabi.ae/diwan/poem/146158","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116503","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100313","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100263","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134134","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134012","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89123","المتدارك"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89007","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89109","المتدارك"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45743","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35533","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139651",""],[4578,"بسادس شعبان جنى اليمين أينما","https://www.poetsgate.com/ViewPoem.aspx?id=49469",""],[4858,"انصروا الله تنالوا نصره","https://www.poetsgate.com/ViewPoem.aspx?id=30637",""]],"verses":[["لَعَزَّ على حَيٍّ بنَعْمانَ نازِلٍ","مَطافُ أخيهمْ بالحِمى ومُقامُهُ",0,"م",2,0],["لَعَزَّ على الأشْرافِ منْ آلِ غالِبٍ","خُدودُ غَطاريفٍ توسَّدْنَ أذْرُعا",1,"ع",2,0],["لِعزَّةَ دَفرٌ حينَ توقَدُ نارُها","لَدَيهِ وَمِتفالٌ بِهِ أُم جُندَبِ",2,"ب",1,0],["لِعَزَّةَ مِن أَيّامِ ذي الغُصنِ هاجَني","بَضاحي قَرارِ الرَوضَتَينِ رُسومُ",3,"م",1,1],["لِعَزَّةَ أَطلالٌ أَبَت أَن تَكَلَّما","تَهيجُ مَغانيها الطَروبَ المُتَيَّما",4,"م",2,1],["لِعَزَّةَ إِذ يَحتَلُّ بِالخَيفِ أَهلُها","فَأَوحَشَ مِنها الخَيفُ بَعدَ حُلولِ",5,"ل",1,0],["لِعَزَّةَ هاجَ الشَوقَ فالدَمعُ سافِحُ","مَغانٍ وَرَسمٌ قد تَقادَمَ ماصِحُ",6,"ح",1,1],["لِعَزَّةَ إِذ حَبلُ المَوَدَّةِ دائِمٌ","وَإِذ أَنتَ مَتبُولٌ بِعَزَّةَ مُعجَبُ",7,"ب",1,0],["لِعَزَّةَ نارًا ما تَبوخُ كأَنَّها","إِذا ما رَمَقناها مِنَ البُعدِ كَوكَبُ",7,"ب",1,0],["لَعَزَّةُ هَمُّ النَفسِ مِنهُنَّ لَو تَرى","إليها سَبيلاً أَو تُلِمُّ فَتُصقِبُ",7,"ب",1,0],["لَعَزَّ عَلَيَّ ما جَهِلوا وَقالوا","أَفي تَسليمَةٍ وَجَبَ الوَعيدُ",8,"د",1,0],["لعزمك يمنٌ والمقاصِدُ مرشدٌ","ورأيك نجحٌ والمقالُ صواب",9,"ب",1,0],["لعزٍّ أو لوَفر أجتنيه","على وفق احتياجي واجتياحي",10,"ح",2,0],["لعز غليوم فيها من يمثله","وذات إدورد فيها من يحاكيها",11,"ي",3,0],["لَعَزمُكَ مِثلُ عَزمِ السَيلِ شُدَّت","قُواهُ بِالمَذانِبِ وَالتِلاعِ",12,"ع",1,0],["لِعِزَّةِ هَذِي اللاهِيَاتِ النَّوَاعِمِ","تَذِلُّ عَزِيزَاتُ النُّفُوسِ الْكَرَائِمِ",13,"م",1,1],["لعزائم الأعيان فيهم وازع","دينا وحاشا هم لزوم العار",14,"ر",1,0],["لعزَّة َ إذ حبلُ المودّة ِ دائمٌ","وإذا أَنْتَ مَتْبُولٌ بِعزَّة َ مُعْجَبُ",15,"ب",1,0],["لعز الدين صياد المعاني","وسلطان الطريق الاحمدي",16,"ي",1,0],["لِعزّك ذلّت الأُمم","وفيك تعلت الهمم",17,"م",1,1],["لعزّهِ جعلَ الرحمنُ مَلبسَهُ","من الشبابِ ونورِ العَينِ مُسْتَلبَا",18,"ب",2,0],["لِعَزمِهِ أَصحَبَ كُلُّ شامِسٍ","وَكُلُّ ما عَزَّ بِغَيرِ اللَهِ ذَل",19,"ل",1,0],["لِعَزمِكَ أَمضِ اليَومَ دونَ تَرَدَّدٍ","وَبادِر وَحاذِر أَن تَقولَ إِلى غَدِ",20,"د",1,1],["لِعزِّ الدِّينِ مِقْدامِ بنِ عِيسى","خَلائِقُ كُلُّها حَسَنٌ مَلِيحُ",21,"ح",1,0],["لَعزَّما منه قد يُهدَي لأنمُلِه","مُشَجِّعٌ نبتُهُ في الغَيْضةِ الأَسَدا",22,"د",2,0],["لِعزِّ الخُدودِ وصَونِ العُيو","نِ تَعللتُ بالوَردِ والنرجِسِ",23,"س",1,0],["لعزيزِ دولَة آل أَحمدَ في الوَغى","وَالسِلمِ بدر سَريرها وَالمَنبرِ",24,"ر",1,0],["لعزم موفَّقين مسدَّدَيْنِ","وبأس مؤيدين مظفَّرَيْنِ",25,"ن",1,0],["لِعَزِيزٍ نصرُهُ حَيْثُ انْتَوى","وعَلِيٍّ كعبُهُ حَيْثُ قَصَدْ",26,"د",1,0],["لَعَزَّ منسوبٌ إلى","عبد العزيز يَنمي",27,"م",2,0],["لعزٍّ تركنا غراماً به","سروجَ الطريق لأكوارِهِ",28,"ر",2,0],["لِعزِّها الذُّلُّ صفوَ العزِّ نحسبُهُ","والسُّمُ من يدها خيراً من الدَّسَمِ",29,"م",1,0],["لعزك صونا صان بالعز صولة","على كل معتل يرى الخلق علة",30,"ه",1,0],["لعزّت فلم يستَغنِ عنها ابنُ آدم","وهانت عليهِ فَهوَ لا يستعيرُها",31,"ر",3,0],["لِعِزَّتِهِ ذُلَّ الأَكاسِرَةُ الألى","هُمُ سَلَبوا تيجانَها آلَ ساسانِ",32,"ن",1,0],["لِعزَّتِهِ ذَلَّ عَبْدُ العَزيزِ","ولم يُغْنِهِ نَصْرُ أَنصارِهِ",33,"ر",2,0],["لعزة من تعنو الوجوه لعزه","ملاذي فاني في حماية حرزه",34,"ز",2,1],["لعزة العلم يسعى الطالبون له","إليه والعلم لا يسعى الى أحد",35,"د",1,1],["لعزة الفضة المبرة","أودعها الله قلب صخره",36,"ر",2,1],["لَعَزَّ عَلى أَيدي المَنونِ اِختِرامُهُ","وَإِن كانَ مَحتوماً عَلَيهِ وُرودُها",37,"د",3,0],["لعز يجتنى بعيون عز","وراء الدين يطلب ثم دينا",38,"ن",2,0],["لعز عليَّ بعدك في محاني","ربى نجدٍ وبعدك بالعزيز",39,"ز",1,0],["لعزّ على المجد أن يكثر ال","عويل بيوم بعد المجد أودى",40,"د",2,0],["لعزك عيد اليمن أضحى مهنئاً","باقبال مجد لن يزال دوامه",41,"ه",1,1],["لعزك عام السعد اقبل يزهر","مفيداً بصدق الوعد ما سوف يظهر",42,"ر",1,1],["لعزيزك يا مصر تاري","خي في خير العبد الأكبر",43,"ر",1,0],["لعزة جاهه نبأ عظيمٌ","وجاه عدوِّه في الذاريات",44,"ت",1,0],["لعزيزك يا مصر انفردت","رايات العز على الدور",45,"ر",1,0],["لعزكم تَعزى المَعالي وَتَنتَمي","العَوالي إِذا جالَت جياد السَلاهب",46,"ب",1,0],["لِعَزم قصرت العَيش فيهِ عَلى السّرى","وَقُلتُ لَها سيري فَموعِدك القصرُ",47,"ر",1,0],["لِعِزِّ الهَوى أَذلَلتُ جامِحَة الصِبا","كَما اِرتاضَ بِالاِلجامِ صَهوَةَ أَصعَب",48,"ب",1,0],["لِعِزَّتِها لألاء مِن تَحتِ طرة","كَبَدر تُبدى مِن سُجوفِ الغَياهِب",49,"ب",1,0],["لعزة فخره العظماء ذلوا","فخرّوا خاضعين له بكيا",50,"ي",2,0],["لعزَ الوَلي وذل العَدُو","نوالٌ مبر وبأْسٌ مُبيرُ",51,"ر",1,0],["لعزت عزة ولمصطفى من","جلاء حكمة فيه تبان",52,"ن",1,0],["لعزيز مصر الفضل ذى المجد الذي","بالفضل قد فاق الورى والسؤدد",53,"د",1,0],["لعز معاليه قد انقاد أمرها","وقد كان قبلاً عن سواه ثمنعا",54,"ع",2,0],["لَعَزَزْتُمْ وَلَكُنْتُمْ خَيْرَ كُلِّ العَالَمينْ","انصروا اللهَ تنالُوا نَصْرَهُ يا غافلونْ",55,"ن",1,0]]}