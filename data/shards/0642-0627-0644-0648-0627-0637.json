{"poems":[[458,"قالوا طيور تغالي في محبتها","https://www.aldiwan.net/poem61224.html","البسيط"],[463,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77565","المجتث"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121649","السريع"],[5038,"قم من جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=190216",""],[5186,"قالوا طغى وبغى وجار وأفرطا","https://www.poetsgate.com/ViewPoem.aspx?id=156546",""],[463,"حملوك لو علموا من المحمولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60211&r=&rc=267",""]],"verses":[["قالوا طيور تغالي في محبتها","فقلت ما كن إلا بعض أبنائي",0,"ي",1,1],["قالوا طويلُ العمر قلتُ لذاكمُ","حزني عليك كما ترون طويلُ",1,"ل",1,0],["قالوا طَلَبنا ملك خان","نَرحل إِلَيهِ في الدَعاوى",2,"ا",3,0],["قالُوا طُفَيْليّاً عجِبْنَا له","يُضيفُ رَبَّ الدارِ في دَارِهْ",3,"ر",2,0],["قالوا طَواها هَديرُ الرَّعْدِ بَلْ كَذِبوا","وَإِنَّما مِنْ نَميرِ النَّهْرِ تَنْتَهِلُ",4,"ل",1,0],["قالوا طغى وبغى وجار وأفرطا","جبران واقتعط الضلال فأقعطا",5,"ط",2,1],["قالوا طويلُ العمر قلتُ لذاكمُ","حزني عليه كما ترون طويلُ",6,"ل",1,0]]}