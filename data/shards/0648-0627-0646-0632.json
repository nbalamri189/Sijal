","https://www.aldiwan.net/poem68093.html","الكامل"],[365,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[365,"محلك سام والعلاء به اعتكف","https://www.aldiwan.net/poem60840.html","الطويل"],[367,"وأنزل بي بعض الأخلاء حاجة","https://www.aldiwan.net/poem17780.html","الطويل"],[381,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[404,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[404,"حي الحمى ومنازل الحب","https://www.aldiwan.net/poem34158.html","الكامل"],[406,"إذا ما أتاح الله لي قرب منصف","https://www.aldiwan.net/poem49381.html","الطويل"],[417,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[421,"يعاتبني في الدين قومي وإنما","https://www.aldiwan.net/poem4848.html","الطويل"],[430,"عقارب صدغه لدغت فوادي","https://www.aldiwan.net/poem40522.html","الوافر"],[440,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[442,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[442,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[442,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[442,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[453,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[453,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[459,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[462,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[478,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[496,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[501,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[501,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[507,"إذا بلغ المرء أرض الحجاز","https://www.aldiwan.net/poem2408.html","المتقارب"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[528,"وكنت سماء والعجاج سحائبا","https://www.aldiwan.net/poem45975.html","الطويل"],[530,"ويوم شبام قد رأيت مواعظا","https://www.aldiwan.net/poem37396.html","الطويل"],[552,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[552,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[552,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[559,"صلاتي إليها بل إلي صلاتها","https://www.aldiwan.net/poem33516.html","الطويل"],[559,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[559,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[559,"يا خبرا عني إذا","https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَإِنَّ زَماني يَومَ يَحرُقُ نابَهُ","أُعاذِمُهُ حَتّى يَمُدَّ عِذامي",0,"م",2,0],["وَأَنزِلُ في القَومِ أَقلالَهُم","وَلَولا الحَضارَةُ لَم أَنزِلِ",1,"ل",1,0],["وَأَنزو نَزوَةَ البازِ","لِ لا يُبرِكُهُ الحَملُ",2,"ل",1,0],["وَإِن زالَ نَجمٌ مِن ذُؤابَةِ هاشِمٍ","فَلا عَجَبٌ إِنَّ النُجومَ تَزولُ",3,"ل",1,0],["وَاِنزِلي بي مُجاوِراً في أُناسٍ","لا يَذُمُّ النَزيلِ فيهِم جِوارا",4,"ر",2,0],["وَإِن زَهِدوا في الأَجرِ إِذ حَمِسَ الوَغَى","فَهَلّا أَتَوْهُ رَغبَةً في الغَنائِمِ",5,"م",1,0],["وَإِنَّ زَمانا شَتَّتَ الشَملَ بَينَنا","وَبَينَكُمُ فيهِ العِدى لَمَشومُ",6,"م",1,0],["وَأَنزَلَني طولُ النَوى دارَ غُربَةٍ","إِذا شِئتُ لاقَيتُ أَمراً لا أُشاكِلُه",7,"ه",1,1],["وَإِنْ زَمَنٌ يَوْماً عَرَتْهُ زَمَانَةٌ","فَرَاحَتُهُ بُرْءُ الزَّمَانِ مِنَ السُّقْمِ",8,"م",1,0],["وإنْ زَحَفوا منْ دونِ رايَةِ يوسُفٍ","تَقولُ تَعالَى مَنْ لهُ الخَلْقُ والأمْرُ",9,"ر",1,0],["وَأَنزَلوهُ بِأُفقٍ مِن مَطالِعِهِ","فَوقَ الكَواكِبِ لا تَحتَ الجَلاميدِ",10,"د",1,0],["وَاِنزِل عَلَيهِ السُخطَ إِن","أَمسى وَلَم يَستَغفِرِ",11,"ر",1,0],["وَأَنزَلنا البُيوتَ بِذي طُلوحٍ","إِلى الشاماتِ تَنفي الموعِدينا",12,"ن",2,0],["وَإِنَّ زَماناً فَرَّقَ الدَهرَ بَينَنا","وَبَينَكُم في صَرفِهِ لَمَشومُ",13,"م",1,0],["وَأَنزَلَ آيَةً أَن قاتِلوهُم","يُعَذِّبهُم بِأَيديكُم فُنونا",14,"ن",2,0],["وَأَنزَلتَ مِن بَينِ الجَوانِحِ وَالحَشا","ذَخيرَةَ وُدٍّ طالَما قَد تَمَنَّعا",15,"ع",2,0],["وانزل على وادي السلام مُمَتَّعاً","برغيد عيش تحت ظلّ نخيله",16,"ل",2,0],["وإن زَوَّجُوا أمرَينِ جَورَاً وبِدعَةً","أنَاخُوا لأخرَى ذاتِ وَدقَينِ تُخطَبُ",17,"ب",1,0],["وَإِن زَجَرَ الرَحمَنُ عَن مُصمَئِلَّةٍ","أَتاها عَلاجيمٌ قَليلٌ حِباؤُها",18,"ا",3,0],["وأنزلت آمالي لديه وإنه","لأكرمُ من آل المهلَّب في المحل",19,"ل",1,0],["وإن زَواهُ عنكُمُ جانبٌ","فلا يَفُتْكُم ذلك الجانبُ",20,"ب",1,0],["وإن زالَ فرعٌ قبل أصلٍ فإنما","تُعَدُّ من الأحداث والفَلتاتِ",21,"ت",1,0],["وَاِنزِع إِلَيكَ فَإِنَّني لا جاهِلٌ","بِكُمُ وَلا أَنا إِن نَطَقتُ فَحومُ",22,"م",1,0],["وَاِنزَع مَعَ الدينارِ مِن قَبضَتي","صَلابَةَ الدينارِ من سِحنَتي",23,"ي",1,0],["وَإِنَّ زَماناً أَلجَأَتني صُروفُهُ","فَحاوَلتُ بُعدي عَنكُمُ لَمُذَمَّمُ",24,"م",1,0],["وَأَنَزَّهُ اِسمَكَ أَن تَمُرَّ حُروفُهُ","مِن غَيرَتي بِمَسامِعِ الجُلّاسِ",25,"س",1,0],["وإنْ زالَ عنها فذاكَ الفناءُ","وإنْ كان في عَرَصَاتِ الخُلودْ",26,"د",1,0],["وأنزلنا العدوّ وما نزلنا","وكنا للرواسى الشم هاما",27,"م",2,0],["وانزل على الطائر الميمون ساحتها","واجلس على تلّها وانعق بواديها",28,"ي",3,0],["وَأَنزَلوا السُنَّةَ عَن رُتبتها","وَرَفَعوا شِيعَتهم وَمَن غَلا",29,"ا",1,0],["وَاِنزِل بِنورِ الخُلدِ جَدَّكَ وَاِتَّصِل","بِمَلائِكٍ مِن آلِهِ أَشباهِ",30,"ا",2,0],["وأنزلني منه بألطفِ منزلٍ","كما مُزِجتْ بابنِ الغمامِ مُدامُ",31,"م",1,0],["وَإِن زُرتُها يَوماً فَلَيسَ بِمُخلِفي","رَقيبٌ يَراني أَو عَدُوٌّ أُحاذِرُه",32,"ر",2,0],["وَأَنزِفُ مِن حُزني دَمي لا مَدامِعي","وَأَيُّ دَمٍ أَبقَيتَ فِيَّ فَيَنزِفُ",33,"ف",1,0],["وَإِن زانَها تَطويلُها وَاِطِّرادُها","فَقَد شانَها تَقصيرُها وَقُصورُها",34,"ر",3,0],["وانزلْ وقبِّلْ تربَها متورِّعاً","متخضِّعاً متخشِّعاً متفرِّجا",35,"ج",2,0],["وَاِنزِل بِها ضَيفاً لِلَيثٍ خادِرٍ","يَقريكَ أَو جاراً لِظَبيٍ كانِسِ",36,"س",1,0],["وَإِنَّ زَماناً فَرَّقَ الدَهرُ بَينَنا","وَبَينَكِ يا لَيلى فَذاكَ ذَميمُ",37,"م",1,0],["وإن زعموا لَحُكمِ الفردِ معنىً","فتلك خُرافةُ المُتألِّهينا",38,"ن",2,0],["وَاِنزَعي مِن صُدورَنا جَمرة الحق","د وَسَلّي سجيّة الشَنآن",39,"ن",1,0],["وأُنزِلنا البِيوتَ بِذي طِلالٍ","إِلى النَسَماتِ نَبغي مُوعِدينا",40,"ن",2,0],["وَأَنزَفَت ماءَ عَيني","وَأَصعَدَت زَفَراتي",41,"ت",2,0],["وأنزَهُ منظراً في رسمِ دارٍ","منازلُ في ذرى قصرٍ أنيق",42,"ق",1,0],["وانزل فناءَ مجانةٍ","يا قومُ حيّ على النكاح",43,"ح",1,0],["وَأَنزَلَ حوتاً في السَماءِ فَضَمَّهُ","إِلى النونِ في خَضراءَ فَاِعتَرَفَ السُلبا",44,"ب",2,0],["وَاِنزِل بِعِرضِكَ في أَعَزِّ مَحَلَّةٍ","فَالغَورُ لَيسَ بِمَوطِنٍ لِلمُنجِدِ",45,"د",1,0],["وَإِنَّ زَماناً فَجرُهُ مِثلُ سَيفِهِ","هِلالٌ دُجاهُ مِن مَخالِبِهِ الحُجنِ",46,"ن",1,0],["وأَنزلَ الجزيةَ والدَّواهِي","على الذينَ أَشركوا باللّهِ",47,"ه",1,0],["وأنزلَ الغيثَ على راغبٍ","رحمتَهُ إذ قنَطَ الراغبُ",48,"ب",1,0],["وانزل دمشق وخاطب صخر مسجدها","عمن بناه لعل الصخر ينعاه",49,"ا",2,0],["وإن زَعيم القوم لَيسَ يغرهم","وَلا هُوَ يجزي فضلهم بكنود",50,"د",1,0],["وَإِنْ زَلَّتِ الأَقْدَامُ فِي دَرْكِ غَايَةٍ","تَحَارُ بِهَا الأَلْبَابُ كَانَ لَهَا الْخَصْلُ",51,"ل",1,0],["وَإِن زاروهُمُ الشَيخَينِ زُرنا","عَلِيّاً وَاِبنَهُ سِبطَ الرَضِيِّ",52,"ي",1,0],["وانزِلْ إلى مَثوى الصديق تَجد بهِ","ما شِئتَ مِنْ حُبٍّ ومن إشرافِ",53,"ف",1,0],["وانزِلْ برَأْس التّين واخْشَعْ مُطْرِقاً","ممّا تُحِسُّ مِنَ الْجَلال وتُبْصِرُ",54,"ر",1,0],["وانزِعي عن جسمِك الثوب يَبِن","رُبّ حق ضاع في ثوب رياء",55,"ا",2,0],["وانزوى حيث لا يحسّ صديقا","يجتبيه ولا عدوّا يروعه",56,"ع",2,0],["وانزوت وحدها تئنّ وتستلقي","وراء الحياة ، خلف الطبيعة",57,"ع",2,0],["وانزرعنا في قلب ( سنوان) قمحاً","وانتثرنا في ريح ( صنعا) طحينا",58,"ن",2,0],["وانزرعنا تحت أمطار الفناء","شجرا ملء المدى أعيّا الزوال",59,"ل",1,0],["وانزوَتْ تلكُمُ الخليعهُ ! طولَ اليومِ","\" عُريانةً \" وراءَ حجاب",60,"ب",1,0],["وانزوت في بُيوتها أدباءٌ","حَطَمت خِيفةَ الهوان اليراعا",61,"ع",2,0],["وأنزلتَ منْ بينِ الجوانحِ والحشا","أَبَا مَخْلَدٍ!كُنَّا عَقيدي مَوَدَّة ٍ",62,"ه",1,0],["وانزل على خير الأبوّة رحمة","تسع الحياة وعفّة وصلاحا",63,"ح",2,0],["وَأَنْزَلْنَا البُيُوْتَ بِذِي طُلُوْحٍ","إِلَى الشَامَاتِ نَنْفِي المُوْعِدِيْنَا",64,"ن",2,0],["وانزل عن سرير الملك خلعا","وأفرد لا نديمَ ولا قرينا",65,"ا",1,0],["وانزل بها برحاب احمد وانتدب","ذاك الهزبر حسامها المسنونا",66,"ن",2,0],["وانزل بنا برحاب سادات الحمى","غر الوجوه ايمة الاسلام",67,"م",1,0],["وانزل حمى رجب الولي المرتجى","يوم الوغا للنقض والابرام",67,"م",1,0],["وانزل بشطحا الفكر","واشرب كؤس الشكر",68,"ر",1,0],["وأنزل بوادي طور سينا قريها","وأشهد معاني نورها وضياها",69,"ا",3,0],["وانْزِلْ على صَدري ودِفءِ الحَشا","لِيَسْكُنَ اللَّيلُ، ويَزهو السَّمَرْ",70,"ر",1,0],["وانزل إلى روضةٍ من يونسِ ازدهرت","وموضع بابن سعد الدين مسعودِ",71,"د",1,0],["وإن زَغزغَتهنَّ البنانُ تضاحكتْ","قَهاقِهُ في ترجيعهنَّ صَليلُ",72,"ل",1,0],["وإنّ زمانا ضمّ شملى وشملَهم","لكالليل مَسرَى ضيغم ونمالِ",73,"ل",1,0],["وإن زعزعتْه فإن القنا","ةَ للطعن زعزعها الطاعنونا",74,"ن",2,0],["وَأَنزَلَتكَ السُيوفُ مَنزِلَةً","طالَ عَلى مَن يَرومُها الأَمَدُ",75,"د",1,0],["وَأَنزَرُها كَالأَتِيِّ اِستَمَدَّ","وَأَيسَرُها كَالغُمامِ اِستَهَلّ",76,"ل",1,0],["وإن زأرت ليوث الغيل","لم تثبت لها الحمر",77,"ر",1,0],["وان زمانا أنت سلطان أهله","ملى بان يكفي القضايا العظائما",78,"م",2,0],["وانزعت بالجود القلوب محبة","تفيض فيمليها على الألسن الصدر",79,"ر",1,0],["وإنزل بساحة من نزولك عنده","عز يطول به الرجال ومفخر",80,"ر",1,0],["وَأَنزَلَها دارَ الأَعادي بِسَيفِهِ","فَأَضحَت خَفافيثاً لَدَيها صِلالُها",81,"ل",3,0],["وانزل بنا بين بيوت النقا","فقد غدت آهلة المربع",82,"ع",1,0],["وَأَنزَلتُ رحلي مِنكَ في خَيرِ بُقعةٍ","أَرى أُمماً فيها بظلِّكَ رُتَّعَا",83,"ع",2,0],["وأنزلتُ حاجاتي بفضلِ بني أبي ال","شجاعِ فهم لي ملجأ ومَآب",84,"ب",1,0],["وإنْ زُيِّفتْ فاعترافِي يَقوم","شَفيعا لها آخِذا بالزمام",85,"م",1,0],["وإن زمانا يمنع الحر خيره","عن الناس من خوف الأذى لشديد",86,"د",1,0],["وإن زفرتْ شابَ الوليدُ لهولها","وكانَ خليقاً أن يشيبَ ويهرما",87,"م",2,0],["وَأُنزِع من جانِبَيكِ الفُؤادَ","وَأُخبئُهُ في دُجى أَضلُعي",88,"ي",1,0],["وانزِعي عَن جِسمِك الثَوب يَبن","لِلمَلا تكوينُ سكّانِ السَماء",89,"ا",2,0],["وانزلوا الخفيف من منىً فيه ظل","للأماني للنازلين ظليل",90,"ل",1,0],["وأنزل أملاك السماء لنصره","على كل خوان السريرة ناكث",91,"ث",1,0],["وَأَنزَلنا الرَجاءُ عَلى رَحيبِ ال","قِرا وَالباعِ يَحمَدُهُ النَزيلُ",92,"ل",1,0],["وَإِن زَعَمتُم أَنّي أَتَيتُ بِها","خَديعَةٍ فَالكَريمُ مُنخَدِعُ",93,"ع",1,0],["وَأَنزَرَ في الفَضلِ مِن حَظِّهِ","وَأَغزَرَ في الجَهلِ مِن ديمَتِه",94,"ت",2,0],["وَأَنْزَلَ بِالدُّعَاءِ غَزِيرَ قَطْرٍ","عَلَى مَنْ ضَرَّهُ شُهْبُ السِّنِينِ",95,"ن",1,0],["وَأَنْزِلْهُ فِي غُرُفَاتِ الرِّضَى","فَمَا حَلَّ تِلْكَ الْمَنَازِلَ بُوسْ",96,"س",1,0],["وَأَنزَلَ خَوفُنا سَعداً بِأَرضٍ","هُنالِكَ إِذ تُجيرُ وَلا تُجارُ",97,"ر",1,0],["وان زمانا ورده لك آجن","ليعييك ان تلقاه في فيك سائغا",98,"غ",2,0],["وإن زماناً جاد فينا بمثله","لأعجب من أمثاله في العجائب",99,"ب",1,0],["وأنزعُ كلَّ تقليد عَقيمٍ","وكلَّ خرافةٍ للأوَّلينا",100,"ن",2,0],["وانزل عليه فما نزلت بسوحه","الا نزلت على ابي الضيفان",101,"ن",1,0],["وانزل عَلى الكرم العَريض فَرُبما","اغنتك دجلة عن ثماد ثمودا",102,"د",2,0],["وانزل من الدين وَالدنيا بنورهما","فالعسر يسر به وَالعقد مَحلول",103,"ل",1,0],["وأنزلته في داره وَمحله","وَما من يقول الشعر في غير أَهله",104,"ه",1,0],["وانزل بمن حل في القبرين مصطحبا","حسن الظنون وسل ما شئته تنل",105,"ل",1,0],["وأنزل باغضيه من الصياصي","وَلَم يترك له في الارض قرنا",106,"ن",2,0],["وانزل من اعلى ذوائِب هاشم","باسمح من فيض الغمام وجودا",107,"د",2,0],["وأنزل حاجَتي في كل حال","الى من تطمئن به القلوب",108,"ب",1,0],["وإِنْ زَمَنُ الْوَرْدِ انْقَضى كانَ عِنْدَهُمْ","مَواهِبُ يُلْغى عِنْدَها زَمَنُ الْوَرْدِ",109,"د",1,0],["وَإِنَّ زَماناً أَنْتَ مِنْ حَسَناتِهِ","حَقِيقٌ بِأَنْ يَخْتالَ مِنْ فَرطِ عُجْبِهِ",110,"ب",2,0],["واِنزل برحبٍ ودعه","وجَفنةٍ مُدَعدَعَه",111,"ه",1,0],["واِنزل ولا تخشَ من عناءٍ","فها هنا يُكرَمُ النَزيلُ",112,"ل",1,0],["وأنزل لنا غيثاً وأنبت لنا","وانج من حرها ومن وهج",113,"ج",1,0],["وَإِن زَعَمت بأنّي قد ظَفرتُ به","وَصرتُ دونكَ مغناهُ وناديهِ",114,"ي",2,0],["وَإِن زانَكَ العِلمُ الَّذي قَد حَمَلتَهُ","وَجَدتَ لَهُ مَن يَجتَنيهِ وَيَحمِلُه",115,"ه",1,0],["وإنْ زَادَ عَن هذا تَربّبْتُ حَبَّهُ","وَعَبْدُكَ لا يَخْتارُ شَيْئاً مُزَبَّبَا",116,"ب",2,0],["وَإنْ زادَ طَارٍ يُزَدْ كَوز زيرٍ","فَليسَ بِضَائرِنا مَن طَرَقْ",117,"ق",1,0],["وَإِن زَعَموا بِهِ نَوعاً بَديعاً","فَعِندي أن ذَلِكَ شرُّ بدعَه",118,"ه",1,0],["وَاِنزِلا مَنزِلاً كَريماً تَباهَت","بِعُلاه مَنازل الأَحبابِ",119,"ب",1,0],["وَانزَعوا الأخفافَ مِن أقدَامِكُم","كَي تلاقِي تُربَهَا المُقَدَّسا",120,"س",2,0],["وَاِنزِل بِسوحِ بَني الصِدّيق ملتجئا","لاحمد بن أَبي بَكر وَصنو عَلى",121,"ل",2,0],["وَاِنزل منى فهناك قَد بَلَغَ المُنى","قَوم وَفازوا بِالمَقام الاِرفَع",122,"ع",1,0],["وأنزَلْتُها منّي بأكرمِ مَنزِلٍ","وآثَرتُها لو آثَرتْ بالهوَى البَعْلا",123,"ل",2,0],["وأن زارَك السُّلطانُ ضَيفاً مُسلِّماً","وما فَوقَ هذا للبريّةِ من شَرَف",124,"ف",1,0],["وَأَنزَلَ بي بَعضُ الأَخِلّاءِ حاجَةً","وَكُنتُ عَلى عُسرٍ بِها لا عَلى يُسرِ",125,"ر",1,1],["وَإِن زالَ اللِقاءُ فَلا لِقاءٌ","فَإِنَ الشَوق باقٍ لا يَزولُ",126,"ل",1,0],["وأن زماني لا رعى اللّه سِرْبَهُ","يوافقني فيما أروم وأقصد",127,"د",1,0],["وانزل إزال فإنهم نزلوا","منها بسفح الجانب الغربي",128,"ب",2,0],["وأنزلتهُ مني بوضع مُهجتي","وواللَهِ لا فارَقتُهُ بيمينِ",129,"ن",1,0],["وإنْ زوَّجوه كانَ من صلبه الَّذي","تَقَرُّ به عين العلاء وتسعد",130,"د",1,0],["وَإِن زَجَروا طَيراً بِنَحسٍ تَمرُّ بي","زَجَرتُ لَهُم طَيراً تَمُرُّ بِهِم سَعدا",131,"د",2,0],["وانزل فوق ذيل الثغر خالاً","ليمنع من طلى الشفتين ورد",132,"د",1,0],["وإِنْ زُجَّ فِي جَفْنِ الرَّدى فَلِحَيْنِهِ","تَخَازَرَ ساجِيهِ وأُوقِظَ نائِمُهْ",133,"م",2,0],["وإن زانها تطويلها واطرادها","فقد شانها تقصيرها وسمودها",134,"د",3,0],["وإن زرتهم غب السرى فهمو غنى","متى ما أردوا في عيونهم العفوا",135,"و",2,0],["وإِن زلت بهم قدم","غدوا في الذل والخرب",136,"ب",1,0],["وأَنزل كلما طلعوا","لنجد فيك بالثلب",136,"ب",1,0],["وأنزلها بأطباق السقوف","مجاورة القبور الموحشات",137,"ت",1,0],["وأن زراد شت استعان بفكره","على وضعه حتى استفاد به نجحا",138,"ح",2,0],["وأنزل ببسِّيمة الزهراء مُنْتَشِقاً","نسيمها اللّدن في الآصال والبكر",139,"ر",1,0],["وأنزلتَني من دارِ أنسك منزلا","يُربِّبُ عزمي أن أروح فأظعنا",140,"ن",2,0],["وأنزلتَ بالعُصُم العازبا","ت عنها وما طاولتك النزالا",141,"ل",2,0],["وأنزع من شرك الإله مُبَرَّؤٌ","بطينٌ من الأحكام جَمُّ النَّوافل",142,"ل",1,0],["وِانَّ زماناً لا يَرى فيه مغرمٌ","أحبَّتهُ في الربعِ ليس مِنَ العمرِ",143,"ر",1,0],["وإن زدت حرفا بعد جزئيه سمه","ضعيف الحجا يوما بحسن أسوتي",144,"ت",2,0],["وإن زدت جزءا بعد جزئيه فاعلمن","بأن بلوج الصفا قطع حجتي",144,"ت",2,0],["وإن زدت بعد الفك حرفين إنه","عدو لكفار بحبل الشريعة",144,"ه",1,0],["وأنزلني جوارَ الأزد ليثاً","ولقني نصيباً في انصراف",145,"ف",1,0],["وانزل أمجهدها بحيِّ أحبَّةٍ","لخيامهم فوق النجوم ظلالُ",146,"ل",1,0],["وانزل عن الأكوار أنت ومن لدي","كَ تأدُّباً من قبل أن تأتيها",147,"ي",3,0],["وإن زار قبر نبي الهدى","فقد أكمل الله ما أَمَّ له",148,"ه",1,0],["واِنزِل فثَمَّ مُعرَّسٌ أبداً ترى","فيهِ قُلوب العِشقِ مِن رُكْبانِهِ",149,"ن",2,0],["وأنزلت منها كوشيار وإنما","تقنصت من فوق المجرة ضيغما",150,"م",2,0],["وَأَنْزَلَهُمْ مِنْ مَعْقِلٍ شامِخِ الذُّرَى","وعُطِّلَ مِنْهُمْ مِنْبَرٌ وسَرِيرُ",151,"ر",1,0],["وَإِن زُرتَهُ يَوماً فإنّ مَزارهُ","قَرا مُسرَجٍ في هَبوَةِ النّقعِ ملجَمِ",152,"م",1,0],["وإنْ زال شجوٌ عن قلوبٍ شجيّةٍ","فحزني عليك الدّهرَ ليس بزائلِ",153,"ل",1,0],["وَإِنْ زُرتَهم أَفضيتَ من شَجَراتِهمْ","إلى ورقٍ لا يعدَمُ الدّهرَ خابطا",154,"ط",2,0],["وَأَنزعُ وَصلَهُ بالرّغم منِّي","كَما نَزعتْ يدي عنّي رِياشي",155,"ش",2,0],["وإن زاد قرباً عبدها وهو ساجد","فما ذاك إلا أن نفاه ثباتها",156,"ت",3,0],["وانزل إليهم لا تُكَلْ","لفهم إلى أعلى المكان",157,"ن",1,0],["وإن زمزم الحادي بها فهي زمزم","وعن مصِّنا من ثديها ما لنا فطم",158,"م",1,0],["وإنزالُهُ القرآن قد حملت به","فروج قلوب بالعلوم تدافع",159,"ع",1,0],["وإن زدت صدقاً في محبته له","به زدت قرباً واهتدى منك ضائع",159,"ع",1,0],["وانزعوا حلة التكبّر عنكم","وابدلوا ذا الإيحاش بالإيناس",160,"س",1,0],["وأنزل الله به ال","قرآن كلُّه عبر",161,"ر",1,0],["وأنزله قد قال ربي بعلمه","وردّاه في كل الملابس فارتدى",162,"د",2,0],["وأَنزَفَ العَبرَةَ مَن لاقى العَبَر","طالَ الإِنى وَزايلَ الحَقُّ الأَشَر",163,"ر",1,0],["وَأَنزَفَ الحَقَّ وَأَودى مَن كَفَر","كانوا كَما أَظلَمَ لَيلٌ فَاِنسَفَر",163,"ر",1,0],["وإن زعمتم أنه أباحكم","عصيانه تركتم صلاحكم",164,"م",1,0],["وأنزل الله على أمينه","لزما ابتلي بالحزن من قرينه",164,"ه",1,0],["وأنزلوا في الدرجات العالية","بقدر ما قد أسلفوا في الخالية",164,"ه",1,0]]}