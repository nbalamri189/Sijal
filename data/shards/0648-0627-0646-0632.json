{"poems":[[53,"حلفت بها صيد الرؤوس سوام","https://www.aldiwan.net/poem29752.html","الطويل"],[53,"أشم ببابل بو الصغار","https://www.aldiwan.net/poem29843.html","المتقارب"],[53,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[63,"مزجنا دماء بالدموع السواجم","https://www.aldiwan.net/poem45816.html","الطويل"],[34,"إلى الله أشكو فقد لبنى كما شكا","https://www.aldiwan.net/poem4931.html","الطويل"],[57,"وأنزلني طول النوى دار غربة","https://www.aldiwan.net/poem24643.html","الطويل"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"بحيث القباب البيض والأسل السمر","https://www.aldiwan.net/poem36489.html","الطويل"],[86,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[54,"أفيقي من ملامك يا ظعينا","https://www.aldiwan.net/poem27460.html","الوافر"],[54,"أبا مخلد كنا حليفي مودة","https://www.aldiwan.net/poem27531.html","الطويل"],[88,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[23,"لقد بدلت نجران بعد ملوكها","https://www.aldiwan.net/poem21528.html","الطويل"],[72,"حلفت بما يملا النديم وما يملي","https://www.aldiwan.net/poem19468.html","الطويل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[70,"رد السلام رسول بعض الناس","https://www.aldiwan.net/poem42851.html","السريع"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"يا قلب ويحك والمودة ذمة","https://www.aldiwan.net/poem8110.html","الكامل"],[62,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[28,"ألا من لشوق أنت بالليل ذاكره","https://www.aldiwan.net/poem5077.html","الطويل"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[33,"تعشقت ليلى وابتليت بحبها","https://www.aldiwan.net/poem25818.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[102,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[21,"غدا جيران أهلك ظاعنينا","https://www.aldiwan.net/poem36142.html","الوافر"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"ألا حي المنازل بالعقيق","https://www.aldiwan.net/poem66579.html","الوافر"],[48,"نك من لقيت من الصباح","https://www.aldiwan.net/poem66610.html","مجزوء الكامل"],[46,"أطل صليب الدلو بين نجومه","https://www.aldiwan.net/poem22112.html","الطويل"],[46,"إركع لربك في نهارك واسجد","https://www.aldiwan.net/poem22482.html","الكامل"],[46,"متى أنا في هذا التراب مغيب","https://www.aldiwan.net/poem23495.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"ما قدر الله هو الغالب","https://www.aldiwan.net/poem39492.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10257","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[100,"من ذا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=50178",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[54,"هوانا وقلبانا جميعاً معاً معَا","https://www.poetsgate.com/ViewPoem.aspx?id=14309",""],[5,"أَلاَ هُبِّي بِصَحْنِكِ فَاصْبَحِيْنَا ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=671&r=&rc=0",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["وَإِنَّ زَماني يَومَ يَحرُقُ نابَهُ","أُعاذِمُهُ حَتّى يَمُدَّ عِذامي",0,"ي",1,0],["وَأَنزِلُ في القَومِ أَقلالَهُم","وَلَولا الحَضارَةُ لَم أَنزِلِ",1,"ل",1,0],["وَأَنزو نَزوَةَ البازِ","لِ لا يُبرِكُهُ الحَملُ",2,"ل",1,0],["وَإِن زالَ نَجمٌ مِن ذُؤابَةِ هاشِمٍ","فَلا عَجَبٌ إِنَّ النُجومَ تَزولُ",3,"ل",1,0],["وَاِنزِلي بي مُجاوِراً في أُناسٍ","لا يَذُمُّ النَزيلِ فيهِم جِوارا",4,"ر",2,0],["وَإِن زَهِدوا في الأَجرِ إِذ حَمِسَ الوَغَى","فَهَلّا أَتَوْهُ رَغبَةً في الغَنائِمِ",5,"م",1,0],["وَإِنَّ زَمانا شَتَّتَ الشَملَ بَينَنا","وَبَينَكُمُ فيهِ العِدى لَمَشومُ",6,"م",1,0],["وَأَنزَلَني طولُ النَوى دارَ غُربَةٍ","إِذا شِئتُ لاقَيتُ أَمراً لا أُشاكِلُه",7,"ه",1,1],["وَإِنْ زَمَنٌ يَوْماً عَرَتْهُ زَمَانَةٌ","فَرَاحَتُهُ بُرْءُ الزَّمَانِ مِنَ السُّقْمِ",8,"م",1,0],["وإنْ زَحَفوا منْ دونِ رايَةِ يوسُفٍ","تَقولُ تَعالَى مَنْ لهُ الخَلْقُ والأمْرُ",9,"ر",1,0],["وَأَنزَلوهُ بِأُفقٍ مِن مَطالِعِهِ","فَوقَ الكَواكِبِ لا تَحتَ الجَلاميدِ",10,"د",1,0],["وَاِنزِل عَلَيهِ السُخطَ إِن","أَمسى وَلَم يَستَغفِرِ",11,"ر",1,0],["وَأَنزَلنا البُيوتَ بِذي طُلوحٍ","إِلى الشاماتِ تَنفي الموعِدينا",12,"ن",2,0],["وَإِنَّ زَماناً فَرَّقَ الدَهرَ بَينَنا","وَبَينَكُم في صَرفِهِ لَمَشومُ",13,"م",1,0],["وَأَنزَلَ آيَةً أَن قاتِلوهُم","يُعَذِّبهُم بِأَيديكُم فُنونا",14,"ن",2,0],["وَأَنزَلتَ مِن بَينِ الجَوانِحِ وَالحَشا","ذَخيرَةَ وُدٍّ طالَما قَد تَمَنَّعا",15,"ع",2,0],["وانزل على وادي السلام مُمَتَّعاً","برغيد عيش تحت ظلّ نخيله",16,"ل",2,0],["وإن زَوَّجُوا أمرَينِ جَورَاً وبِدعَةً","أنَاخُوا لأخرَى ذاتِ وَدقَينِ تُخطَبُ",17,"ب",1,0],["وَإِن زَجَرَ الرَحمَنُ عَن مُصمَئِلَّةٍ","أَتاها عَلاجيمٌ قَليلٌ حِباؤُها",18,"ا",3,0],["وأنزلت آمالي لديه وإنه","لأكرمُ من آل المهلَّب في المحل",19,"ل",1,0],["وإن زَواهُ عنكُمُ جانبٌ","فلا يَفُتْكُم ذلك الجانبُ",20,"ب",1,0],["وإن زالَ فرعٌ قبل أصلٍ فإنما","تُعَدُّ من الأحداث والفَلتاتِ",21,"ت",1,0],["وَاِنزِع إِلَيكَ فَإِنَّني لا جاهِلٌ","بِكُمُ وَلا أَنا إِن نَطَقتُ فَحومُ",22,"م",1,0],["وَاِنزَع مَعَ الدينارِ مِن قَبضَتي","صَلابَةَ الدينارِ من سِحنَتي",23,"ي",1,0],["وَإِنَّ زَماناً أَلجَأَتني صُروفُهُ","فَحاوَلتُ بُعدي عَنكُمُ لَمُذَمَّمُ",24,"م",1,0],["وَأَنَزَّهُ اِسمَكَ أَن تَمُرَّ حُروفُهُ","مِن غَيرَتي بِمَسامِعِ الجُلّاسِ",25,"س",1,0],["وإنْ زالَ عنها فذاكَ الفناءُ","وإنْ كان في عَرَصَاتِ الخُلودْ",26,"د",1,0],["وأنزلنا العدوّ وما نزلنا","وكنا للرواسى الشم هاما",27,"م",2,0],["وانزل على الطائر الميمون ساحتها","واجلس على تلّها وانعق بواديها",28,"ي",3,0],["وَأَنزَلوا السُنَّةَ عَن رُتبتها","وَرَفَعوا شِيعَتهم وَمَن غَلا",29,"ا",1,0],["وَاِنزِل بِنورِ الخُلدِ جَدَّكَ وَاِتَّصِل","بِمَلائِكٍ مِن آلِهِ أَشباهِ",30,"ا",2,0],["وأنزلني منه بألطفِ منزلٍ","كما مُزِجتْ بابنِ الغمامِ مُدامُ",31,"م",1,0],["وَإِن زُرتُها يَوماً فَلَيسَ بِمُخلِفي","رَقيبٌ يَراني أَو عَدُوٌّ أُحاذِرُه",32,"ر",2,0],["وَأَنزِفُ مِن حُزني دَمي لا مَدامِعي","وَأَيُّ دَمٍ أَبقَيتَ فِيَّ فَيَنزِفُ",33,"ف",1,0],["وَإِن زانَها تَطويلُها وَاِطِّرادُها","فَقَد شانَها تَقصيرُها وَقُصورُها",34,"ر",3,0],["وانزلْ وقبِّلْ تربَها متورِّعاً","متخضِّعاً متخشِّعاً متفرِّجا",35,"ج",2,0],["وَاِنزِل بِها ضَيفاً لِلَيثٍ خادِرٍ","يَقريكَ أَو جاراً لِظَبيٍ كانِسِ",36,"س",1,0],["وَإِنَّ زَماناً فَرَّقَ الدَهرُ بَينَنا","وَبَينَكِ يا لَيلى فَذاكَ ذَميمُ",37,"م",1,0],["وإن زعموا لَحُكمِ الفردِ معنىً","فتلك خُرافةُ المُتألِّهينا",38,"ن",2,0],["وَاِنزَعي مِن صُدورَنا جَمرة الحق","د وَسَلّي سجيّة الشَنآن",39,"ن",1,0],["وأُنزِلنا البِيوتَ بِذي طِلالٍ","إِلى النَسَماتِ نَبغي مُوعِدينا",40,"ن",2,0],["وَأَنزَفَت ماءَ عَيني","وَأَصعَدَت زَفَراتي",41,"ي",1,0],["وأنزَهُ منظراً في رسمِ دارٍ","منازلُ في ذرى قصرٍ أنيق",42,"ق",1,0],["وانزل فناءَ مجانةٍ","يا قومُ حيّ على النكاح",43,"ح",1,0],["وَأَنزَلَ حوتاً في السَماءِ فَضَمَّهُ","إِلى النونِ في خَضراءَ فَاِعتَرَفَ السُلبا",44,"ب",2,0],["وَاِنزِل بِعِرضِكَ في أَعَزِّ مَحَلَّةٍ","فَالغَورُ لَيسَ بِمَوطِنٍ لِلمُنجِدِ",45,"د",1,0],["وَإِنَّ زَماناً فَجرُهُ مِثلُ سَيفِهِ","هِلالٌ دُجاهُ مِن مَخالِبِهِ الحُجنِ",46,"ن",1,0],["وأَنزلَ الجزيةَ والدَّواهِي","على الذينَ أَشركوا باللّهِ",47,"ه",1,0],["وأنزلَ الغيثَ على راغبٍ","رحمتَهُ إذ قنَطَ الراغبُ",48,"ب",1,0],["وإن زَعيم القوم لَيسَ يغرهم","وَلا هُوَ يجزي فضلهم بكنود",49,"د",1,0],["وَإِنْ زَلَّتِ الأَقْدَامُ فِي دَرْكِ غَايَةٍ","تَحَارُ بِهَا الأَلْبَابُ كَانَ لَهَا الْخَصْلُ",50,"ل",1,0],["وَإِن زاروهُمُ الشَيخَينِ زُرنا","عَلِيّاً وَاِبنَهُ سِبطَ الرَضِيِّ",51,"ي",1,0],["وانزِلْ إلى مَثوى الصديق تَجد بهِ","ما شِئتَ مِنْ حُبٍّ ومن إشرافِ",52,"ف",1,0],["وانزِلْ برَأْس التّين واخْشَعْ مُطْرِقاً","ممّا تُحِسُّ مِنَ الْجَلال وتُبْصِرُ",53,"ر",1,0],["وانزِعي عن جسمِك الثوب يَبِن","رُبّ حق ضاع في ثوب رياء",54,"ا",2,0],["وانزل دمشق وخاطب صخر مسجدها","عمّن بناه لعل الصخر ينعاه",55,"ا",2,0],["وانزوت وحدها تئنّ وتستلقي","وراء الحياة ، خلف الطبيعة",56,"ع",2,0],["وانزرعنا في قلب ( سنوان) قمحاً","وانتثرنا في ريح ( صنعا) طحينا",57,"ن",2,0],["وانزوَتْ تلكُمُ الخليعهُ ! طولَ اليومِ","\" عُريانةً \" وراءَ حجاب",58,"ب",1,0],["وانزوت في بُيوتها أدباءٌ","حَطَمت خِيفةَ الهوان اليراعا",59,"ع",2,0],["وأنزلتَ منْ بينِ الجوانحِ والحشا","أَبَا مَخْلَدٍ!كُنَّا عَقيدي مَوَدَّة ٍ",60,"ه",1,0],["وَأَنْزَلْنَا البُيُوْتَ بِذِي طُلُوْحٍ","إِلَى الشَامَاتِ نَنْفِي المُوْعِدِيْنَا",61,"ن",2,0],["وانزل عن سرير الملك خلعا","وأفرد لا نديمَ ولا قرينا",62,"ا",1,0]]}