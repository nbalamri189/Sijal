{"poems":[[55,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[75,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[32,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[87,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[87,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem7134.html","الرمل"],[87,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[51,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[102,"الفاتح الأعزل","https://www.poetsgate.com/ViewPoem.aspx?id=50351",""],[132,"صب تحرقه أسى لرعاته","https://www.aldiwan.net/poem50654.html","الكامل"],[173,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[310,"صبحا بدا من رأي خير الدين","https://www.aldiwan.net/poem56390.html","الكامل"],[371,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[385,"رويدا إن للضيق انفراجا","https://www.aldiwan.net/poem48757.html","الوافر"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[534,"خود رداح ربحله","https://www.aldiwan.net/poem37219.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122723","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48810","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63933","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145829","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59687","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130670","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53165","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88691","السريع"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138890",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205850","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205781","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100263","المتقارب"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112650","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99321","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91362","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205889",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138821",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204165","الخفيف"],[4791,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36905",""],[4883,"بنت_تهز الأسئله","https://www.poetsgate.com/ViewPoem.aspx?id=48368",""],[4927,"قالت: أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=30176",""],[5055,"عبارات الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=101657",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5232,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=213660",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6056,"طريق المدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=130179",""],[6097,"فرّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190668",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""]],"verses":[["مَرِمّونَ مِن قَبلِ اللِقاءِ مَهابَةً","إِذا رَمَقوا بابَ الطِرافِ المُمَدَّدِ",0,"د",1,0],["مَرمَرٌ أَوفَدَ الفِرِندَ عَلَيهِ","سَلسَلٌ بَحرُهُ الزُلالُ يَفيضُ",1,"ض",1,0],["مُرِمّينَ مِن لَيثٍ عَلَيه مَهابَةٌ","تَفادى الأُسودُ الغُلبُ مِنهُ تفاديا",2,"ي",2,0],["مرّ ما مرَّ من قرون علينا","رُسَّفا في القيود والأغلال",3,"ل",1,0],["مر من بعدك ما روّعني","أتُرى يا حلو بُعدى روّعك",4,"ك",1,0],["مَرموقِ أَسبابِ الشَبابِ وَإِن بَدَت","لِلشَيبِ في الفَودِ الأَحَمِّ رَواعي",5,"ع",2,0],["مَرمَرٌ تَسبَحُ النَواظِرُ فيهِ","وَيَطولُ المَدى عَلَيها فَتُرسي",6,"س",2,0],["مَرمَرٌ قامَتِ الأُسودُ عَلَيهِ","كَلَّةَ الظُفرِ لَيِّناتِ المَجَسِّ",6,"س",1,0],["مَرمَرٌ أُضجِعَ في مَسنونِهِ","حَجَرُ الأَرضِ وَضِرغامُ العَرين",7,"ن",1,0],["مُرٌّ مَذاقَهُ عُقباها وَأَوَّلُها","غَدّارَةٌ تُكثِرُ الأَحزانَ وَالعِلَلا",8,"ل",2,0],["مَرْمَى العُقُولِ إذا ما غَرَّهَا هَدَفٌ","فلن تُريدَ سِواهُ إن رَمَتْ هَدَفَا",9,"ف",2,0],["مرمي كالقبر المنسي","وإلى كل الدنيا يرحل",10,"ل",1,0],["مرمي يرحل من بعد","كالهول إلى البعد iالأهول",10,"ل",1,0],["مرموقةٌ لفتاته معشوقة","حركاتُه محبوبةٌ نظراتُه",11,"ت",2,0],["مُرِمِّينَ إِلّا عَن حَديثٍ مُصَرَّدٍ","تُخالِسُهُم أَبصارُهُم وَتُسارِقُ",12,"ق",1,0],["مرمى تناضل فيه الحادثات فمن","تصبه تنصبه في عرض الردى هدفا",13,"ف",2,0],["مَرمى مرامِ النجمِ دون مرامهِ","لَو لَم يَكُن مِن همّ خير الدينِ",14,"ن",1,0],["مَرَّ مَكدودُ النَسيمِ وَلَم","يَلتَفِت ثَهلانُ وَالهِضَبا",15,"ب",2,0],["مرمَّتهُ وَخدمتهُ ثَواب","وَقلَّ لَهُ وَإِن سَقَفوهُ عاجا",16,"ج",2,0],["مُرمَعِلّاتٌ كَسِمطَيِّ لُؤلُؤٍ","خُذِلَت أَخراتُهُ فيهِ مَغَر",17,"ر",1,0],["مرمارةٌ رَصُوفُ","وَبَضَّةٌ ألوفُ",18,"ف",1,0],["مَرمُوقَة الطَّرَفينِ أدمِجَ نَسجُها","رَصعاً وفُصِّلَ نظمُها تَفصيلا",19,"ل",2,0],["مر ماضي المرسوم بالقدر الجا","ري ولم يأت بعده مرسوم",20,"م",1,0],["مَرَّ من لا يُعاضُ منه ولا يُعْتا","ضُ من لبسِ ثوبِ خزٍّ بِخَيش",21,"ش",1,0],["مُرٌّ متاهي يا سؤاليَ اقترفْ","ذنبَ الجوابِ بعدَهُ عِشْ أصمَتا",22,"ت",2,0],["مَرمى قِسيّ في تباعد قصدها","نزعتْ فلم يبعد لهنَّ مرام",23,"م",1,0],["مَرْمَىً لِغَيْرِ الأَسْدِ إِذْ يُرامِي","مَرْمَى امْرِئٍ لِنَفْسِهِ ظَلّامِ",24,"م",1,0],["مرملةٌ وقيل فيها متربَه","منشأةٌ بوصلها مجنبه",25,"ه",1,0],["مر ما تشاء فإنني","فيما تشاء عَلَى الأثر",26,"ر",1,0],["مُرْ مقلتيك ببرء قلب مدنف","لجنونه مد العذارُ سلاسلا",27,"ل",2,0],["مر مدلا فتأوهتها","حسرة يعقوب واوفى شجون",28,"ن",1,1],["مرملاً بدماه ليت عينك يا","جداه تنظره في الترب منجدك",29,"ك",1,0],["مرّ من تحتها الغزاة ولكن","نك في ظلها طويل الثواء",30,"ا",2,0],["مرّ من عهدنا ثلاثون حولاً","وهوانا لم يعد فجر الشباب",31,"ب",1,0],["مر من تحتنا يغمغم لحنا","يتناغى كوشوشات الغصون",32,"ن",1,0],["مُرمّاً يصافح وجه الثرى","بوجه كشقة بدرٍ تبدّى",33,"د",2,0],["مرمر الحلق فالمرارة منه","بعد زاد حلاوة ذاتيه",34,"ي",2,0],["مُرملا رأتهُ بالدماءِ","موزَعُ الأوصالِ والأعضاءِ",35,"ا",2,0],["مرموقة الجنبات بالبدع التي","لم يهدها قط الربيع لروضةِ",36,"ه",1,1],["مرموزُ كلّ ذبيحةٍ وضحيَّةٍ","رَمَزتهُ وانتَسَخَت ومُوجِبُها انتَفَى",37,"ا",1,0],["مُر ما تشا يا مالكي وَاحتكمْ","فَاللَيلُ من جندي وَدَهري حرسْ",38,"س",1,1],["مُرْ ما بدا لك في الطري","ق ورُضْ على مهل شعوبه",39,"ب",2,0],["مر ما مر على عرسهما","وهما في روض عيشٍ خضل",40,"ل",1,0],["مرميد يا فرسان يا رجالي","لا تفصلوا الخيل عن العجال",41,"ل",1,0],["مرمغلّون إذا اشتدّ الوغى","للأعادي في سيوفٍ ونبال",42,"ل",1,0],["مرمَّلاً بدمٍ ما غسّلوه ولا","صلَّت عليه صلاة الميت خلان",43,"ن",1,0],["مر مراجان ودلى أندر عذاب","ذهبت هذي وذا بالهجر ذاب",44,"ب",1,0],["مر ما مر بي من اجلك حلة","وعذابي في مثل حبك عذب",45,"ب",1,0],["مرٍ مثيراته تعود بالافلاس","ومر يفيض وتختفي ما تطيقه",46,"ق",2,0],["مرمي عليها الأُمنيات","ووحْده عليها المهْزلة !",47,"ل",2,0],["مَرْمِيَّةٌº وَالنَّاْسُ تَحْذَرُ رِيْحَهَاْ","وَالْمَوْتُº وَالْحُبُّ اللَّعُوْبُ سَوَاْءُ",48,"ا",2,0],["مرماك يا لمح الشهب وش يزاغيكْ","شفت المجرّة في أصابعك بلور",49,"ر",1,0],["مرمروني تمرمرا وسقوني","بطلاهم صاب النفاق المرير",50,"ر",1,0],["مرَّ مِنْ وَجهك ِ ضوءٌ خافتٌ","فأزالَ الليلَ ، واغتالَ الضبابْ",51,"ب",1,0],["مرَّ منْ عمْري كثيرٌ","لم أعِشْ إلا قليلهْ",52,"ل",2,0],["مر من العيش به ماحلا","واغتم قلب كان جذلانا",53,"ن",2,0],["مرّ من جنبي هنوف ٍ قال عشقك معرسه","طبعها دايم تشاكس كل من جاء يمّنا",54,"ن",2,0],["مَرَّ مِثْلَ الرِّيحِ لَكِنْ","مِثْلَ صَخْرٍ اسْتَقَرْ",55,"ر",1,0],["مَرمَى أَمَانِيَّ - وَا شِعرَاهُ - مُمتَنِعٌ","لَا غَايَةٌ بَلَغَتْ مَا فِيهِ , لَا هَدَفُ",56,"ف",1,0],["مرّ من جانبي يزقزق (كالعصفور)","في كل خطوةٍ تغريدُ",57,"د",1,0],["مَرَّ منه القطن خيطاً دُونه","خفقةُ النجم إذا خرَّ مساءا",58,"ا",3,0]]}