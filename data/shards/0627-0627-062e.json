"أم الإفكِ فالإسلام عن ذاك زاجر",6,"ر",1,0],["أإخوتَنا من الكتَّابِ رِقُّوا","عليْنَا من مُغالطةِ الزَّمان",7,"ن",1,0],["أَأَخفَتِ العَينُ عِندَهُ خَبَراً","أَم بَلَغَ الكَيذُبانُ ما أَمَلَه",8,"ل",2,0],["أأخافُ أحداثَ الزمان وإنَّما","سيفي وكنزي مُهجتي وبناني",9,"ن",2,0],["أَأُخَيَّ لَو صَرَفَ الحَريصُ عِنانَهُ","لِيَفوتَهُ ما فاتَهُ ما قُدِّرا",10,"ر",2,0],["أَأَخافُ في أَلفٍ تَلَكُّؤَ مَن","حَمَلَ الأُلوفَ فَلَم يُخَف ظَلَعُه",11,"ع",2,0],["أَأُخَيَّ نَهنِه دَمعَكَ المَسفوكا","إِنَّ الحَوادِثَ يَنصَرِمنَ وَشيكا",12,"ك",2,1],["أَأَخيبُ عِندَكِ وَالصِبا لِيَ شافِعٌ","وَأُرَدُّ دونَكِ وَالشَبابُ رَسولي",13,"ل",2,0],["أَأُخَيَّ قد عزَّيْتَني بحسيبةٍ","منه فعَزِّ بها ذوي الأحسابِ",14,"ب",1,0],["أَأُخَيَّ لَم يَقِكَ المَنِيَّةَ إِذ أَتَت","ما كانَ أَطعَمَكَ الطَبيبُ وَما سَقى",15,"ا",1,0],["أَأُخَيَّ لَم تُغنِ التَمائِمُ عَنكَ ما","قَد كُنتُ أَحذَرُهُ عَلَيكَ وَلا الرُقى",15,"ا",1,0],["أَأُخَيَّ كَيفَ وَجَدتَ مَسَّ خُشونَةِ ال","مَأوى وَكَيفَ وَجَدتَ ضيقَ المُتَّكا",15,"ا",1,0],["أَأُخَيَّ كُن مُستَمسِكاً","بِجَميعِ ما لَكَ فيهِ رُشدُ",16,"د",1,0],["أَأُخَيَّ ما لَكَ ناسِياً","يَومَ التَغابُنِ في الأُمورِ",17,"ر",1,0],["أَأُخَيَّ ما الدُنيا بِواسِعَةٍ","لِمُنىً تَلَجلَجُ مِنكَ في الصَدرِ",18,"ر",1,0],["أَأُخَيَّ فَاذخَر ما اِستَطَع","تَ لِيَومِ بُؤسِكَ وَافتِقارِك",19,"ك",1,0],["أَأُخَيَّ إِنَّ المالَ إِن قَدَّمتَهُ","لَكَ لَيسَ إِن خَلَّفتَهُ لَكَ مالا",20,"ل",2,0],["أَأُخَيَّ كُلٌّ لا مَحالَةَ زائِلٌ","فَلِمَن أَراكَ تُثَمِّرُ الأَموالا",20,"ل",2,0],["أَأُخَيَّ شَأنَكَ بِالكَفافِ وَخَلَّ مَن","أَثرى وَنافَسَ في الحُطامِ وَغالى",20,"ل",2,0],["أَأُخَيَّ إِنَّ المَرءَ حَيثُ فِعالُهِ","فَتَوَلَّ أَحسَنَ ما يَكونُ فِعالا",20,"ل",2,0],["أَأُخَيَّ مَن عَشِقَ الرِئاسَةَ خِفتُ أَن","يَطغى وَيُحدِثَ بِدعَةً وَضَلالا",20,"ل",2,0],["أَأُخَيَّ إِنَّ أَمامَنا كُرَباً لَها","شَغبٌ وَإِنَّ أَمامَنا أَهوالا",20,"ل",2,0],["أَأُخَيَّ إِنَّ الدارَ مُدبِرَةٌ وَإِن","كُنّا نَرى إِدبارَها إِقبالا",20,"ل",2,0],["أَأُخَيَّ لا تَجعَل عَلَيكَ لِطالِبٍ","يَتَتَبَّعُ العَثَراتِ مِنكَ مَقالا",20,"ل",2,0],["أَأُخَيَّ إِنَّ الخَلقَ في طَبَقاتِهِ","يُمسي وَيُصبِحُ لِلإِلَهِ عِيالا",20,"ل",2,0],["أَأُخَيَّ فَاِرمِ مَحاسِنَ الدُ","نيا بِعَينٍ قالِيَه",21,"ي",2,0],["أَأُخَيَّ لا تَنسَ القُبو","رَ فَإِنَّها لَكَ مَوعِدُ",22,"د",1,1],["أَأُخَيَّ مَن لَكَ مِن بَني الدُ","نيا بِكُلِّ أَخيكَ مَن لَك",23,"ك",1,1],["أأخشى منَ الأعداءِ واللهُ ناصري","بخدَّامِ حظٍّ إنْ دعوتُ أجابوا",24,"ب",3,1],["أأُخيَّ \" عبودٌ \" ولستَ بمُعوِزٍ","مدحاً . ولكنَّ الجُحودَ مَعيب",25,"ب",1,0],["أَإِخواني وَلا إِخوانَ صِدقٍ","أُصافي بَعدَكُم إِلا الصِفاحُ",26,"ح",1,0],["أإخبْاتُهُ أحْفَى بهم أم حَنَانُهُ","ورأفَتُهُ أم عَدْلُهُ وتَرَفُّقُه",27,"ق",2,0],["أَأَختارُ البِحارَ عَلى البَراري","وَأَحياناً عَلى ظَبيِ الفَلاةِ",28,"ه",1,0],["أأختارُ البحارَ على البراري","وحيتاناً على ظبي الفلاةِ",29,"ه",1,0],["أَأَخشى عَذابَ اللَهِ وَاللَهُ عادِلٌ","وَقَد عِشتُ عَيشَ المُستَضامِ المُعَذَّبِ",30,"ب",1,0],["أَأَخرُجُ مِن تَحتِ هَذي السَماءِ","فَكَيفَ الإِباقُ وَأَينَ المَفَر",31,"ر",1,0],["أأخْمُلُ والنّبَاهَةُ فيّ لَفْظٌ","وأُقْتِرُ والقَناعَةُ لي عَتادُ",32,"د",1,0],["أَأَخْطَلُ لِمْ ذَكَرْتَ نِسَاءَ قَيْسٍ","فمَا رُوِّعْنَ مِنْكَ ولا سُبِينَا",33,"ن",2,1],["أأختاهُ أيُّ عذابٍ طغى","عليكِ وأيُّ ضنىً أو شقاءْ",34,"ا",2,0],["أإخْوانَنا بينَ الفُراتِ وجِلّقٍ","يدَ اللهِ لا خَبّرْتُكمْ بمُحال",35,"ل",1,0],["أَأَخُصُّ دَاوُداً بِذِكْ","رَى هِمَّةِ السَّمْحِ الْجَرَادْ",36,"د",1,0],["أَأَخُصُّ بِالإِطْرَاءِ مَا","لاِبْنِ الْجُمَيِّلِ مِنْ أَيَادْ",36,"د",1,0],["أَأَخُصُّ مُسْكَاتاً وَمَهْمَ","مَا يُسْتَجَدْ لِلهِ جَادْ",36,"د",1,0],["أَأَخُصُّ بَاخُسَ وَابْنَ مِرْ","زَا مِنْ أَفَاضِلِهَا الْعِدَادْ",36,"د",1,0],["أَأَخُصُّ مَيّاً وَهْيَ فِي","عَلْيَائِهَا ذَاتُ انْفِرَادْ",36,"د",1,0],["أَأَخْفَرْتَ النّبيَّ وكنت قدِماً","إلى السّوْءاتِ تجري بالعراءِ",37,"ا",2,0],["أَأَخي المعين على العدوّ بِمسلقٍ","أزرَى بوائل في ذكاء خطيبها",38,"ب",3,0],["أأُخيّ إنّ من الرجالِ بهيمةً","في صورةِ الرجال السميعِ المبصِر",39,"ر",1,0],["أأخِي دعوتُ فلم تُجِبْ ولرُبّما","قد كنتَ أسبقَ ناهضٍ لدُعاتِهِ",40,"ت",2,0],["أأُخَيَّ : لو سمِع النداءَ رُغامُ","ولو استجابَ إلى الصريخِ حِمام",41,"م",1,0],["أأخت الدّوح حسبك لا تغنّي","فأخت السّرب قد فقدت طلاها",42,"ا",3,0],["أَأُخْبِركُمْ ما البكْرُ فِي خَيرِ مَذْهَبِ","هِيَ الكَأْسُ فَارْشِفْ مَا تَشَاءُ وَقَلِّبِ",43,"ب",1,0],["أأخافُ من ريبِ الزمان وصرفهِ","ومُناصرِى سيفٌ فتى سلطانِ",44,"ن",1,1],["أأخافُ من ريبِ الزمانِ وصرفهِ","وبحبلِ وُدٍّ منك حَبْلِي وَاصِلُ",45,"ل",1,0],["أَإِخوَاني الأجِلَّةَ لَو نَظرتُم","بِطَرفٍ لَم يَكُن طَرفاً كَلِيلا",46,"ل",2,0],["أأخفي حبّهُ ودموعُ عيني","على حبيه أفصح ترجمانِ",47,"ن",1,0],["أأخشى صروف الدهر في عصرٍ ذي الندى","وكيف أخاف الجورَ في زمن المهدي",48,"د",2,0],["أأخا الحيا وابن الحيا وأبا الحيا","وكذا الكريم يكون نجل كرام",49,"م",1,0],["أأخشى بأن أظما وجودك كوثر","وفي كل دار منه ساقية تجرى",50,"ر",2,0],["أَأَخلُد بَينَ خِبٍّ أُسحُوانٍ","يُماكِرُني وَجِلفٍ حِنظِيانِ",51,"ن",1,0],["أََأَخُونُ مِن بَعد الموَدَّةِ والهَوى","خُلُقي إِذَن كَخَلائِقِ الأَنذالِ",52,"ل",1,0],["أََأَخُونُ مِن بَعد الموَدَّةِ والهَوى","كَلا وَربِّ مُحَمَّدٍ وبِلالِ",52,"ل",1,0],["أَإخواني بذاك الثَّغْرِ عندي","لكم وُدٌّ يَروق فلا يُشاب",53,"ب",1,0],["أإخوانَنا والموتُ قد حال دونَنا","وللموتِ حكمٌ نافذٌ في الخلائقِ",54,"ق",1,1],["أأُخَيَّ إنَّ الدهرَ يَعجَبُ صَرفُه","من طول دأبكَ في البكاء ودابي",55,"ب",2,0],["أأخشاهُ جفناً ما تُسَلُّ قواضِبُهُ","وحدُّ حسامي ما تُفَلُّ مضاربهْ",56,"ب",2,1],["أَأَخافُ دَهري أَن يَروعَ صُروفُهُ","سِربي بِرائِعَةٍ وَرَبعُكَ لي حِما",57,"م",2,0],["أَأَخافُ رائِعَةَ الخُطو","بِ وَأَنتَ لِلغِمّاءِ كاشِف",58,"ف",1,0],["أَأُختيَ إِن أَمسيتِ رهنَ مقابرٍ","فَقَلبيَ قد أَمسى على حُزنه وَقفا",59,"ف",2,0],["أَأُخْتَ الدُّمى قَلباً خلا ونُعومةً","وَأُختَ الظِّبا طَرْفاً كَقلبيَ أَوْ نحرا",60,"ر",2,0],["أإخْوتَها الملوكُ بلا ادّعاءٍ","وأربابَ الكمالِ بلا انتِحال",61,"ل",1,0],["أَ أُخيَّ مارَسْتُ الرّجالَ فلم أَجِدْ","عند الشّدائدِ صاحِباً لم يَغْدِر",62,"ر",1,0],["أَأَخافُ أَن تَبقى هُمو","مي في هَواكَ وَما بَقيتُ",63,"ت",1,0],["أَإِخواني وَإِخواناً لِجَهري","أَعُدُّكُم وَأَيُّ أَخٍ لِسِرِّ",64,"ر",1,0],["أَأَخَيَّ ه