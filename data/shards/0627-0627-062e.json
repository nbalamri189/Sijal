اضل من","شهدت له الأقلام والصحف",137,"ف",1,0],["أ أخي فديتُكَ كيفَ سِرتَ مودِّعًا","ومضيتَ في عَجَلٍ وصِرتَ إليه؟",138,"ي",2,0],["أأخي بعد جمال وجهك لا يرى","قلبي بك الصبر الجميل جميلا",139,"ل",2,0],["أأخاف أو أرجوا سواك وليس في","الأكوان مخلوق يضر وينفع",140,"ع",1,0],["أَأُخْبِرُ سِرِّي يَا غَزَالُ وَ أُقْنِعُ","وَ أَنْتَ سَتُصْغِي، إِذْ يَئِنُّ مُرَوِّعُ",141,"ع",1,1],["أأخي الكريم ابن الكرا","م وصفوة الغرّ الصحاب",142,"ب",1,0],["أأخص داودا بذكرى","همة السمح الجواد",143,"د",1,0],["أَأُخَيَّ لا لأبٍ ولا أُمٍّ سِوَى","وِدٍّ لأيدينَا عَليهِ ضُمُومُ",144,"م",1,0],["أأخي هذا الدهر يأبي","أن يؤثر فيه سحرك",145,"ك",1,0],["أَأَخصَبُ مِنْ فِكرِي تُرِيدِينَ جَنَّةً ؟","وَ لَيسَ يُضَاهِينِي خَيَالٌ تَنَدَّرا !",146,"ر",2,0],["أَأَخْبَرْتَهَا عَنْ عَاشِقٍ بَاتَ لَيْلَةً","يُنَاجِيْ طُيُوْرًا غَرَّدَتْ بِالقِيَامِ",147,"م",1,0],["أَأُخَيَّ قد أزف الرحيلُ فهلْ","تبكي لفقدكَ أختَكَ الصُّغْرى",148,"ر",2,0]]}