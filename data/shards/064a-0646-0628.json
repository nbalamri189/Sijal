5718",""],[6090,"أشرق كالبدر بآفاق السما","https://www.poetsgate.com/ViewPoem.aspx?id=170918",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[6259,"قولا له هل دارَ في حوبائهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59352&r=&rc=0",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""],[4228,"في الموحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66131&r=&rc=2",""]],"verses":[["يُنبِضُ لي مِن لِسانِهِ أَبداً","نِصالَ ذَمٍّ تُمَزَّقُ الجُنَنا",0,"ن",2,0],["يَنباعُ مِن ذِفرى غَضوبٍ جَسرَةٍ","زَيّافَةٍ مِثلَ الفَنيقِ المُكدَمِ",1,"م",1,0],["يُنبي القُتودَ بِمِثلِ البُرجِ مُتَّصِلاً","مُؤَيَّداً قَد أَنافوا فَوقَهُ بابا",2,"ب",2,0],["ينبت زرعاً يرتجى حصده","حتى تفوز الناس بالأنعم",3,"م",1,0],["يُنَبِّتنَ أَعناباً وَنَخلاً مُبارَكاً","وَأَنقاءَ بُرٍّ في جُرونِ الحَصائِدِ",4,"د",1,0],["يَنُبنَ عَدُوّاً أَو رَواجِعَ مِنهُمُ","بَوانِيَ مَجداً أَو كَواسِبَ مَغنَما",5,"م",2,0],["ينْبوعِ معروف ورأي ناجعٍ","في مُعضل الأدواء أيَّ نُجوع",6,"ع",1,0],["ينبوعَ حزمٍ يُستقى","منه الصوابُ ويستملُّ",7,"ل",1,0],["يُنَبِّهنَ قَيظِيَّ الفِراخِ كَأَنَّما","يُنَبِّهنَ مَغموراً مِنَ النَومِ أَعجَما",8,"م",2,0],["يُنبوعُ مَعرِفَة وَهَيكَلُ حِكمَةٍ","وَوِعاءُ آداب وَكُنزُ رَشادِ",9,"د",1,0],["ينبيك مصرعه وكل زائل","أن الحياة كغدوة ورواح",10,"ح",1,0],["يُنْبِي ويصدعُ لي بحقٍّ أنّني","فردٌ كنجمِ الصبحِ قرنُ زماني",11,"ن",2,0],["يُنْبِيكَ نورُ جبينهِ عن جُودِه","كالصُّبْحِ دَلَّ على الغزالةِ مسفرا",12,"ر",2,0],["يُنبيكَ عَن حَلَقِيَّةٍ في شِعرِهِ","بِتَعَصُّبٍ لِلّامِ دونَ الكافِ",13,"ف",1,0],["يُنبيكَ عَن قُربِ النُبُوَّةِ هَديُهُ","وَالشَيءُ يُخبِرُ بَعضَهُ عَن كُلِّهِ",14,"ل",2,0],["يُنَبِّئُ بِالرِياحِ وَما أَتَتهُ","عَلى دَقَلِ السَفينَةِ كَالصَراري",15,"ر",2,0],["يُنبيكَ عن صِحَّةِ أخباري","عُسري من العِشقِ وإيساري",16,"ر",2,1],["يُنبيكَ عَن رَفعِ الكَلامِ وَخَفضِهِ","وَالنَصبِ مِنهُ بِحالِهِ وَالمَصدَرِ",17,"ر",1,0],["يَنبوعُها خَضِلٌ وَحَليُ قَريضِها","حَليُ الهَدِيِّ وَنَسجُها مَوضونُ",18,"ن",1,0],["يُنْبي على الودِّ الصدوقِ ويطلع ال","كلفَ المشوقَ على لطيفِ عتابِ",19,"ب",1,0],["يَنبَتُّ حَبلُ الأَصفِياءِ وَيَنطَوي","وَهُما بِحَبلِ اللَهِ مُعتَصِمانِ",20,"ن",1,0],["يَنبو عَلى طولِ العِتا","بِ فَقَد مَلَلتُ وَما أُعاتِب",21,"ب",1,0],["يُنبِئكِ ذو عِرضِهِم عَنّي وَعالَمُهُم","وَلَيسَ جاهِلُ شَيءٍ مِثلَ مَن عَلِما",22,"م",2,0],["يُنبَهُ مُغفي فَلاتِهِ بِقَطاً","بَينَ أَيادي رَواحِلٍ بُقُطِ",23,"ط",1,0],["يَنبُعُ مِن عَينَيكَ ماءٌ لَهُم","إِذا خَليطٌ يَمَّموا يَنبُعا",24,"ع",2,0],["يُنْبيكَ أنَّكَ لم تَجِدْ وَجْدِي","ما خَدَّتِ الْعَبراتُ مِنْ خَدِّي",25,"د",2,1],["يُنْبِي فَيَنْبُو في الكَلامِ لِسَانُهُ","فكأَنَّهُ مِن خَمْرِ عَيْنَيْهِ سُقِي",26,"ق",2,0],["يُنْبِيكَ ظاهِرُهُ بِوُدِّ ضَمِيرِهِ","وَالْوَجْهُ وَسْمَةُ مُخْلِصٍ وَمُرِيبِ",27,"ب",1,0],["يَنْبُو ذَرَا الْبَلَدِ الأَمِيْنِ بِمِثْلِهِ","وَالزَّاحِفَاتُ أَمِيْنَةُ الأَجْحَارِ",28,"ر",1,0],["يُنْبوعُ إِحْسَانٍ وَبِرٍّ جَرَى","أَصْفَى وَأَنْقَى مِنْ قِطَارِ النَّدَى",29,"د",2,0],["يَنْبِرُ النَّبْرَةَ العَزُوفَ فَمَا تُ","سْمَعُ إِلاَّ أَصْدَاؤُهَا فِي الوَادِي",30,"د",2,0],["يَنْبِضُ النَّابِضُ الَّذِي حَرَّكْتَهُ","فَتُؤَدِّي الْحُرُوفُ بِالتَّغْرِيدِ",31,"د",1,0],["يُنَبِّهُني إِذا فِكَري","أَنامُ الهَمُّ أَعيُنَها",32,"ن",3,0],["ينبس العشب ، بالسؤال كطفل","يتهجى قحط الرضاعة درسا",33,"س",2,0],["ينبي عن مولدها الآتي","شفق دام فجر أشقر",34,"ر",1,0],["يُنَبّىءُ بِالرّيَاحِ وَمَا أتَتْهُ،","عَلى دَقَلِ السّفينَةِ كالصَّرَارِي",35,"ر",2,0],["ينبهنا هذا المشيب وقد مضى","شباب لنا في غفلة الغي اشرخ",36,"خ",1,0],["ينبوع صفو النهار مزدحمٌ","رقراقه بالظلام كالجزر",37,"ر",1,0],["ينبيك بالأرض والدنيا وما حوتا","كأنما أنت في الدنيا سليمان",38,"ن",1,0],["ينبغي في كل شهر مرةً","إن يكن منك على قُرْب المَحَلْ",39,"ل",1,0],["ينبغِي أنْ تجدَّ في العملِ الصا","لحِ حقّاً لا خيرَ في التقصيرِ",40,"ر",1,0],["يُنْبيكَ ظاهرُ حالتى","عما تُكِنُّ ضمائرِى",41,"ر",2,0],["ينبَغِي لا تُبْدِى كلاماً ولا تَعْجَ","لْ عَلَى خِطَبةٍ من الأوليَاءِ",42,"ا",2,0],["يُنِبتُ في هامِ الربى ذوائبا","يُضحى لها خدُّ المَصيفِ حالقا",43,"ق",2,0],["يَنبُتنَ مثل الروض إلا أنّه","ترعاه أسماعٌ لنا وعقولُ",44,"ل",1,0],["ينبيك أني معه على شفا","ما في اعتراض لحظة لي من شفن",45,"ن",1,0],["يُنبِي عنِ الودّ الذي","لا يَسْتحيل ولا يُشاب",46,"ب",1,0],["ينبئني لحظكِ أنَّ الذي","سبّب هذا قلبكِ القاسي",47,"س",2,0],["ينبري لها رشأ","هزَّ عطفه الطربُ",48,"ب",1,0],["ينبيكَ ما في وجههِ عن قلبهِ","إن الكتابَ لسانهُ عنوانهُ",49,"ه",1,0],["يَنبضُ الغُصنُ في يَدَيكَ رَجاءً","وَيُنَدّي عَلَيهِما إيمانا",50,"ن",2,0],["يُنْبِتُ نوراً أرِجاً","جرجاره والينمَه",51,"م",2,0],["ينبئك سرا حف بالرمز من يهم","به يلق نصبا دونه وعذابا",52,"ب",2,0],["يُنْبِي الْفَتى قَبْلَ الْفِطامِ بِفَضْلِه","وَيَبِينُ عِتْقُ الْخَيْلِ وَهْيَ مِهارُ",53,"ر",1,0],["ينبيك عن هذا وذا","ذكر كما سار المثل",54,"ل",1,0],["ينبه أشواقي بألحانِ سجعه","فيا ثنى أعطافي بمثلِ المثالثِ",55,"ث",1,0],["يَنبو عنِ العوراءِ لَيس لهفوةٍ","مِنهُ مساغٌ في اللّحاظ ولا الفمِ",56,"م",1,0],["ينبوع شعري زاخر فاشربي","او شئت ان تزيني فالبسي",57,"س",2,0],["ينبيك كاذب وعده عن ختله","يا للعدو ووعده الكذاب",58,"ب",1,0],["يُنبيكَ قَولي إذا ما كنتَ سامعَه","وفعلُه أنَّنا جِئنا عَلى قدرِ",59,"ر",1,0],["يُنبي تَجاليدي وَأَقتادَها","ناوٍ كَرَأسِ الفَدَّنِ المُؤَيَّدِ",60,"د",1,0],["ينبيك عنه وَلَو تنكَّر بشره","مثل الفرند بصفح كل يَماني",61,"ن",2,0],["يُنبيك عَمّا في القُلوبِ كَأَنَّما","جُعِلَ المداد سواد كل جِنانِ",61,"ن",1,0],["يُنَبِّهونَ عَلى فَضلي إِذا كُتَبت","صَحيفَتي في المَعالي عنونت بِهِمِ",62,"م",1,0],["يُنبي تَبسُّمه عَن نَشرِهِ أَبَداً","وَالغَيث آيَة صَوبِ الوابِل الهَطلِ",63,"ل",1,0],["ينبيك عَن جود كفَّيه تبَسُّمه","وَالبَرق عادَته أَن يَقدُم المَطَرا",64,"ر",2,0],["ينبيك عَنه وَلَو تَنَكَّرَ بشره","إِنَّ البَشاشَةَ لِلكَريمِ شِعارُ",65,"ر",1,0],["يُنبي سَلامك