ر",2,"ر",1,0],["فَإِن لَم يَزَل قَلبي إِلَيكَ فَقَد هَفا","وَإِن لَم يَزِد دَمعي عَليكَ فَقَد جَرى",3,"ر",2,0],["فَإِن لا تَصِل تُصبِح عِداكَ كَثيرَةً","عَليكَ وَداءُ الطَعنِ إِن هِبتَهُ يُعدي",4,"د",2,0],["فَإِن لَم أَبكِهِ قُربى تَلاقَت","مَغارِسُها بَكَيتُ لَهُ وَدادا",5,"د",2,0],["فإِن لَم تردوهُ أَقَمتُ لديكمُ","صَريعَ غرامٍ ما أُمِرُّ وما أَحلو",6,"و",1,0],["فَإن لَم يُؤرِّقهُ وَعاوَدَهُ الكَرى","فَطَيفُكِ يا بنتَ الهِلاليِّ طارِقُهْ",7,"ق",2,0],["فإِن لُمتَ لَم يَنظِمْ نَجيبَينِ تَحتَنا","بِبَيداءَ طولَ اللَيلِ سِلكُ سَبيلِ",8,"ل",1,0],["فَإِن لَم تَملِكوا الأَمرَ الَّ","ذي أَرجو فَمَنوني",9,"ي",1,0],["فَإِن لَم يَدنوا حَتّى","تَرى رَأسَيهِما راسا",10,"س",2,0],["فَإِن لَم تَرَي عَينَيَّ أَهلاً لِنَظرَةٍ","إِلَيكِ وَلَم تَستَمسِكي بِعُرى الأَمرِ",11,"ر",1,0],["فَإِن لَم أَمُت غَمّاً وَهَمّاً وَحَسرَةً","فَلي حَسَراتٌ بَعدَهُ وَزَفيرُ",12,"ر",1,0],["فَإِن لُمتُ قَلبي قالَ عَيناكَ هاجَتا","عَلَيكَ الَّذي تَلقى وَلي تَجعَلُ الذَنبا",13,"ب",2,0],["فأنِلْ واحْمِلْ وأعِدْ وأبِدْ","وأنْعَمْ في ظلِّ حِمىً وبَقا",14,"ق",2,0],["فَإِنْ لَمْ يُسَاعِدْكَ الزَّمَانُ فَإِنَّمَا","وُجُودُكَ فِي الأَيَّامِ كَالْعَدَمِ المَحْضِ",15,"ض",1,0],["فإنْ لمْ يكُنْ وَصْلٌ فهَبْها إشارَةً","فَيا حُسْنَ شاراتِي بِها منْ إشاراتِ",16,"ت",1,0],["فَإِنَّ لسانَ المَرءِ ما لَم يَكُن لَهُ","فُؤادٌ بِما يَخفى عَلى الناسِ بائِحُ",17,"ح",1,0],["فَإِن لا يَكُنها أَو تَكُنهُ فَإِنَّهُ","أَخٌ أَرضَعَتهُ أُمُّها بِلِبانِها",18,"ن",3,0],["فَإِنَّ لَكُم قُربَهُ عِزَّةً","وَوَسَّطَكُم مُلكَهُ وَاِستَشارا",19,"ر",2,0],["فَإِن لَم تَكُن وَهماً فَكُن خَيرَ مُسعِدٍ","فَإِنّي وَحيدٌ وَالخُطوبُ كُثارُ",20,"ر",1,0],["فَإِن لَم تَبعَثَنَّ إِلَيَّ حالاً","بِمائِدَةٍ عَلى مَتنِ البُخارِ",21,"ر",1,0],["فَإِن لَم تَكُن بِالشَأمِ داري مُقيمَةً","فَإِنَّ بِأَجنادينَ مِنّي وَمَسكِنِ",22,"ن",1,0],["فَإِن لَم تَكونُوا مِن بَني النَضرِ فَاِترُكُوا","أَراكًا بِأَذنابِ الفَوائِجِ أَخضرا",23,"ر",2,0],["فَإِنَّ لَم يَرُدّوها عَلَينا نَدَع بِهِم","هِجاءً كَكَيِّ الناحِزِ المُتَلَوِّمِ",24,"م",1,0],["فَإِن لَم يَكُن إِلّا تَعَلُّلَ ساعَةٍ","قَليلاً فَإِنّي نافِعٌ لي قَليلُها",25,"ل",3,0],["فَإِن لَم تَكونِي غَيرَ شامٍ بِقَفرَةٍ","تَجُرُّ بِها صَيفِيَّةٌ كُدرُ",26,"ر",1,0],["فإن لم نَرِد فيها الكؤوس فإننا","وردنا بها للأنس مستعذبَ الوردِ",27,"د",1,0],["فإن لم يكن هذا صحيحاً فما الذي","ترون سوى هذا عليه المُعَوّلا",28,"ل",2,0],["فإنّ لأهليها عليك لذِمّةً","ومثلك من راعى الذمام ومّن وفّى",29,"ف",2,0],["فإن لم تقُم بعد الأناة عزائم","فَعْتبي عليكم والملام فُضول",30,"ل",1,0],["فإن له منك الحجا وهو جوهر","وللوالدين العظم واللحم والدم",31,"م",1,0],["فَإِنَّ لَنا عَمراً وَسَعداً عَلَيكُمُ","وَقَمقامَ زَيدٍ وَالصَريحَ المُهَذَّبا",32,"ب",2,0],["فَإِنَّ لِأَنصارِ الخَليفَةِ ناصِراً","عَزيزاً إِذا طاغٍ طَغى وَتَجَبَّرا",33,"ر",2,0],["فَإِنَّ لِآخِرِ الشُعَراءِ مِنّي","كَما لِلأَوَّلينَ مِنَ النَكالِ",34,"ل",1,0],["فَإِن لَم تَجِد مِن دونِ عَدنانَ باقِياً","وَدونَ مَعَدٍّ فَلتَزَعكَ العَواذِلُ",35,"ل",1,0],["فإن لإسماعيل حقاً وإننا","له شاعبوا الصدع المقارب للشعب",36,"ب",1,1],["فَإِنَّ لِلثَغرِ سوراً مِن مَهابَتِهِ","صُحورُهُ مِن أَعادي أَهلِهِ قِمَمُ",37,"م",1,0],["فَإِن لَم يَكُن وُدٌّ قَديمٌ نَعُدُّهُ","وَلا نَسَبٌ بَينَ الرِجالِ قُرابُ",38,"ب",1,0],["فَإِن لَم أُحَقِّق ظَنَّهُم بِتَيَقُّنٍ","فَلا سَقَتِ الأَوصالَ مِنّي الرَواعِدُ",39,"د",1,0],["فَإِن لا أَمُت أَذعَر هُذَيلاً بِغارَةٍ","كَغادي الجِهامِ المُغتَدي بِإِفاءِ",40,"ا",2,0],["فإن لفظي الفداة مثلي","أصبح والله فيه ضعف",41,"ف",1,0],["فَإِنَّ لِسانَ العِلمِ لِلنُطقِ وَالهُدى","وَإِنَّ لِسانَ الغَيبِ جَلَّ عَنِ النُطقِ",42,"ق",1,0],["فإن لم أكن فتشتُ حقاً غُلالتي","لأغسل عنها سَلْحَها فعميتُ",43,"ت",1,0],["فإن لا يكن حيّاً لدينا فإنه","لدى اللَه حيٌّ في الجنان مزوَّجُ",44,"ج",1,0],["فإنْ لا تكن كانت لعفوك وحده","فعفوُك لي فيها شريكٌ مشاطِر",45,"ر",1,0],["فإن لم ير الحسّادُ من ذاك ما أرى","فلا نظروا إلا بعُورٍ بخائص",46,"ص",1,0],["فإنْ لم تفعلوا وجفوْتمونا","على إثرائِكم فيمن جفاني",47,"ي",1,0],["فإنْ لهوا فدفاعُ الهمِّ حقّهُمُ","وإن بكوا فذوو الأشجان باكونا",48,"ن",2,0],["فإن لم يُكنْ لك صبرٌ عليَّ","فلا تُغلبنَّ على الصبر عنْ",49,"ن",1,0],["فَإِنَّ لُبنانَ لَيسَ طَوداً","وَلا بِلاداً لَكِن سَماء",50,"ا",2,0],["فَإِن لَم يَكُن مَهدٌ طِلَيكِ يَضُمُني","فَيا حَبَّذا يا هِندُ لَو ضَمَّنا لَحدُ",51,"د",1,0],["فَإِن لَم يَكُن مِن نَظرَةٍ تَرأَبُ الحَشا","فَرُدّي عَلَيهِ قَلبُه وَبِهِ زُهدُ",52,"د",1,0],["فانٍ لَهُ في كُلِّ فانٍ هَوى","فانٍ وَلا يَنجو مِنَ الذامِ",53,"م",1,0],["فَإِن لَم تَكونوا قَومَ لوطٍ بِعَينِهِم","فَما قَومُ لوطٍ مِنكُمُ بِبَعيدِ",54,"د",1,0],["فَإِن لا تَزُرني حَتَفتي أَو تُلاقِني","أَمَشّي بِدَهوٍ أَو عِدافٍ بَنَوُّرا",55,"ر",2,0],["فَإِنَّ لَنا جاراً عَلِقنا حِبالَهُ","كَغَيثِ الحَيا لا يَجتَويهِ المُجاوِرُ",56,"ر",1,0],["فَإِن لَم تَهِجني ذاتَ يَومٍ فَإِنَّهُ","سَيَكفيكَ وَرقاءُ السَراةِ صَدوحُ",57,"ح",1,0],["فَإِن لَم يَكُن قَولي رِضاكِ فَعَلِّمي","هُبوبَ الصِبا يا بَثنَ كَيفَ أَقولُ",58,"ل",1,0],["فإن لم يأتنا نوح بفلك","على الإسلام والشرق السلام",59,"م",1,0],["فإن لم نرض أخلاقا فعذرا","لعل ضلالنا هذا قديم",60,"م",1,0],["فَإِن لَم يَلِق شِعري لِبابِكَ مِدحَةً","فَمُر يَنفَتِح بابٌ مِنَ العُذرِ أَرحَبُ",61,"ب",1,0],["فإنْ لَمْ تَكُنْ بالطّبْعِ نَفْسِي كَرِيمَةً","وإِنْ كَرُمَ الآباءُ لَمْ أَرَهُ فَضْلا",62,"ل",2,0],["فَإِن لَم يَكُن إِلّا أَبو المِسكِ أَو هُمُ","فَإِنَّكَ أَحلى في فُؤادي وَأَعذَبُ",63,"ب",1,0],["فَإِنَّ لَهُ بِبَطنِ الأَرضِ شَخصاً","جَديداً ذِكرُناهُ وَهُوَ بالي",64,"ل",2,0],["فَإِنَّ لَهُم في سُرعَةِ المَوتِ راحَةً","وَإِنَّ لَهُم في العَيشِ حَزَّ الغَلاصِمِ",65,"م",1,0],["فَإِنَّ لِثالِثِ الحالَينِ مَعنىً","سِوى مَعنى اِنتِباهِكَ وَالمَنامِ",66,"م",1,0],["فإن لانت الأرض الكريمة أخرجت","لكم زهراً يرضي القلوب تلوّنا",67,"ن",2,0],["فَإِن لا تَشِفَّ العَينُ لِلعَينِ أَكثَبَت","مَسامِعُ مَدعوٍّ لِداعٍ يُجاوِبُه",68,"ب",2,0],["فَإِن لَم تَقِف مِن أَجلِ نَفسِكَ ساعَةً","فَقِفها عَلى تِلكَ المَعالِمِ مِن أَجلي",69,"ل",2,0],["فَإِنَّ لَنا عَنكُم مَراحاً وَمَذهَباً","بِعيسٍ إِلى ريحِ الفَلاةِ صَوادي",70,"ي",1,0],["فَإِن لا تَكُن هِندٌ بَكَتهُ فَقَد بَكَت","عَلَيهِ الثُرَيّا في كَواكِبِها الزُهرِ",71,"ر",1,0],["فَإِنَّ لَنا مَجدَ الحَياةِ وَأَنتُمُ","تَسوقونَ عَوداً لِلرُكوبِ مُوَقَّعا",72,"ع",2,0],["فَإِنَّ لِعَبدِ اللَهِ وَاِبنَيهِ مادِحاً","كَريماً فَما يُثني عَلَيهِم يُصَدَّقِ",73,"ق",1,0],["فَإِنَّ لَهُم مِنهُ وَفاءَ رَهينَةٍ","بِأَخلاقِهِ الجُلّى تَفيضُ جَداوِلُه",74,"ل",2,0],["فَإِنَّ لَهُ كَفَّينِ في راحَتَيهِما","رَبيعُ اليَتامى وَالمَساكينِ وابِلُه",75,"ل",2,1],["فإن لم أطل مدحي فيا رب نائل","أحل قصير السهم أخفى المقاتل",76,"ل",1,0],["فإنْ لا أرَ الإلفَ الذي كان آلِفاً","هوايَ ولا الشَّملَ الذي كان شامِلا",77,"ل",2,0],["فَإِنَّ لَكُم مَآقِطَ عاسِياتٍ","كَيَومَ أَضَرَّ بِالرُؤَساءِ إِيرُ",78,"ر",1,0],["فَإِنَّ لُيَيلاتِ الشِتاءِ أَنيسَةٌ","إِذا نُمتُما قَد فازَ فيها سِواكُما",79,"م",2,0],["فَإِن لَم تَزُرنا وَالخِيامُ قَريبَةٌ","وَلا سِترَ إِلّا الأَتحَمِيَّ المُرَعبَلُ",80,"ل",1,0],["فَإِن لاحَظَتهُ عُيونُ الرِضى","لَكَ الفَضلُ في ذاكَ وَالفَخرُ لي",81,"ل",2,0],["فَإِنَّ لَهُ غايَةً في الذَكاءِ","وَلُطفَ البَديهَةِ وَالمِقوَلِ",81,"ل",1,0],["فَإِن لَم تَطيبا لي جَميعاً فَإِنَّهُ","نَهى عُمَرٌ عَن أَكلِ أُدمَينِ في أَدمِ",82,"م",1,0],["فَإِن لَم يَفهَمِ الشِعرَ","سَريعاً فَهِمَ الصَفعا",83,"ع",2,0],["فَإِنْ لَمْ تَجِدْ فِي الْمُدْنِ مَا شِئْتَ مِنْ قِرَىً","فَأَصْحِرْ فَإِنَّ الْبِيدَ خَيْرٌ مِنَ الْمُدْنِ",84,"ن",1,0],["فَإِنْ لَمْ أُصَرِّحْ بِاسْمِهِ خَوْفَ حَاسِدٍ","يَنُمُّ عَلَيْهِ فَهْوَ يَعْلَمُ مَنْ أَعْنِي",84,"ن",2,0],["فَإِنَّ لَهِيبَ النَّارِ مَهْمَا كَفَأْتَهُ","إِلَى أَسْفَلٍ قَسْراً فَلا بُدَّ أَنْ يَعْلُو",85,"و",1,0],["فإنْ لبسَ السوادَ فَبَدْرُ تَمٍّ","وإنْ لبسَ البياضَ فشمسُ أفقِ",86,"ق",1,0],["فَإِن لَم يَكُنها أَو تَكُنهُ فَإِنَّهُ","أَخوها كَما قُدَّ الشِراكُ مِن الجِلدِ",87,"د",1,0],["فَإِنَّ لِإِبراهِمَ فَيأَةَ رَأفَةٍ","تَعودُ بِعَطفِ الحِلمِ وَالعَودُ أَحمَدُ",88,"د",1,0],["فَإِنَّ لَهيبَ النارِ بَينَ جَوانِحي","إِذا ذُكِرَت لَيلى أَحَرُّ مِنَ الجَمرِ",89,"ر",1,0],["فَإِن لَم أَمُت غَمّاً وَهَمّاً وَكُربَةً","يُعاوِدُني بَعدَ الزَفيرِ زَفيرُ",90,"ر",1,0],["فإنّ لكم لَعُقبى الخيرِ فيهم","وإنّ لهم لعُقبى الزّائغينا",91,"ن",2,0],["فَإِن لَم يُجِبني سُلُوّي صَبَرتُ","بِرَغمي فَرُبَّ وَفاةٍ مُريحَه",92,"ح",2,0],["فَإِن لا تَمُت حَتّى تَحُكَّ عَصاعِصاً","نَدِن مِثلَها في عُقرِ دارِ تَميمِ",93,"م",1,0],["فَإِن لَم تَلِج بابَها مُسرِعاً","أَتاكَ عَدُوُّكَ مِن بابِها",94,"ب",3,0],["فإنَّ لِي ذِمَّةً منهُ بِتَسْمِيَتي","مُحمداً وَهْوَ أَوْفَى الخَلْقِ بالذِّمَمِ",95,"م",1,0],["فإنْ لم أُشاهِدْ يومَها مِلْءَ ناظري","أُشاهِدْهُ ملءَ السمْع ملء الحيازم",96,"م",1,0],["فإنْ لم تكنْ إلاّ الغوايةُ وحدها","فإنّ غِرارَ المَشرفيّ رَشيد",97,"د",1,0],["فَإِن لَم تُجيبينا تَبَدَّدَ شَملُنا","وَإِن تَجمَعينا بِالوِدادِ تَواصَلنا",98,"ن",2,0],["فإنّ له نساءٌ سارقاتٍ","إذا آمَنَّ أطرافَ الرماحِ",99,"ح",1,0],["فإنّ لي ماجِناً غويّاً","أغبرُ من حلّ بالعراقِ",100,"ق",1,0],["فَإِن لَم تَسعَدي فَعِدي وَمُنّي","خَلاعاً لا أَموتُ عَلى بَيانِ",101,"ن",1,0],["فَإِنَّ لِهَذِهِ الدُنِّيا طَريقاً","عَلَيهِ يَمُرُّ مَن قَبلي وَبَعدي",102,"د",2,0],["فَإِن لَم تَنَل وَفراً مِنَ المالِ فَاِستَعِن","وَفارَةَ عَقلٍ فَهيَ أَزكى مِنَ الوَفرِ",103,"ر",1,0],["فَإِنَّ لُيوثَ الحَتفِ نالَ اِفتِراسُها","ضَراغِمَ مِن لَيثٍ وَحيِّ فِراسِ",104,"س",1,0],["فَإِن لَم يَعُد فَاِبعَث لَهُ سَهمَ طارِقٍ","لِتُؤجِرَ أَو تُدعى البَريءَ مِنَ البُخلِ",105,"ل",1,0],["فَإِن لَم تَكُن إِلّا الحَياةُ وَبَينُها","فَلَستُ عَلى أَيّامِها أَتَنَدَّمُ",106,"م",1,0],["فَإِن لا يَكُن وَسنانَ حَظّي وَحَظِّها","فَإِنَّ عَلَيهِ فَترَةَ المُتَواسِنِ",107,"ن",1,0],["فَإِن لَم يَكُن مِنهُمُ زاجِرٌ","وَلَم تُرعَ رِحمٌ وَلَم تُرقَبِ",108,"ب",1,0],["فَإِنَّ لَدى المَوتِ مَندُوحةً","وَإِنَّ العِقابَ عَلى المُذنِبِ",108,"ب",1,0],["فإنَّ لضوئهِ قلباً","وإنَّ لسحره جَفْنا",109,"ن",2,0],["فَإِن لَم تَكُن تَقطَع قُوى الوُدّ بَينَنا","وَلَم تَنسَ ما أَسلَفتُ في سالِفِ الدَهرِ",110,"ر",1,0],["فإنْ لَقِيتُ وَليداً والنّوى قَذَفٌ","يَوْمَ القِيامَةِ لم أُعْدِمْهُ تبْكِيتا",111,"ت",2,0],["فأَن لَم تَندَمُوا فَثَكِلتُ عَمراً","وهاجَرتُ الُمؤرِّقَ والسَّماعا",112,"ع",2,0],["فَإِنَّ لِلدَّهْرِ لَوْ فَطَنْتَ لَهُ","قَوْسَاً مِنَ الْمَوْتِ سَهْمُهَا غَرَبُ",113,"ب",1,0],["فَإِنَّ لِي مِنْ عَزْمَتِي صَاحِبَاً","يَمْنَعُنِي فِي الرَّوْعِ أَنْ أَدْحَضَا",114,"ض",2,0],["فَإِنْ لَمْ أَقُلْ حَقَّاً كَذَبْتُ عَلَى الْهَوَى","وَإِنْ قُلْتُ إِنِّي عَاشِقٌ بُحْتُ بِالسِّرِّ",115,"ر",1,0],["فَإِنْ لانَ فَاشْكُرْهُ عَلَى فَضْل مَا أَتَى","مِنَ الْبِرِّ واعْذِرْهُ إِذَا صَدَّ أَوْ أَبَى",116,"ب",2,0],["فإِنَّ لِي دُونَهُنَّ فَاتِنَةً","فِي الزُّهْرِ مَحْسُودَةً وَفِي الزَّهَرِ",117,"ر",1,0],["فَإِنَّ لَهُ حَدِيثاً لَيْسَ يُبَلَى","تُحَدِّثُهُ مَآثِرُ لاَ تَفُوتُ",118,"ت",1,0],["فَإِنْ لَمْ يُعْنِ أَهْلُ الحِطَامِ أَدِيبَهُمْ","فَهَلْ ذَنْبُهُ أَنْ كَانَ غَيْرَ مُوَفَّقِ",119,"ق",1,0],["فَإِن لَم تَزوري في حَياتي فَلَيتَني","إِذا ما سَكَنتُ القَبرَ لي مِنكِ زائِرُ",120,"ر",1,0],["فَإِن لحت قالوا يا عُلاهُ سَلى لَنا","أَلِلقَمَرَينِ النَيِّرَينِ سَليلُ",121,"ل",1,0],["فَإِن لَم تَكُن إِلّا بِقُربى مُحَمَّدٍ","فَهاشِمُ أَولى مِن هَنٍ وَهَناتِ",122,"ت",1,0],["فَإِن لَم تُهدِ لي نَعلاً فَكُنها","إِذا أَعجَمتَ بَعدَ النونِ حَرفا",123,"ف",2,0],["فإنَّ للشرقِ أعْدَاءً ذوِي إحَنٍ","اللّهُ يكفيهِ نجواهُمْ ويكفينَا",124,"ن",2,0],["فإن لها بالعراق فصولاً","وإن لها في الحجاز حدودا",125,"د",2,0],["فإِن لم يُرضِك التكريمُ، فاكفُفْ","-فديتُك- عن مواصلة الجُهُود",126,"د",1,0],["فإن لم يكُنْ وصْلٌ فهَبْها إشارة ً","فيا حُسْنَ شاراتي بها من إشاراتي",127,"ت",2,0],["فان لا تبذَّ المفلقينَ فانّها","يقصِّرُ عنها شاعرٌ غير مُفلِق",128,"ق",1,0],["فانْ لم يكن إلاَّ نهارٌ وليلةٌ","فما أجدرَ الإنسان أنْ يتمتَّعا",129,"ع",2,0],["فان لم أُطِقْ تهديمَ بيتٍ مصارحاً","أتيتُ فهدَّمتُ البيوتَ مواربا",130,"ب",2,0],["فان لم تكن هذي لجأتُ لغيرها","أخفَ أذىً منها وألين جانبا",130,"ب",2,0],["فانْ لم يقولوا إنَّه مُتعنِّتٌ","عَنُودٌ يقولوا مُصْحِبٌ متساهل",131,"ل",1,0],["فإِنْ لم تُهدِ لي نَعْلاً فَكُنْها","إذا أعجمتَ بعدَ النونِ حرف",132,"ف",1,0],["فإنْ لمْ تَشِفّ العَينُ للعَينِ أكْثَبَتْ","مَسَامِعَ مَدْعُوٍّ لداعٍ يُجاوِبُهْ",133,"ب",2,0],["فإن لم يكن مهد إليك يضمّني","فيا حبّذا ، يا هند ، لو ضمّنا لحد",134,"د",1,0],["فإنّ لِعَبْدِ الله وابْنَيْهِ مَادِحاً","كَريماً فَما يُثْنِ عَلَيْهِمْ يُصَدَّقِ",135,"ق",1,0],["فإنّ لكُمْ مَآقِطَ غاشِياتٍ","كيَوْمِ أُضِرّ بالرّؤساءِ إيرُ",136,"ر",1,0],["فإن لم يُكنْ لك صبُرٌ عليْ","يَ فلا تُغلبنَّ على الصبر عنْي",137,"ي",1,0],["فإن لا يَكن حياً لدينا فإنه","لدى اللَّه حيٌّ في الجنان مُزَلَّجُ",138,"ج",1,0],["فإن لم أزرها عادني الشوق والهوى","وعاود قلبي من بثينة داؤها",139,"ا",3,0],["فَإِن لَم تَندَموا فَثَكَلتُ عَمراً","وَهاجَرتُ المُرَوَّقَ وَالسَماعا",140,"ع",2,1],["فإن لبيروت حقوقاً جليلة","على َّ فنب يا شعر عنيَ في الشكر",141,"ر",1,0],["فإن للبشر الراقي بخلقته","من قد انفت به أني من البشر",142,"ر",1,0],["فإن لم تنقذوا الأوطان منهم","فلستم يا بنين لنا بنينا",143,"ا",1,0]]}