{"poems":[[65,"بشراك قد ظفر الراعي بما ارتادا","https://www.aldiwan.net/poem46210.html","البسيط"],[23,"فلما هبطنا بطن مر تخزعت","https://www.aldiwan.net/poem21583.html","الطويل"],[40,"يا عجبا للدهر شتى طرائقه","https://www.aldiwan.net/poem7734.html","الطويل"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[33,"أشارت إلينا بالبنان تحية","https://www.aldiwan.net/poem41307.html","الطويل"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[42,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[50,"ألم تربع على الطلل الطماس","https://www.aldiwan.net/poem64337.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54848","الطويل"],[33,"أَفي رَسْمِ دَارِ دَارِسٍ أَنْتَ وَاقِفُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18959&r=&rc=222",""],[138,"ألم ترني من بعد هم هممته","https://www.aldiwan.net/poem21037.html","الطويل"],[240,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[267,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[370,"فلما هبطنا بطن رنينة بالقنا","https://www.aldiwan.net/poem44537.html","الطويل"],[466,"لئن خالت نوى قذف شطون","https://www.aldiwan.net/poem15109.html","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96636","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67367","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106710","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/15","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138556",""],[4727,"نسيبٌ وهجاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=211408",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["فَلمْ أُهِبْ بالقَوافي بعدَ بينِكُمُ","ولا حَمِدْتُ وقَدْ جَرَّبْتُ أجْوادا",0,"د",2,0],["فَلَمّا هَبَطنا بَطنَ مَرٍّ تَخَزَّعَت","خُزاعَةُ عَنّا بِالجُموعِ الكَراكِرِ",1,"ر",1,1],["فَلَمّا هَبَطنَ المِشفَرَ العَودَ عَرَّسَت","بِحَيثُ اِلتَقَت أَجزاعُهُ وَمَشارِقُه",2,"ق",2,0],["فَلَمّا هَبَّ جورجِيَهُم هُبوباً","تَلَفَّتَ لا يُصيبُ لَهُ مَعينا",3,"ا",1,0],["فَلَمّا هَبَطنا مِن غِفارٍ وَغَيَّبَت","ذُرى الأَرضِ عَنّا طَخيَةٌ وَدُخانُ",4,"ن",1,0],["فَلَمّا هَمَمنا بِالتَفَرُّقِ أَعجَلَت","بَقايا اللُباناتِ الدُموعُ الذَوارِفُ",5,"ف",1,0],["فَلَمّا هَداهُنَّ الجَرِيُّ لِمجلِسٍ","وَهَنَّ بِهِ لَولا التَجاهُلُ أَبصَرُ",6,"ر",1,0],["فَلَم أَهجُركَ هَجرَ قِلىً وَلَكِن","نَوائِبُ لا نَزالُ لَها نُقاسي",7,"س",2,0],["فَلَمَّا هَدَتْكَ الفِطْرَةُ السَّمْحَةُ الَّتِي","رَأَتْ أَنَّ أَسْراً كَيْفَ كَانَ هُوَ الأَسْرُ",8,"ر",1,0],["فلما هممنا بالتفرقِ، أعجلتْ","بَقَايَا الُّبانَاتِ الدُّمُوعُ الذَّوارِفُ",9,"ف",1,0],["فَلَمّا هَبَطنا أَرضَ بُصرى تَشَوَّفوا","لَنا فَوقَ دورٍ يَنظُرونَ عِظامِ",10,"م",1,0],["فَلَمّا هَتَكنا قِناعَ الوَقارِ","وَمُدَّ عَلَينا مِنَ اللَيل سِترُ",11,"ر",1,0],["فَلَمَّا هَدَّنِي ونَفَى رُقَادِي","وطَالَ لِذَاكَ هَمِّي واشتِغالي",12,"ل",2,0],["فلّما هبطنا بطنَ رَنينَةَ بالقَنا","أَرَنَّ سحابٌ رَعدُهُ مُتجاوبُ",13,"ب",1,1],["فلم أهجرك مَلَلاً ولكن","هو الرحمنُ يفعلُ ما يشاءُ",14,"ا",2,0],["فَلمّا هزّها قَضت في قَضائِها","بِمنحِ ذمارٍ أو برزق عبادِ",15,"د",1,0],["فَلَمْ أهْجُكُمْ إلاَّ لأنَّي حَسِبْتُكُمْ","كَرَهْطِ ابنِ بَدْرِ أو كَرَهْطِ ابنِ مَعْبَدِ",16,"د",1,1],["فلما هَمَت تِلك السَّحَائِب فَوقَهَا","أفَاقَت وهَبَّت من كَرَى هَيمَانِهَا",17,"ن",3,0],["فَلَمّا هَبَطنَ السَهلَ وَاِحتَلنَ حيلَةً","وَمِن حيلَةِ الإِنسانِ ما يَتَخَوَّفُ",18,"ف",1,0],["فَلَمّا هَبَطنَ مَصابَ الرَبيعِ","بُدِّلنَ بَعدَ الرِحالِ الحِجالا",19,"ل",2,0],["فلما هوى مستسلماً أمن العد","متى كان مثل الشمر يطمع في الفتك",20,"ك",1,0],["فلَمَّا هَمَّ لوْ هَمَّتْ يَدَاهَا","إلى عُنُقِي انْهَمَمْنا في العِنَاقِ",21,"ق",1,0],["فلم أهبِ الحياة َولم تهبْني","وما أنا بالمُهابِ ولا المهيب",22,"ب",1,0]]}