{"poems":[[55,"أتطمع يا عباس في غير مطمع","https://www.aldiwan.net/poem26259.html","الطويل"],[55,"لعمري ما حبسي كتابي عنكم","https://www.aldiwan.net/poem26431.html","الطويل"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[93,"أدعو القريض فيعصي بعد طاعته","https://www.aldiwan.net/poem11272.html","البسيط"],[88,"ألا من مبلغ عني زنيما","https://www.aldiwan.net/poem44393.html","الوافر"],[51,"وزائرة الخيال بلا اشتياق","https://www.aldiwan.net/poem65710.html","الوافر"],[85,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[97,"سألتك يا صخرة الملتقى","https://www.aldiwan.net/poem24403.html","المتقارب"],[33,"لقد طرقتني أم خشف وإنها","https://www.aldiwan.net/poem25860.html","الطويل"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[128,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[150,"يا حاسد النعمة في غيره","https://www.aldiwan.net/poem68516.html","السريع"],[160,"يساري في يمينك لا تزال","https://www.aldiwan.net/poem58723.html","الخفيف"],[160,"أعد الذي عاينت من ليلتي فجر","https://www.aldiwan.net/poem58762.html","الطويل"],[160,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[177,"لعمري إني يوم بصرى وناقتي","https://www.aldiwan.net/poem4500.html","الطويل"],[178,"عين سين","https://www.aldiwan.net/poem50696.html","الوافر"],[186,"أصون دراهمي وأذب عنها","https://www.aldiwan.net/poem43715.html","الوافر"],[198,"هو البين لا تعصي الدموع له أمرا","https://www.aldiwan.net/poem51842.html","الطويل"],[199,"زمان عيشنا فيه اضطرار","https://www.aldiwan.net/poem45408.html","الوافر"],[199,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[210,"هناء به شمل المعاني تنظما","https://www.aldiwan.net/poem13324.html","الطويل"],[231,"نعم إن للبرق اليماني لوعة","https://www.aldiwan.net/poem44585.html","الطويل"],[235,"سحاب الجود هامي الودق ساكب","https://www.aldiwan.net/poem32185.html","الوافر"],[250,"فضائل خير المرسلين عظيمة","https://www.aldiwan.net/poem15073.html","الطويل"],[259,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[271,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[353,"خذي من ودادي العين يا قرة العين","https://www.aldiwan.net/poem39773.html","الطويل"],[402,"وأغيد وسنان اللحاظ قوامه","https://www.aldiwan.net/poem46743.html","الطويل"],[402,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[439,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[453,"وسائلة هل تقرض الشعر فطر","https://www.aldiwan.net/poem61792.html","الطويل"],[464,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[464,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[464,"وحنين ولكن أين منك زرود","https://www.aldiwan.net/poem3625.html","عموديه"],[500,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[513,"يعيرني الواشي بأن لست مدنفا","https://www.aldiwan.net/poem67722.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فيا كُلَّ هَمّي أَقطِعيني قَطيعَةً","مِنَ الوَصلِ تَبقى لي وَلَو قَدرَ إِصبَعِ",0,"ع",1,0],["فَيا كَبِدي طالَت إِلَيكُم رَسائِلي","وَهَذا رَسولي أَعجَمٌ لَيسَ يُفصِحُ",1,"ح",1,0],["فَيَا كِرَاماً أَقَرَّتْنِي حَفضاوَتُهُمْ","بِحَيْثُ يَحْسُدُنِي أَرْبَاب تِيجَانِ",2,"ن",1,0],["فَيا كِرَاماً تَوَلَّيْتُمْ إِعَانَتَهُ","دُمْتُمْ لِكُلِّ عَظِيمٍ خَيْرَ أَعْوَنِ",3,"ن",1,0],["فيا كلب الزنى ما شئت فانبح","فليس كريه نَبحك بالمضر",4,"ر",1,0],["فيا كذب اللقاء وقد تلاقى","خيالانا ويا صدق الفراق",5,"ق",1,0],["فيا كتبي أياديك الأيادي","ويا رسلي جميلكم الجميل",6,"ل",1,0],["في أَكبَرِ الحَجِّ حافٍ غَيرَ مُنتَعِلٍ","مِن حالِفٍ مُحرِمٍ بِالحَجِّ مَصبورِ",7,"ر",1,0],["فيا كعبةً شهدت هائمَين","أفاءا إلى حسنها المنتقَى",8,"ق",2,0],["فَيا كَبِداً أَخشى عَلَيها وَإِنَّها","مَخافَةَ هَضباتِ اللِوى لَخَفوقُ",9,"ق",1,0],["فَيا كَبِدا مِنَ الطَرَبِ المُعَنّى","إِلَيها إِنَّ أَهوَنَهُ شَديدُ",10,"د",1,0],["فَيا كَبِداً فيها مِنَ الشَوقِ قَرحَةٌ","وَلَيسَ لَها مِمّا تُحِبُّ شِفاءُ",11,"ا",2,0],["في اكتسابِ المالِ من كل مَرَام","وانهمكْنا في خبالِ واجترامِ",12,"م",1,0],["في أكله الطَّيب في شربه","في لبسه النعم في مركبه",13,"ب",2,0],["فيا كهفَ الوزارةِ إِن كهفي","إذا ما استأصل الأمن الوبالُ",14,"ل",1,0],["فيا كبدي إن كنت مني تقطعي","ويا أعيني لم لَم يكن ذلكَ البحرُ",15,"ر",1,0],["فيا كبدي من الهجران ذوبي","ويا جفني بالدمع استهلا",16,"ل",2,0],["فيا كَبِدَيْنا من مَخافَةِ لوعةِ","الفِراقِ ومن صَرْفِ النّوى تَجْفان",17,"ن",1,0],["فيا كمْ اسقطتني في الخطايا","رياحٌ ارهقت مجْرى سفيني",18,"ن",2,0],["فيأكلها ويشربُها هنيّا","على النغمات من زير وجسّ",19,"س",1,0],["فَيا كَبِدِي زِيدي ضَنىً وَصَبابَةً","وَيا جَلَدِي لَن تَستَطيع مَعي صَبرا",20,"ر",2,0],["فيا كوخَ الفقيرِ غدوتَ دنيا","وكلُّ الأرضِ للفقراءِ دارُ",21,"ر",1,0],["فيا كوخَ الفقيرِ إذاً سلاماً","فأنتَ لبهجةِ الدنيا وقارُ",21,"ر",1,0],["فيا كوكبَ الصبحِ إما بزغتْ","تألق تاجاً على الأرؤسِ",22,"س",1,0],["فيا كعبة الجدوى ويا حرم الرجا","حنانيك اني جئت نحوك محرما",23,"م",2,0],["فيا كاسر العدوى وجابر من سطت","به غير الأيام فهو وهيض",24,"ض",1,0],["فَيا كَهفَ الأَرامِلِ وَاليَتامى","وَيا بَحرَ العَطايا وَالرَغائِب",25,"ب",1,0],["فيا كبدي ذوبي اشتياقاً لقبره","ويا دمع عيني لا أعتراكَ توقُّفُ",26,"ف",1,0],["فيا كبدي ذوبي أساً حيث أسهم ال","تنائي إذا جاءت أصابت ولم تُخط",27,"ط",1,0],["فَيا كنز العديم أقل عثارى","فاني عبدك الفلس العَديم",28,"م",1,0],["فيا كعبة الحسن البديع الذي غدا","بها كل صب وإله القلب حائر",29,"ر",1,0],["فيا كعبة فضل التي هِيَ قبلَةٌ","لَها اِنتَجَع القصّاد مُنتجع العينِ",30,"ن",1,0],["فيا كبدي في الوصل منه تقطّعي","غراماً ويا نفسي اذْهبي بسلام",31,"م",1,0],["في اكْتِساب الفخر سَعْيكُمُ","فما لِغَيرِ إمامِ الحَقّ مُفتخَرُ",32,"ر",1,0],["فيا كُثْرَ ما قد نَوَّلَتْنا يد المنى","وعادَتُها الإمساك بالنائل النزر",33,"ر",1,0],["في أَكْرَمِ الذِّكْرِ فِي الدنيا وأَخْلَدِهِ","وأَسْعَدِ الجَدِّ فِي الدُّنيا وأَصْعدِهِ",34,"د",2,0],["فيا كافرا بالنبل في الكون ساخرا","من الحق ليس الكفر مجداً لفنان",35,"ن",1,0],["فيا كاشفَ الجلَّى ويا محييَ الهدى","ويا قاتل البلوى ويا كاشفَ الغمَّا",36,"م",2,0],["فيا كم جزعنا وادياً كان مترعاً","بجودك أو ثوباً من الأرض معلما",37,"م",2,0],["فيا كبدي الحرّي غداةَ زعمتما","بأن التنائي في غدٍ سيكون",38,"ن",1,0],["فيا كبدي أين الهدوُّ من الجوى","ويا جفنَ عيني أين منكِ هجود",39,"د",1,0],["فَيا كَبِدي ما ذُبْتِ والجَمْرُ لاهِبٌ","ويا مُهْجَتي لِمْ أنتِ لم تَقَطَّعي",40,"ي",1,0],["فيا كاشحاً قد جاء في زي ناصحٍ","تشاغل بغيري لست ممن يعرف",41,"ف",1,0],["في أكمل النعمة والسلامة","وأعظم الغبطة والكرامة",42,"ه",1,0]]}