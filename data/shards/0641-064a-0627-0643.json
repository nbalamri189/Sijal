/diwan/poem/91182","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91094","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91395","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85125","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138059","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29323","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32467","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101371","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119681","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127244","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105515","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136571",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83538","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124623","الطويل"],[4755,"اللغز","https://www.poetsgate.com/ViewPoem.aspx?id=199961",""],[4852,"فارسة","https://www.poetsgate.com/ViewPoem.aspx?id=215477",""],[4980,"أمُوتُ هوًى","https://www.poetsgate.com/ViewPoem.aspx?id=190594",""],[3271,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=128730",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[585,"يا وامض البرق بالأنباء تبتدر","https://www.poetsgate.com/ViewPoem.aspx?id=161890",""],[5072,"لنا غدنا في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=53579",""],[5190,"حتى حين","https://www.poetsgate.com/ViewPoem.aspx?id=153350",""],[5285,"لكِ الله يهدي سواء السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=204396",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5497,"معسولة اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=208977",""],[5509,"محاولات لاصطياد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=93490",""],[5609,"ربيع العمر","https://www.poetsgate.com/ViewPoem.aspx?id=214105",""],[5776,"الشّاعِرُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206108",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""]],"verses":[["فيا كُلَّ هَمّي أَقطِعيني قَطيعَةً","مِنَ الوَصلِ تَبقى لي وَلَو قَدرَ إِصبَعِ",0,"ع",1,0],["فَيا كَبِدي طالَت إِلَيكُم رَسائِلي","وَهَذا رَسولي أَعجَمٌ لَيسَ يُفصِحُ",1,"ح",1,0],["فَيَا كِرَاماً أَقَرَّتْنِي حَفضاوَتُهُمْ","بِحَيْثُ يَحْسُدُنِي أَرْبَاب تِيجَانِ",2,"ن",1,0],["فَيا كِرَاماً تَوَلَّيْتُمْ إِعَانَتَهُ","دُمْتُمْ لِكُلِّ عَظِيمٍ خَيْرَ أَعْوَنِ",3,"ن",1,0],["فيا كلب الزنى ما شئت فانبح","فليس كريه نَبحك بالمضر",4,"ر",1,0],["فيا كذب اللقاء وقد تلاقى","خيالانا ويا صدق الفراق",5,"ق",1,0],["فيا كتبي أياديك الأيادي","ويا رسلي جميلكم الجميل",6,"ل",1,0],["في أَكبَرِ الحَجِّ حافٍ غَيرَ مُنتَعِلٍ","مِن حالِفٍ مُحرِمٍ بِالحَجِّ مَصبورِ",7,"ر",1,0],["فيا كعبةً شهدت هائمَين","أفاءا إلى حسنها المنتقَى",8,"ق",2,0],["فَيا كَبِداً أَخشى عَلَيها وَإِنَّها","مَخافَةَ هَضباتِ اللِوى لَخَفوقُ",9,"ق",1,0],["فَيا كَبِدا مِنَ الطَرَبِ المُعَنّى","إِلَيها إِنَّ أَهوَنَهُ شَديدُ",10,"د",1,0],["فَيا كَبِداً فيها مِنَ الشَوقِ قَرحَةٌ","وَلَيسَ لَها مِمّا تُحِبُّ شِفاءُ",11,"ا",2,0],["في اكتسابِ المالِ من كل مَرَام","وانهمكْنا في خبالِ واجترامِ",12,"م",1,0],["في أكله الطَّيب في شربه","في لبسه النعم في مركبه",13,"ب",2,0],["فيا كهفَ الوزارةِ إِن كهفي","إذا ما استأصل الأمن الوبالُ",14,"ل",1,0],["فيا كبدي إن كنت مني تقطعي","ويا أعيني لم لَم يكن ذلكَ البحرُ",15,"ر",1,0],["فيا كبدي من الهجران ذوبي","ويا جفني بالدمع استهلا",16,"ل",2,0],["فيا كَبِدَيْنا من مَخافَةِ لوعةِ","الفِراقِ ومن صَرْفِ النّوى تَجْفان",17,"ن",1,0],["فيا كمْ اسقطتني في الخطايا","رياحٌ ارهقت مجْرى سفيني",18,"ن",2,0],["فيأكلها ويشربُها هنيّا","على النغمات من زير وجسّ",19,"س",1,0],["فَيا كَبِدِي زِيدي ضَنىً وَصَبابَةً","وَيا جَلَدِي لَن تَستَطيع مَعي صَبرا",20,"ر",2,0],["فيا كوخَ الفقيرِ غدوتَ دنيا","وكلُّ الأرضِ للفقراءِ دارُ",21,"ر",1,0],["فيا كوخَ الفقيرِ إذاً سلاماً","فأنتَ لبهجةِ الدنيا وقارُ",21,"ر",1,0],["فيا كوكبَ الصبحِ إما بزغتْ","تألق تاجاً على الأرؤسِ",22,"س",1,0],["فيا كعبة الجدوى ويا حرم الرجا","حنانيك اني جئت نحوك محرما",23,"م",2,0],["فيا كاسر العدوى وجابر من سطت","به غير الأيام فهو وهيض",24,"ض",1,0],["فَيا كَهفَ الأَرامِلِ وَاليَتامى","وَيا بَحرَ العَطايا وَالرَغائِب",25,"ب",1,0],["فيا كبدي ذوبي اشتياقاً لقبره","ويا دمع عيني لا أعتراكَ توقُّفُ",26,"ف",1,0],["فيا كبدي ذوبي أساً حيث أسهم ال","تنائي إذا جاءت أصابت ولم تُخط",27,"ط",1,0],["فَيا كنز العديم أقل عثارى","فاني عبدك الفلس العَديم",28,"م",1,0],["فيا كعبة الحسن البديع الذي غدا","بها كل صب وإله القلب حائر",29,"ر",1,0],["فيا كعبة فضل التي هِيَ قبلَةٌ","لَها اِنتَجَع القصّاد مُنتجع العينِ",30,"ن",1,0],["فيا كبدي في الوصل منه تقطّعي","غراماً ويا نفسي اذْهبي بسلام",31,"م",1,0],["في اكْتِساب الفخر سَعْيكُمُ","فما لِغَيرِ إمامِ الحَقّ مُفتخَرُ",32,"ر",1,0],["فيا كُثْرَ ما قد نَوَّلَتْنا يد المنى","وعادَتُها الإمساك بالنائل النزر",33,"ر",1,0],["في أَكْرَمِ الذِّكْرِ فِي الدنيا وأَخْلَدِهِ","وأَسْعَدِ الجَدِّ فِي الدُّنيا وأَصْعدِهِ",34,"د",2,0],["فيا كافرا بالنبل في الكون ساخرا","من الحق ليس الكفر مجداً لفنان",35,"ن",1,0],["فيا كاشفَ الجلَّى ويا محييَ الهدى","ويا قاتل البلوى ويا كاشفَ الغمَّا",36,"م",2,0],["فيا كم جزعنا وادياً كان مترعاً","بجودك أو ثوباً من الأرض معلما",37,"م",2,0],["فيا كبدي الحرّي غداةَ زعمتما","بأن التنائي في غدٍ سيكون",38,"ن",1,0],["فيا كبدي أين الهدوُّ من الجوى","ويا جفنَ عيني أين منكِ هجود",39,"د",1,0],["فَيا كَبِدي ما ذُبْتِ والجَمْرُ لاهِبٌ","ويا مُهْجَتي لِمْ أنتِ لم تَقَطَّعي",40,"ع",2,0],["فيا كاشحاً قد جاء في زي ناصحٍ","تشاغل بغيري لست ممن يعرف",41,"ف",1,0],["في أكمل النعمة والسلامة","وأعظم الغبطة والكرامة",42,"ه",1,0],["فيا كُردُ لا تُحزِنَنكَ الخُطوبُ","فَإِنَّ الهُمومَ بِقَدرِ الهِمَم",43,"م",1,0],["فَيا كُردُ صَبراً عَلى مِحنَةٍ","فَكَم مِحنَةٍ شيبَت مِن لِمَم",43,"م",1,0],["فيا كثير الرقادِ احذر تعديهُ","وكحل الجفنَ كحل السهد والأرق",44,"ق",1,0],["فيا كُرَيزيُّ كيف تَثْبُتْ يا","ريشةُ قُدَّامَ ريحيَ الزَّعْزَع",45,"ع",1,0],["فَيا كَعبَةَ الفضلِ الّتي قَد نَطوفُها","كَما طيفَ بِالبَيتِ العَتيقِ المحرَّمِ",46,"م",1,0],["فيا كبدي الحرى ويا دمع إذ جرى","سأصفيكما ودُي فلا تقبلا الرشا",47,"ش",2,0],["فَيا كَبدي ذوبي أسىً وتلهّفاً","فَقَد ضاعَ وعدٌ واِستَقامَ وعيدُ",48,"د",1,0],["فيا كوكبي الساهي ويا ربة الشذا","ويا موجتي الثكلى ويا نسمة الفجر",49,"ر",1,0],["فيا كمدي رُدَّ الدموعَ لباطني","لتسقيَ أو جالي فتثمر أشجاني",50,"ن",2,0],["فيا كنز اسرار الخفايا انكشف لنا","لندرك سرا حير العقل مغزاه",51,"ا",2,0],["فياكبدي من حرّ وجد تَصدّعي","وياعينُ سحيّ الدَّمع سَجلاً على سَجلِ",52,"ل",1,0],["فيَأكُلُهَا من حينِهِ وَلَو أَنَّها","رُدَينيّةٌ فيها أَسِنّة قَعضب",53,"ب",1,0],["فيا كبدى ذُوبى ويا أضلعى قِدى","ويا مُهجتى بينى ويا أدمُعى اسكبى",54,"ب",2,0],["فيا كعبة الأشواق هل لمتيم","يفوز ولو في العمر منك بعمرة",55,"ه",1,0],["فَيَا كَبِداً مِنْ لَوْعَةِ الحُبِّ كُلَّما","ذكرتُ وَمِنْ رَفْضِ الهَوَى حِينَ يَرْفُضُ",56,"ض",1,0],["فيا كعبة القصد والمبتغى","وحضرة رب كريم جواد",57,"د",1,0],["فيا كوكباً تحت الثرى حاز مغرباً","وكانت له فوق الثريا مطالع",58,"ع",1,0],["فيا كبدي ماذا جَزيتِ ابنَ مالِكٍ","ويا عبرتي ماذا قَريتِ أَبا الحَسَن",59,"ن",1,0],["فَيا كَوكَب الشَّرق أَبدى سَنا","وَما كادَ يهديهمُ أَن غرب",60,"ب",1,0],["فيا كبداً يُحمى عليها وأنَّها","مخافة هَيضات النوى لخَفُوقُ",61,"ق",1,0],["فيا كاشف الغماء عزماً فما لها","سواك يرد الحق من كل غاصب",62,"ب",1,0],["فَيَا كَمْ هَدَّ مِنْ قَصْرٍ مَشِيدٍ","وفرّق بين جثمانٍ ورأس",63,"س",1,0],["فياكتبي مالي ومالك أنني","رضيت عمى قلبي ونورك أسحم",64,"م",1,0],["فيا كعبة الآمال طال تبددى","بفقد معان انت منى بها ادرى",65,"ر",2,0],["فيا كبد ماذا تلاقي من الأسى","ويا بلبل الأشعار كم أنت تصدَحُ",66,"ح",1,0],["فيا كوكباً قد زيَّن الارض نوره","ويا قمراً قد زان افق السما الجلوى",67,"و",2,0],["فيا كَلْبُ ذُبُّوا عن حريمِ نسائكُمْ","كما ذَبَّ فَحْلُ الشَّوْلِ بين عشارِها",68,"ر",3,1],["فيا كُل معشوقٍ صُنِ الخد سائراً","وَعَظَّ سُويدا القلبِ يا كُلَّ عاشقِ",69,"ق",1,0],["فيا كبدي القريح ويا دموعي","لذي الزفرات هل لك ان تعيني",70,"ن",2,0],["فيا كاتب العصر هذا الكتاب","نشيدة من قد مضى أو غبر",71,"ر",1,0],["فيا كعبة المجد يا من إليه","تشد الورى في الزمان الرحالا",72,"ل",2,0],["فيا كهف الأرامل من يرجى","وأنت لقى تكفنك الرمول",73,"ل",1,0],["فيأكل الناس منه","لحماً حلال الموارد",74,"د",1,0],["فيا كنز إفضال وبحر معارفٍ","ونهر علوم فاض فضلاً على السُدِّي",75,"د",2,0],["فَيا كامد الحُسّاد يا قاهر العِدا","وَغَصّة قاليه وَرَغم المَراغم",76,"م",1,0],["فَيا كم أَرى في الغرب رُوحَ مُقَنَّعٍ","تحرّك بَين الشَرق جسماً مُعَمَّما",77,"م",2,0],["فَيا كم تَأنّّى إِلى أَن تهنّى","بِما قَد تمنى زَمانٌ لَجوج",78,"ج",1,0],["فَيا كَم لَيلة أَغوى دجاها","وَأَيام وَأَغرانا ضحاها",79,"ا",3,0],["فَيا كَم قَد شَكَوتُ لَهُ غَرامي","وَتهيامي وَمِن بلبال بالي",80,"ل",2,0],["فيا كبدي ذوبي ويا مهجتي ارحلي","فقد ضاقت الأحوال من شدة الخطب",81,"ب",1,0],["فيا كعبة تسعى الأنام لحجها","ليستمسكوا منها بانعام قاسم",82,"م",1,0],["فَيا كَبِدِي كَمْ تَصْبِرِينَ عَلى الاَذى","أمَا آنَ أنْ يغْني إذَنْ حَسَراتُها",83,"ت",3,0],["فَيا كَوكَباً فَوقَ العَواصِفِ ساهِماً","يُتابِعُهُ طَيفُ الدُجى وَهوَ غائِرُ",84,"ر",1,0],["فَيَأكُلُ مِن أَكلي وَيَشرَبُ مَشرَبي","وَيَسعى بِسَعيِ ناصِراً وَيُوالي",85,"ل",2,0],["فيا كبراء هذا العصر كونوا","يداً تطوى لباس الكبرياء",86,"ا",2,0],["فيا كريماً إلى العلياء مرتقياً","بهرام يخدمه والكوكب الساري",87,"ر",2,0],["فيا كراما بخل الدهر في","لقياهم وهو أخو الظلم",88,"م",1,0],["فيا كعبة قد تراموا لها","حجيجا وقد أمنوا هولها",89,"ه",2,0],["فيا كوكب المعروف أطلعت كوكباً","ويا ضيغم العلياء أعقبت ضيغما",90,"م",2,0],["فيا كبدي أنت الوديعةُ عندَ من","يخونُ ولم تُحفظ لديه الوَدائع",91,"ع",1,0],["فَيا كَنزَ جود اللَهِ هل من عطيَّةٍ","فَيُقضى بِها ديني وَتُقضى مَآرِبي",92,"ب",2,0],["فيا كاشف الضراء والكُرَب التي","قد أصبح للأقوام لولاك علقما",93,"م",2,0],["فَيَا كُلَّ سَفَّاكٍ.. ويا كُلَّ سارِقٍ","إِلى اللهِ يَدعُوها، أَو اللَّاتِ والعُزَّى",94,"ز",2,0],["فيا كياني .. إذا بالنبضِ تنطقُها","وارِ العيونَ التي بالزيغِ تعترفُ",95,"ف",1,0],["فَيَا كَلِفًا بِجَنَّةِ عَينِ نُورٍ","أدِر وَجهًا إلَى نَارِ الهُيَامِ",96,"م",1,0],["فياكوفةَ الأمجادِ حيَّتْكِ وحدةٌ","على فجرها التفت جميع الأواصرِ",97,"ر",1,0],["فيا كاهن الأيام جئت معلماً","لقابيل يقضي بالذي أنت آمر",98,"ر",1,0],["فيا كتابي إن جئت الرياض غداً","وأشرقت طلعةٌ من مثلها القمر",99,"ر",1,0],["فيا كل َّ أوراقي كتبت ُ جديدة ً","وأنت ِ بهذا الليل ِ يغمرك ِ البعد ُ",100,"د",1,0],["فَيَا كَم سَهِرتُ عَلَيكِ ، ونِمتِ","قَرِيرَةَ عَينِكِ مُستَسلِمَهْ",101,"م",2,0],["فيا كلُّ آهٍ بقلبٍ تماهتْ","لكِ اللهُ يهدي سواءَ السبيلْ",102,"ل",1,0],["فيا كاعياً قد سامها الخسف من بغى","فطال عليها كربها وعثاها",103,"ا",3,0],["فيا كعبة الآمال طاف بها الهدى","على الطوع فرضاً واجباً وتطوعا",104,"ع",2,0],["في اكتمالي ورفعتي وانفتاحي","سوف أسعى محررا قلب قُدسي",105,"س",2,0],["فيا كعبة المشتاقِ يا نور دربه","حنانيك أرجو كلما جئت محرما",106,"م",2,0],["فيا كم أتيتك ُ في كل يوم ٍ","وتحتال كيلا تلاقي الهلاك ْ",107,"ك",1,0],["فيا كل الحياة علام هجري","ويا كل الحياة القلب ذابا",108,"ب",2,0],["فيا كل القصائد ليس يأتي","لنا عزٌّ ولم نسلكْ جهادهْ",109,"د",2,0],["فيا كربلا طُلْتِ السَّمَاءَ وربّما","تنَاولَ عفواً حَظَّ ذي السعيِ قَاعِدُ",110,"د",1,0],["فَيَا كَأسُ كَمْ أَسرَرتُ مِنْ يَأسِ حَالَتِي","وَ أَعلَنَها - جَهرَاءَ - خَائِنِيَ الشِّعرُ",111,"ر",1,0],["فيا كفه كم في الورى لك من يد","فهل عارض بالعين قبلك واكف",112,"ف",1,0]]}