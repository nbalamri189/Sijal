{"poems":[[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38530","الرمل"],[5232,"جذوة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=212801",""],[5295,"ميلاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=210856",""],[5431,"وعرّشت في الأعماق نبعا وماجفّا","https://www.poetsgate.com/ViewPoem.aspx?id=198714",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5957,"عراقي الملامح","https://www.poetsgate.com/ViewPoem.aspx?id=177087",""],[5969,"طقوس العز","https://www.poetsgate.com/ViewPoem.aspx?id=198911",""],[6048,"أُحِبكَ وهَذِه ِ قُبلتِي","https://www.poetsgate.com/ViewPoem.aspx?id=198123",""],[6302,"اشْتِبَاهْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86226&r=&rc=24",""]],"verses":[["طَقطَقَ الفانوسُ لمّا أَن أَضا","غِبّ ما النّار ذَكَت في جَنبِهِ",0,"ه",1,1],["طَقْسي غريبٌ في عناصره ِ","كلُّ الطيور تفرُّ من طقسي",1,"س",2,0],["طقسُ الْجنونِ يلفُّ صمتَ دقائِقي","باللهِ كيفَ لخافقي أن يُرجِئَهْ",2,"ا",2,0],["طقوسٌ وأحلام ببحر غواية","وليلٌ على الشباك يرنو إلى المنفى",3,"ف",2,0],["طقوس والهزيع على احتدام","كقداس البراكين الشراس",4,"س",1,0],["طقوس الحب في محراب روحي","صلاة الخوف في ألمي الدفين",5,"ن",1,0],["طقوسك في الهوى كالنور يضفي","ويشعل نار قلبي من ضرامك",6,"ك",1,0],["طُقوسُ العِز لا يَرقى إليها","سِوى مَنْ عاشَ حُراً في عَناهُ",7,"ا",2,0],["طُقوسُ نَارٍ تَهُبُ فِي الأنا لَهَبًا","والجَمْرُ فِي قُبْلَتِي إِنْ أجَّ قّدْ قَتَلا",8,"ل",2,0],["طُقوسي اعتدتِها تَرفاً.. وقلبي..",".. تَعهَّدَ وَجْدَها أَلَماً وَشقوهْ!!",9,"و",2,0]]}