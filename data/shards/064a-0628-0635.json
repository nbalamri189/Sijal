{"poems":[[55,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[90,"أن من حاز في العلوم إجازه","https://www.aldiwan.net/poem45000.html","الخفيف"],[31,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[80,"قيدي أما تعلمني مسلما","https://www.aldiwan.net/poem14224.html","السريع"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[19,"يبصبصن بالأذناب حول لبانه","https://www.aldiwan.net/poem357.html",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[80,"قَيدي أَما تَعلمُني مُسلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87619&r=&rc=165",""],[203,"زفت ولما يفترعها المزاج","https://www.aldiwan.net/poem45642.html","السريع"],[208,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[369,"وتيس عجيب الشكل يأكل باسته","https://www.aldiwan.net/poem60884.html","أحذ الكامل"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138092",""],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106914","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204963","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205029","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205002","الخفيف"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107485","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136921",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4791,"الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=36903",""],[4859,"ترب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213913",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5700,"خَفقَة","https://www.poetsgate.com/ViewPoem.aspx?id=191217",""],[6093,"فَلْسَفَةُ المَوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=179845",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["يُبصِرُ الناسُ عَلى أَيديهِمُ","قَصَبَ الأَعناقِ بِالبيضِ يُقَطّ",0,"ط",1,0],["يُبْصِرُ الغَيْبَ مِنْ فَرَاسَتِهِ","وَيُعِيدُ العَصِيَّ قَدْ دَانَا",1,"ن",2,0],["يبصر الخطب من هواديه حتى","ينتهي فيه مبصراً أعجازه",2,"ز",2,0],["يُبَصبِصُ وَالقَنا زورٌ إِلَيهِ","وَقَد أَعذَرنَ في وَضَحِ العِجانِ",3,"ن",1,0],["يُبصِرُني فيكَ أَبو هاِشمٍ","فَيَنثَني وَالقَلبُ قَد هُشِّما",4,"م",2,0],["يُبصِرُ الآلَ إِذ يُراحُ بِهِم في","مَوقِفِ الذُلِّ عَنوَةً وَيُجاءُ",5,"ا",2,0],["يُبَصبِصنَ بِالأَذنابِ حَولَ لَبانِهِ","تَخالُ عَلى لَبّاتِهِنَّ الخَصائِلا",6,"ل",2,1],["يبِصُّ لَذي مَنصِبٍ يُرتجى","ويَخدُم ذا صَولةٍ يُختشى",7,"ا",1,0],["يُبصِرُني فيكَ أَبو هاِشمٍ","فَيَنثَني القَلبُ وقَد هُشِّما",8,"م",2,0],["يبصِرها من خلفِ أضلاعهِ","كأنما يبصِرها من زجاجْ",9,"ج",1,0],["يبصر ما أوحت النفوسُ له","وماله آلةٌ بها يُبصرْ",10,"ر",1,0],["يُبَصْبِصُ في وجَهْي لدى الأُنس بالّذي","يُلَفُّ على الخَيشوم إن رُعْتُه زَجْرا",11,"ر",2,0],["يُبصِرون الغيثَ واللّيثَ معاً","والحَيا والشّمسَ من غيرِ امتراء",12,"ا",2,0],["يُبصر النسر وهو في الجو ما لا","تبصر الطير وهي في الدأماء",13,"ا",2,0],["يبصر العمي ثم يسرع","بالزمنى قام يا ما بسر آيته",14,"ت",2,0],["يبصر المرتاد في أفيائها","بهجة النفس ومسلاة الحزين",15,"ن",1,0],["يبصر أني رقصتُ حزنا","لو كنت غصنا",16,"ا",1,0],["يبصر السامعون منها شراراً","فتنير الأسماع والأفكارا",17,"ر",2,0],["يبصر النور ظلاما ويرى","في الغنا نورا لنا ليس يبين",18,"ن",1,0],["يبصر البرء في الخيال ولكن","يقظة النفس تدحض التخييلا",19,"ل",2,0],["يبصر الموت في المسارح إما","علل النفس بالهنا تعليلا",19,"ل",2,0],["يبصرها ذو الفطن الصحيحه","إن أعمل الفكرة والقريحه",20,"ه",1,0],["يُبصِرون التي سُليمانُ لم يلبس","حُلاها في مجدهِ والفخارِ",21,"ر",1,0],["يبصر الناس في مراحٍ ورغدٍ","ويرى نفسهُ شقياً فقيراً",22,"ر",2,0],["يُبصر القربَ والوصالَ حَراماً","ويَرى الهجرَ والبعادَ حَلالا",23,"ل",2,0],["يُبصِرُ الناسُ مِنهُ ما يَبعَثُ الرَح","مَةَ في قَلبِ شانِئٍ وَصَفيِّ",24,"ي",1,0],["يبصر بها الفرد الصمد رب الأرباب","يرفع ظليمتنا عزيز الجلالي",25,"ل",2,0],["يبصرُ الحبَّ حثيثاً","نحوه يقبلُ سعيا!",26,"ي",2,0],["يبصر الخل قد تضعضع وجدا","وإلى وصله يجيش الخفوق",27,"ق",1,0],["يبصر القوم بين هاو الى اللحد","وغرقان دائب في احتظار",28,"ر",1,0],["يُبصِرُ الآلامَ كَيْ يَنقُلَهَا","لِضَمِيرٍ بَاتَ فِيْ العُربِ ضَرِيرَا",29,"ر",2,0],["يُبَصِّرُنَا حَقِيْقَتَنَا","وَ إِنْ غَابَتْ إِلى حِيْنِ",30,"ن",1,0],["يبصر الريح وهي تعتصر النهر","وتلقيه كومة من نجيع",31,"ع",1,0]]}