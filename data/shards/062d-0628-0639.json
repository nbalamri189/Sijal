{"poems":[[208,"ما لي إلى مثلك من شافع","https://www.aldiwan.net/poem53268.html","السريع"],[398,"حب علي علو همه","https://www.aldiwan.net/poem53440.html","الكامل"],[398,"حب علي بن أبي طالب","https://www.aldiwan.net/poem53469.html","السريع"],[398,"حب علي لي أمل","https://www.aldiwan.net/poem53470.html","مجزوء الرجز"],[398,"حب علي بن أبي طالب","https://www.aldiwan.net/poem53626.html","السريع"],[398,"لو فتشوا قلبي رأوا وسطه","https://www.aldiwan.net/poem53628.html","السريع"],[398,"حب علي شرف","https://www.aldiwan.net/poem53669.html","مجزوء الرجز"],[398,"حب علي بن أبي طالب","https://www.aldiwan.net/poem53672.html","السريع"],[408,"حب علي وبنيه","https://www.aldiwan.net/poem46962.html","مجزوء الرجز"],[572,"حب علي علو همه","https://www.aldiwan.net/poem69525.html","مجزوء الرجز"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51557","المنسرح"],[2400,"","https://poetry.dctabudhabi.ae/diwan/poem/205090",""],[2838,"","https://poetry.dctabudhabi.ae/diwan/poem/144483","السريع"],[4791,"يفداك من شافك","https://www.poetsgate.com/ViewPoem.aspx?id=37103",""],[5431,"لم يبقِ دمعا مُحزِنا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198188",""],[5463,"ذا غرامك يا بنيّه فاق ماهم يوصفون","https://www.poetsgate.com/ViewPoem.aspx?id=33249",""],[5648,"ليال البعد","https://www.poetsgate.com/ViewPoem.aspx?id=154828",""]],"verses":[["حُب عليِّ بن أبي طالبٍ","دلالة باطنةٌ ظاهِرَهْ",0,"ر",2,0],["حبُّ عليٍّ علوُّ هِمَّه","لِأَنَّهُ سَيدُ الأَئِمه",1,"ه",1,1],["حبُّ عَلِيُّ بنِ أَبي طالِبٍ","يُمَيِّزُ الحُرَّ من النَغَلِ",2,"ل",1,1],["حُبُّ عليٍّ لي أَمَل","وَمَلجَأي عِندَ الوَجَل",3,"ل",1,1],["حبُّ عَلِيِّ بنِ أَبي طالِبٍ","فَرض عَلى الشاهِد وَالغائِبِ",4,"ب",1,1],["حبُّ عَلي بنِ أَبي طالِبٍ","وَحبُّ مَولايَ أَبي طالِبِ",5,"ب",1,0],["حُبُّ علِيٍّ شَرَفُ","وَمَفخَرٌ لَو عَرَفوا",6,"ف",3,1],["حُبُّ عَلِيِّ بنِ أَبي طالِبٍ","هو الَّذي يَهدي إِلى الجَنَّه",7,"ن",2,1],["حبّ عليٍّ وَبَنِيهِ","الطُّهرِ أَهْلِ الرَّشَدِ",8,"د",1,1],["حُبُّ عَلِيَّ عُلُوُّ هِمَّهْ","لِأَنَّهُ سَيِّدُ الأَثِمَّهْ",9,"م",2,1],["حُبُّ عليٍّ بعدَ النبِيِّ ولا","أشتُمُ صِدّيقاً ولا عُمَرا",10,"ر",2,0],["حب عثمان بن عفا","ن وحب العمرين",11,"ن",1,0],["حبُّ عليّ بن أبي طالبٍ","للنّاس مِقياس ومِعيارُ",12,"ر",1,1],["حبٍ عظيمٍ بالغلا يلزم إلزام","الخافق اللَّي بالهوى له عوايد",13,"د",1,0],["حبٌ على الدمع انثنى","والدمع وشوش سرّنا",14,"ن",2,1],["حبّ عذري جاك منّي ويتزيّن به الفؤاد","وعشق خُمري ما تنام الليل منّه هالجفون",15,"ن",1,0],["حبٍ عجز دونه وساويس وابليس","ولايدخل الخاطر شكوك العبادي",16,"د",2,0]]}