],[380,"لمن طلل بالجزع قفر جوانبه","https://www.aldiwan.net/poem48837.html","الطويل"],[402,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[403,"ثوى جبل العلم الذي طال واندكا","https://www.aldiwan.net/poem33612.html","الطويل"],[409,"يقولون قد أعولت في الدار ما كفى","https://www.aldiwan.net/poem31658.html","عموديه"],[416,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[416,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[439,"بشر الخيل يوم كر الطراد","https://www.aldiwan.net/poem34856.html","الخفيف"],[443,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[452,"لا أحب الجليس فظا غليظا","https://www.aldiwan.net/poem13718.html","الخفيف"],[453,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[461,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[461,"سأبعثها بين البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[461,"عداك الردى والذم كم من فصيحة","https://www.aldiwan.net/poem15677.html","الطويل"],[461,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[461,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[468,"أبا أحمد شتان عندك ناشر","https://www.aldiwan.net/poem60233.html","الطويل"],[475,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[477,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[477,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[482,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[495,"لئن أحرزك الداعي","https://www.aldiwan.net/poem10238.html","الهزج"],[500,"قلبي منكم خائف خافق","https://www.aldiwan.net/poem37656.html","السريع"],[515,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[515,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[529,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[538,"أبي عمدتي سؤلي منائي وسيلتي","https://www.aldiwan.net/poem48192.html","عموديه"],[544,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[551,"سأبلغ حاجاتي وإن كن نزحا","https://www.aldiwan.net/poem47156.html","الطويل"],[575,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[586,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"]],"verses":[["سَأَبعَثُها ظُبَةً تَختَلي ال","خَصائِلَ أَو تَعرُقُ الأَعظُما",0,"م",2,0],["سَأَبذُلُ دونَ العِزِّ أَكرَمَ مُهجَةٍ","إِذا قامَتِ الحَربُ العَوانُ عَلى رِجلِ",1,"ل",1,1],["سَأَبلُغُ بِالقِلى وَالبُعدِ عَنكُم","مَبالِغَ لَيسَ تُبلَغُ بِالأَلالِ",2,"ل",1,0],["سابِق فَلَيسَ تُنالُ أَغ","راضُ المُنى إِلّا سِباقا",3,"ق",2,0],["سَأَبكي لِلشَبابِ بِشارِداتٍ","كَصارِدَةِ السِهامِ عَنِ القِياسِ",4,"س",1,0],["سابِقٌ غُضَّتِ الأَكُفُّ عَليهِ","أَنجَدَ اليَومَ في العَلاءِ وَغارا",5,"ر",2,0],["سَأَبعَثُها عَلَيكَ مُسقِفاتٍ","طِباقَ الأَرضِ أُطلِعُها الفِجاجا",6,"ج",2,0],["سَأَبكي ضِياءً مُستَقِلاً لَها البُكَا","وَيُسعِدُني يَحيى وَفَضلٌ وَجَعفَرُ",7,"ر",1,0],["سَأَبكي عَلى نَفسي بِعَينٍ غَزيرَةٍ","بُكاءَ حَزينٍ في الوِثاقِ أَسيرِ",8,"ر",1,0],["سابِقِ الغَربِيَّ وَاِسبِق وَاِعتَصِم","بِالمُروءاتِ وَبِالبَأسِ اِعتِصاما",9,"م",2,0],["سابِحٌ تَحتَنا مُطِلٌّ عَلَينا","حائِمٌ حَولَنا مُناءٍ مُداني",10,"ن",2,0],["سَأَبكي عَلى حَظّي لَدَيكَ كَما بَكى","رَبيعَةُ لَمّا ضَلَّ عَنهُ ذُؤابُ",11,"ب",1,0],["سَأَبكِيهِما وَاللَهِ ما حَنَّ والِهٌ","وَما أَثبَتَ اللَهُ الجِبالَ الرَواسِيا",12,"ي",2,0],["سَأَبكيكُما عُمري وَأَلعَنُ غادِراً","وَمَن كانَ أَوحى وَالحَديثُ شُجونُ",13,"ن",1,0],["سأبكيه ما دام الحمام مطوّقاً","وما سجعت تبكي الهديلَ قماريها",14,"ي",3,0],["سأبكي ثم استبكى عليها","إذا نضبت من العين الغروب",15,"ب",1,0],["سأبكي عليها كلّما جُلت سائحاً","وشاهدت في العمران مملكةً ترقى",16,"ق",2,0],["سأبكي عليها كلما هبّت الصَبا","فمالت بها من حول دجلة أغصان",17,"ن",1,0],["سأبدي لدهري ناج المتضحّك","ولو كانَ يجري بالذي هوُ مهلكي",18,"ك",2,1],["سأبكيه ولم أعبأ بسلاح","وأندبه وإن سخط العموم",19,"م",1,0],["سأبكي وأستبكي الجيوش على فتىً","فقدناه فقد الغيث في الزمن الصلد",20,"د",1,0],["سَأَبسُطُ مِن يَدَيَّ عَلَيكَ فَضلاً","وَنَحنُ القاطِعونَ يَدَ الظَلومِ",21,"م",1,0],["سَآبى وَتَأبى بي أُصولٌ كَريمَةٌ","وَآباءُ صِدقٍ بِالمَوَدَّةِ شُرِّفوا",22,"ف",3,0],["سأبكيك للدنيا وللدِّين إِنني","رأيت يدُ المعروف بعدك شُلَّتِ",23,"ت",1,1],["سَأَبكيكَ ما أَبقى لِيَ الدَهرُ مُقلَةً","فَإِن عَزَّني دَمعٌ فَما عَزَّني دَمُ",24,"م",1,0],["سابغ الجودِ والثنا قسّمت نع","مى يديه في كل عان غريب",25,"ب",1,0],["سأبكيه ما لاح الظلام بظلمه","وأبكيه ما ناح الحمام بضاله",26,"ل",2,0],["سابق مدَّاحكم وأجدرهم","بأن تبدا إعدام إعدامه",27,"م",2,0],["سأبذل جفني بعد سيفٍ فقدته","إذا السيف أودى فالعفاء على الجفن",28,"ن",1,0],["سأبدي مَعَاتِبَ مكنونةً","إذا هي لم تَبْدُ عادت ضِبَابَا",29,"ب",2,0],["سأبْدِئُ شكري تارة وأعيدُه","على مُبْدئٍ للعارفات مُعيدِ",30,"د",1,0],["سابقة لم تزل تُنقِّلها","بسابقٍ في الكتاب مستطَرِ",31,"ر",1,0],["سابق مضمار كلّ مكرمةٍ","أعيتْ على راكضٍ وتركاضِه",32,"ض",2,0],["سأبكي بِنَثْرِ الدمع طوراً وتارة","بنظم المراثي دائمَ الحُزْنِ والوَكمْ",33,"م",1,0],["سَأَبعَثُ نَوحاً بِالرَجيعِ حَواسِراً","وَهَل أَنا مِمّا مَسَّهُنَّ ضَريحُ",34,"ح",1,0],["سابِحٌ عِندَهُ العَسيرُ يَسيرٌ","وَالقَصِيُّ القَصِيُّ غَيرُ بَعيدِ",35,"د",1,0],["سابِحَةٌ في بِحارِ فِتنَتِها","رافِلَةٌ في ذُيولِ ظَلماها",36,"ا",3,0],["سابِق زَمانَكَ خَوفاً مِن تَقَلُّبِهِ","فَكَم تَقَلَّبَتِ الأَيّامُ وَالدُوَلُ",37,"ل",1,0],["سَأَبكي وَإِن تَنزِف دُموعي عَلَيكُم","بَكَيتُ بِشِعرٍ رَقَّ فَهوَ دُموعُ",38,"ع",1,0],["سأبغي لنفسي من حياتي متعة","واعلم اني لست في الارض خالدا",39,"د",2,0],["سأبقى كئيباً ملء نفسي حسرة","اذا لم يكن لي ما هنالك منظورا",40,"ر",2,0],["سابِقُ النَقعِ يَستَقي جُهدَ نَفسٍ","تُستَزادُ اِستِزادَة المَسبوقِ",41,"ق",1,0],["سَآبى وَتَأبى لي تَميمٌ وَرُبَّما","أَبَيتُ فَلَم يَقدِر عَلَيَّ أَميرُ",42,"ر",1,0],["سَأَبكيكَ حَتّى تُنفِدَ العَينُ ماءَها","وَيَشفِيَ مِنّي الدَمعُ ما أَتَوَجَّعُ",43,"ع",1,0],["سَأَبكيكَ ماكانَت بِنَفسي حُشاشَةٌ","وَما دَبَّ فَوقَ الأَرضِ يَمشي أَنامُها",44,"م",3,0],["سأبَعثُ حَمْدي غازياً وَفْرَ سيِّدٍ","إذا ما غزاه الحمدُ عاد مظفَّرا",45,"ر",2,0],["سأبعثُ الحمدَ مَوشِيّاً سبابُيه","إلى الأميرِ صحيحاً غيرَ مُؤتَشِبِ",46,"ب",1,0],["سأُبرزُها سَوافرَ لا يُواري","محاسِنَها إذا برزَتْ نِقابُ",47,"ب",1,0],["سابِق حُتوفَ الرَدى وَاِعمَل عَلى مَهَلٍ","ما دُمتَ في هَذِهِ الدُنيا عَلى مَهَلِ",48,"ل",1,0],["سابِق إِلى جَنّاتِ عَدنٍ قَد بَدَت","أَزهارُها بِغَرائِبِ الأَجناسِ",49,"س",1,0],["سَأَبكيكَ بِالأَشعارِ حَتّى إِذا وَهَت","سُلوكُ عُقودِ النَظمِ أَنجَدَني النَثرُ",50,"ر",1,0],["سَأَبكيكَ جُهدَ المُستَطيعِ مُنَظَّماً","رِثاكَ وَهَذا جُهدُ مَن ما لَهُ جُهدُ",51,"د",1,0],["سَأَبكيكَ بِالعِزِّ الَّذي كُنتَ مُلبِسي","لَديكَ وَثِقلٍ كُنتَ تَحمِلُهُ عَنّي",52,"ي",1,0],["سَأَبكي ما حَييتُ وَلَستُ أَنسى","صَنائِعَكَ الأَواخِرَ وَالأَوالي",53,"ي",1,0],["سَأَبكيكَ بِالعِزِّ الَّذي كُنتَ مُلبِسي","وَكُنتُ بِهِ بَينَ الوَرى أَتَصَرَّفُ",54,"ف",1,0],["سَأَبكي القَوافي بِالقَوافي فَإِنَّها","عَلَيها وَلَم تَظلِم بِذاكَ جَوازِعُ",55,"ع",1,0],["سَأَبكي ما أَطاعَ الدَمعُ عَيني","مَحاسِنَهُ وَفَترَةَ مُقلَتَيهِ",56,"ي",2,0],["سَأَبعَثُ اليَومَ آمالي إِلى مَلَكٍ","يَلقى المَديحَ بِقَلبٍ غَيرِ نَسيانِ",57,"ن",1,0],["سابقتَ قوماً إلى الأضيافِ إذا وقفوا","كوقفةِ العَيْرِ بينَ الوِرد والصدَرِ",58,"ر",1,0],["سابَقْتُ بالبيضاءِ في ميدانها","شقراءَ جلِّق فاستكنَّ ضميرُها",59,"ر",3,0],["سَأَبكي عَلى ما فاتَ مِنّي صَبابَةً","وَأَندُبُ أَيّامَ السُرورِ الذَواهِبِ",60,"ب",1,1],["سَابحٌ في البَرِّ والبحرِ وفي","مَسْبَحِ الريحِ ومَجرَى الشِّعريَيْنْ",61,"ن",1,0],["سَأَبكي عَلى مِصرٍ وَسالِفِ مَجدِها","وَإِن لَم يَكُن لي مِن بَني مِصرَ مُسعِدُ",62,"د",1,0],["سأبكي عليكَ مدةَ العمرِ إنَّني","رايتُ لبيداً في الوفاءِ مُقَصّرا",63,"ر",2,1],["سَأَبغي عَلَيكُم يا بَني وَذَحِ استِها","مَثالِبَ أَعيا دونَهُنَّ أَخو كَلبِ",64,"ب",1,0],["سَأُبلي خَيرَ ما أَبلى مُحامٍ","إِذا ما النَبلُ أُلجِمَ بِالقِياسِ",65,"س",1,0],["سَأَبغي الغِنى إِمّا نَديمَ خَليفَةٍ","يُقيمُ سَواءً أَو مُخيفَ سَبيلِ",66,"ل",1,0],["سابَقَ الناسَ هاشِمُ اِبنُ حُدَيجٍ","يَومَ موسى اِبنَ مُصعَبِ المَقتولِ",67,"ل",1,1],["سأبكي إذا غنّى ابنُ وَرْقاءَ بَهجةً","وإن كانَ ما يَعنيهِ ضِدَّ الذي أعْني",68,"ن",2,0],["سأَبلغ القصد عَن قَريب","إِن دامَ ركضي بلا عثار",69,"ر",1,0],["سَابَقُونِي فَقَصَّرُوا عَنْ لَحَاقِي","إِنَّما السَّبْقُ مِنْ خِصَالِ الْجَوَادِ",70,"د",1,0],["سَابَا لَكَ اللهُ وَهْوَ أَلْطَفُ مَنْ","يَأْسُو جَرِيحاً وَأَنْتَ ذُو رَشَد",71,"د",1,0],["سابحٌما يشاءُ في بحرهِ الهادي","كما يدفعُ الشراع السفينا",72,"ن",2,0],["سَأَبكيهِم ما حَجَّ لِلَّهِ راكِبٌ","وَما ناحَ قُمرِيٌّ عَلى الشَجَراتِ",73,"ت",1,0],["سَأَبكيهِمُ ما ذَرَّ الأُفقِ شارِقٌ","وَنادي مُنادي الخَيرِ بِالصَلَواتِ",73,"ت",1,0],["سابِقوها بالدِينِ والْخُلُقِ السَّمْحِ","وصِدْقِ الوَفاءِ للإِخْوانِ",74,"ن",1,0],["سابقوها بالْجِدِّ فالْجِدُّ والمَجْدُ","كما شاءتْ العُلا تَوْأمانِ",74,"ن",1,0],["سابق أنتَ للمجَرَّةِ، أم أح","دثُ عهدًا، أم أنتما توءَمان؟",75,"ن",1,0],["سابح الذهن حالم بلشقاتِ","شريد العينين بين الغمائم",76,"م",1,0],["سأُبْدىء ُ شكري تارة وأعيدُه","على مُبْديءٍ للعارفات مُعيدِ",77,"د",1,0],["سابِقوها بالْجِدِّ فالجِدُّ","والمَجْدُ كما شاءتْ العُلا نَؤمان",78,"ن",1,0],["سأَبْكيهمُ ما ذَرَّ في الأرْض شَارِقٌ","ونادى منادي الخيرِ بالصلواتِ",79,"ت",1,0],["سأبكيه ولم أعبأ بلاح","وانديه وان سخط العموم",80,"م",1,0],["سأبكي عليك الناس حتى تخالهم","يتامى دهاهم يوم بنت عظيم",81,"م",1,0],["سأبْكِي مدَى عُمْري عليه كآبةً","بدمعٍ غزيرٍ فوقَ خَدِّى ساجمِ",82,"م",1,0],["سأبكى على لبنى وإن كنت نائيا","وقد كان نأى الحِبِّ للصَّبِ مبكيا",83,"ي",2,0],["سابقاتٌ وفدَ الرياح إذا يو","مُ رِهانٍ أجراهما من مَهَبِّ",84,"ب",1,0],["سَأَبكي وَذو الأَشجانِ يَبكي شَجونَهُ","بِدَمعٍ مَرَت كَفُّ الفِراقِ شُؤونَهُ