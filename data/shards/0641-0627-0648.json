://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12844","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1942","الطويل"],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[43,"مغاني الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=154",""],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[35,"حِبَالُ سُجَيْفَة َ أمْسَتْ رِثَاثَا","https://www.poetsgate.com/ViewPoem.aspx?id=21988",""],[51,"رأيتُ أبا إسحاق والفحلُ فوقه","https://www.poetsgate.com/ViewPoem.aspx?id=29872",""],[24,"رحَلْتُ إلى قومي لأدْعُوَ جُلَّهُم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10870&r=&rc=11",""],[24,"وهاجِرة ٍ لا تَسْتَرِيدُ ظِباؤها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10884&r=&rc=25",""]],"verses":[["فَأَوسَعَني قَبلَ العَطاءِ كَرامَةً","وَلا مَرحَباً بِالمالِ إِن لَم أُكَرَّمِ",0,"م",1,0],["فَأَوى وَقالَ أَرى بِقَلبِكَ لَسعَةً","لِلحُبِّ لَيسَ لِدائِها مِن راقِ",1,"ق",1,0],["فَأولاهُمُ بِالحَمدِ مَن لانَ رَدُّهُ","وَمَن حَسُنَت عِلّاتُهُ وَمَعاذِرُه",2,"ر",2,0],["فَأَوَّلُنا العَناءُ إِذا طَلَعنا","إِلى الدُنيا وَآخِرُنا الذَهابُ",3,"ب",1,0],["فأَودَعَ قَلبي وَصفُهُنَّ عَلاقَةً","فَها أَنا مِن ذاكَ الحَديثِ وَقيذُ",4,"ذ",1,0],["فأوّلُ أفعالِهِمْ آخِرٌ","وبِكْرُ مَكارِمهمْ ثَيِّبُ",5,"ب",1,0],["فأوجُهُها مِنْ طُرّةِ الصُّبْحِ تَكْتَسي","وسائِرُها في حُلّةِ اللّيلِ يَرْفُلُ",6,"ل",1,0],["فأوْجُهُهُمْ والخَطْبُ داجٍ مُضيئَةٌ","وألْسِنَتُهُمْ والعِيُّ مُحتَصَرٌ لُدُّ",7,"د",1,0],["فأوْرَدَها الرّأيُ الظَّهيريُّ مَسْرحاً","على نُغَبٍ زُرْقٍ تَجَلّتْ قَذاتُها",8,"ت",3,0],["فأوْهَنَ البَغْيُ كفّاً كان يُلْمِسُها","قلباً يُرَشِّحُ أضْغاناً وأحْقادا",9,"د",2,0],["فأوْفِ لمَنْ أوفى وكافِ الذي كَفى","فأنْتَ كريمٌ طهُرَتْ منْهُ أعْراقُ",10,"ق",1,0],["فَآوِ طَرِيداً عَائِذاً أَنْتَ كَهْفُهُ","وَذِكْرُكَ بِالْمَدْحِ الصَّرِيحِ رَقِيمُهُ",11,"م",2,0],["فأوْجَدْتَ منّي فائِتاً أيَّ فائِتٍ","وأنْشَرْتَ ميْتاً ضمّ أشْلاءَهُ قَبْرُ",12,"ر",1,0],["فأوْلَيْتَنا في ظِلِّه كلَّ نِعْمَةٍ","هيَ القَطْرُ لا يُحْصى بحَصْرٍ ولا عَدِّ",13,"د",1,0],["فأوْلِ وَجْهَ القَبُولِ عُذْرِي","وَجَنِّبِ الشَّكَّ فِي صَفَاءِ",14,"ف",3,0],["فَأَورَدَها عَيناً مِنَ السَيفِ رِيَّةً","بِها بُرَأٌ مِثلُ الفَسيلِ المُكَمَّمِ",15,"م",1,0],["فَأَوفِ بِما عاهَدتَ بِالخَيفِ مِن مِنىً","أَبا النَصرِ إِذا سُدَّت عَلَيكَ المَطالِعُ",16,"ع",1,0],["فَأَورَدَها في عُكوَةِ اللَيلِ جَوشَناً","لِأَكفالِها حَتّى أَتى الماءَ لازِمُ",17,"م",1,0],["فَأَورَدَها طامِياتِ الجِمامِ","وَقَد كُنَّ يَأجِنَّ أَو كُنَّ جونا",18,"ن",2,0],["فَأَودى بِهِ خَتلاً فَمالَ إِلى الثَرى","وَمالَت لَهُ الأَجرامُ مُنحَرِفاتِ",19,"ت",1,0],["فاوِض وَلا تَخفِض جَناحَكَ ذِلَّةً","إِنَّ العَدُوَّ سِلاحَهُ مَفلولُ",20,"ل",1,0],["فاوِض وَأَنتَ عَلى المَجَرَّةِ جالِسٌ","لِمَقامِكَ الإِعظامُ وَالتَبجيلُ",20,"ل",1,0],["فاوِض فَخَلفَكَ أُمَّةٌ قَد أَقسَمَت","أَلّا تَنامَ وَفي البِلادِ دَخيلُ",20,"ل",1,0],["فاوِض فَإِن أَوجَستَ شَرّاً فَاِعتَزِم","وَاِقطَع فَحَبلُكَ بِالهُدى مَوصولُ",20,"ل",1,0],["فَأَوقَعنا في تيهِ موسى فَكُلُّنا","حَيارى وَلا مَنٌّ لَدَيهِ وَلا سَلوى",21,"ل",3,0],["فَآوي إِلى ظِلٍّ ظَليلٍ وَنائِلٍ","جَزيلٍ وَملكٍ حالفَ العِزَّ جارُهُ",22,"ر",2,0],["فَأَورَدَها ماءً قَليلاً أَنيسُهُ","يُحاذِرنَ عَمراً صاحِبَ القُتُراتِ",23,"ت",1,0],["فَأَورَدَها مِن آخِرِ اللَيلِ مَشرَب","بَلائِقُ خُضراً ماؤُهُنَّ قَليصُ",24,"ص",1,0],["فَأَورَدَهُنَّ مِنَ الدَونَكَينِ","حَشَارِجَ يَحفِرنَ مِنها إِراثا",25,"ث",2,0],["فَأَولِجِ السَوطَ عَلى حَوشَبٍ","أَجرَدَ مِثلِ الصَدَعِ الأَعفَرِ",26,"ر",1,0],["فَأَوْجَبَ الشُّكْرَ لأَدْنَى النَّدَى","مَا جَعَلَ الفَقْرَ مِنَ الذَّنْبِ",27,"ب",1,0],["فأوجدت فيها النقل وارتسمت","كالأصل في قسماتها الغر",28,"ر",1,0],["فأوجفوا ما أوجفوا سارحين","ثم انثنوا من خوضهم مارحين",29,"ن",1,0],["فَأُوتِيَ ذُخْراً مِنْ غَوَالِي دُرُوسِهِ","غَرَانِيقُ فَازُوا فِي الحَيَاةِ وَفِتْيَانُ",30,"ن",1,0],["فَأَورَدَها مَسجورَةً ذاتَ عَرمَضٍ","تَغولُ سيولَ المُكفَهِرّاتِ غولُها",31,"ل",3,0],["فآونةً تفرّق بانبساط","وآونةَ تجمّع بانكماش",32,"ش",1,0],["فأوسعهم بالسيف ضرباً رقابَهم","وآنافَهم جَدعاً وأجوافهم بَقرا",33,"ر",2,0],["فأول درس تهذيب السجايا","يكون عليك يا صدر الفتاة",34,"ه",1,0],["فأوغل في المفاوُز والمَوامي","وطَوّف في الحواضر والبوادي",35,"ي",1,0],["فَأْوِ إلى ظلّه تعش رغَداً","عيشاً أميناً من سوء مُنقلبَه",36,"ب",2,0],["فأوطانكم لن تستقلّ سياسة","إذا أنتم لم تستقلّوا بها فكرا",37,"ر",2,0],["فَأَورَثَكَ العَلاةَ وَأَورَثونا","رِباطَ الخَيلِ أَفنِيَةَ القِبابِ",38,"ب",1,0],["فَأَولِع بِالعِفاسِ بني نُمَيرٍ","كَما أولَعتَ بِالدَبَرِ الغُرابا",39,"ب",2,0],["فَأَولى وَأَولى أَن أُصيبَ مُقَلَّداً","بِغاشِيَةِ العَدوى سَريعٍ نُشورُها",40,"ر",3,0],["فَأَورَدَكَ الأَعدادَ وَالماءُ نازِحٌ","دَليلُ اِمرِئٍ أَعطى المَقادَةَ بِالدَحلِ",41,"ل",1,0],["فَأَورَدَهُم مُسَلَّحَتَي تِياسٍ","حَظيظٌ بِالرَياسَةِ وَالغِنامِ",42,"م",1,0],["فَأَورَدَها العِراكَ وَلَم يَذُدها","وَلَم يُشفِق عَلى نَغَصِ الدِخالِ",43,"ل",1,0],["فَأَورَدَها مَسجورَةً تَحتَ غابَةٍ","مِنَ القُرنَتَينِ وَاِتلَأَبَّ يَحومُ",44,"م",1,0],["فأُونسُ من بعض الصديق ملالة الدُّ","نوِّ فأستبقيهمُ بالتجنبِ",45,"ب",1,0],["فأوفقت دوني بغير المِراط","ولا الفوق مما حشوت الجفيرا",46,"ر",2,1],["فَأَورَثَنا مَجداً وَمَن يَجنِ مِثلَها","بِحَيثُ اِجتَناها يَنقَلِب وَهوَ حامِدُ",47,"د",1,0],["فَأَوَّبَهُ اللَيلُ شَطرَ العِضاهِ","يَخافُ جَهاماً وَصُرّادَها",48,"د",3,0],["فَأَورَدتُها ماءً فَما شَرِبَت بِهِ","سِوى أَنَّها قَد بُلَّ مِنها المَشافِرُ",49,"ر",1,0],["فَأَورَدَكَ اللَهَ بَردَ الجِنانِ","جَذلانَ في نِعمَةِ المَولِجِ",50,"ج",1,0],["فآوي بشطِّ النيل طرفي وناقتي","وأطرح في تيَّاره السرح والرحلا",51,"ل",2,0],["فَأَورَثَنا الشَرابُ عُلومَ غَيبٍ","تَشِفُّ عَلى عُلومِ الأَقدَمينا",52,"ن",2,0],["فأوسعتَني منعاً إخالُك نادماً","عليه وفي تمحيصه الآن راغبا",53,"ب",2,0],["فآونةً أكسوك وَشْياً محبَّراً","وآونة أكسوك ريطاً مُسيَّحا",54,"ح",2,0],["فَآوٍ منْهُ في كهْفٍ","وراعٍ منْه في سفْحِ",55,"ح",1,0],["فأوَّلهم قاد الجيوش وذادها","زُريقٌ وعبد الله للقوم خامس",56,"س",1,0],["فأويْنا لهم وما عطفتْنا","رحِمٌ بيننا هناكَ تئَطُّ",57,"ط",1,0],["فأولى يا بني العباس أولى","لكم منه وأمرُكُمُ جميعُ",58,"ع",1,0],["فأوسع الفاسدين مصلحة","في غير إثم هناك مقترف",59,"ف",1,0],["فأومى بأن نكني فقلت له انتظر","فراغ أخينا فالمكانُ مضيقُ",60,"ق",1,0],["فأوعى جوفه المجنو","ن جُردانا له حالُ",61,"ل",1,0],["فآونةً يُدالُ على أناسٍ","وآونةً يديلهُمُ مُديل",62,"ل",1,0],["فآونةً لصفحته انبلاجٌ","وآونةً لشفرته اصطلامُ",63,"م",1,0],["فأُوَفِّيكمُوهُ بالصاع صاعي","نِ وفاءً يسوء وَجْه المَدينِ",64,"ن",1,0],["فأوصِ خليفتك المُرْتَضى","بكتْبي وعَرّفه حالي لديكا",65,"ك",2,0],["فَأَوقَدَ نارَ مَكرُمَةٍ وَمَجدٍ","فَلَم توقَد مَعَ الجُشَمِيِّ نارُ",66,"ر",1,0],["فَأَورَدتُها ماءً كَأَنَّ جِمامَهُ","مِنَ الأَجنِ حِنّاءٌ مَعاً وَصَبيبُ",67,"ب",1,0],["فَأَودَعتُها في صَميمِ الفُؤا","دِ وَلَم أَرضَ تَسطيرَها بِالذَهَب",68,"ب",1,0],["فَأَوهَمَني أَمراً وَقُلتُ لَعَلَّهُ","رَأى حالَةً لَم يَرضَها فَتَجَنَّبا",69,"ب",2,0],["فَأَومَأتُ إيماءً خَفِيّاً لِحَبتَرٍ","وَلِلَّهِ عَينا حَبتَرٍ أَيُّما فَتى",70,"ا",1,0],["فَأَولى أَن يَظَلَّ العَبدُ يَطفو","بِحَيثُ يُنازِعُ الماءُ السَحابا",71,"ب",2,0],["فَأَوَّلُ مَن مَرَّت بِهِ الطَيرُ نِعمَةٌ","لَنا وَمَبيتٌ عِندَ لَهوَةَ صالِحُ",72,"ح",1,0],["فَأوّلُها رَجاءٌ مِن سَرابٍ","وَآخرُِها رِداءٌ مِن تُرابِ",73,"ب",1,0],["فأوسعها شتما ورد سؤالها","وقال لها موتي طوى لست أبذل",74,"ل",1,0],["فأوْرَدَهُمْ صَدْرَ الحِصانِ وَسَيْفَهُ","فَتًى بأسُهُ مِثْلُ العَطاءِ جَزيلُ",75,"ل",1,0],["فأولَى لها لو فازَ بالبدرِ كفُّهُ","إِذا لاستقلَّتْهُ لعافيهِ دِرهَما",76,"م",2,0],["فأولَى لها من هِمَّةٍ ذُلِّلَتْ لها","صِعابُ العُلَى لولا الزمانُ المعانِدُ",77,"د",1,0],["فَأَولى لِلظَلومِ لَوَ أَنَّ نَفسي","بِشَيءٍ مِن مَوَدَّتِهِ تَطيبُ",78,"ب",1,0],["فَأَولِهِمُ نُعمى فَكُلُّ ص