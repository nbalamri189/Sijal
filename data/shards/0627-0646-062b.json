{"poems":[[53,"رب نائي الملاط يحسب جيدا","https://www.aldiwan.net/poem30208.html","الخفيف"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[93,"هي زهرة بسمت بها","https://www.aldiwan.net/poem11469.html","مجزوء الكامل"],[23,"إن ثقيفا كان فاعترفوا به","https://www.aldiwan.net/poem21460.html","الطويل"],[72,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[85,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[66,"إن ثنت عنكم الخطوب عناني","https://www.aldiwan.net/poem40972.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[80,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[106,"شكر عارفة","https://www.poetsgate.com/ViewPoem.aspx?id=179475",""],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""]],"verses":[["إِن ثَناهُ الزَمامُ جَرجَرَ كاّلرا","عِدِ بِاللَيلِ لَجَّ في قَرقارِه",0,"ر",2,0],["إِنْ ثُقِّفَتْ لطُفَتْ وَفِي ضَحِكَاتِهَا","إِيمَاضُ بَرْقٍ لا انْفِضَاضُ سِنَانِ",1,"ن",1,0],["إِنْ ثَقُفَتْ لَمْ يَلْفَ مِنْهَا","آلُهَا غَيرَ الجَمِيلْ",2,"ل",1,0],["إِنَّ ثَقيفاً كانَ فَاِعتَرِفوا بِهِ","لَئيماً إِذا ما نُصَّ لِلُّؤمِ مَعقِلُ",3,"ل",1,1],["إن ثقَّلوا فعل جودٍ قد أبرّ فما","في المنِّ منٌّ ولا في الصفو تكدير",4,"ر",1,0],["إنّ ثرىً ضمها لأفضلُ مح","جوجٍ لِصَبٍّ وخيرُ معتَمرِ",5,"ر",1,0],["اِنثَنى مَوجَةً وَأَقبَلَ يُرخي","كِلَّةً تارَةً وَيَرفَعُ سِترا",6,"ر",2,0],["أُنثى وَلَكِن في جَنا","حَيها لَباةٌ مُخدِرَه",7,"ر",2,0],["إِن ثَنَت عَنكُمُ الخُطوبُ عِناني","فَفُؤادي لَدَيكُمُ وَجَناني",8,"ي",1,1],["أنثى تلاقي كل آونةٍ","رجلاً وترمي الوعد آلافا",9,"ف",2,0],["إن ثوبَ الصبا يُمَزَّق منِّي","ما الّذي بالخضاب مِنْه يُرَقَّع",10,"ع",1,0],["إنّ ثعبانَ سراه يقتدي","في نعيب منه بالبّرِ غراب",11,"ب",1,0],["إن ثنى ناشدْتُكُمْ نِشْدانَكُمْ","سُجَرائي ليَ عنهُ عَيُّ عَي",12,"ي",1,0],["أُنِّثَت ثُمَّ ذُكِّرَت فَلَها دَلُّ","فَتاةٍ رودٍ وَقَدُّ غُلامِ",13,"م",1,0],["أنثى تفيض مروءة","جُعل الرجالُ لها فدى",14,"د",2,0],["أنثى مُثَقَّفَةٌ إذا عاشرتَها","تَدْري شئون البَيْتِ كيف تُدار",15,"ر",1,0]]}