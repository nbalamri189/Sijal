""],[5751,"نَهارُ عينَيك","https://www.poetsgate.com/ViewPoem.aspx?id=215014",""],[5781,"أُنْثاكَ في العشق!","https://www.poetsgate.com/ViewPoem.aspx?id=208932",""],[5819,"صديقي مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=215676",""],[5848,"قبل الحفلة","https://www.poetsgate.com/ViewPoem.aspx?id=49005",""],[5883,"شيطان الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=22789",""],[5939,"أنثى الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=187751",""],[5943,"أنا وقلبي للوفاءِ فداءُ","https://www.poetsgate.com/ViewPoem.aspx?id=11281",""],[1920,"حجرٌ قلبُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=191354",""],[5956,"حيويتان متبادَلتان ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182266",""],[5956,"مغناطيس الاستعطاف","https://www.poetsgate.com/ViewPoem.aspx?id=192106",""],[5957,"زارني حرفٌ جميلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=37427",""],[5969,"أنثى من روحي أفديها","https://www.poetsgate.com/ViewPoem.aspx?id=198928",""],[5997,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=214294",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6089,"علقت أيامي","https://www.poetsgate.com/ViewPoem.aspx?id=213644",""],[6089,"هبْ لي جمارك","https://www.poetsgate.com/ViewPoem.aspx?id=213860",""],[6093,"أرجوحة","https://www.poetsgate.com/ViewPoem.aspx?id=197204",""],[6102,"لحم ودم","https://www.poetsgate.com/ViewPoem.aspx?id=184863",""],[6131,"صراعُ الماءْ","https://www.poetsgate.com/ViewPoem.aspx?id=189528",""],[6143,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=34307",""],[6196,"موعدُ العمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83044&r=&rc=0",""],[6203,"من منفاه يحدّثك!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88022&r=&rc=0",""],[6238,"أنثى...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86775&r=&rc=4",""],[4960,"الليلية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87988&r=&rc=0",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""]],"verses":[["إِن ثَناهُ الزَمامُ جَرجَرَ كاّلرا","عِدِ بِاللَيلِ لَجَّ في قَرقارِه",0,"ر",2,0],["إِنْ ثُقِّفَتْ لطُفَتْ وَفِي ضَحِكَاتِهَا","إِيمَاضُ بَرْقٍ لا انْفِضَاضُ سِنَانِ",1,"ن",1,0],["إِنْ ثَقُفَتْ لَمْ يَلْفَ مِنْهَا","آلُهَا غَيرَ الجَمِيلْ",2,"ل",1,0],["إِنَّ ثَقيفاً كانَ فَاِعتَرِفوا بِهِ","لَئيماً إِذا ما نُصَّ لِلُّؤمِ مَعقِلُ",3,"ل",1,1],["إن ثقَّلوا فعل جودٍ قد أبرّ فما","في المنِّ منٌّ ولا في الصفو تكدير",4,"ر",1,0],["إنّ ثرىً ضمها لأفضلُ مح","جوجٍ لِصَبٍّ وخيرُ معتَمرِ",5,"ر",1,0],["اِنثَنى مَوجَةً وَأَقبَلَ يُرخي","كِلَّةً تارَةً وَيَرفَعُ سِترا",6,"ر",2,0],["أُنثى وَلَكِن في جَنا","حَيها لَباةٌ مُخدِرَه",7,"ر",2,0],["إِن ثَنَت عَنكُمُ الخُطوبُ عِناني","فَفُؤادي لَدَيكُمُ وَجَناني",8,"ن",2,1],["أنثى تلاقي كل آونةٍ","رجلاً وترمي الوعد آلافا",9,"ف",2,0],["إن ثوبَ الصبا يُمَزَّق منِّي","ما الّذي بالخضاب مِنْه يُرَقَّع",10,"ع",1,0],["إنّ ثعبانَ سراه يقتدي","في نعيب منه بالبّرِ غراب",11,"ب",1,0],["إن ثنى ناشدْتُكُمْ نِشْدانَكُمْ","سُجَرائي ليَ عنهُ عَيُّ عَي",12,"ي",1,0],["أُنِّثَت ثُمَّ ذُكِّرَت فَلَها دَلُّ","فَتاةٍ رودٍ وَقَدُّ غُلامِ",13,"م",1,0],["أنثى تفيض مروءة","جُعل الرجالُ لها فدى",14,"د",2,0],["أنثى مُثَقَّفَةٌ إذا عاشرتَها","تَدْري شئون البَيْتِ كيف تُدار",15,"ر",1,0],["أنثى إذا ضاقت سريرة نفسه","طلعت بآفاق عليه فساح",16,"ح",1,0],["إن ثار شوقي إليكم","يوما صحوتم فثرتم",17,"م",1,0],["إن ثار وجدى فناح طرفى","فالحبّ في مهده كروب",18,"ب",1,0],["إنَّ ثَغرا عهِدتَه بك بَسّا","ما عداه حتى تعودَ الهَناءُ",19,"ا",2,0],["اِنثِيالاً مِثلَ ما تَب","عَثُ أَفواهُ الجِراحِ",20,"ح",1,0],["أُنثّرُ تذكاراتِ حبِّكِ في الدُّجى","كتَنثيرِ وَردٍ في حديقةِ خالك",21,"ك",1,0],["انثَنى يُثني عَلى نُعمى النُعامى","حينَ حَيَّتهُ بِأَنفاسِ الخُزامى",22,"م",2,1],["ان ثنت لين عطفها","ينثني الغصن والحجر",23,"ر",1,0],["إنَّ ثَلاثَةً صَحِبَتْ ثَلاثَةً","أَعَبْتْ عِلاجَ بَدْوِها والحَضَرِ",24,"ر",1,1],["إِنْ ثَنَتْ خَلَّةٌ إِليه يَمِيني","فبعضبٍ تَبْرِيهِ بَرْيَ الخِلالِ",25,"ل",1,0],["إِن ثَلَمَ الضَيفُ رَغيفاً لَهُ","بَكى عَلَيهِ بِأَحرِّ الدُموع",26,"ع",1,0],["أنثى الوقوف إزاء نابغة إذا","ماقال قولا ليس يبقى أو يذر",27,"ر",1,0],["أنثير حرباً في البلاد وأنت من","منع السوابق أن تثير غبارا",28,"ر",2,0],["انثت عليك المشكلات وعقدها","من قيد ألسنة الورى محلول",29,"ل",1,0],["إن ثَنَى طَرْفه فجؤْذرُ رملٍ","أو لوى جيدَهُ فظبيُ كِناس",30,"س",1,0],["إِنْ ثَغرُهُ أَبدى لَنا تَبَسُّما","يَخرُجُ مِنهُ الدّرّ وَالمرجانُ",31,"ن",1,0],["إِنَّ ثَوباً لَبستُه لَجَميلٌ","وَعَلى غَيري حيثُ قَد صارَ أَجمَل",32,"ل",1,0],["إن ثوب الصون والعفة من","دون ما تطلبه منا حمى",33,"م",2,0],["إِنْ ثَبَتَ الرُوحُ انْتَزَعْن عَقْلِي","أَوْ طَبَّقَتْ دَاهِيَةٌ لا تُعْلِي",34,"ل",2,0],["أنثاهمُ زن","وبنتهم دختر",35,"ر",1,0],["أنث سنينه لمن بها أكل","وتحذفَ التا في سنين للأجل",36,"ل",1,0],["أنث بتاء أو بهاء أو ألف","معا وللتصغير ياء أو ألف",36,"ف",1,0],["أنّث وشبّه زد وأبدل أصل","ضارع تفاعل ثم صل وحوّل",36,"ل",1,0],["إن ثبت الهمز مع التصغير","فاقطعه في التأنيث والتذكير",36,"ر",1,0],["أُنُثر على خَدَّيَّ من وَردِك","أو دَع فَمي يَقطُفُ من خدِّك",37,"ك",1,1],["أنثنى منه وفى كبدى","نارُ وُجدٍ من تثنّيهِ",38,"ي",2,0],["انثروا الزهر على قبر الشباب","فشبيه الشىء بالشىء يُثاب",39,"ب",1,1],["أنثى سما باسْمِها النادي وكم ذكرٍ","يُدْعَى كأنَّ اسْمَهُ من لؤمه لقب",40,"ب",1,0],["أُنثى ولكنْ إذا عَدُّوا فضائِلَها","لم يدْعِ الفضلَ من أنثى ولا ذكر",41,"ر",1,0],["انثنى منه بنت فكر كأنها","بما ضمنت سكري تشير إلى الضم",42,"م",1,0],["انثاته زوجها الذكرور بيّضها","إذا سوّدته وروّاها بتنييل",43,"ل",1,0],["أنثاته زوجها الذكرور جلّلها","إذ نالها شبه امرأة ورجلول",44,"ل",1,0],["انثر شجوى ناثراً عبرتي","يا حبذا النثر ونعم النظام",45,"م",1,0],["إن ثوى بالترب منهم نير","فهو شمس قد عرتها وجبه",46,"ب",2,0],["إنّ ثوباً يخيطه غيرُ كفء","لبسه والعراء أضحى سواء",47,"ا",2,0],["إن ثنى حلمه الشذا فشذاه","أبطحي وحلمه مدني",48,"ي",1,0],["أنثى بها حسنت صفات مذكّرٍ","ذاتٌ لها فوق النساء سناء",49,"ا",2,0],["أنث أولى بالانتصار اذا ما","جرد الحب سيفه المسلولا",50,"ل",2,0],["أنثرهم فوق الحُبيلِ ودونه","كما انتثرت من صُرتَّيها الدراهمُ",51,"م",1,0],["أنَثرُكَ أم نَثرُ السَّحَابَةِ لِلنَّدَى","مُعَلَّمَةً مِن جُودِ آبَائِكَ الغُرِّ",52,"ر",1,0],["أنثر لئال أم عقود من الدرر","أم الكاعب الحسنا باسمة الثغر",53,"ر",1,1],["إن ثوى جسمي فحل النجفا","ففؤادي عنده لم يظعن",54,"ن",1,0],["أن ثم لن ثمَّ حتَّى بعدها وإذن","ومن يُحَصِّل معانيها فقد غنما",55,"م",2,0],["إِنَّ ثَوَاءَ المَرءِ في أَوطَانِهِ","عِزٌّ وَما الغُربَةُ إلا كالتَّوَى",56,"ا",1,0],["إن ثلاثا مهلكات للورى","كذاك جاء في حديث مسند",57,"د",1,1],["أنثُرُ الدمع حين أنظمُ شعري","فأتِمُّ الحديثَ نظماً ونثرا",58,"ر",2,0],["أُنثَى على القَلبِ ما زالَت أَصابِعُها","مَرسُومةً, لَم يُصَافِح بَعدَها أَحَدَا",59,"د",2,0],["أُنثايَ تعرفُ ذاتَها ودَواخِلاً","قبلَ التِقائك لم تَكُن أن تُعْلَنا",60,"ن",2,0],["انثى من اثداء الخيال محلوبه","هي اربعين وكوكبي به تشبه",61,"ب",2,0],["أنثى وأجملُ ما لديها حسنُها","والشمسُ من ألوانها تتلعثمُ",62,"م",1,0],["أنثى أنا .. فيكَ -أي والله- والهةً","وأنتَ لا تعرف الأنثى إذا ..ولهتْ",63,"ت",1,0],["انثرْ حروفًا على الأنّاتِ؛ في دعة","إنَّ الحروفَ على الأنَّاتِ تقتاتُ",64,"ت",1,0],["انثر شوقي ويلمه","وأحلف انه آسرني",65,"ن",2,0],["أُنْثَىْº وَمَاْ مِثْلُ الأُنُوْثَةِ فِتْنَةٌ","لِلْعَاْشِقِيْنَº أَسَاْسُهَاْ حَوَّاْءُ",66,"ا",2,0],["انثريني على حروفِكِ بذراً","وارسميني على نقاطِكِ حقلا",67,"ل",2,0],["أُنثَى مِنَ الضَّوْءِ الذِّي إشْعَاعُهُ","أزْرَى بِكٌلِّ كَوَاكِبِ الأَقْمَارِ",68,"ر",1,0],["أنثى تروق أخا الهيام حسناء فارعة القوام","جسم رشيق زانه عنق حكى عنق النعام",69,"م",1,1],["أُنثى أَرَقُّ مِنَ النسيمِ فؤادُها","والعِطْفُ أنْدى مِنْ براعمِ وَردِ",70,"د",1,0],["أُنثايَ عنديَ لا أنثى ستشبهها","ما شابهتْ أبدًا في حسنها مثلا",71,"ل",2,0],["انْثُرْ عَلَى زَمَنِ الْوَفَاءِ قَصِيْدَةً","تُرْثِيْ بِهَا كَبِدِي وَصَهْدَ ضُلُوعِي",72,"ع",2,0],["أنْثَى بِمُشْتَقَّاتِهَا وَنُمُوِّهَا","فإَذَا السُّكُونُ جَمَالُهُ غَنَّاءُ",73,"ا",2,0],["أنثني كفّي تحضنُ القلبَ خوفًا","خلتُ قلبي قد مات في الكفِّ نحرا",74,"ر",2,0],["أٌنْثَوِيُّ الرَّغْدِ الرَّوَى فِي رِيَاضِي","يَرْتَخِي كَالْمَيْسُونِ لَمَّا تَسُورُ",75,"ر",1,0],["إن ثناني عن حفظ عهدكم ثا","ن وإن كان لي سواكم مراما",76,"م",2,0],["أنثر قريضك للنفوسِ محبّةً","واجعل نسيمك عابر الأكوانِ",77,"ن",1,0],["أنثايَ أنتِ وفي عينيكِ تجربتي","خُضْتُ البحارَ بها كي أدركَ الشَفَقا",78,"ق",2,0],["أنثى كَوَجْهِ الشَّمسِ ليسَ يُطالُ","نَثَرَتْ سناها والظّلامُ رِجالُ",79,"ل",1,1],["أنثى أراكِ أنيقَ الحسنِ تحمله","ووجهك الروضُ فيه الحسنَ ما حملا",80,"ل",2,0],["أنثاي تقذفني إلى إنسانها","أمواجها وتصبني في ساحلي",81,"ل",2,0],["انْثُر دِمَاكَ على الثَّرى","واجْمَعْ رُفَاتَكَ وانْتَحِبْ",82,"ب",1,1],["انْثُرْ دِمَاكَ على الثَّرَىٰ","وانْسَ الهُوَيَّةَ والنَّسَبْ",82,"ب",1,0],["أنْثى تُطَرِّزني أشْذاءُ بَسْمَلَتي","وَ عِنْدَ رُوحي يقَومُ الَورْدُ مُبْتَهِلا...",83,"ل",2,0],["انْثُرْ عَلَيَّ مِنَ النَّدَى حَبَّ النَّدَى","هُوَ ذاكَ ذاكَ وَفيهِ ذاكَ سَيَعْلَقُ",84,"ق",1,0],["أنْثَى الخَيالِ وَكُلّ مَنْ أحْبَبْتَهُنَّ","وَجِئْتَهُنَّ مِنَ النِّساء سَأَحْرِقُ",84,"ق",1,0],["أنْثى أنا فوْق الأنا","ولأنتَ دوني تْنتَهي..",85,"ه",2,0],["أنْثَى بِمُفْرَدِها تَهزُّ مَجَرَّةً","مَنْ يَقْرُبُ الأنْثَى الَّتي تَتَأجَّجُ",86,"ج",1,0],["أنْثى النَّقاء ولا أريدُ سَوى أنا","وأنا بِمْعراج الحُروف أُتَوَّجُ",86,"ج",1,0],["أنثى يُشيطنها حينا ويرفعها","نحو السماء إذا ما حنّ أحيانا",87,"ن",2,0],["أنثر الحب في ربوعي ليربو","وله في جنان شعري نصيب",88,"ب",1,0],["انثر الحَبّ للطيور بهاء","وامسح الحزن عن هوى يستاء",89,"ا",2,0],["أُنثَى تُقيّدُ في السلاسل لاهثا","والقلبُ يسرعُ ظامئاً لغنيمةْ",90,"م",2,0],["أُنثَى ومتعتها العميقة معبدٌ","وأمامها حشدٌ يلمُّ هشيمه!",90,"م",2,0],["أنثى تضجّ خرافاتٍ يطيح بها","إمّا تكشّفت السيقان قسيسُ !!",91,"س",1,0],["أنثى وتفرد فوق العرش رغبتها","تهوى العظام ولاترضى بهم نكسا",92,"س",2,0],["اُنثُرْ على جرحِ بدا لكَ غائِرًا","وردَ الشروقِ منَ السّماءِ فيَدمَلَا",93,"ل",2,0],["‏انثري وردك علي ومن عيونك لو سهم","بارسمك باعذب حروفي انتي سيد الغايبين",94,"ن",1,1],["إنثر آمالك على صدر اُمنياتك","وإدفن آلامك تحت ذكرى قديمه",95,"م",2,0],["أنثىً، وعلّمتُ الطّيورَ غناءَها","مِن حُزنِ عينٍ في جُفونِكَ غافِيَةْ",96,"ف",3,0],["انثرْ بروضتهم ما ش