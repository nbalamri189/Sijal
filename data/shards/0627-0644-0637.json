55845.html","أحذ الكامل"],[459,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[459,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[462,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[462,"حلفت بالواضحات الغر مسفرة","https://www.aldiwan.net/poem15907.html","البسيط"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[469,"الطل من فوق الشقيق","https://www.aldiwan.net/poem59801.html","مجزوء الكامل"],[479,"على هذه الأرض","https://www.aldiwan.net/poem9094.html","عموديه"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[539,"الطالبون واتصل","https://www.aldiwan.net/poem47417.html","عموديه"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[539,"بلغ إلى المولى الهمام سلامي","https://www.aldiwan.net/poem47926.html","عموديه"],[539,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[552,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[559,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[563,"يا أيها السفح ماذا يصنع البان","https://www.aldiwan.net/poem52853.html","البسيط"],[563,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"]],"verses":[["الطَودُ أَيهَمُ وَالسَماءُ عَريضَةٌ","وَاليَومَ أَيوَمُ وَالقَلَمَّسُ طامِ",0,"م",1,0],["الطاهِرِ اِبنِ الطاهِرينَ وَمَن يَكُن","لِأَبٍ إِلى جِذمِ النُبُوَّةِ يَعظُمِ",1,"م",1,0],["الطاعِنينَ مِنَ الجَبّارِ مَقتَلَهُ","وَالضارِبينَ وَذَيلُ النَقعِ مُنسَدِلُ",2,"ل",1,0],["الطاعِنينَ مِنَ الأَعداءِ ما لَحِقوا","وَالخَيلُ تَلطِمُ هاماتِ الصَياخيدِ",3,"د",1,0],["الطَّاعِنُونَ وَمَا بِهَا مِنْ طَاعِنٍ","وَالْمُطْعِمُونَ وَمَا بِهَا مِنْ مُطْعِمِ",4,"م",1,0],["الطَّاعِمُ الْكَاسِي وَرِفدُكَ كَافِلُ","وَالْعَالَةُ الْمُعْفَاةُ مِمَّا يَثْقُلُ",5,"ل",1,0],["الطَّاعِنُونَ الْخَيْلَ يَوْمَ المُلْتَقَى","وَالْمُطْعِمُونَ إِذَا عَدَتْ شَهْبَاءُ",6,"ا",2,0],["الطاعِنُ الطَعنَةَ النَجلاءَ جائِشَةً","تَرُدُّ طاعِنَها عَنها بِتَيّارِ",7,"ر",1,0],["أَلطَّالِبِينَ مِنَ المَظِنَّا","تِ الْحَقِيقةَ وَالصَّوَابَا",8,"ب",2,0],["الطَّاهِرِ الشَّيْمَةِ الصِّدِّيقِ في زَمَنٍ","وُجُودُ أَمْثَالِهِ فِيهِ مِنَ الْعَجَبِ",9,"ب",1,0],["ألطائر العالي مراده","ماذا يجشمه مراده",10,"د",2,1],["أَلطِّيْبُ فِي نَفَحَاتِ الرَّوْضِ حَيَّانِي","وَأُنْسُكُمْ يَا كِرَامَ الحَيِّ أَحْيَانِي",11,"ن",2,1],["الطَيِّبونَ مِنَ الرَيحانِ مَنبِتُهُم","وَمَنبِتُ التَيمِ في الكُرّاثِ وَالثومِ",12,"م",1,0],["الطيبو ترب المغار","س والمنابت والمكاسر",13,"ر",1,0],["الطرف في ذاك الجبين منعّمٌ","والقلب من ذاك التجّنب صالي",14,"ل",2,0],["الطاعنين وحرّ الحرب ملتهب","والمطعمين وحرّ الجدب ملتهم",15,"م",1,0],["الطَّرْفُ يقْطِفُ من خدَّيْكَ تُفَّاحَا","والثَّغْرُ منك يَمُجُّ المسْكَ والرَّاحا",16,"ح",2,1],["ألطفها من صبا إليها","ببيضَتَيه على سطيره",17,"ر",2,0],["الطَودُ يَقرَءُ في السَماءِ الصافِيَه","سَفراً جَميلٌ مَتنُهُ وَالحاشِيَه",18,"ه",1,0],["الطَيرُ إِن عَطِشَت وَلَجَّ بِها الظَما","هَبَطَت إِلى الأَنهارِ مِن عَلوِ السَما",18,"ا",1,0],["الطَلُّ فيها كَدُموعِ الدَلال","وَالشَوكُ فيها كَحَديثِ الغُرور",19,"ر",1,0],["الطَيرُ تُغَنّي لِلزَهرِ","وَيَظُنُّ الطَيرَ تُساجِلُهُ",20,"ه",1,0],["الطائرات وتلكم من مراكبهم","كأنها في عنان الجو عقبان",21,"ن",1,0],["الطير فوق الدوح يخطب ثائراً","فيرج منه المنبر الفينان",22,"ن",1,0],["الطفل يحبو إليك حبا","والشيخ يمشى لك انحناء",23,"ا",2,0],["الطير فيها مستطي","ر الروع والحيوان عائر",24,"ر",1,0],["الطالعات ولا أقول فراقدا","حذر العيون ولا أقول نجوما",25,"م",2,0],["الطَيبُ اِبنُ الطَيِّبينَ وَرُبَّما","نَضَحَ الفَتى فَأَبانَ عَن أَحسابِه",26,"ب",2,0],["الطاهِراتُ اللَحظِ أَمثالَ المَها","الناطِقاتُ الجَرسِ كَالأَوتارِ",27,"ر",1,0],["الطَيبُ مِمّا غَنيتُ عَنهُ","كَفى بِقُربِ الأَميرِ طيبا",28,"ب",2,1],["الطيبُ أَنتَ إِذا أَصابَكَ طيبُهُ","وَالماءُ أَنتَ إِذا اِغتَسَلتَ الغاسِلُ",29,"ل",1,0],["الطَّاهِريينَ همُ الأُلى شَرعُوا","للناس دينَ الجُودِ والبَأْسِ",30,"س",1,0],["أَلَطَّت بِهِ الحُمى ثَلاثاً وَوَدُّها","لَوَ اَنَّ وَشيكَ البُرءِ أَمهَلَ عاجِلُه",31,"ل",2,0],["الطاعِنِ الطَعنَةَ النَجلاءَ قَد حَجَزَت","عَنها بِصَدرِ قَناةِ الرُمحِ مَن حانا",32,"ن",2,0],["الطاهِرُ الشِيَمُ اِبنُ الطاهِرِ الشِيَمِ اِب","نِ الطاهِرِ الشِيَمِ اِبنِ الطاهِرِ الشِيَمِ",33,"م",1,0],["الطفل منهم مثل أمي أو أبي","شفتاه أول ما تقول بلادي",34,"د",2,0],["ألطفُ مِنْ أزاهِرِ الرياضِ","وماءِ مزنةٍ على رضراضِ",35,"ض",1,0],["الطرفُ ساهٍ ساهرٌ","والدمعُ وافٍ وافرُ",36,"ر",1,1],["الطالحاتُ فما يبعثْنَ صالحةً","ولا يُبعثرْنَ إلاّ كلَّ مأفون",37,"ن",1,0],["الطّاهرونَ كأنهمْ ماءُ السّما","لم يَلْتَصِقْ دَرَنٌّ بِهِمْ وعيوب",38,"ب",1,0],["الطالِعاتِ عَلى الصَباحِ حَنادِساً","السارِياتِ مَعَ الظَلامِ دراريا",39,"ي",2,0],["الطّالِعينَ بهِ على أعدائهِ","مَوْتاً إذا نشروا الجُنودَ طَواها",40,"ا",3,0],["الطَريقَ الطَريقَ يا كُلَّ عَيني","إِنَّ عَيني تُريدُ وَجهَ الحَبيبِ",41,"ب",1,0],["الطّالبانِ المشْرَفِيّةُ والقَنَا","والمُدرِكانِ النّصْرُ والتّمكين",42,"ن",1,0],["الطّاعِنُ الأُسْدِ في أشداقِها هَرَتٌ","والقائِدُ الخيْلِ في أقرابِها لَحَق",43,"ق",1,0],["الطائرات السّابحات السّابقا","ت الناجيات إذا استُحِثّ نَجاء",44,"ا",2,0],["أَلطَفَ الصَنعَةَ حَتّى","لا تَرى مِغرَزَ إِشفى",45,"ف",2,0],["الطُرقُ مُقبِلَةٌ وَمُدبِرَةٌ","هَوِّن عَلَيكَ لِأَيِّها رَكَبا",46,"ب",2,0],["الطاعِنُ الطَعنَةَ يَومَ الوَغى","يَنهَلُ مِنها الأَسَلُ الناهِلُ",47,"ل",1,1],["الطاعِنينَ وَغَيثُ الرَكبِ مُنسَكِبٌ","إِذا اِزدَهى الجَريُ أَشباحَ الضَغابيسِ",48,"س",1,0],["أَلطِف بِهِ زارَ آقِطَي رَهَجٍ","ما شَعَروا كَيفَ صَنعَةُ الأَقَطِ",49,"ط",1,0],["الطَيلَسانُ اِشتُقَّ في لَفظِهِ","مِن طُلسَةِ المُبتَكِرِ الجامِعِ",50,"ع",1,1],["الطَبعُ شَيئٌ قَديمٌ لا يُحَسُّ بِهِ","وَعادَةُ المَرءِ تُدعى طَبعَهُ الثاني",51,"ي",1,1],["الطّاهرُ الآباءِ والأبناءِ وال","أثوابِ والآرابِ والأُلاّفِ",52,"ف",1,0],["الطعامُ الزقومُ في كل يومٍ","والشراب اليحمومُ واليحمور",53,"ر",1,0],["الطالِعات من النجو","م شبيهة بالغاربات",54,"ت",1,0],["الطاهِرَينِ وَإِخوَةً أَنجَبتَهُم","كَالحَومِ وُجِّهَ صادِراً أَو ناهِلا",55,"ل",2,0],["الطارِحِينَ لخوْضِ الموْتِ لامَهُمُ","سَحْبَ الأجِلّة خَلْفَ الضُّمَّرِ الشُّمُسِ",56,"س",1,0],["الطَّاعِمُونَ الطَّاعِنُو","نَ الْقَائِلُونَ بِكُلِّ نَادِي",57,"د",2,0],["أَلطَّيِّبُ المَحْمُودُ مِنْ عُمْرِي مَضَى","وَالْمُفْتَدَى بالروحِ مِنْ خُلَصَائِي",58,"ا",2,0],["الطِّفْلَةُ الملك الَّتي مِنْ مَهْدِهَا","نَظَرَتْ إلى المَحْرُومِ وَالمَحْرُوبِ",59,"ب",1,0],["أَلطَّائِرُ العَالِي مَرَادُهُ","مَاذَا يُجَثِّمُهُ مُرَادُهْ",60,"د",2,1],["أَلطِّبُّ مِنْ إِبْدَاءِ مِصْرَ فَيَا لَهُ","فَتْحاً أَفَاضَ عَلَى الْغُرُوبِ شُرُوقَا",61,"ق",2,0],["أَلطَّيِّبِ النَّفَّسِ الكَريمِ بِمَالِهِ","فِي ضِنَّةٍ مِنْ أَنْفُسِ الكُرَمَاءِ",62,"ا",2,0],["ألطرب السمح إذا دارت طلا","أو سبق فالشاعر المغبر",63,"ر",1,0],["أَلطَفُ في روحِ الفَتى","مِن روحِهِ في جِسمِهِ",64,"م",2,0],["الطُّموحُ الحياةُ والمجدُ في الدّن","يا مُبَاحٌ لِطالِبي قَصبَاتهْ",65,"ت",2,0],["الطير ملء الروض أشكالاً فما","للسهم لا يُصمي سوى كروانه",66,"ن",2,0],["الطالباتُ كما تََ","يْنَ وأنتِ ذُخْرُ الطالبات",67,"ت",1,0],["الطيرُ للرياض، والغُصونِ","لا للببابِ الفقرِ، والسجوني",68,"ن",2,0],["الطير يسجع إن هاجت بلابله","والركب يحدوه في البيداء حاديه",69,"ي",2,0],["الطبيبُ الذي تَمثَّلَ «جالي","نوسُ» حَيًّا في شخصه «وابن سينا»",70,"ن",2,0],["الطيرُ تهتف فيه والْ","غدران في همسٍ تجيب",71,"ب",1,0],["الطيرُ يهتفُ فيه فوقَ غُصونه","فتُجيبُ وسوسةُ النَّمير الجاري",72,"ر",2,0],["الطيرُ والأيكُ أين غابا؟","لينتفضْ عنهما الغبار",73,"ر",1,0],["الطير يصدح، والغدران هامسةٌ","المطربان هما: طيرٌ، وغدران",74,"ن",1,0],["الطعنة النجلاءُ تحكي عندهم","طَرْفًا غضيضًا جفنُهُ مكحولا",75,"ل",2,0],["الطير ملءُ الروض أشكالاً، فينبري","لمكانه لا يُصْمِي سوى كروانه؟",76,"ن",2,0],["الطِّيب في أحقاقه","متجردٌّ من عطره",77,"ر",2,0],["الطفلُ يرضعُ من أخلاقِ مُرضعهِ","قبل اللِّبانِ التي تنصبُّ في فيه",78,"ي",2,0],["الطيوف الحمر ، والخضر على","مقلتيه ، كنعاقيد البلح",79,"ح",1,0],["الطايش اللّي محتمينه ما قووه","كل العيون اللي تحبّه .؟ باعته",80,"ت",2,1],["الطّود يقرأ في السّماء الصّافيه","سفرا ، جميل متنه والحاشيه",81,"ه",1,0],["الطالباتُ كما تَرَ","يْنَ وأنتِ ذُخْرُ الطالبات",82,"ت",1,0],["(الطّقس رديء ث