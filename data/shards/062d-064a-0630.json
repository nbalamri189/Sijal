{"poems":[[318,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[347,"أنشد الشعر وحي الشهداء","https://www.aldiwan.net/poem55389.html","الرمل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53733","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126867","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108290","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100665","الرمل"],[5732,"ابيه يرحمني","https://www.poetsgate.com/ViewPoem.aspx?id=177905",""]],"verses":[["حي ذا الدار تؤم مغرق","فإذا مات أطار الوسنا",0,"ن",2,0],["حيّ ذكراهم وقف في حيهم","وتخيلهم صباحاً ومساء",1,"ا",2,0],["حَيِّ ذا الزور وانهه أنْ يعودا","إنَّ بالباب حارسين قعودا",2,"د",2,0],["حيّ ذا الفضل والندا والمكارم","وحليف الفخارِ والمجد هاشم",3,"م",1,1],["حي ذاك النضار والميع في","الأزهار تعلوه نفحة ذفريه",4,"ي",2,0],["حيّ ذاك التراب يا أيها الوس","مي صباًّ ويا وليُّ السجيما",5,"م",2,0],["حيّ ذاك المحلّ من حيّ نعم","طاب ما كان بالنعيم محلّا",6,"ل",2,0],["حيِ ذاك الحيَّ يا ريح الصبا","وأهيل الحي عني والصبا",7,"ب",2,1],["حي ذرف دمعه لزينات الالحان","ارخصت له يا عمير قلبي سباله",8,"ل",2,0]]}