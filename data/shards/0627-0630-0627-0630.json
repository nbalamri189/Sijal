m52829.html","البسيط"],[576,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[587,"ترى يا جيرة الشعب","https://www.aldiwan.net/poem17973.html","مجزوء الوافر"]],"verses":[["إذا ذكر الغدير عراه شوقٌ","لصنع فضيلةٍ والحال يآبى",0,"ب",2,0],["إِذا ذُكِرَ الصَوارِمُ وَالعَوالي","تَعَوَّذَ بِالمَثالِثِ وَالمَثاني",1,"ن",2,0],["إِذا ذُبولُ الشِفاهِ شَمَّرَها","في الغَمَراتِ الحِفاظُ وَالسَأَمُ",2,"م",1,0],["إِذا ذَكَروا الوِترَ حَزّوا الرِقابَ","وَإِن ذَكَروا العَفوَ جَزّوا اللِماما",3,"م",2,0],["إِذا ذُكِرَ اِسمُهُ اِرتَجَّت","أَو اِرتَعَدَت مَنابِرُه",4,"ر",2,0],["إِذا ذَكَروهُ لِلخِلافَةِ لَم تَزَل","تَطَلَّعُ مِن شَوقٍ رِقابُ المَنابِرِ",5,"ر",1,0],["إِذا ذَكَرَتكَ عَلى وِنيَةٍ","رَأَيتَ ذَفاريَّها تَنضَحُ",6,"ح",1,0],["إِذا ذَعَرَتهُم نَبأَةٌ غادَرَتهُمُ","وَقَد أَيقَظوا مِن بَينِ أَجفانِها القُضبا",7,"ب",2,0],["إِذا ذَكَرَتْها النَّفسُ باتَت كَأَنَّها","عَلى حَدِّ سَيفٍ بَينَ جَنبيَّ يُنتَضى",8,"ض",2,0],["إِذا ذَكَرتُ بِها نَجداً وَساكِنَهُ","وَضَعتُ حُبوَةَ حِلمي في يَدِ الطَرَبِ",9,"ب",1,0],["إِذا ذُكِرَ المَجْدُ التَّليدُ تَلَفَّتَتْ","إِليهِ بِعَيْنَيْ ثاكِلٍ وَأَرَنَّتِ",10,"ت",1,0],["إذا ذُكِرَتْ آلُ ابنِ عفّانَ أجْهَشَتْ","حُزونٌ ورنّتْ بالحِجازِ سُهولُ",11,"ل",1,0],["إذا ذلَّتْ حَياتُكَ في مَكانٍ","فَمُتْ لطِلابِ عِزِّكَ في مَكانِ",12,"ن",1,0],["إذا ذَكَروهُ أضْمَرَ العُجْمُ إحْنَةً","عليهمْ وأصْلى جَمْرَةَ الحَسَدِ العُرْبا",13,"ب",2,0],["إذا ذَكرْناه هَزَّ الرُّمْحَ عامِلَهُ","والسّيفُ مُبتَسِمٌ والبأسُ مَشهودُ",14,"د",1,0],["إِذا ذُكِرَ الفَخارُ بِأَرضِ قَومٍ","فَضَربُ السَيفِ في الهَيجاءِ فَخري",15,"ر",2,0],["إِذا ذَكَرَتكِ العَينُ يَوماً تَبادَرَت","دُموعي عَلى الخَدَّينِ تَجري بِأَربَعِ",16,"ع",1,0],["إِذا ذَرَفَت عَيني لِحَرِّ مُصيبَةٍ","تَمَثَّلتُ قَولَ المُبتَلى بِالمَصائِبِ",17,"ب",1,0],["إِذا ذُكِرَت لُبنى تَجَلَّتكَ زَفرَةٌ","وَيَثني لَكَ لداعي بِها فَتَفيقُ",18,"ق",1,1],["إِذا ذُكِرَت لُبنى تَأَوَّهَ وَاِشتَكى","تَأَوُّهَ مَحمومٍ عَلَيهِ البَلابِلُ",19,"ل",1,1],["إذا ذُكِرَ الأمْلاكُ يوْماً فيوسُفٌ","لِما شِئْتَ منْ جُودٍ وما شِئْتَ منْ عطْفِ",20,"ف",1,0],["إِذّا ذُكِرَ الْعَلاَءُ فَأَنْتَ أَعْلَى","وَإِنْ ذُكِرَ السَّنَاءُ فَأَنْتَ أَسْنَى",21,"ن",2,0],["إذا ذُكِرَ الإغْضاءُ والحِلْمُ والتُّقى","وحدّثْتَ عنْ عَلْياهُ حدِّثْ عنِ البَحْرِ",22,"ر",1,0],["إِذَا ذَهَبَتْ يَمِينُكَ لاَ تُضَيِّعْ","زَمَانَكَ فِي الْبُكَاءِ عَلَى الْمُصِيبَهْ",23,"ب",2,1],["إذا ذكر الحُجَّابُ في كُلِّ مَشهَدٍ","وَأَمْلاَكُهُمْ مِنْ كُلِّ هَادٍ ومُهْتَدِي",24,"ي",1,0],["إِذَا ذُكِرَ الأَمْلاَكُ مَنْ مِثْلُ يُوسُفٍ","يُسَالِمُ فِي ذَاتِ الْهُدَى وَيُحَارِبُ",25,"ب",1,0],["إِذا ذُكِرَت سِيَرُ النابِهينَ","فَسيرَةُ صَبري تَجُبُّ السِيَر",26,"ر",1,0],["إِذا ذَكَروا مِنهُ النَسيبَ رَأَيتَنا","وَداعي الهَوى مِنّا أَقامَ وَأَقعَدا",27,"د",2,0],["إِذا ذُقتُ فاهاً قُلتُ طَعمُ مُدامَةٍ","مُعَتَّقَةٍ مِمّا تَجيءُ بِهِ التُجُر",28,"ر",1,0],["إِذا ذَرَّ قَرنُ الشَمسِ مالَت طُلاهُمُ","عَلَيها وَأَلقَوا كُلَّ سَوطٍ وَمِحجَنِ",29,"ن",1,0],["إِذا ذَرَفَت عَينايَ أَعتَلُّ بالقَذى","وَعَزَّةُ لَو يَدري الطَبيبُ قَذاهُما",30,"م",2,0],["إِذا ذُكِرَت لَيلى تَغَشَّتكَ عَبرَةٌ","تُعَلُّ بِها العَينانِ بَعدَ نُهولِ",31,"ل",1,0],["إِذا ذَكَرتها النَفسُ ظَلَّت كَأَنَّها","عَلَيها مِنَ الوَردِ التَهامِيِّ أَفكَلُ",32,"ل",1,0],["إِذا ذَكَرَتها النَفسُ جُنَّت بِذِكرِها","وَريعَت وَحَنَّت وَاِستَخَفَّ جَليدُها",33,"د",3,0],["إِذا ذَكَرَ الناسُ السَماحَ مِنِ اِمرِئٍ","وَأَكرَمَ أَو قالَ الصَوابَ خَطيبُ",34,"ب",1,0],["إِذا ذَكَرَت نَفسي نَداهُ وَبَأسَهُ","تَحَسَّرَ عَنها كُلُّ عَيشٍ وَأَنعُمِ",35,"م",1,0],["إِذا ذُكِروا يَوماً وَقَد صِرتَ رابِعاً","ذُكِرتَ بِقَدرِ السَعيِ مِنكَ إِلى الفَضلِ",36,"ل",1,0],["إِذا ذَكَروا قَتلى بِبَدرٍ وَخَيبَرٍ","وَيَومِ حُنَينٍ أَسبَلوا العَبَراتِ",37,"ت",1,0],["إِذا ذابَتِ الشَمسُ اِتَّقى صَقَراتِها","بِأَفنانِ مَربوعِ الصَريمَةِ مُعبِلِ",38,"ل",1,0],["إِذا ذَكَرتكَ النَفسُ مَيّاً فَقلُ لَها","أَفيقي فَأَيهات الهَوى مِن مَزارِكِ",39,"ك",1,0],["إِذا ذُكِرَ الأَقوامُ فَاِذكُر بِمِدحَةٍ","بِلالا أَخاكَ الأَشعرَيَّ أَبا عَمرِو",40,"ر",2,0],["إِذا ذاتُ أَهوالٍ ثَكولٌ تَلَوَّنَت","بِها العِينُ فوضى وَالنَعامُ السَوارِحُ",41,"ح",1,0],["إذا ذكر الورى جشعاً وحرصاً","ف شرشل أكبر المتجشّعينا",42,"ن",2,0],["إذا ذكروا سُماك ولو مَناماً","تحامَوْا ذكره بسوى التهجّي",43,"ج",2,0],["إذا ذُكر الهُبوط فأنت مُعلٍ","وإن خِيف الحُبوط فأنت منج",43,"ج",1,0],["إذا ذُكر العراق بكَيْت شجواً","بدمع طمّ سائله القَرِيّا",44,"ر",3,0],["إذا ذكرناك يوماً في محافلنا","قمنا لذكراك تعظيماً وإجلالا",45,"ل",2,0],["إِذا ذُكِرَت لَيلى أُتيحَ لِيَ الهَوى","عَلى ما تَرى مِن هِجرَتي وَاجتِنابِيا",46,"ي",2,0],["إِذا ذُكِرَت مَساعينا غَضِبتُم","أَطالَ اللَهُ سُخطَكُمُ عَلَينا",47,"ن",2,0],["إِذا ذُكِرَت لِلقَلبِ كادَ لِذِكرِها","يَطيرُ إِلَيها وَاِعتَراهُ عَذابُها",48,"ب",3,0],["إِذا ذَكَرَت زَيداً تَرَقرَقَ دَمعُها","بِمَطروفَةِ العَينَينِ شَوساءَ طامِحِ",49,"ح",1,1],["إِذا ذَكَرَت لَيلى جُبَيراً تَعَصَّرَت","وَلَيسَ بِشافٍ دائَها أَن تَعَصَّرا",50,"ر",2,0],["إِذا ذَكَرَت نَفسي شَريكاً تَقَطَّعَت","عَلى مَضرَحِيٍّ لِلمَقامَةِ رائِسِ",51,"س",1,1],["إِذا ذُكِرَت شَعثاءُ طارَ فُؤادُهُ","لِطَيرِ الهَوى وَاِرفَضَّتِ العَينُ تَدمَعُ",52,"ع",1,0],["إِذا ذُقتَ مِنّي طَعمَ حَربٍ مَريرَةٍ","عَطَفتُ عَلَيكَ الحَربَ وَالحَربُ تُعطَفُ",53,"ف",1,0],["إِذا ذُكِرَت هِندٌ لَهُ خَفَّ حِلمُهُ","وَجادَت دُموعُ العَينِ سَحّاً سُجومُها",54,"م",3,0],["إذا ذات وَدقين هاب الرُقا","ةُ أن يصلحوها وأن يسمُلُوا",55,"ل",3,1],["إِذا ذُكِرَت يَوماً غَطاريفُ وائِلٍ","فَنَحنُ أَعاليها وَنَحنُ الجَماهِرُ",56,"ر",1,0],["إِذا ذَكَرَ الحَيَّ المُقيمَ حُلولُهُم","وَأَبصَرَ ما يَلقى اِستَهَلَّت مَدامِعُه",57,"ع",2,0],["إِذا ذُكِرَت قَهقاءُ حَنّوا لِذِكرِها","وَلِلرَمَثِ المَقرونِ وَالسَمَكِ الرُقطِ",58,"ط",1,0],["إِذا ذُكِرَت عَقيلَةُ بِالمَخازي","تَقَنَّعَ مِن مَخازيها اللِئامُ",59,"م",1,1],["إذا ذُكرت أهل السيادة والعلى","فعدّ ابن فضل الله فاتحةَ الذكر",60,"ر",1,0],["إذا ذكرت أقلامهم وسيوفهم","فناهيك بالحمر الرَّواعف والسمر",60,"ر",1,0],["إذا ذكرناه فاح العطر أجمعه","فكلنا فيه عطارُ ابن عطار",61,"ر",1,0],["إذا ذكروا الركنَ اليمانيَّ يمَّموا","مواهب ركنٍ للعفاة شآم",62,"م",1,0],["إِذا ذَكَرتُكَ كادَ الشَوقُ يُقلِقُني","وَغَفلَتي عَنكَ أَحزانٌ وَأَوجاعُ",63,"ع",1,1],["إذا ذَكرتْ أياديَها نفوس","أفاقت من مُعالجة الكروبِ",64,"ب",1,0],["إذا ذل في الدنيا الأعزةُ واكتستْ","أذلَّتُها عزَّاً وسادَ مَسودُها",65,"د",3,0],["إذا ذكر استغشاءه النومَ آمناً","جرت مقلتاه بالدموع الحواشدِ",66,"د",1,0],["إذا ذُكرتْ لم يكن ذِكرها","بأيسر نتناً من المَنْبَش",67,"ش",1,0],["إذا ذكروا أوطانَهُم ذكَّرتهمُ","عُهودَ الصبا فيها فحنّوا لذلكا",68,"ك",2,0],["إِذا ذَكَرَت قَتلى بِكَوساءَ أَشعَلَت","كَواهِيَةِ الأَخراتِ رَثٍّ صُنوعُها",69,"ع",3,0],["إِذا ذَكَرَت أَنيابَها أُمُّ هَيثَمٍ","رَغَت جَيأَلٌ مَخطومَةٌ بِضَفيرِ",70,"ر",1,0],["إِذا ذادَ عَن ماءِ الفُراتِ فَلَن تَرى","أَخا قِربَةٍ يَسقي أَخاً بِصَميلِ",71,"ل",1,0],["إِذا ذُكِرَ النِساءُ بِيَومِ خَيرٍ","فَنامي أُمَّ زَنبَ وَلا تُراعي",72,"ي",1,1],["إِذا ذُكِرَ الشَآمُ بَكَيتَ وَجداً","وَما تَنفَكُّ تَذَّكَّرُ الشَآما",73,"م",2,0],["إِذا ذُكِرَت في الحَيِّ أَصبَحَ آيِساً","فَرَزدَقُها مِن وَصلِها وَجَريرُها",74,"ر",3,0],["إِذا ذُقتَ فاها قُلتَ طَعمَ مُدامَةٍ","دَنا الزِقُّ حَتّى مَجَّها وَهوَ جانِحُ",75,"ح",1,0],["إذا ذكرتكَ النفس جاشت صبابة","وفار عليها من غرامك مِرجل",76,"ل",1,0],["إذا ذكروا عَهْدَ الشّآمِ اسْتَعادَني","إلى مَنْ بأَكْنافِ الشّآمِ حَنينُ",77,"ن",1,0],["إِذا ذُكِرَت مَواقِفُهُ لِحافٍ","وَشيكَ فَما يُنَكِّسُ لِاِنتِقاشِ",78,"ش",1,0],["إِذا ذَرَّتْ عليها المِسْكَ ريحٌ","رَخَاءٌ نفَّضَتْه يَدُ الغَوادي",79,"د",2,0],["إِذا ذَهَبا هَذانِ مِنّي بِلَذَّتي","فَما أَنا في الدُنيا لِعَيشٍ بِصاحِبِ",80,"ب",1,0],["إِذا ذَهَبَت أَموالُهُ نَحوَ أَوجُهٍ","مِنَ البَذلِ جاءَت مِن وُجوهٍ مَحامِدُه",81,"د",2,0],["إِذا ذُكِرَت أَسلافُهُ وَتُشوهِرَت","أَماكِنُها قُلتَ النُجومُ قُبورُها",82,"ر",3,0],["إِذا ذو العَقلِ أَعطى النُصحَ مِنهُ","عَديمَ العَقلِ ضَيَّعَهُ فَضاعا",83,"ع",2,0],["إِذا ذُكِروا بِشُهرَةِ يَومِ فَخرٍ","تَناسَبَتِ النَباهَةُ وَالخُمولُ",84,"ل",1,0],["إِذا ذَكَرَتكِ النَفسُ شَوقاً تَتابَعَت","لِذِكراكِ أُحدانُ الدُموعِ وَتومُها",85,"م",3,0],["إِذا ذَهَبَت شَرقاً وَغَرباً فَأَمعَنَت","تَبَيَّنتَ مَن تَزكو لَدَيهِ الصَنائِعُ",86,"ع",1,0],["إِذا ذُكِّرَت نَفسي اِبنَ مَروانَ صاحِبي","وَمَروانَ فاضَت ماءَ عَيني غُروبُها",87,"ب",3,0],["إِذا ذَكَرَت عُيونُهُمُ اِبنَ أَروى","وَيَومَ الدارِ أَسهَلَتِ اِنسِكابا",88,"ب",2,0],["إِذا ذَكَرَت عَيني سَعيداً تَحَدَّرَت","عَلى عَبَراتٍ يَستَهِلُّ اِنسِكابُها",89,"ب",3,0],["إِذا ذَكَرَتهُ العَينُ يَوماً تَحَدَّرَت","عَلى الخَدِّ أَمثالَ الجُمانِ المُفَرَّدِ",90,"د",1,0],["إِذا ذُكِرَت أَيدي الكِرامِ إِلى النَدى","وَآثارُها ذَمَّت يَدَيهِ مَعاشِرُه",91,"ر",2,0],["إِذا ذُكِرَت نَوارُ لَهُ اِستَهَلَّت","مَدامِعُ مُسبِلِ العَبَراتِ جارِ",92,"ر",1,0],["إِذا ذَكَرَت زَوجاً لَها جَعفَرِيَّةٌ","وَمَصرَعَ قَتلى لَم تُقَتَّل ثُؤورُها",93,"ر",3,0],["إِذا ذُكِرَت أَيّامُهُم يَومَ لَم يَقُم","لِسَلَّةِ أَسيافِ الضَبابِ نَفيرُها",93,"ر",3,0],["إِذا ذَكَرَت نَفسي زِياداً تَكَمَّشَت","مِنَ الخَوفِ أَحشائي وَذابَت مَفارِقي",94,"ق",2,0],["إِذا ذَكَرَت نَفسي يَدَيكَ نَزَت بِها","كَراسيعُ زالَت وَالقَطيعُ المُحَرَّمُ",95,"م",1,0],["إِذا ذُكِرَت أَسمائُهُم أَو دُعوا بِها","تَكادُ حَيازيمي تَفَرّى صِلابُها",96,"ب",3,0],["إِذا ذَكَرَت عَيني الَّذينَ هُمُ لَها","قَذىً هيجَ مِنها لِلبُكاءِ اِنسِكابُها",96,"ب",3,0],["إذا ذُكِرَ العقِيقُ لنا نَثَرنا","عَقِيقَ الدّمعِ سَحّاً وانهمالا",97,"ل",2,0],["إِذا ذَكَرنا زَماناً كانَ يُدرِكُنا","بِالقُربِ مِنكُم وَفي اللَذّاتِ يُشرِكُنا",98,"ن",2,0],["إِذا ذَكَرتُ حِمى العاصي وَمَلعَبِهِ","وَالقَصرَ وَالقُبَّةَ العُليا بِمَرقَبِهِ",98,"ه",1,0],["إِذا ذَمَّهُ الأَعداءُ قالوا مُفَرِّطٌ","وَإِن بالَغوا بِالذَمِّ قالوا مُبَذِّرُ",99,"ر",1,0],["إذا ذكرتهُ الحمائمُ أنَّ","وإن ضاحكته الربى صفَّقَا",100,"ق",2,0],["إِذا ذاقَها وَهيَ الحَياةُ رَأَيتَهُ","يُعَبِّسُ تَعبيسَ المُقَدَّمِ لِلقَتلِ",101,"ل",1,0],["إِذَا ذَكَرَتْهَا النَّفْسُ يَوْمَاً تَرَاجَعَتْ","عَلَيْهَا عَقَابِيلُ الْهُمُومِ الْقَدَائِمِ",102,"م",1,0],["إِذَا ذَهَبَ الْكِرَامُ فَلا رَجَاءٌ","وَإِنْ ذَهَبَ الرَّجَاءُ فَلَيْسَ فَضْلُ",103,"ل",1,0],["إذا ذهبتْ بالطلا","فقد طُليتْ بالذهبْ",104,"ب",1,0],["إِذا ذُكِرَت لَيلى أَإِنُّ لِذِكرِها","كَما أَنَّ بَينَ العائِداتِ سَقيمُ",105,"م",1,0],["إِذا ذَكَرَتها النَفسُ ماتَت صَبابَةً","لَها زَفرَةٌ قَتّالَةٌ وَشَهيقُ",106,"ق",1,0],["إِذا ذُكِرَت لَيلى أُهيمُ لِذِكرِها","وَكانَت مُنى نَفسي وَكُنتُ لَها أَرضى",107,"ض",2,0],["إِذا ذُكِرَت يَرتاحُ قَلبي لِذِكرِها","كَما اِنتَفَضَ العَصفورُ بُلِّلَ مِن قَطرِ",108,"ر",1,0],["إِذا ذُكِرَت لَيلى أُسَرُّ بِذِكرِها","كَما اِنتَفَضَ العُصفورُ مِن بَلَلِ القَطرِ",109,"ر",1,0],["إِذا ذُكِرَت لَيلى بَكَيتُ صَبابَةً","لِتَذكارِها حَتّى يَبُلَّ البُكا الخَدا",110,"د",2,0],["إِذا ذَكَرَت نَجداً وَطيبَ تُرابِهِ","وَخَيمَةَ نَجدٍ أَعوَلَت وَأَرَنَّتِ",111,"ت",1,0],["إِذا ذَكَرَت ماءَ الفَضاءِ وَخَيمَةً","وَبَردِ الضُحى مِن نَحوِ نَجدَ أَرَنَّتِ",111,"ت",1,0],["إِذا ذُكِرَت لَيلى عَقَلتُ وَراجَعَت","رَوائِعُ قَلبي مِن هَوىً مُتَشَعِّبِ",112,"ب",1,0],["إذا ذكروا الزَّعامةَ فهي دعوى","يكيدُ بها الكنانةَ مَن يكيدُ",113,"د",1,0],["إذا ذاقهُ في غمرةِ الحربِ قَرْنُه","تنكَّبَ يلوِي أخْدَعَيْهِ ويزوَرُّ",114,"ر",1,0],["إذا ذُكِرَتْ مَنَاقِبُهُ الغوالي","تَعَالتْ أُمَّةٌ واعتزَّ جيلُ",115,"ل",1,0],["إِذا ذُكِرَت مَسعاةُ والِدِهِ اِضطَنا","وَما يَضطَني مِن شَتمِ أَهلِ الفَضائِلِ",116,"ل",1,0],["إِذا ذُكِرَت سَلمى لَهُ فَكَأَنَّما","يُغَلغِلُ طِفلٌ في الفُؤادِ وَجيعُ",117,"ع",1,0],["إِذا ذَكرَ النَخلَ أَربابُها","وَقالوا مُبَكِّرُها المُبلِحُ",118,"ح",1,0],["إِذا ذَهَبَ الشَبابُ فَبانَ مِنهُ","فَلَيسَ لِما مَضى مِنهُ لِقاءُ",119,"ا",2,0],["إِذا ذُكِرَت لَكَ الحاجاتُ مِنّي","فَلا حَصِرٌ بِهِنَّ وَلا بَخيلُ",120,"ل",1,0],["إِذا ذُقتَ فاها قُلتَ طَعمَ مُدامَةٍ","بِنُطفَةِ جَونٍ سالَ مِنهُ الأَباطِحُ",121,"ح",1,0],["إذا ذكرَتْهُ النفسُ جاشتْ لذكرهِ","كما عثَرَ السّاقي بكأسٍ من الخمر",122,"ر",1,0],["إذا ذكروا آثارَ سيفك فيهمُ","فلا القَطر معدودٌ ولا الرّمل محسوب",123,"ب",1,0],["إِذا ذاقَها مَن ذاقَها حَلَّقَت بِهِ","فَلَيسَ لَهُ عَقلٌ يُعَدُّ أَديبُ",124,"ب",1,0],["إِذا ذَكَرَ الفِراقَ بَكى","وَإِن غَفَلَ الرَقيبُ شَكا",125,"ك",2,1],["إِذا ذاقَها شُرّابُها بَجَّلوا لَها","بِأَلسُنِهِم شُكراً فَهُم عَرَبٌ عُجمُ",126,"م",1,0],["إِذا ذَكَراني أَطرَقا مِن جَلالَتي","وَقالا كَريمٌ شانَ رُمحَ اِستِهِ صِغَر",127,"ر",1,0],["إِذا ذُكِرَ النابي تَلَمَّطَتِ اِستُهُ","وَبَرَّقَ عَينَيهِ لِوِردٍ مَتى يَرِد",128,"د",1,0],["إِذا ذُكِرَت سَبَقَت عَبرَتي","وَكادَت لَها كَبِدي تَقرَحُ",129,"ح",1,0],["إِذا ذُكِروا في مَأقِطٍ أَطرَقَ العِدى","وَرَنَّحَ فَحلُ القَريَتَينِ المُقَبقِبُ",130,"ب",1,0],["إِذا ذَكَرتُ اِمرَأً يَبيتُ عَلى ال","حَمدِ رَكِبنا العادِيَّةَ الرُكَبا",131,"ب",2,0],["إِذا ذادَ عَنهُ عَقرَباً مِن هَواكُمُ","بِرُقيَتِهِ دَبَّت لَهُ مِنكِ عَقرَبُ",132,"ب",1,0],["إِذا ذُكِرَ الحِبابُ بِها أَضَرَّت","بِها عَينٌ تَضَرُّ عَلى الحِبابِ",133,"ب",1,0],["إِذا ذُكِرَت صَفراءُ أَذرَيتُ عَبرَةً","وَأَمسَكتُ نَفسي رَهبَةً أَن تَصَبَّبا",134,"ب",2,0],["إِذا ذُكِرَت دارَ الهَوى بِمَسامِعي","كَما دارَت الصَهباءُ في رَأسِ شارِبِ",135,"ب",1,0],["إِذا ذَكَروا المَخلوقَ عابوا وَأَطنَبوا","وَإِن ذَكَروا الخَلّاقَ حابوا وَأَشرَكوا",136,"ك",3,0],["إِذا ذَكَرَت يَوماً مِنَ الدَهرِ شَجوَها","عَلى فَرعِ ساقٍ أَذرَتِ الدَمعَ سافِكا",137,"ك",2,0],["إِذا ذُقتَ فاها قُلتَ طَعمُ مُدامَةٍ","مُشَعشَعَةٍ تُرخي الإِزارَ قَديحُ",138,"ح",1,0],["إذَا ذَكَرَ السَعدِيُّ فَخراً فَقُل لَهُ","تَأَخَّر فَلَم يَجعَل لَكَ اللَهُ مَفخَرا",139,"ر",2,0],["إذا ذكرتُكَ يوماً قلت واحَزَنا","وما يَرُدُّ عليكَ القولُ واحَزَنا",140,"ن",2,0],["إِذا ذَكَرُوني والثَّرَى فَوْقَ أَعْظُمِي","بكَوا بعُيُونٍ كالسَّحابِ المواطِرِ",141,"ر",1,0],["إِذا ذَكَرَت نَفسي تَميماً تَذَكَّرَت","أُموراً تُنَسّيني الضَغائِنَ وَالحِقدا",142,"د",2,0],["إِذَا ذَكَرَتْهُ نَفْسِي أَبْصَرَتْهُ","كَأَنِّي مِنْهُ أَنْظُرُ فِي كِتابِ",143,"ب",1,0],["إِذَا ذَكَرَتْهَا النَّفْسُ سَالَتْ مِنَ الأَسَى","مَعَ الدَّمْعِ حَتَّى لا تُنَهْنَهُ بِالرَّدِّ",144,"د",1,0],["إِذَا ذَكَرْنَاهُ أَشَدْنَا بِمَا","كَان لِحِلْفَيْكَ بِهِ مِنْ أَيَادْ",145,"د",1,0],["إِذا ذُكِرَ النِساءُ بِحُسنِ حالٍ","فَهُنَّ لَها الفِدا في كُلِّ حالِ",146,"ل",1,0],["إِذا ذكرَ المَوت ذا عبرَةٍ","وَهَمَّ بِغَيرِ التُقى أَمسَكا",147,"ك",2,0],["إِذا ذَهَب المِسْكُ الذَّكِيّ فإِنّه","يَزُول وَيبْقَى نَشْرُه المُتَضَوِّع",148,"ع",1,0],["إِذا ذُكِرَ الفاروقُ فاضَ مَعِينُهُ","وثَجَّتْ قوافيهِ وعَبَّتْ حَوَافِلُهُ",149,"ل",2,0],["إذا ذرفت عيناه، كَفكَفت معه","وإن مسَّهُ كسرٌ، فعطفك جابره",150,"ر",2,0],["إذا ذُكر العُرْبُ؛ حنَّتْ، وأنَّتْ","وراحَتْ تُلوِّحُ أغصانها!",151,"ن",3,0],["إذا ذقت فاها ذقت طعم مدامة","ٍ بِنُطْفَة ِ جُونٍ سَالَ منه الأباطحُ",152,"ح",1,0],["إذا ذُكِرَتْ لَيْلَى أهِيمُ بِذِكْرِهَا","وكانت مني نفسي وكنت لها أرضى",153,"ض",2,0],["إذَا ذَكَرَتْهَا النَّفْسُ ظَلَّتْ كأَنَّما","عليها من الوَرْدِ التّهاميِّ أفْكَلُ",154,"ل",1,0],["إذا ذُكِرَتْ أسْمَاؤهُمْ أوْ دُعُوا بها","تَكَادُ حَيَازِيمي تفَرّى صِلابُهَا",155,"ب",3,0],["إذا ذَكَرَتْ نَفسِي زِياداً تَكَمَّشَتْ","مِنَ الخَوْفِ أحشائي وَشابَتْ مَفارِقي",156,"ق",2,0],["إذا ذكروا أوطانَهُم ذكَّرته","عُهودَ الصبا فيها فحنّوا لذلكا",157,"ك",2,0],["إذا ذكروا قتلى ببدرٍ وخيبرٍ","ويوم حنينٍ أسلبوا العبراتِ",158,"ت",1,0],["إِذَا ذُكِرَت أَعمالُه وَعُلومُه","أقرَّ لها زيدٌ وبكرٌ وخالدُ",159,"د",1,0],["إِذا ذَكَرت صِفات الحُسن مِنهُ","فَما سَعدي وَما أَسما وَميّا",160,"ي",2,0],["إذا ذكر التباعد والتلاقي","أحاط به بكاء وابتسام",161,"م",1,0],["إذا ذعرٌ لجا تتابع ذعره","تتابع بجٍّ منه للذعر مقصما",162,"م",2,0],["إذا ذكر العلم أدُّكِرتَ فأنتما","تلازمتما ذهناً كروحٍ وجثمانِ",163,"ن",1,0],["إِذا ذُكِرَ البُيوتُ عَدا قُصَيّاً","فَآلُ أَبي عَقيلٍ خَيرُ آلِ",164,"ل",1,0],["إذا ذاك الجبين كساك نوراً","فنورك فانتظر تلك اليمينا",165,"ن",2,0],["إذا ذهبت أيام عمرك باطلاً","فدونك فاختر ايَّ داريك تنزل",166,"ل",1,0],["إِذا ذُكِرَ المُختارُ حَنَّ حَنينَهُ","لأَستَمطِرَن الدَمعَ ما عِشتُ دونَهُ",167,"ه",1,0],["إذا ذكرتك غضبانا وضعت يدي","على فؤاد وها حزنا وذاب ضنىً",168,"ن",2,0],["إذا ذكرت أباؤه اسود وجهه","حياء وأغضى الطرف إغضاء ذلة",169,"ه",1,0],["إذا ذكر ابن إسماعيل ظلت","من الفخر الملوك له تخلا",170,"ل",2,0],["إذا ذكرت مفاخره أطّرحنا","فخار ممالك الدنيا اختيارا",171,"ر",2,0],["إذا ذكرتك والدنيا موليه","أيقنت لي أن باسترجاعها قبلا",172,"ل",2,0],["إذا ذكر الملوك بكل أرض","فأنت لهم إِمام المكرمات",173,"ت",1,0],["إذا ذكر الملوك بكل أرض","فانك ناظر وهم الجفون",174,"ن",1,0],["إِذا ذَوى الغُصنُ الرَطيبُ فَاِعلَمَن","أَنَّ قُصاراهُ نَفاذٌ وَتَوى",175,"ا",1,0],["إِذا ذُكرَت آباؤُهُ يَومَ مَفخَرٍ","تَضاءا لِمَن يَبغي العُلا بِاِنتِسابِهِ",176,"ب",2,0],["إِذا ذَكَرتُ يَومَهُ تَحَدَّرَت","مَدامِعي لِأَربَعٍ في أَربَعِ",177,"ع",1,0],["إِذا ذَكَرَت ماءَ العِضاهِ وطِيبَهُ","وَبَردَ الحَصَى مِن بَطنِ خَبتٍ أَرَنَّتِ",178,"ت",1,0],["إِذَا ذُكِرَت عِندِى أَئِنُّ لذِكرِها","كما أَنَّ وَقعِ السِّلاحِ جَرِيحُ",179,"ح",1,0],["إذا ذكرتهْ النفسُ فاضتْ مَدامِعي","على الزَّفراتِ الصاعداتِ اللَّوافحِ",180,"ح",1,0],["إِذا ذَكَرنَ حَديثاً قُلنَ أَحسَنَهُ","وَهُنَّ عَن كُلِّ سوءٍ يُتَّقى صُدُفُ",181,"ف",1,0],["إِذا ذَكَرَ الأَقوامُ أَحسابَهُم نَما","إِلى خَيرِ ما تَنمي إِلَيهِ المَعاشِرُ",182,"ر",1,0],["إذا ذُكِرَ العقيقُ وساكنوه","بكى طرباً وأسعده الهديل",183,"ل",1,0],["إذا ذكروهُ كبرَ الشرقُ بهجةً","وإن لقبوهُ أكبرَ الشرقِ مغربُ",184,"ب",1,0],["إذا ذكرتها الروح هامت جوانحى","وأوحت أضاليل الغرام إلى لبّى",185,"ب",2,0],["إذا ذكرتها الروح هامت جوانحى","وأوحت أضاليل الهيام إلى لبى",186,"ب",2,0],["إذا ذكرت بغداد والقلب هاجدٌ","صحا واستثارته غيومٌ وأرعاد",187,"د",1,0],["إذا ذكرت الفراق يوماً","غصصت من لوعتي بريقي",188,"ي",1,0],["إذا ذكروا من أرض علية موضعاً","فوسواسه في رحب صدري ينفثُ",189,"ث",1,0],["إِذا ذاكَ نادَت بِصَدري النَفسُ قائِلَةً","أَيّا سَكنتَ تجد حكماً لِإِرضائي",190,"ا",2,0],["إذا ذكرتك في سِرّ وفي عَلَنٍ","وجدتُ حبّك في قلبي قد انطبعا",191,"ع",2,0],["إذا ذكرناك أومأنا بأوجهِنا","مقبِّلين بها للتُرب والمَدَر",192,"ر",1,0],["إذا ذكر الراوون صحب محمد","يكون له فيهم خصائص أربع",193,"ع",1,0],["إِذا ذَكَرَ الأَوطانَ فاضَت دُموعُهُ","فَأَرسَلَها فَوقَ التَرائِبِ وَالنَحرِ",194,"ر",1,0],["إِذَا ذَكَرْتُ حُسَيْناً بِالْعِرَاقِ سَمَا","وَجْدُ الْغَرِيبِ وَجَرَّ الذَّيْلَ ذُو الدَّارِ",195,"ر",1,0],["إذا ذكر الإحساء والعيث هاجه","غليل به من حره يتقلب",196,"ب",1,0],["إذا ذكر القضاة وهم شيوخ","تخيرت الشباب على الشيوخ",197,"خ",1,1],["إذا ذكرت أمامةُ فرطَ حولٍ","ولو بعدت محلتها غُريتُ",198,"ت",1,1],["إذا ذُعرت من بياض السيوف","قلنا لها أقدمي مُقدما",199,"م",2,0],["اذا ذكر اِرتاحَت قلوب لذكره","وَطابَت نفوس وانشرحن صدور",200,"ر",1,0],["إ