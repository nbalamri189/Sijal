ر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[48,"إذا ذكر الفراق بكى","https://www.aldiwan.net/poem64468.html","مجزوء الوافر"],[48,"أديرا علي الكأس ينقشع الغم","https://www.aldiwan.net/poem65097.html","الطويل"],[50,"خليلي عفا عن سهيل بن سالم","https://www.aldiwan.net/poem63809.html","الطويل"],[50,"لحى الله حماد بن نهيا فإنه","https://www.aldiwan.net/poem63895.html","الطويل"],[50,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[50,"خليلي قوما فاعذرا أو تعتبا","https://www.aldiwan.net/poem64836.html","الطويل"],[50,"ذهبت ولم تلمم ببيت الحبائب","https://www.aldiwan.net/poem64850.html","الطويل"],[46,"دع الناس واصحب وحش بيداء قفرة","https://www.aldiwan.net/poem23066.html","الطويل"],[15,"تعفت رسوم من سليمى دكادكا","https://www.aldiwan.net/poem45257.html","الطويل"],[15,"نأتك سليمى فالفؤاد قريح","https://www.aldiwan.net/poem45279.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[76,"لا بيت يسكن إلا فارق السكنا","https://www.aldiwan.net/poem38879.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30460","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1673","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12825","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[22,"ألم تسألِ العيّاف إن كنت صادقاً","https://www.poetsgate.com/ViewPoem.aspx?id=19734",""],[33,"ألا أيُّهَا الشَّيْخُ الَّذِي مَا بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=2673",""],[35,"صَحَا قَلْبُهُ يا عَزَّ أوْ كَادَ يَذْهَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=22128",""],[28,"أبى الحزن أن أسلى بني وسورة","https://www.poetsgate.com/ViewPoem.aspx?id=17968",""],[28,"ألا طرقت ظمياء والركب هجد","https://www.poetsgate.com/ViewPoem.aspx?id=22097",""],[51,"أعوذ بحقْوِيْك العزيزيْن أن أُرى","https://www.poetsgate.com/ViewPoem.aspx?id=30023",""],[54,"تَجَاوَبنَ بالإرنانِ وَالزَّفراتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16977&r=&rc=1",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["إِذا ذُكِرَ الصَوارِمُ وَالعَوالي","تَعَوَّذَ بِالمَثالِثِ وَالمَثاني",0,"ي",1,0],["إِذا ذُبولُ الشِفاهِ شَمَّرَها","في الغَمَراتِ الحِفاظُ وَالسَأَمُ",1,"م",1,0],["إِذا ذَكَروا الوِترَ حَزّوا الرِقابَ","وَإِن ذَكَروا العَفوَ جَزّوا اللِماما",2,"م",2,0],["إِذا ذُكِرَ اِسمُهُ اِرتَجَّت","أَو اِرتَعَدَت مَنابِرُه",3,"ر",2,0],["إِذا ذَكَروهُ لِلخِلافَةِ لَم تَزَل","تَطَلَّعُ مِن شَوقٍ رِقابُ المَنابِرِ",4,"ر",1,0],["إِذا ذَكَرَتكَ عَلى وِنيَةٍ","رَأَيتَ ذَفاريَّها تَنضَحُ",5,"ح",1,0],["إِذا ذَعَرَتهُم نَبأَةٌ غادَرَتهُمُ","وَقَد أَيقَظوا مِن بَينِ أَجفانِها القُضبا",6,"ب",2,0],["إِذا ذَكَرَتْها النَّفسُ باتَت كَأَنَّها","عَلى حَدِّ سَيفٍ بَينَ جَنبيَّ يُنتَضى",7,"ض",2,0],["إِذا ذَكَرتُ بِها نَجداً وَساكِنَهُ","وَضَعتُ حُبوَةَ حِلمي في يَدِ الطَرَبِ",8,"ب",1,0],["إِذا ذُكِرَ المَجْدُ التَّليدُ تَلَفَّتَتْ","إِليهِ بِعَيْنَيْ ثاكِلٍ وَأَرَنَّتِ",9,"ت",1,0],["إذا ذُكِرَتْ آلُ ابنِ عفّانَ أجْهَشَتْ","حُزونٌ ورنّتْ بالحِجازِ سُهولُ",10,"ل",1,0],["إذا ذلَّتْ حَياتُكَ في مَكانٍ","فَمُتْ لطِلابِ عِزِّكَ في مَكانِ",11,"ن",1,0],["إذا ذَكَروهُ أضْمَرَ العُجْمُ إحْنَةً","عليهمْ وأصْلى جَمْرَةَ الحَسَدِ العُرْبا",12,"ب",2,0],["إذا ذَكرْناه هَزَّ الرُّمْحَ عامِلَهُ","والسّيفُ مُبتَسِمٌ والبأسُ مَشهودُ",13,"د",1,0],["إِذا ذُكِرَ الفَخارُ بِأَرضِ قَومٍ","فَضَربُ السَيفِ في الهَيجاءِ فَخري",14,"ر",2,0],["إِذا ذَكَرَتكِ العَينُ يَوماً تَبادَرَت","دُموعي عَلى الخَدَّينِ تَجري بِأَربَعِ",15,"ع",1,0],["إِذا ذَرَفَت عَيني لِحَرِّ مُصيبَةٍ","تَمَثَّلتُ قَولَ المُبتَلى بِالمَصائِبِ",16,"ب",1,0],["إِذا ذُكِرَت لُبنى تَجَلَّتكَ زَفرَةٌ","وَيَثني لَكَ لداعي بِها فَتَفيقُ",17,"ق",1,1],["إِذا ذُكِرَت لُبنى تَأَوَّهَ وَاِشتَكى","تَأَوُّهَ مَحمومٍ عَلَيهِ البَلابِلُ",18,"ل",1,1],["إذا ذُكِرَ الأمْلاكُ يوْماً فيوسُفٌ","لِما شِئْتَ منْ جُودٍ وما شِئْتَ منْ عطْفِ",19,"ف",1,0],["إِذّا ذُكِرَ الْعَلاَءُ فَأَنْتَ أَعْلَى","وَإِنْ ذُكِرَ السَّنَاءُ فَأَنْتَ أَسْنَى",20,"ن",2,0],["إذا ذُكِرَ الإغْضاءُ والحِلْمُ والتُّقى","وحدّثْتَ عنْ عَلْياهُ حدِّثْ عنِ البَحْرِ",21,"ر",1,0],["إِذَا ذَهَبَتْ يَمِينُكَ لاَ تُضَيِّعْ","زَمَانَكَ فِي الْبُكَاءِ عَلَى الْمُصِيبَهْ",22,"ب",2,1],["إذا ذكر الحُجَّابُ في كُلِّ مَشهَدٍ","وَأَمْلاَكُهُمْ مِنْ كُلِّ هَادٍ ومُهْتَدِي",23,"ي",1,0],["إِذَا ذُكِرَ الأَمْلاَكُ مَنْ مِثْلُ يُوسُفٍ","يُسَالِمُ فِي ذَاتِ الْهُدَى وَيُحَارِبُ",24,"ب",1,0],["إِذا ذُكِرَت سِيَرُ النابِهينَ","فَسيرَةُ صَبري تَجُبُّ السِيَر",25,"ر",1,0],["إِذا ذَكَروا مِنهُ النَسيبَ رَأَيتَنا","وَداعي الهَوى مِنّا أَقامَ وَأَقعَدا",26,"د",2,0],["إِذا ذُقتُ فاهاً قُلتُ طَعمُ مُدامَةٍ","مُعَتَّقَةٍ مِمّا تَجيءُ بِهِ التُجُر",27,"ر",1,0],["إِذا ذَرَّ قَرنُ الشَمسِ مالَت طُلاهُمُ","عَلَيها وَأَلقَوا كُلَّ سَوطٍ وَمِحجَنِ",28,"ن",1,0],["إِذا ذَرَفَت عَينايَ أَعتَلُّ بالقَذى","وَعَزَّةُ لَو يَدري الطَبيبُ قَذاهُما",29,"م",2,0],["إِذا ذُكِرَت لَيلى تَغَشَّتكَ عَبرَةٌ","تُعَلُّ بِها العَينانِ بَعدَ نُهولِ",30,"ل",1,0],["إِذا ذَكَرتها النَفسُ ظَلَّت كَأَنَّها","عَلَيها مِنَ الوَردِ التَهامِيِّ أَفكَلُ",31,"ل",1,0],["إِذا ذَكَرَتها النَفسُ جُنَّت بِذِكرِها","وَريعَت وَحَنَّت وَاِستَخَفَّ جَليدُها",32,"د",3,0],["إِذا ذَكَرَ الناسُ السَماحَ مِنِ اِمرِئٍ","وَأَكرَمَ أَو قالَ الصَوابَ خَطيبُ",33,"ب",1,0],["إِذا ذَكَرَت نَفسي نَداهُ وَبَأسَهُ","تَحَسَّرَ عَنها كُلُّ عَيشٍ وَأَنعُمِ",34,"م",1,0],["إِذا ذُكِروا يَوماً وَقَد صِرتَ رابِعاً","ذُكِرتَ بِقَدرِ السَعيِ مِنكَ إِلى الفَضلِ",35,"ل",1,0],["إِذا ذَكَروا قَتلى بِبَدرٍ وَخَيبَرٍ","وَيَومِ حُنَينٍ أَسبَلوا العَبَراتِ",36,"ت",1,0],["إِذا ذابَتِ الشَمسُ اِتَّقى صَقَراتِها","بِأَفنانِ مَربوعِ الصَريمَةِ مُعبِلِ",37,"ل",1,0],["إِذا ذَكَرتكَ النَفسُ مَيّاً فَقلُ لَها","أَفيقي فَأَيهات الهَوى مِن مَزارِكِ",38,"ك",1,0],["إِذا ذُكِرَ الأَقوامُ فَاِذكُر بِمِدحَةٍ","بِلالا أَخاكَ الأَشعرَيَّ أَبا عَمرِو",39,"ر",2,0],["إِذا ذاتُ أَهوالٍ ثَكولٌ تَلَوَّنَت","بِها العِينُ فوضى وَالنَعامُ السَوارِحُ",40,"ح",1,0],["إذا ذكر الورى جشعاً وحرصاً","ف شرشل أكبر المتجشّعينا",41,"ن",2,0],["إذا ذكروا سُماك ولو مَناماً","تحامَوْا ذكره بسوى التهجّي",42,"ج",2,0],["إذا ذُكر الهُبوط فأنت مُعلٍ","وإن خِيف الحُبوط فأنت منج",42,"ج",1,0],["إذا ذُكر العراق بكَيْت شجواً","بدمع طمّ سائله القَرِيّا",43,"ر",3,0],["إذا ذكرناك يوماً في محافلنا","قمنا لذكراك تعظيماً وإجلالا",44,"ل",2,0],["إِذا ذُكِرَت لَيلى أُتيحَ لِيَ الهَوى","عَلى ما تَرى مِن هِجرَتي وَاجتِنابِيا",45,"ي",2,0],["إِذا ذُكِرَت مَساعينا غَضِبتُم","أَطالَ اللَهُ سُخطَكُمُ عَلَينا",46,"ن",2,0],["إِذا ذُكِرَت لِلقَلبِ كادَ لِذِكرِها","يَطيرُ إِلَيها وَاِعتَراهُ عَذابُها",47,"ب",3,0],["إِذا ذَكَرَت زَيداً تَرَقرَقَ دَمعُها","بِمَطروفَةِ العَينَينِ شَوساءَ طامِحِ",48,"ح",1,1],["إِذا ذَكَرَت لَيلى جُبَيراً تَعَصَّرَت","وَلَيسَ بِشافٍ دائَها أَن تَعَصَّرا",49,"ر",2,0],["إِذا ذَكَرَت نَفسي شَريكاً تَقَطَّعَت","عَلى مَضرَحِيٍّ لِلمَقامَةِ رائِسِ",50,"س",1,1],["إِذا ذُكِرَت شَعثاءُ طارَ فُؤادُهُ","لِطَيرِ الهَوى وَاِرفَضَّتِ العَينُ تَدمَعُ",51,"ع",1,0],["إِذا ذُقتَ مِنّي طَعمَ حَربٍ مَريرَةٍ","عَطَفتُ عَلَيكَ الحَربَ وَالحَربُ تُعطَفُ",52,"ف",1,0],["إِذا ذُكِرَت هِندٌ لَهُ خَفَّ حِلمُهُ","وَجادَت دُموعُ العَينِ سَحّاً سُجومُها",53,"م",3,0],["إذا ذات وَدقين هاب الرُقا","ةُ أن يصلحوها وأن يسمُلُوا",54,"ل",3,1],["إِذا ذُكِرَت يَوماً غَطاريفُ وائِلٍ","فَنَحنُ أَعاليها وَنَحنُ الجَماهِرُ",55,"ر",1,0],["إِذا ذَكَرَ الحَيَّ المُقيمَ حُلولُهُم","وَأَبصَرَ ما يَلقى اِستَهَلَّت مَدامِعُه",56,"ع",2,0],["إِذا ذُكِرَت قَهقاءُ حَنّوا لِذِكرِها","وَلِلرَمَثِ المَقرونِ وَالسَمَكِ الرُقطِ",57,"ط",1,0],["إِذا ذُكِرَت عَقيلَةُ بِالمَخازي","تَقَنَّعَ مِن مَخازيها اللِئامُ",58,"م",1,1],["إذا ذُكرت أهل السيادة والعلى","فعدّ ابن فضل الله فاتحةَ الذكر",59,"ر",1,0],["إذا ذكرت أقلامهم وسيوفهم","فناهيك بالحمر الرَّواعف والسمر",59,"ر",1,0],["إذا ذكرناه فاح العطر أجمعه","فكلنا فيه عطارُ ابن عطار",60,"ر",1,0],["إذا ذكروا الركنَ اليمانيَّ يمَّموا","مواهب ركنٍ للعفاة شآم",61,"م",1,0],["إِذا ذَكَرتُكَ كادَ الشَوقُ يُقلِقُني","وَغَفلَتي عَنكَ أَحزانٌ وَأَوجاعُ",62,"ع",1,1],["إذا ذَكرتْ أياديَها نفوس","أفاقت من مُعالجة الكروبِ",63,"ب",1,0],["إذا ذل في الدنيا الأعزةُ واكتستْ","أذلَّتُها عزَّاً وسادَ مَسودُها",64,"د",3,0],["إذا ذكر استغشاءه النومَ آمناً","جرت مقلتاه بالدموع الحواشدِ",65,"د",1,0],["إذا ذُكرتْ لم يكن ذِكرها","بأيسر نتناً من المَنْبَش",66,"ش",1,0],["إذا ذكروا أوطانَهُم ذكَّرتهمُ","عُهودَ الصبا فيها فحنّوا لذلكا",67,"ك",2,0],["إِذا ذَكَرَت قَتلى بِكَوساءَ أَشعَلَت","كَواهِيَةِ الأَخراتِ رَثٍّ صُنوعُها",68,"ع",3,0],["إِذا ذَكَرَت أَنيابَها أُمُّ هَيثَمٍ","رَغَت جَيأَلٌ مَخطومَةٌ بِضَفيرِ",69,"ر",1,0],["إِذا ذادَ عَن ماءِ الفُراتِ فَلَن تَرى","أَخا قِربَةٍ يَسقي أَخاً بِصَميلِ",70,"ل",1,0],["إِذا ذُكِرَ النِساءُ بِيَومِ خَيرٍ","فَنامي أُمَّ زَنبَ وَلا تُراعي",71,"ي",1,1],["إِذا ذُكِرَ الشَآمُ بَكَيتَ وَجداً","وَما تَنفَكُّ تَذَّكَّرُ الشَآما",72,"م",2,0],["إِذا ذُكِرَت في الحَيِّ أَصبَحَ آيِساً","فَرَزدَقُها مِن وَصلِها وَجَريرُها",73,"ر",3,0],["إِذا ذُقتَ فاها قُلتَ طَعمَ مُدامَةٍ","دَنا الزِقُّ حَتّى مَجَّها وَهوَ جانِحُ",74,"ح",1,0],["إذا ذكرتكَ النفس جاشت صبابة","وفار عليها من غرامك مِرجل",75,"ل",1,0],["إذا ذكروا عَهْدَ الشّآمِ اسْتَعادَني","إلى مَنْ بأَكْنافِ الشّآمِ حَنينُ",76,"ن",1,0],["إِذا ذُكِرَت مَواقِفُهُ لِحافٍ","وَشيكَ فَما يُنَكِّسُ لِاِنتِقاشِ",77,"ش",1,0],["إِذا ذَرَّتْ عليها المِسْكَ ريحٌ","رَخَاءٌ نفَّضَتْه يَدُ الغَوادي",78,"ي",1,0],["إِذا ذَهَبا هَذانِ مِنّي بِلَذَّتي","فَما أَنا في الدُنيا لِعَيشٍ بِصاحِبِ",79,"ب",1,0],["إِذا ذَهَبَت أَموالُهُ نَحوَ أَوجُهٍ","مِنَ البَذلِ جاءَت مِن وُجوهٍ مَحامِدُه",80,"د",2,0],["إِذا ذُكِرَت أَسلافُهُ وَتُشوهِرَت","أَماكِنُها قُلتَ النُجومُ قُبورُها",81,"ر",3,0],["إِذا ذو العَقلِ أَعطى النُصحَ مِنهُ","عَديمَ العَقلِ ضَيَّعَهُ فَضاعا",82,"ع",2,0],["إِذا ذُكِروا بِشُهرَةِ يَومِ فَخرٍ","تَناسَبَتِ النَباهَةُ وَالخُمولُ",83,"ل",1,0],["إِذا ذَكَرَتكِ النَفسُ شَوقاً تَتابَعَت","لِذِكراكِ أُحدانُ الدُموعِ وَتومُها",84,"م",3,0],["إِذا ذَهَبَت شَرقاً وَغَرباً فَأَمعَنَت","تَبَيَّنتَ مَن تَزكو لَدَيهِ الصَنائِعُ",85,"ع",1,0],["إِذا ذُكِّرَت نَفسي اِبنَ مَروانَ صاحِبي","وَمَروانَ فاضَت ماءَ عَيني غُروبُها",86,"ب",3,0],["إِذا ذَكَرَت عُيونُهُمُ اِبنَ أَروى","وَيَومَ الدارِ أَسهَلَتِ اِنسِكابا",87,"ب",2,0],["إِذا ذَكَرَت عَيني سَعيداً تَحَدَّرَت","عَلى عَبَراتٍ يَستَهِلُّ اِنسِكابُها",88,"ب",3,0],["إِذا ذَكَرَتهُ العَينُ يَوماً تَحَدَّرَت","عَلى الخَدِّ أَمثالَ الجُمانِ المُفَرَّدِ",89,"د",1,0],["إِذا ذُكِرَت أَيدي الكِرامِ إِلى النَدى","وَآثارُها ذَمَّت يَدَيهِ مَعاشِرُه",90,"ر",2,0],["إِذا ذُكِرَت نَوارُ لَهُ اِستَهَلَّت","مَدامِعُ مُسبِلِ العَبَراتِ جارِ",91,"ر",1,0],["إِذا ذَكَرَت زَوجاً لَها جَعفَرِيَّةٌ","وَمَصرَعَ قَتلى لَم تُقَتَّل ثُؤورُها",92,"ر",3,0],["إِذا ذُكِرَت أَيّامُهُم يَومَ لَم يَقُم","لِسَلَّةِ أَسيافِ الضَبابِ نَفيرُها",92,"ر",3,0],["إِذا ذَكَرَت نَفسي زِياداً تَكَمَّشَت","مِنَ الخَوفِ أَحشائي وَذابَت مَفارِقي",93,"ق",2,0],["إِذا ذَكَرَت نَفسي يَدَيكَ نَزَت بِها","كَراسيعُ زالَت وَالقَطيعُ المُحَرَّمُ",94,"م",1,0],["إِذا ذُكِرَت أَسمائُهُم أَو دُعوا بِها","تَكادُ حَيازيمي تَفَرّى صِلابُها",95,"ب",3,0],["إِذا ذَكَرَت عَيني الَّذينَ هُمُ لَها","قَذىً هيجَ مِنها لِلبُكاءِ اِنسِكابُها",95,"ب",3,0],["إذا ذُكِرَ العقِيقُ لنا نَثَرنا","عَقِيقَ الدّمعِ سَحّاً وانهمالا",96,"ل",2,0],["إِذا ذَكَرنا زَماناً كانَ يُدرِكُنا","بِالقُربِ مِنكُم وَفي اللَذّاتِ يُشرِكُنا",97,"ن",2,0],["إِذا ذَكَرتُ حِمى العاصي وَمَلعَبِهِ","وَالقَصرَ وَالقُبَّةَ العُليا بِمَرقَبِهِ",97,"ه",1,0],["إِذا ذَمَّهُ الأَعداءُ قالوا مُفَرِّطٌ","وَإِن بالَغوا بِالذَمِّ قالوا مُبَذِّرُ",98,"ر",1,0],["إذا ذكرتهُ الحمائمُ أنَّ","وإن ضاحكته الربى صفَّقَا",99,"ق",2,0],["إِذا ذاقَها وَهيَ الحَياةُ رَأَيتَهُ","يُعَبِّسُ تَعبيسَ المُقَدَّمِ لِلقَتلِ",100,"ل",1,0],["إِذَا ذَكَرَتْهَا النَّفْسُ يَوْمَاً تَرَاجَعَتْ","عَلَيْهَا عَقَابِيلُ الْهُمُومِ الْقَدَائِمِ",101,"م",1,0],["إِذَا ذَهَبَ الْكِرَامُ فَلا رَجَاءٌ","وَإِنْ ذَهَبَ الرَّجَاءُ فَلَيْسَ فَضْلُ",102,"ل",1,0],["إذا ذهبتْ بالطلا","فقد طُليتْ بالذهبْ",103,"ب",1,0],["إِذا ذُكِرَت لَيلى أَإِنُّ لِذِكرِها","كَما أَنَّ بَينَ العائِداتِ سَقيمُ",104,"م",1,0],["إِذا ذَكَرَتها النَفسُ ماتَت صَبابَةً","لَها زَفرَةٌ قَتّالَةٌ وَشَهيقُ",105,"ق",1,0],["إِذا ذُكِرَت لَيلى أُهيمُ لِذِكرِها","وَكانَت مُنى نَفسي وَكُنتُ لَها أَرضى",106,"ض",2,0],["إِذا ذُكِرَت يَرتاحُ قَلبي لِذِكرِها","كَما اِنتَفَضَ العَصفورُ بُلِّلَ مِن قَطرِ",107,"ر",1,0],["إِذا ذُكِرَت لَيلى أُسَرُّ بِذِكرِها","كَما اِنتَفَضَ العُصفورُ مِن بَلَلِ القَطرِ",108,"ر",1,0],["إِذا ذُكِرَت لَيلى بَكَيتُ صَبابَةً","لِتَذكارِها حَتّى يَبُلَّ البُكا الخَدا",109,"د",2,0],["إِذا ذَكَرَت نَجداً وَطيبَ تُرابِهِ","وَخَيمَةَ نَجدٍ أَعوَلَت وَأَرَنَّتِ",110,"ت",1,0],["إِذا ذَكَرَت ماءَ الفَضاءِ وَخَيمَةً","وَبَردِ الضُحى مِن نَحوِ نَجدَ أَرَنَّتِ",110,"ت",1,0],["إِذا ذُكِرَت لَيلى عَقَلتُ وَراجَعَت","رَوائِعُ قَلبي مِن هَوىً مُتَشَعِّبِ",111,"ب",1,0],["إذا ذكروا الزَّعامةَ فهي دعوى","يكيدُ بها الكنانةَ مَن يكيدُ",112,"د",1,0],["إذا ذاقهُ في غمرةِ الحربِ قَرْنُه","تنكَّبَ يلوِي أخْدَعَيْهِ ويزوَرُّ",113,"ر",1,0],["إذا ذُكِرَتْ مَنَاقِبُهُ الغوالي","تَعَالتْ أُمَّةٌ واعتزَّ جيلُ",114,"ل",1,0],["إِذا ذُكِرَت مَسعاةُ والِدِهِ اِضطَنا","وَما يَضطَني مِن شَتمِ أَهلِ الفَضائِلِ",115,"ل",1,0],["إِذا ذُكِرَت سَلمى لَهُ فَكَأَنَّما","يُغَلغِلُ طِفلٌ في الفُؤادِ وَجيعُ",116,"ع",1,0],["إِذا ذَكرَ النَخلَ أَربابُها","وَقالوا مُبَكِّرُها المُبلِحُ",117,"ح",1,0],["إِذا ذَهَبَ الشَبابُ فَبانَ مِنهُ","فَلَيسَ لِما مَضى مِنهُ لِقاءُ",118,"ا",2,0],["إِذا ذُكِرَت لَكَ الحاجاتُ مِنّي","فَلا حَصِرٌ بِهِنَّ وَلا بَخيلُ",119,"ل",1,0],["إِذا ذُقتَ فاها قُلتَ طَعمَ مُدامَةٍ","بِنُطفَةِ جَونٍ سالَ مِنهُ الأَباطِحُ",120,"ح",1,0],["إذا ذكرَتْهُ النفسُ جاشتْ لذكرهِ","كما عثَرَ السّاقي بكأسٍ من الخمر",121,"ر",1,0],["إذا ذكروا آثارَ سيفك فيهمُ","فلا القَطر معدودٌ ولا الرّمل محسوب",122,"ب",1,0],["إِذا ذاقَها مَن ذاقَها حَلَّقَت بِهِ","فَلَيسَ لَهُ عَقلٌ يُعَدُّ أَديبُ",123,"ب",1,0],["إِذا ذَكَرَ الفِراقَ بَكى","وَإِن غَفَلَ الرَقيبُ شَكا",124,"ك",2,1],["إِذا ذاقَها شُرّابُها بَجَّلوا لَها","بِأَلسُنِهِم شُكراً فَهُم عَرَبٌ عُجمُ",125,"م",1,0],["إِذا ذَكَراني أَطرَقا مِن جَلالَتي","وَقالا كَريمٌ شانَ رُمحَ اِستِهِ صِغَر",126,"ر",1,0],["إِذا ذُكِرَ النابي تَلَمَّطَتِ اِستُهُ","وَبَرَّقَ عَينَيهِ لِوِردٍ مَتى يَرِد",127,"د",1,0],["إِذا ذُكِرَت سَبَقَت عَبرَتي","وَكادَت لَها كَبِدي تَقرَحُ",128,"ح",1,0],["إِذا ذُكِروا في مَأقِطٍ أَطرَقَ العِدى","وَرَنَّحَ فَحلُ القَريَتَينِ المُقَبقِبُ",129,"ب",1,0],["إِذا ذَكَرتُ اِمرَأً يَبيتُ عَلى ال","حَمدِ رَكِبنا العادِيَّةَ الرُكَبا",130,"ب",2,0],["إِذا ذادَ عَنهُ عَقرَباً مِن هَواكُمُ","بِرُقيَتِهِ دَبَّت لَهُ مِنكِ عَقرَبُ",131,"ب",1,0],["إِذا ذُكِرَ الحِبابُ بِها أَضَرَّت","بِها عَينٌ تَضَرُّ عَلى الحِبابِ",132,"ب",1,0],["إِذا ذُكِرَت صَفراءُ أَذرَيتُ عَبرَةً","وَأَمسَكتُ نَفسي رَهبَةً أَن تَصَبَّبا",133,"ب",2,0],["إِذا ذُكِرَت دارَ الهَوى بِمَسامِعي","كَما دارَت الصَهباءُ في رَأسِ شارِبِ",134,"ب",1,0],["إِذا ذَكَروا المَخلوقَ عابوا وَأَطنَبوا","وَإِن ذَكَروا الخَلّاقَ حابوا وَأَشرَكوا",135,"ك",3,0],["إِذا ذَكَرَت يَوماً مِنَ الدَهرِ شَجوَها","عَلى فَرعِ ساقٍ أَذرَتِ الدَمعَ سافِكا",136,"ك",2,0],["إِذا ذُقتَ فاها قُلتَ طَعمُ مُدامَةٍ","مُشَعشَعَةٍ تُرخي الإِزارَ قَديحُ",137,"ح",1,0],["إذَا ذَكَرَ السَعدِيُّ فَخراً فَقُل لَهُ","تَأَخَّر فَلَم يَجعَل لَكَ اللَهُ مَفخَرا",138,"ر",2,0],["إذا ذكرتُكَ يوماً قلت واحَزَنا","وما يَرُدُّ عليكَ القولُ واحَزَنا",139,"ن",2,0],["إِذا ذَكَرُوني والثَّرَى فَوْقَ أَعْظُمِي","بكَوا بعُيُونٍ كالسَّحابِ المواطِرِ",140,"ر",1,0],["إِذا ذَكَرَت نَفسي تَميماً تَذَكَّرَت","أُموراً تُنَسّيني الضَغائِنَ وَالحِقدا",141,"د",2,0],["إِذَا ذَكَرَتْهُ نَفْسِي أَبْصَرَتْهُ","كَأَنِّي مِنْهُ أَنْظُرُ فِي كِتابِ",142,"ب",1,0],["إِذَا ذَكَرَتْهَا النَّفْسُ سَالَتْ مِنَ الأَسَى","مَعَ الدَّمْعِ حَتَّى لا تُنَهْنَهُ بِالرَّدِّ",143,"د",1,0],["إِذَا ذَكَرْنَاهُ أَشَدْنَا بِمَا","كَان لِحِلْفَيْكَ بِهِ مِنْ أَيَادْ",144,"د",1,0],["إِذا ذُكِرَ النِساءُ بِحُسنِ حالٍ","فَهُنَّ لَها الفِدا في كُلِّ حالِ",145,"ل",1,0],["إِذا ذكرَ المَوت ذا عبرَةٍ","وَهَمَّ بِغَيرِ التُقى أَمسَكا",146,"ك",2,0],["إِذا ذَهَب المِسْكُ الذَّكِيّ فإِنّه","يَزُول وَيبْقَى نَشْرُه المُتَضَوِّع",147,"ع",1,0],["إِذا ذُكِرَ الفاروقُ فاضَ مَعِينُهُ","وثَجَّتْ قوافيهِ وعَبَّتْ حَوَافِلُهُ",148,"ل",2,0],["إذا ذرفت عيناه، كَفكَفت معه","وإن مسَّهُ كسرٌ، فعطفك جابره",149,"ر",2,0],["إذا ذُكر العُرْبُ؛ حنَّتْ، وأنَّتْ","وراحَتْ تُلوِّحُ أغصانها!",150,"ن",3,0],["إذا ذقت فاها ذقت طعم مدامة","ٍ بِنُطْفَة ِ جُونٍ سَالَ منه الأباطحُ",151,"ح",1,0],["إذا ذُكِرَتْ لَيْلَى أهِيمُ بِذِكْرِهَا","وكانت مني نفسي وكنت لها أرضى",152,"ض",2,0],["إذَا ذَكَرَتْهَا النَّفْسُ ظَلَّتْ كأَنَّما","عليها من الوَرْدِ التّهاميِّ أفْكَلُ",153,"ل",1,0],["إذا ذُكِرَتْ أسْمَاؤهُمْ أوْ دُعُوا بها","تَكَادُ حَيَازِيمي تفَرّى صِلابُهَا",154,"ب",3,0],["إذا ذَكَرَتْ نَفسِي زِياداً تَكَمَّشَتْ","مِنَ الخَوْفِ أحشائي وَشابَتْ مَفارِقي",155,"ق",2,0],["إذا ذكروا أوطانَهُم ذكَّرته","عُهودَ الصبا فيها فحنّوا لذلكا",156,"ك",2,0],["إذا ذكروا قتلى ببدرٍ وخيبرٍ","ويوم حنينٍ أسلبوا العبراتِ",157,"ت",1,0],["إِذَا ذُكِرَت أَعمالُه وَعُلومُه","أقرَّ لها زيدٌ وبكرٌ وخالدُ",158,"د",1,0]]}