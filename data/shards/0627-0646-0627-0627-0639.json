{"poems":[[71,"يا رب بالهادي النبي المجتبى","https://www.aldiwan.net/poem28577.html","الرجز"],[48,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[102,"الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50342",""],[112,"قلاده وخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=8424",""],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[376,"أنا أعرف فيمن","https://www.aldiwan.net/poem57424.html","البسيط"],[484,"رشقت فؤادي بالسهام","https://www.aldiwan.net/poem36920.html","مجزوء الكامل"],[556,"لا تلمني فليس لي","https://www.aldiwan.net/poem48047.html","مجزوء الخفيف"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44927","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102048","الرمل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93716","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205054","الخفيف"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105085","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112382","الكامل"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91144","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59463","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135106","الخفيف"],[4702,"لك الحمد ياربي عدد خلق الأجنة","https://www.poetsgate.com/ViewPoem.aspx?id=155107",""],[1901,"خدعتك من سودِ العيونِ نواظرُ","https://www.poetsgate.com/ViewPoem.aspx?id=160381",""],[5002,"العزة عزّتنا...","https://www.poetsgate.com/ViewPoem.aspx?id=202377",""],[5038,"بنت الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=189983",""],[5122,"أصبر وأصابر","https://www.poetsgate.com/ViewPoem.aspx?id=31511",""],[5185,"أمير الشعر والحب","https://www.poetsgate.com/ViewPoem.aspx?id=72850",""],[5408,"أنا إمرأة","https://www.poetsgate.com/ViewPoem.aspx?id=190867",""],[5433,"كبوة حصان","https://www.poetsgate.com/ViewPoem.aspx?id=36765",""],[5573,"سلام اسلم وسلم لي","https://www.poetsgate.com/ViewPoem.aspx?id=200309",""],[5606,"مايستحق الحب مثلك وشرواك","https://www.poetsgate.com/ViewPoem.aspx?id=196449",""],[5606,"ياوقت ماودك ترده؟","https://www.poetsgate.com/ViewPoem.aspx?id=197801",""],[5628,"الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179817",""],[5764,"حديث نفس","https://www.poetsgate.com/ViewPoem.aspx?id=161806",""],[5939,"منذ التقى يوليو ببرد يناير","https://www.poetsgate.com/ViewPoem.aspx?id=179997",""],[5939,"أحلى مُنجزاتِك","https://www.poetsgate.com/ViewPoem.aspx?id=185498",""],[5956,"معزوفة حب","https://www.poetsgate.com/ViewPoem.aspx?id=182082",""],[5956,"أحس عينيها تقولان لي:‏","https://www.poetsgate.com/ViewPoem.aspx?id=182192",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[6001,"حكمة الاقدار","https://www.poetsgate.com/ViewPoem.aspx?id=408",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["إنا اعترفنا بالذُّنوبِ فكنْ لنا","عاصٍ مسيءٌ للعذابِ استوجبا",0,"ب",2,0],["أَنا أَعمى فَكَيفَ أُهدى إِلى المَن","هَجِ وَالناسُ كُلُّهُم عُميانُ",1,"ن",1,0],["أَنا أَعلَمُ اِبني راحِماً مُتَعَطِّفاً","فَمَن لي غَدا بِالراحِمِ المُتَعَطِّفِ",2,"ف",1,0],["أنا أعطي ما تمنحون احترافي","فالمرارات بذركم ونباتي",3,"ت",2,0],["أنا أعترف بنّي خسرت التحدّي..؟","مبكي.؟وبكتني..؟ قلاده... وخاتم...",4,"م",1,0],["أنا أعشى إذا رأيتُ سنا اللّ","ه يحيّى بلمحه مقلتيّا",5,"ي",2,0],["أنا أعرفُ فيمَن","نبتَ الشيخُ أبو نصرِ",6,"ر",1,1],["آنا أعذب بالملا","م وتارة يحلو الملام",7,"م",1,0],["أنا أعشى لَدَى المطا","لب عن نُجحِ مطلبي",8,"ب",2,0],["أَنا أَعطَيتُ العُيونَ النَج","لَ أَسلابُ القُلوب",9,"ب",1,0],["أنا أعنيك وأعرض وانثني","عن شؤني ثم حالي سائل",10,"ل",1,0],["انا اعتصمنا بحبل اللَه اذ جحدوا","بالمحكمات ولم نكفر كما كفروا",11,"ر",3,0],["أَنا أَعلى نَفساً وَأَخلَدُ ذِكراً","وَمَجالي في الكَونِ غَيرُ مَجالِك",12,"ك",1,0],["أَنا أَعرف الرَجُلَ المهذَّب مِنهُما","بِاللَه لا تَسأل عَن التَعيين",13,"ن",1,0],["أنا أعطيتكم لنفسي مرآ","ة ونفسي تشع من ناظريا",14,"ي",2,0],["أنا أعطيه من حقوق الأشقا","ء ويفشي عني ضروب المثالب",15,"ب",1,0],["أنا أعشقُ النفسَ التي","تَلتَذّ في حَسَرَاتها",16,"ت",3,0],["أنا أعمى وقائدي في دجاه","أعورٌ والأُتان لي مهريه",17,"ي",2,0],["أَنا أَعرجٌ لا ضير لَكني فَتى","هَيهات يرزأني العَدو بافكه",18,"ك",2,0],["أنا أعلى ملوكِ الأزدِ قَدراً","وأعظمها وأجزُلها فخارا",19,"ر",2,0],["أنا أعلى بين الأنام وأحلى","وكلامي مزين بعقود",20,"د",1,0],["انا اعْذرك يا حرفي وعزام انا اظنّه","بعد هالقوافي يعْذرك لا عرفك وقام",21,"م",1,0],["أنا أعشقُ الدنيا فقل لعواذلي","إن الغرامَ غرائزُ وخواطرُ",22,"ر",1,0],["إنا أعزاء أقوام وأمتنا","عظيمة ولها نهج سما دينا",23,"ن",2,0],["أَنَا أَعْشَقُ امْرَأَةً تَناهى حُسْنُها","في خُلْقِها تَأْتَمُّ بِالزَّهْراءِ",24,"ا",2,0],["انا اعرفك في اسلوبك شاطر وماهر","عندك اسلوب القناعه كامل وشامل",25,"ل",1,0],["أنا أعظم الشعراء في أرض الهوى","إن غاب شعري فالجميع غياب",26,"ب",1,0],["أنا أعْصُري غادرَتْ وقتََها","وغادرَ ثغْري عصيرُ الخمورِ",27,"ر",1,0],["انا اعتبرها كبوة حصان ويقوم","وانت اعتبرها زي ما تعتبرها",28,"ر",3,0],["انا اعرف للضما زفره ملامحها سمايم صيف","لو افرغ لك مشاكيها ذهل منهو يعد اخلاف",29,"ف",1,0],["أنا أعرف أسرارك وعارف خفاياك","وأمسك رجول الديك تاجيك بالديك",30,"ك",1,0],["أنا أعرفه مانوى الصده","ولاهو انسان متغلي",31,"ل",2,0],["أنا أعلنْت ُ رَحيلي بعدما","رّحّلَ الحبُّ وأخلى مَوضِعَهْ",32,"ع",2,0],["انا اعرفها لو ان ماعرف خفاياها","بعيونها اشياااااء لازالت تخبيها",33,"ي",3,0],["أناْ أعمقُ الهُوَّاتِ في ذاكِ المحي","طِ، لكي تُحيطي بي فغُوصي وانظري!",34,"ر",2,0],["أنا أُعلِيكِ حينَ عليكِ أَعلو","ألا معنى لشمسٍ في حياتِكْ؟",35,"ك",1,0],["أنا أعزف حبي أغنيةً","تعطي إشعاعاً وَضَّاءَا",36,"ا",3,1],["أنا أعرف ماذا يجري لي","لكنّك يا غالي تجهلْ",37,"ل",1,0],["أنا أعشق حُسْنَك يجلدني","ويؤدِّب فوراً مجنونكْ",38,"ك",1,0],["أنا أعرف الذهبَ الأصيل ولم أكن","بأصالةٍ تحوينها مرتابا",39,"ب",2,0],["أنا أعظمُ العظماء أملك زوجة","ملأت حياتي خدمة وعطايا",40,"ا",3,0],["أنا اعلم وأنت لو تعلم بخافي القلب والأسرار","أنا لك بحت بسدودي وأعلن للملا سرِّي",41,"ر",2,1],["أَنا أَعلم أَنك عَبد مَأمور وَاقف","ذولي اللَيالي المظلمات قدار",42,"ر",1,0],["أنا أعرفُ الفخَّ المركَّبَ إنْ أنا","صرَّحتُ متُ وإذ أُلَمِّحُ أُضرَبُ",43,"ب",1,0]]}