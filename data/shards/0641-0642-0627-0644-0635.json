{"poems":[[65,"بمنشط الشيح من نجد لنا وطن","https://www.aldiwan.net/poem45681.html","البسيط"],[68,"وعدت جميلا وأخلفته","https://www.aldiwan.net/poem41580.html","المتقارب"],[50,"وشاطرِ أحورِ طاوي الحشا","https://www.aldiwan.net/poem66292.html","السريع"],[438,"يا حافظا طاول السماك علا","https://www.aldiwan.net/poem12400.html","المنسرح"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[466,"أقول لصحبي والمقال تكعه","https://www.aldiwan.net/poem16163.html","الطويل"],[473,"رأيت من لست له ذاكرا","https://www.aldiwan.net/poem59783.html","السريع"],[1008,"","https://poetry.dctabudhabi.ae/diwan/poem/95763","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203738","البسيط"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216500","المجتث"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70389","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87408","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87449","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""]],"verses":[["فَقالَ صَحبي غداةَ الشِّعبِ من حضَنٍ","وَالخَدُّ يَهمي عَلَيهِ واكِفٌ سَرِبُ",0,"ب",1,0],["فَقالَ صَدَقتَ وَلَكِنَّهُم","بِذاكَ دَروا أَنَّني الأَفضَلُ",1,"ل",1,0],["فقال صِلني وأقل عثرتي","واكتم على عبدِكَ لا تُفش",2,"ش",1,0],["فقالَ صَحْبِي نَزِّهْ جُفونَكَ في","رياضِ حُسْنٍ تكسو الرُّبا حُلَلا",3,"ل",2,0],["فقال صَحْبي أضلَّ هادٍ","أم خُدِعَ الحازمُ الأريبُ",4,"ب",1,0],["فقال صِحابي فُزْتَ بابن مناقبٍ","كريم مبيت الضَّيف ضخمٍ دسائعه",5,"ع",2,0],["فَقالَ صِف لي ما أَرى دُرَّهُ","لِلسَبَجِ الرَطبِ بِهِ يَحكي",6,"ك",2,0],["فقال صغيرٌ ليس يعلم صَنعةً","أُعلِّمه والأَجرُ لي كيف يُدخِل",7,"ل",1,0],["فقال صاحبُنا والحلمُ شيمته","رِفْقاً بنفسك يا سرحان واتئد",8,"د",1,0],["فقال صوني وفائي","غدا وصوني صغاري",9,"ر",2,0],["فقال صحَابي قَدْ هلكنا فقلتُ لا","هلاكَ علينا والدليلُ بصيرُ",10,"ر",1,0],["فَقالَ صبري قلَّ قُل","تُ وأنا صبري أَقَل",11,"ل",1,0],["فَقال صَعبٌ اذا تَجنىَّ","حِبٌّ فَفيهِ التَوَلُّهُ",12,"ه",1,0],["فقالَ صباحٌ قُلنَ غيرَ فواحشٍ","صباحاً وما إنْ قلنَ غيرَ التذمُّمِ",13,"م",1,0],["فقال صفني وأوجز","فقلت لم أر مثلك",14,"ك",1,0],["فَقالَ صِف لِيَ شَيئاً","مِنهُ فَإِنّي أُجيبُك",15,"ك",1,0],["فَقَالَ صَدَقتُ يا هَذَا وَإنِّي","لَبَعْلٌ صِرتُ (مِنكِ) لَكِ الشَّهِيَّا",16,"ي",2,0]]}