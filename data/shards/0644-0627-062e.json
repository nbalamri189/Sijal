,"https://www.aldiwan.net/poem22800.html","البسيط"],[46,"لا خير من بعد خمسين انقضت كملا","https://www.aldiwan.net/poem22860.html","البسيط"],[46,"خاب الذي سار عن دنياه مرتحلا","https://www.aldiwan.net/poem22981.html","البسيط"],[46,"نفس الفتى وليست له جسدا","https://www.aldiwan.net/poem23148.html","الكامل"],[46,"أما البليغ فإني لا أجادله","https://www.aldiwan.net/poem23168.html","البسيط"],[46,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85365","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85568","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85376","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54994","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12782","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43657","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116949","السريع"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116994","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[59,"لاَ خيرَ في المالِ لكنازهِ","https://www.poetsgate.com/ViewPoem.aspx?id=17320",""],[50,"عجِّلْ أَبَا مُحمَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21814",""],[78,"فيما مضى كنت بالأعياد مسرورا","https://www.poetsgate.com/ViewPoem.aspx?id=1465",""],[58,"صَرَمَتْ حِبَاْلَكَ بَعْدَ وَصْلِكَ زَيْنَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=22645",""],[51,"يختلُّ حولاً بخلال واحِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27622",""]],"verses":[["لا خَطَرَ الجودُ عَلى بالي وَلا","سَقَت يَدي يَومَ الطِعانِ ذابِلي",0,"ل",2,0],["لا خَوفَ وَالجَدُّ مُقبِلٌ أَبَداً","عَلى اللَيالي وَأَنتَ مُقتَبِلُ",1,"ل",1,0],["لَأَخفَقَ مَن عَلِقَت بِالمُنى","يَداهُ وَأَثرى الَّذي يَقنَعُ",2,"ع",1,0],["لاخَيرَ في دُنيا نَوائِبُها","تَدري وَداءُ مَنونِها يُعدي",3,"ي",1,0],["لا خافَ أَبناؤُكَ الَّذينَ بَقوا","حَدّاً مِنَ النائِباتِ مَذروبا",4,"ب",2,0],["لأُخمِدَنَّ لَظاها مِنهُمُ بِدَمٍ","يَعومُ فيهِ غِرارُ السَّيفِ مُختَضِبا",5,"ب",2,0],["لا خَطَرَ النَّعامُ فيكِ مَوْهِناً","يَريغُ تَوشيمَ الخِضابِ النّاصِلِ",6,"ل",1,0],["لأُخالِفَنَّ هوى العَذولِ فَطالما","أفضى المَلامُ بهِ إِلى الإغراءِ",7,"ا",2,0],["لَأَخرُجَنَّ مِنَ الدُنيا وَحُبُّكُمُ","بَينَ الجَوانِحِ لَم يَشعُر بِهِ أَحَدُ",8,"د",1,0],["لا خَيرَ في حَشوِ الكَلا","مِ إِذا اِهتَدَيتَ إِلى عُيونِهِ",9,"ن",2,1],["لأَخْلَقُ مِنْ جَفْنِي الْمُسَهَّدِ بِالْكَرَى","وَأَلْيَقُ بِالسِّرِّ الْمَصُونِ مِنَ الْكَتْمِ",10,"م",1,0],["لا خَيرَ فيمَن لَهُ أَصلٌ بِلا أَدَبٍ","حَتّى يَكونَ عَلى ما زانَهُ حَدِبا",11,"ب",2,0],["لَاِختارَ سَدَّ الفَتحَتَي","نِ وَقالَ يا جَيبُ اِحذَرِ",12,"ر",1,0],["لا خِلَّ بَعدَكَ مُؤنِسٌ","نَفسي وَلا قَلبٌ رَحيمُ",13,"م",1,0],["لِأُختَينِ صَفراوَينِ أَصبَحتَ واطِئاً","وَفي جَمعِكَ الأُختَينِ إِثمُكَ وَالعارُ",14,"ر",1,1],["لا خَيرَ في عَيشٍ وَإِن سَرَّنا","وَالدَهرُ لا تَبقى لَهُ باقِيَه",15,"ي",2,0],["لا خَيْرَ فِي زَمَنٍ إِذَا مَا طَاوَلَتْ","فِيهِ الصِّعَادُ عَوَالِي المُرَّانِ",16,"ن",1,0],["لا خَطْبَ أَكْبَرُ مِمَّا رَاعَ أَثْبَتَكُمْ","لَكِنْ أُعِيذُكُمُ أَنْ تَضْعُفَ الْهِمَمُ",17,"م",1,0],["لا خَطْبَ أَبْشَعُ مِنْ خَطْبِ الأُوَارِ وَقَدْ","بَاتَتْ حُشَاشَاتُهُمْ كَالنَّارِ تَضْطَرِمُ",18,"م",1,0],["لأخٍ لَكُمْ وَلَّى وَخَلَّفَ بَيْنَكُمْ","فَضَلَ الرَّئِيسِ الأَوَّلِ المِقْدَامِ",19,"م",1,0],["لا خَيرَ فيكَ سِوى كَلامٍ طَيِّبٍ","وَمَواعِدٍ تُدني وَفِعلٍ يُبعِدُ",20,"د",1,1],["لا خيرَ في نَثِّ الحدي","ثِ ولا الجَليسِ إذا فَطَن",21,"ن",1,0],["لِأِخفافِها بِاللَيلِ وَقعٌ كَأَنَّهُ","عَلى البيدِ تَرشافُ الظِماءِ السَوابِعِ",22,"ع",1,0],["لا خير في وطن يكون السيف عن","د جبانه والمال عند بخيله",23,"ل",2,0],["لأخلاق الوليد بك أنعكاس","كما انعكس الخيال على المرآة",24,"ه",1,0],["لا خير في تقوى امرئ لو لم يَخف","نار الجحيم للجّ في العصيان",25,"ن",1,0],["لا خَيرَ في مُستَعجِلاتِ المَلاوِمِ","وَلا في خَليلٍ وَصلُهُ غَيرُ دائِمِ",26,"م",1,1],["لا خطوتي تتعاطى غير موضعها","ولا يدي في حميت السَّكن تندخلُ",27,"ل",1,0],["لاخَيرَ في بِرِّ الفَتى مالَم يَكُن","أَصفى مَشارِبِ بِرِّهِ في بِشرِهِ",28,"ر",2,0],["لإخالهُ يوم القيا","مة باستِهِ يُؤتى كتابهْ",29,"ب",2,0],["لإخوانهِ ثُلثا مالهِ","وليس له منهُ إلا الثُّلُثْ",30,"ث",1,0],["لا خير في البادئ غير العائدِ","إن أبا موسى لَعينُ الماجدِ",31,"د",1,0],["لا خير في عيشٍ تَخَوَّنُنا","أوقاتُهُ وتَغولنا مُدَدُهْ",32,"د",2,0],["لا خفَّفَ اللَّهُ عنه من حسدي","وزاده اللَّه فوقه كمدَهْ",33,"د",2,0],["لا خير في نعمةٍ لا شكر يتبعها","ولا يدٍ عُرِّيَتْ منِ اصطناع يدِ",34,"د",1,0],["لا خير في غيره وهل أمَمٌ","من شاربِ الراح شارب السَّكرِ",35,"ر",1,0],["لا خير في نزع يدي نابلٍ","بعد لحوق النَصل بالمعجس",36,"س",1,0],["لأخسِرْ به من عاملٍ قدِرتْ له","مع السنِّ أعمالٌ ثِقالٌ حوابطُ",37,"ط",1,0],["لا خير في قرة للعين معقبة","دمعاً يخدد في الخدين ذرّافا",38,"ف",2,0],["لا خيرَ في ثروةٍ تحضُّ على ال","غدرِ صُراحاً وتمرِضُ الشيما",39,"م",2,0],["لا خَيرَ في الشَيءِ اِنقَضى وَقتُهُ","ما لِقَتيلٍ حاجَةٌ بِالطَبيب",40,"ب",1,0],["لا خُلودٌ تَحتَ السَماءِ لِحَيٍّ","فَلِماذا تُراوِدُ المُستَحيلا",41,"ل",2,0],["لا خَيرَ في طولِ الإِقامَةِ لِلفَتى","إِلّا إِذا ما لَم يَجِد مُتَحَوَّلا",42,"ل",2,0],["لا خَرقٌ إِن رقموا كتبا وَلا حَصرٌ","إِذ يَنتَدونَ ولا جَورٌ إِذا حَكَموا",43,"م",3,0],["لا خَدَّ إِلّا تَشكّى الجَدبَ ظاهِرهُ","وَلَيسَ إِلّا مَعَ الأَنفاسِ مَمطورا",44,"ر",2,0],["لا خير في مجتمع عقله","بسيء العادات مغلول",45,"ل",1,1],["لا خير في نقد امرئ","حديثه مرّجم",46,"م",1,0],["لا خير في النخلة الفرعاء قد بسقت","ولم تساقط على من تحتها ثمرا",47,"ر",2,0],["لا خير في ناس اذا","افحمتهم ولوا غضابا",48,"ب",2,0],["لا خمرة منه لي احسو سلافتها","ولا على كرمة الآمال عنقود",49,"د",1,0],["لا خير في الصبر والتأسى","إذا هما عارضا الوفاء",50,"ا",2,0],["لا خلقها الحلو الوسي","م ولا خلائقها نواضر",51,"ر",1,0],["لا خَيرَ في المُلكِ وَفي عِزِّهِ","إِن ضاقَ جاهُ اللَيثِ بِالضِفدَعِ",52,"ع",1,0],["لا خَيرَ في مِنبَرٍ حَتّى يَكونَ لَهُ","عودٌ مِنَ السُمرِ أَو عودٌ مِنَ القُضُبِ",53,"ب",1,0],["لا خَلقَ أَسمَحُ مِنكَ إِلّا عارِفٌ","بِكَ راءَ نَفسَكَ لَم يَقُل لَكَ هاتِها",54,"ت",3,0],["لا خَيلَ عِندَكَ تُهديها وَلا مالُ","فَليُسعِدِ النُطقُ إِن لَم تُسعِدِ الحالُ",55,"ل",1,1],["لَأُخَبِّرَنَّكَ عَن بَني الجَرّاحِ","وَعَتادِهِم مِن سُؤدُدٍ وَسَماحِ",56,"ح",1,0],["لِأَخي الحُبِّ عَبرَةٌ ما تَجِفُّ","وَغَرامٌ يُدوي الحَشا وَيَشُفُّ",57,"ف",1,1],["لأُخاطِرَنَّ وما المُنى","في الحُبِّ إلا للمُخاطر",58,"ر",1,0],["لا خَيرَ بَعدَكَ في الحَياةِ وَإِنَّما","أَبكي مَخافَةَ أَن تَطولَ حَياتي",59,"ي",1,0],["لا خَيرَ في وُدِّ اِمرِئٍ مُتَمَلِّقٍ","حُلوِ اللِسانِ وَقَلبُهُ يَتَلَّهَبُ",60,"ب",1,0],["لا خَيرَ لا خَيرَ لِلإِنسانِ في طَمَعٍ","يَصيرُ مِنهُ إِلى ذُلٍّ وَمَحقَرَةِ",61,"ر",2,0],["لا خَيرَ في الدُنيا لِذي بَصَرٍ","نَفِذَت لَهُ فيحا بَصائِرُهُ",62,"ر",2,0],["لا خَيرَ في المالِ إِلّا أَن تُقَدِّمَهُ","إِن لَم تُقَدِّمَهُ ما تَرجو مِنَ المالِ",63,"ل",1,0],["لا خَيرَ في الدُنيا لِمُغ","تَرٍّ بِها لا يَتَّقيها",64,"ي",3,0],["لا خِفتُ بُؤساً وَنائِلُ المَلِكِ ال","مَنصورِ لِلعالَمينِ قَد كَفِلا",65,"ل",2,0],["لَأَخمِصَنَّ الزَمانَ مُرتَجِلا","وَأَنظِمَنَّ القَريضَ مُرتَجَلا",65,"ل",2,0],["لا خُمارٌ لَها سِوى لُطفِ فِكرٍ","يَبسِطُ النَفسَ آخِرَ النَسَماتِ",66,"ت",1,0],["لا خير في قلم إذا هو لَم يكن","حراً طهوراً كالشعاع الهادي",67,"د",2,0],["لا خير في طب إذا هو لم يزر","ظلم الحياة كفرحة الأعيادِ",67,"د",1,0],["لا خير في الأرواح تسكن منزلاً","متهدماً رثاً من الأجسادِ",67,"د",1,0],["لا خير في الأرواح تسكن موطناً","متخاذلاً لا يرتجى لجلادِ",67,"د",1,0],["لا خَيرَ في قُربى بِغَيرِ مَوَدَّةٍ","وَلَرُبَّ مُنتَفِعٍ بِوُدِّ أَباعِدِ",68,"د",1,1],["لا خَفَّفَ الرَحمَنُ عَنّي إِنَّني","أَرتَعتُ ظَنّي في رِياضِ الباطِلِ",69,"ل",1,0],["لا خَلقَ أَربَطُ جَأشاً مِنكَ يَومَ تَرى","أَبا سَعيدٍ وَلَم يَبطِش بِكَ الزُؤُدُ",70,"د",1,0],["لا خَيرَ في الدُنيا وَبَهجَتِها","إِن لَم تُوافِق نَفسُها نَفسي",71,"س",2,0],["لا خَيرَ في الحُبِّ لَيسَت فيهِ قارِعَةٌ","كَأَنَّ صاحِبَها في نَزعِ مَوتونِ",72,"ن",1,0],["لا خيرَ في المتناحرينَ وإن أبوا","حتَّى تكونَ هَوادةٌ وأَناةُ",73,"ه",1,0],["لأخادعنَّ القومَ عن آمالهِم","وَلأَدفَعنَّ ضجيجَهم بَمِطالي",74,"ل",2,0],["لا خابَ جَدُّ القومِ إنّ إلههم","جمعَ القلوبَ على الهدى فتألَّفوا",75,"ف",3,0],["لا خَزايا لا نَدامَى إنّهم","زُمْرةٌ ما مِثلُها بين الزُّمَرْ",76,"ر",1,0],["لَأَخضَلتَ جوداً وَاِشتَعَلتَ نَباهَةً","فَزِندُكَ يوري حَيثُ غُصنُكَ يورِقُ",77,"ق",1,0],["لا خابَ سُؤلُكَ أَمّا","سُؤلي لَدَيكَ فَخابا",78,"ب",2,0],["لا خوْفَ إنْ قامَ البِنا","ء على الفضيلةِ وارتكنْ",79,"ن",1,0],["لا خَيرَ في رَجُلٍ يُجالِسُ عِرسَهُ","وَيَبيعُ قُرطَيها إِذا ما أَعدَما",80,"م",2,0],["لا خَيرَ في العالِمينَ كُلِّهِمُ","وَلا مِنَ العالَمينَ مُنفَرِدا",81,"د",2,1],["لا خَيرَ في الصَبِّ إِذا","كانَ غَليظَ الرَقَبَه",82,"ب",2,0],["لا خَيرَ لِلأَحياءِ في عَيشِهِم","بَعدَكَ وَالزُلفى لِأَهلِ القُبور",83,"ر",1,0],["لا خَيرَ في الثَعلَبِ في اِبتِكارِهِ","لا خَيرَ في الثَعلَبِ في اِبتِكارِهِم",84,"ر",3,0],["لا خَيرَ في اللَذّاتِ ما لَم يَكُن","صاحِبُها مُنكَشِفَ الراسِ",85,"س",1,0],["لا خَيرَ في العَيشِ إِلّا بِالمُدامِ مَعَ ال","أَكفاءِ في الوَردِ وَالخيرِيِّ وَالآسِ",86,"س",1,0],["لا خَرَّبَ اللَهُ كَرخَ السوسِ وَالسوسا","يَوماً وَلا مَجلِساً بِالسوسِ مَأنوسا",87,"س",2,1],["لا خَيرَ في العاشِقِ إِلّا فَتىً","لاطَفَ مَولاهُ وَداراهُ",88,"ا",2,0],["لَأَخرُجَنَّ مِنَ الدُنيا وَحُبُّهُمُ","بَينَ الجَوانِحِ لَم يَشعُر بِهِ أَحَد",89,"د",1,0],["لا خَيرَ في دُنيا الكَري","مِ وَلا اللَئيمِ عَنِ الوِدادِ",90,"د",1,0],["لا خَيرَ في عِدَةٍ لَيسَت بِمُنجَزَةٍ","فَأَنجِزي الوَعدَ إِنَّ الجودَ مَحمودُ",91,"د",1,0],["لا خَيرَ في العَيشِ إِن كُنّا كَذا أَبَداً","لا نَلتَقي وَسَبيلُ المُلتَقى نَهَجُ",92