{"poems":[[49,"أقناعة من بعد طول جفاء","https://www.aldiwan.net/poem25382.html","الكامل"],[108,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[309,"الناس في ضيق وفي حرج","https://www.aldiwan.net/poem16866.html","الكامل"],[382,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[473,"يا رب تاج صاغه خاطري","https://www.aldiwan.net/poem60126.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38981","المتدارك"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55922","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64855","الرجز"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122861","المنسرح"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112768","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102723","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97883","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89319","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89052","الكامل"],[4816,"ظروف الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=8458",""],[4816,"سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=8552",""],[4816,"عز الاصحاب","https://www.poetsgate.com/ViewPoem.aspx?id=12850",""],[4852,"بمحمد حرف المديح سيعبق","https://www.poetsgate.com/ViewPoem.aspx?id=214333",""],[4987,"سر الإبتعاد","https://www.poetsgate.com/ViewPoem.aspx?id=49553",""],[4987,"ترجل الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=49568",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5599,"جرح الفقد","https://www.poetsgate.com/ViewPoem.aspx?id=213840",""],[5677,"ميثاق غلا ...!","https://www.poetsgate.com/ViewPoem.aspx?id=179806",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5956,"الأغلَيان تُوُفِّيا وفتاهما..","https://www.poetsgate.com/ViewPoem.aspx?id=183597",""],[5956,"تبَقَّتْ ساعة لبلادنا نصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207169",""],[5976,"شفته مع الصبيان","https://www.poetsgate.com/ViewPoem.aspx?id=32095",""],[5977,"حاجة نفس","https://www.poetsgate.com/ViewPoem.aspx?id=213132",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""]],"verses":[["يارَبَّ تِلكَ المُقلَةِ النَجلاءِ","حاشاكَ مِمّا ضُمِّنَت أَحشائي",0,"ي",1,0],["يا رُبَّ تبرٍ في التراب وجرةٍ","وُضعت على رأسٍ مكان الغار",1,"ر",1,0],["يا رب تلك مسائل نظمت","لعبد سوء بمنطق لهج",2,"ج",1,0],["يا ربِّ تَوبَةَ ناصِحٍ مُتَنَصِّلٍ","يَذري الدُموعَ سَخينةً حَرّاءَ",3,"ا",2,0],["يا رُبَّ تاجٍ صاغَهُ خاطِري","مُرَصَّعٌ بِالجَواهِرِالفاخِرِ",4,"ر",1,1],["يا رَبِّ تَولَّ عِنايَتهُ","وَحِمايَتهُ وَصِيانَتهُ",5,"ه",1,0],["يا رب تمم حسن ما أبديته","كرماً وجمّله بأحسن مختتمْ",6,"م",1,0],["يا رَبِّ تَوفيقا لَنا وحِفْظاً","مِنْ كَرْبِ يومٍ نارُهُ تَلَظَّى",7,"ظ",2,1],["يا رب تفاحة خلوت بها","تشعل نار الهوى على كبدي",8,"د",2,1],["يا رب تمم مقصدي","واحتم بأنواع المسار",9,"ر",1,0],["يا رب تعلم ما يحب فاعطه","اقصى مرام ناله متبعد",10,"د",1,0],["يا ربّ تقصيري وعجزي لازمٌ","يا ربّ قابل بالقبول وسدد",11,"د",1,0],["يا رب تبتُ الآن هل من لمحةٍ","يحظى بها المتأسف المتأخر",12,"ر",1,0],["يا رب تكسبه خيراً وتنصره","بمولد زانه في ذلك الحرم",13,"م",1,0],["يا رب تحفظ ذاته","وتديم أحمد يا حميد",14,"د",1,0],["يا رب تجمعنا على خير لدروب","وتنور حياتي يوم باسمه تناديت",15,"ت",1,0],["يارب تحفظني من الناس مهيوف","يا اول حروفه ورابعه طينتيني",16,"ن",2,0],["يا رب تفتح له من الخير ابواب","وباب التقى والدين يا خير جيره",17,"ر",2,0],["يارب تدري ما بقلبِ من ارتجى","دمعاً بروضٍ ، والعيونُ تحدّقُ",18,"ق",1,0],["يا رب تهديني قبل لحظة الفوت","وتغفر ذنوبي يا كريم العطايا",19,"ا",3,0],["يارب تغفر له وترفع مقامه","وتعظّم أجر إمة محمد بخطاب",20,"ب",1,0],["يآرب تحميني من الخزي والعار","بين الخلايق يوم عرض ووفادة",21,"د",2,0],["يارب تسكنهم بجنتك يارب","وتعين من قلبه من الشوق ذايب",22,"ب",1,0],["يارب تقبل توبتي كل ماتبت","يارب تجعل طاعتك مبتغايه",23,"ا",3,0],["يارب تغفر زلتي وذنوبي","أنت الغفور القادر االتوّابي",24,"ب",2,0],["يَا رَبِّ تَوْباً لِعَبْدٍ جَاءَ مُرْتَجِياً","عَفْواً كَرِيماً لَرَبِّ الخَلْقِ عَنْ لَمَمِي",25,"م",2,0],["يارب تلك جراح الشام نازفة","وللعراق لسان بالأسى حاكِ",26,"ك",1,0],["يا رب تحرمُنا الأحبة عَنوة","فلم اختيارك أن تكون الحارما؟",27,"م",2,0],["يا ربُّ تعلم كم كابدتُ من ألمٍ","هل يا ترى بعذابِي الزوجُ تحتفلُ ؟؟",28,"ل",1,0],["يا رب تهدي كل من ظلّي","تهديه يا ربّي وتهديني",29,"ن",2,0],["يارب تعلم حاجتي وتضرعي","فامنن علي فأنت من يعطيها",30,"ي",3,0],["يا رب توأمتي لديك أمانة","فاطعم لها عنبا وحلو فطائر",31,"ر",1,0]]}