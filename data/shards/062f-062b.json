{"poems":[[215,"محطة الرمل جننتني","https://www.aldiwan.net/poem46262.html","مخلع البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114146","الطويل"],[4691,"أشرقي يا شروق أنت ِ الشروق ُ","https://www.poetsgate.com/ViewPoem.aspx?id=126247",""],[4818,"كعبة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=203507",""],[5064,"محاولات تيه متشرّد","https://www.poetsgate.com/ViewPoem.aspx?id=199152",""],[5092,"العيش في ذكرى الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=153631",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5121,"لَيْتَ شِعْرِي","https://www.poetsgate.com/ViewPoem.aspx?id=215772",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5431,"دثرتني بنورها صنعاءُ...","https://www.poetsgate.com/ViewPoem.aspx?id=200425",""],[5431,"دثروها فإنها تتشظى...","https://www.poetsgate.com/ViewPoem.aspx?id=201028",""],[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5956,"ساقية","https://www.poetsgate.com/ViewPoem.aspx?id=183161",""],[5997,"بعثريني","https://www.poetsgate.com/ViewPoem.aspx?id=214249",""],[6143,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=34307",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["دثرتها حين تبدت","بالأجمال الفخم من ثيابي",0,"ب",2,0],["دِثَارُهُ خُلقٌ لاَحَ فِي نُونُ بُردِهِ","وَمَازَاغَ طَرفٌ أبدَتش الطَّرزَ فِي البُردِ",1,"د",1,0],["دثريني بنور عطفِكِ ليلا","فصباحي ضياؤه مشقوق",2,"ق",1,0],["دثرْتُ قِصّتنا بحلّةِ يُوسُفٍ","في أحمرٍ بَهِجٍ يضجُّ بأخضرِ",3,"ر",1,0],["دَثَّرِي التِّيهَ وانْزَعِي فِيكِ جِلبَا","بِي، تَحَدَّتْنِي فِي هَوَاهَا السِّنينُ",4,"ن",1,0],["دَثَّرتُ أحلامي بآهاتِ الجوى","ثارتْ بقاياها بصمتي ظاهرهْ",5,"ر",2,0],["دَثِّرِيِنِي يَا صِفَات الْ","خَيْرِ إِذْعَاناً وَجَوْرَا",6,"ر",2,0],["دَثِّرُونِي بِلَا لِحَافٍ فَإِنِّي","مِنْ سَنَاءٍ وَلَيْسَ يُدْفِئُ كِنِّي",7,"ن",2,0],["دثار الصدق كان له رداء","تبدى فوق من فخروا مهيبا",8,"ب",2,0],["دثار الطهر نبراس البرايا","وحسن الخلق معيار الوفاء",9,"ا",2,0],["دُثِّرْتَ فيها وداع الحقِ يقصدُها","أينَ المفرُّ بهذا الدينِ فاستلمِ",10,"م",1,0],["دثرتني بنورها صنعاءُ","ربّة الحسنِ قلعةٌ شمّاءُ",11,"ا",2,1],["دثروها فإنها تتشظى","خانها الجهل مُفقّئ العين فظّا",12,"ظ",2,1],["دثروني بخبثهم ياإلهي!","طعنَ القلبَ خلسةً أعدقاءُ!!",13,"ا",2,0],["دثَرتْني راضيةْ","بأهازيجِ الخريرْ",14,"ر",1,0],["دثريني في حنينٍ لي توالى","وابعثيني من جوى قلبا تدثَّر",15,"ر",1,0],["دثريني دثريني","عن همومي أبعديني",16,"ن",2,1],["دثريني دثريني","عن ذنوبي أبعديني",16,"ن",2,0],["دثريني دثريني","عن خصومي أخبريني",16,"ن",2,0],["دثريني زمليني","بين جنبيك ضعيني",16,"ن",2,0],["دثرّي جرحي فلا تطفؤه","كلّ ريح جرحها مندمل",17,"ل",1,0]]}