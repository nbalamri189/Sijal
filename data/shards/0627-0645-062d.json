.poetsgate.com/ViewPoem.aspx?id=210819",""],[4578,"فرق المليحة قد أضا أم فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=49398",""],[5121,"حَيَّرَتْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=214885",""],[5147,"خطب كما تعلمونه صعب","https://www.poetsgate.com/ViewPoem.aspx?id=166695",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5183,"الصاروخ","https://www.poetsgate.com/ViewPoem.aspx?id=180184",""],[5183,"السمحاء","https://www.poetsgate.com/ViewPoem.aspx?id=180179",""],[5212,"نِداءُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212030",""],[5353,"طائر الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=212468",""],[5409,"أمحتضن الوادي حضانة مرضعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155273",""],[5561,"تحدّي الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=192956",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5582,"عَبَثَ الهَوَى بِكَ حَيْثُ كُنْتَ العابِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186766",""],[5582,"لا تُكْثِرا فِي اللَّوْمِ مِنْ تَفْنِيدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63502",""],[5595,"شيخ الطريقة شيخٌ لا نظيرَ له","https://www.poetsgate.com/ViewPoem.aspx?id=144758",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[402,"ماذا تعيضك من صباك","https://www.poetsgate.com/ViewPoem.aspx?id=36030",""],[5956,"لقاؤك يا بدور","https://www.poetsgate.com/ViewPoem.aspx?id=182189",""],[5956,"أرملةٌ حنونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194737",""],[6008,"بمناسبة شفاء الملك عبدالله بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=61399",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[6335,"قراءة في قسمات وجه عربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65401&r=&rc=3",""],[5567,"أدخل في الغيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81750&r=&rc=22",""]],"verses":[["أُمحص في هواك بها فأجلى","جلاء التبر إن نفض الترابا",0,"ب",2,0],["أمحمد من أنت؟ أنت عدالة","وصبابة حرى بأحشاء الحمى",1,"م",2,0],["أمُحَمَّدُ وَالْحَمْدُ مِنْكَ سَجِيَّةٌ","بِحُلِيِّهَا بَيْنَ الْوَرَى يُتَجَمَّلُ",2,"ل",1,0],["أمُحمّدُ المحْمودُ دُمْ في عصْمَةٍ","للهِ يمْضي حُكْمَها المِقْدارُ",3,"ر",1,0],["أَمُحَمَّدٌ أَبْلَيْتَ دِينَ مُحَمَّدٍ","حُسْنَى بَقَاءِ الذِّكْرِ مِنْ حَسَنَاتِهَا",4,"ت",3,0],["أَمَحلَّ وَالِدِيَ الَّذِي لِجَنَابِهِ","آوي وَفِي مَرْضَاتِهِ أَتقَلَّبُ",5,"ب",1,0],["أَمَحجوبَةٌ لَيلى وَلَم تُخضَبِ القَنا","وَلا حَجَبَت شَمسَ الضَحاءِ القَساطِلُ",6,"ل",1,0],["أَمَحْجُوبُ المَعَانِي وَالمَعَانِي","بِوَجْهِكَ ظَاهِرَاتٌ عَنْ يَقِينِ",7,"ن",1,0],["أَمُحَرِّرُ الْعَرَبِيَّةِ الْفُصْحَى الَّتِي","أَخْلَصْتَهَا مِنْ شَائِبَاتِ المُعْجَمِ",8,"م",1,0],["أَمَحْجُوبُ خَطْبُكَ رَاعَ البِلادَ","وَقَدْ كُنْتَ فِيهَا الطَّبِيبَ العَلِيمَا",9,"م",2,0],["أمَّ حفصٍ صلْعة الشَّي","خِ أبي حَفْصٍ فديْتُكْ",10,"ك",1,1],["أمحضُك النصحَ غيرَ محتشمٍ","هل ماحِضٌ نصحَه من احتشما",11,"م",2,0],["أَم حَسِبتَ الجَيشَ مُبتَعِداً","وَهوَ أَدنى مِن يَدٍ لِفَمِ",12,"م",1,0],["أَمُحَمَّدٌ وَالجودُ فيكَ سَجِيَّةٌ","يَهنيكَ طَيِّبُ ذِكرِها يَهنيكا",13,"ك",2,1],["أمحمد لا تحسبن ال","صفع لم يصغ إليه",14,"ه",1,1],["أمحمد فرغت حقيبتك التي","أخرجت منها قول كل حكيم",15,"م",1,1],["أَمُحَرِّمَ الأَجفانِ إِدناءَ الكَرى","يَهنيكَ ما حَرَّمَت حينَ تَنامُ",16,"م",1,0],["أَم حاكِمٌ في أَرضِ مِصرَ بِأَمرِهِ","لا سائِلاً أَبَداً وَلا مَسؤولا",17,"ل",2,0],["أَمُحَمَّدَ بنَ عَلِيٍّ اِسمَع عِذرَةً","فيها دَواءٌ لِلمُسيءِ وَداءُ",18,"ا",2,0],["أَمَحَلَّتَي سَلمى بِكاظِمَةَ اِسلَما","وَتَعَلَّما أَنَّ الجَوى ما هِجتُما",19,"م",2,1],["أمحمدُ بنُ عليٍّ احتفلَ الحَيا","ودُموعُنا فَهُما عليكَ سِجامُ",20,"م",1,0],["أمحلَّ صبوتِنا دعاءُ مَشوَّقٍ","يرتاحُ منك إلى الهَوى المَوموقِ",21,"ق",1,1],["أم حدثَت حَيْرَةٌ مواصلة","في الجوّ بَينَ البُطَيْنِ والنّطحِ",22,"ح",1,0],["أَمُحَمَّدَ بنَ سَعيدٍ اِدَّخِرِ الأُسى","فيها رُواءُ الحُرِّ يَومَ ظِمائِهِ",23,"ا",3,1],["أَم حَديثٌ جاءَهُ كَذِبٌ","أَم بِهِ هَجرٌ فَقَد هَجَرا",24,"ر",2,0],["أَمُحيِيَةَ القَلبِ ضِدُّ اِسمِها","أَرَقَّ وَأَصفى مِنَ الجَوهَرِ",25,"ر",1,1],["أَمحَضَ اللَهُ لَهُ أَخلاقَهُ","فَهيَ كَالإِبريزِ مِن سِرِّ الذَهَب",26,"ب",1,0],["أمُحْتَذِيَ الأهِلّةِ غَيْرَ زَهْوٍ","سَلَبْتَ مِن الحُلِيّ شهورَ عامِ",27,"م",1,0],["أم حومةُ السودانِ وهي صحيفة","السيف خطّ سطورها واللهذمُ",28,"م",1,0],["أمحاها الزمانُ أم حجبتها","من عواديه ماحياتُ البدورِ",29,"ر",1,0],["أم حسداً والأهل أهل للحسد","لو استطاع أنكر الرأس الجسد",30,"د",1,0],["أَمُحَمَّدُ اقْرَرْ فِي جَوا","رِ اللهِ فَهْوَ قدِ اصْطَفَاكْ",31,"ك",1,0],["أَمْحَمَّدُ انْعَمْ بِالْخُلُو","دِ وَطَابَ بِالذِّكْرَى ثرَاك",31,"ك",1,0],["أم حنين إلى الحبيب الذي أقسمَ","أن لا يطيرَ عنك فطارا",32,"ر",2,0],["أمُحِبُّكَ يدخُلُ مَجْلسه","فيقال أهَذَا مَسْجدُهُ",33,"د",2,0],["أَمُحَمَّدٌ يا زِينَةَ الْ","فِتْيَانِ يا نَسْلَ الأَكابِرْ",34,"ر",1,0],["أمحمدٌ، منِّي إليكَ نصيحةٌ","لكَ سوف أبْذُلها، وَلِي دِينار",35,"ر",1,0],["أمحمد مهدت شرع محمد","نعم المهاد لنا ونعم الماهد",36,"د",1,0],["امحضهم نصائحا لو ذهبت","الى جماد ذاب أو ماء جسا",37,"ا",1,0],["أمحي رسوم الأنس إن شئت أن تبقي","ذمائي فوف من ودادكم حقي",38,"ق",2,1],["امحُ عنها ذُلَّ ارهاقِ العِدى","أنها ما عُوِّدَت عاراً يَشين",39,"ن",1,0],["أمحق الله ساع ولف الهيام وقطع صيب","من يبكّي مقلتين الشجاع ابن الشجاع",40,"ع",1,0],["امحضك النصيحة والتصابي","يزحزحني لحبي عن مراحى",41,"ح",2,0],["أمحرر الشعب الهضيم","وناشر الحق الدفين",42,"ن",1,0],["أَم حالَت القِرطاسُ كافُوراً بِهَا","فَسَرَت تَمجّ عَلَيهِ مِسكاً أَذفَرا",43,"ر",2,0],["أمحمدُ بن محمدِ بن المرتضى","إنا لفي شُغُلٍ وإنك تَعلمُ",44,"م",1,1],["أمحمدٌ هنيتُ بالخير الذي","أمسى على أبوابكم متراكما",45,"م",2,0],["أمحمدُ بن محمدِ بنِ محمدٍ","وعُلاكَ منِصتةٌ تجيبُ وتسمَعُ",46,"ع",1,0],["أَم حِجاهُ أَم حِلمِهِ حينَ يَهفوُ","حِلمُ قَيسٍ وَحِلمُ ذي الأَطوادِ",47,"د",1,0],["أم حرقَتي وهواجسي ووساوسي","وتذمّري وتمَلملي في مضجعي",48,"ع",2,0],["أَمحقي ذِكرَياتِ أَمس فَخَيرٌ","لَكِ أَلّا يَبقى لِأمسٍ سُلالَه",49,"ل",2,0],["أَمحقيها بِحَقِّ روحي وَحُبّي","أَمحَقيها فَالذِكرَياتُ ضَلالَه",49,"ل",2,0],["إِمحي السَوادَ عَن الأَهدابِ في المُقل","وَاِمحي اِحمرارا اللمى المَمزوحِ بَالقُبلِ",50,"ل",1,1],["أَمحيطٌ بكلِّ شَيءٍ وَمردٍ","كلَّ حيٍّ وَتاركُ السَهلِ وعرا",51,"ر",2,0],["أَمَحْبُوبَ قَلْبِي قَدْ تَنَاهَى سُرُورُهُ","فَبَانَتْ فَأَزْرَتْ بِالْجُمَانِ ثُغُورُهُ",52,"ر",2,1],["أَمحمد ومحمد لِلَّه من","جَبَلَين يَحمي كل من بكما اِحتَمى",53,"م",2,0],["أمحمد بن الشيخ يا فخر القضا","يا معدن العرفان يا إكليل",54,"ل",1,1],["أمحمد قل للسعادة مرحبا","وابشر برفعة رتبة ونشان",55,"ن",1,0],["أَمحمّد رزءاً بمثلك لا نرى","إلّا برزء محمّدٍ تفريجه",56,"ج",2,0],["أمحو خطيئاتي بإخلاصي بها","وأحط أوزاري وإصر ذنوبي",57,"ب",2,0],["أَمحو الَّذي أَثبَتُّ مِن حُسنِها","وَأَشهَدُ الإِثباتَ بِالمَحوِ",58,"و",1,0],["أَمَحمود قَد أَحسَنت أَحسَنَت منعماً","وَما أَنا للإِحسانِ مُستَحسَن وَحدي",59,"د",2,0],["أمحمود الفضائل والسَّجايا","حَمِدْتُ من الأَنام على فعالك",60,"ك",1,0],["أمحملى عيب الهوى لقد اشتفى","داء الجوى من قلبيَ المعمودِ",61,"د",1,0],["أمحدثي بنقا العقيق أعد لنا","فيه الحديث موشحاً بدواته",62,"ت",2,0],["أمحمدٌ إن الذنوب عظيمةٌ","وبكاؤنا من عظمها غربالها",63,"ل",3,0],["أمحمدٌ ما كنتَ خامس عاهلٍ يقظٍ","يَهابُ جلاله الفجَّارُ",64,"ر",1,0],["أم حبلُ كلِّ مودّة في راحة","نكَّاثةٍ بالغدر كلَّ قرينِ",65,"ن",1,0],["أمُحمَّدٌ ولقد دعوتُ مُمَدَّحاً","ومن النَّجاح نداءُ سمْحٍ مُفْضلِ",66,"ل",1,0],["أم حسبن الرماحَ سمر قدودٍ","رقصت والدّماءَ مثل الخمور",67,"ر",1,0],["أَمُحَسِّنُ بنُ المِلحِ لا تَكُ تائِهاً","وَاِرجِع إِلى مِقدارِكَ المَعروفِ",68,"ف",1,1],["أَمحَقِقِّ الآمالَ بِالكَرَمِ الَّذي","أَحيا العُفاةَ وَبَخَّلَ الكُرَماءَ",69,"ا",2,0],["أَمحَقُ كلِّي فيهِمْ","ولم يكنْ ما وَجَبَا",70,"ب",2,0],["أمُحَلِّلا أكفانَه","رِفقاً بِه شَلَّت يَدَاك",71,"ك",1,0],["أمحمدٌ غرِّيطُ ربُّ القولِ مَن","بهِ عصرُنا هذا يفوقُ عُصورا",72,"ر",2,0],["أمُحِقٌّ أنا بِربِّكَ أم لا","أيها السَّامعُون هل من جَوابِ",73,"ب",1,0],["اِمّحى نو