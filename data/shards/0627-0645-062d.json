{"poems":[[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"يا من به للملة استبشار","https://www.aldiwan.net/poem36429.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[93,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[93,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[51,"أم حفص صلعة الشيخ","https://www.aldiwan.net/poem65802.html","مجزوء الرمل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[70,"أمحمد والجود فيك سجية","https://www.aldiwan.net/poem42784.html","الكامل"],[85,"أمحمد لا تحسبن الصفع لم يصغ إليه","https://www.aldiwan.net/poem7541.html","مجزوء الكامل"],[85,"أمحمد فرغت حقيبتك التي","https://www.aldiwan.net/poem7571.html","الكامل"],[85,"ذاد الكرى عن مقلتيك حمام","https://www.aldiwan.net/poem63014.html","الكامل"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[61,"أمحل صبوتنا دعاء مشوق","https://www.aldiwan.net/poem51532.html","السريع"],[80,"يا ليل هجر الحبيب طلت على","https://www.aldiwan.net/poem31525.html","المنسرح"],[44,"أمحمد بن سعيد ادخر الأسى","https://www.aldiwan.net/poem30324.html","الكامل"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[48,"أمحيية القلب ضد اسمها","https://www.aldiwan.net/poem63329.html","المتقارب"],[50,"وأخ ذي ثقة آخيته","https://www.aldiwan.net/poem64820.html","الرمل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""]],"verses":[["أمحمد من أنت؟ أنت عدالة","وصبابة حرى بأحشاء الحمى",0,"م",2,0],["أمُحَمَّدُ وَالْحَمْدُ مِنْكَ سَجِيَّةٌ","بِحُلِيِّهَا بَيْنَ الْوَرَى يُتَجَمَّلُ",1,"ل",1,0],["أمُحمّدُ المحْمودُ دُمْ في عصْمَةٍ","للهِ يمْضي حُكْمَها المِقْدارُ",2,"ر",1,0],["أَمُحَمَّدٌ أَبْلَيْتَ دِينَ مُحَمَّدٍ","حُسْنَى بَقَاءِ الذِّكْرِ مِنْ حَسَنَاتِهَا",3,"ت",3,0],["أَمَحلَّ وَالِدِيَ الَّذِي لِجَنَابِهِ","آوي وَفِي مَرْضَاتِهِ أَتقَلَّبُ",4,"ب",1,0],["أَمَحجوبَةٌ لَيلى وَلَم تُخضَبِ القَنا","وَلا حَجَبَت شَمسَ الضَحاءِ القَساطِلُ",5,"ل",1,0],["أَمَحْجُوبُ المَعَانِي وَالمَعَانِي","بِوَجْهِكَ ظَاهِرَاتٌ عَنْ يَقِينِ",6,"ن",1,0],["أَمُحَرِّرُ الْعَرَبِيَّةِ الْفُصْحَى الَّتِي","أَخْلَصْتَهَا مِنْ شَائِبَاتِ المُعْجَمِ",7,"م",1,0],["أَمَحْجُوبُ خَطْبُكَ رَاعَ البِلادَ","وَقَدْ كُنْتَ فِيهَا الطَّبِيبَ العَلِيمَا",8,"م",2,0],["أمَّ حفصٍ صلْعة الشَّي","خِ أبي حَفْصٍ فديْتُكْ",9,"ك",1,1],["أمحضُك النصحَ غيرَ محتشمٍ","هل ماحِضٌ نصحَه من احتشما",10,"م",2,0],["أَم حَسِبتَ الجَيشَ مُبتَعِداً","وَهوَ أَدنى مِن يَدٍ لِفَمِ",11,"م",1,0],["أَمُحَمَّدٌ وَالجودُ فيكَ سَجِيَّةٌ","يَهنيكَ طَيِّبُ ذِكرِها يَهنيكا",12,"ك",2,1],["أمحمد لا تحسبن ال","صفع لم يصغ إليه",13,"ه",1,1],["أمحمد فرغت حقيبتك التي","أخرجت منها قول كل حكيم",14,"م",1,1],["أَمُحَرِّمَ الأَجفانِ إِدناءَ الكَرى","يَهنيكَ ما حَرَّمَت حينَ تَنامُ",15,"م",1,0],["أَم حاكِمٌ في أَرضِ مِصرَ بِأَمرِهِ","لا سائِلاً أَبَداً وَلا مَسؤولا",16,"ل",2,0],["أَمُحَمَّدَ بنَ عَلِيٍّ اِسمَع عِذرَةً","فيها دَواءٌ لِلمُسيءِ وَداءُ",17,"ا",2,0],["أَمَحَلَّتَي سَلمى بِكاظِمَةَ اِسلَما","وَتَعَلَّما أَنَّ الجَوى ما هِجتُما",18,"م",2,1],["أمحمدُ بنُ عليٍّ احتفلَ الحَيا","ودُموعُنا فَهُما عليكَ سِجامُ",19,"م",1,0],["أمحلَّ صبوتِنا دعاءُ مَشوَّقٍ","يرتاحُ منك إلى الهَوى المَوموقِ",20,"ق",1,1],["أم حدثَت حَيْرَةٌ مواصلة","في الجوّ بَينَ البُطَيْنِ والنّطحِ",21,"ح",1,0],["أَمُحَمَّدَ بنَ سَعيدٍ اِدَّخِرِ الأُسى","فيها رُواءُ الحُرِّ يَومَ ظِمائِهِ",22,"ا",3,1],["أَم حَديثٌ جاءَهُ كَذِبٌ","أَم بِهِ هَجرٌ فَقَد هَجَرا",23,"ر",2,0],["أَمُحيِيَةَ القَلبِ ضِدُّ اِسمِها","أَرَقَّ وَأَصفى مِنَ الجَوهَرِ",24,"ر",1,1],["أَمحَضَ اللَهُ لَهُ أَخلاقَهُ","فَهيَ كَالإِبريزِ مِن سِرِّ الذَهَب",25,"ب",1,0],["أمُحْتَذِيَ الأهِلّةِ غَيْرَ زَهْوٍ","سَلَبْتَ مِن الحُلِيّ شهورَ عامِ",26,"م",1,0],["أم حومةُ السودانِ وهي صحيفة","السيف خطّ سطورها واللهذمُ",27,"م",1,0],["أمحاها الزمانُ أم حجبتها","من عواديه ماحياتُ البدورِ",28,"ر",1,0],["أم حسداً والأهل أهل للحسد","لو استطاع أنكر الرأس الجسد",29,"د",1,0],["أَمُحَمَّدُ اقْرَرْ فِي جَوا","رِ اللهِ فَهْوَ قدِ اصْطَفَاكْ",30,"ك",1,0],["أَمْحَمَّدُ انْعَمْ بِالْخُلُو","دِ وَطَابَ بِالذِّكْرَى ثرَاك",30,"ك",1,0],["أم حنين إلى الحبيب الذي أقسمَ","أن لا يطيرَ عنك فطارا",31,"ر",2,0],["أمُحِبُّكَ يدخُلُ مَجْلسه","فيقال أهَذَا مَسْجدُهُ",32,"د",2,0],["أَمُحَمَّدٌ يا زِينَةَ الْ","فِتْيَانِ يا نَسْلَ الأَكابِرْ",33,"ر",1,0],["أمحمدٌ، منِّي إليكَ نصيحةٌ","لكَ سوف أبْذُلها، وَلِي دِينار",34,"ر",1,0],["أمحي رسوم الأنس إن شئت أن تبقي","ذمائي فوف من ودادكم حقي",35,"ق",2,1],["امحُ عنها ذُلَّ ارهاقِ العِدى","أنها ما عُوِّدَت عاراً يَشين",36,"ن",1,0]]}