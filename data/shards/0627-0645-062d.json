{"poems":[[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"يا من به للملة استبشار","https://www.aldiwan.net/poem36429.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[93,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[93,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[51,"أم حفص صلعة الشيخ","https://www.aldiwan.net/poem65802.html","مجزوء الرمل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[70,"أمحمد والجود فيك سجية","https://www.aldiwan.net/poem42784.html","الكامل"],[85,"أمحمد لا تحسبن الصفع لم يصغ إليه","https://www.aldiwan.net/poem7541.html","مجزوء الكامل"],[85,"أمحمد فرغت حقيبتك التي","https://www.aldiwan.net/poem7571.html","الكامل"],[85,"ذاد الكرى عن مقلتيك حمام","https://www.aldiwan.net/poem63014.html","الكامل"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[61,"أمحل صبوتنا دعاء مشوق","https://www.aldiwan.net/poem51532.html","السريع"],[80,"يا ليل هجر الحبيب طلت على","https://www.aldiwan.net/poem31525.html","المنسرح"],[44,"أمحمد بن سعيد ادخر الأسى","https://www.aldiwan.net/poem30324.html","الكامل"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[48,"أمحيية القلب ضد اسمها","https://www.aldiwan.net/poem63329.html","المتقارب"],[50,"وأخ ذي ثقة آخيته","https://www.aldiwan.net/poem64820.html","الرمل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[113,"اخا الاشجان حي على الفلاح","https://www.aldiwan.net/poem41176.html","عموديه"],[122,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[123,"سائل بغرته الهلال المقمرا","https://www.aldiwan.net/poem4089.html","الكامل"],[126,"أمحمد بن محمد بن المرتضى","https://www.aldiwan.net/poem50511.html","الكامل"],[133,"حدث بذكر عريب ذياك الحمى","https://www.aldiwan.net/poem49129.html","الكامل"],[140,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[195,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[221,"كيف حال المريض ماذا جرى له","https://www.aldiwan.net/poem41605.html","الخفيف"],[221,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[223,"غاض ماء الحياء من كل وجه","https://www.aldiwan.net/poem55142.html","الخفيف"],[235,"أمحبوب قلبي قد تناهى سروره","https://www.aldiwan.net/poem18817.html","الطويل"],[269,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[283,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[283,"سعد الأمين وأزهرت أفراحه","https://www.aldiwan.net/poem39418.html","الكامل"],[303,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[308,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[347,"أثبت ما عاينت من نحوها","https://www.aldiwan.net/poem16022.html","السريع"],[403,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[413,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[434,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[451,"يا مالكا لا عن وراثة شامخ","https://www.aldiwan.net/poem61646.html","الكامل"],[456,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[459,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[462,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[466,"أمحسن بن الملح لا تك تائها","https://www.aldiwan.net/poem59871.html","الكامل"],[491,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[498,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[536,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[536,"شعراء مغربنا وأنت إمامهم","https://www.aldiwan.net/poem48175.html","عموديه"],[536,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[549,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[556,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[556,"ألا إن ذاتي ذات كل الخلائق","https://www.aldiwan.net/poem34328.html","الطويل"],[562,"أمحمود الشمائل دمت سام","https://www.aldiwan.net/poem844.html",""]],"verses":[["أمحمد من أنت؟ أنت عدالة","وصبابة حرى بأحشاء الحمى",0,"م",2,0],["أمُحَمَّدُ وَالْحَمْدُ مِنْكَ سَجِيَّةٌ","بِحُلِيِّهَا بَيْنَ الْوَرَى يُتَجَمَّلُ",1,"ل",1,0],["أمُحمّدُ المحْمودُ دُمْ في عصْمَةٍ","للهِ يمْضي حُكْمَها المِقْدارُ",2,"ر",1,0],["أَمُحَمَّدٌ أَبْلَيْتَ دِينَ مُحَمَّدٍ","حُسْنَى بَقَاءِ الذِّكْرِ مِنْ حَسَنَاتِهَا",3,"ت",3,0],["أَمَحلَّ وَالِدِيَ الَّذِي لِجَنَابِهِ","آوي وَفِي مَرْضَاتِهِ أَتقَلَّبُ",4,"ب",1,0],["أَمَحجوبَةٌ لَيلى وَلَم تُخضَبِ القَنا","وَلا حَجَبَت شَمسَ الضَحاءِ القَساطِلُ",5,"ل",1,0],["أَمَحْجُوبُ المَعَانِي وَالمَعَانِي","بِوَجْهِكَ ظَاهِرَاتٌ عَنْ يَقِينِ",6,"ن",1,0],["أَمُحَرِّرُ الْعَرَبِيَّةِ الْفُصْحَى الَّتِي","أَخْلَصْتَهَا مِنْ شَائِبَاتِ المُعْجَمِ",7,"م",1,0],["أَمَحْجُوبُ خَطْبُكَ رَاعَ البِلادَ","وَقَدْ كُنْتَ فِيهَا الطَّبِيبَ العَلِيمَا",8,"م",2,0],["أمَّ حفصٍ صلْعة الشَّي","خِ أبي حَفْصٍ فديْتُكْ",9,"ك",1,1],["أمحضُك النصحَ غيرَ محتشمٍ","هل ماحِضٌ نصحَه من احتشما",10,"م",2,0],["أَم حَسِبتَ الجَيشَ مُبتَعِداً","وَهوَ أَدنى مِن يَدٍ لِفَمِ",11,"م",1,0],["أَمُحَمَّدٌ وَالجودُ فيكَ سَجِيَّةٌ","يَهنيكَ طَيِّبُ ذِكرِها يَهنيكا",12,"ك",2,1],["أمحمد لا تحسبن ال","صفع لم يصغ إليه",13,"ه",1,1],["أمحمد فرغت حقيبتك التي","أخرجت منها قول كل حكيم",14,"م",1,1],["أَمُحَرِّمَ الأَجفانِ إِدناءَ الكَرى","يَهنيكَ ما حَرَّمَت حينَ تَنامُ",15,"م",1,0],["أَم حاكِمٌ في أَرضِ مِصرَ بِأَمرِهِ","لا سائِلاً أَبَداً وَلا مَسؤولا",16,"ل",2,0],["أَمُحَمَّدَ بنَ عَلِيٍّ اِسمَع عِذرَةً","فيها دَواءٌ لِلمُسيءِ وَداءُ",17,"ا",2,0],["أَمَحَلَّتَي سَلمى بِكاظِمَةَ اِسلَما","وَتَعَلَّما أَنَّ الجَوى ما هِجتُما",18,"م",2,1],["أمحمدُ بنُ عليٍّ احتفلَ الحَيا","ودُموعُنا فَهُما عليكَ سِجامُ",19,"م",1,0],["أمحلَّ صبوتِنا دعاءُ مَشوَّقٍ","يرتاحُ منك إلى الهَوى المَوموقِ",20,"ق",1,1],["أم حدثَت حَيْرَةٌ مواصلة","في الجوّ بَينَ البُطَيْنِ والنّطحِ",21,"ح",1,0],["أَمُحَمَّدَ بنَ سَعيدٍ اِدَّخِرِ الأُسى","فيها رُواءُ الحُرِّ يَومَ ظِمائِهِ",22,"ا",3,1],["أَم حَديثٌ جاءَهُ كَذِبٌ","أَم بِهِ هَجرٌ فَقَد هَجَرا",23,"ر",2,0],["أَمُحيِيَةَ القَلبِ ضِدُّ اِسمِها","أَرَقَّ وَأَصفى مِنَ الجَوهَرِ",24,"ر",1,1],["أَمحَضَ اللَهُ لَهُ أَخلاقَهُ","فَهيَ كَالإِبريزِ مِن سِرِّ الذَهَب",25,"ب",1,0],["أمُحْتَذِيَ الأهِلّةِ غَيْرَ زَهْوٍ","سَلَبْتَ مِن الحُلِيّ شهورَ عامِ",26,"م",1,0],["أم حومةُ السودانِ وهي صحيفة","السيف خطّ سطورها واللهذمُ",27,"م",1,0],["أمحاها الزمانُ أم حجبتها","من عواديه ماحياتُ البدورِ",28,"ر",1,0],["أم حسداً والأهل أهل للحسد","لو استطاع أنكر الرأس الجسد",29,"د",1,0],["أَمُحَمَّدُ اقْرَرْ فِي جَوا","رِ اللهِ فَهْوَ قدِ اصْطَفَاكْ",30,"ك",1,0],["أَمْحَمَّدُ انْعَمْ بِالْخُلُو","دِ وَطَابَ بِالذِّكْرَى ثرَاك",30,"ك",1,0],["أم حنين إلى الحبيب الذي أقسمَ","أن لا يطيرَ عنك فطارا",31,"ر",2,0],["أمُحِبُّكَ يدخُلُ مَجْلسه","فيقال أهَذَا مَسْجدُهُ",32,"د",2,0],["أَمُحَمَّدٌ يا زِينَةَ الْ","فِتْيَانِ يا نَسْلَ الأَكابِرْ",33,"ر",1,0],["أمحمدٌ، منِّي إليكَ نصيحةٌ","لكَ سوف أبْذُلها، وَلِي دِينار",34,"ر",1,0],["أمحي رسوم الأنس إن شئت أن تبقي","ذمائي فوف من ودادكم حقي",35,"ق",2,1],["امحُ عنها ذُلَّ ارهاقِ العِدى","أنها ما عُوِّدَت عاراً يَشين",36,"ن",1,0],["امحضك النصيحة والتصابي","يزحزحني لحبي عن مراحى",37,"ح",2,0],["أمحرر الشعب الهضيم","وناشر الحق الدفين",38,"ن",1,0],["أَم حالَت القِرطاسُ كافُوراً بِهَا","فَسَرَت تَمجّ عَلَيهِ مِسكاً أَذفَرا",39,"ر",2,0],["أمحمدُ بن محمدِ بن المرتضى","إنا لفي شُغُلٍ وإنك تَعلمُ",40,"م",1,1],["أمحمدٌ هنيتُ بالخير الذي","أمسى على أبوابكم متراكما",41,"م",2,0],["أمحمدُ بن محمدِ بنِ محمدٍ","وعُلاكَ منِصتةٌ تجيبُ وتسمَعُ",42,"ع",1,0],["أَم حِجاهُ أَم حِلمِهِ حينَ يَهفوُ","حِلمُ قَيسٍ وَحِلمُ ذي الأَطوادِ",43,"د",1,0],["أم حرقَتي وهواجسي ووساوسي","وتذمّري وتمَلملي في مضجعي",44,"ي",1,0],["أَمحقي ذِكرَياتِ أَمس فَخَيرٌ","لَكِ أَلّا يَبقى لِأمسٍ سُلالَه",45,"ل",2,0],["أَمحقيها بِحَقِّ روحي وَحُبّي","أَمحَقيها فَالذِكرَياتُ ضَلالَه",45,"ل",2,0],["إِمحي السَوادَ عَن الأَهدابِ في المُقل","وَاِمحي اِحمرارا اللمى المَمزوحِ بَالقُبلِ",46,"ل",1,1],["أَمحيطٌ بكلِّ شَيءٍ وَمردٍ","كلَّ حيٍّ وَتاركُ السَهلِ وعرا",47,"ر",2,0],["أَمَحْبُوبَ قَلْبِي قَدْ تَنَاهَى سُرُورُهُ","فَبَانَتْ فَأَزْرَتْ بِالْجُمَانِ ثُغُورُهُ",48,"ر",2,1],["أَمحمد ومحمد لِلَّه من","جَبَلَين يَحمي كل من بكما اِحتَمى",49,"م",2,0],["أمحمد بن الشيخ يا فخر القضا","يا معدن العرفان يا إكليل",50,"ل",1,1],["أمحمد قل للسعادة مرحبا","وابشر برفعة رتبة ونشان",51,"ن",1,0],["أَمحمّد رزءاً بمثلك لا نرى","إلّا برزء محمّدٍ تفريجه",52,"ج",2,0],["أمحو خطيئاتي بإخلاصي بها","وأحط أوزاري وإصر ذنوبي",53,"ب",2,0],["أَمحو الَّذي أَثبَتُّ مِن حُسنِها","وَأَشهَدُ الإِثباتَ بِالمَحوِ",54,"و",1,0],["أَمَحمود قَد أَحسَنت أَحسَنَت منعماً","وَما أَنا للإِحسانِ مُستَحسَن وَحدي",55,"د",2,0],["أمحمود الفضائل والسَّجايا","حَمِدْتُ من الأَنام على فعالك",56,"ك",1,0],["أمحملى عيب الهوى لقد اشتفى","داء الجوى من قلبيَ المعمودِ",57,"د",1,0],["أمحدثي بنقا العقيق أعد لنا","فيه الحديث موشحاً بدواته",58,"ت",2,0],["أمحمدٌ إن الذنوب عظيمةٌ","وبكاؤنا من عظمها غربالها",59,"ل",3,0],["أمحمدٌ ما كنتَ خامس عاهلٍ يقظٍ","يَهابُ جلاله الفجَّارُ",60,"ر",1,0],["أم حبلُ كلِّ مودّة في راحة","نكَّاثةٍ بالغدر كلَّ قرينِ",61,"ن",1,0],["أمُحمَّدٌ ولقد دعوتُ مُمَدَّحاً","ومن النَّجاح نداءُ سمْحٍ مُفْضلِ",62,"ل",1,0],["أم حسبن الرماحَ سمر قدودٍ","رقصت والدّماءَ مثل الخمور",63,"ر",1,0],["أَمُحَسِّنُ بنُ المِلحِ لا تَكُ تائِهاً","وَاِرجِع إِلى مِقدارِكَ المَعروفِ",64,"ف",1,1],["أَمحَقِقِّ الآمالَ بِالكَرَمِ الَّذي","أَحيا العُفاةَ وَبَخَّلَ الكُرَماءَ",65,"ا",2,0],["أَمحَقُ كلِّي فيهِمْ","ولم يكنْ ما وَجَبَا",66,"ب",2,0],["أمُحَلِّلا أكفانَه","رِفقاً بِه شَلَّت يَدَاك",67,"ك",1,0],["أمحمدٌ غرِّيطُ ربُّ القولِ مَن","بهِ عصرُنا هذا يفوقُ عُصورا",68,"ر",2,0],["أمُحِقٌّ أنا بِربِّكَ أم لا","أيها السَّامعُون هل من جَوابِ",69,"ب",1,0],["اِمّحى نورُها فما هي إِلّا","ليلةٌ غاب عن دُجاها الهلالُ",70,"ل",1,0],["أمحلت أرضهم وغيثُ علومٍ","هو في كل أرضنا هتّان",71,"ن",1,0],["أمحجوبة عنكم خريدة توبة","تلوح بوجه كاشف الغيب فائق",72,"ق",1,0],["أمحمود الشمائل دمت سام","لما هذا التجني والصدود",73,"د",1,1]]}