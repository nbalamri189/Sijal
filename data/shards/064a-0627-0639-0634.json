{"poems":[[53,"صورته ناعتة خبره","https://www.aldiwan.net/poem61908.html","السريع"],[102,"بين الرجل والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=50371",""],[139,"خذ من لواحظها الحذار","https://www.aldiwan.net/poem49139.html","مجزوء الكامل"],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[449,"يا عشير الصبا الكريم السجيه","https://www.aldiwan.net/poem56046.html","عموديه"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88637","الخفيف"],[4699,"دائماً بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=153920",""],[4702,"مديت كفي وكفيت مدي","https://www.poetsgate.com/ViewPoem.aspx?id=155466",""],[4968,"حسبي وحسبك","https://www.poetsgate.com/ViewPoem.aspx?id=206759",""],[5111,"بسمةُ الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212080",""],[5224,"يا حسن ما أجلاك في عيني وفي بصري","https://www.poetsgate.com/ViewPoem.aspx?id=121308",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5452,"عشّاق ملول","https://www.poetsgate.com/ViewPoem.aspx?id=112434",""],[5510,"قاضي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205628",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5997,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=214294",""],[6068,"يا عشقها -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175878",""]],"verses":[["يا عشْرَ أسَتاه لها بيضَةٌ","هُنِّئتِ عدْوى الشْيمة الماجدَهْ",0,"د",2,0],["يا عشايا يا هنا يا ريح من","يشتري رأسي ، بحلقوم (الزّرافه) ؟",1,"ف",2,0],["يا عشق كم لك في الحشا","شتَّى اشتعال واستعارْ",2,"ر",1,0],["يا عش بيض القمل فر","خ في السوالف والشعور",3,"ر",1,0],["يا عشير الصبا الكريم السجيه","لك عندي عهود ود قويه",4,"ي",2,1],["يا عُشبَ أرضي وسماءَ روضتي","ودارَ أمني يومَ أَرعَى الحذَرا",5,"ر",2,0],["يا عشيق الملوك اذ كل ملك","بات منه بليلة المعمود",6,"د",1,0],["يا عشق روحي يا ربيع محبتي","يا مُهجةً ملكت زِمَامَ يَقِيني",7,"ن",2,0],["ياعشق من وفاك بالعشق وفه","واللي بخل به عنك لاتقيس له قيس",8,"س",1,0],["يَا عِشْقَ عُمُرِي هَلْ أرَاكَ مُوَسِّدِي","حُضْنَ الحَنَانِ فَأنتَشِي بِالمُحْتَوَى ؟",9,"و",2,0],["يَا عِشْقَ قَلبِيْ، لَحْنُ حُبِّكَ فِيْ فَمِيْ","كَالْمَوْجِ مِنْ أقْصَى الْفُؤَادِ تَدَفَّعَا",10,"ع",2,0],["يا عشق أوقد فؤادي وروحي نيتي","بنارك أحرقها لا تبقي ولا تذري",11,"ر",2,0],["يا عِشْق هارونَ الرَشيدِ وَتاجَه","مِن سالف الأَيام وَالأحقابِ",12,"ب",1,0],["يا عَشْتروت الَّتي طالتْ مواجِعها","وطالَما بوْحها بالحُزْن يَزْدَلِفُ",13,"ف",1,0],["يا عشْتروت التَّي قالتْ وقدعلمتْ","ألا تؤمّنهُ فالقولُ كم يقفُ",13,"ف",1,0],["يا عشقاً كالطّللِ الخالي","ما عندي غيْرَكَ أُنْشدُهُ",14,"د",2,0],["يا عشق إنّ عشيقتي تعصي الهوى","وأبرّ عشقي وسط ليل يسدلُ",15,"ل",1,0],["يا عشق هل حزن بكأسك حلّ أم","فرح نبيذيّ وروح تغسلُ",15,"ل",1,0],["يا عِشْقُ يا شوْقُ يا تَرتِيلَ قافِيَتي","يا حَرّة الآهِ ... في الاضلاعِ إذْ ناحوا",16,"ح",3,0],["يا عشبة ً برية ً أيقظتها","أنا ها هنا بعثرت دمي يحصدا",17,"د",2,0],["يا عشقها حتى متى تتحججُ","الشوقُ نارٌ بالجوى تتأججُ",18,"ج",1,1],["يا عشقها ما كنت أحسبه بقي","لما اغتربنا بل يزيد ويرتقي",19,"ق",2,1]]}