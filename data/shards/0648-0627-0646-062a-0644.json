183,"ذكرى ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=180225",""],[5183,"أبا دواؤد","https://www.poetsgate.com/ViewPoem.aspx?id=180195",""],[5186,"يا روضة العلم التي أنبتت","https://www.poetsgate.com/ViewPoem.aspx?id=156497",""],[5191,"جسدًا واحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=211978",""],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5277,"قميصُ يوسف","https://www.poetsgate.com/ViewPoem.aspx?id=206837",""],[5281,"يا رَامِشْ العَينين","https://www.poetsgate.com/ViewPoem.aspx?id=199605",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[5334,"علِّقْتُها كَعبِيةً حَلَّ أَهلُها","https://www.poetsgate.com/ViewPoem.aspx?id=96982",""],[5344,"وجهتي شرق..","https://www.poetsgate.com/ViewPoem.aspx?id=183176",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5431,"أوجاع شعبي في كربلاء...","https://www.poetsgate.com/ViewPoem.aspx?id=191646",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5525,"دروبي رمل","https://www.poetsgate.com/ViewPoem.aspx?id=924",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5612,"طَريقُ الشَوْق","https://www.poetsgate.com/ViewPoem.aspx?id=179615",""],[5667,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=214869",""],[5720,"درعُ الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=199874",""],[5720,"خيرُ البريّةﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200025",""],[5720,"رَثَتْكَ بيوتُ اللهِ (*)","https://www.poetsgate.com/ViewPoem.aspx?id=203033",""],[5756,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=5417",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5847,"حوار مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=45479",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5939,"أنا فيها","https://www.poetsgate.com/ViewPoem.aspx?id=156540",""],[6056,"صديق اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=156695",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""],[6355,"جُدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66565&r=&rc=25",""],[6355,"شقيق روحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66693&r=&rc=153",""]],"verses":[["وَأَنتَ لا مُرهَقٌ وَلا قَلِقٌ","وَالبَدرُ مُستوفِزٌ وَمُنتَقِلُ",0,"ل",1,0],["وأنتَ لا تأوي لِما تَرُبُّهُ","منْ جَسَدٍ مَصيرُهُ إِلى البِلى",1,"ا",1,0],["وَأَنْتَ لَهَا مِنْ بُغْيَةٍ مَطَلَتْ بِهَا","صُرُوفُ زَمَانٍ نَالَ أَنْفِي لَهَا رَغْمُ",2,"م",1,0],["وأنتَ لها يا ناصِرَ الحقِّ فلْتَقُمْ","بحقٍّ فَما زَيْدٌ يرَجّى ولا عَمْرو",3,"ر",2,0],["وأنْتَ لها أحْيَيْتَ يا مُحْيي الهُدى","فُروضاً بهِنّ اللهُ صَدْرَكَ شارِحُ",4,"ح",1,0],["وَأَنت لِعَيني قُرَّةٌ حينَ نَلتَقي","وَذِكرُكِ في نَفسي إِذا خَدِرَت رِجلي",5,"ي",1,1],["وَإِن تَلقَهُ في الشَربِ لا تَلقَ فاحِشاً","وَلا ناكِثاً عَقدَ السَرائِرِ وَالصَبرِ",6,"ر",1,0],["وَأَنتِ لَو كُنتِ بي جُدُّ الخَبيرَةِ لَم","يُطمِعكِ في طَمَعٍ مِن شِيَمتي طَمَعُ",7,"ع",1,0],["وأنت لهذا الكون علَّةُ كونه","ولولاك ما امتاز الوجود بأكوانِ",8,"ن",1,0],["وأنت لو شئت إرهاباً لجئتهم","بصارم لنواصي القوم حزّار",9,"ز",3,0],["وَأَنتَ لَنا نورٌ وَغَيثٌ وَعِصمَةٌ","وَنَبتٌ لِمَن يَرجو نَداكَ وَريقُ",10,"ق",1,0],["وَأَنتَ لِحَصّاءِ القَفا مارِنِيَّةٍ","وَما لَكَ في المَجدِ المُقَدَّمِ أَوَّلُ",11,"ل",1,0],["وَأَنت لِلعَينِ عِينٌ","وَأَنتَ لِلقَلبِ قَلبُ",12,"ب",1,0],["وأنت لعَمْري شُعبةٌ من ذوي العلا","فلا ترضَ أن تُعتدَّ من أوضع الشُّعَبْ",13,"ب",1,0],["وأنت له أهلٌ فإن تجْزني به","أزِدْك وإن تُمْسِكْ أقفْ غيرَ عاتِب",14,"ب",1,0],["وأنت لا تَبْخَسُ ذا كُلفةٍ","لا بَلْ ترى أن الغنى رَفْتُهَا",15,"ت",3,0],["وأنت لكلَّ مَكْرُمةٍ عِمَادٌ","أجَلْ ولكلَّ ذي كرم عَميدُ",16,"د",1,0],["وأنت للطالب العل","م بحرُ علم غزير",17,"ر",1,0],["وأنت لاهٍ بغيرنا ولنا","منك هوى ممسِكٌ على النفَس",18,"س",1,0],["وأنت لأمر العلا مؤثرٌ","على كل ناعمة المعتنق",19,"ق",1,0],["وأنت لا شكّ أخو ريبةٍ","بادرَ أنْ يبدره القيلُ",20,"ل",1,0],["وإن تلوَّمتَ في أمرٍ يقوم به","قال اتَّقَى العَثْرَ محموداً وما وهنا",21,"ن",2,0],["وَأَنتِ لِعَيني قُرَّةٌ حينَ نَلتَقي","وَذِكرُكِ يَشفيني إِذا خَدِرَت رِجلي",22,"ل",2,0],["وانت لنا في البداية ام","وانت لنا في النهاية غول",23,"ل",1,0],["وأنت لولا تليد الملك تحرزه","من الشمائل في ملك وفي خول",24,"ل",1,0],["وإن تلاقوا ففي تصاف","كأن هذا لذا أخوه",25,"ه",1,0],["وَأَنتَ لَهُنَّ راعٍ ذو اِنتِباهِ","تَكُرُّ مَعَ الظَلامِ وَلا تَفِرُّ",26,"ر",1,0],["وأنتَ لي أَخٌ وأنتَ الصِّهْرُ","زَوَّجَكَ الذي إليهِ الأَمْرُ",27,"ر",1,0],["وَأَنتَ لِلناسِ نورٌ يُستَضاءُ بِهِ","كَما أَضاءَ لَنا في الظُلمَةِ اللَهَبُ",28,"ب",1,1],["وَأَنتَ لِعَبدِ القَيسِ سَيفٌ تَسُلُّهُ","عَلى مَن يُعاديها وَأَنتَ هِلالُها",29,"ل",3,0],["وَأَنتَ لِهَذا الناسِ بَعدَ نَبِيِّهِم","سَماءٌ يُرَجّى لِلمُحولِ غَمامُها",30,"م",3,0],["وأن تُلقى العِدا في النَّحرِ صَرعى","بحدِّ ظُباكَ داميةَ النُّحورِ",31,"ر",1,0],["وأنتَ لا شكَّ من أفوافِ يُمنَتِه","عارٍ كما عُرِّيَت منها مناكبُه",32,"ب",2,0],["وأنت لو أنّ روحاً أزمعت سفراً","أعدتَها وخَيالُ الموت بالبابِ",33,"ب",1,0],["وأنت للخلقِ رأس قد سلمت لهم","فليس يشكونَ من سُقْمٍ على بدنِ",34,"ن",1,0],["وإن تلاكَ العيدُ في بهجَةٍ","فأنْتَ عيدٌ أوّلٌ وهو ثان",35,"ن",1,0],["وأنتِ لم تَبْرَحي في النَّفْسِ عالِقَةً","دَمي ولَحْمِيَ والأنْفاسَ، والرَّمَقا",36,"ق",2,0],["وَإِن تَلتَمِس مِنّا المَوَدَّةَ نُعطِها","وَإِن تَلتَمِس مِمّا لَدَيها تَعَلَّلِ",37,"ل",1,0],["وَأَنتَ لُبابُ السَيفِ أَمّا فِرِندُهُ","فَطَلقٌ وَأَمّا غَربُهُ فَمُذَلَّقُ",38,"ق",1,0],["وَإِن تَلَكّا أَخَذوا عِمامَتَه","وَخَمَشوا أَخدَعَهُ وَهامَتَه",39,"ه",1,0],["وَأَنتَ لي أَيضاً كَذا قُدوَةٌ","لَستُ بِشَيءٍ مِنكَ أَرتابُ",40,"ب",1,0],["وَأَنتِ لَقاةٌ بَينَ خَلفٍ وَأَكلُبٍ","مَتاعٌ لِمَن جازَ السَبيلَ وَمَن قَصَد",41,"د",1,0],["وَأَنتَ لِلجُندِ وَغَيرِ الجُندِ","مُشتَرَكُ النَيلِ وَرِيُّ الزَندِ",42,"د",1,0],["وَأَنَّ تِلادي إِن ذَكَرتُ وَشِكَّتي","وَمُهري وَما ضَمَّت لَدَيَّ الأَنامِلُ",43,"ل",1,0],["وأنت للناس بالحق","قِ ترجمان ضميري",44,"ي",1,0],["وأَنتَ لا تَعلَم أَي","نَ سوف يأتيك الردى",45,"د",2,0],["وأنتِ لا شكوى ولا آهةٌ","مما ترى عيناك أو تسمعينْ",46,"ن",1,0],["وَإِنْ تُلْقِ الْيَرَاعَ فَمَنْ أَدِيبٌ","مَتَى يَدْعُ الْخيَالَ يُجِبْ مُطِيعَا",47,"ع",2,0],["وأنت لا تألو دعاباً في الهوى","شم وتقبيل واشيا أخر",48,"ر",1,0],["وأنت للضاد حارس أبدا","ما خفّ إمعانه ولا حذره",49,"ر",2,0],["وأنت لها أحييت يا محي الهدى","فروضا بهن الله صدرك شارح",50,"ح",1,0],["وإن تُلهبِ الشكوى قوافيَّ حُرقةً","وغيظاً فاني قادحٌ كبِداً حرّى",51,"ر",2,0],["وأنت. لا شيء إلاّ","وعدٌ ببال الحقول",52,"ل",1,0],["وأنت لطالب العل","م بحرُ علم غزير",53,"ر",1,0],["وانت لعمر العلا نسخة","صنوف الكمال بها توجد",54,"د",1,0],["وانت للدين صبح يستضاء به","وفي سماء العلا آباؤكالشهب",55,"ب",1,0],["وأنت لي نعم الحمى","يا صاحب الصدر الرحب",56,"ب",1,0],["وَأَنتَ لِحُنَفاءِ اليَدَينِ لَو أَنَّها","تُباعُ لِما جاءَت بِزِندٍ وَلا سَهمِ",57,"م",1,0],["وإن تُلِيَتْ ألفاظُه في مجالسٍ","يصيحُ لها طفلٌ وكهلٌ وأشيبُ",58,"ب",1,0],["وإن تُلِيَتْ ألفاظه في مجالسِ","يصحُّ لها طفلٌ وكهلٌ وأشيبُ",59,"ب",1,0],["وأنت لكل الجند عزٌ ومنعةٌ","فويل لمن عن بابك استوجبوا النفيا",60,"ي",2,0],["وأنت لخير الرسل خير خليفة","فصل عليه ما استطعت وسلم",61,"م",1,0],["وانت له وللدنيا جميعاً","ومن فيها المثبت والمعين",62,"ن",1,0],["وأنت لمن يصوم ومن يصلى","شريك في الصلاة وفي الصيام",63,"م",1,0],["وإن تَلَوْنا مدحَهُ فوجهُهُ ال","بَسّامُ لا يَتْلو علينا عَبَسا",64,"س",2,0],["وإنْ تلهّبَ بَرقٌ من جَوانبِهمْ","توقّدَ الشّوقُ في جَنْبيَّ والْتَهبا",65,"ب",2,0],["وَأَنتَ لَو شِئتَ أَضحَت كُلُّ ناحِيَةٍ","مِن أَرضِهِم وَبِها نَوحٌ وَإِعوالُ",66,"ل",1,0],["وَأَنتَ لَعَمرِي ما خُصِصتَ بِفَقدِهِ","وَإِنَّكَ فيهِ وَالبَعيدَ لَسِيّانِ",67,"ن",1,0],["وَأَنتَ للدَوحَةُ اللّاتي أَرُومَتُها","طابَت فَمَدَّت عَلى الأَغصانِ أَغصانا",68,"ن",2,0],["وأنتَ لها مثلُ الذريعة في الوَغى","إذا صان نفسَ القوم درعٌ ومِغْفَر",69,"ر",1,0],["وأنت لها إذا ضَرَبتْ يَمينٌ","وأنت لها إذا عَزمتْ جَنان",70,"ن",1,0],["وأنت لدى الأشراف ايضا معظمٌ","كما أنت أيضا في صدور الديالم",71,"م",1,0],["وأنت لم تطلب فوق الذي","يرضيك قل لي بعلاماته",72,"ت",2,0],["وَأَنتَ لَمّا وُلِدتَ أَشرَقَتِ ال","أَرضُ وَضاءَت بِنورِكَ الأُفُقُ",73,"ق",1,1],["وان تليت بالحمد آيات شاعر","بمدح سواه فهو آيتها الكبرى",74,"ر",2,0],["وأنت ليثٌ لدى الهيجاءِ متخِذاً","عند القَساطِلِ ظَرَّانَ القَنا غِيْلا",75,"ل",2,0],["وأنتَ لا تجعلُ المشارِكَ في","حُلْوِك والمُرِّ كالغَويَّيْن",76,"ن",1,0],["وأنتَ للنفس أَشْهَى","من الغِنى والبقاء",77,"ا",2,0],["وأنت لا تجزعي يا نفس من بدع","مضلة ورسول الله هاديكي",78,"ك",2,0],["وان تلك ما احرمتنيه وهبتهم","فأضحى هشيما غرس ارضي وزرعها",79,"ع",3,0],["وَإِن تلاطم أَوْ جاشتْ غواربُهُ","سمعتَ من موجه تصفيقَ مفراح",80,"ح",1,0],["وَأَنتَ لا دَرى كَم بِتيهِكَ وَحدَهُ","قَتَلتَ وَما حاوَلتَ طَعناً وَلا ضَربا",81,"ب",2,0],["وَإِن تَلَهَّفَ خِلتَ الأَرضَ قَد رَجَفَت","وَجادَ مِنهُ رَوايا كُلُّها قُطُفُ",82,"ف",1,0],["وأنت لمن يبكى وإني لنادمٌ","وإن كان ذنبي أنني للورى ضدّ",83,"د",1,0],["وأنت لك اللَه يا فكرةً","أطيرُ إليها كسير الجناح",84,"ح",1,0],["وانت ليلاي مهلا","لا تزدهي بالدمقس",85,"س",1,0],["وَأَنتَ لَنا عَلى خُلق عَظيم","وَنَحنُ عَلى العُموم لَكَ الفِداء",86,"ا",2,0],["وأنتَ لا تُدفَعُ عنها وقد","نَماكَ مَنْ هُنَّ سَجاياه",87,"ا",2,0],["وأنت لدينِ الحقِّ غايتُه التي","تَناهَتْ فما عنها لذِي نُهيةٍ مَعْدى",88,"د",2,0],["وأنتَ لا تنفك في إثرها","تحدو بحثِّ المَدمع الساكبِ",89,"ب",1,0],["وأنتَ لعمر الله أَوْلَى بعقْدِها","وأحرى به من كلّ جيدٍ مُقَلّدٍ",90,"د",1,0],["وأن تلزما في الاعتقاد طريقة","لأسلافنا من غير جبر وتشبيه",91,"ي",2,0],["وأنتَ لابُدَّ يَوماً","بعدَ التَكاهُلِ هالِكْ",92,"ك",1,0],["وإنْ تلفَّظت في نطق وفي قلم","قرّطت من دور الأَلفاظ آذانا",93,"ن",2,0],["وأنت له الأقدار فيما رامهُ","ومضى بذلكم القضاء المنزل",94,"ل",1,0],["وإِنْ تَلْقَ جِسْماً بعد جِسْمِكَ فِي الورى","وكَيْفَ بِهَا أَنْ تَرْتَضِي بَعْدَهُ جِسْما",95,"م",2,0],["وأَنتَ لك البيت الشريف مقدسا","وأَنت فأَنت العالم المتناهي",96,"ي",1,0],["وأنْ تلحظ الأعداءُ مني خصاصةً","لها من اِبائي والتَّصوُّن ساتِرُ",97,"ر",1,0],["وأنت لراجي خيرك الدهرَ رازِقٌ","وللاَّثم الَّلاحي على الجودِ حارِم",98,"م",1,0],["وأنت لِما أُثْني به خيرُ أهْلِه","وأنت لما أرْجوهُ منْ أمَلي ذُخْر",99,"ر",1,0],["وان تلقَ لِين الصَّفح دون شَباتهِ","فما هوَ إلا هازئٌ بكَ هازل",100,"ل",1,0],["واِنْ تلُح ْ بارقةُ يَبِتْ الى","لمعتِها متيَّماً وَلُوعا",101,"ع",2,0],["وأنت لنا ناصر ونصير","ومثلك للناس قرة عين",102,"ن",1,0],["وأَنْتَ لولاكَ لم تُبْنَ السَّماءُ ولم","يَدُرْ بمحوَرِهِ في سَمْكِها الفَلَكُ",103,"ك",1,0],["وأَنْتَ لولاكَ لم يُجْلَ النَّارُ لنا","ولك يَجُرَّ بِنا كَلْكالَهُ الحَلَكُ",103,"ك",1,0],["وَأَنتَ لاَ شَكَّ مِنَ الكَوَافِرِ","وَجَاحِدٌ أنتَ بِرَبٍّ قادِرِ",104,"ر",1,0],["وإنْ تَلاقَى النّاسُ في غَيرِ ذا","فاهْرُبْ إلى فُرْقَتِهِمْ تَسْلَمِ",105,"م",1,0],["وَإِنْ تَلقَهمْ قُلّاً لدى كلِّ مطمعٍ","فإنّهمُ في كلِّ نائبةٍ كُثْرُ",106,"ر",1,0],["وأنت له عبد وظيفتُك الرضى","وما لك معه أن ترى لك مدخلا",107,"ل",2,0],["وأنت لابس غليظ فروة","والقوم لبسهم حلىً وريط",108,"ط",1,0],["وَأَنْتَ لَطِيْفٌ حَدِيْدُ المِزَاجِ","نَحِيْفُ الجَوَارِحِ عَارِي العِظَامِ",109,"م",1,0],["وَأَنتَ لِلصَيدِ مِن مُلوكِهِمُ ال","بانينَ لِلمَجدِ ثابِتَ الدِعَمِ",110,"م",1,0],["وَأَنْتَ لِنَجْدَةِ الْمَلُهوف غَيْثٌ","إِذَا سَكَنَتْ إِرَادَتُهُ سُكُونَا",111,"ن",2,0],["وأنتَ للشعبِ حصنٌ يُستجار به","يذبُّ عنه إذا ما حادثٌ وقعا",112,"ع",2,0],["وأنتَ لَهم إذا حَضَروا مَلاذٌ","وأنتَ لَهُم إذا سُمِعَت مُجيب",113,"ب",1,0],["وأنت لمن بَغى وعدا وأذكى","عليك الحرب واسترداك مُرْدِ",114,"د",1,0],["وأنت لا شكَّ عاديتَ إلالهَ بهِ","فيا جَحيمُ ألا هُبيّ لِسوّارِ",115,"ر",1,0],["وَأَنتَ لَدَينا ذُو الفَقار الَّذي بِهِ","تَصول عَلى جُند الغُرور بِأَسره",116,"ر",2,0],["وَأَنتَ لأَحزاب المَعارف ناصرٌ","وَأَنتَ لِأَرباب الفُنون زَعيم",117,"م",1,0],["وَأَنتَ لِدين اللَه وَالملك ناصر","وَجَيشك في كُل الوَقائع غالب",118,"ب",1,0],["وَأَنتَ لَهُ نعم المَليك الَّذي بِهِ","سَما مُنذ ميطت عَن علاك التَمائم",119,"م",1,0],["وَأَنتَ لمَولانا الإِمام بملكه","معينٌ عَلى تَأييد أَصدق قائم",120,"م",1,0],["وأنت له في خير أفعاله يد","وأنت له في خير أقواله فم",121,"م",1,0],["وأنت لو حمَّلْتِها عمدةً","لنال تشريفاً وأعلى مقامْ",122,"م",1,0],["وأنت لأدرانهم غاسل","وهم يحقدون على الغاسل",123,"ل",1,0],["وانت لا عن حجاب كنت ناظرنا","فارفع حجابك وانظر للاحباء",124,"ا",2,0],["وَأَنتَ لَها دون البريّةِ محْرَمٌ","وَأَنتَ لَها دونَ الخَلائِقِ خاطِبُ",125,"ب",1,0],["وَأَنت لَنا وَاللَّه رُكنٌ وَمَفزع","إِذا اِشتَدّ فينا الكربُ غبّ فجاءِ",126,"ا",2,0],["وَأَنتَ لَنا غَوثٌ وَحِصنٌ وَملجأ","إِلَيكَ لَنا وَاللَّه حسن اِلتجاءِ",126,"ا",2,0],["وَإِن تُلتَمَس مَنهُ الزِيادَةُ وَالجَدا","وَيُستَمطَرِ المَعروفَ يَغضَب وَيَحرَبِ",127,"ب",1,0],["وَأَنتَ لا يَخفاك طَبعُ المعزى","حَيث لَها قوَّةُ قَلبٍ تُعزى",128,"ز",2,0],["وأنتَ للكرَمِ المذكورِ معْدِنُه","وأهلُه وابنُ أهليه ووالدُه",129,"د",2,0],["وأنت لدى بني العباس ردء","وخصم دون ملكهم الد",130,"د",1,0],["وأنت لها سهم رمى كل خالع","وأنت لها ظهر حمى وظهيرُ",131,"ر",1,0],["وأنتل ما لم يعطه إلاك يا حامي","الذما ومنعت ما لم يمنع",132,"ع",1,0],["وَأنْتَ لِفَرْطِ مَا قَدْ جَرَى","أجْرَى عَلَى المُعْتَادِ دَمًا دُونَ عَيْنِ",133,"ن",1,0],["وإِن تلقَ بنت الأربعين فغبطةٌ","وخيرُ النساء ودُّها وَوَلُودُها",134,"د",3,0],["وَأَنتَ لَنا في الكَون بَدرُ جَلالَةٍ","أَعيد إِلى آفاقِهِ وَهُوَ كامِلُ",135,"ل",1,0],["وَأَنْتَ لَيْثُ المَزْحِفِ المُلاَيِثُ","ذُو صَوْلَةٍ تَرْمِي بِكَ المَدَالِثُ",136,"ث",1,0],["وإِنْ تلاهُوْا بشُرْبِ الرَّاح قالَ دِما","بني الحروب ولا بِنْتُ العناقيدِ",137,"د",1,0],["وإِنْ تُلَخِّصْ فَشَطْرُ وَصفْي","والشَّطْرُ وصْفٌ عَلَيهِ يَجْري",138,"ر",2,0],["وأنت لنا يا وارث السر مقصد","اعدك في كل النوايب لي ذخرا",139,"ر",2,0],["وأنت لي عدة ان نابني زمني","وأنت لي منة من اعظم المنن",140,"ن",1,0],["وأنت لك الحماية يا شفيع الورى","إذ أنت محمود الخصائل",141,"ل",1,0],["وأنت لا تسرع من روعتك","كأنما قد خفت عين الصباح",142,"ح",1,0],["وَأن تُلِمَّ بِالمَعَاصِي ذِلَّةً","وَلَو صَعِدتَ مَعقِلاً أو قُلَّةً",143,"ه",1,0],["وَأَنْتَ لأَهْلِ الأَرْضِ خَيْرُ خَلِيفَةٍ","تَخَيَّرَ أَعْلاَقَ المَفَاخِرِ وَانْتَقَى",144,"ق",2,0],["وَإِن تَلقَني في الدَهرِ مَندوحَةُ الغِنى","يَكُن لِأَخِلاّئي التَوَسُّعُ وَاليُسرُ",145,"ر",1,0],["وأنت لبعضِهم ساءَ مَن","رأى وبه يوصَفُ الخاسر",146,"ر",1,0],["وأنت لعمري البحرُ جوداً ونائلاً","وأنملك العشرُ الغيوث السواجمُ",147,"م",1,0],["وأنت للهم نافٍ","وكنت كالريم نافر",148,"ر",1,0],["وأنت لنا كهف لنأوي اليه في","جميع الردي اوفاقة تلك تحصل",149,"ل",1,0],["وأنت لديه في جناب ممتع","تسود به في رفعة وعلاء",150,"ا",2,0],["وأنتَ للدنيا وللدينِ وَلِي","نِيْطَتْ بِكَ الأسْبَابُ فاقطعْ وَصِلِ",151,"ل",1,0],["وإن تلتمسنا في بني الغرب تلقهم","على ضوئنا يَعشون في فلوتِها",152,"ت",3,0],["وأنت ليث عرين في ليوث حمى","يخشون في غابهم أمراً وان ظهرا",153,"ر",2,0],["وأنت لما سن النبي متابع","يهنيك من سعد السعود طلوع",154,"ع",1,0],["وأنتَ لِمَنْ ناواكَ سيفٌ مجرَّدٌ","وأنت لمن والاكَ سُورٌ ومعْقِلُ",155,"ل",1,0],["وأنت لي بصرٌ إذ أبصرت به","وأنت سمعي فخذ فضلاً بأسماعي",156,"ع",2,0],["وإن تلق يوما في الطريق حجارة","أو الشوك أو عظما أزل وكذا الردي",157,"د",2,0],["وَإِن تَلقَ نَدماني يُخَبِّركَ أَنَّني","ضَعيفُ وَكاءِ الكيسِ لَم أُغذَ بِالفَقرِ",158,"ر",1,0],["وأنت لي يا ريح نجد وبي","قلب أذاهب صَباً تلك هب",159,"ب",1,0],["وأنت للرحم القبرى تواصلُها","إذا جفى الرحمُ الموصولُ جافيها",160,"ي",3,0],["وإن تلينتم لانوا وإن شهموا","كشفت أذمار حربٍ غير أغمار",161,"ر",1,0],["وأنت لله ما أحلاكَ من بطل","يا قائد القول قول الفيلق الحربِ",162,"ب",1,0],["وانت لبأسك الاحداث تعنو","فكم لابيك قد لان الحديد",163,"د",1,0],["وانت لنا على الايام عون","يدار بامرك الفلك المدار",164,"ر",1,0],["وَأَنتَ لكَ الرَّأيُ السَّديدُ وهِمَّةٌ","مَوارِدُها تَأبَى عَلى مَن يُرِيدُها",165,"د",3,0],["وَأَنتَ لِلنَفسِ وَالآمالُ مُرتَكِنٌ","وَلِلنُهوضِ إِلى العَلياءِ رِئبالُ",166,"ل",1,0],["وأنت لنا من بعدهم صرت قيماً","حمولاً لثقل الخطب يوري بك الزند",167,"د",1,0],["وأنّت لهُ الأتراسُ حُزناً وحرقةً","وَذابَ لهُ قلبٌ عليهِ جَريدُ",168,"د",1,0],["وأنت لي دائمٌ باقٍ بشاشتهُ","يهتزُّ لا عُودُهُ عسرٌ ولا عاسِ",169,"س",1,0],["وان تلتقيني جانب الحي ساعة","منكرة تحت اللثام اصيلا",170,"ل",2,0],["وإن تلوت القريض تنصت لي","كأنها أُطرِبَتْ لأسجاعي",171,"ع",2,0],["وأنتِ لا جنبتِ تبريحَ الولَهْ","مزءُودةً أوْ فاقِداً أو مُثكِلهْ",172,"ل",2,0],["وَأَنتَ لَهُم هاد إِذا جَدَ جدهم","وَلَولاك في وادي الضَلال لَهاموا",173,"م",3,0],["وأنت لها المغني بغيث له الندى","شذور فلا تحتاج بعد إلى القطر",174,"ر",1,0],["وأنت لها نعم المشير فانها","بعزك في العلياء سامية القدر",174,"ر",1,0],["وإن تلتموا بالكتب عهدا وموثقا","فإن عهود السيف أوفى وأصدق",175,"ق",1,0],["وإن تلتَمِسني في فَزَارَةَ تَلقَنِي","عَزيزاً إذا ما الحربُ شُبَّ وَقُودُها",176,"د",3,0],["وان تلقى علوما من مواهبهم","اياك من ذلة الافشا لسرهم",177,"م",1,0],["وأنتَ لجسم مصر الروح فاِسلَم","وَعِش ما دامَ في الدنيا هناءُ",178,"ا",2,0],["وإِن تلكُمُ الّا أَسامٍ عجيبَةٌ","دعوتم بها انتم مع الجَدّ والابِ",179,"ب",1,0],["وَأَنتَ لَئيمهُم وَهُمُ لِئامٌ","كَذاكَ الحَقُّ خالَفَ ما تُريدُ",180,"د",1,0],["وَإِن تَلزَمي ما قالَهُ لَكِ والِدٌ","شَفيقٌ فَإِنَّ السَعدَ مِنكَ لَمُعتَلي",181,"ل",2,0],["وأنت له اذن واعيه","بأمرك مر الصبا والجنوب",182,"ب",1,0],["وَأَنتَ لكامِل وَفَريد ندّ","بِحَيث يعزّ للقمرين ندُّ",183,"د",1,0],["وأنت لها مهما اتقت فيك جنة","اذا الدهر يوما راش سهما مفوقا",184,"ق",2,0],["وانت لها الربيع فكيف تخشى","أذى بؤس بصيف او شتاء",185,"ا",2,0],["وَإن تَلاَ السَّابِقُ مَا بالاِبتِدَا","يَختَصُّ فَالرَّفعَ التَزِمَهُ أبَدَا",186,"د",2,0],["وَإن تَلاَ المعطُوفُ فِعلاً مُخبَرَا","بِهِ عَنِ اسمٍ فَاعطِفَن مُخيَّرَا",186,"ر",2,0],["وإن تلقهم قالت بأني كاذب","وإني إلى قوم سواهم لأميل",187,"ل",1,0],["وان تلتقم ذا النون حوتٌ فانه","قد التقمت موسى سجون ذوي الحقد",188,"د",1,0],["وانت لادرى كم انا بك هائمٌ","وسل قلبك الصافي فاعلم بالامرِ",189,"ر",1,0],["وانت لادري في قصوري ولم يكن","بغيرك أَن أعدو القصور سبيل",190,"ل",1,0],["وأنت لقد جزت الشآم فإنني","أحن إليها مستهاما متيما",191,"م",2,0],["وأنت لي عون على كل ما","تجمع في السرعة أشتاتي",192,"ت",2,0],["وأنت لذي العصيان بالعفو مانح","وللذنب غ