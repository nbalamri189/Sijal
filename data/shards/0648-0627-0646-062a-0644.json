 لؤلؤة لا زالَ جوْهرها","يغشاهُ من قد تبَدى وهو معْتكفُ",244,"ف",1,0],["وأنتَ لثغةُ شعري حينَ أنطِقُهُ","ألتاكُهُ كالذي بالذنبِ ما شَعَرا",245,"ر",2,0],["وأَنتْ لِي نَاسي.. يا اَهْلِي وِِيَا ناسي","يا كلّ إِحسَاسي.. رَقيقْ صنعاني",246,"ن",2,0],["وأنت لعمري قد حفظت على المدى","بحفظ إله لا بإنس ولا جان",247,"ن",1,0],["وإن تلْقَ تيماً في الندِيّ عرفْتها","عرفْت الأنوف الفُطْس والأعين الزرقا",248,"ق",2,0],["وانت لي مينا عن الحظ الشحيح","يوم كلن دار ربعه له ضماد ..",249,"د",1,0],["وأنت لباري الخلق أذن سميعة","فحاشاك أن تدعى غياثا ولا تعي",250,"ع",2,0],["وإن تلاعب في أقصى رغائبهم","فسوف يجنح مضطراً لما رغبوا",251,"ب",3,0],["وأنت لقلب المتعبين عزاؤهم","ونزفك وشمٌ في القلوب ومنهج",252,"ج",1,0],["وإنْ تلقَ الهزيع على دروبٍ","تناءت خلفَ ضوءٍ لم يفزِّ",253,"ز",1,0],["وانت لو خان الزمن بقول وافي","لا أنا تركي .. ولا أظنك مشاري",254,"ر",2,0],["[ وَأَنْتَ لِلزَّائِرِينَ المُشْتَرِي خُلُقاً","وَلِلْعِدَى كَوْكَبُ المَرِّيخِ أَوْ زُحَلُ ]",255,"ل",1,0],["وإنْ تلْهَجْ بِذِكرِ اللهِ دَوْماً","فلا كُرَبٌ تُعَضْعِضُ أو خُطوبُ",256,"ب",1,0],["وأنتِ لي في الدُنا (أحلامُ) قافيَتي","وكلُّ شعريَ ما ناجيتُ والنَغَمُ",257,"م",1,0],["وأنتَ لهذا القلبِ صبحٌ .. أعيشهُ","وأنتَ الهوىٰ والعشقُ والحبُّ والهدَىٰ",258,"د",2,0],["وأنتَ لنا حياةٌ سوفَ تبقى","لتهدِيَنا . . لجناتٍ . . عليَّةْ",259,"ي",2,0],["وأنتَ لنا في الخير منهاجُ قدوةٍ","بعلمٍ أبانته النُهىٰ . . والدفاترُ",260,"ر",1,0],["وانت ليل لو ضويته مايضيّا","ضعت فيه وشفت نفسي في ضياعه",261,"ع",2,0],["وأنت لملك الله قلب لذاك قد","أطافت بك الأكوان دون سعاية",262,"ه",1,0],["وأنت لسان الحق بالحق نائبا","عن الله في إصلاح حال الخليقتي",262,"ت",2,0],["وأنت لكل ذي علم","سلاح ليس ينثلم",263,"م",1,0],["وانت لو عندك عقل ناضج وعندك عبقرية","ماحكيت ابذالحكي بهل الوفا والمكرماتي",264,"ت",2,0],["وانت لو ناقشت لك بعض القضايا الواقعية","كان قلنا الرجل مقصوده يحل المعظلاتي",264,"ت",2,0],["وأنْتِ لَدَى سُفُني مَرافِيها","فُتُونًا أوافي لا أُجافيها",265,"ي",3,0],["وإنتل قلبي ، له من أقصى المعاليق","نتل الرشاء للدلو، وأقفا بساقه",266,"ق",2,0],["وأنت لهم أمّ وأنت له