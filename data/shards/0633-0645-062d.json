n/poem/47068","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81712","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121264","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28926","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35464","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76719","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120475","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52184","الخفيف"],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5312,"الحكمُ للهِ كلٌّ غيرُه فاني","https://www.poetsgate.com/ViewPoem.aspx?id=128473",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[709,"كتمَ الهوى فوشى النّحولُ بسرّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2905",""],[709,"رنا فسلَّ على العشاق أحوره","https://www.poetsgate.com/ViewPoem.aspx?id=2883",""],[5461,"يا جريح القلب","https://www.poetsgate.com/ViewPoem.aspx?id=1323",""],[5582,"صَبٌّ بِدِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[402,"صدق النعي ورددد الهرمان","https://www.poetsgate.com/ViewPoem.aspx?id=36491",""],[402,"فز بغيداء حرة أوتيت فضلا","https://www.poetsgate.com/ViewPoem.aspx?id=35029",""],[5851,"يا سيد الخلق","https://www.poetsgate.com/ViewPoem.aspx?id=175235",""],[5911,"سمحت بيعا لمملوك يعاندني","https://www.poetsgate.com/ViewPoem.aspx?id=188969",""],[6085,"كامل الزين","https://www.poetsgate.com/ViewPoem.aspx?id=8676",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""],[6259,"إن الحمولَ غداة َ غربة غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59356&r=&rc=4",""]],"verses":[["سَمَحتُ بِهِ إِذ لَم أَجِد عَنهُ مَدفَعاً","وَإِنّي عَلى عُذري بِهِ لَضَنينُ",0,"ن",1,0],["سَمَحَت بِكُم نَفسي عَلى مَضَضٍ","وَلَرُبَّ سامِحَةٍ عَلى ضِنِّ",1,"ن",1,0],["سَمَحَت كَفُّهُ بِهِ لِلمَنايا","بَعدَ أَن لَم يَكُن مِنَ الأَجوادِ",2,"د",1,0],["سَمَحْتَ بِهِ لَمْ تَرْعَ فَرْطَ ضَنَانَةٍ","وَفِي مِثْلِهَا مِنْ سُنَّةٍ يُتْرَكُ الْفَرْطُ",3,"ط",1,0],["سَمحَةٍ سَمحَجِ القَوائمِ حَقباءَ","مِنَ الجونِ طُمِّرَت تَطميرا",4,"ر",2,0],["سَمحٌ دَريرٍ إِذا ما صُوَّةٌ عَرَضَت","لهُ قَريباً لِسَهلٍ مالَ فَاِنحَرَفا",5,"ف",2,0],["سَمحُ الخَليقَةِ لا نِكسٌ وَلا غُمُرٌ","بَل باسِلٌ مِثلُ لَيثِ الغابَةِ العادي",6,"د",2,0],["سَمحٌ خَلائِقُهُ جَزلٌ مَواهِبُهُ","وافي الذِمامِ إِذا ما مَعشَرٌ غَدَروا",7,"ر",3,0],["سَمحٌ إِذا يَسَرَ الأَقوامُ أَقدُحَهُم","طَلقُ اليَدَينِ وَهوبٌ غَيرُ مَنّانِ",8,"ن",1,0],["سَمحٌ سَجِيَّتُهُ جَزلٌ عَطِيَّتُهُ","وَلِلأَمانَةِ راعٍ غَيرُ خَوّانِ",8,"ن",1,0],["سَمحُ الخَلائِقِ مَحمودٌ شَمائِلُهُ","عالي البِناءِ إِذا ما قَصَّرَ الباني",8,"ن",2,0],["سمح إذا جار المعاش","عليه أصنفه معاده",9,"د",2,0],["سَمْحِ المُحَيَّا وَالضَّمِيرِ سِرَارُهُ","كَجِهَارِهِ مِمَّا تَرَى العَيْنَانِ",10,"ن",1,0],["سَمْحَ الخَلائِقِ أَوْلانِي مَدَائِحَهُ","وَجَلَّ مَا قَلْبُهُ المِسْمَاحُ أَوْلانِي",11,"ن",2,0],["سَمْحُ السَّرِيرَةِ هَمُّهُ ألا يَرَى","مِنْ ثُلْمَةٍ فِي وَحْدَةِ الأَوْطَانِ",12,"ن",1,0],["سَمْحٌ بِفِطْرَتِهِ أَبِيٌّ عَادِلٌ","مَا ضَامَ إِنْسَاناً وَلَيْسَ يُضَامُ",13,"م",1,0],["سمحتم بنظم الدُّرِّ في لَبَّةِ العلا","فكم راق من سمط هناك ومن عِقدِ",14,"د",1,0],["سَمَحتَ مِنّي بِمُهجَةٍ كَرُمَت","أَنتَ عَلى يَأسِها مُؤَمَّلُها",15,"ل",3,0],["سمحاً يسابقني إلى القبل التي","قد كان يقنعني بها إيماؤه",16,"ا",3,0],["سمحتُ بروحي للحسان فما لكم","وما لي وما هذا التعسف والجهد",17,"د",1,0],["سمْحٍ بِعِرْسيْهِ حليم المشْهَدِ","خالدُ يا ذا السؤددِ المؤطَّدِ",18,"د",1,0],["سمحٌ ببذل القِرى سماحَ فتىً","سَلَّمَ عِرض القرى لعرَّاضه",19,"ض",2,0],["سمحتم بضيعتكم للخسا","ر يأكلها ناعل بعد حافي",20,"ف",2,0],["سَمحٌ إِذا ضَنَّ الجَبانُ بِروحِهِ","فَكَأَنَّما في جِسمِهِ روحانِ",21,"ن",1,0],["سمحا تراه ترى العناية جهرة","والحق أبلج في الجبين مصوَّرا",22,"ر",2,0],["سمح البنان بكل ما زان الثرى","فالوشى يوهب والحلىّ يعار",23,"ر",1,0],["سمحت بروحي في هواه رخيصة","ومن يهو لا يؤثر على الحب غاليا",24,"ي",2,0],["سمحَ الأزمّة ما تريد تحوّلا","ونريد عمرك أطول الأعمار",25,"ر",1,0],["سمحنا بما بخلوا كلهم","به وشرحنا الذي أجملوا",26,"ل",3,0],["سَمحُ اليَدَينِ إِذا اِحتَبى في مَجلِسٍ","كانَ النَدى صِفَةً لِذاكَ النادي",27,"د",2,0],["سُمُحٌ بَينَ بُرمَةِ أَعشارٍ","تَتَكَفّا وَجَفنَةُ أَكسارِ",28,"ر",1,0],["سَمحَ الخَلائِقِ لِلعَواذِلِ عاصِياً","في المَكرُماتِ وَلِلسَماحِ مُطيعا",29,"ع",2,0],["سَمحُ اليَدَينِ لَهُ أَيادٍ جَمَّةٌ","عِندي وَمَنٌّ لَيسَ بِالمَمنونِ",30,"ن",1,0],["سَمَحَت لي به السُّجوفُ فما حا","دَ عن العينِ والرَّكائبُ تُحدَى",31,"د",2,0],["سَمَحتَ بِأَمرٍ لا يُطاقُ حفيظَةً","وَصِدقاً وَإِخوانُ الحِفاظِ قَليلُ",32,"ل",1,1],["سَمِّح كُفوفَكَ في الشِراءِ فَرَأيُنا","ثَقلُ الكُؤوسِ وَخِفَّةُ الأَكياسِ",33,"س",1,0],["سَمحُ الأَكُفُّ تَرومُ نائِلَكَ الوَرى","وَتَخافُكَ الآسادُ في الأَخياسِ",33,"س",1,0],["سَمَحتَ اِبتِداءً وَلَم أَمتَدِح","وَأَنعَمتَ عَفواً وَلَم أَسأَلِ",34,"ل",1,0],["سَمَحَت بِكَ الأَيّامُ وَهيَ بَواخِلٌ","وَلَرُبَّما جادَ البَخيلُ بِعَمدِهِ",35,"د",2,0],["سَمْحٌ تَبَرّجَ جودُ راحتهِ","لعفُاته ولعِرضه خفَرُ",36,"ر",1,0],["سمحٍ نجرُّ به أذيالَنا مرَحاً","حِيناً ونعثُر في أذياله حينا",37,"ن",2,0],["سَمَحَ الخَيالُ عَلى النَوى بِمَزارِ","وَالصُبحُ يَمسَحُ عَن جَبينِ نَهارِ",38,"ر",1,1],["سمحِ الشَّريعةِ والخلالِ مُسَدَّدٍ","في نَقضِهِ للأمرِ أو إبرامِهِ",39,"م",2,0],["سَمَحتُ في سَفكِ دَمي راضِياً","بِرَشفَةٍ مِن ريقِكَ السَلسَلِ",40,"ل",1,0],["سَمحَتْ لأنْمُلِها الجمي","لِ بِريقِها كْي تَقلِبه",41,"ب",2,0],["سَمحٌ أَخو ثِقَةٍ شُجا","عٌ لا تُنَهنِهُهُ المَزاجِر",42,"ر",1,0],["سَمحَةٍ في الشَمالِ مِثلِ عَصا الذا","ئِدِ أَو مِثلُها رَحاةُ السَجيرِ",43,"ر",1,0],["سُمَحاءُ الفَقرِ أَجوادُ الغِنى","سادَةُ الشَيبِ مَخاريقُ المُرُد",44,"د",1,0],["سمحت نوارُ كما نروم بوقفةٍ","تصغى بها لشكاية من مغرم",45,"م",1,0],["سمحاً جواداً في سبيل الله","ندبا عن الحقوق غير لاه",46,"ه",1,0],["سَمْحٌ قَلِيلُ القَوْلِ إِنْ تَسْأَلْ بِهِ","تَسْمَعْ إِجَابَاتِ الفَعَالِ النَّاطِقِ",47,"ق",1,0],["سَمْحٌ إِلَى الإِتْلاَفِ إِنْ يَتَقَاضَهُ","ذَاكَ الوَفَاءُ وَلَمْ يَظُنَّ ثَوَابَا",48,"ب",2,0],["سَمْحُ السَّجِيَّةِ لا تَعْ","دَمُ المَرَافِق عَطْفَهْ",49,"ف",2,0],["سَمُحُ الضَّمِيرِ بِحِلْمِهِ وَيَزيدُهُ","نُبْلاً وَفَضْلاً أَنَّهُ سَمُحُ الْيَد",50,"د",1,0],["سَمِحَ الْفُؤادِ قَوِيُّ الْجَأْشِ رَابِطُهُ","بِحَيْثُ يُعْصَمُ مِنْ جَهْلِ وَمِنْ غَضَبِ",51,"ب",1,0],["سَمْحٌ إِذَا جَارَ المَعَا","شُ عَلَيْهِ أَنْصَفَهُ مَعَادُهْ",52,"د",2,0],["سَمَحْتَ بِدَعْوَةٍ فَأَجَابَ قَلْبِي","وَعِيقَتْ عَنْكَ عَيْنِي بِاضْطِرَارِ",53,"ر",1,0],["سَمْحَةِ القَلْبِ ظَاهِرٍ لُطْفُ مَا","تُضْمِرُهُ فِي جَبِينِهَا الوَضَّاءِ",54,"ا",2,0],["سَمَحتْ له الدُّنيا بماء سَرَابِها","فابتاعَه منها بماءِ حَياتِه",55,"ت",2,0],["سمحتْ براتبه خُلو","ف، ما لها أبدًا ثقوب",56,"ب",1,0],["سَمْحٌ أخو ثقة ٍ شجا","عٌ ما تنهنههُ المزاجر",57,"ر",1,0],["سمح فبالريقة العذراء نادمنا","نهلا وبالشفة اللمياء عاطانا",58,"ن",2,0],["سمحت بالوصال والليل قد أس","دل ثواباً وقد أمنا الرقيبا",59,"ب",2,1],["سَمَحتُ بِنَفسِي للهَوى واحتسَبتُها","علَيكَ وَلولا أنتَ لَم أحتَسِب نَفسِي",60,"س",2,0],["سمح الزمان لنا بأحسن شعره","وأجله لنجي به لنجيبه",61,"ب",2,0],["سُمحٌ بَهاليلُ عَيّافُو الخَنا صُبُرٌ","يَومَ الكَريهَةِ طَلّابُونَ إِن وُتِرُوا",62,"ر",3,0],["سَمحُ المَوَدَّةِ فى العَطاءِ حَرِيمُهُ","عِندَ الثُّرَيّا مِن يَدِ المُتَناوِلِ",63,"ل",1,0],["سمحت للدهر بما عندي","فزاد بي جهداً على جهدي",64,"د",2,1],["سَمَحَ الزَمانُ بِقُربِهِ","مِن بَعدِ تَسويفٍ وَمَطلِ",65,"ل",1,0],["سمحتُ بقلبي والهوى يورثُ الفتى","طباعَ الجواد المحضِ وهو بخيلُ",66,"ل",1,1],["سمح بالهجر الا انه","بوصال منه لي ما سمحا",67,"ح",2,0],["سمحٌ تراه إذا حللتَ بحيَّه","أَبداً يحنّ إلى خِصال الجود",68,"د",1,0],["سَمْح السجايا مستهِلاًّ عَمْرا","أرحب مَن يمشي عليها صدرا",69,"ر",2,0],["سَمَحَ الخَيالُ بِوَصِلِها","فَدَنَت عَلى عُدوائِها",70,"ا",3,0],["سَمحٌ إِذا بَخِلَ الحَيا","ثَبتٌ إِذا طاشَ الحَليمُ",71,"م",1,0],["سَمَحتُ بِدَمعي لِلدِيارِ مُسائِلاً","رُسومَ الهَوى لَو أَنَّ تَسآلَها يُجدي",72,"د",2,0],["سَمحٌ إذا حلَّ في مغناه ذو أدب","فالمدح يُنظَمُ والأموال تنتَثرُ",73,"ر",1,0],["سَمحٌ إذا دجت الخطوبُ فبشرُهُ","بَرقٌ وغَيثُ نواله هَطَّالُ",74,"ل",1,0],["سمحَت بإرسال الدموع محاجري","مذ صدّ عنّي ريم رملة حاجرِ",75,"ر",1,1],["سمحٌ إذا قابلتَه","صادفتَ أعظم منهل",76,"ل",1,0],["سَمَحتِ بوصلٍ كان منكِ تعلَّةً","فلم يَشف مني غلَّةً وسقاما",77,"م",2,0],["سَمَحتُ بما في القلب والعينِ للهوى","ولو قابلت بالبخلِ خيرَ هِباتي",78,"ت",2,0],["سَمْحاً لأفْواه المُلوكِ بِراحَةٍ","لَثَمُوا أنَامِلَها وَهُنّ بُحُورُ",79,"ر",1,0],["سَمَحَ الزَّمانُ بِصَفْوِهِ وَجَرى بِنا","فِيهِ السُّرُورُ يَمُدُّ فِي مَيْدانِهِ",80,"ه",1,0],["سَمحَ البَدرُ بوصلٍ فَشَفى","من جوى الحبِّ سَقيماً مُغرما",81,"م",2,1],["سمحٌ فإِنْ عارضته هوةً قُذُفٌ","أراك إِقدامَ وَثّابٍ وَدلاّح",82,"ح",1,0],["سمح الزمان بوصل ريم الأجرع","ذات المحاسن والجمال المبدع",83,"ع",1,1],["سَمَحت بكأسِ الوصلِ صفواً بعدما","عَضَلتهُ في خدرِ المطالِ دهورُ",84,"ر",1,0],["سَمْحٌ متى بَلَغتْ بَرْقاً أَسِرَّتُهُ","جَاءَتْ يَداه مَجَرَّ العَارِضِ الهَطِلِ",85,"ل",1,0],["سَمحت بِالوَصلِ بَعد الهَجر يا حسن","وَزالَ ذاكَ العَنا وَالهم وَالحُزن",86,"ن",1,1],["سَمحت بِاللُقا وَأَسرعت السَي","ر فَشابَت شهدا بِسَم الاِفاعي",87,"ع",2,0],["سَمح الزَمان لَنا بِه يَوما فَما","تَرك السُرور بغيه عَن جهده",88,"د",2,0],["سَمْحٌ إذا انتابَه العافونَ قال له","رَأيٌ بتَخْليدِ حُسْنِ الذِكّرِ يُوصيه",89,"ي",2,0],["سَمْحُ البديهةِ ليس يُمسكُ لَفْظَه","فكأنّما ألفاظُه من ماله",90,"ل",2,0],["سمْحٌ إذا جِئْته يوماً لتسأله","أعطاكَ كُلَّ الأماني ثُمَّ قالَ سل",91,"ل",1,0],["سَمْحٌ على الدّينِ بالدّنيا أناملُهُ","سُحْبُ النّدى وسِواهُ الطّاعمُ الكاسي",92,"س",2,0],["سمحُ الخَليقَةِ واليَدَي","نِ إذا سَماحُهُما تَعذَّر",93,"ر",1,0],["سمحنا به فاسمح بكل كرامة","له وتلقى طيَّ نجواه بالنشر",94,"ر",1,0],["سمح الخَلائِقِ حَظَّهُ","مَمّا حَواهُ دونَ حظ الأَجنَبي",95,"ب",2,0],["سَمحَ الخَليقَةِ وَالخَلائِق وَجهَهُ","