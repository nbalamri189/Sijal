{"poems":[[186,"روزا فتاة بني الجاويش قد رحلت","https://www.aldiwan.net/poem61047.html","البسيط"],[186,"روزا فتاة بني عبد المسيح قضت","https://www.aldiwan.net/poem61105.html","البسيط"],[186,"روزين عنحوري العزيزة قد ثوت","https://www.aldiwan.net/poem66982.html","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93864","البسيط"]],"verses":[["رُوزا فَتاةُ بَني الجاويشِ قَد رَحَلَت","كَالغُصنِ لاقَتهُ ريحُ البينِ فَاِنكَسَرا",0,"ر",2,1],["رُوزا فَتاةُ بَني عَبدِ المَسيحِ قَضَت","كَالغُصنِ قَد قَصَفتَهُ راحةُ القَدَرِ",1,"ر",1,1],["روزينُ عَنحوري العزيزة قَد ثَوَت","قَبراً بِحَبَّاتِ القُلوب تَكَلّلا",2,"ل",2,1],["روزنامتي منعت صرفاً وفي فرجي","بوسعه الدين تضيق وتشديد",3,"د",1,0]]}