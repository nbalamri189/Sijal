[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5431,"ويشق قلبي بدرها المتكور","https://www.poetsgate.com/ViewPoem.aspx?id=196923",""],[5480,"صوغ الألماس","https://www.poetsgate.com/ViewPoem.aspx?id=29629",""],[5604,"يَا عَارِفاً مِن كُلِّ فَن","https://www.poetsgate.com/ViewPoem.aspx?id=168949",""],[5674,"ياوجها من الألق","https://www.poetsgate.com/ViewPoem.aspx?id=188335",""],[5674,"قلبك معبدي","https://www.poetsgate.com/ViewPoem.aspx?id=197554",""],[5720,"مَنْ أُعطيَ جوامعَ القولِﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=201565",""],[5853,"عيناكِ.. عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175688",""],[5887,"سأل الطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=35336",""],[5926,"أيلام قلب","https://www.poetsgate.com/ViewPoem.aspx?id=214343",""],[5956,"يا ميِّتاً من حزنهِ","https://www.poetsgate.com/ViewPoem.aspx?id=183751",""],[5956,"وصلتْ إليّ رسالةٌ من درِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193810",""],[5956,"أعانك الله في ترتيب أنفسكم","https://www.poetsgate.com/ViewPoem.aspx?id=193864",""],[6093,"أصورَ الجَرْحَ في القرطاسْ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=183886",""],[6183,"أنت المغني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79843&r=&rc=33",""]],"verses":[["أَنتَ الفَتى وَابن الفَتى وَأَخو الفَتى","وَسَيِّدُنا لَولا خَلائِقُ أَربَعُ",0,"ع",1,1],["إِن تَألَفي سِنَةَ النَؤومِ خَلِيَّةً","فَلَطالَما نافَرتِ فِيَّ كَراكِ",1,"ك",1,0],["أَنتَ الفَتى الماجِدُ الحامي حَقيقَتَهُ","تُعطي الجَزيلَ بِوَجهٍ مِنكَ مِشراقِ",2,"ق",1,0],["أنت الفراشُ لمن أضلَّ فراشَهُ","وكذاك طِرزُك للذكورِ إناثُ",3,"ث",1,0],["أَنتَ الفَتى الباقي بِئاثارِهِ","ما أَنتَ بِالمَرءِ إِذا ماتَ مات",4,"ت",1,0],["أَنتَ الفَتى لَكَ في النَسيمِ حَفيفُهُ","وَلَكَ الغَديرُ صَفائُه وَخَريرُهُ",5,"ر",2,0],["أَنتَ الفِداءُ لِخَيرٍ مِنكَ مَأثُرَةً","عِندَ التَنائي وَخَيرٍ مِنكَ في النادي",6,"د",2,0],["أَنتَ الفَريدُ الَّذي حازَت خَلائِقُهُ","ما لا يُحيطُ بِهِ الإِحصاءُ وَالعَدَدُ",7,"د",1,0],["أَنتَ الفَتى كُلُّ الفَتى لَو أَنَّ ما","تُسديهِ في التَأنيبِ في الإِسعادِ",8,"د",1,0],["أَنْتَ الْفَرِيدَةُ فِي بَدِيعِ نِظَامِهِمْ","وَهُمُ الْقِلاَدَةُ دُرُّهَا مُخْتارُ",9,"ر",1,0],["أنت الفتى لك في النسيم حفيفه","ولك الغدير صفاؤه وخريره",10,"ر",2,0],["أنت الفتى المخلوق من ماء الندا","والعالمون من الحما االمسنون",11,"ن",1,0],["أنت الفتيّةُ لا تدرين مفسدةً","أين المفاسد من أخلاق أولاد",12,"د",1,0],["أنت الفقيرُ مع الغِنى","إن لم تجدْ عقلا يُمدُّك",13,"ك",1,0],["أنت الفيّاض ومولي سح","ب الجود لإطفاء الوهج",14,"ج",1,0],["أَنتَ الفَتى الَّذي يُجي","دُ مَدحَهُ فِتيانُ",15,"ن",1,0],["أَنتَ الفَريدُ وَهذِهِ","في وَصفِ عَياك الفَرائِد",16,"د",1,0],["أنت الفريد الألمعي أبو الثنا","وابن الذكا وأخو الحجى المتسامي",17,"م",2,0],["أنت الفريد قيادة ومهابة","وفطانة منها ترى مالا نرى",18,"ر",2,0],["أنت الفؤاد أمامي","مشاهد مرئي",19,"ي",1,0],["أَنت الفريدُ في زما","نٍ نَاسُه نَسانِسْ",20,"س",1,0],["أنت الفؤاد لوادي النيل تنعشه","والجسم لولا فؤاد فيه ما كانا",21,"ن",2,0],["أنت الفريد بأمة عبرية","ستكون طول الدهر فيها مفردا",22,"د",2,0],["أنت الفؤاد لجسمنا نحيا به","ايكون في جسم فؤاد ثان",23,"ن",1,0],["أنتِ الفريدة في النسآءِ فكيف لا","أهوى حبيباً بات دون مثيلِ",24,"ل",1,0],["أنتِ الفريدةُ في الأنامِ وليسَ من","عجبٍ فإنَّ الشمسَ عزَّ نظيرُها",25,"ر",3,0],["أنت الفريدةُ في عصرٍ وُجِدتِ بهِ","وما لشمسِ الضحى في الكون من مَثَلِ",26,"ل",1,0],["أنتِ الفريسةُ لحمُ عفّتِها","قد قاسمتهُ الآنَ ألفُ يَدِ",27,"د",1,0],["أَنْتَ الفَريدُ بِسِلْكِ الجُودِ مُنْتَظَمٌ","وهي الرحيقُ بِمِسْكِ الشِّعرِ مَخْتومُ",28,"م",1,0],["أَنْتَ الفَتَى لم يَرُعْكَ الغَيُّ عن رَشَدٍ","ولا شَرَيْتَ هُمومَ المُلْكِ بالجَدَلِ",29,"ل",1,0],["أَنت الفَتى كُلُّ الفَتى","لَو كُنتَ تَفعَلُ ما تَقول",30,"ل",1,1],["أنت الفريد الذى حازت خلائقه","ماليس يبلغه حصر وتقدير",31,"ر",1,0],["أنت الفريدة في البها وأنا كما","تجدين شيخٌ من بقايا عاد",32,"د",1,0],["أنت الفريدة في الدّنيا بطلعتها","هيهات تلقين فيها من يساويك",33,"ك",1,0],["أنت الفقيه إذا ودت بقيتنا","لا الضاربو (فيه) أخماساً بأسداس",34,"س",1,0],["انت الفتاة التي رقت شمائلها","وانت كالعنبر الداري رياك",35,"ك",1,0],["أنت الفريد وذاك لل","علياء أصبح مصطفى",36,"ف",2,0],["أنتَ الفؤاد وروح ما تصبو له","هذي البلاد وكلّهم آجامُ",37,"م",1,0],["أنتَ الفؤاد وكلّ ما نصبو له","وجميع من في هذه الدُنيا صُوَر",38,"ر",1,0],["أنت الفدا والحمى لمن عبت فار","جع صاغراً راغماً لك الندم",39,"م",1,0],["أنتَ الفصيحُ أميرُ الشِعرِ مَن مَلكتْ","يَمينُهْ جامحَ الأشعارِ والأدبِ",40,"ب",1,0],["أنت الفتوة في جود وفي كرم","حماك للنجح محجوج ومقصود",41,"د",1,0],["أنتَ الفؤاد وجسم الروح يا قمر","والشمسُ أنتَ وأنتَ الروحُ والبصرُ",42,"ر",1,1],["أَنتَ الفِداءُ لِمن عَصَاني في الهوَى","وغدا لأمرِك سامعاً ومُطيعا",43,"ع",2,1],["أنت الفَريدُ بأوصاف معدّدةٍ","مدحي قَصيرٌ بحمدي خيرَ محمودِ",44,"د",1,0],["أنت الفصيح البَليغ الشاعر العلَم ال","فردُ الحريُّ بوصفٍ غير مكذوبِ",45,"ب",1,0],["أنت الفريدة في البرايا جمَّةً","قد زانكِ المولى بلا تزيينِ",46,"ن",1,0],["أنت الفداء لمن بالأمس فارقتني","يعطي الجزيل بلا من ولا بخل",47,"ل",1,0],["أَنتَ الفَضَاءُ الغَارُ, والعَدَمُ الذي","يَبقَى, وأَنتَ الطَّائِرُ المَيمُونُ",48,"ن",1,0],["أَنْتِ الْفَنَاْرُ عَلَىْ الشُّطْآنِ يُرْشِدُنِيْ","حَتَّىْ أَجِيْءَ إِلَى الْمَعْشُوْقِ فِي الْجُزُرِ",49,"ر",1,0],["أنت الفضاء جمالا شدَ منظره","عصفورَ شعري فأمسى فيه هيمانا",50,"ن",2,0],["أنت الفضاءُ كَمَالاً في محاسنِه","والشعرُ أضعف عُصفورٍ رنا فيها",51,"ي",3,0],["أنت الفضاءُ توسُّعاً، وإحاطةً","لمعارفِ الإنسانِ في إلمامِ",52,"م",1,0],["أنتِ الفضيلةُ حينَ يكشفُها المدى","ولها ومِنْ كشْفِ الجَمَال ِ بيانُ",53,"ن",1,0],["أنت الفدا وابن الفدا وأخو الفدا","لولاك ما كان الفدا مذكورا",54,"ر",2,0],["أنتِ الفُؤادُ وَ من شِغافِكِ أرتَدي","ثَوباً يَشُفُّ بِعِشقِك الخلّابِ",55,"ب",1,0],["أنت الفريد بهامة وضاءة","ويشق قلبي بدرها المتكور",56,"ر",1,0],["أنت الفخر لي مدّته ترفع الرأس","مَّدت كريم ٍ ما يخفّي الأيادي",57,"د",2,0],["أنتَ الفَتَى الأسني الحَسَن","في يَقَظَةٍ وفي وَسَن",58,"ن",1,0],["أنتٓ الفراتُ.. ودٓمعي منكٓ منهٓلُهُ","رِمْشي سياجُكٓ .. كُنْ كالطِّفْلِ في حٓدٓقي",59,"ق",2,0],["أنتِ الفضاءُ وأنتِ شمس محبتي.","مغرورة يا أنتِ.. قلبكِ معبدي",60,"د",2,0],["أنتَ الفَصَاحةُ في الألفاظِ مَبحَثُهَا","وحينَ تلقاكَ تلقى منك مُصطَلَحَا",61,"ح",2,0],["أنتِ الفرات عذابات أسطرها","مزنا تهامى فظل الحرف ريّانا",62,"ن",2,0],["أنت الفلسطيني عشت مشردا","أنت ابن هذي الأرض مهد الأنبياء",63,"ا",2,0],["أنت الفؤاد وأنت نبض مشاعري","وبقلب قلبي روضة وقطوف",64,"ف",1,0],["‏ ‏أنت الفدائيّ الذي","‏ ‏ لم يُبْقِ أجرة دفْنِهِ",65,"ن",2,0],["أنت الفتى الحق الفهيم بديننا","ليحسّن الدنيا وليس لذعرِ",66,"ر",1,0],["أنت الفراس الذي لا تنتهي أبداً","منك المكارم والإخلاص للصّمدِ",67,"د",1,0],["أنت الفريدُ وإنْ زَعَمُوا","زُوْرَاً لكم توأماً في النَّاسْ",68,"س",1,0],["أنتَ الفِدَائِيُّ أنتَ اليَومَ عَاصِفَةٌ","إذا غضِبْتَ فلا طَوْد وَلا سَفْحُ",69,"ح",1,0]]}