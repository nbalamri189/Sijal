{"poems":[[93,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[58,"أنا أوقي من المكاره من دم","https://www.aldiwan.net/poem58483.html","الخفيف"],[68,"فلتة كان منك عن غير قصد","https://www.aldiwan.net/poem40442.html","الخفيف"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[237,"يا حبيب الحبيب تفديك روحي","https://www.aldiwan.net/poem14882.html","الخفيف"],[285,"يا دهر قد عديت عنك طلابي","https://www.aldiwan.net/poem60597.html","الكامل"],[443,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[580,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122328","الخفيف"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105440","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205786","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102952","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4680,"أنا أول التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=202579",""],[4902,"ذكرتك","https://www.poetsgate.com/ViewPoem.aspx?id=4974",""],[4988,"خبري وليده ....","https://www.poetsgate.com/ViewPoem.aspx?id=154188",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"نورس الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=186441",""],[5277,"القصيدةُ القيسيّة","https://www.poetsgate.com/ViewPoem.aspx?id=199277",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5756,"غرام احباب","https://www.poetsgate.com/ViewPoem.aspx?id=5423",""],[5790,"أنا أولى بما ذكرت من الأم","https://www.poetsgate.com/ViewPoem.aspx?id=111947",""],[5821,"نشرة الأخبار","https://www.poetsgate.com/ViewPoem.aspx?id=113756",""],[5843,"اخر مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=51292",""],[5848,"محتاج لك","https://www.poetsgate.com/ViewPoem.aspx?id=50622",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""],[6113,"قصة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=44360",""]],"verses":[["أَنا أَولى بِالحُبِّ مِنك وَأَحرى","مِن كِساءٍ يَبلى وَمالٍ يَنفَد",0,"د",1,0],["أَنا أُوقي مِنَ المكارِهِ مَنْ دَمْ","عِي عليهِ أَرَقُّ مِنْ خَدَّيْهِ",1,"ه",1,1],["أَنا أَولى بِها لِعِدَّةِ أَقسا","مٍ جِسامٍ لَكِن أُسِرُّ وَتُبدي",2,"د",2,0],["أنا أوّلُ المُتفاوِضينَ مكانةً","عند التقدُّمِ ثم يأتي التالي",3,"ل",2,0],["إنا أوَيُناها غداةَ تشردت","وعدت على دار السلام عواد",4,"د",1,0],["أَنا أَولى مِنهُ بِحَملِ التَجَنّي","وَاِمتِلاءِ الأَجفانِ بِالتَسهيدِ",5,"د",1,0],["أَنا أَوْحَدُ الشُّعَراءِ فاحْبُ قَرائِحِي","بِكَ رُتْبَةً يا أَوْحَدَ الْكُتّابِ",6,"ب",1,0],["أنا أولى الورى بجود أيادي","ك وإنعامكَ السحوح الدفوق",7,"ق",1,0],["أَنا أَوضحته وبينته جدّاً","وأَفهمته لِمَن كان يَفْهمَ",8,"م",1,0],["انا أولى بان تصون ودادي","مثلما بالمديح انت جدير",9,"ر",1,0],["أنا أولى بأن أعزى بمولىً","أنعشتني من جوده النعماء",10,"ا",2,0],["أنا أوَّلٌ في الممكناتِ مقيدٌ","وإطلاقها الله فالأول الله",11,"ل",2,0],["أنا أولى بحفظ ودى لاني","قد أطعت الغرام نهيا وأمرا",12,"ر",2,0],["أنا أودعتها حنيني إلى بغ","داد في عهدها الجليل الماسي",13,"س",2,0],["أنا أولى بمدحه وعلاه","أن يفقني شعرا فلي منه همه",14,"م",2,0],["أنا أو إبليس للدنيا عمى","هو خاف وأنا أبدو جليا",15,"ي",2,0],["أنا أوحد الشعراء شأنا فيكم","إني وفيضك للمعالي أوحد",16,"د",1,0],["أنا أولى بأن أنوح وأشدو","وعلى كاهلي يعلو الرغام",17,"م",1,0],["أنا أولى إذا بكيت بدمعٍ","أذهبت نور عينه الأيام",17,"م",1,0],["أنا أول التاريخ والحقب التي","غرستْ جذور المكرمات بتربتي",18,"ت",2,0],["أنا أول عزاي أني..حملت العاشق اللي مانسى حلفه","وأنا آخر عزاي إنك..نسيتيني وأنا طيفك معي وافي",19,"ف",2,0],["أنآ أوجآع وآوجآعي ذيآبه","تحوف آلقلب أوجآآاآع وتزيده",20,"د",2,0],["أنا أول الديوان... ليلى ختامه","فيا ليتها في الوصل كانت ختاميا",21,"ي",2,0],["أنا اوّلُ الدّيوانِ أنتِ ختامُهُ","فَيا ليتَها بالوصلِ كانت ختامِيا",22,"ي",2,0],["أنا اوّلُ الدّيوانِ… ليلى ختامُهُ","فَيا ليتَها بالوصلِ كانت ختامِيا",23,"ي",2,0],["أنا أولى الورى بوصلك ممن","لم يقدرك والمجال سحيق",24,"ق",1,0],["أنا أول من عرف قدرك وأنا توي صغير وشاب","وابي منك ما دام أنك عرفتيني تحبيني",25,"ن",2,0],["أنا أولى بما ذكرت من الأم","ثال إن كان في الحراف تفاخر",26,"ر",1,1],["أنا اوّل من لبس فيكم ثياب المهزله والعار","لأن الحق في نفسي لقى في الشعر منديله",27,"ل",2,0],["انا اول حكاية فوق ماكان بالامكان","وانا آخر مسافر راح محدن عرف سره",28,"ر",2,0],["انا اوعدك اني ابقى وين ما رحتي بدون يدين !","ولا احضن غير صدرك والغرام ان فل جنحانه",29,"ن",2,0],["أنا أولى بهم فليسلني","أو يشأ رؤيتهم فليراني",30,"ن",2,0],["أنَا أَوْلَى بحَملِهِ عَنْكَ فالسَّيْ","يدُ يُغنِي بالكَلِّ عَنْهُ الغُلامُ",31,"م",1,0],["انااول ماكتبت الشعر كان لعين بدويّه","تقابلناواناجاهل وهم في الباديه يرعون",32,"ن",1,0]]}