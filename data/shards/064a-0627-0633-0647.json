{"poems":[[46,"يا سهم للبرق الذي استطارا","https://www.aldiwan.net/poem29693.html","الرجز"],[46,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[473,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86848","الخفيف"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34411","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77954","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125409","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205002","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71401","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66541","الكامل"],[4684,"طيف غزال.","https://www.poetsgate.com/ViewPoem.aspx?id=201337",""],[4733,"شكوى السّهاد","https://www.poetsgate.com/ViewPoem.aspx?id=189178",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[5191,"يا من ظلمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211975",""],[5318,"في حُبِ إربد","https://www.poetsgate.com/ViewPoem.aspx?id=206817",""],[5431,"ولكَم يُظلم النبيل الأصيلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=196635",""],[5470,"رقصات قلب","https://www.poetsgate.com/ViewPoem.aspx?id=10998",""],[5573,"النعش فوق الثريا له منصه","https://www.poetsgate.com/ViewPoem.aspx?id=206497",""],[5632,"يا سهل....","https://www.poetsgate.com/ViewPoem.aspx?id=177817",""],[5813,"باب الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176828",""],[5848,"ليل السهر","https://www.poetsgate.com/ViewPoem.aspx?id=48819",""]],"verses":[["يا سَهمُ لِلبَرقِ الَّذي اِستَطارا","باتَ عَلى رَغمِ الدُجى نَهارا",0,"ر",2,1],["يا سَهمُ كَيفَ يُفيقُ مِن سُكرِ الهَوى","حَرّانُ يُصبَحُ بِالفِراقِ وَيُغبَقُ",1,"ق",1,0],["يا سَهلُ سَهَّلتَ عَيشي","مِن بَعدِ ما كانَ وَعرا",2,"ر",2,1],["يا سِهام الرَدى أَصبت إِماماً","دُونه في العُلوم زَيد وَعَمرو",3,"ر",2,0],["يا سهمه كَم ذا رَمي","تَ بِسَعدِهِ فأَصبتَ مَرمى",4,"م",2,0],["يا سهم قوس القتل","يا طيب أَهل البيت",5,"ت",1,0],["يا سهام اللحاظ يافتكات","من رماح القدود مهما تشاء",6,"ا",2,0],["يا سِهامَ الجُفونِ كُفِّي فهذا","مُهجُ العاشقين جرحى حيارى",7,"ر",2,0],["يأسه صغر الوجود لديه","فرأى أعظم الوجود ضئيلا",8,"ل",2,0],["يَا سَهْمَ مُقْلِتَهَا إِلَى","قَلْبِي وُصُولُكَ فَانْفُذِ",9,"ذ",1,0],["يا سَهْمُ هذا مِنْكَ أَصْوَبُ مَقْصِداً","يا سَيْفُ هذا مِنْكَ أَسْرَعُ مَقْطَعا",10,"ع",2,0],["يا سهام اللحظ حسبي قسوة , إنّي أعاني","شهد طعم ٍمن شفاه ٍأسبغت برداً شرابا",11,"ب",2,0],["يا سُهادي ردَّ سؤلي","عن هجُوعٍ ضَاع حَولِي",12,"ل",2,1],["يا سهادي إنَّ نومي","منك يرجو العطفَ قبلي",12,"ل",2,0],["يا سهام لها شرر","بصدر همو كما القصر",13,"ر",1,0],["يا سَهلَ \"إربِدَ\" فَلتُبلغْ شادِنا","فَلَعلَّ أنْ يَلقاكَ إذ يَلقاكا",14,"ك",2,0],["يا سهلَ إربدَ يا \"حورانَ\" يا وطناً","فيكَ الحياةُ وفيكَ يُلاقنْا الأجلُ",15,"ل",1,0],["ياسهيلا ياهدهدا يانبيلُ","ياوفاءً محببا يانخيلُ",16,"ل",1,1],["يَاسَهِيرَ العَينِ هَبْ لِي مَرْكَبًا","يَمخُرُ اللَّيلَ إلَى الطَّيفِ رَحِيلاَ",17,"ل",2,0],["ياسهى ساريك جوف الليل خصّه","والبدر ماغاب في داخل مداري",18,"ر",2,0],["ياسهل لاتنبهر من شيفة الروس","الجماجم تنحني مهما علا الراس",19,"س",1,1],["ياسهل دعوة على منهاج مدروس","خير عندي من ذهب مطعوم بالماس",19,"س",1,0],["ياسهر عيني .. يازعلها..وعتابي","ياورد حلمي .. ياثمر كله اعناب",20,"ب",1,0],["يا سهل دنياي لو هي صعبة أرقامي","يا شح غيمي ! ويا ما اوسعك يا بيدي",21,"د",2,0]]}