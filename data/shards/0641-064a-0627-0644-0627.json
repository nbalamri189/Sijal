oetsgate.com/ViewPoem.aspx?id=72167",""],[5493,"سبيل الألم","https://www.poetsgate.com/ViewPoem.aspx?id=197683",""],[5563,"وتغنَّيْتُ بمَية","https://www.poetsgate.com/ViewPoem.aspx?id=212490",""],[5628,"المخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=178801",""],[5750,"كوني مع الليل","https://www.poetsgate.com/ViewPoem.aspx?id=214629",""],[402,"لم يكد يسبق الفضاء نذير","https://www.poetsgate.com/ViewPoem.aspx?id=35702",""],[402,"ذلك كالرزء في الصديق الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=36332",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[5851,"الوطن المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=175286",""],[5861,"شكوى أم","https://www.poetsgate.com/ViewPoem.aspx?id=188057",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5952,"تضوع عطراً","https://www.poetsgate.com/ViewPoem.aspx?id=202703",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5956,"أتاني الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181868",""],[5956,"واعدتني والخلف طبعُ \"المؤمنِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=194007",""],[6019,"غيابُ (هلالٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205482",""],[161,"الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=157684",""],[6152,"أبى الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=201741",""],[831,"ذكرى جلوسك مظهرُ الأوطانِ","https://diwany.org/%D8%B0%D9%83%D8%B1%D9%89-%D8%AC%D9%84%D9%88%D8%B3%D9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"],[313,"إلى شباب بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66490&r=&rc=15",""],[186,"عيد به للهنا والبشر تجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55749&r=&rc=12",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[6222,"يا تائهون على الدروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1930&r=&rc=1",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""]],"verses":[["في الأَمرِ يَتَّهِمُ القَري","بَ عَليهِ وَالخِلَّ الحَميما",0,"م",2,0],["فَيا لائِمَيَّ اليَومَ لا صَبرَ بَعدَهُ","فَطيرا بِأَعباءِ المَلامَةِ أَو قَعا",1,"ع",2,0],["فَيا لابِساً شَعْرَ الذُّؤابَةِ ناسِكاً","ليُخْبِرَ في وَصْلي بمَذْهَبِ زُهْدِهِ",2,"د",2,0],["في الأَرضِ ما تَبغونَ مِن","عِزٍّ وَآمالٍ كِبار",3,"ر",1,0],["في الإِقتِصادِ حَياتُنا","وَبَقاؤُنا رَغمَ المُكابِر",4,"ر",1,0],["فِي الأَدِيبِ الأَدِيبِ وَالشَّاعِرُ الشَّا","عِرِ وَالمِدْرَهِ الأَرِيبِ الْحَكِيمِ",5,"م",1,0],["فِي الأَبْيَضِ اللَّمَاحِ مِنْهُ","نُورُ عِفَّتِهَا يُلاَلي",6,"ل",2,0],["في الأغاني تمثّل الحبّ تمثي","لاً صريحاً بصوتها الفتّان",7,"ن",1,0],["فيا لائمي في حب لبنان انني","أحسّ لعمري منه ما لا تحسّه",8,"س",2,0],["فَيا لاهِياً آمِناً وَالحِمامُ","إِلَيهِ سَريعٌ قَريبُ المَدى",9,"ا",1,0],["في الأرضِ من أثرِ السرَى قولٌ به","يملي الهنا ولشهرنا إصغاء",10,"ا",2,0],["في الأربعينات الثلا","ث مَواعظ لذوي العُقَدْ",11,"د",1,0],["في الأَرضِ بُعدُكُمُ وَاماءُ مِثلَهُما","وَالبُغضُ في الحُرِّ مِثلُ البُغضِ في العاني",12,"ن",2,0],["في الارض ما انا الا","بقية من بقايا",13,"ا",3,0],["في الارض تزهق انفس","اما السماء فلا تمور",14,"ر",1,0],["في الالى يحتفون حولي قد يخطئ","فهمي وليس يخطئ حدسي",15,"س",2,0],["في الأرض صار كالعلم","بعزة تمحو الظلم",16,"م",1,0],["في الأَرضِ من أَبَوَيكَ كِنزا رَحمَةٍ","وَهَوىً وَذَلِكَ مِن جِوارٍ كافي",17,"ف",2,0],["في الأَرضِ مِنهُم سَماواتٌ وَأَلوِيَةٌ","وَنَيِّراتٌ وَأَنواءٌ وَعُقبانُ",18,"ن",1,0],["في الأَمرِ ما فيهِ مِن جِدٍّ فَلا تَقِفوا","مِن واقِعٍ جَزَعاً أَو طائِرٍ طَرَبا",19,"ب",2,0],["فيَا لأَبي العَبّاسِ كَمْ رُدَّ راغبٌ","لِفَقْدِكَ مَلهوفاً وكَمْ جُبَّ غَارِبُ",20,"ب",1,0],["في الأَقرَبينَ وَفي الأَباعِدِ تارَةً","إِنَّ الزَكاةَ قَرينَةُ الصَلَواتِ",21,"ت",1,0],["في الأَرضِ ظِلَّ اللَهِ كُنتَ وَلَم يَلُح","في الشَمسِ ظِلُّكَ إِن حَواكَ مَكانُ",22,"ن",1,0],["في الأَرضِ مِن عَدلِ الإِمامِ وَجودِهِ","وَمِنَ النَباتِ الغَضِّ سُرجٌ تَزهَرُ",23,"ر",1,0],["فيا لائماً قَدْ لامَ في تركِ منصبٍ","خُطبتُ لهُ تَرْكي لذلك منصبُ",24,"ب",1,0],["فَيا لائِمي وَالنَفسُ وَلهى لِما بِها","حَنانَكَ إِنَّ الحُرَّ يوجِعُهُ الأَسرُ",25,"ر",1,0],["في الآلِ يَحفِزُها الحُدا","ةُ كَأَنَّها سُحُقٌ مَواقِر",26,"ر",1,0],["في الآلِ تَحْدُوهُنَّ لي أدمُعٌ","تُراهِنُ العِيسَ على السَّبْق",27,"ق",1,0],["في الأَرضِ حَيٌّ وَغَيرُ حَيٍّ","فَجامِدٌ بَينَنا وَنامِ",28,"م",1,0],["في الأديب الحر النفاق ذميمٌ","وهو ما لا يرضاه منه الضميرُ",29,"ر",1,0],["في الأرض دارَت رحىً للحرب طاحنةٌ","وَلَيسَ منها عَلى ذي حيطةٍ خطرُ",30,"ر",1,1],["في الأَرضِ أقدامُ الرَّبيع","تُلامِسُ السَّهْلَ الجَديبْ",31,"ب",1,0],["فِي الأَسَى مِنْ تَفَتتِ الْكَبِد","مِثْلُ أَسَى وَالِدٍ عَلى وَلدِ",32,"د",1,1],["فِي الإِخْوَةِ الغُرِّ الثَّلاَثَةِ هَلْ تَرَى","إِلاَّ جَمَالَ خَلاَئِقٍ أَتْرَابِ",33,"ب",1,0],["فِي الأَرْبَعِ السَّنَوَاتِ مِصْبَ","احَاهُمَا يَتَأَلَّقَانِ",34,"ن",1,0],["فِي الأُمُورِ الصِّعَابِ يَمضِي فَمَا","يَثْنِي عِنَاناً حَتَّى تُرَاضَ الأُمُورُ",35,"ر",1,0],["فِي الأَعَاصِيرِ فلْكُه تَتَهَادَى","فَإِذَا مَا اهْتَدَتْ فلَيْسَتْ تَجُورُ",35,"ر",1,0],["فِي الأَصْلِ وَالفَرْعِ مِنْكُمْ","مَجْدٌ يُسَلْسِلُ مجْدَا",36,"د",2,0],["في الأَمِينِ الأَبَرِّ حُرِّ السَّجَايَا","صَادقِ الْوَعْد مُخْلِف الأَيْعَاد",37,"د",1,0],["في الأُذن قهوْةَ كَرْمٍ","والكف قهوةُ بُنِ",38,"ن",1,0],["في الآل ترفعها الحدا","ة كأنّها سحقٌ مواقر",39,"ر",1,0],["فيا لاسقت إلا يداه ضريحه","ففيه مسح الغيث حل وماطره",40,"ر",2,0],["في الأرضِينَ جُلتَ شَرقاً وغَرباً","تَتَقفي المَشرُوبَ والمَطعُومَا",41,"م",2,0],["في الأرض سبعةُ أبحرٍ ويمينُه","وشِمالُه تجرى بعشرةِ أبحرِ",42,"ر",1,0],["في الأَرضِ أَهلُ مَمالِكٍ ساحاتُهُم","وَصُدورُهُم في المَحلِ غَيرُ رِحابِ",43,"ب",1,0],["فَيا لائِماً في بَسطِ كَفِّ مُحمَّدٍ","مَتى لِيمَ في أَن يَستَهِلَّ غَمامُ",44,"م",1,0],["في الأرض ذلك في السماوات العُلى","تُدعَونَ سادةَ سادةِ العُمّالِ",45,"ل",1,0],["في الأرض وادي ووادي","في الماء أو في الخيال",46,"ل",1,0],["في الأمر سر قد طوته","النفس عن عقلي الكليل",47,"ل",1,0],["في الأرض ما بين السبا","ع وفي السماء بين النسور",48,"ر",1,0],["في الأرضِ عاثوا فساداً بعد ما شربوا","خمرَ الحوانيتِ وامتصّوا المداخينا",49,"ن",2,0],["في الآلِ يَرفَعُها وَيَخفِضُها","ريعٌ كَأَنَّ مُتونَهُ سَحلُ",50,"ل",1,0],["في الأرضِ مِنْ فتوحِنا","مآثرٌ وفي السما",51,"م",2,0],["في الاِسمِ وَالحُسنِ وَالتَمامِ","لِيوسُفَ مُشارِكُ",52,"ك",1,0],["في الأناسي من يميت شعوبا","بسموم يظنهن شفاء",53,"ا",2,0],["في الأَعيُن الزُرق أَرى حكمة","لاحَت لَنا كَالشَمس في الرابعه",54,"ع",2,1],["فَيا لاِفتخارٍ فيهِ آمنةٌ عَلت","عَلى كُلِّ مَن تَعلوهُ شَمس وَكَوكَبُ",55,"ب",1,0],["في الأربعاء قد خرج","وفي الخميس قد ولج",56,"ج",1,0],["في الأَربِعاء لخمسٍ كُنَّ من صَفَرٍ","بَدْرُ المَسَرَّةِ شاهَدْنا مطالِعَهُ",57,"ه",1,1],["في الآلِ طافيةٌ وراسيةٌ","سيرَ السفينِ بلجّةِ البَحرِ",58,"ر",1,0],["في الأرض منكَ ومن أبيكَ وإن مضى","سعدانُ ما ناواهما السُعْدانِ",59,"ن",1,0],["فيا لائمي لو ذقت لعقة شهوتي","دعاك إلى ما تكره العذل الحب",60,"ب",1,0],["في الأرض تشخصُ للسماء كأنها","عرفَتْ ذَراك من السِّماك العالي",61,"ل",2,0],["في الأرض منهم لعزّهم فلكٌ","بكلّ ما شاد ذِكرهم دائرْ",62,"ر",1,0],["في الأَرضِ فَيروزَجٌ مُحَلّى","مِن أَغصُنٍ بِالبَهارِ تُجلى",63,"ل",2,1],["في الأصدقاء خليل","تجسم اللطف فيه",64,"ي",2,1],["في الأرض مالك يا فتى","إلا الثلاث الأذرع",65,"ع",1,0],["في الآستانة كم من آية ظهرت","للفاتحين وكم جاؤوك بالعجب",66,"ب",1,0],["فيالَ الوَحا يا غارَةَ اللهِ نفحَةً","بإسْراجِ أَسرارٍ من الطَّمْسِ تُظْلِمُ",67,"م",1,0],["فِي الاَدرُعِ الدِّلاصِ","فِي المَوضِعِ المُصَاصِ",68,"ص",1,0],["في الأَرضِ وفي السَماءِ لا ربٌ سِواكَ","ما نَعبُدُ يَا واحِد إلاّ إيَاك",69,"ك",1,0],["في الاستقامة قده متعذر","ما دار حول الوهم فكر مثاله",70,"ل",2,0],["في الأسرِ مفقودٌ عَن أهلٍ نازحٌ","وبِفَقدِهِ فَقَدو لذيذ مَنامِ",71,"م",1,0],["فَيا لائِماً في دَمعَتي أَو مفنّداً","عَلى لَوعَتي وَاللوم منهُ عَناءُ",72,"ا",2,0],["في الأرضِ عبدُ العزيزِ اليومَ زِينتُها","ومِثلُهُ في السَّماءِ الشَّمسُ والقَمرُ",73,"ر",1,0],["في الإبتهاج وفي السرور نفوسنا","وقلوبنا اشتركت مع الأبصار",74,"ر",1,0],["في الإختبار إذا طويت فراسخا","فأمام قصدك لا تزال فراسخ",75,"خ",1,0],["في الأمسِ تُعطي ثُمَّ تعطي ال","