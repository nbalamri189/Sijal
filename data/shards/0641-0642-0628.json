ps://www.aldiwan.net/poem4950.html","الوافر"],[28,"وأنتم عضاريط الخميس عتادكم","https://www.aldiwan.net/poem5487.html","الطويل"],[66,"كتبت إلي ترغب في حضوري","https://www.aldiwan.net/poem38431.html","الوافر"],[69,"فإلى جاهك ميل","https://www.aldiwan.net/poem29223.html","مجزوء الرمل"],[74,"أنفحة طيب ما تنسمت أم نظم","https://www.aldiwan.net/poem13259.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[22,"أبى لك أباء أبى لك مجدهم","https://www.aldiwan.net/poem22066.html","الطويل"],[48,"يا رب ساق كأنه شبه البدر","https://www.aldiwan.net/poem64402.html","المنسرح"],[50,"فلما ودعونا واستقلوا","https://www.aldiwan.net/poem63852.html","الوافر"],[7,"لعمرك ما خشيت على يزيد","https://www.aldiwan.net/poem1961.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12529","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"الكبش والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179570",""],[77,"ثنى الصعدة السمراء من لين قده","https://www.poetsgate.com/ViewPoem.aspx?id=33801",""],[90,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[9,"تَصَابَيتَ أمْ بانَتْ بعَقْلِكَ زَيْنَبُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20018",""],[51,"نظرتُ إلى الرغيفِ فردّ رُوحِي","https://www.poetsgate.com/ViewPoem.aspx?id=29374",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[78,"كَتَبتُ وَعِندي مِن فراقِكِ ما عِندي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86475&r=&rc=20",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["فَقَبلَ الشَيبِ أَسلَفتُ الغَواني","قِلىً وَأَمالَني عَنها اِجتِنابُ",0,"ب",1,0],["فقبّلْتُ في لَيلِ الذّؤابَةِ وجْهَهُ","وعُذْتُ بذاكَ النّورِ منْ ليْلِ صَدِّهِ",1,"د",2,0],["فَقَبلَكَ ما أَوفى الرُفادُ لِجارِهِ","فَأَنجاهُ مِمّا كانَ يَخشى وَيَرهَبُ",2,"ب",1,0],["فَقَبِلتُ اليَدَ مِن بَطنِ يَدٍ","ظَهرُها الدَهرَ مَحَلٌّ لِلقُبَل",3,"ل",1,0],["فَقَبَّلتُهَا تِسعاً وتِسعِينَ قُبلَةً","ووَاحِدَةً أَيضاً وكُنتُ عَلَى عَجَل",4,"ل",1,0],["فقبل مضاء السيف تُمضي عزائمٌ","وبعد بناء الرأي تُبنى المعاقلُ",5,"ل",1,0],["فَقَبلَكَ ما أَعيا الرُماةَ إِذا رَمَوا","صَفاً لَيسَ في عادِيِّهِنَّ صُدوعُ",6,"ع",1,0],["فَقُبِّحَ عابِدٌ وَبَنو أَبيهِ","فَإِنَّ مَعادَهُم شَرُّ المَعادِ",7,"د",1,0],["فقبول النفوس إياك عندي","آيةٌ فيك للطيف الخبير",8,"ر",1,0],["فقبّلتُ الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمول فرض",9,"ض",1,0],["فقُبحاً يوم تُبعثُ يا ابن موسى","لوِجهِكَ مُرْدِفاً قُبحاً وشيكا",10,"ك",2,0],["فقبلتَ منه حَوالةً مكروهةً","ورأيتها حظاً إليك أَميلا",11,"ل",2,0],["فقَبْلكَ قام أقوامٌ قُعودٌ","لريب الدهر أو قعد القيامُ",12,"م",1,0],["فَقَبلَكَ رامَها الجَبّارُ فينا","فَكانَ لَنا وَلِلجَبّارِ دينُ",13,"ن",1,0],["فَقَبيحٌ أَن نَرتَدي الحُلَلَ القُش","بَ وَتَبقى الرُبى بِغَيرِ ثِيابِ",14,"ب",1,0],["فَقَبَّلتُ أَقداماً لِغَيرِيَ مامَشَت","وَوَجهاً مَصوناً عَن سِوايَ مُحَجَّبا",15,"ب",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح إِلى العِقد",16,"د",1,0],["فقبلته سلمى النحيفة","ثم ارتمى رأسها لضعف",17,"ف",1,0],["فقبل القبل كنت كذا سماءً","ولا شمسٌ هناك ولا ضياء",18,"ا",2,0],["فقبلتها وصرفت فكري تارة","نحو الثناء وتارة في صرفها",19,"ف",3,0],["فَقَبَّلتُ كَفّاً كانَ بِالسَيفِ ضارِباً","وَقَبَّلتُ سَيفاً كانَ بِالكَفِّ يَضرِبُ",20,"ب",1,0],["فَقَبَّلَت ناظِري تُغالِطُني","وَإِنَّما قَبَّلَت بِهِ فاها",21,"ا",3,0],["فقبلِيَ ما خلَّى عليّاً شقيقُهُ","وقرَّ بهِ بعدَ العراقِ شآمُ",22,"م",1,0],["فَقَبلَكِ بانَ الفَتحُ عَنّي مُوَدِّعاً","وَفارَقَني شَفعاً لَهُ المُتَوَكِّلُ",23,"ل",1,0],["فَقُبِّحَ شَرُّ حَيَّينا قَديماً","وَأَصغَرُهُ إِذا اِغتَرَفوا ذِنابا",24,"ب",2,0],["فَقَبلَكَ ما أَعيَيتُ كاسِرَ عَينِهِ","زِياداً فَلَم تَقدِر عَلَيَّ حَبائِلُه",25,"ل",2,0],["فقبلت الكتاب وقلت سمعا","لأمرك سيدي وأنا الجواب",26,"ب",1,0],["فقبولُ الجاهِ فخرٌ","وقبولُ المالِ عارُ",27,"ر",1,0],["فَقَبَّلتُ كَفّاً أَتحَفَتني بِعِلقِهِ","وَحَقٌّ لِكَأسِ الراحِ أَن يُكرَمُ الكَرَمُ",28,"م",1,0],["فَقَبَّلتُ مِنهُ الجود فِي بَطنِ راحَةٍ","تُنَاجِي المُنَى فِيهَا الثُّغُورُ اللَّواثِمُ",29,"م",1,0],["فَقَبلَكُم ما أَتى موسى بِآيَتِهِ","مِصراً فَلَم يُغنِ عَن فِرعَونَ هامانُ",30,"ن",1,0],["فَقَبرٌ بِأَجبالٍ وَقَبرٌ بِحاجِرٍ","وَقَبرُ القَليبِ أَسعَرَ الحَربَ ساعِرُه",31,"ر",2,0],["فَقُبِّلَت صَفحَةٌ وَسالِفَةٌ","مِن رَوضِ غَضِّ الشَبابِ مُؤتَنِفُه",32,"ف",2,0],["فَقَبلَ دُموعِ عَينِكَ خَبَّرَتنا","بِما جَمجَمتَ زَفرَتُكَ الصَعُودُ",33,"د",1,0],["فَقَبلَكَ ما شُتِمتُ وَقاذَعوني","فَما نَزُرَ الكَلامُ وَلا شَجاني",34,"ي",1,0],["فَقُبضتْ رِهانُهُمْ وأُمِّنوا","وأَنْفَضوا رُؤوسَهُم وأَذْعُنوا",35,"ن",3,0],["فَقبِلَ الإمامُ من أَيمانِهِ","وردَّه عفواً إلى مكانِهِ",35,"ه",1,0],["فقبل عود الرَسول عنها","لا أَبتَغي من هنا براحا",36,"ح",2,0],["فقبَّلها وظلَّلها هواهُ","وندَّى قلبَها والعيشُ جَدْبُ",37,"ب",1,0],["فَقَبَّلْتُهُ ظَمْأَى كَأَنَّ بِمُهْجَتِي","لَظَى النَّارِ وَالشَّيْبُ المُقَبَّلُ مَنْهَلُ",38,"ل",1,0],["فَقَبَّحتِ الخِطابَ وَلَستُ أَدري","لِأَيَّ جِنايَةٍ قُبحُ الخِطابِ",39,"ب",1,0],["فقبِّلُوا تُرْبَ حطِّينٍ فإنَّ بهِ","دَمَ البُطُولةِ مِنْ أيام حطينَا",40,"ن",2,0],["فقبَّل الكبش ناب الذئب معتذرًا","عما رماه به من سالف التُّهم",41,"م",1,0],["فقبلت في ليل الذؤابة وجهه","وعدت بذاك النور من ليل صده",42,"د",2,0],["فقبلَك طاوعتُ من أهلِها","صديقاً إلى مَصرَعي قادني",43,"ن",2,0],["فَقَبْلَكَ مَا أوْفَى الرُّفَادُ لجَارِهِ،","فأنْجاهُ مِمّا كان يَخشَى وَبَرْهَبُ",44,"ب",1,0],["فقبَّلتُه الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمولِ فرض",45,"ض",1,0],["فَقَبَّلَهَا حَتَّى أَجَفَّ دِمَاءَهَا","وكَم سَاعَفَ الحَر المُذِيب شَقَاءَهَا",46,"ه",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح من العِقد",47,"د",1,0],["فقبلْن الصوارمَ والجفونا","وما أَنسى التي برزَت وقالت",48,"ا",3,0]]}