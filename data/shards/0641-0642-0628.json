وديه"],[451,"الحب والحسن والأمان","https://www.aldiwan.net/poem61245.html","مخلع البسيط"],[462,"أما واللمى وجداً بساكنه الملا","https://www.aldiwan.net/poem3589.html","عموديه"],[466,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[468,"وما الشعر إلا خطبة من مؤلف","https://www.aldiwan.net/poem4802.html","الطويل"],[475,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[491,"جاد ربعا حللته يا همام","https://www.aldiwan.net/poem67324.html","الخفيف"],[511,"سقى الله رمل القاع في النخلات","https://www.aldiwan.net/poem67774.html","الطويل"],[513,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[513,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[549,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[549,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["فَقَبلَ الشَيبِ أَسلَفتُ الغَواني","قِلىً وَأَمالَني عَنها اِجتِنابُ",0,"ب",1,0],["فقبّلْتُ في لَيلِ الذّؤابَةِ وجْهَهُ","وعُذْتُ بذاكَ النّورِ منْ ليْلِ صَدِّهِ",1,"د",2,0],["فَقَبلَكَ ما أَوفى الرُفادُ لِجارِهِ","فَأَنجاهُ مِمّا كانَ يَخشى وَيَرهَبُ",2,"ب",1,0],["فَقَبِلتُ اليَدَ مِن بَطنِ يَدٍ","ظَهرُها الدَهرَ مَحَلٌّ لِلقُبَل",3,"ل",1,0],["فَقَبَّلتُهَا تِسعاً وتِسعِينَ قُبلَةً","ووَاحِدَةً أَيضاً وكُنتُ عَلَى عَجَل",4,"ل",1,0],["فقبل مضاء السيف تُمضي عزائمٌ","وبعد بناء الرأي تُبنى المعاقلُ",5,"ل",1,0],["فَقَبلَكَ ما أَعيا الرُماةَ إِذا رَمَوا","صَفاً لَيسَ في عادِيِّهِنَّ صُدوعُ",6,"ع",1,0],["فَقُبِّحَ عابِدٌ وَبَنو أَبيهِ","فَإِنَّ مَعادَهُم شَرُّ المَعادِ",7,"د",1,0],["فقبول النفوس إياك عندي","آيةٌ فيك للطيف الخبير",8,"ر",1,0],["فقبّلتُ الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمول فرض",9,"ض",1,0],["فقُبحاً يوم تُبعثُ يا ابن موسى","لوِجهِكَ مُرْدِفاً قُبحاً وشيكا",10,"ك",2,0],["فقبلتَ منه حَوالةً مكروهةً","ورأيتها حظاً إليك أَميلا",11,"ل",2,0],["فقَبْلكَ قام أقوامٌ قُعودٌ","لريب الدهر أو قعد القيامُ",12,"م",1,0],["فَقَبلَكَ رامَها الجَبّارُ فينا","فَكانَ لَنا وَلِلجَبّارِ دينُ",13,"ن",1,0],["فَقَبيحٌ أَن نَرتَدي الحُلَلَ القُش","بَ وَتَبقى الرُبى بِغَيرِ ثِيابِ",14,"ب",1,0],["فَقَبَّلتُ أَقداماً لِغَيرِيَ مامَشَت","وَوَجهاً مَصوناً عَن سِوايَ مُحَجَّبا",15,"ب",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح إِلى العِقد",16,"د",1,0],["فقبلته سلمى النحيفة","ثم ارتمى رأسها لضعف",17,"ف",1,0],["فقبل القبل كنت كذا سماءً","ولا شمسٌ هناك ولا ضياء",18,"ا",2,0],["فقبلتها وصرفت فكري تارة","نحو الثناء وتارة في صرفها",19,"ف",3,0],["فَقَبَّلتُ كَفّاً كانَ بِالسَيفِ ضارِباً","وَقَبَّلتُ سَيفاً كانَ بِالكَفِّ يَضرِبُ",20,"ب",1,0],["فَقَبَّلَت ناظِري تُغالِطُني","وَإِنَّما قَبَّلَت بِهِ فاها",21,"ا",3,0],["فقبلِيَ ما خلَّى عليّاً شقيقُهُ","وقرَّ بهِ بعدَ العراقِ شآمُ",22,"م",1,0],["فَقَبلَكِ بانَ الفَتحُ عَنّي مُوَدِّعاً","وَفارَقَني شَفعاً لَهُ المُتَوَكِّلُ",23,"ل",1,0],["فَقُبِّحَ شَرُّ حَيَّينا قَديماً","وَأَصغَرُهُ إِذا اِغتَرَفوا ذِنابا",24,"ب",2,0],["فَقَبلَكَ ما أَعيَيتُ كاسِرَ عَينِهِ","زِياداً فَلَم تَقدِر عَلَيَّ حَبائِلُه",25,"ل",2,0],["فقبلت الكتاب وقلت سمعا","لأمرك سيدي وأنا الجواب",26,"ب",1,0],["فقبولُ الجاهِ فخرٌ","وقبولُ المالِ عارُ",27,"ر",1,0],["فَقَبَّلتُ كَفّاً أَتحَفَتني بِعِلقِهِ","وَحَقٌّ لِكَأسِ الراحِ أَن يُكرَمُ الكَرَمُ",28,"م",1,0],["فَقَبَّلتُ مِنهُ الجود فِي بَطنِ راحَةٍ","تُنَاجِي المُنَى فِيهَا الثُّغُورُ اللَّواثِمُ",29,"م",1,0],["فَقَبلَكُم ما أَتى موسى بِآيَتِهِ","مِصراً فَلَم يُغنِ عَن فِرعَونَ هامانُ",30,"ن",1,0],["فَقَبرٌ بِأَجبالٍ وَقَبرٌ بِحاجِرٍ","وَقَبرُ القَليبِ أَسعَرَ الحَربَ ساعِرُه",31,"ر",2,0],["فَقُبِّلَت صَفحَةٌ وَسالِفَةٌ","مِن رَوضِ غَضِّ الشَبابِ مُؤتَنِفُه",32,"ف",2,0],["فَقَبلَ دُموعِ عَينِكَ خَبَّرَتنا","بِما جَمجَمتَ زَفرَتُكَ الصَعُودُ",33,"د",1,0],["فَقَبلَكَ ما شُتِمتُ وَقاذَعوني","فَما نَزُرَ الكَلامُ وَلا شَجاني",34,"ي",1,0],["فَقُبضتْ رِهانُهُمْ وأُمِّنوا","وأَنْفَضوا رُؤوسَهُم وأَذْعُنوا",35,"ن",3,0],["فَقبِلَ الإمامُ من أَيمانِهِ","وردَّه عفواً إلى مكانِهِ",35,"ه",1,0],["فقبل عود الرَسول عنها","لا أَبتَغي من هنا براحا",36,"ح",2,0],["فقبَّلها وظلَّلها هواهُ","وندَّى قلبَها والعيشُ جَدْبُ",37,"ب",1,0],["فَقَبَّلْتُهُ ظَمْأَى كَأَنَّ بِمُهْجَتِي","لَظَى النَّارِ وَالشَّيْبُ المُقَبَّلُ مَنْهَلُ",38,"ل",1,0],["فَقَبَّحتِ الخِطابَ وَلَستُ أَدري","لِأَيَّ جِنايَةٍ قُبحُ الخِطابِ",39,"ب",1,0],["فقبِّلُوا تُرْبَ حطِّينٍ فإنَّ بهِ","دَمَ البُطُولةِ مِنْ أيام حطينَا",40,"ن",2,0],["فقبَّل الكبش ناب الذئب معتذرًا","عما رماه به من سالف التُّهم",41,"م",1,0],["فقبلت في ليل الذؤابة وجهه","وعدت بذاك النور من ليل صده",42,"د",2,0],["فقبلَك طاوعتُ من أهلِها","صديقاً إلى مَصرَعي قادني",43,"ن",2,0],["فَقَبْلَكَ مَا أوْفَى الرُّفَادُ لجَارِهِ،","فأنْجاهُ مِمّا كان يَخشَى وَبَرْهَبُ",44,"ب",1,0],["فقبَّلتُه الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمولِ فرض",45,"ض",1,0],["فَقَبَّلَهَا حَتَّى أَجَفَّ دِمَاءَهَا","وكَم سَاعَفَ الحَر المُذِيب شَقَاءَهَا",46,"ه",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح من العِقد",47,"د",1,0],["فقبلْن الصوارمَ والجفونا","وما أَنسى التي برزَت وقالت",48,"ا",3,0],["فَقَبلناه وَقَد جا","ءَ لَنا بِالمَدح مُعلَم",49,"م",1,0],["فقبلوا منك بالعهد الوثيق يدا","منها عليهم رداء الفضل ينسحب",50,"ب",1,0],["فَقُبِّحَ وَوجَهُهَا مِن مُستَشَارِ","وقًُبَّحَ وَجهُهُ مِن مُستَشِيرِ",51,"ر",1,0],["فَقَبَّلتُكِ أَلفِينِ","وَفَدَّيتُ وَحَيَّيتُ",52,"ت",1,0],["فقبّلت من أقدامه وبساطه","وقال لك البشرى بذا قضي الأمر",53,"ر",1,0],["فَقُبحُهَا أظهرُ من حسنها","وضُرُّهَا أكثر من نفعها",54,"ع",3,0],["فَقَبلي قَضى النُعمانُ في السِّجنِ نَحبَهُ","وَغُودِرَ مَسلوباً وَقَد كانَ سالِبا",55,"ب",2,0],["فَقُبحاً لَكُم ماذا تَعُدُّونَ في غَدٍ","إِذا اِفتَخَرَ الأَقوامُ يا أَخلَفَ النَسلِ",56,"ل",1,0],["فَقَبلي أَخُو شَنّ بنِ أَفصى أَضاعَهُ","بَنُو عَمِّهِ دَونَ الوَرى وَفَضائلُه",57,"ل",2,0],["فَقبّلتُ مثلَ الشمسِ لا بل كَمالُها","على الشمس والبدر المنير يزيد",58,"د",1,0],["فقبضت نفسي عنهمُ","إلا على ظهر الطريق",59,"ق",1,0],["فَقَبَعتُ في داري كصَقرٍ شاكياً","ولو أنّنا في غيرهِ لم نَقبَعِ",60,"ع",1,0],["فقبلها كان بالاهلين لي شغل","واليوم اصبحت لا اهل ولا شغل",61,"ل",1,0],["فقبّلت ثغريه وقبّلت خدَّهُ","فأضحى قتيلاً والمحب قتول",62,"ل",1,0],["فَقَبَّلَ عَمُّهُ يَدَهُ بِحُبٍّ","وَقالَ أَتَيتُ أَطلُبُ مِنكَ عُذرا",63,"ر",2,0],["فَقَبَّلَني عَلى شَفَتي رَسولٌ","وَمَسَّ فَمي كَلامٌ عَبقَرِيُّ",64,"ي",1,0],["فَقُبلَةُ الخُلدِ لَم أَضَعها","إِلّا عَلى حافَةِ القُبورِ",65,"ر",1,0],["فقبّلْتها وقالت وهي ضاحكة","وكيف تَسْقِي خدود الناس للناس",66,"س",1,0],["فَقَبلت منْ َكف الرسُولِ عِلاقَةً","مِسَاحَةَ قِرْطاسٍ مِنَ السوْسَنِ الرطْبِ",67,"ب",1,0],["فقبّلت فاه العذب تقبيل شيّق","وما كنت في تقبيل ممشاه أطمع",68,"ع",1,0],["فَقَبِّل ثَرى الأَرضِ عَنّي فَلي","بِتَقبيلِ مَوطىءِ نَعلَيهِ فَخرُ",69,"ر",1,0],["فقبابها وكواكب الج","وزاء تسمو باتفاق",70,"ق",1,0],["فقبّل ثرى ذاك المقام فإنّه","به منزل البدر الّذي هو مقصدي",71,"د",2,0],["فقبلك ما لبت لبيني وأسعدت","سعاد ولم يحمل بحالي حلا جمل",72,"ل",1,0],["فَقبَّلتُ جيداً فيهِ نفحَةُ زَنبقٍ","مساءَ وَعَينا سقمها يَبعَثُ الخَدر",73,"ر",1,0],["فَقَبيحُ الغَرامِ عِندي جَميلٌ","وَجَميلُ العَزاءِ عِندي قَبيحُ",74,"ح",1,0],["فقبلوا مقالَهُ","واِمتَثلوا ما قالَهُ",75,"ه",1,0],["فقبَّلتُ من مَثواهُ أَعتابَه الَّتي","أَنافَت على هام السِماكَين والنَسرِ",76,"ر",1,0],["فقبَّل الأَرضَ من أَعتابِ ساحَتِها","وَعفَّر الخدَّ تَعظيماً وتَشميتا",77,"ت",2,0],["فَقَبَّلتُ إثرَكَ فوقَ الثَّرَى","وعانقتُ ذكركَ في مَضجعي",78,"ي",1,1],["فَقَبَّلْتُهُ ألْفَاً وَألْفَاً كَرَامَةً","وَلْمَ أَرضَ إِجْلالاً لَهُ الرَّأسَ مَوْضِعا",79,"ع",2,0],["فقبَّلها عَشراً وأظهرَ حُبَّها","فلما ذكرتُ المهرَ طلَّقها عَشرا",80,"ر",2,0],["فقبلي مات الخالدان كلاهما","عميد بني حجوان وابن المضلل",81,"ل",1,0],["فقبري ما حواهُ من ترابٍ","وكُفْني فيهِ نَسْجُ العَنْكَبوت",82,"ت",1,0],["فقبولهم روحي هو الثمن الذي","لا أبتغي فيه نقادة صيرفي",83,"ي",1,0],["فقبَّلْتُهُ ألفاً وقابلت دُره","بشيء يسد السمع لو كان ينشد",84,"د",1,0],["فقبلي منه الثرى","فذاك حقاً يجب",85,"ب",1,0],["فَقَبَّلَتنيَ تَوديعاً فَقُلتُ لَها","كُفّي فَلَيسَ اِرتِشاف الخَمرِ مِن شِيَمي",86,"م",2,0],["فَقَبَّلتُ إِذ عاينته خُفَّ ناقَةٍ","حباني بِهِ تهجيرها وابتِكارها",87,"ر",3,0],["فقبل المزج تحسبها عقيقاً","وبعد المزج تحسبها نضارا",88,"ر",2,0],["فقبضك الناس مداراتهمُ","وذاك كالقبض على الجمرِ",89,"ر",1,0],["فَقَبَسْتُها ناراً يُضِيءُ لَهيبٌها","بِيَدِ المِزاجِ عَلَى الزُّجَاجَةِ نُورا",90,"ر",2,0],["فقبلتُه وأتيتُ أقْ","دَمَ صاحبٍ في الهول أقدَمْ",91,"م",1,0],["فقُبحاً لدهر جار في الحكم صرفهُ","وغالت لكيسخرو المليك غوائله",92,"ل",2,0],["فقبر الندى والحَمد والمَجد والعُلا","وحسن المَساعي والأَيادي له قبر",93,"ر",1,0],["فقبل الحرب ربوات","أدانونا بلا عتم",94,"م",1,0],["فقبله النار بددتني","وما تبقى هو الدخان",95,"ن",1,0],["فقبّلها وجهاً من البيض أبلجاً","وغازلها طرفاً من النَّقع أكحلا",96,"ل",2,0],["فَقَبَّلتُ مِن جِسمِهِ كاسِياً","عَلَيهِ الكِتابُ بِنَصِّ الخَبَر",97,"ر",1,0],["فَقبلَكَ ما أَعطى الهُنَيدَةَ جلَّةً","عَلى الشِعرِ كَعباً مِن سَديسٍ وَبازِلِ",98,"ل",1,0],["فقبلَ البينِ كنتُ أُخالُ جلداً","فلمّا حَلَّ لم أكُ بالجليدِ",99,"د",1,0],["فَقَبيحٌ إِن اِستَزَدت لَهُ صَو","بَ غمامٍ وَأَنتَ فيهِ غمامُ",100,"م",1,0],["فقبر العبادي الذي دون مربخٍ","فمربخ فالغدران فالهضبات",101,"ت",1,0],["فقبلت وجهاً كان لي منه قبلة","أصلي إليها من جميع جهاتي",102,"ي",1,0],["فقبلت عينيه وقبلت وجهه","وودعته توديع بتل بتات",103,"ت",1,0],["فقبيح ظلمِك فيه يعذُلني","ومليحُ ظُلمٍ منك يعذرني",104,"ي",1,0],["فَقَبيحٌ بك أن تَرْ","فُضَ من ليس رَفوضا",105,"ض",2,0],["فقبلوا ذلك من مقاله","ونقصوا الأذن عن كماله",106,"ه",1,0],["فقبل الأمر على ما أظهروا","وأشهد الله على ما أضمروا",106,"ر",3,0],["فقبلت أيمانهم إذ لم تجد","في ذاك من نصيحة عند أحد",106,"د",1,0],["فقبح الله الحسود الزاري","وطهّر الأرض من الأشرار",106,"ر",1,0],["فقبْلَ شَبابِي قد لبستُ شبيبةً","وقبلَ أَشُدِّي قد بلغت أَشُدَّه",107,"ه",1,0]]}