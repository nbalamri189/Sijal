x?id=208020",""],[4927,"سِفرُ الْغَرَاْم","https://www.poetsgate.com/ViewPoem.aspx?id=29829",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5105,"أحادِيَنَا هذا الربيعُ فخيِّم","https://www.poetsgate.com/ViewPoem.aspx?id=135327",""],[5121,"هَدِيَّتِي إِلَيْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=209063",""],[5136,"تفاحنا لو أسلناه","https://www.poetsgate.com/ViewPoem.aspx?id=121545",""],[5149,"خِتامُ المَرءِ في الدنيا رحيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=211096",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5212,"وَدَّعت دجلةَ","https://www.poetsgate.com/ViewPoem.aspx?id=212026",""],[5219,"الأم مدرسة إذا.......","https://www.poetsgate.com/ViewPoem.aspx?id=194906",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5411,"طَوّف بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185344",""],[5411,"مَقام الْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=196446",""],[5413,"إياك أعني واسمعي ياجاره","https://www.poetsgate.com/ViewPoem.aspx?id=200544",""],[5431,"التعريف الحقيقي للحثالة","https://www.poetsgate.com/ViewPoem.aspx?id=183036",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5582,"دَعاهُ هَوَى الأَحْبابِ حَتَّى أَجابَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186669",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5596,"الهجرة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=205615",""],[5781,"بين شوكه والألم....","https://www.poetsgate.com/ViewPoem.aspx?id=206644",""],[402,"ملامتكم عدل لو الحب يعدل","https://www.poetsgate.com/ViewPoem.aspx?id=36073",""],[5809,"روضة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205092",""],[5937,"نَارَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=211828",""],[5952,"حبَّات العِقد","https://www.poetsgate.com/ViewPoem.aspx?id=196747",""],[5975,"أزفَ اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=27094",""],[6005,"إصطفي خلف الأخريات","https://www.poetsgate.com/ViewPoem.aspx?id=161459",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[3512,"جرى الحبُّ منّي مجرى النَّفس","https://www.poetsgate.com/ViewPoem.aspx?id=12591",""],[6093,"وللدِّينِ مِحرابٌ وللحُبِّ مثلُهُ (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=176099",""],[6152,"أنت الحياة لقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=202890",""],[6152,"احفظي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203115",""],[6152,"بقاء للأبد","https://www.poetsgate.com/ViewPoem.aspx?id=203136",""],[6152,"أنتِ كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=203138",""],[5190,"ملل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85046&r=&rc=121",""]],"verses":[["فَقَبلَ الشَيبِ أَسلَفتُ الغَواني","قِلىً وَأَمالَني عَنها اِجتِنابُ",0,"ب",1,0],["فقبّلْتُ في لَيلِ الذّؤابَةِ وجْهَهُ","وعُذْتُ بذاكَ النّورِ منْ ليْلِ صَدِّهِ",1,"د",2,0],["فَقَبلَكَ ما أَوفى الرُفادُ لِجارِهِ","فَأَنجاهُ مِمّا كانَ يَخشى وَيَرهَبُ",2,"ب",1,0],["فَقَبِلتُ اليَدَ مِن بَطنِ يَدٍ","ظَهرُها الدَهرَ مَحَلٌّ لِلقُبَل",3,"ل",1,0],["فَقَبَّلتُهَا تِسعاً وتِسعِينَ قُبلَةً","ووَاحِدَةً أَيضاً وكُنتُ عَلَى عَجَل",4,"ل",1,0],["فقبل مضاء السيف تُمضي عزائمٌ","وبعد بناء الرأي تُبنى المعاقلُ",5,"ل",1,0],["فَقَبلَكَ ما أَعيا الرُماةَ إِذا رَمَوا","صَفاً لَيسَ في عادِيِّهِنَّ صُدوعُ",6,"ع",1,0],["فَقُبِّحَ عابِدٌ وَبَنو أَبيهِ","فَإِنَّ مَعادَهُم شَرُّ المَعادِ",7,"د",1,0],["فقبول النفوس إياك عندي","آيةٌ فيك للطيف الخبير",8,"ر",1,0],["فقبّلتُ الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمول فرض",9,"ض",1,0],["فقُبحاً يوم تُبعثُ يا ابن موسى","لوِجهِكَ مُرْدِفاً قُبحاً وشيكا",10,"ك",2,0],["فقبلتَ منه حَوالةً مكروهةً","ورأيتها حظاً إليك أَميلا",11,"ل",2,0],["فقَبْلكَ قام أقوامٌ قُعودٌ","لريب الدهر أو قعد القيامُ",12,"م",1,0],["فَقَبلَكَ رامَها الجَبّارُ فينا","فَكانَ لَنا وَلِلجَبّارِ دينُ",13,"ن",1,0],["فَقَبيحٌ أَن نَرتَدي الحُلَلَ القُش","بَ وَتَبقى الرُبى بِغَيرِ ثِيابِ",14,"ب",1,0],["فَقَبَّلتُ أَقداماً لِغَيرِيَ مامَشَت","وَوَجهاً مَصوناً عَن سِوايَ مُحَجَّبا",15,"ب",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح إِلى العِقد",16,"د",1,0],["فقبلته سلمى النحيفة","ثم ارتمى رأسها لضعف",17,"ف",1,0],["فقبل القبل كنت كذا سماءً","ولا شمسٌ هناك ولا ضياء",18,"ا",2,0],["فقبلتها وصرفت فكري تارة","نحو الثناء وتارة في صرفها",19,"ف",3,0],["فَقَبَّلتُ كَفّاً كانَ بِالسَيفِ ضارِباً","وَقَبَّلتُ سَيفاً كانَ بِالكَفِّ يَضرِبُ",20,"ب",1,0],["فَقَبَّلَت ناظِري تُغالِطُني","وَإِنَّما قَبَّلَت بِهِ فاها",21,"ا",3,0],["فقبلِيَ ما خلَّى عليّاً شقيقُهُ","وقرَّ بهِ بعدَ العراقِ شآمُ",22,"م",1,0],["فَقَبلَكِ بانَ الفَتحُ عَنّي مُوَدِّعاً","وَفارَقَني شَفعاً لَهُ المُتَوَكِّلُ",23,"ل",1,0],["فَقُبِّحَ شَرُّ حَيَّينا قَديماً","وَأَصغَرُهُ إِذا اِغتَرَفوا ذِنابا",24,"ب",2,0],["فَقَبلَكَ ما أَعيَيتُ كاسِرَ عَينِهِ","زِياداً فَلَم تَقدِر عَلَيَّ حَبائِلُه",25,"ل",2,0],["فقبلت الكتاب وقلت سمعا","لأمرك سيدي وأنا الجواب",26,"ب",1,0],["فقبولُ الجاهِ فخرٌ","وقبولُ المالِ عارُ",27,"ر",1,0],["فَقَبَّلتُ كَفّاً أَتحَفَتني بِعِلقِهِ","وَحَقٌّ لِكَأسِ الراحِ أَن يُكرَمُ الكَرَمُ",28,"م",1,0],["فَقَبَّلتُ مِنهُ الجود فِي بَطنِ راحَةٍ","تُنَاجِي المُنَى فِيهَا الثُّغُورُ اللَّواثِمُ",29,"م",1,0],["فَقَبلَكُم ما أَتى موسى بِآيَتِهِ","مِصراً فَلَم يُغنِ عَن فِرعَونَ هامانُ",30,"ن",1,0],["فَقَبرٌ بِأَجبالٍ وَقَبرٌ بِحاجِرٍ","وَقَبرُ القَليبِ أَسعَرَ الحَربَ ساعِرُه",31,"ر",2,0],["فَقُبِّلَت صَفحَةٌ وَسالِفَةٌ","مِن رَوضِ غَضِّ الشَبابِ مُؤتَنِفُه",32,"ف",2,0],["فَقَبلَ دُموعِ عَينِكَ خَبَّرَتنا","بِما جَمجَمتَ زَفرَتُكَ الصَعُودُ",33,"د",1,0],["فَقَبلَكَ ما شُتِمتُ وَقاذَعوني","فَما نَزُرَ الكَلامُ وَلا شَجاني",34,"ن",2,0],["فَقُبضتْ رِهانُهُمْ وأُمِّنوا","وأَنْفَضوا رُؤوسَهُم وأَذْعُنوا",35,"ن",3,0],["فَقبِلَ الإمامُ من أَيمانِهِ","وردَّه عفواً إلى مكانِهِ",35,"ه",1,0],["فقبل عود الرَسول عنها","لا أَبتَغي من هنا براحا",36,"ح",2,0],["فقبَّلها وظلَّلها هواهُ","وندَّى قلبَها والعيشُ جَدْبُ",37,"ب",1,0],["فَقَبَّلْتُهُ ظَمْأَى كَأَنَّ بِمُهْجَتِي","لَظَى النَّارِ وَالشَّيْبُ المُقَبَّلُ مَنْهَلُ",38,"ل",1,0],["فَقَبَّحتِ الخِطابَ وَلَستُ أَدري","لِأَيَّ جِنايَةٍ قُبحُ الخِطابِ",39,"ب",1,0],["فقبِّلُوا تُرْبَ حطِّينٍ فإنَّ بهِ","دَمَ البُطُولةِ مِنْ أيام حطينَا",40,"ن",2,0],["فقبَّل الكبش ناب الذئب معتذرًا","عما رماه به من سالف التُّهم",41,"م",1,0],["فقبلت في ليل الذؤابة وجهه","وعدت بذاك النور من ليل صده",42,"د",2,0],["فقبلَك طاوعتُ من أهلِها","صديقاً إلى مَصرَعي قادني",43,"ن",2,0],["فَقَبْلَكَ مَا أوْفَى الرُّفَادُ لجَارِهِ،","فأنْجاهُ مِمّا كان يَخشَى وَبَرْهَبُ",44,"ب",1,0],["فقبّلت شفة حمراء دامية","واهتزّ من نشوات اللثم نهدان",45,"ن",1,0],["فقبَّلتُه الرَّغيف وقلتُ خيراً","وشُكرُ المحسنِ المأمولِ فرض",46,"ض",1,0],["فَقَبَّلَهَا حَتَّى أَجَفَّ دِمَاءَهَا","وكَم سَاعَفَ الحَر المُذِيب شَقَاءَهَا",47,"ه",2,0],["فَقَبَّلتُ ما تَحتَ اللثامِ مِنَ اللَمى","وَعانَقتُ ما فَوقَ الوِشاح من العِقد",48,"د",1,0],["فقبلْن الصوارمَ والجفونا","وما أَنسى التي برزَت وقالت",49,"ا",3,0],["فَقَبلناه وَقَد جا","ءَ لَنا بِالمَدح مُعلَم",50,"م",1,0],["فقبلوا منك بالعهد الوثيق يدا","منها عليهم رداء الفضل ينسحب",51,"ب",1,0],["فَقُبِّحَ وَوجَهُهَا مِن مُستَشَارِ","وقًُبَّحَ وَجهُهُ مِن مُستَشِيرِ",52,"ر",1,0],["فَقَبَّلتُكِ أَلفِينِ","وَفَدَّيتُ وَحَيَّيتُ",53,"ت",1,0],["فقبّلت من أقدامه وبساطه","وقال لك البشرى بذا قضي الأمر",54,"ر",1,0],["فَقُبحُهَا أظهرُ من حسنها","وضُرُّهَا أكثر من نفعها",55,"ع",3,0],["فَقَبلي قَضى النُعمانُ في السِّجنِ نَحبَهُ","وَغُودِرَ مَسلوباً وَقَد كانَ سالِبا",56,"ب",2,0],["فَقُبحاً لَكُم ماذا تَعُدُّونَ في غَدٍ","إِذا اِفتَخَرَ الأَقوامُ يا أَخلَفَ النَسلِ",57,"ل",1,0],["فَقَبلي أَخُو شَنّ بنِ أَفصى أَضاعَهُ","بَنُو عَمِّهِ دَونَ الوَرى وَفَضائلُه",58,"ل",2,0],["فَقبّلتُ مثلَ الشمسِ لا بل كَمالُها","على الشمس والبدر المنير يزيد",59,"د",1,0],["فقبضت نفسي عنهمُ","إلا على ظهر الطريق",60,"ق",1,0],["فَقَبَ