د البَلا متبقرطٌ","فيهم وَذاكَ بجهله يَتسفسط",168,"ط",1,0],["هَذا عَلى إِثرِ الَّذي هُوَ قَبلَهُ","وَهيَ المَنايا وَالسَبيلُ المَهيَعُ",169,"ع",1,0],["هَذا عَناني يا عَناني بِهِ الإِر","سالُ إِذ حُبَّكِ لي خَيرُ شانِ",170,"ن",1,0],["هذا علي وهو عصمتنا","ما كان معبوداً له هبل",171,"ل",1,0],["هذا علي المرتضى","غيث الندى ليث الشرى",172,"ر",2,0],["هذا عُجابٌ كيف قد أهديتنا","من فاق إمكاناً بذا المقدارِ",173,"ر",1,1],["هذا على أن حول الشمس من شعر","ليل يقال له الأصداغ والطُّررُ",174,"ر",1,0],["هذا عتابُكَ قد أطلتَ حديثَهُ","وهوى فُؤادِكَ قد براهُ قَديمُهُ",175,"م",2,0],["هذا علاء قد علَت راياتهُ","وحمتهُ قدماً بالأنصار",176,"ر",1,0],["هَذا عَلى الصَدر يَسبي العَينَ مَنظَرُه","وَذاكَ في القَلبِ يُغرى لاعِجَ الحُرَق",177,"ق",1,0],["هذا عن السرج خر منجدلاً","ثاو وعهد الحياة منه نسي",178,"س",2,0],["هذا على الزهر يطوف مدمنا","وذا يج ما بفيه قد جنى",179,"ن",2,0],["هَذا عَذابٌ عَلى طَرفي وَذاك على","نفسِي وقَلبي واسقامٌ على بَدَني",180,"ن",2,0],["هذا على شرف الهلاك وذاك في","نزع وتلك على شفير هار",181,"ر",1,0],["هذا عراق الرافدين ملاحمٌ","كبرى وهذا عزمكَ الجبّارُ",182,"ر",1,0],["هذا عويل الريح فيض جنونها","وعلى الضفاف أنينها ينسابُ",183,"ب",1,0],["هذا عِتَابٌ؟ لا بَل أنِينٌ","فالجُرْحُ أرْقَى مِن أنْ يُعَاتِبْ",184,"ب",1,0],["هذا علي ابن أبى طالب","من ساد في الأكوان برهانه",185,"ن",2,0],["هذا عَدا التَّرَفِ المَقِيتِ وجَوْقَةٍ","مِن جُنْدِ إبليسٍ لها التَّبْجِيلُ",186,"ل",1,0],["هذا عراقي وهذي بعض ما عرَفتْ","منه الخلائقُ ما ساسة القِدم ُ",187,"م",1,0],["هذا علوُّك لولاهُ لما ارتفعتْ","كلُّ السماواتِ وازدادتْ مواليدا",188,"د",2,0],["هذا عطاء الله من تيْسيره","راح النصير لمبغضيك خذولا",189,"ل",2,0],["هَذا عِراقُكَ مَذْبُوحٌ بِخَيْبَتِهِ","وَجَيْشُ (كَافُورَ) في الأحرارِ قَدْ حَكَما",190,"م",2,0],["هذا عذارُكَ بالمسيبِ مُطَرَّزُ","فقَبُولُ عذرِكَ في التصابي مُعْوِزُ",191,"ز",1,1],["هٰذا عطاءُ إلٰهِي لَسْتُ أُنْكِرُهُ","حَمْداً لِمَنْ صَاغَنِي مِنْ أَشْرَفِ الْعَقِبِ",192,"ب",1,0],["هذا عقيدة سادة القوم الذي","في ذمهم أطلقت حاستي لسان معربد",193,"د",1,0],["هذا عدوُّ طريقهم فتكاتفو