{"poems":[[55,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[85,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[85,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[74,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[74,"أقسمت ما رزءك مما يهون","https://www.aldiwan.net/poem20193.html","السريع"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[53,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[53,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[93,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[91,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[87,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[87,"في زهرتَي ذا العود من أهل الهوى","https://www.aldiwan.net/poem7756.html","مجزوء الكامل"],[45,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[64,"من قاس بالعلم الثراء فإنه","https://www.aldiwan.net/poem52481.html","الكامل"],[30,"يا سائلي أين حلّ الجود والكرم","https://www.aldiwan.net/poem25438.html","البسيط"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[82,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[46,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[71,"إن قال صف لي عذاري وصف مبتكر","https://www.aldiwan.net/poem28252.html","البسيط"],[71,"وحاسد يظهر بين الورى","https://www.aldiwan.net/poem28909.html","السريع"],[71,"إن قال لي صف عذاري وصف مبتكر","https://www.aldiwan.net/poem28982.html","البسيط"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[107,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[104,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[77,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[108,"مأتم في عرس","https://www.poetsgate.com/ViewPoem.aspx?id=179495",""],[102,"أمام المفترق الاخير","https://www.poetsgate.com/ViewPoem.aspx?id=50359",""],[66,"لم يبق بيني وبين الحق تبياني","https://www.poetsgate.com/ViewPoem.aspx?id=3101",""],[113,"إن الوزير أدام الله دولته","https://www.aldiwan.net/poem16293.html","البسيط"],[132,"تريد أن تشرب من مائنا","https://www.aldiwan.net/poem50667.html","السريع"],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[164,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[164,"الفرق بين الكفر والإيمان","https://www.aldiwan.net/poem59187.html","الكامل"],[170,"ما بال هذا الفلك الجاني","https://www.aldiwan.net/poem46853.html","السريع"],[186,"هذا عزيز بني شمعون عاجله","https://www.aldiwan.net/poem61108.html","البسيط"],[186,"هذا عزيز بني الجلاد قد فتكت","https://www.aldiwan.net/poem61145.html","البسيط"],[186,"هذا مقام اليازجي فقف به","https://www.aldiwan.net/poem66996.html","الكامل"],[186,"هذا عزيز القطر مولانا الذي","https://www.aldiwan.net/poem67058.html","الكامل"],[189,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[189,"أيام ملكك أعياد وأعراس","https://www.aldiwan.net/poem14555.html","البسيط"],[189,"أسفى على زمن الشباب الزائل","https://www.aldiwan.net/poem14628.html","الكامل"],[189,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[189,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[189,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[190,"يا أيها الفلك الذي","https://www.aldiwan.net/poem43640.html","مجزوء الكامل"],[190,"ما الطير ينهض بالأخبار من بلد","https://www.aldiwan.net/poem43954.html","البسيط"],[208,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[233,"خوفته سلوتي فخافا","https://www.aldiwan.net/poem50936.html","مخلع البسيط"],[241,"هذا هلال المغرب","https://www.aldiwan.net/poem18051.html","الوافر"],[241,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[279,"كرت سوافح عبرتي أشجاني","https://www.aldiwan.net/poem25514.html","الكامل"],[279,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[289,"أهلا وسهلا بالإمام","https://www.aldiwan.net/poem39347.html","مجزوء الرجز"],[324,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[324,"يا آل غرياني اشكروا","https://www.aldiwan.net/poem67212.html","مجزوء الكامل"],[352,"قد أصلح الجوع بين القط والفار","https://www.aldiwan.net/poem20262.html","البسيط"],[357,"يا بدر آفاق المعالي ومن","https://www.aldiwan.net/poem40364.html","السريع"],[365,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[368,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[368,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[368,"إن قصرت بي عن الأغراض أيامي","https://www.aldiwan.net/poem60648.html","البسيط"],[368,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[370,"أما تقاطعنا فلا رسل","https://www.aldiwan.net/poem16943.html","أحذ الكامل"],[370,"هذا عذاب لا يفتر","https://www.aldiwan.net/poem16991.html","مجزوء الكامل"],[370,"هذا على كبرياء في مطامعها","https://www.aldiwan.net/poem17327.html","البسيط"],[375,"لو كان في أن يزور وزر","https://www.aldiwan.net/poem57440.html","مخلع البسيط"],[397,"هذا علي علي في محاسنه","https://www.aldiwan.net/poem53453.html","البسيط"],[420,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[420,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[433,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[436,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[443,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[461,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[461,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[480,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[503,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[503,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[506,"هذا علي في الدجى مصباح","https://www.aldiwan.net/poem21721.html","الرجز"],[518,"أخلفت ميعادك يا أفعل","https://www.aldiwan.net/poem12219.html","السريع"],[541,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[541,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[565,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[565,"يا أيها القبر فيك الناس قد رقدوا","https://www.aldiwan.net/poem52822.html","البسيط"],[565,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[570,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[579,"إن الهوان حمار القوم يعرفه","https://www.aldiwan.net/poem1772.html","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/31383","الكامل"]],"verses":[["هَذا عُبَيدُ اللَهِ حينَ رَمى","عَرضَ العُلى وَأَبى عَلى الدَهرِ",0,"ر",1,0],["هَذَا عَلِيٌّ لَمْ يُثَبِّطْهُ وَقَدْ","بَعُدَتْ مُنَاهُ مَا النَّجَاحُ يَسُومُ",1,"م",1,0],["هذا على أن التغربَ مركبي","وتولُّجَ الفيحِ الفساحِ شعاري",2,"ر",2,0],["هذا على أني نزعتُ عن الصِّبا","وصرمتُ من حبِّ الحسان حِبالي",3,"ل",2,0],["هذا على أنَّ لي عيناً مسهَّدة","للحبِّ مخلوقة الإنسان من عجل",4,"ل",1,0],["هذا على أن اللقا بيننا","مقترب الآماد فالأمر دون",5,"ن",1,0],["هذا على أنك ذو شيمةٍ","يُدرُّها الماسحُ لا العاصبُ",6,"ب",1,0],["هذا على أنَّ سُخْطي لا يُخَلِّفُني","عن مشْهَدٍ من مَآل الخير مشهودِ",7,"د",1,0],["هذا على أنه لا فَرْقَ بينكما","وَحُقَّ ذلك والعُودانِ من عُودِ",8,"د",1,0],["هذا عبيد الله منهم واحد","لكنه هو واحد المِضمارِ",9,"ر",1,0],["هذا على أن فيه فضلَ تكرمةٍ","للأفضلين ولِمْ لا تُمسَح الغرر",10,"ر",1,0],["هذا على أنّ ظني فيك يخبرني","أن قد أتيتَ من الإفضال مأتاكا",11,"ك",2,0],["هذا على أنني أرجو لكم مُهلاً","موصولةً مدة الدنيا إلى مُهَلِ",12,"ل",1,0],["هَذا عَصيرُ الوَحيِ في آلَةٍ","خَرساءَ يَجري فِتَناً لِلأَنام",13,"م",1,0],["هذا على نفسه تلقاه معتمدا","يسعى وهذا على الاقدار يتكل",14,"ل",1,0],["هذا عرابي تمنى أن تقابله","وأن ينال يداً جلت أياديها",15,"ي",3,0],["هذا على هذا حنا","ولذا إلى هذا التفات",16,"ت",1,0],["هَذا عِتابُكَ إِلّا أَنَّهُ مِقَةٌ","قَد ضُمِّنَ الدُرَّ إِلّا أَنَّهُ كَلِمُ",17,"م",1,0],["هذا على الإنفاقِ يغزُرُ فيضُهُ","أبداً وذلك حين يُنفَقُ ناضِبُ",18,"ب",1,0],["هَذَا علی رَسُولُ اللَهِ وَالِدُهُ","أَمْسَتْ بِنُورِ هُدَاهُ تَهْتَدِي‌ الاُمَمُ",19,"م",1,0],["هَذَا عَلِيٌّ يَقُولُ اللهُ دعهُ وَقَدْ","بَاتَ العَدُوُّ لَهُ فِي بَابِهِ رَصَدَا",20,"د",2,0],["هذا عليٌّ نجل يحيى الّذي","في قَصْدهِ نيلُ المنى والأمان",21,"ن",1,0],["هذا عليٌّ وهو بَدْرُ مهابةٍ","كَلِفٌ به بصرُ العُلى اللمَّاحُ",22,"ح",1,0],["هَذا عَلى كَتِفَيهِ كُلُّ نازِلَةٍ","تُخشى وَذاكَ عَلى أَكتافِهِ اللِبَدُ",23,"د",1,0],["هذا عذارُكَ نمَّامٌ ومسكنُهُ","نارٌ بخدَّيْكَ والتمامُ في النارِ",24,"ر",1,0],["هذا عطاءُ اللهِ يا حاسدي","مالكَ غضبانُ على ذي الجلالْ",25,"ل",1,0],["هذا عذارُكَ نمَّامٌ ومسكنُهُ","نارٌ بخديْكَ والنمامُ في النارِ",26,"ر",1,0],["هذا على مَتْنِ العُبابِ عَلامةٌ","لَهمُ وهذا في الجِواءِ مِثالُ",27,"ل",1,0],["هذا عطاء النّيلِ من يدِ مِلْنر","شيخِ النَّدى وعميدِه المِفضالِ",28,"ل",1,0],["هَذا عَطَاؤُكِ لو يكونُ مَكانَهُ","أغلى الكُنوزِ خَشيْتُ أن لا تُحْمَدِي",29,"د",2,0],["هذا عليٌّ في اللّواءِ ومُصعبٌ","والنّصرُ في عِطْفَيْهما يَترنَّحُ",30,"ح",1,0],["هَذا عَدوّك لا يَرع","ك وَهَذِهِ أَخلاقُهُ",31,"ه",1,0],["هذا على أنّكُم لم تُنصِفوه ولا","أورثتموه حميدَ الذكر إن ذُكِرا",32,"ر",2,0],["هذا على حينَ طغَى النِّفاقُ","واستفحلَ النُّكّاثُ والمُرَّاقُ",33,"ق",1,0],["هذا عروسٌ، طواه الموت في كفنٍ","وما طوتْ عرسُهُ أثوابها الجددا!",34,"د",2,0],["هذا عنيف ، وله غايه","وذا بلا قصد ، وما أعنفه",35,"ف",2,0],["هذا عبارة أهل الانفراد به","ذوي المعارف في سرّ وإعلان",36,"ن",1,0],["هَذا عَواقب مَن يَطغى وَحرفَتَهُ","في قَومِهِ وَبَنيهِ المُكر وَالحيل",37,"ل",1,0],["هذا عجيبٌ ما نرى مثله","وقولتى من ذالكم أعْجَبُ",38,"ب",1,0],["هذا عن الشأو معزول وذاك له","مُضمَّرٌ مُحرزٌ غاياتِه عتد",39,"د",1,0],["هذا على رأيكم فأسوا ونحن نرى","خروجكم للقضا الجاري بقتلكم",40,"م",1,0],["هذا عدو الله بين ظهوركم","يقرا الفصوص قراءة القرآن",41,"ن",1,0],["هذا عميدُ الملكِ وهو الذي","لم يَخلُ منهُ صدرُ ديوانِ",42,"ن",1,0],["هَذا عَزيزُ بَني شَمعونَ عاجَلَهُ","داعِي المَنايا فَأدمَى بَعدَهُ المُقَلا",43,"ل",2,1],["هَذا عَزيزُ بَني الجَلادِ قَد فَتَكَت","بِهِ المَنايا بِيَومٍ غَيرِ مَحسوبِ",44,"ب",1,1],["هَذا عِمادُ العلمِ مالَ بِهِ القَضا","فَأَمالَ رُكناً لِلعُلومِ مُشَيَّدا",45,"د",2,0],["هَذا عَزيزُ القَطرِ مَولانا الَّذي","وَرِثَ الإِمارةَ أَكبَراً عَن أَكبَرِ",46,"ر",1,1],["هذا على أنّ شعري غيرُ مبتَذَلٍ","فيمن سواك ولو أَضْحى يُرغِّبه",47,"ب",2,0],["هذا على أن كُتْب الفضلِ قاطبةً","في بعضِ سِيرتِك العَلْياء كُرّاس",48,"س",1,0],["هذا على أنّ العَفافَ وهِمَّتي","لم يُظْفِرا حظِّى لديه بطائل",49,"ل",1,0],["هذا على أن سَجْلا من صَوارِمه","يُعيدها من طُلا الأعداءِ بحرَ دمِ",50,"م",1,0],["هذا على أنها شكر يفضَّله","فعلا فقول نعم من فضله نِعَم",51,"م",1,0],["هذا على أنه يُخفِي صَنائعَه","فينا ويأبَى لما أَخْفاه إعلانا",52,"ن",2,0],["هذا عدوّك تزدري","ه وذا أخوك من الرضاعه",53,"ع",2,0],["هذا عجيب تحنّ الطير وهي شدا","ولا أحنّ بتحصيلي إلى أحد",54,"د",1,0],["هذا على أنَّه المرضيُّ مذهبُه","في السرِّ والجهر تعديلاً وتقويما",55,"م",2,0],["هذا على أنني قدِيماً","ما زِلت أستصحِب العفافا",56,"ف",2,0],["هذا عَريقُ الْحَسَبِ","هذا شَريفُ النَّسَبِ",57,"ب",1,0],["هَذَا عَلَى أَنِّي لَجَأْتُ إِلَى حِمَى","مَنْ قَدْ حَمَى مَنْ كَانَ عُرْضَ نِصَالِهَا",58,"ل",3,0],["هَذا عِنانِي في يدَيْكِ وإنَّما","فازَتْ يَدَايَ بأَنْ مَلَكْتِ عنَانِي",59,"ن",2,0],["هذا على أَغْبَرِ البَيْداء يسْجرُه","وَذاك في أخضَر الدّأماء يملؤُهُ",60,"ا",2,0],["هذا على دوح الربى","صنو الهزار الساحر",61,"ر",1,0],["هَذا عَلَيهِ فَضلُ مَولانا الأَجَلُ","وَلي رَجا في مَنحِهِ طولَ الأَجَلِ",62,"ل",1,0],["هَذا عُبَيدُ اللَهِ ذو ال","فَضلِ الجَزيلِ المُحسِنُ",63,"ن",1,0],["هذا على مَطبخي المَبرودِ في حُرَقٍ","وَذا على مَخْزَني المَكْنُوسِ في نَارِ",64,"ر",1,0],["هَذا عَطاء اللَه سُبحانه","نِلناه بِالصَبر عَلى ما تُريد",65,"د",1,0],["هذا عَلى بن تاج","هذا المعلى المُعظَم",66,"م",1,0],["هذا على أنّ أَمراً غيْرَ مُحتَسَبٍ","كأنّنا بكَ في ذا الدَّهْرِ تُبديه",67,"ي",2,0],["هذا على أنّه ما إن لديَّ سوى","شكرٍ بسابقِ ما أولَيْتَ مُرْتَهَن",68,"ن",1,0],["هذا على أنَّني أُهدي لحَضْرته","على المَغيبِ ثَناءً نَشْرُه نام",69,"م",1,0],["هذا على أنّه لو رامَ في سنةٍ","حسابَ ما جادَ في يومٍ لمّا ضَبَطا",70,"ط",2,0],["هَذا عِقابُهُمُ لِعَبدِهِمُ","راضينَ عَنهُ فَكَيفَ لَو غَضِبوا",71,"ب",3,0],["هَذا عَذابٌ لا يُفَتَّرْ","بِأَقَلِّهِ قَلبي تَفَطَّرْ",72,"ر",1,1],["هَذا عَلى كِبرِياءٍ في مَطامِعِها","نَفسٌ عَلى فَقرِها تَستَرخِصُ الغالي",73,"ل",2,1],["هذا على أنه زَماني","والحَيدريُّونَ فيه كُثرُ",74,"ر",1,0],["هذا عَلِيٌّ عَلِيٌّ في مَحاسِنِهِ","كَأَنَّما حَسبُهُ أَن يَبلُغَ الأَملا",75,"ل",2,1],["هذا عليُّ القَدْرِ وابنُ علائِه","المنتمي شَرفاً إلى عَدنان",76,"ن",1,0],["هذا عليٍّ قد أتى متوسِّلاً","يرجو الثواب إذا الخلايق تحشر",77,"ر",1,0],["هذا عليّ الرضى والأسعدي بما","وافى يشير به هل من يضاهينا",78,"ن",2,0],["هذا على أنك في","أولِ كلِّ سؤدَدِ",79,"د",1,0],["هَذَا عَلَى خَفْقِ الشِّرَاعِ وقَلْسِهِ","حُرُمٌ وذاكَ عَلَى البعيرِ وخُفِّهِ",80,"ف",2,0],["هذا عميد الكفاة نارُ قِرى ال","ليل وكشّافُ أوجهِ السُّبُلِ",81,"ل",1,0],["هذا على اقتناعها","منكم بما بلَّ الرَمقْ",82,"ق",1,0],["هذا على الوجدِ قلبٌ لا يقلِّبُه","طولُ الفراقِ ولا بالعذلِ يرتدعُ",83,"ع",1,0],["هذا عَطاءٌ سابِقٌ","مُحَتَّمٌ في الأَزَلِ",84,"ل",1,0],["هذا عَذيبُ ثغرِهِمْ","قُلَيْبَهُ قد عذَّبَا",85,"ب",2,0],["هذا عَلِيٌّ في الدُّجى مِصبَاحُ","نَحنُ بِذا في فضلِهِ فِصَاحُ",86,"ح",1,1],["هذا عتاب لزمت ميمه","مع لامه فاسمع لما أعمل",87,"ل",1,0],["هذا عدُوُّ الدينِ والإسلامِ قد","كشَرت علَى أنيابِه الأشداق",88,"ق",1,0],["هذا عَزائي والعزاءُ لِكلِّ مَن","كوبٍ رِضَاهُ بما عليه مُقَدَّرا",89,"ر",2,0],["هذا عَمودٌ كان رُكنَ عشيرةٍ","صارت كبُرجٍ مالَ خَطُّ عَمودهِ",90,"د",2,0],["هذا عَمُودٌ هَوَى من أوجِ رِفعِتِهِ","على البَسيطةِ فاهتزَّتْ لهُ العُمُدُ",91,"د",1,0],["هذا على حُكم الجُنونِ وإنَّما","قد أصبحَ المجنونُ غيرَ مُقيَّد",92,"د",1,0],["هَذَا عَلَى أَنَّنِي مَا أَسْتَفِيْقُ وَلاَ","أُفِيْقُ مِنْ رِحْلَةٍ فِي إِثْرِهَا رِحْلَهْ",93,"ل",2,0],["هذا على القول الذي رويتم","لم أعد فيه نص ما حكيتم",94,"م",1,0],["هذا عَليٌّ كعليٍّ في الوغى","هذا الأَميرُ كأَميرِ النحل",95,"ل",1,0],["هَذا عَلى الخَسفِ مَربوطٌ بِرُمَّتهِ","وَذا يُشَجُّ فما يَرثي لَهُ أَحَدُ",96,"د",1,0],["هَذا عَلى إِثرِ الَّذي هُوَ قَبلَهُ","وَهيَ المَنايا وَالسَبيلُ المَهيَعُ",97,"ع",1,0]]}