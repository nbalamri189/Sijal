ُله جشائب","https://www.poetsgate.com/ViewPoem.aspx?id=191418",""],[4767,"بلاغ","https://www.poetsgate.com/ViewPoem.aspx?id=179843",""],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4882,"إن البلاغة في النهرين تزدحم","https://www.poetsgate.com/ViewPoem.aspx?id=34801",""],[4961,"يا واهبَ الجودِ","https://www.poetsgate.com/ViewPoem.aspx?id=33335",""],[4984,"طموح","https://www.poetsgate.com/ViewPoem.aspx?id=191455",""],[5031,"صرخة صامتة الى ابي الطيب المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=148227",""],[1372,"هذا عذارُكَ بالمسيبِ مُطَرَّزُ","https://www.poetsgate.com/ViewPoem.aspx?id=15828",""],[5135,"قالوْا \"شَرِيْفٌ\"","https://www.poetsgate.com/ViewPoem.aspx?id=201815",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5273,"سِفْرُ الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=180938",""],[5280,"داء الحب","https://www.poetsgate.com/ViewPoem.aspx?id=189825",""],[5324,"يازائرا قبر الحسين.","https://www.poetsgate.com/ViewPoem.aspx?id=210987",""],[5362,"قالوا التمدن قلت ذاك سراب","https://www.poetsgate.com/ViewPoem.aspx?id=170372",""],[5461,"يا سائليني","https://www.poetsgate.com/ViewPoem.aspx?id=5036",""],[5461,"كلٍ يعوّد لاصل جدّه ومرباه","https://www.poetsgate.com/ViewPoem.aspx?id=5307",""],[5528,"هلْ مِنْ سُلُو ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201114",""],[5533,"حَلَب تَبْكي","https://www.poetsgate.com/ViewPoem.aspx?id=181530",""],[5574,"خالي عيسى \"رحمه الله\"","https://www.poetsgate.com/ViewPoem.aspx?id=206004",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[243,"عبير","https://www.poetsgate.com/ViewPoem.aspx?id=18447",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[1155,"ذكرتُ شوقاً وعندي ما يصدقه","https://www.poetsgate.com/ViewPoem.aspx?id=190916",""],[5790,"هزوا القدود وأرهفوا سمر القنا","https://www.poetsgate.com/ViewPoem.aspx?id=111945",""],[5804,"لا أقنع بالدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=184441",""],[5804,"مساجلة مع جار الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=190655",""],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"هذا عطائي يا حبيبة ضامرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183876",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[6019,"بمناسبة مولد ابن اختي ( علي )","https://www.poetsgate.com/ViewPoem.aspx?id=200578",""],[6069,"يا صاح هل لك في احتمال تحيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105719",""],[6127,"يوم الجائزة","https://www.poetsgate.com/ViewPoem.aspx?id=206104",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["هَذا عُبَيدُ اللَهِ حينَ رَمى","عَرضَ العُلى وَأَبى عَلى الدَهرِ",0,"ر",1,0],["هَذَا عَلِيٌّ لَمْ يُثَبِّطْهُ وَقَدْ","بَعُدَتْ مُنَاهُ مَا النَّجَاحُ يَسُومُ",1,"م",1,0],["هذا على أن التغربَ مركبي","وتولُّجَ الفيحِ الفساحِ شعاري",2,"ر",2,0],["هذا على أني نزعتُ عن الصِّبا","وصرمتُ من حبِّ الحسان حِبالي",3,"ل",2,0],["هذا على أنَّ لي عيناً مسهَّدة","للحبِّ مخلوقة الإنسان من عجل",4,"ل",1,0],["هذا على أن اللقا بيننا","مقترب الآماد فالأمر دون",5,"ن",1,0],["هذا على أنك ذو شيمةٍ","يُدرُّها الماسحُ لا العاصبُ",6,"ب",1,0],["هذا على أنَّ سُخْطي لا يُخَلِّفُني","عن مشْهَدٍ من مَآل الخير مشهودِ",7,"د",1,0],["هذا على أنه لا فَرْقَ بينكما","وَحُقَّ ذلك والعُودانِ من عُودِ",8,"د",1,0],["هذا عبيد الله منهم واحد","لكنه هو واحد المِضمارِ",9,"ر",1,0],["هذا على أن فيه فضلَ تكرمةٍ","للأفضلين ولِمْ لا تُمسَح الغرر",10,"ر",1,0],["هذا على أنّ ظني فيك يخبرني","أن قد أتيتَ من الإفضال مأتاكا",11,"ك",2,0],["هذا على أنني أرجو لكم مُهلاً","موصولةً مدة الدنيا إلى مُهَلِ",12,"ل",1,0],["هَذا عَصيرُ الوَحيِ في آلَةٍ","خَرساءَ يَجري فِتَناً لِلأَنام",13,"م",1,0],["هذا على نفسه تلقاه معتمدا","يسعى وهذا على الاقدار يتكل",14,"ل",1,0],["هذا عرابي تمنى أن تقابله","وأن ينال يداً جلت أياديها",15,"ي",3,0],["هذا على هذا حنا","ولذا إلى هذا التفات",16,"ت",1,0],["هَذا عِتابُكَ إِلّا أَنَّهُ مِقَةٌ","قَد ضُمِّنَ الدُرَّ إِلّا أَنَّهُ كَلِمُ",17,"م",1,0],["هذا على الإنفاقِ يغزُرُ فيضُهُ","أبداً وذلك حين يُنفَقُ ناضِبُ",18,"ب",1,0],["هَذَا علی رَسُولُ اللَهِ وَالِدُهُ","أَمْسَتْ بِنُورِ هُدَاهُ تَهْتَدِي‌ الاُمَمُ",19,"م",1,0],["هَذَا عَلِيٌّ يَقُولُ اللهُ دعهُ وَقَدْ","بَاتَ العَدُوُّ لَهُ فِي بَابِهِ رَصَدَا",20,"د",2,0],["هذا عليٌّ نجل يحيى الّذي","في قَصْدهِ نيلُ المنى والأمان",21,"ن",1,0],["هذا عليٌّ وهو بَدْرُ مهابةٍ","كَلِفٌ به بصرُ العُلى اللمَّاحُ",22,"ح",1,0],["هَذا عَلى كَتِفَيهِ كُلُّ نازِلَةٍ","تُخشى وَذاكَ عَلى أَكتافِهِ اللِبَدُ",23,"د",1,0],["هذا عذارُكَ نمَّامٌ ومسكنُهُ","نارٌ بخدَّيْكَ والتمامُ في النارِ",24,"ر",1,0],["هذا عطاءُ اللهِ يا حاسدي","مالكَ غضبانُ على ذي الجلالْ",25,"ل",1,0],["هذا عذارُكَ نمَّامٌ ومسكنُهُ","نارٌ بخديْكَ والنمامُ في النارِ",26,"ر",1,0],["هذا على مَتْنِ العُبابِ عَلامةٌ","لَهمُ وهذا في الجِواءِ مِثالُ",27,"ل",1,0],["هذا عطاء النّيلِ من يدِ مِلْنر","شيخِ النَّدى وعميدِه المِفضالِ",28,"ل",1,0],["هَذا عَطَاؤُكِ لو يكونُ مَكانَهُ","أغلى الكُنوزِ خَشيْتُ أن لا تُحْمَدِي",29,"د",2,0],["هذا عليٌّ في اللّواءِ ومُصعبٌ","والنّصرُ في عِطْفَيْهما يَترنَّحُ",30,"ح",1,0],["هَذا عَدوّك لا يَرع","ك وَهَذِهِ أَخلاقُهُ",31,"ه",1,0],["هذا على أنّكُم لم تُنصِفوه ولا","أورثتموه حميدَ الذكر إن ذُكِرا",32,"ر",2,0],["هذا على حينَ طغَى النِّفاقُ","واستفحلَ النُّكّاثُ والمُرَّاقُ",33,"ق",1,0],["هذا عروسٌ، طواه الموت في كفنٍ","وما طوتْ عرسُهُ أثوابها الجددا!",34,"د",2,0],["هذا عنيف ، وله غايه","وذا بلا قصد ، وما أعنفه",35,"ف",2,0],["هذا عبارة أهل الانفراد به","ذوي المعارف في سرّ وإعلان",36,"ن",1,0],["هَذا عَواقب مَن يَطغى وَحرفَتَهُ","في قَومِهِ وَبَنيهِ المُكر وَالحيل",37,"ل",1,0],["هذا عجيبٌ ما نرى مثله","وقولتى من ذالكم أعْجَبُ",38,"ب",1,0],["هذا عن الشأو معزول وذاك له","مُضمَّرٌ مُحرزٌ غاياتِه عتد",39,"د",1,0],["هذا على رأيكم فأسوا ونحن نرى","خروجكم للقضا الجاري بقتلكم",40,"م",1,0],["هذا عدو الله بين ظهوركم","يقرا الفصوص قراءة القرآن",41,"ن",1,0],["هذا عميدُ الملكِ وهو الذي","لم يَخلُ منهُ صدرُ ديوانِ",42,"ن",1,0],["هَذا عَزيزُ بَني شَمعونَ عاجَلَهُ","داعِي المَنايا فَأدمَى بَعدَهُ المُقَلا",43,"ل",2,1],["هَذا عَزيزُ بَني الجَلادِ قَد فَتَكَت","بِهِ المَنايا بِيَومٍ غَيرِ مَحسوبِ",44,"ب",1,1],["هَذا عِمادُ العلمِ مالَ بِهِ القَضا","فَأَمالَ رُكناً لِلعُلومِ مُشَيَّدا",45,"د",2,0],["هَذا عَزيزُ القَطرِ مَولانا الَّذي","وَرِثَ الإِمارةَ أَكبَراً عَن أَكبَرِ",46,"ر",1,1],["هذا على أنّ شعري غيرُ مبتَذَلٍ","فيمن سواك ولو أَضْحى يُرغِّبه",47,"ب",2,0],["هذا على أن كُتْب الفضلِ قاطبةً","في بعضِ سِيرتِك العَلْياء كُرّاس",48,"س",1,0],["هذا على أنّ العَفافَ وهِمَّتي","لم يُظْفِرا حظِّى لديه بطائل",49,"ل",1,0],["هذا على أن سَجْلا من صَوارِمه","يُعيدها من طُلا الأعداءِ بحرَ دمِ",50,"م",1,0],["هذا على أنها شكر يفضَّله","فعلا فقول نعم من فضله نِعَم",51,"م",1,0],["هذا على أنه يُخفِي صَنائعَه","فينا ويأبَى لما أَخْفاه إعلانا",52,"ن",2,0],["هذا عدوّك تزدري","ه وذا أخوك من الرضاعه",53,"ع",2,0],["هذا عجيب تحنّ الطير وهي شدا","ولا أحنّ بتحصيلي إلى أحد",54,"د",1,0],["هذا على أنَّه المرضيُّ مذهبُه","في السرِّ والجهر تعديلاً وتقويما",55,"م",2,0],["هذا على أنني قدِيماً","ما زِلت أستصحِب العفافا",56,"ف",2,0],["هذا عَريقُ الْحَسَبِ","هذا شَريفُ النَّسَبِ",57,"ب",1,0],["هَذَا عَلَى أَنِّي لَجَأْتُ إِلَى حِمَى","مَنْ قَدْ حَمَى مَنْ كَانَ عُرْضَ نِصَالِهَا",58,"ل",3,0],["هَذا عِنانِي في يدَيْكِ وإنَّما","فازَتْ يَدَايَ بأَنْ مَلَكْتِ عنَانِي",59,"ن",2,0],["هذا على أَغْبَرِ البَيْداء يسْجرُه","وَذاك في أخضَر الدّأماء يملؤُهُ",60,"ا",2,0],["هذا على دوح الربى","صنو الهزار الساحر",61,"ر",1,0],["هَذا عَلَيهِ فَضلُ مَولانا الأَجَلُ","وَلي رَجا في مَنحِهِ طولَ الأَجَلِ",62,"ل",1,0],["هَذا عُبَيدُ اللَهِ ذو ال","فَضلِ الج