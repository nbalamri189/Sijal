"يا صفحة بيضاءَ اِفتح صفحة","https://www.poetsgate.com/ViewPoem.aspx?id=192132",""],[5956,"أ عَلِمتَ كم أفراحنا تنتابُنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193350",""],[5956,"أدواء بسرعة الأضواء","https://www.poetsgate.com/ViewPoem.aspx?id=202751",""],[5956,"هل يستطيب الفتى إيهابُ فُرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210301",""],[5970,"دعت فؤادي بليل الأمس غانية","https://www.poetsgate.com/ViewPoem.aspx?id=130649",""],[5970,"منفي الأنام حياتهم","https://www.poetsgate.com/ViewPoem.aspx?id=130628",""],[5970,"كم صديق أنا أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=130608",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6142,"بالأمس كانوا معي واليوم قد رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=155753",""],[6152,"الحب ليس للحبيب الأول","https://www.poetsgate.com/ViewPoem.aspx?id=203392",""],[313,"أمل يخيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66500&r=&rc=22",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""],[572,"بلليتُ بأحسنِ الثّقْلينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9398&r=&rc=255",""]],"verses":[["بَل لا اِلتَذَذتُ مِنَ الزَمانِ بِشَربَةٍ","إِن لَم أُعِضكَ مِنَ الزُلالِ ذُعافا",0,"ف",2,0],["بَل لَو قَذَفتُ بِمَدحَتي لَكُمُ","في البَحرِ ذي الأَمواجِ وَالزَبَدِ",1,"د",1,0],["بَل لَو صَدَمتُ بِهِمَّتي جَبَلي حَرى","قَسَماً وَحَقِّ أَبي قُبَيسَ تَزَلزَلا",2,"ل",2,0],["بَل لَيتَ شِعري هَل أَعودَنَّ ناشِئاً","مِثلي زُمَينَ أَحُلُّ بُرقَةَ أَنقَدا",3,"د",2,0],["بَل لَيتَ شِعري وَأَينَ لَيتٌ","وَهَل يَفيئنَّ مُستَعارُ",4,"ر",1,0],["بَل لِلحَيَاةِ كَرِيمَةً قَدْ حُقِّقَتْ","فِيهَا رَغَائِبُ لِلعُلَى وَأمَانِي",5,"ن",2,0],["بَلْ لِلْحَيَاةِ كَرِيمَةٍ قَدْ حُقِّقَتْ","فِيهَا رَغَائِبُ لِلْحِمَى وَأَمَانِي",6,"ن",2,0],["بَل لَيتَ شِعري وَلَيتَ الطَيرَ تُخبِرُني","ما كانَ شَأنُ عَلِيٍّ وَاِبنِ عَفّانا",7,"ن",2,0],["بل ليتَ شِعري عنك في أمسنا","والظنُّ عن غيبِ الفتى ثاقبُ",8,"ب",1,0],["بل لقومٍ وسائلٌ يستحقّو","نَ إذا ما دَعوا بها أن يجابوا",9,"ب",3,0],["بل لو يَهُزّان هزةً نثرت","من رأس هذا وهذه رُطبا",10,"ب",2,0],["بل لا أريغُ النوال من لَحِزٍ","سيان مُمتاحُه ومُغْتَصَبُهْ",11,"ب",2,0],["بل لك الحقُّ ليس لي غيرَ أن ال","حُرَّ سَمْحٌ مُخَادَعٌ مكذوبُ",12,"ب",1,0],["بل ليَ اليُمْنُ لا محالة كالصُّبْ","حِ إذا لاح ضوؤه المشبوبُ",12,"ب",1,0],["بلْ لَديَّ الإنْصَافُ يَشْفَعُهُ الإحْ","سانُ ما قَارَبَ الألدُّ الشَّغُوبُ",12,"ب",1,0],["بَلْ لا أغُرُّكَ منْ خِيمي ولا شيَمي","إنِّي لَجَلْدٌ صبُورٌ غير مهدودِ",13,"د",1,0],["بلْ لوْ تَوَحَّدْتَ دون النَّاسِ كُلّهمُ","كنتَ الجميع وكانوا كالمواحِيدِ",14,"د",1,0],["بل ليس في الأفقين منك سحابةٌ","للوعْدِ مِبراقٌ ولا مرْعادُ",15,"د",1,0],["بل ليت شعري وقد حَييت وقد","قَدَّمتِ للنفس وجه معتذِرِ",16,"ر",1,0],["بل لو يكون له ضِعفا جوارحِهِ","من الفِقاح لما قضّى بها وطرا",17,"ر",2,0],["بل للغيوب في الصدور جائسه","كأنما السبعة غير الطامسه",18,"س",2,0],["بل لما فيه من وِفاقكَ فيما","يصحبُ الدين من تُقىً وخُشوع",19,"ع",1,0],["بل لك المن الذي أص","بح للأعناق ربقا",20,"ق",2,0],["بل لتطريقنا له وهو المه","روبُ منه ولم يكن ذاك موقا",21,"ق",2,0],["بل لحيةُ الرجلِ الذي","أضحى بها جَمَّ البلابلْ",22,"ل",1,0],["بل ليتَ كنتَ من الطوا","بِل أنت من سَقْط الزَّواملْ",22,"ل",1,0],["بل لإقدامه مع الرُّعب لكن","ساقهُ الحينُ راكبَ استبسالِ",23,"ل",1,0],["بل لا تغزُّلَ عند من لِبَنانه","رُفضَ التغزُّلُ بل هناك تبعُّلُ",24,"ل",1,0],["بل للبرية طرّاً","مأمِومها والإمامِ",25,"م",1,0],["بل لو يكون مكان السيف من رَجُلٍ","كمِخْلَبِ اللَّيْثِ منهُ حان من حانا",26,"ن",2,0],["بل لأن السماع والشعر قِدماً","بالندى آمران مؤتمران",27,"ن",1,0],["بل لا إخال شجاك تَعْدَمُه","روحٌ ألمَّ بها ولا بَدنُ",28,"ن",1,0],["بَل لِما فيكَ مِن صِفا","ت وَمِن طيبِ مُحتَدِ",29,"د",1,0],["بَل لَيتَ كُلَّ نَسيجٍ","بَراقِع وَسُتورُ",30,"ر",1,0],["بَل لاحَت نَفسِيَ في نَفسي","فَهيَ المَرإِيَّةُ وَالرائي",31,"ي",1,0],["بَل لَيتَهُم جادوا عَلى ذي فاقَةٍ","فَحَرىً بِعَطفِ المُحسِنينَ المُرمِلُ",32,"ل",1,0],["بَل لَيتَني لَم أُسائِل عَنكَ جارَتَنا","بَل لَيتَ قَلبي إِذ ساءَلتَ صَوّانُ",33,"ن",1,0],["بَل لا يَحُلُّ بِحَيثُ حَلَّ بِهِ","بُخلٌ وَلا جَورٌ وَلا وَجَلُ",34,"ل",1,0],["بَلَلتُ بِها رُدنَيَّ وَالغَيمُ مُسعِدي","وَعَبرَتُهُ صِرفٌ وَفي عَبرَتي دَمُ",35,"م",1,0],["بَل لَيتَ شِعري هَل تَراني قائِلاً","هَل لِلَّيالي الصالِحاتِ رُجوعُ",36,"ع",1,0],["بَل لَن يَضيرَكَ بَينُ مَن لَم تَهوَهُ","بَل بَينُ مَن صَدَعَ الفُؤادَ يَضيرُ",37,"ر",1,0],["بل لو أطاعَ اللَّومَ فيكِ مُتَيَّمٌ","ما كانَ فيكِ على الهَوى مُتَلَوِّما",38,"م",2,0],["بل لو تعلَّقَ بالجَوزاءِ هاربُه","ما فاتَ خَطْفَ أبي عثمانَ هاربُه",39,"ب",2,0],["بل لو تأمَّلَها ابنُ أوسٍ لم يَقُلْ","لو أنَّ دهراً رَدَّ رَجْعَ جوابي",40,"ب",2,0],["بَل لا نَسيتَ وَلا أَلومُكَ خُلَّتي","وَلَئِن فَعَلتَ لَحادِثٌ أَنساكا",41,"ك",2,0],["بَل لا تُؤَدّي شُكرَها أَبَداً","حَتّى تُصَيِّرَها لَكُم رَبّا",42,"ب",2,0],["بَل لَيتَ شِعري وَالفَتى","لِحينِهِ مُجتَلَبُ",43,"ب",1,0],["بَل لِكُلٍّ مِن رِزقِهِ ما قَضى اللَ","هُ وَإِن حَزَّ أَنفَهُ المُستَميتُ",44,"ت",1,0],["بَلَّلَ الرَكضُ جانِبَيهِ كَما فا","ضَت بِكَفِّ النَديمِ كَأسُ العُقارِ",45,"ر",1,0],["بل لو تُجادلُها بهِ ألبابُها","في اللّه قامَ لحُسنِهِ بُرهانُها",46,"ن",3,0],["بل لو سرَيْتَ إلى الخليجِ بعَزْمَةٍ","سَرتِ الكواكبُ فيه وهي سَفين",47,"ن",1,0],["بَل لَيتَ شِعرِيَ هَل يَدنو بِكُم سَبَبٌ","وَهَل تُعَودَنَّ أَيّامي بِأَجيادِ",48,"د",1,0],["بَل لَم يَكُن لِجُموعِ المُشرِكينَ بِهِ","وَلا يُشَيِّعُهُ جَولٌ وَلا بَدَدُ",49,"د",1,0],["بَل لا مَحالَةَ مِن لِقاءِ فَوارِسٍ","كَرَمٍ مَتى يُدعَوا لِرَوعٍ يَركَبوا",50,"ب",3,0],["بل ليس يَدري غير زائر جزرهم","ما قَد أَصابَ القوم من خسران",51,"ن",1,0],["بل لا أصدق منه شي","ئاً قبلما أَتبصر",52,"ر",1,0],["بل لقد رقَّ منها القلب حين رأَت","عيني تجود بقاني دمعها السرب",53,"ب",1,0],["بَل لَأمَتي أَلقى بِها حَدَّ الوَغى","بَل كَوكَبي أَسري بِهِ وَهِلالي",54,"ل",2,0],["بل لدَاعٍ أعزلٍ في قومهِ","مستباحِ الدَّمِ مهدورِ الذِّمامِ",55,"م",1,0],["بَلْ لَعَلِّي شَطَطْتُ فِي الحُكْمِ","وَالأَحكَامُ لاَ تَستَقِيمُ فِي الإِطْلاَقِ",56,"ق",1,0],["بَلَلتُ رِدائي بِالدُموعِ وَإِنَّما","يُزادُ بِها الباكي عَلى كَربِهِ كَربا",57,"ب",2,0],["بَل لا أُكاثِرُ صاحِبي في يُسرِهِ","وَأَصُدُّ إِذ في عَيشِهِ تَصريدُ",58,"د",1,0],["بل لست مختارا ولست مكرها.","والعشق إن سر القلوب ضرها",59,"ه",2,0],["بل ليس لي كفّ لسيف ، أما","سنان (عمرو) ذاك أمضى الشّفار",60,"ر",1,0],["بل ليت شعري هل يدنو بكم سبب","وهل تعودون أيامي بأجياد",61,"د",1,0],["بل لو تذكَّرَ لم يجدْ لضميرهِ","ومصيرهِ عَوناً من التَّذكار",62,"ر",1,0],["بل لو أشاء لقلت كم من وردة","لي عند جِبس ردَّها أشواكا",63,"ك",2,0],["بل ليته سلب العقول فلم يكن","أحد يعلّل نفسه بمنالها",64,"ل",3,0],["بل ليس في البأس خيرٌ أو يزيِّنَهُ","في عين طالب خيرٍ مطلُ موعودُ",65,"د",1,0],["بِکللَّهِ زُرْنا إن أَرَدْتَ وِصَالَنا","وآحْذَرْ أُنَاساً كُلُّهُمْ مأْمُورُ",66,"ر",1,0],["بِکللَّهِ حَدِّثْ مانُؤَمِّلُهُ","واصدقْ، فإنّ الصدقَ واسعنا",67,"ن",2,0],["بِکللَّهِ قُولي لَهُ، في غَيْرِ مَعْتَبَة ٍ،","ماذا أَرَدْتَ بِطُول المَكْثِ في اليَمَنِ",68,"ن",1,0],["بِکللَّهِ رَبِّ مُحَمَّدٍ، حَدِّثْنَني","حقاً أما تعجبنّ من هذا الفتى",69,"ا",1,0],["بل لا يقاس بعالم","هي قيس بحرٌ بالسرابْ",70,"ب",1,0],["بَل لَو قَنِعتِ مِنَ الغَرامِ بِمُظهَرٍ","عَن مُضمَرٍ بَينَ الحَشا وَالأَضلُعِ",71,"ع",1,0],["بَلِلتُ بِها يَومَ الصُراخِ وَبَعضُهُم","يَخُبُّ بِهِ في الحَيِّ أَورَقُ شارِفُ",72,"ف",1,0],["بل لو اعرض في التغزل بي","فقرو لي صبر بإسماعيلا",73,"ل",2,0],["بل للعناية بالمليكِ لأنه","أصغى فهذبَّه الإِله وثقّفا",74,"ف",2,0],["بللت لكي يلين بماء صبري","صفاة من رضاكم لا تلين",75,"ن",1,0],["بل للعدالة في الطغاة تقيمها","من بعد ما سخروا بها وتمردوا",76,"د",3,0],["بل لو رأى يعقوبُ حُسنَ محمدٍ","ما كان يحزن إذ تغيَّب يوسفُ",77,"ف",1,0],["بل لو ترى الحركات منك عشقتها","عشقاً يُخاف عليك منه ويُحذر",78,"ر",1,0],["بل ليتني بعد الذي","عانيتُ من صحبى أفيق",79,"ق",1,0],["بل ليتني بعدى الذي","عانيت من صحبي أفيق",80,"ق",1,0],["بل لا أَقيسُك بالدنيا وساكنها","وهل يُقاس ضياءُ الصبح بالظُّلَمِ",81,"م",1,0],["بل لي كميتٌ ما رئي مثله"