{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[88,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[37,"أأطلال دار بالنياع فحمت","https://www.aldiwan.net/poem39176.html","الطويل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[302,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96999","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138157",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96615","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64564","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130254","الطويل"],[1686,"","https://poetry.dctabudhabi.ae/diwan/poem/97702","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69402","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71034","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48259","الطويل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20682","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62856","الوافر"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139381",""],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"فلسطين-حق العودة","https://www.poetsgate.com/ViewPoem.aspx?id=197949",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5957,"وحرفكَ زاهٍ بلا شارحة","https://www.poetsgate.com/ViewPoem.aspx?id=181596",""],[6089,"تسامرُني الأشواقُ في غارِ وحشتي","https://www.poetsgate.com/ViewPoem.aspx?id=214639",""]],"verses":[["يُؤوي الضُيوفَ وَدونَ حُجرَتهِ","بابٌ عَلى الأَحداثِ يُغلِقُهُ",0,"ق",2,0],["يَؤولُ عَرشُكِ مِن شَمسٍ إِلى قَمَرٍ","إِن غابَتِ الشَمسُ أَولَت تاجَها القَمَرا",1,"ر",2,0],["يَؤودُ ضَعيفَ القَومِ حَملُ قَتيرِها","وَيَستَضلِعُ الطَرفُ الأَشَمُّ اِحتَمالَها",2,"ل",3,0],["يَؤُوبُ أُولُو الحاجاتِ مِنهُ إِذا بَدا","إلى طَيبِ الأَثوابِ غَيرِ مُؤمَّتِ",3,"ت",1,0],["يَؤودُ مِن مَتنِها مَتنٌ وَيَجذِبُهُ","كَأَنَّهُ في نِياطِ القَوسِ حُلقومُ",4,"م",1,0],["يَؤولُ إِلى أُمِّ اِبنَتَينِ يَؤودُهُ","إِذا ما أَتاها مُخفِقاً أَو تُصاخِبُه",5,"ب",2,0],["يؤوبُ الليلُ منه إلى جَناحٍ","وتبدو الشمسُ منه على جَناح",6,"ح",1,0],["يؤول للمعصوم والمكره الذي","يوري إذا الجى إليه ويوشب",7,"ب",1,0],["يؤوِّدُها مرُّ النَسيم فتنثني","تثنّي غصنِ البان ما شانَه قَصفُ",8,"ف",1,0],["يَؤولُ عِندي بِذِهنٍ","سُداهُ حُسنَ المَآلِ",9,"ل",1,0],["يؤول متا أولاه بالأولوية","بعثت نفوساً في نفوس رقائقي",10,"ي",1,0],["يؤون لو أن ابن نوح جاءهم","آوى إلى عالي الذرى مناع",11,"ع",1,0],["يؤودها حاضر مخز ويزعجها","ما يضمر الغيبُ من قبح وتشويه",12,"ي",2,0],["يَؤوب الغائبونَ وكلّ خلقٍ","إِلى الأخلاقِ سافرَ أن يؤوبا",13,"ب",2,0],["يَؤوبُ الغائبون وكلّ خلق","إِلى الأحداثِ سافر أن يؤوبا",13,"ب",2,0],["يؤوب احتياجي يا غني وفاقتي","إليك فبالنعماء بؤسي بدلا",14,"ل",2,1],["يؤول إليه كل أبلج شامخ","ملوك وأبناء الملوك الغطارف",15,"ف",1,0],["يَؤوّل ما هاجَت لك الشوق دمنةٌ","بِأجرع مقفار مربٍّ محلّلِ",16,"ل",1,0],["يؤوبون بالقصر ثم المنى","ويمضون في كل شعب وواد",17,"د",1,0],["يُؤؤِيهِما قَلبي وَفِيهِ صَبابَتي","لَولا البُكاءُ لَخِفتُ يَحتَرِقانِ",18,"ن",1,0],["يؤوب إِلى أَهْليه في مُستقرِّه","ويُلْقِي عصا التَّسْيار والنَّصَب المُضْني",19,"ن",2,0],["يؤوبُ مواليه لرضوانَ إِن قضوا","وللنارِ من ناوَاهُ يدعوهُ مالكُ",20,"ك",1,0],["يَؤُوبُ إِلَيكَ أِشعَثَ جَرَّفَتهُ","عَوانٌ لا يُنهنِهُها الفُتورُ",21,"ر",1,0],["يَؤولُ به الشَّبابُ الى مَشِيبٍ","ويسْلِمُهُ الغُدُوُّ الى الرَّواحِ",22,"ح",1,0],["يؤوب إلى أوطانه كل غائبٍ","وأحمدُ في الغيابِ ليس يؤوبُ",23,"ب",1,0],["يَؤوب بِالعَجزِ اِقواهُم اِذا الم","بِهِ أَلَم وَيبدى شَر حَسرات",24,"ت",1,0],["يؤول آيات الكتاب على الذي","توهمه من رأيه الفاسد المردي",25,"د",2,0],["يؤول ما قالوا بغير الذي له","أرادوا وتخفى في الدليل محامله",26,"ل",2,0],["يؤولك الأغراب حائط دمعهم","وأنت لنا غيمُ الدموع المؤولُ",27,"ل",1,0],["يَؤُوبُ الغائِبُونَ وَكُلُّ خَلْقٍ","إِلَى الأَجْداثِ سافَرَ لَنْ يَؤُوبا",28,"ب",2,0],["يؤوب الشعورُ إلى كل ركن ٍ","أريج اللغات بها جامحة",29,"ح",2,0],["يؤولني السارون في العشقِ غيمةً","تسحُّ غراما ماؤُهُ لا يؤولُ",30,"ل",1,0]]}