m/ViewPoem.aspx?id=35572",""],[5444,"أحلى الأمكنة","https://www.poetsgate.com/ViewPoem.aspx?id=205447",""],[5526,"حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=192345",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5670,"وأمُرُّ بالدُّنْيا !","https://www.poetsgate.com/ViewPoem.aspx?id=211219",""],[5737,"توبة الملاك","https://www.poetsgate.com/ViewPoem.aspx?id=177800",""],[5741,"وأعور العين ظل يكشفها","https://www.poetsgate.com/ViewPoem.aspx?id=187467",""],[5756,"ادلعها واولعها","https://www.poetsgate.com/ViewPoem.aspx?id=5414",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5943,"القاتلُ المجنونُ","https://www.poetsgate.com/ViewPoem.aspx?id=61843",""],[5956,"بين الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=181865",""],[5956,"مع خيالها","https://www.poetsgate.com/ViewPoem.aspx?id=182067",""],[5956,"إني ذكرتُكِ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182408",""],[5956,"مغناطيس الاستعطاف","https://www.poetsgate.com/ViewPoem.aspx?id=192106",""],[5956,"تصادُمُ السمُوِّ بالدنُوِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193936",""],[6019,"فهويتي (هجرية)","https://www.poetsgate.com/ViewPoem.aspx?id=53062",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[6093,"لا لنْ أُعاشرَ مَنْ يُؤاخذْ (مجزوء الكامل المرفَّل )","https://www.poetsgate.com/ViewPoem.aspx?id=181695",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6102,"ثأر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=183321",""],[520,"فما استنشقت ريح الصباح خياشم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577633",""],[6341,"ذات غائبة..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87276&r=&rc=5",""]],"verses":[["وَأَعوذُ بِالصَبرِ الجَميلِ تَعَزِّياً","لَو كانَ بِالصَبرِ الجَميلِ عَزائي",0,"ي",1,0],["وَأَعوَرَ مِن نَبهانَ يَعوي وَدونَهُ","مِنَ اللَيلِ بابا ظُلمَةٍ وَسُتورِ",1,"ر",1,0],["وَأَعوَرَ مِن نَبهانَ أَمّا نَهارُهُ","فَأَعمى وَأَمّا لَيلُهُ فَبَصيرُ",1,"ر",1,0],["وَأَعوَصنَ بِالدومِيِّ مِن رَأسِ حِصنِهِ","وَأَنزَلنَ بِالأَسبابِ رَبَّ المُشَقَّرِ",2,"ر",1,0],["وأعوانُ الضعيف أُولو احتشادٍ","لنصرته وعنه ذو نضال",3,"ل",1,0],["وَأَعوَزَهُ عَلى البَلوى مُعينٌ","وَأَعوَزَ لَيلَهُ القَمَرُ التَمامُ",4,"م",1,0],["وأَعودُ للدُّنيا بقلبٍ خافقٍ","للحبِّ والأَفراحِ والأَلحانِ",5,"ن",1,0],["وأعوزها زيت تنوِّر بيتها","به والدجى سجف على الأرض مسبل",6,"ل",1,0],["وَأَعوَلَ نَجدٌ وَضَجَّ الحِجازُ","وَمالَ الحُسَينُ فَعَزَّ الحَسَن",7,"ن",1,0],["وأعوانُ حبٍّ إنْ عفَا كَلْمُ صَبْوةٍ","فلِلقلب منها عَقْرُ كلمٍ وتعذيبُ",8,"ب",1,0],["وأعوذُ من شَرْقِ البلادِ بِغَرْبِها","فأؤُوبُ من وَصَبٍ إلى إخفاقِ",9,"ق",1,0],["وَأَعوَزَ مَع ذُنُوّي مِنهُ صَبري","فَكَيفَ يَكونُ صَبري بَعدَ بَينِ",10,"ن",1,0],["وَأَعوذُ بِاِسمِكَ أَن تَكونَ كَعارِضٍ","لا يُرتَجى وَكَنابِتٍ لَم يُثمِرِ",11,"ر",1,0],["وَأَعوذُ مِنكِ بِكِ الغَداةَ لِتَصفَحي","عَمّا جَنَيتُ مِنَ الذُنوبِ وَتَرهَمي",12,"م",2,0],["وَأَعوَلتُ أَندُبُ عَصراً خَلا","وَقَصرُ اِبنِ سِتّينَ أَن يَندُبا",13,"ب",2,0],["وأعولتِ النّطاةُ لِفَقْدِ حِصنٍ","يَعُمُّ يَهودَ شَجْواً وانتحابا",14,"ب",2,0],["وَأَعُودُهُ ما شئتُ أَقضِي حَقَّهُ","وأرى قَضَاءَ اللَّهِ ماذا يَصنعُ",15,"ع",1,0],["وأَعُودَ بالفضلِ العظيمِ مُنَوَّلاً","وَكَفَى بِفضلٍ منه لي تَنْوِيلا",16,"ل",2,0],["وَأَعوَزَني ماءٌ أُزيلُ بِهِ الصَدى","فَلا عَيشَ إِن لَم أَشرَبَ الكَدِرَ الطَرقا",17,"ق",2,0],["وَأَعوَزَتِ الفَضيلَةُ كُلَّ حَيٍّ","فَما هُوَ غَيرُ دَعوى وَاِنتِحالِ",18,"ل",1,0],["وَأَعوَزَنا بَياضُ العَيشِ فيها","وَلَم يُعوِز بَياضٌ مَفرِقِيُّ",19,"ق",2,0],["وا عَولَتا مِن حَزَنٍ داخِلٍ","وَمِن زَفيرٍ بَعدَهُ لي شَهيق",20,"ق",1,0],["وَأَعوَلَتِ المَعالي وَالعَوالي","وَبيضُ الهِندِ وَالجُردِ العَوادي",21,"د",2,0],["وَأَعوَلَ القابِرُ لَمّا رَأى","أَيَّ شِهابٍ بِالثَرى غَطّى",22,"ط",2,0],["وأعود ، قدامي ورائي جبهتي","نعلي وساقي ، في مكان قذالي",23,"ل",2,0],["واعوجاج الزمان يا هبر ما","زال اعوجاجاً ينوء فيه السداد",24,"د",1,0],["وَأَعوَزَتِ الأَمانَةُ فيهِ حَتّى","تَخَوَّفَتِ اليَمينُ مِنَ الشِمالِ",25,"ل",1,0],["واعوارّ صح مدغم المؤخر","واجتور واحملا على التحاور",26,"ر",1,0],["وأَعودُ أَنشدُ في هواك ندامة","يا لَيتَني لم أَتَّخذكَ خَليلا",27,"ل",2,0],["وأعود من دنيا الغرا","مِ وقد كسبت شجونيه",28,"ي",2,0],["وَأَعوَزَهُ باقي النِطافِ وَقَلَّصَت","ثَمائِلُها وَفي الوُجوهِ سُهومُ",29,"م",1,0],["واعْوِجاجٌ بالدَّهرِ أَن يَمْنَحَ الخَدْ","دَيْنِ منّي ما تَطْلُبُ الكَفّان",30,"ن",1,0],["وأعودُ إن أرعَيْتَ سَمْ","عَك شارحاً لك بعضَ حالي",31,"ل",2,0],["وأعود حرّاً مطلقاً","منها وفيها أمتدح",32,"ح",1,0],["وأعود حياّ قائلاً","قول المثاب المنشرح",32,"ح",1,0],["وَأَعوزَهُ الحَصير وَلَو يُراعى","أَكيد حُقوقِهِ فَرَشوهُ ساجا",33,"ج",2,0],["وَأَعوز مِن كَف البَخيل مَخارِجاً","وَأَفسح مِن آمال أَخرق بِطال",34,"ل",1,0],["وَأَعوانُ مثلي عَلى مثلِهِ","بِما حَكَمَ الحُب خوّانه",35,"ن",2,0],["وأعود من حلل الفتوة حاليا","ما تقتضيه المهمّة الغراء",36,"ا",2,0],["وأَعوزَ المُقامُ أن أَسْطيعَهُ","وسُدِّدَتْ عن سيريَ المَقاصدُ",37,"د",1,0],["وأعوزَني الأنصارُ يومَ سويقةِ","ومن ذا الذي يلقى على البين أنصارا",38,"ر",2,0],["وأعوذُ فيكُم من ذُنوبٍ أثْقَلَتْ","ظهري عسى بولائِكُم أن تُغْفَرا",39,"ر",2,0],["وأعوانه عون على ما يسؤوه","وجثمانه طعم النسور الحوائم",40,"م",1,0],["وَاِعوِجاجَ الأَصداغِ في ظاهِرِ الخَ","دِّ وَما في الصُدورِ مِن رُمّانِ",41,"ن",1,0],["وأَعْوَلَتْ حَلَبٌ إِعوال ثَاكِلة","حتى لَقَدْ سُمْعَتْ مِنْ أَرضِ بَغْدَادِ",42,"د",1,0],["وَأَعوَزَنِي فلمَّا لَم أَجِدهُ","خطبتُ الوُدَّ مِن وُرقِ الفَيَافِي",43,"ف",2,0],["وأعود أطرب للنشيد مزمراً","معكم وما تنتابني الأكدار",44,"ر",1,0],["وَأَعوانها تَنقضُّ في كُل لَحظة","عَليّ بِسَهم للمقاتل صائب",45,"ب",1,0],["وأعوزَ هذا اليومَ ان كنتُ قائماً","أقولُ فأستوفي المقالةَ مقصَدا",46,"د",2,0],["وَأَعوَزَه بِها عَلَف وَطالَت","بِها حَركاتُهُ قَصد الإيابا",47,"ب",2,0],["واعوجاجي وذل نجلي ورجلي","بعد شيخي أبي الفقير الوقير",48,"ر",1,0],["وأعود للماضي وأنظر خيره","نظر الحسود إِلى الغنيِّ الخيّر",49,"ر",1,0],["وأعود عما أبتغي متحيراً","ماذا أقول ولست أملك وجده",50,"د",2,0],["وأعود عنها عودة ال","طيف المدفَّع بالسهر",51,"ر",1,0],["وأعود في كبد تذوب ومقلة","عبرى وما عندي لسان أو فم",52,"م",1,0],["وأعول أولادي أسىً وتخوفاً","على والدٍ أفنى لهم طّيب العمر",53,"ر",1,0],["وأعولت في السما الأملاك مزعجةً","ضوضاؤها العرش تهليلاً وتكبيرا",54,"ر",2,0],["وَأَعودُ عَنهُ وَمِلءُ نَفسي شَهوَةٌ","وَكَما عَلِمتِ تَعَفُّفي وَتَرَفُّعي",55,"ع",2,0],["وَأَعوَجَ مِن آلِ الصَريحِ كَأَنَّهُ","بِذي الشَثِّ سيدٌ آخِرَ اللَيل جائِعُ",56,"ع",1,1],["وأعوذُ باللَهِ العلى من الهوى","ومن النفوس ونَزغَة الشيطانِ",57,"ن",1,0],["وأعوزهم على العسرِ اصطبارٌ","ولو صبروا قليلاً صار يسرا",58,"ر",2,0],["وَأعُوذُُ بِالرَّحمَنِ مِن جَزمٍ بِلاَ","عِلمٍ وَهَذَا غَايَةُ الإمكَانِ",59,"ن",1,0],["وَأَعودُ لِلحَرثِ العَتي","دِ وَلِلسمادِ وَلِلجِمالِ",60,"ل",1,0],["وأعولت الأملاك نادبة وقد","أقامت له فوق السماوات مأتما",61,"م",2,0],["واعولت رؤساء المسلمين على","خطب جسيم على الاسلام قد قسما",62,"م",2,0],["واعوزتني الأماني","ولم أجد ما أعوز",63,"ز",1,0],["وأعود بعد ترقبي إقبالها","والنفس ساهمةٌ من الحسرات",64,"ت",1,0],["وأعود أرقبُ عودها","متأرجاً من عود ندكِّك",65,"ك",1,0],["وأعوام عمر أربعين انتزعتها","من الموت لما أن وصلت الى القبر",66,"ر",1,1],["واعولت بعدك الأيتام فاقدة","ثمال مرملة حنت لأيتام",67,"م",1,0],["وَأَعوِجُ في كلامهمُ لساني","ليُعطوني المسوّل والمسولا",68,"ل",2,0],["وأعود منه على الزمان","أغص بالماء القراح",69,"ح",1,0],["وأعوزَ جِرْمٍ يقطِفُ القيدُ خَطوَهُ","شَريقٌ بأسرابِ الدموعِ خَنيقُ",70,"ق",1,0],["وأعود أكلف ما أكون بحسنها","وأصوغ أشعاري بها تشبيبا",71,"ب",2,0],["وأعود أُفرغ يا ديار عليكِ ما","كسبت يدايَ من البيان الراقي",72,"ق",2,0],["وأعوزني فيه من نقطة","تكون على الطاء من خائه",73,"ه",1,0],["وَأعوَادُ المَنَابِرِ حِينَ تَرقَى","بِهَا إِلاَّ لَهَا ثَمَراً يَطِيبُ",74,"ب",1,0],["وَأَعودُ أَبني ما تَهدَّمَ بَينَها","فَيَذوبُ في بَحرٍ مِنَ الدُنيا خِضَمْ",75,"م",1,0],["وأعوذ منه بجانب من عزه","أنت المعاذ أخي يا مقدادها",76,"د",3,0],["وأعود يوحشني الأنيس كأنني","وحدي وإن مارست حاشد مجمعي",77,"ع",2,0],["وَأَعوز النَصيرُ","وَأَبطَأَ المُجيرُ",78,"ر",1,0],["وأعود للأوطانِ أطَّلِبُ العلى","الله يحفظُ بالعلى الأوطانا",79,"ن",2,0],["وأَعُودُ والطُّرُقاتُ يَضرِبُ بَعضُها","بَعضًا كَمِسبَحَةٍ بَكَفِّ الصُّوفِي",80,"ف",2,0],["وأَعُودُ ذابلةً قُوَايَ, ولي","شَبَحٌ يَخَاصِمُنِي ويَضطَهِدُ",81,"د",1,0],["وأَعُودُ مُحتشِدًا إِليكَ.. تَعودُ بي","جُمَلٌ تُقَهْقِهُ داخِلِي وتَجيشُ",82,"ش",1,0],["وأَعُودُ مُنطفِئَ الفؤادِ كم","جَسَدًا يَعُودُ لِأُمّهِ الابنُ",83,"ن",1,0],["وأَعُودُ مُتَّكِئًا عَلَيَّ، وفي فَمِي","عَتَبٌ إِذا طَرَقَتْهُ لا يَتَجَرَّأُ",84,"ا",1,0],["وأَعُودُ ذابلةً قُوَايَ على","شَبَحٍ أُطَمئِنُهُ وأَرتَعِدُ",85,"د",1,0],["وأعودُ للحفل البهيجِ بمعْهدٍ","أحْيا العزيمةَ يا لها من بان!!",86,"ن",1,0],["واعوذ بك ياخالق الانس والجان","من كل فتنه بالحياة السحيقه",87,"ق",2,0],["وأعوّد لطيفك وأقبّل به ايديك","وأنفض كلام الليل.. وأرجع أرتّبك",88,"ك",1,0],["وأعوّد لطيفك وأقبّل به يديك","وأنفض كلام الليل وأرجع أرتّبك",89,"ك",1,0],["وأعوذ باسمك أن تعيذ قصائدي","منها ففيها يجمل الإنشاد",90,"د",1,0],["وَأَعُوْدُ شَوْقاً كَيْ أَرَاْهَاْ بَعْدَمَاْ","ضَجَّ الْفُؤَاْدُº وَلَجَّ بَعْدَ فِرَاْقِ",91,"ق",1,0],["واعوم بشعرك اللي هو سواد الهمّ في قوعه","ياشيخة غيد قد مرّت على المحجر شرى أطرافك",92,"ك",1,0],["وأعود أركض مفردا","روحي من الذكرى يبابُ",93,"ب",1,0],["وأعوزهم مصل اللقاح وسره","ومن فقد الترياق ما هو صانع",94,"ع",1,0],["وأعوذ بالله المهيمن وحده","من شر كل موسوسٍ خناس",95,"س",1,0],["وأعود ُ أسألُك ِ الغداةَ عن الهوى","وأنا المُعاني في تفاقمِ عبرتِهْ",96,"ت",2,0],["وَأَعُودُ سَرِيرِيَ مُكْتَئِبًا","لَا أَفْتَحُ شُرَفَا أَوْ بَابَا",97,"ب",2,0],["وأعود منها هارباً كالمهر فرَّ من الجنود","أدمى زمانيَ مقلتي فصرخت : أحتمل المزيد",98,"د",1,0],["وأعوذ به من سخط يهوي","منه بعاصٍ هوته",99,"ت",2,0],["وأعوذ من شر الرجيم إذا عدا","بغيا عليّ وجار في طغيانه",100,"ن",2,0],["وأعوذ من غضب الشديد محاله","ذي الملك والملكوت في سلطانه",100,"ن",2,0],["وأعود أسأل في الديار عن الهوى","وجواب سؤلي دائما قد عادوا",101,"د",3,0],["وأعوذ بالحيّ المقدّسِ ذكرهُ","أن تستريبَ المسلمينَ صواهلُ",102,"ل",1,0],["وأعود سعيدا منشرحاً","مئةً يا عمري بالمئةِ",103,"ه",1,0],["وأعودُ للسُّحْماءِ والصَّلَفِ التي","فيها دروسُ العلمِ دوماً مُعلَنة",104,"ن",2,0],["واعود ابدّل في مقاماتك انغام","يطرب لها العشّاق من نسج ذاتي",105,"ت",2,0],["وأعود كالطفل المدلل عندها","هيهات أكبر عندها في موجعي",106,"ع",2,0],["وأعود نحو دفاتري وأسلُّ من غِمدي اليراعْ","وأحاربُ الفوضى وأرسمُ فوق مركبيَ الشراعْ !",107,"ع",1,0],["وأعود للذكرى الطليقةِ في الربى","وأعود للنهر المثرثر للغصون",108,"ن",1,0],["وأعود للطرف الوديع أعود لل","أشجار كالعصفور للعشقِ الدفين",108,"ن",1,0],["وأعور العين ظل يكشفها","بلا حياءٍ منه ولا خيفه",109,"ه",1,1],["وأعوّضها عن اللي راح كله","وعن ذيك الليالي كلّبوها",110,"و",3,0],["واعود لمداح ربعي صادقين الوعيد","العزوة اللي بفن الرمي متفردة",111,"د",2,0],["وأعودُ أبحثُ عن قرينِ الشعرِ أس","تجديهِ حرفًا علَّهُ يرضى الإيابْ",112,"ب",1,0],["‏ ‏وأعوم فوق حنانهنَّ كأنني","‏ ‏ في الجو أسبح أسبِقُ العُقْبانا",113,"ن",2,0],["وأعود أرقص في خيال حبيبتي","وأرى جميع الكون يعرف ميزتي",114,"ت",2,1],["وأعود إنسانا يغنِّي قلبه","مع زوجهِ فرِحاً يعيش طويلا",115,"ل",2,0],["وأعود إنساناً يغني قلبه","مع زوجهِ فرحاً يعود جميلا",116,"ل",2,0],["وأعْولَ في وجهي بصوتٍ مضخَّم:","تغيرْتَ يا هذا معي فتأصَّلِ",117,"ل",1,0],["وأعودُ بعدَ مغيبِ شمسِ غوايتي","لتدقَ ساعةَ عودتي أجراسي",118,"س",2,0],["وأعوذ باسمك أن أقول","(لعروة الوثقى) مصاهر",119,"ر",1,0],["وأَعُوذُ مِنهُ إذا بَدَا","قدْ فَازَ مِنْ باللهِ عائِذْ",120,"ذ",1,0],["وأعودُ في بدءٍ برغمِ ختامِهِ","ليهمِّشَ التَّهمِيشُ كلَّ أوائلِ",121,"ل",1,0],["وَأَعُودُ مُتَّكِئًا عَلَى زَمَنٍ","بِالشَّيبِ أَدرَكَنِي , فَما رَحَما",122,"م",2,0],["وأعوانه عونٌ على ما يسوءه","وجثمانه طعم النسور الحوائم",123,"م",1,0],["وأعود للصحراء ألفحُ وجهها","بهجير نفسٍ لاترى الإذعانا",124,"ن",2,0]]}