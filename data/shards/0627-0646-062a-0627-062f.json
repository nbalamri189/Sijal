{"poems":[[74,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[102,"نصيحة سيئة","https://www.poetsgate.com/ViewPoem.aspx?id=50448",""],[132,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[193,"ميت أنسي يأتيه بالوصل روح","https://www.aldiwan.net/poem35168.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48780","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48794","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133798","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17733","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100312","الخفيف"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138532",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73396","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73159","الخفيف"],[4691,"أشرقي يا شروق أنت ِ الشروق ُ","https://www.poetsgate.com/ViewPoem.aspx?id=126247",""],[5952,"مَوْسِقِ ال آهَ","https://www.poetsgate.com/ViewPoem.aspx?id=213572",""],[1100,"لا تحققت يا حلم فتساويت والعدم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613000",""],[313,"هل تناسيت؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66503&r=&rc=25",""]],"verses":[["أنتَ أدرى بحالتِي وبحقِّي","فأغثني بجازمِ الفعل ماضي",0,"ض",2,0],["أنت أدْوَيتَ صدر خِلِّك فاعذر","هُ على النَّفثِ إنه كالدواءِ",1,"ا",2,0],["أنت أدرى بهم فليس لديهم","غير ما تعرفين أدنى مهارة",2,"ر",2,0],["أنت أدرى بهم وليس غريبا","فالبغايا عيون حكم الدعارة",2,"ر",2,0],["أنتَ أدرى بحالِنا إن أردْنا","حاجةً منك ليس بندى سؤالاَ",3,"ل",2,0],["أنتَ أَدرى بها وَبي مِن ضميري","أنتَ روحي بل أنتَ للروح روحُ",4,"ح",1,0],["أنت أدرى في الذي قمت به","كيف تُأتَى وتُداوَى العلل",5,"ل",1,0],["أنت أدرى بفضل إمهالك الأم","رِ وأدرى بحكمة استعجاله",6,"ل",2,0],["أَنتَ أَدْرَى بالشِّعْر من قائلِيهِ","فاقضِ فِيهِ بالْحَزْم والتَّعْجيز",7,"ز",1,0],["أنت أدنى ما أنت في","عالم السر والظُّلَم",8,"م",1,0],["أنت أدر بكل من هو جارٍ","في البرايا بأرضها وسماها",9,"ا",3,0],["أَنتَ أَدَّبتَني فَأَحسَنت تَأدي","بي وَأَفهمتَني مَصير الكَسولِ",10,"ل",1,0],["أَنتَ أَدنَيتَني وَسَهَّلتَ حاجي","وَجَعَلتَ الحُزونَ مِنها السُهولا",11,"ل",2,0],["أنت أدنى إلى الطراز وأولى","ثم أحلى له وأحسن طرزا",12,"ز",2,0],["أَنتَ ادري بحال مضناكَ فَارحَم","عَبراتٍ مِنَ العُيونِ الدَوامي",13,"م",2,0],["أَنتَ أَدرى بأنَّنا بك أَدرى","فَاِختبر غيرنا وَجرّب سِوانا",14,"ن",2,0],["أنت ادرى بما دهاها ولكن","ضاق صدري عن كتمه في الضمير",15,"ر",1,0],["أَنتَ أَدرى بِما يُلاقيهِ قَلبي","مِن لَظَى الحُبِّ أَوَّلاً وأَخيرا",16,"ر",2,0],["أنتَ أدرَى بما يُلاقيه قلبي","مِن غرامٍ بكُنههِ لا يُحاطُ",17,"ط",1,0],["أنت ِ أدرى الأنام بالحال جودي","بشفاءٍ أنت الطبيب الصديق ُ",18,"ق",1,0],["أنت أدرى بملحِ دمعِكَ منهم","فاشربِ الحزنَ يُقْهرِ اللؤماءُ",19,"ا",2,0],["أنت أدنى ما أنت في عالم السر والظُّلَم","جوك الغيب والمبهم والموعد المكتتم",20,"م",1,0],["أنت أدرى بحاله","وهو أدرى بما حصل",21,"ل",1,0]]}