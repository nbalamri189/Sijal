{"poems":[[57,"اصبر على مر الجفا من معلم","https://www.aldiwan.net/poem24719.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[77,"لنا في الفخر أسنمة مطلة","https://www.aldiwan.net/poem36334.html","الوافر"],[93,"مكان العلى من راغب بن عطية","https://www.aldiwan.net/poem9777.html","عموديه"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[30,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[88,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[88,"أدرنة مهلا فإن الظبى","https://www.aldiwan.net/poem44466.html","المتقارب"],[4,"أعاذل قومي فاعذلي الآن أو ذري","https://www.aldiwan.net/poem21164.html","الطويل"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[91,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[38,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[78,"أيا ملكا يجل عن الضريب","https://www.aldiwan.net/poem14153.html","الوافر"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[43,"دروع لملك الروم هذي الرسائل","https://www.aldiwan.net/poem9969.html","الطويل"],[45,"أعوذ ببدر من فراق حبيبي","https://www.aldiwan.net/poem11048.html","الطويل"],[45,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[61,"خطوب تجور ولا تعدل","https://www.aldiwan.net/poem51473.html","المتقارب"],[58,"ومحترس من نفسه خوف ذلة","https://www.aldiwan.net/poem30789.html","الطويل"],[44,"ومنفرد بالحسن خلو من الهوى","https://www.aldiwan.net/poem30290.html","الطويل"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[105,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[46,"إذا قيل لك اخش الله","https://www.aldiwan.net/poem22044.html","الهزج"],[46,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16631","المتقارب"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30437","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[46,"إذا قيل لك: اخشَ اللَّه","https://www.poetsgate.com/ViewPoem.aspx?id=16597",""],[91,"السجينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=374&r=&rc=2",""]],"verses":[["وَمَن فاتَهُ التَعليمُ وَقتَ شَبابِهِ","فَكَبِّر عَلَيهِ أَربَعاً لِوَفاتِهِ",0,"ت",2,0],["وَمِنْ فَوْقِ أَطْبَاقِ الطِّبَاقِ بِكَ اقْتَدَى","خَلِيلُ الَّذِي أَوْطَاكَهَا وَكَلِيمُهُ",1,"م",2,0],["وَمَنْ فَوْقِ أَطْبَاقِ السَّمَاءِ بِكَ اقْتَدَى","خَلِيلُ الَّذِي أَوْطَاكَهَا وَكَلِيمُهُ",1,"م",2,0],["وَمِنْ فَصْلِ الْخِطَابِ بِكُلِّ نَادٍ","ومن فضل الثناء بكل مله",2,"ل",2,0],["وَمَنْ فِي رِجَالِ الْيَوْمِ كَابْنِ عَطِيَّةٍ","قِيَاماً بِحَقٍّ أَوْ نُهُوضاً لِوَاجِبِ",3,"ب",1,0],["وَمِنْ فَتىً أَلمَعِيٍّ كُلُّ مَحْمَدَةٍ","جَارَى السَّوَابِقَ فِيهَا فَازَ بِالقَصَبِ",4,"ب",1,0],["وَمِنْ فَضَائِلَ لاَ يُبْهَى مَحَاسِنُهَا","في الأَمنْ إِلاَّ تَجْلِيهُنَّ في النُّوَبِ",5,"ب",1,0],["ومُنْفَرِجٌ مِنْ خَالِصِ الْعَاجِ مَارِنٌ","كَأَنَّ الْهَوَى قَدْ بُثَّ فِيمَا تَنَسَّمَا",6,"م",2,0],["وَمِن فِتيَةٍ كانَت حَنيفَةُ بُرءَها","إِذا مالَ حَنوا رَأسِها المُتَقادِمِ",7,"م",1,0],["ومن فتى أدمعه جاريه","قد صافح العشق بجسم سقيم",8,"م",1,0],["ومَن في البقيع ومن في قُبا","ومن شهِدوا الفتح والخندقا",9,"ق",2,0],["وَمَن فادَ مِن إِخوانِهِم وَبَنيهِم","كُهولٌ وَشُبّانٌ كَجِنَّةِ عَبقَرِ",10,"ر",1,0],["ومن في المعالي قد تقدَّم ورده","أجلْ إنها عادات آبائه الأولى",11,"ل",2,0],["ومن فَرَحاتِ النفسِ ما فيه حتفُها","ومن أنسِها بالخير ما هو كالنفر",12,"ر",1,0],["ومن فعل الخير مستخفياً","أشاعت مساعيه ما لم يُشِع",13,"ع",1,0],["ومُنْفَردٌ بالجُود دونك حاتمٌ","وكعبٌ ولم يعشركَ كعبٌ وحاتمُ",14,"م",1,0],["وَمِن فَتَياتِ القَصرِ يَرقُصنَ حَولَها","عَلى نَغَماتٍ كُلُّهُنَّ عَجيبُ",15,"ب",1,0],["وَمِن فَرطِ وَجدي في لَماهُ وَثَغرِهِ","أُعَلِّلُ قَلبي بِالعُذيبِ وَبِالنَقا",16,"ق",2,0],["وَمِن فارِسٍ لَم يَحرِمِ السَيفَ حَظَّهُ","إِذا رُمحُهُ في الدارِعينَ تَجَزَّعا",17,"ع",2,0],["وَمَن في كَفِّه بُؤسي وَنعمي","تَصرَّفَ في العدوّ وَفي الحَبيبِ",18,"ب",1,0],["وَمَن في كَفِّهِ مِنهُم قَناةٌ","كَمَن في كَفِّهِ مِنهُم خِضابُ",19,"ب",1,0],["وَمَن فَرَّ مِن إِحسانِهِ حَسَداً لَهُ","تَلَقّاهُ مِنهُ حَيثُما سارَ نائِلُ",20,"ل",1,0],["وَمِن فَجعَتي مِنهُ بِقُرَّةِ أَعيُنٍ","إِذا شُرِعَت فيهِ وَشُغلِ قُلوبِ",21,"ب",1,0],["وَمِن فِتنَةٍ شَعواءَ غَطّى ظَلامُها","عَلى الأُفقِ حَتّى عادَ أَقتَمَ أَكدَرا",22,"ر",2,0],["ومِن فوقِ رأسِك غِرِّيدةٌ","صَدُوحٌ كما صَدَحَ البُلبُلُ",23,"ل",1,0],["وَمِن فَضلِهِ يَرعى ذِماماً لِجارِهِ","وَيَحفَظُ مِنهُ العَهدَ إِذ ظَلَّ راعيا",24,"ي",2,0],["ومُنفَرِدٍ بِالحُسنِ خُلوٍ مِنَ الهَوى","بَصيرٍ بِأَسبابِ التَجَرُّمِ وَالعَتبِ",25,"ب",1,1],["وَمِن فاحِمٍ جَعدٍ وَمِن كَفَلٍ نَهدِ","وَمِن قَمَرٍ سَعدٍ وَمِن نائِلٍ ثَمدِ",26,"د",1,0],["ومن فَزِعٍ مَضيتَ به أسيراً","على جَزَعٍ يَذلُّ ويَسْتَقيدُ",27,"د",1,0],["وَمَن فَوقَ الثَرى يَص","غُرُ في أَجزاءِ مَن وارى",28,"ر",2,0],["وَمَن فَقَد الشَبيبَةَ فَالغَواني","لَهُ عِندَ الوُرودِ مُصَرِّداتُ",29,"ت",1,0],["وَمن فطم الطفل قبل الأوا","ن عن درّ أمٍّ أساء الفطاما",30,"م",2,0],["ومن فضل ذي كسيت خاتماً","يزين وعُرّيَتِ البنصر",31,"ر",1,0],["ومُنَفِّرٍ للنَّوْمِ مَسْكَنُهُ إِذا","نامَ المُمَلَّكُ بَيْنَ أَثْنَاءِ الثِّيَاب",32,"ب",1,1],["وَمِنْ فَطِنٌ تَذْكِي نَوَافِحُ فِكْرِهِ","فَتُتْحِفُ أَرْوَاحَ الرِّفَاق بِأَرْوَاحِ",33,"ح",1,0],["وَمَنْ فِي الشُّيُوخِ الْمُنْتَدِينَ كَيُوسُفٍ","بِهِ حِلْمُ شَيْخٍ وَهْوَ فِي سِنِّهِ كَهْلُ",34,"ل",1,0],["وَمِنْ فِيكِ يسْمَعُ نَجْوَى الْغُصُونِ","وَيُصْغِي إِلَى هَمْسَةِ الْجَدْوَلِ",35,"ل",1,0],["ومن فتاةٍ فَجْرُها لَيْلُها","ومن غُلامٍ ضَلَّ في فَجْرِه",36,"ر",2,0],["وَمنْ في البسطةِ يَفدي البسيط","ويفدي ذَوُو الجَشعِ القانعيا",37,"ي",2,0],["ومَنْ فوقَ الثرى يَص","غُرُ في أجزاءِ منْ وارا",38,"ر",2,0],["ومن فتيات القصر يرقص حولها","على نغمات كلهنّّ عجيب",39,"ب",1,0]]}