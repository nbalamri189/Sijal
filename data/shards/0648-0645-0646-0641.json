دي والعدد",244,"د",1,0],["ومن فاق سحباناً وقساً فصاحة","ومن هو ابهى في الرياض من الزهر",245,"ر",1,0],["ومن في ديه صروف الزمان","أيُصبح رهناً ليدي الصروف",246,"ف",1,0],["ومن فكّ من رمز المقادر أحرفاً","يبينُ له رسمٌ على الكون يرسم",247,"م",1,0],["وَمَن في لَفظِهِ أَحلى بَياناً","لعمرُكَ فيها قَد حارَ أَمري",248,"ر",2,0],["وَمُنفِقين مِن الأَموال أَنفسَها","في البَحث عَن خِرَق لَم يُغنِ باليها",249,"ي",3,0],["ومن فتون السحر الحاظه","أعظم بخلاقك ماذا خلق",250,"ق",1,0],["ومن فقه مستنبط من حديثه","رواه بتصحيح الرواية وانتخب",251,"ب",1,0],["وَمِن فَرائد آداب نحبّرها","فَنُودع الشهبَ أَفلاكاً مِن الكُتبِ",252,"ب",1,0],["ومن فلزاتها غيث تماكمه","يسح منتظما طورا ومنثورا",253,"ر",2,0],["ومن فلك الديباج يبدو مجلببا","لأعين نظار بأحسن جلباب",254,"ب",1,0],["ومن في عمره ما ذاق روحا","فما هو للمعنى بالمريح",255,"ح",1,0],["ومن في حماه قد انام الانام في","امان وعيش ناعم وهو في سهد",256,"د",1,0],["ومن فضائله أني رجعت إلى","نظم القريض وفكري عنه محسور",257,"ر",1,0],["ومن فضل واحسان وعدل","وبذل صنيعة وهلم جرا",258,"ر",2,0],["ومن فاته التعريب لم يدر ما العنا","ولم يصل نار الحرب الا المحارب",259,"ب",1,0],["ومن فاضت له بالجود كفٌّ","كفت بأقل جدواها الوجودا",260,"د",2,0],["ومنفرد بالمكرمات تألقت","عليه المعالي فاستقل بها مجدا",261,"د",2,0],["ومن فَجَعتْهُ المُنَى في صباه","تراءى صِباه له مظلِما",262,"م",2,0],["ومن فيتو الى فينو","وحلم الامن هادينا",263,"ن",2,0],["وَمِنْ فَرَضِيَّةِ المَعْنى بَديلٌ","وَعَنْ جَدَلِيَّةِ اللّفْظِ اخْتصارُ",264,"ر",1,0],["ومن في الراحة توسدها ولاهم العمل","بايدخل ابواب الشقى وتقبل البلوى صليه",265,"ي",2,0],["وَمَنْ فَرَقٍ تَمَاْدَيْنَاْ طِرَاْبَاً","حَسِبْنَاْهَاْ وُرُوْدَاً قدْ زُهينَا",266,"ن",2,0],["وَمِنْ فَرَقِي عَلَيْكِ أَحُطُّ كَفِّي","عَلَى بَصَرِي لِيَغْشَانِي الْمَقَامُ",267,"م",1,0],["وَمَنْ فَرَّ مِنْ دِيِنِ الإِلَهِ تَأَجُّماً","سَيَصْلَى جَحِيِماً كَيْ يَخُرَّ وَيَبْخَعَا",268,"ع",2,0],["وَمَنْ فِي الْحُبِّ لَمْ يُقْتَلْ بِآهٍ","فَلَا حِسٌ سَيَحْيَا فِيهِ فَصْلُ",269,"ل",1,0],["ومن فلسه ربه ، عليم أبتفليسه","ما دامه سليم كل شغله يمارسها",270,"س",3