.com/ViewPoem.aspx?id=199841",""],[5315,"فديتك لَا تعجب لطرفك أَن كبا","https://www.poetsgate.com/ViewPoem.aspx?id=190298",""],[5344,"ربعي بني وايل ( قبيلة عنزه )..","https://www.poetsgate.com/ViewPoem.aspx?id=180837",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5431,"ونور من الرحمن يجلو وساوسي","https://www.poetsgate.com/ViewPoem.aspx?id=189700",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"وحبي له نورٌ وعطرٌ ولا شكلُ!!","https://www.poetsgate.com/ViewPoem.aspx?id=195351",""],[5444,"لن تجد","https://www.poetsgate.com/ViewPoem.aspx?id=205446",""],[5512,"كيمياء أم خيانة","https://www.poetsgate.com/ViewPoem.aspx?id=204425",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5545,"رفيق الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=184833",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5770,"سلامٌ لغزة","https://www.poetsgate.com/ViewPoem.aspx?id=178253",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[402,"مضى حسن في ذمة الله أنسه","https://www.poetsgate.com/ViewPoem.aspx?id=35345",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"النساء ضحايا أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=181848",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5190,"الزاهية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85079&r=&rc=154",""],[6355,"في جوفه نارٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66561&r=&rc=21",""]],"verses":[["وَمَن فاتَهُ التَعليمُ وَقتَ شَبابِهِ","فَكَبِّر عَلَيهِ أَربَعاً لِوَفاتِهِ",0,"ت",2,0],["وَمِنْ فَوْقِ أَطْبَاقِ الطِّبَاقِ بِكَ اقْتَدَى","خَلِيلُ الَّذِي أَوْطَاكَهَا وَكَلِيمُهُ",1,"م",2,0],["وَمَنْ فَوْقِ أَطْبَاقِ السَّمَاءِ بِكَ اقْتَدَى","خَلِيلُ الَّذِي أَوْطَاكَهَا وَكَلِيمُهُ",1,"م",2,0],["وَمِنْ فَصْلِ الْخِطَابِ بِكُلِّ نَادٍ","ومن فضل الثناء بكل مله",2,"ل",2,0],["وَمَنْ فِي رِجَالِ الْيَوْمِ كَابْنِ عَطِيَّةٍ","قِيَاماً بِحَقٍّ أَوْ نُهُوضاً لِوَاجِبِ",3,"ب",1,0],["وَمِنْ فَتىً أَلمَعِيٍّ كُلُّ مَحْمَدَةٍ","جَارَى السَّوَابِقَ فِيهَا فَازَ بِالقَصَبِ",4,"ب",1,0],["وَمِنْ فَضَائِلَ لاَ يُبْهَى مَحَاسِنُهَا","في الأَمنْ إِلاَّ تَجْلِيهُنَّ في النُّوَبِ",5,"ب",1,0],["ومُنْفَرِجٌ مِنْ خَالِصِ الْعَاجِ مَارِنٌ","كَأَنَّ الْهَوَى قَدْ بُثَّ فِيمَا تَنَسَّمَا",6,"م",2,0],["وَمِن فِتيَةٍ كانَت حَنيفَةُ بُرءَها","إِذا مالَ حَنوا رَأسِها المُتَقادِمِ",7,"م",1,0],["ومن فتى أدمعه جاريه","قد صافح العشق بجسم سقيم",8,"م",1,0],["ومَن في البقيع ومن في قُبا","ومن شهِدوا الفتح والخندقا",9,"ق",2,0],["وَمَن فادَ مِن إِخوانِهِم وَبَنيهِم","كُهولٌ وَشُبّانٌ كَجِنَّةِ عَبقَرِ",10,"ر",1,0],["ومن في المعالي قد تقدَّم ورده","أجلْ إنها عادات آبائه الأولى",11,"ل",2,0],["ومن فَرَحاتِ النفسِ ما فيه حتفُها","ومن أنسِها بالخير ما هو كالنفر",12,"ر",1,0],["ومن فعل الخير مستخفياً","أشاعت مساعيه ما لم يُشِع",13,"ع",1,0],["ومُنْفَردٌ بالجُود دونك حاتمٌ","وكعبٌ ولم يعشركَ كعبٌ وحاتمُ",14,"م",1,0],["وَمِن فَتَياتِ القَصرِ يَرقُصنَ حَولَها","عَلى نَغَماتٍ كُلُّهُنَّ عَجيبُ",15,"ب",1,0],["وَمِن فَرطِ وَجدي في لَماهُ وَثَغرِهِ","أُعَلِّلُ قَلبي بِالعُذيبِ وَبِالنَقا",16,"ق",2,0],["وَمِن فارِسٍ لَم يَحرِمِ السَيفَ حَظَّهُ","إِذا رُمحُهُ في الدارِعينَ تَجَزَّعا",17,"ع",2,0],["وَمَن في كَفِّه بُؤسي وَنعمي","تَصرَّفَ في العدوّ وَفي الحَبيبِ",18,"ب",1,0],["وَمَن في كَفِّهِ مِنهُم قَناةٌ","كَمَن في كَفِّهِ مِنهُم خِضابُ",19,"ب",1,0],["وَمَن فَرَّ مِن إِحسانِهِ حَسَداً لَهُ","تَلَقّاهُ مِنهُ حَيثُما سارَ نائِلُ",20,"ل",1,0],["وَمِن فَجعَتي مِنهُ بِقُرَّةِ أَعيُنٍ","إِذا شُرِعَت فيهِ وَشُغلِ قُلوبِ",21,"ب",1,0],["وَمِن فِتنَةٍ شَعواءَ غَطّى ظَلامُها","عَلى الأُفقِ حَتّى عادَ أَقتَمَ أَكدَرا",22,"ر",2,0],["ومِن فوقِ رأسِك غِرِّيدةٌ","صَدُوحٌ كما صَدَحَ البُلبُلُ",23,"ل",1,0],["وَمِن فَضلِهِ يَرعى ذِماماً لِجارِهِ","وَيَحفَظُ مِنهُ العَهدَ إِذ ظَلَّ راعيا",24,"ي",2,0],["ومُنفَرِدٍ بِالحُسنِ خُلوٍ مِنَ الهَوى","بَصيرٍ بِأَسبابِ التَجَرُّمِ وَالعَتبِ",25,"ب",1,1],["وَمِن فاحِمٍ جَعدٍ وَمِن كَفَلٍ نَهدِ","وَمِن قَمَرٍ سَعدٍ وَمِن نائِلٍ ثَمدِ",26,"د",1,0],["ومن فَزِعٍ مَضيتَ به أسيراً","على جَزَعٍ يَذلُّ ويَسْتَقيدُ",27,"د",1,0],["وَمَن فَوقَ الثَرى يَص","غُرُ في أَجزاءِ مَن وارى",28,"ر",2,0],["وَمَن فَقَد الشَبيبَةَ فَالغَواني","لَهُ عِندَ الوُرودِ مُصَرِّداتُ",29,"ت",1,0],["وَمن فطم الطفل قبل الأوا","ن عن درّ أمٍّ أساء الفطاما",30,"م",2,0],["ومن فضل ذي كسيت خاتماً","يزين وعُرّيَتِ البنصر",31,"ر",1,0],["ومُنَفِّرٍ للنَّوْمِ مَسْكَنُهُ إِذا","نامَ المُمَلَّكُ بَيْنَ أَثْنَاءِ الثِّيَاب",32,"ب",1,1],["وَمِنْ فَطِنٌ تَذْكِي نَوَافِحُ فِكْرِهِ","فَتُتْحِفُ أَرْوَاحَ الرِّفَاق بِأَرْوَاحِ",33,"ح",1,0],["وَمَنْ فِي الشُّيُوخِ الْمُنْتَدِينَ كَيُوسُفٍ","بِهِ حِلْمُ شَيْخٍ وَهْوَ فِي سِنِّهِ كَهْلُ",34,"ل",1,0],["وَمِنْ فِيكِ يسْمَعُ نَجْوَى الْغُصُونِ","وَيُصْغِي إِلَى هَمْسَةِ الْجَدْوَلِ",35,"ل",1,0],["ومن فتاةٍ فَجْرُها لَيْلُها","ومن غُلامٍ ضَلَّ في فَجْرِه",36,"ر",2,0],["ومن فاته الرغد في يومه","مضى يندب الماضي الأرغدا",37,"د",2,0],["وَمنْ في البسطةِ يَفدي البسيط","ويفدي ذَوُو الجَشعِ القانعيا",38,"ي",2,0],["ومن .. فرحتن ماتمادى.. بين ليله ويوم","ومن ..؟ نكستن ماتفل..؟ الحجه. العاقده ...",39,"د",2,0],["ومَنْ فوقَ الثرى يَص","غُرُ في أجزاءِ منْ وارا",40,"ر",2,0],["ومن فتيات القصر يرقص حولها","على نغمات كلهنّّ عجيب",41,"ب",1,0],["ومن فارقَ الأحبابَ يوماً فإنه","بأسوأ حالٍ بعدهم لحقِيقُ",42,"ق",1,0],["ومن فوقهِ ظُلَلٌ كالغمامِ","ومن تحته جبلٌ مانعُ",43,"ع",1,0],["ومن فِقَر لو أَلَّفَ النظمُ بينها","تحلت صدور درّها ونحور",44,"ر",1,0],["وَمِن فَرحَةٍ قَد قادَها وَمَسَرَّةٍ","وَكَم بُسِطَت مِنهُ لَدى كُلِّ عُسرَةٍ",45,"ه",1,0],["ومن فر قبل الليل ادركه المسا","سواء تباطئ سيره أو تسارعا",46,"ع",2,0],["ومن فوقي وتحتي دجّ عتمٌ","أمامي حيرتي، خلفي قَريني",47,"ن",2,0],["ومَن فارقَ الأوطانَ في طلب الغِنى","فقد نالَ لو حاز الغِنَى أنكدَ الفقر",48,"ر",1,0],["ومن فيكِ تُبعثُ فيهِ الحياة","ويسقمهُ غيرهُ كلُّ فمْ",49,"م",1,0],["ومن فضلها مدت اليك يد الرجا","واحلى الرجا ما كان بالمد والقصر",50,"ر",1,0],["ومن فنون المعاني","رسمتُ وجه الزمان",51,"ن",1,0],["ومن فرعون ما جدوى ثناه","على نهر محاسنه عيوب",52,"ب",1,0],["ومن فعلت قال افعل فعل","وشاع فعل وفعيلا قس تجل",53,"ل",1,0],["ومن فتن الحياة خذي الأغاني","ومن خفقاتها صوغي النشيدا",54,"د",2,0],["ومَن فَرَجَ الغَمّاء عن وجه أحمدٍ","بمكّةَ لمّا رِيع كلُّ جنَان",55,"ن",1,0],["ومِن فم في فم عَذْبٍ مُقَبَّلُه","كأنّ رِيقتَه ضَرْبٌ منَ العسل",56,"ل",1,0],["وَمِنْ فَقْرٍ أَخِي ذُلٍّ","وَمِنْ بُخْلٍ وَمِنْ عَجْزِ",57,"ز",1,0],["وَمِنْ فَدْمٍ أَخِي لُؤْمٍ","وَمِنْ نَزٍّ أَخِي وَفْزِ",57,"ز",1,0],["وَمِنْ فَقْدٍ نَعُدُّ الْبُعْدَ قُرْباً","وَمِنْ بُعْدٍ نَعُدُّ الْفِكْرَ أَيْنَا",58,"ن",2,0],["ومن فضائله ترضي الرضي وللرازي","الأمام كلام فيه مرضي",59,"ي",1,0],["ومن فاغرات الفم ضمن دلاصها","كما افتر في صاف من الورد ورده",60,"د",2,0],["ومن فلوات الأرض درعك فدفدا","يقيني بالنكباء ليست تحده",60,"د",2,0],["ومن فقد الليث الهصور عوضت","به نقداً كفاه خاف الثعالبا",61,"ب",2,0],["ومِن فَرطِ الحِرَانِ ومِن جِمَاحٍ","ومِن ضَعفِ الأسَافِل والأعالي",62,"ل",2,0],["ومِن فَتقٍ بها في البَطنِ ضَخمٍ","ومِن عُقّالها ومِنَ انفِتالِ",62,"ل",1,0],["ومِنفَارٌ تُقدِّمُ كَلَّ سَرجٍ","تُصَيِّرُ دَفَّتَيهِ على القَذالِ",62,"ل",1,0],["ومن فيهِ أو عينيه مبعثُ علمهِ","ومن جبهةٍ وضّاحةٍ مستنيرة",63,"ه",1,0],["ومن فيها وعَينيها ثلاثٌ","لها دُنياكَ تُوشِكُ أن تمورا",64,"ر",2,0],["وَمَن فاهَ بِالنارِ لَم يَحتَرِق","بِها فوهُ يَوماً وَلَم يَخشَ باسا",65,"س",2,0],["ومن فريق لا خلاق لهم","قد أمعنوا في الخلف والمرج",66,"ج",1,0],["ومن فاته معنى مقالة قائل","فقد عاش ميت القلب في شبه حيوان",67,"ن",1,0],["ومن فعله أعلى من القول مفلح","ومن قوله أعلى اقتفى درب حرضان",67,"ن",1,0],["وَمن فلِّ حدِّ الباترات بأبترٍ","وَقصفِ العوالي بالمطاعن عن وربِ",68,"ب",1,0],["وَمِن فَسادِ العُرفِ إِحصاؤُه","وَذِكرُهُ في كُلِّ إِبّانِ",69,"ن",1,0],["ومِن فَرْطِ فَقْرِي واحتِياجَي بَعدَكُمْ","وَبَذْلُ مُحيًّا بِالحَياءِ مُسَتَّرِ",70,"ر",1,1],["وَمِن فَوقِ لِواءِ الحَمدِ","بَينَ الناسِ مَعقودُ",71,"د",1,0],["وَمَن في اِبتِداءِ العُمرِ لَم يَغدُ فاتِحاً","ثُغورَ المَعالي لا يُرامُ لَهُ نَصرُ",72,"ر",1,0],["وَمَن فازَ بَتَطهيرِ","كَ لَن يَصحَبَهُ الغِشُّ",73,"ش",1,0],["وَمِن فَوقي تَرى تَحتي","وَفي تَحتي سَما أَرضي",74,"ي",1,0],["وَمُنفِقٍ إِسرافُهُ","يِزيلُ فَضلَ النَفَقَه",75,"ق",2,0],["وَمِن فَضلِهِ أَرجو بُلوغ مَقاصِدي","وَأَن يخمد الرَحمَن نارَ فُؤادي",76,"ي",1,0],["وَمن فرعه لَمّا لَهُ عقد اللوا","وَددتُ لَو اِنّي تَحتَهُ كُنت أُحشَرُ",77,"ر",1,0],["ومَن في مُلكِه للهِ سِر","لوَ أنَّ صريعَ سُكْرِ هوىً أَفاقا",78,"ق",2,0],["ومن فعالي ونياتي","فإنها كلها أو زار",79,"ر",1,0],["ومن فَتْوَى تُضِلُّ ذَواتِ سِتْرٍ","فيكَسِرْنَ الأساورَ والحُجولا",80,"ل",2,0],["وَمَنْ في جنّةِ الفِردوسِ أضحَى","لديهِ الظلُّ والماء المعينُ",81,"ن",1,0],["ومِن فضْلِ المهيْمن عن قريبٍ","نعودُ لِمثلِ ما كنّا عليهِ",82,"ي",2,1],["ومن فاته منها الدنو فإنه","يولي إليها وجهه حيثما كانا",83,"ن",2,0],["وَمَن فاتَهُ نَيلُ العُلى بِعُلومِهِ","وَأَقلامِهِ فَلَيبغِها بِحُسامِهِ",84,"م",2,0],["وَمِن فَرطِ شَوقي إِلى مُقلتيه","لِقَلبي أَنّي قطعت الحِبالا",85,"ل",2,0],["وَمن فضل ما خُوِّلَت جادَ بِأَوَلٍ","وَيَبقى مِنَ الشَمسِ النُجوم الزَواهِرُ",86,"ر",1,0],["ومن فزعٍ ينزُو لروعتِهِ دَمِي","ومن نَبْأَةٍ يستَكُّ من ذكرِها سمعِي",87,"ع",2,0],["ومن فتاوٍ بها أفتيت في سلم","ويوم حرب وما أرسمته حمقا",88,"ق",2,0],["ومن فاتته أعمال الص","صلاح فذاك مفرود",89,"د",1,0],["ومن فؤادي لهواك رتبةٌ","لا يصِل العشقُ إلى مكانِها",90,"ن",3,0],["ومن فتىً كلُّ قوم وسمُ شهرتهِ","على أسرَّةِ وجه الدهرِ مسطورُ",91,"ر",1,0],["ومن فؤادٍ بَددٍ تلفِظُه","ولائدُ الحيّ مع الحصا البَدَدْ",92,"د",1,0],["ومن فارق الأحباب عوداً وبدأة","وخامرهُ سمٌ من الثكل منقع",93,"ع",1,0],["وَمِن فَس