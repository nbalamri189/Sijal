iewPoem.aspx?id=179705",""],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[45,"أبَرَّ عَلى الألْوَاءِ نَائِلُكَ الغَمْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31285",""],[91,"الكنار الصامت","https://www.poetsgate.com/ViewPoem.aspx?id=53107",""],[46,"لو كنتَ يعقوبَ طيرٍ كنتَ أرشدَ، في","https://www.poetsgate.com/ViewPoem.aspx?id=17976",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[51,"لقد رأينا عَجَباً من العَجَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27036",""],[32,"أبثين إنك قد ملكت فأسجحي","https://www.poetsgate.com/ViewPoem.aspx?id=121",""],[105,"غشيت ديارها من بعد عشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54859&r=&rc=29",""],[105,"ظماء تريد الري من ذا يذودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55048&r=&rc=218",""],[31,"لاَ فَخْرَ إلاَّ قَدْ عَلاَهُ مُحَمَّدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18848&r=&rc=111",""]],"verses":[["وَلَنا قادِمَةُ المَجْدِ إِذا","عَلِقَ المُقْرِفُ مِنْها بِالخَوافي",0,"ي",1,0],["وَلَنا مِنَ الشَّرَفِ الرَّفيعِ يَفاعُهُ","وَاللهُ يَعْلَمُ ذاكَ ثُمَّ النّاسُ",1,"س",1,0],["وَلَنا إِذا العَرَبُ اعْتَزَتْ جُرْثُومَةٌ","خُلِقَ النَّبِيُّ مُحَمَّدٌ مِنْ طِينِها",2,"ن",3,0],["ولن تُقيمَ بهِ نَفْسٌ فتألَفَهُ","إذ ليسَ للعَيْنِ في أقْطارِهِ سَفَرُ",3,"ر",1,0],["ولَنا بمُعتَرَكِ المَنايا أنْفُسٌ","وقَفَتْ بمَدْرَجَةِ القَضاءِ الجاري",4,"ر",2,0],["ولِنْ لهُم وخادِعْهُمْ أوِ اشْدُدْ","على صَفَحاتِهِمْ وَطْئاً ثَقيلا",5,"ل",2,0],["وَلَن تَنتَهوا حَتّى تَكَسَّرَ بَينَنا","رِماحٌ بِأَيدي شُجعَةٍ وَقَوائِمُ",6,"م",1,0],["وَلَن يُبَلِّغها إِلّا عُذافِرَةٌ","فيها عَلى الأَينِ إِرقالٌ وَتَبغيلُ",7,"ل",1,0],["وَلن يَتَعَدّى ما بَلَغتُم بِراكبٍ","زِوَرَّةَ أَسفارٍ تَروحُ وَتَغتَدي",8,"د",2,0],["وَلْنُوَدِّعْ تِلْكَ المَعَاهِدَ تُوْدِيعَ","الضُّيُوفِ الكِرَامِ حِينَ الذَّهَابِ",9,"ب",1,0],["وَلَنْ تَنْسَى لَكَ الأَوْطَا","نَ تِلْكَ المِنَّةَ العُظْمَى",10,"م",2,0],["وَلَنْ يَكُونَ لَهُمْ مِنْ كَسْبِ غَزْوَتِهِمْ","إِلاَّ الشَّقَاءِ وَعَارٌ خَالِدٌ يَصِمُ",11,"م",1,0],["وَلَن تَرى الأَحمَقَ يُبقي عَلى","دينٍ وَلا وُدٍّ وَلا يَتَّقي",12,"ي",1,0],["ولنجعلنْه يوم أفراحنا","نجني به الأنس ونقضي الوطر",13,"ر",1,0],["ولَننهضنّ إلى الهياج بهمّة","شّماء يُبصرها الجبان فيشجع",14,"ع",1,0],["ولنَسعرنّ معامعاً يَصلونها","ورءوسهم فيها لسيفك رُكّع",14,"ع",1,0],["ولَنَرمَينّهم بمعضلة إذا","تُرمى الجبال بمثلها تتصدّع",14,"ع",1,0],["وَلَنا عَلَيكَ إِذا الجُباةُ تَفارَطوا","جابٍ لَهُ مَدَدٌ وَحَوضٌ مُترَعُ",15,"ع",1,0],["وَلَن يَعدَموا في الحَربِ لَيثاً مُجَرَّباً","وَذا نَزَلٍ عِندَ الرَزِيَّةِ باذِلا",16,"ل",2,0],["وَلَن يَكسِبَ الصُعلوكُ حَمداً وَلا غِنىً","إِذا هُوَ لَم يَركَب مِنَ الأَمرِ مُعظَما",17,"م",2,0],["ولن أَخبِّرَ جاري من حليلته","بما تضمنت الأسرار والكللُ",18,"ل",1,1],["ولن أبيت من الأسرار هينمة","على دقارير أحكيها وافتعلُ",18,"ل",1,0],["ولن يُزيحَ همومَ النفس إذ حضَرتْ","حاجات مثلك إلا الرَّحلُ والجَمَلُ",19,"ل",1,1],["ولن تحييك اظْآر معطَّفةً","بالقاع لا تَمَكٌ فيها ولا مَيَلُ",20,"ل",1,1],["ولن يستخير رسوم الديار","لعولته ذو الصبا المعول",21,"ل",1,1],["ولن ينتهي أو يبلغ الأمر حدَّه","فنلها برسل قبل ألا تنالها",22,"ل",3,0],["وَلَن أعزِلَ العبَّاسَ صِنوَ نَبِيِّنَا","وصِنوَانُهُ مِمَّن أَعُدُّ وأندُبُ",23,"ب",1,0],["وَلَن نَرضى بِهَذا فَاِعلَموهُ","مَعاشِرَ أَوسِ ما سُمِعَ الحَنينُ",24,"ن",1,0],["وَلَن تَرى لِهُذَيلٍ داعِياً أَبَداً","يَدعو لِمَكرُمَةٍ عَن مَنزِلِ الحَربِ",25,"ب",1,0],["ولنا بكم هذا الهناء المجتلى","ولكم بنا هذا الثناء المنتقى",26,"ق",2,0],["ولن ترى اللّه ولياً لامرئٍ","عادى أبا الصقر الوزير المُنتَجَبْ",27,"ب",1,0],["ولن يفكَّ القفْل عن كُعْثُبٍ","كرؤية الحسناء مفتاحَهْ",28,"ح",2,0],["ولَنا خَيْرُهُ وذِرْوةُ مَنْجَا","هُ لأَنَّا أضْدَادُ أهل العُنودِ",29,"د",1,0],["ولن تُخبَر الأنثى طوال حياتها","ولكنها بعد المنية تخبر",30,"ر",1,0],["ولن يعوزَ الوهّابَ إخلافُ فارسٍ","فصبراً فإن البَرَّ من يتصبر",30,"ر",1,0],["ولن يُنْكَر المطل لاسيما","لمن ماله الدهرَ مدٌّ وجزر",31,"ر",1,0],["ولن يُخلِفَ الوعدَ امرؤٌ سار قولُهُ","أرى الوعد مثل العهد والخُلفَ كالغدر",32,"ر",1,0],["ولن يُثوِّب شعراً كالعليم به","ولن يقوِّم ثوباً مثلُ سمسار",33,"ر",1,0],["ولن يوقن الشكَّاك ما لم يقم لهم","على السر برهان من الجهر ناصع",34,"ع",1,0],["ولنا إن رددتَ ما تدعيه","ردُّ ما تدّعيه ضيقاً بضيق",35,"ق",1,0],["ولن يزيدَ بَهاءً تاجُ مملكةٍ","حتى يرصِّعَهُ بالجوهرِ الملكُ",36,"ك",1,0],["ولن يُروي الساقي حوائمَ وردِه","إذا لم تكن سقياه عَلّاً على نهلِ",37,"ل",1,0],["ولن أتقاضاه حسبي به","على نفسهِ للمعالي وكيلا",38,"ل",2,0],["ولن يرى المنصفُ المميّزُ مَنْ","عاتب في نبوة كمن شتما",39,"م",2,0],["ولن يَحْلُم اليقظانُ إلا وقد أتتْ","على لُبِّه دهياءُ هائلةُ الفَقَمْ",40,"م",1,0],["ولنْ أتعدَّى الحقَّ في كُلِّ حالةٍ","وإنْ سنَحَتْ فيه ومنْهُ الأشائمُ",41,"م",1,0],["ولن يذهب الدهرُ حتى تُرى","سليمانُها كسليمانها",42,"ن",3,0],["ولن ترانيَ إلا حاملاً قَدَحاً","وشارباً وعليهِ منهُ سكرانا",43,"ن",2,0],["وَلَن يُرجِعَ القَتلُ مَن قُتِّلوا","وَلَن يَستَعيدَ الَّذي ضَيَّعوا",44,"ع",3,0],["وَلنَستَعِض عَنهُ بِطَيرٍ","مِن لُجَينٍ أَي نُضار",45,"ر",1,0],["وَلَنا ساقٍ رَشيقٌ","أَحوَرُ الطَرفِ أَحَمُّه",46,"م",2,0],["وَلَنا طاهٍ نَظيفٌ","وَظَريفٌ وَخَبيرُ",47,"ر",1,0],["وَلَن يُدرِكَ الحاجاتِ حَتّى يَنالَها","إِلى اِبنِ أَبي سُفيانَ إِلّا مُخاطِرُ",48,"ر",1,0],["ولنتمل قبل ان","نردى الحياة الحاضره",49,"ر",2,0],["ولنكسب الدنيا وربي","غافر في الآخره",49,"ر",2,0],["ولنغتنم هذه الساعات سانحة","فانني بصفاء الدهر لا اثق",50,"ق",1,0],["ولنا في جميع ذ","لك بالله معتصم",51,"م",1,0],["ولنغتبط بالفن ان","ن حياتنا هذي قصيره",52,"ر",2,0],["ولنشرى بالمروءات الخنا","ولنزني والزنا شئ مهين",53,"ن",1,0],["وَلنَجعَل مِصرَ هِيَ الدُنيا","وَلنَجعَل مِصرَ هِيَ الدُنيا",54,"ا",1,0],["وَلِنارِ العَدُوِّ فيكُم قُعودٌ","وَلِسَيفِ العَدُوِّ فيكُم قِيامُ",55,"م",1,0],["وَلَن تَزالَ مِن يَدٍ","إِلى يَدٍ هَذي الكُرَه",56,"ر",2,0],["وَلَنا وَلاهُ الشَهدَ لا ال","خَلَّ الَّذي تَصِفُ الرِوايَه",57,"ا",3,0],["وَلَن تَرتَضي أَن تُقَدَّ القَناةُ","وَيُبتَرَ مِن مِصرَ سودانُها",58,"ن",3,0],["وَلَن تَرى صُحبَةً تُرضى عَواقِبُها","كَالحَقِّ وَالصَبرِ في أَمرٍ إِذا اِصطَحَبا",59,"ب",2,0],["وَلَنا القَولُ وَهوَ أَدرى بِفَحوا","هُ وَأَهدى فيهِ إِلى الإِعجازِ",60,"ز",1,0],["وَلَنا عادَةُ الجَميلِ مِنَ الصَب","رِ لَوَ أَنّا سِوى نَواكَ نُسامُ",61,"م",1,0],["وَلَنا مَجلِسٌ عَلى النَهرِ فَيّا","حٌ فَسيحٌ تَرتاحُ فيهِ القُلوبُ",62,"ب",1,0],["وَلَن تُعينَ اِمرَأً يَوماً وَسائِلُهُ","إِن لَم تُعِنهُ عَلى حُرٍّ ضَرائِبُهُ",63,"ب",2,0],["وَلَن تَرى مِثلَ كِنزِ المَجدِ مُكتَسَباً","يَرعاهُ صَوناً مِنَ الإِنفاقِ كاسِبُهُ",63,"ب",2,0],["وَلَن تَفوتَ المُغالي في المَديحِ بِهِ","حَتّى أَفوتَ عَلَيهِ مَن أُواكِبُهُ",63,"ب",2,0],["وَلَن يُرتَجى في مالِكٍ غَيرِ مُسجِحٍ","فَلاحٌ وَلا في قادِرٍ غَيرِ صافِحِ",64,"ح",1,0],["وَلَنا بِعَبدِ اللَهِ بَح","رٌ مُعرِضٌ لِلناسِ وِردُه",65,"د",2,0],["وَلَن تَستَبينَ الدَهرَ مَوضِعَ نِعمَةٍ","إِذا أَنتَ لَم تُدلَل عَلَيها بِحاسِدِ",66,"د",1,0],["وَلَن يَعدَموا حُسناً إِذا كُنتَ فيهِمِ","وَكانَ لَهُم جارَينِ جودُكَ وَالبَحرُ",67,"ر",1,0],["وَلَن تَعتادَني أَشكو مُقاماً","عَلى مَضَضٍ وَفي يَدِيَ اِنطِلاقي",68,"ي",1,0],["وَلَن يَنقُلَ الحُسّادُ مَجدَكَ بَعدَ ما","تَمَكَّنَ رَضوى وَاِطمَأَنَّ مُتالِعُ",69,"ع",1,0],["وَلَن تَحضُرَ الجَرعاءَ تَرعى ثُمامَها","وَلا تَرتَعي بِالدَوِّ مِن خَرِباتِ",70,"ت",1,0],["وَلَن يَزالَ إِمامٌ مِنهُمُ مَلِكٌ","إِلَيهِ يَشخَصُ فَوقَ المِنبَرِ البَصَرُ",71,"ر",1,0],["وَلَن تُنكِروا شِعري إِذا خَرَجَت لَهُ","سَوابِقُ لَو يُرمى بِها لَتَفَقَّرا",72,"ر",2,0],["وَلنا قُراسِيَةٌ تَظَلُّ خَواضِعاً","مِنهُ مَخافَتَهُ القُرومُ البُزَّلُ",73,"ل",1,1],["وَلَنا مَعاقِلُ كُلَّ أَعيَطَ باذِخٍ","صَعبٍ وَكُلُّ مَباءَةٍ مِحلالِ",74,"ل",1,0],["ولنا راحٌ خِلالَ الشْ","رْبِ لا راحُ العَصيرِ",75,"ر",1,0],["ولن يرهَبَ السَّيفَ حتى يَرى","على صفحةِ السيفِ ماءً ونارا",76,"ر",2,0],["ولن يرى البُعدَ قرباً وهو طالبُه","ويحسِبَ الحَزْنَ سَهلاً وهو راكبُه",77,"ب",2,0],["وَلَنِعمَ حَشوُ الدِرعِ أَنتَ لَنا إِذا","نَهِلَت مِنَ العَلَقِ الرِماحُ وَعَلَّتِ",78,"ت",1,0],["وَلَنِعمَ حَشوُ الدِرعِ أَنتَ إِذا","دُعِيَت نَزالِ وَلُجَّ في الذُعرِ",79,"ر",1,0],["وَلِنَفسي غَفَلاتٌ لَم تَزَل","وَلَها بِالشَيءِ أَحياناً وَلَع",80,"ع",1,0],["وَلِنَفسي حينَ تُعطى فَرَحٌ","وَاضطِرابٌ عِندَ مَنعٍ وَجَزَع",80,"ع",1,0],["وَلَن يَبقى لِأَهلِ الأَر","ضِ لا عِزٌّ وَلا شَرَفُ",81,"ف",1,0],["وَلَن يَستَتِمَّ الصَبرَ مَن لا يَرُبُّهُ","وَلَن يَعرِفَ الأَحزانَ مَن لا يَذوقُها",82,"ق",3,0],["وَلَن تَسرِيَ الذِكرى بِما هُوهَ أَهلُهُ","إِذا كُنتَ لِلبِرِّ المُطَهِّرِ ناسيّا",83,"ي",2,0],["وَلَنا بِها وَالشَمسُ في أَسَدٍ","قَيظاً فَخِلنا بُرجَها الحَمَلا",84,"ل",2,0],["وَلَن يُنكِرَ الناسُ إِن زُرتَني","لِسَعيِ فَقيهٍ إِلى كاتِبِ",85,"ب",1,0],["ولن ترى في الوجود مَن","يدري عذاب الذي تلاه",86,"ه",1,0],["ولنا من فَضْلِ مَذاهِبِهِ","آمالٌ نَبْلُغُها ومُنى",87,"ن",2,0],["وَلَن يخدعوا في الحربِ وهوَ مُبيدُهُم","فتىً كان مولوداً مِنَ الحربِ في حِجْرِ",88,"ر",1,0],["وَلَنِعمَ دِرعا الحَيِّ في يَومَيهِما","كانا وَنِعمَ الذُخرِ كانا لِلغَدِ",89,"د",1,0],["وَلَنْ يَلْبَثَ الْمَرْءُ الضَّنِينُ بِمَالِهِ","إِذَا خَافَ غُرْمَاً أَنْ يُعَدَّ لَئِيمَا",90,"م",2,0],["ولنغمةِ الناقوسِ فيهِ غُنَّةٌ","وعليهِ منْ دونِ الهمومِ ستورُ",91,"ر",1,0],["وَلَن أَنسى بِخَيفِ مِنىً","تَسارُقَ زَينَبَ النَظَرا",92,"ر",2,0],["وَلَنا دَعائِمُ قَد تَناهى أُوَّلٌ","في المَكرُماتِ جَرى عَلَيها المَولِدُ",93,"د",1,0],["وَلَن يَلبَثَ الواشونَ أَن يَصدَعوا العَصا","إِذا لَم يَكُن صُلباً عَلى البَريِ عودُها",94,"د",3,0],["ولن يَستطيعَ الشّعبُ مَجداً ورفعةً","إذا نامَ بانيهِ وعَرْبَد صائِحُهْ",95,"ح",2,0],["ولن يُخطِئَ الشّعبُ السَبيلَ إلى العُلا","سبيلُكَ هاديهِ ورأيُكَ ناصِحُهْ",95,"ح",2,0],["ولَنا بينَ العَوالي والظُّبَى","نَسَبٌ في البأسِ وَضّاحُ الأَثَرْ",96,"ر",1,0],["ولن تُدرِكَ الأقوامُ معنى حياتِها","إذا رُزِئَتْ بالأجنبيِّ يسودها",97,"د",3,0],["ولن ترضى الجلالةُ عن أناسٍ","تراهم في الضّلالةِ سادرينا",98,"ن",2,0],["ولن تلِدَ الحياةُ الخُلْدَ إلا","لِمَنْ وُلِدُوا نوابِغَ نابهينا",98,"ن",2,0],["ولنا بمصرَ من الحُقوقِ ومثلِها","ما ليس للنُّظراءِ والأمثالِ",99,"ل",1,0],["وَلَن يَنالَ مَصونَ المَجدِ طالِبُهُ","إِلّا بِغالٍ مِنَ الأَعلاقِ مَبذولِ",100,"ل",1,0],["وَلَن تُستَباحَ حُقوقُ البِلادِ","إِذا اِستَودَعَتها نُفوسُ الأُباةِ",101,"ه",1,0],["وَلَن تَرى ماكِراً يُخفي سَريرَتَهُ","يَبغي النَكيثَةَ إِلّا سَوفَ يُبديها",102,"ي",3,0],["وَلَن يَقضِيَ الإِنسانُ حَقَّ بِلادِهِ","إِذا هُوَ لَم يَبذُل لَها النَفسَ فادِيا",103,"ي",2,0],["وَلَن تحظى بِعَيشٍ مِنهُ حُلوٍ","إِذا ما كانَ طعمُك غيرَ مُرِّ",104,"ر",1,0],["وَلَن تُقيمَ يَدُ الباني وَإِن جَهَدَت","دُنيا الشُعوبِ وَرُكنُ الدينِ مَهدودُ",105,"د",1,0],["ولن تَستبينَ سَبيلُ الهُدَى","إذا اتَّبعَ النَّاسُ ضُلَّالها",106,"ل",3,0],["وَلنعلِّ الوَطن","فَلنِعمَ الوَطن",107,"ن",1,0],["وَلنُعَلِّ الهتاف","للأَمير البَطَل",108,"ل",1,0],["وَلنودِّع تِلكَ الهُمومَ اللَواتي","يتوثّبنَ في الدُجى أَشباحا",109,"ح",2,0],["ولننحرن في دار كل إقامة","عشراً ونطعمُ ذا العيالِ العائلا",110,"ل",2,0],["وَلَن يَفعَلوا حَتّى تَشولَ عَلَيهِمُ","بِفُرسانِها شَولَ المَخاضِ اِقمَطَرَّتِ",111,"ت",1,0],["وَلَنِعمَ الفَتى إِذا اِحتُضِرَ البا","سُ وَكانَت دَعوى الكُماةِ نَزالِ",112,"ل",1,0],["وَلَنا ما أَضاءَ صُبحٌ عَلَيهِ","وَأَتَتهُ آياتُ لَيلٍ سودُ",113,"د",1,0],["ولَنْ تُدْرِكُوا بالجَهْلِ رُشْداً وَإِنما","يُفَرِّقُ بَينَ الزَّيْفِ وَالجَيِّد النَّقْدُ",114,"د",1,0],["ولَنْ يضِيرَ أُولي التَّقْوَى اختلافُهُم","وهم على فِطْرَةِ الإسلامِ قد فُطِرُوا",115,"ر",3,0],["ولَنْ تَرَى مِنْ وَلِيٍّ غَيْرَ مُنْتَصِرِ","بهِ ولا مِنْ عَدُوٍّ غيْرَ مُنْقَصِمِ",116,"م",1,0],["وَلَنء يَفُوتَ الغِنَى مِنْهُ يَداً تَرِبَتْ","إنَّ الحَيا يُنْبِتُ الأزهارَ في الأُكَمِ",116,"م",1,0],["وَلَنْ يَضِيقَ رَسولَ اللهِ جاهُكَ بي","إذا الكريمُ تَحَلَّى باسْمِ مُنْتَقِمِ",116,"م",1,0],["ولَنِعْمَ مَغنى اللهوِ تَرأمُ ظِلَّه","آرامُ وَجْرَةَ رُحْنَ أو أُدْمانها",117,"ن",3,0],["وَلَن كانَ اِبنُ عَجلانٍ","مِنَ البَلوى كَما ذُكِرا",118,"ر",2,0],["وَلِنافِعٍ فَضلٌ عَلى أَكفائِهِ","إِنَّ الكَريمَ أَحَقُّ بِالتَفضيلِ",119,"ل",1,1],["وَلَنِعمَ جَندَلَةُ الرَدى","في مَأقِطٍ كَالسَيفِ عانِد",120,"د",1,0],["وَلَن يَقومَ مَسيحٌ يُجمَعونَ لَهُ","وَخِلتَ واعِدَهُم مِنَ الخُلفِ عُرقوبا",121,"ب",2,0],["وَلَن تَصيبوا مِنَ الدُنيا سِوى صَبَرٍ","حَتّى تَكونوا عَلى أَحداثِها صُبُرا",122,"ر",2,0],["وَلَن تَلقى كَفِعلِ الخَيرِ فِعلاً","وَلا مِثلَ المَثوَبَةِ رَبحَ تَجرِ",123,"ر",1,0],["وَلَن يُصيبَ خُفاقاً مَن يُقايِضُهُ","يَوماً بِنُدبَةَ لَمّا فاتَها الشَرَفُ",124,"ف",1,0],["وَلَن يَزالوا بِشَرٍّ في زَمانِهِمُ","ما دامَ فَوقَهُمُ المِرّيخُ أَو زُحَلُ",125,"ل",1,0],["وَلَن يُجمِعَ الناسُ الَّذينَ رَأَيتُهُم","عَلى الحَمدِ لَكِن يُجمِعونَ عَلى الذَمِّ",126,"م",1,0],["ولِنارِ المِرّيخِ مِن حَدَثانِ الدّهْ","رِ مُطْفٍ وَإنْ عَلَتْ في اتّقادِ",127,"د",1,0],["وَلَنِعمَ مَأوى المُستَضيفِ إِذا دَعا","وَالخَيلُ خارِجَةٌ مِنَ القَسطالِ",128,"ل",1,0],["وَلَنِعمَ أَيسارُ الجَزورِ إِذا زَهَت","ريحُ الشِتاءِ وَمَألَفُ الجِيرانِ",129,"ن",1,0],["وَلَنا دارٌ وَرِثنا عِزَّها ال","أَقدَمَ القُدموسَ عَن عَمٍّ وَخالِ",130,"ل",1,0],["ولنا بخَيْفِ مِنىً عُرَيْبٌ دونَهُمْ","حَتْفُ المُنى عادي لِصَبّ عاذا",131,"ذ",2,0],["ولِنَفْسِي غيرَها إن سَكِنَتْ","يا خَلِيلَيَّ سلاَها ما سلاها",132,"ا",3,0],["ولنا بالشِّعبِ شَعْبٌ جَلَدي","بَعْدَهُمْ خان وصبري كاءَ كَي",133,"ي",1,0],["وَلننتظر يومين بعد فربما","تأتي لنا بحديثه الأصحاب",134,"ب",1,0],["ولنسارعْ فنقتفي إثرَ ساعا","تٍ فقد تؤذنُ النوى بالتقضِّي",135,"ي",1,0],["وَلَنَحْنُ أَوْثَقُ في صُدُورِ نِسائِكُمْ","مِنْكُمْ إذا بَكَرَ الصُّراخُ بُكُورا",136,"ر",2,0],["ولنْ يُحْوَى الثّناء بغير جودٍ","وهل تُجنى من اليَبَسِ الثّمارُ",137,"ر",1,0],["ولن نرتضي أن تقدَّ القناة","ويُبتَرُ من مصر سودانها",138,"ن",3,0],["ولَنَا مَجدٌ ورَبٌّ مُفِضَلٌ","بِيَدَيهِ الَخيرُ ما شاءَ أَمَر",139,"ر",1,0],["ولَن أَذكُرَ النُّعمانَ إلاَّ بِصالِحٍ","فأَنَّ لَهُ عِندي يديّا وأَنعما",140,"م",2,1],["وَلْنَبْكِ مَنْ مَاتُوا وَمَا","مِنْهُمْ جَبَانٌ مُنْهَزِمْ",141,"م",1,0],["وَلْنَرْثِ لِلضُّعَفَاءِ يُفْ","نِيهِمْ قَوِيٌّ مُغْتَشِمْ",141,"م",1,0],["وَلَنْ تُوَفُّوهُ حَقَّاً مِنْ مَوَاجِبِهِ","لَو جُزْتُمُ الْحَدَّ تَزيِيناً وَتَشْييدا",142,"د",2,0],["وَلَنْ تَنْظِمَ الآرَاءَ نَظْمَ مُوَفِّقٍ","وَلَنْ تَنْثُرَ الآلاَءَ نَثْرَ مُفَرِّقِ",143,"ق",1,0],["وَلَنْ تُعْمِلَ الأَقْلاَمَ وَهْيَ أَسِنَّةٌ","فَتَطْعَنَ أَهْلَ الْبَغْي فِي كُلِّ مَفْرِقِ",143,"ق",1,0],["ولْنَمْضِ فِي أَفْرَاحِ نَهْضَتِنَا","وَلْنَقْضِ أَيَّاماً كَأَعْيَادِ",144,"د",1,0],["وَلَنا مَوعِدٌ إِذا هَدَأَ النُو","وامُ لَيلاً وَاللَيلُ مِنّا قَريبُ",145,"ب",1,0],["ولنفسي مُنى الشبابِ وإن أد","رج وجهي الشبابَ في أغصانه",146,"ن",2,0],["ولنعم الفتى ياتوب كنت إذا التقت","صدور العالي واستشال الأسافلُ",147,"ل",1,1],["ولن يَحملَ القيدَ حرٌّ أبيٌّ","ولن يلبسَ الطَّوقَ شَعبٌ أشَم",148,"م",1,0],["ولن تسلمَ الأرضُ حتى تصير","جحيمًا على الغاصبين اضْطَرَمْ",148,"م",1,0],["ولنا أسوةٌ بشعبٍ عريقٍ","هو في الخلق مضرب الأمثال",149,"ل",1,0],["ولنْ ينفَعَ القومَ إِيمانُهُم","إذا كان إِيمانُهُم أبْتَرا",150,"ر",2,0],["ولنَدْخُلُنَّ محلِّق","ينَ رءوسَنا، ومُقصِّرين",151,"ن",1,0],["ولنحْمِلنَّ لكلِّ من","واساهم الحقد الدَّفين",151,"ن",1,0],["ولنْ يَبقَى على الأيام مُلْكٌ","دمُ الأحْرارِ فيه يُستباحُ",152,"ح",1,0],["ولن يُرجَى لشعبٍ بات فيه","ولاةُ الأمر تُجَّارًا فلاحُ",152,"ح",1,0],["ولن يُرجَى بالدُّستور شَعبٌ","فَسَل عنه: أجدٌّ أم مُزاحُ؟",152,"ح",1,0],["ولن تأمنُوا شرَّهَ الجائعينَ","إذا السُّخطُ حلَّ محلَّ الرضاء",153,"ا",2,0],["ولنا أن نموت كيف أردنا","إنما من يميت فينا الحنينا؟",154,"ن",2,0],["ولَن تَرى مِن وَلِيٍّ غيرَ منتَصِرٍ","بِهِ ولا مِن عَدُوٍّ غيرَ مُنعَجِمِ",155,"م",1,0],["ولَن يَفُوتَ الغِنَى منه يَدَاً تَرِبَتْ","اِنَّ الحَيَا يُنْبِتُ الأزهارَ في الأَكَمِ",155,"م",1,0],["ولَن يَضِيقَ رسولَ اللهِ جاهُكَ بي","اذا الكريمُ تَجَلَّى باسمِ مُنتَقِمِ",155,"م",1,0],["ولْنُوِّجْههُ قبْلةً لا يلقّى","عندها غيرَ حاقدٍ أو مخاصم",156,"م",1,0],["ولْنُثرْهُ ليملأ الكونَ عُنفاً","نفسٌ يُلهبُ المشاعر جاحم",156,"م",1,0],["ولن تَجدي كإيانا نصيراً","يَدُقُّ من الأسى راحاً براح",157,"ح",1,0],["وَلَنْ يَعدَمُوا حَسناً، إذا كنتَ فيهمِ،","وَكانَ لَهُمْ جادينِ: جُودُكَ وَالبحرُ",158,"ر",1,0],["ولنستعض عنه بطير","من لجين أو نضار",159,"ر",1,0],["ولن يقومَ مسيحٌ يُجمَعونَ لهُ،","وخلتَ واعدَهم مِ الخُلفِ عُرقوبا",160,"ب",2,0],["ولنا موعد على جبل الشيخ","كم الثلج دافئ.. وحنونُ",161,"ن",1,0],["ولن ترى اللَّه ولياً لامرىء ٍ","عادى أبا الصقر الوزير المُنتَجَبْ",162,"ب",1,0],["ولن ألفتك أو وصلت حبالكم","لعلى المودّة من ضمير الواصل",163,"ل",1,0],["ولن تحضى بعيشٍ منه حلوٍ","إذا ما كان طعمك غير مر",164,"ر",1,0],["ولن تدرك القوام معنى حياتها","إذا رزئت بالأجنبي يسودها",165,"د",3,0],["ولنا دعائمُ قد تناهى أولٌ،","في المكرماتِ، جرى عليها الموالدُ",166,"د",1,0]]}