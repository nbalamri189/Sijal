{"poems":[[110,"بأيكما أبكي","https://www.shoaraa.com/p12758",""],[55,"أيا جبلي نجد أبينا سقيتما","https://www.aldiwan.net/poem29656.html","الطويل"],[55,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[95,"أمر الأمير لما أحب دعاني","https://www.aldiwan.net/poem11259.html","الكامل"],[29,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[49,"أما إنه ربع الصبا ومعالمه","https://www.aldiwan.net/poem25132.html","الطويل"],[49,"أقول وقد ناحت بقربي حمامة","https://www.aldiwan.net/poem25173.html","الطويل"],[49,"لمن جاهد الحساد أجر المجاهد","https://www.aldiwan.net/poem25321.html","الطويل"],[74,"أيا جنة الحسن التي قد تبرجت","https://www.aldiwan.net/poem19004.html","الطويل"],[74,"أخا اللوم لا تتعب لسانا ولا ذهنا","https://www.aldiwan.net/poem20176.html","الطويل"],[93,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[60,"قصر الجديد إلى بلى","https://www.aldiwan.net/poem30968.html","مجزوء الكامل"],[51,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[51,"أيا جامعي الدنيا لمن تجمعونها","https://www.aldiwan.net/poem63172.html","الطويل"],[82,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[35,"أيا جبل الدوم الذي في ظلاله","https://www.aldiwan.net/poem25777.html","الطويل"],[35,"ألا حبذا يوم يقر به الصبا","https://www.aldiwan.net/poem25810.html","الطويل"],[35,"أيا جبلي نعمان بالله خليا","https://www.aldiwan.net/poem25811.html","الطويل"],[83,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[54,"أدام المهيمن عز الوزير","https://www.aldiwan.net/poem26627.html","المتقارب"],[48,"أيا جسدي لا تجزعن من البلى","https://www.aldiwan.net/poem22224.html","الطويل"],[48,"تشاور بكرك في نفسها","https://www.aldiwan.net/poem22363.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16657","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[136,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[151,"أيا جهبذا دقت معاني رموزه","https://www.aldiwan.net/poem47647.html","الطويل"],[218,"أيا جبلي نعمان بالله خليا","https://www.aldiwan.net/poem517.html",""],[228,"أيا جرسا في هوة الدمع ناحبا","https://www.aldiwan.net/poem41638.html","الطويل"],[240,"وحلوة الريق باتت","https://www.aldiwan.net/poem31805.html","المجتث"],[292,"أيا جلندى يا ابن مستكير","https://www.aldiwan.net/poem1895.html","الرجز"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[333,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[354,"أيا جيرة بلوى الأبرقين","https://www.aldiwan.net/poem15961.html","المتقارب"],[358,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[369,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[369,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[382,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[385,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[411,"أيا جامع المال من حله","https://www.aldiwan.net/poem49768.html","المتقارب"],[443,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[463,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[463,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[482,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[500,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[500,"أيا جامع المال من حله","https://www.aldiwan.net/poem10268.html","المتقارب"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107262","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39025","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[934,"","https://poetry.dctabudhabi.ae/diwan/poem/27016","الطويل"],[990,"","https://poetry.dctabudhabi.ae/diwan/poem/202376","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119066","الوافر"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80237","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80242","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133828","الوافر"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126586","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107308","الطويل"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203765","المتقارب"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102059","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26472","المتقارب"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121878","الطويل"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116655","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87735","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130010","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94151","المتقارب"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118796","الطويل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28306","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28889","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138599",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3758,"","https://poetry.dctabudhabi.ae/diwan/poem/143436","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86494","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73293","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73269","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139642",""],[4699,"عين مها","https://www.poetsgate.com/ViewPoem.aspx?id=153934",""],[4726,"ايا جسر اهل الله يا مركز السعد","https://www.poetsgate.com/ViewPoem.aspx?id=146655",""],[5038,"جرح العراق","https://www.poetsgate.com/ViewPoem.aspx?id=190136",""],[5053,"أيا جيل التصوف شر جيل","https://www.poetsgate.com/ViewPoem.aspx?id=181577",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5431,"سلامٌ به الحب الكريم مقدرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188856",""],[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5536,"إمرأة من تمثال..!!","https://www.poetsgate.com/ViewPoem.aspx?id=19892",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5842,"إلى جيش الغطاريف .. الجيش السوري","https://www.poetsgate.com/ViewPoem.aspx?id=68315",""],[6152,"ذكرتكِ في الهدا","https://www.poetsgate.com/ViewPoem.aspx?id=203177",""],[6152,"جدتي الغالية رحمها الله","https://www.poetsgate.com/ViewPoem.aspx?id=203759",""],[5309,"أيا جارتا نادي الهوى كان نادينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573874",""]],"verses":[["أيا جامع الأضداد والشرّد التي","محال مثانيها بنفسٍ توارد",0,"د",1,0],["أَيا جَبَلَي نَجدٍ أَبينا سُقيتُما","مَتى زالَتِ الأَظعانُ يا جَبَلانِ",1,"ن",1,1],["أَيا جَدَثاً وارى مِنَ العِزِّ هَضبَةً","تَمُدُّ إِلى العَليا بِبوعٍ وَأَذرُعِ",2,"ع",1,0],["أَيُّ اجْتِمَاعٍ كَاجْتِمَاعِ بَنِي أَبٍ","دَالَ الهَوَى فِيهِمْ مِنَ الشَّنْآنِ",3,"ن",1,0],["أَيا جَنبُ قَد كانَت تَميمَةُ حُرَّةً","وَلَكِنَّها بِئسَ القَرينُ قَرينُها",4,"ن",3,0],["أَيا جافِياً ماكُنتُ أَخشى جَفاءَهُ","وَإِن كَثُرَت عُذّالُهُ وَلَوائِمُه",5,"م",2,0],["أَيا جارَتا ما أَنصَفَ الدَهرُ بَينَنا","تَعالَي أُقاسِمكِ الهُمومَ تَعالَي",6,"ل",2,0],["أَيا جاهِداً في نَيلِ مانِلتُ مِن عُلاً","رُوَيدَكَ إِنّي نِلتُها غَيرَ جاهِدِ",7,"د",1,0],["أيا جنة الحسن التي قد تبرجت","متى أنا بالوصل المؤمل فائز",8,"ز",1,1],["أيا جائداً بالتبرِ في حالِ عسرةٍ","لنا لم نكد من طرفها نجد التّبنا",9,"ن",2,0],["أَيا جَبَلَ العِلمِ الَّذي مادَ هاوِياً","عَزيزٌ عَلَينا أَن تُرى في الحَفائِرِ",10,"ر",1,0],["أَيُّ اِجتِماعٍ لَم يَصِر","لِتَشتُّتٍ مِنهُ اِجتِماعُهُ",11,"ع",2,0],["أَيا جامِعَ الدُنيا سَتَكفيكَ جَمعَها","وَيا بانِيَ الدُنيا سَيَخرَبُ ما تَبني",12,"ن",2,0],["أَيا جامِعي الدُنيا لِمَن تَجمَعونَها","وَتَبنونَ فيها الدورَ لا تَسكُنونَها",13,"ن",3,1],["أيا جَزَعي بالدارِ إذ عَنَّ لي الجزعُ","وقاد حِمامي من حمائمِهِ السّجْعُ",14,"ع",1,1],["أَيا جَبَلَ الدومِ الَّذي في ظِلالِهِ","غَزالانِ مَكحولانِ مُؤتَلِفانِ",15,"ن",1,1],["أَيا جَبَلَي نَعمانَ بِاللَهِ خَلِّيا","نَسيمَ الصَبا يَخلُص إِلَيَّ نَسيمُها",16,"م",3,0],["أَيا جَبَلَي نَعمانَ بِاللَهِ خَلِّيا","سَبيلَ الصَبا يَخلُص إِلَيَّ نَسيمُها",17,"م",3,1],["أَيا جَنَّةً حَلَّت لَظىً مِن جَوانِحي","أَطَيَّ ضُلوعي جَنَّةٌ وَهوَ يُحرَقُ",18,"ق",1,0],["أَيا جابِرَ المُلكِ مِن كَسرِهِ","وَيا مُظهِرَ الحَقِّ حَتّى اِستَبانا",19,"ن",2,0],["أَيا جَسَدي لا تَجزَعَنَّ مِنَ البِلى","إِذا صِرتَ في الغَبراءِ تُحثى وَتُنبِثُ",20,"ث",1,1],["أَيا جَسَدَ المَرءِ ماذا دَهاكَ","وَقَد كُنتَ مِن عُنصُرٍ طَيّبِ",21,"ب",1,0],["أيا جَاَرَة البيْتِ المُمَنّعِ جارُهُ","غَدَوْتُ ومَنْ لي عندكُمْ بمَقِيل",22,"ل",1,0],["أَيا جَبَلَ الثَلجِ الَّذي في ظِلالِهِ","غَزالانِ مَكحولانِ مُؤتَلِفانِ",23,"ن",1,1],["أيَا جُملُ لَو تَدرِينَ مَا بي وَفَيتِ لِى","ولَم يَكُ في وَعدٍ وَعَدتِ بِهِ مَطلُ",24,"ل",1,0],["أيا جهبذاً دقّت معاني رموزه","ورقت فلم يدرك لها ذو الحجا سرّا",25,"ر",2,1],["أَيا جَبَلَي وادي عُريعِرَةَ الَّتي","نَأَت عَن نَوى قَومي وَحُقَّ قُدومُها",26,"م",3,0],["أَيا جَرساً في هُوَّةِ الدَمعِ ناحِباً","نحيبُك أَلحانُ الطَبيعَةِ وَالعُمرِ",27,"ر",1,1],["أَيَّ اِجتِماعٍ قَضَينا","عَليهِ بِالتَفريقِ",28,"ق",1,0],["أَيا جُلَندى يا اِبنَ مُستَكيرِ","يا خَيرَ مَن يَمشي مِنَ الذُكورِ",29,"ر",1,1],["أيا جيرةً جاروا عليَّ بذلّةٍ","إِليّ منهم أستنيم إلى حبِّ",30,"ب",1,0],["أيا جاري سألقى خالق ال","جنة والنار",31,"ر",1,0],["أَيا جيرَةً بِلَوى الأَبرَقَينِ","دَنا بِاِنتِزاحِكُم حينُ حَيني",32,"ن",2,1],["أَيا جيرةً جارَ الزَمان بِبعدهم","عَلى بغيهِ لَم يَخش لِلبَغي مصرعا",33,"ع",2,0],["أيا جامعاً عفْواً وسيعاً ظِلالُه","وعَضْباً صَنيعاً مِصْدَعَ الهام مِصْدَغا",34,"غ",2,0],["أيا جاعِلاً في الدّهرِ للدّينِ نَصْرَه","وللخَلْقِ نُعْماه وللفَضْلِ وُدّه",35,"د",2,0],["أيا جبلي لبنان مني إليكما","سلامٌ بطيب ثناكما يتأرج",36,"ج",1,0],["أَيا جسميَ البالي تَجَسَمت مِن ضَناً","وَيا كَيدي الحَرا تَكونتِ مِن جَمر",37,"ر",1,0],["أيا جامِعَ المالِ مِن حَلِّهِ","تَبيتُ وتُصبِحُ في ظِلِّهِ",38,"ه",1,1],["أيا جائداً في دسّته البحر مفعم","ويا ماجداً تلقاه في السرج قسورا",39,"ر",2,0],["أيا جامعاً فِرقَ الخافقيْن","أوانسَ كنَّ شِماساً مَلالا",40,"ل",2,0],["أيا جابر المنهاض لم يبق مفصِلٌ","وإلا ندوبٌ تحته ولواذعُ",41,"ع",1,0],["أيا جيرةَ الخَيْفِ مذ بنتُمُ","لقد جدَّ هجرُكُم المازحُ",42,"ح",1,0],["أيا جابر العظم المهيض لقاؤه","ولا يُجبر العظمُ الذي هو كاسره",43,"ر",2,0],["أيا جامع المال من حله","يبيت ويصبح في ظله",44,"ه",1,1],["أَيَا جُلَسَاءَ اللَّهِ في حَضرَةِ الرِّضا","علامَ المُصَلِّي بالتَّحِيَّاتِ يختِمُ",45,"م",1,1],["أيا جَنَّةً مِن رِيقها كوْثرٌ لَها","تُرى مَشْرقي في الحُبِّ مِنْك مُقَرّبي",46,"ب",2,0],["أيا جد لي حزن عليكم مجدد","ونار اسى تحت الضلوع تضرم",47,"م",1,0],["أَيا جُملُ لا تَشقَي بِأَقعَسَ حَنكَلٍ","قَليلُ النَدى يَسعى بِكيرِ وَمِحلَبُ",48,"ب",1,1],["أيا جسدي العوّاق لي عن مآربي","عدمتك بِنْ ما أنت من قرنائي",49,"ا",3,1],["أيا جمع الأنام بلا شبه","ويا فرد الكرام بلا مجاري",50,"ر",2,0],["أيأجوج اذا نحن التقينا","وأيام التهاجر أنت عوجُ",51,"ج",1,0],["أَيا جسم لُطفٍ بِالوَقارِ قَد اِكتَسى","وَيا هام مَجدٍ بِالفَخارِ تَكَللا",52,"ل",2,0],["أَيا جودَةَ العَصرِ الَّذي جادَ لِلمَلا","مَليكُ العُلى فيهِ فباهَت بِلادُهُ",53,"د",2,0],["أيا جرحاً بجنب الأرز رفقاً","بجنب الطيب سيلك والطلال",54,"ل",1,0],["ايا جارة الحي الذين ترحلوا","فللعيس وخد بالحمول وإعناق",55,"ق",1,0],["أَيا جنَّةَ الدُنيا ويا غايةَ المُنى","ويا بهجَةَ الأيام يا زينَةَ الدهرِ",56,"ر",1,0],["أيا جملة الفضل هنيت نجلا","يفسر بالجود ذاك الجمل",57,"ل",1,0],["أيا جيران ليلى من رقاكم","من هواكم