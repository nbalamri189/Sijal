647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216830","المتقارب"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36713","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131103",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86516","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114557","الوافر"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45542","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107291","الطويل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36287","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119597","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119676","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136940",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90848","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81256","المنسرح"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73089","البسيط"],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146020","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141627","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141632","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120312","البسيط"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147523","الطويل"],[4771,"وَليْلٍ تَجلَّى الصُّبح في جَنباتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=106542",""],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4984,"سَجْعُ الْحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=201167",""],[4987,"توديع الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=49561",""],[5038,"زهرة البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=196716",""],[5092,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=190569",""],[3591,"أحبُّ دياراً لا أزور لها مغنى","https://www.poetsgate.com/ViewPoem.aspx?id=149411",""],[5121,"عِيِدُ الرَّيَاحِيِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=117934",""],[5136,"بروحي شمس على بانة","https://www.poetsgate.com/ViewPoem.aspx?id=121770",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[5550,"الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=211617",""],[5582,"أَهَذِي الشَّمْسُ فِي الأَسْجافِ هَذِي","https://www.poetsgate.com/ViewPoem.aspx?id=186979",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5776,"الشّاعِرُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206108",""],[5790,"لقد سرت البشائر والتهاني","https://www.poetsgate.com/ViewPoem.aspx?id=111875",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"فقدتُ صديقاً ظننْتُه صِدْقا","https://www.poetsgate.com/ViewPoem.aspx?id=193996",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[469,"تود نجوم الليل لو نصلت بها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574834",""],[463,"إذا لم يقرِّبْ منك إلا التذلُّلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60184&r=&rc=240",""],[463,"دعاها معقَّلة ً بالعراقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60165&r=&rc=221",""]],"verses":[["تُوَدِّعنُا ما بَينَ شَكوى وَعَبرَةٍ","وَقَد أَصبَحَ الرَكبُ العِراقِيُّ غادِيا",0,"ي",2,0],["تَوَدُّ العُلى طُلّابُها وَهوَ وادِعٌ","وَيَبلُغُ ما لَم يَبلُغوا وَهوَ قاعِدُ",1,"د",1,0],["تَوَدُّ الثُرَيّا أنْ يكونَ لهُ ثَرى","وتمْدَحُهُ الشِّعْرَى وتحْرُسُ العَوّا",2,"و",2,0],["تودُّ النجومُ الزُهرُ لو مَثَلَتْ به","وقضّت من الزُّلفى إليك الأمانيا",3,"ي",2,0],["تودُّ الغانيات إذا رأتها","لو انتظمت لها عِقْدًا ثمينا",4,"ن",2,0],["تودي بَشاشَتُهُ وَيَأ","تي دونَ حُلوِ العَيشِ مُرُّه",5,"ر",2,0],["تودِّع بالإشارة من بعيد","فيا حُسْنَ الإشارة من بعيدِ",6,"د",1,0],["تودَّدتُ حتى لم أجد مُتَودَّدا","وأَمْلَلْتُ أقلامي عتاباً مُردَّدا",7,"د",2,1],["تودُّ أن الأير في فَرْجها","زادَ على قامتها بسطهْ",8,"ط",2,0],["تَوَدُّ لَو أَنَّ الصِبى عائِدٌ","هَيهاتَ قَد مَرَّ الزَمانُ القَشيب",9,"ب",1,0],["تَوَدُّ شَمسُ الضُحى لَو أَنَّها فَلَكٌ","وَالأُفقُ لَو طَلَعَت في أَوجِهِ قَمَرا",10,"ر",2,0],["تود سجني لو تسطيع في قفص","ويمقت السجن حر شبل احرار",11,"ر",1,0],["تودّ العين لو زيدت سوادا","وأنك في سوادَيها نزيل",12,"ل",1,0],["تَوَدُّ لَو يُتحِفُها بِوالي","يَركَبُها بِالخُطمِ وَالرِحالِ",13,"ل",1,0],["تَوَدُّ بِأَنَّها لَكَ فِيَّ عُجباً","بِجَوهَرِها المُفَصَّلِ في النَشيدِ",14,"د",1,0],["تودَّدَها حديثَ السِّنِّ حتى","أشابَ شَواتَها طعناً وشابا",15,"ب",2,0],["تَوَدُّ العِدى لَو يُحدِقُ اِسمُ أَبي بِها","وَأَلّا تُفاجا في مَجالِ الوَغى بِاِسمي",16,"م",2,0],["تودعُ الكفّ شهاباً محرقاً","كلّ شيطانٍ من الهمّ رجيم",17,"م",1,0],["تُوَدِّعُ للبينِ كفّاً بكَفٍّ","ونحراً بنَحرٍ وجيداً بجيدِ",18,"د",1,0],["تَوَدَّعَ مِن نِساءِ الحَيِّ طُرّاً","فَأَمسى خالِصاً بِكُمُ يَهيمُ",19,"م",1,0],["تودُّ سُيوفُهم أن لو أقاموا","وإن أخذوا الأعِنَّةَ زاهدينا",20,"ن",2,0],["تَوَدُّ الدَراري الطالِعاتُ لَوَ اَنَّها","مُحَجَّبَةٌ مِمّا تُراعي وَتَشهَدُ",21,"د",1,0],["تَوَدُّ اِرتِياعاً لَو حَوَتها حَمامَةٌ","وَغَيَّبها تَحتَ الجَناحَينِ هُدهُدُ",21,"د",1,0],["تَوَدُّ مِنَ السُهدِ المُبَرِّحِ أَنَّها","حَواها مِنَ المَأثورَةِ البيضِ مَرقَدُ",21,"د",1,0],["تَودُّ لو اَنَّ القومَ يَستنقِذُونها","وهيهاتَ لَجَّ الرُّعْبُ واستفحلَ الذُّعْرُ",22,"ر",1,0],["تَودُّ لو اَنّها ملكت فرارا","وهل يُعطَى عدوُّ اللهِ سُولا",23,"ل",2,0],["تَوَدُّ الغَوادي أَنَهُنَّ بَنانُهُ","وَتَهوى الدَراري أَنَهُنَّ شَمائِلُه",24,"ل",2,0],["تَوَدُّ لو وَجَدَتْ يوماً أخا ثقةٍ","لديكِ يُوسعُها برّاً ويحميها",25,"ي",3,0],["تَوَدَّدتُها قَبلاً فَما لانَ قَلبُها","وَأَقسى خَليلاً خِلتَهُ مُتَوَدِّدا",26,"د",2,0],["تَوَدُّ لوَ انّ الليْلَ كفْؤٌ لشَعْرِها","فيَسْتُرَ أوضاحَ الجَوادِ المُسَوَّم",27,"م",1,0],["تَوَدُّ البُزاةُ البِيضُ لوْ أنّ قوتَها","عليه ولم تُرْزَقْ جَناحاً ومِنْسَرا",28,"ر",2,0],["تَوِدُّ عَدُوّي ثُمَّ تَزعَمُ أَنَّني","صَديقُكَ لَيسَ النَوكُ عَنكَ بِعازِبِ",29,"ب",1,1],["تَوَدُّ البَقاءَ النَفسُ مِن خيفَةِ الرَدى","وَطولُ بَقاءِ المَرءِ سُمٌّ مُجَرَّبُ",30,"ب",1,0],["تُوَدِّعُنا الحَياةُ بِمُرِّ كَأسٍ","إِذا اِنتَفَضَت مِنَ الحَيِّ المَريرَه",31,"ر",2,0],["تَوَدُّ لَوَ اِنّ اللَهَ أَعطاهُ حَتفَهُ","وَكَيفَ لَها مِن بَعدِهِ بِغُلامِ",32,"م",1,0],["تود لو أنه كان الوفيَّ لها","فَلَم يخن عهدها يوماً ولم يحل",33,"ل",1,0],["تَوَدّ غِرارَ السيْفِ مِن حُبّها اسمَه","وما هي في النّوْمِ الغِرارِ بطُمّع",34,"ع",1,0],["تُؤدِّى إِلَينا أَنه سِبطُ أَحمدٍ","مَخايِلُ فيهِ لِلهُدى وَشُهودُ",35,"د",1,0],["تَوَدُّ قُلُوبُ النَّاسِ لوْ بُذِلتْ لَهَا","كَبَعْضِ عَطَاءِ المُحْسِنِ المُتَبَرِّعِ",36,"ع",1,0],["تَوَدُّ كُلُّ ريَاضِ الأَرْضِ لَوْ مُنِحَتْ","أَزْهَارُهَا قُبْلَةً مِنْ خَدِّهَا التَّرِبِ",37,"ب",1,0],["تَوَدُّ خَوْضا إِلَيْهِ","لَوِ اسْتَطاعَتْ ذَهَابا",38,"ب",2,0],["تَوَدُّ لوَ أنَّ رسولَ المنايا","ترفَّقَ بالطفل واغتالَها",39,"ل",3,0],["تودع الأنفاس لا تبكي لها","ورجع ما ودعته لا يرتجى",40,"ا",1,0],["تودّ لو طارت مع الرّياح","وحلّقت في كبد الصّراح",41,"ح",1,0],["تود وفيه الحزم لو كانت بالحشا","ضنينا ويأبى الحب الا تكرما",42,"م",2,0],["تَوَدُّ بأنّهَا لَكَ فيّ عُجْباً،","بجَوْهَرِها المُفَضَّلِ في النّشيدِ",43,"د",1,0],["تودّعُنا الحَياةُ بمُرّ كأسٍ،","إذا انتقضتْ من الحيّ المَريره",44,"ر",2,0],["تودّ النّجوم الزهر لو أنّها دمى","ليختار منها المترفات ويلعبا",45,"ب",2,0],["تَوَد كَواكب الجَوزاء لَما","أُنمق بَعض ما فيهِ اِختِصارا",46,"ر",2,0],["تود إن وافى فقير لها","ضيفاً بأن يثوي على هامها",47,"م",3,0],["توددت لا أني إليك فقير","ولا أن بعداً عن ذراك عسير",48,"ر",1,1],["تَوَدُّ الدَّوَاهِى أن تُضَعضِعُهُ وَهَل","لِرِيحِ الصَّبَا أن تَستَخِفَّ يَلَملَمَا",49,"م",2,0],["تَوَدُّ لَو أَن