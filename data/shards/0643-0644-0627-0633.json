{"poems":[[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[52,"يا للرجال أمن شخص بأجياد","https://www.aldiwan.net/poem63932.html","البسيط"],[484,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[567,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64603","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87852","الكامل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[4852,"بياني","https://www.poetsgate.com/ViewPoem.aspx?id=214367",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5431,"رثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=204906",""],[5956,"نجم يسبح","https://www.poetsgate.com/ViewPoem.aspx?id=182428",""],[5956,"سبقوا هتلر في نشر الإرهاب","https://www.poetsgate.com/ViewPoem.aspx?id=194646",""],[6124,"عصفور الكناري","https://www.poetsgate.com/ViewPoem.aspx?id=201240",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6189,"مسافرٌ بلا بوصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83586&r=&rc=53",""]],"verses":[["كل أسر يهون إن أطلقت أر","واحنا الموثقات بالأجساد",0,"د",1,0],["كلُّ أسْرَارِ راحَتَيْهِ غَمَامٌ","مُسْتَهِلٌّ بِوابِلٍ غَيْداقِ",1,"ق",1,0],["كَلّا سَأَترُكُ ذِكري تِلكَ إِذ رَقَدَت","عَنّي وَأَذكُرُ يَوماً غَيرَ رَقّادِ",2,"د",1,0],["كل أستاذ لنا","بسناه نهتدي",3,"ي",1,0],["كُلٌّ أسِيرُ المَنايا لا فِدَاءَ لهُ","فيُحسَبُ الحَيُّ مَيتاً غيرَ مدفونِ",4,"ن",1,0],["كلا ستهجم عند الحد غايتها","فليس يفديك شاكيها وباكيها",5,"ي",3,0],["كُلُّ اِسمِهِ النِصفُ الَّذي في بَدئِهِ","أَمّا المَجيدُ فَلَيسَ غَيرَ مَزيدِ",6,"د",1,0],["كلا سيعلمون ثم كلا","سيعلمون أنه تحلى",7,"ل",2,0],["كل استكانات الحروفِ .. قصائدي","كل اندهاشٍ .. لو تراهُ .. بياني",8,"ي",1,1],["كلا!!...ستقضمُ دون شكٍ قلبه","وتقول كانت ...ثم لم ...ماأجمله!! !",9,"ل",2,0],["كلا... ستحفظه القلوب مرتلا...","وحيا مبينا آية القداس",10,"س",1,0],["كل أسماك المحيطات تغَنِّي","وسناك اليوم نجمٌ يسبحُ",11,"ح",1,0],["كل إسرائيل لا تعدل شخصاً","واحداً منا فتبّت ألف تبْ",12,"ب",1,0],["كُلُّ أَسْرَابِ الكَنَارِي، فِي شُمُوْخٍ","جَمَّعَتْ أَعْشَاشَهَا بَعْدَ الدَّمَارِ",13,"ر",1,0],["كلا سوى أنني يا باب كل نجا","أمسيت عبدك ذاك الكل والوكلا",14,"ل",2,0],["كلاً .. سأطعمُ هذي البيدَ قافية","رُزقتها ولكل الناس ما رُزقوا",15,"ق",3,0]]}