{"poems":[[55,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[65,"ألا يا صفي الملك هل أنت سامع","https://www.aldiwan.net/poem45818.html","الطويل"],[95,"مولاي جاري في الندى طبعه","https://www.aldiwan.net/poem9829.html","السريع"],[95,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[95,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[49,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[48,"ما الثريا عنقود كرم ملاح","https://www.aldiwan.net/poem22111.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55044","الرمل"],[108,"الكبش والقصاب","https://www.poetsgate.com/ViewPoem.aspx?id=179575",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[102,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[128,"واحنيني إلى مباسم بيبي","https://www.aldiwan.net/poem23799.html","الخفيف"],[201,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[406,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[409,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[435,"لكل متيم في الحب حال","https://www.aldiwan.net/poem39865.html","الوافر"],[438,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[534,"نخرج أو ندخل في مصرنا","https://www.aldiwan.net/poem37378.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138179",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136190","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79867","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53230","الخفيف"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3257,"","https://poetry.dctabudhabi.ae/diwan/poem/20060","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138614",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205881","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76448","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[1901,"أقولُ وهَمي ضاقَ عن فيضَهُ صدري","https://www.poetsgate.com/ViewPoem.aspx?id=160389",""],[5388,"سوف أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=206913",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5975,"كنتِ للأبرارِ .. العلى والكتابا","https://www.poetsgate.com/ViewPoem.aspx?id=84581",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""]],"verses":[["أَينَ بانوكِ أَيُّها الحيرَةُ البَي","ضاءُ وَالموطِئونَ مِنكِ الدِيارا",0,"ر",2,1],["أُيُنبَذُ مِثلي بِالعَراءِ وَمارِني","بِما أَتَوَقَّاهُ مِنَ الذُلِّ يُخْطَمُ",1,"م",1,0],["أين بيان وهو لي طيعٌ","وأين ذاك الصوت يا لهفي",2,"ف",2,0],["أين بناة العلى بيوتاً","تهي الرواسي ولا يهينا",3,"ن",2,0],["أَيْنَ بُنَاةُ العُلا بُيُوتاً","تَهِي الرَّوَاسِي وَلا يَهِينَا",4,"ن",2,0],["أين بغداد وهي تزهو علوماً","وزروعاً وأربعا ودروبا",5,"ب",2,0],["أَيَنبَري دونَكَ الكِرامُ لَها","وَأَنتَ قَمقامُها وَأَحمَلُها",6,"ل",3,0],["أَينَ بِقراطُ وَالمُقَلِّدُ جالي","نوسَ هَيهاتَ أَن يَعيشَ طَبيبُ",7,"ب",1,0],["أين بالدانوب شدوُ الذكرياتِ","وصدى العشاق في الليل الأخيرِ",8,"ر",1,0],["أَيْنَ بَيَانِي وَهْوَ لِي طَيِّعٌ","وَأَيْنَ ذَاك الصَّوْتُ يَا لَهْفِي",9,"ف",2,0],["أئن بدا لك لونُ المرِّ تمقُتُه","وأنت بالكأس تلوَ الكَأس تشربه؟",10,"ب",2,0],["أين بنو الآسلام ما يعجزنا","والعزة الكر بحومات الوغى",11,"ا",1,0],["أين بنو القرآن هل ثبطكم","كتابكم عن الجهاد للعدى",11,"ا",1,0],["أين بنو التوحيد لو صدقتم","توحيدكم ما رقص الشرك على",11,"ا",1,0],["أين بنو الأحرار ما سكونكم","والملك والدين حريب والحرى",11,"ا",1,0],["أين بقايا الله في عباده","ظنائن الله وقائذ التقى",11,"ا",1,0],["أين بيت الذي يناديك؟ قلبي،","لايُسمَّى مُعلِّقي أو عليقي",12,"ق",2,0],["أين بيتُ الجبار باق على سمعِ","الليالي مما يَقول زمازِم؟",13,"م",1,0],["أين بيبي وأين أيام بيبي","بعد عمر مضى وعهد تنزى",14,"ا",1,0],["أين بنت الكروم أين حبيبي","أين كأسي بل أين منّي صحابي",15,"ب",2,0],["أَينبي الصَفا المَكي عَن جيرة الحمى","ومن ضمه البيت العَتيق المحجب",16,"ب",1,0],["أين بغدادُناَ لماذا تلظَّى","بين أحشائها لهيبُ الشِّقاقِ؟",17,"ق",1,0],["أين بشراك إذا لاقيتني","أين تفتيشك عني إذ أغيب",18,"ب",1,0],["اينبيءُ فضله إن سوف يأتي","لهُ من نائل العليا نوالُ",19,"ل",1,0],["أين بهاءُ البدرِ من جَبينِه","وأين صوب المُزنِ من يَمينه",20,"ه",1,0],["أين بثأري ودمي","وليُّهُ مَن طلَّهْ",21,"ل",2,0],["أين بالبطحاء ميثاقكم","ربّ آل واسمُه فيكنَّ إلّْ",22,"ل",1,0],["أَيْنَ بَنو جبر طوالُ اللّحَى","لوْ كانَ عِنْدي مِنْهُمُ معْشرُ",23,"ر",1,0],["أين بالحرية اليو","م لمصر الهاتفونا",24,"ن",2,0],["أين بحري أين ما أسمعه","فيه من همس خفىٍّ أين درى",25,"ر",2,0],["أين بتذكار بان الحي ذو شجن","دمعي لفرط النوى في الخد مدرار",26,"ر",1,0],["أين بانى تلك المبانى التي يُض","رَبُ فيها سوائرُ الأمثالِ",27,"ل",1,0],["أين بنو العلياءِ من مجده","ومجدُه ما ناله الفرقد",28,"د",1,0],["أين بنو العَلياءِ من محلِّه","يا بُعدَ ما بين الوهادِ والقُنن",29,"ن",1,0],["أَينَ بودليرُ مِن رَقيقِ مَعاني","هِ وَإِبداعِ نَظمِهِ وَجَلالِه",30,"ل",2,0],["أينَ بدرُ العُلا الَّذي قد وَرِثنا","عنهُ ما في الحَشا من النيرانِ",31,"ن",1,0],["أين بالغُوطتين مربع لذّات","ي ولهوي لا أين بالغُوطتين",32,"ن",1,0],["أين بدر التم من غرته","وخضم الم من راحته",33,"ه",1,0],["أين باب الخلاص من قلق البا","ل وهم البلبال أين الهروب",34,"ب",1,0],["أي نبي اسمع وصايا جمعت","خير نصح بعري الفضل اتصل",35,"ل",1,0],["أين بحر العلم الذي كان منه","تستمد الذفضل البحور الطوامي",36,"م",2,0],["أَينَ بَنو هود النَّبِي وَمَن","شَمر عَن راحَتَيهِ وَابتَكرا",37,"ر",2,0],["أَينَ بنو الاحوصِ الجعارُ وأَي","ن والزرقُ عن عَرشِها الذي انهدَمَا",38,"م",2,0],["أين بانوا عن الديار وعهدي","انها فيهم محط الركاب",39,"ب",1,0],["أين بالأمس كنتَ يوم ابتدأنا","والتقينا بآدم في الطريقِ",40,"ق",1,0],["أَينبت نشء صالح فوق تربة","بدار بها الزوجان يختصمان",41,"ن",1,0],["أين بيضُ الوجوه حمر المواضي","من بني عمي القروُم الصيد",42,"د",1,0],["أينبذُ مثلي بالعراءِ مهانةً","ويصبح في عصرِ الحجى ميّتَ الذكرِ",43,"ر",1,0],["أين بوحي وأين وهجُ شعاعي ؟!","تاه بوحي , وعدتُ وهمَ شهابِ !",44,"ب",1,0],["أينَ بَوحُ المساءِ، أينَ القوافي","أينَ فرسانُها وأينَ المجالُ",45,"ل",1,0],["أينَ بدرٌ .. رماحُها والعوادي","كلُّها أمستْ - ويحَ نفسي - سرابا",46,"ب",2,0],["أَيَنبُتُ إِلَّا مِن مَهانَتِنا القَهرُ ؟","وَيَهزَأُ إِلَّا مِن مَخاوِفِنا الدَّهرُ ؟",47,"ر",1,1]]}