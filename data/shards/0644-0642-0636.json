{"poems":[[55,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[79,"أبا جعفر إن الثقيل الذي ثوى","https://www.aldiwan.net/poem35835.html","الطويل"],[87,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[242,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[264,"أفتاة قلبي رحمة بفتاك","https://www.aldiwan.net/poem35946.html","الكامل"],[285,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[543,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2423","المديد"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83305","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83302","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54078","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102210","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132695","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82827","الكامل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100574","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40143","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66112","المتدارك"],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[6229,"بين يدي الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65210&r=&rc=33",""]],"verses":[["لَقَضى لِسانُكَ مُذ ذَوَت ثَمَراتُه","أَن لا دَوامَ لِنُضرَةِ الأَعوادِ",0,"د",1,0],["لقضّيْتَ منْهُ حاجةً لوْذَعيّةً","وبرّدْتَ منْ نارِ الحَشا لاعِجاً كَوى",1,"و",2,0],["لقضى الحزين بحزنه","ولمات بالكيف الفقير",2,"ر",1,0],["لِقَضاءِ عُذرٍ مِن مُلوكٍ لَحمُها","لَحمي وَأَخشى اللَّومَ إِن لَم آتِها",3,"ت",3,0],["لَقَضَى عَلَى الأَفْرَاحِ سُوقُ هُمُومِهِ","وَالْهَمُّ يَخْتَرِمُ السُّرُورَ شُمُوصُهُ",4,"ص",2,0],["لقضيت بالدعوى لشكوى أدمعي","وحكمت للباكي بحال الشاكي",5,"ك",2,0],["لَقَضى لَكَ اللهُ السَّعادَةَ آيِباً","أَوْ غائِباً وَالله أَعْدَلُ مَنْ قَضا",6,"ض",2,0],["لقضت قريشُ نذرَها فخراً به","وتحلّلت من حِنْثِ كلِّ يمينِ",7,"ن",1,0],["لِقَضَاءِ اللهِ إنا خُضَّعٌ","كرِقابٍ تحتَ حدِّ المشرَفِي",8,"ي",1,0],["لَقَضَينا مِن لُبانَتِهِ","إِنَّما يَشتاقُ مَن عَشِقا",9,"ق",2,0],["لَقضد مَنَّ بِالنُعمى الَّتي جاءَ وَقعُها","عَلى الخَلقِ وَقعُ الماءِ مِن كَبِدٍ حَرّى",10,"ر",2,0],["لَقضد نَوَّروا لَيلاً مِنَ النَقعِ داجِياً","بِشُهبِ رِماحٍ لِلنُحورِ ثَواقِبِ",11,"ب",1,0],["لقضيت حقَّ النفس من تقبيله","وأبحتها ضماً له وعناقا",12,"ق",2,0],["لَقَضيتُ من رسمِ الخَسار لأنَّني","أَصبحتُ مزواراً على بُخلائها",13,"ا",3,0],["لَقَضَى بأنَّ اللَّفظَ لاَ مَعنًى لَهُ","إلاَّ التَّلاَوَةُ عِندَنَا بِلِسَانِ",14,"ن",1,0],["لقضى نحبه ولكن تلافاه","بنور منه دنا فتدلى",15,"ل",2,0],["لَقَضَّيتُ أَيّامي بِأُنسٍ وَلَذَّةٍ","فَخامِسُها يَتلوهُ في الأُنسِ سادِسُه",16,"س",2,0],["لقضى الدهر غير العدل ان يرزق المنى","غبي ويكدى اللوذعي المحنك",17,"ك",1,0],["لَقَضوا جَميعَ حَياتِهِم","لا يُغمِضون الأَعيُنا",18,"ن",2,0],["لقضت علي لواعج","سكنت من الجسم الفؤادا",19,"د",2,0],["لَقَضى لَها أَنْ لا عَديلَ لِفَخْرِها","رَبٌّ بَراكَ فَما تلاكَ عَديلُ",20,"ل",1,0],["لَقَضَيْتُ أَسىً ويَدي صِفْرٌ","ما مِنْ أَمَلٍ أَتَزَوَّدُهُ",21,"د",2,0],["لقضم الأرض زحْفاً وامتداداً","كما السرطانُ موْئلُهُ الثبورُ",22,"ر",1,0],["لقضاةٍ يُحلّلون انتهاكاً","لولاةٍ تصول فيه ذئابا",23,"ب",2,0]]}