{"poems":[[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[77,"أبا جعفر إن الثقيل الذي ثوى","https://www.aldiwan.net/poem35835.html","الطويل"],[85,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[167,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[235,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[257,"أفتاة قلبي رحمة بفتاك","https://www.aldiwan.net/poem35946.html","الكامل"],[278,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[456,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[536,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"]],"verses":[["لَقَضى لِسانُكَ مُذ ذَوَت ثَمَراتُه","أَن لا دَوامَ لِنُضرَةِ الأَعوادِ",0,"د",1,0],["لقضّيْتَ منْهُ حاجةً لوْذَعيّةً","وبرّدْتَ منْ نارِ الحَشا لاعِجاً كَوى",1,"و",2,0],["لقضى الحزين بحزنه","ولمات بالكيف الفقير",2,"ر",1,0],["لِقَضاءِ عُذرٍ مِن مُلوكٍ لَحمُها","لَحمي وَأَخشى اللَّومَ إِن لَم آتِها",3,"ت",3,0],["لَقَضَى عَلَى الأَفْرَاحِ سُوقُ هُمُومِهِ","وَالْهَمُّ يَخْتَرِمُ السُّرُورَ شُمُوصُهُ",4,"ص",2,0],["لقضيت بالدعوى لشكوى أدمعي","وحكمت للباكي بحال الشاكي",5,"ك",2,0],["لَقَضى لَكَ اللهُ السَّعادَةَ آيِباً","أَوْ غائِباً وَالله أَعْدَلُ مَنْ قَضا",6,"ض",2,0],["لقضت قريشُ نذرَها فخراً به","وتحلّلت من حِنْثِ كلِّ يمينِ",7,"ن",1,0],["لِقَضَاءِ اللهِ إنا خُضَّعٌ","كرِقابٍ تحتَ حدِّ المشرَفِي",8,"ي",1,0]]}