{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[55,"يا قرة العين يا من لا أسميه","https://www.aldiwan.net/poem26034.html","السريع"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[10,"ياعين جودي بالدموع السجول","https://www.aldiwan.net/poem21124.html","السريع"],[93,"أي رزء دهاك يا سمعان","https://www.aldiwan.net/poem11258.html","الخفيف"],[54,"قوم إذا أكلوا أخفوا كلامهم","https://www.aldiwan.net/poem27351.html","البسيط"],[54,"لا يقبلون الشكر ما لم ينعموا","https://www.aldiwan.net/poem27529.html","الكامل"],[47,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[72,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[64,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[51,"قل للمكنى باسمِ خير الورى","https://www.aldiwan.net/poem65822.html","السريع"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"أشقى البرية نفسا صاحب الهمم","https://www.aldiwan.net/poem62723.html","عموديه"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[89,"ما بنا خوف اذا الموت دنا","https://www.aldiwan.net/poem44842.html","الرمل"],[85,"لا يقيمن على الضيم الأسد","https://www.aldiwan.net/poem8101.html","الرمل"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[45,"مغنى منازلها التي بمشقر","https://www.aldiwan.net/poem63594.html","الكامل"],[45,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[28,"يا سائلي أين حلّ الجود والكرم","https://www.aldiwan.net/poem25438.html","البسيط"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[66,"بدت فلم يبق ستر غير منهتك","https://www.aldiwan.net/poem39191.html","البسيط"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[31,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[52,"يا صاح يشغل سمعي عن عواذله","https://www.aldiwan.net/poem26930.html","البسيط"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[50,"وذات دل كأن البدر صورتها","https://www.aldiwan.net/poem24579.html","البسيط"],[50,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[46,"خمسون قد عشتها فلا تعش","https://www.aldiwan.net/poem22869.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42511","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[51,"أوَّلُ الشهرِ أولُ الأسبوعِ","https://www.poetsgate.com/ViewPoem.aspx?id=29387",""],[31,"لعمريَ، لو أبصرتني يومَ بنتمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18980&r=&rc=243",""],[107,"هنئتها منحة مباركة","https://www.aldiwan.net/poem16676.html","المنسرح"],[126,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[135,"أيا حكم المتبول لو كنت تعتزي","https://www.aldiwan.net/poem67972.html","الطويل"],[140,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[165,"تغير الفتح","https://www.aldiwan.net/poem1071.html",""],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[268,"لا يقل أحمق النساء بلاء","https://www.aldiwan.net/poem35182.html","الخفيف"],[282,"إذا حججت بمال أصله دنس","https://www.aldiwan.net/poem44305.html","البسيط"],[302,"يا نفس هذا الذي تأتينه عجب","https://www.aldiwan.net/poem16775.html","البسيط"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[326,"قولو لمن نظم الرواية","https://www.aldiwan.net/poem55011.html","مجزوء الكامل"],[362,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[362,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[364,"واصل طيف الحب كالهاجر","https://www.aldiwan.net/poem16988.html","السريع"],[364,"قالوا جرى قلمي في غير مدحكم","https://www.aldiwan.net/poem17273.html","البسيط"],[369,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[413,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[429,"سيدنا الحبر كفه أبدا","https://www.aldiwan.net/poem12543.html","المنسرح"],[436,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[438,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[456,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[462,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[513,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[513,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[549,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"]],"verses":[["لا يُقيمُ العَزيزُ في البَلَدِ السَه","لِ وَلا يَنفَعُ الذَليلَ النِجاءُ",0,"ا",2,0],["لا يَقبَلُ النُصحَ إِلّا في مَحَبَتِهِ","وَقَد تَصابى فَأَرداهُ تَصابيه",1,"ي",2,0],["لا يَقَعُ الطَعنُ إِلّا في نُحورِهِمُ","ما إِن لَهُم عَن حِياضِ المَوتِ تَهليلُ",2,"ل",1,0],["لا يَقصِرُ الفَضلَ عَلى نَفسِهِ","بَل عِندَهُ مَن نابَهُ في فُضول",3,"ل",1,0],["لا يَقُولُونَ مَنْ فَتَاهَا وَسَمْعَانُ","فَتَاهَا المُرَجَّبُ اليَقْظَانُ",4,"ن",1,0],["لا يَقبِسُ الجارُ مِنهُم فَضلَ نارِهِمُ","وَلا تُكَفُّ يَدٌ عَن حُرمَةِ الجارِ",5,"ر",1,0],["لا يَقبَلونَ الشُكرَ ما لَم يُنعِموا","نِعَماً يَكونُ لَها الثَناءُ تَبيعا",6,"ع",2,1],["لايَقبَلُ اللَهُ قَبلَ فَرضِكَ ذا","نافِلَةً عِندَهُ تُنَفِّلُها",7,"ل",3,0],["لا يقربُ الصبرُ قلبي أو يفارقهُ","كأنَّه المالُ في كفِّ بن أيوب",8,"ب",1,0],["لا يقبس الوجد إلا من جوانحنا","ويستقي الدَّمع إلا من مآقينا",9,"ن",2,0],["لا يَقبَلونَ مُذيعاً في مَجالِسِهِم","وَلا يُحِبّونَ سَتراً كانَ وَشواشا",10,"ش",2,0],["لاَيَقِيسَنَّ قائسٌ بِكُمُ قَوْ","ماً فليس المعْدُوم كالموْجُودِ",11,"د",1,0],["لا يقولنَّ حاسدٌ خان من كا","تَم سلطَانَه أعَدَّ عَتادِهْ",12,"د",2,0],["لا يقولنَّ قائلٌ لمرجِّي","ه وقد خاب زاده الله بعدا",13,"د",2,0],["لا يقارعْكَ يا ابن يحي عن السؤ","دُدِ شيءٌ فلستَ بالمقروعِ",14,"ع",1,0],["لا يقرعُ السنَّ لها نادماً","ولا يرى المعروفَ شيئاً هلَك",15,"ك",1,0],["لا يقولنّ قائلٌ فلتةٌ من","هُ تلاها من الندامةِ تالِ",16,"ل",1,0],["لا يَقُدْكَ الهوى إلى نصرة الأخ","بار حتَّى تُهين ما لا يهان",17,"ن",1,0],["لا يَقتَضي قاصِدُهُ حَمدَهُ","وَيَشكُرُ العافي الَّذي قالَ هَت",18,"ت",1,0],["لا يَقبِضونَ مَعَ اللَأواءِ أَيدِيَهُم","وَقَلَّما جادَ ذو وَفرٍ مَعَ الأَزَمِ",19,"م",1,0],["لا يقبل الذل امرؤ","لنفسه يحترم",20,"م",1,0],["لا يقاسى شجنا ميت","ولكنما الحي يقاسي الشجنا",21,"ن",2,0],["لا يُقيمَنَّ عَلى الضَيمِ الأَسَد","نَزَعَ الشِبلُ مِنَ الغابِ الوَتَد",22,"د",1,1],["لا يَقولَنَّ اِمرو أَصلي فَما","أَصلُهُ مِسكٌ وَأَصلُ الناسِ طين",23,"ن",1,0],["لا يُقنِعُ اِبنَ عَليٍّ نَيلُ مَنزِلَةٍ","يَشكو مُحاوِلُها التَقصيرَ وَالتَعَبا",24,"ب",2,0],["لا يَقرَبونَ الطيبَ إِلّا بِالقَنا","وَتَدورُ كَأسُهُمُ لَهُم في مِغفَرِ",25,"ر",1,0],["لا يَقتَفي أَثَرَ الغَريبِ وَلا يُرى","قَلِقَ المَطِيِّ عَلى الطَريقِ الجائِرِ",26,"ر",1,0],["لايَقتُلِ الحُسّادُ أَنفُسَهُم فَقَد","هَتَكَ الصَباحُ دُجى الهَزيعِ المُظلِمِ",27,"م",1,0],["لَأَيقَنَ أَنّي قَد نَقَعتُ فُؤادَهُ","بِشَربَةِ صادٍ يابِسِ الرَأسِ هائِمِ",28,"م",1,0],["لاَ يَقْبِضُ العُسْرُ بَسْطاً مِنْ أكُفِّهِمُ","سِيَّانِ ذَلِكَ إنْ أثْرَوْا وَإنْ عَدِمُوا",29,"م",3,0],["لا يقتدي بسواه في تدبيره","والبحر يغنى عن رذاذ ضحائه",30,"ا",3,0],["لا يُقدِمُ الدَهرُ يَوماً أَن يَميلَ عَلى","عَبدٍ بِحَبلِ وَلاءٍ مِنكَ مُمتَسِكِ",31,"ك",1,0],["لا يقدحُ العفوُ في تمكين قدرته","ولا يواقعُ ذنباً كلّما انتقما",32,"م",2,0],["لَأَيقَنتِ أَنَّ القَلبَ عانٍ بِذِكرِكُم","وَأَنّي رَهينٌ في حِبالِكَ مُثَقُ",33,"ق",1,0],["لا يقبلون لحائِطٍ ثمناً ولا","يَبغونَها دُنيا تُذَمُّ وتُرذَلُ",34,"ل",1,0],["لا يُقعِدُ الشَكُّ عَزمي عِندَ نَهضَتِهِ","وَلَيسَ رَأسِيَ عَن حَزمٍ بِمَحجوزِ",35,"ز",1,0],["لَأَيقَنَ أَنَّ حُبَّ المُر","دِ يُلفى سَهلُهُ وَعَرا",36,"ر",2,0],["لا يَقتُلُ اللَهُ مَن دامَت مَوَدَّتُهُ","وَاللَهُ يَقتُلُ أَهلَ الغَدرِ أَحيانا",37,"ن",2,0],["لا يُقَضّي العَجيبُ مِنّي أَبو حَر","بٍ وَينسي الَّذي ضَمِنتُ الوَليدا",38,"د",2,0],["لا يَقرَأُ السَطرَ بِالنَهارِ وَقَد","كانَ يُجَلّي كَالصَقرِ ثُمَّ عَشي",39,"ي",1,0],["لا يقيمونَ في ذُراهنَّ واللي","لُ على الكون مطبقُ الأسدافِ",40,"ف",1,0],["لا يَقرُبُ اليَأسُ في البَأساءِ أَنفُسَهُم","وَالنَفسُ إِن قَنَطَت فَاليَأسُ مُرديها",41,"ي",3,0],["لا يَقْنَطُ الْمَرْءُ مِنْ غُفْرَانِ خَالِقِهِ","مَا لَمْ يَكُنْ كَافِرَاً بِالْبَعْثِ وَالْقَدَرِ",42,"ر",1,0],["لا يَقْعُدُ الْبَطَلُ الصِّنْدِيدُ عَنْ كَرَمٍ","مَنْ جَادَ بِالنَّفْسِ لَمْ يَبْخَلْ بِمَا كَسَبَا",43,"ب",2,0],["لاَ يَقْنِصُ العَبْدُ الأُسُودَ تَلَهِّياً","دَعْهُ يُوَاسِ جِرَاحَهُ وَيُوَالِي",44,"ل",2,0],["لاَ يَقْصدُ البِنَّاءِ فَخْماً وَلاَ","الزِّينَةَ أَبْهَى مَا جَوَّدَتْهَا الأَيَادي",45,"د",2,0],["لاَ يُقْتَلُ الظَّمْآن فِي حَيِّكم","مَا دَامَ فضْلُ المَاءِ فِي الكأْسِ",46,"س",1,0],["لا يقبل الحر زادًا قدَّمَتْه له","كفُّ الدخيل، ولو ذاق الردى سَغَبَا",47,"ب",2,0],["لا يقيم العزيز بالبلد السه","ل ولا ينفع الذليل النجاء",48,"ا",2,0],["لا \" يُقالُ \" الشعبُ لكنْ طغمةٌ","تسترقُّ الشَعبَ أولى أن تُقالا",49,"ل",2,0],["لا يقارعْكَ يا بن يحي عن السؤ","دِد شيءٌ فلستَ بالمقروعِ",50,"ع",1,0],["لأيقنت أنّ القلبَ عانٍ بذكركم،","وأَنِّي رَهِينٌ في حِبَالِكِ مُوثَقُ",51,"ق",1,0],["لا يقدر الناس قَدرَها وَلَكُم","انثى غَدَت في فَخارِها علما",52,"م",2,0],["لا يقرون جنبَهم في الحشايا","يقطفُون الزمانَ بالاجتهادِ",53,"د",1,0],["لِأَيقَنتَ قَد أَدرَكتَ وِترَكَ عَنوَةً","بِلا حُكمٍ قاضٍ بَل بِضَربِ السَوالِفِ",54,"ف",1,0],["لا يقتنى إلا حساما جاهلا","ولا يُعِدُّ الرمحَ إلا مائقا",55,"ق",2,0],["لا يقبلونك صدرا ً دافئا ً لأخ ٍ","لا يرتضونك عِرقا ً طّيبَ النسَّب ِ",56,"ب",1,0],["لا يَقبَلُ الضَيمَ إلّا عاجِزٌ ضَرِعٌ","إِذا رَأى الشَرَّ تَغلي قِدرُهُ وَجَما",57,"م",2,0],["لا يَقُل أحمقُ النساءُ بلاءُ","هنَّ واللهِ رحمةٌ وعزاءُ",58,"ا",2,1],["لا يَقبَلُ اللَهُ كُلَّ طَيبَةٍ","ما كُلّ مَن حَجَّ بَيتَ اللَهِ مَبرورُ",59,"ر",1,0],["لا يقبل اللَه أعمالاً يزيد بها","عاملها غير وجه اللَه فاجتنبوا",60,"ب",3,0],["لا يقرعُ الأسماعَ تعزية به","إلّا وَزاد تحسّرٌ وتوجّعُ",61,"ع",1,0],["لا يُقعِدنّك عن مراد","كَ بطش جبّارٍ رهيب",62,"ب",1,0],["لا يُقطَعُ السَّعْيُ في نَيْلِ المطالبِ منْ","هذا إلى ذاك ماكَرَّ الجديدان",63,"ن",1,0],["لائقٌ أن يقالَ فيه وفيها","واللّيالي مُعتادَةُ الإعتداء",64,"ا",2,0],["لا يَقبَلُ الرِشوَةَ في حُكمِهِ","وَلا يُبالي غَبَنَ الخاسِرِ",65,"ر",1,0],["لا يَقطَعَن مُفسِدٌ في المَجدِ عُلقَةَ ما","بَينَ الأَيادي وَبَينَ الجودِ مِن رَحِمِ",66,"م",1,0],["لا يقبلونَ الضيمَ لكنَّهُ","يُقبلُ منهم أينَما ثاروا",67,"ر",3,0],["لا يَقتَني العليا إِلّا بِالظُبى","قدماً إِذا ونيَت صُدور قَناهُ",68,"ا",2,0],["لا يقتني المالَ ولم يدَّخرْ","شيئاً ولا مالَ إلى الادِّخار",69,"ر",1,0],["لا يُقتضى جودُك الأزكى لمكرمةٍ","إلا ونائلُه الفيّاضُ ينتصِبُ",70,"ب",1,0],["لا يقصدُ المرءُ عند حاجتِه","إلا كريماً قد باتَ من شِيَعِهْ",71,"ع",2,0],["لا يَقْرَعُ السِّنَّ فِي ضَنْكِ المَكَرِّ إِذَا","تقارَعَتْ فِيهِ بِيضُ الهِنْدِ والحَجَفُ",72,"ف",1,0],["لا يقدرون على إسقاط منزلتي","أو يطمعون يحلوا في سمارتبي",73,"ي",1,0],["لا يُقتَضَيْنَ وفي الديون علهيمُ","قلبي ولا يُقضَى لهنّ غريمُ",74,"م",1,0],["لايقول الوشاةُ عنّي محبٌّ","غيَّرَ النأيُ ودَّه فأحالَهْ",75,"ل",2,0],["لا يقدحُ الحسادُ فيَّ عندكم","وفيتُكم رسومها أو لم أوفّْ",76,"ف",1,0],["لا يُقتَضَى عنده ثأرٌ ولا تِرَةٌ","ولا يُعاب بجبنٍ من يقارعُهُ",77,"ع",2,0],["لا يقظت طرف الشعر من سنة الكرى","وأنقذت أهل الفضل من سن الجدب",78,"ب",1,0],["لا يقرع الباب إلا قلت قارعه","وزارع العمر مهما شاء حاصده",79,"د",2,0],["لا يقولن جاهل بالقوافي","ذهب الناقد السميع البصير",80,"ر",1,0],["لا يقتفي الآثار إلا في التقى","وفي المعالي تقتفى آثاره",81,"ر",2,0],["لا يقنُصُ الدّهرُ قلبي في حبائله","ولا يَميل اِعتِزامي في صِبا أملِ",82,"ل",1,0]]}