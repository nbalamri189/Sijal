te.com/ViewPoem.aspx?id=156700",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6152,"هواكِ محرابي","https://www.poetsgate.com/ViewPoem.aspx?id=203048",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6213,"نبراس أمتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76308&r=&rc=56",""],[6225,"صمود لبنان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80972&r=&rc=241",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""],[463,"لمن الطلول كأنهنَّ رقومُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60183&r=&rc=239",""],[463,"في كلّ دارٍ عدوٌ لي أقاذعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60140&r=&rc=196",""],[6259,"أحياه بعد الله إذ حياه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59407&r=&rc=55",""],[572,"يا مُعرِضاً عنّي بوجهٍ مدبرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9432&r=&rc=289",""]],"verses":[["لا يُقيمُ العَزيزُ في البَلَدِ السَه","لِ وَلا يَنفَعُ الذَليلَ النِجاءُ",0,"ا",2,0],["لا يَقبَلُ النُصحَ إِلّا في مَحَبَتِهِ","وَقَد تَصابى فَأَرداهُ تَصابيه",1,"ي",2,0],["لا يَقَعُ الطَعنُ إِلّا في نُحورِهِمُ","ما إِن لَهُم عَن حِياضِ المَوتِ تَهليلُ",2,"ل",1,0],["لا يَقصِرُ الفَضلَ عَلى نَفسِهِ","بَل عِندَهُ مَن نابَهُ في فُضول",3,"ل",1,0],["لا يَقُولُونَ مَنْ فَتَاهَا وَسَمْعَانُ","فَتَاهَا المُرَجَّبُ اليَقْظَانُ",4,"ن",1,0],["لا يَقبِسُ الجارُ مِنهُم فَضلَ نارِهِمُ","وَلا تُكَفُّ يَدٌ عَن حُرمَةِ الجارِ",5,"ر",1,0],["لا يَقبَلونَ الشُكرَ ما لَم يُنعِموا","نِعَماً يَكونُ لَها الثَناءُ تَبيعا",6,"ع",2,1],["لايَقبَلُ اللَهُ قَبلَ فَرضِكَ ذا","نافِلَةً عِندَهُ تُنَفِّلُها",7,"ل",3,0],["لا يقربُ الصبرُ قلبي أو يفارقهُ","كأنَّه المالُ في كفِّ بن أيوب",8,"ب",1,0],["لا يقبس الوجد إلا من جوانحنا","ويستقي الدَّمع إلا من مآقينا",9,"ن",2,0],["لا يَقبَلونَ مُذيعاً في مَجالِسِهِم","وَلا يُحِبّونَ سَتراً كانَ وَشواشا",10,"ش",2,0],["لاَيَقِيسَنَّ قائسٌ بِكُمُ قَوْ","ماً فليس المعْدُوم كالموْجُودِ",11,"د",1,0],["لا يقولنَّ حاسدٌ خان من كا","تَم سلطَانَه أعَدَّ عَتادِهْ",12,"د",2,0],["لا يقولنَّ قائلٌ لمرجِّي","ه وقد خاب زاده الله بعدا",13,"د",2,0],["لا يقارعْكَ يا ابن يحي عن السؤ","دُدِ شيءٌ فلستَ بالمقروعِ",14,"ع",1,0],["لا يقرعُ السنَّ لها نادماً","ولا يرى المعروفَ شيئاً هلَك",15,"ك",1,0],["لا يقولنّ قائلٌ فلتةٌ من","هُ تلاها من الندامةِ تالِ",16,"ل",1,0],["لا يَقُدْكَ الهوى إلى نصرة الأخ","بار حتَّى تُهين ما لا يهان",17,"ن",1,0],["لا يَقتَضي قاصِدُهُ حَمدَهُ","وَيَشكُرُ العافي الَّذي قالَ هَت",18,"ت",1,0],["لا يَقبِضونَ مَعَ اللَأواءِ أَيدِيَهُم","وَقَلَّما جادَ ذو وَفرٍ مَعَ الأَزَمِ",19,"م",1,0],["لا يقبل الذل امرؤ","لنفسه يحترم",20,"م",1,0],["لا يقاسى شجنا ميت","ولكنما الحي يقاسي الشجنا",21,"ن",2,0],["لا يُقيمَنَّ عَلى الضَيمِ الأَسَد","نَزَعَ الشِبلُ مِنَ الغابِ الوَتَد",22,"د",1,1],["لا يَقولَنَّ اِمرو أَصلي فَما","أَصلُهُ مِسكٌ وَأَصلُ الناسِ طين",23,"ن",1,0],["لا يُقنِعُ اِبنَ عَليٍّ نَيلُ مَنزِلَةٍ","يَشكو مُحاوِلُها التَقصيرَ وَالتَعَبا",24,"ب",2,0],["لا يَقرَبونَ الطيبَ إِلّا بِالقَنا","وَتَدورُ كَأسُهُمُ لَهُم في مِغفَرِ",25,"ر",1,0],["لا يَقتَفي أَثَرَ الغَريبِ وَلا يُرى","قَلِقَ المَطِيِّ عَلى الطَريقِ الجائِرِ",26,"ر",1,0],["لايَقتُلِ الحُسّادُ أَنفُسَهُم فَقَد","هَتَكَ الصَباحُ دُجى الهَزيعِ المُظلِمِ",27,"م",1,0],["لَأَيقَنَ أَنّي قَد نَقَعتُ فُؤادَهُ","بِشَربَةِ صادٍ يابِسِ الرَأسِ هائِمِ",28,"م",1,0],["لاَ يَقْبِضُ العُسْرُ بَسْطاً مِنْ أكُفِّهِمُ","سِيَّانِ ذَلِكَ إنْ أثْرَوْا وَإنْ عَدِمُوا",29,"م",3,0],["لا يقتدي بسواه في تدبيره","والبحر يغنى عن رذاذ ضحائه",30,"ا",3,0],["لا يُقدِمُ الدَهرُ يَوماً أَن يَميلَ عَلى","عَبدٍ بِحَبلِ وَلاءٍ مِنكَ مُمتَسِكِ",31,"ك",1,0],["لا يقدحُ العفوُ في تمكين قدرته","ولا يواقعُ ذنباً كلّما انتقما",32,"م",2,0],["لَأَيقَنتِ أَنَّ القَلبَ عانٍ بِذِكرِكُم","وَأَنّي رَهينٌ في حِبالِكَ مُثَقُ",33,"ق",1,0],["لا يقبلون لحائِطٍ ثمناً ولا","يَبغونَها دُنيا تُذَمُّ وتُرذَلُ",34,"ل",1,0],["لا يُقعِدُ الشَكُّ عَزمي عِندَ نَهضَتِهِ","وَلَيسَ رَأسِيَ عَن حَزمٍ بِمَحجوزِ",35,"ز",1,0],["لَأَيقَنَ أَنَّ حُبَّ المُر","دِ يُلفى سَهلُهُ وَعَرا",36,"ر",2,0],["لا يَقتُلُ اللَهُ مَن دامَت مَوَدَّتُهُ","وَاللَهُ يَقتُلُ أَهلَ الغَدرِ أَحيانا",37,"ن",2,0],["لا يُقَضّي العَجيبُ مِنّي أَبو حَر","بٍ وَينسي الَّذي ضَمِنتُ الوَليدا",38,"د",2,0],["لا يَقرَأُ السَطرَ بِالنَهارِ وَقَد","كانَ يُجَلّي كَالصَقرِ ثُمَّ عَشي",39,"ش",2,0],["لا يقيمونَ في ذُراهنَّ واللي","لُ على الكون مطبقُ الأسدافِ",40,"ف",1,0],["لا يَقرُبُ اليَأسُ في البَأساءِ أَنفُسَهُم","وَالنَفسُ إِن قَنَطَت فَاليَأسُ مُرديها",41,"ي",3,0],["لا يَقْنَطُ الْمَرْءُ مِنْ غُفْرَانِ خَالِقِهِ","مَا لَمْ يَكُنْ كَافِرَاً بِالْبَعْثِ وَالْقَدَرِ",42,"ر",1,0],["لا يَقْعُدُ الْبَطَلُ الصِّنْدِيدُ عَنْ كَرَمٍ","مَنْ جَادَ بِالنَّفْسِ لَمْ يَبْخَلْ بِمَا كَسَبَا",43,"ب",2,0],["لاَ يَقْنِصُ العَبْدُ الأُسُودَ تَلَهِّياً","دَعْهُ يُوَاسِ جِرَاحَهُ وَيُوَالِي",44,"ل",2,0],["لاَ يَقْصدُ البِنَّاءِ فَخْماً وَلاَ","الزِّينَةَ أَبْهَى مَا جَوَّدَتْهَا الأَيَادي",45,"د",2,0],["لاَ يُقْتَلُ الظَّمْآن فِي حَيِّكم","مَا دَامَ فضْلُ المَاءِ فِي الكأْسِ",46,"س",1,0],["لا يقبل الحر زادًا قدَّمَتْه له","كفُّ الدخيل، ولو ذاق الردى سَغَبَا",47,"ب",2,0],["لا يقبل الله دينا غير دينهم","ولا يصح الهدى الا بما دانوا",48,"ن",3,0],["لا يقتنون رياشا فوق سابغة","كأنهن اذا ألقين غدران",48,"ن",1,0],["لا يقيم العزيز بالبلد السه","ل ولا ينفع الذليل النجاء",49,"ا",2,0],["لا \" يُقالُ \" الشعبُ لكنْ طغمةٌ","تسترقُّ الشَعبَ أولى أن تُقالا",50,"ل",2,0],["لا يقنط الحرّ ولا يشتكي","لكلّ بحر هائج شاطئان",51,"ن",1,0],["لا يقارعْكَ يا بن يحي عن السؤ","دِد شيءٌ فلستَ بالمقروعِ",52,"ع",1,0],["لأيقنت أنّ القلبَ عانٍ بذكركم،","وأَنِّي رَهِينٌ في حِبَالِكِ مُوثَقُ",53,"ق",1,0],["لا ي