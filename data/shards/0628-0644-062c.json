{"poems":[[65,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[53,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[53,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[33,"أضحى فؤادك غير ذات أوان","https://www.aldiwan.net/poem41285.html","الكامل"],[33,"يا رب إنك قد علمت بأنها","https://www.aldiwan.net/poem41304.html","الكامل"],[52,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43799","المقتضب"],[164,"اضرب بسيف العزم أَعناق الكرى","https://www.aldiwan.net/poem58719.html","الكامل"],[308,"يا سيدا رب العلا","https://www.aldiwan.net/poem57736.html","مجزوء الرجز"],[382,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[409,"يا رجائي وهل سواك رجائي","https://www.aldiwan.net/poem34178.html","الرمل"],[449,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[463,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[534,"ما للطعام وللثياب أتيته","https://www.aldiwan.net/poem37126.html","الكامل"],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[580,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138427",""],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105268","الرمل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122361","الدوبيت"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38188","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77507","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95495","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128720","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80043","الخفيف"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71050","المنسرح"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102139","المديد"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104974","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121229","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58257","المجتث"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96439","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109866","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123914","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127934","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139696",""],[4927,"مَجْدُ الْعِرَاْق","https://www.poetsgate.com/ViewPoem.aspx?id=30480",""],[5005,"ما أروعك!","https://www.poetsgate.com/ViewPoem.aspx?id=208151",""],[5038,"إنبطح يا عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=195230",""],[5219,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=194428",""],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5701,"أشرق الليل بنور العرس","https://www.poetsgate.com/ViewPoem.aspx?id=164688",""],[5956,"إنكم خيرُ المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=194379",""]],"verses":[["بلْ جادَها ابنُ العامِريِّ براحَةٍ","وَطْفاءَ صِيغَ بَنانُها منْ جُودِ",0,"د",1,0],["بلْ جميعاً وبين ذلك حمداً","أبديّاً يُطبِّقُ الآناءَ",1,"ا",2,0],["بل جبنُهُ يمنعُها إقدامَها","وحَيْنُهُ يمنعه من الهرَبْ",2,"ب",1,0],["بل جلا اللَّه بكم عنا العمى","ونفى اللَّه بكم عنا الحزن",3,"ن",1,0],["بَل جُنَّ قَلبُكَ أَن بَدَت لَكَ دارُها","جَزَعاً وَكِدتَ تَبوحُ بِالكِتمانِ",4,"ن",1,0],["بَل جاءَني فَقَرَأتُهُ مُتَهَلِّلاً","وَجهي وَبَعدَ تَهَلُّلٍ أَبكانا",5,"ن",2,0],["بَلجَ المُحَيّا مُحصَدَ الأَسبابِ","يَجري عَلى العِلّاتِ غَيرَ كابِ",6,"ب",1,0],["بَلْ جُزْتِ بِالحُسْنَى وَسَا","ءَ تَوَرُّعُ المُتَوَرِّعِ",7,"ع",1,0],["بَلْ جُوْرُ قَوْمٍ كَانَ فِيهِمْ عِزَّةً","لِلْمُسْتَعِزِّ وَغِنْيَةٌ لِلطَّالِبِ",8,"ب",1,0],["بَل جَرى عَلَيكَ ردىً","ذابَ كَأسُهُ فَسَقى",9,"ق",2,0],["بل جاءَ ينزعُ من بطينةِ مقلتي","سهم الزمانِ وكان دوني محجرا",10,"ر",2,0],["بل جبلٌ أحاط بال","أرض وذاك معرفه",11,"ف",2,0],["بل جاء عريان الرجا","وعليه من حزنٍ ملابس",12,"س",1,0],["بل جميع الأشياء ملك لربي","لم يخصص شيء من الأشياء",13,"ا",2,0],["بل جمع الدنيا لهم في سفر","اضحى محيط مجرها والبر",14,"ر",1,0],["بُلجةُ فجرِ وجههِ","يُقمِرُ منها المعتِمُ",15,"م",1,0],["بلَجوا على ضوء الصَّبا","حِ ببهجةِ الغُرر الصِّباحِ",16,"ح",1,0],["بل جدولٌ في رعن طوْدِ أْهمٍ","حوليه بحرُ أناملٍ مُتدفِّعِ",17,"ع",1,0],["بلْ جئتْهُ أَرْجُو بُلُوغَ مَقَاصِدٍ","في الدِّينِ واجِبَةٍ منَ الدَّيّانِ",18,"ن",1,0],["بَلْ جَادَ بِالرِّيِّ فِيْكَ جَوْدَاً","تُرْوَى بِهِ قَارَةٌ وَقَاعُ",19,"ع",1,0],["بَلْ جُوده أَعْلَى لأَني امروٌ","آخُذُ آلاَفاً وأُعْطِي مِئِينْ",20,"ن",1,0],["بل جهلهم طبق الآفاق منتشراً","مثل السحاب بهاء الشمس قد حجبا",21,"ب",2,0],["بل جنة الزوج الامين إذا زهت","بزهور عفتها وبالاحصان",22,"ن",1,0],["بل جرى هذا على كل الورى","وجرى أسفله عالي الطنب",23,"ب",1,0],["بل جر واهجر ولا تخف مظلمتي","ما اورثني البلاء إلا حظي",24,"ي",1,0],["بَل جَفاهُ لِجَفاهُ كُلَّما","فيهِ يَلتذّ كمثلِ النعَسِ",25,"س",1,0],["بَل جاءَت الدبَّة ذات يَوم","فَوَجَدَت صاحِبها في النَوم",26,"م",1,0],["بَلْ جَوزِ خَرْقٍ يَكْتَسِي الطَلُوسا","تَرَى عَلَيْهِ الرَقْرَقَ المَأْلُوسا",27,"س",2,0],["بلج الحقُّ بالرسول وأبلى","خيرَ جهدٍ فنالَ خيرَ انتصارِ",28,"ر",1,0],["بل جاء ركضا وسيم الوجه يسبح في","تياره وعلى التكرور كم رأفا",29,"ف",2,0],["بل جوادُ العليا وربُّ فخارٍ","طيبه ضاع بالنديِّ عبيرا",30,"ر",2,0],["بل جاء بالضم صريح الآية","إن كنت بالقرآن ذا درايه",31,"ه",1,0],["بل جئتما فرسَي رها","نٍ واليدان به اليد",32,"د",1,0],["بل جانبوا الدينا وما استكلبوا","على الدَّنايا كَلَبَ النابِحِ",33,"ح",1,0],["بل جُبِلَتْ في ابتداءِ فِطْرتِها","على حَراكٍ من فاطِرِ الفِطَرِ",34,"ر",1,0],["بل جميع الرسل واتباعٍ","لك يرجوا تدخلن مددى",35,"د",2,0],["بَل جَاوَزَ السَّبعَ الطِّبَاقَ وَقَد دَنَا","مِنهُ إِلَى أن قُدِّرَت قَوسَانِ",36,"ن",1,0],["بل جلَّ أن تحكيه وردة","في اللون والنفحة واللمس",37,"س",1,0],["بل جعلتُ بالغرام حلية نفسي","مثل قطر الصباح فوق النبات",38,"ت",1,0],["بل جنة ازلفت للمتقين فلا","عيب بها غير فرط الانس والجذل",39,"ل",1,0],["بَلْ جدولٌ من عُبابٍ","بهِ يداوي الأوام",40,"م",1,0],["بل جناها أخٌ عليَّ كريمٌ","وعلى أهلها بُراقشُ تجني",41,"ن",2,0],["بل جفتني لما بدأت بان اس","لو كأنا كنا على ميعاد",42,"د",1,0],["بَل جاءَنا مِنهُ بِالنور المُبين ضحى","حرصاً عَلَينا فَلَم نرتب وَلَم نَهم",43,"م",1,0],["بلجين برزت تبراً مذاب","وشهاب في شهاب ظهرا",44,"ر",2,0],["بل جاءَ سباقاً لكلِّ سابحٍ","حَتَّى أَتى الرَملَةَ فيما قَد أَتى",45,"ا",1,0],["بلجينِ وعسجدٍ وجمانٍ","ولآل من فوق خضر الملابس",46,"س",1,0],["بل جَنَّةٌ شادها كلٌّ لكل فتىً","وجُنَّةٌ عن عذابٍ للملا شَرَعا",47,"ع",2,0],["بَلْ جَاْهَرُوْا بِعَدَاْئِهِمْ لِبِلاْدِهِمْ","وَ تَآمَرُوْا جَوْراً عَلَى الأَجْوَاْدِ",48,"د",1,0],["بل جلَّ من أسْراكَ في لُبِّي ومَن","أوْلاكَ سرِّيَ واصطفاكَ وأبدعَكْ!",49,"ك",1,0],["بَلْ جَوّزوا أَكْلَ الْأَوادِمِ في الْقُرى","في طَبْعِهمْ لِلْيَومِ تَغْلي الطَّنْجَرَهْ",50,"ر",2,0],["بل جعلتم ساحه طربا","لشيوخ تحته رقصت",51,"ت",1,0],["بل جنة الفردوس يسكنها","جار النبي ورهبطه الزّهر",52,"ر",1,0],["بلجتها غص فالتقط درر الثنا","ولا تختشي أهوالها وغمارها",53,"ر",3,0],["بَلْ جِئْتَ تَرسُمُ دَرباً لِلَّذينَ وَعوا","ساروا عَليهِ بِوَجْهِ الظُلمِ فَانْقَمَعا",54,"ع",2,0],["بل جلا بدرا لكم هالته","قدس لبنان وبيت المقدس",55,"س",1,0],["بل جاد لي بجهوده ودعائه","مهما دعوتُ فلن أوفّيكم ولا",56,"ا",1,0]]}