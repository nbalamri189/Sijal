470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5690,"أسيرُ وقلبي في الغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[5703,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=207240",""],[5725,"يعز علينا","https://www.poetsgate.com/ViewPoem.aspx?id=201701",""],[402,"أبقى ويرفض حولي عقد خلاني","https://www.poetsgate.com/ViewPoem.aspx?id=36429",""],[5784,"لكاع","https://www.poetsgate.com/ViewPoem.aspx?id=202535",""],[5848,"با علم عليك","https://www.poetsgate.com/ViewPoem.aspx?id=53156",""],[5849,"سمراءُ أم بيضاء ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=191276",""],[520,"أيخفى صحيح الوجد والسقم لائح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577462",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6228,"أمّة المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[6259,"أيا من نعاه لسانُ القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59411&r=&rc=59",""],[572,"جَنّبكَ الهُ عارضَ العِلَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9438&r=&rc=295",""]],"verses":[["يعزره على الأعداء رعب","يشي بالنصر من قبل النزال",0,"ل",1,0],["يعزّره على الجلّى لسان","يجرد في ضلالتها كتابا",1,"ب",2,0],["يَعِزُّ عَلَيَّ أَن يَمضي وَتَبقى","وَأَن يَرِدَ المَنونَ وَأَنتَ حَيُّ",2,"ي",1,0],["يَعِزُّ عَلَيَّ أَن أَطويهِ صَفحاً","وَأَذهَبَ عَنهُ نَأياً أَو بِعادا",3,"د",2,0],["يَعِزُّ عَلينا أَن تَفوتَ وَأَنَّها","قَضَت نَحبَها أَو ما اِنقَضَت زَفَراتُها",4,"ت",3,0],["يَعزونَ بَينَ وَبَرٍ وَقِدِّ","عِبدانُ بَينَ عاجِزٍ وَوَغدِ",5,"د",1,0],["يَعِزُّ اِعتِصارُ الفَتى وارِداً","إِذا البارِدُ العَذبُ أَهدى الجَرَض",6,"ض",1,0],["يَعِزُّ عَلَيَّ أَن نَغدو جَميعًا","وَتُصبِحَ ثاوِيًا رَهناً بِوادِ",7,"د",1,0],["يَعِزُّ الحِمَى مِنْهُمْ بِكُلِّ مُهَذَّبٍ","لَهُ أَدَبٌ جَمٌّ وَفَضْلٌ وَعِرْفَانُ",8,"ن",1,0],["يَعِزُّ اِبنَ عَبدِ اللَهِ مَن أَنتَ ناصِرٌ","وَلا يَنصُرُ الرَحمانُ مَن أَنتَ خاذِلُه",9,"ل",2,0],["يعز على دين الهدى أن شمسه","يطول بأطباق التراب تواريها",10,"ي",3,0],["يعز على زُهر النجوم متى سَرَتْ","ولا تلمحُ الهديَ الذي كان يَهديها",10,"ي",3,0],["يعِزّ على أسيافنا اليوم أنها","تقارع قوماً قرعهم بالعصا أحرى",11,"ر",2,0],["يعزّ علينا أهل برقة أنكم","تدور عليكم بالدمار رَحى الحرب",12,"ب",1,0],["يَعُزُّ عَلى الطَريقِ بِمَنكَبَيهِ","كَما اِبتَرَكَ الخَليعُ عَلى القِداحِ",13,"ح",1,0],["يُعَزُّ عَلَى أحمَدٍ بالذي","أصَابَ ابنَهُ أمسِ من يُوسُفِ",14,"ف",1,1],["يَعُزُّ عَلى الأَحِبَّةِ بِالشَآمِ","حَبيبٌ باتَ مَمنوعَ المَنامِ",15,"م",1,1],["يعزّ عليها نار حزنٍ تمسّه","وتلك بجنَّات العلى تتمتَّع",16,"ع",1,0],["يعزُّ على المشتاق يا طلل النقا","بلاه على حكم النوى وبلاكا",17,"ك",2,0],["يُعزَى إلى السند ويعتدُّهُ","في الروم لون ناصع أحمر",18,"ر",1,0],["يَعُزُّ عَلى المَصرِيِّ أَن يَحمِلَ الأَذى","وَحاضِرُهُ يَأبى الهَوان وَغابِرُه",19,"ر",2,0],["يَعِزُّ عَلَيَّ فَقدُكَ يا عَلِيُّ","أَلا لِلَّهِ ذا الأَجَلُ الوَحِيُّ",20,"ي",1,1],["يُعزى لَكَ الإِحسانُ غَيرَ مُدافِعٍ","وَالمُحسِنونَ كَما عَلِمتَ قَليلُ",21,"ل",1,0],["يَعِزُّ عَلَيَّ حينَ أُديرُ عَيني","أُفَتِّشُ في مَكانِكَ لا أَراكا",22,"ك",2,0],["يُعزى لِقَومٍ سادَةٍ يَمَنِيَّةٍ","أَعلى الوَرى قَدراً وَأَزكى مَحتِدا",23,"د",2,0],["يَعِزُّ عَلى نَفسي إِذ رُمتُ راحَةً","بِراحٍ فَتُثنيني الطِباعُ الكَرائِمُ",24,"م",1,0],["يعز على عيني الشقية ان ترى","لليلى بقربي منزلا غير محلال",25,"ل",1,0],["يَعزّبنا ويقهر من يشاء","كأنا تحت رايته القضاء",26,"ا",2,0],["يَعِزُّ عَلَيهِ أَن يُخِلَّ بِعادَةٍ","وَتَدعو لِأَمرٍ وَهوَ غَيرُ مُجيبِ",27,"ب",1,0],["يعزُّ عليَّ أنْ آنستِ قبراً","حللتِ به وأوحشتِ الحريما",28,"م",2,0],["يَعِزُّ عَلَيَّ ماصَنَعَت سُلَيمٌ","بِكُم وَالحَربُ فاحِشَةٌ شَناعُ",29,"ع",1,0],["يَعِزُّ عَلى الوَشينَ لَو يَعلُمونَها","لَيالٍ لَنا نَزدارُ فيها وَنَلتَقي",30,"ق",2,0],["يَعِزُّ غَنِيُّ النَفسِ إِن قَلَّ مالُهُ","ويَغنى غَنِيُّ المالِ وَهوَ ذَليلُ",31,"ل",1,0],["يُعَزّونَني قَومُ بِراءٌ مِنَ الصَبرِ","وَفي الصَبرِ أَشياءُ أَمرُّ مِنَ الصَبرِ",32,"ر",1,1],["يَعَزّي المُعَزّي ثُمَ يَمضي لِشَأنِهِ","وَيَبقى المُعَزّى في أَحَرِّ مِنَ الجَمرِ",32,"ر",1,0],["يَعِزُّ عَلى التَنَزُّهِ مَن رَعاهُ","وَيَستَغني العَفيفُ بِغَيرِ مالِ",33,"ل",1,0],["يَعِزُّ عَلى هارونَ ما قَد لَقيتُهُ","وَما نابَني مِن ناقِصِ الخَلقِ أَعوَرِ",34,"ر",1,0],["يَعِزُّ عَلَيَّ أَنَّكَ لا تَراني","وَإِنّي لا أَراكَ وَلا رَسولي",35,"ل",2,0],["يُعَزَّونَ عَن ثاوٍ تُعَزّى بِهِ العُلى","وَيَبكي عَلَيهِ الجودُ وَالبَأسُ وَالشِعرُ",36,"ر",1,0],["يُعَزَّى الْفَتَى فِي كُلِّ رُزْءٍ وَلَيْتَهُ","يُعَزَّى عَلَى فَقْدِ الشَّبَابِ الْمُزَايِلِ",37,"ل",1,1],["يَعَزُّ عَلَيكَ أَنّي عَنكَ ناءٍ","تَرى تِلكَ الوُفودَ وَلا تَراني",38,"ن",2,0],["يُعزَى الإِمامُ إلَى الإِمامِ وَيَقْتَدِي","للمُقْتَدى بِهُدَاهُ فضلُ المُقْتَدِي",39,"د",2,0],["يَعِزُّ على الحسناءِ أن أطأ القَنا","وأعثِرَ في ذَيْلِ الخَميسِ العَرَمرَم",40,"م",1,0],["يَعِزُّ عَلَيَّ وَلَكِنَّني","بِحَمدِ إِلَهي عَلَيهِ أَهونُ",41,"ن",1,0],["يُعَزَّرُ المَلكُ تَوقيراً وَحُقَّ لَهُ","عَلى المَآثِمِ تَأديبٌ وَتَعزيزُ",42,"ز",1,0],["يعز على عينيّ أَن تنظرا إلى","بلاد تسوس الناس فيها قرودها",43,"د",3,0],["يعز على عينيَّ أن تريا بها","شباباً من الأحرار صفراً خدودها",43,"د",3,0],["يعز عَلَينا أَن يلم بك الرَدى","وَيذبل ذاكَ الزهر وَالورق النضر",44,"ر",1,0],["يعز علينا أَن يَسير لغربة","نَديمٌ وَلا نَمشي إليه نودع",45,"ع",1,0],["يَعِزّ علينا أن يظَلّ ابْنُ دَأيَةٍ","يُفتّشُ ما ضُمّتْ عليه شُؤونها",46,"ن",3,0],["يَعِزُ أَسَاهَا مَا حَييتُ وَهَذِهِ","مَآتِمُهُمْ لاَ تَنْقَضِي وَالمَشَاهِدُ",47,"د",1,0],["يُعَزّونَ عَنكِ وَأَينَ العَزاءُ","وَلَكِنَّها سُنَّةٌ تُستَحَب",48,"ب",1,0],["يَعْزُو ويُنْصَرُ لاَ أَشْلاَءُ مَعْرَكَةٍ","تُرَى وَلاَ وَثَبَاتٌ حَوْلَ أَسْوَارِ",49,"ر",1,0],["يعِزُّ دفاعُ الموتِ عن كُلِّ حيلة","ٍ ويَعْيَا بداءِ المَوْتِ كلُّ دَواءِ",50,"ا",2,0],["يعزُّ ابنَ عبدِ اللهِ منْ أنتْ ناصرٌ","ولا ينصرُ الرَّحمنُ منْ أنتْ خاذلهْ",51,"ل",2,0],["يَعزُّ عَلَى الوَاشِينَ، لَوْ يَعْلَمُونَها،","لَيَالٍ لَنَا نَزْدادُ فيها، وَنَلْتَقي",52,"ق",2,0],["يُعزَّرُ المَلْكُ، توقيراً، وحُقّ لهُ،","على المآثمِ، تأديبٌ وتعزيرُ",53,"ر",1,0],["يعز على الصب المتيم ان يرى","مقاما له اهوى تقلبه الاهوى",54,"و",2,0],["يَعِزُّ القَوافِل سَهلَ الطَريقِ","إِذا طابَقَت وَعثَهُنَّ الحِرارا",55,"ر",2,0],["يَعِزُّ عَلَيكَ رَمُيكَهَا ومَهمَا","رَمَيتَ فَرَميَةٌ مِن غَيرِ رَامِ",56,"م",1,0],["يُعَزّيني أَبو وَهبٍ وَلَيثٌ","وَيَعذِلُ مالِكٌ وَأَبو دَكينِ",57,"ن",1,1],["يعزِّيك عقلُك عمّن مضى","وعلمُك أن ما لشيء دوامُ",58,"م",1,0],["يعِزُّ على الهِيم الخوامسِ وِردُها","إذا كان ما بين الشفاه غديرُها",59,"ر",3,0],["يَعِزُّ جِوارُهُ وَالخَوفُ فاشٍ","وَيُخضَبُ جارُهُ وَالعامُ ماحِل",60,"ل",1,0],["يَعِزُّ عَلَينا أَن يُفارقَ بَعدَما","تَمَنَّيتُ دَهراً أَن يَكونَ مُجانِبي",61,"ي",1,0],["يَعزِز عَلَيكَ جَدَّنا مُقامُنا","وَمَصرَعٌ في الطفِّ أَيُّ مَصرَعِ",62,"ع",1,0],["يُعِزُّ مُهِينَهُ وَيُهينُ لُؤماً","مُكَرِّمهُ كَذا النُطَفُ الحَرامُ",63,"م",1,0],["يَعِزُّ عَلَيْهِ وَأَنِي بِهِ","يَرانِي لِفَضْلِي أَسِيراً فَرِيدَا",64,"د",2,0],["يَعِزُّ وَاللَه عِندي أَن أُعَزيكُم","عَنهُ وَدَمعُ جُفوني فيهِ مُنتَثِرُ",65,"ر",1,0],["يعزِّي الناسُ بعضهمُ","ولا يجديهمُ شيَّا",66,"ي",2,1],["يعز علينا ان نعزيكم به","وما هي إلا سنة ضمنها الصبر",67,"ر",1,0],["يعزّ عليّ تحت الترب تمشي","بعيد الدار مع قرب المزار",68,"ر",1,0],["يَعزُّ عَلَيهِ أَن تَشقى بِلادٌ","بِها من شيمَةِ الأَجيالِ عتقُ",69,"ق",1,0],["يُعِزّ على الدهرِ أَنصارَها","ويضرِب بالسيف خُذّالَها",70,"ل",3,0],["يَعزّ على سيفي ورمحِي وهِمَّتي","جلوسي جبانا تحتَ حادثةٍ أَبْكي",71,"ك",2,0],["يعِزُّ على الزهراء ذِلَّةُ زينب","وقتلُ حسين والقلوبُ شِداد",72,"د",1,0],["يَعِزُّ عَلى زُرقِ الأَسِنَّةِ عَودُها","وَما نَهَلَت مِنهُم ذُوابِلُها السُمرُ",73,"ر",1,0],["يَعِزُّ لَهُ وِردٌ وَفيهِ مَذَلَّةٌ","فَيُعرِضُ عَنهُ وَهوَ صادٍ مُلَوِّحُ",74,"ح",1,0],["يَعِزُّ عَلَيَّ فِرَاقُكَ يَا","غَزَالَ النَّقَا وَرَشَا الأَجْرُعِ",75,"ع",1,0],["يعزُّ عَلى صيدِ المُلوكِ مَنالُه","وَيحكُمُ فيهِ سُوقَةٌ مُتَذَلِّلُ",76,"ل",1,0],["يعز على الساعين بالجد مجدهم","ولم ينل الجوزاء بالسعي سائل",77,"ل",1,0],["يعز على الطائي وشاحها","وتغز وحشا الكندي الفاظها الغر",78,"ر",1,0],["يعزُّ علينا أن نراها مريضةً","ولو أكثرت من حبِّها بيننا المرضى",79,"ض",2,0],["يعزُّ علينا أن تمو