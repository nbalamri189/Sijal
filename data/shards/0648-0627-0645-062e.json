{"poems":[[65,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[438,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[463,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58298","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147278","المتقارب"],[5010,"جدّف","https://www.poetsgate.com/ViewPoem.aspx?id=189903",""],[5162,"ضاد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=196715",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5956,"صور أشواق زوجتي إليّ","https://www.poetsgate.com/ViewPoem.aspx?id=182397",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""]],"verses":[["وَأُمِّ خِشفٍ ضَلَّتْهُ فاِنطَلَقَتْ","تَنشُدُهُ والِهاً وَينشُدُها",0,"د",3,0],["وَأَمَّ خَيبَرَ عَبدُ اللَّهِ في نَفَرٍ","إِلى اليَسِير فَأَرداهُ بِلا أَتَمِ",1,"م",1,0],["وامخِضْ بها الدهرَ لكي","تُعطيك زُبْدَ الحلَبِ",2,"ب",1,0],["وأمِّ خَشْفٍ لو أحسَّتْ هوًى","عن ريمها لم تتعطَّفْ لريمْ",3,"م",1,0],["وأمّ خشف طيّبٍ حديثُها","بين الوشاة طاهرٍ إزارُها",4,"ر",3,0],["وامخروا من نورها في لجة","واركبوا من شعره أجرى سفين",5,"ن",1,0],["وأُمُّ خُراذقَ العَذراءَ لمّا","رآها الُعْقُطريّا غيرَ بكر",6,"ر",1,0],["وأمخر بحر الطموح هوىً","عسى مركبي يلتقي صبوتي",7,"ت",2,0],["وامخرْ عبابَ اليأسِ قلبُك واثقٌ","بالنّصرِ والتّمكينِ والتّأييدِ",8,"د",1,0],["وامخرْ بحورَ الشعرِ كُنْ متمكناً","فُزْ بالشراعِ بحنكةِ السفانِ",9,"ن",1,0],["وامخر عباب معانيها وجوهرها","يدِنْ لك البحر فاقتده بلا لُجُم",10,"م",1,0],["وامخر القلبَ بعينٍ من خَفَرْ","إنما عَينُكَ تدني لي القمرْ",11,"ر",1,0],["وأمخر ما فيك من ماءِ ملْحٍٍ","كأنك زوجٌ بها غارق",12,"ق",1,0]]}