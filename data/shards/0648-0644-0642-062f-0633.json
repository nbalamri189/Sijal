{"poems":[[77,"سبق القضاء وأبرم المحتوم","https://www.aldiwan.net/poem36093.html","الكامل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[93,"يا فاقد الولد الوحيد عجبت","https://www.aldiwan.net/poem9850.html","الكامل"],[88,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[4,"قضي الأمور وأنجز الموعود","https://www.aldiwan.net/poem21156.html","الكامل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[51,"ولقد سئمت مآربي فكأن طيبها خبيث","https://www.aldiwan.net/poem9214.html","مجزوء الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[49,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[66,"خدمتي في الهوى عليكم حرام","https://www.aldiwan.net/poem38794.html","الخفيف"],[80,"ولقد سريت بفتية قطعوا الفلا","https://www.aldiwan.net/poem31534.html","الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[105,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85497","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16692","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16660","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[45,"لا يَرِمْ رَبْعَكَ السّحابُ يَجُودُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31418",""],[107,"ومليحة بالرقمتي","https://www.aldiwan.net/poem16527.html","مجزوء الكامل"],[126,"مذ مدة ما جاءنا","https://www.aldiwan.net/poem50602.html","مجزوء الكامل"],[141,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[141,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[141,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[158,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[158,"الفرق بين الكفر والإيمان","https://www.aldiwan.net/poem59187.html","الكامل"],[183,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[184,"يا غرفتي إن غرفة نطقت","https://www.aldiwan.net/poem43871.html","الكامل"],[227,"ويلي من الرشأ الذي","https://www.aldiwan.net/poem50749.html","السريع"],[227,"أخلصت إخلاص المحب المغرم","https://www.aldiwan.net/poem50826.html","الكامل"],[233,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[257,"بمدام أنس مقام إبراهيما","https://www.aldiwan.net/poem35807.html","الكامل"],[257,"جل من أعلى منارك","https://www.aldiwan.net/poem35944.html","مجزوء الرمل"],[259,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[268,"الورد في خديك لاح","https://www.aldiwan.net/poem35577.html","مجزوء الكامل"],[278,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[295,"لولا ازديارك في الكرى وهنا","https://www.aldiwan.net/poem33143.html","أحذ الكامل"],[302,"يا ربنا يا ربنا","https://www.aldiwan.net/poem16747.html","مجزوء الكامل"],[302,"ولى الزمان وولت الأيام","https://www.aldiwan.net/poem16867.html","الكامل"],[320,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[324,"حي المنابر بالسلام","https://www.aldiwan.net/poem44246.html","مجزوء الكامل"],[326,"كبرت للروح الأمين","https://www.aldiwan.net/poem55004.html","مجزوء الكامل"],[362,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[364,"الأرض واسعة نعم لكنهم","https://www.aldiwan.net/poem17335.html","الكامل"],[374,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[377,"منع القرار متيم","https://www.aldiwan.net/poem49236.html","مجزوء الكامل"],[413,"ما لي أفارق كل يوم صاحبا","https://www.aldiwan.net/poem53942.html","الكامل"],[413,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[413,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[413,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[413,"ما لي أودع كل يوم صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[413,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[429,"منع السلو لعاذر ولعاذل","https://www.aldiwan.net/poem12347.html","الكامل"],[429,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[429,"بكرت لنصحك يا أبا بكر","https://www.aldiwan.net/poem12637.html","أحذ الكامل"],[429,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[431,"ولقد سمعت محمد بن عطية","https://www.aldiwan.net/poem25703.html","الكامل"],[438,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[438,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[456,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[456,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[462,"ياضرة القمرين في شرفيهما","https://www.aldiwan.net/poem3310.html","عموديه"],[462,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[462,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[462,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[462,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[480,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[549,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[549,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[560,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[565,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[573,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[573,"رقدت ولواحظ مسهري","https://www.aldiwan.net/poem2946.html","مجزوء الكامل"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[573,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["وَلَقَدْ سَهِرْتُ مُفكِّراً وَالْبَدْرِ فِي","بَحْرِ السَّمَاءِ مَعَ النُّجُومِ يَعُومُ",0,"م",1,0],["وَلَقَد ساءَها البَياضُ فَلَطَّت","بِحِجابٍ مِن دونِنا مَسدوفِ",1,"ف",1,0],["وَلَقَد سَئِمتُ مِنَ القَريضِ وَنظمِهِ","ما حيلَتي بِبِضاعَةٍ لا تُشتَرى",2,"ر",2,0],["ولقد سما خلقاً وعز نقيبه","وغلا حلى فلأجل ذاك أضعته",3,"ت",2,0],["ولقد سمعت أبا يزيد هاتفاً","بمقالة دُهش العدى بمآلها",4,"ل",3,0],["وَلَقَد سَبَقتُ فَما وَرائي لاحِقٌ","بَدءً وَخُلِّيَ في الجِراءِ عِناني",5,"ن",2,0],["وَلَقَد سَمَوتَ إِلى النَصارى سَموَةً","رَجَفَت لِوَقعَتِها جِبالُ الديلَمِ",6,"م",1,0],["وَلَقَد سَئِمتُ مِنَ الحَياةِ وَطولِها","وَسُؤالِ هَذا الناسِ كَيفَ لَبيدُ",7,"د",1,0],["وَلَقَد سُرِرتُ كَما غَمَمتُ عَشائِري","زَمَناً وَهَنّاني الَّذي عَنّاني",8,"ن",2,0],["ولقد سقيت بكأس فيك مدامة","في غيظ لوّامي عليك فلا سقوا",9,"ق",3,0],["ولقد سئمتُ مآربي","فكأنَّ طيِّبَها خَبِيثْ",10,"ث",1,1],["وَلَقَد سَما لَكُمُ الهُذَيلُ فَنالَكُم","بِإِرابَ حَيثُ يُقَسِّمُ الأَنفالا",11,"ل",2,0],["وَلَقَد سَعَيتُ إِلى العَلاءِ بِهِمَّةٍ","تَقضي لِسَعيِي أَنَّهُ لايُلحَقُ",12,"ق",1,0],["ولقد سرني كما سر غيري","ما بها من نزاهة الاحكام",13,"م",1,0],["ولقد سر السامعين حوار","بينه في الهوى وبين القماري",14,"ر",2,0],["ولقد سرت فاحصا لا تبالي","أسهولا قد جبتها ام حزونا",15,"ن",2,0],["ولقد سلبتُ مِراحَهنَّ إِلى حمَى","ملكٍ له ربُّ السماءِ مُعينُ",16,"ن",1,0],["وَلَقَد سادَ مُفضِلينَ وَأَعلى","مُستَقَرّاً مِن سَيِّدٍ مَن يَسودُه",17,"د",2,0],["وَلَقَد سَكَنتُ مِنَ الصُدودِ إِلى النَوى","وَالشَريُ أَريٌ عِندَ أَكلِ الحَنظَلِ",18,"ل",1,0],["وَلَقَد سَكَنتَ صُحونَ دارِ تَقَلُّبٍ","أَبلى وَأَفنى دارَكَ التَقليبُ",19,"ب",1,0],["وَلَقَد ساءَني شَماتُ الأَعادي","فِيَّ لَمّا زَلَّت بِيَ الأَقدامُ",20,"م",1,0],["ولقد سريتُ بفتيةٍ قطعوا الفلا","بعزائمٍ مثلِ الصوارم سُلّتِ",21,"ت",1,1],["وَلَقَد سَلَوتَ لَوَ اَنَّ داراً لَم تَلُح","وَحَلُمتَ لَو أَنَّ الهَوى لَم يَجهَلِ",22,"ل",1,0],["وَلَقَد سَمِعتَ فَهَل سَمِعتَ بِمُوطِنٍ","أَرضَ العِراقِ يُضيفُ مَن بِالمَوصِلِ",22,"ل",1,0],["ولقد سَعِدتَ بها شهادةَ مُؤمنٍ","ما كنتَ لو كبرتْ عليك لتسعدا",23,"د",2,0],["وَلَقَد سَبَقتَهُمُ إِلَي","يَ فَقَد نَزَعتَ وَأَنتَ آخِر",24,"ر",1,0],["ولقد سمعتُ اللّهَ يندُبُ خَلْقَهُ","جَهْراً إلى الإفضالِ والإحسانِ",25,"ن",1,0],["ولقد سمعتُكَ لا بسَمعي هيبَةً","لكنْ وجَدتُكَ جوهراً معقولا",26,"ل",2,0],["وَلَقَد سَما بك للعروبة جانب","ضخم تخر لعزه الأطواد",27,"د",1,0],["وَلَقَد سلكت سَبيل وا","ديها المخوف بِلا خَفير",28,"ر",1,0],["ولقد سَرَيْتُ الليلَ يُصْبِحُ نجمُه","ثَمِلَ الضّياءِ كأنّه مَوْعوك",29,"ك",1,0],["ولقد سَلَوْتُ عن الشبابِ كما سَلا","غَيري ولكنْ للحزينِ تَذكُّر",30,"ر",1,0],["ولَقَد ساءَني زِيارَةُ ذي قُر","بَى حَبيبٍ لِوِدِّنا مُشتاقِ",31,"ق",1,0],["وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","جَلْدٍ مِنَ الْفِتْيَانِ غَيْرِ مُهَبَّلِ",32,"ل",1,1],["ولقد ساد مفضلين وأعلى","مستقر من سيد من يسوده",33,"د",2,0],["وَلَقد سَجَنت فَكُنت سَي","فاً ماضياً وَالسجن غَمدا",34,"د",2,0],["ولقدْ سمعت بِأَنكم","جِئتم إلى العلمَ الأَبرُّ",35,"ر",1,0],["وَلَقَد سَلَكتَ وَما اِتَّخَذتَ مُرافِقاً","نَهجاً إِلى العَلياءِ لَيسَ بِمَهيَعِ",36,"ع",1,0],["وَلَقَد سَمِعتَ كَما سَمِعنا عَنهُمُ","وَعَلِمتَ بِالإِحسانِ ما لَم يَعلَموا",37,"م",3,0],["وَلَقَد سَمَت شَرَفاً مُلوكٌ قُسِّمَت","فيما تَقَدَّمَ بَينَها بُلدانُهُ",38,"ن",2,0],["ولقد سمعت بأن بعض عداتكم","غرته احلام حكاها المرقدُ",39,"د",1,0],["ولقد سمعتك يا بان روبك حاكيا","عن هؤلاء بمجلس السلطان",40,"ن",1,0],["ولقد سَقاني من كؤوسِ غَرامِه","أَضعافَ ما اسْتعذبتُ من رَشفاتِه",41,"ت",2,0],["ولقد سكنتك مرّة مرحا","مالي لى ذي عورة وطار",42,"ر",1,0],["ولقد سألتُ مُعَذَّبي","يومَ التفرُّقِ قُبْلَتَينِ",43,"ن",1,0],["ولقد سألتُ الله ربَّ محّمدٍ","ودعوتُ فِيكَ له دعاءَ الأبكَم",44,"م",1,0],["وَلَقَد سَرَّ آنِفاً ظَفَرٌ جا","ءَت عَلى رِقبَةٍ بِهِ الأَنباءُ",45,"ا",2,0],["ولقد سقاهم كأس بأس طعانه","فيهم سموماً في الوغى وحميما",46,"م",2,0],["ولقد سوّاك نوراً","في سما قلبي أنارك",47,"ك",1,0],["ولقد سمعت ولا أخالك سامعاً","بكثير والواله المجنون",48,"ن",1,0],["ولقد سمعتُ صفيرَ بُل","بلكِ المرجِّعِ للنوّاح",49,"ح",1,0],["وَلَقَدْ سَرَيْتُ إِذا السَّماءُ تَخالُها","بُرْداً بِراكِدَةِ النُّجُومِ مُشَبْرَقا",50,"ق",2,0],["وَلَقَد سأَلتُ عَريفَ ركبِهمُ","عنها فقال ترحَّلت مَعنا",51,"ن",2,0],["وَلَقد سَبَتهُ حُظوظُهُ","حَتّى لَقِيَ مِنها العَنا",52,"ن",2,0],["ولقد سباني حسنهم وجمالهم","وجميلهم والفضل والأنعام",53,"م",1,0],["وَلَقَد سَمِعتُ بِطائِراتٍ في الدُجى","شُرُدُ النَهارِ وَما لَهُنَّ جَناحُ",54,"ح",1,0],["وَلَقَد سَكِرتُ مِنَ الهَوى","سُكرَ الغَوِيِّ مِنَ المُدامِ",55,"م",1,0],["ولقد سألت الروح ما","حال الكرام الوالدين",56,"ن",1,0],["ولقد سَئمْتُ من المُقامِ بمَوطنٍ","مُتَطاوِلَ التَكْديرِ والتَنْكيد",57,"د",1,0],["وَلَقَد سَكَتُّ عَلى الزَمانِ وَما جَرى","يَوماً وَلا يَجري عِتابٌ بَينَنا",58,"ن",2,0],["ولقد سهرت على مديحك ليلةً","حلف الصباحُ بأنه لا يشرق",59,"ق",1,0],["وَلَقد سَمعت مَع الصَبا","ح حَمامَةً تَتَرَنَم",60,"م",1,0],["ولقَد سئِمْتُ من الحياة ومَلَّني","طولُ الثواء فلا أُريد حياتا",61,"ت",2,0],["ولقد سَتَرْتَ على عوادي بلدةٍ","لولاك لم يستر وحقّك عارها",62,"ر",3,0],["ولقد سأَلتَ فما أجابك رَبْعه","فعلامَ تُكثِرُ بعدَها بسؤاله",63,"ل",2,0],["ولقدْ سَدَدْتُ عن العَذول مسامعي","ورأيتُ أنَّ الرَّأي غير سداده",64,"د",2,0],["ولقد سئمتُ العيش بعد وفاتهم","وقطَعت من طمعي بهم أعلاقي",65,"ي",1,0],["ولقد سئمت من الحياة","بما أُشاهد أو أُكابد",66,"د",1,0],["ولقد سَهِرْتُ الليلَ فيكَ مُنَاجيًا","لبلابلٍ صَدَحَتْ صُدوحَ بلابل",67,"ل",1,0],["ولقد سِرْتُ بأرضٍ","مهمَهٍ ذاتِ هِضابِ",68,"ب",1,0],["ولقد سمحْتُ وما أسِفْتُ لها","لو كان في إيرادِها يَدْري",69,"ر",2,0],["ولقد سرتُ والدُجى ألبسَ الأر","ضَ ثياباً ولسنَ بالأخلاقِ",70,"ق",1,0],["وَلَقَدْ سَمِعْتُ مُحَمَّدَ بْنَ عَطِيَّةٍ","فَسَمِعْتُ إِسْحاقَ بن إِبْراهِيمِ",71,"م",1,1],["ولقد سعينا نرتجي منك الرضا","فاقبل مساعينا إليك وسعينا",72,"ن",2,0],["ولقد سألت طلولها","عن آهليها الماضيه",73,"ي",2,0],["ولقد سترتُ عن الوشاة طروقَها","ومكانُها لنبالهم مستهدَفُ",74,"ف",1,0],["ولقد سريتَ بليلهِ وبصبحهِ","فَحَماً وفي لَهَبِ البياض الواقدِ",75,"د",1,0],["ولقد سكنتَ جوانحاً خفاقةً","من بعد لين أسرة ومهود",76,"د",1,0],["ولقد سجنتَ وصيتُ مدكَ مطلقٌ","لك يا ابن يوسفَ إسوةٌ في يوسف",77,"ف",1,0],["ولقد سمعت وما سمعت بكاتبٍ","شيئاً على صفحات ماءٍ مذهب",78,"ب",1,0],["ولقد سكرتُ بما شكرتَ","فما يدارُ سوى ثنايك",79,"ك",1,0],["ولقد سكرتُ بناظريه ومسكرٌ","خمرُ اللحاظ تديرها كاس الوطفْ",80,"ف",1,0],["ولقد سمعت وما سمعت كمثلها","يصبو إليها الدهرَ قلبُ طعينها",81,"ن",3,0],["ولقد سكرتُ ولم تدرْ كفُّ الصّبا","يوم الوداع سوى شمولِ شمائل",82,"ل",1,0],["ولقد سريت إلى العلى في فتيةٍ","خلقوا لطيّ تنائفٍ وبسابس",83,"س",1,0],["ولقد سموت فيما تبالي بعدما","علموا أتمدح أو تذم عدات",84,"ت",1,0],["وَلَقد سريتُ بفِتيَةٍ مُضَرِيَّةٍ","ليلَ التمام إلى الصّباحِ الكاشفِ",85,"ف",1,0],["ولقد سبقتِ صيانةً وديانةً","وَوراءَكِ الطُّلّاحُ والظلّاعُ",86,"ع",1,0],["وَلَقد سننتَ شَريعةً لِلجودِ في","غير الهديّةِ أنّه للحاضرِ",87,"ر",1,0],["ولَقَد سَمَحتُ لهُ بأنْ يكوِي الحَشا","فكَوَى ولكنْ ما رَضِي حتى شَوَى",88,"و",2,0],["وَلَقَدْ سَنَنْتُ من الكِتا","بَةِ للهَوَى طُرُقاً فَسِيْحَهْ",89,"ح",2,0],["ولقد سَمَحتُ بِشَخْصِهِ","وعَجِبْتُ إِذ سَمَح الضَّنِينُ",90,"ن",1,0],["ولقد سُقِيتُ وقد عَطِشْ","تُ بجنَّةٍ وبكَوْثَرِ",91,"ر",1,0],["ولقد سمعتُ وما سمعتُ بواهبٍ","جلَّت مَواهبُ كَفِّه أَنْ تُشْكَرا",92,"ر",2,0],["ولقد سأَلتُ القلبَ بعدَ تَصَبُّرٍ","يَسخُو عليَّ به فشحَّ وما رَشح",93,"ح",1,0]]}