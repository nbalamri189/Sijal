.poetsgate.com/ViewPoem.aspx?id=188305",""],[5948,"عَجَباً لأحمدَ والعجائبُ جمَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=100609",""],[5956,"بيت الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=182131",""],[6069,"ولقد سنحن لنا بحمص جآذرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=105685",""],[6152,"جمر الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=203397",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[463,"هل تحت ليلك بالغضا من رائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60040&r=&rc=96",""]],"verses":[["وَلَقَدْ سَهِرْتُ مُفكِّراً وَالْبَدْرِ فِي","بَحْرِ السَّمَاءِ مَعَ النُّجُومِ يَعُومُ",0,"م",1,0],["وَلَقَد ساءَها البَياضُ فَلَطَّت","بِحِجابٍ مِن دونِنا مَسدوفِ",1,"ف",1,0],["وَلَقَد سَئِمتُ مِنَ القَريضِ وَنظمِهِ","ما حيلَتي بِبِضاعَةٍ لا تُشتَرى",2,"ر",2,0],["ولقد سما خلقاً وعز نقيبه","وغلا حلى فلأجل ذاك أضعته",3,"ت",2,0],["ولقد سمعت أبا يزيد هاتفاً","بمقالة دُهش العدى بمآلها",4,"ل",3,0],["وَلَقَد سَبَقتُ فَما وَرائي لاحِقٌ","بَدءً وَخُلِّيَ في الجِراءِ عِناني",5,"ن",2,0],["وَلَقَد سَمَوتَ إِلى النَصارى سَموَةً","رَجَفَت لِوَقعَتِها جِبالُ الديلَمِ",6,"م",1,0],["وَلَقَد سَئِمتُ مِنَ الحَياةِ وَطولِها","وَسُؤالِ هَذا الناسِ كَيفَ لَبيدُ",7,"د",1,0],["وَلَقَد سُرِرتُ كَما غَمَمتُ عَشائِري","زَمَناً وَهَنّاني الَّذي عَنّاني",8,"ن",2,0],["ولقد سقيت بكأس فيك مدامة","في غيظ لوّامي عليك فلا سقوا",9,"ق",3,0],["ولقد سئمتُ مآربي","فكأنَّ طيِّبَها خَبِيثْ",10,"ث",1,1],["وَلَقَد سَما لَكُمُ الهُذَيلُ فَنالَكُم","بِإِرابَ حَيثُ يُقَسِّمُ الأَنفالا",11,"ل",2,0],["وَلَقَد سَعَيتُ إِلى العَلاءِ بِهِمَّةٍ","تَقضي لِسَعيِي أَنَّهُ لايُلحَقُ",12,"ق",1,0],["ولقد سرني كما سر غيري","ما بها من نزاهة الاحكام",13,"م",1,0],["ولقد سر السامعين حوار","بينه في الهوى وبين القماري",14,"ر",2,0],["ولقد سرت فاحصا لا تبالي","أسهولا قد جبتها ام حزونا",15,"ن",2,0],["ولقد سلبتُ مِراحَهنَّ إِلى حمَى","ملكٍ له ربُّ السماءِ مُعينُ",16,"ن",1,0],["وَلَقَد سادَ مُفضِلينَ وَأَعلى","مُستَقَرّاً مِن سَيِّدٍ مَن يَسودُه",17,"د",2,0],["وَلَقَد سَكَنتُ مِنَ الصُدودِ إِلى النَوى","وَالشَريُ أَريٌ عِندَ أَكلِ الحَنظَلِ",18,"ل",1,0],["وَلَقَد سَكَنتَ صُحونَ دارِ تَقَلُّبٍ","أَبلى وَأَفنى دارَكَ التَقليبُ",19,"ب",1,0],["وَلَقَد ساءَني شَماتُ الأَعادي","فِيَّ لَمّا زَلَّت بِيَ الأَقدامُ",20,"م",1,0],["ولقد سريتُ بفتيةٍ قطعوا الفلا","بعزائمٍ مثلِ الصوارم سُلّتِ",21,"ت",1,1],["وَلَقَد سَلَوتَ لَوَ اَنَّ داراً لَم تَلُح","وَحَلُمتَ لَو أَنَّ الهَوى لَم يَجهَلِ",22,"ل",1,0],["وَلَقَد سَمِعتَ فَهَل سَمِعتَ بِمُوطِنٍ","أَرضَ العِراقِ يُضيفُ مَن بِالمَوصِلِ",22,"ل",1,0],["ولقد سَعِدتَ بها شهادةَ مُؤمنٍ","ما كنتَ لو كبرتْ عليك لتسعدا",23,"د",2,0],["وَلَقَد سَبَقتَهُمُ إِلَي","يَ فَقَد نَزَعتَ وَأَنتَ آخِر",24,"ر",1,0],["ولقد سمعتُ اللّهَ يندُبُ خَلْقَهُ","جَهْراً إلى الإفضالِ والإحسانِ",25,"ن",1,0],["ولقد سمعتُكَ لا بسَمعي هيبَةً","لكنْ وجَدتُكَ جوهراً معقولا",26,"ل",2,0],["وَلَقَد سَما بك للعروبة جانب","ضخم تخر لعزه الأطواد",27,"د",1,0],["وَلَقَد سلكت سَبيل وا","ديها المخوف بِلا خَفير",28,"ر",1,0],["ولقد سَرَيْتُ الليلَ يُصْبِحُ نجمُه","ثَمِلَ الضّياءِ كأنّه مَوْعوك",29,"ك",1,0],["ولقد سَلَوْتُ عن الشبابِ كما سَلا","غَيري ولكنْ للحزينِ تَذكُّر",30,"ر",1,0],["ولَقَد ساءَني زِيارَةُ ذي قُر","بَى حَبيبٍ لِوِدِّنا مُشتاقِ",31,"ق",1,0],["وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","جَلْدٍ مِنَ الْفِتْيَانِ غَيْرِ مُهَبَّلِ",32,"ل",1,1],["ولقد ساد مفضلين وأعلى","مستقر من سيد من يسوده",33,"د",2,0],["وَلَقد سَجَنت فَكُنت سَي","فاً ماضياً وَالسجن غَمدا",34,"د",2,0],["ولقدْ سمعت بِأَنكم","جِئتم إلى العلمَ الأَبرُّ",35,"ر",1,0],["وَلَقَد سَلَكتَ وَما اِتَّخَذتَ مُرافِقاً","نَهجاً إِلى العَلياءِ لَيسَ بِمَهيَعِ",36,"ع",1,0],["وَلَقَد سَمِعتَ كَما سَمِعنا عَنهُمُ","وَعَلِمتَ بِالإِحسانِ ما لَم يَعلَموا",37,"م",3,0],["وَلَقَد سَمَت شَرَفاً مُلوكٌ قُسِّمَت","فيما تَقَدَّمَ بَينَها بُلدانُهُ",38,"ن",2,0],["ولقد سمعت بأن بعض عداتكم","غرته احلام حكاها المرقدُ",39,"د",1,0],["ولقد سمعتك يا بان روبك حاكيا","عن هؤلاء بمجلس السلطان",40,"ن",1,0],["ولقد سَقاني من كؤوسِ غَرامِه","أَضعافَ ما اسْتعذبتُ من رَشفاتِه",41,"ت",2,0],["ولقد سكنتك مرّة مرحا","مالي لى ذي عورة وطار",42,"ر",1,0],["ولقد سألتُ مُعَذَّبي","يومَ التفرُّقِ قُبْلَتَينِ",43,"ن",1,0],["ولقد سألتُ الله ربَّ محّمدٍ","ودعوتُ فِيكَ له دعاءَ الأبكَم",44,"م",1,0],["وَلَقَد سَرَّ آنِفاً ظَفَرٌ جا","ءَت عَلى رِقبَةٍ بِهِ الأَنباءُ",45,"ا",2,0],["ولقد سقاهم كأس بأس طعانه","فيهم سموماً في الوغى وحميما",46,"م",2,0],["ولقد سوّاك نوراً","في سما قلبي أنارك",47,"ك",1,0],["ولقد سمعت ولا أخالك سامعاً","بكثير والواله المجنون",48,"ن",1,0],["ولقد سمعتُ صفيرَ بُل","بلكِ المرجِّعِ للنوّاح",49,"ح",1,0],["وَلَقَدْ سَرَيْتُ إِذا السَّماءُ تَخالُها","بُرْداً بِراكِدَةِ النُّجُومِ مُشَبْرَقا",50,"ق",2,0],["وَلَقَد سأَلتُ عَريفَ ركبِهمُ","عنها فقال ترحَّلت مَعنا",51,"ن",2,0],["وَلَقد سَبَتهُ حُظوظُهُ","حَتّى لَقِيَ مِنها العَنا",52,"ن",2,0],["ولقد سباني حسنهم وجمالهم","وجميلهم والفضل والأنعام",53,"م",1,0],["وَلَقَد سَمِعتُ بِطائِراتٍ في الدُجى","شُرُدُ النَهارِ وَما لَهُنَّ جَناحُ",54,"ح",1,0],["وَلَقَد سَكِرتُ مِنَ الهَوى","سُكرَ الغَوِيِّ مِنَ المُدامِ",55,"م",1,0],["ولقد سألت الروح ما","حال الكرام الوالدين",56,"ن",1,0],["ولقد سَئمْتُ من المُقامِ بمَوطنٍ","مُتَطاوِلَ التَكْديرِ والتَنْكيد",57,"د",1,0],["وَلَقَد سَكَتُّ عَلى الزَمانِ وَما جَرى","يَوماً وَلا يَجري عِتابٌ بَينَنا",58,"ن",2,0],["ولقد سهرت على مديحك ليلةً","حلف الصباحُ بأنه لا يشرق",59,"ق",1,0],["وَلَقد سَمعت مَع الصَبا","ح حَمامَةً تَتَرَنَم",60,"م",1,0],["ولقَد سئِمْتُ من الحياة ومَلَّني","طولُ الثواء فلا أُريد حياتا",61,"ت",2,0],["ولقد سَتَرْتَ على عوادي بلدةٍ","لولاك لم يستر وحقّك عارها",62,"ر",3,0],["ولقد سأَلتَ فما أجابك رَبْعه","فعلامَ تُكثِرُ بعدَها بسؤاله",63,"ل",2,0],["ولقدْ سَدَدْتُ عن العَذول مسامعي","ورأيتُ أنَّ الرَّأي غير سداده",64,"د",2,0],["ولقد سئمتُ العيش بعد وفاتهم","وقطَعت من طمعي بهم أعلاقي",65,"ق",2,0],["ولقد سئمت من الحياة","بما أُشاهد أو أُكابد",66,"د",1,0],["ولقد سَهِرْتُ الليلَ فيكَ مُنَاجيًا","لبلابلٍ صَدَحَتْ صُدوحَ بلابل",67,"ل",1,0],["ولقد سِرْتُ بأرضٍ","مهمَهٍ ذاتِ هِضابِ",68,"ب",1,0],["ولقد سمحْتُ وما أسِفْتُ لها","لو كان في إيرادِها يَدْري",69,