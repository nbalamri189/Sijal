3%D9%85-%D8%A7%D9%84%D8%A7%D9%84%D9%87-%D8%A7%D9%84%D8%B9%D8%A7%D8%AF%D9%84-%D8%A7%D9%84%D9%85%D9%88%D8%AD%D8%AF/%D8%A3%D8%A8%D9%88-%D8%A7%D9%84%D8%AD%D8%B3%D9%8A%D9%86-%D8%A7%D9%84%D8%B5%D9%88%D9%81%D9%8A/","الرجز"],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""],[463,"أولى لها أن يرعوي نفارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60088&r=&rc=144",""],[2220,"في فؤادِ العارفينَ بصرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11465&r=&rc=339",""]],"verses":[["يُعَرّي الغارِبَ الأَعلى وَيُحذي","عَظيمَ العِزِّ وَالخَطَرَ الأَظَلّا",0,"ل",2,0],["يُعَرّي ظَهرَ أَكثَرِنا عَديداً","وَيَهجُمُ بَيتَ أَطوَلِنا عِمادا",1,"د",2,0],["يُعَرِّفُكَ الإِخوانُ كُلٌّ بِنَفسِهِ","وَخَيرُ أَخٍ مَن عَرَّفَتكَ الشَدائِدُ",2,"د",1,0],["يُعَرِّدُ عَنهُم كُلُّ حَيٍّ كَأَنَّهُم","جِمالٌ مُطَلّاةُ الجُلودِ جِرابُ",3,"ب",1,0],["يُعرِضُ عَنّي وَالكأسُ في يَدِهِ","وَهوَ بِأَنوارِها قَدِ اِختَضَبا",4,"ب",2,0],["يُعَرِّضنَ طَوراً بِالتَغاضي وَتارَةً","يُعاتِبنَها بِالجَدِّ مِنهُنَّ وَالهَزلِ",5,"ل",1,0],["يُعَرِّجنَ بِالصِمّانِ حَتّى تَعَذَّرَت","عَلَيهِنَّ أَرباعُ اللِوى وَمَشارِبُه",6,"ب",2,0],["يعربيّ بنجره","تشرف العرب أن ذكر",7,"ر",1,0],["يعرف النيل فضلها وعلاها","من قديم ويشهد الدردنيل",8,"ل",1,0],["يعرف السَقْبَ قبل أن ينتج السل","تم أهل الجهالة العنقفيرا",9,"ر",2,0],["يُعَرِّفونَكَ رَأسَ اِبنِ الحُبابِ وَقَد","أَضحى وَلِلسَيفِ في خَيشومِهِ أَثَرُ",10,"ر",1,0],["يُعرَضُ المالِكونَ أَسرى عَلَيها","في قُيودِ الهَوانِ عانينَ جَرضى",11,"ض",2,0],["يَعرِفُ الدينُ مَن صَلاحٌ وَيَدري","مَن هُوَ المَسجِدانِ وَالإِسراءُ",12,"ا",2,0],["يعرفه الناس جميعاً ولا","يدرون ما فيه من الأمرِ",13,"ر",1,0],["يُعرِّضها للطعن من لا يرُدُّهُ","عن البأسِ والأفضال ذعرٌ وتأنيبُ",14,"ب",1,0],["يَعرى مِنَ المالِ أَفضالاً وَنُلبِسُهُ","وَشياً مِنَ المَدحِ لَم تُخلِق مَباذِلُهُ",15,"ل",2,0],["يُعرَفُ السَيفُ بِالضَريبَةِ يَلقا","ها وَيُنبي عَنِ الصَديقِ إِمتِحانُه",16,"ن",2,0],["يعرِّيكُمُ من عَصبِه وبُرودِه","عصائبَ شَتَّى لا يَليقُ بها الغَصبُ",17,"ب",1,0],["يَعرِفُني طَرفَهُ وَأَعرِفُهُ","بِنَعتِهِ وَإِسمِهِ وَما فَعَلا",18,"ل",2,0],["يُعرِبُ أَلفاظَهُ فَيَنفُثُ في","سِحرِ المَعاني وَما بِها عُقدُ",19,"د",1,0],["يَعرِفُها مَن كانَ فيها راغِبا","وَصاحِبٍ أُعُدُّهُ لي مالِكا",20,"ك",2,0],["يُعرفُ مَنْ تقبلُهُ أرضُنا","مَنْ لزمَ الأوسطَ مِنْ فعلِهِ",21,"ه",1,1],["يُعَرِّفُ الرَسمَ مِنها","شِسعٌ عَلَيها خَفِيِّ",22,"ي",1,0],["يَعرِفَنَّ المَعروفَ طَبعاً وَيُثني","بِيَدِ الجودِ في عِنانِ الثَناءِ",23,"ا",2,0],["يَعرِفُ لِلنارِ أَبو خالِدٍ","سِوى اِسمَها في الناسِ أَسماءَ",24,"ا",2,0],["يُعَرِّضُني لِفِتنَةِ كُلِّ أَمرٍ","وَيَحمِلُني عَلى مِثلِ السِنانِ",25,"ن",1,0],["يَعرِقنَ خِرّيتاً عَلَيهِ النَدى","كَالبُردِ إِذ تَمَّ بِهِ النيرُ",26,"ر",1,0],["يَعرى اللَئيمُ مِنَ الثَناءِ وَيَكتَسي","حُلَلَ النَواسِجِ فَهوَ كاسٍ عارِ",27,"ر",1,1],["يَعرى الفَقيرُ وَبِالدينارِ كَسوَتُهُ","وَفي صِوانِكَ ما إِعدادُهُ خَرَفُ",28,"ف",1,0],["يَعرى الكَريمُ فَيَعرى بَعدَ مُذهِبَةٍ","صَفراءَ لا يَهجُرُ الصَحراءَ ضافيها",29,"ي",3,0],["يَعرُقُ حدُّ السيفِ من لحمه","ويحطمُ الصّفوانُ بنيانَهُ",30,"ه",1,0],["يَعْرُوكَ دَاءٌ لاَ تُقَاوِمُهُ","وَتَصِيرُ مِنْ غَدهِ إِلى اللَّحْدِ",31,"د",1,0],["يُعْرَفُ الْوَرْدُ حِينَمَا يَنْقَضِي الصَّيْفُ","وَيُبْكي النُّبُوغُ بَعْدَ ذَهَابِهْ",32,"ب",2,0],["يعرِفُ الأَيْهُقَانَ والثولَ والذع","لوقَ والسَيْسَبَي ونوع نباته",33,"ت",2,0],["يعرّى يتزيّا يتيدىّ","أشكالا يبسم يتغضّن",34,"ن",1,0],["يعرّي فضائح هذا الزمان","ويعرّى ، فيبدو كأنقى فضيحه",35,"ح",2,0],["يعرفُ اللقمةَ الهنيئةَ في البيتِ","مُجدٌّ طولَ النهار دَءوب",36,"ب",1,0],["يعرف الفجر أنّ دمعي أصفى","من نداه ويعرف الريحان",37,"ن",1,0],["يعرف الطّيب أنّ دمعي أذكى","منه عطرا وتعرف الأردان..",37,"ن",1,0],["يعرضون الشعوب عرض الجواري","عرّيت للعيون نحرا ونهدا",38,"د",2,0],["يعربيٌّ فَطن أبيٌّ وفىٌّ","فهُو شمسُ الدنيا ونورُ سَنَاهَا",39,"ا",3,0],["يعربيٌّ مهذبٌ ماجدٌ معطٍ","سَريٌّ كهفُ الهدى خيرُ هادِي",40,"د",2,0],["يعربىّ الأعراب يستعبدُ الأح","رار تُرْجَى أفضالُه وصِلاتُه",41,"ت",2,0],["يعرب عن إيمانِ أهل مصرِ","وكيف كان شأوهم في الفكرُ",42,"ر",1,0],["ي