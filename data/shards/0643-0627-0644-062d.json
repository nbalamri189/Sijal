{"poems":[[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[74,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[53,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[87,"حلفت بالمستره","https://www.aldiwan.net/poem62862.html","مجزوء الرجز"],[64,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[63,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[50,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[52,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[234,"آه من منزل طوى إيناسه","https://www.aldiwan.net/poem50976.html","الخفيف"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[308,"قنعت بالعود إلى منزلي","https://www.aldiwan.net/poem58277.html","السريع"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[353,"قلم الوزير هو الشقيق لبيضه","https://www.aldiwan.net/poem20441.html","الكامل"],[358,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[368,"إذا تخازرت وما بي من خزر","https://www.aldiwan.net/poem1737.html","الرجز"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[438,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[438,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[463,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[572,"سارية بين الدياجي السود","https://www.aldiwan.net/poem69731.html","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123379","البسيط"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96298","الكامل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25336","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145101","الرجز"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146951","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48214","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53077","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45675","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137132",""],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26182","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121721","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139932","السريع"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205636","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132139","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114336","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114209","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125917","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4755,"كالحُلمِ لكنْ لَم أَكُنْ غافِيَا","https://www.poetsgate.com/ViewPoem.aspx?id=186357",""],[4767,"خوف وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=209076",""],[4767,"الحَجْر","https://www.poetsgate.com/ViewPoem.aspx?id=211043",""],[4782,"خارطة عينين","https://www.poetsgate.com/ViewPoem.aspx?id=198535",""],[5005,"خلف المساء","https://www.poetsgate.com/ViewPoem.aspx?id=198696",""],[5280,"سيدنا محمد رسول الله ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=189571",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[5458,"رحم الله أم ديبو","https://www.poetsgate.com/ViewPoem.aspx?id=72164",""],[5486,"صدى القلب..","https://www.poetsgate.com/ViewPoem.aspx?id=208743",""],[6060,"وجع","https://www.poetsgate.com/ViewPoem.aspx?id=207935",""],[6079,"إني إلى لقياكم مشتاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=213531",""],[6320,"شَجْوِي الحَزِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84348&r=&rc=45",""]],"verses":[["كَالحُقَّةِ الصَفراءِ صا","كَ عَبيرُها بِمَلابِها",0,"ب",3,0],["كالِحاتٍ مَعاً عَوارِضَ أَشداقٍ","تَرى في مَشَقِّها تَأخيرا",1,"ر",2,0],["كَالحَبشيينِ خافا مِن مَليكِهِما","بَعضَ العَذابِ فَجالا بَعدَما كُتِفا",2,"ف",2,0],["كالحيا قد عمّ محترثاً","ودْقهُ أو غير محترث",3,"ث",1,0],["كالحَسَن المُحسِنِ في شَدوهِ","تمَّ فأضحى مَطرباً مَضرَبا",4,"ب",2,0],["كالحاجةِ الفخمةِ الجليلة من","جاهٍ ومال يميل مِعْياره",5,"ر",2,0],["كالحمدويِّ وكسبِهِ","بل ثروة فينا وذكرى",6,"ر",2,0],["كالحاً في وثاقه الدائم الجِدْ","دة أو عرضه اللبيس الدَريس",7,"س",1,0],["كالحسين المتناهي فضلُه","وإن اغتاظ حسودٌ واضطغن",8,"ن",1,0],["كالحق فهو إن أتى","يزهق منه الباطل",9,"ل",1,0],["كَالحِلمِ أَو كَالوَهمِ أَو","كَالظِلِّ أَو كَالزَهَرَه",10,"ر",2,0],["كالحوت لا يرويه شيء يلهمه","يصبح عطشانا وفي البحر فمه",11,"ه",1,0],["كَالحُسامِ الجُرازِ يَبقى عَلى الدَه","رِ وَيُفنى في كُلِّ عَصرٍ قِرابَه",12,"ب",2,0],["كالحَلْيِ صادَفَ جِيداً شَكْلَ جَوْهَرِهِ","فصَدَّ عن كلِّ جِيدٍ لا يُشاكِلُه",13,"ل",2,0],["كَالحِقفِ حَدَّءُهُ النامونَ قُلتُ لَهُ","ذو ثَلَّتَينِ وَذو بَهمٍ وَأَرباقِ",14,"ق",1,0],["كَالحالِقِ الكاسِرِ لِلتَغويرِ","أَو سَهمِ رامٍ قاصِدٍ طَريرِ",15,"ر",1,0],["كَالحَلي حُسنُ حَديثِها","وَدَلالُها إِحدى المَصايِد",16,"د",1,0],["كالحَوْضِ ألْحَقَ بالخَوالِفِ نَبْتُهُ","سبطٍ عليه من السَّماك مطيرُ",17,"ر",1,0],["كَالْحِقْفِ حَدَّأَهُ النَّامُونَ قلتُ لَهُ","ذُو ثَلَّتَيْنِ وَذُو بَهْمٍ وَأَرْبَاقِ",18,"ق",1,0],["كالح الأرضِ خافِتِ الريح جَهْم الن","نبتِ لم تُنْطِقِ النوى إخراسه",19,"س",2,0],["كَالحِقفِ أَهيَلَ وَالقَضي","بِ مُهَفهَفاً وَالظَبيِ أَجيَد",20,"د",1,0],["كالحجر الملقى إلى صاعد","ليس له هم سوى عودته",21,"ه",1,0],["كالحيّةِ الرقطاءِ لانَ مجسّها","وَاِخشوشَنت حمةٌ لها تستنقعُ",22,"ع",1,0],["كَالحُبشِ مِنها عَلى أَثباجِها بُرَدٌ","قُرعٌ يَعِنُّ بِها هَيقٌ لَها شَوِلُ",23,"ل",1,0],["كَالحُرسِ لا يَستَبينُ السَمعُ مَنطِقَهُم","كَأَنَّهُم مِن سُلافِ الخَمرِ قَد ثَمِلوا",23,"ل",3,0],["كالحديد المصهور يزداد حسنا","بعد أن يصقل الجحيم سنونه",24,"ن",2,0],["كالحيةِ النَّضناضِ إلاَّ أَنَّهُ","يَشفي لِلَسْعِ الدَّهْرِ منهُ الرِّيقُ",25,"ق",1,0],["كَآل حَمادة بَلَغوا المَعالي","فَضمّتهم لَها ضمَّ النِطاقِ",26,"ق",1,0],["كَالحَيَّةِ الصَمّاءِ في أَصلِ الحَجَر","ذا صَولَةٍ في المُصمَئِلّاتِ الكِبَر",27,"ر",1,0],["كالحشر والنشر والوزن لما قد جناه","والجسر والحوض والنيران دار الشقاه",28,"ا",2,0],["كالحيا المنصبِّ بل أندى يداً","والحسام العضب أو أمضى شفارا",29,"ر",2,0],["كالحَيَّةِ النَّضْنَاضِ إِلا أَنَّهُ","مُتَقَسَّمٌ للنفعِ والإِضرارِ",30,"ر",1,0],["كالحافظِ العالِمِ الحَبْرِ الإمامِ ومَنْ","ما مثلُه الآن في هذا الزمان يُرى",31,"ر",2,0],["كالحور في خيامها مقصورة","وفي الفلا مع الظباء الكُنَّسِ",32,"س",1,0],["كالحَبَّتَيْنِ السودِ في العُنْقُودِ","رفعن لي بالطالع السعيد",33,"د",1,0],["كالحِبِّ واعَدَ وَصْلاً وهو مُحتَجِبٌ","فحين بانَ تَقاضَوْهُ فقال غدا",34,"د",2,0],["كالحائمات يَرين شِرباً دونه","رصَدُ الشَريعةِ والقلوبُ صَوادي",35,"د",2,0],["كَالْحُكْمِ وَالْقَضاءِ وَالْحُدُوْدِ","وَكُلِّ أَمْرٍ حادِثٍ جَدِيْدِ",36,"د",1,0],["كالحَيَّةِ المُجْتابِ بِالأَرْقاطِ","يَكْفِيك أَثْرِي القَوْلَ وَانْتِباطِي",37,"ط",2,0],["كَالحُوتِ لا يُرْوِيهِ شَيْءٍ يَلْهَمُهْ","يُصْبِحُ ظَمْآنَ وَفِي البَحْرِ فَمُهْ",38,"م",2,0],["كَالحَيَّة الأَصْيَدِ مِنْ طُول الأَرَقْ","لا يَشْتَكِي صُدْغَيْهِ مِنْ داءِ الوَدَقْ",39,"ق",1,0],["كالحكم للجزء بحكم الكلِّ","كلاهما غشّ وأيّ غشّ",40,"ش",1,0],["كالحات كأنما نفث الصا","ب الغوالي منهن في الأشداق",41,"ق",1,0],["كالحال والمصدر والمنادى","وبسواها لم يكن مرادا",42,"د",2,0],["كالِحَ الوَجهِ لا تَرُدُّ سَلاماً","لَكَأَنَّ السَلامَ مِن أَفضالِك",43,"ك",1,0],["كالحِقْف من تحتِ الغلالة رِدْفُهُ","وقَوامُهُ فالذابلُ المهزوزُ",44,"ز",1,0],["كَالحِقْفِ رِدْفاً والق","ضيب تَأَوُّداً والورد خدّا",45,"د",2,0],["كَالحَاكمِيَّةِ والألَى وَالوهُمُ","كَأبِي سَعِيدٍ ثُمَّ آلِ سِنَانِ",46,"ن",1,0],["كالحذف والتشعيث والحزم وما","كان سواها فهو حتماً لزما",47,"م",2,0],["كَالحسو فيهِ عَدَس","وَجه قَليل البَرَكه",48,"ك",2,0],["كالحبر عواد من دان الزمان له","وبنده بلواء النصر معقود",49,"د",1,0],["كَالحَمدِ تُجزي المُصَلّي حينَ يَقرَأُها","وَلَيسَ يُغنيهِ عَنها سائِرُ السورِ",50,"ر",1,0],["كالحَرْفِ فَرَّ من الْتقاءِ السَّاكنَيْ","نِ لعُسْرِ نُطْقٍ في التَّلفُّظِ فانْكَسَرْ",51,"ر",1,0],["كالحنش المقتول يُلقى على","عودٍ لكي يُلقي على مِزْبلَهْ",52,"ل",2,0],["كالحية الرقشاء إلا أنه","لا يبرأ الملسوع منه إذا رقى",53,"ق",2,0],["كالحبر أو كالحقد أسود كامنٌ","في الترب منطبع على الأحساس",54,"س",1,0],["كَالحَرفِ عِندَ اختِصَاصِهِ لَهُ عَمَلٌ","وَفِي التَّشَارُكِ لَم يَفُز بإِعمَالِ",55,"ل",1,0],["كَالحَرفِ عِندَ اختِصَاصِهِ لَهُ عَمَلٌ","وَفِي التَّشَارُكِ لَم يَفُز بِقِطمِيرِ",56,"ر",1,0],["كالحلم إذ فسّروه","يجيء بالمعكوس",57,"س",1,0],["كَالحِيرَةِ البَيضاءِ إِن ناسَبَها","وَناسَبتَهُ بَهجَةً فَبِالحَرى",58,"ا",1,0],["كالحُلمِ لكنْ لَم أَكُنْ غافِيَا","ما أَتْعَسَ المَنْفِيَّ والنَّافِيَا",59,"ف",3,1],["كالحُلمِ صُرتُ وصُرتِ في جوف الدُّجَى","إني لأرجو أن أراه تحقَّقا",60,"ق",2,0],["كالحشدِ عند حدوث أم","رٍ للجميع تجمهرا",61,"ر",2,0],["كالحلم مرَّ وكالحياة مضى تشيّعهُ السنون","لو يبصرون رأوا حشود هزائمي لويبصرون",62,"ن",1,0],["كالحلم في القنديل صبوا فوقه","ليلا من اليأس المبلل فانطفأ",63,"ا",1,0],["كالحوتِ تُنقِذهُ في قتلِه غرقًا","حبلُ النّجاةِ له في وصلةِ الرّحمِ",64,"م",1,0],["كالحب والتعظيم جل جلاله","تلك الخواطر تحض بالأغلال",65,"ل",1,0],["كالحب يلقى للطيور لصيدها","والعبد مقصوداً لذي الأحبال",65,"ل",1,0],["كالحب والإيمان لن يتلاقيا","في القلب إلا كالتقى الأبطال",65,"ل",1,0],["كالحلم مرت بضع أيام لها","كانت كهدأة مارد قبل الغضب",66,"ب",1,0],["كالحلم كاللاشيئ أنت وإنني","كالسائل اللا نور نورا يشرق!",67,"ق",1,0],["كالحملِ، يوهنُ حبّ الناسِ بعضهمُ","ويشتكون إذا بانوا أو اجتمعوا",68,"ع",3,0],["كالحُرِّ صالَ على العدا بسلاحهِ","فأثابَ هِمّتهمْ بهِ الإرهاقُ",69,"ق",1,0],["كَالحُلْمِ قَدْ عَبَثَ الزَّمَانُ بِسَاحَتِي","كَهْلاً أُكَابِدُهُ وَقَدْ عَزَّ المَعِينْ",70,"ن",1,0]]}