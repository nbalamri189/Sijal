{"poems":[[29,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[87,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[99,"إن عدت أو أخلفت لم تعد","https://www.aldiwan.net/poem24792.html","أحذ الكامل"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[50,"أضجرني الناس يقولون تب","https://www.aldiwan.net/poem66287.html","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45748","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54353","الكامل"],[5358,"متى تعود لنا","https://www.poetsgate.com/ViewPoem.aspx?id=21899",""],[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""],[5975,"معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53260",""],[6093,"أضْجَرتني _يا غبيُّ_ لا تسلِ ( المنسرح )","https://www.poetsgate.com/ViewPoem.aspx?id=176487",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""]],"verses":[["أَضِجّوا الرَوايا بِالمَزادِ فَإِنَّكُم","سَتُكفَونَ كَرَّ الخَيلِ تَدمى نُحورُها",0,"ر",3,0],["أُضجِعَت قَبلَكِ فيهِ مَريَمٌ","وَتَوارى بِنِساءِ المُرَسَلين",1,"ن",1,0],["أضجعتُ جنبي جوف غيهبه","وأرحتُ فيه باليَ الجسدِ",2,"د",1,0],["أَضجَت إِيادٌ في مَعَدٍّ كُلِّها","وَهُمُ إِيادُ بِنائِها المَمدودِ",3,"د",1,0],["أضجَرَني الناسُ يقولون تب","مالي وللناسِ وما شانيه",4,"ن",3,1],["أضجرتني سياسة الناس حيناً","ولئن دام دام لي اضجاري",5,"ر",2,0],["اضجاعُها رديفةً للمنتصب","بقلةٍ كما هنا قد انتخب",6,"ب",1,0],["أَضجعوني على الثرى وافرشوه","بالحصى واذهبوا على البركات",7,"ت",1,0],["أضجرى جوار ابن عباس الأَبّر بِها","خَيراً لِكُل مبار عَنهُ وَقفات",8,"ت",1,0],["أضجعوه ولم يرع ثم شقوا","منه للصدر أشرف الأعضاء",9,"ا",2,0],["أَضجِرتَ منا أَم أَنفتَ فلم تكنْ","ممّن تصابُ لشدّةٍ ضجراتُهُ",10,"ت",2,0],["أضِجُّ وهْيَ تُواسيني بضِحْكَتِها","ويَغْضَبُ القلبُ وهْيَ الصّبْرَ تَنْتَعِلُ",11,"ل",1,0],["أضجِعَنِّي يا حبيبي","تحت ما فيك استقاما",12,"م",2,0],["أضجِعَنِّي يا حبيبي","وانطلق عَبْري سهاما",12,"م",2,0],["أضجُّ فيعتريني رغمَ قهري","جميلُ هواكِ والدنيا سوادُ",13,"د",1,0],["أضْجَرتني _يا غبيُّ_ لا تسلِ","عن غامض الشّعرِ أنت ذو خَطَلِ",14,"ل",1,1],["أضجُّ بمعنى النَّار، كلُّ قصيدة","تفيق بقلبي من منامِ رقودها",15,"د",3,0]]}