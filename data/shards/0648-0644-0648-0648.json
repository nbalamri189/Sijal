البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130074","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71390","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89248","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3480,"","https://poetry.dctabudhabi.ae/diwan/poem/202498","الوافر"],[3532,"","https://poetry.dctabudhabi.ae/diwan/poem/146245","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126949","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131292",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114320","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101346","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101349","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117188","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76762","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4755,"بفَمِي سُؤالٌ شاخَ دُونَ مُبَلِّغٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188571",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[5024,"حمى طاهر شرق البلاد بيمنه","https://www.poetsgate.com/ViewPoem.aspx?id=99981",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5358,"أيام عاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=21764",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5689,"من ذا يؤانسني إن طال بي أرقي","https://www.poetsgate.com/ViewPoem.aspx?id=143426",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5956,"الكهل الرضيع","https://www.poetsgate.com/ViewPoem.aspx?id=182410",""],[520,"لياليك من بشر نهش وتبسم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577648",""]],"verses":[["وَلَو وَجَدتُ مَرقَعاً","لَبِستُ ثَوبي زَمَنا",0,"ن",2,0],["وَلَو وَجَدَ الزَهرُ وَجدي عَلَيكَ","لَاِصفَرَّ فيهِ خُدودُ الثَغامِ",1,"م",1,0],["وَلَوَوا بِوَعدي يَومَ خَفَّ قَطينُهُم","وَمِنَ الصُدودِ اللَيُّ بِالمَوعودِ",2,"د",1,0],["وَلَوْ وَجَد ابْنُ الغابِ في الأرْضِ مَمْرَحاً","لَكانَ لَهُ عَنْ خُطَّةِ الضَّيْمِ تَقْويضُ",3,"ض",1,0],["وَلَو وَقاكَ وَفِيٌّ","بِمُهجَةٍ لَوَقَيتُ",4,"ت",1,0],["وَلَو وُزِنَت رَضوى الجِبالِ بِحِلمِهِ","لَمالَ بِرَضوى حِلمُهُ وَيَرَمرَمِ",5,"م",1,0],["ولو وَجَدَ الناسُ الفداء مُسوْغاً","فداك ببذل النفس كلُّ مُوحِّدِ",6,"د",1,0],["وَلَو وُزِنَت حُلومُ بَني نُمَيرٍ","عَلى الميزانِ ما وَزَنَت ذُبابا",7,"ب",2,0],["وَلَو وازَنتَ لُؤمَ مُجاشِعِيٍّ","بِلُؤمِ الخَلقِ أَضعَفَ ثُمَّ زادا",8,"د",2,0],["ولو وُلِيَ الهُوجُ الثَّوَائِجُ بالذي","وُلِينَا به ما دَعدَعَ المُتَرَخِّلُ",9,"ل",1,0],["ولو ولي الهوج الشوائح بالذي","ولينا به ما دعدع المترحّل",10,"ل",1,0],["وَلَو وُزِنَت رَضوى بِحِلمِ سَراتِنا","لَمالَ بِرَضوى حِلمُنا وَيَلَملَمِ",11,"م",1,0],["ولو وَزنَ استمتاعَهُ بغَنائِهِ","إذاً ما وفَى استمتاعُهُ بعَنائِهِ",12,"ا",3,0],["ولو وعدَتْني عنك المُنى","لأمست مواعيدها وهي وَفر",13,"ر",1,0],["ولو وردتْ كُبرى عطاياك بغتةً","على مُستنيلٍ أسْلَمتْهُ إلى القبر",14,"ر",1,0],["ولو وعدتْ عنك المُنى مُتَمنِّياً","وفيْتَ له عنها وفاءك بالنَّذر",14,"ر",1,0],["ولو وصلتَ به التدبيرَ أمكَنَهُ","أن يفتقَ الرتقَ أو أن يرتقَ الخللا",15,"ل",2,0],["ولو وسمَ الناسُ الجباهَ بمدحهِ","إذاً لاستلذوا الوسمَ والوسمُ يؤلمُ",16,"م",1,0],["ولو وسمَ الناسُ الجباهَ بمدحه","إذا لاستلذَّ الناسُ لذْعَ المياسمِ",17,"م",1,0],["ولو وهبتَ لعيسى منك ألف أخ","ما ضقت ذرعا ولا ضاقوا إلى الأبد",18,"د",1,0],["وَلَو وَجَدتُ مِصيَداً","لَجِئتُها بِفَأرَةِ",19,"ه",1,0],["وَلَو وُجِدَ العِقابُ فَعَلتُ لَكِن","نِفارُ الظَبيِ لَيسَ لَهُ عِقابُ",20,"ب",1,0],["وَلَو وَهَبتُم لَنا عُليا سِيادَتِكُم","ما زادَنا الفَضلُ في إِخلاصِنا قُدُما",21,"م",2,0],["وَلَو وُجِدَت فيكَ يا بنَ الصَفاةِ","لَحَقتَ بِصانِعِكَ المُقتَدِر",22,"ر",1,0],["وَلَو وَجَدتُ سُلُوّاً ما تَخَوَّنَني","لَمّا تَبَسَّمتِ ذاكَ الظَلمُ وَالشَنَبُ",23,"ب",1,0],["وَلَو وَقَفَ المَغرورُ لَالتَبَسَت بِهِ","زَنابيرُ سَرعانِ الخَميسِ المُجَنَّحِ",24,"ح",1,0],["وَلَو وُزِنَت أَركانُ رَضوى وَيَذبُلُ","وَقُدسٍ بِهِ في الحِلمِ خَفَّ ثَقيلُها",25,"ل",3,0],["وَلَو وَصَلَتني بِالإِمامِ ذَريعَةٌ","دَرى الناسُ أَيُّ الطالِبينَ يُحَكَّمُ",26,"م",1,0],["وَلَو وَكَلوهُ إِلى رَأيِهِ","أَتى وَصلُهُ قَبلَ هِجرانِهِ",27,"ن",2,0],["وَلَو وَصَفَ الناسُ الحِسانَ لَأَضعَفَت","عَلَيهِنَّ أَضعافاً لَدى كُلِّ واصِفِ",28,"ف",1,0],["وَلَو وُزِنَت سَلمى بِحِلمِ اِبنِ مُدرِكٍ","لَكانَ عَلى الميزانِ حِلمُكَ أَثقَلا",29,"ل",2,0],["وَلَو وَطِأَت سَعدٌ لِيَأجوجَ رَدمَها","بِأَقدامِها لَاِرفَضَّ عَنها رُدومُها",30,"م",3,0],["وَلَو وَفَتِ الوُفّادُ قَدرَكَ حَقَّهُ","لَكانَ عَلى الأَحداقِ مِنها مَسيرُها",31,"ر",3,0],["ولو وَجَدتُ مزَاجَ القلب معتدلاً","ببرد أنفاسها في حرّ أنْفاسي",32,"س",2,0],["ولَوْ ولَّوا قليلَ الفقهِ فيهِ","مداراةٌ ودينٌ ما جزعْنا",33,"ن",2,1],["وَلَو وَجَدَت سَهمٌ عَلى الغَيِّ ناصِراً","لَقَد حَلَبَت فيها نِساءٌ وَصَرَّتِ",34,"ت",1,0],["وَلَو وَهَبتِ لَنا يَوماً نَعيشُ بِهِ","أَحيَيتِ نَفساً وَكانَت مِن مَساعيكِ",35,"ك",1,0],["ولو وَطِئَتْ في سيرِها جَفْنَ نائمٍ","بأخْفافِها لم يَنْتَبِهْ من مَنامهِ",36,"م",2,0],["ولو وَضَعَتْ في دِجلةَ الهامَ لم تُفِقْ","من الجَرْعِ إلاّ والقُلوبُ خَوال",37,"ل",1,0],["وَلَوْ وَسَعَت أَغَارِيدَ الشَّوَادِي","لَمَا وَسَعَتْ حَنِيناً مِنْ فُؤَادِي",38,"د",2,0],["ولو وقعة كانت بعين محمد","لما قر عينا أو يزول ثبير",39,"ر",1,0],["ولو وجد الخلق السبيل لتربة","حوت لحدك المكنوف بالفضل والبر",40,"ر",1,0],["وَلَوْ وَطِئَتْ سَعْدٌ ليأجُوجَ ردْمَها","بأقْدامِهَا لارْفَضّ عَنها رُدُومُهَا",41,"م",3,0],["ولو وافقت أمنية في حصولها","أتتك وفيها للزوال قيود",42,"د",1,0],["ولو وكلت إلى نفسي عييت بها","لكن دعوت فما أعيا بتبيان",43,"ن",1,0],["ولو وزنَّا جميع الخلق قاطبةَ","بظفر خِنصرِه أَزْرَى بهم ظُفرُ",44,"ر",1,0],["ولو وجدنا مساغا ما لغصتنا","لدن سواه لكنا نحوه نَفِدُ",45,"د",1,0],["ولَو وَسَمتُم بهَذَا الإسمَ شيخَكُمُ","لَطَابَقَت في إسمِهِ السِّيمَا لِمَن وَسَمَه",46,"م",2,0],["ولو وزنتم بظفر من أظافرهم","لما وصلتم إلى شيء يدانيه",47,"ي",2,0],["ولو وجدوا في القول بالحق حيلة","لما سقطوا في الاثم سقطة عاثر",48,"ر",1,0],["ولو وجدت أخا ود جعلت لهُ","خدّي وطاء مكان النعل للقدمِ",49,"م",1,0],["ولو وجدت إلى كسب الغنى سببا","سهلا وثبت إليه وثبة الأسد",50,"د",1,0],["وَلَو وَقَعَت عَلى رضوى محَتهُ","وَلَو وَقعت على ثهلانَ هلّا",51,"ل",2,0],["ولو وزنتَ ملوك الارض قاطبة","به لما وزنوا في الحرب معشارا",52,"ر",2,0],["ولو وردَ التَيَّارَ بعضُ لُهَامِهِ","لما هُوَ من فَوْقِ البسيطةِ دائمُ",53,"م",1,0],["ولو وَهَبَ الدنيا وكانت بكفِّهِ","على سائليهِ فهي في عينهِ نَزْرُ",54,"ر",1,0],["ولو واجَه الشمسَ وجهٌ له","لأَبدَتْ له الشّمْسُ إجلالها",55,"ل",3,0],["ولو وازنتْك النفسُ منّي جعلتُها","فداءكَ أو كثّرتُ عمرك من عمري",56,"ر",2,0],["ولو وهب اللَه الأنام صفاته","لما اقتسمو غير النباهة والنبل",57,"ل",1,0],["ولو وزّعَتهُ خصلةً خصلةً لنا","لكانَ من الأعلاقِ والبركات",58,"ت",1,0],["وَلَو وزنت به عرب وَعجَم","جعلت فداه ما بلغوه وزنا",59,"ن",2,0],["وَلَو وافى إِلَيَّ الطَّيفُ لَيلاً","خَفيتُ عَلَيهِ مِن فَرطِ السَقامِ",60,"م",1,0],["ولو وجدوا نعل الغطمش لاحتذوا","لأرجلهم منها ثماني أنعل",61,"ل",1,1],["وَلَو وعيَت أَذناك كثرَ تأوُّهي","عَلمت إِخائي ما أَبرَّ وَما أَصفى",62,"ف",2,0],["وَلَو وَكَلوا الحِفاظَ إلى الغَواني","لأغنينَ الغيورَ عن اِحتِرازِ",63,"ز",1,0],["وَلو واقع النّسرين راشَ جناحه","لَما اِسطاعَ ذو رصدٍ لغايتهِ حسبا",64,"ب",2,0],["وَلَوْ وَقَعَتْ شَوارِدُهُ إليهِ","لَزانَ بِها المَصَايِدَ والمَطاردْ",65,"د",1,0],["وَلَو وَجَدوا وَجدي عَلَيكَ لِأَيقَنوا","بِأَنَّ هُدى السالينَ عَنكَ ضَلالُ",66,"ل",1,0],["وَلَو وَجَدَ العُذّالُ وَجدي لَمّا بَدا","لَهُم أَبَداً إِلّا لِساليكُمُ العَذلُ",67,"ل",1,0],["ولو وهَب النُّجومَ لسائليهِ","رآها من مَواهبِه نفايا",68,"ا",3,0],["ولو وَرِثَ النّسرُ عُمْرَ القتيلِ","لما حَلّ بالفُتْخ صرْفُ الرَّدى",69,"ا",1,0],["وَلَوَوا مِنَ القُضبانِ وَال","كُثبِ الرَوادِفَ وَالخُصورا",70,"ر",2,0],["ولو وهبتُ دمي لم تُغنِ موهبتي","كم من دمٍ سفكتهُ غير موهوبِ",71,"ب",1,0],["ولو وَجَدُوا السبيلَ إليكَ يوماً","لما خَفِيَتْ لهُمْ طُرُقُ الرَّشادِ",72,"د",1,0],["ولو وجدتُ مَقنعاً","في غيركم لم أقنعِ",73,"ع",1,0],["ولو وفيتُ لخؤونٍ غادرٍ","تبعتُ قلبي معكم حيث انطلقْ",74,"ق",1,0],["وَلَو وَرَدتُ عَلَيها الفَيضَ ما حَفَلَت","وَلا شَفَت عَطَشي مِن مائِهِ الجاري",75,"ر",2,0],["ولو وزنت لوازنها هباء","ولو سكبت لما سيغت شرابا",76,"ب",2,0],["ولو وصفتهم بالضعف ما نسبت","إليك مكرمة في القهر والغلب",77,"ب",1,0],["وَلَو وزِنَت رَضوى بِبَعضِ حُلومِهِم","لَشالَت وَلَو زيدَت عَلَيهِ نُضارِعُ",78,"ع",1,1],["ولو وحَّدوها طبق ما زعموا لما","رأوا غيرها في كل ما هو واقع",79,"ع",1,0],["ولو وُصِلَتْ سُودُ الليالي بِشَعره","لما خَشِيتْ مِنْ غَير غرَّته فَجْرا",80,"ر",2,0],["وَلَوْ وَضَعْتَ على الهِنْدِيِّ سَطْوَتَهُ","طاحَتْ رُؤوسُ الأَعادي وَهْوَ ما ضَرَبا",81,"ب",2,0],["وَلوْ وَضَعْتَ الَّذي تُبْدي فُكَاهَتهُ","لِلعَلْقَمِ المُرِّ أضْحَى طَعْمُه ضَرِبا",81,"ب",2,0],["وَلَو وَقَفُوا لَكَ مَزَّ قتَهُم","بِجَيشِكَ تَمزيقَ ثَوبِ خَلِق",82,"ق",1,0],["ولو وُزِنا مِنه ثَبيرٌ وحَضحضٌ","بأنملَةٍ خفّا ثبيرٌ وحَضحَض",83,"ض",1,0],["ولَو وُزِنَ الأملاكُ مِنه بِخِنصَرٍ","لَما وَزَنُوا مِنهُ قُلامَة خِنصَرِ",84,"ر",1,0],["ولو وهبت الغداة نفسي","قلت لك النفس في الهبات",85,"ت",1,0],["ولو وجدوا بعض الشقاء عذرتهم","ولكنهم أشقوا سواهم لينعموا",86,"م",3,0],["ولو وجدتُ لشعري بينكم ثمناً","بنيتُ حصنين للوادي بأشعاري",87,"ر",2,0],["ولو وهبت لغير المصلحين يدي","لكان أفضل مني عابد الوثن",88,"ن",1,0],["ولو وَلَغَتْ في دم القلب لم","أرَ القلبَ يُؤْلِمُهُ وَلْغُها",89,"غ",3,0],["وَلَو وافى جُيوشاً ذاتَ نَصرٍ","لَوَلَّت رَهبَةً وَغَدا نَصيرا",90,"ر",2,0],["وَلَو وَهِموا أن يكرَّ عليهم","لَولَّوْا وَقالوا الفِرارَ الفِرارا",91,"ر",2,0],["وَلَو وَقَعت لَهَلَكت حَتما","وَأَوسَعتني أُمُّكَ فيك شَتما",92,"م",2,0],["ولو وهَب النجومَ لوافديه","لظنَّ بأنها أدنى عطاه",93,"ا",2,0],["وَلَوَوْا سَوَالِفَهمْ عَلَى وَجَنَاتِهِمْ","كَعَقَارِبٍ دَبَّتْ عَلَى نُعْمَانِ",94,"ن",1,0],["ولو وقفوا يوم الرهان مواقفي","لاهديتهم روحي ومالي ولا منا",95,"ن",2,0],["وَلَو وُزِنَت حُلومُهُمُ بِرَضوى","وَفَت مِنها وَلَو زيدَت كَسابا",96,"ب",2,0],["ولو وَعَدْتُمْ وصْلَكمْ في الرَّدَى","لَسَرني أَنْ أَتَمَنَّى المَنونْ",97,"ن",1,0],["ولو وَجَدَتْ وَجْدي رَثَتْ لي فَخَلِّها","تَصُدُّ ولا تَلْقَى الذي بي مِنَ الجَوَى",98,"و",2,0],["وَلَو وافَيتَ رَبَّكَ دونَ ذَنبٍ","وَناقَشَكَ الحِسابَ إِذاً هَلَكتا",99,"ت",2,0],["ولو وجدت طلوع الشمس متسعا","لحط رجل غريمى كنت أغترم",100,"م",1,0],["ولو وردت صفاً لجرى صفاء","وجمر غضاً أفادته غضاره",101,"ر",2,0],["ولو وافت وحوش البر والبح","ر خائفة لسكّن روعهنه",102,"ن",2,0],["ولو وجدت بعض ما قد وجدتُ","لبلّت من الدمع أردانَها",103,"ن",3,0],["ولو وجدتْ للبين ما قد وجدته","غدا آمري بالحزنِ من كانَ ناهيا",104,"ي",2,0],["وَلَو وقفت له يوماً وَقرت","لكانَ به لأَعينها قرار",105,"ر",1,0],["ولو وزنوا في غير مصر مقامه","لأرخصه في السوم كل مدنق",106,"ق",1,0],["ولوَّوا عن أبي حسنٍ رؤوساً","كأن بها لما كسبت جحاما",107,"م",2,0],["وَلَو وَجَدوا لَهُمُ مَطعَناً","إِلى أَن يَعيبوكَ ما أَحجَموا",108,"م",3,0],["ولو وقفت بقلمرت التي جمعت","شطوطها بين مرعى الظبي والنون",109,"ن",1,0],["ولو وفَتِ الأَيّام جاشَت صُدورُها","بما ضُمّنتهُ أو تبلغَ ما عِندي",110,"د",2,1],["وَلَو وَجِدتَ غَداةَ البَينِ وَجدِي","لَبانَ لَها صَحِيحي مِن خِداعي",111,"ع",2,0],["وَلَو وَمِن خَلفِهِم جَيشٌ فَوارِسُهُ","قَد أَبحَدَتنا بِها الجَوزاءُ وَالأَسَدُ",112,"د",1,0],["ولو وَجَدْتُ بالوُصولِ مُنْجِدا","جَعَلْتُ في أَفراحهِ مُجَلّدا",113,"د",2,0],["ولَو وُفِّقتُ في أمري","لكانَ الصَّبرُ أولى لِي",114,"ي",1,0],["ولو وقور رزين الحلم يسمعه","خفت شمائله من بعد ما وقرا",115,"ر",2,0],["ولو وهل مثل لعل الداخلة","فيه والاستفهام والموضوع",116,"ع",1,0],["ولووا عن طريقه الواضح الأع","لام من جهلهم فضلوا المرادا",117,"د",2,0],["وَلَو وُفِّقوا كُنتُم جَميعاً عَلى العِدى","وَدافَعَ دونَ الغيلِ ذا الأَسَدُ الوِردُ",118,"د",1,0],["ولووا معاطسهم على لهب","تحت الكشوح وليتهم رضوا",119,"ض",3,0],["ولو وُضِعتْ في البحر من فيك قطرة","لأَصبح شُهْداً جامداً ذلك البحرُ",120,"ر",1,0],["ولَوْ وجدتِ كوجدي يومَ ذي سَلمٍ","لما رحَلْتَ ولكن أنتِ لم تجد",121,"د",1,0],["وَلو وزعت أَدنى عَطاياك في الوَرى","بأجمعهم لم يَبقَ بِالأَرض معسر",122,"ر",1,0],["ولو وكلت إلى نفسي غنيت بها","لكن بدأت فلم أعجز وكم ألم",123,"م",1,0],["ولو وصفوني بالّذي فيّ قادح","لهان وما حيّ من القدح سالمُ",124,"م",1,0],["ولو ورثت الدنيا","بالفرض والتعصيب",125,"ب",1,0],["ولو وسعت أمواله جود كفه","لأعوز بين الخافقين فقير",126,"ر",1,0],["ولو وضعنا هوانا في مواضعه","لكان شلال نور في دجى الظلم",127,"م",1,0],["ولو وسط الأعجام سحبانُ قد أتى","بخطبته الفيحاء لاِرتدَّ خاسرا",128,"ر",2,0],["وَلَوْ وَقَفَتْ يَوْماً بِحَدٍ لَنَالَهَا","بِهِ عَدَمٌ هَيْهَاتَ وَهْيَ وُجوُدُ",129,"د",1,0],["ولو وجدت مثل الذي في جوانحي","لما حركت من بان كاظمة عطفا",130,"ف",2,0],["وَلَووا إِلَيكَ رقابَهم من ركّع","يَقضون مفروض الوَلاء وسجّدِ",131,"د",1,0],["ولو وردوا الفرات لنجسوه","ولم يك طاهرا حتى يموتوا",132,"ت",3,0],["ولو وقعت في لجة البحر قطرةٌ","من المزن يوماً ثم شاء لما زها",133,"ه",2,1],["ولو وعى عظمها الصخر الأصم إذاً","دماً تفجر منه الصلد وانفرجا",134,"ج",2,0],["ولو وجد المحتاج في القفر بدرةً","لغادرها من خوفه غير آسف",135,"ف",1,0],["وَلَو وَجَدت سَبِيلاً لِلوِصَالِ لَمَا","قَرأتُ فِي النَّحوِ غَيرَ بِابِ مَوصُولِ",136,"ل",1,0],["ولو وزنوا بي يذبلا خف وزنه","وقنطاره ما قيس وزناً بمثقالي",137,"ل",2,0],["ولو وجد الهلال إليك مثلي","انتماءاً ما تعداك انتماءا",138,"ا",3,0],["ولو وجدت مصعداً لارتوت","على بعدها من دماء الشفق",139,"ق",1,0],["ولَو واللَهِ تشتاقين شوقي","جَمَحتِ إلَيَّ خالعةَ العذارِ",140,"ر",1,0],["ولو وفيتُ حقك في امتداح","لقال الشعر فيك الشعرتان",141,"ن",1,0],["ولو ورق الدوح كان كتابا","لما وسع الشكر الا قليلا",142,"ل",2,0],["ولَوَوْا على \"اليَمنِ السَّعيدِ\" لِيَفصِلُوا","\"صَنعاءَهُ\" عَن \"ثَغرِهِ البَسَّامِ\"",143,"م",1,0],["ولو وقفوا بالعرش والفرش لحظة","لعدوه تقصيرا وجرما ومأتما",144,"م",2,0],["ولو وزنت صم الجبال بحلمه","لخفت وإن كانت ثقيلاً ركودها",145,"د",3,0],["ولو واري معاطِفَها العجوز47","فكم كشرت بعقوَتها العجوز48",146,"ز",1,0],["ولو وقفت بعليين أنشده","لهام من في جنان الخلد من نسم",147,"م",1,0],["ولو وفق الأشقى وقال بنظمه","هداية هذا الشيخ قد غطت الأفقا",148,"ق",2,0],["ولو وطئتُ سماءً كنتُ أحملُها","ولو وقعتُ على أرض ٍ أُحيّيها",149,"ي",3,0],["ولو وجودي مايعدّل للعوج مجلاسه","وأسكته ماجيت جده والبحر يزهاها",150,"ا",3,0],["ولو ومرت عليهم في الثرى حقب","وأعصر لسناهم كلها حجب",151,"ب",1,0],["ولو وجدت في الأرض مكرك ماثلا","لما طال في درب الحياة عثورها",152,"ر",3,0],["ولو وَجَدَ الزوجُ كلَّ الكمال","من الزوج لا بدَّ يَبْقَى طَموعا",153,"ع",2,0],["ولو ولدت منك الوزارة واحداً","له النصر يوم الروع والنصل توأم",154,"م",1,0]]}