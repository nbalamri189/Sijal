{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[63,"ألفت الهوينى في زمان لأهله","https://www.aldiwan.net/poem45930.html","الطويل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[35,"أفي رسم أطلال بشطب فمرجم","https://www.aldiwan.net/poem38832.html","الطويل"],[83,"ضريح أمير المسلمين محمد","https://www.aldiwan.net/poem54319.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[37,"كخالية من كوعها وهي تبتغي","https://www.aldiwan.net/poem7674.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[51,"وما الفقر عيبا ما تجمل أهله","https://www.aldiwan.net/poem8133.html","الطويل"],[51,"كثير نوالك في جنب ما","https://www.aldiwan.net/poem62854.html","المتقارب"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[85,"شكوت لله من نسلي وكثرته","https://www.aldiwan.net/poem7743.html","البسيط"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem63681.html","الوافر"],[85,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[85,"أبا الهول طال عليك العصر","https://www.aldiwan.net/poem63767.html","المتقارب"],[45,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[45,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"على أي أمر مشكل أتلوم","https://www.aldiwan.net/poem65664.html","الطويل"],[45,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[28,"ألم خيال من علية بعدما","https://www.aldiwan.net/poem5318.html","الطويل"],[28,"أقول لمنحوض أعالي عظامها","https://www.aldiwan.net/poem5461.html","الطويل"],[28,"لئن قيس عيلان اشتكتني لمثل ما","https://www.aldiwan.net/poem5585.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[80,"قل للأساة أسأتم في علاجكم","https://www.aldiwan.net/poem31419.html","البسيط"],[69,"ولو ولوا قليل الفقه فيه","https://www.aldiwan.net/poem29176.html","الوافر"],[22,"أشاقتك ليلى في اللمام وما جزت","https://www.aldiwan.net/poem21660.html","الطويل"],[50,"أخشى عليك من الجارات حاسدة","https://www.aldiwan.net/poem62299.html","البسيط"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54793","الوافر"],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[28,"لَئِنْ قَيْسُ عَيلانَ اشتكَتني لمثلِ ما","https://www.poetsgate.com/ViewPoem.aspx?id=17957",""],[118,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[126,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[130,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[130,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[158,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[184,"والله ما وجدتي نقصا علي ولا","https://www.aldiwan.net/poem43252.html","البسيط"],[184,"لما أبي لي سؤال الناس نائلهم","https://www.aldiwan.net/poem43937.html","البسيط"],[187,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[208,"الثار دونك يا ليث الوغى الثارا","https://www.aldiwan.net/poem13557.html","البسيط"],[210,"طيور المعالي في السماء حوائم","https://www.aldiwan.net/poem37831.html","الطويل"],[210,"خليلي هل أشجاكما منزل قفر","https://www.aldiwan.net/poem37894.html","الطويل"],[227,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[227,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[259,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[268,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[269,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[280,"أجيراني بذي سلم عليكم","https://www.aldiwan.net/poem32479.html","الوافر"],[292,"ولو وجدوا نعل الغطمش لاحتذوا","https://www.aldiwan.net/poem1754.html","الطويل"],[295,"بكيت أسى لو رد عنك البكا حتفا","https://www.aldiwan.net/poem33216.html","الطويل"],[295,"سقى صوب الحيا أرض الحجاز","https://www.aldiwan.net/poem33244.html","الوافر"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[347,"تفرق عني العاذلون وأجمعوا","https://www.aldiwan.net/poem15818.html","الطويل"],[347,"سوى حبكم يسلى وغيري له يسلو","https://www.aldiwan.net/poem15860.html","مجزوء الطويل"],[362,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[362,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[364,"نسجوا من الليل الشعورا","https://www.aldiwan.net/poem17003.html","مجزوء الكامل"],[369,"نمت وما مر طيب نفحة الطيب","https://www.aldiwan.net/poem57534.html","البسيط"],[436,"بسعدك لا بسعد أو سعاد","https://www.aldiwan.net/poem34782.html","الوافر"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[462,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[468,"أهوى أمية إن شطت وإن قربت","https://www.aldiwan.net/poem4719.html","البسيط"],[477,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[513,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[538,"ولو وزنت رضوى ببعض حلومهم","https://www.aldiwan.net/poem56758.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[573,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[584,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"]],"verses":[["وَلَو وَجَدتُ مَرقَعاً","لَبِستُ ثَوبي زَمَنا",0,"ن",2,0],["وَلَو وَجَدَ الزَهرُ وَجدي عَلَيكَ","لَاِصفَرَّ فيهِ خُدودُ الثَغامِ",1,"م",1,0],["وَلَوَوا بِوَعدي يَومَ خَفَّ قَطينُهُم","وَمِنَ الصُدودِ اللَيُّ بِالمَوعودِ",2,"د",1,0],["وَلَوْ وَجَد ابْنُ الغابِ في الأرْضِ مَمْرَحاً","لَكانَ لَهُ عَنْ خُطَّةِ الضَّيْمِ تَقْويضُ",3,"ض",1,0],["وَلَو وَقاكَ وَفِيٌّ","بِمُهجَةٍ لَوَقَيتُ",4,"ت",1,0],["وَلَو وُزِنَت رَضوى الجِبالِ بِحِلمِهِ","لَمالَ بِرَضوى حِلمُهُ وَيَرَمرَمِ",5,"م",1,0],["ولو وَجَدَ الناسُ الفداء مُسوْغاً","فداك ببذل النفس كلُّ مُوحِّدِ",6,"د",1,0],["وَلَو وُزِنَت حُلومُ بَني نُمَيرٍ","عَلى الميزانِ ما وَزَنَت ذُبابا",7,"ب",2,0],["وَلَو وازَنتَ لُؤمَ مُجاشِعِيٍّ","بِلُؤمِ الخَلقِ أَضعَفَ ثُمَّ زادا",8,"د",2,0],["ولو وُلِيَ الهُوجُ الثَّوَائِجُ بالذي","وُلِينَا به ما دَعدَعَ المُتَرَخِّلُ",9,"ل",1,0],["ولو ولي الهوج الشوائح بالذي","ولينا به ما دعدع المترحّل",10,"ل",1,0],["وَلَو وُزِنَت رَضوى بِحِلمِ سَراتِنا","لَمالَ بِرَضوى حِلمُنا وَيَلَملَمِ",11,"م",1,0],["ولو وَزنَ استمتاعَهُ بغَنائِهِ","إذاً ما وفَى استمتاعُهُ بعَنائِهِ",12,"ا",3,0],["ولو وعدَتْني عنك المُنى","لأمست مواعيدها وهي وَفر",13,"ر",1,0],["ولو وردتْ كُبرى عطاياك بغتةً","على مُستنيلٍ أسْلَمتْهُ إلى القبر",14,"ر",1,0],["ولو وعدتْ عنك المُنى مُتَمنِّياً","وفيْتَ له عنها وفاءك بالنَّذر",14,"ر",1,0],["ولو وصلتَ به التدبيرَ أمكَنَهُ","أن يفتقَ الرتقَ أو أن يرتقَ الخللا",15,"ل",2,0],["ولو وسمَ الناسُ الجباهَ بمدحهِ","إذاً لاستلذوا الوسمَ والوسمُ يؤلمُ",16,"م",1,0],["ولو وسمَ الناسُ الجباهَ بمدحه","إذا لاستلذَّ الناسُ لذْعَ المياسمِ",17,"م",1,0],["ولو وهبتَ لعيسى منك ألف أخ","ما ضقت ذرعا ولا ضاقوا إلى الأبد",18,"د",1,0],["وَلَو وَجَدتُ مِصيَداً","لَجِئتُها بِفَأرَةِ",19,"ه",1,0],["وَلَو وُجِدَ العِقابُ فَعَلتُ لَكِن","نِفارُ الظَبيِ لَيسَ لَهُ عِقابُ",20,"ب",1,0],["وَلَو وَهَبتُم لَنا عُليا سِيادَتِكُم","ما زادَنا الفَضلُ في إِخلاصِنا قُدُما",21,"م",2,0],["وَلَو وُجِدَت فيكَ يا بنَ الصَفاةِ","لَحَقتَ بِصانِعِكَ المُقتَدِر",22,"ر",1,0],["وَلَو وَجَدتُ سُلُوّاً ما تَخَوَّنَني","لَمّا تَبَسَّمتِ ذاكَ الظَلمُ وَالشَنَبُ",23,"ب",1,0],["وَلَو وَقَفَ المَغرورُ لَالتَبَسَت بِهِ","زَنابيرُ سَرعانِ الخَميسِ المُجَنَّحِ",24,"ح",1,0],["وَلَو وُزِنَت أَركانُ رَضوى وَيَذبُلُ","وَقُدسٍ بِهِ في الحِلمِ خَفَّ ثَقيلُها",25,"ل",3,0],["وَلَو وَصَلَتني بِالإِمامِ ذَريعَةٌ","دَرى الناسُ أَيُّ الطالِبينَ يُحَكَّمُ",26,"م",1,0],["وَلَو وَكَلوهُ إِلى رَأيِهِ","أَتى وَصلُهُ قَبلَ هِجرانِهِ",27,"ن",2,0],["وَلَو وَصَفَ الناسُ الحِسانَ لَأَضعَفَت","عَلَيهِنَّ أَضعافاً لَدى كُلِّ واصِفِ",28,"ف",1,0],["وَلَو وُزِنَت سَلمى بِحِلمِ اِبنِ مُدرِكٍ","لَكانَ عَلى الميزانِ حِلمُكَ أَثقَلا",29,"ل",2,0],["وَلَو وَطِأَت سَعدٌ لِيَأجوجَ رَدمَها","بِأَقدامِها لَاِرفَضَّ عَنها رُدومُها",30,"م",3,0],["وَلَو وَفَتِ الوُفّادُ قَدرَكَ حَقَّهُ","لَكانَ عَلى الأَحداقِ مِنها مَسيرُها",31,"ر",3,0],["ولو وَجَدتُ مزَاجَ القلب معتدلاً","ببرد أنفاسها في حرّ أنْفاسي",32,"س",2,0],["ولَوْ ولَّوا قليلَ الفقهِ فيهِ","مداراةٌ ودينٌ ما جزعْنا",33,"ن",2,1],["وَلَو وَجَدَت سَهمٌ عَلى الغَيِّ ناصِراً","لَقَد حَلَبَت فيها نِساءٌ وَصَرَّتِ",34,"ت",1,0],["وَلَو وَهَبتِ لَنا يَوماً نَعيشُ بِهِ","أَحيَيتِ نَفساً وَكانَت مِن مَساعيكِ",35,"ك",1,0],["ولو وَطِئَتْ في سيرِها جَفْنَ نائمٍ","بأخْفافِها لم يَنْتَبِهْ من مَنامهِ",36,"م",2,0],["ولو وَضَعَتْ في دِجلةَ الهامَ لم تُفِقْ","من الجَرْعِ إلاّ والقُلوبُ خَوال",37,"ل",1,0],["وَلَوْ وَسَعَت أَغَارِيدَ الشَّوَادِي","لَمَا وَسَعَتْ حَنِيناً مِنْ فُؤَادِي",38,"د",2,0],["ولو وجد الخلق السبيل لتربة","حوت لحدك المكنوف بالفضل والبر",39,"ر",1,0],["وَلَوْ وَطِئَتْ سَعْدٌ ليأجُوجَ ردْمَها","بأقْدامِهَا لارْفَضّ عَنها رُدُومُهَا",40,"م",3,0],["ولو وكلت إلى نفسي عييت بها","لكن دعوت فما أعيا بتبيان",41,"ن",1,0],["ولو وزنَّا جميع الخلق قاطبةَ","بظفر خِنصرِه أَزْرَى بهم ظُفرُ",42,"ر",1,0],["ولو وجدنا مساغا ما لغصتنا","لدن سواه لكنا نحوه نَفِدُ",43,"د",1,0],["ولَو وَسَمتُم بهَذَا الإسمَ شيخَكُمُ","لَطَابَقَت في إسمِهِ السِّيمَا لِمَن وَسَمَه",44,"م",2,0],["ولو وزنتم بظفر من أظافرهم","لما وصلتم إلى شيء يدانيه",45,"ي",2,0],["ولو وجدوا في القول بالحق حيلة","لما سقطوا في الاثم سقطة عاثر",46,"ر",1,0],["ولو وجدت أخا ود جعلت لهُ","خدّي وطاء مكان النعل للقدمِ",47,"م",1,0],["ولو وجدت إلى كسب الغنى سببا","سهلا وثبت إليه وثبة الأسد",48,"د",1,0],["وَلَو وَقَعَت عَلى رضوى محَتهُ","وَلَو وَقعت على ثهلانَ هلّا",49,"ل",2,0],["ولو وزنتَ ملوك الارض قاطبة","به لما وزنوا في الحرب معشارا",50,"ر",2,0],["ولو وردَ التَيَّارَ بعضُ لُهَامِهِ","لما هُوَ من فَوْقِ البسيطةِ دائمُ",51,"م",1,0],["ولو وَهَبَ الدنيا وكانت بكفِّهِ","على سائليهِ فهي في عينهِ نَزْرُ",52,"ر",1,0],["ولو واجَه الشمسَ وجهٌ له","لأَبدَتْ له الشّمْسُ إجلالها",53,"ل",3,0],["ولو وازنتْك النفسُ منّي جعلتُها","فداءكَ أو كثّرتُ عمرك من عمري",54,"ر",2,0],["ولو وهب اللَه الأنام صفاته","لما اقتسمو غير النباهة والنبل",55,"ل",1,0],["ولو وزّعَتهُ خصلةً خصلةً لنا","لكانَ من الأعلاقِ والبركات",56,"ت",1,0],["وَلَو وزنت به عرب وَعجَم","جعلت فداه ما بلغوه وزنا",57,"ن",2,0],["وَلَو وافى إِلَيَّ الطَّيفُ لَيلاً","خَفيتُ عَلَيهِ مِن فَرطِ السَقامِ",58,"م",1,0],["ولو وجدوا نعل الغطمش لاحتذوا","لأرجلهم منها ثماني أنعل",59,"ل",1,1],["وَلَو وعيَت أَذناك كثرَ تأوُّهي","عَلمت إِخائي ما أَبرَّ وَما أَصفى",60,"ف",2,0],["وَلَو وَكَلوا الحِفاظَ إلى الغَواني","لأغنينَ الغيورَ عن اِحتِرازِ",61,"ز",1,0],["وَلو واقع النّسرين راشَ جناحه","لَما اِسطاعَ ذو رصدٍ لغايتهِ حسبا",62,"ب",2,0],["وَلَوْ وَقَعَتْ شَوارِدُهُ إليهِ","لَزانَ بِها المَصَايِدَ والمَطاردْ",63,"د",1,0],["وَلَو وَجَدوا وَجدي عَلَيكَ لِأَيقَنوا","بِأَنَّ هُدى السالينَ عَنكَ ضَلالُ",64,"ل",1,0],["وَلَو وَجَدَ العُذّالُ وَجدي لَمّا بَدا","لَهُم أَبَداً إِلّا لِساليكُمُ العَذلُ",65,"ل",1,0],["ولو وهَب النُّجومَ لسائليهِ","رآها من مَواهبِه نفايا",66,"ا",3,0],["ولو وَرِثَ النّسرُ عُمْرَ القتيلِ","لما حَلّ بالفُتْخ صرْفُ الرَّدى",67,"ا",1,0],["وَلَوَوا مِنَ القُضبانِ وَال","كُثبِ الرَوادِفَ وَالخُصورا",68,"ر",2,0],["ولو وهبتُ دمي لم تُغنِ موهبتي","كم من دمٍ سفكتهُ غير موهوبِ",69,"ب",1,0],["ولو وَجَدُوا السبيلَ إليكَ يوماً","لما خَفِيَتْ لهُمْ طُرُقُ الرَّشادِ",70,"د",1,0],["ولو وجدتُ مَقنعاً","في غيركم لم أقنعِ",71,"ع",1,0],["ولو وفيتُ لخؤونٍ غادرٍ","تبعتُ قلبي معكم حيث انطلقْ",72,"ق",1,0],["وَلَو وَرَدتُ عَلَيها الفَيضَ ما حَفَلَت","وَلا شَفَت عَطَشي مِن مائِهِ الجاري",73,"ي",1,0],["ولو وزنت لوازنها هباء","ولو سكبت لما سيغت شرابا",74,"ب",2,0],["ولو وصفتهم بالضعف ما نسبت","إليك مكرمة في القهر والغلب",75,"ب",1,0],["وَلَو وزِنَت رَضوى بِبَعضِ حُلومِهِم","لَشالَت وَلَو زيدَت عَلَيهِ نُضارِعُ",76,"ع",1,1],["ولو وحَّدوها طبق ما زعموا لما","رأوا غيرها في كل ما هو واقع",77,"ع",1,0],["ولو وُصِلَتْ سُودُ الليالي بِشَعره","لما خَشِيتْ مِنْ غَير غرَّته فَجْرا",78,"ر",2,0],["وَلَوْ وَضَعْتَ على الهِنْدِيِّ سَطْوَتَهُ","طاحَتْ رُؤوسُ الأَعادي وَهْوَ ما ضَرَبا",79,"ب",2,0],["وَلوْ وَضَعْتَ الَّذي تُبْدي فُكَاهَتهُ","لِلعَلْقَمِ المُرِّ أضْحَى طَعْمُه ضَرِبا",79,"ب",2,0]]}