{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[96,"الكعبة السمراء","https://www.poetsgate.com/ViewPoem.aspx?id=15616",""],[132,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[295,"أبشري يا دمشق بالأبطال","https://www.aldiwan.net/poem11669.html","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115931","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125472","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110631","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205795","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203471","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204462","الرجز"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136889","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85174","الرمل"],[4269,"","https://poetry.dctabudhabi.ae/diwan/poem/199860","السريع"],[4767,"استبصار","https://www.poetsgate.com/ViewPoem.aspx?id=213047",""]],"verses":[["قَدْ كُوفِيءَ المُحْسِنُونَ الأكْرَمُونَ بِهَا","عَنْ كُلِّ مِثْلٍ مِنْ الجَّدَوى بِأمْثَالِ",0,"ل",1,0],["قدّك والضمير من سجّية","بورك بالرهيف والرهيف",1,"ف",1,0],["قد كَوَتْ مهجتي بجمرةِ خديها","وأضنتْ جسمي بِسُمْرٍ حِداد",2,"د",1,0],["قد كواه النوى وصب عليه الدهر","ارزاءه بكل مجال",3,"ل",1,0],["قد كُوِّرَت شمسُ النهارِ لفقدِه","وخبا سنا القمرِ المُنيرِ الباهِرِ",4,"ر",1,0],["قد كَوَتهُ نارُ حُبِّي","فاختفى طيفُ الرقاد",5,"د",1,0],["قد كورت أمس بالحبر التقي لنا","شمس الهدى فتوارت في دياجرها",6,"ر",3,0],["قدْك وهمّا لقدْ تغلغلتُ فيها","وتأكدتُ مَيْلَها للتّرك",7,"ك",1,0],["قد كوّن العلم آلات لتخدمنا","إذا بنا اليوم للآلات كالخدم",8,"م",1,0],["قد كوّن الشيطان من نار فما","يخشى من النار متى يهدد",9,"د",1,0],["قد كونتها لنا الأفكار فاخترعت","من غير روح فمهما حركت تثب",10,"ب",1,0],["قد كواني الهجر كيا","وخمور الوصل طبه",11,"ه",1,0],["قَدْ كُوِىَ الْقَلْبُ بِنِيرانِ","فَصِرْتُ مِنْها إلْفَ أَحْزانِ",12,"ن",1,1],["قد كوَّمُوا حطباً عليهم كلما","زادوه رُصَّت تلكم الأحطاب",13,"ب",1,0]]}