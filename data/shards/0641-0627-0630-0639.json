{"poems":[[79,"أيحيى سقى حيث لحت الحيا","https://www.aldiwan.net/poem36062.html","المتقارب"],[79,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[409,"أهلا بنظم كالرحيق السلسل","https://www.aldiwan.net/poem33604.html","الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137634",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141255","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133257","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4767,"حصاد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=88342",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[5242,"جنود الله هبُّوا للقتال","https://www.poetsgate.com/ViewPoem.aspx?id=125969",""],[5888,"للراقصين بالعتمة","https://www.poetsgate.com/ViewPoem.aspx?id=214505",""]],"verses":[["فَأَذْعَنَ مَنْ يَدَّعِي السِّحْرَ رَغْماً","وَأَسْلَمَ من أَجْلِهَا المُشْرِكُونَ",0,"ن",1,0],["فَاذْعَرْ بِهِ الْكُفْرَ فِي أَقْصَى مَآمِنِهِ","وَحُطْ بهِ الدِّينَ مِنْ خَلْفٍ وَمِنْ أَمَم",1,"م",1,0],["فأَذعنتْ مُرَّاقُها سِراعَا","وأَقبلتْ حُصونُها تَداعَى",2,"ع",2,0],["فأَذَعنتْ ولم تَكُن بمُذعِنَهْ","واسْتسلمتْ كافرةٌ لمؤمنَهْ",2,"ه",1,0],["فأَذْعنتْ لسيَّدِ السَّاداتِ","وأكرمِ الأحياءِ والأمواتِ",2,"ت",1,0],["فَأَذعَنَتْ وقَبلَها لم تُذْعنِ","ولم تَقُد منْ نَفْسها وتُمكنِ",2,"ن",1,0],["فَأَذعَنَ الدَهرُ حَتّى ما أَتَيتَ أَتى","وَما أَبَيتَ وَإِن سيئَت عِداكَ أَبا",3,"ب",2,0],["فاذعن لما قد جاء غير مؤوِّل","واسلك على نهج الطراز الأول",4,"ل",1,0],["فأذعر كل عجوز وشيخ","وكهل وناشئة وفتى",5,"ت",2,0],["فاذعن والا صوبتك لحاظها","ولقد سمعت بسطوة السودان",6,"ن",1,0],["فَأَذْعَنَ أَهْلُوهَا وَجَاءَ أَمِيرُهُمْ","لأَكْرَمِ مَوْلىً شَأْنُهُ الرِّفْقُ بِالْعَبْدِ",7,"د",1,0],["فأذعنت لأبيها وهي مكرهة","وعاهدته على جرمٍ وكتمان",8,"ن",1,0],["فَأذَعتُهُ بَعدَ اللُتَيَّا وَالتِي","نُصحاً وَخَوفَ مَعَرَّةِ الكِتَمَانِ",9,"ن",1,0],["فَأَذعَن النّاسُ إِلى مَقالهِ","وَطَأطَأوا الرَأس إِلى فِعالهِ",10,"ه",1,0],["فأذعنوا وأجابوا صدق دعوته","بعد العناد وفي الإسلام قد جخلوا",11,"ل",3,0],["فَأُذعَنَ نَسطورٌ وأَستِينِلٌ قَفَل","وأَفرُمِذُونٌ بِالجِيادِ على العَجَل",12,"ل",1,0],["فأذعن زفس لها ثم أمطر على","الأرض طلّاً من الدم أحمر",13,"ر",1,0],["فأذعنت طائعة قد أتت","وكنت قد بكستها بكسا",14,"س",2,0],["فأذعن ربّها الطاغي وخلى","الصياصي عنه للملك المجيد",15,"د",1,0],["فأذعن للإمام ودان قسراً","وها هو في السلاسل والقيود",15,"د",1,0],["فأذعن حصنها وغدى ذليلاً","شريفهُم بذل وارتذال",16,"ل",1,0],["فأذع بيان الصدق دون تردد","لتكون نبراسا وعلما بيّنا",17,"ن",2,0]]}