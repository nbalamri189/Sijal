عشانك ماوصلتي عشاني","https://www.poetsgate.com/ViewPoem.aspx?id=151615",""],[4869,"الحظ والضيق","https://www.poetsgate.com/ViewPoem.aspx?id=151703",""],[4875,"مشروبك الغازي","https://www.poetsgate.com/ViewPoem.aspx?id=133200",""],[4959,"لَوْ كُلُّ مَا يَتَمَنَّى الْمَرْءُ يُدْرِكُهُ !!!","https://www.poetsgate.com/ViewPoem.aspx?id=213810",""],[4987,"قالو حبيبك","https://www.poetsgate.com/ViewPoem.aspx?id=49556",""],[4987,"توديع الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=49561",""],[4987,"ويش استفيد","https://www.poetsgate.com/ViewPoem.aspx?id=49581",""],[5112,"من كل ثانية درهم","https://www.poetsgate.com/ViewPoem.aspx?id=212005",""],[5121,"دُنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=213479",""],[5246,"سل ما تريد فقد نريك جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=187074",""],[5324,"أبدا ولا كلّ الفوارس مظهر .","https://www.poetsgate.com/ViewPoem.aspx?id=207604",""],[1824,"وبديعة قد أفرغت","https://www.poetsgate.com/ViewPoem.aspx?id=170050",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5411,"إلى رجُلٍ مُتَسلّط","https://www.poetsgate.com/ViewPoem.aspx?id=204252",""],[5419,"لويُنسى شعري","https://www.poetsgate.com/ViewPoem.aspx?id=35572",""],[5431,"الكون أنت وبانعكاسك أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=200562",""],[5434,"لاتجربونه","https://www.poetsgate.com/ViewPoem.aspx?id=37614",""],[5848,"على هوني","https://www.poetsgate.com/ViewPoem.aspx?id=51946",""],[5848,"تلعثم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=53100",""],[5952,"لم يكفنا التفاح","https://www.poetsgate.com/ViewPoem.aspx?id=203994",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[5956,"لو مات أولادي لن أحزنا","https://www.poetsgate.com/ViewPoem.aspx?id=194592",""],[5956,"ما عيب شهم أن يؤازر أشهما","https://www.poetsgate.com/ViewPoem.aspx?id=202505",""],[5956,"ازحفْ أيا أرتينُ ازحف للعُلا","https://www.poetsgate.com/ViewPoem.aspx?id=205127",""]],"verses":[["لو كلفوا مشيا على اراسهم","لمشوا كأن رؤسهم اقدام",0,"م",1,0],["لَو كَلَّتِ الخَيلُ حَتّى لا تَحَمَّلَهُ","تَحَمَّلَتهُ إِلى أَعدائِهِ الهِمَمُ",1,"م",1,0],["لو كل مجدك مستردا بالبكا","قطرت محاجره الدماء القانية",2,"ي",2,0],["لَو كَلَّمَت في أَعالِي شاهِقٍ وَعَلا","لاستَنزَلَت بِحُميَّا نَغمَتِها الوِعَلا",3,"ل",2,0],["لَوَكَّلتَ طَيّاً بِطَيِّ القِفارِ","وَلَو لَم تَرُم مُلكَهُم لَم يُرَم",4,"م",1,0],["لوك لمهزول كلامي شفا","للمرء كيف الجزل لو كلمه",5,"م",2,0],["لو كلفت عنده أيدى العفاة بأن","تأتي على أخذ ما يعطيه لم يطق",6,"ق",1,0],["لو كل غانيةٍ تعطى لشهم على","لمات من بات يهواها وما وصلا",7,"ل",2,1],["لو كَلّفوا الخيلَ العُروجَ إلى السّما","كادَتْ بهم فوقَ المجرّةِ تُعنِقُ",8,"ق",1,0],["لو كل أم أيقنت أن ابنها","سيكون مثلك لاشتهت مولودا",9,"د",2,0],["لو كل طعنةٍ فراس بأكفهم","لم يخلق المسبار للمطعون",10,"ن",1,0],["لو كلُّ من يسعى لمجدٍ نالهُ","ما كان بين العالمين خطيرُ",11,"ر",1,0],["لو كل من جا شافي","صّل مدت الأياد",12,"د",1,0],["لو كلم الميت الرميم","بسره جهراً تكلم",13,"م",1,0],["لو كل مرتحل وحل لكى أرى","التوديع والتسليم من أخلاقه",14,"ه",1,1],["لَو كُلُّ مَن رَكِبَ البَحر اِغتَنى وَنَجا","لَم يَبقَ في البرِّ للإِنسانِ مِن سَفَرِ",15,"ر",1,1],["لو كلف الخلقُ ما عاشوا عبادته","من غير حدّ لما ملوا وما عبدوا",16,"د",3,0],["لَو كلف المنطيق عدّ صِفاتكم","أَعيا فَلم يَسطع لَها تِعدادا",17,"د",2,0],["لو كلَّم الحيّ من لحظ لأقبرهُ","أو كلَّم الميَّت من لفظ لأحياهُ",18,"ا",2,0],["لو كل كلب عوى القمته حجراً","لأصبح الصخر مثقال بدينار",19,"ر",1,0],["لو كلُّ أنثى ولدت كهذي","ما فضّلوا الوليد عن وليده",20,"د",2,0],["لوكّلوه علقةً مليحهْ","وقيدوه العمر بالسجان",21,"ن",1,0],["لو كلمت ناسكاً خشوعاً","يكاد عشقاً بها يهيمُ",22,"م",1,0],["لو كل ثانيةٍ لقيتُ جوانحاً","حلَّقتُ أفلاكاً إليك اطيرُ",23,"ر",1,0],["لو كلِّفَ السَّيفُ المعا","شَ نبا بكفِّ الضَّاربِ",24,"ب",1,0],["لو كلُّ نائبةٍ للمرءِ صائبةٍ صا","بتْ ستتبعهُا الأهوالُ والنّوَبُ",25,"ب",1,0],["لو كلُّ ذي نعمةٍ ..قد طالَهُ حَسَدٌ ..","أقسمتُ ..أنعمُ كونٍ قشَّها العَرَبُ",25,"ب",1,0],["لو كلُّ ذي غايةٍ .. بالحربِ مدركها","ما كانت الروحُ -أي والله- قد نُفخَتْ",26,"ت",1,0],["لو كل خافي تقدر تشوفه العين","لا ما انخدع هاني بشوفة تهاني",27,"ن",2,0],["لو كل طآره طآحت بيد سآيق","مآ احدٍ تسبب بإصتدآم الخليقه",28,"ق",2,0],["لو كلّهم راحوا .. ولو كلّهم جو","لك غير مبدا هالمخاليق مبدا",29,"د",2,0],["لَوْ كُلُّ مَا يَتَمَنَّى الْمَرْءُ يُدْرِكُهُ","مَا كُنْتَ تَلْقَى امْرَأً فِي الْكَوْنِ مَهْمُومَا",30,"م",2,1],["لو كل غالي جابه الله لغاليه","ما شفت لك مخلوق تبكي عيونه",31,"ن",2,0],["لوكل غالي تجي دايم علي ذكره","ماصرت اشوفك هناك وحبك هنيّا",32,"ي",2,0],["لو كل بكيفه ياخذ اللي يريد","كان ماشفت ناس تموت في غلها",33,"ل",3,0],["لَوْ كَلُّ ثَانِيَةٍ بِفِكْرٍ أُخْصِبَتْ","مِنْ كُلِّ ثَانِيَةٍ تَوَلَّدَ دِرْهَمُ",34,"م",1,0],["لَوْ كُلُّ نَفْسٍ تَرْضَى بِمَا كَسَبَتْ","لَصُفِّدَ الشَّرُ وَانْجَلَى الْخَيْرُ",35,"ر",1,0],["لو كل قول محكم ببلاغة","شعرا غدا القرآن ويك معابا",36,"ب",2,0],["لو كلّ من ساس البلاد كمظهرٍ","لغدا العراقُ بخيرهِ يتعثّرُ",37,"ر",1,0],["لو كل حسناء بدت","ما اخترت إلا عينها",38,"ن",3,0],["لو كل ميت حسب منزله ثوى","البدر قبرك في السما أو فرقدُ",39,"د",1,0],["لَوْ كُلَّ من رَادَ الوُصول ترْكتهُ","لتَركْت قُطعانا وَرايَ تُهَرّجُ",40,"ج",1,0],["لو كلّ الخلق أدانوني","في عينِك ألقى تبرئتي",41,"ت",2,0],["لو كل ذي حسدٍ يعود لرشده","ويظن خيرا بالسماء ليرزقا",42,"ق",2,0],["لو كل من قاد السبب يعلم الغيب","ياما كرهت النفس من باب خيره",43,"ر",2,0],["لو كل دمعة تسيل تسيّل احزاني","ما كان خليّت دمعه تسكن عيوني",44,"ن",2,0],["لو كل من راح دمع العين لا راح طاح","سالت دموع الخلايق في ضحى عيدها",45,"د",3,0],["\"لو كل آدمَ قد غَوتْ ..تفاحةٌ","لم تَكْفِنا أرضٌ ولا تُفَّاحُ\"",46,"ح",1,0],["لو كلُّها هجمتْ عليّ سويّة","لتمكنتْ مني وكانت قابري",47,"ر",2,0],["لو كلهم ماتوا أنا لن أحزنا","مِمّا أشاهد من مذابحَ بيننا",48,"ن",2,1],["لو كل إنسانٍ توهَّم أنه","دُرَرٌ لأصبحتِ الحنايا مِنْجَما",49,"م",2,0],["لو كل مخلوقٍ توهّم أنه","ضررٌ لأصبحت البسيطة ميتما",49,"م",2,0],["لو كل إبريق دفقته في الفلا","لملأتَ مهجتها بجناتِ الكَلا",50,"ل",2,0]]}