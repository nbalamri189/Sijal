.net/poem48834.html","المنسرح"],[400,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[403,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"],[429,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[432,"قولوا لنجم الدين بل بدره","https://www.aldiwan.net/poem12649.html","السريع"],[464,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"],[477,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[477,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[495,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[495,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[515,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[515,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[538,"يوم بحلوان نقضيه على ظمإ","https://www.aldiwan.net/poem47598.html","عموديه"],[558,"أسقي نداماي من كاسي وأشرب ما","https://www.aldiwan.net/poem34312.html","البسيط"],[558,"اسقني من مدامة القدوس","https://www.aldiwan.net/poem34435.html","الخفيف"],[564,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[567,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[575,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"]],"verses":[["اِسقِني فَاليَومُ نَشوانُ","وَالرُبى صادٍ وَرَيّانُ",0,"ن",1,1],["أُسقى دُموعي إِذا ما باتَ في سَدَفٍ","صَريرُ أَثلٍ بَداريّا يُغَنّيني",1,"ي",1,0],["أَسُقيتَ بِالكَأسِ الَّتي سُقّيتُها","أَم هَل خَطَتكَ إِلَيَّ كَفُّ الساقي",2,"ي",1,0],["أَسقَطَ مِن أَيمانِنا الكِعابا","وَبَزَّنا أَرواحَنا إِغصابا",3,"ب",2,0],["أَسقي الحُسامَ وَأَسقي الرُمحَ نَهلَتَهُ","وَأَتبَعُ القِرنَ لا أَخشى مِنَ الدَرَكِ",4,"ك",1,0],["أَسقَمَ اللَهُ قَلبَها مِثلَ ما أَس","قَمَ قَلبي فَإِنَّ قَلبي سَقيمُ",5,"م",1,0],["أَسقَمتَ جِسماً كانَ ذا صِحَّةٍ","مُقَلَّبَ القَلبِ عَلى الجَمرِ",6,"ر",1,0],["أَسَقيطُ الطَلِّ فَوقَ النَرجِسِ","أَم نَسيمُ الرَوضِ تَحتَ الحِندِسِ",7,"س",1,1],["أَسقى بِلاداً ضُمِّنَت قَبرَهُ","صَوبُ مَرابيعِ الغُيوثِ السَوار",8,"ر",1,0],["أَسقى الإِلَهُ ضَريحَهُ","مِن صَوبِ دائِمَةِ الرَهائِم",9,"م",1,0],["اِسقِهِمُ السُمَّ إِن ظَفِرتَ بِهِم","وَاِمزُج لَهُم مِن لِسانِكَ العَسَلا",10,"ل",2,1],["أَسقى الإِلاهُ بِهِ حُزوى فَجادَ بِهِ","ما قَابَلَ الزُرقَ مِن سَهلٍ وَمِن جَلَدِ",11,"د",1,0],["أَسقَينَ مِن نَوءِ السِماكِ أَعهُدا","بَوادِياً مَراً ومَراً عَوَّدا",12,"د",2,0],["اسقني بنت الدوالي","إنها نعم الدوالي",13,"ي",1,1],["أسقاتهَ الرحما","من فيض بحر الجود",14,"د",1,0],["أَسقي المَنازِلَ بَينَ الدامِ وَالأُدَمى","عَينٌ تَحَلَّبُ بِالسَعدَينِ مِدرارُ",15,"ر",1,0],["أُسقيتِ مُحتَفِلاً يَستَنُّ وابِلُهُ","أَو هاطِلاً مُرثَعِناً صَوبُهُ دِرَرُ",16,"ر",1,0],["إِسقِ هَذا وَذا وَذاكَ وَعَلِّق","لا تُسَمِّ الشَرابَ إِلّا عَليقا",17,"ق",2,1],["إسقني صرفاً من الرَّا","حِ تحِتُّ الهمَّ حَتَّا",18,"ت",2,1],["اسقني شربة ألذُّ عليها","واسْقِ بالله مثلها ابن هشام",19,"م",1,1],["أسقط المدحَ فيك أن لم يُبِنْ من","ك خفياً وهل بصبحٍ خفاءُ",20,"ف",3,0],["أسقطه الجهل والسَّفال فما","يصلح إلا لكفِّ من قَفَدَهْ",21,"د",2,0],["اسقني واشرب على صحته","إنه عيد اصطباحٍ والتذاذِ",22,"ذ",1,0],["أسقمن قلبي بألوان مصححة","وأعين أدنفت بالغنج إدنافا",23,"ف",2,0],["اسقنِي سلوةً فإن أنت لم تق","دِر عليها فداوني بالمُدام",24,"م",1,0],["اسقني من مُدام ريقتها العذْ","بة إذ قد حُرِمْتُ شربَ المُدام",25,"م",1,0],["أَسقِني الصَهباءَ إِن حَضَرَت","ثُمَّ صِف لِيَ الكَأس وَالحَبَبا",26,"ب",2,0],["أَسقَيتَني صِرفَ الهَوى","فَإِذا سَكِرتُ فَلا تَلُمني",27,"ن",2,0],["أَسقَطَت إيكارَ في تَجرِبَةٍ","وَاِبنَ فِرناسٍ فَما اِستَطاعا قِياما",28,"م",2,0],["اِسقِها فَتىً","خَيرَ مَن شَرِب",29,"ب",1,0],["أسقي وأكربُ ثم أزرعُ مثلما","يعني بأرض زروعه الفلاحُ",30,"ح",1,0],["أَسقى السَحابُ الغُرُّ أَطلالَهُم","رَيّاً وَلَو مِن دَمِ أَوداجي",31,"ج",2,0],["أَسقى دِيارَكِ وَالسُقيا تَقِلُّ لَها","إِغزارُ كُلِّ مُلِثِّ الوَدقِ ثَجّاجِ",32,"ج",1,0],["أَسقى مَحَلَّتَكَ الغَمامُ وَلا يَزَل","رَوضٌ بِها خَضِرٌ وَنَورٌ جاسِدُ",33,"د",1,0],["اِسقِني بَعضَها لَعَلِّيَ أَشفى","بِدَمِ الحارِثِيِّ بَعضَ الأُوارِ",34,"ر",1,0],["أَسقى الغَمامُ عَلى الجِسرَينِ مَنزِلَهُ","لِواضِحٍ في ضِياءِ البِشرِ بَسّامِ",35,"م",1,0],["أَسقى الغَمامُ بِلادَ الغَورِ مِن بَلَدٍ","هاجَ الهَوى وَزَمانَ الغَورِ مِن زَمَنِ",36,"ن",1,0],["أَسقاهُ مِن سَيحِ الفُراتِ وَغَيرِهِ","كُدراً غَوارِبُهُ مِنَ التَيّارِ",37,"ر",1,0],["اِسقوا فَقَد مَلَأَ المُعَلّى حَوضَكُم","بِذَنوبِ مُلتَهِمِ الذِنابِ سَجيلِ",38,"ل",1,0],["أَسقيكَ مِن بارِدٍ عَلى ظَمأٍ","تَخالَهُ في الحَلاوَةِ العَسَلا",39,"ل",2,0],["أَسَقامٌ ثُمَّ مَوتٌ نازِلٌ","ثُمَّ قَبرٌ وَنُشورٌ وَجَلَب",40,"ب",1,0],["اِسقِياني مِن قَبلِ أَن يَتَقَضّى","أَمَلٌ اِرتَجي وَعُمرٌ قَصيرُ",41,"ر",1,0],["أَسقَطَهُ العارِضُ مِن رُتبَةٍ","مُخبَرَةٍ بِالقُربِ مِن رَبِّهِ",42,"ب",2,0],["أَسقي نَديمي بِها إِذ غَبَ ثالِثُنا","إِذا شَرِبتُ وَيَسقيني إِذا شَرِبا",43,"ب",2,0],["اسقني واشرب على أطلاله","واروِ عني طالما الدمع روى",44,"ر",3,0],["أَسقى طُلولَهُمُ أَجَشُّ هَزيمُ","وَغَدَت عَلَيهِم نَضرَةٌ وَنَعيمُ",45,"م",1,1],["أَسقِ الرَعِيَّةَ مِن بَشاشَتِكَ الَّتي","لَو أَنَّها ماءٌ لَكانَ مَسوسا",46,"س",2,0],["أَسقى مُخَدَّرَةَ الدُنا","نِ سُلافَ كَرمٍ قَرقَفا",47,"ف",2,0],["أَسقِني الراحَ في شَبابِ النَهارِ","وَاِنفِ هَمّي بِالخَندَريسِ العُقارِ",48,"ر",1,1],["أَسقِياني وَاِعمَلا طَربا","وَأَديرا الكَأسَ وَاِنتَخِبا",49,"ب",2,1],["أسقَطَتْهُ مِنْ ظَهْرِنَا فَأَرَتْنَا","جَيْبَهُ لازِماً لِبَطْنِ المَحَارَهْ",50,"ر",2,0],["أسقَطَ الحاءَ من الحمدِ","وما ذاك لعيّ",51,"ي",1,1],["أَسقَمَ اِسمي ريحُ فيهِ","فَأَظُنُّ اِسمي لِما بِه",52,"ب",2,0],["اِسقِنيها بِسَوادِ","قَبلَ تَغريدِ المُنادي",53,"د",2,1],["اِسقِني حَتّى تَراني","أَحسَبُ الديكَ حِمارا",54,"ر",2,0],["اِسقِني إِن سَقَيتَني بِالكَبيرِ","إِنَّ في السُكرِ لي تَمامُ السُرورُ",55,"ر",1,1],["اِسقِني إِن سَقَيتَني بِالكَبيرِ","مِن لَذيذِ الشَرابِ لا بِالصَغيرِ",56,"ر",1,1],["اِسقِنيها يا نَديمي بِغَلَس","لا بِضَوءِ الصُبحِ بَل ضَوءِ القَبَس",57,"س",1,1],["اِسقِنيها مِن قِيامي خَمسَةً","فَإِذا دارَت فَمَن شاءَ حَبَس",57,"س",1,0],["اِسقِني سَبعاً تِباعا","وَأَدِرهُنَّ سِراعا",58,"ع",2,1],["اِسقِني وَاِسقِ ذُفافَه","يا أَبا الحُرِّ سُلافَه",59,"ف",2,1],["اِسقِني وَاِسقِ يوسُفا","مُزَّةَ الطَعمِ قَرقَفا",60,"ف",2,1],["اِسقِنيها مِلءً وَفا","لا أُريدُ المُنَصَّفا",60,"ف",2,0],["اِسقِني الراحَ عَلى وَج","هٍ رَأَيناهُ نَظيفا",61,"ف",2,1],["اِسقِياني الحَرامَ قَبلَ الحَلالِ","وَدَعاني مِن دارِسِ الأَطلالِ",62,"ل",1,1],["أَسقاطُ عَسجَدِهِ فيها لَآلِئُها","مَنضودَةٌ بِسَموطِ الدُرِّ تَتَّصِلُ",63,"ل",1,0],["اِسقِنا إِنَّ يَومَنا يَومُ رامِ","وَلِرامٍ فَضلٌ عَلى الأَيّامِ",64,"م",1,1],["اِسقِني يا اِبنَ أَدهَما","وَاِتَّخِذني لَكَ اِبنَما",65,"م",2,1],["اِسقِنيها سُلافَةً","سَبَقَت خَلقَ آدَما",65,"م",2,0],["اِسقِنيها وَغَنِّ صَو","تاً لَكَ الخَيرُ أَعجَما",65,"م",2,0],["اِسقِني صَفوَ المُدامِ","قَد بَدا نَقضي ذِمامي",66,"م",2,1],["اِسقِني الخَمرَ جَهرَةً","وَأَلِطني وَأَزنِني",67,"ي",1,0],["اِسقِني يا اِبنَ أُذَينِ","مِن شَرابِ الزَرَجونِ",68,"ن",1,1],["اِسقِني حَتّى تَرى بي","جِنَّةً غَيرَ جُنونِ",68,"ن",1,0],["أَسقَمَ جِسمي وَبَرى مُهجَتي","وَسَلَّ مِنّي الروحَ صُدغاهُ",69,"ا",2,0],["أسقني باللَهِ يا عمرو","مثنى وثلاثا",70,"ث",2,1],["أسقِنيها بنتَ كرمٍ","لتلقّينا الهلالا",71,"ل",2,0],["أسقياني من شمولِ","في مدى اليوم الطويل",72,"ل",1,1],["اِسقِني يابنَ أَسعَدا","قَبلَ أَن يَنزِلَ الرَدى",73,"د",2,1],["اِسقِني ثُمَّ غَنِّني","لا أَرى النَجمَ عَرَّدا",73,"د",2,0],["أَسقَمَت لَيلَةَ الثُلاثاءِ قَلبِي","وَتَصَدَّت في السَبتِ لي لِشَقائِي",74,"ا",2,0],["أُسقُط بِما شِئتَ أَو طِر يا غُرابُ لَنا","فَإِنَّما نَحنُ في الدُنِّيا مِنَ السَقَطِ",75,"ط",1,0],["اسقني خمرةً لعلي بها أُرْ","جِعُ شيئاً مما سبتني السعير",76,"ر",1,0],["اسقني شربة مِن الماء تروي","ني فإني حران أَشكو لهاثي",77,"ي",1,0],["إسقنِيها وتفيَّأ ظُلَّتي","وترنَّمْ بأغاني حُبّها",78,"ه",2,0],["أَسقِهِ كَأسَ المَنايا","وَقِراها مِنهُ داني",79,"ي",1,0],["إسقنيها، بأبي أنت وأمي","لا لتجلو الهم عني، أنت همي",80,"ي",1,1],["إسقني من لماك أشهى من الخمر","وتم ساعةٌ على راحتيا",81,"ي",2,0],["اسقياني سُلافةً عُصرت من","قبل خلق الكُ