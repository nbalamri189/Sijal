/ViewPoem.aspx?id=157963",""],[5431,"سينقرُ شباكها اصبعُك...تساؤلات محقة","https://www.poetsgate.com/ViewPoem.aspx?id=199116",""],[5431,"هند..وبلقيس المقعدة!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200068",""],[5431,"منذا يُعيد قلوب الناس للصح؟","https://www.poetsgate.com/ViewPoem.aspx?id=211746",""],[5461,"غالي الأثمان","https://www.poetsgate.com/ViewPoem.aspx?id=8545",""],[5495,"غشمه","https://www.poetsgate.com/ViewPoem.aspx?id=175436",""],[5573,"بأطراف المدينه منغرس حارس","https://www.poetsgate.com/ViewPoem.aspx?id=206495",""],[5582,"عَرِّجْ بِذاتِ الكُورِ وَالنِّسْعَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=63590",""],[5582,"خلّ المتيّم في نهج الغواياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63473",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5652,"المماليك البحرية","https://www.poetsgate.com/ViewPoem.aspx?id=177048",""],[5652,"ماكلهم صدّام لو بانو على العالم صِدام ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=180634",""],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"ذبْحُ الصهاين للشعب الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=192288",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[5956,"أشبّه بعض أعدائي","https://www.poetsgate.com/ViewPoem.aspx?id=194027",""],[5956,"تخاصمني الحبيبة نايُ أيضاً","https://www.poetsgate.com/ViewPoem.aspx?id=194077",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[5956,"اشبح أيا أرتين في كبدِ الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=205427",""],[6018,"أشبه البدر في السنا والسناء","https://www.poetsgate.com/ViewPoem.aspx?id=181191",""],[6093,"يَزُفُّ الدَّهرُ خَوَّاناً","https://www.poetsgate.com/ViewPoem.aspx?id=176379",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6290,"هَلْ تَسْتَقِيمُ جُذُوعُنَا يَوْماً؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85166&r=&rc=16",""],[572,"جُدْلِي ببر كارِكَ الذي صَنَعَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9167&r=&rc=24",""]],"verses":[["أَشبَهتَ أَظعانَ ذاكَ الحَيِّ مِن يَمَنٍ","طيباً وَحُسناً وَأَغصاناً وَكُثبانا",0,"ن",2,0],["أَشُبُّ لِأَحرِقَ الأَعداءَ لَحظي","فَيُرجِعُني إِلى الإِغضاءِ خيمي",1,"م",2,0],["أُشَبِّبُ فيها بِذِكرِ المَشيبِ","وَما اِستَيأَسَت لِمَّتي مِن شَبابي",2,"ب",2,0],["أَشْبَهْتُ فِي شُهْرَةِ اسْمٍ وَاشْتِهَارٍ على","إِيَوَانَ كِسْرَى وَكَمْ بيْنَ الإِيوَانَيْنِ",3,"ن",1,0],["أَشبَعتِ يا حَربُ ذِئابَ الفَلا","وَغَصَّتِ العِقبانُ وَالأَنسُرُ",4,"ر",1,0],["أَشبَهتُ عِمراناً وَأَشبَهَ كُلُّ من","جاوَزتُ مَنزِلَهُ فَتى زِنباعِ",5,"ع",1,0],["أَشْبَعَتِ الفُسَّاقَ مِنْ لَحْمِهَا","وَسَفَكَتْ هَدْراً دَمَ العَاهِرَهْ",6,"ر",2,0],["أَشْبَاهُ مَوْتَى سِوَى رُؤْيَا تُرَوِّعُهُمْ","وَرَائِعَاتُ الرُّؤْى لا تَبْعَثُ الرِّمَمَا",7,"م",2,0],["أَشبَهتَ مِن عُمَرَ الفاروقِ سيرَتَهُ","سَنَّ الفَرائِضِ وَأَتَمَّت بِهِ الأُمَمُ",8,"م",1,0],["أَشبَعَني اليَومَ وَرَوّاني الفَرَح","فَقَد كَفاني فيهِ قِسطٌ وَقَدَح",9,"ح",1,0],["أشبعت أكباد أولادي وأعينهم","من الشوا ولقد كانوا ذوي قرم",10,"م",1,1],["أشبهت في حبيه ورق الحمى","فكلنا نبكي على البان",11,"ن",1,0],["أُشبِّههُ إذا أَفضَى حميداً","بإفضاءِ المَصيفِ إلى الشتاءِ",12,"ا",2,0],["أشْبعتَ عبداً فمالي","أراك لا تَسْتَكِدُّ",13,"د",1,0],["أشبَّ ما كنتُ قطُّ أهرمَ ما","كنتُ فسبحان خالَقِ البدع",14,"ع",1,0],["أشْبهتها في بردِ أع","لاها أو في حَرّ الأسافلْ",15,"ل",1,0],["أشبَهُ العالمينَ في أخذه الكُت","بَ بيحيى النبيِّ حاشا النُّبوَّه",16,"و",2,0],["أَشبَهَت حالُكَ حالي وَحَكى عُذرِيَ عُذرَك","فَمَتى أَنجو مِنَ الأَسر وَتَنجو لَستُ أَدري",17,"ي",1,0],["أَشباحُ آمالي وَأَحلامي","أَحلامُ مَن أَحلامُ مَضناكِ",18,"ك",1,0],["أَشبَهتِ لَيلى العامِرِيَّةَ فَاِكتُمي","خَبَرَ الَّذي قَد صارَ كَالمَجنونِ",19,"ن",1,0],["أَشبَهتَها بَل أَشبَهت","كَ كَأَنَّ بَينَكُما صِلَه",20,"ل",2,0],["أَشبَهَ البَدرَ وَحا","كاهُ إِلّا كَلَفَه",21,"ف",2,0],["اشبهت روضة بها","كل صنف من الزهر",22,"ر",1,0],["أَشبَهَت أَفواهُها أَعجازَها","قُنفُذٌ في اليَمِّ مَشروعُ الإِبَر",23,"ر",1,0],["أَشبَهُ بِالبَحرِ لا","يُحرِجُها مُزدَحَم",24,"م",1,0],["أَشبَهنَ مِنهُنَّ أَعطافاً وَأَجيِدَةً","وَالرَبرَبَ العينَ في الأَحداقِ وَالكَحَلِ",25,"ل",1,0],["أَشبَعتَ نَفسَكَ مِن دَمي فَهاضَكَ ما","تَلقى وَأَكثَرُ مَوتِ الناسِ بِالتُخَمِ",26,"م",1,0],["أَشبَهتُ يَعقوبَ الحَزينَ لِأَنَّني","ما إِن أَزالُ لُيوسُفٍ مُتَأَسِّفا",27,"ف",2,0],["أشبهتَ أباكَ وكنتَ بما","أشبهتَ مَعاليه قمنا",28,"ن",2,0],["أُشَبِّهُها بالقَطرِ يُبْدي تَألُّقاً","بِأَطرافِ أَغصانٍ يُحاصِرها غُدْرُ",29,"ر",1,0],["أَشبَهِ الخَلقِ جَميعاً","حينَ تَبدو بِالمِثالِ",30,"ل",1,0],["أَشبَهوا القَتلى وَما قُتِلوا","ذاكَ إِلّا أَنَّهُم سَمَروا",31,"ر",3,0],["أَشبَهنَ مِنكِ سَوالِفاً وَمَدامِعاً","فَأَرى عَلَيَّ لَها بِذاكَ ذِماما",32,"م",2,0],["أَشبَهتَ موسى غَيرَ أَنَّكَ ضارِبٌ","بِغِرارِ أَسطَعَ باهِرِ الأَسرارِ",33,"ر",1,0],["أشبَهتَ أعدائِي فَصِرتُ أحِبُّهُم","إذ كَان حَظِّي مِنك حَظِّي مِنهُم",34,"م",1,0],["أَشباهُ آنِسَةِ الحَديثِ خَريدَةٍ","كَالشَمسِ لاقَتها نُجومُ الأَسعُدِ",35,"د",1,0],["أشبهُ بالماءِ من الفِرِندِ","أقدمُ من رامٍ ويَزدجردِ",36,"د",1,0],["أشَبْتَ قُرونَ المُلكِ قبلَ مشيبهِ","فأرضاكَ منه أشْيَبُ الحلم أشيَخ",37,"خ",1,0],["أُشَبِّهُها وَقَد صُفَّت صُفوفاً","بِأَشياخٍ مُعَمَّمَةٍ قِيامِ",38,"م",1,0],["أَشبَهتَ عُقبَةَ غَيرَ ما مُتَشَبِّهٍ","وَنَشأتَ في حِلمٍ وَحُسنِ قَبول",39,"ل",1,0],["أَشبَهَكِ المِسكُ وَأَشبَهتِهِ","قائِمَةً في لَونِهِ قاعِدَه",40,"ه",1,1],["أَشباحُ إِنسٍ يَخضِبونَ صَوارِماً","تَحتَ العَجاجِ وَيَركُضونَ الشُسبا",41,"ب",2,0],["أَشباحُ ناسٍ في الزَمانِ يُرى لَها","مِثلَ الحَبابِ تَظاهُرٌ وَتَواري",42,"ر",2,0],["أشِبْهَ نعاجِ الرَّملِ هل من بقيَّةٍ","ولو سببٌ من وصلكنَّ دَقيقُ",43,"ق",1,0],["أشباحُ جنٍّ فوق صدر الماءِ","تهْفُو بأجنحةٍ من الظلماءِ",44,"ا",2,1],["أشبَهْنَ في الشّوْقِ الحَمامَ وإنما","طَيَرانُهنّ تَوَقّصٌ وذَميلُ",45,"ل",1,0],["أَشْبَاهُ مَا يُعْطَى مَنَ الثَّمَر امْرُؤٌ","فِي زَادِ تَرْحَالٍ عَلَيْهِ شَدِيدِ",46,"د",1,0],["أشبال ذا الوطن الجريح، إلى متى؟","أنتم سيوف بلادكم وتروسها",47,"س",3,0],["أَشبلَ الغيضَةِ المَرهوب باباً","أَتُسلِمُ هكَذا الأسُدُ الغِياضا",48,"ض",2,0],["أشبالُ «إسباطا» حذَوْا","في حربهم حَذْو الجدود",49,"د",1,0],["أشبالَ «لِيبْيا» كأنِّي -إذا أنزلت بكم-","نزلتُ بالقبلتين: الحجرِ، والقُدُسِ",50,"س",1,0],["أشباه ناس وخيرات البلاد لهم","يا للرجال وشعب جائع عاري",51,"ر",2,0],["أشباه ناس دنانير البلاد لهم","ووزنهم لا يساوي ربع دينار",51,"ر",1,0],["أَشْبَهَ بِالجَارِيَةِ الْغَرَّاءِ","فِي حُلَّةٍ شَفَّافَةٍ سَوْدَاءِ",52,"ا",2,0],["أشبَّانَ العراق لكم ندائي","ومثلُكُمُ جديرٌ أن يُنادى",53,"د",2,0],["أشبهنهُ النَّظرة َ الأولى وبهجتهُ","وهنَّ أحسنُ منهُ بعد ما صورا",54,"ر",2,0],["أَشْبَهِ الخَلْقِ جَميعاً","حِينَ تَبْدُو، بِکلمِثَالِ",55,"ل",1,0],["اشب بناره واليه اسعى","احاوله محاولة الفراش",56,"ش",1,0],["اشبب فيه ذاهل الفكر حائرا","ارى العمر الا في محبته سدى",57,"د",2,0],["أشبال أحمد آل حيدرة الوغى","أنجال فاطمة كفاك جدودا",58,"د",2,0],["أُشَبِّهُها غَمامَةَ يَومِ دَجنٍ","تَلَألَأَ بَرقُها أَو ضَوءَ شَمسِ",59,"س",1,0],["أشبَهتَ وَالِدَكَ الأدِيبَ المُصطفي","أدَباً وصِيتُكَ في البَرِيَّةِ قَد طَفَا",60,"ف",2,1],["أشبهت غافية غانية","قد شدت صوتاً وهزت وترا",61,"ر",2,0],["أُشَبِّهُهُ ثَدَايا ناهِداتٍ","غَلائِلُها صُبِغْنَ بِزَعْفَرانِ",62,"ن",1,0],["أُشَبِّهُ صُدْغَيْهِ بِخدَّيْهِ إِذْ بدا","بِسَالِفَتَي ريمٍ وَعِطفينِ من رَشا",63,"ا",1,0],["أَشبَهتَ والدَكَ الهُمامَ وَإِنَّما","عُرِفت بَنو الآسادِ مِن أَصواتِها",64,"ت",3,0],["أشبه الناس بالصدى إن","تحدثه حديثاً أعاده في الحال",65,"ل",1,0],["أشبّه الناس في الدنيا بمجمعة","تظلّهم نخلةٌ موفورةُ السعف",66,"ف",1,0],["أشبهني وإياهم صباحا","وقد منع العيان من الجحود",67,"د",1,0],["أَشبَهَت قضبهُ المناجلَ إذ قا","لَ اِحصُدوهم والهام منهم غثاءُ",68,"ا",2,0],["أَشبَهَت جيدهُ اِعتدالاً وحسناً","دُميةٌ مَع بياضِها جيداءُ",68,"ا",2,0],["أشبه غَمّاً يومُهُ ليلَهُ","حتى استوى الأدهمُ والأشهب",69,"ب",1,0],["اشبب بالرباب هوى وسعدى","وعليا يا اخا هند وساره",70,"ر",2,0],["أشبرا تريني في الغرام ضلالة","وبعض الهوى غيٌّ أثيمٌ مضلّل",71,"ل",1,0],["أشبهتها في الدلّ","وجفنها المعتلّ",72,"ل",1,0],["أُشَبِّهُها بِالبَدر وَالغُصنِ تارَةً","وَما هِيَ إِلّا ظَبيَةٌ وَنِفارُها",73,"ر",3,0],["أشبّانَ هذا العصر أبناءَ أُمتي","تعالوا نعالج داءَنا المتَجدّدا",74,"د",2,0],["أشبهتِني حيثُ الذبولُ نصيبُنا","لكنَّ لونَك في ذبولِكِ أحمرُ",75,"ر",1,0],["أَشْبَهْنَهُ في حَلِّ مَا يَعْقُدْنَهُ","غَدْراً فَلا عَهْدٌ وَلا مِيثَاقُ",76,"ق",1,0],["أَشْبَهْتَه في النَّشْرِ طِيباً فِلْم","خالفَتُه في الحفظ للعهد",77,"د",1,0],["أَشْبَهْتَها فِي سَعْدِها وَعُلُوِّها","وَبَهائِها فَبَقِيتَ مِثْلَ بِقائِها",78,"ه",2,0],["أَشباحُهُم في ناظِري وَخَيالُهُم","في خاطِري وَكَلامُهُم في مسمَعي",79,"ع",2,0],["أَشبها الميزانَ ما مِنْ طرفٍ","شالَ إِلاّ طرفٌ كان رجيحا",80,"ح",2,0],["أشبه الخال على خده","تشبيه من لا عنده شك",81,"ك",1,1],["أشبهت غرفةُ المشيرِ بأرضٍ","غُرفاتٍ مرفوعة بالجنانِ",82,"ن",1,0],["أَشبَهتَ عُذّالي فَصِرتُ أُحِبُّهُم","إِذا كانَ حَظّي مِنكَ حَظّي مِنهُم",83,"م",1,0],["أَشبَهُ السَيرِ بِالسَريرَةِ حَسَنا","وَالمَزايا عَلى النَوايا عَلامَه",84,"م",2,0],["أُشَبِّهُ أَيّامَ الشَبابِ الَّتي مَضَت","وَأَيّامَنا في الشَيبِ بِالفَقرِ وَالغِنى",85,"ن",2,0],["أشباح ليلي تعالي انني شبح","على مثالك اشكالي واحوالي",86,"ل",2,0],["اشباح ليلي كفى روحي معذبة","وقد تبينت اقوالي واعمالي",86,"ل",2,0],["اشباح ليلي أرى نفسي علانية","كما أراك تقاسي شر أهوال",86,"ل",1,0],["أشباح ليلي لماذا أنت صامتة","اتسخرين بآلامي واقوالي",86,"ل",2,0],["اشباح ليلي مناجاتي وعاطفتي","قد هامتا بسناك منذ اجيال",86,"ل",1,0],["اشباح ليلي إليك الشعر من شبح","يرنو إليك باكبار واجلال",86,"ل",1,0],["أُشبّهُ بِالكَواكب كُلّ خودٍ","وَيُعجبني اِجتِماع الفرقدينِ",87,"ن",1,1],["أشبهَ دَهْري أ