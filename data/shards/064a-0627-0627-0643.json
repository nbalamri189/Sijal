{"poems":[[34,"بانت لبينى فهاج القلب من بانا","https://www.aldiwan.net/poem4941.html","البسيط"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[88,"عبد المجيد قضى فوا حربا","https://www.aldiwan.net/poem45048.html","أحذ الكامل"],[27,"إن الأسيدي زنباعا وإخوته","https://www.aldiwan.net/poem5706.html","البسيط"],[72,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[51,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[51,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[70,"تأبى وإلى متى التمادي","https://www.aldiwan.net/poem42745.html","مجزوء الدوبيت"],[85,"جعلتم للفؤاد شغلا","https://www.aldiwan.net/poem7527.html","مخلع البسيط"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[43,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[43,"يا أكرم الناس في الفعال","https://www.aldiwan.net/poem10132.html","مجزوء البسيط"],[45,"العيش في ليل داريا إذا بردا","https://www.aldiwan.net/poem63497.html","البسيط"],[28,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[58,"يا أكرم الخلق على الله","https://www.aldiwan.net/poem30804.html","السريع"],[44,"يا أكرم الناس آباء ومفتخرا","https://www.aldiwan.net/poem30042.html","البسيط"],[44,"النار والعار والمكروه والعطب","https://www.aldiwan.net/poem30066.html","البسيط"],[105,"كيف القرار ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"يا آكل التفاح لاتبعدن","https://www.aldiwan.net/poem23112.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54509","الكامل"],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[108,"لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=8425",""],[45,"ألْعَيْشُ في لَيْلِ دارَيّا، إذا بَرَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31600",""],[99,"بريدها التي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=16904",""],[109,"يا أكرم الرسل يا من ليس يشبهه","https://www.aldiwan.net/poem16554.html","البسيط"],[128,"درويش يا ذا الخلفة الشوهاء","https://www.aldiwan.net/poem50675.html","البسيط"],[160,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[229,"يا أكرم الناس كل الناس في الشيم","https://www.aldiwan.net/poem50790.html","البسيط"],[229,"لو رمت قطع ودادي فيك ما انقطعا","https://www.aldiwan.net/poem50962.html","البسيط"],[259,"خلت ربوعك من غوث المناجيد","https://www.aldiwan.net/poem35744.html","البسيط"],[271,"أرياح نجد تممي الهابا","https://www.aldiwan.net/poem52113.html","الكامل"],[280,"مليت بدرا تهناه وضرغاما","https://www.aldiwan.net/poem60591.html","البسيط"],[305,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[305,"يا أكرم الناس أخلاقا وأحسنهم","https://www.aldiwan.net/poem56593.html","الكامل"],[405,"يا أكثر الناس إحسانا إلى الناس","https://www.aldiwan.net/poem49903.html","البسيط"],[410,"يا أكرم الناس من عرب ومن عجم","https://www.aldiwan.net/poem67528.html","البسيط"],[416,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[443,"نظمت لي دررا أم صغت لي ذهبا","https://www.aldiwan.net/poem56027.html","عموديه"],[495,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[515,"يا أكرم الحاضر والبادي","https://www.aldiwan.net/poem12096.html","السريع"],[524,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[524,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[553,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[564,"قد طال منك الجفاء","https://www.aldiwan.net/poem821.html",""],[586,"بمن أباحك قتلي","https://www.aldiwan.net/poem17667.html","المجتث"]],"verses":[["يا أَكمَلَ الناسِ مِن قَرنٍ إِلى قَدَمٍ","وَأَحسَنَ الناسِ ذا ثَوبٍ وَعُريانا",0,"ن",2,0],["يَاأَكْرمَ الخَلْقِ مِنْ عُرْبٍ وَمِنْ عَجَمِ","وَأَحْسَنَ النَّاسِ مِنْ حُسْنٍ وَتَزيِين",1,"ن",1,0],["يا أكرم المتهذّبين أبا","صبراً لفقدك أكرم العرب",2,"ب",1,0],["يا أَكثَرَ الناسِ أَصواتاً إِذا شَبِعوا","وَأَلأَمَ الناسِ أَخباراً عَلى الزادِ",3,"د",1,0],["يا أكملَ الرؤساء لا مستثنياً","أحداً إذا ما عدَّت الرؤساء",4,"ا",2,0],["يا أكرم الناس دون الناس كُلِّهمُ","وليس ذلك من قِيلي بإبعادِ",5,"د",1,0],["يا أكمل الناس في فضائله","من أهل بدوٍ وساكني حضرِ",6,"ر",1,0],["يا أَكرَمَ مَن رَجاهُ راجٍ","عَن بابِكَ لا يُرَدُّ سائِل",7,"ل",1,0],["يا اكحل العين اى ذنب","صير حظي لديك كحلا",8,"ل",2,0],["يا أكفأ الوزارة","يا صاحب المهارة",9,"ه",1,0],["يا أَكرَمَ الأَكرَمينَ يا مَلِكَ ال","أَملاكِ طُرّاً يا أَصيَدَ الصيدِ",10,"د",1,0],["يا أَكرَمَ الناسِ في الفَعالِ","وَأَفصَحَ الناسِ في المَقالِ",11,"ل",1,1],["يا أَكثَرَ الناسِ إِحساناً وَأَعرَضَهُم","سَيبَن وَأَطوَلَهُم في المَكرُماتِ يَدا",12,"د",2,0],["يا أَكرَمَ الناسِ إِذ هَزّوا عَوالِيَهُم","وَأَطيَبَ الناسِ عِندَ الخُبرِ مُعتَصَرا",13,"ر",2,0],["يا أَكرَمَ الخَلقِ عَلى اللَهِ","وَالمُصطفى بِالشَرَفِ الباهي",14,"ا",3,1],["يا أَكرَمَ الناسِ آباءً وَمُفتَخَرا","وَأَلأَمَ الناسِ مَبلُوّاً وَمُختَبَرا",15,"ر",2,1],["يا أَكثَرَ الناسِ وَعداً حَشوُهُ خُلُفٌ","وَأَكثَرَ الناسِ قَولاً كُلُّهُ كَذِبُ",16,"ب",1,0],["يا أَكثَرُ الناسِ إِنصافاً وَمَعدَلَةً","العَدلُ يُصعَقُ وَالإِنصافُ يحتَضرُ",17,"ر",1,0],["يا أكْرَمَ الرُّسْلِ مالِي مَنْ أَلوذُ به","سِواكَ عندَ حلولِ الحادِثِ العَمِمِ",18,"م",1,0],["يا آكِلَ التُفّاحِ لاتَبعَدَن","وَلا يُقِم يَومُ رَدىً ثاكِلَك",19,"ك",1,1],["يَا أَكْرَمَ الإِخْوَانِ قَدْ أَعْجَزْتَنِي","عَنْ أَنْ أُجِيبَ بِمَا يَشَاءُ وَفَائِي",20,"ا",2,0],["يا أكرَمَ الخلقِ ما لي مَن ألوذُ به","سِوَاكَ عِندَ حُلولِ الحادِثِ العَمِمِ",21,"م",1,0],["يا أكثر من أسكت علاشانه وأهذريبه ..","ويا أكثر من أأأضيعه وأكثر من أحفضه",22,"ض",2,0],["يا أكثرَ النّاسِ إحساناً وأعرَضَهُمْ","سَيْباً وأطْوَلَهُمْ في المَكرُماتِ يَدَا",23,"د",2,0],["يا أكسل امرأةٍ .. تخطّ رسالةً","يا أيتها الوهمُ الذي ما أشبَعَا..",24,"ع",2,0],["يا أَكرَم الرُسل يا مَن لَيسَ يَشبَههُ","في الخَلق وَالخَلق مَخلوق مِن البَشَر",25,"ر",1,1],["يا أكذبَ الضُّلاَّلِ في أخبارهم","وأخَسَّ مَن يمشى على الغَبْراءِ",26,"ا",2,0],["يا أكرمَ الخلفا وأسعدَ من سعى","في موجباتٍ العفو والغفران",27,"ن",1,0],["يا أكرمَ الناسِ كلِّ الناس في الشِّيَم","وأفضلَ الخَلق من عُرْب ومن عَجَمِ",28,"م",1,1],["يا أكرمَ الخلقِ أخلاقاً ومَحْمِيَةً","وأشرفَ الناسِ أفعالاً ومصطَنعا",29,"ع",2,0],["يا أكرمَ الناس إن ضنّ السحاب بما","يحوي وأسرعَهم للغوث إن نودي",30,"د",2,0],["يا أَكرم الكرماء يا أَعلى الورى","شرفا وأمنع ذروة وَجنابا",31,"ب",2,0],["يا أَكْرَمَ النّاسِ آباءً وَأَشْرَفَهُمْ","عِنْدَ التَّفاخُرِ أَخْوالاً وَأَعْماما",32,"م",2,0],["يا أَكرمَ الخلقِ عند اللّه منزلةً","وَمَن بهِ الوحيُ مبدوءٌ ومختتمُ",33,"م",1,0],["يا أَكرمَ الناسِ أخلاقاً وأحسنهم","تَقاضياً وأداءً للأماناتِ",34,"ت",1,1],["يا أكثر النّاسِ إحساناً إلى النّاسِ","وأحسنَ النّاسِ إغضاءً عنِ النّاسِ",35,"س",1,1],["يا أَكرَمَ الناس مِن عُربٍ وَمِن عَجَمِ","بَعدَ الخَليفَةِ يا ضَرغامَةَ العَرَبِ",36,"ب",1,1],["يا أكرمَ النَّاس في فضلٍ وفي كرمٍ","ومن رآك رأى من فضلك العجبا",37,"ب",2,0],["يا أكرم الناس عهدا لست مبتعدا","وودك مني ظل مقتربا",38,"ب",2,0],["يا آكل الخلة بي تحمضا","أرضَك لا أرض ولا مرتكضا",39,"ض",2,0],["يا أكرم الحاضر والبادي","وفارس الموكب والنادي",40,"د",2,1],["يا أَكرَم الرسل آمالي لَدَيك وَلا","يَخفى مُرادي وَلي بِالجَبر عادات",41,"ت",1,0],["يا أَكرَم الشفعاء جارية لَها","قَلب يقلب في لَظى برحائِهِ",42,"ا",3,0],["يا أَكرَمَ الرُّسلِ سُؤلي مِنكَ غَيرُ خفِ","وَأَنتَ أَكرَمُ مَدعوّ إِلى الكَرَمِ",43,"م",1,0],["يا أَكرَمَ الناسِ إِذ تُرجى لِنائِبَةٍ","جاءَت بِها حادِثاتُ الدَهرِ تَهديها",44,"ي",3,0],["يا أكمل الناس حسناً","لك السنى والسناء",45,"ا",2,0],["يَا أَكْرَمَ النَّاسِ عِنْدِي","قَدْ لَذِّ لِي فِيكَ ذُلِّي",46,"ي",1,0]]}