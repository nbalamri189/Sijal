.dctabudhabi.ae/diwan/poem/34853","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119671","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123487","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4269,"","https://poetry.dctabudhabi.ae/diwan/poem/199862","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83489","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83357","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83462","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83639","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83571","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83495","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83471","المجتث"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83459","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83371","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83532","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83524","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133094","البسيط"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143719","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4755,"مطر القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200000",""],[4869,"ترنيمة جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=151510",""],[4869,"مقطوع من شجْرة احزاني","https://www.poetsgate.com/ViewPoem.aspx?id=151719",""],[4935,"تحسين شاكر زها ختانه","https://www.poetsgate.com/ViewPoem.aspx?id=129432",""],[5016,"يا أكرم الكرماء يا من لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=187102",""],[5074,"القرية الوادعة","https://www.poetsgate.com/ViewPoem.aspx?id=157488",""],[5136,"عاد عليك العيد عام فعام","https://www.poetsgate.com/ViewPoem.aspx?id=121722",""],[5145,"يا أكرم الناس لا مستثنياً أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=108251",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5320,"إلى الرغيف","https://www.poetsgate.com/ViewPoem.aspx?id=43255",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"فحياتي تنيرها حواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=196821",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[5458,"وداعاً يا رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=72282",""],[5690,"يا أكرم الخلق يا من ما دعاه فتى","https://www.poetsgate.com/ViewPoem.aspx?id=172199",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[6031,"يا أكْرَمَ النَّاسِ أعْمَاماً وأَخْوَالاَ","https://www.poetsgate.com/ViewPoem.aspx?id=46368",""],[6093,"أصورَ الجَرْحَ في القرطاسْ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=183886",""],[520,"يا اكرم الناس وجها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577477",""]],"verses":[["يا أَكمَلَ الناسِ مِن قَرنٍ إِلى قَدَمٍ","وَأَحسَنَ الناسِ ذا ثَوبٍ وَعُريانا",0,"ن",2,0],["يَاأَكْرمَ الخَلْقِ مِنْ عُرْبٍ وَمِنْ عَجَمِ","وَأَحْسَنَ النَّاسِ مِنْ حُسْنٍ وَتَزيِين",1,"ن",1,0],["يا أكرم المتهذّبين أبا","صبراً لفقدك أكرم العرب",2,"ب",1,0],["يا أَكثَرَ الناسِ أَصواتاً إِذا شَبِعوا","وَأَلأَمَ الناسِ أَخباراً عَلى الزادِ",3,"د",1,0],["يا أكملَ الرؤساء لا مستثنياً","أحداً إذا ما عدَّت الرؤساء",4,"ا",2,0],["يا أكرم الناس دون الناس كُلِّهمُ","وليس ذلك من قِيلي بإبعادِ",5,"د",1,0],["يا أكمل الناس في فضائله","من أهل بدوٍ وساكني حضرِ",6,"ر",1,0],["يا أَكرَمَ مَن رَجاهُ راجٍ","عَن بابِكَ لا يُرَدُّ سائِل",7,"ل",1,0],["يا اكحل العين اى ذنب","صير حظي لديك كحلا",8,"ل",2,0],["يا أكفأ الوزارة","يا صاحب المهارة",9,"ه",1,0],["يا أَكرَمَ الأَكرَمينَ يا مَلِكَ ال","أَملاكِ طُرّاً يا أَصيَدَ الصيدِ",10,"د",1,0],["يا أَكرَمَ الناسِ في الفَعالِ","وَأَفصَحَ الناسِ في المَقالِ",11,"ل",1,1],["يا أَكثَرَ الناسِ إِحساناً وَأَعرَضَهُم","سَيبَن وَأَطوَلَهُم في المَكرُماتِ يَدا",12,"د",2,0],["يا أَكرَمَ الناسِ إِذ هَزّوا عَوالِيَهُم","وَأَطيَبَ الناسِ عِندَ الخُبرِ مُعتَصَرا",13,"ر",2,0],["يا أَكرَمَ الخَلقِ عَلى اللَهِ","وَالمُصطفى بِالشَرَفِ الباهي",14,"ا",3,1],["يا أَكرَمَ الناسِ آباءً وَمُفتَخَرا","وَأَلأَمَ الناسِ مَبلُوّاً وَمُختَبَرا",15,"ر",2,1],["يا أَكثَرَ الناسِ وَعداً حَشوُهُ خُلُفٌ","وَأَكثَرَ الناسِ قَولاً كُلُّهُ كَذِبُ",16,"ب",1,0],["يا أَكثَرُ الناسِ إِنصافاً وَمَعدَلَةً","العَدلُ يُصعَقُ وَالإِنصافُ يحتَضرُ",17,"ر",1,0],["يا أكْرَمَ الرُّسْلِ مالِي مَنْ أَلوذُ به","سِواكَ عندَ حلولِ الحادِثِ العَمِمِ",18,"م",1,0],["يا آكِلَ التُفّاحِ لاتَبعَدَن","وَلا يُقِم يَومُ رَدىً ثاكِلَك",19,"ك",1,1],["يَا أَكْرَمَ الإِخْوَانِ قَدْ أَعْجَزْتَنِي","عَنْ أَنْ أُجِيبَ بِمَا يَشَاءُ وَفَائِي",20,"ا",2,0],["يا أكرَمَ الخلقِ ما لي مَن ألوذُ به","سِوَاكَ عِندَ حُلولِ الحادِثِ العَمِمِ",21,"م",1,0],["يا أكثر من أسكت علاشانه وأهذريبه ..","ويا أكثر من أأأضيعه وأكثر من أحفضه",22,"ض",2,0],["يا أكثرَ النّاسِ إحساناً وأعرَضَهُمْ","سَيْباً وأطْوَلَهُمْ في المَكرُماتِ يَدَا",23,"د",2,0],["يا أكسل امرأةٍ .. تخطّ رسالةً","يا أيتها الوهمُ الذي ما أشبَعَا..",24,"ع",2,0],["يا أَكرَم الرُسل يا مَن لَيسَ يَشبَههُ","في الخَلق وَالخَلق مَخلوق مِن البَشَر",25,"ر",1,1],["يا أكذبَ الضُّلاَّلِ في أخبارهم","وأخَسَّ مَن يمشى على الغَبْراءِ",26,"ا",2,0],["يا أكرمَ الخلفا وأسعدَ من سعى","في موجباتٍ العفو والغفران",27,"ن",1,0],["يا أكرمَ الناسِ كلِّ الناس في الشِّيَم","وأفضلَ الخَلق من عُرْب ومن عَجَمِ",28,"م",1,1],["يا أكرمَ الخلقِ أخلاقاً ومَحْمِيَةً","وأشرفَ الناسِ أفعالاً ومصطَنعا",29,"ع",2,0],["يا أكرمَ الناس إن ضنّ السحاب بما","يحوي وأسرعَهم للغوث إن نودي",30,"د",2,0],["يا أَكرم الكرماء يا أَعلى الورى","شرفا وأمنع ذروة وَجنابا",31,"ب",2,0],["يا أَكْرَمَ النّاسِ آباءً وَأَشْرَفَهُمْ","عِنْدَ التَّفاخُرِ أَخْوالاً وَأَعْماما",32,"م",2,0],["يا أَكرمَ الخلقِ عند اللّه منزلةً","وَمَن بهِ الوحيُ مبدوءٌ ومختتمُ",33,"م",1,0],["يا أَكرمَ الناسِ أخلاقاً وأحسنهم","تَقاضياً وأداءً للأماناتِ",34,"ت",1,1],["يا أكثر النّاسِ إحساناً إلى النّاسِ","وأحسنَ النّاسِ إغضاءً عنِ النّاسِ",35,"س",1,1],["يا أَكرَمَ الناس مِن عُربٍ وَمِن عَجَمِ","بَعدَ الخَليفَةِ يا ضَرغامَةَ العَرَبِ",36,"ب",1,1],["يا أكرمَ النَّاس في فضلٍ وفي كرمٍ","ومن رآك رأى من فضلك العجبا",37,"ب",2,0],["يا أكرم الناس عهدا لست مبتعدا","وودك مني ظل مقتربا",38,"ب",2,0],["يا آكل الخلة بي تحمضا","أرضَك لا أرض ولا مرتكضا",39,"ض",2,0],["يا أكرم الحاضر والبادي","وفارس الموكب والنادي",40,"د",2,1],["يا أَكرَم الرسل آمالي لَدَيك وَلا","يَخفى مُرادي وَلي بِالجَبر عادات",41,"ت",1,0],["يا أَكرَم الشفعاء جارية لَها","قَلب يقلب في لَظى برحائِهِ",42,"ا",3,0],["يا أَكرَمَ الرُّسلِ سُؤلي مِنكَ غَيرُ خفِ","وَأَنتَ أَكرَمُ مَدعوّ إِلى الكَرَمِ",43,"م",1,0],["يا أَكرَمَ الناسِ إِذ تُرجى لِنائِبَةٍ","جاءَت بِها حادِثاتُ الدَهرِ تَهديها",44,"ي",3,0],["يا أكمل الناس حسناً","لك السنى والسناء",45,"ا",2,0],["يَا أَكْرَمَ النَّاسِ عِنْدِي","قَدْ لَذِّ لِي فِيكَ ذُلِّي",46,"ل",2,0],["يا اكرم الضيفان انك أينما","تحلل فانت موقر ومبجل",47,"ل",1,0],["يا أكرم الخلق بعد الرُّسل قاطبة","يا خير من قصدت أبوابه الأمم",48,"م",1,0],["يا أكثَرَ النّاسِ إحساناً وأَصدَقَهُم","وَعداً وأسرَعَهُم في النَّيلِ تَعجيلا",49,"ل",2,0],["يا أَكبر الوزراء تِلكَ فَريدة","مِنها حلت بِثنا علاك شَمائل",50,"ل",1,0],["يا أَكرم الأَملاك يا غَيث النَدى","يا طَيِّب الأَجداد وَالآباء",51,"ا",2,0],["يا أَكرَم والٍ مَسرورِ","يا أَكرم والٍ ذي شممِ",52,"م",1,0],["يا أَكمَلَ الناسِ حُسنا","صِل أَكمَلَ الناسِ حُزنا",53,"ن",2,0],["يا أكرم الخلق فاعذر شاعراً وقفت","عن درك أوصافك العليا قرائحه",54,"ح",2,0],["يا أكملَ الناسِ في خَلْقٍ وفي خُلُقٍ","إذا غَدَتْ خِلَقٌ أضدادَ أخلاق",55,"ق",1,0],["يا أكرمَ الكرما يا أرحمَ الرُّحما","يا أفهمَ الفُهَما يا أعلمَ العُلما",56,"م",2,0],["يا أكرمَ الخلق نبي الهدى","محمداً يا من عليه البلاغْ",57,"غ",1,1],["يا أكرم الخق اني ميتُ شوقكم","لوكنت أحسب ميتا بين أحياء",58,"ا",2,0],["يا أكثر الكرماء إِح","سانا وأحسنهنّ أثرا",59,"ر",2,0],["يا أكبر العالمين قدرا","إسلم فما في علاك كبرُ",60,"ر",1,0],["يا أكمل من قام بالأوامر داع","يا اسمل من زاح بالزواجر عقّال",61,"ل",1,0],["يا أكرم من خص بالمديح وجازى","فضلا بأياد تعم الأول والتال",61,"ل",1,0],["يا أكرم العرب الكرام ومن له","جاه به لاذ المسيح وآدم",62,"م",1,1],["يا أكرم العرب يا أزكى الورى حسبا","يا أشرف الرسل يا من قاله القيل",63,"ل",1,0],["يا أكرم الرسل الكرام ومن على","عليائه بعد الإله توكلي",64,"ل",2,0],["يا أكرم الرسل من أنس ومن ملك","واشرف الخلق من ماض ومن آت",65,"ت",1,0],["يا أكرم الخلق يا أوفى الورى صلة","حسبي امتداح آثارته المحبات",66,"ت",1,0],["يا أكرم الكرما اختم بالرضا عملي","فقد توالت على هلكي الجنايات",66,"ت",1,0],["يا أكرم الكرما أنظرني بعين رضا","واختم بها عملي يا أكرم الكرما",67,"م",2,0],["يَا أكرمَ مَنْ جِىءَ بِرَفْعِ الحُجُبِ","فَوْقَ الرتُّبِ",68,"ب",1,0],["يا أكرم الأكرمين الصيد في بلد","لم ألق في قومه إِلا الذي حصفا",69,"ف",2,0],["يَا أَكرَم الأَنبِيا يا مَن بِنعمَتِه","لِلقادِمينَ عَلى التَخويفِ تَحويلُ",70,"ل",1,0],["يا أكرم الناس جد لي بالرضا كرماً","فأنت أكرم من يثني عليه فم",71,"م",1,0],["يا أكثرَ النّاسِ بى علماً ومعرفةً","متى تُعبّرُ عن أعرافه الذّهبُ",72,"ب",1,0],["يا أكرم الرسل ومن عاداته","لم نحص في تعدادها أفضالها",73,"ل",3,0],["يا أكرم الخلق يا أزكى الأنام ويا","أوفى نبي لسبل الحق منتهج",74,"ج",1,0],["يا أكرم الخلق على الله يا","غوث البرايا يا شفيع العصاه",75,"ا",2,0],["يا أَكرمَ الناسِ والأيامُ شاهدةٌ","على مآثرَ يَهوى حُسْنَها الكَرَمُ",76,"م",1,1],["يا أَكرَمَ الرُسلِ المُجارِ نَزيلُهُم","إِنّي نَزَلتُ عَلى حِماكَ لَأَخفَرا",77,"ر",2,0],["يا أكرم الثقلين لا بخل الحيا","يوماً عليك بعارض هطال",78,"ل",1,0],["يا أكرم الناس آلاءً وأوسعَهم","أفقاً وأثبتَهم في الحق إقداما",79,"م",2,0],["يا أكرم الناس عند اللأضه منزلةً","وخير من ولدت أمٌّ وما تلد",80,"د",1,0],["يا اكرم الخلق على ربه","ويها امام الرسل لما سرى",81,"ر",2,0],["يا أَكرَمَ الناسِ مِن عُربٍ وَمِن عَجَمٍ","وَأَشجَعَ الناسِ مِن حافٍ وَمُنتَعِلٍ",82,"ل",1,0],["يا أَكرَمَ الناسِ عِش لِلناسِ في دَعَةٍ","ما عاش لِي فِيكَ هَذا الفائِحُ العَبقُ",83,"ق",1,0],["يا أَكرَمَ الناسِ إِن هُمُو كَرُمُوا","وَأَشجَعَ الناسِ إِن هُمُو شَجُعُوا",84,"ع",3,0],["يا آكليه خوانيقاً بأعينكم","أين المقشّر من موز كأشبار",85,"ر",1,0],["يا أَكرَمَ الرُّسلِ مالِى غيرُ جاهِكَ مَن","أَرجُوهُ فى دُنيَتى وَالدِّينِ لأخرَاتِى",86,"ت",2,0],["يا أكرَمَ الخَلقِ جُد لِعَبدٍ","جانٍ غَدَا حالُهُ عَجِيبُ",87,"ب",1,0],["يا أكرَمَ الخَلقِ يا مَن حازَ مرتَبَةً","عَلياءَ ما نالَها مِن غَيرِكُم أَحَدُ",88,"د",1,0],["يا أَكرَمَ الثَّقَلَينِ يا كَنزَ الوَرى","نادَاكَ عَبدٌ أُوثِقَت قَدَماهُ",89,"ا",2,0],["يا أكرم الناس عندي","حزتم مزايا جليله",90,"ل",2,1],["يا أكرم الأكرمين أعطف عليّ وخذ","أخذاً وبيلا فتى يهوى معاندتي",91,"ي",1,0],["يا أكرم الكرماء يا ربّ السما","يا كاشفاً ضرّاء من يتضرّع",92,"ع",1,0],["يا أكرم الخلق يا خير الورى خلقا","تلاف ما كان مني بالضنى تلفا",93,"ف",2,0],["يا أكرم الرسل الكرام ومن به","لاذوا لكشف الضر والبأساء",94,"ا",2,0],["يا أَكرَمَ الكُرَماءِ يا أَعلى الوَرى","وَأَعَزَّ مَن تَخِذَ المَطِيَّ رِكابا",95,"ب",2,0],["يا أكرم الخلق على ربه","يا من هو الأفضل والأكمل",96,"ل",1,0],["يا آكلاً كل ما اشتهاه","وشاتم الطب والطبيب",97,"ب",1,1],["يا أكرم الخلق ما لي من أَلوذ به","إذا مُنِيت مَع الشكران بالنقم",98,"م",1,0],["يا أكرَم الناس أخلاقاً وأوفرَهُم","عقلاً وأسبقهم فيه إلى الأَمَدِ",99,"د",1,0],["يا أكفر القوم بالنعمى اذا غدقت","واكثر الخلق كل الخلق تلوينا",100,"ن",2,0],["يا أكرمَ الناسِ بلا مينِ","أُصبت في ردفك بالعين",101,"ن",1,1],["يا أكرم الخلق لا مستثنياً ملكاً","ومفرق الفرقتين العرب والعجم",102,"م",1,0],["يا أكرم الوزراء سعيك قد غدا","لحبيب رب العالمين حبيبا",103,"ب",2,0],["يا أكرم الأمهاتِ الطاهرات لقد","أودعتِ قلبي غليلا دونه النارُ",104,"ر",1,0],["يا أكرم الناس في بؤس وفي نعم","وخير ساع الى مجد على قدم",105,"م",1,1],["يا أَكرَمَ العالَمِ مَوجودا","وَيا أَعَزَّ الناسِ مَفقودا",106,"د",2,1],["يا أَكلَةً ذَهَبَت أَبقَت حَرارَتُها","داءً بِقَلبِكَ ما صُمنا وَصَلَّينا",107,"ن",2,0],["يا أكرم الأرسال بل يا خير خَل","ق اللَه بل يا مظهر الإسلام",108,"م",1,0],["يا أكرم الكرماء يا من جوده","كل البحار لديه كالقطرات",109,"ت",1,0],["يا أكرم الرسل يا من جود راحته","عمّ الوجود وكل من نداه حثا",110,"ث",2,0],["يا أكرم الخ