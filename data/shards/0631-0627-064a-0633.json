{"poems":[[55,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[71,"ومرتجة الأرداف طاوية الحشا","https://www.aldiwan.net/poem28370.html","الطويل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[406,"سيل أشواقي","https://www.aldiwan.net/poem6717.html","عموديه"],[415,"أبا الفوارس ما لاقيت من زمني","https://www.aldiwan.net/poem31708.html","عموديه"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44960","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109200","السريع"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122037","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35749","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141255","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75962","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62845","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86279","البسيط"],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""]],"verses":[["رَأى سَيفَهُ فيها فَعَضَّ بَنانَهُ","فَأَلّا أَبا الغَلّاقِ كُنتُ تُبادِرُ",0,"ر",1,0],["رَأى سالِفَ الدُنيا وَشابِكَ آلِهِ","أَحَقَّ بِأَن يَرعاهُ في سالِفِ العَهدِ",1,"د",1,0],["رأى ساقُها أنْ ينصرَ الخصرَ عندما","رأى الضعفَ لكنْ حال بينهما الموجُ",2,"ج",1,0],["رأىٌ سقىَ اللهُ الخلافةَ صوبَهُ","ورمى بصاعقه ذوى الشَّنآنِ",3,"ن",1,0],["رأى سيلَ أشواقي إليكِ لأصبحتْ","حقيقتُهُ مِمَّا رآهُ بلا معنى",4,"ن",2,0],["رأى سماحي بمنذور تجانف لي","عنه وجودي به فاجتاح موجودي",5,"د",2,0],["رَأى سوذَنيق الجَو مِنهُنَّ غَرَّة","فَكَفكَفَ يَبغيهِنَّ كَالنَجمِ في القَض",6,"ض",1,0],["رأى سناها ذهباً سائلاً","فباعه مني بدرِ الكلام",7,"م",1,0],["رَأَى سَقَماً بِمُقْلَتِهِ فَوَافَى","بِآسٍ عَادَ لَكِنْ مِنْ عذَارِ",8,"ر",1,0],["رَأَيٌ سَرى وَعُيونُ الناسِ هاجِعَةٌ","ما أَخَّرَ الحَزمَ رَأيٌ قَدَّمَ الحَذَرا",9,"ر",2,1],["رأى سليمان مشهوراً بحكمته","يعنو لسطوته القاصي مع الدّاني",10,"ن",2,0],["رَأى سُموي وَما أُوتيتُ مِن شَرَفٍ","فَرامَ هَتكَ حِمىً مازالَ مُحتَرَسا",11,"س",2,0],["رأيٌ سديدٌ للسداد موفّقٌ","باعٌ مديدٌ بالسخا يتكرم",12,"م",1,0],["رأَى سيفَه أوَفى له من حَمِيمِهِ","فعاذَ به أنَّ العَزِيزَ مُمَنَّعُ",13,"ع",1,0],["رَأى سَحاب السَما فيضاً لِراحَتِهِ","فَغيرة مِنهُ سالَت اعيُنُ الديمِ",14,"م",1,0],["رأى سعد ما لاقى سُعيد فهاله","وعيد أخي البتراء إذ قام مزبدا",15,"د",2,0],["رأى ساحرٌ مسلمًا قارئًا","وقد بطلَ السحرُ ثمّ انقلبْ",16,"ب",1,1]]}