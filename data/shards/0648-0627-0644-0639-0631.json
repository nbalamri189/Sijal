/ViewPoem.aspx?id=199886",""],[4955,"تبدو غريباً إذا ما كنت ذا خلقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188548",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[4988,"رحيل ومحطات","https://www.poetsgate.com/ViewPoem.aspx?id=215968",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5046,"كأس العالم","https://www.poetsgate.com/ViewPoem.aspx?id=198446",""],[5061,"البدر لا غاب","https://www.poetsgate.com/ViewPoem.aspx?id=147151",""],[5061,"الديه","https://www.poetsgate.com/ViewPoem.aspx?id=147168",""],[585,"لمن اللواء محلقاً يتهلل","https://www.poetsgate.com/ViewPoem.aspx?id=161887",""],[5094,"جولان الخصوبة","https://www.poetsgate.com/ViewPoem.aspx?id=27772",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5219,"لكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194512",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5237,"هذي رياح اليمن هب نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5279,"آهٍ يَا شَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=183879",""],[5280,"سيدنا محمد رسول الله ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=189571",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5376,"يا قدسُ لو متْنا جميعاً كلَّنا","https://www.poetsgate.com/ViewPoem.aspx?id=189514",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5376,"في الليلة الظلماء ساد نواح","https://www.poetsgate.com/ViewPoem.aspx?id=194862",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5616,"تأبين الفقيد فاروق","https://www.poetsgate.com/ViewPoem.aspx?id=203499",""],[5626,"فُكّي القيود","https://www.poetsgate.com/ViewPoem.aspx?id=189513",""],[5638,"يا قدس صبرًا","https://www.poetsgate.com/ViewPoem.aspx?id=198037",""],[5695,"همسة قبل الإمساك..","https://www.poetsgate.com/ViewPoem.aspx?id=212531",""],[5704,"لبيك يا أقصى","https://www.poetsgate.com/ViewPoem.aspx?id=191599",""],[5704,"القدس لنا","https://www.poetsgate.com/ViewPoem.aspx?id=194471",""],[5717,"إنا من الغابر نتقم السير","https://www.poetsgate.com/ViewPoem.aspx?id=170583",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5848,"من متى والقلب يصبر","https://www.poetsgate.com/ViewPoem.aspx?id=53099",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[4442,"الدر في التاج غير الدر السدف","https://www.poetsgate.com/ViewPoem.aspx?id=171197",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[454,"شارون عربد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82665&r=&rc=29",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""]],"verses":[["والعرب في يومنا كالَطْيس إن حسبوا","كانوا ثمانين مليوناً لمحتسب",0,"ب",1,0],["والعُرب أكبر أمة مشهورة","بفُتوحها وعلومها وبيانها",1,"ن",3,0],["والعريق الذي تسامت فروع","من علا بيته وساخت عروق",2,"ق",1,0],["والعرفُ أعجمُ حين يُولَى مُفْحَماً","وبأن يُضَمَّنَ شَاعِراً إفصاحُه",3,"ح",2,0],["والعرفُ معروفٌ لذا","تِ طباعه والنكرُ مُنكر",4,"ر",1,0],["والعُرف تُسديه إلى لَسِنٍ","خيرُ المتاعِ وأفضلُ التِّرَكِ",5,"ك",1,0],["والعرش في عيد بصاحب عهده","والتاج خلف العرش يحيى المولدا",6,"د",2,0],["وَالعَرشُ يَزهو وَالحَظيرَةُ تَزدَهي","وَالمُنتَهى وَالسِدرَةُ العَصماءُ",7,"ا",2,0],["وَالعَريضُ الطَويلُ مِنها كِتابٌ","لَكَ فيهِ تَحِيَّةٌ وَثَناءُ",8,"ا",2,0],["وَالعُرفُ بُنيانٌ فَمَن يَعدُ الرُبى","يُشرِف وَيَعفُ السَيلُ مِن بُنيانِهِ",9,"ن",2,0],["والعُرْوَةُ الوثقى إذا استيقَظْ","تِ تُؤذِنُ بانفصام",10,"م",1,0],["وَالعَرَضَ الظاهِرَ في التَجسيمِ","وَالقَولَ في طَلائِعِ النُجومِ",11,"م",1,0],["وَالعُربُ خالَفَتِ الحَضارَةَ وَاِنتَقَت","سُكنى الفَلاةِ وَرُعلَها وَصُفارَها",12,"ر",3,0],["والعرفُ من يأتهِ تحمد عواقبهُ","ما ضاع عرفٌ وإن أولَيتهُ حجرا",13,"ر",2,0],["والعرْشُ بين خُمارِهِ وقِمارِهِ","لاءٍ، تَحُفُّ به ذواتُ حِجالِهِ",14,"ل",2,0],["والعرش أشبهُ بالدُّمى","والقولُ ما قال العميد",15,"د",1,0],["والعرش عِزَّتُه من عِزِّ أمته","إن هان شعبٌ على حُكَّامه هانوا",16,"ن",3,0],["والعرف والشكر الدوام مداوماً","لذي عشرة وذويها فاصحب وأدوما",17,"م",2,0],["والعُري أطيب من حكا","كك في العموم وفي الخصوص",18,"ص",1,0],["وَالعَرفُ زَهوُ حَدائِقٍ","نَمَّت بِهِنَّ شَمائِلُ",19,"ل",1,0],["وَالعُربُ تَجمَعُ من أَنفاسِهِ نَسماً","وَتَستَعيدُ بِها لِلفَضلِ ما كانا",20,"ن",2,0],["وَالعرش إن أخلاهُ منهم ماجِدٌ","ذكرَ الأَماجدَ منهمُ وَتخيَّرا",21,"ر",2,0],["والعرب في دعةٍ ناموا على أمل","أن يقصف الرعد أعداء الهدى فيه",22,"ي",2,0],["والعروس التي تزف إلى الأر","طال في ثوب صبغها الأرجواني",23,"ن",2,0],["وَالعَرَبُ العَرباءُ أَصلَبُ نَبعَةً","وَهَل يَستَطيعُ الحَزَّ في النَبعِ ضارِسُ",24,"س",1,0],["والعرب دائمة فيها صنائعهم","وإنَّ منها لتبشيراً وترحابا",25,"ب",2,0],["وَالعَرش يَهتَزُّ مِن تَعظيمِهِ طَرَبا","اذ شرف العرش وَالكرسي مقدمه",26,"م",2,0],["وَالعرش بالضَيف النَزيل قد امتلا","كرما وَضيف الاكرمين مكرم",27,"م",1,0],["وَالعَرَبُ العَرباءُ كانوا بِهِ","في الزَّمَنِ الغابِرِ أَهلَ اِفتِنان",28,"ن",1,0],["وَالعرف أفضَلُ ما اِقتنيت وَخيرهُ","ما سدّ خلّةَ مستحقٍّ صابرِ",29,"ر",1,0],["والعراق الهضيم والأردن الضائع","كل لصحبه كالسمى",30,"م",2,0],["والعُرْبُ قد سارَتْ إثْرنا","فأدركَتْ سُؤْراً تَركْناه",31,"ا",2,0],["وَالعُرف بَدر كُلَمّا اسدَفَت","لَهُ لَيالي الجحد زادَ اتِضاح",32,"ح",1,0],["والعُرْبُ أقتَلُ داءٍ يَهلِكُون به","أن تَملِكَ الحُكم في أعناقِهَا عَجَمُ",33,"م",1,0],["والعراق اليوم لولا عدلُهُ","ما رأى من بعد ما اعْوجَّ اعتدالا",34,"ل",2,0],["والعرب تعرف فضله وجهاده","كالغيث حيث يصيب أرضا تمرع",35,"ع",1,0],["والعرب بين معينها ومهينه","أودت بخير تليدها وجديدها",36,"د",3,0],["والعُرْبُ في تردُّدْ","والغربُ في تفرُّدْ",37,"د",1,0],["والعربِيِّ ساكنَ الجِنانِ","والمُقتفِي لسيرَةِ العَدناني",38,"ي",1,0],["والعرش منشأنا وكرسي الملا","هيآتنا ونفوسنا الأقدار",39,"ر",1,0],["وَالعَربُ لا تَبدَأ بِجَمعِ جُموعِها","إِلّا سَمِعتَ نَشيدَها وَحَداءَها",40,"ا",3,0],["والعروة الوثقى منَ الدين غدَت","يا للوَرى من بعدهِ منحلّه",41,"ل",2,0],["والعراقيون طراً مهجة","طفحت أنساً وثغر يتبسم",42,"م",1,0],["والعرش عرش الرافدين عليه من","ك الليث ليث وقيعة وطعان",43,"ن",1,0],["والعرش معتزٌّ مكينٌ فوقه","تلقى الوفود وتبعث الآمالا",44,"ل",2,0],["والعربُ العرباءُ مِن حوله","طوعاً له في كُلِّ أمْرٍ يُرادْ",45,"د",1,0],["والعِرس ما ربحت من حقها فلها","لأنه مِلكها والربح قد تبعا",46,"ع",2,0],["وَالعَريشُ الرَّحبُ مِن غَربِيِّهِ","رَوضَةٌ أَزهارُها الآدابُ غَنّا",47,"ن",2,0],["والعرض من لبس ثياب الخنا","عار فما يقربه عارُ",48,"ر",1,0],["والعُرفُ إن لم تكن تُتَمِّمُهُ","صارَ قريبَ المعنى من النكرِ",49,"ر",1,0],["والعُرْف مِنك النكر إن يَوماً أتى","أنيَّ وحَالكَ كلها نَكْراءُ",50,"ا",2,0],["والعرب بوصف معانيها","تشدو والترك بها شاعرْ",51,"ر",1,0],["والعرب تعرب عن شهامة نفسها","وبها تعيد الامتداح بلا مللْ",52,"ل",1,0],["والعرب في مصر","كالعجم في تستر",53,"ر",1,0],["والعرف مع نكر ثلاه في الأثر","يجوز في الشعر كقول من غبر",54,"ر",1,0],["والعربُ تفخرُ في دينٍ وفي خُلُقٍ","في عهدكمْ لن تَمَسَّ الدّارَ أخطار",55,"ر",1,0],["والعرش لا يقوى على حملها","وكل من في العرش عنها يفر",56,"ر",1,0],["والعروسه ما معاها الّا جفير","والمحبه في القلوب مْصَوِّرَه",57,"ر",2,0],["والعرب لن ينهضوا بعد انقسامهم","ففي سماء المعالي نجمهم غربا",58,"ب",2,0],["والعرب خلفك شعب العرب أجمعه","صفاً توحد إسراراً وإعلانا",59,"ن",2,0],["والعُربُ والإسلام كُلٌ لاهج","ومردِّدٌ أفضاله ترديدا",60,"د",2,0],["والعُرب للإسلام نبض عروقه","إسلامنا قد ضمَّما توحيدا",60,"د",2,0],["والعرب شيمتهم على طول المدى","عفو وغفران وخلق سماح",61,"ح",1,0],["والعرش والأفلاك ودت أنها","لك تربة ولخط قبرك موضع",62,"ع",1,0],["والعرش والكرسى والألواح والا","قلام والأفهام والأبصار",63,"ر",1,0],["والعَرشُ وَالكُرسيُّ لا يُفنِيهمَا","أيضاً وَإنَّهُمَا لَمخلُوقَانِ",64,"ن",1,0],["والعَرشُ لَيسَ عَلَيهِ معبُودٌ سِوَى ال","عَدَمِ الذي لاَ شَيءَ في الأعيَانِ",64,"ن",1,0],["وَالعَرشَ أخلَينَاهُ مِنكَ فَلَستَ فَو","قَ العَرشِ لَستَ بِقَابِلٍ لِمَكَانِ",64,"ن",1,0],["والعرض لم نعرفه في احداهما","لكن رواه أحمد الشيباني",64,"ن",2,0],["وَالعُربُ عاكفةٌ على أوثانِها","والناسُ بين مُعطلٍ أو مُلحِدِ",65,"د",1,0],["والعَرَبِيَّةِ وكذا الإرشادِ","مُختَصَرَى إمامِنا الأستادِ",66,"د",1,0],["وَالعِرس لاهِيَةٌ بِبركتها الَّتي","يَجري إِلَيها الماء آذريون",67,"ن",1,0],["وَالعرف وَالقانون قَد نَصّا عَلى","مَنع السِلاح إِذا تَحوّل مَفسدَه",68,"د",2,0],["والعرش لم يك غير افئدة الورى","وودادها وولاؤها مرقاته",69,"ت",2,0],["والعرب والعجم يعرفوني","من قبل قولي أنا الفلاني",70,"ن",2,0],["وَالعَرضِ والطولِ وليسَ تَختَلِف","في مِثلِ ذا مَعرفتي وَتحتَرِف",71,"ف",1,0],["وَالعَرشُ وَالمُنتَهى وَالسدرَةُ اِزدَهَرَت","وَاللَوحُ وَالقَلَمُ المَعصومُ في الأَثَرِ",72,"ر",1,0],["والعُرْبُ تحفظُ ذمّةَ الجيران","فُنفِيتُ من عدنانَ إن جازيتُهم",73,"م",1,0],["والعراق الفذ كادت","نفسه تزهق فقدا",74,"د",2,0],["والعرض قوس قد يكون لبلدة","أو كوكب والميل قوس كالتي",75,"ي",1,0],["والعرش تحمله ملايكة لهم","زجل من التسبيح والتقديسة",76,"ه",1,0],["والعُرفُ منهُ كفى لِلمُخلِصِينَ لَهُ","والبأس مُحتَدِماً لِلخَائِنِ العَادِي",77,"د",2,0],["وَالعَرش أَشرَق مِن أَنوار غرته","إِذ مِنهُ قَد سَطَعت في الكَون أَنوار",78,"ر",1,0],["والعرق وثتقوها لي بها كان مشباك","دقق الفكر ان الله بالعقل أولاك",79,"ك",1,0],["والعرشُ لا يُعليكِ شأناً في الورى","ولو أَنّ سُدّتَهُ هناك الأَنجمُ",80,"م",1,0],["والعرف من نابه تحمد مغبته","ما ضاع عرف ولو أوليته حجرا",81,"ر",2,0],["والعرب قد صيرت السماكين","لصورة الليث المتصور ساقين",82,"ن",1,0],["والعروة الوثقى قد انفصمت وأع","لام التقى طمست وشاع فسادها",83,"د",3,0],["والعروة الوثقى لمستمسكٍ","والحجة الكبرى لباري الملا",84,"ل",2,0],["والعَرُوضُ أسبَابُهُ قد تقَوَّتَ","وَالقَوَافِي بالإكتِفاءِ تُزانُ",85,"ن",1,0],["والعرض المحمول كالألوان","وحركات الجوم والإسكان",86,"ن",1,0],["وَآلُ عُروَة في قَتلاكُم علماً","تَنفي الثَعالِبُ عَنهُم رَكضَةُ الساقِ",87,"ق",1,1],["والعرض العام بلا اعتبار","عندهم والتام منه عار",88,"ر",1,0],["والعرضُ مني وافرٌ","يققُ الظواهر والأديم",89,"م",1,0],["والعَرشُ والفرشُ والأفلاكُ خاشِعَةٌ","وخادمُ المصطفى من صفوَةِ الخدَمِ",90,"م",1,0],["والعِرض ريح الرجل الذكيه","طيباً وخبثاً وردت مرويه",91,"ه",1,0],["والعروة الوثقى اتحاد قلوبهم","عقدت على التقديس والتطهير",92,"ر",1,0],["والعرب من أصل فما هذا الندا","أفبالجحود تعامَلُ الأرحام؟",93,"م",1,0],["والعروة الوثقى نزار وولده","فيهم أدان اللّه بالإيمان",94,"ن",1,0],["والعُرْبُ كُلُّ العُرْبِ حيثُ لقيتَهمُ","في الخافقينِ جَهالةٌ جَهْلاءُ",95,"ا",2,0],["والعربُ قد تحذفُ الأخبار بعد إذا","إذا عَنتْ فجأة الأمْرِ الَّذي دهما",96,"م",2,0],["وَالعُربُ إن قصَّروا في الأَمرِ عن سفهٍ","وَلم يُغيثوا كَما يُرجى فَلِسطينا",97,"ن",2,0],["والعُرْبُ بَعْدَ رَكائِبِ العِزِّ امْتَطَوْا","لَهْوَ الحياةِ وغارِبَ التَّلْعاب",98,"ب",1,0],["والعَربُ الأحرارُ قد أهلكوا","بالعصبيَّاتِ على كلِّ حالْ",99,"ل",1,0],["والعروة الوثقى لمن يرتجي","من حلمك الفخر ضوافيها",100,"ي",3,0],["والعروة الوثقى من الدين وهت","والشرع حبله المتين انفصما",101,"م",2,0],["والعرض صنه اذا اعرضت عنه فلا","تقدح بساق له في مورد اشب",102,"ب",1,0],["والعرب أرواحها انبثت تقول له","تهنيك تلك السجايا الهاشميات",103,"ت",1,0],["والعُرْبُ حَوْلَهُمْ تَجَافَى جَنْبُهُم","عَنْ مَضْجَعٍ حَتَّى يَتِمَّ فَنَاءُ",104,"ا",2,0],["والعُرْفُ تجزيه أضعافاً مضاعفةً","بالعُرْفِ والشكرِ، فالإحسان يسبيها",105,"ي",3,0],["والعُرْبُ من حولِكم لاهونَ في عمهٍ","وأنتمُ في جحيم النفيِ والغِيَرِ",106,"ر",1,0],["وَالْعُرْبُ فِيْ نَوْمٍ وَغَيْبَةِ سَاْدِرٍ","وَعَدُوُّهُمْ مُتَحَفِّزٌ يَقْظَاْنُ",107,"ن",1,0],["والعُرْبُ هم شمسُ هذا الكونِ، مذ حُجِبَتْ","بالغيم سادَ الدجى والهرجُ والصخَبُ",108,"ب",1,0],["والعرْبُ كالعُرْب ِ ثارات ٌ مُ