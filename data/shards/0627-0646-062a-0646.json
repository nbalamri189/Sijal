diwan.net/poem61246.html","الكامل"],[458,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[461,"صارم ان خذل السيف حمى","https://www.aldiwan.net/poem15477.html","الرمل"],[461,"أنت نجم الدين في أهل التقى","https://www.aldiwan.net/poem16227.html","الرمل"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[515,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[551,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[551,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[558,"يا جميل الوجه الذي هو داني","https://www.aldiwan.net/poem33715.html","الخفيف"],[558,"قل لنفس جهلت بين الورى","https://www.aldiwan.net/poem34526.html","الرمل"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[575,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["إِن تَناسَوا تَذَكُّرَ الجودِ طَبعاً","أَو تَوَلَّوا ثَنى إِلى المَجدِ عَطفا",0,"ف",2,0],["أَنتَ نَزَّهتَنا عَنِ السَبِّ وَالقَذ","فِ فَلَو أَمكَنَ الجَزاءُ جَزَيتُك",1,"ك",1,0],["إِنْ تَنْصَرِفْ نَحْوَ عَيْنِ الْجَمْعِ مَا انْفَرَقَتْ","أَوْ تَتَّصِفْ بِوُجُودِ الْحَقِّ مَا انْعَدَمَتْ",2,"ت",1,0],["إِن تُنكِريها فَكَم طارَ الرُواةُ بِها","إِلى حِماكِ وَكَم قَد عَطَّرَت فاكِ",3,"ك",1,0],["إِن تَنصُروا المُستَضعَفي","نَ فَنَحنُ أَضعَفُهُم نِكايَه",4,"ا",3,0],["أَنتَ نِعمَ الإِمامُ في مَوطِنِ الرَأ","يِ وَنِعمَ الإِمامُ في المِحرابِ",5,"ب",1,0],["إِن تُنصَبِ القِدرُ لَدى بَيتِهِ","فَغَيرُها يَحتَضِرُ الجادِيَه",6,"ي",2,0],["إِنْ تَنَل عَنْ أَبِيكَ أَسْمَى مَحَلٍّ","هَلْ مِنَ البِدَع أَنْ تَنَالَ الثُّرَيَّا",7,"ي",2,0],["إِنْ تَنْنَدِبْهُ تَجِدْهُ مُنْتَدَباً","أَبَداً لِكُلِّ مَبَرَّةٍ عَمَمِ",8,"م",1,0],["أن تناءى أو ادّنى","فهو للحق ينتصر",9,"ر",1,0],["إن تنزعا وله فضيلة سبقه","فبمثل شاؤ أبيك لم يُتَعَلَّقِ",10,"ق",1,0],["أنت نعم المأمون للملك تحمي","سرجه كاتباً ونعم الرشيد",11,"د",1,0],["أنت نجمُ النجومِ والدهرُ ليلٌ","مَا لِنَجْمٍ سواك فيه ثُقوبُ",12,"ب",1,0],["أنت نعم المضيف والناس أضيا","فك فاعمم ببرك الأضيافا",13,"ف",2,0],["أنت نغل من ألف نُطفةِ فَحْلٍ","عدداً رُكّبَتْ مفاصِلُ جِسمك",14,"ك",1,0],["إن تناومْتَ فَمَنْ ذا أرتجي","أو تصاممت فلم تسمع فمن",15,"ن",1,0],["إِن تَنطَفِئ زُهُرُ النُجومِ فَفي","هَذي الوُجوهِ عَنِ النُجومِ غِنى",16,"ن",2,0],["إِن تَنسَ عَهدي إِنّي","وَاللَهِ لَم أَنسَ عَهدَك",17,"ك",1,0],["إِن تَنءَ سَلمى فَما سَلمى بِفاحِشَةٍ","وَلا إِذا اِستودِعَت سِرّاً بِمِزلاجِ",18,"ج",1,0],["أنت نجم السعد","في سما الإقبال",19,"ل",1,0],["إِن تَنفُخوا فيهِ مِن روحِ البَيانِ وَمِن","حَقيقَةِ العِلمِ يَنهَض بَعدَ إِعضالِ",20,"ل",1,0],["أَنتَ ناقِدٌ أَرِبٌ","وَالأَريبُ يَنتَقِدُ",21,"د",1,0],["إِنْ تَنْأَ عنهُ فَمَا نَأَيْتَ تَباعُداً","أَوْ لَمْ تَبِنْ بَدْراً فما أَخفيتا",22,"ت",2,0],["أَنتَ نَقيضُ اِسمِهِ إِذا اِختَلَفَت","قَواضِبُ الهِندِ وَالقَنا الذُبُلُ",23,"ل",1,0],["أَنتَ نَعيمي وَأَنتَ بُؤسي","وَقَد يَسوءُ الَّذي يَسُرُّ",24,"ر",1,0],["إِن تَنسَ أُذكِركَ مُتَّئِبٍ","وَإِن تَدَعني سَهواً فَلَن أَدَعَك",25,"ك",1,0],["إِن تَنَل قُدرَةً فَقَد نِلتُ صَوناً","وَالتَغاني بَينَ الرِجالِ تَكافِ",26,"ف",1,0],["إِن تُنصِفونا يا لَمَروانَ نَقتَرِب","إِلَيكُم وَإِلّا فَأذَنوا بِبِعادِ",27,"د",1,1],["إِن تَنَم خالِياً فَبَعدَكَ قَلبي","كُلَّ يَومٍ في مُقعِدٍ وَمُقيمِ",28,"م",1,0],["إِن تَنفَلِت وَأُنوفُ المَوتِ راغِمَةٌ","فَاِذَهب فَأَنتَ طَليقُ الرَكضِ يا لُبَدُ",29,"د",1,0],["أَنتَ ناضَلتَ دونَها بِعَطايا","رائِحاتٍ عَلى العُفاةِ غَوادي",30,"د",2,0],["إِن تُنيلي أَعِش بِخَيرٍ وَإِن لَم","تَبذُلي الوُدَّ مِتُّ بِالهَمِّ غَمّا",31,"م",2,0],["أَنتُنَّ زينَتُنَّ فُرقَتَنا","وَلِكُلِّ صاحِبِ زينَةٍ عَمَلُه",32,"ل",2,0],["إِن تَنظُروا اليَومَ الثَواءَ بِأَرضِنا","فَغَدٌ لَكُم رَهنٌ بِحُسنِ ثَواءِ",33,"ا",2,0],["إن تَنْبُ مكّةُ بالرسول فما نبا","عَزْمٌ تُهَدُّ به الصِّعابُ وتُسحَقُ",34,"ق",1,0],["إن تَنهضي اليومَ يَفزعْ كلُّ مُرْتَبئٍ","ويَنتفِضْ كلُّ ذي نابٍ وأُظفورِ",35,"ر",1,0],["إِن تُنكِروا حُكمَ الرِجالِ فَشاوِروا","فيها النِساءَ وَحَكِّموا الأَطفالا",36,"ل",2,0],["أنت نِعْمَ الصِّهرُ مجداً وَسناً","إن طلبنا المجدَ في أقطابِهِ",37,"ه",1,0],["أنت نجيتَه فهاجرَ يقضِي ال","حقَّ لا خائفاً ولا مذعورا",38,"ر",2,0],["إِن تَنهَزِم خَيلٌ لَها","فَحَذارِ مِن أُخرى تَكُرُّ",39,"ر",1,0],["إن تَنَاسَيْتُما وِدادَ أُناسٍ","فاجعَلاني مِن بعضِ مَن تَذكُرانِ",40,"ن",1,0],["إِن تُنَوِّلهُ فَقَد تَمنَعُهُ","وَتُريهِ النَجمَ يَجري بِالظُهُر",41,"ر",1,0],["أنتَ نُورِي في ظَلامِ الدُّجَى","وسِراجِي عنْدَ فَقْد السِّراجْ",42,"ج",1,0],["إن تنصر الباطل الممقوت زعنفة","فإن للحق أنصاراً وأعوانا",43,"ن",2,0],["إِنْ تَنَلْ عَابِدَ شمْسٍ نَارُهَا","لاَ يَدِنْ بَعْدَ تَوَلِّيَهَا بِنَارِ",44,"ر",1,0],["إِنْ تَنَاهَى امْتدَادُها لَمْ تُجاوزْ","دَعَواتِ الوَرَى لَها باقْتِدَادِ",45,"د",1,0],["إِنْ تَنْطَلِقْ راضَ العُباب صِعَابَهُ","فَجَرتْ عَلَى قَدْرٍ مِنَ التَّسهِيل",46,"ل",1,0],["أنتُنّ أقْربُ مُشْبِهٍ لِهِبَاته","فكِلاكُما مِنْ راحَتَيْه نِثَار",47,"ر",1,0],["إن تَنْقُدِ الفنانَ، تُرْهفْ حسَّهُ","وإذا أردتَ له الكَلاَل، فَحَسابِه",48,"ب",2,0],["إِن تنَلْهُم سرَّاءُ، هزَّت كيانِي","من بعيدٍ بخمرها السَّرَّاءُ",49,"ا",2,0],["إن تَنْتَفِضْ لا تجد كفٌّ لها سَعَةٌ","أو تَنقلْ لا تجِدْ أرضاً لها قَدَم",50,"م",1,0],["إن تنصُروها فان الشَعبَ منتصرٌ","أو تخذلِوها فان الشعبَ منتقم",50,"م",1,0],["أنتَ ناري وجَنَّتي","طابَ في حِضْنِكَ السَّمَرْ",51,"ر",1,0],["أنت ناوأتنا وعلمتها الثلب","فرشنا لكم سهام الهجاء",52,"ا",2,0],["إن تنكرِي شيبي فمنكِ حلولُه","أو تُنكرِي جسمي فهجرُك قاتلِي",53,"ل",2,0],["أنت نِعم الإمام بالفضل والإحس","ان والعُرف قد غَمرْتَ البلادا",54,"د",2,0],["أنتَ نِعْمَ الإمامُ فينا لأن","الدهرَ عنَّا مأْسورةٌ آفاتُه",55,"ت",2,0],["إن تَنأى مني فَإني غَيرُ مُكتَرِثٍ","بالعَذلِ فِيهَا ولَم أسأم تَدَلُّلَهَا",56,"ل",3,0],["أَنتَ نَبَّهتَ ذا الكَلامَ فَلا نا","مَت جُفوني إِن نامَ ليلُ القَوافي",57,"ف",2,0],["إن تنج من مكروههم","لم تنج من لمز المغيب",58,"ب",1,0],["إن تنصروا رب السما ينصركم","ويثبت الأقدام في الإِقدام",59,"م",1,0],["إِن تُنكِري شَيبي أُمَيمُ فَطالَما","كُنتُ الأَوَدَّ وَغَيرِيَ المُتَوَدِّدُ",60,"د",1,0],["أنتَ نعمَ العبدُ الكريم عليه","وَهوَ نعمَ المولى ونعم النصيرُ",61,"ر",1,0],["إن تناسيتَ أو نسيتَ فلا عُذ","ر فإنَّ المُهتمَّ ليس بناسِ",62,"س",1,0],["إِن تَنوء بِالحَملِ الثَقيلِ فَتَهوي","يَسقطِ الكَونُ بِالضَجيجِ الشَديدِ",63,"د",1,0],["إن تَنصُروهُ تَرَوا تحقيقَ ما طَمحَت","إليه أَنفُسُ هاتيكَ المَلايين",64,"ن",1,0],["أنتَ نعمَ النَذيرُ يا نجمَ هالي","زَلزِلَ السَهلَ والرَواسِيَ ذُعرا",65,"ر",2,0],["أنت نورُ الأنام عَدْلاً وفَضْلاً","ويمينُ الهدى وعَيْنُ الزمانِ",66,"ن",1,0],["إِن تُنكِروا نَفَسَ الصَبا فَلِأَنَّها","مَرَّت بِزَفرَةِ قَلبي المَحزونِ",67,"ن",1,0],["أَنتَ نَبِيُّ السَماحِ أَرسَلَكَ ال","لَهُ غِياثاً وَالناسُ قَد لَؤُموا",68,"م",3,0],["إِن تَنقِمي سُقمي فَخَصرُكِ ناحِلٌ","أَو تُنكِري شَيبي فَثَغرُكِ أَشنَبُ",69,"ب",1,0],["إِن تَناءى مَزارُها فَسَيُدني","ها إِلَيكَ الإِدلاجُ وَالإِسراءُ",70,"ا",2,0],["إِِنْ تَنْمِ أَهْلَ الْعُلاَ إِلَى مَحَاسِنِهِ","تَجِدْ جَمِيعَهُمْ مِنْ بَحْرِهِ نَهَرَا",71,"ر",2,0],["أنتَ نِعمَ المُعينُ في الدهر لولا","أَنَّ للدّهرِ هِمَّةً لا تُجارى",72,"ر",2,0],["أنت نِعمَ الصديقُ في العيش لولا","أَنَّ للبؤس بَيننا أَو طَارا",72,"ر",2,0],["إن تناءت منّا الجسوم فللأر","واح جمعٌ في الغيب فيه الإفاده",73,"د",2,0],["إن تُنجِزيهِ كُنتِ أكرمَ حرّةٍ","جادت على حرٍّ بما لم يقبح",74,"ح",1,0],["أنتُنَّ فيها أنسُها وجمالُها","وبكنَّ تجذبُ أنفسَ النائينا",75,"ن",2,0],["ان تَناءَت دارنا عَن داركم","فاذكر وَالعهد وَزورونا مناما",76,"م",2,0],["أَنتِ نَغَّصتِ بِالقَطيعَةِ عَيشي","أَيُّ عَيشٍ لِعاشِقٍ مَهجورِ",77,"ر",1,0],["أنت نبع من الصفاء ودنيا","من أمان وفتنة لا تحد",78,"د",1,0],["أَن تنجحَ اليومَ كلَّ سؤلي","وإِن أَبى دَهريَ البَخيلُ",79,"ل",1,0],["إِن تُنكر الأَعداءُ رُتبتَه","شَهِدت بها الآياتُ في الذِكرِ",80,"ر",1,0],["إِن تَنبُ يا اِبنَ أَبي العاصي بِحاجَتِنا","فَما لِحاجَتِنا وِردٌ وَلا صَدَرُ",81,"ر",1,0],["إن تنسكَ الدنيا ولن تنسى فقد","أحيالكَ الأرزَ الوضئَ مشاعلا",82,"ل",2,0],["إِن تَنصروا اللَه يَنصركم وَمن قرنت","بِالنَصر دَولته العليا فَقَد نَجَحا",83,"ح",2,0],["إِن تُنكِر النارَ الَّتي في مُهجَتي","فَلَتَعرِفَنَّ الماءَ في أَجفاني",84,"ي",1,0],["إن تُنقذينا من البَلبال حاميةً","فتحتَ ظلِّ حماكِ لا نرى داء",85,"ا",2,0],["إن تنكروا ما قلته فاستطلعوا","أخبارَكم في سالف الأيام",86,"م",1,0],["إن تنزلي أو تطلعي","أنا لا أميل إلى الرجوع",87,"ع",1,0],["إن تَنُط درَّةَ المديح بمثلي","تُلفِ قاعاً به الصَداء جواب",88,"ب",1,0],["أَنتَ نَذلٌ مِن كِرامٍ","أَنتَ في الطاووسِ رجلُه",89,"ل",2,0],["إن تنكروا هذا فإن أدلتي","سقم يدِبُّ وعبرة لا تقلع",90,"ع",1,0],["إن تَنْهَبوا اللّذّات قبل فواتها","وهَبَ الزمان شقيَّه لسعيده",91,"د",2,0],["إنْ تنشدا قلبي وعهدكما به","صاع العزيز فإنَّه برحاله",92,"ل",2,0],["إنْ تنكر الأَرفاض فضل إمامِنا","عَرَفوا الحقيقة والصواب فأنكروا",93,"ر",3,0],["أنت نجمٌ لهُ السعادة نورٌ","ومجيدٌ رأى المحامد مالا",94,"ل",2,0],["ان تنعموا ردوا الرقاد لعل ان","يحظى بطيف ناظر وسنان",95,"ن",1,0],["إن تناءت فدخان","أو تدانتْ فشرارُ",96,"ر",1,0],["إن تنظر العين الا أنت لانظرت","وان دعا السمع الا منك لا سمعا",97,"ع",2,0],["إن تنأ يا خلي فلست براحل","ما دمت تحيا في نهاي وذاتي",98,"ي",1,0],["إن تُنكري قومي فعن","دكِ من بقيتهم بيانُ",99,"ن",1,0],["أنت نصيبي من الزمان ومف","تاحُ مُناي الرِّغابِ والختمُ",100,"م",1,0],["إن تُنزَع الدولةُ ما أُلبِستْ","منك وأنتَ الملبسُ الفاخرُ",101,"ر",1,0],["اِنْ تناءي مطلبٌ منْ دونهِ","نكَّبَ العيسَ وأزْجى الهِمَما",102,"م",2,0],["أنت نجمُ الدِّينِ في أهلِ التُّقى","مُشْرِقٌ عالٍ بهيجٌ في النَّظَرْ",103,"ر",1,1],["أنتَ نصرٌ يا نصرُ أن يدعك المل","ك لأمرٍ أمرٍ يوافك نصلا",104,"ل",2,0],["إن تنج منها أبا عمرو فعن قدر","نجاؤكم قدرة قد عاقها القدر",105,"ر",1,0],["أَنتَ نكّبْتَ عنِّيَ الخُطَطَ الجُو","نَ ظماءً إلى ذِرارِيَ هِيما",106,"م",2,0],["أنتَ نجّيتَني ومن حولِيَ الأُسْ","دُ سِغاباً هَرتَ الشُّدوقِ سليما",106,"م",2,0],["إِنْ تناءَوْا فليس منهمْ تدانٍ","أو تدانَوْا فليس منهمْ وِصالُ",107,"ل",1,0],["أنت نور أيا وجود علينا","تتجلى في عيننا والعيان",108,"ن",1,0],["أن تنالي غير بعدٍ وعناً","وتحوزي منه إلا أثرا",109,"ر",2,0],["أنتَ نَدْبٌ لهُ التُقَى سُنَّةٌ وال","عدلُ فرضٌ واللهُ يَعلمُ نَفْلَهْ",110,"ل",2,0],["إِنِّ تنَّمتُ من كَفَّيه في نِعَمٍ","حتى سَئِمتُ ولا كفْراً لِنِعْمَتِه",111,"ت",2,0]]}