9",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5563,"موشح الحسن والدلال","https://www.poetsgate.com/ViewPoem.aspx?id=215993",""],[5616,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=204841",""],[5628,"حديث مع القمر","https://www.poetsgate.com/ViewPoem.aspx?id=178551",""],[5720,"نورُ اللهِ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=201378",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5725,"ياعراق","https://www.poetsgate.com/ViewPoem.aspx?id=179277",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5759,"عد إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=213623",""],[5776,"يوم الصمود اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=203770",""],[5781,"بطاقاتُ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=208771",""],[5829,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=181752",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5910,"كلَّ عامٍ وأنتَ بالخيرِ تَنْعَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=206300",""],[5943,"كِبْرُكَ الخدَّاعُ مانعْ","https://www.poetsgate.com/ViewPoem.aspx?id=11261",""],[5956,"إن عشتُ للربيع","https://www.poetsgate.com/ViewPoem.aspx?id=183183",""],[5977,"إلى فلذة الكبد","https://www.poetsgate.com/ViewPoem.aspx?id=213284",""],[6001,"أبو ظبي","https://www.poetsgate.com/ViewPoem.aspx?id=375",""],[6068,"لو تسألوني عن هوى كبدي -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175855",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6152,"مافات انقضى","https://www.poetsgate.com/ViewPoem.aspx?id=207354",""],[242,"حي على الأنس ان طيف الهموم سرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563699",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[5355,"عن الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87229&r=&rc=54",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[402,"لك في ارتجال جلائل الهمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54014&r=&rc=866",""]],"verses":[["إِن تَناسَوا تَذَكُّرَ الجودِ طَبعاً","أَو تَوَلَّوا ثَنى إِلى المَجدِ عَطفا",0,"ف",2,0],["أَنتَ نَزَّهتَنا عَنِ السَبِّ وَالقَذ","فِ فَلَو أَمكَنَ الجَزاءُ جَزَيتُك",1,"ك",1,0],["إِنْ تَنْصَرِفْ نَحْوَ عَيْنِ الْجَمْعِ مَا انْفَرَقَتْ","أَوْ تَتَّصِفْ بِوُجُودِ الْحَقِّ مَا انْعَدَمَتْ",2,"ت",1,0],["إِن تُنكِريها فَكَم طارَ الرُواةُ بِها","إِلى حِماكِ وَكَم قَد عَطَّرَت فاكِ",3,"ك",1,0],["إِن تَنصُروا المُستَضعَفي","نَ فَنَحنُ أَضعَفُهُم نِكايَه",4,"ا",3,0],["أَنتَ نِعمَ الإِمامُ في مَوطِنِ الرَأ","يِ وَنِعمَ الإِمامُ في المِحرابِ",5,"ب",1,0],["إِن تُنصَبِ القِدرُ لَدى بَيتِهِ","فَغَيرُها يَحتَضِرُ الجادِيَه",6,"ي",2,0],["إِنْ تَنَل عَنْ أَبِيكَ أَسْمَى مَحَلٍّ","هَلْ مِنَ البِدَع أَنْ تَنَالَ الثُّرَيَّا",7,"ي",2,0],["إِنْ تَنْنَدِبْهُ تَجِدْهُ مُنْتَدَباً","أَبَداً لِكُلِّ مَبَرَّةٍ عَمَمِ",8,"م",1,0],["أن تناءى أو ادّنى","فهو للحق ينتصر",9,"ر",1,0],["إن تنزعا وله فضيلة سبقه","فبمثل شاؤ أبيك لم يُتَعَلَّقِ",10,"ق",1,0],["أنت نعم المأمون للملك تحمي","سرجه كاتباً ونعم الرشيد",11,"د",1,0],["أنت نجمُ النجومِ والدهرُ ليلٌ","مَا لِنَجْمٍ سواك فيه ثُقوبُ",12,"ب",1,0],["أنت نعم المضيف والناس أضيا","فك فاعمم ببرك الأضيافا",13,"ف",2,0],["أنت نغل من ألف نُطفةِ فَحْلٍ","عدداً رُكّبَتْ مفاصِلُ جِسمك",14,"ك",1,0],["إن تناومْتَ فَمَنْ ذا أرتجي","أو تصاممت فلم تسمع فمن",15,"ن",1,0],["إِن تَنطَفِئ زُهُرُ النُجومِ فَفي","هَذي الوُجوهِ عَنِ النُجومِ غِنى",16,"ن",2,0],["إِن تَنسَ عَهدي إِنّي","وَاللَهِ لَم أَنسَ عَهدَك",17,"ك",1,0],["إِن تَنءَ سَلمى فَما سَلمى بِفاحِشَةٍ","وَلا إِذا اِستودِعَت سِرّاً بِمِزلاجِ",18,"ج",1,0],["أنت نجم السعد","في سما الإقبال",19,"ل",1,0],["إِن تَنفُخوا فيهِ مِن روحِ البَيانِ وَمِن","حَقيقَةِ العِلمِ يَنهَض بَعدَ إِعضالِ",20,"ل",1,0],["أَنتَ ناقِدٌ أَرِبٌ","وَالأَريبُ يَنتَقِدُ",21,"د",1,0],["إِنْ تَنْأَ عنهُ فَمَا نَأَيْتَ تَباعُداً","أَوْ لَمْ تَبِنْ بَدْراً فما أَخفيتا",22,"ت",2,0],["أَنتَ نَقيضُ اِسمِهِ إِذا اِختَلَفَت","قَواضِبُ الهِندِ وَالقَنا الذُبُلُ",23,"ل",1,0],["أَنتَ نَعيمي وَأَنتَ بُؤسي","وَقَد يَسوءُ الَّذي يَسُرُّ",24,"ر",1,0],["إِن تَنسَ أُذكِركَ مُتَّئِبٍ","وَإِن تَدَعني سَهواً فَلَن أَدَعَك",25,"ك",1,0],["إِن تَنَل قُدرَةً فَقَد نِلتُ صَوناً","وَالتَغاني بَينَ الرِجالِ تَكافِ",26,"ف",1,0],["إِن تُنصِفونا يا لَمَروانَ نَقتَرِب","إِلَيكُم وَإِلّا فَأذَنوا بِبِعادِ",27,"د",1,1],["إِن تَنَم خالِياً فَبَعدَكَ قَلبي","كُلَّ يَومٍ في مُقعِدٍ وَمُقيمِ",28,"م",1,0],["إِن تَنفَلِت وَأُنوفُ المَوتِ راغِمَةٌ","فَاِذَهب فَأَنتَ طَليقُ الرَكضِ يا لُبَدُ",29,"د",1,0],["أَنتَ ناضَلتَ دونَها بِعَطايا","رائِحاتٍ عَلى العُفاةِ غَوادي",30,"د",2,0],["إِن تُنيلي أَعِش بِخَيرٍ وَإِن لَم","تَبذُلي الوُدَّ مِتُّ بِالهَمِّ غَمّا",31,"م",2,0],["أَنتُنَّ زينَتُنَّ فُرقَتَنا","وَلِكُلِّ صاحِبِ زينَةٍ عَمَلُه",32,"ل",2,0],["إِن تَنظُروا اليَومَ الثَواءَ بِأَرضِنا","فَغَدٌ لَكُم رَهنٌ بِحُسنِ ثَواءِ",33,"ا",2,0],["إن تَنْبُ مكّةُ بالرسول فما نبا","عَزْمٌ تُهَدُّ به الصِّعابُ وتُسحَقُ",34,"ق",1,0],["إن تَنهضي اليومَ يَفزعْ كلُّ مُرْتَبئٍ","ويَنتفِضْ كلُّ ذي نابٍ وأُظفورِ",35,"ر",1,0],["إِن تُنكِروا حُكمَ الرِجالِ فَشاوِروا","فيها النِساءَ وَحَكِّموا الأَطفالا",36,"ل",2,0],["أنت نِعْمَ الصِّهرُ مجداً وَسناً","إن طلبنا المجدَ في أقطابِهِ",37,"ه",1,0],["أنت نجيتَه فهاجرَ يقضِي ال","حقَّ لا خائفاً ولا مذعورا",38,"ر",2,0],["إِن تَنهَزِم خَيلٌ لَها","فَحَذارِ مِن أُخرى تَكُرُّ",39,"ر",1,0],["إن تَنَاسَيْتُما وِدادَ أُناسٍ","فاجعَلاني مِن بعضِ مَن تَذكُرانِ",40,"ن",1,0],["إِن تُنَوِّلهُ فَقَد تَمنَعُهُ","وَتُريهِ النَجمَ يَجري بِالظُهُر",41,"ر",1,0],["أنتَ نُورِي في ظَلامِ الدُّجَى","وسِراجِي عنْدَ فَقْد السِّراجْ",42,"ج",1,0],["إن تنصر الباطل الممقوت زعنفة","فإن للحق أنصاراً وأعوانا",43,"ن",2,0],["إِنْ تَنَلْ عَابِدَ شمْسٍ نَارُهَا","لاَ يَدِنْ بَعْدَ تَوَلِّيَهَا بِنَارِ",44,"ر",1,0],["إِنْ تَنَاهَى امْتدَادُها لَمْ تُجاوزْ","دَعَواتِ الوَرَى لَها باقْتِدَادِ",45,"د",1,0],["إِنْ تَنْطَلِقْ راضَ العُباب صِعَابَهُ","فَجَرتْ عَلَى قَدْرٍ مِنَ التَّسهِيل",46,"ل",1,0],["أنتُنّ أقْربُ مُشْبِهٍ لِهِبَاته","فكِلاكُما مِنْ راحَتَيْه نِثَار",47,"ر",1,0],["إن تَنْقُدِ الفنانَ، تُرْهفْ حسَّهُ","وإذا أردتَ له الكَلاَل، فَحَسابِه",48,"ب",2,0],["إِن تنَلْهُم سرَّاءُ، هزَّت كيانِي","من بعيدٍ بخمرها السَّرَّاءُ",49,"ا",2,0],["ان تنصروا الله ينصركم فلا تهنوا","فالكفر في المقت والاسلام رضوان",50,"ن",1,0],["إن تَنْتَفِضْ لا تجد كفٌّ لها سَعَةٌ","أو تَنقلْ لا تجِدْ أرضاً لها قَدَم",51,"م",1,0],["إن تنصُروها فان الشَعبَ منتصرٌ","أو تخذلِوها فان الشعبَ منتقم",51,"م",1,0],["أنتَ ناري وجَنَّتي","طابَ في حِضْنِكَ السَّمَرْ",52,"ر",1,0],["أنت ناوأتنا وعلمتها الثلب","فرشنا لكم سهام الهجاء",53,"ا",2,0],["إن تنكرِي شيبي فمنكِ حلولُه","أو تُنكرِي جسمي فهجرُك قاتلِي",54,"ل",2,0],["أنت نِعم الإمام بالفضل والإحس","ان والعُرف قد غَمرْتَ البلادا",55,"د",2,0],["أنتَ نِعْمَ الإمامُ فينا لأن","الدهرَ عنَّا مأْسورةٌ آفاتُه",56,"ت",2,0],["إن تَنأى مني فَإني غَيرُ مُكتَرِثٍ","بالعَذلِ فِيهَا ولَم أسأم تَدَلُّلَهَا",57,"ل",3,0],["أَنتَ نَبَّهتَ ذا الكَلامَ فَلا نا","مَت جُفوني إِن نامَ ليلُ القَوافي",58,"ف",2,0],["إن تنج من مكروههم","لم تنج من لمز المغيب",59,"ب",1,0],["إن تنصروا رب السما ينصركم","ويثبت الأقدام في الإِقدام",60,"م",1,0],["إِن تُنكِري شَيبي أُمَيمُ فَطالَما","كُنتُ الأَوَدَّ وَغَيرِيَ المُتَوَدِّدُ",61,"د",1,0],["أنتَ نعمَ العبدُ الكريم عليه","وَهوَ نعمَ المولى ونعم النصيرُ",62,"ر",1,0],["إن تناسيتَ أو نسيتَ فلا عُذ","ر فإنَّ المُهتمَّ ليس بناسِ",63,"س",1,0],["إِن تَنوء بِالحَملِ الثَقيلِ فَتَهوي","يَسقطِ الكَونُ بِالضَجيجِ الشَديدِ",64,"د",1,0],["إن تَنصُروهُ تَرَوا تحقيقَ ما طَمحَت","إليه أَنفُسُ هاتيكَ المَلايين",65,"ن",1,0],["أنتَ نعمَ النَذيرُ يا نجمَ هالي","زَلزِلَ السَهلَ والرَواسِيَ ذُعرا",66,"ر",2,0],["أنت نورُ الأنام عَدْلاً وفَضْلاً","ويمينُ الهدى وعَيْنُ الزمانِ",67,"ن",1,0],["إِن تُنكِروا نَفَسَ الصَبا فَلِأَنَّها","مَرَّت بِزَفرَةِ قَلبي المَحزونِ",68,"ن",1,0],["أَنتَ نَبِيُّ السَماحِ أَرسَلَكَ ال","لَهُ غِياثاً وَالناسُ قَد لَؤُموا",69,"م",3,0],["إِن تَنقِمي سُقمي فَخَصرُكِ ناحِلٌ","أَو تُنكِري شَيبي فَثَغرُكِ أَشنَبُ",70,"ب",1,0],["إِن تَناءى مَزارُها فَسَيُدني","ها إِلَيكَ الإِدلاجُ وَالإِسراءُ",71,"ا",2,0],["إِِنْ تَنْمِ أَهْلَ الْعُلاَ إِلَى مَحَاسِنِهِ","تَجِدْ جَمِيعَهُمْ مِنْ بَحْرِهِ نَهَرَا",72,"ر",2,0],["أنتَ نِعمَ المُعينُ في الدهر لولا","أَنَّ للدّهرِ هِمَّةً لا تُجارى",73,"ر",2,0],["أنت نِعمَ الصديقُ في العيش لولا","أَنَّ للبؤس بَيننا أَو طَارا",73,"ر",2,0],["إن تناءت منّا الجسوم فللأر","واح جمعٌ في الغيب فيه الإفاده",74,"د",2,0],["إن تُنجِزيهِ كُنتِ أكرمَ حرّةٍ","جادت على حرٍّ بما لم يقبح",75,"ح",1,0],["أنتُنَّ فيها أنسُها وجمالُها","وبكنَّ تجذبُ أنفسَ النائينا",76,"ن",2,0],["ان تَناءَت دارنا عَن داركم","فاذكر وَالعهد وَزورونا مناما",77,"م",2,0],["أَنتِ نَغَّصتِ بِالقَطيعَةِ عَيشي","أَيُّ عَيشٍ لِعاشِقٍ مَهجورِ",78,"ر",1,0],["أنت نبع من الصفاء ودنيا","من أمان وفتنة لا تحد",79,"د",1,0],["أَن تنجحَ اليومَ كلَّ سؤلي","وإِن أَبى دَهريَ البَخيلُ",80,"ل",1,0],["إِن تُنكر الأَعداءُ رُتبتَه","شَهِدت بها الآياتُ في الذِكرِ",81,"ر",1,0],["إِن تَنبُ يا اِبنَ أَبي العاصي بِحاجَتِنا","فَما لِحاجَتِنا وِردٌ وَلا صَدَرُ",82,"ر",1,0],["إن تنسكَ الدنيا ولن تنسى فقد","أحيالكَ الأرزَ الوضئَ مشاعلا",83,"ل",2,0],["إِن تَنصروا اللَه يَنصركم وَمن قرنت","بِالنَصر دَولته العليا فَقَد نَجَحا",84,"ح",2,0],["إِن تُنكِر النارَ الَّتي في مُهجَتي","فَلَتَعرِفَنَّ الماءَ في أَجفاني",85,"ن",2,0],["إن تُنقذينا من البَلبال حاميةً","فتحتَ ظلِّ حماكِ لا نرى داء",86,"ا",2,0],["إن تنكروا ما قلته فاستطلعوا","أخبارَكم في سالف الأيام",87,"م",1,0],["إن تنزلي أو تطلعي","أنا لا أميل إلى الرجوع",88,"ع",1,0],["إن تَنُط درَّةَ المديح بمثلي","تُلفِ قاعاً به الصَداء جواب",89,"ب",1,0],["أَنتَ نَذلٌ مِن كِرامٍ","أَنتَ في الطاووسِ رجلُه",90,"ل",2,0],["إن تنكروا هذا فإن أدلتي","سقم يدِبُّ وعبرة لا تقلع",91,"ع",1,0],["إن تَنْهَبوا اللّذّات قبل فواتها","وهَبَ الزمان شقيَّه لسعيده",92,"د",2,0],["إنْ تنشدا قلبي وعهدكما به","صاع العزيز فإنَّه برحاله",93,"ل",2,0],["إنْ تنكر الأَرفاض فضل