{"poems":[[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[75,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[53,"كتبت ربة الثنايا العذاب","https://www.aldiwan.net/poem8530.html","الخفيف"],[72,"أيها النفس الشريفه","https://www.aldiwan.net/poem42809.html","مجزوء الرمل"],[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[89,"أهلال بين هاله","https://www.aldiwan.net/poem8365.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[215,"أيها الظالم الجميل سلام","https://www.aldiwan.net/poem46603.html","الخفيف"],[228,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[230,"أسست هذا على أس التقى","https://www.aldiwan.net/poem55191.html","الرمل"],[376,"جمرات الهوى بمثلك تصلى","https://www.aldiwan.net/poem57227.html","الطويل"],[415,"أيها الظالم مهلا","https://www.aldiwan.net/poem31882.html","مجزوء الرمل"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122620","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62513","الرمل"],[1279,"","https://poetry.dctabudhabi.ae/diwan/poem/34819","الرمل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90635","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115946","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111796","الرمل"],[1791,"","https://poetry.dctabudhabi.ae/diwan/poem/113902","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114972","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28515","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88637","الخفيف"],[2387,"","https://poetry.dctabudhabi.ae/diwan/poem/143761","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123937","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108313","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92171","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85174","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85164","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35641","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40065","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119725","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90896","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54496","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73164","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136736",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136606",""],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121279","الخفيف"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101302","الخفيف"],[4858,"طلع الفجرُ أخيراً","https://www.poetsgate.com/ViewPoem.aspx?id=138072",""],[5064,"أيُّها الظّالم","https://www.poetsgate.com/ViewPoem.aspx?id=199101",""],[585,"ليتني كنت شارداً أجنبياً","https://www.poetsgate.com/ViewPoem.aspx?id=161850",""],[5092,"دنيا","https://www.poetsgate.com/ViewPoem.aspx?id=179344",""],[5135,"أيُّهَا الظَّبْيُ","https://www.poetsgate.com/ViewPoem.aspx?id=202223",""],[5213,"يا أخلاي والمناخ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=170405",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""]],"verses":[["أَيُّها الظاعِنُ لا جازَ الحَيا","أَبَداً بَعدَكَ بِالحَيِّ الحِلالِ",0,"ل",1,0],["أَيُّها الظافِرُ أَبشِر بِالظَفَر","وَاِجتَلِ التَأييدَ في أَبهى الصوَّر",1,"ر",1,1],["أيها الظالمُ الذي قدَّر اللَّ","هُ به في الأنام طولَ عذابي",2,"ب",2,0],["أَيُّها الظالِمُ ما تَر","فُقُ بِالنَفسِ الضَعيفَه",3,"ف",2,0],["أيها الظالم بالله إلى كم","أسفح الدمع على موطئها",4,"ه",2,0],["أَيُّهَا الظَّالِمُ هَبْ لِي","مَرَّةً مِنْكَ الْعَدَالَهْ",5,"ل",2,0],["أيها الظالم اغتصبت حقوقاً","قد حباها الأنام ربُّ الأنام",6,"م",1,0],["أَيُّها الظلم هل زمانك ماضٍ","أَيُّها العدل هل أَوانك آتي",7,"ت",2,0],["أيها الظالم الجميل سلامٌ","من أسيرٍ قيّدتهُ بجفاكا",8,"ك",2,1],["أَيُّها الظُلمُ وَالخَنا وَالغُرورُ","يا خَداعاً تَعفُّ عَنهُ الشُرورُ",9,"ر",1,1],["أَيُّها الظامِىءُ قِف نِلتَ المُنى","في حمى جَدَّةِ أُمِّ المُحسِنين",10,"ن",1,0],["أيُّها الظاعِنونَ مَهلاً وما قُل","تُ لِدَمعي لمَّا تَبادَرَ مَهلا",11,"ل",2,0],["أيّها الظَّالمُ مهلاً","أنتَ بالحاكمِ غِرُّ",12,"ر",1,1],["أيُّها الظاعنونَ هذي دموعي","بعدكمْ في الرسومِ تسقي المَحَلاّ",13,"ل",2,0],["أيَّها الظَّبيَةُ النَّوارُ كَمِ التَّي","هُ علَى عاشِقيكِ كِبراً وكِبرا",14,"ر",2,0],["أيُّها الظبيُ المُقَبَّى","آه من ذاك المقبَّل",15,"ل",1,0],["أَيُّها الظَبيُ الَّذي تَس","حَرُ عَيناهُ القُلوبا",16,"ب",2,0],["أيها الظَّبيُّ الغريرُ","هل لنا منكَ مجيرُ",17,"ر",1,1],["أيُّها الظّالمُ الذى نال من قلبى","مُناهُ وليس لى منه حظٌّ",18,"ظ",1,0],["أيها الظاعنون عنّيَ مهلاً","لا بُليتم بلوعتي وبكربي",19,"ب",2,0],["ايها الظبيُ الى ما البعدُ","عني وعلا ما",20,"م",2,0],["أيها الظاعنون عنا أقيموا","لتروا حالنا ودينا يسام",21,"م",1,0],["أيها الظالمُ المكذِّبُ هَيَّا","ها جحيمي خُلوٌ من السكانِ",22,"ن",1,0],["أيها الظالمونَ ذُوقُوا نكالاً","إن هذا جزاءُ قومٍ أساؤوا",23,"ا",1,0],["أيها الظالمون قد شاغلتكم","وغرتكم بطيشها الأهواء",23,"ا",2,0],["أيها الظبيُ المليحُ ال","قد مجدولٌ مهفهَف",24,"ف",1,1],["أَيُّها الظّاعِنونَ لا زالَ لِلغَي","ثِ رَواحٌ عَلَيكُمُ وَبُكورُ",25,"ر",1,0],["أَيُّها الظبي كنت غير بَعيد","تقضم الشيح من بطوح زرود",26,"د",1,1],["ايُّها الظَبي لا رأَيت هوانا","بعد ذا اليوم يانقي العود",26,"د",1,0],["أيها الظبي الذي أع","رض عني وجفاني",27,"ن",2,1],["أيها الظاعن الذي","أخذ القلب وانصرف",28,"ف",1,0],["أيها الظبي لا تحجب عن العي","ن مكانَ الفتون من أوصالك",29,"ك",1,0],["أيها الظبي الَّذي قد مرَّ بي","فوق طرف جلَّ عن درك البصرْ",30,"ر",1,1],["أَيُّها الظاعِنُ وَالقَلبُ عَلى","إِثرِهِ مُذ سارَ ما زالَ هَلوعا",31,"ع",2,0],["أيها الظبي ترفق","بالذي يهواك قلبه",32,"ه",1,1],["أيها الظبي التفت نحو الحشى","أيها الشمس أزل ليل الصدود",33,"د",1,0],["أَيُّها الظّالمُ المُسي","ءُ مَدى دَهرِهِ بِنا",34,"ن",2,1],["أيُّها الظّبيُ الذي مَرْ","تعُهُ أَرض القلوبِ",35,"ب",1,0],["أيها الظبي شاقتي منك قرب","يا فتى الحسن ما وصالك صعب",36,"ب",1,1],["أيها الظمآن رح مستمطرا","راحة ذات انهمار وانهمال",37,"ل",1,0],["أَيُّها الظاعنونَ عنِّي وقلبي","معهم لا يفارقُ الأضعانا",38,"ن",2,1],["أيُّها الظَّاعنُ مُذ تولَّى","خلَّفَ النَّارَ في الحَشا واستقلاً",39,"ل",2,1],["أيها الظاعن المخلف في القَلب","زفيراً يذوبُ منه الحديدُ",40,"د",1,0],["أيُّها الظاعنون بالله مهلاً","إنّ لي خَلفكم فُؤاداً عَليلا",41,"ل",2,0],["أيها الظاعنونَ من حيّ ليلى","عجَباً كيف تستطيعونَ صبرا",42,"ر",2,0],["أيها الظاعن المخلف في القلب","جحيماً سر في جوار المهيمن",43,"ن",1,0],["أيّها الظّلامُ يا ويلكمُ","ما رقبتم حقّ قربى وديانه",44,"ن",2,0],["أيُّها الظَّالِمُ أَبْدِلْ ضَحِكًا","بِبُكَاءٍ نَادِمٍ مِنْ مُقلَتَيْكْ",45,"ك",1,1],["أيها الظالمون أفسدتم الأر","ض فأنَّى ننال شأوا قصيا",46,"ي",2,0],["أيها الظمآنُ فيها شهوةً","ليست الأمواهُ فيها غائره",47,"ر",2,0],["أيُّهَا الظَّبْيُ تَمَهَّلْ لَحْظَةً","وتَرَفَّقْ قَدْ أَصَبْتَ الْمَقْتلا",48,"ل",2,0],["أيها الظاعنون عنا اقيموا","ريثما للوداع نلقى الحبيبا",49,"ب",2,0],["أيها الظالمون هل ذي صخورٌ","ما هززنا منكم وما نادينا..؟",50,"ن",2,0],["أيها الظالمون في الأرضً مهٍلا","إنّ في الأرضً والسّما جبَّارا",51,"ر",2,1]]}