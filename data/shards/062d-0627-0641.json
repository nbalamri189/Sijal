ewPoem.aspx?id=214681",""],[4899,"الوصايا","https://www.poetsgate.com/ViewPoem.aspx?id=177222",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5351,"فهوت قواها حين حرك إصبعه","https://www.poetsgate.com/ViewPoem.aspx?id=202706",""],[5431,"ليس حبا من كان رهن انتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=196612",""],[5484,"في رثاء شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=206306",""],[5648,"النت ياكثر صدماته","https://www.poetsgate.com/ViewPoem.aspx?id=155193",""],[5725,"وريث القلب","https://www.poetsgate.com/ViewPoem.aspx?id=210924",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5821,"قرب رحيله ولآ بقآله سوى شهور","https://www.poetsgate.com/ViewPoem.aspx?id=119858",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""],[6257,"سامرتُه حلما ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87182&r=&rc=7",""],[6353,"بطاقة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64726&r=&rc=147",""]],"verses":[["حافِراتٍ في الصَخرِ أَو ناقِشاتٍ","شائِداتٍ رَوائِعَ البُنيانِ",0,"ن",1,0],["حافظٌ للصديق إن زَلَّت النعْ","لُ به أو هوى عن العَلياءِ",1,"ا",2,0],["حافظْ عليهِ حفاظاً لا وراءَ له","إلا النجاحُ وأنقِذْه من العطبِ",2,"ب",1,0],["حافظ على مجلسها جاهداً","فإنه ناهيك من متعه",3,"ع",2,0],["حافِظُ المُلكِ أَن تُزالَ أَواخي","هِ وَراعيهِ أَن تُضاعَ أُمورُه",4,"ر",2,0],["حافِظاتٍ عَلى الأَخِلَّةِ ما طا","بَ وَأَبرَقنَ كَالسَرابِ الغَرورِ",5,"ر",1,0],["حافُ الرُّبى لزَحْفِه تَجيشُ","تَجيشُ في حافاتهِ الجيوشُ",6,"ش",1,0],["حافظَ الودِّ والذمامِ سلاماً","لم يَعُدْ بعدُ من يُوَدُّ ويُصحَبْ",7,"ب",1,0],["حافظٌ زيَّن القريضَ بفنٍّ","بُحْتُرِيّ عذبٍ رشيق المباني",8,"ن",2,0],["حافظًا عهدَ قومه بين قومٍ","لا يراعون حُرمةً للعهود",9,"د",1,0],["حافِظٌ حُرمةَ الأنوف فإن هيجَ","تَوَلَّتْ يداهُ رغمَ الأنوف",10,"ف",1,0],["حافظْ على عهدٍ لهنَّ حائل","عليه فاربَعْ لا على الجنادل",11,"ل",1,0],["حافِظٌ لِلكِتابِ يَعنيهِ مِنهُ","رافِداه التَنزيلُ وَالتَأويلُ",12,"ل",1,0],["حافِظي حافِظي عَلى طهرِ هذا ال","غُصنِ غُصنِ الطُفولَةِ المَيّادِ",13,"د",1,0],["حافظاً للعهدِ، شهمًا","مخلصاً، عدْلاً، فزرني.",14,"ن",2,0],["حافظٌ للعهدِ شَهْمٌ","مستقيمٌ في خُطاهُ",15,"ا",2,0],["حافِظ على الصَديق","في الوِسع والمضيقِ",16,"ق",1,0],["حافرح بأساك","واسمع نجواك",17,"ك",1,0],["حافَظت أَوطانهُم حَتّى غَدَت حَرَماً","أَمناً مِن الضدّ في حلِّ وَمُرتَحلِ",18,"ل",1,0],["حافظ عَلى العَهد يا خَليلي","بَينَ الأَخلّاءِ وَالأَحِبَّه",19,"ب",2,1],["حافظة فيكم عهودَ الندَى","حفظَ الرُّبَا عهدَ السواري الغوادْ",20,"د",1,0],["حافظُ الحزم والزمانُ مضيعٌ","يقظ العزم في منام الأنامِ",21,"م",1,0],["حافظت دهرا عيه","على مقاساة بعدك",22,"ك",1,0],["حافِظِ الشَّرْعِ في العقائِدِ واثْبُتْ","فأُلوا الغيِّ دينُهُمْ أَهواءُ",23,"ا",2,0],["حافظْتَ فيها على التّقوى ودُمتَ على","عهدِ المودّةِ والحُسنى بقُرباها",24,"ا",3,0],["حافِظِ المَغربَينِ والمَشرِقينِ","وهُدى الناسِ قامِعِ النُّظَّارِ",25,"ر",1,0],["حافظاً لما يزل عهود التصابي","في شهود الوجود والآدابا",26,"ب",2,0],["حافظاً مع كبيرهم وصغير","حرمات الوداد بالترحيب",27,"ب",1,0],["حافِظُ العَهدِ للصَّديقِ أمينٌ","صادقٌ يُتبِعُ المَقالَ فَعالا",28,"ل",2,0],["حافظ عَلى مُهجة ضاعَت فَأَنتَ بِها","تسال مِن مُنذ خَلق الرُوح في القدمِ",29,"م",1,1],["حافِظُ العصرِ في دِمشقَ فريداً","في جَميعِ الأمصارِ وَالأَعصارِ",30,"ر",1,0],["حافوا وما خافوا عقوبةَ ربّهم","واللَّه لا تَخفى عليه خافيَه",31,"ي",2,0],["حافت فنكَّستُها لما كلفتُ بها","فان دعوتُ اجابت باسم منتكس",32,"س",1,0],["حافظ للآل فيآن","مقامٌ ونزوح",33,"ح",1,0],["حاف منه الحيفَ قل لي قل","ت لا إنما معناه تعجيل الظفر",34,"ر",1,0],["حافظا ما كان قلده","ملك الأملاك عمران",35,"ن",1,0],["حافظُهُ الله وكاليه منْ","ألسنةٍ مسنونةٍ بالوقاحْ",36,"ح",1,0],["حافظ الحدود","وافيَ العهود",37,"د",1,0],["حافظ على التقوى وحل عن مشتهى","نفس وصد هواك بالأحفاظ",38,"ظ",1,0],["حافلا بالزهر والخض","رة والطير السجوع",39,"ع",1,0],["حافراً باللظى على مصحف الأف","ق سطوراً تنير في دفتيه",40,"ي",2,0],["حافظ في كل عصر","لنظام البشريه",41,"ي",2,0],["حافظا ودها بقلب أمين","باكيا هجرها وطول جفاها",42,"ا",3,0],["حافظاً دواةً أَبوكَ المرجَّى","كان عَضداً لها وَجَدُّكَ رُكْنَا",43,"ن",2,0],["حافِظْ على الذكرِ الميل فما","يَبقى على الأَيامِ كالذّكْرِ",44,"ر",1,0],["حافظٌ عورةَ العيونِ على طوْ","لِ التّغاضي وشدّةِ الإطراقِ",45,"ق",1,0],["حافظ ضقت بهذه الحياة","ولم أدر مثلك أين المفر",46,"ر",1,0],["حافظ شعرك وحي النهى","ومرعى الخيال ونبع الفكر",46,"ر",1,0],["حافظ على الصديق لو كان الحريق","حب التناهي غلطٌ أيا صديقْ",47,"ق",1,0],["حافِظ عَلى النسبِ النفيسِ الأرفعِ","بِمدجّجين مع الرماحِ الشرّعِ",48,"ع",1,1],["حافِظ عَلَيْهِ واتخذه عُدة","سيفاً إِذَا لقي الكرِيهة قاطعا",49,"ع",2,0],["حافِظاً في الزَمانِ ما خَلَّفوه","قائِماً في الصَدورِ بِالتَذكيرِ",50,"ر",1,0],["حافظ على نفسك من كل ما","يشينها من خللٍ أو زلل",51,"ل",1,1],["حافية روحي إليها مشت","ولم تكن يوم الهوى ناعلة",52,"ل",2,0],["حافِلاً بالخير مِمَّا","في يدِ المُبدي المُعيد",53,"د",1,0],["حافظ عليها يسر ولا معاسير","تنجيك بالاخرى تفكك من النار",54,"ر",1,0],["حافين حول العرش من فرح","حمداً وتقديساً وطيب ثناء",55,"ا",2,0],["حافٍ من الأقدار أقبل راشدًا","ما اسطاع ثالوث الغوى أن يردعه",56,"ع",2,0],["حافظا للنقاء مزنٌ سخيٌ","بين فوضى الرعود والضوضاء",57,"ا",2,0],["«حافظٌ» مات ثمّ يتلوه «شوْقي»","أيُّ خطبٍ أجلّ ممّا أتاك!",58,"ك",1,0],["حافظ لساني ولو جاته","هذاك ثعلب وذا قارض",59,"ض",1,0],["حافظ العهد بعهدي نكثا","فأنثنى في غيه ما مكثا",60,"ث",2,1],["حافلاتٍ مثقلاتٍ هاملات","منوراتٍ بالبروق الضاحكات",61,"ت",1,0],["حآفز أليآمنه خلص ضآقت صدور","وعآدن آلبنآت للموآجع سقيمه ,",62,"ه",1,0],["حافين و( زفلتنا ) ما همنا قاره","واللي معه ( كندره ) يا قوّ تكسيره",63,"ر",2,0],["حافيَ القلب والقميصُ حنينٌ","كلما شاخت المسافةُ أخصبْ",64,"ب",1,0],["حافٍ.. وتحضُنُني الرّمضَاء مُنتَعِلاً","جُرحِي، فكيف ينامُ الجرحُ في سَكَنِ؟",65,"ن",1,0],["حافظ أورادك قانون","وبكل مشاعرو وبيك مسكون",66,"ن",1,0]]}