برا",207,"ر",2,0],["وأجملُ ماروى العشاقُ شعرٌ","تبَادَلُهُ القلوبُ ،فخُذْ وهاتِ",208,"ت",1,0],["وأجمل ُ مارأت عيناي شوقٌ","على عينينِ زانَهما الحياءُ",209,"ا",2,1],["واجملُ مافيها بأنّ بيانَها","يزيدُ بهاءً في مديحٍ لنفسها",210,"س",3,0],["وأجملُ مارأتْ عينايِ خَودٌ","بهودجِها تُسبِّحُ ذا الجلالِ",211,"ل",1,1],["واجمع أزاهير الربا واعقد لها","تاجا يزينها فذاك جزاءُ",212,"ا",2,0],["واجمّع كل حزن الكون في لحظة .. واخاف ابكيك","وتدري بي وتبكي .. ثم اضيّعني ولا القاني !!",213,"ن",2,0],["واجْمَعْ شُرورَكَ إنْ باتَتْ عَلى وَجَعٍ","بِالخَيْرِ ، تَشْرَبُ مِنْ ساقٍ لَهُ ثَمِلُ",214,"ل",1,0],["وأجمع عطر الورود وامضي","بعيدا بعيدا بأرضِ التمني",215,"ن",2,0],["وَأَجْمَعُ بِالْقُدْسِ الشَّرِيْفِ كَتَاْئِبِيْ","فَأُوْثِقُ بَيْنَ الْمُسْلِمِيْنَ صِحَاْفِيَا",216,"ف",3,0],["08-وَاَجْمِلْ بِهِ ضَيْمًا أَذَلَّ تَنَائِيًا","بِرُوحِي أعَزَّ الوَمْقَ مُسْتَفْتَحَ العِلْمَا",217,"م",2,0],["واجمع عبير الحب من وجناتها","وانسج رداءً من ضياءِ رضاها",218,"ا",3,0],["وَأجمَعْ شَتَاتَ بُرُوْدَتِيْ","دَعْنِيْ بِنَارِكَ اِلْتَحِفْ",219,"ف",1,0],["واجمع بقلبك ما تبعثره الأنا","من عزة الإحساس بالتعزيزِ",220,"ز",1,0],["وَاجمَعوا الأَموالَ مِن أَوصابِهِ","قَبلَ أَن توقِظَهُ الأَحلامُ",221,"م",1,0],["وأجمع الدمعَ طُوفاناً أُزيل بهِ","حكمَ الشرورِ من الدنيا وأنفيهِ",222,"ي",2,0],["وأجمعتِ الكواكبُ أَنْ صَوابٌ","مقالُ النجمِ أَمضتْهُ ذُكاءُ",223,"ا",2,0],["وأجمل ما تراه العين غيثٌ","برحمة ربه يُحْيي الشعابا",224,"ب",2,0],["واجمعْ شظاياكَ من أوطانكِ النُثِرتْ","منذُ احتلالِ الأسى أشجارَ زيتونِ",225,"ن",1,0],["واجمع شتات فمي واغزل مواجعَهُ","قصيدةً في يدٍ أسرى بها وترُ",226,"ر",1,0],["وَ اجْمَعْ تَشَتُّتَنَا وَ قَوِّ صُفُوفَنَا","وَ اقْهَرْ عِدَانَا قَاهِرَ الْعُدْوَانِ",227,"ن",1,0],["وأَجْمَلُهُ بَيْتٌ عُرَاهُ مَوَدَّةٌ","لَهَا سَكُنٌ حانٍ عَلَيْهِ وناشِرُ",228,"ر",1,0],["وأَجْمَلُ آيَاتِهِ أَنَّهُ","هُوَ الحَقُّ والطُّهْرُ أنّى يكُونْ",229,"ن",1,0],["واجماً في الغيابِ أمضيْ وطرفيْ","بعثرتهُ حُمَّى حنينيْ أصيلا",230,"ل",2,0]]}