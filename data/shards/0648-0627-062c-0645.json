ني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5419,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=35569",""],[5431,"ياريحَ أميَ يافردوسَ إحساسي","https://www.poetsgate.com/ViewPoem.aspx?id=185619",""],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5431,"بردا يلازمني والراحم الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=197726",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"وعشقك السيل لاحدٌ ولا وسطُ","https://www.poetsgate.com/ViewPoem.aspx?id=199798",""],[5431,"قارورة عطر...","https://www.poetsgate.com/ViewPoem.aspx?id=202545",""],[5431,"على لسان الحرية...","https://www.poetsgate.com/ViewPoem.aspx?id=209177",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5497,"إمامها","https://www.poetsgate.com/ViewPoem.aspx?id=208903",""],[5497,"إمام القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=208908",""],[5514,"رباعية الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=31895",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5612,"رسالة إلى عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=197096",""],[5612,"عُدْ يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=198504",""],[5616,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=203333",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5804,"قلب من حجارة","https://www.poetsgate.com/ViewPoem.aspx?id=180672",""],[5809,"اشارة وعبارة","https://www.poetsgate.com/ViewPoem.aspx?id=205281",""],[5809,"وجد وحياء","https://www.poetsgate.com/ViewPoem.aspx?id=205400",""],[5809,"لغتنا","https://www.poetsgate.com/ViewPoem.aspx?id=205406",""],[5809,"خود","https://www.poetsgate.com/ViewPoem.aspx?id=205632",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""],[5848,"اذكرك وانساني","https://www.poetsgate.com/ViewPoem.aspx?id=48967",""],[5906,"الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=188217",""],[5957,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177510",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[6078,"سلوا الفؤادَ","https://www.poetsgate.com/ViewPoem.aspx?id=203256",""],[6120,"أَتُرِيدُنِي أَنْ أَعْتَرِفْ","https://www.poetsgate.com/ViewPoem.aspx?id=213513",""],[6128,"عزيزي","https://www.poetsgate.com/ViewPoem.aspx?id=212860",""],[5309,"هرجوا يا ايها الحكام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573919",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[6228,"فيض الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[6271,"هواجس في طقس الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80710&r=&rc=16",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["وَأَجمَمتُهُ لا عَن غَناءٍ وَإِنَّما","لَأَشرَبَهُ في حَرَّ خَطبٍ أَجُمَّهُ",0,"م",2,0],["وأجْمَمْتَ حدّ السّيفِ عنْ مُهَجاتِهِمْ","وقد طالَ منْهُمْ في سُؤالِكَ تَرْدادُ",1,"د",1,0],["وَأَجمِل إِذا ما كُنتَ لا بُدَّ مانِعاً","فَقَد يَمنَعُ الشيءَ الفَتى وَهوَ مُجمِلُ",2,"ل",1,0],["وَأَجمَعَت صُرمَنا سُعدى وَهِجرَتَنا","لَمّا رَأَت أَنَّ رَأسي اليَومَ قَد شابا",3,"ب",2,0],["وَاِجمَع شَتاتَ العُنصُرَينِ بِعَزمَةٍ","تَأتي عَلى هَذا الخِلافِ وَتَحسِمُ",4,"م",1,0],["وَأَجمِل عَنِ الثاوي العَزاءَ فَإِن ثَوى","فَإِنَّكَ لا الواني وَلا الضَرَعُ الغُمرُ",5,"ر",1,0],["وَأُجمِعُ هِجراناً لِأَسماءَ إِن دَنَت","بِها الدارُ لا مِن زُهدَةٍ في وِصالِها",6,"ل",3,0],["وَأَجمَالِ مَيٍّ إِذ يُقَرَّبنَ بَعَدَما","وَخِطن بِذِبّانِ المَصيفِ الأَزارِقِ",7,"ق",1,0],["وأجمل بوجه العيش لو لم يكن به","حنانيك من ظفُر الخطوب خموش",8,"ش",1,0],["وَأَجمَعنَ مِنكَ النَفرَ مِن غَيرِ ريبَةٍ","كَما ذَعَرَ الرامي بِفَيحانَ رَبرَبا",9,"ب",2,0],["واجمعي الأوفياء إن رسول الله","آت لصحبة الأوفياء",10,"ا",2,0],["وَأَجمَلَ مِن نورِ المَصابيحِ عِندَها","حَباحِبُ تَمضي في الدُجى وَتَؤوبُ",11,"ب",1,0],["وَأَجمَلَ مِنهُنَّ الفَراشاتُ في الضُحى","لَها كَالأَماني سِكنَةٌ وَوُثوبُ",11,"ب",1,0],["وَأَجمَلُ أَيّامِ الفَتى زَمَنُ الصِبى","وَخَيرُ الصِبا ما كانَ في الحُبِّ نامِيا",12,"ي",2,0],["واجمع ندامى الظرف تحت لوائه","وانشر بساحته بساط الرياح",13,"ح",1,0],["وَاِجمَع عَلى الأُمِّ الرَؤومِ وِلدَها","وَاِملَأ بِأَلبانِ النُبوغِ نَهدَها",14,"د",3,0],["وَاِجمَع نَدامى الظَرفِ تَحتَ لِوائِهِ","وَاِنشُر بِساحَتِهِ بِساطَ الراحِ",15,"ح",1,0],["وَأَجمِلوا الصَبرَ في جِدٍّ وَفي عَمَلٍ","فَالصَبرُ يَنفَعُ ما لا يَنفَعُ الجَزَعُ",16,"ع",1,0],["وَاِجمَعوا المالَ لِيَومٍ","فيهِ تَلقَونَ اِغتِصابا",17,"ب",2,0],["وَأَجمَعَ أَمراً كانَ ما بَعدَهُ لَهُ","وَكانَ إِذا ما اِخلَولَجَ الأَمرُ ماضِيا",18,"ي",2,0],["وأَجمِلي قَتْلَ نَفسٍ لا يُتارِكُها","بَرْحُ الغرامِ وإلّا رَمِّقي الرَّمَقا",19,"ق",2,0],["وَاجْمَعْ على دينِ الهُدَى أُممَاً","غَابَ الهُداةُ فَضَلَّتِ السُبُلا",20,"ل",2,0],["واجْمَعْ على دين الحقائقِ أُمّةً","عَصَفَتْ بها دُنيا من الأوهامِ",21,"م",1,0],["وَاِجمَع عَلى صِدقِ الإِخاءِ فِضاضَنا","فَلَقَد تَفَرَّقَ يُمنَةً وَشِمالا",22,"ل",2,0],["وَاِجمَع سِهامَكَ ثُمَّ صُكَّ عِتاقَها","صَكَّ المُقامِرِ أَقدُحَ الأَيسارِ",23,"ر",1,0],["وَأَجمَلُ مَوتِ المَرءِ إِذ كانَ مَيِّتاً","وَلابُدَّ يَوماً مَوتُهُ وَهوَ صابِرُ",24,"ر",1,0],["وَأَجمَعتُ أَن أَنعاهُ حينَ رَأَيتُهُ","يَفوقُ فُواقَ المَوتِ حَتّى تَنَفَّسا",25,"س",2,0],["وَاِجمَع حَوائِجَكَ الَّتي حَضَرَت","عِندَ الكِتابِ إِلَيَّ في سَطرِ",26,"ر",1,0],["وَأَجمَلُ مِن سَوقِ المِئينِ سُكوتُهُ","عَنِ الفَخرِ وَالأَفواهُ رَهنُ الرَواتِمِ",27,"م",1,0],["واجماً أطبقَ الأسى شفتيهِ","غيرَ صوتٍ عبرَ الحياة طليقِ",28,"ق",1,0],["واجمعي أمركِ لليَوْمِ الذي","يَحْمِل البشرى لعُشَّاق السلامِ",29,"م",1,0],["وأَجمَلُ في الرَّعيَّةِ منهُ رَأياً","كَفَاهُ عِلمَ أَخبارِ الخَبيرِ",30,"ر",1,0],["واجْمَعِي اليومَ كُلَّ ذاتِ جَناحٍ","إِنَّ يومَ الفاروقِ في الدهرِ غالي",31,"ل",2,0],["وأجمِعوا امرَكُم يَنْهَضْ بسعيِكُمُ","شَعبٌ إلى هِمَمِ الساعينَ مُفْتَقِر",32,"ر",1,0],["وأجمعي الأمرَ نُجمِعْ لا يُفرِّقنا","أأنتِ أمْ نحنُ فيما ينبغي تَبع",33,"ع",1,0],["وأجمل بوجه العيش لو لم يكن به","حنانيك من ظفر الخطوب مريش",34,"ش",1,0],["واجمَع عَلَى نُورٍ ونِيرَانٍ نِيَار","نِيَرَةٌ أنوَارٌ ِإذَا جَمَعتَ نَار",35,"ر",1,1],["واجمع إلهي قلوب المسلمين على","وداده أعله أعظم له شانا",36,"ن",2,0],["واجمع بشملٍ منه شملَ أحبةٍ","يمسي تعدُّ له الليالي وتحسبُ",37,"ب",1,0],["واجمل فليس السعى إلا تطلبا","لما لم يزل يأتيك من حيث لا تدري",38,"ر",2,0],["وَاِجمَع حَوالَيها لِيَمنَعَها","ما اِسطَعتَ مِن مُستَحكَمِ الجَعرِ",39,"ر",1,0],["واجْمع غُواتكَ لا تبدد هَدْأتي","لا تلقِني سَهرًا بأحْداقِ السَّهرْ",40,"ر",1,0],["وَأَجمَلَ بِالمَرءِ التَّجَمُّلَ إِنَّهُ","إِذا عافه طَوعاً تَكلَّفهُ جَبرا",41,"ر",2,0],["واجمَع به شَملَ الفخارَ فإِنما","بمحمَّدٍ كَمُلَ الفَخَارُ لهاشِمِ",42,"م",1,0],["واجمعي القَشَّ وحُوكي العِشّ في","بَيتِنا فالحَبَّ والحُبَّ حَوى",43,"و",2,0],["وأجمع لِلرَحيل وَلا تعول","عَلى دار اِغترار واغتراب",44,"ب",1,0],["وَأَجمَل شَيء فِي العُلا عَفو قادِر","عَلَى مُذنب لَم يَقتَرِف زِلة الجَحدِ",45,"د",1,0],["وَأَجْمَعُ بَأوٍ في إخاء مُجَمَّعٍ","كَفَانَا انتِخاءً أنَّ إِخْوَتنَا فِهْرُ",46,"ر",1,0],["وَأَجمَلت قَصدايا أَخا السَمع ما جَرى","هُناكَ وَلو فَصَلتهُ هاجَ بي العَنا",47,"ن",2,0],["وَأَجمل مِنكَ لَم تَ