{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[63,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[66,"أين في الحمى عرب","https://www.aldiwan.net/poem40097.html","المقتضب"],[66,"من لم تر الحلة الفيحاء مقلته","https://www.aldiwan.net/poem40661.html","البسيط"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[69,"قالوا بدا الشعر أما تشعر","https://www.aldiwan.net/poem28916.html","السريع"],[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42683","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[115,"فتكت عيون الغيد بالألباب","https://www.aldiwan.net/poem41657.html","الكامل"],[115,"أواه من ظبي النقا ودلاله","https://www.aldiwan.net/poem41660.html","الكامل"],[117,"الغلاء الوحش","https://www.aldiwan.net/poem24033.html","الرمل"],[129,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[132,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[135,"إن كنت بين أناس","https://www.aldiwan.net/poem49046.html","المجتث"],[137,"أرسلي بالسلام يا سلم إني","https://www.aldiwan.net/poem67992.html","الخفيف"],[143,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[150,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[186,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[195,"لمن المنازل أقفرت بغباء","https://www.aldiwan.net/poem54412.html","الكامل"],[204,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[210,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[210,"الدهر قد حسنت بكم أيامه","https://www.aldiwan.net/poem13552.html","الكامل"],[271,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[282,"أحبابنا مذ بانوا","https://www.aldiwan.net/poem32393.html","مجزوء الرجز"],[282,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[297,"يا عين هذا المصطفى أحمد","https://www.aldiwan.net/poem33294.html","السريع"],[328,"جنبي كأسك الحزينة عني","https://www.aldiwan.net/poem55073.html","الخفيف"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[366,"هذا الذي كنت به أوعد","https://www.aldiwan.net/poem17181.html","السريع"],[377,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[377,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[391,"ضاعت الأعمار في قيل وقال","https://www.aldiwan.net/poem54510.html","عموديه"],[405,"لا تجفون أخا إذا أبصرته","https://www.aldiwan.net/poem49438.html","الكامل"],[405,"أقلل زيارة من يحبك","https://www.aldiwan.net/poem49645.html","مجزوء الكامل"],[429,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[437,"أين الخليط وأية سلكوا","https://www.aldiwan.net/poem2600.html","الكامل"],[453,"يا أيها الموتى ويا من خلدوا","https://www.aldiwan.net/poem61635.html","الكامل"],[458,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[464,"ما سرت عن جلق أبغي البديل بها","https://www.aldiwan.net/poem3222.html","عموديه"],[464,"ما بأراك الحمى إلى سلمه","https://www.aldiwan.net/poem3415.html","عموديه"],[468,"باكر صبوحك يا قضيب البان","https://www.aldiwan.net/poem59621.html","الكامل"],[468,"الورد في ورد الضباب شموس","https://www.aldiwan.net/poem59943.html","الكامل"],[468,"قم فاجلها في خلعة الكاس","https://www.aldiwan.net/poem59945.html","السريع"],[468,"الروض في حليه وجوهره","https://www.aldiwan.net/poem60130.html","المنسرح"],[468,"ذا يوم برق ويوم رعد","https://www.aldiwan.net/poem60229.html","مخلع البسيط"],[477,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[493,"ورجاء سيف الدولة الشرف الذي","https://www.aldiwan.net/poem67287.html","عموديه"],[500,"قف أيها المفتون فينا واتئد","https://www.aldiwan.net/poem37643.html","الكامل"],[529,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[529,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[551,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[551,"صبرا ففي الصبر الجميل","https://www.aldiwan.net/poem47185.html","مجزوء الكامل"],[551,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"]],"verses":[["فَالغِمرُ مَن تَرَكَ الجَزاءَ عَلى الأَذى","وَأَقامَ يَنظُرُ عُذرَةً مِن مُجرِمِ",0,"م",1,0],["فالغَرْبُ مَثْوى أُصَيْحابي الذينَ هُمُ","عشيرتي ولَنا بالشّرْقِ إخْوانُ",1,"ن",1,0],["فالغِيُّ رُشْدٌ وهَواني لهُ","في الحُبّ عِزٌّ وفَسادي صَلاحْ",2,"ح",1,0],["فَالْغَدْرُ مَرْتَعُهُ وَخِيمٌ كُلَّمَا","لاَذَ امْرُءٌ بِحِمَاه خَابَ وَخَامَا",3,"م",2,0],["فَالغَرْبُ قَبْلَ اليَوْمِ فِيهِ نُجُومُهُ","وَالشَّرْقُ بِعْدَ اليَوْمِ نُجُومُ",4,"م",1,0],["فالغِشّ في لحمتها والسَدى","وكلُّ ما يدعو إلا الارتياب",5,"ب",1,0],["فالغيث من غيظٍ بها عابسٌ","والبحر في خبطٍ وازْدِباد",6,"د",1,0],["فَالغَليلُ الَّذي عَلِمتِ مُقيمٌ","وَالدُموعُ الَّتي عَهِدتِ غِزارُ",7,"ر",1,0],["فالغَزْوُ مُنْتَظِمٌ والفَيء مُقْتَسَمٌ","والدِّينُ مُبْتَسِمٌ والشِّرْكُ مُصْطَلَمُ",8,"م",1,0],["فالغيثُ يخجَلُ أن يلِمَّ بأرضِه","والليثُ يَفرَقُ أن يُطيفَ ببابِه",9,"ب",2,0],["فَالغَرامُ نارُ لَظىً","عَذلُهُم لَها حَطَبُ",10,"ب",1,0],["فَالغُدرُ طافِحَةٌ وَالريحُ نافِحَةٌ","وَالوُرقُ صادِحَةٌ وَالطَلُّ مَوضونُ",11,"ن",1,0],["فَالغَيثُ يُستَسقى مَعَ اِعتِبابِهِ","وَإِنَّما يُسأَمُ في اِنسِكابِهِ",12,"ب",2,0],["فَالغَيثُ مِن زُهرٍ سَحابَةُ رَأفَةٍ","وَالرُكنُ مِن شَيبانَ طَودُ حَديدِ",13,"د",1,0],["فالغصنُ عنْ والدِهِ الماءِ قدْ","مالَ بقولِ الريحِ إذْ تعبرُ",14,"ر",1,0],["فَالغُمرُ نافى الغَمرَ عِندَ قِياسِهِ","وَالسيدُ غَيرُ مُشابِهٍ لِلسَيِّدِ",15,"د",1,0],["فَالغِمدُ يُذعَرُ في اللِقاءِ كَهامُهُ","وَالسَيفُ لَم يُبدِ الخَبيثَةَ سَلُّهُ",16,"ل",2,0],["فَالْغَيْثُ يَهْمِي رِقَّةً لِصَبَابَتِي","وَالطَّيْرُ تَبْكِي رَحْمَةً لِتَوَجُّعِي",17,"ي",1,0],["فَالغُواةُ مَورِدُها الن","نارُ دونَ مَصدَرِها",18,"ر",3,0],["فالغدر طبع ثابت في ذاتها","ولها التعاظم عن سماع عتاب",19,"ب",1,0],["فالغصن يخجل من تلوى صخره","والأسد ترغب من ورود نباله",20,"ل",2,0],["فالغَلاءُ الوَحْشُ لَيْثٌ جائِعٌ","يَنْشُرُ الفَقْرَ بأرضِ اليَمَنِ",21,"ن",1,0],["فالغِنى والفَقرُ إِن","كنتَ غَنياً في الشُعور",22,"ر",1,0],["فالغيتُ الحَيَا الدَّلوي يَعنُو","لُهُ وغَوارِبَ أليَمِّ الطَّمُومِ",23,"م",1,0],["فالغِ الإفادةَ واعدل","عنها إلى الاستفادهْ",24,"ه",1,0],["فَالغِنى إِن مَلَكتُ أَمرَكِ وَالفَق","رُ بِأَنّي أَزورُ مَن لا يَزورُ",25,"ر",1,0],["فَالغَيمُ إِلّا مِن سَمائِكَ زِبرِجٌ","وَالبَرقُ إِلّا مِن سَحابِكَ خُلَّبُ",26,"ب",1,0],["فالغدر من شيم النفوس فلا تثق","إلاّ بنفسك فالأمين يُخَان",27,"ن",1,0],["فالغيم يحجب عين الشمس ثمّ يرى","قد زال عنها وعين الشمس لم تزل",28,"ل",1,0],["فَالغَمرُ غَمرُ بَني خُزَيمَةَ قَد تَرى","مَأهولَةً فَخَلَت مِنَ الأَحياءِ",29,"ا",2,0],["فالغيم يبكي إذا ما الروض ضاحَكَهُ","وناظِرُ النبت بالأنداء مكحولُ",30,"ل",1,0],["فالغيث تلقاه قطوبا عابسا","ابدا وهذا ضاحك يتبسم",31,"م",1,0],["فالغيث ليس له كنائله ولا","لليث في يوم الوغى اقدامه",32,"م",2,0],["فالغَريق الَّذين حلوا بنجد","ما يَزالون في الفؤاد حلولا",33,"ل",2,0],["فَالغارِمُ الصّاحي إِذَن","وَالغانِمُ النَّشوانُ",34,"ن",1,0],["فَالغَيثُ وَاللَيثُ اللَذانِ هُما هُما","أَقماهُما إِقدامُهُ وَبَنانُهُ",35,"ن",2,0],["فالغارَةَ الغارةَ يا سيّدي","فإنَّكَ المَلجأ وَالمَقصِدُ",36,"د",1,0],["فالغرام البرىء وحي من الل","ه وعشق الجمال أخلد فن",37,"ن",1,0],["فَالغُصنُ خَوفَ جُندِها المُستَحوِذِ","كَإِصبَعٍ تُشيرُ بِالتَعَوُّذِ",38,"ذ",1,0],["فَالغَدُ قَد أَعجَلَني حَثُّهُ","عَن أَن أَقولَ اليَومَ لا تَبعُدوا",39,"د",3,0],["فالغصن إن يثبت بجوهر أصله","نامٍ وإن يُفصَل فليس بنام",40,"م",1,0],["فالغدرُ شيمتُها ولو صدقت أبت","والصدق منها بالخلاف ملَبَّس",41,"س",1,0],["فالغني كل الغنى كل الغنى","في التقى يا صاح خذه رأس مال",42,"ل",1,0],["فالغُصنُ يذبُلُ ثمَّ يُصبِحُ ناضِراً","والماءُ يكدرُ ثمّ يرجِعُ صافيا",43,"ي",2,0],["فالغَيْثُ وهو غِياثُ","الأرضِ يُبرِمُهْمْ مرتّد",44,"د",1,0],["فالغيد والأيام كلٌ منهما","فيما يعاهد ناكثٌ ومخالفُ",45,"ف",1,0],["فالغصنُ يدنو ما اكْتَسى","ثمَراً وينأى ما تعرّى",46,"ر",2,0],["فالغيث من معروفه خجِل","والبحر في جدواه مرتبك",47,"ك",1,0],["فالغدرُ ما برحَ المسيطرَ ضارباً","بالعدلِ لا يُعنى بغيرِ طلابِهِ",48,"ب",2,0],["فالغورَ يا راكبها الغورَ إذنْ","إنْ صدق الرائدُ في هذا الخبرْ",49,"ر",1,0],["فالغيث لولا فراق البحر ما حمدت","له السحائب لما أن بكى أسفا",50,"ف",2,0],["فالغيث في وجنتي حيا يدهِ","والبرقُ في أضلعي سنا ضرمه",51,"م",2,0],["فَالغَيمُ يَخلِطُ بَرقَهُ بِضَبابِهِ","مِثلَ اِختِلاطِ النارِ بِالدُخانِ",52,"ن",1,0],["فَالغَيمُ فاخِتَةٌ نَلَذُّ بِصَوتِها","وَالجَوُّ وَكرٌ وَالثَرى طاووسُ",53,"س",1,0],["فَالغَيمُ قَد دَحرَجَ مِن قَطرِهِ","دُرّاً عَلى المينا مِنَ الآسِ",54,"س",1,0],["فَالغَيمُ قَد سَخِرَ النَسيمَ لَهُ","بِخَلطِ كافورِهِ بِعَنبَرِهِ",55,"ر",2,0],["فَالغَيثُ قَد رَوَّقَ الرَوابي","بِسَيلَقونٍ وَلا زَوَردِ",56,"د",1,0],["فالغيثُ والمنثورُ هذا أسًى","للبينِ يبكيكمْ وذا يَلطِمُ",57,"م",1,0],["فالغيث يغبطني على إنعامه","والدهر يحسدني على تاميله",58,"ل",2,0],["فالغوث منا والمواهب بحرها","أبداً لنا بطوى السعادة جاري",59,"ي",1,0],["فالغَريبُ الذي يَحِلُّ بِلاداً","وَهَواهُ في غَيْرِ تِلْكَ الْبِلادِ",60,"د",1,0],["فالغَمُّ كُلُّ الغَمِّ وقْتٌ غَدا","فِيهِ الفَتَى إن ما يُكَدِّرْه طابَ",61,"ب",1,0],["فالغَوْرُ كالنَّجدِ في نشر الرُّواةِ لها","والحيُّ مِن مُضَرٍ كالحيِّ من يَمَنِ",62,"ن",1,0],["فالغُرْمُ غُنْمٌ واصلٌ","وخشونةُ الأيّامِ لِينُ",63,"ن",1,0],["فالغيثُ فيه ناشجٌ مستعبرٌ","والبرقُ منه ضاحكٌ متبسّمُ",64,"م",1,0]]}