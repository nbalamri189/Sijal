1",""],[5278,"سُلَّم الغربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202551",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5956,"السماح والحب هُمَا وسيلتا لمِّ الشمل الأبديِّ","https://www.poetsgate.com/ViewPoem.aspx?id=204607",""],[4442,"تطوي الذميل على الرسيم","https://www.poetsgate.com/ViewPoem.aspx?id=171227",""],[199,"لمن المنازل أقفرت بغباء","https://www.poetsgate.com/ViewPoem.aspx?id=20779",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""],[6142,"فزعت إليك من الورى الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=155678",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[5355,"احتياج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86681&r=&rc=4",""],[6233,"موكب ... لحرية الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78453&r=&rc=16",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["فَالغِمرُ مَن تَرَكَ الجَزاءَ عَلى الأَذى","وَأَقامَ يَنظُرُ عُذرَةً مِن مُجرِمِ",0,"م",1,0],["فالغَرْبُ مَثْوى أُصَيْحابي الذينَ هُمُ","عشيرتي ولَنا بالشّرْقِ إخْوانُ",1,"ن",1,0],["فالغِيُّ رُشْدٌ وهَواني لهُ","في الحُبّ عِزٌّ وفَسادي صَلاحْ",2,"ح",1,0],["فَالْغَدْرُ مَرْتَعُهُ وَخِيمٌ كُلَّمَا","لاَذَ امْرُءٌ بِحِمَاه خَابَ وَخَامَا",3,"م",2,0],["فَالغَرْبُ قَبْلَ اليَوْمِ فِيهِ نُجُومُهُ","وَالشَّرْقُ بِعْدَ اليَوْمِ نُجُومُ",4,"م",1,0],["فالغِشّ في لحمتها والسَدى","وكلُّ ما يدعو إلا الارتياب",5,"ب",1,0],["فالغيث من غيظٍ بها عابسٌ","والبحر في خبطٍ وازْدِباد",6,"د",1,0],["فَالغَليلُ الَّذي عَلِمتِ مُقيمٌ","وَالدُموعُ الَّتي عَهِدتِ غِزارُ",7,"ر",1,0],["فالغَزْوُ مُنْتَظِمٌ والفَيء مُقْتَسَمٌ","والدِّينُ مُبْتَسِمٌ والشِّرْكُ مُصْطَلَمُ",8,"م",1,0],["فالغيثُ يخجَلُ أن يلِمَّ بأرضِه","والليثُ يَفرَقُ أن يُطيفَ ببابِه",9,"ب",2,0],["فَالغَرامُ نارُ لَظىً","عَذلُهُم لَها حَطَبُ",10,"ب",1,0],["فَالغُدرُ طافِحَةٌ وَالريحُ نافِحَةٌ","وَالوُرقُ صادِحَةٌ وَالطَلُّ مَوضونُ",11,"ن",1,0],["فَالغَيثُ يُستَسقى مَعَ اِعتِبابِهِ","وَإِنَّما يُسأَمُ في اِنسِكابِهِ",12,"ب",2,0],["فَالغَيثُ مِن زُهرٍ سَحابَةُ رَأفَةٍ","وَالرُكنُ مِن شَيبانَ طَودُ حَديدِ",13,"د",1,0],["فالغصنُ عنْ والدِهِ الماءِ قدْ","مالَ بقولِ الريحِ إذْ تعبرُ",14,"ر",1,0],["فَالغُمرُ نافى الغَمرَ عِندَ قِياسِهِ","وَالسيدُ غَيرُ مُشابِهٍ لِلسَيِّدِ",15,"د",1,0],["فَالغِمدُ يُذعَرُ في اللِقاءِ كَهامُهُ","وَالسَيفُ لَم يُبدِ الخَبيثَةَ سَلُّهُ",16,"ل",2,0],["فَالْغَيْثُ يَهْمِي رِقَّةً لِصَبَابَتِي","وَالطَّيْرُ تَبْكِي رَحْمَةً لِتَوَجُّعِي",17,"ع",2,0],["فَالغُواةُ مَورِدُها الن","نارُ دونَ مَصدَرِها",18,"ر",3,0],["فالغدر طبع ثابت في ذاتها","ولها التعاظم عن سماع عتاب",19,"ب",1,0],["فالغصن يخجل من تلوى صخره","والأسد ترغب من ورود نباله",20,"ل",2,0],["فالغَلاءُ الوَحْشُ لَيْثٌ جائِعٌ","يَنْشُرُ الفَقْرَ بأرضِ اليَمَنِ",21,"ن",1,0],["فالغِنى والفَقرُ إِن","كنتَ غَنياً في الشُعور",22,"ر",1,0],["فالغيتُ الحَيَا الدَّلوي يَعنُو","لُهُ وغَوارِبَ أليَمِّ الطَّمُومِ",23,"م",1,0],["فالغِ الإفادةَ واعدل","عنها إلى الاستفادهْ",24,"ه",1,0],["فَالغِنى إِن مَلَكتُ أَمرَكِ وَالفَق","رُ بِأَنّي أَزورُ مَن لا يَزورُ",25,"ر",1,0],["فَالغَيمُ إِلّا مِن سَمائِكَ زِبرِجٌ","وَالبَرقُ إِلّا مِن سَحابِكَ خُلَّبُ",26,"ب",1,0],["فالغدر من شيم النفوس فلا تثق","إلاّ بنفسك فالأمين يُخَان",27,"ن",1,0],["فالغيم يحجب عين الشمس ثمّ يرى","قد زال عنها وعين الشمس لم تزل",28,"ل",1,0],["فَالغَمرُ غَمرُ بَني خُزَيمَةَ قَد تَرى","مَأهولَةً فَخَلَت مِنَ الأَحياءِ",29,"ا",2,0],["فالغيم يبكي إذا ما الروض ضاحَكَهُ","وناظِرُ النبت بالأنداء مكحولُ",30,"ل",1,0],["فالغيث تلقاه قطوبا عابسا","ابدا وهذا ضاحك يتبسم",31,"م",1,0],["فالغيث ليس له كنائله ولا","لليث في يوم الوغى اقدامه",32,"م",2,0],["فالغَريق الَّذين حلوا بنجد","ما يَزالون في الفؤاد حلولا",33,"ل",2,0],["فَالغارِمُ الصّاحي إِذَن","وَالغانِمُ النَّشوانُ",34,"ن",1,0],["فَالغَيثُ وَاللَيثُ اللَذانِ هُما هُما","أَقماهُما إِقدامُهُ وَبَنانُهُ",35,"ن",2,0],["فالغارَةَ الغارةَ يا سيّدي","فإنَّكَ المَلجأ وَالمَقصِدُ",36,"د",1,0],["فالغرام البرىء وحي من الل","ه وعشق الجمال أخلد فن",37,"ن",1,0],["فَالغُصنُ خَوفَ جُندِها المُستَحوِذِ","كَإِصبَعٍ تُشيرُ بِالتَعَوُّذِ",38,"ذ",1,0],["فَالغَدُ قَد أَعجَلَني حَثُّهُ","عَن أَن أَقولَ اليَومَ لا تَبعُدوا",39,"د",3,0],["فالغصن إن يثبت بجوهر أصله","نامٍ وإن يُفصَل فليس بنام",40,"م",1,0],["فالغدرُ شيمتُها ولو صدقت أبت","والصدق منها بالخلاف ملَبَّس",41,"س",1,0],["فالغني كل الغنى كل الغنى","في التقى يا صاح خذه رأس مال",42,"ل",1,0],["فالغُصنُ يذبُلُ ثمَّ يُصبِحُ ناضِراً","والماءُ يكدرُ ثمّ يرجِعُ صافيا",43,"ي",2,0],["فالغَيْثُ وهو غِياثُ","الأرضِ يُبرِمُهْمْ مرتّد",44,"د",1,0],["فالغيد والأيام كلٌ منهما","فيما يعاهد ناكثٌ ومخالفُ",45,"ف",1,0],["فالغصنُ يدنو ما اكْتَسى","ثمَراً وينأى ما تعرّى",46,"ر",2,0],["فالغيث من معروفه خجِل","والبحر في جدواه مرتبك",47,"ك",1,0],["فالغدرُ ما برحَ المسيطرَ ضارباً","بالعدلِ لا يُعنى بغيرِ طلابِهِ",48,"ب",2,0],["فالغورَ يا راكبها الغورَ إذنْ","إنْ صدق الرائدُ في هذا الخبرْ",49,"ر",1,0],["فالغيث لولا فراق البحر ما حمدت","له السحائب لما أن بكى أسفا",50,"ف",2,0],["فالغيث في وجنتي حيا يدهِ","والبرقُ في أضلعي سنا ضرمه",51,"م",2,0],["فَالغَيمُ يَخلِطُ بَرقَهُ بِضَبابِهِ","مِثلَ اِختِلاطِ النارِ بِالدُخانِ",52,"ن",1,0],["فَالغَيمُ فاخِتَةٌ نَلَذُّ بِصَوتِها","وَالجَوُّ وَكرٌ وَالثَرى طاووسُ",53,"س",1,0],["فَالغَيمُ قَد دَحرَجَ مِن قَطرِهِ","دُرّاً عَلى المينا مِنَ الآسِ",54,"س",1,0],["فَالغَيمُ قَد سَخِرَ النَسيمَ لَهُ","بِخَلطِ كافورِهِ بِعَنبَرِهِ",55,"ر",2,0],["فَالغَيثُ قَد رَوَّقَ الرَوابي","بِسَيلَقونٍ وَلا زَوَردِ",56,"د",1,0],["فالغيثُ والمنثورُ هذا أسًى","للبينِ يبكيكمْ وذا يَلطِمُ",57,"م",1,0],["فالغيث يغبطني على إنعامه","والدهر يحسدني على تاميله",58,"ل",2,0],["فالغوث منا والمواهب بحرها","أبداً لنا بطوى السعادة جاري",59,"ر",2,0],["فالغَريبُ الذي يَحِلُّ بِلاداً","وَهَواهُ في غَيْرِ تِلْكَ الْبِلادِ",60,"د",1,0],["فالغَمُّ كُلُّ الغَمِّ وقْتٌ غَدا","فِيهِ الفَتَى إن ما يُكَدِّرْه طابَ",61,"ب",1,0],["فالغَوْرُ كالنَّجدِ في نشر الرُّواةِ لها","والحيُّ مِن مُضَرٍ كالحيِّ من يَمَنِ",62,"ن",1,0],["فالغُرْمُ غُنْمٌ واصلٌ","وخشونةُ الأيّامِ لِينُ",63,"ن",1,0],["فالغيثُ فيه ناشجٌ مستعبرٌ","والبرقُ منه ضاحكٌ متبسّمُ",64,"م",1,0],["فالغصن من فرط الثمار قد انحنى","يدني القطوف لمن جناها عن كثب",65,"ب",1,0],["فالغُرُّ والغُرُّ آلُ فاطِمَةٍ","والسّادَةُ القادَةُ البَهاليلُ",66,"ل",1,0],["فالغصن يسهلُ وهو لَدنٌ فتلهُ","ومتى قسا ان شئتَ تُعدِلهُ انكسر",67,"ر",1,0],["فَالغزْ لنا في سِواه حَيث قَد عُلِمَت","بِالحل أَلفاظُ هَذا اللُغز في القَلم",68,"م",1,0],["فالغَيثُ مِن جودِهِ في الجَدبِ مغتَرِفاً","كاللَيثِ مِن بأَسِهِ في الحَربِ معترفا",69,"ف",2,0],["فالغِيْدُ كالرَّوْضِ في خَلْقٍ وفي خُلُقٍ","إنْ مَرَّ جَانٍ أَتَى مِنْ بَعْدِهِ جانِ",70,"ن",1,0],["فالغُفْل عند الخوف مُغْفٍ مُغْفِلٌ","والجَلْدُ عند الأمن حازٍ حازمُ",71,"م",1,0],["فالغالبيُّ أبو الأملاك قاطبةً","ما زال للنور نور اللّه مُقتبساً",72,"س",2,0],["فَالغَيْمُ بَيْنَ تَقَشُّعٍ وَتَرَاكُمٍ","وَالشَّمْس بَيْنَ تَبَرج وَتَسَتُّرِ",73,"ر",1,0],["فالغير في جانب بر يسلم","وأنا في وادي الجفاء أسقم",74,"م",1,0],["فَأَلْغَى في المَكارِمِ كُلَّ عَذْلٍ","وأَعْمَلَ مَضْرِبَ السَّيفِ الصَّقيلِ",75,"ل",1,0],["فالغَواني صرمتُها والملاهِي","قد كَفاني منها اكتسابُ الذّنوبِ",76,"ب",1,0],["فالغنى يا بنيَّ في النفس والفقرُ","من المال وحده ليس فقرا",77,"ر",2,0],["فالغصنُ يُثمرُ خيرٌ","منه عقيماً مُقِلاَّ",78,"ل",2,0],["فالغُشَيواءُ فَالبُديعُ فجَنبا","تِنضِلينٍ فحَزتُها فالجِواء",79,"ا",2,0],["فَالغُنمُ يَتبَعُ جَيشاً ظَلَّ مُنتَظماً","وَالنُجح بِالسَعيِ مَوكولٌ بِتَرشيدِ",80,"د",1,0],["فالغيثُ يكسو الأرضَ ثوباً يانِعاً","والسَّيلُ يُهدى الخِصبَ للقيعانِ",81,"ن",1,0],["فالغُربةُ الشوهاءُ صارت حيّةً","باللَه ياذا الانفصامُ تبدّد",82,"د",1,0],["فالغيث إن أخلفتك دِيمته","فجود غازي الغياث يخلفها",83,"ف",3,0],["فالغصن يرقص والورقاء ساجعة","والنَّوْرُ يضحك والأنواء تنتحبُ",84,"ب",1,0],["فالغيث أعظم رحمة وأعمها","نفعاً ومنه السيل في إرهابه",85,"ب",2,0],["فالغيث ما ضن إلا","جادت شآبيب سحبه",86,"ب",2,0],["فالغيث في هذه الدنيا لنا بكم","والغوث نرجوه في الأخرى وننتظر",87,"ر",1,0],["فالغيب لا يدركه غائبٌ","إلا الذي في غيبه أحضرا",88,"ر",2,0],["فالغرس جلب كله وهو الذي","يسقى ويحفظ عند أهل زمان",89,"ن",1,0],["فالغرس في تلك الحضارة شارب","فضل المياه مصاوه البستان",89,"ن",1,0],["فالغصن من نَشوة يَثنِي مَعاطِفه","والطيرُ مِن طَربٍ تشدو مَزاهرُهُ",90,"ر",2,0],["فالغيث يبكي الضحى","كمثال أجنحة الفواخت",91,"ت",1,0],["فالغرامُ الدفينُ ينفحهُ اللف","ظُ وسحرُ البيان من مقلتيها",92,"ي",3,0],["فالغصون انثنين بالرقص دلا","والجبال اضطر بن فهي تميد",93,"د",1,0],["فالغيرة في الغرام أضحت فني","وانقل هذا لكل صب عني",94,"ي",1,0],["فالغصنُ يُفصدُ عرقُه","كي ما عليه يُركبُ",95,"ب",1,0],["فالغدر سيرة من طابت سريرته","ولا الجفا منه للأحباب يقترب",96,"ب",1,0],["فالغربُ يزهُو على شرقِ البلاد به","وقومُه يرهبونَ العربَ والعجما",97,"م",2,0],["فالغيث ليس يبالي أين ما انسكبت","منه الغمائم ترباً كان أو حجرا",98,"ر",2,0],["فألغى مَهاتَيْنِ في شأوِهِ","وألغى الظَّليمَ وألغى الحِمارا",99,"ر",2,0],["فَالغُصنُ يُقَوَّم صاحَ وَما","يُرجى تَقويمٌ لِلخَشَبِ",100,"ب",1,0],["فالغيرُ يَفخَرُ بالأُصولِ وانت تَفخَرُ","بالفَعالِ وبالأُصولِ تَصُولُ",101,"ل",1,0],["فالغمُّ قد يعرضُ منه الكرى","والهمُّ قد يحدثُ منه السَهَر",102,"ر",1,0],["فالغِ النصيحةِ يا فَتَى من حاسدٍ","وَلَوَ أنَّهُ مَحَضَ النصيحةَ واجتهَد",103,"د",1,0],["فالغناء اللذيذ ضاع صداه","وانطوي في تذّكر الصياد",104,"د",1,0],["فالغصن والطير هبَّا يلقيان معًا","بنيهما بين أكمام وأوكارِ",105,"ر",1,0],["فالغصنُ ما ماسَ ريعانُ الشباب بهِ","سُكْراً وغيرُ مدام الحسن لم يَذُقِ",106,"ق",1,0],["فالغر ليس بذاعنٍ ابداً","إلّا إذا بهوانه اتصلا",107,"ل",2,0],["فَالغمُّ يَقتل مَن سَقاهُ سمّهُ","وَالصَبر يَحيي من غُذي بلبانهِ",108,"ن",2,0],["فَالغمُّ سوسٌ للنفوس وآفةٌ","وَالصَبرُ سَلوى للقلوبِ وَبَلسَمُ",109,"م",1,0],["فَالغَربُ في كَربٍ لمرِ فراقِهِ","وَالشَرق في طربٍ لا وبة فردِه",110,"د",2,0],["فَالغَيثُ مِن إِنعَامِهِ قَد وَكَفَا","عَلَى البَرَايَا وَهوَ حَسبِى وَكَفى",111,"ف",2,0],["فالغصن طفل والهوى كالمهد","أنا أخو الهوى