9","الوافر"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143607","الوافر"],[4679,"لعمرك ما السعادة للشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=142729",""],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4699,"مساء الحب سيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=155951",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4935,"مفاخر مصر بالكذب","https://www.poetsgate.com/ViewPoem.aspx?id=129308",""],[5057,"صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=184442",""],[5213,"إذا ما جئت قبر أبي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=170401",""],[5277,"ابتهال النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=188114",""],[5397,"أترقد عين الصب والنجم يسهر","https://www.poetsgate.com/ViewPoem.aspx?id=157961",""],[5399,"إذا ما جنى الجاني عليه جناية","https://www.poetsgate.com/ViewPoem.aspx?id=181167",""],[5458,"حاسب نفسك","https://www.poetsgate.com/ViewPoem.aspx?id=72288",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""],[5612,"أُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=179818",""],[5703,"عيون القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207967",""],[5829,"حنانيك","https://www.poetsgate.com/ViewPoem.aspx?id=178194",""],[5873,"أحلى الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=215305",""],[6070,"اذا ما جاءَتِ الدُّنيا إليكا","https://www.poetsgate.com/ViewPoem.aspx?id=188423",""],[6093,"سفيرنا القدوة","https://www.poetsgate.com/ViewPoem.aspx?id=188406",""],[6299,"إذا أصبحتُ بينَ جبالِ قوٍّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19692&r=&rc=17",""]],"verses":[["إِذا ما جَوادي مَرَّ بي في دِيارِها","تَقاضى زَفيري دائِباً بِالتَحَمحُمِ",0,"م",1,0],["إِذا ما جَنوا مِن مالِهِم ثَمَرَ العُلى","جَنَيتُ المَعالي مِن غُضونِ اللَهاذِمِ",1,"م",1,0],["إِذا ما جَنوا ذَنباً عَليَّ اِحتَقَرتُهُ","فَأَعفو عَنِ الذَنبِ العَظيمِ وَأصفَحُ",2,"ح",1,0],["إِذا ما جَرَرتُ الرُمحَ لَم يُثنِني أَبٌ","يُليحُ وَلا أُمٌّ تَصيحُ وَرائي",3,"ا",2,0],["إِذا ما جَفَّ ظَهرُ الأَرضِ مَحلاً","فَهُم أَندى البَريَّةِ بَطنَ وادِ",4,"د",1,0],["إِذا ما جَنى ذَنباً ظَلَلتُ كَأَنَّني","بِهِ صاحِبُ الذَنبِ الَّذي هُوَ صاحِبُه",5,"ب",2,0],["إِذا ما جَنَت ذَنباً تَلَمَّستُ عُذرَها","فَإِن لَم أَجِد عُذراً غَفَرتُ لَها الذَنبا",6,"ب",2,0],["إِذا ما جَلَّ قَدرُكِ عَن هُبوطٍ","مُريهِ إِلى سَمائِكِ بِالصُعودِ",7,"د",1,0],["إِذا ما جَرى شَأوَينِ وَاِبتَلَّ عِطفُهُ","تَقولُ هَزيرُ الريحِ مَرَّت بِأَثأَبِ",8,"ب",1,0],["إِذا ما جَنَبناهُ تَأَوَّدَ مَتنُهُ","كَعِرقِ الرُخامى اِهتَزَّ في الهَطَلانِ",9,"ن",1,0],["إذا ما جَلَتْ أيدي الصَّبا متن صفحه","أرتنا دُروعاً أكسبتنا الأياديا",10,"ي",2,0],["إِذا ما جَعَلتُ السِيَّ بَيني وَبَينَها","وَحَرَّةَ لَيلى وَالعَقيقَ اليَمانِيا",11,"ي",2,0],["إِذا ما جُرِّدَت فَنَقا كَثيبٍ","وَفي القَرِّيِّ هَيكَلَةً ضِناكا",12,"ك",2,0],["إذا ما جهله أربى علينا","حملناه بألباب حصيفه",13,"ف",2,0],["إذا ما جلاها في الرياض ربيعها","يروق عيون الناظرين رفيفها",14,"ف",3,0],["إذا ما جلتْه الحربُ عارضَ رُمْحَهُ","على لاحقِ الآطالِ نهدِ المآكلِ",15,"ل",1,0],["إذا ما جلتْهُ الحربُ أعرضَ رمحُه","على لاحقِ الأقرابِ نهدِ المراكلِ",16,"ل",1,1],["إذا ما جَرى في حلبة عربيةٍ","تخلّف عن شأويه قُسٌّ وأكثَمُ",17,"م",1,0],["إِذا ما جَرى آلُ الضُحى وَتَغَوَّلَت","كَأَنَّ مُلاءً بَينَ أَعلامِها الغُبرِ",18,"ر",1,0],["إِذا ما جَلا لِلناظِرينَ رُموزَهُ","تَجَلّى لَهُم ماضي الزَمان وَحاضِرُه",19,"ر",2,0],["إِذا ما جَرى مِن جَفنِ غَيرِيَ أَدمُعٌ","جَرَت مِن جُفوني أَبحُرٌ وَسِيولُ",20,"ل",1,0],["إِذا ما جِئتِ ما أَنهاكِ عَنهُ","وَلَم أُنكِر عَلَيكِ فَطَلِّقيني",21,"ن",2,0],["إذا ما جمعتم أمركم وهممتمو","بتقديم شئٍ للوكيل ثمين",22,"ن",1,1],["إِذاما جاءَهُ طُلّابُ حَقٍّ","يَقولُ عِصابَةٌ خَرَجوا وَشَقّوا",23,"ق",3,0],["إِذا ما جزيتَ السوءَ بالسوءِ لم يكنْ","لفضلكَ بين الأكرمينَ مَقامُ",24,"م",1,0],["إِذا ما جَرَوا في حَلبَةِ الرَأيِ بَرَّزَت","تَجاريبُ مَعروفٍ لَهُ السَبقُ قارِحِ",25,"ح",1,0],["إِذا ما جَرى سَيلُ العَقيقِ بِجَمَّةٍ","سَقاني رُضابَ الغانِياتِ بَرودُها",26,"د",3,0],["إذا ما جَفَت خِلَعُ المادِحينَ","عليهنَّ رقَّتْ فكانت حَريرا",27,"ر",2,0],["إذا ماجَ الحديدُ ضُحىً عليه","حَسِبْتَ البرَّ بحراً ذا اطِّرادِ",28,"د",1,0],["إِذا ما جاءَ مَحبوبي بِذَنبٍ","يُسابِقُهُ الجَمالُ بِشافِعَينِ",29,"ن",1,0],["إِذا ما جرَى واهتَزَّ للعينِ مُزْبِداً","حَسِبتَ به فَرواً مِنَ النّسْرِ يُنفَضُ",30,"ض",1,0],["إذا ماج بحرٌ في شوانيهمُ بهم","أتى مَدَدٌ منّا فماجَ به البَرُّ",31,"ر",1,0],["إذا ما جَرَى في محفلٍ حُسْنُ ذكره","تَعَلّقَ تشريفاً بأذْيالِهِ الفخرُ",31,"ر",1,0],["إِذا ما جاعَتِ الفيشُ","غَدَت في ذاتِهِ تَرعى",32,"ع",2,0],["إِذا ما جَرى مَجرى دَمِ المَرءِ حُكمُهُ","وَبُثَّت عَلى طُرقِ النُفوسِ حَبائِلُه",33,"ل",2,0],["إِذا ماجَرى فَوقَ قُرطاسِهِ","يَراعٌ جَرى حِبرُهُ بِالحُبورِ",34,"ر",1,0],["إذا ما جِئتَ مكّة فإنأَ عنها","مناسكَ لا تُحِبُّ الغادرينا",35,"ن",2,0],["إِذا ما جِئتَهُم أَرضَوكَ مَدحاً","فَإِن فَارَقتَ عادوا لاعِنينا",36,"ن",2,0],["إذَا مَا جَبَانٌ حُمِّلَ الدّرعَ لَم يُفِد","سِوَى أنَّهُ مِن عَضّهَا مُتَثَاقِلُ",37,"ل",1,0],["إِذا ما جَرى بِالرِزقِ فَالمُزنُ جامِدٌ","وَمَهما جَرى في الطُرسِ فَالبَرقُ مُؤنِقُ",38,"ق",1,0],["إِذا ما جَرى حاكَت رِياضَ أَزاهِرٍ","جَوانِبُهُ وَاِنصاعَ في الأَرضِ جارِيا",39,"ي",2,0],["إذا ماجَ أطنابُ السُّرادقِ بالضُّحَى","وقامَتْ حَواليْهِ القَنا تتَزَعْزَع",40,"ع",1,0],["إِذا ما جاوَزَت جَدَداً","فَلاحَ لِعَينِهِ جَدَدُ",41,"د",1,0],["إِذا ما جَرَينا وَالَّذينَ تَقَدَّموا","مَضوا وَتَرامى في جَوانِحِنا البُهرُ",42,"ر",1,0],["إِذا ما جُدَّ كَلبٌ وَهُوَ أَعمى","تَصَيَّدَ رَبَّةَ الطَرفِ الكَحيلِ",43,"ل",1,1],["إِذا ما جاءَني رَجُلٌ حُذامٌ","فَإِنَّ القَولَ ما قالَت حَذامِ",44,"م",1,1],["إِذا ما جَلَسنا مَجلِساً نَستَلِذُّهُ","تَواشَوا بِنا حَتّى أَمَلَّ مَكانِيا",45,"ي",2,0],["إِذَا مَاجَ بِالْهِيفِ الْحِسَانِ تَأَرَّجَتْ","مَسَالِكُهُ واشْتَقَّ فِي الْجَوِّ نَدُّهُ",46,"د",2,0],["إذا ما جهِلتَ النفسَ وهي قريبةٌ","فأيُّ المعاني بعد نفسِكَ أقْرَب",47,"ب",1,0],["إذا ما جرَى في الأرض فالجدب مُخْصبٌ","وإنْ هو جافَى الأرضَ فالخِصْبُ مجدبُ",47,"ب",1,0],["إذا ما جدت ريح الزفير مدامعي","تسح فتروى من دموعي رماله",48,"ل",2,0],["إذا ما جنبناهُ نأود متنُهُ","كعِرْقِ الرُّخامى اهْتَزّ في الهَطَلانِ",49,"ن",1,0],["إذا ما جلست طويلاً أمامي","كليلكة من عبير ومرمر",50,"ر",1,0],["إذا ما جرى شأوين وابتل عطفه","تَقولُ هزِيزُ الرّيحِ مَرّتْ بأثْأبِ",51,"ب",1,0],["إِذَا مَا جُلتُمُ في النحو يوماً","تَبَلَّدَ بَينَ قَائِلَةٍ وقِيلا",52,"ل",2,0],["إِذا ما جِئتَ رَبَّكَ يَومَ حَشرٍ","فَقُل يا رَبِّ خَرِّقَني الوَليدُ",53,"د",1,0],["إِذا ما جَرى في غايَةٍ صَدَقَ اِسمُهُ","وَغادَرَ كُلّاً خَلفَهُ مُتَخَلِّفا",54,"ف",2,0],["إذا ما جعلت الزيّ برّك والتّقى","فإنّك يوم الحشر أكرمهم زيّا",55,"ي",2,0],["إِذا ما جن فيها الليل أمست","يمزق في نواحيها الجلودُ",56,"د",1,0],["إذا ما جفتني هذه الأرض لم أجد","لقلبي بأرض غيرها ما يلائمه",57,"م",2,0],["إذا ما جَلَسْنا مَجْلِساً نَسْتَلِذُّهُ","تَواشَوا بِنا حتى أَمَلَّ مكاني",58,"ن",2,0],["إذا ما جيوشُ القُرِّ جاءتْ فَرُمْ لها","كمينا بأضعاف اللِّباس المحدَّد",59,"د",1,1],["إِذا ما جادَ بِالأَموالِ ثَنّى","وَلَم تُدرِكهُ في الجُودِ النَدامَه",60,"ه",1,1],["اذا ما جرت قوق الطروس تمدها","يداه بها عنه تضيق الدفاتر",61,"ر",1,0],["إِذا ما جِئتَهُم تَبغي قِراهُم","وَجَدتَ الخَيرَ عِندَهُمُ عَسيرا",62,"ر",2,0],["اذا ما جالَتِ الأَبطالُ وَلّى","وَيقدمُ نَحوَ حامِلَة الوِشاحِ",63,"ح",1,0],["إذا ما جادَ بالنَّغماتِ جُودي","بقُبلاتٍ تذكّرهُ اليمينا",64,"ن",2,0],["إِذا ما جَلَوْنا عُرُوسَ الْمُدامِ","أَجالَ الْحَبابُ عَلَيْها وِشاحا",65,"ح",2,0],["إِذا ماجَعَلتُ السِرَّ بَيني وَبَينَهُ","فَلَيسَ عَلى قَتلي يَزيدُ بِقادِرِ",66,"ر",1,1],["إِذا ما جَرى الجادِيُّ فَوقَ مُتونِها","وَمِسكٌ ذَكِيٌّ جَفَّفَتها المَجامِرُ",67,"ر",1,0],["إِذا ما جَدَّ وَاِستَذكى عَلَيها","أَثَرنَ عَلَيهِ مِن رَهَجٍ عِصارا",68,"ر",2,1],["إِذا ما جئت مَجلس رَوض أُنس","وَرمت تَرى بِهِ شَيئاً محالا",69,"ل",2,1],["إذا ما جئْتَهُ لاقاكَ خِرْقٌ","من الفِتْيانِ طَلْقُ الوجهِ باسم",70,"م",1,0],["إذا ما جَوادُ الفِكْرِ زاد تأَمُّلاً","صفاتِك زادَتْه اتّساعَ مَجال",71,"ل",1,0],["إِذا ما جرى قلت شوذا نقا","تَنَحّضى من الوابِلِ ا