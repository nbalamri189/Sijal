[["وَإِذا سَكَتُّ فَإِنَّ أَنطَقَ مِن فَمي","عَنّي فَمُ المَعروفِ وَالإِحسانِ",0,"ن",1,0],["وَإِذا سَروا كَمَنوا كُمونَ أَراقِمٍ","وَإِذا لَقوا بَرَزوا بُروزَ أُسودُ",1,"د",1,0],["وإذا سَمِعْنا نَبْأةً منْ عاذِلٍ","جُعِلَتْ مَغيضَ دُموعِها الأرْدانُ",2,"ن",1,0],["وَإِذا سارَ سابَقَتهُ المَناي","نَحوَ أَعداهُ قَبلَ يَومِ القُدومِ",3,"م",1,0],["وَإِذا سَطا خافَ الأَنامَ جَميعُهُم","مِن بَأسِهِ وَاللَيثُ عِندَ عِيانِهِ",4,"ن",2,0],["وَإِذا سِحرٌ أَتَت زائِرَةً","كَشَفَت رُؤيَةُ سِحرٍ كُلَّ بَثّ",5,"ث",1,0],["وَإِذا سُئِلتُ عَنِ الَّتي شَغَفَت","قَلبي وَكَلتُهُمُ إِلى أُخرى",6,"ا",1,0],["وَإِذا سَمِعتَ بِأَنَّ مَحروماً أَتى","ماءً لِيَشرَبَهُ فَغاصَ فَحَقِّقِ",7,"ق",1,0],["وَإِذا سُئِلتَ عَنِ الكِنانَةِ قُل لَهُم","هِيَ أُمَّةٌ تَلهو وَشَعبٌ يَلعَبُ",8,"ب",1,0],["وَإِذا سابِحٌ قَدِ اِنقَضَّ في الما","ءِ اِنقِضاضَ العُقابِ فَوقَ الحَمامِ",9,"م",1,0],["وَإِذا سَقى اللَهُ البِلادَ فَلا سَقى","بَلَدَ الهُنودِ سِوى الصَواعِقِ وَالدِما",10,"م",2,0],["وَإِذا سَمِعتِ بِواحِدٍ جُمِعَت لَهُ","فِرَقُ المَحاسِنِ في الأَنامِ فَذاكِ",11,"ك",1,0],["وَإِذا سايَرتَهُ قَدَّمتَهُ","وَتَأَخَّرتَ مَعَ المُستَأنِيَه",12,"ي",2,0],["وَإِذا سَرَيتُ رَأَيتُ نارَكِ نَوَّرَت","وَجهاً أَغَرَّ يَزينُهُ الإِسفارُ",13,"ر",1,0],["وَإِذا سَأَلتَ قَضى القُضاةُ عَلَيكُمُ","وَإِذا اِفتَخَرتَ عَلا عَلَيكَ فَخاري",14,"ر",2,0],["وإذا سخا ملأ الدِّيارَ عوارفاً","وإذا غزا ملأَ القفار عساكرا",15,"ر",2,0],["وإذا سطا جعلَ الحديد قلائداً","وإذا عفى جعل الحديد جواهرا",15,"ر",2,0],["وإذا سألت الناسَ عنك ولم تكنْ","لتطيبَ حين يُثيرُك البحَّاثُ",16,"ث",1,0],["وإذا سمعتَ هجاءَهُ","فاجعلْ وقارك ثَم وقرا",17,"ر",2,0],["وإذا سُئلْتَ فلا نداك تكلُّفٌ","وإذا مُدِحْتَ فلا ثناك تمحُّلُ",18,"ل",1,0],["وإذا سُمِّيتْ دُوَيهيَّةً إح","دى الدواهي فالأمر غير مروم",19,"م",1,0],["وَإِذا سَما لِلمَجدِ فَرعا وائِلٍ","وَاِستَجمَعَ الوادي عَلَيكَ فَسالا",20,"ل",2,0],["وَإِذا سَرَّ نُفوساً أَنَّها","تُحسِنُ الأَخذَ فَسُرّي بِالعَطاء",21,"ا",2,0],["وَإِذا سَمِعتُ هُتافَ شادِيَةٍ","أَمسَكتُ عَنها السَمع وَالكَبِدا",22,"د",2,0],["وَإِذا سَمِعتُ حِكايَةً عَن عاشِقٍ","عَرَضاً حَسِبتُني الفَتى المَقصودا",23,"د",2,0],["وَإِذا سِراجي قَد وَهَت وَتَلَجلَجَت","أَنفاسُهُ فَكَأَنَّهُ المَصدورُ",24,"ر",1,0],["وَإِذا سَكَنتُ إِلى الهُمومِ فَمِثلَما","رَضِيَ القُيودُ الموثَقُ المَكبولُ",25,"ل",1,0],["وَإِذا سَأَلتَ سَأَلتَ غَيثاً مُسبَلا","وَإِذا لَقيتَ لَقيتَ لَيثاً مُشبِلا",26,"ل",2,0],["وَإِذا سَمِعنَ هَديرَ أَكلَفَ مُحنِقٍ","عَدَلَت سَوالِفُها إِذا ما جَلجَلا",27,"ل",2,0],["وإذا سَأَلْتُ لِمَ الوجودُ","وكُلُّهُ همٌّ مُذيبْ",28,"ب",1,0],["وَإِذا سُلَيمانَ اِستَقَلَّ مَحَلَّةً","كانَت بِساطاً لِلنَدى وَرَجاءَ",29,"ا",2,0],["وَإِذا سَبى الفَردُ المُسَلَّطُ مَجلِساً","أَلفَيتَ أَحرارَ الرِجالِ عَبيدا",30,"د",2,0],["وَإِذا سَكَتَّ فَإِنَّ أَبلَغَ خاطِبٍ","قَلَمٌ لَكَ اِتَّخَذَ الأَصابِعَ مِنبَرا",31,"ر",2,0],["وَإِذا سَأَلتَ بَنانَهُ عَن نَيلِهِ","لَم يَرضَ بِالدُنيا قَضاءَ ذِمامِ",32,"م",1,0],["وَإِذا سَحابَةُ صَدِّ حُبٍّ أَبرَقَت","تَرَكَت حَلاوَةَ كُلِّ حُبٍّ عَلقَما",33,"م",2,0],["وإِذا سُئِلتُ عن السُّلوِّ أجبتُهم","بلسانِ معترفٍ ونيَّةِ جاحدِ",34,"د",1,0],["وَإِذا سَأَلتَهُمُ نَدىً","فَجَوابُهُم عَن ذاكَ وَو",35,"و",1,0],["وإذا سقاني الدهر سم خطوبه","داويته بمدامة أو ساقي",36,"ق",2,0],["وَإِذا سَكَنتَ إِلى الهُدى وَأَطَعتَهُ","أُلبِستَ حُلَّةَ صالِحِ الأَعمالِ",37,"ل",1,0],["وَإِذا سَبَحتَ إِلى الهَوى أَذيالَهُ","أَلقاكَ في قيلٍ عَلَيكَ وَقالِ",37,"ل",1,0],["وَإِذا سَأَلتَ فَلَم تَجِد أَحَداً","فَسَلِ الزَمانَ فَعِندَهُ الخَبَرُ",38,"ر",1,0],["وَإِذا سَطوا بَكَتِ السُيوفُ وَإِن سَخوا","ضَحِكَ النَدى وَتَجَلَّتِ الغَمّاءُ",39,"ا",2,0],["وَإِذا سَمِعتَ بَأَنَّ قِدماً مُظهِراً","عَنها النَفارَ فَتِلكَ مِن آياتِها",40,"ت",3,0],["وَإِذا سَأَلتَ السَيفَ قالَ فِرِندُهُ","لا عِلمَ لي إِلّا الَّذي عَلَّمتَني",41,"ن",2,0],["وإذا سَقّيْتَ منها شفَقاً","طَلَعَتْ حُمْرَتُهُ في وجنَتَيك",42,"ك",1,0],["وَإِذا سَرَحتَ الطَرفَ حَولَ قِبابِهِ","لَم تَلقَ إِلّا نِعمَةً وَحَسودا",43,"د",2,0],["وَإِذا سُرِرتُ يَسوءُهُ ما سَرَّني","وَيَرى المَسَرَّةَ مَروَتي أَن تُقرَعا",44,"ع",2,0],["وإذا سألتَ عن الصِّعابِ وحكمِها","فالعلمُ للصَّعبِ الأبيِّ قيادُ",45,"د",1,0],["وَإِذا سَطا سَطَتِ المَنو","نُ بِهِ وَتَعفو إِن عَفا",46,"ف",2,0],["وَإِذا سارَ رَمى","بِيَدَيهِ القُمُطا",47,"ط",2,0],["وإذا سخَّرَ الإِلهُ أُناساً","لسعيدٍ فإِنهم سُعَداءُ",48,"ا",2,0],["وإذا سما باسْمِ العلومِ فلا تَسَلْ","عَن حَطِّ نَفْس بالحَضِيضِ الأَوْهَدِ",49,"د",1,0],["وَإِذا سُئِلتُ أَتَيتُها","ضَربَ الأَميرِ طُلا الأَعادي",50,"د",2,0],["وَإِذا سَكِرتَ فَخُذ بِأَيرِ مُساعِفٍ","وَاِسكُن فَإِنَّكَ ناطِقٌ لا تُرشَدُ",51,"د",1,0],["وَإِذا سَرى كَحَلَ الزَميلَ بِأَرقَةٍ","مِن قَرعِ بازِلِهُ وَمِن قَيقابِهِ",52,"ب",2,0],["وَإِذا سُيوفِ الهِندِ أَدرَكَها البِلى","فَمِنَ العَجائِبِ أَن تَدومَ غُمودُها",53,"د",3,0],["وَإِذا سَرَيتَ سَرَت أَموناً رَسلَةً","وَإِذا تُكَلِّفُها الهَواجِرَ تُصخِدُ",54,"د",1,0],["وإذا سألُتكَ أن أراكَ حقيقةً","فاسمَحْ ولا تجعلْ جوابي لن تَرى",55,"ر",2,0],["وإذا سنة المعيشة شذت","فيك فالحظ فوق كل اِعتراض",56,"ض",1,0],["وإذا سيم الشعب يوماً هواناً","فَهو يبدي عَلى المهين اِحتجاجا",57,"ج",2,0],["وَإِذا سارَ سابَقَتهُ المَنايا","نَحوَ أَعداهُ قَبلَ يَومِ القُدومِ",58,"م",1,0],["وَإِذَا سَمِعْتَ صِيَاحَهُمْ وَدَوِيَّهُمْ","لَمْ تَدْرِهِ فَرَحاً وَلاَ إِعْوَالاَ",59,"ل",2,0],["وَإذَا سَفَرْنَ فَأيْنَ ضَوْ","ءُ الشمْسِ مِنْ شَفَقِ الْخُدُودِ",60,"د",1,0],["وإذا سَما الملِكُ الهُمامُ لغايةٍ","فالصَّعبُ هَيْنٌ والعَسيرُ مُيَسَّر",61,"ر",1,0],["وَإذَا سَكِرْتَ فَخُذْ بِأَيْرِ مُسَاعِفٍ","وَاسْكُتْ فَإِنَّكَ نَاطِقٌ لاتُرْشَدُ",62,"د",1,0],["وإذا سألتَ الرفقَ كان جوابُهُم","ما للقلوبِ الموجَعاتِ ومالي",63,"ل",2,0],["وَإذا سَابَقَ الجِيَادَ إلى المَجْ","دِ، فَما البرْقُ خَلفَهُ بسَرِيعِ",64,"ع",1,0],["وإذا سَقّيْتَ منها شَفقاً","طلعتْ حُمرتهُ في وجنيتكْ",65,"ك",1,0],["وإذا سُمِّيتْ دُوَيْهِيَّة ً أح","ك ملهى ً وعرضة َ استهزاء",66,"ا",2,0],["وإذا سمعت حكاية من عاشق","عرضا حسبتني الفتى المقصودا",67,"د",2,0],["وَإذا سَمْعْتَ نَحِيبَ أُمِّيَ في الدُّجى","تَبْكي شَباباً ضاعَ في الرَّيْعانِ",68,"ن",1,0],["وإذا ساءَ منزلٌ أو نبا بي","وعزتي همومُه حلاّها",69,"ا",3,0],["وإذا سلمتَ اليوم منه","يأتي القضاءُ به غدَا",70,"د",2,0],["وَإِذا سَمَت آمالُ حاسِدِ نِعمَةٍ","بَسَطَ الرَجاءَ فَعَبدُكَ المَحسودُ",71,"د",1,0],["وَإِذا سَطَوا خَتلاً سَطَوتَ مُصَرِّحاً","وَإِذا نَخَوا قَولاً نَخَوتَ فِعالا",72,"ل",2,0],["وإذا سخطا تزايد خوفها","واستسلمت للموت من إشفاقها",73,"ق",3,0],["وَإِذا سَمِعتَ وَحَى الزَما","نِ فَلا تُقَصِّر في الوَحاءِ",74,"ا",2,0],["وإذا سألتَ فنَمْ فهِمَّتُه بها","كالبَيْنِ بين جُفونه وسِناته",75,"ت",2,0],["وَإِذا سَفِهتَ على السبكيّ تابعه","سُؤتَ الإمامَ وكلّ المقتدين بهِ",76,"ب",2,0],["وإذا سألت وجاد يوما","ما بوعد أو تكرّم",77,"م",1,0],["وإذا سمعتَ صرير أقلامٍ له","فزئير أُسدٍ في حمى الأشبالِ",78,"ل",1,0],["واذا سألت عن الذنو","ب غدا فلن تجد الجواب",79,"ب",1,0],["وَإِذا سَنا المِصباح قابَلَ نورهُ","سَلَبَ الذُبال تَشَعشعَ الوقدانِ",80,"ن",1,0],["وَإِذا سَرَت سَكرى شَمالٌ خِلتَها","مَرَّت بِأَخلاقٍ لَهُ وَشَمائِلِ",81,"ل",1,0],["وَإِذا سِنو الأَزَماتِ صَوَّحَ نَبتُها","فَلَديهِمُ يُلغى الخَصيبُ المُمِرِعُ",82,"ع",1,0],["وإذا سكرت فإنني","مُستَهلِكٌ مالي وعتقي",83,"ق",2,0],["وإذا سَحَّرَ المسحِّرُ ليلا","التقى الأمرُ فيه بالعصيان",84,"ن",1,0],["وإذا سلمت فعند بابك","عائد والمهرجان",85,"ن",1,0],["وإذا سطوت أسرت آساد الشرى","قسراً ويأسرني الغزال الأغيد",86,"د",1,0],["وإذا سمعتَ من المؤذِّنِ دعوةً","للخيرٍ شدَّ يداً ومدَّ صراطا",87,"ط",2,0],["وإذا سمعتُ حديثها لم اكترث","لتلاوةِ الإنجيلِ والمزمور",88,"ر",1,0],["وإذا سَرَى عندَ العشيّةِ مَركبٌ","فيهِ شبيبةُ أرضِنا حيِّينا",89,"ن",2,0],["وإذا سَحقتِ الزّنجَ والافرنجَ لا","تنسي الذين على العِدى نَصَروك",90,"ك",1,0],["وإذا سَمَحْتُمْ بالعِتابِ سَمِعْتُهُ","خَبَراً يَطِيحُ على لِسان النَّاسِ",91,"س",1,0],["وَإِذا سَرَت فَالثَناء أَمامي","وَوَرائي وَيسرَتي وَيَميني",92,"ن",2,0],["وإذا سَرَى لم تَهْدِه مَشبوبَةٌ","باللّيلِ إلاّ ما يُجِنُّ جِناني",93,"ن",2,0],["وإذا سألتَ عنِ المكارمِ والعُلا","فلأولٍ من قاسِمَيْهِ وثان",93,"ن",1,0],["وإذا سَمِعْتَ به سمعتَ بماجدٍ","يأتيك واصِفٌه بكُلِّ بَديع",94,"ع",1,0],["واذا سَدَّد الكُماةُ قَناهم","بين آذانِ خَيلِهم تَسْديدا",95,"د",2,0],["وَإِذا سُئِلتَ عَنِ الغَرامِ فَقُل","قَدَرٌ وَمَن ذا يَدفَعُ القَدَرا",96,"ر",2,0],["وَإِذا سُئِلتُ فَإِن أَجَبتُ سُؤالَهُ","عَمّا قَضى بِتَغَرُّبي وَتَشَتُّتي",97,"ي",1,0],["وَإِذا سَمِعتَ بَني أُسامَةَ فَاِستَمِع","مِنهُم لِما يوحى وَأَخبِتُ وَاِنصِتِ",97,"ت",1,0],["وَاِذا سُئِلتَ لِقصدِها وَمقرِّها","فَالحَيرُ أَو كوفان أَو بَغداد",98,"د",1,0],["وإذا سَعى مَعَهُ الحيا متَصَوِّباً","أَلفَيتَهُ من خلْفه يتكسَّرُ",99,"ر",1,0],["وإذا سخر الإِله أناساً","لسعيد ينال أعلى منال",100,"ل",1,0],["وإذا سلمتَ على امرئ فاشكر له","ما كفَّ عنكَ من الأذى فهو الندى",101,"د",2,0],["وإذا سموْتَ إلى المعالي فاخْتَرِطْ","عَزماً كما عَزَمَ الرِّجالُ البُزَّلُ",102,"ل",1,1],["وإذا سطا أضحت قلوب عداته","تلوى كمخراق بكفي لاعب",103,"ب",1,0],["وإذا سرى خلت البسيطة لجّة","أمواجها بيض وبيضٌ قواضب",103,"ب",1,0],["وإذا سَلِمتَ ونلتَ أيسرَ بُغيَةٍ","مِنها جعلْتَ لكَ البريَّة حُسَّدا",104,"د",2,0],["وإذا سَلِمتَ أبا سلامَةَ لي","فمُصابُ كلِّ رزِيَّةٍ ظَلَفُ",105,"ف",1,0],["وإذا سُئِلتَ عَلامَ تَه","جُرهُ فَقُلْ ما صَحَّ عهدُهْ",106,"د",2,0],["وإذا سرتَ بالمطيِّ فمهلاّ","وتَرَفَّقْ بها فيما هي إلاَّ",107,"ل",2,0],["وإذا سُخِّرتِ الريح له","كانَ من أمثاله في السير ساخر",108,"ر",1,0],["وإذا ساءت الظنون بحالٍ","حَسُنَتْ فيك لا بغيرك حاله",109,"ل",2,0],["وإذا سََرحتَ إلى الرِّياض فنَلْ إذَنْ","من رَوحها أرَجاً ومن رَيْحانها",110,"ن",3,0],["وإذا سألتُ مكارماً من ماجد","ما كانَ غير نوالك المسؤولا",111,"ل",2,0],["وإذا سألتُ سواكَ كنت كأنَّني","أبغي لذاتك في الأنام مثيلا",111,"ل",2,0],["وإذا ساءَ غيورٌ أحْسَنا","بحميّا رشفاتِ القبلِ",112,"ل",1,0],["وإذا سألتهمُ بمسألةٍ","بخلوا ولو بقلامة الظفر",113,"ر",1,0],["وإذا سابقَ الجيادَ الى المج","دِ فكالبرقِ حالةَ الإبراقِ",114,"ق",1,0],["وإِذا سَرَّكَ صُنْعٌ فَلْيَدُمْ","وإِذا وافاكَ عيدٌ فَلْيَعُدْ",115,"د",1,0],["وإِذا سُيُوفُهُمُ لَمَعْنَ لوقعَةٍ","جَلَلٍ فوجْهُ الفتحِ فِيهَا لامِعُ",116,"ع",1,0],["وإِذا سَقَاني من عُقارِ جُفُونِهِ","أَبْقى عليَّ فَشَجَّها بِرُضَابِ",117,"ب",1,0],["وإذا ساجلت فأيهما","عاينت تجد ثقة ارشد",118,"د",1,0],["وإذا سمعتَ حمِدتَ صفوي وحدَه","وذمَمتَ غِشَّ القائلين وذَامَها",119,"م",3,0],["وإذا سُحْبُك عني عَبستْ","فمتى آملُ من أَرضِي ابتساما",120,"م",2,0],["وإذا سقى الغيثُ البلادَ بمسبِلٍ","غدَقٍ وهتَّانِ الحيا هطَّالِ",121,"ل",1,0],["وإذا سرى نقصُ القبائل أقبلتْ","تَنمِي المكارمُ فيهُمُ وتزيدُ",122,"د",1,0],["واذا سنَّ ليَ الصَّمتَ النُّهى","قال غيري ومَقالي لم يُذَلْ",123,"ل",1,0],["وإذا سما لرفيع مجدٍ طرفهُ","نظرَ الحسودُ إليه من طرفٍ خفي",124,"ف",2,0],["وإذا سلكت طريقة سلكوا معي","إذ لم أكن لسوى الصلاح بسائر",125,"ر",1,0],["وإذا سَطا صِدقي علَى العقَّاد قد","تَسطُو على أضدَادها الأضدَاد",126,"د",1,0],["وإذا سخطتُ فليس لي","مِن كاعِبٍ إلّا رضاها",127,"ا",3,0],["وَإِذا سُمتُها كما اِشترط المج","دُ فنادِ الرّجالَ لا لا تسوموا",128,"م",3,0],["وإذا سألتَ فلم تُغالِ ولم تُخَبْ","وَإن اِشتططّتَ أخذتَ ما لم تسألِ",129,"ل",1,0],["وإذا سرحتَ الطّرفَ لم تَرَ فيهمُ","إلّا نَجيعاً بالطّعانِ دفيقا",130,"ق",2,0],["وإذا سعيتُ أفوتُهُ","لم تدرِ بُطْئي من خُفوفي",131,"ف",2,0],["وَإذا سَربلَ الخداعُ نفوساً","حسَرَتْ نفسُه قِناعَ الخداعِ",132,"ع",1,0],["وإذا سُئِلتُ عن الّذي بِيَ بعدَهُ","فصممتُ عنه فلا تَعِبْ إبلاسي",133,"س",2,0],["وإذا سمتُهُ نهوضاً بثِقْلٍ","خاننِي منه عودُهُ الخَوّارُ",134,"ر",1,0],["وإذا سريتُ سرى معِي وَضِحاً","وهْناً وجُنْحُ اللّيلِ مُسْودُّ",135,"د",1,0],["وَإِذْ أسْماعهُنَّ إليَّ مِيلٌ","يُصِخْنَ إِلى اِختِياري وَاِقتِراحِي",136,"ح",2,0],["وَإِذا سَقاكَ اللَّه مِن رَحماتِهِ","فَلأَنْتَ أسعدُ من أتاهُ وأفلجُ",137,"ج",1,0],["وَإِذا سَقى اللَّه القُبو","رَ فمنْ مَراحِمِهِ سُقيتا",138,"ت",2,0],["وإذا سترتُ فمن يقد","درُ أنّنِي أهلي عنيتُ",139,"ت",1,0],["وَإِذا سَماءُ ذَوي السَماحَةِ لَم تَجُد","جادَت سَماؤُكَ مَسبِلاً هَطّالا",140,"ل",2,0],["وإذا سُئلتَ لهُ عن التاريخِ قُلْ","في حِضن إبراهيمَ باتَ سَميُّهُ",141,"ه",1,0],["وإذا سَلِمتَ لها اطمأنَّت واكتفتْ","وتَعزَّتِ الدُّنيا بأنَّكَ سالمُ",142,"م",1,0],["وإذا سَلِمتَ فأنتَ شَمسٌ قد كَفَتْ","عن ضَوءِ كلِّ الأنجُمِ المُتَواريَهْ",143,"ي",2,0],["وإذا سكَتَّ فعن رِضَىً","وإذا نَطقتَ فبالحِكَمْ",144,"م",1,0],["وإذا سَألتَ فلا تَزِد","وإذا سُئلتَ فقُلْ نَعَمْ",144,"م",1,0],["وإِذا سأَلْتَ مَنْ الكريمُ فإِنَّه","عبدُ الرَّحيم وإِنَّه مولى الوَرَى",145,"ر",2,0],["وإذا سنى الاقمار أشرق في السما","ببهائهن اضاءت الاكوان",146,"ن",1,0],["وإذا سماء أرعدت أو أبرقت","فالغيث من برق الزمان ورعده",147,"د",2,0],["وَإِذا سَأَلتَ عَنِ الجِهادِ فَإِنَّهُ","مُنذُ الحَداثَةِ كاَ في سَرَواتِهِ",148,"ت",2,0],["وَإِذا سُئِلتَ فلَن تجد","أزكى وأطهر منه فعلا",149,"ل",2,0],["وَإذا سَبَقتُ الخَيلَ مَشكُولاً فَقُل","ماذا يَكُونُ إذا حَلَلتَ شِكالي",150,"ل",2,0],["وَإذا سَحابُ نَدَىً كَذَبنَ غُيُومُهُ","آمالَ شائِمِهِ صَدَقنَ غُيُومُهُ",151,"م",2,0],["وإذا سَعَت حَيّاتُهم فَحَذِرتَها","دَبَّت عَقارِبُهم إليكَ دبيبا",152,"ب",2,0],["وَإذا سَعَيتَ إلَى رِضاهُ فَلا تَرَى","بَرِقاً وَلا مُتسَّخِطاً جَبّاها",153,"ا",3,0],["وإذا سفرت فإنما","سفر الزمان عن السرور",154,"ر",1,0],["وإذا سمعت فعن فم","المولى الملقب بالأمير",154,"ر",1,0],["وإذا سباك البرق يلمع في الدجى","فأنا الضحوك مع البروق اللمع",155,"ع",1,0],["وإذا سئلت بمن أهيم صبابة","قلت: الذين هم الذين هم هم",156,"م",1,0],["وَإِذا سَرى فَالكُلُّ حَول رِكابه","في مَوكب يَسمو عَلى الجَوزاء",157,"ا",2,0],["وإذا سألتَ أجبتُ عنه أنّه","الْقاضي بنُ منظورٍ أبو عمرِ والرِّضَا",158,"ض",2,0],["وإذا سد باب علم عويص","كان مفتاح بابه المسدود",159,"د",1,0],["وإذا سمعتم بأمري شرب الردى","عزوه بعد حياته بمماته",160,"ت",2,0],["وإذا سترت جوى الغرام أَذاعه","نَفَسٌ يقومُ له اعوجاجُ ضلوعي",161,"ع",2,0],["وَإِذا سَئِمتَ مِن اِمرِئٍ","فحديثُهُ ترْكُ الحديث",162,"ث",1,0],["وَإِذا سَطَوتَ عَلى الأُلوفِ مِنَ العِدا","شتّتّهُم فألوفهم آحادُ",163,"د",1,0],["وإذا سَللتَ على العِداة قواضباً","فَغِمادُها الأحشاءُ والأكبادُ",163,"د",1,0],["وَإِذا سَأَلتَ المَجدُ أَينَ مَحَلُّهُ","فَالمَجدُ بَينَ مُحُمَّدٍ وَسَعيدِ",164,"د",1,0],["وإذا سمعت النذْل يسخر من ذوى","المعروف فاصفح عنه ثُمَّت قل سلامْ",165,"م",1,0],["وإذا سئلتُ عن الطبيب أجبتُهم","مُتأوِّهاً هذا فعالُ طبيبي",166,"ب",2,0],["وَإِذَا ساءَلْتُ أَسْرَابَ المَهَا","قُلْنَ: ما نَعْلَمُ عنهُ مِن نَبا",167,"ب",2,0],["واذا سَمِعنَ هماهماً من رِفقَةٍ","واذا النجومُ غوابِراً لم تخفِقِ",168,"ق",1,0],["وإذا سفرن عن المحاسن للورى","فهناك مصرع كل قلب عاني",169,"ن",2,0],["وإذا سفرن فعن وجوهٍ لم تزل","تمحو سواد الليل بالقَسَماتِ",170,"ت",1,0],["وإذا سيوف الهند أوردها الوفى","بيضا أعاد لجينها كالعسجد",171,"د",1,0],["وَإذَا سَألْتَ فَلاَ لأنَّكَ مُحْوَجٌ","وَإذَا كَتَمْتَ وَشَى بِكَ الإحْسَانُ",172,"ن",1,0],["وإذا سكتُّ فخير ما عرف الهوى","أنشودةٌ تبقى بلا انشاد",173,"د",1,0],["وَإِذا سَأَلتُم عَن ضَنى جَسَدي بِهِ","فَسَلوا الحُضورَ فَقَد عَرَفنَ سَقاما",174,"م",2,0],["وإذا سكت فمن يغنيّك","المفوّفة الموائس",175,"س",1,0],["وإِذا سَأَلتُكَ يَقْظَةً","قَرْبي جَنَحْتَ إلى بِعادي",176,"د",2,0],["وإذا سُئِلتِ فأجملي","بالردّ واقتضبي الجوابا",177,"ب",2,0],["وإذا سألت الله في","ك شعرت في رد الجواب",178,"ب",1,0],["وإذا سئلت أقل لمن هو سائلٌ","إني لأعلمُ ما تقولُ وإنما",179,"م",2,0],["وإذا سررت بخل صدقٍ وافدٍ","ورضيته فانظر إلى الترحال",180,"ل",1,0],["وإذا سمعت مدحه فاصغي له","بتأدب واسعى له بتلهف",181,"ف",1,0],["وإذا سرى سحراً طليح نسيمه","مالت بهِ سكراً ذوائب طلحه",182,"ح",2,0],["واذا سهام القطر جادته اغتدى","متحصناً اليك بطرف ظبي فاتر",183,"ر",1,0],["واذا ساء السفيه بما شاء","فترك الجواب عنه جوابه",184,"ب",2,0],["وإذا سخِطتُ على القوافي صُغتُها","في غيره لأذِلَّها وأُهينَها",185,"ه",2,1],["وإذا ساعدت في شأن الهوى","فاتخذ من ذكر أحبابي طريقه",186,"ق",2,0],["وإذا سألتَهمُ النّوال وجدتهم","سُمُحاً بجَزل النائل المسْتَبْشرِ",187,"ر",1,0],["وإِذا سوادُ العينِ هَّم بنَظرةِ","نحو الحسان رَددُتها بردائي",188,"ا",2,0],["وَإِذا سُيوفُكَ صافَحَت هامَ العِدا","طارَت لَهُنَّ عَنِ الرُؤوسِ الهامُ",189,"م",1,0],["وإذا سكرتُ فشارب","خمري من الأُنسْ المُخامِر",190,"ر",1,0],["وإذا سئلتُ ولي فتىً ما بينكم","فشهادتي مجروحةٌ إن أشهد",191,"د",1,0],["واذا سألت ابني نزار بيننا","مجدي ومنزلتي من أبني وائل",192,"ل",1,0],["واذا سامر نجماً ورَعى","لم يقل حسبيَ دمعي وكفى",193,"ف",2,0],["وإذا سألت عن اعتقادي قلت ما","كانت عليه مذاهب الأبرار",194,"ر",1,0],["وإذا سطا فالفارس المخبور","وإذا قضى فالعالم النحرير",195,"ر",1,0],["وإذا سلطك الطبع على","جسمها فالعقل سلطان مهيب",196,"ب",1,0],["وإذا سألتك أن أراك حقيقة","فاسمع ولا تجعل جوابي لن