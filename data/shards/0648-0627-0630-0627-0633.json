دُ",1,"د",1,0],["وإذا سَمِعْنا نَبْأةً منْ عاذِلٍ","جُعِلَتْ مَغيضَ دُموعِها الأرْدانُ",2,"ن",1,0],["وَإِذا سارَ سابَقَتهُ المَناي","نَحوَ أَعداهُ قَبلَ يَومِ القُدومِ",3,"م",1,0],["وَإِذا سَطا خافَ الأَنامَ جَميعُهُم","مِن بَأسِهِ وَاللَيثُ عِندَ عِيانِهِ",4,"ن",2,0],["وَإِذا سِحرٌ أَتَت زائِرَةً","كَشَفَت رُؤيَةُ سِحرٍ كُلَّ بَثّ",5,"ث",1,0],["وَإِذا سُئِلتُ عَنِ الَّتي شَغَفَت","قَلبي وَكَلتُهُمُ إِلى أُخرى",6,"ا",1,0],["وَإِذا سَمِعتَ بِأَنَّ مَحروماً أَتى","ماءً لِيَشرَبَهُ فَغاصَ فَحَقِّقِ",7,"ق",1,0],["وَإِذا سُئِلتَ عَنِ الكِنانَةِ قُل لَهُم","هِيَ أُمَّةٌ تَلهو وَشَعبٌ يَلعَبُ",8,"ب",1,0],["وَإِذا سابِحٌ قَدِ اِنقَضَّ في الما","ءِ اِنقِضاضَ العُقابِ فَوقَ الحَمامِ",9,"م",1,0],["وَإِذا سَقى اللَهُ البِلادَ فَلا سَقى","بَلَدَ الهُنودِ سِوى الصَواعِقِ وَالدِما",10,"م",2,0],["وَإِذا سَمِعتِ بِواحِدٍ جُمِعَت لَهُ","فِرَقُ المَحاسِنِ في الأَنامِ فَذاكِ",11,"ك",1,0],["وَإِذا سايَرتَهُ قَدَّمتَهُ","وَتَأَخَّرتَ مَعَ المُستَأنِيَه",12,"ي",2,0],["وَإِذا سَرَيتُ رَأَيتُ نارَكِ نَوَّرَت","وَجهاً أَغَرَّ يَزينُهُ الإِسفارُ",13,"ر",1,0],["وَإِذا سَأَلتَ قَضى القُضاةُ عَلَيكُمُ","وَإِذا اِفتَخَرتَ عَلا عَلَيكَ فَخاري",14,"ر",2,0],["وإذا سخا ملأ الدِّيارَ عوارفاً","وإذا غزا ملأَ القفار عساكرا",15,"ر",2,0],["وإذا سطا جعلَ الحديد قلائداً","وإذا عفى جعل الحديد جواهرا",15,"ر",2,0],["وإذا سألت الناسَ عنك ولم تكنْ","لتطيبَ حين يُثيرُك البحَّاثُ",16,"ث",1,0],["وإذا سمعتَ هجاءَهُ","فاجعلْ وقارك ثَم وقرا",17,"ر",2,0],["وإذا سُئلْتَ فلا نداك تكلُّفٌ","وإذا مُدِحْتَ فلا ثناك تمحُّلُ",18,"ل",1,0],["وإذا سُمِّيتْ دُوَيهيَّةً إح","دى الدواهي فالأمر غير مروم",19,"م",1,0],["وَإِذا سَما لِلمَجدِ فَرعا وائِلٍ","وَاِستَجمَعَ الوادي عَلَيكَ فَسالا",20,"ل",2,0],["وَإِذا سَرَّ نُفوساً أَنَّها","تُحسِنُ الأَخذَ فَسُرّي بِالعَطاء",21,"ا",2,0],["وَإِذا سَمِعتُ هُتافَ شادِيَةٍ","أَمسَكتُ عَنها السَمع وَالكَبِدا",22,"د",2,0],["وَإِذا سَمِعتُ حِكايَةً عَن عاشِقٍ","عَرَضاً حَسِبتُني الفَتى المَقصودا",23,"د",2,0],["وَإِذا سِراجي قَد وَهَت وَتَلَجلَجَت","أَنفاسُهُ فَكَأَنَّهُ المَصدورُ",24,"ر",1,0],["وَإِذا سَكَنتُ إِلى الهُمومِ فَمِثلَما","رَضِيَ القُيودُ الموثَقُ المَكبولُ",25,"ل",1,0],["وَإِذا سَأَلتَ سَأَلتَ غَيثاً مُسبَلا","وَإِذا لَقيتَ لَقيتَ لَيثاً مُشبِلا",26,"ل",2,0],["وَإِذا سَمِعنَ هَديرَ أَكلَفَ مُحنِقٍ","عَدَلَت سَوالِفُها إِذا ما جَلجَلا",27,"ل",2,0],["وإذا سَأَلْتُ لِمَ الوجودُ","وكُلُّهُ همٌّ مُذيبْ",28,"ب",1,0],["وَإِذا سُلَيمانَ اِستَقَلَّ مَحَلَّةً","كانَت بِساطاً لِلنَدى وَرَجاءَ",29,"ا",2,0],["وَإِذا سَبى الفَردُ المُسَلَّطُ مَجلِساً","أَلفَيتَ أَحرارَ الرِجالِ عَبيدا",30,"د",2,0],["وَإِذا سَكَتَّ فَإِنَّ أَبلَغَ خاطِبٍ","قَلَمٌ لَكَ اِتَّخَذَ الأَصابِعَ مِنبَرا",31,"ر",2,0],["وَإِذا سَأَلتَ بَنانَهُ عَن نَيلِهِ","لَم يَرضَ بِالدُنيا قَضاءَ ذِمامِ",32,"م",1,0],["وَإِذا سَحابَةُ صَدِّ حُبٍّ أَبرَقَت","تَرَكَت حَلاوَةَ كُلِّ حُبٍّ عَلقَما",33,"م",2,0],["وإِذا سُئِلتُ عن السُّلوِّ أجبتُهم","بلسانِ معترفٍ ونيَّةِ جاحدِ",34,"د",1,0],["وَإِذا سَأَلتَهُمُ نَدىً","فَجَوابُهُم عَن ذاكَ وَو",35,"و",1,0],["وإذا سقاني الدهر سم خطوبه","داويته بمدامة أو ساقي",36,"ق",2,0],["وَإِذا سَكَنتَ إِلى الهُدى وَأَطَعتَهُ","أُلبِستَ حُلَّةَ صالِحِ الأَعمالِ",37,"ل",1,0],["وَإِذا سَبَحتَ إِلى الهَوى أَذيالَهُ","أَلقاكَ في قيلٍ عَلَيكَ وَقالِ",37,"ل",1,0],["وَإِذا سَأَلتَ فَلَم تَجِد أَحَداً","فَسَلِ الزَمانَ فَعِندَهُ الخَبَرُ",38,"ر",1,0],["وَإِذا سَطوا بَكَتِ السُيوفُ وَإِن سَخوا","ضَحِكَ النَدى وَتَجَلَّتِ الغَمّاءُ",39,"ا",2,0],["وَإِذا سَمِعتَ بَأَنَّ قِدماً مُظهِراً","عَنها النَفارَ فَتِلكَ مِن آياتِها",40,"ت",3,0],["وَإِذا سَأَلتَ السَيفَ قالَ فِرِندُهُ","لا عِلمَ لي إِلّا الَّذي عَلَّمتَني",41,"ي",1,0],["وإذا سَقّيْتَ منها شفَقاً","طَلَعَتْ حُمْرَتُهُ في وجنَتَيك",42,"ك",1,0],["وَإِذا سَرَحتَ الطَرفَ حَولَ قِبابِهِ","لَم تَلقَ إِلّا نِعمَةً وَحَسودا",43,"د",2,0],["وَإِذا سُرِرتُ يَسوءُهُ ما سَرَّني","وَيَرى المَسَرَّةَ مَروَتي أَن تُقرَعا",44,"ع",2,0],["وإذا سألتَ عن الصِّعابِ وحكمِها","فالعلمُ للصَّعبِ الأبيِّ قيادُ",45,"د",1,0],["وَإِذا سَطا سَطَتِ المَنو","نُ بِهِ وَتَعفو إِن عَفا",46,"ف",2,0],["وَإِذا سارَ رَمى","بِيَدَيهِ القُمُطا",47,"ط",2,0],["وإذا سخَّرَ الإِلهُ أُناساً","لسعيدٍ فإِنهم سُعَداءُ",48,"ا",2,0],["وإذا سما باسْمِ العلومِ فلا تَسَلْ","عَن حَطِّ نَفْس بالحَضِيضِ الأَوْهَدِ",49,"د",1,0],["وَإِذا سُئِلتُ أَتَيتُها","ضَربَ الأَميرِ طُلا الأَعادي",50,"د",2,0],["وَإِذا سَكِرتَ فَخُذ بِأَيرِ مُساعِفٍ","وَاِسكُن فَإِنَّكَ ناطِقٌ لا تُرشَدُ",51,"د",1,0],["وَإِذا سَرى كَحَلَ الزَميلَ بِأَرقَةٍ","مِن قَرعِ بازِلِهُ وَمِن قَيقابِهِ",52,"ب",2,0],["وَإِذا سُيوفِ الهِندِ أَدرَكَها البِلى","فَمِنَ العَجائِبِ أَن تَدومَ غُمودُها",53,"د",3,0],["وَإِذا سَرَيتَ سَرَت أَموناً رَسلَةً","وَإِذا تُكَلِّفُها الهَواجِرَ تُصخِدُ",54,"د",1,0],["وإذا سألُتكَ أن أراكَ حقيقةً","فاسمَحْ ولا تجعلْ جوابي لن تَرى",55,"ر",2,0],["وإذا سنة المعيشة شذت","فيك فالحظ فوق كل اِعتراض",56,"ض",1,0],["وإذا سيم الشعب يوماً هواناً","فَهو يبدي عَلى المهين اِحتجاجا",57,"ج",2,0],["وَإِذا سارَ سابَقَتهُ المَنايا","نَحوَ أَعداهُ قَبلَ يَومِ القُدومِ",58,"م",1,0],["وَإِذَا سَمِعْتَ صِيَاحَهُمْ وَدَوِيَّهُمْ","لَمْ تَدْرِهِ فَرَحاً وَلاَ إِعْوَالاَ",59,"ل",2,0],["وَإذَا سَفَرْنَ فَأيْنَ ضَوْ","ءُ الشمْسِ مِنْ شَفَقِ الْخُدُودِ",60,"د",1,0],["وإذا سَما الملِكُ الهُمامُ لغايةٍ","فالصَّعبُ هَيْنٌ والعَسيرُ مُيَسَّر",61,"ر",1,0],["وَإذَا سَكِرْتَ فَخُذْ بِأَيْرِ مُسَاعِفٍ","وَاسْكُتْ فَإِنَّكَ نَاطِقٌ لاتُرْشَدُ",62,"د",1,0],["وإذا سألتَ الرفقَ كان جوابُهُم","ما للقلوبِ الموجَعاتِ ومالي",63,"ل",2,0],["وَإذا سَابَقَ الجِيَادَ إلى المَجْ","دِ، فَما البرْقُ خَلفَهُ بسَرِيعِ",64,"ع",1,0],["وإذا سَقّيْتَ منها شَفقاً","طلعتْ حُمرتهُ في وجنيتكْ",65,"ك",1,0],["وإذا سُمِّيتْ دُوَيْهِيَّة ً أح","ك ملهى ً وعرضة َ استهزاء",66,"ا",2,0],["وَإذا سَمْعْتَ نَحِيبَ أُمِّيَ في الدُّجى","تَبْكي شَباباً ضاعَ في الرَّيْعانِ",67,"ن",1,0],["وإذا ساءَ منزلٌ أو نبا بي","وعزتي همومُه حلاّها",68,"ا",3,0],["وإذا سلمتَ اليوم منه","يأتي القضاءُ به غدَا",69,"د",2,0],["وَإِذا سَمَت آمالُ حاسِدِ نِعمَةٍ","بَسَطَ الرَجاءَ فَعَبدُكَ المَحسودُ",70,"د",1,0],["وَإِذا سَطَوا خَتلاً سَطَوتَ مُصَرِّحاً","وَإِذا نَخَوا قَولاً نَخَوتَ فِعالا",71,"ل",2,0],["وإذا سخطا تزايد خوفها","واستسلمت للموت من إشفاقها",72,"ق",3,0],["وَإِذا سَمِعتَ وَحَى الزَما","نِ فَلا تُقَصِّر في الوَحاءِ",73,"ا",2,0],["وإذا سألتَ فنَمْ فهِمَّتُه بها","كالبَيْنِ بين جُفونه وسِناته",74,"ت",2,0],["وَإِذا سَفِهتَ على السبكيّ تابعه","سُؤتَ الإمامَ وكلّ المقتدين بهِ",75,"ب",2,0],["وإذا سألت وجاد يوما","ما بوعد أو تكرّم",76,"م",1,0],["وإذا سمعتَ صرير أقلامٍ له","فزئير أُسدٍ في حمى الأشبالِ",77,"ل",1,0],["واذا سألت عن الذنو","ب غدا فلن تجد الجواب",78,"ب",1,0],["وَإِذا سَنا المِصباح قابَلَ نورهُ","سَلَبَ الذُبال تَشَعشعَ الوقدانِ",79,"ن",1,0],["وَإِذا سَرَت سَكرى شَمالٌ خِلتَها","مَرَّت بِأَخلاقٍ لَهُ وَشَمائِلِ",80,"ل",1,0],["وَإِذا سِنو الأَزَماتِ صَوَّحَ نَبتُها","فَلَديهِمُ يُلغى الخَصيبُ المُمِرِعُ",81,"ع",1,0],["وإذا سكرت فإنني","مُستَهلِكٌ مالي وعتقي",82,"ي",1,0],["وإذا سَحَّرَ المسحِّرُ ليلا","التقى الأمرُ فيه بالعصيان",83,"ن",1,0],["وإذا سلمت فعند بابك","عائد والمهرجان",84,"ن",1,0],["وإذا سطوت أسرت آساد الشرى","قسراً ويأسرني الغزال الأغيد",85,"د",1,0],["وإذا سمعتَ من المؤذِّنِ دعوةً","للخيرٍ شدَّ يداً ومدَّ صراطا",86,"ط",2,0],["وإذا سمعتُ حديثها لم اكترث","لتلاوةِ الإنجيلِ والمزمور",87,"ر",1,0],["وإذا سَرَى عندَ العشيّةِ مَركبٌ","فيهِ شبيبةُ أرضِنا حيِّينا",88,"ن",2,0],["وإذا سَحقتِ الزّنجَ والافرنجَ لا","تنسي الذين على العِدى نَصَروك",89,"ك",1,0],["وإذا سَمَحْتُمْ بالعِتابِ سَمِعْتُهُ","خَبَراً يَطِيحُ على لِسان النَّاسِ",90,"س",1,0],["وَإِذا سَرَت فَالثَناء أَمامي","وَوَرائي وَيسرَتي وَيَميني",91,"ن",2,0],["وإذا سَرَى لم تَهْدِه مَشبوبَةٌ","باللّيلِ إلاّ ما يُجِنُّ جِناني",92,"ن",2,0],["وإذا سألتَ عنِ المكارمِ والعُلا","فلأولٍ من قاسِمَيْهِ وثان",92,"ن",1,0],["وإذا سَمِعْتَ به سمعتَ بماجدٍ","يأتيك واصِفٌه بكُلِّ بَديع",93,"ع",1,0],["واذا سَدَّد الكُماةُ قَناهم","بين آذانِ خَيلِهم تَسْديدا",94,"د",2,0],["وَإِذا سُئِلتَ عَنِ الغَرامِ فَقُل","قَدَرٌ وَمَن ذا يَدفَعُ القَدَرا",95,"ر",2,0],["وَإِذا سُئِلتُ فَإِن أَجَبتُ سُؤالَهُ","عَمّا قَضى بِتَغَرُّبي وَتَشَتُّتي",96,"ي",1,0],["وَإِذا سَمِعتَ بَني أُسامَةَ فَاِستَمِع","مِنهُم لِما يوحى وَأَخبِتُ وَاِنصِتِ",96,"ت",1,0],["وَاِذا سُئِلتَ لِقصدِها وَمقرِّها","فَالحَيرُ أَو كوفان أَو بَغداد",97,"د",1,0],["وإذا سَعى مَعَهُ الحيا متَصَوِّباً","أَلفَيتَهُ من خلْفه يتكسَّرُ",98,"ر",1,0],["وإذا سخر الإِله أناساً","لسعيد ينال أعلى منال",99,"ل",1,0],["وإذا سلمتَ على امرئ فاشكر له","ما كفَّ عنكَ من الأذى فهو الندى",100,"د",2,0],["وإذا سموْتَ إلى المعالي فاخْتَرِطْ","عَزماً كما عَزَمَ الرِّجالُ البُزَّلُ",101,"ل",1,1],["وإذا سطا أضحت قلوب عداته","تلوى كمخراق بكفي لاعب",102,"ب",1,0],["وإذا سرى خلت البسيطة لجّة","أمواجها بيض وبيضٌ قواضب",102,"ب",1,0],["وإذا سَلِمتَ ونلتَ أيسرَ بُغيَةٍ","مِنها جعلْتَ لكَ البريَّة حُسَّدا",103,"د",2,0],["وإذا سَلِمتَ أبا سلامَةَ لي","فمُصابُ كلِّ رزِيَّةٍ ظَلَفُ",104,"ف",1,0],["وإذا سُئِلتَ عَلامَ تَه","جُرهُ فَقُلْ ما صَحَّ عهدُهْ",105,"د",2,0],["وإذا سرتَ بالمطيِّ فمهلاّ","وتَرَفَّقْ بها فيما هي إلاَّ",106,"ل",2,0],["وإذا سُخِّرتِ الريح له","كانَ من أمثاله في السير ساخر",107,"ر",1,0],["وإذا ساءت الظنون بحالٍ","حَسُنَتْ فيك لا بغيرك حاله",108,"ل",2,0],["وإذا سََرحتَ إلى الرِّياض فنَلْ إذَنْ","من رَوحها أرَجاً ومن رَيْحانها",109,"ن",3,0],["وإذا سألتُ مكارماً من ماجد","ما كانَ غير نوالك المسؤولا",110,"ل",2,0],["وإذا سألتُ سواكَ كنت كأنَّني","أبغي لذاتك في الأنام مثيلا",110,"ل",2,0],["وإذا ساءَ غيورٌ أحْسَنا","بحميّا رشفاتِ القبلِ",111,"ل",1,0],["وإذا سألتهمُ بمسألةٍ","بخلوا ولو بقلامة الظفر",112,"ر",1,0],["وإذا سابقَ الجيادَ الى المج","دِ فكالبرقِ حالةَ الإبراقِ",113,"ق",1,0],["وإِذا سَرَّكَ صُنْعٌ فَلْيَدُمْ","وإِذا وافاكَ عيدٌ فَلْيَعُدْ",114,"د",1,0],["وإِذا سُيُوفُهُمُ لَمَعْنَ لوقعَةٍ","جَلَلٍ فوجْهُ الفتحِ فِيهَا لامِعُ",115,"ع",1,0],["وإِذا سَقَاني من عُقارِ جُفُونِهِ","أَبْقى عليَّ فَشَجَّها بِرُضَابِ",116,"ب",1,0],["وإذا ساجلت فأيهما","عاينت تجد ثقة ارشد",117,"د",1,0],["وإذا سمعتَ حمِدتَ صفوي وحدَه","وذمَمتَ غِشَّ القائلين وذَامَها",118,"م",3,0],["وإذا سُحْبُك عني عَبستْ","فمتى آملُ من أَرضِي ابتساما",119,"م",2,0],["وإذا سقى الغيثُ البلادَ بمسبِلٍ","غدَقٍ وهتَّانِ الحيا هطَّالِ",120,"ل",1,0],["وإذا سرى نقصُ القبائل أقبلتْ","تَنمِي المكارمُ فيهُمُ وتزيدُ",121,"د",1,0],["واذا سنَّ ليَ الصَّمتَ النُّهى","قال غيري ومَقالي لم يُذَلْ",122,"ل",1,0],["وإذا سما لرفيع مجدٍ طرفهُ","نظرَ الحسودُ إليه من طرفٍ خفي",123,"ف",2,0],["وإذا سلكت طريقة سلكوا معي","إذ لم أكن لسوى الصلاح بسائر",124,"ر",1,0],["وإذا سَطا صِدقي علَى العقَّاد قد","تَسطُو على أضدَادها الأضدَاد",125,"د",1,0],["وإذا سخطتُ فليس لي","مِن كاعِبٍ إلّا رضاها",126,"ا",3,0],["وَإِذا سُمتُها كما اِشترط المج","دُ فنادِ الرّجالَ لا لا تسوموا",127,"م",3,0],["وإذا سألتَ فلم تُغالِ ولم تُخَبْ","وَإن اِشتططّتَ أخذتَ ما لم تسألِ",128,"ل",1,0],["وإذا سرحتَ الطّرفَ لم تَرَ فيهمُ","إلّا نَجيعاً بالطّعانِ دفيقا",129,"ق",2,0],["وإذا سعيتُ أفوتُهُ","لم تدرِ بُطْئي من خُفوفي",130,"ف",2,0],["وَإذا سَربلَ الخداعُ نفوساً","حسَرَتْ نفسُه قِناعَ الخداعِ",131,"ع",1,0],["وإذا سُئِلتُ عن الّذي بِيَ بعدَهُ","فصممتُ عنه فلا تَعِبْ إبلاسي",132,"ي",1,0],["وإذا سمتُهُ نهوضاً بثِقْلٍ","خاننِي منه عودُهُ الخَوّارُ",133,"ر",1,0],["وإذا سريتُ سرى معِي وَضِحاً","وهْناً وجُنْحُ اللّيلِ مُسْودُّ",134,"د",1,0],["وَإِذْ أسْماعهُنَّ إليَّ مِيلٌ","يُصِخْنَ إِلى اِختِياري وَاِقتِراحِي",135,"ي",1,0],["وَإِذا سَقاكَ اللَّه مِن رَحماتِهِ","فَلأَنْتَ أسعدُ من أتاهُ وأفلجُ",136,"ج",1,0],["وَإِذا سَقى اللَّه القُبو","رَ فمنْ مَراحِمِهِ سُقيتا",137,"ت",2,0],["وإذا سترتُ فمن يقد","درُ أنّنِي أهلي عنيتُ",138,"ت",1,0],["وَإِذا سَماءُ ذَوي السَماحَةِ لَم تَجُد","جادَت سَماؤُكَ مَسبِلاً هَطّالا",139,"ل",2,0],["وإذا سُئلتَ لهُ عن التاريخِ قُلْ","في حِضن إبراهيمَ باتَ سَميُّهُ",140,"ه",1,0],["وإذا سَلِمتَ لها اطمأنَّت واكتفتْ","وتَعزَّتِ الدُّنيا بأنَّكَ سالمُ",141,"م",1,0],["وإذا سَلِمتَ فأنتَ شَمسٌ قد كَفَتْ","عن ضَوءِ كلِّ الأنجُمِ المُتَواريَهْ",142,"ي",2,0],["وإذا سكَتَّ فعن رِضَىً","وإذا نَطقتَ فبالحِكَمْ",143,"م",1,0],["وإذا سَألتَ فلا تَزِد","وإذا سُئلتَ فقُلْ نَعَمْ",143,"م",1,0],["وإِذا سأَلْتَ مَنْ الكريمُ فإِنَّه","عبدُ الرَّحيم وإِنَّه مولى الوَرَى",144,"ر",2,0]]}