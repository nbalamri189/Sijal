{"poems":[[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[31,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[31,"ألا سائل الجحاف هل هو ثائر","https://www.aldiwan.net/poem6101.html","الطويل"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[112,"سحر","https://www.poetsgate.com/ViewPoem.aspx?id=8410",""],[438,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32835","الطويل"],[4984,"أول ماي","https://www.poetsgate.com/ViewPoem.aspx?id=180386",""],[5461,"ظلمتين","https://www.poetsgate.com/ViewPoem.aspx?id=5301",""],[6102,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=184867",""]],"verses":[["أَجَحَفتُمُ جُحَفَ الخَزيرِ وَنِمتُمُ","وَبَنو صَفِيَّةَ لَيلُهُم لا يَهجَعُ",0,"ع",1,0],["أَجَحّافُ ما مِن كاشِحٍ ذاقَ حَربَنا","فَيُفلِتَ إِلّا اِزدادَ عَنّا تَناهِيا",1,"ي",2,0],["أَجَحّافُ إِن نَصكُكَّ يَوماً فَتَصطَدِم","عَلَيكَ أَواذِيُّ البُحورِ الذَواخِرِ",2,"ر",1,0],["اجحيم هي لي","ونعيم هو لك",3,"ك",1,0],["أجحر .. بقلبي .جرح . وأنساني وعززّني . عشان","مافيه ضلعن ,., نازي الاّ في محاديره جحر",4,"ر",1,1],["أَجْحَفْتَ بي وبوُدِّي لو تُقَعْقُعُ لي","بالموتِ من دونِ هذا عِنْدَكَ الحَجَفُ",5,"ف",1,0],["أَجَحظَةُ إِن تَجزَع عَلى فَقدِ مَعشَرٍ","فَقَدتَ بِهِم مَن كانَ لِلكَسرِ يَجبُرُ",6,"ر",1,0],["إجحاف من هضموا العمال أيقظهم","شيئا فشيئا لذا إحساسهم نضجا",7,"ج",2,0],["أجحد واجنّب مشكلي كل غالي","واكناه عن عدواني الّلي مغاليل",8,"ل",1,0],["أَجْحَفْتِ بِالصَّدِّ وَ الهِجْرَانِ وَ انْتَفَضَتْ","مَكَائِدُ الشَّرِّ لَمَّا ازْدَدْتِ طُغْيَانا",9,"ن",2,0]]}