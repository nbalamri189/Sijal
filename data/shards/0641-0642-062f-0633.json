5,"","https://poetry.dctabudhabi.ae/diwan/poem/35099","الطويل"],[4726,"مآل كل امرءٍ للموت والعطب","https://www.poetsgate.com/ViewPoem.aspx?id=146654",""],[4767,"الأمل المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=91606",""],[585,"سل الدار والأجيال هل طلع الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=161889",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5296,"حروف العُرْب","https://www.poetsgate.com/ViewPoem.aspx?id=155352",""],[5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[5431,"نعم أنت الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=183080",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5563,"بيروت تثعب","https://www.poetsgate.com/ViewPoem.aspx?id=215318",""],[5660,"فَهَل مِن بَلسَمٍ لِلجُرحِ فينا","https://www.poetsgate.com/ViewPoem.aspx?id=23972",""],[5736,"تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=203886",""],[5846,"نداءُ شاعرة..","https://www.poetsgate.com/ViewPoem.aspx?id=123432",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[5913,"جريمة حب","https://www.poetsgate.com/ViewPoem.aspx?id=177073",""],[5970,"لنا أمل في أن يذيل لنا الغد","https://www.poetsgate.com/ViewPoem.aspx?id=130638",""],[6093,"ذاك لنا","https://www.poetsgate.com/ViewPoem.aspx?id=197424",""],[2575,"يا ناعس الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10276",""],[1395,"على منزل كان الحبيب به قل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605517",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""]],"verses":[["فقدْ سادَ جَسّاسُ بنُ مرَّةَ وائِلاً","بقَتْلِ كُلَيْبٍ دونَ لَقْحةِ جارِهِ",0,"ر",2,0],["فقد سلكوا بهنّ سبيل خُسْر","وصدّوهنّ عن سُبُل الحياة",1,"ه",1,0],["فَقَد سَمِعتُ حَديثاً بَعدَ مَوثِقِنا","مِمّا ذَكَرتِ إِلى زَيدٍ وَشَدّادِ",2,"د",1,0],["فَقَد سَلَبَت عَصاكَ بَنو تَميمٍ","فَما تَدري بِأَيِّ عَصاً تَذودُ",3,"د",1,0],["فَقَد سَرَّني أَن لا يَزالَ يَزيدُكُم","يَسيرُ بِأَمرِ الأُمَّةِ المُتَتابِعِ",4,"ع",1,0],["فقد سُمتُ أيري نيكَ عِرسكَ جاهداً","ونيكَكَ يا ابنَ الزانييْن فما نَشِط",5,"ط",1,0],["فَقَد سَعى لي في الَّذي أَبتَغي","أَبو الحُسَينِ ابنُ أَبي القاسِمِ",6,"م",1,0],["فَقَد سَهَّلَ البَينَ المُشَتِّتَ بَينَنا","جَفاكُم وَأَحلى صَدَّكَم وَهوَ عَلقَمُ",7,"م",1,0],["فَقَد سَحَبَت فيها السَحائِبُ ذَيلَها","وَقَد أُخمِلَت بِالنَورِ فيها الخَمائِلُ",8,"ل",1,0],["فَقَد سارَ صيتُكَ سَيرَ الصَباحِ","يَجِدُّ مَعَ المُعَلِّمِ المُجهَلا",9,"ل",2,0],["فَقَد سَنَّ هَذا الحُبَّ مَن كانَ قَبلَنا","وَقادَ الصِبا المَرءَ الكَريم فَأَعنَقا",10,"ق",2,0],["فقد سئِمَتْ بِيضُ الظُّبى من جفُوُنها","وكانتْ متى تألَفْ سِوَى الهام تَسْأم",11,"م",1,0],["فقد سارَ فيهِمْ سيرةً لم يسِرْ بها","من النّاس إلاّ مثلُ كعبٍ وحاتم",12,"م",1,0],["فقد سَرَى بسِراجٍ منك في ظُلَمٍ","وقد أُعينَ بسَيْلٍ منك في صَبَب",13,"ب",1,0],["فَقَد سَمِعَت أُذناكَ عِندَ مِزاجِها","أَنيناً وَأَلحاناً تُجيبُ دَنينَها",14,"ن",3,0],["فقد سقاها ريقُ الغوادي","بالغربِ من مكّة البريدِ",15,"د",1,0],["فَقَد سَمِعتَ بِموسى حينَ أَفظَعَهُ","وَعيدُ فِرعَونَ لَو يَأتي بِما يَعِدُ",16,"د",1,0],["فَقَد ساغَ لِلغَيرانِ مِن ذاكَ ريقُهُ","وَنامَ العِدى حَتّى اِفتَرَقنا وَأَنجَحوا",17,"ح",3,0],["فَقَد سَئِمتُ خَوضَ الرِمالِ خِفافُها","وَنَضحَ صَداها بِالمِياهِ الأَواسِنِ",18,"ن",1,0],["فقد سمعت بأذني","وَقَد رأَيت بعيني",19,"ي",1,0],["فَقَدْ سَفَرَتْ لِعَيْنَيْهِ اللَّيَالِي","وَبَانَ لَهُ الْهُدَى مِنْ بَعْدِ لَبْسِ",20,"س",1,0],["فَقَد سَلِمَت مِنَ المَكروهِ نَفسي","وَإِلّا لَم أَعِش إِلّا قَليلا",21,"ل",2,0],["فَقَدْ سُوِّسْتِ أمْرَ بَنِيكِ حتّى","تركتهمُ أدقُّ من الطحينا",22,"ن",2,0],["فقد سار بين حُداة الركاب","حديثٌ يرِق له الكاشح",23,"ح",1,0],["فقد سُمتُ أيري نيكَ عِرسكَ جاهداً","ونيكَكَ يا بن الزانييْنَ فما نشط",24,"ط",1,0],["فَقَد سَرَّني إِذ قُلتَ إِنَّكَ مُؤمِنٌ","فَكُن لِرَسولِ اللَهِ في اللَهِ ناصِرا",25,"ر",2,0],["فَقَد سَفهَت أَخلاقُهُم وَعُقولُهُم","وَكانوا كَجَفرٍ بِئسَ ما صَنَعَت جَفرُ",26,"ر",1,0],["فقد سقَّيتُ بَرْدَ اليأسِ منهم","فؤادا من رجائهمُ يُحَمُّ",27,"م",1,0],["فَقَد سادَ في المَعمورِ كُلَّ مُسَوَّدٍ","وَفي المَلإِ الأَعلى لَهُ أَيُّ مَصعَدٍ",28,"د",1,0],["فقد سبقتنا هذه فرطا لنا","ونحن غدا أو بعده من ورائها",29,"ا",3,0],["فقد سمعت اذني وابصر ناظري","تلطفهم مستعطفين المراحما",30,"م",2,0],["فقد سهل الباري عليك طريقه","فدونك من مرضاته فوق ما تهوى",31,"و",2,0],["فَقَد سَيَّروا ما لا يُسَيِّرُ مِثلَهُ","فَصيحٌ عَلى وَجهِ الزَمانِ وَأَعجَمُ",32,"م",1,0],["فَقَد سَئِمَت نَفسي المُقامَ وَشاقَني","رُكُوبُ الفَيافي مَجهَلاً ثُمَّ مَجهَلا",33,"ل",2,0],["فقد سَمِعتْها الصُّمُّ من كلِّ أَخْرسٍ","وأَبْصَرها في حِنْدِسِ الظُّلَمِ الخُلْد",34,"د",1,0],["فَقَد سُدتَ الورى علواً وسفلا","مَلائكةً وأنباءً ورسلا",35,"ل",2,0],["فَقَدَّسَ اللهُ قَبْراً ضَمَّ أَعْظُمَهُ","أَعْظَمَ أَعْظُمِ أَمْوَاتٍ بِذِي الْحِقَبِ",36,"ب",1,0],["فقد سهرت ومن أدنى منافعها","إعانة العاشق المضنى على السهر",37,"ر",1,0],["فقدَّسهُ يومَ الشَّهادةِ والفِدَى","دَمُ الشُّهداءِ المُرتقينَ إِلى الذُّرى",38,"ر",2,0],["فقد ستروا أهل الطريق وأخملوا","أموراً من التحقيق تى تغطت",39,"ت",1,0],["فَقَد سَبَقَت خَيلَ الجَماعةِ كُلَّها","وَخَيلَ أَميرِ المُؤمِنينَ أَتانُ",40,"ن",1,0],["فقد سُمِّرَ الجلْدُ خوفاً علَيْ","هِ أَوّلَ ما الخَلْقُ منْه اسْتَتمّ",41,"م",1,0],["فقد ساد قبلَ خُلُوِّ الدّيارِ","وأَهْوِنْ بمَنْ حين تَخْلو يَسود",42,"د",1,0],["فقدس اللّه ذاتاً منه طاهرة","قد صار تحت الثرى في التراب أعظمه",43,"م",2,0],["فقد سبقوا السباق في كل غاية","فأوصافهم في كل ناحية تسري",44,"ر",2,0],["فَقَد سُدَّت طياً وَهيَ لِلناسِ سادَة","وكل جَواد سَيِّد سَيُسادُ",45,"د",1,0],["فقد سَرَّ العراقَ ومن عليها","بقاضٍ لا يروغ ولا يحابي",46,"ب",2,0],["فقد سُلِّمَ من خَزْمٍ","ومن خرْمٍ ومن خَبْنِ",47,"ن",1,0],["فقد سرى الغدرُ إلى أفاضل ال","رجالِ واستولى على أعيانِها",48,"ن",3,0],["فقد سقا حبَّكم ال","مدَهِّق المصرِّفُ",49,"ف",1,0],["فَقَد سارَ وَصفُكَ مِنّي عَلى","ثَناءٍ يَجوبُ بِإِرقالِهِ",50,"ل",2,0],["فقد سئمتْ مصاحبتي المَهارى","وشدَّي للحدائج والقُتودِ",51,"د",1,0],["فقد سميت في الشعرا كبيرا","برغمي والحقيقة كنت دونا",52,"ن",2,0],["فقد سَبَقَتْهُمْ بالنَّبيِّ عِصابةً","فهدَّمَ منهم صادِمُ الأَمرِ بُنيَانَا",53,"ن",2,0],["فقد سترت أيامه عيب دهرنا","فلا كشف الرحمن ذلك من ستر",54,"ر",1,0],["فَقد سَئِمناك والمدى كَثِبٌ","ومن ثَوَى الرّيفَ جانَبَ السَّأَما",55,"م",2,0],["فَقد سَبَتني غَيرَ ما تَعذيرِ","مَرمارَةٌ مِثلُ النَقا المَرمورِ",56,"ر",1,0],["فقد سمعت الله قد سماه","صاحبه ولم يكن والاه",57,"ه",1,0],["فَقَدْ سَهِرَتْ عَلى الأْشْوَاقِ لَيْلاً","وَلَيْلُ السَّاهِرِينَ بِهَا يَطُولُ",58,"ل",1,0],["فقد سلبت أعظمي نَحْضَهَا","ولم تَترِكْ من دمي قطرهْ",59,"ر",2,0],["فَقَد سارَ في التَدبير أَحسن سيرة","بِفَضل عَلَيهِ في المَمالك يُحسَد",60,"د",1,0],["فقد سرت بشذاه نسمةٌ نفحت","وأقبلت بعبير طيبٍ عبق",61,"ق",1,0],["فقد سئمت نفسي المقامَ ببلدةٍ","تغيّر فيها مَنْ اتخذتُ خليلاَ",62,"ل",2,0],["فقد سُلِبتْ في بسطةٍ أصلَ وضعها","بتقديم مَنْ لولاه لم تَكُ تُسْلَبُ",63,"ب",1,0],["فقد ساءني أني تخلفت عنكمُ","كمن تاه في بيداء غادرها الركب",64,"ب",1,0],["فقد سكَّنتَ قلباً كاد مما","حشدتَ عليه يخرجُ من إِهابه",65,"ب",2,0],["فَقَد سُدْتَ أَهلَ المَجدِ مِن قَبلِ مَجدِهم","وَمَجدي عَلى منوالِهِ جَلّ أَن يَسدوا",66,"د",3,0],["فَقَدْ سَبَقْتُ بِمَدْحٍ فِيهِ فُزْتُ بِهِ","صِدْقٍ إذَا مُدِحَ الأمْلاكُ بِالْكَذِبِ",67,"ب",1,0],["فقد سكنتك أعرف ذات خدر","بإسداء العوارف فاعرفيها",68,"ي",3,0],["فَقَدْ سَقَانِي النَّوَى بِكَأسٍ","جَرَّعَ قَلْبِي مَرَارَةَ الصَّدْ",69,"د",1,0],["فقد سئمنا التشكّي","وما رجونا استماعا",70,"ع",2,0],["فقد سرت في شرق البلاد وغربها","وطوقت خيلي بينها وركابيا",71,"ي",2,0],["فقد سارت مساوئهم وعمت","فاضحت لا تحيط بها عباره",72,"ر",2,0],["فقدس بنور الباطن الحق باطني","وهب لي كشف الباطنات الخفية",73,"ه",1,0],["فقد ساقها ذو الغي نحوك للهُدىَ","يقلب كفيه بخيط مُوصَّلِ",74,"ل",1,0],["فقَد ساءَني هجرانُها وجفاؤُها","وقد شَفَّني الوجدُ المُبَرِّحُ حينَئِذ",75,"ذ",1,0],["فقد سكتت دون الهوى ألسن النهى","كما حط عن إدراكه الزكن العالي",76,"ل",2,0],["فقد سنّ الختان لنا ووصّى","به من جملة الفطرِ الحسان",77,"ن",1,0],["فقد سددناه وارتدت غواديه","حسرى ولم نأل أحكاما واتقانا",78,"ن",2,0],["فَقَد سئمتُ مداجاتِي بَني زَمَنٍ","ما منهمُ غيرُ جافي الطَّبعِ قتّاتِ",79,"ت",1,0],["فَقَد سَمِنَت حَتّى تَظاهَرَ نَيُّها","فَلَيسَ عَلَيها لِلروادِفِ محمَلُ",80,"ل",1,0],["فقُدسي كان في وقتي","ورِجسي كان في أمسي",81,"س",2,0],["فقد سمع المختار شعر صحابه","وتشبيهم من غير تعيين خرّد",82,"د",1,0],["فقد سمعتَ كُثيراً عصرَ صبوته","يَهْذي بعزّةَ لم يمللْ ولم يَمِل",83,"ل",1,0],["فقد سكرتُ وما الصهباءُ دائرة","فيها ولا نَغَمات العودِ في أُذني",84,"ن",2,0],["فَقَد سَدَّ السَبيلَ أَبو حُمَيدٍ","كَما سَدَّ المُخاطَبَةَ اِبنُ بيضِ",85,"ض",1,0],["فقد سرحت لما غدوت مسرحا","قلوب وافكار وسمع ومنطق",86,"ق",1,0],["فقد سلقوا بألسنة حداد","حبيبي وادعوا ما ليس فيه",87,"ي",2,0],["فَقَد سَجَدَ المَلائِكُ حينَ أَربَى","عَليهِم آدمٌ بالعِلمِ فادرِ",88,"ر",1,0],["فَقُدِّس من عالِم عامل","أَثارَ لشجوي لَمّا ذَهَب",89,"ب",1,0],["فقد سمحت لنا الدنيا وأبدت","لياليها محيا الدهر أبلج",90,"ج",1,0],["فقد سال من أجله مدمعي","وسائل دمعي فلا تنهَر",91,"ر",1,0],["فَقَد سَعدت كُل الجِهات بِأَسعَد","وَطابَت بِهِ وَالعُرف مِن ذَلِكَ الند",92,"د",1,0],["فقد سعدنا بزمان به","سلطان عدل نتولاه",93,"ا",2,0],["فقد سلبوا عزها والفخار","واستعبدوا أهلها المالكينا",94,"ن",2,0],["فَقَد سُفِكَت دِماؤُهُم وَطُلَّت","وَلَيسَ لَنا دَمٌ يَوماً يُطَلُّ",95,"ل",1,0],["فقد سمتنى الهجران حتى اذقتني","عقوبة زلاتي وسوء مناقبي",96,"ب",2,0],["فقد سألتك حتى","مللت طول سؤالك",97,"ك",1,0],["فقد سدت نظماً على من جاء قبلك أو","يجيء بعدك والقف كلما سحروا",98,"ر",3,0],["فقد سودت أوجه العاديات","وكسرن للدين جسماً صحيحا",99,"ح",2,0],["فَقَد سَئمت المَقام في بَلَد","أَضاعَ حَق الأَديب وَالأَدبا",100,"ب",2,0],["فَقدِّس القدسَ من خباثٍ","أرجاس كفر غُتم أراذل",101,"ل",1,0],["فقد سروا واستصحبوا ناظري","واليوم يهفو ناظري كي يراك",102,"ك",1,0],["فقد ستروا وما عدموا ولكن","مسيئ الظن فيهم لا يراهم",103,"م",1,0],["فقد سئمتُ الحياةَ بينَهما","وأبدلاني من صَفوِه