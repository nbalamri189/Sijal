"مجزوء الرجز"],[390,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[397,"خوضوا البحار","https://www.aldiwan.net/poem6728.html","عموديه"],[399,"غير مستنكر من الأيام","https://www.aldiwan.net/poem46973.html","الخفيف"],[413,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[413,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[426,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[429,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[429,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[436,"اسعد كما سعدت بك الأيام","https://www.aldiwan.net/poem34855.html","الكامل"],[436,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[453,"لقد علمت وما الإسراف من خلقي","https://www.aldiwan.net/poem26637.html","البسيط"],[456,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[475,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[475,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[477,"سعيا لأجلك في الرعيل المهتدي","https://www.aldiwan.net/poem36956.html","الكامل"],[477,"أصبحت للناس كلي","https://www.aldiwan.net/poem37576.html","المجتث"],[484,"قالت ولم تقصد لقول الخنا","https://www.aldiwan.net/poem479.html",""],[498,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[498,"يا رب بكل بارز غيبي","https://www.aldiwan.net/poem37706.html","الدوبيت"],[498,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[498,"ما للفؤاد بكم طرق","https://www.aldiwan.net/poem37946.html","مجزوء الكامل"],[549,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[549,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[565,"أسعداني يا مقلتي ونوحا","https://www.aldiwan.net/poem69744.html","الخفيف"],[571,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[573,"أسعداني فقد مضت ساعتان","https://www.aldiwan.net/poem2716.html","الخفيف"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["أَسعى عَلى أَثَرِ النَوائِبِ مُنصِفاً","مِنها وَآسي كُلَّ عِرقٍ ناغِرِ",0,"ر",1,0],["أَسعى لِقَومٍ قَعَدوا في العُلى","ما أَكثَرَ الساعي إِلى القاعِدِ",1,"د",1,0],["أَسعى فَيَأخُذُني اللَهيبُ فَأَنثَني","فَيَصُدُّني مُتَدَفِّقُ التَيّارِ",2,"ر",1,0],["أَسعى لِأَطلُبَهُ وَالرِزقُ يُطلِبُني","وَالرِزقُ أَكثَرُ لي مِنّي لَهُ طَلَبا",3,"ب",2,0],["أَسعى عَلى جُلِّ قَومٍ كانَ سَعيُهُمُ","وَسطَ العَشيرَةِ سَهواً غَيرَ دَعداعِ",4,"ع",1,0],["أسعد بها يا قمرِي برْزَةً","سعيدة الطَّالع والغارب",5,"ب",1,1],["أسعى لأبوابه العليا يبشّرني","بشيرها بنجاحِ القصدِ والأمل",6,"ل",1,0],["أسعى على درر المعنى بأبحرها","وسعيُ غيريَ في مستفعلن فعل",7,"ل",1,0],["أسعى على شغلٍ وأترك خلوةً","فأعود لا علمي ولا أعمالي",8,"ي",1,0],["أسعد الدين والدنيا بقطف","على من كنت تغمر بالنوال",9,"ل",1,1],["أسعدُ بالحلم من المشتري","وبالحجى والعلم من هِرْمس",10,"س",1,0],["أُسعفن بالملك عفواً فائتلين معاً","أن لا يرى طالب منهنَّ إسعافا",11,"ف",2,0],["اسْعَدْ بها كسعودِها بك إنها","ظفرتْ بما فوق المطالبِ والهِمَمْ",12,"م",1,0],["اسْعَدْ بعيد أخي نُسْكٍ وإسلامِ","وعيدِ لهوٍ طليق الوجهِ بسَّامِ",13,"م",1,1],["أَسَعياً إِلى نَجرانَ في شَهرِ ناجِرٍ","حُفاةً وَأَعيا كُلُّ أَعيَسَ مِسفَرِ",14,"ر",1,0],["أَسعِدنَهُ فَعَسى يَخُفُّ وُلوعُهُ","إِنَّ الشَجِيَّ أَحَقُّ بِالإِسعادِ",15,"د",1,0],["أَسعى وَما مِن غايَةٍ أَسعى لَها","سَعيِ إِلى أَمَلٍ مِنَ الآمالِ",16,"ل",1,0],["أَسَعيدُ إِنَّكَ في قُرَيشٍ كُلِّها","شَرَفُ السَنامِ وَمَوضِعُ القَلبِ",17,"ب",1,0],["أسعد بأرواح نجون من الردى","فطلعن في عرض السماء كأنجم",18,"م",1,0],["اسعى الى سعدي في خارجي","وانما سعدي في نفسي",19,"ي",1,0],["اسعد بام سافر","لقضاء حاجتها تسير",20,"ر",1,0],["أسعى لأجمعَ شملَ أهلِ مدينتي","يا خيبة المسعى إذا لم أنجحِ",21,"ح",1,1],["اِسعَدْ بيومٍ قد أتاكَ مبكِّرا","بصعودِ جَدِّكَ في العَلاءِ مبشِّرَا",22,"ر",2,1],["أَسعَدتَ في كُلِّ الأُمورِ جُدودَهُم","إِذ كُنتَ لِلأَحرارِ غَيرَ مُساعِدِ",23,"د",1,0],["إِسعَد أَميرَ المُؤمِنينَ بِدَولَةٍ","تَغدو عَلَيكَ بِكُلِّ حَظٍّ مُنفِسِ",24,"س",1,0],["أَسَعيدُ ما العَلياءُ إِلّا ما بَنى","لَكَ أَوَّلٌ أَبناءُ أُمِّ أُناسِ",25,"س",1,0],["أَسعِدا الغَيثَ إِذ بَكاها وَإِن كا","نَ خَلِيّاً مِن كُلِّ ما تَجِدانِ",26,"ن",1,0],["إسْعَدْ بعيدِك والقَ ما تَهوى به","وليَلْقَ مَنْ عاداكَ خَطْباً مُوبِقا",27,"ق",2,0],["أسعيدُ هل لكَ في زيارةِ مَنزلٍ","تُثْنِي عليه جَوانحُ الزُّوَّارِ",28,"ر",1,1],["أَسعيدُ إنَّك لو بَصُرْتَ بهاشمٍ","في العُمرِ غيرَ مُبجَّلِ الأصحابِ",29,"ب",1,0],["أَسعَطُكَ اليَومَ زُعافاً مُرّاً","لا تَحسَبَنّي يا اِبنَ عاصٍ غَرّا",30,"ر",2,0],["أَسعِداني بِالدَمعِ يا عَينَيّا","أَسعِداني عَلَيهِ ما دُمتُ حَيّا",31,"ي",2,1],["أَسعِد بِنَيلِكَ لِلعُلى","وَتَهَنَّ بِالعيدِ السَعيدِ",32,"د",1,0],["أسعد الأيام يوم ضمني","بك في دار كأفق الشهب",33,"ب",1,0],["أسُعادُ إنّ كمالَ خَلْقِكِ رَاعَني","فرَأيْتُ بدرَ التمّ عَنْهُ ناقِصا",34,"ص",2,1],["أَسْعِفْ فَمِي يُطْلِعْكَ حُرّاً ناطِفَاً","عَسَلاً، وليسَ مُدَاهِنَاً مَعْسُولا",35,"ل",2,0],["أَسعَرتَ نَفسَكَ حُبَّ هِندٍ فَالهَوى","حَتّى تَلَبَّسَ فَوقَهُ أَكفانُه",36,"ن",2,0],["أَسُعَيدَ ما ماءُ الفُراتِ وَطيبُهُ","مِنّا عَلى ظَمَإٍ وَفَقدِ شَرابِ",37,"ب",1,0],["أَسعِدِ الوَجدَ بِدَمعٍ وَكَفا","لا تَقُل لِلدَمعِ حَسبي وَكفى",38,"ف",2,1],["أسعديني بزورةٍ أو عِديني","طال عهدي بلوعتي وحنيني",39,"ي",1,1],["أَسَعيدٌ سَعادَةً أَنا أَرجو","أَم مُهانٌ بِما كَسَبتُ شَقيّا",40,"ي",2,0],["أَسعِديني عَلى الزَمانِ عَريبٌ","إِنَّما يُسعِدُ الغَريبُ الغَريبا",41,"ب",2,0],["أَسعَدُ يَومٍ لَها حَظيتُ بِهِ","مَقالُها لي وَلَستُ بِالناسي",42,"ي",1,0],["أَسُعادُ جودي لا شُفيتُ سُعادا","وَصِلي بِوُدِّكِ هائِماً مُعتادا",43,"د",2,1],["أَسعِد بِلا مِنٍّ فَإِنَّ","الجَودَ بِالنُعمى سُعودُ",44,"د",1,0],["أَسعَدُ المُشتَري أَوحَ","شَ مِن عِزِّكَ مَأنوسَك",45,"ك",1,0],["أسْعِدْ أُخَيَّ وغَنني بحديثه","وانْثُر على سَمْعي حِلاهُ وشَنِّف",46,"ف",1,0],["أَسعداً وسعدٌ قلب مصر جميعها","لَقَد جرحوا من مصر في جرحه القلبا",47,"ب",2,0],["أَسعاد أَنت مريضة وأَخاف أن","تزداد فيك من الأسى الأوصاب",48,"ب",1,0],["أسعيد هذا الجمال فأشقى ال","عالمين الحيوان ثم النبات",49,"ت",1,0],["إسعادُ ملهوفٍ ونجدةُ غارقٍ","وعناقُ أحبابٍ وعَودُ مسافر",50,"ر",1,0],["أسعى إِليه بكل ما جمعتْ يدي","وبكل ما ضُمّتْ عليه جوانحي",51,"ح",2,0],["أَسْعَى لَهَا وَهْيَ مِنِّي غَيْرُ دَانِيَةٍ","وَكَيْفَ يَبْلُغُ شَأْوَ الْكَوْكَبِ السَّاعِي",52,"ي",1,0],["أَسْعِفِينِي يَا أُخَيَّاتِ الهَوَى","العُذْرِيِّ فِي أَمْرِي",53,"ر",2,0],["أَسْعَدَهُ الرَّأْيُ بِهَا حَيْثُ لاَ","تُسْعِدُهُ بِيضٌ وَلاَ سُمْرُ",54,"ر",1,0],["أَسْعِدي يَا هَوَاتِفَ الأَيْكِ شَجوي","أَنا فِي حَاجَةٍ إِلَى الإِسْعَاد",55,"د",1,0],["أَسْعِدْ بِلُبْنَانَ مَشُوقاً أَنْ يَرى","جَنَّاتِ مِصْرَ تَزُورُهُ وَالنِّيلاَ",56,"ل",2,1],["أَسْعَدُ الأَقْوَامِ قَوْمٌ عِنْدَهُمْ","رَسَخَ الْحَقُّ وَأَجْلَى الافْتِئَاتُ",57,"ت",1,0],["أَسعى لِكُلِّ عَظيمَةٍ فَأَنالُها","عَزماً يَفوتُ هَواجِسَ الحُسّادِ",58,"د",1,0],["أَسعِد أَباكَ بِرَحمةٍ وَاِشفَع لَهُ","يَرحَمهُ رَبُّ العِزَّةِ القدّوسُ",59,"س",1,0],["أَسعَدَ اللَهُ بِكَ المَفجوعِ إِن","ذَنبُهُ أَشقاهُ في اليَوم الأَشَق",60,"ق",1,0],["أَسْعَدُوا شَعْبَهُمْ فَكَانُوا سَحَاباً","وَحَمْوا عَرْشَهُمْ فَكَانُوا أُسُودا",61,"د",2,0],["أَسعفي بالمال شعْبًا آبقًا","لفظتْهُ أرضُهُ لفظَ النواةْ",62,"ا",2,0],["أَسْعِفُوا هذه الفيافيَ بالما","ءِ، وَرَوُّوا أكبادَها الظامئات",63,"ت",1,0],["أسعف الإنسان في الحرث ولا","أتوانى عند حصد السنبل",64,"ل",1,0],["أُسْعِدَ الغَيْثُ إذْ بَكَاها وإنْ كَانَ","خَلِيّاً مِنْ كُلّ مَا تَجِدَانِ",65,"ن",1,0],["أسعى وما غاية أسعى لها","سعيي إلى أمل من الآمال",66,"ل",1,0],["اسعفتني حين سحت فجرت","عن جفوني احسن الله جزاها",67,"ا",3,0],["أسعدَ الله جدَّه حيث ما كان","من الأرضِ فهو من سُعدائه",68,"ا",3,0],["أَسَعدَةُ هَل إِلَيكِ لَنا سَبيلٌ","وَهَل حَتّى القِيامَةِ مِن تَلاقي",69,"ق",2,1],["أسعد أخاك بدعوة","تسقي ثراه بوبلها",70,"ل",3,0],["أسعى لأسعدَ بالوصالِ وحقَّ لي","إنَّ السعادةَ في وصالِ سُعادِ",71,"د",1,0],["أَسعدٌ رافعٌ عبادةُ عبد ال","لَه سَعدٌ ومنذرٌ والبراءُ",72,"ا",2,0],["أسعفيني به قلست بقنّاص","فاصطاده وبلي أوامي",73,"ي",1,0],["اسعفيني به لأرثي رفيقا","غيّبوه تحت الحصا والرغام",73,"م",1,0],["أسعِدي اللوامَ أشقيني فها","كان ما شاؤوا وزيديني جوى",74,"ج",3,0],["اسعى لنجو بابكم","بطاقتي وجهدي",75,"د",2,0],["أَسعَدُ الناسِ نَحنُ فَليَصفَحِ","الحُبُّ بِنا وَليَكُن لَهم غفرانا",76,"ن",2,0],["أَسْعدَكَ اللهُ بِالْوَلَدْ","يَا أَيُّهَا السَّيِّدُ السَّنَدْ",77,"د",1,1],["أسعداني قبل حين","ثم سَهْواً سلّمَاني",78,"ن",2,0],["أسعفي يا ذات ربّي بالمُنى","وارأفي بالعبد قد طال العنا",79,"ن",2,1],["أسْعَدُ الأملاك جَدّاً لا يَني","أو يَفوتَ النيرات الزُّهُرا",80,"ر",2,0],["أسعد به من باهر المَصاعِد","سُلالة الخَضارِم الأجاوِد",81,"د",1,0],["أَسْعَدَ اللهُ بِالْمَسِيرِ وَأَعْطى","فِيهِ عَزْمَ الْوَزِيرِ نَجْحاً وَنَصْرا",82,"ر",2,1],["أَسعى إِلَيهِ مُؤَمِّلاً فَأَعودُ عَن","هُ مُمَوَّلاً خَصبَ الجنابِ أُؤَمَّلُ",83,"ل",1,0],["أَسعِف وَأَنصِف وجُد وَأَحسِن","إِلَيَّ فَضلاً فَما أَساتُ",84,"ت",1,0],["أَسعَدُ أَسعِدني عَلى دَهرٍ غَدا","عَدوَّ كُلِّ فاضِلٍ بِلا سَبَب",85,"ب",1,0],["أَسعدكَ اللّه بِهذا المسا","وَحزتَ عزّاً يطأُ الأرؤُسا",86,"س",2,1],["أسعد بِبَالِ امرِئ يُمسي عَلَى ثِقَةٍ","أنَّ الَّذِي خَلَقَ الأرزاقَ يَرزُقُهُ",87,"ق",2,1],["أسعد بمولود أتاك مباركا","كالبدر أشرق جنح ليل مقمر",88,"ر",1,1],["أسعديني في مأتم الحب والقل","ب إذا ما أردت أن تسعديني",89,"ي",1,0],["اِسعَد بِمالِكَ في الحَياةِ فَإِنَّما","يَبقى خِلافكَ مُصلِحٌ أَو مُفسِدُ",90,"د",1,1],["أَسعى وَرزق اللَهِ لَيسَ يَفوتني","وَالرزقُ عِند تَزاحم الأَقدامِ",91,"م",1,0],["إسْعَدْ بجَدِّ الزّمان أنت غُرّتُه","بأيِّ حَظٍّ كبيرٍ منْك قد حَظيا",92,"ي",2,0],["أسْعِداني في الحُبِّ ما تعْلَمانِ","وقِفا لي فقد بَدا العَلَمانِ",93,"ن",1,1],["أَسعَدُ النّاسِ أَسعَدٌ والذّي يَرْ","جوهُ فانقَعْ به غليلَكَ نَقْعه",94,"ع",2,0],["أَسعَى ليَرعَى آخَرونَ وما سعَوْا","قُلْ للّيالي ما بدا لكِ فاصْنَعي",95,"ع",2,0],["أسعَى وَقَد أبصَرتَني","هل فيَّ للسَّعي استِطاعَه",96,"ع",2,0],["إسعافُ موكبِ رهبانٍ وقد نَهضوا","ليلاً لناقوسهم والحينُ قد حانا",97,"ن",2,0],["أسعِدْ بمن أضحى ذميماً مُهمَلاً","في اللَه لا يشكو ولا يَتقنَّطُ",98,"ط",1,1],["اسعَد بحسنِ أب