{"poems":[[57,"زن من وزنك بما وزنك","https://www.aldiwan.net/poem24623.html","مجزوء الكامل"],[73,"قد بعثناه ينفع الأعضاء","https://www.aldiwan.net/poem11983.html","الخفيف"],[88,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[72,"أواه من جائرة جاره","https://www.aldiwan.net/poem18725.html","السريع"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[72,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[72,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[51,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"منظر فاتن وتحجب عنا","https://www.aldiwan.net/poem64092.html","الخفيف"],[51,"من ظن أن البغاء يخطئ من","https://www.aldiwan.net/poem64529.html","المنسرح"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"ذكر الأخفش القديم فقلنا","https://www.aldiwan.net/poem65885.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[85,"من ظن بعدك أن يقول رثاء","https://www.aldiwan.net/poem62941.html","الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[61,"أقبل كالذود رعت شوارده","https://www.aldiwan.net/poem51723.html","الرجز"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[58,"أغن عن المخلوق بالخالق","https://www.aldiwan.net/poem30955.html","السريع"],[49,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[49,"أغض عن المرء وعما لديه","https://www.aldiwan.net/poem63181.html","السريع"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"لا عبد يغني عنه ولا ولد","https://www.aldiwan.net/poem40130.html","المنسرح"],[97,"حبذا الريف والخلائق فيه","https://www.aldiwan.net/poem24602.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[87,"من ظنني موضعاً يوماً لحاجته","https://www.aldiwan.net/poem8349.html","البسيط"],[31,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[76,"منظومة هذب ألفاظها","https://www.aldiwan.net/poem38847.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85417","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24159","الطويل"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[57,"زن من وزنك بما وزنك","https://www.poetsgate.com/ViewPoem.aspx?id=3275",""],[51,"من ظن أن الاستزادة في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=27818",""],[51,"يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25883",""],[31,"إعْتادني، بَعْدَ سَلْوَة ٍ، حَزَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19111&r=&rc=373",""],[158,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[158,"اسكنوها بسلام آمنينا","https://www.aldiwan.net/poem58828.html","الطويل"],[158,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[162,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[191,"تفرق الناس في أرزاقهم فرقا","https://www.aldiwan.net/poem13054.html","البسيط"],[191,"يا من غدا في الجمع يتعب نفسه","https://www.aldiwan.net/poem13071.html","الكامل"],[208,"قدوم به ربع الأحبة مشرق","https://www.aldiwan.net/poem13317.html","الطويل"],[209,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[219,"ذهب اليوم وقد آن الغروب","https://www.aldiwan.net/poem55262.html","الرمل"],[227,"خفقان قلبي ممرض","https://www.aldiwan.net/poem50969.html","مجزوء الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[233,"وغزال علقته","https://www.aldiwan.net/poem32145.html","مجزوء الخفيف"],[250,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[259,"قد أحرز السبق مولانا الحريزي","https://www.aldiwan.net/poem38108.html","البسيط"],[278,"كم ذا التجنب والتجني","https://www.aldiwan.net/poem60735.html","مجزوء الكامل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"منظومة شرفت بمدح المصطفى","https://www.aldiwan.net/poem56464.html","الكامل"],[307,"إغن عن المخلوق بالخالق","https://www.aldiwan.net/poem50271.html","السريع"],[318,"لا يغرنك منظر لبغاة","https://www.aldiwan.net/poem61738.html","الخفيف"],[336,"من ظن بالله خيرا جاد مبتدئا","https://www.aldiwan.net/poem68671.html","البسيط"],[346,"من ظن أن السيف يغمد صارما","https://www.aldiwan.net/poem20416.html","الكامل"],[362,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[362,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[362,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[400,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[400,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[402,"من ظن أن العلا بالمال يجمعه","https://www.aldiwan.net/poem49607.html","البسيط"],[402,"الحر في التحقيق معتق ذاته","https://www.aldiwan.net/poem50036.html","الكامل"],[406,"يا ساكني جنة رضوان خازنها","https://www.aldiwan.net/poem32228.html","البسيط"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[413,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[426,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[429,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[429,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[451,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[451,"من مبلغ وطني الحبيب تلهفي","https://www.aldiwan.net/poem61734.html","الكامل"],[513,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[513,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[513,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[527,"يا رب زدني نعما","https://www.aldiwan.net/poem37161.html","مجزوء الرجز"],[527,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[560,"شوق يهيج وقلب طالما خفقا","https://www.aldiwan.net/poem52893.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مَن ظَنَّ أَنَّكَ دونَهُ","فَاِترُك هَواهُ إِذَن وَهِنهُ",0,"ن",2,0],["مَنظَرٌ يُبهِجَ القُلوبَ وَطَعمٌ","تَشكُرُ النَفسُ عَهدُهُ اِستِمراءَ",1,"ا",2,0],["منظر يترك الجوانح منّا","في هياج من الهوى وهيام",2,"م",1,0],["منظرة ما بين زهر الدّجى","أخبارها في الفضلِ طيَّاره",3,"ر",2,0],["منظم طاب حتَّى تمّ مفخره","فكم إلى طيّب يعزى وتمّام",4,"م",1,0],["منظمةً من كلِّ بيتٍ كأنَّه","لإفراط ما ضمَّ الولا بيت سلمان",5,"ن",1,0],["منظمة من كلِّ بيت بودّكم","ففي كلِّ بيت للموالاة سلمان",6,"ن",1,0],["منظومة الأسلاك في عليا فتى","عانٍ بحبِّ المكرمات مدله",7,"ه",1,0],["منظومة الأوساط بالسلاحِ","من كلِّ سهمٍ رجل النجاح",8,"ح",1,0],["منظرٌ يملأ القلوبَ مع الأب","صارِ نُوراً ويَضْرحُ الأقذاءَ",9,"ا",2,0],["من ظباءِ الأنيس تلك اللواتي","تترك الطالبين في أنصابِ",10,"ب",1,0],["منظرُهُ في العين مثلُ القذى","أعيا علاجَ الحُوَّلِ القُلَّبِ",11,"ب",1,0],["منظرٌ مُعجِبٌ تحيَّةَ أنف","ريحها ريح طيِّب الأولادِ",12,"د",1,0],["من ظباء غير نافرةٍ","غايةٍ في الحسن والغَيَدِ",13,"د",1,0],["مَنْظَرٌ مَسْمَعٌ مَعانٌ من اللَّهْ","وِ عَتادٌ لما نُحبُّ عَتيدُ",14,"د",1,0],["منظرٌ لا يسأل النْا","ظر جوداً باغتفار",15,"ر",1,0],["منظر فاتن وتُحجَب عنّا","بين أثناء درعها مَحبورا",16,"ر",2,1],["من ظن أن البغاء يخطِئُ من","واجَرَ فاعدُدْه أعجزَ العَجَزَهْ",17,"ه",1,1],["منظر لا يروق عي","ناً وإن كان يطرُف",18,"ف",1,0],["منظريٌّ لناظرٍ مَخْبَريُّ","لمُريغٍ لديك نقضاً وفتلا",19,"ل",2,0],["منظرٌ معجِبٌ من الحسنِ حالٍ","تحته مخبرٌ من الفضلِ حالي",20,"ل",2,0],["مَن ظَنَّ بَعدَكَ أَن يَقولَ رِثاءَ","فَليَرثِ مِن هَذا الوَرى مَن شاءَ",21,"ا",2,1],["مُنَظَّمَةٌ مِن حَولِهِ بَيدَ أَنَّها","تَوَدُّ لَوِ اِنشَقَّ الثَرى فَتُغَيَّبُ",22,"ب",1,0],["منظومةٌ من شُكرِه قلائِدهُ","يَحمَدُهُ وَلِيُّهُ وحاسِدُه",23,"د",2,0],["مَنظرُ حربٍ ما لها مَخْبَرٌ","سلاحُها بالدَّمِ مخَضوبُ",24,"ب",1,0],["مَن ظَنَّ أَن الرِزقَ في كَفِّهِ","فَلَيسَ بِالرَحمَنِ بِالواثِقِ",25,"ق",1,0],["مَن ظَلَمَ الناسَ أَسا","مَن رَحِمَ الناسَ رُحِم",26,"م",1,0],["مَن ظَنَّ بي الرَغبَةَ في شَيإِهِ","باعَدَني مِنهُ دُنُوّي إِلَيه",27,"ي",2,0],["مَنظَرُ الصَومِ مَع تَوَخّيهِ عِندي","مَنظَرُ الشَيبِ في عُيونِ الغَواني",28,"ن",2,0],["مَنظَرُهُ صالِحٌ وَمَخبَرُهُ","فَالبَدرُ في بُردَتَيهِ وَالأَسَدُ",29,"د",1,0],["منظر تلمح البساطة فيه","وترى طيبةً وبشراً وطهرا",30,"ر",2,0],["منظرٌ تلمح السعادة فيه","لا تقل لي أرى شقاء وفقرا",30,"ر",2,0],["من ظَبيةٍ تنفرُ من ظِلّها","وإن غدا الظلّ عليها وراح",31,"ح",1,0],["مُنَظَّمَةً بِالمَوتِ يَحظى بِحَليِها","مُقَلِّدُها في الناسِ دونَ المُقَلَّدِ",32,"د",1,0],["مَنْ ظَنَّنِي مَوْضِعَاً يَوْماً لِحَاجَتِهِ","كُنْتُ الْحَرِيَّ بِأَنْ أُعْطِيهِ مَا سَأَلا",33,"ل",2,1],["مِن ظَبيَةٍ بِالعَقيقِ ساكِنَةٍ","قَد شَفَّني حُبُّها وَعَذَّبَني",34,"ن",2,0],["مَنظومةٌ هُذِّبَ ألفاظُها","ليستْ منَ الشِّعرِ الحجازيِّ",35,"ي",1,1],["منظراً راق حسنه غير أني","كل يوم أَراه بالتكرار",36,"ر",1,0],["مَنْظَرٌ يَفْتِنُ الْعُقُولَ وَيَجْلُو","صَفَحَاتِ الْقُلُوبِ وَالأَبْصَارِ",37,"ر",1,0],["مَنْظَرُ لَهْوٍ تُعِيدُ بَهْجَتُهُ","أَكِنَّةَ الْعَيْشِ وَهْيَ مُنْحَسِرَهْ",38,"ر",2,0],["مَنْ ظَنَّ خِلْوَتَكَ الأَمِينَةَ حَوْمَةً","فِيهَا تُلاَقِي مَصْرِعَ الْمُسْتَشْهِدِ",39,"د",1,0],["مَنْ ظَنَّ أَنَّ الرَّياحينَ الَّتي سُقِيَتْ","دُمُوعَنا الحُمْرَ قَدْ ضَنَّتْ برَيَّاها",40,"ا",3,0],["من ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشقِ",41,"ق",1,1],["منظرٌ للحقولِ إذ تُشرقُ الشمسُ","جميلٌ وإذ يَحيِنُ الغروب",42,"ب",1,0],["منظرٌ يبعثُ الفراهة والأنسَ لقلبِ","الفلاّح حين يئوب",42,"ب",1,0],["من ظن انك دونه","فاترك هواه إذا وهنه",43,"ن",2,0],["من ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",44,"د",1,1],["مَنْظَرٌ، مَسْمَعٌ، مَعانٌ، من الله","وعتادٌ لما يُحَبّ عتيد",45,"د",1,0],["مِنْ ظَبْيَة ٍ بِکلعَقِيقِ سَاكِنَة ٍ","قد شفني حبها وعذبني",46,"ن",2,0],["من ظنّ بحراً لا يجاوز كعبه","فبحمقهِ الأمثال مثلك تضربُ",47,"ب",1,0],["منظر باهٍ وبهوٌ ناظرٌ","وعقود تزدرى العقد الثمينا",48,"ن",2,0],["من ظن في أرض الجبال أنه","يطلع في شاطىء البحار تمرا",49,"ر",2,0],["مَن ظَلَمَ الناسَ تَحامَوا ظُلمَهُ","وَعَزَّ عَنهُم جانِباهُ وَاِحتَمى",50,"ا",1,0],["مَن ظَنَّ بِاللَهِ جَوراً في قَضِيَّتِهِ","اِفتَرَّ عَن مَأثَمٍ في الدِينِ أَو عارِ",51,"ر",1,0],["مَن ظَلَّ في التَجميعِ يُنفِقُ عُمرَهُ","فَمَتى يَكونُ بِأَكلِهِ اِستمتاعُه",52,"ع",2,0],["منظمة درا من المدح خالصاً","علينا به يوم الندى تتصدق",53,"ق",1,0],["منظرٌ رائع الجمال رهيبٌ","كاصطخاب الأهواء بين ضلوعي",54,"ي",1,1],["منظر أبدعه مبدعه","جامع من دولة الحسن ضروب",55,"ب",1,0],["مِن ظالمٍ مُتَظلّمٍ","متعرِّض لي مُعْرِضِ",56,"ض",1,0],["مَن ظَلَّ يَجلِدُهُ وَيَلعَنُهُ فَفي","هَذا لَعَمرُكَ أَعظَمُ القُربانِ",57,"ن",1,0],["مَنظومَةٍ نَظمَ السُطورِ يَعومُ بَح","رَ الآلِ