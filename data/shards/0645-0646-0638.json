wan.net/poem51778.html","السريع"],[58,"أغن عن المخلوق بالخالق","https://www.aldiwan.net/poem30955.html","السريع"],[49,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[49,"أغض عن المرء وعما لديه","https://www.aldiwan.net/poem63181.html","السريع"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"لا عبد يغني عنه ولا ولد","https://www.aldiwan.net/poem40130.html","المنسرح"],[97,"حبذا الريف والخلائق فيه","https://www.aldiwan.net/poem24602.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[87,"من ظنني موضعاً يوماً لحاجته","https://www.aldiwan.net/poem8349.html","البسيط"],[31,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[76,"منظومة هذب ألفاظها","https://www.aldiwan.net/poem38847.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85417","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24159","الطويل"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[57,"زن من وزنك بما وزنك","https://www.poetsgate.com/ViewPoem.aspx?id=3275",""],[51,"من ظن أن الاستزادة في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=27818",""],[51,"يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25883",""],[31,"إعْتادني، بَعْدَ سَلْوَة ٍ، حَزَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19111&r=&rc=373",""]],"verses":[["مَن ظَنَّ أَنَّكَ دونَهُ","فَاِترُك هَواهُ إِذَن وَهِنهُ",0,"ن",2,0],["مَنظَرٌ يُبهِجَ القُلوبَ وَطَعمٌ","تَشكُرُ النَفسُ عَهدُهُ اِستِمراءَ",1,"ا",2,0],["منظر يترك الجوانح منّا","في هياج من الهوى وهيام",2,"م",1,0],["منظرة ما بين زهر الدّجى","أخبارها في الفضلِ طيَّاره",3,"ر",2,0],["منظم طاب حتَّى تمّ مفخره","فكم إلى طيّب يعزى وتمّام",4,"م",1,0],["منظمةً من كلِّ بيتٍ كأنَّه","لإفراط ما ضمَّ الولا بيت سلمان",5,"ن",1,0],["منظمة من كلِّ بيت بودّكم","ففي كلِّ بيت للموالاة سلمان",6,"ن",1,0],["منظومة الأسلاك في عليا فتى","عانٍ بحبِّ المكرمات مدله",7,"ه",1,0],["منظومة الأوساط بالسلاحِ","من كلِّ سهمٍ رجل النجاح",8,"ح",1,0],["منظرٌ يملأ القلوبَ مع الأب","صارِ نُوراً ويَضْرحُ الأقذاءَ",9,"ا",2,0],["من ظباءِ الأنيس تلك اللواتي","تترك الطالبين في أنصابِ",10,"ب",1,0],["منظرُهُ في العين مثلُ القذى","أعيا علاجَ الحُوَّلِ القُلَّبِ",11,"ب",1,0],["منظرٌ مُعجِبٌ تحيَّةَ أنف","ريحها ريح طيِّب الأولادِ",12,"د",1,0],["من ظباء غير نافرةٍ","غايةٍ في الحسن والغَيَدِ",13,"د",1,0],["مَنْظَرٌ مَسْمَعٌ مَعانٌ من اللَّهْ","وِ عَتادٌ لما نُحبُّ عَتيدُ",14,"د",1,0],["منظرٌ لا يسأل النْا","ظر جوداً باغتفار",15,"ر",1,0],["منظر فاتن وتُحجَب عنّا","بين أثناء درعها مَحبورا",16,"ر",2,1],["من ظن أن البغاء يخطِئُ من","واجَرَ فاعدُدْه أعجزَ العَجَزَهْ",17,"ه",1,1],["منظر لا يروق عي","ناً وإن كان يطرُف",18,"ف",1,0],["منظريٌّ لناظرٍ مَخْبَريُّ","لمُريغٍ لديك نقضاً وفتلا",19,"ل",2,0],["منظرٌ معجِبٌ من الحسنِ حالٍ","تحته مخبرٌ من الفضلِ حالي",20,"ل",2,0],["مَن ظَنَّ بَعدَكَ أَن يَقولَ رِثاءَ","فَليَرثِ مِن هَذا الوَرى مَن شاءَ",21,"ا",2,1],["مُنَظَّمَةٌ مِن حَولِهِ بَيدَ أَنَّها","تَوَدُّ لَوِ اِنشَقَّ الثَرى فَتُغَيَّبُ",22,"ب",1,0],["منظومةٌ من شُكرِه قلائِدهُ","يَحمَدُهُ وَلِيُّهُ وحاسِدُه",23,"د",2,0],["مَنظرُ حربٍ ما لها مَخْبَرٌ","سلاحُها بالدَّمِ مخَضوبُ",24,"ب",1,0],["مَن ظَنَّ أَن الرِزقَ في كَفِّهِ","فَلَيسَ بِالرَحمَنِ بِالواثِقِ",25,"ق",1,0],["مَن ظَلَمَ الناسَ أَسا","مَن رَحِمَ الناسَ رُحِم",26,"م",1,0],["مَن ظَنَّ بي الرَغبَةَ في شَيإِهِ","باعَدَني مِنهُ دُنُوّي إِلَيه",27,"ي",2,0],["مَنظَرُ الصَومِ مَع تَوَخّيهِ عِندي","مَنظَرُ الشَيبِ في عُيونِ الغَواني",28,"ن",2,0],["مَنظَرُهُ صالِحٌ وَمَخبَرُهُ","فَالبَدرُ في بُردَتَيهِ وَالأَسَدُ",29,"د",1,0],["منظر تلمح البساطة فيه","وترى طيبةً وبشراً وطهرا",30,"ر",2,0],["منظرٌ تلمح السعادة فيه","لا تقل لي أرى شقاء وفقرا",30,"ر",2,0],["من ظَبيةٍ تنفرُ من ظِلّها","وإن غدا الظلّ عليها وراح",31,"ح",1,0],["مُنَظَّمَةً بِالمَوتِ يَحظى بِحَليِها","مُقَلِّدُها في الناسِ دونَ المُقَلَّدِ",32,"د",1,0],["مَنْ ظَنَّنِي مَوْضِعَاً يَوْماً لِحَاجَتِهِ","كُنْتُ الْحَرِيَّ بِأَنْ أُعْطِيهِ مَا سَأَلا",33,"ل",2,1],["مِن ظَبيَةٍ بِالعَقيقِ ساكِنَةٍ","قَد شَفَّني حُبُّها وَعَذَّبَني",34,"ن",2,0],["مَنظومةٌ هُذِّبَ ألفاظُها","ليستْ منَ الشِّعرِ الحجازيِّ",35,"ي",1,1],["منظراً راق حسنه غير أني","كل يوم أَراه بالتكرار",36,"ر",1,0],["مَنْظَرٌ يَفْتِنُ الْعُقُولَ وَيَجْلُو","صَفَحَاتِ الْقُلُوبِ وَالأَبْصَارِ",37,"ر",1,0],["مَنْظَرُ لَهْوٍ تُعِيدُ بَهْجَتُهُ","أَكِنَّةَ الْعَيْشِ وَهْيَ مُنْحَسِرَهْ",38,"ر",2,0],["مَنْ ظَنَّ خِلْوَتَكَ الأَمِينَةَ حَوْمَةً","فِيهَا تُلاَقِي مَصْرِعَ الْمُسْتَشْهِدِ",39,"د",1,0],["مَنْ ظَنَّ أَنَّ الرَّياحينَ الَّتي سُقِيَتْ","دُمُوعَنا الحُمْرَ قَدْ ضَنَّتْ برَيَّاها",40,"ا",3,0],["من ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشقِ",41,"ق",1,1],["منظرٌ للحقولِ إذ تُشرقُ الشمسُ","جميلٌ وإذ يَحيِنُ الغروب",42,"ب",1,0],["منظرٌ يبعثُ الفراهة والأنسَ لقلبِ","الفلاّح حين يئوب",42,"ب",1,0],["من ظن انك دونه","فاترك هواه إذا وهنه",43,"ن",2,0],["من ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",44,"د",1,1],["مَنْظَرٌ، مَسْمَعٌ، مَعانٌ، من الله","وعتادٌ لما يُحَبّ عتيد",45,"د",1,0],["مِنْ ظَبْيَة ٍ بِکلعَقِيقِ سَاكِنَة ٍ","قد شفني حبها وعذبني",46,"ن",2,0]]}