للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[404,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[406,"من ظن أن العلا بالمال يجمعه","https://www.aldiwan.net/poem49607.html","البسيط"],[406,"الحر في التحقيق معتق ذاته","https://www.aldiwan.net/poem50036.html","الكامل"],[410,"يا ساكني جنة رضوان خازنها","https://www.aldiwan.net/poem32228.html","البسيط"],[417,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[417,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[433,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[433,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[454,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[454,"من مبلغ وطني الحبيب تلهفي","https://www.aldiwan.net/poem61734.html","الكامل"],[516,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[516,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[516,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[530,"يا رب زدني نعما","https://www.aldiwan.net/poem37161.html","مجزوء الرجز"],[530,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[563,"شوق يهيج وقلب طالما خفقا","https://www.aldiwan.net/poem52893.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مَن ظَنَّ أَنَّكَ دونَهُ","فَاِترُك هَواهُ إِذَن وَهِنهُ",0,"ن",2,0],["مَنظَرٌ يُبهِجَ القُلوبَ وَطَعمٌ","تَشكُرُ النَفسُ عَهدُهُ اِستِمراءَ",1,"ا",2,0],["منظر يترك الجوانح منّا","في هياج من الهوى وهيام",2,"م",1,0],["منظرة ما بين زهر الدّجى","أخبارها في الفضلِ طيَّاره",3,"ر",2,0],["منظم طاب حتَّى تمّ مفخره","فكم إلى طيّب يعزى وتمّام",4,"م",1,0],["منظمةً من كلِّ بيتٍ كأنَّه","لإفراط ما ضمَّ الولا بيت سلمان",5,"ن",1,0],["منظمة من كلِّ بيت بودّكم","ففي كلِّ بيت للموالاة سلمان",6,"ن",1,0],["منظومة الأسلاك في عليا فتى","عانٍ بحبِّ المكرمات مدله",7,"ه",1,0],["منظومة الأوساط بالسلاحِ","من كلِّ سهمٍ رجل النجاح",8,"ح",1,0],["منظرٌ يملأ القلوبَ مع الأب","صارِ نُوراً ويَضْرحُ الأقذاءَ",9,"ا",2,0],["من ظباءِ الأنيس تلك اللواتي","تترك الطالبين في أنصابِ",10,"ب",1,0],["منظرُهُ في العين مثلُ القذى","أعيا علاجَ الحُوَّلِ القُلَّبِ",11,"ب",1,0],["منظرٌ مُعجِبٌ تحيَّةَ أنف","ريحها ريح طيِّب الأولادِ",12,"د",1,0],["من ظباء غير نافرةٍ","غايةٍ في الحسن والغَيَدِ",13,"د",1,0],["مَنْظَرٌ مَسْمَعٌ مَعانٌ من اللَّهْ","وِ عَتادٌ لما نُحبُّ عَتيدُ",14,"د",1,0],["منظرٌ لا يسأل النْا","ظر جوداً باغتفار",15,"ر",1,0],["منظر فاتن وتُحجَب عنّا","بين أثناء درعها مَحبورا",16,"ر",2,1],["من ظن أن البغاء يخطِئُ من","واجَرَ فاعدُدْه أعجزَ العَجَزَهْ",17,"ه",1,1],["منظر لا يروق عي","ناً وإن كان يطرُف",18,"ف",1,0],["منظريٌّ لناظرٍ مَخْبَريُّ","لمُريغٍ لديك نقضاً وفتلا",19,"ل",2,0],["منظرٌ معجِبٌ من الحسنِ حالٍ","تحته مخبرٌ من الفضلِ حالي",20,"ل",2,0],["مَن ظَنَّ بَعدَكَ أَن يَقولَ رِثاءَ","فَليَرثِ مِن هَذا الوَرى مَن شاءَ",21,"ا",2,1],["مُنَظَّمَةٌ مِن حَولِهِ بَيدَ أَنَّها","تَوَدُّ لَوِ اِنشَقَّ الثَرى فَتُغَيَّبُ",22,"ب",1,0],["منظومةٌ من شُكرِه قلائِدهُ","يَحمَدُهُ وَلِيُّهُ وحاسِدُه",23,"د",2,0],["مَنظرُ حربٍ ما لها مَخْبَرٌ","سلاحُها بالدَّمِ مخَضوبُ",24,"ب",1,0],["مَن ظَنَّ أَن الرِزقَ في كَفِّهِ","فَلَيسَ بِالرَحمَنِ بِالواثِقِ",25,"ق",1,0],["مَن ظَلَمَ الناسَ أَسا","مَن رَحِمَ الناسَ رُحِم",26,"م",1,0],["مَن ظَنَّ بي الرَغبَةَ في شَيإِهِ","باعَدَني مِنهُ دُنُوّي إِلَيه",27,"ي",2,0],["مَنظَرُ الصَومِ مَع تَوَخّيهِ عِندي","مَنظَرُ الشَيبِ في عُيونِ الغَواني",28,"ن",2,0],["مَنظَرُهُ صالِحٌ وَمَخبَرُهُ","فَالبَدرُ في بُردَتَيهِ وَالأَسَدُ",29,"د",1,0],["منظر تلمح البساطة فيه","وترى طيبةً وبشراً وطهرا",30,"ر",2,0],["منظرٌ تلمح السعادة فيه","لا تقل لي أرى شقاء وفقرا",30,"ر",2,0],["من ظَبيةٍ تنفرُ من ظِلّها","وإن غدا الظلّ عليها وراح",31,"ح",1,0],["مُنَظَّمَةً بِالمَوتِ يَحظى بِحَليِها","مُقَلِّدُها في الناسِ دونَ المُقَلَّدِ",32,"د",1,0],["مَنْ ظَنَّنِي مَوْضِعَاً يَوْماً لِحَاجَتِهِ","كُنْتُ الْحَرِيَّ بِأَنْ أُعْطِيهِ مَا سَأَلا",33,"ل",2,1],["مِن ظَبيَةٍ بِالعَقيقِ ساكِنَةٍ","قَد شَفَّني حُبُّها وَعَذَّبَني",34,"ن",2,0],["مَنظومةٌ هُذِّبَ ألفاظُها","ليستْ منَ الشِّعرِ الحجازيِّ",35,"ي",1,1],["منظراً راق حسنه غير أني","كل يوم أَراه بالتكرار",36,"ر",1,0],["مَنْظَرٌ يَفْتِنُ الْعُقُولَ وَيَجْلُو","صَفَحَاتِ الْقُلُوبِ وَالأَبْصَارِ",37,"ر",1,0],["مَنْظَرُ لَهْوٍ تُعِيدُ بَهْجَتُهُ","أَكِنَّةَ الْعَيْشِ وَهْيَ مُنْحَسِرَهْ",38,"ر",2,0],["مَنْ ظَنَّ خِلْوَتَكَ الأَمِينَةَ حَوْمَةً","فِيهَا تُلاَقِي مَصْرِعَ الْمُسْتَشْهِدِ",39,"د",1,0],["مَنْ ظَنَّ أَنَّ الرَّياحينَ الَّتي سُقِيَتْ","دُمُوعَنا الحُمْرَ قَدْ ضَنَّتْ برَيَّاها",40,"ا",3,0],["من ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشقِ",41,"ق",1,1],["منظر أودعه فنّ السما","من فنون الخلد والآيات سرّا",42,"ر",2,0],["منظرٌ للحقولِ إذ تُشرقُ الشمسُ","جميلٌ وإذ يَحيِنُ الغروب",43,"ب",1,0],["منظرٌ يبعثُ الفراهة والأنسَ لقلبِ","الفلاّح حين يئوب",43,"ب",1,0],["من ظن انك دونه","فاترك هواه إذا وهنه",44,"ن",2,0],["من ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",45,"د",1,1],["مَنْظَرٌ، مَسْمَعٌ، مَعانٌ، من الله","وعتادٌ لما يُحَبّ عتيد",46,"د",1,0],["مِنْ ظَبْيَة ٍ بِکلعَقِيقِ سَاكِنَة ٍ","قد شفني حبها وعذبني",47,"ن",2,0],["من ظنّ بحراً لا يجاوز كعبه","فبحمقهِ الأمثال مثلك تضربُ",48,"ب",1,0],["منظر باهٍ وبهوٌ ناظرٌ","وعقود تزدرى العقد الثمينا",49,"ن",2,0],["من ظن في أرض الجبال أنه","يطلع في شاطىء البحار تمرا",50,"ر",2,0],["مَن ظَلَمَ الناسَ تَحامَوا ظُلمَهُ","وَعَزَّ عَنهُم جانِباهُ وَاِحتَمى",51,"ا",1,0],["مَن ظَنَّ بِاللَهِ جَوراً في قَضِيَّتِهِ","اِفتَرَّ عَن مَأثَمٍ في الدِينِ أَو عارِ",52,"ر",1,0],["مَن ظَلَّ في التَجميعِ يُنفِقُ عُمرَهُ","فَمَتى يَكونُ بِأَكلِهِ اِستمتاعُه",53,"ع",2,0],["منظمة درا من المدح خالصاً","علينا به يوم الندى تتصدق",54,"ق",1,0],["منظرٌ رائع الجمال رهيبٌ","كاصطخاب الأهواء بين ضلوعي",55,"ي",1,1],["منظر أبدعه مبدعه","جامع من دولة الحسن ضروب",56,"ب",1,0],["مِن ظالمٍ مُتَظلّمٍ","متعرِّض لي مُعْرِضِ",57,"ض",1,