.com/ViewPoem.aspx?id=24368",""],[4119,"ماذا بأطراف الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=16168",""],[5038,"ليلي سفين","https://www.poetsgate.com/ViewPoem.aspx?id=189954",""],[5038,"أرض العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189955",""],[5102,"حيص بيص","https://www.poetsgate.com/ViewPoem.aspx?id=14095",""],[5125,"الراهب","https://www.poetsgate.com/ViewPoem.aspx?id=188655",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5296,"أماه لا تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=152482",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5409,"خرج الناس يضرعون إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=155246",""],[5413,"اقرأ!","https://www.poetsgate.com/ViewPoem.aspx?id=200618",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5463,"يوم المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=25224",""],[5518,"نور الحياة (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=196535",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[243,"تحية القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50485",""],[5714,"أشذى من الفل","https://www.poetsgate.com/ViewPoem.aspx?id=213798",""],[5736,"لا تشقي الحياة مغالبا","https://www.poetsgate.com/ViewPoem.aspx?id=208193",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6142,"عمد البرق والكؤوس وما امتد","https://www.poetsgate.com/ViewPoem.aspx?id=155690",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6202,"احبس دموعك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86700&r=&rc=1",""],[6202,"بنت قحطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86713&r=&rc=14",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["مَن ظَنَّ أَنَّكَ دونَهُ","فَاِترُك هَواهُ إِذَن وَهِنهُ",0,"ن",2,0],["مَنظَرٌ يُبهِجَ القُلوبَ وَطَعمٌ","تَشكُرُ النَفسُ عَهدُهُ اِستِمراءَ",1,"ا",2,0],["منظر يترك الجوانح منّا","في هياج من الهوى وهيام",2,"م",1,0],["منظرة ما بين زهر الدّجى","أخبارها في الفضلِ طيَّاره",3,"ر",2,0],["منظم طاب حتَّى تمّ مفخره","فكم إلى طيّب يعزى وتمّام",4,"م",1,0],["منظمةً من كلِّ بيتٍ كأنَّه","لإفراط ما ضمَّ الولا بيت سلمان",5,"ن",1,0],["منظمة من كلِّ بيت بودّكم","ففي كلِّ بيت للموالاة سلمان",6,"ن",1,0],["منظومة الأسلاك في عليا فتى","عانٍ بحبِّ المكرمات مدله",7,"ه",1,0],["منظومة الأوساط بالسلاحِ","من كلِّ سهمٍ رجل النجاح",8,"ح",1,0],["منظرٌ يملأ القلوبَ مع الأب","صارِ نُوراً ويَضْرحُ الأقذاءَ",9,"ا",2,0],["من ظباءِ الأنيس تلك اللواتي","تترك الطالبين في أنصابِ",10,"ب",1,0],["منظرُهُ في العين مثلُ القذى","أعيا علاجَ الحُوَّلِ القُلَّبِ",11,"ب",1,0],["منظرٌ مُعجِبٌ تحيَّةَ أنف","ريحها ريح طيِّب الأولادِ",12,"د",1,0],["من ظباء غير نافرةٍ","غايةٍ في الحسن والغَيَدِ",13,"د",1,0],["مَنْظَرٌ مَسْمَعٌ مَعانٌ من اللَّهْ","وِ عَتادٌ لما نُحبُّ عَتيدُ",14,"د",1,0],["منظرٌ لا يسأل النْا","ظر جوداً باغتفار",15,"ر",1,0],["منظر فاتن وتُحجَب عنّا","بين أثناء درعها مَحبورا",16,"ر",2,1],["من ظن أن البغاء يخطِئُ من","واجَرَ فاعدُدْه أعجزَ العَجَزَهْ",17,"ه",1,1],["منظر لا يروق عي","ناً وإن كان يطرُف",18,"ف",1,0],["منظريٌّ لناظرٍ مَخْبَريُّ","لمُريغٍ لديك نقضاً وفتلا",19,"ل",2,0],["منظرٌ معجِبٌ من الحسنِ حالٍ","تحته مخبرٌ من الفضلِ حالي",20,"ل",2,0],["مَن ظَنَّ بَعدَكَ أَن يَقولَ رِثاءَ","فَليَرثِ مِن هَذا الوَرى مَن شاءَ",21,"ا",2,1],["مُنَظَّمَةٌ مِن حَولِهِ بَيدَ أَنَّها","تَوَدُّ لَوِ اِنشَقَّ الثَرى فَتُغَيَّبُ",22,"ب",1,0],["منظومةٌ من شُكرِه قلائِدهُ","يَحمَدُهُ وَلِيُّهُ وحاسِدُه",23,"د",2,0],["مَنظرُ حربٍ ما لها مَخْبَرٌ","سلاحُها بالدَّمِ مخَضوبُ",24,"ب",1,0],["مَن ظَنَّ أَن الرِزقَ في كَفِّهِ","فَلَيسَ بِالرَحمَنِ بِالواثِقِ",25,"ق",1,0],["مَن ظَلَمَ الناسَ أَسا","مَن رَحِمَ الناسَ رُحِم",26,"م",1,0],["مَن ظَنَّ بي الرَغبَةَ في شَيإِهِ","باعَدَني مِنهُ دُنُوّي إِلَيه",27,"ي",2,0],["مَنظَرُ الصَومِ مَع تَوَخّيهِ عِندي","مَنظَرُ الشَيبِ في عُيونِ الغَواني",28,"ن",2,0],["مَنظَرُهُ صالِحٌ وَمَخبَرُهُ","فَالبَدرُ في بُردَتَيهِ وَالأَسَدُ",29,"د",1,0],["منظر تلمح البساطة فيه","وترى طيبةً وبشراً وطهرا",30,"ر",2,0],["منظرٌ تلمح السعادة فيه","لا تقل لي أرى شقاء وفقرا",30,"ر",2,0],["من ظَبيةٍ تنفرُ من ظِلّها","وإن غدا الظلّ عليها وراح",31,"ح",1,0],["مُنَظَّمَةً بِالمَوتِ يَحظى بِحَليِها","مُقَلِّدُها في الناسِ دونَ المُقَلَّدِ",32,"د",1,0],["مَنْ ظَنَّنِي مَوْضِعَاً يَوْماً لِحَاجَتِهِ","كُنْتُ الْحَرِيَّ بِأَنْ أُعْطِيهِ مَا سَأَلا",33,"ل",2,1],["مِن ظَبيَةٍ بِالعَقيقِ ساكِنَةٍ","قَد شَفَّني حُبُّها وَعَذَّبَني",34,"ن",2,0],["مَنظومةٌ هُذِّبَ ألفاظُها","ليستْ منَ الشِّعرِ الحجازيِّ",35,"ي",1,1],["منظراً راق حسنه غير أني","كل يوم أَراه بالتكرار",36,"ر",1,0],["مَنْظَرٌ يَفْتِنُ الْعُقُولَ وَيَجْلُو","صَفَحَاتِ الْقُلُوبِ وَالأَبْصَارِ",37,"ر",1,0],["مَنْظَرُ لَهْوٍ تُعِيدُ بَهْجَتُهُ","أَكِنَّةَ الْعَيْشِ وَهْيَ مُنْحَسِرَهْ",38,"ر",2,0],["مَنْ ظَنَّ خِلْوَتَكَ الأَمِينَةَ حَوْمَةً","فِيهَا تُلاَقِي مَصْرِعَ الْمُسْتَشْهِدِ",39,"د",1,0],["مَنْ ظَنَّ أَنَّ الرَّياحينَ الَّتي سُقِيَتْ","دُمُوعَنا الحُمْرَ قَدْ ضَنَّتْ برَيَّاها",40,"ا",3,0],["من ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشقِ",41,"ق",1,1],["منظمة ألبابهم وسيوفهم","ونياتهم والحق للكل ناظم",42,"م",1,0],["منظر أودعه فنّ السما","من فنون الخلد والآيات سرّا",43,"ر",2,0],["منظرٌ للحقولِ إذ تُشرقُ الشمسُ","جميلٌ وإذ يَحيِنُ الغروب",44,"ب",1,0],["منظرٌ يبعثُ الفراهة والأنسَ لقلبِ","الفلاّح حين يئوب",44,"ب",1,0],["من ظن انك دونه","فاترك هواه إذا وهنه",45,"ن",2,0],["من ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",46,"د",1,1],["مَنْظَرٌ، مَسْمَعٌ، مَعانٌ، من الله","وعتادٌ لما يُحَبّ عتيد",47,"د",1,0],["مِنْ ظَبْيَة ٍ بِکلعَقِيقِ سَاكِنَة ٍ","قد شفني حبها وعذبني",48,"ن",2,0],["من ظنّ بحراً لا يجاوز كعبه","فبحمقهِ الأمثال مثلك تضربُ",49,"ب",1,0],["منظر باهٍ وبهوٌ ناظرٌ","وعقود تزدرى العقد الثمينا",50,"ن",2,0],["من ظن في أرض الجبال أنه","يطلع في شاطىء البحار تمرا",51,"ر",2,0],["مَن ظَلَمَ الناسَ تَحامَوا ظُلمَهُ","وَعَزَّ عَنهُم جانِباهُ وَاِحتَمى",52,"ا",1,0],["مَن ظَنَّ بِاللَهِ جَوراً في قَضِيَّتِهِ","اِفتَرَّ عَن مَأثَمٍ في الدِينِ أَو عارِ",53,"ر",1,0],["مَن ظَلَّ في التَجميعِ يُنفِقُ عُمرَهُ","فَمَتى يَكونُ بِأَكلِهِ اِستمتاعُه",54,"ع",2,0],["منظمة درا من المدح خالصاً","علينا به يوم الندى تتصدق",55,"ق",1,0],["منظرٌ رائع الجمال رهيبٌ","كاصطخاب الأهواء بين ضلوعي",56,"ي",1,1],["منظر أبدعه مبدعه","جامع من دولة الحسن ضروب",57,"ب",1,0],["مِن ظالمٍ مُتَظلّمٍ","متعرِّض لي مُعْرِضِ",58,"ض",1,0],["مَن ظَلَّ يَجلِدُهُ وَيَلعَنُهُ فَفي","هَذا لَعَمرُكَ أَعظَمُ القُربانِ",59,"ن",1,0],["مَنظومَةٍ نَظمَ السُطورِ يَعومُ بَح","رَ الآلِ مِنها رَكبُها بِسَفينِ",60,"ن",1,0],["مِن ظِباءِ الصَريمِ يَخ","طُرُ في زِيِّ راهِبِ",61,"ب",1,0],["مَنظَراً مُذ غِبتَ يُعجِبُها","عَيني وَلا سَمِعَت مُسَحسَناً أُذُني",62,"ن",2,0],["منظومة بنت فكر ان اضاء له","صبح المنى غاله بأس دجوجي",63,"ي",1,0],["مَنْ ظَنَّ أَنْ لا بُدَّ مِنْ","هُ فَإِنَّ مِنْهُ أَلْفَ بُدِّ",64,"د",1,0],["مِن ظاهرِ الصداقَه","بالبِشر والطَلاقَه",65,"ه",1,0],["مَنظومةٌ شَرُفت بمدحِ المُصطفى","وَبِآلهِ أَهلِ المودّةِ وَالصفا",66,"ف",2,1],["مَن ظَنَّ أَنَّ الناسَ يغنونَهُ","فَلَيسَ بِالرَحمَنِ بِالرائِقِ",67,"ق",1,0],["مَنظَرُ النارِ مِن بَعيدٍ جَميلُ","يَتَرآى وَقُربُها إِحراقُ",68,"ق",