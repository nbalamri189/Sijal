oem.aspx?id=182301",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[4442,"بشرى العراق بعيد فطره","https://www.poetsgate.com/ViewPoem.aspx?id=171006",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[186,"إلى معاليك ينمى المجد والحسب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55743&r=&rc=6",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""]],"verses":[["تَعنو المُلوكُ حَولَهُ إِعظاما","نَستَكثِرُ اليَومَ لَهُ القِياما",0,"م",2,0],["تَعنولِأَخمَصِكَ الخُطوبُ ذَليلَةً","بَعدَ العِراكِ وَخَدُّهُنَّ الأَضرَعُ",1,"ع",1,0],["تُعَنِّفُني زَبيبَةُ في المَلامِ","عَلى الإِقدامِ في يَومِ الزَحامِ",2,"م",1,1],["تَعْنى قُلوبُ القوْمِ عنْ هَدْيٍ بِهِ","ودُموعُهُمْ تكْفي لرَمْيِ جِمارِ",3,"ر",1,0],["تُعنِّتُ بالمسواكِ أبيضَ صافياً","تكادُ عذارَى الدرّ منه تَحدَّرُ",4,"ر",1,1],["تُعَنِّفُ القَلبَ عَلى غَيِّهِ","وَتَعذُلُ العَينَ الَّتي لا تُنيب",5,"ب",1,0],["تَعنو لِعِزَّتِهِ الوُجوهُ وَوَجهُهُ","لِلشَمسِ في الآفاقِ عانٍ مُطرِقُ",6,"ق",1,0],["تُعَنّينا مُصاحَبَةُ اللَيالي","وَيُنصِبُنا التَرَوُّحُ وَالبُكورُ",7,"ر",1,0],["تَعنو لَهُ وُزَراءَ المُلكِ خاضِعَةً","وَعادَةُ السَيفِ أَن يَستَخدِمَ القَلَما",8,"م",2,0],["تَعَنّى يا جَريرُ لِغَيرِ شَيءٍ","وَقَد ذَهَبَ القَصائِدُ لِلرُواةِ",9,"ه",1,0],["تَعَنَّ فَلَستَ مُدرِكَ ما تَعَنّى","إِلَيهِ بِساعِدَي جُعَلِ الرَغامِ",10,"م",1,0],["تَعَنّى مِنَ المَرّوتِ يَرجو أَرومَتي","جَريرٌ عَلى أُمِّ الجِحاشِ التَوائِمِ",11,"م",1,0],["تُعَنُّ رياحُهُ حَسرَى ويَجري","جَموحُ المُزْنِ فيه بلا عِنانِ",12,"ن",1,0],["تَعُنُّ لنا في مُشرِقاتِ وُجوهها","إذا هي عنَّت مُظلِماتٍ فروعُها",13,"ع",3,0],["تُعنى بِمَ تُكفى وَتَترُكُ ما بِهِ","توصى كَأَنَّكَ لِلحَوادِثِ آمِنُ",14,"ن",1,0],["تَعنو لشرعة دفع","أحكم بها من شريعه",15,"ع",2,0],["تعنو لأرواح جسا","م لا لأجساد جسام",16,"م",1,0],["تَعْنُو لِسُلْطانِكِ الْجِباهُ","مَرْفُوعَةَ الرَأْسِ والْبُنُودِ",17,"د",1,0],["تعنف أحكام القضاء حماقة","كأن القضاءَ الحتمَ ليس بأحمق",18,"ق",1,0],["تَعنو لِعفتك الزهاد مذعنة","وَيَحسد الفَلك الأَعلى مَعانيكا",19,"ك",2,0],["تَعنو لَهُ أَوجُهُ السَّاداتِ صاغِرَةً","وَيَستَكينُ لَدَيهِ الجَحفلُ اللَّجبُ",20,"ب",1,0],["تُعَنِّفُ أربابَ الهوى مُتْ بِحَسْرةٍ","فذو العِشْقِ عَمَّا فيهِ ليسَ يَحُولُ",21,"ل",1,0],["تَعنو الكَواكِبُ إِجلالاً لِعِزَّتِها","وَتَستَكينُ لَها الأَفلاكُ مِن عِظَمِ",22,"م",1,0],["تَعنو الوُجوهُ لِبَأسِهِ","وَتَلينُ في يَدِهِ الصِعابُ",23,"ب",1,0],["تَعَنّاكَ نَصبٌ مِن أُمَيمَةَ مُنصِبُ","كَذي الشَوقِ لَمّا يَسلُهُ وَسَيَذهَبُ",24,"ب",1,1],["تَعَنّى القَلبَ مِن سَلمى عَناءُ","فَما لِلقَلبِ مُذ بانوا شِفاءُ",25,"ا",2,1],["تَعنُو المعاني لها شتَّى مُزَخرفةً","كما يَزَخرفُ مِن أقواسِهِ قزَح",26,"ح",1,0],["تُعنى بنشرِ ثقافةٍ مختارةٍ","يهوى سناها طيّبٌ أو خيّر",27,"ر",1,0],["تُعَنِّفُهُ الردادِ فِي غَيرِ مَرَّةٍ","وَلا يَنْثَنِي عَنْ بابِهِم ساقِطَ الوَغدِ",28,"د",1,0],["تَعنو لَهُ الصيدُ الصَّناديدُ في ال","رَوعِ اِرتِياعاً كَالرَعاديدِ",29,"د",1,0],["تعنو القلوب إليك قبل وجوهنا","سيان من رأس ومن مرءوس",30,"س",1,0],["تَعنْونَ منه بأُولَى الحُروفِ","كتابٌ لكَ اللهُ قِدْماً رَقَم",31,"م",1,0],["تعنو السماء له والأرض صاغرةً","والعبد يلزم عند السيد الأدب",32,"ب",1,0],["تعنو لهُ الأَقمار وهي طوالعٌ","ويخِرُّ للأَذقان ابنُ ذُكاءِ",33,"ا",2,0],["تَعنو لأبلَجَ طلق فَوقَ غُرَّتِهِ","تاج مِنَ النور يَعلوهُ إِذا سَفَرا",34,"ر",2,0],["تعنّفني فيه اللحاة جهالة","وما أنا لولا أنتِ ممَّن يُعنَّف",35,"ف",1,0],["تعنو الأسودُ لها فإن صدقت","خفقَتْ خصائلُها من الظّلِّ",36,"ل",1,0],["تُعنِّفني في شرب كأسي ضَلالةً","أقِلِّي فبين الأحمرينِ هِلالُ",37,"ل",1,1],["تَعنو بِمَخروتٍ لَهُ ناضِحٌ","ذو رَيِّقٍ يَغذو وَذو شَلشَلِ",38,"ل",1,0],["تعنو الرقاب إذا نطقت كأنما","في كل فصل من كلامك مفصل",39,"ل",1,0],["تعنو الوجوه إذا رأته فيلقتي","خد الثرى ومعاقد التيجان",40,"ن",1,0],["تعنو الرّجال لذي التّمائمِ منهمُ","ويسود طفلُهمُ ولم يَتَرَعْرَعِ",41,"ع",1,0],["تُعنِّفُنِي وَبالُك غيرُ بالي","وَتعذلِني وجأْشُك غيرُ جاشي",42,"ش",2,0],["تعنيفك الغي والطغيان لومك لي","يا ذا النصوح فابشر فزت بالنقم",43,"م",1,0],["تعنُو لهيبتِه الأَملاكُ خاضِعةٌ","فالعُجْم في المدْن والأَعرابُ في الحِلل",44,"ل",1,0],["تعنُو الملوكُ لِوجْهِهِ بوجُوهِها","وتَظَلُّ سادَتُها لَديْه أَعْبُدا",45,"د",2,0],["تعنُو الملوكُ لوجههِ بوجُوهِهَا","لا بل تُساق لِبَابِه بِرِقَابِها",46,"ب",3,0],["تَعنو المَعاني لَدَيهِ وَهيَ صاغِرَةٌ","كَأَنَّها في البَرايا مِن جَواريهِ",47,"ي",2,0],["تُعنى بما تُكفى وتتركُ ما به","تُعنَى كأنّك للحوادِث آمنُ",48,"ن",1,0],["تُعَنِّفُ مَن يُحَبُّ اللَّومُ فيهِ","وَتَعَذُلُ مَن يُنيمُ وَلا يَنامُ",49,"م",1,0],["تُعَنِّفُني وَقَلبُكَ لَيسَ يَصبُو","إلى وَطَنٍ وَعينُك لا تَصُوبُ",50,"ب",1,0],["تُعَنِّفُني بالعُنفِ والرِّفقُ أرفَقُ","وتُرعِدُ لي في مَن أُحِبُّ وتُبرِقُ",51,"ق",1,1],["تَعنُو الملوكُ لَهُ وحُقَّ لها ولل","أحياءِ أن تَعنُو لناهٍ آمِر",52,"ر",1,0],["تَعنو لِهَيبَتِها الأَسنَّة وَالظُّبى","وَيَهابُها العضبُ الصقيلُ الذابِحُ",53,"ح",1,0],["تعنو لهُ اليمن العَبا","هِلُ والغطارفة النزارْ",54,"ر",1,0],["تُعَنّنينا بالشعرِ لما أتيتنا","فدونكَ خُذهُ محكَماً يا أبا حَنَش",55,"ش",1,0],["تُعَنِّفُنِي عَلَى تَركِي بِلاداً","عَهِدتُ بِها الغَرَارَةَ والشَّبَابا",56,"ب",2,0],["تعنو فيطربها","بالسمع وَالبصر",57,"ر",1,0],["تعنا وبالاعتراض تأثم","يا حسرة الآثم العاني",58,"ن",2,0],["تعنُو إليَّ القوافي حين أَذكركمْ","كما تَخرُّ لذكرِ اللهِ أَذْقانُ",59,"ن",1,0],["تعنو الجباه له فمن","فوق الجبين له جبين",60,"ن",1,0],["تعن لها فوق الرماح كواكب","تفيد الدجى للسفر منهن إسفارا",61,"ر",2,0],["تَعنُونَ مَا هُوَ قَائِمٌ بِالنَّفسِ أو","عَالٍ عَلَى العَرشِ العَظِيمِ الشَّانِ",62,"ن",1,0],["تَعنو الوُجوهُ لَهُ وَتَحتَ وِشاحِهِ","لِصٌّ يُغيرُ مَعَ اللُصوصِ وَيقسِمُ",63,"م",1,0],["تعنو الوجوهُ لسفيهِ ولرُمحهِ","بعدَ السُّجود لتاجِه والمِغْفَرِ",64,"ر",1,0],["تعنِّفُ أنْ رأت شأْوي بعيداً","ومن يثني الجواد من الجِماح",65,"ح",1,0],["تعنّفني ولي قلب لجوج","يعاصي الشوق فيه معنفيه",66,"ي",2,0],["تعنفني أمي على أن رثيتها","بشعري وأن أتبعتها الدم من حيني",67,"ن",2,0],["تعنين ويلك أَننى","أمّارةٌ بتبدل",68,"ل",1,0],["تعن لك الوجوه مقسمات","فتفتنك الوجوه بما تعن",69,"ن",1,1],["تعني بكشف السر لكن دونه","حجب لحكمة ربها وستائرُ",70,"ر",1,0],["تَعنو إِلى نوره الوَرى أَبَداً","كَأَنَّما الخلق كلّهم فرسُ",71,"س",1,0],["تعنو الوجوه لشيخنا وَوَليدنا","وَنعيذ أَوجهنا لَها إِن تَعبسا",72,"س",2,0],["تعنعنَ السحب عن عيني روايتها","كما يسلسلُ عنها القَطرُ إذ هَملا",73,"ل",2,0],["تعنو لخِدمتها البريَّةُ اسفلاً","ولها الملائكُ في الأعالي تَخدِمُ",74,"م",1,0],["تَعنو البُدور لغرّةٍ مِنها اِنجَلَت","لَولا البَهاء لقلت ستُّ الأَشمس",75,"س",1,0],["تعنو الخصوم لهم وتجثو سجّدا","مهما تشن الغارة الملحاح",76,"ح",1,0],["تعني بذكر الله في صلواتها","والله لا يخفى عليه مأرب",77,"ب",1,0],["تعنو الوجوه لذكراه وسيرته","وينحنى الراس للتعظيم بالتالي",78,"ل",2,0],["تعنو لهيبته الأبطال واجمة","من بأسه وذوو التيجان تخشاه",79,"ا",2,0],["تعنى غمزت ووجعت وعَرج","إلى السماءِ مَلَك أو في الدرَج",80,"ج",1,0],["تعنى تبلدا فإن قلت ثلج","بفتح ثاء فهو سُرّ وابتهج",81,"ج",1,0],["تعني بذاك ديّة وغُرما","وأمرة مطاعة لسَلمى",82,"م",2,0],["تعني بطيئاً واللقاح مَصدر","مِن لقحت ناقته يا جعفر",82,"ر",1,0],["تعنى فنى ونفقا للمصدر","ونفقت حجر أبي المعمّر",83,"ر",1,0],["تعنى غلطت والخطيب أوهما","لفظا إذا أسقطه مجمجما",83,"م",2,0],["تَعنو الغَزالةُ إِجلالاً لِطلعَتِهِ","وَالاسدُ مِن رهبةٍ تَخشاهُ في القننِ",84,"ن",1,0],["تعنو لسطوتك الولاةُ فَيَغْتَدِي","أمضاهُمُ لسلاك بطشك هائبا",85,"ب",2,0],["تعنو النام له إذا خطت أنا","مله الطروس ولو بخط مجرب",86,"ب",1,0],["تَعنيفُهُ وتلفُّتي عن نُصحِه","ممَّا يروحُ الشَّرحُ فيهِ يَطولُ",87,"ل",1,0],["تعنو لهمتك الأمجاد مذعنةً ً","ويحسد الفلك الأعلى معانيكا",88,"ك",2,0],["تعنو لهن الخمائل","خواضعا والنبات",89,"ت",1,0],["تعنفني العواذل وهي تدري","بلغت به إلى أقصى المطالب",90,"ب",1,0],["تعنو لاصغى همة من همه","كبى الحوادث حيث شاء تصرفا",91,"ف",2,0],["تعنفنى الدنيا على ان ليس لي","كما للسوى نهد ليكفيني المسعى",92,"ع",2,1],["تعني مسيرك تحت قبضة حكم من","قد سيَّر الدنيا بذات الآنِ",93,"ن",1,0],["تعني لك التصديق دون تذبذب","تتلوه روعة رجفة الإيمانِ",93,"ن",1,0],["تعني بأن لا قبل أن لا بعد أن","يُجتَثَّ معنىً كان للأزمانِ",93,"ن",1,0],["تَعنّبتِ الأحزان لَمّا عصرتُها","فيا تعَبيْ هاتِ الكُؤوس لِنسكرا",94,"ر",2,0],["تعنو الرقاب ولا تعنو النفوس لهم","شتان ما بين أرواحٍ وأعناق",95,"ق",1,0],["تعن له الشوارد يوم أشوفه","وتمشي عوبها له باعتدالي",96,"ل",2,0],["تعنو لك العرب خوف بأسك","الأتراك والديلمان والفرس",97,"س",1,0],["تُعَنقِدُ قَطرَاتِ النَّدَى في بَنَانِهَا","وَمِن قَسَمَاتِ الفَجرِ يَبدُو مُحَيَّاهَا",98,"ا",3,0],["تعنيت لا كن ماتهنيت وصلها","تقفل عن الملهوف للوصل بابها",99,"ب",3,0],["تعنو إليك قوافي الشعر خاشعةً","كالبيت يعنو له كل المصلينا",100,"ن",2,0],["تعنتر ذاك ياعنتر على درعه وفوقه طاس","نسى جحدر يحسبها ويعرف وش مواصيله !!!",101,"ل",2,0],["تعنَّى لها قومٌ فطارتْ بلبِّهمْ","وكمْ دونها منْ عاقلٍ قدْ تلبَّبا",102,"ب",2,0],["تعنّيت ورفض هجرك يلملم بعثرة مغليك","بعد مالمتك لهفة غرامي وإنقفل بابك",103,"ك",1,0],["تعنيت وسبقت الوقت ولا عشت الغرام اسبوع","انا مابي من الدنيا هبوب تطرح شراعي",104,"ع",2,0],["تعني: نجاحا باهرا في خلقها","أي أتقنَ المولى رسومَ الهيئةِ..‏",105,"ه",1,0],["تعني انتهاك حقوق الناس كلِّهمِ","وتجعل الغيَّ يرقَى أرفع القممِ",106,"م",1,0],["تعني المساواة في رأي الألى ظَلموا","في أن تسوّي رؤوس الناس بالقدمِ",106,"م",1,0],["تعنو له الأيام خاضعة","وتذعن طوع أمره",107,"ر",2,0],["تَعَنَّبَتْ شَفَةُ الذكرى ونادمَني","حزني عليكَ ودارَتْ بيننا النُّخَبُ",108,"ب",1,0],["تعنوا له أوجه السادت صاغرة","ويستكين لديه الجحفل اللجب",109,"ب",1,0],["تعنو لابلجَ طلق فوقَ عرته","تاجٌ من النّور يعلوه إذا سفرا",110,"ر",2,0]]}