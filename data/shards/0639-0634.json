s://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179527",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[93,"عَبْدَ العَزِيزِ لَقَدْ جَزِعْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=33738",""],[96,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[45,"ياْبن المُدَبِّرِ، يا أبا إسْحَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32177",""],[45,"عِشْنَا بأَنْعَمِ عَيْشٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31812",""],[91,"وداع وشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53145",""],[91,"عش للجمال","https://www.poetsgate.com/ViewPoem.aspx?id=53318",""],[28,"ما نحن إن جارت صدور ركابنا","https://www.poetsgate.com/ViewPoem.aspx?id=20013",""],[28,"وأطلس عسال وما كان صاحبا","https://www.poetsgate.com/ViewPoem.aspx?id=21035",""],[97,"رحلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63585&r=&rc=132",""]],"verses":[["عَشِيَّةَ جاراني بِعَينَيهِ شادِنٌ","حَديثَ النَوى حَتّى رَمى بي المَرامِيا",0,"ي",2,0],["عَشِيَّةَ بَلَّتني الدُموعُ كَأَنَّما","رِداوايَ بُردا ماتِحٍ خَضِلانِ",1,"ن",1,0],["عَشيَّةَ خُضنا بِالضَوامِرِ لَيلَهُم","وَفي كُلِّ جَفنٍ مِنهُمُ طَيفُ حالِمِ",2,"م",1,0],["عَشِقَ السَماحَ وَكُلُّ سِحرٍ لِلمُنى","فيهِ بِأَنفاثِ السُؤالِ يُحيقُ",3,"ق",1,0],["عِشتَ تَستَدرِكُ فينا","خَطَلَ الدَهرِ وَموقَه",4,"ق",2,0],["عَشيَّةَ لا يَنفَكُّ لَحظٌ مُبَهَّتٌ","مُراقَبَةً مِنّا وَدَمعٌ مُكَفكَفُ",5,"ف",1,0],["عَشيَّةَ لي مِن رُقبَةِ الحَيِّ زاجِزٌ","عَنِ الدَمعِ إِلّا أَن تَشُذَّ دُموعُ",6,"ع",1,0],["عَشِيَّةَ تَغشاني مِنَ الدَمعِ كَنَّةٌ","كَأَنِّيَ مَرهومُ الإِزارَينِ بِالقَطرِ",7,"ر",1,0],["عِشرونَ أَعجَلَنَ الصِبا وَجُزنَ بي","غاياتِهِ وَما قَضَينَ وَطري",8,"ي",1,0],["عَشِيَّةَ لا عِرسُ الوَفاءِ بِمُرمِلٍ","لَدَينا وَلا أُمُّ الصَفاءِ بِعاقِرِ",9,"ر",1,0],["عَشِيَّةَ ما التَفَتنَ عَلى رَقيبٍ","وَلا اِستَحيَينَ مِن نَظَرِ الغَيورِ",10,"ر",1,0],["عُشرونَ أَردَفَها الزَمانُ بِأَربَعٍ","أَرهَفنَني وَمَنَعنَ مِن تَجريدي",11,"د",2,0],["عُشرونَ أَوجَفَ في البَطالَةِ خَلفَها","عامانِ غَلّا مِن يَدَيَّ مِراحي",12,"ي",1,0],["عَشِقتُ وَما لي يَعلَمُ اللَهُ حاجَةٌ","سِوى نَظَري وَالعاشِقونَ ضُروبُ",13,"ب",1,0],["عِش بِالجُدودِ فَما يَضرِ","الجَهل ما أَوتيتُ",14,"ت",1,0],["عِش قَريرَ العَينِ مَسروراً بِهِ","فَيَزيدُ اللَهُ بِالشُكرِ النِعَم",15,"م",1,0],["عَشَوْا نَحْوَ نُورِ اللهِ يَقْتَبِسُوَنَهُ","وَقَدْ خَرَقُوا مِنْ دُونِهِ ظُلَمَ الحجْبِ",16,"ب",1,0],["عِشتَ ما عِشتَ كَالجِبالِ الرَواسي","فَوقَ نارٍ تُذيبُ صُمَّ الصِلابِ",17,"ب",1,0],["عِشرونَ عاماً عَلى الطِرسِ الطَهورِ جَرى","ما خَطَّ فاحِشَةً أَو خَطَّ بُهتانا",18,"ن",2,0],["عِشتَ ما بَينَهُم مُذالاً مُضاعاً","وَكَذا كُنتَ في العُصورِ الخَوالي",19,"ي",1,0],["عِشرُونَ مَوقِعَةً مَرّتْ مُحَجَّلةً","من بعد عَشرٍ بَنانُ الفَتحِ تُحْصيها",20,"ي",3,0],["عِش يا أَبا الفاروقِ وَاِل","بَس مِن نَسيجِ الحَمدِ بُردا",21,"د",2,0],["عَشَوزَنَةً إِذا اِنقَلَبَت أَرَنَّت","تَشُجُّ قَفا المُثَقَّفِ وَالجَبينا",22,"ن",2,0],["عَشِيَّةَ أَومَت وَالعُيونُ حَواضِرٌ","إِلَيَّ بِرَجعِ الكَفِّ أَن لا تَكَلَّما",23,"م",2,0],["عش ما يشاء اللَه في غبطةٍ","وفي صفاء ورده مستطاب",24,"ب",1,0],["عش ما تشاء موفقاً","ومهنأ بخلود ذكرك",25,"ك",1,0],["عَشْرٌ تَقَضَّتْ وَبَنْكُ مِصْرٍ","يَنْمُو وَيَسَمُو ثَبْتاً مَكِينَا",26,"ن",2,0],["عِشْنَا زَمَاناً وَهْيَ قِسْمَتُنَا","وَغَنَاؤُنَا عَنْ سَائِرِ القِسَمِ",27,"م",1,0],["عِشْنَا رَفِيقَيْ صِبَا فِي مِصْرَ وَاشْتَهَرَتْ","دَهْراً وَقائِعُنَا فِي كُلِّ مُؤتَدَمِ",28,"م",1,0],["عِشْ وَازْدَهِرْ يَا فَرْعَ أَزْكَى دَوْحَةٍ","كَفَلَتْ زَكَاءَ فُرُوعِهَا الأَيَّامُ",29,"م",1,0],["عِشْنَا زَمَاناً وَكَانَ فِيهِ إِلَى","أَحْمَدَ تَيْمُورَ يَنْتَهِي العِظَمُ",30,"م",1,0],["عِشْتَ كَالطِّفْلِ أَصَابَ الأَلضما","مَوْضِعَ اللَّهْوِ وَلَمْ يَدْرِ لِمَا",31,"م",2,1],["عَشِيرَةُ الأَحْرَارِ فِي مَأْتَمِ","حُزْناً عَلَى أُسْتَاذِهَا الأَعْظَمِ",32,"م",1,1],["عِشْ أَطْوَلَ الأَعْمَارِ تَخْتَارُ المَنَى","وَتَصِيبُ أعْلاَهَا وَأَنْتَ سَلِيمُ",33,"م",1,0],["عَشيَّةَ جاءوا بِالجِمالِ وَبَينُهم","مخالجة لم يبرموها كما هيا",34,"ي",2,0],["عَشِيَّةَ لَو تَلقى الوُشاةَ لَبَيَّنَت","عُيونُ الهَوى ذاتَ الصُدورِ الكَواتِمِ",35,"م",1,0],["عَشِيَّةَ يَدعو الأَيهَمَينِ فِلَم يُجِب","نَدى صَوتِهِ إِلّا بِقَتلٍ مُعَجَّلِ",36,"ل",1,0],["عَشِيَّةَ طالَعَت لِتَكونَ داءً","جَوى بَينَ الجَوانِحِ أَو سُلالا",37,"ل",2,0],["عَشِيَّةَ قَلبي في المُقيمِ صَديعُهُ","وَراحَ جَنابَ الظاعِنينَ صَديعُ",38,"ع",1,0],["عَشِيَّةَ ما لي حيلَةٌ غَيرَ أَنَّني","بِلَقطِ الحَصى وَالخَطِّ في التُربِ مولَعُ",39,"ع",1,0],["عَشِيَّةَ لَولا خَشيَتي لَتَهَتَّكَت","مِنَ الوَجدِ عَن أَسرارِ قَلبي سُتورُها",40,"ر",3,0],["عَشِيَّةَ حَنَّت في زِمامي صَبابَةً","إِلى إِبِلٍ تَرعى بِلادَ الجآذِرِ",41,"ر",1,0],["عَشِيَّةَ مَسعودٌ يَقولُ وَقَد جَرى","عَلى لِحَيتي مِن عَبَرةِ العَينِ قاطِرُ",42,"ر",1,0],["عَشيَّةَ جَمعٌ مِن عَديٍّ بِخَوفِها","مُهينٌ لِآنافِ اِمرِئِ القَيسِ حاقِرُ",43,"ر",1,0],["عَشيَّةَ أَعَطتنا أَزِمَّةَ أَمرِها","ضِرارُ بَنو القَرمِ الأَغَرِّ وَمِنقَرُ",44,"ر",1,0],["عَشِيَّةَ فَرَّ الحارِثيُّونَ بَعدَما","قَضى نَحبَهُ في مُلتَقى القَومِ هَوبَرُ",44,"ر",1,0],["عَشيَّةَ أَثني الدَمعَ طَورا وَتارَة","يُصادِفُ جَنبي لِحيَتي فَيَجودُها",45,"د",3,0],["عَشِيَّةَ أَعرَضَتَ أَدماءُ بِكرٌ","بِناظِرَة مُكَحَّلَةٍ وَجيدِ",46,"د",1,0],["عشقت منها حسن الربيع","أحسن بذاك الحسن البديع",47,"ع",1,0],["عشيّة سارت من فروق تقلّنا","وتقذف من فيها بوجه الدجى شهبا",48,"ب",2,0],["عشقتك كل فضيلة وعشقتها","لله درّك عاشقاً معشوقا",49,"ق",2,0],["عشت في مصر باحترام يؤدّي","ه إليك الأماثل الفضلاء",50,"ا",2,0],["عشيّةً أطلقت المسدّس ناره","على قلبك الخفّاق من يدك اليمنى",51,"ن",2,0],["عَشِيَّةَ لاقى القِردُ قِردُ مُجاشِعٍ","هِزَبراً أَبا شِبلَينِ في الغيلِ قَسوَرا",52,"ر",2,0],["عَشِيَّةَ راحوا لِلفِراقِ بِنَعشِهِ","إِلى جَدَثٍ في هُوَّةِ الأَرضِ مُعمَقِ",53,"ق",1,0],["عَشِيَّةَ أَعلى مِذنَبِ الجَوفِ قادَني","هَوىً كادَ يُنسي الحِلمَ أَو يُرجِعُ الجَهلا",54,"ل",2,1],["عَشِيَّةَ تَعصيني غُروبُ مَدامِعي","وَإِن قُلتُ أَحياناً لِعَبرَتِها مَهلا",54,"ل",2,0],["عَشِيَّةَ بِعنا الحِلمَ بِالجَهلِ وَاِنتَحَت","بِنا أَريَحِيّاتُ الصِبا وَمَجاهِلُه",55,"ل",2,0],["عِشتُ دَهراً وَلا يَدومُ عَلى ال","أَيّامِ إِلّا يَرَمرَمٌ وَتِعارُ",56,"ر",1,0],["عَشِيَّةَ قالَ اِبنُ الذَئيمَةِ عارِقٌ","إِخالُ رَئيسَ القَومِ لَيسَ بِآئِبِ",57,"ب",1,0],["عَشِيَّةَ رَوَّحنَ مِن عَرقَةٍ","وَأَصبَحنَ فَوضى عَلى شَيزَرِ",58,"ر",1,0],["عَشِقتُ بِها عَوارِيَّ اللَيالي","أَحَقَّ الخَيلَ بِالرَكضِ المِعارُ",59,"ر",1,0],["عشقته مع خَفا كتابته","فاقبل سؤالي وعدّها كتبه",60,"ب",2,0],["عشْ للفضائلِ والهباتِ حبِيبها الطَّ","اءِيّ أو طائيّها المحبوبا",61,"ب",2,0],["عشوت لكأسه لا للثريا","ونسر الشهب خفاق الجناح",62,"ح",1,0],["عشت للآدابِ تحمي سرحها","ببيانٍ خطّ أو خطوٍ فسيح",63,"ح",1,1],["عش كسليمان على ملكه","تعرض هذي الصافنات الجياد",64,"د",1,0],["عشْ بظلِّ الحبا وأنت المرجى","وتبيدُ العدى وأنت المفدَّى",65,"د",2,0],["عشقي كمدح جمال دين الله لا","ينفكّ مشتغل الضمير بذا وذا",66,"ذ",2,0],["عشقته حلواً على مثله","يطاعُ في الغيّ أبو مرَّه",67,"ر",2,0],["عشْ يا وزير التقى والبرّ محتوياً","في الأجرِ والدكر أولاهُ وآخره",68,"ر",2,0],["عشْ يا وزيراً شمسه قد زهت","ويا أميراً حسنه قد زهر",69,"ر",1,1],["عشْ كذا للسعودِ مستقبلات","بين عامٍ آت وآخر ماضي",70,"ض",2,0],["عش لعفاةٍ طُوّقوا بالندى","فالكلّ في دوحِ الثنا يسجع",71,"ع",1,0],["عش مهنًّا بألف عامٍ وعيد","بين جزم من الأمور ورَفع",72,"ع",1,1],["عشقت نفسه المعالي فجدَّت","والمعالي قليلة العشَّاق",73,"ق",1,0],["عش يا محمد سالماً بيت العلى","إذ كلّ بيتٍ في الورى منهوك",74,"ك",1,1],["عشقته مثلي وخافته خوفي","فاسْتجارت لديه بالأذيال",75,"ل",1,0],["عش للمفصّل من حمدٍ يقال إذا","بدا على مثل هذا تنفق الجمل",76,"ل",1,0],["عشْ يا إمام العلى والعلم ذا نعمٍ","لقاصر السعي مثلي طامح الأمل",77,"ل",1,1],["عشْ يا وليّ الوقت تنعش في الورَى","حالي ال