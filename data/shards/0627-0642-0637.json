{"poems":[[51,"قالوا هجاك أبو حفص فقلت لهم","https://www.aldiwan.net/poem9433.html","البسيط"],[51,"الحمد للَّه يا أبا حسنِ","https://www.aldiwan.net/poem66455.html","المنسرح"],[70,"يا أعز الناس عندي","https://www.aldiwan.net/poem42942.html","مجزوء الرمل"],[45,"خلته لما تبدى","https://www.aldiwan.net/poem66826.html","مجزوء الرمل"],[61,"أقطعتني روض الغنى كرما ولم","https://www.aldiwan.net/poem51380.html","الكامل"],[49,"اقطع الدنيا بما انقطعت","https://www.aldiwan.net/poem10852.html","المديد"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[97,"أصبحت يوم الجمعه","https://www.aldiwan.net/poem24876.html","مجزوء الرجز"],[44,"إقطع حبالي فقد برمت بكا","https://www.aldiwan.net/poem30011.html","المنسرح"],[87,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[52,"اقطع وصالي فلست مني","https://www.aldiwan.net/poem27009.html","مجزوء البسيط"],[48,"لا تراني يئست منك","https://www.aldiwan.net/poem64324.html","مجزوء الخفيف"],[48,"نسيتني حوادث الأيام","https://www.aldiwan.net/poem65241.html","الخفيف"],[46,"من جالس المغتاب فهو مغتاب","https://www.aldiwan.net/poem22376.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39603","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[107,"كبد من سنان لحظك جرحى","https://www.aldiwan.net/poem16239.html","الخفيف"],[107,"سقى الودق ما بين الرياض لنا صرحا","https://www.aldiwan.net/poem16242.html","الطويل"],[113,"خطرات ذكرك تستثير مودتي","https://www.aldiwan.net/poem41225.html","عموديه"],[113,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[122,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[183,"ألا هل إلى ما أرتجيه بلوغ","https://www.aldiwan.net/poem14588.html","الطويل"],[209,"جاد بالوعد في زمان بخيل","https://www.aldiwan.net/poem46272.html","الخفيف"],[209,"صورة منك لو أرادت لقالت","https://www.aldiwan.net/poem46614.html","الخفيف"],[235,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[301,"أمير حسن خطا والرمح في يده","https://www.aldiwan.net/poem58156.html","البسيط"],[374,"اقطع بحزمك غصن الضر مبتكرا","https://www.aldiwan.net/poem59275.html","البسيط"],[374,"يسوع أقبل من عرش السماء فقد","https://www.aldiwan.net/poem59452.html","البسيط"],[374,"خذ خمرة الكذب من هذي وسخرية","https://www.aldiwan.net/poem66920.html","البسيط"],[400,"قال لي اللائم لما رأى","https://www.aldiwan.net/poem33623.html","السريع"],[400,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[429,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[429,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[429,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[451,"اقطعوها وانبذوا من قد دعاها","https://www.aldiwan.net/poem61709.html","الرمل"],[466,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[556,"عشق ذات الخال عشقي","https://www.aldiwan.net/poem34325.html","مجزوء الرمل"],[573,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["أقطعتُ عرضي أبا حفص وأقطعني","أن أنزِل الدهْرَ أنَّى شئتُ في كُوخِهْ",0,"ه",1,0],["أقطعتني مرتع الهُزال وأق","طعتَ أناساً مراتع السِّمن",1,"ن",1,0],["أَقطَعُ اللَيلَ أُقاسي","ما أُقاسي فيهِ وَحدي",2,"د",2,0],["أَقطَعُ اللَيلَ بِذِكرا","هُ نَديماً لِلأَماني",3,"ن",2,0],["أقطعتني روض الغنى كرما ولم","أقطع إليه سباسبا وسهوبا",4,"ب",2,1],["اِقطَعِ الدُنيا بِما اِنقَطَعَت","وَاِدفَعِ الدُنيا بِما اِندَفَعَت",5,"ت",1,1],["أَقَطَراتِ أَدمُعي لا تَجمَدي","وَيا شُواظَ أَضلُعي لا تَخمُدي",6,"ي",1,1],["أقطع يومي مُبطئاً","كأنني لن أقطعه",7,"ع",2,0],["إِقطَع حِبالي فَقَد بَرِمتُ بِكا","وَخَلِّني حَيثُ شِئتُ مِن يَدِكا",8,"ك",2,1],["أَقْطَعُ اللَّيْلَ بَيْنَ حُزْنٍ وَدَمْعٍ","وَسُهَادٍ وَالنَّاسُ عَنِّي نِيَامُ",9,"م",1,0],["اِقطَع وِصالي فَلَستَ مِنّي","وَدُم عَلى جَفوَتي وَهَجري",10,"ي",1,1],["أَقطَعُ الدَهرَ سَيِّدي","مِنكَ بِاللَوِّ وَالعَسى",11,"س",2,0],["أَقطَعُ الدَهرَ بِالنَدامى الكِرامِ","وَرُكوبِ الهَوى وَشُربِ المُدامِ",12,"م",1,0],["أَقطَعُ مِنهُ حِندِساً وَأَجتاب","وَتَضمِرُ الأَقتابُ فَوقَ الأَقتاب",13,"ب",1,0],["أقطفوا الأزهارَ منه واعصروا الكرْمَ الجنِيّا","يا رفاقي قد دعانا زمَنُ الحبِّ فهيّا",14,"ي",2,0],["أقطعُ العمرَ عندها","غيرَ وانٍ عن النظَرْ",15,"ر",1,0],["أَقطع اللَيل وَهُوَ أَسَود يَزي","دُّ كَقَلب الحَسود يَضمر قَبحا",16,"ح",2,0],["أَقطر مِن جفنيَّ روحيَ أَدمُعاً","وَأَطوي عَلى جَمر أَصعدهُ كَشحا",17,"ح",2,0],["اقطع بالفكر لهم سبسبا","اتبعه من لوعتي سبسبا",18,"ب",2,0],["اقطع ليلي هائما مولها","وخيل من اهوى بقلبي تلعب",19,"ب",1,0],["أقطعتها فيها النعال وسرت في","دربي ولم أحفل بذرع الذارع",20,"ع",1,0],["أُقطِّع أوقاتي عليكم تأسُّفا","كأني على طولِ الزمان لَديغ",21,"غ",1,0],["أقطع الدهر كله في هيام","هو في شرعة الغرام شطح",22,"ح",1,0],["أقطع الليل والنهار سهاداً","ما غناءُ الغرام من تعذيبي",23,"ي",1,0],["أَقْطِفُ أَنْوَارَ الْمُنَى غَضَّةً","تَحْتَ ظِلاَلِ الْعِلْمِ فِي حَضْرَتِهِ",24,"ت",2,0],["أقطعته مهجتي فازور من غضبٍ","وقال زدني البكا نقداً من العين",25,"ن",1,0],["اقطع بحزمك غصنَ الضر مبتكراً","ما دام عزمك يستدعيك بالأملِ",26,"ل",1,1],["إقطع صديقاً وصل مولىً كَفِلتَ به","واعص الأنام وطِع ربّاً ثناك حمدْ",27,"د",1,0],["إقطع بسيف خشوعٍ رأس مكذبةٍ","فالسيف أصدق إنباءً من الكذب",28,"ب",1,0],["اقطع علاقات الهوى تسترح","فقلت أو تسمع مني المقال",29,"ل",1,0],["أقطعته قلبي على تحريمه","وللغرام شرعة لا تهدي",30,"ي",1,0],["أَقطِفُ أَثمارَ التَّصابِي غضَّةً","وأَحْتَسِي ماءَ الهوى سلاسلا",31,"ل",2,0],["اقطَعْ مؤاخاةَ أخٍ جافِ","أرضعَهُ اللؤمُ بأخلافِ",32,"ف",1,1],["أقطعْتُهُ قلبي فقطّعه أسًى","فعلامَ يُتلِفُ ذاتَه بأداتِه",33,"ت",2,0],["اقطعوها وانبذوا من قد دَعاها","نعمةً إنّا شبعنا من أَذاهَا",34,"ا",3,1],["أَقطَعتَني مِنكَ وُدّاً","جَنَيتُ لي مِنهُ فَخرا",35,"ر",2,0],["أقطع الأعداء للحا","ل مدى غربٍ وشرق",36,"ق",1,0],["أَقطعْتني وسْطَ بلدتي بلداً","سُرَّ به كلُّ رامِقٍ وامِقْ",37,"ق",1,0]]}