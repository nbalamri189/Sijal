{"poems":[[53,"قالوا هجاك أبو حفص فقلت لهم","https://www.aldiwan.net/poem9433.html","البسيط"],[53,"الحمد للَّه يا أبا حسنِ","https://www.aldiwan.net/poem66455.html","المنسرح"],[72,"يا أعز الناس عندي","https://www.aldiwan.net/poem42942.html","مجزوء الرمل"],[47,"خلته لما تبدى","https://www.aldiwan.net/poem66826.html","مجزوء الرمل"],[63,"أقطعتني روض الغنى كرما ولم","https://www.aldiwan.net/poem51380.html","الكامل"],[51,"اقطع الدنيا بما انقطعت","https://www.aldiwan.net/poem10852.html","المديد"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[99,"أصبحت يوم الجمعه","https://www.aldiwan.net/poem24876.html","مجزوء الرجز"],[46,"إقطع حبالي فقد برمت بكا","https://www.aldiwan.net/poem30011.html","المنسرح"],[89,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[54,"اقطع وصالي فلست مني","https://www.aldiwan.net/poem27009.html","مجزوء البسيط"],[50,"لا تراني يئست منك","https://www.aldiwan.net/poem64324.html","مجزوء الخفيف"],[50,"نسيتني حوادث الأيام","https://www.aldiwan.net/poem65241.html","الخفيف"],[48,"من جالس المغتاب فهو مغتاب","https://www.aldiwan.net/poem22376.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39603","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[113,"كبد من سنان لحظك جرحى","https://www.aldiwan.net/poem16239.html","الخفيف"],[113,"سقى الودق ما بين الرياض لنا صرحا","https://www.aldiwan.net/poem16242.html","الطويل"],[119,"خطرات ذكرك تستثير مودتي","https://www.aldiwan.net/poem41225.html","عموديه"],[119,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[189,"ألا هل إلى ما أرتجيه بلوغ","https://www.aldiwan.net/poem14588.html","الطويل"],[215,"جاد بالوعد في زمان بخيل","https://www.aldiwan.net/poem46272.html","الخفيف"],[215,"صورة منك لو أرادت لقالت","https://www.aldiwan.net/poem46614.html","الخفيف"],[241,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[307,"أمير حسن خطا والرمح في يده","https://www.aldiwan.net/poem58156.html","البسيط"],[381,"اقطع بحزمك غصن الضر مبتكرا","https://www.aldiwan.net/poem59275.html","البسيط"],[381,"يسوع أقبل من عرش السماء فقد","https://www.aldiwan.net/poem59452.html","البسيط"],[381,"خذ خمرة الكذب من هذي وسخرية","https://www.aldiwan.net/poem66920.html","البسيط"],[407,"قال لي اللائم لما رأى","https://www.aldiwan.net/poem33623.html","السريع"],[407,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[436,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[436,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[436,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[456,"اقطعوها وانبذوا من قد دعاها","https://www.aldiwan.net/poem61709.html","الرمل"],[471,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[561,"عشق ذات الخال عشقي","https://www.aldiwan.net/poem34325.html","مجزوء الرمل"],[578,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["أقطعتُ عرضي أبا حفص وأقطعني","أن أنزِل الدهْرَ أنَّى شئتُ في كُوخِهْ",0,"ه",1,0],["أقطعتني مرتع الهُزال وأق","طعتَ أناساً مراتع السِّمن",1,"ن",1,0],["أَقطَعُ اللَيلَ أُقاسي","ما أُقاسي فيهِ وَحدي",2,"د",2,0],["أَقطَعُ اللَيلَ بِذِكرا","هُ نَديماً لِلأَماني",3,"ن",2,0],["أقطعتني روض الغنى كرما ولم","أقطع إليه سباسبا وسهوبا",4,"ب",2,1],["اِقطَعِ الدُنيا بِما اِنقَطَعَت","وَاِدفَعِ الدُنيا بِما اِندَفَعَت",5,"ت",1,1],["أَقَطَراتِ أَدمُعي لا تَجمَدي","وَيا شُواظَ أَضلُعي لا تَخمُدي",6,"د",2,1],["أقطع يومي مُبطئاً","كأنني لن أقطعه",7,"ع",2,0],["إِقطَع حِبالي فَقَد بَرِمتُ بِكا","وَخَلِّني حَيثُ شِئتُ مِن يَدِكا",8,"ك",2,1],["أَقْطَعُ اللَّيْلَ بَيْنَ حُزْنٍ وَدَمْعٍ","وَسُهَادٍ وَالنَّاسُ عَنِّي نِيَامُ",9,"م",1,0],["اِقطَع وِصالي فَلَستَ مِنّي","وَدُم عَلى جَفوَتي وَهَجري",10,"ي",1,1],["أَقطَعُ الدَهرَ سَيِّدي","مِنكَ بِاللَوِّ وَالعَسى",11,"س",2,0],["أَقطَعُ الدَهرَ بِالنَدامى الكِرامِ","وَرُكوبِ الهَوى وَشُربِ المُدامِ",12,"م",1,0],["أَقطَعُ مِنهُ حِندِساً وَأَجتاب","وَتَضمِرُ الأَقتابُ فَوقَ الأَقتاب",13,"ب",1,0],["أقطفوا الأزهارَ منه واعصروا الكرْمَ الجنِيّا","يا رفاقي قد دعانا زمَنُ الحبِّ فهيّا",14,"ي",2,0],["أقطعُ العمرَ عندها","غيرَ وانٍ عن النظَرْ",15,"ر",1,0],["أقطع آمالي بما في بعضه","أكبر من كاف لدرك المبتغى",16,"ا",1,0],["أَقطع اللَيل وَهُوَ أَسَود يَزي","دُّ كَقَلب الحَسود يَضمر قَبحا",17,"ح",2,0],["أَقطر مِن جفنيَّ روحيَ أَدمُعاً","وَأَطوي عَلى جَمر أَصعدهُ كَشحا",18,"ح",2,0],["اقطع بالفكر لهم سبسبا","اتبعه من لوعتي سبسبا",19,"ب",2,0],["اقطع ليلي هائما مولها","وخيل من اهوى بقلبي تلعب",20,"ب",1,0],["أقطعتها فيها النعال وسرت في","دربي ولم أحفل بذرع الذارع",21,"ع",1,0],["أُقطِّع أوقاتي عليكم تأسُّفا","كأني على طولِ الزمان لَديغ",22,"غ",1,0],["أقطع الدهر كله في هيام","هو في شرعة الغرام شطح",23,"ح",1,0],["أقطع الليل والنهار سهاداً","ما غناءُ الغرام من تعذيبي",24,"ب",2,0],["أَقْطِفُ أَنْوَارَ الْمُنَى غَضَّةً","تَحْتَ ظِلاَلِ الْعِلْمِ فِي حَضْرَتِهِ",25,"ت",2,0],["أقطعته مهجتي فازور من غضبٍ","وقال زدني البكا نقداً من العين",26,"ن",1,0],["اقطع بحزمك غصنَ الضر مبتكراً","ما دام عزمك يستدعيك بالأملِ",27,"ل",1,1],["إقطع صديقاً وصل مولىً كَفِلتَ به","واعص الأنام وطِع ربّاً ثناك حمدْ",28,"د",1,0],["إقطع بسيف خشوعٍ رأس مكذبةٍ","فالسيف أصدق إنباءً من الكذب",29,"ب",1,0],["اقطع علاقات الهوى تسترح","فقلت أو تسمع مني المقال",30,"ل",1,0],["أقطعته قلبي على تحريمه","وللغرام شرعة لا تهدي",31,"د",2,0],["أَقطِفُ أَثمارَ التَّصابِي غضَّةً","وأَحْتَسِي ماءَ الهوى سلاسلا",32,"ل",2,0],["اقطَعْ مؤاخاةَ أخٍ جافِ","أرضعَهُ اللؤمُ بأخلافِ",33,"ف",1,1],["أقطعْتُهُ قلبي فقطّعه أسًى","فعلامَ يُتلِفُ ذاتَه بأداتِه",34,"ت",2,0],["اقطعوها وانبذوا من قد دَعاها","نعمةً إنّا شبعنا من أَذاهَا",35,"ا",3,1],["أَقطَعتَني مِنكَ وُدّاً","جَنَيتُ لي مِنهُ فَخرا",36,"ر",2,0],["أقطع الأعداء للحا","ل مدى غربٍ وشرق",37,"ق",1,0],["أَقطعْتني وسْطَ بلدتي بلداً","سُرَّ به كلُّ رامِقٍ وامِقْ",38,"ق",1,0]]}