/ViewPoem.aspx?id=149442",""],[3591,"على الله أجر المسّهام المتيّم","https://www.poetsgate.com/ViewPoem.aspx?id=149475",""],[5225,"زهور الحب","https://www.poetsgate.com/ViewPoem.aspx?id=36891",""],[5431,"غاصت الروح ضمن الروح مُرتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=182963",""],[5480,"سبعة قوافي","https://www.poetsgate.com/ViewPoem.aspx?id=35173",""],[5525,"الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=921",""],[5526,"دفتر أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=198789",""],[5573,"أنتِ التي علمتِني هذا الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=213732",""],[5587,"يا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=194407",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5660,"ما أَصعَبَ الذِكرى عَلى الأَحبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=23715",""],[5660,"دَع عَنكَ ذُلُّ هَوى النِّساءِ جَميعا","https://www.poetsgate.com/ViewPoem.aspx?id=25121",""],[5732,"اقطف زهر مالاق","https://www.poetsgate.com/ViewPoem.aspx?id=177908",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5848,"ست الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=53451",""],[5848,"مدي يدك ..","https://www.poetsgate.com/ViewPoem.aspx?id=48998",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[5950,"غثى ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128333",""],[5956,"حَيْرَة","https://www.poetsgate.com/ViewPoem.aspx?id=184782",""],[5970,"ذرة ما بين أرض وسماء","https://www.poetsgate.com/ViewPoem.aspx?id=130581",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6355,"يا أرض تيهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66645&r=&rc=105",""]],"verses":[["أقطعتُ عرضي أبا حفص وأقطعني","أن أنزِل الدهْرَ أنَّى شئتُ في كُوخِهْ",0,"ه",1,0],["أقطعتني مرتع الهُزال وأق","طعتَ أناساً مراتع السِّمن",1,"ن",1,0],["أَقطَعُ اللَيلَ أُقاسي","ما أُقاسي فيهِ وَحدي",2,"د",2,0],["أَقطَعُ اللَيلَ بِذِكرا","هُ نَديماً لِلأَماني",3,"ن",2,0],["أقطعتني روض الغنى كرما ولم","أقطع إليه سباسبا وسهوبا",4,"ب",2,1],["اِقطَعِ الدُنيا بِما اِنقَطَعَت","وَاِدفَعِ الدُنيا بِما اِندَفَعَت",5,"ت",1,1],["أَقَطَراتِ أَدمُعي لا تَجمَدي","وَيا شُواظَ أَضلُعي لا تَخمُدي",6,"د",2,1],["أقطع يومي مُبطئاً","كأنني لن أقطعه",7,"ع",2,0],["إِقطَع حِبالي فَقَد بَرِمتُ بِكا","وَخَلِّني حَيثُ شِئتُ مِن يَدِكا",8,"ك",2,1],["أَقْطَعُ اللَّيْلَ بَيْنَ حُزْنٍ وَدَمْعٍ","وَسُهَادٍ وَالنَّاسُ عَنِّي نِيَامُ",9,"م",1,0],["اِقطَع وِصالي فَلَستَ مِنّي","وَدُم عَلى جَفوَتي وَهَجري",10,"ي",1,1],["أَقطَعُ الدَهرَ سَيِّدي","مِنكَ بِاللَوِّ وَالعَسى",11,"س",2,0],["أَقطَعُ الدَهرَ بِالنَدامى الكِرامِ","وَرُكوبِ الهَوى وَشُربِ المُدامِ",12,"م",1,0],["أَقطَعُ مِنهُ حِندِساً وَأَجتاب","وَتَضمِرُ الأَقتابُ فَوقَ الأَقتاب",13,"ب",1,0],["أقطفوا الأزهارَ منه واعصروا الكرْمَ الجنِيّا","يا رفاقي قد دعانا زمَنُ الحبِّ فهيّا",14,"ي",2,0],["أقطعُ العمرَ عندها","غيرَ وانٍ عن النظَرْ",15,"ر",1,0],["أقطع آمالي بما في بعضه","أكبر من كاف لدرك المبتغى",16,"ا",1,0],["أَقطع اللَيل وَهُوَ أَسَود يَزي","دُّ كَقَلب الحَسود يَضمر قَبحا",17,"ح",2,0],["أَقطر مِن جفنيَّ روحيَ أَدمُعاً","وَأَطوي عَلى جَمر أَصعدهُ كَشحا",18,"ح",2,0],["اقطع بالفكر لهم سبسبا","اتبعه من لوعتي سبسبا",19,"ب",2,0],["اقطع ليلي هائما مولها","وخيل من اهوى بقلبي تلعب",20,"ب",1,0],["أقطعتها فيها النعال وسرت في","دربي ولم أحفل بذرع الذارع",21,"ع",1,0],["أُقطِّع أوقاتي عليكم تأسُّفا","كأني على طولِ الزمان لَديغ",22,"غ",1,0],["أقطع الدهر كله في هيام","هو في شرعة الغرام شطح",23,"ح",1,0],["أقطع الليل والنهار سهاداً","ما غناءُ الغرام من تعذيبي",24,"ب",2,0],["أَقْطِفُ أَنْوَارَ الْمُنَى غَضَّةً","تَحْتَ ظِلاَلِ الْعِلْمِ فِي حَضْرَتِهِ",25,"ت",2,0],["أقطعته مهجتي فازور من غضبٍ","وقال زدني البكا نقداً من العين",26,"ن",1,0],["اقطع بحزمك غصنَ الضر مبتكراً","ما دام عزمك يستدعيك بالأملِ",27,"ل",1,1],["إقطع صديقاً وصل مولىً كَفِلتَ به","واعص الأنام وطِع ربّاً ثناك حمدْ",28,"د",1,0],["إقطع بسيف خشوعٍ رأس مكذبةٍ","فالسيف أصدق إنباءً من الكذب",29,"ب",1,0],["اقطع علاقات الهوى تسترح","فقلت أو تسمع مني المقال",30,"ل",1,0],["أقطعته قلبي على تحريمه","وللغرام شرعة لا تهدي",31,"د",2,0],["أَقطِفُ أَثمارَ التَّصابِي غضَّةً","وأَحْتَسِي ماءَ الهوى سلاسلا",32,"ل",2,0],["اقطَعْ مؤاخاةَ أخٍ جافِ","أرضعَهُ اللؤمُ بأخلافِ",33,"ف",1,1],["أقطعْتُهُ قلبي فقطّعه أسًى","فعلامَ يُتلِفُ ذاتَه بأداتِه",34,"ت",2,0],["اقطعوها وانبذوا من قد دَعاها","نعمةً إنّا شبعنا من أَذاهَا",35,"ا",3,1],["أَقطَعتَني مِنكَ وُدّاً","جَنَيتُ لي مِنهُ فَخرا",36,"ر",2,0],["أقطع الأعداء للحا","ل مدى غربٍ وشرق",37,"ق",1,0],["أَقطعْتني وسْطَ بلدتي بلداً","سُرَّ به كلُّ رامِقٍ وامِقْ",38,"ق",1,0],["اقطف من روض شعري لهم","فانثر ورداً على نائمينا",39,"ن",2,0],["أُقطِّعُ الطَّرْفَ في المرآةِ منْ فرَقٍ","إذا تراءَتْ له في مَفْرِقي قِطَع",40,"ع",1,0],["أقطعها طوراً وطو","راً بالسرى تقطعني",41,"ن",2,0],["أقطع الليل والنهار كئيبا","بين شوق مبرح وسهاد",42,"د",1,0],["أقطارها طرًّا وساير أهلها","تدعو له في كل دورٍ دايرِ",43,"ر",1,0],["اقطع يدي ولساني","إن كنت أكذب فيها",44,"ه",2,1],["اقطب رحى الإمكان هل لك في الوغى","وفي خوض تيار الردى من مآرب",45,"ب",1,0],["أُقَطّع يَومْي أو أَقَصِّرَ ليلْتَي","بأحسَن من شْمسِ النَّهار وامْلحَها",46,"ح",3,0],["أقطع أنفاسي \"عليه كآبة\"","فلله من بدر لغيري سعدُهُ",47,"د",2,0],["أقطب رحى صبراة ادرك عبيدكم","لما ساءه من حال وقتٍ به عكف",48,"ف",1,0],["اقطع فقلت أَبَعدَ ما","لَم يَخفَ عن كلِّ الملا ذا",49,"ذ",2,0],["اقطاب مجد أقاموا للعلى فلكا","تسبيك انجمه سرجا وحراسا",50,"س",2,0],["أُقَطِّبُ حين أرمقه","كأني لست أعشقه",51,"ق",2,1],["أقطاعنا هي أسماءُ الإله بها","عين النجاةِ لأبصاري وأسماعي",52,"ع",2,0],["أقطعُ الليلَ ساهراً","أهجرُ النومَ والكرى",53,"ر",2,0],["اقطف الجلنار من روض خديك","وأجني الرمان من نهديك",54,"ك",1,0],["اقطاب باريس احتفوا بك واقتفى","منهم على اثر النبيل نبيل",55,"ل",1,0],["أقطع بحد العزم أسباب الثوى","واجدع بحد السيف أنف المشرك",56,"ك",1,0],["اقطعته القلب العلوق توّصلا","وهو التطوع بوصلة الاعلاق",57,"ق",1,0],["أُقطّع روحي كلّ ليل قصائدا","وأملأ رأسي كلّ صبح جرائدا",58,"د",2,1],["أقطع من عيشي اقتصاداً وان أتى","أخو حاجة أحبوه حتى بأوصالي",59,"ل",2,0],[