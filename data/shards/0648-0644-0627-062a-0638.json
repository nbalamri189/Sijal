{"poems":[[110,"أذن بمن في السرى","https://www.shoaraa.com/p11793",""],[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[53,"تأمل العيب عيب","https://www.aldiwan.net/poem8304.html","المجتث"],[87,"تفديك يا مكس الجياد الصلادم","https://www.aldiwan.net/poem7917.html","الطويل"],[60,"ألا فاصبر على الحدث الجليل","https://www.aldiwan.net/poem30920.html","الوافر"],[89,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[42,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[52,"يا عبد بالله فرجي كربي","https://www.aldiwan.net/poem64760.html","المنسرح"],[48,"إذا ما استهل الطفل قال ولاته","https://www.aldiwan.net/poem23036.html","الطويل"],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[170,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[343,"فلا تجزع وإن أعسرت يوما","https://www.aldiwan.net/poem68648.html","الوافر"],[371,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[376,"تمتع إن رأيت بمصر ثديا","https://www.aldiwan.net/poem56962.html","البسيط"],[409,"ترفق بالمعنى يا غرام","https://www.aldiwan.net/poem33423.html","الوافر"],[415,"يا ناصر الدين يا بن الأكرمين ومن","https://www.aldiwan.net/poem32250.html","البسيط"],[438,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[500,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[563,"إن الوجود له ذات وأسماء","https://www.aldiwan.net/poem35080.html","البسيط"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/144328","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34408","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70652","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46722",""],[1357,"","https://poetry.dctabudhabi.ae/diwan/poem/178079","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77976","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77868","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69323","البسيط"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109299","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27940","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75973","البسيط"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100401","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114868","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119384","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119664","البسيط"],[4463,"","https://poetry.dctabudhabi.ae/diwan/poem/144940","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119596","الطويل"],[4691,"نبية الأنوار","https://www.poetsgate.com/ViewPoem.aspx?id=215987",""],[4816,"نيست","https://www.poetsgate.com/ViewPoem.aspx?id=8485",""],[4852,"والهة","https://www.poetsgate.com/ViewPoem.aspx?id=214389",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4988,"كل جنس الخود إلاكي .,., حدر","https://www.poetsgate.com/ViewPoem.aspx?id=153966",""],[3271,"اللاجئون","https://www.poetsgate.com/ViewPoem.aspx?id=131014",""],[585,"يا رب أقدام كان الداء منحسما","https://www.poetsgate.com/ViewPoem.aspx?id=161846",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""],[563,"إن الوجود له ذات وأسماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56283&r=&rc=13",""],[6263,"كما شئتَ يا شعر...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81062&r=&rc=13",""],[2220,"إذا كنتَ إنساناً فكنْ خير إنسانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11845&r=&rc=714",""]],"verses":[["ولا تظنن في الحلم الذي دأبت","عليه أعرافنا ذلاً وتهوينا",0,"ن",2,0],["وَلا تَظُنّي شَكاتي","مِن مَصرَعي إِن شَكَوتُ",1,"ت",1,0],["ولا تظَنَّ بجهلٍ","أن اللسان زُبَيْبُ",2,"ب",1,0],["وَلا تَظفَرُ الأَهرامُ إِلّا بِثالِثٍ","مَزاميرُ داوُدٍ عَلَيهِ نَواغِمُ",3,"م",1,0],["وَلا تَظُنَّنْ بِرَبِّكَ غَيرَ خَيرٍ","فَإِنَّ اللَهَ أَولى بِالجَميلِ",4,"ل",1,0],["وَلا تَظُنُّوا نَمَاءَ الْمَالِ وَانْتَسِبُوا","فَالْعِلْمُ أَفْضَلُ مَا يَحْوِيهِ ذُو نَسَمِ",5,"م",1,0],["وَلا تُظهِرا بُردَيكُما وَعَلَيكُما","كِساءان مِن خَزٍّ بِنَقشٍ وَأَخضَرُ",6,"ر",1,0],["وَلا تَظنّي ما أَشتَكي لَعِباً","هَيهاتَ قَد جَلَّ ذا عَنِ اللَعِبِ",7,"ب",1,0],["وَلا تُظهِرَنَّ الزُّهدَ فيها فَكُلُّنا","شَهيدٌ بِأَنَّ القَلبَ يُضمِرُ عِشقَها",8,"ق",3,0],["وَلا تُظهِرَن حُبَّ اِمرِئٍ قَبلَ خُبرِهِ","وَبَعدَ بَلاءِ المَرءِ فَاِذمُم أَوِ اِحمَدِ",9,"د",1,0],["ولا تظنَّ سواها مثلَها فلَكَمْ","بينَ السَّماكِ إذا مَيزَّتَ والسّمكِ",10,"ك",1,0],["ولا تظهرن الامتناع بقول لا","فقل مرحبا فاستدرك العذر في الان",11,"ن",1,0],["وَلا تَظنُن بِرَبِّكَ ظَنَّ سَوءٍ","فَإِنَّ اللَهَ أَولى بِالجَميلِ",12,"ل",1,0],["وَلا تُظهِرَن رَفعَ السِلاحِ فَمَن لَهُ","وَلا تَرجُوَن نَفعَ الصِياحِ فَقَلَّما",13,"م",2,0],["ولا تُظهِر لِمن تَلقى وَلاءً","فعِندَهُمُ عَلاماتُ الوَليِّ",14,"ي",1,0],["ولا تظلم قلوباً خافقات","هي الرايات يحملها الغرام",15,"م",1,0],["ولا تظنَّنِي أدعو سِواك ولا","يفوهُ مجتدِياً إلا إليكَ فَمِي",16,"م",2,0],["ولا تَظُنَّ به ما لَيْسَ يعرِفُه","فَظَنُّ رَبِّكَ مرفوعٌ عَنِ الظَّنَنِ",17,"ن",1,0],["ولا تظنن جوده سعة","ولا تقدّر هواءهُ لينا",18,"ن",2,0],["ولا تظنوا حلولاً في مقالتنا","ولا اتحاداً فمالأشياء أكفاء",19,"ا",2,0],["ولا تظنّ خفاء النجم من صغرٍ","فالذنب في ذاك محمولٌ على البصر",20,"ر",1,0],["وَلا تَظنّوا سكوني في الغَرام بكم","يَقضي بأنّ فُؤادي مِنكمُ خالي",21,"ل",2,0],["ولا تظنِّي نهَتْني عن زيارتكم","كراهةٌ يا خِيار الخُرَّد العُرُب",22,"ب",1,0],["ولا تَظُنُّوهُ دَخِيلاً ولا","تَكَلَّفَ الَمدَّ ولا يَدَّعِيه",23,"ي",2,0],["ولا تظلِمَنَّ النّاسَ ما في يديهِمُ","ولا تذكُرنْ إفْكاً ولا تحسُدَنْ خلقا",24,"ق",2,0],["وَلا تظن بأن السر ما وضعوا","لَيسَ الحَقائِق تمحى بالأظانين",25,"ن",1,0],["وَلا تظنوا قط أَنا غبنا","في ساعة أَو ليلة أَو شهر",26,"ر",1,0],["وَلا تَظُنّي نُحولَ الجِسمِ مِن أَلَمٍ","فَالهَمُّ يَفعَلُ مالا يَفعَلُ الأَلَمُ",27,"م",1,0],["ولا تظهرنها عند غير حروفها","وعوض بإدغام لدى ستة غير",28,"ر",1,0],["ولا تظنّوا بأَنَّ العَيَّ أَقْعَدَني","عنكم ولا أَنَّ جَمْري غيرُ ذي شَرَر",29,"ر",1,0],["ولا تظني بأني في المحبة لي","أذن عن العذل يوماً غير صماء",30,"ا",2,0],["ولا تظهرن إن كنتَ تملك سترةً","إلى كلِّ ذي عين بصورة عُريانِ",31,"ن",1,0],["وَلا تَظُنَّ امرأً أَسدى إِلَيكَ نَدىً","مِن أَجلِ ذاتِكَ بَل أَسداهُ لِلغرَضِ",32,"ض",1,0],["ولا تظن وحدة الوجود ما","تفهم من وحدة ذا الوجود",33,"د",1,0],["ولا تظنّ شؤون المرء واحدةً","فكلُّ يوم له من امره شانُ",34,"ن",1,0],["ولا تظن بأني صاح انكرها","حاشا وكلا فلا تشكك ولا تهم",35,"م",1,0],["ولا تظهرنّ بُغضةً لها","تنفر فالوسط في الأمر بها",36,"ه",2,0],["ولا تظن القنا تجدي بمفردها","السعد رأس وأطراف القناذنب",37,"ب",1,0],["ولا تظلِم المولى ولا تضع العصا","على الجهل ان طارت عليك دوائره",38,"ر",2,0],["ولا تظنن أن السيف مبتسم","فليس يبسم إلا كلما غضبا",39,"ب",2,1],["ولا تظنّنّ أني غير منتبهٍ","ولست أعلم ما أُبقي وما أذرُ",40,"ر",1,1],["ولا تظهر الأصداغ للناس فتنة","وتجعل منها فوق خديك عقربا",41,"ب",2,0],["ولا تظرنّ اليوم لهوا إلى غد","ومن لغد من حادث بأمان",42,"ن",1,0],["ولا تظنّي إنني مازحٌ","أكرّر الحبّ الذي رُدّدا",43,"د",2,0],["ولا تظن براق المزن ودق غطسا","لن شفت سحب الصيف برق استخالت",44,"ت",1,0],["ولا تظن بأنَّ ال\"لا\" .. ستُسعفني","اسألْ؛ فآهي ورا أهدابيَ ..انسدلتْ",45,"ت",1,0],["ولا تُظهِروا أنّكم جثةٌ","على السفحِ إنّ النسورَ تُحَلِّقْ",46,"ق",1,0],["ولا تظني يوم يتغيّر وفاي","ألوفا أمطار مني تنهمر",47,"ر",1,0],["ولا تظني صلاة الوحي آتيةً","إنَّ المصلِّين بالإلهام قد عبروا",48,"ر",3,0],["ولا تظنوا هموم الدهر تقعدنا","إن الهموم ستحيي بيننا الهمما",49,"م",2,0],["ولا تَظُنَّنَ أَنَّ الوَهنَ دبَّ الى","عَضُدي، ولي مُتّكا، قدْ جاسهُ الدُخلا",50,"ل",2,0],["ولاتظنين التسامح لك خضوع","وأنتي طبعك للحقايق نافيه",51,"ف",3,0],["ولا تظنوا حلولا في مقالتنا","ولا اتحادا فما الأشياء أكفاء",52,"ا",2,0],["ولا تَظلمّنَ فلي نفسُ حُرٍّ أبيٍّ يثورُ على مَن ظَلمْ","وحاذرْ فإنّي إذا ما تماديتَ واخترتَ حربيْ فلن أنهزمْ",53,"م",1,0],["ولا تظهرن إنْ كنتَ تملك سترة ً","إل كلِّ ذي عينٍ بصورة ِ عربانِ",54,"ن",1,0]]}