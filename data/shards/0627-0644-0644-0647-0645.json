.com/ViewPoem.aspx?id=130325",""],[6056,"مفهوم الأذواق","https://www.poetsgate.com/ViewPoem.aspx?id=130522",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[5355,"وجع الخيانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87231&r=&rc=56",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["اللَهُ مَولاهُ وَالرَسولُ وَمِن","بَعدِهِما فَالوَصِيُّ مَولاهُ",0,"ه",1,0],["اللَهُ مَكَّنَ لِلخَليفَةِ جَعفَرٍ","مُلكاً يَحَسِّنُهُ الخَليفَةُ جَعفَرُ",1,"ر",1,0],["اللَهُ مِن حَولِكُم يَحمي جَوانِبَكُم","فَجاهِدوا لا تَخافوا كَيدَ إِنسانِ",2,"ن",1,0],["اللَّهُ مولاهم ونصرُ رسولِهِ","حَقٌّ عليهم في الكتابِ مُحتَّم",3,"م",1,0],["اللَّهُ مولاكم وأنتم شعبُهُ","لا تذكروا شعباً ولا إقليما",4,"م",2,0],["اللَه ما أَحلى الحتوف","فِدى البراق وَالحَرَم",5,"م",1,0],["اللَهُ مَولى دَنانيرٍ وَمَولائي","بِعَينِهِ مَصبَحي فيها وَمَمسائي",6,"ا",3,1],["الله ماذا حَمَّلت","كفُّ النوى هذا البدن",7,"ن",1,0],["الله ما هذا الجلال، حياتُهُ","ترنيمةٌ ومماتُه تبجيل",8,"ل",1,0],["الله من لطف","لاشك سواه",9,"ا",2,0],["الله من جبينه","حين بدا هلاله",10,"ل",2,0],["الله من ذاك الغزال فانها","ذابت بنار صدوده عشاقه",11,"ق",2,0],["الله من قيعان مي انها","لجنة محرقة بنارها",12,"ر",3,0],["الله من وجدنا فيكم وآه فكم","بذلك الشان اسرار خفيات",13,"ت",1,0],["الله من تلك الشمائل انها","مخلوقة للحرب والمحراب",14,"ب",1,0],["الله من داء الغرام فما له","ابدا سوى قرب الحبيب دواء",15,"ا",2,0],["اللَه من فتك العيون وفعلها","هي للمصيبة أعظم الأسباب",16,"ب",1,0],["اللَه من ألم تعاظم جرمه","حكماً ومن أمل تعذر نيله",17,"ل",2,0],["اللَهُ مَكَّنَهُ لَهُ وَأَذَلَّهُ","حُكمُ السُيوفِ لَنا وَجَدٌّ مِزحَمُ",18,"م",1,0],["اللَهَ مِن قُبَلٍ طَرَفتُ بِها دَمي","قوتاً وَلم تَدنَس بِها الشَفَتانِ",19,"ن",1,0],["الله ملَّكك الدنيا وساكنَها","والله أعطاك ما لم يعطه أحدا",20,"د",2,0],["اللَه ما الدنيا وفتنتها","ما الدهر ما المقدور ما القدر",21,"ر",1,0],["اللَه ما أحلاك يا طفلتي","وما احيلى جيدك الاملس",22,"س",1,0],["الله متخصٌّ بمنحته","للصائمين، وعنده الذُّخْرُ",23,"ر",1,0],["اللَه ما أبهى شعاع حسنها","وما أحيلى عندنا دلالها",24,"ل",3,0],["آلٌ لَهُم مِن رَسُولِاللهِ إذ نُسِبُوا","ومِن عَليٍّ وَمِن آبائِهِم آلُ",25,"ل",1,0],["اللهُُ مِن تائِهٍ لَم تُبقِ صُورَتُهُ","شَخصاً يُماثِلُهُ في الدَّلِ والتّيهِ",26,"ي",2,0],["اللَه ما بعد هذا اليوم مصطبرٌ","للمسلمين ولو راموا أذن عذروا",27,"ر",3,1],["الله ما أعلى مرامي ظنه","طبق القضا في شأن كل ظنين",28,"ن",1,0],["اللَهُ مَكَّنَ في البِلا","دِ لَهُ فَسَوّاهنُّ حُكما",29,"م",2,0],["اللَّهُ مِن حبِّه إِيّاكَ في مَرض","قَدِ اِبتَلاكَ لِقربٍ مِنهُ يُدنيكا",30,"ك",2,0],["اللَّه مِن حبّه إِيّاكَ مُفتَقِدٌ","لُطفاً بِذلِكَ لا مَسَّتْكَ بَأساءُ",31,"ا",2,0],["اللَّه ملكه الأشياءَ فانْقلَبتْ","بأمره سهلةً مِنْ غير تعسْير",32,"ر",1,0],["اللَه من سحر أرا","نا ثائراً في زي رائد",33,"د",1,0],["الله من ظبي غدا","يلهو بلبّي أبدا",34,"د",2,1],["الله من ليل تفرّد حسهُ","وقف الزمان به ورد الفربد",35,"د",1,0],["الله من غد هذه الدن","يا السخية بالفجور",36,"ر",1,0],["اللّه ما نوح الحمام ببالغي","نوحا ولا صوب الغمام بمدركي",37,"ك",2,0],["الله ما أحلى دلالك","رنت العيون فصن جمالك",38,"ك",1,1],["الله ما أحلاك في ناظري","يا منبع الألهام للخاطر",39,"ر",1,1],["اللّهَ ماتَ الحلمُ في البرعم","وكان حلم الليل والأنجم",40,"م",1,1],["أللهمم المنوطة بالثريا","أم الشيم المهذبة الحسان",41,"ن",1,0],["الله مِنْ قَلْبٍ تعثر بنبضه","مِثْل السحاب يسوق بعضه ولا راض",42,"ض",1,1],["الله ما زال للأسماع يسمعه","بما يقرِّره شرعاً ويذكره",43,"ر",2,0],["اللَه ما هَذا الغَزال","أَرَأَيتَ حينَ رَنا وَمال",44,"ل",1,1],["الله من صبر الحسين به","حاطت ذوو الأحقاد والضغن",45,"ن",1,0],["اللَه ما ذا الحادِث الجلل","قَد دَكَّ من السهل والجبل",46,"ل",1,1],["اللهُ ملّكهُ وليس بسالبٍ","منه الذي أولاه من نعماء",47,"ا",2,0],["اللهِ مَلّكَه أمور عباده","لما رأه أرحم الرحماء",47,"ا",2,0],["الله مَدّ على الخلائق ظِلَّهُ","ببقائه فهم الجميعُ له الفِدَا",48,"د",2,0],["اللَه ما أَكرمه مَنزِلا","فيهِ تراح الأُنفُس المُتعبه",49,"ب",2,1],["الله ملّكه حمى الإسلام وال","أحكامَ والحرم الحرام وأكدا",50,"د",2,0],["اللَه من كبد يمزقها الجوى","حزناً وقلب بالمصاب يذوب",51,"ب",1,0],["اللَه ما حال العليل وقد رأى","تلك المدامع للوداع تسيل",52,"ل",1,0],["الله منَّ على الإنام بملكه","لولاه كانوا في دجى عشواء",53,"ا",2,0],["الله! مَا أَطْيَبَ التَّارِيْخَ فِيْ حِقَبٍ","بِهَا النبي عَلىْ عَرْشٍ مِنَ الدُّرَرِ",54,"ر",1,0],["اللَهُ ما أعظَمَهُ من يَومِ","أزالَ صبري وأطارَ نَومي",55,"ي",1,0],["اللَه ما أعظَمَها صلافة","مثلُ يزيد يدعي الخلافة",56,"ه",1,0],["اللَه ما لم نعد للدين يحفظنا","ساء المصير فنحن الأمة الهمل",57,"ل",1,0],["الله ما فعلت وهل تدري بما","فعلت بعترة أحمد المختار",58,"ر",1,0],["الله من يسمح في مهجته","تلحد ما بين صفاً وجلمد",59,"د",1,1],["اللَه ما يَلقى العَلي","م حيالَ جهلِ الجاهلينا",60,"ن",2,0],["اللَه ماذا جَرى به قلمي","وَما الَّذي قَد حَواه ذا الطرسُ",61,"س",1,0],["اللَهُ ما أَكبرها همّة","بِجَنبها الأَفلاك تستصغرُ",62,"ر",1,0],["الله من دهرٍ جفا أهل الابا","وشملهم صيره أيدي سبا",63,"ب",2,1],["الله ماذا تصنع الأيام في","شأن الأماجد من عظيم جرائم",64,"م",1,0],["الله مثل مسلمٍ يرمىبه","منكساً والكون لم ينقلبا",65,"ب",2,0],["الله ماذا كابدت زينب","وقابلته برضى واصطبار",66,"ر",1,0],["اللهم والي من والا وعاد لمن","عاداه واخذل الهي من يناويه",67,"ي",2,0],["اللَه من نفثات سحر قد حوت","أجفانها الكحلا ومن تفنيدها",68,"د",3,0],["اللهُ مَلَّكَكَ البَسِيطَةَ وَفقَ مَا","نطَقَت بِذَلِكَ ألسُنُ الأجفَارِ",69,"ر",1,0],["اللهم رب الستين ورب المشعر","ورب من حج له وكبر",70,"ر",1,1],["اللهم رب الأربعين إذا بلغت","أنج بني من قداح كتبت",71,"ت",1,1],["اللَه ما نحهُ فارّخهُ","غُلامُ مُوسَى مِنحةُ اللَهِ",72,"ه",1,0],["اللَّهُ معكَ وناظرٌ إليكَ وشا","هدٌ عليكَ بما يكونُ فاحتشمِ",73,"م",1,0],["الله من شمل تفرق","والصفاء على جنوح",74,"ح",1,0],["الله من ماض أطل","عليَّ كالنسر الجريح",74,"ح",1,0],["اللهمَّ أَنزِل فيه خَيرَ موائِدٍ","مُختارَةٍ إِذ أَنَّها تُختارُ",75,"ر",1,0],["اللُّهُمَّ إِلَّا أَن","يَكونَ القرضُ ما تَرضى",76,"ض",2,0],["اللّه ما فعلت أميّة","ببني المطهّرة الزكيّة",77,"ي",2,1],["الله ما قاسا به","كبد البتولة من سميّة",77,"ي",2,0],["الله من يوم نواه الذي","أودع في الأحشاء ما أودعا",78,"ع",2,0],["الله ملّكه البديعَ بفنه","وبخُلْقِهِ فهو البديعُ تناهى",79,"ا",3,0],["الله من عين ن نظرها نصايف","وكبدن عيوف وكل شي تلوفه",80,"ف",2,1],["الله من قلب ن من الهم متروس","وصدرن من الضيقه خطر يفجر الكيس",81,"س",1,1],["الله من قلب ن لهمه يزمه","لينه ثقل وازرا يشيله ويخفيه",82,"ي",2,1],["الله من نار تقل تزفر ازفار","وضلوع صدري ياعرب مجتذبهاا",83,"ه",3,1],["الله من فكري اذا خيم الليل","يسرح على ضو القمر من مكانه",84,"ن",2,1],["الله ما يهمل الظالم ويمهل له","وان طال به عمره اخس شوي واردى له",85,"ل",2,0],["اللهُ مِن حِقدٍ دَفِينٍ إذا","ما استَنهَضَ الطَّغْوَى وقَطعَ السَّبيلْ",86,"ل",1,0],["الله من العزه عطى ثم وهبنا","طبع ٍ يميزنا على كل الأشناب",87,"ب",1,0],["الله ! ما أبهى امتطاءك نسمةً","فتظلُّ تومضُ خُلسةً أوضاحُك",88,"ك",1,0],["الله ما أنقى انتقاءك روضةً","كي تعتلي أزهارَها أفراحُك",88,"ك",1,0],["اللهُ من طُهرٍ عليهِ بكت","عينُ السماءِ بمحفلِ الحَزَنِ",89,"ن",1,0],["الله من كيد العذارء المفاتين","يتمنعن لو راغبات التودد",90,"د",1,0],["الله من دهر صروفه اشفقتله","به عيشة ضنكى وعاليه مرجوم",91,"م",1,0],["الله منصفنا بالوصل منك على","غيظ الرقيب بمن قد حج واعتمرا",92,"ر",2,0],["اللهُ منها اصطفى للخلقِ قاطبةً","محمدًا خيرَ من تسمو به الرُتَبُ",93,"ب",1,0],["الله محيّكم عدد مزن الامطار","والله محيّكم عدد رمل الصحاري",94,"ر",2,0],["الله من يركن على البدو ويميل","عز الله أنه ساندٍ في جبلّه",95,"ل",2,0],["اللهُ من منحَ الجمالَ تكرماً","جوداً ومن خيراته أعطاكِ",96,"ك",1,0],["اللهُ من وهبَ الجمالَ وأبدعت","يده فجلَ اللهُ من سواك",96,"ك",1,0],["اللهُ مَا أَحْلَى الرُّؤَى","فَالْوِدُّ تَوْقٌ مِنْ لَدُنَّا",97,"ن",2,0],["اللهُ مَا أحْلَى عَصَائِر خَمْرِهِ","حِيِنَ اسْتُشِفَّ الْرَّاحُ فِي الأَقْدَاحِ",98,"ح",1,0],["اللهُ مَا أحلَى زُلالِكَ سَيِّدِي","شَلاَّلُ نَهْرٍ خَرَّ سَيْلاً كَوْثَرَا",99,"ر",2,0],["اللهُ مَا أَحْلَى رَبِيِعَكِ حُلْوَتِي","كُلُّ الزُّهُورِ تَغُضُّ فِي دَوْحَاتِهَا",100,"ت",3,0],["اللهَ ما تلكَ العيونُ؟ تؤمُّني","من سحرِهنَّ وقائعٌ وفتوحُ",101,"ح",1,0],["اللهُ مركزُ كلِّ شيءٍ دائرٍ","حولَ الحقيقةِ يبتغي تصويرَها",102,"ر",3,0],["أللهُ .. ماذا أرى ..؟ يا روعةً سكنتْ","قلبي وما بعدَها كاللحنِ فيهِ غِنا",103,"ن",2,0],["اللهُ مَيزنِي لِأصبحَ درةً","واختارنِي الرحمنُ للقرآنِ",104,"ن",1,0],["الله من نو مزونه مراديف","برقه ينوض وراعديه يدنا",105,"ن",2,1],["الله من موقٍ تكدر مباته","لو الكرى يشرا وينباع ل اشريه",106,"ي",2,1],["الله من شدو القوافي للمها","نظمٌ يرقّ كسلسبيل الماءِ",107,"ا",2,0],["الله من أعطى ومن أغنى وما","ربٌّ سواهُ..يجودُ بالآلاءِ",108,"ا",2,0],["اللهَ!.. ما هَذَا الجَلالُ؛ ومَا أَرَى","رُوحَينِ مِن أَلَقٍ ومِن إِكْبَارِ؟!",109,"ر",1,0],["الله ُ... ماذا لو أراكِ غدًا","في غابةٍ تمتدّ ُ لي يَدُ كِ",110,"ك",1,0],["الله مثل ذاته ولها","بين العوالم يضرب المثل",111,"ل",1,0],["الله من شي بحالي نحفها","من مالجى بالقلب حالي نحيفه",112,"ف",2,1],["الله من عين طرقها صواديف","عميت ويبسن بالعروق الصخافي",113,"ف",2,1],["الله من صوت على الشوق جبته","والله على كلمة غلا في كتابي",114,"ب",2,0],["الله من المكروه والشر ياقاه​","ويسلمه من كل مكروه يرميه​",115,"ي",2,0],["الله معك والدرب قدامك سوي","والله يبلغك المنال",116,"ل",1,0],["الله من أتقن الخلق البديع ومن","يزيد في الخلق مهما شاء مقتدرا",117,"ر",2,0],["اللهً من ضيقٍ على نفسي اجزلْ","من وين ماعفته .. لقيته يحاتي !!",118,"ت",2,0],["اللهم إني متيم على حبه وأهيم","خاتم الرسل وسراج الفصاحه والبيان",119,"ن",1,1],["الله .. ما أبهىٰ السحابَ وقد رقىٰ","بين الجبالِ .. وصاغ رسما آسِرا!",120,"ر",2,0],["الله من هم بالاضلاع غطاس","اقام وسط القلب وابطى شديدة",121,"د",2,0],["الله من قلب همومه تلفه","باقصى فوادي موجعات تخلف",122,"ف",1,0],["الله من هم بلاعماق مخفيه","خيم على مكنون قلبي وكادي",123,"د",2,1],["الله مدّبر فيكم العدل تدبير","ومعكم يسود امن البلاد ونظامه",124,"م",2,0],["اللهُ ما سَكَنَتْ قَلْبًا فَبَاتَ لَهُ","فِي ظِلِّهَا مِنْ مُعَانَاةٍ يُعَانِيهَا",125,"ي",3,0],["اللهُ مَا رَتَّلَ الوِجْدَانُ رَوْعَتَهَا","إِلَّا وَأَمْسَى قَرِيرَ النَّفْسِ رَاضِيهَا",125,"ي",3,0],["الله ما أحلى القصيدَ وما نثرْ","مما اصطفاهُ الحرفُ من أرقى الفِكرْ",126,"ر",1,1],["الله مولاهم فحلوا عنده","بجلاله وتدللت حوباه",127,"ا",2,0],["الله مصْدرُ فكرنا وشعورنا","وإذا اتّبعناه فحتماً نتَّحدْ",128,"د",1,0],["الله ما ظلمَ العبادَ وإنَّما","من ظلمهمْ ساد الظلامُ على القُرى",129,"ر",2,0],["الّلهمّ( الْكافي) ، تعاليت علوًّا","فاكْفني شرًّا ، قدْ غدا كالْوباء",130,"ا",2,0],["اللَّهُمَّ احمِ دارَ صدقٍ وحقٍّ","منِ حَقُودٍ ، مِنَ العِداِ والعَدَاءِ",131,"ا",2,0],["الله من ليل ٍ، غشى الطرف ماانام","سهران وراسي ،، مرتكي له بكوعي",132,"ع",2,0],["الله ، من ليل ٍ لحيّك ، تعنيّت","وأرجع وراس المال دمعات وشهاق",133,"ق",1,0],["الله ما أسناك يا كوكب","زها بك المشرق والمغرب",134,"ب",1,1],["الله ما أقسى الحنين إذا مضى","ورمى الفؤاد بقربه يتعلقُ",135,"ق",1,0],["اللهُ مازكَ من جميعِ عبادهِ","مِن رُسْلهِ وأمينِه جبريلا",136,"ل",2,0]]}