{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[35,"أمن آل سلمى الرسم أنت مسائل","https://www.aldiwan.net/poem39112.html","الطويل"],[35,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[54,"أتيت ابن عمران في حاجة","https://www.aldiwan.net/poem27623.html","المتقارب"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"تطاول بالخمان ليلي فلم تكد","https://www.aldiwan.net/poem21259.html","الطويل"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[85,"غورست رب السمكة","https://www.aldiwan.net/poem7253.html","مجزوء الرجز"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[105,"أخا الدهر ما الدهر إذ ينسب","https://www.aldiwan.net/poem43389.html","الكامل"],[105,"غوى الناس حتى لا صواب ولا رشد","https://www.aldiwan.net/poem43420.html","الطويل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"أوالي هذا المصر في زي واحد","https://www.aldiwan.net/poem23213.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[15,"دعا معاشر فاستكت مسامعهم","https://www.aldiwan.net/poem45275.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55096","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43648","الطويل"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""]],"verses":[["غَوثُكَ مِنها يا غِياثَ الوَرى","قَد ثَقُلَ العِبءُ عَلى المَهرَمِ",0,"م",1,0],["غَوادٍ مِنَ الأَشراطِ وَطفٌ تُقِلُّها","رَوائِحُ أَنواءِ الثُرَيّا الهَواطِلُ",1,"ل",1,0],["غَوامِضُ كَالعُقبانِ إِن هِيَ أُرسِلَت","وَإِن أُمسِكَت عَن غَربِها نَقَلَت نَقلا",2,"ل",2,0],["غَوارِثَ تَشكو إِلى رَبِّها","أَطالَ السَبيعِيُّ إِغراثَها",3,"ث",3,0],["غَوارِثَ تَشكو إِلَيَّ الخَلا","أَطالَ اِبنُ عِمرانَ إِغراثَها",4,"ث",3,0],["غواربُ في بحر السراب تخالها","وقد سبحت فيه مواخرَ غربانِ",5,"ن",1,0],["غوثُ العبادِ ولَيْثُ مشتجرِ القَنَا","يومَ الطعانِ وفارجُ الغماءِ",6,"ا",2,0],["غَوانٍ هُنَّ أَخبَثُ مِن حَميرٍ","وَأَمجَنُ مِن نِساءٍ مُشرِكاتِ",7,"ت",1,0],["غَوَامِض في العَجَاجَةِ مُصعَبات","بِكَذَّانِ الأمَاعِزِ يَرتَمِينَا",8,"ن",2,0],["غَوائِرَ تَترى مِن نُجومٍ تَخالُها","مَعَ الصُبحِ تَتلوها زَواحِفَ لُغَّبا",9,"ب",2,0],["غولٌ يبيت الشّرب من قبحِها","يرون في النوم التهاويلا",10,"ل",2,0],["غوادٍ لا تفرّطُ أو سوارٍ","روائمُ لا يزالُ لها رِزامُ",11,"م",1,0],["غولُ النَجاءِ كَأَنَّها مُتَوَجِّسٌ","بِاللُبنَتَينِ مُوَلَّعٌ مَوشومُ",12,"م",1,0],["غورست رب السمكة","ذاك بشير البركة",13,"ك",2,1],["غَوى رَأيُ نَفسٍ لا تَرى أَنَّ وَجدَها","بِتِلكَ الغَواني شُقَّةٌ مِن عَذابِها",14,"ب",3,0],["غُولاً تسنَّمتُ لم أسألْ أكارعَه","إلى الهُوَى، أمْ على الواحات ترميني",15,"ن",2,0],["غُودِرَتْ في الشّرق فوضى فانبرى","ينشرُ الدُّستورَ فيها والنّظاما",16,"م",2,0],["غَوَتِ النُّفوسُ فَسَادَ كلُّ مخادعٍ","ومَضى بأمرِ القوم كلُّ مُراءِ",17,"ا",2,0],["غواربُ تسمو من حديدٍ ومن دمٍ","بِجأواءَ لم يَصنعْ لها الفُلكَ صانعُ",18,"ع",1,0],["غَوى العُلَماءُ فَالأَخلاقُ فَوضى","جَوامِحُ ما تَريعُ وَما تَلينُ",19,"ن",1,0],["غَوالِبَ تَأخُذُ أَقصى المَدى","وَيَأخُذُها القَدَرُ الأَغلَبُ",20,"ب",1,0],["غَوى الناس حَتّى لا صَوابٌ وَلا رُشدُ","وَضلّوا فَلا رُسلٌ تُطاعُ وَلا جُندُ",21,"د",1,1],["غُودِرَا في جانبِ الوادي وما","يَجلِبُ الأمرَ سوى أسبابهِ",22,"ه",1,0],["غُوَيرِثُ رُمْتَ أمراً مستحيلا","فهل لك أن تثوبَ وأن تريعا",23,"ع",2,0],["غَوجِ اللَبانِ إِذا اِستَحَمَّ وَضينُهُ","وَجَرى حَميمُ دُفوفِهِ المُتَفَصِّدُ",24,"د",1,0],["غَوامِضُ في النَقعِ سُجعُ الخُدود","مُشايِحَةٌ في الوَغى كالِحَه",25,"ح",2,0],["غولُ البِلادِ إِذا المُقيلُ تَحَرَّقَت","آرامُهُ وَجَرَت بِماءِ سَرابِهِ",26,"ب",2,0],["غَوى لَيلُ مُثرٍ فَاِستَقَلَّ بِفِتنَةٍ","وَقَد رَخُصَت لِلسائِمينَ غَوالِ",27,"ل",1,0],["غُواةٌ إذا النّكباءُ حَفّتْ بيوتَهْم","أقاموا لها الفُرْسانَ في كلّ مَرْصَدِ",28,"د",1,0],["غَوَّت بَنو أَسَدٍ غَسّانَ أَمرَهُمُ","وَقَلَّ ما وَقَفَت غَسّانُ لِلرَشدِ",29,"د",1,0],["غوائثُ الأرضِ إذا أقلعتْ","حواملُ الغيث الدفوقِ الهتونْ",30,"ن",1,0],["غَوَافِلُ لا يَعْرِفْنَ بُؤْسَ مَعِيشَةٍ","وَلا هُنَّ بِالْخَطْبِ الْمُلِمِّ شَواعِرُ",31,"ر",1,0],["غوَّاصُ فِكْرٍ فِي كُلِّ بَحْرٍ","يَصِيدُ لِلشِّعْرِ مَا يَصِيدُ",32,"د",1,0],["غَوْثُ اللَّهِيفِ أَبَرُّ فِي مِيقَاتِهِ","مِنْ وَعْدِهِ بِغِنًى بَعِيدِ مَنَالِ",33,"ل",1,0],["غَوْثَ اللَّهِيفِ أَلاَ تُجَارُ وَقدْ","غَلَّ الضَّنَى من بَأْسِ أَيديكا",34,"ك",2,0],["غَوى القَلبُ فيهِ وَهوَ لَولاهُ راشِدٌ","وَمَلآن مِنهُ وَهوَ لَولاهُ فارِغُ",35,"غ",1,0],["غُوصُوا بأغْوار الشبِيِبَة، وانْفُذُوا","من كُلّ بَابٍ مُحْكَم الأقْفالِ",36,"ل",1,0],["غولٌ تغول الطفلَ من يد أمه","بسُعارها والكاعبَ الرُّعبوبا",37,"ب",2,0],["غوْثَ الصريخِ ، أتتك تُعوِلُ حُرَّةٌ","حَّراءُ صارخةٌ من الأشعار",38,"ر",1,0],["غوطةُ الشامِ جحيمٌ فائرٌ","والميادينُ طعانٌ ورماء",39,"ا",2,0]]}