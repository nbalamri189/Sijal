.net/poem56531.html","الكامل"],[305,"بشرى فذا صبح التهاني أسفرا","https://www.aldiwan.net/poem56548.html","الكامل"],[364,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[364,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[364,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[403,"صدرت لإِهداء السلام","https://www.aldiwan.net/poem33429.html","مجزوء الكامل"],[409,"حيا ربوعك من ربى ومنازل","https://www.aldiwan.net/poem31851.html","الكامل"],[416,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[416,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[437,"عم الندى وتواتر الإنعام","https://www.aldiwan.net/poem2560.html","الكامل"],[441,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[458,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[461,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[461,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[464,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[468,"لمحسن بن الملح خطو ضيق","https://www.aldiwan.net/poem59542.html","الكامل"],[468,"أمحسن بن الملح لا تك تائها","https://www.aldiwan.net/poem59871.html","الكامل"],[477,"حن فأجرى للنوى دموعا","https://www.aldiwan.net/poem15204.html","السريع"],[495,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[500,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[500,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[500,"ما قول هند إذا ما صدها القدر","https://www.aldiwan.net/poem37697.html","البسيط"],[500,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[500,"جرد لبر الشرق همة زائر","https://www.aldiwan.net/poem38011.html","الكامل"],[500,"شيخ لنا ثاو بأم عبيدة","https://www.aldiwan.net/poem38039.html","الكامل"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"]],"verses":[["غَوثُكَ مِنها يا غِياثَ الوَرى","قَد ثَقُلَ العِبءُ عَلى المَهرَمِ",0,"م",1,0],["غَوادٍ مِنَ الأَشراطِ وَطفٌ تُقِلُّها","رَوائِحُ أَنواءِ الثُرَيّا الهَواطِلُ",1,"ل",1,0],["غَوامِضُ كَالعُقبانِ إِن هِيَ أُرسِلَت","وَإِن أُمسِكَت عَن غَربِها نَقَلَت نَقلا",2,"ل",2,0],["غَوارِثَ تَشكو إِلى رَبِّها","أَطالَ السَبيعِيُّ إِغراثَها",3,"ث",3,0],["غَوارِثَ تَشكو إِلَيَّ الخَلا","أَطالَ اِبنُ عِمرانَ إِغراثَها",4,"ث",3,0],["غواربُ في بحر السراب تخالها","وقد سبحت فيه مواخرَ غربانِ",5,"ن",1,0],["غوثُ العبادِ ولَيْثُ مشتجرِ القَنَا","يومَ الطعانِ وفارجُ الغماءِ",6,"ا",2,0],["غَوانٍ هُنَّ أَخبَثُ مِن حَميرٍ","وَأَمجَنُ مِن نِساءٍ مُشرِكاتِ",7,"ت",1,0],["غَوَامِض في العَجَاجَةِ مُصعَبات","بِكَذَّانِ الأمَاعِزِ يَرتَمِينَا",8,"ن",2,0],["غَوائِرَ تَترى مِن نُجومٍ تَخالُها","مَعَ الصُبحِ تَتلوها زَواحِفَ لُغَّبا",9,"ب",2,0],["غولٌ يبيت الشّرب من قبحِها","يرون في النوم التهاويلا",10,"ل",2,0],["غوادٍ لا تفرّطُ أو سوارٍ","روائمُ لا يزالُ لها رِزامُ",11,"م",1,0],["غولُ النَجاءِ كَأَنَّها مُتَوَجِّسٌ","بِاللُبنَتَينِ مُوَلَّعٌ مَوشومُ",12,"م",1,0],["غورست رب السمكة","ذاك بشير البركة",13,"ك",2,1],["غَوى رَأيُ نَفسٍ لا تَرى أَنَّ وَجدَها","بِتِلكَ الغَواني شُقَّةٌ مِن عَذابِها",14,"ب",3,0],["غُولاً تسنَّمتُ لم أسألْ أكارعَه","إلى الهُوَى، أمْ على الواحات ترميني",15,"ن",2,0],["غُودِرَتْ في الشّرق فوضى فانبرى","ينشرُ الدُّستورَ فيها والنّظاما",16,"م",2,0],["غَوَتِ النُّفوسُ فَسَادَ كلُّ مخادعٍ","ومَضى بأمرِ القوم كلُّ مُراءِ",17,"ا",2,0],["غواربُ تسمو من حديدٍ ومن دمٍ","بِجأواءَ لم يَصنعْ لها الفُلكَ صانعُ",18,"ع",1,0],["غَوى العُلَماءُ فَالأَخلاقُ فَوضى","جَوامِحُ ما تَريعُ وَما تَلينُ",19,"ن",1,0],["غَوالِبَ تَأخُذُ أَقصى المَدى","وَيَأخُذُها القَدَرُ الأَغلَبُ",20,"ب",1,0],["غَوى الناس حَتّى لا صَوابٌ وَلا رُشدُ","وَضلّوا فَلا رُسلٌ تُطاعُ وَلا جُندُ",21,"د",1,1],["غُودِرَا في جانبِ الوادي وما","يَجلِبُ الأمرَ سوى أسبابهِ",22,"ه",1,0],["غُوَيرِثُ رُمْتَ أمراً مستحيلا","فهل لك أن تثوبَ وأن تريعا",23,"ع",2,0],["غَوجِ اللَبانِ إِذا اِستَحَمَّ وَضينُهُ","وَجَرى حَميمُ دُفوفِهِ المُتَفَصِّدُ",24,"د",1,0],["غَوامِضُ في النَقعِ سُجعُ الخُدود","مُشايِحَةٌ في الوَغى كالِحَه",25,"ح",2,0],["غولُ البِلادِ إِذا المُقيلُ تَحَرَّقَت","آرامُهُ وَجَرَت بِماءِ سَرابِهِ",26,"ب",2,0],["غَوى لَيلُ مُثرٍ فَاِستَقَلَّ بِفِتنَةٍ","وَقَد رَخُصَت لِلسائِمينَ غَوالِ",27,"ل",1,0],["غُواةٌ إذا النّكباءُ حَفّتْ بيوتَهْم","أقاموا لها الفُرْسانَ في كلّ مَرْصَدِ",28,"د",1,0],["غَوَّت بَنو أَسَدٍ غَسّانَ أَمرَهُمُ","وَقَلَّ ما وَقَفَت غَسّانُ لِلرَشدِ",29,"د",1,0],["غوائثُ الأرضِ إذا أقلعتْ","حواملُ الغيث الدفوقِ الهتونْ",30,"ن",1,0],["غَوَافِلُ لا يَعْرِفْنَ بُؤْسَ مَعِيشَةٍ","وَلا هُنَّ بِالْخَطْبِ الْمُلِمِّ شَواعِرُ",31,"ر",1,0],["غوَّاصُ فِكْرٍ فِي كُلِّ بَحْرٍ","يَصِيدُ لِلشِّعْرِ مَا يَصِيدُ",32,"د",1,0],["غَوْثُ اللَّهِيفِ أَبَرُّ فِي مِيقَاتِهِ","مِنْ وَعْدِهِ بِغِنًى بَعِيدِ مَنَالِ",33,"ل",1,0],["غَوْثَ اللَّهِيفِ أَلاَ تُجَارُ وَقدْ","غَلَّ الضَّنَى من بَأْسِ أَيديكا",34,"ك",2,0],["غَوى القَلبُ فيهِ وَهوَ لَولاهُ راشِدٌ","وَمَلآن مِنهُ وَهوَ لَولاهُ فارِغُ",35,"غ",1,0],["غُوصُوا بأغْوار الشبِيِبَة، وانْفُذُوا","من كُلّ بَابٍ مُحْكَم الأقْفالِ",36,"ل",1,0],["غولٌ تغول الطفلَ من يد أمه","بسُعارها والكاعبَ الرُّعبوبا",37,"ب",2,0],["غوْثَ الصريخِ ، أتتك تُعوِلُ حُرَّةٌ","حَّراءُ صارخةٌ من الأشعار",38,"ر",1,0],["غوطةُ الشامِ جحيمٌ فائرٌ","والميادينُ طعانٌ ورماء",39,"ا",2,0],["غوطة الشام هل شجاك بيان","من قريضي كأنّه التنزيل",40,"ل",1,0],["غوطة الشام منك صدّ وحرم","ان ومنّا العطاء والتنويل",40,"ل",1,0],["غوثاه يا آل البتول فانكم","خفقت بكم بين الملا اعلامي",41,"م",2,0],["غوثاه وارحم عاشقا فانيا","اعناه من جدك شيل النطاق",42,"ق",1,0],["غوث على قدم الرسول سلوكه","ولغيره في سلكه اطوار",43,"ر",1,0],["غوثاه يا ايها الفاروق خذ بيدي","فالذنب اسكت نطقي كيف اعتذر",44,"ر",1,0],["غوث الثقلين ضياء العي","ن امام الدين مجدده",45,"د",2,0],["غوث على اردانه مسك العبا","بطراز احوال الرسول يفوح",46,"ح",1,0],["غوث به الله احى الدين فهو بمح","ي الدين في القوم معروف ومنعوت",47,"ت",1,0],["غوث الورى المهدي شيخنا الذي","عن الوجود بالشهود انلسبا",48,"ب",2,0],["غوثاه يا شرف الوجود فانني","لم يرتفع الا اليك ندائي",49,"ا",2,0],["غوثاً وعوناً سادتي يا سادتي","فالدمع قد أعيا من إرساله",50,"ل",2,0],["غوث الزمان أبي علي صاحب الس","ر الجلي وكوكب الإفراد",51,"د",1,0],["غوثاه يا صياد يا ابن السا","دة الأجواد آل السادة الأجواد",51,"د",1,0],["غوث شموس سماء دولته انجلت","في الشرق ثم سرت إلى الأكوان",52,"ن",1,0],["غوثاه بالمصطفى والمرسلين وفي","كل الصحابة أهل المجد والهمم",53,"م",1,0],["غوثاه يا ابن رسول اللَه خذ بيدي","يا سيد الوليا يا ثابت القدم",53,"م",1,0],["غوث أهل الطريق بحر المعاني","بدر فضل لازال يعلو ضياه",54,"ا",2,0],["غوثاه يا سر الورى","يا حاضراً متى ندب",55,"ب",1,0],["غوث الطريقة بعد عدمها عتقا","غيث الخليقة فهو غيثها العتق",56,"ق",1,0],["غوثٌ به الغيث والأوفاض وافضة","إليه ليس لها سواه مفترضا",57,"ض",2,0],["غُودِرَت في مَذَلَّةٍِ واكتِئَابٍ","وهوَ إِنٍ وغُربِةٍ لَن تَرِيمَا",58,"م",2,0],["غَوثِ البَرَايَا ثِمَالِ المُرمِلينِ إِضَا","ضِ المُزعَجِينَ العَتَادِ المَعقِلِ الوَزَرِ",59,"ر",1,0],["غَواربُهُم بِالمَشرَفيَّةِ تُختَلى","وَهامُهُمُ بِالسَمهَريَّةِ تُتلَغُ",60,"غ",1,0],["غودِرتُ بَعدَهُم أَسيرَ صَبابَةٍ","كَمَداً يُغَصِّصُني الشَرابُ السائِغُ",61,"غ",1,0],["غورِيَّةٌ تَعلو الغُصونَ كَأَنَّما","أَهدى لَها الطَوقَ المُؤَلَّفَ صائِغُ",61,"غ",1,0],["غوثايَ منهُ فما ينفكَ يُقلقني","بسفرةٍ تَقتْضي تقويضَ أطنابي",62,"ي",1,0],["غوايتي أهلكت شبابي","فقل كما شئت في العقاب",63,"ب",1,0],["غوائلُ دهرٍ عاقني عن لقائه","تخاف فوا حزني متى اتفرغ",64,"غ",1,0],["غوايهُ جهلٍ قد بكيتُ دماً لها","فرُحت وخدِّي من دُمُوعي يُصبغ",64,"غ",1,0],["غواضبُ يومَ الحربِ للحقِّ والهدُى","وأمّا لأخذِ الثأرِ فهي كواظِم",65,"م",1,0],["غوث لِمُلتَجىء غيث لمنتجع","ليث عَلى ملة الاسلام ريمال",66,"ل",1,0],["غوثان ان عدت العَوادي أوقسا","قلب الزَمان فَما أَبر وَأَرحَما",67,"م",2,0],["غَوالِبُ فَتْكٍ لَمْ يَصُلْنَ بِقُوَّةٍ","طَوالِبُ ثَأْرٍ لَمْ يَبِتْنَ عَلَى حِقْدِ",68,"د",1,0],["غُوارِبُ أَحْياناً طَوالِعُ كُلَّما","هَبَطْنَ فَضا سَهْلٍ عَلَوْنَ مَطا حَزْمِ",69,"م",1,0],["غواصها ان غاص لا","يدري لعاديه مقر",70,"ر",1,0],["غوت البرية كلها ومغيثها","عن إذن سيده الكريم العادل",71,"ل",1,0],["غوث العباد وغيث للبلاد به","تحيا الجدود ويروى كل عطشان",72,"ن",1,0],["غوثٌ تضلّع مِن مَواردِ جدّهِ","بِالمشربِ الأهنا وحوض الكوثرِ",73,"ر",1,0],["غوثٌ إِذا ما الغيثُ عزَّ نواله","سحّت جداه يديه غيثاً ممطرا",74,"ر",2,0],["غَوْثُ الأفاضلِ في زمانِ أراذِلٍ","فكأنّه عَلَمٌ أُقيمَ بمَجْهَل",75,"ل",1,0],["غَوّاصُ بَحْرِ يَمينِه قَلَمٌ","يَمتارُ منه اللُّؤْلُؤُ النَّسق",76,"ق",1,0],["غواربُ أقمارٍ جوانحُ للنَّوى","وقد حَمَلتْها العيسُ فوق غَوارب",77,"ب",1,0],["غَوالبُ أشواقٍ أُتيحتْ حوادثٌ","غوالبُ من دهري لتلك الغوالب",77,"ب",1,0],["غوث الورى غيث الندى","محيي الشريعة للأنام",78,"م",1,0],["غَوثاً لملهوفٍ وملجأَ لاجِئٍ","وجوارَ رَبّ جَرائرٍ وطَوائِلِ",79,"ل",1,0],["غَوثُ الصَّريخ المستجير ببابه","لا مُعرضٌ عنهُ ولا متواني",80,"ن",2,0],["غوث الصريح إذا دُعي لملمَّةٍ","في كشفه الأَخطار أيّ مبادر",81,"ر",1,0],["غوّدتني بندي يديك فصار لي","في مدحكمُ أمد الزمان غرام",82,"م",1,0],["غواد غير مخلفة سقته","حيا متداركاً غدقا وليا",83,"ي",2,0],["غواربُها بعضاضِ القُتو","د من بزّ أوبارها تُنسَلُ",84,"ل",1,0],["غوارب فارتجعت إليَّ طَرفي","يناشد ذا الأراكِ متى الطلوعُ",85,"ع",1,0],["غوّروا غورةَ النجوم وبقَّوا","عَلَماً ردّ طيَّهم منشورا",86,"ر",2,0],["غوادٍ من الحمدِ والإعتراف","غوارفُ من كلِّ عذبٍ غِزارُ",87,"ر",1,0],["غواربُه جيَّاشةٌ من نوالِهِ","ومن بأسه ما بين مُغْنٍ ومُخطر",88,"ر",1,0],["غوانٍ بطيب القول عن مُحكم البُرى","فكلُّ فصيحٍ نِسْعةٌ وزِمامُ",89,"م",1,0],["غوانٍ إذا قيس الغواني بحسنها","فلا الريق معسولٌ ولا القدّ عاسل",90,"ل",1,0],["غوث الأيامي غيث الأوام إذا","أسيل أغنى عن صيب السبل",91,"ل",1,0],["غَوغاءُ يُطلِقُ فِيَّ مِن أَلفاظِهِ","ما لَيسَ يُطلِقُهُ لِسانِيَ فيهِ",92,"ي",2,0],["غَوغاءُ تَطَرَّحَ الصِيارِفُ نَقدَكُم","مِن بَهرَجانٍ فيكُمُ وَزيوفُ",93,"ف",1,0],["غوارباً في حِندسِ الليلِ اِدا","أغشى وفي رأْدِ الضحىطُلوعا",94,"ع",2,0],["غوري لطيبة الأردان تمطلني","مطل الغني حياء منك أو فرقا",95,"ق",2,0],["غوث الرجال وحالهم من حاله","وقد استظلَّ كبارهم بظلاله",96,"ه",1,0],["غوثٌ تفَرَّد في الرجال ولن ترى","لجانبه في الأولياء شبيها",97,"ي",3,0],["غَوائِرُ الغَيبِ ثارَت فارقُبوا عَلَناً","يا قومَنا السِرَّ نِعمَ الخُبرُ والخَبرُ",98,"ر",1,0],["غوْثُ البَسيطَةِ شيخُ كلِّ مُوَحِّدٍ","سيفُ الشَّريعَةِ ناصِرُ القُرآنِ",99,"ن",1,0],["غَوْثٌ مَشَتْ ساداتُهُمْ بِركابِه","ما بينَ وارِدِ جَيشِهِمْ والصَّادِرِ",100,"ر",1,0],["غَوْثٌ بِهمَّتِهِ نرى نارَ الغَضا","رَوضاً ويَمْحَقُ حُزْنَنا الأفراحُ",101,"ح",1,0],["غَوامضُ فِكرِه تَحكي الدَّراري","وطيبُ ثَناهُ يَرخُصُ بالغوالي",102,"ي",1,0],["غُواةٌ قامَ بينهُمُ غَويٌّ","يُمنّيهم بأنواعِ المُحالِ",103,"ل",1,0],["غَوثُ الوَرى كَعبَةُ الآمالِ مُلتَزِمي","في حُبِّهِ بِالتَّفاني صارَ من لزَمي",104,"م",2,0],["غَوارِبَ اليَمِّ إِذا اليَمُّ هَدَر","حَتّى يُقالَ حاسِرٌ وَما حَسَر",105,"ر",1,0]]}