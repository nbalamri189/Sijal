d=180386",""],[5013,"أصم ناعيك سمع الدهر حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=170964",""],[3591,"أحنُّ على شطِ المزار إلى مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=149379",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5232,"كنار الشام","https://www.poetsgate.com/ViewPoem.aspx?id=212657",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5320,"ولدى القعيد","https://www.poetsgate.com/ViewPoem.aspx?id=42967",""],[5328,"أقرب من روحي","https://www.poetsgate.com/ViewPoem.aspx?id=211986",""],[5333,"غنيٌ عن الأكوانِ بالذاتِ والذي","https://www.poetsgate.com/ViewPoem.aspx?id=9195",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5573,"مدية بارضها حقيقها","https://www.poetsgate.com/ViewPoem.aspx?id=200325",""],[5595,"وما رقصت قوافينا ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=144524",""],[2110,"غاض صبري والهوى قد بلغا","https://www.poetsgate.com/ViewPoem.aspx?id=156281",""],[5631,"النَّزلَةُ الأُولىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=210470",""],[2546,"غوثاهُ غوثي بربّي","https://www.poetsgate.com/ViewPoem.aspx?id=17170",""],[402,"واذكر له ذودا مجيدا صادقا","https://www.poetsgate.com/ViewPoem.aspx?id=36032",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5952,"ضيفٌ أتانا","https://www.poetsgate.com/ViewPoem.aspx?id=199848",""],[5956,"من نفس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=183294",""],[5974,"غوصي بأعماق النياط","https://www.poetsgate.com/ViewPoem.aspx?id=214894",""],[5997,"الخل","https://www.poetsgate.com/ViewPoem.aspx?id=214226",""],[6093,"لا تلعن النص إن أعيتك قافية","https://www.poetsgate.com/ViewPoem.aspx?id=204337",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6124,"غواني","https://www.poetsgate.com/ViewPoem.aspx?id=193279",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""],[6269,"نار الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87855&r=&rc=17",""],[2696,"ردَّ الخليطُ الجمالَ فانقضبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27408&r=&rc=12",""],[6355,"بيضي واصفري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66618&r=&rc=78",""]],"verses":[["غَوثُكَ مِنها يا غِياثَ الوَرى","قَد ثَقُلَ العِبءُ عَلى المَهرَمِ",0,"م",1,0],["غَوادٍ مِنَ الأَشراطِ وَطفٌ تُقِلُّها","رَوائِحُ أَنواءِ الثُرَيّا الهَواطِلُ",1,"ل",1,0],["غَوامِضُ كَالعُقبانِ إِن هِيَ أُرسِلَت","وَإِن أُمسِكَت عَن غَربِها نَقَلَت نَقلا",2,"ل",2,0],["غَوارِثَ تَشكو إِلى رَبِّها","أَطالَ السَبيعِيُّ إِغراثَها",3,"ث",3,0],["غَوارِثَ تَشكو إِلَيَّ الخَلا","أَطالَ اِبنُ عِمرانَ إِغراثَها",4,"ث",3,0],["غواربُ في بحر السراب تخالها","وقد سبحت فيه مواخرَ غربانِ",5,"ن",1,0],["غوثُ العبادِ ولَيْثُ مشتجرِ القَنَا","يومَ الطعانِ وفارجُ الغماءِ",6,"ا",2,0],["غَوانٍ هُنَّ أَخبَثُ مِن حَميرٍ","وَأَمجَنُ مِن نِساءٍ مُشرِكاتِ",7,"ت",1,0],["غَوَامِض في العَجَاجَةِ مُصعَبات","بِكَذَّانِ الأمَاعِزِ يَرتَمِينَا",8,"ن",2,0],["غَوائِرَ تَترى مِن نُجومٍ تَخالُها","مَعَ الصُبحِ تَتلوها زَواحِفَ لُغَّبا",9,"ب",2,0],["غولٌ يبيت الشّرب من قبحِها","يرون في النوم التهاويلا",10,"ل",2,0],["غوادٍ لا تفرّطُ أو سوارٍ","روائمُ لا يزالُ لها رِزامُ",11,"م",1,0],["غولُ النَجاءِ كَأَنَّها مُتَوَجِّسٌ","بِاللُبنَتَينِ مُوَلَّعٌ مَوشومُ",12,"م",1,0],["غورست رب السمكة","ذاك بشير البركة",13,"ك",2,1],["غَوى رَأيُ نَفسٍ لا تَرى أَنَّ وَجدَها","بِتِلكَ الغَواني شُقَّةٌ مِن عَذابِها",14,"ب",3,0],["غُولاً تسنَّمتُ لم أسألْ أكارعَه","إلى الهُوَى، أمْ على الواحات ترميني",15,"ن",2,0],["غُودِرَتْ في الشّرق فوضى فانبرى","ينشرُ الدُّستورَ فيها والنّظاما",16,"م",2,0],["غَوَتِ النُّفوسُ فَسَادَ كلُّ مخادعٍ","ومَضى بأمرِ القوم كلُّ مُراءِ",17,"ا",2,0],["غواربُ تسمو من حديدٍ ومن دمٍ","بِجأواءَ لم يَصنعْ لها الفُلكَ صانعُ",18,"ع",1,0],["غَوى العُلَماءُ فَالأَخلاقُ فَوضى","جَوامِحُ ما تَريعُ وَما تَلينُ",19,"ن",1,0],["غَوالِبَ تَأخُذُ أَقصى المَدى","وَيَأخُذُها القَدَرُ الأَغلَبُ",20,"ب",1,0],["غَوى الناس حَتّى لا صَوابٌ وَلا رُشدُ","وَضلّوا فَلا رُسلٌ تُطاعُ وَلا جُندُ",21,"د",1,1],["غُودِرَا في جانبِ الوادي وما","يَجلِبُ الأمرَ سوى أسبابهِ",22,"ه",1,0],["غُوَيرِثُ رُمْتَ أمراً مستحيلا","فهل لك أن تثوبَ وأن تريعا",23,"ع",2,0],["غَوجِ اللَبانِ إِذا اِستَحَمَّ وَضينُهُ","وَجَرى حَميمُ دُفوفِهِ المُتَفَصِّدُ",24,"د",1,0],["غَوامِضُ في النَقعِ سُجعُ الخُدود","مُشايِحَةٌ في الوَغى كالِحَه",25,"ح",2,0],["غولُ البِلادِ إِذا المُقيلُ تَحَرَّقَت","آرامُهُ وَجَرَت بِماءِ سَرابِهِ",26,"ب",2,0],["غَوى لَيلُ مُثرٍ فَاِستَقَلَّ بِفِتنَةٍ","وَقَد رَخُصَت لِلسائِمينَ غَوالِ",27,"ل",1,0],["غُواةٌ إذا النّكباءُ حَفّتْ بيوتَهْم","أقاموا لها الفُرْسانَ في كلّ مَرْصَدِ",28,"د",1,0],["غَوَّت بَنو أَسَدٍ غَسّانَ أَمرَهُمُ","وَقَلَّ ما وَقَفَت غَسّانُ لِلرَشدِ",29,"د",1,0],["غَوْجُ اللَّبَانِ ولَمْ تُعْقَدْ تَمَائِمُهُ","مُعْرَى القِلاَدَةِ مِنْ رَبْوٍ ولاَ بُهُرِ",30,"ر",1,0],["غوائثُ الأرضِ إذا أقلعتْ","حواملُ الغيث الدفوقِ الهتونْ",31,"ن",1,0],["غَوَافِلُ لا يَعْرِفْنَ بُؤْسَ مَعِيشَةٍ","وَلا هُنَّ بِالْخَطْبِ الْمُلِمِّ شَواعِرُ",32,"ر",1,0],["غوَّاصُ فِكْرٍ فِي كُلِّ بَحْرٍ","يَصِيدُ لِلشِّعْرِ مَا يَصِيدُ",33,"د",1,0],["غَوْثُ اللَّهِيفِ أَبَرُّ فِي مِيقَاتِهِ","مِنْ وَعْدِهِ بِغِنًى بَعِيدِ مَنَالِ",34,"ل",1,0],["غَوْثَ اللَّهِيفِ أَلاَ تُجَارُ وَقدْ","غَلَّ الضَّنَى من بَأْسِ أَيديكا",35,"ك",2,0],["غَوى القَلبُ فيهِ وَهوَ لَولاهُ راشِدٌ","وَمَلآن مِنهُ وَهوَ لَولاهُ فارِغُ",36,"غ",1,0],["غُوصُوا بأغْوار الشبِيِبَة، وانْفُذُوا","من كُلّ بَابٍ مُحْكَم الأقْفالِ",37,"ل",1,0],["غولٌ تغول الطفلَ من يد أمه","بسُعارها والكاعبَ الرُّعبوبا",38,"ب",2,0],["غوث البلاد عظيمة بركاته","نفاح كل جليلة قسامها",39,"م",3,0],["غوث الوجود اغثني ضاق مصطبري","سر الوجود استلمني من يد الخَطر",40,"ر",1,1],["غوث البسيطة معلم الدنيا","أبي الضيم مولانا عزيز الجار",41,"ر",1,0],["غوْثَ الصريخِ ، أتتك تُعوِلُ حُرَّةٌ","حَّراءُ صارخةٌ من الأشعار",42,"ر",1,0],["غوطةُ الشامِ جحيمٌ فائرٌ","والميادينُ طعانٌ ورماء",43,"ا",2,0],["غوطة الشام هل شجاك بيان","من قريضي كأنّه التنزيل",44,"ل",1,0],["غوطة الشام منك صدّ وحرم","ان ومنّا العطاء والتنويل",44,"ل",1,0],["غول تغول أشكالا حقيقتها","مكرا ولا يرعوي عنها مدانيها",45,"ي",3,0],["غوثاه يا آل البتول فانكم","خفقت بكم بين الملا اعلامي",46,"م",2,0],["غوثاه وارحم عاشقا فانيا","اعناه من جدك شيل النطاق",47,"ق",1,0],["غوث على قدم الرسول سلوكه","ولغيره في سلكه اطوار",48,"ر",1,0],["غوثاه يا ايها الفاروق خذ بيدي","فالذنب اسكت نطقي كيف اعتذر",49,"ر",1,0],["غوث الثقلين ضياء العي","ن امام الدين مجدده",50,"د",2,0],["غوث على اردانه مسك العبا","بطراز احوال الرسول يفوح",51,"ح",1,0],["غوث به الله احى الدين فهو بمح","ي الدين في القوم معروف ومنعوت",52,"ت",1,0],["غوث الورى المهدي شيخنا الذي","عن الوجود بالشهود انلسبا",53,"ب",2,0],["غوثاه يا شرف الوجود فانني","لم يرتفع الا اليك ندائي",54,"ا",2,0],["غوثاً وعوناً سادتي يا سادتي","فالدمع قد أعيا من إرساله",55,"ل",2,0],["غوث الزمان أبي علي صاحب الس","ر الجلي وكوكب الإفراد",56,"د",1,0],["غوثاه يا صياد يا ابن السا","دة الأجواد آل السادة الأجواد",56,"د",1,0],["غوث شموس سماء دولته انجلت","في الشرق ثم سرت إلى الأكوان",57,"ن",1,0],["غوثاه بالمصطفى والمرسلين وفي","كل الصحابة أهل المجد والهمم",58,"م",1,0],["غوثاه يا ابن رسول اللَه خذ بيدي","يا سيد الوليا يا ثابت القدم",58,"م",1,0],["غوث أهل الطريق بحر المعاني","بدر فضل لازال يعلو ضياه",59,"ا",2,0],["غوثاه يا سر الورى","يا حاضراً متى ندب",60,"ب",1,0],["غوث الطريقة بعد عدمها عتقا","غيث الخليقة فهو غيثها العتق",61,"ق",1,0],["غوثٌ به الغيث والأوفاض وافضة","إليه ليس لها سواه مفترضا",62,"ض",2,0],["غُودِرَت في مَذَلَّةٍِ واكتِئَابٍ","وهوَ إِنٍ وغُربِةٍ لَن تَرِيمَا",63,"م",2,0],["غَوثِ البَرَايَا ثِمَالِ المُرمِلينِ إِضَا","ضِ المُزعَجِينَ العَتَادِ المَعقِلِ الوَزَرِ",64,"ر",1,0],["غَواربُهُم بِالمَشرَفيَّةِ تُختَلى","وَهامُهُمُ بِالسَمهَريَّةِ تُتلَغُ",65,"غ",1,0],["غودِرتُ بَعدَهُم أَسيرَ صَبابَةٍ","كَمَداً يُغَصِّصُني الشَرابُ السائِغُ",66,"غ",1,0],["غورِيَّةٌ تَعلو الغُصونَ كَأَنَّما","أَهدى لَها الطَوقَ المُؤَلَّفَ صائِغُ",66,"غ",1,0],["غوثايَ منهُ فما ينفكَ يُقلقني","بسفرةٍ تَقتْضي تقويضَ أطنابي",67,"ب",2,0],["غوايتي أهلكت شبابي","فقل كما شئت في العقاب",68,"ب",1,0],["غوائلُ دهرٍ عاقني عن لقائه","تخاف فوا حزني متى اتفرغ",69,"غ",1,0],["غوايهُ جهلٍ قد بكيتُ دماً لها","فرُحت وخدِّي من دُمُوعي يُصبغ",69,"غ",1,0],["غواضبُ يومَ الحربِ للحقِّ والهدُى","وأمّا لأخذِ الثأرِ فهي كواظِم",70,"م",1,0],["غوث لِمُلتَجىء غيث لمنتجع","ليث عَلى ملة الاسلام ريمال",71,"ل",1,0],["غوثان ان عدت العَوادي أوقسا","قلب الزَمان فَما أَبر وَأَرحَما",72,"م",2,0],["غَوالِبُ فَتْكٍ لَمْ يَصُلْنَ بِقُوَّةٍ","طَوالِبُ ثَأْرٍ لَمْ يَبِتْنَ عَلَى حِقْدِ",73,"د",1,0],["غُوارِبُ أَحْياناً طَوالِعُ كُلَّما","هَبَطْنَ فَضا سَهْلٍ عَلَوْنَ مَطا حَزْمِ",74,"م",1,0],["غواصها ان غاص لا","يدري لعاديه مقر",75,"ر",1,0],["غوت البرية كلها ومغيثها","عن إذن سيده الكريم العادل",76,"ل",1,0],["غوث العباد وغيث للبلاد به","تحيا الجدود ويروى كل عطشان",77,"ن",1,0],["غوثٌ تضلّع مِن مَواردِ جدّهِ","بِالمشربِ الأهنا وحوض الكوثرِ",78,"ر",1,0],["غوثٌ إِذا ما الغيثُ عزَّ نواله","سحّت جداه يديه غيثاً ممطرا",79,"ر",2,0],["غَوْثُ الأفاضلِ في زمانِ أراذِلٍ","فكأنّه عَلَمٌ أُقيمَ بمَجْهَل",80,"ل",1,0],["غَوّاصُ بَحْرِ يَمينِه قَلَمٌ","يَمتارُ منه اللُّؤْلُؤُ النَّسق",81,"ق",1,0],["غواربُ أقمارٍ جوانحُ للنَّوى","وقد حَمَلتْها العيسُ فوق غَوارب",82,"ب",1,0],["غَوالبُ أشواقٍ أُتيحتْ حوادثٌ","غوالبُ من دهري لتلك الغوالب",82,"ب",1,0],["غوث الورى غيث الندى","محيي الشريعة للأنام",83,"م",1,0],["غَوثاً لملهوفٍ وملجأَ لاجِئٍ","وجوارَ رَبّ جَرائرٍ وطَوائِلِ",84,"ل",1,0],["غَوثُ الصَّريخ المستجير ببابه","لا مُعرضٌ عنهُ ولا متواني",85,"ن",2,0],["غوث الصريح إذا دُعي لملمَّةٍ","في كشفه الأَخطار أيّ مبادر",86,"ر",1,0],["غوّدتني بندي يديك فصار لي","