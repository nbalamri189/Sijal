l","الطويل"],[378,"شدتي أعظم شده","https://www.aldiwan.net/poem66874.html","مجزوء الرمل"],[381,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[381,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[394,"وخط كأن الله قال لحسنه","https://www.aldiwan.net/poem53541.html","الطويل"],[394,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[410,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[433,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[433,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[440,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[440,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[442,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[459,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"أموضع سري والذي حسن عهده","https://www.aldiwan.net/poem3163.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[465,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[465,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[478,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[516,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[528,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[539,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[552,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[561,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[563,"تقول لقلبي ربة الأعين النجل","https://www.aldiwan.net/poem52902.html","الطويل"],[565,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"]],"verses":[["وَخَطّارَ القَنا وَالمَو","تُ مَضروبُ الرِواقَينِ",0,"ن",1,0],["وَخَطابَةً لِلسَمعِ في جَنَباتِها","شُغلٌ يَعُقُ عَنِ الَّذي يَتَرَنَّمُ",1,"م",1,0],["وَخُطوباً إِذا نَحَتنَ مِنَ العَظ","مِ فَلا بَدعَ إِن عَرَقنَ النَحضا",2,"ض",2,0],["وَخِطَّةِ ضَيمٍ خادَعَتني فَفِتُّها","إِلى مَطلَعٍ بَينَ المَذَمَّةِ وَالحَمدِ",3,"د",1,0],["وَخِطَّةٍ بَينَ أَرماحِ العِدى ضَمِنَت","نَجايَ مِن ضيقِها سَمراءُ قَيدودُ",4,"د",1,0],["وَخِطَّةٍ يَضحَكُ مِنها الرَدى","عَسراءَ تَبري القَومَ بَريَ القِداح",5,"ح",1,0],["وَخُطَّةِ خَسفٍ فِتُّها غَيرَ لاحِقٍ","بِيَ العارُ إِلّا ما نَفَضتُ ذَوائِبي",6,"ب",2,0],["وَخَطبٍ عَلى الزَوراءِ أَلقى جِرانَهُ","مَديدِ النَواحي مُدلَهِمِّ الجَوانِبِ",6,"ب",1,0],["وَخُطَّةٍ مِنْ بُيوتِ الحَيِّ زُرْتُ بِها","بِيضاً يَهُزُّ الصِّبا مِنْهُنَّ أَعْطافَا",7,"ف",2,1],["وخُطا المُلوكِ الصِّيدِ تَقْصُرُ عِندَهُ","وتَطولُ فيهِ ألْسُنُ الشُّعَراءِ",8,"ا",2,0],["وَخُطبَةُ الدَولَعِيِّ كَم جَلَبَت","لِلنّاسِ مِن فادِحٍ وَمِن خَطبِ",9,"ب",1,0],["وَخَطباءُ تَبكي شَجوَها فَكَأَنَّها","لَها بالتِلاعِ القاوِياتِ فَقيدُ",10,"د",1,0],["وَخَطْبُكِ إِنَّ يَعْظُمْ فَإِنْ الَّذِي دَهَى","جَمَاعَتَنَا بَيْنَ الْجَمَاعَاتِ أَعْظَمُ",11,"م",1,0],["وَخَطبَ الريحَ إِلَينا الماءُ","جَرى لَنا الدَهرُ بِما نَشاءُ",12,"ا",2,0],["وخطبت من فاسَ الجديدِ عقيلةً","لَبَّتْكَ طوع تسرّع وبدارِ",13,"ر",1,0],["وخطاً تفضح العقود اتساقاً","نظمتها تسرعاً ودبيبا",14,"ب",2,0],["وَخَطبٍ مِنَ الأَيّامِ أَنسانِيَ الهَوى","وَأَحلى بِفَيِّ المَوتَ وَالمَوتُ عَلقَمُ",15,"م",1,0],["وخطَّتِ الريحُ خطاً في مناهلها","كأن قطرَ الغوادي فيه جريات",16,"ت",1,0],["وخط كما راقت سلاسل عسجدٍ","ونظم كما راق الرحيق المسلسل",17,"ل",1,0],["وخطيب يكفي الخطوبَ بلفظ","يستميل الصخور بالتليين",18,"ن",1,0],["وخطيئاتي التي سلفتْ","لستُ أحصي بعضَها عددا",19,"د",2,0],["وخِطتُ بألوانِ التكاليف وهْيَها","وما الدهر أوْهاهُ فمن ذا يخيطُهُ",20,"ط",2,0],["وَخَطيئَتي الكُبرى إِلَيهِم أَنَّهُم","قَعَدوا وَلَم أَقعُد عَلى الغَبراءِ",21,"ا",2,0],["وَخَطبُكَ لا يَفيهِ دَمعُ باكٍ","وَلَو أَنَّ الَّذي يَبكي الغَمامُ",22,"م",1,0],["وَخُطوبٌ يَنقُصُ الصَب","رُ عَلَيها وَتَزيدُ",23,"د",1,0],["وخطب الصيدلية كان أدهى","وأنكر موقعا في مسمعيا",24,"ي",2,0],["وخطابة في كل ناد حافل","ينصبّ آذانا إليها النادى",25,"د",2,0],["وخطب الدين والدنيا جليل","ولكن قدر من فَقدا أجل",26,"ل",1,0],["وَخَطَّ بِالنورِ عَلى","لَوحِ الظَلامِ مَرحَبا",27,"ب",2,0],["وَخُطَّ لَكَ القَبرُ في رَوضَةٍ","يَميلُ عَلى الغُصنِ فيها الغُصُن",28,"ن",1,0],["وَخُطّي لَهُ بَينَ السَلاطينِ مَضجَعاً","وَقَبراً بِجَنبِ الفاتِحِ المُتَقَدِّمِ",29,"م",1,0],["وَخَطبُكَ يا رِياضُ أَمِ الدَواهي","عَلى أَنواعِها وَالنازِلاتُ",30,"ت",1,0],["وَخُطى المَسيحِ عَلَيكَ روحاً طاهِراً","بَرَكاتُ رَبِّكَ وَالنَعيمُ الغَيدَقُ",31,"ق",1,0],["وَخُطوطٍ كَأَنَّها هُدبُ ريمٍ","حَسُنَت صَنعَةً وَطولاً وَعَرضا",32,"ض",2,0],["وَخُطوطٍ تَكَفَّلَت لِلمَعاني","وَلِأَلفاظِها بِأَزيَنَ لَبسِ",33,"س",1,0],["وَخُطوبُ الزَمانِ ماكِثَةُ اللُب","ثِ عَلى أَنَّهُ سَريعُ المُرورِ",34,"ر",1,0],["وَخَطَبتَ مِنّي بَعدَ ذاكَ إِجازَةً","عَن نَقلِهِ حَتّى ظَنَنتُكَ هازي",35,"ز",2,0],["وَخَطوي تَحتَ رايَةِ لَيثِ غابٍ","بِسَطوَتِهِ لِصَرفِ الدَهرِ غابِن",36,"ن",1,0],["وخطِّيَّة تختَطُّ مِنهُم حيازِماً","وأحداقها زرقٌ وأجسادها حُمرُ",37,"ر",1,0],["وَخَطبٍ جَليلٍ دونَها قَد شَغَلتَهُ","وَفي دونِهِ شُغلٌ لِغَيرِكَ شاغِلُ",38,"ل",1,0],["وخطيبٍ تظنُّهُ","فائزاً وَهْوَ هالِكْ",39,"ك",1,1],["وخُطبة تُسمع الرهطينِ مُلْفيةً","في الذئب والحمَلِ المرعوبِ مُصغينا",40,"ن",2,0],["وَخِطابِ بِرٍّ نابَ عَنهُ سِفارَةً","إِنَ الخِطابَ عَلى البُعادِ تَلاقِ",41,"ق",1,0],["وَخُطّا بِأَطرافِ الأَسِنَّةِ مَضجَعي","وَرُدّوا عَلى عَينَيَّ فَضلَ رِدائِيا",42,"ي",2,0],["وَخُطّوا عَلى قَبري إِذا مِتُّ وَاِكتُبوا","قَتيلُ لِحاظٍ ماتَ وَهوَ عَشيقُ",43,"ق",1,0],["وَخَطَّ بِصَدغِهِ لِلحُسنِ واواً","فَنَقَّطَ خَدَّهُ بَعضُ المِدادِ",44,"د",1,0],["وَخَطِيّاً كأَشطانِ الرَكايا","وأَسيافاً يَقُمنَ وَينَحَنينا",45,"ن",2,0],["وَخُطَّةُ ماجِدٍ مِن آلِ لَأيٍ","إِذا ما قامَ صاحِبُها قَضاها",46,"ا",3,0],["وَخَطَّ فَوقَ حِجابِ الدُرِّ شارِبَهُ","بِنِصفِ صادٍ وَدالُ الصُدغِ كَالنونِ",47,"ن",1,0],["وَخِطَّةِ رِبحٍ في العُلى قَد أَجَبتُها","وَخِطَّةِ خَسفٍ ذاتِ بَخسٍ تَأَبَّيتُ",48,"ت",1,0],["وخطبتُ قبلَ القوْمِ خطبةَ فيصَلٍ","أُثني عليك فوعُد ربَّك قد وفَى",49,"ف",2,0],["وخطبتُ بالزَّوراء أُخرَى مثلَهَا","ووقفْتُ بينَ يديكَ هذا المَوقفا",49,"ف",2,0],["وَخَطيئَةٍ تَغلو عَلى مُستامِها","يَلقاكَ آخِرُ طَعمِها بِالأَوَّلِ",50,"ل",1,0],["وَخُطَّةِ حَزمٍ قَد كَشَفتَ بِها الرَدى","وَرَأسِ رَئيسٍ قَد بَعَثتَ بِهِ وَفدا",51,"د",2,0],["وَخَطّوا أَحاديثاً لَهُم في صَحائِفٍ","لَقَد ضاعَت الأَوراقُ فيها وَحِبرُها",52,"ر",3,0],["وَخُطوبُ دَهرٍ غَيرُ ذَلِكَ جَمَّةٌ","دونَ اِغتِذائِكَ وَالأَُمورُ لَبائِسُ",53,"س",1,0],["وخَطيباً لو قامَ بَينَ وُحُوشٍ","عَلّمَ الضّارِياتِ بِرَّ النِّقَادِ",54,"د",1,0],["وَخطوب صارعتهنَّ فَما عا","ب شهودي وإن غُلبت صراعى",55,"ع",2,0],["وخُطّي لها قَبْراً يَضلّونَ دونَهُ","كقَبْرٍ لمُوسى ضَلَّهُ آلُ إسْرال",56,"ل",1,0],["وخططنا فى نقى الرمل فلم","تحفظ الريح ولا الرمل وعى",57,"ع",2,0],["وخطَّةَ ماجِدٍ كَلَّفتُ نَفسي","إذا ضاقُوا رَحِبتُ بِهُم ذِراعا",58,"ع",2,0],["وخُطوبُ الدَّهرِ لا يَبقَى لَها","ولِمَا تَأتي بهِ صُمُّ الجِبال",59,"ل",1,0],["وخطرت في التاريخ طيفا","تعشق الرؤيا انسكابه",60,"ب",2,0],["وَخَطمٌ كَأَنَّ الريحَ شَكَّتهُ بِالسَفا","طَويلٌ وَنابٌ كَالسِنانِ خَضيبُ",61,"ب",1,0],["وَخَطَبْتَ بِالصَوتِ الْجَهِيرِ","فَما امرؤٌ إِلا وَلَبَّى",62,"ب",2,0],["وخطابٌ يأتيك من نجلك الثَّا","ني قميصٌ جاءَت به البُشَراءُ",63,"ا",2,0],["وخطاهم في الأرض ترسم شعرا","هذبته السراء والضراء",64,"ا",2,0],["وخطو فلّاح هناك انحنى","يمحو بقايا العرق النازف",65,"ف",1,0],["وخطانا دم تجمّد في الأشواك","جمرا وفي الصخور مياسم",66,"م",1,0],["وخطوة على قبري إذا مت واكتبوا","قَتِيلُ لِحاظٍ مَاتَ وَهوَ عَشِيقُ",67,"ق",1,0],["وخطبك لا يفيه دمع باك","فموتك من بني العرب يبكي الغمام",68,"م",1,0],["وَخَطّاً كَما أَلقَت عَلَى صَحنِ خَدِّها","عَروسُ الرُّبَى وَشيَ الرِّياضِ المُنَمنَمِ",69,"م",1,0],["وخطبٌ تكادُ الأرض ترجُفُ خيفةَ","لديه وأشرافُ الرواسِي تُصَدَّعُ",70,"ع",1,0],["وخَطتْك أحداثُ الزمانِ ولا","برِحتْ رِباعَك ديمةٌ تجرِى",71,"ر",2,0],["وَخَطِّيَّةٌ يُلفى الرَدى تَبَعاً لَها","إِذا مَرَقَت في الأُسدِ مِنها الثَعالِبُ",72,"ب",1,0],["وَخَطِّيَّةٌ ما زالَ غَضّاً حَديثُها","إِذا شَهِدَت حَرباً وَإِن كُنَّ ذُبَّلا",73,"ل",2,0],["وَخَطيطَةٍ ضَنَّ الغَمامُ بِرَيِّها","خَلَّفتُها خَلفي وَسِرتُ مُيَمِّما",74,"م",2,0],["وخطكم لي عندكم شاهدٌ","عدلُ على احسانكم يقبلُ",75,"ل",1,0],["وخطأ إلا من يرى الخلق صورة","هويته لله عند التناظر",76,"ر",1,0],["وخطبٌ سمينٌ مثلُ رِدفِكَ ذقتُهُ","بجسمٍ نحيفٍ مثلِ خَصركَ ناحلِ",77,"ل",1,0],["وخَطِّيةٌ سُمْر وبيض صَوارمٌ","ومَسْرودةٌ زَغْفٌ ومُقْرَبة جُرْد",78,"د",1,0],["وخَطَّتْ على لَبّاتها البيضِ أَسْطُرا","يكون بأطراف الوَشيجِ لها نَقْط",79,"ط",1,0],["وخُطوبٌ تُحيل صِبْغتها الأب","شارَ فضلا عن أن تُحيل الشعورا",80,"ر",2,0],["وخطيبهم وولي عه","دهم رئيس الثائرين",81,"ن",1,0],["وَخَطَّ عَلى الخَدِّ لامُ العِذارِ","فَما أَحسَنَ الآسُ في الجُلَّنارِ",82,"ر",1,0],["وَخُطوبَ دَهرٍ طاحَ في ال","غُمَراتِ مِنها وَاللُجَج",83,"ج",1,0],["وَخِطابِها بِعِتابِها مِمَّا بِهَا","مِنْ قَسْوَةٍ أَوْ نَخْوَةٍ فِي قَصْدِهَا",84,"د",3,0],["وَخُطُورِهَا بِقُصورِها مُرْتَجَّةً","أَرْدَافُهَا مِن تَحْتِ صَعْدَةِ قَدِّهَا",84,"د",3,0],["وخطه والكتاب في يده","ينثر دراً أمام مرجان",85,"ن",1,0],["وخطوب الدهر لا أحسبها","غير غارات أسود بظباء",86,"ا",2,0],["وخطبَ بعادٍ كلَّما قُلتُ هذه","أَواخرهُ كرَّت عليَّ أَوائِلُه",87,"ل",2,0],["وَخطوا بالدمِ المهراقِ سِفْراً","سيروى بعدهم جيلاً فجيلا",88,"ل",2,0],["وخطرت ملتحفا ببرد حبرت","منه بديع الوشي كف أنيق",89,"ق",1,0],["وَخَطمٌ كَسَتهُ واضِحاً مِن لُغامِها","نَفاهُ مِنَ اللَحيَينِ دَردٌ وَأَروَقُ",90,"ق",1,0],["وَخَطّ الحسن نُقطة مسك خال","فَصار الحاجب المقرون نونا",91,"ن",2,0],["وخَطَّتْ عندهُمْ يُمناكَ سَطْراً","لغَضُّوا من حيائكَ كُلَّ مُقْلَه",92,"ه",1,0],["وخِطابُه والخَطْبُ إن يَعْلُ ال","أَقوامُ إلاّ اللّيلُ والفَلَق",93,"ق",1,0],["وخُطْباً علَتْ فوقَ أَعوادِها","وقد خَطَبتْ مِلْءَ أشْداقها",94,"ق",3,0],["وخِطّةِ إقليمٍ بعَثْتَ لعُسْرِها","بخَطّةٍ أقلامٍ فَبدَّلْتَهُ يُسرا",95,"ر",2,0],["وخَطٍّ عَلاهُ الوَخطُ فاغبرَّ قَبلما","تَترّبَ في كَفِ العَجولِ كتاب",96,"ب",1,0],["وَخَطفُكَ مِن يَدٍ تَهمي وَتَحمي","فَتَختَصِمُ النِصالُ مَعَ النُحورِ",97,"ر",1,0],["وَخَطَبتُ السَلوَةَ","فَأَسأَلُ مَعدوماً وَأَقفُلُ مُعدِما",98,"م",2,0],["وخطوبٌ وشقاءٌ","حدُّها يشحذ حده",99,"د",2,0],["وَخَطُهُ هُوَ وَالسحر المجوَّز قَد","تَلازَما وَجُفون الغيد وَالحورُ",100,"ر",1,0],["وَخَطوب تَتَرى وَقَلب عَلى الأَح","رار قاس وَبِالكِرام ضَنين",101,"ن",1,0],["وَخطٍّ كَأَنَّ اللَهَ قال لِحُسنِهِ","تَشَبَّه بِمن قَد خَطَّكَ اليَومَ فَأتَمَر",102,"ر",1,1],["وَخطابَة جذب القرآنُ بِضبعِها","لَم يُحتَكَم قَسٌّ لَها وَاياد",103,"د",1,0],["وخُطوباً رَمى بها حادِثُ الدَّهْ","رِ سَوادي وكلُّهُنَّ مُصيبُ",104,"ب",1,0],["وخطيبُ الحُسام أَفْصَحُ ما كا","نَ كلاماً إِذا أَثارَ الكُلوما",105,"م",2,0],["وخطرْتَ في فرْدِ المدا","ئح باسمِه فغدوتَ فرْدا",106,"د",2,0],["وخُطَّابُ أمرِ الثَّغْرِ قَدْ صَدَقَتْهُمُ","عيونٌ يُعَفِّينَ الحديثَ المُتَرْجَما",107,"م",2,0],["وخَطَطْتَ بالكَفِّ الكريمةِ مُلحَقِي","والفخرُ فخري منك إِذ سمَّيْتَنِي",108,"ن",2,0],["وخطب من الدنيا عظيم لقفته","بخطب وبلوى من يدري جرعت بلوى",109,"و",2,0],["وخُطَّابَ أفكاري التي وَلدَتْ لهم","ذكورا كراما والقرائحُ تَعقُمُ",110,"م",1,0],["وخطبتَه فحظيتَ من أفكاره","بغرائبٍ نشزت على البُذّالِ",111,"ل",1,0],["وخَطَا ومشتبه الشخو","ص على الدجى تستطرقُهْ",112,"ق",2,0],["وخطاك واسعةُ المَدى تحت الظُّبا","لا الخيطُ يحبسها ولا المِسمارُ",113,"ر",1,0],["وخطابُ جنس الطير أيةُ آيةٍ","لم تغنِ والثقلان أي جنود",114,"د",1,0],["وخطٌ كوشي الروض لم يعدُ ناظراً","به راتعاً أو خاطراً يتأنق",115,"ق",1,0],["وخطّيّة سمرٍ وبيضٍ قواضبٍ","ومسنونة زرق وماذّية خصر",116,"ر",1,0],["وخطّ عذارٍ طرسهُ ماءُ وجنةٍ","فيا من رأى خطاً على الماءِ يكتب",117,"ب",1,0],["وخطبتمُ قلبي لبكرِ هواكمُ","فلسيلُ عن بيت السلوّ الطالق",118,"ق",1,0],["وَخَط يَسحر الأَلباب وَدَت","لَو اِكتَحَلَت بِهِ مُقل الحِسانِ",119,"ن",1,0],["وخطبت فيه المؤمنين خطابة","ذابت عيون عندها وعقول",120,"ل",1,0],["وخطب عظيم قام في دفع صدره","وما زال مذخوراً لدفع العظائم",121,"م",1,0],["وخطَّ الفناء على قَبره","بخطِّ البلا وبنان السّقم",122,"م",1,0],["وخَطابِه نحو النَّجاةِ مِنَ الرَّدى","وبِساحلٍ منها رَسَا بِسَلامِ",123,"م",1,0],["وَخطوبٍ مُعضلاتٍ","بِتن يُنسين الخُطوبا",124,"ب",2,0],["وخطايايَ ارتماءٌ مُخْبِتٌ","في مصلى الروحِ تشدو “يا سميعْ”",125,"ع",1,0],["وخَطَّتْ لخَوفِ العَينِ بالوَشم رُقْيةً","على مِعصَمَيها كالفِرِندِ على النَصْلِ",126,"ل",1,0],["وخط بحدي عزمه وحسامه","على صفحات العصر آياته الكبرى",127,"ر",2,0],["وخطيبُ المهذَّبِيْنَ بَنِي العَبْ","اسِ في كلِّ مَحْفَلٍ مَشْهُودِ",128,"د",1,0],["وخَطَوْتُ فوق ظُبَا المناصلِ مُسْرِعاً","وسعيت فوق أَسنَّة المُرَّانِ",129,"ن",1,0]]}