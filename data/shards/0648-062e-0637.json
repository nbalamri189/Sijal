.html","الطويل"],[369,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[369,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[380,"شدتي أعظم شده","https://www.aldiwan.net/poem66874.html","مجزوء الرمل"],[383,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[383,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[396,"وخط كأن الله قال لحسنه","https://www.aldiwan.net/poem53541.html","الطويل"],[396,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[412,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[435,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[435,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[442,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[442,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[444,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[460,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[460,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[460,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[460,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[466,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[466,"أموضع سري والذي حسن عهده","https://www.aldiwan.net/poem3163.html","عموديه"],[466,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[466,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[466,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[479,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[517,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[517,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[529,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[540,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[553,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[562,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[564,"تقول لقلبي ربة الأعين النجل","https://www.aldiwan.net/poem52902.html","الطويل"],[566,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[569,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[577,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[744,"","https://poetry.dctabudhabi.ae/diwan/poem/67407","الخفيف"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/98129","الكامل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"]],"verses":[["وَخَطّارَ القَنا وَالمَو","تُ مَضروبُ الرِواقَينِ",0,"ن",1,0],["وَخَطابَةً لِلسَمعِ في جَنَباتِها","شُغلٌ يَعُقُ عَنِ الَّذي يَتَرَنَّمُ",1,"م",1,0],["وَخُطوباً إِذا نَحَتنَ مِنَ العَظ","مِ فَلا بَدعَ إِن عَرَقنَ النَحضا",2,"ض",2,0],["وَخِطَّةِ ضَيمٍ خادَعَتني فَفِتُّها","إِلى مَطلَعٍ بَينَ المَذَمَّةِ وَالحَمدِ",3,"د",1,0],["وَخِطَّةٍ بَينَ أَرماحِ العِدى ضَمِنَت","نَجايَ مِن ضيقِها سَمراءُ قَيدودُ",4,"د",1,0],["وَخِطَّةٍ يَضحَكُ مِنها الرَدى","عَسراءَ تَبري القَومَ بَريَ القِداح",5,"ح",1,0],["وَخُطَّةِ خَسفٍ فِتُّها غَيرَ لاحِقٍ","بِيَ العارُ إِلّا ما نَفَضتُ ذَوائِبي",6,"ب",2,0],["وَخَطبٍ عَلى الزَوراءِ أَلقى جِرانَهُ","مَديدِ النَواحي مُدلَهِمِّ الجَوانِبِ",6,"ب",1,0],["وَخُطَّةٍ مِنْ بُيوتِ الحَيِّ زُرْتُ بِها","بِيضاً يَهُزُّ الصِّبا مِنْهُنَّ أَعْطافَا",7,"ف",2,1],["وخُطا المُلوكِ الصِّيدِ تَقْصُرُ عِندَهُ","وتَطولُ فيهِ ألْسُنُ الشُّعَراءِ",8,"ا",2,0],["وَخُطبَةُ الدَولَعِيِّ كَم جَلَبَت","لِلنّاسِ مِن فادِحٍ وَمِن خَطبِ",9,"ب",1,0],["وَخَطباءُ تَبكي شَجوَها فَكَأَنَّها","لَها بالتِلاعِ القاوِياتِ فَقيدُ",10,"د",1,0],["وَخَطْبُكِ إِنَّ يَعْظُمْ فَإِنْ الَّذِي دَهَى","جَمَاعَتَنَا بَيْنَ الْجَمَاعَاتِ أَعْظَمُ",11,"م",1,0],["وَخَطبَ الريحَ إِلَينا الماءُ","جَرى لَنا الدَهرُ بِما نَشاءُ",12,"ا",2,0],["وخطبت من فاسَ الجديدِ عقيلةً","لَبَّتْكَ طوع تسرّع وبدارِ",13,"ر",1,0],["وخطاً تفضح العقود اتساقاً","نظمتها تسرعاً ودبيبا",14,"ب",2,0],["وَخَطبٍ مِنَ الأَيّامِ أَنسانِيَ الهَوى","وَأَحلى بِفَيِّ المَوتَ وَالمَوتُ عَلقَمُ",15,"م",1,0],["وخطَّتِ الريحُ خطاً في مناهلها","كأن قطرَ الغوادي فيه جريات",16,"ت",1,0],["وخط كما راقت سلاسل عسجدٍ","ونظم كما راق الرحيق المسلسل",17,"ل",1,0],["وخطيب يكفي الخطوبَ بلفظ","يستميل الصخور بالتليين",18,"ن",1,0],["وخطيئاتي التي سلفتْ","لستُ أحصي بعضَها عددا",19,"د",2,0],["وخِطتُ بألوانِ التكاليف وهْيَها","وما الدهر أوْهاهُ فمن ذا يخيطُهُ",20,"ط",2,0],["وَخَطيئَتي الكُبرى إِلَيهِم أَنَّهُم","قَعَدوا وَلَم أَقعُد عَلى الغَبراءِ",21,"ا",2,0],["وَخَطبُكَ لا يَفيهِ دَمعُ باكٍ","وَلَو أَنَّ الَّذي يَبكي الغَمامُ",22,"م",1,0],["وَخُطوبٌ يَنقُصُ الصَب","رُ عَلَيها وَتَزيدُ",23,"د",1,0],["وخطب الصيدلية كان أدهى","وأنكر موقعا في مسمعيا",24,"ي",2,0],["وخطابة في كل ناد حافل","ينصبّ آذانا إليها النادى",25,"د",2,0],["وخطب الدين والدنيا جليل","ولكن قدر من فَقدا أجل",26,"ل",1,0],["وَخَطَّ بِالنورِ عَلى","لَوحِ الظَلامِ مَرحَبا",27,"ب",2,0],["وَخُطَّ لَكَ القَبرُ في رَوضَةٍ","يَميلُ عَلى الغُصنِ فيها الغُصُن",28,"ن",1,0],["وَخُطّي لَهُ بَينَ السَلاطينِ مَضجَعاً","وَقَبراً بِجَنبِ الفاتِحِ المُتَقَدِّمِ",29,"م",1,0],["وَخَطبُكَ يا رِياضُ أَمِ الدَواهي","عَلى أَنواعِها وَالنازِلاتُ",30,"ت",1,0],["وَخُطى المَسيحِ عَلَيكَ روحاً طاهِراً","بَرَكاتُ رَبِّكَ وَالنَعيمُ الغَيدَقُ",31,"ق",1,0],["وَخُطوطٍ كَأَنَّها هُدبُ ريمٍ","حَسُنَت صَنعَةً وَطولاً وَعَرضا",32,"ض",2,0],["وَخُطوطٍ تَكَفَّلَت لِلمَعاني","وَلِأَلفاظِها بِأَزيَنَ لَبسِ",33,"س",1,0],["وَخُطوبُ الزَمانِ ماكِثَةُ اللُب","ثِ عَلى أَنَّهُ سَريعُ المُرورِ",34,"ر",1,0],["وَخَطَبتَ مِنّي بَعدَ ذاكَ إِجازَةً","عَن نَقلِهِ حَتّى ظَنَنتُكَ هازي",35,"ز",2,0],["وَخَطوي تَحتَ رايَةِ لَيثِ غابٍ","بِسَطوَتِهِ لِصَرفِ الدَهرِ غابِن",36,"ن",1,0],["وخطِّيَّة تختَطُّ مِنهُم حيازِماً","وأحداقها زرقٌ وأجسادها حُمرُ",37,"ر",1,0],["وَخَطبٍ جَليلٍ دونَها قَد شَغَلتَهُ","وَفي دونِهِ شُغلٌ لِغَيرِكَ شاغِلُ",38,"ل",1,0],["وخطيبٍ تظنُّهُ","فائزاً وَهْوَ هالِكْ",39,"ك",1,1],["وخُطبة تُسمع الرهطينِ مُلْفيةً","في الذئب والحمَلِ المرعوبِ مُصغينا",40,"ن",2,0],["وَخِطابِ بِرٍّ نابَ عَنهُ سِفارَةً","إِنَ الخِطابَ عَلى البُعادِ تَلاقِ",41,"ق",1,0],["وَخُطّا بِأَطرافِ الأَسِنَّةِ مَضجَعي","وَرُدّوا عَلى عَينَيَّ فَضلَ رِدائِيا",42,"ي",2,0],["وَخُطّوا عَلى قَبري إِذا مِتُّ وَاِكتُبوا","قَتيلُ لِحاظٍ ماتَ وَهوَ عَشيقُ",43,"ق",1,0],["وَخَطَّ بِصَدغِهِ لِلحُسنِ واواً","فَنَقَّطَ خَدَّهُ بَعضُ المِدادِ",44,"د",1,0],["وَخَطِيّاً كأَشطانِ الرَكايا","وأَسيافاً يَقُمنَ وَينَحَنينا",45,"ن",2,0],["وَخُطَّةُ ماجِدٍ مِن آلِ لَأيٍ","إِذا ما قامَ صاحِبُها قَضاها",46,"ا",3,0],["وَخَطَّ فَوقَ حِجابِ الدُرِّ شارِبَهُ","بِنِصفِ صادٍ وَدالُ الصُدغِ كَالنونِ",47,"ن",1,0],["وَخِطَّةِ رِبحٍ في العُلى قَد أَجَبتُها","وَخِطَّةِ خَسفٍ ذاتِ بَخسٍ تَأَبَّيتُ",48,"ت",1,0],["وخطبتُ قبلَ القوْمِ خطبةَ فيصَلٍ","أُثني عليك فوعُد ربَّك قد وفَى",49,"ف",2,0],["وخطبتُ بالزَّوراء أُخرَى مثلَهَا","ووقفْتُ بينَ يديكَ هذا المَوقفا",49,"ف",2,0],["وَخَطيئَةٍ تَغلو عَلى مُستامِها","يَلقاكَ آخِرُ طَعمِها بِالأَوَّلِ",50,"ل",1,0],["وَخُطَّةِ حَزمٍ قَد كَشَفتَ بِها الرَدى","وَرَأسِ رَئيسٍ قَد بَعَثتَ بِهِ وَفدا",51,"د",2,0],["وَخَطّوا أَحاديثاً لَهُم في صَحائِفٍ","لَقَد ضاعَت الأَوراقُ فيها وَحِبرُها",52,"ر",3,0],["وَخُطوبُ دَهرٍ غَيرُ ذَلِكَ جَمَّةٌ","دونَ اِغتِذائِكَ وَالأَُمورُ لَبائِسُ",53,"س",1,0],["وخَطيباً لو قامَ بَينَ وُحُوشٍ","عَلّمَ الضّارِياتِ بِرَّ النِّقَادِ",54,"د",1,0],["وَخطوب صارعتهنَّ فَما عا","ب شهودي وإن غُلبت صراعى",55,"ع",2,0],["وخَطَّارَةٍ لَمْ يَنْضَحِ السِّلْمُ فَرْجَهَا","تُلَقَّحُ بِالمُرَّانِ حَتَّى تَشَذَّرَا",56,"ر",2,0],["وخُطّي لها قَبْراً يَضلّونَ دونَهُ","كقَبْرٍ لمُوسى ضَلَّهُ آلُ إسْرال",57,"ل",1,0],["وخططنا فى نقى الرمل فلم","تحفظ الريح ولا الرمل وعى",58,"ع",2,0],["وخطَّةَ ماجِدٍ كَلَّفتُ نَفسي","إذا ضاقُوا رَحِبتُ بِهُم ذِراعا",59,"ع",2,0],["وخُطوبُ الدَّهرِ لا يَبقَى لَها","ولِمَا تَأتي بهِ صُمُّ الجِبال",60,"ل",1,0],["وخطرت في التاريخ طيفا","تعشق الرؤيا انسكابه",61,"ب",2,0],["وَخَطمٌ كَأَنَّ الريحَ شَكَّتهُ بِالسَفا","طَويلٌ وَنابٌ كَالسِنانِ خَضيبُ",62,"ب",1,0],["وَخَطَبْتَ بِالصَوتِ الْجَهِيرِ","فَما امرؤٌ إِلا وَلَبَّى",63,"ب",2,0],["وخطابٌ يأتيك من نجلك الثَّا","ني قميصٌ جاءَت به البُشَراءُ",64,"ا",2,0],["وخطاهم في الأرض ترسم شعرا","هذبته السراء والضراء",65,"ا",2,0],["وخطو فلّاح هناك انحنى","يمحو بقايا العرق النازف",66,"ف",1,0],["وخطانا دم تجمّد في الأشواك","جمرا وفي الصخور مياسم",67,"م",1,0],["وخطوة على قبري إذا مت واكتبوا","قَتِيلُ لِحاظٍ مَاتَ وَهوَ عَشِيقُ",68,"ق",1,0],["وخطيبِ أقوامٍ عَبَأْتُ لنارِهِ","مَطَرِي،فَأَطْفَأَهَا بِدِيمَة ِ وَابِلِ",69,"ل",1,0],["وخطبك لا يفيه دمع باك","فموتك من بني العرب يبكي الغمام",70,"م",1,0],["وَخَطّاً كَما أَلقَت عَلَى صَحنِ خَدِّها","عَروسُ الرُّبَى وَشيَ الرِّياضِ المُنَمنَمِ",71,"م",1,0],["وخطبٌ تكادُ الأرض ترجُفُ خيفةَ","لديه وأشرافُ الرواسِي تُصَدَّعُ",72,"ع",1,0],["وخَطتْك أحداثُ الزمانِ ولا","برِحتْ رِباعَك ديمةٌ تجرِى",73,"ر",2,0],["وَخَطِّيَّةٌ يُلفى الرَدى تَبَعاً لَها","إِذا مَرَقَت في الأُسدِ مِنها الثَعالِبُ",74,"ب",1,0],["وَخَطِّيَّةٌ ما زالَ غَضّاً حَديثُها","إِذا شَهِدَت حَرباً وَإِن كُنَّ ذُبَّلا",75,"ل",2,0],["وَخَطيطَةٍ ضَنَّ الغَمامُ بِرَيِّها","خَلَّفتُها خَلفي وَسِرتُ مُيَمِّما",76,"م",2,0],["وخطكم لي عندكم شاهدٌ","عدلُ على احسانكم يقبلُ",77,"ل",1,0],["وخطأ إلا من يرى الخلق صورة","هويته لله عند التناظر",78,"ر",1,0],["وخطبٌ سمينٌ مثلُ رِدفِكَ ذقتُهُ","بجسمٍ نحيفٍ مثلِ خَصركَ ناحلِ",79,"ل",1,0],["وخَطِّيةٌ سُمْر وبيض صَوارمٌ","ومَسْرودةٌ زَغْفٌ ومُقْرَبة جُرْد",80,"د",1,0],["وخَطَّتْ على لَبّاتها البيضِ أَسْطُرا","يكون بأطراف الوَشيجِ لها نَقْط",81,"ط",1,0],["وخُطوبٌ تُحيل صِبْغتها الأب","شارَ فضلا عن أن تُحيل الشعورا",82,"ر",2,0],["وخطيبهم وولي عه","دهم رئيس الثائرين",83,"ن",1,0],["وَخَطَّ عَلى الخَدِّ لامُ العِذارِ","فَما أَحسَنَ الآسُ في الجُلَّنارِ",84,"ر",1,0],["وَخُطوبَ دَهرٍ طاحَ في ال","غُمَراتِ مِنها وَاللُجَج",85