m/139831",""],[4680,"أودى بكَ الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=185075",""],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[4767,"لو كتبت","https://www.poetsgate.com/ViewPoem.aspx?id=94860",""],[4767,"اختفاء المختار","https://www.poetsgate.com/ViewPoem.aspx?id=187661",""],[4789,"مي","https://www.poetsgate.com/ViewPoem.aspx?id=215394",""],[1703,"دعني أصبّ الدّمع مدرارا","https://www.poetsgate.com/ViewPoem.aspx?id=49901",""],[4852,"حانت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=215172",""],[4881,"بين شاعر وشعره","https://www.poetsgate.com/ViewPoem.aspx?id=200535",""],[4955,"ماذا دهانا كي يزيد بنا الطمع","https://www.poetsgate.com/ViewPoem.aspx?id=195087",""],[4978,"ماذا دهاك فلا تقوى على الكلم؟","https://www.poetsgate.com/ViewPoem.aspx?id=177181",""],[4980,"ماذا دهاني","https://www.poetsgate.com/ViewPoem.aspx?id=197780",""],[3271,"مرثية غصن الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=103533",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5187,"سكرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=29253",""],[5190,"بيني وبين الطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=153352",""],[5219,"إلى أرض الإسراء","https://www.poetsgate.com/ViewPoem.aspx?id=194255",""],[5219,"شمس الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=194905",""],[5219,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=194937",""],[5246,"أمن نسيم عليل صرت في أرق","https://www.poetsgate.com/ViewPoem.aspx?id=187056",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[5277,"العشرُ العجاف","https://www.poetsgate.com/ViewPoem.aspx?id=214857",""],[5299,"محاكمة","https://www.poetsgate.com/ViewPoem.aspx?id=210543",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5458,"عيد اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=72386",""],[5490,"عقد الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176377",""],[5533,"ناجَيْتُ طَيْفَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=176948",""],[5615,"آهات .....!","https://www.poetsgate.com/ViewPoem.aspx?id=193282",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[5644,"سامح فؤادًا","https://www.poetsgate.com/ViewPoem.aspx?id=198654",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[402,"عمر قطعت مداه قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=36485",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[402,"فوجئت فيك بأنكر الأنباء","https://www.poetsgate.com/ViewPoem.aspx?id=35024",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5966,"بردة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=158309",""],[6019,"صمتٌ يجرحُ","https://www.poetsgate.com/ViewPoem.aspx?id=166890",""],[6046,"فراغ في الصورة","https://www.poetsgate.com/ViewPoem.aspx?id=35242",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[433,"رحلة النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87052&r=&rc=5",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""]],"verses":[["ماذا دَهاكَ وَفَوقَ ظَه","رِكِ مَربِضُ الأَسَدِ الهَصورِ",0,"ر",1,0],["ماذا دَها قِبطِيَّ مِصرَ فَصَدَّهُ","عَن وُدِّ مُسلِمِها وَماذا يَنقِمُ",1,"م",1,0],["ماذا داهني فيك يا إلف الصبي","وعشيري المفدي بالشعراء",2,"ا",2,0],["مَاذَا دَهَانِي فِي اخْتِبَاري أَهْلَهَا","مِنْ كِذْبِ آمَالِي وَصِدْقِ عُيُونِي",3,"ن",2,0],["مَاذَا دَهَى الأَفْرَاخَ فِي ظِلٍّ ضَحَا","عَنْ أَيْكَةٍ فِي نَعْمَةٍ وَأَمَانِ",4,"ن",1,0],["مَاذَا دَهَى الْقفسْطَاطَ حينَ تَجَاوَبَتْ","أصْدَاؤُهَا لِنَوَاكَ بِالإرْنَانِ",5,"ن",1,0],["مَاذَا دَهَى العِلْمَ فِيهِ","وَكَانَ أَعْمَلَ عَالِمْ",6,"م",1,0],["ماذا دهى نهرَ الرُفَيل من البلى","حيث المجاري منهُ مندرسات",7,"ت",1,0],["ماذا دهاك من الهوان فأصبحت","آثار عزّك وهي مُنطَمِسات",7,"ت",1,0],["ماذا دعا البينَ إلى حَيَّةٍ","صمَّاء من يَنْصِبِ لها يَنْصَبِ",8,"ب",1,0],["ماذا دعاك بلا أجرٍ تطالبُهُ","إلى قتالك قُدَّامَ التوابيتِ",9,"ت",1,0],["ماذا دَهاني يَومَ بِنتَ فَعَقَّني","فيكَ القَريضُ وَخانَني إِمكاني",10,"ن",2,0],["ماذا دَهاكَ مِنَ الأُمو","رِ وَكُنتَ داهِيَةَ الأُمور",11,"ر",1,0],["ماذا دهى مصر من الطواري","ولقيت من ذلك الجوار",12,"ر",1,0],["مَاذَا دَهَى فِيهِ المُحبِّينَ الأُولَى","رُزِئُوهُ بَيْنَ مَغَارِبٍ وَمَشَارِقِ",13,"ق",1,0],["مَاذَا دَهَانِي اليَوْمَ حَتَّى لاَ أَرَى","إِلاَّ مَكَانَ تَفَجُّعِي وَبُكَائِي",14,"ا",2,0],["مَاذَا دَهى فِيكَ الَّذِينَ","فَكَكْتَ مِن عُسْرٍ بُيُسْرِكْ",15,"ك",1,0],["ماذَا دَهاهُ يَومَ بينك","في الأَرقِّ من الشُّعُورِ",16,"ر",1,0],["مَاذَا دَهَانِي فِيكَ يا إِلْفَ الصِّبَا","وَعَشِيرِيَ المَفْدِيَّ بِالعُشَرَاءِ",17,"ا",2,0],["ماذا دنا منه º توثب غابة","من اذرع صخرية الاخفاف؟",18,"ف",1,0],["ماذا دعاك إلا المقام بعُكبَرا","وعدلت عن وطنٍ ببابِ الطاق",19,"ق",1,0],["ماذا دَهاهُ اليَومَ الشَه","واتُ تَعرفُ ما دَهاه",20,"ا",2,0],["ماذا دهى الخضراءَ صوَّحَ غصنها","وَعلا محيّاها الوسيمَ قتام",21,"م",1,0],["ماذا دهى ريشتي، ما بالُها وَجَمَتْ","ما بالُ إبداعها في رسمها انحسرا؟!",22,"ر",2,0],["ماذا دعاك إلى بعد جعلت به","قلبي الحزين لأصناف الأسى نزلا؟",23,"ل",2,0],["ماذا دَهاكِ إلى مَتى","هذا التَأسُّفُ والنَّحيبُ",24,"ب",1,0],["ماذا دهى جبل الرجاف فاصطرعت","في جوفه حرق وارتج صوان",25,"ن",1,0],["ماذا دهاه ؟ دهته عينا جؤذر","أكبادنا من ضربها تتفطر",26,"ر",1,0],["ماذا دهى الشعبَ في أقلامِ قادِتهِ","كأنما هي للغربان عيدانُ",27,"ن",1,0],["ماذا دهاك وأنتَ زينةُ مجلسٍ","ورجاءُ أحبابِ ونفحةُ بابل",28,"ل",1,0],["ماذا دَهَى الأملَ العريضَ فطالما","أوحى لنا والآن لطمةٌ عانِ",29,"ن",1,0],["ماذا دَهَى هذى الغوالي كلَّها","وشخُوصها ما زلن في وجداني",29,"ن",2,0],["مَاذَا دَعاكَ لِضُرٍّ بالقَرابَةِ وال","أَصْحابِ بَعْدَ الرَّعايا والْمَساكِينِ",30,"ن",1,0],["مَاذا دعَاكَ إلى نُكرانِ مَعرِفَتي","وأنتَ أنتَ صَديقُ السِّرِّ والعَلَنِ",31,"ن",1,0],["ماذا دهاكم يا كلا","ب النبح من ليث العرين",32,"ن",1,0],["ماذا دعاكَ إلى أن صارَ خالِصتي","وخيرُ قومي لديك اليومَ مُحْتَجِبا",33,"ب",2,0],["ماذا دهاك من النوائبْ","سلطانة القوم الغوالبْ",34,"ب",1,1],["ما ذَادَه عن نهلٍ مُرْسِلهُ","في الملتقى إلى خَفيِّ الثغر",35,"ر",1,0],["ماذا دهى أم ملوك الورى","كيف عراها من سؤالي الخفوق",36,"ق",1,0],["ماذا دهاك وما دهاني في النوى","حسبي وحسبك في الفراق دواهيا",37,"ي",2,0],["ماذا دهى الزيغ من خطب الكليم لو","أن العقول إلى الأنصاف تبتدر",38,"ر",1,0],["ماذا دهاكَ من الخطوبِ فأَظلمتْ","دارٌ رأَيتُ دموعَها تسكابا",39,"ب",2,0],["ماذا دهاك وأنت أنت بهمةٍ","شمّاء لا تعنو لسطوة قادر",40,"ر",1,0],["ماذا دهاك وقد حلّ القضاء على","دماغك الملتظي بالنار تزكيه",41,"ي",2,0],["ماذا دهى قلبك المملوء عاطفةً","حتّى وهى فرمى في القوم أكدارا",42,"ر",2,0],["ماذا دهى أهلي أجابت ماتوا","ويلي وإخوان الصّفاء رفات",43,"ت",1,0],["ماذا دهاكَ وهل منامٌ ما أرى","أم ذاك في عينيَّ حُلمٌ صُوِّرا",44,"ر",2,0],["ماذا دهاك وأنت ذو جلد على","وخز الرماح اذا التقى الجمعان",45,"ن",1,0],["ماذا دها البلبل الشادي وكان له","في الروض وكر على نبع به جاري?!",46,"ر",2,0],["ماذا دهاه فأمسى ما بساحته","وكر, يقي الطير من ضيم وأوضار?",46,"ر",1,0],["ماذا دعاك إلى وعد تصيره","بالخلف والمطل والتسويف إبعادا",47,"د",2,0],["ماذا دهاك وكنت ضيف معاشر","اسدوا اليك المدح بالاطاب",48,"ب",1,0],["ماذا دعاكَ اليومَ للرحيلِ","عن حَرَمِ الإلهِ والرسولِ",49,"ل",1,0],["ماذا دهى الكونُ هل شعواء آتية","وهل تحقق من أطماعها الدولُ",50,"ل",1,0],["ماذا دهاك فقد أصبحت هاوية","مهاوي الذل من حينٍ إلى عطب",51,"ب",1,0],["ماذا دَهَى الأَرْضَ حَتَّى ثارَ ثائِرُها","فأَصْبَحَتْ بِخُطُوبِ الوَيْلِ تَرْتَطِم",52,"م",1,0],["ماذا دَهاكِ فقالتْ حاجَةٌ عَرَضَتْ","فكانَ ما دُونَهُ سَيْفُ الرَّدَى الخَذِمُ",52,"