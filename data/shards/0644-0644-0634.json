{"poems":[[73,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[93,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[72,"يا سائلي عن رتبة الحلي في","https://www.aldiwan.net/poem20068.html","الكامل"],[91,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[92,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[89,"طلعت من الافق الجديد عطارد","https://www.aldiwan.net/poem44628.html","الكامل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[62,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[45,"بالله يا ربع لما ازددت تبيانا","https://www.aldiwan.net/poem66659.html","البسيط"],[45,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[49,"ما للفتى مانع من القدر","https://www.aldiwan.net/poem62070.html","الكامل"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[48,"قد أغتدي والليل أحوى السد","https://www.aldiwan.net/poem63254.html","الرجز"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"للشامتين رزايا في شماتهم","https://www.aldiwan.net/poem22203.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85643","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20990","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[106,"الإنسان الآلي","https://www.poetsgate.com/ViewPoem.aspx?id=179449",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[90,"تطويق","https://www.poetsgate.com/ViewPoem.aspx?id=179173",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[105,"يا بريد النيل إن جئت الشآما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55044&r=&rc=214",""],[20,"للشرف العود فأَكنافه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69761&r=&rc=2",""],[115,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[195,"جاء الربيع وأنت راقد","https://www.aldiwan.net/poem39867.html","مجزوء الكامل"],[202,"يا من على وجناته","https://www.aldiwan.net/poem53101.html","مجزوء الكامل"],[230,"من شيمة الدهر إعراض وإقبال","https://www.aldiwan.net/poem14796.html","البسيط"],[252,"طيف","https://www.aldiwan.net/poem36223.html","مجزوء الرمل"],[257,"قد قال محيي الدين في أبياته","https://www.aldiwan.net/poem35818.html","الكامل"],[273,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[280,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[296,"للشمس إذ هجعت أضغاث أحلام","https://www.aldiwan.net/poem36845.html","عموديه"],[324,"حضر الرحيل وشدت الأحداج","https://www.aldiwan.net/poem44288.html","البسيط"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[351,"الحمد لله أَتم الحمد","https://www.aldiwan.net/poem38727.html","الرجز"],[351,"للشيخ بحر كرامات قد اشتهرت","https://www.aldiwan.net/poem39790.html","البسيط"],[362,"قال العراق وقد رحلت مودعا","https://www.aldiwan.net/poem60802.html","البسيط"],[364,"الشكر والإحسان في دين العلا","https://www.aldiwan.net/poem17281.html","الكامل"],[394,"ايقر همتك البعيده","https://www.aldiwan.net/poem11021.html","عموديه"],[397,"أغلى الهدايا","https://www.aldiwan.net/poem6722.html","عموديه"],[397,"أنا مبحر","https://www.aldiwan.net/poem6758.html","عموديه"],[429,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[441,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[447,"يزهو القريض به","https://www.aldiwan.net/poem972.html",""],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[456,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[513,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[556,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[560,"للشيخ قاسم جنبلاط كرامة","https://www.aldiwan.net/poem52639.html","الكامل"],[560,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[560,"للشعر في كل عصر مركب خشن","https://www.aldiwan.net/poem52868.html","البسيط"],[560,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"]],"verses":[["لِلشَفيعِ الثَناءُ وَالحَمدُ في صَوبِ","الحَيا لِلرِياحِ لا لِلغُيومِ",0,"م",1,0],["لِلشَّعْبِ نَفعٌ جِدُّ نَفْعٍ بِهَا","كَفَاؤُهُ لَيسَ مِنَ اللِّعْبِ",1,"ب",1,0],["للشعر حلبان وذلك راجح","ولّى الزمان به وهذا قيم",2,"م",1,0],["لِلشَوكِ حَظُّ الوَردِ مِن تَغريدِها","وَسَيكَهُ مِن بَعدُ في إِعوالِها",3,"ل",3,0],["لِلشَمسِ تُبطِئُ في وَداعِ","ذُراكَ كَيلا تَحزَنا",4,"ن",2,0],["لِلشعِرِ المَفتونِ يُخلَقُ لاهِياً","مِن مَوجِهِ حوراً وَيَعشَقُ حورَهُ",5,"ه",1,0],["للشَّبابِ السَّكرانِ للأَمَلِ المع","بود لليأْسِ للأَسى للمَنُونِ",6,"ن",1,0],["للشُّعاعِ الجميلِ أنتِ وللأنسا","مِ والزَّهر فالْعَبي وأَطيلي",7,"ل",2,0],["للشعر في فلق التجدد ثورة","وكأن شيطان التجدد مارد",8,"د",1,0],["للشيخ نفس بالحيا","ة تنوء وهي له تسر",9,"ر",1,0],["لِلشَمسِ فيهِ وَلِلرِياحِ وَلِلسَحا","بِ وَلِلبِحارِ وَلِلأُسودِ شَمائِلُ",10,"ل",1,0],["للشهبِ وقفةُ خوفٍ في مدارجها","ولم يَقِفْكَ ارتياعٌ في مجاريكا",11,"ك",2,0],["لِلشَيءِ وَقتٌ وَإِبّانٌ وَلَستَ تَني","تَلقى لِمَعروفِهِ وَقتاً وَإِبّانا",12,"ن",2,0],["لِلشَهرِ أَن تَدَعَ المَلاهي كُلَّها","فيهِ وَإِن كَرُمَت عَلى النَدمانِ",13,"ن",1,0],["لِلشَيبِ في عارِضَيكَ بارِقَةٌ","تَنهاكَ عَمّا أَرى مِنَ الأَشَرِ",14,"ر",1,0],["لِلشّرقِ حُرْمَتُه فمن يَعْبَثْ بها","يَلْقَ الهَوانَ ومن يَصُنْها يَغْنَمِ",15,"م",1,0],["لِلشَّرِّ زلزالٌ تَبيتُ شُعوبُها","ترتَجُّ منه وللأَذَى طُوفانُ",16,"ن",1,0],["للشَّآمينَ منّا ولنا","منهمُ العهدُ الذي يَبقَى لِزاما",17,"م",2,0],["لِلشُّمِّ ميعادٌ يجيءُ وهذه","ملء الحوادثِ ما لها ميعادُ",18,"د",1,0],["لِلشَبَحِ الحائِلِ مُستَعِدِّ","عايَنَ بَعدَ النَظَرِ المُمتَدِّ",19,"د",1,0],["لِلشَمسِ يَسجُدُ طائِعاً رَيحانُهُ","وَيَبيتُ يَأرَقُ ضَيفُهُ بِذُبابِهِ",20,"ب",2,0],["لِلشامِتينَ رَزايا في شِماتِهِمُ","فَكُن مُصاباً وَلا تُحسَب مِنَ الشُمُتِ",21,"ت",1,1],["للشعر حق مضاعُ","قد أنكرته البقاعُ",22,"ع",1,1],["للشعب في مصر عز","ضخم على الدهر باقي",23,"ي",1,0],["للشك أشباح تَلوح لجاهل","فَيَقول ماذا تلكم الأشباح",24,"ح",1,0],["للشعر في الآفاق حين تَقوله","نفَسٌ كَما هبَّ الصَّبا خفاق",25,"ق",1,0],["للِشَّرَفِ العَودُ فأَكنافُهُ","ما بَينَ جُمرانَ ويَنصُوبِ",26,"ب",1,1],["لِلشِّعْرِ في الدَّهْرِ حُكْمٌ لا يُغَيِّرُهُ","مَا بِالْحَوادِثِ مِنْ نَقْضٍ وَتَغْيِيرِ",27,"ر",1,1],["لِلشَّرْقِ فِي اسْتِكْمَالِهَا","أَثَرٌ يَحُجُّ يه حَسُوَدَهْ",28,"د",2,0],["للشعرُ منطلقَ الجوانحِ هائماً","بين السواقي الخضر والأوراد",29,"د",1,0],["للشيخ ما يشتهيه الشيخ من عقبٍ","ولليتيم من الآباء ما شاء",30,"ا",2,0],["للشرق ماض، كلما سنحت له","ذكراه يزفرُ زفرة المتنهد",31,"د",1,0],["للشّمسِ فيهِ وللسّحابِ وللبِحَا","رِ وللأسُودِ وللرّياحِ شَمَائِلُ",32,"ل",1,0],["للشاعرينَ قُلوبٌ في تململها","هي البَراكينُ إذ تَهتاجُها الحِمَم",33,"م",1,0],["للشعر منزلةٌ لديَّ أُجَّلها","وأُحلها – لو أقدِر – الأفلاكا",34,"ك",2,0],["للشوك حظّ الورد من تغريدها","وسريكه من بعد إعرالها",35,"ل",3,0],["للشآميين منا ولنا","منهم العهد الذي يبقى لزاما",36,"م",2,0],["للشَرَفُ العَودُ فَأَكنافُهُ","ما بَينَ حُمرانَ فَيَنصوبِ",37,"ب",1,1],["لِلشَّاعِرِ المِنْطِيقِ أَجْنِحَةُ العُلَى","في قَومِهِ وسِواهُ ليس بِشاعِرِ",38,"ر",1,0],["للشيب منّا والشباب فكلّنا","سعد وخالد",39,"د",1,0],["للشكل فيك لطائفٌ","يلعَبنَ بالفِطَن اللطيفَهْ",40,"ف",2,0],["لِلشامِتينَ بِنا يَومٌ نَصولُ بِهِ","عَلَيهِمُ بِالأَماني مِثل ما صالوا",41,"ل",3,0],["للشقا أهديتني حي","ناً،فلا يرجى نعيمُ",42,"م",1,0],["للشرق لا للغرب نسبة شيخنا","وأنا الّذي أبداً إليه أُنسب",43,"ب",1,0],["لِلشَّرقِ والغَربِ اسْتِبَاقٌ نَحْوَهُ","كُلّ قُبَيْلَ دُعَائِهِ لَبَّاهُ",44,"ا",2,0],["لِلشافِعِيِّ بِكُم فَخارٌ بَعدَهُ","أَنوارُهُ مَشهورَةٌ لا تُكتَمُ",45,"م",1,0],["للشمسِ إذْ هَجَعَتْ أضغاثُ أحلامِ","أما ترى الأُفْقَ أمسى لوحَ رسّامِ",46,"م",1,1],["لِلشَّوقِ نيرانٌ قَدَحنَ بِقَلبِهِ","حَتّى اِستَمَرَّ بِهِ الهَوى المِلجاجُ",47,"ج",1,0],["لِلشَيءِ تَعريفاً وَمِنهُ نِسبَةً","وَعَنهُ تَمييزاً بِهِ اِسماً شُهِر",48,"ر",1,0],["لِلشَهم إِبراهيم ذي الآدابِ","خُلاصة الإِخوان وَالأَصحابِ",49,"ب",1,0],["لِلشَيخ بَحرٍ كَراماتٌ قَد اِشتَهَرَت","في الناس أَشهَر مِن نارٍ عَلى عَلَمِ",50,"م",1,1],["للشّمسِ من أُفُقِ السّماء إذا هوَتْ","بدَلٌ ومالكَ لا عَدِمْتَ بَديل",51,"ل",1,0],["لِلشِعرِ ميزانٌ فَكَيفَ بِشُكرِهِ","جوداً يَفيضُ وَما لَهُ ميزانُ",52,"ن",1,0],["للشرق في استكمالها","أثر يحج به حسوده",53,"د",2,0],["للشَّمسِ أطْوارٌ ، صباحٌ مُشرقٌ","وظَهيرةٌ ، وغُروبها المُترامي",54,"م",2,0],["للشعر قومٌ يعشقونَ حروفهُ","ويرونَ فيهِ الرَّوضَ والأشجارا",55,"ر",2,0],["للشّرعِ منه مشرِّعٌ","يُدعى لديهِ البحرُ ثَمْدا",56,"د",2,0],["للشعر للعلم ليلى للفصاحة قد","جا بابدع مرويء لإنسان",57,"ن",1,0],["للشهم راشد من قواعد صرحه","ركن عليه من النضارة رونق",58,"ق",1,0],["للشعب في جنبيك ود خالص","ولك المحبة والولاء المطلق",58,"ق",1,0],["للشيخ والكهل المرجّح منهمُ","ما للموشَّح والصغيرِ المرضَعِ",59,"ع",1,0],["للشِّعر من حولها مذ صرتَ قبلتَهُ","طرفٌ بغنجٍ وتهليلٌ وتكبيرُ",60,"ر",1,0],["للشعر بين جماله وجميله","شرح وإن قصرت منه طويل",61,"ل",1,0],["للشيء فالشيء إذاً هالك","ووجهه باق على خيره",62,"ر",2,0],["للشِّيخِ قاسِمِ جنبلاطَ كَرامةٌ","بِحُلولِ ساحةِ شيخِنا الأوزاعي",63,"ي",1,1],["للشَّامِ جسمٌ قد أُصيبَ فُؤَادُهُ","فَبَدَت عليهِ من السَّقامِ علائِمُ",64,"م",1,0],["للشِعرِ في كُلِّ عصرٍ مَرْكبٌ خَشِنُ","لا يَستَقِلُّ عليهِ الرَّاكبُ الوَهِنُ",65,"ن",1,1],["للشوقِ عِندكَ مُقعِدٌ ومُقيمُ","ذاك الصِّحيحُ وأنتَ منهُ سقيمُ",66,"م",1,1],["للشَيْبِ أنفعُ طِبٍ في الفتى نَبَأً","بما يوافي وترهيباً وتنبيها",67,"ي",3,0]]}