://www.poetsgate.com/ViewPoem.aspx?id=53457",""],[5848,"الشيخ عبدالعزيز بن جامع","https://www.poetsgate.com/ViewPoem.aspx?id=53333",""],[5853,"القصيدة الاخيرة","https://www.poetsgate.com/ViewPoem.aspx?id=175623",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[5956,"صححتُ في حلمي ثلاث قصائد","https://www.poetsgate.com/ViewPoem.aspx?id=201551",""],[4442,"براعم الروضة أعللها النطف","https://www.poetsgate.com/ViewPoem.aspx?id=171004",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6152,"اشتاق للشوق","https://www.poetsgate.com/ViewPoem.aspx?id=206728",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[6245,"حالات مطرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87629&r=&rc=0",""],[6258,"وحي الفراسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75482&r=&rc=54",""],[454,"يزهو القريض به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82684&r=&rc=48",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""]],"verses":[["لِلشَفيعِ الثَناءُ وَالحَمدُ في صَوبِ","الحَيا لِلرِياحِ لا لِلغُيومِ",0,"م",1,0],["لِلشَّعْبِ نَفعٌ جِدُّ نَفْعٍ بِهَا","كَفَاؤُهُ لَيسَ مِنَ اللِّعْبِ",1,"ب",1,0],["للشعر حلبان وذلك راجح","ولّى الزمان به وهذا قيم",2,"م",1,0],["للشمسِ تُبطئُ في وداعِ","ذُراكَ كيلا تَحزنا",3,"ن",2,0],["لِلشَوكِ حَظُّ الوَردِ مِن تَغريدِها","وَسَيكَهُ مِن بَعدُ في إِعوالِها",4,"ل",3,0],["لِلشعِرِ المَفتونِ يُخلَقُ لاهِياً","مِن مَوجِهِ حوراً وَيَعشَقُ حورَهُ",5,"ه",1,0],["للشَّبابِ السَّكرانِ للأَمَلِ المع","بود لليأْسِ للأَسى للمَنُونِ",6,"ن",1,0],["للشُّعاعِ الجميلِ أنتِ وللأنسا","مِ والزَّهر فالْعَبي وأَطيلي",7,"ل",2,0],["للشعر في فلق التجدد ثورة","وكأن شيطان التجدد مارد",8,"د",1,0],["للشيخ نفس بالحيا","ة تنوء وهي له تسر",9,"ر",1,0],["لِلشَمسِ فيهِ وَلِلرِياحِ وَلِلسَحا","بِ وَلِلبِحارِ وَلِلأُسودِ شَمائِلُ",10,"ل",1,0],["للشهبِ وقفةُ خوفٍ في مدارجها","ولم يَقِفْكَ ارتياعٌ في مجاريكا",11,"ك",2,0],["لِلشَيءِ وَقتٌ وَإِبّانٌ وَلَستَ تَني","تَلقى لِمَعروفِهِ وَقتاً وَإِبّانا",12,"ن",2,0],["لِلشَهرِ أَن تَدَعَ المَلاهي كُلَّها","فيهِ وَإِن كَرُمَت عَلى النَدمانِ",13,"ن",1,0],["لِلشَيبِ في عارِضَيكَ بارِقَةٌ","تَنهاكَ عَمّا أَرى مِنَ الأَشَرِ",14,"ر",1,0],["لِلشّرقِ حُرْمَتُه فمن يَعْبَثْ بها","يَلْقَ الهَوانَ ومن يَصُنْها يَغْنَمِ",15,"م",1,0],["لِلشَّرِّ زلزالٌ تَبيتُ شُعوبُها","ترتَجُّ منه وللأَذَى طُوفانُ",16,"ن",1,0],["للشَّآمينَ منّا ولنا","منهمُ العهدُ الذي يَبقَى لِزاما",17,"م",2,0],["لِلشُّمِّ ميعادٌ يجيءُ وهذه","ملء الحوادثِ ما لها ميعادُ",18,"د",1,0],["لِلشَبَحِ الحائِلِ مُستَعِدِّ","عايَنَ بَعدَ النَظَرِ المُمتَدِّ",19,"د",1,0],["لِلشَمسِ يَسجُدُ طائِعاً رَيحانُهُ","وَيَبيتُ يَأرَقُ ضَيفُهُ بِذُبابِهِ",20,"ب",2,0],["لِلشامِتينَ رَزايا في شِماتِهِمُ","فَكُن مُصاباً وَلا تُحسَب مِنَ الشُمُتِ",21,"ت",1,1],["للشعر حق مضاعُ","قد أنكرته البقاعُ",22,"ع",1,1],["للشعب في مصر عز","ضخم على الدهر باقي",23,"ي",1,0],["للشك أشباح تَلوح لجاهل","فَيَقول ماذا تلكم الأشباح",24,"ح",1,0],["للشعر في الآفاق حين تَقوله","نفَسٌ كَما هبَّ الصَّبا خفاق",25,"ق",1,0],["للِشَّرَفِ العَودُ فأَكنافُهُ","ما بَينَ جُمرانَ ويَنصُوبِ",26,"ب",1,1],["لِلشِّعْرِ في الدَّهْرِ حُكْمٌ لا يُغَيِّرُهُ","مَا بِالْحَوادِثِ مِنْ نَقْضٍ وَتَغْيِيرِ",27,"ر",1,1],["لِلشَّرْقِ فِي اسْتِكْمَالِهَا","أَثَرٌ يَحُجُّ يه حَسُوَدَهْ",28,"د",2,0],["للشعرُ منطلقَ الجوانحِ هائماً","بين السواقي الخضر والأوراد",29,"د",1,0],["للشيخ ما يشتهيه الشيخ من عقبٍ","ولليتيم من الآباء ما شاء",30,"ا",2,0],["للشرق ماض، كلما سنحت له","ذكراه يزفرُ زفرة المتنهد",31,"د",1,0],["للشعب يوم تستثير جراحه","فيه ويقذف بالرقود المرقد",32,"د",1,0],["للشّمسِ فيهِ وللسّحابِ وللبِحَا","رِ وللأسُودِ وللرّياحِ شَمَائِلُ",33,"ل",1,0],["للشاعرينَ قُلوبٌ في تململها","هي البَراكينُ إذ تَهتاجُها الحِمَم",34,"م",1,0],["للشعر منزلةٌ لديَّ أُجَّلها","وأُحلها – لو أقدِر – الأفلاكا",35,"ك",2,0],["للشوك حظّ الورد من تغريدها","وسريكه من بعد إعرالها",36,"ل",3,0],["للشآميين منا ولنا","منهم العهد الذي يبقى لزاما",37,"م",2,0],["للشَرَفُ العَودُ فَأَكنافُهُ","ما بَينَ حُمرانَ فَيَنصوبِ",38,"ب",1,1],["لِلشَّاعِرِ المِنْطِيقِ أَجْنِحَةُ العُلَى","في قَومِهِ وسِواهُ ليس بِشاعِرِ",39,"ر",1,0],["للشياطين في مداه كهوفٌ","كلُّ كهف يُودي إلى سرداب",40,"ب",1,0],["للشيب منّا والشباب فكلّنا","سعد وخالد",41,"د",1,0],["للشكل فيك لطائفٌ","يلعَبنَ بالفِطَن اللطيفَهْ",42,"ف",2,0],["لِلشامِتينَ بِنا يَومٌ نَصولُ بِهِ","عَلَيهِمُ بِالأَماني مِثل ما صالوا",43,"ل",3,0],["للشقا أهديتني حي","ناً،فلا يرجى نعيمُ",44,"م",1,0],["للشرق لا للغرب نسبة شيخنا","وأنا الّذي أبداً إليه أُنسب",45,"ب",1,0],["لِلشَّرقِ والغَربِ اسْتِبَاقٌ نَحْوَهُ","كُلّ قُبَيْلَ دُعَائِهِ لَبَّاهُ",46,"ا",2,0],["لِلشافِعِيِّ بِكُم فَخارٌ بَعدَهُ","أَنوارُهُ مَشهورَةٌ لا تُكتَمُ",47,"م",1,0],["للشمسِ إذْ هَجَعَتْ أضغاثُ أحلامِ","أما ترى الأُفْقَ أمسى لوحَ رسّامِ",48,"م",1,1],["لِلشَّوقِ نيرانٌ قَدَحنَ بِقَلبِهِ","حَتّى اِستَمَرَّ بِهِ الهَوى المِلجاجُ",49,"ج",1,0],["لِلشَيءِ تَعريفاً وَمِنهُ نِسبَةً","وَعَنهُ تَمييزاً بِهِ اِسماً شُهِر",50,"ر",1,0],["لِلشَهم إِبراهيم ذي الآدابِ","خُلاصة الإِخوان وَالأَصحابِ",51,"ب",1,0],["لِلشَيخ بَحرٍ كَراماتٌ قَد اِشتَهَرَت","في الناس أَشهَر مِن نارٍ عَلى عَلَمِ",52,"م",1,1],["للشّمسِ من أُفُقِ السّماء إذا هوَتْ","بدَلٌ ومالكَ لا عَدِمْتَ بَديل",53,"ل",1,0],["لِلشِعرِ ميزانٌ فَكَيفَ بِشُكرِهِ","جوداً يَفيضُ وَما لَهُ ميزانُ",54,"ن",1,0],["للشرق في استكمالها","أثر يحج به حسوده",55,"د",2,0],["للشَّمسِ أطْوارٌ ، صباحٌ مُشرقٌ","وظَهيرةٌ ، وغُروبها المُترامي",56,"م",2,0],["للشعر قومٌ يعشقونَ حروفهُ","ويرونَ فيهِ الرَّوضَ والأشجارا",57,"ر",2,0],["للشّرعِ منه مشرِّعٌ","يُدعى لديهِ البحرُ ثَمْدا",58,"د",2,0],["للشعر للعلم ليلى للفصاحة قد","جا بابدع مرويء لإنسان",59,"ن",1,0],["للشهم راشد من قواعد صرحه","ركن عليه من النضارة رونق",60,"ق",1,0],["للشعب في جنبيك ود خالص","ولك المحبة والولاء المطلق",60,"ق",1,0],["للشيخ والكهل المرجّح منهمُ","ما للموشَّح والصغيرِ المرضَعِ",61,"ع",1,0],["للشِّعر من حولها مذ صرتَ قبلتَهُ","طرفٌ بغنجٍ وتهليلٌ وتكبيرُ",62,"ر",1,0],["للشعر بين جماله وجميله","شرح وإن قصرت منه طويل",63,"ل",1,0],["للشيء فالشيء إذاً هالك","ووج