{"poems":[[53,"وصديق أجبته إذ دعاني","https://www.aldiwan.net/poem61866.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43858","البسيط"],[303,"أرأيت كيف ذرى الدموع وناحا","https://www.aldiwan.net/poem36810.html","عموديه"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77972","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216594",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4963,"يادار ابومتعب بك الشعر مفتون","https://www.poetsgate.com/ViewPoem.aspx?id=23951",""],[5461,"ميلت نجمة حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=504",""],[5480,"الأسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=1159",""],[5677,"(بتزين باكر)","https://www.poetsgate.com/ViewPoem.aspx?id=139686",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[402,"غلب الموت فالحياة ثكول","https://www.poetsgate.com/ViewPoem.aspx?id=36544",""]],"verses":[["هاض حريتي وأوثق بالمنْ","زُور من نيله لسانيَ عَقْدا",0,"د",2,0],["هَاضَ عَظْمِي وَمَا تَرِحْتُ عَلَى العِلاَّ","تِ مُنْذُ الصِّبَا إِلَيْهِ أَمِيلُ",1,"ل",1,0],["هاضَ الرَدى أَعظُمي وَعادَت","مَحاسِنُ الدَهرِ كَالمَساوي",2,"ي",1,1],["هاضوا جناحيها وَخلوا قبلها","غرضاً يسيل من السهام جراحا",3,"ح",2,0],["هاض اِنتقالك يا أَخا الإِشفاق","منا العظام إِلى جوار الباقي",4,"ق",2,1],["هَاضْ جيلي بَكْتِب ابياته","عرب نظمي مِنْ لِهْ فْطينا",5,"ن",2,0],["هاضَ الجبيرَ مِن عِداهُ وَوَعى","بِهِ كَسِيرُ المُعتَفِينَ وائتَسَى",6,"ا",1,0],["هاض الشعر يادار شبه الجزيره","يادار ابومتعب بك الشعر مفتون",7,"ن",1,0],["هاضني صوت الضمير إلى شتكى","اختنق ماله سميع ولا مجيب",8,"ب",1,0],["هاضت قوافي فالبلد تعتلي آآآه","وتشّل شله طايله بارقابها",9,"ب",3,0],["هاضت من جروحي تباريح الأقلام","قصت على أوجاع القصيد التذاكر",10,"ر",1,0],["هاضمين حقهن بين الآنام","حسروهن عقب ماهن مترفات",11,"ت",1,0],["هاض عظمي وما برحت على العلات","منذ الصبا إليه أميل",12,"ل",1,0]]}