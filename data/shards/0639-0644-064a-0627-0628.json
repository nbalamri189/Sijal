{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[74,"إليك مدير الكأس عني إنني","https://www.aldiwan.net/poem18552.html","الطويل"],[31,"لعمري لقد أسريت لا ليل عاجز","https://www.aldiwan.net/poem6023.html","الطويل"],[91,"الشعر ما قاله الكرخي عبود","https://www.aldiwan.net/poem44750.html","البسيط"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"مصاب بني الدنيا عظيم بأدهم","https://www.aldiwan.net/poem62830.html","الطويل"],[47,"على ابن المغيرة أن يقتلا","https://www.aldiwan.net/poem65651.html","المتقارب"],[30,"لئن صبر الحجاج ما من مصيبة","https://www.aldiwan.net/poem5279.html","الطويل"],[63,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[107,"أأنت يا ابن رزام تغلب القدرا","https://www.aldiwan.net/poem43581.html","البسيط"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/7954","الطويل"],[37,"خليليّ إنْ أمُّ الحكيم تحمَّلتْ","https://www.poetsgate.com/ViewPoem.aspx?id=22071",""],[53,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[275,"هذا قران سعيد أكسب الدارا","https://www.aldiwan.net/poem35264.html","البسيط"],[325,"رزء به كل القلوب انكوت","https://www.aldiwan.net/poem61622.html","الطويل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[422,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[447,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126903","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122329","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77603","الهزج"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120082","المتقارب"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130706","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78026","الطويل"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117124","المتقارب"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67404","السريع"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110697","الوافر"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2577,"","https://poetry.dctabudhabi.ae/diwan/poem/80147","الوافر"],[3176,"","https://poetry.dctabudhabi.ae/diwan/poem/203959","الوافر"],[3220,"","https://poetry.dctabudhabi.ae/diwan/poem/203416","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112661","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129499","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114241","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70050","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86456","الطويل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103270","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72501","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136440",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4767,"أتاك الشكر","https://www.poetsgate.com/ViewPoem.aspx?id=178839",""],[4767,"شهداء العقيدة","https://www.poetsgate.com/ViewPoem.aspx?id=179282",""],[5183,"نبأة الهناء","https://www.poetsgate.com/ViewPoem.aspx?id=180228",""],[5397,"ما للزمان قديما طرده انعكسا","https://www.poetsgate.com/ViewPoem.aspx?id=157929",""],[5518,"توسلت بالمختار أرجى الوسائل","https://www.poetsgate.com/ViewPoem.aspx?id=190036",""],[5561,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=196755",""],[5736,"مرام بنت الشام","https://www.poetsgate.com/ViewPoem.aspx?id=208480",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[1793,"لَعائِنُ اللَهِ مُتابَعاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=14816",""],[6125,"مَتَىٰ يَا لَيلُ تَشرَعُ بالفِرَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207932",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""]],"verses":[["على ابنة مبعوث الإله وأمه","وكوثره المعطى وزوج الموَّكل",0,"ل",1,0],["عَلى أَبرَقِ الحَنّانِ كانَ حَنينُنا","وَبِالجِزعِ مَبكىً إِن مَرَرنا وَمَجزَعُ",1,"ع",1,0],["عَلى اِبنِ العاصي دِلاصٌ حَصينَةٌ","أِجادَ المُسَدّي سَردَها وَأَذالَها",2,"ل",3,0],["على أبركِ الأوقاتِ تسري لمقصدٍ","وترجع موفور العلى متزيدا",3,"د",2,0],["عَلى اِبنِ أَبي العاصي قُرَيشٌ تَعَطَّفَت","لَهُ صُلبُها لَيسَ الوَشائِظُ كَالصُلبِ",4,"ب",1,0],["على ابتكار معانيه له حسدوا","وكل مبتكر في الشعر محسود",5,"د",1,0],["عَلى أَبي جَعفَرَ ثارَت فتيَةٌ","ما أَنصَفوا وَاللَه في شَق العَصا",6,"ا",1,0],["عَلِيٌّ أَبو الزَهراءِ داهِيَةُ الوَغى","دَهاهُ بِبابِ الدارِ سَيفُ اِبنِ مُلجَمِ",7,"م",1,0],["عَلى اِبنِ المُغيرَةِ أَن يُقتَلا","وَإِن كانَ لِلبَيتِ مُستَقبَلا",8,"ل",2,1],["عَلى اِبنِكَ وَاِبنِ الأُمِّ إِذ أَدرَكَتهُما ال","مَنايا وَقَد أَفنَينَ عاداً وَتُبَّعا",9,"ع",2,0],["على أبن العصب الملح","ي يثني اليوم من أثنى",10,"ن",2,1],["عَلى أَبِي الطَيّبِ الكوفِيِّ مَفخَرُها","إِذ لَم أُضِع مِسكَها في مِثلِ كافورِ",11,"ر",1,0],["على أبي رافعٍ فَلْتَبْكِ مِن أسَفٍ","وَاسْتَبْقِ نفسَكَ إنْ كُنْتَ امرأً حذرا",12,"ر",2,0],["عَلى اِبنِ أَبي سودٍ تَفيضُ دُموعي","وَمَن لِمِراسِ الحَربِ بَعدَ وَكيعِ",13,"ع",1,1],["على ابن أبي العاصي دِلاصٌ حصينة","ٌ أجادَ المُسدّي سردَهَا وأذالَها",14,"ل",3,0],["على ابن كُتّاب بَليدٍ هَبْتِ","مذبذب بين الجهاتِ الستِ",15,"ت",1,0],["على ابن لبنانَ بنتُ الشامِ قد عَطَفت","فالشامُ تصبُو إلى لبنانَ مِعطارا",16,"ر",2,0],["عَلى اِبنِ عَبدِ اللَهِ تاجُ العُلا","خُلاصَةَ المَجدِ الصَدوقِ الأَمينِ",17,"ن",1,0],["عَلى اِبتِلائِكَ وَالعِصيانُ أَثقَلَهُ","فَعَدَلنَ عَلى الحالَتَينِ مائِلُهُ",18,"ه",1,0],["عُلْيا بني إسحاقَ فيه إذا انْتَمى","قد سانَدتْ عُلْيا بني شَيْبان",19,"ن",1,0],["على أبوابه الآمال منّا","قدْ ازدحمت لنا أيَّ ازدحام",20,"م",1,0],["على أبيك فلا تحزن أيا خلف","حسن العزا لك فيه أحسن الخلف",21,"ف",1,0],["عليّ أبو السبطين للناسِ غوثهُ","وَغيث إذا شحّت بوابِلها المزُن",22,"ن",1,0],["على ابنك عين اللّه من كل حاسد","وليس يبيج اللّه ما كان حاميا",23,"ي",2,0],["عَلى اِبن عُرسٍ دَخل الخفاشُ","فَاِهتَز بابن عرسٍ الفراشُ",24,"ش",1,0],["على ابن علي قصرت المديح","فما كل مقتصد يقصدُ",25,"د",1,0],["عليّ أبا الهيجاء تنحو لنحوهم","حروبا فلا زيد هناك ولا عمرو",26,"ر",2,0],["عَلى أَبي السبطين في صَدرة الوَغى","مُبيد العِدى لَيث الحُروب المَداحل",27,"ل",1,0],["على ابن سريج نقضنا الأمور","وقد كان أحكمها ما استطاعا",28,"ع",2,0],["عَلَى ابْنِ بِنْتِ الطَّاهِرِ المُصطَفَى","وابْنِ ابْنِ عَمّ المُصْطَفَى الفَاضِلِ",29,"ل",1,0],["على ابن بشارة المولى الذي قد","تجاوز في المعالي كل غايه",30,"ا",3,0],["علي ابن الملك الموفَّقِ","لولاه سوقُ أدب لم ينفق",31,"ق",1,0],["على أبي عثمان شيخي نافعِ","وكان فيه جد حبر بارعِ",31,"ع",1,0],["على ابنَي وائِلٍ لهُما مُهيناً","يردُّهُما على رُغْمِ السِّبالِ",32,"ل",1,0],["على أبوابه من كل وجهٍ","قصدتَ له أخو مرِّ بن أدِّ",33,"د",1,1],["على إبن دُوَيْلٍ بَهْلَة اللهِ كُلَّما","أهَلَّ حَجيجٌ مُحْرِمٌ بحراء",34,"ا",2,0],["على أبيه قَد بَكى سِنينا","لا زالَ فيه واجداً حَزينا",35,"ن",2,0],["على أبي ولعت ببذل دمعي","ونار الشوق من زند الولوع",36,"ع",1,0],["على أبناء لبنان المفدى","سلام الله يتلوه سلامي",37,"م",2,0],["عَلِيٍّ أبِي الأشرَافِ فِي أوَّلٍ وَفِي","أخِيرٍ وَبَيتِ العِلمِ يَنبُوعِ كَوثَرِ",38,"ر",1,0],["على ابن أتراس المليك الأمجد","أن ينفذ القوم بلا تردد",39,"د",1,0],["عَلى ابنٍ جاءَ مِن سَعدٍ وَحيداً","عَشيرة جودَةٍ نَبكي طَويلا",40,"ل",2,1],["عليٌّ أبوها والبتولة أمها","ومولدها من مكة بشعاب",41,"ب",1,0],["على ابن وحيد غريب الديار","بقلب كواه الجوى فانفطر",42,"ر",1,0],["على ابنه لله كم نعمة","عنوانها تشريف هذا الوليد",43,"د",1,0],["على ابن يوسف نجم المجد واسفا","أليس يؤسف فقد الماجد الخطر",44,"ر",1,0],["عَليا بِها خُصَّ الضَريحُ وَإِنَّما","نَعِمَ الغُوَيرُ بِأَبؤس الإِنجادِ",45,"د",1,0],["على أبوابه اسْمُكمُ مضيء","سيبقى بيننا أبداً (سعيدا)",46,"د",2,0],["على أبوابِ مدخلِها تَهاووا","على أرض الشهادة قد أبيدوا",47,"د",3,0],["عليّ ابن منصور تحية وامق","يلذ له في ذكرك النظم والنثر",48,"ر",1,0],["على ابن جعفر باتت عينه رصدا","في كل ليل وقامت حوله حرسا",49,"س",2,0],["علي أبي السبطين ، صدرة الوغى","مبيد العدى ليث الحروب المداحل",50,"ل",1,0],["على أبوابك احتشدت قلوب","وأرواح نمت فيها ذنوبُ",51,"ب",1,1],["علّي أبثُّ إلى الأغصانِ حُرقتنا","مِنْ عَبْرةٍ قدْ جَرَتْ بالكادِ نخفيها",52,"ي",3,0],["على أبنا ئها، وغدت حلالاً","لغاصبها فيوسعها انتقاما",53,"م",2,0],["عَلى اِبنِ عَبدِ المَلِكِ الزَيّاتِ","عَرَّضَ شَملَ المُلكِ لِلشَّتاتِ",54,"ت",1,0],["عَلَىٰ أبوابِ جِلَّقَ شَاخَ حُزنِي","ونَاحَ عَلَىٰ أَرَائِكِهَا اشتِيَاقِي",55,"ق",2,0],["على أبواب عفوك يا إلهي","وقفنا والسماحة منك جود",56,"د",1,0]]}