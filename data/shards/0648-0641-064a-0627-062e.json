{"poems":[[64,"ولما تراءى السرب قلت لصاحبي","https://www.aldiwan.net/poem52350.html","الطويل"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[136,"رضا بالقضا إن المقادير ترتضى","https://www.aldiwan.net/poem54810.html","الطويل"],[325,"اسمع مقال خبير","https://www.aldiwan.net/poem67170.html","المجتث"],[484,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91295","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72775","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76687","المتقارب"],[5648,"بيت سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=157234",""],[5974,"تمنيتك","https://www.poetsgate.com/ViewPoem.aspx?id=215952",""]],"verses":[["وفي أُخرياتِ السِّربِ حيث تعرَّضتْ","مَطُولٌ على فَضْلِ اليَسارِ منوعُ",0,"ع",1,0],["وفي أُخرياتِ الليل زار رِحالَنا","خيالٌ له أسآدُ سهرٍ وتأويبُ",1,"ب",1,0],["وَفي آخِرِ الأَيّامِ جاءَ مَسيحُنا","فَأَهدى بَني الدُنيا سَلامَ التَكامُلِ",2,"ل",1,0],["وفي إخوَةِ المُختَارِ مِن بَعدِهِ إِسًى","فَهُم غًُرَرُ النَّادِى ذوي الأَوجُهِ الوِضَا",3,"ض",2,0],["وَفي اِختِيارِ ذَويهِ","قَدِ أَشغَلَ الشَيبَ فودُهُ",4,"د",2,0],["وفي اختلاف الليالي ما يشير إلى","أن الزمان وما يحويه في سفر",5,"ر",1,0],["وفي اختلاف أمرهم فساد","وإن تمادى القتل فيهم بادوا",6,"د",3,0],["وَفِي أَخادِيدِ السِيَاط المُشَّنِ","شافٍ لِبَغْيِ الكَلِبِ المُشَيْطَنِ",7,"ن",1,0],["وفي اختلاف الليل والنهار","آيات حق لأولي الأبصار",8,"ر",1,0],["وفي اختلاس موضع التبطين","يُبسَطُ والختامُ باليمين",9,"ن",1,0],["وفي أخرى الركوع تقول خمساً","إذا انقضت القراءة ثم تترا",10,"ر",2,0],["وفي أخرِ الليل أوَّلَ النعشِ طالعاً","وأوَّلَ فرغ الشامِ للغربِ ساير",11,"ر",1,0],["وفي أخير الدبِّ يامهذَّباً","سرتقي أوَّلُ قَفزَاتِ الظّبَا",12,"ب",2,0],["وفي أخيرِ الليلِ زامٌ ثالثُ","يَسلُكهُمُ الرابِعُ ثمّ الثالثُ",12,"ث",1,0],["وفي أخير الدرِّ يا رفيقي","سَيَرتَقي الذُبَّانُ بالعيُّوقِ",12,"ق",1,0],["وفي أخيرِ الدرِّ يا رشيدَا","قِسِ المربَّع تَلقَهُ أَكيدَا",12,"د",2,0],["وَفِى اختِيَارٍ لاَ يَجِىءُ المُنفَصِل","إِذَا تَأتَّى أن يَجِىءَ المُتَّصِل",13,"ل",1,0],["وَفي اختيارك أَسبابَ العُلا مددٌ","لِما ترجّيهِ من تحسينِ مختتم",14,"م",1,0],["وفي آخر اشياخها حسدوا الفتى","لأن لم ينالوا سعيه فتبرموا",15,"م",3,0],["وفي أخيه الحاكمِ المرتجى","من ذروة العز رقى محتِدا",16,"د",2,0],["وفي أخويه لمن يرتجي","غياث وغيث لمن يطلب",17,"ب",1,0],["وفي اخر اللحظات يلقى له انسان","يكفي من الدنيا بكلمة شفاتي",18,"ت",2,0],["وفي آخر قصيدي لك دعوة بين وقفاتي","عسى ربي يديم السعد في قلبك وما ينزاح",19,"ح",1,0]]}