em/21480","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18083","الطويل"],[1153,"","https://poetry.dctabudhabi.ae/diwan/poem/116628","الطويل"]],"verses":[["فما مات حتى سن للجور سنة","تولى وعنها الدين شتى مذاهبه",0,"ب",2,0],["فَما مالُكَ المَدخورُ إِلا لِطالِبٍ","وَلا رَبعُكَ المَعمورُ إِلّا لِزائِرِ",1,"ر",1,0],["فَما مَسَحْتُ بِعُرْفِ الصُّبْحِ حافِرَهُ","وَلا فَلَيْتُ عَلَيْهِ لِمَّة الغَسَقِ",2,"ق",1,0],["فَما منْهُمُ مَنْ ضاقَ بالرّوْعِ ذرْعَهُ","ولا مَنْ تَعاصى في الشّدائِدِ صَبْرُهُ",3,"ر",2,0],["فَما مُخدِرٌ وَردٌ كَأَنَّ جَبينَهُ","يُطَلّى بِوَرسٍ أَو يُطانُ بِمُجسَدِ",4,"د",1,0],["فَما ميتَةٌ إِن مِتُّها غَيرَ عاجِزٍ","بِعارٍ إِذا ما غالَتِ النَفسِ غولُها",5,"ل",3,0],["فَما مِصرُ كَالسودانِ لُقمَةُ جائِعٍ","وَلَكِنَّها مَرهونَةٌ لِأَوانِ",6,"ن",1,0],["فَما مُطَوَّقَةٌ قَد نالَها شَرَكٌ","عِندَ الغُروبِ إِلَيهِ ساقَها القَدَرُ",7,"ر",1,0],["فَما مِنهُمُ إِلّا شَديدٌ نِزاعُهُ","إِلَيكَ مُقيمُ القَلبِ وَالجِسمُ راحِلُ",8,"ل",1,0],["فَما مُلكُ العِراقِ عَلى المُعَلّى","بِمُقتَدِرٍ وَلا مُلكُ الشَآمِ",9,"م",1,0],["فَما مَربَعٌ الجيرانِ إِلاّ جِفانُكُم","تُبارونَ أَنتُم وَالرِياحُ تَبارِيا",10,"ي",2,0],["فما مهّدَ الإسلام غير خليفة","على عطفه دُرُّ المحامد يُنظَمُ",11,"م",1,0],["فما منهم إلا أغرُّ مُحَجْلٌ","بورد المعالي في الشبيبة ناهلُ",12,"ل",1,0],["فما من سائدٍ أو من مَسودٍ","ولا من دائن يُربي الديونا",13,"ن",2,0],["فما ميز المحرم من جمادى","بفرق في البكاء ولا امتياز",14,"ز",1,0],["فَما مَنَعوا الثُغورَ كَما مَنَعنا","وَلا ذادوا الخَميسَ كَما نَذودُ",15,"د",1,0],["فَما مُخدِرٌ وَردٌ بِخَفّانَ زَأرُهُ","إِلى القِرنِ زَجرَ الزاجِرينَ تَوَرَّدا",16,"د",2,0],["فَما مَنَعتُم غَداةَ البِشرِ نِسوَتَكُم","وَلا صَبَرتُم لِقَيسٍ مِثلَ ما صَبَروا",17,"ر",3,0],["فَما ماتَ حَتّى لَم يُخَلِّف وَرائَهُ","بِحَيَّةِ وادٍ صَولَةٍ غَيرَ مُصعَقِ",18,"ق",1,0],["فَما مُغزِلٌ أَدماءُ تَحنو لِشادِنٍ","كَطَوقِ الفَتاةِ لَم تُشَدَّد مَفاصِلُه",19,"ل",2,0],["فَما مِنهُما إِلّا وَأَنّي أَكيلُهُ","بِمِثلٍ لَهُ مِثلَينِ أَو أَنا زائِدُ",20,"د",1,0],["فَما مَنَعَ العَيرُ الضَروطُ ذِمارَهُ","وَما مَنَعَت مَخزاةَ والِدِها هِندُ",21,"د",1,0],["فَما مِنكَ أَعجَبُ يا اِبنِ اِستِها","وَلَكِنَّني مِن أُلى أَعجَبُ",22,"ب",1,0],["فما مصرُ إلاَّ مثلُ جنَّة ساكنٍ","ندى رِزقهِ يأتي بغير حساب",23,"ب",1,0],["فما متاعك دنيا","إلا متاع الغرور",24,"ر",1,0],["فما منكما إلاَّ رئيسٌ وماجدٌ","فلا فرقَ بين الفرقدين ولا انْقضا",25,"ض",2,0],["فما مثلُها للمُلْك دار خلافة","أجَلْ لا ولا للطيب مرتاد رائدِ",26,"د",1,0],["فَما مَذهَبُ الإِنسانِ إِلّا زُجاجَةً","تُقَيِّدُهُ خَمراً وَتَضبُطُهُ خَلّا",27,"ل",2,0],["فَما مَساويها لِمَن","عَدَّدَها مُنتَهِيَه",28,"ي",2,0],["فَما مُغزِلٌ أَدماءُ ريعَت فَأَقبَلَت","بِسالِفَةٍ كَالسَيفِ سُلَّ مِنَ الغِمدِ",29,"د",1,0],["فَما ماؤُها إِلّا بُكاءً عَلَيهِمُ","يَفيضُ عَلى الأَكبادِ مِنهُ بُحورُ",30,"ر",1,0],["فَما مَرَّ لي بُخلٌ بِخاطِرِ مُهجَتي","وَلا مَرَّ بُخلُ الناسِ قَطُّ بِباليا",31,"ي",2,0],["فَما مُزنَةٌ بَينَ السِماكَينِ أَومَضَت","مِنَ النورِ ثُمَّ اِستَعرَضَتها جَنوبُها",32,"ب",3,0],["فَما مِثلُ كَفَّي خالِدٍ حينَ يَشتَري","بِكُلِّ طَريفٍ كُلَّ حَمدٍ وَتالِدِ",33,"د",1,0],["فَما مِن بَلاءٍ أَو وَفاءٍ سِوى الَّتي","فَعَلنا بِقَندابيلَ إِذ نَحنُ نَرتَقي",34,"ق",2,0],["فَما مِنكُمُ إِلّا وَفِيٌّ رِهانَهُ","بِأَلأَمِ مِن يَمشي وَمَن يَتَكَلَّمُ",35,"م",1,0],["فَما مِنهُمُ إِلّا يُقادُ بِأَنفِهِ","إِلى مَلِكٍ مِن خِندِفٍ بِالخَزائِمِ",36,"م",1,0],["فَما مِن مَعَدِّيٍّ كِفاءً تَعُدُّهُ","لَنا غَيرَ بَيتَي عَبدِ شَمسٍ وَهاشِمِ",37,"م",1,0],["فَما مُخدِرٌ وَردٌ عَلَيهِ مَهابَةٌ","يَصيدُ الرِجالَ كُلَّ يَومٍ يُنازِلُ",38,"ل",1,0],["فَما مُوِّتَ الأَحياءُ إِلّا لِيُبعَثوا","وَإِلّا لِتُجزى كُلُّ نَفسٍ بِما سَعَت",39,"ت",1,0],["فَما مُزنُكَ المُرتَجى بِالجَهامِ","وَلا ريحُنا مِنكَ بِالجِربِياءِ",40,"ا",2,0],["فَما مِن نَدىً إِلّا إِلَيكَ مَحَلُّهُ","وَلا رُفقَةٌ إِلّا إِلَيكَ تَسيرُ",41,"ر",1,0],["فَما مَضَت ساعَةٌ وَالحَربُ مُسعَرَةٌ","حَتّى غَدا جَمعُهُم نَهباً لِمُقتَسِمِ",42,"م",1,0],["فَما مِن مُحِبٍّ يَستَزيدُ حَبيبَهُ","يُعاتِبُهُ في الوَدِّ إِلّا تَفَرَّقا",43,"ق",2,0],["فَما مِن مُغزِلٌ أَدما","ءُ تُزجي شادِناً خَرِقا",44,"ق",2,0],["فَما مَسَّ جَنبي الأَرضَ حَتّى ذَكَرتُها","وَإِلّا وَجَدتُ ريحَها في ثِيابِيا",45,"ي",2,0],["فَما مُغزِلٌ أَدماءُ باتَ عَزالُها","بِأَسفَلِ نِهيٍ ذي عَرارٍ وَحَلَّبِ",46,"ب",1,0],["فما ملكوا لِعصمتَ من قِيادٍ","ولا مَلكَ الدُّهاةُ تشتشرينا",47,"ن",2,0],["فَما مَلَكَ الفَرشُ الوَثيرُ جُنوبَكُم","وَلا راعَكُم عَيشٌ لَذيذُ الجَنى رَغدُ",48,"د",1,0],["فما مثلهم فيمن هَدَى اللَّهُ وارِدٌ","ولا مثله فيمن شَفى الدّاءَ نَاصِحُ",49,"ح",1,0],["فما مِثلُه في مَشهدِ الإفكِ فارحٌ","ولا مِثلهُ في مَشهدِ الحقِّ آسفُ",50,"ف",1,0],["فَما مَلَكتُ بِأَن كانَت نُفوسُكُمُ","كَفارِكٍ كَرِهَت ثَوبي وَإِلباسي",51,"س",2,0],["فَما مُغزِلٌ بِأَقاصي البِلادِ","تَفزَعُ مِن خَوفِ كَلّابِها",52,"ب",3,0],["فمَا مِنْ بَلْدَةِ إلاَّ ومنهمُ","عليها كلُّ شَيْطانٍ رَجِيمِ",53,"م",1,0],["فما مثلُ يحيَى من أخٍ لك تابِعٍ","ولا كبَنِيهِ من جَحاجِحَةٍ زُهر",54,"ر",1,0],["فَما مَضَت بَعدَ ذاكَ ثالِثَةٌ","حَتّى أَتاني الحَبيبُ يَعتَذِرُ",55,"ر",1,0],["فما من كان بينكما بنكس","لعمرك في الخطوب ولا بكاب",56,"ب",1,0],["فمامسّ جنبي الأرض حتى رأيته","على أهل آجام ونخل مكمم",57,"م",1,0],["فما مقال الجاهل المفند","تأسس الإسلام بالمهند",58,"د",1,0],["فما مضى في موطن أو همّا","إلا وكان اسما على مسمّى",59,"م",2,0],["فَمَا مَضَتْ سَاعَةٌ أَوْ بَعْضُ ثَانِيَةٍ","إِلا وَلِلصَّيْدِ فِي سَاحَاتِنَا نُزُلُ",60,"ل",1,0],["فَمَا مُهْجَةٌ إِلَّا وَرُمْحِي ضَمِيرُهَا","ولا لَبَّةٌ إِلَّا وَسَيْفِي لَهَا عِقْدُ",61,"د",1,0],["فَمَا مِنْ بِنَاءٍ كَانَ أَوْ هُوَ كَائِنٌ","يُدَانِيهِمَا عِنْدَ التَأَمُّلِ وَالْخُبْرِ",62,"ر",1,0],["فَمَا مَدَدْتُ يَدِي إِلَّا لِمَنْحِ يَدٍ","ولا سَعَتْ قَدَمي إِلَّا لإِسْعَادِ",63,"د",1,0],["فَما مِثْلهُ بَيْنَ الأُبُوَّةِ مِنْ أَبٍ","وَمَا مِثْلُهُ بَيْن البُعُولَةِ مِنْ بَعْلِ",64,"ل",1,0],["فَمَا مِنْ رَاحَةٍ أَشْفَى","وَمَا مِنْ رَاحَةٍ أَنْدَى",65,"د",2,0],["فَمَا مِنْ دَارِ عِلْمٍ لَمْ تَحِدْهُ","سِحَابَاً كَاثَرَ القَطْرَ الصَّبِيبا",66,"ب",2,0],["فما مغزل أدماء بات غزالها","بِأسْفَل نِهْيٍ ذي عَرَارٍ وَحلَّبِ",67,"ب",1,0],["فما ماتَ من في الزمانِ ..","أَحَبَّ .. ولا ماتَ من غّ