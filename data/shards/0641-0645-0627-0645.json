دي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[441,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[441,"تروح المنايا في البرايا وتغتدي","https://www.aldiwan.net/poem14444.html","الطويل"],[441,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[441,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[458,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[458,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[458,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[458,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[461,"بقيت وشمس الدين للمجد والعلى","https://www.aldiwan.net/poem15404.html","الطويل"],[464,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[464,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[466,"ألا يا صبا نجد لقد هجت من نجد","https://www.aldiwan.net/poem50438.html","الطويل"],[468,"تمتعت من شعرك الباهر","https://www.aldiwan.net/poem60131.html","المتقارب"],[470,"وما زال من قلبي لسودة ناصر","https://www.aldiwan.net/poem4847.html","الطويل"],[529,"ولي سلف فوق المجرة خيموا","https://www.aldiwan.net/poem37515.html","الطويل"],[538,"عليك من الخل الوفي سلامه","https://www.aldiwan.net/poem47939.html","عموديه"],[551,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[551,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[553,"وقفتك لم أمدحك لا لمذمة","https://www.aldiwan.net/poem68390.html","الطويل"],[575,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"]],"verses":[["فَما مالُكَ المَدخورُ إِلا لِطالِبٍ","وَلا رَبعُكَ المَعمورُ إِلّا لِزائِرِ",0,"ر",1,0],["فَما مَسَحْتُ بِعُرْفِ الصُّبْحِ حافِرَهُ","وَلا فَلَيْتُ عَلَيْهِ لِمَّة الغَسَقِ",1,"ق",1,0],["فَما منْهُمُ مَنْ ضاقَ بالرّوْعِ ذرْعَهُ","ولا مَنْ تَعاصى في الشّدائِدِ صَبْرُهُ",2,"ر",2,0],["فَما مُخدِرٌ وَردٌ كَأَنَّ جَبينَهُ","يُطَلّى بِوَرسٍ أَو يُطانُ بِمُجسَدِ",3,"د",1,0],["فَما ميتَةٌ إِن مِتُّها غَيرَ عاجِزٍ","بِعارٍ إِذا ما غالَتِ النَفسِ غولُها",4,"ل",3,0],["فَما مِصرُ كَالسودانِ لُقمَةُ جائِعٍ","وَلَكِنَّها مَرهونَةٌ لِأَوانِ",5,"ن",1,0],["فَما مُطَوَّقَةٌ قَد نالَها شَرَكٌ","عِندَ الغُروبِ إِلَيهِ ساقَها القَدَرُ",6,"ر",1,0],["فَما مِنهُمُ إِلّا شَديدٌ نِزاعُهُ","إِلَيكَ مُقيمُ القَلبِ وَالجِسمُ راحِلُ",7,"ل",1,0],["فَما مُلكُ العِراقِ عَلى المُعَلّى","بِمُقتَدِرٍ وَلا مُلكُ الشَآمِ",8,"م",1,0],["فَما مَربَعٌ الجيرانِ إِلاّ جِفانُكُم","تُبارونَ أَنتُم وَالرِياحُ تَبارِيا",9,"ي",2,0],["فما مهّدَ الإسلام غير خليفة","على عطفه دُرُّ المحامد يُنظَمُ",10,"م",1,0],["فما منهم إلا أغرُّ مُحَجْلٌ","بورد المعالي في الشبيبة ناهلُ",11,"ل",1,0],["فما من سائدٍ أو من مَسودٍ","ولا من دائن يُربي الديونا",12,"ن",2,0],["فما ميز المحرم من جمادى","بفرق في البكاء ولا امتياز",13,"ز",1,0],["فَما مَنَعوا الثُغورَ كَما مَنَعنا","وَلا ذادوا الخَميسَ كَما نَذودُ",14,"د",1,0],["فَما مُخدِرٌ وَردٌ بِخَفّانَ زَأرُهُ","إِلى القِرنِ زَجرَ الزاجِرينَ تَوَرَّدا",15,"د",2,0],["فَما مَنَعتُم غَداةَ البِشرِ نِسوَتَكُم","وَلا صَبَرتُم لِقَيسٍ مِثلَ ما صَبَروا",16,"ر",3,0],["فَما ماتَ حَتّى لَم يُخَلِّف وَرائَهُ","بِحَيَّةِ وادٍ صَولَةٍ غَيرَ مُصعَقِ",17,"ق",1,0],["فَما مُغزِلٌ أَدماءُ تَحنو لِشادِنٍ","كَطَوقِ الفَتاةِ لَم تُشَدَّد مَفاصِلُه",18,"ل",2,0],["فَما مِنهُما إِلّا وَأَنّي أَكيلُهُ","بِمِثلٍ لَهُ مِثلَينِ أَو أَنا زائِدُ",19,"د",1,0],["فَما مَنَعَ العَيرُ الضَروطُ ذِمارَهُ","وَما مَنَعَت مَخزاةَ والِدِها هِندُ",20,"د",1,0],["فَما مِنكَ أَعجَبُ يا اِبنِ اِستِها","وَلَكِنَّني مِن أُلى أَعجَبُ",21,"ب",1,0],["فما مصرُ إلاَّ مثلُ جنَّة ساكنٍ","ندى رِزقهِ يأتي بغير حساب",22,"ب",1,0],["فما متاعك دنيا","إلا متاع الغرور",23,"ر",1,0],["فما منكما إلاَّ رئيسٌ وماجدٌ","فلا فرقَ بين الفرقدين ولا انْقضا",24,"ض",2,0],["فما مثلُها للمُلْك دار خلافة","أجَلْ لا ولا للطيب مرتاد رائدِ",25,"د",1,0],["فَما مَذهَبُ الإِنسانِ إِلّا زُجاجَةً","تُقَيِّدُهُ خَمراً وَتَضبُطُهُ خَلّا",26,"ل",2,0],["فَما مَساويها لِمَن","عَدَّدَها مُنتَهِيَه",27,"ي",2,0],["فَما مُغزِلٌ أَدماءُ ريعَت فَأَقبَلَت","بِسالِفَةٍ كَالسَيفِ سُلَّ مِنَ الغِمدِ",28,"د",1,0],["فَما ماؤُها إِلّا بُكاءً عَلَيهِمُ","يَفيضُ عَلى الأَكبادِ مِنهُ بُحورُ",29,"ر",1,0],["فَما مَرَّ لي بُخلٌ بِخاطِرِ مُهجَتي","وَلا مَرَّ بُخلُ الناسِ قَطُّ بِباليا",30,"ي",2,0],["فَما مُزنَةٌ بَينَ السِماكَينِ أَومَضَت","مِنَ النورِ ثُمَّ اِستَعرَضَتها جَنوبُها",31,"ب",3,0],["فَما مِثلُ كَفَّي خالِدٍ حينَ يَشتَري","بِكُلِّ طَريفٍ كُلَّ حَمدٍ وَتالِدِ",32,"د",1,0],["فَما مِن بَلاءٍ أَو وَفاءٍ سِوى الَّتي","فَعَلنا بِقَندابيلَ إِذ نَحنُ نَرتَقي",33,"ق",2,0],["فَما مِنكُمُ إِلّا وَفِيٌّ رِهانَهُ","بِأَلأَمِ مِن يَمشي وَمَن يَتَكَلَّمُ",34,"م",1,0],["فَما مِنهُمُ إِلّا يُقادُ بِأَنفِهِ","إِلى مَلِكٍ مِن خِندِفٍ بِالخَزائِمِ",35,"م",1,0],["فَما مِن مَعَدِّيٍّ كِفاءً تَعُدُّهُ","لَنا غَيرَ بَيتَي عَبدِ شَمسٍ وَهاشِمِ",36,"م",1,0],["فَما مُخدِرٌ وَردٌ عَلَيهِ مَهابَةٌ","يَصيدُ الرِجالَ كُلَّ يَومٍ يُنازِلُ",37,"ل",1,0],["فَما مُوِّتَ الأَحياءُ إِلّا لِيُبعَثوا","وَإِلّا لِتُجزى كُلُّ نَفسٍ بِما سَعَت",38,"ت",1,0],["فَما مُزنُكَ المُرتَجى بِالجَهامِ","وَلا ريحُنا مِنكَ بِالجِربِياءِ",39,"ا",2,0],["فَما مِن نَدىً إِلّا إِلَيكَ مَحَلُّهُ","وَلا رُفقَةٌ إِلّا إِلَيكَ تَسيرُ",40,"ر",1,0],["فَما مَضَت ساعَةٌ وَالحَربُ مُسعَرَةٌ","حَتّى غَدا جَمعُهُم نَهباً لِمُقتَسِمِ",41,"م",1,0],["فَما مِن مُحِبٍّ يَستَزيدُ حَبيبَهُ","يُعاتِبُهُ في الوَدِّ إِلّا تَفَرَّقا",42,"ق",2,0],["فَما مِن مُغزِلٌ أَدما","ءُ تُزجي شادِناً خَرِقا",43,"ق",2,0],["فَما مَسَّ جَنبي الأَرضَ حَتّى ذَكَرتُها","وَإِلّا وَجَدتُ ريحَها في ثِيابِيا",44,"ي",2,0],["فَما مُغزِلٌ أَدماءُ باتَ عَزالُها","بِأَسفَلِ نِهيٍ ذي عَرارٍ وَحَلَّبِ",45,"ب",1,0],["فما ملكوا لِعصمتَ من قِيادٍ","ولا مَلكَ الدُّهاةُ تشتشرينا",46,"ن",2,0],["فَما مَلَكَ الفَرشُ الوَثيرُ جُنوبَكُم","وَلا راعَكُم عَيشٌ لَذيذُ الجَنى رَغدُ",47,"د",1,0],["فما مثلهم فيمن هَدَى اللَّهُ وارِدٌ","ولا مثله فيمن شَفى الدّاءَ نَاصِحُ",48,"ح",1,0],["فما مِثلُه في مَشهدِ الإفكِ فارحٌ","ولا مِثلهُ في مَشهدِ الحقِّ آسفُ",49,"ف",1,0],["فَما مَلَكتُ بِأَن كانَت نُفوسُكُمُ","كَفارِكٍ كَرِهَت ثَوبي وَإِلباسي",50,"ي",1,0],["فَما مُغزِلٌ بِأَقاصي البِلادِ","تَفزَعُ مِن خَوفِ كَلّابِها",51,"ب",3,0],["فمَا مِنْ بَلْدَةِ إلاَّ ومنهمُ","عليها كلُّ شَيْطانٍ رَجِيمِ",52,"م",1,0],["فما مثلُ يحيَى من أخٍ لك تابِعٍ","ولا كبَنِيهِ من جَحاجِحَةٍ زُهر",53,"ر",1,0],["فَما مَضَت بَعدَ ذاكَ ثالِثَةٌ","حَتّى أَتاني الحَبيبُ يَعتَذِرُ",54,"ر",1,0],["فما مقال الجاهل المفند","تأسس الإسلام بالمهند",55,"د",1,0],["فما مضى في موطن أو همّا","إلا وكان اسما على مسمّى",56,"م",2,0],["فَمَا مَضَتْ سَاعَةٌ أَوْ بَعْضُ ثَانِيَةٍ","إِلا وَلِلصَّيْدِ فِي سَاحَاتِنَا نُزُلُ",57,"ل",1,0],["فَمَا مُهْجَةٌ إِلَّا وَرُمْحِي ضَمِيرُهَا","ولا لَبَّةٌ إِلَّا وَسَيْفِي لَهَا عِقْدُ",58,"د",1,0],["فَمَا مِنْ بِنَاءٍ كَانَ أَوْ هُوَ كَائِنٌ","يُدَانِيهِمَا عِنْدَ التَأَمُّلِ وَالْخُبْرِ",59,"ر",1,0],["فَمَا مَدَدْتُ يَدِي إِلَّا لِمَنْحِ يَدٍ","ولا سَعَتْ قَدَمي إِلَّا لإِسْعَادِ",60,"د",1,0],["فَما مِثْلهُ بَيْنَ الأُبُوَّةِ مِنْ أَبٍ","وَمَا مِثْلُهُ بَيْن البُعُولَةِ مِنْ بَعْلِ",61,"ل",1,0],["فَمَا مِنْ رَاحَةٍ أَشْفَى","وَمَا مِنْ رَاحَةٍ أَنْدَى",62,"د",2,0],["فَمَا مِنْ دَارِ عِلْمٍ لَمْ تَحِدْهُ","سِحَابَاً كَاثَرَ القَطْرَ الصَّبِيبا",63,"ب",2,0],["فما مغزل أدماء بات غزالها","بِأسْفَل نِهْيٍ ذي عَرَارٍ وَحلَّبِ",64,"ب",1,0],["فما ماتَ من في الزمانِ ..","أَحَبَّ .. ولا ماتَ من غّرَّدا",65,"ا",1,0],["فما مصعدٌ في شاهقات من الذرى","بأكثر مني وحشةً وهو معنق",66,"ق",1,0],["فَمَا مُدجِنٌ مِن هُمَّعِ الجُونِ","غُزَّرٌ ولاَ لُجَّةٌ يوماً مِنَ اليَمِّ تَدفَقُ",67,"ق",1,0],["فَما مِسكٌ يُعَلُّ بِزَنجَبيلٍ","وَلا عَسَلٌ بِأَلبانِ اللِقاحِ",68,"ح",1,1],["فَما مَلَكُ الأَملاكِ وَالعَصرِ راضِياً","وَإِن غابَ عَمّا قَد جَنَيتَ فَما غابا",69,"ب",2,0],["فَما مَنَعوا الوَدائِعَ مودِعيها","لِضَربٍ مِن ضُروبِ الإِعتِلالِ",70,"ل",1,0],["فَما مِنّي إِلى لَومٍ جُنوحٌ","وَلا عِندي لِتَعنيفٍ قَبولُ",71,"ل",1,0],["فَما مِن عالَمِ الغَبراءِ عادٍ","وَلا في الجَمَّةِ الخَضراءِ جانِ",72,"ن",1,0],["