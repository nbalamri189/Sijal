,"ض",2,0],["فما منعت عنها حصون منيعة","ولا كشفتْ من فادح الخطب ما عرا",118,"ر",2,0],["فما مرَّ الخيال إذنْ بطرفي","ولَمْ أذُقِ الكرى إلاَّ غرارا",119,"ر",2,0],["فما مالت إلى الفحشاء نفسٌ","ولا ركنت إلى حسناء رود",120,"د",1,0],["فما من منصب اشرقت الا","بنور الفضل قد نورت ربعه",121,"ع",2,0],["فما منهم سوى جوّاد بذل","وطعان إذا ما الحرب ثارت",122,"ت",1,1],["فما منعت عن عاشق رشف ظلمها","ولم يرتشف إلى الجسور رضابها",123,"ب",3,0],["فما منهم ترى أبدا كريماً","سوى لحز ولص أو بيوق",124,"ق",1,0],["فما منقذي منها سواك فإنني","بك اللَه لاجٍ بل لعفوك مستجد",125,"د",1,0],["فما من برزخٍ إلا كساه","وما من تلعةٍ إلا علاها",126,"ا",3,0],["فما مزيد عنه تدافع يومه","وليس لنا في دفعنا اليوم من يد",127,"د",1,0],["فما مر يوم من هموم مقدس","ولا ليلة مرت ولا الحزن ممعك",128,"ك",1,0],["فما مقلة شحت عليه بدمعها","ولا عاش قلب للأسى غير لازم",129,"م",1,0],["فما مات من كان المليك محمد","خليفته بالغيث نتج الغمائم",129,"م",1,0],["فما منّي ومن أضغا","ثِ داركُمُ سوى الدِّمنِ",130,"ن",1,0],["فما مات من عاشا لسدّ مكانِهِ","ولا حضرا وموضعٌ منك بالخالي",131,"ل",2,0],["فما مجَّت له أُذُنٌ سؤالاً","ولا سمحتْ له شَفَةٌ بردِّ",132,"د",1,0],["فما مُقلةٌ إلا وأنتَ سوادُها","ولا كبِدٌ إلا وأنت لها خِلبُ",133,"ب",1,0],["فما مات منْ أبقاكما ونماكُما","تغمَّدهُ عفوٌ من اللهِ واسعُ",134,"ع",1,0],["فما منهم في المحل إلاّ جوادها","وما منهم في الحرب إلاّ همامها",135,"م",3,0],["فما مثلهُ في كلِّ مجدٍ وسؤودٍ","ولا مثلُ عادي يومهِ في المصائب",136,"ب",1,0],["فَما مَلَكَت عَينايَ حينَ ذَكَرتُها","دُموعَهُما حَتّى اِنحَدَرنَ عَلى خَدّي",137,"د",2,0],["فَما مِثلُ سابِقِهِ إِذ جَرى","يُؤَمِّلُ إِدراكَهُ خاطِري",138,"ر",2,0],["فَما مُزنَةٌ بَحرِيَّةٌ لاحَ بَرقُها","تَهَلَّلَ فِي غمٍّ لَهُن صَبيرُ",139,"ر",1,0],["فَما مِنْهُمُ في قَوْمِهِ غَيْرُ سيِّدٍ","يَرُوحُ ويَغْدُو وَهْوَ بالمَجْدِ مُحْتَبِي",140,"ب",2,0],["فما مُتعَةٌ مثلُ الوَفا لذَوي الوَفا","ولا سيما مَن بِالمعالي غًرامُهُ",141,"م",2,0],["فَما مَشوا فيه إلّا تُبَّعاً أثري","ولا جنوا غيرَ أشجاري ومغروسي",142,"س",2,0],["فما ماءُ مُزْنٍ بات جَفْنَ سحابةٍ","يصوبُ على أعلى الصّخور ويسفحُ",143,"ح",1,1],["فَما مِن يَدٍ قَدَّمتَها قُلتُ مُثنِياً","عَلَيكَ وَلَكِنّي هَزَزتُكَ لِلمَجدِ",144,"د",1,0],["فما مررت بِرَبْعٍ كان رَبْعَكُمُ","إِلاَّ ظننتُ صَدَاهُ أَنَّه الشاكِي",145,"ك",2,0],["فَما مِنكُم إِلا رأَيناهُ دانِياً","إِلَينا بِحمدِ اللَّهِ في العَينِ مُسلِما",146,"م",2,0],["فَما مَسَّ جِلدي الأَرضَ إِلّا ذَكَرتُها","وَإِلّا وَجَدتُ طيبَها في ثِيابِيا",147,"ي",2,0],["فَمَا مُعولٌ تَبكِي لِفَقدِ أَلِيفِهَا","إِذَا ذَكَرَتهُ لاَ يَكُفُّ زَفِيرُهضا",148,"ض",2,0]]}