{"poems":[[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[93,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[51,"إن الزمان يغرني بأمانه","https://www.aldiwan.net/poem63165.html","الكامل"],[71,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"عميانكم قرأت على أجداثكم","https://www.aldiwan.net/poem23326.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[164,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[280,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[342,"طال الثواء على رسم بيمئود","https://www.aldiwan.net/poem45432.html","البسيط"],[543,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86796","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86740","الكامل"],[834,"","https://poetry.dctabudhabi.ae/diwan/poem/130359","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70831","المجتث"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121099","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112743","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109172","الكامل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44836","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141335","الكامل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45416","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87473","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129470","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109985","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92424","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92080","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133298","الكامل"],[4169,"","https://poetry.dctabudhabi.ae/diwan/poem/116600","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28688","الرجز"],[4691,"تعويذة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=61409",""],[4767,"نعي الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=89357",""],[5150,"مذكرة دفاع ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=202916",""],[5187,"حكايتي مع الناس","https://www.poetsgate.com/ViewPoem.aspx?id=33008",""],[5324,"إلىى تلميذة..","https://www.poetsgate.com/ViewPoem.aspx?id=215864",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["إِنَّ الضَغينَةَ تَلقاها وَإِن قَدُمَت","كَالعَرِّ يَكمُنُ حيناً ثُمَّ يَنتَشِرُ",0,"ر",1,0],["إِنَّ الضَعيفَ بِحاجَةٍ لِنُضارِكُم","لا تَقعُدوا عَن نُصرَةِ الضُعَفاءِ",1,"ا",2,0],["إِنَّ الضَديقَ يَلِجُّ في غِشيانِهِ","لِصَديقِهِ فَيَمَلُّ مِن غِشيانِهِ",2,"ن",2,0],["إنَّ الضياعَ ضياعٌ للزمانِ وَمَنْ","يلِ المناصبَ لا ينفكَ ذا نَصَبِ",3,"ب",1,0],["إنَّ الضَّنِينَ بِنَفسِهِ فِي الأرضِ لا","يَلْوِي عَلَى أَحَدٍ وليسَ بمُصعِدِ",4,"د",1,0],["إِنَّ الضَلالَةَ كَالغَريزَةِ فيكُمُ","يَأوي إِلَيها كَهلُكُم وَفَتاكُمُ",5,"م",1,0],["إِنَّ الضِّعَافَ أَمَانَاتٌ يُوَكِّلُنَا","بِهَا القَضَاءُ ومَنْ يَرْأَفُ بِهِمْ يَثِبِ",6,"ب",1,0],["إن الضلالة لا تجرُّ إِلى هدى","والغيُّ لا يجدي عليك رشادا",7,"د",2,0],["إن الضّحايا في هواكِ كثيرةٌ","فَتَذكّري ما كانَ في اليَرموك",8,"ك",1,0],["إنَّ الضَّراعَةَ لِلْقَبولِ ذَريعَةٌ","والحَقُّ في تَخْلِيدِ أمْرك ضارِعُ",9,"ع",1,0],["إِنَّ الضِرابَ بِبيضِ الهِندِ عادَتُنا","وَلا نُعَوَّدُ ضَرباً بِالجَلاميدِ",10,"د",1,0],["إنَّ الضميرَ عِقابُه في حينِه","إنَّ الضميرَ ذُنوبُه لن تُغفَرا",11,"ر",2,0],["إنّ الضّباع متى تُحسَّ بنبأةٍ","من صوت أشوسَ تَقشعرَّ وتَهربِ",12,"ب",1,0],["إِن الضَلال هُوَ الهِداية في هَوى","هَيفاء فاترة الجُفون وَأَمرَد",13,"د",1,0],["إِن الضَلال هَو الهِداية في الهَوى","بِجَمال ذات تَدلُّلٍ أَو أَمرَد",14,"د",1,0],["إنَّ الضَّبِيْحَ طحا بِمَتْنَيْهِ","الأياصِرُ والنَّصِيْ",15,"ي",1,0],["إن الضعيفَ ضعيفُ الص","صواب والعقلِ والمالْ",16,"ل",1,1],["إنَ الضبَابَ كثيفٌ","فأيّ يَومَيِّكَ أكْثفْ",17,"ف",1,0],["إن الضمائر تأبى أن يكون لها","نعت فقلبي لم تنعت ضمائره",18,"ر",2,0],["أن الضنا قد مسنا فارحمنا","وبالمراضي ربنا فاغمرنا",19,"ن",2,0],["إن الضلال والهوى والأثَره","وكلّ شرّ قد محوتَ أثَرَه",20,"ه",1,0],["إن الضمير أجلُّ محكمة غدت","تقضي لنا بالعدل في الأغراض",21,"ض",1,0],["إنَّ الضّفادِع في السّباخِ إذا ادّعَت","شَدوَ المطوّقَة استبانَ ضلالُها",22,"ل",3,0],["إنّ الضّعيف بكلّ ناحيةٍ","يحيا ذليل النّفس مبتذلا",23,"ل",2,0],["إِنّا لَضَرّابونَ في حَمَسِ الوَغا","رَأسَ المُتَوَّجِ إِن أَرادَ صَدودا",24,"د",2,0],["إنَّ الضعيفَ اذا تَناهى ضعفهُ","حارَت لديهِ قُوى القويِّ جميعُها",25,"ع",3,1],["ان الضرورة تعدو من تلم به","ان يجعل السر خوف الضر إعلانا",26,"ن",2,0],["ان الضعيفَ لَيَقتاتُ البُقولَ بَلِ ال","قويُّ ياكل كلاً غيرَ معترضِ",27,"ض",1,0],["إن الضعيفين إن جمّعت بينَهما","قاما بأمر له تعيا الأشداءُ",28,"ا",2,1],["إنَّ الضعيفين إن جمّعت بينهما","قاموا بأمر له تعيى الأشداءُ",29,"ا",2,0],["إن الضياء يُري العيون ولا يَرى","والحسن يوقظ وهو غافٍ سادر",30,"ر",1,0],["إن الضمير هو الدليل ولم يكن","يأتي الزمان لوحيه بخلاف",31,"ف",1,0],["إن الضياء بها تجسم شخصه","أما الخشوع فلا نزاع ولا جدل",32,"ل",1,0],["إن الضراطَ به تعاظَمَ جَدكُم","فتعاظَمُوا ضَرِطاً بني القَعقاعِ",33,"ع",1,1],["إن الضلالَ بأهواءٍ لها فِرَقُ","وفي الحديثِ أتى ذمٌّ لِمنتحلِ",34,"ل",1,0],["إِنَّ الضَّنى في جَسَدي","يُخبِرُني عَن جَسدِه",35,"د",2,0],["إنَّ الضياءَ لَيَعرى إن نغب ْ صُبُحا","لأننا لطيوفِ الضوء ملبوسُ",36,"س",1,0],["إن الضياء خبت مشاعله","والليل ساد وستره انسدلا",37,"ل",2,0],["إن الضميرَ يحثُّكمْ أن تُصدِروا","حُكماً يُشرِّفُ عدلَكُم شرَفَ القلمْ",38,"م",1,0],["إن الضلالةَ أن أُغيّرَ منهجي","وأضيعَ بين تخاذلي وتفاهتي",39,"ت",2,0],["إنّ الضمير إذا استقال تحدّرت","نحو الحضيض طبائعُ الانسانِ .",40,"ن",1,0],["إن الضمائر قد تخون وربما","تزع الكريم عن الخنا ببكائها",41,"ا",3,0],["إنّ الضياع المرّ في أن تحسبي","شيئاً محالاً.. وهْو غير محالِ",42,"ل",1,0]]}