{"poems":[[55,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[79,"قحطنا ثم صاب الغيث رحمى","https://www.aldiwan.net/poem36686.html","الوافر"],[88,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[95,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[92,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[79,"قحطْنا ثم صاب الغيْثُ رُحْمى","https://www.poetsgate.com/ViewPoem.aspx?id=33380",""],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[92,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[186,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[203,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[264,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[266,"أشاقك من هذا الرديني قده","https://www.aldiwan.net/poem38143.html","الطويل"],[266,"اغمد شبا مرهفك الباتر","https://www.aldiwan.net/poem38276.html","السريع"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[276,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[285,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[287,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[398,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[408,"يا طلعة البدر وقد القضيب","https://www.aldiwan.net/poem46715.html","السريع"],[438,"يا جاعل النيل صبغ جلدته","https://www.aldiwan.net/poem12411.html","المنسرح"],[445,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[447,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[505,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[591,"يا فاضح البدر حسنا","https://www.aldiwan.net/poem17439.html","المجتث"],[591,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53734","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122649","الهزج"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63900","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37756","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59432","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133868","المجتث"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136184","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64526","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64563","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79817","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100957","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77344","الطويل"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114950","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76027","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76012","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100493","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74172","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121405","المتقارب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112693","الوافر"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71307","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48453","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48337","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108329",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91537","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85126","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86514","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114434","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135909","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135908","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135772","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135732","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40092","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101362","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94771","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136503",""],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138821",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57957","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33652","المتقارب"],[4755,"المعنى في وجه الشاعر..","https://www.poetsgate.com/ViewPoem.aspx?id=190897",""],[5277,"خيولٌ اًصائل","https://www.poetsgate.com/ViewPoem.aspx?id=213706",""],[308,"تنوح حمامات اللوى فَأُجِيب","https://www.poetsgate.com/ViewPoem.aspx?id=189362",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[5848,"ما أشجعك","https://www.poetsgate.com/ViewPoem.aspx?id=50624",""],[1395,"على منزل كان الحبيب به قل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605517",""]],"verses":[["وَيا غَريمي بِعَقيقِ الحِمى","حَصَلتُ مِن حَقّي عَلى الباطِلِ",0,"ل",1,0],["ويَا غَيْثَ الرِّضى عنّا انْسِكاباً","فأنْتَ علَى الخَبيرِ بهِ سَقَطْتا",1,"ت",2,0],["وَيا غَربُ إِنَّ الدَهرَ يَطفو بِأَهلِهِ","وَيَطويهِ تَيّارُ القَضاءِ فَيَرسُبُ",2,"ب",1,0],["وَيَا غَابَاتِ لُبْنَانَ المُفَدَّى","مِنَ الدَّوْحِ المُجَدَّدِ وَالْقُدَامِ",3,"م",1,0],["وَيا غَليومُ أَينَ لَكَ الفِرارُ","إِذا جورجي وَعَسكَرَهُ أَغاروا",4,"ا",1,0],["وَيا غَوادي عَبرَتي تَحَدَّري","وَيا بَوادي زَفرَتي تَصَعَّدي",5,"د",2,0],["ويا غُصْنَ \"هاشِمَ\" لم يَنْفَتِحْ","بأزْهَرَ منكَ ولم يُفْرِعِ",6,"ع",1,0],["ويا غِياثَ الرِّضا عنّا انْسِكابا","فأنت على الخبير به سقَطتّا",7,"ت",2,0],["ويا غُرَّ السجايا لم يَمُنُوا","بما لَطُفوا عليَّ ولم يُحابوا",8,"ب",3,0],["ويا غاضبا قلبي لترقيق حره","سراحاً فقد دارت عليه دوائره",9,"ر",2,0],["وَيا غَيثاً يَعُمُّ العامَ سَيباً","وَصَوبُ الغادِياتِ يَخُصُّ حينا",10,"ن",2,0],["وَيا غَمائمُ زوريهِ محيِّيَةً","وَجهاً لَهُ كانَ يُستَسقَى بِهِ المَطرُ",11,"ر",1,0],["ويا غادةَ الروضِ إما جررتِ","ذيولَ الحرائرِ والسندسِ",12,"س",1,0],["ويا غنيا عن الاسياف يحملها","دعها كفتك المحاظ البابليات",13,"ت",1,0],["ويا غدرة كلب الكلاب أتى بها","لها كل غاوٍ غادر يتهيب",14,"ب",1,0],["وَيا غَيثَ البِلادِ اذا اِقشعرَّت","وَضَنَّ الغَيثُ في شَهري قماح",15,"ح",1,0],["ويا غصن روض الفضل ما قطُّ هزّه","نسيم سوادٍ راكدٍ ومدام",16,"م",1,0],["ويا غير مأمور ويا خير آمر","مُر الدهر ما ترضى فقصدك قصده",17,"د",2,0],["ويا غزالا انسا نافرا","وما عهدنا الأنس بالنافر",18,"ر",1,0],["ويا غمامَ افتقد جناتِ مرسيةٍ","وروِّ من زَهرِها ورداً ونسرينا",19,"ن",2,0],["وَيا غافِر الزلات وَهي عَظيمة","وَيا نافِذ التَدبير ما شاء يَفعَل",20,"ل",1,0],["وَيا غائِباً كَمَدِي حاضِرٌ","بِهِ ما شَجَتْ فاقِدٌ بِالْبُغامِ",21,"م",1,0],["وَيا غُصونَ البانِ ميلي عَلى ال","أَغصانِ بِالأَقمارِ أَو مِيدي",22,"د",2,0],["ويا غارة الرحمن جدي بسرعة","إلينا وحلى عقد كل ملمة",23,"ه",1,0],["وياغوث كل المسلمين وغيثهم","وعصمتهم من كل خوف وضائر",24,"ر",1,0],["وَيا غَديرُ اِنبَسِط لِتُسمِعَهُم","مَن كنتُ مَولاهُ فَهو مَولاه",25,"ا",2,0],["وَيا غداةَ الكَساءِ لا تَهني","عَن شَرحِ عَلياهُ اِذ تَكَسّاهُ",25,"ا",2,0],["ويا غريبَ الحُسْنِ رفقاً بمنْ","غرّبَهُ هذا الجمالُ الغرِيبْ",26,"ب",1,0],["ويا غريقًا بنيِلِ مِصْرَ ولَمْ","يَمَسَّ أَثوابَهُ ولا البَلَلُ",27,"ل",1,0],["ويا غَمْرَةً لِلْمَوْتِ غالَ حِمامُها","فتىً أَنْقَذَ الأَحرارَ من غَمَراتِها",28,"ت",3,0],["ويا غريباً شريداً عن مواطنِهِ","لِتَهنكَ الأرضُ أُلّافاً وأَوْطانا",29,"ن",2,0],["ويا غاسليه إن رحمة ربه","لتغنيه عن غسل وعطر وعن كفن",30,"ن",1,0],["ويا غافلا عن ذكره مولاه ساهيا","لا يرتضي أن تذكرا",31,"ر",2,0],["ويا غُصونَ فَنونٍ ما تَميلُ ضُحًى","إِلاَّ أَميلُ برُوحي حالَ مَيْلِهِمِ",32,"م",1,0],["ويا غيثاً إذا الأنواءُ ضنّتْ","وطال جَفا الحيا حيّا وزارا",33,"ر",2,0],["وَيا غزالاً شَرُوداً","مَرْعاهُ حَبُّ القلوبِ",34,"ب",1,0],["وَيَا غُصُونَ النَّقا لا أَصْلُكُنَّ هُوَ ال","ظِّلُّ الظَّلِيلُ ولا الحُلْوُ الجَنَى الثَّمَرُ",35,"ر",1,0],["ويا غدُ إن كنتَ لي محسناً","فلا تدنُ من ليلتي يا غَدُ",36,"د",1,0],["ويا غَرسَ الذي بارَكَ","فيهِ اللهُ مِن غَرس",37,"س",1,0],["ويا غامساً في الدمعِ خدّي وتاركاً","فؤاديَ في بحرٍ من الوجدِ مغموسا",38,"س",2,0],["ويا غِبْطَتَها إذ هِ","يَ بالجامعِ مَغْبوطه",39,"ط",2,0],["وَيا غُصنَ المَكارِمِ مَن عَلَيهِ ال","وَرى بِالشُّكرِ قَد صارَت طُيورا",40,"ر",2,0],["ويا غوث مضطر ويا أمن خائف","ويا غيث محتاج ويا رشد هائم",41,"م",1,0],["ويا غفار يا ستار من لي","بعفوك حين لا يغني اعتذاري",42,"ر",2,0],["ويا غصون الأراك","وشعشعي يا سماء",43,"ا",2,0],["ويا غياثي ويا كيفي ويا ثقتي","ويا سروري ويا روحي ويا وطري",44,"ر",2,0],["ويا غافر الذنب اغتفر لي قبائحاً","تحشمتها في جهرتي وسريرتي",45,"ي",1,1],["ويا غافر الذنب اغفر الذنب والخطا","وإن كان وزراً يقصم الظهر مثقلا",46,"ل",2,0],["ويا غالباً ردي الجفونَ على القذا","لمن أنتِ بعد اليوم ممدودةُ الطرف",47,"ف",1,0],["ويا غُرَفَ المأوى له فتنظّرِى","يطيب بما يلقى لديك ويطرَب",48,"ب",1,0],["وَيا غافِلاً يَسبيهِ طَرفٌ مُكَحَّل","إِذا راحَ أَو يُصبيهِ خَدٌّ مُوَرَّدُ",49,"د",1,0],["ويا غدُ إن كنتَ لي راحماً","فلا تدنُ من ليلتي يا غدُ",50,"د",1,0],["وَيا غَزالاً نافِراً","يسبي الأسودَ بِالحدَق",51,"ق",1,0],["وَيا غُصنُ كَم تَحكي اِعتِدالَ قَوامِها","حَكيتَ وَلَكن أَينَ ثقلُ الرَوادِفِ",52,"ف",1,0],["ويا غائباً عين المكارم لم تزل","تطلع من شوقٍ إليه وترصد",53,"د",1,0],["وَيا غارة اللَه أَسرِعي لِخَلاصِهم","مِن القهر فَالرَحمَن مِن شَأنِهِ الفَضل",54,"ل",1,0],["وَيا غارة اللَه اِجعَلي كُل وَاحد","بِحصنك قَد غارَ العَدو وَهُم عزل",54,"ل",1,0],["وَيا غارَة اللَه انصريهم وَبددي","جموع العِدى عَنهم فمقت العِدى سَهل",54,"ل",1,0],["ويا غامضين عن الواضحاتِ","كأنَّ العيونَ لديها كليله",55,"ل",2,0],["ويا غوث الصريخ من المحامي","إذا ما فاجأ الخطب المهول",56,"ل",1,0],["وَيَا غَزَالاً في فُؤادِي لَهُ","مَرْعىً وَمِنْ دَمْعِي لَهُ مَشْرَبُ",57,"ب",1,0],["ويا غيثَ سُحْبٍ طالَما جادَ بالنّدى","فروّى جَناباً قد ذَوى حين أقْلَعا",58,"ع",2,0],["ويا غُصْنَ النقَى ليناً وقَدّا","أأقرُبُ لوعةً فَتزيدُ بُعْدا",59,"د",2,0],["ويا غادةً حسناءَ في خدرها استوت","وما مسها كالزهر الاَّ ندى القطرِ",60,"ر",1,0],["وَيا غُصنَ هاتيك الملاعبِ وَالحِمى","تَأَمّل لذاك القَدِّ وَاذكر ترنُّمي",61,"م",2,0],["ويا غوث الوجود ومنتقاه","ويا شيخ الملا شرقاً وغربا",62,"ب",2,0],["ويا غضاباً على الشورى رويدكم","إن الذي قد بغيتم مركب خشن",63,"ن",1,0],["ويا غفَّارُ غُفراناً وختماً","علينا بالسعادةِ والأماني",64,"ن",2,0],["ويا غفورُ إنّني أنا الظلومْ","في الليلِ فاغفر ليَ واغفر كل يومْ",65,"م",1,0],["ويا غفورُ فاغفرنْ في القبرِ","ذنوبَنا ونجِّنا من عُسْرِ",66,"ر",1,0],["ويا غنيُّ أغنِني بلا سببْ","وأصلحْ لي السبَبَ والذي كسَبْ",67,"ب",1,0],["ويا غفورُ يا شكورُ يا مجيدْ","عن الذي أمرتنا فلا نحيدْ",68,"د",1,0],["ويا غُصناً يؤرِّقُني","إِذا ما اِهتزَّ مَوْرِقُه",69,"ه",1,1],["ويا غدير الصبا لولا عوارضه","حفتك ألوية منها شربناكا",70,"ك",2,0],["ويا غصن المعاطف كيف أضحت","تميل بك المنون إلى انعطاف",71,"ف",1,0],["ويا غوثٌ بخطب أرتجيهِ","أيغدرني الزمان وأنت فيهِ",72,"ه",1,0],["ويا غُصنَ الاراكِ فدتكَ نفسي","تحبُّ لقَدك الغصنَ الرطيبا",73,"ب",2,0],["ويا غريباً بأكناف الطفوف قضى","وما له في نواحي الأرض جيران",74,"ن",1,0],["ويا غبطة الأقوام لو أنه الردى","ذهابٌ ولا من مبعث وقضاء",75,"ا",2,0],["ويا غايةَ النفسِ في ال","مُنى وحياةَ البَدَن",76,"ن",1,0],["ويا غُبارَ الحَربِ إِن لَم تَقُم","لِوَاقِفٍ, فاهدِمْهُ, أَو فَابْنِهِ",77,"ن",2,0],["ويا غلالةَ عينيها وقدْ حجبتْ","مقارعَ الشِعرِ فيما كانَ من حبّ",78,"ب",1,0],["وَيَا غيث إِن ساجلت دمعي فَإِنَّهُ","يفوتك مَعَ ذَا آنة ونحيب",79,"ب",1,0],["وَيَا غُصْن إِن هزت معاطفك الصِّبَا","فَمَا لَك قلب بالغرام يذوب",79,"ب",1,0],["ويا غصناً وما للغصن ردف","أقام بمهجتي شوقاً وأقعد",80,"د",1,0],["ويا غيث خير عمم الخلق نفعه","ومن يده أنهلت على كلهم سحب",81,"ب",1,0],["ويا غريبة .. مثل وقتي ! صباحي هجاد !","كيف تقوين هذا البعد ... مااااا أشجعك !",82,"ك",1,0],["ويا غاويا بعد النبي محمد","فما إن أرى عنك العماية تنجلي",83,"ل",2,0]]}