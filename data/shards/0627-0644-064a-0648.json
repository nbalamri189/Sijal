tml","الكامل"],[451,"ذكرى يرددها الزمان الوافي","https://www.aldiwan.net/poem61693.html","الكامل"],[451,"تحية مغترب حاضر","https://www.aldiwan.net/poem61733.html","المتقارب"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[456,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[456,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[462,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[466,"اليوم يوم الجام والرطل","https://www.aldiwan.net/poem59741.html","السريع"],[466,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[475,"لا بارك الله في يوم الفراق فكم","https://www.aldiwan.net/poem15228.html","البسيط"],[477,"سعيا لأجلك في الرعيل المهتدي","https://www.aldiwan.net/poem36956.html","الكامل"],[480,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[513,"اليوم عاد إلى المحلة روحها","https://www.aldiwan.net/poem12051.html","الكامل"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[560,"اليوم قبة بيت القدس قد رفعت","https://www.aldiwan.net/poem52525.html","البسيط"],[560,"اليوم قد ورث الملك المعد له","https://www.aldiwan.net/poem52567.html","البسيط"],[560,"اليوم لاح لنا في الحي شمسان","https://www.aldiwan.net/poem52711.html","البسيط"],[560,"ضاق الرثاء بنا من فرط ما اتسعا","https://www.aldiwan.net/poem52762.html","البسيط"],[560,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[560,"خير الرثاء الذي بالقلب قد لطفا","https://www.aldiwan.net/poem52788.html","البسيط"],[560,"طال البعاد فطال الشوق والكمد","https://www.aldiwan.net/poem52804.html","البسيط"],[560,"اليوم ربك أعطى القوس باريها","https://www.aldiwan.net/poem52826.html","البسيط"],[560,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[560,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[584,"سرى لأرض الكرى فما وصلا","https://www.aldiwan.net/poem17662.html","المنسرح"],[584,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["اليَومَ يَرتاحُ مَن كانَت أَضالِعُهُ","عَلى قَوادِمِ أَحقادٍ وَأَوغامِ",0,"م",1,0],["اليَومَ أَغمَدتُ المُهَنَّدَ في الثَرى","وَدَفَنتُ هَضبَ مُتالِعٍ وَيَلَملَمِ",1,"م",1,0],["اليَومَ صَرَّحَتِ الجُلّى وَقَد تَرَكَت","بَينَ الرَجاءِ وَبَينَ اليَأسِ مُعتَرَكا",2,"ك",2,0],["اليَومَ صَرَّحَتِ النَوائِبُ كَيدَها","فينا وَبانَ تَحامُلُ الأَقدارِ",3,"ر",1,0],["اليَومَ جارَ البَينُ في أَحكامِهِ","فَكَأَنَّ أَسبابَ الوَفاءِ جَرائِرُ",4,"ر",1,0],["اليَومَ أَصحَرَتِ الضَغائِنُ وَاِنجَلَت","تِلكَ المَوارِنُ وَالجِباهُ السودُ",5,"د",1,0],["اليَومَ مِن فَتَياتِ دَهرِكَ فَاِرعَه","وَجَميعُ أَيّامِ الزَمانِ أَشائِبُ",6,"ب",1,0],["اليوم عادت علوج (الروم( فاتحة","وموطنُ العَرَبِ المسلوب والسلب",7,"ب",1,0],["اليَومَ تَعلَمُ يا نُعمانُ أَيَّ فَتىً","يَلقى أَخاكَ الَّذي قَد غَرَّهُ العُصَبُ",8,"ب",1,0],["اليَومَ لِلناسِ عيدٌ يَفرَحونَ بِهِ","وَلَيسَ لي مِنهُ إِلّا الهَمُّ والحَزَنُ",9,"ن",1,1],["اليَومَ أَبكي عَلى قَلبي وَأَندُبُهُ","قَلبٌ أَلَحَّ عَلَيهِ الحُزنُ فَاِنصَدَعا",10,"ع",2,0],["اليَومُ مِثلُ العامِ حَتّى أَرى","وَجهَكِ وَالساعَةُ كَالشَهرِ",11,"ر",1,0],["اليَومَ يُشرِقُ إِدوارٌ عَلى أُمَمٍ","كَأَنَّها البَحرُ بِالآذِيِّ قَد زَخَرا",12,"ر",2,0],["اليَومَ يَلثِمُ تاجُ العِزِّ مُحتَشِماً","رَأساً يُدَبِّرُ مُلكاً يَكلَأُ البَشَرا",12,"ر",2,0],["اليوم عيد في الكنانة كلها","هيهات تدك جاهه الأعياد",13,"د",1,0],["اليوم لو جاريتهم في شوطهم","لم الفنى لبطيئهم بمجار",14,"ر",1,0],["أَليَوْمُ بَيْنَ يَدَيْكَ أَجْمَعَ أَمْرِهَا","وَالحَالُ حَالُ الفَصْلِ فِي اسْتِقْبَالِهَا",15,"ل",3,0],["أَليَوْمَ تَخْدُو فِي العَرِينِ أُسُودُهُ","وَالنَّصْرُ بَيْنَ مَخَالِبِ العِقْيَانِ",16,"ن",1,0],["أَليَوْمَ رُومَا هِيَ الدُّنْيَا وَصَوْلَتُهَا","تُنَافِسُ الأَرْضَ تَوْطِيداً وَتَمْكِينَا",17,"ن",2,0],["اليَوْمَ حَاجَتُنَا إِلَى فَتَيَاتِنَا","شَرْعٌ وَحَاجَتُنَا إِلَى الفُتْيَانِ",18,"ن",1,0],["اليَوْمَ عِيدٌ تُحَيِّي فِيهِ نَابِغَةً","فِي الطُّبِّ ذَا شَرْعَةٍ طَابَتْ وَذَا سَنَنِ",19,"ن",1,0],["أَليَوْمَ عِيدُ الْبَائِسِ المُتَأَلِّمِ","وَاليَوْمَ عِيدُ الْخَافِضِ المُتَنَعِّمِ",20,"م",1,1],["اليَوْمَ تَلْهُو بِاسْتِمَاعِ كَلامِهَا","وَغَداً لَهَا فِي الذِّكْرَيَاتِ كَرمُ",21,"م",1,0],["اليَوْمُ عِيدٌ قَدْ نَشَقْنَا طِيبَهُ","مِنْ حَيْثُ أَفْشَتْ سِرَّهُ الأَكْمَامُ",22,"م",1,0],["أَلْيَوْمَ أَبْطَأُ مَا يَكُونُ رِسَالَةً","مَنْ نَاطَ عَاجِلَهَا بِرِيشِ القَشْعَمِ",23,"م",1,0],["أَليَوْمَ تُنْمِي غَرْسَهَا آمَالُكمْ","وَالْيَوْمَ تُجْنِي خَيْرَهَا الآلامُ",24,"م",1,0],["أَليَوْمَ تَنْفُسُ بِالأَوْطَانِ قِيمَتُهَا","عَنْ كُلِّ شَيْءٍ وَتَدْنُوا دُونَها القِيَمُ",25,"م",1,0],["ألَيَوْمَ إِنْ تَبْخَلُوا أَعْمَارُكُمْ سَفَةٌ","وَالْجَاهُ فَقْرٌ وَمَقْصُوراتُكُمْ رُجَمُ",25,"م",1,0],["أَليَوْمَ لا إِغْرَاقَ فِي قَوْلِ امْرِيءٍ","هُزَّ المُقَطَّمُ وَانْتَشَى الأَهْرَامُ",26,"م",1,0],["الْيَوْمَ يُمنَعُ مِنْ وِردٍ عَلَى ظَمأٍ","مَنْ لَيسَ بِاليَقِظِ المُستَبْصِرِ الْفَهِمِ",27,"م",1,0],["اليوْمَ يُحرمُ أَدْنَى الرِّزْقِ طَالِبُهُ","فأَعْمِلِ الفِكْرَ لا تُحْرَمْ وَتَغْتنِمِ",27,"م",1,0],["أَلْيَوْمَ أَخْطَرَهَا","البَيْنُ كُلَّهَا فِي بَالِي",28,"ي",1,0],["اليوم قرّي يا مواطن أعينا","وتطرّبي بالحمد منك الألسنا",29,"ن",2,1],["اليوم قد طابت لنا لعنةٌ","جاءت من الله بحكم القدر",30,"ر",1,0],["اليوم تبلغُ ما أمَّلت من أملٍ","وما تمنَّيتَ من أمنيَّةٍ شطَطِ",31,"ط",1,0],["اليَومَ يَومُ القَوافي تَهتُفينَ بِها","لا يَشرَبُ الناسُ خَمراً لَم تَصُبّيها",32,"ي",3,0],["اليَومَ أَنتَ بِخَيرٍ","وَالخَيرُ عِندَكَ عادَه",33,"د",2,1],["اليوم باق للقريض بحوضه","ماء وأخشى أن يجف الماء",34,"ا",2,0],["اليوم غازي وحده","في الارض سيد العرب",35,"ب",1,0],["اليوم التمس اللذات كاذبة","في ذكر عهد به انصاعت لي الغيد",36,"د",1,0],["اليوم في ادب الحيا","ة على الضمير توكلي",37,"ل",2,0],["اليوم ربي أظهر ال","عدل وربي عادل",38,"ل",1,0],["اليوم ربع المجد قد","أصبح وهو آهل",38,"ل",1,0],["اليوم للبدر المني","رِ طابت المنازل",38,"ل",1,0],["اليوم يُتَّهم الأبوة في البلى","ويُناقشون جماجما وعظما",39,"م",2,0],["اليوم لا سمر الرماح بعدّة","تغنى ولا بيض الظبا بعتاد",40,"د",1,0],["اليوم ينتحر المقطم","ويقوم في مثواه مأتم",41,"م",1,1],["اليَومَ نَسودُ بِوادينا","وَنُعيدُ مَحاسِنَ ماضينا",42,"ا",1,1],["اليَومَ يَومُ السابِقينَ فَكُن فَتىً","لَم يَبغِ مِن قَصَبِ الرِهانِ بَديلا",43,"ل",2,0],["اليَومَ يَرعى في خَمائِلِ أَرضِهِم","نَشءٌ إِلى داعي الرَحيلِ قِيامُ",44,"م",1,0],["اليَومَ يُغني عَنكَ لَوعَةُ بائِسٍ","وَعَزاءُ أَرمَلَةٍ وَحُزنُ يَتامى",45,"م",2,0],["اليَومَ أَبصَرتَ الحَياةَ فَقُل لَنا","ماذا وَراءَ سَرابِها اللَمّاعِ",46,"ع",1,0],["اليَومَ أَصعَدُ دونَ قَبرِكَ مِنبَرا","وَأُقَلِّدُ الدُنيا رِثاءَكَ جَوهَرا",47,"ر",2,1],["اليَومَ هادَنتَ الحَوادِثَ فَاِطَّرِح","عِبءَ السِنينِ وَأَلقِ عِبءَ الداءِ",48,"ا",2,0],["اليَومَ أَخلَفَتِ الوُعودَ حُكومَةٌ","كُنّا نَظُنُّ عُهودَها الإِنجيلا",49,"ل",2,0],["اليَومَ صَرَّحَتِ الأُمورُ فَأَظهَرَت","ما كانَ مِن خُدَعِ السِياسَةِ مُضمَرا",50,"ر",2,0],["اليَومَ عَهدُكُمُ فَأَينَ المَوعِدُ","هَيهاتَ لَيسَ لِيَومِ عَهدِكُمُ غَدُ",51,"د",1,1],["اليَومَ يَرفَعُ مَلكُ الرومِ ناظِرَهُ","لِأَنَّ عَفوَكَ عَنهُ عِندَهُ ظَفَرُ",52,"ر",1,0],["إِلى واحِدِ الدُنيا إِلى اِبنِ مُحَمَّدٍ","شُجاعِ الَّذي لِلَّهِ ثُمَّ لَهُ الفَضلُ",53,"ل",1,0],["إِلى وَغدٍ يَكادُ يَعودُ فينا","بِرُمحٍ في التِنايَةِ أَو شِماسِ",54,"س",1,0],["اليَومَ حَوَّلَني المَشيبُ إِلى النُهى","وَذَلَلتُ لِلعُذّالِ بَعدَ شِماسِ",55,"س",1,0],["اليَومُ جازَ بي الهَوى مِقدارُهُ","في أَصلِهِ وَعَلِمتُ أَنّي عاشِقُ",56,"ق",1,0],["اليَومَ أُطلِعَ لِلخِلافَةِ سَعدُها","وَأَضاءَ فيها بَدرُها المُتَهَلِّلُ",57,"ل",1,0],["إِلَيَّ وَلَم أَترُك عَلى الأَرضِ حَيَّةً","وَلا نابِحاً إِلّا اِستَسَرَّ عَقورُها",58,"ر",3,0],["اليوم يعذب ورد فيه تكدير","ويستفيد من الهجران مهجور",59,"ر",1,1],["اليوم يرعى الجود منك شقيقه","إذ بنتما لا عن قلى وشقاق",60,"ق",1,0],["إلى وُسْعِ حَمَّامٍ كأنَّ سَماءَهُ","عَقيقٌ بجَاماتِ اللُّجَينِ مُرَصَّعُ",61,"ع",1,0],["اليَومَ يَمنَعُني الفَرارُ حَفيظَتي","وَمُصَمِّمٌ في الرَأسِ لَيسَ بِنابِ",62,"ب",1,0],["اليَومَ أَلعَبُ وَالأَيّامُ مُسرِعَةٌ","في هَدمِ عُمري وَفي تَصريفِ أَحوالي",63,"ي",1,0],["اليَومَ أَنتَ مُكاثِرٌ","وَمُفاخِرٌ مُتَزَيِّنُ",64,"ن",1,0],["اليَومَ زُعزِعَ رُكنُ المَجدِ وَاِنهَدَما","فَحَقُّ لِلخَلقِ أَن تَذري الدُموعَ دَماٍ",65,"م",2,1],["اليومَ يوم للأحبةِ كلِّها","فَدعِ الصديقَ يُثبكَ ممَّا به",66,"ب",2,0],["اليوم أهزأُ بالردى فليَرمِني","ما شاءَ إني اليومَ غيرُ جبانِ",67,"ن",1,0],["اليوم يومك في الشباب فناد","لا نوم بعد ولا شهيُّ رقادِ",68,"د",1,1],["اليوم يبدو حبّ مِص","ر فلا خفاءَ ولا حِجاب",69,"ب",1,0],["اليوم منكِ عرفتُ سر وجودي","وعرفتُ من معناك معنى العيد",70,"د",1,1],["اليوم لي روحٌ كظلٍّ شاحبٍ","في هيكل متخاذل الأسوار",71,"ر",1,0],["اليَومَ أُدرِجَ زَيدُ الخَيلِ في كَفَنٍ","وَاِنَحَلَّ مَعقودُ دَمعِ الأَعيُنِ الهُتُنِ",72,"ن",1,1],["اليَومَ يُسليكَ عَن طَيفٍ أَلَمَّ وَعَن","بِلى الرُسومِ بَلاءُ الأَينُقِ الرَسُمِ",73,"م",1,0],["اليومَ نَنهضُ ظَاهرين بِحُجّةٍ","بَيْضاءَ تَدفعُ تُرَّهاتِ المُدَّعي",74,"ع",2,0],["اليومَ نَملِكُ أن نَقولَ وإنَّنا","لإِلى رُفاتٍ صَامتٍ وَرَمادِ",75,"د",1,0],["اليومَ يُبصرُ حادِي الركبِ وِجْهَتَهُ","ويعرفُ الحائرُ الضِّلِّيلُ عُقباهُ",76,"ا",2,0],["اليومَ تهنئةُ العرو","سِ وفي غدٍ شَقُّ الجيوبْ",77,"ب",1,0],["اليَومَ يَنبَلِجُ اليَقينُ لِذي العَمى","فَيَرى الأمورَ وَيَعرفُ الأحوالا",78,"ل",2,0],["اليَومَ يَطلُبُ كُلُّ شَعبٍ حَقَّهُ","لا خائِفاً وَجِلاً وَلا خَوّارا",79,"ر",2,0],["اليَومَ يَبكي عَلى الإِسلامِ شاعِرُهُ","وَيَملَأُ الدَهرَ إِعوالاً وَإرنانا",80,"ن",2,0],["اليَومَ يَعطِفُ أَحرارُ الشُعوبِ عَلى","وَعدٍ لِمِصرَ بَعيدِ العَهدِ مَمطولِ",81,"ل",1,0],["اليَومَ آذَنَ بِالآياتِ مُرسِلُها","ماذا تُرَجّونَ مِنهُ بَعدَ إيذانِ",82,"ن",1,0],["اليَومَ يَصنَعُ ما تَضيقُ بِهِ الدُنى","مَن كانَ أَمسَ يَقولُ ماذا نَصنَعُ",83,"ع",1,0],["اليَومَ يَنعمُ بِالأَوطانِ مُغتَرِبٌ","ما هَزَّهُ الشَوقُ إِلّا أَنَّ وَاِنتَحَبا",84,"ب",2,0],["اليَومَ نَنسَخُ ما قالَ الوُشاةُ لَنا","وَنَترُكُ الظَنَّ إِن صِدقاً وَإِن كَذِبا",85,"ب",2,0],["اليومَ تُورِدُها الدّماءَ فترتوي","وتردُّها نَشَوى ال