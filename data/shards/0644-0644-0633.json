{"poems":[[72,"عوذت شعرك بالظلام وما وسق","https://www.aldiwan.net/poem19349.html","الكامل"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"وساق صبيح للصبوح دعوته","https://www.aldiwan.net/poem64984.html","الطويل"],[91,"عصفت ريح الندى بالمشعل فخبا","https://www.aldiwan.net/poem8756.html","عموديه"],[89,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[43,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[28,"غلبتم الناس بالحق الذي لكم","https://www.aldiwan.net/poem5083.html","البسيط"],[80,"يا أيها المعرض الذي رقدت","https://www.aldiwan.net/poem31258.html","المنسرح"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[105,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[51,"للناس عيدٌ ولي عيدانِ في العيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27703",""],[116,"وأسمر عسلي اللون صادفني","https://www.aldiwan.net/poem41506.html","الكامل"],[125,"فتنتك تذكارات ميه","https://www.aldiwan.net/poem23746.html","مجزوء الكامل"],[186,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[186,"كم قدر ما أخفي الهون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[187,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[276,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[283,"لله يوسف كم أغاث وغاثا","https://www.aldiwan.net/poem32843.html","الكامل"],[358,"يا ليلة جادت الليالي","https://www.aldiwan.net/poem4168.html","مخلع البسيط"],[367,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[367,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[372,"قل للأحبة يصبرون قليلا","https://www.aldiwan.net/poem57171.html","الكامل"],[372,"ما بال عينك دانت","https://www.aldiwan.net/poem57346.html","المجتث"],[407,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[433,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[450,"حققت مأرب مأربٍ في سدها","https://www.aldiwan.net/poem971.html",""],[459,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[465,"للسعيد المجتبى فضل","https://www.aldiwan.net/poem3330.html","عموديه"],[487,"بنيت بعد مستظل ضاحيا","https://www.aldiwan.net/poem478.html",""],[496,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[516,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[563,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[587,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"]],"verses":[["للسيف في يمنى يديه جدول","فلذا يفيض على جوانبه العَلق",0,"ق",1,0],["للسَّيْفِ عن قَطْعِ سَيْفٍ مثْلِهِ ذَكَرٍ","مَنْدُوحَةٌ في رقاب ذاتِ تَأْوِيدِ",1,"د",1,0],["للسُّود في السودِ آثارٌ تركن بها","لمعاً من البيض تَثني أعينَ البيضِ",2,"ض",1,0],["لِلسَما لِلَّيلِ لِلفَجرِ الجَلي لِلرُبى","لِلأَقاحي الذابِلاتِ الذاوِيَ كَالأَماني",3,"ي",1,0],["لِلسَواقي النائِحاتِ الباكِيَه كَالغَواني","سَلَبَ الدَهرُ حَلاها الغالِيَه في ثَوانِ",3,"ن",1,0],["للسمع انت فتنة","وفتنة للباصره",4,"ر",2,0],["لِلسلم آلاتٌ وَلِلحَرب أُهَب","جِماعهن في المَمالك الذَهَب",5,"ب",1,0],["لِلسَبيِ ما نَكَحوا وَالقَتلِ ما وَلَدوا","وَالنَهبِ ما جَمَعوا وَالنارِ ما زَرَعوا",6,"ع",3,0],["لَلسُفنُ أَهوَنُ بَأساً إِذ تُقَوِّدُها","في الماءِ مَطلِيَّةَ الأَلواحِ بِالقيرِ",7,"ر",1,0],["للسحرِ عَيْنٌ سبحانَ خالقِها","وأنتَ من خَلْقِهِ بها رانِ",8,"ن",1,0],["لِلسَيفِ بَعدَكَ حُرقَةٌ وَعَويلُ","وَعَلَيكَ لِلمَجدِ التَليدِ غَليلُ",9,"ل",1,0],["للسلمِ والحربِ منه حازِمٌ يَقِظٌ","يُعيي الدُّهاةَ ويُردِي الجحفلَ اللَّجِبا",10,"ب",2,0],["لَلسَّيفُ سَيفُ اللَّهِ أَهْوَلُ موقعاً","من صَخرةٍ تُلقَى وحبلٍ يُفتَلُ",11,"ل",1,0],["للسِّيفِ عن قَطع سَيفٍ مثلِهِ ذَكرٍ","مندوحة ٌ في رقاب ذات بأويدِ",12,"د",1,0],["للسمر طعن كطعن السمر في كبد","فاحذر أخا الذوق طعن الأسمر العادي",13,"د",2,0],["للسلط تنسب أم تراها","عند حزرك إربدية",14,"ي",2,0],["للسيفِ والقلمِ افتخارٌ كلما","لَمستْها لك راحةٌ وبَنان",15,"ن",1,0],["للسيفِ والقلمِ النحيفِ بكَفِّه","فعلٌ يكون به مُنىً ومَنون",16,"ن",1,0],["للسعة طبّوزع ونهشة حية","ولذعة زنبور فجسمي مكمّد",17,"د",1,0],["لِلسِّلْمِ والهَيْجاء غَيْثٌ ديمَةٌ","مِنْهُ ولَيْثٌ لِلطغاةِ هَصورُ",18,"ر",1,0],["لِلسَّبي وَالبيضِ الرِقاقِ وَلِلقَنا","فَلَكَ المَمالِكُ لا تَزالُ تُراثا",19,"ث",2,0],["لِلسَّيلِ فِيهَا عَلَيَّ نُعمَى","يَقصُرُ عَنهَا لِسَانُ شُكرِي",20,"ر",2,0],["لِلسُحبِ دَعوى في النَدى","بَطَلَت بِحَقٍّ مِنكَ يُزهِق",21,"ق",1,0],["لِلسَبقِ في كَفِّهِ بِها قَصَبٌ","غُرِّزَ مِن تَحتِ ظُفرِها القَصَبُ",22,"ب",1,0],["للسُّقمِ عِندي مِنَّةٌ أعتَدُّها","لمَّا خَفيتُ عن الوُشاةِ نُحولا",23,"ل",2,0],["للسُّقمِ والسِّحرِ فيها","وللفُتورِ اعتِراضُ",24,"ض",1,0],["لِلسَّمحِ نجلُ مُحَمَّدٍ","ذي الفَخرِ وَالقَدرِ الكَبير",25,"ر",1,0],["لِلسَّيْفُ في كفِّهِ نارٌ على عَلَمٍ","إِن كنتَ يوماً سَمِعْتَ النارَ والعلما",26,"م",2,0],["للسد جارات سبقنك في الغنى","وبذلن لم يبخلن في ما ينفع",27,"ع",1,0],["للسيف ما ترضاه من","ها العينُ أو تستونقُهْ",28,"ق",2,0],["للسعيد المجتبى فضلٌ","على كل عديمِ",29,"م",1,1],["لِلسِترِ مِمّا يَتبَعُ القَواضِيا","أَخشى رَكيباً أَو رَجيلاً عاديا",30,"ي",2,0],["للسلفِ الصالح والصحابَهْ","أساءَ سمعاً فأساء جابه",31,"ه",1,0],["للسيف والضيف في يومي ندى وردى","منه نزال إذا حلا وإنزال",32,"ل",1,0],["للسيفِ فضلٌ في المَضاءِ وإنَّما","لا يَقبَلُ الإنكارَ فضلُ الضَّارِبِ",33,"ب",1,0],["للسيفِ والرُمحِ والأقلامِ قد وُلِدَتْ","راحاتُهُ ولِسُؤَّالٍ تفاجيها",34,"ي",3,0],["لِلسُّيوفِ الحدادِ ضَرْبٌ وللسُّم","رِ طِعانٌ وَللجِيادِ صَهِيلُ",35,"ل",1,0]]}