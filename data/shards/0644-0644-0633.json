https://www.poetsgate.com/ViewPoem.aspx?id=179982",""],[4916,"دندنه","https://www.poetsgate.com/ViewPoem.aspx?id=136925",""],[4935,"زفاف نعمت إلى الرضا منى","https://www.poetsgate.com/ViewPoem.aspx?id=129469",""],[5083,"تَدَحْرُجُ الدُرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=53679",""],[5102,"لا أهلاً ولا سهلا..","https://www.poetsgate.com/ViewPoem.aspx?id=12859",""],[5102,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=12900",""],[5273,"أميرة الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=201577",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5431,"للسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=202266",""],[5436,"للكرامات دربنا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177708",""],[5493,"مثلَ النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=208609",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5573,"لاتقولو ضاق فالدرب الحليم","https://www.poetsgate.com/ViewPoem.aspx?id=210462",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5846,"نداءُ شاعرة..","https://www.poetsgate.com/ViewPoem.aspx?id=123432",""],[5848,"الدمع والشمع","https://www.poetsgate.com/ViewPoem.aspx?id=50590",""],[5848,"ظلم الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=53097",""],[5848,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=53361",""],[5848,"مشكلة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=53446",""],[5851,"ويهتفون بحياة الرداءة","https://www.poetsgate.com/ViewPoem.aspx?id=175276",""],[5851,"شهقة السنديان","https://www.poetsgate.com/ViewPoem.aspx?id=175298",""],[5952,"وجْهُ فَلا","https://www.poetsgate.com/ViewPoem.aspx?id=214017",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[5309,"لا اغضب الناس ليس المرء قوته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573735",""],[4222,"الشوق أبرح ما يكون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52710&r=&rc=2",""]],"verses":[["للسيف في يمنى يديه جدول","فلذا يفيض على جوانبه العَلق",0,"ق",1,0],["للسَّيْفِ عن قَطْعِ سَيْفٍ مثْلِهِ ذَكَرٍ","مَنْدُوحَةٌ في رقاب ذاتِ تَأْوِيدِ",1,"د",1,0],["للسُّود في السودِ آثارٌ تركن بها","لمعاً من البيض تَثني أعينَ البيضِ",2,"ض",1,0],["لِلسَما لِلَّيلِ لِلفَجرِ الجَلي لِلرُبى","لِلأَقاحي الذابِلاتِ الذاوِيَ كَالأَماني",3,"ي",1,0],["لِلسَواقي النائِحاتِ الباكِيَه كَالغَواني","سَلَبَ الدَهرُ حَلاها الغالِيَه في ثَوانِ",3,"ن",1,0],["للسمع انت فتنة","وفتنة للباصره",4,"ر",2,0],["لِلسلم آلاتٌ وَلِلحَرب أُهَب","جِماعهن في المَمالك الذَهَب",5,"ب",1,0],["لِلسَبيِ ما نَكَحوا وَالقَتلِ ما وَلَدوا","وَالنَهبِ ما جَمَعوا وَالنارِ ما زَرَعوا",6,"ع",3,0],["لَلسُفنُ أَهوَنُ بَأساً إِذ تُقَوِّدُها","في الماءِ مَطلِيَّةَ الأَلواحِ بِالقيرِ",7,"ر",1,0],["للسحرِ عَيْنٌ سبحانَ خالقِها","وأنتَ من خَلْقِهِ بها رانِ",8,"ن",1,0],["لِلسَيفِ بَعدَكَ حُرقَةٌ وَعَويلُ","وَعَلَيكَ لِلمَجدِ التَليدِ غَليلُ",9,"ل",1,0],["للسلمِ والحربِ منه حازِمٌ يَقِظٌ","يُعيي الدُّهاةَ ويُردِي الجحفلَ اللَّجِبا",10,"ب",2,0],["لَلسَّيفُ سَيفُ اللَّهِ أَهْوَلُ موقعاً","من صَخرةٍ تُلقَى وحبلٍ يُفتَلُ",11,"ل",1,0],["للسِّيفِ عن قَطع سَيفٍ مثلِهِ ذَكرٍ","مندوحة ٌ في رقاب ذات بأويدِ",12,"د",1,0],["للسمر طعن كطعن السمر في كبد","فاحذر أخا الذوق طعن الأسمر العادي",13,"د",2,0],["للسلط تنسب أم تراها","عند حزرك إربدية",14,"ي",2,0],["للسيفِ والقلمِ افتخارٌ كلما","لَمستْها لك راحةٌ وبَنان",15,"ن",1,0],["للسيفِ والقلمِ النحيفِ بكَفِّه","فعلٌ يكون به مُنىً ومَنون",16,"ن",1,0],["للسعة طبّوزع ونهشة حية","ولذعة زنبور فجسمي مكمّد",17,"د",1,0],["لِلسِّلْمِ والهَيْجاء غَيْثٌ ديمَةٌ","مِنْهُ ولَيْثٌ لِلطغاةِ هَصورُ",18,"ر",1,0],["لِلسَّبي وَالبيضِ الرِقاقِ وَلِلقَنا","فَلَكَ المَمالِكُ لا تَزالُ تُراثا",19,"ث",2,0],["لِلسَّيلِ فِيهَا عَلَيَّ نُعمَى","يَقصُرُ عَنهَا لِسَانُ شُكرِي",20,"ر",2,0],["لِلسُحبِ دَعوى في النَدى","بَطَلَت بِحَقٍّ مِنكَ يُزهِق",21,"ق",1,0],["لِلسَبقِ في كَفِّهِ بِها قَصَبٌ","غُرِّزَ مِن تَحتِ ظُفرِها القَصَبُ",22,"ب",1,0],["للسُّقمِ عِندي مِنَّةٌ أعتَدُّها","لمَّا خَفيتُ عن الوُشاةِ نُحولا",23,"ل",2,0],["للسُّقمِ والسِّحرِ فيها","وللفُتورِ اعتِراضُ",24,"ض",1,0],["لِلسَّمحِ نجلُ مُحَمَّدٍ","ذي الفَخرِ وَالقَدرِ الكَبير",25,"ر",1,0],["لِلسَّيْفُ في كفِّهِ نارٌ على عَلَمٍ","إِن كنتَ يوماً سَمِعْتَ النارَ والعلما",26,"م",2,0],["للسد جارات سبقنك في الغنى","وبذلن لم يبخلن في ما ينفع",27,"ع",1,0],["للسيف ما ترضاه من","ها العينُ أو تستونقُهْ",28,"ق",2,0],["للسعيد المجتبى فضلٌ","على كل عديمِ",29,"م",1,1],["لِلسِترِ مِمّا يَتبَعُ القَواضِيا","أَخشى رَكيباً أَو رَجيلاً عاديا",30,"ي",2,0],["للسلفِ الصالح والصحابَهْ","أساءَ سمعاً فأساء جابه",31,"ه",1,0],["للسيف والضيف في يومي ندى وردى","منه نزال إذا حلا وإنزال",32,"ل",1,0],["للسيفِ فضلٌ في المَضاءِ وإنَّما","لا يَقبَلُ الإنكارَ فضلُ الضَّارِبِ",33,"ب",1,0],["للسيفِ والرُمحِ والأقلامِ قد وُلِدَتْ","راحاتُهُ ولِسُؤَّالٍ تفاجيها",34,"ي",3,0],["لِلسُّيوفِ الحدادِ ضَرْبٌ وللسُّم","رِ طِعانٌ وَللجِيادِ صَهِيلُ",35,"ل",1,0],["للسوقِ خُذنا ثمّ بِعنا كَي بما","كَسبت يداكَ من التجارة تغنمِ",36,"م",1,0],["لِلسَعد بِدَولته شَغفُ","وَالمَجد لَهُ مِنهُ شَرَفُ",37,"ف",1,0],["للسبت عندي يُدٌ سأشكرُها","شُكْرَ مقرٍّ له ومعترفِ",38,"ف",1,1],["لِلسّوءِ غَيِّر حالَهمْ","وَقَصِّرَنْ آجالَهمْ",39,"م",1,0],["لِلسحرِ تَأثيرٌ أَضَرَّ ذَوي الحِجا","مُذْ ذُقتُه لا أستطيعُ نُهوضا",40,"ض",2,1],["للسمر معان لا ترى في البيض","تالله لقد نصحت في تحريضي",41,"ي",1,1],["لِلسّادَةِ النِّصْفُ وَنِصْفُ الْغائِبِ","يُدْفَعُ في غَيْبَتِهِ لِلنّائِبِ",42,"ب",1,0],["لِلسَيفِ وَالأَقلامِ قامَ مُشيرُ","وَبَدا وَزيرٌ بِالرَشادِ مُشيرُ",43,"ر",1,1],["للسائق المستحث رد على","الواقف السلام واستقم",44,"م",1,0],["للسعد عشر كواكب ولا نت حا","دي عشرها السامي سنا وسعودا",45,"د",2,0],["للسير فيه راحة للعاشق","فارحل إليه النفس صاح ووافق",46,"ق",1,0],["للسيّد المأمول في سَمَدٍ","ولهُ أَبو عبد الإله اسْمُ",47,"م",1,0],["للسّخط منه العفوُ يَتبعُهُ","برُّ الرّضى ولغيظهِ الكَظْمُ",47,"م",1,0],["للسعد أضحى سيد أو كماله","كجلالة لا يعتريه فتور",48,"ر",1,0],["لِلسَّيرِ مُبتَدِرٍ كالسَّيلِ مُحتَفِرٍ","كالطَّيرِ مُشتَمِلٍ بالليلِ مُلتَئِمِ",49,"م",1,0],["للسيف هام أعاديهِ وأرجلُهم","ونحرُهُم للقَنا الخَطِّيَّةِ الذُبُلِ",50,"ل",1,0],["لِلسَّمعِ مَلهىً وَلِلعَينِ الطَموح هَوىً","فَهُنَّ لَذَّةُ أَسماعٍ وَأَبصار",51,"ر",1,0],["للسابقات يجيلها","شعثاً تشذب في الطراد",52,"د",1,0],["للسلم حسن ساعة فاذا انتفت","قبحت مواقعه على الانظار",53,"ر",1,0],["للسرّ صندوقٍ غلوقه مجافيل","ويداري احقوق الإخوّه والعهود",54,"د",1,0],["للساجدين نَسِيْجُ الوَرْدِ أَفْرِشُهُ","غَيْثًا أُعَطِّرُهَ مِنْ غَيْمِ أَدْمِعَتِيْ",55,"ت",2,0],["لِلساجدِين خُيُوطُ الضَّوْءِ غَافِيَةٌ","تُغَسِّلُ المَوْتَ عَنْ أَعْجَازِ أَسْئِلَتِيْ",55,"ت",2,0],["للسبق حق وحق القرب اكد من","سبق فقدم به حفظا لعهدهم",56,"م",1,0],["للسالكين على الحياةِ بصائرٌ","حسنت بها يوم الحسابِ مصائِرُ",57,"ر",1,0],["للسُّهْدِ فوْقَ جُفوني لا يُفارِقُها","مُراقِبٌ فَإن اسْطَعْتَ الوُلوج لِجِ",58,"ج",1,0],["للسيد السند العلي القدر قل","بشرى بعام للسرور ضمين",59,"ن",1,0],["للسيفِ منهم نصيبٌ ما مطلتَ بهِ","وللتعمّدِ منهم أوفرُ القِسَمِ",60,"م",1,0],["للسّعْدِ تحْرزُهُ للوَعْدِ تُنجزُهُ","للصّدْر تَشرحُه للقَدْرِ ترفعُهُ",61,"ع",2,0],["للسير مع صرف وظبٍ والنظام لغير","البر أو ماله يعزى وصرف عظا",62,"ظ",2,0],["للسلم قَد جَنحوا فَمنوا وَأَصفَحوا","ما قتل نصفَهُم مِن الإِنصاف",63,"ف",1,0],["لِلسَّيفِ في كَفِّ المُدَرَّبِ نبوَةٌ","عِندَ القِراعِ وَلِلزِّنادِ صُلودُ",64,"د",1,0],["للسيد الدردير قطب الدائره","عين لمن حلوا حماه ناظره",65,"ر",2,1],["للسَّخل والرمان إمليسيّ","وعندَنا إهليلج هنديّ",66,"ي",1,0],["للسعد في كلتا يديك أزمة","ولحادثات الدهر طوع أماء",67,"ا",2,0],["لِلسبعَة النَّيِّرات عَن شَرفي","عَجزٌ وفي العالَمينِ تَبريحُ",68,"ح",1,1],["لِلسَيفِ دامَت راحتاهُ وَلِلنَدى","يَردي العِدى وَيَجود بِالإِحسانِ",69,"ن",1,0],["لِلسَيفِ وَالضَيف مُختارٌ وَشاهدهُ","افعالُهُ الغرّ واسمُ المَرءِ إِقرارُ",70,"ر",1,0],["للسماكين شأت في سمكها","مذ أنيطت درراً في سلكها",71,"ه",2,0],["لِلسحر إِلى لحظك وَحيٌ يُوحى","مِن حَظِّكَ لِلحُسنِ أَرى مَشروحا",72,"ح",2,1],["لِلسَبِّ شَحا فاه فَهنّأتُ فَمي","أَن قَد وَقَعت قبلتُهُ مَوقعَها",73,"ه",2,0],["للسبحة الصفراء لازم فكم","سرت قلوبا آذنت بالبوار",74,"ر",1,1],["للسانهِ حُجَجٌ يَرُدُّ بها","جزماً قضايا الألسنِ اللُّدِ",75,"د",1,0],["للسيِّد الملك المُعظّ","م ذي الجلالة والعلاءِ",76,"ا",2,0],["للسِّير في يوم جديد","يبتغي سر النجاة",77,"ه",1,0],["للسائرينَ وعينُ اللهِ تحرسُهمْ","في سكَّةِ العزِّ والأمجاد والظَّفرِ",78,"ر",1,0],["للسراج الذي سيبقى منيراً","رغم ليلٍ دجا وستر أقيما",79,"م",2,0],["للسبطِ مِن ميلاده في يثربٍ","حتى الشهادةِ في مصارع كربلا",80,"ل",2,0],["للسؤال القى بهن بال واجابه.","ماخبرت فيوم عيّن وإخذلنّي",81,"ن",2,0],["للسيف أساد وللضيف همو","أهل وحفظ الجار منهم ديدنا",82,"ن",2,0],["للسعدِ قد خلقت ، فلو مُلِّكْتُه","لجعلتُها تحيا بوَفْرَةِ سَعدِ",83,"د",1,0],["للسلم نجنح إن جنحتم كوننا","أهل السلام ودائما أقطابا",84,"ب",2,0],["للسائلين ما البيعةُ الغرَّاءُ","هنا ب\"العيون\" جوابهم وضّاءُ",85,"ا",2,0],["للسِّحرِ في وجهِها خِدْرٌ ومُتَّكَأٌ","تُخفيهِ لكنَّ مَنْ يُفشيهِ أهدابُ",86,"ب",1,0],["للسّوءِ والإثمِ ما ناخوا ولا قصدوا","فهم شبابٌ بحبل الله مُعتصمُ",87,"م",1,0],["للسمر شهقات البراري نُغّمت","موالَ شعرٍ بالربى مستنفرا",88,"ر",2,0],["للسمر طعم البن كوب تلذّذٍ","وحلاه يكفي لن أزيد السكّرا ...",88,"ر",2,0],["للسمواتِ دربنا درب حرٍّ","يكتب النصر في العلى منحوتا",89,"ت",2,0],["للسالكينَ جراحَ فجٍّ قاتمٍ","كيْ يكشفَ البرهانُ زَهوًا منبَرَهْ",90,"ر",2,0],["للسواري محاري يا دياجي ضلام","والدجا له دياجر فلها من جديل",91,"ل",1,0],["للسؤال الصعب للراي الحكيم","للسكوت المر للحزن وشجاي",92,"ا",2,0],["للساكنين ديارهم في خاطري","حلّوا باطناب القلوب حلالا",93,"ل",2,0],["للسما عز وثبات وللسحاب الانسحاب","والرفيع يدوم عالي والوطن والدون دون",94,"ن",1,0],["للسِّحر.. للفجر..للأمطار تغسِلُني","من وطأةِ الصيفِ والرَملِ الذي نَشِبا",95,"ب",2,0],["للسهر ولضيقة الصدر وجروح الزمان","للتعب واحساس الايام يالقلب الحزين",96,"ن",1,1],["للسالفه ريقٍ نشف يوم ناداك","وللجرح صرخه ما تعدت حراويك",97,"ك",1,0],["للسهر وعيون حزني والدموع وما وراها","والتعب واخر مشاوير التناهيد الأليمة",98,"م",2,1],["للسهر عندي محطات ومواني","وللتعب فيني مواويلٍ أليمة",99,"م",2,0],["للسنديان لجذع النخل ترجمة","لمن تملّكها طهر وعلياءُ",100,"ا",2,0],["للسنديان حكاية في سره","وعلى جذوره برعمت حوباؤه",101,"ا",3,0],["للسيف عجزٌ أفضى إلى ورقٍ","ليقتلَ الوَهْنَ في الذي قُتِلا",102,"ل",2,0],["للسَّبْعِ بَعْدَ العَشْرِ من صَفَرٍ مُنيْ","مِنْكِ الورَى بمُفَتِّتِ الأكْبَادِ",103,"د",1,0],["للسبق فيه ملامح","والبدر يعرف من سنائه",104,"ا",3,0],["لِلسِّرِّ نافِذَتانِ السُّكرُ وَالغَضَب","يَنِمُّ فِعلُ ابنِ أَخفى عَن حَقارَتِهِ",105,"ت",2,0],["للسيد الملك المعظم","ذي الجلالة والعلا",106,"ا",1,0]]}