{"poems":[[46,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[154,"أعدد لضيفك أهبة الإِكرام","https://www.aldiwan.net/poem68525.html","الكامل"],[276,"رد بالمطي موارد الغزلان","https://www.aldiwan.net/poem52069.html","الكامل"],[280,"أمل الفتى ورد الزلال السائغ","https://www.aldiwan.net/poem25392.html","الكامل"],[308,"ما اسم ثلاثي ترى","https://www.aldiwan.net/poem57737.html","مجزوء الرجز"],[396,"خل المقادير تمضي لا تغالبها","https://www.aldiwan.net/poem54612.html","عموديه"],[520,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[563,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34402","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27202","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27686","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27346","البسيط"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202676","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128101","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94270","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93943","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65167","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126280","الكامل"],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5829,"نفحات السحر","https://www.poetsgate.com/ViewPoem.aspx?id=152736",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[2220,"أنض الركاب إلى ربِّ السموات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11229&r=&rc=103",""]],"verses":[["وَأَعكَفتُ المُنى في ذاتِ صَدري","عُكوفَ اللَحظِ في الخَدِّ الأَسيلِ",0,"ل",1,0],["وَاعْكُفْ عَلَى الْهَرَمَيْنِ واسْأَلْ عَنْهُمَا","بَلْهِيبَ فَهْوَ خَطِيبُ ذَاكَ الْوَادِي",1,"د",2,0],["واعكف على الأذكار في آنائه","ما بين مبتدإِ له وختام",2,"م",1,0],["واعكف عَلى الدمن الَّتي بمحجر","وَدع الحنين لا برق الحنان",3,"ن",1,0],["واعكُف على التشمير في جنح الدج","ى تظفر بثوب للمثوبة سابغ",4,"غ",1,0],["واعكسه إن تركته","من بعد أن تحرفه",5,"ف",2,0],["واعكف على بابه في كل ما نفس","فإن نسيانه يا صاحبي حوب",6,"ب",1,0],["واعكس فهن بفضله أيامه","فبه عرفنا حرمة الأيام",7,"م",1,0],["واعكف على سنن النبي محاذراً","بدعَ الزمان يسوقها الشيطان",8,"ن",1,0],["وأعكسَ عَين حاسده فَعادَت","مِنَ الرَمي المصوّب كَالهَباءِ",9,"ا",2,0],["واعكف بشاطىء وادي القدس مرتقياً","واخلع نعالك تحظى بالمناجات",10,"ت",1,0],["واعكف على علم الحقيقةِ","كلٌّ إلى علمِ الحقيقة آثل",11,"ل",1,0],["وأعكفُ على كلِّ خيرٍ أنتَ فاعلُه","فإنما الخيرُ في التشريعِ بالدِّين",12,"ن",1,0],["واعكف على القرآن دهرك واجتمع","فالشغل عنك لغيره تفريق",13,"ق",1,0],["واعكف مع الرهبان في حاناتها","واشطح مع الشماس والبطريق",14,"ق",1,0],["واعكس الأصل بحذف المبتدا","فهو وصف للذي أضحى شرود",15,"د",1,0],["واعكف على إرشاد نصحي وانتبه","حيث الغواية دونها قرع العصى",16,"ا",1,0],["واعكف على ساق لصبح جبينه","نور يضيء وليل طرته سبحا",17,"ح",2,0],["واعكف على الكتب التي منه حوت","عزّ القواعد سيما التلخيص",18,"ص",1,0],["واعكف على كسب العلوم وعانق ال","أسفار تحمد في السرى عقباكا",19,"ك",2,0],["وأعكسه الحبر المهذب فانثنى","بخفي حنين خائباً متندما",20,"م",2,0],["وأعكسه طوراً عليه لأنه","بأرجاسه أولى وأركاسه أحرى",21,"ر",2,0],["واعكف على باب الكريم تضرعا","واخفض جناحك لحظة الاقرار",22,"ر",1,0],["واعكفْ على الأرحامِ واجمعْ شملَهمْ","وَزُرِ القَريبَ محبةً، وََصِلِ العُرى",23,"ر",2,0],["واعكفْ بشاطئ وادي القدسِ مرتقياً","واخلعْ نعالكَ تحظى بالمناجاتِ",24,"ت",1,0]]}