{"poems":[[56,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[87,"ضللت أبناء البلاد بأسطر","https://www.aldiwan.net/poem7254.html","الكامل"],[51,"أخوي مرا بالقبور","https://www.aldiwan.net/poem62076.html","مجزوء الكامل"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[54,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[50,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[50,"وغزال في الدجى لي","https://www.aldiwan.net/poem64326.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[41,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[189,"يا محل الروح من جسدي","https://www.aldiwan.net/poem14498.html","أحذ الكامل"],[226,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[286,"لا يزور الخليل عندي خليلا","https://www.aldiwan.net/poem1381.html",""],[308,"والهوى لو ملكت أمرا مطاعا","https://www.aldiwan.net/poem58221.html","الخفيف"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[396,"وصيتي يا علي","https://www.aldiwan.net/poem54589.html","عموديه"],[458,"حمدت ربي على ذمي فأكثره","https://www.aldiwan.net/poem61236.html","البسيط"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[556,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44612","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77515","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120047","المديد"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90729","الرجز"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27254","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75956","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130832",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200553","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204891",""],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79704","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139985","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""]],"verses":[["ثُمَّ أَدَّت كُلَّ ما شَهِدَت","مِن قُرونِ الناسِ وَالأُمَمِ",0,"م",1,0],["ثُمَّ اِدَّعاها بَنو العَبّاسِ إِرثَهُمُ","وَما لَهُم قَدَمٌ فيها وَلا قِدَمُ",1,"م",1,0],["ثم أدنيتني فزادَك يُمْنِي","من أميرٍ مؤيَّدٍ إدناءَ",2,"ا",2,0],["ثم أَّدرعت الناشئين لحربه","فرأوا ببرديك امرأ ختالا",3,"ل",2,0],["ثُمَّ ادعوا يا مَن بِها","مِن ماجِدٍ قَرمٍ فَخورِ",4,"ر",1,0],["ثُمَّ آدَتهُ كِبرِياءُ عَلى الكر","رِ وَحَردٌ في صَدرِهِ يَجِدُه",5,"د",2,0],["ثُمَّ أَدَّينا إِلى شَمَطٍ","مُسبِلٍ في الرَأسِ أَهدابا",6,"ب",2,0],["ثُمَّ أَدناني إِلى مَلِكٍ","يَأمَنُ الجاني لَدى حُجرِه",7,"ر",2,0],["ثُمَّ أَدنَيتُ يَميني","نَحوَهُ رِفقاً لَماسِ",8,"س",1,0],["ثم أدنى سمعه","ثم ألقى نظرا",9,"ر",2,0],["ثمَّ آدتْهُ كبرياءُ علَى الك","رِّ، وحردٌ في صدرهِ يجدُهْ",10,"د",2,0],["ثم أَدَّاه رجاؤكمُ","لقياسٍ غير مُطَّردِ",11,"د",1,0],["ثم أدنى على فمي","فمه العذب يسبر",12,"ر",1,0],["ثم أدعو نُفعتم وشفيتم","وبقيتم لنا بقاءً طويلاً",13,"ل",2,0],["ثم أدعو العذال إذ ذاك حتى","إن رأوا عندهم فضولاً يقولوا",14,"ل",3,0],["ثم ادع ربك باذكار روتها الرواه","وبعد سلم ورتبها على ماحكاه",15,"ا",2,0],["ثم ادع لي يا علي","إني صحائفي سود",16,"د",1,0],["ثم ادعى الطهر في ستر لعورته","بئس الطهارة في مجموع أوزار",17,"ر",1,0],["ثُمَّ أَدْلاهُ بعدَ ذلكَ للسِّجْ","نِ لِسِرٍّ بعِلْمِهِ مَخْفِيِّ",18,"ي",1,0],["ثم أدى اليد التي كل خل","حاسد لي من أجلها وغيور",19,"ر",1,0],["ثمّ أدنى إلى المحلّ الّذي ين","ظر نحوي فيه المساقون حُولا",20,"ل",2,0],["ثم ادعيتم والكذوب أظلم","بأنه أول من قد اسلم",21,"م",1,0],["ثم ادعيتم بالمباهتات","بأنه قدم للصلاة",21,"ه",1,0],["ثم ادعى الشيعة لما إن عزل","ولم يزل مذبذبا حتى قتل",21,"ل",1,0],["ثم ادعوا له من الدلائل","والمعجزات قيل والوسائل",21,"ل",1,0],["ثم أدارَ كفَّه لِكفِّه","يرفعُها منه إلى أعلى مَحلّ",22,"ل",1,0],["ثُمَّ أَدِر كَأسَ الشَمولِ مُنعِما","أَكرِم بِهذا مَشرَباً وَمَطعَما",23,"م",2,0],["ثُم ادعى الذئب بشيء سَرَقا","مِن بَيته وَقالَ كانَ طبقا",24,"ق",2,0],["ثُمَّ أَدامَها عَلى مرّ المَدى","حَتّى يَكونَ لِعداته مدى",25,"د",2,0],["ثم أدنى خده خجلا","فحنيت الورد وهو جني",26,"ن",2,0],["ثم أدر بقية الأجزاء","كما عهدته في الابتداء",27,"ا",2,0],["ثم أدر دوائر الزحاف","لكل زحف لاق بالقوافي",27,"ي",1,0],["ثم أدُورُ حولهُ وأحتَبِه","حتى يُقالَ شرِهٌ ولستُ بِه",28,"ه",1,0],["ثم أدنى حبا وأزلف حتى","كان أدنى إليه من قدر قاب",29,"ب",1,0],["ثم ادّعى أن الحقيقة خالفتْ","ما الشرعُ جاء به ولكن تستّر",30,"ر",1,0],["ثم ادعى كل بأن العقل ما","قد قلته دون الفريق الثاني",31,"ن",2,0],["ثمَّ ادعُوا مِن بَعدُ للشهابِ","ما دارتِ النعوشُ بالأقطاب",32,"ب",1,0],["ثُمَ أَدنى جَوهَراً مِن جَوهَرٍ","وَتَحسّى الكَأسَ في فَردِ نَفَس",33,"س",1,0],["ثم اديت نحو غيرك خيراً","فلك الخير دائماً في الجنان",34,"ن",1,0],["ثُمَّ أَدناهُ أَهلاً","لِاِصطِفاهُ تعالى",35,"ا",1,0],["ثم أدركت أنني قد ترقّيت","فلم أسع للعلى واكتفيت",36,"ت",1,0],["ثم أدنى الفم مني","فارتشفنا وشربنا",37,"ن",2,0],["ثم أدنو من غرفتي نحو ركن","هو ركن الشقاء والبأساء",38,"ا",2,0],["ثماد اصطباري شفَّها حرُّ أضلعي","ولوعاتُ أشواق إليه حثائث",39,"ث",1,0],["ثم ادعوا أنهم سيطروا","على بني الشرق لكي يرتقوا",40,"ق",3,0],["ثُمَّ أدنَاهُ رَبُّهُ وَحَبَاهُ","بِهِبَاتٍ وَزَالَ عَنهُ الغِشَاءُ",41,"ا",2,0],["ثمُّ ادَّعَى بِأنَّهُ مُسيَّرٌ","كُلٌ بِأمرِ اللهِ يَغدُو سَاريَا",42,"ي",2,0],["ثُمَّ ادَّعى بِالذَّودِ عَن أَوطانِهِ","وَالآنَ باتَ يَذودُ عَن رَنّانِهِ",43,"ن",2,0],["ثم أدنت قُطنها من وَتَرٍ","يستزيد القوس في النّدفِ انحناءا",44,"ا",3,0]]}