{"poems":[[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107200","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77813","الكامل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31510","المتقارب"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66399","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205587","الرمل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119436","السريع"],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5387,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=53792",""],[402,"رؤية أربت على الرؤيا بما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53566&r=&rc=418",""]],"verses":[["كَأَصحابِ ذي القَرنَينِ حَيثُ تَبَوَّأوا","وَراءَ مَغيبِ الشَمسِ تِلكَ المَنازِلا",0,"ل",2,0],["كَأَصدَافِ هِندِبَّينِ زُبٍّ لِحاهُماَ","بِدارِينَ يَبتَاعانِ مِسكاً وَعَنَبَرا",1,"ر",2,0],["كَأَصدَافِ هِندِيَّين صُهبُ لِحاهُمُ","يَبيعُونُ في دارينَ مِسكاً وعَنبَرا",2,"ر",2,0],["كَاصْطِخَابٍ مِنْ وَطِيسٍ هَادِمٍ","لمْ يَصُنْ تاجاً وَلمْ يسْتَشْنِ جِذْرَا",3,"ر",2,0],["كأُصَيحابٍ أَناجِيبَ لَهُم","أَصبَحَ المَجدُ كما شاءُوهُ قِنّا",4,"ن",2,0],["كَأصْحُنٍ من لُجيْنٍ أشْحنَتْ ذَهَباً","لِتَصْطَفِينَا بِبَيِضاءٍ وَصَفرَاءِ",5,"ا",2,0],["كأصبع في خاتم","كعالم في عالم",6,"ا",3,0],["كَأَصحَمَ فَردٍ عَلى عانَةٍ","يُقاتِلُ عَن طُرَّتَيهِ الذُبابا",7,"ب",2,0],["كأصوله عند الإله مقربا","ما فكرتي في نظمها بأديبةٍ",8,"ه",1,0],["كاصبع في طبق أسودٍ","محنّية تلتقط الدرّا",9,"ر",2,0],["كاصفرار الشمس في ثوب الغروبْ","واصفرار العاج في ثوب القدمْ",10,"م",1,0],["كاصحن الكافور قد حشدت","وذر في أوجهها العنبر",11,"ر",1,0],["كأصحاب خير العالمين محمدٍ","وأتباعهم والصالحين ذوي الرشد",12,"د",1,0],["كأصابع الليل التي امتدت إلى","صدر الصباح وقد تألق بالمطر",13,"ر",1,0],["كاصطخاب من وطيس هادم","لم يصن تاجا ولم يستثن جذرا",14,"ر",2,0]]}