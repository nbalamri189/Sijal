{"poems":[[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[27,"أمسى خليطك قد أجد فراقا","https://www.aldiwan.net/poem5934.html","الكامل"],[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[72,"عرفت بخدام البكا أجفانه","https://www.aldiwan.net/poem20184.html","الكامل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[78,"أهلا بكم صحبتكم نحوي الديم","https://www.aldiwan.net/poem14185.html","البسيط"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[45,"حثثنا سيرنا لما مررنا","https://www.aldiwan.net/poem65619.html","الوافر"],[28,"ولو لقيت الذي تكنى بكنيته","https://www.aldiwan.net/poem5222.html","البسيط"],[61,"اليوم يعذب ورد فيه تكدير","https://www.aldiwan.net/poem51300.html","البسيط"],[61,"هذه الشمس أوشكت أن تغيبا","https://www.aldiwan.net/poem51805.html","الخفيف"],[2,"لقد لحقت بأولى الخيل تحملني","https://www.aldiwan.net/poem25026.html","البسيط"],[66,"حي الرفاق وطف بكأس الراح","https://www.aldiwan.net/poem38496.html","الكامل"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[81,"حث الكؤوس ولا تطع من لاما","https://www.aldiwan.net/poem61485.html","الكامل"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[52,"ردت علي اللوم ظلامة","https://www.aldiwan.net/poem26606.html","السريع"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[48,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[48,"وقهوة عتقت في دير شماس","https://www.aldiwan.net/poem63421.html","الطويل"],[46,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""]],"verses":[["حَثَوْنَ على العراقِ تُرابَ نَجْدٍ","فَلا ألْقَتْ مَراسِيها بِوِرْدِ",0,"د",1,0],["حَثَثْتَ رِكَابَ الْعَزْمِ فِي خَيْرِ وِجْهَةٍ","أُتِيحَ بِهَا الإسْلاَمُ بَرْدَ اعْتِلاَلِهِ",1,"ل",2,0],["حُثَّ الكؤوسَ وهاتِنيها قَهْوَةً","تَنْفي الهُمومَ وتَجْلِبُ الأفْراحا",2,"ح",2,0],["حَثَّ الحُداةُ بِهِم وَراءَ حُمولِهِم","بُزلاً تَجاسَرُ لَم يَكُنَّ حِقاقا",3,"ق",2,0],["حثَّت لوشك النوى عيساً تحبّ سرًى","لكنها للأسى بين الحشا تضع",4,"ع",1,0],["حثّ التفرُّق دمعه فتشكَّلت","أشكاله وتلوَّنت ألوانه",5,"ن",2,0],["حَثّوا المَطِيَّ فَوَلَّتنا مَناكِبُها","وَفي الخُدورِ إِذا باغَمتَها الصُوَرُ",6,"ر",1,0],["حَثّوا الرَواحِلَ مَشدوداً حَقائِبُها","مِن شَأنِ رُكبانِها الحاجاتُ وَالسَرَعُ",7,"ع",1,0],["حَثَثنَ الجِمالَ فَاِصمَعَدَّت لِشَأنِها","وَمَدَّ أَزِمّاتِ الجِمالِ ذَميلُها",8,"ل",3,0],["حَثّوا الجِمالَ وَقالوا إِنَّ مَشرَبَكُم","وادي المِياهِ وَأَحساءٌ بِهِ بُرُدُ",9,"د",1,0],["حُثّوا المَطيَّ وَلَو لَيلا بمجهلةٍ","فَلَن تَضِلّوا وَمن بِشري لَكُم عَلَمُ",10,"م",1,0],["حُثَّ البَريدَ مَشارِقاً وَمَغارِباً","وَاِركَب جَناحَ البَرقِ في الأَرجاءِ",11,"ا",2,0],["حَثيثينَ مِن فَوقِ الجِبالِ وَتَحتِها","كَما اِنهارَ طَودٌ أَو كَما اِنهالَ مِذنَبُ",12,"ب",1,0],["حَثَت كُلُّ أَرضٍ تُربَةً في غُبارِهِ","فَهُنَّ عَلَيهِ كَالطَرائِقِ في البُردِ",13,"د",1,0],["حَثّوا النَوى بِحَداةٍ ما لَها وَطَنٌ","إِلّا النَوى وَجِمالٍ ما لَها عُقُلُ",14,"ل",1,0],["حَثَثنا سَيرَنا لَمّا مَرَرنا","عَلى اِبنِ أَبي الشَوارِبِ وَالسِبالِ",15,"ل",1,1],["حَثياً بِأَيديهِمِ المَعروفَ نائِلُهُ","تَفتُرُ عَنهُ الصَبا وَالجودُ ما فَتَرا",16,"ر",2,0],["حث الكؤوس فذا يوم به قصر","وما به عن تمام الحسن تقصير",17,"ر",1,0],["حَثَّ غَرْبٌ من المدامعِ غرباً","حينَ رامت تلك الشموسُ الغُروبا",18,"ب",2,0],["حَثَّ عَلَيها بِصَكٍّ لَيسَ مُؤتَلِياً","بَل هو لِأَمثالِها مِن مِثلِهِ يَدَعُ",19,"ع",1,0],["حُثَّ الكُؤوسَ إِلى جُسومٍ أَصبَحَت","فيها المُدامِ شَريكَةَ الأَرواحِ",20,"ح",1,0],["حَثَّت فَأَعطَت في السَرى خَيرَ عَطاً","إِن حَنَّ يَوماً غَيرُها إِلى عَطَن",21,"ن",1,0],["حثوتُ بأوجِهِ الآدابِ تبراً","ولم أشرعْ لشارعِها جناحي",22,"ح",2,0],["حثيثُ الكرِّ يستبقُ المنايا","إذا الفَرِقُ الهَيُوبُ مشَى الوئيدا",23,"د",2,0],["حُثُّوا المَطِيَّ فإنّه مُتَرقِّبٌ","وأرى جوانحكم تَرِفُّ أُواما",24,"م",2,0],["حُثَّ الكُؤوسَ وَلا تُطِع مَن لاما","فَالمُزنُ قَد سَقَتِ الرِياضَ رِهاما",25,"م",2,1],["حَثَّها مِن كُؤوسِهِ رانِياتٍ","عَن فُتورٍ في لَحظِهِ خُمّارُ",26,"ر",1,0],["حُثّوا مَطايا الجِدِّ تُرقِل بِكُم","ناجينَ بَينَ الناسِ أَو مُعذَرين",27,"ن",1,0],["حَثَّ الفِراقُ بَواكِرَ الأَحداجِ","وَسِجالُ يَومَ نَأوا بِكَتمٍ ساجي",28,"ج",2,1],["حَثَثنا مُغَنّينا عَلى شُربِ كَأسِهِ","فَتُدرِكُهُ كَأسٌ وَفي كَفِّهِ أَخرى",29,"ا",1,0],["حَثَّ المُدامَ وَغَنّانا عَلى طَرَبٍ","الآنَ طابَ الهَوى يا مَعشَرَ الناسِ",30,"س",1,0],["حَثَت يَبسَ الرَغامِ عَلى رَضيعٍ","يَدٌ بِأَبيهِ آدَمَ أَلحَقَتهُ",31,"ت",2,0],["حثثتُك مراتٍ عَلى أَن تفرَّ بي","وَلكن لسوء الحظ ما كنت تسمع",32,"ع",1,0],["حثا ثَرى نَجْدٍ على بَغْداذِ","فعُمْدَةُ الدينِ بِها مَلاذي",33,"ذ",2,0],["حثيثٌ سيرُهنَّ إلى ضعيفٍ","تلقَّفُه وعنْ أشِرٍ بِطاء",34,"ا",2,0]]}