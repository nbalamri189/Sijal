,"الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72491","الهزج"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72558","الرمل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105174","الكامل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216344",""],[4767,"كوكب عمان","https://www.poetsgate.com/ViewPoem.aspx?id=204152",""],[4778,"شهباء","https://www.poetsgate.com/ViewPoem.aspx?id=188205",""],[4816,"افلاطون","https://www.poetsgate.com/ViewPoem.aspx?id=8487",""],[4875,"فحوى الكتابه","https://www.poetsgate.com/ViewPoem.aspx?id=133839",""],[5105,"لولا السُّرَى في ذِمامِ الصارمِ الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=135326",""],[5145,"حثوا المطي فهذا الصبح قد جشرا","https://www.poetsgate.com/ViewPoem.aspx?id=108048",""],[5259,"نرجس باكرتُ منه روضةَ","https://www.poetsgate.com/ViewPoem.aspx?id=186804",""],[5277,"رحيلٌ بلا إياب","https://www.poetsgate.com/ViewPoem.aspx?id=200947",""],[5318,"هيَ حُسنيان","https://www.poetsgate.com/ViewPoem.aspx?id=215393",""],[5431,"التعريف الحقيقي للحثالة","https://www.poetsgate.com/ViewPoem.aspx?id=183036",""],[5431,"لقد وضعت على النص النقاطُ:","https://www.poetsgate.com/ViewPoem.aspx?id=200590",""],[4444,"يا مسعدي بسيحان فديتكما","https://www.poetsgate.com/ViewPoem.aspx?id=85452",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[6117,"سِفْر ُالأحَادِيْثِ وَنَبْعُ الْفَضَائِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=182797",""],[6259,"أرى دهري تفضل واستفادا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59368&r=&rc=16",""]],"verses":[["حَثَوْنَ على العراقِ تُرابَ نَجْدٍ","فَلا ألْقَتْ مَراسِيها بِوِرْدِ",0,"د",1,0],["حَثَثْتَ رِكَابَ الْعَزْمِ فِي خَيْرِ وِجْهَةٍ","أُتِيحَ بِهَا الإسْلاَمُ بَرْدَ اعْتِلاَلِهِ",1,"ل",2,0],["حُثَّ الكؤوسَ وهاتِنيها قَهْوَةً","تَنْفي الهُمومَ وتَجْلِبُ الأفْراحا",2,"ح",2,0],["حَثَّ الحُداةُ بِهِم وَراءَ حُمولِهِم","بُزلاً تَجاسَرُ لَم يَكُنَّ حِقاقا",3,"ق",2,0],["حثَّت لوشك النوى عيساً تحبّ سرًى","لكنها للأسى بين الحشا تضع",4,"ع",1,0],["حثّ التفرُّق دمعه فتشكَّلت","أشكاله وتلوَّنت ألوانه",5,"ن",2,0],["حَثّوا المَطِيَّ فَوَلَّتنا مَناكِبُها","وَفي الخُدورِ إِذا باغَمتَها الصُوَرُ",6,"ر",1,0],["حَثّوا الرَواحِلَ مَشدوداً حَقائِبُها","مِن شَأنِ رُكبانِها الحاجاتُ وَالسَرَعُ",7,"ع",1,0],["حَثَثنَ الجِمالَ فَاِصمَعَدَّت لِشَأنِها","وَمَدَّ أَزِمّاتِ الجِمالِ ذَميلُها",8,"ل",3,0],["حَثّوا الجِمالَ وَقالوا إِنَّ مَشرَبَكُم","وادي المِياهِ وَأَحساءٌ بِهِ بُرُدُ",9,"د",1,0],["حُثّوا المَطيَّ وَلَو لَيلا بمجهلةٍ","فَلَن تَضِلّوا وَمن بِشري لَكُم عَلَمُ",10,"م",1,0],["حُثَّ البَريدَ مَشارِقاً وَمَغارِباً","وَاِركَب جَناحَ البَرقِ في الأَرجاءِ",11,"ا",2,0],["حَثيثينَ مِن فَوقِ الجِبالِ وَتَحتِها","كَما اِنهارَ طَودٌ أَو كَما اِنهالَ مِذنَبُ",12,"ب",1,0],["حَثَت كُلُّ أَرضٍ تُربَةً في غُبارِهِ","فَهُنَّ عَلَيهِ كَالطَرائِقِ في البُردِ",13,"د",1,0],["حَثّوا النَوى بِحَداةٍ ما لَها وَطَنٌ","إِلّا النَوى وَجِمالٍ ما لَها عُقُلُ",14,"ل",1,0],["حَثَثنا سَيرَنا لَمّا مَرَرنا","عَلى اِبنِ أَبي الشَوارِبِ وَالسِبالِ",15,"ل",1,1],["حَثياً بِأَيديهِمِ المَعروفَ نائِلُهُ","تَفتُرُ عَنهُ الصَبا وَالجودُ ما فَتَرا",16,"ر",2,0],["حث الكؤوس فذا يوم به قصر","وما به عن تمام الحسن تقصير",17,"ر",1,0],["حَثَّ غَرْبٌ من المدامعِ غرباً","حينَ رامت تلك الشموسُ الغُروبا",18,"ب",2,0],["حَثَّ عَلَيها بِصَكٍّ لَيسَ مُؤتَلِياً","بَل هو لِأَمثالِها مِن مِثلِهِ يَدَعُ",19,"ع",1,0],["حُثَّ الكُؤوسَ إِلى جُسومٍ أَصبَحَت","فيها المُدامِ شَريكَةَ الأَرواحِ",20,"ح",1,0],["حَثَّت فَأَعطَت في السَرى خَيرَ عَطاً","إِن حَنَّ يَوماً غَيرُها إِلى عَطَن",21,"ن",1,0],["حثوتُ بأوجِهِ الآدابِ تبراً","ولم أشرعْ لشارعِها جناحي",22,"ح",2,0],["حثيثُ الكرِّ يستبقُ المنايا","إذا الفَرِقُ الهَيُوبُ مشَى الوئيدا",23,"د",2,0],["حُثُّوا المَطِيَّ فإنّه مُتَرقِّبٌ","وأرى جوانحكم تَرِفُّ أُواما",24,"م",2,0],["حُثَّ الكُؤوسَ وَلا تُطِع مَن لاما","فَالمُزنُ قَد سَقَتِ الرِياضَ رِهاما",25,"م",2,1],["حَثَّها مِن كُؤوسِهِ رانِياتٍ","عَن فُتورٍ في لَحظِهِ خُمّارُ",26,"ر",1,0],["حُثّوا مَطايا الجِدِّ تُرقِل بِكُم","ناجينَ بَينَ الناسِ أَو مُعذَرين",27,"ن",1,0],["حَثَّ الفِراقُ بَواكِرَ الأَحداجِ","وَسِجالُ يَومَ نَأوا بِكَتمٍ ساجي",28,"ج",2,1],["حَثَثنا مُغَنّينا عَلى شُربِ كَأسِهِ","فَتُدرِكُهُ كَأسٌ وَفي كَفِّهِ أَخرى",29,"ا",1,0],["حَثَّ المُدامَ وَغَنّانا عَلى طَرَبٍ","الآنَ طابَ الهَوى يا مَعشَرَ الناسِ",30,"س",1,0],["حَثَت يَبسَ الرَغامِ عَلى رَضيعٍ","يَدٌ بِأَبيهِ آدَمَ أَلحَقَتهُ",31,"ت",2,0],["حثثتُك مراتٍ عَلى أَن تفرَّ بي","وَلكن لسوء الحظ ما كنت تسمع",32,"ع",1,0],["حثا ثَرى نَجْدٍ على بَغْداذِ","فعُمْدَةُ الدينِ بِها مَلاذي",33,"ذ",2,0],["حثيثٌ سيرُهنَّ إلى ضعيفٍ","تلقَّفُه وعنْ أشِرٍ بِطاء",34,"ا",2,0],["حثّي خطاك فشاهق يرقى وموحشة تجاب","ألبحر معدنك الأصيل وشوق روحك والحباب",35,"ب",1,0],["حثثنا الركب اقلقه الضجيج","لغاب حلها الاسد المهيج",36,"ج",1,1],["حثا شرابهما في ظل حسان","رياه ريحاننا في مجلس الحان",37,"ن",1,1],["حثاً شرابهما حتى رأيتهما","لا يسمعان وإن كانا يقولان",37,"ن",1,0],["حُثُّوا مطاياكم فكم غاية","قد بُلَغَتْ بالأينق الظُّلّعِ",38,"ع",1,0],["حثا الترابُ عليها من يود بقى","نعا لها الترب عيناه وحاجبهُ",39,"ب",2,0],["حثوا فوقَ خديهِ الترابَ وأرسلوا","عليهِ سحاباتِ الدموعِ السواكبِ",40,"ب",1,0],["حَثَوا عليهِ تُراباً أبيضاً يَقَقَاً","من نُورِهِ وَهُمُ صرعى فما فاقوا",41,"ق",3,0],["حَثُّوا المَطَايا للشآ","مِ بِكلّ طاهِرة حَيِيّه",42,"ي",2,0],["حُثَّا علّي الكأسَ وحدي إنّني","ممّن غدا وَلَهَا عليه ذِمامُ",43,"م",1,0],["حثثنا إليك العيس حتى تبوأت","لديك مقيلا ناضر الروض مبهجا",44,"ج",2,0],["حَثَّ كُؤُوسَ الراحِ","وَاِشرَب عَلى الأَقاحي",45,"ح",2,1],["حَث في روض وجنتيه","لنا خَمرُ ثَغرِهِ",46,"ر",2,0],["حَثَّتهُمُ آجالُهُم فَسَقَتهُمُ","بِسُطاكَ كاساتِ المَنونِ حِثاثا",47,"ث",2,0],["حثثنا المطايا قاصدين زيارة ال","حبيب رسول اللَه شمس الظهائر",48,"ر",1,0],["حَثَّها قارِحٌ فَجالَت جَميعاً","خَشيَةً مِن مُكَدَّمٍ جَوّالِ",49,"ل",1,0],["حَثَّ الرِكابُ بِنا وَالقَومُ قَد وَقَفوا","دونَ الحِمى وَعَلى ضالِ الغَضا عَكَفوا",50,"ف",3,1],["حَثَثْنا إلى ذاك الجناب قلائصاً","لها سائق منها إليه وقائد",51,"د",1,0],["حَثثْتُ على عنيف السَّير نُوقي","وقدَّمت الطَّريق على الرفيق",52,"ق",1,1],["حثّت ما طلع الهلال بمثلهِ","وثناءُ مجدك بالمكارم يعبقُ",53,"ق",1,0],["حُثّها نحو النفيسِ المفدّى","واطّرِحْ كلَّ الأنامِ اطّراحا",54,"ح",2,0],["حثّوا المطايا واستقلّوا فاغتدى","صبري لتعذيبِ الغرام قليلا",55,"ل",2,0],["حَثُّ الكريم على التفضّلِ بدعةٌ","والاعتماد عليك فانظر ما ترى",56,"ر",2,1],["حُثَّ الكريم على النَّدى وتَقاضَه","بالوعدِ وابْعثْهُ على الإنْجازِ",57,"ز",1,1],["حُثّ الكُؤوسَ فَكُلَّ همَ","م بِالمُدامَةِ يَذهَبُ",58,"ب",1,1],["حَثُّوا الْمَطِيَّ إلى رُبَا صَنْعا","صَدَعَ الْقُلوبَ فِراقُنا صَدْعا",59,"ع",2,1],["حُثُّوا المطيَّ بنا إلى بَلَدٍ","فاقَتْ وراقَتْ للوَرَى طَبْعا",59,"ع",2,0],["حثّوا لفُرقتك الجمالَ وما","حثّوا النّوى إلّا عَلى رغمي",60,"م",2,0],["حثَّنا الشوقُ في مهامه لومٍ","لديار الهوى وبهجة يومٍ",61,"م",1,0],["حثت العيس للحمى فأزيلت","بالتقى عن ظهورها الأوقار",62,"ر",1,0],["حُثِّ الرَكاب فقدْ بدت سَلْعُ لنَا","وانِزلْ يمينَ الشعبِ من وادي القرى",63,"ر",2,0],["حثثت قلوصي طالباً رسم دارها","وللبين بي ما بالرسوم الدوائر",64,"ر",1,0],["حثوا المطي غداة عن","له بذات الرمل مألف",65,"ف",1,0],["حثوا المطي وأدوا في رمالهم","فما يقوم لهم سرح ولا كور",66,"ر",1,0],["حُثَّ الكؤوسَ فإن هذا وقتها","وَصِلِ الرياضِ فإنّ ذا إِبّانها",67,"ن",3,0],["حثَّ الزئيرَ إليك إلا أنه","لما رآك زأرتَ عن عُفرٍ ثغا",68,"غ",2,0],["حَثَّتْ سُقاهُ الغَمامِ أكؤُسَها","فالأَرضُ سَكرَى وكيفَ لا تَسكَر",69,"ر",1,0],["حَثُّوا نجائب تلوى من خَزائمها","جَذبَ الأزمّة في أزرَارها الحلقُ",70,"ق",1,0],["حِثلَينِ رَضَّا رُفَاضَ البَيضِ عن زَغَبٍ","وُرقٌ أَسافلُها بيضٌ أَعاليها",71,"ي",3,0],["حثثت للكرخ عيسا","أبغي المحل النفيسا",72,"ا",1,1],["حثت ركائبها وحاشا أنها","لسوى مناهله تحت ركابها",73,"ب",3,0],["حُثَّ المَدامَةَ وَالنَسيمُ عَليلُ","وَالظلُّ خَفَّاقُ الرواق ظَليلُ",74,"ل",1,1],["حث أسطوله وأقبل يسعى","في جبال على جبال جواري",75,"ر",2,0],["حثوا الركاب وأخلفوك الموعدا","وغدوا بقلبك في الحمول مقيدا",76,"د",2,1],["حثت لهم عيسى وأملت ردفهم","وللنجح في الدارين أعددت ودهم",77,"م",1,0],["حثّه الشوق للمسي إلى نح","وٍ قباً هائما وقاد زمامه",78,"م",2,0],["حثَّ المطي فهذه نجد","بلغ المدى وتزايد الوجد",79,"د",1,1],["حَثُّوا الركاب فلم أجد لي حيلةً","لرجوعهم إلّا انسكاب دموعي",80,"ع",2,1],["حث الكؤوس فأثرت بمن ادعى","أن الكواكب ما لها تأثير",81,"ر",1,0],["حثوا المطي وساروا","ويلاه شط المزار",82,"ر",1,1],["حثها وهي سموحُ","فغبوق وصبوح",83,"ح",1,1],["حثّوا المَطيّ وَأَرخوا مِن أزمّتها","قَبلَ المماتِ وَقضّوا ما تقضّونا",84,"ن",2,0],["حثها الحادي بكوراً وحداً","خلفها فانطلقت ثم انطلق",85,"ق",1,0],["حَثُّوا إليك كرامَ العِيسِ واحتملوا","من النُّضارِ كما يَهْوى بأكياسِ",86,"س",1,0],["حُثالة ناس لا حياء ولا تقى","وليس لهم أصل ولا عرق مفخر",87,"ر",1,0],["حثوا مطايا الهدى طول الحياة ومذ","بانوا رزحن وضاع الرحل والقَتد",88,"د",1,0],["حُثّوا المَطِيَّ فَغِبَّ الجِدِّ مَشرَبُكُم","مِن بحرِ جودٍ خَضمِّ الماءِ زَخّارِ",89,"ر",1,0],["حَثُّوا المطيَّ على الوجى لما سجا","بحر الدُّجى فانْصَعْنَ فيه رسيما",90,"م",2,0],["حثها شوقها إليك وإن بان","لها عن سواك صَدٌّ ونفره",91,"ر",2,0],["حَثّوا المَطايا وَقادوا الجُردَ وَاِحتَشَدوا","حَولَ المَدينَةِ في بَأسٍ وَفي بُهَمِ",92,"م",1,0],["حثثنا العيسَ نحوكِ فهي تطوي","بنا في اليوم ما يُطوى بخمس",93,"س",1,1],["حثثنا العيس فهي وميض برقٍ","تألّف للنواظر ثمَّ غابا",94,"ب",2,1],["حثّ الركاب إلى هذا الجناب فقد","ضلّوا فما تنفع الآيات والنّذر",95,"ر",1,0],["حثّي المطي وشدّي في دوائرها","هذا أوان انقضاء الشدّ من زِيَمِ",96,"م",1,0],["حثثنا لناديه الركاب وَكلنا","له نظر نحو المَكارِم طامح",97,"ح",1,0],["حثُّ الكريم على التفضُّل بدعة","يا خير من يمشي على وجه الثرى",98,"ر",2,1],["حثوا القرائح في المفي","د وعجلوا نيل المرام",99,"م",1,0],["حُثَّ لِلإِتقانِ دَوماً هِمَّةً","وَاِحتَذِر كَيدَ العَدوِّ الأَرقَمِ",100,"م",1,0],["حثنا في سبيلها أمل نر","جوه فيها كنهلة في آل",101,"ل",1,0],["حث الحكيم على رشد فناوأه","باغى الضلال ومن يؤذى بارشاد",102,"د",1,0],["حث الخطى للعز واسلك نهجه","ولو أن نهج العز كان جحيما",103,"م",2,0],["حثثت ركاب السرى في المسير","مجداً بحيث يشاء الهوى",104,"و",2,0],["حثا التربَ لما أرصدوا لخروجه","عليهمْ وهُمْ لا يُبصرون رواحا",105,"ح",2,0],["حُثْحِث