{"poems":[[55,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[55,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[57,"هجرتنا يا ملول","https://www.aldiwan.net/poem26183.html","المجتث"],[84,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[95,"وقفت على القبر الذي أنت نازله","https://www.aldiwan.net/poem11122.html","الطويل"],[49,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[74,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[53,"تعالت قرون أبي يوسف","https://www.aldiwan.net/poem66420.html","المتقارب"],[64,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[30,"إني وإن كانت تميم عمارتي","https://www.aldiwan.net/poem5528.html","الطويل"],[78,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55047","الكامل"],[84,"في رثاء الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=1468",""],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[30,"إني وإن كانت تميم عمارتي","https://www.poetsgate.com/ViewPoem.aspx?id=21964",""],[53,"تعالتْ قرونُ أبي يوسفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30599",""],[88,"لمِصرَ أم لرُبُوعِ الشَّأمِ تَنْتَسِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13088&r=&rc=43",""],[119,"عتبت على الدنيا عتاب لبيب","https://www.aldiwan.net/poem41243.html","عموديه"],[164,"لمثل رؤيتك الأبصار تدخر","https://www.aldiwan.net/poem59117.html","البسيط"],[202,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[207,"مهلا بني عمنا ظلامتنا","https://www.aldiwan.net/poem68156.html","المنسرح"],[261,"يا صاح فاشرب واسقني","https://www.aldiwan.net/poem48446.html","مجزوء الرجز"],[261,"يا غصة الموت افغري","https://www.aldiwan.net/poem48553.html","مجزوء الرجز"],[275,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[285,"ألا هكذا تستهل البدور","https://www.aldiwan.net/poem60773.html","الطويل"],[287,"أطيب شيء في الزمان مشربا","https://www.aldiwan.net/poem32882.html","الرجز"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[376,"لمثلها كانت الأيام تنتظر","https://www.aldiwan.net/poem57382.html","البسيط"],[445,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[445,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[457,"أيا سيدا حاز المكارم واللطفا","https://www.aldiwan.net/poem13846.html","الطويل"],[458,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[466,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[466,"واني وان لم يدرك الشعر وصفه","https://www.aldiwan.net/poem15589.html","الطويل"],[466,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[466,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[466,"وإني وإن لم تنصفوا في حكومتي","https://www.aldiwan.net/poem16404.html","الطويل"],[471,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[484,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[520,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101502","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70923","البسيط"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178047","الوافر"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6787","البسيط"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82698","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77919","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108624","الطويل"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48248","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102114","المجتث"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89557","البسيط"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142778","السريع"],[2250,"","https://poetry.dctabudhabi.ae/diwan/poem/145175","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93662","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137033",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129983","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83232","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65972","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126065","المتقارب"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3250,"","https://poetry.dctabudhabi.ae/diwan/poem/144405","الوافر"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121383","المنسرح"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112648","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112674","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140025","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46983","الكامل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108400",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108329",""],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21381","الطويل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130435","الطويل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103058","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73099","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136485",""],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89582","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120458","الوافر"],[4702,"\" ميسم عوج \"","https://www.poetsgate.com/ViewPoem.aspx?id=155048",""],[4914,"يا شامخا فوق هام المجد موضعه","https://www.poetsgate.com/ViewPoem.aspx?id=170942",""],[5064,"رقصة هدب على إيقاع رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199160",""],[5239,"عرس بجزين يا مستعبد النجف","https://www.poetsgate.com/ViewPoem.aspx?id=190941",""],[5277,"أحدَ عشرَ حسرةً","https://www.poetsgate.com/ViewPoem.aspx?id=200167",""],[5397,"لعمر العلى ما كل من طلب الفخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157968",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5688,"سنترككم هنالك تصدؤون","https://www.poetsgate.com/ViewPoem.aspx?id=200821",""],[5751,"إيقاعُ اُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=214769",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6152,"زايد بن سلطان آل نهيان حكيم العرب","https://www.poetsgate.com/ViewPoem.aspx?id=203346",""]],"verses":[["لِمِثلِكَ تُحرِزُ المالَ اللَيالي","وَأَولى الناسِ بِالعُدمِ اللَئيمُ",0,"م",1,0],["لِمِثلِها أَدعو بَناتِ السُرى","تَخلِطُ أَعناقاً بِأَعضادِ",1,"د",1,0],["لِمِثلِ هَذا لَعَمري","يَرجو الخَليلَ الخَليلُ",2,"ل",1,0],["لِمثلِ هَذا يَبكِي القَلبُ مِن كَمَدٍ","إِن كانَ في القَلبِ إِسلامٌ وَإِيمانُ",3,"ن",1,0],["لِمِثْلِ أَمِينٍ يَجْزَعُ النَّاسُ إِذْ مَضَى","اَوَاخِرُهُ مَحْمُودَةٌ وَأَوَائِلُهْ",4,"ل",2,0],["لِمِثلِها يَستَعِدُّ البَأسُ وَالكَرَمُ","وَفي نَظائِرِها تُستَنفَذُ النِعَمُ",5,"م",1,1],["لمثل هواك تجنح كل نفسٍ","وتسفح كلّ ناظرة بعين",6,"ن",1,0],["لمثل ذلك في الهيجاء من عملٍ","أنحى على الأدواتِ القينُ واجْتَنَحا",7,"ح",2,0],["لمثلك يستبقي العفيف سؤاله","ويقنى الحياءَ الحرُّ والرمح شارع",8,"ع",1,0],["لمثل قرونك يا كِسْرَوي","يُ شَيَّدَتِ الفُرْسُ إيوانها",9,"ن",3,0],["لمثلِ معاليك تعنُو الرِّقابْ","ومن جودك الغَمْرِ يحيا السحابُ",10,"ب",1,1],["لَمُثنٍ عَلى أَفناءِ بَكرِ اِبنِ وائِلٍ","ثَناءً يُوافي رَكبَهُم في المَواسِمِ",11,"م",1,0],["لمثلِ هذا بكَتْ عيني ولا","للمنزلِ القفرِ وللأرْسُمِ",12,"م",1,0],["لِمِثْلِ ذَا الْيَوْمِ كَانَ الْمُلْكُ يَنْتَظِرُ","فَاسْعَدْ بِهَا دَوْلَةً عُنْوانُها الظَّفَرُ",13,"ر",1,1],["لِمِثالِكَ المَرْفوعِ ظِلُّ مَهَابَةٍ","يُجْلَى بِهِ وَضَحُ المُحَيَّا المُشرِقِ",14,"ق",1,0],["لمثلِ هذا يذوبُ القلبُ مِن كمَدٍ","إن كانَ في القلب إسلامٌ وإيمانُ",15,"ن",1,0],["لمثلِ الذي تَبْغي من الحقِّ قادَها","إلى الموتِ ، لم تسألْ به السَّهْلَ الصَّعبْا",16,"ب",2,0],["لَمُثْنٍ على أفْنَاءِ بَكْرِ بنِ وَائلٍ","ثَنَاءً يُوافي رَكْبَهُمْ في المَوَاسِمِ",17,"م",1,0],["لمثل قرونك يا كِسْرَوي","شَيَّدَتِ الفُرْسُ إيوانها",18,"ن",3,0],["لَمْ ثَبْدُ بارِقَة ٌ في أفْقِ مُنْتَجَعٍ","إلاّ وكان لها بالشامِ مُرتَقِبُ",19,"ب",1,0],["لمثلي باعيان النبيين اسوة","وما ضر نور الشمس جحد مريب",20,"ب",1,0],["لمثل رؤيتك الأبصار تدخر","لولا التملى بها لم يحمد النظر",21,"ر",1,1],["لمثلك من رزءٍ جليلٍ تَضَرَّجَتْ","خدودٌ بأسرابِ الدموعِ تَخَدَّد",22,"د",1,0],["لِمِثلِكُم نَحمِلُ السُيوفَ وَلا","تَغمِزُ أَحسابُنا مِنَ الرِقَقِ",23,"ق",1,0],["لمثل ذا الوقت انتفي","أو احلقي أو نوري",24,"ر",2,0],["لمثل ذا اليوم يقا","ل من خري فقد بري",25,"ر",2,0],["لمثلِ هذا بكى الأحرارُ وانفلقَت","قلوبُهم تحتَ ضربِ الهمّ والنَّكد",26,"د",1,0],["لِمِثْلِكَ حَقّاً وَإِنْ قَلَّ عَنْكَ","يُرْشَّحُ هذا الْمَحَلُّ الْخَطِيرُ",27,"ر",1,0],["لِمِثلِها يَنتَخِبُ الأُسقُفُ مِن","خَيرِ كُرومِ صيدنايا العِنَبا",28,"ب",2,0],["لِمثلك في خيرِ البريّة أسوة","يحنّ لها طبعاً ويَسمو لَها كسبا",29,"ب",2,0],["لمثلِها كانَت الأَيامُ تَنتَظِرُ","فَما لِداهِيةٍ من بَعدِها خَطَرُ",30,"ر",1,1],["لِمِثْلِها أنشَأَ الرَّحْمنُ منكَ لَنا","نورَيْنِ عَظَّمَ من قَدْرَيْهِما عِظَمُكْ",31,"ك",1,0],["لمثلِها كنتَ يَا منصورُ والِدَهُ","ومِثلَها سَيُريكَ اللهُ فِي وَلَدِهْ",32,"د",2,0],["لمثلك يعنو القول نظَّمْت عقده","وقرطتُ آذان الحسان به شَنْفا",33,"ف",2,0],["لمثلك أيها الخل المرجى","إذا الأحداث فاتنا لياس",34,"س",1,0],["لمثنٍ على الجاوانِ من أهل عنترٍ","ثناءً إذا كتمتهُ فهو ذائع",35,"ع",1,0],["لمُثْنٍ عليه ما استطعتُ وانما","لكل امرءٍ ساعٍ قُواهُ وجُهْدهُ",36,"د",2,0],["لمُثْنٍ على نشوانَ بالمجد موجفٍ","إِلى الحمد فَرَّاعٍ لكُلِّ عَلاءِ",37,"ا",2,0],["لَمُثْنٍ على غَيْرانَ منْ آلِ هاشِمٍ","لهُ أرَجٌ منْ عَبْقَةِ المجْدِ رادِعُ",38,"ع",1,0],["لَمُثْنٍ عليكُمْ في مَغيبٍ ومَشْهَدٍ","وأيْنَ ثَناءٌ خالِدٌ كَثَنائي",39,"ا",2,0],["لَمُثنٍ عَلى لَيلى ثَناءً بَريدُهُ","قَوافٍ بِأَفواهِ الرِجالِ تَطيبُ",40,"ب",1,0],["لمثل هذا ترى الأحرار عاملة","فامسك بأذيالها تعتز واعتلق",41,"ق",1,0],["لمثلك والمثل الذي لك معوز","يباح من الذكر الجميل مصون",42,"ن",1,0],["لمثلك زلَّت عقولُ الرِّجالِ","ولكنَّنِي عَاشِقٌ عَاقِل",43,"ل",1,0],["لمثواي في دار الأَحبَّةِ ساعةً","اعزُّ لدى قلبي من العرش والملكِ",44,"ك",1,1],["لمثلِها سُلَّ سيفَ العزم مُمْتطيا","حرفاً تغشْمَرُ في سهلٍ وأوعار",45,"ر",1,0],["لمثلك يا عوين فدتك نفسي","نجا من كربةٍ إن كان ناجي",46,"ي",1,1],["لِمِثلِ هَذا فَكُن مُعِدّا","ما قَد أُعِدَّ الهُداةُ مِنّا",47,"ن",2,0],["لمثّلتُه لك حَتّى تَراهُ","فتعلَمَ أَني اِمرؤ شاكِرُ",48,"ر",1,0],["لمثل هَذا نطرب","وَأَنتَ منا تعجب",49,"ب",1,1],["لمثلك يهدى الحمد يا ناثر العدى","عن الراية الحمراء بالصعدة السمرا",50,"ر",2,0],["لِمَثوى البَغايا أَسلَمتني غَوايَتي","لحريَّةٍ أَنكى لِنَفسي من الأَسرِ",51,"ر",1,0],["لمثلهنَّ لوَ اَنَّ الكأس يجلبُها","والكيسَ سُقْنا لهنَّ الكأس والكيسا",52,"س",2,0],["لمثلى خالياً فيقول هذا","بمحض الفضل قد فاق السماكا",53,"ك",2,0],["لمثلنا ولتبعنا","ألا يا أحمد",54,"د",1,0],["لِمِثلِ ذا الخَطبِ فَلتَبكِ العُيونُ دما","فَما يُماثِلُهُ خطبٌ وَإِن عَظُما",55,"م",2,1],["لمثلِها كنتُ أصونُ الدُّموعْ","فلْتذرِفِ العينُ ويَنْأَ الهُجوعْ",56,"ع",1,1],["لمثلهما من منزه ونزاهة","يجرر ذيل الذيل كل موفق",57,"ق",1,0],["لِمثلك إن أَهدى المَدايح أَهلها","فَأَهل وإلا فَهِيَ زُور وَزُخرف",58,"ف",1,0],["لمثل هؤا الباسل المقدام","يحق مثل ذلك الانعام",59,"م",1,1],["لمثلكَ تنقاد الجيوشُ الجحافلُ","وتذخرُ أبناءُ القنا والقنابِلُ",60,"ل",1,1],["لِمِثلِ ذا عُظَماءُ الدَهرِ قَد خُلِقوا","كَالشَمسِ في نورِها فَضلٌ عَلى الزَهرِ",61,"ر",1,0],["لمثلك إِذ أيقنت أنك ناصري","بلا طلب مني إليك فواشك",62,"ك",1,0],["لمثلته لك حتى تراه","لتعلم انى امرؤ شاكر",63,"ر",1,0],["لمثل ذلك فليعمل ذوو عمل","فارغب الى اللّه في التوفيق للخدم",64,"م",1,0],["لمثلي أن يميل إلى اكتساب","بغير السمهرية والنصول",65,"ل",1,0],["لمثلِ ذا اليوم يا معذّبني","كانت تُرَجِّيكِ أختُكِ الشمسُ",66,"س",1,1],["لِمِثلهِم فلتَلطِم الصدورُ","ولَيكثُرِ العَويلُ والزفير",67,"ر",1,0],["لمِثلِهم فلتندُبِ النوادِب","ولتُنشرِ الشعورُ والذوائبُِ",67,"ب",1,0],["لمِثلِهِم وما لَهُم مثيلُ","فليَكثرِ الصراخُ والعَويلُ",68,"ل",1,0],["لمِثلهم فليحزنِ المقامُ","ومكةٌ والمشعرُ الحَرامُ",68,"م",1,0],["لمثواهُ بالحمراء كان انزعاجهم","فللّه رأيٌ في نزول بمنزل",69,"ل",1,0],["لِمِثَالِ نَعْلِ المُصْطَفَى أُصْفِي الهَوَى","وَأَرَى السُلُوَّ خَطِيئَةً لَنْ تُغْفَرا",70,"ر",2,1],["لمثله كن عبدا تنال كل المنى","وتبلغ منتهى الأسرار العالية",71,"ه",1,0],["لمثلك أوشي برد شعري وأنسج","لأنك فينا قدوة ونموذجُ",72,"ج",1,1],["لمثلك يحلو المجد يا بطل العصرِ","فانت بذا الانعام اولى من البدرِ",73,"ر",1,1],["لِمَثنى المِئينَ والأَساري لأَهلِها","وَحَملِ الضياعِ لا يَرى ذاكَ مُتعِبا",74,"ب",2,0],["لمثن ولكن لا يقابل هجركم","سوى الهجر لا عتب يمض ولا هجر",75,"ر",1,0],["لمثله في علة الحكم لان","يثبت فيه حكمَهُ بلا وَهَن",76,"ن",1,0],["لمثلك أيها الملك المفدّى","أطاع الناس من سام وحام",77,"م",1,0],["لمثل اليوم تدَّخرُ الدُّموع","وَتُحنَى فوقَ لوعتِها الضُّلوعُ",78,"ع",1,1],["لمثلك فلتُطل أبناء كسرى","نحيباً إذ قضيتَ اليوم نحبا",79,"ب",2,0],["لِمِثلِكِ عَبراتي لَمُهراقَةٌ أَسىً","لِمِثلِكِ تَجري لا لِعَمٍّ وَلا خالِ",80,"ل",1,0],["لمثلك يا مولى العلا أنظم الشعرا","فوصفك قد حاكى الدراري والدرا",81,"ر",2,1],["لمثل اميرنا تهدى التهاني","وتسعد في مدائحه البنان",82,"ن",1,1],["لمثل هذا كل ما زاد يزداد","ميسم ونار الشعر عبرة وحيله",83,"ل",2,0],["لمثلك العفو لو مثلي أساء به","والعفو عند كرام الناس موضعه",84,"ع",2,0],["لِمثلِ عينَيكِ تحلُو رقصَةُ الشِّعرِ","فلتضبطِي ا