{"poems":[[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[55,"هجرتنا يا ملول","https://www.aldiwan.net/poem26183.html","المجتث"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[93,"وقفت على القبر الذي أنت نازله","https://www.aldiwan.net/poem11122.html","الطويل"],[47,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[72,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[51,"تعالت قرون أبي يوسف","https://www.aldiwan.net/poem66420.html","المتقارب"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[28,"إني وإن كانت تميم عمارتي","https://www.aldiwan.net/poem5528.html","الطويل"],[76,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55047","الكامل"],[82,"في رثاء الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=1468",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[28,"إني وإن كانت تميم عمارتي","https://www.poetsgate.com/ViewPoem.aspx?id=21964",""],[51,"تعالتْ قرونُ أبي يوسفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30599",""],[86,"لمِصرَ أم لرُبُوعِ الشَّأمِ تَنْتَسِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13088&r=&rc=43",""],[116,"عتبت على الدنيا عتاب لبيب","https://www.aldiwan.net/poem41243.html","عموديه"],[161,"لمثل رؤيتك الأبصار تدخر","https://www.aldiwan.net/poem59117.html","البسيط"],[199,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[204,"مهلا بني عمنا ظلامتنا","https://www.aldiwan.net/poem68156.html","المنسرح"],[257,"يا صاح فاشرب واسقني","https://www.aldiwan.net/poem48446.html","مجزوء الرجز"],[257,"يا غصة الموت افغري","https://www.aldiwan.net/poem48553.html","مجزوء الرجز"],[271,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[281,"ألا هكذا تستهل البدور","https://www.aldiwan.net/poem60773.html","الطويل"],[283,"أطيب شيء في الزمان مشربا","https://www.aldiwan.net/poem32882.html","الرجز"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[372,"لمثلها كانت الأيام تنتظر","https://www.aldiwan.net/poem57382.html","البسيط"],[440,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[440,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[453,"أيا سيدا حاز المكارم واللطفا","https://www.aldiwan.net/poem13846.html","الطويل"],[454,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[462,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[462,"واني وان لم يدرك الشعر وصفه","https://www.aldiwan.net/poem15589.html","الطويل"],[462,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[462,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[462,"وإني وإن لم تنصفوا في حكومتي","https://www.aldiwan.net/poem16404.html","الطويل"],[467,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[480,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[516,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["لِمِثلِكَ تُحرِزُ المالَ اللَيالي","وَأَولى الناسِ بِالعُدمِ اللَئيمُ",0,"م",1,0],["لِمِثلِها أَدعو بَناتِ السُرى","تَخلِطُ أَعناقاً بِأَعضادِ",1,"د",1,0],["لِمِثلِ هَذا لَعَمري","يَرجو الخَليلَ الخَليلُ",2,"ل",1,0],["لِمثلِ هَذا يَبكِي القَلبُ مِن كَمَدٍ","إِن كانَ في القَلبِ إِسلامٌ وَإِيمانُ",3,"ن",1,0],["لِمِثْلِ أَمِينٍ يَجْزَعُ النَّاسُ إِذْ مَضَى","اَوَاخِرُهُ مَحْمُودَةٌ وَأَوَائِلُهْ",4,"ل",2,0],["لِمِثلِها يَستَعِدُّ البَأسُ وَالكَرَمُ","وَفي نَظائِرِها تُستَنفَذُ النِعَمُ",5,"م",1,1],["لمثل هواك تجنح كل نفسٍ","وتسفح كلّ ناظرة بعين",6,"ن",1,0],["لمثل ذلك في الهيجاء من عملٍ","أنحى على الأدواتِ القينُ واجْتَنَحا",7,"ح",2,0],["لمثلك يستبقي العفيف سؤاله","ويقنى الحياءَ الحرُّ والرمح شارع",8,"ع",1,0],["لمثل قرونك يا كِسْرَوي","يُ شَيَّدَتِ الفُرْسُ إيوانها",9,"ن",3,0],["لمثلِ معاليك تعنُو الرِّقابْ","ومن جودك الغَمْرِ يحيا السحابُ",10,"ب",1,1],["لَمُثنٍ عَلى أَفناءِ بَكرِ اِبنِ وائِلٍ","ثَناءً يُوافي رَكبَهُم في المَواسِمِ",11,"م",1,0],["لمثلِ هذا بكَتْ عيني ولا","للمنزلِ القفرِ وللأرْسُمِ",12,"م",1,0],["لِمِثْلِ ذَا الْيَوْمِ كَانَ الْمُلْكُ يَنْتَظِرُ","فَاسْعَدْ بِهَا دَوْلَةً عُنْوانُها الظَّفَرُ",13,"ر",1,1],["لِمِثالِكَ المَرْفوعِ ظِلُّ مَهَابَةٍ","يُجْلَى بِهِ وَضَحُ المُحَيَّا المُشرِقِ",14,"ق",1,0],["لمثلِ هذا يذوبُ القلبُ مِن كمَدٍ","إن كانَ في القلب إسلامٌ وإيمانُ",15,"ن",1,0],["لمثلِ الذي تَبْغي من الحقِّ قادَها","إلى الموتِ ، لم تسألْ به السَّهْلَ الصَّعبْا",16,"ب",2,0],["لَمُثْنٍ على أفْنَاءِ بَكْرِ بنِ وَائلٍ","ثَنَاءً يُوافي رَكْبَهُمْ في المَوَاسِمِ",17,"م",1,0],["لمثل قرونك يا كِسْرَوي","شَيَّدَتِ الفُرْسُ إيوانها",18,"ن",3,0],["لَمْ ثَبْدُ بارِقَة ٌ في أفْقِ مُنْتَجَعٍ","إلاّ وكان لها بالشامِ مُرتَقِبُ",19,"ب",1,0],["لمثلي باعيان النبيين اسوة","وما ضر نور الشمس جحد مريب",20,"ب",1,0],["لمثل رؤيتك الأبصار تدخر","لولا التملى بها لم يحمد النظر",21,"ر",1,1],["لمثلك من رزءٍ جليلٍ تَضَرَّجَتْ","خدودٌ بأسرابِ الدموعِ تَخَدَّد",22,"د",1,0],["لِمِثلِكُم نَحمِلُ السُيوفَ وَلا","تَغمِزُ أَحسابُنا مِنَ الرِقَقِ",23,"ق",1,0],["لمثل ذا الوقت انتفي","أو احلقي أو نوري",24,"ر",2,0],["لمثل ذا اليوم يقا","ل من خري فقد بري",25,"ر",2,0],["لمثلِ هذا بكى الأحرارُ وانفلقَت","قلوبُهم تحتَ ضربِ الهمّ والنَّكد",26,"د",1,0],["لِمِثْلِكَ حَقّاً وَإِنْ قَلَّ عَنْكَ","يُرْشَّحُ هذا الْمَحَلُّ الْخَطِيرُ",27,"ر",1,0],["لِمِثلِها يَنتَخِبُ الأُسقُفُ مِن","خَيرِ كُرومِ صيدنايا العِنَبا",28,"ب",2,0],["لِمثلك في خيرِ البريّة أسوة","يحنّ لها طبعاً ويَسمو لَها كسبا",29,"ب",2,0],["لمثلِها كانَت الأَيامُ تَنتَظِرُ","فَما لِداهِيةٍ من بَعدِها خَطَرُ",30,"ر",1,1],["لِمِثْلِها أنشَأَ الرَّحْمنُ منكَ لَنا","نورَيْنِ عَظَّمَ من قَدْرَيْهِما عِظَمُكْ",31,"ك",1,0],["لمثلِها كنتَ يَا منصورُ والِدَهُ","ومِثلَها سَيُريكَ اللهُ فِي وَلَدِهْ",32,"د",2,0],["لمثلك يعنو القول نظَّمْت عقده","وقرطتُ آذان الحسان به شَنْفا",33,"ف",2,0],["لمثلك أيها الخل المرجى","إذا الأحداث فاتنا لياس",34,"س",1,0],["لمثنٍ على الجاوانِ من أهل عنترٍ","ثناءً إذا كتمتهُ فهو ذائع",35,"ع",1,0],["لمُثْنٍ عليه ما استطعتُ وانما","لكل امرءٍ ساعٍ قُواهُ وجُهْدهُ",36,"د",2,0],["لمُثْنٍ على نشوانَ بالمجد موجفٍ","إِلى الحمد فَرَّاعٍ لكُلِّ عَلاءِ",37,"ا",2,0],["لَمُثْنٍ على غَيْرانَ منْ آلِ هاشِمٍ","لهُ أرَجٌ منْ عَبْقَةِ المجْدِ رادِعُ",38,"ع",1,0],["لَمُثْنٍ عليكُمْ في مَغيبٍ ومَشْهَدٍ","وأيْنَ ثَناءٌ خالِدٌ كَثَنائي",39,"ا",2,0],["لَمُثنٍ عَلى لَيلى ثَناءً بَريدُهُ","قَوافٍ بِأَفواهِ الرِجالِ تَطيبُ",40,"ب",1,0],["لمثل هذا ترى الأحرار عاملة","فامسك بأذيالها تعتز واعتلق",41,"ق",1,0],["لمثلك والمثل الذي لك معوز","يباح من الذكر الجميل مصون",42,"ن",1,0],["لمثلك زلَّت عقولُ الرِّجالِ","ولكنَّنِي عَاشِقٌ عَاقِل",43,"ل",1,0]]}