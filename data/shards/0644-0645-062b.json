{"poems":[[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[55,"هجرتنا يا ملول","https://www.aldiwan.net/poem26183.html","المجتث"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[93,"وقفت على القبر الذي أنت نازله","https://www.aldiwan.net/poem11122.html","الطويل"],[47,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[72,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[51,"تعالت قرون أبي يوسف","https://www.aldiwan.net/poem66420.html","المتقارب"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[28,"إني وإن كانت تميم عمارتي","https://www.aldiwan.net/poem5528.html","الطويل"],[76,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55047","الكامل"],[82,"في رثاء الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=1468",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[28,"إني وإن كانت تميم عمارتي","https://www.poetsgate.com/ViewPoem.aspx?id=21964",""],[51,"تعالتْ قرونُ أبي يوسفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30599",""],[86,"لمِصرَ أم لرُبُوعِ الشَّأمِ تَنْتَسِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13088&r=&rc=43",""]],"verses":[["لِمِثلِكَ تُحرِزُ المالَ اللَيالي","وَأَولى الناسِ بِالعُدمِ اللَئيمُ",0,"م",1,0],["لِمِثلِها أَدعو بَناتِ السُرى","تَخلِطُ أَعناقاً بِأَعضادِ",1,"د",1,0],["لِمِثلِ هَذا لَعَمري","يَرجو الخَليلَ الخَليلُ",2,"ل",1,0],["لِمثلِ هَذا يَبكِي القَلبُ مِن كَمَدٍ","إِن كانَ في القَلبِ إِسلامٌ وَإِيمانُ",3,"ن",1,0],["لِمِثْلِ أَمِينٍ يَجْزَعُ النَّاسُ إِذْ مَضَى","اَوَاخِرُهُ مَحْمُودَةٌ وَأَوَائِلُهْ",4,"ل",2,0],["لِمِثلِها يَستَعِدُّ البَأسُ وَالكَرَمُ","وَفي نَظائِرِها تُستَنفَذُ النِعَمُ",5,"م",1,1],["لمثل هواك تجنح كل نفسٍ","وتسفح كلّ ناظرة بعين",6,"ن",1,0],["لمثل ذلك في الهيجاء من عملٍ","أنحى على الأدواتِ القينُ واجْتَنَحا",7,"ح",2,0],["لمثلك يستبقي العفيف سؤاله","ويقنى الحياءَ الحرُّ والرمح شارع",8,"ع",1,0],["لمثل قرونك يا كِسْرَوي","يُ شَيَّدَتِ الفُرْسُ إيوانها",9,"ن",3,0],["لمثلِ معاليك تعنُو الرِّقابْ","ومن جودك الغَمْرِ يحيا السحابُ",10,"ب",1,1],["لَمُثنٍ عَلى أَفناءِ بَكرِ اِبنِ وائِلٍ","ثَناءً يُوافي رَكبَهُم في المَواسِمِ",11,"م",1,0],["لمثلِ هذا بكَتْ عيني ولا","للمنزلِ القفرِ وللأرْسُمِ",12,"م",1,0],["لِمِثْلِ ذَا الْيَوْمِ كَانَ الْمُلْكُ يَنْتَظِرُ","فَاسْعَدْ بِهَا دَوْلَةً عُنْوانُها الظَّفَرُ",13,"ر",1,1],["لِمِثالِكَ المَرْفوعِ ظِلُّ مَهَابَةٍ","يُجْلَى بِهِ وَضَحُ المُحَيَّا المُشرِقِ",14,"ق",1,0],["لمثلِ هذا يذوبُ القلبُ مِن كمَدٍ","إن كانَ في القلب إسلامٌ وإيمانُ",15,"ن",1,0],["لمثلِ الذي تَبْغي من الحقِّ قادَها","إلى الموتِ ، لم تسألْ به السَّهْلَ الصَّعبْا",16,"ب",2,0],["لَمُثْنٍ على أفْنَاءِ بَكْرِ بنِ وَائلٍ","ثَنَاءً يُوافي رَكْبَهُمْ في المَوَاسِمِ",17,"م",1,0],["لمثل قرونك يا كِسْرَوي","شَيَّدَتِ الفُرْسُ إيوانها",18,"ن",3,0],["لَمْ ثَبْدُ بارِقَة ٌ في أفْقِ مُنْتَجَعٍ","إلاّ وكان لها بالشامِ مُرتَقِبُ",19,"ب",1,0]]}