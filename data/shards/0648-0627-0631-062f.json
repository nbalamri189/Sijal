w.poetsgate.com/ViewPoem.aspx?id=166746",""],[5189,"سهمٌ أصاب القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197542",""],[5213,"هوى قمر الامامة للافول","https://www.poetsgate.com/ViewPoem.aspx?id=170520",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5463,"أحسن أعيش العمر من دون خلان","https://www.poetsgate.com/ViewPoem.aspx?id=26413",""],[5539,"خيالاتي","https://www.poetsgate.com/ViewPoem.aspx?id=192482",""],[5539,"حلوم الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=192576",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5612,"مَنْ زَرَعَ حَصَد","https://www.poetsgate.com/ViewPoem.aspx?id=204401",""],[5667,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=214915",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5845,"أفقْ هديتَ منَ التبرجِ والكمدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198482",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5977,"أخبرته من أول لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213282",""],[6068,"سؤال وجواب (التأخر)-08-","https://www.poetsgate.com/ViewPoem.aspx?id=177482",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""]],"verses":[["وارِدٍ ماءَ عُيونٍ","مُصطَلٍ نارَ قُلوبِ",0,"ب",1,0],["وأرُدُّ طارِقَةَ اللّيالي إنْ عَرَتْ","بعزائِمي وهيَ الصوارِمُ تُنْتَضى",1,"ض",2,0],["وأرُدُّ عَبْرتِيَ الجَموحَ لأنّها","بِمَقيلِ سِرِّكَ في الجَوانِحِ تُخْبِرُ",2,"ر",1,0],["وارِداتٍ وَضاجِراتٍ إِلى أَن","حَسَرَ المُدلَهِمُّ ضَوءَ البَشيرِ",3,"ر",1,0],["وَأرَدْنَا امْتِطَاءَهَا فَاتَّخَذْنَا","مِنْ شِرَاكِ الأَدِيم فِيهَا عِنَانَا",4,"ن",2,0],["وَاِردُد عَلى مُلكِ القَريضِ جَمالَهُ","تَصنَع بِصاحِبِكَ القَديمِ جَميلا",5,"ل",2,0],["وارِداتٍ صادِراتٍ","كَقَطاً مُختَلِفَه",6,"ف",2,0],["وَأَردَفَتِ الذِراعُ لَها بِعَينٍ","سَجومِ الماءِ فَاِنسَحَلَ اِنسِحالا",7,"ل",2,0],["وَأَردَفَ مُزنَةُ المِلحَينِ وَبلاً","سَريعاً صَوبُهُ سَرِبَ العَزالي",8,"ل",2,0],["وَأَردى ذُؤاباً في بُيوتِ عُتَيبَةٍ","بَنوهُ وَأَهلوهُ بِشَدوِ القَصائِدِ",9,"د",1,0],["وارِداتٌ بِكُلِّ أُنسٍ وَبِرٍّ","وافِداتٌ بِكُلِّ حُسنٍ وَطيبِ",10,"ب",1,0],["وارددْ مقالَ عداةٍ لا اعتبارَ به","إنَّ الرَّديء على أهليهِ مردود",11,"د",1,0],["وَأَرَدتُ أَنطِقُ بِالجَوا","بِ وَلَم يَكُن وَقتُ الجَوابِ",12,"ب",1,0],["وَأرَدتُمُ تَضييقَ صَدرٍ لَم يَضِق","وَالسُمرُ في ثُغَر النحورِ تُحَطَّمُ",13,"م",1,0],["وارِدَةٍ دَسكَرَةً","صادِرَةٍ عَن دَسكَرَه",14,"ر",2,0],["وَأَردِيَةٌ خُضرٌ وَمُلكٌ مُطاعَةٌ","وَمَركوزَةٌ سُمرٌ وَمُقرَبَةٌ جُردُ",15,"د",1,0],["وأرُدُّ فيكَ النُّصْحَ عن","علمٍ بأنْ صَدَقَ النصيحُ",16,"ح",1,0],["وَأَرَدتُ هِجرانَ الحَبيبِ فَلَم أَجِد","كَبِداً تُشَيِّعُني عَلى الهِجرانِ",17,"ن",1,0],["وَأَرَدتُ إِبقاءَ المَوَدَّةِ بَينَنا","فَرَأَيتُ صُحبَتَكُم دَوامَ بُعادي",18,"د",2,0],["وأردُّهُم عنْ خطةٍ","أُلِفَتْ فألقتْ في الخطا",19,"ط",2,0],["وَاِردُد تَحِيَّةَ بادي العَهدِ مُبتَدِياً","عاطاكَ مِن عِلقِ صِدقٍ كَفَّ إِجلالِ",20,"ل",1,0],["وارْدُدْ على الوَحْيِ المُنزَّلِ حُكمَهُ","فَلأَنتَ ربُّ الوَحْي والأحكامِ",21,"م",1,0],["وَأَردَفَ حَسّانُ في مائِحٍ","مَتى هَبَطوا مُخصِباً أَجدَبا",22,"ب",2,0],["وَاِردُد إِلى الأُمِّ شَبحاً طالَ مَعهَدُها","بِضَمِّهِ وَهِيَ لا تُرجى لِتَربيتِ",23,"ت",1,0],["وَأَردِيَةٍ بيضاً تَبَدَّلَ أَهلُها","بِحُكمِكَ رَبَّ الناسِ أَردِيَةٍ خُضرا",24,"ر",2,0],["وَأَرَدتُموني أَن أَكونَ مُدَلِّساً","هَيهاتَ غَيري آثَرَ التَدليسا",25,"س",2,0],["وَاِردُد عَصاكَ عَنِ السَوداءِ ماهِنَةً","وَاِرفِق بِعَبدِكَ في المِصطافِ وَالقَرَسِ",26,"س",1,0],["وأرَدْتُ وِرْدَ الوَصْلِ مِن قَمَرٍ","فَصَدَرْتُ عنه كَوارِدِ الآل",27,"ل",1,0],["وأردى أنوشروان كسرى بصرفه","كسيرا ولم يترك لقيصر من قصر",28,"ر",1,0],["وأردى السلاح لأردى الأنام","وأجوده ينصر الأجودا",29,"د",2,0],["وأردت قبل وسائل ال","بنيان تشييد القصور",30,"ر",1,0],["وأردتُها تَصِف الحياة رقيقةً","وجليلةً وتُجيدها إتقانا",31,"ن",2,0],["وَأرْدى ذُؤاباً في بُيُوتِ عُتَيْبَة","ٍ، أبوهُ وأهلوهُ º بشدوِ القصائدِ",32,"د",1,0],["وأردت أن أقضي جوي وصبابة","لولا مواعيد الغزال ومطله",33,"ل",2,0],["وأردتُم غصبَ أنفسهم","فبثثتُم بينها المُقلا",34,"ل",2,0],["وَاِردُد إِلَيهِ تُراثَ والِدِهِ","تَثنِ إِلَيهِ الأَعِنَّةَ العَرَبُ",35,"ب",1,0],["وأرد عن نفسي النوال حمية","فيكم وفيٌّ وبي إليه ضرورة",36,"ه",1,0],["واردت أن تدري وأمري في يدي","إن الوفاء على النوى لي شيمة",36,"ه",1,0],["وأردت أن ترضى وربك لم يرد","فهجرته هجر الملول الشاني",37,"ن",2,0],["وَأَردى أَخانا اليَشكُريَّ وَفَرخَهُ","فَوارِسُ مِنّا غَيرُ ميلٍ وَلا عُزلِ",38,"ل",1,0],["وأَردن تسليماً وخِفْنَ مُراقباً","فبعثْنَه بإشارةِ الإبهام",39,"م",1,0],["وأَردى معادينا وقد رامَ ذُلَّنا","مُصوبُ سهمٍ بالبلاءِ سديدُ",40,"د",1,0],["واردده من همةٍ بختمكهُ","كأنه بالفلوس قد صفعا",41,"ع",2,0],["وأردتُ أن أُلهيهِ عن تَشرابها","حيناً وقد صَغُرَ الكبيرُ لدَيه",42,"ي",2,0],["وأرَدنَ تخليدَ المحاسنِ في الوَرى","فَغَرَسنَ جنّاتٍ وشِدنَ قُصورا",43,"ر",2,0],["وأرَدِّدُ الزَّفَرَاتِ أثْنَاءَ البُكَا","وَتَظَلُّ فَوْقَ أَراكِها تَتَرَنَّمُ",44,"م",1,0],["وَأَرَدتَ الثَمُها فَداَرَت وَاِستَوَت","فَتَبِعتُها مِن حَيثُ قَد دارَ الفَلَكُ",45,"ك",1,0],["وأَردَفَ ليَ النُّعْمى بِنُعْمىَ مُشافهاً","بها الأفضَلَ المَلْكَ الجَوادَ مُمَجِّدا",46,"د",2,0],["وأَردْتُ اختلاسَ قُبلةِ تَودي","عٍ وكُلٌّ في ناظري كان دُرّا",47,"ر",2,0],["وارِدُهُ المُستَأخِرُ اِستِعدادُهُ","إِذا اِستَقى مِن فَيضِ بَحرٍ مُزبِدِ",48,"د",1,0],["وأَردافٌ تُجاذِبُها خُصورٌ","وكَيفَ يُجاذِبُ السَّمِنَ النُّحولُ",49,"ل",1,0],["وارداً بالسرور في كل حول","في نعيم عن ربعكم لا يحول",50,"ل",1,0],["وأردت تأييد الضعيف بمثله","في الضعف يا مولاي عشت نبيلا",51,"ل",2,0],["وأردت إبلاغ النصيح وبعد ذا","فالحق قول مؤلف الأتحاف",52,"ف",1,0],["وَأَرَدتُ صَيد مَها الحِجاز وَلَم يُسا","عِدُكَ القَضاء فَصِرتَ بَعض صيودِهِ",53,"د",2,0],["وَأَرَدتَ إِصلاح الأُمور فَأُفسِدَت","فَنهضت حَتّى استَحكَمَت إِصلاحا",54,"ح",2,0],["واردٌ شرعة العلوم الَّتي ليس","عليها إذا وَرَدْتِّ مزاحم",55,"م",1,0],["وَأَردَينا اِبنَ حَسحاسٍ فَأَضحى","تَجولُ بِشِلوِهِ نُجُسُ الذِئابِ",56,"ب",1,0],["واردُدْ سهامك في صميمك إنما","تتناضلُ الأمثالُ والأكفاءُ",57,"ا",2,0],["وأردت تأخذ منك عيني حظّها","مأري ومختبرا بغير تسامح",58,"ح",1,0],["واردد رسولي يغاظ الحاسدون به","ضخمَ العيابِ عليه البشرُ والنورُ",59,"ر",1,0],["واردد لحاظَك عن زخارفها تفُزْ","إنّ البلاءَ موكَّلٌ بالناظرِ",60,"ر",1,0],["وارددْهُ عن عَجَلٍ كما عوَّدتَه","برواجعٍ من نعمتيك ردائدِ",61,"د",1,0],["وأردّ الحزمَ في أُفحوصِه","وهو هافٍ يتنزَّى للوثوبِ",62,"ب",1,0],["واردد لك الصدر من قولي على عجز","قف بالديار ولا تحفل بذي عذل",63,"ل",1,0],["وارِدُ الحَقِّ مُقيمٌ أبَداً","وكَذا الباطِلُ شيءٌ زاهقُ",64,"ق",1,0],["وَأَرَدنا لِتَغلِبٍ يَومَ سوءٍ","وَقَتَلنا مِنهُم قَبيلاً قَبيلا",65,"ل",2,0],["وأردتُمُ تَودِيعَنا من بَعدِما","أنِس الفُؤادُ بِكُم وزادَ تَحبُّبَا",66,"ب",2,0],["وأردتِ كتمانَ الهوى فكتَمْتُهُ","والدّمعُ يُبدي ما أُسرُّ وأُعلِنُ",67,"ن",1,0],["وأرَدْتَ الضَّرّاءَ لِي وكفى الل","هُ فأَوْلى مكانَ ضَرّي اِنتِفاعي",68,"ع",2,0],["وَأَردتُ حِفظَك في الضّرِيح وإنّما","صيّرتُ شِلْوَكَ في يَدَيْ مِضْيَاعِ",69,"ع",1,0],["وَأَردتمْ عزّاً عَزيزاً فما اِزددْ","تمْ بِذاك الصّنيع إلّا صَغارا",70,"ر",2,0],["وَأَردتُ أَن أَسلو وذا عَجَبٌ","لَو كانَ قَلبي بِالهَوى قَلبي",71,"ب",2,0],["وأردْنَا لنا لغَير مُرادِ","والزم البَابَ في حَيَاءِ وخَجْلهْ",72,"ل",2,0],["وأَردّ زيداً منهمُ","لمكانِه وأُعيد عَمْرا",73,"ر",2,0],["وأردى كميّاً من بني العلم باسلاً","حَكى هيبة بأسَ الليوث الضراغمِ",74,"م",1,0],["وارِداتٍ في سُوحِ عيسَى مُناها","عائِفاتٍ مِن بَعدِهِنَّ المياها",75,"ا",3,0],["وأردفها رابع تاليا","وأين من المنجد المتهم",76,"م",1,0],["وأردنا كما أردت سلاماً","بعد طول الإباء والإعراضِ",77,"ض",1,0],["وأردتمْ بأن يكون شباشاً","لتسفُّوا الدنيا فكان شباشا",78,"ش",2,0],["وارِداً عندك نِيلاً","وَفُراتاً وبَليخا",79,"خ",2,0],["واردى الردى منهم على الرغم ضيغما","سرى الخوف منه في قلوب الضياغم",80,"م",1,0],["واردَعنْ عن مسالكِ الغيّ قلبا","ولساناً وكُفَّ سمعا ولحظا",81