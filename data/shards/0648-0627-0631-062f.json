{"poems":[[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[63,"أذكى بقلبي لوعة إذ أومضا","https://www.aldiwan.net/poem46127.html","الكامل"],[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[6,"نحن من عامر بن ذبيان","https://www.aldiwan.net/poem379.html",""],[77,"قد قبلنا جيادك الدهم لما","https://www.aldiwan.net/poem36066.html","الخفيف"],[86,"يا صارما أنف الثواء بغمده","https://www.aldiwan.net/poem68865.html","الكامل"],[10,"مرهت عيني فعيني","https://www.aldiwan.net/poem21115.html","مجزوء الرمل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[47,"لمن جاهد الحساد أجر المجاهد","https://www.aldiwan.net/poem25321.html","الطويل"],[47,"وقفتني على الأسى والنحيب","https://www.aldiwan.net/poem25356.html","الخفيف"],[72,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[70,"كم ذا التصاغر والتصابي","https://www.aldiwan.net/poem43006.html","مجزوء الكامل"],[78,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[62,"يا من يسيء إلى الأنام","https://www.aldiwan.net/poem52460.html","مجزوء الكامل"],[45,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[66,"في طبعكم ملل مناف للوفا","https://www.aldiwan.net/poem38764.html","الكامل"],[69,"وأصدهم عن بدعة","https://www.aldiwan.net/poem29271.html","مجزوء الكامل"],[74,"وحلة من طراز النظم رائعة","https://www.aldiwan.net/poem13227.html","البسيط"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[46,"يؤدبك الدهر بالحادثات","https://www.aldiwan.net/poem22159.html","المتقارب"],[46,"إدفن أخا الملك دفن المرء مفتقرا","https://www.aldiwan.net/poem22208.html","البسيط"],[46,"أرى الأرض فيها دولة مضرية","https://www.aldiwan.net/poem22600.html","الطويل"],[46,"من لي بإمليسية أعني بها","https://www.aldiwan.net/poem22815.html","الكامل"],[46,"إرفع مجنك أو ضع للفتى قدر","https://www.aldiwan.net/poem22827.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[100,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[100,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[47,"لمنْ جاهدَ الحسادَ أجرُ المجاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=14768",""],[116,"قرب الحبيب وقد تباعد وصله","https://www.aldiwan.net/poem41972.html","الكامل"],[120,"أتراه يترك الغزلا","https://www.aldiwan.net/poem4341.html","المديد"],[144,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[161,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[161,"ظهرت عجائب قدرة الرحمن","https://www.aldiwan.net/poem59156.html","الكامل"],[170,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[230,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[242,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[257,"يا قمرا في تمامه طلعا","https://www.aldiwan.net/poem48481.html","المنسرح"],[271,"ما كان أظرف من نظرت إليه","https://www.aldiwan.net/poem35286.html","الكامل"],[271,"فقن الخمائل نضرة وعبيرا","https://www.aldiwan.net/poem35469.html","الكامل"],[276,"وحمامة ناحت فنحت إزاءها","https://www.aldiwan.net/poem25523.html","الكامل"],[321,"نامت وقد لعب الشراب بعطفها","https://www.aldiwan.net/poem61668.html","الكامل"],[349,"وقد كنت دهرا للمروءة ناشدا","https://www.aldiwan.net/poem20781.html","الطويل"],[365,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[365,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[372,"على ما حل بي وهم حلول","https://www.aldiwan.net/poem57232.html","مجزوء الوافر"],[404,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[404,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[404,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[407,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[407,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[417,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[429,"ألا لا تفخرن أسد علينا","https://www.aldiwan.net/poem767.html",""],[433,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[438,"بين العذيب فبانه المتناوح","https://www.aldiwan.net/poem2620.html","الكامل"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[459,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[480,"قف بالديار ولا تحفل بذي عذل","https://www.aldiwan.net/poem37619.html","البسيط"],[501,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[539,"زارت ضيوف النيل منا المغربا","https://www.aldiwan.net/poem48267.html","عموديه"],[552,"وحللت من قلبي وأنت بخيلة","https://www.aldiwan.net/poem47182.html","الكامل"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[552,"ماذا يضيرك هند من حبي","https://www.aldiwan.net/poem48051.html","أحذ الكامل"],[560,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["وارِدٍ ماءَ عُيونٍ","مُصطَلٍ نارَ قُلوبِ",0,"ب",1,0],["وأرُدُّ طارِقَةَ اللّيالي إنْ عَرَتْ","بعزائِمي وهيَ الصوارِمُ تُنْتَضى",1,"ض",2,0],["وأرُدُّ عَبْرتِيَ الجَموحَ لأنّها","بِمَقيلِ سِرِّكَ في الجَوانِحِ تُخْبِرُ",2,"ر",1,0],["وارِداتٍ وَضاجِراتٍ إِلى أَن","حَسَرَ المُدلَهِمُّ ضَوءَ البَشيرِ",3,"ر",1,0],["وَأرَدْنَا امْتِطَاءَهَا فَاتَّخَذْنَا","مِنْ شِرَاكِ الأَدِيم فِيهَا عِنَانَا",4,"ن",2,0],["وَاِردُد عَلى مُلكِ القَريضِ جَمالَهُ","تَصنَع بِصاحِبِكَ القَديمِ جَميلا",5,"ل",2,0],["وارِداتٍ صادِراتٍ","كَقَطاً مُختَلِفَه",6,"ف",2,0],["وَأَردَفَتِ الذِراعُ لَها بِعَينٍ","سَجومِ الماءِ فَاِنسَحَلَ اِنسِحالا",7,"ل",2,0],["وَأَردَفَ مُزنَةُ المِلحَينِ وَبلاً","سَريعاً صَوبُهُ سَرِبَ العَزالي",8,"ل",2,0],["وَأَردى ذُؤاباً في بُيوتِ عُتَيبَةٍ","بَنوهُ وَأَهلوهُ بِشَدوِ القَصائِدِ",9,"د",1,0],["وارِداتٌ بِكُلِّ أُنسٍ وَبِرٍّ","وافِداتٌ بِكُلِّ حُسنٍ وَطيبِ",10,"ب",1,0],["وارددْ مقالَ عداةٍ لا اعتبارَ به","إنَّ الرَّديء على أهليهِ مردود",11,"د",1,0],["وَأَرَدتُ أَنطِقُ بِالجَوا","بِ وَلَم يَكُن وَقتُ الجَوابِ",12,"ب",1,0],["وَأرَدتُمُ تَضييقَ صَدرٍ لَم يَضِق","وَالسُمرُ في ثُغَر النحورِ تُحَطَّمُ",13,"م",1,0],["وارِدَةٍ دَسكَرَةً","صادِرَةٍ عَن دَسكَرَه",14,"ر",2,0],["وَأَردِيَةٌ خُضرٌ وَمُلكٌ مُطاعَةٌ","وَمَركوزَةٌ سُمرٌ وَمُقرَبَةٌ جُردُ",15,"د",1,0],["وأرُدُّ فيكَ النُّصْحَ عن","علمٍ بأنْ صَدَقَ النصيحُ",16,"ح",1,0],["وَأَرَدتُ هِجرانَ الحَبيبِ فَلَم أَجِد","كَبِداً تُشَيِّعُني عَلى الهِجرانِ",17,"ن",1,0],["وَأَرَدتُ إِبقاءَ المَوَدَّةِ بَينَنا","فَرَأَيتُ صُحبَتَكُم دَوامَ بُعادي",18,"د",2,0],["وأردُّهُم عنْ خطةٍ","أُلِفَتْ فألقتْ في الخطا",19,"ط",2,0],["وَاِردُد تَحِيَّةَ بادي العَهدِ مُبتَدِياً","عاطاكَ مِن عِلقِ صِدقٍ كَفَّ إِجلالِ",20,"ل",1,0],["وارْدُدْ على الوَحْيِ المُنزَّلِ حُكمَهُ","فَلأَنتَ ربُّ الوَحْي والأحكامِ",21,"م",1,0],["وَأَردَفَ حَسّانُ في مائِحٍ","مَتى هَبَطوا مُخصِباً أَجدَبا",22,"ب",2,0],["وَاِردُد إِلى الأُمِّ شَبحاً طالَ مَعهَدُها","بِضَمِّهِ وَهِيَ لا تُرجى لِتَربيتِ",23,"ت",1,0],["وَأَردِيَةٍ بيضاً تَبَدَّلَ أَهلُها","بِحُكمِكَ رَبَّ الناسِ أَردِيَةٍ خُضرا",24,"ر",2,0],["وَأَرَدتُموني أَن أَكونَ مُدَلِّساً","هَيهاتَ غَيري آثَرَ التَدليسا",25,"س",2,0],["وَاِردُد عَصاكَ عَنِ السَوداءِ ماهِنَةً","وَاِرفِق بِعَبدِكَ في المِصطافِ وَالقَرَسِ",26,"س",1,0],["وأرَدْتُ وِرْدَ الوَصْلِ مِن قَمَرٍ","فَصَدَرْتُ عنه كَوارِدِ الآل",27,"ل",1,0],["وأردى أنوشروان كسرى بصرفه","كسيرا ولم يترك لقيصر من قصر",28,"ر",1,0],["وأردى السلاح لأردى الأنام","وأجوده ينصر الأجودا",29,"د",2,0],["وأردت قبل وسائل ال","بنيان تشييد القصور",30,"ر",1,0],["وأردتُها تَصِف الحياة رقيقةً","وجليلةً وتُجيدها إتقانا",31,"ن",2,0],["وَأرْدى ذُؤاباً في بُيُوتِ عُتَيْبَة","ٍ، أبوهُ وأهلوهُ º بشدوِ القصائدِ",32,"د",1,0],["وأردت أن أقضي جوي وصبابة","لولا مواعيد الغزال ومطله",33,"ل",2,0],["وأردتُم غصبَ أنفسهم","فبثثتُم بينها المُقلا",34,"ل",2,0],["وَاِردُد إِلَيهِ تُراثَ والِدِهِ","تَثنِ إِلَيهِ الأَعِنَّةَ العَرَبُ",35,"ب",1,0],["وأرد عن نفسي النوال حمية","فيكم وفيٌّ وبي إليه ضرورة",36,"ه",1,0],["واردت أن تدري وأمري في يدي","إن الوفاء على النوى لي شيمة",36,"ه",1,0],["وأردت أن ترضى وربك لم يرد","فهجرته هجر الملول الشاني",37,"ن",2,0],["وَأَردى أَخانا اليَشكُريَّ وَفَرخَهُ","فَوارِسُ مِنّا غَيرُ ميلٍ وَلا عُزلِ",38,"ل",1,0],["وأَردن تسليماً وخِفْنَ مُراقباً","فبعثْنَه بإشارةِ الإبهام",39,"م",1,0],["وأَردى معادينا وقد رامَ ذُلَّنا","مُصوبُ سهمٍ بالبلاءِ سديدُ",40,"د",1,0],["واردده من همةٍ بختمكهُ","كأنه بالفلوس قد صفعا",41,"ع",2,0],["وأردتُ أن أُلهيهِ عن تَشرابها","حيناً وقد صَغُرَ الكبيرُ لدَيه",42,"ي",2,0],["وأرَدنَ تخليدَ المحاسنِ في الوَرى","فَغَرَسنَ جنّاتٍ وشِدنَ قُصورا",43,"ر",2,0],["وأرَدِّدُ الزَّفَرَاتِ أثْنَاءَ البُكَا","وَتَظَلُّ فَوْقَ أَراكِها تَتَرَنَّمُ",44,"م",1,0],["وَأَرَدتَ الثَمُها فَداَرَت وَاِستَوَت","فَتَبِعتُها مِن حَيثُ قَد دارَ الفَلَكُ",45,"ك",1,0],["وأَردَفَ ليَ النُّعْمى بِنُعْمىَ مُشافهاً","بها الأفضَلَ المَلْكَ الجَوادَ مُمَجِّدا",46,"د",2,0],["وأَردْتُ اختلاسَ قُبلةِ تَودي","عٍ وكُلٌّ في ناظري كان دُرّا",47,"ر",2,0],["وارِدُهُ المُستَأخِرُ اِستِعدادُهُ","إِذا اِستَقى مِن فَيضِ بَحرٍ مُزبِدِ",48,"د",1,0],["وأَردافٌ تُجاذِبُها خُصورٌ","وكَيفَ يُجاذِبُ السَّمِنَ النُّحولُ",49,"ل",1,0],["وارداً بالسرور في كل حول","في نعيم عن ربعكم لا يحول",50,"ل",1,0],["وأردت تأييد الضعيف بمثله","في الضعف يا مولاي عشت نبيلا",51,"ل",2,0],["وأردت إبلاغ النصيح وبعد ذا","فالحق قول مؤلف الأتحاف",52,"ف",1,0],["وَأَرَدتُ صَيد مَها الحِجاز وَلَم يُسا","عِدُكَ القَضاء فَصِرتَ بَعض صيودِهِ",53,"د",2,0],["وَأَرَدتَ إِصلاح الأُمور فَأُفسِدَت","فَنهضت حَتّى استَحكَمَت إِصلاحا",54,"ح",2,0],["واردٌ شرعة العلوم الَّتي ليس","عليها إذا وَرَدْتِّ مزاحم",55,"م",1,0],["وَأَردَينا اِبنَ حَسحاسٍ فَأَضحى","تَجولُ بِشِلوِهِ نُجُسُ الذِئابِ",56,"ب",1,0],["واردُدْ سهامك في صميمك إنما","تتناضلُ الأمثالُ والأكفاءُ",57,"ا",2,0],["وأردت تأخذ منك عيني حظّها","مأري ومختبرا بغير تسامح",58,"ح",1,0],["واردد رسولي يغاظ الحاسدون به","ضخمَ العيابِ عليه البشرُ والنورُ",59,"ر",1,0],["واردد لحاظَك عن زخارفها تفُزْ","إنّ البلاءَ موكَّلٌ بالناظرِ",60,"ر",1,0],["وارددْهُ عن عَجَلٍ كما عوَّدتَه","برواجعٍ من نعمتيك ردائدِ",61,"د",1,0],["وأردّ الحزمَ في أُفحوصِه","وهو هافٍ يتنزَّى للوثوبِ",62,"ب",1,0],["واردد لك الصدر من قولي على عجز","قف بالديار ولا تحفل بذي عذل",63,"ل",1,0],["وارِدُ الحَقِّ مُقيمٌ أبَداً","وكَذا الباطِلُ شيءٌ زاهقُ",64,"ق",1,0],["وَأَرَدنا لِتَغلِبٍ يَومَ سوءٍ","وَقَتَلنا مِنهُم قَبيلاً قَبيلا",65,"ل",2,0],["وأردتُمُ تَودِيعَنا من بَعدِما","أنِس الفُؤادُ بِكُم وزادَ تَحبُّبَا",66,"ب",2,0],["وأردتِ كتمانَ الهوى فكتَمْتُهُ","والدّمعُ يُبدي ما أُسرُّ وأُعلِنُ",67,"ن",1,0],["وأرَدْتَ الضَّرّاءَ لِي وكفى الل","هُ فأَوْلى مكانَ ضَرّي اِنتِفاعي",68,"ع",2,0],["وَأَردتُ حِفظَك في الضّرِيح وإنّما","صيّرتُ شِلْوَكَ في يَدَيْ مِضْيَاعِ",69,"ع",1,0],["وَأَردتمْ عزّاً عَزيزاً فما اِزددْ","تمْ بِذاك الصّنيع إلّا صَغارا",70,"ر",2,0],["وَأَردتُ أَن أَسلو وذا عَجَبٌ","لَو كانَ قَلبي بِالهَوى قَلبي",71,"ب",2,0],["وأردْنَا لنا لغَير مُرادِ","والزم البَابَ في حَيَاءِ وخَجْلهْ",72,"ل",2,0],["وأَردّ زيداً منهمُ","لمكانِه وأُعيد عَمْرا",73,"ر",2,0]]}