5431,"شهوة الموت...","https://www.poetsgate.com/ViewPoem.aspx?id=204950",""],[5431,"الناس للناس...","https://www.poetsgate.com/ViewPoem.aspx?id=212034",""],[5458,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=72391",""],[5536,"وينك يا عمر؟!","https://www.poetsgate.com/ViewPoem.aspx?id=22595",""],[5561,"أمّةُ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192741",""],[5561,"الثائرون","https://www.poetsgate.com/ViewPoem.aspx?id=207881",""],[5563,"ما للهوى دكتور","https://www.poetsgate.com/ViewPoem.aspx?id=213090",""],[5587,"الحب سرار","https://www.poetsgate.com/ViewPoem.aspx?id=197803",""],[5720,"كياد *","https://www.poetsgate.com/ViewPoem.aspx?id=199081",""],[402,"حيوا الرئيسة إنصافا وتكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=35092",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5956,"لا ينبع النُّصْحُ إلا مِن مُحِبِّين","https://www.poetsgate.com/ViewPoem.aspx?id=183684",""],[5956,"هذي الحياة مشقة ومشاكلُ","https://www.poetsgate.com/ViewPoem.aspx?id=203755",""],[5991,"يا قانعاً بصفاته عن ذاته","https://www.poetsgate.com/ViewPoem.aspx?id=116387",""],[6056,"الغريق","https://www.poetsgate.com/ViewPoem.aspx?id=130377",""],[6056,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=130378",""],[6093,"كمن سيغسل جلد الماء بالماء","https://www.poetsgate.com/ViewPoem.aspx?id=208607",""],[5309,"من ينصر الله كان الله ناصره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573809",""],[2220,"إنَّ الإلهَ لهُ تجلٍّ في الصور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11470&r=&rc=344",""],[572,"تَعَطَّفْ علينا أيُّها الغُصُنُ الغَضُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9362&r=&rc=219",""]],"verses":[["مَن يُنتِجُ الآمالَ يَو","مَ تَعودُ بِاللَيّانِ حولا",0,"ل",2,0],["مَنْ يُنْكِرُ دعْوايَ فقُلْ عنّي لهُ","تكْفي امرأةُ العَزيزِ منْ عُشّاقِهْ",1,"ه",1,0],["مُنىً نِلتَها يا لابِسَ المَجدِ مُعلَماً","أَديناً وَدُنيا زادَكَ اللَهُ أَنعُما",2,"م",2,1],["مَنْ يَنْظِمُ المَعْنَى الدَّقِيقَ وَيُحْكِمُ المَبْ","نَى الرَّقِيقَ بِذَلِكَ الإِتْقَانِ",3,"ن",1,0],["مَنْ يَنْصُرُ الدينَ الْحَنِيفَ كَنَصْرِهِ","بِالرَّأْيِ يَنْفُذُ وَالْفِرنْدُ كَهَامُ",4,"م",1,0],["من ينسب النور للأفلاك قلت له","من أين أطلعتِ الأنوارُ لولاهُ",5,"ا",2,0],["من ينجد الصبر الجميل فإنه","بعد الأحبة قد أجَدَّ رحيلا",6,"ل",2,0],["من ينظرِ العَلم المرفوف يلقَه","في عزّ غير بني البلاد يرفرف",7,"ف",1,0],["مَن يَنأَ كِبرٌ بِهِ عَنّا وَأُبَّهَةٌ","نَحمَد أَبا جَعفَرٍ قُرباً وَإِنصافا",8,"ف",2,0],["منىً نلتها كانت لأنفسنا منى","تلفت تجد مصرا بأجمعها هنا",9,"ن",2,1],["مَن يَنهَ يُعصَ وَمَن يَحسِد وَلا وَأَبي","ما ضَرَّني مَن وَشى عِندي وَمَن حَسَدا",10,"د",2,0],["مَن يَنَمْ عن لَهْذَمٍ أو مِخْذَمِ","فَابْنُ بشرٍ ساهرٌ لم يَنَمِ",11,"م",1,1],["مَن يُنجِدُ الأُمّالَ بَعدَكِ أَنجَدَت","زَفَراتُهُم وَلِدَمعِهِم اِتِهامُ",12,"م",1,0],["مَنْ يَنْسى إِنْ ذُكِرَتْ مِصْرٌ وَنَهْضَتُهَا","عَوْنَ النَّجِيبَاتِ لِلصُّبَّابَةِ النُّجُبِ",13,"ب",1,0],["من ينصرِ اللّه لا جَوْرٌ يُجيدُ به","عن الطريق ولا جَهْدٌ بمفقود",14,"د",1,0],["مَنْ ينخُرُ السوسُ نخرًا في نواجِذِه","فلا دواءَ له أشْفَى من الدَّرَدِ",15,"د",1,0],["من ينجِّيه من بنينَ صغار","وبنات يسألنه الإِنفاقا؟",16,"ق",2,0],["من ينسينا مرارات العدى ؟","من يقوينا على حمل الصحابة ؟",17,"ب",2,0],["من ينصرِ اللّه لاجَوْرٌ يَحيدُ به","عن الطريق ولا جَهْدٌ بمفقود",18,"د",1,0],["من ينجد المكروب بعدك إن دعا","يا للحماة ولج في الإعوال",19,"ل",1,0],["منينا باكدار الليالي وصوفها","وصار الينا وغدها وعظيمها",20,"م",3,1],["مَن يَنثَني وَمِنَ النَجيعِ مُدامُهُ","طَرَباً وَما طَبَعَ القُيونُ قِيانُهُ",21,"ن",2,0],["من ينفقِ المالَ من خوفٍ لطالبهِ","فأَنتَ تنفقَهُ للأجر مُكتَسبا",22,"ب",2,0],["من ينقذ الشبلي إبن مرمّد ال","قمّين بين فسافس يتساعي",23,"ع",2,0],["مَن يَنتَضي الأَقلامَ صامِتَةً فَيُع","ديها لِساناً قاطِعاً وَمَقالا",24,"ل",2,0],["مَن يَنحَرُ الكومَ العِزارَ وَيَجعَلَ","السُفَراتِ مِنها لِلفِصالِ فِصالا",24,"ل",2,0],["من ينحو الغير ويشهده","في فعلٍ ما بالطرد فجي",25,"ج",2,0],["من ينصر الضعفاءَ يكسب حمدَهم","ولكم قويٍّ من ضعيفٍ يُنصر",26,"ر",1,0],["مُنِينَا بِهَا خَرْقَاءَ لاَ الْعَذْلُ تَرْعَوِي","إِلَيْهِ وَلاَ مَحْضَ النَّصِيحَة تَقْبَلُ",27,"ل",1,0],["مَنَّينَهُ فَكَذَبنَ إِذ مَنَّينَهُ","تِلكَ العُهودَ وَخُنَّهُ الميثاقا",28,"ق",2,0],["مَن يَنَم لَيلَهُ فَقَد أُعمِلُ اللَي","لَ وَذو البَثِّ ساهِرٌ مُستَهامُ",29,"م",1,0],["من يناؤيكم وَأَنتم أناس","لم تَزالوا عَلى النُجومِ جُلوسا",30,"س",2,0],["من يُنصِفُ المظلومَ مِنَّا إذَا","كنتَ وحاشَاك الذي يَظلِمُ",31,"م",1,0],["من ينثُرُ الدُّرَّ في نَثرِ الكتابَةِ إنْ","شاءً وينظمُهُ في النَّظمِ إن مَدَحَا",32,"ح",2,0],["من يُنيلُ النَّيْل من إحسانه","والعطاءُ الجمَّ والمال الجزيلا",33,"ل",2,0],["من ينجدني أو يطربني","بحديث الحب وإن يلم",34,"م",1,0],["من ينجدنا أو ينقذنا","من بازٍ كرجيّ اللقب",35,"ب",1,0],["من ينقض العهد يغلبه العدو ومن","لم يقض بالحق بين الناس يفتقر",36,"ر",1,0],["من ينقذُ الشعبَ والويلاتُ تَنكههُ","حينَ الزعاماُ تدعوها تمنعها",37,"ع",3,0],["مَن يَنتَخي بِكَ عازِفا ًعن كلِّ مَن","يُنْمَى إليكَ ، لأنَّ سَهْمَكَ أسْرَعُ؟",38,"ع",1,0],["من يَنْطَحِ الصَّخْرَةَ الصَّماءَ تَهْشِمُهُ","والصَّخْرُ بالنَّطْحِ يَوْماً لَيْسَ يَنْشَعِبُ",39,"ب",1,0],["مُنينا مِن فَجيعَتِهِ بِأَمرٍ","يَشيبُ لَهُ الغُلامَةُ وَالغُلامُ",40,"م",1,0],["من يُنيرُ العقولَ من بعدما كن","نَ هُموداً ويُنتجُ الأفهاما",41,"م",2,0],["مُنِيْنَا بِمَنْ نُغْضِي لَهُمْ عَنْ عِثَارِهِمْ","وَهِمَّتُهُمْ فِيْنَا التَّنَقُّصُ وَالغَضُّ",42,"ض",1,0],["مَنْ يُنيم الأَنَامَ أَمْناً ولاَ يُمسكُ","عِقد الوجودِ إِلاَّ وُجُوده",43,"د",2,0],["من ينتقل لجوار ربك يغتبط","ويجف من عينيه دمع ساكب",44,"ب",1,0],["مَن يَنسِبُ الزهراءَ أمَّا بَرَّةً","ومحمداً جداً وحيدرةً أبا",45,"ب",2,0],["من ين أبغضتَ عليَّ الرضى","وأحمدٌ قد كانَ يَرضاهُ",46,"ا",2,0],["من ينصب الليل ينل راحته","عند الصباح يحمد القوم السرى",47,"ر",2,0],["من ينقذني منه ومن ينقذه","افنى حرقا فيه ويفنى حرقا",48,"ق",2,0],["من ينسَ عهدهما يوماً فلستُ له","وإن تطاولتِ الأيامُ بالناسي",49,"س",2,0],["مَن يَنظمُ الأَكبادَ فيها طاعِناً","وَيُبيد فيها الأُسدَ مِن فُرسانِها",50,"ن",3,0],["من ينل منها ثلاثاً","ينس منهاج السبيل",51,"ل",1,0],["من ينجح الآمال من تزكو به","الأعمال من عهدت يداه عهادا",52,"د",2,0],["من يَنْأَ عن أمِةٍ حبلى فما ولدت","له وبعضٌ يرى للسيد الولدا",53,"د",2,0],["من ينصر الذوق أو من","يبقي على الإتزان",54,"ن",1,0],["من ينشد الوادي أغاريدَه","إن فرّ طيراه عن الضفتين",55,"ن",1,0],["من ينتهي منكم إِلى عرفاتها","لاحَت له برجالها الأعراف",56,"ف",1,0],["مَنْ ينادمْ على الحديثِ فقد أختْلَسُ","الكاسَ مِنْ حديثِ النديم",57,"م",1,0],["من ينابيع الطريق الاحمدي","ذاك واللَه طريق الرشد",58,"د",1,0],["من ينتظر نفحاته من يصيب","هذا ضمنت لمن يلازمه النظر",59,"ر",1,0],["مَن يَنصُرِ المَظلومَ قَلَّ نَصيرُهُ","إِن قيلَ قاضٍ يَستَبِدُّ وَيَظلِمُ",60,"م",1,1],["من ينتدبهم للكريهة ينتدب","منهم ضراغمة الأسود غضابا",61,"ب",2,0],["من ينظر المرء في ايامه يره","كالغصن يذبل بعد النضرة الغصن",62,"ن",1,0],["من ينثني بغوادي الطير بارحة","لم يثنِ عزميَ زجر الطير عيافا",63,"ف",2,0],["من يُنكر الرحمنَ جلّ جلاله","في خلقه يبصرْه في القرآن",64,"ن",1,0],["من ينسَ في صورة راقت مصورَها","فإنه جاحد للفن أجحده",65,"د",2,0],["من ينم فوق ناتئ منه يحسب","أنه فوق ناتئات السهام",66,"م",1,0],["مَن ينتصِر في النائباتِ تَنوبُهُ","يوماً بقائمِ سيفِهِ لم يُخذَلِ",67,"ل",1,0],["من ينكر الحسن في القرطاس مرتسما","ما الحسن في المال والألقاب والرتب",68,"ب",1,0],["مَن ينتسِبْ إلى العظيمِ عُظِّمَا","فالْجَأْ إلى اللّهِ تكُن مُكَرَّمَا",69,"م",2,1],["من ينيل الوفد في الجدب النوالا","وعلى أعتاب من تلقي الرحالا",70,"ل",2,1],["مَن يَنهَ عَن حُبِّ الجَمال مُقبَّحٌ","عِندي وَمِن جَهل الغَرام فَأَمْلَذ",71,"ذ",1,0],["من ينزوي عنه الخضمّ إذا جدا","وتقاصر الوسميّ عنه والولا",72,"ل",2,0],["من ينلها كل شهرٍ تره","يتمنى أن يكون اليوم عاما",73,"م",2,0],["مُنينا بأيامٍ كأن نجومَها","سهامٌ فيا وَيْلي من السهم بعدما",74,"م",2,0],["من ينشد الدنيا قصائد نائل","من بعد جودك مالها من منشد",75,"د",1,0],["من ينه عن خلق ويأتى مثله","فهو مريض برؤه في البأد",76,"د",1,0],["من ينصرُ الإسلامَ في غزواتهِ","فلقد أُصيبَ بركنهِ وظهيرِهِ",77,"ر",2,0],["مَن يَنصُر الحَقَّ فَلَيسَ يُغلَبُ","وَمَن أَبى فَما يُفيدُ الصَخَبُ",78,"ب",1,0],["من ينمه في تحر","يجده من خير معدن",79,"ن",1,0],["من ينكر الإحسان لا توله","ما عشت إحساناً فلا خير فيه",80,"ه",1,1],["من ينادم خديمه يتأذى","ويصير الخديم غير خديم",81,"م",1,0],["مَنْ يَنَمْ لِلْزَّمانِ والعَيْشُ رَغْدٌ","يَسْتَفقْ والحياةُ بُؤْسى كَنُودُ",82,"د",1,0],["من ينطحِ الشُّمَّ الجبالَ فراجعٌ","يُبْدِي العويلَ لدمِّهِ المهدار",83,"ر",1,0],["مَن ينسبُ الخمرُ إلى طرفهِ","وتَنتمي السوقُ إلى خدِّهِ",84,"د",2,0],["مَن يَنتَمي لِرِحابِكُم وَجَنابِكُم","يَغنَمُ أَخَيرَ خَلائِقِ الخَلّاقِ",85,"ق",1,0],["مني نصيحه تنفعك في زمانك","الاشعورك ..لاتبيعه وتشريه",86,"ي",2,0],["مَن يُنصِفُ الأحلامَ يا أُمَّنَا","مِن قادَةٍ لِلحزبِ, أو لِلفَصِيلْ",87,"ل",1,0],["مَن يُنفِقونَ العُمرَ شَوقًا إلى","أوطانِهِم.. يَدرُونَ ما يَفعَلُونْ",88,"ن",1,1],["من ينقذ الأجيالَ من طخيائها","يرمي الليالي بالضياء ويُزهِر",89,"ر",1,0],["من ينكرك وإنت الذي حيل مرغوب","من ينكرك وإنتا رسول الحبايب",90,"ب",1,0],["من ينابيع صفاء أغدقت","ميْت روضي برضاب من رحيق",91,"ق",1,0],["من ينطح المويه ولاعنده شراع","ان عاش يرجع من هك الموج هايب",92,"ب",1,0],["من ينصر الله ينصره فلا أمل","في النصر إلا لمن وفى بما اشترطا",93,"ط",2,0],["من ينقل عتاب عدواني لخلاني","من ينزع الهم كانه بالصدر ثابت",94,"ت",1,0],["من ينكر التاريخ.... وجدادنا عاد","من يمسح الشمس بيديه أصطبارى",95,"ر",2,0],["مَنْ يَنْصُرُ الْحَقَّ الْجَلِيَّ وَأَهْلَهُ","لِيَظَلَّ بَاطِلُ كُلِّ دَهْرٍ زَائِلَا ؟",96,"ل",2,0],["من ينفق الساعات في الدنيا على","غير الحسان فعمرهُ لمضيَّعُ",97,"ع",1,0],["منينْ وِحْنا مِثلْ صبيان","لحين عْقلنا وكبرنا",98,"ن",2,1],["من ينقذ الغرقى سواك إذا طغى","طوفان بحر كابر الزلات",99,"ت",1,0],["منين أجيبك يا صبر","ومنو اليطيني العذر",100,"ر",1,0],["منين أجيب الحظ حبيبي","واكظي أيامي معاك",101,"ك",1,1],["منين الك مخلص يودك","مثلي يتمنه رضاك",101,"ك",1,0],["من ينشدِ العلياء يَطلب ودّها","هيَ درةٌ تأبى خمول الخُذّلِ",102,"ل",1,0],["مَنْ يَنْفَعَ القَوْمَ إِذَا جَاسَتْ بِأَرْضِهُمُ","سَنَابِكُ الخَيْلِ تَغْزُوهُمْ بِهَا وَجَعَا",103,"ع",2,0],["من ينفق القطرَ يُجز الغيثَ مُنهمراً","تُساقُ جوداً إليه أثقلُ السحبِ",104,"ب",1,0],["من ينقذ الأرض في الهيجاء راكعة !!!","تكابد القيظَ لا تغفو ولا تصحو !!!