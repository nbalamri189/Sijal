{"poems":[[90,"أي خطب دها ربوع الشام","https://www.aldiwan.net/poem45055.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42711","الخفيف"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[443,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79885","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49570","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109345","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60821","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36342","الدوبيت"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28781","الرمل"],[4680,"لا تلتفت","https://www.poetsgate.com/ViewPoem.aspx?id=198859",""],[5038,"الحدباء تناديني","https://www.poetsgate.com/ViewPoem.aspx?id=195227",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[454,"إن العروبة بالإسلام عزتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82660&r=&rc=24",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""]],"verses":[["سل دمشقاً تجبك عن شيم في","ه تعالت عن أن تزنّ بذام",0,"م",1,0],["سَلْ دمُوعِي فَهُنَّ يُنْبِئْنَ عَمَّا","فِي ضَمِيرِي وَيَعْتَرِفْنَ بِصِدقِي",1,"ق",2,0],["سَلْ دَعْوَةَ المَهْديّ عن آثاره","تُنْبِئْك أنّ ظُباه قُمْنَ إزَاءَها",2,"ا",3,0],["سل دار هندٍ بالكثيب الفردِ","هل ارتوت أطلالها من بعدي",3,"د",2,1],["سل داحسا والغبيرا عن رهانهم","وكيف عبس وذبيان به نكبوا",4,"ب",3,0],["سل ديمةً كلَّما استمطرتُها لمعت","بروقُها لي وانحلَّت عزاليها",5,"ي",3,0],["سَلْ دمعيَ المبذولَ هلْ مِنْ حيلةٍ","لي أوْلَه في نوميَ الممنوع",6,"ع",1,1],["سلْ دماءً تخذتهُنَّ مدادًا","ويراعًا جرَّدتُ منه حساما",7,"م",2,0],["سلْ دروسًا أمليتُهنَّ كؤوسًا","منعشاتٍ وما مُلئن مُداما",7,"م",2,0],["سل دار ريا سقاها الغيث هل عهدت","من بعد دمعي عِهاداً كافل الري",8,"ي",1,0],["سَلْ ديارَ الحي عن ساكِنها","هل ينْبيك فصيح أعجما",9,"م",2,0],["سَل دُرجَ عَقيقهِ من اِستفتحهُ","بَل كَنزَ لآليه من اِستَوضَحَهُ",10,"ه",1,1],["سَل دِيارَ الحَيِّ ما غَيَّرَها","وَمَحاها وَمَحا مَنظَرَها",11,"ر",3,1],["سلْ داميات الليالي عن متاعبها","للجرح ذاكرةٌ عن فعلها أدرى",12,"ر",2,0],["سَلْ دِجْلَةَ الْخَيرِ عَنْ أَرْضِ الرَّياحِينِ","عَنْ مَوصِلِ السِّحْرِ في عُمْرِ الثَّلاثِينِ",13,"ن",1,1],["سَلْ \" دَاعِشَ \" التَّخرِيبِ كَيفَ تَوَغَّلَتْ","فِي كُلِّ شِبرٍ والرُّؤُوسُ نِيَامُ",14,"م",1,0],["سل ديار الحىّ عن ساكنها","إن أجابتك عن الحىّ الدّيار",15,"ر",1,0],["سل داحسا والغبيرا عن رهانهما","وكيف عبس وذبيان به نكبوا",16,"ب",3,0],["سلْ دُموعي عنْ دُموع خلفَها","وسْطها نارٌ وريحٌ تحتدِم ْ",17,"م",1,0]]}