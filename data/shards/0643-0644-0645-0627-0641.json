ViewPoem.aspx?id=130622",""],[5970,"بعض شر من شرور العالمين","https://www.poetsgate.com/ViewPoem.aspx?id=130583",""],[5974,"ونس روحي","https://www.poetsgate.com/ViewPoem.aspx?id=215955",""],[6045,"قُبلة من فم الأيّام","https://www.poetsgate.com/ViewPoem.aspx?id=125345",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6102,"الحب في الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=182875",""],[6102,"جَنَّةُ الشِّعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183611",""],[6102,"نَدَم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185209",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[6124,"سقيم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=159785",""],[6124,"فسيفساء","https://www.poetsgate.com/ViewPoem.aspx?id=159786",""],[313,"هل تناسيت؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66503&r=&rc=25",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[6334,"الحُبٌّ البَدَوِيّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82255&r=&rc=5",""]],"verses":[["كُلُّ ما فيها عَلى إِعجازِها","أَنَّها قَبرٌ لِجَبّارٍ حُطَم",0,"م",1,0],["كل ما في البلاد من أموال","ليس إلاّ نتيجة الأعمال",1,"ل",1,1],["كُلُّ ما في الوُجودِ لِلمَرءِ عَبدٌ","وَهوَ عَبدُ الشَهواتِ وَالأَهواءِ",2,"ا",2,0],["كُلُّ ما فيها جَميلٌ يُشتَهى","ما بِها عَيبٌ سِوى فَرطِ الجَمال",3,"ل",1,0],["كُلَّما فَكَّرتُ في حاضِرِنا","عاقَني عاقَني اليَأسُ عَنِ المُستَقبَلِ",4,"ل",1,0],["كُلُّ ما في الأَرضِ مِن عَينٍ وَظِل","سَوفَ يَنحَلُّ كَما اِنحَلَّ الزَبَد",5,"د",1,0],["كل ما في الوجود فهو لعمري","من نواميس الكون في اصفاد",6,"د",1,0],["‏كلُّ ما في الكون حب وجمالُ","بتجليك وإن عز المنالُ",7,"ل",1,1],["كلما فكرت في الأم","ر تولاني ارتجافُ",8,"ف",1,1],["كل ما في الوجود فهو لعمري","علل تارة وَمعلولات",9,"ت",1,0],["كل ما في حياتنا","هو كالظل زائل",10,"ل",1,1],["كلَّ مَا في الكونِ","مِنْ حُزنٍ وأَفراحٍ عَدَاهْ",11,"ا",2,0],["كُلُّ مَا فِي الحَيَاةِ حِسّاً وَفِكْراً","هُوَ حِسٌّ فِي أَصْغَرَيْكَ وَفِكْرُ",12,"ر",1,0],["كُلُّ مَا فِيكِ فَاتِنٌ وَتَعَالَيْ","تِ كَثِيراً عَنْ دَاعِياتِ الفُتُونِ",13,"ن",1,0],["كلّما فكرت في حاضرنا","عافني اليأس عن المستقبل",14,"ل",1,0],["كلُّ ما فيها يزول فلا","فرقَ بين الهم والجَذَل",15,"ل",1,0],["كلما فتشت عن نسبي","لم تجد شيئا من النسب",16,"ب",1,0],["كلُّ ما فيهِ غايةُ الحسنِ فيه","وَمَزاياهُ كلُّها حسناءُ",17,"ا",2,0],["كل ما فيكَ بينهمْ مكرماتٌ","ومن المكرماتِ أن وحَّدوكا",18,"ك",2,0],["كلما فكرت في شوقي إليك","كلما فكرت في عطفى عليك",19,"ك",1,0],["كل ما فيها جديد في جديد","وشرودٌ في التصابي وشرود",20,"د",1,0],["كُلَّما فَرَّ طائِرٌ حَمَلَ الوا","دي إِلَينا مِن حُبِّهِ أَسرابا",21,"ب",2,0],["كُلُّ ما في الحَياةِ أَنتِ فَقَد سُ","كِّرَ سَمعي وَأُطبِقَت مُقلَتايا",22,"ا",3,1],["كُلَّ ما فيهِ بُكاءٌ وَنُواح","تَشهَدُ الأَجفان",23,"ن",1,0],["كلَّ ما في البِلادِ أَمسى غَريباً","شَوَّهتَهُ مناكِلُ الغُرَباءِ",24,"ا",2,0],["كلّ ما في الحَياةِ يَرنو إِلَينا","بِحنوٍّ عَساهُ أَن يَستَمِرّا",25,"ر",2,0],["كلُّ ما في النفس من أمل","لكِ أطويه وأدَّخِر",26,"ر",1,0],["كُلَّما فَكَّرَ في البَينِ بَكى","ما لَهُ يَبكي لِما لَم يَقَع",27,"ع",1,0],["كُلُّ ما في الوُجودِ حَقٌّ وَهَذا","بِشُهودِ الجَميعِ مَظهَرُ أَمرِك",28,"ك",1,0],["كُلَّما فَتّحَ ذكراً بِاسْمِهِ","مادِحٌ فتّقَ مِسْكاً أذْفَرا",29,"ر",2,0],["كل ما في الدنا احترابٌ على العيش","وضغنٌ يشوّي قلوب الرجال",30,"ل",1,0],["كُلُّ ما في الوجود يُصبي المعنّى","بهوى ذلك الجمالِ المُفدّى",31,"د",2,0],["كُلُّ ما فيكَ مُصطَفى وَحَقيقُ","بِثَناءِ الأَخدانِ وَالأَقرانِ",32,"ن",1,0],["كُلُّ ما فيكَ مُصطَفى واجِبُ المَد","حِ فَماذا أَقولُ وَالحالِ تَشهَدِ",33,"د",1,0],["كل ما فاتنا متاع غرور","فاصنع الباقيات قبل الذهاب",34,"ب",1,0],["كل ما في الوجود آيات فنٍّ","سوف تفنى والملك للوهّاب",35,"ب",1,0],["كل ما في الوجود سحر وفن","وانطلاق من جائر الراحات",36,"ت",1,0],["كل ما فيك يا ربيعي فتون","عصرت في مراشف الحب خمرا",37,"ر",2,0],["كل ما في المكان من كهرباء","خلته الان فوق نهديك عقدا",38,"د",2,0],["كل ما فيه غادتي من شباب","او حوار ينساق للحسن عبدا",38,"د",2,0],["كلما فكرت في الدن","يا تولاني اضطراب",39,"ب",1,0],["كل ما في موطني فتن","هو حقاً فتنة الفتن",40,"ن",1,0],["كُلُّ ما فاتَ في اللّيالي المَواضي","فهْو في ذِمّةِ اللَّيالي البَواقى",41,"ق",2,0],["كلُّ ما فيه كاذبٌ","لا تراه مصدَّقاً",42,"ق",2,0],["كلّما فوَّق سَهْماً","لم يُصِبْ إلاّ المَقَاتِلْ",43,"ل",1,0],["كل ما في الأكوان من آياتك","ودليل على كمال صفاتك",44,"ك",1,1],["كلما فاضت السحائب خلنا","ذلك الفيض من يديك نوالا",45,"ل",2,0],["كل ما في باريس شعر وحسن","آية فتنة كمال نفيس",46,"س",1,0],["كل ما في الكون لا يشغلني","ولئن كان شباكا تترامى",47,"م",2,0],["كل ما فيه مليح عله","كرضاب كمدام كأقاح",48,"ح",1,0],["كلَّما فاهَ بِكُمْ مُنْشِدُنا","دمعُ عَيْني النُّطْقَ منهُ سَبَقَا",49,"ق",2,0],["كلّما فاكَهوا الجليسَ بلفظٍ","نظَمَتْهُ الحبَابُ فوقَ الخُمورِ",50,"ر",1,0],["كُلّ مَا في الْحُّبِّ عَذْبُ","مِنْ عَذَاب فيه يُلْقَى",51,"ق",2,0],["كُلُّ ما في الوُجودِ وَهمٌ فَلا نر","حَمُ زَيداً وَلا نُغبِّطُ عَمرا",52,"ر",2,0],["كل ما فيك إلفة وانحلال","حولاه تفاعل وانفعال",53,"ل",1,1],["كُلَّما فَوَقتَ سَهماً صائِباً","لَم يُصِب مِنّي إلاَّ مَقتَلا",54,"ل",2,0],["كُلَّما فيها ضَحِكنا","أَعقَبَ الضحكَ البُكاءُ",55,"ا",2,0],["كل ما في الدُّنا سيصبح سرا","خافىَ الأمر غير تلك الدور",56,"ر",1,0],["كل ما في الوجود بان كما كا","ن سوى قلبي الحزين الصديع",57,"ع",1,0],["كلّما فترت اللّح","ظَ رَمَتني بسهامِ",58,"م",1,0],["كلُّ ما في الشباب من وثبة الفك","ر وحب التجديد ثوباً وعهدا",59,"د",2,0],["كلما فوّض للنطق فما","بات سحبان الورى في خرسِ",60,"س",1,0],["كلما في ولج الركب الحداة","أعربت ذكرك في تلك الصفات",61,"ت",1,0],["كُلُّ ما في هذِهِ الدُّن","يا قُصاراهُ الفَناءُ",62,"ا",2,0],["كل ما في الوجود غيرك يا اللّه","يا اللّه لا يقوم بفعل",63,"ل",1,0],["كلما في متنها السوط هفا","هتفت بالمرتضى والمصطفى",64,"ف",2,0],["كلما فاز بشيءٍ","يسأل اللَه الزياده",65,"د",2,0],["كلّ ما فيها شقاءٌ وأسى","وعداء وضلال وعمى",66,"م",2,0],["كُلُّ ما في الوُجودِ يَدعوهُ لِلصَف","وِ وَيَحدو عَلى الهَوى وَالوِصالِ",67,"ل",1,0],["كُلُّ ما في الوُجودِ مِلكُ يَدَيهِ","مِن جَمالٍ وَرِقَّةٍ وَكَمالِ",67,"ل",1,0],["كلُّ ما في الوجود بينَ يديها","يطلبُ العفوَ والرضى كلَّ آنِ",68,"ن",1,0],["كل ما في الوصال عندي حلالٌ","لا أرى في الوصال شيئاً حراما",69,"م",2,0],["كلُّ ما فيه يعشق العقلُ معنا","هُ وتهوى جماله العينان",70,"ن",1,0],["كلُّ ما في العلم يشهده","ليس شيءٌ عنده بطنا",71,"ن",2,0],["كل ما في الوجود من كائنات","ذو المعالي لاجله سواها",72,"ا",3,0],["كَلُّ ما في الأَرض نوح","وَنَواعٍ وَبَواكي",73,"ي",1,0],["كلُّ ما في الأنام من شرف النف","س وحسن البلاء في الهيجاء",74,"ا",2,0],["كلّ ما في الكون يوحي الضجرا","من ضجيج المُدْن أو هذر القُرى",75,"ر",2,1],["كل ما في الكون من أوبئةٍ","وأفاعيل القضا والقدر",76,"ر",1,0],["كل ما في الحياة بالشأن عندي","واحدٌ وهو عندكم نسبيُّ",77,"ي",1,0],["كلما فرّ من يد الطفل طيرٌ","قال أطلقته لوجه الباري",78,"ر",2,0],["كل ما في الروض حتى تربه","سبّح الرحمن تسبيحاً خفيّا",79,"ي",2,0],["كلما فكّرتُ فيكم هاجني","ألمٌ في طيِّ أحشائي ألمّ",80,"م",1,0],["كلُّ ما فوقَ ذا الثَرَى مستحيلٌ","بل لكلٍّ تغيُّرٌ وابتدالُ",81,"ل",1,0],["كلّ ما في الوجود يؤلمني الآ","ن وهذي الحياة تجرح نفسي",82,"ي",1,0],["كُل ما فيها تَراه","حالة تُدرَى بحد",83,"د",1,0],["كل ما فيه راقص","ثائر ثورة الخطر",84,"ر",1,0],["كل ما في الوجود يرقص شوقا","وبه السوق نحو روض التهنى",85,"ن",2,0],["كُلَّمَا فَاحَ نَشرٌ او لاَحَ بَرقٌ","هَشَّ قَلبِي وبَشَّتِ الأعضَاءُ",86,"ا",2,0],["كل ما فيك جَميل وَمَتى","قيل ذو حسن نجا ممن حسد",87,"د",1,0],["كلما فكر فيكم مصلح","عاد تصلي رأسه بعض الفكر",88,"ر",1,0],["كُلُّ ما في الحَياةِ طولا وَعَرضا","هائِماتٌ مِنَ السَوائمِ مَرضى",89,"ض",2,0],["كلُّ ما في أيديكم من يديهِ","وإِليه المعادُ حتماً قضاءَ",90,"ا",2,0],["كلما فاح شذىً عرفنا","عرفه أفراح كل الحقب",91,"ب",1,0],["كل ما في الوجود من أجله أو","جد لا تفتقر الى استثناء",92,"ا",2,0],["كلما في الوجود قد نال حظاً","ونصيباً من هذه الصهباء",93,"ا",2,0],["كُل ما في الكَون يَمشي","في حَناياه الإِله",94,"ه",1,0],["كُل ما في الحَياة مِن ذات نهد","ين وَمِن ذي غَلالَتين أَغن",95,"ن",1,0],["كُلُ ما في الوَرى عَدا العلم","لا يَكبر شَعباً وَلا يُمَجد قَطرا",96,"ر",2,0],["كلّ ما في الوُجود يَنشُد طه","بِلِسان الحال الَّذي هو ناشِد",97,"د",1,0],["كلّ ما في الوُجودِ فيكِ تجلّى","يُخجِل الشَمسَ في مَقام الشُهودِ",98,"د",1,0],["كُلَّمَا فَارَقَ الْحَياةَ حَبِيبٌ","أَوْرَثَ الرَّاحِلُون فِي الْقَلْبِ حُزْنَا",99,"ن",2,0],["كُلَّمَا فَتَّشْتُ عَن أَمَلٍ","فيهِ لَاحَ القَبرُ والنَّفَقُ!",100,"ق",1,0],["كُلَّمَا فَتَّشْتُ عَن جِهَةٍ","لَاحَ قَبرٌ ثَمَّ أو نَفَقُ!",101,"ق",1,0],["كلما فاح أريجٌ طيبٌ","سادَ في الأنفس ثم التصقا",102,"ق",2,0],["كل ما فيه عليه","من صفات الحسن لائق",103,"ق",1,0],["كلَّمَا فيهِ أذيقتْ","زاد فيها عبقا",104,"ق",2,0],["كلما في روضِك الأخاذِ ناحت","بالهوَى قُمرِيَّةٌ قلبي تعنَّى",105,"ن",2,0],["كلّ ما في الأمر إني حالمٌ","أنظم الحرف بسِمْطٍ من ضياءْ",106,"ا",2,0],["كل مافيه اقتباسٌ","أفقد البوحَ المهابة",107,"ب",2,0],["كلما في الوجود عنهُ وجودٌ","شاهدٌ ناطقٌ بهِ فَوَّاه",108,"ا",2,0],["كُلُّ مافينا تلاقى في خضوعٍ","ماملكنا في تلاقينا القرارا",109,"ر",2,0],["كُلُّ ما في الكَونِ يا خِلِّيَ يَدعو للكآبَه","والحَزانى مِثلنا لم يَعرفوا إلا عَذابَه",110,"ب",2,0],["كلما فجرٌ تدلى خيطُهُ","كذّبتْ شمسُ عذابي مطلعَه",111,"ع",2,0],["كلما فارقتُ غيمتهُ","بالفؤاد الحزن قد لَبَدا",112,"د",2,0],["كُلُّ مَا فِيَّ يُنَادِيهِ هُنَا","وَهُنَاكَ الصَّمْتُ فِي الثَّغْرِ احْتَفَلْ",113,"ل",1,0],["كل مافي الرياض هام انتشاء","الازاهير والربى والفضاء",114,"ا",2,0],["كلُّ ما في الأرض لولانا سُدى","وبلا الإنسان رملٌ وحُطامْ",115,"م",1,0],["كُلُّ ما فيك بَهِيٌّ ساحِرٌ","كُلُّ ما فيك بِهِ وَجْدي اعْتَنى",116,"ن",2,0],["كلُّ ما فيهِ بقايا أمسِهِ","مِن تخومِ الشامِ تصطكُّ قطَرْ",117,"ر",1,0],["كلما فيها همى قلبي هوى","فاضتِ العينُ بدمعٍ وتزيدْ",118,"د",1,0],["كل ما في الدنا لو انا خسرنا","ه وأن الشباب باقٍ لهانا",119,"ن",2,0],["كل مافيه نازحٌ وشهيدٌ","كل مافيه بالفلاة ذبيحُ",120,"ح",1,0],["كل مافي الأرض ينذر بالمفارق والغياب","اللقا .. والشمس .. وحروف الرسايل .. والقبور",121,"ر",1,1],["كلما فاح ريحه","قلت: حبي تنفسا",122,"س",2,0],["كلما في الرياض شاهدتُ زهْرًا","راسخَ الحُسْن زدْتُ فيكِ هُي