{"poems":[[84,"بحياة ما ضمت عرى الأزرار","https://www.aldiwan.net/poem29396.html","الكامل"],[53,"يا قاتل السنور والديك","https://www.aldiwan.net/poem65828.html","الطويل"],[93,"مثلي هذا النجم في سهده","https://www.aldiwan.net/poem8804.html","عموديه"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[58,"يا رب خرق كأن الله قال له","https://www.aldiwan.net/poem58580.html","البسيط"],[50,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[52,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[93,"أنا والنجم","https://www.poetsgate.com/ViewPoem.aspx?id=53020",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[164,"أما الوشاة به فقد ظلموه","https://www.aldiwan.net/poem58961.html","الكامل"],[164,"ما خاب من في الله كان رجاه","https://www.aldiwan.net/poem59130.html","الكامل"],[358,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[382,"قف بي خليلي واستمح","https://www.aldiwan.net/poem66887.html","مجزوء الكامل"],[385,"ومنعم جذلان لا يدري بما","https://www.aldiwan.net/poem48823.html","الكامل"],[415,"يا رب خذ بيدي من ظلم مقتدر","https://www.aldiwan.net/poem32528.html","البسيط"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38976","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38974","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59123","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115903","المنسرح"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11172","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32607","الرجز"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126517","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205053","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115657","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121381","الكامل"],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178026","المنسرح"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66440","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40060","المنسرح"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70150","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69928","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33559","المنسرح"],[4764,"ربيت لي طيرٍ وضيعت طَيري","https://www.poetsgate.com/ViewPoem.aspx?id=35202",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5561,"أطلِقْ عنانَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192746",""],[5572,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53487",""],[5956,"رحلتْ","https://www.poetsgate.com/ViewPoem.aspx?id=182149",""],[5956,"أرثيه يوميا وهو حيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=206257",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[5977,"حاجة نفس","https://www.poetsgate.com/ViewPoem.aspx?id=213132",""]],"verses":[["يا رب خذ بيدي من الذنب الذي","أنا حائر في بحره الزخار",0,"ر",1,0],["يا ربّ خودٍ غضةٍ بضةٍ","قد حنَّكتْها أيَّ تحنيكِ",1,"ك",1,0],["يا رُبَّ خَلِّ كانَ دوني نُهىً","عَجِبتُ مِن نَهسي وَمِن سَعدِهِ",2,"د",2,0],["يا رب خوف صراطك","الممدود همّ مثقلى",3,"ل",2,0],["يا رُبَّ خَرْقٍ كأنَّ اللّهَ قالَ لَهُ","إذا طَوَتْكَ رقَابُ القَوْمِ فانْتَشِرِ",4,"ر",1,1],["يا رُبَّ خَرقٍ نازِحٍ حَديبِ","أَخضَلَهُ السَحابُ بِالصَبيبِ",5,"ب",1,1],["يا رَبِّ خُذ لي فَقَد تَرى ضُعُفي","مِن فاسِقِ الكَفِّ ما لَهُ شُكُرُ",6,"ر",1,0],["يا ربّ خلّ كان دوني نهى","عجبت من نحسي ومن سعده",7,"د",2,0],["يا رب خذل مثل خذ","لك كان حظ المخلصين",8,"ن",1,0],["يارب خذ منهم له واشغلهم","عنه بأنفسهم كما شغلوه",9,"و",2,0],["يا رب خذ لي في العدو إدالة","يشفي الصديد بها بيوم بلاه",10,"ا",2,0],["يا رَبّ خطبٌ قَد دَهى الأُمّة في","أَوطانِها ظُلمته تغشى السنا",11,"ا",1,0],["يا رُبَّ خَطْبِ خطابٍ منه مَزَّقَه","حتّى انْجلَى لَيْلُه من بعدِ إجنان",12,"ن",1,0],["يا رُبَّ خلٍّ قائلٍ","قول النصوح المنتصح",13,"ح",1,0],["يا رَب خَلّ غَليل جِسمي وَحدَهُ","يَشكو الضَنا وَاِبعَث إِلَيهِ العافِيَه",14,"ي",2,0],["يَا ربِّ خُذ بِيَدي مِن ظُلمِ مُقتَدِرٍ","عَلَيَّ قَد لَجَّ في صَدّي وَهجرانِي",15,"ن",2,1],["يا رُبّ خمرٍ فمُهُ كأسُها","لم أقتَنِعْ من شُربِها بالشميمْ",16,"م",1,0],["يا ربِ خُذ لي أنتَ من مُقلةٍ","حُمرَتُها من دمِ آماقيا",17,"ي",2,0],["يا رُبَّ خِدنٍ قَد قَرَعتُ جَبينَهُ","بِالطاسِ وَالإِبريقِ حَتّى مالا",18,"ل",2,0],["يا رَبِّ خَير النّاصِرينْ","بِالنّصرِ وَالفَتحِ المُبينْ",19,"ن",1,0],["يا رَبِّ خَرِّبْ دارَهم","يا رَبِّ أَطفِئْ نارَهم",20,"م",1,0],["يا رب خان اصطباري والحبيب جفا","ولم أجد لمعاناة الطبيب شفا",21,"ف",2,1],["يَا رُبَّ خُودٍ جَلَتْ مُحَيَّا","كَبَدْرِ تَمّ عَلَى قَضِيبْ",22,"ب",1,0],["يا ربّ خُذ لى من الفراقِ فقد","أذابَ قلبى وأحرقَ الكبدَا",23,"د",2,1],["يا رب خفف حسابي في المعاد إذا","لم يلف في حسنات العبد تثقيل",24,"ل",1,0],["يا رُبَّ خالٍ لِأُمٍّ غَيرِ مُؤتَشِبِ","لا يَشرَبُ الخَمرَ إِلّا في القَواريرِ",25,"ر",1,1],["يا رب خال لك مسود القفا","لا يشتكي من رجله مشي الحفا",26,"ف",2,1],["يا ربّ خلَد مدى الايام شوكتهُ","واحفظ عدالتهُ ورداً لظاميها",27,"ي",3,0],["يا رب خفف من عقابنا به","فهو عقاب فاق جرم الجارم",28,"م",1,0],["يا رب خامسةٍ بدَت","كالشمسِ في نيل الشفَّق",29,"ق",1,1],["يا رُبَّ خَصمٍ قد تركتُ ذَماءَهُ","وكأنما شُقَّت له أرماسُهُ",30,"س",2,1],["يا رب خذ لي من الوشاة إذا","قاموا وقمنا إليك نختصم",31,"م",1,0],["يا رب خلّد في جنانك روحه","واغفر له يا خير مولىً غافر",32,"ر",1,0],["يا ربّ خُذْ لي مِنَ الوُشاةِ إذا","قامُوا وقُمْنا لَدَيْكَ نَحْتَكِمُ",33,"م",1,0],["يا رَبُّ خلّدها إِلى","سلطاننا عَبد الحَميد",34,"د",1,0],["يا رَبُّ خلِّد مَجدهُ","وَاغمر بفضلك سعدهُ",35,"ه",1,0],["يا ربِّ خُذ لي مِن الفراقِ ولا","تأخذ لقلبي مِن الذي ظَلما",36,"م",2,0],["يا رب خذني معه /و ريح ضميري","خلني معه يمكن نلاقي /المسره",37,"ر",2,0],["يا رب خلد ملكه واحرسه في","عز على مر الدهور مؤيد",38,"د",1,0],["يا رُبّ خيل بها التاريخ مرتهنٌ","صارت عتاقا بها الأحمال تنتقل",39,"ل",1,0],["يارب خفّف لوعتي كثر ماهيم","وكثر الأسى ليا طاش وازهم سهادي",40,"د",2,0],["‏يا رب خصّصْها لنفسي وحدِها","‏ ‏ لم ألق مثلكَ يا إلهي سامعي",41,"ع",2,0],["يا رب خالفْ خِيفتي وتشاؤمي","وأطلْ حياته ألف عام قادمِ",42,"م",1,0],["يا رَبِّ خلِّدْ طيبة امرأةٍ","أفراحُنا من دونها عدَمُ",43,"م",1,0],["يارب خيرك في العطاء يلفني","وأنا المقصر ..حالتي أرثيها",44,"ي",3,0]]}