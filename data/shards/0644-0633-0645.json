{"poems":[[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[52,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54702","الطويل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[201,"بك بالشوق بالضنى يا جاره","https://www.aldiwan.net/poem39943.html","الخفيف"],[240,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[469,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2935,"","https://poetry.dctabudhabi.ae/diwan/poem/130238","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110153","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206168","الكامل"],[3861,"","https://poetry.dctabudhabi.ae/diwan/poem/73551","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69974","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70027","الكامل"],[5186,"تالله ما أنا واقف في الباب","https://www.poetsgate.com/ViewPoem.aspx?id=156550",""],[4045,"عقد لخليفة بيعة","https://www.poetsgate.com/ViewPoem.aspx?id=200284",""],[5277,"التزلف الأنيق","https://www.poetsgate.com/ViewPoem.aspx?id=189881",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""]],"verses":[["لَسَمِعتِ طولَ تَأَوُّهي وَتَفَجُّعي","وَعَلِمتِ حُسنَ رِعايَتي وَوَفائي",0,"ي",1,0],["لسماح كفك كلما استوهبتُه","يُزري بغيث الديمة المدرارِ",1,"ر",1,0],["لَسُمِّرَ البَدَنُ الطُهرُ الشَريفُ عَلى","لَوحَينِ لَم يَخشَ مُؤذيهِ وَلَم يَجِمِ",2,"م",1,0],["لسمّيتُ بعضَ النساء الرجالَ","وسمّيتُ بعضَ الرجال النسا",3,"ا",1,0],["لَسَماعُهُ إِن كانَ يُسمِعُنا","أَشهى إِلى قَلبي مِنَ العَذبِ",4,"ب",1,0],["لِسَمْعَانَ فِي كُلِّ الْقُلُوبِ مَكَانَةٌ","بِهَا حَلَّ فِي أَوْجِ الْكَرَامَةِ وَالمَجْدِ",5,"د",1,0],["لَسَمّى نَفسَهُ عَمراً","وَسَمّى الكَلبَ وَثّابا",6,"ب",2,0],["لسَماءِ الروى وشتّى الأماني","فبَناتُ القَريضِ رهنُ الإشارَه",7,"ر",2,0],["لِسَماءِ مَجدِكَ أَنجُمٌ","وَلِمَن يُعاديها رُجومُ",8,"م",1,0],["لسما ارآئه فيما تاه","خطرات منه مرت بالفكر",9,"ر",1,0],["لسما سمو المجد في صدر الضحى","وفللت بالعزم الحسام المرهفا",10,"ف",2,0],["لسمعتم كلامها وهي تُنْبِي","عن علاه كما رأيتم سناها",11,"ا",3,0],["لَسُمِّيتَ ضُرًّا بعد إذْ كنت نَافعاً","ولم تَلْق إلاّ ما لَهُ يَجِبُ القَلْبُ",12,"ب",1,0],["لسميِّ ايليَّا النبيّ نقلةٌ","من الحضيض للعلاءِ ارتحلا",13,"ل",2,1],["لَسَمَوتَ مرتقباً ولم","تَعتَض ببأسك عن رَجائِك",14,"ك",1,0],["لسمعتُ بتنامور ينشد شعره","فتهز ساحة قصرك الأصداء",15,"ا",2,0],["لَسُمتُ المَطيَّ اِشتِكاءَ الوَجا","بِحَيثُ اليَماني بِها مُشئِمُ",16,"م",1,0],["لسمر عواليكم وبيض الصوارم","أحاديث ترويها أسود الملاحم",17,"م",1,1],["لَسمعتَ مِنهُ يا أَباهُ مُنادياً","كفّ البُكاءَ فَلَيسَ ذا باوانهِ",18,"ن",2,0],["لسميهِ أنشأهُ دوناتو الَّذي","حجَّ الوَرى طرّاً لكَعبَةِ فَضلِهِ",19,"ه",1,1],["لسمت روح الشعر من أرواحها","جيفا أفاض بها نعيق غراب",20,"ب",1,0],["لسمىّ مهدىّ الملو","ك محمد خير الأنام",21,"م",1,0],["لسموِّ ذوقكِ تُبعثُ الأزهارُ","وبعطرِ طهركِ يعبقُ النوّارُ",22,"ر",1,1],["ل«سماوة» شغف الفؤاد بها","فاختارها لرفيفه نسبا",23,"ب",2,0]]}