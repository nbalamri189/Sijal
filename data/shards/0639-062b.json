{"poems":[[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[86,"عثمان إنك قد أتيت موفقا","https://www.aldiwan.net/poem68879.html","الكامل"],[71,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[51,"لئن قبحت مني لديك الظهائر","https://www.aldiwan.net/poem62970.html","الطويل"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[28,"بل ما رأيت ولا سمعت به","https://www.aldiwan.net/poem5129.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[44,"عثمان لا تلهج بذكر محمد","https://www.aldiwan.net/poem30027.html","الكامل"],[44,"كف الندى أضحت بغير بنان","https://www.aldiwan.net/poem30297.html","الكامل"],[69,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[74,"ألا فضلت ذيلها ليلة","https://www.aldiwan.net/poem12853.html","المتقارب"],[74,"ألا رب يوم حثت الكاس خطوه","https://www.aldiwan.net/poem12938.html","الطويل"],[48,"عثمان يا أكرم البرايا","https://www.aldiwan.net/poem66145.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[71,"لا تعرضنَّ لضيقِ المقلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28026&r=&rc=13",""],[130,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[197,"عثرت في مدارها الأيام","https://www.aldiwan.net/poem45167.html","الخفيف"],[233,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[248,"عثرات الناس بالناس تقال","https://www.aldiwan.net/poem15009.html","الرمل"],[303,"خير حام مجير عبد المجيد","https://www.aldiwan.net/poem56552.html","الطويل"],[303,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[326,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[364,"الصمت أسلم لكن إن أردت دمي","https://www.aldiwan.net/poem17334.html","البسيط"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[459,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[462,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[463,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[475,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[513,"قصدتك من أرض الحطيم قصائد","https://www.aldiwan.net/poem12029.html","الكامل"],[513,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[525,"طلقت بعدك مدح الناس كلهم","https://www.aldiwan.net/poem45985.html","البسيط"],[527,"عثور الجد جد به أناس","https://www.aldiwan.net/poem37096.html","الوافر"],[549,"عثرت ولولا انتياش الإله","https://www.aldiwan.net/poem48024.html","المتقارب"],[556,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"من للخلاف وللوفاق مسائلا","https://www.aldiwan.net/poem17726.html","الكامل"]],"verses":[["عَثَرَت بِأَرياشِ القَشاعِمِ شَمسُهُ","وَالطَعنُ في هَبَواتِهِ لَم يَعثُرِ",0,"ر",1,0],["عَثَرَ الزَّمَانُ بِهَا وَكَانَتْ فَلْتَةً","شَنْعَاءَ وَالدَّنْيَا تَجِدُّ وَتَهْزَلُ",1,"ل",1,0],["عُثمانُ إِنَّكَ قَد أَتَيتَ مُوَفَّقاً","شَروى سَمِيِّكَ جامِعِ التَنزيلِ",2,"ل",1,1],["عَثَّرتَ خَلفَكَ كُلَّ ذي كَرَمٍ","يَجري وَراكَ وَأَنتَ في مَهَلِ",3,"ل",1,0],["عثرتُ وأنساني التحفُّظ أنني","أراك مُقيلاً حين يعثر عاثر",4,"ر",1,0],["عُثمانُ قُم تَرَ آيَةً","اللَهُ أَحيا المومِياتِ",5,"ت",1,0],["عُثمانُ في بُردَيهِ يَمنَعُ جَيشَهُ","وَاِبنُ الوَليدِ عَلى الحِمى قَوّامُ",6,"م",1,0],["عثَرت بسَيري نحو مصرَ فلا لَعاً","بها ولَعاً بالسيرِ عنها ولا عَثرا",7,"ر",2,0],["عُثمانَ إِذ ظَلَموهُ وَاِنتَهَكوا","دَمَهُ صَبيحَةَ لَيلَةِ النَحرِ",8,"ر",1,0],["عثرت بها فرفعتها بيدي","جسماً يكاد يشف في الظلم",9,"م",1,0],["عُثمانُ لا تَلهَج بِذِكرِ مُحَمَّدٍ","يَنهاكَ طولُ المَجدِ عَنهُ وَعَرضُهُ",10,"ض",2,1],["عَثَرَ الزَمانُ وَنائِباتُ صُروفِهِ","بِمُقيلِنا عَثَراتِ كُلِّ زَمانِ",11,"ن",1,0],["عثا في عرضِهِ قومٌ سلاطٌ","لهمْ منْ نثرِ جوهرِهِ التقاطُ",12,"ط",1,1],["عَثَرتُ بِذَيلِ الدُجى دونَها","فَأَضحَكتُ ثَغراً لَها أَشنَبا",13,"ب",2,0],["عَثَرتُ بِذَيلِ السُكرِ فيهِ عَشِيَّةً","وَلِلريحِ في مَوجِ الخَليجِ عِثارُ",14,"ر",1,0],["عُثمانُ يا أَكرَمَ البَرايا","مِن ذي مَعَدٍّ وَذي يَمانِ",15,"ن",1,1],["عثرت في جوف ليل للخطوب دجا","بذيل جيش من الأهوال ذي لجب",16,"ب",1,0],["عَثَرْتَ إِذْ نَجْمُكَ عَالٍ وَإِذْ","يَخْطُو مُجَارِيكَ خطى الظَّالِعِ",17,"ع",1,0],["عَثْرَةٌ دُونَ رَوْعِهَا","عَثْرَةُ النَّسْرِ إِذْ جَنَحْ",18,"ح",1,0],["عثراتُ العيون نصف حياة المرء","مهما يكن رصيناً رزينا",19,"ن",2,0],["عَثَتِ الأَعرابُ في بَلَدٍ","فَاِكتَسى ثَوبَ البِلى البَلَدُ",20,"د",1,0],["عثَّرتَ خلفكَ كلَّ ذيث كرمٍ","يجري وراكَ وأنتَ في مَهَلِ",21,"ل",1,0],["عِثنَ باللُّبّ واستَبَحنَ حِمَى الص","صَبرِ ومَلاَّنَ بالزَّفِيرِ الحَزِيمَا",22,"م",2,0],["عثرت في مدارها الأيامُ","أم هوَ الدهرُ هكذا والأنامُ",23,"م",1,1],["عَثرَتي فيهِ ما تُقا","لُ وَدَيني ما يُقتَضى",24,"ض",2,0],["عثراتُ الناسِ بالناسِ تُقَالُ","فإلى كم بيننا قيلٌ وقالُ",25,"ل",1,1],["عثرٌ مَن جَنى بِمرمى جحيمٍ","أَينَ يَجري بالعرجِ نكث العهودِ",26,"د",1,0],["عثرٌ من عنى بِمجرى مميحٍ","هاجَ حينٌ مِن عثر مجرى بعيدِ",27,"د",1,0],["عثرت مثل عثرَتي بصخور","فوقها زورق الحياة تحطم",28,"م",1,0],["عَثَرتُ في كُلِّ رَأيٍ قادَ نَحوَكُمُ","وَالعَثرُ في الرَأيِ لَيسَ العَثرُ في القَدَمِ",29,"م",1,0],["عثرت في غدرك بي","عثرةَ من لا وَألا",30,"ل",2,0],["عثرتَ يومَ العذَيبِ فاستقلِ","ما كلُّ ساعٍ يُحسُّ بالزَّلَلِ",31,"ل",1,1],["عثرنَ جيادي بالوشيج وربما","أعيدتْ وتيجانُ الملوك نِعالُها",32,"ل",3,0],["عثرة قلبي فيكم لا تقالْ","وإنما العذلُ حديثٌ يقالْ",33,"ل",1,1],["عَثْرَة َالعُمر.. أكبِري أنْ تُقالي","أنتِ فَوقَ الرِّضا ، وَفَوقَ السُّؤال ِ",34,"ل",1,0],["عثرَ الدهرُ بهِ بعدَهمُ","ليته قالَ وقد زلَّلعاً لَه",35,"ل",2,0],["عثرت به قد الشتاء فلا لعاً","إن لم يقلها رفعة وثواب",36,"ب",1,0],["عثرت بأطراف الفنا حول خدرها","وكم خادر عن جانبي ذلك الخدر",37,"ر",1,0],["عثمان يعلم أن المدح ذو ثمن","لكنه يشتهي مدحاً بمجَّان",38,"ن",1,0],["عُثُورُ الجَدِّ جَدَّ بِهِ أُناسٌ","وَشَانٍ شَنَّ شَاني شَانَ شَانِي",39,"ي",1,1],["عَثَرتُ وَلَولا اِنتِياشُ الإلهِ","لكنتُ صريعَ ردى عثرتي",40,"ي",1,1],["عثير رحلي به قد عثرت","ولعا ما قال قلبي ولعا",41,"ع",2,0],["عثمان وابن ثابت وجابرا","والشعري ذكروه آخرا",42,"ر",2,0],["عُثْمانُ جَدّكُم وَذَلِكَ حَسْبهُ","وَكَفى وَذَلِكَ حَسْبُكُم وَكَفاكُمُ",43,"م",1,0]]}