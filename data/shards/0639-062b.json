{"poems":[[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[86,"عثمان إنك قد أتيت موفقا","https://www.aldiwan.net/poem68879.html","الكامل"],[71,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[51,"لئن قبحت مني لديك الظهائر","https://www.aldiwan.net/poem62970.html","الطويل"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[28,"بل ما رأيت ولا سمعت به","https://www.aldiwan.net/poem5129.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[44,"عثمان لا تلهج بذكر محمد","https://www.aldiwan.net/poem30027.html","الكامل"],[44,"كف الندى أضحت بغير بنان","https://www.aldiwan.net/poem30297.html","الكامل"],[69,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[74,"ألا فضلت ذيلها ليلة","https://www.aldiwan.net/poem12853.html","المتقارب"],[74,"ألا رب يوم حثت الكاس خطوه","https://www.aldiwan.net/poem12938.html","الطويل"],[48,"عثمان يا أكرم البرايا","https://www.aldiwan.net/poem66145.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[71,"لا تعرضنَّ لضيقِ المقلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28026&r=&rc=13",""]],"verses":[["عَثَرَت بِأَرياشِ القَشاعِمِ شَمسُهُ","وَالطَعنُ في هَبَواتِهِ لَم يَعثُرِ",0,"ر",1,0],["عَثَرَ الزَّمَانُ بِهَا وَكَانَتْ فَلْتَةً","شَنْعَاءَ وَالدَّنْيَا تَجِدُّ وَتَهْزَلُ",1,"ل",1,0],["عُثمانُ إِنَّكَ قَد أَتَيتَ مُوَفَّقاً","شَروى سَمِيِّكَ جامِعِ التَنزيلِ",2,"ل",1,1],["عَثَّرتَ خَلفَكَ كُلَّ ذي كَرَمٍ","يَجري وَراكَ وَأَنتَ في مَهَلِ",3,"ل",1,0],["عثرتُ وأنساني التحفُّظ أنني","أراك مُقيلاً حين يعثر عاثر",4,"ر",1,0],["عُثمانُ قُم تَرَ آيَةً","اللَهُ أَحيا المومِياتِ",5,"ت",1,0],["عُثمانُ في بُردَيهِ يَمنَعُ جَيشَهُ","وَاِبنُ الوَليدِ عَلى الحِمى قَوّامُ",6,"م",1,0],["عثَرت بسَيري نحو مصرَ فلا لَعاً","بها ولَعاً بالسيرِ عنها ولا عَثرا",7,"ر",2,0],["عُثمانَ إِذ ظَلَموهُ وَاِنتَهَكوا","دَمَهُ صَبيحَةَ لَيلَةِ النَحرِ",8,"ر",1,0],["عثرت بها فرفعتها بيدي","جسماً يكاد يشف في الظلم",9,"م",1,0],["عُثمانُ لا تَلهَج بِذِكرِ مُحَمَّدٍ","يَنهاكَ طولُ المَجدِ عَنهُ وَعَرضُهُ",10,"ض",2,1],["عَثَرَ الزَمانُ وَنائِباتُ صُروفِهِ","بِمُقيلِنا عَثَراتِ كُلِّ زَمانِ",11,"ن",1,0],["عثا في عرضِهِ قومٌ سلاطٌ","لهمْ منْ نثرِ جوهرِهِ التقاطُ",12,"ط",1,1],["عَثَرتُ بِذَيلِ الدُجى دونَها","فَأَضحَكتُ ثَغراً لَها أَشنَبا",13,"ب",2,0],["عَثَرتُ بِذَيلِ السُكرِ فيهِ عَشِيَّةً","وَلِلريحِ في مَوجِ الخَليجِ عِثارُ",14,"ر",1,0],["عُثمانُ يا أَكرَمَ البَرايا","مِن ذي مَعَدٍّ وَذي يَمانِ",15,"ن",1,1],["عثرت في جوف ليل للخطوب دجا","بذيل جيش من الأهوال ذي لجب",16,"ب",1,0],["عَثَرْتَ إِذْ نَجْمُكَ عَالٍ وَإِذْ","يَخْطُو مُجَارِيكَ خطى الظَّالِعِ",17,"ع",1,0],["عَثْرَةٌ دُونَ رَوْعِهَا","عَثْرَةُ النَّسْرِ إِذْ جَنَحْ",18,"ح",1,0],["عثراتُ العيون نصف حياة المرء","مهما يكن رصيناً رزينا",19,"ن",2,0],["عَثَتِ الأَعرابُ في بَلَدٍ","فَاِكتَسى ثَوبَ البِلى البَلَدُ",20,"د",1,0],["عثَّرتَ خلفكَ كلَّ ذيث كرمٍ","يجري وراكَ وأنتَ في مَهَلِ",21,"ل",1,0]]}