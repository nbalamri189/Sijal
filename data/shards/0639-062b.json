28786","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62130","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66140","الكامل"],[4578,"عوذ سنا بدري بأي المثانِ","https://www.poetsgate.com/ViewPoem.aspx?id=49597",""],[4968,"مصابيح الدجى 2","https://www.poetsgate.com/ViewPoem.aspx?id=208102",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5677,"مقادير","https://www.poetsgate.com/ViewPoem.aspx?id=179849",""],[5881,"أيقظت جذوتها","https://www.poetsgate.com/ViewPoem.aspx?id=183803",""],[6038,"يا رب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=25684",""],[6056,"الأشقر المقضوض","https://www.poetsgate.com/ViewPoem.aspx?id=130331",""],[658,"َعَثت إليك بطيفِها المكذُوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=45791",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[6152,"القلوب أوطان","https://www.poetsgate.com/ViewPoem.aspx?id=203168",""],[6184,"أمام مصحف عثمان في استنبول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78621&r=&rc=13",""],[6290,"هَلْ تَسْتَقِيمُ جُذُوعُنَا يَوْماً؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85166&r=&rc=16",""],[4222,"يا أسدا يحمي عرين العلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52875&r=&rc=167",""]],"verses":[["عَثَرَت بِأَرياشِ القَشاعِمِ شَمسُهُ","وَالطَعنُ في هَبَواتِهِ لَم يَعثُرِ",0,"ر",1,0],["عَثَرَ الزَّمَانُ بِهَا وَكَانَتْ فَلْتَةً","شَنْعَاءَ وَالدَّنْيَا تَجِدُّ وَتَهْزَلُ",1,"ل",1,0],["عُثمانُ إِنَّكَ قَد أَتَيتَ مُوَفَّقاً","شَروى سَمِيِّكَ جامِعِ التَنزيلِ",2,"ل",1,1],["عَثَّرتَ خَلفَكَ كُلَّ ذي كَرَمٍ","يَجري وَراكَ وَأَنتَ في مَهَلِ",3,"ل",1,0],["عثرتُ وأنساني التحفُّظ أنني","أراك مُقيلاً حين يعثر عاثر",4,"ر",1,0],["عُثمانُ قُم تَرَ آيَةً","اللَهُ أَحيا المومِياتِ",5,"ت",1,0],["عُثمانُ في بُردَيهِ يَمنَعُ جَيشَهُ","وَاِبنُ الوَليدِ عَلى الحِمى قَوّامُ",6,"م",1,0],["عثَرت بسَيري نحو مصرَ فلا لَعاً","بها ولَعاً بالسيرِ عنها ولا عَثرا",7,"ر",2,0],["عُثمانَ إِذ ظَلَموهُ وَاِنتَهَكوا","دَمَهُ صَبيحَةَ لَيلَةِ النَحرِ",8,"ر",1,0],["عثرت بها فرفعتها بيدي","جسماً يكاد يشف في الظلم",9,"م",1,0],["عُثمانُ لا تَلهَج بِذِكرِ مُحَمَّدٍ","يَنهاكَ طولُ المَجدِ عَنهُ وَعَرضُهُ",10,"ض",2,1],["عَثَرَ الزَمانُ وَنائِباتُ صُروفِهِ","بِمُقيلِنا عَثَراتِ كُلِّ زَمانِ",11,"ن",1,0],["عثا في عرضِهِ قومٌ سلاطٌ","لهمْ منْ نثرِ جوهرِهِ التقاطُ",12,"ط",1,1],["عَثَرتُ بِذَيلِ الدُجى دونَها","فَأَضحَكتُ ثَغراً لَها أَشنَبا",13,"ب",2,0],["عَثَرتُ بِذَيلِ السُكرِ فيهِ عَشِيَّةً","وَلِلريحِ في مَوجِ الخَليجِ عِثارُ",14,"ر",1,0],["عُثمانُ يا أَكرَمَ البَرايا","مِن ذي مَعَدٍّ وَذي يَمانِ",15,"ن",1,1],["عثرت في جوف ليل للخطوب دجا","بذيل جيش من الأهوال ذي لجب",16,"ب",1,0],["عَثَرْتَ إِذْ نَجْمُكَ عَالٍ وَإِذْ","يَخْطُو مُجَارِيكَ خطى الظَّالِعِ",17,"ع",1,0],["عَثْرَةٌ دُونَ رَوْعِهَا","عَثْرَةُ النَّسْرِ إِذْ جَنَحْ",18,"ح",1,0],["عثراتُ العيون نصف حياة المرء","مهما يكن رصيناً رزينا",19,"ن",2,0],["عَثَتِ الأَعرابُ في بَلَدٍ","فَاِكتَسى ثَوبَ البِلى البَلَدُ",20,"د",1,0],["عثَّرتَ خلفكَ كلَّ ذيث كرمٍ","يجري وراكَ وأنتَ في مَهَلِ",21,"ل",1,0],["عِثنَ باللُّبّ واستَبَحنَ حِمَى الص","صَبرِ ومَلاَّنَ بالزَّفِيرِ الحَزِيمَا",22,"م",2,0],["عثرت في مدارها الأيامُ","أم هوَ الدهرُ هكذا والأنامُ",23,"م",1,1],["عَثرَتي فيهِ ما تُقا","لُ وَدَيني ما يُقتَضى",24,"ض",2,0],["عثراتُ الناسِ بالناسِ تُقَالُ","فإلى كم بيننا قيلٌ وقالُ",25,"ل",1,1],["عثرٌ مَن جَنى بِمرمى جحيمٍ","أَينَ يَجري بالعرجِ نكث العهودِ",26,"د",1,0],["عثرٌ من عنى بِمجرى مميحٍ","هاجَ حينٌ مِن عثر مجرى بعيدِ",27,"د",1,0],["عثرت مثل عثرَتي بصخور","فوقها زورق الحياة تحطم",28,"م",1,0],["عَثَرتُ في كُلِّ رَأيٍ قادَ نَحوَكُمُ","وَالعَثرُ في الرَأيِ لَيسَ العَثرُ في القَدَمِ",29,"م",1,0],["عثرت في غدرك بي","عثرةَ من لا وَألا",30,"ل",2,0],["عثرتَ يومَ العذَيبِ فاستقلِ","ما كلُّ ساعٍ يُحسُّ بالزَّلَلِ",31,"ل",1,1],["عثرنَ جيادي بالوشيج وربما","أعيدتْ وتيجانُ الملوك نِعالُها",32,"ل",3,0],["عثرة قلبي فيكم لا تقالْ","وإنما العذلُ حديثٌ يقالْ",33,"ل",1,1],["عَثْرَة َالعُمر.. أكبِري أنْ تُقالي","أنتِ فَوقَ الرِّضا ، وَفَوقَ السُّؤال ِ",34,"ل",1,0],["عثرَ الدهرُ بهِ بعدَهمُ","ليته قالَ وقد زلَّلعاً لَه",35,"ل",2,0],["عثرت به قد الشتاء فلا لعاً","إن لم يقلها رفعة وثواب",36,"ب",1,0],["عثرت بأطراف الفنا حول خدرها","وكم خادر عن جانبي ذلك الخدر",37,"ر",1,0],["عثمان يعلم أن المدح ذو ثمن","لكنه يشتهي مدحاً بمجَّان",38,"ن",1,0],["عُثُورُ الجَدِّ جَدَّ بِهِ أُناسٌ","وَشَانٍ شَنَّ شَاني شَانَ شَانِي",39,"ي",1,1],["عَثَرتُ وَلَولا اِنتِياشُ الإلهِ","لكنتُ صريعَ ردى عثرتي",40,"ي",1,1],["عثير رحلي به قد عثرت","ولعا ما قال قلبي ولعا",41,"ع",2,0],["عثمان وابن ثابت وجابرا","والشعري ذكروه آخرا",42,"ر",2,0],["عُثْمانُ جَدّكُم وَذَلِكَ حَسْبهُ","وَكَفى وَذَلِكَ حَسْبُكُم وَكَفاكُمُ",43,"م",1,0],["عَثَر الزمانُ فما أقالَك عَثرةً","ولقد تُقالُ لِغيرِكَ العَثَرات",44,"ت",1,0],["عثمانكم أضحى قُدارَ قبيلة","فكأن به لصعيده يتوَّسد",45,"د",1,0],["عَثَرات اللسان بِالمَرء تودي","أَن يَرى رَأسه سَقيط الحسام",46,"م",1,1],["عثر الدهر لا تقال","خيف منها على الأنام الزوال",47,"ل",1,1],["عِثَيْرٌ للطَّيرِ فيهِ مَرْقَدٌ","ولأَهْلِ الشِّركِ سُكْرُ المَرْقَدِ",48,"د",1,0],["عثرت على ما كان قلبي يحاوله","واسعفني دهري بما أنا أمله",49,"ل",2,1],["عثرات مثلك في الزمان كثيرة","ولهن بعد مثابة وجبور",50,"ر",1,0],["عثرنا فلم تفضح وعبنا فرحمة","سترت وأوليت العظيم من الوفد",51,"د",1,0],["عثمان يوم الدار لم يك جازعاً","جزعى لحرقة فرقة العثماني",52,"ن",2,1],["عثر الدهرُ فقولا لا لعاً","فخذا باللوم منه أو دعا",53,"ع",2,0],["عَثرَ الدهرُ ويرجو أن يُقالا","تَرِبت كفُّك من راجٍ محالا",54,"ل",2,1],["عثر الدهرُ فاستقال سريعا","رُبَّ عبدٍ عصى فآب مطيعا",55,"ع",2,1],["عثرتْ فجاوزت الإِقالة عثرةٌ","وطئت بها أنفي وأنفَ الجود",56,"د",1,0],["عثَرَ الحِمام من الكرِرام بربِّهم","إنَّ الردى بالأكرمين عَثور",57,"ر",1,0],["عثرت ذعرا فقلنا","والعا للعاثراتِ",58,"ت",1,0],["عثت مصغيةً تبي","ت لديك ترتقب النجاحا",59,"ح",2,0],["عثرتُ بأخفافِ المَطِّي فأسْبَلَتْ","مدامعُها في مدمعي المتتابعِ",60,"ع",1,0],["عثمان حليت بالسعد","ألا يا أحمد",61,"د",1,0],["عثر الدهر فيك عثرة سوء","لم يقل مثلها المعين المقيل",62,"ل",1,0],["عَثَّرْت سمعي في صفاتك فاكتسى","عِيّاً وما زال البليغ المُفْلِقا",63,"ق",2,0],["عِثْيَرٌ ضلت به بيض الظبا","فهداها برقها نحو الهواد",64,"د",1,0],["عُثمَانُ نُورُ ثَغرِهِ","مَعَ الجبينِ الزَّينِ",65,"ن",1,1],["عثر الدهر واِستَقال وانى","يغضب المجد ان يراني مقيلا",66,"ل",2,0],["عثر الزَمان فَلا لعاً مِن عاثرٍ","وَكَبا عَلى إِيمانهِ لا قاما",67,"م",2,0],["عَثر الدَهر فَاِستَقال وَأَنّى","لَست أَهدي لَسَمعه تَقريعا",68,"ع",2,0],["عَثر الزَمان فَلا لَعاً بِمهذب","كَم قَد أَقالَ مِن الزِمان عثارا",69,"ر",2,0],["عثرت بمدرجة الهوان فاقلعت","نهضا بعبء الحقد عن عثراتها",70,"ت",3,0],["عثرت ذلا وأنت عزاً","على نهوض لديك قدره",71,"ر",2,0],["عثمان ما كانت عدا","تك بالعدات الكاذبه",72,"ب",2,1],["عثمان يا ابن أخت يا عثمان","لك الجمال ولك البيان",73,"ن",1,1],["عثمان يروي بأسه عن حيدر","وقريضه المختار عن حسان",74,"ن",1,0],["عثمان يا قرة عين الجمال","وبهجة العليا وخدن الكمال",75,"ل",1,1],["عثرت بأعماق الحضيض بصخرة","فمذ صدمتْ رجلي علتْ بي الى السما",76,"م",2,0],["عثمان ناداك يا مختار خذ بيدي","يوم الجزا حين اخشى زلة القدم",77,"م",1,0],["عثمان امسى ولوعا حول ساحتكم","يذب عن غيظ اهليه ولو ضربا",78,"ب",2,0],["عثرت بِثَوب قُصورها فأقِم لَها","رَأساً عَلى الأَقران وَالنُقاد",79,"د",1,0],["عثرت بحب الغانيات فلا لعا","ورحت وما أبقيت للطهر موضعا",80,"ع",2,1],["عثمان يتلو لفاروق ويعقبه","ابو تراب وباقي عد عشرهم",81,"م",1,0],["عثر الزَمان فَلا لعا","وَقَضى الأَسى أَن نجزعا",82,"ع",2,1],["عثَر الدّهرُ دونَ قَصْدٍ فلوْلا","ناصِرُ الدّين ما وجَدْنا مُقيلا",83,"ل",2,0],["عثر الزمان وفي نظيرك","لم يكن في الناس عاثر",84,"ر",1,0],["عثر الزمان وما درى ماذا فعل","ولو استقال من الجناية لم يقل",85,"ل",1,1],["عثت فدعاها غيها بعد موطن","رحيب إلى شعب من البر ضيق",86,"ق",1,0],["عثمان يا عيد من يحظى بصحبته","بلّغت ما شئت في الأيام والناس",87,"س",1,1],["عثمان أعطى ابنيه والأخوين أل","قاباً تحل لمن تقلّدها الحبى",88,"ب",2,0],["عثرة العشق حقها أن تقالا","هكذا هكذا والأفلالا",89,"ل",2,0],["عُثمانُ يَعلَمُ أَنَّ الحَمدَ ذو ثَمَنٍ","لَكِنَّهُ يَشتَهي حَمداً بِمَجّانِ",90,"ن",1,0],["عثراتهن وإن عظمن مقالةٌ","وذنوبهن وإن كبرن صغار",91,"ر",1,0],["عَثَرْتُ يا دَهْرُ فَهَلْ مِن مُقِيلْ","وَقُلِّصَ الظِّلُّ وَما لِي مَقِيلْ",92,"ل",1,1],["عَثرتَه وبيعه لمّا غلط","إقالة وقد كننت في السَّفط",93,"ط",1,0],["عثرت بمعناك العقول كأنها","رجل البعوض تعثرت بأكام",94,"م",1,0],["عثر الجواد وكان مأمون الخطى","ونبا الحسام وكان صلت المضرب",95,"ب",1,0],["عثمانُ عمكمُ ولستم مثلَه","وبنو أميّةَ منكم كالآمر",96,"ر",1,0],["عَثابيَ داعي الشَّرِّ حَتَّى أَهَنتُهُ","وَعلِّيَ غِن أَستَغفِرِ الذَّنبَ يَغفِرِ",97,"ر",1,0],["عثمان نوري سما بِالسعد طالِعُه","وَلاحَ في أُفُقِ الشَهباءِ ساطعُهُ",98,"ع",2,1],["عثر الدهر فاستلان جماحي","وعراني من المصاب الخشوع",99,"ع",1,0],["عثر الزمان وفيك عثرته","فلعاً لذياك الزمان لعا",100,"ع",2,0],["عثمان ذى النورين بالمولى على","هو صنوك الكشاف للكربات",101,"ت",1,0],["عثر الزمان به فغودر جسمه","نهب القواضب والقنا المتقصد",102,"د",1,0],["عثمان ذي النُّورينِ بينَ الورى","مِن سؤدٍ سامٍ ومن فضلِ",103,"ل",1,0],["عثاكيل القطوف تمور تيها","وَليست من جنى الجاني أَبيَّه",104,"ي",2,0],["عثاكيلها الياقوت قد حَفَّ نورَهُ","زُمرد أغصانٍ تجلَّت زواهيا",105,"ي",2,0],["عثاكيلها حاكت عقود زمردٍ","هي القبَّة الخضراءُ تزهو كنبراسِ",106,"س",1,0],["عثرَت بأشراك المنية منهمُ","شِيبُ يزينها النهى وشباب",107,"ب",1,0],["عثرةٌ لا تقالُ عمر الليالي","عضبَ المجدُ عندها والمعالي",108,"ل",2,1],["عِث فيهم مثلَ ما عاثَت يَداه مَعاً","عَلى البَرامِكِ بِالتَّهديمِ لِلقُلَلِ",109,"ل",1,0],["عثر الدهر بي وقد جئت حراً","زاكي الأصل ينعش الأحرارا",110,"ر",2,0],["عَثَراتِ مَنْ عَبَدَ الهَوَى","وَلَها بانْصابِ النَّشَبْ",111,"ب",1,0],["عثمان ذو النورين من وجههِ","ومن جبين ضاء في كل آن",112,"ن",1,0],["عثمان ذو النورين قل مثيله","في الجود والإحسان والإمداد",113,"د",1,0],["عَثَرَتْ قّوافل فرحتي فتحدّرت","فوق الهشيم فهالها الترهيب",114,"ب",1,0],["عثى بي الوقت العسر دون تبرير","خذا معي بالجور صولة وجولة",115,"ل",2,0],["عثرات ودٍ كان يوماً باسقاً","فهوى... وعيني لا تجف مزونها",116,"ن",3,0],["عثمان ذي النورين التقي الاواب","الاجودي السخي سليل الكرامي",117,"م",2,0],["عثرت وطحت من سبّة جمال ٍ هالني مخضوض","وقلبي من قبل ما ألقاه ماقد صار به خضّه",118,"ض",2,0],["َعَثت إليك بطيفِها المكذُوبِ","من خوفِ رُؤيةِ كاشحٍ ورقيبِ",119,"ب",1,1],["عثر الزمان به فغادر جسمه","نهب القواضب والقنا المتقصد",120,"د",1,0],["عثرتُ عليه رغم اليأس, قلبا","يفّديني ويملؤني سلاما",121,"م",2,0],["عثمانُ لا عثمانهم ابدًا","والمصحف المأسور ينتحب",122,"ب",1,0],["عِثْنَا فَسَادًا وَ اسْتَبَحْنَا فَوْقَهَا","مَا حَرّمَتْهُ الْكُتْبُ وَ الْأَدْيَانُ",123,"ن",1,0],["عثمان ذي النورين بين الورى","من سؤدد سام ومن فضل",124,"ل",1,0]]}