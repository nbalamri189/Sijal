{"poems":[[74,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[93,"رؤيا منام رب حلم في الكرى","https://www.aldiwan.net/poem8727.html","عموديه"],[45,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem9442.html","الكامل"],[68,"للحسن حلاوة وبالعين تذاق","https://www.aldiwan.net/poem39631.html","الدوبيت"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[109,"كيف عشقت امرأة لم ألقها.. ؟","https://www.poetsgate.com/ViewPoem.aspx?id=214005",""],[119,"أبكى إلى الشام والمحبوب في يمن","https://www.aldiwan.net/poem41521.html","البسيط"],[208,"من عينه قط لم تلتذ بالنظر","https://www.aldiwan.net/poem53271.html","البسيط"],[347,"نيسان يا روح القلوب","https://www.aldiwan.net/poem55318.html","مجزوء الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122352","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38165","السلسلة"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79853","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87940","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132275","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131469",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132106","الخفيف"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131128",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34665","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125881","الرجز"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123957","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94601","البسيط"],[4772,"قالوا عيونكِ تلمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=191759",""],[4796,"رأي","https://www.poetsgate.com/ViewPoem.aspx?id=181221",""],[4852,"قصيدةٌ .. سِكِّين","https://www.poetsgate.com/ViewPoem.aspx?id=214887",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[4927,"مريم","https://www.poetsgate.com/ViewPoem.aspx?id=29635",""],[4927,"إيمان القريبة البعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=30177",""],[4940,"وزعت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205688",""],[4994,"يُحبُّهُ اللهُ وأُحبُّهُ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=208943",""],[5039,"كلمتين أو لعلها بوستين","https://www.poetsgate.com/ViewPoem.aspx?id=48111",""],[5085,"قالت لنا","https://www.poetsgate.com/ViewPoem.aspx?id=188399",""],[564,"حداةَ السُرى زَمْزِمُوا","https://www.poetsgate.com/ViewPoem.aspx?id=71784",""],[5102,"لا تطلبي","https://www.poetsgate.com/ViewPoem.aspx?id=12887",""],[5106,"مِنْ ضَوْءِ أَلْفِ صَبَاْحٍ قَدْ سَرَىْ","https://www.poetsgate.com/ViewPoem.aspx?id=150036",""],[5106,"هٰذي الشُّموسُ بَدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=150488",""],[5121,"خمرة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36281",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[5344,"الفلو والباك (برامج التواصل)..","https://www.poetsgate.com/ViewPoem.aspx?id=180702",""],[5351,"عشر همسات وهمسة","https://www.poetsgate.com/ViewPoem.aspx?id=202051",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5401,"بذر المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=85369",""],[5431,"أبي وسرمد تحنان على شفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192441",""],[5431,"الهجر ذباح ...","https://www.poetsgate.com/ViewPoem.aspx?id=194426",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5431,"كوب من البن !!...","https://www.poetsgate.com/ViewPoem.aspx?id=203341",""],[5431,"تغريبة الحضارة العربية ...","https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5458,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=72391",""],[5480,"من هموم ِ","https://www.poetsgate.com/ViewPoem.aspx?id=9868",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""],[5776,"درس الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=199339",""],[5848,"ست الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=53451",""],[5848,"ممنوعة اللمس","https://www.poetsgate.com/ViewPoem.aspx?id=53359",""],[5848,"فرحة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=50617",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5943,"تشطير لتشطير ( ماذا عساني في هواك )","https://www.poetsgate.com/ViewPoem.aspx?id=138285",""],[6093,"نسخة معدلة","https://www.poetsgate.com/ViewPoem.aspx?id=193066",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""],[6124,"سينية العشق","https://www.poetsgate.com/ViewPoem.aspx?id=128751",""],[6186,"الأساطير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82886&r=&rc=6",""]],"verses":[["والعشر قبَّل من يمناك خمستها","عشراً وعشراً ولا يروى من القبل",0,"ل",1,0],["وَالعُشبُ فيها سُندُسٌ مُتَمَوِّجٌ","وَالجَوُّ أَضواءٌ عَلى أَضواءِ",1,"ا",2,0],["وَالعِشقُ كَالمَعشوقِ يَعذُبُ قُربُهُ","لِلمُبتَلى وَيَنالُ مِن حَوبائِهِ",2,"ا",3,0],["وَالعِشقُ لَهُ مَرارَةٌ يَعرِفُها","مَن خَلَدَ في جَحيمِ نارِ الأَشواق",3,"ق",1,0],["وَالْعِشْقُ مَكْرُمَةٌ إِذَا عَفَّ الْفَتَى","عَمَّا يَهِيمُ بِهِ الْغَوِيُّ الأَصْوَرُ",4,"ر",1,0],["والعشق إن مس القلوب شقها..","وإن تكن حرائر استرقها",5,"ه",2,0],["والعش قيدني والحب أطلقني","والوعد أغفلني والبعد أرقني",6,"ن",2,0],["والعشق أكبر أن تُحصى كبائرُهُ","لكنَّ عشق العَمى من أكبر الكُبَرِ",7,"ر",1,0],["والعشب أخضر كالنقا","ء وكالحياء وكالاديب",8,"ب",1,0],["والعشق حزن لا يجاب وانما","مثلي له كل الحزون سهول",9,"ل",1,0],["وَالعشقُ يَأكلُ في الأَحشاءِ مِن حرق","كَالنّارِ تَأكُلُ بِالإِحراقِ في الحَطَبِ",10,"ب",1,0],["وَالعِشقُ كَسَعيرٍ تَحلّ مُهجَةَ صَبٍّ","إِن قسْتَ عَليها تَرى جَهنَّمَ ضَحضاح",11,"ح",1,0],["والعشبُ كادتْ توارى السائماتِ به","واخضرَّ ثم اسْتَوى سُوقاً وأعوادا",12,"د",2,0],["والعشقُ لا يملك فؤاد","ك فهو سلطانٌ يجورُ",13,"ر",1,0],["والعشقُ وحدهُ بذلُ الروح منيتُهُ","الوصل عهدُهُ والصدق استقامتُهُ",14,"ه",1,0],["والعشقُ جابي خراج الرُّوح من بشرٍ","عنها وهين ومأمورٌ ومعوان",15,"ن",1,0],["والعشق قطّع أوصالي وتيّمني","يا ليته ليته بالرفق أوصى لي",16,"ل",2,0],["والعشر فيما كيل من كلِّ ما","تغرسه في الأرض أو تزرع",17,"ع",1,0],["والعشرُ في أربعةٍ بعدها","من أنضرِ عقيانه أنصعُ",17,"ع",1,0],["والعشق في قلبي ثبت أساسه","وأما بنا صبري فقد تهدّم",18,"م",1,0],["والعشير الذيب اتخذت شريف","والمكان الذي نزلت مكاني",19,"ن",2,0],["والعشقُ جهلٌ والغرامُ فتنةٌ","ومَيِّتُ الأحياءِ مُغْرَمُ الدُّمَى",20,"ا",1,0],["والعشب حف بها لينمو إذ رأى","من وجهها ماء الشبيبة ساكبا",21,"ب",2,0],["وال عشراً من الصبو","حِ على وجهها الحسن",22,"ن",1,0],["والعشبُ قد مَلأَ الفَلا","تُحْيى الفصولُ جذورَه",23,"ه",1,0],["والعشب بين مسندس ومصندل","والزهر بين مفضفضٍ ومعسج",24,"ج",1,0],["والعشق داءٌ به إذلال صاحبهِ","وليس يرضاهُ إلّا كل مغبونِ",25,"ن",1,0],["والعشقُ ينجبُ غيمةً","من مُزْنِنا .....تتجرّع",26,"ع",1,0],["والعشقُ بَلْسَمَ كلَّ مابي قدْ ألَمْ","منْ جور ِكَونٍ كَمْ تَعَسَّفَ كمْ ظَلَم",27,"م",1,0],["والعشقُ مهما بغى .. تعويذةٌ بِجَفا","في متْنِها، (نَسِيَتْ) -والله- تفنيهِ",28,"ي",2,0],["وَالْعِشْقُ مِنْ صُنْعِ الْجَمَاْلِ، وَجُوْدِهِ(19)","وَقَبُوْلُهُ سَرَّ الْقُلُوْبَ، وَأَسْهَرَاْ",29,"ر",2,0],["وَالْعِشْقُ صَاْرَ تِجَاْرَةً عَبَثِيَّةً","فِيْهَا النُّقُوْدُ بِعَاْشِقٍ تَتَحَكَّمُ",30,"م",1,0],["وَالْعِشْقُ إِكْسِيْرُ الْحَيَاْةِ، وَمَاْ بِهَاْ","وَبِفِعْلِهِ تَتَبَّدَلُ الأَشْيَاْءُ",31,"ا",2,0],["والعشق مولود ويقطر ثغره","ذهبا، لماذا قبل موعده نُعِي؟؟",32,"ع",2,0],["والعِشقُ لَو زارَ الصَّحارى أزهَرَتْ","والعِشقُ لَو مَسَّ البَكيمَ تَكلَّما",33,"م",2,0],["والعشب وجنة ثرى والغيم شفة سما","هي كلها بوستين وكل حبٍ يسيل",34,"ل",1,0],["وَالعِشقُ يَصْدعُ بالفتى وشجونهُ","طَوْقاً بَدتْ وَبقيدِها مَكبولُ",35,"ل",1,0],["والعشاق بحال تهيجْ","مليحْ لما يعلموا",36,"و",2,0],["والعشق مرموز ببسمة ثغرك","وتفك شفرتَه ثمالةُ ريقكِ",37,"ك",1,0],["وَالعُشْبُ مِنْ وَرَفٍ فِي شَوْقِ مُبْتَهِلٍ","إِلاَّ يَمُرُّ بِجَنْبَيْهِ يُحَيِّيْهِ",38,"ي",2,0],["والْعُشْبُ دقَّتْ نفِيرَ الطَّلِّ فانتبهتْ","فيه العصافيرُ في الأعشاشِ تسقيها",39,"ي",3,0],["وَالْعُشْبُ مِنْ بَلَلِ الزُّهُورِ صَفَاؤُهُ","لَفَّ الفَرَاشَ بِرَوْنَقٍ وَوِشَاحِ",40,"ح",1,0],["والعُشُ يَحْمِي رَسُولَ اللهِ من خطَرٍ","وقُدرَة اللهِ فَاقَتْ حَدَّ عِلْمِهمِ",41,"م",1,0],["والعشق باثنين يحيا والشقاء لمن","قاسى لهيب الجوى والوجد من طرف",42,"ف",1,0],["والعَشَم يبقى بقلب اللي هقى","إن راية طيب خاطركم تلوح..",43,"ح",1,0],["والعشق حولهما يطوف فؤادهُ","فَرِحا ً فيا الله ما أحلاهما",44,"م",2,0],["والعشق داعبنا واللهو لاطفنا","وكل أهوائنا طيب لموعودِ",45,"د",1,0],["والعشق مره عسل وامرار سمٍ ذحاح","والنادر العشق لا غايه ولا مصلحه",46,"ح",2,0],["والعشق أنت فلا أخشى سفينته","تمضي بها الريح لكن أنت من تَرِدُ",47,"د",1,0],["والعشق ملحمةٌ بالوصل نازفة","ذاقت حلاوته بالسكر أرواح",48,"ح",1,0],["والعشق بئرٌ نازفٌ","والشربُ أمرٌ لايُتاح !!",49,"ح",1,0],["والعشق عند الذوق مكتشفٌ","قد تشتهي من رشفةٍ حتفه!",50,"ف",2,0],["والعشق يتلف من به يتلحفُ","منذا الذي بجحيمه لايُتلفُ !؟",51,"ف",1,0],["والعشق للسلم طبع من شمائلها","إن كان عدلاً وما صاغته ظلام",52,"م",1,0],["والعشق بلواه ياما عانق أطراف وحزوم","في صعود وفي تعليّ وف انعكاسات المرايا",53,"ا",3,0],["والعشب يزخر في سيوح وعراقيب","بجاه من نرجو عطاه وثوابه",54,"ب",2,0],["والعشب غطا باذره كل الاوهاد","من دافق الرايح تسابق عنوقه",55,"ق",2,0],["والعشقُ لغزٌ والحلولُ كثيرةٌ","قد حارِ فيهِ القائلونَ وحللّوا",56,"ل",3,0],["والعشق لا من تكسّر داخله قيده","تموت الاحلام مقتولة ومؤوده",57,"د",2,0],["والعشق دمعٍ نام خلف الكواليس","منديله الكتمان واصابعه خمس",58,"س",1,0],["والعشق اشوفه كثر ما تمطر اتعاسه","أحسه اكثر على قربك يكرّسني",59,"ن",2,0],["والعشيات عليهم هوّم","يتسنمن غصون الزيزفون",60,"ن",1,0],["والعشقُ أَغْرَى بي كما أغرَى بها","ما يَجمعُ الأحبابَ مِن أغرابِ؟",61,"ب",1,0],["والعشق فيه قد خبتْ دقاتُهُ))","(هيهات يأذن بالرجوع أفولُ",62,"ل",1,0],["وَالعِشْقُ آخِرُهُ مَدَامِعُ عَاشِقٍ","فَاقْرَأْ أَوَاخِرَهُ لِتَفْهَمَ أَوَّلَهْ",63,"ل",2,0],["وَالعِشْقُ إِنْ عَرَفَ النَّوَىْ بَاتَ الجَوَىْ","فِيْ ثَوْبِنَا ظِلُّ الرَّدَىْ وَمُحَرَّمُ",64,"م",1,0],["وَ العِشْقُ إنْ صَحَّ الجَوَى فِيْ هَمْسَتِيْ","عِطْرٌ بَدِيْعٌ شَقَّ قَلْبًا نَاعِسَا",65,"س",2,0],["والعشقُ أغرقني في قلب فاتنة","لكنها غرقت في بحر تنظيري",66,"ر",2,0]]}