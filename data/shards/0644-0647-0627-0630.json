{"poems":[[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[74,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[74,"له إذا غازلتك عيناه","https://www.aldiwan.net/poem20512.html","المنسرح"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[87,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[45,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[99,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[54,"يا راكبا فوق بغل","https://www.aldiwan.net/poem26571.html","المجتث"],[54,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[50,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147459","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1914","الطويل"],[113,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[164,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[302,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[371,"الحسن جاد على الأحباب فازدادوا","https://www.aldiwan.net/poem17180.html","البسيط"],[463,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[482,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[563,"إني أنا المكتوب في الطرس","https://www.aldiwan.net/poem34445.html","السريع"],[735,"","https://poetry.dctabudhabi.ae/diwan/poem/45445","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119869","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59275","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17000","الطويل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102112","الوافر"],[2128,"","https://poetry.dctabudhabi.ae/diwan/poem/143659","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10482","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121026","الوافر"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58488","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35512","السريع"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119481","الوافر"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104534","البسيط"],[5431,"فتطوى له الأكوان طيّ الشرائح","https://www.poetsgate.com/ViewPoem.aspx?id=192308",""],[4442,"الشعر سبك وسبك الشعر أجناس","https://www.poetsgate.com/ViewPoem.aspx?id=171020",""]],"verses":[["لَهُ أُذُنانِ تَعرِفُ العِتقَ فيهِم","كَسامِعَتَي مَذعورَةٍ وَسطَ رَبرَبِ",0,"ب",1,0],["لَها ذَنَبٌ مِثلُ ذَيلِ العَروسِ","تَسُدُّ بِهِ فَرجَها مِن دُبُر",1,"ر",1,0],["له إذا حاولت نهب اللهى","خزائن ليست بخزَّان",2,"ن",1,0],["له إذا غازلتْك عيناه","سهامُ لحظٍ أجاركَ الله",3,"ه",1,1],["له إذا ما القُمُدُّ خالطه","أزم كأزم الخناق بالعنق",4,"ق",1,0],["له إذا جاوَب الطنبورَ محتفلاً","صوتٌ بمصر وضربٌ في خراسان",5,"ن",1,0],["لَهُ إِذا هَبَّ الجَوى صَرعَةٌ","مِن دونِها السِحرُ وَفِعلُ المُدام",6,"م",1,0],["لَهُ إِذا أَدبَرَ لَحظُ المُقبِلِ","كَأَنَّما يَنظُرُ مِن سَجَنجَلِ",7,"ل",1,0],["له إذا دوَّى به ساخراً","ضِحكُ التَشَفِّي وجنونُ الطغاة",8,"ا",2,0],["لَهُ إِذا ما تَمَشّى","قَفاً إِلَيها شَهِيِّ",9,"ي",1,0],["لَها ذَنَبٌ مِثلُ خَوصِ العَسيبِ","وَأَربَعَةٌ تَرتَمي بِالحَصى",10,"ا",1,0],["لَها ذُيولٌ مِنَ العِقيانِ تَتبَعُها","في الشَرقِ وَالغَربِ في نورٍ وَظَلماءِ",11,"ا",2,0],["له إذا ساءلوه صمتُ","يطارح الألسن الفصاحا",12,"ح",2,0],["لها ذنب كالتاجرين وخنجرا","جناحين قد قدا بها يَجرح الصبا",13,"ب",2,0],["لَها ذُكْرَةٌ عِنْدِي وَطَيْفٌ كِلاهُما","بِتِمْثَالِها غادٍ عَليَّ ورائِحُ",14,"ح",1,0],["لَهُ أُذُنانِ تَعرِفُ العِتقَ فيهِما","كَسامِعَتَي مَذعورَةٍ وَسطَ رَبرَبِ",15,"ب",1,0],["لَهُ إِذناً سَمع إِذا صاحَ صائِحٌ","تَشوق لِأَوانٍ عَراهُ نَفارُ",16,"ر",1,0],["له إذا الخطب دجى يقظة","كأنها هيبة نصل يمان",17,"ن",1,0],["له أذعَنَت شمسُ العُداة مهابَةً","وَلَم يَخشَ لَو لَم تستذلَّ اِمتناعها",18,"ع",3,0],["لَهُ إِذا سُلَّ سَيفُ المَدحِ أَربَعَةٌ","غَيظٌ وَوَثبٌ وَإيقادٌ وَإِزنادُ",19,"د",1,0],["له إذا امتدّ باعُ همّته","ذكرِي بالعيب والمحاسنُ لي",20,"ل",2,0],["له إذا أنشدوه في مجالسهمْ","عَرْفٌ يُخَجَّلُ في ناديهمُ القُطُرا",21,"ر",2,0],["لها ذوات وصفات على","تعدادهم في حالة اللبس",22,"س",1,0],["لَها ذَفَراتٌ مِن بَوادِرِ عِثْيَرٍ","يَشُقُّ اِنهِمالَ المَعدَنِيِّ اِنسِحالُها",23,"ل",3,0],["له إذا ما لم يعن باذل","مكارم عون وأبكارُ",24,"ر",1,0],["لَهُ إذْ برَاهُ اللَّهُ في الحسنِ مُفْرَدٌ","ثَمَانِيَةٌ فَأعْجَبْ لِفَردٍ يُقَسَّمُ",25,"م",1,0],["لَها ذَنَبٌ وافي الجَوانِبِ مِثلَ ما","تُقَشِّرُ طَلعاً أَو تُجَرِّدُ مَنصِلا",26,"ل",2,0],["له إذا ما علوته نفس","أمضى من السيف في يد البطل",27,"ل",1,0],["له إذ قلتُ مذ بانَت","محاسِنهُ وقد زانَت",28,"ت",1,0],["لها ذنب في رأسه ذنب له","إذا جر منها رد في جوفها طعنا",29,"ن",2,0],["لَها ذَنَبٌ مِثلُ ذَيلِ الهَدِيِّ","إِلى جُؤجُؤٍ أَيِّدِ الزافِرِ",30,"ر",1,1],["له إذ يرتوي طَيشانُ صادٍ","ويسكنُ حين يعروهُ الأوامُ",31,"م",1,0],["لها ذارياتُ الرُّعبِ كالطُّورِ نَجمُها","سنى قمرٍ منهُ رفيعُ المَنَاصِبِ",32,"ب",1,0],["لهُ إذا هاجَهُ نِفارٌ","منْ خَصمهِ وَثبَةٌ الأسودِ",33,"د",1,0],["لَهُ إِذا آنسَ بَرق الحِمى","جَوانِح تَخفق خَفق الجَناح",34,"ح",1,0],["لها ذنب كصيصية أتمت","وصدر مثل خافية الحمام",35,"م",1,0],["له إذا انتاش عرضا أو نحا غرضا","جوارح كل ما فيهن أضراس",36,"س",1,0],["لها ذبّح الشوق العتيّ حشاشتي","وإن كان ذبّاح الضلوع الصحائحِ",37,"ح",1,0],["له أذا أنتاش ممرضا أو نحى غرضا","جوارح كل ما فيهن أضراس",38,"س",1,0]]}