{"poems":[[154,"خير الأخلاء من حلتك صحبته","https://www.aldiwan.net/poem68435.html","البسيط"],[409,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124492",""],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89518","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118788","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87400","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"]],"verses":[["وقلَّ ذلك إلاَّ ما سمعت به","على التواتر من أوصاف رشدين",0,"ن",1,0],["وقل ذا دليل بأن الفتى","شديد الوفا بشروط الصحب",1,"ب",1,0],["وقل ذا لسدين الحبر سيدنا","لكن ذا سفر حتمٌ له السفر",2,"ر",1,0],["وَقَلَّ ذاكَ لِمَغنىً قَد سَحَبنَ بِهِ","ذَيلَ التَصابي بِرَسمِ الشَجوِ غِزلانُ",3,"ن",1,0],["وقل ذاك المعنى هام وجداً","بكم في كل مرتبع ونادِ",4,"د",1,0],["وقلَّ ذاك لدى فضلٍ غدوتَ بِهِ","ناراً على الطَودِ او نوراً باوج سَما",5,"م",2,0],["وَقَلَّ ذَا فِى جَمعِ تَصحِيحٍ وَمَا","ضَاهَى وَغَيرُ ذَينِ بِالعَكسِ انتَمَى",6,"م",2,0],["وَقُل ذا عُبَيد آبِق جاءَ تائِباً","عَسى رَحمَةَ المَولى يَسُرُّ بِها العَبدُ",7,"د",1,0]]}