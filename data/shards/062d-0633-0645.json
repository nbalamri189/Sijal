{"poems":[[53,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[45,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[51,"ليبك رسول الله من كان باكيا","https://www.aldiwan.net/poem63203.html","الطويل"],[82,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[51,"ركنَّا إلى الدنيَا الدنئة ِ ضلَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=2741",""],[190,"حسم الجريمة قبل عذرك","https://www.aldiwan.net/poem43515.html","مجزوء الكامل"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[280,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138323",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138332",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48792","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119301","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67204","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101821","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129487","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139523",""],[4984,"الفارق","https://www.poetsgate.com/ViewPoem.aspx?id=191328",""],[5205,"خطرت وقد خطرت هواتف خاطري","https://www.poetsgate.com/ViewPoem.aspx?id=120991",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""]],"verses":[["حَسَمَ الإدغالَ عزمٌ","منك صَمْصامٌ حُسامُ",0,"م",1,0],["حَسَمَ الصُلحُ ما اِشتَهَتهُ الأَعادي","وَأَذاعَتهُ أَلسُنُ الحُسّادِ",1,"د",1,1],["حَسَمتَ المُنى يا مَوتُ حَسماً مُبَرِّحاً","وَعَلَّتَ يا مَوتُ البُكاءَ البَواكِيا",2,"ي",2,0],["حَسَمَ المظالمَ عادلاً فكأنّهُ","من سيرة العُمرَيْن جَدّدَ ما بَلي",3,"ل",2,0],["حَسَمْتَ منه قديمَ الداءِ مُتّصِلاً","بالجاهِلِيّةِ لاهٍ بالعِدَى هَزِل",4,"ل",1,0],["حسمْتَ المُنَى يا موتُ حسماً مُبرِّحاً","وعلَّمْتَ يا مَوْتُ البُكاءَ البواكِيا",5,"ي",2,0],["حسم الجريمة قبل عذرك","والشكر يحبط ذنب كفرك",6,"ك",1,1],["حَسَمَت فيهِ بِالصَوارِمِ آرا","ؤُكَ داءَ العَدُوِّ وَالبَغيُ داءُ",7,"ا",2,0],["حَسَمَ الأوْجالَ شَهْماً بَطلا","وَفَرى الأحوالَ عَضْباً ذَكَرا",8,"ر",2,0],["حسمَ الأدواءَ طَبٌّ ما رأى","جِلدةً معرورةً إلا كواها",9,"ا",3,0],["حسمت مشكل دير ثار ثائرهُ","فنلت شكراً به كل امرئ سجعا",10,"ع",2,0],["حسم الضغائن من قلوب مثلما","حسم الصعاب بحده المرهوف",11,"ف",1,0],["حسمتَ الذي بين الأمير وعمه","من الخلف بعد الظن أن ليس يُحسم",12,"م",1,0],["حسمت سياستكم خصاماً كنتمُ","فيه أعف تغاضباً وملاما",13,"م",2,0],["حسمت بسيف اليأس أسباب سلمه","كما حسمت قبلي الرؤوس الأحامس",14,"س",1,0],["حَسَمُوا فتنةَ الجمالِ بِسِجنٍ","ضَمَّ من كُلُّ أهلِهِ أنبياء",15,"ا",2,0],["حَسَمَتْ يداهُ يدَ العُلى","حَسمت يداهُ الحاسمه",16,"م",2,0],["حسموا يديه وهامه ضربوه في","عمد الحديد فخر خير طعين",17,"ن",1,0],["حَسمت يَديهِ المرهفاتِ وَإِنَّهُ","وَحسامَهُ مِن حدهنَّ لَأَحسم",18,"م",1,0],["حسمت امارات الغرام بزورة","تقضت وعين النجم وسناء تلمح",19,"ح",1,0],["حَسمَ المعضلات منه برأىٍ","دونه المرهفات تنبو ذبابا",20,"ب",2,0],["حسْمُ الإرادة فيه كل عزيمة","ودوامك المحمودَ يصنع فارقا",21,"ق",2,0],["حسمت وما سمحت عرا وحشت حشاً","ونوت نوى أوهت قوى من قادر",22,"ر",1,0],["حسم القضاء يمينه ويساره","بمضاء عضب لم يزل مسلولا",23,"ل",2,0],["حُسِمَ الأَمرُ وما زالتْ على","وهمها بين نزولٍ وطُلوعْ",24,"ع",1,0],["حسم الحسام مقلة لسقائه","في ضربة ومجيلة للوائه",25,"ا",3,0]]}