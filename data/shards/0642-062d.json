{"poems":[[3,"سلي يا ابنة العبسي رمحي وصارمي","https://www.aldiwan.net/poem205.html",""],[79,"قحطنا ثم صاب الغيث رحمى","https://www.aldiwan.net/poem36686.html","الوافر"],[53,"زلقت رجل شنطف في خراها","https://www.aldiwan.net/poem7993.html","الخفيف"],[53,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[45,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[41,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[41,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140857",""],[199,"لو أطعتك يا غرار كسوتني","https://www.aldiwan.net/poem54379.html","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87865","البسيط"],[1920,"","https://poetry.dctabudhabi.ae/diwan/poem/200379","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60909","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114527","الطويل"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127768","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141592","الكامل"],[4859,"يد الحروب!","https://www.poetsgate.com/ViewPoem.aspx?id=214877",""],[4929,"القدس والخونة","https://www.poetsgate.com/ViewPoem.aspx?id=199525",""],[5002,"أحزنتني يادهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206680",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5206,"قاف الوادي المُقَدَّس","https://www.poetsgate.com/ViewPoem.aspx?id=187388",""],[5206,"قاف بوادي الملك","https://www.poetsgate.com/ViewPoem.aspx?id=187387",""],[5387,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=53149",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5956,"انعزال","https://www.poetsgate.com/ViewPoem.aspx?id=192174",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""]],"verses":[["قَحَمتُ بِها بَحرَ المَنايا فَحَمحَمَت","وَقَد غَرِقَت في مَوجِهِ المُتَلاطِمِ",0,"م",1,0],["قَحَطْنا ثمّ صابَ الغَيثُ رُحْمَى","فشُكْراً يا حَمامُ إذا لَغَطْتَا",1,"ت",2,1],["قَحْبَةٌ كلبةٌ نَخُورٌ صبورٌ","حين تَلقى طعنَ الأُيور كُلاَهَا",2,"ا",3,0],["قحبة تركب الأيو","ر فيها تعسُّف",3,"ف",1,0],["قحطتْ فلما آن مَنْهَضُهُ","جادتْ بِغَوْثِ الناس والنَّعَمِ",4,"م",1,0],["قُحٍّ يَكادُ صَهيلُ الخَيلِ يَقذِفُهُ","عَن سَرجِهِ مَرَحاً بِالغَزوِ أَو طَرَبا",5,"ب",2,0],["قَحطانُ تَضرِبُ رَأسَ كُلِّ مُتَوَّجٍ","وَعَلى بَصائِرِها وَإِذ لا تُبصِرُ",6,"ر",1,0],["قَحطانُ جيبَت لِكَهلانَ المُلوكِ كَما","جيبَ القَبائِلُ مِن كَهلانَ عَن أُدَدِ",7,"د",1,0],["قحٍّ يكاد صهيل الجرد يقذفه","عن سرجه مرحاً بالعز أو طربا",8,"ب",2,0],["قَحطانُ والِدُنا الَّذي نُدعى لَهُ","وَأَبو خُزَيمَةَ خِندَفُ بنُ نِزارِ",9,"ر",1,0],["قُحُّ الأَرومَةِ خُلصاني ثِقاتُ تُقى","إِنّي فُطِرتُ عَلى مِصداقِ تَوحيدِ",10,"د",1,0],["قحطٌ ربيعك والشّموس لوافحٌ","حزنٌ ثمارك والهموم قطافُ",11,"ف",1,0],["قحطانُ هود أبونا لو ذكرت له","وقاسماً قال أنتم نصرتي وبني",12,"ن",2,0],["قُحَمٌ أَعان النصرُ فيها صبره","والصبرُ عون النصرِ ما لم يَضجَرِ",13,"ر",1,0],["قحمت ببحرٍ من صفاتِهِ مُغرِقٍ","ولكنني من فضلِهِ لي زَورقُ",14,"ق",1,0],["قحمت بشهب النظم بالرجم فيهم","فدعني ومن أخلاقهم لا توفقُ",15,"ق",1,0],["قحب السري وأي شهم ماجد","بين البرية مثله لا يقحب",16,"ب",1,1],["قحط من الأفراح دنياي التي","أمّلتها وحمى الأمان قفار!",17,"ر",1,0],["قحِلتْ من الشرف التليد نفوسهم","وتعذرت في غيمها الأمطارُ",18,"ر",1,0],["قَحُلَتْ مَرابِع مُهْجَتي والمُشْتهَى","لا نكهةً بقيتْ يُحَلِّيها المُنَى",19,"ن",2,0],["قحطان لاصا ر الخطر بأول الخيل","لأجالها ضداً عنيدً تضده",20,"د",2,0],["قَحَمَتْ بِهِم وَادِي المُقَدَّسِ بِالهُدَى","نُودُوا أَلَا هَذِي الحَقَايِقُ تَنْطِقُ",21,"ق",1,0],["قَحَلْتُ وَأَضْنَانِي مِنَ النَّفسِ بُطْلُهَا","وَلَيسَ لَهُ إِلَّا الدِّرَايَةُ تَمحَقُ",22,"ق",1,0],["قَحَمْتُ بَوَادِ المَلْكِ حَوْبًا لِشَطئِهِ","فَنُودِيتُ: إسْمَعْ بِالحَقَايِقِ تَنْطِقُ",22,"ق",1,0],["قحطٌ من دونكِ أيامي","ورمالٌ عطشى وصحاري",23,"ر",2,0],["قحطٌ بنبع حقوله","ومعظّمٌ ليكفّره",24,"ر",2,0],["قحمنا بها كلّ مجهولةٍ","تهيّبت الجنّ أهوالها",25,"ل",3,0],["قحِلتْ عهودي الزاهراتُ جميعُها","نشفتْ يداي وقد أبيع المسكنا",26,"ن",2,0],["قحط الطبيعة زاد قحط عقولهم","وهم الجناة وشعبهم يغتالُ",27,"ل",1,0]]}