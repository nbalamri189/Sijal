{"poems":[[3,"سلي يا ابنة العبسي رمحي وصارمي","https://www.aldiwan.net/poem205.html",""],[77,"قحطنا ثم صاب الغيث رحمى","https://www.aldiwan.net/poem36686.html","الوافر"],[51,"زلقت رجل شنطف في خراها","https://www.aldiwan.net/poem7993.html","الخفيف"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[39,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140857",""],[196,"لو أطعتك يا غرار كسوتني","https://www.aldiwan.net/poem54379.html","الكامل"]],"verses":[["قَحَمتُ بِها بَحرَ المَنايا فَحَمحَمَت","وَقَد غَرِقَت في مَوجِهِ المُتَلاطِمِ",0,"م",1,0],["قَحَطْنا ثمّ صابَ الغَيثُ رُحْمَى","فشُكْراً يا حَمامُ إذا لَغَطْتَا",1,"ت",2,1],["قَحْبَةٌ كلبةٌ نَخُورٌ صبورٌ","حين تَلقى طعنَ الأُيور كُلاَهَا",2,"ا",3,0],["قحبة تركب الأيو","ر فيها تعسُّف",3,"ف",1,0],["قحطتْ فلما آن مَنْهَضُهُ","جادتْ بِغَوْثِ الناس والنَّعَمِ",4,"م",1,0],["قُحٍّ يَكادُ صَهيلُ الخَيلِ يَقذِفُهُ","عَن سَرجِهِ مَرَحاً بِالغَزوِ أَو طَرَبا",5,"ب",2,0],["قَحطانُ تَضرِبُ رَأسَ كُلِّ مُتَوَّجٍ","وَعَلى بَصائِرِها وَإِذ لا تُبصِرُ",6,"ر",1,0],["قَحطانُ جيبَت لِكَهلانَ المُلوكِ كَما","جيبَ القَبائِلُ مِن كَهلانَ عَن أُدَدِ",7,"د",1,0],["قحٍّ يكاد صهيل الجرد يقذفه","عن سرجه مرحاً بالعز أو طربا",8,"ب",2,0],["قَحطانُ والِدُنا الَّذي نُدعى لَهُ","وَأَبو خُزَيمَةَ خِندَفُ بنُ نِزارِ",9,"ر",1,0]]}