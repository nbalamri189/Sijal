ي النبي يا ابن علي","https://www.aldiwan.net/poem31970.html","الخفيف"],[251,"لي من الشمس خدمة صفراء","https://www.aldiwan.net/poem14922.html","الخفيف"],[255,"قلب عنيد","https://www.aldiwan.net/poem24960.html","مجزوء الرمل"],[255,"كفى عنادا","https://www.aldiwan.net/poem36218.html","مجزوء الرمل"],[276,"أنت يا شغل خاطري نصب عيني","https://www.aldiwan.net/poem25547.html","الخفيف"],[298,"خطرت في شمائل ونعوت","https://www.aldiwan.net/poem33316.html","الخفيف"],[329,"غن عذراءك يا شاطىء","https://www.aldiwan.net/poem54988.html","مجزوء الرمل"],[329,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[329,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[329,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[329,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[329,"يا بخيلا وكل نظرة عين","https://www.aldiwan.net/poem55026.html","الخفيف"],[343,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[354,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[367,"ما معالشيب حديث في غزل","https://www.aldiwan.net/poem17387.html","الرمل"],[394,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[401,"العصفورة الراحلة","https://www.aldiwan.net/poem6783.html","عموديه"],[480,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[501,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[516,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[539,"قدمي لا عشت لي من قدم","https://www.aldiwan.net/poem47597.html","عموديه"],[559,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[576,"أنا أهوى والعذل عندي أهون","https://www.aldiwan.net/poem2843.html","الخفيف"],[576,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[576,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["أَنتَ يا فارِسَ الكَلامِ تَقَدَّم","تَ وَأَخلَيتَ لي مَكانَ الرَديفِ",0,"ف",1,0],["أنت يا جاهل من قبل الممات","ميّت يمرح ما بين البُيوت",1,"ت",1,0],["أنت يا شمس على كرّ السنين","قد تَقَلّبتِ طلوعاً في الورى",1,"ر",2,0],["أنت يا شيخُ نائمٌ فتنبَّهْ","وانتصِحْنِي فلسْتُ من غُشَّاشِك",2,"ك",1,0],["أنَت يقظانٌ لهذا ال","خَلْق والخَلْقُ نيامُ",3,"م",1,0],["أَنتَ يا بَحرُ أَسيرٌ آهِ ما أَعظَمَ أَسرَك","أَنتَ مِثلي أَيُّها الجَبّارُ لا تَملِكُ أَمرَك",4,"ك",1,0],["أَنْتَ يا كاهِنَ الظَّلامِ حياةٌ","تعبدُ الموتَ أَنْتَ روحٌ شقيُّ",5,"ي",1,0],["أنتَ يا شِعْرُ فلذةٌ مِنْ فؤادي","تَتَغَنَّى وقِطْعةٌ مِنْ وُجُودي",6,"د",2,1],["أَنْتَ يا شِعْرُ قصَّةٌ عن حياتي","أَنْتَ يا شِعْرُ صورةٌ مِنْ وُجودي",6,"د",2,0],["أَنْتَ يا شِعْرُ إنْ فَرِحْتُ أغاريدي","وإنْ غنَّتِ الكآبَةُ عُودي",6,"د",2,0],["أَنْتَ يا شِعْرُ كأسُ خمرٍ عجيبٍ","أَتلهَّى به خلالَ اللُّحودِ",6,"د",1,0],["أَنْتَ يا قلبيَ قلبٌ أنضجَتْهُ الزَّفَراتْ","أَنْتَ يا قلبيَ عُشُّ نَفَرَتْ عنهُ القَطَاةْ",7,"ه",1,0],["أنت يا سعد طود خطير","يرجع الطرف عنه وهو حسير",8,"ر",1,0],["انت يا من بهرت بالشعر عيني","شاعر المشرقين والمغربين",9,"ن",1,0],["انت يا عقل في جميع حياتي","سند ينتهي اليه اعتمادي",10,"د",2,0],["انت يا ليلى كنت ماثلة لي","كل يوم في يقظتي وهجودي",11,"د",2,0],["انت يازخار جبار ولا","يبطش الجبار الا علنا",12,"ن",2,0],["أَنتَ يا فَوقَ أَن تُعَزّى عَنِ الأَح","بابِ فَوقَ الَّذي يُعَزّيكَ عَقلا",13,"ل",2,0],["أَنتَ يَروي نَداكَ كُلُّ ذَوي الفَق","رِ وَذا مَن نَداهُ يَروي القِفارُ",14,"ر",1,0],["أنتَ يا رقةً تذيبُ القلوبَا","وتذيبُ الصخرَ الأصمَّ المذيبَا",15,"ب",2,0],["أنت يا معجزة الحسن ملك","كل لفظ منك شعرٌ قُدُسيّ",16,"ي",1,0],["أنت يومي وغدي أنت وما","من زمان مرّ بي لم تك همي",17,"ي",1,0],["أنتَ يا كاملَ الحجا","والكلامِ المصحَّحِ",18,"ح",1,1],["أَنتِ يا قُرَّةَ عَيني فَاِعلَمي","عِندَ نَفسي عِدلُ سَمعي وَبَصَر",19,"ر",1,0],["أَنت يا وَرقاء مِن دون الأَنامِ","تَسمَعين النوح مني في الظَلام",20,"م",1,0],["أَنتِ يا نُعمُ شَقوَةٌ عَرَضَت لِي","بِئسَ حَظّاً مِنَ الكَريمِ الشَقاءُ",21,"ا",2,0],["أَنتَ يا اِبنَ الرَبيعِ أَلزَمتَني النُس","كَ وَعَوَّدتِنيهِ وَالخَيرُ عادَه",22,"د",2,1],["أَنتِ يا عَينُ كُنتِ لي","لِلصَباباتِ سُلَّما",23,"م",2,0],["أَنتِ ياقوتَةٌ قَدَرتُ عَلَيها","لا أُحِبُّ الشَريكَ في الياقوتِ",24,"ت",1,0],["أَنتِ يا نَفسُ أَنيبي","آبَتِ الشَمسُ فَأوِبي",25,"ب",2,1],["أَنتَ يا آدَمٌ آدَمُ السِربِ حَوّا","ؤُكَ فيهِ حَوّاءُ أَو أَدماءُ",26,"م",3,0],["أَنتَ يا شعر خالد","أَنا يا شعر هالك",27,"ك",1,1],["أَنتَ يا شعر كل ما","أَنا في الكون مالك",27,"ك",1,0],["أَنت يا لَيلى كل ما أَتمنا","ه لِنَفسي أيام عمري الباقي",28,"ق",2,0],["أنت يا من جعلت روض حياتي","مهدَ وردٍ إليك وردك رُدَّا",29,"د",2,1],["أنتِ يا هذه البحيرةُ ماذا","يكتمُ الموجُ فيك والشطآنُ",30,"ن",1,0],["أنتِ يا أيَّتُها الشَّمسُ اطلعي","من وراء الليل والغيم الرُّكامِ",31,"م",1,0],["أنتِ يا من عُدْتِ بالذكرى وأحلام الليالي","يا ابنةَ النَّهر الذي غنّاهُ أربابُ الخيالِ",32,"ل",1,0],["أنتِ يا ساريةَ الفجر اسمعي","دعوةَ الروح البريء الطاهرِ",33,"ر",1,0],["أنتِ يا من شهدتِ فجرَ غرامي","ووعيْتِ الغداةَ سِرَّ الدهورِ",34,"ر",1,0],["أَنْتَ يا ليلُ أَنْتَ ذرّةٌ صَعَدَتْ لل","كون من مَوْطِئ الجحيمِ الغَضوبِ",35,"ب",1,0],["أَنْتِ يَا مَن سَقَتْ فؤَادِي مِنْهَا","حَرَّ وَجْدٍ وَلَوْعَةٍ وَخُفوقَا",36,"ق",2,0],["أَنْتَ يَا سِيِّدِي عَلَى مَا عَلِمْنَا","أًنْتَ تَأْبَى كُلَّ الإِبَاءِ الْمَدِيحَا",37,"ح",2,1],["أنتَ يا لُبْنانُ عَزْمٌ ونُهىً","لستَ من صخرٍ ولا من حَصَب",38,"ب",1,0],["أنتِ يا مِصْرُ جَنَّةُ اللّهِ في الأرْ","ضِ وعَيْنُ العُلاَ وَوَاوُ الوجودِ",39,"د",1,0],["أنتِ يا مِصْرُ بَسْمةٌ في فم الْحُسْن","ودمعُ الْحَنانِ فوقَ الْخُدُودِ",39,"د",1,0],["أنتِ يا مِصْرُ صَفْحَةٌ مِنْ نُضَارٍ","لَمَعَتْ بَيْنَ سَالِفَاتِ العُهُودِ",39,"د",1,0],["أنتِ يا عابدينُ خَيْرُ بناءٍ","مَدَّ أفْياءَهُ على خَيْرِ آل",40,"ل",1,0],["أنتِ يَمُّ الحسن فيه ازدحمتْ","زُمَرُ العشَّاقِ كُل بسِقاء",41,"ا",2,0],["أنت، يا سعدُ، نلتَ تأييدَ قومٍ","يزنون الكلام بالمِثقال",42,"ل",1,0],["أنت، يا صَاحِ، صَالِحٌ للْمَعَالي","وشَهَابًا به يُنِيرُ الظلام",43,"م",1,0],["أَنت، يا نيلُ، معرضٌ للحضارا","تِ، وشتَّى الشهوبِ والأديان",44,"ن",1,0],["أنت، يا نيلُ، فاتحٌ فتحَ المُدْ","نَ بغير الحديد والنيران",44,"ن",1,0],["أنتِ يا مصرُ من قديم اللَّيالي","كعبةُ السائحين والسائحات",45,"ت",1,0],["أنت، يا شعرُ، سلوتي إن قسا الده","رُ، وكادت بين الشدائد تودي",46,"د",2,0],["أنت - يا شاعر الحياة - حياة","و\" كمنج \" حيّ ودنيا ظليلة",47,"ل",2,0],["أنت يا كلّ من أحبّ وأهوى","في حنيني شعر وفي الصمت نجوى",48,"و",2,1],["أنت يا سارية الفجر اسمعي","دعوة الرّوح البرئ الطّاهر",49,"ر",1,0],["أنت يا آمال قد عاهدتني","بالوفا لا لا تخوني عهدنا",50,"ن",2,0],["أنتي.؟ توفقتي.. بشوف المقدّي..","وأنا....؟ توفّقت . بسوااليف...؟ شاتم",51,"م",1,0],["أنت.. ياللي تشعل .. الطرس.. بشموع الحبر.","كنت .. أحسب أنك. تميرض.. وأثاريك.. المريض..",52,"ض",1,1],["أنتي خلاصه خلط لولو بياقوت","ووأنتي حكايات ألف ليله وليله",53,"ل",2,0],["أنت يل ربّ غاية وإلى","الغاية أنت الهدى وأنت السبيل",54,"ل",1,0],["أنت يا موت بالجميع تحيق","ما نجا حتى اليوم منك رفيق",55,"ق",1,0],["أَنتَ يا مَن تَنقاد طَوعاً إِلَيهِ","وَاِمتِثالاً قُلوبَنا وَاختِيارا",56,"ر",2,0],["انت يا رب كريم","مرتجيه لن يزيغ",57,"غ",1,0],["انت يا بارق الحمى فيك سر","كم طوى في اسرارنا اسرارك",58,"ك",1,0],["أنتَ يا مولاى ذُو فضلٍ عظيمْ","أنت يا مولى الورى مولَى كريمْ",59,"م",1,0],["أنت يا ربي بأسرارِي عليمْ","أنتَ يا مولاى رحمنٌ رحيمْ",59,"م",1,0],["أنتِ يا مُقلتي أسقمْتِ حالِي","بطموحٍ إلى ذوات الحِجَالِ",60,"ل",1,1],["أنت يا ابن الكرامِ أكبرهم مجداً","وأنداهم نداً ووجودا",61,"د",2,0],["أنت يا ذا النوال كاسمكِ حقّاً","وأنا قد بلغتُ المُرادا",62,"د",2,0],["أنت يا كاسي وما أقربنى","منك في أعماق معناك الختيم",63,"م",1,0],["أَنتَ يا ظَبيُّ طَليقٌ آمِنٌ","فَاِغدُ في الغِزلانِ مَسروراً وَرُح",64,"ح",1,0],["أَنت يا يحيى كريمٌ والذي","أنت ترجوه يحبُّ الأكرمينا",65,"ن",2,0],["أنت يا مهد هواها","ورؤاها وهوايا",66,"ي",2,0],["أنت يا ملهم قلبي","الشعر جدّدت أسايا",66,"ي",2,0],["أنتَ يا مسرحَ الأسى والرزايا","وصُنوف العذابِ والتنكيلِ",67,"ل",1,0],["أنت يا دهر أجنيّ دخيل","جاهل بالحياة كالأنعام",68,"م",1,0],["أنت يا يوم إذا أقبلت عيد","يقبل القلب عليه من جديد",69,"د",1,0],["أنت يا رشدي على البعد قريب","من صديق يحفظ العهد الحبيب",70,"ب",1,0],["أَنتِ يا لَيلَ أَنتِ أَجمَلُ رُؤيا","صَبَّها في العُيونِ حُلمٌ عَجيبُ",71,"ب",1,0],["أَنتَ يا رَبِّ ما خَلَقتَ جَمالاً","مِثلَها في المَلائِكِ الأَنقِياءِ",72,"ا",2,0],["أَنتَ يا رَبِّ ما خَلَقتَ وَفاءً","كَالَّذي قاتَ حُبَّها في النِساءِ",72,"ا",2,0],["أَنتَ يا رَبِّ ما خَلَقتَ نِساءً","مِثلَ لَيلى نَقِيَّةَ الأَحشاءِ",72,"ا",2,0],["أَنتِ يا روحَ المَماتِ الهائِمَة","يا عَروسَ النور",73,"ر",1,0],["أنتِ يمُّ الحُسنِ فيهِ ازدَحَمَت","سُفُنُ الآمالِ يُزجيها الرجاء",74,"ا",2,0],["أَنتِ يا مُقلَتي جَلَب","تِ لِيَ الهَمَّ وَالحَزَن",75,"ن",1,0],["أَنتَ يا اِبنَ المُختارِ أَكرَمُ أَن تُن","ظِرَ في أَمرِ مُستَفادٍ حَقيرٍ",76,"ر",1,0],["أنت يا قَلبُ بعد فرقَتِك الصَّد","رَ غريبٌ وهكذا الغُرَباء",77,"ا",2,0],["أنتَ ياقلبي عنيدٌ","لستُ وحدي من نهاكَ",78,"ك",1,1],["أنت يا من صَدَّ عني","إنَّ شوقي في ازديادِ",79,"د",1,0],["أنتِ يا شغلَ خاطرِي نُصْبَ عَيْني","حَيثُما شِئتُ أن أراكِ أراكِ",80,"ك",1,1],["إن تيمَّمتَ سَمتها فتجنَّب","يا أَخا العَزم عَن جَميع السموتِ",81,"ت",1,0],["أنتِ يا وَيحك","لا تبقى من الأستار شيّا",82,"ي",2,0],["أنت يا من عرفتُ نفسي فيها","حين أنكرتُ عِفّتي وحيائي",83,"ي",1,0],["أنت يا نفسُ سرُّ هذا الشقاء","شدت مجدي على أساسٍ هباء",84,"ا",2,0],["أنتَ يا متحف الدمامة والقب","حِ تنزّهتَ عن صفات البهاء",85,"ا",2,0],["أنتَ يا مبدعُ ما في","الكون من حسن ملثّم",86,"م",1,0],["أنت يا محروم تدرى","أن راووقك مفعَم",86,"م",1,0],["أنت يا من وهبته صفوَ عمري","كيف جازَيتني بظلمي وغَبني",87,"ن",2,0],["انت يا نفس منبع لشقائي","انت كل البلاء فيك تجسم",88,"م",1,0],["انت يا نفس منبع لشقائي","آه نفسي إلى متى أتألم",88,"م",1,0],["أَنتَ يا أَوَّل بِغَير اِبتِداءٍ","لَم تَزَل آخراً بِغَيرِ اِنتِهاءِ",89,"ا",2,0],["أَنتَ يا شَيبُ كَما السَيفُ سَوا","أَبيَضُ اللَونِ وَيَستامُ الأَجَل",90,"ل",1,0],["أَنتَ يَومَ الغَديرِ صَدرُ المَوالي","حينَ خَلَّفتَهُم معَ الأَعجازِ",91,"ز",1,0],["أنت ياعصفورةً تشدو","على أغصان حبي",92,"ب",2,1],["أنت يا ليلى خطوتي","زادك اللّه في الروا",93,"ر",3,0],["أَنْتَ يا مسكينُ فيهم جاهِلٌ","هم أُناسٌ حيثُ غابوا حَضَروا",94,"ر",3,0],["أنت يمنى يديه إن عن خطب","تتوقاه سائر الأعضاء",95,"ا",2,0],["أنتِ يَا مُورِثَتِي ذُلا بِهِ","صَارَ قَلبي بَينَ شَكوى وَأَنِينِ",96,"ن",1,0],["أنت يا غافلُ الذي لست تدري","عارفاً كن بنفسك النَّسّاكا",97,"ك",2,0],["أنتَ يا رُكنَ قومِنا أهلُ هذا","وهْوَ من بينِ أهلهِ بكَ أليَقْ",98,"ق",1,0],["أَنت يا عاذِلي تُجادِلُ في الحقِّ","عناداً من بعد ما قد تبينْ",99,"ن",1,0],["أَنتِ يا من أَذْكَتْ غَراماً وأَبْكَت","مُستهاماً بها وشَطَّتْ مَزَاراً",100,"ر",2,0],["أَنتَ يا سيِّدَ الملوكِ وَأَزْكَا","هُمْ نِصَاباً ومَنْصِباً وفَخَارَا",100,"ر",2,0],["أَنتَ يا أَفضلَ الأَنام وَيا مَنْ","وصْفُه البأْسُ والحِجَا والجُودُ",101,"د",1,0]]}