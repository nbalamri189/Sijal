مرُّ","بشهرٍ من الذلِّ ليس يسُرُّ",218,"ر",1,1],["وأفراح الليالي لا أراها","ولا تلقى لها سبلي سبيلا",219,"ل",2,0],["وافرقت والدمع يذرفها بحورا","يا فؤادي ذاك ما أوتيت خُبرا",220,"ر",2,0],["وإفرشي لي خمايل ، ثوبك المستدير","آتثني معه ، إلى إنطوى ، واستدار",221,"ر",1,0],["وإفردي لي جناح الشوق ودي أطير","لاني أول ولا آخرمن تعلى ّ وطار",221,"ر",1,0],["وافرد جناحك ذي ألفيّة هجمت","كأنّ غولا بها قد دبً مفترسا",222,"س",2,0],["وأفرُّ من لَحْظِ اليتيمِ ودمعه","فعيون أيتام الشآم حِصَارُ",223,"ر",1,0],["وافرض اني جيت اوصف في محاسن هالبنيه","إلا ذاك الشخص واقف قالوا هذا خالها",224,"ل",3,1],["وَأَفْرَاحِي تُعَرِّيهَا اللَّيَالِي","وَمِنْ عَجَبٍ تُسَجِّيهَا الخُطُوبُ",225,"ب",1,0]]}