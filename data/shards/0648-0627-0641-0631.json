بان","https://www.poetsgate.com/ViewPoem.aspx?id=178375",""],[4767,"اليانصيب","https://www.poetsgate.com/ViewPoem.aspx?id=180035",""],[4767,"الحب الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=213051",""],[5028,"مرت على بالي اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=62108",""],[5030,"بيوت الله","https://www.poetsgate.com/ViewPoem.aspx?id=215723",""],[5084,"هلّ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=177785",""],[3591,"اليوم تبكي ولكن بعد نبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=149440",""],[5121,"دوحة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=36288",""],[5135,"لِقاءُ الْأحِبَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201841",""],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[778,"ماذا انتظارك باللذات والطرب","https://www.poetsgate.com/ViewPoem.aspx?id=89233",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5626,"يا غُربتي","https://www.poetsgate.com/ViewPoem.aspx?id=189560",""],[5652,"متى اشوفك للقى تحتويني ..!","https://www.poetsgate.com/ViewPoem.aspx?id=150376",""],[2599,"هذه الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=14006",""],[5667,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=214940",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5693,"فمشكاتي ومصباحي .","https://www.poetsgate.com/ViewPoem.aspx?id=34850",""],[5732,"ينام منهو مايعرف الهمومي","https://www.poetsgate.com/ViewPoem.aspx?id=177856",""],[5732,"لزيت نفسي مير عيت تلزا","https://www.poetsgate.com/ViewPoem.aspx?id=177849",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"هلال ونجمة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182427",""],[5956,"لا تيأسَنَّ فإنّ الخيرَ موفورُ","https://www.poetsgate.com/ViewPoem.aspx?id=184205",""],[5956,"شهر التأشيرة هو شهر النحس","https://www.poetsgate.com/ViewPoem.aspx?id=192787",""],[5957,"أرى الآتي كما الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=14224",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6056,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6113,"وافرض","https://www.poetsgate.com/ViewPoem.aspx?id=58847",""],[6346,"جَمْرُ الوَدَاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84888&r=&rc=13",""]],"verses":[["وَأَفرَحُ مِن نَحوِ أَوطانِهِم","بِغَيثٍ يُجَلجِلُ بَرقاً وَرَعدا",0,"د",2,0],["وأفْرِشُ سَمْعي للوَعيدِ فحُبُّها","إذا جَمَحَتْ بي نَخوَةٌ يتلطَّفُ",1,"ف",1,0],["وَأَفرَحُ بِالسَيفِ تَحتَ الغُبارِ","إِذا ما ضَرَبتُ بِهِ أَلفَ ضَربَه",2,"ب",2,0],["وَأَفرَحُ إِن تُمسي بِخَيرٍ وَإِن يَكُن","بِها الحَدَثَ العادي تَرُعني الرَوائِعُ",3,"ع",1,0],["وَأَفرَسَ لِلمَنابِرِ وَالمَذاكي","وَأَبهى في البُرودِ وَفي السِلاحِ",4,"ح",1,0],["وافرشْ خدود الورد تحت نعاله","واجعل بها لون المضاعف عبد خفرْ",5,"ر",1,0],["وافر المكرماتِ منشرحُ اللف","ظِ طويلُ الثنا مديدُ الثواب",6,"ب",1,0],["وأفراط كتم للندى وهو ظاهرٌ","وهل مانعٌ للرَّوض أن يتأرّجا",7,"ج",2,0],["وأفردت نظماً سرياً فما","لبيتك في النظم من سارق",8,"ق",1,0],["وأفردت بالآلام فيها وقاسمت","لواحظها ما بين سقمي وسقمها",9,"م",3,0],["وافرضْ له من فضل كفك قُوتَه","واعزمْ إذا اتّسعتْ على تنقيلِهِ",10,"ل",2,0],["وَأَفراسٍ إِذا نَلقى عَدُوّاً","بِمَلحَمَةٍ عُرِفنَ إِذا رُبينا",11,"ن",2,0],["وافراح ناس بعد خفض ونعمة","عليهم اناخ الدهر يقسو بكلكال",12,"ل",1,0],["وَأَفرَطتُ مِن وَجدٍ بِهِ فَدَرى بِنا","عَلى ساعَةِ الهِجرانِ مَن لَم يَكُن يَدري",13,"ر",2,0],["وَإِفراطُها في القُبحِ عِندَ خُروجِهِ","كَإِفراطِها في الحُسنِ عِندَ دُخولِهِ",14,"ل",2,0],["وأفرخ ما هرمت","حين دنا من هرمه",15,"م",2,0],["وَأَفرَشنا مِنَ الأَزهارِ بُسطاً","مُسَردَقَةً بِأَستارِ الغُيومِ",16,"م",1,0],["وافرحا بالذي يطيب ويرجى","عيشةٌ نضرة وعين قريره",17,"ر",2,0],["وافرحتي بك فرحة الطفل الذي","يلهو ويخلق كل يوم عيدا",18,"د",2,0],["وافرحتي بك فرحة الطير الذي","ملأ الروابي المصغيات نشيدا",18,"د",2,0],["وافرحتي بك فرحة الضال الذي","يطوي القفار اللافحات شريدا",18,"د",2,0],["وَافَرَحِي اليومَ بحريَّتي","بأيِّ ليل مدلهمٍّ أطير",19,"ر",1,0],["وَأَفرَدتُ عَيني بِالدُموعِ فَأَصبَحَت","وَقَد غَصَّ مِنها كُلُّ جَفنٍ بِمائِهِ",20,"ا",3,0],["وَأَفرَحُ بِالأَمرِ الَّذي لا أُبينُه","يَقيناً سِوى أَن قَد رَجَمتُ بِهِ ظَنّي",21,"ن",2,0],["وَأُفَرّي مِرطَها عَن مُخطَفٍ","ضامِرِ الأَحشاءِ فَعمِ المُؤتَزِر",22,"ر",1,0],["وَأُفرِدتَ إِفرادَ الطَريدِ وَباعَدَت","إِلى النَفسِ حاجاتٌ وَهُنَّ قَريبُ",23,"ب",1,0],["وَأَفرَدَ في شِعبٍ عَجُوزاً إِزائَها","ثَلاثَةُ أَشباحٍ تَخالُهُمُ بَهما",24,"م",2,0],["وَأُفرِدتُ إِلّا مِن خَليلٍ مُكاشِرٍ","سَريعِ شَرارِ الجَهلِ غَيرِ أَمينِ",25,"ن",1,0],["وَأَفرَدَني مِنَ الإِخوانِ عِلمي","بِهِم فَبَقيتُ مَهجورَ النَواحِ",26,"ح",1,0],["وَأَفرَخَ روعُهُ وَأَفادَ بِشراً","وَهَرهَرَ ضاحِكاً جَذلانَ بالِ",27,"ل",1,0],["وافرض لنفسِكَ كل يوم ركعةً","لا تكثرنَ فتوجب الأجرا",28,"ر",2,0],["وَأَفرَحُ أَن أُعادَ وَقَد أُراني","أُذادُ عَنِ الحَديثِ وَلا أُعادُ",29,"د",1,0],["وَأَفرَقُ مِن يَومٍ تُصَمُّ غَواتُهُ","فَتَعولُ إِعوالَ النِساءِ الفَواقِدِ",30,"د",1,0],["وأفرط أقوام وفرَّط غيرهم","وإن طريق المفلحين هو القصد",31,"د",1,0],["وإِفريقيا ما لإِسلامها","يُسامُ عبوديةً واحتلالا",32,"ل",2,0],["وأفرغتُ بؤسيَ في حِضنها","وأترعتُ كأسيَ من دَنِّها",33,"ه",2,0],["وَافِرَ الأُنْسِ حَيْثُ قَرَّ وَحِيداً","بِاخْتِلاَفِ الملائِكِ الأُمَنَاءِ",34,"ا",2,0],["وَافِرُ المَحْمَدَاتِ فِيهِ خلاَلٌ","غَيْرُهُ بِالأَقَلِّ مِنهَا فخورُ",35,"ر",1,0],["وَافِرَ الحَزْمِ وَافِيَ العَزْمِ فِي إِصْ","دَارِهِ حِكْمَةٌ وَفِي الإِيرَادِ",36,"د",1,0],["وافرق بها البيد حتى يستبين لها","( فرق) على \"بيضة الاسلام\"(1) عنوان",37,"ن",1,0],["وَأَفرَدَ في شِعبٍ عَجُوزاً إِزاءها","ثَلاثَةُ أَشباحٍ تَخالُهُمُ بَهما",38,"م",2,0],["وأفراحنا كشفاه الزهور º","تهامسها قبلات الندى",39,"د",2,0],["وافرش الأرض شعاع وندى","وترقرق في الفضا سحرا وإغرا",40,"ر",2,0],["وإفريقيا ما لإسلمها","يسام عبوديّة واحتلالا !؟",41,"ل",2,0],["وأُفرِدتَ مِثْل السيفِ لا مِنْ مُساعِدٍ","سوى ثِقةٍ بالنفس أنَّكَ صارم",42,"م",1,0],["وأفرغَها من صُنوفِ الخِداعِ","والغشَّ في قالبٍ مُذْهَب",43,"ب",1,0],["وأَفْرَدتْه اللَّيالِي من أَحِبَّته","فباتَ يُنْشِدُها مما جنى الزَّمَنُ",44,"ن",1,0],["وافرط حتى بلا ضابط","اعاب السماع وعنه نهى",45,"ن",3,0],["وافرح في تقبيل اعتاب احمد","امام رجال الله تاج جموعها",46,"ع",3,0],["وأفرط بالتحجب بعد قرب","أتى يحكي شؤون الانفصام",47,"م",1,0],["وأفرَغَ في جوانبها ذَنُوباً","من البركاتِ تَختَطِفُ الذُّنوبَا",48,"ب",2,0],["وأفرط الهجرُ لما بان من ولعي","أن التواصلَ منهُ منتهى أملي",49,"ل",2,0],["وأفرشتها خدّي وقلت لها طني","فلا تحسبي خدّي عليك بذي خال",50,"ل",1,0],["وَأَفْرِحْ صَائِمًا قَامَ اللَّيَالِي","وَرِضْوَانًا بِهِ عَمَّ الأَمَانُ",51,"ن",1,0],["وأفرح بالميعاد منها ولم يكن","ليخلو من خلف لها إن تعد وعد",52,"د",1,0],["وافراح تروى الدهر منها","وصفق وانثنى طربا وغنى",53,"ن",2,0],["وافرحْ فما يُلقى لسدّك هادمٌ","وامرحْ فما يُلفى لحدِّك ثالِمُ",54,"م",1,1],["وأفرطَ البردُ حتى الشّمسُ ما طلعتْ","إلاّ مُزمّلةً في فَرْو سِنجابِ",55,"ب",1,0],["وأُفرِشُهُ فَرشِى وأَفتَرِشُ الثَّرَى","وأَجعَلُ مَسَّ الأَرضِ مِن دُونِهِ لَبسِى",56,"س",2,0],["وأَفْرَق من غَمَرات الهموم","كما يُنْتَضَى الصَّارم المِقْضَب",57,"ب",1,0],["وأفرشها بساط السلم حتّى","على طغيانها نغل الأديم",58,"م",1,0],["وأفرح بالتقويم يوم 