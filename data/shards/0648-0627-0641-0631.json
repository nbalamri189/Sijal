 هشاشةً وابتساما",167,"م",2,0],["وَأَفرغتُ الفؤاد من الأَماني","وَمِن أَملٍ يَغرّ لطول باسي",168,"س",2,0],["وَافرغ فؤادَك بِالسلوّ عَن الهَوى","مِن بَعد أَيّ مجالسٍ وَأَحبّةِ",169,"ه",1,0],["وأَفردتنيَ لا قلبٌ ولا جَلَدٌ","وأَفردَتْها بلا أَهلٍ ولا ولد",170,"د",1,0],["وأفرسُ من راكب الصَّافنات","وأقدمُ ساطٍ على عسكرِ",171,"ر",1,0],["وأفرق بين الَهزبر الهَصورِ","وبين الرَّشا الخاذل الأحور",171,"ر",1,0],["وَأفرَغتُ فَاهَا فِي فَمِي زَائِداً صَدىً","وَأبدَى لِمَا تَحتَ الإِزَارِ دَبِيبُهَا",172,"ب",3,0],["وَاِفرُشي العَسجَدَ الرَقيقَ مِلاءً","وَاِسدُلي اللَيلَ خَيرَ سِترٍ حِجابا",173,"ب",2,0],["وَافراح السَعادةِ قَد دَعَتها","هلمي وَادخلي خَدراً أَمينا",174,"ن",2,0],["وأفرغه الصبا قمراً فلما","تلظت نار وجنته أذيبا",175,"ب",2,0],["وافر الأرداف أبدت نقصه","بدقيق الخصر إذ رجت لديه",176,"ه",1,0],["وأفراس أفراحي يروق طرادها","وراية نصر الله ذي الفتح تخفق",177,"ق",1,0],["وافردت مثل العضب فارق غمده","والا كمثل السهم من كف راشق",178,"ق",1,0],["وافرحي ليلةَ الشّعيرِ كما يف","رحُ قومٌ بليلةِ الماشوشِ",179,"ش",1,0],["وأَفردتني من جَوادٍ صادقٍ","إِن سِيلَ برَّ الُمعتفي أَو قالَ بَر",180,"ر",1,0],["وَأَفراحٌ تَروحُ بِنا وَتَغدوا","لَدَينا لا تَزالث مَدى السِنينا",181,"ن",2,0],["وافرا ان مدحته بخفيف","فبه أرجو حط وزر ثقيل",182,"ل",1,0],["وافرا أن مدحته بخفيف","فبه أرجو حظ وزر ثقيل",183,"ل",1,0],["وافرح وتهنئ بذا الزفاف وأرخ","شمساً مع بدرٍ على الصفاء مقيمان",184,"ن",1,0],["وأفراح تمر وليس تبقى","ويبقى دونها لمح الوميض",185,"ض",1,1],["وافرح بذكراه تؤجر يوم لا فرحٌ","للناصبين العدا من بالهوى قالوا",186,"ل",3,0],["وأفرغتُ الجيوب فما تبقَّتْ","بِها من بعد إفراغٍ نقود",187,"د",1,0],["وافرحي واستأنِسي بالأهل إني","ليس لي مِن ألفةٍ إلا القصيد",188,"د",1,0],["وافراقها كون في خافقي غيوم","أمطارها على الفيافي لا خرت",189,"ت",1,0],["وأفراحنا تشدو على كلّ شاهقٍ","ولم ندرِ أنّ الهمَّ لو طال عابرُ",190,"ر",1,0],["وافراق حيين المصافات مرجوع","لو كدرن عام ٍ فهن يرجعنيّ",191,"ن",2,0],["وأفرح كما كنت فرحاناً لو أن ملكت","يداك ما حاولت إدراكه الهمم",192,"م",1,0],["وَافْرَحْ بِجِرْسِ الْهَزَارِ الْشَّد