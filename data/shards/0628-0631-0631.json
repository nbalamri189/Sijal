{"poems":[[53,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[53,"بررتك بالهجران لما رأيتني","https://www.aldiwan.net/poem65934.html","الطويل"],[87,"خلقنا للحياة وللممات","https://www.aldiwan.net/poem62917.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54967","السريع"],[309,"أهلا وسهلا بالحبيب الواصل","https://www.aldiwan.net/poem16820.html","الكامل"],[484,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216895","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95546","البسيط"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4778,"النوايا","https://www.poetsgate.com/ViewPoem.aspx?id=200410",""],[4978,"ما أجمل الوصل، فاق الوصف والحلُما","https://www.poetsgate.com/ViewPoem.aspx?id=177191",""],[5956,"حرِّروا نيويورك من صهيونها","https://www.poetsgate.com/ViewPoem.aspx?id=194434",""]],"verses":[["بَرِرتَ وعهدِ اللَّه بِرّاً مُبيَّناً","وإن كثُرت من ذي شِقاقٍ هَنابثُهْ",0,"ث",2,0],["بررْتُك بالهجرانِ لمّا رأيتَني","على حسْبِ ما تُبدي أعُقُّك بالوصْلِ",1,"ل",1,1],["بَرَرتِ المُؤمِناتِ فَقالَ كُلُّ","لَعَلَّكِ أَنتِ أُمُّ المؤمِناتِ",2,"ت",1,0],["بَرَرْتُمَا فِيهِ بِذِكْرَى أَبٍ","كَان مِثَالَ الْمُقْدَمِ الصَّابِرِ",3,"ر",1,0],["بر رحيم بالخلائق كلهم ير","عى الوجود بعين لطف شامل",4,"ل",1,0],["بررت بها وما أنا ذا عقوق","وهذا ما يؤيده اعتقادي",5,"د",2,0],["برٌ رحيمٌ لهُ رفقٌ بامتهِ","وهو الشفيع غدا ينجي من الغُدمِ",6,"م",1,0],["بررْتَ ولمْ يستأهل البرُّ ساعةً","دناءَةٌ نفسٍ في خمولٍ من الذّكْرِ",7,"ر",1,1],["بررت ذا اليتم حتى هان والده","وكنت والده الحانى وكان ابنَا",8,"ن",2,0],["برٌّ رحيمٌ شافعٌ ومشفّعٌ","روح العوالم مركز الدوران",9,"ن",1,0],["برّ رَؤف رَحيم للإِله دَعى","تَشريعه مُستَقيم واضح اللقم",10,"م",1,0],["برّ رحيم كريم ما بغير نعم","يجيب من نداه جاء مغترفا",11,"ف",2,0],["برّ رؤف رحيم محسن حسن","نواله للبرايا كلهم وشظا",12,"ظ",2,0],["برروا ما كان من هم من تجني","واقتراف البَغْي جهرا والرزايا",13,"ي",2,0],["برّرْ أصدقْ ، فهل أبقيت لي بدلاً","إلا اصطراعا بقلبي باتَ محتدِما",14,"م",2,0],["برّر التلمود قتل الناس عمداً","كيف يأتي العدل من آل لهبْ؟",15,"ب",1,0]]}