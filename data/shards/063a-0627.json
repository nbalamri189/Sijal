"https://www.poetsgate.com/ViewPoem.aspx?id=21674",""],[98,"الشباب الذاوى","https://www.poetsgate.com/ViewPoem.aspx?id=55332",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[45,"طَيفٌ ألَمّ، فحَيّا عندَ مَشهَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32938",""],[45,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""],[45,"إنّ طَيْفاً يزُورُني في المَنامِ","https://www.poetsgate.com/ViewPoem.aspx?id=31854",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[45,"مِنّيَ وَصْلٌ، وَمنكَ هَجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31193",""],[28,"مِنّا الّذِي اخْتِيرَ الرّجالَ سَماحَةً","https://www.poetsgate.com/ViewPoem.aspx?id=16983",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[89,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[105,"ذهب السرور وولت الأعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54941&r=&rc=111",""]],"verses":[["غاضَت مِياهُ وُجوهِهِم خَوفَ الرَدى","فَكَأَنَّها فاضَت إِلى الأَجفانِ",0,"ن",1,0],["غادَروني جَسَداً تُظهِرُهُ","لَهُمُ الشَكوى وَيُخفيهِ الضَنى",1,"ن",2,0],["غالَطوني عَنِ المَشيبِ وَقالوا","لا تُرَع إِنَّهُ جَلاءُ الحُسامِ",2,"م",1,0],["غائِبٌ مِثلُكَ مِن شُهّادِهِ","ما قَضى العُمرَ وَلا ذاقَ الحِماما",3,"م",2,0],["غايَةُ الناسِ في الزَمانِ فَناءٌ","وَكَذا غايَةُ الغُصونِ الذُبولُ",4,"ل",1,0],["غادٍ تَلَفَّتَ وَالمُشتاقُ يَتبَعُهُ","صَفحَ الطَليقِ إِلى المَقصورِ بِالطِوَلِ",5,"ل",1,0],["غابوا فَغابَ عَنِ الدُنيا وَساكِنُها","مَرأىً أَنيقٌ عَنِ الدُنيا وَمُستَمَعُ",6,"ع",1,0],["غالى بِها الزائِدُ حَتّى اِبتاعَها","بادِنَةً قَد مَلَأَت أَنساعَها",7,"ع",3,1],["غادَرتَها شَنعاءَ ضاحِيَةً","لا النَفسُ يَصبُغُها وَلا الحُصُّ",8,"ص",1,0],["غابٌ أَبَنَّ بِهِ ضَراغِمُ هاشِمٍ","مِن كُلِّ أَغلَبَ لِلعِدى فَرّاسِ",9,"س",1,0],["غاوِياً يَحلُمُ بِالمُلكِ وَهَل","يَغلِبُ العَيرُ عَلى بَيتِ الأَسَد",10,"د",1,0],["غادَرنَ أَسوانَ مَمطوراً بِعَبرَتِهِ","يَنحو مَعَ البارِقِ العُلوِيُّ أَينَ نَحا",11,"ح",2,0],["غاضَ غَديرُ الكَلامِ ما بَقي ال","دَهرُ وَقَرَّت شَقاشِقُ الخُطَبِ",12,"ب",1,0],["غارِسٌ لَم يَألُ في الغَرسِ لَهُم","فَأَذاقوا أَهلَهُ مُرُّ الجَنى",13,"ا",1,0],["غادَةٌ تَملأُ العيونَ جَمالاً","هيَ دائي مِنهُنَّ وَهْيَ شِفائي",14,"ا",2,0],["غَاضَ الكرامُ كما فاضَ اللِّئامُ بِهِ","فَالخَيْرُ مُجْتَنَبٌ وَالشَّرُّ مَتْبوعُ",15,"ع",1,0],["غاضَ الوفاءُ فليسَ في صَفَحاتِهِمْ","ماءٌ وفي الأحشاءِ نارُ حُقودِ",16,"د",1,0],["غادَرتُهُ مُتَعَفِّراً أَوصالُهُ","وَالقَومُ بَينَ مُجَرَّحٍ وَمُجَدَّلِ",17,"ل",1,0],["غادَرتُهُ لِلجَنبِ غَيرَ مُوَسَّدٍ","مُتَثَنِّيَ الأَوصالِ عِندَ مَجالِ",18,"ل",1,0],["غَالَهُم وُدّي فَما عَقِلوا","حينَ سَدّوا دونَهُ الطُرُقا",19,"ق",2,0],["غالَتْ سوائِمَها شُهْبُ السّنينَ فَما","أبْقَتْ مِراساً ولا خَيْلاً ولا جَمَلا",20,"ل",2,0],["غَاظَ الزَّمَانَ بِهَا تَنَعُّمُ عِشَةٍ","فَأَحَالَهَا وَالدَّهْرُ ذُو أَلْوَانِ",21,"ن",1,0],["غائِصاً يسْتَخْرِجُ الدُّرّ","بِبَحْرِ الظّلُماتِ",22,"ت",1,0],["غَابَ قَلْبِي فِيهِ عِنْدَ الْتِمَاحي","قُلْتُ هذَا الْقَبْرُ فِيهِ الْحَبِيبُ",23,"ب",1,0],["غَادَرْتَهُمْ صَرْعَى عَلَى عَفْرِ الثَّرَى","وَمَلأْتَ أَرْضَهُمُ بُكاً وَنَحِيبَا",24,"ب",2,0],["غادَرتُهُ مُتَجَدِّلاً","بِالقاعِ تَنهَسُهُ الفَراعِل",25,"ل",1,0],["غادَرَ الجَحشَ في الغُبارِ وَعَدّا","ها حَثيثاً لِصُوَّةِ الأَدحالِ",26,"ل",1,0],["غابَ الأَديبُ أَديبُ مِصرٍ وَاِختَفى","فَلتَبكِهِ الأَقلامُ أَو تَتَقَصَّفا",27,"ف",2,1],["غالَهُ الضَعفُ حينَ شَمَّرَ لِلإِص","لاحِ في مُلكِهِ بِعَزمٍ فَتِيِّ",28,"ي",1,0],["غادَرتَنا وَالحادِثاتُ بِمَرصَدٍ","وَالعَيشُ عَيشُ مَذَلَّةٍ وَإِسارِ",29,"ر",1,0],["غالَ أَرمادَةَ العَدُوَّ فَفُزتُم","وَبَلَغتُم في الشَرقِ شَأواً عَظيما",30,"م",2,0],["غاصَ في لُجَّةِ الحُتوفِ بِعَزمٍ","لَم يُعَوَّد مَواقِفَ الإِحجامِ",31,"م",1,0],["غابَ فيها وَعادَ يَحمِلُ جِسماً","سَلَّهُ مِن يَدِ الهَلاكِ اللِزامِ",31,"م",1,0],["غالَها قَبلَكِ الزَمانُ اِغتِيالاً","وَهيَ تَلهو في غِبطَةٍ وَأَمانِ",32,"ن",1,0],["غادَرتَ داعِيَةَ البِعادِ مَحَبَّتي","فَبِأَيِّ حالاتي أَرى مُتَقَرِّبا",33,"ب",2,0],["غالى بِما فيهِ فَغَيرُ مُواقِعٍ","سَرَفاً وَلا مُتَوَقِّعٍ تَكذيبا",34,"ب",2,0],["غادَرتَهُ مِزَعَ الرِماحِ وَأَسهَلَت","لَكَ وَردَةٌ كَالسيدِ طامِيَةُ الحَضَر",35,"ر",1,0],["غاية الفن لا ترام وما يق","رب منها إلا النبيغ الصبور",36,"ر",1,0],["غادَةٌ مَنْ سعى إِلَى","غَايَةٍ عِندَهَا غَوَى",37,"و",2,0],["غابت فأوحشت الفضاء بكدرة","سقم الضياء بها فزاد نحولا",38,"ل",2,0],["غادَرتُهُم مِن حَسيرٍ ماتَ في قَرَنٍ","وَآخَرينَ نَسوا التَهدارَ خِصيانا",39,"ن",2,0],["غَالِبِيّينَ هاشِمِيّينَ في العِل","مِ رَبَوا مِن عَطِيَّةِ العَلاَّمِ",40,"م",1,0],["غاب ذو الفضل في حمى مصرَ عنَّا","فهنيئاً له حمى النعماء",41,"ا",2,1],["غاص البحار بها وطار إلى السما","فالدرّ ينظم والكواكب تنثر",42,"ر",1,0],["غازلتني سمراء في حلية المر","د بدبوقة غزت بمظفر",43,"ر",1,1],["غادة عقربت على الخدِّ صدغاً","من عيون الأنام يحرس كنزه",44,"ز",2,0],["غارَ أخوك الغيث يا سيدي","فصدَّ عن رؤياك طرفاً شقيق",45,"ق",1,1],["غازلتنا فأعيدِي ماضيَ الغزل","شواهر البيض من مسوّدة المقل",46,"ل",1,1],["غاب علم التفسير عنَّا وهمت","كتب الفقه فيك بالأعوال",47,"ل",1,0],["غاب الوزير وكان العطف شيمته","وجئت نعم أمير بالرجاء ملي",48,"ي",1,1],["غايات قوم مبدا سريّكم","في رتب الفضل بيت أقوامه",49,"م",2,0],["غادة يروي لماها","عن صحاحٍ جوهريَّه",50,"ي",2,0],["غادَرْتَ حوْضَ المنايا إذْ شَربْتَ بِهِ","عذْبَ المذاق كذوب الشَّهْد بالبَردِ",51,"د",1,0],["غانياً عن كل إرشادٍ بما","فيه من فضل رشاد وسدادِ",52,"د",1,0],["غادةٌ لوهبَّتِ الريحُ لها","آدَها من مسّها ما لا يؤودُ",53,"د",1,0],["غادةٌ زانها من الغُصْن قَدٌّ","ومن الظَّبي مُقلتان وجِيدُ",54,"د",1,0],["غادرتَ فصدك غرة مشهورة","في وجه يوم السبت حتى المحشر",55,"ر",1,0],["غامزٌ ليس من يديه ولا رج","ليه بل من حِتاره المحزوز",56,"ز",1,0],["غاب تحت الحسِّ حتى","ما يُرى إلا قِياسا",57,"س",2,0],["غالطتَ نفسك أو غَلِطتَ وربما","وقعتْ سهامُك في سوى الأغراضِ",58,"ض",1,0],["غابتْ نجومُ النَّحس عنه وأصبحتْ","فيه نجومُ السعد ذاتَ طُلوعِ",59,"ع",1,0],["غادى كتائبهم بعدوته","أجل يطحطح من يروعه",60,"ع",2,0],["غابقها ذاهل وصابحها","عن شأنها ذاهل كغابقها",61,"ق",3,0],["غامت عليَّ بلا ظل ولا ورق","سماء مولى مظل مشمسٍ ساقي",62,"ي",1,0],["غارت عليهن الثُّديْ","يُ هناك من مس الغلائلْ",63,"ل",1,0],["غاب الموفَّقُ واستكفاه غيبتَهُ","فلم يصادفه بين الذمِّ والذامِ",64,"م",1,0],["غابن الحمد حقَّهُ مغبُونُهْ","وهوانُ العلا على المرءِ هونُهْ",65,"ن",2,1],["غابَ المُوَفَّقُ فاستراب بغيبهِ","وأتى فصادف منه مِرْجلَ طاهي",66,"ه",2,0],["غادَرَها وَهِيَ تَكبو تَحتَ كَلكَلِهِ","يَكسو النُحورَ بِوَردٍ خَلفَهُ الزَبَدُ",67,"د",1,0],["غادى بِها مازِجٌ دِهقانُ قَريَتِهِ","وَقّادَةَ اللَونِ في كَأسٍ وَناجودِ",68,"د",1,0],["غايَةُ الوَردِ في الرِياضِ ذُبولٌ","كُن حَكيماً وَاِسبِق إِلَيهِ الذُبولا",69,"ل",2,0],["غاضَ نورُ الطَرفِ أَم غارَت ذُكاء","لَستُ أَدري غَيرَ أَنّي في ظَلام",70,"م",1,0],["غاضَ مِثلَ الماءِ في الأَرضِ العَراء","ما عَهِدتُ البَدَر مَثواهُ الرُغام",70,"م",1,0],["غالِبي اليَأسَ وَاِجلُسي عِندَ نَعشي","بِسُكونٍ إِنّي أُحِبُّ السَكينَه",71,"ن",2,0],["غادَةٌ ما عَرَفَت قَلباً خَلِيّاً","مِن هَواها حَتّى القُلوبُ الخَلِيَّه",72,"ي",2,0],["غابَ عَن عَينَيَّ فيهِ","كُلُّ شَيءٍ أَشتَهيهِ",73,"ي",2,0],["غالَطتَني وَزَعَمتَ أَن","نَكَ لَم تَخُن وَزَعَمتَ أَنّي",74,"ن",2,0],["غابَ عَنّا فَفَرِحنا","جاءَنا أَثقَلُ مِنهُ",75,"ه",1,0],["غابَ عَن طَرفي وَقَد كُن","تُ أَراهُ مِثلَ طَرفي",76,"ي",1,0],["غاضَتْ أَمانيها وغارَ","بها الجَمالُ السَّاحرُ",77,"ر",1,0],["غاضَتْ فلمْ تُبْقِ إلاَّ","الدُّمُوعَ بَيْنَ صُدُوعِهْ",78,"ه",1,0],["غازي الذي قد لأم","الصدع وللفتق رأب",79,"ب",1,0],["غازي الذي قد ورث","العلياء من ام واب",79,"ب",1,0],["غازي زعيم الشعب فهو","لغير غازي لا يطيع",80,"ع",1,0],["غازي تبوأ عرش فيصل اذ قضى","فالناس في حزن وفي افراح",81,"ح",1,0],["غازي لهذا الشعب مصباح الهدى","اكرم به للشعب من مصباح",81,"ح",1,0],["غازلت منها في الغدو بنفسجا","وشممت منها في الاصيل خزاما",82,"م",2,0],["غالبت بالجهل علماً","وليس كالعلم جهل",83,"ل",1,0],["غايته من صومه جنة","فيها له نخل وأعناب",84,"ب",1,1],["غال في قيمة أبن بطر