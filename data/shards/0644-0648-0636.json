{"poems":[[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[105,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[105,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[46,"إصفح وجاهر بالمراد الفتى","https://www.aldiwan.net/poem22108.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[120,"أينغي يا زهراتي","https://www.aldiwan.net/poem49294.html","مجزوء الرمل"],[185,"كم قدر ما أخفي الهون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[204,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[305,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"]],"verses":[["لو ضاحك المَزنَ عنه ضاحَكَهُ","عن برقه مُسبلاً له دِرره",0,"ر",2,0],["لو ضنَّ مُعتَنِقُ الحتوفِ بِنفسِه","ما نال من دنيا الرجالِ نَفِيسا",1,"س",2,0],["لَو ضاعَ عَهدُكَ أَو حامَ الرَجاءُ بِنا","عَلى سِواكَ لَقينا الحَينَ وَالعَطَبا",2,"ب",2,0],["لَو ضُرِبَ الغاوُونَ بِالسَيفِ لا","بِالسَوطِ حَدَّ الخَمرِ ما تابوا",3,"ب",3,0],["لوْ ضم مَا قَطَرَتْ بِهِ أَقْلامُهُ","لامْتَدَّ كَالبَحْرِ الخِضَم الزَّاخِرِ",4,"ر",1,0],["لَوْ ضَارَعَتْ قُوَّتُهُ عَزْمَهُ","لاقى الْمُبِيدَاتِ وَلَمْ يُدْحَرِ",5,"ر",1,0],["لو ضيء الصفحات","لؤلؤي البسمات",6,"ت",1,0],["لو ضَلّتِ الثَّقلانِ كان على الهدى","أو خان أهلُ الأرض فهْو أمين",7,"ن",1,0],["لو ضُمَّت الدنيا إليه بأسرها","لاقتادها من نعله بقِبالِ",8,"ل",1,0],["لو ضمّها بينَ المحافلِ محفلٌ","وَهَوى الخورنق وَاِستحَت صنعاءُ",9,"ا",2,0]]}