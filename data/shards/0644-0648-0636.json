{"poems":[[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[107,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[107,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[48,"إصفح وجاهر بالمراد الفتى","https://www.aldiwan.net/poem22108.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[124,"أينغي يا زهراتي","https://www.aldiwan.net/poem49294.html","مجزوء الرمل"],[189,"كم قدر ما أخفي الهون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[208,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37958","المجتث"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109182","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53046","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28595","المنسرح"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99076","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127369","الرمل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126534","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86364","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107048","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83136","الخفيف"],[4836,"إلى كل الأمهات ممثلة. بأمي / ممحمد صالح العبدلي","https://www.poetsgate.com/ViewPoem.aspx?id=204013",""],[4852,"الطور والتشرين","https://www.poetsgate.com/ViewPoem.aspx?id=214364",""],[5135,"بَحْرُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=202460",""],[5277,"لا تعجبوا","https://www.poetsgate.com/ViewPoem.aspx?id=191253",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5463,"زاد غيابه الضيقه","https://www.poetsgate.com/ViewPoem.aspx?id=34248",""],[5573,"ياوقتي يامطول ليلك/مع طولك ماتقضي شف","https://www.poetsgate.com/ViewPoem.aspx?id=200307",""],[402,"تلك المنارة في المكان العالي","https://www.poetsgate.com/ViewPoem.aspx?id=36215",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[5848,"ضحكه وتنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=51951",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""]],"verses":[["لو ضاحك المَزنَ عنه ضاحَكَهُ","عن برقه مُسبلاً له دِرره",0,"ر",2,0],["لو ضنَّ مُعتَنِقُ الحتوفِ بِنفسِه","ما نال من دنيا الرجالِ نَفِيسا",1,"س",2,0],["لَو ضاعَ عَهدُكَ أَو حامَ الرَجاءُ بِنا","عَلى سِواكَ لَقينا الحَينَ وَالعَطَبا",2,"ب",2,0],["لَو ضُرِبَ الغاوُونَ بِالسَيفِ لا","بِالسَوطِ حَدَّ الخَمرِ ما تابوا",3,"ب",3,0],["لوْ ضم مَا قَطَرَتْ بِهِ أَقْلامُهُ","لامْتَدَّ كَالبَحْرِ الخِضَم الزَّاخِرِ",4,"ر",1,0],["لَوْ ضَارَعَتْ قُوَّتُهُ عَزْمَهُ","لاقى الْمُبِيدَاتِ وَلَمْ يُدْحَرِ",5,"ر",1,0],["لو ضيء الصفحات","لؤلؤي البسمات",6,"ت",1,0],["لو ضَلّتِ الثَّقلانِ كان على الهدى","أو خان أهلُ الأرض فهْو أمين",7,"ن",1,0],["لو ضُمَّت الدنيا إليه بأسرها","لاقتادها من نعله بقِبالِ",8,"ل",1,0],["لو ضمّها بينَ المحافلِ محفلٌ","وَهَوى الخورنق وَاِستحَت صنعاءُ",9,"ا",2,0],["لو ضاقَ بِي أَمرٌ فَما","لي غَيرُ لُطفِ اللَّهِ",10,"ه",1,0],["لو ضربنا بحده","حادث الدهر ما نبا",11,"ب",2,0],["لو ضاقت الأرض الفضاء بأهلها","رحبت بأهلاً من نداه ومرحب",12,"ب",1,0],["لَو ضُرِبَت بِالسُّيوفِ راحَتُهُ","لَما تَنَدَّت مِن بُخلِهِ بِدَمِ",13,"م",1,0],["لو ضنا يخفى عن العي","ن لأخفاه ضناه",14,"ا",2,0],["لو ضرب اللحظ على جوشنٍ","لحلقت مشتبكاتُ الزرد",15,"د",1,0],["لو ضحا في روضة والغصن مال","من نسيم الفجر وانجاب الظلام",16,"م",1,0],["لو ضل يونس عن زخار نائله","لظل للبعث في أحشاء ملتقم",17,"م",1,0],["لو ضاع لاهبها ضاع نوافحها","تهدي فأما عيوناً أو خياشيما",18,"م",2,0],["لو ضمه النادي ترى","في بردتيه ضيغما",19,"م",2,0],["لَو ضَممتِ الشفاهَ ضَناً عَلَينا","نفَذَت بالسَنا إِلى كلِّ لُبِّ",20,"ب",1,0],["لو ضِعفُ عُمرِيَ يا أمَّاهُ أنفِقُه","لردِّ دَيْنِكِ ما وفَّيْتُ مِعشارا",21,"ر",2,0],["لو ..ضلت الأرضُ القداسةَ والهدى","هي كالرسولِ .. ودينُها الزيتونُ",22,"ن",1,0],["لَوْ ضَاقَتِ الدُّنْيا عَلَيَّ بِأسْرِهَا","فالله ربِّي خَالِقِي يَكْفِيْنِي",23,"ن",2,0],["لو ضمَّنا خدرُ اللقاءِ فدونَنا","حدٌّ المعاصي عن أثامٍ مُسقمِ",24,"م",1,0],["لو ضاء نورك بالإسلام ما أفُلَتْ","أنوار مجدك حيث العزُّ موفورُ",25,"ر",1,0],["لو ضاق قلبي وزاد غيابه الضيقه","بالله قولو لحبيبي كيف خلاني ؟",26,"ن",2,1],["لو ضيقي يطبق بظلوعي","ما ابديته لو حزني لف",27,"ف",1,0],["لو ضدت أوراقه من كثرة","طالت على متطاول الأجيال",28,"ل",1,0],["لوضرير الحظ فتّح وقال له حظه:-( صَحوّت)","تحت أمرك لك آلبي لك أنا طوع ورهينه",29,"ن",2,0],["لو ضايقتني ضيقتي ما اسفهليت","في وجه حزني يوم كشر ب نابه",30,"ب",2,0],["لوضَعْتُهُ فوق الجبينِ تحيةً","لقصيدِهِ في الحكم أو تصحيحِ ما",31,"م",2,0],["لو ضربتم بقداح للعلا","لم يطر غير المعلى لي قدح",32,"ح",1,0]]}