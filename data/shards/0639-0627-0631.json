حدَي","نَ بِعِزِّ يَماتِهِم في السُيوفِ",3,"ف",1,0],["عارِضا بي رَكبَ الحِجازِ أُسائِل","هُ مَتى عَهدُهُ بِسُكّانِ سَلعِ",4,"ع",1,1],["عارٍ يُصافِحُ أَعناقَ الرِجالِ بِهِ","يَومَ النَزالِ وَما في باعِهِ قِصَرُ",5,"ر",1,0],["عارَضتُها إِذ توَلَّتْ","بها الحدوجُ الغوادي",6,"د",2,0],["عارضتُها فاتَّقَتْ طَرفي بجارَتِها","كالشَّمسِ عارَضَها غَيمٌ يواريها",7,"ي",3,0],["عارَضْتُها فنظَرْنَ عن حَدَقِ المَها","يَلمَحْنَ بارقَةَ الغَمامِ الجُونِ",8,"ن",1,0],["عارٌ عَلى اِبنِ النيلِ سَبّاقِ الوَرى","مَهما تَقَلَّبَ دَهرُهُ أَن يُسبَقا",9,"ق",2,0],["عارٍ مِنَ العارِ كاسٍ مِن مَفاخِرِهِ","تَكادُ عِزَّتُهُ تَستَوقِفُ القَدَرا",10,"ر",2,0],["عارِضٍ زَوراءَ مِن نَشمٍ","غَيرُ باناةٍ عَلى وَتَرِه",11,"ر",2,0],["عارِضُ سَحماءَ رُدَينِيَّةٍ","كَالنارِ فيها آلَةٌ ماضِيَه",12,"ي",2,0],["عارٍ بِلا ثَوبٍ صَريعٌ في الثَرى","بَينَ الحَوافِرِ وَالسَنابِكِ يُخضَدُ",13,"د",1,0],["عارٌ بقومكِ يا ابنةَ الحيَّيْنِ أن","تلوي الديون وأنت ذات يسارِ",14,"ر",1,0],["عار على المسلمين اليوم أنهم","لم ينقذوا مصر أو لم ينقذوا عدنا",15,"ن",2,0],["عاري الأَشاجِعِ مِن ثَقيفٍ أَصلُهُ","عَبدٌ وَيَزعُمُ أَنَّهُ مَن يَقدِمُ",16,"م",1,0],["عارضت أبيات العماد فعاذر","ولو أنها ذات العماد بأن تهي",17,"ه",2,0],["عارضٌ أمطر غيري وَدَعَتْ","رائدي منْهُ بُروقُ ورُعودُ",18,"د",1,0],["عارفُ النفسِ أنني لم أجاوزْ","فيك قولَ العِدا بجهِد احتفالِ",19,"ل",1,0],["عارُهُمْ لازمٌ لكُمْ أيُّها النَّا","سُ لأنَّ الأديانَ كالأرحام",20,"م",1,0],["عارضَ بالإحسانِ حُسناً له","لا يبلغ الوصفُ مدَى كُنهِهِ",21,"ه",2,0],["عارٌ إِذا أَنشَبتُ فيكَ مَخالِبي","إِذ لَيسَ مِن خُلُقي اِفتِراسُ نِعاجِ",22,"ج",1,0],["عارٌ عَلى نَسلِ المُلوكِ بَني العُلى","أَن يَستَذِلَّهُم بَنو الرُعيانِ",23,"ن",1,0],["عارٌ رُجوعُكَ بَعدَما","عايَنتَ حيطانَ الرُبوعِ",24,"ع",1,0],["عارٌ فظائع دنشواى وسُبّة","غسلتهما هذى اليد البيضاء",25,"ا",2,0],["عارضتُهن وبين قلبي والهوى","أمر أحاول كتمه وأداري",26,"ر",2,0],["عارَضتُها وَضَميري مِن مَحارِمِها","يَزوَرُّ عَن لَحَظاتي في مَساريها",27,"ي",3,0],["عارَضتُهُنَّ وَلي فُؤادٌ عُرضَةٌ","لِهَوى الجَآذِرِ دانَ فيهِ وَدينا",28,"ن",2,0],["عارِضٌ مِن أَبي سَعيدٍ دَعانا","بِسَنا بَرقِهِ غَداةَ تَراءى",29,"ا",2,0],["عارَضنَنا أُصُلاً فَقُلنا الرَبرَبُ","حَتّى أَضاءَ الأُقحُوانُ الأَشنَبُ",30,"ب",1,1],["عارِضٌ صَوبُهُ حِجىً وَعَفافٌ","وَنَوالٌ مِنَ اللُجَينِ صَبيبُ",31,"ب",1,0],["عارَضَت رَبعي بِفَيضٍ مُزبِدٍ","بَينَ أَموَجٍ تَسامى وَحُبُك",32,"ك",1,0],["عارَضَتكَ الأَنواءُ فيها سَماحاً","وَحَكَتكَ السَماءُ سَحّاً وَوَبلا",33,"ل",2,0],["عارٌ عَلَيَّ مَتى أَدَعتُ ذِمامَها","أَو رُعتُها في الحُبِّ بِاِستِبدالِ",34,"ل",1,0],["عاري الأَشاجِعِ مَسعورٌ أَخو قَنَصٍ","فَما يَنامُ بَحيرٌ غَيرَ تَهويمِ",35,"م",1,0],["عارٍ منَ النَّسَبِ الوضَّاحِ مُنتَسِبٌ","في الخالديَّةِ بين الذُّلِّ والعارِ",36,"ر",1,0],["عارٌ يُناديهِ الهَوى فَيُجيبُهُ","طَوعاً وَيَدعوهُ الغَرامُ فَيَسمَعُ",37,"ع",1,0],["عارٌ عَلَيَّ بِأَن أَكونَ مُشَرِّعاً","دينَ الهَوى وَيُقالُ إِنّي مُشرِكُ",38,"ك",1,0],["عارِضٌ يَنهلُّ بالوَبلِ إِذا","كان للعارضِ كفَّ الجَلمَدِ",39,"د",1,0],["عارضتموهُ بما لم يرضني سفهاً","فقلتُ خلُّوا سبيلي لا أبا لكم",40,"م",1,0],["عارُ الزِّنَا يُخزِي الوُجوهَ وشَرُّه","يَرمِي البلادَ وأهلَهَا بِهَلاكِ",41,"ك",1,0],["عارِضَاهُ وَوجنَتَاهُ أعَدَّا","لِفُؤَادِي سَلاَسِلاً وَسَعِيرَا",42,"ر",2,0],["عارٍ كَما أَعرورى الخري","ف تَساقَطَت أَوراقه",43,"ه",1,0],["عاري الظَنابيبِ مُمتَدٍّ نَواشِرُهُ","مِدلاجِ أَدهَمَ واهي الماءِ غَسّاقِ",44,"ق",1,0],["عاري النَسا يَنتَهِبُ التُربَ لَهُ","حَوافِرٌ باذِلَةٌ ما يَنتَهِب",45,"ب",1,0],["عارَضَتْنا المَها الخوَاذِلُ أسْرا","باً بأجراعِهَا فلمْ نَسْلُ عنكِ",46,"ك",1,0],["عارِضٌ يُمطِرُ السَبيلَ وَإِن كا","نَ دُواراً فيِ الحادِثِ القَمطَريرِ",47,"ر",1,0],["عارَضَهُ المُكّاءُ كَالمُستَعدي","صَبَّحتُهُ في ظِلِّ مُزنٍ سَمدِ",48,"د",1,0],["عارِياتٍ مِنَ النَباتِ وَلَكِن","أُلبِسَت مِن سَرابِها كَالرِياطِ",49,"ط",1,0],["عارَضَتنا بِوُدِّها فَكَرِهنا","هُ وَآبَت لِزَورَةٍ فَأَبينا",50,"ن",2,0],["عَارَضْتُهَا بِعَنُودٍ غَيْر مُعْتَلَثٍ","تَرِنُّ مِنْهُ مُتُونٌ حِينَ يَجْرِينَا",51,"ن",2,0],["عارياتٍ يسبحن في اليم لكنْ","لفَّها الرغو في رقيقِ الثيابِ",52,"ب",1,0],["عَارٍ صَغيرٌ وَاجِفٌ","لَمْ يَبْقَ مِنْهُ سِوَى الذَّمَاءْ",53,"ا",2,0],["عارٍ من النّصْرِ والثّراءِ وَمِنْ","أَبْطَالِ أهْلِ الَطْحَاءِ والأسَلِ",54,"ل",1,0],["عارٌ علينا لُبْسُهُ حتى يُرَى","مُتَطَهِّرًا، بدم العِدا متعطِّرا",55,"ر",2,0],["عارية هذي النفوس ولازم","ان يسترد العدل كل معار",56,"ر",1,0],["عاريا ما استعرت غير جبيني","شاحبا ما حملت غير سماتي",57,"ت",2,0],["عارياتٍ يسبحن في اليم لكنْ","لفَّها الرغو من رقيقِ الثيابِ",58,"ب",1,0],["عارٌ على صفحة التاريخ قيلتُه","ولطخةٌ في جبين المجدِ ما كتبا",59,"ب",2,0],["عارٌ على أهل الهوى ان تُزدرى","هذي النفوسُ وتُشترى الأعلاق",60,"ق",1,0],["عاريا ظهرُك الرشيقُ تحبُ العينُ","منه اتساقَهُ واتزانه",61,"ن",2,0],["عارض زوراء من نشم","غير باتاة ٍ على ترهْ",62,"ر",2,0],["عارٌ عَلَىَّ متى أَضَعْتُ ذِمَامَها","أَو رُعْتُها في الحُبِّ باسْتِبْدَالِ",63,"ل",1,0],["عارَضَتْ رَبْعي بفَيْضٍ مُزْبِدٍ،","بَينَ أموَاجٍ تَسامَى، وَحُبُكْ",64,"ك",1,0],["عارض صوبه حجى وعفاف، و","ونوال من اللجين صبيب",65,"ب",1,0],["عاركتَني شَدائد الدَهر حَتّى","عَلَمتَني وَقائع الأَحوال",66,"ل",1,0],["عارف تاريخه حي فقل","رحمة الله على القطب حسن",67,"ن",1,0],["عاركتنا الاشواق فيه فذبنا","ويمينا لا نسمع النصاحا",68,"ح",2,0],["عارفنا جملة أيامه","في خدمة الرحمن مصروفه",69,"ه",1,1],["عارضتنا منكمُ فئةٌ","أحدثت في عهدِنا دخلا",70,"ل",2,0],["عارضٌ أبدى بروقاً جمةً","وهو لم يأتِ ببرقٍ خُلَّبِ",71,"ب",1,0],["عاري الأَشاجِعِ مَعصوبٌ بِلُمَّتِهِ","أَمرُ الزَعامَةِ في عِرنينِهِ شَمَمُ",72,"م",1,0],["عَارِفٍ بالعلوم عَارِ من العَا","رِ شَفَيقٍ عَلَى الضَّعِيفِ العَارِي",73,"ر",2,0],["عارِضٌ صِرتُ فيهِ كَالصَعدَةِ السَم","راءِ لَوناً وَدِقَّةً وَذُبولا",74,"ل",2,0],["عارَضتهُم بِكَنازِ اللّحمِ ناجيةٍ","اَعرَت دَسائعَها الحاجاتُ وَالنَّفَرُ",75,"ر",1,0],["عارضني محتسب بارد","في كرخ بغداذ بإنكار",76,"ر",1,1],["عارِفاتٍ إِذا التَقى أَسَلُ المَوتِ","بِكَرِّ الكُماةِ وَالتَقديمِ",77,"م",1,0],["عارا ارى عنه القعود بمدحه","وهو الذي في الله كان قيامه",78,"م",2,0],["عارٌ عَلَينا نَنامُ اللَيلَ هانِئَةً","عُيونُنا وَعبابُ اللَيلِ مُعتَكِرُ",79,"ر",1,0],["عارٌ عَلَيكِ وَهذا الظِلُّ مُنتَشِرٌ","