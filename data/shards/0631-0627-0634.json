{"poems":[[77,"راش زماني وبرى نبله","https://www.aldiwan.net/poem36061.html","السريع"],[0,"رب رام من بني ثعل","https://www.aldiwan.net/poem66.html",""],[72,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[51,"يا فؤادي غلبتني عصيانا","https://www.aldiwan.net/poem66699.html","الخفيف"],[80,"ما صد عني بوجهه ولها","https://www.aldiwan.net/poem31338.html","المنسرح"],[45,"عاوَدََ القلْبَ بَثُّهُ وَخَبالُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32125",""],[80,"ما صدّ عني بوجههِ ولَهاَ","https://www.poetsgate.com/ViewPoem.aspx?id=3520",""],[121,"راشد العاشقين زد لي فؤادي","https://www.aldiwan.net/poem23826.html","الخفيف"],[169,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[198,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[377,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[377,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[458,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[464,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[538,"نعيت نفسي إليه","https://www.aldiwan.net/poem47496.html","عموديه"],[562,"واحد في الحمى فدته ألوف","https://www.aldiwan.net/poem52775.html","الخفيف"]],"verses":[["رَاشَ زَمَانِي وَبَرَى نَبْلَهُ","فَكُنْتَ لِي مِنْ وَقْعِهَا جُنّهْ",0,"ن",2,1],["راشَهُ مِن ريشِ ناهِضَةٍ","ثُمَّ أَمهاهُ عَلى حَجَرِه",1,"ر",2,0],["راشَ منها البنان نبعة سهم","فأصابت شواكل الأغراض",2,"ض",1,0],["راشفات أفواهَهُمْ رشَفَك الما","ءَ إذا ما شرِبْتَهُ ظمآنا",3,"ن",2,0],["راشَ بسحرٍ سهامَ مُقْلَتِهِ","بالحِمامِ المريجِ نَصّلَها",4,"ل",3,0],["رَاشَنَا أمْسِ جاهُهُ وَثَنَى اليوْ","مَ لَنا بالرّياشِ أجمَعَ مالُهْ",5,"ل",2,0],["راشَ بسحرٍ سهامَ مُقلتيه","وبالحِمامِ المريجِ نَصّلَها",6,"ل",3,0],["راشد العاشقين زد لي فؤادي","من هواك الذي تنيل المحبين",7,"ن",1,1],["راشَ ذَوي الفَقرِ وَأَحياهُمُ","وَاِحتَرَمَ المُثرِينَ أَيَّ اِحتِرام",8,"م",1,0],["راشُوا المساعي وقد قُصّت قوادِمُها","إنَّ الكسيرَ مع الأيامِ مجبورُ",9,"ر",1,0],["راش العداةُ سهامَهم لمذمَّتي","وسهام أحبابي أدقُّ وأرشق",10,"ق",1,0],["راشوا لقدحي أسهماً","ولكل مرءٍ ما خبا",11,"ب",2,0],["راشَتْ يداهُ قدحَها","من بعدِ ما قد كان يُبْرَى",12,"ر",2,0],["راشَ نبالاً في جفنه ورمَى","ظبي بجَمع ما راقبَ الحَرما",13,"م",2,1],["راشك لي نافذاً مصيباً","بارٍ تَجنَّى على نبالِ",14,"ل",1,0],["راشَ بالهدبِ سهاماً حيثما","أرسلتْ كانت سقاماً وخبل",15,"ل",1,0],["رَاش مِن سَهم الرَّزايا","مَارَسَا في مُهجَتيَّه",16,"ي",2,0],["راشدُ السَّعْي في المَكارمِ راعٍ","يَرتَعُ الذِّئبُ عندهُ والخَروفُ",17,"ف",1,0]]}