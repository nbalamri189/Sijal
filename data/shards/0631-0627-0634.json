{"poems":[[79,"راش زماني وبرى نبله","https://www.aldiwan.net/poem36061.html","السريع"],[0,"رب رام من بني ثعل","https://www.aldiwan.net/poem66.html",""],[74,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[53,"يا فؤادي غلبتني عصيانا","https://www.aldiwan.net/poem66699.html","الخفيف"],[82,"ما صد عني بوجهه ولها","https://www.aldiwan.net/poem31338.html","المنسرح"],[47,"عاوَدََ القلْبَ بَثُّهُ وَخَبالُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32125",""],[82,"ما صدّ عني بوجههِ ولَهاَ","https://www.poetsgate.com/ViewPoem.aspx?id=3520",""],[125,"راشد العاشقين زد لي فؤادي","https://www.aldiwan.net/poem23826.html","الخفيف"],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[202,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[382,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[382,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[438,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[469,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[543,"نعيت نفسي إليه","https://www.aldiwan.net/poem47496.html","عموديه"],[567,"واحد في الحمى فدته ألوف","https://www.aldiwan.net/poem52775.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37737","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62573","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64826","المنسرح"],[1846,"","https://poetry.dctabudhabi.ae/diwan/poem/147708",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125444","البسيط"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101431","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67210","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87686","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100340","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58424","البسيط"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108342",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129491","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70156","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94522","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81944","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72946","الرمل"],[4119,"يا سعد ما أحسنها شمائلا","https://www.poetsgate.com/ViewPoem.aspx?id=16208",""],[5061,"محمد بن الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147169",""],[5106,"عَاْشَ صَقْرَاً قَلَصَ الْكِبْرَ حِيْاْضَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150032",""],[5183,"خانني الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186601",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5690,"ضاءت الأكوان والدهر ابتسمْ","https://www.poetsgate.com/ViewPoem.aspx?id=172184",""],[5853,"قبلة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175708",""]],"verses":[["رَاشَ زَمَانِي وَبَرَى نَبْلَهُ","فَكُنْتَ لِي مِنْ وَقْعِهَا جُنّهْ",0,"ن",2,1],["راشَهُ مِن ريشِ ناهِضَةٍ","ثُمَّ أَمهاهُ عَلى حَجَرِه",1,"ر",2,0],["راشَ منها البنان نبعة سهم","فأصابت شواكل الأغراض",2,"ض",1,0],["راشفات أفواهَهُمْ رشَفَك الما","ءَ إذا ما شرِبْتَهُ ظمآنا",3,"ن",2,0],["راشَ بسحرٍ سهامَ مُقْلَتِهِ","بالحِمامِ المريجِ نَصّلَها",4,"ل",3,0],["رَاشَنَا أمْسِ جاهُهُ وَثَنَى اليوْ","مَ لَنا بالرّياشِ أجمَعَ مالُهْ",5,"ل",2,0],["راشَ بسحرٍ سهامَ مُقلتيه","وبالحِمامِ المريجِ نَصّلَها",6,"ل",3,0],["راشد العاشقين زد لي فؤادي","من هواك الذي تنيل المحبين",7,"ن",1,1],["راشَ ذَوي الفَقرِ وَأَحياهُمُ","وَاِحتَرَمَ المُثرِينَ أَيَّ اِحتِرام",8,"م",1,0],["راشُوا المساعي وقد قُصّت قوادِمُها","إنَّ الكسيرَ مع الأيامِ مجبورُ",9,"ر",1,0],["راش العداةُ سهامَهم لمذمَّتي","وسهام أحبابي أدقُّ وأرشق",10,"ق",1,0],["راشوا لقدحي أسهماً","ولكل مرءٍ ما خبا",11,"ب",2,0],["راشَتْ يداهُ قدحَها","من بعدِ ما قد كان يُبْرَى",12,"ر",2,0],["راشَ نبالاً في جفنه ورمَى","ظبي بجَمع ما راقبَ الحَرما",13,"م",2,1],["راشك لي نافذاً مصيباً","بارٍ تَجنَّى على نبالِ",14,"ل",1,0],["راشَ بالهدبِ سهاماً حيثما","أرسلتْ كانت سقاماً وخبل",15,"ل",1,0],["رَاش مِن سَهم الرَّزايا","مَارَسَا في مُهجَتيَّه",16,"ي",2,0],["راشدُ السَّعْي في المَكارمِ راعٍ","يَرتَعُ الذِّئبُ عندهُ والخَروفُ",17,"ف",1,0],["راش سهمَ الملامِ حينَ راشا","فحشاهُ قلبي وما إِن تَحاشى",18,"ش",2,1],["راشَ لهُ سَهْماً أصابَ الحَشا","تعمُّداً منْ لحظِهِ السّاحِرِ",19,"ر",1,0],["راشد الأُمّة مأمون البِنا","واقد الهمة مسنُون الشَبا",20,"ب",2,0],["راشد في الإسم لكن","هو في الفعل رشيد",21,"د",1,0],["راشَ جناحي بما حَباهُ وقد","مَضَى عليهِ دَهْرٌ ولم يَرِشِ",22,"ش",1,0],["راش إمام الهدى جناحي","وليس في الحق من جناح",23,"ح",1,0],["راشَت سِهامَ جَفُونٍ من لواحِظِها","وصوَّبتها إلى قلبي ووجداني",24,"ن",2,0],["رَاشَ الفتورُ لَهُ سَهْماً فَأَخطأَهُ","حتَّى أُتِيحَ لهُ سَهْمٌ من الكُحُلِ",25,"ل",1,0],["راشت نبالَ لحظها بهدبها","ثم رمتهن بقوسِ حاجب",26,"ب",1,0],["راشِقات النبل ماذا","تَبتَغين اليَوم فينا",27,"ن",2,0],["راشت سهام لحاظه اهدابه","ولقد جعلن قلوبنا اهدافا",28,"ف",2,0],["راشت لواحِظُها نَبلاً فَحاجِبُها","قوسٌ على أنّهُ بالموت مَقرونُ",29,"ن",1,0],["راشدا أو ناهضا أو قاصرا","عند رأى الغرب لا يبلغ رشدا",30,"د",2,0],["راشيت وقد كنت الوي نحوها نظري","فقلت عيني غضي الطرف واستتري",31,"ر",2,1],["راشت سهاما من فتور لواحظ","كحلت بسحر غواية الابصار",32,"ر",1,0],["راشت سِهاماً اصابت مِن بمصرعِهِ","لَم يَخُ مِن لَوعَةٍ قَلبٌ وَلا كبدُ",33,"د",1,0],["راشت لنا الأقدار سهماً منهُ قد","فرَّ التواصل والتقاطع قُربا",34,"ب",2,0],["راشت بريش اللحظ قلب صبابتي","سقَمت باسقام الجفون الجلمدا",35,"د",2,0],["راشَها الحُب كَما راشَ فَتاها","وَرَمى قَلبَيهُما عَن قَدَر",36,"ر",1,0],["راشفات كأنَّ أطرافهنَّ","بيض عاج ملبَّس تلبيسا",37,"س",2,0],["رَاشُوا لإِصماءِ الكُلى أَسهُمَهُم","بِقادِماتٍ وَخَوافٍ وَكُلَى",38,"ا",1,0],["راشدٌ من فضلِ رشدي","نال كليّاتِ سعدي",39,"ي",1,1],["راشقة بالنبل من ألحاظها","كأن تحت كل جفن نابلا",40,"ل",2,0],["راشد نباه يعيش لو الجسد مات","مات وبقى بين المخاليق نابيه",41,"ي",2,0],["رَاْشِدَ الْإِشْرَاْقِ فَيْضَاً مَاْ تَغَاْضَىْ","وَعَصِيَّاً يَبْعَثُ الْحَتْفَ فِرَاْضَاً",42,"ا",1,0],["راشديَّ النجار بوركت قصدا","فلأنت المبارك الإيتاء",43,"ا",2,0],["راشت من اللحظ سهما فانبرت كبدي","فقلت لا أخطأت كف لباريه",44,"ي",2,0],["راشد والي بلاد الشام بل","شهمها الندب الهمام المحترم",45,"م",1,0],["راشداً دربه الى","حبّها حافي َالقدمْ",46,"م",1,0]]}