{"poems":[[77,"عرصات دارك للضياف مبارك","https://www.aldiwan.net/poem36384.html","الكامل"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[27,"راح الرفاق ولم يرح مرار","https://www.aldiwan.net/poem5742.html","الكامل"],[72,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[89,"كم من حروب أثار الدين ثائرها","https://www.aldiwan.net/poem45118.html","البسيط"],[85,"يا كعبة العلم في الإسلام من قدم","https://www.aldiwan.net/poem7294.html","البسيط"],[45,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[81,"نظر جرى قلبي على آثاره","https://www.aldiwan.net/poem61515.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55143","الكامل"],[45,"أتَرَى الزّمَانَ يُعَيدُ لي أيّامي","https://www.poetsgate.com/ViewPoem.aspx?id=32037",""],[133,"للدهر في مسراه سر غريب","https://www.aldiwan.net/poem49188.html","السريع"],[140,"لا مرية في الردى ولا جدل","https://www.aldiwan.net/poem58417.html","المنسرح"],[141,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[158,"هو القضا فخذ المبسوط مختصرا","https://www.aldiwan.net/poem59004.html","البسيط"],[184,"للدهر إدبار وإقبال","https://www.aldiwan.net/poem43448.html","الطويل"],[197,"أشكو لها الحب ظنا أن سيعطفها","https://www.aldiwan.net/poem45215.html","البسيط"],[202,"للدهر ما بين الأنام وزيف","https://www.aldiwan.net/poem53097.html","الكامل"],[223,"إن الليالي من أخلافها الكدر","https://www.aldiwan.net/poem55100.html","البسيط"],[233,"للدهر يا أبناء معمر","https://www.aldiwan.net/poem31933.html","مجزوء الكامل"],[273,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[362,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[369,"نظر الغرام إليه من نظراته","https://www.aldiwan.net/poem56923.html","الكامل"],[376,"من كل هوجاء لها جوف هبل","https://www.aldiwan.net/poem4575.html","الرجز"],[413,"إن الممالك في صدارة أحمد","https://www.aldiwan.net/poem53978.html","الكامل"],[456,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[556,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[560,"يا بائع الصبر لا تشفق على الشاري","https://www.aldiwan.net/poem52764.html","البسيط"],[560,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[560,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[560,"دع ذكر بانات العلم","https://www.aldiwan.net/poem52959.html","مجزوء الكامل"]],"verses":[["لِلدِّينِ وَالدُّنْيَا وَلِلشِّيَم الْعُلَى","وَالْجُودِ إِنْ شَحَّ الْغَمَامُ السَّافِك",0,"ك",1,0],["لِلدَّاءِ فِيهِ دَوَاءٌ","وَلِلْجِرَاحِ مَرَاهِمْ",1,"م",1,0],["للدهر لونان من نور ومن غسق","هذا يعاقب هذا كلما بَرحا",2,"ح",2,0],["لِلدافِنينَ أَخا المَكارِمِ وَالنَدى","لِلَّهِ ما ضَمِنَت بِكَ الأَحجارُ",3,"ر",1,0],["للدين والدنيا جمال به","كأنه روحٌ لجثمان",4,"ن",1,0],["للدين والدنيا عليهِ سناً","يعرب عن فحواه عنوانه",5,"ن",2,0],["للدين في كل قطر آهل كلم","سحارة اللفظ يستهوي بها الناسا",6,"س",2,0],["للدّين والبيت رب لا يقاومه","حمر الثياب ولا سود الأساطيل",7,"ل",1,0],["لِلدَهرِ عِندي مِنَّةٌ مَشكورَةٌ","شَفَتِ الَّذي في الصَدرِ مِن أَوغامِ",8,"م",1,0],["للدّهر منه ومن عجائبِ صنعِه","مَثَلٌ يُريهِ بلاءَه فَيُهالُ",9,"ل",1,0],["لِلدَمعِ خَطٌّ فَوقَ صُفرَةِ خَدِّهِ","فَتَراهُ مِثلَ النَقشِ في دينارِهِ",10,"ر",2,0],["للدهر لا تلم","فالدَهر ما غدر",11,"ر",1,0],["لِلدِّينِ وَالوَطَنِ اغْتِبَاطٌ بِالَّذِي","جَدَدْتَ مِنْ مَجْدٍ تَحَيَّفَهُ البَلَى",12,"ل",2,0],["للدّهْرِ عِندي نِعْمَةٌ مَشْكُورَةٌ","شَفَتِ الذي في الصّدرِ من أوْغَامِي",13,"م",2,0],["للدهر في مسراه سرٌّ غريبْ","يحفي على غير الأديب الأريبْ",14,"ب",1,1],["للدهر نُعمى ومنَّةٌ ويدٌ","ما قام في الناس منْكُمُ رجلُ",15,"ل",1,0],["لِلدَولَةِ الغَرّاءِ مِنكَ ذَخيرَةٌ","جَلَّت فَحُقَّ لِمِثلِها أَن يُذخَرا",16,"ر",2,0],["للدين عشرون عاما في خلافته","ينمو نمو زروع تغتذى المطرا",17,"ر",2,0],["للدهر إدبارٌ وإقبال","وكل حال معها حال",18,"ل",1,1],["للدهرِ جنبانِ لا ينفكُّ منقلباً","حيناً وحيناً كما تغريهِ عيناكِ",19,"ك",1,0],["للدهر ما بين الأنام وَزِيفُ","ولصَرفه بين الورى تصريفُ",20,"ف",1,1],["لِلدَهر لو كنتَ تَدري هولَ مَنطِقِهِ","وَعظٌ تُرَدِّدُهُ الآصالُ وَالبُكَرُ",21,"ر",1,0],["لِلدَهرِ يا أَبناءَ مَعمَرٍ","لَكُم ذُنوبٌ لَيسَ تُغفَر",22,"ر",1,1],["لِلدِّينِ والدُّنيا بِعِصْمةِ ذاتهِ","إِعْجابُ مَنْ هُوَ في حِماهُ وَادِعُ",23,"ع",1,0],["للدَّسْتِ أصبحْتَ مثلَ الرُّوحِ في جَسَدٍ","منه فعاش ومثْلَ الرّاحِ في كاس",24,"س",1,0],["لِلدَينِ مِنهُ الناصِرُ اِستِنجادُهُ","إِذا دَعا غَداةَ خَطبٍ موئِدِ",25,"د",1,0],["للدَّهرِ آفاتٌ تَردُّ صُرُوفَهُ","وَبقاؤهُ في الدَّهرِ من آفاتِهِ",26,"ت",2,0],["للدلو في أيديهم سفح عجل","صقبان ممشوقان مأروما الأصل",27,"ل",1,0],["للدولة العلياء في سلطانها","أَرّخ تصدّر مدحت العلياء",28,"ا",2,0],["للدهر عندي ولأبنائه","بعد اجتماعي وثبةُ الأرقمِ",29,"م",1,0],["للدّهرِ أفلاكٌ تدورُ بكفِّه","والنّاسُ تحسَبُها خُطوطَ بَنانِ",30,"ن",1,0],["للديلمي في مسند ال","فردوس عن خير البرايا",31,"ا",3,0],["للدَّهرِ يومٌ علينا لا يدومُ كما","يومٌ لنا لم يَدُمْ في حكمهِ الجاري",32,"ر",2,0],["للدَّهرِ في كلِّ عينٍ دَمعَةٌ قَطَرَتْ","منهُ وفي كلِ قلبٍ جَمْرةٌ تَقِدُ",33,"د",1,0],["لِلدَّهرِ في الأحكامِ بابٌ مُغلَقٌ","لا يَهتدِي أحَدٌ إلى مفتاحِهِ",34,"ح",2,0],["للدَّهرِ حُكمٌ في الوَرَى","فأطِعْهُ وارضَ بما حَكَمْ",35,"م",1,0]]}