{"poems":[[55,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[55,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[90,"خليل هل من منصت فأبثه","https://www.aldiwan.net/poem44797.html","الطويل"],[90,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[47,"متى تسألي عن عهده تجديه","https://www.aldiwan.net/poem66847.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16656","الطويل"],[147,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[185,"ألا هل لأيام تولين مطلب","https://www.aldiwan.net/poem58840.html","الطويل"],[185,"أرى غدر ليلى يا خليلى حاملي","https://www.aldiwan.net/poem59057.html","الطويل"],[275,"حنت ليلى على الصب المريض","https://www.aldiwan.net/poem35018.html","الوافر"],[325,"أرى غصن المسرة قد تثنى","https://www.aldiwan.net/poem67132.html","الوافر"],[342,"أريغوني إراغتكم فإني","https://www.aldiwan.net/poem45317.html","الوافر"],[376,"أرى غير الأيام تسطو ولا أرى","https://www.aldiwan.net/poem57395.html","الطويل"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[469,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[556,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122556","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96691","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108621","الوافر"],[3800,"","https://poetry.dctabudhabi.ae/diwan/poem/146651","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77190","الوافر"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33811","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120277","الطويل"],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""]],"verses":[["أَرى غَمرَةً يَتَّقيها الرَجا","لُ مَحفوفَةً بِالقَنا طاغِيَه",0,"ي",2,0],["أَرى غَديراً شَبِماً ماؤُهُ","فَهَل لِذاكَ الماءِ مِن وارِدِ",1,"د",1,0],["أرى غثياناً في النفوس وهل ترى","نفوساً على خُبث المطاعم لا تغثي",2,"ث",2,0],["أرى غرر الأشعار تبدو نضيدوً","على صفحات الكون سطراً على سطر",3,"ر",1,0],["أَرى غَيثَينِ يَستَبِقانِ جوداً","هُما مَطَرُ السَما وَالغائِثونا",4,"ن",2,0],["أَرى غَفلَةَ الأَيّامِ إِعطاءَ مانِعٍ","يُصيبُكَ أَحياناً وَحِلمَ سَفيهِ",5,"ي",2,0],["أرى غَمَراتٍ ينْجَلِينَ عن الفَتى","ولكن تُوَافي بعْدَها غَمَرات",6,"ت",1,0],["أَرى غِيَرَ الأَيّامِ تَلعَبُ بِالوَرى","فَلا زِلتَ مَحروساً وَلا جَدَّ لاعِبُ",7,"ب",1,0],["أَرَى غِيرَ الأَيّامِ أَزرَى بِلِينِها","وَمَعروفِها دَهرٌ بِنَا يَتَقَلَّبُ",8,"ب",1,0],["أَرَى غَدرَ ليلى يا خَليلىَّ حامِلي","عَلَى غَدرَةٍ ما كانَ قلبى يُطيقُها",9,"ه",2,1],["أرى غمدانَ من صنعاءَ يبدو","لدَى تجريدِ مُعتِدِلٍ بضيض",10,"ض",1,0],["أَرى غُصنَ المَسَرِّةِ قَد تَثَنّى","وَقَمَري الهَنا بِالبِشرِ أَفصَحُ",11,"ح",1,1],["أَريغوني إِراغَتَكُم فَإِنّي","وَحَذفَةَ كَالشَجا بَينَ الوَريدِ",12,"د",1,1],["أرى غِيرَ الأيام تَسطو ولا أَرى","لِسَطوَتِها من مُنكرٍ أو مغيِّرِ",13,"ر",1,1],["أرى غُرفاً من الياقوت فيها","بدا سرُ العجيبة والحبيب",14,"ب",1,0],["أريغت وقد جاوزا الكمال مهودها","وشد وقد حاوزا التمام تميمها",15,"م",3,0],["أُريغ جَداها وهْي جِدُّ بخيلةٍ","وأعْيا على راجي الغواني بخيلُها",16,"ل",3,0],["أرى غَفَلاتِكم أطفأنَ نُوري","إمِصباحٌ يُضيءُ بِغيرِ زيت",17,"ت",1,0],["أَرى غيمَ آمالي دنَت وتَرَاكمت","أراعيله واِنفضّ عنّي وما سقى",18,"ق",2,0],["أرى غادات مصر يقمن عندي","ولا يهجرنني أيام يسري",19,"ر",2,0],["أرى غلام عبيد الله أمرضني","بصورة حيرت في حسنها القمرا",20,"ر",2,1],["أَرى غُرَر المَكارِمِ مِن جَوادِ","بِها تَستَل أَحقاد الأَعادي",21,"د",2,1],["أَرى غَيماً تُؤَلِّفُهُ جَنوبُ","أَراهُ عَلى مَساءَتِنا حَريصا",22,"ص",2,1],["أرى غاية اللذات قبل ابتدائها","فمن أجل هذا لست أنعم في الدنيا",23,"ي",2,1],["أرى غيوم الدهر والسحب في","أجوائنا بالبشر لم تغدق",24,"ق",1,0]]}