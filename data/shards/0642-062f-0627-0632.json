{"poems":[[53,"ما لحيتاننا جفتنا وأنى","https://www.aldiwan.net/poem66012.html","الخفيف"],[93,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[91,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[91,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[71,"قد أزمن الله كافورا وعاقبه","https://www.aldiwan.net/poem29025.html","البسيط"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[264,"ألا أيها الميال عن منهل الورد","https://www.aldiwan.net/poem35819.html","الطويل"],[264,"الحمد للمذكور وهو الذاكر","https://www.aldiwan.net/poem35951.html","الرجز"],[409,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[438,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[443,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[505,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[567,"لرزق الله دار مع أخيه","https://www.aldiwan.net/poem52661.html","الوافر"],[567,"قف بالديار إذا الليل البهيم سجا","https://www.aldiwan.net/poem52900.html","البسيط"],[591,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101559","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100150","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62543","الكامل"],[2184,"","https://poetry.dctabudhabi.ae/diwan/poem/104216","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137191",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130757","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94051","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201761","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202597","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199956","السريع"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102335","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134002","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134024","الطويل"],[3232,"","https://poetry.dctabudhabi.ae/diwan/poem/100430","الكامل"],[3391,"","https://poetry.dctabudhabi.ae/diwan/poem/146629","السريع"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82827","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108419",""],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35594","الرجز"],[4767,"مقام الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=179965",""],[5111,"الْفَجِيعَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=212353",""],[5376,"في الليلة الظلماء ساد نواح","https://www.poetsgate.com/ViewPoem.aspx?id=194862",""],[5431,"نظرةٌ تُحيي تُذيب","https://www.poetsgate.com/ViewPoem.aspx?id=183475",""],[5691,"أبشروا بالرفاه...!","https://www.poetsgate.com/ViewPoem.aspx?id=206155",""],[5956,"قد ازداد فقهاً بمعنى العمل","https://www.poetsgate.com/ViewPoem.aspx?id=193568",""]],"verses":[["قد أزحنا اعتلالهم وجَعَلنا","سَبْتهم جمعةً فما يُشكيهِمْ",0,"م",1,0],["قَدِ اِزدانَت بِكَ الفِتيانُ طِفلاً","كَما يَزدانُ بِالتاجِ الجَبينُ",1,"ن",1,0],["قد أزعجوها حين لم تحفل بهم","بالكذب من حقد وبالأرجاف",2,"ف",1,0],["قد ازهقت منه ارواح مسالمة","تبغي الحياة وديست منه اوطان",3,"ن",1,0],["قدْ أزمنَ اللهُ كافوراً وعاقبَهُ","هذا بذاكَ ولا عُتبى على الزمن",4,"ن",1,1],["قَد أَزالَت وهيَ طعمٌ وشفا","سَقَمي عنّي وَزادت سِمَني",5,"ي",1,0],["قد ازددت طغاياً فيا ويحك اتئد","أسأت فيا سوآك من سوء ما تبدي",6,"د",2,0],["قد أزهرت روضةُ معناه الّتي","أضحت نعيم مهجتي وجنّتي",7,"ي",1,0],["قد أزال الهم عنا لفظه","ما خلا إشكالنا لم يَزُلِ",8,"ل",1,0],["قد أَزِفَ الوقتُ وداعى النَّوَى","أَطْنَبَ في نَاهٍ ونَهْنَاهِ",9,"ه",1,0],["قد ازمعوا للبين حتى أنه","قرب البعاد وحان منه الموعد",10,"د",1,0],["قد أَزْعَجَ القومَ منَّا نورُ طالِعِنا","يُعْشي الخَفافيشَ لو حقَّقْتَ تَنْويرُ",11,"ر",1,0],["قد ازدانَتْ بها بيروتُ حُسناً","فكانت نُزهةً في كلِّ عينِ",12,"ن",1,0],["قد أزهرَ الأزهرُ الضَّاحي بطلْعتهِ","كالبدرِ من مَشرقِ الأفلاكِ قد خَرَجا",13,"ج",2,0],["قَدْ أَزْعَجَ القَلْبَ الغَرامُ وأَعْجَزَ ال","طَرْفَ المنامُ فَحَقَّ لي أَنْ أَجْزَعَا",14,"ع",2,0],["قد ازوجوا بالماء سلسلهم","فتولَّد الإطرابُ والهذرُ",15,"ر",1,0],["قد أزعجوا أيتاماً قد أججوا","بخيامنا لهب السعير المضرم",16,"م",1,0],["قد أزهد الزهاد بالورع الذي","تنذاب منه قسوة الأحجارِ",17,"ر",1,0],["قد أزهر الدهر بأنوارهم","فابتهج القاصي والداني",18,"ي",1,0],["قد ازهر النادي وطاب اريجه","لما بجانبه شذاك تأرجا",19,"ج",2,0],["قد ازاحت يد الطبيعة سترا","فبدا تحته السنا والسنام",20,"م",1,0],["قد ازدهت مصر به وأشرقت","وأصبحت ضاحكة مستبشره",21,"ر",2,0],["قد أزعجتك قوانصٌ من معشري","فحسبتَني منهم أليفَ شرور",22,"ر",1,0],["قد أزعجوني في الغياب فكيف بي","إن كنت في جمع لهم ووفود",23,"د",1,0],["قد أزعج الاحياء في نظمه","حتى غدت تحسد أهل القبور",24,"ر",1,0],["قد أزمعتُ بصريمتي وتجنُّبي","وتهوُّكٍ من ذاك في إِعتابِ",25,"ب",1,0],["قد ازدان بالتقوى وبالحلم علمه","وحسبك مولى عامل وهو عالم",26,"م",1,0],["قد ازدان بالأنوار منك اقتباسه","فأنت له شمس المحاسن والبدر",27,"ر",1,0],["قد أزعجوا أيتامنا قد أججوا","بخيامنا لهب السعير المضرم",28,"م",1,0],["قد أزف الموت وأهواله","أهل الخطيات ألا تتقون؟",29,"ن",1,1],["قَد أَزعَجَت حَتّى الطُيور","وَمُنى بِها سَمكُ البُحور",30,"ر",1,0],["قد ازهرت منه المرؤة والوفا","كالورد ما بين الرياض يفتح",31,"ح",1,0],["قَد أَزهَر الوَردُ عَلى خَدّهِ","لَكِنَّهُ مُمتَنع القَطفِ",32,"ف",1,0],["قد أزهرت من نورها تلك السما","والأرض مِما أنزلتْ خضراء",33,"ا",2,0],["قَدْ أزْهَرَتْ آهَاتُ شَجْوِي فِيْ دَمِي","مِلْحُ الأجَاجِ يَؤُجُّ سَيْلَ دُمُوعِي",34,"ع",2,0],["قد أزْهرَ الموتُ الذي بربيعها","رغم العنا ما أثمر التفاحُ",35,"ح",1,0],["قد أزلت الهمّ عني","روحنا فيكم تطيب",36,"ب",1,0],["قدْ أُزيلتْ شتّى المَشاكِلِ حَلّاً","وغَدا سِعْرُ كلِّ شيْءٍ رَخيصا !",37,"ص",2,0],["قد ازداد فقهاً بأنَّ العملْ","يحلّ مشاكله والدولْ..",38,"ل",1,1]]}