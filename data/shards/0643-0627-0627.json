{"poems":[[466,"","https://poetry.dctabudhabi.ae/diwan/poem/63271","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116006","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""],[5809,"ترقيق","https://www.poetsgate.com/ViewPoem.aspx?id=205315",""],[463,"ألطيمة ٌ حبستْ بكاظمة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60221&r=&rc=277",""]],"verses":[["كاَ التَّصوُّنُ أن تماط سُجوفُه","فحفظتهُ بتبرعٍ لم يكْدُرِ",0,"ر",1,0],["كا الصّدودُ شفاءً لو علمت به","بأنَّ حبلىَ منكم سوف ينصَرِمُ",1,"م",1,0],["كا اهل بدر وكاهل الشجرة","والخلفاء ثم باقي العشرة",2,"ه",1,0],["كأ الجماد الناضح الدم لم يكن","سميعا بصيرا مدركا متكلما",3,"م",2,0],["كااوردِ أهديهِ الحبيبَ","وتارةً أهدي الصديقا",4,"ق",2,0],["كا افتراقهما تجمُّعنا","حتى إذا اجتمعا تفرَّقنا",5,"ن",2,0]]}