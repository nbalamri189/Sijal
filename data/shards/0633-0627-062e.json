{"poems":[[53,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[3,"ألا من مبلغ أهل الجحود","https://www.aldiwan.net/poem142.html",""],[4,"لست بغافر لبني بغيض","https://www.aldiwan.net/poem21208.html","الوافر"],[51,"أحل العراقي النبيذ وشربه","https://www.aldiwan.net/poem62906.html","الطويل"],[51,"أراحنا الله منك يا قذره","https://www.aldiwan.net/poem63010.html","البسيط"],[12,"إذا أصبحت بين جبال قوو","https://www.aldiwan.net/poem1227.html",""],[45,"لدن هجرته زحزحته عن الصبر","https://www.aldiwan.net/poem63642.html","الطويل"],[45,"ملنا أم نبا بنا أم جفانا","https://www.aldiwan.net/poem66784.html","الخفيف"],[61,"رأيتك تبري للصديق نوافذا","https://www.aldiwan.net/poem51420.html","الطويل"],[66,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[48,"وعاذلة تعيب علي عادي","https://www.aldiwan.net/poem66632.html","الوافر"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[46,"سأخرج بالكراهة من زماني","https://www.aldiwan.net/poem22946.html","الوافر"],[130,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[183,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[221,"ناقم على السماء","https://www.aldiwan.net/poem41593.html","مجزوء الرمل"],[268,"أبنت الروم في أعلى الصروح","https://www.aldiwan.net/poem35027.html","الوافر"],[268,"لك الويل يا قلبي فذب أو تصدع","https://www.aldiwan.net/poem35063.html","الطويل"],[268,"خمارك فيه لقلبي خمر","https://www.aldiwan.net/poem35423.html","المتقارب"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[340,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[364,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[451,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[451,"ها هو الشحاذ لصق البنك","https://www.aldiwan.net/poem61577.html","مجزوء الرمل"],[456,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[511,"إذا اشتد ما ألقاه هون علتي","https://www.aldiwan.net/poem67704.html","الطويل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[536,"خليفة عيسى مع سليل محمد","https://www.aldiwan.net/poem47580.html","عموديه"],[573,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"],[573,"تعودت الهوى والخير عاده","https://www.aldiwan.net/poem2969.html","الوافر"]],"verses":[["سَآخُذُها إِمّا اِستِلاباً وَفَلتَةً","وَإِمّا طِراداً في الوَغى وَقِتالا",0,"ل",2,0],["سَأَخطُبُها بِحَدِّ السَيفِ فِعلاً","إِذا لَم يُغنِ قَولٌ أَو خِطابُ",1,"ب",1,0],["سأخْبطُهُمْ بِداهِيَةٍ نَآدٍ","فليسَ لهمْ بنائِبَةٍ يَدانِ",2,"ن",1,0],["سَأَخرُجُ لِلبِرازِ خَلِيَّ بالٍ","بِقَلبٍ قُدَّ مِن زُبَرِ الحَديدِ",3,"د",1,0],["سَآخُذُ مِن سَراتِهِمُ بِعِرضي","وَلَيسوا بِالوَفاءِ وَلا المُداني",4,"ي",1,0],["سآخذ من قوليهما طرفيهما","وأشربها لا فارقَ الوازر الوزرُ",5,"ر",1,0],["ساخرةً منك ثم تحسبها","جاءت بحق إليك معتذره",6,"ر",2,0],["سَأُخلِي لِلظَّعينَةِ ما أَرادَت","وَلَستُ بِحارِسٍ لَكِ كُلَّ حينِ",7,"ن",1,0],["سَأَخبِطُ وَجهَ الدَهرِ وَاللَيلِ أَو أَرى","تَمَزُّقَ ثَوبِ اللَيلِ في وَضَحِ الفَجرِ",8,"ر",1,0],["ساخِطٌ نَبتَغي رِضاهُ وَلا يَس","أَلُ عَن سُخطِنا وَلا عَن رِضانا",9,"ن",2,0],["سأخفَظُ ما بيني وبينَك صائناً","عهودَكَ إنَّ الحُرَّ للعَهْدِ صائِنُ",10,"ن",1,0],["سَأَختِمُ أَبكارَ المَدائِحِ بِاِسمِكُم","كَما بِاِسمِكُم قِدَماً لَها أَنا فاتِحُ",11,"ح",1,0],["ساخراً من هدوئها مستعداً","لصراع الخطوب والأخطارِ",12,"ر",1,0],["سأخبرها من أنت إنك شاعر","قنوع إذا ما الخير جاء تفلسفا",13,"ف",2,0],["سَأَخرُقُ الخَرقَ بِاِبنِ خَرقاءَ كَال","هَيقِ إِذا ما اِستَحَمَّ في نَجَدِه",14,"د",2,0],["سأخلعُ ما حييتُ عذارَ رشدي","وألبسُ جامحاً عذرَ الفساد",15,"د",1,0],["سَأُخبِرُ فاخِرَ الأَعرابِ عَنّي","وَعَنهُ حينَ بارَزَ لِلفَخارِ",16,"ر",1,0],["سَأَخرُجُ بِالكَراهَةِ مِن زَماني","وَفي كَشحِيٍّ مِن يَدِهِ قِطاعُ",17,"ع",1,1],["سَأخفي لَهَا وُدِّى عَلَى رُغمٍ مِن قِلىً","فَسِيَّانِ عِندِى مَن قَلَى وَبَغَاني",18,"ي",1,0],["سآخذ ثأري من صروفِك عنوةً","أَقِدْني وإلا صَرْفُه سيُقيد",19,"د",1,0],["ساخِطٌ عَلى القَضاء","ثائِرٌ عَلى القَدَر",20,"ر",1,0],["سأخلعُ حلَّةً ألبَستِنِيها","فكانت مثلَ حلةِ ذي القروح",21,"ح",1,0],["سأخلصُ من أسرِ الغرامِ وقَيدِهِ","وألعنُ منهُ ما فقَدتُ وما معي",22,"ي",1,0],["سآخذُ قدَّكِ من عَطفِهِ","ولو قَدَّ صَدري حسامٌ صقيل",23,"ل",1,0],["ساخراً يطقعُ الحياة ويلقى","مضحِكات الأيام كالمُبكيات",24,"ت",1,0],["ساخر هازل امر مرورا","بحياة ألفاظها جوفاء",25,"ا",2,0],["سَأَخرُجُ مِن صَديقي مِن عِيانٍ","وَمِن سَمعٍ وَمِن نُطقٍ وَفِكرِ",26,"ر",1,0],["ساخرا بالدعي يحسب الاستقلال","يهوي إذا الهوى حذفه",27,"ف",2,0],["ساخطا أو ساخرا تث","أر في مقت فنونه",28,"ه",1,0],["سأخطو إليك الحادثاتِ ولو غدت","تلوح سيوفاً لم يرعني بريقُها",29,"ق",3,0],["سآخذ من نفسي لنفسك حقها","وأصفح أن لم ترع عهدي تكرما",30,"م",2,0],["ساخرة يبعد منها باطن","وإن دنت من سامع في الظاهر",31,"ر",1,0],["سأخلُقُ في الأسبوع شخصا سِوَاكُمُ","وشَخصِيةُ الإنسَان أَن يَتَشَخَّصَا",32,"ص",2,0],["سَاخِرُ القلب من قلو","ب لَدَيْه مُسَخَّره",33,"ر",2,0],["سأَخلعُ لا لَبِسْتُ له عِذَارِي","وأَقطعُ لا وَصلْتُ له القِلاَدَهْ",34,"د",2,0]]}