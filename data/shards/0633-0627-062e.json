{"poems":[[55,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[55,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[3,"ألا من مبلغ أهل الجحود","https://www.aldiwan.net/poem142.html",""],[4,"لست بغافر لبني بغيض","https://www.aldiwan.net/poem21208.html","الوافر"],[53,"أحل العراقي النبيذ وشربه","https://www.aldiwan.net/poem62906.html","الطويل"],[53,"أراحنا الله منك يا قذره","https://www.aldiwan.net/poem63010.html","البسيط"],[12,"إذا أصبحت بين جبال قوو","https://www.aldiwan.net/poem1227.html",""],[47,"لدن هجرته زحزحته عن الصبر","https://www.aldiwan.net/poem63642.html","الطويل"],[47,"ملنا أم نبا بنا أم جفانا","https://www.aldiwan.net/poem66784.html","الخفيف"],[63,"رأيتك تبري للصديق نوافذا","https://www.aldiwan.net/poem51420.html","الطويل"],[68,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[99,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[99,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[50,"وعاذلة تعيب علي عادي","https://www.aldiwan.net/poem66632.html","الوافر"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[48,"سأخرج بالكراهة من زماني","https://www.aldiwan.net/poem22946.html","الوافر"],[136,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[189,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[228,"ناقم على السماء","https://www.aldiwan.net/poem41593.html","مجزوء الرمل"],[275,"أبنت الروم في أعلى الصروح","https://www.aldiwan.net/poem35027.html","الوافر"],[275,"لك الويل يا قلبي فذب أو تصدع","https://www.aldiwan.net/poem35063.html","الطويل"],[275,"خمارك فيه لقلبي خمر","https://www.aldiwan.net/poem35423.html","المتقارب"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[347,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[458,"ها هو الشحاذ لصق البنك","https://www.aldiwan.net/poem61577.html","مجزوء الرمل"],[463,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[518,"إذا اشتد ما ألقاه هون علتي","https://www.aldiwan.net/poem67704.html","الطويل"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[543,"خليفة عيسى مع سليل محمد","https://www.aldiwan.net/poem47580.html","عموديه"],[580,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"],[580,"تعودت الهوى والخير عاده","https://www.aldiwan.net/poem2969.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48840","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202074","المتقارب"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82298","الرمل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[1583,"","https://poetry.dctabudhabi.ae/diwan/poem/142508","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101052","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26417","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202713","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202524","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204660","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199938","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204704","الطويل"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115112","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129466","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143836","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81269","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135125","الرجز"],[4675,"دفاع عن علامة الصومال عبد الكريم حسن حوش","https://www.poetsgate.com/ViewPoem.aspx?id=192203",""],[4699,"الموت الرحيم","https://www.poetsgate.com/ViewPoem.aspx?id=153916",""],[4733,"منادمةُ المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=211536",""],[4755,"حَنين","https://www.poetsgate.com/ViewPoem.aspx?id=184513",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4791,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=35918",""],[4859,"عصر الشياطين!","https://www.poetsgate.com/ViewPoem.aspx?id=191635",""],[4884,"فردوس بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=210403",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4908,"تائه في سفره","https://www.poetsgate.com/ViewPoem.aspx?id=207282",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[4955,"إذا ما كنت في يوم تعاني","https://www.poetsgate.com/ViewPoem.aspx?id=188748",""],[5024,"حمى طاهر شرق البلاد بيمنه","https://www.poetsgate.com/ViewPoem.aspx?id=99981",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5125,"عشق القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=188624",""],[5277,"سلال الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=185417",""],[5281,"مُلهمتي","https://www.poetsgate.com/ViewPoem.aspx?id=199304",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[223,"أمدُ من السماءِ الآنَ حرفا","https://www.poetsgate.com/ViewPoem.aspx?id=181159",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5411,"خيوط الأرجوان","https://www.poetsgate.com/ViewPoem.aspx?id=194063",""],[5431,"سأخبر ربي","https://www.poetsgate.com/ViewPoem.aspx?id=185607",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5628,"لا جديد","https://www.poetsgate.com/ViewPoem.aspx?id=178475",""],[5730,"رثاءٌ في أبناء الرياح","https://www.poetsgate.com/ViewPoem.aspx?id=210336",""],[5848,"فتنة الريم","https://www.poetsgate.com/ViewPoem.aspx?id=48955",""],[5964,"أجدك ما ينفك طيفك سارياً","https://www.poetsgate.com/ViewPoem.aspx?id=181301",""],[5975,"أنا في هذه الدنيا سجينُ","https://www.poetsgate.com/ViewPoem.aspx?id=53401",""],[6093,"لقد كانت ( مجزوء الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176004",""],[6125,"سأزهدُ في الحياةِ وأزدريها","https://www.poetsgate.com/ViewPoem.aspx?id=212870",""],[6336,"من بعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73556&r=&rc=17",""]],"verses":[["سَآخُذُها إِمّا اِستِلاباً وَفَلتَةً","وَإِمّا طِراداً في الوَغى وَقِتالا",0,"ل",2,0],["سَأَخطُبُها بِحَدِّ السَيفِ فِعلاً","إِذا لَم يُغنِ قَولٌ أَو خِطابُ",1,"ب",1,0],["سأخْبطُهُمْ بِداهِيَةٍ نَآدٍ","فليسَ لهمْ بنائِبَةٍ يَدانِ",2,"ن",1,0],["سَأَخرُجُ لِلبِرازِ خَلِيَّ بالٍ","بِقَلبٍ قُدَّ مِن زُبَرِ الحَديدِ",3,"د",1,0],["سَآخُذُ مِن سَراتِهِمُ بِعِرضي","وَلَيسوا بِالوَفاءِ وَلا المُداني",4,"ن",2,0],["سآخذ من قوليهما طرفيهما","وأشربها لا فارقَ الوازر الوزرُ",5,"ر",1,0],["ساخرةً منك ثم تحسبها","جاءت بحق إليك معتذره",6,"ر",2,0],["سَأُخلِي لِلظَّعينَةِ ما أَرادَت","وَلَستُ بِحارِسٍ لَكِ كُلَّ حينِ",7,"ن",1,0],["سَأَخبِطُ وَجهَ الدَهرِ وَاللَيلِ أَو أَرى","تَمَزُّقَ ثَوبِ اللَيلِ في وَضَحِ الفَجرِ",8,"ر",1,0],["ساخِطٌ نَبتَغي رِضاهُ وَلا يَس","أَلُ عَن سُخطِنا وَلا عَن رِضانا",9,"ن",2,0],["سأخفَظُ ما بيني وبينَك صائناً","عهودَكَ إنَّ الحُرَّ للعَهْدِ صائِنُ",10,"ن",1,0],["سَأَختِمُ أَبكارَ المَدائِحِ بِاِسمِكُم","كَما بِاِسمِكُم قِدَماً لَها أَنا فاتِحُ",11,"ح",1,0],["ساخراً من هدوئها مستعداً","لصراع الخطوب والأخطارِ",12,"ر",1,0],["سأخبرها من أنت إنك شاعر","قنوع إذا ما الخير جاء تفلسفا",13,"ف",2,0],["سَأَخرُقُ الخَرقَ بِاِبنِ خَرقاءَ كَال","هَيقِ إِذا ما اِستَحَمَّ في نَجَدِه",14,"د",2,0],["سأخلعُ ما حييتُ عذارَ رشدي","وألبسُ جامحاً عذرَ الفساد",15,"د",1,0],["سَأُخبِرُ فاخِرَ الأَعرابِ عَنّي","وَعَنهُ حينَ بارَزَ لِلفَخارِ",16,"ر",1,0],["سَأَخرُجُ بِالكَراهَةِ مِن زَماني","وَفي كَشحِيٍّ مِن يَدِهِ قِطاعُ",17,"ع",1,1],["سَأخفي لَهَا وُدِّى عَلَى رُغمٍ مِن قِلىً","فَسِيَّانِ عِندِى مَن قَلَى وَبَغَاني",18,"ن",2,0],["سآخذ ثأري من صروفِك عنوةً","أَقِدْني وإلا صَرْفُه سيُقيد",19,"د",1,0],["ساخِطٌ عَلى القَضاء","ثائِرٌ عَلى القَدَر",20,"ر",1,0],["سأخلعُ حلَّةً ألبَستِنِيها","فكانت مثلَ حلةِ ذي القروح",21,"ح",1,0],["سأخلصُ من أسرِ الغرامِ وقَيدِهِ","وألعنُ منهُ ما فقَدتُ وما معي",22,"ع",2,0],["سآخذُ قدَّكِ من عَطفِهِ","ولو قَدَّ صَدري حسامٌ صقيل",23,"ل",1,0],["ساخراً يطقعُ الحياة ويلقى","مضحِكات الأيام كالمُبكيات",24,"ت",1,0],["ساخر هازل امر مرورا","بحياة ألفاظها جوفاء",25,"ا",2,0],["سَأَخرُجُ مِن صَديقي مِن عِيانٍ","وَمِن سَمعٍ وَمِن نُطقٍ وَفِكرِ",26,"ر",1,0],["ساخرا بالدعي يحسب الاستقلال","يهوي إذا الهوى حذفه",27,"ف",2,0],["ساخطا أو ساخرا تث","أر في مقت فنونه",28,"ه",1,0],["سأخطو إليك الحادثاتِ ولو غدت","تلوح سيوفاً لم يرعني بريقُها",29,"ق",3,0],["سآخذ من نفسي لنفسك حقها","وأصفح أن لم ترع عهدي تكرما",30,"م",2,0],["ساخرة يبعد منها باطن","وإن دنت من سامع في الظاهر",31,"ر",1,0],["سأخلُقُ في الأسبوع شخصا سِوَاكُمُ","وشَخصِيةُ الإنسَان أَن يَتَشَخَّصَا",32,"ص",2,0],["سَاخِرُ القلب من قلو","ب لَدَيْه مُسَخَّره",33,"ر",2,0],["سأَخلعُ لا لَبِسْتُ له عِذَارِي","وأَقطعُ لا وَصلْتُ له القِلاَدَهْ",34,"د",2,0],["سأخرج من واديكم الرحب مرغماً","تراوحني ذكراكم وتباكرُ",35,"ر",1,0],["سآخذ في الذِّكر مِما عَناني","وأثْنى إلى طُولِ شُكرٍ عِنَانِي",36,"ن",2,0],["ساخِراً مِنكَ يُمَنّي","كَ أَمانِيَّ تَطولُ",37,"ل",1,0],["سَأَخزنُها عَنِ الأسمَاعِ حَتَّى","أَرُدَّ الصّمتَ بَينَهُما حِجَابا",38,"ب",2,0],["سأَخلق فجراً جديداً","إذا الفجر لم يطلعِ",39,"ع",1,0],["سأخضع يا أمي لقلبي ومدمعي","على رغم ما أسديت من نصحك الجم",40,"م",1,0],["سَأَخلَعُ ثَوبَ اللَهوِ بَعدَ أَحِبَّتي","وَأَرفُضُ طيبَ العَيشِ بَعدَهُمُ رَفضا",41,"ض",2,0],["ساخراتٌ أيامها من ظلومٍ","لم يفكر في يقظةِ الندمانِ",42,"ن",1,0],["ساخطا آنا على هذا الوجود","يائسا حينا وطورا منتظر",43,"ر",1,0],["سأخبركم إذا ما جدَّ شيءٌ","وإلا نبْقَ في ظنٍّ وحدس",44,"س",1,0],["سأخلق تابعاً في الخلق ربي","وخلِّ الخلق تفعل ما تشاء",45,"ا",2,0],["ساخطا حين يلمح النور فيها","هائجا حين يسمع الأوتارا",46,"ر",2,0],["سأخصر القول لدى وصفها","ان جاء من يسأل عن سرها",47,"ر",3,0],["سأخلد في شعري الولود فإنما","دواوين أشعاري تولد أشعارا",48,"ر",2,0],["سأختارُ من حُرِّ الكلام قصيدةً","لِفتحِ بن خاقانٍ تفوقُ القصائدا",49,"د",2,1],["ساخطٌ انْ حفِظتُ مجدَ مَوالي","هِ وَحَرَّمتُ منهم ما أَحَلاّ",50,"ل",2,0],["سأخفي الحب في قلبي ولكن","اذا ما انهل دمعي فاعذريني",51,"ن",2,0],["سأٌخبركم يا عُصبةَ الخير بالذي","جرى بقضاء اللهِ والله حاكمُ",52,"م",1,0],["سأخدمه عمري ويخدم بابه","إذا متُّ عني خادمٌ بعد خادم",53,"م",1,0],["ساخِطاً يَلعَن السَماء وَما في الأَ","رض مِن عالم وَمِن أَشباح",54,"ح",1,0],["سأختم النظم بخير في الملا","فالحمد لله مصليا على",55,"ل",2,0],["سأخرج وجدي من فؤادي وأرسل","وأعلنه بين الأنام وأبذل",56,"ل",1,1],["سأختار بُعْدَكَ حتى وإن عاش قلبي بعد هواك يتيما","فقربك موت وبُعْدُكَ موتٌ ولكنني اخترتُ موتا رحيما",57,"م",2,0],["سأُخفِي صُورتي عَمَّن وَعاها","وأُبدِي غَيرَها عندَ المعَابِر",58,"ر",1,0],["سَأختِمُ بالحَنِينِ وأَستَهِلُّ","وأُقسِمُ بالفُؤادِ.. وأنتَ حِلُّ",59,"ل",1,1],["ساخرا من سواه بالفعل ظنا","أنه كان ذات يوم ذكيا",60,"ي",2,0],["ساخن الدمع في عين الملامة يفوح","الشره في زماني يطّرد لي سراب",61,"ب",1,0],["سأخبرُ اللهَ عمّنْ كنتُ أحسبهمْ","مأوى البراءةِ في عصرِ الشياطينِ",62,"ن",1,1],["سأختارِ من درِّ البيانِ فرائداً","وثغرُ زماني قد شدا وتلاها",63,"ا",3,0],["سأخطو على ثقةٍ وإذا","شككتُ تقولُ المقاديرُ ثِقْ",64,"ق",1,0],["سأخوضُ في بحرِ الغرام مجازفاً","فلأجلكم يُستعذَب التجديفُ",65,"ف",1,0],["ساخ للرُّكبتين منه جوادٌ","ومن الرُّعب ترعد الأحشاء",66,"ا",2,0],["سأخبركَ النتيجةَ دونَ ريبٍ","ألا فاشهدْ على ذا يازماني",67,"ن",2,0],["سأخبر منى مدحة عربية","لذيذ بأفواه الرواة نشيدها",68,"د",3,0],["سأخلعُ نعلي وأمشي رفيقاً","على أرضها إذ يحينُ اللقاءْ",69,"ا",2,1],["سأختصر