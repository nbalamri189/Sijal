{"poems":[[46,"وقائلة حج عبد العزيز","https://www.aldiwan.net/poem30342.html","المتقارب"],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[445,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[466,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62481","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""]],"verses":[["وَآبَ مُعَرّىً مِنَ السَيِّئا","تِ يَرفُلُ في الحَسَناتِ الجِسامِ",0,"م",1,0],["وآبَ ماضِي شَبابي وانْثَنَتْ جِدَتي","وَثَابَ يَنْعُمُ في نَعْمَائِك البالُ",1,"ل",1,0],["وآبَ مَنصورُ قَحطانٍ بعزَّتِهِ","أَوْباً تَذُوبُ مُلُوكُ الأَرْضِ من حَسَدِهْ",2,"د",2,0],["وآبَ منَ البيتِ الحَرامِ وأجْرُهُ","كَجدْوى يديْهِ واصِبٌ غيرُ زائلِ",3,"ل",1,0],["وَآب مظفّراً وَأَبو عليٍّ","أَخوه أَتى وَقَد حَمَدوا الإِيابا",4,"ب",2,0],["وآب منها إلى بركا وحسرتها","لمَّا مضى حَرُّها في صدرها لفحا",5,"ح",2,0],["وآب مآب الفائز المنى","وقد شملته بهجةٌ وحبور",6,"ر",1,0],["وأب مربّ كل جيل صاعد","من بعض سادته جمال الدين",7,"ن",1,0]]}