{"poems":[[108,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[463,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[463,"أنا اليوم مما تعهدين بعيد","https://www.aldiwan.net/poem56239.html","البسيط"],[482,"عفا منزل قد كان للغيد مألفا","https://www.aldiwan.net/poem15244.html","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64538","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132264","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[404,"اعتزالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191816",""],[5732,"الجادل اللي","https://www.poetsgate.com/ViewPoem.aspx?id=177913",""]],"verses":[["متى ضمِنْتَ رضاءَ الله عنك، فلا","تُبَالِ بعد رضاءِ الله مَن غَضِبا",0,"ب",2,0],["متى ضحكت لي من سمائك برقةٌ","حكت لك أرضي كيف تزكو الصنائعُ",1,"ع",1,0],["متى ضنَّتِ الدنيا عليّ فأبصرت","لسانِيَ فيها بالسؤالِ يجودُ",2,"د",1,0],["متى ضلَّ أهلُ النظمِ عنها فاِنَّني","أجوبُ قوافيها الصَّعابَ تَعَسُّفا",3,"ف",2,0],["متى ضربت صياصيهم أفاضت","بصمعهم الشداد سحاب تعسِ",4,"س",1,0],["متى ضايقتني شدة لم تكن لها","بطولك يا ذا الطول حتى تجلت",5,"ت",1,0],["متى ضيّعت قلبي أميمة ضائعا","وما عوّضتنيه سوى حقف ضائع",6,"ع",1,0],["متى ضحكتْ يوماً تريكَ مودَّةً","فتبكيكَ فيما تبتليكَ بهِ شَهْرا",7,"ر",2,0],["متي ضمَّ البريدُ مُعلَّقاتي","فقد ملَّ التشبُّبَ بالكواعبْ",8,"ب",1,0],["متى ضعنهم يتفق مع ضعنا","ومتى فوادي ينتعش عقب ما اوذيت",9,"ت",1,0]]}