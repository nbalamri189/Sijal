5393,"إن الذيول صناعة غربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85459&r=&rc=26",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""],[6308,"صوتٌ من الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87726&r=&rc=4",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""],[6323,"قتامة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82176&r=&rc=7",""]],"verses":[["الحَربُ أَروَحُ لِلنُفو","سِ مِنَ الحِيادِ الكاذِبِ",0,"ب",1,0],["الحُرّ من خرق العادات مُنْتَهِجاً","نهج الصواب ولو ضدّ الجماعات",1,"ت",1,0],["الحُرُّ يَصبِرُ ما أَطاقَ تَصَبُّراً","في كُلِّ آوِنَةٍ وَكُلِّ زَمانِ",2,"ن",1,1],["الحرُّ يضربُهُ والعبدُ يضربُهُ","إن الشقاءَ على الأشقَيْن مصبوبُ",3,"ب",1,0],["الحَربُ مَجلَبَةُ الشَقاوَةِ لِلوَرى","وَالحَربُ يَعشَقُه بَنو الإِنسانِ",4,"ن",1,0],["الحر فعال فما","هو من يماري او يمارى",5,"ر",2,0],["الحر يكفيه اللوا","والعبد يقرع بالجريدة",6,"ه",1,0],["الحرب لا بدّ منها","وإن أباها الأنام",7,"م",1,1],["الحَريرُ مَلبَسُها","وَاللُجَينُ وَالذَهَبُ",8,"ب",1,0],["الحربُ تعلمُ أنكم آسادُها","والأرضُ تعلمُ أنكم أمطارُها",9,"ر",3,0],["الحِرصُ لُؤمٌ وَمِثلُهُ الطَمَعُ","ما اِجتَمَعَ الحِرصُ قَطُّ وَالوَرَعُ",10,"ع",1,1],["الحرص يوقظه والمجد يوقظه","والويل إن وثب الوسنان يقظانا",11,"ن",2,0],["الحربُ سُوقٌ والنُّفوسُ تجارةٌ","بِئْسَ التِجارُ همو وبئسَ المتجرُ",12,"ر",1,0],["الحربُ يَقْظَى والجنودُ بَواسِلٌ","فَمَتَى يُفيقُ القائدُ الوَسنانُ",13,"ن",1,0],["الحربُ تَقصِفُ في البلادِ رُعودها","والشّعبُ تَقصِمُ صُلْبَهُ النَّكَباتُ",14,"ت",1,0],["الحربُ عِنْدَ بَني عُثمانَ مُعجزةٌ","تُعْيي العُقولَ وتُلغِي كلَّ تدبيرِ",15,"ر",1,0],["الحَربُ هادِمَةُ الشُعوبِ وَإِنَّها","لِلشَرِّ بَينَ العالَمينَ لِقاحُ",16,"ح",1,0],["الحَربُ دائِرَةٌ وَجَيشكِ قائِمٌ","يَنضي السُيوفَ وَيَرفَعُ الأَعلاما",17,"م",2,0],["الحربُ تُوضَع بيننا أوزارُها","وَتَعودُ إن جَمعَ الحجيجَ الموسمُ",18,"م",1,0],["الحُرُّ يوصى وَالعَصا لِلعَبدِ","وَلَيسَ لِلمُحلِفِ مِثلُ الرَدِّ",19,"د",1,0],["الحرب للمتهوسي","نَ هيَ الطَريق الأوعر",20,"ر",1,0],["الحرب ذنب الاجتما","عِ وإنه لا يغفر",20,"ر",1,0],["الحرب لَولا أن تمس","سَ ضرورة لا تشهر",20,"ر",1,0],["الحر لا يَخشى إذا","قال الحَقيقة من ملام",21,"م",1,0],["أَلحَريق حين بدا","محدقاً بهم جلبوا",22,"ب",3,0],["الحرب بعد اليوم حرب سياسة","وَالغالِبون بها هم الأحرار",23,"ر",1,0],["الحرب أَول ما تثور عجاجة","وَالنار أَول ما تشب دخان",24,"ن",1,0],["الحَربُ في حَقٍّ لَدَيكَ شَريعَةٌ","وَمِنَ السُمومِ الناقِعاتِ دَواءُ",25,"ا",2,0],["أَلْحُرَّةُ المُنْجِبَةُ الأُمُّ الَّتِي","بِالْمَالِ تُشْرَى وَالْقُلُوبِ تُفْدَى",26,"د",2,0],["الحرب قد لقح البريةَ حرُّها","فأظلَّها واديك من لفَحاته",27,"ت",2,0],["الحرب إن مسَّتْ سواه، فإنها","عضَّتَ بأنياب عليه حِداد",28,"د",1,0],["الحربُ حولَ الشرق شبَّ أُوارها","والشرقُ يرقبُ، من يقُذهُ ينقد",29,"د",1,0],["الحرصُ داءٌ قَد أَضَرَّبِمَن","تَرى إِلّا قَليلا",30,"ل",2,1],["الحرفُ يَحسو قَيئَهُ في فَمِي","والصمتُ أقسى من حسابِ الذُّنوب",31,"ب",1,0],["الحرب مجلبة الشّقاوة للورى","والحرب يعشقها بنو الإنسان",32,"ن",1,0],["الحرفُ في قلبي نزيفٌ دائمٌ","والحرفُ عندكِ.. ما تعدّى الإصبعا.",33,"ع",2,0],["الحَرْفُ يبدأُ من عَيْنَيْكِ رحْلتَهُ","كلُّ اللُغاتِ بلا عينيكِ .. تَنْدثِرُ",34,"ر",1,0],["الحرّ يؤسر والحمائم حرّة","يا ليت لي في الشام حظّ حمامها",35,"م",3,0],["الحرميُّ الزمزميُّ اليثربي","وَهو الحجازيُّ التهاميُّ النبي",36,"ي",1,0],["الحر في مصر تشقيه مواهبه","ربح المفكر فيها ألف خسراني",37,"ن",2,0],["الحُرُّ لا يأتي الدنِيّهْ","والمجدُ للنّفسِ الأبيّهْ",38,"ي",2,1],["الحربُ أحلى إذا ما خفتَ نائرةً","من المقام على ذُلٍ وتصغير",39,"ر",1,0],["الحرُّ يأنَفُ من عُبودةِ غَيرهِ","ويُنيله من حظِّهِ كَشرِيك",40,"ك",1,0],["الحِرصُ عَونٌ لِلزَمانِ عَلى الفَتى","وَالصَبرُ نِعمَ العَونُ لِلأَزمانِ",41,"ن",1,1],["الحُرُّ من عَمَّ الأنامَ سَماحةً","كَرماً وخَصَّ أُولي النُّهَى بخَصائص",42,"ص",1,0],["الحربُ أوّلٌ ما تكونُ فُتيَّةً","تسعى بزينتها لكلِّ جَهولِ",43,"ل",1,1],["الحر يرضى بحمل الصخر من جبل","عال وفي جيده حَبْلٌ من المسد",44,"د",1,0],["الحُرُّ في التَّحقيقِ مُعتِقُ ذاتِهِ","من رِقِّ شَهوتِهِ ومن غَفلاتِهِ",45,"ت",2,1],["الحرب إن باشرتها","يوماً فدع عنك الوجل",46,"ل",1,1],["الحرُّ والصفيُّ هذا قسمُ","وأحسن الشكلين حرٌّ يسمو",47,"و",1,0],["الحَرْبُ بَيْنَ عُهُودِهِ وَوَفَائِهِ","كَالسِّلْمِ بَيْنَ وُعُودِهِ وَمُطَالِهِ",48,"ل",2,0],["الحر من لم يتخذها سلماً","يرقي به للفوز في مرامه",49,"م",2,0],["الحر من قد صانها في زمن","يكثر فيه الطعن من طغامه",49,"م",2,0],["الحر من لا يقبل الظلم ولا","يركب متن الجور في أحكامه",49,"م",2,0],["الحر من ساوى وواسى وسعى","في خدمة الشعب وفي اكرامه",49,"م",2,0],["الحر من يصدر في مقاله","ويتقي البهتان في كلامه",49,"م",2,0],["الحر من يجد في نيل العلى","حتى يقود العز من زمامه",49,"م",2,0],["الحرب توسع من يصلى بها حرباً","يُتم البنين وإثكال المثاكيل",50,"ل",1,0],["الحرب في البلقان أهونُ مفزعاً","من موقفي يوم الوداع بعيدا",51,"د",2,0],["الحرم المطمئن طائفه","ومن ستسعى لركنه الدول",52,"ل",1,0],["الحر قنّاص الحباري يلي طار","كيف الحبارى تقنص الحر تالي",53,"ل",2,0],["الحركات لولا خفةٌ","في قدِهّ والرِدّف ملء وقار",54,"ر",1,0],["الحَرُّ يَدنُسُ بَينَ الحِرصِ وَالطَلَب","فَاِخلَع لِباسَهُم بِالعِلمِ وَالأَدَب",55,"ب",1,1],["الحر حر في الشعوب جميعها","من هجرة قد كان أو ميلاد",56,"د",1,0],["الحرة العَفيفه","البرزة الحَصيفه",57,"ه",1,0],["الحُر عَبد إِن طَمع","وَالعَبد حُر إِن قَنع",58,"ع",1,0],["الحرص لَوم وَصلف","الزهد عز وشرف",59,"ف",1,0],["الحرفُ يشرقُ زهوة","لو مسّ حرفك بعض حسني",60,"ن",2,0],["الحرف ركن بالبنا قد اتّصف","ولقّبوه الحرف إذ كان الطرف",61,"ف",1,0],["الحرُّ فيه وإن أَبرَّ مؤخَّرٌ","والعبدُ مرفوعُ المقامِ مُقدَّم",62,"م",1,0],["الحربُ قد شُهرتْ يا قومُ فامتشقوا","سيفَ الدفاعِ عن الأوطانِ والحرم",63,"م",1,0],["الحرُّ يرزأ إلاَّ فضل شيمته","وإن تقلَّب بين البؤسِ والنكد",64,"د",1,0],["الحُرُّ نَفسُهُ مِن نارٍ وَما رَضيَت","إِلّا اِرتِفاعاً وَإِن تُسجَن بِتَقييدِ",65,"د",1,0],["الحرب والمحراب يعرف فضله","وتعاقب الإصباح والإمساء",66,"ا",2,0],["الحرّ من ظاهر المظلوم مضطرباً","وجداً ومدّ يد الإسعاف مختارا",67,"ر",2,0],["الحرّ من قال قولاً ثمّ يعمله","لا من تراه قليل الخير ثرثارا",67,"ر",2,0],["الحرّ من ذاد عن أوطانه وله","قلبٌ تلامس فيه 