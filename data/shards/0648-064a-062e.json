{"poems":[[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[63,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[63,"إذا استلب النوم العنان من اليد","https://www.aldiwan.net/poem46176.html","الطويل"],[63,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[63,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[77,"أنا إلى الله وإنا له","https://www.aldiwan.net/poem36021.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"عرصات دارك للضياف مبارك","https://www.aldiwan.net/poem36384.html","الكامل"],[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[86,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[0,"لمن طلل أبصرته فشجاني","https://www.aldiwan.net/poem57.html","الطويل"],[35,"أمن طلل أقوى من الحي ماثله","https://www.aldiwan.net/poem39102.html","الطويل"],[93,"يا أمتي تنكري نصح امريء","https://www.aldiwan.net/poem11288.html","الكامل"],[54,"أفيقي من ملامك يا ظعينا","https://www.aldiwan.net/poem27460.html","الوافر"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[88,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[51,"ما علمنا من لؤلؤ ما ذكرتا","https://www.aldiwan.net/poem8703.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"ما ضر مدحا في جواد","https://www.aldiwan.net/poem61865.html","مجزوء الكامل"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[91,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[91,"يا من قربت من الفؤاد","https://www.aldiwan.net/poem8819.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[70,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[92,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[89,"الشمس قد غربت فلاح وراءها","https://www.aldiwan.net/poem44892.html","الكامل"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[43,"أنا لائمي إن كنت وقت اللوائم","https://www.aldiwan.net/poem10544.html","الطويل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[45,"عمرت أبا إسحاق ما صلح العمر","https://www.aldiwan.net/poem63637.html","الطويل"],[45,"قم تأمل بنا عجائب دهر","https://www.aldiwan.net/poem65226.html","الخفيف"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[61,"غذيت به طفلا وإن رمت تركه","https://www.aldiwan.net/poem51306.html","السريع"],[61,"على الرغم بدلت من رغم لاحي","https://www.aldiwan.net/poem51742.html","المتقارب"],[66,"قدمت وقد لاح الهلال مبشرا","https://www.aldiwan.net/poem40974.html","الطويل"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[97,"أفدي نهارا طلعت فيه","https://www.aldiwan.net/poem24871.html","مجزوء البسيط"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[80,"ومضمن راحا يشف زجاجه","https://www.aldiwan.net/poem31496.html","الكامل"],[74,"وخيرية بين النسيم وبينها","https://www.aldiwan.net/poem12842.html","الطويل"],[21,"حنانيك إن الجن كنت رجاءهم","https://www.aldiwan.net/poem36135.html","الطويل"],[40,"لمن طلل بالنعف نعف وقير","https://www.aldiwan.net/poem42313.html","الطويل"],[40,"طال عن آل زينب الإعراض بي","https://www.aldiwan.net/poem42318.html","الخفيف"],[52,"قطعته يوما وليس يطيعه","https://www.aldiwan.net/poem26842.html","الكامل"],[52,"صبوت إلى الندامى والعقار","https://www.aldiwan.net/poem26994.html","الوافر"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[48,"رغيف سعيد عنده عدل نفسه","https://www.aldiwan.net/poem62435.html","السريع"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"إذا خطب الزهراء كهل وناشئ","https://www.aldiwan.net/poem22932.html","الطويل"],[46,"خير لآدم والخلق الذي خرجوا","https://www.aldiwan.net/poem23019.html","البسيط"],[46,"يضحي الفتى المرؤوس بالسيد ال","https://www.aldiwan.net/poem23415.html","السريع"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202876","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1914","الطويل"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"ثنى الصعدة السمراء من لين قده","https://www.poetsgate.com/ViewPoem.aspx?id=33801",""],[77,"أيغلبُ من عاداك والله غالبُه","https://www.poetsgate.com/ViewPoem.aspx?id=33204",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[99,"بالأحمرِ فقَط","https://www.poetsgate.com/ViewPoem.aspx?id=16902",""],[51,"ما ضرَّ مدحاً في جواد","https://www.poetsgate.com/ViewPoem.aspx?id=27813",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[86,"أَيُّها المُصْلِحُونَ ضاقَ بنا العَيْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13095&r=&rc=50",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""],[43,"فديناك من ربع وإن زدتنا كربا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5442&r=&rc=13",""]],"verses":[["وَيَخرُجُ مِنها بِالكَرائِمِ حادِثٌ","وَيَدخُلُها صَرفُ الرَدى بِالبَوائِقِ",0,"ق",1,0],["وَيَخشى القَطا الكُدْرِيُّ فيها ضَلالَهُ","وَيَشكو لَظاها في أَداحيِّها الرُّبْدُ",1,"د",1,0],["ويخْجَلُ منْ راحَتَيْهِ الغَمامُ","إذا دَرَّ نائِلُهُ الصَّيِّبُ",2,"ب",1,0],["ويَخْدِشُ غِمدي بالحِمي صَفحةَ الثّرى","إذا جرَّ مِن أذْيالِهِ المُتحضِّرُ",3,"ر",1,0],["ويَخْضَعُ في كَعبٍ لغَيرانَ يحْتَمي","بِجارٍ خُزَيْميِّ الإباءِ سَوامُهُ",4,"م",2,0],["ويَخْلُفُ أنواءَ الرّبيعِ إذا كسا","سَنامَ الحمى بُرْدَيْ عَديمٍ نُضوبُها",5,"ب",3,0],["ويَخْفُقُ أنّى سارَ أو حَلَّ فَوقَهُ","حَواشي ثَناءٍ أو ذَوائِبُ سُؤْدَدِ",6,"د",1,0],["ويخوضُ مُشْتَجَرَ الرِّماحِ بغِلْمَةٍ","عرَبيّةٍ نَخَواتُها أغْمارِ",7,"ر",1,0],["ويَخْبُرُ أهواءَ النّفوسِ بنَظْرَةٍ","تَفُضُّ لها الأسرارُ كلَّ خِتامِ",8,"م",1,0],["ويخْتالُ في ظِلِّهِ المُعْتَفونَ","وتندىً على زائِريهِ رُباهْ",9,"ا",2,0],["ويُخْجِلنَ بالأغصانِ أغصانَ بانَةٍ","وتَهزَأُ بالكُثبانِ منهُنَّ كُثبانُ",10,"ن",1,0],["ويُخلِّفُ المُتَطَلِّعينَ إِلى المَدى","في الفَخْرِ مُنْجَذِبُ العِنانِ سَبوقُ",11,"ق",1,0],["وَيَخْزُنُ الفَلْسَ لِوَارِثِهِ","مُسْتَنْفِداً مَبْلَغَ أَكْوَانِهِ",12,"ن",2,0],["وَيُخْجِلُ سُحْبَ الْغَيْثِ فَالْبَرْقَ خَجْلَةً","إِذَا مَا هَمَى فِي كَفِّهِ وَابِلٌ سَجْمٌ",13,"م",1,0],["وَيَخُصُّ مَجْدَكَ مِنْ سَلاَمِي عَاطِرٌ","كَالْمِسْكَ صَاكَ بِهِ الْغَوَالِي صَائِكُ",14,"ك",1,0],["وَيُخبِرُكُم حُمرانُ أَنَّ بَناتِنا","سَيُهزَلنَ إِن لَم يَرفَعِ العيرَ ميلُها",15,"ل",3,0],["وَيَخافانِ عامِراً عامِرَ الخُض","رِ وَكانَ الذِنابُ مِنهُ مَصيرا",16,"ر",2,0],["وَيَخالُ الرَغيفَ في البُعدِ بَدراً","وَيَظُنُّ اللُحومَ صَيداً حَراما",17,"م",2,0],["وَيَخشى رَبَّهُ وَيُطيعُ مَولىً","هَداهُ إِلى الصِراطِ المُستَقيمِ",18,"م",1,0],["وَيَخطو عَلى صُمٍّ صِلابٍ كَأَنَّه","حِجارَةُ غيلٍ وارِساتٌ بِطُحلُبِ",19,"ب",1,0],["وَيَخضِدُ في الآرِيِّ حَتّى كَأَنَّم","بِهِ غِرَّةٌ مِن طائِفٍ غَيرِ مُعقِبِ",19,"ب",1,0],["وَيَخدي عَلى صُمٍّ صِلابٍ مَلاطِسٍ","شَديداتِ عَقدٍ لَيِّناتِ مَتانِ",20,"ن",1,0],["وَيُخفي لَكُم حُبّاً شَديداً وَرَهبَةً","وَلِلناسِ أَشغالٌ وَحُبُّكِ شاغِلُه",21,"ل",2,0],["وَيَخَافُ عَاقِبَةَ الصَّغَارِ وَقَوْمُهُ","بَاؤُوا بِهِ فِي المَأْزِقِ المُتَلاحِمِ",22,"م",1,0],["وَيُخزِهِمُ وَيَنصُركُم عَلَيهِم","وَيَشفِ صُدورَ قَومٍ مُؤمِنينا",23,"ن",2,0],["ويَختَص بالتبجيل من جاء مُنشداً","ويُقذَف بالتَجْهيل من جاء فاكرا",24,"ر",2,0],["ويخلفها البدر المنير حفيدها","وعنها إذا جنّ الظلام ينوب",25,"ب",1,0],["ويخطر في وشي الحرير قوامها","ونجم الدجى بالغيظ يعثر في منح",26,"ح",1,0],["ويخدعه مثلي فيخدع للندى","سريعاً ولا والله ما هو بالغمر",27,"ر",1,0],["ويَخالُ النديمُ أنّك تفسو","إن تنفستَ نحوه أو نَكَهتَا",28,"ت",2,0],["ويخاف الإِنفاد ممتدحوه","ولديه الأمانُ من إنفادِهْ",29,"د",2,0],["ويخافه القوم البُرا","ء وما أخاف وما تهدَّدْ",30,"د",1,0],["وَيَخالُ حاجَتَهُ الَّتي يَصبو لَها","في دارَةِ الجَوزاءِ أَو في الفَرقَدِ",31,"د",1,0],["وَيَخشى الهَزارُ عَلى وَكنَتِه","فَيَدفَعُ عَنها بِمِنقارِهِ",32,"ه",1,0],["وَيَخافُ مِن أَضيافِهِ","خَوفَ الصَغيرِ مِنَ اليَهود",33,"د",1,0],["وَيَخوضُ في وَحلِ الشِتا","مُتَهَلِّلاً مُتَيَمِّنا",34,"ن",2,0],["وَيَخفِقُ حينَ يُبصِرُهُ فُؤادي","وَلا عَجَبٌ إِذا رَقَصَ الطَروبُ",35,"ب",1,0],["ويَخالُ الوَرْدَ يداعِبُهُ","فرحاً فتعابثه يَدُهُ",36,"د",2,0],["ويخوضُ أَحشاءَ الوُجُود مُغامِراً","في ليلها المتهيِّبِ المحذورِ",37,"ر",1,0],["ويخال مبصره اذا لم ينتبه","ان الذي يرنو اليه حريق",38,"ق",1,0],["وَيَختَلِفُ الدَهرُ حَتّى يَبينَ","رُعاةُ العُهودِ وَخُوّانُها",39,"ن",3,0],["وَيُخشى عُبابُ البَحرِ وَهوَ مَكانَهُ","فَكَيفَ بِمَن يَغشى البِلادَ إِذا عَبّا",40,"ب",2,0],["وَيَختَلِفُ الرِزقانِ وَالفِعلُ واحِدٌ","إِلى أَن يُرى إِحسانُ هَذا لِذا ذَنبا",40,"ب",2,0],["وَيَخفى عَلَيكَ البَرقُ وَالرَعدُ فَوقَهُ","مِنَ اللَمعِ في حافاتِهِ وَالهَماهِمِ",41,"م",1,0],["وَيُخشى شَذاهُ وَهوَ غَيرُ مُسَلَّطٍ","وَقَد يُتَوَقّى السَيفُ وَالسَيفُ في الغِمدِ",42,"د",1,0],["وَيَخرُقُ بِالتَبذيرِ وَهوَ مُجَرِّبٌ","فَلا يَتَمارى القَومُ في أَنَّهُ غُمرُ",43,"ر",1,0],["وَيَخِسُّ النَصيبُ حَتّى يَقِلَّ ال","حَظُّ فيهِ وَيَكثُرُ الأَشراكُ",44,"ك",1,0],["وَيَخُصُّ أَرضاً دونَ أَرضِ جَودِهِ","وَسَحابُ جودِكَ في العُفاةِ عُموما",45,"م",2,0],["ويخدمهم قلبي وسري ومنطقي","فأبلغ أقصى غاية القرب في بعدي",46,"ي",1,0],["ويخطِرُ في هَبْوَتَيْهِ الكَميُّ","بقَلْبٍ جرئء ووجهٍ وَقاحِ",47,"ح",1,0],["وَيُخبِرُ أَنَّ النَصرَ فيهِ مُقَدَّرٌ","أَلَم تَرَهُ قَد لاحَ في الغَربِ نونُهُ",48,"ه",1,0],["وَيُخصِبَ رَبعُ الأُنسِ مِن بَعدِ مَحلِهِ","وَيورِقَ مِن دَوحِ التَواصُلِ عودُ",49,"د",1,0],["ويخلق الله معجزاتٍ","يجمعها كلَّها بفرد",50,"د",1,0],["ويَختَطُّ بالخطِّيِّ أرضَ كريهةٍ","يجرّرُ فيها ذيلَ جحْفَله المَجْرِ",51,"ر",1,0],["ويَخِفُّ مَلآناً ويثقُلُ فارغاً","كالجسم تُعدَمُ روحُهُ أو تُوجَدُ",52,"د",1,0],["وَيَخفى مَعَ الإِصباحِ حَتّى كَأَنَّما","يَظَلُّ عَلَيهِ لِلصَباحِ رَقيبُ",53,"ب",1,0],["وَيُخرِجُ مِنهُ حَبَهُ في رُؤَوسِهِ","وَفي ذاكَ آياتٌ لِمَن كانَ واعِيا",54,"ي",2,0],["وَيُخفى بِها وَجداً شَديداً وَقَلبُهُ","إِلَيها كَمَشدُودِ الوِثاقِ أَسِيرِ",55,"ر",1,0],["وَيُخَبَّر بِما تَضَمَّنَ مِنّا","إِذ خَلا اليَومَ لِلمَسيرِ المَراضُ",56,"ض",1,0],["وَيَخافُ شَيطانُ النِفاقِ مَواقِفي","وَإِذا رَآني حاضِراً لَم يَنزَغِ",57,"غ",1,0],["وَيَخجَلُ إِذ يُلاقيني كَأَنّي","أُنَقِّطُ خَدَّهُ بِالجُلَّنارِ",58,"ر",1,0],["ويَخْضِبُ سَيْفَهُ بِدَمِ النَّواصي","مَخَافَةَ أنْ يُقالَ به مَشِيبُ",59,"ب",1,0],["ويخشى الفتى من بأسه قبل باسه","وقد تتقى قبل العضاض الأراقم",60,"م",1,0],["ويخطو على صمّ خفاف وقوعها","ثقيلٌ يُردّ الصخرَ وهو فليق",61,"ق",1,0],["وَيُخرِجُهُ مِن كِمِّهِ فَيَشِمَّهُ","وَيُجلِسَهُ في حِجرِهِ وَيُخاطِبُه",62,"ب",2,0],["وَيَخمِطُ الشاؤونَ مِن خَمّاطِهِ","وَيَطبُخُ الطابِخُ مِن أَسقاطِهِ",63,"ط",2,0],["وَيُخالِفُ الأَيّامَ حُكمٌ واقِعٌ","فيها وَمِثلُ سُبوتِها جُمُعاتُها",64,"ت",3,0],["وَيُخفَضُ في كُلِّ المَواطِنِ ذَمُّهُ","وَإِن كانَ يُدنى في المَحَلِّ وَيُرفَعُ",65,"ع",1,0],["وَيُخلِفُ الظَنُّ في الأَشياءِ صاحِبَهُ","وَالغَيمُ يَكدي وَداعي البَرقِ يَأتَلِقُ",66,"ق",1,0],["وَيُخمَصُ الإِنسانُ مِن نَخوَةٍ","ساكِنَةٍ في أَنفِهِ الوارِمِ",67,"م",1,0],["ويُخالُ موسى جَدُّكُمْ لجلالِهِ","في النّفْس صاحبَ سورةِ الأعرافِ",68,"ف",1,0],["وَيخبرُ عَنّي ما أَقُولُ إِبنَ عامرٍ","وَنِعمَ الفَتَى يأََوي إِِليهِ المُعَصَّبُ",69,"ب",1,0],["ويخصِفُ نعليهِ وطوعُ يمينهِ","مصايرُ هذا العالمِ المترغِّدِ",70,"د",1,0],["ويخفُّ قلبي إثرَ كلِّ شعاعةٍ","في الليلِ تومض عن شهابٍ غائرِ",71,"ر",1,0],["ويخفق صدرانا خفوقا ً كأنما","مع القلبِ قلبٌ في الجوانح ثاني",72,"ن",2,0],["ويخطب الكهان في المواسم","سجع الحمام في الرّبا النواسم",73,"م",1,0],["ويخاف بادرة اللسان تخونه","فإذا تناوله الحديث يُجمجم",74,"م",1,0],["وَيَخفِضُ لي هُناكَ جَناحَ عِزٍّ","عَهدتُ لَهُ مِنَ الرَحِمِ اِنخِفاضا",75,"ض",2,0],["وَيَخطو عَلى صُمٍّ صِلابٍ كَأَنَّها","حِجارَةُ غيلٍ وارِساتٌ بِطُحلُبِ",76,"ب",1,0],["وَيَخضِدُ في الآرِيِّ حَتّى كَأَنَّما","بِهِ غِرَّةٌ مِن طائِفٍ غَيرِ مُعقِبِ",76,"ب",1,0],["وَيَخْلصُ مَنْ رَاحَتَيْكَ زمَامُهُ","فَسَيْبُكَ كَاسِيهِ وَسَيْفُكَ سَالِبُهُ",77,"ب",2,0],["ويخدَعُه طَيْفُ الخيالِ إذا سَرى","فيبعَثُ آمالَ الشجيّ ويذهَبُ",78,"ب",1,0],["ويخفُقُ خفقًا بحبِّ السلام","كما يخفقُ الطيرُ فوقَ الشَّجرَ",79,"ر",1,0],["ويخفضُ للضعفاء الجناحَ","ويعصفُ كالريح بالأقوياء",80,"ا",2,0],["ويختلف الرجال كما أرادوا","فإن أومأت أنت، فلا جدال",81,"ل",1,0],["ويختال أثناء الذؤابة هازئا","كما اختال سيف في خمائل غمده",82,"د",2,0],["ويخلُصُ من في راحتيك زمامهُ","فسيبك كاسيهِ وسيفُكَ سالبهُ",83,"ب",2,0],["ويخون المنظرون وننسى","كي يعيدوا ما كرروه سنينا",84,"ن",2,0],["وَيَخمُسُ العُشبَ وَلا تُبالي","وَماءَ كُلِّ مُسبِلٍ هَطّالِ",85,"ل",1,0],["ويُخصِب من رياضِ حقلٌ","يُراح القادمونَ ! به انتِجاعا",86,"ع",2,0],["ويختلفُ البُناةُ ، ورُبَّ بانٍ","بَنى مِن فِكرةٍ صَرْحاً وشادا",87,"د",2,0],["، ويخربش فوق جدار الشمس","ولا يرتاح ، ولا يضجر",88,"ر",1,0],["ويخافه القوم البُرا","ء وما أخاف ما تهدَّدْ",89,"د",1,0],["وَيُخْطِيءُ فِيهَا مِنْ يَكُونُ عَلَى جَهْلِ","وَكَمْ مِنْ سَرِيٍّ مُولَعٍ بِالتَّعَفَّفِ",90,"ف",1,0],["ويخالُ الرَّغيفَ منْ بَعْدِ كَدٍّ","صاحَ : مَن لي بأنْ أُصِيبَ الإداما",91,"م",2,0],["وَيَخْضِدُ في الآرِيّ، حتى كأنّهُ","بهِ عُرّة ٌ من طائفٍ، غَيرَ مُعْقِبِ",92,"ب",1,0],["وَيخْتَلِفُ الرّزْقانِ والفِعْلُ وَاحِدٌ","إلى أنْ تَرَى إحسانَ هذا لِذا ذَنْبَا",93,"ب",2,0]]}