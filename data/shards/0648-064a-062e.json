 السَّمهريّ","لَدْنٌ ولا الغُصُنُ الأخضَرُ",145,"ر",1,0],["ويخدمكم مني السلام مؤبداً","يوافي إذا هب النسيم اليمانيا",146,"ي",2,0],["ويخطف النوم فلا مقلة","بنومها من بعدها تكحل",147,"ل",1,0],["ويخضر منه روض علم وحكمة","ويصبح أمر الدين ما فيه من باس",148,"س",1,0],["ويخضَرُّ روض الوصل بعد دوائه","وأغصانه تختال في الحلل الخضر",149,"ر",1,0],["ويخلو بمولاه رب الأنا","م وخالقهم وجزيل العطا",150,"ا",1,0],["وَيُخجِلنَ إِن باسمنُ مُبتَسِم الرُبى","أَقاحيهِ مِنهُنَّ الأَقاحِ المُفَلَّجُ",151,"ج",1,0],["ويخوض نيران الوغى وكأنه","ظمآن خاض موارد الغدران",152,"ن",1,0],["ويخضرُّ من بيض أيديهمُ","وجدواهم الزَّمَنُ الأَغْبرُ",153,"ر",1,0],["ويخمد نورهم ناراً تلظى","وكان الظنّ آبية الخمود",154,"د",1,0],["ويخفِقُ وهي مثل الطير سبحاً","جناحاها إذا دارتْ رحاها",155,"ا",3,0],["ويخشخش في صوت الضحكات المرسَل","صوت كتكسُّر قشر الجوز المثقل",156,"ل",1,0],["ويخدمني الصبا والعمر شبا","وإني دائماً بنتٌ فتيّه",157,"ي",2,0],["ويخص منا بالسلام حبيبنا","الألمعي أبو العلا عثمان",158,"ن",1,0],["ويُخْدِعُ بالمُنَى من بات يرجو","تناوُلَ شَأْوِ عِزِّكَ بالخِداعِ",159,"ع",1,0],["ويخاطبون بألسنِ البيضِ التي","من دونها يتلجلجُ الخُطباءُ",160,"ا",2,0],["ويخطُر كالقضيبِ اهتزّ رِيّا","وجُرّ عليه ذيلٌ من سَحابِ",161,"ب",1,0],["ويخوضُ في بحرِ العروضِ ورِجْلُه","لم تبْتَلِلْ بالماءِ فهو نبيُّ",162,"ي",1,0],["ويَخْلَعُ عن مَنكِبَيهِ الرِّدَاءَ","سُروراً وفَرْشاً لضَيفِ القُيولِ",163,"ل",1,0],["ويخفي كنوز الأرض وهي لوامع","ويسرقها سرا وجهرا ویقهر",164,"ر",1,0],["ويخضر اعلاه ويزهر سفحه","ولله ذاك الماء إذ تردونه",165,"ن",2,0],["ويخال ان الله طوع صياحه","أو أنه ان لم يصح لم يرزق",166,"ق",1,0],["ويخط أروع ما شدا مترنم","غرد وأجمل ما جنى وتخيرا",167,"ر",2,0],["ويخال صَخبَ الموبقاتِ حيا لهُ","إعجابَ من عَانوا من استهزائه",168,"ا",3,0],["ويُخجلني أن ينشرَ الناسُ أنكم","طويتم من التنويه ما بي نشرتمُ",169,"م",1,0],["ويخفُق قلبُ الدهر شوقاً وتلتظى","إلى الرِّيّ أيامٌ لواغبُ هِيمُ",170,"م",1,0],["ويختلفُ الناسُ حتى إذا","قضيتَ قضَى القدرُ المنزَلُ",171,"ل",1,0],["ويخفُّ بين بنانها إن حُمِّلَتْ","ضبطُ الحسامِ ويثقلُ الدينارُ",172,"ر",1,0],["ويخدعني البخيلُ يريد ذمّي","وهل عند الهشيمة من مَررادِ",173,"د",1,0],["ويختارُ الصَّوارمَ والعَوالي","فيُتلفُها طِعاناً أو ضِرابا",174,"ب",2,0],["ويخجلُ نورُ البدر من قسماتهِ","وباهِرُ ضوءِ الشمس إذ هو باسِم",175,"م",1,0],["ويُخرس ضوضاء الخطوب بصبره","إذا ما وَنى عَوْدُ المعالي وجرْجرا",176,"ر",2,0],["ويخْشى الجَوْرَ سَطوتَهُ عليه","كما يخْشى مِن الصَّقْرِ الحَمامُ",177,"م",1,0],["ويخشين نار الله نزّاعة الشوى","ويرجين رضواناً من الله أكبرا",178,"ر",2,0],["ويخون في أسناد ريّاه إلى","نجدٍ فكيف يعدُّ في الأمناء",179,"ا",2,0],["وَيَخرُجُ في كُلِّ إِيقاعِهِ","فَأَوقَعَهُ اللَهُ في المَخرَجِ",180,"ج",1,0],["ويخلفني في الطارقات فلا يعو","د يشمت من في الحب لاقي الدواهيا",181,"ي",2,0],["ويَخْوضُ في التّفْسيرِ مِنْ غَمَراتِهِ","لُجَجاً لَدَيْها كُلُّ حَبْرٍ يَذْهَلُ",182,"ل",1,0],["ويخلُبُ لبَّ المرءِ سحرُ جَمالها","وتُنطِقُ من فرطِ المَسَرّةِ أبكَما",183,"م",2,0],["ويُخِفُّ من كان البطيءَ عن الهوى","فكأنّه ما كان غير خفيفِ",184,"ف",1,0],["وَيُخطِئ عُذري وَجهَ جُرمِيَ عِندَها","فَأَجني إِلَيها الذَنبَ مِن حَيثُ لا أَدري",185,"ر",2,1],["ويخفى الكون من غير اختفاء","ويبدو النور من غير انفهاق",186,"ق",1,0],["ويخبث أو يزكو من الأرض نبعُها","على قدرها وهو اختلاف المشارب",187,"ب",1,0],["ويُخلِفُ عمَّن قد مَضَى من رجالهِ","كما يُخلِفُ الأصلُ القديمُ غُصونَهُ",188,"ن",2,0],["ويُخاطبونَ بكلِّ فنٍّ أهلَهُ","فكأنَّ واحدَهم بألف لِسانِ",189,"ن",1,0],["وَيَخلُفُ الخَيرُ بَديلٌ وَنَجيب","عَنهُ وَعَن هَذا النَقيبُ المُستَجيب",190,"ب",1,0],["ويَخْفِضُهم أَنَّهم كالمُضافِ","ويرفَعُهم أَنَّه الفاعِلُ",191,"ل",1,0],["ويُخْلىَ بسيفٍ من يمينك ظالِمٌ","ويُجْلَى بصبحٍ مِنْ جبينك حِنْدِسُ",192,"س",1,0],["ويختار ما اختار البخاري وقد أتى","بذا أثر عن نجل حلو الشمائل",193,"ل",1,0],["ويخرج الأمر عن طوق العباد له","وذاك من شأنه أعظم به شانا",194,"ن",2,0]]}