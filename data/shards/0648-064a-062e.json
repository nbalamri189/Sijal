ل"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[462,"سهرت ونام عن سهري رجال","https://www.aldiwan.net/poem15455.html","الوافر"],[462,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[462,"تتيه جياد الخيل عجبا وعزة","https://www.aldiwan.net/poem16123.html","الطويل"],[462,"هنيئا للمناقب والمعالي","https://www.aldiwan.net/poem16428.html","الوافر"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[465,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[469,"ومله لهونا به عندما","https://www.aldiwan.net/poem60319.html","المتقارب"],[483,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[530,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[539,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[554,"ويخطئ عذري وجه جرمي عندها","https://www.aldiwan.net/poem68311.html","الطويل"],[559,"هي الذات التي فوق البراق","https://www.aldiwan.net/poem34331.html","الوافر"],[559,"دع المنكرين الجاحدين فإنهم","https://www.aldiwan.net/poem34944.html","الطويل"],[563,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[563,"قامت لهيبتها غصون البان","https://www.aldiwan.net/poem52803.html","الكامل"],[564,"فالأولياء رحمة للخلق","https://www.aldiwan.net/poem13620.html","الرجز"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[576,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[588,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[588,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["وَيَخرُجُ مِنها بِالكَرائِمِ حادِثٌ","وَيَدخُلُها صَرفُ الرَدى بِالبَوائِقِ",0,"ق",1,0],["وَيَخشى القَطا الكُدْرِيُّ فيها ضَلالَهُ","وَيَشكو لَظاها في أَداحيِّها الرُّبْدُ",1,"د",1,0],["ويخْجَلُ منْ راحَتَيْهِ الغَمامُ","إذا دَرَّ نائِلُهُ الصَّيِّبُ",2,"ب",1,0],["ويَخْدِشُ غِمدي بالحِمي صَفحةَ الثّرى","إذا جرَّ مِن أذْيالِهِ المُتحضِّرُ",3,"ر",1,0],["ويَخْضَعُ في كَعبٍ لغَيرانَ يحْتَمي","بِجارٍ خُزَيْميِّ الإباءِ سَوامُهُ",4,"م",2,0],["ويَخْلُفُ أنواءَ الرّبيعِ إذا كسا","سَنامَ الحمى بُرْدَيْ عَديمٍ نُضوبُها",5,"ب",3,0],["ويَخْفُقُ أنّى سارَ أو حَلَّ فَوقَهُ","حَواشي ثَناءٍ أو ذَوائِبُ سُؤْدَدِ",6,"د",1,0],["ويخوضُ مُشْتَجَرَ الرِّماحِ بغِلْمَةٍ","عرَبيّةٍ نَخَواتُها أغْمارِ",7,"ر",1,0],["ويَخْبُرُ أهواءَ النّفوسِ بنَظْرَةٍ","تَفُضُّ لها الأسرارُ كلَّ خِتامِ",8,"م",1,0],["ويخْتالُ في ظِلِّهِ المُعْتَفونَ","وتندىً على زائِريهِ رُباهْ",9,"ا",2,0],["ويُخْجِلنَ بالأغصانِ أغصانَ بانَةٍ","وتَهزَأُ بالكُثبانِ منهُنَّ كُثبانُ",10,"ن",1,0],["ويُخلِّفُ المُتَطَلِّعينَ إِلى المَدى","في الفَخْرِ مُنْجَذِبُ العِنانِ سَبوقُ",11,"ق",1,0],["وَيَخْزُنُ الفَلْسَ لِوَارِثِهِ","مُسْتَنْفِداً مَبْلَغَ أَكْوَانِهِ",12,"ن",2,0],["وَيُخْجِلُ سُحْبَ الْغَيْثِ فَالْبَرْقَ خَجْلَةً","إِذَا مَا هَمَى فِي كَفِّهِ وَابِلٌ سَجْمٌ",13,"م",1,0],["وَيَخُصُّ مَجْدَكَ مِنْ سَلاَمِي عَاطِرٌ","كَالْمِسْكَ صَاكَ بِهِ الْغَوَالِي صَائِكُ",14,"ك",1,0],["وَيُخبِرُكُم حُمرانُ أَنَّ بَناتِنا","سَيُهزَلنَ إِن لَم يَرفَعِ العيرَ ميلُها",15,"ل",3,0],["وَيَخافانِ عامِراً عامِرَ الخُض","رِ وَكانَ الذِنابُ مِنهُ مَصيرا",16,"ر",2,0],["وَيَخالُ الرَغيفَ في البُعدِ بَدراً","وَيَظُنُّ اللُحومَ صَيداً حَراما",17,"م",2,0],["وَيَخشى رَبَّهُ وَيُطيعُ مَولىً","هَداهُ إِلى الصِراطِ المُستَقيمِ",18,"م",1,0],["وَيَخطو عَلى صُمٍّ صِلابٍ كَأَنَّه","حِجارَةُ غيلٍ وارِساتٌ بِطُحلُبِ",19,"ب",1,0],["وَيَخضِدُ في الآرِيِّ حَتّى كَأَنَّم","بِهِ غِرَّةٌ مِن طائِفٍ غَيرِ مُعقِبِ",19,"ب",1,0],["وَيَخدي عَلى صُمٍّ صِلابٍ مَلاطِسٍ","شَديداتِ عَقدٍ لَيِّناتِ مَتانِ",20,"ن",1,0],["وَيُخفي لَكُم حُبّاً شَديداً وَرَهبَةً","وَلِلناسِ أَشغالٌ وَحُبُّكِ شاغِلُه",21,"ل",2,0],["وَيَخَافُ عَاقِبَةَ الصَّغَارِ وَقَوْمُهُ","بَاؤُوا بِهِ فِي المَأْزِقِ المُتَلاحِمِ",22,"م",1,0],["وَيُخزِهِمُ وَيَنصُركُم عَلَيهِم","وَيَشفِ صُدورَ قَومٍ مُؤمِنينا",23,"ن",2,0],["ويَختَص بالتبجيل من جاء مُنشداً","ويُقذَف بالتَجْهيل من جاء فاكرا",24,"ر",2,0],["ويخلفها البدر المنير حفيدها","وعنها إذا جنّ الظلام ينوب",25,"ب",1,0],["ويخطر في وشي الحرير قوامها","ونجم الدجى بالغيظ يعثر في منح",26,"ح",1,0],["ويخدعه مثلي فيخدع للندى","سريعاً ولا والله ما هو بالغمر",27,"ر",1,0],["ويَخالُ النديمُ أنّك تفسو","إن تنفستَ نحوه أو نَكَهتَا",28,"ت",2,0],["ويخاف الإِنفاد ممتدحوه","ولديه الأمانُ من إنفادِهْ",29,"د",2,0],["ويخافه القوم البُرا","ء وما أخاف وما تهدَّدْ",30,"د",1,0],["وَيَخالُ حاجَتَهُ الَّتي يَصبو لَها","في دارَةِ الجَوزاءِ أَو في الفَرقَدِ",31,"د",1,0],["وَيَخشى الهَزارُ عَلى وَكنَتِه","فَيَدفَعُ عَنها بِمِنقارِهِ",32,"ه",1,0],["وَيَخافُ مِن أَضيافِهِ","خَوفَ الصَغيرِ مِنَ اليَهود",33,"د",1,0],["ويَخوضُ في وحلِ الشّتا","مُتهلّلا مُتيمّنا",34,"ن",2,0],["وَيَخفِقُ حينَ يُبصِرُهُ فُؤادي","وَلا عَجَبٌ إِذا رَقَصَ الطَروبُ",35,"ب",1,0],["ويَخالُ الوَرْدَ يداعِبُهُ","فرحاً فتعابثه يَدُهُ",36,"د",2,0],["ويخوضُ أَحشاءَ الوُجُود مُغامِراً","في ليلها المتهيِّبِ المحذورِ",37,"ر",1,0],["ويخال مبصره اذا لم ينتبه","ان الذي يرنو اليه حريق",38,"ق",1,0],["وَيَختَلِفُ الدَهرُ حَتّى يَبينَ","رُعاةُ العُهودِ وَخُوّانُها",39,"ن",3,0],["وَيُخشى عُبابُ البَحرِ وَهوَ مَكانَهُ","فَكَيفَ بِمَن يَغشى البِلادَ إِذا عَبّا",40,"ب",2,0],["وَيَختَلِفُ الرِزقانِ وَالفِعلُ واحِدٌ","إِلى أَن يُرى إِحسانُ هَذا لِذا ذَنبا",40,"ب",2,0],["وَيَخفى عَلَيكَ البَرقُ وَالرَعدُ فَوقَهُ","مِنَ اللَمعِ في حافاتِهِ وَالهَماهِمِ",41,"م",1,0],["وَيُخشى شَذاهُ وَهوَ غَيرُ مُسَلَّطٍ","وَقَد يُتَوَقّى السَيفُ وَالسَيفُ في الغِمدِ",42,"د",1,0],["وَيَخرُقُ بِالتَبذيرِ وَهوَ مُجَرِّبٌ","فَلا يَتَمارى القَومُ في أَنَّهُ غُمرُ",43,"ر",1,0],["وَيَخِسُّ النَصيبُ حَتّى يَقِلَّ ال","حَظُّ فيهِ وَيَكثُرُ الأَشراكُ",44,"ك",1,0],["وَيَخُصُّ أَرضاً دونَ أَرضِ جَودِهِ","وَسَحابُ جودِكَ في العُفاةِ عُموما",45,"م",2,0],["ويخدمهم قلبي وسري ومنطقي","فأبلغ أقصى غاية القرب في بعدي",46,"د",2,0],["ويخطِرُ في هَبْوَتَيْهِ الكَميُّ","بقَلْبٍ جرئء ووجهٍ وَقاحِ",47,"ح",1,0],["وَيُخبِرُ أَنَّ النَصرَ فيهِ مُقَدَّرٌ","أَلَم تَرَهُ قَد لاحَ في الغَربِ نونُهُ",48,"ه",1,0],["وَيُخصِبَ رَبعُ الأُنسِ مِن بَعدِ مَحلِهِ","وَيورِقَ مِن دَوحِ التَواصُلِ عودُ",49,"د",1,0],["ويخلق الله معجزاتٍ","يجمعها كلَّها بفرد",50,"د",1,0],["ويَختَطُّ بالخطِّيِّ أرضَ كريهةٍ","يجرّرُ فيها ذيلَ جحْفَله المَجْرِ",51,"ر",1,0],["ويَخِفُّ مَلآناً ويثقُلُ فارغاً","كالجسم تُعدَمُ روحُهُ أو تُوجَدُ",52,"د",1,0],["وَيَخفى مَعَ الإِصباحِ حَتّى كَأَنَّما","يَظَلُّ عَلَيهِ لِلصَباحِ رَقيبُ",53,"ب",1,0],["وَيُخرِجُ مِنهُ حَبَهُ في رُؤَوسِهِ","وَفي ذاكَ آياتٌ لِمَن كانَ واعِيا",54,"ي",2,0],["وَيُخفى بِها وَجداً شَديداً وَقَلبُهُ","إِلَيها كَمَشدُودِ الوِثاقِ أَسِيرِ",55,"ر",1,0],["وَيُخَبَّر بِما تَضَمَّنَ مِنّا","إِذ خَلا اليَومَ لِلمَسيرِ المَراضُ",56,"ض",1,0],["وَيَخافُ شَيطانُ النِفاقِ مَواقِفي","وَإِذا رَآني حاضِراً لَم يَنزَغِ",57,"غ",1,0],["وَيَخجَلُ إِذ يُلاقيني كَأَنّي","أُنَقِّطُ خَدَّهُ بِالجُلَّنارِ",58,"ر",1,0],["ويَخْضِبُ سَيْفَهُ بِدَمِ النَّواصي","مَخَافَةَ أنْ يُقالَ به مَشِيبُ",59,"ب",1,0],["ويخشى الفتى من بأسه قبل باسه","وقد تتقى قبل العضاض الأراقم",60,"م",1,0],["ويخطو على صمّ خفاف وقوعها","ثقيلٌ يُردّ الصخرَ وهو فليق",61,"ق",1,0],["وَيُخرِجُهُ مِن كِمِّهِ فَيَشِمَّهُ","وَيُجلِسَهُ في حِجرِهِ وَيُخاطِبُه",62,"ب",2,0],["وَيَخمِطُ الشاؤونَ مِن خَمّاطِهِ","وَيَطبُخُ الطابِخُ مِن أَسقاطِهِ",63,"ط",2,0],["وَيُخالِفُ الأَيّامَ حُكمٌ واقِعٌ","فيها وَمِثلُ سُبوتِها جُمُعاتُها",64,"ت",3,0],["وَيُخفَضُ في كُلِّ المَواطِنِ ذَمُّهُ","وَإِن كانَ يُدنى في المَحَلِّ وَيُرفَعُ",65,"ع",1,0],["وَيُخلِفُ الظَنُّ في الأَشياءِ صاحِبَهُ","وَالغَيمُ يَكدي وَداعي البَرقِ يَأتَلِقُ",66,"ق",1,0],["وَيُخمَصُ الإِنسانُ مِن نَخوَةٍ","ساكِنَةٍ في أَنفِهِ الوارِمِ",67,"م",1,0],["ويُخالُ موسى جَدُّكُمْ لجلالِهِ","في النّفْس صاحبَ سورةِ الأعرافِ",68,"ف",1,0],["وَيخبرُ عَنّي ما أَقُولُ إِبنَ عامرٍ","وَنِعمَ الفَتَى يأََوي إِِليهِ المُعَصَّبُ",69,"ب",1,0],["ويخصِفُ نعليهِ وطوعُ يمينهِ","مصايرُ هذا العالمِ المترغِّدِ",70,"د",1,0],["ويخفُّ قلبي إثرَ كلِّ شعاعةٍ","في الليلِ تومض عن شهابٍ غائرِ",71,"ر",1,0],["ويخفق صدرانا خفوقا ً كأنما","مع القلبِ قلبٌ في الجوانح ثاني",72,"ن",2,0],["ويخطب الكهان في المواسم","سجع الحمام في الرّبا النواسم",73,"م",1,0],["ويخاف بادرة اللسان تخونه","فإذا تناوله الحديث يُجمجم",74,"م",1,0],["وَيَخفِضُ لي هُناكَ جَناحَ عِزٍّ","عَهدتُ لَهُ مِنَ الرَحِمِ اِنخِفاضا",75,"ض",2,0],["وَيَخطو عَلى صُمٍّ صِلابٍ كَأَنَّها","حِجارَةُ غيلٍ وارِساتٌ بِطُحلُبِ",76,"ب",1,0],["وَيَخضِدُ في الآرِيِّ حَتّى كَأَنَّما","بِهِ غِرَّةٌ مِن طائِفٍ غَيرِ مُعقِبِ",76,"ب",1,0],["وَيَخْلصُ مَنْ رَاحَتَيْكَ زمَامُهُ","فَسَيْبُكَ كَاسِيهِ وَسَيْفُكَ سَالِبُهُ",77,"ب",2,0],["ويخدَعُه طَيْفُ الخيالِ إذا سَرى","فيبعَثُ آمالَ الشجيّ ويذهَبُ",78,"ب",1,0],["ويخفُقُ خفقًا بحبِّ السلام","كما يخفقُ الطيرُ فوقَ الشَّجرَ",79,"ر",1,0],["ويخفضُ للضعفاء الجناحَ","ويعصفُ كالريح بالأقوياء",80,"ا",2,0],["ويختلف الرجال كما أرادوا","فإن أومأت أنت، فلا جدال",81,"ل",1,0],["ويختال أثناء الذؤابة هازئا","كما اختال سيف في خمائل غمده",82,"د",2,0],["ويخلُصُ من في راحتيك زمامهُ","فسيبك كاسيهِ وسيفُكَ سالبهُ",83,"ب",2,0],["ويخون المنظرون وننسى","كي يعيدوا ما كرروه سنينا",84,"ن",2,0],["ويخفي وراء الطلاء الأنيق","صدوع الحنايا وخزي الضمير",85,"ر",1,0],["وَيَخمُسُ العُشبَ وَلا تُبالي","وَماءَ كُلِّ مُسبِلٍ هَطّالِ",86,"ل",1,0],["ويُخصِب من رياضِ حقلٌ","يُراح القادمونَ ! به انتِجاعا",87,"ع",2,0],["ويختلفُ البُناةُ ، ورُبَّ بانٍ","بَنى مِن فِكرةٍ صَرْحاً وشادا",88,"د",2,0],["، ويخربش فوق جدار الشمس","ولا يرتاح ، ولا يضجر",89,"ر",1,0],["ويخافه القوم البُرا","ء وما أخاف ما تهدَّدْ",90,"د",1,0],["وَيُخْطِيءُ فِيهَا مِنْ يَكُونُ عَلَى جَهْلِ","وَكَمْ مِنْ سَرِيٍّ مُولَعٍ بِالتَّعَفَّفِ",91,"ف",1,0],["ويخالُ الرَّغيفَ منْ بَعْدِ كَدٍّ","صاحَ : مَن لي بأنْ أُصِيبَ الإداما",92,"م",2,0],["وَيَخْضِدُ في الآرِيّ، حتى كأنّهُ","بهِ عُرّة ٌ من طائفٍ، غَيرَ مُعْقِبِ",93,"ب",1,0],["وَيخْتَلِفُ الرّزْقانِ والفِعْلُ وَاحِدٌ","إلى أنْ تَرَى إحسانَ هذا لِذا ذَنْبَا",94,"ب",2,0],["ويخصف نعليه ، وطوع يمينه","مصاير هذا العالم الترغّد",95,"د",1,0],["ويخزى ما رق ويذل باغ","ويات الله بالفرج القريب",96,"ب",1,0],["ويخلق ما لا تعلمون وأنه","على كل شيءٍ ما يشاء قدير",97,"ر",1,0],["ويُخْلِفني لما طلبتُ وصالَه","وينجزُ لي من وَعده بوعيده",98,"د",2,0],["وَيَخِفُّ نَحوَ الجودِ إِلّا أَنَّهُ","يوفي عَلى شُمِّ الجِبالِ وَقارا",99,"ر",2,0],["ويخفى الهوى خوفا وتضحى دموعه","تنم بما تخفيه منه ضمائره",100,"ر",2,0],["ويخجل من تلك الظنون ويرعوى","فيحيى خضمٌ من طبيعته المدُّ",101,"د",1,0],["ويخلصه لله من شوبة الهوى","فإن الهوى قاضي القضايا الجوائر",102,"ر",1,0],["وَيَخمُلُ ذِكرُ المَرءِ ذي المالِ بَعدَهُ","وَلَكِنَّ جَمعَ العِلمِ لِلمَرءِ رافِعُ",103,"ع",1,0],["ويَخطبُ أشعاري أمِن حِزبهِ أنا","فأنكِحَها إيّاهُ أم هوَ من حِزبي",104,"ب",2,0],["وَيختصُّ مَن يختارهُ بِشفاعةٍ","إِذا شاءَ في الدُنيا وإن شاء في الأخرى",105,"ر",2,0],["ويخبرني وَشْكُ الرَّدى بلحاقِهِ","فأرتاحُ لليومِ",106,"م",1,0],["ويخالونَ وجهها قمرَ الأف","قِ على ما بأوجهِ الأقمارِ",107,"ر",1,0],["وَيُخفيِ عطاياه ويُظْهِرُها الثَنا","وهل كَتَمَتْ نَشْرَ الربيع الكَمائِمُ",108,"م",1,0],["ويختطفُ الأبصارَ ضوءُ جبينهِ","وترتجفُ الأبحارُ إن هو جيّشا",109,"ش",2,0],["ويخجل ورد الروض من ورد خدّه","حلفت له أن لا أبوح بودّه",110,"ه",1,0],["وَيخلفها الأَلَمُ المُستَزيدُ","فَيَفعَلُ في الصَدرِ ما يفعَلُ",111,"ل",1,0],["ويخرج من نار الجحيم بجاهه","من العصب العاصين كل محنذ",112,"ذ",1,0],["وَيَخُصُّ خِزْيُكَ يَا مُخَصِّصُ كُلَّ مَنْ","قَدْ خُصَّ فِي شَيْءٍ سِوَاكَ خُصُوصُهُ",113,"ص",2,0],["ويخترق الصفوفَ بروقُ فيها","وهل يخفى شذا المسك الذكيّ",114,"ي",1,0],["وَيُخجِلُ مَيّاسَ القَضيبِ تَمايُلاً","وَيفضَحُ مُنهال الكَثيبِ تَهيُّلا",115,"ل",2,0],["وَيَخشى مِن دنوّ العارِ مِنه","وَلا يَخشى مِن الأَجَلِ المُتاحِ",116,"ح",1,0],["ويخصب ناديهم بالسماح","إذا أقلع الغيث أو صبا",117,"ب",2,0],["وَيَخُطُّ بالخَطِّيِّ ما لا تَدَّعِي