{"poems":[[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[32,"يا حاديي بنت فضاض أما لكما","https://www.aldiwan.net/poem29609.html","البسيط"],[87,"نظر الليث إلى عجل سمين","https://www.aldiwan.net/poem8041.html","الرمل"],[45,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[47,"لج هذا الحبيب في هجرانه","https://www.aldiwan.net/poem66663.html","الخفيف"],[46,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[21,"لك الحمد والنعماء والملك ربنا","https://www.aldiwan.net/poem36236.html","الطويل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85453","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140944",""],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[240,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[242,"ليس لنا في سوى ابن الحاج من حاج","https://www.aldiwan.net/poem18115.html","البسيط"],[324,"ونحن حبسنا في نهاوند خيلنا","https://www.aldiwan.net/poem23880.html","الطويل"],[368,"غشيت بِقرا فرط حول مكمل","https://www.aldiwan.net/poem1723.html","الطويل"],[396,"وراك ياذاك جالس في بلد جانبي","https://www.aldiwan.net/poem54613.html","عموديه"],[406,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[406,"عثمان رضي الله عنه","https://www.aldiwan.net/poem6768.html","عموديه"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[438,"مولاي عبدك يشتكي","https://www.aldiwan.net/poem12546.html","مجزوء الكامل"],[438,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[445,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[449,"مذ تفردت بالكمال وأصبح","https://www.aldiwan.net/poem55913.html","الخفيف"],[458,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[463,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[511,"قل للزنادق عني","https://www.aldiwan.net/poem2394.html","المجتث"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18504","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96606","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64780","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137865",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95512","الخفيف"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96343","الكامل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128753","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69330","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27260","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93906","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97889","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74083","الوافر"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128403","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45779","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135753","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99114","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204266","المجتث"],[4755,"المَوتُ مِن طَرَفٍ واحد","https://www.poetsgate.com/ViewPoem.aspx?id=184730",""],[4791,"منك وعليك أشكي","https://www.poetsgate.com/ViewPoem.aspx?id=28412",""],[5183,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5409,"أحداث هذا الدهر تترى","https://www.poetsgate.com/ViewPoem.aspx?id=155276",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5732,"الله كفيل الناس وارضه وسيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[6093,"عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=198259",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""]],"verses":[["وَرَآكَ أهْلاً لِلْخِلاَفَةِ بَعْدَهُ","فَأرَاكَ قِدْحَ الْمُلْكِ كَيْفَ تُجِيلُهُ",0,"ل",2,0],["وَراكِدِ الشَمسِ أَجاجٍ نَصَبتُ لَهُ","حَواجِبَ القَوم بِالمَهرِيَّةِ العوجِ",1,"ج",1,0],["وَرَآكُم خَيرَ مَن يُستَوزَرُ","وَلِأَمرِ المُلكِ رُكناً يُذخَرُ",2,"ر",1,0],["وَراكِبَ الهَولِ لا يُفَتِّرُهُ","لَو كانَ لِلهَولِ مَحزِمٌ هَزَلَه",3,"ل",2,0],["ورآكَ إذْ ولَّاكَ أمرَ عِبادهِ","تَدعُ الذي تهوَى لِما يختارُ",4,"ر",1,0],["وَرَآكَ العِبادُ مِن نِعَمِ اللَ","هِ عَلَيهِم وَطولِهِ وَاِمتِنانِه",5,"ن",2,0],["وَراكِدُ الهَمِّ كَالزَمانَةِ وَال","بَيتُ إِذا ما أَلِفتَهُ رَمسُ",6,"س",1,0],["وَراكِعُهُم يَعنو لَهُ الدَهرَ خاشِعاً","يُرَدِّدُ آلاءَ الآِلَهِ وَيَحمَدُ",7,"د",1,0],["وَراكِباً عَلى النَجيبِ هارِبا","لَمّا رَأى مَن فِعلِهِ العَجائِبا",8,"ب",2,0],["وَراكبه كَثير اللَهْ","وِ لا يخشى به الغَرَقا",9,"ق",2,0],["وراكب الهول ما يفتره","لو كان للهول محزمٌ هزله",10,"ل",2,0],["ورآك سيدُنَا الإِمامُ أحقَّهُم","بقيادة الأعلام والأعلام",11,"م",1,0],["وَراكبُ البعيرِ في الصحفِ الأُوَل","وهيَ علاماتٌ بها قَد عُلما",12,"م",2,0],["وَرَآكَ أَسرَعَهُم إِلى الأَعداءِ إِقداماً","وَغَيرُكَ مُحجِمٌ مُتَهَيِّبُ",13,"ب",1,0],["وَرَاكِبُ البَحْرِ لاَ يَنْفَكُّ مِنْ خَطَرٍ","وَبَحْرُهُ مُمْتَطِيهِ كُلُّهُ نَاجِ",14,"ج",1,0],["وَراكَضَهُنَّ الفَيرُزانُ عَلى الصفا","فَلَم ينجِهِ مَنّا اِنفِساحُ المَخارِمِ",15,"م",1,0],["وَراكِضَةٍ ما تَستَجِنُّ بِجُنَّةٍ","بَعيرَ حِلالٍ راجَعَتهُ مُجَعفَلِ",16,"ل",1,0],["وراك ياذاك جالس في بلد جانبي","قد خير لك قم وسر منها إلى جانبي",17,"ي",1,1],["ورآكَ شهرُ الصَّومِ عاشق صومِهِ","وأخا قيامٍ ينشدُ الرَّيَّانا",18,"ن",2,0],["ورآكَ جيش العُسرةِ الكفَّ التي","تعطي وسلَّمكَ السَّخاء المقودا",19,"د",2,0],["وراكبٍ من المعالي سابقاً","ما عثر الجدّ به ولا كبا",20,"ا",1,0],["ورآكَ معدومَ النظي","رِ يَبينُ بالفضلِ انفرادُك",21,"ك",1,0],["ورآكَ في ذا الدّهرِ معنى جِدّه","وسواك معنى هولِه ومِزاحه",22,"ح",2,0],["ورآكَ فِي هَدْيِ الصَّلاةِ مُكَبِّراً","ومهلِّلاً وبحمدِ ربِّكَ مُعلِنَا",23,"ن",2,0],["ورآك المليك أوسكار بحراً","وافرا جامعا شتات العلوم",24,"م",1,0],["ورآك في أحلامه ويقينه","أبدا فهمّ يصارع الجبّار",25,"ر",1,0],["وراكب الريح سليمان لو اب","تغاكُمُ في ظهرها ما لحقا",26,"ق",2,0],["ورآك الشِّعرُ العزيزُ على غي","رك كُفئاً فلانَ شيئاً وقَرَّا",27,"ر",2,0],["ورآكَ طفلاً شِيبُها وكهولها","فتزحزحوا لك عن مكان السيِّدِ",28,"د",1,0],["وراكبٍ لهواه","عَساه يَوماً سَيُثنيه",29,"ي",2,0],["ورآك أسبق إنْ جريتَ ولو","أعطته سَبْقَ لحاظها المُقَلُ",30,"ل",1,0],["وَراكِبٌ مَحمَلاً صَلّى فَرائِضَهُ","وَمَع كَمالِ شُروطِها الَّذي ذَكَرا",31,"ر",2,0],["ورآك ميمون الجلوس موفّقاً","شعب رآك مبارك الميلاد",32,"د",1,0],["وَراكِبٍ لِلهَولِ يَجتابُهُ","مِثلَ شِهابِ القَبَسِ الواقِدِ",33,"د",1,0],["وَرَآكَ قبلَةَ قَصدهِ","دونَ الأَعاجمِ وَالعَرب",34,"ب",1,0],["ورآكَ في سِلْمٍ فأَقْبَلَ مُقْبِلاً","ولو أنَّهُ في الحَرْب أَسْرَعَ مُدْبِرا",35,"ر",2,0],["ورآك جندك ضارعاً","لهم ضراعات الأسير",36,"ر",1,0],["ورآك سيفك لا تمد له يدا","عجزا فكاد لذاته يتجرد",37,"د",1,0],["ورآك الفتى الوقورَ المؤدى","للعلا ناهضا حقوقاً وفيه",38,"ي",2,0],["ورآك أهلك منهم ورأينهم","ولقد يكون مع ا لشباب الخاذل",39,"ل",1,0],["وراك عن لومي يا لائمي","لا يملك المشتاق سلوانه",40,"ن",2,0],["وَرَآكَ ماضي الشَفرَتَينِ مُهَنَّداً","فَكَساكَ ماضي الشَفرَتَينِ مُهَنَّدا",41,"د",2,0],["وراكبُ الفلك ما دامت تسيِّره","ريحُ الشريعة محفوظٌ وممنون",42,"ن",1,0],["وَرآك أَهلا أَن تَقوم بحده","وَبِسَيفه المَشهور أَنتَ مقلّد",43,"د",1,0],["وراكَ والمُقدِمُ والجنبانِ","وبعدُ غُضروفَاك والثديانِ",44,"ن",1,0],["وراكب ظهر الدهر راكب زورق","إذا أعوزته الريح عاد إلى الحدر",45,"ر",1,0],["وراكبٍ سيارة فخمةً","كأنه في قومه السيد",46,"د",1,0],["وَراكِب رأسه إن سارَ يَوماً","فَلَيسَ له من العثرات بدُّ",47,"د",1,0],["ورآك أهلا للرقي فبت في","أسمى المراتب جالسا بإزائه",48,"ا",3,0],["وَرَآك فَوقَ صُعوده وَسُعوده","قَدراً وَأَجدَر بِالسُمو وَأَقدَرا",49,"ر",2,0],["وراكبٍ وطارقٍ بالليلِ","أو النهار والعدا والويلِ",50,"ل",1,0],["ورآك أهلاً للرشاد وللهدى","وكساك آيات الإمام الهادي",51,"د",2,0],["وراكباً متن بلواها على غررٍ","وطارحاً نفسه أقصى مهاويها",52,"ي",3,0],["ورآك للتشريف أهلاً فاجتبى","بوفائه ملكٌ يقول ويفعلُ",53,"ل",1,0],["وراكب فوق طرف","كأنّه فوق طرفي",54,"ف",2,1],["ورَآكَ بيَومٍ خارِجَةٌ","عَن سِربِ العُمرِ عَقَارِبُهُ",55,"ب",2,0],["وراك ما ترحم خفوق ٍ يعاني","صدِّك وتعذيبك يرى فيه راحات",56,"ت",1,0],["ورآك اللبيب فيه فلما","عرف الحال طيه أخفاها",57,"ا",3,0],["ورآك الورى فهاموا ولو لم","يبصروا العين ما سبتهم رؤاها",57,"ا",3,0],["ورآك لست من الألى","قتلوا حياة الناس خبرا",58,"ر",2,0],["وراكبهم .. كان في أرضِنا.",". وما زال لصًا .. بغيًا .. دخيلاً",59,"ل",2,0],["ورآك والشجار حولك سجدا","لك حيث ملت تفيأت لتميلا",60,"ل",2,0],["وراك تورينا الجفا والقطيعه","وحنالك اطوع من بنان اليديني",61,"ن",2,1],["وراكضاً فيهِ ألقى حِمْلَ غُربَتِهِ","وما استراحَ ، أغانيهِ غَدَت شُهَدا",62,"د",2,0],["وراكعٍ غير بيت اللهِ وُجْهَتهُ","يَأتَمُّ شَيْخًا من الأغْصَانِ والخِرَقِ",63,"ق",1,0],["وراكبُ الرِّيحِ سليمانُ أو اب","تغاكمُ في ظهرها ما لحقا",64,"ق",2,0]]}