{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[90,"يا بني الرافدين مالي أراكم","https://www.aldiwan.net/poem44473.html","الطويل"],[53,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[121,"مضناك","https://www.aldiwan.net/poem24046.html","المتدارك المنهوك"],[285,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[302,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[343,"إن ظني بحسن عفوك يا رب","https://www.aldiwan.net/poem68762.html","الخفيف"],[358,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[396,"الحمدلله على ما أولى","https://www.aldiwan.net/poem54480.html","عموديه"],[412,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[580,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138254",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64108","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1129,"","https://poetry.dctabudhabi.ae/diwan/poem/102043","البسيط"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216851",""],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111125","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48202","الطويل"],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115164","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126228","الخفيف"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105081","الخفيف"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138757",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138520",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216416","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102975","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178104","البسيط"],[4827,"يا استاااااذ ...؟","https://www.poetsgate.com/ViewPoem.aspx?id=29525",""],[4869,"ريح السواليف","https://www.poetsgate.com/ViewPoem.aspx?id=151577",""],[4987,"النصايب","https://www.poetsgate.com/ViewPoem.aspx?id=49593",""],[5055,"أذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=104032",""],[5194,"سهير الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=31733",""],[5324,"فأنا المصلوب من غير صليب.","https://www.poetsgate.com/ViewPoem.aspx?id=211384",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5455,"إحتياج","https://www.poetsgate.com/ViewPoem.aspx?id=49231",""],[5461,"إبتعد","https://www.poetsgate.com/ViewPoem.aspx?id=9931",""],[5461,"الليالي فرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=22533",""],[5461,"السما وردي","https://www.poetsgate.com/ViewPoem.aspx?id=9512",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5794,"النضال العفاف","https://www.poetsgate.com/ViewPoem.aspx?id=80278",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5974,"حكاية فلّ","https://www.poetsgate.com/ViewPoem.aspx?id=216007",""],[6056,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=130378",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""]],"verses":[["يَؤُمُّهُم إِذ يَؤُمُّهُم جُنُباً","فَلَيتَهُ أَمَّهُم عَلى جَنبِ",0,"ب",1,0],["يَوْمُ هَذَا التَّأْبِينِ مَفْخَرَةٌ","فَلْيُثِبْكَ القَدِيرُ وَليَصُنِ",1,"ن",1,0],["يوم هجتم على ذويكم لضرب","بسيوف ما جاز أن تنتضوها",2,"و",3,0],["يومُها للنديم يومُ نعيمٍ","والتذاذٍ وحَبرةٍ وابتهاجِ",3,"ج",1,0],["يَومُهَا يوْمُهَا وَلِلسَّعْدِ فِيهِ","غُرَرٌ ذَاتُ رَوْعَةٍ وَحُجُولُ",4,"ل",1,0],["يَؤُمُّهَا بِالأَمَانِي العُفَاةُ وَمَا","يَنْأَى عَنِ الخَيْرِ مِنْهَا كُلُّ مُقْتَرِبِ",5,"ب",1,0],["يومُهُ واللّيا","لي في البُكا مُذْ أَحَبّْ",6,"ب",1,0],["يُوْمُهُ فِي النَّدى بِعامٍ مِنَ الْغَيْ","ثِ إِذا قَلَّ مَنْ يَجُودُ وَيُجْدِي",7,"د",2,0],["يؤمُّه الوَفدُ من عُربٍ ومن عَجمٍ","وَيسبرونَ له البيدَ السَباريتا",8,"ت",2,0],["يومه شقوة وجوع وعرى ومناه","حياة هذا الغني",9,"ي",1,0],["يَومَ هَتكِ السُتورِ عَن حُجُبِ الغَي","بِ فَلا تَهتِكَنَّ لِلناسِ سَتري",10,"ر",2,0],["يُؤمّهم باذل المَعروفِ يقدُمهم","غَضَنفراً غَير زَجر الخَيل ما عَرَفا",11,"ف",2,0],["يؤمه الناس من كل الجهات لهم","إليه شوق كمثل المالظمان",12,"ن",1,0],["يؤمهم عطّاف يَطلُب ثأرُهُ","فَأَوردهم وَرداً وَبيّا موهَّجا",13,"ج",2,0],["يؤمهم البَدر الفَتى ابن رَبيعة","وَقَد صَمَّمَ الرمح الأَصم وَأَرهَجا",13,"ج",2,0],["يوم هاجت بالإدكار قلوباً","أصبحت من صوارم البين كلمى",14,"م",2,0],["يَومَها كلُّ فِلْقَةٍ مِن رَصاص ٍ","سوفَ يَجري لِكَعبِها استِنطاقُ",15,"ق",1,0],["يَومَها كلُّ قَطرَة ٍ مِن دِمانا","سَوفَ تَغدو عَينا ًلَها حِملاقُ",15,"ق",1,0],["يومُه في النَّدى لمن يَرْتَجيه","عيدُ فطرٍ وفي العِدا عيدُ نحْرِ",16,"ر",1,0],["يؤمها عظماء مثلما حظيت","فيما مضى بملوك أو صناديد",17,"د",1,0],["يومَهُ كم هرقتَ في الأرض دمعاً","من دمٍ من قلوبها مُهَراق",18,"ق",1,0],["يَؤُمُّهُمْ فِي صَلاَةِ النَّصْرِ أعْلَمُهُمْ","بِالفَتْحِ وَالنَّصْرِ فِي خَتْمٍ وَإبْدَاءِ",19,"ا",2,0],["يؤمهم فرد هو الجمع نجدة","وحسبك فرد بالجميع مقوم",20,"م",1,0],["يَؤُمُّهُمُ لَيْثٌ إذَا الخَطْبُ غَالَهُمْ","جَلاَهُ وَنَابُ الخَطْبِ بِالخَطْبِ كَاشِرُ",21,"ر",1,0],["يؤمهم للعلى حامي الحقيقة من","جلت مزاياه إن يحصين بالقلم",22,"م",1,0],["يوم هذا صار تَلواكم","عقب زينٍ به مِلَكتونا",23,"ن",2,0],["يوم هو الأضحى وصلت به","من وصله ليلاً هو القدر",24,"ر",1,0],["يؤمُّهُمُ في المجدِ والبأسِ سيِّدٌ","كريمٌ صَفَتْ من راحتيهِ المواردُ",25,"د",1,0],["يؤمُهُّم صادعٌ بالحقّ أحكمَهُ","حزمٌ وعلمٌ بما يأتي وما يذرُ",26,"ر",1,0],["يَومُهُ صَائِمٌ وقائِمٌ بليلٍ","يَتَّقِى رَبَّهُ بِقَلبٍ شَجِى",27,"ا",1,0],["يوم هاجت عصايب الشرك للهي","جاء تقفوا الصفوف إثر الصفوف",28,"ف",1,0],["يَومٌ هُوَ العيدُ العَظيمُ لِمؤمِنٍ","مَا شَابَ مَحضَ الرِّبحِ مِنهُ بِخُسرِهِ",29,"ر",2,0],["يوم هوى للأرض قطب وجودها","فتزلزلت بالاضطراب جبالها",30,"ل",3,0],["يومها الأول وافى ودنا","فانس أيامك في ساعاته",31,"ه",1,0],["يؤمهم هاد من اللَه لو دجا","عويص فعن عين العناية ينظر",32,"ر",1,0],["يؤمهم علم الإسلام معلمه","لولاه لم تصب الأوثان والصلب",33,"ب",1,0],["يؤمهم سليمان المعالي","ولا قش بن ساعدة الأيادي",34,"د",2,0],["يٌؤٌمُّهُمْ ((زائِدُ)) الإحسانِ مُتَّشِحاً","بُرْدَ الهُدَى وسَرَى في ظِلِّ مُقْتَدرِ",35,"ر",1,0],["يومه تركني بين اهات .. واهات","احسّ به والقلب فاقد حواسه",36,"س",2,0],["يومه وعدني باللقا ليتني غبت","ولا شفت شيٍ يِتعب اللي يناظرْه",37,"ر",2,1],["يومه غدى بينت له كل الاوضاع","ماقلت اخلي سايب الوضع سايب",38,"ب",1,0],["يوم هل السعد مع روحي خذاك","وانطوت الآمال يا ضيّ السنين",39,"ن",1,0],["يومه يبان كل يوم قبالي","يقول يا عمري هذي حياتي وظماي",40,"ا",2,0],["يومه داء ..شرود ..وانكسار","وضياع في دروب ضائعات",41,"ت",1,0],["يؤمها الغرب والأخلاق في عدمٍ","ما همَّ هند بأخلاقٍ وتشديدِ",42,"د",1,0],["يومه قادم... فويل ٌ لمن واجه","...يوم الحساب غير مزود",43,"د",1,0],["يومه فتت أكباد الورى","ومن الأجفان قد بز الرقادا",44,"د",2,0],["يوم هبّ الوقت وأعماني عجاجه","الفرج عيّا .. وأنا بالصبر راهي",45,"ا",3,1],["يوم هفت شمس حبك للمغيب","استرحت وعاد لي طيف الكرى",46,"ر",2,0],["يوم هملنا الليالي هملتنا","كيف تعطينا وحنا ما عطينا ؟",47,"ن",2,0],["يوم هلت واستهلت وامطرت","روضة عقب الوسم جاها ولي",48,"ل",2,0],["يومه اشر قلت طرقي لي زهم","والمسافات البعيده لي نكد",49,"د",1,0],["يومُهُ مثلُ أمسِهِ في شقاءٍ","ولعلَّ الرَّجاء طيَّ غَداتِه",50,"ت",2,0],["يومها وانت واقف للطهاره عفاف","مانكسر فيك مبدأ ولا شكالك وله",51,"ل",2,0],["يومها الدنيا ملاهي / عشتها طفلٍ / عنيد","ان بكى قامت حروب / وان ضحك / شاع السلام",52,"م",1,0],["يومها الدنيا ملاهي / عشتها طفلٍ / عنيد","ان زعل قامت حروب / وان ضحك / شاع السلام",52,"م",1,0],["يوم هام الزمان فيك وأبدى","حسراتِ المحبِّ ذا المستهامُ",53,"م",1,0],["يومها حطيت فُلِّك في أمان","ريحته والله لا يمكن تطير",54,"ر",1,0],["يوم هي في الناس ماغيري هوت","ومارضت بأحد لها قبلي خليل",55,"ل",1,0],["يوم هبّ الغلا في الجوف نفحة ورود","في عروقي ، رياح الودّ شمّيتها",56,"ت",3,0],["يومها فليهن جفنيكَ الكَرَى","نيمةَ الطفل وأحلامَ الحَمامْ",57,"م",1,0]]}