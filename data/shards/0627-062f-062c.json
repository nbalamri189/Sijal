{"poems":[[87,"من ظن بعدك أن يقول رثاء","https://www.aldiwan.net/poem62941.html","الكامل"],[92,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[215,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[215,"طغت دجلة فيما سمعت فأغرقت","https://www.aldiwan.net/poem46758.html","الطويل"],[302,"من لشملي لو فاز منكم بجمع","https://www.aldiwan.net/poem33226.html","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25339","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88679","الكامل"],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139091","المتقارب"],[4767,"الحَجْر","https://www.poetsgate.com/ViewPoem.aspx?id=211043",""],[4778,"أطلق يراعك","https://www.poetsgate.com/ViewPoem.aspx?id=188187",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5906,"في رثاء عمي","https://www.poetsgate.com/ViewPoem.aspx?id=188827",""]],"verses":[["أَدجى بِها لَيلُ الخُطوبِ وَطالَما","مُلِأَت مَنازِلُها سَنىً وَسَناءَ",0,"ا",2,0],["أدجلةُ إنَّ في العبرات نطقاً","يحّير في بلاغته العقولا",1,"ل",2,0],["أدجلةُ ما بيني وبينك أفصحي","فقد طال في مغناك تبريح إضنائي",2,"ي",1,0],["أدجلةُ أين الحب قولي فإنني","تقلبتُ في نارين حقد وبغضاء",2,"ا",2,0],["أدجلةُ أين النور قولي فإنني","على الشط أستهدى دياجير ظلمائي",2,"ي",1,0],["أدجلةُ أبلاني اغترابي وشفّني","هيامى بظلمي في بلادي وإشقائي",2,"ي",1,0],["أدجلة أنت النيل بغياً وكدرة","فكيف من النارين تسلم أحشائي",2,"ي",1,0],["أدجلة ساقتني إليك مقادرٌ","تأنّقن في كيدي وأبدعن إيذائي",2,"ي",1,0],["أدجلة واسيني فللضيف حقّهُ","إذا شئت من زادٍ وحبّ وصهباء",2,"ا",2,0],["أدجلة تطغى والزمان مسالمٌ","وقد سكن البتّار وانقضت الحربُ",3,"ب",1,0],["أدجلة تطغى كيف إني إخالها","بدمع عيون العاشق الصب تحتل",4,"ل",1,0],["آدَ جهدي هواكمُ ونواكم","حمَّلتني من الجَوى غيرَ وسعي",5,"ع",2,0],["أَدْجَنَ فَاخْضَرَّتْ لَهُ فُرُوعِي","بَعْدَ ابْتِراءِ السَنَةِ السَفُوعِ",6,"ع",1,0],["ادجاج زحاف عليك تزاحفت","قوم قلوبهم من الجلمود",7,"د",1,1],["أدجالُ هذا أوانُ الخروجِ","ويا شمسُ لوحي من المغربِ",8,"ب",1,1],["أدجَى وكان ينيرُ مِن","إشعاعِ وجهكِ مُسفرا",9,"ر",2,0],["أدجت سراج النهى فالتاث طالعها","واستوطن الجهل من أرجائها القمما",10,"م",2,0],["أدجاجة، أكنافة،","أم صحن خوخ، أم عنب؟",11,"ب",1,0],["أَدُجِّنَتِ الكَرَامَةُ؟ أَيُّ عِزٍّ","لأَرْضِ النَّخْلِ يَحْكُمُهَا \" سَفِيْرُ \"؟",12,"ر",1,0],["أَدجيتَ لَيلَكَ حصراً في مضاربنا","والأنجُم السود في دجناك تنحَدِرُ",13,"ر",1,0]]}