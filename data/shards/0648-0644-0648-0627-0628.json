{"poems":[[36,"إذا طلعت شمس النهار فسلمي","https://www.aldiwan.net/poem4908.html","الطويل"],[90,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[87,"خفضت لعزة الموت اليراعا","https://www.aldiwan.net/poem62859.html","الوافر"],[107,"بربك ماذا أصاب البلادا","https://www.aldiwan.net/poem43390.html","المتقارب"],[50,"على مركبي مني السلام وبزتي","https://www.aldiwan.net/poem66147.html","الطويل"],[50,"أبا العباس كف عن الملام","https://www.aldiwan.net/poem66628.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16689","الطويل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43905","الكامل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[136,"تأوبه الخيال وليس يألو","https://www.aldiwan.net/poem54769.html","الوافر"],[139,"رأى الواشي تباريحي","https://www.aldiwan.net/poem49020.html","الهزج"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[214,"أحيا الربيع الأرض بعد مماتها","https://www.aldiwan.net/poem13322.html","الكامل"],[266,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[287,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[370,"تمناني ليقتلني وأنت","https://www.aldiwan.net/poem44519.html","مجزوء الوافر"],[371,"جوابك في بعده في المنال","https://www.aldiwan.net/poem17393.html","المتقارب"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[411,"جرى رسم الأحبة إن ناوا","https://www.aldiwan.net/poem49597.html","الوافر"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48602","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113988","الكامل"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123776","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201719","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53221","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53226","الخفيف"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105408","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62778","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103872","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22804","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120231","الطويل"],[4800,"العنيده","https://www.poetsgate.com/ViewPoem.aspx?id=104750",""],[5277,"الليالي البيض..","https://www.poetsgate.com/ViewPoem.aspx?id=213842",""],[5300,"ذكرت فراقا والتفرّق يصدع","https://www.poetsgate.com/ViewPoem.aspx?id=200452",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5582,"لِمَنْ تِلْكَ الهَوادِجُ وَالحُدُوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=186779",""],[5582,"أَهاجَتْ لَكَ التَّذْكارَ تِلْكَ المَعاهِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63494",""],[5701,"جنود لصوص في القناة تجمعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164588",""],[5817,"أ لو نمتي","https://www.poetsgate.com/ViewPoem.aspx?id=190710",""],[5906,"آدمية جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188520",""],[6102,"اللي لزوما","https://www.poetsgate.com/ViewPoem.aspx?id=182909",""]],"verses":[["وَلَو أَبلَغَتها جارَةٌ قَولِيَ اِسلَمي","بَكَت جَزَعاً وَاِرفَضَّ مِنها دُموعُها",0,"ع",3,0],["ولو ابتغوا للنشئ فيه ثقافة","لتثقفوا منه بخير ثقاف",1,"ف",1,0],["وَلَو آبَت ثَواكِلُ كُلِّ قَرنٍ","وَجَدنَ الشَمسَ لَم تَثكَل شُعاعا",2,"ع",2,0],["وَلَو أَبصَرَ المَوتَ مِن دونِها","لَما رامَ عَن جانِبَيها اِرتِدادا",3,"د",2,0],["وَلَو أَبصَراني وَالقُيودُ تَلُفُّني","وَمَشيِي إِلى البَوّابِ بِالنَجَشانِ",4,"ن",1,0],["ولو أبصرتَني عند السواري","أطوّفُ عند تأذين الإمام",5,"م",1,0],["ولو أبصرَتْ شخصي غُدُوّاً لشَبّهَتْ","بما أبْصَرَتْهُ نابِتَ الشُّبُهانَه",6,"ن",2,0],["وَلَو أَبصَرَها طِفلٌ","صَغيرُ السِّنِّ ما شابا",7,"ب",2,0],["ولو اِبتغوا حلقَ الرؤوسِ بمكّةٍ","حضر الرشيدُ بها وغابَ الهادِي",8,"د",2,0],["ولو ابتغى شمس الضحى عِرسا له","لرأيتها هبطت من الآراد",9,"د",1,0],["ولَو أبقَيتُ بَعضَ القَلبِ عَنهَا","لَدَلَّ عَلَى بَقِّيتهِ الدَّلاَلُ",10,"ل",1,0],["ولو أبصر وجناتٍ","تضيء الليل إن جنَا",11,"ن",2,0],["ولو أبرزوها مزقت من عروضها","جلابيب فيها بالضلال تجلببوا",12,"ب",3,0],["ولو ابن حجة رام منها وقفة","ما حاد في مسمعاه عن ميقاتها",13,"ت",3,0],["ولو أبقت الدنيا على الناس حالة","لما اختلفت بعد القياس أمورها",14,"ر",3,0],["وَلَو أَباحَني وِصالاً لَم أَفُز","مِنهُ بِغَيرِ ضَمِّهِ وَاللَثمِ",15,"م",1,0],["وَلّوا بسخطٍ وعُنف نازحين وقد","قابلتُهم بالرِضا والرفق من أمَمِ",16,"م",1,0],["ولو أَبصرتَ ما جَمَّعت","تُ فوقَ الوَردِ تَزدَهِدُه",17,"د",2,0],["وَلو أبصرتَ والبَصَرُ ال","مُبَيِّنُ قَلَّ مَن يَجِدُه",17,"د",2,0],["وَلَو أَبصَرَ الدَهرُ ما قَدَّمو","كَ وَلَكِن لِمَن فيهِ عَمَّ العَمى",18,"م",2,0],["وَلَو أَبصَرَت المامي","بِنادي فَضلِهِ الخَضل",19,"ل",1,0],["ولو أبقى فِراقُكَ لي فُؤاداً","وجَفْناً كنتُ أجزَعُ مِن سُهادِ",20,"د",1,0],["ولو أبصَرتَ إذ رحلوا فؤادي","رأيت الصبر يتّبع الجمالا",21,"ل",2,0],["ولوِ ابْتَذَلْتَ بِهَا مَخَفَّةَ والِدٍ","لَمْ تُعْطِها إِلّا السيوفَ مُهُورا",22,"ر",2,0],["ولو أباح ما حَمى من ريقه","لكان أشفَى لي من الماء اللمى",23,"م",2,0],["ولو أَبْصرَ النَّظَّامُ جوهَر ثَغْرِها","لما شَكَّ فيه أَنَّه الجوهَرُ الفَرْد",24,"د",1,0],["وَلَو أبلَغَتكَ النّاسُ حَقَّكَ في العُلا","وَفي غَيرِها صلَّوا عَلَيكَ وَسَلَّمُوا",25,"م",3,0],["ولو أبصرته فاتكاً بعد عودها","به ما استطاعت أن تمد له يدا",26,"د",2,0],["ولَّوا بأُمِّ المؤمنينَ فهَلهَلت","نَفسي تُفارِقُني وعيني تسجمُ",27,"م",1,0],["ولو ابتغى لحظُ التمنّي أن يُرى","ظِلّاً لطَيفِ خياله لتَنَكَّرا",28,"ر",2,0],["ولو أبو كَرِب في وصلِها طمعَا","ندّت وصَدَّت صُدوداً عن أبي كَرِبِ",29,"ب",1,0],["ولو أبصرتْ عيناي للعلم ناصرًا","لما كنتُ أبكيه بمقلة بائس",30,"س",1,0],["وَلَو اِبتَليت وَعَلَّ ذَلِكَ كائن","بِالفَقر ما عيرت ذا اِستجداء",31,"ا",2,0],["ولو ابن حجاج رآه لانثنى","يثني المدائح عن أبي الريان",32,"ن",1,0],["ولو ابن الحسين شاء عُلَيَّاهُ","ثَنَى الحمدَ عن بني حمدان",33,"ن",1,0],["ولو أبقت لي الزفرات صوتاً","لأسكت السواجع بالحنين",34,"ن",1,0],["ولو أبصرتها الشهبّ غارت ولو بدت","لبدر الدُجى في التّم ما كان يُبدرُ",35,"ر",1,0],["ولَّوا بهم ما بالقَنا من أَفكَلٍ","لكنَّ ذا خببٌ وذاكَ وثاقُ",36,"ق",1,0],["ولو أبصرتْ عيناهُ شَخْصَكَ مَرّةً","لأبصرَ منه شَمْسَهُ وهي غَيْهَبُ",37,"ب",1,0],["ولو أبصرت أنوار وجهك فارس","لأغناهم عن هرمزان وموبذ",38,"ذ",1,0],["وَلَو أَبو الطَيبِ الكوفي أُسمِعَها","لَقالَ لي قَول لاعيٍّ وَلا خطلِ",39,"ل",1,0],["وَلَو أَبصَرتَ غَنمَةً ذاتَ يَومٍ","وَقَد سَفَرَت وَأَحدَرَت اللِثاما",40,"م",2,0],["ولو ابصر الرآى مبادئ قصدها","لبانت له فيما يروى العواقب",41,"ب",1,0],["ولوأبعد وصار البعد عاده","لاتحسبني مع اشواقي شديده",42,"د",2,0],["ولو أبصرتُها طيفاً لراحتْ","عيوني في هوى طيفِ الخيالِ",43,"ل",1,0],["ولو ابصرت عيناك غمّى لأبصرت","ضبابة حزن غيمها ليس يقشع",44,"ع",1,0],["ولو أبت عزة عنها حميته","حزب الهدى بمغاوير الضلال فني",45,"ن",2,0],["وَلَوْ أَبْدَى لِعُذَّالِي مُحَيَّا","لأَدْهَشَهُمْ بِهِ أَمْرٌ مَرِيجُ",46,"ج",1,0],["[ وَلَوْ أَبْدَت الخَدَّيْنِ مِنْها لِعابِدٍ","لَخَرَّ لَها فَوْقَ الثَّرَى وَهوَ ساجِدُ ]",47,"د",1,0],["ولو أبصرت طفلا على ثدي أمه","لنحته باسم الحلف عنه لترضعا",48,"ع",2,0],["ولو أبصرت ما فيا","لكم مت بنيراني",49,"ن",2,0],["ولو أبطأتَ وِدَّاً بَعدَ حينٍ","فَفَضلُكَ مِنْْ عِيونِ الكُلِ يََهويْ",50,"و",2,0],["وَ لَوِ ابتَلَعتُكَ فِي عَمِيقِ قَرارَتِي","فَكَأَنَّنِي - فِيما ابتَلَعتُ - القُلزُمُ",51,"م",1,0]]}