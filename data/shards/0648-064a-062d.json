يحَ العَذولِ أَما يُبقي عَلى دَنِفٍ","طَوى الحَيازيمَ مِن وَجدٍ عَلى أَلَمِ",4,"م",1,0],["وَيَحذَرُ سُخْطِي مَن أَرابَكِ فِعلُهُ","وَإِن نالَهُ مِنكِ الرِّضى صِرتُ راضِيا",5,"ي",2,0],["وَيَحْلُبُ فينا العَيْشَ وُسْعَ إِنائِهِ","وَيُرْضِعُهُ دَرَّ النَّعيمِ ثَراءُ",6,"ا",2,0],["وَيَحمي ذِمارَ الجارِ كلُّ ابْنِ حُرَّةٍ","يَكادُ مِنَ الإكرامِ يُوْطِئُهُ خَدَّا",7,"د",2,0],["ويَحْكي السّرابُ إذا ما زَها","ظَعائِنَها البَحْرَ يزْهو السّفينا",8,"ن",2,0],["ويَحوطُها بيَراعِهِ وحُسامِهِ","متدَفِّقَيْنِ بنائِلٍ ومَنونِ",9,"ن",1,0],["وَيْحَ الهَوى كيفَ أصابَ لحْظُها","وقد أطاشَ أسْهُمي مَقاتِلي",10,"ل",2,0],["ويَحتَقِبونَ أعماراً قِصاراً","ويعتقِلونَ أرماحاً طِوالا",11,"ل",2,0],["ويحبو على ساعديّ","فأرضعه أدمعي",12,"ع",2,0],["وَيحَ المُحِبّينَ ما أَشقى جُدودَهُمُ","إِن كانَ مِثلُ الَّذي بي بِالمُحِبّينا",13,"ن",2,0],["وَيَحجُزُني مَن لا أَرى دونَ ما أَرى","شَهيدي عَلَيه عالَمُ السِرِّ وَالجَهرِ",14,"ر",1,0],["وَيَحزُنُ قَلبي سِرَّها وَيَصونُهُ","وَلَيسَ لَدَيها مِن حِفاظٍ وَلا شُكرِ",14,"ر",1,0],["وَيحَ هَذا الهَوى لَقَد مَلَكَ النا","سَ وَصارَت لَهُ عَلَيهِم بُنودُ",15,"د",1,0],["وَيحيا بِهِ قَومٌ أَصابوا هَواهُمُ","وَقَد صِرتُ فيهِم لا أَموتُ وَلا أَحيا",16,"ا",1,0],["وَيحَ قَيسٍ لَقَد تَضَمَّنَ مِنها","داءَ خَبلٍ فَالقَلبُ مِنهُ عَميدُ",17,"د",1,0],["ويُحْيي منَ التّوْحيدِ رسْماً يُعيدُهُ","لخَيْرِ اجْتِماعِ الشّمْلِ بعْدَ تبدُّدِ",18,"د",1,0],["ويحْتالُ أثْناءَ الذُّوابَةِ هازِئاً","كما اخْتالَ سيْفٌ في حَمائِلِ غِمْدِهِ",19,"د",2,0],["وَيَحْوِي النَّحْوَ لاَ بَلْ كُلَّ عِلْمٍ","وَيَرِوْي الشَّعْرَ مِنْ مَدْحٍ وَغِيبَهْ",20,"ب",2,0],["وَيُحطَم بِظُلمٍ لا يَزالُ يَرى لَهُ","مَصارِعَ مَظلومٍ مُجَرّاً وَمَسحَبا",21,"ب",2,0],["وَيَحمي الحَيَّ أَرعَنُ ذو دُروعٍ","مِنَ السُلافِ تَحسَبُهُ إِوانا",22,"ن",2,0],["وَيحَ مِصرٍ كُلَّ يَومٍ حادِثٌ","وَبَلاءٌ ما لَها مِنهُ مَفَر",23,"ر",1,0],["وَيَحُلُّ غامِضَها بِثاقِبِ ذِهنِهِ","حَلَّ الطَبيبِ عَناصِرَ الأَعشابِ",24,"ب",1,0],["وَيحَ مِصرٍ بَل فَوَيحاً لِلثَرى","إِنَّهُ أَبلَغُ حُزناً وَأَشَد",25,"د",1,0],["وَيحَ مِصرٍ فَأَيُّ خَيطِ رَجاءٍ","قَطَعَتهُ رَنّاتُ صَوتِ النَعِيِّ",26,"ي",1,0],["وَيحَ الكِنانَةِ ما لَها","في غَمرَةٍ لا تَنجَلي",27,"ي",1,0],["وَيحَكُم إِنَّ جاكَ أَسرَفَ حَتّى","زادَ في قَومِهِ عَلى داوودِ",28,"د",1,0],["وَيَحمِلُ عَنّي لِلعَزيزِ تَحِيَّةً","وَيَذكُرُ شَيئاً مِن حَديثي وَأَخباري",29,"ي",1,0],["وَيَحلفُ بِاللَهِ ما قَصدُهُ","نَوالاً وَلَكِنَّهُ يَكذِبُ",30,"ب",1,0],["وَيحَ أَعضايَ مِن زَواجِ النَصارى","بِسوى المَوتِ لا يُفَرَّجُ هَمّي",31,"ي",1,0],["وَيَحسَبُ نَسوانٌ لَهُنَّ وَسيلَةً","مِنَ الحُبِّ لا بَل حُبُّها كانَ أَقدَما",32,"م",2,0],["ويْحَ امْرِئٍ رَجَّاهُ مَوْ","طِنُهُ لِمَحْمَدَةٍ فَخَابَا",33,"ب",2,0],["وَيَحْتَضِن التُّرْبُ حَبَّ البِذَار","رِ فَيَرْجِعُهُ جَنَّةً زَاهِرَهْ",34,"ر",2,0],["وَيْحَ الفَقِيرَاتِ الجَمِيلاتِ مِنْ","حَبَائِلِ القَنَّاصَةِ المَاكِرَهْ",35,"ر",2,1],["وَيْحُ المَنِيَّةِ أَيُّ مُعْتَصِمٍ","مَدَّت إِلَى عَلْيَائِهِ يَدُهَا",36,"د",3,0],["وَيحَ الأَبِيِّ تَسُوءهُ أَيَّامُهُ","وَتَسُرُّ كُلَّ مُمَاذِقٍ مِذْعَانِ",37,"ن",1,0],["وَيحَ الأُولَى أكَلَ الْقِلَى أَكْبَادَهُمْ","مِنْ رَحْمَةٍ فِي ثَغْرِكَ المُتَبسِّمِ",38,"م",1,0],["وَيَحْسَبُ مَنْ يَرْنُو إِلَيْهِ وَدُونَهُ","أَرَقُّ غِشَاءٍ أَنَّهُ مُتَوَهِّمُ",39,"م",1,0],["وَيْحُ أَهْلِ التَّثْقِيفِ مِنْ بِيئةٍ","لِلْمَالِ فِيهَا غَيْرِهِ التَّعْظِيمُ",40,"م",1,0],["ويحفُّها وَرَقٌ يروقُ كأنّه","وَرَقُ النُّضار وقد أجاد نِبَالا",41,"ل",2,0],["ويحرس خدَّ الورد صارمُ نهرها","ويُمنع ثغر النّوْر بالذابل النضرِ",42,"ر",1,0],["ويح الفرات فلو كانت زواخره","تدري بعزمك لم تطفح على الطرق",43,"ق",1,0],["ويح شباب فتك الشيب به","إذ لاح كالسيف عليه منتضى",44,"ا",1,0],["ويح ابنتي أن ريب الدهر روّعها","بالفقر واليتم آها منهما آها",45,"ا",3,0],["ويح الذكاء فقد تأخرّ أهله","حتى تقدّم مَن قفاه عريض",46,"ض",1,0],["ويحلب شطرَيها العدوّ ضرائباً","ويمخضها درّاً كما يُمحض الزِق",47,"ق",1,0],["ويحسن في المسامع منه صوت","له تهتز بالطرب القلوب",48,"ب",1,0],["ويحمله الغاوي على غير وجهه","فيُوسعني شتماً وينظرني شزرا",49,"ر",2,0],["ويح العراق فيوم مقتل جعفر","فجع العراق بعزّة الأخيار",50,"ر",1,0],["وَيَحسَرُ مَن تَرَكتَ فَلَم تُكَلِّم","وَيُغبَطُ مَن تُراجِعُهُ الكَلاما",51,"م",2,0],["وَيُحمَدُ في العَضبِ البِلى وَهوَ قاطِعٌ","وَيَحسُنُ في الخَيلِ المُسَوَّمَةِ الضُمرُ",52,"ر",1,0],["ويحَ المعنى الذي أضرمتِ باطنه","ماذا يكابد من أهوالِ أهواء",53,"ا",2,0],["ويح العذول يرى ليلي ويسمعُ من","لا يسمعُ العذلَ فيها قولَ فحشاء",54,"ا",2,0],["ويحفظُ الدِّين بالعلمِ الذي اتَّضحت","ألفاظهُ فيه حفظَ الأفقِ بالشهب",55,"ب",1,0],["ويحمرُّ دمعي حين تصفرُّ وجنتي","فألبس ثوبَ الهمِّ وهو مشهَّر",56,"ر",1,0],["ويحق لي فيه التغزل باهراً","وثنا تقيّ الدّين عندي أبهر",57,"ر",1,0],["ويحثو تراب السبق في وجهِ عاشق","أراه غباري ثم قال له الحق",58,"ق",1,0],["ويحثُّني داعي الهوى فبحقِّه","يا سع عرِّج بي على الوادي النقا",59,"ق",2,0],["ويح صبّ يخفي بكمّيه دمعاً","وهو كالزهر لاح في أكمامه",60,"م",2,0],["ويحي من الحظِّ كم أحاوله","في دهرِنا وهو حائدٌ عنِّي",61,"ي",1,1],["ويحتجبُ الضياءُ إذا سقانا","وما ضوءٌ بجودك ذو احتجابِ",62,"ب",1,0],["ويحَ ابنِ يوسفَ ليت الويحَ عاجَلَهُ","فما يُدانيه في بلواهُ أيوبُ",63,"ب",1,0],["ويح القوافي ما لها سَفْسَفتْ","حَظِّي كأَنِّي كنتُ سَفْسَفْتُها",64,"ت",3,0],["ويحلفنَ لا ينقُضنَ في ذات بيننا","على الدهر معهوداً وهنَّ حوانثُ",65,"ث",1,0],["ويُحيِّيِ جليسَه","بِفُسَاءٍ له رهَجْ",66,"ج",1,0],["ويح عيني ساء من نظرتْ","ويح قلبي ساء ما اعتقدا",67,"د",2,0],["ويح الطبيب الذي جسَّتْ يداه يدك","ما كان أشجعَه فيما به اعتمدَكْ",68,"ك",1,1],["ويحبوك بالعمر الطويل مُتابعاً","لك الرِّفْدَ والمبْتزُّ إن شاء رافدُ",69,"د",1,0],["ويحجب مثلي مستطيلاً بعزكم","وإمدادِكم إياه بالجاه والوفر",70,"ر",1,0],["ويُحابون من يسمى بعمرو","فتفقَّدْ ما قلتُ في كل عصر",71,"ر",1,0],["ويحك ما أسخاك من لابسٍ","أكل ما تلبسه تخلع",72,"ع",1,0],["ويح ابن أيوب لقد فاته","منها السماع اللَّذُ والصنعه",73,"ع",2,0],["ويحيَ كم تعذب لي جرعة","منه وكم تملُحُ لي جرعه",73,"ع",2,0],["ويحَ نفسي وما لراجيك ويحٌ","أتُراها بسيفها مقتولهْ",74,"ل",2,0],["ويحَ أعدائها أذلك منها","فرطُ حشدٍ لحاسرٍ مِعزالِ",75,"ل",1,0],["ويحسدنيه الحاسدون فموضعي","به منهمُ مَقذاةُ عينٍ ومَرغَمُ",76,"م",1,0],["ويحُلُّ في عَلْيا مَراتِب ودِّكُمْ","وخصوصِكُمْ حتى يُقالَ حميمُ",77,"م",1,0],["ويحزُنُني طوراً وطوراً يسُرُّني","مغانمُهُ طوراً وطوراً مغارمُهْ",78,"م",2,0],["وَيْحَ هذا القلب ما أَغفله","أيها المولى وأحلى وَسَنه",79,"ن",2,0],["ويح هاتيكَ الرعايا","فلقد أمسَتْ سبايا",80,"ا",3,0],["وَيَحُلُّ أَهلي بِالمكانِ فَلا أَرى","طَرفي بِغَيرِكِ مَرَّةً يَتَقَلَّبُ",81,"ب",1,0],["وَيحَ قَومي قَد أَطمَعَ الدَهرُ فيهِم","كُلَّ قَومٍ حَتّى بَني السَوداءِ",82,"ا",2,0],["وَيحَ هَذي الطُيورِ تَجني عَلى المَو","تى وَتَرجو سِلماً مِنَ الأَحياءِ",83,"ا",2,0],["وَيَحسَبُ مِهرَجانَ الناسِ مَأتَم","بِلا خَمر وَجَنَّتُهُم جَهَنَّم",84,"م",1,0],["وَيحَكِ لا في عُزلَتي تَطرَبين","وَلا إِذا كُنتُ مَعَ الناسِ",85,"س",1,0],["وَيَحسَبُ الأَرضَ قَد مادَت مَناكِبُها","كَذاكَ يَمسَخُ عَينَ الخائِفِ الوَجَلُ",86,"ل",1,0],["وَيحَ المَدائِنِ إِنَّ ساكِنَها","كَالمَيتِ لَم يُطمَر وَلا دُفِنا",87,"ن",2,0],["وَيَحِلُّ اللَهُ في ماءٍ وَطين","فَيَراهُ الشَيخُ والشابُ الأَحيَء",88,"ي",2,0],["وَيَحسُنُ قُبحُ الفِعلِ إِن جاءَ مِنكُمُ","كَما طابَ ريحُ العودِ وَهوَ دُخانُ",89,"ن",1,0],["وَيحَ صَبٍّ في مَحَبَّتِكُم","كَثُرَت فيهِ الأَقاويلُ",90,"ل",1,0],["وَيحَكَ يا قَلبُ أَما قُلتُ لَكَ","إِيّاكَ أَن تَهلِكَ في مَن هَلَك",91,"ك",1,1],["وَيحَ الشَقِيُّ إِلى مَتى","بِالفِسقِ مَعمورُ العِراصِ",92,"ص",1,1],["وَيحَ الكِنانَةِ كَيفَ تَلعَبُ أُمَّةٌ","شَمطاءُ واهِنَةٌ وَشَعبٌ أَشيَبُ",93,"ب",1,0],["وَيُحرَمُ الرِزقَ ذو المَطِيَّةِ وَال","رَحلِ وَمَن لا يَزالُ مُغتَرِبا",94,"ب",2,0],["ويِح الحَيَاة أَما تَنْ","قَضي لَدَيْها الرَّزايا",95,"ي",2,0],["ويحفظ الاخلاق ان","تمسها يد العطب",96,"ب",1,0],["ويح هذي الخراف ماذا تلاقي","من ذئاب بين الحضيرة طلس",97,"س",1,0],["ويحسب قوم في التعصب رشدهم","وما اخر الاقوام غير التعصب",98,"ب",1,0],["ويحي لممحوض العلاقة يزدري","ويحي لمعروض الوداد يضيَّع",99,"ع",1,0],["ويح المواطن إنها لبست بهم","ثوب الخراب فما بها عمران",100,"ن",1,0],["ويحظى عماد الدين منا بجنة","وكان الذي قد جاءه كله نكرا",101,"ر",2,0],["ويح نفسي فقد سلكت طريقاً","ليس فيه إلى الحقيقة هادي",102,"ي",1,0],["ويح نفسي من روع يوم التقاضي","ويح نفسي من هول يوم التنادي",102,"ي",1,0],["ويحلو لها النوم فوق الشريط","وتحلو لها في الطريق الولادة",103,"د",2,0],["وَيحٌ لَهُ وَيحٌ لِهَ","ذا الوَلدِ المُعَذَّبِ",104,"ب",1,0],["وَيُحلي البِحارَ بِلَألائِهِ","فَمِنّا الكُؤوسُ وَمِنهُ الحَبَب",105,"ب",1,0],["وَيْحَ ابنِ جَنْبي ؟ كلُّ غايةِ لذَّةٍ","بعدَ الشبابِ عزيزةُ الإدراكِ",106,"ك",1,0],["وَيحَ الشَبابِ وَقَد تَخَطَّرَ بَينَهُم","هَل مُتِّعوا بِتَمَسُّحٍ وَطَوافِ",107,"ف",1,0],["وَيحَها كَم تَزَيَّنَت لِعَليمٍ","واحِدِ الدَهرِ وَاِستَعدَت لِخَمسِ",108,"س",1,0],["وَيَحُثُّهُ بِاِسمِ الكِتابِ أَقِسَّةٌ","نَشَطوا لِما هُوَ في الكِتابِ حَرامُ",109,"م",1,0],["وَيُحجَبُ رَبُّ العيدِ ساعَةَ عيدِهِ","وَتَنقُصُ مِن أَطرافِهِنَّ مَآرِبُه",110,"ب",2,0],["وَيُحذى عَرانينَ المُلوكِ وَإِنَّها","لِمَن قَدَمَيهِ في أَجَلِّ المَراتِبِ",111,"ب",1,0],["وَيَحتَقِرُ الحُسّادَ عَن ذِكرِهِ لَهُم","كَأَنَّهُمُ في الخَلقِ ما خُلِقوا بَعدُ",112,"د",1,0],["ويحرق الجسم الذي قد عتا","على لهيب النار واستكبروا",113,"ر",3,0],["ويحك هذا رمز أسرارنا","يحار فيها الجن والإنسُ",114,"س",1,0],["وَيُحزِنُني أَن تَعرِفي الحُبَّ بِالجَوى","وَإِن نَفَعَتنا مِنكِ مَعرِفَةُ الحُبِّ",115,"ب",1,0],["وَيُحجَبُ عَنكُم عَبدُهُ وَهوَ بارِزٌ","تُناجونَهُ بِالعَينِ مِن غَيرِ حاجِبِ",116,"ب",1,0],["وَيَحُلُّ مِن دونِ القُلوبِ إِذا غَدا","مُتَكَرِّماً وَكَأَنَّهُ مُتَوَدِّدُ",117,"د",1,0],["وَيَحمِلُ إِسماعيلُ عَنّا اِبنَ بُلبُلٍ","مِنَ المَحلِ عِبئاً لَيسَ يَحمِلُهُ القَطرُ",118,"ر",1,0],["وَيَحمى الهَجرُ في الأَحشاءِ حَرّاً","وَإيقاداً كَما يحمى الهَجيرُ",119,"ر",1,0],["وَيَحفَظُ المُلكَ بِإِشرافِهِ","عَلى نَواحيهِ وَإِطلالِهِ",120,"ل",2,0],["وَيَحكُمُ في ذَخائِرِهِ نَداهُ","كَما حَكَمَ العَزيزُ عَلى الذَليلِ",121,"ل",1,0],["وَيحَهُ لِيَقولُ ما يُفسِدُ الذِه","نَ وَيُري بِالفَهمِ وَالتَحصيلِ",122,"ل",1,0],["وَيَحسُنُ دَلُّها وَالمَوتُ فيهِ","وَقَد يُستَحسَنُ السَيفُ الصَقيلُ",123,"ل",1,0],["وَيُحجِمُ أَحياناً عَنِ الجودِ بَعضُ مِن","تَراهُ عَلى مَكروهَةِ السَيفِ يُقدِمُ",124,"م",1,0],["وَيَحزُنُكَ اللُوّامُ لَستُ أُطيعُهُم","وَقَولٌ مِنَ الواشينَ لَستُ أَعيهِ",125,"ي",2,0],["وَيَحسَبُها باتَت حَصاناً وَقَد جَرَت","لَنا بُرَتاها بِالَّذي أَنا شاكِرُه",126,"ر",2,0],["ويحمل ماء كحمل السحاب","وليس يجود بغير الهواء",127,"ا",2,0],["ويَحُثُّها حَثَّ الحُدا","ةِ شَواردَ الكُومِ العَقائِل",128,"ل",1,0],["وَيُحييكَ ما يُفنيكَ في كُلِّ حالَةٍ","وَيَحدوكَ حادٍ ما يُريدُ بِكَ الهَزءا",129,"ز",3,0],["وَيحَ عُقولِ المُستَعصِمينَ بِدا","رِ الذُلِّ في أَيِّ مَنشَبٍ نَشِبَت",130,"ت",1,0],["وَيحَ اِبنَ آدَمَ كَيفَ تَرقُدُ عَينُهُ","عَن رَبِّهِ وَلَعَلَّهُ غَضبانُ",131,"ن",1,0],["وَيحَ اِبنِ آدَمَ كَيفَ تَغفُلُ نَفسُهُ","وَلَهُ بِيَومِ حِسابِهِ اِستيقانُ",131,"ن",1,0],["وَيحَ نَفسي إِنّي أَراني بِدُنيا","يَ ضَنيناً وَلا أَضِنُّ بِديني",132,"ن",2,0],["وَيَحسَبُ الأَرضَ تَشكو ثِقلَ مَشيَتِهِ","كَأَنَّ رَبَّكَ لَم يَخلُق لِخَشيَتِهِ",133,"ه",1,0],["ويحَ المآبِ إلى مكانٍ موحش","متجهمِ العرصات مقفرِ ساحِ",134,"ح",1,0],["ويحَ الحياةِ اليومَ أين جمالُهَا","وعلامَ إخفاقي بها ونجاحي",134,"ي",1,0],["ويحسُّ تبريحَ الصبابة واصفاً","مجنونَ ليلى في سحيق قفارِ",135,"ر",1,0],["ويحَ الذكاءِ وما يُكل","لِفه من الثَّمنِ الذَّكاء",136,"ا",2,0],["ويح دَمعي وويح ذلة نفسي","لَم تدع لي أحداثه كبرياءَ",137,"ا",2,0],["ويحَ الحنين وما يجرعني","من مُرِّه ويبيت يسقيني",138,"ي",1,0],["ويحي على كفك البيضاء إذ بسطت","عند السلام وويحي حين تنطبق",139,"ق",1,0],["ويحها لم تدر ماذا حطمت","حطمت تاجي وهدت معبدي",140,"ي",1,0],["وَيحَ وِشاحَيكِ فَما أَصبَحا","صِفْرَيْنِ إِلّا حَسدَا دُمْلجيك",141,"ك",1,0],["ويحملُ دمعُ العين عن قلبيَ الأسى","ولكنه يبدي هوايَ الذي أُخْفي",142,"ي",1,0],["وَيحَكَ لو كنتَ وفيّاً لم تَقلْ","ويحكَ لا تبكِ برَسْمٍ بلقعِ",143,"ع",1,0],["ويَحتَالُ مِن أَهلِ القَريضِ مُصَرِّفٌ","يُهَادي القوافي في امتداحك قُرّحا",144,"ح",2,0],["وَيح قلبٍ ضاقَ من أسهمها","عن جراحٍ وقعها فوق جراح",145,"ح",1,0],["وَيَحسُبُ ما يُفيدُ بِلا عَطاءٍ","وَتُعطي ما تُفيدُ بِلا حِسابِ",146,"ب",1,0],["وَيَحلَمُ لاعَن ذِلَّةٍ وَلَرُبَّما","سَطا أَسَدٌ مِنهُ وَأَطرَقَ أَسوَدُ",147,"د",1,0],["وَيَحمِلُ ثَوبُكَ خَطَّيَّهُ","وَيَنطِقُ عَنكَ لِسانُ الحُسامِ",148,"م",1,0],["وَيَحطِمُهُ مابَينَ دِرعٍ وَمِغفَرٍ","وَإِن كانَ عَضبَ الشَفرَتَينِ يَمانِيا",149,"ي",2,0],["وَيحِي أأنتَ انْشقَّ قَبرُك وانْقَضى","عَبَثُ الخُطوبِ ورأيُها المأفونُ",150,"ن",1,0],["وَيْحَ مِصرٍ هَلْ تَرى فيها سِوَى","أُمةٍ تُؤذَى وشَعبٍ يُنْكَبُ",151,"ب",1,0],["ويح الأُلى ضلّوا السبيل أمالهم","من ناصحٍ أو مُرشدٍ أو هادِ",152,"د",1,0],["ويحي أما تَزَعُ النفوسَ عن الهوى","عِبَرٌ تمرُّ كِبارُها وعِظاتُ",153,"ت",1,0],["ويحَ الكِنانةِ لا استقلالُها صَدقتْ","فيه الظُّنونُ ولا دُستورُها نَفَعا",154,"ع",2,0],["ويُحمَد كلُّ مُختلفِ المساعي","إلى الأقوامِ جيّاءٍ ذَهوبِ",155,"ب",1,0],["وَيْحُ النبيِّ أما يُباع رُفاتُه","بِسوَى لباسٍ لابنهِ وطعامِ",156,"م",1,0],["وَيْحَ العقولِ رُمينا من غَباوتها","بدولةٍ من بقايا الوهمِ والزُّورِ",157,"ر",1,0],["وَيحَ الكِنانَةِ جَدَّ الهادِمونَ بِها","فَما تَرى العَينُ فيها غَيرَ أَطلالِ",158,"ل",1,0],["وَيحَ نَفسي وَيحَ مِصرٍ كُلَّما","ذَكَرَت مِصرُ بَنيها الهالِكينْ",159,"ن",1,0],["وَيحَ الَّتي أَكَلَ النُسورُ وَليدَها","وَمَضَت مُحَلِّقَةً بِكُلِّ مَطارِ",160,"ر",1,0],["وَيحَ العِراقِ وَقَومٍ بِالعِراقِ عَلا","ضَجيجُهُم وَتَمادى مِنهُمُ الصَخَبُ",161,"ب",1,0],["وَيحَ المَعارِفِ وَالفُنونِ فَإِنَّهُم","جَعَلوا الشُرورَ مَعارِفاً وَفُنونا",162,"ن",2,0],["وَيحَ الأُلى زَعَموا الحُروبَ دُعابَةً","ما غَرَّهُم بِالتُركِ وَالأَلمانِ",163,"ن",1,0],["وَيحَ الَّتي فَزِعَت إِلَيَّ تَهيجُني","ماذا تُريدُ إِلى الكَمِيِّ الأَجذَمِ",164,"م",1,0],["وَيحَ الضُلوعِ أَما تُشفى لَواعِجُها","وَيحَ القُلوبِ أَما تُروى صَواديها",165,"ي",3,0],["وَيحَ النَوائِبِ وَالأَرزاءِ ما فَعَلَت","بِأُمَّةٍ أَخذَتها مِن نَواصيها",165,"ي",3,0],["وَيحَ العُهودِ أَصابَ الخَسفَ ذاكِرُها","وَآبَ بِالبِرِّ وَالإِكرامِ ناسيها",165,"ي",3,0],["وَيحَ الكِنانَةِ خانَت عَهدَها فِئَةٌ","بِالمُخزِياتِ حَياءٌ مِن مَآتيها",165,"ي",3,0],["وَيحَ الكنانَةِ أَمسَت مِن تَفَرُّقِهِم","حَيرى الرَجاءِ فَما تَدري بِمَن تَثِقُ",166,"ق",1,0],["وَيحَ البِلادِ أَما يَقومُ بِنَصرِها","حِزبٌ يُقامُ لَهُم وَوَفدٌ يوفَدُ",167,"د",1,0],["وَيحَ العُيونِ أَيَغشاها النُعاسُ وَقَد","شَفَّ الهِلالَ عَلَيها الحُزنُ وَالسَهَرُ",168,"ر",1,0],["وَيحَ الحَجيجِ إِذا حانَت مَناسِكُهُم","ماذا يَرى طائِفٌ مِنهُم وَمُعتَمِرُ",168,"ر",1,0],["وَيَحيا حَياةَ البائِسينَ وَيَحتَقِب","مِنَ العارِ ما يَبقى لَهُ الدَهر مَيسِما",169,"م",2,0],["وَيحَ قَومي غَرَّهُم إِذ هَلَكوا","رَونَقُ القَبرِ وَحُسنُ الكَفَنِ",170,"ن",1,0],["وَيحي عَلى الإِسلامِ هان وَزَلزَلَت","أَيدي الخُطوبِ شُعوبَه فَاستُضعِفوا",171,"ف",3,0],["وَيحَهمُ ماذا عليهم لو رَضُوْا","شِرْعَةَ اللهِ ودينَ الحُنَفَاءْ",172,"ا",2,0],["وَيْحَ ذِي القَصَّةِ ماذا يَشْهَدُ","وَيْحَهُ من وَقْعَةٍ لا تُحمدُ",173,"د",1,1],["وَيْحَ الثلاثةِ إنّهم مما لَقُوا","لأَشدُّ خَطباً في الرجالِ وأعظمُ",174,"م",1,0],["وَيحَ النِّساءِ وَمَن وَلَدْنَ ألا فَتىً","يَحمِي الذّمارَ ألا كَمِيٌّ مِحرَبُ",175,"ب",1,0],["ويَحمدُ فالِقَ الإصباحِ حَمْداً","يَهُزُّ جَوَانِحَ الوادي الطَّرُوبِ",176,"ب",1,0],["وَيَحْكُمُ حُكْمَهُ عَدْلاً وَبِرّاً","فَيُلقِي بالدّواءِ إلى الطبيبِ",176,"ب",1,0],["وَيحَ أسماءَ إذ يجيءُ أبو جه","لٍ عَلَى خدرها المصون مغيرا",177,"ر",2,0],["وَيحُ قَومٍ خَذَلوه بَعدَما","أَخَذوا الميثاقَ أَلّا يُخذَلا",178,"ل",2,0],["وَيحَهُم لَو يَرون ما صَنَعَ الده","ر لَقالوا معذب مَشئوم",179,"م",1,0],["وَيُحدِثُ قَلبي كُلَّ يَومٍ شَفاعَةً","لَهُنَّ وَمالي عِندَهُنَّ شَفيعُ",180,"ع",1,0],["وَيَحلِفُ حَلفَةً لِبَني بَنيهِ","لَأَمسَوا مُعطِشينَ وَهُم رِواءُ",181,"ا",2,0],["وَيَحرُمُ سِرُّ جارَتِهِم عَلَيهِم","وَيَأكُلُ جارُهُم أُنُفَ القِصاعِ",182,"ع",1,0],["وَيَحُثُّني بِالكَأسِ سا","قٍ لَحظُ مُقلَتِهِ سَقيمُ",183,"م",1,0],["وَيحَ دارِ المُلكِ الَّتي تَنفَحُ المِس","كَ إِذا ما جَرى عَليها النَسيمُ",184,"م",1,0],["وَيحَ نَفسي مِن حَبيبٍ","ناقِضِ العَهدِ مَلولِ",185,"ل",1,0],["وَيحَ المُتَيَّمِ وَيحَهُ ماذا عَلى","عُذّالِهِ مِن ذَنبِهِ أَو عارِه",186,"ر",2,0],["وَيحَ مَن يَهوى فَقَد عَذَّبَهُ ال","لَهُ في الدُنيا بِتَبعيدٍ شَديدِ",187,"د",1,0],["وَيَحُثُّني حَدَقُ المَها","وَلَقَد جَحَدنَ عِداتي",188,"ت",2,0],["وَيحَ القُلوبِ مِنَ العُيونِ لَقَد","قامَت قِيامَتُهُنَّ في الدُنيا",189,"ا",1,0],["ويْحَ قومٍ جَفَوا نَبِيَّاً بأرضٍ","أَلِفَتْهُ ضِبَابُها والظِّبَاءُ",190,"ا",2,0],["وَيْحَ مَنْ يَطْلُبُ مِنْ وَجْنَتَيَّ ال","وردَ أوْ مِنْ شَفَتَيَّ الشَّرابا",191,"ب",2,0],["وَيَحْمِلَ كَلَّ المُلْكِ عنه وإصْرَهُ","حَرِيٌّ بِتَدْبيرِ الأُمورِ جَدِيرُ",192,"ر",1,0],["ويَحُجُّهُ أصحابُ رَيْعٍ عِنْدَهُ","ويُقَدِّمُوهُ فَيُظْهِرُ التَّعْبيسا",193,"س",2,0],["وَيْحَه إذ أطاعَه جِيدُ ظبيٍ","ولِواءٌ إلى الهوى مُنْصات",194,"ت",1,0],["وَيَحِقُّ لي إِذ صِرتُ بَينَكُما","لا يَحِلَّ بِساحَتي فَقرُ",195,"ر",1,0],["وَيَحمِلُ الوَطبَ وَالعِلابَ وَلا","يَصلُحُ إِلّا لِحَملِ إِبريقِ",196,"ق",1,0],["وَيحُ ثَقيفٍ ماذا يَضُرُّهُمُ","إِن كانَ لي في دِيارِهِم سَكَنُ",197,"ن",1,0],["وَيَحكي البَدرَ وَقتَ التَم","مِ لِلأَعيُنِ خَدّاهُ",198,"ا",2,0],["ويحُها يسطعُ منها","فائحاً من رأس ميل",199,"ل",1,0],["وَيحَها كاعِباً تَدِلُّ بِجَهمٍ","كَعثَبِيٍّ كَأَنَّهُ حَمّامُ",200,"م",1,0],["وَيحَ نَفسي أَمِن دَلالِ فَتاةٍ","راحَ هَمّي وَخَفَّ عَنّي الهُجودُ",201,"د",1,0],["وَيحَ نَفسي أَكُلَّما دَبَّ واشٍ","بِحَديثٍ وَثَبتِ لِلهَجرِ وَثبا",202,"ب",2,0],["وَيُحمَلُ مِن أَرضٍ لِأُخرى وَما دَرى","فَواهاً لَهُ بَعدَ البِلى يَتَغَرَّبُ",203,"ب",1,0],["وَيُحمَدُ الصابِرُ الموفي عَلى غَرَضٍ","لا عاجِزٌ بِعُرى التَقصيرِ مَعقودُ",204,"د",1,0],["وَيَحقِرونَ أَخا الإِعدامِ بَينَهُمُ","وَإِنَّ أَفضَلَ مِنهُم لِلَّذي اِحتَقَروا",205,"ر",3,0],["وَيَحوي الفَتى بِالجَدِّ مالَ عَدُوِّهِ","عَلى رُغمِهِ مِن غَيرِ حِرصٍ وَلا مَكرِ",206,"ر",1,0],["وَيَحمِلُ الهَمَّ قَلبي مُعفِياً جَسَدي","رَأسي أَحَمُّ وَظَهري غَيرُ مُنأَطِرِ",207,"ر",1,0],["وَيُحبَسُ في جَدَثٍ ضَيِّقٍ","وَلَيسَ بِمُطلِقِهِ الحابِسُ",208,"س",1,0],["وَيحَ شَمّاءَ لِلثَرى","شَمَمُ الأَنفِ وَالذَلَف",209,"ف",1,0],["وَيحٌ لِجيلِيَ وَالأَجيالِ إِن بُعِثوا","إِلى حِسابِ قَديمِ اللُطفِ عَلّامِ",210,"م",1,0],["وَيُحمَدُ المَرءُ في الساعينَ مُبتَكِراً","وَلَيسَ يُحمَدُ يَوماً في المُساعينا",211,"ن",2,0],["وَيَحسَبُ بَعضُنا أَن قد أَتاهُ","نَعيمٌ وَهوَ لَو يَدري شَقِيُّ",212,"ق",2,0],["ويحِقّ في رُزْءِ الحسين تغيّرُ ال","حَرَسَينِ بَلْهَ الدُّرَّ في الأصْدافِ",213,"ف",1,0],["وَيَحبو الخَليلَ بِخَيرِ الحِب","ءِ غَيرَ مُكِبٍّ وَلا قاطِبِ",214,"ب",1,0],["ويحدث عندي ذكر ليلى صبابةً","فماذا ترى لي محدثاً عندها ذكري",215,"ر",2,0],["وَيحزنني أني عَن الدار نازح","عَلى أَن بعد الدار خير من القرب",216,"ب",1,0],["وَيح العنادِل إنها قد أعولت","في جنة الآداب بعد هتاف",217,"ف",1,0],["ويحهم قد شيّعوا أعيادهم","بين عصف النار أو قصف الحديد",218,"د",1,0],["ويحنو الصباحُ على ثغرِها","وقد جُنَّ شوقاً إلى لثمِها",219,"ه",2,0],["ويحدو العذارى إلى دارهنَّ","حَيِيَّ الخطى موسويَّ القدمْ",219,"م",1,0],["ويحلُمُ بالفِدَى طفلٌ فطيمٌ","وكلُّ رضيعةٍ في المهدِ تحْبو",220,"ب",2,0],["ويحطم القلمُ العاني بحومتها","أصفادهُ ويفكُّ القيدَ ضرغامُ",221,"م",1,0],["وَيَحسَبُ نِسوانٌ مِنَ الجَهلِ أَنَّني","إِذا جِئتُ إِيّاهُنَّ كُنتُ أُريدُ",222,"د",1,0],["ويحك لا تمنن عَلَى منعم","عليه فالخالق رب المنن",223,"ن",1,1],["ويحهموا ما لهموا وما له","طاب وطيّب الحلال ماله",224,"ه",1,0],["ويح عيني ما أرى","قيس: ليلى خذ الحذر!",225,"ر",1,0],["ويْح الكِتابَة مِن شَيْخٍ هَبنَّقَةٍ","يلْقَى العُيُون برأَسٍ مُخْهُ رارُ",226,"ر",1,1],["وَيَحمِلُ عُدَّتي فَرَسٌ كَريمٌ","أُقَدِّمُهُ إِذا كَثُرَ الدَواعي",227,"ي",1,0],["وَيحَ هَذا الزَمانِ كَيفَ رَماني","بِسِهامٍ صابَت صَميمَ فُؤادي",228,"ي",1,0],["وَيحَ أمِّ دارٍ حَلَلنا بِها","بَينَ الثَّوِيَّةِ والمَردَمَه",229,"م",2,1],["وَيْحَ قَلْبِي مِنْ غَرِيمٍ مَاطِلٍ","كُلَّمَا جَدَّدَ وَعْدَاً أَفَكَا",230,"ك",2,0],["وَيُحْمَدُ فِي الشَّوْطِ تَبْرِيزُهُمْ","إِذَا مَا جَلا نَقْعُهُ عَنْهُمُ",231,"م",1,0],["وَيُحَيِّي حَجِيجَهُ العِزَّةُ","القَعْساءُ فِي هَبْيَةٍ وَفِي إِطْرَاقِ",232,"ق",1,0],["وَيْحَهُمْ مَا مَصِيرُهُمْ فَهُمُ اليَوْ","مَ وَلاَ عُوْنَ غَيْرُ لُطْفِ القَضَاءِ",233,"ا",2,0],["وَيْحَ تِلْكَ الْقِطَعِ الصَّفْرَاءِ فِي","صَوْتِهَا حِسُّ جِرَاحٍ وَحُرُوقِ",234,"ق",1,0],["وَيْحَ قَلْبِي طَال الثَّواءُ وَحوْلِي","دائِرَاتٌ عَلى الرِّفَاقِ تَدُورُ",235,"ر",1,0],["وَيَحْيَا الرَّئِيسُ البَاذِخُ القدْرِ إِنهُ","لعَهْدٍ جَدِيدٍ فِي المَفاخرِ يُذْخَر",236,"ر",1,0],["وَيْحَ أُمِّ اللُّغاتِ مِمَّا دَهَاهَا","فِي طرِيفِ الفخارِ بَعْدَ التِّلاَد",237,"د",1,0],["وَيُحِبُّ الحَيَاةَ مَلأَى عُهوداً","كُلُّ أَسْبابِهَا بَوَاعِثُ فَخْرِ",238,"ر",1,0],["وَيْحَ رُوما تَزْدَهِي ذَاكِيَةً","وَعُيونُ الليْلِ بِالرحْمَةِ شَكْرَى",239,"ر",2,0],["وَيْحَ لُبْنَانَ مَا دَهَى العِزَّةَ الْقَعْ","سَاءَ مِنْهُ فِي رُكنِهَا المَهْدُودِ",240,"د",1,0],["وَيَحْرِصُ أَلاَّ يُغْمَطَ الفَضْلُ حَقَّهُ","وَيُعْدَمَ بَيْنَ العَالَمِينَ جَزَاءَ",241,"ا",2,0],["ويَحْيَا في كُلِّ قَوْمٍ وَيَلْقَى","حَيْثُ حَلَّ التَّأْهِيلَ وَالتِّرْحَابَا",242,"ب",2,0],["وَيَحبو الخَليلَ بِخَيرِ الحِبا","ءِ غَيرَ مُكِبٍّ وَلا قاطِبِ",243,"ب",1,0],["ويحٌ لأَمْرٍ قد أَتاني رَائعٍ","هدَّ الجبَالَ فانقَضَتْ بِرُجُوفِ",244,"ف",1,0],["ويح المحب اذا تملكه الهوى","نمًت به عينان فاضحتان",245,"ن",1,0],["ويح الفقير فما تراه يلاقي","سُدّت عليه منافذُ الأرزاق",246,"ق",1,1],["ويحَ هذي العقول لم تُصِبِ","الرمية يوما إلا لتخطىء عشرا",247,"ر",2,0],["ويح لبنان كلما ذر نجم","فيه ولى عن أفقه وأنارا",248,"ر",2,0],["وَيحفَظ حينَ يُملَأُ لَو","حُهُ وَالخَطُّ مُندَمِجُ",249,"ج",1,0],["وَيَحنو عَلَيهِ المَجدُ مِمّا سَما لَهُ","وَيَعنو لَهُ الضّرغامُ مِمّا تَنَجَّذا",250,"ذ",2,0],["وَيَحِلُّ ما عَقَدَ الكَهول بِرَأيِهِ","وَيُصيبُ مَعنى الشَيء حينَ يَقيسُ",251,"س",1,0],["وَيح عَيني سُلِبَت قُرَّتها","وَخَبا نيّرُها لَمّا اِئتَلَق",252,"ق",1,0],["وَيحَ المَنايا أَثكَلَت","كِرامَ فِهرٍ نَفَرَك",253,"ك",1,0],["وَيحَهُمُ أَلَم يَرَوا","أَيَّ مُصابٍ وَقَذا",254,"ذ",2,0],["ويحسَبُ تَحنانَ الغديرِ هَديلَه","فيحبِسُ من زَفْراتِهِ ثم يَسْمع",255,"ع",1,0],["ويحَ هذا الكِرْوانِ هل راقه الحب","سُ وأغراه عسجدُ القضبان",256,"ن",1,0],["وَيُحِبُّ السَّوَادَ مِنْ عَيْنِ شَمْسٍ","مَالِئاً مِنْ رُوَائِهِ أَجْفَانَه",257,"ن",2,0],["ويحَ الكنانةِ بعد نزعِ شِغافِها","أتعيشُ في الدنيا بِغير شِغافِ",258,"ف",1,0],["ويح نفسي أفدي الشبابَ بنفسي","وجديرٌ بمثلهِ أن يُفَدَّى",259,"د",2,0],["ويحَها أين سِحْرها أين صارت","أين ولَّى جمالُها أين نَدّا",259,"د",2,0],["ويحي على خافقٍ في الصدر محتبسٍ","يكاد يطفر شوْقاً حين تسرينا",260,"ن",2,0],["ويح نفسي ما للعواصف تخبو","ويفت الخذلان في ساعديّا",261,"ي",2,0],["ويح السوائم، كم رعت","في مصر من زهر الأقاح",262,"ح",1,0],["ويحي على رفقائه","من قاتلِ هربوا لقاتل",263,"ل",1,0