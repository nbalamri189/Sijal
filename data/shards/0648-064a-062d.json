ي",2,0],["وَيُحْرَمُ الرِّزْقَ ذُو الْمَطِيَّة ِ وَالرْ","رَحْلِ وَمَنْ لاَ يَزَالُ مُغْتَرِبا",287,"ب",2,0],["ويح عيني ساء ما نظرتْ","ويح قلبي ساء ما اعتقدا",288,"د",2,0],["ويح نفسي فإنها ستلاقي","بغتة حتفها فما أشقاها",289,"ه",2,0],["ويحيَى لَعاديّة ُ المنتمى","إذا سألوا من فتى ً قيلَ ذا",290,"ا",1,0],["ويحطمْ بظلمٍ لا يزالُ لهُ","مصارعَ مظلومٍ، مجرّاً ومسحبا",291,"ب",2,0],["وَيحَ عَمرِو بنِ عَدِيٍّ مِن رَجُل","خانَ يَوماً بَعدَ ما قيلَ كَمَل",292,"ل",1,1],["ويح الفرات فلو كانت زواخره","تدري بعزمك لك تطفح على الطرق",293,"ق",1,0],["ويحَ أمي وَ ويحها لقتيلٍ","مِنْ بَنِي تَغْلِبٍ وَوَيْحاً وَوَاحَا",294,"ح",2,0]]}