{"poems":[[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[95,"اسمع شكاتي فهي إن لم تفد","https://www.aldiwan.net/poem11090.html","السريع"],[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[97,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[93,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[58,"احل وامرر معا ولن تارة واخشن","https://www.aldiwan.net/poem58528.html","البسيط"],[104,"في ثنايا العجاج","https://www.aldiwan.net/poem32914.html","المتدارك"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[79,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[128,"أين جمشيد ابن كايو كباد","https://www.aldiwan.net/poem23713.html","الخفيف"],[234,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[303,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[438,"أي نجم من أي شمس وبدر","https://www.aldiwan.net/poem12370.html","الخفيف"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[575,"أينجو بنو بدر بمقتل مالك","https://www.aldiwan.net/poem59464.html","الطويل"],[580,"أي نجل بل أي نجم سعيد","https://www.aldiwan.net/poem2995.html","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133852","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201724","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53097","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105010","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100310","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48328","الدوبيت"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91087","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81688","المقتضب"],[5121,"عِرَاقُ الْإِبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=209030",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[463,"يا ديارَ الحيِّ منْ جنبِ الحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60162&r=&rc=218",""],[6277,"رثاء الهبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64488&r=&rc=51",""]],"verses":[["أَيُنْجِدُ نَجْدٌ بَعْدَ شَحْطِ مَزَارِهِ","وَيَكْئُبُ بَعْدَ الْبُعْدِ مِنْهُ كَثِيبُ",0,"ب",1,0],["أي نجل يحيى كن إذا حققوا","آمالنا ندبهم المفضلا",1,"ل",2,0],["أَيْنَ جَوْلاتُنَا وَأَيْنَ الدُّعَابَا","تُ وَأَيْنَ الهَوَى وَأَيْنَ الفُتونُ",2,"ن",1,0],["أي نجوى مخضلة النعماء","رددتها حناجر الصحراء",3,"ا",2,1],["أَيُّ نَجمٍ شارِقٍ ما غَرَبا","أَيُّ قَلبٍ خافِقٍ لَم يَسكُنِ",4,"ن",1,0],["أَيْنَ جَوْبُ البلادِ شَرْقاً وغَرْباً","واعْتِسَافُ السُّهولِ والأَجْبالِ",5,"ل",1,0],["أَينَ جَيش العِدا","إِن دَعا للجِهاد",6,"د",1,0],["أيُّ نجمٍ في أفقه رصدوه","لمسارٍ حول الثرى ومطافِ",7,"ف",1,0],["أينجبُ نجدٌ بعد شحطِ مَزارِهِ","ويكتَبُ بعد البُعدِ منه كثيب",8,"ب",1,0],["أين جمشيد ابن كايو كباد","أين زالا زالوا جميعاً وبادوا",9,"د",3,1],["أين جدّي حسينٌ بن عليّ","أين زيدُ المفجَّع الموتور",10,"ر",1,0],["أَيَّ نجوى وحديثٍ أَرسلا","همسُها همسُ دلالٍ وعتاب",11,"ب",1,0],["أيَنْجو صَحيحٌ وهْو سالِكُ مَنْزِلٍ","تُديرُ المَها في جَوّه الحَدَقَ النُّجْلا",12,"ل",2,0],["أَيُّ نَجْمٍ من أَيِّ شَمْسٍ وبَدْرِ","أُلْبِسَ الليلُ منه حُلَّةَ فَجْرِ",13,"ر",1,1],["أين جيراني بها لهفي بهم","لهفة سكرتُها غيرُ مفيقَهْ",14,"ق",2,0],["أينجو بنو بدر بمقتلِ مالكٍ","ويخذلنا في النائبات ربيع",15,"ع",1,1],["أَيُّ نَجْلٍ بل أَيُّ نَجْمٍ سَعِيدٍ","أَسعد اللهُ كلَّ من يرتَجِيه",16,"ي",2,1],["أي نجم لم يرتفع","نازحاً عن مخادعي",17,"ع",2,0],["أين جناحاك متى فارقاك","قد سقطا في الارض أم في السماك",18,"ك",1,0],["أينَ جالُوتُ من تعاظَمَ بأساً","أرضَعَتهُ لبانَها الهَيجاء",19,"ا",2,0],["أي نجم بدا بأفق علاهم","فأفاض الهدى على الأكوان",20,"ن",1,0],["أيّ نجم من خير بدر وشمس","زان أفق العلا بسعد السعود",21,"د",1,0],["أي نجم من الهداية أهوى","صعقاً مذله الإِله تجلّى",22,"ل",2,0],["أيُّ نجمٍ بدا يشعُّ منيرا","طبَّق الكون بهجةً وسرورا",23,"ر",2,1],["أيُنْجزُ يوْماً للتلاقِي وَعْدُ","ويُغْمَرُ غوْرٌ للرّضا أو نَجْدُ",24,"د",1,0],["أَيَنجو كَلب أَهل الكَهف مَعهم","وَيَهلك يا رَسول اللَه إِبنُكْ",25,"ك",1,1],["أينَ جيرَةٌ ذهبوا","بالسلوّ إذ ذهبوا",26,"ب",3,0],["أَيْنَ جِلْجَامِشَ الْخُلُودِ وَفِكْراً","عَاشَ دَهْراً لِيَرْتَقِي الْمَرْءُ صُلْحَا",27,"ح",2,0],["أي نجم من عاش فى الوحل دهرا ؟","إنما الفضل للذين استقاموا",28,"م",3,0],["أينّ جيراني لها لهفي بهمْ","لهفة َ سكرتها غيرُ مفيقهْ",29,"ق",2,0],["اين جشميد ابن كايو كباد ؟","اين زالا ؟ زالوا جميعا وبادوا",30,"د",3,1]]}