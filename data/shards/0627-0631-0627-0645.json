{"poems":[[90,"بني الأرض هل من سامع فأبثه","https://www.aldiwan.net/poem45068.html","الطويل"],[29,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[49,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[46,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[46,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[76,"أرقت أكف الدمع طورا وأسفح","https://www.aldiwan.net/poem12887.html","الطويل"],[48,"إذا كان علم الناس ليس بنافع","https://www.aldiwan.net/poem22025.html","الطويل"],[48,"مغنية هذي الحمامة أصبحت","https://www.aldiwan.net/poem22646.html","الطويل"],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[202,"يا فتية الحي كفوا الأعين النجلا","https://www.aldiwan.net/poem51900.html","البسيط"],[275,"برزت لنا من القصر العلي","https://www.aldiwan.net/poem35578.html","الوافر"],[287,"آرام رامة عن بان الحمى بانوا","https://www.aldiwan.net/poem32376.html","البسيط"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[412,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108507","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66256","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93561","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87688","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137232",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122455","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65102","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132784","الوافر"],[4184,"","https://poetry.dctabudhabi.ae/diwan/poem/124070","الكامل"],[4578,"هذي رواية آدابٍ لذي أدبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49350",""],[5083,"خمرةُ الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=53881",""],[5605,"هذي المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=159788",""],[5776,"حربُ الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=207245",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6259,"بعثن غداة تقويض الخيامِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59399&r=&rc=47",""],[6277,"ازعق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64492&r=&rc=55",""]],"verses":[["أرامل تستذري الدموع وحولها","يتامى كأفراخ القطا والحمائم",0,"م",1,0],["أُرامي مَن رَموا وَيَحولُ دوني","مِجَنٌّ مِن صِفاتِهِمُ صَلودُ",1,"د",1,0],["أَرامِيَتي كُلَّ السِهامِ مُصيبَةٌ","وَأَنتِ لِيَ الرامي وَكُلّي مَقاتِلُ",2,"ل",1,0],["أَرامَةُ كُنتِ مَألَفَ كُلِّ ريمِ","لَوِ اِستَمتَعتِ بِالأُنسِ القَديمِ",3,"م",1,1],["آرامُ حَيٍّ أَنزَفَتهُم نِيَّةٌ","تَرَكَتكَ مِن خَمرِ الفِراقِ نَزيفا",4,"ف",2,0],["أَرامٍ بِأَغماتٍ يُسَدِّدُ سَهمَهُ","فَيَرمي وَقَلبٌ بِالجَزيرَةِ يُجرَحُ",5,"ح",1,0],["أُرامي فَتُشويَ مَن أُعاديهِ أَسهُمي","وَما صافَ عَنّي سَهمُهُ بِرِماءِ",6,"م",3,0],["أَرامَت مِنَ اللَهِ الثَوابَ أَمِ اِنبَرَت","تُؤَمِّلُ بِالسَجعِ التَخَلُّصَ مِن نَذرِ",7,"ر",1,0],["أرآم هذا الحي من مدين","فالبدع فالبتراء حتى ظبا",8,"ب",2,0],["آرامكم كانساتٌ في الضلوع وإن","قالوا دعا السرب داعي البين فاحتملا",9,"ل",2,0],["أرامية بنبلِ اللحظِ من لي","بنزعِ السّهمِ من قلبي الدميِّ",10,"ي",1,0],["آرامُ رامَةَ عَن بانِ الحِمى بانوا","مِن بَعدِ أَن غازَلَتني فيهِ غِزلانُ",11,"ن",1,1],["أَرام عزوب الحلمِ عنّي مزلزلاً","بأرجلِ نمل دبّ راسية الهضبِ",12,"ب",1,0],["أَراميهنَّ بِاللحظات خَلساً","فَترجع نَحوَ مَقتَلَتي سِهامي",13,"م",2,0],["آرامُ خَيفٍ كِرامٌ في أساوِدِها","بيضٌ صِحاحٌ تُخيفُ الأُسْدَ في الأكَمِ",14,"م",1,0],["آرام جلق ريقهن شفاءُ","فإذا تعذر لا يفيد دواءُ",15,"ا",2,1],["أراميةً سهم لحظٍ فتورِ","أغيري على من رميت أغيري",16,"ر",2,1],["آرام وَجرة لا يدون قَتيلهم","وَأَسيرهم لَم يَرجُ فيهِ سراح",17,"ح",1,0],["أَرامية السَهم الَّذي نَفذ الحَشا","بَلَغتِ المُنى لا تَجعلي السَهم سَهمين",18,"ن",1,0],["ارامز اني ان نظمت قصيدة","فانك فيها دون كل الورى قصدي",19,"د",2,0],["أرَامِلُ فِي القُرَى كَعَدِيدِ طِيسٍ","وَأُخرَى في القَبَائِلِ لاَ تُعدُّ",20,"د",1,0],["أراملُ وصغارٌ لا مجال لهم","وواهنُ الجسم من ضُرّ ومن عرج",21,"ج",1,0],["ارامي مهجتي بالله خفض","فان السهم قد قتل الرميا",22,"ي",2,0],["آرام إنس لم تصَد إلا كما","تصطادُ في بيدائها الآرام",23,"م",1,0],["أرام رامة في تصويرها برزت","للناظرين بشكل الخرّد العرب",24,"ب",1,0],["آرامَ إدلبَ هذا الشأنُ حيَّرَني","يُقبِلْنَ .. يُعرِضْنَ .. لا زُهْداً ولا مَرَحا",25,"ح",2,0],["أرامل ويتامى والطلاق ومن","للعقل فاقده أو بات في مُجُنِ",26,"ن",1,0],["أرامكو حصن خيبر شيدته","سيحرق حصنها وبه نصولُ",27,"ل",1,0],["أرامي الرَّدَى أَخطَأْتَنا وأَصَبْتَهُ","أسأتَ لنا جُذَّتْ أَنامِلُكَ العَشْرُ",28,"ر",1,0],["أراميهنّ باللحظات خلساً","فترجع نحو راميها سهامي",29,"م",2,0],["آرام رملتنا ! وعزّ ظبائها !","إنّي بكم ، وكمثلكم منكوب",30,"ب",1,0]]}