725,"أقات الموت","https://www.poetsgate.com/ViewPoem.aspx?id=208791",""],[5759,"عودة الرَشاد","https://www.poetsgate.com/ViewPoem.aspx?id=213721",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5992,"كأنَّ السُحبَ تكشفُ عن نجومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=41832",""],[243,"المساء الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68160&r=&rc=152",""],[6259,"خليليَّ قد طال الكرى بكما هبّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59359&r=&rc=7",""]],"verses":[["كَأَنَّ السَماءَ بِها لامَةٌ","وَزُهرُ النُجومِ مَساميرُها",0,"ر",3,0],["كانَ السَوادُ سَوادَ عَينِ حَبيبِهِ","فَغَدا البَياضُ بَياضَ طَرفِ الناظِرِ",1,"ر",1,0],["كَأَنَّ السَوابِقَ مِن تَحتِها","دَبىً طائِرٌ أَو قَطاً سارِبُ",2,"ب",1,0],["كأنّ السّماءَ لَها مَنْهَلٌ","عليهِ منَ الحَبَبِ الكَوْكَبُ",3,"ب",1,0],["كَأَنَّ السَرايا بَينَ قَوٍّ وَقارَةٍ","عَصائِبُ طَيرٍ يَنتَحَينَ لَمَشرَبِ",4,"ب",1,1],["كَأَنَّ السُها فاني الحُشاشَةِ شَفَّهُ","ضَنىً فَخُفاتٌ مَرَّةً وَمَشابُ",5,"ب",1,0],["كَأَنَّ السُلافَ المَحضَ مِنهُنَّ طَعمُهُ","إِذا جَعَلَت أَيدي الكَواكِبِ تَضجَعُ",6,"ع",1,0],["كَأَنَّ السَليطيِّينَ أَنقاضُ كَمأَةٍ","لِأَوَّلِ جانٍ بِالعَصا يَستَثيرُها",7,"ر",3,0],["كان السَّدَى والندى مجداً ومكرمة","تلك المكارم لا يُوَرثن عن رِقَبِ",8,"ب",1,1],["كَأَنَّ السُبلَ فيهِ لَنا عُيونٌ","وَإِنسانُ السَفينَةِ لا يَقِرُّ",9,"ر",1,0],["كَأَنَّ السَرايا ساكِناتٍ مَوائِجاً","قَطائِعُ تُعطى الأَمنَ طَوراً وَتُسلَبُ",10,"ب",1,0],["كَأَنَّ السُمانى إِذا ما رَأَتكَ","تَصَيَّدُها تَشتَهي أَن تُصادا",11,"د",2,0],["كَأَنَّ أَلسُنَهُم في النُطقِ قَد جُعِلَت","عَلى رِماحِهِمِ في الطَعنِ خِرصانا",12,"ن",2,0],["كانَ السَحابُ مُجانِباً لِبِلادِنا","حَتّى قَدِمتَ فَجادَ فيهِ وَأَسبَلا",13,"ل",2,0],["كانَ السِرارُ لِعارِمٍ في أَمرِنا","رُؤيا قَصَصناها عَلى الغُرّامِ",14,"م",1,0],["كَأَنَّ السُيوفَ المَشرِفِيَّةَ في البُرى","إِذا اللَيلُ عَن أَعناقِهِنَّ تَقَدَّدا",15,"د",2,0],["كأنَّ السَّماءَ استَعْبَرَتْ لِمَصابِهِم","فما مَلَكَتْ فيه الدُّموعَ الهَوامِلا",16,"ل",2,0],["كأنّ السحرَ جيءَ به طبيباً","ليبرئهنّ مِنْ سَقَم العيونِ",17,"ن",1,0],["كأنّ السُّها مضنىً أتاه بنعشهِ","بَنوه وظنُّوا أن موْتَتَهُ حَتْمُ",18,"م",1,0],["كَأَنَّ السَحابَ الغُرَّ غَيَّبنَ تَحتَها","حَبيباً فَما تَرقا لَهُنَّ مَدامِعُ",19,"ع",1,0],["كَأَنَّ السَرايا وَالفَيالِقَ لَم تَسِر","إِلى المَوتِ تَثني دونَهُ مَن يُحارِبُه",20,"ب",2,0],["كأنّ السِّماكَينِ اللّذينِ تَظاهَرا","على لِبْدَتَيْهِ ضامِنانِ له حَتْفا",21,"ف",2,0],["كأنّ السيوفَ المُصْلَتاتِ إذا طَمَتْ","على البَرِّ بحْرٌ زاخِرُ الموجِ مُترَع",22,"ع",1,0],["كَأَنَّ السَيفَ لَم يَعطَل زَماناً","إِذا حَلِيَ الحَمائِلُ وَالقِرابُ",23,"ب",1,0],["كَأَنَّ السِلاحَ فَوقَ شُعبَةِ بانَةٍ","تَرى نَفَخاً وَردَ الأَسِرَّةِ أَسحَما",24,"م",2,0],["كَأَنَّ السُّرَى أَهْدَتْ لنَا بَعْدَمَا ونَى","مِنَ اللَّيْلِ سُمَّارُ الدَّجَاجِ فَنَوَّمَا",25,"م",2,0],["كَأَنَّ السَماءَ اِنشَقَّتِ اليَومَ لِلَّذي","دَعاني فَكانَت وَردَةً كَدِهانِ",26,"ن",1,0],["كأنّ السِّباعَ فيهِ غَرْقَى عَشِيّة","ً بِأرْجائِهِ القُصْوى أنابيشُ عُنْصُلِ",27,"ل",1,0],["كَأنَّ السُّعَاةَ المَجتوي قَرقَفَ الكَرَى","إلَى المَجدِ ألفَاظٌ وهوَ لهَا مَعنَى",28,"ن",2,0],["كأَنَّ السَّقامَ لَهُ عاشِقٌ","فَقَدْ سارَ قُرْباً بإِبعادِهِ",29,"د",2,0],["كان السماع لهم والشرع ممتنع","منهم وأهلوه لا يؤتون من غلب",30,"ب",1,0],["كأن السيف والانساع منها","وميثرتي كسين أقب جابا",31,"ب",2,0],["كَأَنَّ السِهامَ المُرسَلاتِ كَواكِبٌ","إِذا أَدبَرَت عَن عَجِّها وَهيَ تَلمَعُ",32,"ع",1,0],["كأنّ السحاب الغُرَّ اصبحن أَكؤساً","لنا وكأنّ الراح فيها سنا البرق",33,"ق",1,0],["كأنّ السَّحاب به غادة","مُشَوَّقة بين أترابها",34,"ب",3,0],["كأن السُّقاةَ لها يَقْسِمون","شُعاعَ الشموش لشُرَّابها",34,"ب",3,0],["كأن السُّهَا حقٌّ تعرضَ باطلٌ","إليه فألقى دونَه مُسبَلَ السِّترِ",35,"ر",1,0],["كَأَنَّ السَوطَ يَقبِضُ بَطنَ طاوٍ","بِأَجمادِ اللُبَيِّنِ مِن جُفافِ",36,"ف",1,0],["كأن السري وتركأني ارومة","كأن النوى نون كأن الفلابحر",37,"ر",1,0],["كأن السها صب للقيا ذكائه","وقد هجرت ليلا فأنحله الهجر",37,"ر",1,0],["كَأَنَّ السُلافَ بِأَنيابِها","يُخالِطُ في النَومِ عَذباً زُلالا",38,"ل",2,0],["كَأَنَّ السُخامَ الشَيعَ حينَ تَجوبُهُ","عَلى نَخلَةٍ فَردٍ تَدَلَّت عُذوقُها",39,"ق",3,0],["كَأَنَّ السُّرَى يَقتَاتُ مِنها غَوارِباً","بَرَى النَّيَّ مِنها نَأْيُها واغْتِرابُها",40,"ب",3,0],["كَأَنّ السُها إِذ لاحَ دينار باخل","إِذا ما بَدا مِن كَفِّهِ فَهوَ حاجبُه",41,"ب",2,0],["كَأَنَّ السَماءَ وَقَد غَيَّمَت","مِراةٌ تَنَفَّسَ فيها كَئيبُ",42,"ب",1,0],["كانَ السُكوتُ غِطاءً كُنتُ أُسبِلُهُ","حَتّى تَكَلَّمَ دَمعُ العَينِ فَاِنكَشَفا",43,"ف",2,0],["كأن السرى عند الكرى لي حَشيَّةٌ","ليالي افترَقنا والمَهارى وسائدُ",44,"د",1,0],["كان السقوط من الصعو","د إلى مراتب عاليه",45,"ه",1,1],["كان السَبيل إِلى البَيت الحَرام وَقَد","تَفاقَمَ الأَمر صَعباً كُلُهُ خَطَرُ",46,"ر",1,0],["كان السفائن سابقاً","تأتي بأنواع الخطاب",47,"ب",1,1],["كَأَنَّ السُرى وَالصُبحُ يَرقُصُ بِالفَتى","فُؤاد جَبانٍ فوجىء الخَوفُ وَالرُعبا",48,"ب",2,0],["كَأَنَّ السَما خَرقاء ضوعف زَهرُها","فَفَرَّت كماماً عَن تَرائِبها كَربا",48,"ب",2,0],["كَأَنَّ السَّمَاءَ بدْرَها ونجومها","سُرَاكَ وَقَدْ حَفُّوكَ شِيبٌ وشُبَّانُ",49,"ن",1,0],["كأن السما بالأرض مقلة ناعس","طليح وقد ألقى عليها هدابها",50,"ب",3,0],["كأن السحب برك رازماتٌ","برأس خميلةٍ نفضت ذراها",51,"ا",3,0],["كأنَّ السُرى بحرٌ كأني أَخوضه","كأنَّ له مدٌّ وليس له جَزْر",52,"ر",1,0],["كأنَّ السُّهى معنىً يَدِقُّ فيختفى","ويبدو جِهاراً أن تراجعه الفكر",52,"ر",1,0],["كانَّ السنينَ الخمسَ خمسون حجَّةً","بصحبتهِ أو كالخضمِ إذا غَمر",53,"ر",1,0],["كأنّ السياطَ يَقتلِعنَ إذا هوت","سفائنَ منها والسرابُ بِحارُ",54,"ر",1,0],["كأنّ السحابَ جَوْنَها وبياضَها","تفرّعَ من صافٍ به ومَشوبِ",55,"ب",1,0],["كانَّ السَّعالي ترْتمي بمواردٍ","كماةُ وغاهُ في كواهلِ سُبَّقِ",56,"ق",1,0],["كأنَّ السِّنينَ الغُبْر هامُ عُداتِه","ونعماءَه حدُّ السيوفِ البَواترِ",57,"ر",1,0],["كان السماحُ بهم حياً فمذ عدموا","أضحى السماح بهم في قبضة العدمِ",58,"م",1,0],["كأنَّ السويداوات ذابت لعشقها","معانيه حتى نالها بالأنامل",59,"ل",1,0],["كأن السرى ساقٍ كأن الكرى طلا","كأنا لها شرب كان المنى نقل",60,"ل",1,0],["كأنّ السّحابَ الجَوْنَ يَنطِفُ فوقه","ركائبُ يحملن الهوادجَ ضُلَّعُ",61,"ع",1,0],["كأن السها ما بينها متضائلا","أديب له في الحي دار قرار",62,"ر",1,0],["كأن السماوات أرض لها","وبالعرض قد نيط منها الطنب",63,"ب",1,0],["كأن السما والأرض فيه تنافساً","فنال الفضا عفواً سني الرغائب",64,"ب",1,0],["كَأَنّ السُّهى جِسمي الّذي ذابَ بِالنَّوى","فَطَوراً لَقَد يَبدو وَتاراً لَقَد يَخفى",65,"ف",2,0],["كأن السطر منه نشر","ه بالصار إلى السطرِ",66,"ر",1,0],["كأن السدَّ مُنْبَسِطٌ","على جو السما طبقا",67,"ق",2,0],["كأن السها معنى دقيق بفكرة","فآونة يخفى وآونة يبدو",68,"د",2,0],["كان السوق وسط محلّتَيْها","نجوم مجرة بسماء وَرْسِ",69,"س",1,0],["كأنَّ السُّها عين تَغُضّ على قَذىً","واخوتها حُور العيون شواهدُ",70,"د",1,0],["كأنَّ السماك استأسر الليل سمكه","فخاض حشاه رمحه المتواردُ",70,"د",1,0],["كان السَّقام فولىّ","يعدو بسَاحة أَعدا",71,"د",2,0],["كأن السماك الرامِح الرمح هزّه","عَلى أَعزَل فارتاع واِجتنَب اللسمعا",72,"ع",2,0],["كأن السهى في زيّه ذو صَبابة","كسته نحولا كاد من فرطه ينعي",72,"ع",2,0],["كأنّ السماء صحيفة رأس","تطاردُ فيه المشيب المشابا",73,"ب",2,0],["كَأَنَّ السَميرِيّاتُ فيهِ عَقارِبٌ","تَجيءُ عَلى زُرقِ الزُجاجِ وَتَذهَبُ",74,"ب",1,0],["كأنَّ السحابَ الغرَّ لما تجمعت","وقد فرقت عنا الهمومَ بجمعها",75,"ه",2,1],["كأَن السكر في الإنسان طبعٌ","يميل إليه ميل الكف للَّمس",76,"س",1,0],["كَأَنَّ السَّحابَ الغُرَّ أَلقَت بِسِرِّها","إِلَيها فَلَم تكتُم وَضاقَت عَنِ الحَملِ",77,"ل",1,0],["كَأَنَّ السَماءَ وَقَد أَزهَرَت","كَواكِبُها في دُجى الحِندِسِ",78,"س",1,1],["كأن السحاب الجون يحمومها سما","على الجو في داجٍ من النق مطبق",79,"ق",1,0],["كان السحب ييكين البراري","وزهر الروض يشمت بالرمايا",80,"ا",3,0],["كَأَنَّ السُيُوفَ وَقَد خُضِّبَت","سَنا النارِ أَوَّلَ ما تُشعَلُ",81,"ل",1,0],["كان السهام الواردات لصدره","بنان يعاطيه المدام مخضب",82,"ب",1,0],["كأن السما تبكي حسيناً بساجم","حكى عبرتي لو كان أحمر قانيا",83,"ي",2,0],["كَأَنَّ السُّها إِنسانُ عَينٍ غَريقَةٍ","مِنَ الدَّمعِ تَبدو كُلَّما ذَرَفَت ذَرفا",84,"ف",2,0],["كأنَّ السَّما ريطةٌ رحِّلت","وذهِّب من طرفيها الغماما",85,"م",2,0],["كان السِراجَ وَكُلُّ عَين نَحوَه","تَعشو فعاد بِهِ ال