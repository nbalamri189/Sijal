{"poems":[[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[95,"عيد حسيب عيد حبيب","https://www.aldiwan.net/poem11127.html","مخلع البسيط"],[95,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[74,"رشقتني من اللحاظ بغمزه","https://www.aldiwan.net/poem19000.html","الخفيف"],[53,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[93,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[47,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[30,"نابي الفراش طري اللحم مطعمه","https://www.aldiwan.net/poem5497.html","البسيط"],[68,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[107,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[21,"والحية الحتفة الرقشاء أخرجها","https://www.aldiwan.net/poem36160.html","البسيط"],[50,"نابذت من باصطباري عنك يأمرني","https://www.aldiwan.net/poem64434.html","البسيط"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42678","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[108,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[87,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[89,"سَكِرَتْ بِخَمْرِ حَدِيثِكِ الأَلْفَاظُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24011&r=&rc=273",""],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[119,"صلى الآله على أبي الزهراء","https://www.aldiwan.net/poem41474.html","عموديه"],[136,"إن للبين صولة وهجوما","https://www.aldiwan.net/poem54650.html","الخفيف"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[261,"تعرف لي أحسن من بغله","https://www.aldiwan.net/poem48335.html","السريع"],[295,"يا أيها الظالم","https://www.aldiwan.net/poem11676.html","منهوك المنسرح"],[398,"يا ساريا قد نهضا","https://www.aldiwan.net/poem53657.html","مجزوء الرجز"],[443,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[463,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[505,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[519,"فجر الهدى","https://www.aldiwan.net/poem20844.html","مجزوء الرجز"],[519,"فجر الهدى حيدري عم نائله","https://www.aldiwan.net/poem20852.html","البسيط"],[520,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[563,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"],[567,"يا أيها الناس هذا مولد القمر","https://www.aldiwan.net/poem52829.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122699","الخفيف"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[1355,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77854","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108953","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108774","الخفيف"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105867","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102155","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199630","المسحوب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77229","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93569","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129882","الرمل"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102022","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93870","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109845","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140300",""],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71363","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126971","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86287","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132089","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131273",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131231",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69955","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44706","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44686","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75722","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54378","الخفيف"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103299","السريع"],[4389,"","https://poetry.dctabudhabi.ae/diwan/poem/178146","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72470","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4691,"اعتذارات بين يدي النقاء","https://www.poetsgate.com/ViewPoem.aspx?id=102702",""],[4755,"غَفوةٌ على سَرير البَرزَخ","https://www.poetsgate.com/ViewPoem.aspx?id=215432",""],[4881,"بين شاعر وشعره","https://www.poetsgate.com/ViewPoem.aspx?id=200535",""],[4906,"ورُحتُ أشكو للطُّلول الجَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=173614",""],[5160,"يحيى عياش","https://www.poetsgate.com/ViewPoem.aspx?id=175161",""],[5376,"يا دارَ أهلي رغم هجري فانعمي","https://www.poetsgate.com/ViewPoem.aspx?id=188285",""],[5431,"قالت لي القدس...","https://www.poetsgate.com/ViewPoem.aspx?id=202677",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5533,"يا أُمَّةَ المِلْيَار","https://www.poetsgate.com/ViewPoem.aspx?id=180269",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5739,"الحرف دلاّل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127067",""],[5943,"أسيرُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=11280",""],[5956,"رضيعٌ يزحف كسُلْحُفاةٍ حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=205158",""],[6106,"إلى ربيع المولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=6310",""],[5393,"ركبت خيول الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85462&r=&rc=29",""],[6257,"صعلكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87176&r=&rc=1",""]],"verses":[["نابِلاً في مَطامِحِ الجَوِّ هاتي","كَ وَذا في مَهابِطِ الغيطانِ",0,"ن",1,0],["نابٍ إِذا جَرَّبتَهُ في العِدا","وَهوَ عَلى عُنقِيَ ماضٍ هَذام",1,"م",1,0],["نَأبى التَعَزّي ثُمَّ يُل","حِقُنا الزَمانُ بِمَن تَعَزّى",2,"ز",2,0],["نابَ عَرفُ الطيبِ عَن نارِ القِرى","في لَياليهِم إِذا الطارِقُ حارا",3,"ر",2,0],["نَابِغَةٌ مُدْرِكٌ مُنَاهُ","بِالحَزْمِ وَالْعَزْمِ وَالرُّجُولَهْ",4,"ل",2,0],["نَابِهَاتِ النُفُوسِ إنْ هُذِّبْ","نَ يُحِطْنَ الْحجَى بِخُلْقٍ حَصِينِ",5,"ن",1,0],["نابهُ العزّ مفصحٌ لو توخى","في كَراه قُسّ الخطاب لعزّه",6,"ز",2,0],["نابَ عَنْ صِدْقِهِ وصِدْقِ وفائي","لك بالشكر صادقُ الأحلام",7,"م",1,0],["نابي وَظِفري بِتُّ بَعدَكُما","وَحدي بِلا ناب وَلا ظِفرِ",8,"ر",1,0],["نابِهٌ في مَحاسِنِ شُهرَتِهِ","لَم يَكُن فَضلُهُنَّ بِالمَكتومِ",9,"م",1,0],["نابي الفِراشِ طَرِيُّ اللَحمِ مُطعَمَهُ","كَأَنَّ أَلواحَهُ أَلواحُ مَحصومِ",10,"م",1,1],["نابَت عَنِ الشَمسِ المُنيرَةِ عِندَما","حُبِسَت وَساطِعُ نورِها لَم يُحبَسِ",11,"س",1,0],["نَأْبَى على المُسْتَسْلِمينَ سَبيلَهم","شرُّ الشُّعوبِ العاجزُ المُسْتَسْلِمُ",12,"م",1,0],["نأبى مَشورتَهُ وتُنكِرُ أُمُّه","ما يفتَري من باطلِ الأقوالِ",13,"ل",1,0],["نَأبى الكَرى حَتّى نَقومَ بِنَصرِها","وَنَرُدَّ غاصِبَ حَقِّها مَخذولا",14,"ل",2,0],["نَأبى المَناصِبَ إِلّا في جَوانِحِها","يَنُصُّها كُلُّ ذي لُبٍّ وَوِجدانِ",15,"ن",1,0],["نَأبى تَعَسُّفَهُم ونُنكِرُ ظُلمَهُم","وَنُعِدُّهُم لِشُعوبِهِم خُدّاما",16,"م",2,0],["نابٌ حَدِيدٌ وَكَفٌ غَيرُ وادِعَةٍ","والخَلقٌ مُختَلِفٌ والقَولُ وَالشِيَمُ",17,"م",1,0],["نابَذتُ مَن بِاِصطِباري عَنكِ يَأمُرُني","لِأَنَّ مِثلَكِ روحي عَنهُ قَد ضاقا",18,"ق",2,1],["نَأبى عَلى الناسِ المَقادَةَ كُلِّهِم","حَتّى نَقودَهُمُ بِغَيرِ زِمامِ",19,"م",1,0],["نابَ بدرُ التّمامِ طَيْفَ مُحَيّا","كَ لطَرْفي بيَقْظَتي إذ حكاكا",20,"ك",2,0],["نَابِي الْمَضَاجِعِ لا تَزُورُ جُفُونَهُ","سِنَةُ الْكَرَى وَأُولُو الْهَوَى أَيْقَاظُ",21,"ظ",1,0],["نَابُهَا الْحُجَّةُ الضَّرُوسُ وَأظْفَا","رُ يَدَيْهَا عَزِيمَةُ الْبُسَلاَءِ",22,"ا",2,0],["نابوا، فكانوا الناطقين برأيهم","والمُنطقين الخائرَ الرِّعديدا",23,"د",2,0],["ناب الحنين إليكم فى خواطرنا","عن الدلال عليكم فى أمانينا",24,"ن",2,0],["نابً المضاجعِ ، لا تزورُ جفونَهُ","سِنَة ُ الْكَرَى ، وَأُولُو الْهَوَى أَيْقَاظُ",25,"ظ",1,0],["ناب برشد عن ابيه المصطفى","بحكمة يعجز عن اصدارها",26,"ر",3,0],["نابوا النبي فهديه وعلومه","في الاولياء الغر والعلماء",27,"ا",2,0],["نابلىَّ الألحاظ مسكى رُدن","عنبرياً مخطوطَ كشح هضيما",28,"م",2,0],["نابَتِ العَينُ بِالبُكاءِ وَأُفحِم","تُ فَما أَحسَنَ اللِسانُ المَنابا",29,"ب",2,0],["ناب عنه الرعبُ حتى أنه","يقتل القِرن وإن لم يَضْرِب",30,"ب",1,0],["نابت عن الأشهب لما مضى","نيابة الكلب عن الفهد",31,"د",1,0],["ناب عن المضجع","لا يعرف السلوى",32,"ا",1,0],["نابَذتُهُم وَلَم أُبل","اِن قيلَ قد تَرفَّضا",33,"ض",2,0],["نابت مهابتهُ عن سيفهِ وقفت","نفوسُ أعدائهِ من شدّةِ الرعُبِ",34,"ب",1,0],["نابتاً في أرومةٍ للعلا غي","ناءَ شَقَّتْ ترابَ أرضٍ غَنَّا",35,"ن",2,0],["نابَ طَهَ فأَتانا مُرْشِداً","لطَريقٍ ضاءَ فيهِ الحَلَكُ",36,"ك",1,0],["نابُ الرَّدَى","رُوحُ المُنَى",37,"ن",2,0],["نَابُ الرَّدَى كَفُّ يُمنِ الدَّهرِ كَاهِلُهُ","رُوحُ المُنَى مَنهَلٌ طَابَت مَشَارِبُهُ",38,"ب",2,0],["نابت مناب الخضر في تطوافه","مذ فارقت هذا الجناب الأخضرا",39,"ر",2,0],["نابٍ عن الأوطانِ فهْوَ متى","ظَفِرت به الأوطان مُرتحِلُ",40,"ل",1,0],["نابُ الإِمامِ الَّذي يَفتَرُّ عَنهُ إِذا","ما اِفتَرَت الحَربُ عَن أَنيابِها العُصُلِ",41,"ل",1,0],["نابت عنه كل ما كان منه","مثل نبت المعنى من الإحساس",42,"س",1,0],["نابَتْ عنِ الشَّمسِ فاستخَفَى ببَهْجتِها","ما كانَ للبَدْرِ من ضوءٍ عن النَّظَرِ",43,"ر",1,0],["نابِهُ الذِّكرِ شُكرُهُ مَلأَ الأر","ضَ وأوفى مِن فَوقِ سَبعِ طِباقِ",44,"ق",1,0],["نَاب بِكُلِّ عَظِيمَةٍ تَغشَاهُمُ","فَمَتَى تُحَمِّلهُ العَشِيرَةُ يَحمِلِ",45,"ل",1,0],["نابى المَعَدَّينِ خاظٍ لَحمُهُ زِيَمٌ","سامٍ يَجُذُّ جِيادَ الخَيلِ مُنجَذِبا",46,"ب",2,0],["نابوش دير هلال السير مندرج","في قبة الخير عصار لخمار",47,"ر",1,0],["نابت ثغور العذارى عن كواكبه","وبارقات الغيارى عن مذاكيه",48,"ي",2,0],["نابت البيضُ والمكارمُ منه","في الردى والندى عن الأطواق",49,"ق",1,0],["نابِلَةٌ رامِحَةٌ","سائِفَة مُتَرَّسه",50,"س",2,0],["نابذوه وإنهم لم يحيدوا","مخبراً عن سوابق قد حواها",51,"ا",3,0],["نابَ في البيعةِ عنهُ المصطفى","بيعَةُ الرضوان حينَ انتُدِبا",52,"ب",2,0],["نابت الأعين عن بيض الطلى","والقدود الهِيف عن سمر الرماح",53,"ح",1,0],["نابي الروادف هاضم الكشح منهوب","كالخيزرانه لي تثنى وماحي",54,"ح",2,0],["نابع في الجزل سبكه من ذهب","جنه التيار الي ماله ابلود",55,"د",1,0],["نابَعتُها مُستَجلِياً حَتّى إِذا",