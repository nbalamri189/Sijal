adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[88,"انظر الى تلك المعلقة التي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19580&r=&rc=83",""],[88,"إياك والبصرَّة المُضنى توطُّنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19576&r=&rc=79",""],[88,"يا عدل طال الانتظار فعجلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19514&r=&rc=17",""],[85,"كلُّ حيٍّ على المنية غادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9597&r=&rc=87",""],[85,"لِمَ لَمْ أَرْثِ أَبي؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9627&r=&rc=117",""],[87,"يَا نَاعِسَ الطَّرْفِ، إِلَى كَمْ تَنَامْ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23778&r=&rc=40",""]],"verses":[["اِنظُر إِلَيَّ بِبَعضِ طَرفِكَ نَظرَةً","يَسمو لَها نَظَري وَيُعرِبُ مِقوَلي",0,"ل",2,0],["أُنظُري تَرضَي بَقايا قَومِنا","إِن جَلا اليَومُ غُبارَ المُعتَرَك",1,"ك",1,0],["أُنظُر إِلى هَذا الزَمانِ بِعَينِهِ","تَرَجِع إِلَيكَ بِمَقتِهِ الأَلحاظُ",2,"ظ",1,0],["أُنظُر إِلى الأَيّامِ كَّيفَ تَعودُ","وَإِلى المَعالي الغُرِّ كَيفَ تَزيدُ",3,"د",1,1],["اُنظُر إِلى هَذا الأَنامِ بِعِبرَةٍ","لا يُعجِبَنَّكَ خَلقُهُ وَبَهاؤُهُ",4,"ا",3,0],["إِنَّ ظِلَّ النَّقْعِ أَوْلَى بِالفَتَى","في طِلابِ العِزِّ مِنْ ظِلِّ الطِّرافِ",5,"ف",1,0],["اُنظُر إِلى جَسَدٍ أَضَرَّ بِهِ الهَوى","لَولا تَقَلُّبُ طَرفِهِ دَفَنوهُ",6,"و",2,0],["انظُرْ خِضابَ الشّبابِ قد نصَلا","وزائِرَ الأُنْسِ بعْدَهُ انْفَصَلا",7,"ل",2,1],["انْظُرْ الى ينْعِي وحُسْنِ بُسوقِي","يهْفُو النّسيمُ بِقَدّيَ الممْشوقِ",8,"ق",1,1],["انْظُرْ إِلَيْهِ شَبِيهَ مُعْجِزَة الْعَصَا","مَاءٌ بِتَنْقِيةِ الْمَثَانَةِ خُصِّصَا",9,"ص",2,1],["انْظُرْهُ في كفّةِ الميزانِ صاعِدةً","كأنّها صَنْجةٌ بيْضاءُ منْ حَجَرِ",10,"ر",1,0],["أُنْظُرْ إليهِ والأصيلُ مؤَرَّسٌ","والشّمْسُ تُرْسِلُ منْ عِنانِ عَسيرِها",11,"ه",2,1],["اُنْظُرْ إلَيْها تَجِدْ حَبَّ المُلوكِ بِها","وقد حَكى نَوْرُها المُبْيَضُّ حينَ فُتِحْ",12,"ح",1,1],["اِنظُر إِلى كَفٍّ وَأَسرارِها","هَل أَنتَ إِن أَوعَدتَني صابِري",13,"ر",2,0],["إِنْ ظَلَّ بعد ثَلاثٍ رأْيُها شُعَباً","فجَرِّدِ السَّيفَ واضرِبْ في هَواديها",14,"ي",3,0],["انظُر إِلى زَهرِ الرَبي","عِ كَأَنَّهُ زُهرُ النَعائِم",15,"م",1,0],["انظُر إِليَّ بِعَينِ مَولىً لَم يَزَل","يولي النَدى وَتَلافَ قَبلَ تَلافي",16,"ي",1,1],["انظُر إِلى مَن كانَ قَبلكَ وَاعتَبر","سَتَصيرُ عَن كَثَبٍ إِلى ما صاروا",17,"ر",3,0],["أُنظُر تَرَ البَدرَ سَناً وَاِختَبِر","تَجِدهُ كَالمِسكِ إِذا ميثَ فاح",18,"ح",1,0],["أُنظُر إِلى مُحتَلَّنا","قَد زانَ ساحَتَهُ اِحتِلالُك",19,"ك",1,0],["اِنظُر إِليَّ فَإِنَّ النَفس قَد تَلِفت","وَارفُق عَليَّ فإنَّ الرُوحَ قَد زهِقا",20,"ق",2,0],["أُنْظُرْ إلى تُمْثِيلِهِمْ","أَفَمَا تَرَى عَجَباً عُجَابا",21,"ب",2,0],["أنظرت تقويض البناء","الضخم حين هوى عماده",22,"د",2,0],["أَنْظُرْ إِلَى أَحْدَائِهِمْ وَكُهُولِهِمْ","أُنْظُرْ إِلَى الفَتَيَاتِ وَالفِتْيَانِ",23,"ن",1,0],["أُنْظُرْ إِلَى البَادِينَ وَالخُضَارِ فِي","حَلَبَاتِهَا اسْتَبَقُوا لِغَيْرِ رِهَانِ",23,"ن",1,0],["أُنْظُرْ بِأَيْمَنِهِ إِلَى الرَّأْسِ الَّذِي","يُزْهَى بِرَوْعَةِ تَاجِهِ الرُّومَانِي",24,"ن",2,0],["أَنْظَل فِي قَيْدِ الْقُصَورِ وَغَيْرُنَا","مَلَكَ الطَّبِيعَةَ مِلْكَ أَقْدَرِ قَيِّمِ",25,"م",1,0],["اِنظُر إِلَيهِ وَإِلى ظَرفِهِ","كَيفَ تَطايا وَهوَ مَنشورُ",26,"ر",1,1],["أنظر لأفق جمال","به الأباريقُ تصعدْ",27,"د",1,1],["أنظر إلى الحسناء في رأد الضحا","تمشي فتلفح وجها الرمضاء",28,"ا",2,0],["أنظر الصورة التي انتزعتها","من يد العري ريشة الرسَام",29,"م",1,0],["أنظر ما فيه يحار الحجا","في الكون من عالٍ ومن سافل",30,"ل",1,0],["انظر لصرعة من رَقَيْتُ وطولها","فإذا نظرت فعند ذلك فاعذِل",31,"ل",1,0],["أنظر تجدْ شُعَب الحياة كثيرة","فيها من السعي الحثيث مَشاهد",32,"د",1,0],["اِنظُر خَليلي بِأَعلى ثَرمَداءِ ضُحىً","وَالعيسُ جائِلَةٌ أَغراضُها خُنُفُ",33,"ف",1,1],["اِنظُر لِضَعفي ياقَويُّ","وَكُن لِفَقري ياغَني",34,"ي",1,1],["أُنظُر إِلى زَهرِ الرَبيعِ","وَالماءِ في بِرَكِ البَديعِ",35,"ع",1,1],["أُنظُر خَليلي بِبَطنِ جِلِّقَ هَل","تُؤنِسُ دونَ البَلقاءِ مِن أَحَدِ",36,"د",1,1],["أنظر لخليك اللذين تحاربا","أدباً وهب لكليهما ما فاته",37,"ت",2,0],["أنظر إلى الدهرِ الذي ساقَ الورَى","خبراً بأقطارِ البلاد ومخبرا",38,"ر",2,1],["أنظر إلى وصفي وما حزته","من أربعٍ للعيشِ فيها نصوص",39,"ص",1,0],["أنظّم درّ الوصف من نظمها لها","وليس لألفاظي سوى رقّة السلك",40,"ك",1,0],["انظر لحبوته وأنعمه تجد","من جانبي رضوى سيولاً تفعم",41,"م",1,0],["أنظم الشعر وهو يبسم عجباً","ولهذا أتى به جوهريّا",42,"ي",2,0],["انظريها حول اليتيم فراشا","هزجا حول دافق اللالاء",43,"ا",2,0],["انظُر بعين العدلِ تُبْصرْ بها","أنك عن منهاجِه ناكبُ",44,"ب",1,0],["انظرْ إليهِ وإلى تدبيرهِ","فإن فيه عجباً من العَجَبْ",45,"ب",1,0],["انظر إلى بِنْتك يا خالدُ","يُخبركَ عن غائبك الشاهدُ",46,"د",1,1],["انظر إلى أحمدٍ ضرَّاطِ عسكره","هَلْ عابَهُ أحَدٌ أو عَدَّه أحَدَا",47,"د",2,0],["انظر إليَّ أبا الفوا","رِسِ يَسْهل الأمر العسيرُ",48,"ر",1,0],["انظر إلى الكلب مرميّاً لنعلم أن","لم تتَّركْ شَبهاً منه ولم تذر",49,"ر",1,0],["انظُرْ إلى أهليهمُ","فكذلك الباقون بعْدَك",50,"ك",1,0],["إن ظني فلا يقع دون ظني","همُّك الطامع البعيدُ المغالي",51,"ل",2,0],["انظر إلى الدهرِ هل فاتَتْهُ بُغْيَتُه","في مطمح النَّسرِ أو في مَسْبح النون",52,"ن",1,0],["انظر إلى الدنيا وزينتِها","ترَى الكارمَ فيها زِينةَ الزِّيَنِ",53,"ن",1,0],["أنظروني بني ثوابة حتى","أضَع الذَّمَّ والأمانة عنّي",54,"ي",1,1],["انظرْ إذا شئت إلى قرنه","وانظر إلى قائم سكينه",55,"ن",2,0],["انظرْ فإنكَ ناظرٌ بجلِيَّةٍ","هل في وزيرك عن وزيرك ناهي",56,"ه",2,0],["أُنظُري كَيفَ تَساوى الكُلُّ في هَذا المَكانِ","وَتَلاشى في بَقايا العَبدِ رَبُّ الصَولَجانِ",57,"ن",1,0],["أُنظُر فَإِنَّ الصُبحَ أَوشَكَ أَن","يَمحو ضِياءَ الأَنجُمِ الزُهرِ",58,"ر",1,0],["أُنظُر فَوَجهُ الأَرضِ أَغبَرُ شاحِبٌ","وَاِسمَع فَأَصواتُ الرِياحِ عَويلُ",59,"ل",1,0],["أُنظُر فَقَد خَلَتِ البُيوتُ مِنَ الشَبابِ","وَلا جَمالٌ لِمَنزِلٍ مِنهُم خَلا",60,"ل",2,0],["أُنظُر فَما زالَت تَطُلُّ مِنَ الثَرى","عُصورٌ تَكادُ لِحُسنِها تَتَكَلَّمُ",61,"م",1,0],["أُنظُر أَلَستَ تَراكَ في أَوهامِهِ","أَشقى وَأَتعَسَ مِنكَ في أَوهامي",62,"ي",1,0],["إِن ظَمِئنا وَعَزَّ أَن نَرِدَ الما","ءَ رَوانا تُصَوِّرُ الغُدرانِ",63,"ن",1,0],["أُنظُر إِلى الماءِ إِنَّ البَذلَ شيمَتُهُ","يَأتي الحُقولَ فَيَرويها وَيُحيِّها",64,"ي",3,0],["انظري اللَّيلَ فهو حلَّة الأَح","لامِ يمشي على الذُّرى والحُزُونِ",65,"ن",1,0],["انْظُرْ إلى شَفَقِ السَّماءِ","يَفيضُ عَنْ تِلْكَ الجِبَالْ",66,"ل",1,0],["انظر اليها فهي تحكي غادة","ترنو اليه من المحل الارفع",67,"ع",1,0],["انظر اليها فهي تشبه ماسة","لمّاعة منها عليها شاهد",68,"د",1,0],["انظر إلى الكواكب","يسبحن في الغياهب",69,"ب",1,1],["انظر اليه من قريب يبتسم","لك وابتسامات الحسان حسان",70,"ن",1,0],["انظر إلى إيران كيف تملصت","من خطة فيها أذى وهوان",71,"ن",1,0],["انظر إلى القصور كيف أصبحت","لم يبق من مقدَّم ولا أغا",72,"ا",1,0],["انظر إلى ثيابه","ولونها كيف آتحد",73,"د",1,0],["انظر إلى حذائهِ","من النظافة أتقد",73,"د",1,0],["انظر إلى السمسار يسحر الفتى","وانظر إلى الغلام كيف استحسنه",74,"ه",1,1],["أنظر الناس هل ترى لحياة","عَطَلت من نباهة الذكر معنى",75,"ن",2,0],["انظر وراءك هل تركت من الغنى","إلا المروءة ذكرها وثناءها",76,"ا",3,0],["أنظروا عند توافى جمعكم","تجدوا في الجمع جبريل الأمين",77,"ن",1,0],["أَنظر إِلى النيةِ ما تَأَتي بِهِ","وَالدِينِ ما وَراءَهُ مِن الوَفا",78,"ا",1,0],["أُنظُر إِلى أَيامِهِ النَواضِرِ","وَظِلِّها الوَارف في الحَواضِرِ",79,"ر",1,0],["أَنظُر فَإِن كُنتَ لِدينٍ ثرتَ","فَلا تُفارق ما إِلَيهِ سِرتَ",80,"ت",1,0],["أَنظُرُ في ديوانِ شِع،","،رٍ أَو كِتابِ سيرَةِ",81,"ه",1,0],["أُنظُر إِلَيَّ كَيفَ أَق","ضي لَهُمُ ما وَجَبا",82,"ب",2,0],["انظُر أَبا الفاروقِ غَرسَكَ هَل تَرى","بِالغَرسِ إِلّا نِعمَةً وَنَماءَ",83,"ا",2,0],["اُنظُرِ المُلكَ وَأَكبِر ما خَلَق","وَتَمَتَّع فيهِ مِن خَيرٍ رَزَق",84,"ق",1,0],["اِنظُرِ الآثارَ ما أَزيَنَها","قَد حَباها الخُلدَ مَن أَتقَنَها",84,"ه",2,0],["اُنظُر أَبا الفاروقِ غَرسَكَ هَلَ دَنَت","ثَمَراتُهُ وَبَدَت لَهُ أَعلامُ",85,"م",1,0],["اِنظُروا تَلقَوا عَلَيها شَفَقاً","مِن جِراحاتِ الضَحايا وَدِماها",86,"ا",3,0],["اِنظُرِ الكَونَ وَقُل في وَصفِهِ","كُلُّ هَذا أَصلُهُ مِن أَبَوَين",87,"ن",1,0],["اُنظُر إِلى الأَقمارِ كَيفَ تَزولُ","وَإِلى وُجوهِ السَعدِ كَيفَ تَحولُ",88,"ل",1,1],["اِنظُروا هَل تَرَونَ في الجَمعِ مِصراً","حاسِراً قَد تَجَلَّلَت بِسَوادِ",89,"د",1,0],["أُنظُرُهُ فَأَنتَ كَأَمسِ شَأن