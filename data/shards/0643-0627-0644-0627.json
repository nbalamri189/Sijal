,[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137279",""],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102503","البسيط"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22598","الكامل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70322","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93453","السريع"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58248","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201781","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201149","الكامل"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143689","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87476","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87477","الكامل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126923","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46012","الكامل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103806","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59448","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75714","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90851","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141657","الكامل"],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[4821,"غُرّةُ الكَوْن ذاتُ بِش","https://www.poetsgate.com/ViewPoem.aspx?id=120390",""],[4888,"تحية وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207745",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5060,"تسبيح النارنج","https://www.poetsgate.com/ViewPoem.aspx?id=214495",""],[5064,"بينَ .. بينَ","https://www.poetsgate.com/ViewPoem.aspx?id=199135",""],[5102,"الأطلس المعطاء","https://www.poetsgate.com/ViewPoem.aspx?id=13977",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5720,"أرض بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=202808",""],[5956,"آن الأوان إلى الخلاص من الرِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=192593",""],[5977,"لقاءات الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=213126",""],[4442,"نزعت تخط بكل نفنف","https://www.poetsgate.com/ViewPoem.aspx?id=171225",""],[6102,"رِقَّةٌ وَحشِيَّة !!","https://www.poetsgate.com/ViewPoem.aspx?id=184163",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["كَالآسِ أَخضَرَ نَضرَةً وَالوَردِ أَحمَرَ","بَهجَةً وَالمِسكِ أَذفَرَ طيبا",0,"ب",2,0],["كالأعاريب لم يروْا درْمك البُر","رِ فهم يُكبرون خبز الشعير",1,"ر",1,0],["كالأردشيريِّ الذي بَيَّنَتْ","في عُودِه حُرِّية المغرِس",2,"س",1,0],["كَالأَرضِ في دَوَرانِها","وَلَكَالمِظَلَّةِ في النُشورِ",3,"ر",1,0],["كالأَرض تمشي فوق تُرْبَتِها","المسرَّةُ والشَّبابْ",4,"ب",1,0],["كالأُسْدِ بأساً والبُدورِ إضاءَةً","والمُزْنِ جُواداً والجبالِ حُلُوما",5,"م",2,1],["كالأرض عفّنها المياه وصعّدت","منها السخونة في الهواء بخارا",6,"ر",2,0],["كَالأُسدِ إِن غَضِبوا وَالمَوتِ إِن طَلبوا","وَالسَيفِ إِن نُدبوا وَالسَيلِ إِن وَهَبوا",7,"ب",3,0],["كالأفقِ مبيضُّ الغمائمِ مشرقٌ","والشمسُ تلمعُ من وراءِ سحابِهِ",8,"ب",2,0],["كالأبْلقِ الفردِ لم يَرْكَنْ إلى طَمَعٍ","لفتحه قبلها عُرْبٌ ولا عَجَمُ",9,"م",1,0],["كَالأَجدَلِ الغِطريفِ لاحَ لِعَينِهِ","خُزَزٌ وَأَنتَ عَلَيهِ مِثلُ الأَجدَلِ",10,"ل",1,0],["كَالأَرحَبِيِّ المَذَكّى سَيرُهُ المَرَطى","وَالوَخدُ وَالمَلعُ وَالتَقريبُ وَالخَبَبُ",11,"ب",1,0],["كَالأَوحَدِ اِبنِ الجَدِّ كُرِّرَ ذِكرُهُ","فَأَتى عَلى تَكرارِهِ مُستَعذَبا",12,"ب",2,0],["كَالأَمَةِ الوَرهاءِ لا مائَها","أَبقَت وَلا أَبقَت أَذى البَطَرِ",13,"ر",1,0],["كَالأُمِّ لا تَجفو عَلى العِتابِ","فَأَمضِها مِن بَحرِكَ العُبابِ",14,"ب",1,0],["كَالأُقحُوانِ غَداةَ غِبَّ سَمائِهِ","جَفَّت أَعاليهِ وَأَسفَلُهُ نَدي",15,"د",2,0],["كَالأَدهَمِ الجاري مَضى فَإِذا","آثارُهُ بِمَفارِقي غُبرُ",16,"ر",1,0],["كالأرض أُبصرها موا","تاً بين دجلة وَالفرات",17,"ت",1,0],["كالأمس ضَجَّتْ فهل أسمَعْتَ هاتفها","صدى هُتافكَ في جنّات رضوانِ",18,"ن",1,0],["كالأضاةِ المُفْضاةِ يَنْفِرُ عنها الضْ","ضبُّ أنْ ظَنّها غَديراً مَطيرا",19,"ر",2,0],["كَالأَنْبِيَاءِ وَمَنْ تَأَثَّرَ إِثْرَهُمْ","مِنْ عِلْيَةِ العُلَمَاءِ وَالحُكَمَاءِ",20,"ا",2,0],["كالأهازيجِ في الوَغى تترجّع","إن ثائرٌ ثار",21,"ر",1,0],["كالأُرجوان وُجُوُهُهُمْ","وقلوبُهم كَالْقَار سُود",22,"د",1,0],["كالأفق إن غام في جَنوبٍ","هبّت شَمالٌ له فأضحىَ",23,"ح",2,0],["كالأمنِ للملهوف من أعدائه","والوَصْلِ للمهجور من أحبابه",24,"ب",2,0],["كَالأُقحُوانِ بِضاحي الرَوضِ صَبَّحَهُ","غَيثٌ أَرَشَّ بِتَنضاحٍ وَما نَقَعا",25,"ع",2,0],["كالأرض جاد عليها الغيث منهملاً","فزانها بضروب الرّوض والزَهَر",26,"ر",1,0],["كَالأَجَلِّ المُوَفَّقِ اِب","نِ الدَوامِيِّ ذي المِنَن",27,"ن",1,0],["كالأفعوان على قضيب كثيبه","لا يرتجى لسليمه أن يسلما",28,"م",2,0],["كالأفعوان للامسى أعضائها","خشنت طبائعها ولأنت ملمسا",29,"س",2,0],["كالأمير الخطير يتقد الباس","ويندى براحتيه السماح",30,"ح",1,0],["كالأنسِ في حزن ومثل العدل في","ظلمٍ ضياؤكَ لاحَ في الأرجاء",31,"ا",2,0],["كَالأُمَّهاتِ أَوَتْ إِلَى أَطْفَالِها","فَرَمَت عَلَيْها الرِّزْقَ مِنْ قُمصَانِها",32,"ن",3,0],["كالأمنِ في قلبِ المروع الشارِد","للّهِ عَهدٌ مُحْكَمُ المَعَاقِد",33,"د",1,0],["كَالأَشرَفِ المَلكِ القيل الَّذي خَضَعَت","شوسُ المُلوكِ لَهُ تَحنو عَلى الركبِ",34,"ب",1,0],["كَالآلِ يَجهدُ ظَمآناً يُيمّمهُ","وَالماءُ في مِصرَ وَالظَمآن في حَلَبِ",35,"ب",1,0],["كالأرضِ يُمْسِكُها ألاّ يَزال يُرَى","من حَولِها فَلَكٌ يُحْتَثُّ دَوّار",36,"ر",1,0],["كَالأَجدَلِ الطّالِبِ رَهوَ القَطا","مُستَنشِطاً في العُنُقِ الأَصيَدِ",37,"د",1,0],["كالأَجْدَلِ الغِطْرِيفِ يَحْمِلُ سَرْجَهُ","سامِي التَّليلِ كما اشْرَأَبَّ الأَجْدَلُ",38,"ل",1,0],["كالآلِ في النّعْتِ كالضّياءِ كسح","ا البَيْضِ يبدو كالبرقِ في لُمَعِهْ",39,"ع",2,0],["كالأثْرِ مسُّ صِفاحه والروح بي","ن رياحِه والدّرِّ فوق نِصاحه",40,"ح",2,0],["كالأجلِّ الإمامِ أحمدَ مَن أص","بَحَ كالبدرِ لاح في الديجورِ",41,"ر",1,0],["كالأجدل المنقضّ لكن صيدهُ","تحت العجاج لحاسرٍ ومقنّع",42,"ع",1,0],["كالأكَم اغتصَّت بها","تشرَق منها الأكمُ",43,"م",1,0],["كالأنابيب اتصالا كلّما","قلت تمّ الفضلُ فيهم وكمَلْ",44,"ل",1,0],["كَالأَيمِ ذي الطُرَّةِ أَو ناشىءِ ال","بَردِيِّ تَحتَ الحَفَإِ المُغيِلِ",45,"ل",1,0],["كَالأَسودِ الحَبَشِيِّ الحَمشِ يَتبَعُهُ","سودٌ طَماطِمُ في آذانِها النُطَف",46,"ف",1,0],["كَالآلِ يُطمِعُ لامِعاً مُتَقرِّباً","وَلِمَن أَتاهُ زُفرَةٌ وَشَهيقُ",47,"ق",1,0],["كَالأُسْدِ بَأْسَافِي الوَغَى","والغَيْثِ إِنْ عَمَّ القَحَطْ",48,"ط",1,0],["كالأمر منه في الذي نصبتم","لأنكم بأمره قدمتم",49,"م",1,0],["كَالأُقحُوانِ مَراتُهُ","وَمَذاقُهُ لِلذائِقِ",50,"ق",1,0],["كالأفعوان يشتفي من سُمِّهِ","بشُرب درياقِ كريح لَحْمِهِ",51,"ه",1,0],["كَالإِمام الصدّيق ثُمَ أَبي حف","ص الَّذي عم عَدلُه وَتُقاه",52,"ا",2,0],["كالأفعوانِ إذا تبيَّغَ ريقُهُ","خلنا به السمَّ الذعافَ تبيّغا",53,"غ",2,0],["كَالأُمَّهاتِ المُرضِعاتِ رضيعَها","أَفَلا تَراها أَرضَعَته دُخانَها",54,"ه",2,0],["كالأسد بأساً وكانت دونه كرماً","إذ كان لم يتبع في الحرب منهزما",55,"م",2,0],["كالأقحوانِ غداة غبّ سمائه","غيث أعاليه وأسفله ندِ",56,"د",1,0],["كَالأَقْطَعِ الكَفِّ اتَّقَى بِالكُوعِ","شارَكَ أَهْلَ النارِ في الضَرِيعِ",57,"ع",1,0],["كالأسبر الموصوف ثم البازي","ثم الجرا الوافي الجهاد الغازي",58,"ي",1,0],["كالأَقحوان سَقاهُ أَرى رُضابِه","وَجَلاه مِن صبغِ السَوادِ بنفسج",59,"ج",1,0],["كالابحر","من يقل كفك سحب او بحار",60,"ر",1,0],["كالأمر والنهي والتمني","والعرض والجحد والدعاء",61,"ا",2,0],["كالابتداء للتي تأخرت","في جمعها والبسط قد تقررت",62,"ت",1,0],["كالأَسد تنقلهم جُرد مُسموّمة","عليهم حَلقُ الماذيِّ مَسْرودُ",63,"د",1,0],["كَالأَرْضِ أَرْضِ الكُفْرِ لَمَّا حَلَّهَا","جَيْشُ ابْنِ نَصْرٍ بُدِّلَتْ تَبْدِيلاَ",64,"ل",2,0],["كالارضِ تجري ونحنُ نبصرُها","ساكنةً كالعقولِ في مصرِ",65,"ر",1,0],["كالأيْكِ مُشْتَبِهاتٌ في منابتها","وإنما يقعُ التفضيلُ بالثَّمر",66,"ر",1,0],["كالأسَدِ الوَرْدِ وما حُجَّتِي","إن لم أقُلْ كالعارضِ الوَبْل",67,"ل",1,0],["كالالمعي سعيد الجد خير فتى","به مرام النهى والفضل قد نجحا",68,"ح",2,0],["كالأُسدِ تَنقَضُّ انقضاضَ صواعقٍ","تجتاحُ ما تَلقاهُ من بُنيَانِ",69,"ن",1,0],["كالأسد في غاب القنا يقدمهم","منه إلى الروع هِزَبْر أَغلب",70,"ب",1,0],["كالأنبياءِ ومن جرى مجراهمُ","من وارثٍ أمنوا بها من فصمته",71,"ت",2,0],["كالإمام الهمام مفرد عصر","لعلوم شتى كذاك الأصول",72,"ل",1,0],["كَالاستِوَاءِ مَعَ التَّكَلُّمِ هَكَذَا","لَفظُ النُّزُولِ كَذَاكَ لَفظُ يَدَانِ",73,"ن",1,0],["كالاصل والتمكين والتفأل","وقد يفيد الاختصاصان ولي",74,"ي",1,0],["كالأمِّ تندب طفلها","والموتُ صار حليفه",75,"ه",1,0],["كَالأَطلس السرحان إِن تَغفل لَهُ","عَين فأخري عِندَهُ لا تَغفل",76,"ل",1,0],["كالأُقحُوانِ يَرِفُّ عَن غِبِّ النَّدى","في السَّهلِ بَينَ دَكادِكٍ وَرِمالِ",77,"ل",1,0],["كَالأُسد تَحسبهم إِذا وَثَبوا وَإِن","رَكبوا الصوافن خِلتهم عِقبانا",78,"ن",2,0],["كالارز في لبنان زاكٍ عرفه","ومخلد في مصر تخليد الهرم",79,"م",1,0],["كالأهدل الحبر من وافي بشهرته","كيوان دع عنك مجرى دارة الحمل",80,"ل",1,0],["كَالأقحُوانِ لِغِبِّ سارِيَةٍ","جُنَحَ العِشاءِ يُنيرُ في الظُّلمِ",81,"م",1,0],["كالأَرض ملقىً فوقها أَقذارُها","أَبداً وتُنْبتُ ما يرُوقُ المنظرَا",82,"ر",2,0],["كَالأَعينِ الحورِ مجاذيفُها","مِن حَولِها أَشفارُ أَجفانِ",83,"ن",1,0],["كالأشهب المكّيِّ وهو يفوقُ في","حُسنٍ صواحبَ هذه الأَلقاب",84,"ب",1,0],["كالابن بين عقوقه أو بِرّه","ألقى أباه بحيرة ووجيب",85,"ب",1,0],["كالأغنياء قد امتلت أكياسهم","لكنهم ليسوا من الأكياس",86,"س",1,0],["كالأنبجاني مصقولاً عوارضها","سوداء في لين الغادة الرّود",87,"د",1,0],["كالأرض لا يجديك صافي لونها","حتىّ يكدَّرَ بالسَماد القاتم",88,"م",1,0],["كالارض لا تجديك سهلاً مستوٍ","لِغلالها حتىّ تُثارَ وَتُحرَثا",89,"ث",2,0],["كالاقحوان هم بالجفاف","تعرفها الاعراب بالاثاف",90,"ف",1,0],["كالأَرقمِ النضناضِ ليسَ يَروعهُ","ناب وَلا يلوى به أظفورُ",91,"ر",1,0],["كالأنجم نجم الشهب منها أوجه سطعت","بل اين منهن نور الأنجم الشهب",92,"ب",1,0],["كَالأَشعَثِ البَدَوِيِّ قائِدِ غارَةٍ","غَزواً عَلى اليَعبوبِ غَيرَ لَهيدِ",93,"د",1,0],["كألاته سهراً وبات مكالئي","حتى رأيت اللحئ منه كليلا",94,"ل",2,0],["كالاجدل الغطريف في","تَوثابِه أو كالعُقابْ",95,"ب",1,0],["كالأقحوانة إِذ غدت أَطرافها","بيضا تحف بهالة صفرا",96,"ا",1,0],["كالأسم أعرابه للَه منخفض","لديه مرتفع للفضل منتصب",97,"ب",1,0],["كالإذن أن أحكّت تهيج أختها","وتظل هائجة إذا لم تفعل",98,"ل",1,0],["كالأنجمِ الزُّهرِ بثوب السما","الحَسَنُ السبطُ بدا كوكبا",99,"ب",2,0],["كالإمام الهمامِ سيدنا يو","سفَ مَنْ شادَ للمفاخِر ذِكْرا",100,"ر",2,0],["كالأمِّ حينَ تَضُمُّنا بحنانِها","تَروي النُّفوسَ تُبدِّدُ الآلاما",101,"م",2,0],["كالأرجوانِ هما ومن لونيهما","يسقي الغروبُ سماءَنا والمشرِقُ",102,"ق",1,0],["كالأغنياتِ السُّكارى.. حين تسرقنا","من ثقبِ نايٍ.. كأنَّ النايَ.. مبحوحُ",103,"ح",1,0],["كالأرضِ إِذْ تهتزُّ بَعدَ خشُوعِهَا","قَدْ أنبَتْتْ بالمَاءِ عُشبًا أخضرَا",104,"ر",2,0],["كالأم ترفع طفلها بسّامةً","فيعود للأحضان بالقبلاتِ",105,"ت",1,0],["كالأيم في حافاتها تهوى إلى","رحوى غدير باللحين ممرد",106,"د",1,0],["كالآي في حِكم والنور في حَكم","والبحر في كرم والدهر في همم",107,"م",1,0],["كالأفعوان تمج السم ريقته","من الوجار وثوبا للردى خرجا",108,"ج",2,0],["كَآلِ أَحمَدَ رَبُّ العَرشِ طَهَّرَهُ","طَيَّ العَباءَةِ زالَ الرِجْسُ وَأنقَشَعا",109,"ع",2,0],["كالأحمق الجربان أخرج عورة","كانت له دوما لسانا مخفقا!!",110,"ق",2,0],["كالأشهبِ الضَبّاح تلك حياتنا","كَرٌ وفرٌ مُقبِلٌ وحَرونُ",111,"ن",1,0],["كالأمِّ بَاذِلةِ المحبةِ والندىٰ","من خير ربٍ مُنعمٍ جوَّادِ",112,"د",1,0],["كالأمِّ تغذو طفلها من نفسها","ليصير حيّاً من دماها مخصبا",113,"ب",2,0],["ك الأبيات أنظمها وأهدي","حروف المجد في حرم الجمالِ",114,"ل",1,1],["كالأيم تلتقط الفجاج","أو العقاب إذا تخطف",115,"ف",1,0],["كَالأَرنَبَينِ إِذا قَدِ انكَمَشا","فَرَّا! وَعادا لِي إِذا انبَسَطا!",116,"ط",2,0],["كالأُفْعُوانِِ يبُثُّ سُمّاً قاتلاً","وتعينُهُ عَضَلاتُهُ في نَشْرِهِ",117,"ر",2,0]]}