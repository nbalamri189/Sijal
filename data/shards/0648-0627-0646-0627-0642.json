{"poems":[[55,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[73,"ما اسم إذا صحفوه كان مجلبة","https://www.aldiwan.net/poem3873.html","البسيط"],[85,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[91,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[51,"كل رزق أرجوه من مخلوق","https://www.aldiwan.net/poem62192.html","الخفيف"],[46,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[71,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[71,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[83,"يمثل لي نهج الصراط بوعده","https://www.aldiwan.net/poem61533.html","الطويل"],[50,"وفي الديوان غزلان","https://www.aldiwan.net/poem64362.html","الهزج"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[48,"ترج بلطف القول رد مخالف","https://www.aldiwan.net/poem22648.html","الطويل"],[48,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85396","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[136,"أم النبي إذا ما أزمعت ظعنا","https://www.aldiwan.net/poem54725.html","البسيط"],[136,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[147,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[230,"تدفق دموعا أو دما أو قوافيا","https://www.aldiwan.net/poem55094.html","الطويل"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[310,"ألا يا صبا نجد متى هجت من نجد","https://www.aldiwan.net/poem56564.html","الطويل"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[443,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[445,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[445,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[445,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[458,"إن نالني السقم لم يبلغ بي الجزع","https://www.aldiwan.net/poem61292.html","البسيط"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[482,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[505,"رأيت رسول الله سبعين مرة","https://www.aldiwan.net/poem37969.html","الطويل"],[505,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[534,"يا زينة الدهر وعين الوجود","https://www.aldiwan.net/poem37439.html","السريع"],[556,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[563,"بالله يا من رماني بالصد والهجران","https://www.aldiwan.net/poem33846.html","عموديه"],[563,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[572,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34427","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48827","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48821","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104623","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64121","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38027","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70726","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59776","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146412","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62575","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203746",""],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67741","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56182","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115997","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100976","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130573","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114703","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2140,"","https://poetry.dctabudhabi.ae/diwan/poem/31482","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27388","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27275","الهزج"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124675","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115501","الوافر"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140308",""],[3120,"","https://poetry.dctabudhabi.ae/diwan/poem/22613","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121795","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112288","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138443",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77733","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202338","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86468","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119655","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135098","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58161","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4750,"ألا يالهبوب البارده","https://www.poetsgate.com/ViewPoem.aspx?id=180442",""],[4802,"خليل أنا عندي حكي","https://www.poetsgate.com/ViewPoem.aspx?id=33011",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4881,"فنجان قهوتي","https://www.poetsgate.com/ViewPoem.aspx?id=181729",""],[4883,"ميزاج","https://www.poetsgate.com/ViewPoem.aspx?id=48402",""],[4883,"قصيدة حب","https://www.poetsgate.com/ViewPoem.aspx?id=48366",""],[5075,"الله مولانا","https://www.poetsgate.com/ViewPoem.aspx?id=190435",""],[5096,"شوق يعنينا","https://www.poetsgate.com/ViewPoem.aspx?id=209127",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5136,"ثقتي أنت يا كريم الذات","https://www.poetsgate.com/ViewPoem.aspx?id=121530",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5273,"فنجان قهوة","https://www.poetsgate.com/ViewPoem.aspx?id=198524",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5302,"ذنوب وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=202728",""],[5463,"قالتها سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=34514",""],[5720,"تَهَامِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204870",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6144,"سي المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=21836",""]],"verses":[["وَإِن أَقعَدَتكَ النائِباتُ فَطالَما","سَرى موقَراً مِن مَجدِكَ المَلَوانِ",0,"ن",1,0],["وإنِ اقتَرَبْتُ أوِ اغْتَرَبْتُ فإنّني","لهِجٌ بشُكإِ عَوارِفٍ لا تُكفَرُ",1,"ر",1,0],["وَإِنّا قَد وَنينا وَاِنقَسَمنا","فَلا سَعيٌ هُناكَ وَلا وِئامُ",2,"م",1,0],["وَإِن أُقِرَّ عَلى مَفهومِ صيغَتِهِ","وَلَم يُخِلَّ بِهِ التَغييرُ كانَ أَذى",3,"ذ",2,0],["وإن أقلعت سُحْبُ الحيا وتقشَّعت","فقد نشأَتْ منها غمائمُ وُكَّفُ",4,"ف",1,0],["وَإِنّا قَد يُرى ما نَحنُ فيهِ","وَنُسحَرُ بِالشَرابِ وَبِالطَعامِ",5,"م",1,0],["وإنا قد عشقنا الموت لما","سمعنا ذكره فمتى اللقاء",6,"ا",2,0],["وأن أقوم من تراب","ي نابتاً كالعنم",7,"م",1,0],["وَأَنا قائِلٌ وَأَستَغفِرُ اللَ","هَ مَقالَ المَجازِ لا التَحقيقِ",8,"ق",1,0],["وَإِن أَقدَمَت يَوماً عَلَيهِ رَزِيَّةٌ","تَلَقّى شَباها وَهوَ بِالصَبرِ دارِعُ",9,"ع",1,0],["وإنْ أقلْ امسحْ لي مداسي يقلْ صهٍ","أتنصرُ إبليساً عليكَ وما النصرُ",10,"ر",1,0],["وإنْ أقمتَ الواوَ في الكلامِ","مِنْ صدغهِ نابتْ منابَ اللاّمِ",11,"م",1,0],["وَإِن أُقِدَ المِصباحُ ظَنَّتهُ بارِقاً","يُحَيّي فَهَشَّت لِلسَلامِ وَرَدِّهِ",12,"د",2,0],["وَإِن أَقرَضَ ذا هَذا","نَوالاً عَجَّلَ النَقضا",13,"ض",2,0],["وَإِن أَقبَلتِ فَالعَينا","نِ هاروتٌ وَماروتُ",14,"ت",1,0],["وَإِنَّ اِقتِناعَ النَفسِ مِن أَحسَنِ الغِنى","كَما أَنَّ سوءَ الحِرصِ مِن أَقبَحِ الفَقرِ",15,"ر",1,0],["وَإِن إِقبالُ قَومٍ زالَ عَنهُم","فَما يُغني المَعاشِرُ مِن قِبالِ",16,"ل",1,0],["وأن اقتحام الهول أقصر مسلك","إلى المَجد إلا أنه متوعر",17,"ر",1,0],["وإنَّ أقوَى ساعدٍ عاجزٌ","أن يُمسكَ المجدافَ دون اضطرابْ",18,"ب",1,0],["وأنّا قَدْ أَتَيْنَاهُمْ بِزَحْفٍ","يُحِيطُ بِسُورِ حُصْنِهُمُ صُفُوفَا",19,"ف",2,0],["وإِن أقَامَت هُنَا دَهراً أقَمتُ هنا","دَهراً وإِن سَئِمت هُنَا سَئِمتُ هُنَا",20,"ن",2,0],["وإِنَّا قَد عَلِمنَا أنَّ رُشداً","جُمُودُ الدَّمعِ لَكِن ما أُستُطِيعَا",21,"ع",2,0],["وَإِن أَقعَدَتنِيَ عَنكَ الخُطوبُ","فَعِندي ثَناءٌ يُديمُ السَفَر",22,"ر",1,0],["وإن أقبح ما كن اعتقادكم","إن العبادة في شيء من الطرب",23,"ب",1,0],["وَإِن أَقُل كُنتُ ذا مالٍ فَمَزَّقَهُ","صَرفٌ مِنَ الدَهرِ ما يَنفَكُّ يَلحانا",24,"ن",2,0],["وَأَن أُقفِلَ البابُ الذي كنتَ عندَه","تُقابِلُ مَلهوفا وَتَرصُدُ شاكيا",25,"ي",2,0],["وَإنْ أُقَصِّرْ فَلا ذَنْبٌ لِمُجْتَهدٍ","يَكْبُو الجَوَادُ إِذا مَا طَالَ مَيْدَانا",26,"ن",2,0],["وَأنّ اِقترابَ الدارِ إِن كانَ ممكناً","يَملُّ وأنَّ النأيَ يُشفي من الودِّ",27,"د",1,0],["وَان أَقَمت دَليلاً","فَهو الدَليل المقَوّم",28,"م",1,0],["وإن اقفرت منه المغاني فذكره","تغنى به الركبان في المهمة القفر",29,"ر",1,0],["وإِنَّ أَقطعَ وَصَّالٍ لواصِلِهِ","غَدْرٌ لطاغِيَةِ الإِشراكِ وَصَّالُ",30,"ل",1,0],["وإِنْ أَقمْتَ أبا مَرْوَانَ سُنَّتَها","شَجْواً فَذُو اللُّبِّ فِي السُّلْوانِ يَبْتَدِعُ",31,"ع",1,0],["وإِنْ أَقْبَلُوا والمِسْكُ يندى عَلَيْهِمُ","أَتَيْتُ وَقَدْ ضُمِّخْتُ مِسْكاً من الوحْلِ",32,"ل",1,0],["وأن أقطع أذنابا لها مرنوا","على الفجور وقالوا فجرهم ورع",33,"ع",1,0],["وإن أُقمْ فسائراتٌ شرَّدٌ","يَزُرن عنّي أبداً من لم أَزُرْ",34,"ر",1,0],["واِنْ أقبلتْ زرقُ الأسنَّةِ شرَّعاً","وعاينتَ في أطرافِها الموتَ أحمرا",35,"ر",2,0],["وأنا قد فتحناها","بكف العدل أختاما",36,"م",2,0],["وأن أَقطَعَ الأَلبابَ عن رِبْقَةِ الهَوَى","وأَفعَلَ عندَ الأَمرِ بالعزمِ والصَّدْعِ",37,"ع",1,0],["وإنَّا قد اختَرْنا على الأَينِ صُحبَةً","لمشهدِكُمْ عن كلِّ خلٍّ وصاحِبِ",38,"ب",1,0],["وإنْ أَقُلْ ذَا القَطْعُ والصَّرْمُ مِنْ","عَادَاتِ ذا الصّارِمِ قامَتْ رُدودْ",39,"د",1,0],["وإنْ أقمتَ مقاماً واحداً فبما","شَنَنْتَ نحو المعالي النَّصَّ والعَنقا",40,"ق",2,0],["وإن أقل أنت غيرى فقد زعمت شريكاً","لأن ذاتك تأبى يكون معها ثانْ",41,"ن",1,0],["وإن أقل يا روح روحي يقل","ذلك نوري من له أوحي",42,"ح",2,0],["وإِنْ أُقِمْ سوقَ إِطْرَابِي فلا عَجَبٌ","هذا بِذَاكَ إذَا مَا قَامَ نُوَّاحِي",43,"ح",2,0],["وَإِنَّ أَقبحَ من ذنب ومن خَطأ","إِصرارُ فاعله من بعد ما يَثِبُ",44,"ب",1,0],["وإن أقاموا وهم في الضيق مؤتمراً","فليس إلا لتمويه وتهوين",45,"ن",1,0],["وإن أقام ففي أرضٍ إلى أجلٍ","لا في قلوب وآذانٍ وأبصار",46,"ر",1,0],["وان أقبلت شُهبُ الجِيادِ مُغيرةً","ثنتها بأطرافِ الأسنَّةِ كالشُّقرِ",47,"ر",1,0],["وإن أقبلَ الصيفُ أبْصَرْتَهُ","ذليلاً حقيراً حزيناً كئيباً",48,"ب",2,0],["وَإِنَّ اِقتِرانَ الجِنسِ في غَيرِ جِنسهِ","عَذابٌ أَليمٌ عِندَ ذي العِلمِ والعَقلِ",49,"ل",1,1],["وإن أقِسْ جودَ وَهَّاسٍ بأيسرِ ما","أوليْتَنِي قلَّ عندي جود وَهَّاس",50,"س",1,0],["وأن أقسموا أن العهود تُنوسيت","فلا أجزلت للوصل حظاً ولا قسماً",51,"م",2,0],["وإن أقطب وجهي حين تبسم لي","فعند بسط الموالي يحفظ الأدب",52,"ب",1,0],["وإنَّ اقتحامي للشدائد والفلا","لَيَسْهُلُ في لُقْيا الكريم محمدِ",53,"د",1,0],["وانا قفر كفورٌ","كارهٌ حتى السما",54,"م",2,0],["وَإنَا قَدْ وَجَدْنَا أمَّ بِشْرٍ","كَأمّ الأسْدِ مِذْكارا وَلُودَا",55,"د",2,0],["وإن أقام لاطرادٍ قوايمه","قامت قيامة قوم منه قد ذعروا",56,"ر",3,0],["وَأَنا قُرَّةٌ لِعَينِ صَديقي","وَقَذَىً في مَحاجِرِ الأَعداءِ",57,"ا",2,0],["وأن أقولَ وفيك العدلُ أجمعُهُ","ولم أقُل ما رَجَونا عدلَهم ظلمُوا",58,"م",3,0],["وإن أقاموا فأطوادٌ تلوذ بها","عصم النهى بين مزجور ومطرود",59,"د",1,0],["وَأَنَّ أَقاليمَ العِراقِ فَقيرَةٌ","إِلَيها أَقامَت بِالعِراقِ تَجودُها",60,"د",3,0],["وإن اقتباس العلم منه وأنَّهُ","إذا كان منه الرأي لم يتعقب",61,"ب",1,0],["وإن اقتصرتُ فقد كَفاني وَصفها","بَيتٌ عليَّ من اللّيالي مُعلَمُ",62,"م",1,0],["وَإِن أَقَمتُ أَفانِينَ البَديعِ حُلىً","لِمَدحِهِ فَبِبَعضِ البَعضِ لَم أَقُمِ",63,"م",1,0],["وَإِنّا قَد قَتَلنا مَن عَلِمتُم","وَلَستُم بَعدُ في قُفٍّ حَصينِ",64,"ن",1,0],["وإن اقتدى فيه بإخوة يوسفَ","فلذاك حكمٌ كلنا ندريه",65,"ي",2,0],["وإن أقبلتُ يأتيني","وإن أعرضت ُيدعوني",66,"ن",2,0],["وان اقليدس يوماً حلها","من قبل ان يعرف منها فضلها",67,"ه",2,0],["وأنا قبلةُ الحديثِ فلفظٌ","يبتغيني والُف لحظٍ يشير",68,"ر",1,0],["وإنا قد لقينا القومَ طُرّا","وطال الأمرُ واتّصلَ الطرادُ",69,"د",1,1],["وإن أقمت سجيناً في حدائقه","كرهاً فيا حبذا دار المساجين",70,"ن",1,0],["وَأَنّا قَبيلٌ في عَصانا صَلابَةٌ","إِذا زُعزِعَت أَحلامُنا لَم تُزَعزَعِ",71,"ع",1,0],["وأنا قد رأيتُ رُقْيةَ فَقْرِي","حين ألْقاكَ أن أقولَ السَّلامُ",72,"م",1,0],["وأنا قطب الرجا بيت القصيد","إن تراخت همّتي الجيش انهزم",73,"م",1,0],["وَإِن أَقل إِنَّني سَأصبح لل","أنس لَوى بي للحزن إِمسائي",74,"ا",2,0],["وَاِن اِقسَمت لي ان اعيش مُتَيَّماً","فَشَوقي لَها بَينَ المُحِبّينَ شائِع",75,"ع",1,0],["وأنا قد أطعت أمرك في الآل","علي وآله الأطهار",76,"ر",1,0],["وان أقتل داء وقع نازلة","يضي فيه شجاً صدر الفضا الرحب",77,"ب",1,0],["وإنّ أقلَّ حظٍّ يُبتغى من","رضاكَ يفي بملْك الحارثينِ",78,"ن",1,0],["وإن أقامك في حال فقف أدباً","وإن دعاك مع التمكين تأتيه",79,"ي",2,0],["وإن أقسمت بالليل خاضت حمامه","قتلت بسيف الصبح من قبل حينه",80,"ن",2,0],["وَأَن أُقَلِّدَك النُصح الَّذي أَخَذت","بِهِ العُهود عَلى تَبليغ مُمتَثَل",81,"ل",1,0],["وأن أقض بحبك مستهاما","فكم قبلي قضى صبح معنىً",82,"ن",2,0],["وأن اقيم بعد حجي حِقَبا","فيها وأنفي عن فؤادي كُرَبا",83,"ب",2,0],["وإن أقاد في هجروا محلّي","وحبل الوصل قد قطعوه دوني",84,"ن",2,0],["وان أقل ما فيه من جميل","من جمل تغني عن التفصيل",85,"ل",1,0],["وإن أقَلَّنَا عقلاً فتًى مَنْ","على الدنيا يقاتِلُ أو يُدَاني",86,"ن",2,0],["وإن أقام منه سالت ديَمٌ","بالعلم والجدوى همت أنواؤها",87,"ا",3,0],["وأنا قانعٍ باللي علي كاتبه ربي","ومؤمن بمقدوره وقانعٍ بمكتوبه",88,"ب",2,0],["وانا قنعت بمدها دام الزمن معنا دخيل","ولازلت اهيم من الوله لاجل ... بضحكة هامسة .",89,"س",2,0],["وان اقبلت شعوا حربن فاني","لي ضربتن تدوي لها الاجرامي",90,"م",2,0],["وأنا قد جئتُ أحميه...لذا","هو بالبشْرِ أمامي مفعمُ",91,"م",1,0],["وانا قلبي صخر ياللي تْعقْد مْن العتاب حجا","على بال ٍ مثل صبّ البْرد في كاس ميزاجه!",92,"ج",2,0],["وأنَا قَلبيْ وطَنْ أرضَهْ سمَاكْ وبيتَهْ الكُراس","جبِينَك شَمسَهْ فْ صُبحَ الوَلَهْ وجْروحَكْ شعوبهْ",93,"ب",2,0],["وَإِنْ أَقَمْنَا عَلَى الأَحْزَانِ وِجْهَتَنَا","حَتَّى عَمِينَا فَأَدْمَيْنَا مُحَيَّانَا",94,"ن",2,0],["وإنَّا قدْ رأيْنا مجْلساً منْ","أناسٍ فيهمُ الخير المبينا",95,"ن",2,0],["وَأَنَّاْ قَدْ مَلَأْنَاْ الْأَرْضَ قُبْحَاً","وَوَغْدَاً سَاْدِرَاً دُنْيَاْ وَدِيْنَاْ",96,"ن",2,0],["وَأَنَّاْ قَدْ شَنَقْنَاْ الْعَدْلَ مَقْتَاً","وَقَدْ رُحْنَاْ لِكِفِّهِ قَاْسِطِيْنَاْ",96,"ن",2,0],["وأنا قد هتفت باسمك أدعوك","لما همني من الواردات",97,"ت",1,0],["وإن أقد فبالهدى لما عنى","أهل الهدى لا ما عنى أهل الهوى",98,"ا",1,0],["وأنا قُبالَةَ حسنِها دَنِفٌ","يَختالُ فِيَّ اليأسُ والأمَلُ",99,"ل",1,0],["وَأنْ أقْبَلَتْ لَيْلة كَالصّبا","فَقُلْ يا فتاة غَرامي: (هَلا)",100,"ل",2,0],["وإن اقترفنا ما اقترفنا ليس من","أمل سوى أن ندعو الرحمنا",101,"ن",2,0],["وأنا قتلت الفؤاد اللي غدا جمره","وأبيها تعفو بيمناها عن الجاني",102,"ن",2,0],["وَإِنْ أَقْبَلَتْ تَمْشِيْ .. تَمَنَّيْتُ قُرْبَهَا","لَأَلْحَظَ هَٰذَا الْحُسْنَ .. قَدْ زَادَهَا قُرْبَا",103,"ب",2,0],["وإن اقتصّ منهم ما جنوه","وقام العدل فيهم والقضاء",104,"ا",2,0],["وَ أَنْ أَقُولَ لَها : ( عُودِي ؛ فَقَدْ هَلَكَتْ","يا أُمُّ ؛ نَفسِيَ فِي أَقوالِ مَنْ كَذَبُوا",105,"ب",3,0],["وأنا قريبٌ في المتاهةِ بيننا","زمنٌ أريدُ لهُ النَّفيرَ فيقرُبُ",106,"ب",1,0],["وإنْ أقمتُ صلاتي قلتُ مُفتتحاً","اللهُ أكبرُ باسم المجلس البلدي",107,"د",2,0]]}