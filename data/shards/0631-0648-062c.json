{"poems":[[290,"روجت نفسك حسبما","https://www.aldiwan.net/poem39367.html","مجزوء الكامل"],[315,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98202","السريع"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87719","الخفيف"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128104","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139673",""]],"verses":[["روجت نفسك حسبما","قلنا لذا نلت الطلب",0,"ب",1,1],["روجوا في شأني غرائب زور","نصبوها لأمرهم أحبوله",1,"ل",2,0],["روّجْ لراجيك ولو حبّةً","واقعُدْ على العرشِ من التّيهِ",2,"ي",2,0],["رَوّجُوا من جهلهم إذ علموا","أنّ سُوقَ النّبل والفَضل كَسَد",3,"د",1,0],["رَوَّجوا الفُسق وَالفَجور وَقالوا","تِلكَ فينا مَظاهر المَدنيَّه",4,"ي",2,1],["روجت سوق الشعر بعد كساده","فصبت لسوق عكاظه الشعراء",5,"ا",2,0],["روَّجتَ سوق العلم في","قسطاس رأى من جواهر",6,"ر",1,0]]}