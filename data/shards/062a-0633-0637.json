{"poems":[[53,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[63,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[214,"لعبت بقلبي والحشا اهواه","https://www.aldiwan.net/poem13386.html","الكامل"],[237,"صبر غريم الشوق منه مفلس","https://www.aldiwan.net/poem14713.html","الكامل"],[246,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[302,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[302,"بين العذيب وبين برقة ضاحك","https://www.aldiwan.net/poem33203.html","الكامل"],[358,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[422,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[567,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87273","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56378","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55898","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108950","البسيط"],[2869,"","https://poetry.dctabudhabi.ae/diwan/poem/145172","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4075,"","https://poetry.dctabudhabi.ae/diwan/poem/177851","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66122","البسيط"],[4816,"موكونو","https://www.poetsgate.com/ViewPoem.aspx?id=199476",""],[4966,"فى تيهِ بُعْدِك..","https://www.poetsgate.com/ViewPoem.aspx?id=196796",""],[5595,"أبا السّجادِ يا كلَّ نبيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=175953",""],[5638,"يا قدس صبرًا","https://www.poetsgate.com/ViewPoem.aspx?id=198037",""],[5720,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=198792",""],[5975,"لمياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=66584",""],[6052,"قبة الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=34642",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6093,"سُكَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=204997",""]],"verses":[["تسطو وتعفو وأنت مقتدر","لا ورَعٌ عند ذاك بل ورِع",0,"ع",1,0],["تَسطو بأسمرَ يُمضيه سَنا قَبَسٍ","بينَ الشَّراسيفِ والأحشاءِ ولاَّجِ",1,"ج",1,0],["تسطو الرّجالُ بهم من بعد ما نظرَوُا","إلى المنابرِ خُزْراً والكَراسيّ",2,"ي",1,0],["تسطو لواحظها على مهج الورى","وتصول في العشاق كيف تشاء",3,"ا",2,0],["تَسطو لَواحِظُهُ إِذا ما اِفتَرَّ لي","فَالثَغرُ يَبسُمُ وَالجُفونُ تُعَبِّسُ",4,"س",1,0],["تسطُو بها لكن بغيرِ مُهنَّدٍ","وتغضُّها لكن بغيرِ نُعاس",5,"س",1,0],["تَسطو بأسدِ الشَرى فيها ثعالبُها","وَالصقرُ تصطادُه الغربانُ والرخَمُ",6,"م",1,0],["تَسطو مَعاطِفُها وَسودُ لحاظِها","بمثقَّفٍ لَدنٍ وأَبيضَ باتِكِ",7,"ك",1,0],["تَسطو بِأَلحاظ نبال جُفونها","أَمضى مِن الأَجَل المُتاح سِهامُها",8,"م",3,0],["تسطو على العشاق من لحظاتها","بصوارمٍ مشحوذة وسِنان",9,"ن",1,0],["تُسطْرب العيس من ذكرى محامدهم","فللحداةِ بهم رجْعٌ وتغريدُ",10,"د",1,0],["تَسطُو علينا بلا كَفٍّ ولا عَضُدٍ","وليسَ يَنفَعُ مِنَّا الكَفُّ والعَضُدُ",11,"د",1,0],["تَسطو عَلى كُل ضاري","مِن تَحت راية نَصرِ",12,"ر",1,0],["تسطو بمعتدل القدّ الرشيق وفي","ظبا لحاظٍ أسود الغاب تخشاها",13,"ا",3,0],["تسطو بصارم لحظٍ إذا","ما صال أتنساك ضرب النصال",14,"ل",1,0],["تسطيره كلمة جمعتها","مع كلمة سطراً إذا وضعتَها",15,"ه",2,0],["تسطو فتبلغ آفات الزمان إذا ال","حرب العوان علينا أفغرت فاها",16,"ا",3,0],["تسطو بجفن كل منبت شعرة","من هدبه محسوبة بسنان",17,"ن",1,0],["تَسطو بأسهمها فتن","فذ في حَشا المستلئمِ",18,"م",1,0],["تَسطو فَتقتَلِع الأصم","مَ بوهدة وَبمخرمِ",18,"م",1,0],["تسطع الخوذات في هاماتهم","وطوال السمر في راحاتهم",19,"م",1,0],["تسطو بها فتية غر سيوفهم","بيض كأحسابهم مصقولة عنقوا",20,"ق",3,0],["تَسْطُو على الخُلُقِ المَأْثُورِ تُضْعِفُهُ","والمالِ تَنْهَبُهُ والنَّجْمِ والشَّجَرِ",21,"ر",1,0],["تسطر مواقف ينحتوها رجالها","على جبهة المجد العظيم وكتايبه",22,"ب",2,0],["تسطو عليك ببطش كفٍ معجلٍ","أقبح بها ما كاد يومك ينصفُ",23,"ف",1,0],["تسطّرُ كربلا لفظاً تسامى","وفيضاً يسلبُ اللبّ الجنينا",24,"ن",2,0],["تُسَطِّرُ اليَوْمَ فِي التَّارِيخِ مَلْحَمَةً","رَغْمَ الخِيَانَةِ وَالإِجْرَامِ وَالغَمَمِ",25,"م",1,0],["تسطو علىٰ أجزائهِ بتفنُّنٍ","حتىٰ يباتَ بما تحمَّلَ هائمَا",26,"م",2,0],["تسطو بخنجرها عليَّ وإنّما -- من كانَ أخلصكِ الهدى صبّارُ","وأحبُّ .. أبغضُ .. في هواكِ ولذَّ لي -- فيكِ الجهادُ إذا الجهادُ يدارُ",27,"ر",1,0],["تسطع الأرض في الدجى بشعاع","فترى البدر في السماء استهانا",28,"ن",2,0],["تسطع الارض في الدجى بشعاع","تحسب البدر في سماها تدانى",29,"ن",2,0],["تَسْطُوْ عَلَى الدِّيْنِ والَأمْوَالِ تَنْهَبُهَا","وتُهْدِرُ الوَقْتَ في الأَوْزَارِ وَ الوَصَبِ",30,"ب",1,0]]}