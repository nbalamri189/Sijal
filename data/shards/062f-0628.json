],[5725,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=186954",""],[5749,"الدوا والطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=29663",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5823,"كم تقت للأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=61555",""],[5833,"حميا الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=197004",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5882,"يا ورد 1","https://www.poetsgate.com/ViewPoem.aspx?id=190202",""],[5894,"دم يا هوى واجعل حبالك ترفد","https://www.poetsgate.com/ViewPoem.aspx?id=131417",""],[5911,"دببت على الْخَطِيب قبيل نوم","https://www.poetsgate.com/ViewPoem.aspx?id=188974",""],[5911,"لما ثنى جيده للسكر مُضْطَجعا","https://www.poetsgate.com/ViewPoem.aspx?id=188973",""],[6142,"ملك ميت بسكتةِ قلبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155688",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[463,"صدتْ بنعمانَ على طول الصدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60044&r=&rc=100",""],[454,"إلى ربيع العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82650&r=&rc=14",""],[4222,"لو كنت تعلم منتهى برحائه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52713&r=&rc=5",""]],"verses":[["دَبيبُ نارِ القَينِ طارَت في الفَحَم","أَقرَعُ فيهِ بِشَبا طَعنٍ وَذَم",0,"م",1,0],["دبّجَ الغيثُ بهِ خُضْرَ الرُّبى","كيْفَما شاء ووشّى ووشَعْ",1,"ع",1,0],["دَبَّ الْفَسَادُ إلَيْهَا","خَفِيفَ وَطْءِ كَمِينَا",2,"ن",2,0],["دبّ التباغض في أحشاهم مَرَضاً","به انْبَرَت أعظم منهم وجَفَّ دم",3,"م",1,0],["دبر الملك بالتقى فكساه الل","ه فيه ثوب المرجَّى المهيب",4,"ب",1,0],["دب الخمر","يا من ستر",5,"ر",1,0],["دبَّ فيها لها ومنها إليها","فاكْتَسَتْ لون رثَّة شَمْطاءِ",6,"ا",2,0],["دبَنَفْسَجٌ جُمِعَتْ أوراقُه فحَكى","كُحْلاً تشرَّبَ دمْعاً يومَ تَشْتِيتِ",7,"ت",1,1],["دبَّرتَ تدبيرَ المدبّرِ إنه","ما كان عندَ مَضلَّةٍ ضِلّيلا",8,"ل",2,0],["دَبَّت وَقَد أَرخى الظَلامُ سِتارا","وَلَطالَما كَتَمَ الدُجى الأَسرارا",9,"ر",2,1],["دَبَّت عَقارِبُها إِلَيهِ تَنوشُهُ","وَرَمَت بَقاياهُ إِلى أَصلالِها",10,"ل",3,0],["دب فيه الماء من شق به","فهو حتى عن طفو وهنا",11,"ن",2,0],["دَبَّروا المُلكَ في العِراقِ وَفي الشا","مِ فَسَنّوا الهُدى وَرَدّوا المَظالِم",12,"م",1,0],["دَبَّت الهِمَّةُ فيهِ وَمَشَت","عَزَماتٌ مِنكَ يا حَربُ صِحاح",13,"ح",1,0],["دبُّوا الضَّراءَ مخاتلينَ وأَعْمَلوا","أفكارَهُمْ في الكفرِ وهو سِرَارُ",14,"ر",1,0],["دَبَّرَ المُلكَ بِالسَدادِ فَإِبرا","ماً صَلاحُ الإِسلامُ فيهِ وَنَقضا",15,"ض",2,0],["دَبَّتْ عقاربُهم إليَّ ولم تكُنْ","لِتَدِبَّ في ليلِ النَّفاقِ عقاربي",16,"ب",2,0],["دَبَّت دَبيباً حَتّى تَخَوَّنَهُ","مِنها حُمَيّاً وَكَفَّ صالِبُها",17,"ب",3,0],["دَبَّرتَ أَمرَ المُسلِمينَ فَطَوِّقوا","بِنَداكَ أَطواقَ الحَمامِ فَغَرَّدوا",18,"د",3,0],["دَبَّت نِمالُ المَوتِ في شَفَرائِهِ","وَجَرى الحِمامُ بِحَدِّهِ يَتَرَدَّدُ",18,"د",1,0],["دَبَّ العِذارُ فَقامَتِ الأَعذارُ","وَبَدا السَوادُ فَزادَتِ الأَنوارُ",19,"ر",1,1],["دَبَّت عَقارِبُ صُدغِهِ في خَدِّهِ","وَسَعى عَلى الأَردافِ أَرقَمُ جَعدِهِ",20,"د",2,1],["دَبّابَةٌ في الرّأسِ يَصْعَدُ سُكْرُها","فتجدّ منا بالعقولِ وتلعبُ",21,"ب",1,0],["دبَّ مَوْتُ السّكونِ في حركاتي","وخَبَا في رمادِهِ حُمْرُ جمري",22,"ر",2,0],["دَبَّ ابنُ حصنٍ في الظلامِ فراعه","يقظانُ مثل الصلِّ ليس يُهوِّم",23,"م",1,0],["دَبَّرَ المُلكَ للجميع فَسوَّى ال","أمرَ فيه وأحكمَ التدبيرا",24,"ر",2,0],["دبَّ فينا الشَقاق يا لِبلاد","أَصبَحت تَحتَ رَحمة الحزبيه",25,"ي",2,0],["دَبَّت بِنا في غَمرَةٍ مَشمولَةٍ","حَتّى تَوَهَّمنا الصَباحَ أَصيلا",26,"ل",2,0],["دِبسِيَّةُ الاِسمِ لَكِن","نَ صَوتَها صَوتُ عَيرِ",27,"ر",1,1],["دُبِّقَ مِن نَعمانِ سَهرَدازٍ","تَصيدُنا رِزقاً وَدَستَخازِ",28,"ز",1,0],["دَبَّ فِيَّ الفَناءِ سُفلاً وَعُلوا","وَأَراني أَموتُ عُضواً فَعُضوا",29,"و",2,1],["دببتُ كالعقربِ جنبيّةٌ","وتارةً أحبو على بطني",30,"ن",2,0],["دَبيبُ نِمالٍ عَن عُقارٍ تَخالُها","بِجِسمِكَ شَرٌّ مِن دَبيبِ العَقارِبِ",31,"ب",1,0],["دَبَّت دَبيبَ نِمالٍ في أَنامِلِهِم","بِسائِرٍ في رُؤوسِ القَومِ دَرّاجِ",32,"ج",1,0],["دَبَبتَ بِسِرّي بَعدَما قَد عَلِمتَهُ","وَأَنتَ بِأَسرارِ الكِرامِ نَسولُ",33,"ل",1,0],["دَبَّتْ بِهِ رُوحُ الْحَياةِ فَلَوْ وَهَتْ","عَنْهُ الْقُيُودُ مِنَ الْجَدَاوِل قَدْ مَشَى",34,"ا",1,0],["دَب فِيْهِمْ رُوح جَدِيدٌ لَهُ مَا","بَعْدَهُ فِي القلوبِ وَالإِخلادِ",35,"د",1,0],["دَبَّ لَهُ إِبليسُ فَاِقتادَهُ","وَالشَيخُ نَفّاعٌ عَلى لَعنَتِه",36,"ت",2,0],["دبت الحية حتى نهست","في غصون العدل جهرا بعد سر",37,"ر",1,0],["دب اليكم داء من قبلكم","من حسد يسفعكم ومن قلى",38,"ا",1,0],["دبّابة أخرى وأخرى ولا","ألقى رصيف نظرة خاطفه",39,"ف",2,0],["دبَّرتَ أعظمَ تدبيرٍ وأحسنَه","تُتلى مآثِرُهُ عُمراً وتُدَّكر",40,"ر",1,0],["دبّت عقاربه الى جيرانه","اوما ترى بغداد أعدت جِلَّقا",41,"ق",2,0],["دبّت حميّاهم في كل جوهرةٍ","عقل ونفس وأعضاء وأرواح",42,"ح",1,0],["دَبيبُ الهَوى بينَ الضُّلُُوع مُؤجِّجٌ","لهَيبَ اشتياقٍ فيهِ للقَلب مَوردُ",43,"د",1,0],["دَبَّ في كَفَّيْهِ مَا مِنْ","حُبِّهِ دبَّ بِقَلْبي",44,"ب",2,0],["دَبَّجَ الغَيْثُ رَوْضَها مُذْ بَدا يَسْ","حَبُ مِنْ فَوْقِها ذُيولَ السَّحابِ",45,"ب",1,0],["دبَّ في خاطرِه ثانيا","ذكرُ اللوى سَقياً لعهدِ اللوى",46,"و",2,0],["دَبَّتْ عَقارِبَهُم إِلَيْ","كُم بِالمَفاسِدِ وَالدَسائِسْ",47,"س",1,0],["دب البلى فيه وهو حيّ","فما على الأرض منه شي",48,"ي",1,1],["دبّ نبات الشعر في خده","وصدّ عنه مشتكي صدّه",49,"د",2,0],["دَبَّرَ أَمرَ المُلكِ تَد","بيرَ الطَبيبِ المُشفِقِ",50,"ق",1,0],["دَبَّجَها النُّوَّارُ منْ أصْفَرٍ","يحْكِي النُّضَارَالغَضَّ في كُهْبَتِهِ",51,"ت",2,0],["دَبَّتْ عَقارِبُكُمْ إِلَيَّ وَقَدْ","تَهْوِي إِلى أَقْدامِكُمْ قُبَلِي",52,"ل",2,0],["دَبَّت على خَدِّهِ عَقارِبُ صُد","غَيهِ فَخافَت مِن نارِهِ التَلَفا",53,"ف",2,0],["دَبَّت إِلى حُسنِ ظَنّي فيكِ أَلسِنَةُ ال","واشينَ عَنّي بِقُبحِ المَينِ فَاِنقَطَعا",54,"ع",2,0],["دُبّاً عَظيماً موثَقا","في سَرحةٍ معلَّقا",55,"ق",2,0],["دبَّ الفناءُ له فعاد بخيبةٍ","خزيانَ ينظرُ مستشيطاً حاقدا",56,"د",2,0],["دَبَبتُ لَها الضَرّاءَ وَقُلتُ أَبقى","إِذا عَزَّ اِبنُ عَمِّكَ أَن تَهوَنا",57,"ن",2,0],["دب العذارُ فظن فيه لائمي","أ