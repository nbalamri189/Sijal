{"poems":[[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[88,"هي المنى كثغور الغيد تبتسم","https://www.aldiwan.net/poem44833.html","البسيط"],[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[72,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"دبنفسج جمعت أوراقه فحكى","https://www.aldiwan.net/poem9211.html","البسيط"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[91,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[91,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[89,"ما بنا خوف اذا الموت دنا","https://www.aldiwan.net/poem44842.html","الرمل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"أيها العاتب الذي ليس يرضى","https://www.aldiwan.net/poem64637.html","الخفيف"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[2,"وبلدة لا ترام خائفة","https://www.aldiwan.net/poem25041.html","المنسرح"],[66,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[66,"دب العذار فقامت الأعذار","https://www.aldiwan.net/poem39219.html","الكامل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[80,"قبس بكف مديرها أم كوكب","https://www.aldiwan.net/poem31239.html","الكامل"],[80,"يا ذنوبي ثقلت والله ظهري","https://www.aldiwan.net/poem31425.html","الخفيف"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[52,"يا صاح ودعت الغواني والصبا","https://www.aldiwan.net/poem26732.html","الكامل"],[52,"دبسية الاسم لكن","https://www.aldiwan.net/poem27005.html","المجتث"],[48,"قد أغتدي بزرق جراز","https://www.aldiwan.net/poem63418.html","الرجز"],[48,"دب في الفناء سفلا وعلوا","https://www.aldiwan.net/poem66204.html","البسيط"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[46,"توخ بهجر أم ليلى فإنها","https://www.aldiwan.net/poem22179.html","الطويل"],[46,"قد أسرجوا بكميت أطلقت لجما","https://www.aldiwan.net/poem22259.html","البسيط"],[1,"لهند بحزان الشريف طلول","https://www.aldiwan.net/poem34011.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/3481","السريع"],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"سبحان من خلق الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=179013",""]],"verses":[["دَبيبُ نارِ القَينِ طارَت في الفَحَم","أَقرَعُ فيهِ بِشَبا طَعنٍ وَذَم",0,"م",1,0],["دبّجَ الغيثُ بهِ خُضْرَ الرُّبى","كيْفَما شاء ووشّى ووشَعْ",1,"ع",1,0],["دَبَّ الْفَسَادُ إلَيْهَا","خَفِيفَ وَطْءِ كَمِينَا",2,"ن",2,0],["دبّ التباغض في أحشاهم مَرَضاً","به انْبَرَت أعظم منهم وجَفَّ دم",3,"م",1,0],["دبر الملك بالتقى فكساه الل","ه فيه ثوب المرجَّى المهيب",4,"ب",1,0],["دب الخمر","يا من ستر",5,"ر",1,0],["دبَّ فيها لها ومنها إليها","فاكْتَسَتْ لون رثَّة شَمْطاءِ",6,"ا",2,0],["دبَنَفْسَجٌ جُمِعَتْ أوراقُه فحَكى","كُحْلاً تشرَّبَ دمْعاً يومَ تَشْتِيتِ",7,"ت",1,1],["دبَّرتَ تدبيرَ المدبّرِ إنه","ما كان عندَ مَضلَّةٍ ضِلّيلا",8,"ل",2,0],["دَبَّت وَقَد أَرخى الظَلامُ سِتارا","وَلَطالَما كَتَمَ الدُجى الأَسرارا",9,"ر",2,1],["دَبَّت عَقارِبُها إِلَيهِ تَنوشُهُ","وَرَمَت بَقاياهُ إِلى أَصلالِها",10,"ل",3,0],["دب فيه الماء من شق به","فهو حتى عن طفو وهنا",11,"ن",2,0],["دَبَّروا المُلكَ في العِراقِ وَفي الشا","مِ فَسَنّوا الهُدى وَرَدّوا المَظالِم",12,"م",1,0],["دَبَّت الهِمَّةُ فيهِ وَمَشَت","عَزَماتٌ مِنكَ يا حَربُ صِحاح",13,"ح",1,0],["دبُّوا الضَّراءَ مخاتلينَ وأَعْمَلوا","أفكارَهُمْ في الكفرِ وهو سِرَارُ",14,"ر",1,0],["دَبَّرَ المُلكَ بِالسَدادِ فَإِبرا","ماً صَلاحُ الإِسلامُ فيهِ وَنَقضا",15,"ض",2,0],["دَبَّتْ عقاربُهم إليَّ ولم تكُنْ","لِتَدِبَّ في ليلِ النَّفاقِ عقاربي",16,"ب",2,0],["دَبَّت دَبيباً حَتّى تَخَوَّنَهُ","مِنها حُمَيّاً وَكَفَّ صالِبُها",17,"ب",3,0],["دَبَّرتَ أَمرَ المُسلِمينَ فَطَوِّقوا","بِنَداكَ أَطواقَ الحَمامِ فَغَرَّدوا",18,"د",3,0],["دَبَّت نِمالُ المَوتِ في شَفَرائِهِ","وَجَرى الحِمامُ بِحَدِّهِ يَتَرَدَّدُ",18,"د",1,0],["دَبَّ العِذارُ فَقامَتِ الأَعذارُ","وَبَدا السَوادُ فَزادَتِ الأَنوارُ",19,"ر",1,1],["دَبَّت عَقارِبُ صُدغِهِ في خَدِّهِ","وَسَعى عَلى الأَردافِ أَرقَمُ جَعدِهِ",20,"د",2,1],["دَبّابَةٌ في الرّأسِ يَصْعَدُ سُكْرُها","فتجدّ منا بالعقولِ وتلعبُ",21,"ب",1,0],["دبَّ مَوْتُ السّكونِ في حركاتي","وخَبَا في رمادِهِ حُمْرُ جمري",22,"ر",2,0],["دَبَّ ابنُ حصنٍ في الظلامِ فراعه","يقظانُ مثل الصلِّ ليس يُهوِّم",23,"م",1,0],["دَبَّرَ المُلكَ للجميع فَسوَّى ال","أمرَ فيه وأحكمَ التدبيرا",24,"ر",2,0],["دبَّ فينا الشَقاق يا لِبلاد","أَصبَحت تَحتَ رَحمة الحزبيه",25,"ي",2,0],["دَبَّت بِنا في غَمرَةٍ مَشمولَةٍ","حَتّى تَوَهَّمنا الصَباحَ أَصيلا",26,"ل",2,0],["دِبسِيَّةُ الاِسمِ لَكِن","نَ صَوتَها صَوتُ عَيرِ",27,"ر",1,1],["دُبِّقَ مِن نَعمانِ سَهرَدازٍ","تَصيدُنا رِزقاً وَدَستَخازِ",28,"ز",1,0],["دَبَّ فِيَّ الفَناءِ سُفلاً وَعُلوا","وَأَراني أَموتُ عُضواً فَعُضوا",29,"و",2,1],["دببتُ كالعقربِ جنبيّةٌ","وتارةً أحبو على بطني",30,"ي",1,0],["دَبيبُ نِمالٍ عَن عُقارٍ تَخالُها","بِجِسمِكَ شَرٌّ مِن دَبيبِ العَقارِبِ",31,"ب",1,0],["دَبَّت دَبيبَ نِمالٍ في أَنامِلِهِم","بِسائِرٍ في رُؤوسِ القَومِ دَرّاجِ",32,"ج",1,0],["دَبَبتَ بِسِرّي بَعدَما قَد عَلِمتَهُ","وَأَنتَ بِأَسرارِ الكِرامِ نَسولُ",33,"ل",1,0],["دَبَّتْ بِهِ رُوحُ الْحَياةِ فَلَوْ وَهَتْ","عَنْهُ الْقُيُودُ مِنَ الْجَدَاوِل قَدْ مَشَى",34,"ا",1,0],["دَب فِيْهِمْ رُوح جَدِيدٌ لَهُ مَا","بَعْدَهُ فِي القلوبِ وَالإِخلادِ",35,"د",1,0],["دَبَّ لَهُ إِبليسُ فَاِقتادَهُ","وَالشَيخُ نَفّاعٌ عَلى لَعنَتِه",36,"ت",2,0],["دبَّرتَ أعظمَ تدبيرٍ وأحسنَه","تُتلى مآثِرُهُ عُمراً وتُدَّكر",37,"ر",1,0],["دبّت عقاربه الى جيرانه","اوما ترى بغداد أعدت جِلَّقا",38,"ق",2,0]]}