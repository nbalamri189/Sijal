ف القد بالقلوب هفا","https://www.aldiwan.net/poem32705.html","المنسرح"],[280,"افتر ثغرك لي أم بارق لمعا","https://www.aldiwan.net/poem32715.html","البسيط"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[296,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[298,"ألا ليت المنازل قد بلينا","https://www.aldiwan.net/poem45452.html","الوافر"],[301,"دب العذار فظن فيه لائمي","https://www.aldiwan.net/poem57934.html","الكامل"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[336,"دب في السقام سفلاً وعلوا","https://www.aldiwan.net/poem68176.html","الخفيف"],[364,"دبت عقارب من وشى تحت الدجى","https://www.aldiwan.net/poem16934.html","الكامل"],[390,"دب العذار على ميدان وجنته","https://www.aldiwan.net/poem53495.html","البسيط"],[390,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[413,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[413,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[447,"تحلو الترانيم","https://www.aldiwan.net/poem985.html",""],[447,"إلى ربيع العمر","https://www.aldiwan.net/poem1006.html",""],[450,"دب العذار بخده","https://www.aldiwan.net/poem13869.html","مجزوء الكامل"],[456,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[456,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[456,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[456,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[462,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[477,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[477,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[491,"ومستدير معجم التقسيم","https://www.aldiwan.net/poem67318.html","الرجز"],[556,"دب سر الوجود بالمفقود","https://www.aldiwan.net/poem33552.html","الخفيف"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[584,"دب نمل العذار في الخد يبغي","https://www.aldiwan.net/poem17469.html","الخفيف"],[584,"نمت بما تحنو عليه ضلوعه","https://www.aldiwan.net/poem17586.html","الكامل"]],"verses":[["دَبيبُ نارِ القَينِ طارَت في الفَحَم","أَقرَعُ فيهِ بِشَبا طَعنٍ وَذَم",0,"م",1,0],["دبّجَ الغيثُ بهِ خُضْرَ الرُّبى","كيْفَما شاء ووشّى ووشَعْ",1,"ع",1,0],["دَبَّ الْفَسَادُ إلَيْهَا","خَفِيفَ وَطْءِ كَمِينَا",2,"ن",2,0],["دبّ التباغض في أحشاهم مَرَضاً","به انْبَرَت أعظم منهم وجَفَّ دم",3,"م",1,0],["دبر الملك بالتقى فكساه الل","ه فيه ثوب المرجَّى المهيب",4,"ب",1,0],["دب الخمر","يا من ستر",5,"ر",1,0],["دبَّ فيها لها ومنها إليها","فاكْتَسَتْ لون رثَّة شَمْطاءِ",6,"ا",2,0],["دبَنَفْسَجٌ جُمِعَتْ أوراقُه فحَكى","كُحْلاً تشرَّبَ دمْعاً يومَ تَشْتِيتِ",7,"ت",1,1],["دبَّرتَ تدبيرَ المدبّرِ إنه","ما كان عندَ مَضلَّةٍ ضِلّيلا",8,"ل",2,0],["دَبَّت وَقَد أَرخى الظَلامُ سِتارا","وَلَطالَما كَتَمَ الدُجى الأَسرارا",9,"ر",2,1],["دَبَّت عَقارِبُها إِلَيهِ تَنوشُهُ","وَرَمَت بَقاياهُ إِلى أَصلالِها",10,"ل",3,0],["دب فيه الماء من شق به","فهو حتى عن طفو وهنا",11,"ن",2,0],["دَبَّروا المُلكَ في العِراقِ وَفي الشا","مِ فَسَنّوا الهُدى وَرَدّوا المَظالِم",12,"م",1,0],["دَبَّت الهِمَّةُ فيهِ وَمَشَت","عَزَماتٌ مِنكَ يا حَربُ صِحاح",13,"ح",1,0],["دبُّوا الضَّراءَ مخاتلينَ وأَعْمَلوا","أفكارَهُمْ في الكفرِ وهو سِرَارُ",14,"ر",1,0],["دَبَّرَ المُلكَ بِالسَدادِ فَإِبرا","ماً صَلاحُ الإِسلامُ فيهِ وَنَقضا",15,"ض",2,0],["دَبَّتْ عقاربُهم إليَّ ولم تكُنْ","لِتَدِبَّ في ليلِ النَّفاقِ عقاربي",16,"ب",2,0],["دَبَّت دَبيباً حَتّى تَخَوَّنَهُ","مِنها حُمَيّاً وَكَفَّ صالِبُها",17,"ب",3,0],["دَبَّرتَ أَمرَ المُسلِمينَ فَطَوِّقوا","بِنَداكَ أَطواقَ الحَمامِ فَغَرَّدوا",18,"د",3,0],["دَبَّت نِمالُ المَوتِ في شَفَرائِهِ","وَجَرى الحِمامُ بِحَدِّهِ يَتَرَدَّدُ",18,"د",1,0],["دَبَّ العِذارُ فَقامَتِ الأَعذارُ","وَبَدا السَوادُ فَزادَتِ الأَنوارُ",19,"ر",1,1],["دَبَّت عَقارِبُ صُدغِهِ في خَدِّهِ","وَسَعى عَلى الأَردافِ أَرقَمُ جَعدِهِ",20,"د",2,1],["دَبّابَةٌ في الرّأسِ يَصْعَدُ سُكْرُها","فتجدّ منا بالعقولِ وتلعبُ",21,"ب",1,0],["دبَّ مَوْتُ السّكونِ في حركاتي","وخَبَا في رمادِهِ حُمْرُ جمري",22,"ر",2,0],["دَبَّ ابنُ حصنٍ في الظلامِ فراعه","يقظانُ مثل الصلِّ ليس يُهوِّم",23,"م",1,0],["دَبَّرَ المُلكَ للجميع فَسوَّى ال","أمرَ فيه وأحكمَ التدبيرا",24,"ر",2,0],["دبَّ فينا الشَقاق يا لِبلاد","أَصبَحت تَحتَ رَحمة الحزبيه",25,"ي",2,0],["دَبَّت بِنا في غَمرَةٍ مَشمولَةٍ","حَتّى تَوَهَّمنا الصَباحَ أَصيلا",26,"ل",2,0],["دِبسِيَّةُ الاِسمِ لَكِن","نَ صَوتَها صَوتُ عَيرِ",27,"ر",1,1],["دُبِّقَ مِن نَعمانِ سَهرَدازٍ","تَصيدُنا رِزقاً وَدَستَخازِ",28,"ز",1,0],["دَبَّ فِيَّ الفَناءِ سُفلاً وَعُلوا","وَأَراني أَموتُ عُضواً فَعُضوا",29,"و",2,1],["دببتُ كالعقربِ جنبيّةٌ","وتارةً أحبو على بطني",30,"ي",1,0],["دَبيبُ نِمالٍ عَن عُقارٍ تَخالُها","بِجِسمِكَ شَرٌّ مِن دَبيبِ العَقارِبِ",31,"ب",1,0],["دَبَّت دَبيبَ نِمالٍ في أَنامِلِهِم","بِسائِرٍ في رُؤوسِ القَومِ دَرّاجِ",32,"ج",1,0],["دَبَبتَ بِسِرّي بَعدَما قَد عَلِمتَهُ","وَأَنتَ بِأَسرارِ الكِرامِ نَسولُ",33,"ل",1,0],["دَبَّتْ بِهِ رُوحُ الْحَياةِ فَلَوْ وَهَتْ","عَنْهُ الْقُيُودُ مِنَ الْجَدَاوِل قَدْ مَشَى",34,"ا",1,0],["دَب فِيْهِمْ رُوح جَدِيدٌ لَهُ مَا","بَعْدَهُ فِي القلوبِ وَالإِخلادِ",35,"د",1,0],["دَبَّ لَهُ إِبليسُ فَاِقتادَهُ","وَالشَيخُ نَفّاعٌ عَلى لَعنَتِه",36,"ت",2,0],["دبَّرتَ أعظمَ تدبيرٍ وأحسنَه","تُتلى مآثِرُهُ عُمراً وتُدَّكر",37,"ر",1,0],["دبّت عقاربه الى جيرانه","اوما ترى بغداد أعدت جِلَّقا",38,"ق",2,0],["دبّت حميّاهم في كل جوهرةٍ","عقل ونفس وأعضاء وأرواح",39,"ح",1,0],["دَبيبُ الهَوى بينَ الضُّلُُوع مُؤجِّجٌ","لهَيبَ اشتياقٍ فيهِ للقَلب مَوردُ",40,"د",1,0],["دَبَّ في كَفَّيْهِ مَا مِنْ","حُبِّهِ دبَّ بِقَلْبي",41,"ي",1,0],["دَبَّجَ الغَيْثُ رَوْضَها مُذْ بَدا يَسْ","حَبُ مِنْ فَوْقِها ذُيولَ السَّحابِ",42,"ب",1,0],["دبَّ في خاطرِه ثانيا","ذكرُ اللوى سَقياً لعهدِ اللوى",43,"و",2,0],["دَبَّتْ عَقارِبَهُم إِلَيْ","كُم بِالمَفاسِدِ وَالدَسائِسْ",44,"س",1,0],["دب البلى فيه وهو حيّ","فما على الأرض منه شي",45,"ي",1,1],["دبّ نبات الشعر في خده","وصدّ عنه مشتكي صدّه",46,"د",2,0],["دَبَّرَ أَمرَ المُلكِ تَد","بيرَ الطَبيبِ المُشفِقِ",47,"ق",1,0],["دَبَّجَها النُّوَّارُ منْ أصْفَرٍ","يحْكِي النُّضَارَالغَضَّ في كُهْبَتِهِ",48,"ت",2,0],["دَبَّتْ عَقارِبُكُمْ إِلَيَّ وَقَدْ","تَهْوِي إِلى أَقْدامِكُمْ قُبَلِي",49,"ي",1,0],["دَبَّت على خَدِّهِ عَقارِبُ صُد","غَيهِ فَخافَت مِن نارِهِ التَلَفا",50,"ف",2,0],["دَبَّت إِلى حُسنِ ظَنّي فيكِ أَلسِنَةُ ال","واشينَ عَنّي بِقُبحِ المَينِ فَاِنقَطَعا",51,"ع",2,0],["دُبّاً عَظيماً موثَقا","في سَرحةٍ معلَّقا",52,"ق",2,0],["دبَّ الفناءُ له فعاد بخيبةٍ","خزيانَ ينظرُ مستشيطاً حاقدا",53,"د",2,0],["دَبَبتُ لَها الضَرّاءَ وَقُلتُ أَبقى","إِذا عَزَّ اِبنُ عَمِّكَ أَن تَهوَنا",54,"ن",2,0],["دب العذارُ فظن فيه لائمي","أني أكون عن الغرام بمعزلٍ",55,"ل",1,1],["دَبّوا الضراءَ إِلى عرضي مراوغةً","وَأَوطأوا غرّتي شعواءَ تحتدمُ",56,"م",1,0],["دبّت إِليّ عقاربُ البغيِ الّتي","كانَت بِنعلك كلّ يومٍ تصفعُ",57,"ع",1,0],["دَبَّ فِيَّ السِقامُ سُفلاً وَعُلوا","وَأَراني أَموتُ غُضواً فَعُضوا",58,"و",2,1],["دَبَّت عَقارِبُ مَن وَشى تَحتَ الدُجى","أَوَما جَرَت في الخَدِّ مِنها عَقرَبُ",59,"ب",1,1],["دبَّ العذارُ عَلى ميدان وُجنَتِهِ","حَتّى اِذا كادَ أَن يَسعى بِهِ وَقَفا",60,"ف",2,1],["دَبَّت عَقارِبُهُم لِصِنوِ نَبِيِّهم","فَاِغتالَهُ أَشقى الوَرى بِتَخَتُّلِ",61,"ل",1,0],["دَبَّرَ الملك برأي ثاقبٍ","وأحالَ الجَوْرَ عدلاً فاستحالا",62,"ل",2,0],["دبَّ فيه السُّرور من كلّ وجهٍ","بأديب الزَّمان عبد الباقي",63,"ق",2,0],["دبي يا جنة بالخير قد ورفت","ظلالها فتلاقى الحب والأدب",64,"ب",1,0],["دبي يا موئل الأحرار من قدم","وبلسم الجرح إن أزرى به العطب",64,"ب",1,0],["دبجته لصفات وجهك كلم","هام الفؤاد به ورف شعاره",65,"ر",2,0],["دب العذار بخده","حتى تكامل واتسق",66,"ق",1,1],["دبَّرتَها كهلا وسُدتَ كهولَها","تُرضِي النفوسَ وكنتَ بعدُ غلامَها",67,"م",3,0],["دبت إليه عقارب من كاشح","مسحولةٌ أسبابُهن ضِعافُ",68,"ف",1,0],["دبّت أفانينُ صروفِ الدهر لي","أساودا فناهشتني ورُقُطْ",69,"ط",1,0],["دبَّرها مستبصراً فلم يكن","مفوِّضاً فيها ولا مقلِّدا",70,"د",2,0],["دبجتها كف الربيع كا","ن شقت عليها مطارفاً وبرودا",71,"د",2,0],["دبجت خطوط خطى","طرزّت بها الكثبا",72,"ب",2,0],["دب الشعور فأحيا كل عاطفة","فينا وأوجدنا من بعد إعدام",73,"م",1,0],["دَبَّرَهُ فِكرُ اِمرىءٍ حَكيمِ","فَصاغَهُ في صِغَرِ التَجسيمِ",74,"م",1,0],["دب سر الوجود بالمفقودِ","فبدا للعيان كالموجود",75,"د",1,1],["دَبَّجتُ صُفرةَ خَدِّي بالدُّمُوع جَرت","حُمراً وأسْوَدُ رأسي ابيضَّ عن أمَمِ",76,"م",1,0],["دَبَّ نَمْلُ العِذَارِ في الخَدِّ يَبْغي","شَهْدَ ريقٍ يَجْلو بِهِ ما تَأَجَّجْ",77,"ج",1,1],["دَبَّتْ عَقارِبُ صُدْغِه في خَدِّهِ","فَغَدا وقَلْبِي في الهَوَى مَلْسُوعُهُ",78,"ع",2,0]]}