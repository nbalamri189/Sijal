{"poems":[[77,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[70,"نهاك عن الغواية ما نهاكا","https://www.aldiwan.net/poem42781.html","الوافر"],[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[66,"بعثت بآيات الجمال فآمنت","https://www.aldiwan.net/poem39652.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[48,"يا ليت زجر العائفية حاضري","https://www.aldiwan.net/poem64379.html","الكامل"],[50,"لم يطل ليلي ولكن لم أنم","https://www.aldiwan.net/poem62251.html","الرمل"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[76,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10172","الخفيف"],[77,"سيدي أنت عمدتي فاحتَملْني","https://www.poetsgate.com/ViewPoem.aspx?id=33312",""],[54,"إنَّ هذا الفتى يصونُ رغيفاً","https://www.poetsgate.com/ViewPoem.aspx?id=14468",""]],"verses":[["خَتَمَ اللهُ بِالْرِّضَى يَا ابْنَ رِضْوَا","نٍ لَكَ العُمْرَ بَعْدَ طُولِ البَقَاءِ",0,"ا",2,0],["خَتَمَا الْعُرْسَ فِي غَيَابَةِ رَمْسٍ","وَخَتَمْنَا أَفْرَاحَنَا بِالمَآتِمْ",1,"م",1,0],["ختمتُ ثنائي بالدعاء وها أنا","أُقلِّبُ في كفِّ النّدى وأُسلِّمُ",2,"م",1,0],["خَتَمتُ عَلى وِدادِكَ في ضَميري","وَلَيسَ يَزالُ مَختوماً هُناكا",3,"ك",2,0],["خُتِمَ الحُبُّ مِن حَديثي بِمِسكٍ","رُبَّ خَيرٍ يَجيءُ في الخاتِماتِ",4,"ت",1,0],["خَتَمتَ عَلى دُرِّ الثَنايا بِخاتَمٍ","عَقيقٍ وَتَحتَ الخَتمِ تُخبى الجَواهِرُ",5,"ر",1,0],["خَتَمَتْهُ يُمْنَى الأَمينِ وقد أُو","دِعَ ما لم تُذَع له أَنْبَاءُ",6,"ا",2,0],["خَتَمَ اللهُ النَّبِيِّينَ بهِ","قَبْلَ أنْ يجْبُلَ مِنْ آدَمَ طِينا",7,"ن",2,0],["خَتَمَت عَلى الشَكوى إِلَيَّ بِخاتِمٍ","نَقَشَت عَلَيهِ رُبَّ هَجرٍ نافِعي",8,"ي",1,0],["خَتَمَ الحُبُّ لَها في عُنُقي","مَوضِعَ الخاتَمِ مِن أَهلِ الذِمَم",9,"م",1,0],["خَتَمَت عَلى قَلبي بِخاتَمِها","وَيَلومُني في حُبِّها قَبُحا",10,"ح",2,0],["خُتِمتْ فَأرَةُ مِسكِ","فَأَبتْ إلا التَّذكِّي",11,"ي",1,1],["خُتِمَتْ بالشفَق الورديِّ في أصفى إناءِ","جُبلتْ فخّارتاهُ من صفاءٍ ونقاءِ",12,"ا",2,0],["خُتِمَتْ بِمَوْتِكَ نَكْبَةٌ وَتَواَصَلَتْ","أُخْرَى وَرَاءَ الْمَوْتِ ذَاتَ غَرَائِبِ",13,"ب",1,0],["خَتَمَ الْكَلامَ بِمَنْ حَدِيثُ","هَوَاهْ فِي الأَمْثالِ سَائِرْ",14,"ر",1,0],["خُتِمت كُلُّ سَلَّةٍ بِرَصاصٍ","وَسُيورٍ قُدِدنَ مِن جِلدِ فيلِ",15,"ل",1,0],["ختم الله بالرضا يا ابن رضوانٍ","لك العُمرُ بعد طولِ البقاء",16,"ا",2,0],["خُتِمَتْ كُلُّ سَلَّة ٍ بِحدِيدٍ","وسيورٍ قددنَ منْ جلدِ فيلِ",17,"ل",1,0]]}