{"poems":[[77,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[70,"نهاك عن الغواية ما نهاكا","https://www.aldiwan.net/poem42781.html","الوافر"],[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[66,"بعثت بآيات الجمال فآمنت","https://www.aldiwan.net/poem39652.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[48,"يا ليت زجر العائفية حاضري","https://www.aldiwan.net/poem64379.html","الكامل"],[50,"لم يطل ليلي ولكن لم أنم","https://www.aldiwan.net/poem62251.html","الرمل"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[76,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10172","الخفيف"],[77,"سيدي أنت عمدتي فاحتَملْني","https://www.poetsgate.com/ViewPoem.aspx?id=33312",""],[54,"إنَّ هذا الفتى يصونُ رغيفاً","https://www.poetsgate.com/ViewPoem.aspx?id=14468",""],[109,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[116,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[116,"ختم المجالس باب كل عناية","https://www.aldiwan.net/poem41977.html","الخفيف"],[116,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[138,"أدر الكأس يمينا","https://www.aldiwan.net/poem67988.html","مجزوء الرمل"],[143,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[151,"أي نور كشف الله به","https://www.aldiwan.net/poem68437.html","الرمل"],[205,"قل لمولاي يا بديع الزمان","https://www.aldiwan.net/poem53172.html","الخفيف"],[224,"ذلك الطير لم عراه ذهول","https://www.aldiwan.net/poem39724.html","الخفيف"],[224,"ختمت بالصمت آيات وعرفانا","https://www.aldiwan.net/poem41615.html","البسيط"],[232,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[236,"ختان جرى بالنجح واليمن طائره","https://www.aldiwan.net/poem32012.html","الطويل"],[236,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[260,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[282,"ابدأ مقالك بالثناء على النبي","https://www.aldiwan.net/poem1357.html",""],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[286,"ختم الرسالة ربنا بمحمد","https://www.aldiwan.net/poem39410.html","الكامل"],[298,"تذكر بالحمى رشأ أغنا","https://www.aldiwan.net/poem33152.html","الوافر"],[298,"أما الصبوح فإنه فرض","https://www.aldiwan.net/poem33232.html","أحذ الكامل"],[298,"بدا والليل معتكر","https://www.aldiwan.net/poem33255.html","مجزوء الوافر"],[299,"لا تنكري جزعي وفرط تفجعي","https://www.aldiwan.net/poem36256.html","عموديه"],[305,"بنفس أفدي خير من وطئ الثرى","https://www.aldiwan.net/poem16863.html","الطويل"],[305,"خذ ما صفا ودع الكدر","https://www.aldiwan.net/poem16879.html","مجزوء الكامل"],[305,"شغف المحب بحب ظبية عامر","https://www.aldiwan.net/poem16891.html","الكامل"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"نجلا بني البربير والفرقدان","https://www.aldiwan.net/poem39766.html","البسيط"],[365,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[365,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[375,"ختان فيه بالكرم اعتبار","https://www.aldiwan.net/poem4133.html","الوافر"],[378,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[381,"لك الحمد يا من حصل","https://www.aldiwan.net/poem48754.html","مجزوء المتقارب"],[392,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[394,"المجد أجمع ما حوته يميني","https://www.aldiwan.net/poem53666.html","الكامل"],[417,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[430,"أخو الصبابة يعلم","https://www.aldiwan.net/poem40273.html","المجتث"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[442,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[459,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[459,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[505,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[528,"ختمت بك العجم الملوك وراجعت","https://www.aldiwan.net/poem45977.html","الكامل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[563,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["خَتَمَ اللهُ بِالْرِّضَى يَا ابْنَ رِضْوَا","نٍ لَكَ العُمْرَ بَعْدَ طُولِ البَقَاءِ",0,"ا",2,0],["خَتَمَا الْعُرْسَ فِي غَيَابَةِ رَمْسٍ","وَخَتَمْنَا أَفْرَاحَنَا بِالمَآتِمْ",1,"م",1,0],["ختمتُ ثنائي بالدعاء وها أنا","أُقلِّبُ في كفِّ النّدى وأُسلِّمُ",2,"م",1,0],["خَتَمتُ عَلى وِدادِكَ في ضَميري","وَلَيسَ يَزالُ مَختوماً هُناكا",3,"ك",2,0],["خُتِمَ الحُبُّ مِن حَديثي بِمِسكٍ","رُبَّ خَيرٍ يَجيءُ في الخاتِماتِ",4,"ت",1,0],["خَتَمتَ عَلى دُرِّ الثَنايا بِخاتَمٍ","عَقيقٍ وَتَحتَ الخَتمِ تُخبى الجَواهِرُ",5,"ر",1,0],["خَتَمَتْهُ يُمْنَى الأَمينِ وقد أُو","دِعَ ما لم تُذَع له أَنْبَاءُ",6,"ا",2,0],["خَتَمَ اللهُ النَّبِيِّينَ بهِ","قَبْلَ أنْ يجْبُلَ مِنْ آدَمَ طِينا",7,"ن",2,0],["خَتَمَت عَلى الشَكوى إِلَيَّ بِخاتِمٍ","نَقَشَت عَلَيهِ رُبَّ هَجرٍ نافِعي",8,"ي",1,0],["خَتَمَ الحُبُّ لَها في عُنُقي","مَوضِعَ الخاتَمِ مِن أَهلِ الذِمَم",9,"م",1,0],["خَتَمَت عَلى قَلبي بِخاتَمِها","وَيَلومُني في حُبِّها قَبُحا",10,"ح",2,0],["خُتِمتْ فَأرَةُ مِسكِ","فَأَبتْ إلا التَّذكِّي",11,"ك",2,1],["خُتِمَتْ بالشفَق الورديِّ في أصفى إناءِ","جُبلتْ فخّارتاهُ من صفاءٍ ونقاءِ",12,"ا",2,0],["خُتِمَتْ بِمَوْتِكَ نَكْبَةٌ وَتَواَصَلَتْ","أُخْرَى وَرَاءَ الْمَوْتِ ذَاتَ غَرَائِبِ",13,"ب",1,0],["خَتَمَ الْكَلامَ بِمَنْ حَدِيثُ","هَوَاهْ فِي الأَمْثالِ سَائِرْ",14,"ر",1,0],["خُتِمت كُلُّ سَلَّةٍ بِرَصاصٍ","وَسُيورٍ قُدِدنَ مِن جِلدِ فيلِ",15,"ل",1,0],["ختم الله بالرضا يا ابن رضوانٍ","لك العُمرُ بعد طولِ البقاء",16,"ا",2,0],["خُتِمَتْ كُلُّ سَلَّة ٍ بِحدِيدٍ","وسيورٍ قددنَ منْ جلدِ فيلِ",17,"ل",1,0],["ختمت قلبي عن عشاشيق جيله","ختم المصللّي بالدعا . والتحياااات",18,"ت",1,0],["ختم القصيدة بالصلاة مسلماً","فيها على الهادي الحبيب وآله",19,"ل",2,0],["ختم المجالس باب كل عنايةٍ","مدح الرسول الطاهر المحمود",20,"د",1,1],["ختام كرام المرسلين وصدرهم","ومن فيهم في جامع الاصطفا صلى",21,"ل",2,0],["خَتَموها بِالأَفاوي","هِ وَكافورٍ وِقارِ",22,"ر",1,0],["ختمَ الضُّمَّر العِتاقَ وخلَّى","في الأَوراىِّ مُقرَفات وهُجْنا",23,"ن",2,0],["ختم الله به أنواره","عندما أكمل سن الأربعين",24,"ن",1,0],["خُتِمت هذه الصفات بخالٍ","يصرف العينَ عنك عند العيانِ",25,"ن",1,0],["خُتِمَت جِلدَةُ العُروقِ عَلَيهِ","فَبِأَزكى دِمائنا مَجبولُ",26,"ل",1,0],["خَتَمتَ بِالصَمتِ آياتٍ وَعرفانا","لَمّا نَزَلتَ جوارَ اللَهِ سُبحانا",27,"ن",2,1],["ختم النبوة فهو درة تاجها","وطراز حلتها الثمني عباره",28,"ر",2,0],["خِتانٌ جَرى بِالنُجحِ وَاليُمنِ طائِرُه","مَوارِدُهُ مَحمودَةٌ وَمَصادِرُه",29,"ر",2,1],["خَتَمَ الأَجوادَ طُرّاً","وَخَتَمتُ الشُعَراءا",30,"ا",3,0],["ختم الجمال على لآلئ ثغره","ميماً وطرّز لحظه بالصاد",31,"د",1,0],["ختَّام ديوان الرسالة والهدى","فتاح باب شفاعة الشفعاءِ",32,"ا",2,0],["ختارةٌ سلمها حرب ومأمنها","هو المخاف فمن يأمن به ثففا",33,"ف",2,0],["ختالة نصبت فينا حبائلها","وحُبُّها حبَها من يلتقط لقفا",33,"ف",2,0],["ختم الرسالة ربنا بمحمد","فهدى الأنام إلى الطريق الأرشد",34,"د",1,1],["ختامُ جميع رسل اللَه حقّا","وَمبدأ كلِّ إِحسانٍ وحُسنى",35,"ن",2,0],["ختم الحَيا أَزهارَها فَغَدا","بيد النَسيم لخَتمها فَضُّ",36,"ض",1,0],["ختمتُ بحبِّهِ وَطَري","فَما لي غيرُه وَطَرُ",37,"ر",1,0],["خُتِمَتْ بمصرعِه الخطوبُ فأَصبحتْ","للكارثاتِ قلوبُنا لم تجزع",38,"ع",1,0],["ختام النبيين الكرام جميعهم","حبيب إله العالمين بلا مرا",39,"ر",2,0],["ختم النبيين الكرام","نعم المصابيح الغرر",40,"ر",1,0],["ختم النبيين الكرام جميعهم","صلى عليه اللَه عد الماطر",41,"ر",1,0],["خِتامُها مِسكٌ فَهَل مُنافِسٌ","وَإِنَّما المَزكوُ يَجهَلُ العِطِر",42,"ر",1,0],["خِتان كُلٍّ كانَ عيداً لَنا","فَاِجتمع النوروز وَالمَهرجان",43,"ن",1,0],["خِتان كلٍّ مِنهُما بِالهَنا","قَد كانَ أرَّخت أَبرَّ الخِتان",43,"ن",1,0],["خُتِمَ الإجادةُ في المدائحِ بي","وبكَ الأَجاوِدُ في النّدى خُتِموا",44,"م",3,0],["خُتِمَتْ به الوزراءُ خَتْم جَلالةٍ","من كُلِّ ذي سَبْقٍ بذِكْرٍ شائع",45,"ع",1,0],["خِتانٌ فيه بالكَرم اعتبارُ","وبالشَمع المُنير وَباليَراع",46,"ع",1,1],["ختمت الأولين من القضايا","كما قد يختم الشعرَ الروي",47,"ي",1,0],["ختان جَرى بِالجدى","فَعَمَّ الوَرى بِالجَذل",48,"ل",1,0],["ختام خير فلا يلقى النصب والشدد","ثم الصلاة مع التسليم دائم أبد",49,"د",1,0],["خَتَمَ الرِقابَ بِنَصبِهِ لِوِلايَةٍ","خَتم الرقاب خلاف خَتمِ الطينِ",50,"ن",1,0],["خَتَنْتَ بَنيك في أيّام سَعْدٍ","بمعتَدِل الفصولِ من الزمان",51,"ن",1,0],["ختامه كابتداءٍ","وقلبه يا محكم",52,"م",1,0],["ختم الجود لنا منه فلا","حاتم أغنى ولا ايمعان معن",53,"ن",1,0],["ختام الرسل أولهم إلى كل","ل فضلٍ غير مسبوق سبوق",54,"ق",1,0],["ختمتهم وبراك الله خيرَهُمُ","جودا كما بكلامي تُختَم الكَلِمُ",55,"م",1,0],["ختمتم على حرّ الخواطر أنه","لكم ما انتهى فكرٌ وأسمح مِقوَلُ",56,"ل",1,0],["ختم الكلام بان خط عذاره","صحف ونور جماله جبريل",57,"ل",1,0],["ختمت بك العجم الملوك وراجعت","بك تاجُ ملكهم القديم المنهجِ",58,"ج",1,1],["خُتمت خِلافته بكمْ وعليكُمُ","إشرافُها أبدَ الزَّمان مطنَّبُ",59,"ب",1,0],["ختمتُ على نظمِ القوافي ففَضَّهُ","كريمٌ عليهِ هانَ فتحُ المغالقِِ",60,"ق",1,0],["ختمَ الحبيبُ بخاتَم","مِنْه على سَمْعِي وقَلْبِي",61,"ب",2,0]]}