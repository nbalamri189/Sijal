,""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""],[5064,"شروحُ الفتوح على أسانيد بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87507&r=&rc=2",""]],"verses":[["خَتَمَ اللهُ بِالْرِّضَى يَا ابْنَ رِضْوَا","نٍ لَكَ العُمْرَ بَعْدَ طُولِ البَقَاءِ",0,"ا",2,0],["خَتَمَا الْعُرْسَ فِي غَيَابَةِ رَمْسٍ","وَخَتَمْنَا أَفْرَاحَنَا بِالمَآتِمْ",1,"م",1,0],["ختمتُ ثنائي بالدعاء وها أنا","أُقلِّبُ في كفِّ النّدى وأُسلِّمُ",2,"م",1,0],["خَتَمتُ عَلى وِدادِكَ في ضَميري","وَلَيسَ يَزالُ مَختوماً هُناكا",3,"ك",2,0],["خُتِمَ الحُبُّ مِن حَديثي بِمِسكٍ","رُبَّ خَيرٍ يَجيءُ في الخاتِماتِ",4,"ت",1,0],["خَتَمتَ عَلى دُرِّ الثَنايا بِخاتَمٍ","عَقيقٍ وَتَحتَ الخَتمِ تُخبى الجَواهِرُ",5,"ر",1,0],["خَتَمَتْهُ يُمْنَى الأَمينِ وقد أُو","دِعَ ما لم تُذَع له أَنْبَاءُ",6,"ا",2,0],["خَتَمَ اللهُ النَّبِيِّينَ بهِ","قَبْلَ أنْ يجْبُلَ مِنْ آدَمَ طِينا",7,"ن",2,0],["خَتَمَت عَلى الشَكوى إِلَيَّ بِخاتِمٍ","نَقَشَت عَلَيهِ رُبَّ هَجرٍ نافِعي",8,"ي",1,0],["خَتَمَ الحُبُّ لَها في عُنُقي","مَوضِعَ الخاتَمِ مِن أَهلِ الذِمَم",9,"م",1,0],["خَتَمَت عَلى قَلبي بِخاتَمِها","وَيَلومُني في حُبِّها قَبُحا",10,"ح",2,0],["خُتِمتْ فَأرَةُ مِسكِ","فَأَبتْ إلا التَّذكِّي",11,"ك",2,1],["خُتِمَتْ بالشفَق الورديِّ في أصفى إناءِ","جُبلتْ فخّارتاهُ من صفاءٍ ونقاءِ",12,"ا",2,0],["خُتِمَتْ بِمَوْتِكَ نَكْبَةٌ وَتَواَصَلَتْ","أُخْرَى وَرَاءَ الْمَوْتِ ذَاتَ غَرَائِبِ",13,"ب",1,0],["خَتَمَ الْكَلامَ بِمَنْ حَدِيثُ","هَوَاهْ فِي الأَمْثالِ سَائِرْ",14,"ر",1,0],["خُتِمت كُلُّ سَلَّةٍ بِرَصاصٍ","وَسُيورٍ قُدِدنَ مِن جِلدِ فيلِ",15,"ل",1,0],["ختمت له الحسنى ووافى ربه","متقبلا لمزية الاطهار",16,"ر",1,0],["ختم الله بالرضا يا ابن رضوانٍ","لك العُمرُ بعد طولِ البقاء",17,"ا",2,0],["خُتِمَتْ كُلُّ سَلَّة ٍ بِحدِيدٍ","وسيو