{"poems":[[110,"بأيكما أبكي","https://www.shoaraa.com/p12758",""],[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[53,"شفيعك من قلبي مكين مشفع","https://www.aldiwan.net/poem65384.html","الطويل"],[46,"لم أر شيئا من الفراق إذا","https://www.aldiwan.net/poem30210.html","المنسرح"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21119","الكامل"],[108,"أبو الشعراء!","https://www.poetsgate.com/ViewPoem.aspx?id=179680",""],[102,"في بيتها العريق","https://www.poetsgate.com/ViewPoem.aspx?id=50421",""],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[192,"اصعد بعزمك إن المجد متصل","https://www.aldiwan.net/poem35678.html","الكامل"],[202,"أنوما ووعد الحادثات وعيد","https://www.aldiwan.net/poem51952.html","الطويل"],[447,"أيا ليلى ويا ليت التلاقي","https://www.aldiwan.net/poem14315.html","الوافر"],[534,"أصعدت مرتفعا إلى أوج السما","https://www.aldiwan.net/poem37165.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120057","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46561","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46546","الرجز"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201714","الطويل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100439","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100322","الوافر"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46018","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54465","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4860,"غٌربة مُواطن","https://www.poetsgate.com/ViewPoem.aspx?id=32519",""],[5431,"ولي نفس يُجافيها الغلاط","https://www.poetsgate.com/ViewPoem.aspx?id=199199",""],[5433,"تبدين مثل المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=36229",""],[5848,"وقفت في نصف الطريق اتحراك","https://www.poetsgate.com/ViewPoem.aspx?id=48933",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5950,"أبيات ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=126254",""],[5956,"انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=182418",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"أعطي من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=184182",""],[5956,"تتزاحم الأحزان في بنياني","https://www.poetsgate.com/ViewPoem.aspx?id=205383",""],[6089,"يا واصلا غيري","https://www.poetsgate.com/ViewPoem.aspx?id=213818",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""]],"verses":[["أصعّر خدي ما تلاقى ووردهم","وألثم ما بانوا محلاً تواردوا",0,"د",3,0],["أَصعَقَ الأَعداءَ حَتّى خِلتُهُ","زَفَيانَ الريحِ يَرمي بِالعَضَد",1,"د",1,0],["أصعِّد أنفاسي وأحدر عبرتي","بحيث يرى ذاك الإله ويسمع",2,"ع",1,0],["أَصعَبَ مِن وَقفَةِ المُشَيِّعِ لِلحُبِّ","يُريدُ الوَداعَ مُنصَرِفا",3,"ف",2,0],["أَصعَدنَ في وادي أُثَيدَةَ بَعدَمَا","عَسَفَ الخميلَةَ وَاحزَأَلَّ صُواها",4,"ه",2,1],["اصعَد إلى الملأ الأعلى؛ فإنَّ به","مثواكَ، وانعم بُلقيا اللهِ، واقترب",5,"ب",1,0],["إصعد ... لكن هل في فمها","أخرى ؟ ... أو أذني مخلولة",6,"ل",2,0],["أصعِدتِ في رَكبِ النُّزوع","حتى وصلتِ إلى الرُّبوع",7,"ع",1,0],["أصعِّد أنفاسي إذا ما تمرّغت","على تُربه هوجُ الرياح الخواطرِ",8,"ر",1,0],["اصْعَد بِعَزْمِكَ إنَّ المَجْدَ مُتَّصِلُ","وهل تَمَلُّ صُعُودًا أيُّها البَطَلُ",9,"ل",1,1],["أُصَعِّدُ أنفاسي لنجمٍ رأيته","يُهالُ عليه بالأكفِّ صعيد",10,"د",1,0],["أصعد زفرة في إثرى أخرى","فهن لمهجتي أبداً رواق",11,"ق",1,0],["أَصَعِدْتَ مُرْتَفِعاً إلى أَوْجِ السَّما","فَنَظَمْتَ في ذا الطِّرْسِ تِلكَ الأَنْجُما",12,"م",2,1],["أصعد أنفاسا حرارا كأنما","لهن على الأحشاء وخز صعادِ",13,"د",1,0],["أَصْعَرَ مَلْقُوّاً مُبِيناً ضَجَمُهْ","وَالكُفْرُ أَخْزَى عَمَلٍ وَأَوْخَمُهْ",14,"م",2,0],["أَصعب مِن نَيل السهى","صَبرك عَما يَشتَهي",15,"ي",1,0],["أَصعب ما تكابد","صُحبة مَن يُعاند",16,"د",1,0],["أُصعِّد أنفاسًا كأن شرارها","كواكبُ ليلٍ ملء أحشائه وقْد",17,"د",1,0],["أُصعِّد أنفاسًا نضحن بعبرة","على كبد العلياء من حرها برد",17,"د",1,0],["أصعده اللَه لأعلى رتبةٍ","لو رام أدناه الهلال ما صعد",18,"د",1,0],["اصعِّد مقلة واغضُّ اخرى","تصوِّب خاشع الطرف الغضيض",19,"ض",1,0],["أَصعَرتِ خَدَّكِ دونَ صبك نَخوَةً","حَتّى خَلَعتِ عَلى اللَّهيفِ خِبالا",20,"ل",2,0],["أَصعبُ ما نلقاهُ من أَهلها","قولٌ بلا أهلٍ ولا سهلِ",21,"ل",1,0],["أصعد زفرتي فتصوب دمعا","يخلص باتقاد الوجد سبكي",22,"ي",1,0],["اصعط جنونك دع الحب لاتبالي","قبل لاتشوى على نار(ن)صليّه",23,"ي",2,0],["أصعب أحاسيس القلب لين أغترب في ثورته","وين الوطن وين أنتمي..نفسي في نفسي ضايعه",24,"ع",2,1],["أصعّد هامتي شعرا وفكرا","فأربحني ويربحني النشاط",25,"ط",1,0],["اصعب كلام أصعب خبر صرخه عقب صمت طويل","ثل الهدوء اللي سبق لحظة هبوب العاصفه",26,"ف",2,0],["أصعب من احساسي بفرقاك .. فرقاك","يا صعبها .. لامن جلست اتخيّلك",27,"ك",1,0],["اصعَدْ كما تبغِي وربُّكَ رافعٌ","ومقدِّمٌ إيَّاكَ أسنَى تَقْدِمَهْ",28,"م",2,0],["أصعب من أنّه يكون بهالزمان السّهل","وأسهل من أنّه يكون الممتلي بالغرور",29,"ر",1,0],["أصعب الأشياء تعدادٌ يسمى","بالهبوطيِّ، فمن منه يقيني ؟؟",30,"ن",2,0],["أصعبُ الأشياء أن يُخْنَقَ شخص","عبر غاز الفحم لا يلقى مجالا",31,"ل",2,0],["أصعبُ الأفعال أن ترفض شيئاً","من كريم أريحيٍّ أنت صنتُهْ",32,"ت",2,0],["أ صَعدْتُ كل شبيبتي كي أرتمي","وقت المشيب بقبضةِ السلطانِ؟",33,"ن",1,0],["اصعد دموعي واتخذْ لك سلما","من أضلعي لترى العذاب المؤلما",34,"م",2,1],["إصعدْ، فموطنك السّماءُ، وخلِّنا","في الأرضِ، إن الأرضَ للجبناءِ",35,"ا",2,0],["إصعَدْ فموطنك المُرّجَى مخفرٌ","متعددُ اللهجات والأزياءِ",35,"ا",2,0],["إصعدْ، فهذي الأرض بيتُ دعارةٍ","فيها البقاءُ معلّقٌ ببغاءِ",35,"ا",2,0],["أصعلكُ ما تبقى من حدائي","لأن العمر آخره نحيبُ",36,"ب",1,0]]}