{"poems":[[57,"ماعليها لو أنها أذنت لي","https://www.aldiwan.net/poem26320.html","الخفيف"],[79,"الأصيل ارتدى بثوب شحوب","https://www.aldiwan.net/poem35698.html","الخفيف"],[95,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[29,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[54,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[146,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[230,"كم ساعة آلمني مسها","https://www.aldiwan.net/poem55108.html","السريع"],[230,"غاض ماء الحياء من كل وجه","https://www.aldiwan.net/poem55142.html","الخفيف"],[266,"حاذر مجالسك القريب فطالما","https://www.aldiwan.net/poem38250.html","الكامل"],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[408,"أنا وحدي في المكان","https://www.aldiwan.net/poem46526.html","مجزوء الرمل"],[435,"رشف المجد بالمسرة كاسه","https://www.aldiwan.net/poem39875.html","الخفيف"],[435,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[458,"دور من القدم الغالي مجللة","https://www.aldiwan.net/poem61368.html","البسيط"],[558,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[591,"للمنطقيين أشتكي أبدا","https://www.aldiwan.net/poem17589.html","المنسرح"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199564","المسحوب"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96300","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117456","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111896","البسيط"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27640","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91991","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127355","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4755,"يا مَوطِنِي.. أَطَبَعْتَ ذُلَّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=183839",""],[4772,"وشاح الغواية","https://www.poetsgate.com/ViewPoem.aspx?id=190803",""],[4830,"ياصَبيَّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210819",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5219,"أين المفر ..... ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=195014",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5277,"قاب قوسين أو أدنى","https://www.poetsgate.com/ViewPoem.aspx?id=201614",""],[5409,"أرسلوها في الفضا قبا مهارا","https://www.poetsgate.com/ViewPoem.aspx?id=155278",""],[5587,"العدل(2)","https://www.poetsgate.com/ViewPoem.aspx?id=196841",""],[5781,"ألْتذُّ منه بالرحيق!","https://www.poetsgate.com/ViewPoem.aspx?id=208761",""],[6068,"حكمة -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175945",""],[5309,"حاذر الفاجر ان عاشرته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573854",""]],"verses":[["حاذَرَت أَن تَرِقَّ لي فَهيَ لا تَز","دادُ إِلّا تَباعُداً وَنِفارا",0,"ر",2,0],["حاذراً موقف الفراق ومن ذا","لا يرى للفراق تحت حذار",1,"ر",1,0],["حَاذِرُوا أَنْ يُسَوَّدَ الأَغْنِيَاءُ","فَتَوَلَّى جُهَّالُهُ الأَحْكَامَا",2,"م",2,0],["حاذَرتُ بَينَهُمُ بِالأَمسِ إِذ بَكَروا","مِنّا وَما يَنفَعُ الإِشفاقُ وَالحَذَرُ",3,"ر",1,0],["حاذِقُ الوُدِّ لي بِما سَرَّ نَفسي","كانَ طَبّاً وَعالِماً بِالشِفاءِ",4,"ا",2,0],["حاذِرْ عَليُّ وَلَيْتَ شِعْرِي","هَلْ يَرُدُّكَ قَوْلُ حاذِرْ",5,"ر",1,0],["حاذرت العَينَ فما إن تُرَى","وخافت السمعَ فما تَبغِمُ",6,"م",1,0],["حاذِرِ الحُبَّ إِنَّ في الحُبِّ شَرّا","فَهوَ نارُ القَلبِ تصهُر صَهرا",7,"ر",2,1],["حاذِر منَ الساعات ويلٌ لمَن","يَأمنُ تلكَ الفِئَةَ الطاغِيه",8,"ي",2,0],["حاذِري يا ذِئابُ صَولةَ أُسدٍ","منكِ أَقوى ناباً وأنفَذُ ظُفرا",9,"ر",2,0],["حاذر مجالسك القريب فطالما","كان التباعد من قريب ناشي",10,"ش",2,1],["حاذرْ عَلى الحقِّ من قومٍ سياستهمْ","لا تنتهي بهمُ حيث الذي شرعوا",11,"ع",3,0],["حاذقٌ بالسّقي للشّرْ","بِ بصيرٌ بالأغاني",12,"ن",2,0],["حاذقٌ بالأمور وضاح رأيٍ","بذكاء الذكاء فاق أياسه",13,"س",2,0],["حاذر زمانك يا هذا وكن وجلاً","منه فإن الذي أبرمت ينتقضُ",14,"ض",1,0],["حاذر من الشمس قالوا إنها خطر","وإن تقبيلها إحراق نيران",15,"ن",1,0],["حاذِروا دَولَةَ الزَمانِ عَلَيكُم","إِنَّهُ بَينَ أَهلِهِ أَطوارُ",16,"ر",1,0],["حَاذَرَهَا مَنْ أُحِبُّهُ فَأَبَى","أَنْ نَخْتَلِي سَاعةً وَنَجْتَمِعَا",17,"ع",2,0],["حاذر على نفسك من الزّيف والزّلل","وطالع مخاصيص الجدى من عدودها",18,"د",3,0],["حاذَرنَ شَدَةَ مُحصَفٍ ذي شِرّةٍ","حاضَرنَه فوجَدنَه مِحضيرا",19,"ر",2,0],["حاذر أصابعَ من ظلمتَ فإنه","يدعو بقلبٍ في الدجى مكسور",20,"ر",1,1],["حاذر ففي الحيِّ من آرامهِ نفرٌ","تحوي المنيَّة منهم اعينٌ نُجلُ",21,"ل",1,0],["حاذي مكارم أخلاقٍ لوالده","والليث يحذوه في الأخلاق أشبال",22,"ل",1,0],["حاذر غوائلَ مكره في بسطه","لا تأمن الرزاق والفتَّاحا",23,"ح",2,0],["حاذَرَ من خزينةٍ يسوغُها","وهل على المخزياتِ أقدارُ",24,"ر",1,0],["حاذر التفريط في عصر الصِبا","إنه عصرُ المَعالي وَالهممْ",25,"م",1,1],["حاذى ببدر الوجه مرآة السما","فأرتني القمرين في وقت معا",26,"ع",2,0],["حاذى بنا قُبَيبةَ ابنِ طاهِرٍ","يَفرِى أديمَ الماءِ فَرى مَن حَذا",27,"ا",1,0],["حَاذَيتُ حُزنَكَ واتَّحَدْتُ بهِ","قَبلَ الخَلِيقَةِ.. لَيتَهُ حَاذَى",28,"ذ",2,0],["حاذر فوجه الشمس يحرق ظلّه","والصمتُ صار على المدى صداحا",29,"ح",2,0],["حاذري ياغِرَّةً من قَتلِ روحٍ","أنتِ فيها فاتركي منها بقيَّهْ",30,"ي",2,0],["حاذر رصيدك بالوفى يعلن افلاس","واتعب على دربٍ يعز انتهاجه",31,"ج",2,0],["حاذر خطاك فانها اعداء","وازجر هواك فإنه نزاء",32,"ا",2,1],["حَاذِرْ ، فَقَد تُبْتَلَى يَوماً بِوَخزَتِهِ","فَيَسكُنُ اللَّيلُ فِي جَفنَيْكَ والسُّهدُ",33,"د",1,0],["حاذر لزلته سارع لطاعته","واطمع برحمته تلقاه رحمانا",34,"ن",2,0],["١٣-حاذر من الفعل القبيح فإنه .","يفضي الى خزي ولا تتوقع",35,"ع",1,0],["حَاذِرْ مِنَ النَّفْسِ مِنْ أَهْوَائِهَا سُبُلاً","وَاحْرِصْ لِزِينَتِهَا مِنْ زَلَّةِ الْقَدَمِ",36,"م",1,0],["حاذرْ.. ففي مقلتي دمعٌ تعاهدها","إيّاك من دمعةِ الموجوعِ بالحبّ",37,"ب",1,0],["حاذروا ثورةَ شعبٍ يائس","فمذ استولى عليه الياس ثارا",38,"ر",2,0],["حَاذِرْ مِنَ الجُورِ فِي مُسْتَنْقَعِ الرِّيَبِ","وَالأَخْذُ بِالعَدْلِ مِنْ إِسْتَبْرَقٍ ذَهَبِي",39,"ي",1,1],["حاذِرْ إذا أحْبَبْتَ نَفْثةَ حاسدٍ","إن دُقَّ بابُ القلبِ ذاتَ تَلَبُّسِ!",40,"س",1,0],["حاذر سخاف الأمر إن سخافه","مجموعة في لاحق الأبيات",41,"ت",1,1],["حاذِر الفاجِرَ إِن عاشَرتَهُ","وَلَئيمَ الطَّبعِ إن أَكرَمتَهُ",42,"ت",2,1]]}