{"poems":[[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[93,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[91,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[43,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[43,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[62,"هم الحي ما بين العذيب إلى الرمل","https://www.aldiwan.net/poem52322.html","الطويل"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"ألثغ بالراء زار بيتي","https://www.aldiwan.net/poem28238.html","مخلع البسيط"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[122,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[133,"حيت فأحيت مهجة المشتاق","https://www.aldiwan.net/poem49125.html","الكامل"],[208,"اطلع روض الخدود وردا","https://www.aldiwan.net/poem13483.html","مخلع البسيط"],[208,"الثار دونك يا ليث الوغى الثارا","https://www.aldiwan.net/poem13557.html","البسيط"],[227,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[227,"خوفته سلوتي فخافا","https://www.aldiwan.net/poem50936.html","مخلع البسيط"],[233,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[233,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[269,"قل للمطي اللواتي طال مسراها","https://www.aldiwan.net/poem52094.html","البسيط"],[278,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[351,"قم بنا أيها الحبيب","https://www.aldiwan.net/poem40222.html","مجزوء الخفيف"],[413,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[462,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[549,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[565,"الثلج يسقط أم لجين يسبك","https://www.aldiwan.net/poem69558.html","الكامل"],[573,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["أَلثامٌ شفَّ عَن وردٍ ندِ","أَم غمامٌ ضحكت عَن بَرَدِ",0,"د",1,1],["أَلثَّرَاءُ المُسْتَعَزُّ بِهِ","كَنْزُهُ فِي العَقْلِ لاَ التُّرْبِ",1,"ب",1,0],["الثاقب الرأي الذي نوره","فاز بفانوس على المشعل",2,"ل",1,0],["الثُّكْلُ مَوْتٌ طَوِيلٌ","مَدَاهُ فِي تَبْرِيحِهْ",3,"ح",2,0],["الثُّماليُّ ثِمالُ المُرْتجَى","مُطلِقُ الأصفاد والطَّلْقُ الصّفُودُ",4,"د",1,0],["الثائِرِ المُتَفَجِّرِ الدَفّاقِ","لَولاهُ لَم تَشمَخ جِبالُ بِلادي",5,"ي",1,0],["الثكالى اذا بكين فان الضعف","عذر المفجوعة المثكال",6,"ل",1,0],["الثابِتينَ فُروسَةً كَجُلودِها","في ظَهرِها وَالطَعنُ في لَبّاتِها",7,"ت",3,0],["الثَغرُ وَالنَحرُ وَالمُخَلخَلُ وَال","مِعصَمُ دائي وَالفاحِمُ الرَجِلُ",8,"ل",1,0],["ألثَّ عليه كلُّ جَوْنٍ ربَابَهُ","يُسِفُّ إِلى أن يَمْسَحَ الأرضَ بالخَمْلِ",9,"ل",1,0],["أَلثم الدّرَّ حصىً ينبع لي","بزلالٍ ناقعاً فيه التياح",10,"ح",1,0],["ألثغ بالراءِ زارَ بيتي","فجاءَنا حاسدٌ وأصغى",11,"غ",2,1],["الثّابتين على الهُدى ما زُلزلوا","يوماً ولا عَرفوا سبيل مَلالِ",12,"ل",1,0],["الثّاوياتُ على هُدىً من ربّها","والسّابحاتُ السّائحاتُ الجُوَّلُ",13,"ل",1,0],["الثلاثون لم تكن عمرَكَ السَّا","دِرِ في فتنةِ الصِّبا ومراحِهْ",14,"ح",2,0],["الثلاثون قد مَضَتْ","في النفاهاتِ والهذَرْ",15,"ر",1,0],["ألثم السدة التي إن أنلها","تهو فيها وتسجد الجوزاء",16,"ا",2,0],["أَلَثَّتْ علَيْهَا المُعْصِراتُ بقَطْرِهَا","وجَرَّتْ بها هُوجُ الرِّيَاحِ مُلاءَهَا",17,"ا",3,0],["الثورةُ البيضاءُ شَعَّ بياضُها","في ظلمة الوادي شُعاع هلالِهِ",18,"ل",2,0],["الثورة الكبرى نمتْ","ك، وأنت أنت لها ربيب",19,"ب",1,0],["الثورةُ الكبرى التي","جدنا لها بدم الشباب",20,"ب",1,0],["الثغرُ أين مضى رُواؤهُ؟","أوَلم يفارقهُ شتاؤهْ؟",21,"ا",3,1],["الثغر بات يئنُّ . أه","لونا وأنفُسنا فداؤه",21,"ا",3,0],["الثائرون على الطُّغيان من قِدَمٍ","بكلِّ حرٍّ يبيع الروح بالبَخَسِ",22,"س",1,0],["الثياب الفَرْهاء رفَّتْ عليهم","كضمادٍ غطَّ جِراحاً وطَعْنا",23,"ن",2,0],["الثابتين على مباديء قومهم","الحافظين ذمام من لا يخفر",24,"ر",1,0],["الثابت الجأش الرفيع مقامهُ","عذب السجايا طيب الأخلاقِ",25,"ق",1,0],["ألثم منه فما وجيدا","وأجتلي سالفا وخدّا",26,"د",2,0],["الثار دونك يا ليث الوغى الثارا","فليس غيرك عنا يكشف العارا",27,"ر",2,1],["أَلْثَمْننا بَرَداً زادَ الجوى لَهَباً","كَأّنما بَرْدُه في حَرّه شُعَلُ",28,"ل",1,0],["ألثمني خدّه شقِيقا","وعلّنِي ريقه سُلافا",29,"ف",2,0],["الثابِتُ العَزَماتِ في دَحضٍ وَأَق","دَامُ الأَعادي رَحبَةً تَتَزَلزَلُ",30,"ل",1,0],["الثابِتِ الأَراءِ في","دَحضٍ بِواطِئِهِ زَليلِ",31,"ل",1,0],["الثابِتُ الآراءِ في","كُلِّ مَقامٍ مُزلِقِ",32,"ق",1,0],["الثدى در له وَالغيم ظلله","وانشق في الافق بدر شق ظلماها",33,"ا",3,0],["الثَّأْرُ مَضْمُونٌ وَفِي أَيْمانِنا","بِيضٌ كخاطِفَةِ الْبُرُوقِ اللُّمَّعِ",34,"ع",1,0],["اِلثم الثَغر إِن أَباح","منية القلب أو أبى",35,"ب",2,0],["الثابت الجأش في سِلْم ومعترك","في موطن الفخر قد أرسى له قدما",36,"م",2,0],["الثابت الجأش الوقور جانباً","ما ارتاع من حادثة ولا انثنى",37,"ا",1,0],["الثابتون على الجياد إذا همُ","هّموا إلى حربٍ ثباتَ جلودها",38,"د",3,0],["الثّابتُ العزمِ إذا طيشٌ هفا","والواجدُ الرّأي إذا الرّأي بَطَلْ",39,"ل",1,0],["الثَّلْجُ يَسْقُطُ أَمْ لُجَيْنٌ يُسْبَكُ","أَمْ ذَ حَصَى الكَافُورِ ظَلَّ يُفَرَّكُ",40,"ك",1,1],["أَلْثُمُ منه لُؤلؤاً أَبْيَضاً","أَغْنَى به عَنْ حَجَرٍ أَسْودِ",41,"د",1,0]]}