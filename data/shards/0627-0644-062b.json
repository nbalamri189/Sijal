{"poems":[[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[93,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[91,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[43,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[43,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[62,"هم الحي ما بين العذيب إلى الرمل","https://www.aldiwan.net/poem52322.html","الطويل"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"ألثغ بالراء زار بيتي","https://www.aldiwan.net/poem28238.html","مخلع البسيط"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""]],"verses":[["أَلثامٌ شفَّ عَن وردٍ ندِ","أَم غمامٌ ضحكت عَن بَرَدِ",0,"د",1,1],["أَلثَّرَاءُ المُسْتَعَزُّ بِهِ","كَنْزُهُ فِي العَقْلِ لاَ التُّرْبِ",1,"ب",1,0],["الثاقب الرأي الذي نوره","فاز بفانوس على المشعل",2,"ل",1,0],["الثُّكْلُ مَوْتٌ طَوِيلٌ","مَدَاهُ فِي تَبْرِيحِهْ",3,"ح",2,0],["الثُّماليُّ ثِمالُ المُرْتجَى","مُطلِقُ الأصفاد والطَّلْقُ الصّفُودُ",4,"د",1,0],["الثائِرِ المُتَفَجِّرِ الدَفّاقِ","لَولاهُ لَم تَشمَخ جِبالُ بِلادي",5,"ي",1,0],["الثكالى اذا بكين فان الضعف","عذر المفجوعة المثكال",6,"ل",1,0],["الثابِتينَ فُروسَةً كَجُلودِها","في ظَهرِها وَالطَعنُ في لَبّاتِها",7,"ت",3,0],["الثَغرُ وَالنَحرُ وَالمُخَلخَلُ وَال","مِعصَمُ دائي وَالفاحِمُ الرَجِلُ",8,"ل",1,0],["ألثَّ عليه كلُّ جَوْنٍ ربَابَهُ","يُسِفُّ إِلى أن يَمْسَحَ الأرضَ بالخَمْلِ",9,"ل",1,0],["أَلثم الدّرَّ حصىً ينبع لي","بزلالٍ ناقعاً فيه التياح",10,"ح",1,0],["ألثغ بالراءِ زارَ بيتي","فجاءَنا حاسدٌ وأصغى",11,"غ",2,1],["الثّابتين على الهُدى ما زُلزلوا","يوماً ولا عَرفوا سبيل مَلالِ",12,"ل",1,0],["الثّاوياتُ على هُدىً من ربّها","والسّابحاتُ السّائحاتُ الجُوَّلُ",13,"ل",1,0],["الثلاثون لم تكن عمرَكَ السَّا","دِرِ في فتنةِ الصِّبا ومراحِهْ",14,"ح",2,0],["الثلاثون قد مَضَتْ","في النفاهاتِ والهذَرْ",15,"ر",1,0],["ألثم السدة التي إن أنلها","تهو فيها وتسجد الجوزاء",16,"ا",2,0],["أَلَثَّتْ علَيْهَا المُعْصِراتُ بقَطْرِهَا","وجَرَّتْ بها هُوجُ الرِّيَاحِ مُلاءَهَا",17,"ا",3,0],["الثورةُ البيضاءُ شَعَّ بياضُها","في ظلمة الوادي شُعاع هلالِهِ",18,"ل",2,0],["الثورة الكبرى نمتْ","ك، وأنت أنت لها ربيب",19,"ب",1,0],["الثورةُ الكبرى التي","جدنا لها بدم الشباب",20,"ب",1,0],["الثغرُ أين مضى رُواؤهُ؟","أوَلم يفارقهُ شتاؤهْ؟",21,"ا",3,1],["الثغر بات يئنُّ . أه","لونا وأنفُسنا فداؤه",21,"ا",3,0],["الثائرون على الطُّغيان من قِدَمٍ","بكلِّ حرٍّ يبيع الروح بالبَخَسِ",22,"س",1,0],["الثياب الفَرْهاء رفَّتْ عليهم","كضمادٍ غطَّ جِراحاً وطَعْنا",23,"ن",2,0]]}