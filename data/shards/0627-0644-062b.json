=199811",""],[5452,"غادة الطوارق","https://www.poetsgate.com/ViewPoem.aspx?id=112029",""],[5493,"في شِرعَتِي هذه البلدَان كالحرَم","https://www.poetsgate.com/ViewPoem.aspx?id=196991",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5626,"يحيا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189695",""],[5764,"جنازة الزفه","https://www.poetsgate.com/ViewPoem.aspx?id=137043",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5842,"تساؤلات حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=73686",""],[5851,"حزن اليتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=175236",""],[5956,"الثلج يعزلنا","https://www.poetsgate.com/ViewPoem.aspx?id=182424",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[5956,"المنيرُ الرّوحيُّ المفضال","https://www.poetsgate.com/ViewPoem.aspx?id=194141",""],[5956,"الثأر ما بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=194417",""],[5956,"هذي الطبيعة يا رفاهي غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=196809",""],[5992,"الثلجُ يسقطُ في أثنائِه بَرَدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=41809",""],[6115,"الثعل يحفر ويدفن في اطراف التلال","https://www.poetsgate.com/ViewPoem.aspx?id=186434",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[5464,"يا منقذي من وحول العار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=490&r=&rc=4",""],[6320,"أَجْرَاسُ السَّفَر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84361&r=&rc=58",""],[572,"الثّلجُ يسقُطُ أمْ لُجينٌ يُسْبَكُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9422&r=&rc=279",""]],"verses":[["أَلثامٌ شفَّ عَن وردٍ ندِ","أَم غمامٌ ضحكت عَن بَرَدِ",0,"د",1,1],["أَلثَّرَاءُ المُسْتَعَزُّ بِهِ","كَنْزُهُ فِي العَقْلِ لاَ التُّرْبِ",1,"ب",1,0],["الثاقب الرأي الذي نوره","فاز بفانوس على المشعل",2,"ل",1,0],["الثُّكْلُ مَوْتٌ طَوِيلٌ","مَدَاهُ فِي تَبْرِيحِهْ",3,"ح",2,0],["الثُّماليُّ ثِمالُ المُرْتجَى","مُطلِقُ الأصفاد والطَّلْقُ الصّفُودُ",4,"د",1,0],["الثائِرِ المُتَفَجِّرِ الدَفّاقِ","لَولاهُ لَم تَشمَخ جِبالُ بِلادي",5,"ي",1,0],["الثكالى اذا بكين فان الضعف","عذر المفجوعة المثكال",6,"ل",1,0],["الثابِتينَ فُروسَةً كَجُلودِها","في ظَهرِها وَالطَعنُ في لَبّاتِها",7,"ت",3,0],["الثَغرُ وَالنَحرُ وَالمُخَلخَلُ وَال","مِعصَمُ دائي وَالفاحِمُ الرَجِلُ",8,"ل",1,0],["ألثَّ عليه كلُّ جَوْنٍ ربَابَهُ","يُسِفُّ إِلى أن يَمْسَحَ الأرضَ بالخَمْلِ",9,"ل",1,0],["أَلثم الدّرَّ حصىً ينبع لي","بزلالٍ ناقعاً فيه التياح",10,"ح",1,0],["ألثغ بالراءِ زارَ بيتي","فجاءَنا حاسدٌ وأصغى",11,"غ",2,1],["الثّابتين على الهُدى ما زُلزلوا","يوماً ولا عَرفوا سبيل مَلالِ",12,"ل",1,0],["الثّاوياتُ على هُدىً من ربّها","والسّابحاتُ السّائحاتُ الجُوَّلُ",13,"ل",1,0],["الثلاثون لم تكن عمرَكَ السَّا","دِرِ في فتنةِ الصِّبا ومراحِهْ",14,"ح",2,0],["الثلاثون قد مَضَتْ","في النفاهاتِ والهذَرْ",15,"ر",1,0],["ألثم السدة التي إن أنلها","تهو فيها وتسجد الجوزاء",16,"ا",2,0],["أَلَثَّتْ علَيْهَا المُعْصِراتُ بقَطْرِهَا","وجَرَّتْ بها هُوجُ الرِّيَاحِ مُلاءَهَا",17,"ا",3,0],["الثورةُ البيضاءُ شَعَّ بياضُها","في ظلمة الوادي شُعاع هلالِهِ",18,"ل",2,0],["الثورة الكبرى نمتْ","ك، وأنت أنت لها ربيب",19,"ب",1,0],["الثورةُ الكبرى التي","جدنا لها بدم الشباب",20,"ب",1,0],["الثغرُ أين مضى رُواؤهُ؟","أوَلم يفارقهُ شتاؤهْ؟",21,"ا",3,1],["الثغر بات يئنُّ . أه","لونا وأنفُسنا فداؤه",21,"ا",3,0],["الثائرون على الطُّغيان من قِدَمٍ","بكلِّ حرٍّ يبيع الروح بالبَخَسِ",22,"س",1,0],["الثياب الفَرْهاء رفَّتْ عليهم","كضمادٍ غطَّ جِراحاً وطَعْنا",23,"ن",2,0],["الثابتين على مباديء قومهم","الحافظين ذمام من لا يخفر",24,"ر",1,0],["الثابت الجأش الرفيع مقامهُ","عذب السجايا طيب الأخلاقِ",25,"ق",1,0],["ألثم منه فما وجيدا","وأجتلي سالفا وخدّا",26,"د",2,0],["الثار دونك يا ليث الوغى الثارا","فليس غيرك عنا يكشف العارا",27,"ر",2,1],["أَلْثَمْننا بَرَداً زادَ الجوى لَهَباً","كَأّنما بَرْدُه في حَرّه شُعَلُ",28,"ل",1,0],["ألثمني خدّه شقِيقا","وعلّنِي ريقه سُلافا",29,"ف",2,0],["الثابِتُ العَزَماتِ في دَحضٍ وَأَق","دَامُ الأَعادي رَحبَةً تَتَزَلزَلُ",30,"ل",1,0],["الثابِتِ الأَراءِ في","دَحضٍ بِواطِئِهِ زَليلِ",31,"ل",1,0],["الثابِتُ الآراءِ في","كُلِّ مَقامٍ مُزلِقِ",32,"ق",1,0],["الثدى در له وَالغيم ظلله","وانشق في الافق بدر شق ظلماها",33,"ا",3,0],["الثَّأْرُ مَضْمُونٌ وَفِي أَيْمانِنا","بِيضٌ كخاطِفَةِ الْبُرُوقِ اللُّمَّعِ",34,"ع",1,0],["اِلثم الثَغر إِن أَباح","منية القلب أو أبى",35,"ب",2,0],["الثابت الجأش في سِلْم ومعترك","في موطن الفخر قد أرسى له قدما",36,"م",2,0],["الثابت الجأش الوقور جانباً","ما ارتاع من حادثة ولا انثنى",37,"ا",1,0],["الثابتون على الجياد إذا همُ","هّموا إلى حربٍ ثباتَ جلودها",38,"د",3,0],["الثّابتُ العزمِ إذا طيشٌ هفا","والواجدُ الرّأي إذا الرّأي بَطَلْ",39,"ل",1,0],["الثَّلْجُ يَسْقُطُ أَمْ لُجَيْنٌ يُسْبَكُ","أَمْ ذَ حَصَى الكَافُورِ ظَلَّ يُفَرَّكُ",40,"ك",1,1],["أَلْثُمُ منه لُؤلؤاً أَبْيَضاً","أَغْنَى به عَنْ حَجَرٍ أَسْودِ",41,"د",1,0],["الثغر يبسم والمدائن تجذل","ووجوه كل شعوبها تتهلل",42,"ل",1,1],["الثُرَيّا الَّتي قَدِمتُ عَلَيها","بِضَئيلِ السُهى وَشِبهِ القَتامِ",43,"م",1,0],["الثلج قد جاء على أشهب","وعم بالبلقا وسيع الفضا",44,"ض",2,1],["الثقيلُ الذي يُقاس بِرَضْوَى","ثِقَلاً أو يفوقُهُ في القياس",45,"س",1,0],["الثلجُ ريشُ الغمامِ ينثرُهُ","لأنَّ هذا الغمامَ قد قَرْنَص",46,"ص",1,0],["الثّاقِبُ الفِكر لا تَخفاهُ غائِبَة","بِرَأيِهِ الصائِبِ المَحفوظِ مِن غبنِ",47,"ن",1,0],["أَلثِمُ مِن كاساتِها مَبسِماً","فيهِ شِفاهٌ خِلتُها لُعْسا",48,"س",2,0],["الثّغرُ أَقاحٌ بِهِ السُّلافَةُ وَالراحْ","وَالخدُّ كَرَوضٍ بِهِ الورودُ وَتُفّاحْ",49,"ح",1,1],["الثَعلَبُ المَكار كانَ يَسعى","فَشاهَدَ الحِصان وَهوَ يَرعى",50,"ع",2,1],["ألثم ثغرا له نسيم","يعرفه تعرف اللطائم",51,"م",1,0],["أَلثّ بها جون السحابِ مواصلاً","قطارَ الحيا من ودقهِ بقطارِ",52,"ر",1,0],["ألثّ على أَطلاله كلّ مدجن","وكلّ هتونٍ بالشآبيب ناضحِ",53,"ح",1,0],["الثار... فليحرق لهيب","ُ الثار هذي الباكية",54,"ي",2,0],["الثائرين على الغموض","وكل منسدل حجاب",55,"ب",1,0],["أَلثَغُ يُضْحي عِنْدَه","كُلُّ فَصيحٍ أَلْثَغَا",56,"غ",2,0],["الثم الصدع والسوالف منه","احتجاجاًبأننا في سرار",57,"ر",1,0],["الثكل عِندي أَحلى","مِنهُم فَخل العذلا",58,"ل",2,0],["الثلث صافٍ مثل طبعك حينما","تحلو معاشرة الرفاق وتصدق",59,"ق",1,0],["الثلث والرقاعُ والمحقق","والنسخ والتوقيع حيثُ يُطلَقُ",60,"ق",1,0],["الثابت العزم والأبطال في قلقٍ","والراسخ الحزم والألباب في حيَر",61,"ر",1,0],["الثغر يا قوتة في خرتها لعسٌ","لو ذاقه الرجل الفاني لعاد صبي",62,"ب",2,0],["الثيها من كدي يهبطن صبا","ضبوط السيل بين القنتين",63,"ن",1,0],["الثور والبقرة دِي","العام ومن قبله",64,"ل",2,1],["الثلج من لبنان شاطئ خاطري","والأرز منه مجتلى آياتي",65,"ت",2,0],["الثابتينَ على الإيمانِ جُهدَهُمُ","وَالصادِقينَ فما مانوا وَلا خَتَروا",66,"ر",3,0],["ألثّت عليها ديمةٌ بعد وابلٍ","فللصخر من جَوخ السيول وحبيب",67,"ب",1,1],["الثابتين وقد تزايل غيرهم","فهم الجبال الشم جيلا جيلا",68,"ل",2,0],["أَلثَّت عَلَيهِ كُلُّ سَحّاءَ وابِلٍ","فَللجِزع مِن خَوعِ السُّيولِ قَسيبُ",69,"ب",1,0],["الثابتين إِذا قَلب الشجاع هَفا","وَالباسمين إِذا لَيث الشَري عبسا",70,"س",2,0],["الثانيُ المشهورُ فوقَ الرابع","يُسمَى لَكَ الأعرَجَ إسماً شايع",71,"ع",1,0],["ألثم خديه وكم انثني","نشوان من رشف ثناياه",72,"ا",2,0],["ألثمها من فرعها","لمنتهى كعابها",73,"ب",3,0],["الثلج أهدانا صباحاً أبيضا","والروض قبل ربيعه قد أروضا",74,"ض",2,1],["الثَوبُ يَبلى ثُمَّ يُشتَرى غَيرُهُ","وَالعِرضُ بَعدَ هَلاكِهِ لا يُشتَرى",75,"ا",1,0],["الثاكِلات وَحيدها","ملأت بك الدنيا ثكولا",76,"ل",2,0],["الثوب ينسل من أطرافه وأرى","ثوب الجزيرة منسولا من الوسط",77,"ط",1,0],["الثائر الوطني في ميدانه","عجبي له من مستقر ثائر",78,"ر",1,0],["الثديُّ الحسان تبغي رضاها","ما لثغر الفطيم غير رضيِّ",79,"ي",1,0],["أَلْثُمُ مِن خَدِّها بَنَفْسَجَةً","وَنَرْجِساً فَتَّحَتْهُ عَيْناها",80,"ا",3,0],["الثالث الفصل وذاك ما حم","بأي شيء هو ذلك لو سئل",81,"ل",1,0],["الثابِت العزمات حيث تزلزلَت","شم الربى وَالخطب ليل أَدهَم",82,"م",1,0],["الثغر يبسم والوجوه عوابس","والوجه يشرق والوقائع جون",83,"ن",1,0],["الثاقب الآراء نجل الثاقب ال","آراء نجل الثاقب الآراء",84,"ا",2,0],["الثابت الأقدام بالأقدام من","لولاه ماد بنا الوجود ومارا",85,"ر",2,0],["الثابت الأقدام أقداما ومن","عرف الحقيقة لم يزغ قدماه",86,"ا",2,0],["الثوابيُّ فتى ليس له","في سوى السؤدد والمجد وَطَر",87,"ر",1,1],["الْثم ثرى قبرِ النبيِّ محمَّدٍ","وبذلك العَفَرِ الأَسرَّةً عَفرِ",88,"ر",1,0],["الثاقب الفكر كم أبدى بفكرته","من مضمر بحجاب الغيب مستتر",89,"ر",1,0],["الثَّغرُ منه وخدُّه وجبينُه","للنَّورِ بل للنَّارِ بل للنُّورِ",90,"ر",1,0],["الثورةُ الغضبى مَدَى عينه","وجُثَّةُ السلطةِ في ظِفْرِهِ",91,"ر",2,0],["الثراءُ مفخرةٌ","والأديب متّهمُ",92,"م",1,0],["ألثمُ السوسنَ ضنّي أنّها","ثمَّ أصحو حيثُ يعروني الخجلْ",93,"ل",1,0],["الثاقب الفكر الذي أروعُ","جلت سنا وجلت دجى الأوهام",94,"م",1,0],["الثمن ليه ولماذا يوم لازم تدفعين","الثمن كلّه دفعته والضرايب والرسوم",95,"م",1,0],["الثانيه تقوى الولي به مياسير","خلك تقي حصن لنفسك عن العار",96,"ر",1,0],["الثرى يا مايسه مغروركي","ومن يلومه ما يعرف سر الغرور",97,"ر",1,0],["الثّغر في رجفة والهمس يطربني","والورد في حمرة الخدّين من خجل",98,"ل",1,0],["الثَّوْبُ أَبْلَىْ مِنْ بَرَاْعَةِ صَدْرِهَاْ","وَالنَّهْدُ يَبْكِيْ فِيْ الْمَلاْبِسِ ضَيِّقَا",99,"ق",2,0],["الثانيه دونك مثل السنه مرت","وقلب مجنونك من فرقتك تاعب",100,"ب",1,0],["ألث به كل غيث.. ..","فطورا يرد وطورا يبل",101,"ل",1,0],["الثّوبُ خَبَّرَ: إنَّ النّهدَ مَهلَكَةٌ،","بدا ليَ النّهدُ ... إنَّ الثّوبَ كَذّابُ",102,"ب",1,0],["ألثم كالملهوف في نشوة","تعلو ومن يعلو سوى المقدم ؟",103,"م",1,0],["الثأر نار فى دمى","ويدى يعاتبها الحسام",104,"م",1,0],["الثعلب يلهو جزلانا","والفأرة فى وهو ظاهر",105,"ر",1,0],["الثمتها قبلا في الحلم لاهبتي","لما أطلت بطرف العين والقدم",106,"م",1,0],["الثائرون غمام الله في حجركْ","ليغسلَ الملح والتجفاف عن ثغركْ",107,"ك",1,1],["الثائرون قناديل الحياة إذا","تفحَّم الدهر شقّوا الفجر في صدرك",107,"ك",1,0],["الثوب ناعم عند الصدر ينحصر","عن ربوتين وكأسي نشوة صينا",108,"ن",2,0],["اَلثَّوْبُ أَبيَضُ وَالْخيْبَاتُ منْ دَمِنَا","فَالْبَسْ حَرِيرًا مِنَ الْخَيبَاتِ تُحْتَرَمِ",109,"م",1,0],["أَلَثُّ مُلُوكِ أَهْلِ الأَرْضِ غَيْثاً","وَلِلأَعْداءِ أَكْثَر