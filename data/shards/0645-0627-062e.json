ت","https://www.aldiwan.net/poem20795.html","البسيط"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[551,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[551,"ما خامر الرزق قلبي قبل فجأته","https://www.aldiwan.net/poem47854.html","البسيط"],[551,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[553,"تفاحة شامية","https://www.aldiwan.net/poem68255.html","مجزوء الرجز"],[562,"قف بالديار وحي القوم عن كثب","https://www.aldiwan.net/poem52914.html","البسيط"],[562,"لك الهناء بما أوتيت معتذرا","https://www.aldiwan.net/poem52962.html","البسيط"],[567,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[575,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[584,"من حس لي الأخوين كالغصنين","https://www.aldiwan.net/poem69383.html","مجزوء الكامل"]],"verses":[["ما خَلَعَ الدَهرُ عَنهُ سّابِغَةً","وَاللَيثُ لا يُنتَضى مِنَ اللَبَدِ",0,"د",1,0],["ما خالِدٌ بَعدَما قَد سِرتُ طالِبَهُ","بِخالِدٍ لا وَلا الجَيداءُ تَفتَخِرُ",1,"ر",1,0],["ما خلّفَتْ ذِكْراً ولا رَحْمَةً","في فَمِ إنْسانٍ ولا في فؤادْ",2,"د",1,0],["ما خَطبُها عَجَباً وَما خَطبي بِها","ما لي أُشاطِرُها الوَجيعَةَ ما لي",3,"ل",2,0],["ما خَطبُ ذا الكَلبِ قالَ الجوعُ يَخطِفُهُ","مِنّي وَيُنشِبُ فيهِ النابَ مُغتَصِبا",4,"ب",2,0],["ما خِلتُهُ يَفنى وَأَبقى بَعدَهُ","يا بُؤسَ عَيشي ما أَمَرَّ وَأَنكَدا",5,"د",2,0],["ما خَلَّفا إِذ وَدَّعا","في سُؤدُدٍ شَرواهُما",6,"م",2,0],["مَا خِلْتُ رُؤْيَتَهُ بِبَهْجَتِهَا سِوَى","رُؤْيَا بَدَتْ لِي فِي لَذِيذِ مَنَامِ",7,"م",1,0],["ما خَطَّ لا كاتِباهُ في صَحيفَتِهِ","كَما تُخَطَّطُ لا في سائِرِ الصُحُفِ",8,"ف",1,0],["ما خرج الفستق من قشرهِ","فيها وقد أخرجت من قشري",9,"ي",1,0],["ما خالفتك النجوم الزّهر في شبهٍ","إلاَّ بتقصيرِها عن مجدِك العالي",10,"ي",1,0],["ما خصَّ مأتم أهليها بل اتّفقت","في كلِّ بابٍ من التقوى مآتمه",11,"م",2,0],["ما خفتُ في المدحِ من ذنبٍ أقارفه","فإنَّ في مدحِك المقبول غفرانا",12,"ن",2,0],["ما خَمَدَتْ ناري ولكنني","ألقى قلوباً نارُها خامدَهْ",13,"د",2,1],["ما خَلَوْا من شرفٍ يَبْنونَهُ","مُذْ خَلتْ منهم حُجُورٌ ومُهودُ",14,"د",1,0],["ما خلت من يُهدي لنا فانياً","نجزيه عنه باقياً يخسر",15,"ر",1,0],["ما خانك السيف إذ خانتك نصرتُهُ","وفيه منتصَرٌ يوماً لمنتصِر",16,"ر",1,0],["ما خِلتُ أن رميّاً","رميتَهُ فيه نبضُ",17,"ض",1,0],["ما خفَّ قطُّ لتصريفٍ يُصرِّفهُ","وهل يخِفُّ لنفخ الريح ثهلان",18,"ن",1,0],["ما خلا من محاسن الزهَرِ الغضْ","ضِ ولا من مَطايب الريحان",19,"ن",1,0],["ما خان دهرٌ مُؤذِنٌ بصروفهِ","ما انفكّ يُرسل بالمواعِظ آذنا",20,"ن",2,0],["ما خِلتُ أن اللَّه سبحانه","يجمع ما فيهِ وبُغضَ النَّبيّ",21,"ي",1,0],["ما خانَني فِكري وَلا قَلَمي","لَكِن رَأَيتُ الشِعرَ قَد كَسَدا",22,"د",2,0],["ما خَفَروا ذِمَّة وَلا نَكَثوا","عَهدا وَلا مَلَأو وَلا غَدَروا",23,"ر",3,0],["ما خابَ داعٍ إِلى العِداءِ","وَلَم يَفُز ناصِحٌ حَكيمِ",24,"م",1,0],["ما خُنتُ عَهدَكُمُ كَما","زَعَمَ الوُشاةُ وَلا أَخونُ",25,"ن",1,0],["ما خطب روض الشعر اصبح دوحه","بين البواسق اجرداً لا يورق",26,"ق",1,0],["ما خير ناس اجفلت من ظلها","فقضى على غاياتها اجفالها",27,"ل",3,0],["ما خَلفُهُ إِلّا مَقودٌ طائِعٌ","مُتَلَفِّتٌ عَن كِبرِياءِ مُطاعِ",28,"ع",1,0],["ما خُنتُ هَواكَ وَلا خَطَرَت","سَلوى بِالقَلبِ تُبَرِّدُهُ",29,"د",2,0],["ما خِلتُ جَنّاتِ النَعيمِ وَلا الدُمى","تُرمى بِمَشهودِ النَهارِ سَفوكِ",30,"ك",1,0],["ما خَفَّ إِلّا لِلهَوى وَالعُلا","أَو لِجَلالِ الوَفدِ في رَكبِهِ",31,"ب",2,0],["ما خالفوا حكمتنا","لو وفقوا للرشدِ",32,"د",1,0],["مَأخوذَةٌ لِلأُمورِ أُهبَتُهُ","تَسبِقُها قَبلَ وَقتِها عُدَدُه",33,"د",2,0],["ما خَطبُ مَن حُرِمَ الإِرادَةَ وادِعاً","خَطبَ الَّذي حُرِمَ الإِرادَةَ جاهِدا",34,"د",2,0],["ما خالَفَ المُلكُ حالَتَيهِ وَلا","غَيَّرَ عِزُّ السُلطانِ مِن كَرَمِه",35,"م",2,0],["ما خَيرُ مَن لايُرتَجى نَفعُهُ","يَوماً وَلا يُؤمَنُ مِنهُ الأَذى",36,"ا",1,0],["ما خَيرُ مَن يُدعى لِيُحرِزَ حَظَّهُ","مِن دينِهِ فَيَكونُ غَيرَ مُطاوِعِ",37,"ع",1,0],["ما خَيرُ دارٍ يَموتُ ساكِنُها","وَأَغفَلُ الغافِلينَ آمِنُها",38,"ه",2,1],["ما خَيرُ مُرضِعَةٍ بِكَأ","سِ المَوتِ تَفطِمُ مَن غَذَت",39,"ت",1,0],["ما خِلتُ أَنَّ نَداكَ تُقلِعُ سُحبُهُ","عَنّا وَيَنضُبُ بَحرُهُ المَسجورُ",40,"ر",1,0],["ما خطبهم في روضة حالت","أو صوّحت أفنانها الخُضُل",41,"ل",1,0],["ما خنت عهدي لمن تولى","كلا ولا خانني اصطبار",42,"ر",1,0],["ما خِلتُ قَلبي وَتَبريحي يُقَلِّبُهُ","إلا جناحَ قطاةٍ في اعتقال شَرَك",43,"ك",1,0],["ما خَطبُهُ ما دَهاهُ ما غالَهُ","ما نالَهُ في الحِسانِ مِن خُرُدِه",44,"د",2,0],["ما خالِدٌ لي دونَ أَيّوبٍ وَلا","عَبدُ العَزيزِ وَلَستُ دونَ وَليدِ",45,"د",1,0],["ما خُنتُ عَهدَ القَتولِ إِذ شَحطَت","وَلو أَتَوها بِهِ لِتَصرِمَني",46,"ي",1,0],["ما خُنتُ عَهدَكِ يا عُثَيمَ وَلا هَفا","قَلبي إِلى وَصلٍ لِغَيرِكِ فَاعلَمي",47,"ي",1,0],["ماخَطَّ مِن غُرَرِ الحِسانِ وَضاءَةً","حَتّى اِستَمَدَّ لَها مِنَ الأَحداقِ",48,"ق",1,0],["ما خَطْبُنَا بين الشّعوبِ أما كفى","أنّا نُعابُ بديننا ونُعيَّرُ",49,"ر",1,0],["ما خطبُ هذا الذي لاقَتْ فوارسُهُ","عِندَ القديدِ أيَمضِي غير مُعتاقِ",50,"ق",1,0],["ما خَصبَةٌ حَصبائُها جَوهَرٌ","إِن لَم تَكُن في فَمِ شُرٍّ فَمَن",51,"ن",1,0],["ما خُصَّ مِن آفاقِ قامَتِهِ","أُفُقٌ بِتَفضيلٍ عَلى رُفُقِ",52,"ق",1,0],["ما خِنجَرٌ تَسلُبُ روحي بِهِ","أَقتَلُ مِن تَفتيرِ عَينَيكا",53,"ك",2,0],["ما خُيِّرَ القَلبُ إِلّا اِختارَ قُربَكُمُ","وَلا سَرى الشَوقُ إِلّا هاجَ إِسهادا",54,"د",2,0],["ما خَصَّ مِصراً وَبَأٌ وَحدَها","بَل كائِنٌ في كُلِّ أَرضٍ وَبَأ",55,"ب",2,1],["ما خَفِيَت قُدرَتُهُ عَنكُمُ","وَهَل لَها عَن ذي رَشادٍ خَفاء",56,"ف",3,0],["ما خَضبُ رَأسٍ كَخَضبٍ في بَنانِ يَدٍ","وَحُمرَةُ الفَجرِ لَيسَت حُمرَةَ الشَفَقِ",57,"ق",1,0],["ما خُلَّةٌ بِأَغَرَّ مِنها وَالفَتى","يَبكي إِذا رَكِبَ الصَريمَةَ خِلُّهُ",58,"ل",2,0],["ما خانَ ذاكَ الفَتى وَلَكِن","حَثَّ سِواهُ عَلى الخِيانَه",59,"ن",2,0],["ما خُتِنَ القَومُ بِاِختِيارِهِم","إِذ جُلِبوا مِن طِرازٍ أَو خَتَنِ",60,"ن",1,0],["ما خاضَت الأحرار غمر كَريهة","إِلّا وأَنت