iwan.net/poem62711.html","عموديه"],[70,"أحبابنا وحياتكم","https://www.aldiwan.net/poem42442.html","مجزوء الكامل"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[62,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[49,"الحمد لله على ما نرى","https://www.aldiwan.net/poem10323.html","السريع"],[49,"ما يرتجى بالشيء ليس بنافع","https://www.aldiwan.net/poem62159.html","الكامل"],[49,"ما خير دار يموت ساكنها","https://www.aldiwan.net/poem63169.html","المنسرح"],[49,"المرء دنيا نفسه","https://www.aldiwan.net/poem64141.html","مجزوء الكامل"],[66,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[97,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[97,"كل الورى يدعون حبك","https://www.aldiwan.net/poem25066.html","مجزوء البسيط"],[80,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[31,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[31,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[105,"بني الملوح لا حام ولا واق","https://www.aldiwan.net/poem43577.html","البسيط"],[52,"حاجيتكم يا كل من لامني","https://www.aldiwan.net/poem26649.html","السريع"],[48,"قد مت غير حشاشة الرمق","https://www.aldiwan.net/poem64439.html","الكامل"],[48,"أوعدتني بالقتل من غير ما","https://www.aldiwan.net/poem64470.html","البسيط"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[46,"ما خص مصرا وبأ وحدها","https://www.aldiwan.net/poem22035.html","السريع"],[46,"انفرد الله بسلطانه","https://www.aldiwan.net/poem22038.html","السريع"],[46,"قد آن مني ترحال ولم أفق","https://www.aldiwan.net/poem23051.html","البسيط"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[46,"جمجم هذا الزمان قولا","https://www.aldiwan.net/poem23484.html","مجزوء البسيط"],[46,"لاتجلسن حرة موفقة","https://www.aldiwan.net/poem23540.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147484","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147501",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54323","البسيط"],[106,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[45,"رُنُوُّ ذاكَ الغَزَالِ، أوْ غَيَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31423",""]],"verses":[["ما خَلَعَ الدَهرُ عَنهُ سّابِغَةً","وَاللَيثُ لا يُنتَضى مِنَ اللَبَدِ",0,"د",1,0],["ما خالِدٌ بَعدَما قَد سِرتُ طالِبَهُ","بِخالِدٍ لا وَلا الجَيداءُ تَفتَخِرُ",1,"ر",1,0],["ما خلّفَتْ ذِكْراً ولا رَحْمَةً","في فَمِ إنْسانٍ ولا في فؤادْ",2,"د",1,0],["ما خَطبُها عَجَباً وَما خَطبي بِها","ما لي أُشاطِرُها الوَجيعَةَ ما لي",3,"ل",2,0],["ما خَطبُ ذا الكَلبِ قالَ الجوعُ يَخطِفُهُ","مِنّي وَيُنشِبُ فيهِ النابَ مُغتَصِبا",4,"ب",2,0],["ما خِلتُهُ يَفنى وَأَبقى بَعدَهُ","يا بُؤسَ عَيشي ما أَمَرَّ وَأَنكَدا",5,"د",2,0],["ما خَلَّفا إِذ وَدَّعا","في سُؤدُدٍ شَرواهُما",6,"م",2,0],["مَا خِلْتُ رُؤْيَتَهُ بِبَهْجَتِهَا سِوَى","رُؤْيَا بَدَتْ لِي فِي لَذِيذِ مَنَامِ",7,"م",1,0],["ما خَطَّ لا كاتِباهُ في صَحيفَتِهِ","كَما تُخَطَّطُ لا في سائِرِ الصُحُفِ",8,"ف",1,0],["ما خرج الفستق من قشرهِ","فيها وقد أخرجت من قشري",9,"ي",1,0],["ما خالفتك النجوم الزّهر في شبهٍ","إلاَّ بتقصيرِها عن مجدِك العالي",10,"ي",1,0],["ما خصَّ مأتم أهليها بل اتّفقت","في كلِّ بابٍ من التقوى مآتمه",11,"م",2,0],["ما خفتُ في المدحِ من ذنبٍ أقارفه","فإنَّ في مدحِك المقبول غفرانا",12,"ن",2,0],["ما خَمَدَتْ ناري ولكنني","ألقى قلوباً نارُها خامدَهْ",13,"د",2,1],["ما خَلَوْا من شرفٍ يَبْنونَهُ","مُذْ خَلتْ منهم حُجُورٌ ومُهودُ",14,"د",1,0],["ما خلت من يُهدي لنا فانياً","نجزيه عنه باقياً يخسر",15,"ر",1,0],["ما خانك السيف إذ خانتك نصرتُهُ","وفيه منتصَرٌ يوماً لمنتصِر",16,"ر",1,0],["ما خِلتُ أن رميّاً","رميتَهُ فيه نبضُ",17,"ض",1,0],["ما خفَّ قطُّ لتصريفٍ يُصرِّفهُ","وهل يخِفُّ لنفخ الريح ثهلان",18,"ن",1,0],["ما خلا من محاسن الزهَرِ الغضْ","ضِ ولا من مَطايب الريحان",19,"ن",1,0],["ما خان دهرٌ مُؤذِنٌ بصروفهِ","ما انفكّ يُرسل بالمواعِظ آذنا",20,"ن",2,0],["ما خِلتُ أن اللَّه سبحانه","يجمع ما فيهِ وبُغضَ النَّبيّ",21,"ي",1,0],["ما خانَني فِكري وَلا قَلَمي","لَكِن رَأَيتُ الشِعرَ قَد كَسَدا",22,"د",2,0],["ما خَفَروا ذِمَّة وَلا نَكَثوا","عَهدا وَلا مَلَأو وَلا غَدَروا",23,"ر",3,0],["ما خابَ داعٍ إِلى العِداءِ","وَلَم يَفُز ناصِحٌ حَكيمِ",24,"م",1,0],["ما خُنتُ عَهدَكُمُ كَما","زَعَمَ الوُشاةُ وَلا أَخونُ",25,"ن",1,0],["ما خطب روض الشعر اصبح دوحه","بين البواسق اجرداً لا يورق",26,"ق",1,0],["ما خير ناس اجفلت من ظلها","فقضى على غاياتها اجفالها",27,"ل",3,0],["ما خَلفُهُ إِلّا مَقودٌ طائِعٌ","مُتَلَفِّتٌ عَن كِبرِياءِ مُطاعِ",28,"ع",1,0],["ما خُنتُ هَواكَ وَلا خَطَرَت","سَلوى بِالقَلبِ تُبَرِّدُهُ",29,"د",2,0],["ما خِلتُ جَنّاتِ النَعيمِ وَلا الدُمى","تُرمى بِمَشهودِ النَهارِ سَفوكِ",30,"ك",1,0],["ما خَفَّ إِلّا لِلهَوى وَالعُلا","أَو لِجَلالِ الوَفدِ في رَكبِهِ",31,"ب",2,0],["ما خالفوا حكمتنا","لو وفقوا للرشدِ",32,"د",1,0],["مَأخوذَةٌ لِلأُمورِ أُهبَتُهُ","تَسبِقُها قَبلَ وَقتِها عُدَدُه",33,"د",2,0],["ما خَطبُ مَن حُرِمَ الإِرادَةَ وادِعاً","خَطبَ الَّذي حُرِمَ الإِرادَةَ جاهِدا",34,"د",2,0],["ما خالَفَ المُلكُ حالَتَيهِ وَلا","غَيَّرَ عِزُّ السُلطانِ مِن كَرَمِه",35,"م",2,0],["ما خَيرُ مَن لايُرتَجى نَفعُهُ","يَوماً وَلا يُؤمَنُ مِنهُ الأَذى",36,"ا",1,0],["ما خَيرُ مَن يُدعى لِيُحرِزَ حَظَّهُ","مِن دينِهِ فَيَكونُ غَيرَ مُطاوِعِ",37,"ع",1,0],["ما خَيرُ دارٍ يَموتُ ساكِنُها","وَأَغفَلُ الغافِلينَ آمِنُها",38,"ه",2,1],["ما خَيرُ مُرضِعَةٍ بِكَأ","سِ المَوتِ تَفطِمُ مَن غَذَت",39,"ت",1,0],["ما خِلتُ أَنَّ نَداكَ تُقلِعُ سُحبُهُ","عَنّا وَيَنضُبُ بَحرُهُ المَسجورُ",40,"ر",1,0],["ما خطبهم في روضة حالت","أو صوّحت أفنانها الخُضُل",41,"ل",1,0],["ما خنت عهدي لمن تولى","كلا ولا خانني اصطبار",42,"ر",1,0],["ما خِلتُ قَلبي وَتَبريحي يُقَلِّبُهُ","إلا جناحَ قطاةٍ في اعتقال شَرَك",43,"ك",1,0],["ما خَطبُهُ ما دَهاهُ ما غالَهُ","ما نالَهُ في الحِسانِ مِن خُرُدِه",44,"د",2,0],["ما خالِدٌ لي دونَ أَيّوبٍ وَلا","عَبدُ العَزيزِ وَلَستُ دونَ وَليدِ",45,"د",1,0],["ما خُنتُ عَهدَ القَتولِ إِذ شَحطَت","وَلو أَتَوها بِهِ لِتَصرِمَني",46,"ي",1,0],["ما خُنتُ عَهدَكِ يا عُثَيمَ وَلا هَفا","قَلبي إِلى وَصلٍ لِغَيرِكِ فَاعلَمي",47,"ي",1,0],["ماخَطَّ مِن غُرَرِ الحِسانِ وَضاءَةً","حَتّى اِستَمَدَّ لَها مِنَ الأَحداقِ",48,"ق",1,0],["ما خَطْبُنَا بين الشّعوبِ أما كفى","أنّا نُعابُ بديننا ونُعيَّرُ",49,"ر",1,0],["ما خطبُ هذا الذي لاقَتْ فوارسُهُ","عِندَ القديدِ أيَمضِي غير مُعتاقِ",50,"ق",1,0],["ما خَصبَةٌ حَصبائُها جَوهَرٌ","إِن لَم تَكُن في فَمِ شُرٍّ فَمَن",51,"ن",1,0],["ما خُصَّ مِن آفاقِ قامَتِهِ","أُفُقٌ بِتَفضيلٍ عَلى رُفُقِ",52,"ق",1,0],["ما خِنجَرٌ تَسلُبُ روحي بِهِ","أَقتَلُ مِن تَفتيرِ عَينَيكا",53,"ك",2,0],["ما خُيِّرَ القَلبُ إِلّا اِختارَ قُربَكُمُ","وَلا سَرى الشَوقُ إِلّا هاجَ إِسهادا",54,"د",2,0],["ما خَصَّ مِصراً وَبَأٌ وَحدَها","بَل كائِنٌ في كُلِّ أَرضٍ وَبَأ",55,"ب",2,1],["ما خَفِيَت قُدرَتُهُ عَنكُمُ","وَهَل لَها عَن ذي رَشادٍ خَفاء",56,"ف",3,0],["ما خَضبُ رَأسٍ كَخَضبٍ في بَنانِ يَدٍ","وَحُمرَةُ الفَجرِ لَيسَت حُمرَةَ الشَفَقِ",57,"ق",1,0],["ما خُلَّةٌ بِأَغَرَّ مِنها وَالفَتى","يَبكي إِذا رَكِبَ الصَريمَةَ خِلُّهُ",58,"ل",2,0],["ما خانَ ذاكَ الفَتى وَلَكِن","حَثَّ سِواهُ عَلى الخِيانَه",59,"ن",2,0],["ما خُتِنَ القَومُ بِاِختِيارِهِم","إِذ جُلِبوا مِن طِرازٍ أَو خَتَنِ",60,"ن",1,0],["ما خاضَت الأحرار غمر كَريهة","إِلّا وأَنت الأوّل السباق",61,"ق",1,0],["ما خَضَبَتْهُ المُهَنّداتُ لها","ولا العَوالي سِوى رَشَاشِ دَم",62,"م",1,0],["ما خِلْتُ هَمّاماً لوِ ابْتاعَها","يَفِرّ مِن خَوْفِ أبي جَهْضَم",63,"م",1,0],["مأخوذة مانعة في الورى","نفس بحكم الله مأخوذه",64,"ذ",2,0],["ما خبر الغابر عن","دفينه أين سلك",65,"ك",1,0],["مَا خَلَقَ اللهُ الْوَرَى بَاطِلاً","لِيَرْتَعُوا بَيْنَ الْبَوَادِي سُدَى",66,"د",2,0],["ماخطب هذا وهو أهول ما رأت","عين وما سمعت به أذنان",67,"ن",1,0],["ما خَطَّ مِذراعُ القَنا بيراعه","غَير العُشورِ وَلا خَطا لِخَطاءِ",68,"ا",2,0],["ما خِلتُ قَبلَ مَغيبِ وَجهِكَ في الثَرى","أَنَّ البُدورَ تَحوزهُنَّ رُموسُ",69,"س",1,0],["ما خَطْبُها والنارُ مِنْ حَوْلِها","والْمَوْتُ لم يَتْرُكْ لها مَفْزَعا",70,"ع",2,0],["ما خطّ زيدانُ أسطاراً على صحفٍ","لكن جلا صُوَراً من صُنْعِ فَنّانِ",71,"ن",1,0],["ما خيرُ علم لم يُزَوَّدْ ربُّه","بكريم أخلاقٍ، وحُسْنِ طِباع؟",72,"ع",1,0],["ما خَصرُها وهو عُريانٌ تتيهُ بهِ","أرقُّ منه إذِ الزُّنَّارُ مشدود",73,"د",1,0],["مأخُوذَةٌ للأُمُورِ أُهْبَتُهُ،","نَسْبُقُهُا، قَبلَ وَقتها، عُدَدُه",74,"د",2,0]]}