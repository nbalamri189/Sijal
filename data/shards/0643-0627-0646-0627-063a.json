{"poems":[[48,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141962","الطويل"],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[203,"ألا ترى الزهر في رباه","https://www.aldiwan.net/poem45352.html","مخلع البسيط"],[287,"أنظر إلى أيكة يلوح بها","https://www.aldiwan.net/poem32853.html","المنسرح"],[303,"لا هم دمعي من طول البكا نفدا","https://www.aldiwan.net/poem36823.html","عموديه"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199618","المسحوب"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44820","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92093","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[4755,"الشَّوقُ كانَ سُؤَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184674",""],[5758,"خياط الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=214576",""]],"verses":[["كَأَنَّا غُروبٌ مُكرَهاتٌ عَلى العُلى","تُمَدُّ إِلى أَعلى الرَكِيِّ بِأَشطانِ",0,"ن",1,0],["كأن أغصانه لما برزت لها","سربلإ من الحور في أثواب أعياد",1,"د",1,0],["كأنا غدوة وبني أبينا","بجنب عنيزة رحيا مدير",2,"ر",1,0],["كأنَّ أغصانهُ الحواني","هذا وليٌّ وذا يتيمُ",3,"م",1,0],["كَأَنَّ أَغصانَها الزَبَرجَدُ قَد","رُصِّعَ فيها فُصوصُ ياقوتِ",4,"ت",1,0],["كأنَّ إغضاءهم إغضاء ذي كرمٍ","عن الإِساءةِ خلقاً طاهراً وَهدى",5,"د",2,0],["كان أغلى الأوقاتِ في النفسِ قَدْراً","فتلاشى زمانُه واضمحلا",6,"ل",2,0],["كان اغتنت الأضعافي","واتباشرت لعباد",7,"د",1,0],["كَأَنَّ أَغصانَها كِرامٌ","تُقابِلُ الضَّيفَ بِارتِياحِ",8,"ح",1,0],["كأنّ أغصانَها اللدن الرشاق إذا","هصرت أعطافُها أعطافُ وطفاء",9,"ا",2,0],["كأنّا غريبان بقفرٍ تلاقيا","فما سلَّما إلا وقد أعجلا الركبا",10,"ب",2,1],["كان اغترابٌ وكان العود منتظراً","وصدعةُ البين مأمولاً تلاقيها",11,"ي",3,0],["كَانَ اغتِرَابُكَ يَومًا","عَن ناظِرَيَّ مُحَالَا",12,"ل",2,0],["كَأَنّ أُغْنِيَةً مِنْ قَلْبِ أَشْرَفِهِمْ","تَقُودُهَا فِي انْفِعَالِ الرُّوحِ أَنْفَاسُ",13,"س",1,0]]}