326.html","مجزوء الرمل"],[48,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[50,"دع ذكر عبدة إنه فند","https://www.aldiwan.net/poem63911.html","الكامل"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"إن شئت ترزق الدنيا ونعمتها","https://www.aldiwan.net/poem22172.html","البسيط"],[46,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[46,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[46,"لقد أتوا بحديث لا يثبته","https://www.aldiwan.net/poem23481.html","البسيط"],[19,"فإن يأتكم مني هجاء فإنما","https://www.aldiwan.net/poem364.html",""],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42534","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55144","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55190","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54606","السريع"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10242","الكامل"],[106,"ليثان يقتنصان","https://www.poetsgate.com/ViewPoem.aspx?id=179573",""],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[49,"ما أسرعَ الأيَّامَ فِي الشَّهرِ","https://www.poetsgate.com/ViewPoem.aspx?id=25123",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[45,"أمن نظري إليك صددت عني","https://www.poetsgate.com/ViewPoem.aspx?id=31385",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[45,"لا تكمل اللذات إلا","https://www.poetsgate.com/ViewPoem.aspx?id=31164",""],[91,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[51,"أبدرَ السماءِ وغيثَ السما","https://www.poetsgate.com/ViewPoem.aspx?id=30332",""],[18,"أَخٌ وَحَرِيمٌ سَيِّئ إنْ قَطَعْتَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26462&r=&rc=28",""]],"verses":[["فَاِختَلِس طَعنَ الزَمانِ بِها","إِنَّما الأَيّامُ أَقرانُ",0,"ن",1,0],["فَآخُذَ حَقّي أَو يَثورَ غُبارُها","مِنَ القاعِ عَن أَرضٍ بِشَرِّ مَقيلِ",1,"ل",1,0],["فَاِخبِط رَصيدَ فِتنَةٍ","تُخشى بِها الغَوائِلُ",2,"ل",1,0],["فَاِخلِط بِصَوتِكَ كُلَّ صَوتٍ وَاِستَمِع","هَل في المَنازِل مَن يُجيبُ دُعاءَ",3,"ا",2,0],["فأخْلَدَ منْ غِوايَتِهِ إلَيْهِمْ","وبانَ لهُ بهُلْكِهِمُ الرّشادُ",4,"د",1,0],["فاخْتالَ مِنبرُها بهِ وسَريرُها","وكِلاهُما طَرِبٌ إليه مَشوقُ",5,"ق",1,0],["فاخْلُدْ ودُمْ وانْعَمْ بسابِغِ نِعْمَةٍ","تَتْرَى ومُلْكٌ لا يُثَلُّ مَشيدُهُ",6,"د",2,0],["فَأَخَذتُ مِنها ما رَضيتُ بِأَخذِهِ","وَتَرَكتُ أَكثَرَ ما هُنالِكَ جانِبا",7,"ب",2,0],["فَأَخطَرتَ أَهلَكَ عَن أَهلِهِم","فَصادَفَ قِدحُكَ فَوزاً يَسيرا",8,"ر",2,0],["فَاِخضَرَّ فَوقَ رُبوعِ مِصرٍ عودُهُ","في مَنبِتٍ خِصبٍ وَرَحبِ جَنابِ",9,"ب",1,0],["فَأَخجَلَني البِرُّ مِن فَرطِهِ","وَإِنَّ الجَوابَ لَيُبدي الخَجَل",10,"ل",1,0],["فَاِختارَ مِنها لُجبَةً ذاتَ هَزَم","حاشِكَةَ الدَرَّةِ وَرهاءَ الرَخَم",11,"م",1,1],["فَأَخلَفنَ ميعادي وَخُنَّ أَمانَتي","وَلَيسَ لِمَن خانَ الأَمانَةَ دينُ",12,"ن",1,0],["فَاخْلُفُوهُ بِالحَقِّ وَاتَّخِذوا مِنْ","هُ لَكُمْ خَيرَ مُرْشِدٍ وَإِمَامِ",13,"م",1,0],["فَاِختَر لِنَفسِكَ ما أَقولُ فَإِنَّني","لا بُدَّ مُخبِرُهُم وَإِن لَم أَسأَلِ",14,"ل",1,0],["فَأَخفَيتُ شَوقي مِن رَفيقي وَإِنَّهُ","لَذو نَسَبٍ دانٍ إِلَيَّ وَذو حِجرِ",15,"ر",1,0],["فاختصرت في كلامي","ونظمت قد من قل",16,"ل",1,0],["فأخرج منها كنوز العلو","م لأهل الفنون وأهل الأدب",17,"ب",1,0],["فأخفقوا عاجزين عن درك","لبعض ما كلّه تيسرّ له",18,"ل",2,0],["فأخوك مَن إن غاب عَنْ","ك رعى وِدادك في غيابه",19,"ب",2,0],["فَاِخسَء إِلَيكَ فَلا سُلَيمٌ مِنكُمُ","وَالعامِرانِ وَلا بَنو ذُبيانِ",20,"ن",1,0],["فَأَخزَيتَ يا اِبنَ القَينِ آلَ مُجاشِعٍ","فَأَصبَحَ ما تَحمي مُباحاً مُدَعثَرا",21,"ر",2,0],["فَاِختارَ مِنها مِثلَ الخَريدَةِ لا","تَأمَنُ مِنهُ الحِذارَ وَالعَطَبا",22,"ب",2,0],["فاخِراتٌ ضُروعُها في ذُراها","وَأَناضَ العَيدانُ وَالجَبّارُ",23,"ر",1,0],["فاخَرَتني بِيَشكُرَ بنِ بَكرِ","وَأَهلِ قُرّانَ وَأَهلِ حَجرِ",24,"ر",1,1],["فَأَخي إِن شَرِبوا مِن خَيرِهِم","وَأَبو الحَزّازِ مِن أَهلِ النَفَل",25,"ل",1,0],["فاختل حِضْنَىْ دِراكٍ وانثنى حِرجاً","لزارع طعنةٌ في شرقها نَجَلُ",26,"ل",1,1],["فَاِختَرتُ لَمّا وَقَفوا طَويلاً","عِشرينَ أَو فَوَيقَها قَليلا",27,"ل",2,0],["فَإِخواني وَنُدماني","وَعُذّالي وَعُوّادي",28,"ي",1,0],["فأخذتها كالتاج وهو مكلّلٌ","ورددتها مثل السوار بمعصم",29,"م",1,0],["فإخالُ الذي تُديرُ على القو","م حُروباً دوائرَ الأرحاءِ",30,"ا",2,0],["فأخلفتُمُ ما تَوسّمْتُهُ","وقلَّ حميدٌ على تَجْرِبَهْ",31,"ب",2,0],["فأخلفتِ الذي نرجو وصبَّتْ","علينا منك صاعقَةَ العذابِ",32,"ب",1,0],["فاخشَ ربَّ السماء وأْمَنْ هجائي","قد كفتني أخبارُك المبثوثهْ",33,"ث",2,0],["فأخرَجْتهُ مستخزياً راجلاً بما","بَثَثْتَ عليه من صنوف المكايدِ",34,"د",1,0],["فأخلف الله عليهِ بها","قرناً مكان الشَّعَرِ الجعْد",35,"د",1,0],["فاختار بنتاً لكي يكونَ لهُ","كَعْثبها وُصْلةً إلى الكَمر",36,"ر",1,0],["فاخْرُجْ له من حَقّه","وأنِبْ عسى يُنجيك ركْضُك",37,"ك",1,0],["فاخترعتم من الذكاءِ شُموساً","وابتدعتُم من السماح ظلالا",38,"ل",2,0],["فأخلاقُه تارةً وَعْرةٌ","وأخلاقُه تارة سهْلَهْ",39,"ه",1,0],["فاختبرْه في الحالتين جميعاً","تجدِ الجدَّ عنده والبطالهْ",40,"ل",2,0],["فاخبرْ وجرّبْ تجدْني حين تخبرني","أمْضى من السيف في الأعناق والقُللِ",41,"ل",1,0],["فأخْفى عليه ويخفى عليْ","يَ أن قد بغاني مُغيماً مُخيلا",42,"ل",2,0],["فاخلُفوا الغيثَ إذا أخلَفنا","ومتى صاب فباروا مُزنه",43,"ن",2,0],["فَاِختارَ بَعدَ تَمامِ الظِمءِ ناجِيَةً","مِثلَ الهِراوَةِ ثَنياً بِكرُها أَبِدُ",44,"د",1,0],["فَاِخسَأ كُلَيبُ إِلَيكَ إِنَّ مُجاشِعاً","وَأَبا الفَوارِسِ نَهشَلاً أَخَوانِ",45,"ن",1,0],["فَاِخفِض جَناحَكَ لِلأَنامِ تَفُز بِهِم","إِنَّ التَواضُعَ شيمَةَ الحُكَماءِ",46,"ا",2,0],["فَاِختَلَجَت أَوضاعُها بِالمُنى","وَجالَ ماءُ الحُسنِ في المُفرَدات",47,"ت",1,0],["فَاِخدِم بِلادَكَ مِثلُ موسى كاظِمٍ","تُسبِغ عَلَيكَ ثَنائَها الأَمصارُ",48,"ر",1,0],["فَاِخلَعنَ أَثوابَ الكَآبَةِ وَالأَسى","وَاِلبِسنَ مِن نورُ الضُحى سِربالا",49,"ل",2,0],["فَاِختَر صَحابَكَ وَاِنظُر في اِختِيارِهُمُ","إِلى الطَبائِعِ قَبلَ اللَونِ وَالدينِ",50,"ن",1,0],["فَاِختَلَفَت حالي وَحالاتُهُم","كَأَنَّني في غَيرِ أَقوامي",51,"ي",1,0],["فَاِختَرتُكُم لِمَوَدَّتي","وَلَكَم لَها عِندي زُبونُ",52,"ن",1,0],["فَاِختَرتُ ما عِندَهُ صَهباءَ صافِيَةً","مِن خَمرِ ذي نَطَفاتٍ عاقِدِ التاجِ",53,"ج",1,0],["فَأَخْرَجُوهُ ولكنْ","بعدَ القضاءِ الأَخيرِ",54,"ر",1,0],["فاختر لرأسك جلمودا لتضربه","ولا تقلّ على الارض الجلاميد",55,"د",1,0],["فاختر لبأسك قرِنه وأربأ به","أن يلتقى بسفاسف الأحرار",56,"ر",1,0],["فأخذ الإله","ما كان قد أعطاه",57,"ه",1,0],["فأخذ الرفيقة","وقال ذى الحقيقة",57,"ه",1,0],["فَاِختارَ لِلفَتح فَتى مُختَبَراً","معدِنُه فَكانَ جَوهَرُ الفَتى",58,"ا",1,0],["فَأُخِذَ الزائِرُ مِن أُذنِهِ","وَأُعطِيَ الكَلبَ بِهِ يَلعَبُ",59,"ب",1,0],["فَأَخرَجَت مِن طَيشِها لِسانَها","فَعَضَّهُ بِنابِهِ فَشانَها",60,"ه",2,0],["فَاِختارَهُ الفيلُ لَهُ طَريقا","مُمَزِّقاً أَصحابَنا تَمزيقا",61,"ق",2,0],["فَأَخبِث بِهِ طالِباً قَهرَهُم","وَأَخبِث بِهِ تارِكاً ما طَلَب",62,"ب",1,0],["فَأَخرَقَ رائِيَهُ ما رَأى","وَأَبرَقَ ناقِدَهُ ما اِنتَقَد",63,"د",1,0],["فَاِختَلَفَت في وابِلَي نِبالِ","مِن أَسفَلِ الطَودِ وَمِن مُعالِ",64,"ل",1,0],["فاخسَأ كليباً واقعُد على ذنَبٍ","واطلِ بما بينَ إليَتيكَ فمكْ",65,"ك",1,0],["فَأَخلاقُهُم بِالمُخزِياتِ رَهائِنٌ","وَأَعراضُهُم لِلمُندِياتِ حَصائِدُ",66,"د",1,0],["فَأَخَذتَ بَيعَتَهُم لِأَزكى قائِمٍ","بِالسَيفِ إِذ شَغِبوا عَلَيكَ فَأَجلَبوا",67,"ب",3,0],["فَآخِرُ نَظرَةٍ كانَت وَعيداً","وَأَوَّلُ نَظرَةٍ سَبَبُ الصُدودِ",68,"د",1,0],["فَاِخلَع عَلَيَّ سُروراً","بِكَونِكَ اليَومَ عِندي",69,"ي",1,0],["فَآخِرُ يَومِهِ سُكرٌ تَجَلّى","غَوايَتُهُ وَأَوَّلُهُ خُمارُ",70,"ر",1,0],["فَاخفِض جَناحَكَ لي وَصُنّي إِنَّني","كَالسامِرِيِّ مَحَرَّمٌ بِمِساسِ",71,"س",1,0],["فَاِخطُب وَقُل لِأَبيكَ يَشفَعُ إِنَّهُ","سَيَكونُ أَو سَيُعينُكَ المِقدارُ",72,"ر",1,0],["فاخضِبْ يمينكَ بالمُدامِ فطالَما","خَضَبَتْ أنامِلُها السِّنانَ الأزْرَقا",73,"ق",2,0],["فاخلَعْ عذارَك واشربْ قَهوةً مُزِجَتْ","بقَهوةِ الفَلَجِ المعسولِ والشَّنَبِ",74,"ب",1,0],["فَاِخطُ مَعَ الدَهرِ عَلى ما خَطى","وَاجرِ مَعَ الدَهرِ كَما يَجري",75,"ر",2,0],["فَاِخفِض جَناحَكَ لِلصَديقِ مُتابِعاً","لِهَوائِهِ أَو عِش بِغَيرِ صَديقِ",76,"ق",1,0],["فَأَخَذتُ الفِرزانَ حُكماً وَوَلّى","رَخُّهُ ناكِصاً عَلى العَقِبَينِ",77,"ن",1,0],["فَأَخَذتُ اليُمنى وَأَجفَلَتِ اليُس","رى شَروداً تَجولُ في الحَومَتَينِ",77,"ن",1,0],["فَأَخَّرَ صَرفَ الدَهرِ عَنّي فَلا يَرى","مُقابَلَتي لَمّا دَرى أَنَّهُ الخَصمُ",78,"م",1,0],["فَأَخَّرَني الحَياءُ وَليسَ يَدري","جَميعُ الناسِ ما سَبَبُ اِمتِناعي",79,"ي",1,0],["فَأَخرَجَكُم وَحَباكُم بِها","وَقَمَّصَكُم فَضلَ جِلبابِها",80,"ب",3,0],["فأخال عينَكَ هزَّها","شكوى الغريبِ المهمَلِ",81,"ل",1,0],["فَاِختَلَطَ السَوادُ بِالسَوادِ","أَظفَرَتِ الثَرى بِما يُغادي",82,"ي",1,0],["فَاخْلَعْ عِذَارَكَ وَاغْتَنِمْ زَمَنَ الصِّبَا","قَبْلَ الْمَشِيبِ فَكُلُّ شَيءٍ فَانِي",83,"ي",1,0],["فَاخْسَأْ فَمَا الْكَلْبُ أَدْنَى مِنْكَ مَنْزِلَةً","وَاخْسَأْ لِمِثْلِكَ إِعْزَازٌ وَإِكْرَامُ",84,"م",1,0],["فَآخِرُ عَهدٍ لي بِها حينَ أَعرَضَت","وَلاحَ لَها خَدُّ نَقِيٌّ وَمَحجَرُ",85,"ر",1,0],["فَاِختَر لِنَفسِكَ أَيَّ صَوبٍ تَنتحي","وَبِأَيِّ مُضطَرَبٍ تَسيرُ وَتَذهَبُ",86,"ب",1,0],["فَإِخال فاتَنتي تَمتع","بِينهن بِما تَروم",87,"م",1,0],["فَأَخلَقَ مِنها كُلَّ بالٍ وَعَيِّنٍ","وَجيفُ الرَوايا بِالمَلا المُتَباطِنِ",88,"ن",1,0],["فَأَخفَينَ الَّذي أَجمَعنَ لَمّا","أَرَدنَ لُقَيَّنا حَتّى خَفِينا",89,"ن",2,0],["فَاِختَلَفوا فَقالَ قَومٌ هَذا","وَقالَ قَومٌ آخَرونَ لا ذا",90,"ذ",2,0],["فاختفى عند كشفِها الرأْسَ جِبْري","لُ فما عادَ أو أُعيدَ الغِطاءُ",91,"ا",2,0],["فَأَخْلِقْ بأنْ يَبْقَى وَيَبْقَى لِمُلْكِهِ","ثَناءٌ حَكاهُ عَنْبَرٌ وعَبيرُ",92,"ر",1,0],["فَأَخمَدَ مَا بَيْنَ الخَلِيلِ بِرَأْيِهِ","ونابُلُسَ النارَ التي تَتَسَعَّرُ",93,"ر",1,0],["فأَخْرَجْتَ مَرْعاها وَأَجْرَيْتَ ماءَها","غَ