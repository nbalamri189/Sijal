3553",""],[4778,"لا يأس مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=196521",""],[463,"إذا عمّ صحراءَ الغميرِ جدوبها","https://www.poetsgate.com/ViewPoem.aspx?id=14624",""],[463,"أجدك بعد أن ضمَّ الكثيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17990",""],[4955,"إذا رمت عزاً تبتغيه فإنَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188766",""],[5213,"وقائلة هلا ترحلت طالبا","https://www.poetsgate.com/ViewPoem.aspx?id=170471",""],[5300,"ذكرت فراقا والتفرّق يصدع","https://www.poetsgate.com/ViewPoem.aspx?id=200452",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[351,"وسيّارة ضلَّتْ عن القصْدِ بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=4472",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5672,"الحياة...بعد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212476",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5850,"لمنْ طَلَلٌ عافٍ ورسمُ منازلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19708",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6259,"ألمتْ ودوني من تهامة بيدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59367&r=&rc=15",""]],"verses":[["إِذا ما حاجَةٌ قُضِيَت بِسَيفي","شَكَرتُ لَها يَدَ اللَيلِ البَهيمِ",0,"م",1,0],["إذا ما حَدَوْتُ الأرْحَبيَّ بِذِكْرِهمْ","عَرَفْتُ هَواهُم في حَنينِ الرّكائِبِ",1,"ب",1,0],["إِذَا مَا حَدَتْ رِيحُ الزَّفِيرِ سَحَابَهَا","ثِقَالاً سَقَى مِنْهَا المَعَاهِدَ عِهْدَانِ",2,"ن",1,0],["إِذا مَا حَدِيثٌ عَنْكَ جَاءَتْ بِه الصَّبَا","شَجَاهُ منَ الشَّوْقِ الْحَثِيثِ قَدِيمُهُ",3,"م",2,0],["إِذَا مَا حَدَتْ رِيحُ الزَّفِيرِ مَدَامِعَي","تَسِحُّ فَتُرْوَى مَنْ دُمُوعِي رِمَالُهُ",4,"ل",2,0],["إِذا ما حَمِدتُكَ بَينَ الرِجالِ","فَأَنتَ الخَليقُ بِأَن تُحمَدا",5,"د",2,0],["إِذا ما حَشَوناهُنَّ جَوزَ تَنوفَةٍ","سَباريتَ يَنزو بِالقُلوبِ اِهوِلالُها",6,"ل",3,0],["إِذا ما حَلَّ أَهلُكِ يا سُلَيمى","بِدارَةِ صُلصُلٍ شَحَطوا المَزارا",7,"ر",2,0],["إذا ما حروف العيس خطَّت بقفرةٍ","غدت موضع العنوانِ والعيس أسطر",8,"ر",1,0],["إذا ما حاملٌ جرَّتْ بحملٍ","أتمَّتْ شخصَه عند الولادِ",9,"د",1,0],["إذا ما حلف النَّغْلُ","ففي أيمانه رُخصَهْ",10,"ه",1,1],["إِذا ما حَيَّةٌ مِنكُم تَوارى","تَنَمَّرَ حَيَّةٌ مِنكُم ذَكيرُ",11,"ر",1,0],["إِذا ما حَدا الحادي المُجِدُّ تَدافَعَت","بِهِنَّ المَطايا وَاِستُحِثَّ النَجائِبُ",12,"ب",1,0],["إِذا ما حارَبَتكَ بُطونُ قَيسٍ","حَسِبتَ الناسَ حَرباً أَجمَعينا",13,"ن",2,0],["إِذا ما حُصِّلَت عُليا قُرَيشٍ","فَلا في العيرِ أَنتَ وَلا النَفيرِ",14,"ر",1,1],["إِذا ما حَريزُ القَومِ باتَ وَما لَهُ","مِنَ اللَهِ واقٍ فَهوَ بادي المَقاتِلِ",15,"ل",1,0],["إِذا ما حَجَرناهُ عَن صاحِبٍ","تَجَنّى وَحاوَلَ أَن نُسلِمَه",16,"م",2,0],["إِذا ما حَلَلنا حَلَّ مَن كانَ خَلفَنا","وَيَتبَعُنا إِن نَظعَنِ الثَقَلانِ",17,"ن",1,0],["إذا ماحداه البَرقُ يرتاحُ صَبوةً","إلى رائحٍ من ذي الأراكِ وَغَادي",18,"د",2,0],["إِذا ما حَساها الفَتى وُكِّلَت","بِحَلِّ الضَميرِ وَعَقدَ اللِسانِ",19,"ن",1,0],["إِذا ما حَسَوناها أَقَرّوا بِأَنَّهُم","قَدِ اِرتَكَبوا في تَركِها مَركَباً صَعبا",20,"ب",2,0],["إِذا ما حِبالُ الشَمسِ مِنها تَخَلَّصَت","إِلى رَوضِهِ أَلقَت شِراكاً مِنَ التِبرِ",21,"ر",1,0],["إِذا ما حَسَوناها وَسارَ سُرورُها","إِلى مُنتَهى الأَفكارِ مِن مَوضِعِ السِرِّ",21,"ر",1,0],["إِذا ما حُلومُ الناسِ حِلمَكَ وازَنَت","رَجَحتَ بِأَحلامِ الرِجالِ وَخَفَّتِ",22,"ت",1,0],["إِذا ما حَسَوناها أَقاموا مَكانَهُم","وَإِن مُزِجَت حَثّوا الرِكابَ وَيَمَّموا",23,"م",3,0],["إِذا ما حِبالُ الناسِ عادَت بَوالِياً","فَإِنَّ حِبالَ الشَمسِ غَيرُ بَوالِ",24,"ل",1,0],["إِذا ما حَذِرتِ الصَقرَ يَوماً فَحاذِري","أَخا الإِنسِ أَيّاماً وَإِن كانَ مُحرِما",25,"م",2,0],["إِذا ما حُرَّةٌ هُرِيَت وَسيفَت","فَمَن سافَ الإِماءَ وَمَن هَراها",26,"ا",3,0],["إِذَامَاحَلَلتُ الجَدبَ فَرداًبِلا أذاً","فَسَقياًله مِن رَوضَةٍ غَيْرِمِحلالي",27,"ل",2,0],["إذا ما حِبالٌ من خليلٍ تصرّمَتْ","عَلِقْتُ بخِلٍّ غَيْرِهِ بحِبال",28,"ل",1,0],["إِذا ما حَسَا أَلْقَمْتُهُ كُلَّ فِلْذَةٍ","لفَرْخةِ طَيْرٍ أَوْ لسَخْلةِ ضانِ",29,"ن",1,0],["إذا ما حَلبة الحسنات جاءت","رأيتك أنت صاحبة السُّكيت",30,"ت",1,0],["إِذا ما حَلبة جَمَعَت","وَطالَ البَحث وَالجَدَل",31,"ل",1,0],["إذا ما حباني اللهُ يوماً بنعمةٍ","وألبسني من عزِّهِ ما رضيتُما",32,"م",2,0],["إذا ما حبَاك اللهُ يوماً بثروة","وعزِّ وسلطانٍ وجاهٍ فكن عدلا",33,"ل",2,1],["إِذا ما حَلَّ ظَلَّلَها دُخاناً","وَإِن هُوَ سارَ طَبَّقَها قَتاما",34,"م",2,0],["إِذا ما حَبا وَفداً أَتاهُم بِمِثلِهِ","رُكوبَ المَوامي بِالمَطِيِّ المُخَزَّمِ",35,"م",1,0],["إِذا ما حكيتُ الصِدقَ وَهوَ فَضيلَةٌ","فَتَنعَتني بِنتُ الجَهالَةِ بِالكُفرِ",36,"ر",1,0],["إِذا ما حَدى الحادي بِنَجدٍ تَمايَلَت","كَأَنَّ سُلافَ السَلسَبيل سَقاها",37,"ا",3,0],["إِذا ما حَمَلنا حَملَةً مَثَّلوا لَنا","بِمُرهَفَةٍ تَذري السَواعِدَ مِن صُعدِ",38,"د",1,0],["إذا ما حَدا الحادي بها قال قائِلٌ","أَلا فاِشكراها نَغمةً وَسَماعَها",39,"ع",3,0],["إِذا ما حَصيرا زَورِها لَم يُعَلِّقا","لَها الضَفرَ إِلّا مِن أَمامِ رَحاهُما",40,"م",2,0],["إِذا ما حَرابِيُّ الظَهيرَةِ لَم تَقِل","نَسَأتُ بِها صَعراءَ طالَ اِمتِعاظُها",41,"ه",2,0],["إِذا ما حَسوناها أَضاءوا بِظُلمَةٍ","وَإِن قُرِعَت بِالمَزجِ ساروا وَعَمَّموا",42,"م",3,0],["إذا ما حانَ من فِرَقٍ ذَهابٌ","أُتيحَ إليه من فِرَقٍ مَجِيّ",43,"ي",1,0],["إذا ما حططت الرحل في عرصاتها","وأقراك رب البيت عفواً وغفرانا",44,"ن",2,0],["إِذا ما حَوى أَعلى المَراتِبِ ناشِئاً","فَماذا الَّذي يَبقى لحينِ اكتِهالِهِ",45,"ل",2,0],["إِذا ما حَلَلتَ الأَرض وَلَّت نُحوسها","وَأَقبَلَ مِن كُلِّ الجِهاتِ سُعودُها",46,"د",3,0],["إذا ما حمِدْنا في الرجال ابن أحمد","فعن خالص في الودِّ بالسر والجهر",47,"ر",1,0],["إذا ما حقق الحر اعتزاماً","فلا يخشى أذى بر وحبا",48,"ب",2,0],["إذا ما حزتها انتفضت عِطاراً","سوالفُها بعدلك والتريبُ",49,"ب",1,0],["إذا ما حَمَى مؤيَّدُ المُلْكِ حَوزةً","من الصُّمِّ لم يقدِرْ عليها طَلوبُها",50,"ب",3,0],["إذا ما حَموا أرواحهم بدروعِهم","أبحْنا حِماها بالرماح الشَّوارعِ",51,"ع",1,0],["إذا ما حلَّ أرضاً ذاتَ مَحْلٍ","أعادَ المَحْل أخصَبَ من ربيعِ",52,"ع",1,0],["اذا ما حلَّ أرضاً ذاتَ جَدْبٍ","فأسوءُ قيْظها نضِرٌ مَطيرُ",53,"ر",1,0],["اذا ما حَدابير السنين تتَابعتْ","تُعطِّلُ نيرانَ القِرى والطَّواهيا",54,"ي",2,0],["إذا ما حْتَبى يوم السَّلامِ وأذْعَنَتْ","لِهَيْبَتِهِ طوْعاً طُلىً ورِقابُ",55,"ب",1,0],["إذا ما حبا قصاده وهو محتبٍ","تيقنت أن السيل ينشأ من أحد",56,"د",1,0],["إذا ما حبا رب الندي بكأسه","ورياه فانظر ما يجل عن الشرح",57,"ح",1,0],["إذا ما حكاكِ البرق عند ابتسامهٍ","بكيتُ بكاءَ الثاكلات من الوجد",58,"د",1,0],["إِذا ما حَواشي العُمرِ كانَت نَقِيَّةً","مِنَ الخَوفِ كانَ العَيشُ في غايَةِ الحُسنِ",59,"ن",1,0],["إذا ما حللت بمغناهم","رأيت نعيماً وملكاً كبيرا",60,"ر",2,0],["إذا ما حَرّكَتْ قَوْمٌ رُؤوساً","فَعَدِّ عَنِ التَّثَبُّطِ والتَّواني",61,"ن",2,0],["إذا ما حذرتَ الأمر فَاِجعَل إزاءَه","رجوعاً إلى ربٍّ يقيك المحاذرا",62,"ر",2,1],["إذا ما حلها تهتز","من صير إلى صورِ",63,"ر",1,0],["إذَا مَا حُبِي مِنْكَ المُرَجِّي بِنَاصر","فَبُشْرَى المُرَجِّي أنَّه لَيْسَ يُخْذَلُ",64,"ل",1,0],["إِذا ما حوتهنّ الخبايا كأنّما","خلالَ الخبايا غزلة وجآذرُ",65,"ر",1,0],["إِذا ما حال رَوضُ رباب دوني","وَتَثليثٌ فَشَأنُكَ بِالبَكاري",66,"ر",2,0],["إذا ما حَجَّ بيتَ نَداهُ وَفْدٌ","رَمَى في قلبِ حاسِدِهِ جِمارَهْ",67,"ر",2,0],["إذا ما حامت العقبان يوما","تسترث الجوارح بالغياض",68,"ض",1,1],["إِذَا مَا حَدَا الرُّكْبَانُ فِي السَّيْرِ بِاسْمِهِ","طَوَتْ عِيسُهُمْ مَا لِلفَلاَةِ مِنَ العَرْضِ",69,"ض",1,0],["إِذا ما حِياضُ المَجدِ قَلَّت مِياهُها","فَحَوضُ أَبي العَبّاسِ في الجودِ مُترَعُ",70,"ع",1,0],["إِذا ما حَلَّ حَرباً هاجَ نَقعاً","كَذاكَ النارِ تُعرَفُ بِالدُخانِ",71,"ن",1,0],["إذا ما حططت الرحل بابن صمادح","فإن السرى بسل عليك حرام",72,"م",1,0],["اذا ما حملنا حملة ثبتوا لنا","بمرهفة تذري السواعد من صعد",73,"د",1,0],["إذا ما حدا الحادي فحفَّت ركائبي","املت لهُ سمعي فآب يلومُ",74,"م",1,0],["إذا ما حططنا الرحل بين رحابها","وداخلنا ذهل الملاقاة والحير",75,"ر",1,0],["إِذا ما حَلَّ شَخصُكَ في مَكامٍ","تَهَلَّلَ مِن تَهَلُّلكَ المَكانُ",76,"ن",1,0],["إذا ما حلّ أرض علاي خطبٌ","كشفت الخطب عنها بالخطابه",77,"ه",1,1],["إذا ما حلَّ يوماً في مكانٍ","بهِ حلَّ السرورُ مع الجمالِ",78,"ل",1,0],["إِذا ما حَبَت مِن آخِرِ اللَيلِ حَبوَةً","ضَرَبتُ بِمَلوِيٍّ مِن اخرَى ذِراعَها",79,"ع",3,0],["إذا ما حددنا وانتضينا قواطعا","أصم الذكي السمع منها صريرها",80,"ر",3,1],["إذا ما حدتْ بالركب في كل نَفْنَفٍ","رأيتُ نَعاماً بالفَلا متجفِّلا",81,"ل",2,0],["إذا ما حساها لم تزده سماحة","ولكن أرته أن يصر ويحصرا",82,"ر",2,0],["إِذا ما حانَ يَومُ الرَوعِ مِنّا","تَرانا نَستَهينُ بِكُلِّ فاني",83,"ن",2,0],["إذا ما حل جان في حماه","يصير كداخل البيت الحرام",84,"م",1,0],["إذا ما حرمنا اليوم أنوار شمسه","فإنّا جميعاً نستفيئ له ظلاّ",85,"ل",2,0],["إِذا ما حثا مِن ماله أَوسَع الحشى","فَصارَ الغثا مِن كَفه ماؤه يَجري",86,"ر",2,0],["إِذا ما حل كَفك كُنت مَولى","تُصافحه يَد فيها جذام",87,"م",1,0],["إذا ما حرمنا الرزق والعرض وافر","فلسنا نبالي العيش بين جهنم",88,"م",1,0],["إذا ما حلا عيش اتى الدهر دونه","فاصبح حلو العيش وهو مرير",89,"ر",1,0],["إذا ما حدين بمدح الأمير","سبقن لحاظ المحثّ العجل",90,"ل",1,0],["إِذَا مَا حضرنا فِي غذاءٍ وقهوة","نقوم ونحن يَا أخا القوم جُوَّعُ",91,"ع",1,0],["إذا ما حُمِّل ابنُ أبيه حملاً","وعصلجَ في الطريق به وضاقا",92,"ق",2,1],["إذا ما حَللْنا تحتْ ظلّ جَنابِه","فما ضرّ أن ينْأى حَبيبٌ ومنزِلُ",93,"ل",1,0],["اذا ما حل مغناها ينادي","مشمرة عواقد للنطاق",94,"ق",1,0],["إذا ما حكت بالعود رجع لسانها","رأيت لسان العود من كفها يملي",95,"ل",2,0],["إِذا ما حَشرةٌ أَزَّت","عَرَتني هِزَّةٌ رُغما",96,"م",2,0],["إذا ما حَشاها القومُ طعناً رماحَهمُ","رست بجنانٍ ثابت غير مائلِ",97,"ل",1,0],["إِذا ما حِمامُ المَرءِ كانَ بِبلدة","دَعَتهُ إِلَيها حاجَةٌ أَو تطَرُّبُ",98,"ب",1,1],["إذا ما حدا حادى الرفاق مزمزماً","تضرّم نار الشوق بين ضلوعها",99,"ع",3,0],["إذا ما حدا حادي الرفاق مزمزماً","ذكرت الذي قد بان من عهد موعدي",100,"د",2,0],["إذا ما حل أرضا وهي مرت","تراها أنبتت عزا ومجدا",101,"د",2,0],["إذا ما حلَّ بيْ همٌّ جديدٌ","وأسلاني عن ِ الهمِّ القديم ِ",102,"م",1,0],["إذا مَا حلَّ يوماً في بلادٍ","بهِ سُلَّتْ على الناسِ السيوف",103,"ف",1,0],["إذا ما حل بي ظَمَأ وردت","إلى حوض يطب به المقيلُ",104,"ل",1,0],["إذا ما حمى مؤيدُ الملكِ حوزة ً","من الصمَّ يقدرْ عليها طلوبها",105,"ب",3,0],["إذا ما حزتها انتفضت عطارا","والفها بعدلك والتريبُ",106,"ب",1,0],["إذا ما حباكَ اللهُ يا عبدُ بالرضا","فما بَعدُ ترجو بَعدَ نيلِ رضاهُ",107,"ا",2,0],["اذا ما حباني جوده ونواله","فلست ابالي بعدما يفعل الدهر",108,"ر",1,0],["اذا ما حياض الجود قلت مياهها","فحوض أبى العباس بالجود مترع",109,"ع",1,0],["إذا ما حدى الحادي أطار قلوبها","كمثل القطا الكدري من صوته ذعرا",110,"ر",2,0],["إذا ما حَسَوناها أضاؤوا بظلمةٍ","وإن قُرِعَتْ بالمزجِ ساروا وعُمِّمُوا",111,"م",3,0],["إِذا ما حاوَلَتْ عَيْنايَ مِنْها","طُلُوعاً حاوَلَتْ عَنِّي غُرُوبا",112,"ب",2,0],["إذا ما حلّ في بلدٍ تراها","وقد خرجت له رَجِلاً وركبا",113,"ب",2,0],["إذا ما حباكَ الله فضلاً ورحمةً","فقدْ بُتَّ منْ ربِّ العبادِ مقرَّبا",114,"ب",2,0],["إذا ما حل في دار","رأيت الدار إيوانا",115,"ن",2,0],["إذا ما حرابيُّ الظهيرة ِ لم تَقِلْ","نسأْتُ بها صَعْراءَ طالَ امْتعاضُها",116,"ض",3,0],["إِذا ما حداهم خَوف ما يَنظر العَما","مثل شارب الصَهبا غَشاهم جُنونها",117,"ن",3,0],["إذا ما حللتَ الأرض غابت نحوسها","وأقبل من كلّ الجهات سعودها",118,"د",3,0]]}