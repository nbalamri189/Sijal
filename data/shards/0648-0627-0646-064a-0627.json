3.html","الوافر"],[571,"سميت مسكينا وكانت لجاجة","https://www.aldiwan.net/poem52040.html","الطويل"],[577,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[577,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[577,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[611,"","https://poetry.dctabudhabi.ae/diwan/poem/18846","الطويل"],[765,"","https://poetry.dctabudhabi.ae/diwan/poem/31484","الطويل"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/26694","الطويل"],[819,"","https://poetry.dctabudhabi.ae/diwan/poem/20908","الطويل"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10453","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28076","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28077","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18050","الطويل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[962,"","https://poetry.dctabudhabi.ae/diwan/poem/96101","الطويل"],[1020,"","https://poetry.dctabudhabi.ae/diwan/poem/2","الطويل"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/98031","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21394","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2537","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2567","المتقارب"]],"verses":[["وإني أقمت الفكر دهراً فلم أجد","كمالاً بلا نقص ولته الزوائد",0,"د",1,0],["وَإِنّي إِذا أَبدى العَدُوُّ سَفاهَةً","حَبَستُ عَنِ العَوراءِ فَضلَ لِسانِيا",1,"ي",2,0],["وَإِنِّيَ إِن أَلقى صَديقاً مُوافِقاً","وَذَلِكَ شَيءٌ عازِبٌ عَن رَجائِيا",1,"ي",2,0],["وَإِنّي إِن صَبَرتُ ثَنَيتُ قَلبي","عَلى طَرفٍ مِنَ البَلوى أَليمِ",2,"م",1,0],["وَإِنّي إِذا ما قُلتُ في غَيرِ ماجِدٍ","مَديحاً كَأَنّي لائِكٌ طَعمَ عَلقَمِ",3,"م",1,0],["وَإِنّي أُرَوِّعُهُ بِالوَدا","عِ حَتّى يُخادِعَني بِالسَلامِ",4,"م",1,0],["وَإِنّي إِن دَعَوتُكَ لِلمَعالي","لَأَعلَمُ أَيَّ بارِقَةٍ أَشيمُ",5,"م",1,0],["وَإِنّي أَعوذُ بِكُم أَن يَعودَ","حُبابي قِلىً وَثَنائي مَلاما",6,"م",2,0],["وَإِنّي إِذا اِصطَكَّت رِقابُ مَطيُّكُم","وَثَوَّرَ حادٍ بِالرِفاقِ عَجولُ",7,"ل",1,0],["وَإِنّي أَراني لا أَلينُ لِحادِثٍ","لَهُ أَبَداً وَطءٌ عَلَيَّ ثَقيلُ",8,"ل",1,0],["وَإِنّي إِن لَحِقتُ أَبي جَلالاً","فَهَذي النارُ مِن ذاكَ الذُبالِ",9,"ل",1,0],["وَأَنّى اِهتَدى في مُدلَهِمِّ ظَلامِهِ","يَخوضُ بِحاراً أَو يَجوبُ رِمالا",10,"ل",2,0],["وَإِنِّيَ إِن أُعطِ المَدى مُتَنَفَّساً","نَزَعتُ أَذاها وَالزَمانُ يُديلُ",11,"ل",1,0],["وَإِنِّيَ آبى أَن أَذُلَّ وَفي يَدي","عِناني وَلَم يُقطَع عَلَيَّ سَبيلي",12,"ل",2,0],["وَإِنّي إِذا ما اِستَطالَ الزَمانُ","أَنجَدَني صاحِبٌ أَروَعُ",13,"ع",1,0],["وَإِنّي أَرى زَنداً تَواتَرَ قَدحُهُ","وَيوشِكُ يَوماً أَن تَشُبَّ لَنا النارُ",14,"ر",1,0],["وَإِنّي أَخِفُّ إِلى المُسمِعا","تِ عَن خَطرَةِ الشَغَفِ الخاطِرِ",15,"ر",1,0],["وَإِنّي إِذا لَم أَجِد ناصِراً","وَجَدتُكَ أَنصَرَ لي مِن يَدي",16,"د",2,0],["وَإِنِّيَ إِن أَنضَح جَوايَ بِعَبرَةٍ","يَكُن كَخَبِيِّ النارِ يُقدَحُ بِالزَندِ",17,"د",1,0],["وَإِنّي إِذا قالوا مَضى لِسَبيلِهِ","وَهيلَ عَليهِ التُربُ مِن جانِبِ اللَحدِ",17,"د",1,0],["وَإِنّي إِذا ما بَلَّغَ اللَهُ مُنيَتي","ضَمِنتُ لَهُ هَجرَ القَريضِ وَحوبِهِ",18,"ب",2,0],["وَأَنّي أُعاني في الصَّبابَةِ لَومَهُ","وَما هُوَ عِندي بِالرَّفيقِ المُماذِقِ",19,"ق",1,0],["وَإنّي إذا أَنْكرَتْني البِلادُ","وَشِيبَ رِضَى أَهْلِها بِالغَضَبْ",20,"ب",1,0],["وإني إذا ما انْسابَ في الأعْيُنِ الكَرى","يَخُبُّ ببَزّي أعْوَجيٌّ مُضَمَّرُ",21,"ر",1,0],["وأنّى اهْتَدَتْ والليلُ داجٍ ودونَها","حُزونُ البِطاحِ منْ مِنىً وسُهوبُها",22,"ب",3,0],["وإنّي إذا ما لَجْلَجَ القوْلَ فاخِرٌ","يؤنِّبُ في أقوالِهِ ويُعَنِّفُ",23,"ف",1,0],["وَإِنّي أَعشَقُ السُمرَ العَوالي","وَغَيري يَعشَقُ البيضَ الرِشاقا",24,"ق",2,0],["وَأَنّي أَرى أَهلي جَميعاً وَأَهلَها","يَسُرُّهُمُ لَو بانَ مِن حَبلِها حَبلي",25,"ل",2,0],["وَأَنّي إِذا لَم أَلزَمِ الصَبرَ طائِعاً","فَلابُدَّ مِنهُ مُكرَهاً غَيرَ طائِعِ",26,"ع",1,0],["وَإِنّي أَرى مِن أَهلِ بَيتِكِ نُسوَةً","شَبَبنَ لَنا في الصَدرِ ناراً تَلَهَّبُ",27,"ب",1,0],["وَإِنّي اِبتَلاني اللَهُ مِنكُم بِخادِمةٍ","تُبَلِّغُكُم عَنّي الحَديثَ وَتَكذِبُ",27,"ب",1,0],["وَإِنِّيَ أَشتاقُ إِلى ريحِ جَيبِها","كَما اِشتاقَ إِدريسُ إِلى جَنَّةِ الخُلدِ",28,"د",1,0],["وَإِنّي إِذا شَقَّت عَليَّ قَرينَتي","ذَهَلتُ وَلَم أَحنِن إِذا هيَ حَنَّتِ",29,"ت",1,0],["وَإِنّي امرؤٌ عِندي وَعمداً أَقولُهُ","لآتي الَّذي يَأتي امرؤٌ وَهوَ خابِرُ",30,"ر",1,0],["وَإِنّي اِمرُؤٌ قَد باتَ هَمّي قَريبَتي","تَأَوَّبَني عِندَ الفِراشِ تَأَوُّبا",31,"ب",2,0],["وَإِنّي إِذا ما قُلتُ قَولاً فَعَلتُهُ","وَلَستُ بِمِخلافٍ لِقَولي مُبَدَّلِ",32,"ل",1,0],["وَإِنّي الَّذي لَولا صَنائِعُ جَدِّهِ","لَما رُفِعَت يَوماً لِمُلكٍ مَضارِبُه",33,"ب",2,0],["وَإِن يَأبَ إِلّا قَبضَ مَبسوطِ فَضلِهِ","فَفي يَدِ مَولىً فَوقَهُ القَبضُ وَالبَسطُ",34,"ط",1,0],["وَإِنّي أَراحُ إِذا ما الجَنو","بُ راحَت بِرِيّا جَنوبِ العَلَم",35,"م",1,0],["وَأَنّي إِن زُرتُ لَم تَحتَجِب","وَإِن طالَ بي مَجلِسٌ لَم تَمَلّ",36,"ل",1,0],["وَإِني اِمرؤٌ قَد كُنتُ أَحسَنتُ مَرَّةً","وَلِلمَرءِ آلاءٌ عَلَيَّ اِستَطالَها",37,"ل",3,0],["وَإِنِّي أَهْوَاكِ مِلْءَ عُيُو","نِي وَمِلْءَ حُشَاشَتِيَ الصَّابِرهْ",38,"ر",2,0],["وَأني إِذَا مَا رُمْتُ رِيّاً لِظَمْأَتِي","إِلَى مُلْتَقَاهُ عَزَّ مَا أَنَا رَائِمُ",39,"م",1,0],["وَأَنّى اِهتَدَت مَيٌّ لِصُهبٍ بِقَفرَةٍ","وَشُعثٍ بِأَجوازِ الفَلاةُ نِيامِ",40,"م",1,0],["وإنّي إذا ما الدهر جرّ جريرةً","لتأنف نفسي أن أكلّمه عتبا",41,"ب",2,0],["وإني أخو عزم إذا ما انتضيته","نبا كل عضب عنه أو أنكر الضربا",41,"ب",2,0],["وإني أعاف الماء في صفو القذى","وإن كان في أحواضه بادراً عذبا",41,"ب",2,0],["وإِنّي إذا استنبطته من قريحتي","شفيت صدى الراوي ببرد معينه",42,"ن",2,0],["وإني أظنّ الفيل صاحب قوّة","تكون له لو شاء من ذاك مّوْثلا",43,"ل",2,0],["وإني أرى العُربيَّ للعرب ينتمي","قريباً من العِبريّ يُنمى إلى العِبر",44,"ر",1,0],["وإني إذا أبصرتها مستضامةً","يكاد لها قلبي من الحزن يَنشقّ",45,"ق",1,0],["وإني إذا قبَّلت رأساً ولم أجد","به فضل عقل كان أجدر بالصفع",46,"ع",1,0],["وأني أرى في القوم بعض مخايلٍ","وأحذر من أن يَنقشعْن بلا هَمْع",46,"ع",1,0],["وَإِنّي أَخو الحَربِ الَّتي يُصطَلى بِها","إِذا حَمَلَتهُ فَوقَ حالٍ تَشَنَّعا",47,"ع",2,0],["وَأَنّى اِهتَدى لِلرَكبِ في مُدلَهِمَّةٍ","تُواعِسُ بِالرُكبانِ فيها الرَواحِلُ",48,"ل",1,0],["وَإِنّي إِذا ما المَوتُ لَم يَكُ دونَهُ","قَدى الشِبرِ أَحمي الأَنفَ أَن أَتَأَخَّرا",49,"ر",2,0],["وَإِنِّيَ أَرمي بِالعَداوَةِ أَهلَه","وَإِنِّيَ بِالأَعداءِ لا أَتَنَكَّفُ",50,"ف",1,0],["وَإِنّي أَذينٌ أَن يَقولوا مُزايِلٌ","بِأَيٍّ يَقولُ القَومُ أَصحابُ حاتِمِ",51,"م",1,0],["وإن يأود المر يلقْوا له","ثِقافاً وإن يحكُمُوا يعدلوا",52,"ل",3,0],["وَأَنّي إِذ نَزَلتُ عَلى دُلوكٍ","تَرَكتُكَ غَيرَ مُتَّصِلِ النِظامِ",53,"م",1,0],["وَإِنّي إِذا لَم أَرجُ يَقظانَ وَصلَها","لَيُقنِعُني مِنها الخَيالُ المُزاوِرُ",54,"ر",1,0],["وَإِنّي إِذا ما الهَمُّ ضافَ قَرَيتُهُ","زَماعاً وَمِرقالَ العَشِيّاتِ عَيهَلا",55,"ل",2,0],["وَإِنّي إِذا ما قُلتُ قَولاً فَعَلتُهُ","وَأُعرِضُ عَمّا لَيسَ قَلبي بِفاعِلِ",56,"ل",1,0],["وإني إلى حسن التجلد ساكنٌ","فما بال عذَّالي يزيد انْزعاجها",57,"ج",3,0],["وإني إذا أجهدتُ مدحي فإنَّما","قصاراي منها أن أقول فأخجلا",58,"ل",2,0],["وإني الذي لم يُبقِ في الجُهدِ غايةً","لتجبره لوجدتَ للكسر بالجبر",59,"ر",1,0],["وإني امرؤ ليست تضيع صنيعَةٌ","لديَّ لجذمي بالثناء وبالنشر",60,"ر",1,0],["وإني إذا ما ضقت ذرعاً ببلدة","لجواب أقطار البلاد ذروعها",61,"ع",3,0],["وإني إذا لم يجُد صاحبي","بجدواه قابلته بالعفافِ",62,"ف",1,0],["وإنّي أُريبُك يا مَنْ به","دِفاعي الرُّيُوبَ التي قد تظلُّ",63,"ل",1,0],["وأني إذا ما أُعزَّ امرؤٌ","فلي مُستضيمٌ ولي مُستَذلُّ",63,"ل",1,0],["وأني أرى حسنَ الأمورِ وقبحَها","بألوى من الآراء مستحكم الجدْلِ",64,"ل",1,0],["وإني أرى المسكينَ لا شكّ ضائعاً","متى هو لم يوصَلْ بحبلك حبلُهُ",65,"ل",2,0],["وأنَّى أعاني فيه شعراً أقوله","وهاجيهِ لا يبغي إليه المرَاقيا",66,"ي",2,0],["وَإِنّي إِذا اِرتابَ الوُشاةُ لِأَدمُعي","لَذو حُجَجٍ لَم يُبدِها عاشِقٌ قَبلي",67,"ل",2,1],["وَإنَي إذا خامَ الجَبانُ عَنِ الرَدى","فَلي حَيثُ يَخشى أَن يُجاوِزَ مِخشَفُ",68,"ف",1,0],["وَإِنّي إِذ أَسُبُّ بِها كُلَيباً","فَتَحتُ عَلَيهِمُ لِلخَسفِ بابا",69,"ب",2,0],["وَإِنِّيَ أَن يَعلى بِكِ اللَومُ أَو تُرَي","بِدارِ أَذىً مِن شامِتٍ لَجُزوعُ",70,"ع",1,0],["وان يأب من بعد الدعاء قضاءها","نكن نحن اربابا لحاجاتنا نقضى",71,"ض",2,0],["واني اذا جاد الزمان بفرحة","علي وكان اليوم يلمع فتانا",72,"ن",2,1],["واني ان اهلك فلست بخاسر","لشيء كثير من عقار واموال",73,"ل",1,0],["وإني أوتيت البلاغة ساعة","فاديت حق القول نظما ومنثورا",74,"ر",2,0],["وإني أرى بيني وبين جماعة","من الناس في العصر الذي ضمّنا بونا",75,"ن",2,1],["وإني ارى أن اختراق ستارها","يهون لدى ذي حكمة سبر الكونا",75,"ن",2,0],["وإني أجازى المرء من جنس فعله","فأعطيه بالوزن الذي كالنى وزنا",75,"ن",2,0],["وأني الفتى يمسى على الموت صابراً","وأما على ذل فليس له صبر",76,"ر",1,0],["وَأَنّي إِذا باشَرتُ أَمراً أُريدُهُ","تَدانَت أَقاصيهِ وَهانَ أَشَدُّهُ",77,"د",2,0],["وَأَنّى اِهتَدى هَذا الرَسولُ بِأَرضِهِ","وَما سَكَنَت مُذ سِرتَ فيها القَساطِلُ",78,"ل",1,0],["وإِنّي إِذا ما العودُ يسلبُ ظِلُّهُ","أنفِّضُ أقطاعَ المَطيِّ الرواسمِ",79,"م",1,0],["وأني أرامي الدهرَ عنكمْ مدافعاً","وترمونني بالباتراتِ الكَوالمِ",80,"م",1,0],["وَأَنّي اليَومَ عَن وَطَني شَريدٌ","بِلا جُرمٍ وَمِن مالي حَريبُ",81,"ب",1,0],["وَإِنّي أَرى مِن أَهلِ بَيتِكِ نِسوَةً","شَبَبنَ لَنا في الناسِ ناراً تَلَهَّبُ",82,"ب",1,0],["وَإِنّي اِبتَلاني اللَهُ مِنكُم بِخادِمٍ","تُبَلِّغُني عَنكِ الحَديثَ وَتَكذِبُ",82,"ب",1,0],["وَإِنّي أَرتَجيكَ وَأَرتَجيهِ","لَدَيكَ لِنائِلٍ بِهِ مُستَفادِ",83,"د",1,0],["وَإِن يَأتِنا نَصرٌ مِنَ التُركِ سالِماً","فَما بَعدَ نَصرٍ غائِبٌ أَنا ناظِرُه",84,"ر",2,0],["وَإِنّي الَّذي لا يَبحَثُ السِرَّ وَحدَهُ","إِذا كانَ غَيري مَن يَدُبُّ إِلى الخَمَر",85,"ر",1,0],["وَأَنّي الَّذي كانَت تَعُدُّ لِثَغرِها","تَميمٌ لِأَبياتِ العَدُوِّ المَقاذِفِ",86,"ف",1,0],["وَأَنّى اِهتَدَت وَالدَوُّ بَيني وَبَينَها","وَزَوراءُ في العَينَينِ جَمٌّ فُتوقُها",87,"ق",3,0],["وَإِنّي أَنا النَجمُ الَّذي عُذِّبَت بِهِ","قُرى أُمَّةٍ بادَت وَبادَ نَخيلُها",88,"ل",3,0],["وَأَنّى أَتَتنا وَالرِكابُ مُناخَةٌ","بِخَوعى وَأَمسى بِاللِياحِ اِختِلالُها",89,"ل",3,1],["وَأَنّي الَّذي لا بَدَّ أَن سَيُصيبُهُ","حِمامُ المَنايا مِن وَفاةٍ وَمِن قَتلِ",90,"ل",1,0],["وَإِنّي أَرى أَن لا أُنافِسَ ظالِماً","وَأُرضي بِكُلِّ الحَقِّ مَن لَيسَ يُرضيني",91,"ن",2,0],["وَإِنّي إِن وَصَفتُ لَهُ وَلائي","كَأَنّي طالِبٌ تَحصيلَ حاصِل",92,"ل",1,0],["وَإِنّي إِن حَلَفتُ لَهُ يَميناً","فَما غَيرُ الفِعالِ لَها شِمالُ",93,"ل",1,0],["وإني إذا عيناكِ بالدمعِ غامَتَا","جديرٌ بأن يمشي على هدبِهَا فمي",94,"م",2,0],["وإنّي امْرؤ في خَجْلَةٍ مُسْتَمِرّةٍ","يذوبُ لها في الماءِ جامدةُ الصّخْرِ",95,"ر",1,0],["وَإِنّي إِذا أَلقى بِرَبعِيَ رَحلَهُ","لِأُذعِرُهُ في سِربِهِ وَهوَ راتِعُ",96,"ع",1,0],["وَإِنّي إِذا ما الحِلمُ أَحوَجَ لاحِياً","إِلى سَفَهٍ أَفضَلتُ فَضلاً عَلى حِلمي",97,"م",2,0],["وَإِنِّي امْرُؤٌ لَوْلا الْهَوَى مَا وَجَدْتَنِي","أَدِينُ لِغَيْرِ اللَّهِ أَوْ أَرْهَبُ الْعَدْوَى",98,"و",2,0],["وَإِنِّي إِذَا مَا الْخَطْبُ أَمْقَرَ طَعْمُهُ","نَبَذْتُ بِهِ رَأْيَاً أَلَذَّ مِنَ السَّلْوَى",98,"و",2,0],["وَأَنّي إِذا يَمَّمتُ قَبرَكَ زائِراً","وَقَفتُ وَدوني لِلتُرابِ حِجابُ",99,"ب",1,0],["وَإِنّي إِذا ما اللَيلُ جاءَ بِفَحمَةٍ","لَأوري زِنادَ الهَمِّ فيها فَأَقدَحُ",100,"ح",1,0],["وَإِنّي إِذا ما شاقَني لِحَمامَةٍ","رَنينٌ وَهَزَّتني لِبارِقَةٍ ذِكرى",101,"ر",2,0],["وَإِنّي إِذا صَلَّيتُ وَجَّهتُ نَحوَها","بِوَجهي وَإِن كانَ المُصَلّى وَرائِيا",102,"ي",2,0],["وَأَنّي إِذا حَنَّت إِلى الإِلفِ إِلفُها","هَفا بِفُؤادي حَيثُ حَنَّت سُحورُها",103,"ر",3,0],["وإنّي استقمتُ على واضحٍ","من الأمرِ يا ابنَ أبي فَاسْتَقِمْ",104,"م",1,0],["واني أَدينُ لَكُم أَنَّهُ","سَيُنجِزُكُم رَبُّكم ما زَعَم",105,"م",1,0],["وَإِنّي إِذا رَدّت عَلَيَّ تَحِيَّةً","أَقولُ لَها اِخضَرَّت عَلَيكِ وَطُلَّتِ",106,"ت",1,0],["وَأَنّى اِهتَدَت وَالدَوُّ بَيني وَبَينَها","وَما كانَ ساري الدَوِّ بِاللَيلِ يَهتَدي",107,"د",2,0],["وإنّي إذا يَسْري إليَّ لَخائِفٌ","عليه حِبالاتِ العيونِ الحوائل",108,"ل",1,0],["وَأَنّي أَحفَظُ العَهدَ","وَأَرعاكَ وَتَنساني",109,"ن",2,0],["وَإِنّي إِذا ما عَوى نابِحٌ","وَجاشَ لَهُ بَحرِيَ المُزبِدُ",110,"د",1,0],["وَإِن يَأتِكَ المُستَشرِعونَ فَرُبَّما","أَتَوكَ فَرَوَّيتَ القَديمَ المُصَرَّدا",111,"د",2,0],["وَإِنّي أُقاسي مِن جِهادِكِ خالِياً","عَياءً فَأَنّى لي بِأَجرِ المُجاهِدِ",112,"د",1,0],["وَإِنّي أَرى ذُرَيَّةَ الشَيخِ آدَمٍ","قَديماً عَلَيهِم بِالرَدى أُخِذَ الإِصرُ",113,"ر",1,0],["وَإِنّي أَرى أَنصارَ إِبليسَ جَمَّةً","وَلا مِثلَ ما أَوفى لَهُ الزَرَجونُ",114,"ن",1,0],["وَأَنّى اِهتَدَت سَلمى وَسائِلَ بَينَنا","بَشاشَةُ حُبٍّ باشَرَ القَلبَ داخِلُه",115,"ل",2,0],["وَإِنّي اِمرُؤٌ أَعدَدتُ لِلحَربِ بَعدَما","رَأَيتُ لَها ناباً مِنَ الشَرِّ أَعصَلا",116,"ل",2,0],["وإني أرد الكبش والكبش جامح","وأرجع رمحي وهو ريان ناهل",117,"ل",1,0],["وإني إذا رضيتني الكرا","م خدناً فلست أُبالي اللئاما",118,"م",2,0],["وإني إن ذهبت أُريد مصراً","فَلَيسَ يضر بغداد الذهاب",119,"ب",1,0],["وإني امرؤٌ يبني أساس دفاعه","على السلم إن السلم خير من الحرب",120,"ب",1,0],["وإني إذا ناديت بيروت صارخاً","يجاوبني من جانب الجبل الصدى",121,"د",2,0],["وإني إذا أَهدى لي الليل طيفها","جعلت ظلام الليل للعين إثمدا",121,"د",2,0],["وإني امرؤ بغداد أَول بقعة","رضعت بها الآداب أصفى من الندى",121,"د",2,0],["وإني أَخذت الشعر باليد من علٍ","كَما طائر من حالق يتقضض",122,"ض",1,0],["وأني إذا ما قلت قولاً يفيد في","مصالحها ألفيت من هو يسمع",123,"ع",1,0],["وإِنِّي إِذَا مَلَّتْ رِكَابي مُنَاخَهَا","رَكِبْتُ ولَمْ تَعْجَزْ عَلَيَّ المَنَادِحُ",124,"ح",1,0],["وإَنَّي إِذَا ضَنَّ الرَّفُودُ بِرِفْدِهِ","لَمُخْتَبِطٌ مِنْ تَالِدِ المَالِ جِازِحُ",124,"ح",1,0],["وإنّي إذا ما زُرتُها قلتُ يا اسْلَمي","وما كانَ قَولي اسْلمي ما يَضيرُها",125,"ر",3,0],["وَإِنّي إِذا ما أَعوَزَ الدَمعُ أَهلَهُ","فَزِعتُ إِلى دَلحاءَ دائِمَةِ القَطرِ",126,"ر",1,0],["وَإِنّي اليَومَ أَحمي عِرضَ قَومي","وَأَنصُرُ آلَ عَبسَ عَلى العُداةِ",127,"ه",1,0],["وَإِنِّي امْرُؤٌ تَأْبَى لِيَ الضَّيْمَ صَوْلَةٌ","مَوَاقِعُهَا فِي كُلِّ مُعْتَرَكٍ حُمْرُ",128,"ر",1,0],["وَإِنِّي امْرُؤٌ لا أَسْتَكِينُ لِصَوْلَةٍ","وإِنْ شَدَّ سَاقِي دُونَ مَسْعَايَ قِدُّهُ",129,"د",2,0],["وإِنِّي امْرُؤٌ صَعْبُ الشَّكِيمَةِ بَالِغٌ","بِنَفْسِيَ شَأْواً لَيْسَ فِيهِ نَكِيرُ",130,"ر",1,0],["وَإِنِّي امْرُؤٌ لَوْلا الْعَوائِقُ أَذْعَنَتْ","لِسُلْطَانِهِ الْبَدْوُ الْمُغِيرَةُ والْحَضْرُ",131,"ر",1,0],["وَإِنِّي إِذا ما الشَكُّ أَظْلَمَ لَيْلُهُ","وَأَمْسَتْ بِهِ الأَحْلامُ حَيْرَى تَشَعَّبُ",132,"ب",1,0],["وَأَنِّيَ أَقْلِي صِحَّتِي وَشبِيبَتِي","إِذَا لَمْ تكُونِي فِيهِمَا مُتَمَتَّعِي",133,"ع",2,0],["وَإِنّي أُبغِضُ الإِنسا","نَ أَن أَلقاهُ كَذّابا",134,"ب",2,0],["وَإِنِّيَ أَرمي بِالعَداوَةِ أَهلَها","وَإِنِّيَ بِالأَعداءِ لا أَتَنَكَّفُ",135,"ف",1,0],["وإنيّ إذْ أُهدي إليكَ تحيَّتي","أهزُّ بكَ الجْيلَ العَقوقَ المُعاصِرا",136,"ر",2,0],["وإني أراني بين نوم ويقظة","أسيان حالي في هنا أو هناك",137,"ك",1,0],["وأن يأكلَ \" الثَمرَ \" الزارعونَ","وأن يأخُذَ \" الأرضَ \" من يدأب",138,"ب",1,0],["وأنَّى أعاني فيه شعراً أقوله","وهاجيهِ لا يبغي إله المرَاقيا",139,"ي",2,0],["وأني أخو عزم إذا ما انتضيتُه","نبا كل عضب أو انكر الضرب",140,"ب",1,0],["وأني أعاف الماء في صفوه القَذى","وان كان في احواضه بارداً عذبا",140,"ا",1,0],["وانى اليك الهاشمي وسيلتي","نبي بكل المؤمنين رحيم",141,"م",1,0],["واني اذا لم ارتدي الدين كسوة","واجعله رغم الكفور نصيبي",142,"ب",2,0],["وإني أخافُ البعدَ ينسخ عهدنا","كما نسخَ الحزنَ الشديدَ ظِلالُ",143,"ل",1,0],["وَإِنّي أَخوهُم عِندَ كُلِّ مُلِمَّةٍ","إِذا مُتُّ لَم يَلقَوا أَخاً لَهُمُ مِثلي",144,"ل",2,1],["وإني أريد اليوم عندك حاجةً","لأنك تعطى الحاجة السائلينها",145,"ه",2,0],["وأني إِن بَالَغتُ في صِرفِ هَجوِهِ","وَمَزَّقتُه مِن أصلِه كُنتُ مُطرِيَا",146,"ي",2,0],["وإني ابنُ مَن يَرعَى حُقَوقَ بُنَوَّتِى","ومَن كَانَ يَرعَاهَا يَجِد مني أبنَمَا",147,"م",2,0],["وِإني ابنُ مَن يَرجُو إِذَا غِبتُ أَوبَتِى","سَرِيعاً ويَرجُو أن أفُوزَ وأَغنَمَا",147,"م",2,0],["وأنِّي إلى غُرٍّ أكَارِمَ أنتَمِي","طُهَارَى شُموسِ العَصرِ فِي البَدوِ والحَضرِ",148,"ر",1,0],["وإني أهنيّ وباعي قصير","وكلُّ كلامٍ لديَّ قليلْ",149,"ل",1,0],["وإني إذا أطنبتُ في وصفِ فضلكم","وأنفدتُ عمري لست أحصي لكم شكراً",150,"ر",2,0],["وأنى التأني ثم أخشى ملامكم","فأقدم إقدام الهزبر على قصد",151,"د",1,0],["وَإِنّيَ إِن أَسدَيتُ مَدحاً لِغَيرِهِ","جَديرٌ بِأَن تَنسَدَّ عَنّي المَناجِحُ",152,"ح",1,0],["وإنِّي امْرُؤٌ تَصْفُو مَوارِدُ رَأفَتِي","وَتَحْرُبُ سَطْوَاتِ الْعَدُوَّ الْمُحَرَّبَا",153,"ب",2,0],["وإِنّي إِنْ بكيتُ بكيتُ حقّاً","وإِنَّكِ في بكائِكِ تكذِبينا",154,"ن",2,0],["وَأَنِّى إِذا ما جِئتُ بَيتَكِ أَرشَقَت","إِلىَّ بَصِيراتُ العُيُونِ وَعُورُهَا",155,"ه",2,0],["وإني أخشى على عرضِنا","قافيةً كالصارمِ المرهفِ",156,"ف",1,0],["وإن يأمرِ الملكِ الذي ليسَ تحتهُ","سريرٌ من القتلى يسمعُ",157,"ع",1,0],["وَإِنّي أَتَتني عَن يَسارٍ مَقالَةٌ","وَجَهلٌ وَكانَ المَرءُ لَيسَ بِجاهِلِ",158,"ل",1,1],["واني الى لقياك زدت تشوقا","واني الى جدوا زدت تشوقا",159,"ق",2,0],["وإني أسيرٌ في الهوى ومُتَيّمٌ","ومالي عليه في الغَرامِ مُسَاعِدُ",160,"د",1,0],["وإني أرى البعد عن وجهكم","ردى من حبائله اجفل",161,"ل",1,0],["وإني إذا ما نَبا مُنْصُلٌ","لِمجدِك دِرع وسَيْفٌ صَقِيلُ",162,"ل",1,0],["وأنِيَ أطوِي من صفاءِ ودادِه","ومن نصحِهِ أضعاف ما يعجِز البشرى",163,"ر",2,0],["وإني إذا ما غِبتُ عنك لناظِرٌ","إليك بقلب منك ممتلئ فِكرا",164,"ر",2,0],["وأنَّى اهْتدى طيفُ الخيال ودونَه","من البِيدِ مجهولٌ ودَوٌّ وسَبْسَبُ",165,"ب",1,0],["وإني إليه خاضع متوجه","بأحمد أزكى شافع لفتىً جنى",166,"ن",2,0],["وإني إذا ما قلت إني مؤمن","ولا شك عندي بالمشيئة اتبع",167,"ع",1,0],["وَأَنّي أَنالُ إِذا كُنتُ جارَ","عَبدِ الرَحيمِ أَعالي الرُتَب",168,"ب",1,0],["وإني إذا ما زرتها قلتُ يا اسلمي","فهل كانَ في قولي اسلمي ما يضيرُها",169,"ر",3,0],["وَإِنّي إِلى أَوسٍ لِيَقبَلَ عِذرَتي","وَيَعفُوَ عَنّي ما حَييتُ لَراغِبُ",170,"ب",1,0],["وانّي إِن رأَيتُكَ حَلَّ نَذري","وحقَّ الصَومُ لِلَّهِ المَجيدِ",171,"د",1,0],["وإنّي أرتجي غفران ذنبٍ","فهب لي قبل أن ألقاك توبه",172,"ب",2,0],["وَأَنّي أُحامي مِن وَراءِ حَريمِهِم","إِذا ما المُنادي بِالمُغيرَةِ نَدَّدا",173,"د",2,0],["واني المسهل المدل قياده","لدى العز والصعب الأبي على الذل",174,"ل",1,0],["وإني أخاف العار فيما سألتني","فوالدتي زنجية وأبي حر",175,"ر",1,0],["وإنّي إن رَكِبتُ أَذَيتُ نَفسِي","بِضَربٍ باليَمينِ وبالشِّمالِ",176,"ل",1,0],["وإني أرى ما لا ترَينَ ولا يرى","سوايَ فدُوني لا حِجابٌ ولا سِتر",177,"ر",1,0],["وإني إلى الماضي حَنُونٌ لأنهُ","تولّى بذاوٍ من فؤادي وذائب",178,"ب",1,0],["وإني أحبُّ الحسنَ في كلّ حاجةٍ","وما الحسنُ إلا ما أرومُ وأعشَق",179,"ق",1,0],["وإني أرى الأقدار طوعَ إرادتي","إذا زرتُ مولاتي على صَهوةِ الأشقَر",180,"ر",1,0],["واني اذا ورق الحمام ترنمت","ذكرت خياه بالاباطح قسمت",181,"ت",1,0],["واني اذا ضاقَت وجوه طالبي","أَسير بآمالي الى بابك الفسح",182,"ح",1,0],["وإني المغنّيكم وخادم وفدكم","وعبدكمو عبد لضيفٍ وضيفَنِ",183,"ن",1,0],["وَانى أَرتَجي مِنكُم جَميعا","اِجابَة ما يؤمّله ضَميري",184,"ر",2,0],["وَاِنّي أَرى أَن لا أَرى الذُلّ في الهَوى","وَاِن باتَ قَلبي في لَظى يَتَلَهَّب",185,"ب",1,0],["وإنّي إذا قالوا مَتى أنت راحِلٌ","فقد حانَ للمُسْتَعْجِلينَ رَحيل",186,"ل",1,0],["وَإِنّي إِذا أَجرَيتُ ذِكرَكَ خالِياً","لَأَلتَذُّ فيكُم بِالدُموعِ الَّتي تَجري",187,"ر",2,0],["وَأَنّي إِن جَرى ذِكرٌ بِحَفلٍ","دَفَعتُم بِالأَسى في صَدرِ ذِكرى",188,"ر",2,0],["وَإِنّي إِذا اِستَغرَبتُ يَوماً مِنَ الأَسى","فَما لِيَ ما اِستَغرَبتُ عاماً مِنَ الفَرَح",189,"ح",1,1],["وأني أشكر صنائعك التي","بجيديَ من أطواقهن أثوب",190,"ب",1,0],["وإني أرى التصريحَ خيراً من الكُنَى","وهل يُمكِنُ التمويهُ والمظهرُ السهو",191,"و",1,0],["وإني أرتجي وصلاً سريعاً","يطيب به زماني والمقام",192,"م",1,0],["وَإِنّي إِلى الفَهمِ الَّذي لَكَ أَشتَكي","هُموميَ مِن طولِ اغتِرابي وَمِن كَدّي",193,"د",2,0],["وأنّي أُمَنِّي النفسَ لثْمَ بنانِهِ","وما كانَ قبلي للسحائِبِ لاثِمُ",194,"م",1,0],["وإنّي إذا نازلتُ كَبشَ كَتيبةٍ","فلستُ أُبالِي أيُّنا ماتَ أوَّلاَ",195,"ل",2,0],["وَإِنّي أَميرَ المُؤمِنينَ لَواثِقٌ","بِأَن لا يُرى شَربي لَدَيكَ مُصَرَّدا",196,"د",2,0],["وإنِّيَ إذ أُصغي لمعنى حديثه","ثَمِلْتُ وتردادي بأمداحه نقلي",197,"ل",2,0],["وإنِّي امرؤ يأبى الهوان فلم يَدِن","إلى حكم دهر يا أُميمة جائر",198,"ر",1,0],["وإنِّي إذا ضاقَ الخناق لحادثٍ","تَرَفَّعْتَ إلاَّ عن نداك ترفُّعا",199,"ع",2,0],["وإنِّي إذا قلتُ القريضَ بمدحه","لأصدقُ من قال القريض مقالا",200,"ل",2,0],["وإنِّي أعرِفُ كُنْهَ الرِّجال","ويكشفُ مخبرَها المنظرُ",201,"ر",1,0],["وإنِّي إذا مضَّت بقلبي مضاضةٌ","من الوجد داريتُ الأسى بالتجلُّد",202,"د",1,0],["وإني أصلّي كلّ وقتٍ بذكركم","وأتبع شفعي في صلاتي بالوتر",203,"ر",1,0],["وإني إذا ناديت مدحا أجابني","بديع القوافي منه ممتثلا أمري",203,"ر",2,0],["وأنّى أمّ عزمكم مكانا","فسهل الأرض دونك والحزون",204,"ن",1,0],["وإني أرى الدين لا يستتم","إلا بحبّكم إذ وجب",205,"ب",1,0],["وأَنَّى انتحَيْنا إِلَيْكَ المَطِيَّ","كما قصفَ العاصِفاتُ الغصونا",206,"ن",2,0],["وإني إذا ما الليل ألقى سدوله","خلوت ولي عند الحبيب ولي شجن",207,"ن",1,0],["وإني الذي قد أنظر الغيب شاخصا","أمامي فأرويه ولا أتنبأ",208,"ا",1,0],["وإِني إن بلغتُ النجمَ يوماً","لكان إلى صنيعتك أنتسابي",209,"ب",2,0],["وأنْ يأخُذ الآرابَ غيرَ مُجاهِرٍ","إذا ما المَباغي شَوَّهتْها المخاتِلُ",210,"ل",1,0],["وإني أسير بلا صاحب","فاطوى الدجى وأصيد الشرودا",211,"د",2,0],["وأني أذمُّ الصبر عنك وحسنهُ","أسى وأعدُّ الحلم فيك من الجهل",212,"ل",1,0],["وأنّي اهتدت في ليل شعر ودجنة","إلى مضجعي والنجمُ في الغرب حيران",213,"ن",1,0],["وَأَنّى اِهتَدَت أَسماءُ وَالنَعفُ دونَها","لِرَكبٍ بِأَعلى ذي سَلامانِ نازِلِ",214,"ل",1,0],["وَأَنِّيَ أَسلَمتُ الرِكابَ فَعَقَّرَت","وَقَد كُنتُ مِقداماً بِسَيفي مُغَرِّدا",215,"د",2,0],["وإِني إِذا ما جِئتُكُم مُتَهَلِّلاً","بَدا مِنكُمُ وَجهٌ عَليَّ قَطوبُ",216,"ب",1,0],["وَإِنّي إِذا حَلَّت بِبيشٍ مُقيمَةً","وَحَلَّ بِوَجٍّ جالِساً أَو تَتَهَّما",217,"م",2,0],["وإني إلى الباي قدمته","يهنّي الأمير بأحسن عام",218,"م",1,0],["وإني امروءٌ واللهُ يعلمُ أَنَّهُ","تساوى لديه في الهوى الحلُّ والعقدُ",219,"د",1,0],["وأنِّي امرؤٌ في حضرَةِ القُدْسِ قلبُهُ","وقد رَشَّقَ البُرْدَ المُعَلَّى بدمْعِهِ",220,"ع",2,0],["وإنّي إلى الموتِ بشوقٍ وعلّ في","الفراقِ ارتياحنا فردّدْ دعائيهْ",221,"ي",2,0],["وإنّيْ إذا لقيتُ ربّي مُكبَّلا","بوزنِ الجبالِ والهضابِ ذُنوبا",222,"ب",2,1],["وأنّي الأسيرُ والجريحُ المحاصرُ","بنارٍ حقودٍ ما رهبتُ لظاها",223,"ا",3,0],["وأنّي الحسينُ ما ارتوت كربلاءُ من","دمي وفلسطينُ يئنُّ ثراها",223,"ا",3,0],["وأنّي العليمُ الأعلمُ المتعلِّمُ ال","معلِّمُ ذوالعلمِ الذي لا يُضاهى",223,"ا",3,0],["وأنّي العزيزُ ذوالإباء الكريمُ ذو","العطاءِ الذي عنِ الصغائرِ ناهَ",223,"ا",2,0],["وأني أرى أولاد غيري حسرة","فأبكي على نسلي وفقدان ما يسلي",224,"ل",2,0],["وَاِنّي اِذا رُمت الدُخول تَرُدُّني","مَهابَةُ قيس وَالرتاج المُضَبَّب",225,"ب",1,0],["وَأنى الثَنا وَاللَّه جَلَّ جَلاله","عَلى عَبدِهِ أَثنى فَهَل بَعدَ ذا حَمدُ",226,"د",1,0],["وَإنِّيَ أَدْعُو إلَهِي بأنْ","يُعافِيَني مِنْ جَميع العِلَلْ",227,"ل",1,0],["وَإنّي أَرَاها قَاصِراتٍ وإِنَّنِي","إذَا حَقَّقَ الأَقْوامُ أَقْصَرُ قاصِرِ",228,"ر",1,0],["وإِنِّي امْرُؤ أَمّا نِجارِي فخالِصٌ","وأَمَّا فَعَالِي فاسْأَل الدَّهْرَ واكْتُبِ",229,"ب",1,0],["وإني أخذتُ بما قُلتَه","فكانت نَتيجَتُه ما تَرى",230,"ر",2,0],["وإنِّي أرَى النَشءَ الجديدَ ونَهجَهُ","على عَكسِ هذا وهو ما لستُ أَفهمُ",231,"م",1,0],["وإنّي إنْ فخرتُ على البرايا","فخرتُ بمن يبذُّ الفاخرينا",232,"ن",2,0],["وَإنِّيَ أَقضي كلَّ يومٍ وليلةٍ","فَأقربُ إبْقاءً وأُرمى فلا أَرمِي",233,"م",2,0],["وإنّي أميمٌ بالمشيبِ فخلِّيا","ولا تطلبا عندي علاجَ الأمائِمِ",234,"م",1,0],["وإنّي أُشيرُ برأيٍ يضمُّ","إلى النُّصْحِ تَجْرِبَةَ العالمِ",235,"م",1,0],["وإنِّيَ أُلقِي القولَ بالسّوءِ منهمُ","بمَدْرَجِ أنفاسِ الرّياحِ السّواهكِ",236,"ك",1,0],["وإنّي آملٌ فيكمْ وشيكاً","وإنْ موطلتُ عنه بلوغَ ثاري",237,"ر",2,0],["وأنَّى أرجِّيكمْ لبُرْءِ جُراحتي","وَما كانَ إلّا عَن سهامكُم عَقْرِي",238,"ر",2,0],["وَإِنّي أَستطيل إِذا هَجرتمْ","وسادي مدّةً اللّيلِ القصيرِ",239,"ر",1,0],["وإني أنا الموجود عنها بها لها","وما أنا موجود وما لغتي لغو",240,"و",1,0],["وإني الملْك والملكوت فضلاً","وإني صخرة الوادي وإني",241,"ن",2,0],["وإِني امرؤ مني الحياء الَّذي تَرى","أَعيش بأَخلاق قَليل خداعها",242,"ع",3,0],["واني امرؤ لا آلف البيت قاعداً","الى جنب عرسي لا أُفارقها شبرا",243,"ر",2,0],["وإِنّي أحلُّ ببطن واد","ولا آوي إِلى البيت القَصير",244,"ر",1,0],["وإِنّي امرؤ لا أَسأَل الناس مالهم","بشعري ولا تعمى عليَّ المكاسبُ",245,"ب",1,0],["وإِني إِذا قابلتُ خَصْماً مُمَاحْكَا","كَبَا باطلٌ منه وأَشرقَ بُرْهَاني",246,"ن",2,0],["وإِني أَسرُّ العالمين لأَنَّنِي","تصوَّرْتُ حيّاً بعد أَنْ ضمَّني الْقبرُ",247,"ر",1,0],["وإِني أَكيلٌ للزَّمانِ بصرفِه","ومن عَجبٍ أن يأكل الصارم الغمد",248,"د",1,0],["وَإِنّي أَرُدُّ الكَيشَ عَن سُنَنِ الهَوى","وَيَرجِعُ رُمحي بَعد رَيّانُ ناهِلِ",249,"ل",1,0],["وَأَنّي إِذا ما الصُبحُ آنَستُ ضَوءَهُ","يُعاوِدُني قِطعٌ عَلَيَّ ثَقيلُ",250,"ل",1,0],["وَأَنّي أَرى الشَخصَينِ أَربَعَةً مَعاً","فَسقياً لِلَذّاتِ الشَبابِ المُزايِلِ",251,"ل",1,0],["وَأَنّى اِهتَدَت سَلمى وَسائِلَ بَينَنا","وَما دونَها مِن مَهمَةِ الأَرضِ يَخفُقُ",252,"ق",1,0],["وَإِنّي إِذا اِبنُ العَمِّ أَصبَحَ غارِماً","وَلَو نالَ مِنّي ظِنَّةً لا أُهاجِرُه",253,"ر",2,0],["وَإِنّي أَرى كُلَّ اِبنِ أُنثى مُؤَجَّلاً","وَلَم يُضرُبِ الآجالُ إِلّا لِتَنفَدا",254,"د",2,0],["وَإِنّي أَخوكَ الدائَمُ العَهدِ لَم أَحُلُ","إِن اِبزاكَ خَصمٌ أَو نَبابِكَ مَنزِلُ",255,"ل",1,0],["وَإِنّي أَخوهُم عِندَ كُلِّ مُلِمَّةٍ","إِذا مِتُّ لَم يَلقوا أَخاً لَهُمُ عِدلي",256,"ل",2,0],["وَإِن يَأتِنا ذو حاجَةٍ يُلفِ وَسطَنا","مَجالِسَ يَنفي فَصلُ أَحلامِها الجَهلا",257,"ل",2,0],["وَإِنّي إِذا ضاقَت عَلَيكُم بُيوتُكُم","لَيَعلَمُ قَومي أَنَّ بَيتِيَ واسِعُ",258,"ع",1,0],["واني ابن حرب لا تزال تهرني","كلاب عدوي أو تهر كلابي",259,"ب",2,0],["وَأَنّي أَرى ديني يُوافِقُ دينَهُم","إِذا نَسَكوا أَفراعُها وَذَبيحُها",260,"ح",3,0],["وَإِنّي إِن يقال قَضى ضرارٌ","لِباكيةٌ بِمنسجمٍ هتونِ",261,"ن",1,0],["وَإِني إِذا ما المَوتُ لَم يَكُ دونَهُ","مَدى الشِبرِ أَحمي الأَنفَ أَن أَتأَخَّرا",262,"ر",2,0],["وإِنّي إِذا أَغضى الفَتى عَن ذِمارِهِ","لَذو شَفَقٍ عَلى الذِمارِ مُشارِفُ",263,"ف",1,0],["وَإِنِّيَ إِن أَوعَدتُهُ أَو وَعَدتُهُ","لَأُخلِفُ إيعادي وَأُنجِزُ مَوعِدي",264,"ي",1,0],["وَأَنّي أَحُلُّ عَلى رَهوَةٍ","مِنَ المَجدِ في الشَرَفِ الأَعظَمِ",265,"م",1,0],["وَأَنّي أُشَمِّصُ بِالدارِعي","نَ في ثَورَةِ الرَهَجِ الأَقتَمِ",265,"م",1,0],["وَأَنّي أَكُرُّ إِذا أَحجَموا","بِأَكرَمَ مِن عَطفَةِ الضَيغَمِ",265,"م",1,0]]}