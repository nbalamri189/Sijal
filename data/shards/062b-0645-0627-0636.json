{"poems":[[55,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[90,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62226","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20995","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[20,"ثم أَضحوا عصف الدهر بهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70002&r=&rc=24",""],[132,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[563,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35780","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109482","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205774","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202408","الخفيف"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/6","الخفيف"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139436",""],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4702,"الوقت ياعزام بانت غوايبه","https://www.poetsgate.com/ViewPoem.aspx?id=155114",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""]],"verses":[["ثُمَّ اِضطُرِرتُ إِلى صَبري فَعُذتُ بِهِ","وَأَعرَبَ الصَبرُ لَمّا أَعجَمَ الجَزَعُ",0,"ع",1,0],["ثم أضجعتها على الأرض واعرَو","رَيت منها مطيّةً خيفانه",1,"ن",2,0],["ثُمَّ أَضحى يَقتَري حِبَّةً","بَينَ أَكنافِ كَثيبٍ رُكام",2,"م",1,0],["ثُمَّ اضْطَبَنْتُ سِلاَحِي عِنْدَ مَغْرِضِهَا","ومِرْفَقٍ كَرِئَاسِ السَّيْفِ إِذْ شَسَفَا",3,"ف",2,0],["ثُمًّ أَضحَوا أَخنَعَ الَّهرُ بهم","وكَذلكَ الدَّهرُ يُودي بِالجبال",4,"ل",1,0],["ثُمَّ أَضحَى مُلكُ رُومَا مُلْكهُمْ","وَمُوَلاَّهمْ على الأَحْبَارِ حَبْرا",5,"ر",2,0],["ثُمَّ أَضحوا عَصَفَ الدَهرُ بِهِم","وَكَذاكَ الدَهرُ حالٌ بَعدَ حال",6,"ل",1,1],["ثم أضحى في قعْرِ لحدٍ وحيداً","بعد عِزٍّ يُقلقلُ الأوتادا",7,"د",2,0],["ثم أضحى من بعد ذاك وهذا","مثل ما كان أسر أمر مطاع",8,"ع",1,0],["ثم أضف إن أفرد اسم ولقب","أو أتبع الثاني لأوّل وجب",9,"ب",1,0],["ثُمَّ أَضحَوا تَسحَبُ الري","حُ بِمَغناهُم ذُيولا",10,"ل",2,0],["ثم اضحى بعدما حاز الرضا","بنعيم ما عليه من مزيد",11,"د",1,0],["ثم أضحى فتى يتوق إلى الفه","م ويمضي إلى سبيل الرشاد",12,"د",1,0],["ثم أضحى يبص بالذيل عطفا","يطلب الأذن منهمُ باقتراب",13,"ب",1,0],["ثم أضحى الثقّاب نزوة طيشٍ","من أخي جنّةٍ وربّ غرور",14,"ر",1,0],["ثُمَّ أَضحَوا عَلى الدَثينَةِ لا يَألونَ","أَن يَرفَعوا صُدورَ الجِمالِ",15,"ل",1,0],["ثم أضحوا لعبَ الدهرُ بهم","وكذاك الدهرُ حالٌ بعد حال",16,"ل",1,0],["ثم أضحى صوت البنادق يدوي","فتجيب الأغوار والأنجادُ",17,"د",1,0],["ثم اضحكت والروض تشدو نسايمه","قامت تلاعبها وسالت لعايبه",18,"ب",2,0],["ثم أضحى شيخاً حنَتْه الليالي","فهو كالجذع مالَ منه القَوامُ",19,"م",1,0]]}