يم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[31,"لَيْتَ شِعْرِي هَلْ أَذُوقَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18779&r=&rc=42",""],[68,"ما بينَ مُعْتَرَكِ الأحداقِ والمُهَجِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15406&r=&rc=12",""]],"verses":[["وَأَضاءَ لي زَمَني وَأَي","يامُ الفَتى بيضٌ وَجونُ",0,"ن",1,0],["وَأُضرَبَ سَمعٌ عَنِ العاذِلاتِ","لَها شانُها وَلَهُ شانُهُ",1,"ن",2,0],["وَأَضمَرتُ مِنهُ لَفظَةً لَم أَبُح بِها","إِلى أَن أَرى إِطلاقَها لِيَ مُطلَقا",2,"ق",2,0],["وَأَضرَمَ ناراً فَاِستَرابوا بِضَوئِها","وَما هِيَ إِلّا لِلضُيوفِ السَوائِرِ",3,"ر",1,0],["واضِحُ العَزمِ مُتلَئِبُّ المَطايا","مُستَطيبُ الإِتهامِ وَالإِنجادِ",4,"د",1,0],["وَأَضحوا عَلى الأَعوادِ تَسمو لِحاظَهُم","كَلَمحِ القَطامِيّاتِ فَوقَ المَراقِبِ",5,"ب",1,0],["وَأَضرَمَها حَمراءَ يَنزو شَرارُها","إِلى جَنَباتِ الجَوِّ نَزوَ الجَنادِبِ",6,"ب",1,0],["وَأَضحى هُذَيمٌ مُسعِداً لي عَلى البُكا","وَأَمسى أَبو المِغوارِ سَعدٌ يُعَنِّفُ",7,"ف",1,0],["وَأَضْلُعٌ فيها الجَوَى كامِنٌ","وَأَدْمُعٌ مِنْها النَّوى تَغْتَرِفْ",8,"ف",1,0],["وأضاءَ بَرْقٌ كادَ يَسلُبُهُ الكَرى","فتَقَصّيا نَظَراً إليهِ وشيما",9,"م",2,0],["وأضَرُّهُمْ لكَ حينَ يُعضِلُ حادِثٌ","بالمَرْءِ مَنْ هوَ في الصّداقَةِ أقْدَمُ",10,"م",1,0],["وَأَضرَمَ في صَميمِ القَلبِ نار","كَضَربي بِالحُسامِ الهُندُواني",11,"ن",2,0],["وَأَضْرَبَ عَنْ خَطِّ الْهَوَى عِنْدَمَا اسْتَوَى","وَقَدْ أَجْمَلَتْ جُمْلٌ وَقَدْ أَنْعَمَتْ نُعْمُ",12,"م",1,0],["وأضاءتْ منْ نُورِ ميلادِكَ الأرْ","ضُ وهزّتْ لهُ اهْتِزازَ ارْتِياحِ",13,"ح",1,0],["وَأُضْحِي وَمِحْرَابُ الدُّجَى مُتَهَجَّدِي","وَأَمْسِي وَمَاءُ الرَّافِديْنِ شَرَابِي",14,"ي",1,0],["وَأَضِفْ إِلَى لاَمِ الْوَغَى أَلِفَ الْقَنَا","تَظْهَرْ لَدَيْكَ عَلاَمَةُ التَّغْلِيبِ",15,"ب",1,0],["واضِعاً في سَراةِ نَجرانَ رَحلي","ناعِماً غَيرَ أَنَّني مُشتاقُ",16,"ق",1,0],["واضِحِ اللَونِ كَالمَجَرَّةِ لا يَع","دَمُ يَوماً مِنَ الأَهابِيِّ مورا",17,"ر",2,0],["وَاِضرَع إِلى اللَهِ في الفِردَوسِ مُبتَهِلاً","أَن يَحرُسَ النيلَ مِمَّن رامَ طُغيانا",18,"ن",2,0],["وَاِضرِب عَلى الوَتَرِ الَّذي اِهتَزَّت لَهُ","أَعطافُنا زَمَناً وَغَنِّ النيلا",19,"ل",2,0],["وَأَضحَت تَتيهُ بِرَبِّ القَريضِ","كَتيهِ البَوادي بِأَشعارِها",20,"ر",3,0],["وَاِضرِب بِسَوطِ البَأسِ أَع","طافَ الزَمانِ إِذا اِستَبَدّا",21,"د",2,0],["وَاِضرَع إِلى اللَهِ أَن يَرعى أَريكَتَنا","مَرفوعَةَ الشانِ ما مَرَّ الجَديدانِ",22,"ن",1,0],["وَأَضاعَ عَهداً لَم أُضِعهُ حافِظاً","ذِمَمَ الوَفاءِ وَحالَ عَن صَبٍّ صَبا",23,"ب",2,0],["وَأَضحى يَسُحُّ الماءُ عَنكُلِّ فَيقَةٍ","يَكُبُّ عَلى الأَذقانِ دَوحَ الكَنَهبَلِ",24,"ل",1,0],["وَأَضرَرتَ بِالفاني وَشَمَّرتَ لِلَّذي","أَمامَكَ في يَومٍ مِنَ الشَرِّ مُظلِمِ",25,"م",1,0],["وَأَضْمَرُوا لَكَ عُدْوَاناً وَجَدْتَ بِهِ","فِي الأَمْنِ مَا لَمْ تَجِدْ فِي الحَرْبِ مِنْ حَرَبِ",26,"ب",1,0],["وَأَضَافَ بِالدُّسْتُورِ أَرْوَعَ دُرَّةٍ","يُزْهَى بِهَا إِكْلِيلُهَا النُّورَانِي",27,"ن",2,0],["وَاِضطَرَّهُم مِن أَيمَنٍ وَأَشأَمِ","صِرَّةُ صَعصاعِ عِتاقٍ قُتَّمِ",28,"م",1,1],["وَأَضحَت مَباديها قِفاراً بِلادُها","كَأَن لَم سِوى أَهلٍ مِنَ الوَحشِ تُؤهِلِ",29,"ل",1,0],["وَآضَ حِربَآءُ الفَلاةِ الأَصعَرُ","كَأَنَّهُ ذو صَيَدٍ أَو أَعوَرُ",30,"ر",1,0],["واضعاً فأي فوق فيها وكلٌّ","قد أمصّ الضجيع منه لسانه",31,"ن",2,0],["واضاعة الوطن العزيز جناية","ضلّ الزمان بها عن الغفران",32,"ن",1,0],["وأضرِب في البلاد بغير مكث","أجوب من المهامِهِ ما أجوب",33,"ب",1,0],["واضرب عن جهل الجهول ولم أكُنْ","لأضرب في الأيام للغدر موعدا",34,"د",2,0],["وَأَضبُعُ ذي مَعارِكَ قَد عَلِمتُم","لَقينَ بِجَنبِهِ العَجَبَ العُجابا",35,"ب",2,0],["وَأَضرَبَ بِالسُيوفِ إِذا تَلاقَت","هَوادي الخَيلِ صادِيَةً حِرارا",36,"ر",2,0],["وَأَضحَت رِكابُ القَينِ مِن خَيبَةِ السُرى","وَنَقلِ حَديدِ القَينِ حَسرى وَظُلَّعا",37,"ع",2,0],["وَاِضبِطِ اللَيلَ إِذا طالَ السُرى","وَتَدَجّى بَعدَ فَورٍ وَاِعتَدَل",38,"ل",1,0],["وأضحكت الضباعَ سيوفُ سَعْد","بقتلى ما دُفن ولا ودينا",39,"ن",2,0],["وَاضِحِي أَوجُهٍُ كَرِيمِي جُدُودٍ","وَاسِطِي نِسبَةٍ لِهَام فَهَامِ",40,"م",1,0],["وَأَضحَكنَا بَوَاكِيَ أهلَ خَوف","وأبكَينَا ضَوَاحِكَ آمِنينَا",41,"ن",2,0],["وأضحَكَت الضِّبَاع سُيُوفُ سَعد","بِقَتلَى ما دُفنَّ وَمَا ودينَا",41,"ن",2,0],["واضِحي العلم والهدى بسناهم","يتجلَّى عن الورى كلّ داجي",42,"ج",2,0],["وأضيفت لذا وذا جمل الأنع","ام يتلو جزيلها الحرّ جزله",43,"ل",2,0],["وأضحى لسرِّ الملك صدراً قد انْتقى","له مستقرًّا في الورَى ومقاما",44,"م",2,0],["وأضحت قناةُ الظَّهْر قُوِّسَ متْنُها","وقد كان معدولاً وإن عشتُ فخخا",45,"خ",2,0],["وأضحى ذَلولاً ظهرُه إذ ركبته","لمجدٍ يبيد الدهْرُ قبل بُيُودِهِ",46,"د",2,0],["وأضحت ترى كل ما حولها","لظلمتها جبلاً أسودا",47,"د",2,0],["وأضحت الحرة مقرونةً","بالحر في دولته الحرهْ",48,"ر",2,0],["وأضحى وأمسى كل ما بين بَلْدحٍ","به حرماً حتى القفارُ البسابس",49,"س",1,0],["وأضحتْ تَعِيرُ مع العائِري","نَ في زُمرة البَقَش الأبقش",50,"ش",1,0],["وأضلاع الرُّخال مُربَّيَاتٍ","بكسب المروِ والعجم اللقيطِ",51,"ط",1,0],["واضحةَ الأَثْرينِ من طول ما","تُناك إبراكاً وتجديلا",52,"ل",2,0],["وأضحى وأمسى والسلامةُ عنده","لحافَ مبيتٍ أو فراش مقيلِ",53,"ل",1,0],["وأضحتْ عليكِ الوحشُ والطيرُ وُلَّهاً","تبكِّي الرواء النضر والمَخْبر العَمَمْ",54,"م",1,0],["وأضربُ الناس في قومٍ بجائحة","شُؤماً وأكثر من عمرو بن دهمان",55,"ن",1,0],["وَأَضحَت لِبَعلٍ غَيرِ أَخطَلَ إِذ ثَوى","تَلُطُّ بِعَينَيها الأَشاجِعَ وَالكُحلا",56,"ل",2,0],["وَأَضحَت عامِرٌ تَعتادُ دَوساً","كَما اِعتادَ المُطَلَّقَةَ النِساءُ",57,"ا",2,0],["وَأَضحى بَناتُ البُلعُمانِ كَأَنَّها","جَوارٍ عِجافٌ جَشَّبَتها الرَبائِبُ",58,"ب",1,0],["وَأَضَلَّ روحُكَ في السُرى وَأَضَلَّها","ما خِلتَهُ ماءً فَكانَ سَرابا",59,"ب",2,0],["وَأَضحى لَهُ يولي الثَناءَ غَنِيُّها","وَأَمسى لَهُ يُهدي الدُعاءَ فَقيرُها",60,"ر",3,0],["وَأَضحى نَسيمُ الرَوضِ يَروي حَديثِنا","فَيا رَبُّ لا تُسمَع وُشاةٌ وَحُسَّدُ",61,"د",1,0],["وأضعفُ الناسِ رأياً مَن يُهيب بكم","لا تتركوا النّيلَ في أيدي العِدَى سَلَبا",62,"ب",2,0],["وأَضغاثِ أَيَّاميَ الغابراتِ","وفيها الشَّقيُّ وفيها السَّعيدْ",63,"د",1,0],["وَأَضعَفتَ بالمطلِ حَبلَ الرَجا","ء فرثّ وَأعهدُهُ مُحصَدا",64,"د",2,0],["واِضرب بِسكين الدَوا","ة مَكانَ ماضي الحَدّ باتِرْ",65,"ر",1,0],["وَأَضعافُ الَّذي يُبدي لِساني","إِلَيهِم ما يَجِنُّ لَهُم جِناني",66,"ي",1,0],["وأضرحة فيها الرغام وسائد","فما حفلت نوامها بالوسائد",67,"د",1,0],["وأضلعا لا تقاس طهرا","بها الغوادي ولا نقاء",68,"ا",2,0],["وأضيئي البحر واتّسمى","بحجول اليمن والغرر",69,"ر",1,0],["وَاِضحَك مِنَ الأَقدارِ غَيرَ مُعَجَّزٍ","فَاليَومَ لَستَ لَها مِنَ الأَهدافِ",70,"ف",1,0],["وَأَضحى نُفوذُ المالِ لا أَمرَ في الوَرى","وَلا نَهيَ إِلّا ما يَرى وَيُشيرُ",71,"ر",1,0],["وَأَضْلُعَه لِقَضْقَضةٍ","صَيَارِفُ حاسِبُو وَرِقِ",72,"ق",1,0],["وَأَضحى ذِكرُهُ في كُلِّ أَرضٍ","تُدارُ عَلى الغِناءِ بِهِ العُقارُ",73,"ر",1,0],["وَأَضحى وَبَينَ الناسِ في كُلِّ سَيِّدٍ","مِنَ الناسِ إِلّا في سِيادَتِهِ خَلفُ",74,"ف",1,0],["وَأضْعَفْنَ ما كُلّفْنَهُ مِنْ قُباقِبٍ","فأضْحَى كأنّ الماءَ فيهِ عَليلُ",75,"ل",1,0],["وَأَضحى جَنيباً لِلمَطالِ مُجانِباً","لِناصِحِهِ في الغَيِّ طَوعاً لِمَن يُردى",76,"د",2,0],["واضِحٌ في دُجى الخُطوبِ وَحَتمٌ","أَن يَسودَ السَحابَ حُسناً صَبيرُه",77,"ر",2,0],["وَاِضطِرابي في الناسِ حَتّى عُد","تُ إِلى حاجَةٍ فَأَنتُم قَصاري",78,"ر",2,0],["وَأَضحَوا وَكانوا لا يُنَهنِهُ شَغبَهُم","إِذا قيلَ كُفّوا عَن تَخَمُّطِكُم كُفّوا",79,"ف",3,0],["وَأَضعَفَ بِالقَبّاذَقَينِ سِجالَهُ","وَأَرعَدَ بِالأُبسيقِ شَهراً وَأَبرَقا",80,"ق",2,0],["وَأَضلَلتُ حِلمي فَاِلتَفَتُّ إِلى الصِبا","سَفاهاً وَقَد جُزتُ الشَبابَ مَراحِلا",81,"ل",2,0],["وَأَضحَت بِالشَآمِ تَرى حَراماً","مُواصَلَتي وَهِجراني حَلالا",82,"ل",2,0],["واضِحُ الوَجهِ وَالفَعالِ إِذا ما","كانَ وَجهُ الزَمانِ جَهماً بَهيما",83,"م",2,0],["وَاِضمَحَلَّ الشِقاقُ في الأَرضِ مُذ طا","عَ لَكَ المَشرِقانِ وَالمَغرِبانِ",84,"ن",1,0],["وَأَضحى المُلكُ أَزهَرَ مُستَنيراً","بِأَزهَرَ مِن بَني فِهرٍ هِجانِ",85,"ن",1,0],["وَأَضحى سَعيدٌ في الحَديدِ مُكَبَّلاً","يُعاني وَأَحياناً يُقادُ فَيَصحَبُ",86,"ب",1,0],["وَأَضحى الغَواني لا يُرِدنَ وِصالَهُ","وَبَينا تَرى ظِلَّ الغِيايَةِ أَدبَرا",87,"ر",2,0],["وَأَضيافِ لَيلٍ قَد نَقَلنا قِراهُمُ","إِلَيهِم فَأَتلَفنا المَنايا وَأَتلَفوا",88,"ف",3,1],["وَأَضحَت بِأَجرازٍ مُحولٍ عِضاهُها","مِنَ الجَدبِ إِذ ماتَ الأَفاعي بِها هَزلا",89,"ل",2,0],["وأَضرِبُ بالفَصِّ وجهَ الثَّرى","فإمَّا عليَّ وإمَّا لِيه",90,"ي",2,0],["وأضحى الحَيا في غَيْرِ حينِ أوانِه","رَذاذاً على تلكَ الجُسومِ ووَابلا",91,"ل",2,0],["وأَضحَكَ الثَغْرَ إلاّ أنَّ مَبسِمَه","إذا تَبَسَّمَ مَسْروراً مَناصِلُه",92,"ل",2,0],["وأضاءَتْ فيه مَخايلُ بِشْرٍ","كُنَّ للغَيْثِ من نَداه بُروقا",93,"ق",2,0],["وأَضحَتِ الأُهبُ شباريقَ قِدَد","كأنها في الرَّوضِ نَظماً وبَدَد",94,"د",1,0],["وأضحَتِ الأغصانُ قد نُظِّمَتْ","غَرائبُ الحَلْيِ بأجيادِها",95,"د",3,0],["وَأَضحَت تَقولُ الناسُ وَالدِستُ وَالعُلى","كَذا فَليَجَلُّ الخَطبُ وَليَفدَحِ الأَمرُ",96,"ر",1,0],["وَأَضيَقُ مِن سُمَّ الخِياطِ اِعتِذارُهُ","وَصَدرٌ مِنَ الأَرضِ البَسيطَةِ أَفسَحُ",97,"ح",1,0],["واضيعَةَ العُمرِ وَفَوتَ المُنى","بَينَ رِضى الكومِ وَسُخطِ المِلاح",98,"ح",1,0],["وَأَضعَفُ ما بِيَ بِالخُصورِ مِنَ الضَنا","عَلى أَنَّها مِن ظُلمِها غَصَبَت قِسمي",99,"ي",1,0],["وا ضياع الحزن والدم","ع على العمر المضاع",100,"ع",1,0],["وَأَضحَتْ لَهُم سَرْقُوسةٌ دارَ مِنْعَةٍ","يَزورونَ بِالدَّيرين فيها النواوِسا",101,"س",2,0],["وَأَضُمُّ أَحنائي على أَنفاسِها","كَيمَا تُبَرّدَ حَرّ قلبٍ مُكْمَدِ",102,"د",1,0],["وأَضحَت لَديهِ مُعتَقاتٍ وَمُتِّعَت","بِخُضرِ المَراعي بَينَ زُرقِ المَوارِدِ",103,"د",1,0],["وأضحى لقومٍ مذعنينَ بعدلهِ","نعيماً وقومٍ مجرمين عذابا",104,"ب",2,0],["واضعٌ كفَّيْه في أخصارهِ","وقيامٌ في قعودٍ قد وجب",105,"ب",1,0],["وأَضحَت بها أَهواؤهم وكَأَنَّما","مذاهبهم فيها اختلافُ المذاهِبِ",106,"ب",1,0],["وَأَضحَت قَريحاتُ القُلوبِ مِنَ الجَوى","تُقاظُ وَلَكِنَّ المَدامِعَ تُربَعُ",107,"ع",1,0],["وَأَضحَت عِندَ غَيرِكَ في هُبوطٍ","حُظوظٌ كُنَّ عِندَكَ في صُعودِ",108,"د",1,0],["وأضحتْ ساحةُ الألعابِ فيها","كأقصر ما ترسَّمت الحدود",109,"د",1,0],["واضِحٍ عَذبٍ إِذا ما اِبتَسَمَت","لاحَ لَوحَ البَرقِ في وَسطِ الحَبي",110,"ي",1,0],["وَأَضحوا جَميعاً تَعرِفُ العَينُ فيهِمُ","كَرى النَومِ مُستَرخي العَمائِمِ مُيَّلِ",111,"ل",1,0],["واضِحِ اللَبَّةِ وَالسُن","نَةِ كَالظَبيِ الرَبيبِ",112,"ب",1,0],["وَأَضرَمتَ نارَ الطَعنِ في ثَغرَةِ العِدى","وَأَجرَيتَ ماءَ النَصرِ في صَفحَةِ النَصلِ",113,"ل",1,0],["وَأَضرَمتَ نيراناً بِقَلبي وَإِنَّني","أُكابِدُ أَهوالاً طَويلاً قَصيرُها",114,"ر",3,0],["واضرِبْ بما زعم الضّعافُ وجوهَهم","فمن المزاعمِ للعقولِ خَبالُ",115,"ل",1,0],["وأَضَلُّ النّاسِ رَأياً مُرجِفٌ","تارةً يَهذِي وَحِيناً يكذِبُ",116,"ب",1,0],["وأضعفَ ما يكونُ القومُ جُنداً","إذا حَشدوا الصّحائفَ صائحينا",117,"ن",2,0],["وَأَضِئ لَها سُبُلَ النَجاةِ لِيَهتَدي","مَن زاغَ عَن وَضَحِ الطَريقِ وَمالا",118,"ل",2,0],["وَأَضيَعُ ما فَوقَ البَسيطَةِ أُمَّةٌ","يُمَزِّقُها جَهلٌ وَيَأكُلُها حِقدُ",119,"د",1,0],["وأضلُّ النّاسِ في دنياهُ مَنْ","وَضَح الحقُّ فولَّى وأَبَى",120,"ب",2,0],["وأضلُّ الرجالِ من لا يُلبِّي","دَاعِيَ اللهِ طائعاً إذ يُنادَى",121,"د",2,0],["وَأَضرِم النارَ إِن القَومَ هامِدة","قُلوبُهُم ذلَّ قَلبٌ غَير مَشبوبِ",122,"ب",1,0],["وأضعْتُ صادقة الرجاءَ","فأينَ كاذبةُ الرجاءِ",123,"ا",2,0],["وأضاءَ عُرْجُونٌ وَسَوْطٌ في الدُّجى","عَنْ أمرِهِ فكأنَّ كُلّاً كَوْكَبُ",124,"ب",1,0],["واضرِبهُم بَقَناً مثلِ الحديدِ بهمْ","فليسَ من غَيرِ ضَرْبٍ يَنْفَعُ الزُّبُرُ",125,"ر",1,0],["وأَضاءَتِ الأَيّامُ مِنْ أنوارِهِ","فَاستَصحَبَت غُرَراً بها وحُجُولا",126,"ل",2,0],["وآضَ مِنْ رَوْضِها جِيدُ الوجودِ به","مِنْ لُؤلُؤٍ النَّورِ تَرْضِيعٌ وتكلِيلُ",127,"ل",1,0],["وأضحى مُرَدّىً بالنِّجادِ كأنّهُ","هِزَبْرُ عَرينٍ ضَمّ جَنْبَيْهِ أشجع",128,"ع",1,0],["واضطلاعٍ بالّذي حُمِّلَهُ","واكتفاءٍ وانتِصاحٍ واجتِهاد",129,"د",1,0],["وَاِضمَنِ التَوبَةَ عَمَّن","كُلَّما أَطراكَ عادا",130,"د",2,0],["واضَياعاهُ أَمِثلي","يُرتَجى مِنهُ خَليطا",131,"ط",2,0],["وَأَضرَطَ مِن أُمِّ مُبتاعِها","إِنِ اِقتَحَمَت بُكرَةً حَرمَلا",132,"ل",2,0],["وَأَضبَطُ لا تُوَزِّعُهُ المَنايا","أَبَلَّ مُشَيَّعٌ بِالمَوتِ سَمحُ",133,"ح",1,0],["وَأُضمِرُها في النَفسِ حَتّى كَأَنَّما","أُكَلِّمُها بَينَ الحَشا وَلَهاتي",134,"ي",1,0],["وَأَضحى ساطِعاً بِجِبالِ حِمسى","دُقاقُ التُربِ مُختَزِمُ القَتامِ",135,"م",1,0],["وَأَضحَت نَعامُ الجَوِّ بَعدَ سُموِّها","سُدىً في نَعامِ الدَوِّ لا تَأمَنَ الغُلبا",136,"ب",2,0],["وَآضَ الفَرغُ لِلساقينَ فَرغاً","تُحاوِلُ ماءَهُ المُتَوَرِّداتُ",137,"ت",1,0],["وَأَضعَفُ مَن تَلقاهُ مِن آلِ آدَمٍ","إِذا ما شَتا يَبغي وَقوداً وَبُرجُدا",138,"د",2,0],["وَأُضيعُ أَوقاتي بِغَيرِ نَدامَةٍ","وَيَفوتُني الشَيءُ اليَسيرُ فَأَندَمُ",139,"م",1,0],["وأضعفَ الرّعْبُ أيدِيهِم فطعْنُهُمُ","بالسّمهرِيّةِ دُونَ الوَخْزِ بالإبَرِ",140,"ر",1,0],["وأضلُعٌ نَحِلَتْ كادتْ تُقَوِّمُها","من الجوى كبِدي الحرّا من العِوَجِ",141,"ج",1,0],["وأَضاءَ الهواء فهو كبحرٍ","ماج في لج نوره الموّار",142,"ر",1,0],["وأضربت عن باقي اعتراضاتهم فما","لها قوة يأتي لها الرد مسلم",143,"م",1,0],["وأضاعوا فرصاً","ثم لاموا القدرا",144,"ر",2,0],["وأضعفن ما خلّصنه من قباقبٍ","فأضحى كأنّ الماء فيه عليل",145,"ل",1,0],["وأضىء على شط الحياة منارة","واطلع بكل دجية مصباحا",146,"ح",2,0],["واضطرب الحبل وما جت الزّمر","واقتحم الفتنة فابتل عمر",147,"ر",1,0],["وَأَضرَمَ في صَميمِ القَلبِ ناراً","كَضَربي بِالحُسامِ الهُندُواني",148,"ن",2,0],["وَأَضْحَتِ الأَرْضُ لِفَيْضِ الْحَيَا","مَصْقُولَةً يَلْهُو بِهَا النَّاظِرُ",149,"ر",1,0],["وَأَضَافَتِ الجُسْنَى إِلَى الحُسْنَى بِأَنْ","أَهْدَتْ إِلَيْهِ وِشَاحَ إِسْمَعِيلاَ",150,"ل",2,0],["وَأَضَاءَ فِي تلك السَّمَاءِ","عَلَى التَّعَاقُبِ كَوْكَبَانِ",151,"ن",1,0],["وَاضِحٌ عُذْرُكَ مَهْمَا تَفْتَنِنْ","لِلعَدُوّ الصُّلْبِ وَالخِدْنِ الرَّفِيقِ",152,"ق",1,0],["وَأَضْحَى ذَلِيلاً للنَّواظِرِ مَشْهَدٌ","رَأَتْهُ بِنُورِ الشُّهْبِ وهُوَ مَهِيبُ",153,"ب",1,0],["وأَضَاءَ الحَقُّ لِمُرسِيةٍ","لَمَّا أَورَت بك أَزْنُدُهُ",154,"د",2,0],["وَأَضْحَتْ مِنَ الْعِلْمِ في رَوْضَةٍ","وَمِنْ عِزَّةِ الْمُلْكِ في مَعْقِلِ",155,"ل",1,0],["وآضَ تَصفِيقُهُمْ نَوْحاً ومندَبةً","وأصبحَ البِشْرُ تقطيباً وتَغْصِينَا",156,"ن",2,0],["وأضاف ما بيديها من","أدب إلى أدبيهما",157,"م",2,0],["وأضِفْ إلى لام الوَغا ألفَ القَنا","تظهَرْ لديْكَ علامة ُ التَّغليب",158,"ب",1,0],["وأضمرتَ يا مولى الأئمَّة نصرَهُ","فملككَ بالنَّصرِ استقلَّت ركائبهُ",159,"ب",2,0],["وَأَضحى بِالعَواصِمِ مُستَقِرًّا","وَلَيسَ لِبَحرِ نائِلِهِ قَرارُ",160,"ر",1,0],["وَأَضَلّهُمْ رَأوُا القَبِيحَ جَمِيلا","سبحانَ قاتِلِ نَفْسِهِ فأَقُولا؟",161,"ل",2,0],["وَأَضَلّهُمْ رَأوُا القَبِيحَ جَمِيلا","لهُمُ رِباً وخيانَة ً وَغُلولا",161,"ل",2,0],["وأضعتُ أحلامي وشرخَ شبيبتي","وطَلاقتي فوجدتُهُنَّ جميعا",162,"ع",2,0],["وأضحى \" ثمودُ \" و\" لوطٌ \" به","ومَن لهما في الشرورِ انتمى",163,"ا",1,0],["وأضْفَتْ عليه الدروسُ الثِقالُ","لوناً من الأدب المُعْجِب",164,"ب",1,0],["وأَضُنُّها حِلاًّ لَهُ مِنْ فاقَةِ الْ","إِمْلاقِ إِذْ هِيَ لليَتِيمِ حَرامُ",165,"م",1,0],["وأَضْحوا وكانُوا لا يُنهْنِهُ شَغْبَهُمْ","إِذا قيلَكُفُّوا تَخمُّطِكُمْ كَفُّوا",166,"ف",3,0],["واضِحُ الوَجْهِ والفَعالِ، إذا ما","كَانََ وجْهُ الزّمَانِ جَهْاً بَهيما",167,"م",2,0],["وأضحى جنيبا للمطال، مجانبا","لناصحه في الغي، طوعاً لمن يدري",168,"د",3,0],["وَاضطِرَابي في النّاسِ، حتّى إذا عُدْ","تُ إلى حاجَةٍ، فأنتُمْ قُصَارِي",169,"ر",2,0],["وأضحت لهم سرقوسة ٌ دارَ منعة","ٍ يزورون بالديرين فيا النواوسا",170,"س",2,0],["وأضحى وأمس كل ما بين بَلْدحٍ","به حرماً حتى القفارُ البسابس",171,"س",1,0],["وأضرم الصيفُ الأجيجَ الصاخِدا","جاءَ الكِساء عند ذاك باردا",172,"د",2,0],["وَاضِحِ اللَّبَّة ِ والسُّنَّ","كالظبيِ الربيب",173,"ب",1,0],["وأضْلُعٌ نَحِلَتْ كادتْ تُقَوِّمُها،","مِنَ الجَوى ، كبِدي الحرّى ، مِنَ العَوَجِ",174,"ج",1,0]]}