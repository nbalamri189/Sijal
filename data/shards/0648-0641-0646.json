{"poems":[[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[31,"منعت النوم بالسهد","https://www.aldiwan.net/poem42566.html","مجزوء الوافر"],[50,"ذهب الدهر بسمط وبرا","https://www.aldiwan.net/poem64874.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[100,"بعد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=50191",""],[115,"لي في بوادي الرقمتين غزال","https://www.aldiwan.net/poem40621.html","عموديه"],[342,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[349,"مازال يخفيني الغرام بحبكم","https://www.aldiwan.net/poem15863.html","الكامل"],[361,"بنظمك هذا العلم زاد ابتهاجه","https://www.aldiwan.net/poem68127.html","الطويل"],[364,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[366,"جهادك حكم الله ليس بمصدود","https://www.aldiwan.net/poem17172.html","الطويل"],[416,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[479,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[500,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[538,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[558,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[558,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[558,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[575,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"]],"verses":[["وفَنَى كما يَفنى النَّشيدُ","الحلوُ في صَمْتِ الأَثيرْ",0,"ر",1,0],["وَفَنَّدَني الوُشاةُ بِها","وَما في ذاكَ مِن فَنَدِ",1,"د",1,0],["وَفَناءُ المَرءِ مِن آفاتِهِ","قَلَّ مَن يَسلَمُ مِن عِيِّ الفَنا",2,"ا",1,0],["وَفنوناً في روضها العين تَرعى","نرجساً أَو بنفسجاً مطلولا",3,"ل",2,0],["وَفَنّدَني في كُلِّ مَدحٍ أَحوكهُ","لِقَومٍ أسمّيهِم وَهُم عَربٌ نَبعا",4,"ع",2,0],["وفنونا ألذّ من بسمة الطفل","ومن نسمة الصباح العليلة",5,"ل",2,0],["وفنّ يضمّ هوانا ... كما","يضمّ السميرة أشهى سمير",6,"ر",1,0],["وفنيت اذ نار تأج باضلعي","والعين يدفق دمعها السيال",7,"ل",1,0],["وفنينا في دموع","فقرحنا ناظرينا",8,"ن",2,0],["وفنينا في رحيق ال","روح صرفاً فانتشينا",8,"ن",2,0],["وَفَنَيتُ حَتّى لَهُ تَصَوَّرَني الفَنا","لَم يَدرِ أَينَ أَنا وَفيهِ مُقامي",9,"ي",1,0],["وَفَنّ أَصول الدين عالَجت ضُعفُه","بِتَجريد مَعناه فَصح مَزاجَه",10,"ج",2,0],["وفِناء مَولانا المدى وخِطارُنا","من بعدِ نَيلِ المجدِ نُجحُ المَطْلب",11,"ب",1,0],["وَفَنَّدَني يَأسي وَشَجَّعَني المُنى","فَيا كِذبَ تَشجيعي وَيا صِدقَ تَفنيدي",12,"ي",1,0],["وفنون لشجون أطلَقَتْ","عَبرة الصّبّ من الوجد دما",13,"م",2,0],["وفند ما تقوله المناوي","بتحقيقات حبر ذي اقتدار",14,"ر",1,0],["وفنيتُ عني بالهيام لأجلكم","ونظام اشباحي نسيقُ خيالِ",15,"ل",1,0],["وفنونُ الهُتافِ من كلِّ صَوبٍ","شَقَّتَ أصداؤُها عِنانَ العَوالي",16,"ي",1,0],["وفُنونُ التَّطريبِ مِن كلِّ ضَربٍ","خافِتاً تارةً وطوراً جَهيرا",17,"ر",2,0],["وفنائي بأنني منه فعل","بي أشارت صفاته الأزليه",18,"ي",2,0],["وفنائي هو الرجوع لعلم","أزليٍّ في حضرة أبديه",18,"ي",2,0],["وفنيت حتى في وجودك بان لي","كيف التمسُّك منك بالحبل المتينْ",19,"ن",1,0],["وفنون التجليات علينا","كثرت والعيون عنها نيام",20,"م",1,0],["وفنيتُ من طرب وقد أَفْنى فَمِي","ريقاً له يَجْري عليه الرِّيقُ",21,"ق",1,0]]}