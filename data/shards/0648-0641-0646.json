{"poems":[[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[33,"منعت النوم بالسهد","https://www.aldiwan.net/poem42566.html","مجزوء الوافر"],[52,"ذهب الدهر بسمط وبرا","https://www.aldiwan.net/poem64874.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[102,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[102,"بعد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=50191",""],[119,"لي في بوادي الرقمتين غزال","https://www.aldiwan.net/poem40621.html","عموديه"],[347,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[354,"مازال يخفيني الغرام بحبكم","https://www.aldiwan.net/poem15863.html","الكامل"],[366,"بنظمك هذا العلم زاد ابتهاجه","https://www.aldiwan.net/poem68127.html","الطويل"],[369,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[371,"جهادك حكم الله ليس بمصدود","https://www.aldiwan.net/poem17172.html","الطويل"],[422,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[505,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[543,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[563,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[563,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[563,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[580,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48895","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112855","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49921","الخفيف"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95523","الطويل"],[1748,"","https://poetry.dctabudhabi.ae/diwan/poem/92978","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95276","الهزج"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28502","المتقارب"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100483","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204654","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199912","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100824","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111471","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83146","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141638","الخفيف"],[4691,"كل عام وأنتِ للعيد ِ عيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213049",""],[4816,"السيف والضيف والكيف","https://www.poetsgate.com/ViewPoem.aspx?id=199477",""],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""]],"verses":[["وفَنَى كما يَفنى النَّشيدُ","الحلوُ في صَمْتِ الأَثيرْ",0,"ر",1,0],["وَفَنَّدَني الوُشاةُ بِها","وَما في ذاكَ مِن فَنَدِ",1,"د",1,0],["وَفَناءُ المَرءِ مِن آفاتِهِ","قَلَّ مَن يَسلَمُ مِن عِيِّ الفَنا",2,"ا",1,0],["وَفنوناً في روضها العين تَرعى","نرجساً أَو بنفسجاً مطلولا",3,"ل",2,0],["وَفَنّدَني في كُلِّ مَدحٍ أَحوكهُ","لِقَومٍ أسمّيهِم وَهُم عَربٌ نَبعا",4,"ع",2,0],["وفنونا ألذّ من بسمة الطفل","ومن نسمة الصباح العليلة",5,"ل",2,0],["وفنّ يضمّ هوانا ... كما","يضمّ السميرة أشهى سمير",6,"ر",1,0],["وفنيت اذ نار تأج باضلعي","والعين يدفق دمعها السيال",7,"ل",1,0],["وفنينا في دموع","فقرحنا ناظرينا",8,"ن",2,0],["وفنينا في رحيق ال","روح صرفاً فانتشينا",8,"ن",2,0],["وَفَنَيتُ حَتّى لَهُ تَصَوَّرَني الفَنا","لَم يَدرِ أَينَ أَنا وَفيهِ مُقامي",9,"ي",1,0],["وَفَنّ أَصول الدين عالَجت ضُعفُه","بِتَجريد مَعناه فَصح مَزاجَه",10,"ج",2,0],["وفِناء مَولانا المدى وخِطارُنا","من بعدِ نَيلِ المجدِ نُجحُ المَطْلب",11,"ب",1,0],["وَفَنَّدَني يَأسي وَشَجَّعَني المُنى","فَيا كِذبَ تَشجيعي وَيا صِدقَ تَفنيدي",12,"د",2,0],["وفنون لشجون أطلَقَتْ","عَبرة الصّبّ من الوجد دما",13,"م",2,0],["وفند ما تقوله المناوي","بتحقيقات حبر ذي اقتدار",14,"ر",1,0],["وفنيتُ عني بالهيام لأجلكم","ونظام اشباحي نسيقُ خيالِ",15,"ل",1,0],["وفنونُ الهُتافِ من كلِّ صَوبٍ","شَقَّتَ أصداؤُها عِنانَ العَوالي",16,"ل",2,0],["وفُنونُ التَّطريبِ مِن كلِّ ضَربٍ","خافِتاً تارةً وطوراً جَهيرا",17,"ر",2,0],["وفنائي بأنني منه فعل","بي أشارت صفاته الأزليه",18,"ي",2,0],["وفنائي هو الرجوع لعلم","أزليٍّ في حضرة أبديه",18,"ي",2,0],["وفنيت حتى في وجودك بان لي","كيف التمسُّك منك بالحبل المتينْ",19,"ن",1,0],["وفنون التجليات علينا","كثرت والعيون عنها نيام",20,"م",1,0],["وفنيتُ من طرب وقد أَفْنى فَمِي","ريقاً له يَجْري عليه الرِّيقُ",21,"ق",1,0],["وفنُّكَ فنِّي واسمك اسمي ومن أتى","بآلك مصراً أمس جاء بآليا",22,"ي",2,0],["وفنوا وقد نالوا البقا وعلى الهدى","ورجوا وحفوا بالعطاء السرمدي",23,"د",2,0],["وفنُونٌ من الصنَّائع قامتْ","في النواحي لَه مقامَ الخطيبِ",24,"ب",1,0],["وفنون من البلاغة تعيي","بلغاء الجواب من كل ناد",25,"د",1,0],["وفنٌ يشيد الصرح كالبرج هائلاً","على ناطحات السحب حقاً يفاخرُ",26,"ر",1,0],["وَفِّني دَيني فما حَل","لَ لَكَ المَطلُ بِدَيني",27,"ي",1,0],["وفناء طورًا وطورًا بقاءُ","قد تلونتَ يا زمان علينا",28,"ا",1,0],["وفني من أكؤس الراح النصيب","وائتني تؤماً بها لا مفردا",29,"د",2,0],["وَفَنَى فيه فَنّي","وَقَد مُتُّ مِنَ الفَضلِ",30,"ل",1,0],["وَفَنٌّ مِنَ الوَجدِ ما أَستَعينُ","بِغَيرِكَ مِن جودِهِ مُسعَدا",31,"د",2,0],["وفُنُونَ الأسرارِ سلها جميعاً","وفنونَ الحديثِ والقرآنِ",32,"ن",1,0],["وفناءه الحصن المنيع وركنه","لي جنةً وعلى صفاه صفائي",33,"ي",1,0],["وفنك كيف سموه غناء","وما سموه بالسحر العجيب",34,"ب",1,0],["وفنٌّ أهوجٌ للغرب ينمى","يكاد يميتنا حسا وفكرا",35,"ر",2,0],["وفندت حكماً لو به الشم أنذرت","لخرت له تلك الشواهق خشعا",36,"ع",2,0],["وفَنَّدَ بالتفنيدِ كلَّ عضيهةٍ","وأَرتَقةٍ فَهوَ الكَمِيُّ المُكافحُ",37,"ح",1,0],["وفنيلاس انتضى السيف وخف","قطع الهامة في خوذتها",38,"ه",2,0],["وفِنكسٌ هُنا يَبِيتُ وإِمَّا","رامَ عَوداً مَعِي غَداً فَنِعِمَّا",39,"م",2,0],["وَفَناء النَفسِ فيمَن هَوِيَت","وَتَرى كُلَّ وُجودٍ في فَناها",40,"ا",3,0],["وفنون البديع من غير أكْل","تستشيط اللهى بها واللسان",41,"ن",1,0],["وفنونَ الجمال من وحْيِ أنثى","زانتِ الأرضَ فهي منها تميدُ",42,"د",1,0],["وفنجانها الثاني على الضيف نزييل","مواجب يسعد بها من زهمها",43,"م",3,0],["وفنجانها الثالث يلم المزاميل","كيف على خوة نجا ويحشمها",43,"م",3,0],["وفند ما تخرصه الأعادي","وألجم من أساء بك الظنونا",44,"ن",2,0],["وفناء يتغذى بالبقا","وحياة تتغذى بالممات",45,"ت",1,0],["وَفُنوني زينَتي إِن يَفخَروا","بِحَصى الدُّرِّ وَجَمعِ الذَّهَبِ",46,"ب",1,0]]}