dhabi.ae/diwan/poem/85845","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85622","المجتث"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2242","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[77,"سلوا عن فؤادي بعدكم كيف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=34157",""],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[105,"لهان على نعاتك أن نصابا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55035&r=&rc=205",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18438&r=&rc=10",""]],"verses":[["وَإِن نامَ لي في الجَفنِ إِنسانُ ناظِرٍ","تَيَقَّظَ عَنّي ناظِرٌ لِيَ في الجَفنِ",0,"ن",1,0],["وَإِن نازَعنا الحَقُّ","عِنانَ المالِ أَلقَينا",1,"ن",2,0],["وَأَنَّني بَقِيَّةُ البُزلِ الأُوَل","قَد يَجسُرُ العَودُ عَلى طولِ العَمَل",2,"ل",1,0],["وَإِن نُعرَةٌ يَوماً أَمالَت رُؤوسَها","أَقامَ عَلى نَهجِ الهُدى يَستَميلُها",3,"ل",3,0],["وَأَنَّني وارِدُ العِدِّ الَّذي وَرَدوا","بِالكُرهِ أَو قارِعُ البابِ الَّذي قَرَعوا",4,"ع",3,0],["وَإِن ناكَرَتني خَلَّةٌ مِن خِلالِهِ","تَعَرَّضَ قَلبي يَفتَديها مِنَ الحِقدِ",5,"د",1,0],["وَإِنَّني لِلشَقاءِ أَحسَبُني","أَلعَبُ بِالدَهرِ وَهُوَ يَلعَبُ بي",6,"ب",2,0],["وَإِن نودي بِهِ وَالحِلمُ يَهفو","صَغا كَرَماً إِلى الداعي وَفاءَ",7,"ا",2,0],["وَإِنْ نُشِرَتْ عَنْها صَحيفَةُ ناسِبٍ","رَأَيْتَ بُدوراً مِنْ جُدودي وَأَنْجُما",8,"م",2,0],["وإنْ نطَقوا قُلْتَ القَطا منْ قَبيلِهِمْ","وهُمْ غِلْمَةٌ منْ وُلْدِ نوحٍ قَبيلُها",9,"ل",3,0],["وإنْ ناوَلْتَهُم أطرافَ حَبْلٍ","وهَى فاهْجُرْهُمُ هَجْراً جَميلا",10,"ل",2,0],["وَإِن نامَ جَفني كانَ نَومي عُلالَةً","أَقولُ لَعَلَّ الطَيفَ يَأتي يُسَلِّمُ",11,"م",1,0],["وَإِنْ نَقَّلتْ عَنْكِ اللَّيَالِي رَكَائِبِي","فُؤَادِيَ شَيْءٌ لَيْسَ يَخْفَى انْتِقَالُهُ",12,"ل",2,0],["وإنْ نظَرَتَ الى لأْلاءِ غُرّتِهِ","يومَ الهِياجِ رأيْتَ الشّمْسَ في الأسَدِ",13,"د",1,0],["وَأَنَّ نُفوسَ هَذا الخَلقِ تَأبى","لِغَيرِ إِلَهِهاً ذُلَّ السُجودِ",14,"د",1,0],["وَإِن نادَيتَهُم لَبّاكَ مِنهُم","أَساطيلٌ وَأَسيافٌ تُسَلُّ",15,"ل",1,0],["وَأَنَّنا لَم نَصِل فيها إِلى مِئَةٍ","عَدّاً وَذاكَ لِعَيٍّ أَو لِنُقصانِ",16,"ن",1,0],["وَأَن نَتَلَقّى السُخطَ عانينَ بِالرِضى","لِغَيرانَ أَجفى ما يُرى حينَ يَلطُفُ",17,"ف",1,0],["وإنني أوثر لو في يدي","قاض من المصنوع في المولد",18,"د",1,0],["وَإِنْ نَبْغِ الْعَزَاءَ جلا أَمِينٌ","لَنَا الْفَرْعَ الزَّكِيَّ يُعِيدُ أَصْلَهْ",19,"ل",2,0],["وَأَنَّنِي أحصي الأُولَى جَادُوا لَهَا","لَسَرَدْتُ مَا وَسِعَتْ حُرُوفُ المُعْجَمِ",20,"م",1,0],["وَأَنَّنَا القَوْمُ نَسْتَبْقِي مَفَاخِرَنَا","حَتَّى تُوَاتِينَا الأَقْدَارُ مِنْ أمُمِ",21,"م",1,0],["وَأَنَّنَا أُمَّةٌ تَهْوَى مَوَاطِنَهَا","حَتَّى عَلَى الذِّكْرِ مِنْ عَادٍ وَمِنْ إِرَمِ",21,"م",1,0],["وَأَنَّنَا لَوْ تَآلَفْنَا لِمَا عَجِزَتْ","بِنَا النُّهَى عَنْ مَقَامٍ فِي العُلَى سَنِمِ",21,"م",1,0],["وَإِن نابَ شُغلٌ فَفي دونِ ما","تُدَبِّرُهُ شُغُلٌ شاغِلُ",22,"ل",1,0],["وَأَنَّنا قَد رَضَعنا الكَأسَ دِرَّتَها","وَالكَأسُ دِرَّتُها حَظٌّ مِنَ النَسَبِ",23,"ب",1,0],["وَإِن نَظَرَت إِلى شَبَحٍ أَمَجَّت","كَإِمجاجِ المُعَبَّدَةِ الشَرودِ",24,"د",1,0],["وإن نقص البازي رياش جناحه","يزيد استباقاً وهو للصيد خاتلُ",25,"ل",1,0],["وإن نضب الوادي وجف مَعينُهُ","فقد فاض بحر بالجواهر يقذف",26,"ف",1,0],["وإنن لم تنزجر زدناك طرداً","وصتنا عند طردك صوت نقر",27,"ر",1,0],["وإن نابني خطب ضممتك لاثماً","فقبّلت منك الصدر والنَحرَ والثغرا",28,"ر",2,0],["وإن نظرت بإمعان مساعيه","فقد نظرت بعيني رأسك الشرفا",29,"ف",2,0],["وأن نَزَلَت بالنَّاسِ عَميَاءُ لم يَكُن","لَهُم بَصَرٌ إلاَّ بِهِم حِينَ تُشكِلُ",30,"ل",1,0],["وَأَنَّني مَن صَفَت مِنهُ سَرائِرُهُ","وَصَحَّ باطِنُهُ مِنهُ وَظاهِرُهُ",31,"ر",2,0],["وَأَنَّني واصِلٌ مَن أَنتَ واصِلُهُ","وَأَنَّني هاجِرٌ مَن أَنتَ هاجِرُهُ",31,"ر",2,0],["وَإِن نابَ خَطبٌ أَو أَلَمَّت مُلِمَّةٌ","جَعَلتُ لَهُم نَفسي وَما مَلَكَت فِدا",32,"د",2,0],["وَإِن نَلقَ قَيسَ بنِ اِمرِئِ القَيسِ بَعدَهُ","نَزِد في سَوادِ وَجهِهِ لَونَ حالِكِ",33,"ك",1,0],["وَإِن نابَ أَمرٌ لَم يَقوموا بِحَملِهِ","فَمِن عِندِهِ تَيسيرُ ما يَتَشَدَّدُ",34,"د",1,0],["وَأَنَّنا يَومَ بِعنا اللَهَ أَنفُسَنا","لَم نُبدِ خَوفاً عَلى مالٍ وَلا وَلَدِ",35,"د",1,0],["وإن نظمت ريح الصبا عقد حزْنه","تناثر من سلك الجفون فريده",36,"د",2,0],["وأنَّ نماء الخلق والرزق لم يزل","إلى الشمسِ عن إذنٍ من الله راجع",37,"ع",1,0],["وإن نحسن الأمداح نظماً فإنها","على حسن السلطان مقبلة الحسن",38,"ن",1,0],["وإنَّ نِفاري منه وهو يُريغني","لَشيءٌ لرأي فيه غيرُ مناسبِ",39,"ب",1,0],["وإن نحن عبّرنا عن الحقِّ قصَّرَتْ","حُلُومُ أناسٍ عن مقامي وعن ذبّي",40,"ب",2,0],["وأنني عاتبتُ فيما جرى","عليَّ من ذاك فلم أُعتبِ",41,"ب",1,0],["وإن نحن أبرمنا القُوى من حِبالنا","أبى الوصلَ دهرٌ بالمحبين عابثُ",42,"ث",1,0],["وإنني تائبٌ إليك من ال","تخفيف توباً تصحُّ أسراره",43,"ر",2,0],["وإنني مستعير عرضَ عَمْرِهُمُ","شهراً من الحول كي يُقضَى به وطر",44,"ر",1,0],["وإن نَبلي متى هممتُ بأن","أرْميَ نصَّلْتُها بجمر غضا",45,"ض",2,0],["وإنني لأرجي منك تلبية","وذاك في قلب من يدعوك مقذوف",46,"ف",1,0],["وإنني خفت أن تصيبك بال","عين عيونٌ تقرطس الهدفا",47,"ف",2,0],["وإنني للذي غادرنه عُطُلاً","بغير لب وإن أحسنت أوصافا",48,"ف",2,0],["وإنني لبصير العين ثاقبها","أن لا نظير له في الناس يُؤتنف",49,"ف",1,0],["وإنني لَلضنين القبضتين به","ولَلضنين بقدري حين أُعتسف",49,"ف",1,0],["وإنني ملحق بها فِقَراً","سوابق الشعر من لواحقها",50,"ق",3,0],["وإنني مُسلفٌ إياكَ تهنئتي","وللصنائع تعجيلٌ وتأجيلُ",51,"ل",1,0],["وإنني منْ كسادهنَّ على","سِنّي لأولىَ بالخوفِ والوَجلِ",52,"ل",1,0],["وإنْ نَفَثْتَ إليّ السرَّ مؤتمناً","لم أفشِ سرَّك عن عمدٍ ولا زللِ",53,"ل",1,0],["وإنني لأرَجِّي أن يصبّحني","سعدُ السعودِ بحظ منه مُقتبلِ",53,"ل",1,0],["وإن نفاستي حظاً عليه","للؤمٌ في الخليقةِ بل سُفولُ",54,"ل",1,0],["وإنَّني حالفٌ فمجتهدٌ","مُنكِّبٌ عن سبيل من أثِما",55,"م",2,0],["وإنني يظْلِمُني","كلُّ امرىء يظلمُهُ",56,"م",2,0],["وإنني ما زلتُ مُسْتَحْسِناً","مَغْفِرتي مُسْتقبِحاً نَقْمي",57,"م",2,0],["وإنني ممن حماه حَرَمُهْ","وُهِّمَ جُرماً ليس مِثلي يَجْرمُهْ",58,"م",2,0],["وَإِن نَحنُ قُلنا مَن فَتىً عِندَ خُطَّةٍ","نُرامي بِهِ أَو دَفعِ داهِيَةٍ نُكرِ",59,"ر",1,0],["وَأَن نَكتَفي بِالأَرضِ نَسرَحُ فَوقَها","وَقَد مَلَكوا مِن فَوقِنا البَرق وَالرَعدا",60,"د",2,0],["وَأَن نَهتِفَ فَلنَهتِف مَعَ البُلبُلِ وَالقَمري","فَمَن يَعلَم بَعدَ اليَومِ ما يَحدُثُ أَو يَجري",61,"ي",1,0],["وَإِن نُكَلِّمُهُ لا يَفقَه مَقالَتَنا","إِلّا كَما يَفقَهُ التَسبيحُ سَكرانُ",62,"ن",1,0],["وَأَن نَبغُضَ البُغضَ لا تَبلى مَرائِرُهُ","وَلا يُقاسُ وَلا يُحصى بِميزانِ",63,"ن",1,0],["وَأَن نُرَدِّدَهُ في كُلِّ ناحِيَةٍ","وَأَن نُكَرِّرَهُ تَكريرَ أَلحانِ",63,"ن",1,0],["وَأَن نُعَلِّمَ مِنّا كُلَّ ذي كَبِدٍ","أَن يَبغُضَ القَومَ في سِرٍّ وَإِعلانِ",63,"ن",1,0],["وَإِن نَفَثَت في الطِرسِ مِنهُ يَراعُهُ","رَأَيتَ عَصى موسى غَدَت وَهيَ ثُعبانُ",64,"ن",1,0],["وَإِنَّ نِساءَ الحَيِّ لَمّا رَمَينَني","أَصَبنَ الشَوى مِنّي وَصِدنَ فُؤادِيا",65,"ي",2,0],["وإن نطقت بصدق","قامت عليَّ القيامه",66,"م",2,0],["وإن نقلنا لبقعة قدما","فللهوى لا البقعة النقل",67,"ل",1,0],["وأن نصون الحق عن معشر","قد كتموا الحق وظنوا اكتتام",68,"م",1,0],["وإن نهضت للمشي ودَّ قوامها","نساء طوال حولها وقصار",69,"ر",1,0],["وَإِنَّني إِذا دَعَوتُ الذيبا","لا يَستَطيعانِ لَهُ تَكذيبا",70,"ب",2,0],["وَإِنَّني وَإِن أَسَأتُ السَيرا","عَمِلتُ شَرّاً وَعَملتُ خَيرا",71,"ر",2,0],["وَأَنَّ نَبِيَّهُمُ واحِدٌ","نَبِيُّ الصَوابِ نَبِيُّ اللَسَن",72,"ن",1,0],["وَأَنَّ نِزاعَ الرُشدِ وَالغَيِّ حالَةٌ","تَجيءُ بِأَحلامِ الرِجالِ وَتَرجِعُ",73,"ع",1,0],["وَإِن نَبَغتُم فَفي عِلمٍ وَفي أَدَبٍ","وَفي صِناعاتِ عَصرٍ ناسُهُ صُنُعُ",74,"ع",1,0],["وَإِن نَقَعَ الصَريخُ إِلى مَكانٍ","نَصَبنَ لَهُ مُؤَلَّلَةً دِقاقا",75,"ق",2,0],["وَأَنَّني غَيرُ مُحصٍ فَضلَ والِدِهِ","وَنائِلٌ دونَ نَيلي وَصفَهُ زُحَلا",76,"ل",2,0],["وَإِنَّ نُفوساً أَمَّمَتكَ مَنيعَةٌ","وَإِنَّ دِماءً أَمَّلَتكَ حَرامُ",77,"م",1,0],["وإِن نظرتُ من الدنيا إِلى حَسَنٍ","مُذْ بِنْتَ عنِّي فلا مُتِّعْتُ بالنَّظَرِ",78,"ر",1,0],["وإنْ نَبا الجَدُّ فكلُّ الذي","تأمُلُ من رِبْحٍ إِلى خُسْرِ",79,"ر",1,0],["وَإِن نَقتَصِر مِنهُ عَلى وَصفِ جُملَةٍ","تَدُلُّ عَلى التَفصيلِ نَعمَل بِواجِبِ",80,"ب",1,0],["وَإِن نَزَلوا في النَسبِ مِن بَعدِ هاشِمِ","بِبَطنٍ عَلَوا في المَجدِ أَعلى المَراتِبِ",80,"ب",1,0],["وَإِن نَحنُ عُدنا عاوَدَتنا سَماؤُهُ","بِأَحمَدَ مِن جَدواهُ أَوَّلَ أَوَّلِ",81,"ل",1,0],["وَإِن نَزَلنا حَريمَهُ فَلَنا","هُناكَ أَمنُ الحَمامِ في حَرَمِه",82,"م",2,0],["وَإِن نَفَرَ الأَحياءُ يَومَ عَظيمَةٍ","تَحاقَرَ في حَيَّي تَميمٍ نُفورُها",83,"ر",3,0],["وَإِن نَقِدَت يَداهُ فَزَلَّ عَنها","أَطافَ بِهِ عَطِيَّةُ فَاِستَدارا",84,"ر",2,1],["وَإِن نَبَّهَتهُنَّ الوَلائِدُ بَعدَما","تَصَعَّدَ يَومُ الصَيفِ أَو كادَ يَنصِفُ",85,"ف",1,0],["وَإِن نَكَثوا يَوماً ضَرَبنا رِقابَهُم","عَلى الدينِ حَتّى يُقبِلَ المُتَأَلَّفُ",86,"ف",1,0],["وَإِن نَكَثَ الأَوتارُ حَبلاً لَمَعشَرٍ","أَقَمنا عَلَيهِ غَيرَ مُنتَكِثي الحَبلِ",87,"ل",1,0],["وَإِن ناءَت بِيَ العُدواءُ عَنهُ","فَلَم أَشهَد مُقاسَمَةً كَفاني",88,"ي",1,0],["وَإِنَّ نَعيمَها يَفنى","فَتَركُ نَعيمِها أَحزَم",89,"م",1,0],["وَإِن نالَهُم رِفدي فَلا شُكرَ عِندَهُم","وَإِن أَنا لَم أَبذُل لَهُم شَتَموني",90,"ن",2,0],["وَإِن نَحنُ لَم نَبغِ مَعروفَهُ","فَمَعروفُهُ أَبَداً يَبتَغينا",91,"ن",2,0],["وإن نسيت تلك الخلال خواطري","فلا دار لي ما بين أهل النهى ذكر",92,"ر",1,0],["وَإِنَّني سَوفَ أَسلوهُم إِذا عُدِمَت","روحي وَأَحيَيتُ بَعدَ المَوتِ وَالعَدَمِ",93,"م",1,0],["وَإِن نَأَت صارِمَةً حَبلَها","بادِر إِلى اللَذّاتِ وَاِركَب لَها",94,"ه",2,0],["وَإِن نَظَروا يَوماً لَبيباً مُداوِياً","بِها الهَمَّ قالوا باخِلاً مُتَطَبِّبا",95,"ب",2,0],["وَإِنَّ نَوالي في المُلِمّاتِ واصِلٌ","أَباعِدَ أَهلِ الحَيِّ قَبلَ الأَقارِبِ",96,"ب",1,0],["وإِن نَنظمِ الدرّ الَّذي أنت بحرُهُ","ففضلُكَ ألقاهُ لنا في السواحِلِ",97,"ل",1,0],["وإن نالَ منها ذو الكآبةِ شربةً","تسرّبتِ الأرواح منها إلى القلبِ",98,"ب",1,0],["وَإِن نَفسُ اِمرِئٍ دَقَّت رَأَينا","بِعَرصَةِ جودِهِ كَرَماً جُلالا",99,"ل",2,0],["وإنني لَوْ شرعتُ أَحْمَدُها","أضحكَهُ أنني لها حامدْ",100,"د",1,0],["وأنَّنا حين يُروي الناسَ نبعُهمُ","نُروى بنبعِ هُمومٍ فُجّرتْ فينا",101,"ن",2,0],["وأنَّنا نحسبُ الخالينَ من ألمٍ","غَرثى عفاةً وإن كانوا قوارينا",101,"ن",2,0],["وَأَن نَرعى الأَمانَةَ ما نَأَينا","وَنُعمِلُ في تَجاوُرِنا الرَسولا",102,"ل",2,0],["وَإِن نَأى بِكِ رَبعٌ غَيرُ مُقتَرِبٍ","أَوِ اِحتَواكِ حِجابٌ فيهِ يُقصيكِ",103,"ك",1,0],["وإن نقد الناس الرجال بمشهد","فلا تنطق العوراء تحسبها نقدا",104,"د",2,0],["وإن نَقَموا المشاربَ سائغاتٍ","رضوا بالصَّابِ من يده شرابا",105,"ب",2,0],["وَأَنَّنا أُمَمٌ فَوضى مُضَلَّلَةٌ","تَظَلُّ في غَمَراتِ الجَهلِ تَضطَرِبُ",106,"ب",1,0],["وإنّ نِساءَ الرُّومِ يَغْلِبْنَنِي على","عَفافِي فَدَعْنِي ما لهنّ ومالِيهْ",107,"ي",2,0],["وإن نَهلتْ سيوفُ القومِ منَّا","فلا تتزحزحوا فإذا أذنَّا",108,"ن",2,0],["وَإِن نَهَضَت بَعدَ القُعُودِ فَلَم تَقُم","مَعَ الجَهدِ إِلّا بَعدَ طُولِ التَجَشُّمِ",109,"م",1,0],["وَإِن نَظَرَت يَوماً بِمُؤخَرِ عَينِها","إِلى عَلَمٍ بِالغَورِ قالَت لَهُ اِبعَدِ",110,"د",1,0],["وَإِنَّني مُقفَلُ الضَمائِرِ مِن","حُبِّ سِواهُم ما حَنَّتِ الإِبلُ",111,"ل",1,0],["وَإِن نَغَّصَ بَعضَ الطي","بِ أَصحابُ المَناديلِ",112,"ل",1,0],["وَإِنَّني في الصَلاةِ أَحضُرُها","ضُحكَةُ أَهلِ الصَلاةِ إِن شَهِدوا",113,"د",3,1],["وَإِن نُسرِع بِمَرحَمَةٍ لِقَومٍ","فَلَسنا بِالسِراعِ إِلى العِقابِ",114,"ب",1,0],["وَإِن نالَ مِنّي الشَوقُ واجَهتُ بابَها","بِإِنسانِ عَينٍ ما يُفيقُ مِنَ السَكبِ",115,"ب",1,0],["وَإِن نُعطَ الإِناثَ فَأَيُّ بُؤسٍ","تَبَيَّنَ في وجوهِ مُقَسَّماتِ",116,"ت",1,0],["وَإِن نِلتَ في دُنياكَ لِلجِسمِ نِعمَةً","مِنَ العَيشِ فَاِذكُر دَفنَهُ وَبِلاهُ",117,"ل",3,0],["وإن نَهَضَتْ من مطمَئنّ ظنَنْتَه","يَجيشُ جِبالاً أو يَمُجّ حِرارا",118,"ر",2,0],["وَإِن ناصِحٌ مِنكَ يَوماً دَنا","فَلا تَنأَ عَنهُ وَلا تُقصِهِ",119,"ص",2,0],["وَإنْ نَبا بِيَ في ساحاتِهمْ وطنٌ","فَالأرضُ واسعةٌ والنَّاسُ أَفْراقُ",120,"ق",1,0],["وأن نصيب الملحدين للذة","وأن نصيب المؤمنين لحرمان",121,"ن",1,0],["وان نطقت بكذب","قالوا أتيت صوابا",122,"ب",2,0],["وإنني الصَّخر الذي","أردتِ أن لا يُغلَبا",123,"ب",2,0],["وإنْ نَقصتَ منه بعد الشّطرِ","جُزءاً صحيحاً من أَخيرِ الصَّدرِ",124,"ر",1,0],["وَإِنْ نَحْنُ عُدْنَا بِالْعَشِيِّ أَضَافَنَا","إِلَيْهِ سَدِيلٌ مِنْ نَقاً مُتَقَابِلِ",125,"ل",1,0],["وَإِنْ نَظَمَ الْعِرَابَ مِنَ الْقَوَافِي","أَبَتْ فِي النَّابِغِينَ لَهُ قَرِيعَا",126,"ع",2,0],["وَأَنَّ نُفُوساً كَتِلْكَ النَُفُوسِ","لَهَا رَجْعَةٌ فِي بَنِيهَا غَدَا",127,"د",2,0],["وَإِن نُعطَ لا نَجهَل وَلا نَنطُقُ الخَنا","وَنَجزِ القُروضَ أَهلَها ثُمَّ نَقصِدِ",128,"د",1,0],["وإن نَضَبَتْ أنهارُها فَبحَسْبِهَا","من الدِّين نَهر للهُدَى ليس ينضُبُ",129,"ب",1,0],["وإن نقلت عنك الليالي ركائبي","فؤادي فشيء ليس يخفى انتقاله",130,"ل",2,0],["وإنْ نابَ أمرٌ لَم يقوموا بِحمدهِ","فمنْ عندهِ تيسيرُ ما يتشددُ",131,"د",1,0],["وأننا ناسٌ أباةٌ متى","نُرهق فمضطرُّون لا مُرتَضون",132,"ن",1,0],["وأننا بالرُغم من صبرِنا","إن حانت الفرصةُ مستغنِمون",132,"ن",1,0],["وأنَّ نَتاجَ الرفهِ أعْجَفُ خاملٌ","وأنَّ نَتاجَ البُؤسِ ريّانُ زاهر",133,"ر",1,0],["وان نَكِرتُ عليكم سيرَ متَّئدٍ","وان طَلَبتُ اليكم سيرَ عَجلان",134,"ن",1,0],["وانني إنْ رَمَتْني أعينٌ خُزُرٌ","فانَّ أعينَكُم باللطفِ تَرعاني",134,"ن",2,0],["وأنْ نَنْشُدَ الاخلاصَ في تضحياتهِ","ونحنُ تركناهُ ضحيَّةَ غاشم",135,"م",1,0],["وأنْ نبتغي رِكضاً حَثيثاً لِغايةٍ","نُحاوِلُها مِن راسِفٍ في أداهم",135,"م",1,0],["وإن نقموا المشارب سائغات","رضوا بالصاب من يده شرا",136,"ر",2,0],["وإنّ نَمَاءَهُمْ لكُمُ نَمَاءُ","على الأَيَّامِ إن نَفَعَ البَلاءُ",137,"ا",1,0]]}