{"poems":[[110,"تأبط شرا","https://www.shoaraa.com/p12775",""],[55,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[54,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[119,"سارت تزمزم للحمى الركبان","https://www.aldiwan.net/poem40480.html","عموديه"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[164,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[202,"حدائق الحسن تغري السهد بالحدق","https://www.aldiwan.net/poem51912.html","البسيط"],[242,"قصدنا ابن داود ذا المعلوات","https://www.aldiwan.net/poem19065.html","المتقارب"],[242,"فرجت من همي ومن بوسي","https://www.aldiwan.net/poem19716.html","الكامل"],[325,"أتترك لذة الصهباء عمدا","https://www.aldiwan.net/poem67090.html","الوافر"],[358,"أنت هام العز للرتب","https://www.aldiwan.net/poem40773.html","المديد"],[366,"حماك قد غردت فيه المسرات","https://www.aldiwan.net/poem68129.html","البسيط"],[505,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[505,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[543,"إذا كان هذا كذا فبما","https://www.aldiwan.net/poem47460.html","عموديه"],[563,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[563,"أنت هو الملفوظ واللافظ","https://www.aldiwan.net/poem34401.html","السريع"],[563,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[592,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87266","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87139","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87103","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38974","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49920","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130785",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89072","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86309","الطويل"],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132018","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114068","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44683","البسيط"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126337","السريع"],[4261,"","https://poetry.dctabudhabi.ae/diwan/poem/124285","الطويل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116079","الخفيف"],[4788,"وجدي على الراحه وجود ام الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=132265",""],[4796,"معزوفة لها","https://www.poetsgate.com/ViewPoem.aspx?id=180984",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5732,"يضوي ويسري","https://www.poetsgate.com/ViewPoem.aspx?id=177920",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""]],"verses":[["وإلا وقد سد الذرائع ليته","نفى عنه أصل الحالتين ليسلما",0,"م",2,0],["وَالأولى شَقَّقوا ثَراكِ مِن العُش","بِ وَأَجروا خِلالَكِ الأَنهارا",1,"ر",2,0],["وَإِلّا وَعيدٌ لا يَسيرُ بِجُندِهِ","وَحَيّاتُ ضِغنٍ في مَكامِنِها رُقطُ",2,"ط",1,0],["وَالأولَى أَفْنوا العَزَائِمَ فِي رَبْطِ","الأَوَاخِي وَفِي التِمَاسِ الوِفَاقِ",3,"ق",1,0],["وَالأولى زالتْ مَغانِيهِمْ بِمَا","شِيدَ لِلأَلْعَابِ مَحْبُورُونَ حَبْرَا",4,"ر",2,0],["والاولياء الصالحون ومن لهم","من سر قربك يا مهيمن شان",5,"ن",1,0],["والأوحد السباق غير مدافع","في حلبة المفروض والمسنون",6,"ن",1,0],["والأولياء يؤاخذون بدون ذا","لو شاء ربي كان ذاك الفدية",7,"ه",1,0],["والأوسُ في فَلَوَاتِ البيدِ مفترسٌ","فإنْ يَصُلْ ليثُ غابٍ مات من فرق",8,"ق",1,0],["وَإِلاَّ وَحَاشَاهُ مِنْ سَنَدٍ","عَلِمْنَا بِأَنَّ الدَّخِيلَ دَخِيلْ",9,"ل",1,0],["وَالأَوَّلُ الْمُسْدِي كَحِبْوَتِهِ","فِيمَا يُرَى أَحْلَى الْقَوَامِيسِ",10,"س",1,0],["وَإِلّا واثِقَ مِن غَيرِ شَكٍّ","بِما وَعَدوكَ مِن وَخَمرِ",11,"ر",1,0],["وَالأولي ذاعَت مَحامدهم","بِلسان التُرك وَالعَرَبِ",12,"ب",1,0],["وَالاِولِياء كَثير غَير أَنَّهُم","في رُتبَة العَبد وَالسادات سادات",13,"ت",1,0],["والأولياء انزلوا","ببابهم آمالهم",14,"م",1,0],["والأَولِياءُ وإنْ جلَّتْ مَراتِبُهُمْ","لاذَ الأَكابِرُ منهُمْ في أَصاغِرِنَا",15,"ن",2,0],["وإلا وأنتَ لنا حَكَمٌ","فماذا سيَحسِمُ هذا المِرَا",16,"ر",2,0],["والأوليا الأخيارْ","فيهم يطول الذيلْ",17,"ل",1,0],["والأوليا والأنبيا كلهم","والحيّ في تحقيقه الفائظ",18,"ظ",1,0],["والأول الله لا ثان له أزلاً","والآخر الله لا تبقى له أخر",19,"ر",1,0],["والآ والصحب ثم التابعين لهم","ما انهل ودق وما بالرق مرقوم",20,"م",1,0],["وَالأَورباويون قالوا بِنَجدٍ","لَيتَنا لَم نَزَل بِها نُزَلاه",21,"ا",2,0],["وَالأوجيان عَلى الفَضا","وَثَباتها مِثل القَضا",22,"ض",2,0],["وَالأوجيان عَلى الثَرى وَثَباتُهم","وَثَباتُهم في الحَرب مَشهوران",23,"ن",1,0],["وَالأوجيان كَأَنَّهُم مِن خفةٍ","طيرٌ عَلى رَأس المنافق حائم",24,"م",1,0],["وَالأَولِيا وَالصّالحينْ","عَجِّلْ بِنَصرِ المُؤمنين",25,"ن",1,0],["والأول الأصح إذ","بالفَرج نال الأرَبا",26,"ب",2,0],["والأول المرضيّ وهو المذهب","وقل من لفعلات يذهب",27,"ب",1,0],["والأوسُ والخزرجُ الأنصارُ قد دَفعوا","عن الرَّسولِ وآووْهُ لدَيَ الهَربِ",28,"ب",1,0],["والأولُ المدعُوُّ تركِيبُ امتِزَا","جٍ وَاختِلاَطٍ وَهوَ ذُو تِبيَانِ",29,"ن",1,0],["وَالأوسَطَانِ هُمَا اللَّذَانِ تَنَازَعَا ال","عُقَلاَءَ فِي تَركِيبِ ذي الجُثمَانِ",29,"ن",1,0],["وَالأوَّلُ التَّنزِيهُ لِلرَّحمَنِ عَن","وَصفِ العُيُوبِ وَكُلِّ ذِي نُقصَانِ",29,"ن",1,0],["والأول المعهود من وضع الخطا","ب فلا تحدن عن ظاهر القرآن",29,"ن",1,0],["والأوزاعيّ فهو له بشرع ال","نبيّ المصطفى أوفى اتّصال",30,"ل",1,0],["والأول اختص بثاني السبب","مزدوجاً أو مفرداً في الأقرب",31,"ب",1,0],["وَالأولَينِ قِس ما اعتدَلُوا","أعني أوالي النعشِ يا ذا الرجلُ",32,"ل",1,0],["والأوسطان قياسُهُنَّ تِسعَه","عندَ السِّماكِ بعدَ ذا خُذ نَفعَه",33,"ه",1,0],["والأولى في الهوى تمادوا وصموا","عن نداء الهدى ضلالاً ووقراً",34,"ر",2,0],["والاولى سطروا المعارف واستج","لوا خفايا الورى فزال الخفاء",35,"ا",2,0],["والأولى في عصبة رد الجميع له","وان ترد جبر قلب بالقيام قم",36,"م",1,0],["والاولياء حيهم والميت","كذا على اقطاب اهل البيت",37,"ت",1,0],["والأوّل الموضوع في الحمليّه","والآخر المحمول بالسويّه",38,"ه",1,0],["وإلا وفى داعي البشائر بالمنى","فيا حسنَ ما أملى علينا وما أوردْ",39,"د",1,0],["والاَّ وميضاً من ظبىً وأَسِنَّةٍ","لها غَرضٌ في نفعِهِ وألِيلُ",40,"ل",1,0],["وَاِلّا وَميضُ الصاعِقات بِبَأسه","يَشق الفلا لا عَن جواد وَلا مهر",41,"ر",1,0],["والأولان إن نظرت رتبا","على نظام الموضعيين في النبا",42,"ب",2,0],["والأوس تستبق الخطى للقائه","والخزرج انسابت له تنسم",43,"م",1,0],["والأولى بشّروا بأن لهم في","جنّة الخلد مستقرّاً ودارا",44,"ر",2,0],["والاول الشرطي والحملُّي","والحكم في ثانيهما جلي",45,"ي",1,0],["وَإِلاَّ وُقِيتُم فَاللِّجَامُ لِكَاتِمٍ","مُعَدٌّ وحَقُّ اللهِ أدعَى لِرَاغِبِ",46,"ب",1,0],["وَإِلاَّ وَعَنِّي الحِمَامُ مُنِع","لَعَانَيتُ آلامَ مَن قَد صُرِع",47,"ع",1,0],["وإلا وبهم العدى صرعوني","وجندلت في وجه هذي السفين",48,"ن",1,0],["وَالأَوصياءُ غَدوا مِثل الأَفاعي إِذا","عَضَّت بِأَنيابها مَن رامَ يَقضيها",49,"ي",3,0],["والأوَّل الاولى بغنمٍ لما","في سعيهِ من شامل المغنمِ",50,"م",1,0],["والأول في أيامه يحسن الصبا","والآخر في أيامه يقبح اللعب",51,"ب",1,0],["والأوليا ذوو كرامات رتب","منكرها له التواني والتبب",52,"ب",1,0],["والأولياء رتب لهم قد خصصوا","بكرامةٍ وعنايةٍ وبيان",53,"ن",1,0],["والأولياء كلهم نؤمن بعصمتهم","كذا بتنزيههم عن وصمةِ القذرِ",54,"ر",1,0],["والأُولى لا تقرُّ منهم جُنوبٌ","في الدَّياجِي ولا تنامُ عيونُ",55,"ن",1,0],["وإلا وجود ٍ ب/القصايد م إنذكر","ولا فيه نفس ٍ يطرقه وجّادها",56,"د",3,0],["والأوفَ واللَّيا وياليلي ويا","عيني ودَلَّ الدَّلّعَوا بالدَّلعَنا",57,"ن",2,0],["وَآلاؤُهُ لَا يُدركِ العَدُّ حَصْرَهَا","وَلَيسَ بِها قُلٌّ أَلا كُلُّهَا جَزْلُ",58,"ل",1,0],["وَالأَوَّلِ الْمُنْجِي الصَّفِيِّ الْمُنْتَجَىٰ","وَالآخِرِ الْمَاحِي لِكُفْرِ مَرِيدِ(١١)",59,"د",1,0],["والأولياء فلم يجعل ذواتهمو","بين البرية أعني الشيخ أوثانا",60,"ن",2,0],["والا وقفك العنيد اشمط الشيب","اللي إلى جا الليل يسري لحاله",61,"ل",2,0],["والأولياء كقطرة من غيثهم","فاعرف بقدر الأنبياء الأعيان",62,"ن",1,0],["والأوصف الدرّاكُ إذْ سُعِّرتْ","نار الوغى والزجل والضرب",63,"ب",1,0],["والأول القدم اللاهوت باطنه","غيب وظاهره رشد لذي رشد",64,"د",1,0],["والأولي أبعدوا تولوا وراحوا","ليس منهم من زارنا ثم باحا",65,"ح",2,0]]}