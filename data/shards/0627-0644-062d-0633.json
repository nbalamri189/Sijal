gate.com/ViewPoem.aspx?id=199605",""],[5413,"الشِّعْرُ يَرْقُصُ","https://www.poetsgate.com/ViewPoem.aspx?id=200601",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5626,"اربأ بنفسك","https://www.poetsgate.com/ViewPoem.aspx?id=189715",""],[5628,"طقوس صامتة","https://www.poetsgate.com/ViewPoem.aspx?id=178474",""],[5628,"في محراب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=178542",""],[5720,"المتْرفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205536",""],[402,"شارفت مصر وفيها كل ناضرة","https://www.poetsgate.com/ViewPoem.aspx?id=36822",""],[5853,"مولد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=175678",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5956,"هذي الأنوثة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182150",""],[5956,"حيويتان متبادَلتان ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182266",""],[5956,"الحِسُّ يغمر كل شيئٍ","https://www.poetsgate.com/ViewPoem.aspx?id=184785",""],[5956,"الحِسّ الحيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=192121",""],[5956,"الاصطباح بالأفراح","https://www.poetsgate.com/ViewPoem.aspx?id=193167",""],[5956,"الحُسْن الذهبيُّ النادرْ","https://www.poetsgate.com/ViewPoem.aspx?id=202752",""],[5956,"لبيكِ يا خطيبتي ثم قرينتي رفاه","https://www.poetsgate.com/ViewPoem.aspx?id=208836",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[5957,"ولولا الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=22604",""],[6038,"يا رب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=25684",""],[161,"السُّكَّرُ والسُّكَّرِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=157685",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6075,"( الحسن توجها )","https://www.poetsgate.com/ViewPoem.aspx?id=195130",""],[6093,"أصورَ الجَرْحَ في القرطاسْ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=183886",""],[6093,"حلوية عربية","https://www.poetsgate.com/ViewPoem.aspx?id=215567",""],[2575,"روضة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=10282",""],[6353,"بطاقة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64726&r=&rc=147",""]],"verses":[["الحُسنُ مِنكِ سَجِيَّةٌ مَطبوعَةٌ","وَمِنَ النِساءِ تَخَلُّقٌ وَتَصَنُّعُ",0,"ع",1,0],["الحُسْنُ يَجْلُو الخَبَايَا مِنْ سَرَائِرِهَا","وَالطهرُ يسْطَعُ نُوراً مِنْ مُحيَّاهَا",1,"ا",3,0],["الحُسْنَيَانِ سَلامَةٌ وَكَرَامَةٌ","وَالسَّوءيَانِ خَصَاصَةٌ وَسَقَامُ",2,"م",1,1],["الحسن يفتن والألحاظ فاتكة","واحيرتي بين فتّان وفتّاك",3,"ك",1,0],["الحسنِ المحسنِ في فعله","أنفِسْ به من عُقدةٍ أنفس",4,"س",1,0],["الحسنُ المحْسِنُ المحسَّنُ أخ","لاقاً وخَلْقاً برغم مَنْ رَغما",5,"م",2,0],["الحُسنُ حَولَك في الوِهاد وَفي الذُرى","فَاِنظُر أَلَستَ تَرى الجَمالَ كَما أَرى",6,"ر",2,1],["الحِسُّ مَجلَبَةُ الكَآبَةِ وَالأَسى","قُم نَنطَلِق مِن عالَمِ",7,"م",1,0],["الحسن تسمعه كالحسن تبصره","ما عنهما من غنى يأتي به السأم",8,"م",1,0],["الحُسنُ حَلَفتُ بِيوسُفِهِ","وَالسورَةِ إِنَّكَ مُفرَدُهُ",9,"د",2,0],["الحُسنُ لَفظٌ في المَدائِنِ كُلِّها","وَوَجَدتُهُ لَفظاً وَمَعنىً فيكِ",10,"ك",1,0],["الحُسنُ يَرحَلُ كُلَّما رَحَلوا","مَعَهُم وَيَنزِلُ حَيثُما نَزَلوا",11,"ل",3,0],["الحسنُ عندَكِ لحنٌ والبيانُ له","لحن يهدهده والحسن أنغام",12,"م",1,0],["الحسن من حق الورى وحملتِه","مستخفيا متأبيا ممنوعا",13,"ع",2,0],["الحُسنُ جُزءٌ مِن وَجهِكَ الحَسَنِ","يا قَمَراً موفِياً عَلى غُصُنِ",14,"ن",1,1],["الحُسنُ وَالطيبُ إِذا اِستُجمِعا","عَبدانِ عِندي لِأَبي عَبدِ",15,"د",1,0],["الحُسنُ مِنهُ عَلى ما كُنتُ أَعهَدُهُ","وَالشِعرُ حِرزٌ لَهُ مِمَّن يُطالِبُهُ",16,"ب",2,0],["الحَسَنُ بنُ وَهبٍ","كَالغَيثِ في اِنسِكابِه",17,"ب",2,1],["أَلِحُسنِ مَنزِلَتي تُؤَخِّرُ حاجَتي","أَم لَيسَ عِندَكَ لي بِخَيرٍ مَطمَعُ",18,"ع",1,0],["الحُسنُ في كُلِّ جُزءٍ","مِنها مُعادٌ مُرَدَّد",19,"د",1,0],["ألحُسْنُ يَعْلَمُ أنّ مَنْ وارَيْتَهُ","قَمَرٌ تَسَتّرَ في غَمامٍ أبْيَضِ",20,"ض",1,1],["أَلَحُسْنِ وَالإِحْسَانُ يَقْ","تَسِمَانِهَا أَبْهَى اقْتِسَامِ",21,"م",1,0],["الحسنُ معنى قد جهلنا كنهَه","فتحدثي عن سره المستور",22,"ر",1,0],["الحُسنُ فيه بكلِّ شيءٍ ماثلٌ","حتى الصُّخورِ الصُّمِّ، والأحجار",23,"ر",1,0],["الحسن في سنَة من نومه، فإِذا","حلَّ الربيع فإِنَّ الحسن يقظان",24,"ن",1,0],["الحسنُ وهْو مقنَّعٌ","كالبدر آخرَ شهره",25,"ر",2,0],["الحسنُ خمرُ الرُّوح فام","لأ، واسقني من خمره",25,"ر",2,0],["الحسن يظهر في بيتين رونقه","بيتٌ من الشعرِ أو بيتٌ من الشعَر",26,"ر",1,0],["الحسن في الشط نار","قبستها فاحترقت",27,"ت",1,0],["الحسن عاد فكن يا قلب في طرب","وأوح إن شئت ألطاف الأناشيد",28,"د",1,0],["الحسنُ صنع يديك","أبدعته أنتَ",29,"ت",1,0],["الحسن بين يديك","إليك أمري إليك",30,"ك",1,0],["الحسنُ عندك وحدك","والحب عندي وحدي",31,"ي",1,0],["الْحُسْنُ فِيكَ قَدِ اكْتَمَلْ","لَوْ كُنْتَ تُوصَفُ بِالْخَجَلْ",32,"ل",1,1],["الحسن الاسم والأفعال","للجازم والضامر",33,"ر",1,0],["الحسنُ سلطانٌ وأنتِ مليكةٌ","فاقت بملكِ الحبِّ ربَّةَ تَدمر",34,"ر",1,0],["الحسنُ فانٍ والهوى باقٍ فلا","ترضي بما يَزهُو ويُرضي حينا",35,"ن",2,0],["الحُسنيانِ وقد علِمتم نصرةٌ","وشهادَةٌ فالمؤمِنُ المِقدام",36,"م",1,0],["الحسنُ ناسقَ والإحسانُ وافقَ وال","إِفضال طابقَ ما بين اِنتظامهمِ",37,"م",1,0],["الحسن يُروى عَن أَبيهِ بِها","فَهوَ لَدَينا القَمَر المبدرُ",38,"ر",1,0],["الحُسنُ فيهِ مُخاصِمي","وَيَعَزُّني عِندَ الخِصامِ",39,"م",1,0],["الحُسنُ جادَ عَلى الأَحبابِ فَاِزدادوا","لَكِنَّ أَحبابَنا في الحُسنِ ما جادوا",40,"د",3,1],["الحسن البصري وأمثاله","أو كَعَليٍّ ما له من مثال",41,"ل",1,0],["الحسن متّفق فيها وما اختلَفَتْ","إلاَّ بأشكال أزهار وألوان",42,"ن",1,0],["الحسنُ حيثُ المقلةُ الكحلاء","والقدّ حيثُ القامة الهيفاء",43,"ا",2,1],["الحسن منك بدا معناه ثم غدا","مفرقا فى الورى لكن لك اجتمعا",44,"ع",2,0],["الحسن في نظراته كالحصب في","خطراته كالوحي للشعراء",45,"ا",2,0],["الحَسَبُ العِدُّ من بنيهِ","كلُّ نجيبٍ نَمَآ نجيبُ",46,"ب",1,0],["الحُسَيْنِيُّ الكبيرُ المُرْتَجى","إنْ دَهى باغٍ وإِنْ عادٍ عَدَا",47,"د",2,0],["الحسن من ايات مصحف وجهه","سبحان من سر القلوب بفاله",48,"ل",2,0],["الْحُسَيْنَ السَّيِّدَ الْقَرْمَ الّذي","فاقَ في عِلْمٍ وزُهْدٍ ووَقارِ",49,"ر",1,0],["الحسن فيه طوفانْ","والبدرُ منه غيْران",50,"ن",1,0],["الحسنُ تبرِزُه بغير تصنُّع","والمِلْح يُبرِزها بغيرِ تَكَلُّف",51,"ف",1,0],["الحُسن خَلْقُ اللهِ جلَّ","جلالُه والعِشْقُ كَسْبِي",52,"ب",2,0],["الحسنُ في شَفَتَيهِ ألعسُ أسمرُ","والسِّحرُ في عَينيهِ أبيضُ أسودُ",53,"د",1,0],["الحُسامُ الجُرازُ والعَلَمُ العَ","الِمُ والسَّيِّدُ الحَسيبُ النَّسيب",54,"ب",1,0],["الحسنُ في العالمينَ نوعٌ","مشتركٌ وهو فيك جِنْسُ",55,"س",1,0],["الحسْ حسٍّ خافي","والقلب فيه أحقاد",56,"د",1,0],["الحَسيبُ النَّسيبُ نَجلُ المَعالي","وَهوَ مِنها قَد كانَ خَيرَ وَليدِ",57,"د",1,0],["الحَسن الصيتِ الحَميدِ الثّنا","وَمَن بِحُسنِ الخُلق فينا اِدَّهَن",58,"ن",1,0],["الحسن فيهنَّ انتهى مستوطنٌ","معهن في الحرَكات والسكَناتِ",59,"ت",1,0],["الحسن ليس بمقصور على أحد","يوما وليس بمزوىّ عن الضِمن",60,"ن",1,0],["الحُسن للحزن ضد ليس يألفه","فكيف يجتمع الضدان في قرن",60,"ن",1,0],["الحسن يملكه من ليس يطلبه","نعم ويمنع عنه كل معمود",61,"د",1,0],["الحسن يملي الهوى فأنظمه","والدل يملي الأسى فأنثره",62,"ر",2,0],["الحسن مكانك معبده","واللحظ فؤادي مغمده",63,"د",2,1],["الحَسَن السياسه","الجَيد الفَراسه",64,"ه",1,0],["الحسن السامي الذي تخاله","فيالجود بحراً زاخراً مانضبا",65,"ب",2,0],["الحُسنُ لَفظٌ وَهَذا القَصرُ مَعناهُ","يا ما أُمَيلِحَ مَرآهُ وَأَسناهُ",66,"ا",2,1],["الحسنُ للنَّحسِ كم ادَّت مفاخرُهُ","والمجدُ كَم صاب مهبولاً ومطروقا",67,"ق",2,0],["الحسن في الوجه سريع الزَوال","فلتَعلم الحسناءُ ذات الدلال",68,"ل",1,1],["الحسن سلطان يسود على","عرش الصبا أن يزل ذاك زال",68,"ل",1,0],["الحسن الأخلاق من فضله","أنسى الورى فضل السحاب الثقال",69,"ل",1,0],["الحُسنُ جَمالُكِ سَيِّدُهُ","وَالسِحرُ عُيونُكِ مَورِدُهُ",70,"د",2,1],["الحسن نور بكف الود أَقطفه","وَالصد يعني بجمر الشوق تنور",71,"ر",1,0],["الحسنُ في الناسِ والأزهارِ مشتَبهٌ","وإن تعدّدَ أَشكالٌ وألوانُ",72,"ن",1,0],["الحسنُ يأسر من رآه وإنّما","في لون مكرك حارت الأوصافُ",73,"ف",1,0],["الحسود هلكا","ومضى مرتبكا",74,"ك",2,1],["الحسن الفعل شقيق محسن","فَتى صبا للمجد من قبل الصبا",75,"ب",2,0],["الحسين الحبر والبحر الخضم","بحر علم بالعلوم التطما",76,"م",2,0],["الحسين الشائغ الإحسان من","طوق الأعناق إحساناً ومن",76,"ن",1,0],["الحسن وهو من التراب","غداً يصير إلى التراب",77,"ب",1,0],["الحسين الندب والهادي الفتى","وعلى القدر جمعاً واتساقا",78,"ق",2,0],["الحُسْنُ ينبت في ترابِ بلادِكم","والظرفُ فيها ساحبَ الأكمام",79,"م",1,0],["الحُسنُ ما قَد حَواه","هَذا الإِزار المفوَّف",80,"ف",1,0],["الحسن علمك التحكيم فابق على","وجه العدالة في التحكيم يا قاضي",81,"ض",2,0],["الحسن الريحانة الشهيه","لخير من حلت له الهديه",82,"ه",1,0],["الحسنُ قد زادني غراماً","إذْ رَقَمَ الوردَ بالبَنَفْسجْ",83,"ج",1,0],["الحسن بالحب التقىَ فيهم","فالكل منهم عاشقٌ صب",84,"ب",1,0],["الحسن أبيض هكذا الثلج أدعى","وأقام منه أدلة أن تدحضا",85,"ض",2,0],["الحسن روض لم أنل من زهره","شيئا سوى الآلام والتنكيد",86,"د",1,0],["الحسن آلفها يبيت ضجيعها","وتظل قاصرةً عليه ظلالها",87,"ل",3,0],["الحسن يا اخت الاغن كزهرة","في الروض تذبل بعض بضع ليال",88,"ل",1,0],["الحسنُ يأمرُ والعُشّاقُ تأتَمِرُ","فَلَيسَ للَّومِ وجهٌ لا وَلا أَثرُ",89,"ر",1,1],["الحسن فيك ككهربا","ء قوية يذكي الشعور",90,"ر",1,0],["الحسن فيك مجدد","بين العشية والبكور",90,"ر",1,0],["الحسن فيك ممحض","لا ريب فيه ولا غرور",90,"ر",1,0],["الحسن السبط الزكي المجتبى","خامس أهل البيت أصحاب العبا",91,"ب",2,1],["الحسود يكاد بالياس","فِيْ بحر فرعون ونتلفه",92,"ف",2,0],["الحسنُ معذب كلَّ قلب","اللّه قضى به فحسبي",93,"ي",1,1],["الحسن يقول لمبسمه","إنا أعطيناك الكوثر",94,"ر",1,0],["الحسن ضاء بقنجةٍ","فازت بسعد يستمد",95,"د",1,1],["الحسن يعشق ذاتها وصفاتها","والغصن يطرق إذ هي الهيفاء",96,"ا",2,0],["ألحسنى ترتجيها أم قضت","حكمة الله فسلمت امتثالا",97,"ل",2,0],["الحسن يعشق لا يلام متيمُ","ويهيم فيه عاذلون ولوّم",98,"م",1,1],["الحسن يطرد أتراحاً وأشجانَا","وانظر البان تلقَ الهم قد بانا",99,"ن",2,1],["الحسن إن ضن به المليح","كالمال إذ يدفنه الشحيح",100,"ح",1,0],["الحسنُ أعجبُ من رآه فعانه","ممن يجدُّ إليه وهو مغامر",101,"ر",1,0],["الحسن كنزٌ في يديك فوقّه","لحظ الشحيح ونظرة المفتات",102,"ت",1,0],["الحسن شمس في المليحة لا يرى","يومين في فلك حليف تمام",103,"م",1,0],["الحسن أنواعه قد اختلفت","لكن حسن الخصال أجودها",104,"د",3,0],["الحسن قد بث على خده","بنفسجاً يرنو إلى ورده",105,"د",2,0],["الحسن شيء ماله شبيه","و