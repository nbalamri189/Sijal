,"يا ملك العترة الزكية يا","https://www.poetsgate.com/ViewPoem.aspx?id=121602",""],[5136,"قالوا تركت الهوى فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=121788",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5148,"في انتظار الحياة!","https://www.poetsgate.com/ViewPoem.aspx?id=187124",""],[5186,"قالوا: صناعاتنا بارت، فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=156496",""],[5273,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=180369",""],[5277,"ولأنّها شبهُ القمر..","https://www.poetsgate.com/ViewPoem.aspx?id=194586",""],[5279,"الصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=215615",""],[5282,"قالوا تغزل","https://www.poetsgate.com/ViewPoem.aspx?id=214653",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""],[307,"كم فيك يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=213636",""],[5320,"رثاء الشناوى","https://www.poetsgate.com/ViewPoem.aspx?id=43103",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[190,"قالوا تهنّ بيوم العيد قلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=101341",""],[5358,"لو نعيش معا","https://www.poetsgate.com/ViewPoem.aspx?id=21907",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5376,"لا الشمسُ آفلةٌ في أوجِها حلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188497",""],[5376,"ما عابني في الهوى قولٌ بنائحة","https://www.poetsgate.com/ViewPoem.aspx?id=188546",""],[5376,"بئسا لقوم الى الأعداء قد تبعا","https://www.poetsgate.com/ViewPoem.aspx?id=190264",""],[5376,"ما اعتدْتُ بعداً عنك يا أمي","https://www.poetsgate.com/ViewPoem.aspx?id=191870",""],[5376,"ما نفعُ روحٍ اذا بالعينِ تذرفُها","https://www.poetsgate.com/ViewPoem.aspx?id=192433",""],[5376,"يا شام بسمك في السماء شحوب","https://www.poetsgate.com/ViewPoem.aspx?id=197716",""],[5409,"لم يبتهج لي قلبٌ فيك مكتئبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=155394",""],[5419,"عين الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=32241",""],[5431,"تعويذة","https://www.poetsgate.com/ViewPoem.aspx?id=201776",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[5616,"معذرة يا أبا العلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204842",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5732,"قالو تنوح","https://www.poetsgate.com/ViewPoem.aspx?id=177936",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""],[5830,"يَاقُدْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=200771",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[192,"قالوا ترى","https://www.poetsgate.com/ViewPoem.aspx?id=9856",""],[5944,"كلاسيكية","https://www.poetsgate.com/ViewPoem.aspx?id=214285",""],[6008,"الواسطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=60803",""],[6068,"قالوا: تحبُّ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194951",""],[6082,"هامور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=58893",""],[6097,"بيدي ودَعتُك...","https://www.poetsgate.com/ViewPoem.aspx?id=190689",""],[6115,"اللى يحبون الهروج اللفايق","https://www.poetsgate.com/ViewPoem.aspx?id=180496",""],[6142,"قالوا تحب أبا بكر فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=155739",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[572,"ما أرتضي عَنْكَ بالرّياضِ غِنَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9480&r=&rc=337",""]],"verses":[["قالوا تَزاوَرَ عِطفُهُ","وَأَرابَنا إيماضُه",0,"ض",2,1],["قالوا تَشَكّى فَلَم يَكتُب فَواحَزَني","إِن كانَ يَمنَعُهُ أَن يَكتُبَ الوَجَعُ",1,"ع",1,1],["قالوا تَرَفَّضتَ قُلتُ كَلّا","ما الرَفضُ ديني وَلا اِعتِقادي",2,"د",2,1],["قَالوا تَنَحَّوا فَمَسّوا الأَرضَ فَاِحتَوَلوا","ظِلّاً بِمُنخَرِقٍ تَهفو بِهِ المَورُ",3,"ر",1,0],["قالوا تَحَرَّرتَ مِن قَيدِ المِلاحِ فَعِش","حُرّاً فَفي الأَسرِ ذُلٌّ كُنتَ تَأباهُ",4,"ا",2,0],["قالوا تَغَيَّرَ بِالسُلُوِّ","وَبِالمَلامَةِ قَد تَعَيَّر",5,"ر",1,0],["قالوا تَعَزَّ فَقُلتُ لَستُ بِكائِنٍ","مِنّي العَزاءُ وَصَدعُ قَلبي يُقرَعُ",6,"ع",1,0],["قالوا ترقَّى فلانُ اليومَ منزلةً","فقلتُ ينزلهُ عنها لقاء غدِ",7,"د",1,0],["قالوا تَداوَ بِهِ فَقُلتُ لَهُم","يا قَومُ هَل يَتَداوى الداءُ بِالدائي",8,"ا",3,0],["قالوا تُعاهِرُ في الدرو","بِ فقلتُ كلا بل تُعاظلْ",9,"ل",1,0],["قالوا تَوَرَّع إِنَّها مَحجوبَةٌ","إِلّا عَنِ المُتَزَهِّدِ المُتَوَرِّعِ",10,"ع",1,0],["قالوا تَرقّى سَليلُ الطينِ قُلتُ لَهُم","الآنَ تَمَّ شَقاءُ العالَمِ الآنا",11,"ن",2,0],["قالوا تَأَمَّل أَيَّ حالٍ حالَها","صَدَعَ القَضاءُ صُروحَها فَأَمالَها",12,"ه",2,0],["قالوا تَعَشَّقتَها عَمياءَ قُلتُ لَهُم","ما شانَها ذاكَ في عَيني وَلا قَدَحا",13,"ح",2,1],["قالوا تزوَّجَ في فروق غنية","أموالها تُعلى الرجال وترفع",14,"ع",1,0],["قالوا تَمايَزَ حَمزَةُ","قُلتُ التَمايُزُ مِن قَديمِ",15,"م",1,1],["قالوا تَعَشَّقَ كُلَّ رَبِّ مَلاحَةٍ","فَأَجَبتُهم إِنَّ المُحَرِّكَ واحِدُ",16,"د",1,0],["قالوا ترى عورتَها","قلتُ المنى عورتُها",17,"ه",2,0],["قالوا تحبُّ السوادَ قلتُ لهم","أحبُّهُ في الشعورِ والحدقِ",18,"ق",1,1],["قالوا تجدَّرَ منْ تهوى فطلعتُهُ","كالبدرِ مِنْ فوقِها سمطان منْ لولو",19,"و",1,1],["قالوا تنقَّلْ لتنالَ العُلى","واشمخْ إلى العزِّ ولا تقتنعِ",20,"ع",1,1],["قالوا تركتَ الحكمَ قلتُ تركتُهُ","واعتضتُ عنْ خَضِرِ القضا بالياسِ",21,"س",1,1],["قالوا تناسى فقلتُ كلاَّ","عهدي بهِ لا يخونُ عهدي",22,"ي",1,1],["قالوا تجدَّر مَنْ تهوى فطلعتُهُ","كالبدرِ مِنْ فوقِهِ سمطانِ منْ لولو",23,"و",1,1],["قالوا تعدَّى عليك مغتصِباً","ديوانك المشتهى إلى العاقلِ",24,"ل",1,1],["قالوا تَنَسَّكَ بَعدَ الحَجِّ قُلتُ لَهُم","أَرجو الإِلَهَ وَأَخشى طيزَناباذا",25,"ذ",2,1],["قالوا تُقُسُّمَ مَقتولٌ عَلى حَنَقٍ","فَقُلتُ سِيّانِ كَلمُ المَيتِ وَالكَلِمُ",26,"م",1,0],["قالوا تسلَّ بغيرها فأَجبتهم","ما حيلَتي إن كنت لا أَسطيع",27,"ع",1,0],["قالوا تكلم وساد الصمت بينهم","فقلت أنصح والإخلاص منهاجي",28,"ج",2,0],["قالُوا تَجافى الرُّقادُ عنها","فقُلْتُ لا تَرْقُدُ الكَواكِبْ",29,"ب",1,0],["قَالُوا تَعَلَّقْ بِأُخْرَى كَيْ تَذُودَ بِهَا","بَرْحَ الأَسَى عَنْ فُؤَادٍ دَائِمِ الْكَمَدِ",30,"د",1,0],["قالوا تحبُّ الشام قلتُ جوانِحي","مقصوصةٌ فيها وقلتُ فؤادي",31,"د",2,0],["قالوا: تكرِّمُهُ، فقلتُ: لمحتُ في","هذا الجبين على النجاحِ شواهدا",32,"د",2,0],["قالوا: تكرِّمة، فقلت: فتىً إذا","كرَّمتُه، كرَّمتُ فيه بلادي",33,"د",2,0],["قالوا: تنكَّر للدُّستور، وانفردَتْ","بالأمر شيعَتُهُ، قلنا: إلى أمَدِ",34,"د",1,0],["قالوا: تألق نُور العلم. قلت لهم:","بل ناره أصبحت تزداد إشعالا!",35,"ل",2,0],["قالوا: تُظَاهِرُهُم قوي ال","عدوانِ، قلنا: فَلْتُظَاهر",36,"ر",1,0],["قالوا تماثلَ للشِفاء بِشارةً","سَكَنت لها روحي وأُفرِخَ رُوعي",37,"ع",2,0],["قالوا تَشاغَلَ عن أهلٍ وعن ولَدٍ","فقال نهداك : لم يَشغَلهْ من أحد",38,"د",1,0],["قالوا تداوَ به منه فقلت لهم","يا قوم هل يتداوى الداء بالدائي",39,"ا",3,0],["قالوا تَبَدا امام العلم قالَ إِذاً","آن الرَحيل وَطابَ السَير وَالسَفَر",40,"ر",1,0],["قالوا تمشكح في يافا لقد صدقوا","إني تمشكحت رغم لعاذل الشأني",41,"ن",2,0],["قالوا تعاقرها قولوا لهم علناً","إني أعاقرها في كل دكان",41,"ن",1,0],["قالوا تدمشق قولوا ما يزال على","علاته إربدي اللون حوراني",41,"ن",2,0],["قالوا تعالوا نحتكمْ","فالجسمُ قاضي القاصِدَهْ",42,"د",2,0],["قَالُوا تُذَكِّرُنَا جُملُ الظِّبَاءَ إِذَا","نَصَّت وتُذكِرُ إِن تَرنُ المَهَا الهَمَلا",43,"ل",2,0],["قَالُوا تُذَكِّرُنَا اللَّيلَ البَهِيمَ إِذَا","مَا أرخَتِ الفَرعَ فَوقَ المَتنِ فَانسَدَلا",43,"ل",2,0],["قالوا تعَوّضْ بغِزلان النقا بدلا","أمقنعى شِبْهُ أجيادٍ لأجياد",44,"د",1,0],["قالوا تعجب آل الناشري على","تخلفي عن أخيهم غاية العجب",45,"ب",1,0],["قالوا تهنّ بيوم العيد قلد لهم","ما سرّ بالعيد مدفوع إلى العدمِ",46,"م",1,1],["قالوا تعشّق فافتقر","ويلي بمنحول النظر",47,"ر",1,1],["قالوا تثاب على هذا فقلت لهم","خذوا ثوابي