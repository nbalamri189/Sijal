{"poems":[[95,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[53,"أسأت فأحسن بي جهده","https://www.aldiwan.net/poem64067.html","المتقارب"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141983","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[119,"لله في بطحاء ام عبيدة","https://www.aldiwan.net/poem41081.html","عموديه"],[119,"حنت لفيفاء البطاح الروح","https://www.aldiwan.net/poem41186.html","عموديه"],[190,"يا غرفتي إن غرفة نطقت","https://www.aldiwan.net/poem43871.html","الكامل"],[228,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[236,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[236,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[422,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[543,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[563,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[563,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[567,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138301",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126825","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126726","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126787","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97056","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86848","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38335","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38321","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145968","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56644","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144085","الرمل"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117136","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79960","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127954","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26413","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110255","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93631","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137001",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93866","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93865","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205855","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67593","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65171","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48355","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138460",""],[3607,"","https://poetry.dctabudhabi.ae/diwan/poem/203062",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132091","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135490","المديد"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44900","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136958",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91004","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90996","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90812","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4554,"","https://poetry.dctabudhabi.ae/diwan/poem/199563","المسحوب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139670",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139689",""],[4578,"حكم العيون من الظماء الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49401",""],[4984,"لا تلم حظك..","https://www.poetsgate.com/ViewPoem.aspx?id=175536",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5277,"دستورُ حبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=188010",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5397,"طلعت بك العليا بنجم أسعد","https://www.poetsgate.com/ViewPoem.aspx?id=157935",""],[5431,"عهد المحبة راسخ وموثق","https://www.poetsgate.com/ViewPoem.aspx?id=191185",""],[5431,"والشعر بحرٌ طائرٌ في أربعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=197923",""],[5431,"هدية بعيد الزواج ...","https://www.poetsgate.com/ViewPoem.aspx?id=207439",""],[5674,"مأسور ويعشق آسره","https://www.poetsgate.com/ViewPoem.aspx?id=190017",""],[5701,"قلت يوما لامرئٍ رحّالة","https://www.poetsgate.com/ViewPoem.aspx?id=164631",""],[402,"يا مصر أنت الهل والسكن","https://www.poetsgate.com/ViewPoem.aspx?id=36539",""],[5848,"الشيخ عبدالعزيز بن جامع","https://www.poetsgate.com/ViewPoem.aspx?id=53333",""],[5853,"هو شاعرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175677",""],[1920,"الأرجوحة المشنقة","https://www.poetsgate.com/ViewPoem.aspx?id=197103",""],[5956,"ربّاه هذا التلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=182284",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[6008,"مهداه إلى الإمير نواف بن فواز الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60802",""],[6225,"الحبُّ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80938&r=&rc=207",""],[2638,"ممرضتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87859&r=&rc=16",""]],"verses":[["هُوَ شُكْرُ مَا مَنَحَتْ وَمَا مَنَعَتْ","مِنْ أَنْ تُنَغِّصَ فَضْلَهَا المِنَنُ",0,"ن",1,0],["هُوَ شِيمَةٌ بِقُلُوبِنَا طَهُرَتْ","عَنْ أَنْ تَشُوبَ نَقَاءهَا الظِّنَنُ",0,"ن",1,0],["هُوَ شَعْبٌ حُرُّ السَّجَايَا سَخِيٌّ","وَأَبِيٌّ عَنْ عِزَّةٍ لاَ اخْتِيَالِ",1,"ل",1,0],["هو شيخٌ مُسخَّرُ الظهر لا ين","فكُّ من سُخرةٍ على إثر سُخره",2,"ر",2,0],["هو شمس الضحى إذا ما استقلَّتْ","لا تمارِي في ضوئها عينان",3,"ن",1,0],["هو شعر يهز مستمعيه","وهو سحر يحار فيه اللبيب",4,"ب",1,0],["هو شكوى على القضا","ء وعتب على القدر",5,"ر",1,0],["هو شطرُ النَّفسِ لا توأمُها","هو منها هو فيها كلَّ آن",6,"ن",1,0],["هُوَ شَوْقٌ إلى حِمىً","كُلُّ مَا فِيِهِ مُسْتَحَبّْ",7,"ب",1,0],["هو شاعر الأطيار لا متكبّرٌ","صلفٌ ولا هو بالإمارة معجَبُ",8,"ب",1,0],["هو شوقي جسماً يُرَى ويُناجي","وهو في الشعرِ طائفٌ نوراني",9,"ن",2,0],["هو شيخنا الغوث الرفاعي الذي","سطعت عليه جلالة الكرار",10,"ر",1,0],["هو شيخ اهل الله عقد نظامهم","ولهم بجاذبه القوي فتوح",11,"ح",1,0],["هو شاهد لي في ضمائرهم","لقبيح ما قالوا وما ذكروا",12,"ر",3,0],["هُوَ شاعِرٌ إِن لَم يَذُق أَلَمَ الهَوى","يَكفيكَ مِنهُ أَحرُفٌ تَتَأَلَّمُ",13,"م",1,0],["هو شاهد متوكل ولوصفه","بين الكرام أولى النهى مشهود",14,"د",1,0],["هو شاهد متول ومبشر","هو منذر متيقن إنذاره",15,"ر",2,0],["هُوَ شاهِدٌ مُتَوَكِّلٌ هُوَ مُنذِرٌ","وَمُبَشِّرُ الأَبرارِ بِالرّضوانِ",16,"ن",1,0],["هُوَ شمس عبد مناف العلياعات","مضر بجديه عَلى الانجاد",17,"د",1,0],["هو شَمسُ مجدٍ أَشرقت بضيائها","ظُلَمُ الدُجى وأَنارت الأَحلاكُ",18,"ك",1,0],["هو شرعة الظَّامي إذا اتَّقَدَ الظَّما","أَظما ولم أَفْقِدْ نَميرَ زلاله",19,"ل",2,0],["هو شعري وفيك قيل ابتداءً","جاء أو كان راجعاً مكرورا",20,"ر",2,0],["هوَ شرع يأبى حسامك إلاَّ","كونهُ فيهِ محرماً أو محلاَّ",21,"ل",2,0],["هو شمس الهدى وأبناء رزي","ك نجوم من حوله وبدور",22,"ر",1,0],["هو شِبلُ فَخرِ المَزاورِ مَن يَم","شونَ هوناً والصوتُ مِنهم زئيرُ",23,"ر",1,0],["هوْ شراب وما سواه سراب","شربه للشفا من الأوجاع",24,"ع",1,0],["هو شمس وما سواه ظلال","وهو بدر لظلمة الغير غطى",25,"ط",2,0],["هُوَ شافِعِيٌّ عِندَهُ حُسنُ الوَفا","لابنِ الكَرامةِ سُنَّةٌ وَحُقُوقُ",26,"ق",1,0],["هو شخصك السامي الخلائق من جرت","منه المعارف كالبحور زواخرا",27,"ر",2,0],["هو شبلُ المهدي وصالح أكرم","بفتىً فاضل حليف المعالي",28,"ل",2,0],["هو شبلُ حيدرة الوصيّ لبابه","أملاكها طرّاً تروح وتغتدي",29,"د",2,0],["هو شبلهُ وله السدانة سلّمت","وإليه كلّ الأمرِ صار مفوّضا",30,"ض",2,0],["هو شطبٌ أم رمح عنتر كانا","وعجاجاً نرى به أم دخانا",31,"ن",2,1],["هُوَ شَمس المَعقول مِنهُ أَضاءَت","كُل أَرض وَأَشرَقَت مِنهُ مَصر",32,"ر",1,0],["هُوَ شافعيُّ زَمانِهِ إِذ مِنهُ قَد","جادَت بِتَخريجِ الفُروعِ قَرائِحُ",33,"ح",1,0],["هوَ شَمسٌ لَها الحَواجِبُ بُرجٌ","فيهِ حَلَّت كَأنَّهُ الميزانُ",34,"ن",1,0],["هُوَ شِفاء الملكِ الهمام","بَعد اِنحِراف كانَ ذا إِلمامِ",35,"م",1,0],["هو شبَّاكُنا المُطِلُّ علينا","قدْ كرهناهُ دَائِمَاً كي نُحِبَّهْ",36,"ب",2,0],["هو شعري به يطيب أرتجالي","كل معنى يحير العقل فيه",37,"ي",2,0],["هو شمسٌ وأنا حِرباؤه","فلذا أقبل وجهي مطلَعَهْ",38,"ه",1,0],["هو شاعر في عصره فطن ول","كنَّ ابن حمير أشعر الشعراء",39,"ا",2,0],["هو شمس أفق المكرمات وبدرها ال","هادي لمن أمسى يجوب البيدا",40,"د",2,0],["هو شمس حسن ان بدت ظلت لها ال","أحداق بين محقق أوخاسى",41,"س",2,0],["هُوَ شَمسُ الضُحى إِذا أَظلَمَ الخَط","بُ وَبَدرُ الدُجى وَسَعدُ السُعودِ",42,"د",1,0],["هو شرُّ ما كتبَ الشبابُ وخيرُ ما","يلقيه أستاذٌ على طلاب",43,"ب",1,0],["هوَ شَخص سَما بِنَوع كَمال","فَأَرى الصنف عاليَ الأجناس",44,"س",1,0],["هو شاعر فذٌ له في شعره","شأوٌ تقصر دونه البلغاء",45,"ا",2,0],["هو شيخ كل مشايخ الإسلام من","هم في الشريعة للرسول خلائف",46,"ف",1,0],["هو شمس تزدهي أنوارها","حيث يجلو ضوءها جنح الظلم",47,"م",1,0],["هو شكوى الغريب في البلد النا","ئي ونوح الثكلى ودمع اليتامى",48,"م",2,0],["هو شرخُ الزَّمانِ ما زالَ مُذ كا","نَ لهُ بالمؤاخَيَينِ وُلُوعُ",49,"ع",1,0],["هو شمس علم يهتدي بضيائه","من ضلّ عن طرق الهدى يتعسّف",50,"ف",1,0],["هو شر من وطئت له وجه الثرى","قدم وأخبث من يدب وألأم",51,"م",1,0],["هوَ شمْسي وطالَما قد توارَتْ","عن جفوني يومَ النَوى بالحِجابِ",52,"ب",1,0],["هو شمس والأنبياء بدورٌ","ومن الشمس تستمد ضياها",53,"ا",3,0],["هو شيخ سوء مزدرى","له شيوب عاصيه",54,"ه",1,1],["هُوَ شَيخُ أَصحابِ النَبيِّ وَخَيرُهُم","وامامُهُم حَقّاً بِلا بُطلانِ",55,"ن",1,0],["هُو شرعُ موسى الذي جفَّت مَغارسُهُ","وانهارَ ميناهُ وانهالَت قواعدُهُ",56,"د",2,0],["هو شعلةٌ من نور مشرقنا ألم","تشعر به يا أيذاك المغربُ",57,"ب",1,0],["هو شمسٌ ضاء شرقاً","منه ضوء الغربياتِ",58,"ت",1,0],["هو شمس في الضحى بل أَحسَن","كحل اللحظ عليها أيده",59,"ه",1,0],["هُوَ شائعٌ بَينَ الوُجودِ مُقسَّمٌ","لَكِنَّه في نُورِ عَينيكَ اِلتأَمْ",60,"م",1,0],["هو شاعر لا تعليقه وحاذري","هذا ابوك فسائليه خبير",61,"ر",1,0],["هو شبل عبد القادر الغازي ومن","أسد الدجال تولد الآساد",62,"د",1,0],["هو شبل عبد القادر الغازي الذي","قهر العدا قدما نجد الصارم",63,"م",1,0],["هو شبل عبد القادر الغازي وهل","يأتي من الضرغام غير ضراغم",64,"م",1,0],["هو شيبة الحمد الذي بوقاره","قرَّت ربي الزوراء مع بطحاها",65,"ا",3,0],["هو شمعتي بنصاه إلى الحرب شالي","شيخٍ متى ما طاح شملي يْشالي",66,"ي",1,0],["هو شهدٌ حلا بذوق الموالي","وبذوق القالي اجاجٌ مريرُ",67,"ر",1,0],["هو شمس العلوم شعَّ سناها","فرأينا للعلم فيها سطوعا",68,"ع",2,0],["هو شامة الشام التي بجمالهِ","وجناتها تزدان بالتوريدِ",69,"د",1,0],["هو شعر ليس إلا .. فارتشف","من عناقيد الدَّوالي ما اختمر",70,"ر",1,0],["هُوَ شَاعِرٌ 