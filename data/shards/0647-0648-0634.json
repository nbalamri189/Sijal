{"poems":[[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[51,"أسأت فأحسن بي جهده","https://www.aldiwan.net/poem64067.html","المتقارب"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[89,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141983","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[116,"لله في بطحاء ام عبيدة","https://www.aldiwan.net/poem41081.html","عموديه"],[116,"حنت لفيفاء البطاح الروح","https://www.aldiwan.net/poem41186.html","عموديه"],[187,"يا غرفتي إن غرفة نطقت","https://www.aldiwan.net/poem43871.html","الكامل"],[224,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[232,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[232,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[298,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[417,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[465,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[539,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[559,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[559,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[563,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"]],"verses":[["هُوَ شُكْرُ مَا مَنَحَتْ وَمَا مَنَعَتْ","مِنْ أَنْ تُنَغِّصَ فَضْلَهَا المِنَنُ",0,"ن",1,0],["هُوَ شِيمَةٌ بِقُلُوبِنَا طَهُرَتْ","عَنْ أَنْ تَشُوبَ نَقَاءهَا الظِّنَنُ",0,"ن",1,0],["هُوَ شَعْبٌ حُرُّ السَّجَايَا سَخِيٌّ","وَأَبِيٌّ عَنْ عِزَّةٍ لاَ اخْتِيَالِ",1,"ل",1,0],["هو شيخٌ مُسخَّرُ الظهر لا ين","فكُّ من سُخرةٍ على إثر سُخره",2,"ر",2,0],["هو شمس الضحى إذا ما استقلَّتْ","لا تمارِي في ضوئها عينان",3,"ن",1,0],["هو شعر يهز مستمعيه","وهو سحر يحار فيه اللبيب",4,"ب",1,0],["هو شكوى على القضا","ء وعتب على القدر",5,"ر",1,0],["هو شطرُ النَّفسِ لا توأمُها","هو منها هو فيها كلَّ آن",6,"ن",1,0],["هُوَ شَوْقٌ إلى حِمىً","كُلُّ مَا فِيِهِ مُسْتَحَبّْ",7,"ب",1,0],["هو شاعر الأطيار لا متكبّرٌ","صلفٌ ولا هو بالإمارة معجَبُ",8,"ب",1,0],["هو شوقي جسماً يُرَى ويُناجي","وهو في الشعرِ طائفٌ نوراني",9,"ن",2,0],["هو شيخنا الغوث الرفاعي الذي","سطعت عليه جلالة الكرار",10,"ر",1,0],["هو شيخ اهل الله عقد نظامهم","ولهم بجاذبه القوي فتوح",11,"ح",1,0],["هو شاهد لي في ضمائرهم","لقبيح ما قالوا وما ذكروا",12,"ر",3,0],["هُوَ شاعِرٌ إِن لَم يَذُق أَلَمَ الهَوى","يَكفيكَ مِنهُ أَحرُفٌ تَتَأَلَّمُ",13,"م",1,0],["هو شاهد متوكل ولوصفه","بين الكرام أولى النهى مشهود",14,"د",1,0],["هو شاهد متول ومبشر","هو منذر متيقن إنذاره",15,"ر",2,0],["هُوَ شاهِدٌ مُتَوَكِّلٌ هُوَ مُنذِرٌ","وَمُبَشِّرُ الأَبرارِ بِالرّضوانِ",16,"ن",1,0],["هُوَ شمس عبد مناف العلياعات","مضر بجديه عَلى الانجاد",17,"د",1,0],["هو شَمسُ مجدٍ أَشرقت بضيائها","ظُلَمُ الدُجى وأَنارت الأَحلاكُ",18,"ك",1,0],["هو شرعة الظَّامي إذا اتَّقَدَ الظَّما","أَظما ولم أَفْقِدْ نَميرَ زلاله",19,"ل",2,0],["هو شعري وفيك قيل ابتداءً","جاء أو كان راجعاً مكرورا",20,"ر",2,0],["هوَ شرع يأبى حسامك إلاَّ","كونهُ فيهِ محرماً أو محلاَّ",21,"ل",2,0],["هو شمس الهدى وأبناء رزي","ك نجوم من حوله وبدور",22,"ر",1,0],["هو شِبلُ فَخرِ المَزاورِ مَن يَم","شونَ هوناً والصوتُ مِنهم زئيرُ",23,"ر",1,0],["هوْ شراب وما سواه سراب","شربه للشفا من الأوجاع",24,"ع",1,0],["هو شمس وما سواه ظلال","وهو بدر لظلمة الغير غطى",25,"ط",2,0],["هُوَ شافِعِيٌّ عِندَهُ حُسنُ الوَفا","لابنِ الكَرامةِ سُنَّةٌ وَحُقُوقُ",26,"ق",1,0]]}