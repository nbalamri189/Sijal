{"poems":[[132,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[230,"عباس طبت منابتا ومناقبا","https://www.aldiwan.net/poem55114.html","الكامل"],[264,"كن رؤوفا بالوالدين رحيما","https://www.aldiwan.net/poem35827.html","الخفيف"],[275,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[396,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[458,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[473,"يا أيها البدر الذي","https://www.aldiwan.net/poem60053.html","مجزوء الرجز"],[505,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126155","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118380","الرجز"],[2128,"","https://poetry.dctabudhabi.ae/diwan/poem/143660","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118756","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91381","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131069",""],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139263","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58114","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33460","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33588","الخفيف"],[4814,"في رحاب الخشوع","https://www.poetsgate.com/ViewPoem.aspx?id=213010",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5431,"كن صديقي...","https://www.poetsgate.com/ViewPoem.aspx?id=200252",""],[5431,"عطر وبحر ...(2)","https://www.poetsgate.com/ViewPoem.aspx?id=206136",""],[5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[1680,"يا من تحل بذكره","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5848,"بقايا حلم","https://www.poetsgate.com/ViewPoem.aspx?id=53157",""],[5861,"لك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=188263",""],[6134,"يا سيداً حاز التفرد بالذكا","https://www.poetsgate.com/ViewPoem.aspx?id=169540",""],[6152,"لكنة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=201742",""],[5190,"الديك المغرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78302&r=&rc=15",""]],"verses":[["كنْ راضياً بقضاءِ اللهِ ذَا عِبرٍ","في النفع والضُّرِّ والإعسار واليسرِ",0,"ر",1,0],["كُن راعِياً يَرعى الأُسودَ فمن رَعى","غَنَماً يَبِت يَخشى الذِئابَ وَيَفرَقُ",1,"ق",1,0],["كن رؤوفاً بالوالدين رحيما","محسناً مكرماً وبرّاً شفوقا",2,"ق",2,1],["كُن رفيقاً لي رفيقاً بي فقد","شاقني رفقُ شقيٍّ بشُقي",3,"ي",1,0],["كن راحما نفسك","من قبل رمسك",4,"ك",1,0],["كُنْ رَيَّقَ البِشْرِ إنْ الحُرَّ هِمَّتُهُ","صَحيفَةٌ وعَلَيها البِشْرُ عُنْوانُ",5,"ن",1,0],["كن رحيما بالبرا","يا حسبهم وزر ووزر",6,"ر",1,0],["كُن راحِمَ المَيتِ الَّذي","ضَريحُهُ أَطمارُهُ",7,"ر",2,0],["كُنْ رأسَ حِزْبي ناظِماً لِعِصابَتي","حِزْبي بِعَينِ المُصْطَفى مَرْعِيُّ",8,"ي",1,0],["كن راضياً ابن الشقيق وحامداً","إحسان مولاك الكريم وشاكره",9,"ه",1,0],["كن راكبا منوقا","زين بلي المرفق",10,"ق",1,0],["كنرجسة في الروض ترنو بمقلة","مذهبة والجفن منها مفضض",11,"ض",1,0],["كُن رائِق البَشر ان الحر شيمَتُه","بَشاشَة وَليَكُن لِلغَيظِ كِتمانُ",12,"ن",1,0],["كُن رَحيبَ الصَدرِ ان حَلَّ القَضا","وَاِصطَبِر ان نابَكَ الخَطبُ الجَل",13,"ل",1,0],["كن راحمي من زمانٍ","يُصمي ويعمي ويضني",14,"ن",2,0],["كُن راحماً يا مالكي في مُهجتي","فَالرفق يَجمُلُ بِالجَميل المنصف",15,"ف",1,0],["كن رؤوفا بنا فأنت لطيف","وقنا صدمة المذنب يا رب",16,"ب",1,0],["كن رابطا متمما للعقد","فأطرق القاضي مليا رأسه",17,"ه",1,0],["كن رفيقاً إذا قدرت حليما","وتغافل تسلك طريقاً قويما",18,"م",2,1],["كن راكعاً طوراً وطوْراً ساجداً","وارئبْ إلى المولى ابتغاءَ النائلِ",19,"ل",1,0],["كُن رؤوفاً بهِ وأنعِم عليهِ","وخفِ اللَهَ واذكرَنَّ معادَك",20,"ك",1,0],["كن رَحيما فقد ملكتَ سقيماً","لا تزده بطولِ هجرِكَ سُقما",21,"م",2,0],["كن رقيباً لدمعتي حينَ تهمي","بالتياعٍ يعيثُ في الأجفانِ",22,"ن",1,0],["كن راضياً بقضاء الله، كيف جرى؟","إيَّاك أن تسخط المقدور منتقدا",23,"د",2,0],["كن رفيقي برحلة الوقت حتى","يطفئ الغيث غابة في الحريق",24,"ق",1,0],["كنرجسٍ تاه في علائقه","فأيقظ الشعر مابه اتصفا",25,"ف",2,0],["ك''نَرْسِيسَ'' في المَنْفَى أُشَاكِسُ صُورَتِي","كَأَنَّ جُنُونًا فِي فُؤَادِي تَفَسَّحَا",26,"ح",2,1],["كن راحمي فلقد أيس","ت من الأقارب والأباعد",27,"د",1,0],["كن رجد الخيل مع غط الصهيل","الزلازل والرعود الصاعقات",28,"ت",1,0],["كن روحي يوم حست في جفاه وصعب نيله","بشرتني بالضياع وشدة العزم لسفرها",29,"ر",3,0],["كن ربي سخر له المعجزات المستحيله","واصبح اسطوره وكل الالسنه تنقل خبرها",29,"ر",3,0],["كن ربي خلقها من بياض الغيوم","ومن كفوف السحابه بالورد القحت",30,"ت",1,0],["كن روحه من ضلوعه تبي تطلع","لاتذكّر بقايا حلمه الغافي",31,"ف",2,0],["كن رؤوفًا ذاك قلبي","في يديك كعيالِكْ",32,"ك",1,0],["كن رافلاً في ثوب عز دائم","ما دام حلمك في الأنام شهيرا",33,"ر",2,0],["كنرجستين عيناها جمال","تنافسه جمالا وجنتاها",34,"ا",3,0],["كن رابط الجأش ذا عزمٍ وذا ثقةٍ","عند اللقاء بهِ ، فالله يكفيكا",35,"ك",2,0]]}