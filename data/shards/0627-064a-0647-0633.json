{"poems":[[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[74,"واوحشتي لمقام منك محمود","https://www.aldiwan.net/poem18564.html","البسيط"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[99,"إيه سونيا إيهِ سونيا","https://www.aldiwan.net/poem24415.html","مجزوء الرمل"],[99,"إيه سونيا أنت الرضا والحنان","https://www.aldiwan.net/poem24583.html","الخفيف"],[99,"يا أبا الأشواق غن","https://www.aldiwan.net/poem24584.html","مجزوء الرمل"],[228,"مغناك ملتهب وكأسك مترعه","https://www.aldiwan.net/poem41598.html","الكامل"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48977","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100734","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97969","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74045","الخفيف"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4691,"إيه ِ سلمى ويا أنامل سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=142520",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5408,"إحتفالية المقاتل في محراب الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=190866",""],[5411,"شاعر الثورة","https://www.poetsgate.com/ViewPoem.aspx?id=198605",""]],"verses":[["إِيهِ سَرْكِيسُ إِنْ بَكَيْنَا فَإِنْ البَ","اقِيَ الحُزْنُ وَالسُّرُورُ الظَّعِينُ",0,"ن",1,0],["إيهٍ سقاكَ شهاب الدِّين صوب حياً","يكادُ يعشب أطراف الجلاميد",1,"د",1,0],["إيهِ سيزوستَريسَ ماذا يَنالُ ال","وَصفُ يَوماً أَو يَبلُغُ الإِطراءُ",2,"ا",2,0],["إيه سونيا إيهِ سونيا","أنت دنيا أنت دنيا",3,"ي",2,1],["إيه سونيا أنت الرضا والحنان","كيف ضاءت بكِ الليالي الحسان",4,"ن",1,1],["إيهِ سونيا هجتِ شوقي","وشجوني والتمني",5,"ن",2,0],["إيه سونيا ذاك يومي","فاسكبي لي لا تضني",5,"ن",2,0],["إيه سدومُ بُعثتِ مِن خَلِلِ اللظى","حَمراءَ في شَهَواتِكِ المُتَسَرِّعَه",6,"ع",2,0],["إيه سل منابره","فهو أخطب الخطبا",7,"ب",2,0],["إيه سلّومُ قد نقلتَ رُفاتاً","غارَ دُرُّ البحار من مَرْجانهْ",8,"ن",2,0],["إِيهٍ سليمان ايهٍ يا ابن بجدتها","لا زلت للفضل ما دام الجديدان",9,"ن",1,0],["إيه سمنود ما أحلاك باسمة","كزهرة الفل تزهر بين أعواد",10,"د",1,1],["إيه سركيس ما نظرناكَ إِلّا","وَرأيناك لِلكَمال مِثالا",11,"ل",2,0],["أيهِ سقراط أنت أفضل شخص","عاش في تلك الأعصر الوثنية",12,"ي",2,0],["إيهِ سلمى ويا أناملَ سلمى","أنا عاينتُ في رسومك حلما",13,"م",2,1],["إيه سمراء ما تسمرَّ طرفي","فيك حتى تسمَّرت أشعاري",14,"ر",2,0],["إيه ..سنين العمر كيف .تصرمت","أيامنا ..وطوى الزمان صحائفا",15,"ف",2,0],["إيهٍ سَميحُ وَ لَمْ تَزَلْ أنْتَ الّذي","أحْنى إليْكَ مِنَ الصمود عِقالُ",16,"ل",1,0]]}