{"poems":[[55,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[53,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[203,"للحسان الدلال والخيلاء","https://www.aldiwan.net/poem45375.html","الخفيف"],[458,"أربعاء الرماد يا عيد أحزا","https://www.aldiwan.net/poem61392.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2484","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109253","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91931","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216468","الخفيف"]],"verses":[["إِنَّما ضَلَّت عُقولُهُمُ","حَيثُ يُعييهِنَّ وُجدانُ",0,"ن",1,0],["إنما ضيَّع مثرٍ ما اقتنى","واقتنى غيرَ كذابٍ ما اصطنع",1,"ع",1,0],["إنما ضيَّعَ البلادَ وأهلي","ها قديماً نساؤها الضعفاءُ",2,"ا",2,0],["إن ماضيّ ماثل فيه والحا","ضر أيضا ومقبلي المتداني",3,"ن",2,0],["إِنَّما ضَلَّلَ الفُؤا","دَ غَزالٌ مُرَبرَبُ",4,"ب",1,0],["إنما ضمتي من الشعر","والشعر ربيع زمانه ليس فاني",5,"ن",2,0],["إنما ضاق بالوجودات ذرعاً","أن تواريك في ثرى فبراها",6,"ا",3,0],["إنما ضرّ الفَتى أَو نفعُه","بيدي واهب ضرٍّ وَانتفاع",7,"ع",1,0],["إن ما ضاء كان بالأمس ظلما","ء وما ابيضَّ كان بالأمس أسود",8,"د",1,0]]}