لى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[466,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[466,"سقاني بكأسي ريقه ومدامه","https://www.aldiwan.net/poem3446.html","عموديه"],[466,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[468,"خلا الفيض مما حله فالخمائل","https://www.aldiwan.net/poem50381.html","الطويل"],[479,"دع العيس ترفل في الفدفد","https://www.aldiwan.net/poem15189.html","المتقارب"],[479,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[481,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[502,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[502,"خذوا بيد العبد الضعيف تكرما","https://www.aldiwan.net/poem38071.html","الرمل"],[516,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[517,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[517,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[553,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[553,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[564,"لقد حل الأمين ضريح مجد","https://www.aldiwan.net/poem52620.html","الوافر"],[564,"سلام على وادي الأراك وحاجر","https://www.aldiwan.net/poem52743.html","الطويل"],[564,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[587,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""],[587,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[588,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/29442","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27080","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/97826","الطويل"]],"verses":[["لَقَد حَلَّ وِدُّكَ مِن مُهجَتي","بِحَيثُ يُقيلُ الأَسى وَالإِسا",0,"ا",1,0],["لَقَد حُجِبَت عَينايَ عَن كُلِّ مَنظَرٍ","وَما خُلِقَت عَينايَ إِلّا لِتَنظُرا",1,"ر",2,0],["لقد حطّ فيكَ الرّحْلَ أيُّ خليفةٍ","أصيلِ المَعالي غُرّةٍ في بَني نَصْرِ",2,"ر",1,0],["لقدْ حلّ فيكَ العِزُّ والمَجْدُ والعُلا","وبدْرُ الدُّجى والمُسْتَجارُ منَ الذُّعْرِ",2,"ر",1,0],["لَقَد حانَ تَوديعُ العَميدِ وَإِنَّهُ","حَقيقٌ بِتَشييعِ المُحِبّينَ وَالعِدا",3,"د",2,0],["لَقَد حَوَت غَيرَ مِكسالٍ وَلا رَعِشٍ","إِن قَيَّدَ القُودَ مِن دونِ السُرى الكَسلُ",4,"ل",1,0],["لَقَد حاوَلوا العُظمى الَّتي لا شَوى لَها","فَأَعجَلَهُم عَقدٌ مِنَ الهَمِّ مُحصَفُ",5,"ف",1,0],["لَقَد حَمَلَت قَيسُ بنُ عَيلانَ حَربَها","عَلى مُستَقِلٍّ لِلنَوائِبِ وَالحَربِ",6,"ب",1,1],["لَقَد حَكَمَت يَومَ القَضيَّةِ بَينَنا","وَبَينَ اِمرئِ القَيسِ الِرماحُ الشَواجِرُ",7,"ر",1,1],["لقد حزتَ فضلاً يا أبا الفضل شاملاً","فيجزيك عن نصح البرايا شفيعُها",8,"ع",3,0],["لقد حلّ فيها لواءٌ مُريب","حلول الحقارة بين الجلال",9,"ل",1,0],["لقد حكّموا العادات حتى غدت لهم","بمنزلة الأقياد للأسراء",10,"ا",2,0],["لقد حكّموني في الأمور فلم أكن","لأنطِق إلاّ آمراً ومُطاعا",11,"ع",2,0],["لقد حار فكري في ذويك وإنه","ليختار في مثوى ذويك أو لو الفكر",12,"ر",1,0],["لَقَد حَدَبَت قَيسٌ وَأَفناءُ خِندِفٍ","عَلى مُرهَبٍ حامٍ ذِمارَ المَحارِمِ",13,"م",1,0],["لَقَد حَظِيَت يَوماً سُلَيمٌ وَعامِرٌ","وَعَبسٌ بِتَجريدِ السُيوفِ الصَوارِمِ",13,"م",1,0],["لَقَد حَلَفتَ وَلَم تَحلِف عَلى كَذِبٍ","يا اِبنَ الفُرَيعَةِ ما كُلِّفتَ مِن أَمَمِ",14,"م",1,0],["لقد حجَّ فيَّ الطيف بالوصل مرة","فهل هو في حجِّ الوصال معاوِدُ",15,"د",1,0],["لقد حارَ عبدكَ يا سيدي","وحقّ الجليل بحقّ الدَّقيق",16,"ق",1,0],["لقد حاكيتها وجداً وحيداً","عليه لحية النعمى وسامهْ",17,"م",2,0],["لقد حسنت فعالك في البرايا","فحسَّن فيكَ مادحك المقالا",18,"ل",2,0],["لقد حفظ الفتى ما في يديه","بغاية حيلة اللَّحِزِ الشحيحِ",19,"ح",1,0],["لقد حزَّر الحُزَّار منكم لعبدكم","وفاءً وإفضالاً فلا يخطئِ الحَزر",20,"ر",1,0],["لقد حرسا وصالك من ملالي","وصرمي شئت صرمي أو وصالي",21,"ل",2,0],["لقد حلَّ حُبُّ الأير منك بمنزلٍ","رفيعٍ فما يسطيعُه عذلُ عاذلِ",22,"ل",1,0],["لَقَد حَمَلَت قَيسَ بنَ عَيلانَ حَربُنا","عَلى يابِسِ السيساءِ مُحدَودِبِ الظَهرِ",23,"ر",1,0],["لَقَد حَلَفتُ بِما أَسرى الحَجيجُ لَهُ","وَالناذِرينَ دِماءَ البُدنِ بِالحَرَمِ",24,"م",1,0],["لَقَد حانَ كُلَّ الحَينِ مَن رامَ شاعِراً","لَهُ السَورَةُ العُليا عَلى كُلِّ شاعِرِ",25,"ر",1,0],["لَقَد حَسَدَتكِ أُمُّ الفَنِّ روما","كَما حَسَدَتكِ ضَرَّتُها أَثِنا",26,"ن",2,0],["لَقَد حَكَمَت بِفُرقَتِنا اللَيالي","وَلَم يَكُ عَن رِضايَ وَلا رِضاكا",27,"ك",2,0],["لقَد حُصِّلتِ يا رُندَهْ","فَصِرتِ لِمُلكِنا عِقدَهْ",28,"د",2,1],["لقد حبب الذكرى الى الشيخ انه","يحس له فيها رجوعاً الى الماضي",29,"ي",1,0],["لقد حلَّ مذ عامين في الدار هذه","فتى لنساء كالظباء يعول",30,"ل",1,0],["لَقَد حالَ بِالسَيفِ دونَ الوَعيدِ","وَحالَت عَطاياهُ دونَ الوُعودِ",31,"د",1,0],["لَقَد حازَني وَجدٌ بِمَن حازَهُ بُعدُ","فَيا لَيتَني بُعدٌ وَيا لَيتَهُ وَجدُ",32,"د",1,1],["لَقَد حالَ بَينَ الجِنِّ وَالأَمنِ سَيفُهُ","فَما الظَنُّ بَعدَ الجِنِّ بِالعُربِ وَالعُجمِ",33,"م",1,0],["لَقَد حَسُنَت بِكَ الأَوقاتُ حَتّى","كَأَنَّكَ في فَمِ الدَهرِ اِبتِسامُ",34,"م",1,0],["لقد حازَ نُعماهُ رجالٌ صفَتْ لهمْ","أصائلُ عيشٍ أرمضتهُ هواجرُهْ",35,"ر",2,0],["لَقَد حَمَلَ المُعتَزُّ أُمَّةَ أَحمَدٍ","عَلى سَنَنٍ يَسري إِلى الحَقِّ لاحِبُه",36,"ب",2,0],["لَقَد حَكَمَت فينا اللَيالي بِجورِها","وَحُكمُ بَناتِ الدَهرِ لَيسَ لَهُ قَصدُ",37,"د",1,0],["لَقَد حيطَ فَيءُ المُسلِمينَ بِحازِمٍ","كَلوءٍ لِفَيءِ المُسلِمينَ مُوَفِّرِ",38,"ر",1,0],["لَقَد حَمِدتُ صُروفاً مِنهُ عَرَّفَني","مَذمومُها عُصَباً مِمَّن عَلَيَّ وَلي",39,"ل",2,0],["لَقَد حَكَمَ البَينُ المُشَتِّتُ بِالبَلى","عَلَيكِ وَصَرفُ البَينِ أَجوَرُ حاكِمِ",40,"م",1,0],["لَقَد حُطتَ دينَ اللَهِ خَيرَ حِياطَةٍ","وَقُمتَ بِأَمرِ اللَهِ خَيرَ قِيامِ",41,"م",1,0],["لَقَد حَرَّمتِ مِن وَصلي حَلالاً","وَقَد حَلَّلتِ مِن هَجري حَراما",42,"م",2,0],["لَقَد حَبَوتُ صَفاءَ الوُدِّ صائِنَهُ","عَنّي وَأَقرَضتُهُ مَن لا يُجازيني",43,"ن",2,0],["لَقَد حَمَلَ الخِلافَةَ مُستَقِلٌّ","بِها وَبِحَقِّهِ فيها المُبينِ",44,"ن",1,0],["لَقَد حَلَبتُ الزَمانَ أَشطُرَهُ","طَبّاً بِما تَن