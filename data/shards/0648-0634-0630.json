{"poems":[[39,"وشذبت عنهم شوك كل قتادة","https://www.aldiwan.net/poem7203.html","الطويل"],[93,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[94,"أقبل الصبح يغني","https://www.aldiwan.net/poem38893.html","مجزوء الرمل"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"النساء والمسافات","https://www.poetsgate.com/ViewPoem.aspx?id=36380",""],[119,"من راحمي والقلب شبت ناره","https://www.aldiwan.net/poem40934.html","عموديه"],[128,"يا حلوة النظرات حسبك فتنة","https://www.aldiwan.net/poem23793.html","الكامل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[242,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[302,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[354,"جهل القياس وفاته القصد","https://www.aldiwan.net/poem15609.html","أحذ الكامل"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[505,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139044",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86616","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53943","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128005","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110326","الرمل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129818","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76133","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101879","الرمل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122490","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74080","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132166","الخفيف"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103010","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199048","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127096","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90874","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133133","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4755,"فَمُكِ الأَنِيقُ, وخَدُّكِ المُتَوَرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183694",""],[4869,"حاضر وانت غايب","https://www.poetsgate.com/ViewPoem.aspx?id=151570",""],[4881,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=187293",""],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[182,"قدٌّ من مرْمرْ","https://www.poetsgate.com/ViewPoem.aspx?id=72824",""],[4984,"ما تخبئه النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""],[5031,"من تفاصيل عشقٍ يوسفي","https://www.poetsgate.com/ViewPoem.aspx?id=148228",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5277,"ومضةٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198473",""],[5310,"إِلَى السَّمَاءِ الثَّامِنَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215363",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5463,"قصه كذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25529",""],[5526,"بسمه ورسمه","https://www.poetsgate.com/ViewPoem.aspx?id=195136",""],[5573,"ترجمتك في صمتي بوح","https://www.poetsgate.com/ViewPoem.aspx?id=200071",""],[5725,"عمّن سواك","https://www.poetsgate.com/ViewPoem.aspx?id=195059",""],[5736,"لا قانون .. لا منطق","https://www.poetsgate.com/ViewPoem.aspx?id=208194",""],[5747,"ياظالمه","https://www.poetsgate.com/ViewPoem.aspx?id=61683",""],[5790,"أعشق البيض ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=112098",""],[231,"وردة ذابلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79152&r=&rc=26",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""]],"verses":[["وشذّبتَ عنهم شوك كلِّ قتادة","بفارسَ يخشاها الأنيثُ المغمَّزُ",0,"ز",1,1],["وَشَذَوتُ مَع أَطيارِها وَسَهِرتُ مَع","أَقمارِها وَرَقَصتُ مَع شَلّالِها",1,"ل",3,0],["وشذاً حلواً وسِحْراً","وسَلاماً وظِلالْ",2,"ل",1,0],["وشذًى كأَجنحَةِ الملائكِ غامضٌ","سَاهٍ يُرفرفُ في سُكونٍ سَامِ",3,"م",1,0],["وشذًى يَضوعُ مع الأَشعَّةِ والرُّؤى","في معبدِ الحقِّ الجليلِ السَّامي",3,"ي",1,0],["وشذىً من زهرةٍ ناضرةٍ","جمّلتْ في مصرَ أزهَى زهرتينْ",4,"ن",1,0],["وشذاك المثير صار رماداً","أفأرثي شذاك ، أم أرثيك",5,"ك",1,0],["وشذا الازاهر عابق لم ادر هل","هو وحده ام هب فيه عراره",6,"ر",2,0],["وشذى كريا المجدلية في الهوى","وجوى كوجد الأخيلية عات",7,"ت",1,0],["وشذ نحو مجمع الابطال","واكسره من ذي الكسر والمثال",8,"ل",1,0],["وَشَذَا مَدْحِكُمْ فَائِحٌ","مَا هَمَى مُزْنٌ وَهَبَّتْ رِيَاحْ",9,"ح",1,0],["وَشُذورُ تبرٍ أَم جمانُ قَلائِدٍ","تَزهو وَتزهرُ في مقلَّد جؤذرِ",10,"ر",1,0],["وشذت لبعد العهد عنها فلم تكن","تذكرها إلا بتجديد نغمة",11,"ه",1,0],["وَشَذاهُ وَردٌ في غَضارَتِهِ","لَكِنَّ وَردَكَ عُرفُهُ نَدُّ",12,"د",1,0],["وشذا النسيم معجّلٌِ معروفهُ","لا خير في المعروف غير معل",13,"ل",1,0],["وشَذا نَشْرِ الحُمَيَّا","ما لنا منه هُجوعْ",14,"ع",1,0],["وشذا في أصفها","ن بالأغاني المطربات",15,"ت",1,1],["وَشذاه يَضوع مِنهُ بِمَصر","فيهِ عِندَ اللقا عَبيرٌ وَطيب",16,"ب",1,0],["وشذى المسكِ قاصِرٌ عن شذاهُ","إذ يُوافِي به هبوبُ النيسمِ",17,"م",1,0],["وشذّ في الموصول والمشاربه","أصلا وفرعا حيث جاز فانتبه",18,"ه",1,0],["وشذُّ غير ذاك للمريد","كقولهم تسمع بالمعيدي",18,"ي",1,0],["وشذ في عروضه الإقعاد","أي حذفها وفي جزى الإنشاد",19,"د",1,0],["وشذ أن تأتي تماما في سوى","مصرّع ونحن فيه قد هوى",19,"ه",3,0],["وشذّ أن تأتي له في النقل","كاملة قل يا ضعيف العقل",19,"ل",1,0],["وشذّ فيه عنهم محذوفه","حنّت له بقلّة معروفه",19,"ه",1,0],["وشذّ ما يأتي به الإكمال","وليس للكف به إعمال",19,"ل",1,0],["وشذ في غير المقفي كاسد","وإن تشعّث فامنع الخبن تفد",19,"د",1,0],["وشذّ قطع في القريض حل في","حشو وهذا عن سعيد قد ففي",19,"ي",1,0],["وشذّ دون هذه التمام","في الشعر حيث يثقل الكلام",19,"م",1,0],["وشذ رفع ما بجر تجعله","أرمض من تحت وأضحي من عله",19,"ه",1,0],["وشذا عبيرك فائح","أم ذاك مسك ضائع",20,"ع",1,0],["وشذاه عندما تغدو الصبا","ولها بين روابيه زفير",21,"ر",1,0],["وشذ ما منه مذيلا ورد","ولا أرى للقطع فيهما سند",22,"د",1,0],["وشذاه صانهُ حتى اغتدى","بين أيدي الريح غصبا يُنتَهب",23,"ب",1,0],["وَشَذاً بريقكَ أَم تأرجُ مِسكةٍ","وَسنا بِثَغرك أَم شعاعُ دراري",24,"ر",2,0],["وشذا العنبر والعود لقد","أرج الأرجاء بالنفحين",25,"ن",1,0],["وشذا القيصوم حيث انتشرا","مثله يوجد والشاهد فوه",26,"ه",1,0],["وشذراً مِن روائِعِكَ اللَّواتِي","جَذَبتَ بِها العواطِفَ والمُيُولا",27,"ل",2,0],["وَشَذاها فاضِح مَن","شور مطويّ الغَوالي",28,"ل",2,0],["وَشذَّ إيَّاىَ وَإيَّاهُ أشَذُّ","وَعَن سَبِيلِ القَصدِ مَن قَاسَ انتَبَذ",29,"ذ",1,0],["وَشذَّ حَذفُ أن وَنَصبٌ فِى سِوَى","مَا مَرِّ فاقبَل مِنهُ مَا عَدلٌ رَوَى",29,"ر",3,0],["وَشَذَّ فِى عِيدٍ عُيَيدٌ وَحُتِم","لِلجَمعِ مِن ذَا لِتَصغِيرٍ عُلِم",29,"م",1,0],["وَشذَّ تَركٌ دُونَ لَبسٍ وَنَدَر","لَحَاقُ تَا فِيمَا ثُلاَثِيا كَثَر",29,"ر",1,0],["وشذا الرند والبنفسج والزنبق","والورد والعرار شذاها",30,"ا",3,0],["وشذبته شباً تجلى الخطوب به","إذا الخطوب طغى تيارها الغمر",31,"ر",1,0],["وشذاً لو انتشقته أصداء البلى","طارت بأجنحة الحياة رمامها",32,"م",3,0],["وشذاذ طروادةٍ شرد","قضيضاً قلاعهم وردوا",33,"د",3,0],["وشذى من العطر الشذي نسيمها","فتضوعت من نشره الأرجاء",34,"ا",2,0],["وشذى نسيم الأنس في","سحر الأماني قد نفح",35,"ح",1,0],["وشذا نسيم الإنس والإيناس قد","عم السباسب والفلا والفدفدا",36,"د",2,0],["وشذاكم من مغاطسه يفوح","طول ليلٍ مع بكورٍ والعشي",37,"ي",1,0],["وشذا التهاني في البسيطى أعقبا","كم كاس بشرى من لمى فيه سقى",38,"ق",2,0],["وشَذَاكِ بينَ خُفُوتِهِ وحَيَائِهِ","بِيَدَيَّ يُشعِلُ لَوعَتِي ويُبَرِّدُ",39,"د",1,0],["وش ذنب قلبٍ يقضي الليل نآطر","وش ذنب روحٍ طآيحه في عذآبك",40,"ك",1,0],["وشذى الجلال يفيض فوق ترابه","والفخر يملأ أنفسا ونخيلا",41,"ل",2,0],["وشذا القرنفلُ هاج من أنفاسِهم","سَحَرًا وماءُ الورد من عَرَقِ البدن",42,"ن",1,0],["وشذاها يسبقُ طلَّتها","مسكٌ مجبولٌ في عنبر",43,"ر",1,0],["وشذى البراءة في العيون مخاتل","يروي لسرك ما تخبئه النجوم",44,"م",1,0],["وَشَذاكِ نَبْعٌ لاشْتِعالِي يَرتَوِي","مِنْ دَمْعَتي، وَالدَّمعُ شِعْراً أنْطَقَه",45,"ق",2,0],["وشذت لكم ريح الخزام بمدحة","حرى، شداها البلبل الصداح",46,"ح",1,0],["وشذاك من وجهِ الصباحِ عبيرُهُ","فيهِ المدى والكونُ والآفاقُ",47,"ق",1,0],["وَ شَذَاكِ؛ أَوْرِدَةُ النَّسِيْ","مِ؛ عَلى الْمُدَامَةِ لَا يَضِلُّ",48,"ل",1,0],["وشذى السمر لعنة في عروقي","ذلك العطر آثمٌ سفاكُ",49,"ك",1,0],["وش ذنوبه هالمتيّم لاهو حبّك بإقتناعه","وش ذنوبه لا انحرم من حبّ(ن) أسقاه العُذوبَه .. !",50,"ب",2,0],["وش ذبّل أغصان الزهر غير نسمه","تشبه ثمار التوت في موسم التوت",51,"ت",1,1],["وش ذنبي يومي مغليك","لو جيتك لدموعك خد",52,"د",1,0],["وشذاك يا آي الاريج اريجه","اشتاقه حد الممات زكاما",53,"م",2,0],["وشذا البنفسج في انسكاب ذراعه","وأنا لضمِّ عبيره اتحرّقُ",54,"ق",1,0],["وش ذكرك يابنت دامك تخونين","وش ذكرك حبٍ طوته الصحايف",55,"ف",1,0],["وشذا العنبر والمس","ك من الكافور أعبق",56,"ق",1,0],["وشذاها لم يزل يفعمني","فيعيد الشجو لي بالذكر",57,"ر",1,0],["وشذىً ألهم الهزار أغانيه","وروى ألحانه العندليبا",58,"ب",2,0]]}