{"poems":[[55,"لحب إلي بالدهناء ملقى","https://www.aldiwan.net/poem29852.html","الوافر"],[90,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[93,"سلام عليها طفلة وفتية","https://www.aldiwan.net/poem8831.html","عموديه"],[30,"لها صاحبا فقر عليها وصادع","https://www.aldiwan.net/poem5391.html","الطويل"],[46,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[89,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[76,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[107,"أهاب الحق فاستبقوا كراما","https://www.aldiwan.net/poem41938.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54209","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[113,"فدا لك روحي من رشا متبرم","https://www.aldiwan.net/poem16245.html","الطويل"],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[136,"ألا يا جبرائيل نماك دود","https://www.aldiwan.net/poem54855.html","الوافر"],[208,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[435,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[438,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62497","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108549","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131337","الرجز"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116518","الطويل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101888","الطويل"],[3239,"","https://poetry.dctabudhabi.ae/diwan/poem/145264","المنسرح"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3820,"","https://poetry.dctabudhabi.ae/diwan/poem/145477","الوافر"],[4728,"خليليّ مرا دار سلمى (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176875",""],[5020,"بنفسى من منعت نفعها","https://www.poetsgate.com/ViewPoem.aspx?id=201047",""],[5186,"يا طيب ليل بالأنس مرا","https://www.poetsgate.com/ViewPoem.aspx?id=156570",""],[778,"ليهنك نيروزا اتاك كأنه","https://www.poetsgate.com/ViewPoem.aspx?id=89222",""],[5703,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=210885",""],[5956,"أحب الحمير","https://www.poetsgate.com/ViewPoem.aspx?id=183417",""]],"verses":[["لَها صِنعٌ يَطولُ عَلى طُلاها","قَلائِدُ لا تُفَصَّلُ بِاللَآلي",0,"ل",2,0],["لها صيحة عند الولوج كأنها","تقول بها يا طود خلّ ليَ الدربا",1,"ب",2,0],["لَها صَولَةُ الأَبطالِ إِن حَمَسَ الوَغى","وَفيها حَياءُ البِكرِ عَمّا بِهِ وَزَرُ",2,"ر",1,0],["لَها صاحِبا فَقرٍ عَلَيها وَصادِعٌ","بِها البيدَ عادِيٌّ ضَحوكٌ مَناقِلُه",3,"ل",2,1],["لَها صَيحَةٌ في كُلِّ روحٍ وَمُهجَةٍ","وَلَيسَت بِشَيءٍ ما خَلا القَلبَ تُسمِعُ",4,"ع",1,0],["لَهَا صِبْيَةٌ لا بَارَكَ اللَّهُ فِيهِمُ","قِبَاحُ النَّوَاصِي لا يَنَمْنَ عَلَى حَالِ",5,"ل",1,0],["لَها صَقيلِ النورِ ثَغرٌ مُفَلَّجٌ","يَشوقُ وَمِن سَجعِ الحَمامَةِ مَنطِقُ",6,"ق",1,0],["لها صُورٌ يَروحُ بها ويغدو","طِوالَ الدّهرِ صَبَّاً مُسْتَهاما",7,"م",2,0],["لها صَفْحَةُ الْكَوْن مَنْشورةٌ","يُتَرْجم بالشّعر أَسْطارَها",8,"ر",3,0],["لها صَوْتُ دَاودٍ وحُسْنُ رَنِينه","إِذا ما عَلَتْ مَتْنَ النَّسِيم مَزَامِرُهْ",9,"ر",2,0],["لَها صَوت دَاود وَصُورة يوسف","وَحكمة لُقمان وَعفة مَريم",10,"م",1,0],["له اصح الارض عن آبائه","سادات قادات الورى خيارها",11,"ر",3,0],["لَها صُبحٌ تَبَلَجَّ تحت لَيلٍ","وألمَى وَاضحٍ عَسِلٌ بَرُودُ",12,"د",1,0],["لها صدقُ إعراضٍ وزُورُ تعرُّضٍ","فيا حَسرَتا من صدقها لي وزُورِها",13,"ر",3,0],["لَها صَحيفَةُ وَجهٍ يُستَضاءُ بِها","لَم يَعلُ ظاهِرَها بَثرٌ وَلا كَلَفُ",14,"ف",1,0],["لها صبح الجبين إذا","سرت في ظلمة الشعرِ",15,"ر",1,0],["لها صدرُ نهرٍ شقّ جيبَ أزاهرٍ","وغرّة أفْقٍ قلّصَتْ طُرَرَ الحُبْكِ",16,"ك",1,0],["لهُ أصلان في شرف ال","علا حازا لقاصيه",17,"ي",2,0],["لها صعدت بالحزن للعرش رنَّةٌ","بأعلى بيوت الوحي كانَ نزولها",18,"ل",3,0],["لها صولةٌ تعلو على كل صولةٍ","وغاية مجدٍ جاوزت كلَّ غايةِ",19,"ه",1,0],["له اصْطِبارٌ عندما طالَ السُّرى","وسَيْرُه مثلُ النَّسِيم إنْ سَرى",20,"ر",2,0],["له اصبع قد فاق قضبان فضة","وفي حاله شيخا كفى اول العمر",21,"ر",1,0],["لها صدر طاووس تطاول ناشراً","جناحيه بأمثال اللجين بلادهن",22,"ن",1,0],["لها صفات اللظى وداخلها","في جنة جمة ملاهيها",23,"ي",3,0],["لها صفة الإنسان والطبع أغلظ","وأقوى من الحمار في حال زفرة",24,"ه",1,0],["لها صفتان من نار وماء","يعمان الأسى غرقاً وشيا",25,"ي",2,0],["لها صورةٌ حَسْناءُ قدْ تمَّ حسْنُها","على كلِّ حسْنٍ باتَ حسْناً عَلِيَّا",26,"ي",2,0],["لها صفو ودّى ولكنّنى","حرمت على ودّها خيرها",27,"ر",3,0],["لها صلاتي خمسا وعشرا","لها صيامي عصرا ودهرا",28,"ر",2,0],["لها صورة في الكأس عند اجتلائها","حكت صورة الاقبال في فسحة العمر",29,"ر",1,0],["لها صبرٌ على نيلِ المَعالي","تَمازجَ بالدموعِ وبالدماءِ",30,"ا",2,0],["‏ ‏لها صبرُ أيوبَ في كل أمر","‏ ‏ وأنْكَرُ صوت يحاكي الدَّمارْ",31,"ر",1,0]]}