an/poem/127039","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70103","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73091","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136574",""],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198227","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133164","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133106","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4764,"غابت شموسك والأماني تحتريك","https://www.poetsgate.com/ViewPoem.aspx?id=25982",""],[4935,"لو كنت مثلي في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=129296",""],[4987,"الجدايل","https://www.poetsgate.com/ViewPoem.aspx?id=49582",""],[5055,"نايمة تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=108502",""],[5055,"ضرب الجوازي","https://www.poetsgate.com/ViewPoem.aspx?id=110085",""],[5843,"مكاسر عود جاوي!","https://www.poetsgate.com/ViewPoem.aspx?id=51287",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[572,"ياطِيبَ يومِ خَلاعة ٍ وبطَالة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9188&r=&rc=45",""]],"verses":[["يَومٌ حَدا الظُعنَ فيهِ لِاِبنِ فاطِمَةٍ","سِنانُ مُطَّرِدِ الكَعبَينِ مَطرورِ",0,"ر",1,0],["يَومَ حَجرٍ بِما أُزِلَّ إِلَيكُم","إِذ تُذَكّي في حافَتَيهِ الضِراما",1,"م",2,0],["يؤمّ حماهُ طالبٌ بعدَ طالبٍ","فذو الحال يستجدي وذو العلم يقتدي",2,"د",2,0],["يَومُ حَلقِ اللِمّاتِ ذاكَ وَهَذا ال","يَومُ في الرومِ يَومُ حَلقِ الحُلوقِ",3,"ق",1,0],["يَومَ حَلَّت مِن سَوادِ ال","قَلبِ مُحتَلّاً رَفيعا",4,"ع",2,0],["يَومَ حَنَّت إِلَيَّ مُرفَضَّةُ الدَم","عِ وَحَنَّت إِلى سِوايَ الرَبابُ",5,"ب",1,0],["يومٌ حَنَى التاريخُ هامَتهُ له","واصطفَّت الأحقابُ لاِستقبالِهِ",6,"ل",2,0],["يوم حُطَّت عمائم وأذاعت","سِرَّها فيه أَدْؤرٌ وخُدورُ",7,"ر",1,0],["يوم حانَ النَّوى فسالت دموع","لم أخَلْها إلاَّ انسجام ركام",8,"م",1,0],["يومَ حانَ الوداع من آل ميّ","فأرانا تَفَتُّتَ الأَكباد",9,"د",1,0],["يومٌ حكى فضلَك فامتاز لنا","عن شَبَهِ الأيّام أو أشكالها",10,"ل",3,0],["يومٌ حكاك شرفا وبهجةً","وفاق من يعقِلُ ما لم يعقِلِ",11,"ل",1,0],["يَؤُمُّ حَجيجَ المُسلِمينَ ابنُ فَرتَنى","فَهَب ذاكَ حَجّاً لَيسَ بِالمُتَقَبَّلِ",12,"ل",1,0],["يوم حسبت الجو يهمي عبرة","من ذكره بصواعق وجلامد",13,"د",1,0],["يَومٌ حَمَدْتُ بِهِ الزّمان وحُكِّمَتْ","فيه الشّمُولُ من العُقُولِ فَجَارَتِ",14,"ت",1,0],["يَوم حَربي","ما الفَرقُ إنَّك لَم تُحَلِّل",15,"ل",1,0],["يوم حل السرور قلب كريمٍ","طال ما سر في البرية معدم",16,"م",1,0],["يوم حفت بابن النبي رجالٌ","يملأون الدروع بأَساً وَخيرا",17,"ر",2,0],["يومٌ حدت ناياتُه عيدانَهُ","حَدْواً بمحثوثِ الغناءِ يشْيَّعُ",18,"ع",1,0],["يَوم حلّت به عَزائِم قَوم","صوحت من قلوبهم آمالاً",19,"ل",2,0],["يَومُ حَجٍّ إِلى المَدامِ وَقُربا","ن بَزق موثِق كَالهدي",20,"ي",1,1],["يومَ حَلوا نُبَيكةَ النصفِ إذ قَصَّ","رَ لهوي وحلَّمَتني السنونا",21,"ن",2,0],["يومُ حَشرٍ حوى البرايا جميعاً","شاخصاتٍ أبصارها فزعاء",22,"ا",2,0],["يؤم حماه من يوفقه القضا","ويصفو له فيه الزمان المعاند",23,"د",1,0],["يَوم حَيّانا تَدانت مِنهما","معطنا العيس وَاطناب القباب",24,"ب",1,0],["يوم حواشيه رقت","ومنه راقت مناظر",25,"ر",1,0],["يوم حسين بالحمى أرخوا","ذكرنا بالطف يوم الحسين",26,"ن",1,0],["يُؤمُّ حماهُ مَن يَحتاج غوثاً","فَيَلقى المبتغى وَيزادُ رشدا",27,"د",2,0],["يوم حرب الشاه تلقى ضَيغماً","منه يسطو بسلاحٍ فوق رال",28,"ل",1,0],["يوم حامى فيه أبو الفضل عمن","سبب اللَه فيهم الأسباب",29,"ب",1,0],["يَومُ حطِّينَ شِاهِدٌ لظُباكُم","كَم أَبادَت بِها هُناكَ قَتيلا",30,"ل",2,0],["يوم حنَّت نياقُنا فاستفزَّت","صّبٍ لضمة التوديع",31,"ع",1,0],["يومُ حازَ الأميرُ تاجَ فخَارٍ","مُذْ على عَرشِ حُكْمهِ وتَسنَّمْ",32,"م",1,0],["يؤم حبيباً في الركاب مسافراً","وقد صده الفقدان عن ذلك الغادي",33,"د",2,0],["يوم حشر يوم نشر","يوم الأخذ بالنواصي",34,"ص",2,0],["يوم حرٍ شمسه ذات ضرامْ","أحرقت في ذلك الجو الغَمامْ",35,"م",1,0],["يَوم حَسيت .. إبجنونٍ مِبتليك","إنجَلى عَن نَاظري .. غَيم الضَباب",36,"ب",1,0],["يوم حسابي أرتجي","منهم مآلاً طيبا",37,"ب",2,0],["يوم حد الغلا قلبي على أقصاه","شرع القلب بيبان المحاني",38,"ن",2,0],["يوم حل البوم في دار الغراب","ميتة الدنيا وماتت من جديد",39,"د",1,1],["يوم حازت بالنظر نجمي سرت","حدها مطواع في شاغي الكهوف",40,"ف",1,0],["يوم حط بدارها ذل هجرت","ونتخى مجد الفطاحل بالكتوف",40,"ف",1,0],["يوم حر الصيف يبعدها وياخذ من نصبها","ماتحلويت المنام اللي تحلواه العباوي",41,"ا",3,0],["يومَ حَظّي من المَسَرَّةِ وَافٍ","وشَرابي صَافٍ وعيشي رَغيدُ",42,"د",1,0],["يومٌ حَمَدْتُ بِهِ الزَّمانَ وأَحْكَمَتْ","فينا الشَّمُولُ عَلَى العقولِ فحارَتِ",43,"ت",1,0]]}