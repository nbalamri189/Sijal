{"poems":[[79,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[74,"هلال بأفقالملك تزهى سعوده","https://www.aldiwan.net/poem18551.html","الطويل"],[74,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[74,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[47,"تطلبت من أدعو لرد ظلامتي","https://www.aldiwan.net/poem63576.html","الطويل"],[63,"أأزجر همة لقيت هماما","https://www.aldiwan.net/poem51426.html","الوافر"],[35,"لقد هتفت في جنح ليل حمامة","https://www.aldiwan.net/poem25827.html","الطويل"],[285,"أصون لساني والجنان يذال","https://www.aldiwan.net/poem60596.html","الكامل"],[521,"لقد هتفت في جنح ليل حمامة","https://www.aldiwan.net/poem48614.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120017","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103561","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72358","المتقارب"],[5277,"نبتة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185021",""]],"verses":[["أَأَزَاهِيرُ رِيَاضٍ","أَمْ شِفَاءٌ لِعِيَاضِ",0,"ض",1,1],["أَأَزمَعتَ مِن آلِ لَيلى اِبتِكارا","وَشَطَّت عَلى ذي هَوىً أَن تُزارا",1,"ر",2,1],["أأزكى الورَى نفساً وأكرم معشراً","وأمكنهم من سؤدَدٍ تستجيدُه",2,"د",2,0],["أأزكى الورَى نفساً وأكرم أسرةً","وأرفعهم عن مشبهٍ ومثال",3,"ل",1,0],["أأزكى الورَى أسرة برّه","وأسعدهم همَّة عاليه",4,"ي",2,0],["أَأَزدادُ يَأساً كِلَّما زِدتُ واجِباً","عَلَيهِ بِمَدحي أَو تَزَيَّدَ في القَدرِ",5,"ر",1,0],["أَأَزْجُرُ هِمَّةً لَقيَتْ هُماما","وأَظِلمُ عَزْمةً جَلَتِ الظَّلاما",6,"م",2,1],["أَأَزعُمُ أَنّي عاشِقٌ ذو صَبابَةٍ","بِلَيلى وَلا أَبكي وَتَبكي البَهائِمُ",7,"م",1,0],["أَأَزْعُمُ أَنْ لا مالَ لِي بَعْدَ هذِهِ","وَجُودُكَ ذُخْرٌ لِلْمُقِلّ وَمالُ",8,"ل",1,0],["أَأَزعُم انّي هائِم ذو صَبابَة","لِسُعدى وَلا اِبكي وَتَبكي الحَمائِم",9,"م",1,0],["أأزعُم عِرْضَكَ من غائط","وأَنظفُ من عِرْضِك الغائط",10,"ط",1,0],["أأزول عن وطن وجدت به","نعمى بهاء الدين لي صَفَدا",11,"د",2,0],["أأزْمَعَ سَلْوَةَ أمْ بانَ غَدْراً","فإنّ الغَدْرَ من شيمِ الذّئابِ",12,"ب",1,0],["أأزعُم في نظم البديع ولم يزل","لك السبق فيه والورى لك تابعُ",13,"ع",1,0],["أأزعم أني في ولا الآل صادقا","كذبت وأيم الله لو كنت عاشقا",14,"ق",2,0],["أأزرعُ نبتةَ الدنيا بقلبي","وتحصدُها المناجلُ والسيوفُ...",15,"ف",1,1]]}