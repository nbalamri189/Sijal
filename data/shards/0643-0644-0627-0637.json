{"poems":[[46,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[76,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[154,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[534,"من غدا مستحكم الطمع","https://www.aldiwan.net/poem37326.html","المديد"],[541,"جبت لما أسرى الإله بعبده","https://www.aldiwan.net/poem23853.html","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120502","الكامل"],[4578,"بشاير وافتنا بسعد محمدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49407",""],[5970,"قد تبارى الناس في حب الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=130590",""],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""]],"verses":[["كِلا طَعمَيهِمُ سَلَعٌ وَصابٌ","فَأَيُّ مَذاقَتَيهِم تَستَطيبُ",0,"ب",1,0],["كُلّاً طَوى الدَهرُ فَلا ما وَهى","بِجانِبٍ دامَ وَلا ما وَهَب",1,"ب",1,0],["كِلا طَرَفَيهِ في السيادَةِ مُعرِقُ","فَما شِئتَ مِن أُسٍّ كَريمٍ وَمِن سَمكِ",2,"ك",1,0],["كِلا طرفَي حقِّ النبوّة باطلٌ","فَمَن زادهُ قَدراً كمن زادهُ حقرا",3,"ر",2,0],["كلا طرفيه من كرمٍ وعتقٍ","تأنَّق رابطٌ فيه وفالي",4,"ل",2,0],["كُلُّ أطُماعِ الْفَتَى شَرَهٌ","مالَها نَفْعٌ سِوى الْهَلَعِ",5,"ع",1,0],["كِلا طَلَقَيهِ كانَ مَنَّ بِبَعضِها","ذَهاباً وَإِقبالاً وَما مِن مُعَرَّسِ",6,"س",1,0],["كلا طمعي وجدواه عظيم","واحسب ذا على عفوي دليلا",7,"ل",2,0],["كل اطلاب ان يمر بباله","ويرم نداه سانح لا بارح",8,"ح",1,0],["كلا طرفيه جاء بالعيد والهنا","وطيب الصفا والأنس مع كل سودد",9,"د",1,0],["كل أطماع الفتي من عيشه","ضلة أوقعه فيها هواه",10,"ا",2,0],["كِلا طَرَفَيْهِ حِينَ تَنْسبُهُ إلى","عَلِيٍّ وخير المرسَلِينَ مُحَمَّدِ",11,"د",1,0]]}