{"poems":[[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"في أمان الله أنى سرت يا","https://www.aldiwan.net/poem18294.html","الرمل"],[72,"لمولودكم يا آل يحيى مزية","https://www.aldiwan.net/poem18529.html","الطويل"],[72,"لمولودكم يا آل يعقوب أنجم","https://www.aldiwan.net/poem19985.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[49,"لا بارك الله فيمن كان يخبرني","https://www.aldiwan.net/poem64133.html","البسيط"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[48,"اترك التقصير في الشر","https://www.aldiwan.net/poem64368.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"]],"verses":[["لِمُوسَى أَبِي حَمُّو بْنِ يُوسُفَ آيَةٌ","وَبُرْهَانُ صِدْقٍ لاَ يُعَانِدُهُ خَصْمُ",0,"م",1,0],["لِمُوقِعِ الأَمْرِ فِيهِمْ كُلُّ تَكْرمَةٍ","وَمُنْفِذِ الأَمْرِ فِيهِمْ كُلُّ نِسْيَانِ",1,"ن",1,0],["لمواليك ما ارْتجَى من بقاءٍ","ولشانيك ما اخْتشَى من فناء",2,"ا",2,0],["لموَاطِي طرقه كم مؤمن","قائل يا ليتني كنتُ ترابا",3,"ب",2,0],["لمولودكم يا آل يحيى مزيةٌ","من الفضلِ لا تخفى على كلِّ لامح",4,"ح",1,1],["لمولودكم يا آل يعقوب أنجم","من اليمن لم تحتج لحدس منجّم",5,"م",1,1],["لموَّلني إلى أن قال أهلي","أأحلامٌ يُخيِّلُها منامُ",6,"م",1,0],["لموجه غير الجريئ","الجلد لا يقتحم",7,"م",1,0],["لَمَوتَةٌ تَأخُذُ الإِنسانَ واحِدَةٌ","خَيرٌ لَهُ مِن لِقاءِ المَوتِ مَرّاتِ",8,"ت",1,0],["لَمَوقِعُ الهِجرانِ بَينَ الحَشا","أَنفَذُ مِن رِشقٍ بِنُشّابِ",9,"ب",1,0],["لِم وَعَفوُ اللَهِ مَبذو","لٌ غَداً عِندَ الصِراطِ",10,"ط",1,0],["لموت الفَتى خير له من معيشة","يَكون بها عبئاً ثَقيلا عَلى الناس",11,"س",1,1]]}