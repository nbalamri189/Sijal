/poem/59494","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111481","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101387","الطويل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141850","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127323","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123490","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123521","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91015","الطويل"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58100","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57965","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72644","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72546","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139579",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4728,"ثمان وربع","https://www.poetsgate.com/ViewPoem.aspx?id=176877",""],[4829,"بنات الجن","https://www.poetsgate.com/ViewPoem.aspx?id=34266",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5183,"الموقف الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=180261",""],[5277,"البشير","https://www.poetsgate.com/ViewPoem.aspx?id=185161",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5431,"موسى والخضر وقلبي...","https://www.poetsgate.com/ViewPoem.aspx?id=189801",""],[5431,"نفحات الفن ...","https://www.poetsgate.com/ViewPoem.aspx?id=209138",""],[5452,"\"موسى\"","https://www.poetsgate.com/ViewPoem.aspx?id=119182",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5823,"أيا موت زر","https://www.poetsgate.com/ViewPoem.aspx?id=59147",""],[6068,"سحّتْ دموعي لجّها تهيّيجا -17-","https://www.poetsgate.com/ViewPoem.aspx?id=175813",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[4115,"لمولانا اليد البيضاء نزهو","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607721",""]],"verses":[["لِمُوسَى أَبِي حَمُّو بْنِ يُوسُفَ آيَةٌ","وَبُرْهَانُ صِدْقٍ لاَ يُعَانِدُهُ خَصْمُ",0,"م",1,0],["لِمُوقِعِ الأَمْرِ فِيهِمْ كُلُّ تَكْرمَةٍ","وَمُنْفِذِ الأَمْرِ فِيهِمْ كُلُّ نِسْيَانِ",1,"ن",1,0],["لمواليك ما ارْتجَى من بقاءٍ","ولشانيك ما اخْتشَى من فناء",2,"ا",2,0],["لموَاطِي طرقه كم مؤمن","قائل يا ليتني كنتُ ترابا",3,"ب",2,0],["لمولودكم يا آل يحيى مزيةٌ","من الفضلِ لا تخفى على كلِّ لامح",4,"ح",1,1],["لمولودكم يا آل يعقوب أنجم","من اليمن لم تحتج لحدس منجّم",5,"م",1,1],["لموَّلني إلى أن قال أهلي","أأحلامٌ يُخيِّلُها منامُ",6,"م",1,0],["لموجه غير الجريئ","الجلد لا يقتحم",7,"م",1,0],["لَمَوتَةٌ تَأخُذُ الإِنسانَ واحِدَةٌ","خَيرٌ لَهُ مِن لِقاءِ المَوتِ مَرّاتِ",8,"ت",1,0],["لَمَوقِعُ الهِجرانِ بَينَ الحَشا","أَنفَذُ مِن رِشقٍ بِنُشّابِ",9,"ب",1,0],["لِم وَعَفوُ اللَهِ مَبذو","لٌ غَداً عِندَ الصِراطِ",10,"ط",1,0],["لموت الفَتى خير له من معيشة","يَكون بها عبئاً ثَقيلا عَلى الناس",11,"س",1,1],["لمولاي يا مولى البرايا وعلة ال","وجود وباب الوصل للقاص والداني",12,"ن",2,0],["لِمَوْتِ مَن استهدى به كل جاهل","فأضْحى حليفاً للهُدَى وهْو طَيّعُ",13,"ع",1,0],["لِمُؤَيَّدِ الإِقدامِ بِالرَأيِ الَّذي","لَم يَأتِهِ عَمروٌ وَلا وَردانُهُ",14,"ن",2,0],["لموتي قبل ذاك بحسن مسّ","أحبّ إلي من فقر بوكسِ",15,"س",1,0],["لِمُؤَيِّدِ الإِسلامِ كَف","فٌ لا يُساجِلُها السَحابُ",16,"ب",1,0],["لِمَوْلاَنَا ابْنِ مَوْلاَنَا التُّهَامِي","مَنَارِ الرُّشْدِ أَمْلَيْتُ الْجَوَابَا",17,"ب",2,0],["لمؤتمر يحوي القبائل كلها","تنحيت فيه كي يشيروا وينصبوا",18,"ب",3,0],["لمولى الظفر سيف الله عبد ال","حميد المرتضى سامي الفعال",19,"ل",1,0],["لمواريث الرسول حووا","وأمير المؤمنين على",20,"ل",2,0],["لِمَوانعٍ في طيّها اِستنظارهُ","قولي وَقد يَستجفلُ المستنظرُ",21,"ر",1,0],["لَمَوتُ الفَتى خَيرٌ مِنَ البُخلِ لِلفَتى","وَلَلبُخلُ خَيرٌ مِن سُؤال بَخيلِ",22,"ل",1,0],["لموسى يد في البخل قد قيل انها","إذا ما تبدت وهي مقفلة قفل",23,"ل",1,1],["لَموعانِ مثْلَ الكوكبَيْنِ تقارَنا","بلَيلٍ أثارتْهُ السَّنابِكُ أَقْتَم",24,"م",1,0],["لُمُّوا الشتاتَ ، فإنَّنا في عالَمٍ","قد فرقتهُ عن الصراطِ دُرُوبُ",25,"ب",1,0],["لِمولايَ عندي أيادٍ تَجلُّ","وتكثُرُ عن صِفَةِ الواصِفِ",26,"ف",1,1],["لِمَوْعِدٍ غيرِ مكذوبٍ عواقِبُهُ","فِي مَتْجَرٍ غَيرِ مُزْجاةٍ بضائِعُهُ",27,"ع",2,0],["لِمواكِبٍ صَهَلَتْ إليكَ خُيولُها","وكتائِبٍ خَفَقَتْ عَلَيْكَ بُنودُها",28,"د",3,0],["لُمْ وقلْ إني عدوّ كاشحٌ","ذابَ غيظاً لا تقل إني عذولُ",29,"ل",1,0],["لُمُّوا كسوري فما في الأرض منقبةٌ","أعلى بصاحبها من جبر أكساري",30,"ر",2,0],["لموت العارف المولى الولي ال","المربيّ من معارفه صنوفُ",31,"ف",1,0],["لموت الفاضل الشيخ الشريف ال","مولى وانّه نعم الشريف",31,"ف",1,0],["لموقه سارتْ مطاياهمُ","قلبٌ على بينهمُ مُوجَعُ",32,"ع",1,0],["لِموسَى بُسْتُرُسْ نَجلٌ سعيدٌ","بَنى داراً لها شأنٌ عظيمُ",33,"م",1,1],["لِمَولِدِكَ المَيمونِ آيٌ شَهيرَةٌ","شَفَت غُلَّةَ الراوينَ مِن قَولِها الشَّفّا",34,"ف",2,0],["لموت إمام الدين والعلم والتقى","مذيق العدى كاسات سم الأقاليا",35,"ي",2,0],["لمواصلات بلادنا بأن وزيرها","مقدامنا الممدوح والمحمود",36,"د",1,0],["لموتهم أطقت له انضماما","ولولا ذاك لم تُطق اتساعا",37,"ع",2,0],["لمَولى الأنام الإمام الكبير","أزفّ التهاني بيوم الغديرِ",38,"ر",1,1],["لمواقد النيران تصعد في دمي","للموج ينهض للخطوب النازله",39,"ل",2,0],["لِمؤمنٍ إلاّ ومنها به","غُصنٌ ومنها ما به اثنانِ",40,"ن",1,0],["لموقفهم في الطف أنبى مواقفاً","بصفين جازت في الوغى منتهى الوصف",41,"ف",1,0],["لِمَولانا أَمير العَدل مُلك","بِهِ اِنسَلَبت يَدُ الكُفر اِنسِلابا",42,"ب",2,0],["لموجدة القلب المفجع موقع","ولكن إلى الحكم الإلاهي نرجع",43,"ع",1,1],["لمولاك ريحان وَروْحٌ وجنَّة","كما للعدى أغْلالُها والسلاسل",44,"ل",1,0],["لمولى الوَرى المستنصر الكاشف الدجى","وصفوةِ من أمسى على الأرض ماشيا",45,"ي",2,0],["لِمَولِدِهِ اِهتَزَّ الوُجودُ وَأَشرَقَت","قُصورٌ بِبُصرى أَشرَفَت وَبُروجُ",46,"ج",1,0],["لموتك في اضالعنا دويّ","وعصف مستبد في الكبود",47,"د",1,0],["لموسى أعبدٌ وأنا أخوه","وصاحبه ومالي غير عبد",48,"د",1,1],["لِمَوْلِدِهِ جَلَّ مِنْ مَولْدٍ","خَبَتْ نَارُ فَارِسَ وَالْمَاءُ غَارَا",49,"ر",2,0],["لِمَوْلاَيَ سَيْفِ الدِّينِ فِي الفِقْهِ بَيْنَنَا","مَقَامُ اجْتِهَادٍ لَيْسَ يَلْحَقُهُ الحَيْفُ",50,"ف",1,1],["لِمَوْلِدِهِ نِيرَانُ فَارِسَ أُخْمِدَتْ","فَعُطِّلَ مِنْهَا كُلُّ أَفْيَحَ مُسْوَدِّ",51,"د",1,0],["لموعظة رَآها في","أَبيهِ لَها رَأَيتُ أَبي",52,"ب",2,0],["لموسى بن عمرانَ لم يُفلق","ولا يومُ حربٍ على الشركِ فاظ",53,"ظ",1,0],["لموسى بنِ عمرانٍ من الآيةِ الكبرى","ترى الفضلَ فيها إنها في رفاغةٍ",54,"ه",1,0],["لُم وفنّد واملإِ الدنيا","ملاماً واتهاما",55,"م",2,0],["لموت نائمة بليل","على رجل بقارعة الصعيد",56,"د",1,1],["لم ولا ولو لكراع قد دعيت أجب","للإقتداء بذخري سيد البشر",57,"ر",1,0],["لموت أمي أرى الأحزان تحنيني","فطالما لَحّستني لحس تحنيني",58,"ن",2,1],["لموحدين الههم لم يجعلوا","معه سواه ولا أتوا ما حرما",59,"م",2,0],["لمولاك أكثر من سجودك يا فتى","وعالج به داء الذنوب وآسه",60,"ه",1,1],["لمولاي العزيز عليّ فضل","بنعمته على ولدي الأمين",61,"ن",1,1],["لموتهِ يبكون بالدموعِ","والدهر كم فرَّق من جموعِ",62,"ع",1,0],["لمولانا الإمام ومن ترقى","على كل الملوك بكل فخر",63,"ر",1,0],["لم وبل نيلي لم يزل مغدودقا","من غير مال بل يقينا جازما",64,"م",2,0],["لِمَوجَةِ الصَّلِيبِ يَا حَمِيدَا","وَالوَاجِبُ أن هَاهُنَا تَزِيدَا",65,"د",2,0],["لمولد مَن لَهُ رقصت حُظوظ","لَها شيَخ التَصابي اليَوم رابح",66,"ح",1,0],["لِمَولِدِها لاحَت سُعود فَأَرخَت","كَمال الهَنا تَشريف مَولد زَينَب",67,"ب",1,0],["لموحٌ بِلخصاوَينِ كَالنار أُشعِلَت","يَرى بِهما ما كانَ أَخفى مِن النَملِ",68,"ل",1,0],["لمولده نيران فارس أخمدت","وإيوان كسرى كسره ليس يجبر",69,"ر",1,0],["لمولاك فاشكر وقل أنه","بمحمود سري لقد سرني",70,"ن",2,0],["لموسى والجواد زججت عيسي","أجدُّ السير وخداً بعد وخدِ",71,"د",1,1],["لموسى لحظه في النّاس جُرحٌ","ونارُ الخدّ أحرقت النّفوسا",72,"س",2,1],["لمولده الأسنى تدلت كواكب","وحفت به الأملاك وازدحم الحفل",73,"ل",1,0],["لِمَوطِئِ شَيخِ العَصرِ قاضي قُضاتِها","إِمامٌ لَدى أَعتابِهِ السَعدُ خَيّما",74,"م",2,0],["لموت الفتى خير له من معيشة","تقضى نزاعا بين هم ووسواس",75,"س",1,1],["لِمَوْلانا الْخَليفَةِ فِيهِ رَأْيٌ","حَديدٌ لا يَفِيلُ وَلا يُفَلُّ",76,"ل",1,0],["لِموذيةٍ لدى منَحٍ رسُومُ","تلوحُ وعهدُها بالٍ قديمُ",77,"م",1,1],["لموذيةٍ بين الانَيْعمِ فالخالِ","محلٌّ محيلٌ طاسم ما صِحٌ خالي",78,"ل",2,1],["لُموذيةِ أقٌوَت سِنيناً وَغَّيرتْ","معَاِهدها أيدي البلى والَتفرقِ",79,"ق",1,0],["لموذيةٍ بالسَّفحِ من منَحٍ طَلَلْ","أرَبَّت بهِ هوجُ المراويدِ فاضمحلْ",80,"ل",1,1],["لِمَواقِفِ الاُسطُولِ سارَ وَإِنَّما","هَيهاتِ مِن تِلكَ الرِّسالَةِ يَرجِعُ",81,"ع",1,0],["لِمَوقِفِ الأُسطولِ يَسفِكُ الدِما","حَتّى يَرى قُدسَ الدُجى قَد خَيَّما",82,"م",2,0],["لِمَوقِفِ الأُسطولِ يَسفِكُ الدِما","حَتّى تَرى قُدسَ الدُجى قَد خَيَّما",82,"م",2,0],["لموع ثنايا الثغر لولا ابتسامه","لما ابتسم الشيب اللموع بمفرقي",83,"ق",2,0],["لمولانا شهاب الدين حَدْس","ضياه قد أعاد الشمس كسْفا",84,"ف",2,1],["لمولانا اليد البيضاء تزهو","بلا سوء وتنفق ما لديه",85,"ه",1,1],["لمولده الاوثان خرّت كما بدا","بكسرى انكسار عندما كسر الصرح",86,"ح",1,0],["لمولاك هد واسمع أوامر وعد","ومكرك صد لا أمك الكره واللدم",87,"م",1,0],["لمولده المشهود تاريخه دعا","بإقبال وضع يا محمد يا علي",88,"ل",2,0],["لمؤيد من ربه القهار","بالمعجزات جلَتْ عمى الأبصار",89,"ر",1,0],["لمولاي كلُّ الحمدِ والمجدُ والثنا","وكلُّ مديحٍ في الورى أيُّ باطل",90,"ل",1,1],["لموتِ تقي عالم متورِّع","حليم منيب ماله في الورى هَبُّ",91,"ب",1,0],["لموتِ حليفِ العلمِ والحلمِ والهدى","ومن لبني الدنيا جميعهمو ذخرُ",92,"ر",1,0],["لمولاه أهدى الرقيق رقيقا","من الشعر ضخم المعاني دقيقا",93,"ق",2,1],["لمولانا الشهاب علا يراع","على الأعلام من هضبات نجده",94,"د",2,1],["لمولانا أمير المؤمنينا","مدى الاعصار كل المادحينا",95,"ن",2,1],["لموضح علمِ أعلامٍ علاهم","توحَّد فذُّه يأبي ازدواجا",96,"ج",2,0],["لموسى والجواد السبط سبطى","رسول الله خير الأنبياء",97,"ا",2,0],["لمَولدِهِ غَنّى الزَّمانُ وغرَّدا","وعاينَ بعدَ الحزنِ من جاءَ مُسعِدا",98,"د",2,1],["لموعد ظبيةٍ تسكن حنايا سِبْع","يزيّنها الغلا لو إنها شانت",99,"ت",1,0],["لمولد احمد(ن) ارتج كسرى","وفي موت الحبيب ارتج كزْنا",100,"ن",2,0],["لموت إمام المسلمين محمداً","مصاب على الدين الحنيفي والتقى",101,"ق",2,0],["لموتُ إمام المسلمين محمد","مصاب على الدين الحنيفي والتقى",102,"ق",2,0],["لُمّوا الجِراح وودَّعوا أحزانكم","وامْحوا المَواجع في العراق تَسمّحا",103,"ح",2,0],["لِمَوْلِدِ الْحَقِّ فِي رَسُولٍ","مُحَمَّدٍ أَحْمَدِ الْخِصَالِ",104,"ل",1,0],["لموسى بهذا القلب خضرٌ ومركبُ","وأسفار أفكارٍ إلى الشك أقربُ",105,"ب",1,1],["لموائد العشاق في خلواتهم","حرف الصبابة خمرهم والقوت",106,"ت",1,0],["لموساي التشوّق يستجدّ","نوالا قربه أو ما يعدُّ",107,"د",1,1],["لمولاي هذي منة فوق منة","تلألأ معناها وفاح عبيرها",108,"ر",3,0],["لموقع نور المصطفى وإحاط","له بمفاتيح العلوم الكريمتي",109,"ت",2,0],["لمَوْتٌ يُخَفِّفُ حزني وغمِّي","ويُخْمِدُ نارَ الأسى وحريقَه",110,"ق",2,0],["لمّوا شتات الهم لمّ مبعثر","إنّ الهموم لتستبيح حريجا",111,"ج",2,0],["لم وافقوا سالب الزهراء نحلتها","وتلك خير ابنة تعزى لخير أب",112,"ب",1,0],["لموا السلاح وضيعوا الباس وَالشيم","وَصاروا بريده بعد ما هم عال",113,"ل",1,0],["لمولانا اليد البيضاء نزهو","بلا سوء وتنفق ما لديه",114,"ه",1,1]]}