{"poems":[[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"في أمان الله أنى سرت يا","https://www.aldiwan.net/poem18294.html","الرمل"],[72,"لمولودكم يا آل يحيى مزية","https://www.aldiwan.net/poem18529.html","الطويل"],[72,"لمولودكم يا آل يعقوب أنجم","https://www.aldiwan.net/poem19985.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[49,"لا بارك الله فيمن كان يخبرني","https://www.aldiwan.net/poem64133.html","البسيط"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[48,"اترك التقصير في الشر","https://www.aldiwan.net/poem64368.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[113,"أغث يا ختام المرسلين بإحسان","https://www.aldiwan.net/poem42161.html","الوافر"],[126,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[141,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[184,"أصون دراهمي وأذب عنها","https://www.aldiwan.net/poem43715.html","الوافر"],[233,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[235,"لعبد الله وجهت الخطابا","https://www.aldiwan.net/poem18079.html","الوافر"],[237,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[283,"هنيئا عزت المختار فاسعد","https://www.aldiwan.net/poem39419.html","الوافر"],[302,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[303,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[336,"بخلت وليس البخل مني سجية","https://www.aldiwan.net/poem68624.html","الطويل"],[340,"لموسى يد في البخل قد قيل انها","https://www.aldiwan.net/poem55371.html","البسيط"],[362,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[397,"بسلامة الصدر الحياة تطيب","https://www.aldiwan.net/poem6747.html","عموديه"],[402,"لمولاي عندي أياد تجل","https://www.aldiwan.net/poem49861.html","المتقارب"],[436,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[456,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[456,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[475,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[560,"لموسى بسترس نجل سعيد","https://www.aldiwan.net/poem52668.html","الوافر"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[585,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["لِمُوسَى أَبِي حَمُّو بْنِ يُوسُفَ آيَةٌ","وَبُرْهَانُ صِدْقٍ لاَ يُعَانِدُهُ خَصْمُ",0,"م",1,0],["لِمُوقِعِ الأَمْرِ فِيهِمْ كُلُّ تَكْرمَةٍ","وَمُنْفِذِ الأَمْرِ فِيهِمْ كُلُّ نِسْيَانِ",1,"ن",1,0],["لمواليك ما ارْتجَى من بقاءٍ","ولشانيك ما اخْتشَى من فناء",2,"ا",2,0],["لموَاطِي طرقه كم مؤمن","قائل يا ليتني كنتُ ترابا",3,"ب",2,0],["لمولودكم يا آل يحيى مزيةٌ","من الفضلِ لا تخفى على كلِّ لامح",4,"ح",1,1],["لمولودكم يا آل يعقوب أنجم","من اليمن لم تحتج لحدس منجّم",5,"م",1,1],["لموَّلني إلى أن قال أهلي","أأحلامٌ يُخيِّلُها منامُ",6,"م",1,0],["لموجه غير الجريئ","الجلد لا يقتحم",7,"م",1,0],["لَمَوتَةٌ تَأخُذُ الإِنسانَ واحِدَةٌ","خَيرٌ لَهُ مِن لِقاءِ المَوتِ مَرّاتِ",8,"ت",1,0],["لَمَوقِعُ الهِجرانِ بَينَ الحَشا","أَنفَذُ مِن رِشقٍ بِنُشّابِ",9,"ب",1,0],["لِم وَعَفوُ اللَهِ مَبذو","لٌ غَداً عِندَ الصِراطِ",10,"ط",1,0],["لموت الفَتى خير له من معيشة","يَكون بها عبئاً ثَقيلا عَلى الناس",11,"س",1,1],["لمولاي يا مولى البرايا وعلة ال","وجود وباب الوصل للقاص والداني",12,"ي",1,0],["لِمَوْتِ مَن استهدى به كل جاهل","فأضْحى حليفاً للهُدَى وهْو طَيّعُ",13,"ع",1,0],["لِمُؤَيَّدِ الإِقدامِ بِالرَأيِ الَّذي","لَم يَأتِهِ عَمروٌ وَلا وَردانُهُ",14,"ن",2,0],["لموتي قبل ذاك بحسن مسّ","أحبّ إلي من فقر بوكسِ",15,"س",1,0],["لِمُؤَيِّدِ الإِسلامِ كَف","فٌ لا يُساجِلُها السَحابُ",16,"ب",1,0],["لِمَوْلاَنَا ابْنِ مَوْلاَنَا التُّهَامِي","مَنَارِ الرُّشْدِ أَمْلَيْتُ الْجَوَابَا",17,"ب",2,0],["لمؤتمر يحوي القبائل كلها","تنحيت فيه كي يشيروا وينصبوا",18,"ب",3,0],["لمولى الظفر سيف الله عبد ال","حميد المرتضى سامي الفعال",19,"ل",1,0],["لمواريث الرسول حووا","وأمير المؤمنين على",20,"ل",2,0],["لِمَوانعٍ في طيّها اِستنظارهُ","قولي وَقد يَستجفلُ المستنظرُ",21,"ر",1,0],["لَمَوتُ الفَتى خَيرٌ مِنَ البُخلِ لِلفَتى","وَلَلبُخلُ خَيرٌ مِن سُؤال بَخيلِ",22,"ل",1,0],["لموسى يد في البخل قد قيل انها","إذا ما تبدت وهي مقفلة قفل",23,"ل",1,1],["لَموعانِ مثْلَ الكوكبَيْنِ تقارَنا","بلَيلٍ أثارتْهُ السَّنابِكُ أَقْتَم",24,"م",1,0],["لُمُّوا الشتاتَ ، فإنَّنا في عالَمٍ","قد فرقتهُ عن الصراطِ دُرُوبُ",25,"ب",1,0],["لِمولايَ عندي أيادٍ تَجلُّ","وتكثُرُ عن صِفَةِ الواصِفِ",26,"ف",1,1],["لِمَوْعِدٍ غيرِ مكذوبٍ عواقِبُهُ","فِي مَتْجَرٍ غَيرِ مُزْجاةٍ بضائِعُهُ",27,"ع",2,0],["لِمواكِبٍ صَهَلَتْ إليكَ خُيولُها","وكتائِبٍ خَفَقَتْ عَلَيْكَ بُنودُها",28,"د",3,0],["لُمْ وقلْ إني عدوّ كاشحٌ","ذابَ غيظاً لا تقل إني عذولُ",29,"ل",1,0],["لُمُّوا كسوري فما في الأرض منقبةٌ","أعلى بصاحبها من جبر أكساري",30,"ي",1,0],["لموت العارف المولى الولي ال","المربيّ من معارفه صنوفُ",31,"ف",1,0],["لموت الفاضل الشيخ الشريف ال","مولى وانّه نعم الشريف",31,"ف",1,0],["لموقه سارتْ مطاياهمُ","قلبٌ على بينهمُ مُوجَعُ",32,"ع",1,0],["لِموسَى بُسْتُرُسْ نَجلٌ سعيدٌ","بَنى داراً لها شأنٌ عظيمُ",33,"م",1,1],["لِمَولِدِكَ المَيمونِ آيٌ شَهيرَةٌ","شَفَت غُلَّةَ الراوينَ مِن قَولِها الشَّفّا",34,"ف",2,0],["لموت إمام الدين والعلم والتقى","مذيق العدى كاسات سم الأقاليا",35,"ي",2,0]]}