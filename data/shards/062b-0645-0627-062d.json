{"poems":[[37,"لمن الديار بأبرق الحنان","https://www.aldiwan.net/poem38817.html","الكامل"],[60,"لما رأيت الأمر أمرا منكرا","https://www.aldiwan.net/poem31074.html","الرجز"],[33,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[50,"ومجلس ما له شبيه","https://www.aldiwan.net/poem64501.html","مجزوء البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[406,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[445,"ثم أَحييت فجرهم يا ابن يحيى","https://www.aldiwan.net/poem34746.html","الخفيف"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71005","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46438","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109300","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10478","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205843","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201612","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205016","الرمل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115644","الرمل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100190","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[4691,"( أبصرا صاحبيّ عيني غدير)","https://www.poetsgate.com/ViewPoem.aspx?id=61597",""],[5163,"أمطري يا سماء","https://www.poetsgate.com/ViewPoem.aspx?id=33942",""],[5431,"أنا سوري","https://www.poetsgate.com/ViewPoem.aspx?id=185605",""],[5895,"نقرتْ سهيدةُ","https://www.poetsgate.com/ViewPoem.aspx?id=198608",""],[6004,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=33680",""]],"verses":[["ثُمَّ اِحتَمَلنَ غُدَيَّةً وَصَرَمنَهُ","وَالقَلبُ رَهنٌ عِندَ عَزَّةَ عانِ",0,"ن",1,0],["ثُمَّ اِحتَفَرتُ حُفَراً وَحُفَراً","وَقَنبَرٌ يَحطِمُ حَطماً مُنكَراً",1,"ر",2,0],["ثُمَّ أَحيَيتُهُ أُنازِعُ فيهِ","شادِناً أَحوَراً أَغَنَّ رَخيما",2,"م",2,0],["ثُمَّ اِحتَبى مُسرِعاً وَغَنّى","بِخُسرَوِيٍّ لَهُ دَلالُ",3,"ل",1,0],["ثُمَّ أحسست أنَّ رأسي يغلي","مثلما يغلي بالوقود القدور",4,"ر",1,0],["ثمَّ أَحياهُما القديرُ فحازا","شرفَ الدين حبّذا الإحياءُ",5,"ا",2,0],["ثم أحيا القلوب بعدَ مواتٍ","وحماها من وسوسات اللعين",6,"ن",1,0],["ثم أَحْيَيتَ فجرَهُمْ يا ابنَ يحيى","بِسِراجَيْنِ نورِ دينِ ودُنيا",7,"ي",2,1],["ثُمَّ احتوى حَكَمٌ مثنى وَزارَتِها","فَفُزْتُمُ بالعلا مثنىً وَوِحْدانا",8,"ن",2,0],["ثم أحياه ربه يوم حشر","عرف الكل واهتدى بلغات",9,"ت",1,0],["ثم احذروا جورْ صروفِ الدنا","لو حاد عن طرْق الهدى الحائدون",10,"ن",1,0],["ثُمَ احتجاج العامل","بِهِ لِكُل باطل",11,"ل",1,0],["ثم أحرم بالحج من مسجد ال","جن إذا ما اعتمرت تأتِ كمالا",12,"ل",2,0],["ثم أحرم من الحليفة إن","أقبلت من يثربٍ لها إقبالا",12,"ل",2,0],["ثم أحرم بعد الوضوء وإلا","فاغتسل إن أطقت اغتسالا",12,"ل",2,0],["ثُم اِحتَجَبت تخالُ قَولك مثله","بِمشبّهٍ مَمدوحه بِذَكاء",13,"ا",2,0],["ثم أحيتني براح","عصرت من شفتيها",14,"ي",3,0],["ثُمَّ احكُمُوا مِن بَعُد مَن هَذا الذِي","أولَى بِهَذَا الشَّبهِ بِالبُرهَانِ",15,"ن",1,0],["ثُمَّ اِحضُرونا إِذا ما اِحمَرَّ أَعيُنُنا","في كُلِّ يَومٍ يُزيلُ الهامَ مَذكورِ",16,"ر",1,0],["ثم أحنى على الامام مكبا","ذابحاً بالمهند الصمصام",17,"م",1,0],["ثم أحيى ذكراك ميتاً وقد خل","لدت ذكرى تضوع في الكون نشرا",18,"ر",2,0],["ثم أحبو الأولى بنظرة عطفٍ","إذ أراها مرّت على عميان",19,"ن",1,0],["ثم أحضرت اليها مسرعا","كل ما كان من الأكل لدي",20,"ي",1,0],["ثم أحبَسناهُ وقتاً","وشربناه مُعَتَّق",21,"ق",1,0],["ثم أحلا بعد إحرام وقد","حلا بطيبة المحل الأشرفا",22,"ف",2,0],["ثم احتكم فالدهر طوع الأمر","حتى صفت بالآصفيِّ بنها",23,"ه",2,0],["ثم احتقرتم للضعيف مقاله","من غير ذنبٍ والمقال سديد",24,"د",1,0],["ثُمّ أَحْيَتْ كَمَا اشْتَهَت ْ لِفُؤَادِي","بالْتِفَات ٍ وَ ضِحْكَةٍ كَالْخَرِيرِ",25,"ر",1,0],["ثم أحيى من بعدها وهنيئا","للذي يحيى برشفكِ ريّا",26,"ي",2,0],["ثم احتويتُ بفيض الحب ذا عوزٍ","لعمَّ دفئيَ في الأرجاء يُحيّني",27,"ن",2,0],["ثُمَّ احْتَرَقُنَا فِى الدِّرُوبِ كَأَنَّنَا","نَجْمٌ تَفَتَّتَ فِى السَّمَاءِ وَضَاعَا",28,"ع",2,0],["ثُمّ احتَوَتْ مُهْجَتيْ نجََْوَىْ تُسَاْمِرُنِي","تَجْرِِىْ الْلّيَاْليْ بِِأَقْدَارٍ تُنَاْوِئنيْ",29,"ن",2,0]]}