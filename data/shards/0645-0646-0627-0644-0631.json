an/poem/135861","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102975","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77005","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101361","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94962","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133075","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58010","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72742","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120380","الكامل"],[4693,"الارهاب","https://www.poetsgate.com/ViewPoem.aspx?id=30028",""],[4729,"لِمنْ بَعدَ هدءٍ صدفَةٌ وتلفتُ","https://www.poetsgate.com/ViewPoem.aspx?id=109440",""],[4767,"عقد الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=178711",""],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[4578,"زناد نوى الأحباب في القلب يقدحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49376",""],[5112,"سلام لسلمان","https://www.poetsgate.com/ViewPoem.aspx?id=216003",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5373,"مَنِ الرَّزَّاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=185996",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""]],"verses":[["مَنِ الرَكبُ ما بَينَ النَقا وَالأَناعِمِ","نَشاوى مِنَ الإِدلاجِ ميلَ العَمائِمِ",0,"م",1,1],["مِنَ الراكِزينَ الرِماحَ الطِوا","لَ وَالرافِعينَ العِمادَ العِظاما",1,"م",2,0],["مَنِ الرَّكْبُ يا بْنَ العامِريِّ أمامي","أهُمْ سِرُّ صُبْحٍ في ضَميرِ ظَلامِ",2,"م",1,1],["مِن الرَوضَتَينِ فَجَنبَي رُكَيحٍ","كَلَقطِ المُضِلَّتِ حَليًا مُباثا",3,"ث",2,0],["مِنَ الرَضَماتِ البيضِ غَيَّرَ لَونَهُ","بَناتُ فِراضِ المَرخِ وَاليابِسُ الجَزلُ",4,"ل",1,0],["مِنَ الراجِعاتِ الوَخد رَجعاً كَأَنَّهُ","مِراراً مُباري صُنتُعِ الرَأسِ خاضِبِ",5,"ب",1,0],["من الروم أما وجهه فمشوّه","وقاح وأما قلبه فمن الصخر",6,"ر",1,0],["من الروم من البصر","ة ذات المد والجزر",7,"ر",1,0],["مِنَ الرُخامِ الندرِ لَكِنَّها","تُنازِعُ الجَوهَرَ قيماتِهِ",8,"ت",2,0],["مِنَ الرِجالِ وَقُيو","دِ حُكمِهِم مُحَرَّرَه",9,"ر",2,0],["مِنَ الرَملِ رَملِ الحَوشِ يَهلِكُ دونَهُ","رَواحُ شَمالٍ نَيرَجٍ وَبُكورُها",10,"ر",3,0],["مِنَ الرِجالِ وَأَيفاعٍ قَدِ اِحتُمِلوا","مُؤَزَّرينَ وَمِثلَ البَهمِ ما اِتَّزَرا",11,"ر",2,0],["من الرِّماحِ وإن طاَلتْ مخاصِرُه","كما الدُّروعُ وإن أَوْهَتْ غَلائِلُه",12,"ل",2,0],["من الرُّقشِ أعلاهُ سِنانٌ مذرَّبٌ","وأسفلُه عَضبُ الغِرارَينِ باترُ",13,"ر",1,0],["مِنَ الرُدَينِيَّةِ اللاتي إِذا عَسَلَت","تُشِمُّ بَوَّ صَغارِ الأَنفِ ذا الشَمَمِ",14,"م",1,0],["مِن آلِ رَحيمٍ حَيثُ لا هَضبَةُ العُلا","لِهَدٍّ وَلا بَحرُ النَدى لِعُبورِ",15,"ر",1,0],["مِنَ الرومِ وَالأُحبوشِ حَتّى تَناوَلا","بِبَيعِهِما مالَ المَرازِبَةِ الغُلفِ",16,"ف",1,0],["مِنَ الرَّأْيِ أن يُهْدَى لِمِثْلِكَ مِثْلُهُ","جَهِلْتُ وهَلْ يُهْدَى إلى البَحرِ جَوْهَرُ",17,"ر",1,0],["من الرّاسياتِ الشُّمّ لولا انتقالُها","فمنها قِنَانٌ شُمَّخٌ ورُيود",18,"د",1,0],["مِنَ الريحِ ماقامَت وَإِن هِيَ أَعصَفَت","نُهوزٌ بِرَأسٍ كَالعَلاةِ وَهادي",19,"د",2,0],["مِنَ الراحِ وَإِقرانُ","كَ مِنهُ الراسُ بِالراسِ",20,"س",1,0],["من الرمال فارشٌ زَرابي","تَستقبلُ الوفودَ بالترحاب",21,"ب",1,0],["مِنَ الرَّوْضتينِ فجَنْبَيْ رُكَيحٍ","كلقطِ المُضلَّة ِ حلياً مُباثا",22,"ث",2,0],["من الرمل ، ينشفُ فيه النِدا","ومثلَ بُكاء المآذن .. سرتُ",23,"ت",1,0],["مِنَ الرَّمْلِ مَا يَقْذِفْنَ فِيهِ مِنَ النسْلِ","يُعِدُّ بَنِيهِ لِلتَّبَارِيحِ وَالفَنا",24,"ن",2,0],["مِن الرَوضة الغَنّاء وَالدَوحة الَّتي","يَهز لَها أَعطافثهُ العِز وَالمَجد",25,"د",1,0],["مِن آلِ رَسلانَ قَد ذاقَ المَنيَّةَ في","ثَلاث عشْرَ وَلِلأَنوارِ إِقبالُ",26,"ل",1,0],["مِنَ الرِجلَةِ الساعينَ أَو تَلقَ فارِساً","عَلى فَرَسٍ في الخَيلِ أَدهَمَ ذي وِردِ",27,"د",1,0],["من الرأي أن لا توقع الحربَ بيننا","فإني جزَّارٌ وأنتَ سَمينُ",28,"ن",1,0],["مِنَ الرحمنِ ما لهما انتهاءٌ","عَليه وآله الأبد الأبيدِ",29,"د",1,0],["مِنَ الرَقيبِ مِنَ الغَيرانِ مِن حَدَقٍ","مِنَ النُجومِ وَلا أَنسَى مِنَ القِصَرِ",30,"ر",1,0],["من الروم الكرام بدا أميرٌ","فريدٌ في محامده كريمٌ",31,"م",1,1],["من الراقصاتِ بحَبِّ القلو","ب حتى يكون الحليمُ الخليعا",32,"ع",2,0],["من الريح لولا أن يَذْبُل تحتها","وقارُك مرَّتْ عنك مرَّ هُبوبِ",33,"ب",1,0],["من الرُّبْد يُنكرْن الأنيس كأنها","طخاريرُ عُلْويٍّ تُساقُ بشمْأل",34,"ل",1,0],["من الراشدات الشاردات كفيئها","وزيرٌ مفدى أو مليكٌ متوَّج",35,"ج",1,0],["من الرَّفْضِ ، والكبرياءِ العظيمةِ","حتى بَصُرتَ ، وحتى عَمِي",36,"م",2,0],["مِنَ الراحِ الَّتي تُجلى فَتَجلو","صَدى الأَحزانِ عَن روحِ الحَزينِ",37,"ن",1,0],["من آل رزيك الذين أقسموا","لا خذل الحق ولا أنصاره",38,"ر",2,0],["من آل رزيك الذين سما بهم","شرف لنيل العز والأعراق",39,"ق",1,0],["مِنَ الرَحمنِ في أَعلى جِنانٍ","مِنَ الفِردَوسِ طابَ بِها المُقامُ",40,"م",1,0],["من آلِ رَسْلانَ من لَخْمٍ لهُ نسَبٌ","إلى تَنُوخَ إلى قَحْطانَ يتَّصِلُ",41,"ل",1,0],["منَ الرِّجالِ رجالٌ عَدُّهم عَبَثٌ","وواحدٌ قد كَفَى عن كَثْرةِ العَدَدِ",42,"د",1,0],["من الرثا مقالاً في مدائحه","أو من مآثر إحسان وإنعام",43,"م",1,0],["من الرِضا عاد شبلُ المُرتضى وله","وجهٌ منيرٌ يضاهي فلقة القمرِ",44,"ر",1,0],["من الروق ما جذته مدية عزمنا","جذاذاً فسل عنه الفريفة والبحرا",45,"ر",2,1],["مِنَ الرُّقشِ نِضنانضُ اللِّسان كأنَّما","تَجَمَّعَ في خُرشاهُ سُمُّ الأساود",46,"د",1,0],["من آل رزقِ اللهِ شَهمٌ فاضلٌ","أَجرَى لفرقتِهِ المَدامعَ أَنهُرا",47,"ر",2,1],["مِنَ الراَكِبينَ الخَيلَ شُعثاً إِلى الوَغى","بِصُمِّ القَنا وَالمُرسِفاتِ القَواصِمِ",48,"م",1,0],["من الركب ما بين العراقين يممت","ركائبه من دجلة مربع 