{"poems":[[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[107,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[1,"إن امرأ سرف الفؤاد يرى","https://www.aldiwan.net/poem34015.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39679","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54879","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[79,"طرقنا ديور القوم وهنا وتليسا","https://www.poetsgate.com/ViewPoem.aspx?id=34193",""],[47,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[226,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[266,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[275,"طال التمنع يا مليحة فامنحي","https://www.aldiwan.net/poem35461.html","الكامل"],[275,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[438,"الشعر للشعراء مغنم معرك","https://www.aldiwan.net/poem12336.html","الكامل"],[445,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[463,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[463,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[463,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[466,"وأقسم لولا أحمد بن محمد","https://www.aldiwan.net/poem16176.html","الطويل"],[466,"بقيت أبا الفضل الذي شاهد له","https://www.aldiwan.net/poem16223.html","الطويل"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[510,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122312","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38369","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38135","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38633","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77576","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64698","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79538","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53153","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93942","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203033","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204643","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67995","الطويل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32724","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3638,"","https://poetry.dctabudhabi.ae/diwan/poem/203037","بسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117907","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85263","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131233",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66557","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114272","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44695","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134251","الطويل"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131912","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58157","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76697","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67477","الخفيف"],[4767,"اليانصيب","https://www.poetsgate.com/ViewPoem.aspx?id=180035",""],[4778,"إذا المرء لا يرعاك الا تكلّفا","https://www.poetsgate.com/ViewPoem.aspx?id=190721",""],[4968,"تغريدة الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=208101",""],[4984,"مجد الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175798",""],[5127,"وهبتُكَ ما كانَ لي أقْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=177480",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5324,"المرأة الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=210925",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[5464,"يا أخت مكة","https://www.poetsgate.com/ViewPoem.aspx?id=701",""],[5628,"الخروج من القمقم","https://www.poetsgate.com/ViewPoem.aspx?id=178500",""],[5744,"انا الأُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207275",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[463,"روَّحها مخمسة ٍ خمائصا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60109&r=&rc=165",""],[6260,"فتى الحروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68356&r=&rc=48",""],[5190,"مسافر من زمان العولمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78311&r=&rc=24",""]],"verses":[["فَفَتَّشتَ أَثناءَها جاهِداً","بِعَينَي بَصيرٍ بَعيدِ النَظَر",0,"ر",1,0],["ففتحتَ مرقاه الممنّعَ عَنْوَةً","وبات به التوحيد يعلو مناديا",1,"ي",2,0],["ففتكتَ جهراً لا طِعانُكَ خِلْسَةٌ","في المارقينَ ولا الضِرابُ ضِمَارُ",2,"ر",1,0],["فَفُتوحٌ يَقصُصنَ في كُلِّ يَومٍ","شَأنَذ قاصٍ مِنَ الأَعادي وَدانِ",3,"ن",1,0],["فَفَتىً يَقولُ عَلى الشُعوبِ مَدارُها","وَفَتىً يَقولُ عَلى المُلوكِ تَدورُ",4,"ر",1,0],["فَفَتَحتَ بابَكَ لِلمَكارِمِ حي","نَ تَواصَتِ الأَبوابُ بِالأَزمِ",5,"م",1,0],["ففتِّش على مُهجَةٍ حُرَّةٍ","أَبَت أَن يَمُرَّ عليها العِدا",6,"د",2,0],["فَفَتَحَ الْبَابَ لَهُ مُسْرِعاً","وَقَالَ أَحْسَنْتَ فخيْراً تَرى",7,"ر",2,0],["ففتّحت آذاناً وأيقظت أعيُناً","وصنتَ رِباطَ العنصرين من الفصْمِ",8,"م",1,0],["ففتحت الأبواب بالرحب منهم","وعرس طلاب المدامة تعريسا",9,"س",2,0],["فَفُتُوحٌ يَقصُصْنَ، في كلّ يَوْمٍ،","شأنَ قَاصٍ من الأعادي وَدانِ",10,"ن",1,0],["ففتى كالذئب في شكل امرىء","باسم السن خداعا ورياء",11,"ا",2,0],["ففتح الله فتح للأماني","إذا سدت مسالكها انسدادا",12,"د",2,0],["ففتحتُ قلبي مثلَ حرزٍ مُثمنٍ","يحوي جواهرَ لم يُمَسَّ وتُطَرَح",13,"ح",1,0],["فَفَتَحتُ جرحي تارةً وضمَدتُه","طوراً وسالَ دمي ودمعي حينا",14,"ن",2,0],["فَفَتِّق بِمَرّ نَسيمِ التُقى","كَمائِمَ تَوحيدِ باري النَسَم",15,"م",1,0],["فَفُتُّ مَن فيها رَأى تَفاوُتاً","وَهَل يَرى كيوانَ أَعشى ذو سَدَر",16,"ر",1,0],["فَفَتًى يفِيحُ الخُرْءُ من وَجْعَائِهِ","وفتًى يذيعُ المِسْكُ من أَسْفَاطِهِ",17,"ط",2,0],["فَفَتقْتَ أنهارَ الجَدَا لحدائِقي","ونَصَبْتَ أغراضَ المُنى لِسِهامي",18,"م",2,0],["ففتُّها بمهَلي حرائصا","فوتَ الرؤوس أعيتِ الأخامصا",19,"ص",2,0],["ففُتَّحت الرُّبا خدّاً وسُدَّت","بشكر المزن أفواهُ الوهادِ",20,"د",1,0],["ففتحتُ عن غُرٍّ تم","جُّ المسكَ والصهباءَ مجّا",21,"ج",2,0],["ففتكتُهُ في المَحْل والمحْلُ عارقٌ","كفْتكِتهِ في الدارعينَ المساعرِ",22,"ر",1,0],["ففتْواك عند المُشكلاتِ صَوارمٌ","وجدْواك عند المُجْدباتِ غَمائِمُ",23,"م",1,0],["ففتى الجود من إذا أبدأ","النعمى طباعاً أعادها وأداما",24,"م",2,0],["ففتش عن عدوٍّ لا","يداريك إذا احتلّا",25,"ل",2,0],["ففتح العلم وكان مقفلا","فانتظم الدين لنا واعتدلا",26,"ل",2,0],["ففت ولم تسع سؤددا وندى","كذاك اهل العلا إذا خطبوا",27,"ب",3,0],["فَفَتائِلٌ مِن عَسجَدٍ قَد عُلِّقَت","بِسَناجِقٍ خُضرٍ غَدتْ من سندسِ",28,"س",1,0],["فَفَتحُ عكّا وَعيدُ النّحرِ يَعقُبهُ","فَالفتحُ الاِوّلُ وَالثّاني هوَ الثَّاني",29,"ن",2,0],["فَفتّني فَقلت فَديتُكَ دَعني","فَكَيفَ تَروحُ فَإِنّي وَراك",30,"ك",1,0],["فَفَتح الثَعلَب عَينا تَدمَع","وَقالَ لِلقُنفذ ماذا تَصنَع",31,"ع",1,0],["فَفَتَّتَتْ أَكْبدَ الحسَّادِ مِنْ مِدَحٍ","سارَتْ فَأَنْسَتْ سَحيقَ المِسْكِ مَفْتوتا",32,"ت",2,0],["ففتحتَها وأَبحتَها ومَنَحتَها","نفراً هُمُ لفنائِكَ الخدَّامُ",33,"م",1,0],["ففتحنا الحصون من بعد مل كا","نت حماهم إذا أرادوا القتالا",34,"ل",2,0],["ففتحت أحداقها كأنما","قد شارفت بجوه حدائقا",35,"ق",2,0],["ففتى يعربد صائلاً","ويبين عن أبناء يافث",36,"ث",1,0],["ففتّشوا عنه في الحانات وانصرفوا","وكلُّ ما عرفوه عنه أوهام",37,"م",1,0],["ففتش قلبه لترى خرابا","ولا تنظر بيوتا عامرات",38,"ت",1,0],["ففتشتُ من فِي الأرض طُراً فلم أجد","لأهوالِ دهري من يزيل عَنائيا",39,"ي",2,0],["فَفَتَحناهُ مُسرِعينَ فَأَلفَي","ناهُ خَلّاً يُعَدُّ لِلمَمقورِ",40,"ر",1,0],["فَفَتىً باعَ حَظهُ بِسِواها","وفتى قالَ ما أَخذتُ نَصيبي",41,"ب",2,0],["ففتحتُ قلبي ساحاتٍ زرعتها","عفواً وحباً غير منفصمِ",42,"م",1,0],["ففتش تجد أصل البلاء نساءهم","بما اسطعن من بذر التنافر والبعد",43,"د",1,0],["ففتحت للدين الحنيفي أعيناً","وكفت سحائها بدمعٍ مسبل",44,"ل",1,0],["ففتنتها بالحسن حتى أوشكت","ان لا تسير فلا يكون قتام",45,"م",1,0],["فَفَتَّاهُ وَراسَلَهُ اخْتِصاصاً","وَرَوَّاهُ الْحَديثَ وَذاكَ فَضْلُ",46,"ل",1,0],["فَفتحُهُ فِي الزَّهرَاءِ أولَى لأنَّهُ","هُوَ الأصلُ عُجمَةً كَمَا جَاءَ فِِي الخَطِّ",47,"ط",1,0],["ففتكت بالأيام فتكة عالم","بالنائبات يقلب الأحوالا",48,"ل",2,0],["ففتح في الحال كل رتاج","وقد رفعوا منه كل زلاج",49,"ج",1,0],["فَفَتحتُها فَوَجَدتُ في","أَحشائِها اِبنَ الخيِّرينْ",50,"ن",1,0],["ففتى فاراب في تعليمه","لم يكن من مسكه إلا أريج",51,"ج",1,0],["ففتق من صون الكمام أزاهرا","فأعبقت الأرجاء من طيبها نشرا",52,"ر",2,0],["ففتحت عيني ناظرا لجمالها","وكاد سنا نور الحبيبة لي يغشى",53,"ش",2,0],["ففتش تجد ما قلتُه مضمرا","عليكَ يا شهر الصيامِ السلامْ",54,"م",1,0],["ففتية الكهف لا يدرون كم لبثوا","وفتية البرق لا يدرون ما نفخوا",55,"خ",3,0],["ففتحناه مسرعين فألفين","ناه خَلاّ يُعدّ للممقور",56,"ر",1,0],["ففتشت الصحيفة في ذهولٍ","وخوفي من خفاياها شديد",57,"د",1,0],["ففتش عن الأسباب عندك قبل أن","تدعه وتندم ذات يوم على الجفا",58,"ف",2,0],["ففتحت ابواب القصيد ليحتفي","الابداع في شغف بذا الولهان",59,"ن",1,0],["ففتحناها وكانت مغنما","ليلها شد على ألبابنا",60,"ن",2,0],["فَفَتِّشْهُ حرصاً ترى أنَهُ","بماءِ الوفا قد جرى يسكبُ",61,"ب",1,0],["ففتاه مسمر دون وعي","بات يغشى في سكرة ويفيق",62,"ق",1,0],["ففتشَ فيهِ عن صوتٍ","لما يرنو يدلّيهِ",63,"ي",2,0],["ففتحتُ عينيَ في مدارِ رزيةٍ","آلاُمها في كلِّ شبرٍ ذائعة",64,"ع",2,0],["ففتحت لي باب الأمان كما","أشرعتِ لي محراب مبتهل",65,"ل",1,0],["ففتحتِ قمقمهُ بسحركِ والهوى","إنْ عزَّ مفتاحٌ هوَ المفتاحُ",66,"ح",1,0],["فَفتّشْ في عيوني ألفَ لونٍ","وعِطري طارَ نشراً كالخُزامى",67,"م",2,0],["ففتحت نافذتي، وقُلتُ لها ادخلي","لكنها لم تهتدِ لمُناها",68,"ا",3,0],["ففتنةُ الدُّنيَا إذا ضَحِكَتْ","وإنْ غدَتْ بالقُربِ ، لَمْ تُسَمِ",69,"م",1,0],["ففتُّها بمهلي حرائصا","فوتَ الرؤسِ أعيتِ الأخامصا",70,"ص",2,0],["ففتى الحروب كما علم","ت ولكن ليس حربك",71,"ك",1,1],["ففتَّشَ عنكِ في زمنٍ تولّى","وجابَ سؤالُهُ كلَّ العشائرْ",72,"ر",1,0]]}