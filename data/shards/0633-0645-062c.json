{"poems":[[46,"عياش زف إليك جهد جاهد","https://www.aldiwan.net/poem30050.html","الكامل"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[113,"وفد الصباح وزالت الأحلاك","https://www.aldiwan.net/poem16210.html","الكامل"],[208,"روض المحاسن نزهة الأبصار","https://www.aldiwan.net/poem53142.html","الكامل"],[226,"ذهب الوفاء فلا ندامه","https://www.aldiwan.net/poem55272.html","مجزوء الكامل"],[266,"حلا بك الدهر وازدانت علا حلب","https://www.aldiwan.net/poem38367.html","البسيط"],[287,"كلما حادثني ابن الخيمي","https://www.aldiwan.net/poem32841.html","المتقارب"],[463,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[473,"لمحسن بن الملح منزلة","https://www.aldiwan.net/poem60232.html","أحذ الكامل"],[572,"صاحب لي ليس فيه","https://www.aldiwan.net/poem69527.html","مجزوء الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49964","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49936","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131246",""],[5520,"سمجت مناظره فحين خبرته","https://www.poetsgate.com/ViewPoem.aspx?id=96131",""],[463,"أرأيتَ أمْ حبستْ لحاظكَ عبرة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60108&r=&rc=164",""]],"verses":[["سَمُجَت بِكَ الدُنيا فَما لَكَ حامِدٌ","وَسَمَجتَ بِالدُنيا فَما لَكَ حاسِدُ",0,"د",1,0],["سَمُجَت وَنَبَّهَنا عَلى اِستِسماجِها","ما حَولَها مِن نَضرَةٍ وَجَمالِ",1,"ل",1,0],["سمج لئيم النفس لم","تك وصمة إلا أَتاها",2,"ا",3,0],["سَمج بِإِحدى راحَتَيهِ رَشوَةٌ","فَرح بِها وَبِأُختِها المِسواكُ",3,"ك",1,0],["سمجٌ بمثلك صحبة الأشرارِ","وإخاءُ كلِّ مُهَتَّك الأستارِ",4,"ر",1,0],["سمج يمت الى الزعا","نف صار ينعم بالزعامه",5,"م",2,0],["سمج سما ودريافا لذي عود","ومستقيم ففيه البرء والعطب",6,"ب",1,0],["سَمِجُ الإِنشادِ غَثٌّ لَفظُهُ","فاتِرُ الشِعرِ يُرى فيهِ خَنيثا",7,"ث",2,0],["سمجتْ فغودر كلُّ ذنبٍ عندها","ما كان شافعَه الشبابُ ممحَّصا",8,"ص",2,0],["سَمِجٌ إِذا شاهَدتَ صورَتَهُ","شاهَدتَ مِنها صورَةَ القِردِ",9,"د",1,0],["سَمِجٌ شَخْصَاً وَمَخْبُورَاً","وَتَفْصِيْلاً وَجُمْلَهْ",10,"ل",2,0],["سَمُجَ الزَّمانُ وأوحش البلدُ","فكأنّما هو ما به أَحدُ",11,"د",1,1],["سَمَجَتْ علالاتُ الصِّبا بِمهذَّبِ","لولا بياضُ عِذاره لم يسْمُجِ",12,"ج",1,0],["سمج التعابير سمج الذوق متخذٌ","من البلادة أسلوباً به اتسما",13,"م",2,0],["سمجت مناظره فحين خبرته","حسنت مناظره لقبح المخبرِ",14,"ر",1,1],["سمجتْ فغودرَ كلُّ ذنبٍ عندها","إلاَّ الخيالُ تكذباً وتخرُّصاً",15,"ص",2,0]]}