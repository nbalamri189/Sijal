{"poems":[[95,"حسرة أي أن تبيني","https://www.aldiwan.net/poem11238.html","الخفيف"],[90,"أطلت يا دهر نحسي","https://www.aldiwan.net/poem45010.html","المجتث"],[74,"عللونا عند النوى بالعناق","https://www.aldiwan.net/poem19354.html","الخفيف"],[74,"حبذا للدين والدنيا فتى","https://www.aldiwan.net/poem19453.html","الرمل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[94,"يا قلبي الدامي إلام الوجوم","https://www.aldiwan.net/poem38920.html","البسيط"],[91,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[107,"بني الملوح لا حام ولا واق","https://www.aldiwan.net/poem43577.html","البسيط"],[104,"قد شهدنا لعهدكم بالعداله","https://www.aldiwan.net/poem32962.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[53,"سائل أبا الصقر إذا جئته","https://www.poetsgate.com/ViewPoem.aspx?id=30011",""],[119,"روحي الفدا لرسول","https://www.aldiwan.net/poem41992.html","المجتث"],[139,"بالأمس كنا ومصر في شبيبتها","https://www.aldiwan.net/poem49187.html","البسيط"],[203,"إن لم يكن عندك ما عندنا","https://www.aldiwan.net/poem45236.html","السريع"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[246,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[369,"صيرت خوزستان حربا قائما","https://www.aldiwan.net/poem60610.html","الكامل"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[411,"هل منعم في الناس أو مفضل","https://www.aldiwan.net/poem49959.html","السريع"],[543,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138364",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138269",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138090",""],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80235","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126187","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56645","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100988","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76654","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100450","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93595","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82870","المجتث"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127398","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147325","البسيط"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198304","المنسرح"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145121","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127056","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91837","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91090","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91900","الكامل"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67781","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111317","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125817","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125810","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133206",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58032","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58038","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4767,"قل للرجال","https://www.poetsgate.com/ViewPoem.aspx?id=175120",""],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[4858,"مصير الصحفي","https://www.poetsgate.com/ViewPoem.aspx?id=29942",""],[4858,"إلى التي نسيت إسلامها","https://www.poetsgate.com/ViewPoem.aspx?id=30116",""],[4929,"الشعر في معادلة التغيير","https://www.poetsgate.com/ViewPoem.aspx?id=199508",""],[4968,"تعويذة العشق ٢","https://www.poetsgate.com/ViewPoem.aspx?id=208097",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5147,"من عاذري أن قلت إن","https://www.poetsgate.com/ViewPoem.aspx?id=166752",""],[5206,"حب غير الله","https://www.poetsgate.com/ViewPoem.aspx?id=187395",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[5376,"بغداد إن ضحكت فيها نواجذها","https://www.poetsgate.com/ViewPoem.aspx?id=188304",""],[5376,"من مبلغ الريم عن لهفي لما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=188559",""],[5431,"خاتم الشعر..","https://www.poetsgate.com/ViewPoem.aspx?id=202252",""],[5574,"في كنفِ الإلٰهِ مُهدهِداً بدراً","https://www.poetsgate.com/ViewPoem.aspx?id=206002",""],[402,"حسرة أي حسرة أن تبيني","https://www.poetsgate.com/ViewPoem.aspx?id=36466",""],[5797,"فقيد الدين والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=187796",""],[6035,"كذبة يوم القدس .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175126",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6120,"يَا قَلْبِي دَعْ عَنْكَ الْأَمَلَ","https://www.poetsgate.com/ViewPoem.aspx?id=214879",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""]],"verses":[["كُلُّ أفْعَالِهَا صَرِيحٌ سِوَى","إعْطَائِهَا لِلْيَتِيمِ وَالمِسْكِينِ",0,"ن",1,0],["كُلُّ أفكَارِهَا بَدِيعٌ وَلاَ يُصْطَادُ","إلاَّ كَاللُّؤْلُؤِ المَكْنُونِ",0,"ن",1,0],["كلا فإن مقالي","هَزْل وليس بجِدّ",1,"د",1,0],["كل أفعاله مناسبة النف","ل فعوّذ تجنيسها بالطباق",2,"ق",1,0],["كل أفقٍ سار فيه ذكره","يا له سعدٌ ثنته بركه",3,"ه",1,0],["كلا فلا تُكْثرْ مَلامك واطّرِح","عنك الهُذَاءَ فإنني طَرَّاحُهُ",4,"ح",2,0],["كَلاّ فإنَّ الدَّهْر يمضي ولا","يلوي على مَا خَلْفَهُ مِنْ كَلِيمْ",5,"م",1,0],["كلا فان الشعر يرجى منه","فوق ما وهب",6,"ب",1,0],["كلا فإن يَكُ حقّاً ما يقولُ فما","فيما يُريدُونَ من ظُلمٍ وإرهاقِ",7,"ق",1,0],["كلُّ أفضالكم على الرأس والعي","ن وليست في حاجة لدلاَلهْ",8,"ل",2,0],["كل اِفتراقٍ لا أبا لك هينٌ","إلا افتراق الروح والجثمان",9,"ن",1,0],["كلا فما بعد موتي","سعادة ثم كلا",10,"ل",2,0],["كلّ أفق تضيق فيه أسيرا","سعة الأفق أن تكون طليقا",11,"ق",2,0],["كلا فما يخفى على مثله","أمر تفاقيع وتشقيق",12,"ق",1,0],["كلا فما يَحْفى على مثله","أمر تفاقيع وتشقيق",13,"ق",1,0],["كل افتخاري أني","عشقته وصدقت",14,"ت",1,0],["كلا فما هي ما ندريه من قدم","وما همو لو تدبرت الأمور همو",15,"م",2,0],["كلا فؤادينا امتلا بالهوى","وفاضَ حتى ملا الأعينا",16,"ن",2,0],["كلاّ فلا أنساب لل","ملك المقيم ولا بنين",17,"ن",1,0],["كلا فما أنت إلا أعظمٌ دَرَست","أخنى عليها الذي أخنى على لُبَدِ",18,"د",1,0],["كَلاّ فَمجْدُ المُلْكِ أبعدُ هِمّةً","وأَتَمُّ تَدبيراً وأَعظَمُ شانا",19,"ن",2,0],["كلا فإن البوم تُظلِمُ عينُه","في النور ثم تضيء في الإظلام",20,"م",1,0],["كَلاَّ فقد غابَ النَّدى والسَّدى","وماتَ أهلُ الفَضلِ والقَدْرِ",21,"ر",1,0],["كَلاَّ فما هىَ بالقَوافِي إنَّها","آهاتُ أعمَاقِي وصَوتُ بِلادي",22,"د",2,0],["كلا فإن زكياً خالد أبداً","ذكراً وإن كان لم يترك لنا عقا",23,"ق",2,0],["كلا فلا عين او اذن بها بها سمعت","سوى عيون بوادينا وآذان",24,"ن",1,0],["كلا فبين العالمين أماجد","بلغوا الغلاء بجدهم وأماثل",25,"ل",1,0],["كلا فمن ملك القلوب هو الذي","عشق المكارم والعدالة نفذا",26,"ذ",2,0],["كلاّ فإن جمالهنّ لزائلٌ","لكنّ حسن العلم يمكث آبدا",27,"د",2,0],["كلا فلو أنهم مثل الجماد إذا","لدبَّ روحُك في الصُمِّ الجلاميد",28,"د",1,0],["كُلأُّ فعلٍ لَكَ فيهِ بِالمَلا فَضلُ","مَن صامَ وَصَلى وَسَجَد",29,"د",1,0],["كلاّ فذاك هو الوحيد بعصره","وبغابر أو مقبل لن يوجدا",30,"د",2,0],["كلا فلن تألف هذا الأنام","خلقت من نور وهم من ظلام",31,"م",1,0],["كلا فلو كنت الأله جعلته","وقفاً لثغر الشاعر المحروم",32,"م",1,0],["كلافلك في لجٍّ تنازع سيرها","من فوقه نكبٌ من الإعصار",33,"ر",1,0],["كلا فما شأني وشأن مؤنبي","شَرَعٌ سواء للرجال شؤون",34,"ن",1,0],["كلا فما التسويف من شيمي ولا","لي الجميل بعادة من عادي",35,"د",2,0],["كلا فما فقدت صفات محمد","وبنوه في ترب الفخار قعود",36,"د",1,0],["كلا فَقَد كانَ الدُجى","بِمنار جعفر مبصرا",37,"ر",2,0],["كلا فَلا تعذُلوني","عَلى اتِّصالِ اِجتِنابي",38,"ي",1,0],["كلا فلا الموت ينسينا فضائله","ولا الزمان وما يأتي به القدر",39,"ر",1,0],["كلا فمعتقدي وأنت المجتدى","أنى أنال لمطلبي ومنائي",40,"ا",2,0],["كَلاَّ فَمَا سُبُحَاتُ الضَّوءِ سَاهِيَةٌ","عَنِ الصَّلاةِ بِمِحْرَابِي عَلَى شَفَقِي",41,"ق",2,0],["كلّ أفانين دهركم عجب","وكلّ أيّام دهركم غرر",42,"ر",1,0],["كلا فسوف تعود بهجة حسنها","ويزيدها كسب المفاخر طيبا",43,"ب",2,0],["كلا فتلك ليس هذه وذي","فاح من الفيحاء نشرها الشذى",44,"ذ",2,0],["كلا فقد أَدركتُ ما غاياتها","وَعلمتُ أَنّ الصاب في طعم العَسل",45,"ل",1,0],["كَلا فَما غَيرَه أَرجو لَنائبةٍ","وَلا شَفيعاً إِذا ما أَوبقت وَصمي",46,"م",2,0],["كلا فَما فَوقٌ وَلا تَحتٌ فَما","جِهةُ المَكان وَأَين ما لم نشهد",47,"د",1,0],["كلا فئتيه عاش حيّاً وميتاً","يكادان لولا الحق يشتبهان",48,"ن",1,0],["كلّا فلن يجزيك ذاك فما","هو قاصرٌ حكماً بما حكما",49,"م",2,0],["كلّا فلست برائعي جزعا","أقبل نجل صم النصال معا",49,"ع",2,0],["كلّا فتنفسي الزاد لا تستبيح","ما عشت لن ينتابني حادثٌ",50,"ث",1,0],["كلا فجدي أحمد وأبي","ليث الوغى والفارس البطل",51,"ل",1,0],["كلا فما عزلوه فهو لهم","مولى بغيضهم وان نكلوا",51,"ل",3,0],["كلا فهم لم يُحرِزوا همما","توازي همتك",52,"ك",1,0],["كلا فسطِّر ما رأيت","لعل في هذا عظة",52,"ه",1,0],["كلا فما هو غيرُ عضوٍ مفرد","سهلِ الجناب ضعيفةٌ ذراته",53,"ت",2,0],["كلّا فما قد دام هجر أخي هوى","مثلي وظلَّ أسير حبٍّ مُغرما",54,"م",2,0],["كلا فهم في بطون الأرض رهن بما","قد قدموا في مشيب العمر أو في الشباب",55,"ب",1,0],["كلاّ فليس بجانحٍ لحُطَامِها","وغرورها غيرُ الغوِيِّ الغاشم",56,"م",1,0],["كلاّ فلا حجةٌ يوماً لذي خَذَلٍ","أطِعْ وَسَارِعْ لأمر الله وابْتَدر",57,"ر",1,0],["كلا فإنك عن مثقال خردلة","مناقَشٌ وبذَاك اليوم محضور",58,"ر",1,0],["كَلّا فَمُعتَقدي وَأَنتَ المُجتَدي","أَن لا أَرى هَمّاً وَأَنتَ جَلائي",59,"ا",2,0],["كِلاَّف يِحظونَه وهم لَه سِويجِ","شَروات م الجوزاء تراها بسايِج",60,"ج",1,0],["كلا فَساسةُ يومنا","في صفحة التاريخ لعنة",61,"ن",2,0],["كلا فلن تفلحوا مهما بدا علمٌ","في كل أرض لكم بالجهل منتصبا",62,"ب",2,0],["كلاّ فلا أرَبٌ له أن يفزِعا","بل قلبه حقّاً بحبّ أترِعا",63,"ع",2,0],["كلا فإنّ نجاتنا بشريعة الله النقيّه","هيّا فسيري باسمِ ربّك في السبيلِ الأخرويّه",64,"ي",2,0],["كلا فلم تفقدِ التأثيرَ قُدرتُهُ","سِحْرًا ولا أَمْحَلْتْ جدبًا وإِسْنَاتَا",65,"ت",2,0],["كلاّ فأغصانه ترتاح وارفة","وتستكين لشحرور على زجل",66,"ل",1,0],["كلا فإن كيانه","مترفع عنها محلا",67,"ل",2,0],["كلا فإن المبدء الفيا","ض مبدعها هداها",68,"ا",3,0],["كَلّا فإنَّ بِغَيرِ ذلكَ مُمكِنٌ","في حَالتَيهِ مُحَرَّمًا وحَلَالا",69,"ل",2,0],["كلا, فعزمُ الشامخين إلى العلا","يبقى لدربِ الصابرين إماما",70,"م",2,0],["كلا فما وهنتْ يوماً لعاديةٍ","والحقُّ موعدُها للبسمِ ميعادُ",71,"د",1,0],["كلا فما رحلتْ عني عذوبتها","ولا أنسْتُُ على الهجران خلانا",72,"ن",2,0],[": كلا فليست رياح الشر تقلعه","ولا يزيل خطوط العشق شانئُه",73,"ا",2,0],["٢٤- كلّا، فما كذَبَ الفؤادُ بما رأى","والعيْنُ لم تتطغَ (ى) بكلِّ حياءِ",74,"ا",2,0],["كل افكارها بديع","ولا يصطاد غلا كاللؤلؤ المكنون",75,"ن",1,0],["كلا فذلك شأن من","برِدا الجهول تكفَّنا",76,"ن",2,0],["كلا ، فلست بعيداً عن نواظرهم","ولوأرادوا لكنت الآن مُلْكهم !",77,"م",1,0],["كُلُّ أَفعالِكَ جُرمٌ","بَيِّنٌ . فالقُبحُ قُبحُ",78,"ح",1,0],["كَلَّا، فَقَدِ اِخْتَارَ الْهِجْرَانَ","لِكَيْ لا يُسأَلَ حِينَ سَلَا",79,"ل",2,0],["كل أفاض بما منه تكون من","ملح أجاج ومن مستملح عذب",80,"ب",1,0],["كلا فما كان إلا دمية نصبت","من العمالة والتضليل مذ وفدا",81,"د",2,0]]}