""],[28,"وأقسم أن لولا قريش وما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=20969",""],[28,"وما عن قلى عاتبت بكر بن وائل","https://www.poetsgate.com/ViewPoem.aspx?id=22042",""],[28,"إن رجال الروم يعرف أهلها","https://www.poetsgate.com/ViewPoem.aspx?id=22063",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[51,"أخالدُ قد أصبحت قيَّم نسوة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30206",""],[97,"المآب","https://www.poetsgate.com/ViewPoem.aspx?id=17256",""],[29,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[33,"أنِيري مَكانَ البَدْرِ إنْ أفَلَ البَدْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14108&r=&rc=43",""],[3,"بين العقيق وبينَ برْقَة ِ ثَهْمَد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10684&r=&rc=38",""]],"verses":[["رَفيعُ بُيوتِ المَجدِ كَالجَدِّ جَدُّهُ","فَخاراً وَفي العَلياءِ كَالخالِ عَمُّهُ",0,"م",2,0],["رِفقاً بِأَنفِكَ لا تَشمَخ عَلى مُضَرٍ","وَاِنظُر بِعَينِكَ مَن زُمّوا وَمَن خُطِموا",1,"م",3,0],["رَفَعتَ ناري عَلى عَلياءَ مُشرِفَةٍ","مِنَ المَعالي وَأَخضَعتَ النَوائِبَ لي",2,"ل",2,0],["رِفقاً بِقَلبي يا أَبا حَسَنٍ","العَينُ مِنكَ وَأَنتَ تَطرِفُها",3,"ف",3,0],["رَفَعتُ إِلَيكَ دِعوَةَ مُستَجيرٍ","وَأَنتَ مَدى عَقيرَةِ كُلِّ داعِ",4,"ع",1,0],["رَفَعوا المَساعي مِن قَواعِدِها","يَعلو بِهِنَّ الرَضمُ وَالرَصُّ",5,"ص",1,0],["رُفِعَت لِعَينِ الناظِرِ المُتَنَوِّرِ","وَاللَيلُ مِثلُ الواقِفِ المُتَحَيِّرِ",6,"ر",1,0],["رَفَعوا القِبابَ وَبَينَهُنَّ لُبانَةٌ","لَم تَقضِها عِدَةُ الغَزالِ الأَغيَدِ",7,"د",1,0],["رَفيقانِ ما باغاهُما العِزَّ صاحِبٌ","نَديمانِ ما ساقاهُما المَجدُ ثالِثُ",8,"ث",1,0],["رَفَعتَ اليَومَ مِن قَدري","وَأَوطَأتَ العِدى عَقبي",9,"ب",2,0],["رَفعَتْهُمُ جِدَةٌ وجَدُّهمُ لَقىً","منْ لُؤْمِهِ بمَدارِجِ الأقْدامِ",10,"م",1,0],["رُفِعَ الأظَلُّ على السّنامِ وأوطِئَتْ","قِمَمَ السُّراةِ أخامِصَ الأوْباشِ",11,"ش",1,0],["رُفِعَتْ منارُ العَدلِ في أرْجائِها","فاللّيْثُ يَخْضَعُ للغَزالِ الأحْوَرِ",12,"ر",1,0],["رَفَعْتَ لنا نارَ القِرى بعدَما خَبَتْ","عَداكَ الرَّدى أُكْرِمْتَ يا مُوقِدَ النَّارِ",13,"ر",1,0],["رَفَعْتَ صَحْبي ضَوءَ نارٍ عَتيقةٍ","بِها يَهتَدي السّارونَ والنَّجْمُ حَيرانُ",14,"ن",1,0],["رَفَعوا القِبابَ عَلى وُجوهٍ أَشرَقَت","فيها فَغَيَّبتِ السُها في الفَرقَدِ",15,"د",1,0],["رُفِعَت عَلَينا بَعدَما","زَرَعَت هَواها في الفُؤادِ",16,"د",1,0],["رفعت على الحمراء تاجاً مجوهراً","وقلدت منها النحر عقداً مجنسا",17,"س",2,0],["رُفِعَتْ قصّةُ اشْتِقاقي ليَحْيى","فزَوى الوجْهَ رافِضاً للفُتوّهْ",18,"ه",1,1],["رِفْقاً بنَفسِكَ سيّدِي رِفْقاً","فالقَصْدُ أنْ تَبْرا وأنْ تَبْقَى",19,"ق",2,1],["رِفْقاً أبانَا جَلّ ما حمّلْتَنا","لا تنْسَ فينَا عادَةَ الإشْفاقِ",20,"ق",1,0],["رَفَلْتُ بابْراهِيم في حُلَلِ السّعْدِ","وأُفْرِدْتُ بالفَخْرِ المُؤَثَّلِ والمَجْدِ",21,"د",1,1],["رفَعْتَ بِناءَ المُلْكِ لمّا تَمايَلَتْ","دَعائِمُهُ فوْقَ الأساسِ الموطَّدِ",22,"د",1,0],["رِفْقاً على مُهَجٍ تملّكَها الهَوى","فالرِّفْقُ منْ أخْلاقِكُمْ مَعْدودُ",23,"د",1,0],["رَفَعُوا لَها قَبَساً بجانِبِ طُورِهِمْ","فعَشَوْتُ نحْوَ سِراجِهِ الوهّاجِ",24,"ج",1,0],["رَفيعَ الوِسادِ طَويلَ النَجا","دِ ضَخمَ الدَسيعَةِ رَحبَ العَطَن",25,"ن",1,0],["رَفيعِ المَحالِ وَالضُلوعِ نَمَت بِهِ","قَوائِمُ عوجٌ ناشِزاتُ الخَصائِلِ",26,"ل",1,0],["رَفيقٌ بِتَنضيدِ الصَفا ما تَفوتُهُ","بِمُرتَصَدٍ وَحشِيَّةٌ وَهُوَ نائِمُ",27,"م",1,0],["رَفَعَ الحِمايَةَ بَعدَما بُسِطَت عَلى","أَبناءِ مِصرَ وَأُيِّدَت بِكِتابِ",28,"ب",1,0],["رَفَعتَ عَنِ الفَلّاحِ عِبءَ ضَريبَةٍ","يَنوءُ بِها أَيّامَ لا غَوثَ يَنفَعُ",29,"ع",1,0],["رِفقاً عَميدَ الدَولَتَينِ بِأُمَّةٍ","ضاقَ الرَجاءُ بِها وَضاقَ المَذهَبُ",30,"ب",1,0],["رِفقاً عَميدَ الدَولَتَينِ بِأُمَّةٍ","لَيسَت بِغَيرِ وَلائِها تَتَعَذَّبُ",30,"ب",1,0],["رَفِّه وُرودَكَها لِتَغنَمَ راحَةً","وَأَطِل مَزارَكَها لِتَنعَمَ بالا",31,"ل",2,0],["رَفَّ بِشرُ الأُفقِ في عَيني لَها","لا لِأَنَّ الشَمسَ حَلَّت في الحَمَل",32,"ل",1,0],["رُفِعَتْ عَلَى الأَعْضَادِ يَغْنَجُ خِصْرُهَا","وَتَمِيلُ هَامَتُهَا مِنَ الرَّجْحَانِ",33,"ن",1,0],["رِفَاقٌ صَحِبْتُهُمْ فِي الحَيَاةِ","وَأَيْنَ هُمُ اليَوْمَ بَاتُوا رَمِيمَا",34,"م",2,0],["رُفِعَ الكَلبُ فَاِتَّضَع","لَيسَ في الكَلبِ مُصطَنَع",35,"ع",1,1],["رَفَعوا مَحَلَّكَ بَعدَ طولِ خُمولِهِ","وَاِستَنقَذوكَ مِنَ الحَضيضِ الأَوهَدِ",36,"د",1,0],["رَفَعتُ لَهُ رَحلي عَلى ظَهرِ عِرمِسٍ","رُواعِ الفُؤادِ حُرَّةِ الوَجهِ عَيطَلِ",37,"ل",1,0],["رَفَعتُ لَهُم عَن نِصفِ ساقي وَساعِدي","مُجاهَرةً بِالمِحرَباتِ العَوالِقِ",38,"ق",1,0],["رَفَعنَ عَلَيهِ الرَقمَ حَتّى كَأَنَّهُ","سَحوقٌ تَدَلَّى مِن جَوانِبِها البُسرُ",39,"ر",1,0],["رَفَعتَ مَجدَ تَميمٍ يا هِلالُ لَها","رَفعَ الطِرافِ عَلى العَلياءِ بِالعَمَدِ",40,"د",1,0],["رَفيقُ أَعيَنَ ذَيّالٍ تُشَبِّهُهُ","فَحلَ الهِجان تَنَحّى غَيرَ مَخلوجِ",41,"ج",1,0],["رفعت له نار الصبابة فاهتدى","وخاض لها عرضَ الدُّجُنَّةِ ساريا",42,"ي",2,0],["رفقاً بمن مَلك القضاءُ زمامَهُ","فغدا بقيد ذنوبه معقولا",43,"ل",2,0],["رُفعت لهم راياتُ كل جلالة","فتميَّزوا في حلبة السُّبَّاقِ",44,"ق",1,0],["رفعوا سريرك خافضين رؤوسَهم","ما منهُمُ إلا حليف سياقِ",44,"ق",1,0],["رفعت قوسَ سمائي","يُزهى بتاج الهلالِ",45,"ل",1,1],["رَفَعنا لواء النّصر يهفو أمامها","ورحنا على صرف الزمان لها حِلْفا",46,"ف",2,0],["رَفَّعتُ مائِرَةَ الدُفوفِ أَمَلَّها","طولُ الوَجيفِ عَلى وَجى الأَمرانِ",47,"ن",1,0],["رَفَعوا البِناءَ بَنو الوَليدِ وَأَسَّسوا","بُنيانَةً وَصَلَت أُرومَةَ عادِ",48,"د",1,0],["رَفَعتُ لَهُ مَشبوبَةً يُهتَدى بِها","يَكادُ سَناها في السَماءِ يَطيرُ",49,"ر",1,0],["رَفَعَ المَطِيُّ بِكُلِّ أَبيَضَ شاحِبٍ","خَلَقِ القَميصِ تَخالُهُ مُختالا",50,"ل",2,0],["رُفِعَ المَطِيُّ بِما وَسَمتُ مُجاشِعاً","وَالزَنبَرِيُّ يَعومُ ذو الأَجلالِ",51,"ل",1,0],["رَفيعَ اللَبانِ مُطمَئِنّاً عِذارُهُ","عَلى خَدِّ مَنخوضِ الغَرارَينِ صُلَّبِ",52,"ب",1,0],["رِفهاً إِذا يَأتي ضَريكٌ وَرَدا","مِثلُ الَّذي في الغَيلِ يَقرو جُمُدا",53,"د",2,0],["رَفَعنَ سُرادِقاً في يَومِ ريحٍ","يُصَفِّقُ بَينَ مَيلٍ وَاِعتِدالِ",54,"ل",1,0],["رَفَّعتُها طَرَدَ النِعامِ وَشَلَّهُ","حَتّى إِذا سَخِنَت وَخَفَّ عِظامُها",55,"م",3,0],["رفعت إليك وما ثغر","ت عيون مستمع وناظرْ",56,"ر",1,1],["رَفَعتُ لهم نَاظِرَي خَائِفٍ","على الحَقِّ يُقدَعُ مُستَرهِبِ",57,"ب",1,0],["رَفِّه بِقَرعِ العودِ سَمعاً غَدا","قَرعُ العَوالي جُلَّ مايُسمَعُ",58,"ع",1,0],["رَفَعتُ عَلى الحُسّادِ نَفسي وَهَل هُمُ","وَما جَمَعوا لَو شِئتُ إِلّا فَرائِسُ",59,"س",1,0],["رَفيعِ عِمادِ البَيتِ يَستُرُ عِرضَهُ","مِنَ الذَمِّ مَيمونِ النَقيبَةِ خِضرِمِ",60,"م",1,0],["رفقاً بناظريَ الجريح فقد جرى","ما قد كفى من غيرة وتسهد",61,"د",1,0],["رفد أرادَ الغيثُ تشبيهه","فعُد ذاك الفعل من برده",62,"د",2,0],["رفقاً بقلبٍ في الصبابة والأسى","صيرته مثلاً فأصبح سائرا",63,"ر",2,0],["رفعت قدريَ فيه ليلة","قرَّبتني يا لها ليلة قدر",64,"ر",1,0],["رفعت قدري عطاً ولفظاً","يا سيدي أحمد الرفاعي",65,"ي",1,0],["رفضت الورى لمَّا علقت حبالكم","ونزَّهت دين الحبّ فيكم عن الشرك",66,"ك",1,0],["رفقاً بمن كحل الجفاء جفونه","فغدا الكرى منها على أميال",67,"ل",1,0],["رفق كما انْحلّت خيوط غمامةٍ","فإذا سطا نزلَ القضاء المبرم",68,"م",1,0],["رفيع التاج أزهر خزرجي","زكيّ الحلم مبرور الشهامه",69,"م",2,0],["رفعَ اللّه رغبتي عن عطايا","كَ وما لِلعُقاب والعندليبِ",70,"ب",1,0],["رفعتْنا السعودُ فيها إلى الفو","ز فكانت كليلة المِعرَاجِ",71,"ج",1,0],["رفعت منه رفيع الذكر ممتدَحاً","ألفى أباه رفيع الذكر ممتَدحا",72,"ح",2,0],["رفعت إلى وُدِّيك أبصار همتي","لترفع من قدري فهل أنت رافعُ",73,"ع",1,1],["رفعنَ لمُرتادِ الزنا أرجُلَ الزنا","عروضاً لأيدي الداعيات هُنالكا",74,"ك",2,0],["رفعْتُك فوق الفاعلين بسومِها","فلا ترضَ مما دونها ببديلِ",75,"ل",1,0],["رفعوا يفاعي كابراً عن كابرٍ","حتى استقلَّ إلى السّماك الأعزلِ",76,"ل",1,0],["رَفَعتُ لَها طَرفي وَقَد حالَ دونَها","رِجالٌ وَخَيلٌ بِالبَثاءِ تُغيرُ",77,"ر",1,0],["رَفيعُ المُنى لا يَستَقِلُّ بِحِملِهِ","سَؤومٌ وَلا مُستَنكَشُ البَحرِ ناضِبُه",78,"ب",2,0],["رَفَعتُهُ وَهوَ يَهفو في عَمائِمِهِم","كَأَنَّهُ طائِرٌ في رِجلِهِ عَلِقُ",79,"ق",1,0],["رَفَعتَ لِواءَ الحَقِّ فَوقَ رُبوعِها","فَضَمَّ إِلَيهِ كُلَّ ذي وَطَنِيَّةِ",80,"ه",1,0],["رَفَعَ الرَبيعُ لَكَ الأَرائِكَ في الرُبى","وَكَسا حَواشيها بُرودَ زَبَرجَدِ",81,"د",1,0],["رَفَعَ الرَئيسُ عَلَيهِما