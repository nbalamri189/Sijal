1,1],["رَفيقٌ بِرَجعِ المَرفِقَينِ مُمانِعٌ","إِذا راعَ مِنهُ بِالخِشاشَةِ رائِعُ",172,"ع",1,0],["رَفَعنَ بِها خوصَ العُيونِ وَجوهُها","مُلَفَّعَةٌ تُرباً وَأَعيُنُها خُزرُ",173,"ر",1,0],["رفعوا على الوهمِ البِناءَ وما دَرَوْا","أنّ الخطوبَ شديدةُ الزِّلزالِ",174,"ل",1,0],["رَفَع النُّفوسَ عن الصَّغارِ وصَانَها","عن أن تَخافَ عَدُوَّهُ أو ترهبا",175,"ب",2,0],["رفعوا الطّغامَ على الكرامِ وقوّضوا","صَرحَ النّظامِ بجرأةٍ لم تُعْهَدِ",176,"د",1,0],["رَفَعَ الصّوتَ أَصِرْنا أُمَّةً","تتركُ الدّينَ لقومٍ لاعبينْ",177,"ن",1,0],["رَفعَ الحياةَ على أساسٍ صالحٍ","والسّيفُ رُكنٌ والكتابُ دِعامُ",178,"م",1,0],["رفع السّيفَ على هامِ السُّهَى","أفلا أرفع فيه القلما",179,"م",2,0],["رَفَعُوا على الحقِّ الحياةَ فأعجزت","أقوَى البُناةِ وأقْدرَ الهُدّامِ",180,"م",1,0],["رفعوه في ذاتِ الألهِ وإنّما","رَفعوا بهِ لِلمُسلمينَ أُنوفا",181,"ف",2,0],["رَفعتْ على آيِ الكتابِ بِناءَها","زمناً فهدَّ الهادمين وزَلْزَلا",182,"ل",2,0],["رَفعتُمْ من حضارتِهِ مَناراً","يَفيضُ شُعاعُه للمُدْلجِينا",183,"ن",2,0],["رفعوا المنارَ لكلّ شعبٍ حائرٍ","أعمى المطالبِ جامحِ الأوطارِ",184,"ر",1,0],["رَفَعوا بِناءَكَ صاعِدينَ فَما اِنتَهوا","حَتّى تَصَدَّعَ وَاِنتَهى البُنيانُ",185,"ن",1,0],["رَفَعوا عَلى هامِ القَياصِرِ مُلكَهُم","وَالعَدلُ رُكنٌ قائِمٌ وَعِمادُ",186,"د",1,0],["رَفَعنا لِواءَ السِلمِ بِرّاً وَرَحمَةً","وَقُلنا يُسَوّى الأَمرُ وَالسَيفُ نائِمُ",187,"م",1,0],["رَفَعتَ مَنارَ الجودِ فيكُم عالِياً","تَعشو الكِرامُ إِلى سَناهُ فَتَهتَدي",188,"د",2,0],["رَفَعوا بِحَدِّ السَيفِ دينَ هِدايَةٍ","لَولا جَليلُ صَنيعِهِم ما قاما",189,"م",2,0],["رَفَعنا عَلى هامِ المَمالِكِ حُكمَنا","فَكانَ لَها تاجاً مِنَ العَدلِ غالِيا",190,"ي",2,0],["رَفَعوا الطَغامَ عَلى الكِرامِ فَأَشكَلَت","قِيَمُ الرِجالِ وَرابَتِ الأَشياءُ",191,"ا",2,0],["رَفَعوا العُروشَ عَلى الدِماءِ وَإِنَّما","تَبقى السَفينَةُ ما أَقامَ الماءُ",191,"ا",2,0],["رَفِيقُكَ في التَجَلُّدِ والتأَسِّي","وَخِدْنُكَ في التَّقدُّمِ والصِّيالِ",192,"ل",1,0],["رُفَيْدَةُ عَلِّمِي النَّاسَ الحَنانا","وَزِيدي قومَكِ العالينَ شانا",193,"ن",2,1],["رَفعتِ لأسلمٍ