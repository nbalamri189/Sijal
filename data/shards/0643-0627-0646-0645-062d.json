{"poems":[[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[79,"محلك بالدنيا وبالدين معمور","https://www.aldiwan.net/poem36488.html","الطويل"],[53,"كل نفس لموقت ليس حي بمفلت","https://www.aldiwan.net/poem8698.html","مجزوء الخفيف"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[26,"لعمرك والمنايا غالبات","https://www.aldiwan.net/poem24090.html","الوافر"],[63,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[51,"أذل الحرص والطمع الرقابا","https://www.aldiwan.net/poem10327.html","الوافر"],[83,"كان محياك له بهجة","https://www.aldiwan.net/poem61496.html","السريع"],[79,"محلك بالدنيا وبالدين معمور","https://www.poetsgate.com/ViewPoem.aspx?id=34127",""],[131,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[342,"كلا يومي طوالة وصل أروى","https://www.aldiwan.net/poem45418.html","الوافر"],[366,"مكان باعلى الفرقدين مكين","https://www.aldiwan.net/poem68046.html","الطويل"],[369,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[466,"رأيت مواسم الأيام طرا","https://www.aldiwan.net/poem16090.html","الوافر"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[563,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39112","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62526","الطويل"],[1244,"","https://poetry.dctabudhabi.ae/diwan/poem/144835","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35798","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108762","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49564","البسيط"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67206","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146365","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103434","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89320","البسيط"],[3711,"","https://poetry.dctabudhabi.ae/diwan/poem/31525","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131122",""],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18710","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59481","الطويل"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/142523","البسيط"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34745","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72738","الوافر"],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5298,"كلا يوميْ طوالة ْ وصلُ أروى","https://www.poetsgate.com/ViewPoem.aspx?id=185654",""],[4444,"قل لأبي يعقوب ان الذي","https://www.poetsgate.com/ViewPoem.aspx?id=85443",""]],"verses":[["كأنّ مُحيّاهُ وَقْبُ الصَّفا","تَغشّى جَوانِبَهُ الطُّحْلُبُ",0,"ب",1,0],["كأنّ مَحاميدَ الزّمانِ دَفاتِرٌ","وحمْدُكَ تَصْحيحٌ عليْها وتطْريرُ",1,"ر",1,0],["كان مَحْيَاهُ فيكَ أف","ضَل حِينٍ ومَوْقتِ",2,"ت",1,0],["كأن محاسني لم تَضْحَ يوماً","وفي لحظاتهنَّ لها اقتسامُ",3,"م",1,0],["كَأَنَّ مُحَرَّباً مِن أُسدِ تَرجٍ","يُنازِلُهُم لِنابَيهِ قَبيبُ",4,"ب",1,0],["كأنَّ مَحاسنَ الأشعارِ شَرْعٌ","تُحبِّبُهُ فجاءَ على الخِلافِ",5,"ف",1,0],["كَأَنَّ مَحاسِنَ الدُنيا سَرابٌ","وَأَيُّ يَدٍ تَناوَلتِ السَرابا",6,"ب",2,0],["كانَ مُحَيّاكَ لَهُ بَهجَةٌ","حَتّى إِذا جاءَكَ ماحي الجَمال",7,"ل",1,1],["كأن محاميد الزمان دفاتر","وحمدك تصحيح عليه وتطرير",8,"ر",1,0],["كَأَنَّ مَحافيرَ السِباعِ حِياضَهُ","لِتَعريسِها جَنبَ الأَزاءِ المُمَزَّقِ",9,"ق",1,0],["كَأَنَّ مَحازَ لَحيَيهِ حَصاهُ","جَنابا جِلدِ أَجرَبَ ذي غُضونِ",10,"ن",1,0],["كان محياه سَماء محاسِن","بِها البَدرُ يَجلو وَالنُجومُ تَزين",11,"ن",1,0],["كأنّ محاريبَ القنا ثُغَرُ العِدا","فما أَصبحتْ إلاّ وفيها رُكوعها",12,"ع",3,0],["كان محبّاً واثقاً","عرَّضتُهُ للخجْلَهْ",13,"ل",2,0],["كأنَّ مُحمَّداً جَوْنٌ مُسِفٌّ","يَصوبُ الأرض قطْراً بعد قطْرِ",14,"ر",1,0],["كان محباً له فأضحى","محبوبه الرائق الدنان",15,"ن",1,0],["كان محبوبه ابن حارثة زي","داً تبناه فهو كالمنسوب",16,"ب",1,0],["كأنَّ مُحَيَّاهُ بَدْرُ سَحابٍ","فَطوراً يَلُوحُ وطَوراً يغوصْ",17,"ص",1,0],["كأنَّ مُحياه كَسَا الشمسَ حُلّةً","من الحسن حتى صار نور ضحاها",18,"ا",3,0],["كأنَّ محيّاها بليل فروعها","بياض العطايا في سوادِ المطالب",19,"ب",1,0],["كأن محياه المدافع قد بدا","بغُرّتِه في النقع يسطو بها قهرا",20,"ر",2,0],["كَأَنَّ مَحاسِنَ الدُنيا","تَبسَّمُ إِن هُوَ اِبتَسَما",21,"م",2,0],["كأن محياه اكتسى من حميمه","مخافة عينٍ سابريّاً مضعَّفا",22,"ف",2,0],["كأَنَّ محرابَها والليلُ مُعتكرٌ","في هالة البدر بين البيضِ والعُشر",23,"ر",1,0],["كأن محمدا في الدين سيف","وَفي أَهل الردى العجز المتين",24,"ن",1,0],["كَأَنَّ مَحَطّاً في يَدَي حارِثِيَّةٍ","صَناعٍ عَلَت مِنّي بِهِ الجِلد مِن عَلُ",25,"ل",1,0],["كأنَّ مُحياهُ الصباحُ وجعده","إذا لاح في عينيك ليلُ الغياهب",26,"ب",1,0],["كأنَّ محيّا الصُّبح قابلَ فضله","ففي خدّه من خجلة النقص توريدُ",27,"د",1,0],["كأنَّ مُحَجَّلاتِ الدُومِ فيه","خرائدُ سافراتٌ في حدادِ",28,"د",1,1],["كأن محرمة الأمان أرسلها","شوال لا بأس أن ترتاح صُوّام",29,"م",1,0],["كَأَنَّ مُحَرَّبا مِن أُسدِ تَرجٍ","يُسافِعُ فارِسَي عَبدٍ سِفاعا",30,"ع",2,0],["كأن محياها صباح كأنما","تموه منه الشمس بالشفق الخدا",31,"د",2,0],["كَأَنَّ مَحالَها بِالنيرِ حَرثٌ","أَثارَتهُ بِمَجمَرَةٍ صَلابِ",32,"ب",1,0],["كان مُحيَّا رَبعه رَقشَتَّ به","سُطورُ يمين الكاتب المتألقِ",33,"ق",1,0],["كأنَّ محفوظَ في أولادِ حارتِهِ","شَيخٌ تصابى يُثيرُ المَزْحَ واللَعِبا",34,"ب",2,0],["كانَ مُحِبّاً لَكَ فيما مَضى","فَالآنَ قَد صادَفَ مَحبوبا",35,"ب",2,0],["كأن محابري حانات خمر","وأقلامي بنشوتها سكارى",36,"ر",2,1],["كأن محيا البدر في غسق الدجى","جبين جلاه الفرع فهو منير",37,"ر",1,0],["كأنَّ محازَ لحييها حصاهُ","جنابا جِلْدِ أجْرَبَ ذي غُضون",38,"ن",1,0],["كان محباً لك فيما مضى","فالآن قد صادق محبوبا",39,"ب",2,0]]}