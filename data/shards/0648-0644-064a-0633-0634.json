{"poems":[[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[53,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[30,"ألا حبذا البيت الذي أنت هايبه","https://www.aldiwan.net/poem1265.html",""],[51,"لا تعجبن من الأيام والدول","https://www.aldiwan.net/poem63081.html","البسيط"],[185,"خليلى هل من حيلة تعلمانها","https://www.aldiwan.net/poem58737.html","الطويل"],[216,"ظلمتك مذ شبهت عودك بالقنا","https://www.aldiwan.net/poem37878.html","الطويل"],[240,"كم أنفق الأيام في خدمة","https://www.aldiwan.net/poem31922.html","السريع"],[563,"ذو العلم قصر مشيد ليس ينهدم","https://www.aldiwan.net/poem34078.html","البسيط"],[580,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54079","البسيط"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119278","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107217","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65095","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132811","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141267","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114729","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27985","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27948","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202717","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36714","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131236",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58093","الطويل"],[5121,"هَبَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214995",""],[308,"قل لي مَا شَيْء إِذا رمت إِن","https://www.poetsgate.com/ViewPoem.aspx?id=189406",""],[592,"أدم بالعوال يالطن في الضدان جدا","https://www.poetsgate.com/ViewPoem.aspx?id=128845",""],[5459,"أقيموا الوزن بالقسط","https://www.poetsgate.com/ViewPoem.aspx?id=198347",""],[5937,"خارِجَ النّسَق","https://www.poetsgate.com/ViewPoem.aspx?id=211805",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""]],"verses":[["وَليسَ شِفاءُ النَفسِ إِلّا مُشَقَّفٌ","بُعَدَّ لِيَومٍ بِالغُبارِمُلَثَّمِ",0,"م",1,0],["وليس شفائي قتل عمرٍو لأنه","يُراح به من ذلك الجبل الوعر",1,"ر",1,0],["وليس شأْني الجهلَ لكنني","قد يَقْدَحُ الإحراجُ في حِلْمي",2,"م",2,0],["وَلَيسَ شَبابٌ بَعدَ شَيبٍ بِراجِعٍ","يَدَ الدَهرِ حَتّى يَرجَعَ الدَرَّ حالِبُه",3,"ب",2,0],["وَلَيسَ شَيءٌ وَإِن طالَ الزَمانُ بِهِ","إِلّا سَيَفنى عَلى الآفاتِ وَالعِلَلِ",4,"ل",1,0],["وَلَيسَ شِفاءُ الصَّبِّ إِلاّ حَبِيبَهُ","وَإِن لَم يَصِل كانَ التَّجاوُرُ اًنفَعَا",5,"ع",2,0],["وليس شجاني كلُّ وصفٍ ذكرتُه","فلا تظهري الأحقادَ يا بهجةَ الدَّهْرِ",6,"ر",1,0],["وَليسَ شَكوايَ سِوى أَنَّني","أَنظُمُ دُرّاً ما لَهُ مُشتَري",7,"ر",2,0],["وليس شيء مع الحق المبين وهل","مع الوجود سواه والسوى عدم",8,"م",1,0],["وليس شَجَاني من سُعادِيَ ما شجا","ولكن عَنَاني من بُعَادِك ما عَنا",9,"ن",2,0],["وليس شدو حمام الدوح شدو غنىً","لكنه النوح فيها تسمع الأذن",10,"ن",1,0],["وليس شريف الشاو من شف شفه","وليس نقي العرض من ضيع العهدا",11,"د",2,0],["وَلَيسَ شَقِيقُ البَدرِ غيرَ جَبِينِهِ","وَلا الدُّرُّ إِلا ما حَوَت شَفَياتُهُ",12,"ت",2,0],["وليس شعري كُفواً لشِعْرِكُمُ","بل هو شكْرُ الإِنعام بالصَدَقَهْ",13,"ق",2,0],["وَلَيسَ شَيء غَيره يُساعده","بَل كُل شَيء في الوَرى يُعانده",14,"ه",1,0],["وليس شُحُوباً ما أراه بوجههِ","ولكنَّهُ في الَمكرُماتِ نُدُوبُ",15,"ب",1,0],["وليس شريفاً في بني العرب غير من","يفدّي بغالي روحه لغة العرب",16,"ب",1,0],["وليسَ شيءٌ إليهِ مِن كَرَمٍ","أحبَّ من عَفوِهِ إذا قَدرَا",17,"ر",2,0],["وليس شخصٌ من أهل العلم ينكره","إلا تراه لدى الإنصاف يضمره",18,"ر",2,0],["وليس شؤونُ ربي غير هذا","وهذا الحقُّ ليس من الخيالِ",19,"ل",1,0],["وليس شعري عراقياً ليحسدني","أهلوه لا العُجم تحكيني ولا العرب",20,"ب",1,0],["وَلَيسَ شَكواي إِلّا مِن بَنيه وَإِن","كَنَّيتُ عَنهُم بِهِ فَاِفطَن لَما كانا",21,"ن",2,0],["وليس شريفاً من تسوء خلاله","وإن كان من أسلافه الشمس والبدر",22,"ر",1,0],["وليس شيءٌ من الأكوان مختفياً","عليه ما كان من قلٍّ ومن كثر",23,"ر",1,0],["وليس شيءٌ عليه واجباً أبداً","للخلق كلا فدع مفهوم ذي خسر",23,"ر",1,0],["وليسَ شريكٌ في العُلاَ أبداً لَهُمْ","تَعَالَوْا لَهُمْ حبلٌ من الله واثقُ",24,"ق",1,0],["وَلَيْسَ شِفَاءُ الْقَلْبِ بِالبَيْنِ هَيِّنٌ","وَلَكِنْ لِقَاءُ الرُّوحِ حِيناً دَوَاءُ",25,"ا",2,0],["وَلَيْسَ شَيخا وَهُوَ ذُو دورة","طَرِيقه يعرفهَا السالك",26,"ك",1,0],["وليس شديداً لنخوة اليوم راضياً","بثوب الهوينا والعدا تلبس الحمدا",27,"د",2,0],["وليسَ شهادةَ العُميا","نِ تَحتَ شَرائعِ الخَبْطِ..",28,"ط",1,0],["وليسَ شَراهَةً تُفْنِي","حُقُوقَ النَّاسِ بِالسَّرْطِ..",28,"ط",1,0],["وليس شعريَ إلّا شَعرُكِ انفَلتَتْ","خُصْلاتُهُ منكِ ، فانكبَّتْ على ورقي",29,"ق",2,0],["وليس شي سوى إثبات حجته","حب الإباحة إطماعا به قرنا",30,"ن",2,0],["وليس شيءٌ أواه فهو يحصره","تبارك الله هذا قول مكتيد",31,"د",1,0]]}