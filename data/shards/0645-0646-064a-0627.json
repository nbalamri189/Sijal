75","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89604","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4679,"يانيل قد فاضت دموعي نيلاً","https://www.poetsgate.com/ViewPoem.aspx?id=142756",""],[4755,"سِيرَةُ أَيلُول","https://www.poetsgate.com/ViewPoem.aspx?id=183562",""],[4755,"يا رَجْفةَ المَقصوفِ والقاصِفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183781",""],[4755,"لِلحُزنِ في وطني \"السّعيدِ\" مَنازلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=196917",""],[4762,"وشوشات","https://www.poetsgate.com/ViewPoem.aspx?id=212906",""],[4908,"عهود وأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=211503",""],[4935,"مني إليك قصيدة يا ذا المعال","https://www.poetsgate.com/ViewPoem.aspx?id=129387",""],[4954,"هلَكَ الفُؤادُ","https://www.poetsgate.com/ViewPoem.aspx?id=208897",""],[4978,"رد على تشطير رسالتي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=177250",""],[5092,"أنثايَ","https://www.poetsgate.com/ViewPoem.aspx?id=180133",""],[5111,"روسِيكَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=212161",""],[5111,"هَمْزِيَّةُ :الْحَوَّاسِ بري","https://www.poetsgate.com/ViewPoem.aspx?id=212623",""],[5136,"بكى سحرة لما تألق باسما","https://www.poetsgate.com/ViewPoem.aspx?id=121672",""],[5149,"يا إخوة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=215291",""],[5150,"حبي عليك جنى ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203779",""],[5160,"ليان","https://www.poetsgate.com/ViewPoem.aspx?id=175193",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[5314,"عودة الذات","https://www.poetsgate.com/ViewPoem.aspx?id=214821",""],[5376,"تلك فلسطينُ التي لم تغبْ","https://www.poetsgate.com/ViewPoem.aspx?id=204775",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5408,"لو مرة حاولت","https://www.poetsgate.com/ViewPoem.aspx?id=190757",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5458,"رمضان العراق","https://www.poetsgate.com/ViewPoem.aspx?id=72392",""],[5523,"وقفات","https://www.poetsgate.com/ViewPoem.aspx?id=201355",""],[5525,"مني السلام","https://www.poetsgate.com/ViewPoem.aspx?id=7260",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5704,"مني السلام إليكم...","https://www.poetsgate.com/ViewPoem.aspx?id=198739",""],[402,"انا من اسلفت خيرا وتوانى","https://www.poetsgate.com/ViewPoem.aspx?id=36457",""],[5829,"من باحة الأموي للزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=150259",""],[5847,"وهَجُ الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=6938",""],[5851,"جسر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175295",""],[5861,"هو قالها","https://www.poetsgate.com/ViewPoem.aspx?id=191302",""],[5872,"لما تناهى الصب في تشويقه","https://www.poetsgate.com/ViewPoem.aspx?id=120608",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"حكاية شخص فوق الرمال","https://www.poetsgate.com/ViewPoem.aspx?id=182719",""],[5956,"أبتي الحبيب معلّمُ الأبناءِ","https://www.poetsgate.com/ViewPoem.aspx?id=192091",""],[5956,"يا رمزَ خيرِ حضارةِ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=193684",""],[5956,"ندعو تفوز مثوبة الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=193715",""],[5956,"هذي الردينة والإيادُ.. أحِبتي","https://www.poetsgate.com/ViewPoem.aspx?id=194112",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5956,"من يا ترى هذي الحنون؟","https://www.poetsgate.com/ViewPoem.aspx?id=209040",""],[5956,"إذا قال الشَّمالي صدِّقوهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210307",""],[6019,"ما كنتُ إلا ( أنَا )","https://www.poetsgate.com/ViewPoem.aspx?id=151180",""],[6045,"ضيم رائق !","https://www.poetsgate.com/ViewPoem.aspx?id=125351",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6102,"مُراوَحَةٌ بِانتِظارِ المَوتِ...","https://www.poetsgate.com/ViewPoem.aspx?id=186294",""],[6211,"أنا الطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78235&r=&rc=6",""],[6259,"ذكر الحمى فبكى لسجع حمامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59404&r=&rc=52",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["مِنّي إِلى الدَهرِ شَكوى غَيرُ غافِلَةٍ","عَن موثَقٍ بِحِبالِ العَجزِ مَصفودِ",0,"د",1,0],["مِنّي السَلامُ عَلَيكُمُ يا مُنيَتي","عَدَدَ النُجومِ وَكُلِّ طَيرٍ في السَما",1,"ا",1,0],["مَنْ يَا أَخَا الإِتْقَانِ بَعْدَكَ صَائِغٌ","غُرَرَ الْقَرِيضِ بِذَلِكَ الإِتْقَانِ",2,"ن",1,0],["منّي إلى مصر ذات المجد والحسب","تحية ذات ود غير منقضب",3,"ب",1,1],["من يأتِ مجلسنا يصدّق أنه","لمُراد غير الناخبين مؤلَّف",4,"ف",1,0],["من يأتِ مُطّرَد الوزارة يُلفِها","بقيود أهل الاستشارة ترسف",4,"ف",1,0],["من يافث في حسنها أو فرعها","تلقاك في سام يصول وحام",5,"م",1,0],["مِنِّي اللَّجاجة في الهوى وسبيله","وَمِن العَذولِ هِريره وَنباحُهُ",6,"ح",2,0],["مِنّي الهجاءُ ومنك الصبر فاصطبرِ","لِشرِّ منتظَرٍ يا شر منتظِرِ",7,"ر",1,1],["مَنِيُّ العَبدِ عَبدِ بَني سُواجٍ","أَحَقُّ مِنَ المُدامَةِ أَن تَعيبا",8,"ب",2,0],["مِنّي السَلامُ ومن أمٍّ مُفجَّعةٍ","عَلَيكُما أَبَداً مَثنى وَوحدانا",9,"ن",2,0],["مني العراق بثملة رجيعة","جو العراق بشدهم مخنوق",10,"ق",1,0],["مُنىً إن تكنْ كِذْباً فقد طابَ كذبُها","وإن صدقَتْ يوماً تضاعف طِيْبُها",11,"ب",3,0],["مَن يَأمَنِ البَلوى وَبَينا فَتىً","مِن آلِ وَهبٍ بَينَنا إِذ حَبَق",12,"ق",1,1],["مُنى النَفسِ في أَسماءَ لَو تَستَطيعُها","بِها وَجدُها مِن غادَةٍ وَوَلوعُها",13,"ع",3,1],["مَن يَأتِ رابِيَةَ الوَليدِ وَدِفأَها","مِن خائِفٍ لِجَريرَةٍ لا يُضرَرِ",14,"ر",1,0],["مَن يَأتِ عَوّاماً وَيَشرَب عِندَهُ","يَدَعِ الصِيامَ وَلا تُصَلّى الأَربَعُ",15,"ع",1,1],["مُنى النَفسِ مِمّا يوطِئُ المَرءَ عَشوَةً","إِذا النَفسُ جالَت حَولَهُنَّ وَحامَتِ",16,"ت",1,0],["مَن يَأمَنُ المَوتَ إِذ صارَت لَهُ عِلَلٌ","تَكونُ في الزُبدِ أَحياناً وَفي العَسَلِ",17,"ل",1,0],["منّي المصبَّغ حين يبسط كفّه","فبنانُ كلّ خريدة كبناني",18,"ن",2,0],["مُنىً أَطارَ الفُؤادَ عَنّي","وَقَصَّ مِن شَوقِيَ الجَناح",19,"ح",1,0],["مِنّي إِلَيَّ وَتَنسى ذَنبَ رَبَّتِها","إِذا بَرَّحَت بِمُصابِ القَلبِ مَعمُودِ",20,"د",1,0],["مِنّي إِلَيكِ الحَديثَ مُبتَدِعاً","أَو مِن سِواهُ إِلَيكِ ما حُمِلا",21,"ل",2,0],["مِنّي إِلى المُتَكَبِّر","وَالشامِخِ المُتَجَبِّر",22,"ر",1,1],["مَن يَأخُذِ النارَ بِأَطرافِهِ","يَنضَح عَلى النارِ مِنَ بإيتائي",23,"ا",2,0],["مُنيَ القُلوب وكل حي عندها","والأرض ذات العرض بالرجفان",24,"ن",1,0],["مِنّي إليكَ معَ الرّياح تحيّةٌ","مَشْفُوعَةٌ ومعَ الوَميضِ رَسولُ",25,"ل",1,0],["منى النفس ليلى قرّبي فاكِ من فمي","كما لفَّ منقاريهما غردان",26,"ن",1,0],["منّى الرّكب وجهك والصباحا","فجنّ اللّيل من فجرين لاحا",27,"ح",2,1],["مُنىً أرَّقَتْ مصرَ سبعين عامًا","ومَنْ رام درْكَ المنى لم يَنَمْ",28,"م",1,0],["من يأكلُ الخُبزَ القَفا","رَ به، لعمري، ما ائتَدم",29,"م",1,0],["منْ يأخذ النّار بأطرافه","يَنْضَحْ علَى النَّار من المْاء",30,"ا",2,0],["مُنى النفسِ إنَّ المنى تَرتَمى","على قَدَمَيكِ وتَستَعطِف",31,"ف",1,0],["مُنى النفسِ إنّ على وَجنَتيكِ","من رَغبةٍ ظُلَلاً تزحف",31,"ف",1,0],["مُنَى النّفسِ في أسماءَ، لَوْ يَستَطيعُها","بِهَا وَجْدُها مِنْ غادَةٍ وَوَلُوعُهَا",32,"ع",3,1],["من يأخذ الجبار أخذ مجربٍ","ساس الأمور وجال كل مجال",33,"ل",1,0],["مني اليهم ركاب بالغرام سرت","تجول في طور رحال ونزال",34,"ل",1,0],["مني السلام عليهم كلما لمعت","بيضاء بارقة في طي سوداء",35,"ا",2,0],["منّي السلام على الولىّ الوالي","ذى الجود والأجمال والأفضالِ",36,"ل",1,1],["مِني التحية والسلا","مُ عليك طولَ الأَبَدْ",37,"د",1,0],["مُنيَ العِدى مِنهُ بِأَغلَبَ ثائِرٍ","يُنبيكَ مَنظَرُهُ بِصِدقِ المَخبَرِ",38,"ر",1,0],["مَنْ يا تُرى يُصْغي لِدَمْعِكَ إنْ هَوى؟","مَنْ ذا يُجيرُكَ مِنْ صَقيعٍ يَطَّرِدْ ؟",39,"د",1,0],["مني السلامُ على من لو تصافحها","يد النسيم أحست غمز آلامي",40,"م",2,1],["منى النفسِ لو بقيتْ لي المنى","ومن للشقيِّ بيومٍ سعيدِ",41,"د",1,1],["منى السلام على لقاك وطيبه","وعلى كمالك بكرةً واصيلا",42,"ل",2,0],["مَن يا تُرى يَكونُ هذا الوَلَدُ","في مُقلَتَيهِ حُلُمٌ مُشَرَّدُ",43,"د",1,0],["مِنّي السَلامُ إِلَيكَ غَيرَ مَغارِقٍ","يُهدي إِلَيكَ مَعَ الرِكابِ الطلعِ",44,"ع",1,0],["مَن يَأمَنُ الجاني لَدى أَبوابِهِ","وَتَخافُ سَطوَتَهُ المُلوكُ وَتَخشَعُ",45,"ع",1,0],["مني أنا لا شيء ومن سيدي ال","آجر والصناع والنوره",46,"ر",2,0],["منِّي السلامُ عليكَ يا إبليسُ","ما أنت إلا صاحبٌ وأنيسُ",47,"س",1,1],["مني السَلام عَلى أَنوار قبرك ما","تحاوبت ساجعات الايك بالنغم",48,"م",1,0],["مني السَلام عَلى القَبر الَّذي اعكفت","فيه العلى واِنتَهَت فيه النهايات",49,"ت",1,0],["مني السَلام عَلى النور الَّذي اِبتهجَت","به السَموات لما جاز أَعلاها",50,"ا",3,0],["مني السَلام عليك ما هب الصبا","وَتعانقت عذبات بانات الربا",51,"ب",2,0],["مني السَلام عَلى المقيم بطيبة","من طاب من خبث العيوب فَطابا",52,"ب",2,0],["مُنى النَفسَ أَن تَدنو الدِيارُ بِأَهلِها","فَمن بُرَحائي بِالسَلامِ مُنيتُ",53,"ت",1,0],["منّي السَلامُ عليكَ ما","غنّى الحمامُ بذي سَلَم",54,"م",1,0],["منى النفسِ أن أدنو وَلو كنت مبغضاً","فكيف ولي من ودِكنّ نصيب",55,"ب",1,0],["مَن يَأمَنِ اللَه يَخَف","وَخائِفُ اللَهِ أَمن",56,"ن",1,0],["مِنّي إِلَيكَ وَلَو أَنصَفتَ لَم تَلُمِ","لَو أَنتَ تَدري بِما في العُشّاقِ مِن خَطَر",57,"ر",1,0],["منى الأمس يا قلباه والغيب دونها","وأنت بمعنى الغيب ذاكي التفطن",58,"ن",1,0],["مِنّي السَلامُ عَلى الدُنيا وَبَهجَتِها","فَقَد نَعاها إِلَيَّ الشَيبُ وَالكِبَرُ",59,"ر",1,1],["مني السلامُ على رُبوع أحبَّتي","متأَلِّقاً بسواطعِ اللألاءِ",60,"ا",2,0],["مِنّي السَلام عَلى رباك تَحِيَّة","إِن كنت تَقنَع من جَوٍ بِسَلامِهِ",61,"م",2,0],["مني اليك لها اهديك جارية","مغضوضة من قذا النقصان عيناها",62,"ا",3,0],["مني إليك الآن كل تحية","تنبيك عن شوقي وعظم هيامي",63,"م",2,0],["مني إليك عروس المدح مقبلة","بخجلة وهي من كفيك في نعم",64,"م",1,0],["مني القرب لذي شجن","يرضى بالوصل ولو وهما",65,"م",2,0],["مني إليك وقد تباعدَ بيننا","بُعدٌ وصالَ على الصدودِ وصالُ",66,"ل",1,1],["منًى أحْلى من الأمن","وحُرِّفْهُ من المَنِّ",67,"ن",1,0],["منّيَ الصبر فنل","في التنائي أملك",68,"ك",1,0],["مني السلام عليكم وعليكم","مني الثنا فيه النشيد أمادني",69,"ن",2,0],["مني السلام عليك يا مولى الورى","وعلى ضجيعيك السلام تأثنا",70,"ن",2,0],["مُنىً إن تراءتك اللواحظُ فوقه","فأمَّا على الأعداء فهو منونُ",71,"ن",1,0],["منّى أخٌ إن ينأَ عنك وِلادُه","فودادهُ بك لاصق موصولُ",72,"ل",1,0],["مَن يَأمَنُ الدَهرَ أَو يَرجو الخُلودَ بِهِ","بَعدَ الَّذينَ مَضَوا في سالِفِ الأُمَمِ",73,"م",1,0],["مني إلي بدت في الكون فانمحقت","عني المرائي وهي العين تلبيسا",74,"س",2,0],["مني السلام لأبي المعالي","جوهرة الأيام والليالي",75,"ي",1,1],["منّي التحيّةُ غدوةً وعشيّةً","ووكيفُ منخرقِ العَزالِي مُغْدقُ",76,"ق",1,0],["مني السلام على أهل الهدى أبداً","ما ذاقت الروح بالإحسان مشربها",77,"ب",3,0],["مني السلام علي حت","تى أنقضي بطلوع فجري",78,"ر",2,0],["منّي إليك رِسالةٌ في طَيِّها","شَوقُ الشَّجِي وتَحيَّةُ الخِلِّ الوَفِي",79,"ف",2,0],["منى إلى الوطن العزيز تحية","مطبوعة بصحائف الأيام",80,"م",1,0],["مني السلام على الاساتذة الأُلى","قدروا القصائد فوق ما أستأهل",81,"ل",1,1],["مني اليك خريدة أنا واثق","حقا بها أنت الجدير اللائق",82,"ق",1,1],["منى السلام عليك يا أبت الذي","قد كان في الأجياد منك عقودُ",83,"د",1,1],["مِنّي السلامُ عليهِما ما رجَّعَت","وُرقُ الحَمائِمِ في ذُرا الأَغصانِ",84,"ن",1,0],["مني النفس ما بين العذيب وحاجر","بحيث تهاب الأسد بطش الجآذر",85,"ر",1,1],["منّي إليكَ سلام","يَحكي النسائم رقد",86,"د",1,1],["منّي إليكَ أبا الجواد تحيّة","تهدى لمحسنك المحبّ المحسنِ",87,"ن",1,0],["مني السلامُ على ديارِ اَحبَّتي","كالمسكِ تحملُهُ الصَّبَا إذ هبَّتِ",88,"ت",1,1],["مني السلامُ على الذي هجر الحمى","ولهُ خيالٌ لا يزالُ بمقلتي",88,"ت",2,0],["مني السلامُ على الذي هجر الحمَى","فجرت دموعي كالسحائب عَندَما",89,"م",2,1],["مني السلامُ إلى مَن سارَ في السَّحَرِ","وبدَّلَ العينَ بعد النوم بالسَّهَرِ",90,"ر",1,1],["منى البلاد التي كانت تعللها","بها الليالي قضاها عادل القدر",91,"ر",1,0],["منّي السلامُ عليكَ يا بنَ المُصطفى","أبداً يروح مع الزمان ويغْتدي",92,"د",2,0],["من يا عليّ أبا الحسين يقولُ مَنْ","يا هاشميُّ كما أَقولُ وتصنع",93,"ع",1,0],["مني أنت في العمياء غاد ورائح","تصعد في بهمائها وتصوب",94,"ب",1,0],["مني السلام عيك الدهرَ ما سجعت","وُرقُ الحمام على الأغصان والقضب",95,"ب",1,0],["مَن يأخذ الحذر غداة انبعثت","صحراؤهُم تَهدي نسيم السحر",96,"ر",1,0],["مني إليك تحية موصولة","ما إن تزال بها الملائك تصعد",97,"د",1,0],["منى السَّلام للذي اسْت","رشد ما هبت صبا",98,"ب",2,0],["مِنّي المدح ابتداء","ولك الفضل انتهاءَ",99,"ا",2,0],["مِنّي السَّلامُ عَليكُم ما أَضاءَ بِكُم","أُفقٌ وآخي بِكُم لِلفَضلِ إِسفارُ",100,"ر",1,0],["منى أنا لا شي ومن مالكي ال","آجر والاجذاع والنورة",101,"ر",2,0],["مني السلام عليك ما","غطت على الشمس الدجون",102,"ن",1,0],["مني القلب جالي الكرب منقذ من هوى","شفيع إذا هول المعاد ترادفا",103,"ف",2,0],["مِن ياسَمٍ بيضٍ وَوَردٍ أَحمَرا","يَخرُجُ مِن أَكمامِهِ مُعَصفَرا",104,"ر",2,1],["مِني إِلى من بها جار الزمان علَي","وصرت من بعدها إِلف الوساوس حَي",105,"ي",1,1],["من يأتنا رائما فينا الصلات يكن","مثل الذين ومثل اللاء واللات",106,"ت",1,0],["مِنّى الحفاظُ إذا خانوا وإن صبَروا","آذَوا وعندي وفاء الغدرِ إِن غَدَروا",107,"ر",3,0],["مَنّى اِبنُ أَيلولٍ نَفيسَتَهُ","بَعدَ الأَمانِ أَماني الحُمقِ",108,"ق",1,0],["مِنّيَ الصَّبرُ وَمِنكَ ال","هَجرُ فَابلغ بي مَداكا",109,"ك",2,0],["منيَّ القصدُ وتحقيقُ الرجاءِ","من سليلي آل طاها الأصفياءِ",110,"ا",2,1],["مني السَلام وَمنكم لي مثله","أَنتم بدأتم بالمَكارِم فاِختموا",111,"م",3,0],["من يا سليمان الزمان ترى بمي","دان البيان له يراعة فارس",112,"س",1,0],["مُنىً أتمناها ولا يدَ لي بها","سوى خطراتٍ لا تريش ولا تبري",113,"ر",2,0],["من يافع سئم الشبا","ب ولم يصل سن الكهول",114,"ل",1,0],["مُنىً إِن تَكُن حَقّاً تَكُن أَحسَنَ المُنى","وَإِلّا فَقَد عِشنا بِها زَمَناً رَغدا",115,"د",2,0],["مِنى إِلَى صاحِبِ القَبرِ المُنِيرِ سَنَا","أزكى صَلاَةٍ مَعَ الآصالِ وَالبُكُر",116,"ر",1,0],["من يافقي وسامي وغيرهما","من أحمديٍّ وبوذيٍّ ونصراني",117,"ن",2,0],["مُنىَ النفسِ منْ أسماءَ وصلٌ معجَّلُ","وإِنْ أزِف التَّرحالُ بينٌ مؤجَّلُ",118,"ل",1,1],["من يا شقيقي معيني","في مثل 