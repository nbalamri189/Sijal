{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[76,"ومغرد هزج الغناء مطرب","https://www.aldiwan.net/poem12932.html","الكامل"],[83,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[173,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[487,"يا واردا من ليلى قف متصاغيا","https://www.aldiwan.net/poem24336.html","عموديه"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[563,"أنتم هي الجوزة في قشرها","https://www.aldiwan.net/poem34468.html","السريع"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31566","المجتث"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116562","الكامل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18700","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93635","الكامل"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94173","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58324","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115490","البسيط"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143479","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66467","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131275",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103016","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72573","السريع"],[4871,"إب الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=214893",""],[5344,"طبعي مزوح","https://www.poetsgate.com/ViewPoem.aspx?id=154945",""],[5377,"شعب متربص","https://www.poetsgate.com/ViewPoem.aspx?id=61901",""],[5425,"إِبْتِهَالْ","https://www.poetsgate.com/ViewPoem.aspx?id=198924",""],[5628,"حديث مع الطير","https://www.poetsgate.com/ViewPoem.aspx?id=178516",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[6115,"ياوجودي يوم شفت الديره المهجوره","https://www.poetsgate.com/ViewPoem.aspx?id=181608",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""]],"verses":[["وآلُ مُزَيقيَاءِ غَداةَ لاَقَوا","بَني سَعدِ بنِ ضَبَّةَ مُؤلِفِينَا",0,"ن",2,0],["والمُزَاحُ الجدُّ إن فَك","كَرْتَ والجِدُّ المُزَاحُ",1,"ح",1,0],["وَالمُزنُ طِرفٌ جالَ يَصهَلُ أَشهَبٌ","وَالبَرقُ جُلَّ قَد تَمَزَّقَ أَحمَرُ",2,"ر",1,0],["وَالمَزنُ يَهمي باكِياً مُتَجَهِّماً","أَبَداً وَتَهمي ضاحِكاً مُستَبشِرا",3,"ر",2,0],["والمَزيَدِيِّينَ غالَتهُم غَوائِلُهُ","وَاِجتَاحَهُم مُزبِدٌ مِن سَيلِهِ العَرِمِ",4,"م",1,0],["والمزن تسفحُ منهراتُ جراحها","وترى حسام البرق غيرَ مفلَّل",5,"ل",1,0],["والمزن مرخية لذيل دموعها","في كل وقت لا يغيب سياح",6,"ح",1,0],["والمُزْنُ من حسدٍ لجودِ يَمينه","تَبكي أسىً وتظنُّها لن تَهتِنا",7,"ن",2,0],["والمزج من حق ومن باطل","في درة غرقاء في بحرها",8,"ر",3,0],["والمزن تبكى بدموع سائحه","والنهر حنّ والرعود صائحه",9,"ه",1,0],["والمزجُ ماءُ غَديرٍ","صَافٍ كَماءِ الشَّبابِ",10,"ب",1,0],["والمُزنُ هازجَة والأرضُ واشجَةٌ","والشَّمْسُ خارجةٌ من آخر الحُوتِ",11,"ت",1,0],["وآل مُزَيْقِيا فلقد عرفتم","قراعهمُ فكروا عايدينا",12,"ن",2,0],["والمزعجاتُ جفونهنّ غضيضةٌ","والمبهجاتُ غصونهنّ غضاض",13,"ض",1,0],["وَآلُ مُزَيقِياءَ وَقَد تَداعَت","حَلائِبُهُم لَنا حَتّى قَرينا",14,"ن",2,1],["وَالمُزن تعبس إِن همت وَتباين","ما بَين وَجه ضاحك وَمعبِّس",15,"س",1,0],["والمُزُّ بين ذاوذا معتدِل","على الدواء والغذا مُشتمِل",16,"ل",1,0],["والمزايا دنت غصون جناها","حيث تجنى ثمارها دون هز",17,"ز",1,0],["والمزرُ يا مَسعودُ دَعْهُ جانباً","واشرَبْ من اللّبن المخيص مبَكرِّا",18,"ر",2,0],["والمزن تهمى وقوسُ الغيم ذو حُبُكٍ","والشمسُ ترنو وقمريُّ الرعودِ صدح",19,"ح",1,0],["والمزن يضحك في الربى","والورد جمشه الندى",20,"ا",1,0],["والمزن يسمح بالفريد محبباً","وإذا التقى بالأرض جاد بدرهم",21,"م",1,0],["والمزدري كل ذي فحشٍ وذي قحةٍ","لا اللهز يؤلم لحييه ولا الحجر",22,"ر",1,0],["والمزج ينسج عن يدي ندمانها","حلق الفواقع محكم الإبرام",23,"م",1,0],["والمزج قد أطلع من أفقها","زهر نجوم تزدري بالشموس",24,"س",1,0],["والمزن يتدافق بغيث العوافي","والطيف بالوانه والاجواء تطوفه",25,"ف",2,0],["والمزح بين الي يمونون محمود ،","بس المهم يكون طالع ب اوانه",26,"ن",2,0],["والمزح باليدين صاحبه مقرود ،","له يوم يلقى من مزوحه إدانه",26,"ن",2,0],["والمزاد الذي يجدد بيع الشعب","فيه بالبيعة المنكوده",27,"د",2,0],["وَالمُزْنُ مَحْضُ خَيَالَاتٍ مُطَلْسَمَةٍ","وَالبَحْرُ بَعْضٌ مِنَ الأَلوَانِ قَدْ سَاحَا",28,"ح",2,0],["والمزهريّاتُ التي عَبَقَتْ","بالعطْرِ فارقَ زهْرها العطْرُ",29,"ر",1,0],["والمَزَاراتُ الَّتِي لَم تمَّحِي","والمَنَارَاتُ الَّتِي لَم تركَع",30,"ع",1,0],["والمزارع والمساكن كلها مدموره","يوم اطالعها بعيني هيضت وجداني",31,"ن",2,0],["والمزن تعرف أين تنزل حملها","لا تدرك الشر الهزيل أو النيام",32,"م",1,0],["والمزن يهمي سلسلا مترقرقًا","فوق الرّبى من زورة لسحاب",33,"ب",1,0]]}