{"poems":[[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[47,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[47,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[47,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[47,"مَرّتْ على عَزْمِها، وَلمْ تَقِفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32845",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109078","الخفيف"],[1512,"","https://poetry.dctabudhabi.ae/diwan/poem/32994","الطويل"],[1673,"","https://poetry.dctabudhabi.ae/diwan/poem/119053","البسيط"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10411","المنسرح"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26124","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102947","الكامل"],[4869,"موتي قهر","https://www.poetsgate.com/ViewPoem.aspx?id=151653",""]],"verses":[["إِيُّها تَمَطَّرَ نَحوَكَ الداءُ الَّذي","قَرَضَ الرِجالَ وَفَرَّقَ القُرَباءَ",0,"ا",2,0],["أَيهاتَ يَلحَقُ مِن غُبارِكِ لَمحَةً","وَلَوَ اَنَّ في يَدِهِ عِنانَ الذائِدِ",1,"د",1,0],["أَيهاتِ مِنكَ لَقَد أُعطيتَ مَأثُرَةً","مَأثورَةً عَن جُدودٍ غَيرِ أَنكاسِ",2,"س",1,0],["أَيهاتَ ما وَجهُها بِمُلتَفِتٍ","فَإِسلُ وَلا عِطفُها بِمُنعَطِفِ",3,"ف",1,0],["أيهات ما وجهها بملتفٍ","َفاسْلُ وما عطفها بُمْنعطِفِ",4,"ف",1,0],["أيُّ هاتين استميل وإن شئ","تُ اجتناباً ترى فمن أنجنب",5,"ب",1,0],["أَيهاتَ قَد أَبلى عِظامي وَشَفَّها","وَأَسهَرَ لَيلي ذِكرُ عَونِ اِبنِ أَحمَرِ",6,"ر",1,1],["أيهات لن تطلب الأظعان مصعدة","ولن ترى الخصم ذا المغلاق مردودا",7,"د",2,0],["أَيهاتَ مَن أَهلُهُ بِيَثرِبَ قَد","أَمسى وَمَن دونَ أَهلِهِ سَرِفُ",8,"ف",1,0],["أَيهاتَ حَلَّت في السَماءِ بُيوتُهُم","وَأَقامَ بَيتُكَ بِالحَضيضِ الأَقعَدِ",9,"د",1,0],["أيها تركت الكتب بعد دروسها","تشكو الدروس وما لها مستنجد",10,"د",1,0],["إيه آتباها بعزتي لني آنول","مرضاة رب الكون وْكل الميامين",11,"ن",1,0]]}