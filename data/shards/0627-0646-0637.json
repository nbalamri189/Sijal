14",""],[402,"عد لابسا ثوب الخلود وعلم","https://www.poetsgate.com/ViewPoem.aspx?id=36321",""],[5804,"الاقتراب الخطير","https://www.poetsgate.com/ViewPoem.aspx?id=180656",""],[5829,"درة الدهر الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=152342",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5882,"يا ورد 1","https://www.poetsgate.com/ViewPoem.aspx?id=190202",""],[5887,"طابا","https://www.poetsgate.com/ViewPoem.aspx?id=35263",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[5948,"يا فرحتا إذ صَرَفنا أوجه الإبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=100608",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[6003,"الشاعر الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=207312",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6056,"لوحة الإحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=130351",""],[6082,"عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=58948",""],[6093,"رُدّ السلامَ لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=176093",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[186,"أيها النائح المبكر مهلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55791&r=&rc=54",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[6237,"سوزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77873&r=&rc=15",""],[572,"ممنطقُ الخصرِ أجوفٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9334&r=&rc=191",""]],"verses":[["إِن طَواني الغَيبُ عَن أَلحاظِهِم","مَزَقّوا عِرضِيَ تَمزيقَ الأَدَم",0,"م",1,0],["إِن طَوَّحَ الفَعّالَ دَهرٌ ظالِمٌ","فَلَقَد أَقامَ وَخَلَّدَ الأَفعالا",1,"ل",2,0],["إِنَّ طَيفَ الحَبيبِ زارَ طُروقاً","وَالمَطايا بَينَ القِنانِ وَشِعبِ",2,"ب",1,1],["إِنْ طُوِّقُوا نِعَماً وَاللُّؤْمُ مُشْتَمِلٌ","عَلَيْهِمُ فَهْيَ أَطْواقٌ كَأَغْلالِ",3,"ل",1,0],["إِنَّ طَيفَ الخَيالِ يا عَبلَ يَشفي","وَيُداوى بِهِ فُؤادي الكَئيبُ",4,"ب",1,0],["إنْ طووِلَتْ بالدُرِّ منْ حوْلِ الطُلا","يوْماً تشكّتْ حظَّها المَوْكوسا",5,"س",2,0],["إنْ طافَ بها شيْطانُ عِدىً","يبْغي بسَمائِكَ مُسْتَرَقا",6,"ق",2,0],["إِنْ طَافَ شَيْطَانُ الْعِدَى بِسَمَائِهَا","رَجَمَتْهُ شُهْبُ صَلاَتِهَا وَزَكَاتِهَا",7,"ت",3,0],["إِنَّ طيبَ المُناخِ جَرَّ عَلَينا","في سَبيلِ الحَياةِ ذاكَ الزِحاما",8,"م",2,0],["إِن طالَ في السِجنِ إيداعي فَلا عَجَبٌ","قَد يودَعُ الجَفنَ حَدُّ الصارِمِ الذَكَرِ",9,"ر",1,0],["إن طرسا تزينه بسطور","لهو التحفة التي تختار",10,"ر",1,0],["إِنْ طَاشَ رَأْيٌ كُنْتَ خَيْرَ مُسَدِّدٍ","أَوْ زَاغَ حُكْمٌ كُنْتَ خَيْرَ كُقَوِّمِ",11,"م",1,0],["إنّ طرفي ممازح ولساني","وضميري عن الفسوق عفيفُ",12,"ف",1,0],["إن طريق النجاة وعرٌ","يكبو به الطرف ذو النجاء",13,"ا",2,0],["إِن طارَدوا الخَيلَ لَم يُشوُوا فَوارِسَها","أَو واقَفوا عانَقوا الأَبطالَ فَاِهتُصِروا",14,"ر",3,0],["إِنَّ طِلابَكَ شَيئاً لَستَ نائِلَهُ","جَهلٌ وَطولُ لُباناتِ الهَوى سَقَمُ",15,"م",1,0],["انطفت ربُدها الأسرة منها","واستلجت دماؤها تقطيرا",16,"ر",2,1],["إِن طالَ لَيلي في ذُرا","كَ فَقَد نَعِمتُ بِهِ قَصيرا",17,"ر",2,0],["إن طيفاً عن حال شجوايَ أملى","لستُ أدري أدَّى الأمانة أم لا",18,"ل",2,1],["إن طول العتاب يَزْدرِعُ البغ","ضاءَ في قلب كَاره البَغْضاءِ",19,"ا",2,0],["إن طابَ أو طِبْتُمْ فما أبعدتْ","فروعُ مجدٍ أَشبهتْ منصبا",20,"ب",2,0],["أنطَقْتَ مُفْحَمَنَا فأصبح شاعراً","وأَعَرْتَ أَعْجَمَنَا لسانَ فصيحِ",21,"ح",1,0],["إن طول المِطال يُؤْذن بالخُل","ف ولستَ الظَّنينَ بالخلف عندِي",22,"د",2,0],["إنْ طال لم يُملَل وإن هي أوجزت","ودَّ المحدَّثُ أنها لم توجز",23,"ز",1,0],["أنطق مُدَّاحاً وكمَّتْ به","أفواهُ حسّادٍ فلم تَنْبِس",24,"س",1,0],["أنطقه فضلك المبرز بال","حق فأداه غير مُعتَنف",25,"ف",1,0],["إن طُلب الخير فمفتاحه","أو طُلب الشر فمغلاقه",26,"ق",2,0],["إنَّ طولَ المِطالِ يُغري بإرها","قِكَ من لا يَسُرُّه إرهاقُك",27,"ك",1,0],["إِنَّ طَيرَ الأَراكِ لَيسَ يُبالي","أَنتَ أَصغَيتَ أَم أَنا إِن غَرَّد",28,"د",1,0],["إن طلت كانت رحمة","حلَّت على من كان حاضر",29,"ر",1,0],["إِن طِرتَ عَن كَنَفي وَقَع","تَ عَلى النُسورِ الجُهَّلِ",30,"ل",1,0],["إِن طُلِبَ القِسطُ فَما مِنهُمُ","إِلّا جَوادٌ عَن أَبيهِ الجَواد",31,"د",1,0],["إِن طالَ ما غَيَّرَ النائي المُحِبّينا","إِنّا وَإِن زادَنا تَفريقُنا غُلَلاً",32,"ل",2,0],["إِن طالَ فَضلُ لِسانِها","فَجَزاؤُها قَطعُ الرُؤوسِ",33,"س",1,0],["انطوى ذلكَ البساطُ الذي","مُدَّ وفُضَّت مجالسُ الندماءِ",34,"ا",2,0],["إِن طالَ يَومُكَ في الوَغى فَلَقَد تُرى","فيهِ وَيَومُ الهامِ مِنكَ طَويلُ",35,"ل",1,0],["إنْ طلبناها طلبْنا خيالاً","أو تركناها اضْطررْنا إليها",36,"ه",2,0],["إِنَّ طَيفَ الخَيالِ حينَ أَلَمّا","هاجَ لي ذِكرَةً وَأَحدَثَ هَمّا",37,"م",2,1],["إِنَّ طَرفي دَلَّ الفُؤادَ عَلَيها","فَفُؤادي كَالهائِمِ المَقتولِ",38,"ل",1,0],["أَنْطَقُوهُ فترامَى ومضَى","يَقذفُ الأسماعَ بالصّوتِ اللّعينْ",39,"ن",1,0],["أَنَطلُبُهُ فَوضى وَنَسعى جَميعُنا","إِلى عَرَصاتِ المَوتِ سَعياً مُنَظَّما",40,"م",2,0],["أَنُطريهِ قَهّاراً وَنُؤذيهِ مُرهَقاً","كَفى اللَيثَ شَرّاً أَن تُفَلَّ مَخالِبُه",41,"ب",2,0],["أَنطمعُ كَالأَحياءِ في نَيلِ بُغيةٍ","وَأَعداؤُنا تَقضِي عَلينا وَتحكمُ",42,"م",1,0],["إن طافَ شَيطانُ السَلوِّ بِخاطِري","فَشِهابُ شَوقي في المَكانِ يُصيبُهُ",43,"ب",2,0],["أنْطَوي دائماً على كَبِدٍ حَر","رى على حبّكُمْ وقَلْبٍ رَجُوف",44,"ف",1,0],["إِنَّ طولَ السُهادِ وَالدَمعَ كادا","يَترُكانِ الجَليدَ غَيرَ جَليدِ",45,"د",1,0],["إِن طابَ خَيمُكَ في الدُنيا فَلا تَخِمِ","وَلا تَضَنَّ بِمَقتولٍ عَلى الرَخَمِ",46,"م",1,1],["إن طبتَ طبتُ وإن هن","تَ يا عراق أهون",47,"ن",1,0],["إن طريق العقل لا يسدَّ","ومذهب الأفكار لا يحدّ",48,"د",1,0],["إِنَّ طَرْفِي غَرَّ قَلْبِي فَمَضَى","فِي سَبِيلِ الشَّوْقِ حَتَّى هَلَكَا",49,"ك",2,0],["أَنْطُونُ عُوجِلَ فِي شَرْخِ الشَّبَابِ فَهَلْ","فِي الرُّبْعِ أُنْسٌ وَأُنْسُ الرَّبْعِ قَدْ ذَهَبَا",50,"ب",2,0],["إِنَّ طَيفاً يَزورُني في المَنامِ","لَخَلِيٌّ مِن لَوعَتي وَغَرامي",51,"م",2,1],["انطلقتم، وسار يحبو فيكبو","من حدا الفلك والمهار العرابا",52,"ب",2,0],["إن طوقوك، فطالما","طوقت أعناق العتاة",53,"ا",2,0],["إن طافَ شيطانُ العِدا بِسمائِها","رجَمَتْهُ شُهْبٌ صَلاتِها وزكاتِها",54,"ت",3,0],["إن طويل العمر لا يرتضي","حبا ينادي أو صدى يلهم",55,"م",1,0],["أنطقتم الصّور الجماد فخبّرت","عن شأنها ورويتم أخبارها",56,"ر",3,0],["إنَّ طَرْفي دَلَّ الفُؤادَ عَلَيْهَا، سرْ قَليلاً، وَلاَ تَلُمْني خَليلي","لوداعِ الربابِ قبلَ الرحيلِ",57,"ل",1,1],["إنّ طويل العمر لا يرتضي","حيا ينادي … أو صدى يلهم",58,"م",1,0],["ان طعن اللئام نبح كلاب","ونباح الكلاب لا كالكلام",59,"م",1,0],["إن طيف الحبيب بعد الهجوع","زار وأزور مولعا برجوع",60,"ع",1,1],["إِن طَلَبَت عَجَائِزُكُم عِصَاماً","فَكُونُوا لِلعَجَائِزِ قَاتِلِينَا",61,"ن",2,0],["إِن طاوَلا عَلَوا أَو فاضَلا فَضَلا","أَو حارَبا حَرَبا أَو خاطَبا خَطَبا",62,"ب",2,0],["إِن طالَما آثَرتَهُم فَلَطالَما","خاضوا الرَدى وَتَحَمَّلوا الآلاما",63,"م",2,0],["أنطقتها ملء اللّسان","وطال ما كانت فهيهه",64,"ي",3,0],["إن طلبتَ الإنجابَ فانكِحْ غَريباً","وإلى الأقربينَ لا تَتَوسّلْ",65,"ل",1,1],["أَنطونُ بلُّوني أَبو الأَيتامِ قَد","وَلَّى فادركَ رَحمةً وَنَعيما",66,"م",2,1],["أَنطونُ طفلٌ لِشُكرِ اللَهِ باتَ لَهُ","مناحةٌ في بَني الخوري وَتَعديدُ",67,"د",1,1],["إِن طَرْفاً بَكى عَلى هِبةِ اللَا","هِ حَرٍ بِالدِّماء يُسفَحن بَذلا",68,"ل",2,0],["انطح الصخر كيف شئت فإني","من رواسي الصخور أثبت ركنا",69,"ن",2,0],["إِن طلبَت شَيئاً وَلم يُؤتِها","جَميع ما تصدفه يُكسَرُ",70,"ر",1,0],["أَنُطيقُ الحيا وَنَحن شُيوخٌ","شَرفٌ في صُدورِنا وَشعورُ",71,"ر",1,0],["انطق بنفسٍ قبل أن يحسبوا","أنك من طين وآجر",72,"ر",1,0],["أنطت ظَهري بأَوزار وَجئتك لا","قَلب سَليم وَلا شيء أقدمه",73,"م",2,0],["إِن طاعَنتك الحادثاتُ بأسمرٍ","فَاِفزَع إِلى عبد السلام الأسمرِ",74,"ر",1,1],["انطلق فكرة وحلّق خيالا","وانبعث وثبة بغير حدود",75,"د",1,0],["اِن طالَ نوحي عَلَيهِ أَو بكايَ لَهُ","فَتِلكَ نفثَة مَصدور لَه شان",76,"ن",1,0],["أَنطَقتْني بشُكْرِهنَّ أيادي","ه وفي الطّوقِ للحمامةِ سَجْعه",77,"ع",2,0],["أَنطْتَ مُلْكاً فَطَهُر","من بَينِ أحشاءِ الغِيَر",78,"ر",1,0],["إن طَرقَتْ فيه فِكَر","كُلُّ قَليبٍ مُحتَفَر",78,"ر",1,0],["إن طالَ ليلي لا الدُّجى مُنجلٍ","عنهم ولا الكَوكَبُ غوَّارُ",79,"ر",1,0],["إِن طالَعتَ كُتبهُ أَعداؤُهُ كَسرت","فَقارَ أَظهُرِهم مِن خَوفِهِ الفُقرُ",80,"ر",1,0],["إن طمع العاذل في سلوتي","فإنما أستاذه أشعب",81,"ب",1,0],["إنْ طوَّقوني بطَوقٍ من مكارمهم","فإنَّهم وثنائي الطَّوق والجيد",82,"د",1,0],["أنطقَ الودّ لساني فيكُم","لقضاء الحقّ لا للطّلبِ",83,"ب",1,0],["إن طال بالغَ في المعالي وانتهى","أو قال أعجزَ في الكلامِ وأبدَعا",84,"ع",2,0],["أنطقت خرس الأماني وهبي صامتة","ورضت صعب المعاني فهيَ تبتدر",85,"ر",1,0],["أنَّ طعنَ الحميمِ أقصى وأنكى","من شمات المضلل الجاهلي",86,"ي",1,0],["أنْطونيوس إسُّها إرْسانيُوس قبسٌ","ينير أولادَها من مكر حسّاد",87,"د",1,0],["إِن طَفَّلَ السَمعُ عَلى شِعرِهِ","أَصابَهُ غَيرُ مَليحِ الأَثاث",88,"ث",1,0],["إن طارَ قلبُ المَرءِ لله ولم","يَحْفَلْ بِغَوْشِ الكَوْنِ بالله اكْتَفى",89,"ف",2,0],["أنطقتني مناقب علمتني","كيف أثني بها على العلياء",90,"ا",2,0],["إن طعنت فلا شوى","وإن رمت فلا شلل",91,"ل",1,0],["إنْ طاب لِي طعمُ الحياةِ أمرَّهُ","شوقٌ إليك كما علمتَ مبرِّحُ",92,"ح",1,0],["أنطقوا كل بومة بهواهم","وأرادوا السكوت للعندليب",93,"ب",1,0],["أَنْطَقَتْهُ يَدُ امْرِيءٍ","فَاتِرِ اللَّحْظِ سَاحِرِهْ",94,"ر",2,0],["أَنْطَقْتَنِي بالجودِ بل أَفْحمْتني","فأَرى مَقَالَي قد أَطال وقَد جَمح",95,"ح",1,0],["إن طاعة لمليكنا وجبت فهل","ملك المحاسن أمره مردود",96,"د",1,0],["إِن طالَما كانَتِ الأَحزانُ زائِلَةً","مَعَ الزَمانِ فَحَزَني غَيرَ زَيّالِ",97,"ل",1,0],["إن طابَ عَيشي أو تقرّ عيوني","فلَقد بدا لي نور بدر الدينِ",98,"ن",1,1],["إن طاوَلُوكَ لِغايَةٍ بَعُدَت","عَنهُم فَليسَ الحَرفُ كالإسم",99,"م",1,0],["إن طِبتَ دُونَهُمُ طعماً فَلا عَجَبٌ","الأرضُ يَنبُتُ فيها الكَرمُ والدَّحَقُ",100,"ق",1,0],["أنطَقَت وُشحَها وأخرَسَت الخِل","خال بالسّاقِ أيَّما إخراسِ",101,"س",1,0],["إنَّ طَعنَ العيونِ بالحَدَقِ النُّج","لِ سواءٌ والطعنةَ النجلاءَ",102,"ا",2,0],["إن طُلتَ مُلكاً عَن أبيكَ فقَد عَلا","مُلكاً سليمانُ على داوود",103,"د",1,0],["إِن طابَ عَيشي بِأَرض","أَقَمتُ فيها مَليّا",104,"ي",2,0],["إن طار عنه صيد وإن مشى","أو غاب عنه في السماء فتّشا",105,"ش",2,0],["أنطقتني بعد السكوت ليالياً","حبست جناني قبل حبس لساني",106,"ن",2,0],["إن طال مكث ضيوف مصر فصبرها","أقوى وأفضل من عثار الواثب",107,"ب",1,0],["أنطمئن إلى الخصم العنيد وما","تراجع الخصم عن نفي وتبعيد",108,"د",1,0],["أنطلب اليوم أن تخفى مقاتلنا","عن الرماة ونحن اليوم نقتتل",109,"ل",1,0],["ان طال حملى عبء الذل في بلد","تطاول الأكم فيه قمة القنن",110,"ن",1,0],["إِن طالَ شَخصٌ لِحيَةً","كانَت بِضاعَتُهُ قَليلهْ",111,"ه",1,1],["اِنطَلَق الإِثنان في الطَريقِ","مثل اِنطِلاق الماءِ في إِبريق",112,"ق",1,0],["أنطمع بعدهم في البقا","وأرواحنا زادهم في السفر",113,"ر",1,0],["إن طال أو جال في يومي ندى وردى","فالناس أكياس والأغماد هامات",114,"ت",1,0],["إِن طَفا خافَ منَ الطيرِ وإن","رَسب اللجّ تلقّاه السمك",115,"ك",1,0],["انطقتني انني بفهمي متى","شئت وعزمي في الحالتين ملي",116,"ل",2,0],["إن طال وجدي فيهم فأنا الذي","نومي بطول الليل غير طويل",117,"ل",1,0],["إن طلعت مجلوة","يحلو عليها السمر",118,"ر",1,0],["إِن طارَ في الجَو لَهُ صَيحة","فَافهمه إِن اللغز تَصريح",119,"ح",1,0],["إن طاها شرع الدين وفي","مدحه قد أنزل الرحمن طاها",120,"ه",2,1],["إِنْ طَالَ هَذَا أَوْ كَفانِي كافِ","حَتَّى إِذا مَا نَحَلَتْ أَكْنَافِي",121,"ف",2,0],["أَنطقْتَ بالفتح أَعوادَ الوشيج وما","أَخْليْتَ عن ذكرِهِ مِنْ مِنْبرٍ عُودا",122,"د",2,0],["إن طول الحياة داء وما نف","عُ حياةٍ لمن قضت أترابه",123,"ب",2,0],["إن طلبوا عندَك ثارَ الغلبِ","فهل تراهم أجملوا في الطلبِ",124,"ب",1,0],["انطق لي الصبر لسالي فما","أخضع بالقول لجلاسي",125,"س",2,0],["إنّ طولَ الحبل في الآبار د","لَّ على بعدِ مجال المستقى",126,"ق",2,0],["إن طَهرَ اللَهُ بَيتاً جِئتُموهُ كَما","قَد أَذهَب الرجس عَنكُم فَهوَ مَفصولُ",127,"ل",1,0],["إن طَلبتونا عِطيناكم","وان طَلَبنا ما عطيتونا",128,"ن",2,0],["إن طافَ حولَ خبائها","من ليس من أهل الطَوافِ",129,"ف",1,0],["اِنَطمَع في دار سَريع زَوالِها","وَكاس المَنايا مِنهُ لَيسَ لَنا بُد",130,"د",1,0],["أنطقتُمُ الشّعْر قدماً يا بني عُمَرٍ","يُثْني عليكم ولولا جودكم خَرسَا",131,"س",2,0],["ان طرفاً ما قر فيك أب