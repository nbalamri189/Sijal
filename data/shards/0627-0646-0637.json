,1,0],["إن طِرسِي هذا لَذو مَنطِقٍ لَو","كانَ سَيفاً يَرَى القَضا محتُوما",215,"م",2,1],["إن طويتُ الغرامَ بين ضلوعي","نَشرته بين الانام دُموعي",216,"ع",2,1],["إِن طابَ إِنشادُ شِعري في المَديح فَقد","وَقفت في مدحه شعري وَإِنشادي",217,"د",2,0],["إن طاف من حدثانه بي","فمكارم القاضي سفينة نوح",218,"ح",1,0],["انْ طالَ لَيْلُ الخَطْبِ قَصَّرَ طُولَهُ","رايُ الشُّيُوخِ وعَزْمَةُ الشُّبانِ",219,"ن",1,0],["إِن طارَ عَقلُ الَّذي قَد شَمَّ رَيّاك","فَكَيفَ حالُ الَّذي قَد نالَ رُؤياكِ",220,"ك",1,1],["أنطق الحكمة بالفهم كما","جعل الأمثل فيئا يغتنم",221,"م",1,0],["ان طال تحمالي فكم من قائل","ارأيت من حملوا على الاعواد",222,"د",1,0],["أنطمع في وعد الأماني الكواذبِ","ونأمنُ من صرف القضاء المحاربِ",223,"ب",1,1],["إنطلَقَ الفكر بعيدَ المدى","كالصَّقر لمّا فرَّ من وَكره",224,"ر",2,0],["أنطونُ إن تصف البنينَ فنشأة","في روضةٍ بالحسنِ أجمع تُوصفُ",225,"ف",1,1],["أنْطَقْتِنِى شِِعْرًا ولسْتُ بِشَاعِرٍ","يَا مَنْ عَلَِى نَظْمِ القََوافِى تَأْنفُ",226,"ف",1,0],["ان طعتني لك احترامي وشكري","الله عطاك العقل بالفكر تختار",227,"ر",1,0],["إن طالني قحط فلي","زخات عين ماطره",228,"ر",2,0],["ان طحت لاترجي سوى عالم الغيب","الواحد الي من ترجاه ماخاب",229,"ب",1,0],["انْ طالَ لسامرها طربٌ","أو أزرَتْ فيه أحزانا",230,"ن",2,0],["اِنْ طالَ هلالُكَ مطلعُهُ","سيظلُّ القلبُ بلا اِفطارْ",231,"ر",1,0],["انطرني ياحب كله ورد ويا خد","مثل الشهد انطرني يا قمر يوم العيد",232,"د",1,0],["انْطلِقْ في الركض واسرعْ يا عجول","قد شرعنا في تبارينا المهول",233,"ل",1,1],["أنطقت بنتئور في صمته الدهْ","ر فغنّى وخلّد الأشعارا",234,"ر",2,0],["إن طال بعدي عنكم لا ابتغي","قرباً وأرغب في دوام فراق",235,"ق",1,0],["إِنْ طَافَتِ الأَيَّامُ دُونَ مَلاَمِحٍ","فَمَلاَحِمُ التَّارِيِخِ طَيَّ طِبَاقِنَا",236,"ن",2,0],["إنْ طَالَ لَيْلُكَ واعْتَرَتْكَ هُمُومُ","وجَفَاكَ مِنَ بَعْدِ التَّذَكُّرِ نَوْمُ",237,"م",1,1],["إن طلبت الرزق لن تدركه","وإذا وليت عنه تبعك",238,"ك",1,0],["إن طي النسيم أنفاس شجو","من غرامي تجرى الدموع سجاما",239,"م",2,0],["إن طريقاً أنت فيه سالك","أصبح لا يسلكه هذا الورى",240,"ا",1,0],["إن طال ليلك في بلادك فاحترس","لا