ل في مصر نواك فان","لبناناً اليها يزمع الترحالا",160,"ل",2,0],["ان طرفي هو علينا قد جنى","منذ ورد في خدودك قد جنا",161,"ن",2,0],["إن طول البعد أرقّ ناظري","واشتياقي يا فتى أشغل خاطري",162,"ي",1,0],["إن طَالَتِ الأيَّامُ والليالي","ما تأسَفَن على الزَّوالِ",163,"ل",1,0],["إن طََّبقَ المَحلُ البلادَ فأننا","في روضة من خصبها وغديرِ",164,"ر",1,0],["أنطقوا الميتَ أخرجُوا الحيَّ منهُ","رَتَّلوا بالحديدِ آىَ الأغانى",165,"ن",2,0],["إن طاب عيشك بالمسرة أو صفا","قبل الفوات فوات دهراً أنصفا",166,"ف",2,1],["إن طلبنا حديثه عربياً","قال أحمى حميث أطمى طميثا",167,"ث",2,0],["إن طاولوا طالوا بمجدهم","أو غالبوا بنوالهم غلبوا",168,"ب",3,0],["إن طلبتم أعداءكم لم تلاقوا","غير تجاركم لكم أعداء",169,"ا",2,0],["إن طال عمر فلان قلت لا عجب","الموت يهرب منه من غلاظته",170,"ه",1,1],["إن طعم الفراق كالصبر مرٌّ","ويقول الخليُّ صبراً جميلا",171,"ل",2,0],["ان طعم الدواء ينكره الذوق","وفيه يلقى المريض شفاه",172,"ا",2,0],["إن طلبت الغناء يطربني","اسكرتني الالحان من فيها",173,"ي",3,0],["إن طغى في الشرق سيل جارف","في عوادي الغرب لاقى منه سدا",174,"د",2,0],["إن طال مدحي لكم فلا عجبٌ","مُطوّل المدح فيك مُختصرُ",175,"ر",1,0],["إن طاعنوا دون أقصى أرضهم فهم","بقية من مطاعيم مطاعين",176,"ن",1,0],["ان طباع السوء مذ تقسمت","اصبح فيك لؤمها وكبرها",177,"ر",3,0],["إن طال هذا كان هذا قاصراً","فعلى إخائهما هما ضدان",178,"ن",1,0],["إن طاوَلتْك ملوكُ عصرِك رفعةً","يَا ابنَ الملوكِ فأنت أطولُ عُنْقا",179,"ق",2,0],["إن طالَ لَومُ العُذَّلِ","أو لم يَطُل لم يحلُ لي",180,"ل",2,1],["إن طال ما قام فيكم وهو معتزل","فقد أتى الدين طوعاً غير معتزل",181,"ل",1,0],["أنطون ذاك سعيد النجم طالعه","عطارد وحماه الشمس في الأسد",182,"د",1,0],["إِنَّ طاعَة لِلإِمام عَلى كل","لِ موالٍ من أَفضَل الطاعاتِ",183,"ت",1,0],["أَنطَقتني تلك الأَيادي طَويلاً","بعد عهد من السكوت طَويلِ",184,"ل",1,0],["اِنطَلِق اليَوم بأَرجائها","إِنّك وَالطير طَليقانِ",185,"ن",1,0],["إِن طابَ فَرعٌ منك في","مصر فَفي السودان أَصلُ",186,"ل",1,0],["إنْ طَغى معْتَدٍ وصوّحَ مرْعىً","أسدٌ عابسٌ وغيْثٌ باجِسْ",187,"س",1,0],["ان طور الوصال حضرة قدسٍ","فاخلع النعل والفؤاد