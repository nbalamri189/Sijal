{"poems":[[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"إن طيف الحبيب زار طروقا","https://www.aldiwan.net/poem30725.html","الخفيف"],[63,"ضلت قبيلة راموا مساجلتي","https://www.aldiwan.net/poem45928.html","البسيط"],[3,"حسناتي عند الزمان ذنوب","https://www.aldiwan.net/poem130.html",""],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[93,"حسدت خطك الحلي من العسجد","https://www.aldiwan.net/poem11078.html","الخفيف"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[41,"يا خليلي قد صفا كدر العيش","https://www.aldiwan.net/poem42369.html","الخفيف"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[37,"انطفت ربدها الأسرة منها","https://www.aldiwan.net/poem7079.html","الخفيف"],[47,"إن زرت خرشنة أسيرا","https://www.aldiwan.net/poem25260.html","مجزوء الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أيها الواعد المماطل بالبر","https://www.aldiwan.net/poem61841.html","الخفيف"],[51,"وحديثها السحر الحلال لو انها","https://www.aldiwan.net/poem64552.html","الكامل"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[85,"يا ليل طل أو لا تطل","https://www.aldiwan.net/poem7298.html","مجزوء الكامل"],[85,"صداح يا ملك الكنار","https://www.aldiwan.net/poem63754.html","مجزوء الكامل"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[66,"نار الشموع توقدت","https://www.aldiwan.net/poem40992.html","مجزوء الكامل"],[97,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[69,"إنما الدنيا عناء وذل","https://www.aldiwan.net/poem28561.html","المديد"],[31,"إن طيف الخيال حين ألما","https://www.aldiwan.net/poem41313.html","الخفيف"],[31,"سر قليلا ولا تلمني خليلي","https://www.aldiwan.net/poem41866.html","الخفيف"],[105,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[105,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[81,"صب تحكم كيف شاء حبيبه","https://www.aldiwan.net/poem61550.html","الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[46,"إن طاب خيمك في الدنيا فلا تخم","https://www.aldiwan.net/poem23386.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54636","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[100,"كانوا رجالا","https://www.poetsgate.com/ViewPoem.aspx?id=50425",""],[94,"أهوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=15665",""],[31,"إنَّ طَرْفي دَلَّ الفُؤادَ عَلَيْهَا، سرْ قَليلاً، وَلاَ تَلُمْني خَليلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19004&r=&rc=267",""],[100,"كانوا رجالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67691&r=&rc=178",""],[115,"صبرت عليك عن حلم ورفق","https://www.aldiwan.net/poem40587.html","عموديه"],[132,"إن طيف الحبيب بعد الهجوع","https://www.aldiwan.net/poem54645.html","الخفيف"],[132,"عجبت لأسرة الحسن الدينا","https://www.aldiwan.net/poem54720.html","الوافر"],[143,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[143,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[150,"فالآن أحسن إن نثرت","https://www.aldiwan.net/poem68537.html","مجزوء الكامل"],[166,"إن طلبت الإنجاب فانكح غريبا","https://www.aldiwan.net/poem46894.html","الخفيف"],[182,"أنطون بلوني أبو الأيتام قد","https://www.aldiwan.net/poem61052.html","الكامل"],[182,"أنطون طفل لشكر الله بات له","https://www.aldiwan.net/poem67003.html","البسيط"],[182,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[211,"أقبل العيد ما رأينا صفاه","https://www.aldiwan.net/poem46236.html","الخفيف"],[223,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[223,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[256,"يا صنما يعبده شعري","https://www.aldiwan.net/poem48421.html","السريع"],[271,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[305,"إِن طاعنتك الحادثات بأسمر","https://www.aldiwan.net/poem56531.html","الكامل"],[328,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[361,"لا تأمن الدهر ان الدهر خوان","https://www.aldiwan.net/poem68052.html","البسيط"],[364,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[364,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[371,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"],[380,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[403,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[416,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[432,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[432,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[437,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[453,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[468,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[468,"يا صاح لا تصغ إلى لفظة","https://www.aldiwan.net/poem60331.html","السريع"],[500,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[515,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[551,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[558,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[567,"مخطف الخصر أجوف","https://www.aldiwan.net/poem69655.html","مجزوء الخفيف"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["إِن طَواني الغَيبُ عَن أَلحاظِهِم","مَزَقّوا عِرضِيَ تَمزيقَ الأَدَم",0,"م",1,0],["إِن طَوَّحَ الفَعّالَ دَهرٌ ظالِمٌ","فَلَقَد أَقامَ وَخَلَّدَ الأَفعالا",1,"ل",2,0],["إِنَّ طَيفَ الحَبيبِ زارَ طُروقاً","وَالمَطايا بَينَ القِنانِ وَشِعبِ",2,"ب",1,1],["إِنْ طُوِّقُوا نِعَماً وَاللُّؤْمُ مُشْتَمِلٌ","عَلَيْهِمُ فَهْيَ أَطْواقٌ كَأَغْلالِ",3,"ل",1,0],["إِنَّ طَيفَ الخَيالِ يا عَبلَ يَشفي","وَيُداوى بِهِ فُؤادي الكَئيبُ",4,"ب",1,0],["إنْ طووِلَتْ بالدُرِّ منْ حوْلِ الطُلا","يوْماً تشكّتْ حظَّها المَوْكوسا",5,"س",2,0],["إنْ طافَ بها شيْطانُ عِدىً","يبْغي بسَمائِكَ مُسْتَرَقا",6,"ق",2,0],["إِنْ طَافَ شَيْطَانُ الْعِدَى بِسَمَائِهَا","رَجَمَتْهُ شُهْبُ صَلاَتِهَا وَزَكَاتِهَا",7,"ت",3,0],["إِنَّ طيبَ المُناخِ جَرَّ عَلَينا","في سَبيلِ الحَياةِ ذاكَ الزِحاما",8,"م",2,0],["إِن طالَ في السِجنِ إيداعي فَلا عَجَبٌ","قَد يودَعُ الجَفنَ حَدُّ الصارِمِ الذَكَرِ",9,"ر",1,0],["إن طرسا تزينه بسطور","لهو التحفة التي تختار",10,"ر",1,0],["إِنْ طَاشَ رَأْيٌ كُنْتَ خَيْرَ مُسَدِّدٍ","أَوْ زَاغَ حُكْمٌ كُنْتَ خَيْرَ كُقَوِّمِ",11,"م",1,0],["إنّ طرفي ممازح ولساني","وضميري عن الفسوق عفيفُ",12,"ف",1,0],["إن طريق النجاة وعرٌ","يكبو به الطرف ذو النجاء",13,"ا",2,0],["إِن طارَدوا الخَيلَ لَم يُشوُوا فَوارِسَها","أَو واقَفوا عانَقوا الأَبطالَ فَاِهتُصِروا",14,"ر",3,0],["إِنَّ طِلابَكَ شَيئاً لَستَ نائِلَهُ","جَهلٌ وَطولُ لُباناتِ الهَوى سَقَمُ",15,"م",1,0],["انطفت ربُدها الأسرة منها","واستلجت دماؤها تقطيرا",16,"ر",2,1],["إِن طالَ لَيلي في ذُرا","كَ فَقَد نَعِمتُ بِهِ قَصيرا",17,"ر",2,0],["إن طيفاً عن حال شجوايَ أملى","لستُ أدري أدَّى الأمانة أم لا",18,"ل",2,1],["إن طول العتاب يَزْدرِعُ البغ","ضاءَ في قلب كَاره البَغْضاءِ",19,"ا",2,0],["إن طابَ أو طِبْتُمْ فما أبعدتْ","فروعُ مجدٍ أَشبهتْ منصبا",20,"ب",2,0],["أنطَقْتَ مُفْحَمَنَا فأصبح شاعراً","وأَعَرْتَ أَعْجَمَنَا لسانَ فصيحِ",21,"ح",1,0],["إن طول المِطال يُؤْذن بالخُل","ف ولستَ الظَّنينَ بالخلف عندِي",22,"د",2,0],["إنْ طال لم يُملَل وإن هي أوجزت","ودَّ المحدَّثُ أنها لم توجز",23,"ز",1,0],["أنطق مُدَّاحاً وكمَّتْ به","أفواهُ حسّادٍ فلم تَنْبِس",24,"س",1,0],["أنطقه فضلك المبرز بال","حق فأداه غير مُعتَنف",25,"ف",1,0],["إن طُلب الخير فمفتاحه","أو طُلب الشر فمغلاقه",26,"ق",2,0],["إنَّ طولَ المِطالِ يُغري بإرها","قِكَ من لا يَسُرُّه إرهاقُك",27,"ك",1,0],["إِنَّ طَيرَ الأَراكِ لَيسَ يُبالي","أَنتَ أَصغَيتَ أَم أَنا إِن غَرَّد",28,"د",1,0],["إن طلت كانت رحمة","حلَّت على من كان حاضر",29,"ر",1,0],["إِن طِرتَ عَن كَنَفي وَقَع","تَ عَلى النُسورِ الجُهَّلِ",30,"ل",1,0],["إِن طُلِبَ القِسطُ فَما مِنهُمُ","إِلّا جَوادٌ عَن أَبيهِ الجَواد",31,"د",1,0],["إِن طالَ ما غَيَّرَ النائي المُحِبّينا","إِنّا وَإِن زادَنا تَفريقُنا غُلَلاً",32,"ل",2,0],["إِن طالَ فَضلُ لِسانِها","فَجَزاؤُها قَطعُ الرُؤوسِ",33,"س",1,0],["انطوى ذلكَ البساطُ الذي","مُدَّ وفُضَّت مجالسُ الندماءِ",34,"ا",2,0],["إِن طالَ يَومُكَ في الوَغى فَلَقَد تُرى","فيهِ وَيَومُ الهامِ مِنكَ طَويلُ",35,"ل",1,0],["إنْ طلبناها طلبْنا خيالاً","أو تركناها اضْطررْنا إليها",36,"ه",2,0],["إِنَّ طَيفَ الخَيالِ حينَ أَلَمّا","هاجَ لي ذِكرَةً وَأَحدَثَ هَمّا",37,"م",2,1],["إِنَّ طَرفي دَلَّ الفُؤادَ عَلَيها","فَفُؤادي كَالهائِمِ المَقتولِ",38,"ل",1,0],["أَنْطَقُوهُ فترامَى ومضَى","يَقذفُ الأسماعَ بالصّوتِ اللّعينْ",39,"ن",1,0],["أَنَطلُبُهُ فَوضى وَنَسعى جَميعُنا","إِلى عَرَصاتِ المَوتِ سَعياً مُنَظَّما",40,"م",2,0],["أَنُطريهِ قَهّاراً وَنُؤذيهِ مُرهَقاً","كَفى اللَيثَ شَرّاً أَن تُفَلَّ مَخالِبُه",41,"ب",2,0],["أَنطمعُ كَالأَحياءِ في نَيلِ بُغيةٍ","وَأَعداؤُنا تَقضِي عَلينا وَتحكمُ",42,"م",1,0],["إن طافَ شَيطانُ السَلوِّ بِخاطِري","فَشِهابُ شَوقي في المَكانِ يُصيبُهُ",43,"ب",2,0],["أنْطَوي دائماً على كَبِدٍ حَر","رى على حبّكُمْ وقَلْبٍ رَجُوف",44,"ف",1,0],["إِنَّ طولَ السُهادِ وَالدَمعَ كادا","يَترُكانِ الجَليدَ غَيرَ جَليدِ",45,"د",1,0],["إِن طابَ خَيمُكَ في الدُنيا فَلا تَخِمِ","وَلا تَضَنَّ بِمَقتولٍ عَلى الرَخَمِ",46,"م",1,1],["إن طبتَ طبتُ وإن هن","تَ يا عراق أهون",47,"ن",1,0],["إن طريق العقل لا يسدَّ","ومذهب الأفكار لا يحدّ",48,"د",1,0],["إِنَّ طَرْفِي غَرَّ قَلْبِي فَمَضَى","فِي سَبِيلِ الشَّوْقِ حَتَّى هَلَكَا",49,"ك",2,0],["أَنْطُونُ عُوجِلَ فِي شَرْخِ الشَّبَابِ فَهَلْ","فِي الرُّبْعِ أُنْسٌ وَأُنْسُ الرَّبْعِ قَدْ ذَهَبَا",50,"ب",2,0],["إِنَّ طَيفاً يَزورُني في المَنامِ","لَخَلِيٌّ مِن لَوعَتي وَغَرامي",51,"م",2,1],["انطلقتم، وسار يحبو فيكبو","من حدا الفلك والمهار العرابا",52,"ب",2,0],["إن طوقوك، فطالما","طوقت أعناق العتاة",53,"ا",2,0],["إن طافَ شيطانُ العِدا بِسمائِها","رجَمَتْهُ شُهْبٌ صَلاتِها وزكاتِها",54,"ت",3,0],["إن طويل العمر لا يرتضي","حبا ينادي أو صدى يلهم",55,"م",1,0],["أنطقتم الصّور الجماد فخبّرت","عن شأنها ورويتم أخبارها",56,"ر",3,0],["إنَّ طَرْفي دَلَّ الفُؤادَ عَلَيْهَا، سرْ قَليلاً، وَلاَ تَلُمْني خَليلي","لوداعِ الربابِ قبلَ الرحيلِ",57,"ل",1,1],["إنّ طويل العمر لا يرتضي","حيا ينادي … أو صدى يلهم",58,"م",1,0],["ان طعن اللئام نبح كلاب","ونباح الكلاب لا كالكلام",59,"م",1,0],["إن طيف الحبيب بعد الهجوع","زار وأزور مولعا برجوع",60,"ع",1,1],["إِن طَلَبَت عَجَائِزُكُم عِصَاماً","فَكُونُوا لِلعَجَائِزِ قَاتِلِينَا",61,"ن",2,0],["إِن طاوَلا عَلَوا أَو فاضَلا فَضَلا","أَو حارَبا حَرَبا أَو خاطَبا خَطَبا",62,"ب",2,0],["إِن طالَما آثَرتَهُم فَلَطالَما","خاضوا الرَدى وَتَحَمَّلوا الآلاما",63,"م",2,0],["أنطقتها ملء اللّسان","وطال ما كانت فهيهه",64,"ي",3,0],["إن طلبتَ الإنجابَ فانكِحْ غَريباً","وإلى الأقربينَ لا تَتَوسّلْ",65,"ل",1,1],["أَنطونُ بلُّوني أَبو الأَيتامِ قَد","وَلَّى فادركَ رَحمةً وَنَعيما",66,"م",2,1],["أَنطونُ طفلٌ لِشُكرِ اللَهِ باتَ لَهُ","مناحةٌ في بَني الخوري وَتَعديدُ",67,"د",1,1],["إِن طَرْفاً بَكى عَلى هِبةِ اللَا","هِ حَرٍ بِالدِّماء يُسفَحن بَذلا",68,"ل",2,0],["انطح الصخر كيف شئت فإني","من رواسي الصخور أثبت ركنا",69,"ن",2,0],["إِن طلبَت شَيئاً وَلم يُؤتِها","جَميع ما تصدفه يُكسَرُ",70,"ر",1,0],["أَنُطيقُ الحيا وَنَحن شُيوخٌ","شَرفٌ في صُدورِنا وَشعورُ",71,"ر",1,0],["انطق بنفسٍ قبل أن يحسبوا","أنك من طين وآجر",72,"ر",1,0],["أنطت ظَهري بأَوزار وَجئتك لا","قَلب سَليم وَلا شيء أقدمه",73,"م",2,0],["إِن طاعَنتك الحادثاتُ بأسمرٍ","فَاِفزَع إِلى عبد السلام الأسمرِ",74,"ر",1,1],["انطلق فكرة وحلّق خيالا","وانبعث وثبة بغير حدود",75,"د",1,0],["اِن طالَ نوحي عَلَيهِ أَو بكايَ لَهُ","فَتِلكَ نفثَة مَصدور لَه شان",76,"ن",1,0],["أَنطَقتْني بشُكْرِهنَّ أيادي","ه وفي الطّوقِ للحمامةِ سَجْعه",77,"ع",2,0],["أَنطْتَ مُلْكاً فَطَهُر","من بَينِ أحشاءِ الغِيَر",78,"ر",1,0],["إن طَرقَتْ فيه فِكَر","كُلُّ قَليبٍ مُحتَفَر",78,"ر",1,0],["إن طالَ ليلي لا الدُّجى مُنجلٍ","عنهم ولا الكَوكَبُ غوَّارُ",79,"ر",1,0],["إِن طالَعتَ كُتبهُ أَعداؤُهُ كَسرت","فَقارَ أَظهُرِهم مِن خَوفِهِ الفُقرُ",80,"ر",1,0],["إن طمع العاذل في سلوتي","فإنما أستاذه أشعب",81,"ب",1,0],["إنْ طوَّقوني بطَوقٍ من مكارمهم","فإنَّهم وثنائي الطَّوق والجيد",82,"د",1,0],["أنطقَ الودّ لساني فيكُم","لقضاء الحقّ لا للطّلبِ",83,"ب",1,0],["إن طال بالغَ في المعالي وانتهى","أو قال أعجزَ في الكلامِ وأبدَعا",84,"ع",2,0],["أنطقت خرس الأماني وهبي صامتة","ورضت صعب المعاني فهيَ تبتدر",85,"ر",1,0],["أنَّ طعنَ الحميمِ أقصى وأنكى","من شمات المضلل الجاهلي",86,"ي",1,0],["أنْطونيوس إسُّها إرْسانيُوس قبسٌ","ينير أولادَها من مكر حسّاد",87,"د",1,0],["إِن طَفَّلَ السَمعُ عَلى شِعرِهِ","أَصابَهُ غَيرُ مَليحِ الأَثاث",88,"ث",1,0],["إن طارَ قلبُ المَرءِ لله ولم","يَحْفَلْ بِغَوْشِ الكَوْنِ بالله اكْتَفى",89,"ف",2,0],["أنطقتني مناقب علمتني","كيف أثني بها على العلياء",90,"ا",2,0],["إن طعنت فلا شوى","وإن رمت فلا شلل",91,"ل",1,0],["إنْ طاب لِي طعمُ الحياةِ أمرَّهُ","شوقٌ إليك كما علمتَ مبرِّحُ",92,"ح",1,0],["أنطقوا كل بومة بهواهم","وأرادوا السكوت للعندليب",93,"ب",1,0],["أَنْطَقَتْهُ يَدُ امْرِيءٍ","فَاتِرِ اللَّحْظِ سَاحِرِهْ",94,"ر",2,0],["أَنْطَقْتَنِي بالجودِ بل أَفْحمْتني","فأَرى مَقَالَي قد أَطال وقَد جَمح",95,"ح",1,0]]}