{"poems":[[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"إن طيف الحبيب زار طروقا","https://www.aldiwan.net/poem30725.html","الخفيف"],[63,"ضلت قبيلة راموا مساجلتي","https://www.aldiwan.net/poem45928.html","البسيط"],[3,"حسناتي عند الزمان ذنوب","https://www.aldiwan.net/poem130.html",""],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[93,"حسدت خطك الحلي من العسجد","https://www.aldiwan.net/poem11078.html","الخفيف"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[41,"يا خليلي قد صفا كدر العيش","https://www.aldiwan.net/poem42369.html","الخفيف"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[37,"انطفت ربدها الأسرة منها","https://www.aldiwan.net/poem7079.html","الخفيف"],[47,"إن زرت خرشنة أسيرا","https://www.aldiwan.net/poem25260.html","مجزوء الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أيها الواعد المماطل بالبر","https://www.aldiwan.net/poem61841.html","الخفيف"],[51,"وحديثها السحر الحلال لو انها","https://www.aldiwan.net/poem64552.html","الكامل"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[85,"يا ليل طل أو لا تطل","https://www.aldiwan.net/poem7298.html","مجزوء الكامل"],[85,"صداح يا ملك الكنار","https://www.aldiwan.net/poem63754.html","مجزوء الكامل"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[66,"نار الشموع توقدت","https://www.aldiwan.net/poem40992.html","مجزوء الكامل"],[97,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[69,"إنما الدنيا عناء وذل","https://www.aldiwan.net/poem28561.html","المديد"],[31,"إن طيف الخيال حين ألما","https://www.aldiwan.net/poem41313.html","الخفيف"],[31,"سر قليلا ولا تلمني خليلي","https://www.aldiwan.net/poem41866.html","الخفيف"],[105,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[105,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[81,"صب تحكم كيف شاء حبيبه","https://www.aldiwan.net/poem61550.html","الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[46,"إن طاب خيمك في الدنيا فلا تخم","https://www.aldiwan.net/poem23386.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54636","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[31,"إنَّ طَرْفي دَلَّ الفُؤادَ عَلَيْهَا، سرْ قَليلاً، وَلاَ تَلُمْني خَليلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19004&r=&rc=267",""]],"verses":[["إِن طَواني الغَيبُ عَن أَلحاظِهِم","مَزَقّوا عِرضِيَ تَمزيقَ الأَدَم",0,"م",1,0],["إِن طَوَّحَ الفَعّالَ دَهرٌ ظالِمٌ","فَلَقَد أَقامَ وَخَلَّدَ الأَفعالا",1,"ل",2,0],["إِنَّ طَيفَ الحَبيبِ زارَ طُروقاً","وَالمَطايا بَينَ القِنانِ وَشِعبِ",2,"ب",1,1],["إِنْ طُوِّقُوا نِعَماً وَاللُّؤْمُ مُشْتَمِلٌ","عَلَيْهِمُ فَهْيَ أَطْواقٌ كَأَغْلالِ",3,"ل",1,0],["إِنَّ طَيفَ الخَيالِ يا عَبلَ يَشفي","وَيُداوى بِهِ فُؤادي الكَئيبُ",4,"ب",1,0],["إنْ طووِلَتْ بالدُرِّ منْ حوْلِ الطُلا","يوْماً تشكّتْ حظَّها المَوْكوسا",5,"س",2,0],["إنْ طافَ بها شيْطانُ عِدىً","يبْغي بسَمائِكَ مُسْتَرَقا",6,"ق",2,0],["إِنْ طَافَ شَيْطَانُ الْعِدَى بِسَمَائِهَا","رَجَمَتْهُ شُهْبُ صَلاَتِهَا وَزَكَاتِهَا",7,"ت",3,0],["إِنَّ طيبَ المُناخِ جَرَّ عَلَينا","في سَبيلِ الحَياةِ ذاكَ الزِحاما",8,"م",2,0],["إِن طالَ في السِجنِ إيداعي فَلا عَجَبٌ","قَد يودَعُ الجَفنَ حَدُّ الصارِمِ الذَكَرِ",9,"ر",1,0],["إن طرسا تزينه بسطور","لهو التحفة التي تختار",10,"ر",1,0],["إِنْ طَاشَ رَأْيٌ كُنْتَ خَيْرَ مُسَدِّدٍ","أَوْ زَاغَ حُكْمٌ كُنْتَ خَيْرَ كُقَوِّمِ",11,"م",1,0],["إنّ طرفي ممازح ولساني","وضميري عن الفسوق عفيفُ",12,"ف",1,0],["إن طريق النجاة وعرٌ","يكبو به الطرف ذو النجاء",13,"ا",2,0],["إِن طارَدوا الخَيلَ لَم يُشوُوا فَوارِسَها","أَو واقَفوا عانَقوا الأَبطالَ فَاِهتُصِروا",14,"ر",3,0],["إِنَّ طِلابَكَ شَيئاً لَستَ نائِلَهُ","جَهلٌ وَطولُ لُباناتِ الهَوى سَقَمُ",15,"م",1,0],["انطفت ربُدها الأسرة منها","واستلجت دماؤها تقطيرا",16,"ر",2,1],["إِن طالَ لَيلي في ذُرا","كَ فَقَد نَعِمتُ بِهِ قَصيرا",17,"ر",2,0],["إن طيفاً عن حال شجوايَ أملى","لستُ أدري أدَّى الأمانة أم لا",18,"ل",2,1],["إن طول العتاب يَزْدرِعُ البغ","ضاءَ في قلب كَاره البَغْضاءِ",19,"ا",2,0],["إن طابَ أو طِبْتُمْ فما أبعدتْ","فروعُ مجدٍ أَشبهتْ منصبا",20,"ب",2,0],["أنطَقْتَ مُفْحَمَنَا فأصبح شاعراً","وأَعَرْتَ أَعْجَمَنَا لسانَ فصيحِ",21,"ح",1,0],["إن طول المِطال يُؤْذن بالخُل","ف ولستَ الظَّنينَ بالخلف عندِي",22,"د",2,0],["إنْ طال لم يُملَل وإن هي أوجزت","ودَّ المحدَّثُ أنها لم توجز",23,"ز",1,0],["أنطق مُدَّاحاً وكمَّتْ به","أفواهُ حسّادٍ فلم تَنْبِس",24,"س",1,0],["أنطقه فضلك المبرز بال","حق فأداه غير مُعتَنف",25,"ف",1,0],["إن طُلب الخير فمفتاحه","أو طُلب الشر فمغلاقه",26,"ق",2,0],["إنَّ طولَ المِطالِ يُغري بإرها","قِكَ من لا يَسُرُّه إرهاقُك",27,"ك",1,0],["إِنَّ طَيرَ الأَراكِ لَيسَ يُبالي","أَنتَ أَصغَيتَ أَم أَنا إِن غَرَّد",28,"د",1,0],["إن طلت كانت رحمة","حلَّت على من كان حاضر",29,"ر",1,0],["إِن طِرتَ عَن كَنَفي وَقَع","تَ عَلى النُسورِ الجُهَّلِ",30,"ل",1,0],["إِن طُلِبَ القِسطُ فَما مِنهُمُ","إِلّا جَوادٌ عَن أَبيهِ الجَواد",31,"د",1,0],["إِن طالَ ما غَيَّرَ النائي المُحِبّينا","إِنّا وَإِن زادَنا تَفريقُنا غُلَلاً",32,"ل",2,0],["إِن طالَ فَضلُ لِسانِها","فَجَزاؤُها قَطعُ الرُؤوسِ",33,"س",1,0],["انطوى ذلكَ البساطُ الذي","مُدَّ وفُضَّت مجالسُ الندماءِ",34,"ا",2,0],["إِن طالَ يَومُكَ في الوَغى فَلَقَد تُرى","فيهِ وَيَومُ الهامِ مِنكَ طَويلُ",35,"ل",1,0],["إنْ طلبناها طلبْنا خيالاً","أو تركناها اضْطررْنا إليها",36,"ه",2,0],["إِنَّ طَيفَ الخَيالِ حينَ أَلَمّا","هاجَ لي ذِكرَةً وَأَحدَثَ هَمّا",37,"م",2,1],["إِنَّ طَرفي دَلَّ الفُؤادَ عَلَيها","فَفُؤادي كَالهائِمِ المَقتولِ",38,"ل",1,0],["أَنْطَقُوهُ فترامَى ومضَى","يَقذفُ الأسماعَ بالصّوتِ اللّعينْ",39,"ن",1,0],["أَنَطلُبُهُ فَوضى وَنَسعى جَميعُنا","إِلى عَرَصاتِ المَوتِ سَعياً مُنَظَّما",40,"م",2,0],["أَنُطريهِ قَهّاراً وَنُؤذيهِ مُرهَقاً","كَفى اللَيثَ شَرّاً أَن تُفَلَّ مَخالِبُه",41,"ب",2,0],["أَنطمعُ كَالأَحياءِ في نَيلِ بُغيةٍ","وَأَعداؤُنا تَقضِي عَلينا وَتحكمُ",42,"م",1,0],["إن طافَ شَيطانُ السَلوِّ بِخاطِري","فَشِهابُ شَوقي في المَكانِ يُصيبُهُ",43,"ب",2,0],["أنْطَوي دائماً على كَبِدٍ حَر","رى على حبّكُمْ وقَلْبٍ رَجُوف",44,"ف",1,0],["إِنَّ طولَ السُهادِ وَالدَمعَ كادا","يَترُكانِ الجَليدَ غَيرَ جَليدِ",45,"د",1,0],["إِن طابَ خَيمُكَ في الدُنيا فَلا تَخِمِ","وَلا تَضَنَّ بِمَقتولٍ عَلى الرَخَمِ",46,"م",1,1],["إن طبتَ طبتُ وإن هن","تَ يا عراق أهون",47,"ن",1,0],["إن طريق العقل لا يسدَّ","ومذهب الأفكار لا يحدّ",48,"د",1,0],["إِنَّ طَرْفِي غَرَّ قَلْبِي فَمَضَى","فِي سَبِيلِ الشَّوْقِ حَتَّى هَلَكَا",49,"ك",2,0],["أَنْطُونُ عُوجِلَ فِي شَرْخِ الشَّبَابِ فَهَلْ","فِي الرُّبْعِ أُنْسٌ وَأُنْسُ الرَّبْعِ قَدْ ذَهَبَا",50,"ب",2,0],["إِنَّ طَيفاً يَزورُني في المَنامِ","لَخَلِيٌّ مِن لَوعَتي وَغَرامي",51,"م",2,1],["انطلقتم، وسار يحبو فيكبو","من حدا الفلك والمهار العرابا",52,"ب",2,0],["إن طوقوك، فطالما","طوقت أعناق العتاة",53,"ا",2,0],["إن طافَ شيطانُ العِدا بِسمائِها","رجَمَتْهُ شُهْبٌ صَلاتِها وزكاتِها",54,"ت",3,0],["إنَّ طَرْفي دَلَّ الفُؤادَ عَلَيْهَا، سرْ قَليلاً، وَلاَ تَلُمْني خَليلي","لوداعِ الربابِ قبلَ الرحيلِ",55,"ل",1,1]]}