{"poems":[[47,"مني وصل ومنك هجر","https://www.aldiwan.net/poem63631.html","مجزوء البسيط"],[63,"أمقدم يا أبا المقدام أنت على","https://www.aldiwan.net/poem51756.html","البسيط"],[52,"صحا تربي وما قلبي بصاح","https://www.aldiwan.net/poem63977.html","الوافر"],[47,"مِنّيَ وَصْلٌ، وَمنكَ هَجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31193",""],[343,"شكر الإله نعمة","https://www.aldiwan.net/poem68656.html","مجزوء الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77525","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138144",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138166",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204755","البسيط"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216349","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112616","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97987","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101380","الطويل"],[5616,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=203325",""]],"verses":[["وَكَيفَ شُكرِكَ عَن سَواءٍ","وَما يُداني نَداكَ شُكرُ",0,"ر",1,0],["وكيف شنَّ أبو الغاراتِ غارتَه","عليَّ مُقتحماً بالخيل ساحاتي",1,"ت",2,0],["وَكَيفَ شِفاءُ مُختَبِلٍ حَزينٍ","بِشَبعى الحَجلِ جائِعَةِ الوِشاحِ",2,"ح",1,0],["وَكَيفَ شُكرِيكَ عَنْ سَوَاءٍ،","وَمَا يُداني نَداكَ شُكْرُ",3,"ر",1,0],["وَكَيفَ شُكري بِرَّهُ","وَشُكرُهُ مِن بِرِّهِ",4,"ه",1,0],["وَكَيفَ شَنَّ لِلوَغى إِغاره","وَصَدَّ مِن جَفوَتِهِ عِماره",5,"ه",1,0],["وكيف شياطين الهموم تعودني","وأنجم ذكراه لهن رجوم",6,"م",1,0],["وكيف شدت أطياره وتفجرت","ينابيعه واختال في دوحه الرند",7,"د",1,0],["وكيف شعري يأتي سائغاً عبقاً","ومعظم العمر بالآلام مستعر",8,"ر",1,0],["وكيف شكا قلبي تداويت باسمكم","ونعم الدوا أنتم على قلبي المضنى",9,"ن",2,0],["وكيف شئت أقرأ لإدراكِ المنى","إن لم يصل ذاك إلى حَد الغِنا",10,"ن",2,0],["وكيف شعوري بالحياة مشككا","وليس لمقطوع الرجاء شعور",11,"ر",1,0],["وكيف شفاها والمجرب خائف","يلجلج وصفا والطبيب مسقم",12,"م",1,0],["وكيف شالوا على الأعناق صيدهم","وكلهم تحت هذا الصيد قد شهقا!",13,"ق",2,0]]}