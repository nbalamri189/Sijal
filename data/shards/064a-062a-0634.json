{"poems":[[55,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[73,"ومدل على الأخلاء مغتر","https://www.aldiwan.net/poem3750.html","الخفيف"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[74,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[48,"ابن خمسين ضمه عقد تسعين","https://www.aldiwan.net/poem22926.html","الخفيف"],[48,"العالم العالي برأي معاشر","https://www.aldiwan.net/poem23316.html","الكامل"],[102,"حَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=199745",""],[47,"ما تُقَضّى لُبَانَةٌ عِنْدَ لُبْنَى","https://www.poetsgate.com/ViewPoem.aspx?id=31873",""],[113,"وفد الصباح وزالت الأحلاك","https://www.aldiwan.net/poem16210.html","الكامل"],[119,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[124,"كل يوم لي شكاة","https://www.aldiwan.net/poem49324.html","مجزوء الرمل"],[173,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[190,"الأحنف بن محمد يشكو الضوى","https://www.aldiwan.net/poem43248.html","الكامل"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[353,"ما حل عزمي مثل عقد قبائه","https://www.aldiwan.net/poem19820.html","الكامل"],[408,"أتعزي في المصاب","https://www.aldiwan.net/poem46436.html","مجزوء الرمل"],[422,"علموا يا سعد جيران الغضا","https://www.aldiwan.net/poem53837.html","الرمل"],[422,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[463,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104107","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120124","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56601","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95501","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79850","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48959","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113975","الرمل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105877","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93691","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100239","الكامل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105353","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123944","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32904","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136638",""],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5101,"للعرب","https://www.poetsgate.com/ViewPoem.aspx?id=196660",""],[5431,"محض لوطي...","https://www.poetsgate.com/ViewPoem.aspx?id=213340",""],[5458,"جولة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=113370",""],[5956,"نعم لقول رب العالمين \"وخلقنا الإنسان في كبَد.\"","https://www.poetsgate.com/ViewPoem.aspx?id=183506",""],[6093,"نسخة معدلة","https://www.poetsgate.com/ViewPoem.aspx?id=193066",""],[5309,"قل يا اخي للشاعر الغريد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573904",""]],"verses":[["يَتَشَقَّقُ البَرقُ اللَموعُ بِها","وَتَروعُهُ بِتَهَزُّمِ الرَعدِ",0,"د",1,0],["يَتَشَكّى إِلَيَّ رِقَّةَ حالٍ","أَسقَمَتهُ وَغَيَّضَت مِن عُرامِه",1,"م",2,0],["يَتَشَاطَرَانِ العَيْشَ إِنْ يَحْسُنْ وَإِنْ","يَخْشُنْ كَمَا تَتَشَاطَرُ العَيْنَانِ",2,"ن",1,0],["يتشكَّى الصَّدى لنغبة جاهٍ","أصبح الناس فيه كالسُّبَّاح",3,"ح",1,0],["يتشاكى وشاحها وأخوه","ضدَّ شكوى السّوار والخلخالِ",4,"ل",1,0],["يَتَشافَعنَ بِالغَريرِ المُسَمّى","مِن فَتاءٍ دونَ الجَليلِ المُكَنّى",5,"ن",2,0],["يتشكَّى العُنَّابُ نَورَ الأَقاحي","واشتكى الوردُ ناضرَ العنَّابِ",6,"ب",1,0],["يَتَشَكّى فَظاظَةً مِن حَياةٍ","وَأَظُنُّ الحِمامَ مِنها أَفَظّا",7,"ظ",2,0],["يَتَشَبَّهُ الطاغي بِطاغٍ مِثلِهِ","وَأَخو السَعادَةِ بَينَهُم مَن يَسلَمُ",8,"م",1,0],["يَتَشَظَّى عَلى اللَّيالِي ويُعْطِي","كُلَّ أمْسِيَّةٍ نُعَاسًا ودِفْئَا",9,"ا",2,0],["يَتَشَاعَفْنَ بالغَرِيرِ المُسَمّى","من فَتَاءٍ، دونَ الجَليلِ، المكنّى",10,"ن",2,0],["يَتَشهد الكُفار مِن أَفعالِهم","مُتَهولين وَتَفسق النساكُ",11,"ك",1,0],["يتشدقون كانهم بفعالهم","احيوا الانام وبئست الافعال",12,"ل",1,0],["يتشاكون غراماً","غير كأبي الجمرات",13,"ت",1,0],["يَتشابَهُ الطّرفُ المُجَلّلُ إِن بَدا","في عَينِ سالِكِ جَوِّها وَالثَعلَبُ",14,"ب",1,0],["يتشّرفون به ويدركه القلى","لمكان دوم بقائه رعيانه",15,"ن",2,0],["يَتَشَكّى الوَجا وِمِنهُ إِذا جَدَّ","عَلى طَلعِهِ لَهُنَّ غَناءُ",16,"ا",2,0],["يَتشبّهُ الغُصْنُ الرَّطِيبُ بقدّهِ","يَا غُصْنُ فاتَكَ لَسْتَ من نُظَرائهِ",17,"ا",3,0],["يتشكّى الضيقَ من بعدِ","المقاصير الرّحابِ",18,"ب",1,0],["يتشافى بعدكم في زعمِهِ","بالصَّبا النجديّ والبرق اللموع",19,"ع",1,0],["يتشافى من عهدها بالأَحادي","ث ويرعى لها على النأي عهدا",20,"د",2,0],["يَتَشرَّفون بحمل ثَوبِ نبيِّهم","فوق الرؤوس هو الطراز الأخضر",21,"ر",1,0],["يتشاهدون له بأنْ ما فيه لي","يومَ المقالِ مُناسبٌ ومُساجلُ",22,"ل",1,0],["يتشكى من ردفه دقة الخص","ر تشتكي الضعيف جور القوي",23,"ي",1,0],["يتشكى الفتور من كسلِ المش","ي ولا يشتكيهِ من أجفانِه",24,"ن",2,0],["يتشاجى بدلال","وهو مكحول مرعَّث",25,"ث",1,0],["يتشافى به الرواة ومنه","في قلوب الأعداء وخز الأشافي",26,"ف",2,0],["يتشاورون بأمرهم","والله في عون المشاور",27,"ر",1,0],["يتشوقون إِلى الرغيف وما لهم","ما يشترونَ بهِ فوا اسفاه",28,"ا",2,0],["يتشذَى على هواه المعانى","كزهور الرُّبى سَرَت بالنّسيمِ",29,"م",1,0],["يتشطَّرون ضروعَها","لا بالتلوّث ولا الشطورِ",30,"ر",1,0],["يتشوّفون إلى الثغور وفيهمِ","حَسَرٌ بنى دون الثغور جدارا",31,"ر",2,0],["يَتشَمَّمنَ مجَرَّ البوِّ لا","هُنَّ يغفُلنَ إذا شَولٌ ذهَل",32,"ل",1,0],["يَتَشَكّى الظما وفي يَدك الرِ","يُّ فإِن لم تُروِّه كُنتَ ظالم",33,"م",1,0],["يَتشاجرون بِكُل مُشكلة فان","أَعيَت يَرد لرأيهِ أشكالها",34,"ل",3,0],["يتشيعون وذي صفاتهم","لا بوركت من شيعة صفة",35,"ه",1,0],["يتشكى ما لا تنوء به الشم","الرواسي من غاشيات الهموم",36,"م",1,0],["يَتشَهذاها المُنيلُ وَقَد","كادَ مَن تُعطاهُ يَسأمُها",37,"م",3,0],["يتشبّهون بكلِّ أغلفَ كامن","في زيِّهم وكلامهم في المشهدِ",38,"د",1,0],["يتشكى المراكشي اعتصاب","وكشكواه يشتكي العثماني",39,"ن",2,0],["يَتَشكّونَ شِدَّةَ الجوعِ وَالدا","عي لَهُم عَن مَقالَهم مَشغولُ",40,"ل",1,0],["يتشايحون إلى الفرار كأنهم","كدر القطا صدت عن البيزان",41,"ن",1,0],["يَتشاكونَ وَطأةَ الخَطبِ فيهِم","وَيَصيحون حَيثُ لا ثَمَّ مُنجِدْ",42,"د",1,0],["يتشابهون صغيرهم ككبيرهم","مثل النجوم الزهر حين تبين",43,"ن",1,0],["يتشكى الهوى إلي ويُبدي","إنَّ داء الغَرام فيه قَديم",44,"م",1,0],["يتشدقون وإن كل دفاعهم","قولٌ يغص تهيباً وبيان",45,"ن",1,0],["يتشاجرون مع العدوّ بِرِقّةٍ","ويوجّهون له صُراخاً ابكما",46,"م",2,1],["يتشهى حدائقا فاح منها","ريح طير كنايةً عن هبوط",47,"ط",1,0],["يتشددون خباثة بعدالة","وحقوق إنسان وعيش أرغدا",48,"د",2,0],["يتشكّل المخلوق كي يتعذبا","أضعاف مايَهْنا، أؤكِّد ذا النبا",49,"ب",2,1],["يَتَشَابَهُ العُشَّاقُ في أَقْدَارِهِمْ","فَكَأَنَّهُمْ نُسَخٌ تَجِيءُ مُعَدَّلَةْ",50,"ل",2,0],["يَتَشَدَّقونَ بِحُبِّهِم حُرِّيَّةً","نَصَبوا لَها سِرًا سِتارَ حَديدِ",51,"د",1,0]]}