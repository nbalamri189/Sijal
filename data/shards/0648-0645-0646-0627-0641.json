{"poems":[[79,"رحلت فكنت في التحقيق بدرا","https://www.aldiwan.net/poem36576.html","الوافر"],[90,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[50,"أيا من أخلف الوعد","https://www.aldiwan.net/poem62592.html","الهزج"],[46,"أحسِنْ بأيَّامِ العقيقِ وأطيبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15651&r=&rc=11",""],[284,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[343,"كذبت ومن يكذب فإن جزاءه","https://www.aldiwan.net/poem68728.html","الطويل"],[438,"أنا من جوارك في أعز مكان","https://www.aldiwan.net/poem12752.html","الكامل"],[484,"إليك خليفة الإسلام ترنو","https://www.aldiwan.net/poem37200.html","الوافر"],[520,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122702","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122666","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122606","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86867","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49941","الكامل"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72990","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114799","الكامل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131724",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122501","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74190","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68049","الطويل"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144946","الطويل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66912","الكامل"],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[5436,"حديثُ الموت والنصر (تركي عبد الغني )","https://www.poetsgate.com/ViewPoem.aspx?id=33447",""],[402,"هل في علاقة مصر بالسودان","https://www.poetsgate.com/ViewPoem.aspx?id=36530",""]],"verses":[["ومنْ أفْلاكِ رِحْلَتِكَ المَعالي","ومنْ آثارِ نيّرِكَ الجِهادُ",0,"د",1,0],["ومَن افتدت أوطانها بدمائها","وبآخر الرَبَوات من أموالها",1,"ل",3,0],["وَمُنافِسٍ عُمَرَ بنَ طَوقٍ ما لَهُ","مِن ضِغنِهِ غَبرُ الحَصى وَالأَثلَبِ",2,"ب",1,0],["وَمَن أَفرَطَ في الهِجرا","نِ وَالإِعراضِ وَالصَدِّ",3,"د",1,0],["ومُنافِسٍ عُمَرَ بنَ طوقٍ ما لهُ","مِن ضِغْنِهِ غَيْرُ الحَصَى والأَثْلَبِ",4,"ب",1,0],["ومن أَفناهم عدماً حقيقٌ","بِحَمْدٍ مثلما وجدوا ويغني",5,"ن",2,0],["وَمِن آفَةِ الكَذّابِ نِسيانُ كِذبِه","وَتَلقاهُ ذا حِفظٍ إِذا كانَ حاذِقا",6,"ق",2,0],["ومن افتقادِكَ في رياضِ مكارمِ","حيّيْنَني بغرائبِ الإحسانِ",7,"ن",1,0],["ومن افريقيا بقيت بلاد","بمفردها إليكم فانقذوها",8,"و",3,0],["ومنافق شمخ النفاق بأنفه","وسرت رقى الشيطان في أوهامه",9,"م",2,0],["ومُنافِقٍ في الحُبِّ يَع","دِلُ دينُهُ دينَ المُنافِق",10,"ق",1,0],["ومُنافِقينَ تَربَّصُوا بِكَ أخفَقُوا","في الخافِقَينِ وسائِلاً وذرائعا",11,"ع",2,0],["ومُنافِسٍ لي في مَديحِ","كَ قد تَوعَّدَني وهَدَّد",12,"د",1,0],["وَمَنافعٍ للعالمين كَثيرة","ما جادَ مِنها غَيره بِيَسير",13,"ر",1,0],["ومنْ أفنانِ رمّانٍ","على الحيطانِ مَحْطُوطَه",14,"ط",2,0],["ومُنافسٍ لكَ في المكارِم والعُلى","لما رآكَ على السّماكِ تَزَحْزَحَا",15,"ح",2,0],["ومن أفناءِ ثعلبةَ بن سعدٍ","قتلتُ وما أُبِيئهُمُ بوترِ",16,"ر",1,0],["ومُنافق يُبدي انفِعالَ مُنافقٍ","مُتَبسّماً وضَمِيرُهُ مُتَجَهِّمُ",17,"م",1,1],["ومنافع للناس يم","سكها الأفاضل والعبيد",18,"د",1,0],["وَمِن أفانِينِ أسرار اللُّغَى عَجَبٌ","والفَرعُ مِن أصلِهِ الأَقوَى تفَرُّعُهُ",19,"ع",2,0],["وَمن أَفضاله للبر جاب","وَغَيث نَواله للكسر جابر",20,"ر",1,0],["ومن أفضلِ الأقوامِ عَزَّ وَلاؤُهُ","طفقتُ أُعانيه فطال عَنَاؤُهُ",21,"ه",1,0],["ومن آفة الكذاب نسيان كذبه","وتَلقاهُ إذا فَقْهٍ إذا كان حاذقا",22,"ق",2,0],["ومن أَفذاذها المنجاد","منصور بن قدارة",23,"ر",2,0],["ومنافق كالقار عز صلاحه","ما لم يدسه القوم بالأقدام",24,"م",1,0],["وَمِنّا فَوْقَ هذا التُّرْبِ يَقْضي","وَمِنّا مَنْ يَموتُ على المَشانِقْ",25,"ق",1,0],["ومن افتاحات الجميلة عندها","عودا لرئيس وعودكم في آن",26,"ن",1,0]]}