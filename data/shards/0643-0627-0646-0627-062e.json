{"poems":[[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[65,"ألا ليت شعري هل أرى أم سالم","https://www.aldiwan.net/poem45785.html","الطويل"],[37,"أصادرة حجاج كعب ومالك","https://www.aldiwan.net/poem39124.html","الطويل"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[53,"سألتك حاجة فسعيت فيها","https://www.aldiwan.net/poem64046.html","الوافر"],[30,"وبالمسجد الأقصى الإمام الذي اهتدى","https://www.aldiwan.net/poem5384.html","الطويل"],[51,"ليبك رسول الله من كان باكيا","https://www.aldiwan.net/poem63203.html","الطويل"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30483","البسيط"],[146,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[159,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[170,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[353,"مساع غدت في الله تنضى ركابها","https://www.aldiwan.net/poem19844.html","الطويل"],[447,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[520,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19951","الطويل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75749","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119926","السريع"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82631","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104164","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125404","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45617","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45726","الطويل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31511","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93851","البسيط"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9610","الطويل"],[3220,"","https://poetry.dctabudhabi.ae/diwan/poem/203415","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48314","المتقارب"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99258","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86536","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75690","البسيط"],[4108,"","https://poetry.dctabudhabi.ae/diwan/poem/206280","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130285","الطويل"],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""]],"verses":[["كَأَنّا خُلِقنا عُرضَةً لِمَنيَّةٍ","فَنَحنُ إِلى داعي المَنونِ عِجالُ",0,"ل",1,0],["كَأَنَّ أَخا عَبْسٍ عَلى الكُورِ أَجدَلٌ","بِمُرتَبأٍ مِن ذي الأَراكَةِ شاهِقِ",1,"ق",1,0],["كَأَنَّ أَخاهُ في النَوائِبِ مُلجَأَ","إِلى عَلَمٍ مِن رُكنِ قُدسِ المُنَطَّقِ",2,"ق",1,0],["كَأَنَّ أَخا اليَهودِ يَخُطُّ وَحياً","بِكافٍ في مَنازِلِها وَلامِ",3,"م",1,0],["كأن أخاه عُضْوٌ منه فيها","ففيه تحُزُّ بالفَوْت الشفار",4,"ر",1,0],["كَأَنَّ أَخا الهَمِّ الَّذي قَد أَصابَهُ","بِهِ مِن عَقابيلِ القَطيفِ مُلالُها",5,"ل",3,0],["كَأَنّا خُلِقنا لِلبَقاءِ وَأَيُّنا","وَإِن مُدَّتِ الدُنيا لَهُ لَيسَ فانِيا",6,"ي",2,0],["كَأَنَّ أَخفافَها وَالسَيرُ يَنقُلُها","دَلاءُ بِئرٍ تَدَلَّت بَينَ أَشطانِ",7,"ن",1,0],["كأنّ أخاه حينَ دَوّمَ طائِراً","أتى دون نصفِ البدر فاختطفَ النصفا",8,"ف",2,0],["كأَنَّ أَخفافَنا علَيْه","مَراكِبٌ ما لها دَلِيلُ",9,"ل",1,0],["كأنّا خُلقنا لرَيبِ المنونِ","شرابٌ يَلذُّ به أو طَعامُ",10,"م",1,0],["كَأَنَّ اخضِرارَ الجَوِّ صَرْحُ زَبَرْجَدٍ","تَناثَر فيهِ الدُّرُّ مِن جيدِ كاعبِ",11,"ب",1,0],["كأن أخلاقَه من طيبِ نَفحتِها","نشرٌ يجودُ بهِ الروضُ المجُودُ ذكي",12,"ك",2,0],["كَأَنَّ اخضْرارَ اللُّجّ ضَاهَى سَماءَهُ","وَجَارَى عَلَيْها الجَارِياتِ شِهابُها",13,"ب",3,0],["كأن أخلاق عيسى فيه قد طبعت","لو هز جذعا جنى منه بحيث جنى",14,"ن",2,0],["كأن أخاك الغيثَ وُلِّيَ نسجَها","فزهرته وسمٌ لها ورُقومُ",15,"م",1,0],["كأن أخلاقه من حسن خلقته","صيغت فقد راقت الأفعال والصور",16,"ر",1,0],["كَأَنّا خُلِقنا لِلنَوى وَكَأَنَّما","حَرامٌ عَلى الأَيامِ أَن نَتَجَمَّعا",17,"ع",2,0],["كأن أَخاه الواقِع اِنضم نازِلا","حذارَ الرَدى فاِختار من رايه الوقعا",18,"ع",2,0],["كأن أخلاقك مخلوقه","من خمرة شيبت بماء قرَاح",19,"ح",1,0],["كانَ أَخا ثُمَّ عادَ لي أَمَلا","فَبِتُّ بَينَ الإِخاء وَالأَمل",20,"ل",1,1],["كأَنَّ أَخاه السيف أُعطي صبرَهُ","فلم يبرح الهيجاءَ حتَّى تكسَّرا",21,"ر",2,0],["كانا خليلين لم تفرع صفافتهما","دخان دهرهما من بعد ما أمنا",22,"ن",2,0],["كان اختيارك للفنِّ الجميل هُدى","لكشف سرِّ كنوزِ الفُرسِ والعَرَبِ",23,"ب",1,0],["كَأَنَّ اِخضِرار الجَو تَحتَ نُجومَها","اِخضِرار رياض نشرت بَينَ أَنوار",24,"ر",1,0],["كانَ اِخضِرار البَحر صرح مَمرد","وَفيهِ لآلٍ لَم تَشن بِثُقوب",25,"ب",1,1],["كَأَنَّ أَخاهُ حينَ يُظلَمُ عِندَهُ","مِنَ العِزِّ في مَسرودَةِ السَكِّ دارِعُ",26,"ع",1,0],["كأن أخلاقه لطفاً نسيم صبا","من أم ساحته في خيفة أمنا",27,"ن",2,0],["كَأَنَّ اِختِلاءَ المَشرَفيِّ رُؤوسَهُم","هَويُّ جَنوبٍ في يَبيسٍ مُحَرَّقِ",28,"ق",1,0],["كاَنَّ أخى وَرْقَاء إذْ يَطردُونَه","قَعُودٌ بِرجليْهٍ الحدَاجَة نافرُ",29,"ر",1,0],["كأَن أَخاها من مجاوبةِ الصدى","اذا زجر الوجناءَ يزجر بالزجرِ",30,"ر",1,0],["كأنّ أخاهُ أخو لوعَةٍ","فلا هُوَ أغفى ولا غمّضا",31,"ض",2,0],["كأن اخضرارَ الدوح والنهرُ ضاحكٌ","غياهبُ شقَّ الفجرُ من جُنْحها سَجْفا",32,"ف",2,0],["كأن أخاه الأعزل ارتد هارباً","فقيل لفرط الخوف قد كاد يهلك",33,"ك",1,0],["كأن أَخلاق مَولانا محمد الشحم","ي قَد أَودعت في نشرها العطر",34,"ر",1,0],["كأنَّ اختطافَ الهامِ عندكَ بِالظبا","ابتهاجاً به يومَ الوغى ثَمَرٌ يُجْنَى",35,"ن",2,1],["كأَنَّ أخاه رام فَوْتاً أمامه","فلم يَعدُ أنْ مدَّ الجناح وأنْ مطا",36,"ط",2,0],["كأنا خلقنا للنوى وكأنما","حرام على الأيام أن تتجمعا",37,"ع",2,0],["كأن اخضرار الوصل في أبيض اللق","ا هداهد خضر والجليد وكور",38,"ر",1,0],["كأنا خلقنا للغرام وللنوى","فما سكنت من بعد ليلى المرابع",39,"ع",1,0],["كانَّ أخلاقهُ للحكم قد خلقت","فقلت اللّه أعطي القوس باريها",40,"ي",3,0],["كان اْختياري ليس ذوقاً صالحاً","واليومَ هذا بتُّ عنكَ أحيدُ",41,"د",1,0],["كان اختياري ، فاْبتَدَرْتُ مِنَ اْلأَسَىَ","ما قَدْ تَغَلْغَلَ فِيْ اْلحَشَا وَ تَعَمَّقا",42,"ق",2,0]]}