{"poems":[[55,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[87,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[240,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[264,"من مجيري من فاتن الطرف فاتك","https://www.aldiwan.net/poem35948.html","الخفيف"],[287,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[409,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[443,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[563,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70955","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79909","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137080",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137121",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132523","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112288","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131289",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114174","الخفيف"],[4791,"عظيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=28424",""],[4935,"مالك الملك بجودٍ كملك","https://www.poetsgate.com/ViewPoem.aspx?id=129536",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""]],"verses":[["لَكَ ذُروَةُ البَيتِ المُعَ","ظَّمِ وَالأَباطِحُ وَالحَجونُ",0,"ن",1,0],["لك ذمة لم ينصر الحق آمرؤ","ألا تمنى برها ووفاءها",1,"ا",3,0],["لكَ ذاتُ العلومِ من عالِمِ الغَي","بِ ومنها لآدمَ الأَسماءُ",2,"ا",2,0],["لك ذكراكِ ولي عهدٌ بها","كيف أنسى ذكرياتي وعهودي",3,"د",2,0],["لكذبتها تُستحبُّ الحياةُ","ويَصْفو الزمانُ بتغريرها",4,"ه",2,0],["لَكَ ذمةٌ عِندي وَإِن عَزَّ اللُّقا","تَبقى عَلى مَرِّ الزَّمانِ الغابِرِ",5,"ر",1,0],["لَكَ ذُروَةُ البَيتِ الَّذي لا يُرتَقى","هَضَباتُهُ وَلَكَ المَحَلُّ الأَرفَعُ",6,"ع",1,0],["لَكَ ذُروَةُ البَيتِ العَتيقِ عِمادُهُ","وَمُقَلَّدُ السَيفِ الطَويلِ نِجادُهُ",7,"د",2,1],["لك ذاتٌ بها سلبت البرايا","بتناويع حسنها من صفاتك",8,"ك",1,0],["لَكَ ذِكرٌ طابَ في العالَمِ نَشراً","فَهوَ في النادي كَعَرفِ المَندَلِيِّ",9,"ي",1,0],["لك ذِكْرٌ بكُلِّ أَرْضٍ مُقيمٌ","وندىً يَذْرَعُ العُلا أَيَّ ذِرْعه",10,"ع",2,0],["لك ذهن به تفض المعاني","وغرام بالعلم لا بالجوار",11,"ر",1,0],["لك ذروةُ المجد الذي لا يرتقى","ومكارم جازت مدى أن تلحقا",12,"ق",2,1],["لك ذرية بسرك قامت","تقتفي منك مشرق الإيقان",13,"ن",1,0],["لكِ ذو الزيغ لم يؤدْبه وعظ","لو تصدى له خطيبُ عُكاظ",14,"ظ",1,0],["لك ذلّت عرامة الدهر حتَّى","لك أمسى يُعدُّ في الوصفاء",15,"ا",2,0],["لك ذكرٌ نشرُه يهدي شذاً","فيه أنفاسُ النسيمِ الغضِّ تشهد",16,"د",1,0],["لك ذروة البيت الذي فيه غدا","ابداً جميلك بالثنا مذكورا",17,"ر",2,0],["لك ذكر يلذ منه حديث","هو زاد السارين في البيداء",18,"ا",2,0],["لك ذات قد أبدع الله فيها","صنعه وهو صانع ما يشاء",19,"ا",2,0],["لكِ ذكرٌ في فُؤادي أستعِير","منه عَزماً قَصرَت عنهُ الشّفار",20,"ر",1,0],["لك ذكر زان الوجود ووجه","كلّما أَظلَم الوجود أَضاءَ",21,"ا",2,0],["لَكَ ذلت جَبابرٌ وَطغاة","بِكَ عَزت أَجلَّةٌ حُنفاء",22,"ا",2,0],["لك ذروة يا دار أعلاها الندى","إذ جاء يرفع غيرها البناء",23,"ا",2,0],["لَكَ ذِكرٌ يَفُوحُ فِي الأمجَادِ","طَائِرٌ فِي الأغوَارِ وَالأنجَادِ",24,"د",1,1],["لك ذكرياتٍ جميلة يوم مرني","ما وسعت خاطرٍ تسعى لمرضاته",25,"ت",2,0],["لك ذات عزها الرحمن إذا","أنت لم تصغ إليّ من نم لك",26,"ك",1,0],["لك ذاك الذي أردت ببعد","واصرمي ما شئت الهوى من فقيدِ",27,"د",1,0]]}