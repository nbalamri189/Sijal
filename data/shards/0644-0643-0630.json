{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[183,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[236,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[236,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[260,"من مجيري من فاتن الطرف فاتك","https://www.aldiwan.net/poem35948.html","الخفيف"],[283,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[365,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[404,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[438,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[559,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"]],"verses":[["لَكَ ذُروَةُ البَيتِ المُعَ","ظَّمِ وَالأَباطِحُ وَالحَجونُ",0,"ن",1,0],["لك ذمة لم ينصر الحق آمرؤ","ألا تمنى برها ووفاءها",1,"ا",3,0],["لكَ ذاتُ العلومِ من عالِمِ الغَي","بِ ومنها لآدمَ الأَسماءُ",2,"ا",2,0],["لك ذكراكِ ولي عهدٌ بها","كيف أنسى ذكرياتي وعهودي",3,"د",2,0],["لكذبتها تُستحبُّ الحياةُ","ويَصْفو الزمانُ بتغريرها",4,"ه",2,0],["لَكَ ذمةٌ عِندي وَإِن عَزَّ اللُّقا","تَبقى عَلى مَرِّ الزَّمانِ الغابِرِ",5,"ر",1,0],["لَكَ ذُروَةُ البَيتِ الَّذي لا يُرتَقى","هَضَباتُهُ وَلَكَ المَحَلُّ الأَرفَعُ",6,"ع",1,0],["لَكَ ذُروَةُ البَيتِ العَتيقِ عِمادُهُ","وَمُقَلَّدُ السَيفِ الطَويلِ نِجادُهُ",7,"د",2,1],["لك ذاتٌ بها سلبت البرايا","بتناويع حسنها من صفاتك",8,"ك",1,0],["لَكَ ذِكرٌ طابَ في العالَمِ نَشراً","فَهوَ في النادي كَعَرفِ المَندَلِيِّ",9,"ي",1,0],["لك ذِكْرٌ بكُلِّ أَرْضٍ مُقيمٌ","وندىً يَذْرَعُ العُلا أَيَّ ذِرْعه",10,"ع",2,0],["لك ذهن به تفض المعاني","وغرام بالعلم لا بالجوار",11,"ر",1,0],["لك ذروةُ المجد الذي لا يرتقى","ومكارم جازت مدى أن تلحقا",12,"ق",2,1],["لك ذرية بسرك قامت","تقتفي منك مشرق الإيقان",13,"ن",1,0]]}