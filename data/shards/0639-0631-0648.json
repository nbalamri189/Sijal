",""],[5376,"بلقيس ألقت جمالا من خمائلها","https://www.poetsgate.com/ViewPoem.aspx?id=189751",""],[5431,"مدينة الرقة تذبح بصمت","https://www.poetsgate.com/ViewPoem.aspx?id=185007",""],[5431,"إلى الجزائر الحبيبة ....","https://www.poetsgate.com/ViewPoem.aspx?id=190246",""],[5431,"قلب صقر...","https://www.poetsgate.com/ViewPoem.aspx?id=206335",""],[5431,"لأرض السودان الحبيبة....","https://www.poetsgate.com/ViewPoem.aspx?id=216015",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[5533,"عَروسُ المَدائِن","https://www.poetsgate.com/ViewPoem.aspx?id=177401",""],[5561,"عروبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=213353",""],[5563,"أبيات مجتزأة من سجال","https://www.poetsgate.com/ViewPoem.aspx?id=213545",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"أَمِنْ دِمَنٍ مَعالِمُها قِفارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63510",""],[5605,"بنا عجب","https://www.poetsgate.com/ViewPoem.aspx?id=159671",""],[1547,"إلامَ ألامُ فيك وكم أعادى","https://www.poetsgate.com/ViewPoem.aspx?id=16745",""],[5725,"الا ياسليمى","https://www.poetsgate.com/ViewPoem.aspx?id=178415",""],[5744,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=207274",""],[5829,"تطريز الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=210922",""],[5893,"جدة مآآآآسي غير","https://www.poetsgate.com/ViewPoem.aspx?id=141386",""],[6045,"عروبي ساخط !","https://www.poetsgate.com/ViewPoem.aspx?id=125347",""],[6070,"الشام ( عروسُ المدى )","https://www.poetsgate.com/ViewPoem.aspx?id=193903",""],[6131,"ما أنا إلَّا جرمٌ في القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=189524",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[6300,"عروس أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82838&r=&rc=9",""]],"verses":[["عروبة اليوم أخرى لا ينم على","وجودها اسم ولا لون.ولا لقب",0,"ب",1,0],["عَرُوسَ مُلْكٍ طَالَمَا أُعْمِلَتْ","فِي عَقْدِهِ أَرْجُلُ خُطَّابِهِ",1,"ب",2,0],["عَروبٌ أَلاحَت مِن أَعاريبِ حِلَّةٍ","تَجاوَبُ فيها بِالصَهيلِ عِرابُ",2,"ب",1,0],["عُرُوسٌ هِيَ البَدْرُ فِي تَمِّهِ","وَمَا التَّمُّ فِي البَدْرِ إِذْ تَبْسَمُ",3,"م",1,0],["عروس هو قصر الشريف","ما يجلها غير الخمر",4,"ر",1,0],["عروس مجليّا","مريه هو شنيل",5,"ل",1,0],["عروس بدتْ من دَنها وهي تنجلي","كما تنجلي بِكر الزفاف من الخدر",6,"ر",1,0],["عُروةٌ ما لقواها","آخرَ الدهر انفصامُ",7,"م",1,0],["عرُّوه من كنيةٍ ليست تليقُ به","يكنى أبا الصقرِ من كان ابنَ شاهينِ",8,"ن",1,0],["عَروفٌ لِحَقِّ السائِلينَ كَأَنَّهُ","بِعَقرِ المَتالي طالِبٌ بِذُنوبِ",9,"ب",1,0],["عَروفٌ لِإِضعافِ المَرازِئِ مالُهُ","إِذا عَجَّ مَنحوتُ الصَفاةِ بَخيلُها",10,"ل",3,0],["عروس سماء الشرق انت جمالها","إذا زُيّنت كنت الحلى والمجاليا",11,"ي",2,0],["عَروس تَبَدَّتْ في قَميصٍ مُعَصْفَرٍ","وفي كلّةٍ صَفْراءَ ذاتِ جَبائِرِ",12,"ر",1,0],["عَروفٌ بِأَحوالِ الضِرابِ تُؤَمُّهُ","عَزيمَةُ شَهمٍ مِنهُ بِالضَربِ أَعرَفُ",13,"ف",1,0],["عَرَوْنَا فَأَبْخَلْنَاهُ فَضْلَ حِبَائِهِ","وَمِنْ عَجَبٍ إِمْسَاكُهُ وَهُوَ نَوْفَلُ",14,"ل",1,0],["عُروشُ الأرضِ إرثٌ في يَدَيها","وتيجانُ الملوكِ الأقدمينا",15,"ن",2,0],["عَروسُ دَسكَرَةٍ تيجانُها دُرَرٌ","قَد رَضَّعَت نَفسَها في دَنِّها حَقِبا",16,"ب",2,0],["عَرَوضِيٌّ إِذا ما اِفتَر","رَ مُبتَسِماً بَدا بَرَدُ",17,"د",1,0],["عَروسُ خِدرٍ مِنَ الياقوتِ نَشرَبُها","تُكِنُّ تَحتَ سَماها بَدرَ أَقمارِ",18,"ر",1,0],["عَروسُكَ أَفعى فَهَب قُربَها","وَخَف مِن سَليلِكَ فَهُوَ الحَنَش",19,"ش",1,0],["عروبتُها على الأدهار أبقى","وأثبتُ من رواسخها دِعامهْ",20,"م",2,0],["عروبتي فوق فرق الشمس ساخرة","من لؤم ما زوّر الواشي وما سردا",21,"د",2,0],["عَرُوسُ شِعْرٍ بِهَا ضرُوبٌ","مُنُوَّعَاتٌ مِن الجَمالِ",22,"ل",1,0],["عَرُوسُ شِعْرٍ تَنْجَلِي","بَيْنَ الحِلَى وَالحُلَلِ",23,"ل",1,1],["عَرُوسٌ يُفَدِّيهَا بِمُهْجَتِهِ فَتى","لَهَا أَرْخَصَ الدُّرِّ الغَوَالِيَ فِي المَهْرِ",24,"ر",1,0],["عَرُوسٌ لِعَامٍ لمْ يَتِمَّ صَرَعْتَهَا","وَلوْ شِئْتَ لمْ تَضْرِبْ بِأَمْضى وَأَقْطعِ",25,"ع",1,0],["عَرُوسٌ بِهَا الْحُسْنَانِ خُلْقاً وَخِلْقَةً","يَقُولاَنِ سُبْحَانَ الْمَلِيكِ المُوَحَّدِ",26,"د",1,0],["عَرُوس يَرَاهَا المُعْجَبُونَ كَأُمِّهَا","مِثَالَ كَمَالٍ فَوْقَ طَائِلَةِ النَّقْدِ",27,"د",1,0],["عُروقُ الناسِ كُلِّهِمُ","إِلى عِرقِ الثَرى تَشجُ",28,"ج",1,0],["عروسَ الشرقِ دونكِ كُلُّ مَهْرٍ","وأين لمِثل مهرِك أنْ يُساما",29,"م",2,0],["عروبة للسماك طرت بها","جناح غيب شآي به قدره",30,"ر",2,0],["عروسُ المدائنِ ماذا دهاها","بليلٍ فمزَّق أوصالها؟",31,"ل",3,0],["عروشُهُم فوق ظهر الأرض راسخةٌ","كأنها فوق ظهر الأرضِ أوتاد",32,"د",1,0],["عروبتها على الأدهر أبقى","وأثبت من رواسخها دعامه",33,"م",2,0],["عروف بمقدار الكرام وغيرهم","ومن غيره في شأن تفريقهم أدرى",34,"ر",2,0],["عروف غروفٌ نابه متنبّهٌ","شمائله فيض البحور غطمطما",35,"م",2,0],["عروساً في بُرُودِ حليلةِ","مفوقةِ ما ضمَّ أمثالَها بُردُ",36,"د",1,0],["عَرُوبٌ تَستِيكَ بِذِى غَرُوبٍ","يَحَاكِى لَونُهُ شَوكَ السَّيَالِ",37,"ل",1,0],["عروسا من بنات الفكر زفت","إليك بملك عقد لا سفاح",38,"ح",1,0],["عَروسُ حسنٍ عَلى مَهد البِلَى جُلِيَت","فَنَقَّطَتها مِن الأَجفانِ أَدمُعُها",39,"ع",3,0],["عروب تدور وماء يمور","وكأس تدور وهمّ يطير",40,"ر",1,1],["عَروسُ المَعاني في بديعِ بيانها","تُزفُّ على أسماعِ أهلِ النُهى بِكرا",41,"ر",2,0],["عروسُ ملاحةٍ جُلِيت علينا","وقد نُفِل الجمالُ لها جهازا",42,"ز",2,0],["عروض هجرانه دائي وعارضه","عليّ في الحبّ قد دارت دوائره",43,"ر",2,0],["عروسها بحماة لست ابدلها","ولو ليّ مطيعا جاء عاصيها",44,"ي",3,0],["عروسة بالدر قد نطقت","مليحة المظهر والشكل",45,"ل",1,0],["عروس البحر والدنيا سفينٌ","تروّع بالقواصف والضّباب",46,"ب",1,0],["عروس البحر ما هذي الرزايا","تصبُّ على بنيك بلا حساب",46,"ب",1,0],["عروس البحر يا مهوى فتوني","ويا مغنى أمانيّ العذاب",46,"ب",1,0],["عروس البحر حدّثني شهودٌ","بأن الشط صار إلى تبات",46,"ب",3,0],["عروس البحر نسرف إن رأينا","حياتك في المزاح وفي اللعاب",46,"ب",1,0],["عَروسُكَ عَذراءُ مِن عَبقَرٍ","أَتَتكَ مُصَبَّغَةً بِالخَفَر",47,"ر",1,0],["عروس تحيّاتٍ من الحسن تنجلي","بعقدِ بديعٍ زانه أعظمُ الحُلي",48,"ل",2,1],["عروبَتُهم قد أعربت عن نُفوسهم","فكانت من الإبريزِ أصفى وأبهرا",49,"ر",2,0],["عَروسٌ أَنتَ أَوْلَى مَن جَلاها","وَهَلْ تُجْلَى العَروسُ بِغَيْرِ تَاجِ",50,"ج",1,0],["عَروس مَجدا ذا أَبصَرتَها ظَهَرَت","عَن وَجهِ مُستَبشِر أَو ثغر مُبتَسِم",51,"م",1,0],["عَروبٌ كَأَنَّ الشَمسَ تَحتَ قِناعِها","إِذا اِبتَسَمَت أَو سافِراً لَم تَبَسَّمِ",52,"م",1,0],["عَرَوناه على الأكوار لما","برا من أصلنا داءً عضالا",53,"ل",2,0],["عروة ما مثلها من عروة","مالها قط انفصام وانخرام",54,"م",1,0],["عروة الوثقى ومنهاجِ الهدى","كشفوا عن أوجهِ الحقّ حجابا",55,"ب",2,0],["عروةٌ من عُرا السَّعادة وثقى","قد وثقنا بها وحبلاً متينا",56,"ن",2,0],["عروس بالدعا وافت","وقامت بالثنا تجري",57,"ر",2,0],["عروساً كلَّ بِكْرٍ أَوْ عَوَانٍ","من العَطِراتِ بالمَوْتِ الزُّؤامِ",58,"م",1,0],["عَرُوبة حيّ كالقناة زففتها","إليك كما زُفّتْ لكفء عرائس",59,"س",1,0],["عَرُوبةُ حيّها تختالُ تيهاً","على الشِعرى بعيداً مرتماها",60,"ا",3,0],["عروسٌ حصانُ النجرِ فكري وليّها","سهرتُ لها وهناً فما وجدتْ وهنا",61,"ن",2,0],["عروسٌ حصانٌ كان يومُ زفافها","من الدَّهر عيداً للسّماح وموسماً",62,"م",2,0],["عَروسُ مُدامَةٍ زُفَّت إِلَينا","عَلى نَغَمَ الَثالِثِ وَالمَثاني",63,"ن",2,1],["عُروجا إلى عَرشَيكَ عرشِ قلُوبِنا","وعرشٍ له تعنو الأعاجمُ والعُربُ",64,"ب",1,0],["عَروبٍ عَروسِ الزِيِّ أَندَلُسِيَّةٍ","مِنَ الأَدَبِ الغَضِّ الَّذي رَوضهُ نَدي",65,"د",2,0],["عروسُ الكأْس يجلوها نديمي","علينا في ثيابٍ من نعيم",66,"م",1,1],["عروس مجد ابت الا الزفاف إلى","اماجد القوم والاكفاء والشرفا",67,"ف",2,0],["عَروساً كلَّما جُليَت تَناهَت","غُلالَتُها اصفِراراً واحمِرارا",68,"ر",2,0],["عَروسٌ بُدِّلَت بالموتِ بَعلاً","وسآءَ الموتُ واأَسفى الحليلا",69,"ل",2,0],["عروسٌ لها نِطْعٌ بديعٌ مُسَرْدَقٌ","تراه لها قبلَ الزفافِ يمهَّد",70,"د",1,0],["عَروسَ كَرمٍ أَتَت تَختالُ في حُلَلٍ","صُفرٍ عَلى رَأسِها تاجٌ مِنَ الحَبَبِ",71,"ب",1,0],["عَروسِ كَرمٍ أَتَت تَختالُ في حُلَلٍ","صُفرٍ عَلى رَأسِها لِلمَزجِ إِكليلُ",72,"ل",1,0],["عروسُ كرْمٍ لها حُلٌّ","ما حُلِّيتْ مثلهُ عَرُوسُ",73,"س",1,0],["عَروساً إِليكَ الفكرُ مولايَ زفّها","وَظلّ لَها يَرضاكَ خير حَليلِ",74,"ل",1,