39,"لا لن يموت أبي","https://www.poetsgate.com/ViewPoem.aspx?id=187199",""],[5945,"رمضان أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=189061",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"إن المهيمن وحده هو قادر","https://www.poetsgate.com/ViewPoem.aspx?id=208056",""],[5956,"يا رب فك الغمة عن طحال ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=214668",""],[5977,"مطر وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212726",""],[5977,"شهر الصوم","https://www.poetsgate.com/ViewPoem.aspx?id=213259",""],[6152,"دمعة على قبر والدي رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=204818",""],[6152,"طوبى لمن أدرك شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=213172",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6202,"مرثيتي ......","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86754&r=&rc=55",""]],"verses":[["يا رَبُّ فَاِسمَع وَاِستَجِب دَعوَتي","عَجِّل إِلى سَيِّدَتي العافِيَه",0,"ي",2,0],["يا رَبِّ فَاِجمَعنا مَعاً وَنَبِيَّنا","في جَنَّةٍ تُنبي عُيونَ الحُسَّدِ",1,"د",1,0],["يا رُبَّ فاتنة الجمال غريرة","تحمي وراء أسنَّة وسيوف",2,"ف",1,1],["يا رَبِّ فَكَثِّرنا عَدَدا","وَاِبذُل لِأُبُوَّتِنا المَدَدا",3,"د",2,0],["يا رُبَّ فِتنَةِ أُمَّةٍ قَد بَزَّها","جَبّارُها في طاعَةِ الجَبّارِ",4,"ر",1,0],["يا ربُّ فارحمْ مَنْ على","كاتبِهِ ترحَّما",5,"م",2,0],["يا ربُّ فارزقهنَّ قربَ جوارِ مَنْ","شتّانَ بينَ جوارِهِ وجِواري",6,"ر",2,0],["يا رُبّ فارعةِ الأجبالِ راسِيَةٍ","منها وشاهقةِ الأكنافِ صَيخود",7,"د",1,0],["يا ربِّ فاحْرُسْهُ لِي بعيْنٍ","تَمْنَعُهُ الدَّهْر مِن أَذاهُ",8,"ا",2,0],["يا رُبَّ فاتِنة -يعيبُ جمالَها","مَن كان يُدْرك كنهَهُ لو أبصرا",9,"ر",2,0],["يا رُبَّ فرد في الكريهة واحد","بالصدق والإيمان يَعْدلُ عَسْكَرا",10,"ر",2,0],["يا رَب فَاِجمَع شَملَنا مُتَفَضِلاً","فَلمنَك لا مِن فَضل غَيرِكَ أَطلُبُ",11,"ب",1,0],["يا رب فاشدد على الأعداء وطأته","واحم حماه وزده منك إجلالا",12,"ل",2,0],["يا رَبِّ فَاِرحَم عَبيداً في جِواركَ مِن","بَنِي أَبي قاسمٍ في طَيِّهِ اِضطَجَعوا",13,"ع",3,0],["يا ربِّ فاسكنه الجنان منعماً","بجوار أحمد خير أصناف الورى",14,"ر",2,0],["يا رب فاختم لي بخاتمه ال","حسنى وخذ في شدتي بيدي",15,"د",2,0],["يَا رَبِّ فَاغْفِرْ لِي الذِي صَنَعْتُ","وَلاَ تُعَامِلْنِي بِمَا ضَيَّعْتُ",16,"ت",1,0],["يَا رَبِّ فَرِّجْ فَقَدْ ضَاقَتْ مَسَالِكُنَا","وَمُنْقَعُ الْغَمَرَاتِ قَدْ طَمَى فِيهَا",17,"ي",3,0],["يَا رَبِّ فَاجْمَعْنَا مَعاً فِي الْحَيِّ","يَا حَيُّ مَا عَنْهُ غِنىً لِحَيِّ",18,"ي",1,0],["يا رب فازدد سالماً","سكناً يحن إلى سكن",19,"ن",1,0],["يا رب فادخلنا بفضلك في","ما ترتضي والسحب والآل",20,"ل",1,0],["يا رب فاحفظ ديننا ومعاشنا","واختم بخير إن ألم حمام",21,"م",1,0],["يا رب فاستر واسمحن","فأنت أكرم من ستر",22,"ر",1,0],["يا رَبِّ فَاِجعَل لَدَيهِ","بَدرَ الصَفا في تَمامِ",23,"م",1,0],["يا رَبّ فاِصرفهُ بِما شئت كَما","تَشاءُ وَاِبعَث لِأَعادينا البلا",24,"ا",1,0],["يا رَبّ فينا اِتّسع الخرق بِلا","رَتق وَقَد ضاقَ بِنا رَحب الفَضا",24,"ا",1,0],["يا ربّ فاكْتُبْ ثَوابَ عَبْدٍ","ما زَالَ مُذْ كانَ في جِهادِ",25,"د",1,0],["يا رب في دار الفنا رحمة","فهي لمن فيها غدت تشمل",26,"ل",1,0],["يا رُبَّ فردٍ قد يُضِّيعُ أمةً","سواه تَعمرُ حوَله الأعمارُ",27,"ر",1,0],["يا رَبِّ فاجْعَلْ لهذَا العَبْدِ بَيْنَهُمُ","سَهْماً وإنْ كانَ مِنْ أَثْوابِهِمْ عارِي",28,"ر",2,0],["يا ربِّ فامْنُنْ بالسَّراحِ معجَّلاً","فأنا سراحي من جَلالِك أسألُ",29,"ل",1,0],["يا رَبِّ في حِفْظِكَ تَرْحالُهُ","ما إنْ يُضِيْعُ اللهُ مُسْتَودَعَهْ",30,"ع",2,0],["يا ربِّ فاكفِ أبا عل","ي حيث حلَّ وحيثُ سارا",31,"ر",2,0],["يا رَبِّ فَرِّق جَمعَهُم","يا رَبِّ والِ قَمعَهم",32,"م",1,0],["يا رَبِّ في أَعناقِهم","مَكِّنْ سُيوفَ المُسلِمين",32,"ن",1,0],["يا رَبِّ فيهِم ضَيِّقِ","لِلقَفرِ وَالفَلا الرّحيب",33,"ب",1,0],["يا رب فاسدِل على العبد الضعيف","من العفو الكثيف رداءً يستر الخللا",34,"ل",2,0],["يا رب فوارة أَبدت لنا عَجَباً","يَحكي نضاراً مذاباً ماؤها الجاري",35,"ي",1,1],["يا رَبِّ فَاجعَل لَيالِينا مُفَصَّلَةً","بِمِثلِ لَيلَتِنا يا خَيرَ مَشكُورِ",36,"ر",1,0],["يا رب فاقبل ولا تخيب","فأنت غوثاي واعتمادي",37,"د",2,0],["يا رَبِّ فاحكُمْ بيننا باَلحقِّ","يا عالما مَكْنونَ سِرِّ الَخلْقِِ",38,"ق",1,0],["يا َربِّ فالْعَنْ جاِحدى الشرائعِ","واْرِمهمُ بأفْجَع الفَجائِع",38,"ع",1,0],["يا رب فاسلك بسري حيثما سلكت","اسراره وادعني من خير خدامه",39,"م",2,0],["يا رب فارحمه وهب منك الدوا","حتى يُرى بعد الضلالة قد حوى حسن",40,"ن",1,0],["يا رب فارحمني به وتولنى","في كل حال واهدني وأجلني",40,"ي",1,0],["يا رب في الدارين هبنا الفضل والاحسان","واجبر بفضلك يا ولي لنا الخلل",40,"ل",1,0],["يا رب فاقبل دعاءي","وقِ العذاب بستر",41,"ر",1,0],["يا ربِّ فض الختم عن غيرها","واجعل بها يا ربِّ حسن الختام",42,"م",1,0],["يا رب فارحمني أجب","قد عيل مني المصطبر",43,"ر",1,0],["يارب فارع ( أبا خليفة) للورى","وأنله عمرا من لَدُنك مديدا",44,"د",2,0],["يا رب فضاقَت فرِّجنا","فالشدّةُ أفضَت للفَقَم",45,"م",1,0],["يا ربَّ فتيان صدق رحتُ بينهمُ","والشمسُ كالدنف المشغوف في الأُفُقِ",46,"ق",1,1],["يا ربّ فاقض على شقو","تي وهبني السلاما",47,"م",2,0],["يا رَبُّ فاشهَد أنَّنِي بَلَّغتُهُم","وَيُشِيرُ نَحوَهُم لِقَصد بَيَانِ",48,"ن",1,0],["يَارَبُّ فَانصُرنَا عَلَى الشَّيطَانِ لَي","َسَ لَنَا بِهِ لَولاَ حِمَاكَ يَدَانِ",48,"ن",1,0],["يا رب فارزقها بحقك تاجرا","قد طاف بالآفاق والبلدان",48,"ن",1,0],["يا ربِّ فإرجِعنى إليك فيها","بكسوَة الأنوارش يا كافيها",49,"ه",2,0],["يارب فيم خلقتنا","وتركتنا نهب الضباب فلا ظلام ولا سنا ؟ !",50,"ن",2,1],["يا ربّ فيم جعلت حسّي مُرهفا","فبقيتُ رهن وساوسٍ وبلابل",51,"ل",1,1],["يا رب فيم جعلت طبعي نافرا","من أسرةٍ وتجمّع وزواج",52,"ج",1,1],["يا رَبُّ فَارحَم كُلَّ آنٍ شيخَنا","أبَداً وآنس شيخَنا في المَضجَعِ",53,"ع",1,0],["يا ربِّ فامنن علينا","قبلَ الممات بفقدهِ",54,"ه",1,0],["يا رب فتحا قريبا سرمدا ابدا","بغير حد ولا عد ولا ثلم",55,"م",1,0],["يا رب فاشفع لنا فينا بحسن رضا","وارفع لخافض احوال من التخم",55,"م",1,0],["يا رَب فَاِقبَل مُسيئاً جاءَ مُعتَزِراً","وَاِسمَع دعاة الا يا خَير من سَمِعا",56,"ع",2,0],["يا رَب فَاِقبَل دعا عَبد اِلَيكَ سَعى","وَصَحَّ فيكَ لَهُ ظَن وَمعتَقَد",57,"د",1,0],["يا رب فرج إذاً وعجل","فإنك السامع المجيب",58,"ب",1,0],["يا ربّ فاقضِ عليهم","فانك الفعَّال",59,"ل",1,0],["يا رب فانظر إلينا","بعينش رُحماكَ فينا",60,"ن",2,0],["يا ربِّ فاغفرْ ذنبي واعفُ عنّي","ولا تؤاخذني بذنبٍ مني",61,"ي",1,0],["يا ربِّ فاقبلَنِّي باسمك الشكور","واغفر ذنوبي ربّنا باسم الغفورْ",62,"ر",1,0],["يا رَب فَاِجعَل جَنَّة المَأوى لَها","دارا يَطيبُ نَعيمُها تَتَمَتَّع",63,"ع",1,0],["يا رب في الأولى سترت عيوبهم","فاغفر لهم ما قدّموا في الآخره",64,"ر",2,0],["يا رب فارحم عبيداً أنت بارؤه","وكف عنه الذي يخشى على عجل",65,"ل",1,0],["يا رب فاغمره لطفا","يا رب شاف وعاف",66,"ف",1,0],["يا ربِّ فانْجِدْني بجيشِ العَفْوِ قدْ","صالت عَلَيَّ كتائبُ العصيانِ",67,"ن",1,0],["يا ربَّ في الوصلِ لومٌ","وليس في الهجرِ لومُ",68,"م",1,0],["يَارَبِّ فَرِّجْهَا فَأَنْتَ إِلَهُنَا","وَاجْعَلْ لِوَأْدِ بَلَائِهِ أَنْفَاقًا",69,"ق",2,0],["يَا رَبُّ فَاغْفِرْ ذَنْب َ مُعْتَذِر ٍ","أَنْتَ الْغَفُورُ وَأنْتَ مُقْتَدِرُ",70,"ر",1,0],["يا ربّ فلتستجب دعوات من فقدوا","وارحمهُ أنتَ عفوٌّ أنتَ مقتدرُ",71,"ر",1,0],["يا رب فارحم من أتاك بما","في الخلدِ والبِس وافداً حللا",72,"ل",2,0],["يا ربُّ فأذَنْ بالظهور لغائبٍ","أنت العليمُ بِما يُكَنُّ ويُضمَر",73,"ر",1,0],["يا رب فارحمنا بهم","يا من عن العاصي عفا",74,"ف",2,0],["يا ربِّ فارحم قلبَ والهةٍ","بالوالهِ المفتون يتصل",75,"ل",1,0],["ياربِّ فارحَمْ بذاكَ القَبرِ ساكنةً","آتِ الكتابَ بِيُمْنَاها إذا وَقَفُوا",76,"ف",3,0],["يا ربّ فاهدِ قلوبنا وعقولَنا","وقنا الشّرورَ ، إلهنا ، يا مُرْتَجَى",77,"ا",1,0],["يا ربِّ فارحم شيخَنا وحبيبَنا","واحفظ علينا ملّةً ترضاها",78,"ا",3,0],["يا ربِّ فالْطُفْ بنا وارحم مشرَّدَنا","وانصر شعوباً , وما إلاّك يرعاها",79,"ا",3,0],["يا ربِّ, فارحم ضعفنا وأنيننا","يا ربِّ, وارحم مَن ببابك ينْصَبُ",80,"ب",1,0],["يا رب فتيَانِ صِدق رحتُ بينهم","والشمسُ كالدّنفِ المعشوق في الأفقِ",81,"ق",1,1],["ياربُ فارزقنا شفاعةَ احمدٍ","يومَ الوقوفِ بساحةِ الميعاد",82,"د",1,0],["يا رب فرج كربتي بمحمد","وببنته ثم أبنها وأبيه",83,"ه",1,1],["يا رب فارفع للشهيد مقامه","وأَنِرْ لهذا الجيل منه مشاعله",84,"ل",2,0],["يا رب في الأظعان سار فؤاده","وبوده لو كان سار جميعه",85,"ع",2,0],["يا رَبِّ فاكْتُبْ لنا لُقْيا أحِبَّتِنا","لا يخْذُلُ الله عبْداً باتَ يَدْعُوْهُ",86,"و",2,0],["يا رب فاجعل لها في الخلد منزلة","يسر لنا في جنان الخلد لقياها",87,"ا",3,0],["يَا رَبِّ فَاقْبَلْ مِنْ عِبَادِكَ سَعْيَهُمْ","وتَجَاوَزَنْ يَا رَبِّ عَنْ زَلَّاتِي",88,"ت",2,0],["يا ربِّ فاجعلْ لنا مِنْ فَقْدِهِم عِوَضاً","نلقاهمُ في جِنَانِ الخُلْدِ نَحْتَفِلُ",89,"ل",1,0],["يَا رَبِّ فاكرمْ في القيامةِ وفدَهم","واسكنهما الفردوسَ نِعْمَ المنزلُ",90,"ل",1,0],["يا ربُّ فاشهدْ كيف أعدَدْنا لهمْ","من قوّةِ الإيمانِ إرهاباً دواءْ",91,"ا",2,0],["يا ربُّ فارحَمْ روحَهَمْ وشبابَهَمْ","أكْرِمْ عُبَيْداً في لحَاقِ الأكرمينْ",92,"ن",1,0],["ياربِّ فارحم فالقلوب تباعدَتْ","وتغيَّرت من غمَّةِ الأحزانِ",93,"ن",1,0],["يَا رَبُّ فَاشْهِدْنِي وُجُودَكَ إِنَّنِي","لِوُجُودِ غَيرِكَ فِي وُجُودِكَ قَامِسُ",94,"س",1,0],["يا ربُّ فاحفظْ في العراقِ حبيبةً","ذهبتْ مغاضبةً إلى البلقانِ",95,"ن",1,0],["يا ربُّ..فاغفرْ لي ذنوبي كلَّها","يا غافرَ الزلّاتِ والآثامِ",96,"م",1,0],["يا ربُّ فاختمْ بالرفاهِ سنينَنا","وامننْ وجدْ يا ربُّ بالغفرانِ",97,"ن",1,0],["يا ربُّ؛ فَاعصِمْهَا قُلوبَ أحبَّتي","واللطفُ لطفُكَ أَنتَ مَن يُجريهِ",98,"ي",2,0],["يا رب فاغفر لمن لم يدر ما قصدا","وما أراد الأعادي من مضرات",99,"ت",1,0],["يا ربّ فالطفْ والمصائب جمّةٌ","والخيرُ من بعد المصاب تضاءلا",100,"ل",2,0],["يا ربُّ فارحمْ نفْسنَا وفؤادَنا","فبرحمةٍ يجْزي الصيامَ جزاءُ",101,"ا",2,0],["يا ربُّ فارجعْ للعباد هدى","وأعدْ علاء المسلمين حِوَلْ",102,"ل",1,0],["يا رب فالطف في عبادك رحمة","فالموت فيهم بالخلائق خاطف",103,"ف",1,0],["يا ربّ فاغفر زلتي","والذنب تأكيد وشكّ",104,"ك",1,0],["يارب فارحم خافقاً","رام الفلاح وما انتهك",104,"ك",1,0],["\"يا ربُّ فتممْ فرحتَنا","فالحبُّ تطهَّر موردُه",105,"د",2,0],["يارب فرج للهموم جميعها","هذي الشعوب لطيب عيشٍ ترغب",106,"ب",1,0],["يارب فاغدق بالعطاء لقلبه","واغمره حبا قد رجوتك داعيا",107,"ي",2,0],["ياربِ فاغفر ذنب مكتئبٍ","من غيظه قد أطلق الوحشا",108,"ش",2,0],["يا رب فاجعل حبه","زادي إلى دار الحلول",109,"ل",1,0],["يا رب فاغمر بالسَّعادة قلبنا","ولتزهوَ الدنيا وتلك الدار",110,"ر",1,0],["يارب