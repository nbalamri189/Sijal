ا عنه من",80,"ن",1,0],["واستحضر الشطرنج للملاعبه","إِشارة مِنهُ إِلى المُحارَبه",81,"ه",1,0],["واستحسن الخليل خبنا في سوى","مستفعلن لكن سعيد قد طوى",82,"ط",3,0],["واستحسنوا عندَ الفراغِ طَبقَها","إذ كان ذاكَ الانطباقُ حَقَّها",83,"ه",2,0],["واستحسنوا استعمالها وقللوا","ما كان في الاوضاع منها ينقلُ",83,"ل",1,0],["واستَحي مِن رَبِّ الوَرى حقّ الحَيا","أما تَرى الدَّهرَ يُنادي بِهَيا",84,"ي",2,0],["واستحوذَ الجهلُ على قلوبهمْ","حتّى لقد صار البغيض من نطَق",85,"ق",1,0],["واستحث الكؤوس صرفاً بلا مز","ج مكباً كالهائم العطشان",86,"ن",1,0],["واستحلت الفرسُ له خلائقاً","أخلاقها المرةُ من أضدادها",87,"د",3,0],["وَاِستَحَلَّوا غَزوي بِكُلِّ غَزالٍ","حَلَّ في حُبِّهِ قِتالي وَغَزوي",88,"ي",1,0],["وَاِستَحالَ النَهارُ وَاللَيلُ حَتّى","كادَ أن يَسبِقَ الغُدُوَّ الأَصيلُ",89,"ل",1,0],["واستحال القريب منّي بعيداً","هكذا كان أمرهم في تمادي",90,"د",2,0],["واستحق العتق لما ولدت","أول الشان عليها واتفق",91,"ق",1,0],["واستحلبت حلب جفنيّ فانحلبا","وَبشرتني بحرّ القتل حرّانُ",92,"ن",1,0],["وَاِستَحدَثَ القَومُ أَمراً غَيرَ ما وَهِموا","وَطارَ أَنصارُهُم شَتّى وَما جَمَعوا",93,"ع",3,0],["واستحسنوا من قبيح الفعل ما وَخدَتْ","عنهم به في البلاد الأَيْنُقُ الرُّسُمُ",94,"م",1,0],["واستحوذ الذعر على جمعها","فاضطربت أفرادهُ هالعه",95,"ع",2,0],["واستحيي من عشق الحسان فما الذي","تبغى الحمائم عند نسر قشعم",96,"م",1,0],["وَاِستَحكَمَت غُربَةُ الإِسلامِ وَاِنكَسَفَت","شَمسُ العُلومِ التي يُهدى بها البَشرُ",97,"ر",1,0],["واستَحسَنَ ابنُ عَقِيل ذَا مِن أحمدٍ","لمَّا حَكَاهُ عَنِ الرِّضَى الرَّبَّانِي",98,"ن",2,0],["وَاِستَحَلَّت قَتلَنا عامِدَةً","وَتَجَنَّت عِلَلاً لَم تُجتَرَم",99,"م",1,0],["وَاِستَحَلَّ الأَميرُ حَبسَ عَطائي","خالِدٌ إِنَّ خالِداً لَحَريصُ",100,"ص",1,0],["واستحكمت عروة الوجد الذي فتكت","سهامه فيك واستعصى تلافيها",101,"ي",3,0],["واستحلبوا الفاظه فكأنكم","بسريره وعليه جمع ينحب",102,"ب",1,0],["واستحضر الناس إجمالا وفصلهم","مميزا بين ذي لب ومجنون",103,"ن",1,0],["واستحى فؤادك بالتقوى","فالتقوى تحيي ما رمسا",104,"س",2,0],["وأستحي من مدح نفسي سدى","لكنما شعريَ لا يستحي",105,"ح",2,0],["واس