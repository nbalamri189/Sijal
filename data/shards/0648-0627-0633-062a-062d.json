,"جلاء الجيش الإنجليزى عن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185638",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5186,"في ليلة القدر أتاح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=156523",""],[5206,"جواب الشيخ حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187421",""],[5214,"مضى وحيدًا","https://www.poetsgate.com/ViewPoem.aspx?id=214842",""],[5277,"العفوُّ جلّ جلاله","https://www.poetsgate.com/ViewPoem.aspx?id=189515",""],[5324,"رواء .","https://www.poetsgate.com/ViewPoem.aspx?id=207629",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5387,"بعينيكِ ارتياحي","https://www.poetsgate.com/ViewPoem.aspx?id=46526",""],[5409,"بدلت وجهه الحميا بوجهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155393",""],[5409,"أين ذاك الوادي الذي كان بال","https://www.poetsgate.com/ViewPoem.aspx?id=155315",""],[5409,"خلطاء من كل فج حضور","https://www.poetsgate.com/ViewPoem.aspx?id=155271",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5431,"أعلنوه انسحابا ...","https://www.poetsgate.com/ViewPoem.aspx?id=212773",""],[5444,"صفيُّ العِلم","https://www.poetsgate.com/ViewPoem.aspx?id=205525",""],[709,"خفرت بسيف الغنج ذمّة َ مِغفَري","https://www.poetsgate.com/ViewPoem.aspx?id=2880",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[5574,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=206009",""],[5727,"الشاطئ البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=205417",""],[5790,"بعثوا اللحاظ طلائع الأحداق","https://www.poetsgate.com/ViewPoem.aspx?id=112090",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""]],"verses":[["وَاِستُحِثَّ المُغَيِّرونَ مِنَ القَو","مِ وَكانَ النُطافُ ما في العَزالي",0,"ل",2,0],["واستحلفتني على قلبي فقلت لها","يهواك أي وجلال الحسن يهواك",1,"ك",1,0],["واستحلّوا محارمَ اللّه بالظَّن","نِ ولم يرْهبوا له ترهيبا",2,"ب",2,0],["واستحبَّ الإحفاءَ فيهن والحَلْ","ق مكان الإعفاء والتوفيرِ",3,"ر",1,0],["واستحفظته قوام دولتها","وما يلي ذاك من علائقها",4,"ق",3,0],["وَاِستَحدَثوا طُرقاً مُنَوَّرَةَ الهُدى","كَسَبيلِ عيسى في فِجاجِ الماءِ",5,"ا",2,0],["وَاِستَحجَبوا الكُهّانَ هَذا مُبلِغٌ","ما يَهتِفونَ بِهِ وَذاكَ مُصَدِّقُ",6,"ق",1,0],["وَاِستَحدَثَت ديناً فَكانَ فَضائِلاً","وَبِناءِ أَخلاقٍ يَطولُ وَيَشهَقُ",6,"ق",1,0],["وَاِستُحدِثَت لِيَ أَبدالٌ بَرِمتُ بِها","بِالكَورِ حَورٌ وَبِالبُنيانِ تَقويضُ",7,"ض",1,0],["وَاِستِحالَ سَوادُ حَظّي بَياضاً","حينَ حالَ البَياضُ مِنكَ سَوادا",8,"د",2,0],["واستَحضَرَ اللَّيلُ النّهارَ بظلمةٍ","طلعتْ بها زُهْرُ النجوم إلالا",9,"ل",2,0],["واستحدثوا لابْنَيْكَ ما لا تَدَّعِي","خُدَعُ الرُّؤى وعجائبُ الأيَامِ",10,"م",1,0],["وَاِستَحمَلَ الشَبَحَ الضُحى بِزُهائِهِ","وَأُميتَ دُعموصُ الغَديرِ المُثمِدُ",11,"د",1,0],["وَأَستَحَبُّوا دُوني البِلاط فَسَلعاً","فَقُباءً وَأَينَ مِنّي قُباءُ",12,"ا",2,0],["وَاِستَحوَذَت رِيحُ الشَمالِ عَلى","أَثوابِهِ وَتَمَصَّحَ البُسرُ",13,"ر",1,0],["واستْحالَ الزَّأرُ إرناناً كما","رَجَّعَ الباكي على الأيكِ الغرِد",14,"د",1,0],["واستحجبَ الإمامُ خيْرَ حاجبِ","وخيْرَ مَصحوبٍ وخَيرَ صاحبِ",15,"ب",1,0],["واستحقروه إِذ رأوه أمرداً","غرّاً وعدّوه من الصبيان",16,"ن",1,0],["واسْتَحْمَلَ الشَّوْقَ مِنِّي عِرْمِسٌ سُرُحٌ","تَخَالُ بَاغِزَهَا بِاللَّيْلِ مَجْنُونَا",17,"ن",2,0],["واستحالت بين عينيه دُمىً","حيَّةً تستبقُ البابَ خطاها",18,"ا",3,0],["وَاسْتَحْكَمَ الْهَوْلُ حَتَّى مَا يَبِيتُ فَتىً","فِي جَوْشَنِ اللَّيْلِ إِلَّا وَهْوَ سَاهِرُهُ",19,"ر",2,0],["وَاسْتَحَبَّتْ عَلَى اعْتِدَالِ المُقَامِ","عِيشَةً بَيْنَ صِحَّةٍ وَسَقَامِ",20,"م",1,0],["وَاسْتَحَثُّوا الْخُطَا فَكَانُوا بروقاً","وعلاَ صَوْتُهمْ فكانوا رُعُودا",21,"د",2,0],["واستحالتْ ألحانهُ حشرجاتِ","من حلوق النساء والولدان؟",22,"ن",1,0],["واستحالت أنغامُها زمجراتٍ","تتحدَّى العروشَ والتيجانا",23,"ن",2,0],["واستحالت جنةً وارفةً","من نخيل بائعٍ، دان جَناه",24,"ا",2,0],["واستحرّت خلف ((النجاحي)) وأدمى","في رباها خيوله وحميره",25,"ر",2,0],["واستحكمت ضجةٌ من كل ناحية","جاءت إليها بموتٍ عاجلٍ نُذُر",26,"ر",1,0],["وَاِستَحلها نَزهاً لَو أَنَّها رزقت","حَظّاً لَكانَت لِعَين الدَهر إِنسانا",27,"ن",2,0],["واستحبُّوا الظَلام","فهيَ تدعو النيام",28,"م",1,0],["واستَحسَنُوا وأرتَضوا حَوكِى وأَنتَ إِذَا","ما غِبتَهُ ازدَادَ عِندِى رِفعَةً وعَلا",29,"ل",2,0],["واستحقروا وطآتهم لما دهُوا","بأشدِّ من وطءِ الزمانِ وأثقلا",30,"ل",2,0],["واستحسن الكرماءُ من سَغبٍ","أن يبعثوا بذخائر النملِ",31,"ل",1,0],["واستحسنَتْ فيها الثّعالبُ لبسَهُ","لِفِرائِها فاخترْنَ حَتْفاً عاجِلا",32,"ل",2,0],["واستحاب السحاب في صبحة الص","ح بصوبٍ مثعنجر هتّان",33,"ن",1,0],["واستحسن الناس جحود الغنى","وأظهر الإفلاس ذو المال",34,"ل",1,0],["واستحال النعيمُ غير نعيم","واستحال السرور غير سرور",35,"ر",1,0],["واستحال الإعوال فيها أنينا","حين جفّت من فرطه مقلتاها",36,"ا",3,0],["واستحجرتْ راحاتُهم فكأنها","صخرٌ وإن فلقوهُ ليسَ يلينُ",37,"ن",1,0],["وَاِستَحسَنوا نَقضَ العُهودِ فَهُ","م مِنَ الأَيّامِ أَغدَر",38,"ر",1,0],["واستحالت تلك الدموعُ بُخاراً","صاعداً من فؤادها المصدوع",39,"ع",1,0],["واستحضر العود ووجه به","حتى نصلي بالطنابير",40,"ر",1,0],["واستحضر بطش القادر ما","أحياك ومن بلواه خف",41,"ف",1,0],["واستَحي من شيبة تَراها","في لنار مسجونة تهان",42,"ن",1,0],["وَأَستحيي المروءةَ أَن تَراني","قَتلتُ مُناسِبي جَلداً وقهرا",43,"ر",2,0],["واستحال الضجيج صمتاً رهيباً","زحمته الأشباحُ والأسرار",44,"ر",1,0],["واستحال النغمُ الحنّ","ان في سمعي نواحا",45,"ح",2,0],["واستحال العطف الشديد إلى حب","نماه ذلي وفرط دلالك",46,"ك",1,0],["وَاِستُحصِدَ القَومُ الَّذي أَنا مِنهُمُ","وَكَفى بِذاكَ عَلامَةً لِحَصادي",47,"ي",1,0],["وأستَحْيي زماناً أنت فيه","إذا أرخَيْتُ للشَّكْوَى عِناني",48,"ن",2,0],["واستَحلَّ الوَرى محارِمَ دينِ ال","لَهِ وَيلُ الوَرى من الدَيَّانِ",49,"ن",1,0],["واستحدَثَتْ في لِمّتي","نُقَطاً فهلا كُنّ حِبْرا",50,"ر",2,0],["واستحفظوا منه القَوي","يَ فيهمُ المؤتمَنا",51,"ن",2,0],["واستحلمتني الصَّبا وقِدماً","جُنَّ بأنفاسها جَناني",52,"ن",2,0],["واستحسن الفُصحاءُ شأنَ قصيدةٍ","لأجَلِّ مَمْدوحٍ وأفْصحِ