{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[65,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[50,"ومجلس ما له شبيه","https://www.aldiwan.net/poem64501.html","مجزوء البسيط"],[108,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[112,"يئوى النّعاس","https://www.poetsgate.com/ViewPoem.aspx?id=8400",""],[159,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[240,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[556,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25317","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25355","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132155","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54438","المنسرح"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4931,"أمجاد حبّي","https://www.poetsgate.com/ViewPoem.aspx?id=32488",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5652,"ياضيق صدر الشمري وانت غايب","https://www.poetsgate.com/ViewPoem.aspx?id=137150",""],[5652,"أوركيدتي ..؟!","https://www.poetsgate.com/ViewPoem.aspx?id=175028",""],[5652,"زاد الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=192039",""],[5848,"شفة غياب","https://www.poetsgate.com/ViewPoem.aspx?id=53330",""],[6038,"علامك غيوبي","https://www.poetsgate.com/ViewPoem.aspx?id=25686",""]],"verses":[["يُمطَلنَ بِالعُشبِ فَلا","رِعيٌ لَها إِلّا الجِرَر",0,"ر",1,0],["يُمْطي ذُرا الشّرَفِ العاديِّ همّتَهُ","مُلْقًى على الأمَدِ الأقصى مَراسيها",1,"ي",3,0],["يَمطو مُحَملَجَةَ النُسوعِ بِجَهضَمٍ","رَحبَ الأَضالِعِ فَهوَ مِنها أَكبَدُ",2,"د",1,0],["يَمطُرُ فيهِ السُرورُ سَحّاً","بِديمَةٍ ما لَها اِنتِقالُ",3,"ل",1,0],["يُمطرْنَ بالجُزُرِ الدماءَ، وربَّما","كان الدَّمُ المَوَّار صَوْبَ غمام",4,"م",1,0],["يمطلّع أهداف أجمل الغيّد .. ألى رمية تماس","يمهدّف بقلبي ثمان أهداف .. من حب وقدر",5,"ر",1,0],["يَمْطُلُ كُلَّ العِبادِ دَيْنَهُمُ","وَهْوَ مُلَبّىً بِذَلكَ الدَّيْنِ",6,"ن",1,0],["يَمطُرُنا دائِماً نَداها","فَدَهرُنا كُلُّهُ رَبيعُ",7,"ع",1,0],["يمطر العسجدَ المصفَّى فقد أص","بح كلٌّ على غواديهِ كلاّ",8,"ل",2,0],["يَمطُلُ الشيءَ في يديهِ وزادَ الْ","مَطلَ لؤماً أنْ كان بالمَوجودِ",9,"د",1,0],["يَمْطُوهُ مِنْ شَعْشاعِ غَيْرِ مُودَنِ","صَعْلٌ كَجِذْعِ الشاذِبِ المُمَخَّنِ",10,"ن",1,0],["يَمْطُو قِلاصَ السَفَرِ المَجّاجِ","كَأَنَّهَا مِنْ شِدَّةِ الإِدْراجِ",11,"ج",1,0],["يَمْطُرُ سَحّاً دائماً مُغَيِّمُهْ","مُشْتَرِكاً فِي كُلِّ حَيٍّ قِسَمُهْ",12,"م",2,0],["يُمْطِرْن أَدْجان الغُبُوث السُجَّمِ","سَبَحْتَ مِنْ غَلْوِ الجَوادِ المِخْدَمِ",13,"م",1,0],["يمططون بالحان مصنعة","يحرفون بها واللّه للكلم",14,"م",1,0],["يمطر الزجر في المسامع منه","وتجد السياط في أبدانه",15,"ن",2,0],["يمطرُ مطرانُها العذابَ كما","يُردَى بهدِّ السُّقوفِ أَسقُفُها",16,"ف",3,0],["يمطى الجزيل ويزيل الفقرا","ويبذل الدنيا ويبقى الاخرا",17,"ر",2,0],["يمطر عليّه ورد .. نرجس .. ويزداد","همس الغزل بالشّعر يا عود باني",18,"ن",2,0],["يمطر على أطراف الركا طلعت سهيل","ديره لربوع جارها ماتحده",19,"د",2,0],["يمطر عليك الوصل بأبيات وتجيك","ممزوجةٍ بالطيب مثل السحايب",20,"ب",1,0],["يمطر مشاعر طيب في قلب ممطور","يكتب شعوره ويتغنى شعورك",21,"ك",1,0],["يمطر .. وتتخشع .. رؤوسٍ تخافا","وفي محكم التنزيل آيآت تعصفْ",22,"ف",1,0],["يمطر سما تخضّر منه السحابه","ينزل مثل دمع العزا بين الاقراب",23,"ب",1,0],["يمطر جفاك يا عنودي سكوبي","وتذرف دموع عيني سكايب",24,"ب",1,0]]}