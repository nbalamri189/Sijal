{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[53,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[256,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[275,"الروم قد وثبوا على مراكشا","https://www.aldiwan.net/poem34992.html","الكامل"],[347,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[372,"ولي النبعة من سلافها","https://www.aldiwan.net/poem4618.html","الرمل"],[376,"من يسأل الطرف المسهد","https://www.aldiwan.net/poem57505.html","مجزوء الكامل"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[505,"أرأيت سوق الحب كيف يقام","https://www.aldiwan.net/poem37801.html","الكامل"],[520,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62461","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133829","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35787","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146322","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86263","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131072",""],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29311","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81266","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58169","الكامل"],[5419,"إصرار","https://www.poetsgate.com/ViewPoem.aspx?id=32222",""],[5616,"مفاتن","https://www.poetsgate.com/ViewPoem.aspx?id=203233",""],[5912,"لجة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=205020",""],[6102,"غَنِيمَةُ العُمر !!","https://www.poetsgate.com/ViewPoem.aspx?id=184543",""]],"verses":[["يَتَزَاحَمُونَ عَلَيْكَ حَتَّى خِلْتُهُمْ","سِرْبَ الْقَطَا الظَّامِي وَكَفُّكَ مَنْهَلُ",0,"ل",1,0],["يتزحَّرون بأنفسٍ مجهودةٍ","تبكي وتندرُ ندرةً في الغائطِ",1,"ط",1,0],["يَتَزَوَّجونَ عَلى نِساءٍ تَحتَهُم","لا صاحِباتِ بُغىً وَلا بِشَرارِ",2,"ر",1,0],["يتزّوج الذكر الذكور بلا حيا","وبدعوة علناً...ودفع صداق",3,"ق",1,0],["يتزاحمُ الإفرنسُ والأسبانُ في","تلكَ الديارِ تحارشاً وتخادشا",4,"ش",2,0],["يتزين حسرة","واسى في الاضالع",5,"ع",1,0],["يَتَزَاوَرْنَ كَتَقْطاءِ القَطَا","وَطَعِمْنَ العَيشَ حُلواً غَيرَ مُرّْ",6,"ر",1,0],["يتزوَّد الغادي إِلَي","هِ بفضل ما عنه تزوَّد",7,"د",1,0],["يَتَزَّيَنُ النادي بِحُسنِ وُجوهِهِم","كَتَزَيُّنِ الهالاتِ بالأَقمارِ",8,"ر",1,0],["يتزاحمون على ارتشاف بيوتها","حشدَ الحجيج على جوانبِ زمزمِ",9,"م",1,0],["يتَزاحَمونَ إلى العُلى بقُلوبِهِمْ","هاموا وفي ذاكَ المَقامِ تَرامُوا",10,"م",3,0],["يتزاحم الركبان في أكوارها","كتزاحم الأعناق في إعناقها",11,"ق",3,0],["يتزاحمون ببابه فجميعهم","يبغي المثار على الزمان الغادرِ",12,"ر",1,0],["يتزاحمون على رضاك فواثق","متأدّب ومعفّر متصنع",13,"ع",1,0],["يَتَزَحزَحونَ إِذا رَأَوني مُقبِلاً","عَن كُلِّ مُتَّكئٍ مِنَ الإِجلالِ",14,"ل",1,0],["يَتَزَاهى فخراً وأعظمُهُ مَحْ","ضُ فخارٍ محمدُ اللوذعيُّ",15,"ي",1,0],["يَتزاحَمون على الحِمام كأَنَّه","فَرْضٌ يُفَوِّتُ نَيْلَهُ التأْخير",16,"ر",1,0],["يَتَزاحَمونَ عَلى مَناهِل فَضلِهِ","اذ فَيضُها لِلنّاسِ اعذَب مَورِد",17,"د",1,0],["يتزاحمون على مناهل حتفهم","فكان بهم ظمأ إلى الفقدان",18,"ن",1,0],["يتزاحم العافون حول رحابه","فيبث فيهم ماله ويفرق",19,"ق",1,0],["يتزاحم التيجان حول سريرها","وترى معاقدها الشوامخ خضعا",20,"ع",2,0],["يتزيون بالنزاهة والصد","ق كما يستر الإناء طلاء",21,"ا",2,0],["يَتَزاهَرُ البِشنَينُ فَوقَ شُطوطِها","وَيُغازِلُ الدُفلى زَهرَ اللوتَسِ",22,"س",1,0],["يتزلفون إلى الولاة تذللاً","فتضيق منهم للولاة سجون",23,"ن",1,0],["يَتَزاحَمان إِلَيك في وَ","لَع وَتَستَبق القُرون",24,"ن",1,0],["يتزخرفون على الجنانِ تَبَخْتُراً","لا يفزعُون نَوائِبَ الحِدْثَانِ",25,"ن",1,0],["يتزاحمون من القرون الماضيا","ت وينظرون إليّ من عرض الأفقْ",26,"ق",1,0],["يتزاحم الشعراء حول حياضهم","وحياض شعري نخلتان ومصحف",27,"ف",1,0],["يتزاحم الليل الكئيب بداخلي","وأراك كالأعمى أو المتعامي",28,"م",2,0],["يَتَزَحلَقُ المَنحُوسُ فَوقَ دُرُوبِهِ","وَعَلَى الجَلِيدِ حَظِيظُهُ يَتَزَلَّجُ",29,"ج",1,0]]}