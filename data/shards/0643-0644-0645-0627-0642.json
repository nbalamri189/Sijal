ئمَّة قولاً","فإلى ما تقول أنتَ المآل",95,"ل",1,0],["كلَّما قطَّبتْ من الجوّ وجهاً","عاد فيها بياضه مسودَّا",96,"د",2,0],["كلَّما قلت أورد العدم نقصي","مدَّني بالنوال جودك مدَّا",96,"د",2,0],["كلما قادك شيطان الهوى","للرّدى نجاك سلطان الهدى",97,"د",2,0],["كُلَّما قَلتُ تَقَضّى تَمَطّى","حالِكَ اللَونِ دامِساً يَحموما",98,"م",2,1],["كلَّما قلتُ يُنصف الوصلَ أمضى ال","هجرُ من جَوره على القلب حكمَهْ",99,"م",2,0],["كلّما قلت قرَّ قلبي على با","بلَ هبّت فهيّجتْ بَلبالَهْ",100,"ل",2,0],["كلما قلتُ هادنَ الحسنُ قلبي","راشَ بالهُدب من لحاظك نبلا",101,"ل",2,0],["كلَّما قلت عادني لبي العا","زبُ أو أقصر الفؤاد الجهولُ",102,"ل",1,0],["كلّما قلت قد دنا","زاد بالتّيه بعده",103,"د",2,0],["كل ما قد حوته","فهو شيء نفيس",104,"س",1,0],["كلما قلت أستطيل عليها","حكم الحب أنها تستطيل",105,"ل",1,0],["كُلَّمَا قلتُ رحمةً بي يُجِبني","ارتَقب ما تَراهُ مِن بَعدِ حِينِ",106,"ن",1,0],["كلُّ ما قُلتَهُ حَقٌّ","وَغِنِىٌّ عَن بَيَانِ",107,"ن",1,0],["كُلمَا قد دنوتُ منهُ قليلاً","صبغَ الوجهَ منهُ لونُ الحيَاء",108,"ا",2,0],["كلّما قلتُ أتى ولَّى وإنْ","ضاء لِي شيئاً قليلاً أظلما",109,"م",2,0],["كلّما قلتُ قد مضى عاد منه","وله ما يَغِبّنا وخَبالُ",110,"ل",1,0],["كلّما قُمت طالباً","وَصلهُ في الهَوى قَعد",111,"د",1,0],["كلما قلت آه من فرط شوقي","لك قال المقال منيَ آها",112,"ا",3,0],["كلما قلت ليت لي خبراً","عندهم قيل أنت في العدم",113,"م",1,0],["كلما قام ذلك الماء فيها","خرَّ للأرض ساجداً للحال",114,"ل",1,0],["كلما قلت لي دنا وصل ليلى","كان هذا دنو طيف هجوع",115,"ع",1,0],["كلما قربني همت به","أو تدانيت إليه ارتفعا",116,"ع",2,0],["كلما قد قلت تمت قصص","ظهرت لي في هواهم قصص",117,"ص",1,0],["كلما قارف الذنوب أتته","توبة طهرته واستغفار",118,"ر",1,0],["كُلَّمَا قَالَ لِي رِضَائِيَ فِي هَ","ذَا وَآثَرْتُهُ أَرَادَ سِوَاهُ",119,"ا",2,0],["كُلَّما قُلتُ تَناهَي","حَدَثانُ الدَهرِ عادا",120,"د",2,0],["كلما قلت جار قومك فينا","قالت العذل شأنهم للرفيق",121,"ق",1,0],["كلَّما قُلتُ من مَدِيحي فنّاً","جاءَني من نَدَى يَدَيْه فنونُ",122,"ن",1,0],["كلما قدَّم الطعام له كب","بر مستبشراً به وتأدبْ",123,"ب",1,0],["كل م