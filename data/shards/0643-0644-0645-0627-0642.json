56,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""],[4442,"أرهقتني بين المقابر جلبه","https://www.poetsgate.com/ViewPoem.aspx?id=171231",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6124,"نور اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=193275",""],[6142,"بالغريين وبين الذكوات","https://www.poetsgate.com/ViewPoem.aspx?id=155734",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""],[572,"أنا أفْدي منْ لَيسَ أعرف تيهاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9493&r=&rc=350",""]],"verses":[["كُلَّما قَبَّلتُ زَهرَتَها","خِلتُ أَنَّ القَطرَ غَيرانُ",0,"ن",1,0],["كُلَّما قَصَّرَ الحَيا كانَ ماءُ ال","عَينِ أَبقى صَوباً وَأَعظَمَ غَزرا",1,"ر",2,0],["كُلَّما قُلتُ رَوَّحَتني اللَيالي","ضَرَبَت بي آفاقَ هَذي البِلادِ",2,"د",1,0],["كُلُّ ما قُلْتَهُ فقدْ قالَه النا","سُ مَقالاً آياتُهُ مَتْلُوّهْ",3,"و",2,0],["كُلَّما قامَ مُصلِحٌ أَعجَلَتهُ","عَن مُناهُ غَوائِلُ الآجالِ",4,"ل",1,0],["كُلَّما قامَتِ الصَلاةُ دَعى الدا","عي لِعَبدِ الحَميدِ بِالتَأييدِ",5,"د",1,0],["كُلَّما قُلتُ حاكَ فيهِ مَلامي","نَهَسَتني مِنهُ عَقارِبُ تَسري",6,"ر",2,0],["كلم أقدامها على خجل","مخبوءة في طاقة الزهر",7,"ر",1,0],["كلما قد هززتكم لنُهوض","عدت منكم بقَسوة الجُلمود",8,"د",1,0],["كلما قال لنا ساستهم","نقضت أقوالهم منهم فعال",9,"ل",1,0],["كل ما قيل في الحياة ظنون","جرّها في افتكارنا التخييل",10,"ل",1,0],["كلَّما قيل قد سلا عن فتاةٍ","عادَهُ الحبّ فاسْتجدّ فتاته",11,"ت",2,0],["كلما قابلت طلعته","قيل لي يا سعدها بركه",12,"ه",1,0],["كلما قطَّ أو هَوَى في مَقَذٍّ","مِضْرَبٌ منه في العظام رَسُوبُ",13,"ب",1,0],["كلما قلتُ فيك قولاً جميلاً","ناقَضتْهُ وردعُهُ في يديكا",14,"ك",2,0],["كُلَّما قُلتُ قَد وَجَدتُ حَبيبا","طَلَعَ المَوتُ بَينَنا يَتَهادى",15,"ا",1,0],["كُلَّما قُلتُ اِستَرَحنا","جاءَنا الشَيخُ الإِمامُ",16,"م",1,1],["كُلَّما قُلتُ اِستَرَحنا","جاءَنا شُغلٌ جَديدُ",17,"د",1,1],["كلَّما قامَ في البلادِ خَطيبٌ","مُوقِظٌ شعبَهُ يُريدُ صَلاحَهْ",18,"ح",2,0],["كل ما قد نثرته فجميل","كل ما قد نظمته فبديع",19,"ع",1,0],["كل ما قد قلناه في هذه الذكرى","ثناء عليك بعض صفائك",20,"ك",1,0],["كل ما قلته لئالئ الا","انها لا تباع في الاسواق",21,"ق",1,0],["كل ما قد صنعت كان بديعا","كل ما قد ابدعت كان ثمينا",22,"ن",2,0],["كُلَّما قالَ نائِلٌ أَنا مِنهُ","سَرَفٌ قالَ آخَرٌ ذا اِقتِصادُه",23,"د",2,0],["كُلَّما قيلَ قَد تَناهى أَرانا","كَرَماً ما اِهتَدَت إِلَيهِ الكِرامُ",24,"م",1,0],["كُلَّما قُلتُ أَعتَقَ المَدحُ رِقّي","رَجَعَتني لَهُ أَياديهِ عَبدا",25,"د",2,0],["كُلَّما قُلتُ أَنفَدَ الشَوقُ دَمعي","فاضَ غُزرٌ مِن غَربِهِ بَعدَ غُزرِ",26,"ر",1,0],["كُلَّما قُلتُ قَد أَرَحتُ رِكابي","ذَهَبَت بي عَنِ الحُقوقِ الفُضولُ",27,"ل",1,0],["كُلَّما قُلتُ ثابَ لِلقَلبِ رُشدٌ","عاوَدَ القَلبَ عائِدٌ مِن خَبالِه",28,"ل",2,0],["كُلَّما قُلتُ أَيبَسَ المَحلُ أَرضي","وَلَيتَني غَمامَةٌ مِنهُ تَهمي",29,"م",2,0],["كُلَّما قامَت لِقَومٍ دَولَةٌ","عَجَّلَ الحَينُ عَلَيهِم نَكسَها",30,"س",3,0],["كُلُّ ما قَد كانَ مِنهُ","فَلِقُبحٍ مِن خِلالي",31,"ل",2,0],["كُلَّما قُمتُ قائِلاً أَرِني وَج","هَكَ نادى وَعِزَّتي لَن تَراني",32,"ي",1,0],["كُلَّما قُلتُ يَستَتِمُّ هِلالٌ","سَلَبَتنا أَيدي الرَدى أَقمارا",33,"ر",2,0],["كلما قال شعرَه","غمر السهلَ والعلم",34,"م",1,0],["كلما قامت تثَنّى خَلَعَتْ","مَيَلَ التيه على خُوطٍ قويم",35,"م",1,0],["كُلَّما قُلتُ قَد رَثى لِسَقامي","زادَ قَلبي بِهَجرِهِ تَبريحا",36,"ح",2,0],["كُلَّمَا قُلْتُ قَدْ أَصَبْتُ خَلِيلاً","أَضْحَكَتْنِي مِنْ غَدْرِهِ الأَيَّامُ",37,"م",1,0],["كُلَّما قُلتُ تَناسى ذِكرَها","راجَعَ القَلبُ الَّذي كانَ نَسي",38,"ي",1,0],["كُلَّما قالَ لي اِنطَلِق","قُلتُ إِربَع سَأَفعَلُ",39,"ل",1,0],["كُلَّما قُلتُ مَتى ميعادُنا","ضَحِكَت هِندٌ وَقالَت بَعدَ غَد",40,"د",1,0],["كُلَّما قُلتُ أَما مِن نَهضَةٍ","نَهَضَت فيهِم فَهاجَت حَزَني",41,"ن",2,0],["كُلَما قاتَلَ جُندِي","يٌ بِسَيفٍ أَو عَمودِ",42,"د",1,0],["كلّما قلَّبَ المُحَدِّدُ فيها ال","لحظَ ولّى بنَاظِرٍ مطروف",43,"ف",1,0],["كُلَّما قيسَ بِكَ الأَق","وامُ لَم يَسوُوا قِبالا",44,"ل",2,0],["كلَّما قابلَهُ شخ","صٌ رأى صُورتَهُ فيهِ",45,"ي",2,0],["كل ما قد أصابكم من عذابٍ","فله ممن في السماءٍ صدور",46,"ر",1,0],["كلُّ ما قد رقَّ من شعري وما راق لديها","وهو ما ضمَّ كتابٌ هو منها وإليها",47,"ي",3,0],["كُلَّمَا قُلْتُ قَدْ تَنَاهَى غَرَامِي","عَادَ مِنْهُ مَا كَانَ أَصْمَى وَأَرْدَى",48,"د",2,0],["كَلِمٌ أُقَدِّمُهَا عَلى خَجَلٍ","مخْبُوءَةً فِي طَاقةِ الزَّهْر",49,"ر",1,0],["كلّما قلت رفّ من فمك الفجر","وغنّى الربيع بالعطر واخضلّ",50,"ل",1,0],["كلمَا قَامَ مُنْشِدُ الْقَوْمِ يَتْلُو","هُ تَمَنَّى مُتَابِعٌ أَنْ يُعِيدا",51,"د",2,0],["كلّما قابل آه ! أو صعّد الأنف","اس شاهدت قطعة من فؤاده",52,"د",2,0],["كلّ ما قد رقّ من شع","ري وما راق لديها",53,"ي",3,0],["كلما قلتُ قدْ أصبتُ خليلاً","فَانْظُرُوا: كَيْفَ تُعْبَدُ الأَصْنَامُ؟",54,"م",1,0],["كلما قلت يا عريب أغيثوا","بوصال قالوا مع العجب لالا",55,"ل",2,0],["كلما قلنا نسينا قدحت","من دماء القلب نيران الأسى",56,"ا",1,0],["كلما قبلت وجنته","خلت أن الورد خجلان",57,"ن",1,0],["كلما قُلت قد هبطتُ من الشدةٍ","في حبِّكم بَدَا لِيَ مَرْقَى",58,"ق",2,0],["كلما قُلت قد صَحَوْتُ من الحبِّ","سَقَاني نَوَاكُمْ كأسَ فُرْقَى",58,"ق",2,0],["كلَّما قُلت قد تبرّد قلبي","نظرةٌ منه زاد قلبي استعارُهْ",59,"ر",2,0],["كلّما قيل الرحيلُ قريبٌ","غَصَّ بالبادر حَلْقى اغتصاصا",60,"ص",2,0],["كُلَّما قُلْتُ قَدْ تَسَلَّيْتُ عَنْهُ","قَالَ صَبْري وَهِمْتَ فِيما تَقُولُ",61,"ل",1,0],["كُلَّما قُلتُ لَهُ ذا سَرَفٌ","في التَّعدّي قالَ لي هَذا اِقتِصادي",62,"د",2,0],["كلَّما قلتُ سرَّ قَلبي الحزينُ","ثارَ مِن عسكرِ الهموم كمينُ",63,"ن",1,1],["كلّما قيل دام خيرُك قال ال","جُودُ آمِينَ رغبةً أن يدوما",64,"م",2,0],["كلما قلت شاب دمعي مني","شب نار الغرام في احشائي",65,"ا",2,0],["كلما قلت غاب عني دجاها","