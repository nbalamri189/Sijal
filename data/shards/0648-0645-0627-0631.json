",""]],"verses":[["وَما رَفَعَ الحَجِجُ إِلى المُصَلّى","يَجُرّونَ المَطِيَّ عَلى وَجاها",0,"ا",3,0],["وَما رَدَّ شِعبَ المَأزَمَينِ عَلى مِنىً","وَجَمعٍ وَما وارى السِتارُ المُحَرَّمُ",1,"م",1,0],["وَما رَأى الراؤونَ مِن قَبلِها","زَرعاً ذَوى مِن قَبلِ أَن يُبقِلا",2,"ل",2,0],["وَما راقَني مِمَّن أَوَدُّ تَمَلُّقٌ","وَلا غَرَّني مِمَّن أَحِبُّ وِصالُ",3,"ل",1,0],["وَمارِناً لَم يَزَل لَهُ ظُبَةٌ","يَجدَعُ أَعناقَ حَيِّ مَن جَدَعَه",4,"ع",2,0],["وَما رَدَّ الزَمانُ عَليكَ حِفظاً","مِنَ الأَملاكِ وَالمالِ المُضاعِ",5,"ع",1,0],["وَما رَوَّعتُ مِن جَزَعٍ جَناناً","وَلا رَوَّيتُ مِن دَمعٍ جَنابا",6,"ب",2,0],["وَما راقَتِ الأَعيادُ إِلّا بِغُرَّةٍ","تَبَلَّجُ عَن نورٍ مِنَ المَجدِ ثاقِبِ",7,"ب",1,0],["وما راقَبَتْها عُصبَةٌ عامِريّةٌ","تُزَرُّ على أُسْدِ العَرينِ جُيوبُها",8,"ب",3,0],["وما رَوْضَةٌ حَلَّ الرّبيعُ نِطاقَها","وجَرَّتْ بِها الأنْواءُ حاشِيَةَ البُرْدِ",9,"د",1,0],["وما رَوْضَةٌ تَشْفي الجَنوبُ غَليلَها","بذي وَطَفٍ من غائِرِ المُزْنِ مُنجِدِ",10,"د",1,0],["وَما راعَني يَومَ الطِعانِ زُهوقُهُ","إِلَيَّ بِمَن بِالزَعفَرانِ تَضَرَّجوا",11,"ج",3,0],["وَما راعَ قَومي غَيرُ قَولِ اِبنِ ظالِمٍ","وَكانَ خَبيثاً قَولُهُ قَولَ ماكِرِ",12,"ر",1,0],["وَما رَدُّ الأَعِنَّةِ غَيرُ عَبدٍ","وَنارُ الحَربِ تَشتَعِلُ اِشتِعالا",13,"ل",2,0],["وَمَا رَاعَ مَلْكَ الرُّومِ إِلاَّ طُلُوعُهَا","سَوَابِحَ تُزْجِيَها رِيَاحٌ مِنَ الرَّكْضِ",14,"ض",1,0],["وَمَا رَأَى يَامُنَى نَفْسِي وَبُغْيَتَهَا","إِنْسَانُ عَيْنِي لَمَّا غِبْت أَعْيَانَا",15,"ن",2,0],["وما رِيءَ منْ مثْلٍ لهُ يوْمَ زينَةٍ","كأنّ نَضيرَ الزّهْر راقَ بهِ الزّهْرُ",16,"ر",1,0],["وما رَجُلُ الدّنْيا سوى متَقَطِّنٍ","لنَكْرانِها ماضٍ مَضاءَ المُهَنَّدِ",17,"د",1,0],["وما راعَ مَلْكَ الرّومِ إلا طُلوعُها","بَوارِقَ تُدْعَى بالمُطهّمَةِ الجُرْدِ",18,"د",1,0],["وَمَا رَاعَنِي وَالدَّهْرُ رَبُّ وَقَائِعٍ","سِجَالٍ عَلَى أَبْنَائِهِ وَغِلاَبِ",19,"ب",1,0],["وَما رَجُلٌ لا يَقتَفي بِكَلامِهِ","بِموفٍ بِميثاقٍ عَليهِ وَلا عَهدِ",20,"د",1,0],["وَما رائِحٌ رَوَّحَتهُ الجَنوبُ","يُرَوّي الزُروعَ وَيَعلو الدِيارا",21,"ر",2,0],["وَمارِدٌ مِن غُواةِ الجِنِّ يَحرُسُها","ذو نيقَةٍ مُستَعِدٌّ دونَها تَرَقا",22,"ق",2,0],["وَما رَدّي عَلى الواشينَ إِلّا","رَضيتُ بِجَورِ مالِكَتي رَضيتُ",23,"ت",1,0],["وَما رَوضَةٌ بالحُزنِ ظاهِرَةُ الثَرى","قِفارٍ تَعالى طَيِّبِ النَبتِ عازِبِ",24,"ب",1,0],["وما راعه إلاّ حسامٌ وعزمةٌ","يضيئان في ليل الخطوب الدَّواجيا",25,"ي",2,0],["وما رزفلت فيها غير جانٍ","يزوّر في إطالتها المُيونا",26,"ن",2,0],["وما رحت أستشفي القلوب مداوياً","من الحِقد إلاّ عدت عنها كما هيا",27,"ي",2,0],["وما ركنت إلى الدنيا وزخرفها","ولا أردت بها جاهاً ولا مالا",28,"ل",2,0],["وَما رَضِيَت تَيمِيَّةٌ دينَ مُسلِمٍ","وَلَكِن عَلى دينِ اِبنِ أَلغَزَ دينُها",29,"ن",3,0],["وَما رامَ الأُخَيطِلُ مِن صَفاتي","وَقَد صَدَّعتُ صَخرَةَ مَن أُرادي",30,"ي",1,0],["وَما رَهطُ الأُخَيطِلِ إِذ دَعاهُم","بِغُرٍّ بِالعَشِيِّ وَلا جِعادِ",30,"د",1,0],["وَما رَضيتُم لِأَجسادٍ تُحَرِّقُهُم","في النارِ إِذ حَرَّقَت أَرواحَهُم سَقَرُ",31,"ر",1,0],["وَما راحَ فيها يَشكُرِيٌّ وَلا غَدا","لِذُهلٍ وَتَيمِ اللَهِ رَأسٌ مُشايِعُ",32,"ع",1,0],["وَما رَدَّ قَومُ الحَوفَزانِ عَلَيكُمُ","ظُلامى وَما قالوا لِصاحِبِهِم مَهلا",33,"ل",2,0],["وَما رَغِبوا في صِهرِ آلِ مُجاشِعٍ","وَما إِن رَأوا شَكلَ القُيونِ لَهُم شَكلا",33,"ل",2,0],["وما رحلت حتى رأت فيه كلماً","تمنَّت فليس من حمام تروع",34,"ع",1,0],["وما روضة بالحزنِ مخضلَّة الربى","مكاثرة زهر النجوم بنجمها",35,"م",3,0],["وما روضة خاطت بها إبرة الحيا","من الودق ثوباً علق الوشي مسبلا",36,"ل",2,0],["وما رَمَيْتُكَ من وُدِّي بخاطئةٍ","مِنِّي ولا فَلْتَةٍ عن غير تَسْدِيدِ",37,"د",1,0],["وما رفدُك المحمودُ من رفْد رافدٍ","تُعَدُّ عيوبٌ جمَّةٌ في رفُودِهِ",38,"د",2,0],["وما راحتي في طرحهِ ثقلَ أنفه","وما دَركي في أن يُفكّ من الأسر",39,"ر",1,0],["وما رمتك يد بالحظ خاطئةٌ","كلا لعمري وما أعطتك إسرافا",40,"ف",2,0],["وما رأى الناس أمراً أنت صاحبه","ظهراً تبدل بالإسراج إيكافا",40,"ف",2,0],["وما رجا فضله راجٍ فأخلفه","ولا تمنّاه إلا قالَ قد حصلا",41,"ل",2,0],["وما رميتَ ونبلُ القوم طائشةٌ","إلّا أصبتَ وإلا قيلَ لا شللا",41,"ل",2,0],["وما راحةُ المرزوءِ في زرءِ غيره","أيحمل عنه بعضَ ما يتحمَّلُ",42,"ل",1,0],["وما راحةُ المرزوءِ في رُزءِ غيره","أمُشرِكُهُ في حمل ما قد تحملا",43,"ل",2,1],["وَما رِمتُمُ البَطحاءَ حَتّى رَدَدتُمُ","هِجانَ اِبنِ حَربٍ وَالشَآمِيَّةَ الصُفرا",44,"ر",2,0],["وما راقني ممن تقدم عهدهم","سوى الصدق ان الصدق اجمل سربال",45,"ل",1,0],["وما رأت العيون أجل منها","على أجزاء هيكله اطلاعا",46,"ع",2,0],["وما رأيت على علمي وتجربتي","كالموت جدا ولا ما قبله لعبا",47,"ب",2,0],["وما رأت لك سيفا تستضىء به","يوم القتال ولا وجها يحييها",48,"ي",3,0],["وما رشاديَ إلا لمع بارقة","يرام فيه ويُقضَى للعلى أرب",49,"ب",1,0],["وَما راعَهُم غَيرُ رَأسِ الرِجالِ","عَلى هَيكَلٍ مِن ذَواتِ الظُفُر",50,"ر",1,0],["وَما راعَني إِلّا لِواءٌ مُخَضَّبٌ","هُنالِكَ يَحميهِ بَنانٌ مُخَضَّبُ",51,"ب",1,0],["وَما ريحُ الرِياضِ لَها وَلَكِن","كَساها دَفنُهُم في التُربِ طيبا",52,"ب",2,0],["وَما رَغبَتي في عَسجَدٍ أَستَفيدُهُ","وَلَكِنَّها في مَفخَرٍ أَستَجِدُّهُ",53,"د",2,0],["وَما رَبَّةُ القُرطِ المَليحِ مَكانُهُ","بِأَجزَعَ مِن رَبِّ الحُسامِ المُصَمِّمِ",54,"م",1,0],["وما رام إغماضه جابر","وهوّل فيه كما هوَلوا",55,"ل",3,0],["وما رَبِحتْ في الودِّ صفقةُ كَارهٍ","مجاملةَ الإخوانِ يعتدُّها غبنا",56,"ن",2,0],["وما رأتْ في غِطاء الغرب أيديَها","حتى رأتْ فوق مثواها مساعِيكا",57,"ك",2,0],["وما راعَنِي هُدرُ الفَحالةِ قبلَكُمْ","فأرتاعُ من رزِّ البكارة تفلخُ",58,"خ",1,0],["وما راع أهلَ الشامِ إلا طلاعها","رقاقُ الظُّبَى والمقرَباتُ اليعابيبُ",59,"ب",1,0],["وما راعَهمْ إلا شمائلُ ماجدٍ","طَروبٍ أَلا إنَّ الكريمَ طروبُ",60,"ب",1,0],["وَما رَأَيناكَ إِلّا بانِياً شَرَفاً","أَو فاعِلاً حَسَناً أَو قائِلاً سَدَدا",61,"د",2,0],["وَما رُمتُ مِنهُم جانِباً فَوَجَدتُهُ","مَنيعاً وَلا أَعمَلتُ في صَعبِهِم جُهدي",62,"ي",1,0],["وَما رَغَثانُكَ الجَهمُ بنُ بَدرٍ","مِنَ الأَقمارِ ثُمَّ وَلا البُدورِ",63,"ر",1,0],["وَما رامَ مَسعاكَ اِمرُؤٌ في اِرتِقائِهِ","إِلى سُؤدُدٍ إِلّا تَغَوَّلَهُ بُهرُ",64,"ر",1,0],["وَما رَشَّحَت شَيبانُ فَضلَ عَطائِهِ","بَلِ البَحرُ غَطّى الراسِياتِ غُطامِطُه",65,"ط",2,0],["وَما رامَ ضَرّي يَومَ ذاكَ وَإِنَّما","أَراغَ اِمرُؤٌ حُرٌّ مَكانَ اِنتِفاعِهِ",66,"ع",2,0],["وَما رَأَيتَ المِرّيخَ قَد حاسَدَ ال","زُهرَةَ في الحَدِّ مِنهُ وَالشَرَفِ",67,"ف",1,0],["وَما رُبَّما بَل كُلَّما عَنَّ ذِكرُها","بَكَيتَ فَأَبكَيتَ الحَمامَ المُطَوَّقا",68,"ق",2,0],["وَما راحَت بِهِ النَكباءُ حَتّى","دَعا داعي المَكارِمِ بِالرَحيلِ",69,"ل",1,0],["وَما رَدَّ صَرفَ الدَهرِ مِثلُ مُهَذَّبٍ","أَبى الدَهرُ أَن يَأتي لَهُ بِشَبيهِ",70,"ي",2,0],["وَما رُهِنَت عَن قَومِها مِن يَدِ اِمرِئٍ","نِزارِيَّةٍ أَغنَت لَها كَغَنائِها",71,"ا",3,0],["وَما رُمتُ مِن حَيٍّ لِأَثأَرُ فيهُمُ","مِنَ الناسِ إِلّا ذَلَّ تَحتي رِقابُها",72,"ب",3,0],["وَما راعَ مَنعِيّاً لَهُ مِن أَخٍ لَهُ","وَلا اِبنٍ مِنَ الأَقوامِ مِثلاهُما مَعا",73,"ع",2,0],["وَما رُفِعَت إِلّا أَمامَ جَماعَةٍ","عَلى مِثلِهِ حَزماً عِمادُ السُرادِقِ",74,"ق",1,0],["ومارِقَةٍ مَرْقَ السِّهامِ تَضُمُّها","قَرارَةُ مَسجورٍ طمَى ثم عَرمَضا",75,"ض",2,1],["وما رأى الناسُ سَبْياً مثلَ سَبْيِهِما","بِيعَتْ نفَيسَتُه ظُلماً بدينارِ",76,"ر",1,0],["وما رأيتُم شُجاعاً قبلَ رؤيَتِه","قَراكُمُ وهو مُودٍ شَهْدَ مُشتارِ",76,"ر",1,0],["وَما رَأى البُؤسَ أَفواجُ العُفاةِ وَقَد","حَلَّت بِرَبعِكَ إِلّا حالَ أَو حادا",77,"د",2,0],["وَما رَمِدَت عَيناكَ إِلّا لِفَرطِ ما","أَصَرَّ عَلى كَسرِ القُلوبِ اِنكِسارُها",78,"ه",2,1],["وَما رَجاني اِمرُؤٌ إِلّا بَذَلتُ لَهُ","جوداً عَنِ الشُكرِ أَو شُكراً عَنِ الجودِ",79,"د",1,0],["وما راعَ قلبي منك إلا فراشةٌ","من الدمعِ حامت فوق عرشٍ من الوردِ",80,"د",1,0],["وما رأيْتُ أُسوداً قبلهم فَتَحَتْ","مدائناً نازَلَتْها وهي في الأجُمِ",81,"م",1,0],["وَما رَأى ناظِرٌ مِن قَبلِهِ أَسَداً","قَد أَكملَ اللّهُ فيه الخَلْقَ والخُلُقا",82,"ق",2,0],["وما رأيْتُ مهاةً قبلها وُصِفَتْ","في السرب بالشمَم المعشوق لا الخَنَسِ",83,"س",1,0],["وما روضةٌ حيّ ثرى أقحوانِها","يضاحكُها في الغيم سِنّ من الضِّحّ",84,"ح",1,1],["وَما راغِبٌ أَسرى إِلَيكَ بِراغِبٍ","وَلا سائِلٌ أَمَّ الخَليفَةَ سائِلُ",85,"ل",1,0],["وَما رَبعُ القَطيعَةِ لي بِرَبعٍ","وَلا نادي الأَذى مِنّي بِنادِ",86,"د",1,0],["وَما رَواهُ لَهُ كَهلٌ بِصَومَعَةٍ","مِنَ الرَّهابينِ عَن أَسلافِهِ القُدُمِ",87,"م",1,0],["وَمَا رَتَّلَ المُخْلِصُونَ الدُّعَاةُ","من \" مُرْسِلِينَ \" ومنْ \"سُجَّعِ\"",88,"ع",1,0],["وَما رَأى القَلبُ مِن شَيءٍ يُسِرُّ بِهِ","مُذ بانَ مَنزِلُكُم مِنّا وَما ثَلِجا",89,"ج",2,0],["وَما رَفَلَت في قَميصِ الظَلامِ","وَلا اِشتَمَلَت بِرِداءِ الغَسَق",90,"ق",1,0],["وَما راعَني إِلّا تَبَسُّمُ شَيبَةٍ","نَكَرتُ لَها وَجهَ الفَتاةِ تَجَهُّما",91,"م",2,0],["وَما راعَ وَقعُ السَيفِ وَالحَربُ تَلتَظي","كَما راعَ وَقعُ الدَمعِ وَالبَينُ يَأفَدُ",92,"د",1,0],["وما رَغِبَ المأمونُ فيها هَديَّةً","كساكَ بها البُرْدَ الذي أنت سَاحِبُ",93,"ب",1,0],["وَما رَضيتَ لَهُم حَتّى رَفَدتَهُمُ","مِن وائِلٍ رَهطِ بِسطامٍ بِأَصرامِ",94,"م",1,0],["وَما رَأى الراؤونَ مِثلَ الشَجَرَه","ذاتَ غُصونٍ مورِقاتٍ مُثمِرَه",95,"ه",1,0],["وَما راعَهُ إِلّا أَسُنَّةُ عَسكَرٍ","كَظُلمَةِ لَيلٍ نُقِّبَت بِنُجومِ",96,"م",1,0],["وَما رَدَّ حُجّابُها وافِداً","لَنا إِذ وَقَفنا بِأَبوابِها",97,"ب",3,0],["وَما رَأَى العَبْدُ لهُ مَخْلَصاً","إِلَّا وما في عِينِهِ قَطرَه",98,"ر",2,0],["وما رُكزَتْ في جوّها قبلك القَنا","ولا ركَضَتْ فيها المسوَّمةُ الجُرد",99,"د",1,0],["وما راعَ مَلْكَ الرّوم إلاّ اطّلاعُها","تُنَشَّرُ أعْلامٌ لها وبنُود",100,"د",1,0],["وما راعَ ذاتَ الدَّلّ إلاّ مُعَرَّسي","ومُلْقى نِجادي والجُلالُ المنوَّخُ",101,"خ",1,0],["وما راعهمْ إلاّ سُرادقُ جعفرٍ","تحُفُّ به أُسْدُ اللّقاءِ الدّلاهِث",102,"ث",1,0],["وما رَاعَني إلاّ ابنُ وَرقاءَ هاتِفٌ","بعينَيْهِ جَمرٌ من ضلوعيَ مشبوب",103,"ب",1,0],["وَما راحَ مِثلي في العِقابِ وَلا غَدا","لِمُستَكبِرٍ في ناظِريهِ عَداءُ",104,"ا",2,0],["وَما رَأَيتُكَ إِلّا نَظرَةً عَرَضَت","يَومَ النِمارَةِ وَالمَأمورُ مَأمورُ",105,"ر",1,0],["وَما رَوِيتَ بِعَذبٍ حَلَّ في قُلُبٍ","حَتّى تَكَلَّفتَ إِعناتاً وَتَعذيبا",106,"ب",2,0],["وَما رَقَصوا حِذاراً مِن إِلهٍ","وَلا يَبغونَ إِلّا ما حَمَيتِ",107,"ت",1,0],["وَما رَأَينا صُروفَ الدَهرِ تارِكَةً","لَيثاً بِتَرجٍ وَلا ظَبياً بِفِرتاجِ",108,"ج",1,0],["وَمارِس بِحُسنِ الصَبرِ بِلِواكَ إِن هُمُ","أَتوا بِقَبيحٍ فَالَّذي جِئتَ أَقبَحُ",109,"ح",1,0],["وَما رَبَحُ الدُنيا بِمَمكِنِ تاجِرٍ","عَلى حالَةٍ بَل كُلُّ أَعمالِها خُسرُ",110,"ر",1,0],["وَما رَجَعَت يَوماً إِلى عُقرِ دارِها","وَكانَ بِكَفَّي ذَلِكَ السَهمِ عَقرُها",111,"ر",3,0],["وَما رَقَّت وَلا رَثَتِ اللَيالي","مِنَ السَرحانِ لِلأَظبي الغَريرَه",112,"ر",2,0],["وَما رُتباتُهُم إِلّا غُروبٌ","دَوائِبُ في طُلوعٍ وَاِنحِدارِ",113,"ر",1,0],["وَما رَفُّ الكِعابِ سِوى عَناءٍ","وَإِن عُنِيَت لِمَسواكٍ بِرَفِّ",114,"ف",1,0],["وَما رَدَّ عَن آلِ السِماكِ سِلاحَهُ","وَلا كَفَّ عَنهُ المَوتُ إِن قيلَ أَعزَلُ",115,"ل",1,0],["وَما رَضيت رَضوى مِنَ الدَهرِ حُكمَهُ","وَإِن كانَ سَلمى غَيرَ مَرزوقَةٍ سِلما",116,"م",2,0],["وَما رابَها مِن رِيبَةٍ غَيرَ أَنَّها","رَأَت لِمَّتِي شابَت وَشابَ لِداتِيا",117,"ي",2,0],["وما رَوضةٌ بالحَزْنِ حاكَ لها النَّدى","بُروداً مِنَ الموْشِيِّ حُمرَ الشقائقِ",118,"ق",1,1],["وما رابني فيه الشهادة وحدها","ولكنما ريب الشهادة والغيب",119,"ب",1,0],["وَما رغبتي في الروض والروض قاحل","وَقَد طارَ عنه العندليب وأبعدا",120,"د",2,0],["وَما رأَيتَ بما قد عشت من عمر","كالمَوت سيلاً لمن لاقاه يجترف",121,"ف",1,0],["وَما رابَني إلا غرارة فتية","تؤمل إصلاحا وَلا تتأمل",122,"ل",1,0],["وما راتجفت بجنح الليل إلاّ","لتضحك فيه مما يزعمونا",123,"ن",2,0],["وما رَقَدَتْ عَنْسي ولكنْ سَما لَها","طُرُوقاً فأعْداها سَنًي مُتَناعِس",124,"س",1,0],["وما رأي المنبر من عطفي ملك","كابن أبي سفيان أو عبد الملك",125,"ك",1,0],["وما رمْتُهَا حتَّى حطَطْتُ رِحالَهَا","على ملك منهم أَغَرَّ حُلاحِلِ",126,"ل",1,0],["وما رأَى النَّاسُ على ما مَضَى","مِن قَبْلِهِ قِرْداً بقَرْنَينِ",127,"ن",1,0],["وَما رَوضَةٌ يُهدي النسيمُ أَريجَها","مَحا عَن ثَراها القَطْرُ سَيِّئةَ المَحلِ",128,"ل",1,0],["وَما رَوضَةٌ جادَ السِماكُ فُروجَها","لَها حَنوَةٌ بَينَ الحُزونَةِ وَالسَهلِ",129,"ل",1,0],["وما رفعت لنا الدرجاتُ شأنًا","كلانا من شُعاع الشمس أشهرَ",130,"ر",1,0],["وما رجل الدنيا سوى متفطن","لنكرائها ماض مضاء المهند",131,"د",1,0],["وما ريء من مثل له يوم زينة","كأن نضيد الزهر راق به الزهر",132,"ر",1,0],["وما راعها من قبلِ ذاك شغورُ","فللهِ سلطانُ البسيطة ِ إنهُ",133,"ه",1,0],["وما رفع الدُّستورُ حيفاً وإنما","أتونا به للنَّهْب ألطفَ سَلَم",134,"م",1,0],["وما رأيتُ كمعروفٍ يُجاد به","بيين الرجال وبين الله من سبب",135,"ب",1,0],["وَمَا رَأيْنَاكَ، إلاّ بانِياً شَرَفاً،","وَفَاعِلاً حَسَناً، أوْ قَائِلاً سَدَدَا",136,"د",2,0],["وَما رَأيتَ المِرّيخَ قَدْ جاسَدَ ال","زُّهْرَةَ في الحَدّ مِنْهُ، وَالشّرَفِ",137,"ف",1,0],["وَما رَغَشَانُكَ الجَهْمَ بنَ بَدْرٍ","مِنَ الأقْمَارِ، ثمّ، وَلا البدورِ",138,"ر",1,0],["وما رَوِيتَ بعذبٍ، حلّ قل قُلُبٍ،","حتى تكلّفتَ إعناتاً وتعذيبا",139,"ب",2,0],["وَما رُهِنتْ عن قوْمِها من يَدِ امرِىءٍ","نِزَارِيّةٍ أغْنَتْ لهَا كَغَنَائِها",140,"ا",3,0],["وما راحة ُ المرزوءِ في رزءِ غيره","أيحمل عنه بعضَ ما يتحمَّلُ",141,"ل",1,0],["وما رأى القلبُ من شيءٍ يسرّ بهِ،","مُذْ بانَ مَنْزِلُكُمْ مِنّا وَلا ثَلِجا",142,"ج",2,0],["وما راعَ قومي غيرُ قولي ابن ظالمٍ","وكان خبيثاً قولهُ قول ماكر",143,"ر",1,0],["وما راعني يومَ الطعانِ دهاقهُ","إليَ مثلٍ منْ بالزعفرانِ نضرِّجُ",144,"ج",1,0]]}