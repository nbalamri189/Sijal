{"poems":[[74,"حاشا لوعدك أن يلويه نسيان","https://www.aldiwan.net/poem20287.html","البسيط"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[80,"أنفحة الروض رقت في صبا السحر","https://www.aldiwan.net/poem14182.html","البسيط"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54653","الكامل"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[113,"ما أحمل القلب للبلوى واصبره","https://www.aldiwan.net/poem16290.html","البسيط"],[119,"يا من ولهت به والقلب طار له","https://www.aldiwan.net/poem40936.html","عموديه"],[121,"سافر","https://www.aldiwan.net/poem24065.html","السريع"],[170,"فترت لواحظك المراض ولم تزل","https://www.aldiwan.net/poem46900.html","الكامل"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[382,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[398,"يا من وهبت له روحي فعذبها","https://www.aldiwan.net/poem53479.html","الوافر"],[406,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[438,"يا من وهبت لوجهه","https://www.aldiwan.net/poem12703.html","مجزوء الكامل"],[473,"يا من وفيت وما وفى","https://www.aldiwan.net/poem59854.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120080","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65025","المتدارك"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145101","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125425","الكامل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76910","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198478","الكامل"],[2782,"","https://poetry.dctabudhabi.ae/diwan/poem/144339","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100841","البسيط"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56462","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108273","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133253","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95373","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102948","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33408","الكامل"],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[4778,"يا من وداده في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=193948",""],[4856,"كوفية الياسر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=36096",""],[4888,"معراج عشقي .. (في حب الرسول)","https://www.poetsgate.com/ViewPoem.aspx?id=207773",""],[4955,"يامن وشيت بسر كنت تحفظه","https://www.poetsgate.com/ViewPoem.aspx?id=195101",""],[4968,"حسبي وحسبك","https://www.poetsgate.com/ViewPoem.aspx?id=206759",""],[4981,"نجوى إلى الحَجِيج","https://www.poetsgate.com/ViewPoem.aspx?id=190676",""],[5001,"في مدح النبي صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=176233",""],[5127,"وقفتْ ومدمعُها على اﻷجفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=177316",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5139,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=68955",""],[5338,"القلب شوقا للقاء طموح","https://www.poetsgate.com/ViewPoem.aspx?id=187677",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5419,"قرأت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=32231",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5442,"يامن وقفت بباب مسجده وقد","https://www.poetsgate.com/ViewPoem.aspx?id=114751",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5612,"في يوم عيد الحج","https://www.poetsgate.com/ViewPoem.aspx?id=199230",""],[5615,"إلى أخرق .....!","https://www.poetsgate.com/ViewPoem.aspx?id=196994",""],[5688,"قالت حبيبتي:","https://www.poetsgate.com/ViewPoem.aspx?id=200940",""],[402,"يا ويح فاقدة عزيزا لا يرى","https://www.poetsgate.com/ViewPoem.aspx?id=35331",""],[5790,"أصبحت بقعر حفرتي مرتهنا","https://www.poetsgate.com/ViewPoem.aspx?id=111967",""],[5829,"الكون يختصر","https://www.poetsgate.com/ViewPoem.aspx?id=187193",""],[5830,"كَتبْتُ شِعْرِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=201124",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5956,"أسترحم اليومَ يا إيهابُ نخوتكم","https://www.poetsgate.com/ViewPoem.aspx?id=205421",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[5957,"يا من وهذا القلب مأواهُ","https://www.poetsgate.com/ViewPoem.aspx?id=177512",""],[5975,"هج بالبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=27091",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6198,"عيناكِ أسطورتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79269&r=&rc=43",""]],"verses":[["يا من وقفت عليه العين ساهرة","أقسمت لا صدّ عيني عنك إنسان",0,"ن",1,0],["يا مَنْ وجدناهُ فرداً في سياسته","إن صالَ عدَّل ميلاً أو قضى عدلا",1,"ل",2,0],["يا مَن وَلائي فيهِ نَصٌّ بَيِّنٌ","وَالنَصُّ عِندَ القَومِ لَن يَتَأَوَّلا",2,"ل",2,0],["يا مَن وَرَدتُ الوَفاءَ الغَمر مرتوياً","مِن عهدهِ إِذ يُساقى الناسُ بالغُمَرِ",3,"ر",1,0],["يَا مَنْ وَصَلْتَ إلى بَابِ الإلهِ لِكَي","تَقُولَ للخَلْقِ هَذَا البَابُ مَا وُصِدَا",4,"د",2,0],["يا من وجدنا الجودَ من بذله","مِلءَ الأماني وعدمنا العدم",5,"م",1,0],["يا مَن وصفتَ لنا الحياةَ رشيدةً","ماذا ترى من حكمةٍ ورشادِ",6,"د",1,0],["يَا مَنْ وَقَفْتُ عَلَيْهِ مُنْذُ فِرَاقِهِ","رَمَقاً تَمَاسَكَ فِي فُؤَادٍ ذَائِبِ",7,"ب",1,0],["يا مَنْ وهبْتُم لنا أمْنًا نعيشُ به","عَفْوًا، ألاَ يملِكُ الإنسانُ ما يَهَب؟",8,"ب",1,0],["يا من وقته السحاب الحر تابعة","لذاته في حلول الركب والسفر",9,"ر",1,0],["يا مَن وَهَبتُ لَهُ قَلبي فَانكرني","مِن بَعد مَعرِفَتي ظُلماً وَانكرهُ",10,"ر",2,0],["يا من ولهت به والقلب طار له","والروح تاخذها من ذكره الفكر",11,"ر",1,1],["يا مَنْ وَهَبْتَ الشّمسَ إشراقَها","وأنتَ أَزهى مِن جَبينِ القَمَرْ",12,"ر",1,0],["يا مَنْ وَفاتي في فواتِ وِصالهِ","فُتَّ الحسانَ فَواتِ قبلَ فَواتِكا",13,"ك",2,0],["يا من وسعَتنا رحمتُهُ","مذ كنّا في طور النُّطَف",14,"ف",1,0],["يا من ولدت لأجلنا حَمَلاً أتى","لفدائنا حيناً وهوْ مقتول",15,"ل",1,0],["يا مَن وَهَبتُ لَهُ روحي فَعَذَّبَها","وَرُمتُ تَخليصَها مِنهُ فَلَم أُطِقِ",16,"ق",1,1],["يا من وقفتُمْ على أفواهِ أوديةٍ","سدّتْ بردمٍ وترصيفٍ وبنيانِ",17,"ن",1,0],["يا من وهبتُ لوجهه","نفسي وتلك له قليلَهْ",18,"ل",2,1],["يا مَن وَفَيتُ وَما وَفى","وَوَصلتُهُ لِما جَفا",19,"ف",2,1],["يا من ورد منه خد","واهتز هز الغصن قد",20,"د",1,1],["يا من وفى في الجب يو","سف إذ دعا وله عضد",21,"د",1,0],["يا من وقى عيسى المسيح","من اليهود ذوي الحسد",21,"د",1,0],["يا مَنْ وَجْدي فِيْهمْ يَقْوَى","مَغْنَى صَبْري عنكُمْ أَقْوى",22,"ق",3,1],["يا مَنْ وصفت جلمدًا بالهشّ","اِنطحه يشهدْ عمرك المُوَلِّي",23,"ي",1,0],["يا من وجوهُهم مصابحُ للهدى","وأكفُّهم في الجودِ سحبُ الجود",24,"د",1,0],["يا من وهبتك عن رضاءِ مهجتي","ودمي وروحي والكرى هنيني",25,"ن",2,0],["يا من وَفيتُ له بِمي","ثاقِ الوداد فَما وفى لي",26,"ل",2,0],["يامنْ وقفتَ لدى الكُوَيْتِ مدافِعاً","ومُجابِهاً للإثْمِ والعُدوانِ",27,"ن",1,0],["يا مَنْ وهبتُ له قلبي فعذَّبَه","وما اعتراني على إِعطائه ندم",28,"م",1,0],["يا من وليت وقد الفى بشائرنا","تدعو له بعلاء غير متنقل",29,"ل",1,0],["يا من وَضَعْتُ لَهُ خَدِّي فَذَلَّلهُ","وَلَيْس فَوْقي سِوى الرَّحمنِ سُلْطانُ",30,"ن",1,0],["يا من ودِدتُ مدى الليالي قربهم","حتى غضبت على الزمان المبعدِ",31,"د",1,0],["يا من وجودك للأنام ضمانة","من كل مكروه ألم فخوّفا",32,"ف",2,0],["يا من وردنا البارد العذب من","جدواه بعد المنهل الطرق",33,"ق",1,0],["يا من وقى بغداد كل كريهة","ظفرت بأي وقاية بغداد",34,"د",1,0],["يا مَنْ وجدتُ بلاغتي حَصَراً","في حَصْرِ ما يُوليهِ والعَدِّ",35,"د",1,0],["يا من وفى قلبي له وتضمنت","نفسي له مقةَ الحبيبِ وما وفى",36,"ف",2,0],["يَامَنْ وِصَالُكَ بَاتَ يُبْكِينِي دَمًا","ارْحَلْ رَجَاءً لاَ تُجِفَّ دِمَائِي",37,"ا",2,0],["يا مَن.. وأَسقُطُ في يَدَيهِ مُضَرَّجًا","بقَصِيدةٍ شَكَتِ الضَّيَاعَ فَطَالا",38,"ل",2,0],["يا من وداده في القلوب تماهى","وبعشقه أهل الغرام تباهى",39,"ا",3,1],["يا مَنْ وُلِدتِ لتَجمعي أشلاءَنا","وترفضي أنْ تُرضعي مُستسلِما",40,"م",2,0],["يا مَن وُلِدْتَ يتيمًا ثُمَّ أنتَ أبٌ","لكلِّ مُنْتَسِبٍ للدِّينِ، مُعْتَقِدِ",41,"د",1,0],["يا مَن وشيتَ بسرٍّ كنتَ تحفظُهُ","أما استطعتَ لذاكَ السِّرِّ كتمانا",42,"ن",2,1],["يَا مَنْ وَهَبْتَ شِغَافَ قَلبِي شُحْنَةََ","وَسَقَيْتَهُ مِن نَبْعِ حُبِّكَ فارْتَوَى",43,"و",2,0],["يامَن وقفتم وقفةً مشهودةً","اُدعوا الإلهَ بدمعةٍ لا تَخجلُ",44,"ل",1,0],["يا من ولدت فأشرقت بربوعنا","نفحات نورك..وانجلى الإظلام",45,"م",1,0],["يا مَنْ وقفتِ على الجفونِ بمدمعٍ","من رامَ عنكَ باتَ كالعريانِ",46,"ن",1,0],["يامن وهبت لها روحي لترحمها","فعذبتها وجدّت في تجنيها",47,"ي",3,0],["يا من وجدتُ بحيّهم ما أشتهي","هل من شبابٍ لي يُباع فيُشترى؟",48,"ر",2,0],["يَا مَنْ وَقَفتُ بِبَابِهِ مُتَذَلِّلاً","وَالذُّلُّ إِلاّ فِي حِمَاكَ قَبيحُ",49,"ح",1,0],["يامن وهبت القلب حبّك خالصاً","-صلني بحبلك فالجفاء لهيبُ",50,"ب",1,0],["يا من وهبتِ الشعر نبض حياتهِ","ومن القصائد قد جمعتِ شتاتي",51,"ت",2,0],["يامن وهبتك سائغا","ملء اللذاذة ساخنا",52,"ن",2,0],["يامن وقفت بباب مسجده وقد","قطعت ألأمن نداه وسائلي",53,"ي",1,1],["يامن وقف محتار يرقب شبابه","لايارد لدجله ولا يارد فرات",54,"ت",1,0],["يا من وقفْتَ بِساحَةِ البَرَكاتِ","ورَجوْتَ عفْوَ اللهِ في عَرَفاتِ",55,"ت",1,1],["يَا مَنْ وَقَفتَ مُكَابِرًا ، مُتَحَدِّيًا","مَنْ أَنتَ ، حَتَّى تَستَهينَ بِذَاتي ؟!",56,"ت",2,0],["يا من وهبتك حبّا غير ذي غَشَشٍ","ما شان صفوتَه شكّ ولا رِيَب",57,"ب",1,0],["يا من وقفت عليه منذ فراقه","رمقا تماسك في فؤاد ذئب",58,"ب",1,0],["يا من وسعت عباده رحمته","من بعض عبادك المسيئين أنا",59,"ن",2,0],["ﻻ يأمنون إذا ساروا وإن مكثوا","مكر القذائف أو من جاء ينتحر",60,"ر",1,0],["يَامَنْ وَعَيْتَ فَكُنْ بِالْحَرفِ مُعْتَبِراً","الْحَرْفُ سِرٌ وَمَا كَلَّتْ مَعَانِيهِ",61,"ي",2,0],["يا من وصفتَ مدائحي","كَ كما أكون مرائيا",62,"ي",2,0],["يا من وعدتم ألا تُوْفُون موعدَكم","غداً لناظرهِ يأتيك عن قرُبِ..",63,"ب",1,0],["يا مَن وأدتم داعشاً في جُحْرها","يحميكم الرحمن والقدراتُ",64,"ت",1,0],["يا من وهذا القلب مأواهُ","قل لي بربك كيف أنساهُ",65,"ا",2,0],["يا من وهبتُ لهُ روحي وفارقني","رضيتَ بالبعدِ عن خلٍّ تولاكا",66,"ك",2,0],["يا منوره بحلاها كون","يا قمر كوكب زحل",67,"ل",1,0],["يا من وضعتم قوانينا لأنفسكم","نحن اتخذنا كتاب الله قانونا",68,"ن",2,0],["يامن وقفتِ على وجدٍ... يكتّمُهُ","أما رأيتِ الذي يضنيه من سقم؟!",69,"م",1,0]]}