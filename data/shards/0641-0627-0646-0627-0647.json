{"poems":[[55,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[49,"سلي فتيات هذا الحي عني","https://www.aldiwan.net/poem25127.html","الوافر"],[30,"ألم أرم عنكم إذ عجزتم عدوكم","https://www.aldiwan.net/poem5418.html","الطويل"],[71,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[17,"عفا من آل فاطمة الخبيت","https://www.aldiwan.net/poem1192.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[128,"ما قهوة البن إن قيست بصافية","https://www.aldiwan.net/poem23759.html","البسيط"],[254,"أسائلة عميرة عن أبيها","https://www.aldiwan.net/poem2129.html","الوافر"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[518,"نصيحة يوم المهرجان هدية","https://www.aldiwan.net/poem67689.html","الطويل"],[548,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[563,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[563,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96448","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101982","البسيط"],[1814,"","https://poetry.dctabudhabi.ae/diwan/poem/28428","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11225","الوافر"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18685","الوافر"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115242","الوافر"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142582","الكامل"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132222","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3422,"","https://poetry.dctabudhabi.ae/diwan/poem/79638","الوافر"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27131","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91215","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119603","الوافر"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33067","الوافر"],[585,"تألق للدستور يوم مذهب","https://www.poetsgate.com/ViewPoem.aspx?id=161853",""],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5674,"احترقت بناري","https://www.poetsgate.com/ViewPoem.aspx?id=187319",""],[5674,"تفرقت آثاري","https://www.poetsgate.com/ViewPoem.aspx?id=195390",""],[5736,"سها","https://www.poetsgate.com/ViewPoem.aspx?id=208478",""],[6019,"إبحار في عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53055",""]],"verses":[["فَإِن أَهلِك فَعَن قَدرٍ جَرِيٍّ","وَإِن أَملِك فَقَد أَغنى طِلابي",0,"ب",2,0],["فَإِن أَهلَك فَعَن أَجَلٍ مُسَمّى","سَيَأتيني وَلَو ما بَينَكُنَّه",1,"ن",2,0],["فَإِن أَهجُ كَعباً أَو كِلاباً فَإِنَّهُم","كِلا طَرَفَيهِم لِلنَمَيرِيِّ فاضِلُه",2,"ل",2,0],["فإنْ أهلكَ الناسَ جهلٌ بهمْ","فأنتَ منَ الفرقةِ الناجيَهْ",3,"ي",2,0],["فَإِن أَهلِك فَقَد أَبلَيتُ عُذراً","وَقَضَّيتُ اللُبانَةَ وَاِشتَفَيتُ",4,"ت",1,0],["فأن أَهِلك فقد أَبلَيتُ قَومي","بَلاءً كُلُّه حَسَنٌ جَميلُ",5,"ل",1,0],["فإن آهاتهم سحر ومجلسهم","شعر وألحانهم يا شيخ تشجيني",6,"ن",2,0],["فَإِن أَهلِك عُمَيرَ فَرُبَّ زَحفٍ","يُشَبَّهُ نَقعُهُ عَدواً ضَبابا",7,"ب",2,0],["فإن أهل التحمال","بالمقضى متاعيب",8,"ب",1,0],["فإن أهد روحي أهد ما أنت ربه","وإن أهد مالي فهو مالك من قبلي",9,"ل",2,0],["فَإِن أَهلِكُ يا تَملي","فَما مِن أَحَدٍ مُخلِ",10,"ل",1,0],["فإن أهل الله نور ولن","يرى امرؤٌ نوراً بظلمائه",11,"ا",3,0],["فإن أهل الجهل قد بالغوا","في حقه بالنقص وهو الشفيقْ",12,"ق",1,0],["فَإِن أَهجُ يَربُوعاً فَإِنِّىَ لاَ أرَى","لِشَيخِهمُ الأقصَى على ناشِىءٍ فَضلاَ",13,"ل",2,0],["فإن أهل النهى شتى مراتبهم","هذا أخير وهذا أول العدد",14,"د",1,0],["فَإِن أَهلِك بِحُبِّكِ فَاِعلَميهِ","فَلَم يُفلِح أَبوكِ وَلا أَبونا",15,"ن",2,0],["فَإِن أَهلِكَ فَقَد أَبقَيتُ بَعدي","قَوافيَ تُعجِبُ المُتَمَثِّلينا",16,"ن",2,1],["فَإِن أَهلِك فَذي حَنَقٍ لَظاهُ","عَلَيّ يَكادُ يَلتَهِبُ التِهابا",17,"ب",2,0],["فإن أهلِك فهنّ لكم وإلا","فهنّ من المتاع لكم سنينا",18,"ن",2,0],["فإن أهديت لي من فيك حتفي","فإني كالذي أهديت أهدي",19,"د",2,0],["فأنا هُنَا جُرحُ الهَوَى، وَهُنَاكَ في وَطَني جراحُ","وعليكِ عَينِي يا دِمَشقُ، فمِنكِ ينهَمِرُ الصّبَاحُ",20,"ح",1,0],["فإن أهملت عدلاً فإني مهمل","وإن صادفت وقت القبول فيا سعدي",21,"د",2,0],["فَإِن أُهِنكَ فَهَذا العَبدُ أَخسأَهُ","وَإِن حُقِرتَ فأَنتَ العَبدُ تُحتَقَرُ",22,"ر",1,0],["فإِنْ أهلكْ فقدْ أورثْتُ خيرا","وقد أعظَمْتُ وصْلَ بني هلالِ",23,"ل",1,1],["فَإِن أَهلِك فَرُبَّ فَتى سَيَبكي","عَلَيَّ مُهَذَّبٍ رَخصِ البَنانِ",24,"ن",1,0],["فَإِنّ أَهنا مَساء لَيلُ مغتبقٍ","وَإِنّ أَجلى صَباحاً صبح مصطبحِ",25,"ح",1,0],["فإن أُهجى فهل أُهجى بقومي ال","أفاضل أم بجدّي واجتهادي",26,"د",2,0],["فَإِن أَهدَيتُ ذاكَ لَيَحمِلوني","عَلى نَعلٍ فَدَقَّ اللَهُ رِجلي",27,"ل",2,0],["فإن أهرقوا من أجله الدم حسبنا","مدامع من فرط المسرة تُسكب",28,"ب",1,0],["فأنا هنا بعُمانَ نصفي مُشرقٌ","والنصفُ مخفيٌ بليلِ الحُرقة",29,"ه",1,0],["فأنا هنا وأنا هناك تعددت","مني الخطا وتفرقت آثاري",30,"ر",2,0],["فأنا هنا وأنا هناك تعددت","مني الخطى وتفرقت آثاري",31,"ر",2,0],["فإن أهديتُ من أهواهُ شعرًا","فلنْ تكفي حروفٌ أو محابرْ",32,"ر",1,0],["فَأَنَا هَوَىً يَهتَزُّ تَحتَ ضِلُوعِهِ","شَوقٌ يَوَدُّ بِخَفقَتَينِ يُحَلِّقُ",33,"ق",1,0]]}