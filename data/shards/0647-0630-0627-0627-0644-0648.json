{"poems":[[79,"يا نجعة الوزراء والنواب","https://www.aldiwan.net/poem36707.html","الكامل"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[108,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[119,"هذا الولي المرتضى","https://www.aldiwan.net/poem40452.html","عموديه"],[164,"حصنت ذا الوجه الأغر","https://www.aldiwan.net/poem58781.html","مجزوء الرجز"],[164,"عاملت ربك وانتدبت خصالا","https://www.aldiwan.net/poem58816.html","الكامل"],[215,"محطة الرمل جننتني","https://www.aldiwan.net/poem46262.html","مخلع البسيط"],[228,"شبح الدموع تمضك الأتراح","https://www.aldiwan.net/poem41872.html","الكامل"],[287,"لا والمطايا ذللا في البرى","https://www.aldiwan.net/poem32765.html","السريع"],[302,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[369,"هذا الوزير الأجل","https://www.aldiwan.net/poem60684.html","المجتث"],[382,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[412,"أمن خيال هداه الشوق والحلم","https://www.aldiwan.net/poem50109.html","البسيط"],[458,"هذا الوجود كما تراه فلم يكن","https://www.aldiwan.net/poem61321.html","الكامل"],[463,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[484,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[505,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[505,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[543,"عهدي ببيت القدس وهو مقدس","https://www.aldiwan.net/poem47535.html","عموديه"],[543,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[563,"هي الحقيقة كل الكائنات لها","https://www.aldiwan.net/poem33534.html","البسيط"],[563,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[563,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[563,"بالله يا من رماني بالصد والهجران","https://www.aldiwan.net/poem33846.html","عموديه"],[563,"هذا الوجود الحقيقي الواحد الأحد","https://www.aldiwan.net/poem34570.html","البسيط"],[563,"هذا الوجود وهذا الواحد الأحد","https://www.aldiwan.net/poem34575.html","البسيط"],[563,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[567,"بشراك بالخير يا لبنان بشراكا","https://www.aldiwan.net/poem52738.html","البسيط"],[567,"جاء الصيام قرير العين مبتهجا","https://www.aldiwan.net/poem52754.html","البسيط"],[567,"أعطى محمد عزة من فضله","https://www.aldiwan.net/poem52936.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86666","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38959","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145852","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80224","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133811","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28044","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27685","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88653","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101807","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134077","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112649","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89024","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86279","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110083","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109991","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91645","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91195","الكامل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126513","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102983","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69911","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44721","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127103","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97090","المجتث"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147285","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120502","الكامل"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4782,"حكاية البدر","https://www.poetsgate.com/ViewPoem.aspx?id=206798",""],[4791,"جيش الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=37101",""],[4802,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=34355",""],[4858,"الى الام التي ترضع طفلها الحليب الصناعي","https://www.poetsgate.com/ViewPoem.aspx?id=138297",""],[4859,"ماقيمة العمر!","https://www.poetsgate.com/ViewPoem.aspx?id=197810",""],[4859,"هل وعيت!","https://www.poetsgate.com/ViewPoem.aspx?id=206931",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5033,"ما لا يُقال","https://www.poetsgate.com/ViewPoem.aspx?id=183225",""],[5060,"ابن المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=214493",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5135,"يا ربِّ لطفكَ بالعبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=211015",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5232,"وداع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213781",""],[5279,"ضَاع الحلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183787",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5805,"خربشْ","https://www.poetsgate.com/ViewPoem.aspx?id=12459",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5837,"سارعي يا بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=179452",""],[5848,"الخامس الأول","https://www.poetsgate.com/ViewPoem.aspx?id=48824",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5956,"رسالة جوابية منه لي على الوتس أب","https://www.poetsgate.com/ViewPoem.aspx?id=194394",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5956,"ودّعتُ حبَّه مِن صَوبي","https://www.poetsgate.com/ViewPoem.aspx?id=204250",""],[6008,"الجوف زانت","https://www.poetsgate.com/ViewPoem.aspx?id=60997",""],[6142,"فزعت إليك من الورى الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=155678",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""]],"verses":[["هَذَا الْوَفَاءُ يَقِلُّ مَا حُدِّثْتَهُ","مِنْ مُقْتَضٍ لِلنَّفْيِ وَالإِيجَابِ",0,"ب",1,0],["هَذا الوَليدُ رَأى التَثَبُّتَ بَعدَما","قالوا يَزيدُ بنُ المُهَلَّبِ مودِ",1,"د",1,0],["هَذَا الْوَفَاءُ وَفَاؤُهُ","فَادْعِيهِ لاَ يَتَمَنَّعِ",2,"ع",1,0],["هذا الوسامُ لعمري حِليةٌ لمعت","في صدرِ كلِّ أديب قال أو كتبا",3,"ب",2,0],["هذا الولي المرتضى","فان ترم تاريخه",4,"ه",1,1],["هذا الوزيرُ ابن الوزير","الصارم العضب الذكر",5,"ر",1,0],["هذا الوداع له وهذى ليلةٌ","عن ألف شهر قدرها قد طالا",6,"ل",2,0],["هذا الوجود الجميل نار","بدت لروحي بلا حجاب",7,"ب",1,0],["هذا الوجودُ جنينةٌ مرغوبَةٌ","قَد غَرَّ فيها آدمَ التُفّاحُ",8,"ح",1,0],["هذا الوُجودُ مشانِقٌ نُصِبَت لَنا","وَالظُلمُ في ساحاتِها السَفّاحُ",8,"ح",1,0],["هَذا الوَفاءُ المَحضُ لا ما بِهِ ال","سمَوءَل استَوجَبَ أَن يَفخَرا",9,"ر",2,0],["هَذا الوفيُّ الهاشميُّ المجتبى","غَوثُ الجَليس له وبدرُ المجلِسِ",10,"س",1,0],["هذا الوزيرُ الأجَلُّ","ما في مَطاويهِ غِلُّ",11,"ل",1,1],["هذا الوجود ومثله","يكفيه جزءٌ من عطائك",12,"ك",1,0],["هَذا الوَزير الَّذي نُعماه قَد شهدت","لَهُ البَرايا ومنه البؤس وَالنِعَمُ",13,"م",1,0],["هذا الوجود كما تراه فلم يكن","إلاه في الماضي ورهن الآتي",14,"ت",2,1],["هذا الوزير وأخوه فاسفري","قد رُدّت الشمسُ عليك والقمرْ",15,"ر",1,0],["هذا الوفاء بعينه","ما بالوفاة تصنع",16,"ع",1,0],["هذا الوظثف إذا وهذا أمره","بين البرية لم يزل منشورا",17,"ر",2,0],["هذا الوجيه الوجه عند الله بل","هذا الذي للغوث قام مدارا",18,"ر",2,0],["هذا الوُجودُ وأنت تشهَدُ شكلَهُ","منه بعينِكَ بُرْدَةٌ طَمْساءُ",19,"ا",2,0],["هذا الوجودُ على مَجلاكَ إيماءُ","وفي العَمى من سَنا معناكَ أَضْواءُ",20,"ا",2,1],["هَذا الوِفَاقُ وَهَذِه آيَاته","فَإذَا تَخَيَّبَ فَالوِفَاقُ نِفاقُ",21,"ق",1,0],["هَذا الوِفَاقُ وهَذِه آيَاتُهُ","مَا خَابَ فِي يَوم اللِّقَاءِ وِفَاقُ",22,"ق",1,0],["هذا الوجود به الأكوان قائمة","فحقق الفرق واجمع واترك الشبها",23,"ه",2,0],["هذا الوجود الحق باد على","كل التقادير بما يعتني",24,"ن",2,0],["هذا الوجود هو الحقيقيُّ الذي","نبدو به وبه نعود إلى الفنا",25,"ن",2,0],["هذا الوجود خيال وكلنا في منام","وليس يوجد إلا حقيقة الإنسانْ",26,"ن",1,0],["هذا الوجود الحقيقيْ الواحد الأحدُ","يشف عنه لدينا الروح والجسدُ",27,"د",1,1],["هذا الوجود وهذا الواحد الأحدُ","ولا يشاركه في وصفه أحدُ",28,"د",1,1],["هذا الوجود جميعه كلي بلا","شكٍّ عداةً قد حوى وحبائبا",29,"ب",2,0],["هذا الوزيرُ الذي أعتَزَّتْ بمَنصِبهِ","رُباكَ حتَّى غدَت في الأرضِ أَفلاكا",30,"ك",2,0],["هذا الوزيرُ الذي جلَّت مَهابَتُهُ","فَقِفْ لديهِ كمَنْ في الكعبْةِ اعتَكَفا",31,"ف",2,0],["هذا الوزيرُ وزيرُ سُلطانِ الوَرَى","وخليفةِ اللهِ العليِّ وظِلِّهِ",32,"ل",2,0],["هذا الوَزير الَّذي أَنسى ابن زائدة","وحاتماً بالمبرّات الجَزيلات",33,"ت",1,0],["هَذا الوَزيرُ أَبو العَوالي وَالعُلى","وَالمُرهَفات البيض وَالغاراتِ",34,"ت",1,0],["هذا الوفيُّ الفارسُ الرمحُ الذي","سيظلُّ للعهدِ الوفيَّ المؤمنا",35,"ن",2,0],["هَذا الوَداعُ سَقاهُ رَبي ما سَقا قَلبي","بِبُعدِكَ قَد طَرَحتُ غَميدا",36,"د",2,0],["هذا الوجودُ المنتَظَم","خلقتُه من العدم",37,"م",1,1],["هذا الوجودُ ومن به يتجمل","إن الحديث منا يقول الأوّلُ",38,"ل",1,1],["هذا الوجودُ الذي بالعرف نعرفه","ليس الوجودُ الذي بالكشف نعلمه",39,"م",2,1],["هَذا الوفاء وَياله شرفا","ثبتت عليه السادة النبل",40,"ل",1,0],["هذا الوفاء مع الذي أصفاكم","الود القديم وسالف الأشواق",41,"ق",1,0],["هذا الوداد سرني","بطيب وصل برني",42,"ي",1,1],["هذا الوداعُ فَمَتى اللِقاءُ","بعدَكَ لا يطيبُ لي بقاءُ",43,"ا",2,0],["هذا الوزير لفضله","وُرْقُ التهاني صدحت",44,"ت",1,1],["هذا الوَزيرُ النَدي ذاعَت مَآثِرُهُ","وَقَد سَرى ذِكرُهُ في سائِرِ الامَمِ",45,"م",1,0],["هذا الوزير الذي يملا العيون سنا","في قوم عثمان رب الطول من قدم",46,"م",1,0],["هذا الوُلوعُ الذي القاك في دَنَفٍ","غدوتَ منهُ نحيفَ الجِسم كالجَلَمِ",47,"م",1,0],["هذا الوحيدُ الفريدُ في مَلاء","بكى مُناويهِ نادباً ونَعَى",48,"ع",2,0],["هذا الوَداعُ وَلا تَلاقٍ بَيننا","إِلا ليومٍ فيهِ تَضطرِبُ الحُجَج",49,"ج",1,0],["هَذا الوَزير هوَ الَّذي","لَم يَثن حكمتَه الصلف",50,"ف",1,0],["هذا الوجود شؤون في الورى بطنت","ومن رآها كيفما اشترطا",51,"ط",2,0],["هذا الوزير وصاحب العهد الذي","ذمم المكارم عنده لن تخفرا",52,"ر",2,0],["هَذا الوَزير الَّذي دانَت لِدَولَتِهِ","هامُ المَعالي وَقَد هابتهُ امصارُ",53,"ر",1,0],["هذا الوَزيرُ الَّذي أَعيَت مَكارِمُهُ","عَن دَركِها مِن إِلى نَهجِ السِباقِ هدي",54,"د",2,0],["هَذا الوِسامُ الَّذي تَصبو القُلوب لَهُ","دَع عَنكَ أَوسِمَةً صيغت وَتيجانا",55,"ن",2,0],["هذا الوزير الذي لا عيب فيه سوى","اعطائه من نحاه فوق ما اقترحا",56,"ح",2,0],["هذا الوداع فقل لي","متى يكون التلاقي",57,"ق",2,0],["هذا الوصي الطهر لو علموا","لكنَّ حشو صدورهم غلُّ",58,"ل",1,0],["هذا الوجود مُلَغزٌ","واللغز يَكمنُ في الصفاتِ",59,"ت",1,0],["هذا الوزير المستعز بمجده","غاد يجيد له المديح ورائح",60,"ح",1,0],["هذا الوصيَّ أميرُ أبرارِ الورى","سيفٌ على تلك النفوس الخالعة",61,"ع",2,0],["هذا الوفي لعاشقيه على المدى","جبّ الغرام ومخبأ الأسرارِ",62,"ر",1,0],["هذا الورق من حربة الحبر خايف","ويحفظ لها ما تستبيحه من البوق",63,"ق",1,1],["هذا الوطن إذا حبيبي نفاني","وإذا الوطن هذا حبيبي وبوحي",64,"ح",2,0],["هذا الوليد ثمار كدّكِ أشهراً","لا تهمليه يكن لكم معوانا",65,"ن",2,0],["هذا الوجودُ به نمضي نؤمّل أن","نلقى السرورَ فتُبكينا خوافيهِ!",66,"ي",2,0],["هذا الوجود بدون قربكَ موحشٌ","والموجعات أتتْ إليّ تقول هيتْ",67,"ت",1,0],["هذا الولي الحق في تبيانه","يأنى قوياً في أعز متانة",68,"ه