{"poems":[[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[58,"تمتع بها ما ساعفتك ولا يكن","https://www.aldiwan.net/poem58459.html","الطويل"],[47,"أقول لجاهلكم إذ ملك","https://www.aldiwan.net/poem65221.html","المتقارب"],[30,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[77,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[50,"وخندريس لها شعاع","https://www.aldiwan.net/poem65100.html","مجزوء البسيط"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[119,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[136,"عوجا العناجيج حتى تسالا الطللا","https://www.aldiwan.net/poem54775.html","البسيط"],[190,"أحب الملاح بحسن الدلال","https://www.aldiwan.net/poem43740.html","المتقارب"],[234,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[254,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[366,"والله لا استطيع صدك","https://www.aldiwan.net/poem68117.html","مخلع البسيط"],[376,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[463,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[463,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[473,"وخندريس سردوسية","https://www.aldiwan.net/poem59701.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86613","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48705","السريع"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21668","المتقارب"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101833","البسيط"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71081","الطويل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101433","المجتث"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46741","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4356,"","https://poetry.dctabudhabi.ae/diwan/poem/143366","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113826","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4858,"الى حقود لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=35295",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5186,"تالله ما أنا واقف في الباب","https://www.poetsgate.com/ViewPoem.aspx?id=156550",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5493,"تاجُ اللغَات","https://www.poetsgate.com/ViewPoem.aspx?id=201747",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5943,"خنساء ورابعة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=34294",""],[1920,"حجرٌ قلبُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=191354",""],[6185,"خنجر البعد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87026&r=&rc=12",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""]],"verses":[["وخِناقٍ قد ضاق بي فتولَّى","ضِيقُهُ قَطْعَهُ فعاد رحيبا",0,"ب",2,0],["وخُنْها وإنْ كانتْ تَفِي لكَ إنّها","على قِدَمِ الأَيّامِ سوفَ تَخُونُ",1,"ن",1,0],["وَخَنَّثَ لَهجَتَهُ مُسمِعاً","بِلَفظٍ تُحَلُّ عَلَيهِ التَكَك",2,"ك",1,0],["وَخُنسٌ تَسوقُ السَخلَ كُلَّ عَشِيَّةٍ","بِداوِيَّةٍ غَبراءَ دُرمٍ حِدابُها",3,"ب",3,0],["وخنىً حالفٍ بأنّكَ ما أصْ","بحتَ يوماً لغيره بحليف",4,"ف",1,0],["وَخَندَريسٍ باكَرتُ حانَتَها","فَوَدَّجوا خَصرَها بِمِبزالِ",5,"ل",1,0],["وَخَندَريسٍ لَها شُعاعٌ","يَلمَعُ في الكَأسِ كَالضِرامِ",6,"م",1,1],["وَخِندَفُ أَقرِب بِأَنسابِهِم","وَلَكِنَّنا أَهلُ بيتٍ كُثُر",7,"ر",1,0],["وَخُنْتُ وَليَّ نِعْمَتنَا فَذَنْبي","إِلَيْهِ بقَدْر نعْمَتِهِ كَبيرُ",8,"ر",1,0],["وخنق الدمعة الحمراء","في كف الأباطيل",9,"ل",1,0],["وخنقتُ السنينَ أو ما علاها","فرأيتُ الميلادَ مَوْتاً ودَفْنا",10,"ن",2,0],["وخنت بدين الحب والله ناظر","وحاشاه ان يولي المآمل ذا غدر",11,"ر",1,0],["وخُنتُمُونَا وكَانَ الغَدرُ دَيدَنَكُم","قدما وهَيَّأتُمُ العَورَا لَنَا نُزُلا",12,"ل",2,0],["وخنث الفكاهات والمزعجات","لسرّ القلوب وما قد ظهر",13,"ر",1,0],["وخَنُوفٍ عَيْرانة عَنْتَريسٍ","عَيْسَجُور شِمِلَّة مِسيارٍ",14,"ر",1,0],["وَخِنذيذٍ تَرى الغُرمولَ مِنهُ","كَطَيِّ الرِقِّ عَلَّقَهُ التِجارُ",15,"ر",1,0],["وَخُنت عَهدي فَلَيت شِعري","هَل خُنتَ في العاشِقين عَهدَك",16,"ك",1,0],["وخنتَ وما خانَ عَهد الهَوى","أتَرضَى خِيانَةَ مَن لم يَخُن",17,"ن",1,0],["وخُن الأمانَةَ وانجُ مغتبطا","إن الوفاءَ مطيَّةُ الهمِّ",18,"م",1,0],["وخُنِّقن بالماء في خانِقِي","نَ حبّاً لما بعدَها أو قَرَمْ",19,"م",1,0],["وَخَندَريسٍ سَرَدوسِيَّةٍ","رَقَّت فَما يُدرِكُها الوَهمُ",20,"م",1,1],["وَخَنزير ثَقيل الرُوح فَظ","نَجاسته بِها وَرد الكِتاب",21,"ب",1,0],["وخنت زوجي الذي","فيه المنى والرجاء",22,"ا",2,0],["وَخِندِفِ تَخطُرُ مِن دونِنا","وِمِن ذا يَقومُ لِتَخطارِها",23,"ر",3,0],["وخندريس الهنا راقت لشاربها","في يوم عرس سليل المجتبي موسى",24,"س",2,0],["وخنفسٌ يسقى بجعلانه","يقوتها الأوراث والبعرُ",25,"ر",1,0],["وخُنتَهُمُ في أَمْرهم وَاغَتصَبْتَهم","وأَنت لهم في كلّ ذلك ظالِمُ",26,"م",1,0],["وَخُنْتَ ذِمَّةَ صَبٍّ","ما خَانَ قَطُّ ذِمَامَكْ",27,"ك",1,0],["وخندف منهم أمنا طاب ذكرها","وطابت ومنها طيبون وطيب",28,"ب",1,0],["وَخِنذيذٍ كَمَرِّيخِ المُغالي","إِذا ما خَفَّ يَعتَزِمُ اِعتِزاما",29,"م",2,0],["وخنساءُ مِخماصُ الوِشاحَيْنِ خَطْوُها","إلى الزوجِ أقتارٌ خُطى المُتجشِّمِ",30,"م",1,0],["وَخِنذيذٍ تَصيدُ الرَبدَ عَفواً","وَقُبَّ الأَخدَرِيَّةِ في الصَباحِ",31,"ح",1,0],["وخُنتَ ومأمولي وفاؤكَ ضِلَّةً","ومن مأمن الإنسان بفجؤه الأذى",32,"ذ",2,0],["وخندف كانت زوج الياس ظئرنا","وإنا بمن صفى لمن حج برئنا",33,"ن",2,0],["وخنزير ينام على فراش","تنعّم بالحرير المستطاب",34,"ب",1,0],["وخنوع المجموع للفرد قسراً","وبقاءَ الأطواق في الأَجيادِ",35,"د",1,0],["وخنقْتَ الحُبَّ حتّى","وجمَتْ كُرْهاً طيورُهْ!",36,"ر",2,0],["وخنت تراثاً للمسيح مقدساً","فكنت عدواً للمسيح وقاليا",37,"ي",2,0],["وخنوع رأس خاضع، لا خاشع","لابن الحلال المانع الوهاب",38,"ب",1,0],["وخنزير طبع في شمائل ناطق","نعم هكذا كنتم لدى من توسما",39,"م",2,0],["وخنزير طبع في شمائل ناطق","يهر على أهل الهدى بالعوى هرا",40,"ر",2,0],["وخنساءُ قدْ زفَّتْ رثاءً لصخرِها","ليبقَى مدَى التَّاريخِ تاجَ المُناضِلِ",41,"ل",1,0],["(وخنت مولاي عهدا من ألست وما )(1)","يمحو خطاياه إلا صفح مولاه",42,"ا",2,0],["وخنساءٌ بأشعارٍ","وبالأخلاقِ سامقة ٌ",43,"ه",1,0],["وخنقتِ حرفا كان يصدح ها هنا","بالشعر بين بلابلٍ وحسانِ",44,"ن",1,0],["وخِنْجَرُ بُعْدِهِ أوْدَى بِقَلْبِيْ","وَوَقْتِي بَعْدَ ذَاكَ الأُنْسِ شُلَّا",45,"ل",2,0],["وخِنْجَرُ \" التطبيعُ \" في نَصله","دمُ الضحايا والسلامُ الكسيحْ",46,"ح",1,0]]}