{"poems":[[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[56,"تمتع بها ما ساعفتك ولا يكن","https://www.aldiwan.net/poem58459.html","الطويل"],[45,"أقول لجاهلكم إذ ملك","https://www.aldiwan.net/poem65221.html","المتقارب"],[28,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[48,"وخندريس لها شعاع","https://www.aldiwan.net/poem65100.html","مجزوء البسيط"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[116,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[133,"عوجا العناجيج حتى تسالا الطللا","https://www.aldiwan.net/poem54775.html","البسيط"],[187,"أحب الملاح بحسن الدلال","https://www.aldiwan.net/poem43740.html","المتقارب"],[230,"جادك الغيث من محلة دار","https://www.aldiwan.net/poem51068.html","الخفيف"],[250,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[362,"والله لا استطيع صدك","https://www.aldiwan.net/poem68117.html","مخلع البسيط"],[372,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[459,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[459,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[469,"وخندريس سردوسية","https://www.aldiwan.net/poem59701.html","السريع"]],"verses":[["وخِناقٍ قد ضاق بي فتولَّى","ضِيقُهُ قَطْعَهُ فعاد رحيبا",0,"ب",2,0],["وخُنْها وإنْ كانتْ تَفِي لكَ إنّها","على قِدَمِ الأَيّامِ سوفَ تَخُونُ",1,"ن",1,0],["وَخَنَّثَ لَهجَتَهُ مُسمِعاً","بِلَفظٍ تُحَلُّ عَلَيهِ التَكَك",2,"ك",1,0],["وَخُنسٌ تَسوقُ السَخلَ كُلَّ عَشِيَّةٍ","بِداوِيَّةٍ غَبراءَ دُرمٍ حِدابُها",3,"ب",3,0],["وخنىً حالفٍ بأنّكَ ما أصْ","بحتَ يوماً لغيره بحليف",4,"ف",1,0],["وَخَندَريسٍ باكَرتُ حانَتَها","فَوَدَّجوا خَصرَها بِمِبزالِ",5,"ل",1,0],["وَخَندَريسٍ لَها شُعاعٌ","يَلمَعُ في الكَأسِ كَالضِرامِ",6,"م",1,1],["وَخِندَفُ أَقرِب بِأَنسابِهِم","وَلَكِنَّنا أَهلُ بيتٍ كُثُر",7,"ر",1,0],["وَخُنْتُ وَليَّ نِعْمَتنَا فَذَنْبي","إِلَيْهِ بقَدْر نعْمَتِهِ كَبيرُ",8,"ر",1,0],["وخنق الدمعة الحمراء","في كف الأباطيل",9,"ل",1,0],["وخنقتُ السنينَ أو ما علاها","فرأيتُ الميلادَ مَوْتاً ودَفْنا",10,"ن",2,0],["وخنت بدين الحب والله ناظر","وحاشاه ان يولي المآمل ذا غدر",11,"ر",1,0],["وخُنتُمُونَا وكَانَ الغَدرُ دَيدَنَكُم","قدما وهَيَّأتُمُ العَورَا لَنَا نُزُلا",12,"ل",2,0],["وخنث الفكاهات والمزعجات","لسرّ القلوب وما قد ظهر",13,"ر",1,0],["وخَنُوفٍ عَيْرانة عَنْتَريسٍ","عَيْسَجُور شِمِلَّة مِسيارٍ",14,"ر",1,0],["وَخِنذيذٍ تَرى الغُرمولَ مِنهُ","كَطَيِّ الرِقِّ عَلَّقَهُ التِجارُ",15,"ر",1,0],["وَخُنت عَهدي فَلَيت شِعري","هَل خُنتَ في العاشِقين عَهدَك",16,"ك",1,0],["وخنتَ وما خانَ عَهد الهَوى","أتَرضَى خِيانَةَ مَن لم يَخُن",17,"ن",1,0],["وخُن الأمانَةَ وانجُ مغتبطا","إن الوفاءَ مطيَّةُ الهمِّ",18,"م",1,0],["وخُنِّقن بالماء في خانِقِي","نَ حبّاً لما بعدَها أو قَرَمْ",19,"م",1,0],["وَخَندَريسٍ سَرَدوسِيَّةٍ","رَقَّت فَما يُدرِكُها الوَهمُ",20,"م",1,1]]}