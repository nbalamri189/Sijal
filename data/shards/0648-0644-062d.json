{"poems":[[53,"يا عاذلان أسأتما العذلا","https://www.aldiwan.net/poem29827.html","الكامل"],[53,"ومقبل كفي وددت بأنه","https://www.aldiwan.net/poem29878.html","الكامل"],[53,"لو كان ما تطلبه غاية","https://www.aldiwan.net/poem29940.html","السريع"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[77,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[77,"إن شهرت نصلي بدا يوسف","https://www.aldiwan.net/poem36671.html","السريع"],[86,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[71,"ريح الشمال عساك أن تتحملي","https://www.aldiwan.net/poem4013.html","الكامل"],[83,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[72,"غدا فيك قلبي أحمدي صبابة","https://www.aldiwan.net/poem18292.html","الطويل"],[72,"قاضي القضاة المرتجى دمت ذا","https://www.aldiwan.net/poem18681.html","السريع"],[72,"هنئت بالعيد السعيد وحبذا","https://www.aldiwan.net/poem19208.html","الكامل"],[72,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"ولحية سائلة منصبه","https://www.aldiwan.net/poem8291.html","الرجز"],[51,"ولحية لو شاء ذو المعارج","https://www.aldiwan.net/poem9255.html","الرجز"],[51,"وصديق أجبته إذ دعاني","https://www.aldiwan.net/poem61866.html","الخفيف"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"ولحية ذات أصواف وأوبار","https://www.aldiwan.net/poem64072.html","البسيط"],[51,"ألذ من فائقة الإبهط","https://www.aldiwan.net/poem65027.html","الرجز"],[51,"ولحية يحملها مائق","https://www.aldiwan.net/poem65429.html","السريع"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[51,"ولحية سوء ولكنها","https://www.aldiwan.net/poem66776.html","المتقارب"],[51,"ولحية سوء ولكنها لصاحبها","https://www.aldiwan.net/poem66777.html","المتقارب"],[91,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"سل الليل عن أفلاكه هل جرت سدى","https://www.aldiwan.net/poem7892.html","الطويل"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[43,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[62,"زموا جمالهم وبدد شملهم","https://www.aldiwan.net/poem52306.html","الكامل"],[45,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[45,"لامت ملامة مشفق متعتب","https://www.aldiwan.net/poem11495.html","الكامل"],[45,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[80,"لو كنت زائرتي لراعك منظري","https://www.aldiwan.net/poem31224.html","الكامل"],[80,"أي روح لي في الريح القبول","https://www.aldiwan.net/poem31315.html","الرمل"],[31,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[52,"ألا ترى يا صاح ما حل بي","https://www.aldiwan.net/poem27117.html","السريع"],[52,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[48,"أيا من وجهه الداح","https://www.aldiwan.net/poem62530.html","الهزج"],[48,"فلا أشرب داريا","https://www.aldiwan.net/poem66255.html","الهزج"],[7,"جمع محاشك يا يزيد فإنني","https://www.aldiwan.net/poem1970.html","الكامل"],[46,"إنما نحن في ضلال وتعلي","https://www.aldiwan.net/poem22218.html","الخفيف"],[46,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140862",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54852","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199488","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9550","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""],[58,"أَبَا لَهَبٍ تَبَّتْ يَدَاكَ أَبَا لَهَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=22547",""],[51,"وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","https://www.poetsgate.com/ViewPoem.aspx?id=30777",""],[51,"وصديقٍ أجبتُهُ إذ دعاني","https://www.poetsgate.com/ViewPoem.aspx?id=27821",""],[51,"أحسنَ ما كان الدقيقُ مَوقعا","https://www.poetsgate.com/ViewPoem.aspx?id=29501",""],[51,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""]],"verses":[["وَلَحَوتُما المَقتولَ مِن كَمَدٍ","وَعَذَلتُما مَن طَرَّقَ القَتلا",0,"ل",2,0],["وَلَحَظتُ عَقدَ نِطاقِهِ فَكَأَنَّما","عُقِدَ الجَمالُ بِقُرطَقٍ مَحلولِ",1,"ل",1,0],["وَلَحظُ عَينَيكَ رَمى مُقلَتي","كَأَنَّ نَومي تَحتَها عاشِقُ",2,"ق",1,0],["ولِحاسِديكَ وأنت مُقتَبَلُ الصِّبا","كَمَدٌ يَكادُ يُصَدِّعُ الحَيْزوما",3,"م",2,0],["وَلِحِكْمَةٍ مَا أَشْرَقَتْ شُهْبُ الدُّجَى","وَتَعَاقَبَ الإِصْبَاحُ وَالإِظْلاَمُ",4,"م",1,0],["ولُحْتُ مثلَ البَرْقِ في كَفِّه","لا يُنْكَرُ البَرْقُ على الغَيْثِ",5,"ث",1,0],["وَلَحظٍ بابِلِيٍّ ذي اِنكِسارِ","كَأَنَّ بِطَرفِهِ سيما اليَتيمِ",6,"م",1,0],["وَلَحارَ بطليموسُ لَو لاقاهُ مِن","بُرهانِهِ في كُلِّ شَكلٍ مُشكِلِ",7,"ل",1,0],["ولحقت ترجمة الكتاب وصدرَه","وفوائد المكتوب في الإلحاقِ",8,"ق",1,0],["ولُحْت بأفْقها بدراً منيراً","جلا من ليل أبْؤسها الظلاما",9,"م",2,0],["ولحظك سهمٌ لا يردُّ فحبَّذا","للحظك سهمٌ في الحشا ونصيب",10,"ب",1,0],["ولحاجبينِ إذا تعرّض ناظر","متأملٌ قالت لقوسيها خُذا",11,"ذ",2,0],["ولحالنا المكسور يدعو برّك ال","منصوب يا من قدره مرفوع",12,"ع",1,0],["ولحية لحَ غاظها ضحكي على","أثيثٍ كقنو النخلة المتعثكل",13,"ل",1,0],["ولحظ إذا حفته أصداغ شعرِه","فما هو إلا سيفه والحمائل",14,"ل",1,0],["ولحى اللَّهُ مسمِعاً ليَ فيكم","يَتوخَّى بمُسخِطٍ إرضاءَ",15,"ا",2,0],["ولحيةٍ سائلةٍ مُنْصَبَّهْ","شهباءَ تحكي ذنبَ المِذبَّهْ",16,"ب",2,1],["ولحيةٍ لو شاء ذو المعارجِ","أغنى بها كواسدَ النواسجِ",17,"ج",1,1],["ولَحَا اللّه بين هذين من غَر","رَ عفيفاً من نفسه ثم أكدى",18,"د",2,0],["ولحْظِ عينين لو أدارهما","لفارسٍ في سلاحِهِ أسره",19,"ر",2,0],["ولحيةٍ ذاتِ أصوافٍ وأوْبارِ","منها يُحاك أثاثُ البيت والدارِ",20,"ر",1,1],["ولحم طيرٍ وصدور البطِّ","خُرطومُ سلسالٍ من الإسْفنطِ",21,"ط",1,0],["ولحيةٍ يحملها مائقٌ","مثل الشراعين إذا أشرعا",22,"ع",2,1],["ولحا الصِّبا بعد المشيب فإنه","شأوٌ يريك الحرَّ خلفَ وصيفه",23,"ف",2,0],["ولحَسبُكُم بنميم ما تُخفونَه","منا وللمسْكِ الذكيِّ نَمِيم",24,"م",1,0],["ولحيةِ سوءٍ ولكنّها","على عِرْضِ صاحبها واقيَهْ",25,"ه",1,1],["ولحيةِ سوء ولكنها","لصاحبها أبداً فدْيَهْ",26,"ه",1,1],["وَلَحَدَّثَتنا كَيفَ عَن أَعشاشِكُم","طِرتُمُ بِأَجنِحَةِ المُنى إِذ طُرتُمُ",27,"م",1,0],["وَلَحَظتِ مِنَ الكَواكِبِ صَدّاً","وَنُفاراً وَفي النَسيمِ خُشونَه",28,"ن",2,0],["ولحاظ من معاني سحره","جمع الجفن سهاما وظبى",29,"ب",2,0],["ولحنٌ به للقارئين قصيدة","من الحكمة العلياء لم ترض منشدا",30,"د",2,0],["وَلَحَظتُ أُنمُلَهُ فَسِلنَ مَواهِباً","وَلَمَستُ مُنصُلَهُ فَسالَ نُفوسا",31,"س",2,0],["وَلِحِتفٍ في العِزِّ يَدنو مُحِبٌّ","وَلِعُمرٍ يَطولُ في الذُلِّ قالي",32,"ل",2,0],["ولحقتُ آثارَ الحمول ودونَها","غيرانُ سطوتُهُ القضاءُ النازلُ",33,"ل",1,0],["وَلِحَربَةِ الإِسلامِ حينَ يَهُزُّها","هَولٌ يُراعُ لَهُ النِفاقُ وَيَرهَبُ",34,"ب",1,0],["وَلِحُزنِها بِصَميمِ قَلبي مَوقِعٌ","ذاكٍ عَلى جَمرِ الغَضا المُتَلَهِّبِ",35,"ب",1,0],["وَلَحالَ كُلَّ الحَولِ مِن دونِ الَّذي","قَد باتَ يُسخِطُكَ الَّذي يُرضيكا",36,"ك",2,0],["وَلحَالَ من دمعي وحرّ تنفسي","بيني وبينكِ لجةٌ وحريقٌ",37,"ق",1,0],["ولحونٍ حارَ فيها مَعْبَدٌ","وله علمٌ بِموسيقى الهَديلِ",38,"ل",1,0],["وَلَحى اللَهُ كُلَّ عَفلاءَ زَلّا","ءَ عَبوساً قَد آذَنَت بِالبَذاءِ",39,"ا",2,0],["وَلَحتَ وَمَغرِبُنا مُدبِرٌ","فَصارَ بِكَ المَشرِقَ المُقبِلا",40,"ل",2,0],["وَلَحَيتَني في مَعشَرٍ","هُم أَلحَقوكَ بِمَن تُفاخِر",41,"ر",1,0],["وَلَحا الرَحمَنُ مِنّا طالِبَ ال","صُلحِ وَالأَطوَعَ في حَبلِ القِيادِ",42,"د",1,0],["وَلَحظَةٍ أَسرَعَ مِن تُهمَةٍ","تُخيبُ مَن يَسأَلُ أَو يَبتَدي",43,"ي",1,0],["وَلِحَيني إِذ بُليتُ بِهِ","وَأَرى لِلحَينِ أَسبابا",44,"ب",2,0],["ولحُكمٍ من الزمانِ انتهاءٌ","ولحُكم من الزمانِ ابتداءُ",45,"ا",2,0],["ولحظْتُ مَنبرَكَ المُعَلّى راجِفاً","من تحتِ عِقْدِ الرّايَتَينِ مَهُولا",46,"ل",2,0],["ولحالَتْ دونَه رَجْراجة","كعُبابِ البحرِ يَرْمي بالزَّبَد",47,"د",1,0],["وَلَحظٌ صائِبُ الأَسهُ","مِ لِلمُهجَةِ جَرّاحُ",48,"ح",1,0],["ولحم الجمل الراضع","مسموطاً ومسلوخا",49,"خ",2,0],["وَلَحِقتُ بِالنَسَبِ الَّذي عَيَّرتَني","وَتَرَكتَ أَصلَكَ يا يَزيدُ ذَميما",50,"م",2,0],["وَلحُبِّ الصَحيحِ آثَرَتِ الرو","مُ اِنتِسابَ الفَتى إِلى أُمَّهاتِه",51,"ت",2,0],["وَلِحَبرِ اليَهودِ في دَرسِهِ التَو","راةَ فَنٌّ وَالهَمُّ في التَدبيلِ",52,"ل",1,0],["ولحتفٍ في العز يدنو محبٌّ","ولعمر يطول في الذل قال",53,"ل",1,0],["ولحونُ سِلمٍ أو ملاحمُ غارةٍ","غنَّى الجبالَ بها السحابُ المرزِمُ",54,"م",1,0],["وَلِحَاظُ القَوْمِ فِيهِ تَلْتَقِي","مُرْسِلاَتٍ أَسْهُماً أَوْ شَرَرَا",55,"ر",2,0],["ولحت ياأزرق العينين فانطلقت","أشواقه بجنون البيد في المطر",56,"ر",1,0],["وَلِحُسنِ الحَلالِ فَضلٌ إِذا ما","شابَهُ في العُيونِ ظَرفُ الحَرامِ",57,"م",1,0],["وَلَحيانَ كَاللَوحَينِ رُكِّبَ فيهِما","مَساميرُ أَقيانٍ لَهُنَّ غُروبُ",58,"ب",1,0],["وَلَحظِ عَينٍ يُريدُ ذاكَ وَذا","خِوانَةٌ تُجرى عَلى العَيَنِ",59,"ن",1,0],["ولُحونٌ لها مِثالٌ عجيبٌ","أو إِذا شِئْتَ قُلْ بغيرِ مِثالِ",60,"ل",1,0],["وَلُحْتَ فِيهَا فَصَارَتْ","خِصْبا وَكانَتْ يَبَابا",61,"ب",2,0],["ولحيتني في معشرٍ","هُم أَلْحَقُوكَ بِمَنْ تُغَاوِرْ",62,"ر",1,0],["ولحّنته سحرا يحتسي رؤى","الفجر بين ذراعي كتاب",63,"ب",1,0],["ولحقت أبا جهل فأصبحت تابعاً","لَهُ وَكَذَاكَ الرَّأْسُ يَتْبَعُهُ الذَّنَبْ",64,"ب",1,0],["وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","لِصَاحِبهَا أبداً افَديه",65,"ي",2,1],["ولَحَا الله بين هذين من غَرَّ","عفيفاً من نفسه ثم أكدى",66,"د",2,0],["ولحِق السَّبعينَ أو ترفَّعا","عن ذاك لا يرحم من تضرَّعا",67,"ع",2,0],["ولحية ٍ مثل غراب الحَمْتِ","كأنها مدهونة ٌ بزفتِ",68,"ت",1,0]]}