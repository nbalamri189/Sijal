oetsgate.com/ViewPoem.aspx?id=202509",""],[5970,"دعت فؤادي بليل الأمس غانية","https://www.poetsgate.com/ViewPoem.aspx?id=130649",""],[5989,"ما كنتُ بدعاً من العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=183969",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6139,"حب وأسى","https://www.poetsgate.com/ViewPoem.aspx?id=212335",""],[6237,"مسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77905&r=&rc=47",""],[6259,"إن الحمولَ غداة َ غربة غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59356&r=&rc=4",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""]],"verses":[["ولحدٌ بها دون الأنام تخالفت","ملائكة تسعاه من كل معقل",0,"ل",1,0],["وَلَحَوتُما المَقتولَ مِن كَمَدٍ","وَعَذَلتُما مَن طَرَّقَ القَتلا",1,"ل",2,0],["وَلَحَظتُ عَقدَ نِطاقِهِ فَكَأَنَّما","عُقِدَ الجَمالُ بِقُرطَقٍ مَحلولِ",2,"ل",1,0],["وَلَحظُ عَينَيكَ رَمى مُقلَتي","كَأَنَّ نَومي تَحتَها عاشِقُ",3,"ق",1,0],["ولِحاسِديكَ وأنت مُقتَبَلُ الصِّبا","كَمَدٌ يَكادُ يُصَدِّعُ الحَيْزوما",4,"م",2,0],["وَلِحِكْمَةٍ مَا أَشْرَقَتْ شُهْبُ الدُّجَى","وَتَعَاقَبَ الإِصْبَاحُ وَالإِظْلاَمُ",5,"م",1,0],["ولُحْتُ مثلَ البَرْقِ في كَفِّه","لا يُنْكَرُ البَرْقُ على الغَيْثِ",6,"ث",1,0],["وَلَحظٍ بابِلِيٍّ ذي اِنكِسارِ","كَأَنَّ بِطَرفِهِ سيما اليَتيمِ",7,"م",1,0],["وَلَحارَ بطليموسُ لَو لاقاهُ مِن","بُرهانِهِ في كُلِّ شَكلٍ مُشكِلِ",8,"ل",1,0],["ولحقت ترجمة الكتاب وصدرَه","وفوائد المكتوب في الإلحاقِ",9,"ق",1,0],["ولُحْت بأفْقها بدراً منيراً","جلا من ليل أبْؤسها الظلاما",10,"م",2,0],["ولحظك سهمٌ لا يردُّ فحبَّذا","للحظك سهمٌ في الحشا ونصيب",11,"ب",1,0],["ولحاجبينِ إذا تعرّض ناظر","متأملٌ قالت لقوسيها خُذا",12,"ذ",2,0],["ولحالنا المكسور يدعو برّك ال","منصوب يا من قدره مرفوع",13,"ع",1,0],["ولحية لحَ غاظها ضحكي على","أثيثٍ كقنو النخلة المتعثكل",14,"ل",1,0],["ولحظ إذا حفته أصداغ شعرِه","فما هو إلا سيفه والحمائل",15,"ل",1,0],["ولحى اللَّهُ مسمِعاً ليَ فيكم","يَتوخَّى بمُسخِطٍ إرضاءَ",16,"ا",2,0],["ولحيةٍ سائلةٍ مُنْصَبَّهْ","شهباءَ تحكي ذنبَ المِذبَّهْ",17,"ب",2,1],["ولحيةٍ لو شاء ذو المعارجِ","أغنى بها كواسدَ النواسجِ",18,"ج",1,1],["ولَحَا اللّه بين هذين من غَر","رَ عفيفاً من نفسه ثم أكدى",19,"د",2,0],["ولحْظِ عينين لو أدارهما","لفارسٍ في سلاحِهِ أسره",20,"ر",2,0],["ولحيةٍ ذاتِ أصوافٍ وأوْبارِ","منها يُحاك أثاثُ البيت والدارِ",21,"ر",1,1],["ولحم طيرٍ وصدور البطِّ","خُرطومُ سلسالٍ من الإسْفنطِ",22,"ط",1,0],["ولحيةٍ يحملها مائقٌ","مثل الشراعين إذا أشرعا",23,"ع",2,1],["ولحا الصِّبا بعد المشيب فإنه","شأوٌ يريك الحرَّ خلفَ وصيفه",24,"ف",2,0],["ولحَسبُكُم بنميم ما تُخفونَه","منا وللمسْكِ الذكيِّ نَمِيم",25,"م",1,0],["ولحيةِ سوءٍ ولكنّها","على عِرْضِ صاحبها واقيَهْ",26,"ه",1,1],["ولحيةِ سوء ولكنها","لصاحبها أبداً فدْيَهْ",27,"ه",1,1],["وَلَحَدَّثَتنا كَيفَ عَن أَعشاشِكُم","طِرتُمُ بِأَجنِحَةِ المُنى إِذ طُرتُمُ",28,"م",1,0],["وَلَحَظتِ مِنَ الكَواكِبِ صَدّاً","وَنُفاراً وَفي النَسيمِ خُشونَه",29,"ن",2,0],["ولحاظ من معاني سحره","جمع الجفن سهاما وظبى",30,"ب",2,0],["ولحنٌ به للقارئين قصيدة","من الحكمة العلياء لم ترض منشدا",31,"د",2,0],["وَلَحَظتُ أُنمُلَهُ فَسِلنَ مَواهِباً","وَلَمَستُ مُنصُلَهُ فَسالَ نُفوسا",32,"س",2,0],["وَلِحِتفٍ في العِزِّ يَدنو مُحِبٌّ","وَلِعُمرٍ يَطولُ في الذُلِّ قالي",33,"ل",2,0],["ولحقتُ آثارَ الحمول ودونَها","غيرانُ سطوتُهُ القضاءُ النازلُ",34,"ل",1,0],["وَلِحَربَةِ الإِسلامِ حينَ يَهُزُّها","هَولٌ يُراعُ لَهُ النِفاقُ وَيَرهَبُ",35,"ب",1,0],["وَلِحُزنِها بِصَميمِ قَلبي مَوقِعٌ","ذاكٍ عَلى جَمرِ الغَضا المُتَلَهِّبِ",36,"ب",1,0],["وَلَحالَ كُلَّ الحَولِ مِن دونِ الَّذي","قَد باتَ يُسخِطُكَ الَّذي يُرضيكا",37,"ك",2,0],["وَلحَالَ من دمعي وحرّ تنفسي","بيني وبينكِ لجةٌ وحريقٌ",38,"ق",1,0],["ولحونٍ حارَ فيها مَعْبَدٌ","وله علمٌ بِموسيقى الهَديلِ",39,"ل",1,0],["وَلَحى اللَهُ كُلَّ عَفلاءَ زَلّا","ءَ عَبوساً قَد آذَنَت بِالبَذاءِ",40,"ا",2,0],["وَلَحتَ وَمَغرِبُنا مُدبِرٌ","فَصارَ بِكَ المَشرِقَ المُقبِلا",41,"ل",2,0],["وَلَحَيتَني في مَعشَرٍ","هُم أَلحَقوكَ بِمَن تُفاخِر",42,"ر",1,0],["وَلَحا الرَحمَنُ مِنّا طالِبَ ال","صُلحِ وَالأَطوَعَ في حَبلِ القِيادِ",43,"د",1,0],["وَلَحظَةٍ أَسرَعَ مِن تُهمَةٍ","تُخيبُ مَن يَسأَلُ أَو يَبتَدي",44,"د",2,0],["وَلِحَيني إِذ بُليتُ بِهِ","وَأَرى لِلحَينِ أَسبابا",45,"ب",2,0],["ولحُكمٍ من الزمانِ انتهاءٌ","ولحُكم من الزمانِ ابتداءُ",46,"ا",2,0],["ولحظْتُ مَنبرَكَ المُعَلّى راجِفاً","من تحتِ عِقْدِ الرّايَتَينِ مَهُولا",47,"ل",2,0],["ولحالَتْ دونَه رَجْراجة","كعُبابِ البحرِ يَرْمي بالزَّبَد",48,"د",1,0],["وَلَحظٌ صائِبُ الأَسهُ","مِ لِلمُهجَةِ جَرّاحُ",49,"ح",1,0],["ولحم الجمل الراضع","مسموطاً ومسلوخا",50,"خ",2,0],["وَلَحِقتُ بِالنَسَبِ الَّذي عَيَّرتَني","وَتَرَكتَ أَصلَكَ يا يَزيدُ ذَميما",51,"م",2,0],["وَلحُبِّ الصَحيحِ آثَرَتِ الرو","مُ اِنتِسابَ الفَتى إِلى أُمَّهاتِه",52,"ت",2,0],["وَلِحَبرِ اليَهودِ في دَرسِهِ التَو","راةَ فَنٌّ وَالهَمُّ في التَدبيلِ",53,"ل",1,0],["ولحتفٍ في العز يدنو محبٌّ","ولعمر يطول في الذل قال",54,"ل",1,0],["ولحونُ سِلمٍ أو ملاحمُ غارةٍ","غنَّى الجبالَ بها السحابُ المرزِمُ",55,"م",1,0],["وَلِحَاظُ القَوْمِ فِيهِ تَلْتَقِي","مُرْسِلاَتٍ أَسْهُماً أَوْ شَرَرَا",56,"ر",2,0],["ولحت ياأزرق العينين فانطلقت","أشواقه بجنون البيد في المطر",57,"ر",1,0],["وَلِحُسنِ الحَلالِ فَضلٌ إِذا ما","شابَهُ في العُيونِ ظَرفُ الحَرامِ",58,"م",1,0],["وَلَحيانَ كَاللَوحَينِ رُكِّبَ فيهِما","مَساميرُ أَقيانٍ لَهُنَّ غُروبُ",59,"ب",1,0],["وَلَحظِ عَينٍ يُريدُ ذاكَ وَذا","خِوانَةٌ تُجرى عَلى العَيَنِ",60,"ن",1,0],["ولُحونٌ لها مِثالٌ عجيبٌ","أو إِذا شِئْتَ قُلْ بغيرِ مِثالِ",61,"ل",1,0],["وَلُحْتَ فِيهَا فَصَارَتْ","خِصْبا وَكانَتْ يَبَابا",62,"ب",2,0],["ولحيتني في معشرٍ","هُم أَلْحَقُوكَ بِمَنْ تُغَاوِرْ",63,"ر",1,0],["ولحّنت الغدر أنشودة","من النار تحتقر المنشدا",64,"د",2,0],["ولحّنته سحرا يحتسي","رؤى الفجر بين ذراعي كتاب",65,"ب",1,0],["ولحقت أبا جهل فأصبحت تابعاً","لَهُ وَكَذَاكَ الرَّأْسُ يَتْبَعُهُ الذَّنَبْ",66,"ب",1,0],["ولحدّثتنا عن أعشاشكم","طرتم بأجنحة المنى إذ طرتم",67,"م",1,0],["ولحت لنا في عالم الحقّ بدعة","من النّور يخبو كلّ حسن ولا تخبو",68,"ب",2,0],["ولحت لنا في عالم الحقّ والتقى","على ا