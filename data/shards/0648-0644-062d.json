ml","الخفيف"],[462,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[462,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[462,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[462,"ما عند مهضوم الوشاح ضعيفه","https://www.aldiwan.net/poem3583.html","عموديه"],[462,"عج بالمطي في أظعانها","https://www.aldiwan.net/poem3628.html","عموديه"],[466,"عندي جعلت فداك من ندمان","https://www.aldiwan.net/poem59563.html","الكامل"],[512,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[536,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[549,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[549,"عادت إلي بغيضة فتوددت","https://www.aldiwan.net/poem48072.html","الكامل"],[556,"إنني جمع وفرق","https://www.aldiwan.net/poem34329.html","مجزوء الرمل"],[565,"سلام على دير القصير وسفحه","https://www.aldiwan.net/poem69772.html","الطويل"],[584,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"]],"verses":[["وَلَحَوتُما المَقتولَ مِن كَمَدٍ","وَعَذَلتُما مَن طَرَّقَ القَتلا",0,"ل",2,0],["وَلَحَظتُ عَقدَ نِطاقِهِ فَكَأَنَّما","عُقِدَ الجَمالُ بِقُرطَقٍ مَحلولِ",1,"ل",1,0],["وَلَحظُ عَينَيكَ رَمى مُقلَتي","كَأَنَّ نَومي تَحتَها عاشِقُ",2,"ق",1,0],["ولِحاسِديكَ وأنت مُقتَبَلُ الصِّبا","كَمَدٌ يَكادُ يُصَدِّعُ الحَيْزوما",3,"م",2,0],["وَلِحِكْمَةٍ مَا أَشْرَقَتْ شُهْبُ الدُّجَى","وَتَعَاقَبَ الإِصْبَاحُ وَالإِظْلاَمُ",4,"م",1,0],["ولُحْتُ مثلَ البَرْقِ في كَفِّه","لا يُنْكَرُ البَرْقُ على الغَيْثِ",5,"ث",1,0],["وَلَحظٍ بابِلِيٍّ ذي اِنكِسارِ","كَأَنَّ بِطَرفِهِ سيما اليَتيمِ",6,"م",1,0],["وَلَحارَ بطليموسُ لَو لاقاهُ مِن","بُرهانِهِ في كُلِّ شَكلٍ مُشكِلِ",7,"ل",1,0],["ولحقت ترجمة الكتاب وصدرَه","وفوائد المكتوب في الإلحاقِ",8,"ق",1,0],["ولُحْت بأفْقها بدراً منيراً","جلا من ليل أبْؤسها الظلاما",9,"م",2,0],["ولحظك سهمٌ لا يردُّ فحبَّذا","للحظك سهمٌ في الحشا ونصيب",10,"ب",1,0],["ولحاجبينِ إذا تعرّض ناظر","متأملٌ قالت لقوسيها خُذا",11,"ذ",2,0],["ولحالنا المكسور يدعو برّك ال","منصوب يا من قدره مرفوع",12,"ع",1,0],["ولحية لحَ غاظها ضحكي على","أثيثٍ كقنو النخلة المتعثكل",13,"ل",1,0],["ولحظ إذا حفته أصداغ شعرِه","فما هو إلا سيفه والحمائل",14,"ل",1,0],["ولحى اللَّهُ مسمِعاً ليَ فيكم","يَتوخَّى بمُسخِطٍ إرضاءَ",15,"ا",2,0],["ولحيةٍ سائلةٍ مُنْصَبَّهْ","شهباءَ تحكي ذنبَ المِذبَّهْ",16,"ب",2,1],["ولحيةٍ لو شاء ذو المعارجِ","أغنى بها كواسدَ النواسجِ",17,"ج",1,1],["ولَحَا اللّه بين هذين من غَر","رَ عفيفاً من نفسه ثم أكدى",18,"د",2,0],["ولحْظِ عينين لو أدارهما","لفارسٍ في سلاحِهِ أسره",19,"ر",2,0],["ولحيةٍ ذاتِ أصوافٍ وأوْبارِ","منها يُحاك أثاثُ البيت والدارِ",20,"ر",1,1],["ولحم طيرٍ وصدور البطِّ","خُرطومُ سلسالٍ من الإسْفنطِ",21,"ط",1,0],["ولحيةٍ يحملها مائقٌ","مثل الشراعين إذا أشرعا",22,"ع",2,1],["ولحا الصِّبا بعد المشيب فإنه","شأوٌ يريك الحرَّ خلفَ وصيفه",23,"ف",2,0],["ولحَسبُكُم بنميم ما تُخفونَه","منا وللمسْكِ الذكيِّ نَمِيم",24,"م",1,0],["ولحيةِ سوءٍ ولكنّها","على عِرْضِ صاحبها واقيَهْ",25,"ه",1,1],["ولحيةِ سوء ولكنها","لصاحبها أبداً فدْيَهْ",26,"ه",1,1],["وَلَحَدَّثَتنا كَيفَ عَن أَعشاشِكُم","طِرتُمُ بِأَجنِحَةِ المُنى إِذ طُرتُمُ",27,"م",1,0],["وَلَحَظتِ مِنَ الكَواكِبِ صَدّاً","وَنُفاراً وَفي النَسيمِ خُشونَه",28,"ن",2,0],["ولحاظ من معاني سحره","جمع الجفن سهاما وظبى",29,"ب",2,0],["ولحنٌ به للقارئين قصيدة","من الحكمة العلياء لم ترض منشدا",30,"د",2,0],["وَلَحَظتُ أُنمُلَهُ فَسِلنَ مَواهِباً","وَلَمَستُ مُنصُلَهُ فَسالَ نُفوسا",31,"س",2,0],["وَلِحِتفٍ في العِزِّ يَدنو مُحِبٌّ","وَلِعُمرٍ يَطولُ في الذُلِّ قالي",32,"ل",2,0],["ولحقتُ آثارَ الحمول ودونَها","غيرانُ سطوتُهُ القضاءُ النازلُ",33,"ل",1,0],["وَلِحَربَةِ الإِسلامِ حينَ يَهُزُّها","هَولٌ يُراعُ لَهُ النِفاقُ وَيَرهَبُ",34,"ب",1,0],["وَلِحُزنِها بِصَميمِ قَلبي مَوقِعٌ","ذاكٍ عَلى جَمرِ الغَضا المُتَلَهِّبِ",35,"ب",1,0],["وَلَحالَ كُلَّ الحَولِ مِن دونِ الَّذي","قَد باتَ يُسخِطُكَ الَّذي يُرضيكا",36,"ك",2,0],["وَلحَالَ من دمعي وحرّ تنفسي","بيني وبينكِ لجةٌ وحريقٌ",37,"ق",1,0],["ولحونٍ حارَ فيها مَعْبَدٌ","وله علمٌ بِموسيقى الهَديلِ",38,"ل",1,0],["وَلَحى اللَهُ كُلَّ عَفلاءَ زَلّا","ءَ عَبوساً قَد آذَنَت بِالبَذاءِ",39,"ا",2,0],["وَلَحتَ وَمَغرِبُنا مُدبِرٌ","فَصارَ بِكَ المَشرِقَ المُقبِلا",40,"ل",2,0],["وَلَحَيتَني في مَعشَرٍ","هُم أَلحَقوكَ بِمَن تُفاخِر",41,"ر",1,0],["وَلَحا الرَحمَنُ مِنّا طالِبَ ال","صُلحِ وَالأَطوَعَ في حَبلِ القِيادِ",42,"د",1,0],["وَلَحظَةٍ أَسرَعَ مِن تُهمَةٍ","تُخيبُ مَن يَسأَلُ أَو يَبتَدي",43,"ي",1,0],["وَلِحَيني إِذ بُليتُ بِهِ","وَأَرى لِلحَينِ أَسبابا",44,"ب",2,0],["ولحُكمٍ من الزمانِ انتهاءٌ","ولحُكم من الزمانِ ابتداءُ",45,"ا",2,0],["ولحظْتُ مَنبرَكَ المُعَلّى راجِفاً","من تحتِ عِقْدِ الرّايَتَينِ مَهُولا",46,"ل",2,0],["ولحالَتْ دونَه رَجْراجة","كعُبابِ البحرِ يَرْمي بالزَّبَد",47,"د",1,0],["وَلَحظٌ صائِبُ الأَسهُ","مِ لِلمُهجَةِ جَرّاحُ",48,"ح",1,0],["ولحم الجمل الراضع","مسموطاً ومسلوخا",49,"خ",2,0],["وَلَحِقتُ بِالنَسَبِ الَّذي عَيَّرتَني","وَتَرَكتَ أَصلَكَ يا يَزيدُ ذَميما",50,"م",2,0],["وَلحُبِّ الصَحيحِ آثَرَتِ الرو","مُ اِنتِسابَ الفَتى إِلى أُمَّهاتِه",51,"ت",2,0],["وَلِحَبرِ اليَهودِ في دَرسِهِ التَو","راةَ فَنٌّ وَالهَمُّ في التَدبيلِ",52,"ل",1,0],["ولحتفٍ في العز يدنو محبٌّ","ولعمر يطول في الذل قال",53,"ل",1,0],["ولحونُ سِلمٍ أو ملاحمُ غارةٍ","غنَّى الجبالَ بها السحابُ المرزِمُ",54,"م",1,0],["وَلِحَاظُ القَوْمِ فِيهِ تَلْتَقِي","مُرْسِلاَتٍ أَسْهُماً أَوْ شَرَرَا",55,"ر",2,0],["ولحت ياأزرق العينين فانطلقت","أشواقه بجنون البيد في المطر",56,"ر",1,0],["وَلِحُسنِ الحَلالِ فَضلٌ إِذا ما","شابَهُ في العُيونِ ظَرفُ الحَرامِ",57,"م",1,0],["وَلَحيانَ كَاللَوحَينِ رُكِّبَ فيهِما","مَساميرُ أَقيانٍ لَهُنَّ غُروبُ",58,"ب",1,0],["وَلَحظِ عَينٍ يُريدُ ذاكَ وَذا","خِوانَةٌ تُجرى عَلى العَيَنِ",59,"ن",1,0],["ولُحونٌ لها مِثالٌ عجيبٌ","أو إِذا شِئْتَ قُلْ بغيرِ مِثالِ",60,"ل",1,0],["وَلُحْتَ فِيهَا فَصَارَتْ","خِصْبا وَكانَتْ يَبَابا",61,"ب",2,0],["ولحيتني في معشرٍ","هُم أَلْحَقُوكَ بِمَنْ تُغَاوِرْ",62,"ر",1,0],["ولحّنته سحرا يحتسي رؤى","الفجر بين ذراعي كتاب",63,"ب",1,0],["ولحقت أبا جهل فأصبحت تابعاً","لَهُ وَكَذَاكَ الرَّأْسُ يَتْبَعُهُ الذَّنَبْ",64,"ب",1,0],["وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","لِصَاحِبهَا أبداً افَديه",65,"ي",2,1],["ولَحَا الله بين هذين من غَرَّ","عفيفاً من نفسه ثم أكدى",66,"د",2,0],["ولحِق السَّبعينَ أو ترفَّعا","عن ذاك لا يرحم من تضرَّعا",67,"ع",2,0],["ولحية ٍ مثل غراب الحَمْتِ","كأنها مدهونة ٌ بزفتِ",68,"ت",1,0],["ولحمقهم يستحمقون الناس لا","هجعوا وراء نسيمهم اشعال",69,"ل",1,0],["ولحب محبوب تحب قبيلة","ولأجل عين الف عين تكرم",70,"م",1,0],["ولحسني سلامة الدين والدن","يا وللأمن من عذاب النار",71,"ر",1,0],["ولحسن الشهود من غير قطع","وصفاء الأوقات والأفكار",71,"ر",1,0],["ولحل عقد الكفر جا","بالذكر منظوم العقود",72,"د",1,0],["ولحظٌ كأن البرق ريش سهامه","يضيء حواشي كل أغبر قاتم",73,"م",1,0],["ولُحتِ وفَحتِ في شَمسٍ ومِسكٍ","فَلاَقَى القَلبُ أصعَبَ ما يُلاَقَى",74,"ق",2,0],["وَلِحِلمِكَ الإِغضاءُ في الإِغضابِ","وَلِنَيلِكَ الإِجداءُ في الإِجدابِ",75,"ب",1,0],["وَلَحْظٍ يَكَادُ الْحُسْنُ يَعْبُدُ حُسْنَهُ","إِذا أَقْلَقَتْهُ لِلْعُيونِ المَضَاجِعُ",76,"ع",1,1],["ولحفظها بالفر أكبر شاهد","لك بالعلى فلم التاسفَ والحزن",77,"ن",1,0],["وَلِحارِثٍ عُرِفَت رِئاسَةُ عامِرٍ","في جاهِلِيَّتِها وَفي الإِسلامِ",78,"م",1,0],["ولحبّه بقلوبنا","ونفوسنا أبقى المعابد",79,"د",1,0],["ولحظ عيون العِين أمضى مضارباً","وأتلفُ للأرواح من قضُب الهندِ",80,"د",1,0],["ولحظ من بني عبس","ووجه من بني بدر",81,"ر",1,0],["ولحناً من أغاريد القوافي","فقل ما شئت من فن وسحر",82,"ر",1,0],["ولحتَ للنفس مثال الخلود","وإن تعامت عن سناك العيون",83,"ن",1,0],["ولُحتَ كما يلوح فَتِيقُ صبح","ومِستَ كما يميس قضيبُ بانِ",84,"ن",1,0],["ولحزبك الأعلون حتى يخرج ال","طاغي ويمنع درهم وقفيز",85,"ز",1,0],["وَلِحُسنِ عَفوِكَ وَهوَ أَوفى ذِمَّةٍ","لِلجارِ أَن يَلقى لَدَيكَ تَهَدُّما",86,"م",2,0],["ولحاظٍ حمى بها طَلعَ ثغرٍ","بَرَدُ الدمع من جفوني نَضِيدُه",87,"د",2,0],["ولحسنه كيف استمال عواذلي","فرأيت حسادي به العذالا",88,"ل",2,0],["ولحظةُ الغيتار