et/poem34878.html","الكامل"],[442,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[453,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[459,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[459,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[465,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[465,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[465,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[465,"ما عند مهضوم الوشاح ضعيفه","https://www.aldiwan.net/poem3583.html","عموديه"],[465,"عج بالمطي في أظعانها","https://www.aldiwan.net/poem3628.html","عموديه"],[469,"عندي جعلت فداك من ندمان","https://www.aldiwan.net/poem59563.html","الكامل"],[515,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[539,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[545,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[552,"عادت إلي بغيضة فتوددت","https://www.aldiwan.net/poem48072.html","الكامل"],[559,"إنني جمع وفرق","https://www.aldiwan.net/poem34329.html","مجزوء الرمل"],[568,"سلام على دير القصير وسفحه","https://www.aldiwan.net/poem69772.html","الطويل"],[587,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"]],"verses":[["ولحدٌ بها دون الأنام تخالفت","ملائكة تسعاه من كل معقل",0,"ل",1,0],["وَلَحَوتُما المَقتولَ مِن كَمَدٍ","وَعَذَلتُما مَن طَرَّقَ القَتلا",1,"ل",2,0],["وَلَحَظتُ عَقدَ نِطاقِهِ فَكَأَنَّما","عُقِدَ الجَمالُ بِقُرطَقٍ مَحلولِ",2,"ل",1,0],["وَلَحظُ عَينَيكَ رَمى مُقلَتي","كَأَنَّ نَومي تَحتَها عاشِقُ",3,"ق",1,0],["ولِحاسِديكَ وأنت مُقتَبَلُ الصِّبا","كَمَدٌ يَكادُ يُصَدِّعُ الحَيْزوما",4,"م",2,0],["وَلِحِكْمَةٍ مَا أَشْرَقَتْ شُهْبُ الدُّجَى","وَتَعَاقَبَ الإِصْبَاحُ وَالإِظْلاَمُ",5,"م",1,0],["ولُحْتُ مثلَ البَرْقِ في كَفِّه","لا يُنْكَرُ البَرْقُ على الغَيْثِ",6,"ث",1,0],["وَلَحظٍ بابِلِيٍّ ذي اِنكِسارِ","كَأَنَّ بِطَرفِهِ سيما اليَتيمِ",7,"م",1,0],["وَلَحارَ بطليموسُ لَو لاقاهُ مِن","بُرهانِهِ في كُلِّ شَكلٍ مُشكِلِ",8,"ل",1,0],["ولحقت ترجمة الكتاب وصدرَه","وفوائد المكتوب في الإلحاقِ",9,"ق",1,0],["ولُحْت بأفْقها بدراً منيراً","جلا من ليل أبْؤسها الظلاما",10,"م",2,0],["ولحظك سهمٌ لا يردُّ فحبَّذا","للحظك سهمٌ في الحشا ونصيب",11,"ب",1,0],["ولحاجبينِ إذا تعرّض ناظر","متأملٌ قالت لقوسيها خُذا",12,"ذ",2,0],["ولحالنا المكسور يدعو برّك ال","منصوب يا من قدره مرفوع",13,"ع",1,0],["ولحية لحَ غاظها ضحكي على","أثيثٍ كقنو النخلة المتعثكل",14,"ل",1,0],["ولحظ إذا حفته أصداغ شعرِه","فما هو إلا سيفه والحمائل",15,"ل",1,0],["ولحى اللَّهُ مسمِعاً ليَ فيكم","يَتوخَّى بمُسخِطٍ إرضاءَ",16,"ا",2,0],["ولحيةٍ سائلةٍ مُنْصَبَّهْ","شهباءَ تحكي ذنبَ المِذبَّهْ",17,"ب",2,1],["ولحيةٍ لو شاء ذو المعارجِ","أغنى بها كواسدَ النواسجِ",18,"ج",1,1],["ولَحَا اللّه بين هذين من غَر","رَ عفيفاً من نفسه ثم أكدى",19,"د",2,0],["ولحْظِ عينين لو أدارهما","لفارسٍ في سلاحِهِ أسره",20,"ر",2,0],["ولحيةٍ ذاتِ أصوافٍ وأوْبارِ","منها يُحاك أثاثُ البيت والدارِ",21,"ر",1,1],["ولحم طيرٍ وصدور البطِّ","خُرطومُ سلسالٍ من الإسْفنطِ",22,"ط",1,0],["ولحيةٍ يحملها مائقٌ","مثل الشراعين إذا أشرعا",23,"ع",2,1],["ولحا الصِّبا بعد المشيب فإنه","شأوٌ يريك الحرَّ خلفَ وصيفه",24,"ف",2,0],["ولحَسبُكُم بنميم ما تُخفونَه","منا وللمسْكِ الذكيِّ نَمِيم",25,"م",1,0],["ولحيةِ سوءٍ ولكنّها","على عِرْضِ صاحبها واقيَهْ",26,"ه",1,1],["ولحيةِ سوء ولكنها","لصاحبها أبداً فدْيَهْ",27,"ه",1,1],["وَلَحَدَّثَتنا كَيفَ عَن أَعشاشِكُم","طِرتُمُ بِأَجنِحَةِ المُنى إِذ طُرتُمُ",28,"م",1,0],["وَلَحَظتِ مِنَ الكَواكِبِ صَدّاً","وَنُفاراً وَفي النَسيمِ خُشونَه",29,"ن",2,0],["ولحاظ من معاني سحره","جمع الجفن سهاما وظبى",30,"ب",2,0],["ولحنٌ به للقارئين قصيدة","من الحكمة العلياء لم ترض منشدا",31,"د",2,0],["وَلَحَظتُ أُنمُلَهُ فَسِلنَ مَواهِباً","وَلَمَستُ مُنصُلَهُ فَسالَ نُفوسا",32,"س",2,0],["وَلِحِتفٍ في العِزِّ يَدنو مُحِبٌّ","وَلِعُمرٍ يَطولُ في الذُلِّ قالي",33,"ل",2,0],["ولحقتُ آثارَ الحمول ودونَها","غيرانُ سطوتُهُ القضاءُ النازلُ",34,"ل",1,0],["وَلِحَربَةِ الإِسلامِ حينَ يَهُزُّها","هَولٌ يُراعُ لَهُ النِفاقُ وَيَرهَبُ",35,"ب",1,0],["وَلِحُزنِها بِصَميمِ قَلبي مَوقِعٌ","ذاكٍ عَلى جَمرِ الغَضا المُتَلَهِّبِ",36,"ب",1,0],["وَلَحالَ كُلَّ الحَولِ مِن دونِ الَّذي","قَد باتَ يُسخِطُكَ الَّذي يُرضيكا",37,"ك",2,0],["وَلحَالَ من دمعي وحرّ تنفسي","بيني وبينكِ لجةٌ وحريقٌ",38,"ق",1,0],["ولحونٍ حارَ فيها مَعْبَدٌ","وله علمٌ بِموسيقى الهَديلِ",39,"ل",1,0],["وَلَحى اللَهُ كُلَّ عَفلاءَ زَلّا","ءَ عَبوساً قَد آذَنَت بِالبَذاءِ",40,"ا",2,0],["وَلَحتَ وَمَغرِبُنا مُدبِرٌ","فَصارَ بِكَ المَشرِقَ المُقبِلا",41,"ل",2,0],["وَلَحَيتَني في مَعشَرٍ","هُم أَلحَقوكَ بِمَن تُفاخِر",42,"ر",1,0],["وَلَحا الرَحمَنُ مِنّا طالِبَ ال","صُلحِ وَالأَطوَعَ في حَبلِ القِيادِ",43,"د",1,0],["وَلَحظَةٍ أَسرَعَ مِن تُهمَةٍ","تُخيبُ مَن يَسأَلُ أَو يَبتَدي",44,"د",2,0],["وَلِحَيني إِذ بُليتُ بِهِ","وَأَرى لِلحَينِ أَسبابا",45,"ب",2,0],["ولحُكمٍ من الزمانِ انتهاءٌ","ولحُكم من الزمانِ ابتداءُ",46,"ا",2,0],["ولحظْتُ مَنبرَكَ المُعَلّى راجِفاً","من تحتِ عِقْدِ الرّايَتَينِ مَهُولا",47,"ل",2,0],["ولحالَتْ دونَه رَجْراجة","كعُبابِ البحرِ يَرْمي بالزَّبَد",48,"د",1,0],["وَلَحظٌ صائِبُ الأَسهُ","مِ لِلمُهجَةِ جَرّاحُ",49,"ح",1,0],["ولحم الجمل الراضع","مسموطاً ومسلوخا",50,"خ",2,0],["وَلَحِقتُ بِالنَسَبِ الَّذي عَيَّرتَني","وَتَرَكتَ أَصلَكَ يا يَزيدُ ذَميما",51,"م",2,0],["وَلحُبِّ الصَحيحِ آثَرَتِ الرو","مُ اِنتِسابَ الفَتى إِلى أُمَّهاتِه",52,"ت",2,0],["وَلِحَبرِ اليَهودِ في دَرسِهِ التَو","راةَ فَنٌّ وَالهَمُّ في التَدبيلِ",53,"ل",1,0],["ولحتفٍ في العز يدنو محبٌّ","ولعمر يطول في الذل قال",54,"ل",1,0],["ولحونُ سِلمٍ أو ملاحمُ غارةٍ","غنَّى الجبالَ بها السحابُ المرزِمُ",55,"م",1,0],["وَلِحَاظُ القَوْمِ فِيهِ تَلْتَقِي","مُرْسِلاَتٍ أَسْهُماً أَوْ شَرَرَا",56,"ر",2,0],["ولحت ياأزرق العينين فانطلقت","أشواقه بجنون البيد في المطر",57,"ر",1,0],["وَلِحُسنِ الحَلالِ فَضلٌ إِذا ما","شابَهُ في العُيونِ ظَرفُ الحَرامِ",58,"م",1,0],["وَلَحيانَ كَاللَوحَينِ رُكِّبَ فيهِما","مَساميرُ أَقيانٍ لَهُنَّ غُروبُ",59,"ب",1,0],["وَلَحظِ عَينٍ يُريدُ ذاكَ وَذا","خِوانَةٌ تُجرى عَلى العَيَنِ",60,"ن",1,0],["ولُحونٌ لها مِثالٌ عجيبٌ","أو إِذا شِئْتَ قُلْ بغيرِ مِثالِ",61,"ل",1,0],["وَلُحْتَ فِيهَا فَصَارَتْ","خِصْبا وَكانَتْ يَبَابا",62,"ب",2,0],["ولحيتني في معشرٍ","هُم أَلْحَقُوكَ بِمَنْ تُغَاوِرْ",63,"ر",1,0],["ولحّنت الغدر أنشودة","من النار تحتقر المنشدا",64,"د",2,0],["ولحّنته سحرا يحتسي","رؤى الفجر بين ذراعي كتاب",65,"ب",1,0],["ولحقت أبا جهل فأصبحت تابعاً","لَهُ وَكَذَاكَ الرَّأْسُ يَتْبَعُهُ الذَّنَبْ",66,"ب",1,0],["ولحدّثتنا عن أعشاشكم","طرتم بأجنحة المنى إذ طرتم",67,"م",1,0],["ولحت لنا في عالم الحقّ بدعة","من النّور يخبو كلّ حسن ولا تخبو",68,"ب",2,0],["ولحت لنا في عالم الحقّ والتقى","على الموعد الهاني المقيمون والسفر",69,"ر",1,0],["وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","لِصَاحِبهَا أبداً افَديه",70,"ي",2,1],["ولَحَا الله بين هذين من غَرَّ","عفيفاً من نفسه ثم أكدى",71,"د",2,0],["ولحِق السَّبعينَ أو ترفَّعا","عن ذاك لا يرحم من تضرَّعا",72,"ع",2,0],["ولحية ٍ مثل غراب الحَمْتِ","كأنها مدهونة ٌ بزفتِ",73,"ت",1,0],["ولحمقهم يستحمقون الناس لا","هجعوا وراء نسيمهم اشعال",74,"ل",1,0],["ولحب محبوب تحب قبيلة","ولأجل عين الف عين تكرم",75,"م",1,0],["ولحسني سلامة الدين والدن","يا وللأمن من عذاب النار",76,"ر",1,0],["ولحسن الشهود من غير قطع","وصفاء الأوقات والأفكار",76,"ر",1,0],["ولحل عقد الكفر جا","بالذكر منظوم العقود",77,"د",1,0],["ولحظٌ كأن البرق ريش سهامه","يضيء حواشي كل أغبر قاتم",78,"م",1,0],["ولُحتِ وفَحتِ في شَمسٍ ومِسكٍ","فَلاَقَى القَلبُ أصعَبَ ما يُلاَقَى",79,"ق",2,0],["وَلِحِلمِكَ الإِغضاءُ في الإِغضابِ","وَلِنَيلِكَ الإِجداءُ في الإِجدابِ",80,"ب",1,0],["وَلَحْظٍ يَكَادُ الْحُسْنُ يَعْبُدُ حُسْنَهُ","إِذا أَقْلَقَتْهُ لِلْعُيونِ المَضَاجِعُ",81,"ع",1,1],["ولحفظها بالفر أكبر شاهد","لك بالعلى فلم التاسفَ والحزن",82,"ن",1,0],["وَلِحارِثٍ عُرِفَت رِئاسَةُ عامِرٍ","في جاهِلِيَّتِها وَفي الإِسلامِ",83,"م",1,0],["ولحبّه بقلوبنا","ونفوسنا أبقى المعابد",84,"د",1,0],["ولحظ عيون العِين أمضى مضارباً","وأتلفُ للأرواح من قضُب الهندِ",85,"د",1,0],["ولحظ من بني عبس","ووجه من بني بدر",86,"ر",1,0],["ولحناً من أغاريد القوافي","فقل ما شئت من فن وسحر",87,"ر",1,0],["ولحتَ للنفس مثال الخلود","وإن تعامت عن سناك العيون",88,"ن",1,0],["ولُحتَ كما يلوح فَتِيقُ صبح","ومِستَ كما يميس قضيبُ بانِ",89,"ن",1,0],["ولحزبك الأعلون حتى يخرج ال","طاغي ويمنع درهم وقفيز",90,"ز",1,0],["وَلِحُسنِ عَفوِكَ وَهوَ أَوفى ذِمَّةٍ","لِلجارِ أَن يَلقى لَدَيكَ تَهَدُّما",91,"م",2,0],["ولحاظٍ حمى بها طَلعَ ثغرٍ","بَرَدُ الدمع من جفوني نَضِيدُه",92,"د",2,0],["ولحسنه كيف استمال عواذلي","فرأيت حسادي به العذالا",93,"ل",2,0],["ولحظةُ الغيتارِ فوقَ الساقِ","سحليةٌ تَمُرُّ وتشحذُ الإيقاعَ",94,"ع",1,0],["ولحفظِ هيبتها يظلُّ خميسُها","شاكي السلاح بهِ يحفُّ عَتاد",95,"د",1,0],["ولحسنِ نجدتِهم وشدة بأسهم","حكموا على التصعيبِ بالتسهيل",96,"ل",1,0],["وَلحلمه سبحانه يَعصى فَلَم","يمحل عَلى عبد عصى مَولاه",97,"ا",2,0],["وَلِحَرِّها بَرْدٌ عَلَى كَبِدِي إِذا","أَيْقَنْتُ أَنَّ تَحَرُّقِي يُرْضِيهِ",98,"ي",2,0],["وَلَحَظْتَنِي فَعَرَفْتَ مَوْضِعَ خَلَّتِي","نَظَرَ الطَّبِيبِ إلى الْعَلِيلِ الْمُمْرَضِ",99,"ض",1,0],["وَلِحاظٍ هُنَّ خُرصانُ القَنا","رُكِّبَت إِذ أُمهِيَت في شَنتَرين",100,"ن",1,0],["وَلَحمِ حوتٍ طَرِيٍّ","لا مالِحِ الطِّرِّيخِ",101,"خ",1,0],["وَلَحظُكَ مُنتَشٍ صاحٍ وَأَحسِن","بِلَحظٍ مُنتَشٍ يا صاحِ صاحِ",102,"ح",1,0],["وَلِحاظُهُ فيهِنَّ هاروتٌ وَما","روتٌ سِواحِرُ وَهيَ لا تَتَحَرَّجُ",103,"ج",1,0],["ولحظك كم ذا يتيه الخيال","بآفاقه الرحبة النائيه",104,"ي",2,0],["وَلِحُسنِ الظَنِّ لازِمٌ","وَهوَ خِلّي وَحَليفي",105,"ي",1,0],["وَلِحاظِها قَد أَصبَحَت","في مُهجَتي مَشبوكَه",106,"ك",2,0],["وَلَحظُها قَدِ اِنبَرى لِلنُهى","وَنَقطُ الحالِ عَلى خَدِّها",107,"ه",2,0],["وَلِحاظُ مَقرونَةٍ بِالمَنايا","لَو رَآها عَمرُو رَمى الصَمصامَه",108,"م",2,0],["وَلَحِّبي الصَبرُ الجَميلُ زَهِدتُ في ال","جَنّاتِ حينَ رَغِبتُ في النيرانِ",109,"ن",1,0],["ولحيني بانت ولم تشف قلباً","مستهاماً يطير شوقاً إليها",110,"ي",3,0],["وَلحاظ سِيافَة 