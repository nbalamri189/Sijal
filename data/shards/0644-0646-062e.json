{"poems":[[50,"وخيمة ناطور برأس منيفة","https://www.aldiwan.net/poem64489.html","الوافر"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[466,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[491,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[505,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[567,"لنخلة ثابت قبر ينادي","https://www.aldiwan.net/poem52610.html","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77099","الكامل"],[4691,"حنينٌ إلى معزوفة الماءِ والنور","https://www.poetsgate.com/ViewPoem.aspx?id=196824",""],[4782,"الى معلمتي \" الملاك الحارس\"","https://www.poetsgate.com/ViewPoem.aspx?id=208645",""],[5895,"نبض النيل","https://www.poetsgate.com/ViewPoem.aspx?id=198611",""],[5956,"جُلُّ الآداب قميئ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=185791",""]],"verses":[["لِنَخمُسَ مالَ اللَهِ مِن كُلِّ فاجِرٍ","وَذي بِطنَةٍ لِلطَيِّباتِ أَكولِ",0,"ل",1,0],["لنَخُطَّن فوق أرضك سفرًا","بمدادين: من دمٍ، وصديد",1,"د",1,0],["لنخل قُرىً عند العراقِ بواسقٍ","شَهيٍّ إِليهَا طلعُها وكمُامها",2,"م",3,0],["لِنِخبِرَ عَنها أَو نَرى سَروَ أَرضِها","وَقَد يُتعِبُ الرَكبَ المُحِبُّ المُكَلَّفُ",3,"ف",1,0],["لنخلَعَ في الحُبِّ العِذارى تهَتُّكاً","وننظِمَ في أَشواقِ ساداتِنا نَظْمَا",4,"م",2,0],["لنخلةِ ثابتٍ قبرٌ ينادي","أيا ويلاهُ من فَقْدِ الشَّبابِ",5,"ب",1,1],["لِنخيلٍ تَهتَزُّ بِالتِبرِ وَالياقو","تِ حَلّى زَبَرجَدِيَّ الجَريدِ",6,"د",1,0],["لِنَخوَة وَضاح المُحيا لَدى النَدى","بَسالَة عَبّاس الفَوارِس في الكَر",7,"ر",1,0],["لنخلة أحلامي لأعذاقها التي","تجود من الإحساس من غير تقتيرِ",8,"ر",1,0],["لنخطَّ في لوح الوفاء قصيدةً","منكِ استقيناها لعامٍ بعد عام",9,"م",1,0],["لنخيلٍ رصََّّعَ صفحتهُ من فيضِ حَنَانٍ قد أثمرْ","والنجمُ تناثرَ فى مَوْجٍ فتجمَّعَ شَمْساً وَتقَطَّرْ",10,"ر",1,0],["‏ ‏لنخففَ مِن سأم الأوقا","‏ ‏ ت ويصبحَ ما نقرأ ذُخْرا",11,"ر",2,0]]}