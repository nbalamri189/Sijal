78,"","https://poetry.dctabudhabi.ae/diwan/poem/79668","الوافر"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20443","الطويل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/21214","الطويل"],[906,"","https://poetry.dctabudhabi.ae/diwan/poem/20692","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21399","الطويل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/20649","الطويل"],[1190,"","https://poetry.dctabudhabi.ae/diwan/poem/28236","المتقارب"]],"verses":[["وَإِن يَكُ فَخرٌ أَو نِضالٌ فَإِنَّني","لَها يَدُها طَوراً وَطَوراً لِسانُها",0,"ن",3,0],["وإنْ يَكُ في نَجْديِّ قَيْسٍ بَسالَةٌ","فإنّي ابنُ أرْضٍ تُنبِتُ البَطَلَ النَّدْبا",1,"ب",2,0],["وإنْ يَكُ صافِياً وشَلٌ تَمَشّتْ","بجانِبِه الصَّبا فكَذاكَ وُدّي",2,"د",2,0],["وَإِنّي كُلَّ يَومٍ عِن","دَكُم يَحظى بِيَ الساعي",3,"ع",2,0],["وَإِن يَكُ أَقوامٌ رَساؤوا وَأَهجَروا","فَإِنَّ الَّذي بَيني وَبَينَكِ صالِحُ",4,"ح",1,0],["وَإِن يَكُ في أَهلِ الزَمانِ مُؤَمَّلٌ","فَأَنتَ الشَرابُ العَذبُ وَهوَ سَرابُ",5,"ب",1,0],["وَإِن يَكُ وَلّى جَهوَرٌ فَمُحَمَّدٌ","خَليفَتُهُ العَدلُ الرِضى وَاِبنُهُ البَرُّ",6,"ر",1,0],["وَإِن يَكُ قَرَّ عَنكَ اليَومَ جِسمي","فُديتَ فَما لِقَلبِيَ مِن قَرارِ",7,"ر",1,0],["وَإِنّي كَأَشلاءِ اللِجامِ وَلَن تَرى","أَخا الحَربِ إِلّا ساهِمَ الوَجهِ أَغبَرا",8,"ر",2,0],["وَإِن يَكُنِ الحِذارُ مِنَ المَنايا","سَبيلاً لِلحَياةِ فَلِم تَمُتنَه",9,"ن",2,0],["وإن يكن بيت صبري قد ألمَّ به","عديّ دهرٍ فقد سلاّه حاتمه",10,"م",2,0],["وإن يكن قد بكى جفن السحاب فقد","بكى من البرد لي أنفٌ وأجفان",11,"ن",1,0],["وأنّيَ كنت أباهي بها","من استلم الحجر الأسودا",12,"د",2,0],["وأن يكون له بغلٌ وآلته","وأن يسير وقد حَفَّت به الزمر",13,"ر",1,0],["وإن يك لي سبب قاطع","فما أملي فيك بالمنقطع",14,"ع",1,0],["وإن يكن كان أردى مفلحاً عرضاً","فقد تصيب سهام الدهر خِطرافا",15,"ف",2,0],["وإن يكُ جانبٌ لا ظِلَّ فيه","فلي في جانبٍ ظلٌّ ظليلُ",16,"ل",1,0],["وإن يكن ذاك إعناتاً لمَقْليةٍ","فقد غدوتُ بسوء الحال مُرتَهَنا",17,"ن",2,0],["وَإِن يَكُنِ الأَحرارِ مِن نُصَرائِها","فَكَم نَصَرَ الأَحرارَ صاحِبُها الحُرُّ",18,"ر",1,0],["وَإِنّي كَفانِي فَقدُ مَن لَيسَ جازِياً","بِحُسنى وَلا في قُربٍه مُتَعَلَّلُ",19,"ل",1,0],["وَإِن يَكُن قَدرٌ قد عاق عَن وَطَرٍ","فَلا مَرَدّ لما يأتي بِهِ القدرُ",20,"ر",1,0],["وأن يكون موقفي","موقف عاص مجرم",21,"م",1,0],["وأن يكون وفيا","وأن يكون أمينا",22,"ن",2,0],["وأن يكون بأوطا","نه حِفيًّا ضنينا",22,"ن",2,0],["وَإِن يَكُ سَيفَ دَولَةِ غَيرِ قَيسٍ","فَمِنهُ جُلودُ قَيسٍ وَالثِيابُ",23,"ب",1,0],["وَأَن يُكذِبَ الإِرجافَ عَنهُ بِضِدِّهِ","وَيُمسي بِما تَنوي أَعاديهِ أَسعَدا",24,"د",2,0],["وَإِن يَكثُرِ الإِحسانُ مِنكُم فَإِنَّهُ","بِأَنعُمِهِ جازٍ عَلَيهِ وَشاكِرُه",25,"ر",2,0],["وَإِن يَكُ أَضحى لِلمَنِيَّةِ هاشِمٌ","فَأَسوَتُهُ فيها وَفي المَجدِ هاشِمُه",26,"م",2,0],["وإن يكُن مسَّها من جرحِه أَلَمٌ","فطالما أَلِمَت من كَثرةِ القُبَلِ",27,"ل",1,0],["وَإِن يَكُن أَحَدٌ أَولاكَ صالِحَةً","فَكافِهِ فَوقَ ما أَولى بِأَضعافِ",28,"ف",1,0],["وَإِن يَكُ لي في ذاكَ ذَنبٌ فَمَنطِقي","قَصيرٌ وَإِلّا فَالعِتابُ طَويلُ",29,"ل",1,0],["وَإِن يَكُ عَدّا عَن سِواكَ إِلَيكَ بي","رَحيلٌ فَلي في الأَرضِ عَنكَ رَحيلُ",30,"ل",1,0],["وَإِن يَكُ مِن بَني أُدَدٍ جَناحي","فَإِنَّ أَثيثَ ريشي مِن إِيادِ",31,"د",1,0],["وإنْ يكنْ واللهُ يكفي سوى","ذا فالدعا ينفعُ تحتَ الرجامْ",32,"م",1,0],["وإنْ يكنْ عذلُكَ منْ مؤنثِ","فقلْ لها خافي رجالَ العبثِ",33,"ث",1,0],["وإنْ يكنْ قلبي مريضاً بهِ","فاسألُ اللهَ يعافيهِ",34,"ه",1,0],["وإنْ يكنْ كسدَ الورديُّ في حلبٍ","فالمندلُ الرطبُ في أوطانِهِ حَطَبُ",35,"ب",1,0],["وَإِن يَكُ لِلخِلَّينِ ثَمَّ اِلتِقاءَةٌ","فَيا لَيتَ شِعري أَينَ أَو كَيفَ نَلتَقي",36,"ق",2,0],["وَإِنّي كَتومُ حُبِّها في ضَمائِري","فَيا لَيتَ حُبّي كامِنٌ في ضَميرِها",37,"ر",3,0],["وَإِن يَكُ لا لَيلى وَلا نَجدُ فَاِعتَرِف","بِهَجرٍ إِلى يَومِ القِيامَةِ وَالوَعدِ",38,"د",1,0],["وإن يكن كاذباً فالسَّيفُ صاحبُهُ","والسَّيفُ صاحبُ صدقٍ غيرِ مَذَّاقِ",39,"ق",1,0],["وإن يكُ مِنكَ مغفرةٌ وعَفْوٌ","شكرتُكَ والقَوِيُّ له احْتِكَامُ",40,"م",1,0],["وَإِن يَكُ صُرماً أَو دَلالاً فَطالَ ما","بِلا رِقبَةٍ عَنَّت سُلَيمى وَمَلَّتِ",41,"ت",1,0],["وَإِن يَكُن لِلقَومِ ساقٍ يُعشَقُ","فَجَفنُهُ بِجَفنِهِ مُدَبِّقُ",42,"ق",1,0],["وَإِنِّيَ كَالعَطشانِ طالَ بِهِ الصَدى","إِلَيكَ وَلَكِن ما الَّذي أَنا صانِعُ",43,"ع",1,0],["وإنْ يُكَذِّب نِسبَتِي جِئْتُهُ","بِجُبَّتي الصُّوف وَدَفَّاسِي",44,"س",2,0],["وإن يكُنْ عَقلُ مَن ناواه مخْتَبَلاً","فإنّ للنّصْلِ عَقلاً غيرَ مُختَبَل",45,"ل",1,0],["وَإِنّي كُنتُ لا أَنسى","فَقَد أَصبَحتُ لا أَذكُر",46,"ر",1,0],["وَإِنّي كُلَّما شِئتُ","بِمَن أَهوى تَعَلَّيتُ",47,"ت",1,0],["وَإِن يَكُن في مَوتِنا راحَةٌ","فَالفَرَجُ الوارِدُ مِنّا قَريب",48,"ب",1,0],["وَإِن يَكُ في الدُنِّيا سَعودٌ فَإِنَّما","تَكونُ قَليلاً كَالشَذوذِ الشَوارِدِ",49,"د",1,0],["وإن يَكُ وادينا من الشِّعْرِ نَبْتُهُ","فغيْرُ خفِيّ أثْلُهُ من ثُمامهِ",50,"م",2,0],["وأَنْ يكونَ عاملاً في طاعتِهْ","على دُرورِ الخَرْجِ مِن جِبايتِهِ",51,"ه",1,0],["وإن يكُنْ فرطُ وجدي في مَحَبّتِكُمُ","إثْماً فقد كَثُرَتْ في الحبّ آثامي",52,"م",2,0],["وإني كريم لم أقصر عن العلى","أب وارث مجد الكرام جدودها",53,"د",3,0],["وإني كَغَيري لست في الأرض خالداً","وإني وإن طال الزَمان لمودي",54,"د",2,0],["وإِنْ يَكُنْ ذَاكَ مِقْدَاراً أُصِبْتُ بِهِ","فَسِيرَةُ الدَّهْرِ تَعْوِيجُ وتَقْوِيمُ",55,"م",1,0],["وَإِن يَكُ عَن لَيلى غِنىً وَتَجَلُّدٌ","فَرُبَّ غِنى نَفسٍ قَريبٌ مِنَ الفَقرِ",56,"ر",1,0],["وإن يَكُنْ مُحَرَّكاً فَسكِّنا","فذلكَ المُضمَرُ حَقاً بَيِّنا",57,"ن",2,0],["وإن يكُن هذا الذي يَزولُ","مُحرَّكاً فإنّهُ المَعقولُ",57,"ل",1,0],["وإنْ يكُنْ محرَّكاً سَكَّنْتهُ","فَسمِّهِ المَعصوبَ إنْ سمَّيتَهُ",57,"ه",1,0],["وإنْ يكُنْ أعصبَ ثم يُعْقلُ","فذلكَ الأَجمُّ ليسَ يُجهلُ",57,"ل",1,0],["وإنْ يكُنْ مُحرَّكاً فأُذْهِبا","فذلكَ المَكسوفُ حقّاً مُوجِبا",57,"ب",2,0],["وإنْ يكُن هذا وذا مُعاقبا","فهو يُسمَّى طَرفين واجبا",57,"ب",2,0],["وإنْ يكُنْ أَذهبَهُ النُّقصانُ","فافْهمْ ففي قولي لك البَيانُ",57,"ن",1,0],["وإِنْ يَكُ حُبَّ النَّفْسِ وَالوُلْدِ شِرْعَةً","فَحُبِّ البِلاَدِ الفَرْضُ وَالآخَرُ النَّفْلُ",58,"ل",1,0],["وإِنْ يَكُ دَهْرِي ضَمَّنِي ثمّ ضامني","فإِنَّ عَلِيَّاً خيرُ مَوْلىً ومْوئلِ",59,"ل",1,0],["وإنْ يكنْ كالتاج فوقَ الهامِ","قد كان رمزَ الجد الإقدامِ",60,"م",1,0],["وإنْ يكُ منيَة ٌ عجِلَتْ بشيءٍ","تُسَرُّ بهِ فإنَّ لَهَا ذَهَابَا",61,"ب",2,0],["وأني كالليل بادي الهموم","وأني كالنجم لم انعس",62,"س",1,0],["وإِنْ يَكَ أَقوامٌ أساؤوا وأهجروا","فإنَّ الذي بيني وبينكِ صالحُ",63,"ح",1,0],["وإن يك لا ليلى ولا نجد فاعترف","بهجر يوم القيامة والوعد",64,"د",1,0],["وَإِن يَك في ثَغر الحسان عُذوبة","فَفي ثَغر مَن أَهوى عَذيب وَبارق",65,"ق",1,0],["وَإِن يَكُ في الوَرى أَزرى فَقَدري","سَما يَسمو سُمُوّاً فَهُوَ سامي",66,"م",2,0],["وَإن يكُن يُربى عَلَيهِ العَدَد","أَيقَنتَ أنَّ ذاكَ لا يَنعَضِد",67,"د",1,0],["وَإِن يَكُ يَومٌ رابِعٌ لا أَعُد لَهُ","وَإِن يَكُ يَومٌ خامِسٌ أَتَنَكَّبِ",68,"ب",1,0],["وَإِن يَكُ مُختَاراً وَطَالت فَمَيتَةٌ","لِتَقصِيرِهِ في رَفعِهِ وبِدَارِهِ",69,"ر",2,0],["وإن يَكُ إتمَامُ الذَّكَاةِ يَقِينَهُ","لَدَى رَفعِهِ حلَّت لَهُ لاِغتِرَارِهِ",69,"ر",2,0],["وإِن يَكُ وَجهَها فَلَقَد أعَارَت","بِلَمحَتِهِ السَّنَا بَدرَ التَّمَامِ",70,"م",1,0],["وإِن يَكُ مُقفِرَ العَرَصَانِ ما إِن","تَرَى العَينَانِ فِيهِ مِن أرَيمِ",71,"م",1,0],["وِإن يَكُنِ البَتُول فَإنَّ عِندِى","لها ولِمَن يُجَاوِرُهَا إشتِيَاقَا",72,"ق",2,0],["وإن يَكُ عَنهُ اليومَ أصبَحَ آبِياً","فهذا الفتى المرضُّى تَسخٍيرُهُ زُعرُ",73,"ر",1,0],["وإن يكُ ناظرٌ قد غض عنه","فكم بين الوزارة من خبيرِ",74,"ر",1,0],["وإن يكن قد بٌعدَت داره","فشخصُه مني دواماً قريبْ",75,"ب",1,0],["وَإِن يَكُن ما بَلَغتَ اليَومَ مُذهِلَهُم","فَإِنَّهُ دونَ ما تَرجو وَتَرتَقِبُ",76,"ب",1,0],["وان يكن ساخطا منه فلا حرج","لا يحمل الوزر إلا ظهر جانيه",77,"ي",2,0],["وإن يكن قوله كفراً وتابعه","في الكفر يمشي به في أضيق الشعب",78,"ب",1,0],["وَإِن يَكتَسِب مالاً يَقولوا بهيمَةٌ","أَتاها مِنَ المَقدورِ حَظٌّ وَنائِلُ",79,"ل",1,0],["وإن يك منهم أصلي فمنهم","قرابين الإله بني قصيّ",80,"ي",1,0],["وَإِني كَما تَهوُون لا مُتهاوِناً","وَلا سائِلاً فيما أكلِّفهُ أَجرا",81,"ر",2,0],["وإِن يكتسب مالا يقولوا بهميةٌ","أتاه من المقدور حظ وطائل",82,"ل",1,0],["وإني كمثل السيف متناه كالوطا","وبين غراري مضربيه غرور",83,"ر",1,0],["وَإِن يكُ في شيءٍ بهِ شبهٌ بها","فَذاكَ كَما قد أشبهَ الذهبُ الصفرا",84,"ر",2,0],["وَأَن يكونَ المُصطفى نصيري","وَدعوةً صالحةً مِن بعدي",85,"ي",1,0],["وإن يكن الزمانُ لهُ أميرٌ","فمن فيهِ لذا الدهرِ احتقارُ",86,"ر",1,0],["وإن يكن مثلي العشاقُ قد هجروا","فأينَ ميلُ قلوبُ الناسِ للناسِ",87,"س",1,0],["وان يك عن موسى وعيسى زمانه","تأخر فهو السابق المتقدم",88,"م",1,0],["وان يك قد ولى وايامه انطوت","فعرف نداه بالثناء له نشر",89,"ر",1,0],["وان يكن العمري قد غاب عنكم","فما غاب عنكم جود نائله الغمر",89,"ر",1,0],["وإن يكن من غابر كنال","فافتحه واكسر ان يكن مثالا",90,"ل",2,0],["وأن يكون راضياً بما قضى","ولم يكن لحكمه معترضا",91,"ض",2,0],["وَإِن يَكُن جاعَ فَلا مَأكَلٌ","يَغذوهُ إِلّا ذلِكَ العَلقَمُ",92,"م",1,0],["وإن يك درهمُه زائفاً","فإنّي لزائفه ناقد",93,"د",1,0],["وإن يكن أحمدُ الكنديُّ متَّهماً","بالفخر قبلي فإني لستُ أُتَّهَمُ",94,"م",1,0],["وإن يكن ما فاهَ بالشكر فقد","أغنى لسانُ الدمع عن لسانهِ",95,"ن",2,0],["وإن يكن في النفوس الطيب فاح لهم","راحٌ وريحان روض طابَ بالزهر",96,"ر",1,0],["وإني كي أُمثِّلكنَّ ليلاً","بتذكارٍ رغِبتُ عنِ الرقاد",97,"د",1,0],["وان يكن بشرا من قوم اِشتَبَهوا","خلقا فَما صفر كالاشهر الحرم",98,"م",1,0],["وان يك عقنى صحبي وَجاري","فَجودك بالَّذي أَرجوه جاري",99,"ر",2,0],["وَإِني كُلَّما غَفَلُوا ونَامُوا","أسَامِر في الثّناءِ ابْنَيْ سَميرِ",100,"ر",1,0],["وإن يك قد أودى فكم من أسنةٍ","مركبةٍ من قوله في عوامل",101,"ل",1,0],["وإن يكن ثَمَّ حَسد","أَنشَبَ إِنشاب الأسد",102,"د",1,0],["وإِن يَكُن عدوّا","وكاشِحاً مجفوّا",102,"ف",3,0],["وإِنْ يَكُ لا فعندي كلُّ همٍّ","يضيقُ ببعضه الفطن اللَّبيق",103,"ق",1,0],["وَإِنْ يك ليس بدّ من سؤالٍ","فما عن خالتي لي من محيد",104,"د",1,0],["وَإِن يكُ فيه للبدويّ طبٌّ","فَلِلحضريّ أَسقامٌ وداء",105,"ا",2,0],["وَإِن يَكُن رَسمُ نَفسِ الشَيخِ مُنطَبِعاً","عَلى القُلوبِ وَحاشا الفِكرَ نِسيانِ",106,"ن",1,0],["وَإِن يَكُن عِندَهُم نارٌ لِتَدفِئَةٍ","قالوا لِأُمِّهِم بَولي عَلى النارِ",107,"ر",1,0],["وَإِن يَكُ بعدُ الدار قَد حالَ بَينَنا","فَما زالَ قُرب القَلب أَقوى وَأَحكَما",108,"م",2,0],["وإن يك ذو القَرنَيْنِ أحكمَ سَدَّهُ","بما شاع من تَمكينِه المُتكامل",109,"ل",1,0],["وإن يك للأشياء في العَينِ ظاهرٌ","فذو اللُّبِّ أحياناً عنِ اللُّبِّ يَبْحث",110,"ث",1,0],["وإن يكُ فَرْضُ الوَقْتِ فات فجائِزٌ","متى ذَكَرَ النّاسي قَضاءُ الفَوائت",111,"ت",1,0],["وإن يك نظْمٌ حال عن عهدِ حُنه","فطُولُ اللّيالي للأنامِ سَلوب",112,"ب",1,0],["وأنِّي كأنِّي أرَى المكرُماتِ","مَناماً ولكنَّه قد تَفَسر",113,"ر",1,0],["وإن يكن خاليا ليس به أحد","فاجلس به واعتكف فيه تجد نورا",114,"ر",2,0],["وَاِن يَكن قَد لامَني","شَيبيَ فيهِ وَعَذَلَ",115,"ل",1,0],["وإِن يك مدلولاً عليّ فإنني","أخو الحرب لا قَحمٌ ولا متجاذِعُ",116,"ع",1,0],["وإن يَكن حادِث يُخشى فَذو علَقٍ","تَظلُّ تزبُرُهُ مِن خشيَةِ الذِّيبِ",117,"ب",1,0],["وإن يكن غيرها والحرُّ مُمتَحَنٌ","فما عَلَى مَن أقام العذرَ بالطّلبِ",118,"ب",1,0],["وإن يكن عادلاً فكنت وإن يكن ال","أخرى ففي النار من أقران قارون",119,"ن",1,0],["وإنْ يكُنْ في دهرِنا","ذو أُبْنَةٍ لاطِ فَهُو",120,"و",1,0],["وإن يكن وأحاشي مجده ثَلَجت","عُتباه حرَّ حشاً بالهمِّ مُحترِقِ",121,"ق",1,0],["وإني كما شاء الغرام موحّد","وإن ملت تمويها إلى الروضة الغنا",122,"ن",2,0],["وإن يكُ بين جسمينا بعاد","فإن القرب بالأرواح منا",123,"ن",2,0],["وإن يكُ قد شط المزار فلم يزل","جمالك ف عيني وشخصك في قلبي",124,"ب",2,0],["وإن يكن قد غدا في اللحد مستتراً","فذكره في ذرى الأفلاك منتهضُ",125,"ض",1,0],["وإن يكن أحمر الأحداق مكتحلاً","فذاك أجود من ذي الأعين الصفر",126,"ر",1,0],["وإن يكن بالغ المدّاح في سلفٍ","لكن فيك خلالاً فوق مدحهمِ",127,"م",1,0],["وإن يك فيه مدحي باختصار","فقد فاضت عطاياه الوفيّه",128,"ي",2,0],["وإن يكن أمسى قتيلاً أنهُ","في روضة الشهداءِ لاح سعيدا",129,"د",2,0],["وإن يكن جالسا في صدر مجلسه","تقل هو الشمس حلت دارة الحمل",130,"ل",1,0],["وإِنْ يَكُنْ فِيَّ جسمٌ عن ذَراكَ مَضَى","فإِنَّ عندكَ قلبًا في ذراك يَقِي",131,"ق",2,0],["وإنّي كمن قوم همُ يثجُ العُلا","ورأبُ الثأى والعارضُ المندفقُ",132,"ق",1,0],["وإِن يَكُ قُدْوَةَ الكُرمَاءِ جُوداً","فإِنَّكَ بالمكارِمِ ذُو اقْتِداءِ",133,"ا",2,0],["وإِنْ يَكُ فِي سَرْوِ اليَمانِينَ أَصْلُهُ","فطاعتُهُ فِي عَبدِ شَمْسٍ وَوُدُّهُ",134,"د",2,0],["وإِنْ يَكُ مسبوقاً فيا رُبَّ سابقٍ","بعيدِ المَدى لا يدَّعِي معَهُ سَبقا",135,"ق",2,0],["وإن يك ذكر ليلى زاد عندي","شجى بين المحنق والوريد",136,"د",1,0],["وإِن يك أصل العمر منك فقد ذوى","فحسناك منه الغصن ريان مورق",137,"ق",1,0],["وإن يكن لي في قلبي بنظرتهش","حُرُّ المواطنِ أني حلَّ أو رَحلاَ",138,"ل",2,0],["وإن يكن في حليفي الصبر لي سَندٌ","كالأنبياء يهُّز الحصن والجبلا",138,"ل",2,0],["وإن يكن صدٌّ يسوء الهوى","أو جفوةٌ تهتِك سِتر الكَتومْ",139,"م",1,0],["وإن يكن هوَّمَ فيها ناسياً","وعاجَ عن طريقها وجَنَّبا",140,"ب",2,0],["وإني كنتُ وعاشَ الفقيدُ","فخلدَ لو أنَّ حياً خلَد",141,"د",1,0],["وَإِن يَكُن عِندِيَ لَوزَينَجٌ","مَلَأتُ مِنهُ لَكَ زُبدِيَّه",142,"ي",2,0],["وَأَن يَكونَ قَنوعاً","فَالعِزُّ في الإِقتِناعِ",143,"ع",1,0],["وَأَن يُكرِمَ الشَيبَ إِن زارَهُ","وَيَستُرَ عَنهُ وُجوهَ الكُؤوسِ",144,"س",1,0],["وإن يك مشعر الحرم افتخاري","فإنك مشعر الكرم اختياري",145,"ر",2,0],["وإن يكن الوزير سما إليها","بكاف من كمال اللب كاف",146,"ف",1,0],["وإن يك حظه منهن حظّاً","على المرباع منا والصفايا",147,"ا",3,0],["وإِن يكنْ قد لعِبَتْ","بكلِّهِ أَيدي سَبَا",148,"ب",2,0],["وإنّي كما العُرْبِ حطامُ نخيلِ","وأرضي مفازةٌ لكلّ دخيلِ",149,"ل",1,0],["وأنّي كنتُ في عادٍ","وهم يبنونَ بُنيانا",150,"ن",2,0],["وإن يكن في المعاد لقيا","فدونه مدة بطيه",151,"ط",3,0],["وإنْ يَكُنْ لا بُدَّ مِنْ صَدْمَةٍ","فَخَيْرُها في الصَّبْرِ والحِلْمِ",152,"م",1,0],["وَإِن يَكُ غَدرٌ نالَهُ مِن مُنافِقٍ","فَإِنَّ لَهُ العُقبى إِذا النَعلُ زَلَّتِ",153,"ت",1,0],["وإنْ يكن ذاكَ تعويقاً لشرّكمُ","فينا فيا حبّذا الأشغالُ من عُقَلِ",154,"ل",1,0],["وإن يَكُ نجمٌ غار بعد طلوعه","فقد ملأتْ منك الشّموسُ المشارقا",155,"ق",2,0],["وَإِنْ يَكُن من رسول اللَّه غيركُمُ","سوى الوجود فأنتمْ عنده الحدَقُ",156,"ق",1,0],["وَإنّي كَفيلٌ بِالنّجاء منَ الأذى","لِمن لَم يَبتْ يدعو سوى اللَّه ناصرا",157,"ر",2,0],["وَإِنِّيَ كَالدَلوِّ في حُبِّكُم","هَوَيتُ إِذا اِنقَطَعَت عَرقُوَه",158,"ه",1,1],["وَإِن يَكُن شَبَّها حَرباً وَقَد خَمَدَت","فَنائِياً حَيثُ لا هَيدٍ وَلا هيدِ",159,"د",1,0],["وإن يكن غالباً شخصٌ سواه على","مكانه ينصرف عن ذاك تهوينا",160,"ن",2,0],["وإن يكونوا جهلوا","فروضهم والسننا",161,"ن",2,0],["وإن يكن في النفوس الطيب فاح له","بين البرية ريا عنبرٍ عطِر",162,"ر",1,0],["وإن يكن قدَّر المولى له غرقاً","فهو الغريق وإن أُلقِي بصحراء",163,"ا",2,0],["وإنْ يكُنْ ذاكَ من جنسِ الحِلَى نَسَباً","فهكذا الماسُ معدودٌ من الحجرِ",164,"ر",1,0],["وإنْ يكنْ فاتَهُ نهرُ السّلامِ ففي","دارِ السّلامِ لهُ الأنهارُ تَنفجِرُ",165,"ر",1,0],["وإن يكن كما زعمت لم يقم","خليفة من بعده فأنت لم",166,"م",1,0],["وإن يكن لم يأمر الجليل","به ولا أتى به الرسول",166,"ل",1,0],["وإن يكن نبيه دعاه","لم يدعه إلا وقد رآه",166,"ه",1,0],["وإن يكن ذاك من الدلائل","فإن عرموا غزوة السلاسل",166,"ل",1,0],["وأن يكون موضع الرسول","تبا لنقص الرأي والعقول",166,"ل",1,0],["وإن يكن بغاهم المؤدي","فأخذه الشطر لهم تعدي",166,"ي",1,0],["وإن يكونوا غير ذاك أضمروا","فإنما الحكم على ما يظهروا",166,"ر",3,0],["وإِن يكن بالحبِّ حقّاً للورَى","نَقْصِي فبالأَفضل بان فَضْلِي",167,"ل",2,0],["وأن يكن الواشون بالظن أكثروا","من القيل في الإخوان زوراً متبرا",168,"ر",2,0],["وَإِن يَكُ شَيبٌ قَد عَلاني فَرُبَّما","أَراني في ريعِ الشَبابِ مَعَ المُردِ",169,"د",1,0],["وإِن يك مجدٌ في تميمٍ فإنّه","نماني اليفاع نهشلٌ وعُطارِدُ",170,"د",1,0],["وإنْ يكُ صادقا بالتَّيْم ظَنِّى","يشُبُّ الحربَ ألويةٌ كرامُ",171,"م",1,1],["وَإِنّي كَما قَد تَعلَمينَ لَأَتَّقي","تُقايَ وَأُعطي تِلاديَ لِلحَمدِ",172,"د",1,0],["وَإِن يَكُ بَرقاً فَهوَ بَرقُ سَحابَةٍ","لَها رَيِّقٌ لَن يُخلِفَ الشَيمَ رائِعُ",173,"ع",1,0],["وإن يكُ حقّاً يا خديجةُ فاعلمي","حديثُكِ إيّاها فأحمدُ مرسلُ",174,"ل",1,1],["وَإِنّي كَريمٌ ذُو عيالٍ تَهُمُّني","نَوائِبُ يَغشى رُزؤُها وَحقوقُ",175,"ق",1,0],["وَإِن يَكُ أَمرٌ غَيرَ ذاكَ فإِنَّني","لَراضٍ بِقَدرِ اللَهِ لِلحَقِّ عارِفُ",176,"ف",1,0],["وإِن يَكُ قَتلٌ لا أَبالَكَ نَصطَبِر","عَلى القَتلِ إِنّا في الحُروبِ أُلو صَبرِ",177,"ر",1,0],["وَإِن يَكُ مِن كَعبِ بِن يِشكُرَ مَنصِبي","فَإِنَّ أَبانا عامِرٌ ذو المَجاسِدِ",178,"د",1,0],["وَإِن يَكُنِ الحَمدُ في باذِخٍ","مِنَ المَجدِ أَسلُك إِلَيهِ سَبيلا",179,"ل",2,1]]}