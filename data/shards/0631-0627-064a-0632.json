{"poems":[[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[466,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122732","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137637",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106861","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62945","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66219","الوافر"],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""]],"verses":[["رأى زينة الدنيا غروراً فعافها","فليس له إلا على الفضل حاسدُ",0,"د",1,0],["رأى زمَناً حبسَ اللهُ في","ه قَطْر الغمامِ بما قد جَنى",1,"ا",1,0],["رأى زُخْرف الدنيا بعينٍ بصيرةٍ","سواءٌ عليها تِبْرُها ورَغامُها",2,"م",3,0],["رَأى زُبَرَ الحَديدِ تَمُوجُ بَحراً","وَجِنَّةَ عَبقَرٍ فَوقَ السَّعالي",3,"ل",2,0],["رأى زوجه فقدت روعها","وأولاده حولها معولينا",4,"ن",2,0],["رأى زرقةً بين عينيك قد","وسعت السماء بها والبحارا",5,"ر",2,0],["رأى زَرَدَاً يثنى الحديدَ حديده","ومعتركاً فيه الرؤوس تُطوَّحُ",6,"ح",1,0],["راى زَهْوَ الحَياةِ فَهامَ فِيهِ","وما يَبْقَى لَهُ زَهْوُ الحياةِ",7,"ه",1,0],["رائز الخلْقِ سرّه عند ربي","ليس بالوقت تُستشفُ الروائز",8,"ز",1,0],["رَأَى زُهُورًا بَكَتْ مِنْ حَرِّ فُرْقَتِهَا","وَطَارِقَ الْبَيْنِ قَدْ أًهْدَاهُ أَنْوَاءَه",9,"ا",3,0]]}