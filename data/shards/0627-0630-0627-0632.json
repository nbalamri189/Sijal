,"https://www.aldiwan.net/poem50173.html","الطويل"],[409,"لئن غربت شمسي المنيرة في النوى","https://www.aldiwan.net/poem32340.html","الطويل"],[409,"أسير إلى أرض الأعادي وفي الحشا","https://www.aldiwan.net/poem32494.html","الطويل"],[416,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[416,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[416,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[416,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[432,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[441,"أعيدي بديع النوح ويك أعيدي","https://www.aldiwan.net/poem14453.html","الطويل"],[453,"إلى ابن حبيب من ثنائي أجله","https://www.aldiwan.net/poem61789.html","الطويل"],[458,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[458,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[458,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[458,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[471,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[477,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[513,"إذا زار الحبيب أثار شوقا","https://www.aldiwan.net/poem67706.html","الوافر"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[551,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[551,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[562,"مضى الشيخ مرعي راحلا عن ديارنا","https://www.aldiwan.net/poem52522.html","الطويل"],[562,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[562,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[587,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["إِذا زُرتَهُ وَالوَهنُ يَحرِقُ نابَهُ","ثَنى صَرفَهُ عَنّي وَأَنيابُهُ دَردُ",0,"د",1,0],["إِذَا زَارَ مَغْناهُمْ كَريمٌ فَما لَهُ","إِليْهَمْ إِذَا حُمَّ الفِرَاقُ رُجوعُ",1,"ع",1,0],["إذا زُجِرَتْ منهُنَّ وَجْناءُ خِلْتَها","وقد مسّها الإعياءُ ذاتَ عِقالِ",2,"ل",1,0],["إذا زارَهُمْ خِلٌّ مُقِلٌّ لَوَوْا بهِ","مَناخِرَ لمْ يَعْطِسْ بهِنَّ كَريمُ",3,"م",1,0],["إذا زُمَّ للبَيْنِ الغَداةَ جِمالُ","فَلا وَصْلَ إلا أنْ يَزورَ خَيالُ",4,"ل",1,1],["إِذا زُرتُكُم قُلتُم نَزوعٌ وَإِن أَدَع","زيارَتَكُم يَوماً يَكُن مِنكُم عَتبُ",5,"ب",1,0],["إِذَا زَعَمَتْ شَمْسُ الظَّهِيرَةِ أَنَّهُ","أَخُوهَا بِلا شَكٍّ فَقَدْ صَدَقَ الزَّعْمُ",6,"م",1,0],["إِذَا زَأَرَتْ عَنْ جَانِبَيَّ أَجَابَهَا","رُغَاءٌ يُبَارِي زَأَرَهَا وَصَهِيلُ",7,"ل",1,0],["إِذا زارَهُ يَوماً صَديقٌ كَأَنَّما","يَرى أَسَداً في بَيتِهِ وَأَساوِدا",8,"د",2,0],["إِذا زُرتَ رَهنَ المَحبَسَينِ بِحُفرَةٍ","بِها الزُهدُ ثاوٍ وَالذَكاءُ سَتيرُ",9,"ر",1,0],["إِذا زادَهُ جَنياً وَشَماً مُتَيَّمٌ","ذَكا وَردُ خَدَّيهِ وَزادَ اِحمِرارُهُ",10,"ر",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِم","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",11,"ر",2,0],["إِذا زَجَرَت أَلفَيتُها مُشمَعِلَّةً","تُنيفُ بِعَذقٍ مِن غُروسِ اِبنِ مُعنِقِ",12,"ق",1,0],["إِذا زَجَروها في الصَريخِ وَطابَقَت","طِباقَ كِلابٍ في الهِراشِ وَهَرَّتِ",13,"ت",1,0],["إِذا زَفَّ جُنحَ اللَيلِ زَفَّت عِراضَهُ","إِلى البَيضِ إِحدى المَخمَلاتِ الذَعالِبِ",14,"ب",1,0],["إِذا زَاحَمَت رَعناً دَعا فَوقَهُ الصَدا","دُعاءَ الرُوَيعي ضَلَّ في اللَيلِ صاحِبُه",15,"ب",2,0],["إِذا زارَها القَينُ العِراقِيُّ ذَبَّحَت","فِراخَ حَمامٍ باضَ خِزياً حَمامُها",16,"ه",2,0],["إِذا زُرتُها حالَ الرَقيبانِ دونَها","وَإِن غِبتُ شَفَّ النَفسَ عَنها هُمومُها",17,"م",3,0],["إذا زلدوا ناراً ليوم كريهة","سبقنا إلى إيقادها من تَنَورَّا",18,"ر",2,1],["إِذَا زَخَرَت إِليَّ بُحُورُ قَيس","بِخَيرِ عُمُومَةِ المُتَعَمِّمِينَا",19,"ن",2,0],["إِذا زَفَّتِ الأَنصارُ حَولَ مُحَمَّدٍ","بِجَيشٍ كَيَمٍّ مُزبِدٍ حينَ يَزخُرُ",20,"ر",1,0],["إذا زُرتني فالروحُ والمالُ هينٌ","وكلُّ الذي فوقَ الترابِ تراب",21,"ب",1,0],["إذا زُرتَ أرضاً زالَ محلُ ديارِها","وأخرجَ منها خائفاً يترقب",22,"ب",1,0],["إذا زعماء القوم همَّت بشأوهِ","فقد طلبت شأو النجوم بزعمها",23,"م",3,0],["إذا زاره من طالبي العرفِ مادحٌ","هجا شعره بالحق لا يتجرمُ",24,"م",1,0],["إِذا زَعزَعَتهُ الريحُ جَرَّ ذُيولَهُ","كَما زَحَفَت عوذٌ ثِقالٌ تُطَفِّلُ",25,"ل",1,0],["إِذا زَلَّ عَنها السَهمُ حَنَّت كَأَنَّها","مُرَزَّأَةٌ عَجلى تُرِنُّ وَتُعوِلُ",26,"ل",1,0],["اذا زأرت فاني مثل راعدة","او انقضضت فاني شبه اعصار",27,"ر",1,0],["إذا زحموا الضياغم في مجاز","أبادوها وكانوا العابرينا",28,"ن",2,0],["إِذا زُلزِلَت مِن حَولِكَ الأَرضُ رادَها","وَقارُكَ حَتّى تَسكُنَ الجَنَباتُ",29,"ت",1,0],["إِذا زُرتَ يا مَولايَ قَبرَ مُحَمَّدٍ","وَقَبَّلتَ مَثوى الأَعظَمِ العَطِراتِ",30,"ت",1,0],["إِذا زَلِفَت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",31,"م",1,0],["إِذا زارَ سَيفُ الدَولَةِ الرومَ غازِياً","كَفاها لِمامٌ لَو كَفاهُ لِمامُ",32,"م",1,0],["إِذا زَمجَرَ النوتِيُّ فَوقَ عَلاتِهِ","رَأَيتَ خَطيباً في ذُؤابَةِ مِنبَرِ",33,"ر",1,0],["إِذا زَورَةٌ مِنهُ تَقَضَّت مَعَ الكَرى","تَنَبَّهتُ مِن فَقدٍ لَهُ أَتَفَزَّعُ",34,"ع",1,0],["إِذا زالَ زُلنا ناصِبينَ كَمَنزِلٍ","يُعَفّيهِ سافٍ مِن جَنوبٍ وَشَمأَلِ",35,"ل",1,0],["إِذا زَرودُ دَنَت مِنّا صَرائِمُها","فَلا مَحالَةَ مِن زَورٍ يُواقينا",36,"ن",2,0],["إِذا زادَ في غَيظِهِ بَغيُهُم","وَأَنكَرتَ ظاهِرَ عِرفانِهِ",37,"ن",2,0],["إِذا زَخَرَت قَيسٌ وَخِندِفُ وَاِلتَقى","صَميماهُما إِذ طاحَ كُلُّ صَميمِ",38,"م",1,1],["إِذا زَخَرَت حَولي الرُبابُ وَجاءَني","لِمُرٍّ أَواذِيُّ البُحورِ الخَضارِمِ",39,"م",1,0],["إذا زارَها وَفْدُ الرِّضاعِ تَبرَّعَتْ","بِعَذْراءَ لا يَهوى الفِطامَ رضيعُها",40,"ع",3,0],["إِذا زُرتَ المُلوكَ فَكُن رَئيساً","بَصيراً بِالأُمورِ رَحيبَ صَدرِ",41,"ر",1,1],["إِذا زينَةُ الدُنيا مِنَ المالِ أَعرَضَت","فَأَزيَنُ مِنها عِندَنا الحَمدُ وَالشُكرُ",42,"ر",1,0],["إِذا زَهَّدَتني في الهَوى خيفَةُ الرَدى","جَلَت لِيَ عَن وَجهٍ يُزَهِّدُ في الزُهدِ",43,"د",1,0],["إِذَا زَادَ عُمْرُ الْمَرْءِ قَلَّ نَصِيبُهُ","مِنَ الْعَيْشِ وَالنُّقْصَانُ آفَةُ مَنْ نَمَا",44,"م",2,0],["إِذا زُرتُ نُعماً لَم يَزَل ذو قَرابَةٍ","لَها كُلَّما لاقَيتُها يَتَنَمَّرُ",45,"ر",1,0],["إِذا زارَ خَطبٌ خَفَّرَتني ثَلاثَةٌ","سِنانٌ وَعَضبٌ صارِمٌ وَجَوادُ",46,"د",1,0],["إِذا زَلزَلَ اليَأسُ صَرحَ الرَجاءِ","وَمالَ بِأَركانِهِ وَالجُدُرْ",47,"ر",1,0],["إذا زَعْزَعَتْهُنَّ الرّياحُ تَزَعْزَعَتْ","مَواكِبُ مُرّانِ الوشيجِ المُقَوَّم",48,"م",1,0],["إذا زَفَرَتْ غَيظاً ترَامَتْ بمارجٍ","كما شُبّ من نَارِ الجحيمِ وقُود",49,"د",1,0],["إذا زارها انحطّتْ عُقابُ مَنيّةٍ","وليسَ لها إلاّ الجَماجِمُ أفرُخُ",50,"خ",1,0],["إِذا زَخَرَت لَنا مُضَرٌ وَسارَت","رَبيعَةُ ثُمَّتَ اِجتَمَعَت نِزارُ",51,"ر",1,0],["إِذا زُرتَ أَطلالاً بَقينَ عَلى اللِوى","مَلَأنَكَ مِن شَوقٍ وَهُنَّ عُذوبُ",52,"ب",1,0],["إِذا زُيَّنَّ في أَيّامِ حَفلٍ","بَدَت خَيلُ المَريدِ مُسَوَّماتِ",53,"ت",1,0],["إِذا زادَكَ المالُ اِفتِقاراً وَحاجَةً","إِلى جامِعيهِ فَالثَراءُ هُوَ الفَقرُ",54,"ر",1,1],["إِذا زارَتِ الشَربَ المَراجيحَ هَتَّكَت","فَلَم تَتَّرِك فيهِم إِزاراً وَلا أَزرا",55,"ر",2,0],["إذا زحمتني الجلّى بروع","جمعت لها الإباء فلا براحا",56,"ح",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِما","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",57,"ر",2,0],["إذا زارك العافُون كان إيابُهم","إيابَ بشيرٍ لا إيابَ نذيرِ",58,"ر",1,0],["إِذا زَلِقت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",59,"م",1,0],["إِذَا زَرُودُ دَنَتْ مِنَّا صَرَائِمُها","فَلاَ مَحَالَةَ مِنْ زَوْرٍ يُوَافِينا",60,"ن",2,0],["إذا زال لم يسمع بطيب ذكره","ولم ير ذاك اللهو منه منير",61,"ر",1,0],["إذا زلّ عنها السهمُ ، حَنَّتْ كأنها","مُرَزَّأةٌ ، ثكلى ، ترِنُ وتُعْوِلُ",62,"ل",1,0],["إذا زُرْتُ نُعْماً لَمْ يَزَلْ ذُو قَرَابَة ٍ","لها، كلما لاقيتهُ، يتنمرُ",63,"ر",1,0],["إِذا زُرت خفف مِن عَطاياك إِنَّهُ","لِيثقل ظَهري جودِكَ المُتَكاثِرُ",64,"ر",1,0],["إِذَا زَبَنَتهُ عَالَجهَا فَألقَت","عَلَى أطمَارِهِ القِطَعَ الذًُّنَانَا",65,"ن",2,0],["إذا زلّت الأقدامُ في يومِ شدةٍ","رأيتُ هماماً ثابت الجأشِ كالطودِ",66,"د",1,0],["إذا زمَّها نجمُ ذا بالشُّعا","ع تخطُّمها شمسُ ذا بالهَباءِ",67,"ا",2,0],["إذا زعيمُ الجيش حامَى على","مِرباعه أنهبَ أموالَهْ",68,"ل",2,0],["إِذا زُرتُهُ لَم أَدرِ هَل جِئتُ مَجلِساً","حَوى جُمَلَ العَلياءِ أَم جِئتُ مَكتَبا",69,"ب",2,0],["إذا زمزم الحادي بذكر صفاتها","وصرح ما كنّى ونادى نأى الصبر",70,"ر",1,0],["إذا زلزلت شم الرواسي وجدته","رصين حصاة العلم غير مواثب",71,"ب",1,0],["إذا زيد في اثنائه ثلث كله","يصر جنة خضراء تزهو وتثمر",72,"ر",1,0],["إذا زار الصديق أخاه يوما","بغير هديّة وبلا طعام",73,"م",1,1],["إذا زاد في التقبيل زدتُ تحشُّماً","فذاك نِهابٌ في الوصال وذا نَهبُ",74,"ب",1,0],["إذا زرت في أسيوط روحا أعزُّهُ","فذاك هو الروح المعزّز في قلبي",75,"ي",1,0],["إذا زرته بالوهم ثارت صبابتي","وثار فؤادٌ بالجمال موكل",76,"ل",1,0],["إذا زار طيف اسكندرية خاطري","تذكرت ما بيني وبينك من أمر",77,"ر",1,0],["إذا زَمَرَت أطرَبتْ نفسَها","فغنّت بمختلِفاتِ اللُّحونِ",78,"ن",1,0],["إذا زاره وفدٌ غدا من تليده","وطارفه عند الذي لم يَزُرْ رِفد",79,"د",1,0],["إِذَا زَارَهُ مَنْ زَارَهُ الْحُبُّ حُبُّهُ","سَقَاهُ بِكَأْسٍ قَدْ يَدُومُ مُدَامُهُ",80,"ه",1,0],["إذا زرتُ في فصلِ الخريفِ خميلةً","تُصَفِّقُها هوجُ الرياحِ وتنفض",81,"ض",1,0],["إذا زرتِني بالرّوحِ يا أُمِّ نبِّهي","بهينَمةٍ منّي تهزُّ قواما",82,"م",2,0],["إذا زرتِ هاتيكَ الربوعَ وأهلها","تهزّينَ من بيضِ الأمانيّ مَضجعا",83,"ع",2,0],["إذَا زَحَفَتْ كتَائِبُهُ نَهَاراً","رَأيْتَ الليلَ مَمْدودَ الرِّوَاقِ",84,"ق",1,0],["إِذا زُرْتها لاقيتُ حجبا مِن القَنا","وبيض الظُّبى تحمي البَراقِع والحجبا",85,"ب",2,0],["إِذا زَيَّنَ الْحَسْناءَ عِقْدٌ بِجِيدِها","فَأَحْسَنُ مِنُْ زِينَةً موْضِعُ الْعِقْدِ",86,"د",1,0],["إذا زَفَرَتْ درَّ النجيعُ كأنه","لهيبٌ يطيل النفخُ منه ويدلق",87,"ق",1,0],["إِذا زِدتها نقداً تزدكَ نضارةً","وَتنشرُ إِن رمتَ النسيءَ لَها مَهرا",88,"ر",2,0],["إذا زُرْتِ بي بابَ الوزيرِ وأُلقِيَتْ","بمُنتَجَعِ الآمالِ عنكِ قُتود",89,"د",1,0],["إذا زُرْتُها جَرَّ الرماحَ فَوارسٌ","لتَقْصيدها فيمَنْ يُريغ لها قَصدا",90,"د",2,0],["إذا زانَ نَعْت الأمجِدينَ فَمَجْدُه","يَجِلُّ غداةَ الفَخْرِ عن نَعْتِ ناعت",91,"ت",1,0],["إذا زرْتُها طافتْ عليها عواذلٌ","وقاسمني العينَيْنِ منها مُراقِب",92,"ب",1,0],["إِذا زُلزِلَت بِالعادِياتِ مَنازِلٌ","فَلا هِجنَكُم صُبحا وَلا رُعنَكُم ضَبحا",93,"ح",2,0],["إذا زرت أرضاً كنت إنسان عينها","كأنك نور والمواطن أحداق",94,"ق",1,0],["إِذا زيَّن الحليُ النِساءَ فَإِنَّهُ","يُزَيِّنُهُ أَجيادها وَنُحورُها",95,"ر",3,0],["إذا زَادَنا التَّرحالُ بُعداً فما الّذِي","يُقَرِّبُنَا إن كان ثَمَّ لِقَاءُ",96,"ا",2,0],["إذا زُرتُها طالَتْ طريقي وإِن أَعُدْ","أَرَى الأَرضَ تُطوَى لي ويدنُو بعيدُهَا",97,"ه",2,0],["إذا زفّها الساقي لشربٍ تبسَّمت","به طرباً حتَّى يروح مقطّبا",98,"ب",2,0],["إذا زُحزحت عنها اللئام عشيةُ","أضاءَ بها جنحٌ من اللَّيل مظلمُ",99,"م",1,0],["إذا زكَتِ الأُصولُ زكتْ فروع","فطابَ العود منها واللّحاء",100,"ا",2,0],["إذا زأرَ الليث الهزبر بحيّة","يجاوبه ريم من السرب باغم",101,"م",1,0],["إِذا زَوَى عَنِّيَ الجُمَّارُ طَلْعَتَهُ","فلا يُصِبْني بِحَدَّيْ شَوْكِهِ السَّعَفُ",102,"ف",1,0],["إذَا زارَنِي أَعْشى جُفُونَ رَقِيبِهِ","وأَخرَسَ عَنِّي مَا تقولُ اللَّوائِمُ",103,"م",1,0],["إِذا زارك الراجي رأى الوعد حاضراً","وما خاف في عقباه سوء وعيد",104,"د",1,0],["إذا زادني براً رزحتُ ببره","كأني على الحالين أشقى بمنصفي",105,"ي",1,0],["إذا زُرَّتْ سحابَتُه أحالت","صَبَا نجدٍ محلَّلةً عُراها",106,"ا",3,0],["إذا زعيم الملك انتفاهم","يحمي من الضيم أو ينيلُ",107,"ل",1,0],["إذا زفرتْ من الظمأ المطايا","فليلةُ عِشرِها أبداً شُروعُ",108,"ع",1,0],["إذا زانت الدرَّ اليتيمةُ أصبحت","بعيدةَ يُتمٍ من معانٍ تُرصَّعُ",109,"ع",1,0],["إذا زارك النيروزُ عُطْلاً فإنه","يُطوَّق من أبياتها ويسوَّرُ",110,"ر",1,0],["إذا زلِقتْ يوماً بأقدامِ معشرٍ","فمالت مَشى فيها قويماً على الصَّرحِ",111,"ح",1,0],["إذا زرّ جيبُ النقع شدّوا واطلعوا","نجومَ العوالي في ظلام القساطل",112,"ل",1,0],["إِذا زالَ رَعنٌ عَن يَدَيها وَنَحرِها","بَدا رَأسُ رَعنٍ وَارِدٍ مُتَقَدِّمِ",113,"م",1,0],["اِذا زارنَي أشكو اليه كأنَّما","يشدُّ بأزري أو يخفِّفُ مِن وِزْري",114,"ر",2,0],["إذا زمزم الشادي طربت تهتكا","عليها وفاضت في البرية قضيتي",115,"ي",1,0],["إذا زار الحبيب أثار شوقاً","تفتت من حرارته العظام",116,"م",1,1],["إذا زارَه العافونَ يوماً تشتّتَتْ","كأدمُعِ صَبٍّ قد دعتْهُنّ أرسُمُ",117,"م",1,0],["إذا زيّن الأملاكَ حِليةُ مفخرٍ","ففيهِ وفي آبائِه زينةُ الفخرِ",118,"ر",1,0],["إذا زاره يوماً فقيرٌ فإنّما","يروح غنيّاً من جيادٍ وجاملِ",119,"ل",1,0],["إذا زارَهُ يوماً دَلوحٌ بذنبِهِ","مضى وهو عُريانُ الفِرا متكشِّفُ",120,"ف",1,0],["إذا زُرَتَ مثواهُ فأرِّخْ وقُلْ بهِ","عليكَ الرِّضَى والعفوُ يا أيُّها القبرُ",121,"ر",1,0],["إذا زُرتُ الصَّديقَ ولم يزُرني","فذلكَ كالخِطابِ بلا جَوابِ",122,"ب",1,0],["إذا زرتَ الوزير على صلاحٍ","فقل للركبِ حيَّ على الفلاحِ",123,"ح",1,0],["إذا زرتها بعد الرحيق ولم تخف","عتاب المريد الكاشح المترقب",124,"ب",1,0]]}