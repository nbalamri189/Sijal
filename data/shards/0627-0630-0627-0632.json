{"poems":[[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"أرقنا وأسراب النجوم هجوع","https://www.aldiwan.net/poem45921.html","الطويل"],[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[63,"بكت شجوها وهنا وكدت أهيم","https://www.aldiwan.net/poem46131.html","الطويل"],[63,"إذا زم للبين الغداة جمال","https://www.aldiwan.net/poem46158.html","الطويل"],[55,"ألا ليت ذات الخال تلقى من الهوى","https://www.aldiwan.net/poem26540.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[9,"أجدك ودعت الصبى والولائدا","https://www.aldiwan.net/poem21922.html","الطويل"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[71,"تحية مشتاق بعيد مزاره","https://www.aldiwan.net/poem3992.html","الطويل"],[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[10,"أعين ألا فابكي لصخر بدرة","https://www.aldiwan.net/poem21061.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[27,"على أي دين دين سوداء إذ شوت","https://www.aldiwan.net/poem6001.html","الوافر"],[27,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[37,"إذا زلدوا نارا ليوم كريهة","https://www.aldiwan.net/poem7159.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"كبرت كذاك المرء ما عاش يكبر","https://www.aldiwan.net/poem21567.html","الطويل"],[72,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[72,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[72,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[51,"وكم من بخيل قد تأدب حيلة","https://www.aldiwan.net/poem66063.html","الطويل"],[29,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[89,"لاقى اسامة وهو الضيغم الضاري","https://www.aldiwan.net/poem44740.html","البسيط"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[43,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[45,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[45,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[28,"إذا زخرت قيس وخندف والتقى","https://www.aldiwan.net/poem5516.html","الطويل"],[28,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[66,"إذا زرت الملوك فكن رئيسا","https://www.aldiwan.net/poem38574.html","الوافر"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[44,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[74,"أبى البرق إلا أن يحن فؤاد","https://www.aldiwan.net/poem12892.html","الطويل"],[105,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"إذا زادك المال افتقارا وحاجة","https://www.aldiwan.net/poem22520.html","الطويل"],[46,"لقد أصبحت دنياك من فرط حبها","https://www.aldiwan.net/poem22604.html","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1915","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[43,"على قدر أهل العزم","https://www.poetsgate.com/ViewPoem.aspx?id=62",""],[45,"يَكَادُ عَاذِلُنَا في الحُبِّ يُغْرينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31882",""],[80,"غريبٌ بأرض المغربين أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3292",""],[12,"أقيموا بني أمي صدورَ مطيَّكمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8986&r=&rc=0",""],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""]],"verses":[["إِذا زُرتَهُ وَالوَهنُ يَحرِقُ نابَهُ","ثَنى صَرفَهُ عَنّي وَأَنيابُهُ دَردُ",0,"د",1,0],["إِذَا زَارَ مَغْناهُمْ كَريمٌ فَما لَهُ","إِليْهَمْ إِذَا حُمَّ الفِرَاقُ رُجوعُ",1,"ع",1,0],["إذا زُجِرَتْ منهُنَّ وَجْناءُ خِلْتَها","وقد مسّها الإعياءُ ذاتَ عِقالِ",2,"ل",1,0],["إذا زارَهُمْ خِلٌّ مُقِلٌّ لَوَوْا بهِ","مَناخِرَ لمْ يَعْطِسْ بهِنَّ كَريمُ",3,"م",1,0],["إذا زُمَّ للبَيْنِ الغَداةَ جِمالُ","فَلا وَصْلَ إلا أنْ يَزورَ خَيالُ",4,"ل",1,1],["إِذا زُرتُكُم قُلتُم نَزوعٌ وَإِن أَدَع","زيارَتَكُم يَوماً يَكُن مِنكُم عَتبُ",5,"ب",1,0],["إِذَا زَعَمَتْ شَمْسُ الظَّهِيرَةِ أَنَّهُ","أَخُوهَا بِلا شَكٍّ فَقَدْ صَدَقَ الزَّعْمُ",6,"م",1,0],["إِذَا زَأَرَتْ عَنْ جَانِبَيَّ أَجَابَهَا","رُغَاءٌ يُبَارِي زَأَرَهَا وَصَهِيلُ",7,"ل",1,0],["إِذا زارَهُ يَوماً صَديقٌ كَأَنَّما","يَرى أَسَداً في بَيتِهِ وَأَساوِدا",8,"د",2,0],["إِذا زُرتَ رَهنَ المَحبَسَينِ بِحُفرَةٍ","بِها الزُهدُ ثاوٍ وَالذَكاءُ سَتيرُ",9,"ر",1,0],["إِذا زادَهُ جَنياً وَشَماً مُتَيَّمٌ","ذَكا وَردُ خَدَّيهِ وَزادَ اِحمِرارُهُ",10,"ر",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِم","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",11,"ر",2,0],["إِذا زَجَرَت أَلفَيتُها مُشمَعِلَّةً","تُنيفُ بِعَذقٍ مِن غُروسِ اِبنِ مُعنِقِ",12,"ق",1,0],["إِذا زَجَروها في الصَريخِ وَطابَقَت","طِباقَ كِلابٍ في الهِراشِ وَهَرَّتِ",13,"ت",1,0],["إِذا زَفَّ جُنحَ اللَيلِ زَفَّت عِراضَهُ","إِلى البَيضِ إِحدى المَخمَلاتِ الذَعالِبِ",14,"ب",1,0],["إِذا زَاحَمَت رَعناً دَعا فَوقَهُ الصَدا","دُعاءَ الرُوَيعي ضَلَّ في اللَيلِ صاحِبُه",15,"ب",2,0],["إِذا زارَها القَينُ العِراقِيُّ ذَبَّحَت","فِراخَ حَمامٍ باضَ خِزياً حَمامُها",16,"ه",2,0],["إِذا زُرتُها حالَ الرَقيبانِ دونَها","وَإِن غِبتُ شَفَّ النَفسَ عَنها هُمومُها",17,"م",3,0],["إذا زلدوا ناراً ليوم كريهة","سبقنا إلى إيقادها من تَنَورَّا",18,"ر",2,1],["إِذَا زَخَرَت إِليَّ بُحُورُ قَيس","بِخَيرِ عُمُومَةِ المُتَعَمِّمِينَا",19,"ن",2,0],["إِذا زَفَّتِ الأَنصارُ حَولَ مُحَمَّدٍ","بِجَيشٍ كَيَمٍّ مُزبِدٍ حينَ يَزخُرُ",20,"ر",1,0],["إذا زُرتني فالروحُ والمالُ هينٌ","وكلُّ الذي فوقَ الترابِ تراب",21,"ب",1,0],["إذا زُرتَ أرضاً زالَ محلُ ديارِها","وأخرجَ منها خائفاً يترقب",22,"ب",1,0],["إذا زعماء القوم همَّت بشأوهِ","فقد طلبت شأو النجوم بزعمها",23,"م",3,0],["إذا زاره من طالبي العرفِ مادحٌ","هجا شعره بالحق لا يتجرمُ",24,"م",1,0],["إِذا زَعزَعَتهُ الريحُ جَرَّ ذُيولَهُ","كَما زَحَفَت عوذٌ ثِقالٌ تُطَفِّلُ",25,"ل",1,0],["إِذا زَلَّ عَنها السَهمُ حَنَّت كَأَنَّها","مُرَزَّأَةٌ عَجلى تُرِنُّ وَتُعوِلُ",26,"ل",1,0],["اذا زأرت فاني مثل راعدة","او انقضضت فاني شبه اعصار",27,"ر",1,0],["إذا زحموا الضياغم في مجاز","أبادوها وكانوا العابرينا",28,"ن",2,0],["إِذا زُلزِلَت مِن حَولِكَ الأَرضُ رادَها","وَقارُكَ حَتّى تَسكُنَ الجَنَباتُ",29,"ت",1,0],["إِذا زُرتَ يا مَولايَ قَبرَ مُحَمَّدٍ","وَقَبَّلتَ مَثوى الأَعظَمِ العَطِراتِ",30,"ت",1,0],["إِذا زَلِفَت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",31,"م",1,0],["إِذا زارَ سَيفُ الدَولَةِ الرومَ غازِياً","كَفاها لِمامٌ لَو كَفاهُ لِمامُ",32,"م",1,0],["إِذا زَمجَرَ النوتِيُّ فَوقَ عَلاتِهِ","رَأَيتَ خَطيباً في ذُؤابَةِ مِنبَرِ",33,"ر",1,0],["إِذا زَورَةٌ مِنهُ تَقَضَّت مَعَ الكَرى","تَنَبَّهتُ مِن فَقدٍ لَهُ أَتَفَزَّعُ",34,"ع",1,0],["إِذا زالَ زُلنا ناصِبينَ كَمَنزِلٍ","يُعَفّيهِ سافٍ مِن جَنوبٍ وَشَمأَلِ",35,"ل",1,0],["إِذا زَرودُ دَنَت مِنّا صَرائِمُها","فَلا مَحالَةَ مِن زَورٍ يُواقينا",36,"ن",2,0],["إِذا زادَ في غَيظِهِ بَغيُهُم","وَأَنكَرتَ ظاهِرَ عِرفانِهِ",37,"ن",2,0],["إِذا زَخَرَت قَيسٌ وَخِندِفُ وَاِلتَقى","صَميماهُما إِذ طاحَ كُلُّ صَميمِ",38,"م",1,1],["إِذا زَخَرَت حَولي الرُبابُ وَجاءَني","لِمُرٍّ أَواذِيُّ البُحورِ الخَضارِمِ",39,"م",1,0],["إذا زارَها وَفْدُ الرِّضاعِ تَبرَّعَتْ","بِعَذْراءَ لا يَهوى الفِطامَ رضيعُها",40,"ع",3,0],["إِذا زُرتَ المُلوكَ فَكُن رَئيساً","بَصيراً بِالأُمورِ رَحيبَ صَدرِ",41,"ر",1,1],["إِذا زينَةُ الدُنيا مِنَ المالِ أَعرَضَت","فَأَزيَنُ مِنها عِندَنا الحَمدُ وَالشُكرُ",42,"ر",1,0],["إِذا زَهَّدَتني في الهَوى خيفَةُ الرَدى","جَلَت لِيَ عَن وَجهٍ يُزَهِّدُ في الزُهدِ",43,"د",1,0],["إِذَا زَادَ عُمْرُ الْمَرْءِ قَلَّ نَصِيبُهُ","مِنَ الْعَيْشِ وَالنُّقْصَانُ آفَةُ مَنْ نَمَا",44,"م",2,0],["إِذا زُرتُ نُعماً لَم يَزَل ذو قَرابَةٍ","لَها كُلَّما لاقَيتُها يَتَنَمَّرُ",45,"ر",1,0],["إِذا زارَ خَطبٌ خَفَّرَتني ثَلاثَةٌ","سِنانٌ وَعَضبٌ صارِمٌ وَجَوادُ",46,"د",1,0],["إِذا زَلزَلَ اليَأسُ صَرحَ الرَجاءِ","وَمالَ بِأَركانِهِ وَالجُدُرْ",47,"ر",1,0],["إذا زَعْزَعَتْهُنَّ الرّياحُ تَزَعْزَعَتْ","مَواكِبُ مُرّانِ الوشيجِ المُقَوَّم",48,"م",1,0],["إذا زَفَرَتْ غَيظاً ترَامَتْ بمارجٍ","كما شُبّ من نَارِ الجحيمِ وقُود",49,"د",1,0],["إذا زارها انحطّتْ عُقابُ مَنيّةٍ","وليسَ لها إلاّ الجَماجِمُ أفرُخُ",50,"خ",1,0],["إِذا زَخَرَت لَنا مُضَرٌ وَسارَت","رَبيعَةُ ثُمَّتَ اِجتَمَعَت نِزارُ",51,"ر",1,0],["إِذا زُرتَ أَطلالاً بَقينَ عَلى اللِوى","مَلَأنَكَ مِن شَوقٍ وَهُنَّ عُذوبُ",52,"ب",1,0],["إِذا زُيَّنَّ في أَيّامِ حَفلٍ","بَدَت خَيلُ المَريدِ مُسَوَّماتِ",53,"ت",1,0],["إِذا زادَكَ المالُ اِفتِقاراً وَحاجَةً","إِلى جامِعيهِ فَالثَراءُ هُوَ الفَقرُ",54,"ر",1,1],["إِذا زارَتِ الشَربَ المَراجيحَ هَتَّكَت","فَلَم تَتَّرِك فيهِم إِزاراً وَلا أَزرا",55,"ر",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِما","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",56,"ر",2,0],["إذا زارك العافُون كان إيابُهم","إيابَ بشيرٍ لا إيابَ نذيرِ",57,"ر",1,0],["إِذا زَلِقت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",58,"م",1,0],["إِذَا زَرُودُ دَنَتْ مِنَّا صَرَائِمُها","فَلاَ مَحَالَةَ مِنْ زَوْرٍ يُوَافِينا",59,"ن",2,0],["إذا زال لم يسمع بطيب ذكره","ولم ير ذاك اللهو منه منير",60,"ر",1,0],["إذا زلّ عنها السهمُ ، حَنَّتْ كأنها","مُرَزَّأةٌ ، ثكلى ، ترِنُ وتُعْوِلُ",61,"ل",1,0],["إذا زُرْتُ نُعْماً لَمْ يَزَلْ ذُو قَرَابَة ٍ","لها، كلما لاقيتهُ، يتنمرُ",62,"ر",1,0]]}