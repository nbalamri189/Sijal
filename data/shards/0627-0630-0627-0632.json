dhabi.ae/diwan/poem/35539","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44677","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75682","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107512","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101376","الطويل"],[4198,"","https://poetry.dctabudhabi.ae/diwan/poem/145260","الطويل"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34746","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58157","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33268","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139591",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139580",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67460","الطويل"],[4723,"ابتهال","https://www.poetsgate.com/ViewPoem.aspx?id=63307",""],[4764,"قهرت الغير","https://www.poetsgate.com/ViewPoem.aspx?id=29790",""],[4929,"لأن الحب ليس له ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=202414",""],[4974,"إذا زرتكم لاقيت أهلاً ومرحباً","https://www.poetsgate.com/ViewPoem.aspx?id=181277",""],[585,"لك الله من دمعٍ تحدّر صيّبا","https://www.poetsgate.com/ViewPoem.aspx?id=161848",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[5206,"وصفة كيميائية","https://www.poetsgate.com/ViewPoem.aspx?id=187419",""],[5376,"تئن على فراق الأهل درعا","https://www.poetsgate.com/ViewPoem.aspx?id=189706",""],[5431,"إذا زادت الظلماء زدت تمردا","https://www.poetsgate.com/ViewPoem.aspx?id=193730",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5493,"سفينة المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=197698",""],[5582,"رَمَتْكَ وَدُونَها الرُّقَباءُ عَمْداً","https://www.poetsgate.com/ViewPoem.aspx?id=187153",""],[5582,"أَلا عُجْ بِالمَطِيِّ عَلَى المُقامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63580",""],[5616,"لأنك مسلمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205046",""],[5688,"أخ ما أنجبته الأم","https://www.poetsgate.com/ViewPoem.aspx?id=200689",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[3477,"ولولا اكتساب الحمد ما رمت ثروة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612678",""],[463,"يذنب دهرٌ ويستقيلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60272&r=&rc=328",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["إِذا زُرتَهُ وَالوَهنُ يَحرِقُ نابَهُ","ثَنى صَرفَهُ عَنّي وَأَنيابُهُ دَردُ",0,"د",1,0],["إِذَا زَارَ مَغْناهُمْ كَريمٌ فَما لَهُ","إِليْهَمْ إِذَا حُمَّ الفِرَاقُ رُجوعُ",1,"ع",1,0],["إذا زُجِرَتْ منهُنَّ وَجْناءُ خِلْتَها","وقد مسّها الإعياءُ ذاتَ عِقالِ",2,"ل",1,0],["إذا زارَهُمْ خِلٌّ مُقِلٌّ لَوَوْا بهِ","مَناخِرَ لمْ يَعْطِسْ بهِنَّ كَريمُ",3,"م",1,0],["إذا زُمَّ للبَيْنِ الغَداةَ جِمالُ","فَلا وَصْلَ إلا أنْ يَزورَ خَيالُ",4,"ل",1,1],["إِذا زُرتُكُم قُلتُم نَزوعٌ وَإِن أَدَع","زيارَتَكُم يَوماً يَكُن مِنكُم عَتبُ",5,"ب",1,0],["إِذَا زَعَمَتْ شَمْسُ الظَّهِيرَةِ أَنَّهُ","أَخُوهَا بِلا شَكٍّ فَقَدْ صَدَقَ الزَّعْمُ",6,"م",1,0],["إِذَا زَأَرَتْ عَنْ جَانِبَيَّ أَجَابَهَا","رُغَاءٌ يُبَارِي زَأَرَهَا وَصَهِيلُ",7,"ل",1,0],["إِذا زارَهُ يَوماً صَديقٌ كَأَنَّما","يَرى أَسَداً في بَيتِهِ وَأَساوِدا",8,"د",2,0],["إِذا زُرتَ رَهنَ المَحبَسَينِ بِحُفرَةٍ","بِها الزُهدُ ثاوٍ وَالذَكاءُ سَتيرُ",9,"ر",1,0],["إِذا زادَهُ جَنياً وَشَماً مُتَيَّمٌ","ذَكا وَردُ خَدَّيهِ وَزادَ اِحمِرارُهُ",10,"ر",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِم","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",11,"ر",2,0],["إِذا زَجَرَت أَلفَيتُها مُشمَعِلَّةً","تُنيفُ بِعَذقٍ مِن غُروسِ اِبنِ مُعنِقِ",12,"ق",1,0],["إِذا زَجَروها في الصَريخِ وَطابَقَت","طِباقَ كِلابٍ في الهِراشِ وَهَرَّتِ",13,"ت",1,0],["إِذا زَفَّ جُنحَ اللَيلِ زَفَّت عِراضَهُ","إِلى البَيضِ إِحدى المَخمَلاتِ الذَعالِبِ",14,"ب",1,0],["إِذا زَاحَمَت رَعناً دَعا فَوقَهُ الصَدا","دُعاءَ الرُوَيعي ضَلَّ في اللَيلِ صاحِبُه",15,"ب",2,0],["إِذا زارَها القَينُ العِراقِيُّ ذَبَّحَت","فِراخَ حَمامٍ باضَ خِزياً حَمامُها",16,"ه",2,0],["إِذا زُرتُها حالَ الرَقيبانِ دونَها","وَإِن غِبتُ شَفَّ النَفسَ عَنها هُمومُها",17,"م",3,0],["إذا زلدوا ناراً ليوم كريهة","سبقنا إلى إيقادها من تَنَورَّا",18,"ر",2,1],["إِذَا زَخَرَت إِليَّ بُحُورُ قَيس","بِخَيرِ عُمُومَةِ المُتَعَمِّمِينَا",19,"ن",2,0],["إِذا زَفَّتِ الأَنصارُ حَولَ مُحَمَّدٍ","بِجَيشٍ كَيَمٍّ مُزبِدٍ حينَ يَزخُرُ",20,"ر",1,0],["إذا زُرتني فالروحُ والمالُ هينٌ","وكلُّ الذي فوقَ الترابِ تراب",21,"ب",1,0],["إذا زُرتَ أرضاً زالَ محلُ ديارِها","وأخرجَ منها خائفاً يترقب",22,"ب",1,0],["إذا زعماء القوم همَّت بشأوهِ","فقد طلبت شأو النجوم بزعمها",23,"م",3,0],["إذا زاره من طالبي العرفِ مادحٌ","هجا شعره بالحق لا يتجرمُ",24,"م",1,0],["إِذا زَعزَعَتهُ الريحُ جَرَّ ذُيولَهُ","كَما زَحَفَت عوذٌ ثِقالٌ تُطَفِّلُ",25,"ل",1,0],["إِذا زَلَّ عَنها السَهمُ حَنَّت كَأَنَّها","مُرَزَّأَةٌ عَجلى تُرِنُّ وَتُعوِلُ",26,"ل",1,0],["اذا زأرت فاني مثل راعدة","او انقضضت فاني شبه اعصار",27,"ر",1,0],["إذا زحموا الضياغم في مجاز","أبادوها وكانوا العابرينا",28,"ن",2,0],["إِذا زُلزِلَت مِن حَولِكَ الأَرضُ رادَها","وَقارُكَ حَتّى تَسكُنَ الجَنَباتُ",29,"ت",1,0],["إِذا زُرتَ يا مَولايَ قَبرَ مُحَمَّدٍ","وَقَبَّلتَ مَثوى الأَعظَمِ العَطِراتِ",30,"ت",1,0],["إِذا زَلِفَت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",31,"م",1,0],["إِذا زارَ سَيفُ الدَولَةِ الرومَ غازِياً","كَفاها لِمامٌ لَو كَفاهُ لِمامُ",32,"م",1,0],["إِذا زَمجَرَ النوتِيُّ فَوقَ عَلاتِهِ","رَأَيتَ خَطيباً في ذُؤابَةِ مِنبَرِ",33,"ر",1,0],["إِذا زَورَةٌ مِنهُ تَقَضَّت مَعَ الكَرى","تَنَبَّهتُ مِن فَقدٍ لَهُ أَتَفَزَّعُ",34,"ع",1,0],["إِذا زالَ زُلنا ناصِبينَ كَمَنزِلٍ","يُعَفّيهِ سافٍ مِن جَنوبٍ وَشَمأَلِ",35,"ل",1,0],["إِذا زَرودُ دَنَت مِنّا صَرائِمُها","فَلا مَحالَةَ مِن زَورٍ يُواقينا",36,"ن",2,0],["إِذا زادَ في غَيظِهِ بَغيُهُم","وَأَنكَرتَ ظاهِرَ عِرفانِهِ",37,"ن",2,0],["إِذا زَخَرَت قَيسٌ وَخِندِفُ وَاِلتَقى","صَميماهُما إِذ طاحَ كُلُّ صَميمِ",38,"م",1,1],["إِذا زَخَرَت حَولي الرُبابُ وَجاءَني","لِمُرٍّ أَواذِيُّ البُحورِ الخَضارِمِ",39,"م",1,0],["إذا زارَها وَفْدُ الرِّضاعِ تَبرَّعَتْ","بِعَذْراءَ لا يَهوى الفِطامَ رضيعُها",40,"ع",3,0],["إِذا زُرتَ المُلوكَ فَكُن رَئيساً","بَصيراً بِالأُمورِ رَحيبَ صَدرِ",41,"ر",1,1],["إِذا زينَةُ الدُنيا مِنَ المالِ أَعرَضَت","فَأَزيَنُ مِنها عِندَنا الحَمدُ وَالشُكرُ",42,"ر",1,0],["إِذا زَهَّدَتني في الهَوى خيفَةُ الرَدى","جَلَت لِيَ عَن وَجهٍ يُزَهِّدُ في الزُهدِ",43,"د",1,0],["إِذَا زَادَ عُمْرُ الْمَرْءِ قَلَّ نَصِيبُهُ","مِنَ الْعَيْشِ وَالنُّقْصَانُ آفَةُ مَنْ نَمَا",44,"م",2,0],["إِذا زُرتُ نُعماً لَم يَزَل ذو قَرابَةٍ","لَها كُلَّما لاقَيتُها يَتَنَمَّرُ",45,"ر",1,0],["إِذا زارَ خَطبٌ خَفَّرَتني ثَلاثَةٌ","سِنانٌ وَعَضبٌ صارِمٌ وَجَوادُ",46,"د",1,0],["إِذا زَلزَلَ اليَأسُ صَرحَ الرَجاءِ","وَمالَ بِأَركانِهِ وَالجُدُرْ",47,"ر",1,0],["إذا زَعْزَعَتْهُنَّ الرّياحُ تَزَعْزَعَتْ","مَواكِبُ مُرّانِ الوشيجِ المُقَوَّم",48,"م",1,0],["إذا زَفَرَتْ غَيظاً ترَامَتْ بمارجٍ","كما شُبّ من نَارِ الجحيمِ وقُود",49,"د",1,0],["إذا زارها انحطّتْ عُقابُ مَنيّةٍ","وليسَ لها إلاّ الجَماجِمُ أفرُخُ",50,"خ",1,0],["إِذا زَخَرَت لَنا مُضَرٌ وَسارَت","رَبيعَةُ ثُمَّتَ اِجتَمَعَت نِزارُ",51,"ر",1,0],["إِذا زُرتَ أَطلالاً بَقينَ عَلى اللِوى","مَلَأنَكَ مِن شَوقٍ وَهُنَّ عُذوبُ",52,"ب",1,0],["إِذا زُيَّنَّ في أَيّامِ حَفلٍ","بَدَت خَيلُ المَريدِ مُسَوَّماتِ",53,"ت",1,0],["إِذا زادَكَ المالُ اِفتِقاراً وَحاجَةً","إِلى جامِعيهِ فَالثَراءُ هُوَ الفَقرُ",54,"ر",1,1],["إِذا زارَتِ الشَربَ المَراجيحَ هَتَّكَت","فَلَم تَتَّرِك فيهِم إِزاراً وَلا أَزرا",55,"ر",2,0],["إذا زحمتني الجلّى بروع","جمعت لها الإباء فلا براحا",56,"ح",2,0],["إِذا زُعتُهُ مِن جانِبَيهِ كِلَيهِما","مَشى الهَيدَبى في دَفِّهِ ثُمَّ فَرفَرا",57,"ر",2,0],["إذا زارك العافُون كان إيابُهم","إيابَ بشيرٍ لا إيابَ نذيرِ",58,"ر",1,0],["اذا زكى خلق من اصله نزعت","الى الكمال على علاتها الخلل",59,"ل",1,0],["إِذا زَلِقت مَشَّيتَها بِبِطونِها","كَما تَتَمَشّى في الصَعيدِ الأَراقِمُ",60,"م",1,0],["إِذَا زَرُودُ دَنَتْ مِنَّا صَرَائِمُها","فَلاَ مَحَالَةَ مِنْ زَوْرٍ يُوَافِينا",61,"ن",2,0],["إذا زال لم يسمع بطيب ذكره","ولم ير ذاك اللهو منه منير",62,"ر",1,0],["إذا زلّ عنها السهمُ ، حَنَّتْ كأنها","مُرَزَّأةٌ ، ثكلى ، ترِنُ وتُعْوِلُ",63,"ل",1,0],["إذا زُرْتُ نُعْماً لَمْ يَزَلْ ذُو قَرَابَة ٍ","لها، كلما لاقيتهُ، يتنمرُ",64,"ر",1,0],["إِذا زُرت خفف مِن عَطاياك إِنَّهُ","لِيثقل ظَهري جودِكَ المُتَكاثِرُ",65,"ر",1,0],["إِذَا زَبَنَتهُ عَالَجهَا فَألقَت","عَلَى أطمَارِهِ القِطَعَ الذًُّنَانَا",66,"ن",2,0],["إذا زلّت الأقدامُ في يومِ شدةٍ","رأيتُ هماماً ثابت الجأشِ كالطودِ",67,"د",1,0],["إذا زمَّها نجمُ ذا بالشُّعا","ع تخطُّمها شمسُ ذا بالهَباءِ",68,"ا",2,0],["إذا زعيمُ الجيش حامَى على","مِرباعه أنهبَ أموالَهْ",69,"ل",2,0],["إِذا زُرتُهُ لَم أَدرِ هَل جِئتُ مَجلِساً","حَوى جُمَلَ العَلياءِ أَم جِئتُ مَكتَبا",70,"ب",2,0],["إذا زمزم الحادي بذكر صفاتها","وصرح ما كنّى ونادى نأى الصبر",71,"ر",1,0],["إذا زلزلت شم الرواسي وجدته","رصين حصاة العلم غير مواثب",72,"ب",1,0],["إذا زيد في اثنائه ثلث كله","يصر جنة خضراء تزهو وتثمر",73,"ر",1,0],["إذا زار الصديق أخاه يوما","بغير هديّة وبلا طعام",74,"م",1,1],["إذا زاد في التقبيل زدتُ تحشُّماً","فذاك نِهابٌ في الوصال وذا نَهبُ",75,"ب",1,0],["إذا زرت في أسيوط روحا أعزُّهُ","فذاك هو الروح المعزّز في قلبي",76,"ب",2,0],["إذا زرته بالوهم ثارت صبابتي","وثار فؤادٌ بالجمال موكل",77,"ل",1,0],["إذا زار طيف اسكندرية خاطري","تذكرت ما بيني وبينك من أمر",78,"ر",1,0],["إذا زَمَرَت أطرَبتْ نفسَها","فغنّت بمختلِفاتِ اللُّحونِ",79,"ن",1,0],["إذا زاره وفدٌ غدا من تليده","وطارفه عند الذي لم يَزُرْ رِفد",80,"د",1,0],["إِذَا زَارَهُ مَنْ زَارَهُ الْحُبُّ حُبُّهُ","سَقَاهُ بِكَأْسٍ قَدْ يَدُومُ مُدَامُهُ",81,"ه",1,0],["إذا زرتُ في فصلِ الخريفِ خميلةً","تُصَفِّقُها هوجُ الرياحِ وتنفض",82,"ض",1,0],["إذا زرتِني بالرّوحِ يا أُمِّ نبِّهي","بهينَمةٍ منّي تهزُّ قواما",83,"م",2,0],["إذا زرتِ هاتيكَ الربوعَ وأهلها","تهزّينَ من بيضِ الأمانيّ مَضجعا",84,"ع",2,0],["إذَا زَحَفَتْ كتَائِبُهُ نَهَاراً","رَأيْتَ الليلَ مَمْدودَ الرِّوَاقِ",85,"ق",1,0],["إِذا زُرْتها لاقيتُ حجبا مِن القَنا","وبيض الظُّبى تحمي البَراقِع والحجبا",86,"ب",2,0],["إِذا زَيَّنَ الْحَسْناءَ عِقْدٌ بِجِيدِها","فَأَحْسَنُ مِنُْ زِينَةً موْضِعُ الْعِقْدِ",87,"د",1,0],["إذا زَفَرَتْ درَّ النجيعُ كأنه","لهيبٌ يطيل النفخُ منه ويدلق",88,"ق",1,0],["إِذا زِدتها نقداً تزدكَ نضارةً","وَتنشرُ إِن رمتَ النسيءَ لَها مَهرا",89,"ر",2,0],["إذا زُرْتِ بي بابَ الوزيرِ وأُلقِيَتْ","بمُنتَجَعِ الآمالِ عنكِ قُتود",90,"د",1,0],["إذا زُرْتُها جَرَّ الرماحَ فَوارسٌ","لتَقْصيدها فيمَنْ يُريغ لها قَصدا",91,"د",2,0],["إذا زانَ نَعْت الأمجِدينَ فَمَجْدُه","يَجِلُّ غداةَ الفَخْرِ عن نَعْتِ ناعت",92,"ت",1,0],["إذا زرْتُها طافتْ عليها عواذلٌ","وقاسمني العينَيْنِ منها مُراقِب",93,"ب",1,0],["إِذا زُلزِلَت بِالعادِياتِ مَنازِلٌ","فَلا هِجنَكُم صُبحا وَلا رُعنَكُم ضَبحا",94,"ح",2,0],["إذا زرت أرضاً كنت إنسان عينها","كأنك نور والمواطن أحداق",95,"ق",1,0],["إِذا زيَّن الحليُ النِساءَ فَإِنَّهُ","يُزَيِّنُهُ أَجيادها وَنُحورُها",96,"ر",3,0],["إذا زَادَنا التَّرحالُ بُعداً فما الّذِي","يُقَرِّبُنَا إن كان ثَمَّ لِقَاءُ",97,"ا",2,0],["إذا زُرتُها طالَتْ طريقي وإِن أَعُدْ","أَرَى الأَرضَ تُطوَى لي ويدنُو بعيدُهَا",98,"ه",2,0],["إذا زفّها الساقي لشربٍ تبسَّمت","به طرباً حتَّى يروح مقطّبا",99,"ب",2,0],["إذا زُحزحت عنها اللئام عشيةُ","أضاءَ بها جنحٌ من اللَّيل مظلمُ",100,"م",1,0],["إذا زكَتِ الأُصولُ زكتْ فروع","فطابَ العود منها واللّحاء",101,"ا",2,0],["إذا زأرَ الليث الهزبر بحيّة","يجاوبه ريم من السرب باغم",102,"م",1,0],["إِذا زَوَى عَنِّيَ الجُمَّارُ طَلْعَتَهُ","فلا يُصِبْني بِحَدَّيْ شَوْكِهِ السَّعَفُ",103,"ف",1,0],["إذَا زارَنِي أَعْشى جُفُونَ رَقِيبِهِ","وأَخرَسَ عَنِّي مَا تقولُ اللَّوائِمُ",104,"م",1,0],["إِذا زارك الراجي رأى الوعد حاضراً","وما خاف في عقباه سوء وعيد",105,"د",1,0],["إذا زادني براً رزحتُ ببره","كأني على الحالين أشقى بمنصفي",106,"ف",2,0],["إذا زُرَّتْ سحابَتُه أحالت","صَبَا نجدٍ محلَّلةً عُراها",107,"ا",3,0],["إذا زعيم الملك انتفا