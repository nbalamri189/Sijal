3133",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[4442,"الشعر سبك وسبك الشعر أجناس","https://www.poetsgate.com/ViewPoem.aspx?id=171020",""],[6125,"أحلِّقُ في الدُّجى وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=212879",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6142,"لم يكن همه بدنياه إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155695",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[5080,"أُصرِّف آياتي على سورة النبضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88131&r=&rc=1",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[6243,"سارق النّار الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84438&r=&rc=12",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6314,"الدرب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88074&r=&rc=9",""],[6345,"بلادي الإمارات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78677&r=&rc=48",""],[6346,"مشنقة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83387&r=&rc=3",""]],"verses":[["ساسَ البَرِيّةَ قَرْمٌ ماجِدٌ نَدِسٌ","غَمْرُ البَديهَةِ نَدْبٌ حازِمٌ بَطَلُ",0,"ل",1,0],["ساسَ الوَرى وهَجيرُ الظُّلمِ يَلفَحُهُمْ","فأعْقَبَ العَدْلُ فِيهمْ رِقَّةَ الأُصُلِ",1,"ل",1,0],["سَأَسكُتُ كَيلا يَعلَمَ الناسُ مَنطِقي","وَنَسلَمَ مِن أَهلِ الوِشايَةِ وَالظَنِّ",2,"ن",1,0],["سَأَستَمطِرُ العَينَ إِن أَمسَكَت","فَإِنَّ شِفائي أَن تُسبِلا",3,"ل",2,0],["سَأَسكُتُ ما لَم يَجمَعِ اللَهُ بَينَنا","فَإِن نَلتَقي يَوماً فَسَوفَ أَقولُ",4,"ل",1,0],["سَأَسكُتُ إِن بَخِلتِ بِجَدعِ أَنفي","وَأَحفَظُكُم إِلى يَومِ التَنادِ",5,"د",1,0],["سَأَستُرُ وَالسَترُ مِن شيمَتي","هَوى مَن أُحِبُّ بِمَن لا أُحِبّ",6,"ب",1,0],["سَأَسقيكَ نَدماني بِكَأسٍ مِزاجُها","أَفانينُ دَمعٍ مُسبَلٍ وَسَروبِ",7,"ب",1,0],["سَاس الْبِلاَدَ وَرَاضَ مِنْ دَهْمَائِهَا","إِبلاً صِعَاباً لاَ تُطِيق خِطَامَا",8,"م",2,0],["سَأَسكُتُ حَتّى تَحسِبوني كَأَنَّني","مِنَ الجُهدِ في مَرضاتِكُم مُتَماوِتُ",9,"ت",1,0],["سَاسَهَا مُقَدَّمٌ قَدِيرٌ خَبِيرٌ","دَائِبُ السَّعْي طَاهِرُ الآرَابِ",10,"ب",1,0],["سَاسَ أَعْمَالَهُ فَأَنْجَحَهَا","جَهْدُ رَوَّاضِ صَعْبَةٍ مَرِنِ",11,"ن",1,0],["سَاسَ الدِّيَارَ بِعَزْمٍ","مَاضٍ وَقَلْبٍ رَحِيمِ",12,"م",1,0],["سأستودع الأيام كل قصيدة","يَطيب لهم فيها الثناء المُخَلَّد",13,"د",1,0],["سَأَسأَلُ إِن لَقيتُ بَني زِيادٍ","مَتى ضَلَّت حُلومُ بَني قَنانِ",14,"ن",1,0],["ساسَ الخِلافَةَ حينَ قامَ بِحَقِّها","وَحَمى الذِمارَ فَما يُضاعُ ذِمارُ",15,"ر",1,0],["سَاسَةٌ لا كَمَن يَرَى رَعيَةَ النَّا","سِ سَوَاءً وَرِعيَةَ الأَنعَامِ",16,"م",1,0],["سَأَسكُتُ إِجلالاً لِعِلمِكَ أَنَّني","إِذا لَم تَكُن خَصمي لِيَ الحُجَجُ اللُدُّ",17,"د",1,0],["سأسعى إلى أبوابكم ولو أنَّني","على الرأس أسعى راضياً لا على الرجل",18,"ل",1,1],["سأستَنصرُ اللَّهَ حسبي بهِ","نصيراً وإلا فحسبي حسيبا",19,"ب",2,0],["سأستُر نفسي أجادَ اللئي","مُ أم ضنَّ عنّي بموهوبِهِ",20,"ب",2,0],["سأسْقِيكَ ماءَ العيْن ما أسْعَدَتْ به","وإن كانت السُّقْيَا من الدَّمْعِ لا تُجْدِي",21,"د",2,0],["سأسْمعُ الناس ذمّه أبداً","ما سمع الله حمد من حمدَهْ",22,"د",2,0],["ساسنا فالدهرُ عُرسٌ كلّهُ","وعطايا ووجوهٌ ناضره",23,"ر",2,0],["سأسْلم تفويضي إليك بأسره","ومثلي إلى عدلٍ كعدلك فوَّضا",24,"ض",2,0],["سأسوء قوماً بامتداحِك همُّهم","في أن تُذَمّ وفي صنيعك يرذُلُ",25,"ل",1,0],["ساسَ الورى بيد وهُو","بٍ للُّهَى ويدٍ ضموم",26,"م",1,0],["سأُسَلِّي نفسي وأسبِقُ يأْساً","لِسُلُوِّي ملامَة اللُّوَّام",27,"م",1,0],["سَأسألُ رَبّي أَن يُديمَ بيَ الشَكوى","فَقَد قَرَبَت مِن مَضجَعي الرَشأ الأَحوى",28,"و",2,1],["ساسة الشرق حيث كانوا فريق","ليس فيهم من يحسن التدبيرا",29,"ر",2,0],["ساسَها بِالأَناةِ أَروَعُ كَالدا","خِلِ ماضي الجِنانِ يَقظانُ حازِم",30,"م",1,0],["سأسلوا لَذيذَ العيشِ بعدك دائماً","وأنسى حياةَ النفسِ من قبلِ أنساكا",31,"ك",2,0],["سأسلُو عنك بعد اليوم يأساً","إِذا لم يُسلني ملل الطِبَاعِ",32,"ع",1,0],["ساسَ الرعيةَ لا يباعدُه","بُغْضٌ ولا يدنُو به حُبُّ",33,"ب",1,0],["ساسَ البِلادَ بِتَدبيرٍ يُطَبِّقُها","أَبَدَّ واسِطَةً مِنها وَأَطرافا",34,"ف",2,0],["سأستأذنُ القرآنَ فيما دعوتَني","إليه ولا أَعْصِي لِمُنْزِلِه أمرا",35,"ر",2,0],["سَأَسأَلُ عَن أُمورٍ كُنتُ فيها","فَما عُذري هُناكَ وَما جَوابي",36,"ب",2,0],["سَأُسرِعُ نَحوَ رَأسِ العَينِ خَطوي","وَأَقصُدُها عَلى رَأسي وَعَيني",37,"ن",2,0],["ساسَ الأمورَ فشِعبُ الكفرِ مفترقٌ","بالبأس منه وشعبُ الدينِ ملتئمُ",38,"م",1,0],["ساسَ الجُيوشَ سِياسَةَ اِبنِ تَجارِبٍ","رَمَقَتهُ عَينُ المُلكِ وَهوَ جَنينُ",39,"ن",1,0],["سَأَسقي الرَكبَ مِن ذِكراهُ صِرفاً","وَمَمزوجاً مِنَ الكَلِمِ البَواقي",40,"ق",2,0],["ساسُوا الجِيادَ فَظَلَّت في أَعِنَّتِها","طَوعَ البَنانَةِ في كَرٍّ وَمُقتَحَمِ",41,"م",1,0],["سأسفحُ دمعي في هوى المجد منشداً","ألا في سبيلِ المجدِ ما أنا فاعلُ",42,"ل",1,0],["سَأَستَعطِفُ الأَيامَ فيكِ لَعَلَّها","بِيَومِ سُرورٍ في هَواكِ تُثيبُ",43,"ب",1,0],["سَاسُوا المَمالِكَ مُفْسِدينَ فَباطلٌ","تعلو مَواكبُهُ وحقٌّ يُهزَمُ",44,"م",1,0],["ساسَ الحوادثَ والنُّفوسَ فتارةً","يَقِصُ الرقابَ وتارةً يترفَّقُ",45,"ق",1,0],["ساسَ الجماهيرَ الخِفافَ ولم يكن","لولا رَفيفُ حُلومِها لِيَسوسا",46,"س",2,0],["ساسوا المَمالِكَ وَالشُعوبَ سِياسَةً","رَفَعوا الجَمادَ بِها عَلى الحَيَوانِ",47,"ن",1,0],["ساسوا فَلا صَلَفٌ وَلا جَبرِيَّةٌ","وَرَعَوا فَلا خَسفٌ وَلا اِستِبدادُ",48,"د",1,0],["سَأَسنَحُ فَليَسنَح فَميعادُنا المَدى","مَدى البُعدِ إِن يَصبِر إِلى غايَةِ البُعدِ",49,"د",1,0],["ساسَ الأَنامَ شَياطينٌ مُسَلَّطَةٌ","في كُلِّ مِصرٍ مِنَ الوالينَ شَيطانُ",50,"ن",1,0],["سَأَسْتَعْتِبُ الأَيَّامَ فيكَ لَعَلَّها","لصِحَّةِ ذاك الجِسْمِ تَطْلُبُ طالِبَا",51,"ب",2,0],["سَأَستَعطِفُ الأَيامَ فيكِ لَعَلَّها","بِيَومِ سُروري في هَواكِ تَؤوبُ",52,"ب",1,0],["سَاسَهُمْ مَاهِرٌ بِعَدْلٍ فَأَنْسَى","مَا جَنَاهُ الجُهَّالُ وَالظُّلاَّمُ",53,"م",1,0],["ساسَهُ شيْخُكُمْ بِحَزْمٍ وَعَزْمٍ","فَغَدا وَهْوَ بِالنَّدى مغْمُورُ",54,"ر",1,0],["سَاسَ نيْرُونُ بِرِفْقٍ قوْمَهُ","مُسْتِهلاًّ عَهْدَهُ بِالخيْرِ دَثْرا",55,"ر",2,0],["سَأَسفحُ ما أَسأَرتُ مِن بَحرِ أَدمُعي","وَحَسبي بُكاءُ العَينِ بِالهَمَلانِ",56,"ن",1,0],["ساسَ بالحِكْمةِ البِلاَدَ فكانَتْ","من عَوَادِي الزَّمانِ دِرْعاً وسَدّا",57,"د",2,0],["ساسَ البلادَ بِحكْمةٍ عَلَويّة","بسَدادِها تعتزُّ مِصْرُ وتُنْصَر",58,"ر",1,0],["ساس «السنوسيُّ» أطراف البلادِ أبًا","في رفقه، وبغير الرفق لم يَسُسِ",59,"س",1,0],["ساس البلاد وراض من دهمائها","إبلا صعابا لا تطيع خطاما",60,"م",2,0],["سأسميه (ظفارا ) (مذحجا)","لو أتت أنّى ، أسميّها (سعاده)",61,"د",2,0],["سأستغتب الأيام فيك لعلها","لصحة ذاك الجسم تطلب طالبا",62,"ب",2,0],["ساسوا الرعيةَ بالغرورِ سياسةً","لا يرتضيها من يسوسُ قطيعا",63,"ع",2,0],["سَاسَ البِلادَ بتَدْبيرٍ يُطَبّقُهَا،","أيَّدَ واسِطَةً مِنْهَا وَأطْرَافَا",64,"ف",2,0],["سأسكب الدمعة فيها الأسى","والشعر والحبّ الشجيّ الحزين",65,"ن",1,0],["سأستجدي صغيراً من كبيرِ","وأرغبُ في حصاةٍ من ثبيرِ",66,"ر",1,1],["سأسترُ سرى عن قريبٍ وشاسعٍ","ولو أَنَّ قلبي بالسمومِ تسمَّما",67,"م",2,0],["ساسَ أَهلَ الآفاق بالرأ","ي واللطفِ فصارُوا لربهم زُهَّادَا",68,"د",2,0],["سَأسقِيكَ كَأساً مِن هِجَائِكَ مُرَّةً","تَوَدُّ ِإذَا مَا ذُقَتَهَا قَبلَهَا التَّوَى",69,"و",2,0],["ساس الأمورَ فليس تُخلَى رغبةٌ","من رهبة وبسالةٌ من لينِ",70,"ن",1,0],["سَأَسْتَعْتِبُ الأَيَّامَ فِيكَ لَعَلَّها","تُبَلِّغُني بِالعَتْبِ فِيكَ قَبُولا",71,"ل",2,0],["سأسرجُ مركبَيْ مُلكٍ وهُلكٍ","فأركبُ واحداُ إيْما وإيْما",72,"م",2,0],["ساساتُ قَوْمي قَدْ \"تَصهْينَ\" جُلُّهُمْ","تَركوا العُروبَةَ ما اسْتحوا و\"تأمْرَكوا\"",73,"ك",3,0],["ساسَ البِلادَ بِأَطرافِ اليَراعِ وَلَو","يَشاءُ نابَ القَنا الخَطِيُّ وَالقُطبُ",74,"ب",1,0],["ساس الأمورَ لها برأيٍ صائبٍ","إنْ كان منه شَراسةٌ أو لِين",75,"ن",1,0],["سأستعمل البقيا على مَن أُحبُّه","وإن كان ما أبقى عليَّ ولا استبقى",76,"ق",2,0],["سأسمع صوتا آية السحر عنده","وإني لمسحورٌ وصوتك ساحر",77,"ر",1,0],["سأسقى الفؤاد النار بعد صدودكم","لينسى الذي قد كان في زمن القرب",78,"ب",1,0],["سأسهر ليل العيد وحدي لعلني","أصدق أني من جوي الوجد معتق",79,"ق",1,0],["سأسحق هذه العقرب الدون سحقةً","بنعلى وتأديب النساء هو النعل",80,"ل",1,0],["سأستقبل اليوم أمراً بدى","بقلب على ما مضى يندم",81,"م",1,0],["ساس الأمور بنفسه فدنت له","وسعى بهمته إلى آماله",82,"ل",2,0],["سأسعف قلبي في الهوى بعذابه","وأترك ذكري خالداً بذهابه",83,"ب",2,1],["سأَستَلّ من عَزمْي لَحْربِكِ صارِماً","وإن كنَّ أَمضى من سُيوفِك أَقلامي",84,"م",2,0],["سأسكُت صبراً واحْتساباً فإنّني","أَرى الصبرَ سيفاً ليس فيه فلول",85,"ل",1,0],["سأستقيد بك الدنيا التي امتنعتْ","منّى وألبسُ أثواب العلا جُدُدا",86,"د",2,0],["ساسوا فَكانوا أَحسَنَ السُوّاسِ","وُجوهُهُم في اللَيلَةِ الديماسِ",87,"س",1,0],["سَأَسْأَلُ الصَّفْحَ عَنْ جِنَايَتِهِ","إِنْ صِرْتُ مِنْهَا عَلَى شَفِيرِ شَفَا",88,"ف",2,0],["سأسلو بلثم القبر قبر محمد","فمنها كنت أروى من مراشفها اللُّعس",89,"س",1,0],["ساس الورى بسياسةٍ وفراسةٍ","وحماسةٍ وغدا بذاك حكيما",90,"م",2,0],["سأسمعهُ في الخافقينِ كأنّما","من الملإ الأعلى يرنُّ نداء",91,"ا",2,0],["سأسيرُ مُهتَدياً بما زَوّدتِني","إن كنتُ أبغي السَيرَ أو أبغي السُّرى",92,"ر",2,0],["ساسَ أُمورَ الناسِ في الرَأيِ وَال","بَأسِ بِتَشديدٍ وَتَسديدِ",93,"د",1,0],["ساسوا الممالكَ حتّى قرَّ نافرُها","لم تَبقَ مكرمةٌ إلاّ بِسُوّاس",94,"س",1,0],["سَأَسكُتُ عَن شُكري نَداهُ لِعِلَّةٍ","يَقومُ لَها ذَنبي بِأَحسَنِ عُذرِه",95,"ه",1,1],["سأسْلكُ من سُبْل المعالي مَحَجَّةً","أبى لي سِواها طيبُ أصلي ومحتدي",96,"د",2,0],["سأسْعَى لِطاعتِه طاقتي","وإن قَصُرْت همّتي القاصِرَه",97,"ه",1,0],["ساسَ الأَقاليمَ العِظام بِكَفِّهِ","قلم يَفُلُّ شَبا الخُطوبِ شَباهُ",98,"ا",2,0],["ساسَت أَقاليم الوَرى أَقلامه","فأَجَمَّ أَطراف القَنا وَأَراحا",99,"ح",2,0],["سأسكبُ دمعي على قبره","فما كنتُ مُبدلَ مدحٍ بقدحِ",100,"ح",1,0],["سأسكتُ ثمَّ تحسبني سواءً","وأنت وبيننا في الحال بُونُ",101,"ن",1,0],["سأسلك طُرقَها البيضاءَ فرداً","وأين إن ارتفعتُ بها الرفيقُ",102,"ق",1,0],["ساسوا يعدّون الملوكَ واحتبوا","وسطَ النَّدِيِّ يِصفون العربَا",103,"ب",2,0],["ساس مزاج المل","ك بعد الانحراف فاعتدل",104,"ل",1,0],["سأسفحُها أربَعاً لا تغيضُ","على سُفْعِ أحجارِها الركَّدِ",105,"د",1,0],["ساسوا الممالك بالعدالة أينما",