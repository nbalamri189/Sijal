{"poems":[[94,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[33,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[33,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[102,"عينة جديدة من الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=50414",""],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[189,"يا محل الروح من جسدي","https://www.aldiwan.net/poem14498.html","أحذ الكامل"],[287,"دع النسيب وقول اللهو والغزل","https://www.aldiwan.net/poem32673.html","البسيط"],[358,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[469,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59605","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66243","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4481,"","https://poetry.dctabudhabi.ae/diwan/poem/33990","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4767,"الذكر الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179785",""],[5969,"الثوري العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=198903",""]],"verses":[["للثَّلجِ تنثُرُهُ الزَّوابعُ للأسى","للهَوْلِ للآلامِ للمقدورِ",0,"ر",1,0],["لِلثُرَيّا قَد أَبى هَ","ذا المُعَنّى أَن يَدوما",1,"م",2,0],["لِلثُرَيّا قولي لَهُ أَنتَ هَمّي","وَمُنى النَفسِ خالِياً وَخَليلي",2,"ل",2,0],["للثواني اليوم أيد وفم","مثلما تعدو على المذعور غابة",3,"ب",2,0],["للثُكلِ ثُمَّ لأسبابٍ له اجتَمَعتْ","ملءَ النواظر دمعٌ والقلوبُ دَم",4,"م",1,0],["لَلَثمتُ الورد ملتزِما","وتَرشَّفتُ الأَقاحَ نَدِ",5,"د",1,0],["لِلثَغرِ مِنهُ شُجاعٌ فارِسٌ بَطَلٌ","ناهيكَ مِن فارِسٍ نَدبٍ وَمِن بَطَلِ",6,"ل",1,0],["لِلثَنا شَمل يَجمّعه","وَلشمل المال تَبديدُ",7,"د",1,0],["للثمتُ وجهاً للضحى متبلّجاً","وطرفتُ طرفاً للظلامِ كحيلا",8,"ل",2,0],["للثم يُمتع بالمباسم عذبة","للقدّ يُسعد باعتناق نُهود",9,"د",1,0],["للثم أعتاب العلا والسؤدد","والارتقا لصرحك الممرد",10,"د",1,0],["للثغر والسفين حيث انتشروا","كلٌّ إلى أسطوله يبتدر",11,"ر",1,0],["لِلثَرى تَحتَها سُباتٌ وَلِلماءِ","خَريرٌ وَلِلغُصونِ غِناءُ",12,"ا",2,0],["للثم مواطي أخمصيه الافاضل","تفرَّد في الرأي المصيب فلا يرى",13,"ر",2,0],["للثريا التي أبت في سماها","أن ينال الثرى مقاما كريما",14,"م",2,0],["للثائرينَ على الظَلامِ بَراحُ","فَوقَ السَماءِ ودونَهُم أَشباحُ",15,"ح",1,1]]}