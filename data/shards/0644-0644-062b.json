{"poems":[[94,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[33,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[33,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[102,"عينة جديدة من الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=50414",""],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[188,"يا محل الروح من جسدي","https://www.aldiwan.net/poem14498.html","أحذ الكامل"],[285,"دع النسيب وقول اللهو والغزل","https://www.aldiwan.net/poem32673.html","البسيط"],[356,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[466,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"]],"verses":[["للثَّلجِ تنثُرُهُ الزَّوابعُ للأسى","للهَوْلِ للآلامِ للمقدورِ",0,"ر",1,0],["لِلثُرَيّا قَد أَبى هَ","ذا المُعَنّى أَن يَدوما",1,"م",2,0],["لِلثُرَيّا قولي لَهُ أَنتَ هَمّي","وَمُنى النَفسِ خالِياً وَخَليلي",2,"ل",2,0],["للثواني اليوم أيد وفم","مثلما تعدو على المذعور غابة",3,"ب",2,0],["للثُكلِ ثُمَّ لأسبابٍ له اجتَمَعتْ","ملءَ النواظر دمعٌ والقلوبُ دَم",4,"م",1,0],["لَلَثمتُ الورد ملتزِما","وتَرشَّفتُ الأَقاحَ نَدِ",5,"د",1,0],["لِلثَغرِ مِنهُ شُجاعٌ فارِسٌ بَطَلٌ","ناهيكَ مِن فارِسٍ نَدبٍ وَمِن بَطَلِ",6,"ل",1,0],["لِلثَنا شَمل يَجمّعه","وَلشمل المال تَبديدُ",7,"د",1,0],["للثمتُ وجهاً للضحى متبلّجاً","وطرفتُ طرفاً للظلامِ كحيلا",8,"ل",2,0]]}