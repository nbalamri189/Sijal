,"ب",1,0],["برحمتك التي وسعت أصبني","فإنك من تشاء بها تصيب",64,"ب",1,0],["برحمتك العظمى تمسكت ضارعاً","أغوث ملهوفاً وأهتف عانيا",65,"ي",2,0],["برحٌ يعاودني إذا مثلته","والخيل تطفو بالقتام وترسبه",66,"ب",2,0],["بُرَحآءُ شَوْقٍ قد أَلحّ بِمهجَتي","ولو كان عجَّل موتَها لأراحا",67,"ح",2,0],["برح القلب بالصدود ومالل","قلب عن نار حبه من براح",68,"ح",1,0],["برح الشوق بالمشوق إلى أن","كاد والله أن يذيب عظامه",69,"م",2,0],["برح الجفاء فَلا جفا","وَبَدَت صفات المُصطَفى",70,"ف",2,0],["برح الخفاء بحب من لو في الدجى","أبدى ابتساماً زال لون المشرف",71,"ف",1,0],["برحاب تلك الربوة الخضراءِ","عانقت ذات الربوة البيضاءِ",72,"ا",2,1],["بَرِح الخفا ءوبان ما احتجبا","وعدا الزمان بريبه دَأَبا",73,"ب",2,1],["برح الخفاء فلا الغيور يقيك","كلا ولا بيض الظبي تحميك",74,"ك",1,1],["برحت بي لواعج الحب وجدا","باغنٍّ هزَّ الرديني قدا",75,"د",2,1],["برح الصبابة ماله من شائب","إلا بما باللب منا يفعل",76,"ل",1,0],["برِحَ الوَاشي بِسحْرٍ بَاطِلٍ","إنَّ ذاك الوَاشي وَاللهِ سَهَا",77,"ه",2,0],["بَرح الخَفاءُ فَلات حينَ خفاءِ","فَاجهر فَبئس الثوب ثَوب رِياء",78,"ا",2,1],["بَرَّحَت بي مِحنَتي حَتّى لَقَد","ذابَ أَحبابي وَلي رَقَّ العِدا",79,"ا",1,0],["برحمةٍ منك إلَهى أطلُبنى","حتّى أكونَ واصلاُ ومُدنى",80,"ن",2,0],["برح السقم بي فليس صحيحا","من رأت عينه عيونا مراضا",81,"ض",2,1],["برحت مهجتي لتبريح وجدي","فعلى جيرتي وأهلي سلامي",82,"م",2,0],["بَرَّح البَينُ بِقَلبي وَالنَوى","لَم تَزَل تُضرم نار الاشتِياق",83,"ق",1,0],["برَّح الوَجد بِهِ","حَتّى بَراه فَاِستَحالا",84,"ل",2,0],["بَرِحَ الخَفاءُ وَقَد عَلِمتِ بِهِ","إِنّي لِحُبِّكِ غَيرُ مُكتَتِمِ",85,"م",1,0],["برّح بي من ليس عنه براح","ومن رأى قتلي حلالاً مباح",86,"ح",1,1],["برحلتنا وقد أخذت بسيفي","وأمسكت الحمائل والنجادا",87,"د",2,0],["بَرَحَ الخَفاءُ فَما لِنَفسي حيلَةٌ","في الصَبرِ عَنكَ وَلَو دَنا لَم أَصبِرِ",88,"ر",1,0],["برّحٌ غربلت حصاه فأمسى","خالصاً وحده بلا غربال",89,"ل",1,0],["برحاء وجد على أحشاي مضطرم","وانني عندما قد سرّهم المي",90,"م",2,0],["برح الخفا فعلمت ما ابغيه من","سر الهوى وعلمت ما تبغينا",91,"ن",2,0],["برّح الوجد في الفؤاد ولولا","حب