/ViewPoem.aspx?id=206463",""],[5561,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=196755",""],[5573,"اليوم انا ماني سويّ","https://www.poetsgate.com/ViewPoem.aspx?id=205470",""],[5674,"احترقت بناري","https://www.poetsgate.com/ViewPoem.aspx?id=187319",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""],[5747,"شح العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61681",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5790,"من منصفي منك يا ظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=112131",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6056,"الوجيه المكفهرّه","https://www.poetsgate.com/ViewPoem.aspx?id=156694",""],[6090,"يا نجم بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170919",""]],"verses":[["بَرَّحَ بِالعَينَينِ كُلُّ مُغيرَةٍ","أَسِنَّتُها مِن قانِئِ الدَمِ تَرذُمِ",0,"م",1,1],["بَرِحْتَ سَمَاءً لِلقَضَاءِ إذَا صَفَتْ","فَأَحْيَتْ فَقَدْ تَرْمِي بِمُرْدِيّةِ الرُّجْمِ",1,"م",1,0],["برحوا وادي السلام عجالا","أفجد براحهم أم مزاح",2,"ح",1,0],["بَرْحاً لهذا الزمانِ يُلبسُنا","سِرْبالَ نَعْماءَ ثمَّ يَسْتَلِبُهْ",3,"ب",2,0],["برحب ذرعٍ وصدرٍ لم يزل بلداً","فيه ينابيعُ رأي غيرُ أسدامِ",4,"م",1,0],["بَرحَ الحَياءُ وَأَعلَنَت أَسرارَها","إِنَّ الحَياةَ لِكُلِّ خَودٍ بُرقُعُ",5,"ع",1,0],["بَرَحَ الخَفاءُ وَقُلتُها","مِنّي إِلَيكَ بِلا اِحتِشامِ",6,"م",1,1],["بَرَّحتَ يا مَرَضَ الجُفونِ بِمُمرَضٍ","مَرِضَ الطَبيبُ لَهُ وَعيدَ العُوَّدُ",7,"د",1,0],["بَرَّحَ بي الطَيفُ الَّذي يَسري","وَزادَني سُكراً إِلى سُكري",8,"ر",2,1],["بَرَّحَ بي حُبُّكَ المُعَنّى","وَغَرَّني مِنكَ ما يَغُرُّ",9,"ر",1,0],["برَحيبِ الفِناءِ يَرهَبُه الدَّهْ","رُ ولا يَتَّقي الخُطوبَ بِوَاقي",10,"ق",2,0],["بَرَّحنَ بي من وحشةٍ","وقتلتُهن تململا",11,"ل",2,0],["بَرَّ حَتّى عَقَّ الأَقارِبَ إِنَّ ال","بِرَّ بِالدَينِ تَحتَ ذاكَ العُقوقِ",12,"ق",1,0],["بَرَّحَ الشَوقُ إِلى عَينَيكَ بي","عَجَباً أَصبوا لِسَهمَي مَن رَماني",13,"ن",2,0],["برَّحَ بي الشوقُ فلما طغى","فزعْتُ للرْسمِ فكبَّرُتهُ",14,"ت",2,1],["بَرِحَت بِأَتلَعَ في قَلائِدِهِ","وَغَدَت تَهُزُّ رَوادِفاً رُجُحا",15,"ح",2,0],["بَرَحَ الخَفاء بحُبّ مَنْ لَوْ في الدّجى","سَفَرَ اللّثامَ لقُلْتُ يا بدرُ اختَفِ",16,"ف",1,0],["بَرَّحَ بي الوَجدُ يَومَ مَدَّت","إِلَيكَ أَظفارها شعوبُ",17,"ب",1,0],["بِرَحمَةٍ مَن تَقَبَّلَها","فَأسكنُ حَيثُ أَسكَنَها",18,"ن",3,0],["برِحتُ إلى الشّوق المبرِّح من قلبي","وسلَّمتُ أمري في الغرام إلى رَبي",19,"ب",2,1],["برحل وبآآتي أذاني بقدر آآتي","بس أخاف أرحل ولا عاد أقدر.. آآتي",20,"ت",2,1],["برح الحياء وأعلنت أسرارها","إنّ الحياء لكلّ خود برقع",21,"ع",1,0],["بَرَّحتَ فَضلاً وَإِفضالاً فَلا بَرِحَت","تَزينُ أَوصافُكَ الأَشعارَ وَالخُطَبا",22,"ب",2,0],["برحمةِ اللَهِ في هَذا الضَريحِ فَتىً","كَالغُصنِ عَن آلِ فيليبيذِسٍ ذَهَبا",23,"ب",2,1],["بِرَحمةِ اللَّهِ ديمتري قَضى فَبَكى","آلَ المُصلِّي بِدَمعٍ ظَلَّ مُنهَمِرا",24,"ر",2,1],["بَرَّحتَ لي كَبِداً بِالشَوقِ كَم سُلِبَت","كَما كَويتُ كلىً بَرّحتُها لَهَفا",25,"ف",2,0],["برحَ الخَفاءُ وَمَن يَعِشْ","يَرَ ما تَشيبُ لَهُ القَوانِسْ",26,"س",1,0],["برح الخفاء وحاق بال","يونان كيدهم الكمين",27,"ن",1,0],["بَرَحتُ حَتّى بَرَّحَ الوَجدُ بي","وا حَرَبا مِن ثَغرِكَ الأَشنَبِ",28,"ب",1,1],["بِرُحٍّ كَأَصدافِ الصَناعِ قَرائِنٍ","إِثارَةَ مِعطاشِ الخَليقَةِ مُخمِسِ",29,"س",1,0],["بَرَحَ بِي الشّوْقُ إلَى حَضْرَةٍ","لَيسَ لِمَنْ وُفِّقَ عَنْها بَراح",30,"ح",1,0],["بَرِحَ اليَومَ عَن هَوايَ خَفاهُ","ما لِقَلبي عن الهَوى مِن بَراحِ",31,"ح",1,0],["برحتُ حماها ذاكراً لعهودها","إلى بلدٍ ما عهدها كنت ناسيا",32,"ي",2,0],["بَرَحَ الخفاءُ فلستُ أكتمُ لوعةً","عَبَثَ الأسى بين الضلوعِ وهاجَها",33,"ج",3,1],["بَرحَ الخفاءُ به فَأبصرَ خابطٌ","في جاهليّةِ ضلّة وفتونِ",34,"ن",1,0],["بَرحَ الخفاءُ وإنّما رانَ الهوى","بحجابِ عادٍ كم نرى لو يرفعُ",35,"ع",1,0],["برحَت بي الآلام يوما فأعول","تُ كأن الآلام 