{"poems":[[65,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[90,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[50,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[147,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[469,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[590,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60906","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21645","البسيط"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144166","الطويل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132149","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[4767,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=91943",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""]],"verses":[["ولم يَذَرْ في الندى إسْرافُهُ كَرَماً","وإنّما شَرَفُ الأجْوادِ في السّرَفِ",0,"ف",1,0],["ولم يذكروا مجداً لهم كان صارباً","رِواقاً على هام الكواكب قد أوفى",1,"ف",2,0],["وَلَم يَذُقِ الهَوى نَوعَي","نِ مِثلَ الشَهدِ وَالسَبرِ",2,"ر",1,0],["وَلَم يَذكُر هُنَيدَتَهُ حَياءً","وَعِندَ المِسكِ يُلغى الياسَمينُ",3,"ن",1,0],["ولم يذعر غرابَ الليل شيبٌ","ولا سجعتْ به ذات الجناح",4,"ح",1,0],["ولم يذر في الأرض من جزرة","إلا بها دعوته مشهورة",5,"ه",1,0],["ولم يَذْخَرْك نور الدين إِلاّ","لتدفع عنه نائبةَ الخُطوب",6,"ب",1,0],["ولم يذكر نعمة الله بل","تعمد إِنكارها وكفر",7,"ر",1,0],["ولم يذر عن واديك من أجل أننا","رأينَاك تقرا ساعةً وتبتل",8,"ل",1,0],["وَلَم يَذر أُمَّهُ في الدارِ والِهَةً","قَد اِستَجارَ لَها إِذ هُم يُجارونا",9,"ن",2,0],["ولم يذخَروا غير الصّوارم والثّنا","كذا وأبي العلياء فليكنِ الذُخرُ",10,"ر",1,0],["ولم يذق جفني من الغمض سنه","فيالها من ليلة زيدت سنه",11,"ه",1,0],["ولم يذرف الدمع السخين ولم يذف","مرارة آمالٍ تفر وأوطار",12,"ر",1,0],["ولم يَذُق طَعمَ قُربٍ غيرُ مُلتَزِمٍ","ما يَرتَضيهِ حَبيبٌ غيرُ مُعتَرِمِ",13,"م",1,0],["ولم يذكرك شعري في ربيع","أحال الجدب في الأرض اخضرارا",14,"ر",2,0],["ولم يذكر لنا في البر سعيا","ولم يشكر لنا جهد المعين",15,"ن",1,0],["ولم يذكر لنا ما قد بسطنا","له وقت الشدائد من يمين",15,"ن",1,0]]}