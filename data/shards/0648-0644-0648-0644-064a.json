{"poems":[[458,"ولولي ولولي وصيحي وطيري","https://www.aldiwan.net/poem61249.html","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93795","البسيط"],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142240","الخفيف"],[4728,"على قبر أبي","https://www.poetsgate.com/ViewPoem.aspx?id=176882",""],[5818,"لاجئ","https://www.poetsgate.com/ViewPoem.aspx?id=196530",""]],"verses":[["ولولي ولولي وصيحي وطيري","وأقرعي وامنعي بعصف مسيري",0,"ر",2,1],["ولو لياقوتٍ المستصعميِّ بدت","لكان حقالها أقلامه سجدت",1,"ت",1,0],["وَلْوِلي يا رياحُ أنتِ خِضمّ","ما له أينما توجَّهتِ بَرُّ",2,"ر",1,0],["ولو لي ما لبابل من سحر هاروتٍ وماروت","توضّيت بدماه ومن ضلوعه جمرةٍ شبّيت",3,"ت",1,0],["ولو لي مهربٌ من سوء فِعلي","حياءًا منْك يا ربّي هربت",4,"ت",1,0]]}