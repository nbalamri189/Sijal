{"poems":[[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[65,"هي الجرعاء صادية رباها","https://www.aldiwan.net/poem45792.html","الوافر"],[9,"لعمري لئن أمسى من الحي شاخصا","https://www.aldiwan.net/poem21947.html","الطويل"],[75,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[95,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[90,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[4,"من كان مني جاهلا أو مغمرا","https://www.aldiwan.net/poem21163.html","الطويل"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[72,"حبيبي على الدنيا إذا غبت وحشة","https://www.aldiwan.net/poem42830.html","الطويل"],[87,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[47,"فتى مذحج غفرا فتى مذحج غفرا","https://www.aldiwan.net/poem63584.html","الطويل"],[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[33,"ألا يا حبذا نجد","https://www.aldiwan.net/poem42468.html","الهزج"],[33,"خذي حدثينا يا قريب التي بها","https://www.aldiwan.net/poem42641.html","الطويل"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[50,"أبا جعفر لازلت مشترك الرفد","https://www.aldiwan.net/poem63482.html","الوافر"],[48,"سواء على هذا الحمام أضيغما","https://www.aldiwan.net/poem22877.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[151,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[154,"لم تبق معلوة إلا خصصت بها","https://www.aldiwan.net/poem68465.html","البسيط"],[164,"من قوم المرء بالمكروه تثقيفا","https://www.aldiwan.net/poem59015.html","البسيط"],[203,"ما أوجب الإعراض بعد الذي","https://www.aldiwan.net/poem45213.html","السريع"],[208,"طباعك فالزمها وخل التكلفا","https://www.aldiwan.net/poem53252.html","الطويل"],[211,"تقطع باقي وصل أم مؤمل","https://www.aldiwan.net/poem27930.html","الطويل"],[228,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[261,"سعدك للحاسدين نحس","https://www.aldiwan.net/poem48556.html","مخلع البسيط"],[266,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[287,"افتر ثغرك لي أم بارق لمعا","https://www.aldiwan.net/poem32715.html","البسيط"],[308,"لا ترع للملاق عهدا ولا","https://www.aldiwan.net/poem58236.html","السريع"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[353,"ابعث إلي بمشط من شبيبته","https://www.aldiwan.net/poem20734.html","البسيط"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[376,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[385,"فؤاد كما يهوى هواك معذب","https://www.aldiwan.net/poem48814.html","الطويل"],[408,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[411,"أبا قاسم كم ظالم متعجرف","https://www.aldiwan.net/poem49444.html","الطويل"],[443,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[473,"حتام ذا الطغيان","https://www.aldiwan.net/poem59549.html","المجتث"],[473,"اسمع جعلنا فداكا","https://www.aldiwan.net/poem59784.html","المجتث"],[475,"وإنك إن تنزح بك الدار آتكم","https://www.aldiwan.net/poem4670.html","الطويل"],[518,"قصرت عليك النفس حتى توهمت","https://www.aldiwan.net/poem67784.html","الطويل"],[543,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[543,"أتيت بإذن أم أتيت بلا إذن","https://www.aldiwan.net/poem47915.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38488","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77525","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70906","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61165","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27196","السريع"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123477","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76040","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202733","المجتث"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3078,"","https://poetry.dctabudhabi.ae/diwan/poem/198209","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3630,"","https://poetry.dctabudhabi.ae/diwan/poem/147723","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109903","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135745","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44909","البسيط"],[4074,"","https://poetry.dctabudhabi.ae/diwan/poem/204144","الطويل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4691,"أحبك حبا تخطّى الحدودا","https://www.poetsgate.com/ViewPoem.aspx?id=128031",""],[4691,"لوجهك صلى الضوء هل أنت معبد ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=154940",""],[4984,"يمر بي بعضهم","https://www.poetsgate.com/ViewPoem.aspx?id=176109",""],[5081,"أَنْتَ رُوحِي","https://www.poetsgate.com/ViewPoem.aspx?id=186369",""],[5145,"يا أكرم الناس لا مستثنياً أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=108251",""],[5152,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=184394",""],[5183,"على بيتي المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180283",""],[5468,"وجه جميل وصاحب صلف","https://www.poetsgate.com/ViewPoem.aspx?id=181089",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[402,"بنات الدهر عوجي لا تهابي","https://www.poetsgate.com/ViewPoem.aspx?id=35116",""],[5956,"(ولا تزر وازرة وزر أخرى)","https://www.poetsgate.com/ViewPoem.aspx?id=194346",""],[6088,"حسان","https://www.poetsgate.com/ViewPoem.aspx?id=207592",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""],[2220,"يا قمرَ الأسرارِ يا مُلبسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11482&r=&rc=356",""]],"verses":[["فَأَنتَ تُرَجّي المُلكَ وَهوَ زَوالُهُ","بِغَيرِ جِلادٍ فيهِ وَهوَ مُجالِدُ",0,"د",1,0],["فَأَنتَ تَخالُها ظَمياءَ تَمشي","عَلى خَفَرٍ وَقَد فَقَدَت حُلاها",1,"ا",3,0],["فَإِن تَتَّعِدني أَتَعِدكَ بِمِثلِها","وَسَوفَ أَزيدُ الباقِياتِ القَوارِصا",2,"ص",2,0],["فَإِن تَتَناقَلكَ الدِيارُ فَطالَما","تَناقَلَتِ البَدرَ المُنيرَ المَنازِلُ",3,"ل",1,0],["فَإِنْ تَتَوَارَ عَنَّا في حِجَابٍ","فَمَعْنَى لنُّورِ في ذَاكَ الحِجَابِ",4,"ب",1,0],["فأنت تملأ صدر الجوّ أدخنةً","ونحن نملأ صدر الأرض أحزانا",5,"ن",2,0],["فَإِن تَتَقَدَّم تَغشَ مِنها مُقَدَّماً","عَظيماً وَإِن أَخَّرتَ فَالكِفلُ فاجِرُ",6,"ر",1,0],["فأنت تَعْتدُّهُمْ ثلاثَة أشْ","خاص وإن تبلُهُمْ تجدْ أُمَما",7,"م",2,0],["فَإِن تَتَفَضَّل يا رَسولي فَقُل لَهُ","مُحِبُّكَ في ضيقٍ وَعَفوُكَ واسِعُ",8,"ع",1,0],["فأنت تهز صقيل اليراع","ومنس يهز الحسام الصقيلا",9,"ل",2,0],["فَأَنتَ تُعَلِّمُ الناسَ التَعَزّي","وَخَوضَ المَوتِ في الحَربِ السِجالِ",10,"ل",1,0],["فإنْ تتصاهَلْ فالرعودُ صوامِتٌ","وإنْ تتسابقْ فالبَوارِقُ ظُلَّعُ",11,"ع",1,0],["فَأَنتَ تُصيبُ المَجدِ حَيثُ تَلَألَأَت","كَواكِبُهُ إِن أَنتَ لَم تُصِبِ الأَجرا",12,"ر",2,0],["فَإِن تَتَقَدَّم مِنكَ فيهِ عُقوبَةٌ","فَإِنَّكَ قَد أَعقَبتَها بِنَوالِ",13,"ل",1,0],["فَأَنْتَ تَنْمِيقَةُ الكُوفِيِّ صَفْحَتَهُ","قَدْ هَدَّأَ الليْلَ فِي أَوْرَاقِهِ فَهَدَا",14,"د",2,0],["فَإِن تَتَعاهَدي وُدّي","إِذاً تَجِدينَهُ غَضّا",15,"ض",2,0],["فَإِن تَتَقَرَّب يُسكِنِ القَلبَ قُربُها","كَما النَأيُ مِنها مُحدِثُ الشَوقِ مُنصِبُ",16,"ب",1,0],["فإن تتبعوه فهو مولاكمُ الّذي","له برسولِ اللّه دونكمُ الفخر",17,"ر",1,0],["فَإِن تَتَجاوَز بي لُهاكَ إِلَيهِمِ","أَجِد عِوَضي مِنها اِزدِيادي مِنَ المَجدِ",18,"د",1,0],["فَإِن تَترُكوا المَوتَ الطَبيعيَّ يَأتِكُم","وَلَم تَستَعينوا لا حُساماً وَلا خِرصَا",19,"ص",2,0],["فأنت تسعد ده","را وتستريح وتسلى",20,"ل",2,0],["فأَنتَ تَرفَعُها جَذلانَ مُبتَهِجاً","سَهواً وتُعمِلُها عَرفاءَ مِذكارا",21,"ر",2,0],["فَأَنْتَ تَرَى بَيْنَ الْفَرِيقَيْنِ كَبَّةً","يُحَدِّثُ فيها نَفْسَهُ الْبَطَلُ الْجَعْدُ",22,"د",1,0],["فأنت تراه ماطرا غيرَ بارقٍ","ولست تراه بارقا غيرَ ماطرِ",23,"ر",1,0],["فأنت تحت لواء المجد مغتبطٌ","في حضرة جمعت فطبا وأبدالا",24,"ل",2,0],["فأنت تنقل من بذل إلى ورع","غلى حسام إلى طرس إلى قلم",25,"م",1,0],["فأنت تنزف من بحر إذا نحتوا","من العظام الذي أفنوه مصروفا",26,"ف",2,0],["فأنتِ تخفي السرَّ لكنما","تظهرهُ عيناكِ للناسِ",27,"س",1,0],["فإن تَتَّخِذ مني بديلاً فإنني","تبدَّلتُ من بعد السرور تلهُّفا",28,"ف",2,0],["فَإِن تَتبَعِ الكُفّارَ أَمُّ مُؤَمَّلٍ","فَقَد زَوَّدَت قَلبي عَلى نَأيِها شَغفا",29,"ف",2,0],["فَأَنتَ تَرى في الرَبيع الجَمالَ","وَأُبصِرُ اَزهارَهُ كَالبُثور",30,"ر",1,0],["فأنت تحت الظلام تسعى","وذاك تحت اللحاف يفسو",31,"س",2,0],["فأنت تجيد الجود والمجد والغنى","واني اجيد الحمد والحمد افضل",32,"ل",1,0],["فَأَنتَ تولي وَلا تولى الأَياديَ إِل","لا مِن إِلَهَكَ فَاِشكُرهُ لِما اِصطَنَعا",33,"ع",2,0],["فأنت تدري ما جنته يد الر","رامي على الطير برعي الملق",34,"ق",1,0],["فَأَنتَ تَعرِفُ كَيدَ الخَصمِ وَالحُكمِ","أَقولُ هَذا وَلَم أَنظُر إِلى عِلَلِ",35,"ل",1,0],["فأنت تعيب الطاعنين جميعهم","عليك وترميهم بكل مذمة",36,"ه",1,0],["فَأَنتَ تُمسِكُ إمساكاَ بِمَعْرِفةٍ","كَما تُسرِّحُ تَسْرِيحاً بِإحسانِ",37,"ن",1,0],["فأنتَ تكْبرُ عن شِبْهٍ تُقاسُ به","لكنْ وزيرُك نُوشروانٌ الثّاني",38,"ن",2,0],["فأنتَ تلومُني إذ لم أوقِّر","من اعتَسفَ الظلامَ إلى وقاري",39,"ر",2,0],["فَإِن تَتَخذ عِندي يَداً لَكَ غَنِني","لِرَب القَوافي ما يَروق وَبِعَجب",40,"ب",1,0],["فأنْتَ تُروّي هَذِهِ دون هَذِهِ","وهَذَا يُروّي ساحةَ الأَرض عَن يدِ",41,"د",1,0],["فإنْ تتّقيهِ أوْ صبْرت فإنَّما","زمانُكَ أيضاَ مُنقَضٍ كزَمانِهِ",42,"ن",2,0],["فإن تتخذني في الملمات تلقني","عليما بها إن راح غيري به جهل",43,"ل",1,0],["فَأَنتَ تَرضى بِما لا","يَرضى بِهِ الرَحمَنُ",44,"ن",1,0],["فَأَنتَ تَحنو عَلَيهِ","وَما يَرى لَكَ ذاكا",45,"ك",2,0],["فَإِن تَتَّبِعها تُغضِ عَيناً عَلى القَذى","وَإِن تَجتَنِبها بَعد ما نِلتَ تَكمدِ",46,"د",1,0],["فإن تتفكر في انصرافي خائباً","وغدرك تعلم أينا عاد أخيبا",47,"ب",2,0],["فأنتَ تَرى أنَّ هذا يَفِي","بقَصدٍ ولِلوَقتِ قد وفَّرا",48,"ر",2,0],["فأَنتَ تراني في لِقائِكَ خائِفاً","لِكَى لا يَحومُ الشَّكُّ منهُ على ذِهن",49,"ن",1,0],["فَإِن تَتّسِع في عِشقهِ أَعيُن الوَرى","فَإِنّي عَلَيهِ في الهَوى ضَيّق العَينِ",50,"ن",1,0],["فَأَنتَ تَدري شَرَّ تِلكَ القُبله","وَما جَرى لِعَنتر في عَبلَه",51,"ه",1,0],["فإن تتَّقِ الرحمنَ يحْطُطْ بفضله","ورحمتِه وزراً لظهرك مُنْقِضا",52,"ض",2,0],["فأنت تنادي يا إلهي شفاعتي","وأدعو أنا الرحمن غوث المطامع",53,"ع",1,0],["فَإِن تَتَفهمه وَتقلب حُروفه","فَذَلك ما يَبقى مِن النفس يا صاح",54,"ح",1,0],["فإن تَتَقَبَّلْهَا وتلك مطيتي","فيا مَنْ رأى خطباً ثناه خطاب",55,"ب",1,0],["فأنت تسري في ثمان وفي","عشرين حماسا على الكنسِ",56,"س",1,0],["فأنتَ تَرى الغربيَّ يَجهَدُ دائماً","لِكشف مُعَمَّى إذ يكونُ لها الوَفقُ",57,"ق",1,0],["فَأَنتَ تُسرِعُ قُدماً في الضَلال وَما","يَرُدُّك الوازِعانِ الخَوفُ وَالخَجَلُ",58,"ل",1,0],["فأنت تخسر وقتاً","تقضيه بالآلام",59,"م",1,0],["فأَنتَ تعرف كيد الخصم وَالحكم","إني ومُ اللَه فيما صُغت من جُمَل",60,"ل",1,0],["فإن تتبعوا ذبيان تأتوا كتيبة","تقودكم إن الجنيبة متعب",61,"ب",1,0],["فأنتَ ترى منهنَّ شَدْواً تكلَّفتْ","بهِ لكَ آياتُ الرسومِ الطَّواسمِ",62,"م",1,0],["فأنْت تَلفتين له شمالاً","ودون هوَاك من مَلَحِ يمين",63,"ن",1,0],["فإِن تَتَّضِع يا أَيُّها الأَرضُ تَرتَفِع","لأَوجِ 