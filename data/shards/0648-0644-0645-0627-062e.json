{"poems":[[55,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[65,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[53,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[53,"لئن قبحت مني لديك الظهائر","https://www.aldiwan.net/poem62970.html","الطويل"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[53,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[34,"وقلت لها اعتللت بغير ذنب","https://www.aldiwan.net/poem27815.html","الوافر"],[87,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[47,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[63,"قصاراك أن تلقى الزمان مسلما","https://www.aldiwan.net/poem51453.html","الطويل"],[106,"لك الحمد","https://www.aldiwan.net/poem61098.html","عموديه"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[136,"أراني القبض لم أر فيه عابا","https://www.aldiwan.net/poem54888.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[214,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[240,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[266,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[266,"ما بالتعلل بالأوطان أوطار","https://www.aldiwan.net/poem38320.html","البسيط"],[275,"تعشقت أجفانا وقبلت أصداغا","https://www.aldiwan.net/poem35044.html","الطويل"],[275,"لعمرك ما ليالي المهرجان","https://www.aldiwan.net/poem35270.html","الوافر"],[276,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[305,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[353,"وأهيف مثل الرمح عانقت قده","https://www.aldiwan.net/poem20362.html","الطويل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[376,"ولما خلت عيناي منه لبعده","https://www.aldiwan.net/poem57185.html","الطويل"],[376,"فؤاد صحا حتى تعقبه السكر","https://www.aldiwan.net/poem57381.html","الطويل"],[382,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[408,"ولم أخف السقام لأجل موتي","https://www.aldiwan.net/poem46686.html","الوافر"],[411,"ولما خاب حسن الظن فيكم","https://www.aldiwan.net/poem49682.html","الوافر"],[411,"بئس شعار الرجل الشعاره","https://www.aldiwan.net/poem49940.html","الرجز"],[412,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[438,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[447,"لقد أثرت بي لسعة الكرش بالكرش","https://www.aldiwan.net/poem14309.html","الطويل"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[466,"معاذ الله أن أزجي عتابا","https://www.aldiwan.net/poem15178.html","الوافر"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[556,"وقوفي في ذا الورى الخامل","https://www.aldiwan.net/poem47292.html","الخفيف"],[556,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[578,"تفاحة حامضة عضها","https://www.aldiwan.net/poem3639.html","السريع"],[580,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63889","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37743","المتقارب"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59812","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62575","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119263","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105444","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59110","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56188","البسيط"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64562","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64527","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102243","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79875","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108686","الوافر"],[2668,"","https://poetry.dctabudhabi.ae/diwan/poem/105580","الطويل"],[2735,"","https://poetry.dctabudhabi.ae/diwan/poem/198854","المتقارب"],[2895,"","https://poetry.dctabudhabi.ae/diwan/poem/143699","الوافر"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113672","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200181","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112502","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62816","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108037","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73414","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115341","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121262","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141605","الكامل"],[4119,"لك الله إن حاربت فالنصر والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=16107",""],[5549,"خضبت الشيب لما كان عيباً","https://www.poetsgate.com/ViewPoem.aspx?id=181313",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""],[6339,"أبواب الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87890&r=&rc=2",""]],"verses":[["وَلَمّا خُرِّقَ الإِظلامُ جُبناً","خَلَعتَ عَليهِ ثَوبَ المِهرَجانِ",0,"ن",1,0],["ولم أختَرِعْها رَغْبَةً في نَوالِكُمْ","وإنْ كانَ مَشْمولاً بهِ المُتَضَيِّفُ",1,"ف",1,0],["ولم أخفْ في ذاك أنّي متى","وعدتُها رِفدَك أخلفْتُها",2,"ت",3,0],["ولم أخف أن تكون لي شَرَقاً","كلّا ولا غُلَّة على كبدي",3,"د",2,0],["ولم أخْلُ من ربحٍ وخُسْرٍ كليهما","إذا نفذت للمبصرين البصائر",4,"ر",1,0],["ولمَا خفيت بأن وجهك لم يكن","في كل ليلٍ دامسٍ قنديلا",5,"ل",2,0],["ولما خفيتَ بأن نَشْركَ لم ينلْ","أقصى مدى نشرٍ ونيَّفَ ميلا",5,"ل",2,0],["ولم أخش الهجاء عليكَ لكنْ","خشيتُ المدحَ من نَثْرٍ ونظم",6,"م",1,0],["وَلَم آخُذ لَهُ مالاً فَيُلفى","لَهُ دَينٌ عَلَيَّ كَما يَقولُ",7,"ل",1,0],["وَلَم أَخلُ مِن وَجدٍ عَلَيكَ وَرِقَّةٍ","إِذا حَلَّ غيدٌ أَو تَرَحَّلَ غيدُ",8,"د",1,0],["وَلَمّا خَطَونا دِجلَةَ اِنصَرَمَ الهَوى","فَلَم يَبقَ إِلّا لَفتَةُ المُتَذَكِّرِ",9,"ر",1,0],["ولم آخُذِ الكأسَ الرويَّةَ من يدٍ","أناملُها تَنهلُّ بُؤسىً وأَنعُمَا",10,"م",2,0],["ولم أخشَ، يا ربّاه، موتاً يحيط بي","ولكنني أخشى حسابك في الحشرِ",11,"ر",1,0],["ولِمَ اختلاجُ النيلِ فيه كأنه","شيخٌ يُذكرُ بالشبابِ ويحلمُ",12,"م",1,0],["وَلَمْ أَخَلْنِي إِنْ أَمُتْ","يَسْتَحْيِنِي هَذَا الأَثَرْ",13,"ر",1,0],["ولَم أخشَ إغتِيَاباً فَِيهِ أنَّى","يَجُرُّ القَبض لِلمَرءِ إغتَيابا",14,"ب",2,0],["وَلَمّا خَشيتَ عَلَيها الخِلافَ","وَما اِختَلَفَ العِزُّ إِلّا اِنتَقَل",15,"ل",1,0],["ولمّا خشيت الموتَ كذبت وعدَكم","فقولوا أكان الموتُ خيراً أم الكذْبُ",16,"ب",1,0],["ولم اخش شيطان الملام لأن لي","شهابا له ما زال يتبع بالرجم",17,"م",1,0],["وَلَم إِخَل لِلشَقاءِ أَنّي","لِثِقلِ أَعبائِهِ حَمولُ",18,"ل",1,0],["وَلَم أَخَل أَنَّ اللِقا","ءَ رائِدُ التَفَرُّقِ",19,"ق",1,0],["ولم اخضع مدى الأيام الا","لمن خضعت لهيبته القرون",20,"ن",1,0],["ولم اخل قبل رؤياي الأمير يُري","في القوم نصر ولا في الأرض امصار",21,"ر",1,0],["ولما خَبِرتُ الغانياتِ تملُّقاً","رَجعتُ وقولي من أحبَّ فقد زاغا",22,"غ",2,0],["ولما خضتُ مَوجاً من زحامٍ","رَأيتُ حَبيبتي بينَ الحِسان",23,"ن",1,0],["وَلَم اختدعت فبعت قَلبك يوم ذي","سلم بلا ثمن فهل لك ثاني",24,"ن",2,0],["وَلَم أَختَلِس بَينَ الشَقائِقِ حُجَّةً","وَقَد وَقَعَت بِالقُرِّ إِلّا تَلافِيا",25,"ي",2,0],["وَلَمْ أَخْشَ طَعْناً لِلوُشَاةِ بَقولهُمْ","وَفي رَاحتي مِن قَدّهِ اللَّدْنِ أَسْمَرُ",26,"ر",1,0],["ولم أختَرْ مُفارَقةً ولكنْ","غدا بك عنك قلبي في اشْتِغال",27,"ل",1,0],["ولمَّا خَلَت عَينايَ مِنه لِبُعدِه","تَمنَّيتُ أنَّ القَلبَ مثلهما يَخلو",28,"و",1,1],["ولم أختصِرها عاجِزاً عن إِطالةٍ","وحقُّ العُلى أن لا يُطاوِلها الشِّعرُ",29,"ر",1,0],["ولم أُخفه ضنّاً به وصيانةً","عليه من الجهّال والعالم الشَظف",30,"ف",1,0],["ولم أَخَفِ السقامَ لأجل موتي","سقاماً أو لإشماتِ الأعادي",31,"ي",1,1],["ولّما خابَ حُسنُ الظَّنِّ فيكُمْ","ورُحْتُ بِذاكَ صُفْر الرّاحَتَيْن",32,"ن",1,1],["ولم أخشَ مَخوفَ الثَّغْ","رِ عندَ الرَّشفِ بالثَّغْرِ",33,"ر",1,0],["وَلَمّا خزمتم ما حوته أَكُفُّنا","عَثرتم بِنا مِن غَيرِ علم وَلا عَمدِ",34,"د",1,0],["ولما خيّم الرُقَباءُ حولي","جعلتُ الريحَ نحوكم رَسولي",35,"ل",2,0],["ولم أخش من حبي لليلى وأحمد","سواد غطاش الليل أو من يد العطش",36,"ش",1,0],["ولم أخلْ قبلَها شفائي","عند نسيم الصَّبا العليلِ",37,"ل",1,0],["ولم أخْشَ الذُّبابَ لهُ ولكنْ","ثناني حُبُّ حَلْواءِ الذُبابِ",38,"ب",1,0],["ولما خلت أوكارهم من نسورهم","وطارت حذار من سطاك نسورها",39,"ر",3,0],["ولمّا خبرتُ جميعَ البلا","دِ لم أَرَ أضيَعَ من عاقِلِ",40,"ل",1,0],["وَلم أخْفَ إلّا عن عَمٍ ولطالما","تغطّى عن العَشْوِ الصّباحُ المقابلُ",41,"ل",1,0],["وَلَم أَخشَ إلّا من معاجلةِ الرّدى","فأُصرفُ عن ذاك الزّمان وأُصدَفُ",42,"ف",1,0],["ولما خلا عن أهله ووفودِه","وضيوفِه فينا مكانٌ مُقفِرُ",43,"ر",1,0],["وَلَم أَخَل مِن قَبلِها مُحسِناً","يُجزى عَلَيهِ العَضَّ وَالنَجها",44,"ه",2,0],["ولم أَخَلْ قبلَ أَنْ أَبْدى جواهرَه","أَنَّ الجواهِر قَدْ أَصْبَحن أَصْدَافا",45,"ف",2,0],["ولم أُخْلِ من اللهوِ","مكاني بينَ جُلاَّسي",46,"س",2,0],["وَلَمّا خَلَعْنا بُرودَ الهُموم","وفيه أزَلْنا رُسومَ الكرَبْ",47,"ب",1,0],["وَلَم أَخرِقِ الصَفَّ حَتّى تَمي","لَ دارِعَةُ القَومِ وَالحُسَّرُ",48,"ر",1,0],["وَلَمْ أخفِ طابوقه ُخِيفةً","ولمْ أطل ِوَجهي لغيري الطِلاءُ",49,"ا",2,0],["ولم أخن لك عهداً","ولم أحل طول دهري",50,"ي",1,0],["ولم أخشَ من تقبيلها سيفَ لحظها","وإن هدّدتني بالحسام المجرّدِ",51,"د",1,0],["ولم أخفض الانسان الا تعففا","لئلا يبيت العار في قريبا",52,"ب",2,0],["ولم أخف نوب الأيام مقبلةً","حيث اعتصمت بمنصور على النوب",53,"ب",1,0],["وَلَمْ أخلْكَ لِغَيْرِ المَجْدِ مُقْتَنِياً","كَلاَّ وَلاَ بِسِوَى الإفْضَالِ ذَا كلَفِ",54,"ف",1,0],["ولم أخل كخليل الله من بشرٍ","قد خاللته العلى ذاك الفتى الشهمُ",55,"م",1,0],["وَلَم أخَل وَبي مزيدُ قُوَّة","مُذ لَم تَدَع حبلُ المنا مِن صُوَّةٍ",56,"ه",1,0],["ولم أخش اذلالاً وكان تعززي","بركنك عزاً يا عزيز وموئلا",57,"ل",2,0],["ولم أخش طردي قابل التوب خائباً","وأنت خبير بابتهالي وأوبتي",58,"ي",1,0],["ولم أُخفِ عنه السرَّ من ظنَّةٍ بهِ","ولكنَّني أخشى صديقَ صديقي",59,"ي",1,0],["ولم أخل أنَّ السرابَ صادقٌ","حتَّى غدا وعدُك منه يَستمِد",60,"د",1,0],["ولما خاب ظني قلت هذا ال","دجى ولى ولاح الفجر فاجري",61,"ر",2,0],["ولم أخش ضنكا من حياة لأنني","سروب وإن سدت على المسارب",62,"ب",1,0],["ولما خلونا ورق الكلام","دفعت بكفي في صدرها",63,"ر",3,0],["ولم أخلع عذاري فيك إلا","لما عاينت من حسن العذار",64,"ر",1,0],["ولم أختلق بِدعاً وحسبك داعياً","إذا كان عرض المرء منثلم الغربِ",65,"ب",1,0],["ولم اخش من من هجر الحسان ففي الصّبا","رأيتُ عيون الغيد عن منظري تنبو",66,"ب",2,0],["ولم أخش من ذا الرزء لا فضيحتي","بأني قد ملّكت شرّ لحاف",67,"ف",1,0],["ولما خطبت الغانيات ولم يل","ذلك المنام واستطبت وطاكا",68,"ك",2,0],["ولَم أخَل من عادةِ الليالي","أن تَحكُمَ العبيدُ في الموالي",69,"ي",1,1],["ولم أخْصُصْكَ بالتقريض حتى","بلوتُ الناسَ من حامٍ وسامِ",70,"م",1,0],["ولم أخشَ أن أنساك ياساكن الحشا","لذلك لم أُسرع ولم أتعجل",71,"ل",1,0],["ولما خلقنا منه مرجعنا فلا","أثر يدوم لنا ولا تأثير",72,"ر",1,0],["وَلم أُخِل بالخَلخالِ من كأسِها يدي","وَأَثبتُّ في تاريخِ ما سَرَّني سَطرا",73,"ر",2,0],["ولم أخلع عذاراً فيك إلا","لما عاينت من خلع العذار",74,"ر",1,0],["ولم أخُصّك من بينِ الأنامِ بها","إلّا وأنتَ رشيدٌ قبلَ إرشادي",75,"د",2,0],["ولمَ اختُصصن بكل علق مضنّة","وبكل حلي فاخر دون الورى",76,"ر",2,0],["ولم أختصر ما قلت إلا لأنني","أعبر عما لا يقوم به الشرح",77,"ح",1,0],["ولم أخضب مخافة هجر خل","ولا عيباً خشيت ولا عتابا",78,"ب",2,0],["ولما خلت أوكارهم من نسورهم","وطارت حذاراً من سطاك نسورها",79,"ر",3,0],["وَلَمْ أَخشَ مِنْ ضَيْمٍ وفي الأَرضِ حُرَّةٌ","على هَذِهِ الصَّحراءِ ... تُنْجِبُ سَيدَا",80,"د",2,0],["‏ولم اختبرت صبابتي وتلهفي","‏تدري بأني في هواك مصابُ",81,"ب",1,0]]}