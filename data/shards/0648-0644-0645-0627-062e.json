{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[51,"لئن قبحت مني لديك الظهائر","https://www.aldiwan.net/poem62970.html","الطويل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[32,"وقلت لها اعتللت بغير ذنب","https://www.aldiwan.net/poem27815.html","الوافر"],[85,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[45,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[61,"قصاراك أن تلقى الزمان مسلما","https://www.aldiwan.net/poem51453.html","الطويل"],[104,"لك الحمد","https://www.aldiwan.net/poem61098.html","عموديه"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[132,"أراني القبض لم أر فيه عابا","https://www.aldiwan.net/poem54888.html","الطويل"],[143,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[204,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[210,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[235,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[235,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[261,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[261,"ما بالتعلل بالأوطان أوطار","https://www.aldiwan.net/poem38320.html","البسيط"],[270,"تعشقت أجفانا وقبلت أصداغا","https://www.aldiwan.net/poem35044.html","الطويل"],[270,"لعمرك ما ليالي المهرجان","https://www.aldiwan.net/poem35270.html","الوافر"],[271,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[300,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[348,"وأهيف مثل الرمح عانقت قده","https://www.aldiwan.net/poem20362.html","الطويل"],[364,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[371,"ولما خلت عيناي منه لبعده","https://www.aldiwan.net/poem57185.html","الطويل"],[371,"فؤاد صحا حتى تعقبه السكر","https://www.aldiwan.net/poem57381.html","الطويل"],[377,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[402,"ولم أخف السقام لأجل موتي","https://www.aldiwan.net/poem46686.html","الوافر"],[405,"ولما خاب حسن الظن فيكم","https://www.aldiwan.net/poem49682.html","الوافر"],[405,"بئس شعار الرجل الشعاره","https://www.aldiwan.net/poem49940.html","الرجز"],[406,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[432,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[441,"لقد أثرت بي لسعة الكرش بالكرش","https://www.aldiwan.net/poem14309.html","الطويل"],[458,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[461,"معاذ الله أن أزجي عتابا","https://www.aldiwan.net/poem15178.html","الوافر"],[515,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[551,"وقوفي في ذا الورى الخامل","https://www.aldiwan.net/poem47292.html","الخفيف"],[551,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[551,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[551,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[573,"تفاحة حامضة عضها","https://www.aldiwan.net/poem3639.html","السريع"],[575,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"]],"verses":[["وَلَمّا خُرِّقَ الإِظلامُ جُبناً","خَلَعتَ عَليهِ ثَوبَ المِهرَجانِ",0,"ن",1,0],["ولم أختَرِعْها رَغْبَةً في نَوالِكُمْ","وإنْ كانَ مَشْمولاً بهِ المُتَضَيِّفُ",1,"ف",1,0],["ولم أخفْ في ذاك أنّي متى","وعدتُها رِفدَك أخلفْتُها",2,"ت",3,0],["ولم أخف أن تكون لي شَرَقاً","كلّا ولا غُلَّة على كبدي",3,"د",2,0],["ولم أخْلُ من ربحٍ وخُسْرٍ كليهما","إذا نفذت للمبصرين البصائر",4,"ر",1,0],["ولمَا خفيت بأن وجهك لم يكن","في كل ليلٍ دامسٍ قنديلا",5,"ل",2,0],["ولما خفيتَ بأن نَشْركَ لم ينلْ","أقصى مدى نشرٍ ونيَّفَ ميلا",5,"ل",2,0],["ولم أخش الهجاء عليكَ لكنْ","خشيتُ المدحَ من نَثْرٍ ونظم",6,"م",1,0],["وَلَم آخُذ لَهُ مالاً فَيُلفى","لَهُ دَينٌ عَلَيَّ كَما يَقولُ",7,"ل",1,0],["وَلَم أَخلُ مِن وَجدٍ عَلَيكَ وَرِقَّةٍ","إِذا حَلَّ غيدٌ أَو تَرَحَّلَ غيدُ",8,"د",1,0],["وَلَمّا خَطَونا دِجلَةَ اِنصَرَمَ الهَوى","فَلَم يَبقَ إِلّا لَفتَةُ المُتَذَكِّرِ",9,"ر",1,0],["ولم آخُذِ الكأسَ الرويَّةَ من يدٍ","أناملُها تَنهلُّ بُؤسىً وأَنعُمَا",10,"م",2,0],["ولم أخشَ، يا ربّاه، موتاً يحيط بي","ولكنني أخشى حسابك في الحشرِ",11,"ر",1,0],["ولِمَ اختلاجُ النيلِ فيه كأنه","شيخٌ يُذكرُ بالشبابِ ويحلمُ",12,"م",1,0],["وَلَمْ أَخَلْنِي إِنْ أَمُتْ","يَسْتَحْيِنِي هَذَا الأَثَرْ",13,"ر",1,0],["ولَم أخشَ إغتِيَاباً فَِيهِ أنَّى","يَجُرُّ القَبض لِلمَرءِ إغتَيابا",14,"ب",2,0],["وَلَمّا خَشيتَ عَلَيها الخِلافَ","وَما اِختَلَفَ العِزُّ إِلّا اِنتَقَل",15,"ل",1,0],["ولمّا خشيت الموتَ كذبت وعدَكم","فقولوا أكان الموتُ خيراً أم الكذْبُ",16,"ب",1,0],["ولم اخش شيطان الملام لأن لي","شهابا له ما زال يتبع بالرجم",17,"م",1,0],["وَلَم إِخَل لِلشَقاءِ أَنّي","لِثِقلِ أَعبائِهِ حَمولُ",18,"ل",1,0],["وَلَم أَخَل أَنَّ اللِقا","ءَ رائِدُ التَفَرُّقِ",19,"ق",1,0],["ولم اخضع مدى الأيام الا","لمن خضعت لهيبته القرون",20,"ن",1,0],["ولم اخل قبل رؤياي الأمير يُري","في القوم نصر ولا في الأرض امصار",21,"ر",1,0],["ولما خَبِرتُ الغانياتِ تملُّقاً","رَجعتُ وقولي من أحبَّ فقد زاغا",22,"غ",2,0],["ولما خضتُ مَوجاً من زحامٍ","رَأيتُ حَبيبتي بينَ الحِسان",23,"ن",1,0],["وَلَم اختدعت فبعت قَلبك يوم ذي","سلم بلا ثمن فهل لك ثاني",24,"ي",1,0],["وَلَم أَختَلِس بَينَ الشَقائِقِ حُجَّةً","وَقَد وَقَعَت بِالقُرِّ إِلّا تَلافِيا",25,"ي",2,0],["وَلَمْ أَخْشَ طَعْناً لِلوُشَاةِ بَقولهُمْ","وَفي رَاحتي مِن قَدّهِ اللَّدْنِ أَسْمَرُ",26,"ر",1,0],["ولم أختَرْ مُفارَقةً ولكنْ","غدا بك عنك قلبي في اشْتِغال",27,"ل",1,0],["ولمَّا خَلَت عَينايَ مِنه لِبُعدِه","تَمنَّيتُ أنَّ القَلبَ مثلهما يَخلو",28,"و",1,1],["ولم أختصِرها عاجِزاً عن إِطالةٍ","وحقُّ العُلى أن لا يُطاوِلها الشِّعرُ",29,"ر",1,0],["ولم أُخفه ضنّاً به وصيانةً","عليه من الجهّال والعالم الشَظف",30,"ف",1,0],["ولم أَخَفِ السقامَ لأجل موتي","سقاماً أو لإشماتِ الأعادي",31,"ي",1,1],["ولّما خابَ حُسنُ الظَّنِّ فيكُمْ","ورُحْتُ بِذاكَ صُفْر الرّاحَتَيْن",32,"ن",1,1],["ولم أخشَ مَخوفَ الثَّغْ","رِ عندَ الرَّشفِ بالثَّغْرِ",33,"ر",1,0],["وَلَمّا خزمتم ما حوته أَكُفُّنا","عَثرتم بِنا مِن غَيرِ علم وَلا عَمدِ",34,"د",1,0],["ولما خيّم الرُقَباءُ حولي","جعلتُ الريحَ نحوكم رَسولي",35,"ل",2,0],["ولم أخش من حبي لليلى وأحمد","سواد غطاش الليل أو من يد العطش",36,"ش",1,0],["ولم أخلْ قبلَها شفائي","عند نسيم الصَّبا العليلِ",37,"ل",1,0],["ولم أخْشَ الذُّبابَ لهُ ولكنْ","ثناني حُبُّ حَلْواءِ الذُبابِ",38,"ب",1,0],["ولما خلت أوكارهم من نسورهم","وطارت حذار من سطاك نسورها",39,"ر",3,0],["ولمّا خبرتُ جميعَ البلا","دِ لم أَرَ أضيَعَ من عاقِلِ",40,"ل",1,0],["وَلم أخْفَ إلّا عن عَمٍ ولطالما","تغطّى عن العَشْوِ الصّباحُ المقابلُ",41,"ل",1,0],["وَلَم أَخشَ إلّا من معاجلةِ الرّدى","فأُصرفُ عن ذاك الزّمان وأُصدَفُ",42,"ف",1,0],["ولما خلا عن أهله ووفودِه","وضيوفِه فينا مكانٌ مُقفِرُ",43,"ر",1,0],["وَلَم أَخَل مِن قَبلِها مُحسِناً","يُجزى عَلَيهِ العَضَّ وَالنَجها",44,"ه",2,0],["ولم أَخَلْ قبلَ أَنْ أَبْدى جواهرَه","أَنَّ الجواهِر قَدْ أَصْبَحن أَصْدَافا",45,"ف",2,0]]}