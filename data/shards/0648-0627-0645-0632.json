{"poems":[[79,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[79,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[79,"يا هلالا يا قضيبا يا رشا","https://www.aldiwan.net/poem35869.html","الرمل"],[54,"لا تملا حثنا واسقيانا","https://www.aldiwan.net/poem26608.html","المديد"],[54,"ضحك الورد في قفا المنثور","https://www.aldiwan.net/poem26980.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42542","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[79,"خذها فقد وضح الصباح ولاحا","https://www.poetsgate.com/ViewPoem.aspx?id=33805",""],[103,"سارِي الْهَواءِ مَلَكْتَ أيَّ جَناحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62448&r=&rc=40",""],[141,"عللاني واسقياني","https://www.aldiwan.net/poem67933.html","مجزوء الرمل"],[242,"عللاني بمطرب الأشعار","https://www.aldiwan.net/poem18802.html","الخفيف"],[275,"رجعي يا مي ذياك الغناء","https://www.aldiwan.net/poem35611.html","الرمل"],[325,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[385,"هذا الصباح قد ابتسم","https://www.aldiwan.net/poem48800.html","مجزوء الكامل"],[422,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[505,"عللونا بذكر سادات سلع","https://www.aldiwan.net/poem37824.html","الخفيف"],[519,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[543,"إن كان لا بد من غبوق","https://www.aldiwan.net/poem47533.html","عموديه"],[556,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[563,"يا طالبا للحجر المكرم","https://www.aldiwan.net/poem34086.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87260","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1247,"","https://poetry.dctabudhabi.ae/diwan/poem/178055","المنسرح"],[1551,"","https://poetry.dctabudhabi.ae/diwan/poem/101267","الكامل"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130695","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53082","الكامل"],[2564,"","https://poetry.dctabudhabi.ae/diwan/poem/216956","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108105","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91586","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91611","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92448","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85041","البسيط"],[5136,"أذاب فؤاد عاقه غراما","https://www.poetsgate.com/ViewPoem.aspx?id=121666",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5461,"ناقد الاشعار لك مني سلام","https://www.poetsgate.com/ViewPoem.aspx?id=1316",""],[5616,"مفاتن","https://www.poetsgate.com/ViewPoem.aspx?id=203233",""],[5894,"وامزج الخمر باللما يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=131441",""],[5956,"لو تكرمتِ أريد الزنجبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=182376",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6237,"حسناء الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77879&r=&rc=21",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["وامْزُجْ بصِرْفِ الرّاحِ عَذْبَ رُضابِها","ما ضرّ أنْ خَلَفَ الحَرامُ مُباحا",0,"ح",2,0],["وامْزُجْ بِمامِيثا وحَبِّ الفَنا","لَخْلَخَةً مُتْقَنةَ المَزْجِ",1,"ج",1,0],["وامْزُجاها قهْوَة عِطرِيّةً","كرُمَتْ كرَماً وطابَتْ عُرُشا",2,"ش",2,0],["وَاِمزُجا كَأسَنا بِريقَةِ شُرٍّ","طابَ لِلعَطشانِ وِرداً وَحانا",3,"ن",2,0],["وَاِمزُجِ النَبتَ وَاِمزُجِ الراحَ بِالثَل","جِ وَاِطفِئ بِالماءِ نارَ الهَجيرِ",4,"ر",1,0],["وامْزُجِيهَا بِرُضابٍ","مِنْكِ مَعْسُولِ اللَّهاةِ",5,"ه",1,0],["وَامْزُجْ بمِسْكِيِّ الأَثِيرِ تَحيَّةً","لِعَشائِرٍ شُمِّ الأُنُوفِ سِماحِ",6,"ح",1,0],["وامزج بصرف الراح عذب رضابها","ما ضر أن خلط الحرام مباحا",7,"ح",2,0],["وَامْزُجْ بمِسْكِيِّ الأَثِيرِ تَحِيَّة ً","لِعَشَائِرٍ شُمِّ الأُنُوفِ سِماخِ",8,"خ",1,0],["وَاِمزِجِ الكَأسَ وَلا تُك","ثِر مِزاجَ العَسقَلاني",9,"ن",2,0],["وَامْزِجَاهُ بِغُنَّةٍ تُنْعِشُ الْفِكْ","رَ فُدِيتُمْ مِنْ سَائِرِ الأَغْيَارِ",10,"ر",1,0],["وامزُجي الأنغامَ بالألحانِ في","هذهِ الليلةِ كي يحلو البُكاء",11,"ا",2,0],["وَاِمزُج خُلاصَتَها بِمَحلولِ الهَنا","وَاِجعَل رَحيقَ الأُنسِ لِلنَدماءِ",12,"ا",2,0],["وَاِمزج مَدامك إِنَّما المَمزوج","شُرب مَن اِحتَشَم",13,"م",1,0],["وامزِج معتقةَ الدنان فإنَّني","أهوى المزاج بريق معسول اللمى",14,"م",2,0],["وامزِجْ بِطيبِ تَحِيَّتِي غَدِقَ الحَيَا","فاجْعَلْهُ سَقْيَ أَحِبَّتِي وحَبائِبي",15,"ب",2,0],["وامْزِجوا ماءَنا بِطيبِ ثَناهُمْ","فهوَ أشْهى من نَكْهَةِ الزَّنْجَبيلِ",16,"ل",1,0],["واِمزُج لُجَينَ الدّمعِ في عرَصاتِه","بنُضارِ جاري العَبرةِ الحمراءِ",17,"ا",2,0],["وَاِمزُج مَلامَك بِالذِّكرى فَإِن بِها","تَعَلّلا لِعَليلِ الشَّوقِ مِن أَلَمِ",18,"م",1,0],["وامزِج بِريقِ الحبِيب رِيقي","بالله حِد بي على الصَّوَابِ",19,"ب",1,0],["وَاِمزُجْ صَفاءً قَد عَداك برَنْقِه","وَاِخلُطْ زَماناً ناعماً بشديدِ",20,"د",1,0],["وامزجهما معاً بأيدٍ منهما","ممدودة كدرجات السُّلَّمِ",21,"م",1,0],["وَامزج حميّاها بَريق قرقفٍ","يُطفي لَهيباً بِالجَوى قَد أُشعِلا",22,"ل",2,0],["وَأَمزجْ لِلنَدامى بِال","ندى ما صُنتَ في الحُقب",23,"ب",1,0],["وامْزُجا الراحَ بماء","منه أو لا تَمْزجاها",24,"ا",3,0],["وأمزج الهمَّ بالسرور اذا","أيقنتُ أنا جاران في بلدِ",25,"د",1,0],["وامزج بكأسك خمر ثغرك باسماً","تزل الهموم وتقلع الأوصابا",26,"ب",2,0],["وامزجنها برحيقٍ من لَمَى","حَولَ وَردٍ في عذارِ الغَلَسِ",27,"س",1,0],["وامزح لي الكاسات من برد على","برد النسيم وخلِّ عنك يزيدا",28,"د",2,0],["وأمزج من كأس المطامع والمنى","مجاجة سمٍّ من خلاصته محض",29,"ض",1,0],["وامزّق البردَ الذي من فوقه","وأقول يا قلبي من الرشا اشتف",30,"ف",1,0],["وَامزجنْها برضابٍ وَاسقني","بَينَ جَنات وَولدانٍ وَحورْ",31,"ر",1,0],["وَامزج بريقِك صرفَها","وَبها وَخدِّكَ فاشفع",32,"ع",1,0],["وامزجا لي من رحيق","بين مختلف الزهورِ",33,"ر",1,0],["وَاِمزُج فَدَتكَ النُفوسُ كاسي","مِن ريقَةٍ تُسكِرُ المَدامَه",34,"م",2,0],["وأمزج كأسه شهدا براح","وأسقيه ويسقيني الحماما",35,"م",2,0],["وامزج بروحي ومهجتي ودمي","وحملتي لا إله إلا الله",36,"ل",2,0],["وامزج شعوري مع حسن القبيل","في قصيد(ن)مثل ندّاي الغمام",37,"م",1,0],["وأمزق الأوراق شرّ ممزّق","كي لا أرى حرفاً يخور ويزحف..",38,"ف",1,0],["وامزج الخمر باللما يا نديمي","واسقني فأرى شفائي وأحكي",39,"ي",1,1],["‏وامزِجيهِ بحنان أريحيٍّ","‏ ‏ منك لا يترك في النفس غليلا",40,"ل",2,0],["وَامزِجْها بِنُخاعِ حِمارٍ","مَعْ كُوبٍ مِن بَولِ خُيولِ!",41,"ل",1,0],["وامزِجْ شذاها بجوى خافقٍ","مابين جنبيّ كسير الجناحْ",42,"ح",1,0],["وامزجَنْها من ريق حسناءَ كي يَ","حلو اصطباحي بشربهاواغتباقي",43,"ق",2,0]]}