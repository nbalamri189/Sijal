"],[5376,"لو جادَ غيثُكِ ما مكثْتُ عليلا","https://www.poetsgate.com/ViewPoem.aspx?id=205151",""],[5410,"إلامَ الصَبر...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=141849",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5608,"أحلا قصيد","https://www.poetsgate.com/ViewPoem.aspx?id=33532",""],[5776,"عَامُ الفيلِ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=200699",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5820,"فلا تسألونا بالسلاح فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=201348",""],[5848,"تنهيدة قتيل","https://www.poetsgate.com/ViewPoem.aspx?id=50601",""],[5865,"إلى أصدقائي","https://www.poetsgate.com/ViewPoem.aspx?id=179880",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6152,"دعي الماضي وذكراه","https://www.poetsgate.com/ViewPoem.aspx?id=203074",""],[5309,"هذا الخلود فإن بلغت محله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573742",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["وَكانوا دُروعي إِن رَمَتني مُلِمَّةٌ","وَنَبلِيَ إِن رامى العِدا وَسِهامي",0,"م",2,0],["وَكانَ وَليُّ العَقدِ وَالعَهدِ بَينَهُ","وَبَينَ بَهاءِ المُلكِ يَسعى وَيَلطُفُ",1,"ف",1,0],["وَكانوا عَلى الأَيّامِ مَلهىً وَمَطرَباً","فَقَد أَصبَحوا لِلقَلبِ مَبكىً وَمَجزَعا",2,"ع",2,0],["وَكانوا أَحاديثَ الرِفاقِ فَأَصبَحوا","أَغاني لِلغورِيِّ وَالمُتَنَجِّدِ",3,"د",1,0],["وَكانُوا بِها وَالْعِزُّ في غُلَوائِهِ","مَطاعِينَ في الهَيْجا طِوالَ السَّواعِدِ",4,"د",1,0],["وَكَانُوا نَعِيمَ الْجَنَّتَيْنِ تَفَيَّأُوا","وَلَمَّا يَقَعْ مِنْهَا النُّزُولُ وَلاَ الْهَبْطُ",5,"ط",1,0],["وَكانوا بِشَحمِ الكُلى قَبلَها","فَقَد جَرَّبوها لِمُرتادِها",6,"د",3,0],["وَكانوا قُعوداً حَولَها يَرقَبونَها","وَكانَت فَتاةُ الحَيُّ مِمَّن يُنيرُها",7,"ر",3,0],["وَكانوا ذَوي نُعمى فَقَد حالَ دونَها","ذَوو أَنعُمٍ فيما مَضى فَاِستَحالَها",8,"ل",3,0],["وَكانوا سُراةَ بَني مالِكٍ","وَزَينَ العَشيرَةِ بَذلاً وَعِزّا",9,"ز",2,0],["وَكانوا أُناساً كُنتُ آمَنُ غَيبَهُم","فَراحوا عَلى ما لا نُحِبُّ فَأَدلَجوا",10,"ج",3,0],["وَكانوا شَيَّدوا في الفَقرِ مَجداً","فَلَمّا جاءَتِ الأَموالُ مَلّوا",11,"ل",3,0],["وَكانوا غَرَّزوا في الرَملِ بَيضاً","فَأَمسَكَهُ كَما غَرَزَ الجَرادُ",12,"د",1,0],["وكأنَّ وشْيَ رُقومها","بالبرق طُرُزَ عَسْجَدَا",13,"د",2,0],["وكأنّ واحدكم لفَرط غروره","ثمِل تَميل بجانبَيْه القرقَف",14,"ف",1,0],["وكانوا به شُمّ العَرانين فاغتدَوْا","يُقاسون أهوالاً به تَجْدع الأنفا",15,"ف",2,0],["وكانوا إذا ما أظلم الدهر أشرقت","به غُرَرٌ من مجدهم وحجول",16,"ل",1,0],["وكانوا في الذؤابة من نزار","وأهل لوائها متنزرينا",17,"ن",2,0],["وَكَانُوا إِخوَةً وَيَداً وكُنَّا","لَهُم في الوُدِّ غَيرَ مُلَوِّنَينَا",18,"ن",2,0],["وَكانوا الكُثرَ يَومَئِذٍ وَلَكِن","كَثُرنا إِذ تَعارَكنا وَقَلّوا",19,"ل",3,0],["وَكانوا مُلوكاً بِأَرضيهِمِ","يُبادونَ غَصباً بِأَمرٍ غَشِم",20,"م",1,0],["وكان واللهوُ مقرونين في قَرَنٍ","فانبتَّ حبلُهُما مني لميعادِ",21,"د",1,0],["وكانوا يدبُّون الضَّراء فأصبحوا","وكل مبادٍ يركضُ الغيَّ مَرْكضا",22,"ض",2,0],["وكأن وقع مشارطٍ من ريشه","في تِلكُمُ الأحناكِ وقعُ مشارط",23,"ط",1,0],["وكأن وعدكم تقيَّل عهدكم","فلقاحه بنتاجه مرهوق",24,"ق",1,0],["وكانوا كأوصال القناة تتابعت","وكنتَ لهم مثل السنان المزلَّق",25,"ق",1,0],["وكانوا جرادَ الأرض يُفنون ريعَها","وأنتم تمجُّ الشهدَ للناس نحلُها",26,"ل",3,0],["وَكانوا السَنامَ اِجتُثَّ أَمسِ فَقَومُهُم","كَعَرّاءَ بَعدَ النَيِّ راثَ رَبيعُها",27,"ع",3,0],["وَكانوا مَعشَراً قَد جاوَرونا","بِمَنزِلَةٍ فَأَكرَمنا الجِوارا",28,"ر",2,0],["وَكانوا كَذي كَفَّينِ أَصبَحَ راضِياً","بِواحِدَةٍ شَلّاءَ مِن قَصَبٍ عَشرِ",29,"ر",1,0],["وكانوا بحاراً للعلوم عميقة","وكانوا جبالاً للحلوم رواسيا",30,"ي",2,0],["وكانوا مصابيح الهدى ونجومها","بهم يهتدى من كان في الليل ساريا",30,"ي",2,0],["وَكانَ وُدُّهُمُ الصافي وَنُصرَتُهُم","لِلمُسلِمينَ وَراعيهِم كَما شاؤوا",31,"ا",1,0],["وَكانوا لَهُ الفَخرَ لَمّا أَتى","وَكُنتَ لَهُ العُذرَ لَمّا ذَهَب",32,"ب",1,0],["وَكانوا يَروعونَ المُلوكَ بِأَن بَدَوا","وَأَن نَبَتَت في الماءِ نَبتَ الغَلافِقِ",33,"ق",1,0],["وَكانوا رَقَّعوا أَيّامَ سِلمٍ","عَلى تِلكَ القَوادِحِ وَالنُدوبِ",34,"ب",1,0],["وَكانوا ثَمودَ الحِجرِ حَقَّ عَلَيهُمُ","وُقوعُ العَذابِ وَالخَصِيُّ لَهُم سَقبُ",35,"ب",1,0],["وَكانَ وَكُنتُ وَالحالانِ شَتّى","بِمُثنٍ بِالإِثابَةِ أَو مُثيبِ",36,"ب",1,0],["وَكانوا خِيارَ الجاهِلِيَّةِ كُلِّها","مَناكِبُهُم في المَجدَ أَعلى المَناكِبِ",37,"ب",1,0],["وَكانوا حُماةَ الناسِ في كُلِّ فَزعَةٍ","وَأَجوادَهُم في الحِصبِ أَوفى اللَوازِبِ",37,"ب",1,0],["وَكَأَنَّ وَجهَكَ حينَ تُسأَلُ مُشرَبٌ","مِن حُسنِهِ ماءَ الحُسامِ المُذهَبِ",38,"ب",1,0],["وَكانوا مَتى ما يُسأَلوا النَصفَ يَشمَخوا","بِآنُفِ شُرّادٍ عَنِ الحَقِّ نُفَّرِ",39,"ر",1,0],["وَكانَ وَراءَ المَدحِ إِذ هُوَ زائِدُ ال","يَدَينِ فَكَيفَ الآنَ إِذ هُوَ كامِلُ",40,"ل",1,0],["وَكانوا إِذا راموا تَعاطِيَ سَعيِهِ","يَفيءُ بِعَجزٍ رَأيُهُم فَيَفيلُ",41,"ل",1,0],["وَكانوا جَمعَ مَملَكَةِ فَآلوا","طَوائِفَ في مَخابيهِم عَزينا",42,"ن",2,0],["وَكانوا عُدولاً فَأَدّوا إِلَي","هِ أَمانَةَ أَيّامِها الخالِيَه",43,"ي",2,0],["وَكانَ وَفاءُ الناسِ خَيرُهُمُ لَهُم","نَدىً وَيَداً قَد أُترِعَت كُلَّ جانِبِ",44,"ب",1,0],["وَكانوا سَراةَ الحَيِّ قَبلَ مَسيرِهِم","مَعَ الأُسدِ مُصفَرّاً لِحاها وَمالِكِ",45,"ك",1,0],["وَكانوا يَرَونَ الدائِراتِ بِغَيرِهِم","فَصارَ عَلَيهِم بِالعَذابِ اِنفِتالُها",46,"ل",3,0],["وَكانو كَذي داءٍ أَصابَ شِفائَهُ","طَبيبٌ بِهِ تَحتَ الشَراسيفِ داخِلِ",47,"ل",1,0],["وَكانوا خَمسَةً إِثنانِ مِنهُم","لَها وَتَحَزُّماً كانا ثِبانا",48,"ن",2,0],["وَكانوا هُمُ المالَ الَّذي لا أَبيعُهُ","وَدِرعي إِذا ما الحَربُ هَرَّت كِلابُها",49,"ب",3,0],["وَكانوا إِذا ما القَرُّ هَبَّت رياحُهُ","وَضَمَّ سَوادُ اللَيلِ رَحَلاً إِلى رَحلِ",50,"ل",1,0],["وَكانوا عَلى الإِسلامِ إِلباً ثَلاثَةً","فَقَد بَزَّ مِن تِلكَ الثَلاثَةِ واحِدُ",51,"د",1,1],["وَكانوا طالَما راحوا","إِلى اللَذّاتِ وَابتَكَروا",52,"ر",3,0],["وَكانوا طالَما أَشِروا","وَكانوا طالَما بَطِروا",52,"ر",3,0],["وَكانوا قَومَنا فَبَغَوا عَلَينا","فَقَد لقاهُمُ لَفَحُ السَعيرِ",53,"ر",1,0],["وكانوا رأوا مَهْدِيَّتَيْكَ وفيهما","لِعِزِّ العدى أمْرٌ فهالَهُمُ الأمرُ",54,"ر",1,0],["وَكانَ وَرائي مِن صَريمَةِ طَيِّئٍ","وَمَعنٍ وَوَهبٍ عَن أَمامِيَ ما يُسلي",55,"ل",2,0],["وكأنَّ وجهَكَ فوقَهُ جدريةٌ","ذهبٌ بسمطي لؤلؤٍ قَدْ رصِّعا",56,"ع",2,0],["وكانوا عن طرائقهِ كسالى","ولكنْ في أذاهُ لهم نشاطُ",57,"ط",1,0],["وَكانَ وَسادَهُ أَحناءُ رَحلٍ","عَلى أَصلابِ ذِعلِبَةٍ هَبوبِ",58,"ب",1,0],["وكانوا إذا ساموا المُتوَّجَ خُطّةً","أتاها وأغضَى يَنزعُ التّاجَ صاغرا",59,"ر",2,0],["وَكانوا كَالأُسودِ الغُلبِ عِزّاً","فَضاعَ العِزُّ وَاِستُلِبَ العَرينُ",60,"ن",1,0],["وَكانوا العُروَةَ الوُثقى إِذا ما","تَصَعَّدَتِ الأُمورُ إِلى عُراها",61,"ا",3,0],["وَكانوا العُروَةَ الوُثقى إِذا ما","تَجَرَّدَتِ الأُمورُ إِلى عُراها",62,"ا",3,0],["وَكانوا بِالرِضا شُغِفوا زَماناً","وَقَد نَفَخوا بِهِ في الناسِ بوقا",63,"ق",2,0],["وَكَأَنَّ وَجنَتَهُ تُفَتِّحُ وَردَةً","خَجَلاً إِذا طالَبتَهُ بِعِداتِه",64,"ت",2,0],["وكانُوا قَدْ مَضَوْا وَهُمُ عُرَاةٌ","فَجَاءُوا بَعْدَ ذَلِكَ مُكْتَسِينا",65,"ن",2,0],["وكأنَّ وفْرَتَهُ غَدائِرُ غادةٍ","لم يَلْقَها بُؤسٌ ولا إقْتار",66,"ر",1,0],["وكانوا وكانَتْ فترةٌ جَاهِليّةٌ","فقد نَهّجَ اللّهُ السبيلَ وأوضَحا",67,"ح",2,0],["وَكانوا كَآسادِ الشَرى لَيسَ فيهِمُ","كُؤوسٌ فَدارَت لِلمَنايا كُؤوسُها",68,"س",3,0],["وكانوا الأمسِ أرسخَ من جبالٍ","إذا ما زُلزلَتْ قِممٌ وهُضْبُ",69,"ب",1,0],["وَكَانُوا مِثَالاً لِلأُخُوَّةِ يُحْتَذى","وقُدْوَةَ مَنْ يَرْعَى القَرَابَةَ وَالأَصْرَا",70,"ر",2,0],["وكانوا في احتراشِهمُ ذئاباً","فكونوا في ضَراوتكمْ ضِباعا",71,"ع",2,0],["وكانوا كالزُّروعِ شََتْ مُحُولاً","فلمَّا استمْطرتْ مُطِرَتْ جرادا!",72,"د",2,0],["وكان وأمثالُه عبرةً","على ضوئها يهتدي المهتدي",73,"د",2,0],["وَكَانُوا رَقّعُوا أيّامَ سِلْمٍ،","على تِلْكَ القَوَارِحِ والنُّدُوبِ",74,"ب",1,0],["وَكانُوا كَذِي داءٍ، أصَابَ شِفاءَهُ","طَبيبٌ بهِ، تحتَ الشّراسيفِ داخِلِ",75,"ل",1,0],["وَكَانُوا قَوْمَنَا فَبَغَوْا عَلَيْنَا","فَقَدْ لاَقَاهُمُ لَفَحٌ السَّعِيرِ",76,"ر",1,0],["وكانوا حليتي فعطلت منها","وغمدي فالحسام بغير غمد",77,"د",1,0],["وَكانوا لِذا الدينِ لَمّا نَبَت","بِهِ أَرضُ مَكَّةَ نِعمَ الوَزَر",78,"ر",1,0],["وَكانَ وَقارُ الشَيبِ في الناسِ فاشِياً","فَأَعلَمتَهُم أَنَّ الشَبيبَةَ أَوقَرُ",79,"ر",1,0],["وَكانوا هُمُ الحَيُّ اللَقاحُ فَغودِروا","بِها لِلِقاحِ الذُلِّ وَالضَيمِ مَرتَعا",80,"ع",2,0],["وَكَانَ وصُولاً فَلَمّا جَفَا","تَجافَتْ عَنِ الغُمْضِ مِنَّا الجُفُونُ",81,"ن",1,0],["وَكَأَنَّ وَشْيَ رُباكِ يا دَارَ الهَوى","مِنْ عَبْرَتي مُسْتَعْبِرٌ مُسْتَعْلِمُ",82,"م",1,0],["وكَأنَّ وَجْهَكَ نِعْمَةٌ في نقْمَةٍ","لِلنَّاظِرينَ وَجَنَّةٌ في نارِ",83,"ر",1,0],["وكانوا كغمر رام تكثير ربحه","فباع رؤس المال بيع الغبينة",84,"ه",1,0],["وكانوا طغاة سماعيليه","فعادوا هداة سماعيليه",85,"ه",1,0],["وَكانُوا يَظُنّونَ الأَميرَ بِدارِهِ","مُقيماً وَجاءَتهُم بِذاكَ الرَسائِلُ",86,"ل",1,0],["وكأنّ وجهَ الصبح وجهُك صَدَّه","عني رقيُبك فهْو ناءٍ نافر",87,"ر",1,0],["وكانوا يجمعون لها","كأنّهم لها خلقوا",88,"ق",3,0],["وَكانَ وليُّ الأمرِ عنديَ جالساً","نُصوحي جزاهُ اللَّه عن نصحهِ خيرا",89,"ر",2,0],["وَكانوا ذَوي كرٍّ وفَرٍّ لدى الوغا","فعوّضَهم في حقلهِ الكرَّ والفرّا",90,"ر",2,0],["وَكانوا بِأعلى مَنعةٍ مِن حُصونِهم","وَلَم يرهَبوا مِن حِرزِها الليثَ والنَسرا",90,"ر",2,0],["وَكانوا لَنا أَصدِقاءَ مَضوا","تَفانوا جَميعاً فَما خَلَّدوا",91,"د",3,1],["وكان وصيُّ المصطفى خيرةِ الورى","له مزحات ينثر الأُنسَ نَشرُها",92,"ر",3,0],["وكأن وجهك دُرَّة وكأنما","سَكُّ العذار بجانبيه جوهرُ",93,"ر",1,0],["وكأن وجنته ونبت عذاره","طرس به بالمسك سطر ملحق",94,"ق",1,0],["وَكانون في خارِج الدار يَبكي","فَيشتدُّ فيهِ دجى الظُلمةِ",95,"ه",1,0],["وَكَانُوا مِنْ هُرَاءِ الْقَوْلِ نَثْراً","وَكُنْتَ الْمُسْتَجَادَ مِنَ النِّظَامِ",96,"م",1,0],["وكانوا بأموال الأجانب رتعاً","فأسقط في أيديهم حين سيبوا",97,"ب",3,0],["وكانوا يرون المشهديات زينة","فأطغاهم منك الحرير المقصب",98,"ب",1,0],["وَكانوا قَومَنا فَبَغَوا عَلَينا","فَسُقناهُم إِلى البَلَدِ الشَآمي",99,"م",2,0],["وكان وداعُ بعدهُ ضاعَتِ المُنى","كما ضاع دمعٌ من محاجرنا انهمر",100,"ر",1,0],["وَكانَ والدهُ الشيخُ الحسين لهُ","صيتٌ يشيدُ بِه تقواه والكرمُ",101,"م",1,0],["وكانَ والدهُ عبد الكريمِ بن عب","دِ اللّه شيخاً بِنفعِ الخلق يتّسمُ",101,"م",1,0],["وَكانَ وُصولي إِلى بابِها","مِنَ الحُزنِ وَالحَزَنِ لي مَخرَجا",102,"ج",2,0],["وكان والمُلْكَ صاحبَيْنِ معاً","فهاهُما اليومَ ذاهبانِ مَعا",103,"ع",2,0],["وكانوا بِبَسْطِ ندىً أحرياءَ","وأنت به منهمُ اليومَ أحْرى",104,"ر",2,0],["وكأنَّ وجنَتَهُ حَنيَّةُ عاكِفٍ","والدَّمعُ قِنديلٌ علَيهِ مُعلَّقُ",105,"ق",1,0],["وكأن وجهَ هواك كان ملثَّماً","مُتخفِّياً قبل الفراقِ فأسفَرا",106,"ر",2,0],["وكان وقد كان الشبيبة حلتي","يرى طاعتي فرضاً وقربى مغنما",107,"م",2,0],["وكأنَّ وجهَ الأرضِ خَدُّ مُتَيَّمٍ","وُصِلَتْ سُجومُ دُموعِهِ بسِجامِ",108,"م",1,0],["وكانوا على روض المجرَّة أمَّةً","تَفَجَّرَ من أيديهمُ الجود أنهرا",109,"ر",2,0],["وكانوا بجمع وكانَ الكئيب","فحلّوا الغُوَير وحلَّ الحَطيما",110,"م",2,0],["وكانوا باكرين وهمْ رؤوسٌ","فصاروا رائحين وهم كرينُ",111,"ن",1,0],["وكأن ولوال الصبا لما سرى","وأثرا إبرقها بها بهالها",112,"ل",3,0],["وكان وما زالت معاليه هُوةص","وكان ولم يبرح إذا اكتملَ اندثر",113,"ر",1,0],["وكان ولم ينفكَّ ماساةَ مسرحٍ","يُهدّمه الباني وتملؤهُ العبر",113,"ر",1,0],["وكانوا إذا فتنةٌ أظلمتْ","وأعوزهم مَنْ يُجلِّي الكروبا",114,"ب",2,0],["وكانوا عِيَاراً ربما جاد بعضهم","فأعدَى صحاحَ السَّرْحِ يا سعد جُرْبُهُ",115,"ب",2,0],["وَكانوا هُمُ البانينَ قَبلَ اِختِلافِهِم","وَمَن لا يَشِد بُنيانَهُ يَتَهَدَّمِ",116,"م",1,0],["وكان وظيفك الأسمى حجابا","وكنت أظنه الحصن الحصينا",117,"ن",2,0],["وكانوا شعار الدير أراس ملة","هم الناس والأسياد أرض وأعبد",118,"د",1,0],["وكانوا جباه الداهر فافتخرت بهم","وجرت ذيول الزهو أقيال أزمان",119,"ن",1,0],["وكانوا قديماً على صحّةٍ","فقد داخلتهم حُروفُ العللِ",120,"ل",1,0],["وكانوا كالجوارِحِ كاسراتٍ","فولّوا مثلَ نافِرةِ الرّئالِ",121,"ل",1,0],["وكان ورد النيل أقصى أمانه","فحل به من أمنه ما يحاذر",122,"ر",1,0],["وكانوا كلّما كالوا وزنا","فصرنا كلما وزنوا نكيلُ",123,"ل",1,0],["وَكانوا أَهلَ طاعتِهِ فَوَلّى","وَسارَ وَراءَهُ منهُم قَبيلُ",124,"ل",1,0],["وكانوا وعزَّاتُ الزَّمانِ ذليلةٌ","لديهمْ وأجفانُ المنيَّاتِ هُجَّعُ",125,"ع",1,0],["وكانوا زماناً بهجةً لتأمّلٍ","فآبوا اِنقلاباً حَسْرَةً لتذكّرِ",126,"ر",1,0],["وكأنَّ وجهَك قُدَّ من شَمسِ الضُّحى","أم مِنْ سَنا قمر الدّجى مقدودُ",127,"د",1,0],["وكانوا كما كانوا على الحالة التي","بها أزلاً كانوا كلم يك واضع",128,"ع",1,0],["وكان ولم أكن وحلفت إني","كغيري لا أكون ولست حانث",129,"ث",1,0],["وكانَ وِدادُهُ الذَّهبَ المصفَّى","يزيدُ جِلاءَهُ الزَّمَنُ المُحيلُ",130,"ل",1,0],["وَكَانَ وَكُنْتُ بِالإِخْلاَصِ مِنْهُ","بِحَيْثُ يَرَى ابْنَ صَخْرٍ مِنْ زيَادِة",131,"د",2,0],["وكأَنَّ وجهك جنةٌ ما زُخرفت","إِلاَّ وأَجْرَتْ من دُموعي كَوْثرا",132,"ر",2,0],["وكانُوا لها كالعِقْد إِلاَّ أَنَّه وهَى","وأَضْحى لَها جَيْشُ ابن أَيَّوبَ كالغُلِّ",133,"ل",1,0],["وكانوا جِبالاً ثم عادُوا حصىً","بل أَصْبَحوا منْه كَحَبِّ الحَصِيدْ",134,"د",1,0],["وَكَأَنَّ وادي النيلِ مِن أَحزانِهِ","يَلقى عَلى الشَطينِ مشن زَفَراتِهِ",135,"ت",2,0],["وَكانوا كَما الأَعضاءُ في الجِسمِ فَاِغتَدى","عَلى الكُلِّ مِنهُم خَيرُهُ مُتَقَسِّما",136,"م",2,0],["وكانُوا قَبلَ ما تَظهَرُ","في أضيَقَ مِن حَبس",137,"س",1,0],["وكانُوا كالّذي قد زادَ جَهلا","عُبابَ اليَمِّ أمواهَ المُراد",138,"د",1,0],["وكانوا تشيد العالمون بذكرهم","فيورق من ذكراهم كل يابس",139,"س",1,0],["وكانوا بجمع الرأي ترمق نحوهم","عداهم بلحظ المستريب المخالس",139,"س",1,0],["وكانوا بعز البأس يسري لوائهم","رفيعاً فيغلي قدرهم كل باخس",139,"س",1,0],["وكانوا بفضل العلم يشرق عصهم","شروق اللئالي في نحور العرائس",139,"س",1,0],["وكانوا بائتلافهم استعانوا","فما لاقوكمُ حتى استكانوا",140,"ن",3,0],["وكانوا يفكُّون الأسير فأصبحوا","يُمنُّ عليهم بالفكاك من الأسر",141,"ر",1,0],["وكأن وردَ الباقلاءِ على","خُضْرِ الغصونِ حمائمٌ بُلْق",142,"ق",1,0],["وَكانوا يَدفَعونَ الخَصمَ عَنّي","فَيُقصِرُ وَهوَ مَشدودُ الحِناقِ",143,"ق",1,0],["وكانوا بها أسْداً فلما غزَوتَهمْ","غدَوْا بقراً عُو