َّدَها القرآن من زمن","هل يا ترى انسلخت عن عهدها الهدن",218,"ن",1,0],["وَكَانُوا أَعَدُّوا لَنَا إِنَّمَا","مُخَطِّطُنَا شَلَّ أَفْهَامَهُمْ",219,"م",1,0],["وكان وفياً لا يزن بريبةٍ","وكان أبياً لا يذل ويخنع",220,"ع",1,0],["وكان وجه الصواب في أن","أصون نفسي بلا ابتذال",221,"ل",1,0],["وكأن وسوسة الجداول في الدجى","حلي الكعاب برنة الوسواس",222,"س",1,0],["وكانوا في ادِّكارٍ وافتخارٍ","لحيدرَ وابنةِ المختارِ ذكرى",223,"ر",2,0],["وكانوا همُ القومُ الذينَ تتابعوا","ينادونَ منْ يأتي: \"إليكَ بما ترى\".",224,"ر",2,0],["وكانَ وصالُ روحي ذكرياتٍ","بها أنت المواصلُ والوصولُ",225,"ل",1,0],["وكانوا على غير الهدى لاتباعهم","من الدين والتوحيد ما كان أسلما",226,"م",2,0],["وكانوا على غير الهدى لأتباعهم","يقيناً ولما يألفوا قط مأتما",227,"م",2,0],["وكانوا له رداء هناك ومعقلاً","يبوء إليهم في النوازل والضر",228,"ر",1,0],["وكانوننا الثاني يوافيك بلدة","لعشر تراها وهي كالبلدة القفر",229,"ر",1,0],["وكأنّ وجهَكِ في الظّلامِ","البدرُ مسْتَتِرٌ ستارَه",230,"ر",2,0],["وكأنِّ وجهَكِ من شِفَارِ مهندٍ","نورٌ يشعُّ على الدنى مصقولا",231,"ل",2,0],["وكانوا في المعارفِ مثل شمسٍ","سَمَتْ في افقها تجلو الظلاما",232,"م",2,0],["وَكانُوا يُعِدُّونَ القُبُورَ لِمَوْتِهِمْ","فَماتُوا وَما الأَجْداثُ إِلاَّ الحَواصِلُ",233,"ل",1,0],["وكان ودك بالقصايد .. وانثر احساسي نهر","كوني بجنبي قريبه .. وابشري باحلا قصيد",234,"د",1,0],["وكانوا على أفيالهم يرقبوننا","وجئنا على ميعادنا نبدأُ الحصْدا",235,"د",2,0],["وكانوا عصاة ثم دانوا لحكمه","وكلفهم بالرغم وضع الأكلة",236,"ه",1,0],["وكان ولي العهد بعد محمد","علي وفي كل المواطن صاحبه",237,"ب",2,0],["وكان وردك مال قلي بأن الورد مال","كان ما ميّلت قلبي .. عسى حظي يميل !!",238,"ل",1,0],["وكانوا خيرَ من كانوا","ينابيعاً لذي اللُهبةْ",239,"ب",2,0],["وكانوا للشهادة بيتَ وحيٍ","به تحيا نفوسٌ، زادَ شُكْرُ",240,"ر",1,0],["وكانوا أوّلَ التسبيحِ نَفْراً","أغاظوا البغي، ما وهنوا فَسَرّوا",240,"ر",3,0],["وكانوا لا يملُّونَ","فما بالهمُ ملُّوا",241,"ل",3,0],["وكانوا شوكنا الدامي","وكنتُ لهم رياحينا",242,"ن",2,0],["وَكأَنَّ وَصفَ الفَجرِ وَصفُ خِلالِهِ","هذا نَشيدُكَ فَابتَهِج بِجَما