"],[240,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[250,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[271,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[350,"لقد قبض اليأس بسط الرجا","https://www.aldiwan.net/poem15555.html","المتقارب"],[365,"لم يدر ناعيك من إلي نعى","https://www.aldiwan.net/poem60847.html","المنسرح"],[365,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[372,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[372,"كتبت جفونك فوق خدك أسطرا","https://www.aldiwan.net/poem57467.html","الكامل"],[404,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[406,"يوم له فضل على الأيام","https://www.aldiwan.net/poem49756.html","الكامل"],[417,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[417,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[433,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[447,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[454,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[459,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[459,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[472,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[480,"خدمتك أيها المولى بصدق","https://www.aldiwan.net/poem37593.html","الوافر"],[483,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[507,"أخلاء هذا الزمان الخؤون","https://www.aldiwan.net/poem2409.html","المتقارب"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[516,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[528,"بحمدك لا بحمد الناس أضحي","https://www.aldiwan.net/poem45980.html","الوافر"],[541,"غلبت على الخلافة من تمنى","https://www.aldiwan.net/poem56714.html","الوافر"],[552,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[552,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[563,"لعمرك ليس في الدنيا خليل","https://www.aldiwan.net/poem52737.html","الوافر"],[568,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[576,"أغناك طرفك أن تسل الأبترا","https://www.aldiwan.net/poem2954.html","الكامل"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[576,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"]],"verses":[["وَكانوا دُروعي إِن رَمَتني مُلِمَّةٌ","وَنَبلِيَ إِن رامى العِدا وَسِهامي",0,"م",2,0],["وَكانَ وَليُّ العَقدِ وَالعَهدِ بَينَهُ","وَبَينَ بَهاءِ المُلكِ يَسعى وَيَلطُفُ",1,"ف",1,0],["وَكانوا عَلى الأَيّامِ مَلهىً وَمَطرَباً","فَقَد أَصبَحوا لِلقَلبِ مَبكىً وَمَجزَعا",2,"ع",2,0],["وَكانوا أَحاديثَ الرِفاقِ فَأَصبَحوا","أَغاني لِلغورِيِّ وَالمُتَنَجِّدِ",3,"د",1,0],["وَكانُوا بِها وَالْعِزُّ في غُلَوائِهِ","مَطاعِينَ في الهَيْجا طِوالَ السَّواعِدِ",4,"د",1,0],["وَكَانُوا نَعِيمَ الْجَنَّتَيْنِ تَفَيَّأُوا","وَلَمَّا يَقَعْ مِنْهَا النُّزُولُ وَلاَ الْهَبْطُ",5,"ط",1,0],["وَكانوا بِشَحمِ الكُلى قَبلَها","فَقَد جَرَّبوها لِمُرتادِها",6,"د",3,0],["وَكانوا قُعوداً حَولَها يَرقَبونَها","وَكانَت فَتاةُ الحَيُّ مِمَّن يُنيرُها",7,"ر",3,0],["وَكانوا ذَوي نُعمى فَقَد حالَ دونَها","ذَوو أَنعُمٍ فيما مَضى فَاِستَحالَها",8,"ل",3,0],["وَكانوا سُراةَ بَني مالِكٍ","وَزَينَ العَشيرَةِ بَذلاً وَعِزّا",9,"ز",2,0],["وَكانوا أُناساً كُنتُ آمَنُ غَيبَهُم","فَراحوا عَلى ما لا نُحِبُّ فَأَدلَجوا",10,"ج",3,0],["وَكانوا شَيَّدوا في الفَقرِ مَجداً","فَلَمّا جاءَتِ الأَموالُ مَلّوا",11,"ل",3,0],["وَكانوا غَرَّزوا في الرَملِ بَيضاً","فَأَمسَكَهُ كَما غَرَزَ الجَرادُ",12,"د",1,0],["وكأنَّ وشْيَ رُقومها","بالبرق طُرُزَ عَسْجَدَا",13,"د",2,0],["وكأنّ واحدكم لفَرط غروره","ثمِل تَميل بجانبَيْه القرقَف",14,"ف",1,0],["وكانوا به شُمّ العَرانين فاغتدَوْا","يُقاسون أهوالاً به تَجْدع الأنفا",15,"ف",2,0],["وكانوا إذا ما أظلم الدهر أشرقت","به غُرَرٌ من مجدهم وحجول",16,"ل",1,0],["وكانوا في الذؤابة من نزار","وأهل لوائها متنزرينا",17,"ن",2,0],["وَكَانُوا إِخوَةً وَيَداً وكُنَّا","لَهُم في الوُدِّ غَيرَ مُلَوِّنَينَا",18,"ن",2,0],["وَكانوا الكُثرَ يَومَئِذٍ وَلَكِن","كَثُرنا إِذ تَعارَكنا وَقَلّوا",19,"ل",3,0],["وَكانوا مُلوكاً بِأَرضيهِمِ","يُبادونَ غَصباً بِأَمرٍ غَشِم",20,"م",1,0],["وكان واللهوُ مقرونين في قَرَنٍ","فانبتَّ حبلُهُما مني لميعادِ",21,"د",1,0],["وكانوا يدبُّون الضَّراء فأصبحوا","وكل مبادٍ يركضُ الغيَّ مَرْكضا",22,"ض",2,0],["وكأن وقع مشارطٍ من ريشه","في تِلكُمُ الأحناكِ وقعُ مشارط",23,"ط",1,0],["وكأن وعدكم تقيَّل عهدكم","فلقاحه بنتاجه مرهوق",24,"ق",1,0],["وكانوا كأوصال القناة تتابعت","وكنتَ لهم مثل السنان المزلَّق",25,"ق",1,0],["وكانوا جرادَ الأرض يُفنون ريعَها","وأنتم تمجُّ الشهدَ للناس نحلُها",26,"ل",3,0],["وَكانوا السَنامَ اِجتُثَّ أَمسِ فَقَومُهُم","كَعَرّاءَ بَعدَ النَيِّ راثَ رَبيعُها",27,"ع",3,0],["وَكانوا مَعشَراً قَد جاوَرونا","بِمَنزِلَةٍ فَأَكرَمنا الجِوارا",28,"ر",2,0],["وَكانوا كَذي كَفَّينِ أَصبَحَ راضِياً","بِواحِدَةٍ شَلّاءَ مِن قَصَبٍ عَشرِ",29,"ر",1,0],["وكانوا بحاراً للعلوم عميقة","وكانوا جبالاً للحلوم رواسيا",30,"ي",2,0],["وكانوا مصابيح الهدى ونجومها","بهم يهتدى من كان في الليل ساريا",30,"ي",2,0],["وَكانَ وُدُّهُمُ الصافي وَنُصرَتُهُم","لِلمُسلِمينَ وَراعيهِم كَما شاؤوا",31,"ا",1,0],["وَكانوا لَهُ الفَخرَ لَمّا أَتى","وَكُنتَ لَهُ العُذرَ لَمّا ذَهَب",32,"ب",1,0],["وَكانوا يَروعونَ المُلوكَ بِأَن بَدَوا","وَأَن نَبَتَت في الماءِ نَبتَ الغَلافِقِ",33,"ق",1,0],["وَكانوا رَقَّعوا أَيّامَ سِلمٍ","عَلى تِلكَ القَوادِحِ وَالنُدوبِ",34,"ب",1,0],["وَكانوا ثَمودَ الحِجرِ حَقَّ عَلَيهُمُ","وُقوعُ العَذابِ وَالخَصِيُّ لَهُم سَقبُ",35,"ب",1,0],["وَكانَ وَكُنتُ وَالحالانِ شَتّى","بِمُثنٍ بِالإِثابَةِ أَو مُثيبِ",36,"ب",1,0],["وَكانوا خِيارَ الجاهِلِيَّةِ كُلِّها","مَناكِبُهُم في المَجدَ أَعلى المَناكِبِ",37,"ب",1,0],["وَكانوا حُماةَ الناسِ في كُلِّ فَزعَةٍ","وَأَجوادَهُم في الحِصبِ أَوفى اللَوازِبِ",37,"ب",1,0],["وَكَأَنَّ وَجهَكَ حينَ تُسأَلُ مُشرَبٌ","مِن حُسنِهِ ماءَ الحُسامِ المُذهَبِ",38,"ب",1,0],["وَكانوا مَتى ما يُسأَلوا النَصفَ يَشمَخوا","بِآنُفِ شُرّادٍ عَنِ الحَقِّ نُفَّرِ",39,"ر",1,0],["وَكانَ وَراءَ المَدحِ إِذ هُوَ زائِدُ ال","يَدَينِ فَكَيفَ الآنَ إِذ هُوَ كامِلُ",40,"ل",1,0],["وَكانوا إِذا راموا تَعاطِيَ سَعيِهِ","يَفيءُ بِعَجزٍ رَأيُهُم فَيَفيلُ",41,"ل",1,0],["وَكانوا جَمعَ مَملَكَةِ فَآلوا","طَوائِفَ في مَخابيهِم عَزينا",42,"ن",2,0],["وَكانوا عُدولاً فَأَدّوا إِلَي","هِ أَمانَةَ أَيّامِها الخالِيَه",43,"ي",2,0],["وَكانَ وَفاءُ الناسِ خَيرُهُمُ لَهُم","نَدىً وَيَداً قَد أُترِعَت كُلَّ جانِبِ",44,"ب",1,0],["وَكانوا سَراةَ الحَيِّ قَبلَ مَسيرِهِم","مَعَ الأُسدِ مُصفَرّاً لِحاها وَمالِكِ",45,"ك",1,0],["وَكانوا يَرَونَ الدائِراتِ بِغَيرِهِم","فَصارَ عَلَيهِم بِالعَذابِ اِنفِتالُها",46,"ل",3,0],["وَكانو كَذي داءٍ أَصابَ شِفائَهُ","طَبيبٌ بِهِ تَحتَ الشَراسيفِ داخِلِ",47,"ل",1,0],["وَكانوا خَمسَةً إِثنانِ مِنهُم","لَها وَتَحَزُّماً كانا ثِبانا",48,"ن",2,0],["وَكانوا هُمُ المالَ الَّذي لا أَبيعُهُ","وَدِرعي إِذا ما الحَربُ هَرَّت كِلابُها",49,"ب",3,0],["وَكانوا إِذا ما القَرُّ هَبَّت رياحُهُ","وَضَمَّ سَوادُ اللَيلِ رَحَلاً إِلى رَحلِ",50,"ل",1,0],["وَكانوا عَلى الإِسلامِ إِلباً ثَلاثَةً","فَقَد بَزَّ مِن تِلكَ الثَلاثَةِ واحِدُ",51,"د",1,1],["وَكانوا طالَما راحوا","إِلى اللَذّاتِ وَابتَكَروا",52,"ر",3,0],["وَكانوا طالَما أَشِروا","وَكانوا طالَما بَطِروا",52,"ر",3,0],["وكانوا رأوا مَهْدِيَّتَيْكَ وفيهما","لِعِزِّ العدى أمْرٌ فهالَهُمُ الأمرُ",53,"ر",1,0],["وَكانَ وَرائي مِن صَريمَةِ طَيِّئٍ","وَمَعنٍ وَوَهبٍ عَن أَمامِيَ ما يُسلي",54,"ل",2,0],["وكأنَّ وجهَكَ فوقَهُ جدريةٌ","ذهبٌ بسمطي لؤلؤٍ قَدْ رصِّعا",55,"ع",2,0],["وكانوا عن طرائقهِ كسالى","ولكنْ في أذاهُ لهم نشاطُ",56,"ط",1,0],["وَكانَ وَسادَهُ أَحناءُ رَحلٍ","عَلى أَصلابِ ذِعلِبَةٍ هَبوبِ",57,"ب",1,0],["وكانوا إذا ساموا المُتوَّجَ خُطّةً","أتاها وأغضَى يَنزعُ التّاجَ صاغرا",58,"ر",2,0],["وَكانوا كَالأُسودِ الغُلبِ عِزّاً","فَضاعَ العِزُّ وَاِستُلِبَ العَرينُ",59,"ن",1,0],["وَكانوا العُروَةَ الوُثقى إِذا ما","تَصَعَّدَتِ الأُمورُ إِلى عُراها",60,"ا",3,0],["وَكانوا العُروَةَ الوُثقى إِذا ما","تَجَرَّدَتِ الأُمورُ إِلى عُراها",61,"ا",3,0],["وَكانوا بِالرِضا شُغِفوا زَماناً","وَقَد نَفَخوا بِهِ في الناسِ بوقا",62,"ق",2,0],["وَكَأَنَّ وَجنَتَهُ تُفَتِّحُ وَردَةً","خَجَلاً إِذا طالَبتَهُ بِعِداتِه",63,"ت",2,0],["وكانُوا قَدْ مَضَوْا وَهُمُ عُرَاةٌ","فَجَاءُوا بَعْدَ ذَلِكَ مُكْتَسِينا",64,"ن",2,0],["وكأنَّ وفْرَتَهُ غَدائِرُ غادةٍ","لم يَلْقَها بُؤسٌ ولا إقْتار",65,"ر",1,0],["وكانوا وكانَتْ فترةٌ جَاهِليّةٌ","فقد نَهّجَ اللّهُ السبيلَ وأوضَحا",66,"ح",2,0],["وَكانوا كَآسادِ الشَرى لَيسَ فيهِمُ","كُؤوسٌ فَدارَت لِلمَنايا كُؤوسُها",67,"س",3,0],["وكانوا الأمسِ أرسخَ من جبالٍ","إذا ما زُلزلَتْ قِممٌ وهُضْبُ",68,"ب",1,0],["وَكَانُوا مِثَالاً لِلأُخُوَّةِ يُحْتَذى","وقُدْوَةَ مَنْ يَرْعَى القَرَابَةَ وَالأَصْرَا",69,"ر",2,0],["وكانوا في احتراشِهمُ ذئاباً","فكونوا في ضَراوتكمْ ضِباعا",70,"ع",2,0],["وكانوا كالزُّروعِ شََتْ مُحُولاً","فلمَّا استمْطرتْ مُطِرَتْ جرادا!",71,"د",2,0],["وكان وأمثالُه عبرةً","على ضوئها يهتدي المهتدي",72,"د",2,0],["وَكَانُوا رَقّعُوا أيّامَ سِلْمٍ،","على تِلْكَ القَوَارِحِ والنُّدُوبِ",73,"ب",1,0],["وَكانُوا كَذِي داءٍ، أصَابَ شِفاءَهُ","طَبيبٌ بهِ، تحتَ الشّراسيفِ داخِلِ",74,"ل",1,0],["وَكَانُوا قَوْمَنَا فَبَغَوْا عَلَيْنَا","فَقَدْ لاَقَاهُمُ لَفَحٌ السَّعِيرِ",75,"ر",1,0],["وكانوا حليتي فعطلت منها","وغمدي فالحسام بغير غمد",76,"د",1,0],["وَكانوا لِذا الدينِ لَمّا نَبَت","بِهِ أَرضُ مَكَّةَ نِعمَ الوَزَر",77,"ر",1,0],["وَكانَ وَقارُ الشَيبِ في الناسِ فاشِياً","فَأَعلَمتَهُم أَنَّ الشَبيبَةَ أَوقَرُ",78,"ر",1,0],["وَكانوا هُمُ الحَيُّ اللَقاحُ فَغودِروا","بِها لِلِقاحِ الذُلِّ وَالضَيمِ مَرتَعا",79,"ع",2,0],["وَكَانَ وصُولاً فَلَمّا جَفَا","تَجافَتْ عَنِ الغُمْضِ مِنَّا الجُفُونُ",80,"ن",1,0],["وَكَأَنَّ وَشْيَ رُباكِ يا دَارَ الهَوى","مِنْ عَبْرَتي مُسْتَعْبِرٌ مُسْتَعْلِمُ",81,"م",1,0],["وكَأنَّ وَجْهَكَ نِعْمَةٌ في نقْمَةٍ","لِلنَّاظِرينَ وَجَنَّةٌ في نارِ",82,"ر",1,0],["وكانوا كغمر رام تكثير ربحه","فباع رؤس المال بيع الغبينة",83,"ه",1,0],["وكانوا طغاة سماعيليه","فعادوا هداة سماعيليه",84,"ه",1,0],["وَكانُوا يَظُنّونَ الأَميرَ بِدارِهِ","مُقيماً وَجاءَتهُم بِذاكَ الرَسائِلُ",85,"ل",1,0],["وكأنّ وجهَ الصبح وجهُك صَدَّه","عني رقيُبك فهْو ناءٍ نافر",86,"ر",1,0],["وكانوا يجمعون لها","كأنّهم لها خلقوا",87,"ق",3,0],["وَكانَ وليُّ الأمرِ عنديَ جالساً","نُصوحي جزاهُ اللَّه عن نصحهِ خيرا",88,"ر",2,0],["وَكانوا ذَوي كرٍّ وفَرٍّ لدى الوغا","فعوّضَهم في حقلهِ الكرَّ والفرّا",89,"ر",2,0],["وَكانوا بِأعلى مَنعةٍ مِن حُصونِهم","وَلَم يرهَبوا مِن حِرزِها الليثَ والنَسرا",89,"ر",2,0],["وَكانوا لَنا أَصدِقاءَ مَضوا","تَفانوا جَميعاً فَما خَلَّدوا",90,"د",3,1],["وكان وصيُّ المصطفى خيرةِ الورى","له مزحات ينثر الأُنسَ نَشرُها",91,"ر",3,0],["وكأن وجهك دُرَّة وكأنما","سَكُّ العذار بجانبيه جوهرُ",92,"ر",1,0],["وكأن وجنته ونبت عذاره","طرس به بالمسك سطر ملحق",93,"ق",1,0],["وَكانون في خارِج الدار يَبكي","فَيشتدُّ فيهِ دجى الظُلمةِ",94,"ه",1,0],["وَكَانُوا مِنْ هُرَاءِ الْقَوْلِ نَثْراً","وَكُنْتَ الْمُسْتَجَادَ مِنَ النِّظَامِ",95,"م",1,0],["وكانوا بأموال الأجانب رتعاً","فأسقط في أيديهم حين سيبوا",96,"ب",3,0],["وكانوا يرون المشهديات زينة","فأطغاهم منك الحرير المقصب",97,"ب",1,0],["وَكانوا قَومَنا فَبَغَوا عَلَينا","فَسُقناهُم إِلى البَلَدِ الشَآمي",98,"م",2,0],["وكان وداعُ بعدهُ ضاعَتِ المُنى","كما ضاع دمعٌ من محاجرنا انهمر",99,"ر",1,0],["وَكانَ والدهُ الشيخُ الحسين لهُ","صيتٌ يشيدُ بِه تقواه والكرمُ",100,"م",1,0],["وكانَ والدهُ عبد الكريمِ بن عب","دِ اللّه شيخاً بِنفعِ الخلق يتّسمُ",100,"م",1,0],["وَكانَ وُصولي إِلى بابِها","مِنَ الحُزنِ وَالحَزَنِ لي مَخرَجا",101,"ج",2,0],["وكان والمُلْكَ صاحبَيْنِ معاً","فهاهُما اليومَ ذاهبانِ مَعا",102,"ع",2,0],["وكانوا بِبَسْطِ ندىً أحرياءَ","وأنت به منهمُ اليومَ أحْرى",103,"ر",2,0],["وكأنَّ وجنَتَهُ حَنيَّةُ عاكِفٍ","والدَّمعُ قِنديلٌ علَيهِ مُعلَّقُ",104,"ق",1,0],["وكأن وجهَ هواك كان ملثَّماً","مُتخفِّياً قبل الفراقِ فأسفَرا",105,"ر",2,0],["وكان وقد كان الشبيبة حلتي","يرى طاعتي فرضاً وقربى مغنما",106,"م",2,0],["وكأنَّ وجهَ الأرضِ خَدُّ مُتَيَّمٍ","وُصِلَتْ سُجومُ دُموعِهِ بسِجامِ",107,"م",1,0],["وكانوا على روض المجرَّة أمَّةً","تَفَجَّرَ من أيديهمُ الجود أنهرا",108,"ر",2,0],["وكانوا بجمع وكانَ الكئيب","فحلّوا الغُوَير وحلَّ الحَطيما",109,"م",2,0],["وكانوا باكرين وهمْ رؤوسٌ","فصاروا رائحين وهم كرينُ",110,"ن",1,0],["وكأن ولوال الصبا لما سرى","وأثرا إبرقها بها بهالها",111,"ل",3,0],["وَكانوا قَومَنا فَبَغَوا عَلَينا","فَقَد لقاهُمُ لَفَحُ السَعيرِ",112,"ر",1,0],["وكان وما زالت معاليه هُوةص","وكان ولم يبرح إذا اكتملَ اندثر",113,"ر",1,0],["وكان ولم ينفكَّ ماساةَ مسرحٍ","يُهدّمه الباني وتملؤهُ العبر",113,"ر",1,0],["وكانوا إذا فتنةٌ أظلمتْ","وأعوزهم مَنْ يُجلِّي الكروبا",114,"ب",2,0],["وكانوا عِيَاراً ربما جاد بعضهم","فأعدَى صحاحَ السَّرْحِ يا سعد جُرْبُهُ",115,"ب",2,0],["وَكانوا هُمُ البانينَ قَبلَ اِختِلافِهِم","وَمَن لا يَشِد بُنيانَهُ يَتَهَدَّمِ",116,"م",1,0],["وكان وظيفك الأسمى حجابا","وكنت أظنه الحصن الحصينا",117,"ن",2,0],["وكانوا شعار الدير أراس ملة","هم الناس والأسياد أرض وأعبد",118,"د",1,0],["وكانوا جباه الداهر فافتخرت بهم","وجرت ذيول الزهو أقيال أزمان",119,"ن",1,0],["وكانوا قديماً على صحّةٍ","فقد داخلتهم حُروفُ العللِ",120,"ل",1,0],["وكانوا كالجوارِحِ كاسراتٍ","فولّوا مثلَ نافِرةِ الرّئالِ",121,"ل",1,0],["وكان ورد النيل أقصى أمانه","فحل به من أمنه ما يحاذر",122,"ر",1,0],["وكانوا كلّما كالوا وزنا","فصرنا كلما وزنوا نكيلُ",123,"ل",1,0],["وَكانوا أَهلَ طاعتِهِ فَوَلّى","وَسارَ وَراءَهُ منهُم قَبيلُ",124,"ل",1,0],["وكانوا وعزَّاتُ الزَّمانِ ذليلةٌ","لديهمْ وأجفانُ المنيَّاتِ هُجَّعُ",125,"ع",1,0],["وكانوا زماناً بهجةً لتأمّلٍ","فآبوا اِنقلاباً حَسْرَةً لتذكّرِ",126,"ر",1,0],["وكأنَّ وجهَك قُدَّ من شَمسِ الضُّحى","أم مِنْ سَنا قمر الدّجى مقدودُ",127,"د",1,0],["وكانوا كما كانوا على الحالة التي","بها أزلاً كانوا كلم يك واضع",128,"ع",1,0],["وكان ولم أكن وحلفت إني","كغيري لا أكون ولست حانث",129,"ث",1,0],["وكانَ وِدادُهُ الذَّهبَ المصفَّى","يزيدُ جِلاءَهُ الزَّمَنُ المُحيلُ",130,"ل",1,0],["وَكَانَ وَكُنْتُ بِالإِخْلاَصِ مِنْهُ","بِحَيْثُ يَرَى ابْنَ صَخْرٍ مِنْ زيَادِة",131,"د",2,0],["وكأَنَّ وجهك جنةٌ ما زُخرفت","إِلاَّ وأَجْرَتْ من دُموعي كَوْثرا",132,"ر",2,0],["وكانُوا لها كالعِقْد إِلاَّ أَنَّه وهَى","وأَضْحى لَها جَيْشُ ابن أَيَّوبَ كالغُلِّ",133,"ل",1,0],["وكانوا جِبالاً ثم عادُوا حصىً","بل أَصْبَحوا منْه كَحَبِّ الحَصِيدْ",134,"د",1,0]]}