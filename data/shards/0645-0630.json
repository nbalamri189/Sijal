oem40115.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[66,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[44,"أزعمت أن الربع ليس يتيم","https://www.aldiwan.net/poem30360.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[69,"رب كفتي سباني حسنه","https://www.aldiwan.net/poem28287.html","الرمل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[105,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[105,"إلى العزى فقد بلغت مداها","https://www.aldiwan.net/poem44038.html","الوافر"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"بشر بالصبح طائر هتفا","https://www.aldiwan.net/poem26828.html","المنسرح"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"أيها القادم من بص","https://www.aldiwan.net/poem62415.html","مجزوء الرمل"],[48,"يا لاعبا بحياتي","https://www.aldiwan.net/poem62469.html","المجتث"],[48,"أبت عيناي بعدك أن تناما","https://www.aldiwan.net/poem65228.html","الوافر"],[46,"جاء القران وأم الله أرسله","https://www.aldiwan.net/poem23037.html","البسيط"],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[45,"لا جَديدُ الصِّبَا، وَلاَ رَيَعَانُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31846",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[51,"لو أن رِجْليَ عِرسِه يداها","https://www.poetsgate.com/ViewPoem.aspx?id=26194",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[101,"يالواءَ الحسنِ أحزابُ الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62457&r=&rc=49",""]],"verses":[["مَذايِيعُ لِلسِرِّ المَصونِ وَلَيتَهُم","أَذاعوهُ طَلقَ البُردِ لَمّا يُنَمنَمِ",0,"م",1,0],["مَذكورَةٌ ما بَقِيَت","مِن غَيرِ عَقدٍ لِرَتَم",1,"م",1,0],["مُذَكَّرَةٍ لا تَصدِمُ القَومَ صَدمَةً","فَتُقلِعَ إِلّا عَن دَمٍ وَقَتيلِ",2,"ل",1,0],["مُذَبذَبُ الرِزقِ لا فَقرٌ وَلا جِدَةٌ","حَظٌّ لِعَمرُكَ لَم يَحمَق وَلَم يَكِسِ",3,"س",1,0],["مُذنِباً كُلَّما شَكا شاكَ كَيداً","وَإِذا قيلَ قَد أَنابَ أَصَرّا",4,"ر",2,0],["مُذ أَوقَدوا بِأَضلُعي","جَمرَ الغَضا ما خَمَدا",5,"د",2,0],["مَذِقُ الوِدادِ فَوَجْهُهُ مُتَهلِّلٌ","لِمكيدَةٍ وضَميرُهُ مُتَجَهِّمُ",6,"م",1,0],["مُذ رَآها فَتى العَزيزِ مَناماً","وَهوَ في السِجنِ بَينَ هَمٍّ وَيَأسِ",7,"س",1,0],["مُذَلِّلٌ لِلمَساعي حُكمَها شَطَطاً","عَليهِ وَهُوَ العَزيزُ النَفسِ وَالنَفَرِ",8,"ر",1,0],["مُذ نَهانا عَنِ المُدامِ اِنتَهَينا","مَعَ أَنّا نُعَدُّ مِن صِبيانِك",9,"ك",1,0],["مذا تبينه المقالة من","علياء تلك الشيمة الطهر",10,"ر",1,0],["مُذْ شَبَّتِ الثَّوْرَةُ الأُولَى تَوَرَّدَهَا","ظَمْآنَ حُرُّ لَظَاهَا عِنْدَهُ شَبَمُ",11,"م",1,0],["مُذْ رَمَى سَهْمَهُ فَجَاءَ المُعَلَّى","مَا شَكَكْنَا فِي أَنَّهُ سَهْمُ رَامِ",12,"م",1,0],["مَذِقٌ يَلقى أَخاهُ بِالرِضى","وَإِذا ما غابَ عَنهُ سَبَعَه",13,"ه",1,0],["مُذَبَّبةً أَضَرَّ بِها بكُوري","وَتَهجيري إِذا اليَعفورُ قالا",14,"ل",2,0],["مذ أقرّت برقصها كل عين","واسترقّت بصوتها كل أذن",15,"ن",1,0],["مذ حان في نصف النهار دلوكها","هبطت تزيد على النزول نزولا",16,"ل",2,0],["مذ بنَوها لهم كنيسة حرب","تخذت كل مدفع ناقوسا",17,"س",2,0],["مذهب قد نحا إليه أبو ذرٍّ","قديماً في غابر الأجيال",18,"ل",1,0],["مذانب لا تستنبت العود في الثرى","ولا يتحاذى الحائمون فضالها",19,"ه",2,0],["مُذَكَّرَةٌ لا يَحمِلُ السوطَ رَبُّها","ولأياً مِنِ الإِشفاقِ ما يَتَعَصَّبُ",20,"ب",1,0],["مذكَّرة الأسياف من لحظاتها","وقالت علاماتُ الفتور مؤَنثه",21,"ث",2,0],["مذ قيلَ فرعكَ بالذَّوائب عرَّشا","شرِبَ المتيم كاسَ حبِّك وانْتشى",22,"ش",2,1],["مُذال الغنى لو حاولت يدُ سارق","خزائنه ما كانَ في الشرعِ يقطع",23,"ع",1,0],["مذكِّري بدنانيرِ الوجوه هدًى","تحف في فيه عُذَّالٌ مثاقيل",24,"ل",1,0],["مذ أضامتني الليالي جفاني","كرم الإفتخار والإكرام",25,"م",1,1],["مذ فاحَ في ليلايَ مندل عشقتي","أنا تابعٌ في الحبِّ للمجنون",26,"ن",1,0],["مذ خُلقت مرفوعةً رجلاها","كأنما تستغفرانِ اللهَ",27,"ه",1,0],["مذلَّلٌ للمساعي وهْوَ مُشتمِلٌ","بالعزِّ في ظلِّ عَيشٍ مُحْصَد الأَشَبِ",28,"ب",1,0],["مذ صِرتِ همِّي في النوم واليقَظَهْ","أتعبتُ مما أهذي بك الحفَظَهْ",29,"ظ",2,1],["مذاقٌ ومسرىً في العروق كلاهما","ألذُّ من البرء الجديد وأنعمُ",30,"م",1,0],["مَذاهِبُهُ أَنَّ الفِجاجَ عَريضَةٌ","إِذا ضَنَّ عَنهُ بِالفَعالِ أَقارِبُه",31,"ب",2,0],["مُذ كُنتُ لَم تَكُنِ الخِيا","نَةُ في المَحَبَّةِ مِن خَلاقي",32,"ي",1,0],["مَذهَبي في الغَرامِ مَذهَبُ حَقٍّ","وَلَقَد قُمتُ فيهِ بِالبَيِّناتِ",33,"ت",1,0],["مُذ فارَقَت أَحبابَها","لَها جُفونٌ ما اِلتَقَت",34,"ت",1,0],["مُذ كُنتُ فيكُم لَم يَخِب","أَمَلي وَلَم يَخبُ رَجائي",35,"ا",2,0],["مُذْ كانَ له مَلَكٌ في الكونِ","جَميلُ الطَّلعَةِ يَعْبُدُهُ",36,"د",2,0],["مُذِ اِقتَرَنَت بِبَرِّهِمُ يَهودٌ","أَباحَ حُسامُهُم حُسنَ القِرانِ",37,"ن",1,0],["مذهبي وحدة الوجود فلا كا","ئن غير اللَه القديم القدير",38,"ر",1,0],["مُذنِبُكُم قَد غَفَرَ","اللَهُ لَهُ ما أَذنَبا",39,"ب",2,0],["مُذِلُّ الأَعِزّاءِ المُعِزُّ وَإِن يَئن","بِهِ يُتمُهُم فَالموتِمُ الجابِرُ اليُتمِ",40,"م",1,0],["مَذهَبٌ في البَلاءِ بَرَّزتَ فيهِ","قَد يُسادُ الشَريفُ ثُمَّ يَسودُ",41,"د",1,0],["مَذَمَّةٌ مِنهُ تَغَمَّدتُها","بِالصَبرِ حَتّى خُيِّلَت مَحمَدَه",42,"د",2,0],["مُذنِبٌ يُكثِرُ التَجَنّي فَمِنهُ ال","ذَنبُ ظُلماً وَمِنّي الاِعتِذارُ",43,"ر",1,0],["مُذَلَّلُ السَمعِ لِلداعينَ لَيسَ بِذي","بَأوٍ عَلى الصارِخِ الأَقصى وَلا بُذُمِ",44,"م",1,0],["مُذ بَدا صُبحُ وَجهِ حُبّي وَوَلّى","هارِباً مِن سَناهُ صِبغُ اللَيالي",45,"ي",1,1],["مُذ حَكَيتَ الهِلالَ وَالظَبيَ وَالغُص","نَ جَبيناً وَغَنجَ طَرفٍ وَقَدّا",46,"د",2,0],["مُذ قاطَعَني وَصَدَّ عَنّي لاهي","أَجرى عَبرَتي وَأَذكى زَفرَتي",47,"ي",1,0],["مُذ رَأى عِلَّتي وَقَد لاحَ لِلمَو","تِ عَلَيها أَدِلَّةٌ وَشُهودُ",48,"د",1,0],["مُذ دَعَتهُ الأَيّامُ لِلدينِ تاجاً","حَسَدَ الدينَ فيهِ هامُ السِماكِ",49,"ك",1,0],["مَذهَبٌ ما ذَهَبتُ عَنهِ وَدينٌ","ما تَعَرَّضتُ فيهِ لِلإِشراكِ",49,"ك",1,0],["مُذ وُلِدَ الصُبحُ وَماتَ الدُجى","صاحَت فَلَم نَدرِ غِناً أَم نُواح",50,"ح",1,0],["مُذ فَسُدَ العَيشُ رَأى قَصدَهُ","لِلمَلِكِ الصالِحِ عَينَ الصَلاح",50,"ح",1,0],["مَذِلَت وَلَم تَكتُم جَفاءَكَ تَكتَمُ","إِنَّ الَّذي يَمِقُ المَذولَ لَمُغرَمُ",51,"م",1,0],["مَذخورَةٌ أَحرَزتَها بِحُكومَةٍ","لِلَّهِ تَعلو أَرؤُسَ الحُكّامِ",52,"م",1,0],["مَذاكي حَلبَةٍ وَشُروبُ دَجنٍ","وَسامِرُ فِتيَةٍ وَقُدورُ صادِ",53,"د",1,0],["مذْ تبدَّى في جديدٍ فحكى","قمراً طرَّزَ بالبرقِ الدُّجى",54,"ج",2,0],["مذْ أطربَ الأغصانَ صوتُ خريرهِ","مالتْ إليهِ ونقَّطَتْهُ بالحلي",55,"ي",1,0],["مَذِلُ المذاهبِ في الرجالِ مَلولُها","ما سِيمَ خُطّةَ ماجدٍ فأطاقا",56,"ق",2,0],["مُذَمَّمَةٌ تُساقُ لها الهَدَايا","تَظَلُّ دِمَاؤُها تَسْقِي ثَرَاها",57,"ا",3,0],["مَذِلٌ بِغائِبِ ما يُجِنُّ ضَميرُهُ","غَرِدٌ يُعَسِّرُ بِالصِياحِ وَيَنكُدُ",58,"د",1,0],["مُذَلِّلاً لَيسَت لَهُ مَهابَهُ","يَخافُ إِن طَنَّت بِهِ ذُبابَه",59,"ه",1,0],["مُذَكِّراً بِالصَبوحِ صاحَ بِنا","كَخاطِبٍ فَوقَ مِنبَرٍ وَقَفا",60,"ف",2,0],["مُذْ فارَقوا العِجْلَ الّذي فُتِنُوا به","وَدُّوا اتِّخاذَ الأنبياءِ عُجُولا",61,"ل",2,0],["مُذ مَتى عَهدُكَ بِاللَ","هِ بِحَمدانَ اِبنِ رَحبا",62,"ب",2,0],["مُذَكَّرٌ حينَ يَبدو","مُؤَنَّثُ الخَلَواتِ",63,"ت",1,0],["مُذَكَّرَةٌ مُؤَنَّثَةٌ مَهاةٌ","إِذا بَرَزَت تُشَبِّهُها الغُلاما",64,"م",2,0],["مَذاهِبٌ جَعَلوها مِن مَعايِشِهِم","مَن يُعمِلِ الفَِكرَ فيها تُعطِهِ الأَرقا",65,"ق",2,0],["مُذْ غِبْتُمُ عن ناظِري ليَ أنّةٌ","ملأتْ نواحي أرضِ مِصْرَ نُواحا",66,"ح",2,0],["مذ أبصرته انثنى ومرّا","قالتْ ومن دمعها مَسيلُ",67,"ل",1,0],["مَذْعُورَةٌ تَبْغِي الْفِرَارَ مِنَ الرَّدَى","إِنَّ الْفِرَارَ مِنَ الْمَنُونِ وَثَاقُ",68,"ق",1,0],["مُذْعِناً يَصْلُحُ لِلإِقْرَارِ فِي","مَجْلِسِ الأَشْيَاخِ مَحْمُوداً مَقَرَّا",69,"ر",2,0],["مُذَكَّاةً وَحَسْبُكِ نَفْحُ طِيبٍ","مِنَ الجَنَّاتِ تُسْقى شُهدَ نِيلِ",70,"ل",1,0],["مذ سقيناها العلى من دمنا","أيقَنت أن معدا قد نمانا",71,"ن",2,0],["مُذَكِّراً عَهدَهُ بِمَعهَدِهِ","مُنَسِّياً عَتبَهُ بِعُتباهُ",72,"ا",2,0],["مذ رأوْا طَرفَكِ يبدو ناعساً","أيقظوا الفتنةَ في ظلِّ اللواء",73,"ا",2,0],["مُذْ خَلَعْنا ثِيابَكَ القُشْبَ لم نَنْعَمْ","بِشَيءٍ مِنْ مُنْفِساتِ الثّيابِ",74,"ب",1,0],["مُذْهَبَةٌ تَبسِمُ عن حَبابِها","مثلَ جَنى النَّرجِسِ جَادَ فابتَسَمْ",75,"م",1,0],["مذ سقيناها العُلا من دمنا","أيقنت أن مَعَدّاً قد نمانا",76,"ن",2,0],["مَذْحِجيُّ النجارِ والبَيْتِ لمْ يَقْ","عُدْ به، يَومَ سُؤدَدٍ، نَجْرَانُهْ",77,"ن",2,0],["مذا يروع نفوسكم ، ما فيكم","وكلّ ولا التّرك غير جبان",78,"ن",1,0],["مذ خُلقت مرفوعة ً رجلاها","كأنما تستغفرانِ اللاَّها",79,"ا",3,0],["مذلَّلٌ للمساعي وهْوَ مُشتمِلٌ","بالعزِّ في ظلّ عِيصٍ مُحْصَد الأَشَبِ",80,"ب",1,0],["مذ رأوْا طَرفَكِ يبدو ناعساً","أيقظا الفتنة َ في ظلِّ اللواء",81,"ا",2,0]]}