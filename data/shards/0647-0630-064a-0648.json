{"poems":[[74,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[102,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[458,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[458,"الموحيات حيالي لا عداد لها","https://www.aldiwan.net/poem61582.html","البسيط"],[458,"هذي وصيتك النفيسة لم تزل","https://www.aldiwan.net/poem61640.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48742","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38279","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35397","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106829","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74088","الكامل"],[3682,"","https://poetry.dctabudhabi.ae/diwan/poem/131389","الكامل"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144245","الكامل"],[4866,"وصايا العز","https://www.poetsgate.com/ViewPoem.aspx?id=133584",""],[4899,"الوصايا","https://www.poetsgate.com/ViewPoem.aspx?id=177222",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5122,"نصيحة في عجالة","https://www.poetsgate.com/ViewPoem.aspx?id=31515",""],[5127,"هلاّ بعثتِ إلى الفؤادِ رسوﻻ؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=177331",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5277,"وهاد التيه","https://www.poetsgate.com/ViewPoem.aspx?id=185483",""],[5493,"أنينُ الأُمّة","https://www.poetsgate.com/ViewPoem.aspx?id=196995",""],[402,"ألغرس غرسك أيها البستاني","https://www.poetsgate.com/ViewPoem.aspx?id=36486",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6142,"خلق الوصي طلاع الكون ترتع في","https://www.poetsgate.com/ViewPoem.aspx?id=155726",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["هذي وفودك قد أمّت ثراك كما","أمّت بعين الندى قدماً معانيكا",0,"ك",2,0],["هذي وعامتك الفتيّة قصّة","بفم الفتوح وفي شفاه الأدهر",1,"ر",1,0],["هَذي وِلادته وذلك نورهُ","بانَت بأرضِ الشامِ منه قصورهُ",2,"ه",1,0],["هَذِي وَسائِلُها تَدْعوكَ مِنْ كَثَبٍ","وَأَنْتَ أفْضَلُ مَرجُوٍّ لِمَنْ يَئِسا",3,"س",2,0],["هذي وهذي وهذي كلها عبر","لكنهم غفلوا عن هذه العبر",4,"ر",1,0],["هذي وتلك وآلاف تماثلها","عرائس يتنافسن بأبياتي",5,"ت",2,0],["هذي وصيتك النفيسةُ لم تزل","أَلقاً تَرَ جرجً في الغمامِ الوادق",6,"ق",1,1],["هذي وسائلنا هذي مآربنا","هذي عواطفنا هذي سجايانا",7,"ن",2,0],["هَذي وَقَد حَفَّت بِتاريخٍ سَما","عينٌ بِها ماءٌ مَعينٌ عذبُ",8,"ب",1,0],["هَذي وُفودُ السَعدِ نَحوي تَنتَمي","وَطَلائِعُ البُشرى لِبابي تَرتَمي",9,"م",2,1],["هَذِي وَصِيَّةُ نَاصِحٍ وَلِنَفسِهِ","وَصَّى وَبَعدُ سَائِرُ الإخوَانِ",10,"ن",1,0],["هذي وجوههم انظريها كلها","لطخٌ نَبَت ذوقاً وساءَت منظرا",11,"ر",2,0],["هَذي وفودهموا وَخا","في القصد منها غير خافِ",12,"ف",1,0],["هذي وصية ناصح فاسمع وع","واعمال هديت إذا وعيت بما تعي",13,"ع",2,1],["هذي وصيتي التي أوصيكها","أكرم بها من والد متودد",14,"د",1,0],["هذي وصايا العزّ خذها مظلّه","لمّا هجير الذلّ يوجع نواظرك",15,"ك",1,0],["هذي وصايا جبتها بالتفاسير","فيها العقول النيره غصب تحتار",16,"ر",1,0],["هذي ودائع من أحب مصونة","دون الترائب تحت ختم محاجري",17,"ر",2,0],["هذي وذكر الله ولفض الجلاله","هو خالقي وانا بعد راجع له",18,"ل",2,0],["هذي وأنتِ تعلمينَ بأنني","أمطي القوافيَ والرهانَ صهيلا",19,"ل",2,0],["هذي وصوف الخيل ياهل البطولات","ويالله عسا بالوصف مافيه زلّه",20,"ل",2,0],["هذي وهادُ التيه صرن مساربي","من ذا يريني للحبيبةِ مسربا",21,"ب",2,0],["هَذِي وُجُوهٌ بِحِبرِ الْغَدْرِ قدْ وُسِمَتْ","وَيَمَّمَتْ شَطْرَ منْ شَقُّوا بِها حُفَرَا",22,"ر",2,0],["هذي وفودهم إليك توافدت","تلقاك من متعدد الوطان",23,"ن",1,0],["هذي وهذي يفيد العلمَ مزْجُهما","كما الينابيع تجري ترفد الحوضا",24,"ض",2,0],["هذيْ وفودُ الحَمدِ صادرةً فَخُذْ","بطريقهِمْ تُبلِغْكَ أَعْذَبَ مَورِدِ",25,"د",1,0],["هذِي، وَحَقِّ اللّهِ، هِجْرَةُ أَحْمَدٍ","هذِي وِلاَدَةُ دَوْلَةٍ وَنِظَامِ",26,"م",1,0],["هذي وتيرته وهي الوتيرة للر","رُسلِ التي أرسلت للخلق تهديها",27,"ي",3,0],["هذي وصيَّةُ من أرْضَعْتِهِ شَمَماً","فلتقرئي ما بها إنْ تُسدَلِ السُّتُرُ",28,"ر",1,0]]}