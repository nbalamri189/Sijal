53952.html","الطويل"],[426,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[429,"تغير عن مودته وحالا","https://www.aldiwan.net/poem12316.html","الوافر"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[438,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[451,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[451,"تحية مغترب حاضر","https://www.aldiwan.net/poem61733.html","المتقارب"],[456,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[456,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[456,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[462,"تكف بصبر فالسؤال مذلة","https://www.aldiwan.net/poem3528.html","عموديه"],[477,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[477,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[513,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[513,"فدى لبني رزيك قوم رفعتهم","https://www.aldiwan.net/poem12149.html","الطويل"],[513,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[513,"رأيتك في المنام بعثت نحوي","https://www.aldiwan.net/poem12273.html","الوافر"],[522,"نبي براه الله من نوره الأسمى","https://www.aldiwan.net/poem13283.html","الطويل"],[549,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[549,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[564,"هل للفتى من بنات الدهر من واق","https://www.aldiwan.net/poem1928.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"فديتك كم علي عليك عذل","https://www.aldiwan.net/poem17649.html","الوافر"]],"verses":[["وَأَرسَلتَها بِغِرارِ الحُسامِ","وَخاطَبتَها بِلِسانِ السِنانِ",0,"ن",1,0],["وَأَرسَلَها تَخُبُّ بِدارِ زَينٍ","عُبابَ اليَمِّ لَجَّ بِهِ اِلتِطامُ",1,"م",1,0],["وَأَرْسَلَ الْغَيْمُ نَبْلاً مِنْ سَحَائِبِه","أَدْمَى بِصَائِبِها وَرْداً وَنُعْمَاناً",2,"ن",2,0],["وَأَرْسَلْتَ يَوْمَ السَّبْقِ كُلَّ طِمِرَّةٍ","كَمَا تُرْسَلُ الْمَلْمُومَة النَّارُ وَالنَّفْطُ",3,"ط",1,0],["وأرْسَلْتُ دمْعَ العينِ حينَ قرأتُها","فمِنْها أمامي روْضَةٌ وغَديرُ",4,"ر",1,0],["وأرْسَلْتَ فيها جَدْوَلَ الماءِ سائِلاً","كما سُلّ مَصْقولُ الغِرارَيْنِ منْ غِمْدِ",5,"د",1,0],["وَأَرسَلتَ تَستَسقي بَني مِصرَ شَربَةً","فَقَطَّعتَ أَحشائي وَأَضرَمتَ أَضلُعي",6,"ع",2,0],["وأرسلوهنّ مُرخاةً أعِنّتها","يُوغِلن في الأمر إحضاراً وتقريبا",7,"ب",2,0],["وأرسلت دمعَ العين فانهلَ جارياً","له بين أطلال الديار مسيل",8,"ل",1,0],["وأرسلته عفواً فجاء كما ترى","قَوافيَ تَجتْاب البلادِ سراعا",9,"ع",2,0],["وأرسلته نظماً يروق انسجامه","فيحسبه المصغي لانشاده نثرا",10,"ر",2,0],["وأرسلت قلبي خلفهنّ مشيعاً","فراح ولم يرجع إلى حيث لا أدري",11,"ر",2,0],["وَأَرسَلَهُ في الناسِ نوراً وَرَحمَةً","فَمَن يَرضَ ما يَأتي مِنَ الأَمرِ يَهتَدِ",12,"د",1,0],["وأرسلتُم طيف الخيال لمقلةٍ","إذا ما أتاها استصحب السهد ضيفنا",13,"ن",2,0],["وأرسلتها غرَّاء كالغصن يانعاً","وزهر الرُّبى ريَّان والريح سلسلا",14,"ل",2,0],["وارسل طرفي الى ما بقربي","فيرجع طرفي وهو كليل",15,"ل",1,0],["وأرسلي الشجو أسجاعا مفصلة","أو ردّدي من وراء الأيك إنشادي",16,"د",2,0],["وَأَرسَلتُها في سَماءِ الخَيالِ","تَجُرُّ عَلى النَجمِ أَذيالَها",17,"ل",3,0],["وَأَرسَلنَ الرِياحَ عَلَيهِ ناراً","فَما حَفَلَ الجَنوبُ وَلا الشَمالا",18,"ل",2,0],["وَأَرسَلَ عائِلاً مِنكُم يَتيماً","دَنا مِن ذي الجَلالِ فَكانَ قابا",19,"ب",2,0],["وأرسلَ البلبلَ الغِرّيدَ يُطْرِبُها","إياكَ والروضَ فالمِكواةُ في النارِ",20,"ر",1,0],["وَأَرسَلتُ أَفوافَ القَوافي شَوافِعاً","إِلَيكَ وَقَد يُجدي لَدَيكَ رَسولُها",21,"ل",3,0],["وَأَرسَلَ يَرجو اِبنُ المَراغَةِ صُلحَنا","فَرُدَّ وَلَم تَرجِع بِنُجحٍ رَسائِلُه",22,"ل",2,0],["وَأُرسِلُ مَع ثِقاتِكَ مِن حَديثي","عِتاباً دونَهُ السِحرُ الحَلالُ",23,"ل",1,0],["وَأَرسَلتُ آمالاً خِماصاً بُطونُها","إِلَيكَ فَعادَت مُثقَلاتٍ ظُهورُها",24,"ر",3,0],["وَأَرسَلَها عَلى موقانَ رَهواً","تُثيرُ النَقعَ أَكدَرَ بِالكَديدِ",25,"د",1,0],["وَأَرسَلَ الرُّسلَ تَترى لِلمُلوكِ بِما","فِيهِ بَلاغٌ لِأَهلِ الذِّكرِ وَالفَهَمِ",26,"م",1,0],["وَأَرْسَلَ الْغَيْثَ أَرْسَالاً بِرَحْمَتِهِ","وَأَنْبَتَ الأَرْضَ مِنْ حَبٍّ وَرَيْحَانِ",27,"ن",1,0],["وَأَرسَلَت فَجاءَني","بَنانُها المُطَرَّفُ",28,"ف",1,0],["وَإِرسالِها لَمّا أُجِدَّ رَحيلُها","عَلى عَجِلٍ بادٍ مِنَ البَينِ موفِدِ",29,"د",1,0],["وَأَرسَلَ اللَحظَةَ مَكسورَةً","مِن تَرَفٍ وَالخُطوَ مَقصورا",30,"ر",2,0],["وأَرسلتَهُ مِلءَ الزّمانِ مُغامِراً","وكان صريعاً ما يُواتيك رازِحُهْ",31,"ح",2,0],["وأرسلَ الصّوتَ يُسدِي النُّصحَ فابتدرت","مِصرُ الجريحةُ تستشفِي بنجواهُ",32,"ا",2,0],["وأرسلَ يا بَجَيْرُ صبأت لمّا","سَقَاكَ بكأسِهِ السمحُ الجَوادُ",33,"د",1,0],["وأرسله النبيُّ فخالفوه","وقالوا لا يُصابُ لنا قتيلُ",34,"ل",1,0],["وأرسلها الصِّدِّيقُ دِيمةَ حِكمةٍ","لها من فمِ الفاروقِ سَحٌّ وتَهطال",35,"ل",1,0],["وأُرسِلتُ لَم أُرسَل غَويّاً ولَم أَكُن","شَقيّاً ولَم أُبعَث بِفُحشٍ وَمَأثَمِ",36,"م",1,0],["وَأُرسِلَتِ الحَمامَةُ بَعدَ سَبعٍ","تَدُلُّ عَلى المَهالِكِ لا تَهابُ",37,"ب",1,0],["وَأَرسَلَ نوراً كَالعَمودِ أَمامَهُم","يُنيرُ الدُجى كَالصُبحِ غَيرَ مُزايلِ",38,"ل",1,0],["وَأَرسَلَ الرُسلَ إِلى اِبنِ عيسى","وَكادَ أَن يَجعَلَهُ قِسّيسا",39,"س",2,0],["وَأَرسَلتُهُ مُستَطعِماً لِعِنانِهِ","أَخا ثِقَةٍ ما أَنتَ إِلّا مُبَشِّرا",40,"ر",2,0],["وَأَرسَلَ الشَيبُ في رَأسي وَمَفرِقِهِ","بُزاتَهُ البيضَ في غِربانِهِ السودِ",41,"د",1,0],["وَأَرسَلتُها في الكَأسِ راحاً كَريمَةً","تَعَطَّرُ بِالرَيحانِ أَحكَمَها الدَهرُ",42,"ر",1,0],["وَأَرسَلَت عَبرَتَها تُمورُ","مَريَ الحَبابِ جَريُهُ مَجدورُ",43,"ر",1,0],["وَاِرسُم بِفَخّارِ شَرابَكَ لاتُرِد","قَدَحَ اللُجَينِ وَلا إِناءَ العَسجَدِ",44,"د",1,0],["وأرسطاليسُ الكبيرُ وقد أغر","قَ منه المشاعرَ التفكير",45,"ر",1,0],["وأرسلْ على الوادي حمائمَ أيكه","برنّة ولْهى أو شكاة عميدِ",46,"د",1,0],["وأرسلتها بعد نسيانها","حديثَ النباهةِ والعارفَه",47,"ف",2,0],["وأرسلهُ سمحاً من قريحةِ شاعرٍ","يعيشُ بروحِ الصَّيْدحيِّ المجدِّدِ",48,"د",1,0],["وأرْسَلْتِ طَيْفاً خانَ لمّا بَعثْتِهِ","فلا تَثِقِي مِن بعدِهِ برَسُولِ",49,"ل",1,0],["وأَرْسَلْت فِيك الشِّعْرَ لَوْعَةَ مُوجَعٍ","تَئِنُّ قَوَافيه وتَبْكي صَدَائِبه",50,"ه",1,0],["وأرسلتها من صَيْحةٍ نبويَّةٍ","يَمُور لها قَلْبُ الجبالِ ويُرْعَبُ",51,"ب",1,0],["وأرسلتَ صوْتاً في البلادِ مجلجِلاً","سمعنا به زأرَ الضراغِمِ في الأجْمِ",52,"م",1,0],["وأرْسَلُوها إِلَى العَلْياءِ فانْطَلَقتْ","تَعْدُو إِلَى الْمَجْدِ في جدٍّ وإمْعانِ",53,"ن",1,0],["وأرسلها في الخافقيْنِ وثيقةً","لها الحبُّ يُمْلى والوفاءُ يوقِّعُ",54,"ع",1,0],["وأرسلتِ الصحائفُ منك نوراً","ففرَ الشكُ من وَضَحِ اليقين",55,"ن",1,0],["وأرْسَى على الأَرض أهْرَامَه","فأَصغرت الأرض أوتادها؟",56,"د",3,0],["وأرسل شعرهُ المضغوط، يحكي","وميض البرق، أو لمع الشهاب",57,"ب",1,0],["وأرسل الغيم نبلا من سحائبه","أدمى بغيثها وردا ونعمانا",58,"ن",2,0],["وأرسلت فيه جدول الماء سائلا","كما سل مصقول الغرارين من غمد",59,"د",1,0],["وأرسل البدرُ طيفاً من أشعّتِه","كان الضمينَ بإنياس الدياجير",60,"ر",1,0],["وَأَرسل دَمعَهُ وَبَكى معيناً","وَأَينَ بُكا المعان مِن المَعين",61,"ن",1,0],["وأرسَلَ مِن كِنَانَتِهِ سِهاماً","بِلاَ سَبَبٍ ِإلىَّ ولاَ سَلاَمِ",62,"م",1,0],["وَأَرسَلتَ العِتاقَ الجُردَ قُبّاً","يُعارِضُ مُمتَطىً مِنها مَقودُ",63,"د",1,0],["وَأَرسَلَها سَومَ الجَرادِ مُغيرَةً","تَخِرُّ جِبالُ الأَرضِ مِن وَقعِها هَدّا",64,"د",2,0],["وَاِرسُم لِدَهرِكَ ما تَختارُ يَجرِ عَلى","عاداتِ مُستَمِعٍ لِلرَسمِ مُمتَثِلِ",65,"ل",1,0],["وَأَرسَلتَ فيهِم أَميناً كَفاكَ","فَقَسَّمَ بِالعَدلِ ذاكَ النَفَل",66,"ل",1,0],["وأرسل مهجتي نحو المناي","وأدفع عاشقي دفعا جريَا",67,"ي",2,0],["وأرسل فيهم قطعة من خيوله","نهكن يسيرا من دمائهم نهكا",68,"ك",2,0],["وأرسل في شتمي لسانا ذليقة","على ثقة من انني لا أجوب",69,"ب",1,0],["وأرسخ خلق الله علما أشدهم","بتكييفه جهلا وذلك محصب",70,"ب",1,0],["وأرسلُ حَظّي لبعضِ بطانٍ","أيا ويحَ حَظّي خميصًا يَؤوبُ",71,"ب",1,0],["وَأَرسلَ مِن أصحابهِ يوم مؤتةٍ","أُسوداً بأرضِ الشامِ قَد زَأَروا زأرا",72,"ر",2,0],["وَأرسلهُ طرّاً لكلّ الخلائقِ","وَأولاهُ علماً في جميع الحقائقِ",73,"ق",1,0],["وأرسلتْ فَرْعَاً غدا لَوْنُهُ","كحالِ مَنْ يُحْرَمُ منها التَّلاق",74,"ق",1,0],["وأرسلتْ منْ مثنّى فرعها غَسقاً","في ليلةٍ أرسلتْ فرعاً مِنَ الغسق",75,"ق",1,0],["وأرسطو والغزالي ما الذي","لقياه في ذراه من عثور",76,"ر",1,0],["وأرسم للمنى حداً","وما لجواي من حدّ",77,"د",1,0],["وأرسل الزفرة الحراء لافحة","كوقدة الجمر في آجام قصباء",78,"ا",2,0],["وأرسل الشِّعر وهي تلهو","وترسل الشَّعر للوراء",79,"ا",2,0],["وأرسلت بالحق المبين محمدا","أجل الورى من حاضرين ومن بدو",80,"و",1,0],["وَأَرْسَلَهُ الإِلَهُ لَنَا بَشِيراً","نَذِيراً بِالذِي بَعْدَ الْمَنُونِ",81,"ن",1,0],["وأرسل اللحظ نذيراً وقد","كلم قلبي بمناجاته",82,"ت",2,0],["وارسل من راحاته لعفاته","سحائب معروف سوار مركبا",83,"ب",2,0],["وأَرسلَه الرحمنُ للخلق رحمةً","فأنقذهم بالنور من ظلمةِ الكُفرِ",84,"ر",1,0],["وأرسلنا النفوسَ علَى هواها","بما تقضي مروءَتها تبارى",85,"ر",2,0],["وَأَرسَلَهُ بِالحٌَ وَالصدق وَالهُدى","وَبَذل النَدى وَالرفق وَالمَنطق العَذب",86,"ب",1,0],["وأرسل حكيما في أمور شديدة","ولا توصه الا بالفاظ أجفان",87,"ن",1,0],["وأرسيت عزمي منك وهو ملجج","ببر طما بالبر أبحر فضله",88,"ل",2,0],["وَاِرسُم خَطَّ السَيرِ في زَورَقِ المُنى","وَالهَد مَهرَ الأُنسِ وَسطَ الفَدافِدِ",89,"د",1,0],["وَأَرسَلَ مُهمَلاً جَذِعاً وَحُقاً","بِلا جَدعِ النَباتِ وَلا جَديبِ",90,"ب",1,1],["وَأرسلُوها يَقَقاً أَوْ ظُلَماً","عَليّ في جُنْحِ الدُّجَى المُعْتَكِرِ",91,"ر",1,1],["وأرسَلَ الخَيلَ زُمَر","عَوابِساً معَ الغُرَر",92,"ر",1,0],["وَأَرسَلتُ الزَفرَةَ","فَلَو صافَحتَ رَضوى لَرُض وَهُدِّما",93,"م",2,0],["وأَرسلَتِ اللَّحظَ الضَّعيفَ مع الهَوى","لِيَقوى فَأرسَلتُ القَويَّ لأضعُفا",94,"ف",2,0],["وأرسلتَها حوراء مَصْحوبة الرضى","فَقُلتُ انظروها فَهْي من حُورِ رضوانِ",95,"ن",1,0],["وإرسالُ عبرتِه في الديار","تُعبِّرُ عن فرطِ أشجانه",96,"ن",2,0],["وأرْسَلَها مثلاً في الثناء","وخَصَّ بمن شاءَ إرسالها",97,"ل",3,0],["وأُرسلُ في طيّ النَّسيم تحيَّةً","إليكَ وما غير النسيم رسول",98,"ل",1,0],["وارسل من فتور اللحظ رسلاً","لتدعو للغرام بلا فتورِ",99,"ر",1,0],["وأُرسلُها شوارِدَ مطلقاتٍ","تكونُ لعقلِ سامِعِها عِقالا",100,"ل",2,0],["وأَرسَلْنَا من الأَشعارِ رِيحًا","نَهُزُّ بها المعاطِفَ من ثَبِيرِ",101,"ر",1,0],["وأرسل الرسل تبشيراً ومنذرة","فبلغت صدق مولاها الذي صدقا",102,"ق",2,0],["وأرسلت آمالي خماصاً بطونها","إليك فجاءت مفعماتٍ جلودها",103,"د",3,0],["وأرسم اليوم معنى مجدها الثاني","في فخم ألوانه لا فخم ألواني",104,"ي",1,0],["وارسلتها فوق متن الخيال","فريداً من الأَلقِ الطاهرِ",105,"ر",1,0],["وأرسلتُ اللحاظَ على يقينٍ","بما تجني العيونُ على الجسومِ",106,"م",1,0],["وأرسلت أنملٌ لواها ال","ظنُّ على عهده المُحيلِ",107,"ل",1,0],["وأرسلتُ عَينيَ بالأَنعَميْنِ","لتُبصِرَ لو أنها تُبصرُ",108,"ر",1,0],["وأرسل من رَسَن الإقتضاءِ","أواناً أعرِّض أو أذكُرُ",108,"ر",1,0],["وأرسلَ لي مع العُوَّاد طيفاً","يُرِي كرماً وصاحبُهُ شحيحُ",109,"ح",1,0],["وأُرسِلُ طَرفي رائداً في خميلةٍ","من الناسِ أبغي نُجعةً لمطَالبي",110,"ب",2,0],["وأرسلتُ عيني في الزمان وأهله","فما عثرت أجفانها بكريم",111,"م",1,0],["وأرسلها ميامن طائرات","خبير بابن بجدتها عليم",112,"م",1,0],["وارسلتها لأهليهن جامعة","برين في عمل بالنقد والحلل",113,"ل",1,0],["وأرسلَتْ للدُجى من فرعِها مثلاً","تمثّلَتْهُ فُروعُ البانِ والعذَبُ",114,"ب",1,0],["وأرسلها مسومة عراباً","تفيض من الوهاد على الروابي",115,"ب",2,0],["وأرسلته في الحسن وتراً كأنني","أطالب عند النائبات به وترا",116,"ر",2,0],["وأرسلتها مثل النسور كواسراً","تسوق حماماً نحو سرب الحمائم",117,"م",1,0],["وأرسلها وضم الشرب فيها","كخود فوق وجنتها عرامة",118,"م",2,0],["وَأرسله فَضلاً إِلى الخَلق كلهم","وَأسبغ في إِرسالِهِ الفَضل وَالنّعما",119,"م",2,0],["وأَرسفُ في قيدٍ من الحزمِ عنوةً","ومن ذيدَ عن بسط الخُطا فهو يَرسُفُ",120,"ف",1,0],["وأرسلتَ تستدعِي المديحَ وإنّه","لرأسِيَ تاجٌ والسّواران في يدِي",121,"د",2,0],["وأرسلت طوفاناً عليهم فأغرقوا","ولم ينج إلا من معي في سفينتي",122,"ي",1,0],["وأرسلت روحي طبق ما هو عادتي","إلى الأم حتى كان مظهر نفختي",122,"ي",1,0],["وَأَرسَلوا فِتيَةً مِن خَيرِهِم حَسَباً","لِيُسنِدوا في ضَريحِ التُّربِ أَطبَاقي",123,"ي",1,0],["وأرسل الماء إليه إذ منع","منه وذاك ثابت فيما سمع",124,"ع",1,0],["وَأَرْسَلَ صُدْغهُ عَرْفاً نِثَاراً","بِخدٍّ مَا لَهُ فِي الوَرْدِ مِثْلُ",125,"ل",1,0]]}