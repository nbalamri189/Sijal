{"poems":[[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[3,"حكم سيوفك في رقاب العذل","https://www.aldiwan.net/poem192.html","الكامل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[88,"حياة الورى جسر مديد وإنما","https://www.aldiwan.net/poem45058.html","الطويل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"وقت شاربيها النار عمدا بنفسها","https://www.aldiwan.net/poem64703.html","الطويل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[29,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[43,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[62,"قد زرعنا النضار في الفضة","https://www.aldiwan.net/poem52156.html","الخفيف"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[58,"أتاني أن هندا أخت صخر","https://www.aldiwan.net/poem31088.html","الوافر"],[107,"قفي ساعة يفديك قولي وقائلة","https://www.aldiwan.net/poem69426.html","عموديه"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[46,"وقت يمر وأقدار مسببة","https://www.aldiwan.net/poem23130.html","البسيط"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[19,"صبوت وهل تصبو ورأسك أشيب","https://www.aldiwan.net/poem323.html",""],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85722","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2232","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[100,"خطرات","https://www.poetsgate.com/ViewPoem.aspx?id=50194",""],[100,"عازف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50174",""],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[45,"أكنتَ مُعَنّفي، يوْمَ الرّحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32199",""],[51,"يا بن داود يا فقيه العراق","https://www.poetsgate.com/ViewPoem.aspx?id=29981",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[115,"آه على وقت مع الاحباب","https://www.aldiwan.net/poem41219.html","عموديه"],[115,"قلب غدا كالبعض من خاله","https://www.aldiwan.net/poem41522.html","السريع"],[143,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[143,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[160,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[181,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[185,"يا من صفا لي ظاهرا ونيه","https://www.aldiwan.net/poem14691.html","الرجز"],[185,"هي دار العيش العزيز بما ضم","https://www.aldiwan.net/poem14788.html","الخفيف"],[189,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[197,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[199,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[203,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[210,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[229,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[235,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[270,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[275,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[275,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[287,"وقتيل مرة أثأرن فإنه","https://www.aldiwan.net/poem1896.html","الكامل"],[342,"حنانيك اخت البكا والانين","https://www.aldiwan.net/poem55327.html","المتقارب"],[342,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[363,"سمونا بالجياد إلى أعاد","https://www.aldiwan.net/poem1714.html","الوافر"],[371,"لقلع ضرس ومضغ كلس","https://www.aldiwan.net/poem56921.html","مخلع البسيط"],[371,"وقتيل الجفون سقما تفانت","https://www.aldiwan.net/poem57201.html","الكامل"],[380,"ملأ الغرام فؤاده فتصدعا","https://www.aldiwan.net/poem49244.html","الكامل"],[391,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[393,"برئت من الأرجاس رهط امية","https://www.aldiwan.net/poem53633.html","الطويل"],[437,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[464,"ذاك سلع فاندب معي أطلاله","https://www.aldiwan.net/poem3614.html","عموديه"],[482,"نور الحق هداني بفضل عطاني","https://www.aldiwan.net/poem24198.html","عموديه"],[486,"نُبئت أنك جئت تسري","https://www.aldiwan.net/poem456.html",""],[509,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[515,"أبا المجد إن تزمع رحيلاً فللندى","https://www.aldiwan.net/poem12210.html","الطويل"],[529,"قالوا أتيت مؤخرا","https://www.aldiwan.net/poem37423.html","مجزوء الكامل"],[540,"هيهات أوتي في سراتهم","https://www.aldiwan.net/poem56647.html","البسيط"],[551,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[554,"بكر العواذل بالسواد يلمنني","https://www.aldiwan.net/poem1850.html","الكامل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[575,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["وَقَتْكِ الرّدى بيضٌ حِسانٌ وُجوهُها","ومُثْرِيَةٌ منْ نَضْرَةٍ وجَمالِ",0,"ل",1,0],["وَقَتَلتُ فارِسَهُم رَبيعَةَ عَنوَةً","وَالهَيذُبانَ وَجابِرَ بنَ مُهَلهَلِ",1,"ل",1,0],["وَقَتْكَ أَوَاقِي اللَّهِ مِنْ كُلِّ غَائِلٍ","فَأَيُّ سِلاَحٍ مَا الْمِجَنُّ وَمَا اللَّمْطُ",2,"ط",1,0],["وقَتْ مُلْكَكَ المَحْروسَ منْ كُلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عن الآلِ والجُنْدِ",3,"د",1,0],["وقَتْ بَيْتَكَ المعْمورَ منْ كلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عنِ الآلِ والجُنْدِ",4,"د",1,0],["وقتل الردى قتل جبار فلم تكن","لتدُرك فيه ثأرها نفس ثائر",5,"ر",1,0],["وَقَتِيلٌ بالطَّفِ غُودِرَ منهُ","بَينَ غَوغاءِ أُمّةٍ وَطَغَامِ",6,"م",1,0],["وَقَتَلنا مِنكُمُ أَهلَ اللِوَا","إِذ لَقيناكُم كَأَنّا أُسدُ طَلّ",7,"ل",1,0],["وَقَتلاكُمُ في النارِ أَفضَلُ رِزقِهِم","حَميمٌ مَعاً في جَوفِها وَضَريعُ",8,"ع",1,0],["وقتيلٍ بغير جُرمٍ جناه","وجريحٍ مُسَلَّمِ الأعضاءِ",9,"ا",2,0],["وَقَتْكَ يدُ الإله أبا عليٍّ","ولا جَنحتْ بساحتك الخطوبُ",10,"ب",1,1],["وَقتَّلَ أجْذَالَ العِبَادَةِ عَنْوَةً","وهُمْ رُكَّعٌ بَيْنَ السَّوَارِي وسُجَّدُ",11,"د",1,0],["وقَتْ شاربيها النارَ عمداً بنفسها","وما كان جسمُ النار جسماً تُلامسه",12,"س",2,0],["وقت شاربيها النارَ عمداً بنفسها","وما كان جسمُ الفار جسماً يلامسُهْ",13,"ه",1,1],["وقتالُ من لا تستطيع قِتالهُ","في الناس يكسبُ رأيكَ التفييلا",14,"ل",2,0],["وقتكَ أبا سهلٍ يدُ الله إنني","أراك يداً دفّاعةً للعظائمِ",15,"م",1,0],["وَقَتلى بَني رِعلٍ كَأَنَّ بُطونَها","عَلى جَلهَةِ الوادي بُطونُ حَميرِ",16,"ر",1,0],["وَقَتَلتُ في نَفسي الرَغائِب وَالمُنى","فَقَهَرتُهُ بِتَجَرُّدي وَتَزَهُدي",17,"د",2,0],["وَقَتكَ العِنايَةُ بِالراحَتَينِ","وَطَوَّقَ جيدَكَ إِحسانُها",18,"ن",3,0],["وَقَتَلتَ الزَمانَ عِلماً فَما يُغ","رِبُ قَولاً وَلا يُجَدِّدُ فِعلا",19,"ل",2,0],["وَقَتَلنَ دَفراً وَالدُهَيمَ فَما تُرى","أُمُّ الدُهَيمِ وَأُمُّ دَفرٍ هابِلُ",20,"ل",1,0],["وَقَتَّلَ الكُردَ عَنِ القِتالِ","حَتّى اِتَّقَت بِالفَرِّ وَالإِجفالِ",21,"ل",1,0],["وَقتٌ يَضيعُ وَعُمرٌ لَيتَ مُدَّتَهُ","في غَيرِ أُمَّتِهِ مِن سالِفِ الأُمَمِ",22,"م",1,0],["وقتلنا قيد الشموس بهاب","من رماد فما استطاع نفورا",23,"ر",2,0],["وَقَتلُ المُحِبّينَ العُيونُ وَلَم أَكُن","أَظُنُّ الرُسومَ الدارِساتِ قَواتِلا",24,"ل",2,0],["وَقَت نَفسَ الجَوادِ مِنَ المَنايا","وَمَحظوراتِها نَفسُ البَخيلِ",25,"ل",1,0],["وَقَتْكَ من عَثرَةِ الرَّدى عُصَبٌ","إن عَثروا قلتَ بالسَّماحِ لَعا",26,"ع",2,0],["وَقَتَّلنا سُراةَ الناسِ طُرّاً","وَغُنِّمنا الوَلائِدَ وَالعَبيدا",27,"د",2,0],["وَقَتْلَى عَلَى شَطِّ العِرَاقِ كَأَنَّهُمْ","نُقُوشُ بِسَاطٍ دَقَّقَ الرَّسْمَ غَازِلُهْ..",28,"ل",2,0],["وَقَتَلَ اِبنَ جَعفَرٍ مَنصورا","وَكانَ قَبلَ قَتلِهِ كَبيرا",29,"ر",2,0],["وَقَتَلا اللُصوصَ وَالأَكرادا","وَعَمَرا مِن بَعدِها البِلادا",29,"د",2,0],["وَقَتَلوا الحُسَينَ بَعدَ ذاكا","فَأَهلَكوا أَنفُسَهُم إِهلاكا",29,"ك",2,0],["وَقتٌ يَمُرُّ وَأَقدارٌ مُسَبَّبةٌ","مِنها الصَغيرُ وَمِنها الفادِحُ الَجَلَلُ",30,"ل",1,1],["وَقِتالٍ لا يُغِبُّكُمُ","في جَميعٍ جَحفَلٍ لَهِمُه",31,"م",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّه","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",32,"ب",1,0],["وَقَتلى كَمِثلِ جُذوعِ النَخيلِ","تَغَشّاهُمُ مُسبِلٌ مُنهَمِر",33,"ر",1,0],["وقت المحبة منى","قَد فاتَ أو سَيَفوتُ",34,"ت",1,1],["وقتيلٌ بين عينيْ زوجه","كلُّ معشوقٍ دَعتهُ فعصاها",35,"ا",3,0],["وقتلُكَ الإنسانَ غِيلةً شَنِعْ","الجبنُ أن تَقْتُلَ مَن لا يمتنعْ",36,"ع",1,0],["وَقَتَلْتَهُ خُبْراً لإِحْيَاءٍ بِهِ","وَسَبَرْتَ أَبْعَدَ غَوْرِهِ تَحْقِيقَا",37,"ق",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّها","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",38,"ب",1,0],["وقَتْلاهُمُ في جِنانِ النَّعيمِ","كِرامُ المداخلِ والمَخْرَجِ",39,"ج",1,0],["وَقّتَ اللَه الحمامَ فَإِن","صابَ شَهماً سَهمُهُ قَتَلا",40,"ل",2,0],["وقتلناه بالوقارِ ضلالاً","وهو ما جار مرّةً أو تعدَّى",41,"د",2,0],["وقتيلا يغفو ويسهر ثارا","وشهيدا يندى سلاما وحبّا",42,"ب",2,0],["وقتلى دعوها ضحايا الظروف","وكانوا الضحايا وكانوا الظروف",43,"ف",1,0],["وقَتَلْنَ دَفْراً والدُّهَيْمَ فَما تَرَى","أُمُّ الدُّهَيْمِ وأُمُّ دَفْرٍ ثَاكِلُ",44,"ل",1,0],["وقتَلتَ أصناف الرجال درايةً","من مستقيمٍ في خطاهُ وكابي",45,"ب",2,0],["وَقَتْ نَفْسَ الجَوَادِ، مِنَ المَنَايا","وَمَحْذُورَاتِهَا، نَفْسُ البَخِيلِ",46,"ل",1,0],["وقتيل التلاقي أحسنُ حالاً","عند داود من قتيل الفراقِ",47,"ق",1,0],["وَکقْتَصَرْتُ الحَدِيثَ دُونَ الَّذي قَدْ","كانَ من قبلُ يعلمُ الأسرارا",48,"ر",2,0],["وقت صفا بأحبة جبهاتهم","زهر النجوم وهم اسود الغاب",49,"ب",1,0],["وقت مضى لكن بكراه لل","قلب الشفا من داء آماله",50,"ل",2,0],["وَقَتكَ مِنَ الرَدى أَرواحُ قَومٍ","مَتى بَخِلوا بِها بَخِلوا عُقوقا",51,"ق",2,0],["وَقَتَلتَ مَن لَو غَيرُكَ المُجتاحُهُ","لَأَبَت نِزارٌ أَن يُطَلَّ لَهُ دَمُ",52,"م",1,0],["وقت تضرب أمثالا تنكفه","كما ينكف رب الجهل مغريه",53,"ي",2,0],["وَقَتَّلنَا سَرَاةَ بَنِى جِحَاشِ","وَأَثكَلنَا نِسَاءَهُمُ البَنِينَا",54,"ن",2,0],["وَقَتَّلنا مُلُوكَ الرُّومِ حَتَّى","سَكَنّا حَيثُ كانُوا يَسكُنُونَا",54,"ن",2,0],["وَقَتْك نفسي وافدَ المَنِيَّة","هَلُمَّ عندي تحفةٌ سَنِية",55,"ن",3,0],["وقتيلا لكمُ ولا يشتكيكم","هل رأيتم قبلي قتيلا شكورا",56,"ر",2,0],["وَقتاً وعادَ على الدوامِ محرّما","اللَّهُ قَد صلّى عليهِ وسلّما",57,"م",2,0],["وقتلنا مع الزمان ليالي الصي","ف بالشدو أو لذيذ الكلام",58,"م",1,0],["وقتيلٌ من كانَ في الغابِ حيّاً","تتولاهُ أعينُ الآسادِ",59,"د",1,0],["وَقَتلى مِنَ الأَوسِ في مَعرَكٍ","أُصيبوا جَميعاً بِذي الأَضوَجِ",60,"ج",1,0],["وقتلي ظلما قد اباحت لحاظه","وها من دمي في خده شاهد الظلم",61,"م",1,0],["وقتَّلهمْ بغيا عُبَيدٌ وكادهم","يزيدُ بأنواع الشقاء فبادوا",62,"د",3,0],["وَقَتكَ الرِفاقُ البيضُ لَفحَ أُوارِهِ","وَيارُبَّ ظِلٍّ لِلسُيوفِ ظَليلِ",63,"ل",1,0],["وَقَت لكَ دوحةٌ إلفاً وعشّاً","وهذي دعوةُ النائي الفقيد",64,"د",1,0],["وَقَتْنِيَ مِنْ شَكْوَى الزَّمَانِ وَذَمِّهِ","فَمَا لي غَيْر العَجْزِ عَنْ شُكْرِهَا شَكْوَى",65,"و",2,0],["وَقَتْهُ الأَواقي علَى أنّهُ","تَسَنّمَهَا صّعْبَة المَرْكَب",66,"ب",1,0],["وَقَتيلُ مُرَّةَ أَثأَرَنَّ فَإِنَّهُ","فَرغٌ وَإِنَّ أَخاكُمُ لَم يَثأَرُ",67,"ر",1,1],["وقتل الليالي ببذل مياه ال","محيا الوسيم ودمع سخين",68,"ن",1,0],["وقتلى يوردون الحتف ظلماً","وخصم ما رمى الا اصابا",69,"ب",2,0],["وَقَتلُ داؤُدَ لِجالوتَ وَطا","لوتَ وَما النَهرُ الَّذي عَنهُ نَهَر",70,"ر",1,0],["وَقَتَّلنا سَراتَهُمُ جِهاراً","وَجِئنا بِالسَبايا وَالنِهابِ",71,"ب",1,0],["وقتلُ إلفٍ وأكلُ كفٍّ","وَضيقُ خُفٍّ ونَزعُ نَفسِ",72,"س",1,0],["وَقَتلُ عَمٍّ وَشُربُ سَمٍّ","وَطولُ غَمٍّ وَضَنكُ حَبسِ",72,"س",1,0],["وقتلُ خالٍ وعُدمُ مالٍ","وسُوءُ خالٍ وطُول عكسِ",72,"س",1,0],["وقَتيلِ الجُفونِ سُقماً تَفانَت","في هَواهُ النُّفوسُ أَسراً وقَتلا",73,"ل",2,1],["وَقَتَلت صبا عائِذاً بِكَ لَم يَجد","مِن جور سُلطان المَحبة مفزعا",74,"ع",2,0],["وقتله واجب","كسائرالمهدرات",75,"ت",1,0],["وَقَتلُهُم الساداتِ من آلِ هاشِمٍ","وَسَبيهِمُ عن جُرأةٍ لِنِسائِهِم",76,"م",1,0],["وقتيل في محبّتكم","ماله بين الورى قودُ",77,"د",1,0],["وَقَتِ ابنَ نعمانَ النزاهةُ أو نجا","سَلماً فكان من الخطوب بمعزِلِ",78,"ل",1,0],["وقتيلُ العيونِ هيهاتِ أنْ","يحييهِ غيرُ اللواحظِ القتّالة",79,"ل",2,0],["وقتك عمر خيم تمارك","هو نور غراسك يا باب",80,"ب",1,0],["وَقَتَلتُ كَعباً قَبلَها","وَعَلَوتُ بِالسَيفِ الذُؤابَه",81,"ب",2,0],["وَقَتَلنا عَلى الثَنِيَّةِ عَمراً","وَجَلَبنا عَدِيَّهُم مَغلولا",82,"ل",2,0],["وقتك من الأسواء أنفس معشر","لهم حسب في الباخلين طويل",83,"ل",1,0],["وَقْتُ الأَصِيل مَعَ التّأَخُّ","رِ يَفْضُلُ الأَوْقاتَ طُرّا",84,"ر",2,0],["وَقَتَّلوا كُلَّ جَبّارٍ وَدانَ لَهُم","مَن قَد أَسَرَّ مُعاداةً وَعِصيانا",85,"ن",2,0],["وقتٌ به السّعدُ مقرونٌ ومُلتبسٌ","وطالعٌ وَسْطَه التوفيقُ مُرتِفقُ",86,"ق",1,0],["وَقُتودِ ناجِيَةٍ وَضَعتُ بِقَفرَةٍ","وَالطَيرُ غاشِيَةُ العَوافي وَقَّعُ",87,"ع",1,0],["وقتلك معنى الروح بالروح يقتضي","قصاصاً بسيف الحق إذ هو شارع",88,"ع",1,0],["وقتلهم فاطمة الزهراء","أضرم حر النار في أحشائي",89,"ي",1,0],["وقتلوا وانقطعت مدتهم","وانصرموا وفنيت عدتهم",89,"م",1,0],["وقتلوا جماعة من شعيته","ومن بني آبائه وعرته",89,"ه",1,0],["وقتل البعض وهد الأمرى","إذ خاف مما نحلوه الشرا",89,"ر",2,0],["وقتلتَ همِّي من سُطو","ركَ هلْ سطورُك مِن نِضَالِكْ",90,"ك",1,0],["وقتْه جُنَّةُ تقْوى في مَعارِكه","وجنَّةُ الصَّبر فيها لِلتَّقِيِّ تَقي",91,"ق",2,0]]}