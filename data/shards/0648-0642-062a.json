{"poems":[[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[3,"حكم سيوفك في رقاب العذل","https://www.aldiwan.net/poem192.html","الكامل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[88,"حياة الورى جسر مديد وإنما","https://www.aldiwan.net/poem45058.html","الطويل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"وقت شاربيها النار عمدا بنفسها","https://www.aldiwan.net/poem64703.html","الطويل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[29,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[43,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[62,"قد زرعنا النضار في الفضة","https://www.aldiwan.net/poem52156.html","الخفيف"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[58,"أتاني أن هندا أخت صخر","https://www.aldiwan.net/poem31088.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[46,"وقت يمر وأقدار مسببة","https://www.aldiwan.net/poem23130.html","البسيط"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[19,"صبوت وهل تصبو ورأسك أشيب","https://www.aldiwan.net/poem323.html",""],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85722","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2232","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[45,"أكنتَ مُعَنّفي، يوْمَ الرّحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32199",""],[51,"يا بن داود يا فقيه العراق","https://www.poetsgate.com/ViewPoem.aspx?id=29981",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""]],"verses":[["وَقَتْكِ الرّدى بيضٌ حِسانٌ وُجوهُها","ومُثْرِيَةٌ منْ نَضْرَةٍ وجَمالِ",0,"ل",1,0],["وَقَتَلتُ فارِسَهُم رَبيعَةَ عَنوَةً","وَالهَيذُبانَ وَجابِرَ بنَ مُهَلهَلِ",1,"ل",1,0],["وَقَتْكَ أَوَاقِي اللَّهِ مِنْ كُلِّ غَائِلٍ","فَأَيُّ سِلاَحٍ مَا الْمِجَنُّ وَمَا اللَّمْطُ",2,"ط",1,0],["وقَتْ مُلْكَكَ المَحْروسَ منْ كُلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عن الآلِ والجُنْدِ",3,"د",1,0],["وقَتْ بَيْتَكَ المعْمورَ منْ كلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عنِ الآلِ والجُنْدِ",4,"د",1,0],["وقتل الردى قتل جبار فلم تكن","لتدُرك فيه ثأرها نفس ثائر",5,"ر",1,0],["وَقَتِيلٌ بالطَّفِ غُودِرَ منهُ","بَينَ غَوغاءِ أُمّةٍ وَطَغَامِ",6,"م",1,0],["وَقَتَلنا مِنكُمُ أَهلَ اللِوَا","إِذ لَقيناكُم كَأَنّا أُسدُ طَلّ",7,"ل",1,0],["وَقَتلاكُمُ في النارِ أَفضَلُ رِزقِهِم","حَميمٌ مَعاً في جَوفِها وَضَريعُ",8,"ع",1,0],["وقتيلٍ بغير جُرمٍ جناه","وجريحٍ مُسَلَّمِ الأعضاءِ",9,"ا",2,0],["وَقَتْكَ يدُ الإله أبا عليٍّ","ولا جَنحتْ بساحتك الخطوبُ",10,"ب",1,1],["وَقتَّلَ أجْذَالَ العِبَادَةِ عَنْوَةً","وهُمْ رُكَّعٌ بَيْنَ السَّوَارِي وسُجَّدُ",11,"د",1,0],["وقَتْ شاربيها النارَ عمداً بنفسها","وما كان جسمُ النار جسماً تُلامسه",12,"س",2,0],["وقت شاربيها النارَ عمداً بنفسها","وما كان جسمُ الفار جسماً يلامسُهْ",13,"ه",1,1],["وقتالُ من لا تستطيع قِتالهُ","في الناس يكسبُ رأيكَ التفييلا",14,"ل",2,0],["وقتكَ أبا سهلٍ يدُ الله إنني","أراك يداً دفّاعةً للعظائمِ",15,"م",1,0],["وَقَتلى بَني رِعلٍ كَأَنَّ بُطونَها","عَلى جَلهَةِ الوادي بُطونُ حَميرِ",16,"ر",1,0],["وَقَتَلتُ في نَفسي الرَغائِب وَالمُنى","فَقَهَرتُهُ بِتَجَرُّدي وَتَزَهُدي",17,"د",2,0],["وَقَتكَ العِنايَةُ بِالراحَتَينِ","وَطَوَّقَ جيدَكَ إِحسانُها",18,"ن",3,0],["وَقَتَلتَ الزَمانَ عِلماً فَما يُغ","رِبُ قَولاً وَلا يُجَدِّدُ فِعلا",19,"ل",2,0],["وَقَتَلنَ دَفراً وَالدُهَيمَ فَما تُرى","أُمُّ الدُهَيمِ وَأُمُّ دَفرٍ هابِلُ",20,"ل",1,0],["وَقَتَّلَ الكُردَ عَنِ القِتالِ","حَتّى اِتَّقَت بِالفَرِّ وَالإِجفالِ",21,"ل",1,0],["وَقتٌ يَضيعُ وَعُمرٌ لَيتَ مُدَّتَهُ","في غَيرِ أُمَّتِهِ مِن سالِفِ الأُمَمِ",22,"م",1,0],["وقتلنا قيد الشموس بهاب","من رماد فما استطاع نفورا",23,"ر",2,0],["وَقَتلُ المُحِبّينَ العُيونُ وَلَم أَكُن","أَظُنُّ الرُسومَ الدارِساتِ قَواتِلا",24,"ل",2,0],["وَقَت نَفسَ الجَوادِ مِنَ المَنايا","وَمَحظوراتِها نَفسُ البَخيلِ",25,"ل",1,0],["وَقَتْكَ من عَثرَةِ الرَّدى عُصَبٌ","إن عَثروا قلتَ بالسَّماحِ لَعا",26,"ع",2,0],["وَقَتَّلنا سُراةَ الناسِ طُرّاً","وَغُنِّمنا الوَلائِدَ وَالعَبيدا",27,"د",2,0],["وَقَتَلَ اِبنَ جَعفَرٍ مَنصورا","وَكانَ قَبلَ قَتلِهِ كَبيرا",28,"ر",2,0],["وَقَتَلا اللُصوصَ وَالأَكرادا","وَعَمَرا مِن بَعدِها البِلادا",28,"د",2,0],["وَقَتَلوا الحُسَينَ بَعدَ ذاكا","فَأَهلَكوا أَنفُسَهُم إِهلاكا",28,"ك",2,0],["وَقتٌ يَمُرُّ وَأَقدارٌ مُسَبَّبةٌ","مِنها الصَغيرُ وَمِنها الفادِحُ الَجَلَلُ",29,"ل",1,1],["وَقِتالٍ لا يُغِبُّكُمُ","في جَميعٍ جَحفَلٍ لَهِمُه",30,"م",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّه","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",31,"ب",1,0],["وَقَتلى كَمِثلِ جُذوعِ النَخيلِ","تَغَشّاهُمُ مُسبِلٌ مُنهَمِر",32,"ر",1,0],["وقت المحبة منى","قَد فاتَ أو سَيَفوتُ",33,"ت",1,1],["وقتيلٌ بين عينيْ زوجه","كلُّ معشوقٍ دَعتهُ فعصاها",34,"ا",3,0],["وقتلُكَ الإنسانَ غِيلةً شَنِعْ","الجبنُ أن تَقْتُلَ مَن لا يمتنعْ",35,"ع",1,0],["وَقَتَلْتَهُ خُبْراً لإِحْيَاءٍ بِهِ","وَسَبَرْتَ أَبْعَدَ غَوْرِهِ تَحْقِيقَا",36,"ق",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّها","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",37,"ب",1,0],["وقَتْلاهُمُ في جِنانِ النَّعيمِ","كِرامُ المداخلِ والمَخْرَجِ",38,"ج",1,0],["وَقّتَ اللَه الحمامَ فَإِن","صابَ شَهماً سَهمُهُ قَتَلا",39,"ل",2,0],["وقتلناه بالوقارِ ضلالاً","وهو ما جار مرّةً أو تعدَّى",40,"د",2,0],["وقَتَلْنَ دَفْراً والدُّهَيْمَ فَما تَرَى","أُمُّ الدُّهَيْمِ وأُمُّ دَفْرٍ ثَاكِلُ",41,"ل",1,0],["وقتَلتَ أصناف الرجال درايةً","من مستقيمٍ في خطاهُ وكابي",42,"ب",2,0],["وَقَتْ نَفْسَ الجَوَادِ، مِنَ المَنَايا","وَمَحْذُورَاتِهَا، نَفْسُ البَخِيلِ",43,"ل",1,0],["وقتيل التلاقي أحسنُ حالاً","عند داود من قتيل الفراقِ",44,"ق",1,0],["وَکقْتَصَرْتُ الحَدِيثَ دُونَ الَّذي قَدْ","كانَ من قبلُ يعلمُ الأسرارا",45,"ر",2,0]]}