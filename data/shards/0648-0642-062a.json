ww.poetsgate.com/ViewPoem.aspx?id=51941",""],[5851,"على مرايا الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=175279",""],[5887,"دعونا اليوم نعلنها صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=28327",""],[5917,"الحمد لله هذا العين لا الأثر","https://www.poetsgate.com/ViewPoem.aspx?id=106533",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"ومضة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=193456",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[5956,"وقت الشدائد نَطلب الرحماءَ","https://www.poetsgate.com/ViewPoem.aspx?id=194601",""],[5956,"عندي وعند كل شاب طباع الهر","https://www.poetsgate.com/ViewPoem.aspx?id=209041",""],[5961,"قرت عيون الساري","https://www.poetsgate.com/ViewPoem.aspx?id=199773",""],[5961,"والله اليوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=199808",""],[5974,"حكاية فلّ","https://www.poetsgate.com/ViewPoem.aspx?id=216007",""],[6084,"لا تلمني على البكا والعويل","https://www.poetsgate.com/ViewPoem.aspx?id=170854",""],[6115,"ياوجودي وجد من شاف ديّانه","https://www.poetsgate.com/ViewPoem.aspx?id=180482",""],[6115,"لاتلومون الذي قال فيه الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=180485",""],[231,"ابتسامة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79151&r=&rc=25",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["وَقَتْكِ الرّدى بيضٌ حِسانٌ وُجوهُها","ومُثْرِيَةٌ منْ نَضْرَةٍ وجَمالِ",0,"ل",1,0],["وَقَتَلتُ فارِسَهُم رَبيعَةَ عَنوَةً","وَالهَيذُبانَ وَجابِرَ بنَ مُهَلهَلِ",1,"ل",1,0],["وَقَتْكَ أَوَاقِي اللَّهِ مِنْ كُلِّ غَائِلٍ","فَأَيُّ سِلاَحٍ مَا الْمِجَنُّ وَمَا اللَّمْطُ",2,"ط",1,0],["وقَتْ مُلْكَكَ المَحْروسَ منْ كُلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عن الآلِ والجُنْدِ",3,"د",1,0],["وقَتْ بَيْتَكَ المعْمورَ منْ كلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عنِ الآلِ والجُنْدِ",4,"د",1,0],["وقتل الردى قتل جبار فلم تكن","لتدُرك فيه ثأرها نفس ثائر",5,"ر",1,0],["وَقَتِيلٌ بالطَّفِ غُودِرَ منهُ","بَينَ غَوغاءِ أُمّةٍ وَطَغَامِ",6,"م",1,0],["وَقَتَلنا مِنكُمُ أَهلَ اللِوَا","إِذ لَقيناكُم كَأَنّا أُسدُ طَلّ",7,"ل",1,0],["وَقَتلاكُمُ في النارِ أَفضَلُ رِزقِهِم","حَميمٌ مَعاً في جَوفِها وَضَريعُ",8,"ع",1,0],["وقتيلٍ بغير جُرمٍ جناه","وجريحٍ مُسَلَّمِ الأعضاءِ",9,"ا",2,0],["وَقَتْكَ يدُ الإله أبا عليٍّ","ولا جَنحتْ بساحتك الخطوبُ",10,"ب",1,1],["وَقتَّلَ أجْذَالَ العِبَادَةِ عَنْوَةً","وهُمْ رُكَّعٌ بَيْنَ السَّوَارِي وسُجَّدُ",11,"د",1,0],["وقَتْ شاربيها النارَ عمداً بنفسها","وما كان جسمُ النار جسماً تُلامسه",12,"س",2,0],["وقت شاربيها النارَ عمداً بنفسها","وما كان جسمُ الفار جسماً يلامسُهْ",13,"ه",1,1],["وقتالُ من لا تستطيع قِتالهُ","في الناس يكسبُ رأيكَ التفييلا",14,"ل",2,0],["وقتكَ أبا سهلٍ يدُ الله إنني","أراك يداً دفّاعةً للعظائمِ",15,"م",1,0],["وَقَتلى بَني رِعلٍ كَأَنَّ بُطونَها","عَلى جَلهَةِ الوادي بُطونُ حَميرِ",16,"ر",1,0],["وَقَتَلتُ في نَفسي الرَغائِب وَالمُنى","فَقَهَرتُهُ بِتَجَرُّدي وَتَزَهُدي",17,"د",2,0],["وَقَتكَ العِنايَةُ بِالراحَتَينِ","وَطَوَّقَ جيدَكَ إِحسانُها",18,"ن",3,0],["وَقَتَلتَ الزَمانَ عِلماً فَما يُغ","رِبُ قَولاً وَلا يُجَدِّدُ فِعلا",19,"ل",2,0],["وَقَتَلنَ دَفراً وَالدُهَيمَ فَما تُرى","أُمُّ الدُهَيمِ وَأُمُّ دَفرٍ هابِلُ",20,"ل",1,0],["وَقَتَّلَ الكُردَ عَنِ القِتالِ","حَتّى اِتَّقَت بِالفَرِّ وَالإِجفالِ",21,"ل",1,0],["وَقتٌ يَضيعُ وَعُمرٌ لَيتَ مُدَّتَهُ","في غَيرِ أُمَّتِهِ مِن سالِفِ الأُمَمِ",22,"م",1,0],["وقتلنا قيد الشموس بهاب","من رماد فما استطاع نفورا",23,"ر",2,0],["وَقَتلُ المُحِبّينَ العُيونُ وَلَم أَكُن","أَظُنُّ الرُسومَ الدارِساتِ قَواتِلا",24,"ل",2,0],["وَقَت نَفسَ الجَوادِ مِنَ المَنايا","وَمَحظوراتِها نَفسُ البَخيلِ",25,"ل",1,0],["وَقَتْكَ من عَثرَةِ الرَّدى عُصَبٌ","إن عَثروا قلتَ بالسَّماحِ لَعا",26,"ع",2,0],["وَقَتَّلنا سُراةَ الناسِ طُرّاً","وَغُنِّمنا الوَلائِدَ وَالعَبيدا",27,"د",2,0],["وَقَتْلَى عَلَى شَطِّ العِرَاقِ كَأَنَّهُمْ","نُقُوشُ بِسَاطٍ دَقَّقَ الرَّسْمَ غَازِلُهْ..",28,"ل",2,0],["وَقَتَلَ اِبنَ جَعفَرٍ مَنصورا","وَكانَ قَبلَ قَتلِهِ كَبيرا",29,"ر",2,0],["وَقَتَلا اللُصوصَ وَالأَكرادا","وَعَمَرا مِن بَعدِها البِلادا",29,"د",2,0],["وَقَتَلوا الحُسَينَ بَعدَ ذاكا","فَأَهلَكوا أَنفُسَهُم إِهلاكا",29,"ك",2,0],["وَقتٌ يَمُرُّ وَأَقدارٌ مُسَبَّبةٌ","مِنها الصَغيرُ وَمِنها الفادِحُ الَجَلَلُ",30,"ل",1,1],["وَقِتالٍ لا يُغِبُّكُمُ","في جَميعٍ جَحفَلٍ لَهِمُه",31,"م",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّه","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",32,"ب",1,0],["وَقَتلى كَمِثلِ جُذوعِ النَخيلِ","تَغَشّاهُمُ مُسبِلٌ مُنهَمِر",33,"ر",1,0],["وقت المحبة منى","قَد فاتَ أو سَيَفوتُ",34,"ت",1,1],["وقتيلٌ بين عينيْ زوجه","كلُّ معشوقٍ دَعتهُ فعصاها",35,"ا",3,0],["وقتلُكَ الإنسانَ غِيلةً شَنِعْ","الجبنُ أن تَقْتُلَ مَن لا يمتنعْ",36,"ع",1,0],["وَقَتَلْتَهُ خُبْراً لإِحْيَاءٍ بِهِ","وَسَبَرْتَ أَبْعَدَ غَوْرِهِ تَحْقِيقَا",37,"ق",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّها","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",38,"ب",1,0],["وقَتْلاهُمُ في جِنانِ النَّعيمِ","كِرامُ المداخلِ والمَخْرَجِ",39,"ج",1,0],["وَقّتَ اللَه الحمامَ فَإِن","صابَ شَهماً سَهمُهُ قَتَلا",40,"ل",2,0],["وقتلناه بالوقارِ ضلالاً","وهو ما جار مرّةً أو تعدَّى",41,"د",2,0],["وقتيلا يغفو ويسهر ثارا","وشهيدا يندى سلاما وحبّا",42,"ب",2,0],["وقتلى دعوها ضحايا الظروف","وكانوا الضحايا وكانوا الظروف",43,"ف",1,0],["وقَتَلْنَ دَفْراً والدُّهَيْمَ فَما تَرَى","أُمُّ الدُّهَيْمِ وأُمُّ دَفْرٍ ثَاكِلُ",44,"ل",1,0],["وقتَلتَ أصناف الرجال درايةً","من مستقيمٍ في خطاهُ وكابي",45,"ب",2,0],["وَقَتْ نَفْسَ الجَوَادِ، مِنَ المَنَايا","وَمَحْذُورَاتِهَا، نَفْسُ البَخِيلِ",46,"ل",1,0],["وقتيل التلاقي أحسنُ حالاً","عند داود من قتيل الفراقِ",47,"ق",1,0],["وَکقْتَصَرْتُ الحَدِيثَ دُونَ الَّذي قَدْ","كانَ من قبلُ يعلمُ الأسرارا",48,"ر",2,0],["وقت صفا بأحبة جبهاتهم","زهر النجوم وهم اسود الغاب",49,"ب",1,0],["وقت مضى لكن بكراه لل","قلب الشفا من داء آماله",50,"ل",2,0],["وَقَتكَ مِنَ الرَدى أَرواحُ قَومٍ","مَتى بَخِلوا بِها بَخِلوا عُقوقا",51,"ق",2,0],["وَقَتَلتَ مَن لَو غَيرُكَ المُجتاحُهُ","لَأَبَت نِزارٌ أَن يُطَلَّ لَهُ دَمُ",52,"م",1,0],["وقت تضرب أمثالا تنكفه","كما ينكف رب الجهل مغريه",53,"ي",2,0],["وَقَتَّلنَا سَرَاةَ بَنِى جِحَاشِ","وَأَثكَلنَا نِسَاءَهُمُ البَنِينَا",54,"ن",2,0],["وَقَتَّلنا مُلُوكَ الرُّومِ حَتَّى","سَكَنّا حَيثُ كانُوا يَسكُنُونَا",54,"ن",2,0],["وَقَتْك نفسي وافدَ المَنِيَّة","هَلُمَّ عندي تحفةٌ سَنِية",55,"ن",3,0],["وقتيلا لكمُ ولا يشتكيكم","هل رأيتم قبلي قتيلا شكورا",56,"ر",2,0],["وَقتاً وعادَ على الدوامِ محرّما","اللَّهُ قَد صلّى عليهِ وسلّما",57,"م",2,0],["وقتلنا مع الزمان ليالي الصي","ف بالشدو أو لذيذ الكلام",58,"م",1,0],["وقتيلٌ من كانَ في الغابِ حيّاً","تتولاهُ أعينُ الآسادِ",59,"د",1,0],["وَقَتلى مِنَ الأَوسِ في مَعرَكٍ","أُصيبوا جَميعاً بِذي الأَضوَجِ",60,"ج",1,0],["وقتلي ظلما قد اباحت لحاظه","وها من دمي في خده شاهد الظلم",61,"م",1,0],["وقتَّلهمْ بغيا عُبَيدٌ وكادهم","يزيدُ بأنواع الشقاء فبادوا",62,"د",3,0],["وَقَتكَ الرِفاقُ البيضُ لَفحَ أُوارِهِ","وَيارُبَّ ظِلٍّ لِلسُيوفِ ظَليلِ",63,"ل",1,0],["وَقَت لكَ دوحةٌ إلفاً وعشّاً","وهذي دعوةُ النائي الفقيد",64,"د",1,0],["وَقَتْنِيَ مِنْ شَكْوَى الزَّمَانِ وَذَمِّهِ","فَمَا لي غَيْر العَجْزِ عَنْ شُكْرِهَا شَكْوَى",65,"و",2,0],["وَقَتْهُ الأَواقي علَى أنّهُ","تَسَنّمَهَا صّعْبَة المَرْكَب",66,"ب",1,0],["وَقَتيلُ مُرَّةَ أَثأَرَنَّ فَإِنَّهُ","فَرغٌ وَإِنَّ أَخاكُمُ لَم يَثأَرُ",67,"ر",1,1],["وقتل الليالي ببذل مياه ال","محيا الوسيم ودمع سخين",68,"ن",1,0],["وقتلى يوردون الحتف ظلماً","وخصم ما رمى الا اصابا",69,"ب",2,0],["وَقَتلُ داؤُدَ لِجالوتَ وَطا","لوتَ وَما النَهرُ الَّذي عَنهُ نَهَر",70,"ر",1,0],["وَقَتَّلنا سَراتَهُمُ جِهاراً","وَجِئنا بِالسَبايا وَالنِهابِ",71,"ب",1,0],["وقتلُ إلفٍ وأكلُ كفٍّ","وَضيقُ خُفٍّ ونَزعُ نَفسِ",72,"س",1,0],["وَقَتلُ عَمٍّ وَشُربُ سَمٍّ","وَطولُ غَمٍّ وَضَنكُ حَبسِ",72,"س",1,0],["وقتلُ خالٍ وعُدمُ مالٍ","وسُوءُ خالٍ وطُول عكسِ",72,"س",1,0],["وقَتيلِ الجُفونِ سُقماً تَفانَت","في هَواهُ النُّفوسُ أَسراً وقَتلا",73,"ل",2,1],["وَقَتَلت صبا عائِذاً بِكَ لَم يَجد","مِن جور سُلطان المَحبة مفزعا",74,"ع",2,0],["وقتله واجب","كسائرالمهدرات",75,"ت",1,0],["وَقَتلُهُم الساداتِ من آلِ هاشِمٍ","وَسَبيهِمُ عن جُرأةٍ لِنِسائِهِم",76,"م",1,0],["وقتيل في محبّتكم","ماله بين الورى قودُ",77,"د",1,0],["وَقَتِ ابنَ نعمانَ النزاهةُ أو نجا","سَلماً فكان من الخطوب بمعزِلِ",78,"ل",1,0],["وقتيلُ العيونِ هيهاتِ أنْ","يحييهِ غيرُ اللواحظِ القتّالة",79,"ل",2,0],["وقتك عمر خيم تمارك","هو نور غراسك يا باب",80,"ب",1,0],["وَقَتَلتُ كَعباً قَبلَها","وَعَلَوتُ بِالسَيفِ الذُؤابَه",81,"ب",2,0],["وَقَتَلنا عَلى الثَنِيَّةِ عَمراً","وَجَلَبنا عَدِيَّهُم مَغلولا",82,"ل",2,0],["وقتك من الأسواء أنفس معشر","لهم حسب في الباخلين طويل",83,"ل",1,0],["وَقْتُ الأَصِيل مَعَ التّأَخُّ","رِ يَفْضُلُ الأَوْقاتَ طُرّا",84,"ر",2,0],["وَقَتَّلوا كُلَّ جَبّارٍ وَدانَ لَهُم","مَن قَد أَسَرَّ مُعاداةً وَعِصيانا",85,"ن",2,0],["وقتٌ به السّعدُ مقرونٌ ومُلتبسٌ","وطالعٌ وَسْطَه التوفيقُ مُرتِفقُ",86,"ق",1,0],["وَقُتودِ ناجِيَةٍ وَضَعتُ بِقَفرَةٍ","وَالطَيرُ غاشِيَةُ العَوافي وَقَّعُ",87,"ع",1,0],["وقتلك معنى الروح بالروح يقتضي","قصاصاً بسيف الحق إذ هو شارع",88,"ع",1,0],["وقتلهم فاطمة الزهراء","أضرم حر النار في أحشائي",89,"ي",1,0],["وقتلوا وانقطعت مدتهم","وانصرموا وفنيت عدتهم",89,"م",1,0],["وقتلوا جماعة من شعيته","ومن بني آبائه وعرته",89,"ه",1,0],["وقتل البعض وهد الأمرى","إذ خاف مما نحلوه الشرا",89,"ر",2,0],["وقتلتَ همِّي من سُطو","ركَ هلْ سطورُك مِن نِضَالِكْ",90,"ك",1,0],["وقتْه جُنَّةُ تقْوى في مَعارِكه","وجنَّةُ الصَّبر فيها لِلتَّقِيِّ تَقي",91,"ق",2,0],["وَقَتيلُ الأَحزابِ حَمزَةُ مِنّا","أَسَدُ اللَهِ وَالسَناءُ سَناءُ",92,"ا",2,0],["وقَتلنا سيّد الخَزْ","رج سعدَ بن عُبادة",93,"ه",1,1],["وقتلته بنواظر أجفانها","بسيوفها الأمثال فيها تضرب",94,"ب",1,0],["وقتَلتِني عمداً بصا","رمِ جفنكِ الماضي القَضيبِ",95,"ب",1,0],["وَقَتْ ذاك البليخَ يدُ الليالي","وذاك النيلَ من متجاورين",96,"ن",1,0],["وَقتُ المَلامةِ في اِبتِداءِ مَحبَّتي","وَسَقيتني في حينِها كاساتِها",97,"ت",3,0],["وَقَتَلتُم خَشَبِيّينَ بِهِم","بَدَلاً مِن قَومِكُم شَرَّ بَدَل",98,"ل",1,0],["وَقْت إمام العَصْر من أذعنت","لأمره فيما مَضَى الخافقان",99,"ن",1,0],["وَقَتّل أَهلها وَسبى وَوَلّى","حَميداً في سُرور من اِستَطابا",100,"ب",2,0],["وقتُنا هذا عجيبٌ","مظلمٌ فاضحُ ناسِ",101,"س",1,1],["وَقَتْلُ نُفُوسٍ فِي الْهَوى مَنْ أ