{"poems":[[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[3,"حكم سيوفك في رقاب العذل","https://www.aldiwan.net/poem192.html","الكامل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[88,"حياة الورى جسر مديد وإنما","https://www.aldiwan.net/poem45058.html","الطويل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"وقت شاربيها النار عمدا بنفسها","https://www.aldiwan.net/poem64703.html","الطويل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[29,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[43,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[62,"قد زرعنا النضار في الفضة","https://www.aldiwan.net/poem52156.html","الخفيف"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[58,"أتاني أن هندا أخت صخر","https://www.aldiwan.net/poem31088.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[46,"وقت يمر وأقدار مسببة","https://www.aldiwan.net/poem23130.html","البسيط"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[19,"صبوت وهل تصبو ورأسك أشيب","https://www.aldiwan.net/poem323.html",""],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85722","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2232","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[45,"أكنتَ مُعَنّفي، يوْمَ الرّحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32199",""],[51,"يا بن داود يا فقيه العراق","https://www.poetsgate.com/ViewPoem.aspx?id=29981",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[113,"آه على وقت مع الاحباب","https://www.aldiwan.net/poem41219.html","عموديه"],[113,"قلب غدا كالبعض من خاله","https://www.aldiwan.net/poem41522.html","السريع"],[141,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[141,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[158,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[179,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[183,"يا من صفا لي ظاهرا ونيه","https://www.aldiwan.net/poem14691.html","الرجز"],[183,"هي دار العيش العزيز بما ضم","https://www.aldiwan.net/poem14788.html","الخفيف"],[187,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[195,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[197,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[201,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[208,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[227,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[233,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[268,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[273,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[273,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[285,"وقتيل مرة أثأرن فإنه","https://www.aldiwan.net/poem1896.html","الكامل"],[340,"حنانيك اخت البكا والانين","https://www.aldiwan.net/poem55327.html","المتقارب"],[340,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[361,"سمونا بالجياد إلى أعاد","https://www.aldiwan.net/poem1714.html","الوافر"],[369,"لقلع ضرس ومضغ كلس","https://www.aldiwan.net/poem56921.html","مخلع البسيط"],[369,"وقتيل الجفون سقما تفانت","https://www.aldiwan.net/poem57201.html","الكامل"],[377,"ملأ الغرام فؤاده فتصدعا","https://www.aldiwan.net/poem49244.html","الكامل"],[388,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[390,"برئت من الأرجاس رهط امية","https://www.aldiwan.net/poem53633.html","الطويل"],[434,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[462,"ذاك سلع فاندب معي أطلاله","https://www.aldiwan.net/poem3614.html","عموديه"],[480,"نور الحق هداني بفضل عطاني","https://www.aldiwan.net/poem24198.html","عموديه"],[484,"نُبئت أنك جئت تسري","https://www.aldiwan.net/poem456.html",""],[507,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[513,"أبا المجد إن تزمع رحيلاً فللندى","https://www.aldiwan.net/poem12210.html","الطويل"],[527,"قالوا أتيت مؤخرا","https://www.aldiwan.net/poem37423.html","مجزوء الكامل"],[538,"هيهات أوتي في سراتهم","https://www.aldiwan.net/poem56647.html","البسيط"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[552,"بكر العواذل بالسواد يلمنني","https://www.aldiwan.net/poem1850.html","الكامل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[573,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["وَقَتْكِ الرّدى بيضٌ حِسانٌ وُجوهُها","ومُثْرِيَةٌ منْ نَضْرَةٍ وجَمالِ",0,"ل",1,0],["وَقَتَلتُ فارِسَهُم رَبيعَةَ عَنوَةً","وَالهَيذُبانَ وَجابِرَ بنَ مُهَلهَلِ",1,"ل",1,0],["وَقَتْكَ أَوَاقِي اللَّهِ مِنْ كُلِّ غَائِلٍ","فَأَيُّ سِلاَحٍ مَا الْمِجَنُّ وَمَا اللَّمْطُ",2,"ط",1,0],["وقَتْ مُلْكَكَ المَحْروسَ منْ كُلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عن الآلِ والجُنْدِ",3,"د",1,0],["وقَتْ بَيْتَكَ المعْمورَ منْ كلِّ حادِثٍ","عِنايَةُ مَنْ يُغْني عنِ الآلِ والجُنْدِ",4,"د",1,0],["وقتل الردى قتل جبار فلم تكن","لتدُرك فيه ثأرها نفس ثائر",5,"ر",1,0],["وَقَتِيلٌ بالطَّفِ غُودِرَ منهُ","بَينَ غَوغاءِ أُمّةٍ وَطَغَامِ",6,"م",1,0],["وَقَتَلنا مِنكُمُ أَهلَ اللِوَا","إِذ لَقيناكُم كَأَنّا أُسدُ طَلّ",7,"ل",1,0],["وَقَتلاكُمُ في النارِ أَفضَلُ رِزقِهِم","حَميمٌ مَعاً في جَوفِها وَضَريعُ",8,"ع",1,0],["وقتيلٍ بغير جُرمٍ جناه","وجريحٍ مُسَلَّمِ الأعضاءِ",9,"ا",2,0],["وَقَتْكَ يدُ الإله أبا عليٍّ","ولا جَنحتْ بساحتك الخطوبُ",10,"ب",1,1],["وَقتَّلَ أجْذَالَ العِبَادَةِ عَنْوَةً","وهُمْ رُكَّعٌ بَيْنَ السَّوَارِي وسُجَّدُ",11,"د",1,0],["وقَتْ شاربيها النارَ عمداً بنفسها","وما كان جسمُ النار جسماً تُلامسه",12,"س",2,0],["وقت شاربيها النارَ عمداً بنفسها","وما كان جسمُ الفار جسماً يلامسُهْ",13,"ه",1,1],["وقتالُ من لا تستطيع قِتالهُ","في الناس يكسبُ رأيكَ التفييلا",14,"ل",2,0],["وقتكَ أبا سهلٍ يدُ الله إنني","أراك يداً دفّاعةً للعظائمِ",15,"م",1,0],["وَقَتلى بَني رِعلٍ كَأَنَّ بُطونَها","عَلى جَلهَةِ الوادي بُطونُ حَميرِ",16,"ر",1,0],["وَقَتَلتُ في نَفسي الرَغائِب وَالمُنى","فَقَهَرتُهُ بِتَجَرُّدي وَتَزَهُدي",17,"د",2,0],["وَقَتكَ العِنايَةُ بِالراحَتَينِ","وَطَوَّقَ جيدَكَ إِحسانُها",18,"ن",3,0],["وَقَتَلتَ الزَمانَ عِلماً فَما يُغ","رِبُ قَولاً وَلا يُجَدِّدُ فِعلا",19,"ل",2,0],["وَقَتَلنَ دَفراً وَالدُهَيمَ فَما تُرى","أُمُّ الدُهَيمِ وَأُمُّ دَفرٍ هابِلُ",20,"ل",1,0],["وَقَتَّلَ الكُردَ عَنِ القِتالِ","حَتّى اِتَّقَت بِالفَرِّ وَالإِجفالِ",21,"ل",1,0],["وَقتٌ يَضيعُ وَعُمرٌ لَيتَ مُدَّتَهُ","في غَيرِ أُمَّتِهِ مِن سالِفِ الأُمَمِ",22,"م",1,0],["وقتلنا قيد الشموس بهاب","من رماد فما استطاع نفورا",23,"ر",2,0],["وَقَتلُ المُحِبّينَ العُيونُ وَلَم أَكُن","أَظُنُّ الرُسومَ الدارِساتِ قَواتِلا",24,"ل",2,0],["وَقَت نَفسَ الجَوادِ مِنَ المَنايا","وَمَحظوراتِها نَفسُ البَخيلِ",25,"ل",1,0],["وَقَتْكَ من عَثرَةِ الرَّدى عُصَبٌ","إن عَثروا قلتَ بالسَّماحِ لَعا",26,"ع",2,0],["وَقَتَّلنا سُراةَ الناسِ طُرّاً","وَغُنِّمنا الوَلائِدَ وَالعَبيدا",27,"د",2,0],["وَقَتَلَ اِبنَ جَعفَرٍ مَنصورا","وَكانَ قَبلَ قَتلِهِ كَبيرا",28,"ر",2,0],["وَقَتَلا اللُصوصَ وَالأَكرادا","وَعَمَرا مِن بَعدِها البِلادا",28,"د",2,0],["وَقَتَلوا الحُسَينَ بَعدَ ذاكا","فَأَهلَكوا أَنفُسَهُم إِهلاكا",28,"ك",2,0],["وَقتٌ يَمُرُّ وَأَقدارٌ مُسَبَّبةٌ","مِنها الصَغيرُ وَمِنها الفادِحُ الَجَلَلُ",29,"ل",1,1],["وَقِتالٍ لا يُغِبُّكُمُ","في جَميعٍ جَحفَلٍ لَهِمُه",30,"م",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّه","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",31,"ب",1,0],["وَقَتلى كَمِثلِ جُذوعِ النَخيلِ","تَغَشّاهُمُ مُسبِلٌ مُنهَمِر",32,"ر",1,0],["وقت المحبة منى","قَد فاتَ أو سَيَفوتُ",33,"ت",1,1],["وقتيلٌ بين عينيْ زوجه","كلُّ معشوقٍ دَعتهُ فعصاها",34,"ا",3,0],["وقتلُكَ الإنسانَ غِيلةً شَنِعْ","الجبنُ أن تَقْتُلَ مَن لا يمتنعْ",35,"ع",1,0],["وَقَتَلْتَهُ خُبْراً لإِحْيَاءٍ بِهِ","وَسَبَرْتَ أَبْعَدَ غَوْرِهِ تَحْقِيقَا",36,"ق",2,0],["وَقَتلى بِجَنبِ القُرنَتَينِ كَأَنَّها","نُسورٌ سَقاها بِالدِماءِ مُقَشِّبُ",37,"ب",1,0],["وقَتْلاهُمُ في جِنانِ النَّعيمِ","كِرامُ المداخلِ والمَخْرَجِ",38,"ج",1,0],["وَقّتَ اللَه الحمامَ فَإِن","صابَ شَهماً سَهمُهُ قَتَلا",39,"ل",2,0],["وقتلناه بالوقارِ ضلالاً","وهو ما جار مرّةً أو تعدَّى",40,"د",2,0],["وقَتَلْنَ دَفْراً والدُّهَيْمَ فَما تَرَى","أُمُّ الدُّهَيْمِ وأُمُّ دَفْرٍ ثَاكِلُ",41,"ل",1,0],["وقتَلتَ أصناف الرجال درايةً","من مستقيمٍ في خطاهُ وكابي",42,"ب",2,0],["وَقَتْ نَفْسَ الجَوَادِ، مِنَ المَنَايا","وَمَحْذُورَاتِهَا، نَفْسُ البَخِيلِ",43,"ل",1,0],["وقتيل التلاقي أحسنُ حالاً","عند داود من قتيل الفراقِ",44,"ق",1,0],["وَکقْتَصَرْتُ الحَدِيثَ دُونَ الَّذي قَدْ","كانَ من قبلُ يعلمُ الأسرارا",45,"ر",2,0],["وقت صفا بأحبة جبهاتهم","زهر النجوم وهم اسود الغاب",46,"ب",1,0],["وقت مضى لكن بكراه لل","قلب الشفا من داء آماله",47,"ل",2,0],["وَقَتكَ مِنَ الرَدى أَرواحُ قَومٍ","مَتى بَخِلوا بِها بَخِلوا عُقوقا",48,"ق",2,0],["وَقَتَلتَ مَن لَو غَيرُكَ المُجتاحُهُ","لَأَبَت نِزارٌ أَن يُطَلَّ لَهُ دَمُ",49,"م",1,0],["وقت تضرب أمثالا تنكفه","كما ينكف رب الجهل مغريه",50,"ي",2,0],["وَقَتَّلنَا سَرَاةَ بَنِى جِحَاشِ","وَأَثكَلنَا نِسَاءَهُمُ البَنِينَا",51,"ن",2,0],["وَقَتَّلنا مُلُوكَ الرُّومِ حَتَّى","سَكَنّا حَيثُ كانُوا يَسكُنُونَا",51,"ن",2,0],["وَقَتْك نفسي وافدَ المَنِيَّة","هَلُمَّ عندي تحفةٌ سَنِية",52,"ن",3,0],["وقتيلا لكمُ ولا يشتكيكم","هل رأيتم قبلي قتيلا شكورا",53,"ر",2,0],["وَقتاً وعادَ على الدوامِ محرّما","اللَّهُ قَد صلّى عليهِ وسلّما",54,"م",2,0],["وقتلنا مع الزمان ليالي الصي","ف بالشدو أو لذيذ الكلام",55,"م",1,0],["وقتيلٌ من كانَ في الغابِ حيّاً","تتولاهُ أعينُ الآسادِ",56,"د",1,0],["وَقَتلى مِنَ الأَوسِ في مَعرَكٍ","أُصيبوا جَميعاً بِذي الأَضوَجِ",57,"ج",1,0],["وقتلي ظلما قد اباحت لحاظه","وها من دمي في خده شاهد الظلم",58,"م",1,0],["وقتَّلهمْ بغيا عُبَيدٌ وكادهم","يزيدُ بأنواع الشقاء فبادوا",59,"د",3,0],["وَقَتكَ الرِفاقُ البيضُ لَفحَ أُوارِهِ","وَيارُبَّ ظِلٍّ لِلسُيوفِ ظَليلِ",60,"ل",1,0],["وَقَت لكَ دوحةٌ إلفاً وعشّاً","وهذي دعوةُ النائي الفقيد",61,"د",1,0],["وَقَتْنِيَ مِنْ شَكْوَى الزَّمَانِ وَذَمِّهِ","فَمَا لي غَيْر العَجْزِ عَنْ شُكْرِهَا شَكْوَى",62,"و",2,0],["وَقَتْهُ الأَواقي علَى أنّهُ","تَسَنّمَهَا صّعْبَة المَرْكَب",63,"ب",1,0],["وَقَتيلُ مُرَّةَ أَثأَرَنَّ فَإِنَّهُ","فَرغٌ وَإِنَّ أَخاكُمُ لَم يَثأَرُ",64,"ر",1,1],["وقتل الليالي ببذل مياه ال","محيا الوسيم ودمع سخين",65,"ن",1,0],["وقتلى يوردون الحتف ظلماً","وخصم ما رمى الا اصابا",66,"ب",2,0],["وَقَتلُ داؤُدَ لِجالوتَ وَطا","لوتَ وَما النَهرُ الَّذي عَنهُ نَهَر",67,"ر",1,0],["وَقَتَّلنا سَراتَهُمُ جِهاراً","وَجِئنا بِالسَبايا وَالنِهابِ",68,"ب",1,0],["وقتلُ إلفٍ وأكلُ كفٍّ","وَضيقُ خُفٍّ ونَزعُ نَفسِ",69,"س",1,0],["وَقَتلُ عَمٍّ وَشُربُ سَمٍّ","وَطولُ غَمٍّ وَضَنكُ حَبسِ",69,"س",1,0],["وقتلُ خالٍ وعُدمُ مالٍ","وسُوءُ خالٍ وطُول عكسِ",69,"س",1,0],["وقَتيلِ الجُفونِ سُقماً تَفانَت","في هَواهُ النُّفوسُ أَسراً وقَتلا",70,"ل",2,1],["وَقَتَلت صبا عائِذاً بِكَ لَم يَجد","مِن جور سُلطان المَحبة مفزعا",71,"ع",2,0],["وقتله واجب","كسائرالمهدرات",72,"ت",1,0],["وَقَتلُهُم الساداتِ من آلِ هاشِمٍ","وَسَبيهِمُ عن جُرأةٍ لِنِسائِهِم",73,"م",1,0],["وقتيل في محبّتكم","ماله بين الورى قودُ",74,"د",1,0],["وَقَتِ ابنَ نعمانَ النزاهةُ أو نجا","سَلماً فكان من الخطوب بمعزِلِ",75,"ل",1,0],["وقتيلُ العيونِ هيهاتِ أنْ","يحييهِ غيرُ اللواحظِ القتّالة",76,"ل",2,0],["وقتك عمر خيم تمارك","هو نور غراسك يا باب",77,"ب",1,0],["وَقَتَلتُ كَعباً قَبلَها","وَعَلَوتُ بِالسَيفِ الذُؤابَه",78,"ب",2,0],["وَقَتَلنا عَلى الثَنِيَّةِ عَمراً","وَجَلَبنا عَدِيَّهُم مَغلولا",79,"ل",2,0],["وقتك من الأسواء أنفس معشر","لهم حسب في الباخلين طويل",80,"ل",1,0],["وَقْتُ الأَصِيل مَعَ التّأَخُّ","رِ يَفْضُلُ الأَوْقاتَ طُرّا",81,"ر",2,0],["وَقَتَّلوا كُلَّ جَبّارٍ وَدانَ لَهُم","مَن قَد أَسَرَّ مُعاداةً وَعِصيانا",82,"ن",2,0],["وقتٌ به السّعدُ مقرونٌ ومُلتبسٌ","وطالعٌ وَسْطَه التوفيقُ مُرتِفقُ",83,"ق",1,0],["وَقُتودِ ناجِيَةٍ وَضَعتُ بِقَفرَةٍ","وَالطَيرُ غاشِيَةُ العَوافي وَقَّعُ",84,"ع",1,0],["وقتلك معنى الروح بالروح يقتضي","قصاصاً بسيف الحق إذ هو شارع",85,"ع",1,0],["وقتلهم فاطمة الزهراء","أضرم حر النار في أحشائي",86,"ي",1,0],["وقتلوا وانقطعت مدتهم","وانصرموا وفنيت عدتهم",86,"م",1,0],["وقتلوا جماعة من شعيته","ومن بني آبائه وعرته",86,"ه",1,0],["وقتل البعض وهد الأمرى","إذ خاف مما نحلوه الشرا",86,"ر",2,0],["وقتلتَ همِّي من سُطو","ركَ هلْ سطورُك مِن نِضَالِكْ",87,"ك",1,0],["وقتْه جُنَّةُ تقْوى في مَعارِكه","وجنَّةُ الصَّبر فيها لِلتَّقِيِّ تَقي",88,"ق",2,0]]}