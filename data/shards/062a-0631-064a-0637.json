{"poems":[[37,"أفي رسم أطلال بشطب فمرجم","https://www.aldiwan.net/poem38832.html","الطويل"],[56,"أبا عبد الاله أصخ لقولي","https://www.aldiwan.net/poem27609.html","الوافر"],[32,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[90,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[63,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[520,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64069","الوافر"],[1493,"","https://poetry.dctabudhabi.ae/diwan/poem/202228","الطويل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31499","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123062","الوافر"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21460","الطويل"],[2712,"","https://poetry.dctabudhabi.ae/diwan/poem/105722","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4133,"","https://poetry.dctabudhabi.ae/diwan/poem/97679","الوافر"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104535","الطويل"],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""]],"verses":[["تَرى طَبَقَ الأَعناقِ مِنها كَأَنَّهُ","إِلَيكَ كُعوبُ السَمهَرِيِّ المُقَوَّمِ",0,"م",1,0],["تَرى طَمساً تَعودُ بِها اللَيالي","إِلى الدُنيا كَما رَجَعَت إِيادُ",1,"د",1,0],["تَرى طَيرَها في كُلِّ عافٍ وَحاجِلٍ","إِلى حَيَّةِ الأَنفاسِ مَوتى عِظامُها",2,"م",3,0],["ترى طبع واديه رءوفاً بأهله","شديداً على ما يزعج النفس بأسه",3,"س",2,0],["تَرى طَمَعَ العافينَ يَحتاجُ وَفرَه","وليسَتْ ترى أعدؤه فيه مَطمَعا",4,"ع",2,0],["ترى طائر النسرين أول واقع","تمر به في كل فج له فخ",5,"خ",1,0],["ترى طَرْفَ الأقاحي بي","نها من أطْرَفِ الطُّرَف",6,"ف",1,0],["ترى طالب الحاجات نحو بيوتكم","عصائب هلكى تهتدى بعصائب",7,"ب",1,0],["تَرى طالِبي الحاجاتِ يَغشَونَ بابَهُ","سِراعاً كَما تَهوى إِلى أُدَمى النَحلُ",8,"ل",1,0],["تُرى طرفي على قلبي مُعيني","بحُسن الصّبر والدمع المُعينِ",9,"ن",1,1],["تَرى طَرَفيهِ يَعسِلان كِلاهُما","كَما اهتَزَّ عودُ الساسَمِ المُتَتايعُ",10,"ع",1,0],["ترى طير الأراكِ تنوحُ مثلى","على أعلى الغصونِ المائلاتِ",11,"ت",1,0],["ترى طيشا بعقلك لا يداوى","فتخفي الطيش في مشي الوقور",12,"ر",1,0],["تَرى طَلقَ المَحيا ذا اِزدِهاء","إِذا ما الكَلبُ أَحجَرَهُ الشِتاء",13,"ا",2,0],["تُرى طيرُ الأراكِ يَنوح مثلي","عَلى أَعلى الغصونِ المائلاتِ",14,"ت",1,0],["ترى طبقات الخلد في طبقاتها","لبعض على بعض علاً وتفوق",15,"ق",1,0],["تَرى طَيْرَاً عَلى الْشَبَّاكِ يَوْمَاً","يُرَاوَدُهَا شَقَاءً قَدْ غَشَاهَا",16,"ا",3,0]]}