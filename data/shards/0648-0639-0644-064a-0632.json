{"poems":[[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80018","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77201","الخفيف"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106794","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76494","الكامل"]],"verses":[["وَعَلى زُبالَةَ باتَ مِنهُ كَلكَلٌ","وَعَلى الكَثيبِ وَقُلَّةِ الأَدحالِ",0,"ل",1,0],["وعلى زحف الليالي لا شكت","أبداً أبيات علياكم زحافا",1,"ف",2,0],["وَعَلى زَرعِنا سَلامٌ وَبَردٌ","وَعَلى ضَرعِنا رَخاءٌ وَخَيرُ",2,"ر",1,0],["وَعَلَى زِقَاقِ البَعلِ أن تَسرِي ضُحىً","قُولِي عَلَيكِ مِنَ المَشُوقِ سَلاَمُ",3,"م",1,0],["وَعَلى زَمان قَد مَضى وكانه","لَم ينقض اذ لَم تَزَل سيماته",4,"ت",2,0]]}