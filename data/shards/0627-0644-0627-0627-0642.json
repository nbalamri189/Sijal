{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[50,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[202,"ألا اقصري لا أطيع العذل في رشأ","https://www.aldiwan.net/poem51911.html","البسيط"],[434,"أعاذلتي على رزءٍ أفيقي","https://www.aldiwan.net/poem764.html",""],[438,"ألا اقبح بدهلك من بلدة","https://www.aldiwan.net/poem12689.html","المتقارب"],[445,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[510,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98197","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90827","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58163","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58085","الطويل"],[5112,"سجدتي كمامتي","https://www.poetsgate.com/ViewPoem.aspx?id=211145",""],[5829,"امنت بالله","https://www.poetsgate.com/ViewPoem.aspx?id=155462",""]],"verses":[["أَلّا أَقالَتكَ اللَيالي عَثرَةً","يا مَن إِذا عَثَرَ الزَمانُ أَقالا",0,"ل",2,0],["أَلا أَقمتَ فَكانَ الرُشدُ أَجمَعُهُ","لَو أَنَّنِي يَومَ بانَ الرُشدُ اتبَعُهُ",1,"ع",2,0],["أَلا اِقتُليني فَفي ذا","كَ راحَةٌ لِلعَميدِ",2,"د",1,0],["ألا اقْصري لا أُطيعُ العذلَ في رَشَأٍ","في مثلِهِ لا يزالُ الصبُّ يعصيكِ",3,"ك",1,1],["أَلا أَقسَمتُ آسى بَعَد بِشرٍ","عَلى حَيًّ يَموتُ وَلا صَديقِ",4,"ق",1,0],["ألا اقْبح بدهلكَ من بلدة","فكلُّ امرئٍ حلّها هالِكُ",5,"ك",1,1],["أَلا أَقْدَمَتْ فِي حَوْمَةِ الموتِ والرَّدى","تُطارِدُهُ حمرا وتبهره قدما",6,"م",2,0],["ألا أقبِحْ بها سُنناً فردُّوا","لما شئتمْ خلا الإسلامَ دينا",7,"ن",2,0],["ألا اقتديتَ بحُوَّلٍ في وجدِه","قد عارك الأشجانَ وهْوَ نحيلُ",8,"ل",1,0],["ألا أقمتُ فكانَ الرشدُ أَجمَعُهُ","لو أَنني حين بانَ الرُشدُ أتبعُهُ",9,"ه",1,0],["إلا اقتداء بالكتاب وكيف لا","واللَه في القرآن أعظم ذاكر",10,"ر",1,0],["إلا أقام بها السرو","ر لها وللأتراح اقعد",11,"د",1,0],["ألا اقْنَوْا في بيوتكم حَيَاءً","عن العلياء أنتم قاعدونا",12,"ن",2,0],["أَلاَ اقصرْ فإنَّ الله ليس بغافلٍ","وسوفَ تراهُ مُهْلِكاً كلَّ من طَغَى",13,"غ",2,0],["ألا اِقْتَرَبَ الصَّيْفُ لَا سِينَما","وَلَا شاطئا ضَجَّ بالحفلةِ",14,"ه",1,0],["إلا أقدّمُ في دنياي معذرة","يا بؤس أعمالي باءت بخسرانِ",15,"ن",1,0]]}