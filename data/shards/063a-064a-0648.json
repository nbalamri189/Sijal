{"poems":[[79,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[53,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[31,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[63,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[48,"بعالج بات هم النفس يعتلج","https://www.aldiwan.net/poem22243.html","البسيط"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43648","الطويل"],[79,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[119,"بأعتاب تاج المرسلين التجائيا","https://www.aldiwan.net/poem42170.html","الطويل"],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[147,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[154,"رأيت بني الدنيا يؤمل نفعهم","https://www.aldiwan.net/poem68544.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[173,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[382,"مراتب أهل الفضل خمس تجمعت","https://www.aldiwan.net/poem59262.html","الطويل"],[412,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[412,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[438,"أما إنه لولا الخيال المعاود","https://www.aldiwan.net/poem12609.html","الطويل"],[463,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[466,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[487,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[520,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138362",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77670","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67838","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62524","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198680","الطويل"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199209","المتقارب"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11899","الطويل"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101830","الطويل"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143887","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198874","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69320","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96027","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53042","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109367","الطويل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84529","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76068","الطويل"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96433","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122471","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200701","المنسرح"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74147","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67982","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89300","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48323","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48325","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131293",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199111","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199055","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94432","الطويل"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120188","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58162","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104922","الطويل"],[4702,"علام الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155110",""],[4775,"النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=175343",""],[4929,"جمالك ماله ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=199239",""],[5039,"على كثر القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=48129",""],[5111,"مَرَاكِبُ الرَّجَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212131",""],[5431,"غيومٌ به سكرى...","https://www.poetsgate.com/ViewPoem.aspx?id=198423",""],[5582,"أَلا عُوجُوا عَلَى الطَّلَلِ القَدِيمِ","https://www.poetsgate.com/ViewPoem.aspx?id=187263",""],[5756,"غرام احباب","https://www.poetsgate.com/ViewPoem.aspx?id=5423",""],[5956,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183218",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[6167,"غيوم السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85553&r=&rc=36",""],[422,"إذا نَبَتِ الدّيارُ بِحرِّ قومٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22246&r=&rc=2",""]],"verses":[["غُيوثُ نَوالٍ كلّما سُئِلُوا النّوى","لُيوثٌ نِزالٍ كلّما حضَروا الزّحْفا",0,"ف",2,0],["غُيُوثٌ إِذَا أَعْطَوْا لُيُوثٌ إِذَا سَطَوْا","أَهِلَّةُ هَالاَتِ الْبَهَاءِ إِذَا اعْتَمُّوا",1,"م",3,0],["غيوثُ سماح والعفاة مسايلٌ","ليوث كفاح والكماة تنازلُ",2,"ل",1,0],["غُيُوثٌ رأى الإمحالُ فيها حِمَامَهُ","قرينَ حياةِ الأرضِ بعد هُمُودها",3,"د",3,0],["غيوثٌ لها ضوءُ الشموسِ وإنها","شُموسٌ لها صوْبٌ ملِثٌّ وأظلالُ",4,"ل",1,0],["غَيورٌ طَوى طَيَّ المُلاءِ بُطونُها","وَلَوَّحَها تَسحاجُهُ وَصَلاصِلُه",5,"ل",2,0],["غيومٌ تُمَسِّكُ أُفقَ السَّما","وبَرقٌ يُكتِّبُها بالذَّهَب",6,"ب",1,0],["غُيوثٌ لَهُم يَومَ الجِيادِ مِنَ الظُبى","بُروقٌ وَمِن وَطءِ الجِهادِ رُعودُ",7,"د",1,0],["غُيوثٌ تَلتَقي الأَرحامُ فيها","تُحِلُّ بِها الطَروقَةُ وَاللِجابُ",8,"ب",1,0],["غَيورٍ عَلى أَصحابِهِ لا يَرومُهُ","خَليطٌ وَلا يَرجو سِواهُ صَواحِبُه",9,"ب",2,0],["غُيوثُ مَحلٍ وَمِن أَدراعِهِم غُدُرٌ","بِحارُ جودٍ وَفي أَغمارِهِم خُلِجُ",10,"ج",1,0],["غُيُوثاً تَنُوءُ عَلى المُقتِري","نَ إِن يَكذِبِ الغَيثُ لَم تَكذِبِ",11,"ب",1,0],["غَيورٌ أَبوهُ كَيفَ لي بِلِقائِهِ","وَمِن حَولِهِ سُمرُ القَنا وَالسَوابِغُ",12,"غ",1,0],["غيوث نوال كلما سئلوا الندى","ليوث نزال كلما حضروا الزحفا",13,"ف",2,0],["غيور على إيذاء أشبال بنته","إذا ما انتحى من كان خلا مواسيا",14,"ي",2,0],["غيوبُ غيوبِ الغيبِ صارت بمشهدٍ","له وبه من شاء يشهد أسهما",15,"م",2,0],["غُيوثُ نَدىً تُعدي عَلى المَحلِ كُلَّما","عَدا وَلُيوثٌ وَالجِيادُ بِهِم تَعدو",16,"د",2,0],["غيوث جدوب أو شموس معارف","هضاب حلوم أو نجوم غياهب",17,"ب",1,0],["غيور على أدنى الحقوق لربه","بغيرة ملك شاكر الله ذاكر",18,"ر",1,0],["غَيُورٍ عَلى العَلياءِ أَن يَبتَني بِها","رَزايا أُناسٌ ما تُمِرُّ وَلا تُحلي",19,"ل",2,0],["غيورٌ على الإيمان والعرض والتقى","به غيرةٌ تنمو إلى الحق تنتمي",20,"م",2,0],["غَيوث وَلَكِن قطرة الغيث بدرة","مكملة أَو نبرة وَجوادُ",21,"د",1,0],["غَيوثٌ وَلَكِن قَطرِها المال وَالنَدى","ليوثٌ وَلَكِن المُلوكَ صُيودُها",22,"د",3,0],["غيوث مكارمٍ وليوث حربٍ","وأكفاءُ الشجاعةِ والكفاحِ",23,"ح",1,0],["غُيوثٌ لُيوثٌ نائلاً وشجاعةً","إذا أجدبَ المَرعى وصالَ المُعاند",24,"د",1,0],["غيور لا ينام على اهتضام ال","كرام ولا الغِرارَ ولا الخُفوقا",25,"ق",2,0],["غيوثُ نوالٍ أو ليوثُ كريهةٍ","إِذا شهدوا حَرَّ الوغى والمشاتيا",26,"ي",2,0],["غيور يرى في القلب غيره في الزمن","موارد إسعاد تكون مدانيا",27,"ي",2,0],["غيوث إذا ضن السحاب بوبله","ليوث إذا صل الحديد وصالوا",28,"ل",3,0],["غَيورٌ إِذا ما الحَقُّ غُيِّرَ مولَعٌ","بِقَطعِ لِسانِ الباطِلِيِّ اليَلندَدِ",29,"د",1,0],["غيوث رحمة مولانا العلىّ همت","تسقي ضريحك في الاسحار والاصل",30,"ل",1,0],["غَيورَة بَخيلَة شريرَة","صَغيرَةٌ وَفي الأَسى كَبيرَه",31,"ه",1,0],["غَيُورٌ لِدِينِ اللهِ يَحْمِي ذِمَارَهُ","بِعَزْمٍ لِهَامِ الشِّرْكِ وَالكُفْرِ دَامِغُ",32,"غ",1,0],["غيور للمَحارم لستُ أرضى","لها في حقها إلا احتراما",33,"م",2,0],["غيوث سلم ليوث حرب","رؤوس حي صدور نادي",34,"د",2,0],["غيوث إذا ما المحل شب ببلدة","كهوف إذا جاءت بنا أرضه كبرى",35,"ر",2,0],["غُيوثٌ إذا ضَنَّ قطر السماء","ليوثٌ إذا زحفَ الجَحفلُ",36,"ل",1,0],["غُيوثٌ إِذا جادَوا لُيوثٌ إِذا سَطَوا","لَهُم نائِلٌ جَمٌّ وَمَجدٌ مُشَيَّدُ",37,"د",1,0],["غيوث ندى أن أجدب العام يغتدي","إليهم حديث الجود في الناس مسندا",38,"د",2,0],["غيومُ غمومٍ لا يَرِمْنَ عن الجَفْنِ","ومُزْنُ دموعٍ هنَّ أَسْخى من المُزْنِ",39,"ن",1,1],["غيور إذا زغنا عن الحق أحمد","فويلي فما غيري عن الحق أوزغ",40,"غ",1,0],["غُيُوثٌ إِذا جادوا لُيُوثٌ إِذا عَدَوا","كَثيرٌ إِذا عادَوا قَليلٌ إِذا عُدُّوا",41,"د",3,0],["غيوث ليوث يومي السلم والوغى","مماة حياة للمعادي وللولي",42,"ل",2,0],["غُيوث لها يوم النوال تدفق","لُيوث لها يوم النزال وثوب",43,"ب",1,0],["غيوث جدواه بب","رق البِشْر مستهله",44,"ل",2,0],["غيورٌ على من يحتمي بجنابه","وان كان من يبغي له الضيم ضيغما",45,"م",2,0],["غيور حمى الحدبآء من كل طارِق","وَهَل يَستَوي البازي بطشاً وَزغزغ",46,"غ",1,0],["غَيورٌ عَلى الحُسنِ الَّذي هُوَ حُسنُهُ","كَأنَّ بِهِ عشقَ المُحبِّ الملازِمِ",47,"م",1,0],["غيوتٌ لمن يرجو نداهم وجودهم","سمامٌ لأقوام صُحاةٌ وثُمَّلُ",48,"ل",1,0],["غُيوثاً فِي السَّلاَمِ وَفي الحُروبِ اللُّيُوثُ","وهكَذَا طرداً وعَكسَا",49,"س",2,0],["غيورة ربّةُ القريض فما","تدخل بيتاً وفيه ضرّتها",50,"ه",2,0],["غيوث إِذا أعطوا ليوث إِذا سَطوا","بحار أَياديهم تَفوق عَلى البَحرِ",51,"ر",1,0],["غَيورٌ تحوم الأُسْد حول حِمائه","ومهما رَعاياه سامَ فأَغْيَر",52,"ر",1,0],["غيور متى أهوى يقول من الذي","عليّ هضيم الكشح ريّا المخلخل",53,"ل",1,0],["غيوثٌ ولكنْ كلّما شهِدوا الوَغى","لُيوثٌ ومُلْتَفُّ القَنا أجَماتُها",54,"ت",3,0],["غُيوثٌ إذا ما السُّحْبُ أخْلفَ جَوْدُها","لُيوثٌ ومُلْتَفُّ الذّوابِلِ غِيلُها",55,"ل",3,0],["غيوراً عليه من حسودٍ وجاهل","ومن ذي هوى ما كان إلا محابيا",56,"ي",2,0],["غيور أن يمس حمى شريف","ويأنف للمذلة والهوان",57,"ن",1,0],["غيور ومتلاف له من نواله","دعائم بر ماثلات صمود",58,"د",1,0],["غيوث جود ليوث في اللقاء فكم","عم العداة بهم غم وتنكيل",59,"ل",1,0],["غيورٌ بني للمؤمنين مدارساً","بها الرشد قد أضحى من الفضل مثمرا",60,"ر",2,0],["غيوث هطل فى عام جدب","ليوث بُسَّلٌ يوم ازدحام",61,"م",1,0],["غيوثٌ لمُسْتَسْقٍ نكَالٌ لمعتدٍ","أَمَان الورى خوفٌ إذا مِنْهمُ دَنَا",62,"ن",2,0],["غيوم غموم كلما قلت أنها","قد انقشعت زادت عليّ تراكما",63,"م",2,0],["غيوم وموج في ظلمى غدت بي شاعرٍ مأسور","غدت بي وقت اصارعها نهاره لي مثل ليله",64,"ل",2,0],["غيوم في الهوى يا خب تنسى","شروقي ثم تجهضني سحابي",65,"ب",2,0],["غيومي فيك مرعدةٌ","ونَوئي سيلُ ودياني",66,"ن",2,0],["غيوض وما يغيض النرجس الا ضحكة النوار","\"نعم\" والجود لو يفنا فنا من زود حبهلك",67,"ك",1,0],["غُيُومٌ يسْتَحِمُّ بهَا الْعَنَاءُ","أ فَاتنتِي مَتى يَصحُو اللقَاءُ ؟",68,"ا",2,1],["غيومٌ به سكرى وروحي له الكأسُ","على رُسلِها أمشي بعشبٍ هو الحسُ",69,"س",1,1],["غُيُومُ نَداكَ أَغْنَتْنِي إِذا ما","عَدِمْتُ نَدَى الغُيُومِ مِنَ الغُيُومِ",70,"م",1,0],["غيورٍ ماعرفت أضحك مع الغدر ببّرود أعصاب","أبيع عيوني الثنتين قبل أنك تخونيني",71,"ن",2,0],["غيوم البحر أجمل من غيوم","لدى صدر السماء بها أُعافَى",72,"ف",2,0],["غيومُ بحيراتٍ وشمسُ كواكبٍ","تؤثِّر في شِعري ليصبحَ أعظما",73,"م",2,0],["غيومُ الوجد مرسوم سناها","بسرّ اللغز كحَّلَت الجفونا",74,"ن",2,0],["غُيومُ السماءِ رأيتُ المُنى","سَرابا يجوسُ بأدنى مَدَاهْ",75,"ا",2,1],["غيومُ السماءِ وهل خبَّروكِ","بِداءِ القلوبِ بوادى الحياهْ",75,"ا",2,0],["غيومُ السماءِ وما يَرتجِى","كَئيبٌ يُتَمتمُ : وَا لو عَتَاهْ",75,"ا",2,0],["غيومُ السماءِ وقد تعجبينَ","أَيحزَنُ قلبٌ وضوءٌ حَواهْ",75,"ا",2,0],["غيوث مكارممٍ وليوث حربِ","وأكفاءُ الشجاعة ِ والكفاح",76,"ح",1,0]]}