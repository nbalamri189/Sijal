لخفيف"],[445,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[451,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[461,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[461,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[461,"قل لها أيها الخيال الطروق","https://www.aldiwan.net/poem56105.html","الخفيف"],[461,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[461,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[461,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[461,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[464,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[467,"أو ما ترى وجه السماء معبساً","https://www.aldiwan.net/poem3547.html","عموديه"],[480,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[480,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[482,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[503,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[503,"تهادت العيس ليلا","https://www.aldiwan.net/poem37778.html","المجتث"],[503,"من لجسم من لوعة الهجر بالي","https://www.aldiwan.net/poem37923.html","الخفيف"],[518,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[530,"قد عصاني دمعي وخلي فخلت الخل","https://www.aldiwan.net/poem45996.html","الخفيف"],[532,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[554,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[554,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[554,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[554,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[554,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[554,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[554,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[554,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[554,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[561,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[561,"إن قوما لم يروا","https://www.aldiwan.net/poem34263.html","مجزوء الرمل"],[561,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[561,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[561,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[561,"حروف المباني والمعاني تنزهت","https://www.aldiwan.net/poem34543.html","الطويل"],[565,"بنو عبيد أقاموا اليوم مدرسة","https://www.aldiwan.net/poem52581.html","البسيط"],[565,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[565,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"],[565,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"],[565,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[570,"مقلة بالدمع منبجسه","https://www.aldiwan.net/poem69641.html","المديد"],[570,"ما تغطي أكوار تلك البدور","https://www.aldiwan.net/poem69679.html","الخفيف"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"]],"verses":[["وَفَوارِساً يَتَسَمَّعونَ إِلى العُلى","نَغَماتِ كُلِّ حَنِيَّةٍ مِرنانِ",0,"ن",1,0],["وَفَوارِساً يَتَزاحَمونَ عَلى الرَدى","نَهلاً وَقَد عَزَّ البَرودُ السَلسَلُ",1,"ل",1,0],["وَفَوارِسٍ ما اِستَعصَموا بِثَنيَّةٍ","إِلّا طَلَعتَ عَلَيهِمُ في جَحفَلِ",2,"ل",1,0],["وَفَوارِسٍ كَالشُهبِ تَطرَحُ ضَوءَها","يَومَ الوَغى وَأَوارِ حَرِّ النارِ",3,"ر",1,0],["وَفَوارِسٍ رَكِبوا النَجاءَ وَأَدلَجوا","مِن موغِلٍ خَلفَ المُنى وَمَغَرِّرِ",4,"ر",1,0],["وَفَوَّفَت ريحُ الصَبا مَتنَهُ","تَفويفَ أَعلامٍ وَأَبرادِ",5,"د",1,0],["وَفَوقَ قَطاها غِلمَةٌ غالِبِيَّةٌ","تَميسُ عَلى أَكتافِها وَفَراتُها",6,"ت",3,0],["وَفَوقَها مِن قُرَيشٍ مَعشَرٌ نُجبٌ","بيضٌ شِدادُ حُبا الأَحلامِ أَخيارُ",7,"ر",1,0],["وَفَوقَ السَّريرِ ابنُ المُلوكِ مُحَمَّدٌ","تَخِرُّ لَهُ مِن فَرطِ هَيبَتِهِ النَّاسُ",8,"س",1,0],["وَفَوَّقَتْ عَيْنُكِ لي أَسْهماً","لَمْ تَمتَنِعْ مِنْ وَقْعِها الأَدْرُعُ",9,"ع",1,0],["وَفَوْقَ مَطاهَا كُلُّ أَرْوَعَ مَاجِدٍ","يَقُودُ نِزاراً كُلَّها وَيَسُودُها",10,"د",3,0],["وفَوقَ الغُرَيْرِيّاتِ أعْناقُ فِتْيَةٍ","يَشُدُّ طُلاها بالرِّحالِ دُؤوبُها",11,"ب",3,0],["وَفَوارِسٍ لي قَد عَلِمتُهُمُ","صُبُرٍ عَلى التَكرارِ وَالكَلمِ",12,"م",1,1],["وَفَوارِسُ الهَيجاءِ بَينَ مُمانِعٍ","وَمُدافِعٍ وَمُخادِعٍ وَمُعَربِدِ",13,"د",1,0],["وَفَوْقَ سَفْحِ عَمِيق الدَّمْعِ عُجْ لِتَرَى","جَآذِرَ الْحَيِّ بَيْنَ الخُرَّدِ الْعِينِ",14,"ن",1,0],["وَفَوْقَ رَاحَتِهِ صُمُّ الْحَصَى نَطَقَتْ","وَالْمَاءُ مِنْ كَفِّهِ يُزْرِي بِجَيْحُونِ",14,"ن",1,0],["وَفَوْقَ ابْنِ الْبَتُولِ ابْنٌ","وَفَوْقَ ابْنِ الْبَتُولِ أَبُ",15,"ب",1,0],["وَفَوِّض إِلى اللَهِ الأُمورَ فَإِنَّما","تَروحُ بِأَرزاقٍ عَلَيكِ جُدودُ",16,"د",1,0],["وَفوهُ كَشَرخِ الكورِ خانَ بِأَسرِهِ","مَساميرُهُ فَحِنوُهُ مُتَفاقِمُ",17,"م",1,0],["وَفَوقَ الحَوايا غِزلَةٌ وَجَآذِرٌ","تَضَمَّخنَ مِن مِسكٍ ذَكِيٍّ وَزَنبَقِ",18,"ق",1,0],["وَفَوقَ جِمالِ الحَيِّ بيضٌ كَأَنَّها","عَلى الرَقمِ آرامُ الأَثيلِ الأَوارِكُ",19,"ك",1,0],["وَفَوارِساً مِنّا هُنالِكَ قُتِّلوا","في عَشرَةٍ كانَت مِنَ الدَهرِ",20,"ر",1,0],["وَفَوقَهُما ساقٌ كَأَنَّ حَماتَها","إِذا اِستُعرِضَت مِن ظاهِرِ الرَحلِ خِرنِقُ",21,"ق",1,0],["وفوقك من سعدٍ لواءٌ مُشَهَّرٌ","ودونك من عزم حسامٌ مُصمِّمُ",22,"م",1,0],["وَفَوُا المواطن حقها وتسنّموا","أعلى المفاجر بالصوارم والقنا",23,"ن",2,0],["وفوقها الطير وهي حائمة","تبعد من رأسها وتقترب",24,"ب",1,0],["وَفَوا يَومَ بَدرٍ لِلرَسولِ وَفَوقَهُم","ظِلالُ المَنايا وَالسُيوفُ اللَوامِعُ",25,"ع",1,0],["وَفَوا إِذ كَفَرتُم يا سَخينَ بِرَبِّكُم","وَلا يَستَوي عَبدٌ عَصى وَمُطيعُ",26,"ع",1,0],["وفوقَ رأسيَ من شيب الأسى نطفٌ","ماذا جرى في الأسى منها على راسي",27,"س",2,0],["وفوّق منه الشرع سهم إصابة","فلا غَرْوَ إن أضحى به وافر السهم",28,"م",1,0],["وفؤاد به من ال","وجد نار تَوقَّدُ",29,"د",1,0],["وفؤادٌ مُضنىً وشوقٌ قديمٌ","وهوىً كامنٌ وسُقميَ فاش",30,"ش",1,0],["وفوق ذَينكَ أعنابٌ مُهَدَّلةٌ","سودٌ لهن من الظلماء ألوانُ",31,"ن",1,0],["وفوتُ ما كنتَ تُلقيه إلى أُذني","من فَضْلِ علم يُجَلَّى عنه باللَّسنِ",32,"ن",1,0],["وَفَوقَنا الأَغصانُ مَعقودَةٌ","ذَوائِبٌ طالَ تَدَلّيها",33,"ي",3,0],["وَفَوقَ سَريرِ المُلكِ أَروَعُ قاهِرٌ","نَبيهُ المَعالي في المُلِمّاتِ نَبهانُ",34,"ن",1,0],["وَفُؤادٌ أَضحى بِغَيرِ اِصطِبارٍ","وَجُفونٌ أَمسَت بِغَيرِ اِغتِماضِ",35,"ض",1,0],["وفوْجٍ تغذِّيه الحَيَاةُ لِبَانَهَا","وفوْجٍ يُرى تَحْتَ التُّرابِ لهُ رَدْمُ",36,"م",1,0],["وفوقه عبرات غير راقئة","يسقينه ثم روح ثم ريحان",37,"ن",1,0],["وفود مولاى لولا أنها نزلت","بالحلم قلنا وفود البحر ذى العبب",38,"ب",1,0],["وفؤادي لا رشاد له","طالب اللذات ليس ينى",39,"ن",2,0],["وَفُؤادٍ مُعَلَّلٍ","بِالخَيالاتِ وَالذُكَر",40,"ر",1,0],["وَفُؤادي مِنَ المُلوكِ وَإِن كا","نَ لِساني يُرى مِنَ الشُعَراءِ",41,"ا",2,0],["وَفَوقَ حَواشي كُلِّ ثَوبٍ مُوَجَّهٍ","مِنَ الدُرِّ سِمطٌ لَم يُثَقِّبهُ ناظِمُه",42,"م",2,0],["وَفَوارِسٍ يُحَيِ الحِمامُ نُفوسَها","فَكَأَنَّها لَيسَت مِنَ الحَيَوانِ",43,"ن",1,0],["وفوق المِنَصَّةِ مجلوَّةٌ","علينا عرائسُ من كسكرِ",44,"ر",1,0],["وَفَواقِعٌ مِثلُ الدُموعِ تَرَدَّدَت","في صَحنِ خَدِّ الكاعِبِ الحَسناءِ",45,"ا",2,0],["وفوق رؤوس الشرب غيم معلق","من الند لا يسري ولا هو ساكب",46,"ب",1,0],["وفوارغَ الأحشاءِ من بَرحِ الصَّبا","يُضْحِي الفراغُ بهنَّ شُغلاً شاغِلا",47,"ل",2,0],["وفوقَك صَفراوانِ إن شئتَ غَنَّتا","كذاكِرَتيْ فَرخَينْ شفَّهُما الذِّكرى",48,"ر",2,0],["وفَوقَ العِيسِ بِيضٌ وكَّلَتْنا","بأيَّامٍ من الهِجرانِ سُودِ",