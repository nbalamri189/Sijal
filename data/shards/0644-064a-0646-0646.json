7,"","https://poetry.dctabudhabi.ae/diwan/poem/74151","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100733","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121663","المتقارب"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124087","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89230","الطويل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125938","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124647","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36798","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77078","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94482","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73300","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136540",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136566",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72493","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120507","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101936","الطويل"],[4787,"لَئِن نفذ الْقدر السَّابِق","https://www.poetsgate.com/ViewPoem.aspx?id=189652",""],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[5055,"ماجد","https://www.poetsgate.com/ViewPoem.aspx?id=104297",""],[5277,"هكذا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=187898",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5845,"أيرجعُلي قربُ الحبيبِ المعاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198432",""],[6064,"لئن نحن خفنا في زمان عدوكم","https://www.poetsgate.com/ViewPoem.aspx?id=96331",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""],[6259,"ألا هل لعهد العامريّة جاحدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59371&r=&rc=19",""],[422,"بوادي الغضا للمالكية أرْبُعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22255&r=&rc=11",""]],"verses":[["لَئِن نِلتُ الكَواكِبَ في عُلاها","لَقَد أَبقَيتُ فَضلاً مِن مَنالي",0,"ل",2,0],["لَئِن نَأى عَنّا فَإِحسانُهُ","أَدنى مِنَ الناظِرِ وَالمَسمَعِ",1,"ع",1,0],["لَئِن نَبَحَتهُ آوِنَةً كِلابٌ","لَقَد لَبِسَت بِهِ الأَسَدَ المُهاجا",2,"ج",2,0],["لَئِن نَشَبَت مِن سِربِها في حِبالَتي","مَليحَةُ ما وارى البَراقَعُ رودُ",3,"د",1,0],["لَئِنْ نسِيَتْ إحْسانَ جدِّكَ فِرْقَة","تُزَرُّ علَى أعْناقِهِمْ منْهُ أطْواقُ",4,"ق",1,0],["لئن نسيتْ تلك العهودَ أحبَّتي","فقلبيَ عهدَ العامريّة ما نسي",5,"س",2,0],["لئن نشرت على دهرِي قصائده","لقد طويت على حبٍّ ضمائره",6,"ر",2,0],["لئن نزلت عن بلدةٍ يدُ ملكه","فما نزلت من بلدة الأفق علياه",7,"ا",2,0],["لئن نصر الأنْصارُ بَدْءاً نبيَّهمْ","لقد عُدْتُم بالنصر والعودُ أحمدُ",8,"د",1,0],["لئن نفرتْ مني الظباء لربما","يكون قريباً من سهامي بعيدُها",9,"د",3,0],["لئن نِلْتُمُ منها حُظوظاً لقد غَدتْ","نفوسُكُمُ مذمومةً في المشاهدِ",10,"د",1,0],["لئن نَفِس الأعداءُ حظك إنه","لحَظّ جزيل لا يعنَّف نافسه",11,"س",2,0],["لئن نَعُمَتْ لِما رثَّتْ حبالٌ","لها عندي ولا أمست رِماما",12,"م",2,0],["لَئِن ناءَ مِن سِمَنٍ جِسمُهُ","فَما عَرِفَت روحُهُ ما السِمَن",13,"ن",1,0],["لَئِن نَفَرُ الحَجّاجِ آلُ مُعَتِّبٍ","لَقوا دَولَةً كانَ العَدُوُّ يُدالُها",14,"ل",3,0],["لَئِن نَأَت عَنكُمُ يَوماً جَوانِحُنا","فَإِنَّ أَرواحَنا في رَبعِكُم جَنَحَت",15,"ت",1,0],["لَئِن نَقِموا حوشِيَّةً فيكَ دونَها","لَقَد عَلِموا عَن أَيِّ عِلقٍ تُناضِلُ",16,"ل",1,0],["لَئِن نائِباتِ الدَهرِ يَوماً أَدَلنَ لي","عَلى أُمِّ عَمروٍ دَولَةً لا أُقيلُها",17,"ه",2,0],["لِئنْ نكَبوا الكِنانةَ حِينَ جاءوا","لقد نُكِبوا بِشعبٍ ذِي إباءِ",18,"ا",2,0],["لَئِن نَطَقَ اللِسانُ بِبَعضِ حُبّي","لَأَعظَمُ مِنهُ ما لَكَ في الضَميرِ",19,"ر",1,0],["لئن نكَّسوه يوم متَّ، فطالما","وقفت له في ساعة الروع حاميا",20,"ي",2,0],["لَئِن ناسَبَتكَ التُركُ فَرعاً وَعُنصُراً","فَما لَكَ في حَوزِ العَلاءِ مُناسِبُ",21,"ب",1,0],["لَئِن نالَ جِسمَكَ نَهكُ الضَنى","لَقَد ضَنِيَ السُؤددُ الأَعظَمُ",22,"م",1,0],["لَئِن نَفَرَت كُماةُ الحَربِ عَنهُ","إِذاً فَلَها بِعَقوَتِهِ اِزدِحامُ",23,"م",1,0],["لئن نجت مهجتي مما رميت به","من فقدها القوت بعد النزع والعلج",24,"ج",1,0],["لَئِن نَفَع الإسلامَ مِن دونِ قصدهِ","فَكم هوَ عَن قصدٍ به ألحقَ الضرّا",25,"ر",2,0],["لئن نَفِدَتْ أيَّامُهُ إنَّ لوعتي","على قِدَمِ الأيامِ ما ليس تَنْفَد",26,"د",1,0],["لئن نور الرحمن قلبي بذكره","غنيت بذاك النور عن نور مقلتي",27,"ت",2,0],["لئن ندرت لي عطفة بوصا لكم","عَلى بعد دارينا وَقرب الحواسِد",28,"د",1,0],["لَئِن نَأَت عَن سَوادِ العَينِ دارُهُمُ","فَإِنَّهُم بِسُوَيدِ القَلبِ سُكّانُ",29,"ن",1,0],["لَئِن نَأَت بَعدَ قُربٍ مِنكُمُ الدارُ","فَلي إِلَيكُم صَباباتٌ وَتَذكارُ",30,"ر",1,1],["لئن نَقعَت من لاعج الوجد غُلَّةً","فمن بعد ما أَورَت لهيبَ أوامِ",31,"م",1,0],["لئن نسخَ البينُ المشِتُّ وِصالَنا","فَما هو للحبِّ المبرِّحِ ناسِخُ",32,"خ",1,0],["لَئِن نالَتِ الأَملاكُ مُلكاً بِحَظِّها","فَقَد نِلتُمُ ما نِلتُمُ بِمَساعِ",33,"ع",1,1],["لئِن نامَ اصطِباري فَ","غَرامي فيكَ يَقظانُ",34,"ن",1,0],["لَئِن نامَ عَن جَدوى أَبي الفَضلِ طالِب","فَما جودِهِ عَن ما يُحاوِلُ راقِدُ",35,"د",1,0],["لئن نام حظّي يا أميمُ عن العُلى","فعزمي كما تدرينَهُ غير نائم",36,"م",1,0],["لئن نشرت طيّ الغرام الذي لها","فقد طُوِيَتْ منِّي على الوجدِ أضلع",37,"ع",1,0],["لئن نأت الديار فإن قربى","لاسعد من رقى العليا ارتجاعُ",38,"ع",1,0],["لئن نسيت فمحصي اللَه ما عملت","نفسي من خالص الأعمال والغلث",39,"ث",1,0],["لئن نقعت الصدى منكم بمغفرة","فلا صدى بعد نقع الغل يصديني",40,"ن",2,0],["لئن نسب الشعر بين الحمو","ل باسمى ليُحتبَلَنّ المُسَمْ",41,"م",1,0],["لئن نفَّرتك قِرافُ الأذى","وأوحش سمْعَك لذعُ الكَلِمْ",41,"م",1,0],["لئن نُفضتْ باليأس كفّيَ منهمُ","وأصبحتُ مما يغمر العيشَ مملقا",42,"ق",2,0],["لئن نام دهرِيَ دون المُنَى","وأصبح عن نَيلها مُقعِدي",43,"د",2,0],["لئن نازعتْني يدُ الملك فيك","فلم أستطع بدفاعٍ يدا",44,"د",2,0],["لئن نقلوا ما يجهلون فإنني","لفارسُ علمٍ ناقلاً ومفسِّرا",45,"ر",2,0],["لئن نقص المقدار قدر حياته","لقد مات موفور الجلالة والقدر",46,"ر",1,0],["لئن نظم الأيام عقد طلائع","ضمنت بها يا سلك أن ليس تنثر",47,"ر",1,0],["لئن نصبوا في البر جسراً فإنكم","عبرتم ببحر من حديد على الجسر",48,"ر",1,0],["لئن نظمت ليالي الملك عقداً","عليك فإنه سلك النظام",49,"م",1,0],["لئن نال أسباب السماء بعلمه","فأوتاده في المجد غير مزايل",50,"ل",1,0],["لَئِن نَسُوها عُهوداً كُرِّمَتْ لَهُمُ","حَديثُ سِرِّي وجَهْري في الأنامِ هُمُ",51,"م",1,0],["لئن نوهّت باسمِ الامامِ خلافةٌ","ورفّعتِ الزّاكي النِّجارِ مناسِبُه",52,"ب",2,0],["لئن نجوتَ من الأحداثِ أو سلمت","منهن نفسك لم تسلم من الهَرم",53,"م",1,0],["لَئِنْ نُسِبَ القَوَامُ إلَى رَشِيقٍ","فَقَدْ نُسِبَ المُحَيَّا لِلْحُسَيْنِ",54,"ن",1,0],["لَئنْ نَضَبَ الدَّمعُ مِنْ شانِهِ","فليس التَّصبُّرُ مِن شانِهِ",55,"ن",2,1],["لَيْنٌ نوائلُ عُرْفِهِ تَنكيرُهُ","شَرِسٌ يُلازِمُ كَيَّهُ إِنضاجُهُ",56,"ج",2,0],["لئن نلتما بالسحر من كل غرة","ففي مقل الغزلان كل غرور",57,"ر",1,0],["لئن نأيتم وقلبي كله لكم","فللحوادث جسمي كله عرض",58,"ض",1,0],["لئن نبزَ الناسُ قِدْماً أباكَ","فسمّوه من شُحّه صُرَّ بَعْرا",59,"ر",2,1],["لئنْ نزحَتْ داري فإنَّ مودَّتي","على كدَر الأيّام صافٍ غديرُها",60,"ر",3,0],["لئن نَصَبتَ لي الرَّوقَينِ مُعتَرِضاً","لَأَرمِينَّكَ رَمياً غَيرَ تَرقيعِ",61,"ع",1,1],["لئن نلت منك العفو من بعد توبة","فأنت بفضل منك يسرت توبتي",62,"ي",1,0],["لئن نال عهد اللّه قبل خلافة","لأنت من اعهد الذي نلت أفضَلُ",63,"ل",1,0],["لَئِن نَبَت بِيَ حمصٌ وَهيَ قَد فَعَلَت","فَلَيسَ تَنبو بِيَ السَبعُ الأَقاليمُ",64,"م",1,0],["لئنْ نَفَضُوا الأناملَ مِنْ ثَرَاهَا","لقد مَلَؤوهُ منْ حُسْنٍ وطيب",65,"ب",1,0],["لئن نزحت ذات الوشاحين فالجوى","مقيمٌ بقلبٍ رسمُ مغناه دائر",66,"ر",1,0],["لئن نزحت تلك الديار فوجدنا","عليها له بين الضلوع أنين",67,"ن",1,0],["لئن نثرت لئالي أدمعي فعلى","سوى فريد جماني غير ناثرها",68,"ر",3,0],["لئن نصَّروك فهذا التطوُّعُ","ذكرى وريّا الفؤاد الصدي",69,"د",2,0],["لئن نطقَتْ دمالجُها دَلاَلاً","وخلخالاً لقد نطقت وشاحا",70,"ح",2,0],["لئن نذروا صرماً لأوّل أوبةٍ","فنذريَ صومى منذ يوم ذهابه",71,"ه",1,1],["لئن نقضتم عهودي لست أنقضها","حفظ المودة طبع عنه لم أحد",72,"د",1,0],["لئن نسى امرؤ عهدا فإني","لعهد أبي الفوارس غير ناس",73,"س",1,1],["لئن نلتَ من بعد التشاؤم لذة","فما نلتُ من دنيايَ غير التشاؤم",74,"م",1,0],["لئن نالني تَعْسٌ من الدهر مزمنٌ","فلي أملٌ في جانب التعس مزمن",75,"ن",1,0],["لئِن نَفَرَّقنا ولم نجتمِع","وزادت الفرقَةٌ عن وقتها",76,"ه",2,1],["لَئن نسيت عُهوداً بِالحِمى سلفت","فَلَست أَنسى وَإني ذَلِكَ الرَجل",77,"ل",1,0],["لئن ناضل الشرع الحنيف فحسبه","هواناً ومن يعتدَّ بالشرع يكرم",78,"م",1,0],["لَئِن نكَسَّ الدهرُ حَظِّي فلِي","لطَائفُ في الغَيْبِ تُحْيِي الرَّجَاءْ",79,"ا",2,1],["لئن نسخ الشيب الصبابة والصبا","لفى القلب عهد محكمٌ ليس ينسخ",80,"خ",1,0],["لئن نظرت عيني محاسن غيرهم","لحقَّ عليها بالدموع تُسبَّع",81,"ع",1,0],["لئن ناصب المقدور نفسي حروبه","وهشم من عزمي بواتر امضائي",82,"ي",1,0],["لَئِن نَشَرتُ ثناءً لا خَفَاءَ بِهِ","لَقًَد بَسَطتَ عَطَايا مَالَهَا قِيَمُ",83,"م",1,0],["لَئِن نَقَل الأَقوامُ عَنّي جِنايَةً","لَهُم وَالإِمامِ الحَقِّ حَقّاً جناتُها",84,"ت",3,0],["لَئِن نِلتُ مِن زَفسٍ وَفالاسَ نُصرَةً","فَبَعدِيَ قَبلَ القَومِ تَظفِرُ بالجَدا",85,"د",2,0],["لَئِن نَنَل مِن لَدى زَفسٍ إِبادَتَهُم","وَنَشرَ خَزيِهِم فَليَهلِكوا عَجَلا",86,"ل",2,0],["لَئِن نَأَت دارَكُم عَنّي فَمَنزِلُكُم","في القَلبِ وَالطُرفِ يَوماً لَيسَ يَحتَجِبُ",87,"ب",1,0],["لَئِن ناءَ لا يحزن على النأي خاسرٌ","وإن جاءَ لا يفرح لدى الوفد كاسبُه",88,"ب",2,0],["لَئن نسي الحَبيبُ فما نَسينا","وإن أسلى الفؤادَ فما سلينا",89,"ن",2,1],["لَئِن نَزَحَت بِكُم عَنَّا اللَّيالي","فَأَنتُم في حِمَى قَلبِي نُزولُ",90,"ل",1,0],["لئن نقَضوا عهدَ الوداد فاننيّ","وفيتُ بعهدي إذ أقمتُ على الود",91,"د",1,0],["لئن نَفرت عني وألوت بجيدها","فما هي إلا الريمُ والريم نافِر",92,"ر",1,0],["لئن نزرت أعدادنا فنزارنا","حبنا بما تحمي به الجار دارنا",93,"ن",2,0],["لئن نزرت أقرانه فجواره","عزيز وجار الاكثرين ذليل",94,"ل",1,0],["لئن نظرت عيناك في السن مثله","فما رأتا في مجده من مزاحم",95,"م",1,0],["لئن نزرت كماً وكيفاً لديكم","فإن الهدايا تقتفي أثر المهدي",96,"د",2,0],["لَئِن نفذ الْقدر السَّابِق","بموتي كَمَا حكم الْخَالِق",97,"ق",1,1],["لين نْعَسَت عين..وشوي نْعَسَت عين","ونمت وتركتك تحاكي صمت الالوان!",98,"ن",1,0],["لين نلفي داركم ملفى سبوع","نرضي الهامات ونزيح الخصام",99,"م",1,0],["لئنْ نكثَ العشَّاقُ يوماً منَ النوى","فلستُ الَّذي بالعهدِ يوماً سينكثُ",100,"ث",1,0],["لئن نبذت قتلى عراة لدى العرى","فأرهب أسياف الحروب عراتها",101,"ت",3,0],["لئنْ نذرتْ لي عطفة ً بوصالكمْ","على بعد دارينا وقربَ الحواسدِ",102,"د",1,0],["لئن نحن خفنا في زمان عدوكم","وخفناكم إن البلاء لراكد",103,"د",1,1],["لَئِن نَتََّحِد نَملِك وَلَيسَ يَصُدُّنا","عَتادُ ذَوي الأطماعِ أَو كَثرَةُ الجُندِ",104,"د",1,0],["لئنْ نفضتْ باليأسِ كفّي منهمُ","وأصبحتُ ممّا يملقُ العيشُ مملقا",105,"ق",2,0],["لئن نام عن جدوى أبي الفضل طالبٌ","فما جوده عما يحاولُ راقد",106,"د",1,0],["لئن نشرت طيّ الغرام الذي لها","فقط طُويَتْ مني على الوجد أضلع",107,"ع",1,0]]}