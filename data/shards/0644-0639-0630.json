{"poems":[[55,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[46,"لوْ أنَّ دهراً ردَّ رجعَ جوابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15648&r=&rc=8",""],[119,"وغزيل عبث النسيم بطبعه","https://www.aldiwan.net/poem41182.html","عموديه"],[369,"سألت ومن خلقي أنني","https://www.aldiwan.net/poem60671.html","المتقارب"],[371,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102218","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126365","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115430","الكامل"],[3420,"","https://poetry.dctabudhabi.ae/diwan/poem/177881","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105524","الرمل"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134252","الكامل"],[5823,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=59133",""]],"verses":[["لَعَذَرتُ مَن في المَجدِ يَمرَضُ فِكرُهُ","وَتَكُنُّ فيهِ بَواطِنُ الآلامِ",0,"م",1,0],["لَعَذَلتُهُ في دِمنَتَينِ بِرامَةٍ","مَمحُوَّتَينِ لِزَينَبٍ وَرَبابِ",1,"ب",1,0],["لعذلتهُ في دمنتينِ بأمرة ٍ","مَمْحُوَّتَيْنِ لِزَيْنَبٍ ورَبَاب",2,"ب",1,0],["لعذرت مفتون الغرام ولم تمل","ما عشت للوام والنصاح",3,"ح",1,0],["لِعُذْريَ فاقْبَلْ وكنْ عالِماً","بأنّي لعُذْرِكَ لا أَقبَل",4,"ل",1,0],["لِعُذّالِهِ مِن وَعرِها أَيُّ هَضبَةٍ","لِأَحبابِهِ مِن سَهلِها أَيُّما بَطحا",5,"ح",2,0],["لعذرتِني وعلمتِ أنيَ طالبٌ","ما الزُهدُ في الدنيا له مِفتاحُ",6,"ح",1,0],["لَعُذِرْتُمُ فيه ولم أَهتف بكم","أَبَداً ولكنْ خِفْتُ كُثْرَ العارِ",7,"ر",1,0],["لعذاره الساري العجول بخدِّه","ما في وقوفك ساعة من باس",8,"س",1,0],["لِعَذَرتَهُ إن بَالَ فِي القَلُّوطِ لَم","يَشرَب بِهِ مَع جُملَةِ العُميَانِ",9,"ن",1,0],["لعذر تموني في التشاغل","بالملاهي والشراب",10,"ب",1,0],["لعذرتموه وماله من عاذل","وعذلتموه وماله من عاذر",11,"ر",1,0],["لعذابي أنت كنت السبا","وسواك اللب لم يختلس",12,"س",1,0],["لعذرت من ملك الجمال قياده","ولدنت في شرع الهوى بالهون",13,"ن",1,0],["لعذب الحديث يتوق فؤادي،","ويبني ممالك عشق تُضاءُ",14,"ا",2,0]]}