{"poems":[[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[3,"عقاب الهجر أعقب لي الوصال","https://www.aldiwan.net/poem197.html",""],[55,"صحائف عندي للعتاب طويتها","https://www.aldiwan.net/poem26169.html","الطويل"],[55,"وصلت فلما لم أر الوصل نافعي","https://www.aldiwan.net/poem26185.html","الطويل"],[55,"عتبت وما أستطيع العتابا","https://www.aldiwan.net/poem26522.html","المتقارب"],[55,"عتبت على نفسي لعتبي عليكم","https://www.aldiwan.net/poem26524.html","الطويل"],[71,"وما إخوة شتى النجار فمنهم","https://www.aldiwan.net/poem3858.html","الطويل"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[35,"أمن آل قيلة بالدخول رسوم","https://www.aldiwan.net/poem39086.html","الكامل"],[93,"أمات أولئك الجند الكرام","https://www.aldiwan.net/poem11420.html","الوافر"],[88,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[27,"سمت لي نظرة فرأيت برقا","https://www.aldiwan.net/poem5736.html","الوافر"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[72,"عتبت ابن الوكيل وشك ظني","https://www.aldiwan.net/poem20310.html","الوافر"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"ألا يا قاتل الديك","https://www.aldiwan.net/poem65825.html","الهزج"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[51,"أصبت مصائب كنت الشري","https://www.aldiwan.net/poem66523.html","البسيط"],[29,"لعمري لقد أسريت لا ليل عاجز","https://www.aldiwan.net/poem6023.html","الطويل"],[91,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[70,"وزائر على عجل","https://www.aldiwan.net/poem42734.html","مجزوء الرجز"],[70,"رويدك قد أفنيت يا بين أدمعي","https://www.aldiwan.net/poem42833.html","الطويل"],[70,"عفا الله عنكم أين ذاك التودد","https://www.aldiwan.net/poem42937.html","الطويل"],[70,"عتب الحبيب ولم أجد","https://www.aldiwan.net/poem42985.html","مجزوء الكامل"],[70,"إلى عدلكم أنهي حديثي وأنتهي","https://www.aldiwan.net/poem43042.html","الطويل"],[78,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[89,"عتا وقال يقيني","https://www.aldiwan.net/poem44714.html","المجتث"],[89,"لهفي يطول على شبابك","https://www.aldiwan.net/poem44755.html","مجزوء الكامل"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[62,"عتبت فرضت النفس بالهجر مدة","https://www.aldiwan.net/poem52301.html","الطويل"],[62,"عجبا لقوم يحسدون فضائلي","https://www.aldiwan.net/poem52312.html","الكامل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"ألا تعجبون كما أعجب","https://www.aldiwan.net/poem11487.html","المتقارب"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[45,"فداؤك نفسي دون رهطي ومعشري","https://www.aldiwan.net/poem63567.html","الطويل"],[28,"أترجو ربيع أن يجيء صغارها","https://www.aldiwan.net/poem5136.html","الطويل"],[28,"بنات المهاري الصهب كل نجيبة","https://www.aldiwan.net/poem5323.html","الطويل"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[49,"عتابة النفس كاعب شكله","https://www.aldiwan.net/poem64286.html","المنسرح"],[49,"عتب ما للخيال","https://www.aldiwan.net/poem64292.html","مجزوء الخفيف"],[66,"ومدام حكت سهيل اتقادا","https://www.aldiwan.net/poem39189.html","الخفيف"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[33,"عسى الله أن يجري المودة بيننا","https://www.aldiwan.net/poem25743.html","الطويل"],[33,"أيا شبه ليلى لا تراعي فإنني","https://www.aldiwan.net/poem25862.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"غوى الناس حتى لا صواب ولا رشد","https://www.aldiwan.net/poem43420.html","الطويل"],[52,"عتبت عليك مليحة العتب","https://www.aldiwan.net/poem27304.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[48,"عتبت عليك محاسن الخمر","https://www.aldiwan.net/poem63272.html","الكامل"],[48,"لا تعرج بدارس الأطلال","https://www.aldiwan.net/poem64498.html","الخفيف"],[48,"لا تمزج الخمر على حال","https://www.aldiwan.net/poem64504.html","السريع"],[48,"يا شقيق النفس من حكم","https://www.aldiwan.net/poem65090.html","المديد"],[48,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[48,"عتاب ليس ينصرم","https://www.aldiwan.net/poem65237.html","مجزوء الوافر"],[48,"اسقني يا ابن أذين","https://www.aldiwan.net/poem65290.html","مجزوء الرمل"],[48,"أسقياني من شمول","https://www.aldiwan.net/poem66633.html","مجزوء الرمل"],[50,"عتبت على الزمان وأي حي","https://www.aldiwan.net/poem24564.html","الوافر"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[50,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[46,"ما للنعائم لا تمل نفارها","https://www.aldiwan.net/poem22633.html","الكامل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85309","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85827","المجتث"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9894","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54587","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5788","الوافر"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[50,"طال ليْلِي مِنْ حُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=16883",""],[7,"أهاجَكَ، من أسماءَ، رَسمُ المَنازِلِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17583",""],[90,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[46,"وجَدتُ النّاسَ كالأرَضينَ شتّى،","https://www.poetsgate.com/ViewPoem.aspx?id=20268",""],[51,"يا بْن المدبِّر غرَّنيِ الروَّادُ","https://www.poetsgate.com/ViewPoem.aspx?id=27824",""],[39,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""]],"verses":[["عِتاقُ الوُجوهِ وَعُتقُ الجِيا","دِ في الضُمرِ تَعرِفُهُ وَالقَبَب",0,"ب",1,0],["عَتَقَتْ علَيَّ ألِيَّةٌ سَيُبِرُّها","هَمٌّ بِمُعْتَرَكِ النُّجومِ مُخَيِّمُ",1,"م",1,0],["عَتَبتُ الدَهرَ كَيفَ يُذِلَّ مِثلي","وَلي عَزمٌ أَقُدُّ بِهِ الجِبالا",2,"ل",2,0],["عِتابٌ لَعَمري لا بَنانٌ تَخُطُّهُ","وَلَيسَ يُؤَدّيهِ إِلَيكِ رَسولُ",3,"ل",1,0],["عَتَبتُ عَلى نَفسي وَأَقبَلتُ تائِباً","إِلَيكِ مَتابَ المُذنِبِ المُتَنَصِّلِ",4,"ل",1,0],["عَتَبتِ وَما أَستَطيعُ العِتابا","وَحَسبي بِطولِ سُكوتٍ عَذابا",5,"ب",2,1],["عَتَبتُ عَلى نَفسي لِعَتبي عَلَيكُمُ","وَما ضَرَّ غَيري فَاِعلَمي ذَلِكَ العَتبُ",6,"ب",1,1],["عَتادُهُم نَحرُ الصَفايا لِقَومِهِم","إِذا السَنَةُ الشَهباءُ أَخلَفَها القَطرُ",7,"ر",1,0],["عُتباكَ بَعدَ العَتبِ أُمنِيَّةٌ","ما لي عَلى الدَهرِ سَواها اِقتِراح",8,"ح",1,0],["عَتَدُ القِيادِ كَأَنَّهُ مُتَحَجِّرٌ","حَرِبٌ يُشاهِدُ رَهطَهُ مَظلومُ",9,"م",1,0],["عَتِيٌّ مَا جَثَا للهِ إلاَّ","وَمَرْكَعُهُ عَلَى عَمَدٍ يُقَامُ",10,"م",1,0],["عتَبْت على بغداد عَتْب مُوَدِّع","أمَضَّتْه فيها الحادثاتِ قراعا",11,"ع",2,0],["عُتَيبَةُ وَالأُحَيمِرُ وَاِبنُ سَعدٍ","وَعَتّابٌ وَفارِسُ ذي الخِمارِ",12,"ر",1,0],["عَتيقُ سُلافاتٍ سَبَتها سَفينَةٌ","تَكُرُّ عَلَيها بِالمِزاجِ النَياطِلُ",13,"ل",1,0],["عَتَّقَها الحانوتُ دَهراً فَقَد","مَرَّ عَلَيها فَرطُ عامٍ فَعام",14,"م",1,0],["عتبت ابن الوكيل وشكّ ظني","فأعتبني وعادَ إلى اليقين",15,"ن",1,1],["عَتْبُ إلْفٍ أرقُّ من كَلِم الأم","مِ وإن كان من ذرى خَلْقاءِ",16,"ا",2,0],["عَتيدٌ لَديْهِ الخَيرُ والشرُّ لامْرىءٍ","بَغَى أوْ بَغَى خيراً ولَلْخَيْرُ أَعْتَدُ",17,"د",1,0],["عُتِقْتِ من الأطْمَاع يوم لقائه","ورِقُّ ذوي الأطماع رقٌّ مُؤَبَّدُ",17,"د",1,0],["عُتْباك منها أن غضبْتَ مقالتي","ستُزادُ يا ابن مدبّرٍ وتُزادُ",18,"د",1,0],["عَتِبْتَ عَلينا أن عففنا عن التي","تؤاجرُها فاستنشق الغيظ واستعِط",19,"ط",1,0],["عتبتَ على المقرض المقتضي","وما ظَلمَ المُسلفُ المرتجع",20,"ع",1,0],["عتتْ قدماً","كأرماحِ الصعاليكِ",21,"ك",1,0],["عتُقن فهن من قربٍ ملاحٌ","ورُقْن فهن من بُعْدِ فِخامُ",22,"م",1,0],["عتبتَ عليّ لأن الزما","ن ينحى عليهم ببَرْكٍ طَحون",23,"ن",1,0],["عَتَبتُم عَلَينا قَيسَ عَيلانَ كُلُّكُم","وَأَيُّ عَدُوٍّ لَم نُبِتهُ عَلى عَتبِ",24,"ب",1,0],["عَتِبتُ عَلى الدَهرِ لَو أَنَّني","أَمِنتُ فُؤادِيَ أَن يَعتَبا",25,"ب",2,0],["عَتَبتُهُ لِأَنَّهُ","أَلبَسَني ثَوبَ الخَجَل",26,"ل",1,0],["عَتَبتُم فَلا وَاللَهِ ما خُنتُ عَهدَكُم","وَما كُنتُ في ذاكَ الوَدادِ بُمِدَّعي",27,"ي",1,0],["عَتَبتُم عَلَينا وَاِعتَذَرنا إِلَيكُمُ","وَقُلتُم وَقُلنا وَالهَوى يَتَأَكَّدُ",28,"د",1,0],["عَتَبتُم فَلَم نَعلَم لِطيبِ حَديثِكُم","أَذَلِكَ عَتبٌ أَم رِضاً وَتَوَدُّدُ",28,"د",1,0],["عَتَبَ الحَبيبُ وَلَم أَجِد","سَبَباً لِذاكَ العَتبِ حادِث",29,"ث",1,1],["عَتبُ الحَبيبِ أَلَذُّ مِن","نَغَمِ المثاني وَالمَثالِث",29,"ث",1,0],["عَتَبتُكُمُ عَتبَ المُحِبِّ حَبيبَهُ","وَقُلتُ بِإِذلالٍ فَقولوا بِإِصفاءِ",30,"ا",2,0],["عَتادي أجرُ ما أولَيتُ فيهِم","مِنَ الفَتَكاتِ بِكرٍ أَو عَوانِ",31,"ن",1,0],["عتا وقال يقيني","بالله يقوى ويزكو",32,"و",1,1],["عتبي على الاقدار كيف خططن","هذا في كتابك",33,"ك",1,0],["عتبي على نفسي فلو احمدت","ما كان في شيبي من بأس",34,"س",1,0],["عَتبُهُ رِضىً","لَيتَهُ عَتَب",35,"ب",1,0],["عتبتُ فرضتُ النفسَ بالهجر مدّةً","فلما افترقنا ما انتفعتُ به أصلا",36,"ل",2,1],["عتَبُوا على فضلي وذمُّوا حِكمتي","واستوحشوا من نقصِهم وكمالي",37,"ل",2,0],["عَتادُ نظام المُلكِ للخطب يُتَّقَى","وللمُلكِ يُسْتبقَى وللحقِّ يُتْبَعُ",38,"ع",1,0],["عَتَبتَ فَدَيتُكَ يا مُذنِبُ","فَجِئتُكَ أَبكي وَأَستَعتِبُ",39,"ب",1,0],["عَتادي الَّذي آوى إِلَيهِ وَعُدَّتي","لِما أَختَشي مِن صَرفِ دَهري وَأَرتَجي",40,"ي",1,0],["عِتابٌ بِأَطرافِ القَوافي كَأَنَّهُ","طِعانٌ بِأَطرافِ القَنا المُتَكَسِّرِ",41,"ر",1,0],["عُتُلّونَ صَخّابو العَشِيِّ كَأَنَّهُم","جِداءٌ مِنَ المِعزى شَديدٌ يَعارُها",42,"ر",3,0],["عِتاقٌ تَغَشَّتها السُرى كُلَّ لَيلَةٍ","وَرُكبانُها كَالمَهمَهِ المُتَجانِفِ",43,"ف",1,0],["عِتاباً كالنَّسيمِ جرَى لعَتْبٍ","يُضَرِّمُ في الحَشا مني استِعارا",44,"ر",2,0],["عُتّابَةُ النَفسِ كاعِبٌ شَكِلَه","كَحلاءُ بِالحُسنِ غَيرُ مُكتَحِلَه",45,"ل",2,1],["عُتبُ ما لِلخَيالِ","خَبِّريني وَمالي",46,"ل",2,1],["عَتَّقَتها القُسوسُ مِسكِيَّةَ الأَن","فاسِ لا قارِسٌ وَلا مَطبوخُ",47,"خ",1,0],["عُتّقَتْ ما عتقت في خَزَفٍ","بِرِداءِ القارِ فيهِ تَرتَدي",48,"د",2,0],["عَتُقَت وَسيلَتُهُ وَأَيَّةُ قيمَةٍ","لِلتُّبَّعِيِّ العَضبِ إِن لَم يُعتِقِ",49,"ق",1,0],["عَتِبتُ فَما أَعتَبتِني بِمَوَدَّةٍ","وَرُمتِ فَما أَسعَفتِني بِسُؤالِيا",50,"ل",3,0],["عُتِقتِ فَأَدّي شِكرَ لَيلى بِنِعمَةٍ","فَأَنتِ لِلَيلى إِن شَكَرتِ طَليقُ",51,"ق",1,0],["عَتَوْا في الأرضِ والتهموا بنيها","فكانوا وَحشَها الجَشِعَ البطينا",52,"ن",2,0],["عَتبتُم عَلى الأَيّامِ وَهيَ كَعهدِها","فَلا تعتبُوا حَتّى يَدومَ لَكُم عَهدُ",53,"د",1,0],["عَتَبَت عَلَيكَ مَليحَةُ العَتبِ","غَضبى مُهاجِرَةً بِلا ذَنَبِ",54,"ب",1,1],["عَتَوْا 