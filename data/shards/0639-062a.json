دام في الخلوات","https://www.aldiwan.net/poem69367.html","الخفيف"],[560,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[573,"أبى القلب إلا أن يبيت به صباً","https://www.aldiwan.net/poem2993.html","الطويل"],[573,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[573,"عتبنا على الأيام قبل ظهوره","https://www.aldiwan.net/poem3105.html","الطويل"]],"verses":[["عِتاقُ الوُجوهِ وَعُتقُ الجِيا","دِ في الضُمرِ تَعرِفُهُ وَالقَبَب",0,"ب",1,0],["عَتَقَتْ علَيَّ ألِيَّةٌ سَيُبِرُّها","هَمٌّ بِمُعْتَرَكِ النُّجومِ مُخَيِّمُ",1,"م",1,0],["عَتَبتُ الدَهرَ كَيفَ يُذِلَّ مِثلي","وَلي عَزمٌ أَقُدُّ بِهِ الجِبالا",2,"ل",2,0],["عِتابٌ لَعَمري لا بَنانٌ تَخُطُّهُ","وَلَيسَ يُؤَدّيهِ إِلَيكِ رَسولُ",3,"ل",1,0],["عَتَبتُ عَلى نَفسي وَأَقبَلتُ تائِباً","إِلَيكِ مَتابَ المُذنِبِ المُتَنَصِّلِ",4,"ل",1,0],["عَتَبتِ وَما أَستَطيعُ العِتابا","وَحَسبي بِطولِ سُكوتٍ عَذابا",5,"ب",2,1],["عَتَبتُ عَلى نَفسي لِعَتبي عَلَيكُمُ","وَما ضَرَّ غَيري فَاِعلَمي ذَلِكَ العَتبُ",6,"ب",1,1],["عَتادُهُم نَحرُ الصَفايا لِقَومِهِم","إِذا السَنَةُ الشَهباءُ أَخلَفَها القَطرُ",7,"ر",1,0],["عُتباكَ بَعدَ العَتبِ أُمنِيَّةٌ","ما لي عَلى الدَهرِ سَواها اِقتِراح",8,"ح",1,0],["عَتَدُ القِيادِ كَأَنَّهُ مُتَحَجِّرٌ","حَرِبٌ يُشاهِدُ رَهطَهُ مَظلومُ",9,"م",1,0],["عَتِيٌّ مَا جَثَا للهِ إلاَّ","وَمَرْكَعُهُ عَلَى عَمَدٍ يُقَامُ",10,"م",1,0],["عتَبْت على بغداد عَتْب مُوَدِّع","أمَضَّتْه فيها الحادثاتِ قراعا",11,"ع",2,0],["عُتَيبَةُ وَالأُحَيمِرُ وَاِبنُ سَعدٍ","وَعَتّابٌ وَفارِسُ ذي الخِمارِ",12,"ر",1,0],["عَتيقُ سُلافاتٍ سَبَتها سَفينَةٌ","تَكُرُّ عَلَيها بِالمِزاجِ النَياطِلُ",13,"ل",1,0],["عَتَّقَها الحانوتُ دَهراً فَقَد","مَرَّ عَلَيها فَرطُ عامٍ فَعام",14,"م",1,0],["عتبت ابن الوكيل وشكّ ظني","فأعتبني وعادَ إلى اليقين",15,"ن",1,1],["عَتْبُ إلْفٍ أرقُّ من كَلِم الأم","مِ وإن كان من ذرى خَلْقاءِ",16,"ا",2,0],["عَتيدٌ لَديْهِ الخَيرُ والشرُّ لامْرىءٍ","بَغَى أوْ بَغَى خيراً ولَلْخَيْرُ أَعْتَدُ",17,"د",1,0],["عُتِقْتِ من الأطْمَاع يوم لقائه","ورِقُّ ذوي الأطماع رقٌّ مُؤَبَّدُ",17,"د",1,0],["عُتْباك منها أن غضبْتَ مقالتي","ستُزادُ يا ابن مدبّرٍ وتُزادُ",18,"د",1,0],["عَتِبْتَ عَلينا أن عففنا عن التي","تؤاجرُها فاستنشق الغيظ واستعِط",19,"ط",1,0],["عتبتَ على المقرض المقتضي","وما ظَلمَ المُسلفُ المرتجع",20,"ع",1,0],["عتتْ قدماً","كأرماحِ الصعاليكِ",21,"ك",1,0],["عتُقن فهن من قربٍ ملاحٌ","ورُقْن فهن من بُعْدِ فِخامُ",22,"م",1,0],["عتبتَ عليّ لأن الزما","ن ينحى عليهم ببَرْكٍ طَحون",23,"ن",1,0],["عَتَبتُم عَلَينا قَيسَ عَيلانَ كُلُّكُم","وَأَيُّ عَدُوٍّ لَم نُبِتهُ عَلى عَتبِ",24,"ب",1,0],["عَتِبتُ عَلى الدَهرِ لَو أَنَّني","أَمِنتُ فُؤادِيَ أَن يَعتَبا",25,"ب",2,0],["عَتَبتُهُ لِأَنَّهُ","أَلبَسَني ثَوبَ الخَجَل",26,"ل",1,0],["عَتَبتُم فَلا وَاللَهِ ما خُنتُ عَهدَكُم","وَما كُنتُ في ذاكَ الوَدادِ بُمِدَّعي",27,"ي",1,0],["عَتَبتُم عَلَينا وَاِعتَذَرنا إِلَيكُمُ","وَقُلتُم وَقُلنا وَالهَوى يَتَأَكَّدُ",28,"د",1,0],["عَتَبتُم فَلَم نَعلَم لِطيبِ حَديثِكُم","أَذَلِكَ عَتبٌ أَم رِضاً وَتَوَدُّدُ",28,"د",1,0],["عَتَبَ الحَبيبُ وَلَم أَجِد","سَبَباً لِذاكَ العَتبِ حادِث",29,"ث",1,1],["عَتبُ الحَبيبِ أَلَذُّ مِن","نَغَمِ المثاني وَالمَثالِث",29,"ث",1,0],["عَتَبتُكُمُ عَتبَ المُحِبِّ حَبيبَهُ","وَقُلتُ بِإِذلالٍ فَقولوا بِإِصفاءِ",30,"ا",2,0],["عَتادي أجرُ ما أولَيتُ فيهِم","مِنَ الفَتَكاتِ بِكرٍ أَو عَوانِ",31,"ن",1,0],["عتا وقال يقيني","بالله يقوى ويزكو",32,"و",1,1],["عتبي على الاقدار كيف خططن","هذا في كتابك",33,"ك",1,0],["عتبي على نفسي فلو احمدت","ما كان في شيبي من بأس",34,"س",1,0],["عَتبُهُ رِضىً","لَيتَهُ عَتَب",35,"ب",1,0],["عتبتُ فرضتُ النفسَ بالهجر مدّةً","فلما افترقنا ما انتفعتُ به أصلا",36,"ل",2,1],["عتَبُوا على فضلي وذمُّوا حِكمتي","واستوحشوا من نقصِهم وكمالي",37,"ل",2,0],["عَتادُ نظام المُلكِ للخطب يُتَّقَى","وللمُلكِ يُسْتبقَى وللحقِّ يُتْبَعُ",38,"ع",1,0],["عَتَبتَ فَدَيتُكَ يا مُذنِبُ","فَجِئتُكَ أَبكي وَأَستَعتِبُ",39,"ب",1,0],["عَتادي الَّذي آوى إِلَيهِ وَعُدَّتي","لِما أَختَشي مِن صَرفِ دَهري وَأَرتَجي",40,"ي",1,0],["عِتابٌ بِأَطرافِ القَوافي كَأَنَّهُ","طِعانٌ بِأَطرافِ القَنا المُتَكَسِّرِ",41,"ر",1,0],["عُتُلّونَ صَخّابو العَشِيِّ كَأَنَّهُم","جِداءٌ مِنَ المِعزى شَديدٌ يَعارُها",42,"ر",3,0],["عِتاقٌ تَغَشَّتها السُرى كُلَّ لَيلَةٍ","وَرُكبانُها كَالمَهمَهِ المُتَجانِفِ",43,"ف",1,0],["عِتاباً كالنَّسيمِ جرَى لعَتْبٍ","يُضَرِّمُ في الحَشا مني استِعارا",44,"ر",2,0],["عُتّابَةُ النَفسِ كاعِبٌ شَكِلَه","كَحلاءُ بِالحُسنِ غَيرُ مُكتَحِلَه",45,"ل",2,1],["عُتبُ ما لِلخَيالِ","خَبِّريني وَمالي",46,"ل",2,1],["عَتَّقَتها القُسوسُ مِسكِيَّةَ الأَن","فاسِ لا قارِسٌ وَلا مَطبوخُ",47,"خ",1,0],["عُتّقَتْ ما عتقت في خَزَفٍ","بِرِداءِ القارِ فيهِ تَرتَدي",48,"د",2,0],["عَتُقَت وَسيلَتُهُ وَأَيَّةُ قيمَةٍ","لِلتُّبَّعِيِّ العَضبِ إِن لَم يُعتِقِ",49,"ق",1,0],["عَتِبتُ فَما أَعتَبتِني بِمَوَدَّةٍ","وَرُمتِ فَما أَسعَفتِني بِسُؤالِيا",50,"ل",3,0],["عُتِقتِ فَأَدّي شِكرَ لَيلى بِنِعمَةٍ","فَأَنتِ لِلَيلى إِن شَكَرتِ طَليقُ",51,"ق",1,0],["عَتَوْا في الأرضِ والتهموا بنيها","فكانوا وَحشَها الجَشِعَ البطينا",52,"ن",2,0],["عَتبتُم عَلى الأَيّامِ وَهيَ كَعهدِها","فَلا تعتبُوا حَتّى يَدومَ لَكُم عَهدُ",53,"د",1,0],["عَتَبَت عَلَيكَ مَليحَةُ العَتبِ","غَضبى مُهاجِرَةً بِلا ذَنَبِ",54,"ب",1,1],["عَتَوْا فغادرتَ في صَحرائهم رَهَجاً","يمتَدُّ منهُم على الأفلاكِ كالظُّلَل",55,"ل",1,0],["عَتَدٌ يَطيرُ إِذا هَتَفتَ بِهِ","فَإِذا رَضيتُ بِعَفوِهِ سَبَحا",56,"ح",2,0],["عَتَبَت عَلَيكَ مَحاسِنُ الخَمرِ","أَم غَيَّرَتكَ نَوائِبُ الدَهرِ",57,"ر",1,1],["عُتِّقَت في الدِنانِ حَتّى اِستَفادَت","نورَ شَمسِ الضُحى وَبَردَ الظِلالِ",58,"ل",1,0],["عَتَّقَها الكُردِيُّ في مَجلِسٍ","بَينَ بَساتينَ وَأَجبالِ",59,"ل",1,0],["عُتِّقَت حَتّى لَوِ اتَّصَلَت","بِلِسانٍ ناطِقٍ وَفَمِ",60,"م",1,0],["عَتَّقَتها الأَنباطُ عَشراً فَعَشراً","ثُمَّ عَشراً في مُدمَجٍ مَختومِ",61,"م",1,0],["عِتابٌ لَيسَ يَنصَرِمُ","وَحُبٌّ لَيسَ يَنكَتِمُ",62,"م",1,1],["عُتِّقَت في الدَنِّ حَتّى","هِيَ في رِقَّةِ ديني",63,"ن",2,0],["عُتّقَت حولاً وحَولاً","بين كرَم ونخيل",64,"ل",1,0],["عَتَبتُ عَلى الزَمانِ وَأَيُّ حَيٍّ","مِنَ الأَحياءِ أَعتَبَهُ الزَمانُ",65,"ن",1,1],["عَتَبتُ عَلى خِنزيرِ كَلبٍ وَإِنَّني","بِذاكَ عَلى الكَلبِ التَميمِيِّ أَعتَبُ",66,