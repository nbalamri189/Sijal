قُ",81,"ق",1,0],["اشوفك هنا وهناك وهناك كيف ارتاح","وفي كل حالاتي خيالك مخاويني",82,"ن",2,0],["اشوفهم في كل ديره وكل حيّ,","ثم صار في عيني خياله وزوله..",83,"ل",2,0],["أشوف لك لمحة إذا الطرف غفّى","في صحوتي ماخذ خيالي مرايه",84,"ا",3,0],["أشوف الربيع الزين واشوف لي بدوان","ومقاطر طويلة مالحقنا تواليها",85,"ي",3,0],["أشواق قلبي من الهجران تقتلني","يا حادي العيس غنِّ الشام موالا",86,"ل",2,0],["اشوف قبري يمر بوحشته فوقي","وتصير كل الحياة أضيق من أخلاقي",87,"ق",2,0],["أشوفك مطر هتان لا برق ولارعاد","من الوسم يبعد بالصحاري زهر ودي",88,"د",2,0],["أشوفها فوق اعتلت وانا تحت ويّا النحيب","والجرح والهم ودموع عشانها اذرفتها",89,"ت",3,0],["أشوفها ساحت جدى فرخ الحداه","يتقاتلوا عشره في خلود أجنابها!!",90,"ب",3,0],["اشووف الكل بعيوني وانا مقهور","واكن الجرح والنظرات مكسوره",91,"ر",2,0],["اشوفك بعيني ضوى ليل وسراج","لك بالمحاني الف ممشى وديره",92,"ر",2,0],["اشوفك طفلتي واهلي اشوفك لي اعز اصحاب","خذانا الليل في غفوه وعلى ايدي تعب نمتي",93,"ت",2,0],["اشوف السفر مره ولاجا الظلام انحاش","وقلب مريح وقلب ن النار صاليها",94,"ي",3,0],["اشوف انت يامنهو يبي مني الخبر","ولي نضرة في كل الاحوال ثاقبه",95,"ب",2,0],["أشوف العلم للغادي مناره","وأشوف الحلم للعاقل سفيره",96,"ر",2,1],["اشوف بدنيتي وحشه وغربة كل يوم تزيد","وحبال الكيد يمكرها لنا بالناس ماكرها",97,"ر",3,0],["اشوف اخواني تعاني لضى خوف ووجع تشريد","وانا مكتوف الايدي ما معي حيله وابادرها",97,"ر",3,0],["اشوف قرومنا صارو ضحايا في نهار العيد","ولا يا مكثر اعياد العدو ماني ابحصرها",97,"ر",3,0],["اشوف طيفه بالخيال واراعيه","وانا اعرف انه كذب والوقت كذاب",98,"ب",1,0],["أشوفها .. بوجيه .. كل القرايب","في بيتها الي خاويٍ ..فيه مجلاس",99,"س",1,0],["اشوف بداخلي طلسم معاني وتمتة شيطان","وعلى الاوراق من امشي اكون بهيئة ايماني",100,"ن",2,0],["اشوف بس أخذ الاشواك وغيري ياخذ ازهارك","ياطيبي كنت احسب الجرح منك حيل يزهابي",101,"ب",2,0],["اشواقنا كطلاسم ورموزها","قد خطهن على الرقيم رقيمُ",102,"م",1,1],["اشوف ديّاني وقف لي على الباب","يبغى الوفا مني ويبغى حسابه",103,"ب",2,1],["أشوم عن رجوى المخاليق واصوم.","معروف حرفي بين صجه .. ولجّه.",104,"ج",2,0],["اشوش