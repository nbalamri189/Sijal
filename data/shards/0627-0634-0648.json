"https://www.poetsgate.com/ViewPoem.aspx?id=177857",""],[5739,"عش ٍ من القش","https://www.poetsgate.com/ViewPoem.aspx?id=126423",""],[5739,"روس ٍ تمسس في عمايمها ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131547",""],[5755,"حظ الحفاة العراه","https://www.poetsgate.com/ViewPoem.aspx?id=133252",""],[5759,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213914",""],[5792,"يحبونه","https://www.poetsgate.com/ViewPoem.aspx?id=180355",""],[5821,"نشرة الأخبار","https://www.poetsgate.com/ViewPoem.aspx?id=113756",""],[5848,"جهة خامسة للبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=53190",""],[5848,"المعقول واللا معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53187",""],[5848,"على حافة غموض","https://www.poetsgate.com/ViewPoem.aspx?id=49223",""],[5848,"والله لاجي قدام بيتك","https://www.poetsgate.com/ViewPoem.aspx?id=53210",""],[5875,"شيّب المهاريف","https://www.poetsgate.com/ViewPoem.aspx?id=187017",""],[192,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=16374",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[5969,"رثاء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=198842",""],[6056,"حالة وراثية","https://www.poetsgate.com/ViewPoem.aspx?id=130318",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6056,"طري العود","https://www.poetsgate.com/ViewPoem.aspx?id=130346",""],[2575,"يا فرحة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=22532",""],[6113,"يامجنوووووووون","https://www.poetsgate.com/ViewPoem.aspx?id=12872",""],[6113,"حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=14417",""],[6113,"خلي هجرني","https://www.poetsgate.com/ViewPoem.aspx?id=14618",""],[6341,"سران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87288&r=&rc=17",""]],"verses":[["أَشَوقاً وَما زالَت لَهُنَّ قِبابُ","وَذِكرَ تَصابٍ وَالمَخيبُ نِقابُ",0,"ب",1,1],["أشَوْقاً وأجْوازُ المَهامِهِ بَيْنَنا","يَطيحُ وجيفٌ دونَها وذَميلُ",1,"ل",1,0],["أَشوقاً وَلَمّا تَمضِ لي غَيرُ لَيلَةٍ","رُوَيدَ الهَوى حَتّى يَغُبَّ لَيالِيا",2,"ي",2,0],["أَشَوقاً وَلَمَّا تَمضِ بي غير ليلةٍ","رُوَيدَ الهَوَى حَتّى لِغبِّ لياليا",3,"ي",2,1],["أشوكت ما ان عنَّ ذكرك خاطراً","بقلبيَ إلا واعترت رجفةٌ قلبي",4,"ب",2,0],["أَشوَسَ لا يَلبَسُ الخَليلَ عَلى","عَمدِ التَكَفّي وَكَثرَةِ الزَلَلِ",5,"ل",1,0],["أَشوامخُ الأحلام وال","مثلِ الرقيقةِ كالهباء",6,"ا",2,0],["أُشَوَّقُ أَن تَنأى بِنائِلَةَ النَوى","وَهَل يَنفَعَنّي قُربُها لَو تَقَرَّبُ",7,"ب",1,0],["أَشَوقاً وَلَمّا يَمضِ لي غَيرُ لَيلَةٍ","رُوَيدَ الهَوى حَتّى تَغِبَّ لَيالِيا",8,"ي",2,0],["أَشوَسَ في مَجلِسِهِ","يُجثى لَهُ بِالرُكَبِ",9,"ب",1,0],["أشوه وَجهاً طالَما بجماله","فتنت عيوناً نحو وجهك تنظر",10,"ر",1,0],["أشَوْقيِ وأنت طَبيبُ النُّفوسِ","وَضَعْت عن النفس آصارَها",11,"ر",3,0],["أشوامخُ الأحلامِ والمثلُ","الرفيعةُ كالهباءْ؟",12,"ا",2,0],["أشواقها ستظل في قلبي","وإن أوديت حية",13,"ي",2,0],["أَشَوقي لقد نِلتَ ما تَشتَهي","بِفَضلِ أَميرٍ رَفيعِ الذُرا",14,"ر",2,1],["أشْوسُ في مِشْيته تيّاه","يُطاولِ الجوزاءَ مَن مَطَاه",15,"ا",2,0],["أَشوَسُ مِن عِصابَةٍ أَشواسِ","غَيرِ رَعاديدٍ وَلا أَنكاسِ",16,"س",1,0],["أَشَوقاً إِلَيكُم وَاِصطِباراً عَلَيكُمُ","وَسُكنى لَدَيكُم إِنَّهُ لَحَمولُ",17,"ل",1,0],["أشواقُ حبِّ اللَه ما أُخمدت","من قلب أم الخالق المرشدِ",18,"د",1,1],["أشوّقك العرارُ لأرض نجدٍ","ولا شيحاً شَمِمْتَ ولا عرارا",19,"ر",2,0],["أشوقاً ومَن تَهوى خليُّ الجوانِح","لك اللّهُ مِن وافي الأمانةِ ناصحِ",20,"ح",1,1],["أشوقاً إلى نجدٍ ودون لقائها","أهاويل يخشى قطعها وبسابس",21,"س",1,0],["أَشوسَ عَن سِفارَةِ السَفيرِ","سُرتُ إِلَيهِ في أَعالي السورِ",22,"ر",1,0],["أشوقُ إلى تلك الدِّيار وذكرِها","على بُعدها شوقَ الغريبِ المسافرِ",23,"ر",1,0],["أَشوَسُ ضِرغامةٌ وأورَّثَهُ","إِرْثَ المعالي ضراغمٌ شُوسُ",24,"س",1,0],["أَشْوَاقُهُ جَيَّاشَةٌ","إِلَى العُلا إِلَى الرُّقِي",25,"ق",2,0],["أَشواقُنا ما بَيننا مقسومة","فَالكلُّ يصبحُ شائقاٌ ومشوقا",26,"ق",2,0],["أَشْوَس أَبّاءً وَعَضْباً باتِرا","إِذا اسْتَجاشَ الطَبْخَ غَلْياً آفِرا",27,"ر",2,0],["أشوف كِلَّ الناس بالعين دونه","يا ليتني للزين من بعض لارْزاقْ",28,"ق",1,0],["أَشواهد الإِحسان إِنّي شاهد","لكم بِقَلب في اليقين مقدس",29,"س",1,0],["أَشواطِئَ الإٍسكَندَرِيَّةِ طيبٌ","فيكَ المصيف لعاشق ولهان",30,"ن",1,1],["أشوقا ولَمّا يسلُكِ البَينُ مسلَكاً","فما أنت ان شقّت عصا البين فاعل",31,"ل",1,1],["أشوس الطرف عرته نخوة","فتهادى كالغزال الخرق",32,"ق",1,0],["أشوفاً لأهلي وأوطانيه","ووجداً لقومي وجيرانيه",33,"ي",2,1],["أَشوق الى الَّذي مثّلت مِنهُ","مثالاً لَيسَ من ماءِ وطينِ",34,"ن",1,0],["أشوال تريه عجاب أمرٍ","بشهرك هلَّ عيد ثم عيد",35,"د",1,0],["أَشَوقاً وَلَمّا تَمضِ بي غَيرُ لَيلَةٍ","فَكيفَ إِذا سارَ المَطيُّ بِنا عَشرا",36,"ر",2,1],["أشوقا ولما يمض لي غير ليلةٍ","رويد الهوى حتى يغيب لياليا",37,"ي",2,0],["أشوقهم إليك بطيب مدح","واحملهم على شد الرحال",38,"ل",1,0],["أَشواقُه تبقى وَيَفنى صَبرُه","وَتظل حالتُه تَبوحُ بشَأنه",39,"ن",2,0],["أَشوسُ يُنضو الدرعَ عَن مَنكِبٍ","مِثلَ سِنانِ الرُمحِ شَعشاعِ",40,"ع",1,0],["أشوقي هذا النيل بعدك قد جرى","لينعاك بحرا بالبلاغة طاميا",41,"ي",2,0],["أَشواقيَ جَدَّ جدُّها تَلعَبُ بي","إِذ أَيديهنَّ بِالمَلاهي عبثَت",42,"ت",1,0],["أَشوفُ مُقَلَّدا سَبطا","وَأَرشُفُ بارِداً شَبما",43,"م",2,0],["اشوف واعرف يا بناتي غلابه","والناس ضعفٍ تحت رب العبادي",44,"د",2,0],["اشوف حبي في عيونك تملكّ","وانا لغيرك صرت بالحب مملوك",45,"ك",1,1],["اشواقنا ما بيننا باي تثمين","والوصل غالي والغلا باب الاسرار",46,"ر",1,0],["اشوف انا اسمك دايم الدوم واقراه","والضاهر انه تاه واخطى مسيري",47,"ر",2,0],["اشوف انا للموت صفّو طوابير","وانا انتظر دوري وطبعة قراري",48,"ر",2,0],["اشوف عداد التنازل بنا عد","مد النظر يالادمي فيه مده",49,"د",2,1],["اشوف كلٍ تعراء ماتفيد الهدوم","وتهنا وضعنا مابين المعركه والسلام",50,"م",1,0],["اشوف ناسٍ لرديله توجّه","واشوف ناسٍ للوفى تلبس التاج",51,"ج",1,0],["اشوف انه علي واجب ليا مريتكم سلمت","مرور اكرام تربطه الكرامه عند الاكرامي",52,"م",2,0],["أشواقنا لم تزل. طفلا على يده","ألعابه تحفل. الدنيا. بما. فيها",53,"ي",3,0],["اشوف الغاليه بيت السعاده","وانا يمناي تمد صوب بابه",54,"ب",2,0],["أشوف وأحب لكن عقب شوفي لك","لقيتك الهاجس اللي مشغلٍ بالي",55,"ل",2,0],["أشوفه وهو جنبي من الشوق راح بعيد","عليه العيون وكل 