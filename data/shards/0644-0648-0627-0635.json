{"poems":[[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[37,"حبال سجيفة أمست رثاثا","https://www.aldiwan.net/poem39175.html","المتقارب"],[53,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85502","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[302,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[406,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[580,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48824","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38380","الطويل"],[863,"","https://poetry.dctabudhabi.ae/diwan/poem/116086","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70857","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109195","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32583","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94312","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113850","البسيط"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79698","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5274,"حكمةُ الأجداد","https://www.poetsgate.com/ViewPoem.aspx?id=203266",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["لَو أَصابوا لَهُم مَجالاً لَأَبدَوا","مُعجِزاتِ الذَكاءِ في كُلِّ قَصدِ",0,"د",1,0],["لَواصِبَ قَد أَصبَحَت وَاِنطَوَت","وَقَد أَطوَلَ الحَيُّ عَنها لِباثا",1,"ث",2,0],["لو أصبح السادات مثلك سؤدداً","وَفت العِداتُ وأخلف الإيعادُ",2,"د",1,0],["لو أصابا إلى الغِلاط سبيلاً","غالطا الحاسبين في الحُسْبان",3,"ن",1,0],["لَو أَصابَت غَيرَ ذي روحٍ لَما","سَلِمَت مِنها الثُرَيّا وَسُهاها",4,"ا",3,0],["لَو أَصَخنا مِن بَعدِها لَسَمِعنا","لِقُلوبِ الأَيّامِ مِنكَ وَجيبا",5,"ب",2,0],["لو أصْحرُوا في فضاءٍ من صُدورهِمُ","سَدّوا عليكَ فُروجَ البِيدِ بالبِيد",6,"د",1,0],["لَو أَصلح البشر الأنسال مهتدياً","بالعلم يوما لرقَّى نوعَه البشر",7,"ر",1,0],["لو أصابَتْ ريشتيها وثَبتْ","بجناحين من الشَّوق القديمْ",8,"م",1,0],["لو أصابوا حكمةً ما اتَّهموا","وبكى لاحيكَ والمسْتهجنُ",8,"ن",1,0],["لو أصابتكِ مسّةُ الريحِ ثارت","بفؤادي عواصفٌ ليس تَهْدا",9,"د",2,0],["لَو أصَابَ الجِبَالَ بَعضَ الذي أَل","قاهُ مِن حُبِّهَا لَهَدَّ الجِبَالا",10,"ل",2,0],["لَو أَصحَروا لَم تَحوِ أَنطاكِيَّةٌ","إِلّا أَرامِلَ تَكفُلُ الأَيتاما",11,"م",2,0],["لو أَصاخوا للمُعَنّى ساعةً","يَشرح الوَجدَ وهل لِلوَجدِ شَرحُ",12,"ح",1,0],["لو أصَخْنا سمعاً إليها رهيفاً","لسمعنا نداءها: أنقذوني",13,"ن",2,0],["لو أَصبح المشتَرِي يُعانده","لحطَّه عن مكانِه الشَّاهِقْ",14,"ق",1,0],["لو أصاب الرجال لاتفق الحا","كم في الطيبات والمحكوم",15,"م",1,0],["لو أصابوا لتابعوك وقد أع","رض عنهم شفيعهم وتخلى",16,"ل",2,0],["لَوِ اِصطَفَّ أَلفٌ واحداً خَلفَ واحِدٍ","وَأَفلَتَ ذاكَ الرّمح لَيسَ بِراحِمِ",17,"م",1,0],["لو أصابُوا الرَّشَادَ عندَ ابتِدَاءٍ","كانَت الغَايةُ الجَمِيلةُ أَمثَل",18,"ل",1,0],["لو أصاب العذولَ معشار ما قا","ساه قلبي من الصبابة كافِ",19,"ف",1,0],["لو أصاب الغرام بعض الذي","ألقاه باد الهوى ومات الغرام",20,"م",1,0],["لو أصبحت علماءُ الأرض واردةً","منه لما رغبت منه إلى الصدرِ",21,"ر",1,0],["لو أصلَحوا شأنَ الحياةِ ومبا","دىءَ الفضيلةِ وشَدّوا ما وَهى",22,"ا",1,0],["لَو أَصبَحَت عِندَنا جَنازَتُها","لَحُنِّطَت وَاِشتَرى لَها كَفَنا",23,"ن",2,0],["لو أصاب الجبال وجدى الذي بي","كان للصخر وهو صلد مذيبا",24,"ب",2,0],["لو أصابتك قطرة من نداه","لتخلصت من كفاف الكفاف",25,"ف",1,0],["لو أصبح الملك العباس منتخبا","حبرا إليه نظام الملك يحتاج",26,"ج",1,1],["لو أصابوا لعظموك على الرق","ق وأولوا يمينك التقبيلا",27,"ل",2,0],["لَو أَصابوا الرَشاد عاشوا عزازاً","لَم تهدّر نُفوسهم أَو تُقَتّل",28,"ل",1,0],["لو أصاب الجميع منه مناهم","لم تجد غير سيد ونبيه",29,"ي",2,0],["لو أصبَحَ الشّعْرُ يا رمْلَ المُنى مطراً","لما بكتْ مِنْ أسَى أوجَاعِنا الحَدَقُ",30,"ق",1,0],["لو إصبعٌ تمتدُّ لو","عينٌ يلوحُ بها العِتابُ",31,"ب",1,0],["لَوْ أَصْبَحَتْ كُلّ السهوب صَحَائِفاً","أَوْ حُبِّرَتْ باللّجْة الأقلامُ",32,"م",1,0],["لو أصلحوه بما يليق بمثله","لطغى على كلّ البلاد كماله",33,"ل",2,0]]}