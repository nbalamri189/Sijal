{"poems":[[90,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[64,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[63,"قل للأمير الماجد السامى","https://www.aldiwan.net/poem51822.html","مجزوء الكامل"],[60,"لا تطلبن معيشة بمذلة","https://www.aldiwan.net/poem31132.html","الكامل"],[51,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[68,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[48,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[48,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[78,"قل ما بدا لك وافعل","https://www.aldiwan.net/poem39011.html","مجزوء الكامل"],[14,"","https://poetry.dctabudhabi.ae/diwan/poem/2187","الكامل"],[132,"وعليك نفسك لا تعب أحدا ولا","https://www.aldiwan.net/poem50568.html","الكامل"],[154,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[190,"لمت الغواني في العدو","https://www.aldiwan.net/poem43441.html","مجزوء الكامل"],[220,"أجُبيل إن أباك كاربُ يومه","https://www.aldiwan.net/poem683.html",""],[242,"لذ بالذي يشكيك إن تشكو","https://www.aldiwan.net/poem18846.html","الكامل"],[242,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[321,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[371,"وإذا أفاض الصب صب دموعه","https://www.aldiwan.net/poem17092.html","الطويل"],[411,"وإذا غنيت فلا تكن بطرا","https://www.aldiwan.net/poem49586.html","أحذ الكامل"],[412,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[422,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[556,"قل لمشغوف بعذلي","https://www.aldiwan.net/poem47886.html","مجزوء الرمل"],[558,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[567,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[572,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[572,"وإذا افتخرت بأعظم مقبورة","https://www.aldiwan.net/poem69582.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112434","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101990","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49566","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202172","الكامل"],[2350,"","https://poetry.dctabudhabi.ae/diwan/poem/147620","الخفيف"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133974","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112512","الكامل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113896","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87567","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216766",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[4929,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=199259",""],[5038,"خصومة الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=190124",""],[585,"لمع اللجين وسال ذوب العسجد","https://www.poetsgate.com/ViewPoem.aspx?id=161875",""],[5338,"لي في هباتك حيرة لا توصف","https://www.poetsgate.com/ViewPoem.aspx?id=187913",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5909,"يا رقّة الرؤيا التي آنستها","https://www.poetsgate.com/ViewPoem.aspx?id=210227",""],[6304,"مهلا ضفاف الرافدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1612&r=&rc=2",""]],"verses":[["وإذا أفَضْتم في المباح","من الحديث فجَمجموا",0,"م",3,0],["وَإِذا اِفتَقَرتَ إِلى الذَخائِرِ لَم تَجِد","ذُخراً يَكونُ كَصالِحِ الأَعمالِ",1,"ل",1,0],["وإِذا افتكرتُ أضاء فكريَ إنَّما","عُسْرُ الزمانِ ويُسْرُهُ سِيَّانِ",2,"ن",1,0],["وَإذَا أَفَادَ صَنِيعَةً","بَقِيَتْ بِطُولِ بَقَائِهِ",3,"ا",3,0],["وِإِذا اِفتَقَرتَ فَداوِ فَقرَكَ بِالغِنى","عَن كُلِّ ذي دَنَسٍ كَجِلدِ الأَجرَبِ",4,"ب",1,0],["وَإِذا أَفنى سِنيهِ ال","مَرءُ أَفنَتهُ سِنونُ",5,"و",2,0],["وَإِذا أَفاضَ البَحثَ ساقَطَ لَفظُهُ","دُرَراً تُنَزِّهُها عَنِ الأَصدافِ",6,"ف",1,0],["وَإِذا اِفتَقَرَت فَلا تَهُن","وَإِذا غُنيتَ فَلا تَجَبَّر",7,"ر",1,0],["وَإِذا اِفتَكَرتَ فَما يَهيجُ تَفَكُّري","فيما أُكابِدُ غَيرَ لَومِ الناجِلِ",8,"ل",1,0],["وإذا افْتقرتَ فلا تَكُنْ","مُتخشِّعاً وتجمَّلِ",9,"ل",1,0],["وَإِذا اِفتَقَرتُ فَلَن أَرى مُتَخَشِّعاً","لِأَخي غِنىً مَعروفُهُ مَكدودُ",10,"د",1,0],["وإذا افترى خبراً لثيمٌ سجَّلوا","هذا يدحرجه وهذا بَنْدفُ",11,"ف",1,0],["وإذا افتقرت إلى سواه فإنما","ألوى بخاطرك الطريق الأبعد",12,"د",1,0],["وإذا أفاض إلى الذبو","ل ذوى فألقيَ في المزابل",13,"ل",1,0],["وَإِذا اِفتَقَرتَ فَلا تَكُن مُتَخَشِّعاً","تَرجو الفَواضِلَ عِندَ غَيرِ المُفضِلِ",14,"ل",1,0],["وَإِذَا افْتَقَرْتَ فَلاَ تَحُمْ أَبَداً","حَوْلَ الذِي بِقَضَائِهِ يَشْكُو",15,"ك",2,0],["وَإِذَا افْتَقَرْتَ فَلاَ تَكُنْ مُتَخَشَّعاً","وَصُنِ امْتِهَانَكَ بِالْوَقَارِ وَغَشِّهِ",16,"ش",2,0],["وإذا أفاق ذوو المصائب سلوة","وتصبروا أمسيت غير مفيق",17,"ق",1,0],["وَإِذا أَفاضَ الصَبُّ صَبَّ دُموعِهِ","أَغنى الدِيارَ عَنِ الحَيا المُتَهَلِّلِ",18,"ل",1,1],["وإذا افتقرْتَ فلا تَكُنْ جَزِعاً","فوراءَ كُلِّ دُجُنَّةٍ فَجْرُ",19,"ر",1,0],["وَإِذا أَفات أَفاد في طَلَبِ العُلى","فَالفَضلُ بَينَ يَقينِهِ وَمفيده",20,"د",2,0],["وإذا أفادك جاهُه أو ماله","فهناك عِزٌّ يستفاد وسؤدد",21,"د",1,0],["وإذا أفرغتْ كنانة فخرٍ","ساعةَ الأذنِ أو غداة السلامِ",22,"م",1,0],["وإذا أفنَى العِبَاد","بعضُهُم بَعضاً وَبَادُوا",23,"د",3,0],["وَإِذا أَفلحتَ فَاِترُكْ","للورى غيرَ الفلاحِ",24,"ح",1,0],["وَإِذا اِفتَخَرتُ عَدَدتُ سَعيَ مَآثِرٍ","قَصَرَت عَلى الإِغضاءِ طَرَفَ الأَشوَسِ",25,"س",1,0],["وإذا افتَرَضناهُ حديثاً باطلاً","ضَبَطوهُ نقلاً كالطِّرازِ المُعَلَمِ",26,"م",1,0],["وَإِذَا افْتِتَاحُ الأَمْرِ رَاقَكِ حُسْنُهُ","فَتَبَيَّنِي مَاذَا تَكُونُ الخَاتِمَهْ",27,"م",2,0],["وَإِذَا افْتَخَرْتَ بِأَعْظُمٍ مَقْبُورَةٍ","فَالنًّاسُ بَيْنَ مُكَذِّبٍ وَمُصَدِّقِ",28,"ق",1,1],["وإذا افتقرت إلى جليل مواعظ","حتى تكون بها سعيدا سائدا",29,"د",2,0],["وإذا أفقت من الكرى فسأغتدي","كفراشة حول السراج المولع",30,"ع",1,0],["وإذا أفتت الأنام وأفتى","حكمه دون حكمهم مسموع",31,"ع",1,0],["وإذا افترقنا لم يزلْ ما بيننا","أَرِجَ المهبِّ مُعَطَّرَ الأنفاس",32,"س",1,0],["وإِذا أَفاضا في البيان وأَعْربا","نُطْقاً فَسُحْبانُ الفَصاحةِ مُفْحَمُ",33,"م",1,0],["وإذا افتر ثغره عن سوادٍ","في بياضٍ فالبيض والسمر خجلى",34,"ل",2,0],["وِإِذا اِفتَخَرتَ بِمُنقِذٍ أَو فَقعَسٍ","مَدَّت لِأَبحُرِهِم بُحورٌ تَزخَرُ",35,"ر",1,0],["وإذا أفسدت مطامعُ لبا","أوردته موارد الأمراض",36,"ض",1,0],["وإذا افتقرت وجدت رحمتها","قد أمطرتني اليسر والنعما",37,"م",2,0],["وإذا أفاض العاذلون بإفكهم","في قولهم دع نصحهم ليفيقوا",38,"ق",3,0],["واذا اِفتَرَضنا ليس من جَذبٍ فَلا","دَفعٌ وذلك مؤذِنٌ بِبَقاءِ",39,"ا",2,0],["واذا افاقَ الوجدُ وأَندَمَلَ الهَوى","رأَتِ القلوبُ ولم ترَ الأَحدَاقُ",40,"ق",1,0],["وإذا افتقرت إليهمُ","فاللوم من لغو الكلام",41,"م",1,0],["وإذا افتقرت إلى السؤال وشبهه","فاختر لنفسك ذا مكارم واسأل",42,"ل",1,0],["وإذا أَفْلَتَّ فلن تنجو","ممن جعلوا دمّكَ هدرَا",43,"ر",2,0],["وَإِذا أَفْرَحَ قَلْباً زادَ في الدُّنْيا أَسايا","عَجَباً يَسْقي أَبابيلَ الْهَوى خَمْراً وَمايا",44,"ا",3,0],["وإذا افتقدت الجلنار أصبته","جذلان يضحك من صياح الجدجد",45,"د",1,0],["وإذَا افْتَقَرْتُ فأَنْتَ مُدْرِكُ فَاقَتي","وإذَا عَجِزْتُ عَنِ الأُمورِ فَمُسْعِفُ",46,"ف",1,0],["وَإِذَا أَفَاضَ الْمُسْتَهَامُ بَِزَيْنَبٍ","أَوْ حُبِّ لَيْلَىٰ وَالرَّبَابِ تَغَزُّلَا",47,"ل",2,0],["وَإِذا افْتَرَّتْ رأَيْتُ ال","دُّرَّ مَحْكُومَ النِّظامِ",48,"م",1,0],["وإذا أفقت وددت أني مبقها","محشورةً عندي بكأس الصفوِ",49,"و",1,0],["وإذا افتقدناه شُموخاً صاعداً","تَنحط ٌ دون سمائِهِ الأسماء",50,"ا",2,0]]}