","https://www.poetsgate.com/ViewPoem.aspx?id=199646",""],[5324,"ندم الإنسان.","https://www.poetsgate.com/ViewPoem.aspx?id=211750",""],[5369,"أمامنا سفر طويل","https://www.poetsgate.com/ViewPoem.aspx?id=177443",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5922,"فلم الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=185134",""],[5937,"مَن نحن !","https://www.poetsgate.com/ViewPoem.aspx?id=211888",""],[5943,"كفكف دموعكَ","https://www.poetsgate.com/ViewPoem.aspx?id=11276",""],[5943,"بشذا الورودِ ندى تفوحْ","https://www.poetsgate.com/ViewPoem.aspx?id=60770",""],[5956,"قرُبَ الوداعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193570",""],[6096,"عماء .. لكني أرى","https://www.poetsgate.com/ViewPoem.aspx?id=177111",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[6225,"شراع وريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80914&r=&rc=183",""],[4035,"أغارَ الحُسنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1522&r=&rc=5",""],[6243,"موحَش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84432&r=&rc=6",""],[6290,"بِكُلِّ بَلِيَّةٍ يَزْداَدُ سِنِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85161&r=&rc=9",""],[6320,"سَهْمُ العَنَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84366&r=&rc=63",""],[5190,"مسافر من زمان العولمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78311&r=&rc=24",""]],"verses":[["فَلَم أَلقَ إِلّا ماذِقَ الوُدِّ كاذِباً","يَسُفُّ بِهِ مِن طائِرِ الغَدرِ واقِعُ",0,"ع",1,0],["فَلَمّا لَعِبنا وَطابَت لَنا","وَفازَ بِأَطيَبِها الغالِبونا",1,"ن",2,0],["فَلَمّا لَم أَجِد سَبَباً إِلَيها","يُقَرِّبُني وَأَعيَتني الأُمورُ",2,"ر",1,0],["فَلَما لَحِقنا بِالحُدوجِ وَقَد عَلَت","حَماطاً وَحِرباءَ الفَلا مُتَشاوِسُ",3,"س",1,0],["فَلَما لَبِسنَ اللَيلَ أَو حينَ نَصَّبَت","لَهُ مِن خَذا آذانِها وَهوَ جانِحُ",4,"ح",1,0],["فَلَمّا لَحَقناهُنَّ أَبدَينَ صَبوَةً","وَهُنَّ يُحاذِرنَ الغَيورَ مِنَ الأَهلِ",5,"ل",1,0],["فَلَمّا لَم تَجِد طَمَعاً تَوَلَّت","وَقالَت فِيَّ عاتِبَةً وَقُلنَه",6,"ن",2,0],["فَلَمّا لاحَ بَعدَ الأَينِ سَلعٌ","ذَكَرتُ مَنازِلي وَعَرَفتُ داري",7,"ر",2,0],["فلم ألقَ فيه مُستراحاً لمُتعَبٍ","ولا نُزُلاً أيانَ ذاك لساغِبِ",8,"ب",1,0],["فَلَمّا لَواهُ القوتُ مِن حَيثُ أَمَّهُ","دَعا فَأَجابَتهُ نَظائِرُ نُحَّلُ",9,"ل",1,0],["فَلَمّا لَحِقنا وَاِزدَهَتنا بَشاشَةٌ","لِإِتيانِ مَن كُنّا نَوَدُّ وَنَمدَحُ",10,"ح",1,0],["فلم التغطرس والغرو","ر ألست تذكر مبتداك",11,"ك",1,0],["فَلَمّا لِلصَلاةِ دَعا المُنادي","نَهَضتُ وَكُنتُ مِنها في غِرورِ",12,"ر",1,0],["فَلَم أَلِج غَيرَ داري","وَلَم أَزُر غَيرَ نَفسي",13,"س",2,0],["فَلِمَ الرجفةُ التي في دمائي","ولم الرعدةُ التي في كياني",14,"ن",2,0],["فلمّا لم يجدْ فيها علاجاً","أقامَ محَيَّراً بين الجفونِ",15,"ن",1,0],["فَلَم أَلقَ إِلّا صَعدَةً فَوقَ لامَةٍ","فَقُلتُ قَضيبٌ قَد أَطَلَّ عَلى نَهرِ",16,"ر",1,0],["فلما لَقُوكم قال صاحبُ أمرِهم","هُوَ الحقُّ مَن يُؤثِرْهُ يَرشَدْ ويهتدِ",17,"د",1,0],["فَلَمّا لَم تَدع قَوساً وَنبلاً","مَشَينا النِصفَ ثُم مَشَوا إِلينا",18,"ن",2,0],["فَلَمّا لاحَ لِلساري سَهيلٌ","قُبَيلَ الصُبحِ مِن وَقتِ الغَداةِ",19,"ه",1,0],["فلِمَ الأير خفيفٌ","فإذا قامَ ثقل",20,"ل",1,0],["فَلَمّا لَم أَنَل حَظّاً","بِما رُحتُ وَغادَيتُ",21,"ت",1,0],["فَلَمّا لَم أَنَل حَظّاً","بِما كَدَّرتِ مِن شِربي",22,"ب",2,0],["فَلمَّا لَقَيْناهُمْ وكلٌّ مُجَاهدٌ","لأصْحَابِهِ مُسْتَبْسِلُ النّفْسِ صَابِرُ",23,"ر",1,0],["فلم ألف من خيرٍ ونُصح مُعوِّضاً","لأحمدَ عن شَرٍّ وغدرٍ جوازيا",24,"ي",2,0],["فَلَمَّا کلْتَقَيْنا، شَفَّ بُرْدٌ مُحَقَّقٌ","عَنِ الشَّمْسِ، جَلَّى يَوْمَ دَجْنٍ غَمامُها",25,"م",3,0],["فَلَمَّا کلْتَقَيْنا سَلَّمَتْ، وَتَبَسَّمَتْ،","وقالت كقول المعرضِ المتجنبِ:",26,"ب",1,0],["فَلَمَا کلْتَقَيْنَا بِکلثَّنْيَّة ِ سَلَّمَتْ","وَنَازَعَني البَغْلُ اللَّعينُ عِناني",27,"ن",2,0],["فَلَمَّا کلْتَقَيْنَا، وکطْمَأَنَّتْ بِنَا النَّوَى ،","وغيبَ عنا من نخافُ ونشفقُ",28,"ق",1,1],["فِلمَ البِعادُ وأنتَ ذُو","خيرٍ وما هذا الشفَاءُ",29,"ا",2,0],["فلم التمرُّدُ والعِراك","ما سُورُ جسمي بالمَتين",30,"ن",1,0],["فَلَم أَلقَ مِنهُم يَومَ نَحسٍ وَلَم أَبِت","أُحاذِرُ مِنهُم جانِياً أَو مُواثِبا",31,"ب",2,0],["فلم ألف من يصفي الوداد ولم أجد","أخا ثقة في شدّة ونعيم",32,"م",1,0],["فلمَ التخاذلُ والعروبةُ أُمُّنا","ولمَ الشقاقُ ونحنُ من عدنانِ",33,"ن",1,0],["فلما لم يجد في الحب صبراً","ولم ترحم جوانحه السجون",34,"ن",1,0],["فلما لم يجد في الحب صبراً","ولم ترحم جوانحهَ الشجون",35,"ن",1,0],["فلمّا لَمْ يساعِد","هنّ لِلتودِيعِ إِمكان",36,"ن",1,0],["فَلَم أَلقَ مِنهُ البِشرَ فَضلاً عَنِ النَدى","وَيا رُبَّ مَدحٍ صارَ داعِيَةَ الذَمِّ",37,"م",1,0],["فلم ألفهم في حادث وملمة","مع الدهر والأيام عغير عواتب",38,"ب",1,0],["فَلَم أَلقَ لي مِن صاحِبٍ غَيرَ حاصِبٍ","وَلَم أَرَ في الإِخوانِ لي غَيرَ خَوّانِ",39,"ن",1,0],["فلم النبيء بصحبه","خاض الحروب ولم هجر",40,"ر",1,0],["فَلِمَ التَكَتُّمُ أَيُّها المُشتاقُ","لا تَخَف ما صَنَعَت بِكَ الأَشواقُ",41,"ق",1,0],["فلَم أَلْقَ من نظم القريض سوى عناً","وشُغْلة أوقاتٍ وطول سهادِ",42,"د",1,0],["فلم ألق جاهلاً متصوفاً","يرى أن أهل الأرض من خدم الشِّسع",43,"ع",1,0],["فلم ألمه بحرف","لفرط شوقي اليه",44,"ي",2,0],["فلم ألقَ لي إِلاّ السلام تَعلّةً","بعثت به يذكو لديه عطيرُه",45,"ر",2,0],["فَلَمّا لَم يَكُن مِنكَ اِعتِذارٌ","أَسَمتُ القَلبَ في مَرعى العَزاءِ",46,"ا",2,0],["فلما لبسناها وهمنا بحبها","تركنا لها الأوطان والمال والأهلا",47,"ل",2,0],["فلم الحسود السم ينفث في الذي","كالشمس في آفاق آداب بدا",48,"د",2,0],["فلم ألف إلفي عند غير تألفي","وقد فاء في التأليف عن إلف ألفة",49,"ه",1,0],["فلم التقاطع وابن عمكما الفتى","قد اثقلت كتفاه بالأرزاء",50,"ا",2,0],["فلمّا لبستَ الفضلَ لي لبسَ فاضلٍ","يرى لبسَ ثوبِ الفضلِ من أفضلِ اللبس",51,"س",1,0],["فَلَمّا لَواني يَستَثيبُ زَجَرتُهُ","وَقُلتُ اِغتَرِف إِنّا كِلانا عَلى بَحرِ",52,"ر",1,0],["فلمَ القواصر يدّعون حرفتي","واشلهم وافى لبابي يطرقُ",53,"ق",1,0],["فلَمْ أُلَبِّ الهَوى لَمّا دَعا عَجِلاً","حَتّى دَعَوْتُ الضَّنى غَضْاً فَلَبّاني",54,"ن",2,0],["فلم ألقَ من البعض اهتماما","فزاد العسر من عسري ليسري",55,"ر",2,0],["فلم أَلقَ في النّاس إلا خَؤوناً","وإلا حسوداً وإلا مَلولا",56,"ل",2,0],["فلَمّا لَقيناهُم بِسُمرِ رُدَينَةٍ","وَجُردٍ عِتاقٍ في العَجاجِ لَواهِثِ",57,"ث",1,0],["فلم ألفها لما مضت وعددتها","بحسبتها في الدهر إلا لياليا",58,"ي",2,0],["فلما لم ينالوا ما تمنوا","وصاروا للتغيُّظ كاظمينا",59,"ن",2,0],["فلم الكبرياء بين أناس","تركتهم حوادث الدهر عزلا",60,"ل",2,0],["فَلَمّا لَم أَجِد شَيئاً نَفيساً","يَكونُ هَدِيَّةً أَهدَيتُ نَفسي",61,"ي",1,0],["فلم القه إلا كزرق نواظر","يلاحظني شزراً كمن يرتجي هلكي",62,"ك",2,0],["فلما لم يجبه دعاه حباً","ووجداَ دائماً أخرى الليالي",63,"ل",2,0],["فَلِمَ المَلاَمَةُ إذ عَزَلنَاهَا وَوَلَّ","ينَا العُقُولَ وَفِكرَةَ الأذهَانِ",64,"ن",1,0],["فَلَمّا لَحِقنا لَم يَقُل ذو لُبانَةٍ","لَهُنَّ وَلا ذو حاجَةٍ ما تَيَمَّما",65,"م",2,0],["فَلمّا لَوينَ عَلى مِعصَمٍ","وَكفٍّ خَضيبٍ وإِسوارِها",66,"ر",3,1],["فلم ألق مالاً ضاع منّيَ وحده","ولكنني لاقيتُ مالاً وإيمانا",67,"ن",2,0],["فلم ألمه سوى أن قلت من جزع","الموعد الحشر والقاضي هو الله",68,"ه",1,0],["فلم ألفظك من شبع ولكن","لأقضي حاجة النفس الشعاع",69,"ع",1,0],["فلما لم يدع في الأرض قرناً","تخوله فعاجله الحمام",70,"م",1,0],["فلما لم يطق نهضاً أتته","فقال لها أنا ذاك الطعام",70,"م",1,0],["فَلَمّا لَم يَرَينَ كَثيرَ ذُعرٍ","وَرَدنَ صَوادِياً وَرداً كَمِيّا",71,"ي",2,0],["فلمّا لم يدعْ رُمحاً طويلاً","يُقصِّدُهُ ولا سيفاً نَحيلا",72,"ل",2,0],["فلم ألق من يولي الجميل وطالما","بحثت فلم ألق الصديق المجاملا",73,"ل",2,0],["فلِمَ النّظْمُ يا إمامَ البَرايا","أصْمَتَ النُّطْقَ منْ يَدَيْكَ النّوالُ",74,"ل",1,0],["فلمّا لحقْناهمْ شددْنا ولمْ يكنْ","كِلامٌ وجرَّدْنا الصَّفيحَ اليَمانيا",75,"ي",2,0],["فَلم أَلقَ إِلا أُمّة بَعد أُمّة","تَودّ عماراً في ديار خَراب",76,"ب",1,0],["فلما لم يجد للعين سبلاً","توخّى مهبطاً بِحِمى فؤادي",77,"د",2,0],["فَلَمّا لَم نُطِق فيهِ كَلاماً","تَكَلَّمَتِ العُيونُ عَنِ القُلوبِ",78,"ب",1,0],["فلم ألق إلا خدعة بعد خدعة","ولم ألق إلار ما يشق مرارتي",79,"ت",2,0],["فَلَم أَلقَ إِلّا صَديقاً يَجودُ","بِطيبِ الكَلامِ وَحُسنِ السَلامِ",80,"م",1,0],["فلما لحقناهم قرأنا عليهم","تحيّةَ موسى رَبّه أن يجاوِرُه",81,"ر",2,1],["فَلِمَ التَّخَلُّفُ رِعدَةً لِسِواكُما","والقَومُ خِرصانَ العَوامِلِ قَوَّمُوا",82,"م",3,0],["فَلَم أَلُم يَحيى عَلى فِعلِهِ","وَلَم أَقُل مَلَّ وَلا ضَيَّعا",83,"ع",2,0],["فَلَم أَلقَ مَن يُصغي لِشَكوى مُتَيم","وَلَم أَرَ ما يُجدي لِدَفعِ النَوائِب",84,"ب",1,0],["فلم آل جهدا في ربيع ومنهل","فذاك نضير حيث ذاك خريص",85,"ص",1,0],["فَلِمَ المُحِبّ يُجُبّ قَلبَ مُحِبِّهِ","وَيَريشُ مِن نَبعِ القَطيعَةِ أَسهُما",86,"م",2,0],["فلم ألف من هذي الرئاسة راحة","وما ازددت إلا بؤس عيش مواثبي",87,"ب",2,0],["فلما لقيناهم بها مستفيضة","وقد جعلوا يسمون فعل المساهم",88,"م",1,0],["فلم ألق في شطّها رأفةً","وأضحى يشابهُ نكرانَها",89,"ن",3,0],["فلم ألق الجنان َ ولم تزرني","كفوفكِ كي تناولني ضمادة",90,"د",2,0],["فَلم أُلْفِ حُجّاباً ولم أخشَ مَنْعَهُ","ولو كان سُؤلي فوق هامِ الكواكبِ",91,"ب",1,0],["فلم اليأس أخي هل حزننا","غير مَجد صبْرُنا كان بناه",92,"ن",3,0],["فلِمَ العاقلُ مُحتارٌ ولا يَدري صَوابَه!","أتَرى كيفَ نَلوك العُمرَ بؤساً ورَتابَه؟!",93,"ب",2,0],["فلمَ الحوار?لمَ الحوار? مع الذي","جعلَ السعيدةَ تكتسي ثوب الدمارْ.",94,"ر",1,0],["فلم التكبّر يا ابن آدم إنها","دنيا كما نقدٍ بغير رواج",95,"ج",1,0],["فلمَ الهروبُ وقد قتلتُ قصيدتي..؟!!","ونحرتُ قافيتي بِعِيدِ غيابِها",96,"ب",3,0],["فَلِمَ الرجوع إلى الحكايا","منا انتشتْ يوم انتشينا",97,"ن",2,0],["فَلِمَ الْهَجْرُ تَمَاْدَتْ مِلْؤُنَاْ أَيَّاْمُهُ دَمْ","عَاً وَأَعْذَاْرَاً وَكِبْرَاً وَعِنَاْدَاً وَغَرَاْرَاْ",98,"ر",2,0],["فَلِمَ التَّجَنِّي وَالْمَنَامُ يَهِدُّنِي","وَكَذَا تَهِيِجُ بِقَلْبِيَ الآهَاتُ",99,"ت",1,0],["فَلِمَ التَّبَاعد وَالْحَيَاةُ خَلِيَّةٌ","لَوْلَا التَّقَارُب مَا احتَوَتْنَا الدَّانِيَةْ",100,"ي",2,0],["فلمَ التساؤلُ عن غموضٍ بَيِّنٍ","وغموضُ معناكِ البيانُ المُبهمُ",101,"م",1,0],["فَلِمَ الصُّدودُ أيا مُعَذِّبَ مُهْجَتي","وحبالُ صوتي قد أضعنَ صداهُ",102,"ا",2,0],["فَلِمَ الحُزنُ والشُّكوكُ عَلامَ ؟","وحياتي نذرتُها فيكِ نَذْرا",103,"ر",2,0],["فلم الحزن إذا شاء القضاء","كل مافي الكون بدء وانتهاء.",104,"ا",2,0],["فلِمَ التلوّنُ والخداعُ؟","لم الدخولُ على (الفِتن)؟!",105,"ن",1,0],["فَلِمَ الجفاء كأنّني يا مهجتي","لست الذي في المكرمات بسابقِ",106,"ق",1,0],["فَلمَ الدّماءُ ؟ وَهلْ بدين مُسَيْلمهْ","شَرَّعْ