دي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138293",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5081,"فَكُنْ فَيْضَاً مِنَ الْأَشْوَاقِ تُسْقَى","https://www.poetsgate.com/ViewPoem.aspx?id=186273",""],[5135,"ليلُ الهُمُومِ","https://www.poetsgate.com/ViewPoem.aspx?id=201989",""],[5152,"عندي ألف فن","https://www.poetsgate.com/ViewPoem.aspx?id=185862",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5189,"ألاَ يا قلبُ فلتَصبرْ","https://www.poetsgate.com/ViewPoem.aspx?id=191550",""],[5268,"تَحُفُّ بِيَ المَخَاطِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206999",""],[5277,"مناط الحب والسلام","https://www.poetsgate.com/ViewPoem.aspx?id=203323",""],[5370,"البنت ياحبها","https://www.poetsgate.com/ViewPoem.aspx?id=81635",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5442,"فوض أمورك من بين الأنام إلى","https://www.poetsgate.com/ViewPoem.aspx?id=114753",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5704,"خمريات","https://www.poetsgate.com/ViewPoem.aspx?id=196500",""],[5720,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=214737",""],[5725,"أهون الطعنات","https://www.poetsgate.com/ViewPoem.aspx?id=211094",""],[5725,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=211771",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[4623,"تركت الهوى بعد طول امتحان ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146692",""],[5790,"خليل الله قد جئناك نرجو","https://www.poetsgate.com/ViewPoem.aspx?id=111990",""],[5885,"خطوتي","https://www.poetsgate.com/ViewPoem.aspx?id=194732",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6115,"لاتكتلف للي يدور على فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=180476",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[463,"في الظباء الغادين أمسِ غزالُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60186&r=&rc=242",""],[6328,"تاء التأنيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84884&r=&rc=25",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""]],"verses":[["وَقَلى مَجالِسَنا وَمالَ بِهِ","عِطفٌ إِلى البَغضاءِ مُنعَطِفُ",0,"ف",1,0],["وَقَليلٌ أَن لَو بَذَلتُ دِماءَ ال","بُدنِ حُزناً عَلى الذُرى وَسَقَيتُك",1,"ك",1,0],["وقُلْ يا رَسولَ اللّهِ عبْدٌ تقاصَرَتْ","خُطاهُ وأضْحى منْ أحبّتِهِ فرْدا",2,"د",2,0],["وَقَليبٍ أَجنٍ كَأَنَّ مِنَ الري","شِ بِأَرجائِهِ لُقوطَ نِصالِ",3,"ل",1,0],["وَقَليلٌ عِندي لَها نِصفُ جيلٍ","لِمُجِدٍّ مُوَفَّقٍ فَعّالِ",4,"ل",1,0],["وقلّي جي واتعلّم","قلت اهلال راسلني",5,"ي",1,0],["وقليلُ النوال في هذه الحا","لة مما أراهُ شيئاً عجيبا",6,"ب",2,0],["وقليلٌ لوجهك النفثُ منهنْ","ن حقيرٌ أو يتبع النفثَ نهشُ",7,"ش",1,0],["وقليل الرَّينِ فيه بيِّنٌ","وكذا العرض إذا العرض نصع",8,"ع",1,0],["وقليلٌ يدومُ أرْجى وأحجى","بمقلٍّ ينفِّلُ الأنفالا",9,"ل",2,0],["وقليلُ الخلافِ يصلح إن شئ","تَ جليساً ويرتضَى للوكالهْ",10,"ل",2,0],["وقَليلٌ لمثلها أن تُلَهَّى","بالبساتين والوجوهِ الحسان",11,"ن",1,0],["وقليلٌ كلُّ شكر حسن","في الذي تُسديه من فعل حسن",12,"ن",1,0],["وَقَليلٌ كُلَّ ما يَط","لُبُ فيها وَيَسومُ",13,"م",1,0],["وَقَليلٌ لِمِثلِكُم","بَسطُ خَدّي تَأَدُّبا",14,"ب",2,0],["وقل يا واهب الرتب العوالى","متى وعسى تبلَّغني النديا",15,"ي",2,0],["وَقَليلٌ إِن أَكبَروكَ لَكَ الهَي","بَةُ مِمَّن رَآكَ وَالإِكبارُ",16,"ر",1,0],["وَقَليلُ النَوالُ يَنفَعُ إِن لَم","تَرَني اليَومَ مَوضِعاً لِلكَثيرِ",17,"ر",1,0],["وَقَليلُ هَذا السَعيِ يُكسِبُكَ الغِنى","إِن كانَ يُغنيكَ الَّذي يَكفيكا",18,"ك",2,0],["وقليلٌ من الكلام نقيٌ","وكثيرٌ من الكلام بغاء",19,"ا",2,0],["وقل يا حبيب القلب إنك عائد","على جهلِ حساد وغفلة لوّامِ",20,"م",1,0],["وَقَلى قَبلي النِساءَ سَواهَ","بَعدَما كانَ مُغرَماً بِالغَواني",21,"ن",2,0],["وَقَليلاً في التَلاقي","وَكَثيراً في الضَميرِ",22,"ر",1,0],["وقَليلٍ ذاكَ إلا أنَّهُ","لَيْسَ مِنْ مِثلِك عِنْدي بالقَليلْ",23,"ل",1,0],["وقل يا عروسَ النبع هاتي من الجنى","ودوري عَلَيْنا بالرحيق وجودي",24,"د",2,0],["وقُلْ يا سماءَ النيل ويحكِ اقلعي","ويا أرضُ بالشُّمِّ الرواسخ مِيدي",24,"د",2,0],["وَقَلِيلاً مَا يَصْلُحُ الْمَرْءُ لِلْجَدْ","دِ إِذَا كَانَ سَاقِطَ الأَجْدَادِ",25,"د",1,0],["وَقَلِيلٌ فِي الصَّادِقِينَ الَّذِي","يَسْتَكْثِرُ الأَصْدِقَاءَ وَالأَصْحَابَا",26,"ب",2,0],["وَقَليلٌ لِهِندٍ","أَن يُسَقّى الغَماما",27,"م",2,0],["وقليلاً ما يصلُحُ المرءُ للج","دِّ إذا كانَ ساقِطَ الأجدادِ",28,"د",1,0],["وَقُل يا نُزهة الأَبصار حُسناً","سَقى واديك منهل الغَمام",29,"م",1,0],["وقل يا قوم تلك قلوب قوم","رماها الهجر بالداء العضال",30,"ل",1,0],["وقل يا عيون الزهر غضى وأطرقي","قضى عاشقٌ أحلى العيون الروانيا",31,"ي",2,0],["وقل يرحم اللَه السكينة والمنى","وخفضاً وريفا أعجلته المقادر",32,"ر",1,0],["وقليلٌ إن أكبرتك القوافي","يا جميلاً بحورها من مطيره",33,"ر",2,0],["وقليلُ الجدوَى مقالىَ يا أط","لالُ حتى سُقيتِ رَبعاً ومَغنىَ",34,"ن",2,0],["وَقَليلٌ لِما حَوَيتَ مِنَ السُؤ","دُدِ هَذا الإِجلالُ وَالإِعظامُ",35,"م",1,0],["وَقَليلٌ مِن بَعد مَصرَعِكَ الدَم","عُ وَلَو سالَ مِن جُفونِ الغَمامِ",36,"م",1,0],["وقليل شعر العارضين مخبّر","وكذا الكتاب فأصله عنوانه",37,"ن",2,0],["وَقُل يا أعزّ الورى بائسٌ","رَجاك لدينٍ ودُنيا معا",38,"ع",2,0],["وقليلٌ ذا لمِثلك يا","جاعلي مولاه مِن مَثَلَ",39,"ل",1,0],["وَقُل يا سَيِّدي قَد صَحَّ عَزمي","وَقَولي قَولُ أَصحابِ الحِمامِ",40,"م",1,0],["وَقُل يا عَليُّ العَلِيَّ المَحَلِّ","وَيا مَن مَواهِبُ كَفَّيهِ غَزرُ",41,"ر",1,0],["وَقُل يا خَيرَ أَهلِ الأَرضِ نَفساً","وَآباءً وَأَرحَبَهُم رَحابا",42,"ب",2,0],["وَقُلْ يَا أَيُّهَا الْمَوْلَى الْمُرَجَّى","تَوَسَّلِ لِي إِلَى الْمَوْلَى الْعَلِيِّ",43,"ي",1,0],["وَقُلْ يَا يُسْرَهُ الْمَيْسُورَ أَنْصِتْ","فَقَدْ نَادَاكَ عُسْرُ الْحَارِثِيِّ",44,"ي",1,0],["وقل يا خير خلق الل","ه إنّي فيك مبتهل",45,"ل",1,0],["وقُل يا بحرُ قد لاقيت بحراً","فأنت لهُ رفيقٌ أو نظير",46,"ر",1,0],["وَقل يا شَفيع المذنبين اعانة","لذى دعوة يَرجو اقالة عاثر",47,"ر",1,0],["وَقَليلٌ لسَراسُنقُرَ في ال","مُلكِ أَن يُعطى أَقاليمَ وَمُدنا",48,"ن",2,0],["وقليلُ الإحسانِ عندي كثيرٌ","لو تَوقَّعْتُه من الحَسناء",49,"ا",2,0],["وَقُل يا دِيارَ الظاعِنينَ بِرَغمِنا","وَعَهدِكِ أَن أَضحى لَكِ الدَهرُ مُرغِما",50,"م",2,0],["وقل يا رب يا رب","هب لي الاستقامه",51,"ه",1,0],["وقليلٌ فيك لو أنظمها","في مزاياك لها دُرًّا نضيدا",52,"د",2,0],["وقليلٌ ولو أنِّي ناظم","لعلاه في القريض الأَنجما",53,"م",2,0],["وقليل لك المديح وإنْ كنتُ","بمديحك شاعراً مكثارا",54,"ر",2,0],["وقليلة الخُطَّابِ أي","أسَ بعضُها من ليس كُفْوَهْ",55,"و",2,0],["وقليلاً فيكِ أن أدعو لها","ما رآني الله أستجدي الغماما",56,"م",2,0],["وقليلة الخُطَّاب عند نشوزها","إن تستطيع لها الرجالُ بِعالا",57,"ل",2,0],["وقليلٌ لكم ضلوعِي تَهتز","زُ مع الوجد أو دموعي تُذالُ",58,"ل",1,0],["وقل يا رسولي مبلغاً سُفراءَهم","جميعاً وخُصَّ العبدرِيَّ أبا نصرِ",59,"ر",1,0],["وقل يا عميد الدولة اعطفْ وإن جَنتْ","فما زَلَّةٌ إلا وعفُوك أرحبُ",60,"ب",1,0],["وقل يا أبا العباس بل يا أبا الورى","فكلّهُمُ فيما مَلكتَ بنو أبِ",61,"ب",1,0],["وقليبُ القلب ما زال بهِ","فاتحاً إنسانها حتى أماها",62,"ا",3,0],["وقليل عند مثلي لو غدت","دارةُ البدر لتلك الشمس دارا",63,"ر",2,0],["وقلْ يا لمَّةَ الشَّيْطانِ زُولي","وقلْ يا رحمَةَ الرَّحمنِ دُومي",64,"م",2,0],["وقَليلٌ للحِبِّ في الحُبِّ هذا","لو سَعَيْنا لهُ على الآماقِ",65,"ق",1,0],["وقلْ يا فاطِرَ الأَشياءِ إِنِّي","دعوتُكَ بانْكِسارٍ واعْتِقادِ",66,"د",1,0],["وقليل نظم النجوم لملك","جاز في المجد أنجم الجوزاء",67,"ا",2,0],["وقليلُهُ حيث الصّوابُ وكُثرُهُ","من قائليه وساوسٌ وخُبولُ",68,"ل",1,0],["وَقُلْ يا غَرِيبَ الحُسْنِ رِقّ لِنازِحٍ","غَريبٍ لَهُ قَلْبٌ لَدَيْكَ مُقيمُ",69,"م",1,0],["وقل يا ابنَ الوصيِّ فدتكَ نَفسي","أطلتَ بذلكَ الجَبَلِ المُقاما",70,"م",2,0],["وَقُل يا أَنت فيما","زَعمت مفند بين العَبيد",71,"د",1,0],["وقليلٌ لغرسِ نعماكَ أن يع","لو على كلِّ هذه الأغراس",72,"س",1,0],["وقليل على الجباه إذا ما","حظيت باللقاء لَمُّ ثَراها",73,"ا",3,0],["وقل يسمع وسل تعط الأماني","وقم واشفع تشفع في العباد",74,"د",1,0],["وقل يا لقومي ان نهج التقى عفت","مراسمه والوقت فيه تنكر",75,"ر",1,0],["وقل يا رسول اللَه دارك وخذ يدي","فاني نعم فارقت ما يوجب الخجل",76,"ل",1,0],["وقل يا رب فارحمني وجد لي","بتوبة صادق حسن اعتدال",77,"ل",1,0],["وقليل من الشعاع ال","حب يكفي ليرجع الوحل طلاَّ",78,"ل",2,0],["وَقَليلٌ مِن أَيادي","كَ عَلى الناسِ كَثيرُ",79,"ر",1,0],["وقليل شكر العباد وأنت الشا","كر العبد للذي منك تولي",80,"ل",2,0],["وقل يا عظيماً عظم الله شأنه","فعبر في فرقانه عنه بالنبا",81,"ب",2,0],["وقل يا تقدَّستِ من بقعةٍ","بها يَغفرُ الزلّةَ الغافرُ",82,"ر",1,0],["وقليلٌ بها وإن ليس يجدي","ترسل العينُ دمعَها مدرارا",83,"ر",2,0],["وقل يا دعاةَ السحرِ خلُّوا التشخُّصا","لأقلامِ موسى سرُّ ما كانَ في العصا",84,"ص",2,0],["وقليل إن أدركت بك نفس","كل شيء ترومه من مناها",85,"ا",3,0],["وقليل ثأري أن مثلك فقده","جعل (القضاء) المستعز خجولا!",86,"ل",2,0],["وَقُل يا شَفِيعَ الخَلقِ إِنِّىَ عَبدُكُم","مُسِيئاً فَدَارِكنى وَقُل لِىَ أولِجُ",87,"ج",1,0],["وقل يابن الذي عادت إليه","طغاة الشرك خاضعة الرقاب",88,"ب",1,0],["وَقَليلٌ لِلمُؤمِنِ الزُهدُ فيها","وَكَثيرٌ مِنَ الكَفورِ الفُسوقُ",89,"ق",1,0],["وَقَليلٌ في هَواها ناظِري","وَدَراريهِ وَفَصدُ الأَكحَلِ",90,"ل",1,0],["وَقَليلٌ في هَوى أَوطانِنا","ما بَذَلناهُ وَما لَم نَبذُلِ",90,"ل",1,0],["وَقَليلٌ ذُلّي لَهُ وَخُشوعي","وَدُموعي نَظيمُها وَالنَثيرُ",91,"ر",1,0],["وقل يا إلهي قد أتيناك نرتجي","مواعيد صدق من كريم معود",92,"د",1,0],["وقليلٌ لهما إن","يُذكرا ذكراً حميدا",93,"د",2,0],["وقليل من يبرره","في يد التهذيب تحصيل",94,"ل",1,0],["وَقَليلُ الحُبِّ صَرفاً خالِصاً","لَكَ خَيرٌ مِن كَثيرٍ قَد مُزِج",95,"ج",1,0],["وقل يا إلهي عنى وسامح","إذا قيل مه لا ت حين مناص",96,"ص",1,0],["وقل يا علياً علا شأنه","تهنأ بنجلك واقض المنى",97,"ن",2,0],["وقل يمموا يم العذيب بهيبة","لذي عزة إن لم نهبه يعذبنا",98,"ن",2,0],["وقليل العقل والأدب","عجبُه من غاية العجب",99,"ب",1,1],["وَقُل يا أَيُّها الأَوحَد","حسين يَشتَكي البينا",100,"ن",2,0],["وَقَليلٌ مَن ينال المُشتَهى","بَل حَرامٌ تُبلَغَ المُشتَهياتُ",101,"ت",1,0],["وقليلا تمتعت في الفيافي","بسنام كالعارض المركوم",102,"م",1,0],["وقل يا حجة الباري أغثنا