{"poems":[[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[91,"من بعد ما انتظرت حقابا","https://www.aldiwan.net/poem44746.html","مجزوء الكامل"],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[287,"لعن الله جرجس القنياطا","https://www.aldiwan.net/poem32717.html","الخفيف"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[454,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[558,"ما قصر السعي ولاعللت","https://www.aldiwan.net/poem68174.html","السريع"],[563,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[580,"من يشتري لي أشجان","https://www.aldiwan.net/poem2842.html","منهوك المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138381",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112448","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55888","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123151","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53090","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109747","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77359","الخفيف"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204968","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112678","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86266","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4927,"ارحل يا بلطجي","https://www.poetsgate.com/ViewPoem.aspx?id=79604",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5410,"دٌّ على موغل في الزيفِ والعدم","https://www.poetsgate.com/ViewPoem.aspx?id=140754",""],[5674,"شموخ صمتك هزته القوارير","https://www.poetsgate.com/ViewPoem.aspx?id=207901",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[1155,"مَا فر خربندا عَن الرحبة","https://www.poetsgate.com/ViewPoem.aspx?id=190931",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""],[454,"بوركت من نهضة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82681&r=&rc=45",""]],"verses":[["بل خاض روضاً بين غدرانِهِ","يُرضيه إن صعَّد أو صَوَّبا",0,"ب",2,0],["بل خصوصاً به يُنفِّلُني التأ","هيلَ منه ويفرضُ الترحيبا",1,"ب",2,0],["بل خِفْتُ من كنتُ له راجياً","ورجَّتِ النفسُ فخوّفْتُها",2,"ت",3,0],["بل خدمة الوطن العزيز","بهن عن بعد اهابا",3,"ب",2,0],["بل خالدٌ إن كان شيء خالدا","وظالمين استوْطَئوا المراقدا",4,"د",2,0],["بَل خَراءُ الرُهبانِ لَمّا تَعَشّوا","عَدَساً كاَن فَتُّهُ بَقسُماطا",5,"ط",2,0],["بل خوفا أن تختل الدورة","إذ نتصادم أو نتلاقى",6,"ق",2,0],["بل خير دار لنا دار نعز به","إن الكريم يرى في الضيم إضرارا",7,"ر",2,0],["بَل خانَها الدَهرُ وَأَزرى بِها","عَثرَةُ جَدٍّ لا تُواتيها",8,"ه",2,0],["بل خيلات عقول ظهرت","في منام وهو رب متعال",9,"ل",1,0],["بل خطفته العُقْبَانْ","فابكوا مَعِي يا إِخوان",10,"ن",1,0],["بل خير من أسى العباد كأنه","للعالمين ابٌ أبرُّ رحيم",11,"م",1,0],["بل خدمة الأوطان وهي فريضة","لك أصبحت من كل فرض أوجبا",12,"ب",2,0],["بل خدوداً وردية ولحاظاً","مصلتات على رقاب البريه",13,"ي",2,0],["بل خلص ودي قد دعاني أنني","أنشي التعازي فيكم وانمّقُ",14,"ق",1,0],["بل خلّفوه طريحاً في درياهم","مغرغر الدمع لا تهدأ له مقل",15,"ل",1,0],["بل خصوصية بها خصه الله","فكانت تسمو على الأتراب",16,"ب",1,0],["بل خاف أن يدميه رشق عيونها","فكساه حلة وشيه المتوقد",17,"د",1,0],["بل خلونا بقدر ما قلتُ انت ال","ح فقال الحبيب وهو غضوبُ",18,"ب",1,0],["بَل خَبَّطُوا نَقلاً وَبَحثاً أوجَبَا","شَكًّا لِكُلِّ مُلَدَّدٍ حَيرَانِ",19,"ن",1,0],["بَل خُلِقنا لِلَّهوِ وَالأَفراحِ","ثُمَّ نادَت فَجيءَ بِالأَقداحِ",20,"ح",1,0],["بَل خَرج الناسُ عَلى الإِطلاقِ","مِن عالَم بَل عَلوي راقي",21,"ي",1,0],["بل خلقنا الى الطموح فحالت","دونه أعبد ودوني دائي",22,"ي",1,0],["بل خلفه قف وإليه ول","وجهك شطر قبلة المصلي",23,"ي",1,0],["بَل خاضَ في فَن العُروض بُجورُهُ","فَاتى بِزاهي الدرَّ لِلطلابِ",24,"ب",1,0],["بل خَلقُهُ إن عَاشَ خِدنَ البُوسِ","إذ هُوَ فِى الدَّارَينِ ذو العُبُوسِ",25,"س",1,0],["بَلْ خُذْ جَمِيْعَ الْمُخْبِرِيْنَ","وَكُلَّ جُمْهُوْرِ الْكَسَلْ",26,"ل",1,0],["بل خضبنا الأرض منهم بكما","تخضب الغيد شفاها وخدودا",27,"د",2,0],["بل خفقةٌ بصداها الطهر منسكب","بين الضلوع كنورٍ مشرقٍ عَرِمِ",28,"م",1,0],["بل خانك الحب لمّا خنتَ موثقَهُ","فأوثقتك المنايا والمقاديرُ",29,"ر",1,0],["بل خبٌريهم انني مقتولها","بل روحها ان جادت الارواحُ",30,"ح",1,0],["بل خَافَ من مَالِكهَا أَنه","يلْبسهُ من سَيْفه طوقا",31,"ق",2,0],["بل خيرُ مسرورٍ بكل كنوزنا","ويزيدُها مِن حُبِّه إغناءا",32,"ا",3,0],["بل خير دار لنا دار نعز بها","إن الكريم يرى في الضيم إضرارا",33,"ر",2,0]]}