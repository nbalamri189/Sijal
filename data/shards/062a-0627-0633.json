.ae/diwan/poem/146751","الطويل"],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[3591,"لم يبرح الفتك من جفنيك مشتغلا","https://www.poetsgate.com/ViewPoem.aspx?id=149457",""],[5122,"تّمر","https://www.poetsgate.com/ViewPoem.aspx?id=33179",""],[5213,"يا بقعة تحيى الفروض والسنن","https://www.poetsgate.com/ViewPoem.aspx?id=170394",""],[5510,"قلبي يحنُّ إليك","https://www.poetsgate.com/ViewPoem.aspx?id=205642",""],[5956,"قناديل عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182182",""],[5956,"الصديق والأمانة","https://www.poetsgate.com/ViewPoem.aspx?id=184479",""],[5956,"وجوه مبتسمة","https://www.poetsgate.com/ViewPoem.aspx?id=184823",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6093,"فَمَا كُلُّ قَولٍ يُقَالُ صَحِيْحاً (المتقارب)","https://www.poetsgate.com/ViewPoem.aspx?id=181457",""],[6315,"بيروت وأحاديث العرَّاف ... قراءة لأقداح الأنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87583&r=&rc=8",""]],"verses":[["تَأَسَّفَت جارَتي لَمّا رَأَت زَوَري","وَعَدَّتِ الحِلمَ ذَنباً غَيرَ مُغتَفَرِ",0,"ر",1,1],["تَأَسّي كَفاكِ اللَهُ ما تَحذَرينَهُ","فَقَد غالَ هَذا الناسُ قَبلَكِ غولُ",1,"ل",1,0],["تَأْسى على عهديَ الماضي ويُذهِلُها","تَفوُّقُ العيشِ ذي الأحلاب في العُلَبِ",2,"ب",1,0],["تأسوا جميعا فيالمداجاة ذا بذا","فراح فلان قدوة بفلان",3,"ن",1,0],["تَأسيسُها وَدَخيلُها مَع رِدفِها","وَرَوِيُّها مَع وَصلِها وَخُروجِها",4,"ه",2,0],["تَأسو جِراحَ الباسِلينَ مُسالِماً","وَكَأَنَّما تَغشى الجِلادَ مُحارِبا",5,"ب",2,0],["تأسف إن أنفقت مالاً ولا","تأسف من عمرك إذ تنفق",6,"ق",1,0],["تأْسُو بِرِفْقٍ أَوْ تُوَاسِي بِهِ","قدْ يَضجَرُ الرِّفْقُ وَلاَ تَضْجَرُ",7,"ر",1,0],["تَأْسى النِّيَابَةُ أَنْ تَبِينَ وَكُنْتَ مِنْ","حُصَفَائِهَا وَثِقَاتِهَا الصُّيَّابِ",8,"ب",1,0],["تأْسَى الرِّيَاسَةُ أَنْ تُزَايِلَهَا وَلَمْ","تَتَقَضَّ حَاجَتُهَا لِغَيْرِ إِيَابِ",8,"ب",1,0],["تأسى بقوم بالشهادة أكرموا","لهم موطن في جنة الخلد دائم",9,"م",1,0],["تَأْسى على عهديَ الماضي ويُذهِلُها","تَفوُّقُ العيشِ لا الأحلاب في العُلبِ",10,"ب",1,0],["تأسد ثعلب والهر أيضا","تنمر بالآيات الزمان",11,"ن",1,1],["تَأَسَّ بِمَن نَاوَيتُ قَبلَكَ فَانثَنَوا","خَزَايَا وَوَلَّوا مُدبرِينَ تَأَسِّيَا",12,"ي",2,0],["تَأْسِرُ بالأَلحاظِ أُسْدَ الغابِ","مربوبةٍ تُرْبي عَلَى الأَربابِ",13,"ب",1,0],["تأسّوا بإخوانٍ أُصيبوا بإخوةٍ","فما الأرضُ إِلا مرقدٌ بعد مرتع",14,"ع",1,0],["تأَسَّ بخير الخَلق آبائك الألى","بكت لرَزاياهم أَولو الدين والشِركِ",15,"ك",1,0],["تَأسّى بِهِ الشِبل الكَريم مُحمَّد","فَنالَ بِحَمد اللَهِ ما هُوَ طالِبُه",16,"ب",2,0],["تأسيتُ بالفادي الذي كفرَت به","بنو آدمٍ جهراً وخانت حبائبه",17,"ب",2,0],["تأس واذكر فكم من صاحب وأخ","فارقته ومليك كان ذا خطر",18,"ر",1,0],["تأس بالمصطفى المختار من مضر","صلَّى الإِله على المختار من مضر",18,"ر",1,0],["تأسَ يا صاحِ بالذين مضت","من قبلنا فوقهنَّ أحقابُ",19,"ب",1,0],["تَأسَّ ولا تَأْسَ مِنْ عَضَّةٍ","فَكَمْ لَكَ في مِثْلِها مَوْعِظَهْ",20,"ه",1,1],["تأسى السما والارض كل أسى على","شمس اراد لها الزمان كسوفا",21,"ف",2,0],["تأسَّ فما مُصابُك كالمُصاب","فَيومُ أبيكَ يومُ أبي ترابِ",22,"ب",1,1],["تأسّي القلوبِ الهيمِ أنَّ محمداً","مَضى وتَقَضَّى آلُهُ آلُ طالبِ",23,"ب",1,0],["تَأَسَّ فَنِعمَ الذُّخرُ صَبرُ الأَكارِمِ","وَتَعظيمُ قَدرِ العَظايِمِ",24,"م",1,1],["تأسَّ ولا تَجزَع فَقَد ُضيَ الأمرُ","ولَيس يَضيرُ الشَّمسَ إن كَسَفَ البدرُ",25,"ر",1,1],["تأسَّ فإن المرءَ غيرُ مُخَلَّدٍ","ومَن فاتَ حينَ اليومش أدرِكَ في الغَدِ",26,"د",1,1],["تأسى بهم آل الزبي فذللت","لمصعب في الهيجاء ظهور المصاعب",27,"ب",1,0],["تأست برفقك في حظها","ولولاك لم تك بالساليه",28,"ي",2,0],["تأسو الجراح وتكرم الأسرى بما","زودتها من برّك المعتاد",29,"د",1,0],["تأسو جراحهمُ وتخفي مُكرهاً","للجارح البغضاءَ والغضبات",30,"ت",1,0],["تَأَسّس مِنهُ المجدُ في ذَروَةِ العُلى","عَلى مَشرف يُبنى عَلى أَشرَفِ الأُسِّ",31,"س",1,0],["تأسن العباب","وأنتن التراب",32,"ب",1,0],["تَآسَوا عَلى نَصرِ اِبنِ بِنتِ نَبِيِّهِم","بِأَسيافِهِم آسادَ غيلٍ ضَراغِمَه",33,"م",2,0],["تاسعها المقصور موسى يعلى","سعدى رحى رضوى وقس وحبلى",34,"ل",2,0],["تأسيسها حرف هوائيّ ألف","مسكن به ابتداؤها ألف",35,"ف",1,0],["تأسَّفَ لكن حين عزَّ التأسَّفُ","وكفكف دمعاً حين لا عين تذرِفُ",36,"ف",1,1],["تأسو الجراح بليغة","وتزحزح الداء الخطير",37,"ر",1,0],["تأس لا تأس واذكر احسن القصص","ورج من ربك التسويغ للغصص",38,"ص",1,1],["تأس وان تكن ما نلت أجراً","فطورا لا يُفيد دم الحِجامه",39,"م",2,0],["تأسَّ بصبره في كلِّ خطبٍ","يشيب لِهَوْلِه رأس الغلام",40,"م",1,0],["تأسيا بالوالد المرتضى","فهو الذي ناداك يا مسلم",41,"م",1,0],["تَأسين بِالبَسماتِ أَجراح الفُؤاد","وَتَبعثين مِن العُيون لَهُ الدَنَف",42,"ف",1,0],["تأسّ إذا أبصرت صاحبُ ثروة","وإن كنت ذا قلّ تبت طاوي الحشا",43,"ش",2,1],["تأس عن حبسك الماضي بمن سلفوا","من الغزاة وأقدم غير مضطرب",44,"ب",1,0],["تأس بآل أحمد يوم خفوا","اليها وثبة الأسد المراع",45,"ع",1,0],["تأَسّ أمير المسلمينَ فإنّما","هو القدَرُ المحْتومُ جاءَ إلى وَعْدِ",46,"د",1,0],["تأسَّ أميرَ المُسْلِمينَ فإنّهُ","ورُودُ سَبيلٍ لمْ يزَلْ مُتوقّعا",47,"ع",2,0],["تأسرها وإن تكن","عنيدة لم تؤسر",48,"ر",1,0],["تَأسَّ بِمَن قَبلُ يا رَجُلُ","فإنَّ التأسي دواءث الأسى",49,"س",2,1],["تأسَّ بما قد مضى جُملَةً","فإن التأسي دَواءُ الأسى",50,"س",2,0],["تَأَسَّ ايا أَباهُ وَكفَّ دَمعاً","فَإِن اللَه معواضٌ أَمينُ",51,"ن",1,0],["تاس ببدر التم يا شمس ذا العصر","ولا ناس من كلم بوجهك لا يزري",52,"ر",2,1],["تأسَّف يعقوبٌ علي لو انه","رآني ولم يخطر على البال يُوسف",53,"ف",1,0],["تأس بيأس أو تعز بسلوة","فمالك في أطلال عزة طائل",54,"ل",1,0],["تأسوا بطة أمة الرشد واعملوا","بقولٍ وفعلٍ واقتفاء شمائل",55,"ل",1,0],["تأسى ومفتاح ُ انسجامِك َ ضائع ٌ","مع كل ِّ ما في بوحِه ِ يتعامد ُ",56,"د",1,0],["تأسى على نصح عذال الغرام فكم","قد عنفونا وأم نسمع لهم عذلا",57,"ل",2,0],["تأسف على غلطتها والدموع شهود","تغطي ابزخ الدموعها كبر غلطتها",58,"ت",3,0],["تاسست على تقى وشادها","والي رقاب المسلمين ذو المنن",59,"ن",1,0],["تاﻻ سيبقى في السماء تربّعي","في ظل حسنك ﻻ أرى أحداً معي",60,"ع",2,0],["تَأَسَّيْ بمعنى : عَسَى أن تحبِّوا","وشرٌّ لكم حبكم وارتباكْ",61,"ك",1,0],["تأسَّيْ بذلك، فالله خيرٌ","لكم حافظاً راحماً لحِماكْ",61,"ك",1,0],["‏ ‏تأسَّيتُ بالله ثم الرسولِ","‏ ‏ وبالصَّحْب في كل طبعٍ جميلِ ِ",62,"ل",1,0],["تأسو جراحاتِ المشاعر بسمةٌ","هي ذاتُ فعل فاق فِعْلَ طبيبها",63,"ب",3,0],["تَأسُو عَلَى طَيرٍ هَوَى كمَدًا","أَمْ أَنتَ تَخشَى صَولَةَ اللَّمَمِ",64,"م",1,0],["تَأَسَّفَ مني بدمعِ العُيونِ","كَذاكَ الكريمُ حَمِيْدُ المَآلْ",65,"ل",1,0],["تأسَّنت الألغاز فينا .. ولم يَعُدْ","نَثيثُ الذُّرى يفشو بأحلامنا عِطرا",66,"ر",2,0],["تأسَّنت الألغاز .. كلا بل اشْتَرَتْ","بنا حسرةُ الأفراسِ من عُمْرها خَمرا",66,"ر",2,0]]}