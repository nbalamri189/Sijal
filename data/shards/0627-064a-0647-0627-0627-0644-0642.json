iewPoem.aspx?id=199815",""],[5964,"أيها القرم الذي","https://www.poetsgate.com/ViewPoem.aspx?id=181309",""],[5991,"ته على المستهام فيك جمالاً","https://www.poetsgate.com/ViewPoem.aspx?id=116381",""],[6032,"تسابيح القرب","https://www.poetsgate.com/ViewPoem.aspx?id=181510",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6167,"عمارة الضباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85571&r=&rc=54",""],[6189,"السيف والوردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83560&r=&rc=27",""],[6315,"محاريب الحيرة .. حيرة الفراديس!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87576&r=&rc=1",""]],"verses":[["أَيُّها القَبرُ الَّذي أَمسى بِهِ","عاطِلَ الأَرضِ جَميعاً وَهوَ حالي",0,"ل",2,0],["أَيُّها القانِصُ ما أَح","سَنتَ صَيدَ الظَبَياتِ",1,"ت",1,0],["أَيُّها القائِمُ بِالأَمرِ لَقَد","قُمتَ في الناسِ فَأَحسَنتَ القِياما",2,"م",2,0],["أَيُّها القائِمونَ بِالأَمرِ فينا","هَل نَسَيتُم وَلاءَنا وَالوِدادا",3,"د",2,1],["أيها القوم مالكم في جمود","أو ما يَستفِزّكم تَفنيدي",4,"د",2,1],["أيها القوم نحن في عصر علم","جعل الحرب في طراز جديد",4,"د",1,0],["أيها القوم فادخلوا المعهد الحر","بيّ طوعاً وانضوا ثياب الجمود",4,"د",1,0],["أيها القوم إن هذا لرأيي","في فقيدٍ لم تشهدوا إرماسه",5,"س",2,0],["أيها القوم إن للنوم سلطا","ناً قوياً لا يُتّقى بسلاح",6,"ح",1,0],["أيها القاسمُ القسيمُ رُواءَ","والذي ضمَّ ودُّهُ الأهواءَ",7,"ا",2,1],["أيها القائل صبراً","طال بي صبري ورفقي",8,"ق",2,0],["أيُّها القحطبيُّ ما ضرَّ ناري","ما هوى في جحيمها من فَراشِكْ",9,"ك",1,0],["أيُّها القائلُ بالجسْ","مِ لأنَّ الأير جِسمُ",10,"م",1,1],["أَيُّها القَبرُ تَكَلَّم وَاِخبِريني يا رِمام","هَل طَوى أَحلامَكَ المَوت وَهَل ماتَ الغَرام",11,"م",1,0],["أَيُّها القَلبُ الَّذي في أَضلُعي","إِنَّما اللَذَّةُ جَهلاً فَاِجهَلِ",12,"ل",1,0],["أيها القلب قد أثار عجابي","بعد ذاك النزاع هذا النزوع",13,"ع",1,0],["أيها القبر فيك يغفو الهمام","فسلام عليك ثم سلام",14,"م",1,0],["ايها القلب لا يهولنك موت","ليس في هذا الموت شيء يهول",15,"ل",1,0],["ايها القوم لا لبا","نة عندي ولا وطر",16,"ر",1,0],["ايها القوم الراكضون بليل","حاذروا ان تصادفوا ازليقا",17,"ق",2,0],["أيها القوم إن علمي بما ارتبتم","به في الرسوخ كالأطواد",18,"د",1,0],["أيها القصر أترعى عهدنا","وتفى إن عز في الناس الوفى",19,"ا",1,1],["أيها القصر أنقضى عُرس الهوى","وطوى الإِصباح ليل الأنس طى",19,"ا",1,0],["أَيُّها القَومُ عَظِّموا","واضِعَ الأُسِّ وَالحَجَر",20,"ر",1,0],["أَيُّها القَلبُ أَحَقٌّ أَنتَ جار","لِلَّذي كانَ عَلى الدَهرِ يَجير",21,"ر",1,0],["أَيُّها القَلْبُ لا تَعُدْ","لِهَوى البِيضِ ثَانِيَهْ",22,"ن",3,0],["أَيُّها القاضي الَّذي كادَ القَضا","وَيَدُ الأَقدارِ تَقضي ما يَشا",23,"ش",2,0],["أيها القلب الذي مزقته","صارخاً عهدك يا قلب انتهى",24,"ه",2,0],["أَيُّها القَلبُ أَنجِزِ اليَومَ نَحباً","مِن بَني الحِصنِ إِذ غَدَوا وَذُحولا",25,"ل",2,0],["أيّها القائدُ الأبيّ عزاءً","فثواءُ المقيمِ منّا رحيلُ",26,"ل",1,0],["أَيُّها القَلبُ ما أَراكَ تَفيقُ","طالَ ما قَد تَعَلَّقَتكَ العَلوقُ",27,"ق",1,1],["أَيُّها القائِلُ غَيرَ الصَوابِ","أَمسِكِ النُصحَ وَأَقلِل عِتابي",28,"ب",2,1],["أيها القائدُ العظيم تقدَّمْ","أنت بالحرب والكتائب أعلمْ",29,"م",1,1],["أَيُّها القَصرُ ذُو الأَواسي وَذُو البُس","تانِ أَعلى القُصُورِ بَينَ الظِرابِ",30,"ب",1,0],["أَيُّها القَصرُ ذُو الأَواسِيِّ وَالبُس","تانِ بَينَ القُصُورِ فَوقَ الظِرابِ",31,"ب",1,0],["أَيُّها القَلبُ هَل تُطيقُ اِصطِباراً","طالَما قَد أَطلَقتَني فَصَبِرتا",32,"ت",2,0],["أَيُّها القادِمُ مِن بَص","رَتِنا أَهلاً وَرَحبا",33,"ب",2,1],["أَيُّها القارِئُ المُذَكِّرُ بِاللَ","هِ تَرى في وِصالِ حِبٍّ جُناحا",34,"ح",2,0],["أَيُّها القادِحُ نارَ الهوى","اصْلَها يا أَيُّها القادِحُ",35,"ح",1,0],["أيها القبرُ ارحم طوالع شيبي","أنا في كربتي إليك فقير",36,"ر",1,0],["أَيُّها القلب إن أَمرت بعودي","بعد حين فأَنتَ غير مطاع",37,"ع",1,0],["أَيُّها القبر المستجدّ سلامٌ","وَعَسى أَن يَلقى سَلامي قبولا",38,"ل",2,0],["أَيُّها القبر كيف فيك رَشيد","أَشَديد كَذا عليه السقام",39,"م",1,0],["أَيُّها القوم إنكم قد جهلتم","أنكم أمسيتم بوقت الغداة",40,"ه",1,0],["أَيُّها القَوم أَيُّها القوم أَنتم","أُمَّةٌ ساقطون في مهواة",40,"ه",1,0],["أَيُّها القبر هَل علمت بأَني","قبل موتي دفنت فيك حَياتي",41,"ت",2,0],["أيها القطبُ حَدّثِ الكونَ هلا","تُسعدِ الشعرَ ليلةً باعترافِ",42,"ف",1,0],["أَيُّهَا القَلبُ تَعَلَّل بِدَدَن","إنَّ هَمَّي في سَمَاعٍ وأَذَن",43,"ن",1,1],["أيها القوم نحن متنا فهيّا","نستمعْ ما يقول فينا الرثاء",44,"ا",2,0],["أيها القوم نحن متنا ولكن","أنفتْ أن تضمنا الغبراء",44,"ا",2,0],["أَيُّها القَبرُ ما صَنَعتَ بِجِسمٍ","يَتَأَذّى مِنَ البُرودِ بِدَرزِ",45,"ز",1,0],["أيّها القارئُ الذي لبسَ الصو","فَ وأضحى يُعَد في العُبّاد",46,"د",1,1],["أيها القوم، حسبكمْ إرهاقَا","كم علينا تضيِّقون الخناقَا!",47,"ق",2,1],["أيها القوم، طوِّفوا حَوْل مصر ال","يومَ، في زيِّ مُحْرِمين حُفَاة",48,"ه",1,0],["أيها الْقارىء المُذَكِّرُ باللَّهِ:","ترى في وِصال حِبٍّ جُنَاحَا",49,"ح",2,0],["أَيُّهَا الْقَلْبُ أَنْجِزِ الْيَوْمَ نَحْباً","مِنْ بَنِي الحِصْنِ إذْ غَدَوْا وَذُخُولاَ",50,"ل",2,0],["أَيُّها القَبرُ قُم بِحَقِّ نَزيلٍ","بِكَ ما زالَ لِلكَرامةِ أَهلا",51,"ل",2,0],["أيها القصر قد صمدت على الكر","ه ولو أن خطبك الجلل",52,"ل",1,0],["أَيُّها القَلبُ مُت فَخَيرٌ وَأَبقى","لَكَ مَوتٌ يَقيكَ شرَّ العِبادِ",53,"د",1,1],["أَيُّها القاتلُ اِشرَبِ الموتَ كأساً","في نَضير الصِبا وَغضِّ الفتاءِ",54,"ا",2,0],["أَيُّهَا الْقَرْمُ الْهُمَامُ الْمُرْتَضَى","مَنَ حَوَى فِي الْمَجْدِ بُرْداً فَضْفَضَا",55,"ض",2,1],["أَيُّها القادِمون مِن أَرض نجد","هَل وَجدتم لهم قَلبي مزيلا",56,"ل",2,0],["أَيها القاطعُ عرضَ البحرِ هلْ","لكَ عهدٌ بروابي قاسيون",57,"ن",1,0],["أيّها القائلون بالنار والجنّ","ة والحشر في غد والحساب",58,"ب",1,0],["ايها القلب المعنى","ان ما تبغيه فات",59,"ت",1,0],["أيها القوم دخلتم حلفاء","وملكتم فغدوتم خصماء",60,"ا",2,0],["أَيُّها القَوم وَيَحكُم قَد هَدمتُم","بُنيَة اللَهِ وَاِتهمتم عِبادِه",61,"د",2,1],["أَيُّها القَوم حُزتُم المَجد حَتّى","اِنَّكُم في الكَمالِ بحر عباب",62,"ب",1,0],["أيُّها القاعِدونَ عَنها اقعِدوني","مَعكُم قَد سَئِمتُ مِن أَن أَقوما",63,"م",2,0],["أيُّها القانونُ أصبحتَ عجيب","في زماني ، ناطقاً عن سوءِ حالِ",64,"ل",1,0],["أيُّها القانونُ مازلْتَ تُرين","في مقاماتِ الهوى شرَّ مثالِ",64,"ل",1,0],["أيُّها القانونُ إن كنتَ ستبقى","رافعاً راية زورٍ واحتيالِ",64,"ل",1,0],["أيُّها القبر لا بَرِحْتَ مَصوباً","من غزيرِ الحيا بصيّب مُزْنِ",65,"ن",1,1],["أَيّها القاطعُ الفلاةَ إِكاماً","يمتطيها دون الرِّفاق وَكُوما",66,"م",2,0],["أيها القابضُ عنّي جاهَهُ","إنّني مشتغلٌ بالباسطِ",67,"ط",1,0],["أيها القوم سيروا","الأمام الأماما",68,"م",2,0],["أيها القارئ إذا مت","ت لنظمي ولنثري",69,"ر",2,1],["أيها القائد المُفدى بِرُوحي","وبنفسي وكل شيءٍ ثمينِ",70,"ن",1,1],["أيُّهَا القومُ الأُسُودُ","في ثَبَاتِ فَلتزِيدُوا",71,"د",3,0],["أيها القَائد العظيمُ الذي أع","مالُه قُورِنَت بكل ثَناء",72,"ا",2,0],["أَيّها القادمُ الَّذي أَقْدَمَ الثّأْ","رَ لِقَلبٍ جَنى عليه المغيبُ",73,"ب",1,0],["أيها القوم السكارى","بعقار وهو دونْ",74,"ن",1,1],["أيُّها القاتِلُ لا ذُقتَ الرَّدَى","والَّذي يَرشُقُني لا شَلَلا",75,"ل",2,0],["أيها القائد الكبير الخطيرُ","أَنت للسيف من صِباك سميرُ",76,"ر",1,1],["أيّها القاضي المُنتقَى من أُناسٍ","ليس فيهم سِواكُمُ من نجيب",77,"ب",1,1],["أيها القبر إن فيك لروحي","نزعت من مفاصلي وعظامي",78,"م",2,0],["أيها القلب ذب هموما وحزنا","عين جودي ما العذر إن لم تجودي",79,"د",2,0],["أيها القاتلي بعينيه رفقا","إنما يستحق ذا من قلاكا",80,"ك",2,1],["أيُّهَا القادِمُونَ مِنْ (قِنْدَهارِ)","مَا دَهَى الشَّرْقَ من دَمَارِ وَمِحْنَة؟",81,"ن",2,0],["أَيُّها القائِدُ لِم خَلَّفتَنا","وَلِمَن وَلَّيتَ تَصريفَ الجُنودِ",82,"د",1,0],["أَيُّها القائِدُ هذي ميتَةٌ","طالَما رجَّيتها مُنذُ بَعيدِ",82,"د",1,0],["أَيّها القرم الّذي قد صعدت","في مَعاليهِ به قعس الهِمَم",83,"م",1,0],["أيها القلب لست تقبل نصحاً","فتجرع هذا الذي تبتغيه",84,"ي",2,0],["أيها القوم بالمسرات بشرى","أيها القوم فزتموا بالمراد",85,"د",1,0],["أيُّها القلبُ كن صبوراً على الوجدٍ","وفرطِ الغرامَِ والبَلبالِ",86,"ل",1,0],["أيها القادمُ الذي تتمنى","كلُّ عينٍ رأته أن لا يغيبا",87,"ب",2,0],["أَيّها القوم ساعدوا ربّةَ الخد","رِ ولا تُفسدوا عليها المَسيرا",88,"ر",2,0],["أيُّها القلبُ عدِّ عن سنَنِ البا","طلِ واهجُر ذَويه هجراً جميلا",89,"ل",2,0],["أيها القلب الذي جُنّ بنا"