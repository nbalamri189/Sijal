{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[119,"محجوبة عن ناظري","https://www.aldiwan.net/poem41509.html","مجزوء الرجز"],[119,"وليلي ما كفاها الهجر حتى","https://www.aldiwan.net/poem41513.html","الوافر"],[119,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[133,"وقفت وقد ضاق بي","https://www.aldiwan.net/poem67448.html","مجزوء الكامل"],[276,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[458,"عزاء بهذا الموت يا من فدى مصرا","https://www.aldiwan.net/poem61244.html","الطويل"],[591,"ناوليني الكأس في الصبح","https://www.aldiwan.net/poem17474.html","المديد"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64928","الخفيف"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113742","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104952","المتدارك"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102502","الوافر"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138011",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118756","المجتث"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72627","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4874,"جوهر العشق","https://www.poetsgate.com/ViewPoem.aspx?id=176407",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[6093,"لنْ ينُجبَ الخطآنِ مهما حاولا","https://www.poetsgate.com/ViewPoem.aspx?id=205154",""]],"verses":[["وَاشْغِلْ عِنِ اللَّذَّاتِ نَفْسكَ بِالَّذِي","نَفْسُ الْحَكِيمِ بِهِ تَلذُّ وَتُشْغَلُ",0,"ل",1,0],["وأشغَلُ الفارغاتِ من أعيُنِ ال","بِيضِ وَيَسلُبنني وأستلِبُ",1,"ب",1,0],["وأشغلت أهل الهوى","بفك طرف ساحر",2,"ر",1,0],["وأشغلت الفؤاد بها وراحت","إلى قاضي المحبة تشتكيني",3,"ن",2,0],["واشغل عن هذا الزمان وأهله","بدولتكم أرضى لدى النهى والأمر",4,"ر",1,0],["وأَشغَلَ قلباً عتا","وضلَّ بغيرِ الإِله",5,"ه",1,0],["واشغل ببيت اللَه طرفك خشية","وَطف القدوم به طواف المحرم",6,"م",1,0],["وأشغلت بالإنسان فردا وأمة","ويا لجهود منك لم تعرف الحصرا",7,"ر",2,0],["وأشغلت بالفكر النزيه محررا","وكل الذي جافاه صورته نكرا",7,"ر",2,0],["واشْغلي كفَّيك فِي وترِ","لاَ تَمُدِّيها إِلَى السُّبحِ",8,"ح",1,0],["واشْغَلاني عن لائمٍ ما أَتاني","بِرَشادٍ أَتَتْهُ آفةُ غَفَلَهْ",9,"ل",2,0],["واشغَلهُ باللَهِ في سرٍّ وفي عَلَنٍ","عمّا سواهُ فما في غيره سُرُرُ",10,"ر",1,0],["وَاشغَلهُم عِندَ الجِدَالِ بِبَعضِهِم","بَعضاً فَذَاكَ الحَزمُ للفُرسَانِ",11,"ن",1,0],["واشغل يمناك بصبِّ الكا","سِ وخلِّ يسارك للمزهر",12,"ر",1,0],["واشغلني بفضلك عن فضولي","وعن غيري وفعلي عن مقالي",13,"ل",2,0],["واشغل القلب في ذكره صباحك وممساك","فان بيده صلاح امرك وضرك وبلواك",14,"ك",1,0],["واشغل بشكرك قلبي","وقالبي مع ذهني",15,"ن",2,0],["واشغل نفسي والرضا ساعد لها","بابهام أمر لم تنله يد الوصف",16,"ف",1,0],["وَأَشغَلَني شُغلي بِها عَن سوائِها","وَأَذهَلَني عَنّي الهَوى وَالهَوامِعُ",17,"ع",1,0],["وَأَشغَلَني شُغلي بِها عَن شَواغِلي","وَفيها فَإِنّي لِلعَذارِ مُخالِعُ",17,"ع",1,0],["واشغل عذول الهوى والهه","واترك رموش الوله تحضنك",18,"ك",1,0],["وَاشْغَلْ فَرَاغَكَ مَا استَطَعتَ بِحَقِّهِ","وَانصَبْ فإنَّ العُمْرَ عَدَّاءٌ جَرَى",19,"ر",2,0],["وأشغلت منك النفس عن زخرف الهوى","بما في العلا يدنيك من رفعة الشأن",20,"ن",1,0],["واشْغلْ سِواكَ بما يرى من فضلِكمْ","وبغيرِ خيرٍ لا تكنْ مشغُولا",21,"ل",2,0]]}