ttps://www.aldiwan.net/poem31437.html","الوافر"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[74,"ويوم صقيل للشباب ظللته","https://www.aldiwan.net/poem12860.html","الطويل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[74,"وضيف طيف أم من هاجر","https://www.aldiwan.net/poem12934.html","السريع"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[74,"كفى حزنا أن الديار قصية","https://www.aldiwan.net/poem13209.html","الطويل"],[74,"وساق لخيل اللحظ في شأو حسنه","https://www.aldiwan.net/poem13264.html","الطويل"],[33,"إذا حجبت ليلى فما أنت صانع","https://www.aldiwan.net/poem25888.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[21,"ومن صنعه يوم فيل الحبوش","https://www.aldiwan.net/poem36162.html","المتقارب"],[52,"أردت الشرب في القمر","https://www.aldiwan.net/poem27001.html","مجزوء الوافر"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[48,"لنا بالبصرة البيضاء","https://www.aldiwan.net/poem66122.html","الهزج"],[50,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[46,"أمامة كيف لي بإمام صدق","https://www.aldiwan.net/poem22478.html","الوافر"],[46,"لقد أصبحت دنياك من فرط حبها","https://www.aldiwan.net/poem22604.html","الطويل"],[46,"أما الحسام فما أدناك من أجل","https://www.aldiwan.net/poem22791.html","البسيط"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[46,"إذا ما شئتم دعة وخفضا","https://www.aldiwan.net/poem23487.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10818","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9878","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200109","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[77,"لي الله من عنوان ملك مجدد","https://www.poetsgate.com/ViewPoem.aspx?id=33798",""],[18,"رماك الله من بغل","https://www.poetsgate.com/ViewPoem.aspx?id=27762",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[46,"قِيانٌ غدتْ، خمساً وعشراً، على عَصا","https://www.poetsgate.com/ViewPoem.aspx?id=20063",""],[29,"لعَمْري، لقد أسريتُ، لا لَيْلَ عاجزٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17429&r=&rc=2",""]],"verses":[["وَقَد جَعَلَ الزَمانُ يُضيءُ وَجهي","وَيَرفَعُ ناظِري وَيَمُدُّ باعي",0,"ع",2,0],["وَقَد جُدتُ بِالنُعمى عَليكَ لِأَنَّني","حَلَلتُ عُرى ضِغنى وَكَفكَفتُ مِن وِتري",1,"ي",1,0],["وَقَد جَثَمَ الرَدى في كُلِّ سَهمٍ","لَهُ في كُلِّ حَيزومٍ مَطارُ",2,"ر",1,0],["وَقَد جابَ الذَميلُ عَليكَ وَهناً","مِنَ الظَلماءِ مَدرَعَةً وَساجا",3,"ج",2,0],["وَقَدْ جَهِلَتْ أنِّي أَسُورُ إِلى العُلا","وَيَعْيَى بِها مَنْ لَمْ يُساعِدْهُ دَهْرُهُ",4,"ر",2,0],["وَقَدْ جَعَلْتُ مَرادَ الطَّرَفِ غَيْر مَهاً","يَهْزُزْنَ في المَشْي أَغْصانَاً على كُثُبِ",5,"ب",1,0],["وقد جَعَلَتْ على خَفَرٍ تَراءى","فتُخفي من محاسِنِها وتُبْدي",6,"ي",1,0],["وَقَد جَرَحَت عَيناهُ قَلبي فَأَصبَحَت","مُكَلَّمَةً أَوساطُهُ وَجَوانِبُه",7,"ب",2,0],["وقدْ جنَحوا للسِّلْمِ فاجْنَحْ تفضُّلاً","فَما مِنْهُمُ عيْنٌ منَ الرُّعْبِ تطْرِفُ",8,"ف",1,0],["وَقَدْ جَعَلَتْ تَفْلِي بِإَنْمُلِهَا الْفَلاَ","وَيُرْسَلُ مِنْهَا فِي غَدَائِرِهِ مُشْطُ",9,"ط",1,0],["وَقَد جَرَّبونا قَبلَها في وَقائِعٍ","تعلّم غُمر القَومِ منّا بِها الطَعنا",10,"ن",2,0],["وَقَد جَعَلَت أَشجانَ بِركٍ يَمينَها","وَذاتَ الشِمال مِن مُريخَةَ أَشأَما",11,"م",2,0],["وَقَد جَاوَزنَ هَضبَ قُتائداتٍ","وَعَنَّ لَهُنَّ مِن رَكَكٍ شُروجُ",12,"ج",1,0],["وَقَد جَعَلَت في نَفسِها أَن تَخافَهُ","وَلَيسَ لَها مِنهُ سَلامٌ وَلا حَربُ",13,"ب",1,0],["وَقَد جَرَّدَ الأَبطالُ بيضاً كَأَنَّها","مَصابيحُ تَذكو بِالذُبالِ المُفَتَّلِ",14,"ل",1,0],["وَقَد جَعَلوا السَبِيَّةَ عَن يَمينٍ","مَقادَ المُهرِ وَاِعتسَفَوا الرِمالا",15,"ل",2,0],["وَقَد جَعَلَتَ زُرقَ الوَشيجِ حُداتُها","يَميناً وَحوضى عَن شَمالِ المَرافِقِ",16,"ق",1,0],["وَقَد جَعَلَ الحِرباءُ يَبيَضُ لَونُهُ","وَيَخضَرُّ مِن لَفحِ الهَجيرِ غَباغِبُه",17,"ب",2,0],["وقد جلّلته بردة سندسيّة","ومن تحتها دِرعِ إلهية السرد",18,"د",1,0],["وَقَد جَرَّبتَني فَعَرَفتَ أَنّي","عَلى خَطَرِ المُراهِنِ غَيرُ كابي",19,"ب",2,0],["وَقَد جَلَّت نِساءُ بَني نُمَيرٍ","وَما عَرَفَت أَنامِلُها الخِضابَ",20,"ب",1,0],["وَقَد جَرَّبَ الهِرماسُ وَقعَ سُيوفِنا","وَصَدَّعنَ عَن رَأسِ اِبنِ كَبشَةَ مِغفَرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","لِئالِ أَبي قابوسَ يَوماً مُذَكَّرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","مَجَرّاً لِذي التاجِ الهُمامِ وَمَصرَعا",22,"ع",2,0],["وَقَد جَرَّبَ الهِرماسُ أَنَّ سُيوفَنا","عَضَضنَ بِرَأسِ الكَبشِ حَتّى تَصَدَّعا",22,"ع",2,0],["وقد جُرِّبتْ منهُ على آلِ مَخْلدٍ","تجاربُ ليستْ مثلهنَّ تجاربُ",23,"ب",1,0],["وقد جهور في الصوت","بصدر أيّما صدر",24,"ر",1,0],["وقد جلدوها الحد وهْي بريئةٌ","فحيَّ على دفن الشهيدة تؤجروا",25,"ر",3,0],["وقد جرَّبَ المنصورُ منهم نصيحةً","وجدّاً سعيداً نِعْم ركنُ المُزاحِمِ",26,"م",1,0],["وقد جرَّبوا لحمي فذاقوا مرارةً","نَهتهُمْ فكفُّوا غيرَ خَرْقِ الأوارمِ",26,"م",1,0],["وقد جعلتَ لدعوى طاعنٍ سبباً","فلا تُبرهنْ على الدعوى إذا طعنا",27,"ن",2,0],["وَقَد جَعَلَ اللَهُ الخِلافَةَ فيكُمُ","لِأَبيَضَ لا عاري الخِوانِ وَلا جَدبِ",28,"ب",1,0],["وَقَد جارَيتُ قَد عَلِمَت مَعَدٌّ","بِلا واني اليَدَينِ وَلا قَصيرِ",29,"ر",1,0],["وَقَد جَعَلتُ كِتابَ العَتبِ مُختَصَراً","إِذا اِلتَقَينا لَهُ شَرحٌ وَتِبيانُ",30,"ن",1,0],["وَقَد جاوَرتُهُم فَرَأَيتُ سَعداً","شَعاعَ الأَمرِ عازِبَةَ الحُلومِ",31,"م",1,0],["وَقَد جابَ في سَكَراتِ الكَرى","عُروضَ اللَيالي وَأَطوالَها",32,"ل",3,0],["وقد جفَا مقلتِي نومي جفاءَكم","فما يذوقُ حثاثَ النوم أجفاني",33,"ي",1,0],["وَقَد جَرَّبوا بِالأَمسِ مِنكَ عَزيمَةً","فَضَلتَ بِها السَيفَ الحُسامَ المُجَرَّبا",34,"ب",2,0],["وَقَد جَزِعَت جَلدٌ وَلَولاكَ لَم يَكُن","لِيَجزَعَ مِن صَرفِ الزَمانِ جَليدُها",35,"د",3,0],["وَقَد جاوَرَت أَرضَ الأَعادي وَأَصبَحَت","حِماً وَصلُها مُذ جاوَرَت أَبرَقَ الحِمى",36,"م",2,0],["وَقَد جَعَلَت لِلدينِ في المَرجِ بِالقَنا","لِمَروانَ أَيّامٌ عِظامُ المَلاحِمِ",37,"م",1,0],["وقَد جاءتْ مدائحُنا نُقوداً","فلا تَجعَل جوائزَها نَسايا",38,"ا",3,0],["وقد جرَتْ خيلُ راحِنا خَبَباً","في جَرْيِها أو همَمْنَ بالخَبَبِ",39,"ب",1,0],["وقد جُمِعَ الحُسْنُ في روضةٍ","وفرَّقَ دِجلةُ فيه شُعوبا",40,"ب",2,0],["وَقَد جَرَّبتُماني في أُمورٍ","يُعاشُ بِمِثلِها لَو تَعقِلانِ",41,"ن",1,0],["وَقَد جاءَ في القُرآنِ إِثباتُ نَفعِها","وَلَكِنَّ فيهِ مِن تَوابِعِها إِثمُ",42,"م",1,0],["وَقَد جُمِعَت لِيَ اللَذّاتُ لَمّا","دَنَت مِنها قُطوفُ الجَنَّتَينِ",43,"ن",1,0],["وَقَد جَلا نورُ وَجهِهِ","الغَسَقا",44,"ق",2,0],["وقد جعل الله ذا الصخرَ بي","ن الحياةِ وبين البلى موبقَا",45,"ق",2,0],["وقد جُبِلَ الغانياتُ الصّغارُ","على بُغْضِهِنّ الشيوخَ الكبارا",46,"ر",2,0],["وَقَد جَرى في الَّذي جاؤوا به قَدَرٌ","ولا مَرَدّ لما يجري به القَدَرُ",47,"ر",1,0],["وقد جعلوا لهم شُرُعَ الشواني","مَعَ الأَرواحِ أَجنِحَةً وطاروا",48,"ر",3,0],["وَقَد جاءَنا أَنَّ تِلكَ الحُروبَ","إِذا حُدِيَت فَاِلتَوَت بِالحُداءِ",49,"ا",2,0],["وَقَد جالَ مِن كَأسِ السُلافَةِ أَشقَرٌ","يُسابِقُهُ مِن جَدوَلِ الماءِ أَشهَبُ",50,"ب",1,0],["وَقَد جاشَ بَحرٌ بَينَ جَنبَيَّ مائِجٌ","لَهُ زَخرَةٌ في وَجنَتَيَّ وَعُبابُ",51,"ب",1,0],["وَقَد جَلا الحُسنُ لَهُ سُنَّةً","يُلقى بِها المَعذولُ مَعذورا",52,"ر",2,0],["وَقَد جالَ دَمعُ القَطرِ في مُقلَةِ الدُجى","وَلَفَّت نَواصي الخَيلِ نَكباءُ زَعزَعُ",53,"ع",1,0],["وَقَد جاذَبَت ريحُ الصَبا غُصنَ النَقا","فَمادَ عَلى رِدفِ الكَثيبِ وَمالا",54,"ل",2,0],["وَقَد جالَ مِن جَونِ الغَمامَةِ أَدهَمٌ","لَهُ البَرقُ سَوطٌ وَالشَمالُ عِنانُ",55,"ن",1,0],["وَقَد جَدَّ بي وَجدي وَفاضَت مَدامِعي","وَقَد زادَ ما اِنضَمَّت عَلَيهِ الأَضالِعُ",56,"ع",1,0],["وقد جَرتِ الدِّماءُ على الرغامِ","ألا أيقِظْ أخاك من المنامِ",57,"م",1,0],["وقَد جَعلوا سوطَهُ مِغولاً","إِذا يَمَّموهُ فَفاهَ كلم",58,"م",1,0],["وَقَد جَمَّعتُ ما يُلهي","فَلَم أَترُك وَلَم أَذَرِ",59,"ر",1,0],["وقد جعلت تبأى علينا بقومها","وفي وجهها شغل عن الفخر شاغل",60,"ل",1,0],["وقد جاشَتِ الدأماءُ بِيضاً صَوارِماً","ومارنَةً سُمْراً وفَضْفاضَةً زَغْفا",61,"ف",2,0],["وقد جاوزَ الاسكندريّةَ جوهَرٌ","تُطالعُه البُشرَى ويقْدُمُه النَّصْر",62,"ر",1,0],["وَقَد جَرَّعَني كَأساً","لَها في القَلبِ نيرانُ",63,"ن",1,0],["وَقَد جاءَني مِن باهِلِيٍّ يَسُبُّني","فَأَعرَضتُ إِنَّ الباهِلِيَّ جَنيبي",64,"ب",2,0],["وَقَد جَرَّبتُكُم فَوَجَدتُ جَهلاً","مُبيناً في السِباطِ وَفي الجِعادِ",65,"د",1,0],["وَقَد جَهَّزَت لِلعَقلِ راحاً تَغولُهُ","فَدَعها وَلا تَشرَب طِلاءً وَلا مِزرا",66,"ر",2,0],["وَقَد جَنى الإِثمَ تَغشاهُ صَحابَتُهُ","وَالنَبلُ وَالسَيفُ وَالخَطّيُّ وَالفَرَسُ",67,"س",1,0],["وَقَد جاءَ غافِلَنا رِزقُهُ","وَإِن كانَ لِلقوتِ لَم يَحتَرِف",68,"ف",1,0],["وَقَد جارَ القُضاةُ إِذا أَشاروا","بِأَيسَرِ نَظرَةٍ مُتَحامِلينا",69,"ن",2,0],["وَقَد جاءَ أن البنت دلبر نابها","عياء من الجدريّ بالمَوت ينذر",70,"ر",1,0],["وَقَد جاهدت مصر الفتية دونه","وَبعد جهاد طال قد أَفلحت مصر",71,"ر",1,0],["وقد جعل الإسلام أمر بتاته","ثلاثاً ليكفي الوقت من هو يندم",72,"م",1,0],["وقد جرى ضوؤه الغريرُ","يستشرف الأُفْقَ والعُبابا",73,"ب",2,0],["وَقَد جُمِعَت مِنها خُمورٌ ثَلاثَةٌ","وَفي واحِدٌ سُكرٌ يَزيدُ عَلى السُكرِ",74,"ر",1,0],["وَقَد جَلَبا حَيناً لِمَصرَعِ مالِكٍ","وَكانَ كَريماً ماجِداً لِهِجانِ",75,"ن",1,0],["وَقَدْ جَهِلُوا الْبَيْتَ نَبْنِيه فَذّاً","فَيَسْتَغْرِبُ الأَمَدُ الأَبْعَدَا",76,"د",2,0],["وَقَد جَحَظت أَلَماً عَينُهُ","وَعَهدي بِها تُبرئ الجحَّظا",77,"ظ",2,0],["وقد جمعا في كلمة مستبينة","على مثلكم تخفى ومن مثلكم تبدو",78,"و",1,0],["وَقَد جَحَظَت مُزوَرَّتانِ وَما كَفى","جحوظُهُما حَتّى أَسيلَ أَسيلُ",79,"ل",1,0],["وقد جمعنا من الألحانِ أُغْنِيةً","لو يفهمُ الطيرُ معناها لغنَّاها",80,"ا",3,0],["وقد جيد الأملاك مني قلادة","وكم زان حسن الجيد حسن المقلد",81,"د",1,0],["وقد جئتم بها شعوا","ء أشابت مفرق الطفل",82,"ل",1,0],["وقد جُنَّ وركُكِ من غَيظِه","سَمينٌ يُناهِضُه أعجَف",83,"ف",1,0],["وقد جاشَ صدرُ الشعبِ يَغلى حفيظةً","عليكم كما يغلي على النار مِرجل",84,"ل",1,0],["وَقد جاوَزَتْ أرْضَ الأَعادِي وأصْبَحَتْ","حِمَى وَصْلِها مذ جاوَرَتْ أبرَقَ الحِمَى",85,"م",2,0],["وقد جوانحنا، البُهر عُذِرتْ في نوْحِها وغنائِها","، فلمّا أطالَتْ فيهما بَطَلَ العُذْر",86,"ر",1,0],["وقد جعلَ اللهُ الخلافة َ فيكُمُ","بأبْيضَ، لا عاري الخِوَانِ، ولا جَدْبِ",87,"ب",1,0]]}