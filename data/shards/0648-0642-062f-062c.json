ى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[460,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[460,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[460,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[460,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[460,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[463,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[465,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[466,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[466,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[472,"وقد جئت الطبيب لسقم نفسي","https://www.aldiwan.net/poem4842.html","الوافر"],[472,"يرى حسرة أن تصقب الدار مرة","https://www.aldiwan.net/poem4846.html","الطويل"],[472,"وما زال من قلبي لسودة ناصر","https://www.aldiwan.net/poem4847.html","الطويل"],[479,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[484,"فتنت بشمس الحسن لما تسترت","https://www.aldiwan.net/poem24278.html","الطويل"],[502,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[516,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[517,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[517,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[531,"نظام هو الدر الثمين منضدا","https://www.aldiwan.net/poem37444.html","الطويل"],[540,"يا رب أنت رازق العباد","https://www.aldiwan.net/poem47427.html","عموديه"],[540,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[540,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[553,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[553,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[553,"أشيبا ولما تمض خمسون حجة","https://www.aldiwan.net/poem47216.html","الطويل"],[553,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[553,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[553,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[553,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[553,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[560,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[560,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[560,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[560,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[560,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[564,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[568,"صحا من تصابيه الفؤاد المشوق","https://www.aldiwan.net/poem1929.html","الطويل"],[569,"بليت بحب ناسكة","https://www.aldiwan.net/poem69750.html","مجزوء الوافر"],[577,"رأيت الرضي وما ناله","https://www.aldiwan.net/poem2823.html","المتقارب"],[577,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[588,"لحاظ الظبا تحكى الظبي في المضارب","https://www.aldiwan.net/poem17435.html","الطويل"],[589,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[589,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[589,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"],[589,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[589,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[589,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[756,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[511,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[858,"","https://poetry.dctabudhabi.ae/diwan/poem/132486","الطويل"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10407","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22535","الوافر"],[962,"","https://poetry.dctabudhabi.ae/diwan/poem/96116","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/29395","المتقارب"],[1171,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"]],"verses":[["وَقَد جَعَلَ الزَمانُ يُضيءُ وَجهي","وَيَرفَعُ ناظِري وَيَمُدُّ باعي",0,"ع",2,0],["وَقَد جُدتُ بِالنُعمى عَليكَ لِأَنَّني","حَلَلتُ عُرى ضِغنى وَكَفكَفتُ مِن وِتري",1,"ر",2,0],["وَقَد جَثَمَ الرَدى في كُلِّ سَهمٍ","لَهُ في كُلِّ حَيزومٍ مَطارُ",2,"ر",1,0],["وَقَد جابَ الذَميلُ عَليكَ وَهناً","مِنَ الظَلماءِ مَدرَعَةً وَساجا",3,"ج",2,0],["وَقَدْ جَهِلَتْ أنِّي أَسُورُ إِلى العُلا","وَيَعْيَى بِها مَنْ لَمْ يُساعِدْهُ دَهْرُهُ",4,"ر",2,0],["وَقَدْ جَعَلْتُ مَرادَ الطَّرَفِ غَيْر مَهاً","يَهْزُزْنَ في المَشْي أَغْصانَاً على كُثُبِ",5,"ب",1,0],["وقد جَعَلَتْ على خَفَرٍ تَراءى","فتُخفي من محاسِنِها وتُبْدي",6,"د",2,0],["وَقَد جَرَحَت عَيناهُ قَلبي فَأَصبَحَت","مُكَلَّمَةً أَوساطُهُ وَجَوانِبُه",7,"ب",2,0],["وقدْ جنَحوا للسِّلْمِ فاجْنَحْ تفضُّلاً","فَما مِنْهُمُ عيْنٌ منَ الرُّعْبِ تطْرِفُ",8,"ف",1,0],["وَقَدْ جَعَلَتْ تَفْلِي بِإَنْمُلِهَا الْفَلاَ","وَيُرْسَلُ مِنْهَا فِي غَدَائِرِهِ مُشْطُ",9,"ط",1,0],["وَقَد جَرَّبونا قَبلَها في وَقائِعٍ","تعلّم غُمر القَومِ منّا بِها الطَعنا",10,"ن",2,0],["وَقَد جَعَلَت أَشجانَ بِركٍ يَمينَها","وَذاتَ الشِمال مِن مُريخَةَ أَشأَما",11,"م",2,0],["وَقَد جَاوَزنَ هَضبَ قُتائداتٍ","وَعَنَّ لَهُنَّ مِن رَكَكٍ شُروجُ",12,"ج",1,0],["وَقَد جَعَلَت في نَفسِها أَن تَخافَهُ","وَلَيسَ لَها مِنهُ سَلامٌ وَلا حَربُ",13,"ب",1,0],["وَقَد جَرَّدَ الأَبطالُ بيضاً كَأَنَّها","مَصابيحُ تَذكو بِالذُبالِ المُفَتَّلِ",14,"ل",1,0],["وَقَد جَعَلوا السَبِيَّةَ عَن يَمينٍ","مَقادَ المُهرِ وَاِعتسَفَوا الرِمالا",15,"ل",2,0],["وَقَد جَعَلَتَ زُرقَ الوَشيجِ حُداتُها","يَميناً وَحوضى عَن شَمالِ المَرافِقِ",16,"ق",1,0],["وَقَد جَعَلَ الحِرباءُ يَبيَضُ لَونُهُ","وَيَخضَرُّ مِن لَفحِ الهَجيرِ غَباغِبُه",17,"ب",2,0],["وقد جلّلته بردة سندسيّة","ومن تحتها دِرعِ إلهية السرد",18,"د",1,0],["وَقَد جَرَّبتَني فَعَرَفتَ أَنّي","عَلى خَطَرِ المُراهِنِ غَيرُ كابي",19,"ب",2,0],["وَقَد جَلَّت نِساءُ بَني نُمَيرٍ","وَما عَرَفَت أَنامِلُها الخِضابَ",20,"ب",1,0],["وَقَد جَرَّبَ الهِرماسُ وَقعَ سُيوفِنا","وَصَدَّعنَ عَن رَأسِ اِبنِ كَبشَةَ مِغفَرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","لِئالِ أَبي قابوسَ يَوماً مُذَكَّرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","مَجَرّاً لِذي التاجِ الهُمامِ وَمَصرَعا",22,"ع",2,0],["وَقَد جَرَّبَ الهِرماسُ أَنَّ سُيوفَنا","عَضَضنَ بِرَأسِ الكَبشِ حَتّى تَصَدَّعا",22,"ع",2,0],["وقد جُرِّبتْ منهُ على آلِ مَخْلدٍ","تجاربُ ليستْ مثلهنَّ تجاربُ",23,"ب",1,0],["وقد جهور في الصوت","بصدر أيّما صدر",24,"ر",1,0],["وقد جلدوها الحد وهْي بريئةٌ","فحيَّ على دفن الشهيدة تؤجروا",25,"ر",3,0],["وقد جرَّبَ المنصورُ منهم نصيحةً","وجدّاً سعيداً نِعْم ركنُ المُزاحِمِ",26,"م",1,0],["وقد جرَّبوا لحمي فذاقوا مرارةً","نَهتهُمْ فكفُّوا غيرَ خَرْقِ الأوارمِ",26,"م",1,0],["وقد جعلتَ لدعوى طاعنٍ سبباً","فلا تُبرهنْ على الدعوى إذا طعنا",27,"ن",2,0],["وَقَد جَعَلَ اللَهُ الخِلافَةَ فيكُمُ","لِأَبيَضَ لا عاري الخِوانِ وَلا جَدبِ",28,"ب",1,0],["وَقَد جارَيتُ قَد عَلِمَت مَعَدٌّ","بِلا واني اليَدَينِ وَلا قَصيرِ",29,"ر",1,0],["وَقَد جَعَلتُ كِتابَ العَتبِ مُختَصَراً","إِذا اِلتَقَينا لَهُ شَرحٌ وَتِبيانُ",30,"ن",1,0],["وَقَد جاوَرتُهُم فَرَأَيتُ سَعداً","شَعاعَ الأَمرِ عازِبَةَ الحُلومِ",31,"م",1,0],["وَقَد جابَ في سَكَراتِ الكَرى","عُروضَ اللَيالي وَأَطوالَها",32,"ل",3,0],["وقد جفَا مقلتِي نومي جفاءَكم","فما يذوقُ حثاثَ النوم أجفاني",33,"ن",2,0],["وَقَد جَرَّبوا بِالأَمسِ مِنكَ عَزيمَةً","فَضَلتَ بِها السَيفَ الحُسامَ المُجَرَّبا",34,"ب",2,0],["وَقَد جَزِعَت جَلدٌ وَلَولاكَ لَم يَكُن","لِيَجزَعَ مِن صَرفِ الزَمانِ جَليدُها",35,"د",3,0],["وَقَد جاوَرَت أَرضَ الأَعادي وَأَصبَحَت","حِماً وَصلُها مُذ جاوَرَت أَبرَقَ الحِمى",36,"م",2,0],["وَقَد جَعَلَت لِلدينِ في المَرجِ بِالقَنا","لِمَروانَ أَيّامٌ عِظامُ المَلاحِمِ",37,"م",1,0],["وقَد جاءتْ مدائحُنا نُقوداً","فلا تَجعَل جوائزَها نَسايا",38,"ا",3,0],["وقد جرَتْ خيلُ راحِنا خَبَباً","في جَرْيِها أو همَمْنَ بالخَبَبِ",39,"ب",1,0],["وقد جُمِعَ الحُسْنُ في روضةٍ","وفرَّقَ دِجلةُ فيه شُعوبا",40,"ب",2,0],["وَقَد جَرَّبتُماني في أُمورٍ","يُعاشُ بِمِثلِها لَو تَعقِلانِ",41,"ن",1,0],["وَقَد جاءَ في القُرآنِ إِثباتُ نَفعِها","وَلَكِنَّ فيهِ مِن تَوابِعِها إِثمُ",42,"م",1,0],["وَقَد جُمِعَت لِيَ اللَذّاتُ لَمّا","دَنَت مِنها قُطوفُ الجَنَّتَينِ",43,"ن",1,0],["وَقَد جَلا نورُ وَجهِهِ","الغَسَقا",44,"ق",2,0],["وقد جعل الله ذا الصخرَ بي","ن الحياةِ وبين البلى موبقَا",45,"ق",2,0],["وَقَد جِئتُم بِها شَعوا","ءَ شابَت مَفرِقَ الطِفلِ",46,"ل",1,0],["وقد جُبِلَ الغانياتُ الصّغارُ","على بُغْضِهِنّ الشيوخَ الكبارا",47,"ر",2,0],["وَقَد جَرى في الَّذي جاؤوا به قَدَرٌ","ولا مَرَدّ لما يجري به القَدَرُ",48,"ر",1,0],["وقد جعلوا لهم شُرُعَ الشواني","مَعَ الأَرواحِ أَجنِحَةً وطاروا",49,"ر",3,0],["وَقَد جاءَنا أَنَّ تِلكَ الحُروبَ","إِذا حُدِيَت فَاِلتَوَت بِالحُداءِ",50,"ا",2,0],["وَقَد جالَ مِن كَأسِ السُلافَةِ أَشقَرٌ","يُسابِقُهُ مِن جَدوَلِ الماءِ أَشهَبُ",51,"ب",1,0],["وَقَد جاشَ بَحرٌ بَينَ جَنبَيَّ مائِجٌ","لَهُ زَخرَةٌ في وَجنَتَيَّ وَعُبابُ",52,"ب",1,0],["وَقَد جَلا الحُسنُ لَهُ سُنَّةً","يُلقى بِها المَعذولُ مَعذورا",53,"ر",2,0],["وَقَد جالَ دَمعُ القَطرِ في مُقلَةِ الدُجى","وَلَفَّت نَواصي الخَيلِ نَكباءُ زَعزَعُ",54,"ع",1,0],["وَقَد جاذَبَت ريحُ الصَبا غُصنَ النَقا","فَمادَ عَلى رِدفِ الكَثيبِ وَمالا",55,"ل",2,0],["وَقَد جالَ مِن جَونِ الغَمامَةِ أَدهَمٌ","لَهُ البَرقُ سَوطٌ وَالشَمالُ عِنانُ",56,"ن",1,0],["وَقَد جَدَّ بي وَجدي وَفاضَت مَدامِعي","وَقَد زادَ ما اِنضَمَّت عَلَيهِ الأَضالِعُ",57,"ع",1,0],["وقد جَرتِ الدِّماءُ على الرغامِ","ألا أيقِظْ أخاك من المنامِ",58,"م",1,0],["وقَد جَعلوا سوطَهُ مِغولاً","إِذا يَمَّموهُ فَفاهَ كلم",59,"م",1,0],["وَقَد جَمَّعتُ ما يُلهي","فَلَم أَترُك وَلَم أَذَرِ",60,"ر",1,0],["وقد جعلت تبأى علينا بقومها","وفي وجهها شغل عن الفخر شاغل",61,"ل",1,0],["وقد جاشَتِ الدأماءُ بِيضاً صَوارِماً","ومارنَةً سُمْراً وفَضْفاضَةً زَغْفا",62,"ف",2,0],["وقد جاوزَ الاسكندريّةَ جوهَرٌ","تُطالعُه البُشرَى ويقْدُمُه النَّصْر",63,"ر",1,0],["وَقَد جَرَّعَني كَأساً","لَها في القَلبِ نيرانُ",64,"ن",1,0],["وَقَد جاءَني مِن باهِلِيٍّ يَسُبُّني","فَأَعرَضتُ إِنَّ الباهِلِيَّ جَنيبي",65,"ب",2,0],["وَقَد جَرَّبتُكُم فَوَجَدتُ جَهلاً","مُبيناً في السِباطِ وَفي الجِعادِ",66,"د",1,0],["وَقَد جَهَّزَت لِلعَقلِ راحاً تَغولُهُ","فَدَعها وَلا تَشرَب طِلاءً وَلا مِزرا",67,"ر",2,0],["وَقَد جَنى الإِثمَ تَغشاهُ صَحابَتُهُ","وَالنَبلُ وَالسَيفُ وَالخَطّيُّ وَالفَرَسُ",68,"س",1,0],["وَقَد جاءَ غافِلَنا رِزقُهُ","وَإِن كانَ لِلقوتِ لَم يَحتَرِف",69,"ف",1,0],["وَقَد جارَ القُضاةُ إِذا أَشاروا","بِأَيسَرِ نَظرَةٍ مُتَحامِلينا",70,"ن",2,0],["وقد جعلت أن الجديد إلى بلى","منازل سلمى بالمراضين تدرس",71,"س",1,0],["وَقَد جاءَ أن البنت دلبر نابها","عياء من الجدريّ بالمَوت ينذر",72,"ر",1,0],["وَقَد جاهدت مصر الفتية دونه","وَبعد جهاد طال قد أَفلحت مصر",73,"ر",1,0],["وقد جعل الإسلام أمر بتاته","ثلاثاً ليكفي الوقت من هو يندم",74,"م",1,0],["وقد جرى ضوؤه الغريرُ","يستشرف الأُفْقَ والعُبابا",75,"ب",2,0],["وَقَد جُمِعَت مِنها خُمورٌ ثَلاثَةٌ","وَفي واحِدٌ سُكرٌ يَزيدُ عَلى السُكرِ",76,"ر",1,0],["وَقَد جَلَبا حَيناً لِمَصرَعِ مالِكٍ","وَكانَ كَريماً ماجِداً لِهِجانِ",77,"ن",1,0],["وَقَدْ جَهِلُوا الْبَيْتَ نَبْنِيه فَذّاً","فَيَسْتَغْرِبُ الأَمَدُ الأَبْعَدَا",78,"د",2,0],["وَقَد جَحَظت أَلَماً عَينُهُ","وَعَهدي بِها تُبرئ الجحَّظا",79,"ظ",2,0],["وقد جمعا في كلمة مستبينة","على مثلكم تخفى ومن مثلكم تبدو",80,"د",2,0],["وَقَد جَحَظَت مُزوَرَّتانِ وَما كَفى","جحوظُهُما حَتّى أَسيلَ أَسيلُ",81,"ل",1,0],["وقد جمعنا من الألحانِ أُغْنِيةً","لو يفهمُ الطيرُ معناها لغنَّاها",82,"ا",3,0],["وقد جيد الأملاك مني قلادة","وكم زان حسن الجيد حسن المقلد",83,"د",1,0],["وقد جئتم بها شعوا","ء أشابت مفرق الطفل",84,"ل",1,0],["وقد جُنَّ وركُكِ من غَيظِه","سَمينٌ يُناهِضُه أعجَف",85,"ف",1,0],["وقد جاشَ صدرُ الشعبِ يَغلى حفيظةً","عليكم كما يغلي على النار مِرجل",86,"ل",1,0],["وَقد جاوَزَتْ أرْضَ الأَعادِي وأصْبَحَتْ","حِمَى وَصْلِها مذ جاوَرَتْ أبرَقَ الحِمَى",87,"م",2,0],["وقد جوانحنا، البُهر عُذِرتْ في نوْحِها وغنائِها","، فلمّا أطالَتْ فيهما بَطَلَ العُذْر",88,"ر",1,0],["وقد جعلَ اللهُ الخلافة َ فيكُمُ","بأبْيضَ، لا عاري الخِوَانِ، ولا جَدْبِ",89,"ب",1,0],["وَقَد جَمَعَ الإِلَهُ لَدَيك ما قَد","تَفرَّق في البَريّة مِن حُلاكا",90,"ك",2,0],["وقد جلا وجهك بالنور من","شمس الضحى وبالسنا جللك",91,"ك",1,0],["وقد جعلوا في طي لب قلوبهم","قبورا لاشكال تنزه عن نقل",92,"ل",1,0],["وقد جانس الاضداد عن غير حكمة","وخلا مسئيا غادرا خله الوفي",93,"ف",2,0],["وقد جاء نعم العبد بالنص خالد","فيا حسنها من نعمة عند ناقد",94,"د",1,0],["وقد جمع الأشتات في سلك حاله","فمقلته وسنا ومهجته حرا",95,"ر",2,0],["وقد جررت ولم أحفل بلومهم","بين الخرابيش عند الزط أرداني",96,"ن",2,0],["وقد جرعتني بالنوى مضض الهوى","لتمنع من عذب الوصال معينهَا",97,"ه",2,0],["وقَد جَاءَ هَذَا في الظُّرُوفِ مَُخَبَّاً","فَمَهمَا تُطَالِعهَا الجَنَى مِنهُ تقطِفِ",98,"ف",1,0],["وَقَد جَمَعَت له الأيدِى المَعَالِى","وفَرَّقَتِ المَجَالِيحَ العِتَاقَا",99,"ق",2,0],["وقد جَرَى العدلُ فيما أَنتَ تَنظُمُهُ","مِنَ القَوانِينِ مَجرَى الرُّوحِ في الجَسَدِ",100,"د",1,0],["وًقَد جذبَت إِليهِ يَدٌ المَعَالِى","طَرِيفَ المَجدِ والمَجدَ التَّلِيدَا",101,"د",2,0],["وَقَد جرِّبوا فيما مَضى غِبَّ أَمرِهِم","وَما عالمٌ أَمراً كَمَن لَم يُجَرِّبِ",102,"ب",1,0],["وقد جعلوا عذَر حرماننا الثَّ","وابَ خلَّوهُمُ من فَهمْ",103,"م",1,0],["وَقَد جَلَّلَ الأَرضَ غَيمُ القِطارِ","وَجادَ الثَرى عارِضٌ مُنسَكِب",104,"ب",1,0],["وَقَد جَرى القَلَمُ الأَعلى بِنُصرَتِهِ","فَقَبلَ يُدعى بِهِ مُستَنصِراً نُصِرا",105,"ر",2,0],["وقد جاء في التّأفيف ما فيه عبرة","تدلَّ على ما فوقها فتأدَّب",106,"ب",1,0],["وَقَد جاءَهُ مِنهُ لِيُظهِرَ فَضلَهُ","كِتابٌ عَزيزٌ أَعجَزَ الخَلقَ كُلَّهُ",107,"ه",1,0],["وَقَدْ جَمَعَ الوَقْتُ حَالَيْهِما","فَمَنْ ذا يُفِيقُ وَمَنْ يَسْتَفِيقُ",108,"ق",1,0],["وقد جئتكم مستشفعاً في خلاصةٍ","بفضل أياديك التي دونها السحبُ",109,"ب",1,0],["وقد جرى بعض ما تهدي عواقبه","خيراً وإنى لذاك الخير منتظرُ",110,"ر",1,0],["وقد جربوا في الحرب والسلم أحمداً","فما فيه الا حين ترضيه مطمع",111,"ع",1,0],["وقد جرى تبر خديه بوجنته","ماء به ازداد جمر الخد في ضرمه",112,"م",2,0],["وقد جرب الأعدا لقاك فما رأوا","لحربك إقداما يفيد ولا جبنا",113,"ن",2,0],["وقد جمعت شملهم كعقد","جمعن به الفرائد في نظام",114,"م",1,0],["وقد جاء علم أن كفار قطره","غشوه وقد أضحى ببعض الجزائر",115,"ر",1,0],["وَقَد جاءَهُم مِنهُ النَّذيرُ لِيَأخُذُوا","مِنَ البِرِّ عَن جَوزِ الطَّريقِ بِجانِبِ",116,"ب",1,0],["وَقَد جَعَلت نَخلَين خَلفَاً وَيَمَّمَت","قُرى الشامِ أَو أَرضَ العِراقِ نجُوعُها",117,"ع",3,0],["وَقَد جاءَت الإِفرَنجُ مِن كُلِّ وجهَةٍ","كَأَنَّ تَداعيها السُيُولُ الدَوافِقُ",118,"ق",1,0],["وَقَد جُزِيَت بالوُدِّ سَلمضى وَمَا الهَوَى","بِمُستَجمِعٍ إِلاّ لمَن يَتَحَبَّبُ",119,"ب",1,0],["وَقَد جَعَلَت رَيّا الجَنُوبِ إِذَا جَرَت","عَلَى طِيبِهَا تَندَى لَنَا وَتَطِيبُ",120,"ب",1,0],["وَقَد جَعَلَ الوَاشُونَ عَمداً لَيَعلَمُوا","أَلِي مِنكِ أَم لاَ ياأُمَيمَ نَصِيبُ",120,"ب",1,0],["وقد جَرَّرت ريحُ الصَّبا فَضْلَ بُرْدِها","مُنَدًّى على بُسْطِ الرِّياض النَّوافح",121,"ح",1,0],["وقد جاد مَدْحِي فيك لما رأيتُ ما","رأى فاسْتَوىَ المدْحَان والإبنُ والجَدّ",122,"د",1,0],["وَقد جاءَ في القرآنِ ذكرُ فَسادِهم","وَزَعمهمُ الإصلاحَ في السورة الزهرا",123,"ر",2,0],["وَقَد جاءَ في الأخبارِ وصفُ مُروقهم","منَ الدينِ مثلَ السهمِ للجهةِ الأخرى",123,"ر",2,0],["وَقَد جاوَزوا أَطوارَهم ودوابهم","عَلى حالِها ما جاوَزَت مِثلَهُم طَورا",123,"ر",2,0],["وَقَد جَعلوا لي حصّةً من كبارها","لما عَلِموا مِن حبّه حصّتي كبرى",123,"ر",2,0],["وَقَد جَعلوا عيداً لهم يوم صلبهِ","فَكم طَبلوا طبلاً وكم زمروا زمرا",124,"ر",2,0],["وَقَد جعلَ المختارُ كالأهل حكمهُ","فَلا غروَ أَن خلّى أباهُ وعمّه",125,"ه",1,0],["وقد جَمَعَ الحسنُ فيه مع النب","لِ نوراً وطيبَ ذكاءِ",126,"ا",2,0],["وقد جَدَّ عزمي على رحلةٍ","أُجدِّد فيها صلات الرَّحِم",127,"م",1,0],["وقد جاوَبَ الزِّيرُ في جَذْبِه","مع البَمِّ ترجيعَ صوتِ المثَاني",128,"ن",2,0],["وقد جادني المَلْكُ الهمام فخصَّني","بِملْكٍ من الدُّهْم المطهَّمة الغُرّ",129,"ر",1,0],["وقد جاد من لم يجِد","وأنجز من لم يعِد",130,"د",1,0],["وَقَد جُمِعَت فيهِ شيناتُهُ","شَرابٌ وَشَمعٌ وَشَهدٌ وَشاهِد",131,"د",1,0],["وَقَد جاوَزنَ مِن غُمدانَ أَرضاً","لِأَبوالِ البِغالِ بِها وَقيعُ",132,"ع",1,0],["وقد جرى منه الذي قد جرى","وعوتب الصديق في حقهِ",133,"ق",2,0],["وَقَد جاءَتك يا كفوءاً كَفيّاً","تزفّ اليكَ طالِبَة اِمتياح",134,"ح",1,0],["وقد جُمعت فيها الشمائل كلّها","ففاق الورى باللفظ واللحظ واليد",135,"د",1,0],["وقد جئت زور الوزر بالغيب راجماً","لنا بمقال السوء من ظنّك المُردي",136,"د",2,0],["وقد جاءك العيد الذي أنت عيده","وعيد الذي أضحى فضحى وعيدا",137,"د",2,0],["وقَد جَعَلَتْ تَشتدُّ نحوَ خِبائها","لِتَخْبَأ نوراً مذْ تلألأَ ما خبَا",138,"ب",2,0],["وَقَدْ جَعل الهَيْجا رِياضاً خِلالَها","يُفجِّر أنْهارَ الدّماء الصّوائِبِ",139,"ب",1,0],["وَقَد جَمَعوا جَمعَهُم كُلَّهُ","وَجَمع الرِبابِ لَنا مُستَعارا",140,"ر",2,0],["وَقَدْ جاشَ مِنْ أَرْضِ إِفْرَنْجَةٍ","جُيُوشٌ كَمِثْلِ جِبالٍ تَرَدّا",141,"د",2,0],["وَقَد جالَتِ الأَكرادُ بِالسُمرِ وَالظُبى","تصيد المُلوكَ الصَّيدَ وَالأُسُدَ الشوسا",142,"س",2,0],["وَقَد جَعَلتُ إِذا ما قُمتُ يُثقِلني","ثَوبي فَأَنهَضُ الشارِبِ السَكِرِ",143,"ر",1,0],["وقد جمع الأسرار والأمر كله","محمد المبعوث للخلق رحمة",144,"ه",1,0],["وَقَد جلّل الريحانُ والروحُ روضةً","حَوَتك وَروّاها الرِّضا مُتوكّفا",145,"ف",2,0],["وَقد جلّ من نال الملوك إسارهُ","وَأعظم منه مَن لإطلاقِهم هبّا",146,"ب",2,0],["وَقَد جَلَّلَ رَعداهُ","فَلا ذَمٌّ لِرَعدَيهِ",147,"ي",2,0],["وقد جاء شوال فشالت نعامة الص","يام وأبد لنا النعيم من الضر",148,"ر",1,0],["وَقَد جاوَرَ الرَحمَنُ وَالحورُ أَرخَت","وَرَبّي في عَدنٍ مُقيمٍ عَلى اللَيثي",149,"ث",2,0],["وقد جاء هذا الحاشر الخاتم الذي","حوى كل خير في عموم الرسالة",150,"ه",1,0],["وَقَد جَعَلَت ضَغائِنُهُنَّ تَبدو","بِما قَد كانَ نالَ بِلا شَفيعِ",151,"ع",1,0],["وقد جُدْتُ بابْنٍ كان عزىَ روحُه","فها أنا منّي سوى جَسَدٍ مُضْنى",152,"ن",2,0],["وقد جعَل النّاسُ إلاّ الأقَلْ","لَ يُبدونَ عُرْفاً ويُخْفُونَ نُكرا",153,"ر",2,0],["وقد جرّ فوقَ الأنجمِ الذَّيلَ جرّةً","تَوشَّحها صرحُ السماء المُمَرَّد",154,"د",1,0],["وقد جبْت أرضاً كالجبال سُهولُها","فقُلْ في جبالٍ ثُمّ كيف تُجاب",155,"ب",1,0],["وَقد جَاوَزنَ من غُمدانَ داراً","لأَبوالِ البغالِ بها وَقيعُ",156,"ع",1,0],["وَقَد جاءَ قَبلَ النَيلِ نَيلُكَ سابِقاً","إِذا النيلُ في شُغلٍ مِنَ المَدِّ وَالجَزرِ",157,"ر",1,0],["وَقَد جَفَّت غِمارُ الوِردِ مِمّا","تَزاحَمَ في مَورِدِها الدَلاءُ",158,"ا",2,0],["وقد جازَ شُكري حَدَّه فالتمِس مَعي","نَديماً نكن فيما نُحاولُه مَعا",159,"ع",2,0],["وقد جاءَ القلندسُ بعد فطرٍ","وأيامي بذاكَ وذا حَيارى",160,"ر",2,1],["وقد جَمعوا أخبارَ من شفَّه الهوى","وتِلك أحاديثي وأخبارُ إخوتي",161,"ت",2,0],["وَقَد جاءَ تاريخُهُ","خِتان بِجود كَمل",162,"ل",1,0],["وَقَد جَرى أَكثَرُها","مِن دَمعي المُنحَدر",163,"ر",1,0],["وَقَد جَدَ في اتلاف نَفسي مَع الهَوى","وَاِنحَلَ جِسمي فَهُوَ أَوهى مِن العَهنِ",164,"ن",1,0],["وقد جاء في ذكر الإله فضائل","تسامت عن الإحصاء والعدو والحصر",165,"ر",1,0],["وَقَد جاهَدَ الأَعداءَ ابدءاً وَعودةً","وَكان سِواهُ في القِتالِ يُمَرِّدُ",166,"د",1,0],["وقد جعلَ التخيْيرَ غيرَ مُضيّقٍ","إلى العبدِ فلْيَذْهَبْ بما شاءه العبدُ",167,"د",1,0],["وقد جاريت جار اللّه فيما","أتى من علم تفسير القرآن",168,"ن",1,0],["وقد جاءنا من أرضه الشيخ مربد","فحقق من أحواله كل ما يبدي",169,"د",2,0],["وقد جاءنا عن ربنا في براءة","براءتهم عن كل كفر وعن جحد",169,"د",1,0],["وقد جاهد الصديق أصنافهم ولم","يكفر منهم غير من ضل عن رشد",169,"د",1,0],["وقد جاءت الأخبار عنه بأنه","يعيد لنا الشرع الشريف بما يبدي",170,"د",2,0],["وقد جمعت فيها الكمالات كلها","ومن جمعت فيه غدا وهو مفرد",171,"د",1,0],["وقد جعلوا المخرج شبه نص","ليحيى داعي الحق المجاب",172,"ب",1,0],["وقد جعل الشمسَ المنيرةَ تُرْسَه","مخافةَ عوْدِ الليل في ثأره حربا",173,"ب",2,0],["وقد جعلتْ حب الفتى الجاهَ صقرَها","وحُبَّ الثنا والمالَ قد جعلت كلبا",173,"ب",2,0],["وقد جَمَعَتْنا للمسرَّات ساعةٌ","هي العمرُ لا ما مرَرَّ في سالف العصر",174,"ر",1,0],["وقد جَمَعتْنا لِلّذائذ ساعةٌ","أحلَّتْ لنا بالسكر كلَّ حرام",175,"م",1,0],["وقد جاب وعر الشوق في بيد هجركم","ومن زاد تقواه عن العزل زوّدا",176,"د",2,0],["وقد جرّدوها بعد آل محمد","مثقَّفةً تدمى وبيض صفائح",177,"ح",1,0],["وقد جئت مسرور الفؤاد مؤيّداً","من الله بالتوفيق والفتح والنصر",178,"ر",1,0],["وقد جرت فيه أمواه الصفا فروت","من كوثر غدق ينبث كالدرر",179,"ر",1,0],["وقد جمعت في حسنها كل مقتض","وازهارها الحسناء في كف مقبض",180,"ض",1,0],["وقد جمع الله فيك الأنام","وليس عليه بمُسْتَنكَرِ",181,"ر",1,0],["وقد جنحتْ فيه الثريا كأنها","على عاتقِ الجوزاءِ قرطٌ معلقُ",182,"ق",1,0],["وقد جلّ رزء المؤمنين كأنّما","عليّ عليّ فالدموع رواذم",183,"م",1,0],["وَقَدْ جاءَتْ جُنودُ النصرِ زحفاً","تلوذُ بظلِّ أَكرمِ رايتَيْنِ",184,"ن",1,0],["وَقَدْ جاشَتْ جُيوشُ الموتِ فِيهَا","بأَهْوَلَ من توافي الأَيْهَمَيْنِ",184,"ن",1,0],["وَقَدْ جَدَعَتْ أُنوفَ العِزِّ منهُمْ","خطوبٌ سُمْتَهُمْ أَنفَ الإِباءِ",185,"ا",2,0],["وقد جعلوا أديانهم وعروضهم","على كل حال دون أديانهم ترسا",186,"س",2,0],["وقد جعلت سهيلاً من وراها","ونعشاً بالشمال المغربيه",187,"ي",2,0],["وقد جعلوا التقية أَصل دين","ولو شاة تناطح من سلاها",188,"ا",3,0],["وقد جاء دور الدين فانشرحت به","صدور ذوى التقوى وباركه الملا",189,"ل",2,0],["وقد جئتَ تحبوني ضيافة مشفقٍ","لدى كنفٍ حول الطبيعة ساحر",190,"ر",1,0],["وقد جرَّبتْنِيَ قِرْنا فما","وفَتْ بي فهلَّا اجتبتني قرينا",191,"ن",2,0],["وقد جرَّ شهرا عليَّ المُقام","وأنّيَ وجداً كأن لم أُقِمْ",192,"م",1,0],["وقد جرّبتني وخبرتَ قِدماً","فهل شيءٌ يُريبك من خصالي",193,"ل",2,0],["وقد جَنبَ الدهرُ من نفعه","منائحَ في حبل إصرارِهِ",194,"ر",2,0],["وقد جرَّبوا عزميك والجودُ ساكنٌ","على السَّلم والنقعُ الأغَمُّ مُثارُ",195,"ر",1,0],["وقد جعلَ الأمرَ من بعده","لحيدَرَ بالخبر المُسنَدِ",196,"د",1,0],["وقد جاء نجمٌ من جُمادَى بلَيلةٍ","بلَيلٍ يريك الطولُ أن ليس تُصبحُ",197,"ح",1,0],["وقد جربتْك الحادثاتُ فلا تكن","ضعيفَ القُوَى رِخواً لهنّ مَجاذِبُهْ",198,"ب",2,0],["وقد جرّبوه عاطلاً ومقلَّداً","وقادوه يَعْصِي حبلَهُ ويُجيبُ",199,"ب",1,0],["وقد جاءك الحمد المقيم حديثهُ","وحازَ لكَ الإقبالُ أمَّ الغَنائمِ",200,"م",1,0],["وقد جاء في القرآن ادع إِلى س","بيل ربك فاقرأ أو فسل كل من قرا",201,"ر",2,0],["وقد جرد الغيث بيض البروق","وأقسم ألا تحل الغمودا",202,"د",2,0],["وقد جمهتنا شملةُ الليل والهوى","كما اش