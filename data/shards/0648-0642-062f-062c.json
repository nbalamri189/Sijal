ويل"],[549,"أشيبا ولما تمض خمسون حجة","https://www.aldiwan.net/poem47216.html","الطويل"],[549,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[549,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[556,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[556,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[556,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[560,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[564,"صحا من تصابيه الفؤاد المشوق","https://www.aldiwan.net/poem1929.html","الطويل"],[565,"بليت بحب ناسكة","https://www.aldiwan.net/poem69750.html","مجزوء الوافر"],[573,"رأيت الرضي وما ناله","https://www.aldiwan.net/poem2823.html","المتقارب"],[573,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[584,"لحاظ الظبا تحكى الظبي في المضارب","https://www.aldiwan.net/poem17435.html","الطويل"],[585,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[585,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[585,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[585,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَقَد جَعَلَ الزَمانُ يُضيءُ وَجهي","وَيَرفَعُ ناظِري وَيَمُدُّ باعي",0,"ع",2,0],["وَقَد جُدتُ بِالنُعمى عَليكَ لِأَنَّني","حَلَلتُ عُرى ضِغنى وَكَفكَفتُ مِن وِتري",1,"ي",1,0],["وَقَد جَثَمَ الرَدى في كُلِّ سَهمٍ","لَهُ في كُلِّ حَيزومٍ مَطارُ",2,"ر",1,0],["وَقَد جابَ الذَميلُ عَليكَ وَهناً","مِنَ الظَلماءِ مَدرَعَةً وَساجا",3,"ج",2,0],["وَقَدْ جَهِلَتْ أنِّي أَسُورُ إِلى العُلا","وَيَعْيَى بِها مَنْ لَمْ يُساعِدْهُ دَهْرُهُ",4,"ر",2,0],["وَقَدْ جَعَلْتُ مَرادَ الطَّرَفِ غَيْر مَهاً","يَهْزُزْنَ في المَشْي أَغْصانَاً على كُثُبِ",5,"ب",1,0],["وقد جَعَلَتْ على خَفَرٍ تَراءى","فتُخفي من محاسِنِها وتُبْدي",6,"ي",1,0],["وَقَد جَرَحَت عَيناهُ قَلبي فَأَصبَحَت","مُكَلَّمَةً أَوساطُهُ وَجَوانِبُه",7,"ب",2,0],["وقدْ جنَحوا للسِّلْمِ فاجْنَحْ تفضُّلاً","فَما مِنْهُمُ عيْنٌ منَ الرُّعْبِ تطْرِفُ",8,"ف",1,0],["وَقَدْ جَعَلَتْ تَفْلِي بِإَنْمُلِهَا الْفَلاَ","وَيُرْسَلُ مِنْهَا فِي غَدَائِرِهِ مُشْطُ",9,"ط",1,0],["وَقَد جَرَّبونا قَبلَها في وَقائِعٍ","تعلّم غُمر القَومِ منّا بِها الطَعنا",10,"ن",2,0],["وَقَد جَعَلَت أَشجانَ بِركٍ يَمينَها","وَذاتَ الشِمال مِن مُريخَةَ أَشأَما",11,"م",2,0],["وَقَد جَاوَزنَ هَضبَ قُتائداتٍ","وَعَنَّ لَهُنَّ مِن رَكَكٍ شُروجُ",12,"ج",1,0],["وَقَد جَعَلَت في نَفسِها أَن تَخافَهُ","وَلَيسَ لَها مِنهُ سَلامٌ وَلا حَربُ",13,"ب",1,0],["وَقَد جَرَّدَ الأَبطالُ بيضاً كَأَنَّها","مَصابيحُ تَذكو بِالذُبالِ المُفَتَّلِ",14,"ل",1,0],["وَقَد جَعَلوا السَبِيَّةَ عَن يَمينٍ","مَقادَ المُهرِ وَاِعتسَفَوا الرِمالا",15,"ل",2,0],["وَقَد جَعَلَتَ زُرقَ الوَشيجِ حُداتُها","يَميناً وَحوضى عَن شَمالِ المَرافِقِ",16,"ق",1,0],["وَقَد جَعَلَ الحِرباءُ يَبيَضُ لَونُهُ","وَيَخضَرُّ مِن لَفحِ الهَجيرِ غَباغِبُه",17,"ب",2,0],["وقد جلّلته بردة سندسيّة","ومن تحتها دِرعِ إلهية السرد",18,"د",1,0],["وَقَد جَرَّبتَني فَعَرَفتَ أَنّي","عَلى خَطَرِ المُراهِنِ غَيرُ كابي",19,"ب",2,0],["وَقَد جَلَّت نِساءُ بَني نُمَيرٍ","وَما عَرَفَت أَنامِلُها الخِضابَ",20,"ب",1,0],["وَقَد جَرَّبَ الهِرماسُ وَقعَ سُيوفِنا","وَصَدَّعنَ عَن رَأسِ اِبنِ كَبشَةَ مِغفَرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","لِئالِ أَبي قابوسَ يَوماً مُذَكَّرا",21,"ر",2,0],["وَقَد جَعَلَت يَوماً بِطِخفَةَ خَيلُنا","مَجَرّاً لِذي التاجِ الهُمامِ وَمَصرَعا",22,"ع",2,0],["وَقَد جَرَّبَ الهِرماسُ أَنَّ سُيوفَنا","عَضَضنَ بِرَأسِ الكَبشِ حَتّى تَصَدَّعا",22,"ع",2,0],["وقد جُرِّبتْ منهُ على آلِ مَخْلدٍ","تجاربُ ليستْ مثلهنَّ تجاربُ",23,"ب",1,0],["وقد جهور في الصوت","بصدر أيّما صدر",24,"ر",1,0],["وقد جلدوها الحد وهْي بريئةٌ","فحيَّ على دفن الشهيدة تؤجروا",25,"ر",3,0],["وقد جرَّبَ المنصورُ منهم نصيحةً","وجدّاً سعيداً نِعْم ركنُ المُزاحِمِ",26,"م",1,0],["وقد جرَّبوا لحمي فذاقوا مرارةً","نَهتهُمْ فكفُّوا غيرَ خَرْقِ الأوارمِ",26,"م",1,0],["وقد جعلتَ لدعوى طاعنٍ سبباً","فلا تُبرهنْ على الدعوى إذا طعنا",27,"ن",2,0],["وَقَد جَعَلَ اللَهُ الخِلافَةَ فيكُمُ","لِأَبيَضَ لا عاري الخِوانِ وَلا جَدبِ",28,"ب",1,0],["وَقَد جارَيتُ قَد عَلِمَت مَعَدٌّ","بِلا واني اليَدَينِ وَلا قَصيرِ",29,"ر",1,0],["وَقَد جَعَلتُ كِتابَ العَتبِ مُختَصَراً","إِذا اِلتَقَينا لَهُ شَرحٌ وَتِبيانُ",30,"ن",1,0],["وَقَد جاوَرتُهُم فَرَأَيتُ سَعداً","شَعاعَ الأَمرِ عازِبَةَ الحُلومِ",31,"م",1,0],["وَقَد جابَ في سَكَراتِ الكَرى","عُروضَ اللَيالي وَأَطوالَها",32,"ل",3,0],["وقد جفَا مقلتِي نومي جفاءَكم","فما يذوقُ حثاثَ النوم أجفاني",33,"ي",1,0],["وَقَد جَرَّبوا بِالأَمسِ مِنكَ عَزيمَةً","فَضَلتَ بِها السَيفَ الحُسامَ المُجَرَّبا",34,"ب",2,0],["وَقَد جَزِعَت جَلدٌ وَلَولاكَ لَم يَكُن","لِيَجزَعَ مِن صَرفِ الزَمانِ جَليدُها",35,"د",3,0],["وَقَد جاوَرَت أَرضَ الأَعادي وَأَصبَحَت","حِماً وَصلُها مُذ جاوَرَت أَبرَقَ الحِمى",36,"م",2,0],["وَقَد جَعَلَت لِلدينِ في المَرجِ بِالقَنا","لِمَروانَ أَيّامٌ عِظامُ المَلاحِمِ",37,"م",1,0],["وقَد جاءتْ مدائحُنا نُقوداً","فلا تَجعَل جوائزَها نَسايا",38,"ا",3,0],["وقد جرَتْ خيلُ راحِنا خَبَباً","في جَرْيِها أو همَمْنَ بالخَبَبِ",39,"ب",1,0],["وقد جُمِعَ الحُسْنُ في روضةٍ","وفرَّقَ دِجلةُ فيه شُعوبا",40,"ب",2,0],["وَقَد جَرَّبتُماني في أُمورٍ","يُعاشُ بِمِثلِها لَو تَعقِلانِ",41,"ن",1,0],["وَقَد جاءَ في القُرآنِ إِثباتُ نَفعِها","وَلَكِنَّ فيهِ مِن تَوابِعِها إِثمُ",42,"م",1,0],["وَقَد جُمِعَت لِيَ اللَذّاتُ لَمّا","دَنَت مِنها قُطوفُ الجَنَّتَينِ",43,"ن",1,0],["وَقَد جَلا نورُ وَجهِهِ","الغَسَقا",44,"ق",2,0],["وقد جعل الله ذا الصخرَ بي","ن الحياةِ وبين البلى موبقَا",45,"ق",2,0],["وقد جُبِلَ الغانياتُ الصّغارُ","على بُغْضِهِنّ الشيوخَ الكبارا",46,"ر",2,0],["وَقَد جَرى في الَّذي جاؤوا به قَدَرٌ","ولا مَرَدّ لما يجري به القَدَرُ",47,"ر",1,0],["وقد جعلوا لهم شُرُعَ الشواني","مَعَ الأَرواحِ أَجنِحَةً وطاروا",48,"ر",3,0],["وَقَد جاءَنا أَنَّ تِلكَ الحُروبَ","إِذا حُدِيَت فَاِلتَوَت بِالحُداءِ",49,"ا",2,0],["وَقَد جالَ مِن كَأسِ السُلافَةِ أَشقَرٌ","يُسابِقُهُ مِن جَدوَلِ الماءِ أَشهَبُ",50,"ب",1,0],["وَقَد جاشَ بَحرٌ بَينَ جَنبَيَّ مائِجٌ","لَهُ زَخرَةٌ في وَجنَتَيَّ وَعُبابُ",51,"ب",1,0],["وَقَد جَلا الحُسنُ لَهُ سُنَّةً","يُلقى بِها المَعذولُ مَعذورا",52,"ر",2,0],["وَقَد جالَ دَمعُ القَطرِ في مُقلَةِ الدُجى","وَلَفَّت نَواصي الخَيلِ نَكباءُ زَعزَعُ",53,"ع",1,0],["وَقَد جاذَبَت ريحُ الصَبا غُصنَ النَقا","فَمادَ عَلى رِدفِ الكَثيبِ وَمالا",54,"ل",2,0],["وَقَد جالَ مِن جَونِ الغَمامَةِ أَدهَمٌ","لَهُ البَرقُ سَوطٌ وَالشَمالُ عِنانُ",55,"ن",1,0],["وَقَد جَدَّ بي وَجدي وَفاضَت مَدامِعي","وَقَد زادَ ما اِنضَمَّت عَلَيهِ الأَضالِعُ",56,"ع",1,0],["وقد جَرتِ الدِّماءُ على الرغامِ","ألا أيقِظْ أخاك من المنامِ",57,"م",1,0],["وقَد جَعلوا سوطَهُ مِغولاً","إِذا يَمَّموهُ فَفاهَ كلم",58,"م",1,0],["وَقَد جَمَّعتُ ما يُلهي","فَلَم أَترُك وَلَم أَذَرِ",59,"ر",1,0],["وقد جعلت تبأى علينا بقومها","وفي وجهها شغل عن الفخر شاغل",60,"ل",1,0],["وقد جاشَتِ الدأماءُ بِيضاً صَوارِماً","ومارنَةً سُمْراً وفَضْفاضَةً زَغْفا",61,"ف",2,0],["وقد جاوزَ الاسكندريّةَ جوهَرٌ","تُطالعُه البُشرَى ويقْدُمُه النَّصْر",62,"ر",1,0],["وَقَد جَرَّعَني كَأساً","لَها في القَلبِ نيرانُ",63,"ن",1,0],["وَقَد جاءَني مِن باهِلِيٍّ يَسُبُّني","فَأَعرَضتُ إِنَّ الباهِلِيَّ جَنيبي",64,"ب",2,0],["وَقَد جَرَّبتُكُم فَوَجَدتُ جَهلاً","مُبيناً في السِباطِ وَفي الجِعادِ",65,"د",1,0],["وَقَد جَهَّزَت لِلعَقلِ راحاً تَغولُهُ","فَدَعها وَلا تَشرَب طِلاءً وَلا مِزرا",66,"ر",2,0],["وَقَد جَنى الإِثمَ تَغشاهُ صَحابَتُهُ","وَالنَبلُ وَالسَيفُ وَالخَطّيُّ وَالفَرَسُ",67,"س",1,0],["وَقَد جاءَ غافِلَنا رِزقُهُ","وَإِن كانَ لِلقوتِ لَم يَحتَرِف",68,"ف",1,0],["وَقَد جارَ القُضاةُ إِذا أَشاروا","بِأَيسَرِ نَظرَةٍ مُتَحامِلينا",69,"ن",2,0],["وَقَد جاءَ أن البنت دلبر نابها","عياء من الجدريّ بالمَوت ينذر",70,"ر",1,0],["وَقَد جاهدت مصر الفتية دونه","وَبعد جهاد طال قد أَفلحت مصر",71,"ر",1,0],["وقد جعل الإسلام أمر بتاته","ثلاثاً ليكفي الوقت من هو يندم",72,"م",1,0],["وقد جرى ضوؤه الغريرُ","يستشرف الأُفْقَ والعُبابا",73,"ب",2,0],["وَقَد جُمِعَت مِنها خُمورٌ ثَلاثَةٌ","وَفي واحِدٌ سُكرٌ يَزيدُ عَلى السُكرِ",74,"ر",1,0],["وَقَد جَلَبا حَيناً لِمَصرَعِ مالِكٍ","وَكانَ كَريماً ماجِداً لِهِجانِ",75,"ن",1,0],["وَقَدْ جَهِلُوا الْبَيْتَ نَبْنِيه فَذّاً","فَيَسْتَغْرِبُ الأَمَدُ الأَبْعَدَا",76,"د",2,0],["وَقَد جَحَظت أَلَماً عَينُهُ","وَعَهدي بِها تُبرئ الجحَّظا",77,"ظ",2,0],["وقد جمعا في كلمة مستبينة","على مثلكم تخفى ومن مثلكم تبدو",78,"و",1,0],["وَقَد جَحَظَت مُزوَرَّتانِ وَما كَفى","جحوظُهُما حَتّى أَسيلَ أَسيلُ",79,"ل",1,0],["وقد جمعنا من الألحانِ أُغْنِيةً","لو يفهمُ الطيرُ معناها لغنَّاها",80,"ا",3,0],["وقد جيد الأملاك مني قلادة","وكم زان حسن الجيد حسن المقلد",81,"د",1,0],["وقد جئتم بها شعوا","ء أشابت مفرق الطفل",82,"ل",1,0],["وقد جُنَّ وركُكِ من غَيظِه","سَمينٌ يُناهِضُه أعجَف",83,"ف",1,0],["وقد جاشَ صدرُ الشعبِ يَغلى حفيظةً","عليكم كما يغلي على النار مِرجل",84,"ل",1,0],["وَقد جاوَزَتْ أرْضَ الأَعادِي وأصْبَحَتْ","حِمَى وَصْلِها مذ جاوَرَتْ أبرَقَ الحِمَى",85,"م",2,0],["وقد جوانحنا، البُهر عُذِرتْ في نوْحِها وغنائِها","، فلمّا أطالَتْ فيهما بَطَلَ العُذْر",86,"ر",1,0],["وقد جعلَ اللهُ الخلافة َ فيكُمُ","بأبْيضَ، لا عاري الخِوَانِ، ولا جَدْبِ",87,"ب",1,0],["وَقَد جَمَعَ الإِلَهُ لَدَيك ما قَد","تَفرَّق في البَريّة مِن حُلاكا",88,"ك",2,0],["وقد جلا وجهك بالنور من","شمس الضحى وبالسنا جللك",89,"ك",1,0],["وقد جعلوا في طي لب قلوبهم","قبورا لاشكال تنزه عن نقل",90,"ل",1,0],["وقد جانس الاضداد عن غير حكمة","وخلا مسئيا غادرا خله الوفي",91,"ي",1,0],["وقد جاء نعم العبد بالنص خالد","فيا حسنها من نعمة عند ناقد",92,"د",1,0],["وقد جمع الأشتات في سلك حاله","فمقلته وسنا ومهجته حرا",93,"ر",2,0],["وقد جررت ولم أحفل بلومهم","بين الخرابيش عند الزط أرداني",94,"ي",1,0],["وقد جرعتني بالنوى مضض الهوى","لتمنع من عذب الوصال معينهَا",95,"ه",2,0],["وقَد جَاءَ هَذَا في الظُّرُوفِ مَُخَبَّاً","فَمَهمَا تُطَالِعهَا الجَنَى مِنهُ تقطِفِ",96,"ف",1,0],["وَقَد جَمَعَت له الأيدِى المَعَالِى","وفَرَّقَتِ المَجَالِيحَ العِتَاقَا",97,"ق",2,0],["وقد جَرَى العدلُ فيما أَنتَ تَنظُمُهُ","مِنَ القَوانِينِ مَجرَى الرُّوحِ في الجَسَدِ",98,"د",1,0],["وًقَد جذبَت إِليهِ يَدٌ المَعَالِى","طَرِيفَ المَجدِ والمَجدَ التَّلِيدَا",99,"د",2,0],["وَقَد جرِّبوا فيما مَضى غِبَّ أَمرِهِم","وَما عالمٌ أَمراً كَمَن لَم يُجَرِّبِ",100,"ب",1,0],["وقد جعلوا عذَر حرماننا الثَّ","وابَ خلَّوهُمُ من فَهمْ",101,"م",1,0],["وَقَد جَلَّلَ الأَرضَ غَيمُ القِطارِ","وَجادَ الثَرى عارِضٌ مُنسَكِب",102,"ب",1,0],["وَقَد جَرى القَلَمُ الأَعلى بِنُصرَتِهِ","فَقَبلَ يُدعى بِهِ مُستَنصِراً نُصِرا",103,"ر",2,0],["وقد جاء في التّأفيف ما فيه عبرة","تدلَّ على ما فوقها فتأدَّب",104,"ب",1,0],["وَقَد جاءَهُ مِنهُ لِيُظهِرَ فَضلَهُ","كِتابٌ عَزيزٌ أَعجَزَ الخَلقَ كُلَّهُ",105,"ه",1,0],["وَقَدْ جَمَعَ الوَقْتُ حَالَيْهِما","فَمَنْ ذا يُفِيقُ وَمَنْ يَسْتَفِيقُ",106,"ق",1,0],["وقد جئتكم مستشفعاً في خلاصةٍ","بفضل أياديك التي دونها السحبُ",107,"ب",1,0],["وقد جرى بعض ما تهدي عواقبه","خيراً وإنى لذاك الخير منتظرُ",108,"ر",1,0],["وقد جربوا في الحرب والسلم أحمداً","فما فيه الا حين ترضيه مطمع",109,"ع",1,0],["وقد جرى تبر خديه بوجنته","ماء به ازداد جمر الخد في ضرمه",110,"م",2,0],["وقد جرب الأعدا لقاك فما رأوا","لحربك إقداما يفيد ولا جبنا",111,"ن",2,0],["وقد جمعت شملهم كعقد","جمعن به الفرائد في نظام",112,"م",1,0],["وقد جاء علم أن كفار قطره","غشوه وقد أضحى ببعض الجزائر",113,"ر",1,0],["وَقَد جاءَهُم مِنهُ النَّذيرُ لِيَأخُذُوا","مِنَ البِرِّ عَن جَوزِ الطَّريقِ بِجانِبِ",114,"ب",1,0],["وَقَد جَعَلت نَخلَين خَلفَاً وَيَمَّمَت","قُرى الشامِ أَو أَرضَ العِراقِ نجُوعُها",115,"ع",3,0],["وَقَد جاءَت الإِفرَنجُ مِن كُلِّ وجهَةٍ","كَأَنَّ تَداعيها السُيُولُ الدَوافِقُ",116,"ق",1,0],["وَقَد جُزِيَت بالوُدِّ سَلمضى وَمَا الهَوَى","بِمُستَجمِعٍ إِلاّ لمَن يَتَحَبَّبُ",117,"ب",1,0],["وَقَد جَعَلَت رَيّا الجَنُوبِ إِذَا جَرَت","عَلَى طِيبِهَا تَندَى لَنَا وَتَطِيبُ",118,"ب",1,0],["وَقَد جَعَلَ الوَاشُونَ عَمداً لَيَعلَمُوا","أَلِي مِنكِ أَم لاَ ياأُمَيمَ نَصِيبُ",118,"ب",1,0],["وقد جَرَّرت ريحُ الصَّبا فَضْلَ بُرْدِها","مُنَدًّى على بُسْطِ الرِّياض النَّوافح",119,"ح",1,0],["وقد جاد مَدْحِي فيك لما رأيتُ ما","رأى فاسْتَوىَ المدْحَان والإبنُ والجَدّ",120,"د",1,0],["وَقد جاءَ في القرآنِ ذكرُ فَسادِهم","وَزَعمهمُ الإصلاحَ في السورة الزهرا",121,"ر",2,0],["وَقَد جاءَ في الأخبارِ وصفُ مُروقهم","منَ الدينِ مثلَ السهمِ للجهةِ الأخرى",121,"ر",2,0],["وَقَد جاوَزوا أَطوارَهم ودوابهم","عَلى حالِها ما جاوَزَت مِثلَهُم طَورا",121,"ر",2,0],["وَقَد جَعلوا لي حصّةً من كبارها","لما عَلِموا مِن حبّه حصّتي كبرى",121,"ر",2,0],["وَقَد جَعلوا عيداً لهم يوم صلبهِ","فَكم طَبلوا طبلاً وكم زمروا زمرا",122,"ر",2,0],["وَقَد جعلَ المختارُ كالأهل حكمهُ","فَلا غروَ أَن خلّى أباهُ وعمّه",123,"ه",1,0],["وقد جَمَعَ الحسنُ فيه مع النب","لِ نوراً وطيبَ ذكاءِ",124,"ا",2,0],["وقد جَدَّ عزمي على رحلةٍ","أُجدِّد فيها صلات الرَّحِم",125,"م",1,0],["وقد جاوَبَ الزِّيرُ في جَذْبِه","مع البَمِّ ترجيعَ صوتِ المثَاني",126,"ي",1,0],["وقد جادني المَلْكُ الهمام فخصَّني","بِملْكٍ من الدُّهْم المطهَّمة الغُرّ",127,"ر",1,0],["وقد جاد من لم يجِد","وأنجز من لم يعِد",128,"د",1,0],["وَقَد جُمِعَت فيهِ شيناتُهُ","شَرابٌ وَشَمعٌ وَشَهدٌ وَشاهِد",129,"د",1,0],["وَقَد جاوَزنَ مِن غُمدانَ أَرضاً","لِأَبوالِ البِغالِ بِها وَقيعُ",130,"ع",1,0],["وقد جرى منه الذي قد جرى","وعوتب الصديق في حقهِ",131,"ق",2,0],["وَقَد جاءَتك يا كفوءاً كَفيّاً","تزفّ اليكَ طالِبَة اِمتياح",132,"ح",1,0],["وقد جُمعت فيها الشمائل كلّها","ففاق الورى باللفظ واللحظ واليد",133,"د",1,0],["وقد جئت زور الوزر بالغيب راجماً","لنا بمقال السوء من ظنّك المُردي",134,"د",2,0],["وقد جاءك العيد الذي أنت عيده","وعيد الذي أضحى فضحى وعيدا",135,"د",2,0],["وقَد جَعَلَتْ تَشتدُّ نحوَ خِبائها","لِتَخْبَأ نوراً مذْ تلألأَ ما خبَا",136,"ب",2,0],["وَقَدْ جَعل الهَيْجا رِياضاً خِلالَها","يُفجِّر أنْهارَ الدّماء الصّوائِبِ",137,"ب",1,0],["وَقَد جَمَعوا جَمعَهُم كُلَّهُ","وَجَمع الرِبابِ لَنا مُستَعارا",138,"ر",2,0],["وَقَدْ جاشَ مِنْ أَرْضِ إِفْرَنْجَةٍ","جُيُوشٌ كَمِثْلِ جِبالٍ تَرَدّا",139,"د",2,0],["وَقَد جالَتِ الأَكرادُ بِالسُمرِ وَالظُبى","تصيد المُلوكَ الصَّيدَ وَالأُسُدَ الشوسا",140,"س",2,0],["وَقَد جَعَلتُ إِذا ما قُمتُ يُثقِلني","ثَوبي فَأَنهَضُ الشارِبِ السَكِرِ",141,"ر",1,0],["وقد جمع الأسرار والأمر كله","محمد المبعوث للخلق رحمة",142,"ه",1,0],["وَقَد جلّل الريحانُ والروحُ روضةً","حَوَتك وَروّاها الرِّضا مُتوكّفا",143,"ف",2,0],["وَقد جلّ من نال الملوك إسارهُ","وَأعظم منه مَن لإطلاقِهم هبّا",144,"ب",2,0],["وَقَد جَلَّلَ رَعداهُ","فَلا ذَمٌّ لِرَعدَيهِ",145,"ي",2,0],["وقد جاء شوال فشالت نعامة الص","يام وأبد لنا النعيم من الضر",146,"ر",1,0],["وَقَد جاوَرَ الرَحمَنُ وَالحورُ أَرخَت","وَرَبّي في عَدنٍ مُقيمٍ عَلى اللَيثي",147,"ث",2,0],["وقد جاء هذا الحاشر الخاتم الذي","حوى كل خير في عموم الرسالة",148,"ه",1,0],["وَقَد جَعَلَت ضَغائِنُهُنَّ تَبدو","بِما قَد كانَ نالَ بِلا شَفيعِ",149,"ع",1,0],["وقد جُدْتُ بابْنٍ كان عزىَ روحُه","فها أنا منّي سوى جَسَدٍ مُضْنى",150,"ن",2,0],["وقد جعَل النّاسُ إلاّ الأقَلْ","لَ يُبدونَ عُرْفاً ويُخْفُونَ نُكرا",151,"ر",2,0],["وقد جرّ فوقَ الأنجمِ الذَّيلَ جرّةً","تَوشَّحها صرحُ السماء المُمَرَّد",152,"د",1,0],["وقد جبْت أرضاً كالجبال سُهولُها","فقُلْ في جبالٍ ثُمّ كيف تُجاب",153,"ب",1,0],["وَقد جَاوَزنَ من غُمدانَ داراً","لأَبوالِ البغالِ بها وَقيعُ",154,"ع",1,0],["وَقَد جاءَ قَبلَ النَيلِ نَيلُكَ سابِقاً","إِذا النيلُ في شُغلٍ مِنَ المَدِّ وَالجَزرِ",155,"ر",1,0],["وَقَد جَفَّت غِمارُ الوِردِ مِمّا","تَزاحَمَ في مَورِدِها الدَلاءُ",156,"ا",2,0],["وقد جازَ شُكري حَدَّه فالتمِس مَعي","نَديماً نكن فيما نُحاولُه مَعا",157,"ع",2,0],["وقد جاءَ القلندسُ بعد فطرٍ","وأيامي بذاكَ وذا حَيارى",158,"ر",2,1],["وقد جَمعوا أخبارَ من شفَّه الهوى","وتِلك أحاديثي وأخبارُ إخوتي",159,"ي",1,0],["وَقَد جاءَ تاريخُهُ","خِتان بِجود كَمل",160,"ل",1,0],["وَقَد جَرى أَكثَرُها","مِن دَمعي المُنحَدر",161,"ر",1,0],["وَقَد جَدَ في اتلاف نَفسي مَع الهَوى","وَاِنحَلَ 