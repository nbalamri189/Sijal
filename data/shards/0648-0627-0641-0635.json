{"poems":[[65,"سواي يكون عرضة مستريث","https://www.aldiwan.net/poem45946.html","الطويل"],[74,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[74,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[91,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[64,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[76,"تخيرته من رهط أعوج سابحا","https://www.aldiwan.net/poem12845.html","الطويل"],[108,"أنا وابناي","https://www.poetsgate.com/ViewPoem.aspx?id=179447",""],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[264,"لنا تعرب الآلات والنطق أعجم","https://www.aldiwan.net/poem35527.html","الطويل"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[408,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[438,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[447,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[519,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[567,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53873","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37789","الطويل"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96717","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96605","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136194","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44811","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111801","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121189","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76038","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83207","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46890","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54454","المنسرح"],[4727,"ألا ليت حكام الجزائر نسوةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215839",""],[4830,"ذكريات الدّيار","https://www.poetsgate.com/ViewPoem.aspx?id=195076",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[5725,"ياظبية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=179251",""],[1583,"عن بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73070&r=&rc=27",""]],"verses":[["وَأَفْصَحُ مَنْ يُقَوِّمُ دَرْء قَوْلٍ","يَجُوتُ الأَرْضَ بالعَنَقِ الحَثِيثِ",0,"ث",1,0],["وأفصح عن ألفاظه وابتسامه","فأعجبني نظم الجمان ونثره",1,"ر",2,0],["وأفصحت بالثنا كتب مقدَّمة","إن جيل في الدهر توراة وإنجيل",2,"ل",1,0],["وافصحت حتى اوهنتني كبرة","وحينئذ اسمكت كالطلل البالي",3,"ل",2,0],["وافصد المعدن الكري","م مرامي ذوي النظر",4,"ر",1,0],["وَأَفصَحَتِ الوَرقاءُ في كُلِّ تَلعَةٍ","نَشيداً وَقَد رَقَّ النَسيمُ نَسيبا",5,"ب",2,0],["وأفصحُ من أفصح الناس طفلٌ","أراد الكلام فكان عيَّيا",6,"ي",2,0],["وافصل الصلاة والسلام","على النبي الزمزمي التهامي",7,"ي",1,0],["وَأفصحَ بالشهادةِ فيه ضبٌّ","وذلّ الفحلُ والسرحان دلّا",8,"ل",2,0],["وأفصحتَ حتى ليس إلاَّكَ مُفْصِحٌ","وأسْهبتَ حتى ليس إلاّكَ مُسْهِب",9,"ب",1,0],["وأفصح قولاً وهو أبكم في الورى","فيا عجباً من مفصحٍ وهو أبكم",10,"م",1,0],["وأُفصحُ قَولاً بالّذي أنت أهلُه","ولو لم يكُنْ ما كان أيضاً لِيَغْمُضا",11,"ض",2,0],["وأفصَحَهُمُ عند التلاحي وخيرَهم","نَوالاً إذا ما شِيمَ نائلُه الجَزْلُ",12,"ل",1,0],["وأفصحَ من نهج البلاغة منطقاً","تخرّ له الأقلام في الطرس سجّدا",13,"د",2,0],["وأفصَحُهُم إذا نطقوا لساناً","وأفسَحُهُم إذا طُرِقوا جَنابا",14,"ب",2,0],["وأفصح من رأوه طوعه","وأذهن من خرنق في دويّ",15,"ي",1,0],["وأفصحَ عن فصلِ الخِطابِ بمنطِقٍ","لديه لَبيدٌ ضارعٌ وبَليدُ",16,"د",1,0],["وأفصحُ كلِّ ذي قولٍ مَقالاً","وأنجَحُ كلِّ ذي فعلٍ فَعَالا",17,"ل",2,0],["وأفصحَ قسّيس الأعاجِمِ جاهراً","بإنجيل روح الله عيسى بن مرْيمِ",18,"م",1,0],["وَأَفصِحْ بِتَبيينِ المَديحِ مُهذَّباً","بِتَحسينِ سَبكٍ فَالبيانُ مِنَ السِّحرِ",19,"ر",1,0],["وأفصح القبر باعتبار","وامتع القول والنشيد",20,"د",1,0],["وَاِفصدن وجهَ عرارٍ تلفهِ","بحرَ جودٍ بالعَطايا مُتلطم",21,"م",1,0],["وَأفصحُ مَن قَرَى منهم","وَمَن أَملى وَمَن كَتَبا",22,"ب",2,0],["وأَفصَحَ بِالشَكوى لَهُ الجِذعُ صارِخاً","كَما صَرَخَت غِبَّ الحِلابِ ضَجوجُ",23,"ج",1,0],["وأفصِّل الآيات وهي بليغة","وأبيِّن المحجوبَ من لمحاتهِ",24,"ت",2,0],["وافصحي عن جوى قلبي وما لقيت","روحي وبثي الذي قد كان مستترا",25,"ر",2,0],["وأفصحَ بالشُّكر الجزِيل كلاهما","كأنَّ كِلا الخَصمين عِندكَ غَالِب",26,"ب",1,0],["وافصج عن اسمٍ ثلاثي تحيَّر في","معناهُ فكري وابدى كنههُ عجبا",27,"ب",2,0],["وأفصح مني في مديح باسمه","اذا ثارت البحر القنا والسوابق",28,"ق",1,0],["وَأُفصِحُ عَن مَعانٍ غامِضاتٍ","إِذا خَرسَ الفَصيحُ لَدى المَقالِ",29,"ل",1,0],["وَأَفصَحَ عَن وِجدانِهِم جَلُّ مَنطِقي","وَدَلَّ على إِجلالِكَ الحَرفُ وَالسَطرُ",30,"ر",1,0],["وَأَفصحوا بينما الأعداء في حَصَر","فقد أَعزوه فوق السمع وَالبصر",31,"ر",1,0],["وأفْصَحَ يَثْنِي خاطِباً في خِطَابِهِ","وما انْفَكَّ لَوْلا السَّيْفُ أعْجَمَ طِمْطِما",32,"م",2,0],["وافصل جميلاً هذي القضيَّة بال","عَدْلِ وخلِّ التفصيل والجُمَلا",33,"ل",2,0],["وأفصح عند القول من كل طَمْطَمِ","وأصدق عند الخطب من كل كاذب",34,"ب",1,0],["وأفصحَ الصبحُ عن شمسٍ تنادمنا","والبدرُ بان على عهدٍ يُلاقينا",35,"ن",2,0],["وأفصح عن جهل عميق مركب","وأبرز مكنوناً من الغي مظلما",36,"م",2,0],["وَأَفْصَحُ مَنْ قَرَا مِنْهُمْ","وَمَنْ أَمْلا وَمَنْ كَتَبَا",37,"ب",2,0],["وافصحي عن ناظر نتلو به","من معاني الحسن يطويني حصيفا",38,"ف",2,0],["وافصح الغيب ، لما شئته ، وانجلى","وارتدَّ عن موكبي ، أفق المدى مجفلا",39,"ا",1,0]]}