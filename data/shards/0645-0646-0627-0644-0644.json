دني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[5145,"بدر سنوه ليالي البدر عاد له","https://www.poetsgate.com/ViewPoem.aspx?id=108245",""],[5286,"هو الشعر !..","https://www.poetsgate.com/ViewPoem.aspx?id=110863",""],[5660,"مِنَ اللَيلِ أَشواقٌ أَضَرَّت جَوانِحي","https://www.poetsgate.com/ViewPoem.aspx?id=27422",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[402,"وارحمتا لي من صروف زماني","https://www.poetsgate.com/ViewPoem.aspx?id=36540",""],[5953,"سلام على أرض الحسين وحضرته","https://www.poetsgate.com/ViewPoem.aspx?id=93792",""],[5956,"إلى جنات عدن","https://www.poetsgate.com/ViewPoem.aspx?id=181920",""],[5956,"الكورونا وباءٌ قد يحسِّن العالم","https://www.poetsgate.com/ViewPoem.aspx?id=210865",""],[5986,"أقدم سيدي منك اعتذارا","https://www.poetsgate.com/ViewPoem.aspx?id=162954",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6069,"سرى موهناً واستكتمته المهالك","https://www.poetsgate.com/ViewPoem.aspx?id=105697",""],[199,"أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=20770",""],[2220,"ألا انعم صباحا أيها الوارد الذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11564&r=&rc=438",""]],"verses":[["مِنَ اللَهِ أَستَهدي بَقاءَكَ أَن تُرى","مُحَلّاً لِأَسبابِ العُلى بِمَكانِ",0,"ن",1,0],["مِنَ اللَهِ أَستَبقي صَفاءً يَضُمُّنا","وَطاعَةَ أَيّامٍ وَدارِ مُقامِ",1,"م",1,0],["مِنَ اللائي يُماطُ العَيبُ عَنها","إِذا نُثِلَت لَدى الرَوعِ العِيابُ",2,"ب",1,0],["مِنَ اللاتي حُمِلنَ عَلى الرَوايا","كَريحِ المِسكِ تَستَلُّ الزُكاما",3,"م",2,0],["مِن اللاتي أَلفِنَ جَنوبَ إيرٍ","كَأَنَّ لَهُنَّ مِن سِبتٍ نِعالا",4,"ل",2,0],["مِنَ اللاءِ يَحفِرنَ تَحتَ الكُدى","وَلا يَبتَغينَ الدِماثَ السُهولا",5,"ل",2,0],["مِن اللائي يَعُودُ الحِلمُ فيهُم","وَيُعطَونَ الجَزيلَ بِلاحِسابِ",6,"ب",1,0],["مِنَ اللَواتي لَها دُهنٌ مُنَصِّفُها","قَد غَيَّرَتها الفَيافي أَيَّ تَغييرِ",7,"ر",1,0],["من اللاء يملكن القلوب بكلمة","ويحيين ميت الوجد بالنظر الثزر",8,"ر",1,0],["مِنَ اللاءِ تَأبى أَن تُعانِدَ رَبَّها","إِذا حُسِرَت عِندَ المُغارِ المَآزِرُ",9,"ر",1,0],["من اللاتي زكت نسباً ورقت","عليك شمائل الخود الرداح",10,"ح",1,0],["من الّلآءِ خفّت في يمين مديرها","فلو أهرقتها الكأسُ لم تتبدَّدِ",11,"د",1,0],["من اللاءِ أجدى كُثرُها فتكاثرت","لديّ بها الأتباعُ والأصلُ والولدُ",12,"د",1,0],["من اللاء تسري في دجى من مدادها","وتجلى كما تجلى النجوم العواتم",13,"م",1,0],["من اللائي لا تنفكّ تجري سواكِناً","بفرسانها تِلقاءَ نارٍ تَلهَّبُ",14,"ب",1,0],["مِنَ اللائي تَزْدادُ انْدماجاً ومُنَّةً","إذا هِيَ أنْضَاها السِّفَارُ العَطوَّدُ",15,"د",1,0],["من اللائي لا يُخزي الوجوه نشيدُها","إذا منشدٌ باهَى بها من يُجالس",16,"س",1,0],["من اللائي عمَّتها المحاسنُ لا الأُلى","محاسِنُها من خلقها في خَصائص",17,"ص",1,0],["من اللاتي يحميها الأباطيلَ أهلُها","وهنّ إذا ما نابَ حقٌّ شوابط",18,"ط",1,0],["من اللواتي إذا ظفرن بنا","أنزفن ألبابنا سوى نُزَف",19,"ف",1,0],["من اللائي تنبو بالجنوبِ وكلها","لأيدي المهاري أملسُ المتنِ أدرمُ",20,"م",1,0],["من اللائي يجبي أهلُها الحمدَ لا التي","جِبا أهلها دينارُ عيْنٍ ودرهمُ",20,"م",1,0],["مِنَ اللَواتي إِذا لانَت عَريكَتُها","كانَ لَها بَعدَهُ آلٌ وَمَجلودُ",21,"د",1,0],["مِنَ اللَواتي وَلا شَبيهَ لَها","يَزينُهُنَّ الدَلال وَالخَفَرُ",22,"ر",1,0],["من اللاء لم يأتين فاحشة ولا","زُنن بما منه العقائل تخجل",23,"ل",1,0],["مِنَ اللائي إِذا أُرهِبنَ زَجراً","دَنَونَ وَزادَهُنَّ لَهُ اِقتِرابا",24,"ب",2,0],["مِنَ اللائي يَظَلُّ الأَلفُ مِنهُ","مُنيخاً مِن مَخافَتِهِ نَهارا",25,"ر",2,0],["منَ اللَّواتي تقولُ الأرضُ إنْ بسَمَتْ","هَذي الحياةُ التي يَحيا بها النَّسَمُ",26,"م",1,0],["مِنَ اللَّائي أَعصارُ زُهْرِ النُّجوم","تكادُ تُطاوِلُ أعمارَها",27,"ر",3,0],["مِنَ اللاءِ يَشرَبنَ النَجيعَ مِنَ الكُلى","غَريضاً وَيَروى غَيرُهُنَّ فَيَنقَعُ",28,"ع",1,0],["مِنَ اللاءِ قَدْ آلَيْنَ يَشْرَبْنَ أَوْ تَلِي","مَنَابِتُهَا غَوْرَ الْبِحَارِ الْخَضَارِمِ",29,"م",1,0],["مِنَ اللَّاءِ يُعطينَ الخِلافةَ حقَّها","وَيَبنْينَ منها ما تهدُّ القوارعُ",30,"ع",1,0],["مِنَ اللاءِ لَم يَحجِجنَ يَبغِينَ حِسبَةً","وَلَكِن لِيَقتُلنَ البَرئِ المُغَفَّلا",31,"ل",2,0],["مِنَ اللَهِ سُقياهُ لِشُرٍّ وَجَودُهُ","وَلَيسَ لَها سَحُّ الغَمامِ وَلا القَحطُ",32,"ط",1,0],["منَ اللاّءِ لا يَصْدُرْنَ إلاّ رَوِيّة","كأنّ عليها صِبْغَ خَمْرٍ وعَنْدَم",33,"م",1,0],["من اللاّءِ هاجتْ للنّوى أرْيَحِيّتي","وهزّتْ إلى فُسْطاط مصرَ قَوادمي",34,"م",2,0],["منَ اللاء تغدو وهي في السلم مركبي","ولو كانتِ الهيجاءُ قدَّمتُها صَفّا",35,"ف",2,0],["من اللاّءِ تأكُلُ أغمادَها","وتلفَحُ منهنّ جَمْرَ الغضا",36,"ا",1,0],["مِنَ اللَواتي خَطَبناها عَلى عَجَلٍ","لَمّا عَجَجنا بِرَبّاتِ الحَوانيتِ",37,"ت",1,0],["مِنَ اللَواتي حَكى الحَبابُ بِها","وَجهَ حَبيبٍ إِلَيَّ مُبتَسِمِ",38,"م",1,0],["من اللواتي حكاها","أبو زبيدٍ فأكثر",39,"ر",1,0],["مِنَ اللَواتي اِكتَسَت قَدّاً وَشَقَّ لَها","مِن ثَوبِهِ الحُسنُ سِربالاً فَرَدّاها",40,"ا",3,0],["مِنَ اللَواتي إِذا حَنَّ الكِرانُ لَها","صَلَّت بِأُذنٍ لِصَوتِ البَمِّ وَالزيرِ",41,"ر",1,0],["مِنَ اللَواتي ريقُها طَهورُ","زَيَّنَها ما زُيِّنَ الجاذورُ",42,"ر",1,0],["مِنَ اللُؤلُؤِ وَالياقو","تِ أَو مِن عَنبَرِ الهِندِ",43,"د",1,0],["مِنَ اللائي إِذا لَم يُجدِ عامٌ","تَفَوَّقنَ الحَوادِثَ مُعدِماتِ",44,"ت",1,0],["مِنَ اللاّتي أمَدّ بِهِنّ طَبْعٌ","وهَذّبَهُنّ فِكْرٌ وانْتِقادُ",45,"د",1,0],["مِنَ اللَواتي إِن وَنى شاكِرٌ","قامَت لِمُسديها مَقامَ الخَطيبِ",46,"ب",1,0],["من اللاَّنهاية ألوانُها","مشعشعةٌ بالندى المنسكبْ",47,"ب",1,0],["مِنَ اللاءِ لا يَأْكُلْنَ زاداً سِوَى الَّذِي","يُضَرِّسْنَهُ وَالصَّيْدُ أَشْهَى وَأَعْذَبُ",48,"ب",1,0],["مِنَ اللهِ فَضْلٌ أَنْ تَكُونَ حكِيمَنا","وَيَجْمَعُ فِيكَ العِلْمَ وَالجُوَد وَالظَّرْفَ",49,"ف",1,1],["من اللاء غذّاها \" جرير \" بروحه","ولاءَمَ شَطرَيها نسيج \" الفرزدق\"",50,"ق",1,0],["من اللاَّءِ يهتزُّ منها النديُّ","ويُطربُ إيقاعُهُنَّ السَّمر",51,"ر",1,0],["من اللواتي تُغَذِّيهنَّ عاطفةٌ","جياشةٌ بين تصعيدٍ وتصويب",52,"ب",1,0],["من اللآء لا يعرفن للروح قيمة","سواء لديها شيب ورضائع",53,"ع",1,0],["من اللّواتي - ولا شبيه لها -","يزينهنّ ادلال والخفر",54,"ر",1,0],["من اللائي عمّتها المحاسنُ لا الأُلى","محاسِنُها من خلفها في خَصائص",55,"ص",1,0],["مِنَ اللَهِ أَستَهدي بَقاءَكِ إِنَّهُ","قَصِيَّةُ ما أَعطى وَنُخبَةُ ما أَهدا",56,"د",2,0],["مِنَ اللَهِ نَستَهدي لَكَ العُمُرَ الَّذي","يَطولُ إِلى أَن لا يُماثِلَهُ عُمرُ",57,"ر",1,0],["من اللائي تطيعهم القوافي","وتنقاد انقياداً كالغريم",58,"م",1,0],["مِنَ اللَهِ أَرجو أَن يُسَنّي قُربَهُ","وَإِن عاقَ وَقتٌ كَدَّرا اللَهُ شِربَهُ",59,"ه",1,0],["مِنَ اللَهِ أَوفى وَهوَ لِلَّهِ يَعرُجُ","سَناهُ بِآفاقِ العُلا مُتَبَلِّجُ",60,"ج",1,0],["من اللوم منح اللوم من ليس أهله","فهل أنت أولى من تجنبه أولا",61,"ل",2,0],["من آلِ لمْع الأكرَمين كَريمةٌ","تَنمي إِلى رَبِّ المَعالي حَيدَرا",62,"ر",2,0],["مِنَ اللَواتي إِذا اِستَقبَلنَ مَهمَهَةً","نَجَّينَ مِن هَولِها الرُكبانَ وَالثَقَلا",63,"ل",2,0],["من اللظى بات يشكو","يا ليتني ما فعلت",64,"ت",1,0],["مِنَ اللائي غُذينَ بِغَيرِ بُؤسٍ","مَنازِلُها القَصيمَةُ فَالأُوارُ",65,"ر",1,0],["من اللَه أرجو أن أفوزَ بمدحة","تجاه ضريحٍ منه وهُوَ أمامي",66,"م",2,0],["من اللائي ابقت لأبن حمدان نفسه","وراحت عن الزنا بروح قصير",67,"ر",1,0],["مناللاء لَم يسبق اليهن شاعر","سواي وَلَم ينطق بهن اديب",68,"ب",1,0],["مِنَ اللائِي يَهْوَى القَصْرُ لَوْ قُصِرَتْ بِهِ","فَتَأْبَاهُ لِلْبَيْتِ المُطَنَّبِ والخُصِّ",69,"ص",1,0],["مِنَ اللّاحِقاتِ السابقاتِ إِذا قَفَت","أَو اِقتفيت تُطوى بها الشقَّة الشحطا",70,"ط",2,0],["مِنَ اللَواتي إِذا لانَت عَريكَتُها","يَبقى لَها بَعدَها آلٌ وَمَجلودُ",71,"د",1,1],["منَ اللاّتي إذا طَرِبتْ لحَدْوٍ","حَسِبْتَ من النُّسوعِ لها انْسِلالا",72,"ل",2,0],["منَ الّلائي إذا طَرِبتْ لحَدْوٍ","خَشِيتَ منَ النُّسوعِ لها انْسِلالا",73,"ل",2,0],["منَ اللّواتي يَزيدُ السّيرُ أَيديَها","سَبْقاً إذا الفَضْلُ من أَنساعِها مَعَطا",74,"ط",2,0],["مِنَ اللُجَينِ وَمِنَ العِقبانِ","عيدِيَّةٌ شاحِطَةُ الأَثمانِ",75,"ن",1,0],["من اللواتي ما انبرى مسترعيا","بمثلها قطُّ لسانٌ أُذُنا",76,"ن",2,0],["من اللواتي تستصبُّ نحوها","نفسُ الوقور أو يكونَ الأنزقا",77,"ق",2,0],["من اللواتي نَصَرَتْ آباءَها","في السبق أمّهاتُها الردائدُ",78,"د",1,0],["مِنَ اللاءِ لا تَكبو لِسُرعَةِ جَريِها","إِذا هِيَ خَبَّت في فِجاجِ المَهارِقِ",79,"ق",1,0],["مِنَ اللاءِ يَهجُرنَ ال