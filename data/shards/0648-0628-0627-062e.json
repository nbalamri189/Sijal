{"poems":[[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[47,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[83,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[197,"وباخل يبدي لنا","https://www.aldiwan.net/poem13049.html","مجزوء الرجز"],[240,"وباخل قدم لي شمعة","https://www.aldiwan.net/poem31583.html","السريع"],[240,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[240,"وباخل بت في أرجاء منزله","https://www.aldiwan.net/poem31913.html","البسيط"],[240,"وباخل جاد على بخله","https://www.aldiwan.net/poem31961.html","البسيط"],[353,"وباخل أطعمني بشره","https://www.aldiwan.net/poem19876.html","السريع"],[353,"وباخل يشنأ الأضياف حل به","https://www.aldiwan.net/poem20705.html","الخفيف"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[543,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126767","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145852","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102106","المديد"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115596","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65399","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100193","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118752","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135898","الرجز"],[4225,"","https://poetry.dctabudhabi.ae/diwan/poem/143359","الطويل"],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""]],"verses":[["وَبِأَخلاقٍ رِقاقٍ","دونَ أَعراضٍ صَفيقَه",0,"ق",2,0],["وَباخِلينَ سَلَونا عَن نَوالِهِمِ","سُلوانَ صَبٍّ تَمادى هَجرُ مُصبيهِ",1,"ي",2,0],["وَباخِلٌ بِالنَوالِ عادَتُهُ","قَد عَلَّمَتني بِحُبِّهِ البَخَلا",2,"ل",2,0],["وَبِأَخْمَصٍ مُتَثَاقِلٍ دَاسَتْ عَلَى","أَشْبَاهِ حَيَّاتٍ سَعَتْ وَعَقَارِبِ",3,"ب",1,0],["وَباخِلٍ يُبدي لَنا","عَجائِباً مِن أَمرِهِ",4,"ر",2,1],["وَباخِلٍ قَدَّمَ لي شَمعَةً","وَحالُهُ أَحرَقُ مِن حالِها",5,"ه",2,1],["وَباخِلٍ سَمُحَ الطَيفُ الكَذوبُ بِهِ","وَاللَيلُ قَد مَدَّ مِن ظَلمائِهِ سُجَفا",6,"ف",2,0],["وَباخِلٍ بِتُّ في أَرجاءِ مَنزِلِهِ","كَأَنَّني بِتُّ في بَعضِ النَواويسِ",7,"س",1,1],["وَباخِلٍ جادَ عَلى بُخلِهِ","مُحتَفِلاً في عُمُرِهِ مَرَّه",8,"ر",2,1],["وَبَاخِلٍ أَطْعَمني بُشرَهُ","وَغَرَّني بِالبارِقِ الخُلَّبِ",9,"ب",1,1],["وَبَاخِلٍ يَشنَأُ الأَضيافَ حَلَّ بهِ","ضَيفٌ مِن الصَّفْعِ نَزَّالٌ علَى القِمَمِ",10,"م",1,1],["وباخلين مع الإِثراءِ شأنُهُمُ","منْع العطاءِ وسوءُ الغدر بالذِّمَمِ",11,"م",1,0],["وبإخلاَصِ الوَلاَءِ","فلتُجِيبُوا لِلنِّداءِ",12,"ا",2,0],["وَبِإخوانه تَعِزُّفَهُم والل","حمدُ الله قُرَّةٌ للرَّائي",13,"ا",2,0],["وَبِأخلاقِهم وطيبِ شَذاهم","فاحَ منهم في الرافدين عبيرُ",14,"ر",1,0],["وَباختصار لَم أطق تَفصيلا","وَلَم أرِد لشرحها تَطويلا",15,"ل",2,0],["وبأخوةٍ همْ فتيةٌ صدقوا الذي","قد عاهدوا اللهَ الرحيمَ المحسنا",16,"ن",2,0],["وباخرنا انل راحةً","بزحامٍ لاعنا نصبى",17,"ب",2,0],["وباختِصَارٍ على الأحنانِ إذلَهُمُ","على الرَّبابِينِ ترتيبٌ وتَفصيلُ",18,"ل",1,0],["وباخل يُخسَأُ من لؤمهِ","لأنّهُ أحقَر أن يُجزى",19,"ز",2,1],["وباخل يجمعُ الدّينار قُلتُ لهُ","أنفقهُ في البرّ إنّ اللّه يُخلفهُ",20,"ه",1,1],["وباخلةٍ وهي الكريمة لم تجد","بوصل وجدت دونها أنمل الخال",21,"ل",1,0],["وَبِأخٍ أختاً وَبِابنٍ بِنتَا","ألحِق وَيُونُسٌ أبَى حَذفَ التَّا",22,"ت",2,0],["وباخلاصكم وحسن نواياكم","تفوّقتم على الحكماء",23,"ا",2,0],["وبأخير الحشر والذي نزلْ","به من الأسماءِ ذي خير جزلْ",24,"ل",1,0],["وباخِسُ حقِّ العلم بالعِلمِ جاهلٌ","وواضعُ أهل الفضل للفضل ظالمُ",25,"م",1,0],["وبأخلاقك الحسان فبدل","سوء وصف قد كان فيه شينا",26,"ن",2,0]]}