b.com/modules.php?name=Sh3er&doWhat=shqas&qid=76314&r=&rc=62",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[2220,"الكبرياءُ رداءُ منْ سجدتْ لهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11680&r=&rc=554",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""],[5190,"لا تغضبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85043&r=&rc=118",""]],"verses":[["لا تَغرُرَنَّكَ مِن عَدُو","وِكَ رَميَةٌ مِن غَيرِ رامِ",0,"م",1,0],["لا تَغبِطَنَّ عَلى البَقاءِ مُعَمَّراً","فَلَقُربُ يَومِ مَنِيَّةٍ مِن مَولِدِ",1,"د",1,0],["لاَ تُغْفِل الْحَزْمَ الَّذِي بِعِقَالِهِ","إبلُ الإِمَارَةِ وَالإِدَارَةِ تُعْقَلُ",2,"ل",1,0],["لا تَغْتَرِرْ فهُوَ السّرابُ بقِيعَةٍ","قدْ خودِعَ الماضِي بهِ والآتي",3,"ت",2,0],["لا تَغتَرر بِالدَهرِ إِن وافاكَ في","حالٍ يَسُرُّكَ إِنَّهُ غَرّارُ",4,"ر",1,0],["لا تَغدرَنَّ بِوَصلِ عَزَّةَ بَعدَما","أَخَذَت عَلَيكَ مواثِقًا وَعُهودا",5,"د",2,0],["لا تغرّنّكم شِباكٌ كبارٌ","أصبحت لاصطيادنا منسوجه",6,"ج",2,0],["لا تَغمُرُ النعمُ الجلائِلُ قَدْرَهُ","كلا ولا تَزْهَاهُ حتَّى يمرحا",7,"ح",2,0],["لا تغترر بطهارةٍ","فيها البشاشة والسرور",8,"ر",1,0],["لا تغسل الدهرَ كفّها قَذَراً","فكفّها طولَ دهرها غمره",9,"ر",2,0],["لا تغرنَّك المطامِعُ منه","إنَّه ليس من ضِباب احتراشِك",10,"ك",1,0],["لا تغافلْ يا أبا الصق","رِ وليستْ فيك غفلَهْ",11,"ل",2,1],["لا تَغْشَ إلا ملكاً في منزلِهْ","يُعرضُ في مشربهِ ومأكلِهْ",12,"ل",2,1],["لا تَغْتَرر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصامِ",13,"م",1,0],["لا تَغبننَّ موالاتي ولا مِدَحي","فقد عهِدتك ممن يكره الغَبَنا",14,"ن",2,0],["لا تَغْلُظَنَّ على امرئٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",15,"ن",1,0],["لا تُغَرَّنَّ فلن يغ","فَلَ علّامُ الخفايا",16,"ا",3,0],["لا تُغالِطني وَحَقُّ ال","لَهِ ما يَكذِبُ ظَنّي",17,"ن",2,0],["لا تُغَنِّينِي أَغَاريدَ الصَّبَاحْ","بُلْبُلَ الأَفْراحْ",18,"ح",1,0],["لا تَغلُ في جودِ الرِجالِ فَإِنَّهُ","لَم أَرضَ جوداً غَيرَ جودِ أَديبِ",19,"ب",1,0],["لا تَغُرَّنكَ جَولَةُ الدَهرِ إِنَّ الدَ","هرَ كانَ مُذنِباً سَيَتوبُ",20,"ب",1,0],["لاتَغلُ في شَمسِ بنِ أَكلُبَ إِنَّها","ظُفري فَرَيتُ بِها العَدُوَّ وَنابي",21,"ب",2,0],["لاتَغتَرِر مِن حِلمِهِ وَاِحتَرِس","مِن سَطوَةٍ فيها السِمامُ النَقيع",22,"ع",1,0],["لا تُغرِيَن شُؤمَكَ القَديمَ بِهِم","فَيُصبِحوا كَالرُسومِ وَالدِمَن",23,"ن",1,0],["لا تَغتَرِر بِالحادِثاتِ فَما","لِلحادِثاتِ عَلى امرِئٍ بُقيا",24,"ا",1,0],["لا تَغبِطَنَّ أَخاً بِمَعصِيَةٍ","لا تَغبِطَن إِلّا أَخا التَقوى",24,"ا",1,0],["لا تَغضَبَنَّ عَلى الزَمانِ فَإِنَّ مَن","يُرضي الزَمانُ أَقَلُّ مِمَّن يُغضِبُه",25,"ب",2,0],["لا تَغتَرِر فَكَأَنَّني بِعُقابِ رَي","بِ الدَهرِ قَد نَشَرَت عَلَيكَ جَناحَها",26,"ح",3,0],["لا تَغفُلُنَّ فَإِنَّما","آجالُكُم نَفَسٌ يُعَدُّ",27,"د",1,0],["لا تَغُرَّنَّكَ العُيونُ فَكَم أَع","مى تَراهُ وَإِنَّهو لَبَصيرُ",28,"ر",1,0],["لا تَغفُلَنَّ فَإِنَّ الدارَ فانِيَةٌ","وَشُربُها غُصَصٌ وَصَفوُها رَنَقُ",29,"ق",1,0],["لاتَغبِطَنَّ الدَهرَ ذا ثَروَةٍ","قَد جَعَلَ اللَذاتِ مِن بالِهِ",30,"ل",2,0],["لا تَغضَبَنَّ عَلى امرِئٍ","لَكَ مانِعٍ ما في يَدَيهِ",31,"ه",1,1],["لا تَغفِرُ الذَنبَ إِن أَسَأتُ وَلا","تَقبَلُ عُذري وَلا مُؤاتاتي",32,"ت",2,0],["لا تُغضِبَنَّكَ مُنهِضاتي إِنَّها","مَذخورَةٌ لَكَ في السِقاءِ الأَوفَرِ",33,"ر",1,0],["لا تُغنِ أَسماءُ المَلاحَةِ وَالحِجى","فيمَن سِواهُ فَإِنَّها أَسماؤُهُ",34,"ا",3,0],["لا تغبطنَّ بني الدنيا بنعمتهم","فراحةُ القلبِ لم يظفَر بها أحدُ",35,"د",1,0],["لا تُغمِضُوا نَظَرَ الرضا فلربَّما","ضَمّتْ عليه جَناحَها المبلولا",36,"ل",2,0],["لا تُغَطّى عَنهُ مَكرُمَةٌ","بِرُبى وادٍ وَلا خَمرِه",37,"ر",2,0],["لا تَغبِطَنَّ فَتىً بِحُسنِ أَناتِهِ","تَحتَ المَخيلَةِ داؤُهُ مَهجورُ",38,"ر",1,0],["لا تَغشَهُم كَوُلوجِ الهَمِّ يَطرُقُهُم","بِالكُرهِ بَل مِثلَ وَسقِ الخَيرِ مَصحوبا",39,"ب",2,0],["لا تَغبِطِ القَومَ في ضَلالَتِهِم","وَإِن رُؤوا في النَعيمِ قَد سَبَحوا",40,"ح",3,0],["لا تَغبِطوا رَجُلاً عَلى ما نالَهُ","إِن باتَ قَد سادَ الرِجالَ وَلَم يُسَد",41,"د",1,0],["لا تَغبِطَنَّ عَلى الهِباتِ فَإِنَّها","زَهرٌ يَزولُ مَعَ الزَمانِ الأَزهَرِ",42,"ر",1,0],["لا تَغبِطِ الأَقوامَ يَوماً عَلى","ما أَكَلوا خَضماً وَما سُربِلوا",43,"ل",3,0],["لا تُغَيِّر هَذا البَياضَ فَإِن تَأ","بَ فَلا تَجزَعَنَّ إِن قيلَ ناصِل",44,"ل",1,0],["لا تُغرينّكمو وعودُ محالف","يطأ الممالك بادِّعاءِ مصالحِ",45,"ح",1,0],["لا تَغْزُوَنَّ الدَّهْرَ آلَ مطرَّفٍ","لا ظالماً أبداً ولا مَظْلُوما",46,"م",2,0],["لا تغو في دنياك مستهتراً","فإن أصحابك فيها غووا",47,"و",3,1],["لاَ تَغَارِي مِنْ حُسْنِهَا المَلْحُودِ","وَشَبَابٍ فِي شَرْخِهِ مَفْقُودِ",48,"د",1,1],["لاَ تغْضَبِي مِنْ مِدْحَتِي إِنَّهَا","قَدْ وَجَبَتْ وَالفَضْلُ قَدْ يُشْكَرُ",49,"ر",1,0],["لا تغد عليَّ بمُجْتَرِمٍ","لم يثْبُتْ عندك شُهَّدهُ",50,"د",2,0],["لا تغني فإن حشرجة الميت","وجهش النعاة في مسمعيّا",51,"ي",2,1],["لا تغضَبنَّ على فول، ولا عدسٍ","ولو أَتوك بسمٍ ناقعٍ هار",52,"ر",1,0],["لا تُغلِ نفسك أو ترخص أخاك، فقد","سوَّاك ربك من طين وسواه",53,"ا",2,0],["لا تغضبوا ضاع كرجع الصداح","في ضجّة الفوضى وسخف النعيق",54,"ق",1,0],["لا تغش سرَّ فتاة ٍ كُنْتَ تألفُها","إنَّ الكريم لها راعٍ وإن تابا",55,"ب",2,0],["لا تَغُرّنّكَ جَوْلَةُ الدّهْرِ إنّ ال","دّهرَ، إنْ كانَ مُذنِباً، سيَتوبُ",56,"ب",1,0],["لا تغرّنك ضحكة من حزين","ضحكات البروق سرّ الرّعود",57,"د",1,0],["لا تغف تحلم بالنجوم فيرتمي","منها لرشف لماك ألف شهاب",58,"ب",1,0],["لا تغف وأثم في هواك ولا تخف","نسكي أمانك في غد وثوابي",58,"ب",2,0],["لا تغضبي مني ... اذا غلب الهوى","ان الهوى في طبعه غلاب",59,"ب",1,0],["لا تَغتَر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصام",60,"م",1,0],["لا تَغْلُظَنَّ على امرىء ٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",61,"ن",1,0],["لا تَغتَرر بِشَبابك الغَض الَّذي","أَيامُهُ قَمر يَلوح وَيأفلُ",62,"ل",1,1],["لا تغبط المجدَب في علمه","وإن رأيتَ الخِصبَ في حالِه",63,"ه",1,1],["لا تغض العيوب طرف بغي","نشأت بين بيئة شنعاء",64,"ا",2,0],["لا تغترر بتعففي عن شربها","وبنفض ظهر الكف إذ تدعوني",65,"ن",2,0],["لا تغضبن لما قد قلت من ألمي","أقوال ذلك إضماراً وإعلانا",66,"ن",2,0],["لا تغرنْك الأماني كلما","كثُر المال فتهوى في ظُلَلْ",67,"ل",1,0],["لا تغيبي مرة واحدةً","واسبحي يا كأس في سرى وهيم",68,"م",1,0],["لا تغتبط 