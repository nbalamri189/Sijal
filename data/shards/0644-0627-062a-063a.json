{"poems":[[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"خذ من حياتك للممات الآتي","https://www.aldiwan.net/poem36676.html","الكامل"],[71,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[35,"ولقد لقيت على الدريجة ليلة","https://www.aldiwan.net/poem39168.html","الكامل"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"طي اللقاء له نشور","https://www.aldiwan.net/poem63006.html","مجزوء الكامل"],[51,"أراحنا الله منك يا قذره","https://www.aldiwan.net/poem63010.html","البسيط"],[51,"بينما أنت في احتيال فياشك","https://www.aldiwan.net/poem65818.html","الخفيف"],[51,"لا تغافل يا أبا الصقر","https://www.aldiwan.net/poem65861.html","مجزوء الرمل"],[51,"لا تغش إلا ملكا في منزلِه","https://www.aldiwan.net/poem65968.html","الرجز"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[51,"عجبا يا قوم للصنع","https://www.aldiwan.net/poem66737.html","مجزوء الرمل"],[70,"لا تلمني أو فلمني","https://www.aldiwan.net/poem42453.html","مجزوء الرمل"],[92,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[45,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[45,"يا سعيد والأمر فيك عجيب","https://www.aldiwan.net/poem11045.html","الخفيف"],[45,"أرسوم دار أم سطور كتاب","https://www.aldiwan.net/poem11430.html","الكامل"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[45,"الله الله يا أبا الحسن","https://www.aldiwan.net/poem66680.html","المنسرح"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"المرء يطلب والمنية تطلبه","https://www.aldiwan.net/poem10382.html","الكامل"],[49,"إن الخطوب غدوها ورواحها","https://www.aldiwan.net/poem62031.html","الكامل"],[49,"جدوا فإن الأمر جد","https://www.aldiwan.net/poem62047.html","مجزوء الكامل"],[49,"إن ذا الموت ما عليه مجير","https://www.aldiwan.net/poem62069.html","الخفيف"],[49,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[49,"من جعل الدهر على باله","https://www.aldiwan.net/poem63091.html","السريع"],[49,"لا تغضبن على امرئ","https://www.aldiwan.net/poem63180.html","مجزوء الكامل"],[49,"الله بيني وبين مولاتي","https://www.aldiwan.net/poem64131.html","المنسرح"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[44,"نفسي فداء محمد ووقاؤه","https://www.aldiwan.net/poem30295.html","الكامل"],[69,"كم من صديق صدوق الود تحسبه","https://www.aldiwan.net/poem29301.html","البسيط"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[46,"سرحوب عمن سرى لله مبتعثا","https://www.aldiwan.net/poem22129.html","البسيط"],[46,"قد علموا أن سيخطف الشبح","https://www.aldiwan.net/poem22289.html","المنسرح"],[46,"لا تكرموا جسدي إذا ما حل بي","https://www.aldiwan.net/poem22495.html","الكامل"],[46,"لا تطلب الغرض البعيد وتسهر","https://www.aldiwan.net/poem22697.html","الكامل"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[46,"عجبا للقطا من الكدر والجو","https://www.aldiwan.net/poem23274.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72239","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147506","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54779","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[95,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=721",""],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[50,"يا صاح قمْ فاسقني بالكأس إعرابا","https://www.poetsgate.com/ViewPoem.aspx?id=17117",""],[45,"يا سَعيدٌ، وَالأمْرُ فيكَ عَجيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31534",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[51,"اسْعَدْ بعيد أخي نُسْكٍ وإسلامٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30411",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""]],"verses":[["لا تَغرُرَنَّكَ مِن عَدُو","وِكَ رَميَةٌ مِن غَيرِ رامِ",0,"م",1,0],["لا تَغبِطَنَّ عَلى البَقاءِ مُعَمَّراً","فَلَقُربُ يَومِ مَنِيَّةٍ مِن مَولِدِ",1,"د",1,0],["لاَ تُغْفِل الْحَزْمَ الَّذِي بِعِقَالِهِ","إبلُ الإِمَارَةِ وَالإِدَارَةِ تُعْقَلُ",2,"ل",1,0],["لا تَغْتَرِرْ فهُوَ السّرابُ بقِيعَةٍ","قدْ خودِعَ الماضِي بهِ والآتي",3,"ي",1,0],["لا تَغتَرر بِالدَهرِ إِن وافاكَ في","حالٍ يَسُرُّكَ إِنَّهُ غَرّارُ",4,"ر",1,0],["لا تَغدرَنَّ بِوَصلِ عَزَّةَ بَعدَما","أَخَذَت عَلَيكَ مواثِقًا وَعُهودا",5,"د",2,0],["لا تغرّنّكم شِباكٌ كبارٌ","أصبحت لاصطيادنا منسوجه",6,"ج",2,0],["لا تَغمُرُ النعمُ الجلائِلُ قَدْرَهُ","كلا ولا تَزْهَاهُ حتَّى يمرحا",7,"ح",2,0],["لا تغترر بطهارةٍ","فيها البشاشة والسرور",8,"ر",1,0],["لا تغسل الدهرَ كفّها قَذَراً","فكفّها طولَ دهرها غمره",9,"ر",2,0],["لا تغرنَّك المطامِعُ منه","إنَّه ليس من ضِباب احتراشِك",10,"ك",1,0],["لا تغافلْ يا أبا الصق","رِ وليستْ فيك غفلَهْ",11,"ل",2,1],["لا تَغْشَ إلا ملكاً في منزلِهْ","يُعرضُ في مشربهِ ومأكلِهْ",12,"ل",2,1],["لا تَغْتَرر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصامِ",13,"م",1,0],["لا تَغبننَّ موالاتي ولا مِدَحي","فقد عهِدتك ممن يكره الغَبَنا",14,"ن",2,0],["لا تَغْلُظَنَّ على امرئٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",15,"ن",1,0],["لا تُغَرَّنَّ فلن يغ","فَلَ علّامُ الخفايا",16,"ا",3,0],["لا تُغالِطني وَحَقُّ ال","لَهِ ما يَكذِبُ ظَنّي",17,"ن",2,0],["لا تُغَنِّينِي أَغَاريدَ الصَّبَاحْ","بُلْبُلَ الأَفْراحْ",18,"ح",1,0],["لا تَغلُ في جودِ الرِجالِ فَإِنَّهُ","لَم أَرضَ جوداً غَيرَ جودِ أَديبِ",19,"ب",1,0],["لا تَغُرَّنكَ جَولَةُ الدَهرِ إِنَّ الدَ","هرَ كانَ مُذنِباً سَيَتوبُ",20,"ب",1,0],["لاتَغلُ في شَمسِ بنِ أَكلُبَ إِنَّها","ظُفري فَرَيتُ بِها العَدُوَّ وَنابي",21,"ب",2,0],["لاتَغتَرِر مِن حِلمِهِ وَاِحتَرِس","مِن سَطوَةٍ فيها السِمامُ النَقيع",22,"ع",1,0],["لا تُغرِيَن شُؤمَكَ القَديمَ بِهِم","فَيُصبِحوا كَالرُسومِ وَالدِمَن",23,"ن",1,0],["لا تَغتَرِر بِالحادِثاتِ فَما","لِلحادِثاتِ عَلى امرِئٍ بُقيا",24,"ا",1,0],["لا تَغبِطَنَّ أَخاً بِمَعصِيَةٍ","لا تَغبِطَن إِلّا أَخا التَقوى",24,"ا",1,0],["لا تَغضَبَنَّ عَلى الزَمانِ فَإِنَّ مَن","يُرضي الزَمانُ أَقَلُّ مِمَّن يُغضِبُه",25,"ب",2,0],["لا تَغتَرِر فَكَأَنَّني بِعُقابِ رَي","بِ الدَهرِ قَد نَشَرَت عَلَيكَ جَناحَها",26,"ح",3,0],["لا تَغفُلُنَّ فَإِنَّما","آجالُكُم نَفَسٌ يُعَدُّ",27,"د",1,0],["لا تَغُرَّنَّكَ العُيونُ فَكَم أَع","مى تَراهُ وَإِنَّهو لَبَصيرُ",28,"ر",1,0],["لا تَغفُلَنَّ فَإِنَّ الدارَ فانِيَةٌ","وَشُربُها غُصَصٌ وَصَفوُها رَنَقُ",29,"ق",1,0],["لاتَغبِطَنَّ الدَهرَ ذا ثَروَةٍ","قَد جَعَلَ اللَذاتِ مِن بالِهِ",30,"ل",2,0],["لا تَغضَبَنَّ عَلى امرِئٍ","لَكَ مانِعٍ ما في يَدَيهِ",31,"ه",1,1],["لا تَغفِرُ الذَنبَ إِن أَسَأتُ وَلا","تَقبَلُ عُذري وَلا مُؤاتاتي",32,"ت",2,0],["لا تُغضِبَنَّكَ مُنهِضاتي إِنَّها","مَذخورَةٌ لَكَ في السِقاءِ الأَوفَرِ",33,"ر",1,0],["لا تُغنِ أَسماءُ المَلاحَةِ وَالحِجى","فيمَن سِواهُ فَإِنَّها أَسماؤُهُ",34,"ا",3,0],["لا تغبطنَّ بني الدنيا بنعمتهم","فراحةُ القلبِ لم يظفَر بها أحدُ",35,"د",1,0],["لا تُغمِضُوا نَظَرَ الرضا فلربَّما","ضَمّتْ عليه جَناحَها المبلولا",36,"ل",2,0],["لا تُغَطّى عَنهُ مَكرُمَةٌ","بِرُبى وادٍ وَلا خَمرِه",37,"ر",2,0],["لا تَغبِطَنَّ فَتىً بِحُسنِ أَناتِهِ","تَحتَ المَخيلَةِ داؤُهُ مَهجورُ",38,"ر",1,0],["لا تَغشَهُم كَوُلوجِ الهَمِّ يَطرُقُهُم","بِالكُرهِ بَل مِثلَ وَسقِ الخَيرِ مَصحوبا",39,"ب",2,0],["لا تَغبِطِ القَومَ في ضَلالَتِهِم","وَإِن رُؤوا في النَعيمِ قَد سَبَحوا",40,"ح",3,0],["لا تَغبِطوا رَجُلاً عَلى ما نالَهُ","إِن باتَ قَد سادَ الرِجالَ وَلَم يُسَد",41,"د",1,0],["لا تَغبِطَنَّ عَلى الهِباتِ فَإِنَّها","زَهرٌ يَزولُ مَعَ الزَمانِ الأَزهَرِ",42,"ر",1,0],["لا تَغبِطِ الأَقوامَ يَوماً عَلى","ما أَكَلوا خَضماً وَما سُربِلوا",43,"ل",3,0],["لا تُغَيِّر هَذا البَياضَ فَإِن تَأ","بَ فَلا تَجزَعَنَّ إِن قيلَ ناصِل",44,"ل",1,0],["لا تُغرينّكمو وعودُ محالف","يطأ الممالك بادِّعاءِ مصالحِ",45,"ح",1,0],["لا تَغْزُوَنَّ الدَّهْرَ آلَ مطرَّفٍ","لا ظالماً أبداً ولا مَظْلُوما",46,"م",2,0],["لا تغو في دنياك مستهتراً","فإن أصحابك فيها غووا",47,"و",3,1],["لاَ تَغَارِي مِنْ حُسْنِهَا المَلْحُودِ","وَشَبَابٍ فِي شَرْخِهِ مَفْقُودِ",48,"د",1,1],["لاَ تغْضَبِي مِنْ مِدْحَتِي إِنَّهَا","قَدْ وَجَبَتْ وَالفَضْلُ قَدْ يُشْكَرُ",49,"ر",1,0],["لا تغد عليَّ بمُجْتَرِمٍ","لم يثْبُتْ عندك شُهَّدهُ",50,"د",2,0],["لا تغني فإن حشرجة الميت","وجهش النعاة في مسمعيّا",51,"ي",2,1],["لا تغضَبنَّ على فول، ولا عدسٍ","ولو أَتوك بسمٍ ناقعٍ هار",52,"ر",1,0],["لا تُغلِ نفسك أو ترخص أخاك، فقد","سوَّاك ربك من طين وسواه",53,"ا",2,0],["لا تغش سرَّ فتاة ٍ كُنْتَ تألفُها","إنَّ الكريم لها راعٍ وإن تابا",54,"ب",2,0],["لا تَغُرّنّكَ جَوْلَةُ الدّهْرِ إنّ ال","دّهرَ، إنْ كانَ مُذنِباً، سيَتوبُ",55,"ب",1,0],["لا تغضبي مني ... اذا غلب الهوى","ان الهوى في طبعه غلاب",56,"ب",1,0],["لا تَغتَر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصام",57,"م",1,0],["لا تَغْلُظَنَّ على امرىء ٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",58,"ن",1,0]]}