يا ما مثله من قاض","https://www.aldiwan.net/poem46005.html","الكامل"],[530,"لا تغضبن لذم من أخي حسد","https://www.aldiwan.net/poem37156.html","البسيط"],[552,"ألا أرقت لضوء برق أومضا","https://www.aldiwan.net/poem47737.html","الكامل"],[559,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[559,"أيها الجاهل الذي ليس يدري","https://www.aldiwan.net/poem33580.html","الخفيف"],[563,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[568,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[568,"بالله يا متفردا في حسنه","https://www.aldiwan.net/poem69705.html","الكامل"],[576,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"],[576,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[576,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"],[587,"الشيخ قالوا قد غدا سالكا","https://www.aldiwan.net/poem17637.html","السريع"]],"verses":[["لا تَغرُرَنَّكَ مِن عَدُو","وِكَ رَميَةٌ مِن غَيرِ رامِ",0,"م",1,0],["لا تَغبِطَنَّ عَلى البَقاءِ مُعَمَّراً","فَلَقُربُ يَومِ مَنِيَّةٍ مِن مَولِدِ",1,"د",1,0],["لاَ تُغْفِل الْحَزْمَ الَّذِي بِعِقَالِهِ","إبلُ الإِمَارَةِ وَالإِدَارَةِ تُعْقَلُ",2,"ل",1,0],["لا تَغْتَرِرْ فهُوَ السّرابُ بقِيعَةٍ","قدْ خودِعَ الماضِي بهِ والآتي",3,"ت",2,0],["لا تَغتَرر بِالدَهرِ إِن وافاكَ في","حالٍ يَسُرُّكَ إِنَّهُ غَرّارُ",4,"ر",1,0],["لا تَغدرَنَّ بِوَصلِ عَزَّةَ بَعدَما","أَخَذَت عَلَيكَ مواثِقًا وَعُهودا",5,"د",2,0],["لا تغرّنّكم شِباكٌ كبارٌ","أصبحت لاصطيادنا منسوجه",6,"ج",2,0],["لا تَغمُرُ النعمُ الجلائِلُ قَدْرَهُ","كلا ولا تَزْهَاهُ حتَّى يمرحا",7,"ح",2,0],["لا تغترر بطهارةٍ","فيها البشاشة والسرور",8,"ر",1,0],["لا تغسل الدهرَ كفّها قَذَراً","فكفّها طولَ دهرها غمره",9,"ر",2,0],["لا تغرنَّك المطامِعُ منه","إنَّه ليس من ضِباب احتراشِك",10,"ك",1,0],["لا تغافلْ يا أبا الصق","رِ وليستْ فيك غفلَهْ",11,"ل",2,1],["لا تَغْشَ إلا ملكاً في منزلِهْ","يُعرضُ في مشربهِ ومأكلِهْ",12,"ل",2,1],["لا تَغْتَرر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصامِ",13,"م",1,0],["لا تَغبننَّ موالاتي ولا مِدَحي","فقد عهِدتك ممن يكره الغَبَنا",14,"ن",2,0],["لا تَغْلُظَنَّ على امرئٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",15,"ن",1,0],["لا تُغَرَّنَّ فلن يغ","فَلَ علّامُ الخفايا",16,"ا",3,0],["لا تُغالِطني وَحَقُّ ال","لَهِ ما يَكذِبُ ظَنّي",17,"ن",2,0],["لا تُغَنِّينِي أَغَاريدَ الصَّبَاحْ","بُلْبُلَ الأَفْراحْ",18,"ح",1,0],["لا تَغلُ في جودِ الرِجالِ فَإِنَّهُ","لَم أَرضَ جوداً غَيرَ جودِ أَديبِ",19,"ب",1,0],["لا تَغُرَّنكَ جَولَةُ الدَهرِ إِنَّ الدَ","هرَ كانَ مُذنِباً سَيَتوبُ",20,"ب",1,0],["لاتَغلُ في شَمسِ بنِ أَكلُبَ إِنَّها","ظُفري فَرَيتُ بِها العَدُوَّ وَنابي",21,"ب",2,0],["لاتَغتَرِر مِن حِلمِهِ وَاِحتَرِس","مِن سَطوَةٍ فيها السِمامُ النَقيع",22,"ع",1,0],["لا تُغرِيَن شُؤمَكَ القَديمَ بِهِم","فَيُصبِحوا كَالرُسومِ وَالدِمَن",23,"ن",1,0],["لا تَغتَرِر بِالحادِثاتِ فَما","لِلحادِثاتِ عَلى امرِئٍ بُقيا",24,"ا",1,0],["لا تَغبِطَنَّ أَخاً بِمَعصِيَةٍ","لا تَغبِطَن إِلّا أَخا التَقوى",24,"ا",1,0],["لا تَغضَبَنَّ عَلى الزَمانِ فَإِنَّ مَن","يُرضي الزَمانُ أَقَلُّ مِمَّن يُغضِبُه",25,"ب",2,0],["لا تَغتَرِر فَكَأَنَّني بِعُقابِ رَي","بِ الدَهرِ قَد نَشَرَت عَلَيكَ جَناحَها",26,"ح",3,0],["لا تَغفُلُنَّ فَإِنَّما","آجالُكُم نَفَسٌ يُعَدُّ",27,"د",1,0],["لا تَغُرَّنَّكَ العُيونُ فَكَم أَع","مى تَراهُ وَإِنَّهو لَبَصيرُ",28,"ر",1,0],["لا تَغفُلَنَّ فَإِنَّ الدارَ فانِيَةٌ","وَشُربُها غُصَصٌ وَصَفوُها رَنَقُ",29,"ق",1,0],["لاتَغبِطَنَّ الدَهرَ ذا ثَروَةٍ","قَد جَعَلَ اللَذاتِ مِن بالِهِ",30,"ل",2,0],["لا تَغضَبَنَّ عَلى امرِئٍ","لَكَ مانِعٍ ما في يَدَيهِ",31,"ه",1,1],["لا تَغفِرُ الذَنبَ إِن أَسَأتُ وَلا","تَقبَلُ عُذري وَلا مُؤاتاتي",32,"ت",2,0],["لا تُغضِبَنَّكَ مُنهِضاتي إِنَّها","مَذخورَةٌ لَكَ في السِقاءِ الأَوفَرِ",33,"ر",1,0],["لا تُغنِ أَسماءُ المَلاحَةِ وَالحِجى","فيمَن سِواهُ فَإِنَّها أَسماؤُهُ",34,"ا",3,0],["لا تغبطنَّ بني الدنيا بنعمتهم","فراحةُ القلبِ لم يظفَر بها أحدُ",35,"د",1,0],["لا تُغمِضُوا نَظَرَ الرضا فلربَّما","ضَمّتْ عليه جَناحَها المبلولا",36,"ل",2,0],["لا تُغَطّى عَنهُ مَكرُمَةٌ","بِرُبى وادٍ وَلا خَمرِه",37,"ر",2,0],["لا تَغبِطَنَّ فَتىً بِحُسنِ أَناتِهِ","تَحتَ المَخيلَةِ داؤُهُ مَهجورُ",38,"ر",1,0],["لا تَغشَهُم كَوُلوجِ الهَمِّ يَطرُقُهُم","بِالكُرهِ بَل مِثلَ وَسقِ الخَيرِ مَصحوبا",39,"ب",2,0],["لا تَغبِطِ القَومَ في ضَلالَتِهِم","وَإِن رُؤوا في النَعيمِ قَد سَبَحوا",40,"ح",3,0],["لا تَغبِطوا رَجُلاً عَلى ما نالَهُ","إِن باتَ قَد سادَ الرِجالَ وَلَم يُسَد",41,"د",1,0],["لا تَغبِطَنَّ عَلى الهِباتِ فَإِنَّها","زَهرٌ يَزولُ مَعَ الزَمانِ الأَزهَرِ",42,"ر",1,0],["لا تَغبِطِ الأَقوامَ يَوماً عَلى","ما أَكَلوا خَضماً وَما سُربِلوا",43,"ل",3,0],["لا تُغَيِّر هَذا البَياضَ فَإِن تَأ","بَ فَلا تَجزَعَنَّ إِن قيلَ ناصِل",44,"ل",1,0],["لا تُغرينّكمو وعودُ محالف","يطأ الممالك بادِّعاءِ مصالحِ",45,"ح",1,0],["لا تَغْزُوَنَّ الدَّهْرَ آلَ مطرَّفٍ","لا ظالماً أبداً ولا مَظْلُوما",46,"م",2,0],["لا تغو في دنياك مستهتراً","فإن أصحابك فيها غووا",47,"و",3,1],["لاَ تَغَارِي مِنْ حُسْنِهَا المَلْحُودِ","وَشَبَابٍ فِي شَرْخِهِ مَفْقُودِ",48,"د",1,1],["لاَ تغْضَبِي مِنْ مِدْحَتِي إِنَّهَا","قَدْ وَجَبَتْ وَالفَضْلُ قَدْ يُشْكَرُ",49,"ر",1,0],["لا تغد عليَّ بمُجْتَرِمٍ","لم يثْبُتْ عندك شُهَّدهُ",50,"د",2,0],["لا تغني فإن حشرجة الميت","وجهش النعاة في مسمعيّا",51,"ي",2,1],["لا تغضَبنَّ على فول، ولا عدسٍ","ولو أَتوك بسمٍ ناقعٍ هار",52,"ر",1,0],["لا تُغلِ نفسك أو ترخص أخاك، فقد","سوَّاك ربك من طين وسواه",53,"ا",2,0],["لا تغضبوا ضاع كرجع الصداح","في ضجّة الفوضى وسخف النعيق",54,"ق",1,0],["لا تغش سرَّ فتاة ٍ كُنْتَ تألفُها","إنَّ الكريم لها راعٍ وإن تابا",55,"ب",2,0],["لا تَغُرّنّكَ جَوْلَةُ الدّهْرِ إنّ ال","دّهرَ، إنْ كانَ مُذنِباً، سيَتوبُ",56,"ب",1,0],["لا تغرّنك ضحكة من حزين","ضحكات البروق سرّ الرّعود",57,"د",1,0],["لا تغف تحلم بالنجوم فيرتمي","منها لرشف لماك ألف شهاب",58,"ب",1,0],["لا تغف وأثم في هواك ولا تخف","نسكي أمانك في غد وثوابي",58,"ب",2,0],["لا تغضبي مني ... اذا غلب الهوى","ان الهوى في طبعه غلاب",59,"ب",1,0],["لا تَغتَر بحياء فيه من شرسٍ","فالماءُ في كُل عَضْبِ الغرب صَمْصام",60,"م",1,0],["لا تَغْلُظَنَّ على امرىء ٍ لم يَجْتَرمْ","جُرماً وأنت أرقُّ مِن تشرين",61,"ن",1,0],["لا تَغتَرر بِشَبابك الغَض الَّذي","أَيامُهُ قَمر يَلوح وَيأفلُ",62,"ل",1,1],["لا تغبط المجدَب في علمه","وإن رأيتَ الخِصبَ في حالِه",63,"ه",1,1],["لا تغض العيوب طرف بغي","نشأت بين بيئة شنعاء",64,"ا",2,0],["لا تغترر بتعففي عن شربها","وبنفض ظهر الكف إذ تدعوني",65,"ن",2,0],["لا تغضبن لما قد قلت من ألمي","أقوال ذلك إضماراً وإعلانا",66,"ن",2,0],["لا تغرنْك الأماني كلما","كثُر المال فتهوى في ظُلَلْ",67,"ل",1,0],["لا تغيبي مرة واحدةً","واسبحي يا كأس في سرى وهيم",68,"م",1,0],["لا تغتبط يا بنَ الحُصَينِ بِصبيَةٍ","أضحت لديك كثيرة الأعدادِ",69,"د",1,1],["لا تغلبوا جهلا على أنفسكم","فتصبحوا تحت التراب تربا",70,"ب",2,0],["لا تغترر بسواه فيما يدعى","فالصيد كل الصيد في جوف الفرا",71,"ر",2,0],["لا تغترر بالغمض من مستيقظ","وثباته وثباته لا ينكر",72,"ر",1,0],["لا تغضبون ولا ترضون عن رجل","إلا وقصدكم الإِصلاح للرجل",73,"ل",1,0],["لا تُغلقنَّ السمعَ عن عُذري إذا","نَهْنَهْتُ سْؤّالي ببابٍ مُغلقِ",74,"ق",1,0],["لا تَغْرُرَنَّك بالفتورِ فإنه","مرضٌ يضرُّ بقلِبك اسْتِلْذاذه",75,"ذ",2,0],["لا تَغبِطنَّ أخا الغرام فلو غَدا","ملكَ الملوك فقلبُه مسكين",76,"ن",1,0],["لا تغترر منهم بالنسك إن نسكوا","فالنسك سترهم يوما إذا نطقوا",77,"ق",3,0],["لا تغرنْكِ من ترينَ من العج","مِ فما الشرقُ والشمالُ سواءُ",78,"ا",2,0],["لا تغترر بالناسِ فيما ترى","فهمْ معَ الفاتِحِ في كلِّ بابْ",79,"ب",1,1],["لا تغرَّكُم رُتبٌ","حقلُكُم هُوَ الرُتبُ",80,"ب",1,0],["لا تُغَطَّوا بحيفكم واضح الح","ق فيُفْضِي بكم لكلّ دَمَار",81,"ر",1,0],["لا تَغترِر بفتورِ طرفٍ ناعِسٍ","فالسحرُ من لحظاته يقظانُ",82,"ن",1,0],["لا تُغالي في اتهامي","حاكميني، وارحميني",83,"ن",2,0],["لا تغبْ عني كثيراً","خاب ظني في الغيابِ",84,"ب",1,0],["لا تغامرْ، سِرْ رُوَيْداً","ابتعدْ، حاذرْ كفاكَ",85,"ك",1,0],["لا تغترر أنك من فارسٍ","في معدن الملك وأوطانه",86,"ن",2,0],["لا تغفل النفس عن تحصيله أبداً","فلو تسلّت أسلناها على الأسل",87,"ل",1,0],["لا تُغمِضي العَينينِ كي","لا تُبصِري أثرَ الجراح",88,"ح",1,0],["لا تَغضبنَّ فالغَضَب","في المزح من سوء الأَدَب",89,"ب",1,0],["لا تغرقن في وصف حور كأنها","من القاصر