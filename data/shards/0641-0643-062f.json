{"poems":[[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[44,"رأيت زيادا يجتويني بشره","https://www.aldiwan.net/poem50454.html","الطويل"],[44,"وأهوج ملجاج تصاممت قيله","https://www.aldiwan.net/poem50465.html","الطويل"],[37,"ألم يحزنك يوم غدت حدوج","https://www.aldiwan.net/poem39174.html","الوافر"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[90,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[90,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[74,"أخربت قلبي الذي صيرته وطنا","https://www.aldiwan.net/poem18466.html","البسيط"],[53,"بخلت علي بجدوى سواك","https://www.aldiwan.net/poem66528.html","المتقارب"],[64,"حل وعقد وأثال وأوزان","https://www.aldiwan.net/poem52227.html","البسيط"],[76,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[50,"إلى الله أشكو حب من جل نيله","https://www.aldiwan.net/poem63319.html","الطويل"],[52,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8239","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[37,"","https://poetry.dctabudhabi.ae/diwan/poem/19803","الطويل"],[52,"طربتَ إلى \"حوضى \" وأنت طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16891",""],[136,"وأحوى في الملاحة ذي افتتان","https://www.aldiwan.net/poem54706.html","الوافر"],[136,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[146,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[159,"وهاج لي الشوق أسى كامنا","https://www.aldiwan.net/poem55478.html","السريع"],[234,"الحمد لله شكرا هذا","https://www.aldiwan.net/poem51260.html","المجتث"],[255,"كتبت لنا بذاك البر برا","https://www.aldiwan.net/poem14932.html","الوافر"],[261,"يا سائلي عن خبري","https://www.aldiwan.net/poem48555.html","مجزوء الرجز"],[276,"هل عرس الظاعن المشيم","https://www.aldiwan.net/poem52049.html","مخلع البسيط"],[398,"تحدثت الركاب بسير أروى","https://www.aldiwan.net/poem53432.html","الوافر"],[422,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[447,"وهبتك النصح لو طاوعت من نصحا","https://www.aldiwan.net/poem14423.html","البسيط"],[466,"أمر مطاع أتاني","https://www.aldiwan.net/poem15329.html","المجتث"],[475,"أمن آل سلمى الطارق المتأوب","https://www.aldiwan.net/poem4636.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2429","المتقارب"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110433","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112460","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62502","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96607","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80241","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102238","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21670","الطويل"],[1789,"","https://poetry.dctabudhabi.ae/diwan/poem/122398","الطويل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31490","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46470","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18059","الطويل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123451","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137048",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201414","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202736","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204727","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205012","الوافر"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101633","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65184","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45777","الطويل"],[3748,"","https://poetry.dctabudhabi.ae/diwan/poem/205181","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128919","المجتث"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40045","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70163","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105501","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83457","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58126","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72529","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72754","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120523","البسيط"],[4778,"تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=189598",""],[3591,"أممت نزهة نفس خارج البلد","https://www.poetsgate.com/ViewPoem.aspx?id=149392",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5413,"مررنَ كأحلام الكرى!","https://www.poetsgate.com/ViewPoem.aspx?id=200636",""],[572,"يا رُبَّ مُهْدٍ هَدِيَّة ً لَطُفَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9443&r=&rc=300",""]],"verses":[["فَكَدَرتُ تَحتَ النَقعِ مِن جَبَهاتِهِم","مِثلَ النُجومِ عَلى العَجاجِ الأَكدَرِ",0,"ر",1,0],["فَكَدَّ قَليلاً ثُمَ صَدَّ وَقَد بَنَت","عَلى كُرهِهِ أَنيابُهُ وَأَنامِلُه",1,"ل",2,0],["فَكَدَّ قَليلاً ثُمَ صَدَّ كَأَنَّما","يَعُضُّ بِصُمٍّ مِن سَدى جَبَلٍ راسي",2,"س",2,0],["فَكِدتُ وَقَد تَغَيَبَتِ التوالي","وَهُنَّ خواضِعُ الحَكَماتِ عوجُ",3,"ج",1,0],["فَكِدتُ أَموتُ مِن شَوقٍ عَلَيهِم","وَلَم أَرَ نأويُ الأَظعانِ بالا",4,"ل",2,0],["فكدت تملأ فرغ الواديين بما","حشرت من طبق يأتيك عن طبق",5,"ق",1,0],["فكدت بقربهم أنسى بلادي","وأسلو الطفّ ثمة والغَريّا",6,"ر",3,0],["فكدتُ بالرغمِ أخلي منك جانبه","خوفاً عليك من المستوطن الحرج",7,"ج",1,0],["فكدني أكِدك ولا تألُني","ستعلم مَنْ كيدُه أَمْتنُ",8,"ن",1,0],["فكد فكرا وأسرع في التجارب إن","أتقنت علمك فالتقصير حرمان",9,"ن",1,0],["فَكِدتُ وَدونَ الصِبا شَيبَةٌ","أَجُرُّ هُنالِكَ ما أَذهَبا",10,"ب",2,0],["فَكَدَّرَ العَيشَ بِيَومٍ أَبلَقِ","أَقطارُهُ بِلَهوِهِ لَم تَلتَقِ",11,"ق",1,0],["فَكِدنا جَميعاً مِن حَلاوَةِ لَفظِهِ","نُجَنُّ وَلَم نَسطِع لِمَنطِقِهِ صَبرا",12,"ر",2,0],["فَكِدنا وَلَمّا غَيرَ أَنَّ شِفاهَنا","تَعاطَت خَليطَي سُكَّرٍ وَعُقارِ",13,"ر",1,0],["فَكَدَّرَ ذاكَ العَيشَ بَعدَ صَفائِهِ","أَحاديثُ قَتّاتٍ لَهُنَّ دَبيبُ",14,"ب",1,0],["فَكِدتُ وَلَم أَملِك إِلَيها صَبابَةً","أَهيمُ وَفاضَ الدَمعُ مِنّي عَلى نَحري",15,"ر",2,0],["فَكِدْنَا نَخَالُ الدْهْرَ قَابَلَ حَالَةً","وَدَابَرَهَا ثُمَّ اسْتَوَى مُتَرَدِّدَا",16,"د",2,0],["فَكِدنَ لَعَمرُ اللهِ يُحدِثنَ فِتنَةً","لِمُختَشِعٍ مِن خَشيَةِ الله تائِبِ",17,"ب",1,0],["فكدَّار ذاك الْعيْشَ بعْد صفائه","أحاديث قتَّاتٍ لهُنَّ دبيبُ",18,"ب",1,0],["فَكِدتُ أطِيرُ مِن فَرَحٍ وَوَجدٍ","فَأومَاَ وَهو يَضحَكُ لِلعَنَانِ",19,"ن",1,0],["فَكِدتُ أطِيرُ مِن وَلَهٍ ولَكِن","خَشِيتُ مِنَ الرَّقيبِ لَدَى إطِّلاَعِ",20,"ع",1,0],["فكدت بأن أنسى لذاك فصاحتى","سوى أنّ طبعا في الحمَام هديرُها",21,"ر",3,0],["فَكِدْتُ أَنْ أَغْرَقَ في دَمْعَتي","وَأَجْعَلَ الذَّنْبَ لِيَوْمِ الرَّحِيلْ",22,"ل",1,0],["فكدتُ أفِنيه بالضَّ","ضمّ والعِناق وأَفنَى",23,"ن",2,0],["فكدَّر صَفوَةُ الكيَّالُ حتَّى","بَقينا منه في أمر عُجَاب",24,"ب",1,0],["فكدت أن أخرى على","دست الرئيس الطبري",25,"ر",2,0],["فَكَ دَعا البين من قلوب","في ركبهم ما لها جسوم",26,"م",1,0],["فَكِدتُ أَطيرُ من شَوقٍ اِلَيها","بِقادمةٍ كَقادِمَةِ الحمامِ",27,"م",1,0],["فكدْتُ أَطيرُ سروراً به","ومن ذا يطير بغير الجناح",28,"ح",1,0],["فكدت أَعلم ما كنت ضمائرهم","ولو أَردت بها التصريح لانصرحا",29,"ح",2,0],["فكِدتُ أُمْسك لولا","عُلوُّ قدْرِ المُسائلْ",30,"ل",1,0],["فَكِدتُ اشتياقاً إِذ أَلَمَّ خَيالُها","أَبوحُ وَيَبدو مِن هَوايَ المُغَيَّبُ",31,"ب",1,0],["فَكِدتُ أَموتُ وَقَد حُمِّلَت","خَطيئَتَهُ رَبَّةُ الدُملُجِ",32,"ج",1,0],["فكدَّر الدهرُ ذاك العيش واأسغى","من بعد ما كان فيكم زاهياً نضِرا",33,"ر",2,0],["فكدت من عنبرها أن أجن","يا ويلة المشتاق مما به",34,"ه",1,0],["فكدت أغْرِقُه أو كدتُ أَحْرِقُه","من عبرتي أدمعاً أو لبتي نَفَسَا",35,"س",2,0],["فَكدّرَ عَيشي كشفه لي وصدقه","لِعلميَ أَنّ العيشَ كسوة سالبِ",36,"ب",1,0],["فَكدتُ لَو لَو تَثر نَكباءُ عاصِفَةٍ","مِنها أَنالُ عَلى رَغم العِدا وَطَري",37,"ر",2,0],["فَكدت أَن أَهلك لَولا أَني","أَحضَرت قَلبي وَاستشرت ذهني",38,"ي",1,0],["فكِدت ولم أفعل وكيف وليس لي","مُعينان حقاً صحةٌ وفراغُ",39,"غ",1,0],["فَكِدتُ أَبُثُّهُ فِي جَفنِ عَينِي","لِكَي أَستَودِعَ الزَّهرَ السَّحابا",40,"ب",2,0],["فَكِدتُ لِذِكراها أَطيرُ صَبابَةً","وَغالَبتُ نَفساً زادَ شَوقاً غِلابُها",41,"ب",3,0],["فكدهم بمثلي إن مثلي عليهم","شديدٌ وخلقي في الرجال مديدُ",42,"د",1,0],["فَكِدتُ وَقَد خَلَّفتُ أَصحابَ فائِدٍ","لَدى حَجَرِ الشَغرى مِنَ الشَدِّ أُكلَمُ",43,"م",1,0],["فَكِدنا وَلَم نَملُك عِنان تَشبثٍ","نَشك وَقُلنا غائب سيؤوب",44,"ب",1,0],["فَكِدتُ أَذوقُ المَوتَ لَو أَنَّ عاشِقاً","أَمَرَّ بِموساهُ الشَوارِبَ فَاِنتَحَر",45,"ر",1,0],["فكدنا نضم الرمح قداً مهفهفاً","ونلثم خد السيف وهو موردُ",46,"د",1,0],["فكدت اذوب من غيظي وكادت","تفيض النفس حين صددت قهرا",47,"ر",2,0],["فكدت أعاف الله من فرط مدحه","وأعشق إبليساً لكثرة سبّه",48,"ب",2,0],["فكدت أقول يا أنا يا مثالي","أرى بك أحمد الصافي الوحيدا",49,"د",2,0],["فكدت أعذلهم واليوم أعذرهم","إذ ليس عندهمو شيء ليعطوه",50,"ه",1,0],["فكدت أموت فيه من ازدحام","وأسكن فيه قبل القبر قبرا",51,"ر",2,0],["فكدت فعجابي وشدة حيرتي","أخر على وجهي وأجهر بالكفر",52,"ر",1,0],["فكدتُ أطيرُ من طربي سُرُورا","ولا عجبٌ إذا طار الغرابُ",53,"ب",1,0],["فَكُدت أُباري البَدر تيهاً وَقَد بَدَت","أَهلة شعري بَينَ أَهل المَشاعر",54,"ر",1,0],["فكدت أقضي بكاء غير سالية","وكيف أسلوك في خطب كذا جلل",55,"ل",1,0],["فكدروا صفو مائي","ومزقوا ثوب طهري",56,"ي",1,0],["فَكِدْتُ إِجلالاً لَهُ","أُدْمِي يَدَيْهِ قُبَلا",57,"ل",2,0],["فكدتهُ مِن عَصر ادم في الوَرى","وَلَديهِ ماضي الأمر مثل الحاضرِ",58,"ر",1,0],["فكدت أطير من فرحي سروراً","وليس سوى المسرة من جناح",59,"ح",1,1],["فَكدتُ من حَسرَتي أَقضي وَمن أَلَمي","أَشكو إلى اللَّهِ آلامي وَحَسراتي",60,"ت",2,0],["فَكِدتُ عَنها أَنكُلُ","لَولا الإِمامُ الأَفضَلُ",61,"ل",1,0],["فكدتُ أَنِيهُ مُغتبطاً على من","تفاخر بالجدودِ وبالقبائِلْ",62,"ل",1,0],["فكدت من غير ما جناح","أطير عن قصري المشيد",63,"د",1,0],["فكدت من غير ما جناح","من جدل نحوه أطير",64,"ر",1,0],["فكدت اذهل اني في رضى ملك","وانه لي مجن يدفع المحنا",65,"ن",2,0],["فكدناهم وضاقوا فينا ذرعا","فمن رحم البلاء نرى انتصارا",66,"ر",2,0],["فكدت أسري بلا خفٍ ولا قدمُ","أن الرياح أطارت كالقطا جسدي",67,"د",2,0],["فكدت ألبيك لما دعو","ت وأصغي لصوتكَ كالحاضر",68,"ر",1,0],["فكدتُ أبوحُ السرَّ للبدرِ عاصيًا","نصائحَ عقلٍ مِنْ سناه تذبذبا",69,"ب",2,0],["فَكِدْتُ من شدّة ِ السرورِ بهِ","آمنُ أنَّ المَشِيبَ يشتَعِلُ",70,"ل",1,0]]}