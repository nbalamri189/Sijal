{"poems":[[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[42,"رأيت زيادا يجتويني بشره","https://www.aldiwan.net/poem50454.html","الطويل"],[42,"وأهوج ملجاج تصاممت قيله","https://www.aldiwan.net/poem50465.html","الطويل"],[35,"ألم يحزنك يوم غدت حدوج","https://www.aldiwan.net/poem39174.html","الوافر"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[88,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[72,"أخربت قلبي الذي صيرته وطنا","https://www.aldiwan.net/poem18466.html","البسيط"],[51,"بخلت علي بجدوى سواك","https://www.aldiwan.net/poem66528.html","المتقارب"],[62,"حل وعقد وأثال وأوزان","https://www.aldiwan.net/poem52227.html","البسيط"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[48,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[48,"إلى الله أشكو حب من جل نيله","https://www.aldiwan.net/poem63319.html","الطويل"],[50,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8239","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/19803","الطويل"],[50,"طربتَ إلى \"حوضى \" وأنت طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16891",""],[133,"وأحوى في الملاحة ذي افتتان","https://www.aldiwan.net/poem54706.html","الوافر"],[133,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[143,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[156,"وهاج لي الشوق أسى كامنا","https://www.aldiwan.net/poem55478.html","السريع"],[230,"الحمد لله شكرا هذا","https://www.aldiwan.net/poem51260.html","المجتث"],[251,"كتبت لنا بذاك البر برا","https://www.aldiwan.net/poem14932.html","الوافر"],[257,"يا سائلي عن خبري","https://www.aldiwan.net/poem48555.html","مجزوء الرجز"],[272,"هل عرس الظاعن المشيم","https://www.aldiwan.net/poem52049.html","مخلع البسيط"],[394,"تحدثت الركاب بسير أروى","https://www.aldiwan.net/poem53432.html","الوافر"],[417,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[442,"وهبتك النصح لو طاوعت من نصحا","https://www.aldiwan.net/poem14423.html","البسيط"],[462,"أمر مطاع أتاني","https://www.aldiwan.net/poem15329.html","المجتث"],[471,"أمن آل سلمى الطارق المتأوب","https://www.aldiwan.net/poem4636.html","الطويل"]],"verses":[["فَكَدَرتُ تَحتَ النَقعِ مِن جَبَهاتِهِم","مِثلَ النُجومِ عَلى العَجاجِ الأَكدَرِ",0,"ر",1,0],["فَكَدَّ قَليلاً ثُمَ صَدَّ وَقَد بَنَت","عَلى كُرهِهِ أَنيابُهُ وَأَنامِلُه",1,"ل",2,0],["فَكَدَّ قَليلاً ثُمَ صَدَّ كَأَنَّما","يَعُضُّ بِصُمٍّ مِن سَدى جَبَلٍ راسي",2,"س",2,0],["فَكِدتُ وَقَد تَغَيَبَتِ التوالي","وَهُنَّ خواضِعُ الحَكَماتِ عوجُ",3,"ج",1,0],["فَكِدتُ أَموتُ مِن شَوقٍ عَلَيهِم","وَلَم أَرَ نأويُ الأَظعانِ بالا",4,"ل",2,0],["فكدت تملأ فرغ الواديين بما","حشرت من طبق يأتيك عن طبق",5,"ق",1,0],["فكدت بقربهم أنسى بلادي","وأسلو الطفّ ثمة والغَريّا",6,"ر",3,0],["فكدتُ بالرغمِ أخلي منك جانبه","خوفاً عليك من المستوطن الحرج",7,"ج",1,0],["فكدني أكِدك ولا تألُني","ستعلم مَنْ كيدُه أَمْتنُ",8,"ن",1,0],["فكد فكرا وأسرع في التجارب إن","أتقنت علمك فالتقصير حرمان",9,"ن",1,0],["فَكِدتُ وَدونَ الصِبا شَيبَةٌ","أَجُرُّ هُنالِكَ ما أَذهَبا",10,"ب",2,0],["فَكَدَّرَ العَيشَ بِيَومٍ أَبلَقِ","أَقطارُهُ بِلَهوِهِ لَم تَلتَقِ",11,"ق",1,0],["فَكِدنا جَميعاً مِن حَلاوَةِ لَفظِهِ","نُجَنُّ وَلَم نَسطِع لِمَنطِقِهِ صَبرا",12,"ر",2,0],["فَكِدنا وَلَمّا غَيرَ أَنَّ شِفاهَنا","تَعاطَت خَليطَي سُكَّرٍ وَعُقارِ",13,"ر",1,0],["فَكَدَّرَ ذاكَ العَيشَ بَعدَ صَفائِهِ","أَحاديثُ قَتّاتٍ لَهُنَّ دَبيبُ",14,"ب",1,0],["فَكِدتُ وَلَم أَملِك إِلَيها صَبابَةً","أَهيمُ وَفاضَ الدَمعُ مِنّي عَلى نَحري",15,"ر",2,0],["فَكِدْنَا نَخَالُ الدْهْرَ قَابَلَ حَالَةً","وَدَابَرَهَا ثُمَّ اسْتَوَى مُتَرَدِّدَا",16,"د",2,0],["فَكِدنَ لَعَمرُ اللهِ يُحدِثنَ فِتنَةً","لِمُختَشِعٍ مِن خَشيَةِ الله تائِبِ",17,"ب",1,0],["فكدَّار ذاك الْعيْشَ بعْد صفائه","أحاديث قتَّاتٍ لهُنَّ دبيبُ",18,"ب",1,0],["فَكِدتُ أطِيرُ مِن فَرَحٍ وَوَجدٍ","فَأومَاَ وَهو يَضحَكُ لِلعَنَانِ",19,"ن",1,0],["فَكِدتُ أطِيرُ مِن وَلَهٍ ولَكِن","خَشِيتُ مِنَ الرَّقيبِ لَدَى إطِّلاَعِ",20,"ع",1,0],["فكدت بأن أنسى لذاك فصاحتى","سوى أنّ طبعا في الحمَام هديرُها",21,"ر",3,0],["فَكِدْتُ أَنْ أَغْرَقَ في دَمْعَتي","وَأَجْعَلَ الذَّنْبَ لِيَوْمِ الرَّحِيلْ",22,"ل",1,0],["فكدتُ أفِنيه بالضَّ","ضمّ والعِناق وأَفنَى",23,"ن",2,0],["فكدَّر صَفوَةُ الكيَّالُ حتَّى","بَقينا منه في أمر عُجَاب",24,"ب",1,0],["فكدت أن أخرى على","دست الرئيس الطبري",25,"ر",2,0],["فَكَ دَعا البين من قلوب","في ركبهم ما لها جسوم",26,"م",1,0],["فَكِدتُ أَطيرُ من شَوقٍ اِلَيها","بِقادمةٍ كَقادِمَةِ الحمامِ",27,"م",1,0],["فكدْتُ أَطيرُ سروراً به","ومن ذا يطير بغير الجناح",28,"ح",1,0],["فكدت أَعلم ما كنت ضمائرهم","ولو أَردت بها التصريح لانصرحا",29,"ح",2,0],["فكِدتُ أُمْسك لولا","عُلوُّ قدْرِ المُسائلْ",30,"ل",1,0],["فَكِدتُ اشتياقاً إِذ أَلَمَّ خَيالُها","أَبوحُ وَيَبدو مِن هَوايَ المُغَيَّبُ",31,"ب",1,0]]}