://poetry.dctabudhabi.ae/diwan/poem/59514","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111490","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44903","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86475","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102731","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94590","الكامل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121269","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139650",""],[4755,"مِن بَسمَةٍ _يا حُبُّ_ هذا الدَّمْ","https://www.poetsgate.com/ViewPoem.aspx?id=184809",""],[4755,"الكَفُّ، والجَوَّالُ، والمَبسَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=191248",""],[4767,"إلى نعجة الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=124840",""],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[4767,"المنزلة","https://www.poetsgate.com/ViewPoem.aspx?id=179760",""],[4930,"عَلَّمَتْني الطيورُ","https://www.poetsgate.com/ViewPoem.aspx?id=213638",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5102,"لاهية","https://www.poetsgate.com/ViewPoem.aspx?id=12886",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5152,"عبور","https://www.poetsgate.com/ViewPoem.aspx?id=186233",""],[259,"ما لعيني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5431,"لم تروها شفتي...","https://www.poetsgate.com/ViewPoem.aspx?id=190639",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5691,"أسير الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=205764",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[5956,"مصر الأبية ليس ترضَى بالأسى","https://www.poetsgate.com/ViewPoem.aspx?id=210652",""],[6355,"شيطانة وشيطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66577&r=&rc=37",""],[572,"قد جَادَ طيفُكَ لي بِوَعْدِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9226&r=&rc=83",""]],"verses":[["لَمْ تَحُزْ مَعْرِفَةَ اللَّهِ قَدْ","أَوْرَطَهَا الشَّيْءُ الْذِي حَازَتْ",0,"ت",1,0],["لَم تَحظَ ذائِبَةً لَدَي","كَ وَلَم تَنَل حَظَّ القَبول",1,"ل",1,0],["لم تُحصِ سيّئةَ العادات مقدرتي","مهما تَفَنّنت منها في عباراتي",2,"ت",2,0],["لم تحْلُ جدّاً ولم تحمض مَذاقتُها","بل ذات طعم من الطَّعمين ممزوزِ",3,"ز",1,0],["لم تُحَلَّلْ لمَنْ أتاها ولكِنْ","لم يكنْ دونَها من الشيْبِ حامي",4,"م",2,0],["لَم تَحتَثي خَمرا وَتَحسَبُها","مِمّا بِها نَشوى مِنَ الخَمرِ",5,"ر",1,0],["لَم تُحِبَّ السَيرَ لَيلاً فَإِذا","ذَرَّ قَرنُ الشَمسِ عانَقتَ الكَرى",6,"ر",2,0],["لم تحرم البؤس العزاء ولا الأولى","ضلوا الرجاء من الشعاع الهادى",7,"د",2,0],["لَم تَحمِلِ الجِبالُ مِثلَ حِملي","أَظُنُّ مَولايَ يُريدُ قَتلي",8,"ي",1,0],["لَم تُحصَ مِن عَهدِ الصِبا حَرَكاتُهُ","وَتَخالُهُنَّ مِنَ الخُشوعِ سُكونا",9,"ن",2,0],["لَم تَحكِ نائِلَكَ السَحابُ وَإِنَّما","حُمَّت بِهِ فَصَبيبُها الرُحَضاءُ",10,"ا",2,0],["لَم تَحُزها صِفَةُ المُطري وَلا","مُنيَةُ الراغِبِ لَو قيلَ تَمَنّ",11,"ن",1,0],["لَم تُحمَ مِن مَشرِقِها بِالمَغرِبِ","مُكَذِّباً فيها مَقالَ العَرَبِ",12,"ب",1,0],["لَم تَحفِلي بِعُهودِنا فَنَقَضتِها","يا هَذِهِ نَقضُ العُهودِ حَرامُ",13,"م",1,0],["لَم تُحرِّك مِنهُ العَواصف رُكناً","وَلَكن خابَ مثلها في كِفاحِه",14,"ه",1,0],["لَم تَحِد نَبلُ دَهرِنا بِرِماحٍ","أَو سُيوفٍ عَن ساقِطٍ أَو نَبيلِ",15,"ل",1,0],["لَم تحو حَياة المرء سِوى","أَمل يبلى وَيُجدده",16,"د",2,0],["لم تحد في اندفاعها قيد شبر","عَن سَبيل لها هناك سواء",17,"ا",2,0],["لم تحك نائلك السحاب وإنما","حمت به فصبيبها الرخصاء",18,"ا",2,0],["لم تحمحم تختال بالحسن والقوّة","بل حمحمت تريد العليقا",19,"ق",2,0],["لم تحمَدِ الرومُ إذ رامتْك وَثبتَها","والليثُ لا يحمَدُ العُقبى مُواثِبُه",20,"ب",2,0],["لم تحجُبُوا الشمسَ بالأسرابِ طائرةً","لكنْ من الخزي وجهُ الشمس مُسْتَتِر",21,"ر",1,0],["لم تحك فطرة العقول على من","والها ليس صنعها من قواها",22,"ا",3,0],["لم تحاول وظيفة المنصب العا","لي ولا تبتغي إليه وسيلة",23,"ل",2,0],["لم تحتسي خمرا وتحسبها","ممّا بها نشوى من الخمر",24,"ر",1,0],["لَم تَحمِهِ الأَصحابُ حينَ اِقتَدَتهُ","وَلَهُ إِلى حَوضِ الرَدى إِصحابُ",25,"ب",1,0],["لَم تُحشَ حوشِيَّ الكَلامِ فَقَد أَتَت","مَعدومَةَ الأَشكالِ وَالإِشكالِ",26,"ل",1,0],["لَم تَحوّل عَنهُ النَواظِرَ إِلّا","عِندَما أَوشكَ الأَسى أَن يَثورا",27,"ر",2,0],["لم تَحْمِل الكُثبانُ قضباناً ولا","لاحتْ بدورُ التِّمّ تحت جلابِب",28,"ب",1,0],["لَم تَحفَظوهُ وَلا رَعَيتُم عَهدَهُ","رَعيَ الصَديقِ فَراحَ وَهوَ مُضيَّعُ",29,"ع",1,0],["لم تحرم الشمطاء إلا بعد ما","لعبت برب ذؤابة شمطاء",30,"ا",2,0],["لَم تَحلُ مِن أَعدائِهِ مِن خَوفِهِ","قُرباً وَبُعداً يَقظَةٌ وَمَنامُ",31,"م",1,0],["لَم تحزَنِ العَرَبُ الكِرامُ كَحُزنِها","إِذ فارَقَت زَمَنَ الشَبابِ الأَطيَبا",32,"ب",2,0],["لم تحمل الغبراء قبل وجوده","أحدا تطيق لحمله الخضراءُ",33,"ا",2,0],["لم تحترق إلا بنار الشجون","وزفرة الملتاع والمغرام",34,"م",1,0],["لم تَحْكِ يا دمعَ عيني عند قاتلتي","غداةَ تَرجمْتَ عن بَثّي وأَشجاني",35,"ن",2,0],["لم تَحْوِ إلاّ سديداً واحداً يَدُه","وللكنانةِ مَلاْءَى أسهُماً نثَرا",36,"ر",2,0],["لم تحمهم تلك العسا","كر والحصون العاليه",37,"ي",2,0],["لم تحوِّلك الملمّات على","ضغطِها من كسبِها أو مقتناها",38,"ا",3,0],["لم تحظَ عيني بها والطَّيفُ يشهد في","عزل السهاد ولا في دولة الحلمِ",39,"م",1,0],["لم تَحْسُنِ الأقمارُ بعدَ وجوهِكُم","عندي ولا نظَري إلَيها يطمَحُ",40,"ح",1,0],["لم تحُلْ من فِراقِها كلَّ يومٍ","فهْي صَفراءُ خشيةً من نَواها",41,"ا",3,0],["لم تحترق دار الخليج وإنما","شبت لمن يسري بها نار القرى",42,"ر",2,0],["لم تَحتجِب باريسُ عَن رُوَادها","إلاَّ لِتُذكِي لَوعَةَ الرُّوادِ",43,"د",1,0],["لم تَحتَجِب عنهُ غُيوبٌ فقَد","تكشَّفَت مِن غَيبِه حُجبُه",44,"ب",2,0],["لَم تَحلُ إلّا بهِ الدّنيا ولا مَرَقتْ","منهُ الخَلائقُ عن بُحْبُوحَةِ الدِّينِ",45,"ن",1,0],["لَمْ تحملي ثِقْلَ الهوى فَحَقَرْتِهِ","وخفيفُ أعباءِ الغرامِ ثقيلُ",46,"ل",1,0],["لم تَحْمِهِ البِيضُ الصَوارِمُ والقَنا","والشُوسُ والجُرْدُ السَلاهِبُ والذُرَى",47,"ر",2,0],["لم تَحُطَّ الأيَّامُ منكَ سِوى ما","حَطَّ برْيُ المُدَى من الأطوادِ",48,"د",1,0],["لم تحمِلُ الظُّلمَ التقي","لَ وأَنْتَ تَشْكو حَمْلَ عِقْدِكْ",49,"ك",1,0],["لَم تَحتَضِر إِلّا وَمِصرَ كُلُّها","لِنَظيرِ صُنعِكَ تَستَحِثُّ وَفودا",50,"د",2,0],["لَم تَحلُ لي مِن زَماني لَحظَةٌ عَذَّبتُ","إِلّا أَمَّرتَ وَحاكَت وَقعَ مُرّانِ",51,"ن",1,0],["لم تحفلي بالنازلاتِ صواعقاً","والعاصفاتِ تهبُ حول فِناك",52,"ك",1,0],["لم تحتلبْ حلبٌ شؤونَ مدامعي","إِلا وقد نيط الأسى بنياطي",53,"ي",1,0],["لم تحملت الذي لا تستطيع","وغدا بولك ذا منحصرا",54,"ر",2,0],["لِمَ تحبون باطلاً ولماذا","تبتغون اقتراف كذبٍ مضرِّ",55,"ر",1,0],["لم تحفظوا البأس مثل من حفظوا","لم تخزنوا المال مثل من خزنوا",56,"ن",3,0],["لم تحنِ رأسك للعواصف آمناً","واقيتها بالضاحك البسَّامِ",57,"م",1,0],["لَم تحسن الرِّئاسه","لَم تَطب السِّياسه",58,"ه",1,0],["لم تحترم منه عصا موسى التي","ابدا تحطم صخرة الوديان",59,"ن",1,0],["لم تحدُ مُدلجة الركائب رغبةٌ","إلاَّ وكان لربعكم إدلاجها",60,"ج",3,0],["لم تحكِ أخلاقَهُ الصهباءُ مُرتشفا","ولم تماثِلهُ أربابُ النهى ظَرفا",61,"ف",2,0],["لم تَحفظي للبازِ حُرمةَ","والدٍ حرِّ المَناقِبْ",62,"ب",1,0],["لم تحم شاذي هذه المطهم","مة الجرد ولا المرهفات والأسل",63,"ل",1,0],["لم تحاربْ بصارم أو سنان","بل يراع ٍ بها يفلّ الحديدُ",64,"د",1,0],["لم تَحتفل بمبدإٍ تَجني الإفا","دَةَ به أصافَ وقتٌ أم شَتا",65,"ا",1,0],["لم تَحتفل بغَزَلٍ ولا نسيبٍ","مُعجِبٍ ولا بِحليٍ وحُلا",65,"ا",1,0],["لَم تَحم إِلّا أَنَّها هَتفت بِكم","لَما رأت فَوقَ الثَرى أَقوامَها",66,"م",3,0],["لم تحفظي عهد الفضيلة بينما","لا يستحي آباؤك النبلاء",67,"ا",2,0],["لم تحوِ غلَ كاشح صدورهم","تلك سجايا العرب الاوائل",68,"ل",1,0],["لم تحل بنت الكرم في قدح","الا ويرشفها وترشفهُ",69,"ف",2,0],["لم تحلُ في عيني قنابلُ ذرة","الا غداة أرى بغال الناس",70,"س",1,1],["لم تحرك بنظم شعرك يوما","شهوة هم لها من العباد",71,"د",1,0],["لم تحاول في نظم شعرك الا","خدمة الحق وهو جم الأعادي",71,"د",2,0],["لم تَحْكِكَ السُّحْبُ ولا البَحْرُ في","جُودٍ ولا فاز بما في لُهاكْ",72,"ك",1,0],["لم تَحمِل النُسوانُ مِثلَكَ ماجداً","كلا وشِبهَكَ ما قَبِلنَ قوابلُ",73,"ل",1,0],["لم تحكم فيك أسياف العدا","وبك المحبوب يا قلب احتكم",74,"م",1,0],["لم تحسن الرأي في أمر جريت به","عهدي برأيك الهام وتننزيلُ",75,"ل",1,0],["لم تحتجب قط عنهم كلما وفدوا","حتى انبرى الموت يلقي دونك الحجبا",76,"ب",2,0],["لم تحفلوا بالمنايا عندما اتخذت","شكل القذائف يرميكم بها الرامي",77,"م",2,0],["لم تحمل الغبراءُ خلقاً مثلنا","يرضى الغضاضة أو يطيقُ دوامها",78,"م",3,0],["لم تحوِ حقَّكَ بالمزاحِ فإنما","بالجَدِّ يحوي حقه الطعَّانُ",79,"ن",1,0],["لَم تَحقَهُ فالاسُ ذُومِيذاً تَلِي","فَانقَضَّ مُحتَدِماً وَراحَ يُفزِّعُ",80,"ع",1,0],["لَم تَحفظيهِ وَلَم تَرعى مَوَدتَهُ","وَما جَنى غَير حُبٍّ طاهرٍ سامِ",81,"م",1,0],["لم تحل اللحاظ وهي سيوف","عقدة الوجد من حشا المعمود",82,"د",1,0],["لم تحدثوا في الهجر فعلا زائداً","إلا ولى شوق اليكم يحدث",83,"ث",1,0],["لم تحدر الدَّمعَ إلاّ أَنّها رفعتْ","إلى الأحبةِ من كربِ الهوى قصصا",84,"ص",2,0],["لم تحو شكراً مثلما هو حقّهُ","لكن لتوضح بالقصور تعذُّرا",85,"ر",2,0],["لم تحتَبِس ركبٌ بوادٍ معطِشٍ","إلّا جمَعتُ من البكاءِ غديرا",86,"ر",2,0],["لم تحوه الأقطارُ ثم الأمكنة","وليسَ تبليه مُرُورُ الأزمنهْ",87,"ه",1,0],["لم تحل عن فؤاده أبد الده","ر ولا مال قلبها عن وداد",88,"د",1,0],["لَمْ تَحْكِ.. لكنْ قالَ لِي رِمْشُها","أضعافَ ما يُحْكَى وما يُكتَمْ",89,"م",1,0],["لَم تَحْكِ.. لكنْ قالَ لِي صَمتُها","أَضعَافَ ما يُحكَى وما يُكتَمُ",90,"م",1,0],["لَم تَحُل دونَه عصابات بغيٍ","تَختفي خلف شاهقٍ في الفجاج",91,"ج",1,0],["لم تحِن يا بدر ساعاتُ الرحيل","إن ليلَ الجهلِ في الكون طويلْ",92,"ل",1,1],["لم تحفظوا عهدَ خيرِ الناسِ كلِّهمُ","إذ كنتمُ عنده من خير إخوان",93,"ن",1,0],["لم تحنِ رأسًا في السماءِ وصوتُها","يحكي لنا أنَّ المهانةَ موتُها",94,"ت",3,0],["لم تحسن الحال لي من خوفي حر بكم","فيا بوير لكم فلتحسن الحالُ",95,"ل",1,0],["لم تحسن الرمي، وكانت راميهْ","إذ بعثرت أشلاء جسمي الواهيهْ",96,"ي",2,0],["لم تحسب البحر يدنو من ندى يده","هيهات لا يشبه المثعنجر النبطا",97,"ط",2,0],["لم تحترمْ شفقي ولم","تعبأْ بأيامِ الذُبُولْ",98,"ل",1,0],["لُمْتُ حالي بعد شكّي","في كلام الناس عني",99,"ن",2,0],["لم تحتمل عبء الحياة ولم تطق","فيها البقاء معذب الوجدان",100,"ن",1,0],["لم تحاول إكراه قومٍ عليه","لست عنهم ولا عليهم وكيلا",101,"ل",2,0],["لم تحكها شفةٌ حمراء قانيةٌ","ثارت بأحرفها من دون أسلحةِ",102,"ه",1,0],["لم تحرِّكْ كل المجازرِ نبضاً","فالملايين صمتُها مرموقُ!",103,"ق",1,0],["لمْ تحفظي عَهْد الوَفا","فغدرْت بِي لمّا وفيْت ُ",104,"ت",1,0],["لمْ تَحْذَروا ما كانَ يُحْبَكُ ضِدَّكُمْ","وتَخِذْتُمُ التَّصْفيقَ ضَرْعَ حَلوبِ",105,"ب",1,0],["لمْ تحْتَرِمْهُ فعاشَ في شَجَنٍ إلى","أنْ عبَّ سُمّاً طافَ في الأوْداجِ !",106,"ج",1,0],["لم تحتفظ بصديق عاش معتمِداً","على عطائك إلا كنتَ تغدُرُهُ",107,"ر",2,0],["لم تحي بامرء في سمع وفي بصر","إلا لتحيي منك القلب بالعبر",108,"ر",1,1],["لم تحفظوا للغرب إلا فسقهم","حتى تعمّ مبادئ جوفاء",109,"ا",2,0],["لم تحترفْ إلا أنانيّاتِها‎","تهوى السعادة تكره الإسعادا ‏‎",110,"د",2,0],["لم تحرك ساكناً في فطنةٍ","إنما قد حركتْ غِمدَ الغبا",111,"ب",2,0],["لم تحتقرْ مصرٌ فلسطيناً ولا","شعباً أصيلاً طاهِرَ الأعراقِ",112,"ق",1,0],["لم تحْمِلِ الأرضُ صَخْرا مثلَ قَسْوَته","أثار عاصفةَ غضْبي وطوفانا",113,"ن",2,0],["لم تَحِملِ الظّلْمَ الثَّقِيلَ","وأنتَ تشكُو حَمْلَ عقدِكْ",114,"ك",1,0]]}