{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[10,"ياعين جودي بدمع منك مسكوب","https://www.aldiwan.net/poem20950.html","البسيط"],[29,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[74,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[53,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[64,"ودعت طيب العيش ساعة ودعا","https://www.aldiwan.net/poem52354.html","الكامل"],[63,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[63,"أتظن أن الدهر يسعف طالبا","https://www.aldiwan.net/poem51807.html","الكامل"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"أيا من بين باطية وزق","https://www.aldiwan.net/poem66165.html","الوافر"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[102,"لعيني أم بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67679&r=&rc=166",""],[87,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[164,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[266,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[287,"سقى الله دارا بحزوى الربابا","https://www.aldiwan.net/poem32871.html","المتقارب"],[310,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[354,"من سره الإحسان منه وساءه","https://www.aldiwan.net/poem15936.html","الكامل"],[412,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[445,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[520,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[569,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38875","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78150","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1573,"","https://poetry.dctabudhabi.ae/diwan/poem/199903","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101009","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144787","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144761","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52066","الكامل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53114","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27268","الهزج"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113056","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93564","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93593","الطويل"],[2502,"","https://poetry.dctabudhabi.ae/diwan/poem/35000","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93783","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100237","الكامل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102352","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112585","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87351","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48320","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126955","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205732","المتقارب"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59489","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133214","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102952","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102986","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69985","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44914","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93746","الكامل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145346","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139129","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35080","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[4915,"شقشقة","https://www.poetsgate.com/ViewPoem.aspx?id=211399",""],[4977,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=199748",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[5351,"على درب الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=202234",""],[5459,"غثاء","https://www.poetsgate.com/ViewPoem.aspx?id=199893",""],[5459,"دنان الغش","https://www.poetsgate.com/ViewPoem.aspx?id=205796",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5689,"انا عربي لا جنس أمجد من جنسي","https://www.poetsgate.com/ViewPoem.aspx?id=143432",""],[5781,"جدائله..ضفائِرُ سُهْد","https://www.poetsgate.com/ViewPoem.aspx?id=208776",""],[5784,"لا تسل","https://www.poetsgate.com/ViewPoem.aspx?id=190295",""],[5943,"هوِّنْ عليك فإنَّ العمرَ محدودُ","https://www.poetsgate.com/ViewPoem.aspx?id=60866",""],[6070,"أرى الماءَ يمشي في طريقٍ مغامرِ","https://www.poetsgate.com/ViewPoem.aspx?id=194775",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[6078,"بل أَكثر","https://www.poetsgate.com/ViewPoem.aspx?id=203412",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""]],"verses":[["وَمَنِ اسْتَبَحْتَ ذِمَارَهُ بِعُقُوبَةٍ","فَبِغيْرِهِ مِنْ بَعْدِهَا يُسْتَبْدَلُ",0,"ل",1,0],["وَمِن أَسيرٍ بِلا شُكرٍ جَزاكَ بِهِ","بِساعِدَيهِ كُلومٌ غَيرُ تَجليبِ",1,"ب",1,0],["وَمِنّا سُلَيمانُ النَبِيُّ الَّذي دَعا","فَأُعطِيَ بُنياناً وَمُلكاً مُسَخَّرا",2,"ر",2,0],["ومَناسبٍ عُمرِيةٍ نصبت","درجَ المفاخرِ أحسن النصب",3,"ب",1,0],["ومن استفاض بعدله وبفضله","حتى استوى الجبار والمسكين",4,"ن",1,0],["ومن استجنَّ من الحوادث جارُه","فكأنه بعد الوِلاد جنين",4,"ن",1,0],["ومن استمهلته","ضارعا قد اعجلك",5,"ك",1,0],["ومن استنصرته","واثقا قد خذلك",5,"ك",1,0],["ومن استزلَّ المجدَ عن قُذُفاتِه","متوقّلاً في هضبهِ متفرِّعَا",6,"ع",2,0],["ومُناسِبٌ حازَ الفضيلةَ أعجَماً","فينا كما حازَ الفضيلةَ مُعِربا",7,"ب",2,0],["ومُناسِبُ السَّيفِ الحُسامِ فإنْ جرَى","في الجودِ أصبحَ للسَّحابِ مُناسبا",8,"ب",2,0],["ومِن أُسارى على الأقتابِ خاشعةٍ","تَزِفُّ بينَ المَنايا والأمانيّ",9,"ي",1,0],["وَمَن أَسوا وَأَقبَحُ مِن لَبيبٍ","يُرى مُتَطَرِّباً في مِثلِ سِنّي",10,"ن",2,0],["وَمِن أَسَدٍ أَغوى كُهُولاً كَثِيرَةً","بِنَهيِ غُرابٍ ثُمَّ بَاعَ وحَرَّرا",11,"ر",2,0],["وَمِن أَسَدٍ أَغوى كُهُولاً كَثيرَةً","بِنَهي غُرابٍ يَومَ ما عَوَّجَ الذُرا",12,"ر",2,0],["ومن أساء الصُّنْعَ في عيشه","كيف تُسيئين ولا تُحسنينْ",13,"ن",1,0],["ومن أسمار أجدادي","ومن هذيان جداتي",14,"ت",2,0],["ومَن استُبيح على يَديهم حقُّها","هدراً ، وديست حرمةٌ وذِمام",15,"م",1,0],["ومن اسف اني اودع مربعاً","انيقا ً به كنتم ربيعا ً ومعقلا",16,"ل",2,0],["ومن أسمار أجدادي","ومن هذيان جدتي",17,"ت",2,0],["ومن أسبابها بلغَ اليفاعا","فتى عجمتْه أحداثُ الليالي",18,"ا",3,0],["ومن أسالمه والنفس عالمةٌ","بأنه حربان إن طاش حسبان",19,"ن",1,0],["ومن أسلمته في المكر رجاله","فما أحد ممن يعاديه راحمه",20,"م",2,0],["ومن اسس العليا بناءً على هدي","وتقوى وبنيان الشقي على شفا",21,"ف",2,0],["وَمِن أَسَدٍ دونَها فِتيَةٌ","هُمُ الأُسدُ تَتَّخِذُ الشَمسَ غابا",22,"ب",2,0],["وَمن اِستطال لعلم شيء فوقه","جهلَ الّذي من تحته وتكالبا",23,"ب",2,0],["وَمَن اِستَسَنَّ الرَفضَ لِلأَهوا","ءِ وَاِتَّبِعِ الإِمامَ الحَقَّ جانِبَهُ الخَنا",24,"ن",2,0],["وَمِن أَسلاتِ الخُطِّ كُلَّ لَذيذَةٍ","تَروقك بِالنِبراسِ ذاتَ شَباً عَردِ",25,"د",1,0],["ومناسِكٍ شاقَتْ مساعِيكَ الَّتِي","أَحْذَيْتَها منها المِثالَ الأَبْيَنا",26,"ن",2,0],["ومن أسكت الفضل الذي كان فضله","خطيباً إذا التفت عليه محافله",27,"ل",2,0],["ومن أسفٍ ذو العلم يبخس حقه","وذو دجل تهوي إليه الغنائم",28,"م",1,0],["ومن استثار فما أغار وإنما","سئم الهوانَ الحرُّ والترغيما",29,"م",2,0],["وَمِن أَسَدٍ يَعدو وَآخرَ زائِرٍ","وَمِن ضَيغَمٍ جاثٍ وَساطٍ صَؤولِ",30,"ل",1,0],["ومن أسمائك عجل المدد","والنصر والتفريج والفتح القريب",31,"ب",1,0],["وَمِن أَسيافِها تِلكَ المَواضي","أَراكَ تَحيد عَن نَظَري حَياءً",32,"ا",2,0],["ومن اسرى به جبريل ليلا","لرب العرش مخترقا لحجب",33,"ب",1,0],["ومِن أُسْرةِ المَهْزُولِ قَتْلَى كَثِيرَةٌ","تَخَألُهُمُ في الهيْج أُسْدَ الغَيَاطِلِ",34,"ل",1,0],["ومنا سرها في آل كلب","ومهرة قصره والداعرينا",35,"ن",2,0],["ومنا سيبويه وذو القضايا","أخو جرم رئيس الحاسبينا",35,"ن",2,0],["ومنا ساكن الجغبوب نلوى","به زند الخطوب إذا بلينا",36,"ن",2,0],["ومن استقلَّ من المنية راحلاً","شحَط المزارُ به وفات المرجع",37,"ع",1,0],["ومن استعار الغيث فضل نواله","إذ رام يهمي والسحاب إذا ارحجن",38,"ن",1,0],["ومن استظل الدهر في أعتابه","وسعى إليه خاضعاً متضرعا",39,"ع",2,0],["وَمَنِ اٍسْتَمَالَ إلَى اللَّيَالِي آمِناً","ضَرَبَتْ لَهُ الأخمَاسَ لِلأسْدَاسِ",40,"س",1,0],["ومنا سائر الأنصا","ر والأشراف من فهر",41,"ر",1,0],["ومنا سعفة الريح","لضرب الكلب والهرّ",41,"ر",1,0],["ومن أسبل الغازي بن يوسف ظله","عليه فعار أن يباشر منكرا",42,"ر",2,0],["ومن أسِّي إلى فَرعي","ومِن فَرعي إلى أُسِّي",43,"س",2,0],["ومن استطاع يطيل غرته فمو","قوف على الراوي هو الفوقاني",44,"ن",2,0],["ومن استحالات الزمان وقبحه","وصفي وطاوط مالها من واق",45,"ق",1,0],["ومن استكفى لدى الخطب كفي","يا سراة لهم الفخر سرى",46,"ر",2,0],["وَمِن أسد اللَه الَّذي هُوَ كاسمه","يَزمجر في غاب العُلوم وَيَضبح",47,"ح",1,0],["وَمِن أَسد اللَه العلا لك حَبوة","هِيَ المَجد لا سَيف عَنيت وَلا بَردا",48,"د",2,0],["وَمِنّا سِنانُ المَوتِ وَاِبنُ عُوَيمِرٍ","وَمُرَّةُ فَاُنظُر أَيَّ ذاكَ تَعيبُ",49,"ب",1,0],["ومن استجار به احتمى","وأوى إلى ركن متين",50,"ن",1,0],["ومن استزلَّ النجم عن أبراجها","واستنزل الأقمار من هالاتها",51,"ت",3,0],["ومن أسدٍ وفَّى يزيدٌ لنصره","بكلٍّ فتىً حامي الذّمار منيع",52,"ع",1,0],["ومن استقل الطائرات يجد بها","عزما له في السعى خطو ناجح",53,"ح",1,0],["وَمَن أُساءُ اذا ما مسَّهُ ضررٌ","حتىّ كأَنَّ اليَّ الضرَّ ينصرفُ",54,"ف",1,0],["ومَن أسلَمَ الإيمانَ للشّرْكِ عامِداً","أيُفْلِتُ من قيْدِ الهَوانِ ويُفْلِحُ",55,"ح",1,0],["ومن اسيافهم بالقرع رعد","ومن لمعانها ومض لموج",56,"ج",1,0],["ومن استعصم صدقاً لم يخف","غير باريه ولم يرج سواه",57,"ا",2,0],["وَمَن اِستَذَلَّ لِفَرجِهِ وَلِبَطنِهِ","فَهُما لَهُ مَعَ ذا الهَوى بطنانِ",58,"ن",1,0],["ومن أستمدُّ لديها القُوى","ومن بالقوى أنا أمددتُها",59,"ه",2,0],["ومنا سُليمان الهمام وظافرٌ","ونبهانُ مولى كل حافٍ وناعلِ",60,"ل",1,0],["ومن استعزّ به ولاذ بجاهه","نال العناية والرعاية والنجا",61,"ج",2,0],["ومناسك للحزم فيك تأكدت","فلذ