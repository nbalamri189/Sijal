{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[74,"متع لواحظنا بحسنك ساعة","https://www.aldiwan.net/poem19306.html","الكامل"],[93,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142001","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107035","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118349","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53215","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27777","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88637","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65210","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110164","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114548","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4767,"مهر القريض","https://www.poetsgate.com/ViewPoem.aspx?id=194941",""],[4578,"الآن حققت إن الشمس تنكشف","https://www.poetsgate.com/ViewPoem.aspx?id=49484",""],[4578,"سهم النوائب لا يبقى ولا يذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=49427",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""]],"verses":[["سَلَخَ الظَلامُ إِهابَهُ وَتَهَلَّلَت","جَنَباتُ ذاكَ العارِصِ المُتَهَلَّلِ",0,"ل",1,0],["سَلَخَ الغَوَالِي مِنْ سِنِيهِ مُكَافِحاً","دُونَ العُرُوبَةِ كُلَّ بَاغٍ آثِمِ",1,"م",1,0],["سلْ خصره عن طول ليلة شعره","إنَّ السقيم بطول ليل عارف",2,"ف",1,0],["سَلَخنَها سَبعينَ مِن أَجلِها","في عالَمِ الطِرس وَدُنيا الدُواة",3,"ه",1,0],["سَلْ خَالِياً بِحَرَى يُلَبِّي رَبَّهُ","فِي الغَارِ عَمَّا نَابَهُ فِي الغَارِ",4,"ر",1,0],["سَلَخَ التَّوْأَمَ الحَبِيبَ فَمَاذَا","حَلَّ مِنْهُ بِصِنْوِهِ المُشْتَاقِ",5,"ق",1,0],["سلخَت عني الليالي من أود","مثل سلخ الأم عن مهد الولد",6,"د",1,1],["سل خيبرا عنه وبدرا وسل أحدا تل","قاه قد هزم الأحزاب وانتصفا",7,"ف",2,0],["سل خندقاً وخيبراً وبدرا","فإنها بما أقول أدرى",8,"ر",2,0],["سلخت في الربيع شهر جمادى","تتوخى مواقع الامصار",9,"ر",1,0],["سل خدَّك الأحمر القاني أيشعر ما","سُعاره فهو جوف النار في جَنَن",10,"ن",1,0],["سلخ النهار لعينِ كلِّ محققٍ","سلخاً يشعشعُ نورَه من ظلمته",11,"ت",2,0],["سلخوا جلده فما ظل قوم","حَرموا في القديم طعم الجلود",12,"د",1,0],["سلخ الصّبر عن فُؤادي منهُ","أسودُ الفرع فهو أسود سالخ",13,"خ",1,0],["سلخُ النَهارِ تلاهُ زا","دٌ قُل لنا ماذا يُماثِل",14,"ل",1,0],["سلختَ نهارَ الحقِّ من ليلِ شُبهَةٍ","ببدرٍ وقد طلعتَ في أفقِهِ شمسا",15,"س",2,0],["سل خبيراً به فانى أدرى","فيه من كل حاسدٍ مسماع",16,"ع",1,0],["سلْ (خيبراً) تنبيك عنه فقد غدا","في هولِ معترك القتالِ مُحيَّرا",17,"ر",2,0],["سلخ الشهور وإهلالٌ لهخا أبداً","ما زال طالعها بالبين يختلف",18,"ف",1,0],["سلخ الشهور بها للمرء معتبرٌ","هيهات أين الذي تلقاه يعتبر",19,"ر",1,0],["سُلِخَتْ بِأَيْدِي الأَبْعَدِيْنَ نِكَاْيَةً","بِالأَقْرَبِيْنَº وَزُوِّرَتْ أَسْمَاْءُ",20,"ا",2,0]]}