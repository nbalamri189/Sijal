{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[72,"متع لواحظنا بحسنك ساعة","https://www.aldiwan.net/poem19306.html","الكامل"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142001","الرمل"]],"verses":[["سَلَخَ الظَلامُ إِهابَهُ وَتَهَلَّلَت","جَنَباتُ ذاكَ العارِصِ المُتَهَلَّلِ",0,"ل",1,0],["سَلَخَ الغَوَالِي مِنْ سِنِيهِ مُكَافِحاً","دُونَ العُرُوبَةِ كُلَّ بَاغٍ آثِمِ",1,"م",1,0],["سلْ خصره عن طول ليلة شعره","إنَّ السقيم بطول ليل عارف",2,"ف",1,0],["سَلَخنَها سَبعينَ مِن أَجلِها","في عالَمِ الطِرس وَدُنيا الدُواة",3,"ه",1,0],["سَلْ خَالِياً بِحَرَى يُلَبِّي رَبَّهُ","فِي الغَارِ عَمَّا نَابَهُ فِي الغَارِ",4,"ر",1,0],["سَلَخَ التَّوْأَمَ الحَبِيبَ فَمَاذَا","حَلَّ مِنْهُ بِصِنْوِهِ المُشْتَاقِ",5,"ق",1,0],["سلخَت عني الليالي من أود","مثل سلخ الأم عن مهد الولد",6,"د",1,1]]}