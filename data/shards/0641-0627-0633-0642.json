n/poem/91599","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114430","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114186","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35513","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21593","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73246","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204180",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204178",""],[4778,"رسول السماء","https://www.poetsgate.com/ViewPoem.aspx?id=200413",""],[4852,"غيّ","https://www.poetsgate.com/ViewPoem.aspx?id=214351",""],[4984,"عاد رفاق الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=190247",""],[5121,"رَيْحَانَةُ الحُبَّ","https://www.poetsgate.com/ViewPoem.aspx?id=174814",""],[5121,"شَاعِر","https://www.poetsgate.com/ViewPoem.aspx?id=213481",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5156,"ما ترى طيب وقتنا يا سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=99128",""],[5557,"دمعة هاربة","https://www.poetsgate.com/ViewPoem.aspx?id=26030",""],[1547,"لا تلمني على الدموع الجواري","https://www.poetsgate.com/ViewPoem.aspx?id=16772",""],[5725,"يا رشيقا","https://www.poetsgate.com/ViewPoem.aspx?id=195333",""],[3792,"دار من تهواه دار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613109",""],[6190,"أتيتُ سهواً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87002&r=&rc=8",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["فَاِسقِني فَالوَصلُ يَألَفُني","إِنَّ يَومَ البَينِ قَرحانُ",0,"ن",1,0],["فَأَسقي بِهِ أُختي ضَعيفَةَ إِذ نَأَت","وَإِذ بَعُدَ المَزارُ غَيرَ القَريضِ",1,"ض",1,0],["فاسقِي خَلِيلَكِ مِن شَرا","بٍ لَم يُكَدِّره الدَّرَن",2,"ن",1,0],["فَاسقُط عَلَينا كَشُقُوطِ النَّدى","لَيلَةَ لا نَاهٍ وَلا زَاجِرُ",3,"ر",1,0],["فاسْقني صرف الحميا أطلساً","معها يوم اللقا لا مع دني",4,"ن",2,0],["فاسقنا من شرابك الرائق العذْ","بِ ولا تَحمِنا سَقتكَ السماءُ",5,"ا",2,0],["فاسْقِني عشرين رطلاً","لا تَشبهُنَّ بماءِ",6,"ا",2,0],["فاسْقِ حليبَ الكَرْم شُرَّابَهُ","إذ ليس من شأنهمُ الرائبُ",7,"ب",1,0],["فاسقِها من وَليِّك الجَودِ واربُبْ","ها تَهَدَّلْ لها ثمارٌ عذابُ",8,"ب",1,0],["فاسقِني شَرْبةً يعودُ بها عُو","ديَ غضَّاً عن ريِّه ذا تَثَنِّي",9,"ن",2,0],["فاسقِنيها يا سَوادَ بنَ عَمرو","إِنَّ جِسمي بَعدَ خالِي لَخَلُّ",10,"ل",1,0],["فَاِسقِنيها فِدىً لِعَينَيكِ نَفسي","مِن غَزالٍ وَطارِفي وَتَليدي",11,"د",2,0],["فَاِسقِياني فَقَد تُشُوِّفَتِ الرا","حُ وَطابُ الصُبوحُ وَالاِبتِكارُ",12,"ر",1,0],["فَاِسقِ مِن حَيثُ كانَ يَشرَبُ كِسرى","عُصبَةً كُلُّهُم ظِماءٌ حِرارُ",13,"ر",1,0],["فاسقِني كالعروسِ ألبسَها الما","ءُ وُشاحاً من الحَبابِ وعِقْدا",14,"د",2,0],["فَاِسقِني القَهوَةَ الَّتي قَيلَ عَنها","إِنَّها مِن شَرائِطِ الشَيطانِ",15,"ن",1,0],["فَاِسقِني صِرفَها فَإِنَّ جَديدَ ال","غَيمِ يَدعو إِلى عَتيقِ الدَنانِ",15,"ن",1,0],["فاسقِني عن إذْنِ سلطانِ الهَوَى","ليس يَشفي الرّوحَ إلّا كأسُ راح",16,"ح",1,0],["فَاِسقِنيها يا سَوادَ بنَ عَمروٍ","إِنَّ جِسمي بَعدَ خالِ لَخَلُّ",17,"ل",1,0],["فَاِسقِني لِلراحِ صافِيَةً","تَنشُرُ الإِصباحَ في الظُلَمِ",18,"م",1,0],["فَأَسقيهِ إِلى أَن ماتَ سُكراً","وَلَم يُدفَن وَعَيشِكَ في ضَريحِ",19,"ح",1,0],["فَاِسقِياني رَقيقَةَ السِربالِ","تُعدِماني مَعارِفَ الأَطلالِ",20,"ل",1,0],["فَاسقِني الخَمرَ الَّتي اختَمَرَت","بِخِمارِ الشَيبِ في الرَحِمِ",21,"م",1,0],["فَاِسقِنيها سُلافَةً بِنتُ عَشرٍ","دَبَّ في جِرمِها غِذاءُ الحَرامِ",22,"م",1,0],["فَاِسقِنا حَتّى أَوانِ ال","حَجِّ لا تَسقِ الضَنينا",23,"ن",2,0],["فَاِسقِني كَأساً عَلى عَذَلٍ","كَرِهَت مَسموعَهُ أُذُني",24,"ن",2,0],["فاسقيانيها نهاراً","واهتفا بالشمسِ زولي",25,"ل",2,0],["فأسقِطا بأَقبَحِ الزِّحافِ","سُمِّيَ مشكولاً بلا اختلافِ",26,"ف",1,0],["فَاِسقِياني لا بِكَأسٍ","مِن دَمٍ كَالأُرجُوانِ",27,"ن",1,0],["فاسقنيها قد طال صحوي ومكثي","وتمنّيت سكرة ورواحا",28,"ح",2,0],["فاسقني عشرون رطلاً","لا تشبهن بماء",29,"ا",2,0],["فاسقطْ علينا كسقوطِ الندى","ليلَة َ لا ناهٍ ولا زاجِرُ",30,"ر",1,0],["فاسقط شهود الأشيا","لا إله إلا اللَه",31,"ه",1,0],["فاسقنيها وحسبنا اليوم مادا","م غريراً ووجهه حسن",32,"ن",1,0],["فاسق يظهر العفاف ويخفي","تحته الخزي يا له من مراء",33,"ا",2,0],["فَاسقِني البِكرَ الَّتي في","حِجْرِهَا دَبَّ السُّرورُ",34,"ر",1,0],["فَاسْقني يا غلامُ عاش ليَ العَي","شُ مُداماً تُجْلى بحَلْي الحَبابِ",35,"ب",1,0],["فاسقط إثما عن رجال غررتهم","وبؤت به مثل الرواسي الشماخر",36,"ر",1,0],["فأسقِ روض الهوى غيثَ المنى فعسى","أن نجتني ثمراً للوصل أو طُرَفا",37,"ف",2,0],["فاسقني قاتِلةَ الأح","زان فاليوم مَطِيرُ",38,"ر",1,0],["فاسقني المرّ من صدودك واحكم","جائرَ الحكم في ظلالِ صباكا",39,"ك",2,0],["فَاِسقِطي يا دَعائِمَ الكَذِبِ الجا","ني وَكوني أُسطورَة لِلدُهورِ",40,"ر",1,0],["فاسقني يا نديمُ واشرب بكأسي","واقسم الّلهوَ بيننا والنعيما",41,"م",2,0],["فاسقِنيها على سنا وجهك الغَضْ","ضِ فإني إليه عين المشوقِ",42,"ق",1,0],["فاسقياني فقد تكامل حسن ال","يوم يا صاحِبَيَّ في كلِّ وصفِ",43,"ف",1,0],["فاسقِياني فليس للحمد والمج","د سِوائي وليس للراح غيري",44,"ر",2,0],["فاسِقياها الدموع إِن بخل الغي","ثُ عليها بواكف مِدرار",45,"ر",1,0],["فاسقِيانِي فإنني أطلب المج","د بثارٍ والحادثاتِ بثارِ",46,"ر",1,0],["فاسقِني صِرْفاً وغَنِّ","داوِ بالخمر الخُمَارا",47,"ر",2,0],["فاسِقياني بلا مِزاجٍ فإني","للمعالي صِرْفاً بغير مِزَاج",48,"ج",1,0],["فاسقِنيها مدامةً تَصْبِغ الكأ","سَ كما يَصْبِغ الخدود الشّباب",49,"ب",1,0],["فَأَسقَمَني بِأَجفانٍ مِراضٍ","وَأَقسَمَ لا يُفارِقُني السِقامُ",50,"م",1,0],["فَأَسقَطتُمُ لَفظَةَ الوَردِ مِنهُ","وَجِئتُم بِماءٍ مِنَ البِركَةِ",51,"ه",1,0],["فاسقنيها صرفاً ونَزَه حَلال الماء","عن أن تَشُوبَهُ بحَرام",52,"م",1,0],["فاسقياني محض التي نطق الوح","ي بتحريمهما من القرآن",53,"ن",1,0],["فاسقياني بين الدنان إلى أن","ترياني كبعض تلك 