{"poems":[[71,"قلت وقد عانقته","https://www.aldiwan.net/poem28240.html","مجزوء الرجز"],[107,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[146,"غدا تراها جنحا على الغضا","https://www.aldiwan.net/poem58340.html","الرجز"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[543,"عذت بالله من خضم السياسه","https://www.aldiwan.net/poem47522.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77603","الهزج"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77478","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204585","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65163","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""]],"verses":[["قالَ وهلْ يحسدُنا","قلتُ نعمْ قالَ انفلقْ",0,"ق",1,0],["قالَ وهو العليمُ إذ كلَّمَ القو","مَ ومِنْ مثلهِ يَطيبُ الكلامُ",1,"م",1,0],["قال وهل ترجو الوفاءَ عندهم","كأنها على الأجَلِّ المُرتضَى",2,"ض",2,0],["قالَ وَهَل رَأَيتَهُ","قُلتُ وَهَل عَنّي اِستَتَر",3,"ر",1,0],["قالَ وهوَ الذِي إذا قالَ قولاً","طأطَأ الكلُّ عنِد ذكرِه رَاسَه",4,"س",2,0],["قالَ وَهَل مثلي يُسمّى طائِرا","إِني لَفَأرٌ قَد أتيتُ زائِرا",5,"ر",2,0],["قالَ وَهَل تريدني أُرتَبَطُ","دَعني إِلى الشَوك بِهِ أَختبِطُ",6,"ط",1,0],["قالَ وَهذِه نواصي الخَيل","قَد أقبَلَت مُسرِعَة كَالسيل",7,"ل",1,0],["قالَ وَهَل يُمكن في العُقول","إِنكارك الصانع يا خَليلي",8,"ي",1,0],["قال وهل بالشعر تحيا وهل","تملى به أحشاؤك الجائعات",9,"ت",1,0],["قال وهل أهل لهم تنتمي","قد رابني منك غريب السمات",9,"ت",1,0],["قال وهل من محرز للعلى","في عصرنا قلت لها مُحرز",10,"ز",1,0],["قال وهيراً خولنه المقال","وللثرى أعرافه بانسدال",11,"ل",1,0],["قالَ وهل قلبُكَ ناءٍ به","اِذا الحشاشاتُ جوىً أزفرَتْ",12,"ت",1,0]]}