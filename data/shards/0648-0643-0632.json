{"poems":[[69,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43715","الكامل"],[102,"أخر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=50333",""],[438,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140227",""],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131969","الرمل"]],"verses":[["وَكَزُغْبِ القَطا وَرائِي فِراخ","مِنْ إناثٍ أعُولُهُمْ وذُكُورِ",0,"ر",1,0],["وَكَزَ العَدُوُّ حُبَيِّبي","شُلَّت يَمينُ وكوزِهِ",1,"ه",1,1],["وكزهر الرمّان اختلجت","شفتاك ، وخفّتك الخجلى",2,"ل",2,0],["وَكَزْتَ حَشَا اللَّعِينِ بمُنْكِصَاتٍ","على الأَعقابِ من جِهَةِ العُقَاب",3,"ب",1,0],["وَكَزتْه بشليلٍ ظنَّهُ","مِنْ قَفاه أنّه طَعْنُ القَنا",4,"ن",2,0],["وَكَزُوهُ ليَلْحقُوهُ فَآبُوا","بِقَصِيرٍ عنِ المَدَى مَوْكُوز",5,"ز",1,0],["وكزهرة وافى الربيع بحسنها","او لامعا فكلاهما أخوان",6,"ن",1,0],["وكزوس الراح في","كف ذاك الأغيد",7,"د",1,0]]}