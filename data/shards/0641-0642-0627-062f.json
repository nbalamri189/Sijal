{"poems":[[55,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[41,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[136,"عجبت لأسرة الحسن الدينا","https://www.aldiwan.net/poem54720.html","الوافر"],[173,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[240,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[520,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[545,"أتاني وأهلي باللوى فوق مثعر","https://www.aldiwan.net/poem56882.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122765","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125476","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87761","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5135,"صُدُود","https://www.poetsgate.com/ViewPoem.aspx?id=201817",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5979,"كأنك حين ضل الناس عنها","https://www.poetsgate.com/ViewPoem.aspx?id=181359",""],[5997,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=214289",""]],"verses":[["فَقادَ الجَديلَ إِلى لاحِقٍ","وَأَهدى الوَجيهَ إِلى داعِرِ",0,"ر",1,0],["فَقادَتهُمُ قَودَ الأَيانِقِ في البُرى","وَزَمَّتهُمُ زَمَّ القُرومِ المَصاعِبِ",1,"ب",1,0],["فقاد مستصعَبَ الأمور بهِ","لا خائفاً ضَعفَهُ ولا قِصَرَهْ",2,"ر",2,0],["فَقادَت لَنا المَأمومَ في القَدِّ عَنوَةً","جَنيباً إِلى ضَبعَي مُواشِكَةِ الوَخدِ",3,"د",1,0],["فَقادَ الوَرى الجدُّ وَهوَ التقى","لِعِزِّ الرِقابِ الَّتي فَكَّكا",4,"ك",2,0],["فَقَادَتني الخُئُولُةُ لِلمَعَالِي","ومَا كُنتُ الجَبَانَ المُستَكِينَا",5,"ن",2,0],["فَقادَ إِلى الإِفرَنجِ جَيشاً زُهاؤُهُ","عَديدُ الحَصا ذا أَزمَلٍ وَزَمازِمِ",6,"م",1,0],["فَقادَ صِعابِها وَبِها جَماحٌ","وَأَخمَدَ نارَها وَلها اِستِعارُ",7,"ر",1,0],["فقادَ بريماً من رِجالٍ أعِزَّةٍ","ليلقى خميساً قارِحاً مُتجَمِّرا",8,"ر",2,0],["فقادَ إلى حَرْب الوصيّ كتائباً","ولم تُغْنيه عندَ النِّزالِ كتائبُهْ",9,"ب",2,0],["فقادَ إِليكِ الخيلَ شُعْثاً شَوازباً","يُلَبِّينَ بالنَّصرِ العزيز انتصارَكِ",10,"ك",1,0],["فقاد عنان الصبح والصبح أشهب","وساق إليك الليل والليل أدهم",11,"م",1,0],["فَقادَ إِليها الحالبينَ فَأنهَلوا","ظِماءً إِذا صارَت إِلى الريِّ عَلَّتِ",12,"ت",1,0],["فَقادُوا إلَينا كُلَّ أبيَضَ مِخذَمٍ","وَقادُوا إلَينا كُلَّ أَجرَدَ شَيظَمِ",13,"م",1,0],["فقادني وَجدَ قلبي غيرَ واجفةٍ","إلى اقتفاء خيالٍ جَدَّ في طلبي",14,"ب",2,0],["فَقادَ أُمته لِلحَرب مرغَمَةً","وَراحَ يَحسب ما يَأتيهِ إِفلاحا",15,"ح",2,0],["فَقادَ أَوَّلَها هَكطورُ أَوَّلُهُم","كَذاكَ فوليدَماسٌ مَن أَمالَهُمُ",16,"م",1,0],["فقادهم جيشاً تسيل بمدِّه","بطاح بني ماء السماء وتَجزر",17,"ر",1,0],["فَقَاْدَتُنَاْ تُهَذِّبُنَاْ عِيَاْلَاً","وَمَنْ فَوْقِ الْمَنَاْبِرِ يَجْلُدُوْنَاْ",18,"ن",2,0],["فقادتْني خُطَايَ إلَى حِمَاهَا","يُعَاتِبُ قَلْبِيَ الْمَشْدُوْهَ لُبِّي",19,"ب",2,0],["فَقَادُوكِ مَعصُوبَةً لَلوَرَاءِ","بِ\\\" قَالَ الرَّسُولُ وقَالَ الإِلَهْ \\\"",20,"ا",3,0],["فَقَادُوهُ نَحْوَ الْمَوْتِ للهِ مَا دَجَا","مِنَ الخَطْبِ مَا أبكىٰ عُيونَ النَّوَايِبِ",21,"ب",1,0],["فقادت إليه جيشها وهو واحد","وقد شحنت بالرجف ستا جهاتها",22,"ت",3,0],["فقاد له إلى بغداد قوداً","تجلى لحمها جنب الفرات",23,"ت",1,0],["فقادت نار في قلبي ضراماً","وسجن اليأس قهراً اودعوني",24,"ن",2,0]]}