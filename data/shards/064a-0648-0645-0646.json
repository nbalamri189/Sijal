{"poems":[[55,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[72,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[87,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[107,"أنذر الأقوام لو تغني النذر","https://www.aldiwan.net/poem43084.html","الرمل"],[21,"عند ذي العرش يعرضون عليه","https://www.aldiwan.net/poem36133.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[69,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39582","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[100,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[136,"ويذكرني الأمين إذا بدا لي","https://www.aldiwan.net/poem54839.html","الوافر"],[159,"يومنا يوم مطير ولذاذات","https://www.aldiwan.net/poem55688.html","مجزوء الرمل"],[186,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[190,"ما دام شيء ولا يدوم","https://www.aldiwan.net/poem43318.html","مخلع البسيط"],[234,"يومنا لين الحواشي رقيق","https://www.aldiwan.net/poem50927.html","الخفيف"],[266,"ذراني إذا ما فؤادي صبا","https://www.aldiwan.net/poem38370.html","المتقارب"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[354,"بدر بم من القبا","https://www.aldiwan.net/poem15778.html","مجزوء الخفيف"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[473,"يومنا يوم مجون","https://www.aldiwan.net/poem59622.html","مجزوء الرمل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100595","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110432","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96985","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59744","الرمل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44935","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64739","البسيط"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216694",""],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122900","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109192","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109182","الخفيف"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216850",""],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178073","الرجز"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216297",""],[1594,"","https://poetry.dctabudhabi.ae/diwan/poem/97781","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96040","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93652","الرمل"],[2558,"","https://poetry.dctabudhabi.ae/diwan/poem/200322","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75948","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112674","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89399","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89297","الكامل"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35888","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138520",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91960","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205951","الرمل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21494","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114582","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135354","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136812",""],[4192,"","https://poetry.dctabudhabi.ae/diwan/poem/104437","الكامل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115310","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83154","الكامل"],[4718,"البارحه ليلي على الفكر طالي","https://www.poetsgate.com/ViewPoem.aspx?id=137216",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[4896,"نضال لا ينتهي","https://www.poetsgate.com/ViewPoem.aspx?id=180869",""],[4988,"فوز وفشيله","https://www.poetsgate.com/ViewPoem.aspx?id=185312",""],[5122,"المسافه","https://www.poetsgate.com/ViewPoem.aspx?id=33178",""],[5281,"دمعتان على خدِّ النِّيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=199523",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5480,"الأسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=1159",""],[5539,"قصيدة فكر","https://www.poetsgate.com/ViewPoem.aspx?id=198815",""],[5643,"استمع بالله يا ابن ال","https://www.poetsgate.com/ViewPoem.aspx?id=181290",""],[5652,"وطن ال بدون !!","https://www.poetsgate.com/ViewPoem.aspx?id=176984",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[6008,"ياسعود","https://www.poetsgate.com/ViewPoem.aspx?id=60804",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"يؤمن بالأوهام غر جهول","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573898",""],[6302,"رَجَاحَهْ ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86239&r=&rc=37",""]],"verses":[["يُؤَمِّنُ سَطوَةَ لَيثِ العَرينِ","وَمَضجَعُهُ بَينَ غيلٍ وَغابِ",0,"ب",1,0],["يَومُنا يَومٌ مَطيرُ","وَلَنا كَأسٌ تَدورُ",1,"ر",1,1],["يُؤَمِّنُنا عَلى الدُستورِ أَنّا","نَرى مِن خَلفِ حَوزَتِهِ فُؤادا",2,"د",2,0],["يُؤمِنُها مِن هَذِهِ الأَهوالِ","وَيَخمُسُ العُشبَ وَلا تُبالي",3,"ل",2,0],["يَومُنا المَشهودُ لا يَومَ لَنا","إِن أَضَعناهُ فَوَلّى وَغَبَرْ",4,"ر",1,0],["يَومَ نَأتيهِ وَهوَ رَبٌّ رَحيمٌ","إِنَهُ كانَ وَعدُهُ مَأتِيّا",5,"ي",2,0],["يَومَ نَأتيهِ مِثلَما قالَ فَرداً","لَم يَذَر فيهِ راشِداً وَغَوِيّا",5,"ي",2,0],["يوْمَ نَالت بِوَضْعِهِ ابنَةُ وَهْبٍ","مِنْ فَخَارٍ ما لم تَنَلْهُ النِّساءُ",6,"ا",2,0],["يومَ نالَتْهُ بإفْكٍ يَهودٌ","مِثْلَمَا اسْتَنْبَحَ بَدْرٌ كِلابا",7,"ب",2,0],["يوم نادتكَ باسمكَ العذبِ فريا","لُ أبي هللَ الزمانُ السعيدُ",8,"د",1,0],["يَوْمَ نَادَى الفَتَى العَظِيمُ فَلَبَّى","مَنْ نَبَا قَبْلَهُ بِصَوْتِ المُنَادِي",9,"د",2,0],["يَومَ نادَيت فَرَّجَ اللَه كَربي","إِنَّني اِشتَقتُ مَسجِدي وَالأَديبا",10,"ب",2,0],["يوم نادانا فلبّينا النِدا","وتركنا نُهيَةَ الدين ورانا",11,"ن",2,0],["يُؤَمِّنُ مِن مخاوفِ كُلَّ ثَفرٍ","بدهرٍ فيهِ فُتِّحَت الثُّغُورُ",12,"ر",1,0],["يَومُنا يومٌ مَطيرُ","ولذَاذاتٌ حضورُ",13,"ر",1,1],["يَومَ نَعَى ليَ مِن أَهوى بِبكرتِهِ","فَخِلْتُ شَمسَ الضُحى في مُقلَتي زُحَلا",14,"ل",2,0],["يوم نعيم ويوم بؤس","لا البؤس يبقى ولا النعيم",15,"م",1,0],["يومُنا ليّن الحواشِي رقيق","ليس فيه لغيرها مستفيق",16,"ق",1,1],["يؤم نوالهم النازحين","إذا عم جودهم الأقربا",17,"ب",2,0],["يَومَ نُشِرَ وَحُشِرَ","وَوُقوفٌ وَمَجمَعُ",18,"ع",1,0],["يُؤمِنُ القَلبَ قُربُهُ","وَنَواهُ يَروعُهُ",19,"ع",2,0],["يُؤْمَنُ المرءُ ثُمّ يُؤْمَلُ جُوداً","هو ذاك المأمولُ والمَأمون",20,"ن",1,0],["يَومُنا يَومُ مُجونِ","فَخُذُوهُ في سُكونِ",21,"ن",1,1],["يوم نهضنا كأمثال الأسود به","وأقبلت كالدبى زحفاً أعادينا",22,"ن",2,0],["يومٌ نَعَى الناعي بهِ بدرَ الدجى","لا بل نَعى شمساً يحجبُها الثَرَى",23,"ر",2,0],["يوم نلت المنى فهنيت فيك","المجد علماً بأنه لك توأم",24,"م",1,0],["يومنا يومُ صباح مشرقٍ","فأجيبوا يا نجوم الأفق",25,"ق",1,1],["يَومُنا طَيِّب بِهِ حُسنُ القَص","فِ وَحَثَّ الأَرطالِ وَالكاسات",26,"ت",1,1],["يومٌ نَصَرْتَ بهِ العلياءَ والجودا","وساعةٌ غادرْتَ صَيْداً لك الصِّيدا",27,"د",2,1],["يوم نور ديارننا ضوّ القمر","يوم زج الشّعب من لجٍّ غزير",28,"ر",1,0],["يومنا يوم جمعة بأبي أن","ت وعند الوضيع لا كان قومُ",29,"م",1,1],["يوم نشدو وقد تبلبلت الا","لسن حتى حكت خوار العجوز",30,"ز",1,0],["يوم نهزو بدهرنا","أن تجافى وقطَّبا",31,"ب",2,0],["يوم نَسنَس مِ المشاريجِ","غدّر بطيبٍ ومِطلِنّه",32,"ن",2,0],["يَؤُمّ نَجْداً والعَقيقُ همُّهُ","مُسترشداً ينفض أخلاق الطرق",33,"ق",1,0],["يوم نَشّ وثار بالعاني","وطيِتَه في الأرض موزونه",34,"ن",2,0],["يومَ نادى إلى الصلاةِ بلال","فبكينا بعد النداءِ مَليا",35,"ي",2,0],["يومنا بين بارق بالمحبات","كفاها أن ياك عوداً كفاها",36,"ا",3,0],["يوم نادى يا ساكن الملأ الأع","لى يميناً بعزتي وعلاها",36,"ا",3,0],["يومنا الآتي فَلا علم لَنا","بالَّذي يبديه فاشرب عَن عجل",37,"ل",1,0],["يومنا يومَ بالوصالِ هنيُّ","فخرُهُ من رباربٍ رَبَوِيُّ",38,"ي",1,1],["يوم نيران القرى قد اطفئت","وركاب المجد قد أوثق عقلا",39,"ل",2,0],["يَوم نادى وَعَلى السَيف اِنحنى","أَيُّها القَوم انسبوني مَن أَنا",40,"ن",2,0],["يوم نادت في وغاها خندفا","وتنادينا بآباء شرف",41,"ف",1,0],["يَومنا يُشبِهُ أَمسِ","مِثلَما نُصبِحُ نُمسي",42,"ي",1,1],["يوم نرى أعمالنا ولم يحق","بالنفس إلا ما تكون تستحق",43,"ق",1,0],["يؤمنون النصارى واليهود على","ديوانهم ويدانوهم لقربهم",44,"م",1,0],["يومٌ نراكَ فيه يومُ عيدِ","يُفدى بعُمرِ الزَمنِ المديدِ",45,"د",1,0],["يوم نسيم بنعيم أتى","حتى غدا غرة وجه الزمان",46,"ن",1,1],["يوم نسيمٍ مر يومٌ جلا","وصفا لعيني باجتماع جميل",47,"ل",1,1],["يَومَ نَيروزِكَ يَومٌ","واحِدٌ لا يَتَأَخَّر",48,"ر",1,1],["يوم نفى السلوان عن أشياعه","اني وقد شابت به أطفالها",49,"ل",3,0],["يوم ناداهم جهاراً وقد نبّ","ه فيه البصير عنه السميعا",50,"ع",2,0],["يَوم نُوفَّى ما عملنا بِهِ","وَشاب طفل وَاندهى رجالُ",51,"ل",1,0],["يومنا عاد فهل تعرفه","شد ما رعرعه العام السريع",52,"ع",1,1],["يَومَ نُدعى إِلى الحِسابِ وَمَعنا","يَومَ نَأتيكَ سائِقٌ وَشَهيدُ",53,"د",1,0],["يُؤمِّنُنا حُبٌّ لَهُ وَصَبابَةٌ","يَطِيبُ حَياةً في المماتِ وفي المحيا",54,"ي",2,0],["يؤَمِّننا حُبٌّ لهُ وصبابةٌ","فَلَسنا نخافُ الدهرَ داهيةً دَهيا",54,"ي",2,0],["يوم نأيه نال عيني أوارٌ","ولمن يدني ما يشاء يُجَمُّ",55,"م",1,0],["يومنا ما سمع العاذل ولا طيع نصاح","غير في لجة ارجيها مع كل من صاح",56,"ح",1,0],["يوم نعمت به بقر","بك لم يعبه سوى القصر",57,"ر",1,0],["يَومُ نعيمٍ وَيومُ لَهوٍ","خُصِصتَ فيه بما تريدُ",58,"د",1,0],["يَومٌ نَشَرتَ بِهِ جُحا","يَومٌ عَلى القُرّاءِ عيدُ",59,"د",1,0],["يومنها حامت بروس الرجالي","تصعب عليكم ياهل الفرس الانجاس",60,"س",1,0],["يومننا صغار مثل الورد بين الخميل","نمسي على ضحكنا بين الصحو والخْيْال",61,"ل",1,0],["يومنا ذكرى كفاح ومنى","تحشد البهجة في حاضرنا",62,"ن",2,0],["يوم (ن) على ثريّا وقف ضدّها قوم","قوم (ن) من الغيره فلا هي حصيله",63,"ل",2,0],["يوم ناظرتني نظرت الود بسكات","وهزت ظفاير راسها وفهقتها",64,"ت",3,0],["يَومَ نَمضِي في غُربةٍ مِن خُطانا","وعلى النِّيلِ تَلتَقي دَمعَتَانِ",65,"ن",1,0],["يوم نادت شريعة الله فيه","ليس إلا للعادلين الولاء",66,"ا",2,0],["يوم نادى تلاقفوها لعمري","إن يوم الحساب قولٌ هراء",67,"ا",2,0],["يومن تعاهدنا على الود نرضاه","في ليلة ٍ طل القمر لأصحابها",68,"ب",3,0],["يومن تحداني قيوده حديدي","ولاحتار (حاتم) ف الكرم مامعه صرف",69,"ف",1,0],["يومنا في الحسن والبه","جة قد جاز التمي",70,"ي",1,0],["يومن نصيح بصوت حقٍ يماري","نلقى بدون المصطلح فيه يحكون",71,"ن",1,0],["يوم نادى محمد في جميع ال","خلق إذ قال مفصح التخبير",72,"ر",1,0],["يوم نتسمع للعلوم القدامي","تلقى الغيار بوقتنا والفظيعه",73,"ع",2,0],["يوم ناديت قافي جت خيوله عرايا","أقبلت تصطفق صوبي وتجمح جميح",74,"ح",1,0],["3. يُؤمنُ رَوْعَهُ ويَذُبُّ عَنْهُ","ويُبْدُلُ عُسْرَهُ يُسْرَاً وَ لِيْنَا",75,"ن",2,0],["يُؤَمَّنُ فِينا كُلُّ باغٍ وَظالِمٍ","وَيَحكُمُ فِي أَحوالِ عِيشَتِنا غِرُّ",76,"ر",1,0],["يومن غدو مثل البَصل روس واوبشوا","وَشاخوا الشَباب وَقلطوا العَيان",77,"ن",1,0],["يُومن لَفوا حُوران ثاري بحمها","صَوارم قَواطع يصفطوا الرُوح دونَها",78,"ن",3,0],["يومن غمر كل النَواحي فَسادهم","سُكان سُوريا عَلى الاجمال",79,"ل",1,0],["يومن برد حر البلاد وَلهيبها","ساقوا المؤامن في عزا العيال",79,"ل",1,0],["يُؤمِنُ بِالأَوهامِ غِرٌ جَهول","وَمعظَمُ الإِيمانِ فِعلُن فَعول",80,"ل",1,1],["يَومُنا مُستلَبُ الرُّوح مَهِينٌ","عِزُّهُ خَفْقُ المَخازي المستَباحَهْ",81,"ح",2,0]]}