{"poems":[[79,"هذي ثمان قد قطعن الدجى","https://www.aldiwan.net/poem36662.html","السريع"],[33,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[79,"هذي ثمان قد قطعن الحجا","https://www.poetsgate.com/ViewPoem.aspx?id=33640",""],[463,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138340",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48506","الكامل"],[2090,"","https://poetry.dctabudhabi.ae/diwan/poem/198729","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137947",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205778","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87608","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126339","الكامل"],[4740,"لا نامت أعين الجبناء","https://www.poetsgate.com/ViewPoem.aspx?id=206374",""],[4916,"ياسنين","https://www.poetsgate.com/ViewPoem.aspx?id=135641",""],[5135,"قِبْلَةُ الكَوْن","https://www.poetsgate.com/ViewPoem.aspx?id=201820",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5953,"السين سر شريف","https://www.poetsgate.com/ViewPoem.aspx?id=93857",""],[5956,"اعترافٌ عادل","https://www.poetsgate.com/ViewPoem.aspx?id=192316",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""]],"verses":[["هَذي ثَمانٌ قد قَطَعْنَ الدُّجى","في سَيْرِها مُعْتَبَرٌ للحِجا",0,"ج",2,1],["هَذي ثَمانِيَةٌ تَهُلُّ وَتَنقَضي","عالَجتُ فيها سُقمَ صَبٍّ مُغرَمِ",1,"م",1,0],["هذي ثمان قد قطعن الحجا","في سيرها معتبر للحجا",2,"ج",2,1],["هذي ثمارُ الحلمِ مُجلَبَةٌ","فتهنَّها ونتيجة الصَّبْرِ",3,"ر",1,0],["هذي ثِمارُ نَوالِه فليَقْتَطِفْ","ما يَبتغي المُحتاجُ من حاجاتِهِ",4,"ت",2,0],["هذي ثياب الفخر زينت الفتى","وازاءها لا تذكروا الاستبرقا",5,"ق",2,0],["هذي ثمار فتى بروضك عوده","ريان من ماء الشباب الجاري",6,"ر",2,0],["هذي ثماركَ قد دنت وتدفقت","والشعب حولك يفتدي ويذودُ",7,"د",1,0],["هذي ثلث من سنيها مضت","ونحن في حجتها الرابعه",8,"ع",2,0],["هَذِي ثَلاَثٌ مُسعِدَاتٌ لِلَّذِي","قَد نَالَهَا وَالفَضلُ لِلمَنَّانِ",9,"ن",1,0],["هذي ثناياك قد لاحت بوارقها","أم أشرقت في الدجى أنوار برجيس",10,"س",1,0],["هذي ثمارك طابت في مغارسها","وذاك غصنك يندي وهو فينان",11,"ن",1,0],["هَذي ثُريّا الارض لاحَت في سما","مَجدٍ تأَلَّق نورها وَتبسما",12,"م",2,1],["هذي ثمار العلم ذُقها تعترف","من لم يذق ثمر المعارف ما عرف",13,"ف",1,1],["هَذِي ثُغُورُ بَنِي الإِسْلاَمِ .... تَمْقُتُنَا","لَمْ يَبْقَ مِنْهَا ... سِوَى مَا يَنْدُبُ الطَّلَلاَ",14,"ل",2,0],["هذي ثمان سنين والعمر فاني","ينقص .. وانا والهم من زود في زود",15,"د",1,0],["هَذِي ثَمَانٌ أَتَتْ بَعْدَ الثَّمَانِيْنا","وازْدَدْتَ يَا وَطَنِي عِزّاً وتَمْكِيْنا",16,"ن",2,1],["هذي ثلاث طبائعٍ قد جمعت","في قسمة الجسمان للإنسان",17,"ن",1,0],["هذي ثلاث حروف","مكتوبة في المعمى",18,"م",2,0],["هذي ثقافتنا العدالة أوَّلاً","لسنا نسبِّب أيما استعداءِ",19,"ا",2,0],["هذي ثمارُ سنيني بتُّ أحصدها","وأحكم العرش في عهدٍ سليماني",20,"ن",2,0],["هذي ثوانيك قد نامتْ عقارِبُها","متى سَتُوقظها يا أيها السَّاري؟!",21,"ر",2,0]]}