{"poems":[[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[32,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[74,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[53,"الأرض تنقص من أطرافها أبدا","https://www.aldiwan.net/poem65057.html","البسيط"],[53,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[58,"حمائم ورق في حمى ورق خضر","https://www.aldiwan.net/poem58584.html","الطويل"],[63,"ومخطف الخصر برده حبر","https://www.aldiwan.net/poem51617.html","المنسرح"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[82,"وغيداء لا ترضى بلثمي خدها","https://www.aldiwan.net/poem31343.html","الطويل"],[35,"وقالوا لو تشاء سلوت عنها","https://www.aldiwan.net/poem26031.html","الوافر"],[50,"بديع الخلق موفور الخطوط","https://www.aldiwan.net/poem64370.html","الوافر"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[53,"راع فؤادي منك ما راعَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29511",""],[135,"فإن يك رأسي كالثغامة نسله","https://www.aldiwan.net/poem24160.html","الطويل"],[141,"وصفراء في الكأس كالزعفران","https://www.aldiwan.net/poem67932.html","المتقارب"],[159,"لها حكم لقمان وصورة يوسف","https://www.aldiwan.net/poem55476.html","الطويل"],[168,"عيون ما يلم بها الرقاد","https://www.aldiwan.net/poem67847.html","الوافر"],[199,"قضاعية الكعبين كندية الحشا","https://www.aldiwan.net/poem54358.html","الطويل"],[261,"أنا ابن حجاج إليه أبي","https://www.aldiwan.net/poem48437.html","السريع"],[261,"يا صاح فاشرب واسقني","https://www.aldiwan.net/poem48446.html","مجزوء الرجز"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[280,"بنفسي مثلجات للصدور","https://www.aldiwan.net/poem25442.html","الوافر"],[287,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[305,"أغدوا واعد الحي الزبالا","https://www.aldiwan.net/poem45471.html","الوافر"],[353,"بنيتم على تقوى من الله مسجدا","https://www.aldiwan.net/poem20053.html","الطويل"],[353,"ودائرة في الأرض لا تطعم الكرى","https://www.aldiwan.net/poem20055.html","الطويل"],[376,"نظرن بأسياف عليها جفونها","https://www.aldiwan.net/poem57093.html","الطويل"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[406,"في جوف الكعبة","https://www.aldiwan.net/poem6711.html","عموديه"],[422,"وقفنا بالركائب يوم سلع","https://www.aldiwan.net/poem54152.html","الوافر"],[447,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[463,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[466,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[473,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[475,"لها حسن عباد وجسم ابن واقد","https://www.aldiwan.net/poem4799.html","الطويل"],[482,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[520,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"رأيت خيال الظل أكبر عبرة","https://www.aldiwan.net/poem34333.html","الطويل"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93485","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122691","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64322","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62526","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120127","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119859","البسيط"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130874","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17043","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17031","الطويل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117066","الرجز"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101988","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112748","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31611","الوافر"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124699","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78147","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101041","المجتث"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2316,"","https://poetry.dctabudhabi.ae/diwan/poem/200310","الطويل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10412","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205839",""],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100607","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26956","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59443","المتقارب"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119482","الطويل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62077","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4702,"عقارب طينة الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=155178",""],[5277,"الليالي البيض..","https://www.poetsgate.com/ViewPoem.aspx?id=213842",""],[5291,"بلادى البيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=14022",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5413,"وبي مالا يبوح الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=201608",""],[5837,"مصدر الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=192086",""]],"verses":[["لَها حارِسٌ ما يَبرَحُ الدَهرَ بَيتَها","إِذا ذُبِحَت صَلّى عَلَيها وَزَمزَما",0,"م",2,0],["لَها حافِرٌ مِثلُ قَعبِ الوَليدِ","رُكِّبَ فيهِ وَظيفٌ عَجِز",1,"ز",1,0],["لها حلىً أبهجها في النظر","خفرها قبل أوان الخفر",2,"ر",1,0],["لَها حَومَةُ العِزَّ الّتي لا يَرومُها","مُخيضٌ وَمِن عَيلانَ نَصرٌ مُؤَزَّرُ",3,"ر",1,0],["لَها حَجَلٌ قَد قَرَّعَت مِن رُؤوسِهِ","لَها فَوقَهُ مِمّا تَحَلَّبُ واشِلُ",4,"ل",1,0],["له أحاديثٌ تغني كلّ مجدبةٍ","عن الحياء وتجلي كلّ أحلاك",5,"ك",1,0],["لها حِرٌ واسعٌ لا شيءَ يُشبِعُهُ","كحوتِ يُونسَ مهما شاء يبتلعُ",6,"ع",1,0],["لها حِرٌ أشمط مستكرشٌ","شاب وما تترك إرضاعه",7,"ع",2,0],["لَها حَقٌّ وَلِلأَحبابِ حَقٌّ","رَشَفتُ وِصالَهُم فيها حَبابا",8,"ب",2,0],["لها حُرَقٌ لَوْ أَنَّ خَنْساءَ أَعْوَلَتْ","بِهِنَّ لأَدَّتْ حَقَّ صَخْرٍ إلى صَخْرِ",9,"ر",1,0],["لها حُمَاتٌ كأنَّها شَعَرٌ","تَظهَرُ مُسوَدَّةً وتَستَترُ",10,"ر",1,0],["لها حركاتٌ أودِعَتْ في سُكونِها","فما تَبِعَتْ في نقلهنّ يدٌ رِجلا",11,"ل",2,0],["لَها حُمرَةُ الياقوتِ في خَدِّ مخْجَلٍ","وَقَسوَته منها بِقَلبِ مُدَلّلِ",12,"ل",1,0],["لَها حُبٌّ تَنَشَّأَ في فُؤادي","فَلَيسَ لَهُ وَإِن زُجِرَ اِنتِهاءُ",13,"ا",2,0],["لَها حالانِ مِن طَعمٍ وَريحٍ","وَلَونٌ في الزُجاجَةِ كَالسَليطِ",14,"ط",1,0],["لَها حَجَلُ قُرعُ الرُّؤُوسِ تَحَدَّرَت","عَلى هامِها بالصَيفِ حَتّى تَمَوَّرا",15,"ر",2,0],["لَها حَجَلٌ قُرعُ الرؤوسِ تَحَلَّبَت","عَلى هامَةٍ بِالصيفِ حَتّى تَمَوَّرا",16,"ر",2,0],["لها حَلَقٌ ضَيْقٌ لو أنّ وَضِينَهُ","فُؤادُكَ لم يَخْطُرْ بقَلْبِكَ هاجِس",17,"س",1,0],["لها حِر أشمط متكرشٌ","شابَ وما تترك إرضاعه",18,"ع",2,0],["لَها حُضُرٌ كَيفَ الحَريقُ وَعَقبُها","كَجَمِّ الخَسيفِ بَعدَ مَعمَعَةِ الوَردِ",19,"د",1,0],["لَها حَبَبٌ كُلَّما صُفِّقَت","تَراها كَلَمعَةِ بَرقٍ يَماني",20,"ن",2,0],["لَهَا حُكْمُ لُقْمَانٍ وَصُورَةُ يُوُسفٍ","وَنَغْمَةُ دَاوُدٍ وَعِفَّةُ مَرْيَمِ",21,"م",1,1],["لَها حَدَقٌ مِنَ الذَهَبِ المُصَفّى","صِياغَةَ مَن يَدينُ لَهُ العِبادُ",22,"د",1,0],["لَها حُكمُ لُقمان وَصورَةُ يوسُف","وَمَنطِقُ داوود وَعِفَّةُ مَريَمِ",23,"م",1,0],["لها حر درته جرةٌ","مبعرٌ روثته صخره",24,"ر",2,0],["لها حر كأنه","وجه غلام خزري",25,"ر",2,0],["لها حقُّ سلطانٍ وحقُّ خلافةٍ","وما نوزِعَت إلا لنزغٍ وشرَّة",26,"ه",1,0],["لَها حالان بَيْنَ فَمٍ وَكَفٍّ","إِذَا وَافَتكَ رائِقَةَ السُّفُورِ",27,"ر",1,0],["لَها حنينٌ حَنينَ النيبِ تُفصَلُ عَن","فصلانِها فَهيَ صُعرٌ نَحوَها صورُ",28,"ر",1,0],["لَها حِبَبٌ يُرى الراووقَ مِنها","كَما أَدمَيتَ في القَروِ الغَزالا",29,"ل",2,0],["لَها حُلَلٌ شَتَّى وَلكِنْ طِرازُها","مِن الجامعِ المَعْمُورِ بِاللَّهِ وَاحِدُ",30,"د",1,0],["لَها حَافِرٌ يَحْفَى وَيُنعَلُ تَارَةً","وَقَدْ يَنْتهِي قُربْاً وَقَدْ يَنتهِى بُعْدا",31,"د",2,0],["لهَا حَبَبٌ يُنبِيكَ عَن طُولِ عُمرِها","ألستَ تَراها كيفَ شابَت قُرونُها",32,"ن",3,0],["لها حُجبٌ تقواك تقوَى بِحَجْبها","على حَجبها والحَجبُ في تلكُمِ الحُجب",33,"ب",1,0],["لها حُرْمةٌ عند الإله عظيمةٌ","ومقدارها عند الإلهِ مَبَجَّلُ",34,"ل",1,0],["لها حق على المشتاق منا","فأسرع يا هذيم لها الأداءا",35,"ا",3,0],["لها حنين إلى ليلى هوى وجوى","تظنها كلما حنت مفاريقا",36,"ق",2,0],["لها حُسْنُها لكن أريدك شافعاً","وخيرُ شفيعٍ لي إلى الجسم قلبُهُ",37,"ب",2,0],["لها حَبَبٌ يرفض عنها كأنَّه","عيونُ جرادٍ أو زواهرُ أنجم",38,"م",1,0],["لَها حَبَبٌ لَما أُريقَت كَأَنَّهُ","مِنَ الدُرِّ طَوقٌ لِلزُجاجَةِ أَو عِقدُ",39,"د",1,0],["لَها حُسنُ عَبّادٍ وَجِسمُ ابنِ واقِدٍ","وَريحُ أَبي حَفصٍ وَدينُ ابنِ نَوفَلِ",40,"ل",1,1],["لها حَبَبٌ علاها مِن لُجينٍ","وتحت شِباكهِ منها نُضارُ",41,"ر",1,0],["لها حجب يوم الوغى من مثارها","وأبوابها في السلم سهل حجابها",42,"ب",3,0],["له احتراس من الاعدا بلا رهب","محض النوال يلامن ولا سأم",43,"م",1,0],["لها حركات ثم يبدو سكونها","وتفني جميعاً والمحرك باقي",44,"ق",2,0],["لَهَا حَلاوةُ عَيشٍ غَيرُ دَائِمَةٍ","وفي العَوَاقِبِ مِنهَا المُرُّ والصَّبِرُ",45,"ر",1,0],["لَها حَنينٌ ولَنا شَهيقٌ","ما يَنقَضي إن ذُكِرَ العَقيقُ",46,"ق",1,1],["لها حبب ما طفا في الانا","ء حسبت النجوم طفت في الاناء",47,"ا",2,0],["لها حسنُ وجه ضاءَ بين عقودها","كبدرِ سماءٍ زُيّنت بالكواكب",48,"ب",1,0],["لها حركات للهوى تجذب النهى","كما يجذب الأهواء عصر الشبائب",48,"ب",1,0],["لها حبب كالعقد عند مزاجها","تطوف بها سمراء تبسم عن عقدِ",49,"د",1,0],["له أحاديث جود لا ارتياب بها","إحسانه الغمر في الآفاق يرويها",50,"ي",3,0],["لها حُرَّتا وحشيةٍ راع سمعها","أَنيسٌ فضمَّت بين سَمع مُؤَلَّلِ",51,"ل",1,0],["لها حق على وان تناءت","فاسرع يا هذيم لها الرحيلا",52,"ل",2,0],["لَها حائلٌ دونَ اللِقا مِن عشيرها","غيورٌ وَمِن كونِ التعفّف حائلُ",53,"ل",1,0],["لَها حُسنُ العَوارِضِ حينَ تَبدو","وَفيها لينُ أَعطافِ الغُلامِ",54,"م",1,0],["لَها حِقَبٌ لا تَستَطيعُ اِطِّراحَها","وَلَيسَ يَطيقُ سَلبَها مَن يَرومُها",55,"م",3,0],["لَها حِرٌ مُستَهدِفٌ كالقَعبِ","مُستَحصِفٌ نِعمَ قِرابُ",56,"ب",1,0],["لها حيب مثل الجمان كأنما","تساقط منثور الحباب من العقر",57,"ر",1,0],["لها حال كئيب من ذنوب","توالت والبعاد تعد مثواها",58,"ا",3,0],["لَها حَصْباءُ كَالكافورِ بُثَّتْ","عَلى تُرْبٍ خُلِقْنَ مِنَ الخَلوقِ",59,"ق",1,0],["لها حمةُ المجنون فارت دماؤه","وشهقةُ سكران ضعيف مهدّم",60,"م",1,0],["لَها حَركات مُعرب رفع لَحظِها","وَإِن كانَ مَبنيَّ الجُفون عَلى الكَسرِ",61,"ر",1,0],["لها حسبٌ في قومها ولصبّها","إذا ما بدا في حيها أيّ نسبة",62,"ه",1,0],["لها حواليك بأس","يدك شم الجبال",63,"ل",1,0],["لها حَديثٌ يُثيرُ الوَجدَ ماجِنُهُ","تُغريكَ رِقَّتُهُ بِالشُربِ وَالسَمَرِ",64,"ر",1,0],["لها حنين يهيج الشوق نغمته","صوت لغانيةٍ قد حركت وترا",65,"ر",2,0],["لها حاجب يوحي إلى القلب أنهُ","باسهم لحظيها الكحيلين يرشق",66,"ق",1,0],["لها حسب يابن الدنية في الورى","وملك كأملاك البرية حمير",67,"ر",1,0],["لَها حائِطانِ المَوتُ أَسفَلَ مِنهُما","وَجَمعٌ مَتى يُصرَخ بِيَثرِبَ يُصعِدِ",68,"د",