{"poems":[[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[102,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142060","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[85,"حبَّذا الساحة ُ والظلُ الظليلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9651&r=&rc=141",""],[209,"ملعب كان وأحلام الهوى","https://www.aldiwan.net/poem46285.html","الرمل"],[252,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[351,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[388,"إن الفتن فيها المحن من كل فن","https://www.aldiwan.net/poem54509.html","عموديه"],[475,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"]],"verses":[["ملعب الأيام إلا أنه","ليس حظ الجدّ منه بالقليل",0,"ل",1,0],["مَلعَبُ مَثَّلَ القَضاءُ عَلَيهِ","في صِبا الدَهرِ آيَةَ الصِدّيقِ",1,"ق",1,0],["ملعب لِلصبا وَقَد كانَ يوحي","كُلَّ يَوم مَهما أَفاضَ وَأَثنى",2,"ن",2,0],["مَلْعَبٌ تَسْرَحُ النَّوَاظِرُ مِنْهُ","بَيْنَ أَفْنانِ جَنَّةٍ وَشعابِ",3,"ب",1,0],["ملعب الأحلام ما","أحلاك حلوَ المبتسم",4,"م",1,0],["مَلَّ عُكّازُه من الضَّرْبِ في الأر","ضِ على خَيْبةٍ ورِقَّةِ حال",5,"ل",1,0],["ملعبُ الأيلمِ ، إلاَّ أنَّه","ليس حظُّ الجدِّ منه بالقليل",6,"ل",1,0],["ملعبٌ كان وأحلام الهوى","ترسل الأفراح فيما ترسلُ",7,"ل",1,1],["مَلَّ عقلي، لام قلبي","قلتُ: اهدأْ يارقيبُ",8,"ب",1,0],["مَلعَب الغيد لِلنُفوس بِذكراه","شَجنٌ صالَ في القُلوب وَجالا",9,"ل",2,0],["ملعون الرزايا والبلايا كلها","فيها هلاك الدين بالتعجيل",10,"ل",1,0],["ملعبُ حورٍ منذُ","بانوابانَ عنه رَصَدُه",11,"د",2,0]]}