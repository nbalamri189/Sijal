{"poems":[[87,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[87,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[104,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142060","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[87,"حبَّذا الساحة ُ والظلُ الظليلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9651&r=&rc=141",""],[215,"ملعب كان وأحلام الهوى","https://www.aldiwan.net/poem46285.html","الرمل"],[259,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[358,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[396,"إن الفتن فيها المحن من كل فن","https://www.aldiwan.net/poem54509.html","عموديه"],[482,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118429","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129832","الرمل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66460","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33503","الرمل"],[4814,"جُرعةُ اللّبن","https://www.poetsgate.com/ViewPoem.aspx?id=201763",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4578,"نيل السعادة من أحلى الماني","https://www.poetsgate.com/ViewPoem.aspx?id=49621",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[3271,"[2] هكذا قال النورج","https://www.poetsgate.com/ViewPoem.aspx?id=104130",""],[3271,"اللاجئون","https://www.poetsgate.com/ViewPoem.aspx?id=131014",""],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""],[6106,"سقوط العاهر : امريكا","https://www.poetsgate.com/ViewPoem.aspx?id=6848",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""]],"verses":[["ملعب الأيام إلا أنه","ليس حظ الجدّ منه بالقليل",0,"ل",1,0],["مَلعَبُ مَثَّلَ القَضاءُ عَلَيهِ","في صِبا الدَهرِ آيَةَ الصِدّيقِ",1,"ق",1,0],["ملعب لِلصبا وَقَد كانَ يوحي","كُلَّ يَوم مَهما أَفاضَ وَأَثنى",2,"ن",2,0],["مَلْعَبٌ تَسْرَحُ النَّوَاظِرُ مِنْهُ","بَيْنَ أَفْنانِ جَنَّةٍ وَشعابِ",3,"ب",1,0],["ملعب الأحلام ما","أحلاك حلوَ المبتسم",4,"م",1,0],["مَلَّ عُكّازُه من الضَّرْبِ في الأر","ضِ على خَيْبةٍ ورِقَّةِ حال",5,"ل",1,0],["ملعونة جعلتها الشام جنتها","من ذي الفقار وقد أشفت على الخطر",6,"ر",1,0],["ملعبُ الأيلمِ ، إلاَّ أنَّه","ليس حظُّ الجدِّ منه بالقليل",7,"ل",1,0],["ملعبٌ كان وأحلام الهوى","ترسل الأفراح فيما ترسلُ",8,"ل",1,1],["مَلَّ عقلي، لام قلبي","قلتُ: اهدأْ يارقيبُ",9,"ب",1,0],["مَلعَب الغيد لِلنُفوس بِذكراه","شَجنٌ صالَ في القُلوب وَجالا",10,"ل",2,0],["ملعون الرزايا والبلايا كلها","فيها هلاك الدين بالتعجيل",11,"ل",1,0],["ملعبُ حورٍ منذُ","بانوابانَ عنه رَصَدُه",12,"د",2,0],["مَلْعُونَةً آثارُهُ مُقَبَّحا","إِذا الحُقُوق احْتَضَرَتْه أَوْكَحا",13,"ح",2,0],["مِلعِبءِ يَوماً آضَ مَجزُولَ المَطَا","لا تَغتَرِر بِكُلِّ خبٍّ حَاسِدِ",14,"د",1,0],["ملع المطي ارتياحا ان نحتك تجد","بمنتهاه بلا حث ولا نغم",15,"م",1,0],["ملع الصفاوز جابتها قنابله","وسقن اسرى ملوك الارض كالنعم",15,"م",1,0],["ملعبٌ للهو مذ فارقته","ما ثناني نحو لهو ملعبُ",16,"ب",1,0],["ملعبٌ للشموسِ لولاهُ ما شعَّ ضيآءٌ","ولا تندّى لألآءُ",17,"ا",1,0],["مُلَعّس الثغر معسول الشفاه جلا","حسناً فأوسع أقمار الدجى وجلا",18,"ل",2,1],["ملَّ عمداً مظهراً لي مَللا","بجَفائي أو تسلّي فَسلا",19,"ل",2,1],["ملعونةٌ قد ساءَ منبتُها","مدسوسةُ البغضاءِ والضغنِ",20,"ن",1,0],["ملعون صير وعلّته بالملّه","حقّ(ن)علي لآجيه كالجاثومي",21,"م",2,0],["مل عن سواه ولا تعدل به أحدا","فمن يعادل خفاشاً ببازي",22,"ي",1,0],["ملعونةٌ تقتات من عرضها","قوت الصدى من أيّ مزمارِ",23,"ر",1,0],["ملعبٌ دنياهُ أعراسٌ ورقصٌ وغناءُ","هلّل الكوخ عليه وتناجى البؤساءُ",24,"ا",2,0],["ملعونةُ اللمس من مستهُ راحتها","عضَّتهُ أفعى سرى من نابها الخطرُ",25,"ر",1,0],["ملعب تعمره الروح فما","فيه إلا نحن والروح حضور",26,"ر",1,0],["ملعب ذو يبس آساد الشرى","والأفاعي لينات الملمس",27,"س",1,0],["ملعونك الأعلى يصرح أنه","يوحى إليه وقد أتته أوامر",28,"ر",1,0],["ملعب للجمال... يصبح غاباً","في الليالي... وحائطاً مسدودا",29,"د",2,0]]}