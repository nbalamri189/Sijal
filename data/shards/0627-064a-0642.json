ttps://www.aldiwan.net/poem48606.html","الطويل"],[523,"أبكي وأبكي بإسفار وإظلام","https://www.aldiwan.net/poem2030.html","البسيط"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[549,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[549,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[549,"قل لمشغوف بعذلي","https://www.aldiwan.net/poem47886.html","مجزوء الرمل"],[556,"نور هذا الوجود بالإيمان","https://www.aldiwan.net/poem33844.html","الخفيف"],[556,"إن قوما لم يروا","https://www.aldiwan.net/poem34263.html","مجزوء الرمل"],[556,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[565,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[573,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[573,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"],[573,"لام العذول على هواك وفندا","https://www.aldiwan.net/poem2960.html","الكامل"]],"verses":[["أَيقَظنَ مِنّي مُهَنَّداً ذَكَراً","إِلى المَعالي وَسائِقاً أَرِنا",0,"ن",2,0],["أَيقَظتُ عَنُه صاحِباً","يَنجابُ عُلوِيَّ السَنا",1,"ن",2,0],["أَيَقْتَادُني نَحْوَ الدَّنِيَّةِ مَطْمَعٌ","عَلَيَّ إِذاً إِنْ لَمْ أَذَرْهُ عَفَاءُ",2,"ا",2,0],["أيْقَظْتَ لمّا نِمْتَ ساكِنَ زَفْرَتي","وحرَمْتَ أجْفانِي لَذيذَ هُجوعِ",3,"ع",1,0],["أيقَنْتُ لَمّا أَنْ مَثَلْتُ بِباَبِهِ","أَنَّ النُّجُومَ تَشَوَّفَتْ لِمَكاَنِي",4,"ن",2,0],["أَيَقتُلُني ظَمايَ وَأَنتَ جاري","وَكَيفَ يَبيتُ جارُ البَحرِ ظامي",5,"ي",1,0],["أَيَقتُلُني وَالمَشرَفِيُّ مُضاجِعي","وَمَسنونَةٌ زُرقٌ كَأَنيابِ أَغوالِ",6,"ل",1,0],["أَيَقتُلَني وَقَد شَغَفتُ فُؤادَه","كَما شَغَفَ المَهنوءَةَ الرَجُلُ الطالي",6,"ل",2,0],["أي قسط أوليتموني منه","هو فضل على قليلي كثير",7,"ر",1,0],["أَيْقَظْتُهَا وَظَلِلْتَ بَعْدَ نُهُوضِهَا","عُنْوَانَ عِزَّتِهَا وَرمْزَ جَلالِهَا",8,"ل",3,0],["أيُّ قَوْمٍ هَانَ النِّسَاءُ عَلَيْهِمْ","وَنَجَوْا فِي بِلاَدِهِمْ من هُونِ",9,"ن",1,0],["أَيْقَنْتُ حِينَ رَأَيْتُ مَا أَبْلَيْتَهُ","فِي الذَّوْدِ عَنْهَا أَنَّكَ الضِّرْغَامُ",10,"م",1,0],["أَيُقْبِلُ يَوْمٌ تَنْتَفِي مِنْ نُفُوسِنَا","ضَغَائِنُ تَخْبُو حِقْبَةً ثُمَّ تُضْرَمُ",11,"م",1,0],["أَيُقْتَلُ آمِنٌ وَيُقَالُ رَفِّهْ","عَلَيْكَ فَمَا حِمَامُكَ بِالحِمَامِ",12,"م",1,0],["أَيقَظتَ أَجفاناً وَكُنتَ لَها كَرىً","وَأَنَمتَ عَيناً لَم تَكُن بِكَ تَهجَعُ",13,"ع",1,0],["أيُّ قوسٍ ذي جمالٍ","سهمه سهم السعادَهْ",14,"د",2,1],["أيقتدر الشعر أن يشكرا","كما يجب الشكر ذاك البطل",15,"ل",1,0],["أيقظتنا بها إلى أن في النو","م ارتياحاً لنا وأيّ ارتياح",16,"ح",1,0],["أَيُقيمُ أَهلُكَ بِالسِتارِ وَأَصعَدَت","بَينَ الوَريقَةِ وَالمَقادِ حُمولُ",17,"ل",1,0],["أيّ قلبٍ لم يرمَ بعد سراهُ","بفنون الأوجاع والأوجال",18,"ل",1,0],["أيُّ قرْنٍ باد منهم لم يكن","حَقَّهُ لو أنصفَ الدهرُ البُيُودُ",19,"د",1,0],["أيقنت إذ وامضتني منك بارقة","أني بسيبك مربوع ومخروف",20,"ف",1,0],["أيقتُلُني من ليس لي منه ناصرٌ","سواه وأعواني عليه مكارِمُهْ",21,"ه",1,1],["أيقود قحطبةُ الجيوشَ مُسوَّماً","بالخافقين كحُوَّم العِقبان",22,"ن",1,0],["أَيقَظتَ في الأَنفُسِ الأَماني","وَالاِبتِساماتِ في الثُغورِ",23,"ر",1,0],["أَيقَنتُ أَنَّكِ جَنَّةٌ خَلّابَةٌ","فَحَنَنتُ مِن بَعدِ المَشيبِ إِلَيكِ",24,"ك",1,0],["أَيقِظ شُعورَكَ بِالمَحَبَّةِ إِن غَفا","لَولا الشُعورُ الناسُ كانوا كَالدُمى",25,"م",2,0],["أيقظوا فيهِ نزْعَةَ الشَّرِّ فانْقَضَّ","على النَّاسِ فاتكاً جبَّارا",26,"ا",1,0],["أيَّ قدس يضُمَ هذا البناء","حسدت أرضه عليه السماء",27,"ا",2,1],["أيقنت أن الخلق ضلوا ربهم","يا رب لا تأخذهم بعذاب",28,"ب",1,0],["أيقنت أن منى العشاق ما جُمعت","إلا إلى مثل خيط العنكب الفاني",29,"ي",1,0],["أَيَقولُ واشٍ أَو يُرَدِّدُ شامِتٌ","صِنديدُ بُرقَةَ موثَقٌ مَكبولُ",30,"ل",1,0],["أَيَقولونَ سَكرَةٌ لَن تَجَلّى","وَقُعودٌ مَعَ الهَوى وَقِيامُ",31,"م",1,0],["أَيقَنتَ أَنَّ الجَهلَ عِل","لَةُ كُلِّ مُجتَمَعٍ سَقيمِ",32,"م",1,0],["أَيُقالُ فِتيانُ الحِمى بِكِ قَصَّروا","أَم ضَيَّعوا الحُرُماتِ أَم خانوكِ",33,"ك",1,0],["أَيَقدَحُ في الخَيمَةِ العُذَّلُ","وَتَشمَلُ مَن دَهرَها يَشمَلُ",34,"ل",1,1],["أَيقَنتُ أَنَّ سَعيداً طالِبٌ بِدَمي","لَمّا بَصُرتُ بِهِ بِالرُمحِ مُعتَقِلا",35,"ل",2,0],["أَيَقتَصُّ مِنّي آخِرُ الدَهرِ ظالِماً","جَرائِرَ أَجدادي عَلى أَوَّلِ الدَهرِ",36,"ر",1,0],["أَيُّ قَضيبٍ عَلى كَثيبِ نَقا","أَحسَنُ مِن خَصرِهِ عَلى كَفَلِه",37,"ه",1,0],["أَيقَظتُموهُ وَنِمتُمُ عَن صَولَةٍ","طَحَنَت مَناكِبَ يَذبُلٍ وَشَمامِ",38,"م",1,0],["أَيُقتَلُ مَخضوبُ البَنانِ مُبَرقَعٌ","بِمَيتٍ خُفاتاً لَم تُصِبهُ كِلامُها",39,"م",3,0],["أَيُّ قَوافٍ يَعزُّ مُونِقُها","فيَستَرِقَّ القُلوبَ رَيِّقُها",40,"ق",3,1],["أَيقرُبُ منك ذو نَسَبٍ بعيدٍ","ويبعُدُ مَنْ له نَسَبٌ قريبُ",41,"ب",1,0],["أَيقَنتُ أَنَّ المُستَحيلَ ثَلاثَةٌ","الغولُ وَالعَنقاءُ وَالخِلُّ الوَفي",42,"ي",1,0],["أَيقَنتُ أَن لَستَ إِنساناً لِفِعلِكَ ذا","لِقَولِهِ خُلِقَ الإِنسانُ مِن عَجَلِ",43,"ل",1,0],["أيقول دهري إن ما يبسا","هيهات يرجع عوده الرطب",44,"ب",1,0],["أَيقَنتُ حينَ نَتَفتَ أَن سَتُكابِرُ","وَعَلِمتُ إِذ بادَلتَ أَن سَتُؤاجِرُ",45,"ر",1,1],["أَيقَظتَ لِلكَرَمِ الكِرامَ بِناطِقٍ","لِنَداكَ أَظهَرَ كَنزَ كُلِّ قَديمِ",46,"م",1,0],["أَيقَظتَ هاجِعَهُم وَهَل يُغنيهُم","سَهَرُ النَواظِرِ وَالعُقولِ نِيامُ",47,"م",1,0],["أَيقَنتَ أَنَّ مِنَ السَماحِ شَجاعَةً","تُدمي وَأَنَّ مِنَ الشَجاعَةِ جودا",48,"د",2,0],["أيقطعُ طرفُكِ المسنو","نُ قلبي وهُوَ قَدْ وجبا",49,"ب",2,0],["أيقيمُ حيثُ يضامُ إلاّ جاهلٌ","قدْ عادلَ الأشرارَ بالأخيارِ",50,"ر",1,0],["أيُّ قلبٍ بهِ ولوْ كان صخراً","ما يحاكي الخنساءَ نوحاً وحزنا",51,"ن",2,0],["أيقولُ النّاسُ مَنّاعُ الحِمَى","ضنَّ بالنّفسِ عليه فاحتَمى",52,"م",2,0],["أيقنتُ أنّ اللهَ غَيَّرَ ما بنا","وأَرادَ أمراً بالبلادِ كُبارا",53,"ر",2,0],["أَيقَنتَ أَنَّ مِنَ الشُعوبِ أَجِنَّةً","وَعَلِمتَ أَنَّ مِنَ البِلادِ طُلولا",54,"ل",2,0],["أَيُقضى عَلَينا قَضاءَ العَبيدِ","وَنُؤخَذُ بِالخَسفِ أَخذَ الحُمُرْ",55,"ر",1,0],["أَيَقودُ جَيشَكَ أَم يَقودُ عُيَينَةٌ","شُمَّ الفَوارِسِ مِن بَني غَطفانِ",56,"ن",1,0],["أَيُقدَرُ لِلمَمالِكِ ما تَمَنّى","وَقَد عَلِقَت بَني الدُنيا عَلوقُ",57,"ق",1,0],["أَيقولُ تِلكَ فَلا تَميدُ بِأَهلِها","باريسُ مِن فَزَعٍ وَيَهوي المُتحَفُ",58,"ف",1,0],["أيْقِظْ هِرَقْلَ فقد تطاولَ نَومُهُ","وأبَتْ عَمايتُه فما تَتَكشَّفُ",59,"ف",1,0],["أيْقِظهُ إنّ اللهَ ليس كَدِينهِ","دِينٌ وليس له شَريكٌ يُعرَفُ",59,"ف",1,0],["أيُقيمُ بالوادي الجديبِ فلا يرى","إلا سَراباً كاذباً وجَهاما",60,"م",2,0],["أيقظت عائشةً من نومها","مثلما يُوقِظُها صوتُ الأذينْ",61,"ن",1,0],["أيقَنتُ أنَّك قَاتِلِي ومُعَذّبِي","ولِكُلّ نَاوٍ فِي الحَقِيقَة مَا نوَآ",62,"و",2,0],["أَيَقبَلُ شَوقي سَلوَةً عَن مُقَبَّلٍ","يَسومُ خِتامَ الصَبرِ خاتَمُهُ فَضّا",63,"ض",2,0],["أَيقَظ اللوعةَ فيها وَالأَسى","وَغَفا بَينَهما لَم يَحفلِ",64,"ل",1,0],["أْيقِظ صلاحَ الدين رَب","ب التَّاج والسَّيف اليماني",65,"ن",2,0],["أَيَقُلنَ لا تَبعَد فَرُبَّ كَريهَةٍ","فَرَّجتُها بِشَجاعَةٍ وَسَماحِ",66,"ح",1,0],["أَيَقتُلُ كُلَّ مُشتاقٍ هَواهُ","كَما حُدِّثتُ عَن يَومِ الرَحيلِ",67,"ل",1,0],["أَيقَنوا مِنهُ بِحَربٍ عَوانٍ","وَرِجالٍ يَخضِبونَ الرِماحا",68,"ح",2,0],["أَيقَنتَ مِن قَبلِ النُهى أَنَّ السُهى","ساهٍ يُضاحِكُ جارَهُ وَيُهازِلُ",69,"ل",1,0],["أيْقنْتُ أنّ حِبالَ الشمسِ تُدرِكُني","لمّا بَصُرْتُ بخَيْطِ المَشرِقِ اليَقَقِ",70,"ق",1,0],["أَيقظَ طَرفي إِذْ بَدا مِن نَعْسهِ","مَنْ طَرْفُهُ ناعِسٌ مُسْتَيْقِظُ",71,"ظ",1,0],["أَيَقْتُلُني دائي وَأَنتَ طَبيبي","قَريبٌ وَهلْ منْ لا يُرى بقَريبِ",72,"ب",1,1],["أيّ قوم نالوا نجاة من الأس","ر بغير اقتحام أمر جسام",73,"م",1,0],["أيُّ قيثارٍ شجيٍّ غرِدِ","خلتُهُ ينطق عن أسرار قلبي",74,"ي",1,0],["أيُّ قصرٍ باذخٍ في قمّةٍ","تحسَبُ الأنجمَ من بعض ذُراها",75,"ا",3,0],["أيقظي فيه من فتونٍ وسحرٍ","ذكرياتٍ من الشبابِ الغريرِ",76,"ر",1,0],["أيقظوا في الليلِ ثاراتِ الرعودْ","إنَّها ثاراتُ جبّارِ السماءْ",77,"ا",2,0],["أَيْقَنَ أَنَّ الهِلالَ راكِبُهُ","فضاءَ للحاضِرِينَ واتَّسَعَا",78,"ع",2,0],["أَيْقَنْتُ من أَخْذِي له","وتَلَوْتُ مِن سُورِ العزائِمْ",79,"م",1,0],["أَيُّ قَومي إذا عَزَّتِ الخَم","رُ وقامَت رفِاقُهُم بالحِقَاق",80,"ق",1,1],["أَيَقْتُلُنِي الْهَوَى ظُلْماً","وَمَا فِي النَّاسِ لِي خَلَفُ",81,"ف",1,0],["أَيَّ قِنَاعٍ مِنْ شَباَبٍ سَرَا","وَأَيَّ ثَوْبٍ مِنْ نَعِيمٍ نَضَا",82,"ض",2,0],["أَيُّ قَلْبٍ عَلَى صُدُودِكَ يَبْقَى","أَوَ لَمْ يَكْفِ أَنَّنِي ذُبْتُ عِشْقَا",83,"ق",2,1],["أَيْقَظُوهَا مِنَ الرُّقَاد وَقَدْ جَا","زَ مَدَاهُ أَقْصَى مَدى لِلرُّقَادِ",84,"د",1,0],["أَيُقِرُّ هِمَّتُكَ البَعِيدَهْ","أَنْ تَبْلُغَ الدُّنْيَا الجَدِيدَهْ",85,"د",2,1],["أَيَقتُلَني وَقَد شَغَفتُ فُؤادَها","كَما شَغَفَ المَهنوءَةَ الرَجُلُ الطالي",86,"ل",2,0],["أيقالُ: شعبٌ عضَّ كفًا حرَّرَتْ","بالأمس هذا الشَّعْبَ من أغلالِهِ؟",87,"ل",2,0],["أيقالُ: أردى النيلُ مُنقذَهُ الذي","بَعَثَ الحياةَ تدِبُّ في أوصالِهِ؟",87,"ل",2,0],["أيقالُ: غالَ النيلُ ليثًا صانه","وحمى حماه، وذاد عن أشبالِهِ؟",87,"ل",2,0],["أيقال: أبطالُ الحمى","وضعوا المطالب في العياب؟",88,"ب",1,0],["أيقنت لما أن مثلت ببابه","أن النجوم تشوفت لمكان",89,"ن",1,0],["ايقن أن الهلال زاكنه","فضاء للحاضرين واتسعا",90,"ع",2,0],["أيقدر أن يُري التاريخ سعياً","متى نمرُرْ عليه نقلْ أجادا",91,"د",2,0],["أيقتص مني آخر الدهر ظالما","جزائر أجدادي على أول الدهر؟",92,"ر",1,0],["أيقتُلُني من ليس لي منه ناصرٌ","عليه وأعواني عليه مكارِمُهْ",93,"ه",1,1],["أيقنتُ إذا وامضتْني منك بارقة ٌ","أني بسيبك مربوعٌ ومخروفُ",94,"ف",1,0],["أيقضي علينا قضاء العبيد","ويؤخذ بالخسف أخذ الحمر",95,"ر",1,0],["أيقنتُ أنْ سيكونُ عند لقائهمْ","ضرْبٌ يُطيرُ عن الفِراخِ الجُثّمَ",96,"م",1,0],["أيقظني فيه من فتون وسحر","ذكريات من الشّباب الغرير",97,"ر",1,0],["أيقاس ما غَرس العُلا","يَوماً بِخَضراءِ الدمن",98,"ن",1,0],["أَيَقصد مِن أُسرَتِهِ سُيوف","طبعن لِضَرب أَعناق الرِجال",99,"ل",1,0],["أيقوم في دست الخطابة الكن","وتصد عنه ايمة التبيان",100,"ن",1,0],["أي قضاء قد مضى غلابا","وأي خطبٍ قد رمى فصابا",101,"ب",2,0],["أيقنت أن الأَلمعية في","ازدراء الألمعية",102,"ي",2,0],["أيقنتُ أنّك ساعدِي ومساعدي","يا ابنَ الذي قد عمَّنى إحسانُه",103,"ن",2,0],["أيقنتُ أن ابن سلطانَ الإمام لنا","بحرٌ طمَا ولأهل الأرض أَنواءُ",104,"ا",2,0],["أَيقَنَ يَومَ اِصطَفاكَ مُنتَجِباً","أَنَّكَ لِاِبنِ اِبنِهِ غَداً عَضُدُ",105,"د",1,0],["أَيقظ فؤادَكَ من نومِ ومن سنة","واحذر فذو الحَزمِ من أوصافِهِ الحذر",106,"ر",1,0],["أيقظ القلب اللجوج فقد","أثّرت فيه يد المحنِ",107,"ن",1,0],["أَيْقَظْتُ فِيها كُلَّ وَجْدٍ هَاجِعٍ","بِيَدِ السُّهادِ وَمَا أَرَدْتُ مُعِينا",108,"ن",2,0],["أيقنت أن دوائي قد ظفرت به","وأن دائي بحمد الله منحسم",109,"م",1,0],["أيقنتُ أنَّ الدهرَ يسلبُ ما كسا","ظلماً ويظهرُ للسُّرورِ عَوائقا",110,"ق",2,0],["أَيُقْضَي لنفسٍ غالَها الشوقُ حاجةٌ","ويسمحُ دهرٌ بالوصال ضَنين",111,"ن",1,0],["أيُّ قَومٍ أَبناءُ قيلةَ لا الأق","يالُ تَحكيهم ولا الأذواءُ",112,"ا",2,0],["أَيقعُدُ العجزُ بي عن خَوْضِ مُظلِمةٍ","ومَقعَدُ الكُرماءِ السَّرْجُ والكُور",113,"ر",1,0],["أَيقَنتِ أَنَّ بَني فَهرٍ وَإِخوَتَهُم","كانوا لَدى القاعِ يَومَ الرَوعِ فُرسانا",114,"ن",2,0],["أَيقَنتُ أَنّي مُقيمٌ في دِيارِهِمُ","حَتّى يُفارِقَ ما في جَوفِهِ الحَدَقُ",115,"ق",1,0],["أيُقاس قَدُّك يا أبا العبّاسِ","بقضيب آسٍ ليس ذا بقياسِ",116,"س",1,1],["أيقظ جفونك من فتور نعاسها","فالشمس قد نزعت لنا من كاسها",117,"س",3,1],["أيّ قبر حواك يا صنو قلبي","كل روح لطيب روحك لحد",118,"د",1,0],["أيقنت أن عذابها عَذْبٌ ولو","في حُبِّها قِطَعاً أباعُ وأشترى",119,"ر",2,0],["أَيُّ قَلبٍ أَشَدَّ مِن قَلبِ أُختٍ","في أَشَدِّ الآلامِ ظلَّ صَبورا",120,"ر",2,0],["أي قلبٍ كوى الفِراق وهزّهْ","أيّ لبٍّ أَطاره واستفزّه",121,"ز",2,1],["أَيُقيمُ في أوطانه مُتَأَدِّبٌ","ما خلفَهُ مالٌ ولا قُدَّامهُ",122,"م",2,0],["أيُّ قربٍ، أيُّ وَصْلٍ","فهْوَ بالأمر المريحِ",123,"ح",1,0],["أيقظَ الطرف والأنامُ نيامٌ","من يقيسُ الرقود بالأيقاظِ",124,"ظ",1,0],["أيُقيمُ لَيْسَ يَريمُ بَيْنَ إضَافَةٍ","عَالَتْ فَريضَتُها وَبَيْنَ عِيَالِ",125,"ل",1,0],["أيَقْصُر عنْ فَتْح المشارِق بعْدَما","تَقاضى بِأَمْرِ اللّهِ فَتْح المَغارِبِ",126,"ب",1,0],["أَيُقيم قَلبي في حَشايَ وَقَد","عَبَثَت بِحَبَّتِهِ يَدُ الحُبِّ",127,"ب",1,0],["أيقنتُ أنك قد هدرت دمي","بل سرعت عامدة إلى قتلي",128,"ي",1,0],["أَيُّ قَلبٍ ما هامَ فيك ولكن","زادَ قَلبي بحبِّك اِستِهتارا",129,"ر",2,0],["أَيقظتْ عاطفةً وَثابةً","وَرمتْ جفناً وَجسماً بالفتورِ",130,"ر",1,0],["أَيقَظتُ أَزمَلُها فَاِستَوى","مُصَعصَعُ الرَأسِ شَخيتٌ قَفِر",131,"ر",1,0],["أيقظته من كراه بعد ما رمدت","عيناه لا مسه من بعدها ألم",132,"م",1,1],["أَيقرُّ جفنٌ ناعسٌ بمنامِ","وَالكفرُ يرتعُ في حِمى الإسلامِ",133,"م",1,1],["أيّ قلبٍ لم يَصدهُ مُرغماً","كاسرُ الجفنِ الفتور النعسِ",134,"س",1,0],["أَيقنتُ أنّي مُدركٌ أملي وإن","عهدَ الورى جرح الزمان جبارا",135,"ر",2,0],["أيّ قلبينِ في الصبابةِ قلبا","نا ومن أيّ عالمٍ قدسيّ",136,"ي",1,0],["أَيقَنت أَن لا شَيء إِلّا لِلفنا","حَتّى الفَنا يَفنى وَلِلّه البقا",137,"ا",1,0],["أَيُقصَدُ نَقْلُ إدراري بظُلْمٍ","وظُلمُ النّاسِ مَرتَعُه وَبيّ",138,"ي",1,0],["أَيَقتَضى عَدلُ مَولانا عَلى مَلَكٍ","يَرمي الشَياطينَ يُرمى مِنهُ بِالشُهُبِ",139,"ب",1,0],["أَيقَظتَ مِن سِنَةِ الإِياسِ مَطامِعي","فَلِذا يُشَكِّكُ شُكرِيَ اليَقظانُ",140,"ن",1,0],["أَيَقطَعُ حَدُّ السَيفِ وَالسَيفُ مُغمَدٌ","وَيَفرُسُ نابُ اللَيثِ وَاللَيثُ بَربُضُ",141,"ض",1,0],["أَيقَنت أَن ذَوي المروَّة كُلَهُم","في غُربة فَبَكيت لِلغَرباء",142,"ا",2,0],["أيقيسكَ البحرُ الخِضمّ ولِلْورى","من كلّ أنملةٍ بكفّكَ أبْحِرُ",143,"ر",1,0],["أيُقاسَ بي ظُلماً من الكُتبِ","الجديدةِ ما عَداني",144,"ي",1,0],["أيقنت أنك محسن وموفق","وكذا للإِنصاف أنت إمام",145,"م",1,0],["أيقسم أموال الرعايا تجارياً","وأنت بمرأى كل طاغ وظالم",146,"م",1,0],["أيقظتم ذهني بذكر فوائد","أضحى بها طرف الذكا مكحولا",147,"ل",2,0],["أيُّ قلبٍ عذَّبته بصدودٍ","ودُنُوٍّ نَغَّصَتْهُ ببعاد",148,"د",1,0],["أيقَنْتَ أنَّ وجوده لوجودنا","كالماء يَنْقَعُ غلَّةَ الظَّمآن",149,"ن",1,0],["أيّ قلب قلبي وقد صار في حك","م يديه لقد عرفت مآله",150,"ل",2,0],["أيقطعنا في حبّه من نواصلُه","ويطنب في عذل عليه عواذلُه",151,"ل",2,1],["أَيْقَنُوا بالحِمامِ لما رَأَوْهُ","مُقْبِلاً نحوَهُمْ وسِيئَتْ وُجُوهُ",152,"و",2,0],["ايقنت ان الشرح ليس","يفي ولست عليه قادر",153,"ر",1,0],["أيُّ قلبٍ يبقى على الحبِّ أيُّ","طَرْفُ مَنْ قَدْ هَويتُهُ بابليُّ",154,"ي",1,1],["أيقال إنكمو محط حماية","لهوانكم فمن الذي أدناكمو",155,"م",2,0],["أيقالُ أنتم خاذلوهم بعدَما","أنسوا إليكم صادقين وأسلموا",156,"م",3,0],["أيقالث قد أخَذ البرئُ بظلكِّم","ظُلماً بما صنعَ الخبيثُ المجرمُ",156,"م",1,0],["ايقامر المتسامحون بفكرهم","ان جاز أن يهب الثراءَ مقامر",157,"ر",1,0],["أيقظَني للبرقِ وهو نائمُ","جهالةً والعربيُّ حازمُ",158,"م",1,1],["أيقظَ منك الصِّلَّ ثمّ هوَّمتْ","عيناه يستجدي عُلالات الحُلُمْ",159,"م",1,0]