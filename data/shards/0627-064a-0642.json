,1],["أيّ قوم نالوا نجاة من الأس","ر بغير اقتحام أمر جسام",73,"م",1,0],["أيُّ قيثارٍ شجيٍّ غرِدِ","خلتُهُ ينطق عن أسرار قلبي",74,"ي",1,0],["أيُّ قصرٍ باذخٍ في قمّةٍ","تحسَبُ الأنجمَ من بعض ذُراها",75,"ا",3,0],["أيقظي فيه من فتونٍ وسحرٍ","ذكرياتٍ من الشبابِ الغريرِ",76,"ر",1,0],["أيقظوا في الليلِ ثاراتِ الرعودْ","إنَّها ثاراتُ جبّارِ السماءْ",77,"ا",2,0],["أَيْقَنَ أَنَّ الهِلالَ راكِبُهُ","فضاءَ للحاضِرِينَ واتَّسَعَا",78,"ع",2,0],["أَيْقَنْتُ من أَخْذِي له","وتَلَوْتُ مِن سُورِ العزائِمْ",79,"م",1,0],["أَيُّ قَومي إذا عَزَّتِ الخَم","رُ وقامَت رفِاقُهُم بالحِقَاق",80,"ق",1,1],["أَيَقْتُلُنِي الْهَوَى ظُلْماً","وَمَا فِي النَّاسِ لِي خَلَفُ",81,"ف",1,0],["أَيَّ قِنَاعٍ مِنْ شَباَبٍ سَرَا","وَأَيَّ ثَوْبٍ مِنْ نَعِيمٍ نَضَا",82,"ض",2,0],["أَيُّ قَلْبٍ عَلَى صُدُودِكَ يَبْقَى","أَوَ لَمْ يَكْفِ أَنَّنِي ذُبْتُ عِشْقَا",83,"ق",2,1],["أَيْقَظُوهَا مِنَ الرُّقَاد وَقَدْ جَا","زَ مَدَاهُ أَقْصَى مَدى لِلرُّقَادِ",84,"د",1,0],["أَيُقِرُّ هِمَّتُكَ البَعِيدَهْ","أَنْ تَبْلُغَ الدُّنْيَا الجَدِيدَهْ",85,"د",2,1],["أَيَقتُلَني وَقَد شَغَفتُ فُؤادَها","كَما شَغَفَ المَهنوءَةَ الرَجُلُ الطالي",86,"ل",2,0],["أيقالُ: شعبٌ عضَّ كفًا حرَّرَتْ","بالأمس هذا الشَّعْبَ من أغلالِهِ؟",87,"ل",2,0],["أيقالُ: أردى النيلُ مُنقذَهُ الذي","بَعَثَ الحياةَ تدِبُّ في أوصالِهِ؟",87,"ل",2,0],["أيقالُ: غالَ النيلُ ليثًا صانه","وحمى حماه، وذاد عن أشبالِهِ؟",87,"ل",2,0],["أيقال: أبطالُ الحمى","وضعوا المطالب في العياب؟",88,"ب",1,0],["أيقنت لما أن مثلت ببابه","أن النجوم تشوفت لمكان",89,"ن",1,0],["ايقن أن الهلال زاكنه","فضاء للحاضرين واتسعا",90,"ع",2,0],["أيقدر أن يُري التاريخ سعياً","متى نمرُرْ عليه نقلْ أجادا",91,"د",2,0],["أيقتص مني آخر الدهر ظالما","جزائر أجدادي على أول الدهر؟",92,"ر",1,0],["أيقتُلُني من ليس لي منه ناصرٌ","عليه وأعواني عليه مكارِمُهْ",93,"ه",1,1],["أيقنتُ إذا وامضتْني منك بارقة ٌ","أني بسيبك مربوعٌ ومخروفُ",94,"ف",1,0],["أيقضي علينا قضاء العبيد","ويؤخذ بالخسف أخذ الحمر",95,"ر",1,0],["أيقنتُ أنْ سيكونُ عند لقائهمْ","ضرْبٌ يُطيرُ عن الفِراخِ الجُثّمَ",96,"م",1,0],["أيقظني فيه من فتون و