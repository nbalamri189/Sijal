أتيت ببدعة فينا","https://www.aldiwan.net/poem28686.html","مجزوء الوافر"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[69,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"لما رأيتك والقلوب خوافق","https://www.aldiwan.net/poem42075.html","الكامل"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[105,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[81,"والنجم في خد الحبيب إذا هوى","https://www.aldiwan.net/poem61297.html","الكامل"],[81,"طمحت بأجفاني فأنسيتها الغمضا","https://www.aldiwan.net/poem61467.html","الطويل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[17,"إن امرأً أمن الحوادث جاهل","https://www.aldiwan.net/poem1197.html",""],[52,"ألم تحزن على الربع المحيل","https://www.aldiwan.net/poem26756.html","الوافر"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[46,"أجمل فعالك إن وليت ولا تجر","https://www.aldiwan.net/poem23145.html","الكامل"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[76,"يا ساحرا طرفه إذ يلحظ","https://www.aldiwan.net/poem39275.html","مجزوء البسيط"],[76,"أيقتلني دائي وأنت طبيبي","https://www.aldiwan.net/poem39483.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30471","المنسرح"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21077","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42703","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42669","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42709","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[84,"شكرت للدهر حسن ما صنعا","https://www.poetsgate.com/ViewPoem.aspx?id=26332",""],[90,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[45,"لدن هجرته زحزحته عن الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=31219",""],[51,"أيقتُلُني من ليس لي منه ناصرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30438",""],[51,"لا زلتَ غوثاً إذا ناداك ملهوفُ","https://www.poetsgate.com/ViewPoem.aspx?id=29592",""],[105,"تغلغل في القلب حتى وقر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54985&r=&rc=155",""],[3,"وتظلُّ عبْلة ُ في الخدور تجُرُّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10748&r=&rc=102",""],[96,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""]],"verses":[["أَيقَظنَ مِنّي مُهَنَّداً ذَكَراً","إِلى المَعالي وَسائِقاً أَرِنا",0,"ن",2,0],["أَيقَظتُ عَنُه صاحِباً","يَنجابُ عُلوِيَّ السَنا",1,"ن",2,0],["أَيَقْتَادُني نَحْوَ الدَّنِيَّةِ مَطْمَعٌ","عَلَيَّ إِذاً إِنْ لَمْ أَذَرْهُ عَفَاءُ",2,"ا",2,0],["أيْقَظْتَ لمّا نِمْتَ ساكِنَ زَفْرَتي","وحرَمْتَ أجْفانِي لَذيذَ هُجوعِ",3,"ع",1,0],["أيقَنْتُ لَمّا أَنْ مَثَلْتُ بِباَبِهِ","أَنَّ النُّجُومَ تَشَوَّفَتْ لِمَكاَنِي",4,"ن",2,0],["أَيَقتُلُني ظَمايَ وَأَنتَ جاري","وَكَيفَ يَبيتُ جارُ البَحرِ ظامي",5,"ي",1,0],["أَيَقتُلُني وَالمَشرَفِيُّ مُضاجِعي","وَمَسنونَةٌ زُرقٌ كَأَنيابِ أَغوالِ",6,"ل",1,0],["أَيَقتُلَني وَقَد شَغَفتُ فُؤادَه","كَما شَغَفَ المَهنوءَةَ الرَجُلُ الطالي",6,"ل",2,0],["أي قسط أوليتموني منه","هو فضل على قليلي كثير",7,"ر",1,0],["أَيْقَظْتُهَا وَظَلِلْتَ بَعْدَ نُهُوضِهَا","عُنْوَانَ عِزَّتِهَا وَرمْزَ جَلالِهَا",8,"ل",3,0],["أيُّ قَوْمٍ هَانَ النِّسَاءُ عَلَيْهِمْ","وَنَجَوْا فِي بِلاَدِهِمْ من هُونِ",9,"ن",1,0],["أَيْقَنْتُ حِينَ رَأَيْتُ مَا أَبْلَيْتَهُ","فِي الذَّوْدِ عَنْهَا أَنَّكَ الضِّرْغَامُ",10,"م",1,0],["أَيُقْبِلُ يَوْمٌ تَنْتَفِي مِنْ نُفُوسِنَا","ضَغَائِنُ تَخْبُو حِقْبَةً ثُمَّ تُضْرَمُ",11,"م",1,0],["أَيُقْتَلُ آمِنٌ وَيُقَالُ رَفِّهْ","عَلَيْكَ فَمَا حِمَامُكَ بِالحِمَامِ",12,"م",1,0],["أَيقَظتَ أَجفاناً وَكُنتَ لَها كَرىً","وَأَنَمتَ عَيناً لَم تَكُن بِكَ تَهجَعُ",13,"ع",1,0],["أيُّ قوسٍ ذي جمالٍ","سهمه سهم السعادَهْ",14,"د",2,1],["أيقتدر الشعر أن يشكرا","كما يجب الشكر ذاك البطل",15,"ل",1,0],["أيقظتنا بها إلى أن في النو","م ارتياحاً لنا وأيّ ارتياح",16,"ح",1,0],["أَيُقيمُ أَهلُكَ بِالسِتارِ وَأَصعَدَت","بَينَ الوَريقَةِ وَالمَقادِ حُمولُ",17,"ل",1,0],["أيّ قلبٍ لم يرمَ بعد سراهُ","بفنون الأوجاع والأوجال",18,"ل",1,0],["أيُّ قرْنٍ باد منهم لم يكن","حَقَّهُ لو أنصفَ الدهرُ البُيُودُ",19,"د",1,0],["أيقنت إذ وامضتني منك بارقة","أني بسيبك مربوع ومخروف",20,"ف",1,0],["أيقتُلُني من ليس لي منه ناصرٌ","سواه وأعواني عليه مكارِمُهْ",21,"ه",1,1],["أيقود قحطبةُ الجيوشَ مُسوَّماً","بالخافقين كحُوَّم العِقبان",22,"ن",1,0],["أَيقَظتَ في الأَنفُسِ الأَماني","وَالاِبتِساماتِ في الثُغورِ",23,"ر",1,0],["أَيقَنتُ أَنَّكِ جَنَّةٌ خَلّابَةٌ","فَحَنَنتُ مِن بَعدِ المَشيبِ إِلَيكِ",24,"ك",1,0],["أَيقِظ شُعورَكَ بِالمَحَبَّةِ إِن غَفا","لَولا الشُعورُ الناسُ كانوا كَالدُمى",25,"م",2,0],["أيقظوا فيهِ نزْعَةَ الشَّرِّ فانْقَضَّ","على النَّاسِ فاتكاً جبَّارا",26,"ا",1,0],["أيَّ قدس يضُمَ هذا البناء","حسدت أرضه عليه السماء",27,"ا",2,1],["أيقنت أن الخلق ضلوا ربهم","يا رب لا تأخذهم بعذاب",28,"ب",1,0],["أيقنت أن منى العشاق ما جُمعت","إلا إلى مثل خيط العنكب الفاني",29,"ي",1,0],["أَيَقولُ واشٍ أَو يُرَدِّدُ شامِتٌ","صِنديدُ بُرقَةَ موثَقٌ مَكبولُ",30,"ل",1,0],["أَيَقولونَ سَكرَةٌ لَن تَجَلّى","وَقُعودٌ مَعَ الهَوى وَقِيامُ",31,"م",1,0],["أَيقَنتَ أَنَّ الجَهلَ عِل","لَةُ كُلِّ مُجتَمَعٍ سَقيمِ",32,"م",1,0],["أَيُقالُ فِتيانُ الحِمى بِكِ قَصَّروا","أَم ضَيَّعوا الحُرُماتِ أَم خانوكِ",33,"ك",1,0],["أَيَقدَحُ في الخَيمَةِ العُذَّلُ","وَتَشمَلُ مَن دَهرَها يَشمَلُ",34,"ل",1,1],["أَيقَنتُ أَنَّ سَعيداً طالِبٌ بِدَمي","لَمّا بَصُرتُ بِهِ بِالرُمحِ مُعتَقِلا",35,"ل",2,0],["أَيَقتَصُّ مِنّي آخِرُ الدَهرِ ظالِماً","جَرائِرَ أَجدادي عَلى أَوَّلِ الدَهرِ",36,"ر",1,0],["أَيُّ قَضيبٍ عَلى كَثيبِ نَقا","أَحسَنُ مِن خَصرِهِ عَلى كَفَلِه",37,"ه",1,0],["أَيقَظتُموهُ وَنِمتُمُ عَن صَولَةٍ","طَحَنَت مَناكِبَ يَذبُلٍ وَشَمامِ",38,"م",1,0],["أَيُقتَلُ مَخضوبُ البَنانِ مُبَرقَعٌ","بِمَيتٍ خُفاتاً لَم تُصِبهُ كِلامُها",39,"م",3,0],["أَيُّ قَوافٍ يَعزُّ مُونِقُها","فيَستَرِقَّ القُلوبَ رَيِّقُها",40,"ق",3,1],["أَيقرُبُ منك ذو نَسَبٍ بعيدٍ","ويبعُدُ مَنْ له نَسَبٌ قريبُ",41,"ب",1,0],["أَيقَنتُ أَنَّ المُستَحيلَ ثَلاثَةٌ","الغولُ وَالعَنقاءُ وَالخِلُّ الوَفي",42,"ي",1,0],["أَيقَنتُ أَن لَستَ إِنساناً لِفِعلِكَ ذا","لِقَولِهِ خُلِقَ الإِنسانُ مِن عَجَلِ",43,"ل",1,0],["أيقول دهري إن ما يبسا","هيهات يرجع عوده الرطب",44,"ب",1,0],["أَيقَنتُ حينَ نَتَفتَ أَن سَتُكابِرُ","وَعَلِمتُ إِذ بادَلتَ أَن سَتُؤاجِرُ",45,"ر",1,1],["أَيقَظتَ لِلكَرَمِ الكِرامَ بِناطِقٍ","لِنَداكَ أَظهَرَ كَنزَ كُلِّ قَديمِ",46,"م",1,0],["أَيقَظتَ هاجِعَهُم وَهَل يُغنيهُم","سَهَرُ النَواظِرِ وَالعُقولِ نِيامُ",47,"م",1,0],["أَيقَنتَ أَنَّ مِنَ السَماحِ شَجاعَةً","تُدمي وَأَنَّ مِنَ الشَجاعَةِ جودا",48,"د",2,0],["أيقطعُ طرفُكِ المسنو