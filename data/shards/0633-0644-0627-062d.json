{"poems":[[53,"أغر أناسا أن تجافيت عنهم","https://www.aldiwan.net/poem64685.html","الطويل"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[87,"رأيت الجنون جديرا به","https://www.aldiwan.net/poem7805.html","المتقارب"],[87,"يد الملك العلوي الكريم","https://www.aldiwan.net/poem8082.html","المتقارب"],[63,"ومخطف الخصر برده حبر","https://www.aldiwan.net/poem51617.html","المنسرح"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[92,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[132,"النون حاجبه والعين مقلته","https://www.aldiwan.net/poem50514.html","البسيط"],[186,"تنبهوا واستفيقوا أيها العرب","https://www.aldiwan.net/poem67087.html","البسيط"],[275,"أيوحشك الملهى ويؤنسك الرمس","https://www.aldiwan.net/poem35181.html","الطويل"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[369,"سلا حادي الأنضاء أين يريد","https://www.aldiwan.net/poem60957.html","الطويل"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[371,"وقاك الله من غلب الرجال","https://www.aldiwan.net/poem17258.html","الوافر"],[376,"كأن الليالي بالليالي طلبنني","https://www.aldiwan.net/poem57169.html","الطويل"],[406,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[412,"قد كنت نبالا بلحظك صائدا","https://www.aldiwan.net/poem50183.html","الطويل"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[466,"يقر بعيني أن أراها مغيرة","https://www.aldiwan.net/poem15105.html","الطويل"],[466,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[543,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[554,"ترى أثر القيون بصفحتيه","https://www.aldiwan.net/poem445.html",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39002","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96627","الوافر"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107035","الرجز"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108494","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10509","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76001","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200998","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202606","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100834","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130060","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62824","الوافر"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2525","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111516","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4755,"سِلاحٌ وحَربٌ أَو فَبَحرٌ وسَاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=184086",""],[4929,"تطريز كلمة (السلام)","https://www.poetsgate.com/ViewPoem.aspx?id=199730",""],[5122,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=27210",""],[5135,"الغِيْد","https://www.poetsgate.com/ViewPoem.aspx?id=202003",""],[5273,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=180372",""],[5431,"حضارتنا يُراد لها زوال","https://www.poetsgate.com/ViewPoem.aspx?id=183275",""],[5476,"كِبْرِيَاءُ الْمَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=194644",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5582,"أَبَدْرٌ فِي الكَنِيسَةِ أَمْ بَراحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186831",""],[5616,"قطار","https://www.poetsgate.com/ViewPoem.aspx?id=203453",""],[5688,"ظاهرة الغش في المدارس","https://www.poetsgate.com/ViewPoem.aspx?id=200922",""],[6093,"السَّمَهَّى","https://www.poetsgate.com/ViewPoem.aspx?id=211002",""],[3874,"تقول إبنة العمري مالك بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=6445",""],[186,"تنبهوا واستفيقوا أيها العرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55739&r=&rc=2",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""]],"verses":[["سلاحي لسان لا يُفلُّ وجُنَّتي","أديمٌ صحيحٌ يضرحُ العار أملس",0,"س",1,0],["سلاح من سلاح الموت أمضى","إذا الإيمان يوم الروع أنضى",1,"ض",2,0],["سلاح ثقيل بلا مضرب","وحمل ثقيل بلا فائدة",2,"ه",1,0],["سِلاحُكَ مِن أَدَواتِ الحَياةِ","وَكُلُّ سِلاحٍ أَداةُ العَطَب",3,"ب",1,0],["سِلاحُه الدَّهْرَ في مُؤَخَّرِهِ","يَفتُكُ طَوراً به ويَنتَصرُ",4,"ر",1,0],["سِلاحُ الحقِّ يقطعُ كلَّ عَضْبٍ","ويَصدعُ قُوّةَ المُتهوِّرينا",5,"ن",2,0],["سلاحكم خنجر ماضي الضريبة أو","مسدس وَسلاحي في الوغى قصب",6,"ب",1,0],["سِلاَحُكِ الحَقُّ إِنْ أَلْقَى أَشِعَّتَهُ","هَوَتْ أَبَاطِيلُهُمْ رَأْسَاً عَلَى عَقِبِ",7,"ب",1,0],["سلاحُها لحظُها الماضي وأسلحتي","فَنٌّ يجرِّدُه للغزوِ فَنّانُ",8,"ن",1,0],["سلاحُ البلادِ المرهفُ الحدِّ ماله","نَبا منهُ في يومِ التَّصادُم مضرب؟",9,"ب",1,0],["سلاحُهُمُ الأحدُّ إذا تصدَّى","لهمْ باغ وركنهمُ الأشدُّ",10,"د",1,0],["سلاحُه طرفُه ما شاءَ صرَّفَه","يرمى فيُصْمِى ولكن لا يسيل دَمُ",11,"م",1,0],["سِلاحَهُم في وُجوهِ الخَصمِ مَكرَهُمُ","وَخَير جُندِهُم التَّدليسُ وَالكَذبُ",12,"ب",1,0],["سلاحُهما ماضٍ وقاضٍ هواهُما","ولا درعَ لي عندَ العراكِ ولا ترس",13,"س",1,0],["سلاحُ هوىً لم تَنْتشِبْ وقَعاتُه","فأَجلَيْنَ إلاّ عن مَصارعِ مُغْرَم",14,"م",1,0],["سلا حاديَ الأنضاء أين يريدُ","وهذا وقد كلَّ المَطِيُّ زرودُ",15,"د",1,1],["سِلاحُ حَربي مَعَ الأَيّامِ عَطَّلَهُ","رَأيٌ مِنَ الرَأيِ حَليٌ يُشبِهُ العَطَلا",16,"ل",2,0],["سِلاحُ الرَأيِ مِن جَلٍّ وَدِقٍ","لَدَيكَ فَمِن عَوالٍ أَو نِبالِ",17,"ل",1,0],["سلاحُ اللَّيالي كلّ أبيضَ باذِلٍ","تجاذِبُه لا كلُّ أَسمَرَ ذابِلِ",18,"ل",1,0],["سلاحه دفْترٌ أو لوحةٌ بَرَزَتْ","فيها الحروفُ لأهل البغي إنذارا",19,"ر",2,0],["سِلاحٌ وَلَكِن لا يَضيرُ مُدانياً","وَيَنفُذُ فيهِ حده مُتَباعِدا",20,"د",2,0],["سلاحاً قتلتَ بهنَّ الحقودَ","وخيلاً غَنمتَ بهِنَّ السَلامَهْ",21,"م",2,0],["سلاحهمُ يومَ التسالم زينةٌ","وحربهمُ يوم اللقاءِ فِرار",22,"ر",1,0],["سِلاحُه وكميُّ الروع في رَهجٍ","والمالُ كلٌّ بحبِّ المجد مظْلومُ",23,"م",1,0],["سِلاحُ حَدِيد قد بَدا مثلَما بدا","سِوَاه وسُلحَانٌ ستظهر مِن بعدُ",24,"د",1,0],["سِلاحي ثُمَّ قَد عَلِموا بِأَنّي","إِذا ما فَرَّ ذو العِذَرِ السَميجُ",25,"ج",1,0],["سِلاح دارِ وَزير لا نَظير لَهُ","وَمثلهُ الدهرَ مَعدومٌ وَمَفقودُ",26,"د",1,0],["سلاحٌ يزدهي في كلّ عينٍ","وَيعذبُ منه في المهج الجراحُ",27,"ح",1,0],["سل احداً ففيه بالنص الجلي","نادى الأمين لا فتى إلا علي",28,"ي",1,0],["سلاحُه رمحٌ فما عُذرهُ","وقد عراه دونه الذعرُ",29,"ر",1,0],["سلاحك قتال فرفقاً بمغرم","على قدميك الآن ألقى سلاحه",30,"ح",2,0],["سِلاحُكُمُ يَومَ الهِياجِ أَصِرَّةٌ","بِأَيديكُمُ مَعوِيَّةٌ وَمَثاني",31,"ي",1,1],["سِلاحٌ كُلُّهنَّ غَدَت","قَواتِلَ بَعضها يَكفي",32,"ف",2,0],["سلاحك للحسود هو التعالي","فإما تعتلي مات الحسود",33,"د",1,0],["سلاحنا كلُّ شيء تنظرون له","حيث السلاح لديكم بعض أوراق",34,"ق",1,0],["سلاحهم يراع لا حسام","وعدتهم لك الرأي السديد",35,"د",1,0],["سلاحكمُ حسن اليقين وجيشكم","نفوسٌ تفلُّ الحادثات وتحطمُ",36,"م",1,0],["سلاحُ مباشرٍ لا يَزْدَهيهِ","سُمُوّ الخُنْزُوانةِ والجَلالِ",37,"ل",1,0],["سِلاحُ اِمرِئٍ قَد يَعلَمُ الناسُ أَنَّهُ","طَلوبٌ لِثَأراتِ الرِجالِ مُطَلَّبِ",38,"ب",1,0],["سلاح خلدٍ من الأرباب أهديه","فيلا فما حصرت تقويمه القيم",39,"م",1,0],["سلاح سرفدونٍ الذي استلب","فطرقل لما ذلك القرم غلب",40,"ب",1,0],["سِلاحَنا الأَسيافُ وَالبَنادِقُ","وَبِالرِمايَةِ الجَميعُ حاذِق",41,"ق",1,0],["سل أحدثك أحاديث الرجوم","إنها يشهد عن عنها كبا",42,"ب",2,0],["سِلاحُهُمْ لاََِعادِيهِمْ تَحَرُّزُهُمْ","بِعِزِّ مَوْلىً بِهِ قِدْمَاً تَعَزُّزُهُمْ",43,"م",1,0],["سلاحهم التعري من سلاحٍ","وإن جوادَهم فيها الفِرار",44,"ر",1,0],["سِلاحٌ وحَربٌ أَو فَبَحرٌ وسَاحِلُ","هِيَ الحَربُ.. أُختُ البَحرِ، والكُلُّ قاتِلُ",45,"ل",1,1],["سلاحُهمْ ، مصدرٌ للرِّزقِ سلعتُهُ","وفي دمانا على أسواقِها طلبُ",46,"ب",1,0],["سلاحه الإيمان واصل كفاحه","لين الحجر معنى الحقيقة،، نطقها",47,"ق",3,0],["سلاح الغانيات قِلىً وهجرٌ","وإن أعطين بالوصل الوعودا",48,"د",2,0],["سِلاحي قصيدي وعِطْرُ حُروفي","فَهَلْ بالقَصَائدِ يأتي الظَّفَرْ؟",49,"ر",1,0],["سلاحك في الحياة وميض علمٍ","فلاتجزع وأشعله فتيلا",50,"ل",2,0],["سلاحك في الحياة مداد علمِ","تزوّد بالعلوم تعشْ طويلا",50,"ل",2,0],["سِلَاحِي هُوَ الْخَوْفُ مِنْ أَضْلُعِي","وَلَا السَّاعِدُ الْعَنْتَرِيُّ أَرَاهْ",51,"ا",2,0],["سلاحُهمْ خنجرٌ يقتاتُ من دمهم","ينسلُّ نحوَ هدير الكفرِ من سَقَرِ",52,"ر",1,0],["سِلاحٌ يُزْدَهَى فِي كُلِّ عَيْنٍ","وَتَعْذُبُ مِنْهُ في المُهَجِ الجِراحُ",53,"ح",1,0],["سلاحي حين يخذلني سلاحي","وعكازي أهش بها القطيعا",54,"ع",2,0],["سلاح ليس منه أشدّ فتكا","وفي التدمير ليس له نظير",55,"ر",1,0],["سلاحهم التعنظي والتخنذي","وبين شدوقهم حملوا الحديدا",56,"د",2,0],["سِلاحُ امرىء ٍ قد يَعلَمُ النّاسُ أنّهُ","طَلُوبٌ لثأراتِ الرّجالِ مُطَلَّبِ",57,"ب",1,0],["سلاحهم في وجوه الخصم مكرهم","وخير جندكم التدليس والكذب",58,"ب",1,0],["سلاحه ابدا في نحر أمته","يا خائن الجار غدرا بعد ما رقدا",59,"د",2,0]]}