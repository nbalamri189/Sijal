diwan/poem/131342","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125831","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117204","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4767,"عقد زينب","https://www.poetsgate.com/ViewPoem.aspx?id=179946",""],[4767,"أصل الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=214135",""],[4935,"هنئو هذا الكريم الراقيا","https://www.poetsgate.com/ViewPoem.aspx?id=129513",""],[4935,"بالعلى والخير قد وافى حسين","https://www.poetsgate.com/ViewPoem.aspx?id=129486",""],[4935,"أضحى خطيب العلم فوق المنبر","https://www.poetsgate.com/ViewPoem.aspx?id=129451",""],[182,"ارتواء روحين","https://www.poetsgate.com/ViewPoem.aspx?id=72797",""],[4981,"وقفة مع الآخرة","https://www.poetsgate.com/ViewPoem.aspx?id=190507",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[4119,"إن الألى جمعتهم والنوى دار","https://www.poetsgate.com/ViewPoem.aspx?id=16140",""],[5072,"يا صاحب العقل","https://www.poetsgate.com/ViewPoem.aspx?id=53672",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5232,"قُبَّرتي","https://www.poetsgate.com/ViewPoem.aspx?id=212760",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5691,"يعرب","https://www.poetsgate.com/ViewPoem.aspx?id=206081",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5952,"شوقٌ لِ قُبَّتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=212162",""],[6132,"أَقُول للخل عداك الردى","https://www.poetsgate.com/ViewPoem.aspx?id=194880",""],[520,"هم الأحبة ان جاروا وإن عدلوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577619",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["فَلي عِندَها بُردٌ تُسَكِّنُ قَلبَها","بِهِ وَلَها عِندي حِقابٌ وَخاتَمُ",0,"م",1,0],["فَليعدِلَنَّ سَماحَ كَفِّكَ قَطرَه","وَليورِقَنَّ بِقُربِكَ الصَخرُ",1,"ر",1,0],["فَليُعطيَنَّكَ ما أَرادَ بِقُدرَةٍ","فَهوَ اللَطيفُ لِما أَرادَ فِعالا",2,"ل",2,0],["فَليَعجَبِ الناسُ مِن قَومٍ يَقودهُمُ","إِلى الضَلالَةِ أَعمى وَهوَ مُتَّبَعُ",3,"ع",1,0],["فليعاقب كلاهما","إذا هما مصدرا الجوى",4,"و",2,0],["فليعل فيه ثالث القمرين","وليسلم فؤاده",5,"د",2,0],["فليعلم اللؤماء من أعدائنا","أن البلاد عزيزة برجالها",6,"ل",3,0],["فلْيعتبر بك هذا الشعب مفتدياً","إن كان شعبك بعد اليوم معتبرا",7,"ر",2,0],["فليعذر الآن مغلوب بعائلةٍ","ليس السكوت بمجديهم ولا الحراك",8,"ك",1,0],["فليعذر المدَّاح فيه فإنهم","بالعجز عن أدنى المدى قد أيقنوا",9,"ن",3,0],["فليعلمِ الرؤساءُ أني راهبٌ","للشرّ والمرهوبُ من أسبابِهِ",10,"ب",2,0],["فَلْيُعْنَ بِالمَثلِ المضْرُوب غَيْرُكما","فليس مَعْناكُما فيه بموْجُودِ",11,"د",1,0],["فليعطك الحظُّ ما شا","ء وليكاثِرْكَ جُهْدَهْ",12,"د",2,0],["فليعش ما بقيت آثاره","وهي أبقى من شروى ونضاد",13,"د",1,0],["فليعذُر الناس من أساء ومن","قصر في الشعر إنه بشر",14,"ر",1,0],["فليعلم المتَقنِّصون بأنه","ما كل حينٍ يُطعم المتقنِّصُ",15,"ص",1,0],["فليعظك امرؤ غدا في يديه","حسبٌ مبتلىً ومالٌ معافى",16,"ف",2,0],["فَلْيَعِبْ عائبٌ سواهم وإلا","فليلاطِم أسنّةً في عوالِ",17,"ل",1,0],["فليعلمِ الملك المظفَّرُ أنه","ما للسلامةِ ما أقام ترحُّلُ",18,"ل",1,0],["فليُعده إلى المطابقِ مذمو","ماً فما للمُجيف شيء كَدفنه",19,"ن",2,0],["فَليَعقِلوا عَن غِيِّهِم إِنّي أَرى","خَوَرَ الشُيوخِ بِهِم وَلَمّا يَهرَموا",20,"م",3,0],["فَلي عَن يَمينِ الغَورِ دارٌ عَهَدتُني","أَميلُ لِأَقمارٍ بِها وَشُموسِ",21,"س",1,0],["فَليَعسُرَنَّ عَلى اللَيالي بَعدَهُ","أَن يُبتَلى بِصُروفِهِنَّ المُعسِرُ",22,"ر",1,0],["فَلْيَعْلَمَنَّ أَخُو الْجَهَالَةِ قَصْرَهُ","عَنِّي وَإِنْ سَبَقَتْ بِهِ قَدَمَانِ",23,"ن",1,0],["فَليَعِدنا مَوعِداً لا","نَتَّقي فيهِ نَموما",24,"م",2,0],["فليعرفِ الحقَّ قومٌ ضلَّ رائدُهم","وارتدَّ قائدُهم خَزيانَ يعتذر",25,"ر",1,0],["فَلْيَعْبُدُوا غيرَ المسيحِ فليس في","دينِ الترهُّبِ عن سُيوفك مَزحل",26,"ل",1,0],["فَليَعْلَمِ الأَعْقَابُ مَن ذَاكَ الَّذِي","زَانَ الظُّهُورَ بِتَاجِ هَذَا المَفرِقِ",27,"ق",1,0],["فَليَعْمَرِ البَيتُ الَّذي شِدْتُما","ولتَسْعَدا أَقْصَى مَدَى العُمْرِ",28,"ر",1,0],["فلْيُعْلِيَنَّ اللهُ كَعْبَ وَلِيِّهِ","وَلْيَجْعَلَنَّ عَدُوَّهُ الذّلاّنَا",29,"ن",2,0],["فليَعُد الليثُ إلى العرين","أهلاً بمصرَ البلدِ الأمينِ",30,"ن",1,0],["فلْيعلم الغَرْبُ أن الشرق لافظُهم","وإن أتتهمْ من الشيطانِ أمداد",31,"د",1,0],["فليعشْ مابقيتْ آثارُه","وهي أبقى من شَرَوْرَى ونَضَاد",32,"د",1,0],["فليعتبرْ مَن كان ذَا","عقلٍ يقيسُ وذَا بصرْ",33,"ر",1,0],["فَليَعلُ أَبناءُ المُلوكِ كَما حَوى","أَسنى الحِباءِ وَعُدَّ في الأَحياءِ",34,"ا",2,0],["فَليَعتَرِف لَكَ بِالسِيادَةِ أَهلُها","لَزِمَت مَلازِمَها وَصَرَّ الجُندُبُ",35,"ب",1,0],["فَليَعلَمِ الساعي لِيُدرِكَ ذا المَدى","أَنَّ الطَريقَ كَثيرَةٌ أَخطارُهُ",36,"ر",2,0],["فَليَعلُ قَدرُ التُركِ أَنَّكَ مِنهُمُ","فَلَهُم بِكَ الشَرَفُ الَّذي لا يُدَّعا",37,"ع",2,0],["فَليَعلَموا أَنّي ثَبَتُّ بِمَوقِفٍ","لَو قامَ سَحبانٌ بِهِ لَتَتَعتَعا",38,"ع",2,0],["فَليَعسُرَنَّ عَلى اللَيالي بَعدَما","كَلَّفتَها الإِسهالَ أَن تَتَعَسَّفا",39,"ف",2,0],["فَليَعذِرِ المَولى الَّذي خالَفتُهُ","فَأَذَعتُ جوداً رَأيُهُ كِتمانُهُ",40,"ن",2,0],["فليعلمن الشامتون بأنني","عند الممهد قابلا مقبولا",41,"ل",2,0],["فَلي عَن ديارِ الهونِ مَنأىً وَمَرحَلٌ","إِذا النِّكسُ ظنَّ العَجزَ عَقلاً فَأَفرَدا",42,"د",2,0],["فلي عَيْلةٌ عَشْر وجاريَ خمسةٌ","وباطنُ أحوالي بذاك قَبيح",43,"ح",1,0],["فَليَعلِم الغادُونَ أَنّ جَوانِحي","مَثوى الأَحِبَّةِ غُوَّرُوا أَو أَنجَدُوا",44,"د",3,0],["فلي عندكم عهدٌ قديم وموثقٌ","لأن رسول الله عروتي الوثقى",45,"ق",2,0],["فَلي عِيالٌ لا يُريدونَ مِن","فاكِهَةِ الدُنيا سِوى المِشمِشِ",46,"ش",1,0],["فَلْيَعْلَمِ الْغَيْثُ الْمُجَلْجِلُ رَعْدُهُ","أَنَّ السَّماحَ مُعِينُهُ بِمَعِينِهِ",47,"ن",2,0],["فَلي عَن كُلِّ شُغلٍ في","بَني الدُنيا بِها شُغُلُ",48,"ل",1,0],["فَليَعجَبِ الناسُ مِنّي أَنَّني شَرِقٌ","بِماءِ عَينَيَّ وَالأَحشاءُ تَلتَهِبُ",49,"ب",1,0],["فَليَعتَصِم بِدُخولِهِ","في عِزِّ طاعَةِ ذي الجَلالِ",50,"ل",1,0],["فلي عَبراتٌ إن أحسَّتْ بِبَيْنِكم","إذنْ تَركَتْ بحراً لكم جانبَ البَرّ",51,"ر",1,0],["فَليَعلَم الأَحبابُ أَنّا لَهُم","وافونُ في الحُبِّ وَإِن خانوا",52,"ن",3,0],["فَليَعتَبر مَن كانَ ذا","بَغي وَلا يَركَب غُرورَه",53,"ر",2,0],["فلي عهود به قد بت أرقبها","عسى الرياح تهاديني بنشرهم",54,"م",1,0],["فلْيَعْجَبِ الدَّهْرُ أَنه وَلَدٌ","لو كانَ للدهرِ والِدٌ وَلَدَه",55,"د",2,0],["فليعلمِ السَمْدانُ إذ فارقتُه","أني لديكَ بذروةِ السُمْدانِ",56,"ن",1,0],["فليعلم القدسُ أن الفتح منتظرٌ","حاولهُ وعلى الآفاق فليطل",57,"ل",1,0],["فليعلمنَّ مهوّمٌ عاف السّرى","ما فاتهُ بالنصّ والذّملان",58,"ن",1,0],["فليعلم اليمن القصي بأنه","دار فناء العدم عند فنائها",59,"ا",3,0],["فليعلموا أن ودي لا يغيره","تغير من سجاياهم ولا ملل",60,"ل",1,0],["فَليَعُد مَغتَمَّ نَفسٍ","َدامِىَ القلبِ كَسيرَا",61,"ر",2,0],["فليَعِش لِلنَّاسِ ذُخرا","مَلِكُ العَصرِ مُحَمَّد",62,"د",1,0],["فلْيُعدِدِ الأكفانَ قبلَ ثيابِهِ","والنَّعشَ قبلَ سريرهِ ومُهودِهِ",63,"د",2,0],["فليعتبر كل ويسمع من له","اذنان متعظا بما قد قيلا",64,"ل",2,0],["فليَعِش ولتَعِش بلاد عليها","كلّ شهمٍ بالأمر والحكم عادل",65,"ل",1,0],["فليَعِش في حِمى الإله سعيداً","وَحباهُ بالنصرِ ربّ العبادِ",66,"د",1,0],["فَليَعِش سيّد البلاد عزيزاً","لَم يَزل للحِمى وللشعب سورُ",67,"ر",1,0],["فَليَعلَمِ الثَّقلانِ أنَّ كِفايَتي","مِن بِرِّ سُلطانٍ وَمِن إنعامِهِ",68,"م",2,0],["فَلي عَن ثَقيفٍ إِن هَمَمتُ بِنَجوَةٍ","مَهابَةَ تَهوي بَينَهُنَّ الهَجارِعُ",69,"ع",1,0],["فليعتزلْ سُنَنَ الأحزان ذو فطنٍ","سيّان ما سُنَنُ الأحزان والبدَعُ",70,"ع",1,0],["فَلي عندَها مِن رحيقِ المدا","مِ كأسٌ وَمِن ريقةِ الثغر كاسُ",71,"س",1,0],["فَليَعلَم الكَونُ أَنَّ الخَيرَ يَغمُرُهُ","لِأَنَّ مالِكُهُ بِاللُطفِ يَنظرُهُ",72,"ر",2,1],["فليعف عنهم انما هي عثرة","ما ان تعز على الامام جبورها",73,"ر",3,0],["فليعلم الشرق أن السعد رائده","وإن وقت جهاد الشرق قد أزفا",74,"ف",2,0],["فليعل صوت العب حتى","يرجعوا من حيث جاءوا",75,"ا",1,0],["فليعتبر من كان ذا نظرٍ","ولينتبه من نومهِ من رقد",76,"د",1,0],["فَلِي عَلَمٌ فِي ذَرْوَةِ الْمَجْدِ قَائِمٌ","رَفِيعُ الْسَّنَا تَأْوِي لَهُ كُلُّ أُمَّةِ",77,"ه",1,0],["فليعل في سمائها الهلال","على الذرا منها وفي الوهاد",78,"د",1,0],["فليعتبر قومي كفي ما قد جرى","من ذات خلف بيننا وتنافي",79,"ف",2,0],["فلي على كل خصله قافيه","فيها مدحته بما قد شاع وذاع",80,"ع",1,0],["فليعقد العرب في الدنيا مناحتهم","من الفرات إلى خزان أسوان",81,"ن",1,0],["فليعش ذا الفن مع أربابه","باعتزاز بعد ذاك الامتهان",82,"ن",1,0],["فليعلمن معاشر","أن تأت فاطمة القيامه",83,"م",2,0],["فلْيَعتَرِضْ سوداءَ نُوبِيَّةً","كالقِرْدِ في حُجرة نَخّاس",84,"س",1,0],["فليعطينك ذو العلا","بدوام ملك الأرض عهدا",85,"د",2,0],["فليعترف بالعجز مثلي شاعر","يرجو لوصفك أن يكون محققا",86,"ق",2,0],["فليعلموا أنى تركت ثمادهم","قصدا الى هذا السحاب المُغدق",87,"ق",1,0],["فليعذل العاذلون فيه فلا","سمع عن العاذلين في صمم",88,"م",1,0],["فليعترى الحسد الاقران ما بلغوا","مرامهم ولهذا يعترى الحسد",89,"د",1,0],["فلي عين على رؤياك اشهى","من الصادي إلى الماء المعين",90,"ن",1,0],["فليعطفِ الغيدَ غيرى فى خمائلها","وليقطفِ الورد من تلك البساتينِ",91,"ن",1,0],["فليعش من عاش فالجن","دي قد مات شهيد",92,"د",1,0],["فليعشْ جيبي فقيراً إنما","فقر جيبي ثروةٌ للأدب",93,"ب",1,0],["فلي عيشةُ اليوم في الحاضر","وفي الغد في خاطر الذاكر",94,"ر",1,0],["فلي على الفقرٌ أجرٌ","لو يملك الفقر أجرا",95,"ر",2,0],["فليعرفنَّ به الأحبّ","ةُ حُسنَ عهدكَ بالمغيب",96,"ب",1,0],["فَليَعجَبِ الناسُ مِنّي أَنَّ لي بَدَناً","لا روحَ فيهِ وَلي روحٌ بِلا بَدَنِ",97,"ن",1,0],["فليُعطَ فِى التَّعريفِ وَالتَّنكيرِ مَا","لِما تَلا كامرُر بِقَومٍ كُرَمَا",98,"م",2,0],["فَلي عالَةٌ رَبّي العَليمُ بِحالِهِم","فُؤادي لَهُم أَضحى بِجَمرٍ يضرّما",99,"م",2,0],["فليعتبر اولو الجرائم مثلةً","وليرعووا متوحشو الغبرائي",100,"ي",1,0],["فليعلم الأقوام أن أناتنا","دامت إلى حين من الأحيان",101,"ن",1,0],["فلي عن هوى سلماي حُسنُ تَخ