{"poems":[[30,"أعيني إلا تسعداني ألمكما","https://www.aldiwan.net/poem5085.html","الطويل"],[592,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53101","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85251","البسيط"],[5776,"عَامُ الفيلِ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=200699",""],[5845,"كلامٌ بلا نحوٍ طعامٌ بلا ملحِ","https://www.poetsgate.com/ViewPoem.aspx?id=198485",""]],"verses":[["وَقَلَّ جَداءً عَبرَةٌ تَسفَحانِها","عَلى أَنَّها تَشفي الحَرارَةَ في الصَدرِ",0,"ر",1,0],["وقل جزا الله شيخ المسلمين كما","قد شاد للملة السمحاء أركانا",1,"ن",2,0],["وقلَّ جاني عِذْقٍ يُزهِّدُه","في العِذْقِ سُلاَّءَةٌ تُعزّزُهُ",2,"ز",2,0],["وقل جاد مثواك الغمام إذا هَمَى","به باكر الأنواء راح كما غدا",3,"د",2,0],["وقلَّ جلدي","من ذا ألوذ به أو من أقلده",4,"ه",1,0],["وقل جزى اللَه شيخ المسلمين بما","أبدا فجلى ظلام الشرك بالنور",5,"ر",1,0],["وقُلْ جاءَ نصرُ اللهِ للرايةِ الأهدى","وإن اشتِدادَ الحربِ قد قرّبَ الوعدا",6,"د",2,1],["وقُلْ جاءَ نصرُاللهِ، نادتْ شواطئي","هنا يحصدون الجزْرَ لن يبلغوا المدّا",6,"د",2,0],["وقلَّ جهاداً شوكهَ الشركِ إذْ دعا","كباشَ جهادِ المشركينَ إلى الذبحِ",7,"ح",1,0]]}