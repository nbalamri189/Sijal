{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[32,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[68,"ضعف رأسي وقلة الإيمان","https://www.aldiwan.net/poem39039.html","الخفيف"],[46,"بعقلي هذا صرت أحدوثة الركب","https://www.aldiwan.net/poem30278.html","الطويل"],[48,"لقد مات جني الصبا منذ برهة","https://www.aldiwan.net/poem22450.html","الطويل"],[161,"هدية لأشبال فلسطين","https://www.aldiwan.net/poem23650.html","الخبب"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[447,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2412","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122684","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87227","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64239","الخفيف"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67835","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67824","الطويل"],[1243,"","https://poetry.dctabudhabi.ae/diwan/poem/105729","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27811","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65936","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204701","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129404","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85074","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70161","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77081","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4881,"نصائح","https://www.poetsgate.com/ViewPoem.aspx?id=181833",""],[4946,"معاتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=175984",""],[5136,"قسما باللها وورد الخدود","https://www.poetsgate.com/ViewPoem.aspx?id=121562",""],[5324,"يامظهر الإحسان.","https://www.poetsgate.com/ViewPoem.aspx?id=211078",""],[5431,"سبحان الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=208038",""],[5436,"نصيحة صادقة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35264",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5660,"فَلَستُ أَرى فَيضَ الفُراتِ بِناضِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=24646",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5956,"الله وحدَهُ فاطرُ الأكوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=183100",""],[5956,"رسولٌ كان أكثرهم شعورا","https://www.poetsgate.com/ViewPoem.aspx?id=192702",""],[5956,"تُهدى التحايا إليكم أيها العمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=193645",""],[6134,"وليلة انس زانها قمر البشر","https://www.poetsgate.com/ViewPoem.aspx?id=169556",""]],"verses":[["بعقلي فديت الطيش في اللهو والصبا","وهيهات يفدى جفف الضرع حالبه",0,"ب",2,0],["بِعَقوَتِها الهِجانُ وَكُلُ طِرفٍ","كَأَنَّ نِجارَ نُقبَتِهِ أَديمُ",1,"م",1,0],["بِعُقارٍ تَظَلُّ تَفعَلُ بِالعَق","لِ فِعالَ النُعاسِ بِالأَجفانِ",2,"ن",1,0],["بِعَقلي هَذا صِرتُ أُحدوثَةَ الرَكبِ","وَقَد كُنتُ في سَلمٍ فَأَصبَحتُ في حَربِ",3,"ب",1,1],["بِعَقّاقَةٍ أَهلَ العَقيقِ وَمَنعَجٍ","وَزَرادَةٍ بِالحَتفِ أَهلَ زَرودِ",4,"د",1,0],["بِعُقُولِ رِجَالِكَ نَحْنُ لَهَا","والله بِحَوْلِهِ يُمْدِدُنَا",5,"ن",2,0],["بِعَقدِ البَندِ حَلَّ عُرى اِصطِباري","فَعَن قَلبي الكَئيبِ لَهُ اِنهِزامُ",6,"م",1,0],["بِعُقامٍ أُجدٍ تَفَلَّجُ بِالسَرا","كِبِ عَنسٍ جُلالَةٍ شملالِ",7,"ل",1,0],["بعِقدَيْنِ عِقْدٍ حَلَّ غيرَ محلِّه","وعِقْدٍ نظيمٍ حَلَّ من حيث يُعقَد",8,"د",1,0],["بعقول لم تزل مشرقة","وسيوف تحصد الأَعمار حصدا",9,"د",2,0],["بعَقْدِ بناءٍ أَنْتَ شِدْتَ بناءَهُ","وَلَيْسَ لَهُ فِي الأَرْضِ غيرَكَ هادِمُ",10,"م",1,0],["بعقلك قسني لا بقول حواسدي","ولا تأمر اليمنى بقطع شمالكا",11,"ك",2,0],["بعقود تزدري عقد الحجر","أذلت للشمس فيه بالدخول",12,"ل",1,0],["بعقابٍ يحوم فوق صقور","ونجومٍ تجول من تحت أسد",13,"د",1,0],["بِعُقَيرِ الرومِيِّ مِنها مَحَلٌّ","وَلَها بِالكُوَيفَتَينِ دِيارُ",14,"ر",1,0],["بِعُقُودٍ مِنَ لُؤلُؤِ الفِكرِ أنهَى","مِن عُقُودِ لِلُؤلُؤِ الأصدافِ",15,"ف",1,0],["بعقل وعلم أو بفهم وفطنة","تجلى بأنواع العقول فأعلمت",16,"ت",1,0],["بِعقد نالَ إِبراهيمُ فيهِ","مَقاماً سامياً أَسنى هَنيا",17,"ي",2,0],["بعقارٍ تنفي الهمومَ وتستخ","رجُ شوقاً من الفؤاد دفينا",18,"ن",2,0],["بِعَقْرَبِ صُدْغَيْهِ حَمى الْوَرْدَ وَاللَّمى","فَهَيَّجَني مِنْ بَطْنِ وَادِ إلَى حِمى",19,"م",2,0],["بِعَقْدِ نِظَامٍ لَيْسَ يُنْقَضُ بِالْفَسْخِ","لَهُ طَلْعَةٌ كَالشَّمْسِ تَخْلُو إذَا بَدَتْ",20,"ت",1,0],["بعقرِ عشيرةٍ منّا","كرامِ الخيمِ والمنصب",21,"ب",1,0],["بعقود الثناء فخراً تحلَّى","وتحلَّت به عقودُ الثناء",22,"ا",2,0],["بِعَقلٍ رَصِينٍ في المُهِمَّاتِ نَافَذٍ","وَعَرضٍ نَقِيّ في نَظَافَتِهِ فَرْدِ",23,"د",1,0],["بعقده وفعله","رسولُنا فيما شرع",24,"ع",1,0],["بعقلك فانظر إن عقلك وافر","وعزمك فاسلك إن عزمك ثاقب",25,"ب",1,0],["بعقد امام عادل عن مشورة","يقيم حدود اللّه فيهم بفطنة",26,"ه",1,0],["بعقلي أفكر لا عقلهم","فيُحْسَبُ ما قلته فلسفه",27,"ف",2,0],["بعقيلة قد اشرقت في خدرها","كالشمس لولا وجهها لم تطلع",28,"ع",1,0],["بعقاب نجد سرني بنعيمه","أنعم بعيش ينقضي بعقابه",29,"ب",2,0],["بعقدٍ حلَّ لا يَنحلُّ قطعاً","عَلى ما سنَّهُ مولى الوجودِ",30,"د",1,0],["بِعِقدِ حاميها الهِمامَ الَّذي","إِلى المَعالي وَردَهُ وَالصَدر",31,"ر",1,0],["بعقودٍ من دُر نظمي في ال","مدحِ تحلى بها العُلى لا النحورُ",32,"ر",1,0],["بعقلٍ حباك اللهُ لكن أضعتَهُ","فكيفَ بِمنْ يُهْدى إليهِ ويُتْلِفُ ؟!",33,"ف",1,0],["بعقل راجح وجمال روح","وطيب العرف والرأي السديد",34,"د",1,0],["بعقيق الشفاه ينفح منها","نفس طاب في ثنايا برود",35,"د",1,0],["بعقالها ما أزلفت له هامة","إنّ العقال بهامه قد أزلفا",36,"ف",2,0],["بعقدٍ على جيد الحروف منظّمٌ","تُثمنه الأخلاق إمّا تُرصّعُ",37,"ع",1,0],["«بَعْقُوبَةُ» امْتَشَقَتْ سيوفاً مُرَّةً","جَعَلَتْ بنادِقَنا حمِيراً تَنْهَقُ",38,"ق",1,0],["بعقامٍ أجدٍ تقلج بالرا","كِبِ عَنْسٍ جُلالة ٍ شِمْلالِ",39,"ل",1,0],["بعقيدةٍ سمحاءَ يُبسَطُ عَدلُنا","وسلامُ أهلِ الأرضِ فينا يُعقَدُ",40,"د",1,0],["بِعَقلي كَأَطلالٌ مِنَ الجَهلِ بَعدَما","رَمَتني صُروفُ الدَّحِّ عَن كُلِّ جانِبِ",41,"ب",1,1],["بعُقولٍ خُلِقْنَ للمَجْدِ عِلْماً","لا بأيْدٍ خلِقْنَ للتَّصْفيقِ",42,"ق",1,0],["بعقيدة التوحيد يكبح آدمٌ","جُلَّ الحروبِ ونزغةَ الشيطان",43,"ن",1,0],["بعقلٍ مظلمٍ لا وعي فيه","يذل الناس إذلالاً خطيرا",44,"ر",2,0],["بعقلك الحرِّ قد ألهبتَ حافظةً","تصحو إليك عن التقصير تعتذر",45,"ر",1,0],["بعقل تسامى مع فريد نباهة","ولفظ رقيق صيغ من افخر الدر",46,"ر",1,0]]}