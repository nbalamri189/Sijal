{"poems":[[95,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[74,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[94,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[87,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55509","الكامل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142181","الكامل"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[147,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[201,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[240,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[276,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[309,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[321,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[520,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112443","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87060","الكامل"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140227",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48891","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136316","الخفيف"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21662","المديد"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101056","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88664","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137001",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93827","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94582","الكامل"],[4859,"موج النفاق","https://www.poetsgate.com/ViewPoem.aspx?id=186918",""],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[5061,"صدفه عابره","https://www.poetsgate.com/ViewPoem.aspx?id=158858",""],[5129,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=151601",""],[5277,"صمتُ الوَقور","https://www.poetsgate.com/ViewPoem.aspx?id=199746",""],[5330,"أحببتك أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=15589",""],[5348,"الرحيل إلى شواطيء الأحلام .","https://www.poetsgate.com/ViewPoem.aspx?id=59564",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5595,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=176090",""],[2110,"والنجم من فلك النحور إذا هوى","https://www.poetsgate.com/ViewPoem.aspx?id=156289",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[6115,"اذا كان مايعجبك قول الحقيقه","https://www.poetsgate.com/ViewPoem.aspx?id=180488",""],[321,"لهفى عليك ابا النذير لو انه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606414",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""]],"verses":[["وعلى شبيه النصل أغمد","رونق النصر أغتماده",0,"د",2,0],["وعلى شخصك الكريم من السؤ","دد نورٌ يكفي العقول دليلا",1,"ل",2,0],["وعلى شواطئهِ القُلُوبُ","تئنُّ داميةً عُراةْ",2,"ه",1,0],["وَعَلى شَمائِلَ كَالرُبى","بَينَ الصَبا وَالجَدوَلِ",3,"ل",1,0],["وَعَلَى شَيبِهِ النَّصْلِ أَغْ","مَدَ رَوْنَقَ النَّصْرِ اغْتِمَادُهْ",4,"د",2,0],["وعلى شفاهك يكشف الفجر","الجميل لنا نقابه",5,"ب",2,0],["وعلى شُبولِ اللَّيثِ خرقُ نعالِهم!","أزكى من المُترهِّلين حقائبا",6,"ب",2,0],["وَعَلى شِفارِ ظُباكَ أَلّا يُقدِموا","طُرَداكَ حَتّى يَنشُروا قَتلاكا",7,"ك",2,0],["وعلى شذا منديلها كم سَكرةٍ","لفؤادهِ المتلَهِّفِ المتطَلّعِ",8,"ع",1,0],["وَعَلى شَموسٍ في الخُدورِ غَوارِبٍ","لَو أَذَّنَت بَعدَ النَوى بِطُلوعِ",9,"ع",1,0],["وَعلى شهيد الدار عثمان الَّذي","من نوره استَحيت ملائكة السما",10,"م",2,0],["وعلى شيخنا وأتى","بالإمام الجامع الحفل",11,"ل",1,0],["وعلى شمائلك اللواتي ما نمت","حتى ذوت من بعد حسن سموق",12,"ق",1,0],["وعلى شمائل مجده ورُوائه","للمًلك أبَّهةٌ بغير تأبُّه",13,"ه",1,0],["وعلى شريعة جدكم ووصيه","صلى وضحى أهل كل بلاد",14,"د",1,0],["وعلى شوارعها الظباء سوافراً","يعنو لفاتر لحظها الجبار",15,"ر",1,0],["وَعَلى شَهامته وَوافر حَزمه","قامَ الدَليل لراحل وَمُقيم",16,"م",1,0],["وعلى شقّاءَ نقّاءَ استوى","كُرَةً قَوْداً تسرّ الأَعْيُنا",17,"ن",2,0],["وعلى شروطهم أصرَّ القوم أم","جاءوا بأمر ليس في الحسبان",18,"ن",1,0],["وعلى شاطئ الوداد نفوس","قد تزكت والفضل في الكون قد عم",19,"م",1,0],["وَعَلى شَعبٍ هَبَطنَ بِنا","أَهلَ شَعبٍ خُطَّةً أَضمَة",20,"م",2,0],["وعلى شرائعهم تبي","ينا الضياء من الظلام",21,"م",1,0],["وعليٌّ شاعرٌ غضُّ الصبا","صارم ان سُمتَه الخسف نبا",22,"ب",2,0],["وعلى شملِهم جنيتُ لآلي ال","رفقِ من وصلِ زينب والرَّباب",23,"ب",1,0],["وَعَلَى شَفَا جُرُفٍ بَنَيتُم أنتُمُ","فَأتَت سُيُولُ الوَحيِ وَالإِيمَانِ",24,"ن",1,0],["وَعَلى شرط لبانات الهوى","فاروعن اسحاق ما يطفي الجوى",25,"ج",3,0],["وعليّ شمس الدين كم رويت بعذ","ب قريضه وهو الزلال ظماء",26,"ا",2,0],["وعلى شأن وعز","مجدها مجد مقرر",27,"ر",1,0],["وَعَلى شُؤون الجزع أَضحى جازعاً","إِذ جرّعته شُؤونَه الجَرعاء",28,"ا",2,0],["وعلى شعاعِ الشمسِ لمع حديدها","يبدو كما يعلو اللجَين نُضارُ",29,"ر",1,0],["وعلى شواشيخ الرواسي قد غدا","تاجاَ دراري الفخر فيه نشاهدُ",30,"د",1,0],["وعلى شاطئِ الضياعِ سترسو","سفنُ الحقدِ يقتفيها الخبالُ",31,"ل",1,0],["وعلى شفاهك تلعثم حدّ سكين","وخيانة الأحمر النافر للالوان!",32,"ن",1,0],["وعليش اغاار حتى من اخيش اللي معش بالدار","وحتى من سميّش لا سمعت اسمه وضحكاته",33,"ت",2,0],["وعلى شواطئِ حزنِها رغمَ التجلُّ","دِ تحتَ أمواجِ الدُّموعِ قروحُ",34,"ح",1,0],["وعلى شفاهكِ بسمةٌ يشتاقُها","صمتُ الوقورِ وذارفُ العبراتِ",35,"ت",1,0],["وَعَلَى شَطَّيْهِمَا أَمْوَاجُ عَكَّا تَتَكَسَّرْ","مِنْ بَقَايَا دَمْعِنَا هَلْ شَجَرُ ٱللَيْمُونِ أَزْهَرْ",36,"ر",1,0],["وعلَى شواطئِ نَاظِرَيكَ تَقَطَّعَتْ","أسبابُ سَعْيِي وانْطَوتْ أَبْعادِي",37,"د",2,0],["وعلى شاطيءِ الهوى نمْتُ دهراً","واكتنفْتُ الجوى ثنايا وجودي",38,"د",2,0],["وعلى شواطئه ِ تهادَتْ بسمةٌ","بين النخيل ٍ تحضنُ الأعذاقا",39,"ق",2,0],["وعلى شيوخ القوم أعلى قدره","وسقاه من كأس الرضا حتى ارتوى",40,"و",2,0],["وعلى شواطئه الحزينة لا يرى","إلا أوار قاتل وأوام",41,"م",1,0],["وعلى شراعِ توهماتِ نضالِهِ","حَكَمتْ عليهِ إلى الخلودِ الداعمة",42,"م",2,0],["وعلى شان كلٍ يستمر بطريقه","وتبقى معرفتنا بوّد ونقاوه",43,"ا",3,0],["وعلى شمائلك اللواتى ما سمت","حتى ذَوَت من بعد حسن سُموقِ",44,"ق",1,0],["وعلى شبلك الإمام الرفاعي","أحمد القوم سيد الأولياء",45,"ا",2,0],["وعلى شواطيء زقزقاتِ نوارسِ ال","أحلامِ يُبْحرُ في سفينةِ عُمْرِهِ",46,"ر",2,0]]}