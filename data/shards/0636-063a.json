{"poems":[[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[27,"أمن عهد ذي عهد تفيض مدامع","https://www.aldiwan.net/poem5971.html","الطويل"],[27,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[85,"لما سمعت بنقطة","https://www.aldiwan.net/poem7576.html","مجزوء الكامل"],[28,"فقالوا له رد الحمار فإنه","https://www.aldiwan.net/poem5489.html","الطويل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[46,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[106,"الكادر","https://www.poetsgate.com/ViewPoem.aspx?id=179520",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[46,"ألا إنّ الظّباءَ لَفي غُرُورٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18254",""],[119,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[456,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[477,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"]],"verses":[["ضَغا قِردُكُم لَمّا اِختَطَفتُ فُؤادَهُ","وَلِاِبنِ وَثيلٍ كانَ خَدُّكَ أَضرَعا",0,"ع",2,0],["ضَغا القِردُ لَمّا مَسَّهُ الجَهدُ وَاِشتَكى","بَنو القَينِ مِنّا حَدَّ نابٍ وَكَلكَلِ",1,"ل",1,0],["ضَغا في القِدِّ آدَرُ تَغلِبِيٌّ","ضَبيحُ الجِلدِ مِن أَثَرِ الكُلومِ",2,"م",1,0],["ضَغا الشُعَراءُ حينَ رَأوا مُدِلّاً","إِذا اِمتَدَّ الأَعِنَّةُ ذا اِعتِزامِ",3,"م",1,0],["ضغن وحقد دائم","كانت لعيسى منه غنوة",4,"و",2,0],["ضَغا ضَغوَةً في البَحرِ لَمّا تَغَطمَطَت","عَلَيهِ أَعالي مَوجِهِ وَأَسافِلُه",5,"ل",2,0],["ضَغَمَتهُ فَتَآيا لَها","بِقَويمِ المَتنِ عارٍ حُسام",6,"م",1,0],["ضَغائِنُ لَمّ تَزَل مِن قِبَلِ نوحٍ","عَلى ما هانَ مِن فِزرٍ وَعَرجِ",7,"ج",1,0],["ضغطوا يؤذون وَقَد جهلوا","أن البركان سينفجر",8,"ر",1,0],["ضغينةٌ لم تدع الإماما","حتّى رمى في يدها الزّماما",9,"م",2,0],["ضَغائِنُ في هذا الزَمانِ عَلى الفَتى","فَمُستَقبلٌ مِن خَطبِهِنَّ وَماضِ",10,"ض",1,0],["ضغطوا «الكادِر» الجديد إلى أن","لبستهُ أعناقنا أطواقا",11,"ق",2,0],["ضَغَطَت هُنا كفٌّ على أزراره","تُنبي بخطبٍ في العراقِ فَظيع",12,"ع",1,0],["ضَغائنُ لم تزَلْ من قبل نُوحٍ،","على ما هانَ من فِرْزٍ وعَرْج",13,"ج",1,0],["ضغيغ دهر الأنام دهره ولها","ضغيغةٌ دهرها يريضها فَضَضَا",14,"ض",2,0],["ضُغِموا بنابٍ واحد ولطالما از","دردوا أراقمَ قبلها وأفاعيا",15,"ي",2,0],["ضغطت على رسغيهما ال","أشطان وانصدع الوتين",16,"ن",1,0]]}