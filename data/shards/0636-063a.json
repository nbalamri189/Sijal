{"poems":[[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[29,"أمن عهد ذي عهد تفيض مدامع","https://www.aldiwan.net/poem5971.html","الطويل"],[29,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[87,"لما سمعت بنقطة","https://www.aldiwan.net/poem7576.html","مجزوء الكامل"],[30,"فقالوا له رد الحمار فإنه","https://www.aldiwan.net/poem5489.html","الطويل"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[48,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[108,"الكادر","https://www.poetsgate.com/ViewPoem.aspx?id=179520",""],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[92,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[112,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[48,"ألا إنّ الظّباءَ لَفي غُرُورٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18254",""],[96,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[125,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[463,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[484,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105518","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93719","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204971","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87373","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140029","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62845","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117935","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131045",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40137","المتقارب"],[4973,"ثورة الاحرار","https://www.poetsgate.com/ViewPoem.aspx?id=189430",""],[5219,"اهات حرف","https://www.poetsgate.com/ViewPoem.aspx?id=194919",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5126,"زفرةُ أسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87804&r=&rc=19",""]],"verses":[["ضَغا قِردُكُم لَمّا اِختَطَفتُ فُؤادَهُ","وَلِاِبنِ وَثيلٍ كانَ خَدُّكَ أَضرَعا",0,"ع",2,0],["ضَغا القِردُ لَمّا مَسَّهُ الجَهدُ وَاِشتَكى","بَنو القَينِ مِنّا حَدَّ نابٍ وَكَلكَلِ",1,"ل",1,0],["ضَغا في القِدِّ آدَرُ تَغلِبِيٌّ","ضَبيحُ الجِلدِ مِن أَثَرِ الكُلومِ",2,"م",1,0],["ضَغا الشُعَراءُ حينَ رَأوا مُدِلّاً","إِذا اِمتَدَّ الأَعِنَّةُ ذا اِعتِزامِ",3,"م",1,0],["ضغن وحقد دائم","كانت لعيسى منه غنوة",4,"و",2,0],["ضَغا ضَغوَةً في البَحرِ لَمّا تَغَطمَطَت","عَلَيهِ أَعالي مَوجِهِ وَأَسافِلُه",5,"ل",2,0],["ضَغَمَتهُ فَتَآيا لَها","بِقَويمِ المَتنِ عارٍ حُسام",6,"م",1,0],["ضَغائِنُ لَمّ تَزَل مِن قِبَلِ نوحٍ","عَلى ما هانَ مِن فِزرٍ وَعَرجِ",7,"ج",1,0],["ضغطوا يؤذون وَقَد جهلوا","أن البركان سينفجر",8,"ر",1,0],["ضغينةٌ لم تدع الإماما","حتّى رمى في يدها الزّماما",9,"م",2,0],["ضَغائِنُ في هذا الزَمانِ عَلى الفَتى","فَمُستَقبلٌ مِن خَطبِهِنَّ وَماضِ",10,"ض",1,0],["ضغطوا «الكادِر» الجديد إلى أن","لبستهُ أعناقنا أطواقا",11,"ق",2,0],["ضغائن اللات والعزى رقلن بها","تحت الطليق وعثمانية الأشر",12,"ر",1,0],["ضَغَطَت هُنا كفٌّ على أزراره","تُنبي بخطبٍ في العراقِ فَظيع",13,"ع",1,0],["ضغطّتي .. وفجّّرس وأنتي تضغطين","والضغط.؟ من طبعه يولّد الانفجار",14,"ر",1,0],["ضَغائنُ لم تزَلْ من قبل نُوحٍ،","على ما هانَ من فِرْزٍ وعَرْج",15,"ج",1,0],["ضَغِينةٌ تتنزّى في جَوانِحِنا","ما كان أغناكمُ عنها وأغنانا",16,"ن",2,0],["ضغيغ دهر الأنام دهره ولها","ضغيغةٌ دهرها يريضها فَضَضَا",17,"ض",2,0],["ضُغِموا بنابٍ واحد ولطالما از","دردوا أراقمَ قبلها وأفاعيا",18,"ي",2,0],["ضغطت على رسغيهما ال","أشطان وانصدع الوتين",19,"ن",1,0],["ضَغْماً لِمَا نالَ وَخَلْباً عاقِرا","بِسَرْطَمَاتٍ تُحْسَبُ الخَناجِرا",20,"ر",2,0],["ضغائن أخفتها بطي بنودها","فأظهر ما تخفيه في طيها النشر",21,"ر",1,0],["ضَغاين شرك أَظهرتها أُميةٌ","وَكَم من عليٍّ في الصُدور ضغائن",22,"ن",1,0],["ضغوط على العقل والروح مني","وما تركت غير جسمي سقيما",23,"م",2,0],["ضَغا ظِلُّها من شِدَّة الخصب وارفاً","وَمثلَتِ الانوارَ منها الازاهرُ",24,"ر",1,0],["ضغائنُ أهل الشرك من أهل مكةٍ","ثنته على صُلح له اللّه ناقض",25,"ض",1,0],["ضَغَائنُ لو لم يُحْسِنِ السيفُ داءَها","لضرَّتْ وهلْ شيءٌ سِوى السيفِ يَنْفَعُ",26,"ع",1,0],["ضغائن ممّن أعلن الدين مكرها","ولولا العوالي لم يوحّد ويسلِم",27,"م",1,0],["ضغطت قلوبهم الخديعة فابتغوا","سبباً لمبرم عهدنا أن ينقضا",28,"ض",2,0],["ضغائن في سود الكلاب أمية","أكنت بها من بدر الغدر مضمرا",29,"ر",2,0],["ضغطوا عليه بكل ما في وسعهم","ليطيع منهم آثما وكفورا",30,"ر",2,0],["ضَغمْت فَأَدْرَرت أَفواهَها","وَسِرت فَقَلَّمت أَظفارَها",31,"ر",3,0],["ضغَطَ الزناد َ فغادرتهُ رصاصة ٌ","وصَلَتْ لقلب ِ الحاكم العثماني",32,"ن",2,0],["ضغائن زرعت في أنفس فنمت","ونقطف الشوك أحقادا به النقم",33,"م",1,0],["ضغط المكابح فجأة فترنحت","نحو اليمين هنيهة ثم الشمال",34,"ل",1,0],["ضغط الأسى قلباً كسيراً ماله","بكفاح أحداث الزمان يدانِ",35,"ن",1,1]]}