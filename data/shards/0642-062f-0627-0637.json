 الرأس عني راح وارتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=197713",""],[5431,"أحتاج عمرا كي أرى دمعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=191667",""],[5561,"حبٌّ في زمن الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=192736",""],[5691,"قمرٌ باهتٌ...وأرضٌ يبابُ !","https://www.poetsgate.com/ViewPoem.aspx?id=206523",""],[5736,"أسقام","https://www.poetsgate.com/ViewPoem.aspx?id=208879",""],[5781,"شفاهٌ عُرْضَةٌ للدفء","https://www.poetsgate.com/ViewPoem.aspx?id=202841",""],[5873,"إهداء عشية سجال","https://www.poetsgate.com/ViewPoem.aspx?id=215782",""],[5956,"رولانُ خففت الأسى عن جدِّها","https://www.poetsgate.com/ViewPoem.aspx?id=200899",""],[5956,"إلى كل بطل مجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202506",""],[5956,"ودّعتُ حبَّه مِن صَوبي","https://www.poetsgate.com/ViewPoem.aspx?id=204250",""],[5956,"لبّت مطالبَ أبِّها أنْؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=206255",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["قَد أَطعُنُ الطَعنَةَ النَجلاءَ عَن عُرُضٍ","تَصفَرُّ كَفُّ أَخيها وَهوَ مَنزوفُ",0,"ف",1,0],["قَد أَطفَأَتهُ كُراتٌ","ما مِن لَظاهُنَّ فَوتُ",1,"ت",1,0],["قَد أَطلُبُ الحاجَةَ القُصوى فَأَدرِكُها","وَلَستُ لِلجارَةِ الدُنيا بِزَوّارِ",2,"ر",1,0],["قد أطلتُ العتابَ جداً وأكثر","ت فضولي لكنَّ لي شركاءَ",3,"ا",2,0],["قَد أَطرُقُ الغادَةَ الحَسناءَ مُقتَدِراً","عَلى الشَبابِ فَتُصبيني وَأُصبيها",4,"ي",3,0],["قد أَطاعَتْكَ في العدوِّ المَنايا","وجرَتْ بالمُنى لك الأقدارُ",5,"ر",1,0],["قَدِ اِطمَأَنَّت عَلى الحِرمانِ أَنفُسُنا","فَلَيسَ لِلمَنعِ يَوماً عِندَنا أَثَرُ",6,"ر",1,1],["قَد أَطعَنُ الطَعنَةَ النَجلاءَ عَن عُرُضٍ","كَفَرجِ خَرقاءَ وَسطَ الدارِ مِسكينِ",7,"ن",1,1],["قَد أَطلَعَت إِبَرَ القُرونِ كَأَنَّها","أَخذُ المَراوِدِ مِن سَحيقِ الإِثمِدِ",8,"د",1,0],["قد أطفأُوا بالدُّهْمِ منها فجْرَهمْ","فتكوّرَتْ شمسُ النهار تغضُّبا",9,"ب",2,0],["قَد أَطلُبُ الحاجَةَ مِن مُشرِفٍ","مِن دونِها زَأرٌ وَتَنفيرُ",10,"ر",1,0],["قَد أَطبق الموت عيني","نِ من فتاة رداح",11,"ح",1,0],["قَدْ أَطْعَمَ السُّهْدَ مُقْلَتَيْهِ","وَأَقْلَقَ المَهْدَ بِالصِّفَاقِ",12,"ق",1,0],["قد اطَّرَدَت أنوارُهُ حولَ قصرهِ","وأشرقَ والتفّت عليه حدائِقُه",13,"ه",1,0],["قَد أَطلَعتني عَلى الأَشياء تَجربة","ما غادَرَت ليَ في شَيء إِذا أَربا",14,"ب",2,0],["قَد أَطمَع الفكر آمالي لِزورتِهِ","فَباتَ يَسهَر في أَجفانِيَ السَهَر",15,"ر",1,1],["قد أطلتمْ بعادَنا بَعْد قرب","ما علمتم عذَابنا في البِعادِ",16,"د",1,0],["قد أطرقوا مهابةً لو وقفت","طيرٌ على رؤوسهم لم تنفرِ",17,"ر",1,0],["قد أطفأ الغيظ فضل الاقتدار فلو","رأيت قتلهم فخرا قتلتهم",18,"م",1,0],["قد اطردت أرسانها وتنافست","كما اطردت في السمهري الأنايب",19,"ب",1,0],["قَد أَطلَقَ النَفسَ نَحوَ اللَّهِ فَاِنطَلَقَت","تَرجو لَها رَحمةٍ مِن عِندِهِ وَرِضى",20,"ض",2,0],["قَد أَطاعَتهُ شارِداتُ القَوافي","راشِداتٍ فَأَنطَقَت مَن عَصاها",21,"ا",3,0],["قَد أَطاعتهُ في منىً للمنايا","كيفَ تَعصيه للمُنى العقلاءُ",22,"ا",2,0],["قد أطعت الغرام وازددت منه","ليت شعري متى يكون المتاب",23,"ب",1,0],["قَد أَطفَأَت نورَ الرَجا","لَمّا غَدَوتَ بِهِ أَسير",24,"ر",1,0],["قد أطلت النوى فأضنيت جسمي","فمتى نلتقي وأين التلاقي",25,"ق",2,0],["قَد أَطالَ الفراقُ والبين أَسري","وَقَضى لي عنكَ البعادُ بهجرِ",26,"ر",1,0],["قد أَطلتم مطلَ المحبِّين فاِقضوا","دَين صَبٍّ أَذقتموه مَنونَه",27,"ن",2,0],["قَد أَطَعتُ الهَوى فَكانَ هَوانا","وَمُطيعُ الهَوى حَليفَ النَدامَه",28,"م",2,0],["قَد أَطَعنا بِكَ الهَوى وَعَصينا","مَن عَن الراح راح يظهر عذلا",29,"ل",2,0],["قد أَطال انتظاريَ الدَّهرُ والطّا","لبُ للشّيءِ قد يُطيلُ انتِظاره",30,"ر",2,0],["قد أطْلعَتْ غابة الإِقبال ليثَ شرى","مرامه بقرين السَّعدِ مقرونُ",31,"ن",1,0],["قَد أَطلَقَ المَهدِيُّ لي لِساني","وَشَدَّ أَزري ما بِهِ حَباني",32,"ن",2,0],["قد أطال الهجر عمدا","وغدا بالصد يمرح",33,"ح",1,0],["قد أطلعت للورد خداً أحمراً","وأضحكت للنوْرِ ثغراً ناصعا",34,"ع",2,0],["قد أطمعَ الناس كفي عن هجائهمُ","فكُلُّهمْ جائرٌ في حكمهِ جاني",35,"ن",2,1],["قد أطبق النسْيانُ يوماً عليْ","كِ جفنَهُ وصار كالمنزلِ",36,"ل",1,0],["قد أطلت نجمةٌ","في سماءِ العائله",37,"ه",1,0],["قد أطلَقوا في الأديبِ سمَّ ألسُنِهم","ولم يُزاحمهم في جَمعِ دينار",38,"ر",1,0],["قد أطعتُمْ وما أطعْ","تُ نَموماً مبلّغا",39,"غ",2,0],["قَدِ اِطَّلَعتَ عَلى سِرّي وَإِعلاني","فَإِذهَب لِشَأنِكَ لَيسَ الجَهلُ مِن شاني",40,"ن",2,1],["قد أطلقَ اللحظَ في لفظٍ يُحرِّفُهُ","فراحتِ الرُوحُ بينَ الكَلْمِ والكَلِمِ",41,"م",1,0],["قد أطعَمَتْهُ بما أرضاهُ عن كَثَبٍ","سُهولةُ الظَرْفِ فاقتادَتْهُ كالنَّعَمِ",41,"م",1,0],["قد أطالت فينا الظُنونُ الأمانيْ","يَ وعندَ القضاءِ صحَّ اليقينُ",42,"ن",1,0],["قَد أُطيعُ الخَليلَ ما لَم أَرَ العَج","زَ وَأَعلو بَعدَ السُهوبِ سُهوبا",43,"ب",2,0],["قد أطربت أنيّ أنغام له","أحلى من الترتيل والإنشاد",44,"د",1,0],["قد أطلتم في العذلِ والتنقيدِ","بِهوى السيّدِ الإمامِ السّديدِ",45,"د",1,1],["قد أطربته حتى","يعرق في الأسار",46,"ر",1,0],["قد أطلعَ الغيثُ في سماهُ","نجومَ وردٍ وياسمينِ",47,"ن",1,0],["قد أطلعَ التوفيقَ صبحُ جبينهِ","في ليلِ أليلِ شعرهِ مُتألِّقا",48,"ق",2,0],["قد اطلعك اللّه بين قوسك بدراً","لا زلت منيراً بهم وهم لك افلاك",49,"ك",1,0],["قَد أَطرَبَتني وَاِبتَهَجتُ مَسرَّةً","إِذْ حَلَّ قَلبي الأنسُ مِن أَصواتِها",50,"ت",3,0],["قَد أَطارَ الحَبيبُ ماءَ حَياتي","وَهوَ روحٌ بِهِ حَياةُ النُّفوسِ",51,"س",1,1],["قد اطلعت من كل معنى","في سماء علاك نجما",52,"م",2,0],["قد أطلعت للراح فوق يمِينه","وجبينه نار وصبح مُشرق",53,"ق",1,0],["قد اطمأنت به نفس الفخار وقد","جرت بساحته الأعداء أردانا",54,"ن",2,0],["قد أطرحوا لبس الدروع لأنهم","لهم من زكيات المناصب أذرع",55,"ع",1,0],["قَد أطلتُ القول جهرا","في الهوى نظماً ونثرا",56,"ر",2,0],["قَد أَطلَعَتكَ سَما المَعالي كَوكَباً","بِجَبين مصر لامِعاً في الأُمةِ",57,"ه",1,0],["قد أطال الزمان شقوة حر","لست ترضى له بجد شقي",58,"ي",1,0],["قد أطلعتْ من عِنان الراح طلعتَها","وأَنطقتْ أَلْسُنَ العيدانِ والناءِ",59,"ا",2,0],["قد اطلق البين بين الناس غربانا","نعيبها افعم الاكباد احزانا",60,"ن",2,1],["قد اطمعتك محبتي فهجرتني","وبعدت بعد النوم عن اجفاني",61,"ن",2,0],["قد أطالت مُقلتاك بلا","سببٍ تعذيبَ مهجتهِ",62,"ت",2,0],["قد أطلع المجدُ في أُفق العُلى قمراً","يا فرحة الشهب لو تغدو له خدما",63,"م",2,0],["قَد أطَلتِ المُكوثَ عِندي فَهَيّا","غادِري مَضجَعي وَلا تُزعِجيني",64,"ن",2,0],["قد أطيلتْ قوادمُ اللَّكْنِ للجا","هل لكنْ جناحيَ المحصوصُ",65,"ص",1,1],["قد أطاعوا الرحمنَ في كلِّ أمرٍ","وبأمر العزيز يجري القضاء",66,"ا",2,0],["قد أطرقَت بتفكُّرٍ عَيناهُ","وتقلَّصَت لتبسُّمٍ شَفَتاهُ",67,"ا",2,0],["قد أطلع اللَه من آفاقكم قمراً","نارت بطلعته الأحياء والبيد",68,"د",1,0],["قد أطربتني سجاياه فقمت بها","على رياض القوافي شاعراً غردا",69,"د",2,0],["قد أطعناه يقيناً إنه","في غد من لهب النار يقينا",70,"ن",2,0],["قد أطعنا غيَّ الشَّباب بجهلٍ","فاعفُ عنَّا يا واسع الغفران",71,"ن",1,0],["قد أطرب الدهر زفاف لكم","فيه اقتران الشمس والبدر بدا",72,"د",2,0],["قد أطلتَ الملام وهو عذابٌ","ليتَ أن الصعيدَ يملؤ فاكا",73,"ك",2,0],["قد أطلع اللَه في سعد السعود سنى","بدر بلألائه ابيضت لياليها",74,"ي",3,0],["قد أطنب العذال في قصتي","وأكثروا في القيل والقال",75,"ل",1,0],["قد أطلت من شبابيك السديم لترانا","أينما نحن نقيم",76,"م",1,0],["قد أطلعت ليلاً بمشرق أنسها","شمسين من ساق وكاس عقار",77,"ر",1,0],["قد أطلت السؤال عنه فهل نل","ت جواباً للسائل الحيران",78,"ن",1,0],["قد أطنبوا قوم بحسنك أغربوا","ولعارض أن أطنبوا أو أغربوا",79,"ب",3,0],["قد اطبَّاني رشأ مهفهفٌ","احوى الجفون اختشي برائقه",80,"ق",2,1],["قد اطبقت ظلماؤه كأنما","عمود مصباح الصباح انحطما",81,"م",2,0],["قد أطلّت عليّ صبحاً لقتلي","فأحالت ليَ الصباح مساءَ",82,"ا",2,0],["قَد أَطرَب الكَون حَتّى مالَ من طَرب","قَول المُبشر بَعدَ اليَأس بِالفَرَج",83,"ج",1,0],["قد أطلعت فيها الذئاب رؤوسها","مذ أسلمتها منكم الآساد",84,"د",1,0],["قد أطلق العاني وفك اساره","فإلام يبقي وهو في أغلاله",85,"ل",2,0],["قد أطفأ الرحمن نور حظوظهم","لما تألق حظك الموهوب",86,"ب",1,0],["قد اطرقوا رهبا حيالك وانثنوا","جزعا وساؤا بعد موتك حالا",87,"ل",2,0],["قد أطعن الطعنة النجلاء أتبعها","طرفا شديدا إذا ما يشخص البصر",88,"ر",1,0],["قد أطمعتني فيه رقةُ خدّه","لو أمكنتني فيه رقة دينه",89,"ن",2,0],["قد أطلت المقام في دار ذل","كيف ترضى المقام فيها طويلا",90,"ل",2,0],["قد أطرب الأسماع من تحبيره","وبديعه ما استحلت الأذواق",91,"ق",1,0],["قد أطرح الناس العلى وطلابها","سواه فأضحى دائناً ومدانا",92,"ن",2,0],["قد أطلنا بالباب أمسِ القعودا","وجُفِينا به جفاءً شديدا",93,"د",2,1],["قد أطلعت شمس الطلى","منه بليل الجعد بدرا",94,"ر",2,0],["قد أَطلَقَت عَينُهُ عُيوناً","وَطَلَّقَت فيكُمُ الهُجوعَا",95,"ع",2,0],["قد أطلعت بسما القلوب هلالها","ولذاك تعملُ نحوها إهلالها",96,"ل",3,0],["قد أطار َ الهوى فؤادي فمازال","بجو ِّ الهوى يطير ويمرحْ",97,"ح",1,0],["قدْ أطلق المهديُّ لي لساني","وشدَّ أزري ما به حبابي",98,"ي",1,0],["قد أطرحوا لبس الدروع كأنما","لهم من زكيات المناصب أدرع",99,"ع",1,0],["قد اطّرحوا لبس الدروع كأنها","لهم من زكيات المناصب أدرعُ",100,"ع",1,0],["قد أطلقَ الحُزنُ رمحاً في الدُّنا عجِلاً .","فجاء دونَ عِباد اللهِ فيَّ أنا .",101,"ن",2,0],["قد أطلق الدستور عن أبوابه","فانحوه فهو محجةٌ بيضاء",102,"ا",2,0],["قد أطنبت برواج السوق عندك ف","قال وسفرٌ لسوءِ الحال فقالُ",103,"ل",1,0],["قد أطَلَّتْ مِنْ عُشِّهَا دُونَ قَصْدٍ","غَادةٌ تَتركُ الذَّكِيَّ بَلِيْدا",104,"د",2,0],["قد اطفأت بالبعد شمس نهارنا","فكأننا بدجى الكآبة نغرقُ",105,"ق",1,0],["قد أطفأ اللهُ نارَ الفرسِ فانتصرت","للحقِّ راياتُ عزٍَ شاءَ ما كانا",106,"ن",2,0],["قد أطرق الرأس عني راح وارتحلا","والعقل والقلب في هجرانه اقتتلا",107,"ل",2,1],["قد أطعم النيران من كبد النوى","ولكم يطيب إلى الهوى رجعهْ",108,"ع",2,0],["قد أطلقتْ لزمامها مُرَّ العنا","سيّانَ عندَكَ سانحٌ أو بارحُ",109,"ح",1,0],["قدْ أطلَّتْ منْ فوقِ أسْوارِها","العوْسَجُ والياسَمينُ واللبْلابُ !",110,"ب",1,0],["قد أطربوا مسمعي بالعزف منفردا","لحن الهلاك لكي بالكيد أحتضرا",111,"ر",2,0],["قَدْ أطْرَبَ الوَجْدَ بَوْحٌ ما أُحَيُلاهُ","تَشْدو لُحونًا بِسِحْر الشَّرْقِ عيْناهُ",112,"ا",2,1],["قد أطربت سمعي روائع سحرها","أنفاسها أرج الورود الفائحة",113,"ح",2,0],["قد أطربَتْ أسماعنا بحديثها","شدْواً يضافُ إلى بحور الشِّعْرِ",114,"ر",1,0],["قد أطفأوا إحدى المَجَرَّات التي","لابد منها في السُّرى للعالي",115,"ل",2,0],["قد أطلقَ الحبَّ لحظاتٍ معدَّدةً","وبعد ذلكمُ الشيطانُ كبَّلَهُ..",116,"ل",2,0],["قد أطعمته مآكلا خلابة","هي: شنجليشٌ، كِبّة ، زيتونُ",117,"ن",1,0],["قد أطعمته مقادماً مع كرشة","وجرى السِّجِقُّ إلى الطحال يُعينُ",117,"ن",1,0],["قدْ أطعموا النارَ التي بزنادهم","مَليونَ قُرْبانٍ مِنَ البُسطاء ِ",118,"ا",2,0],["قد أطافت به الفضائل حتى","ضقن ذرعا بهن ست جهانه",119,"ه",1,0],["قَد أَطلَقَ الأَصحابُ أَرجُلَهُمْ","لِلرِّيحِ ؛ مِثلَ كُرَيَّةِ \" التِّنسِ \"",120,"س",1,0],["قد أطلنا الرحيلَ حتى انتهينا","فبُهِتنا!!...قَدِ انتهينا رحيلا",121,"ل",2,0]]}