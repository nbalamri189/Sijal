d=192736",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5776,"نهرٌ سماويّ","https://www.poetsgate.com/ViewPoem.aspx?id=205833",""],[5956,"الرَّنين","https://www.poetsgate.com/ViewPoem.aspx?id=184781",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6093,"أشجار أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=196883",""],[6124,"أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=174686",""],[242,"وافى الأصيل مذهب الأطواق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563756",""],[5080,"من يصطفي جسد الرّحيل مواظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88142&r=&rc=12",""],[5080,"أشجرت ذاتك في أحشاء تربته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88137&r=&rc=7",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""]],"verses":[["أَشَجَتْكَ رَنَّاتٌ بِهَا","نَبَرُوا وَقَدْ فَصَلُوا الْخِطَابَا",0,"ب",2,0],["أَشَجَاكُمْ كَمَانُ سَامٍ وَأَلْعَا","بُ المَفَاتِيحِ فِيهِ وَالأقفالِ",1,"ل",1,0],["أشجَتْكَ أطلال لخو","لةَ كالمَهَارِق دُرَّسُ",2,"س",1,1],["أَشَجَتْكَ منزلةٌ بمَرجَيْ راهِطِ","كلّا ولا دِمنٌ عفتْ بشلاهِط",3,"ط",1,1],["أشجتك داعية مع الإشراقِ","هتفت بساق في ذؤابة ساقِ",4,"ق",1,1],["أَشجى وَأُرمى بِوَجدٍ مُنصِبٍ وَهَوىً","مُبَرِّحِ الخَبلِ في شاجي وَفي رامي",5,"م",2,0],["أَشجَتكَ بِالتَغريبِ في تَغريدِها","فَظَنَنتَ مَعبَدَ كانَ بَعضَ عَبيدِها",6,"د",3,1],["أشجارُ لوزٍ تنادي","أمري على الخُلْفِ جارِ",7,"ر",1,1],["أَشجَعَ مِن عادي عَرينَ الأُسدِ","تَرى الدَجاجَ حَولَهُ كَالجُندِ",8,"د",1,0],["أشجَعُ مَنْ قَلّبَ خَطّيّةً","على طَويلِ الباعِ مُمْتَدّهِ",9,"د",2,0],["أَشَجاكَ الرَبعُ أَم قِدَمُه","أَم رَمادٌ دارِسٌ حُمَمُه",10,"م",2,1],["أَشجي فؤادي موقف","جمع الزَئير إلى البغام",11,"م",1,0],["أشجاه منظرها فأسبل عبرة","وَمشى يردد زفرة الوَلهان",12,"ن",1,0],["اشجاك أنك رائح لا ترجع","وهواك والأوطان بعدك بلقع",13,"ع",1,1],["اشجارها العقول وهي لا خفا","دقائق العلوم من اثمارها",14,"ر",3,0],["أشَجَتك رُؤيا يا أخا الجُلمُودِ","رُفِعت لطَرفِك من مكانٍ قاصِ",15,"ص",1,0],["أشجانهُ قيّضت له تلفا","فصار يدعى قتيل أشجانه",16,"ن",2,0],["أشجاكِ منذُ هُنَيهَةٍ نوحي","وأشجاني نواحُكِ فاسمَعي تغريدي",17,"د",2,0],["أشجى الرفاقَ تأوّهي وتوَجّعي","وتمنّعي عن شُربها في المقوعِ",18,"ع",1,1],["أَشجارُهُ ذاهِبَةٌ في الفَضا","يَروعُ مِنها ذلِكَ المَنظَرُ",19,"ر",1,0],["أَشجاعُ حُقَّ لَنا بِأَن","نَهجو الزَمانَ وَأَنَّ نسبَه",20,"ب",2,0],["أُشجي بِها الحَكَمِيَّ لَو حاكَمتُهُ","لَكِن تَعَذَّرَ بَينَنا مَن يَحكُمُ",21,"م",1,0],["أَشْجَى بِبَهْجَتِهِ الْهَزَارَ وَغُصْتَهُ","فَشَدا وَمَاسَ وَذِي حُلَى الْعُشَّاقِ",22,"ق",1,0],["أَشُجُّ بِها إِذا الظَلماءُ أَلقَت","مَراسِيَها وَأَردَفَها دُجاها",23,"ا",3,0],["أشجَاكِ نورُ النّجمةِ الزهراءِ","فَبَكيتِ من ذكرى حبيبٍ ناءِ",24,"ا",2,1],["أَشجارُهُ كَعَرائِسٍ تَختالُ بَي","نَ غَلائِلٍ مِن نَورِهِ وَتَبَرَّجُ",25,"ج",1,0],["أَشْجاك أَنْ تُمسي الجنانُ بها لظىً","وتبيت داراتُ النَّعيمِ مَراقدا",26,"د",2,0],["أشجارُها كعرائسٍ","متضمِّخات بالعبير",27,"ر",1,0],["أَشجى المزابرَ وَالمنابرَ فَاِغتَدت","أَوتادُ قاعٍ بالأسى مَسجوجه",28,"ج",2,0],["أشجِعْ بقَلْبي حين تَرشُقُه","لو أنّ صُدْغَك فوقَه حَلَق",29,"ق",1,0],["أشجاك تيار سيلٍ جارفٍ وأنا","سيلُ المواجعِ والآلامِ أشجاني",30,"ن",2,0],["أَشُجُّ بِهَا والليلُ مُرْخٍ سُدُولَه","سَبَارِيتَ أَرضٍ لا يُرَاعُ قطاها",31,"ا",3,0],["أشجارها تحجب دون لوم","في الصيف وهج الشمس كل يوم",32,"م",1,0],["أشْجَى من الدنيا بحبِّ مقلِّبٍ","وجهين عُرفُ وفائه إِنكارُ",33,"ر",1,0],["اُشجُعْ وجُدْ تحْظَ بفخريهما","فكلُّ ما قَدَّرهُ اللّهُ كانْ",34,"ن",1,0],["أَشجارُهُ وَثِمارُهُ","مِثلُ التَرائِب وَالمَخانِق",35,"ق",1,0],["أَشجارُهُ وَنَسيمُهُ","مِثلُ المَشاجِبِ وَالبُخورِ",36,"ر",1,0],["أشجاكَ قمريُّ الأراك مغرِّدا","والليلُ قد خلعَ الرداءَ الأسودا",37,"د",2,1],["أشجى النفوس إذا ما","جرّ المغاني وأجرى",38,"ر",2,0],["أشجارُ كذْبٍ تُغاثُ كلّما ذبلتْ","بكذبةٍ يستظلُّ تحتها النّزِقُ",39,"ق",1,0],["أَشَجاكَ الرَبعُ أَقوى وَالدِيارُ","وَبُكاءُ المَرءِ لِلرَبعِ خَسارُ",40,"ر",1,1],["أشجاره نحن اللحا","ء لها الملائم والنجب",41,"ب",1,0],["أَشجعُ القوم فيهمُ جاعلُ الدِّرْ","عِ هُروباً أَو الفرارِ مجَنَّا",42,"ن",2,0],["اشجيتِ كل الخلق اشجاء به","ذكر الليالي الماضيات متيم",43,"م",1,0],["أشجار حبي عاريات الغصون","جرداء إِلا من معاني الذبول",44,"ل",1,0],["أَشْجَى مسامِعَهُمْ تِيْهاً بما سَمِعُوا","ولا تَقَرُّ لهمْ عَيْنٌ إِذا قرأوا",45,"ا",1,0],["أشجى النبي المصطفى ووصيه","وابنيهما والطهر بنت المرسل",46,"ل",1,0],["أشجاره طابتْ وطابت جنيً","فيه نخيلُ الفَرْضِ والساير",47,"ر",1,0],["أشجارُ هذي الأرضِ خلفك قد مشت","مدت إليكَ عروقَها والأغصُنا",48,"ن",2,0],["أشجع من قلَّبت أنامله","بيضا وهزت خطية سمرا",49,"ر",2,0],["أشجع من خالد في مأزق","وأبرع الناس غداة الجدال",50,"ل",1,0],["أشجع من قلبت أنامله","رمحا طويلاً أو مرهقا باتر",51,"ر",1,0],["أشجع من يخطر بالرمح في","يوم وغى أسمر خطارا",52,"ر",2,0],["أشجع من جال يوم حرب","على طري نهدٍ عتيقِ",53,"ق",1,0],["أَشجاكَ لعاتكةٍ طللُ","مثل ما لاح للناظرِ الخللُ",54,"ل",1,1],["أشجاهُ حادثُ دهرهِ أم هاجهُ","رسمٌ عفا مغناهُ من نزّالهِ",55,"ل",2,0],["أَشْجَعُ مِنْ ذِي لِبَدٍ بِخَبْتِ","يَدُقُّ صُلْبَاتِ العِظامِ رَفْتِي",56,"ت",2,0],["أَشْجَعُ مِجْذَامٌ إِذَا لَمْ تَغْفرِ","وَإِنْ غَفَرْتَ الذَنْبَ لِلْمُسْتَغْفِرِ",57,"ر",1,0],["اشجي فوادي بالسماع حديثهم","فلي الهنا اني سمعت بمسمعي",58,"ع",2,0],["أشجاك ما خلف الستار وإنما","خلف الستائر لؤلؤٌ مكنونُ",59,"ن",1,1],["أشجتك شمس ملاحة","في غيهب الليل استنارت",60,"ت",1,1],["أشجاكَ والله يغفر له","سويجعَ الطير في الأغصان",61,"ن",1,1],["أَشجاكَ أَنَّكَ قَد شُغِفتَ بَوَردَةٍ","غَذَّيتَها بِفُؤادِكَ المُتَقَطِّعِ",62,"ع",1,0],["أشجع من قلب خطيب على","كواهل للباع ممتده",63,"د",2,0],["أشجارها نوعان منها ما له","في هذه الدنيا مثال ذان",64,"ن",1,0],["أشجى الورى يوم رحلت به","كالحشر لا بل قل هو الحشر",65,"ر",1,0],["أَشجَعَ مِن لَيثِ عَرينٍ خادِرِ","ذاكَ عَلَيَّ ذو النَوالِ الغامِرِ",66,"ر",1,0],["أشجى بهم وأداريهم على مضض","والصقر يكأب بين البوم والرخم",67,"م",1,0],["أشجى الورى فكأنهم أبناؤه","وكأنه وهو العطوف أبالها",68,"ل",3,0],["أشجَارَهَا في قُربٍ برِّعَارُوَه","وَخَلفَ ذَا بَطنٌ فَلاَ تُمَارِيَه",69,"ه",1,0],["أشجارها كالعذراى في ملاحتها","خضر النضيرات من سقى البساتين",70,"ن",1,0],["أشجاك رسم الدار مالك مولع","أم هل شجاك بسفح رامة مربعُ",71,"ع",1,1],["أشجى الحمائم رقة نوحي ومن","قد لامني فيك وما أشجاك",72,"ك",1,0],["أَشجارُ قَفرِ الفَلا لَبَّتهُ ناهِضَةً","وَالطَيرُ تَأتيهِ صافّاتٍ وَقابِضَةً",73,"ه",1,0],["أشجى بني الدنيا وضعضع منهم","طوداً بعيد مدىً عزيز مرام",74,"م",1,0],["أَشجُّ مجهولَهَا وأَلحبُها","بطائشِ اللبِّ حلمُه نَزَقُ",75,"ق",1,0],["أشجع النفس على حربكم","تقاضيا والسلم يزويها",76,"ي",3,1],["اشجى بذكراك القلوبَ وان تكن","بعظيم رزئك ما لها خبر",77,"ر",1,0],["أشجع الناس من يجود بذا اليو","م فيخشى فقرَ النوال الأنام",78,"م",1,0],["أشجع الناس من يجود بذا اليو","م فما للمولى الجميلِ ذمام",78,"م",1,0],["أشجارها خضر واوجه أهلها","صفر محى كف السقام بهاها",79,"ا",3,0],["أَشَجَتكَ أَطيارُ الأَراكةِ تَسجعُ","أَم راقَ أَعينَك السحائبُ تَهمعُ",80,"ع",1,1],["أشجاك جعدة إذ نادى فوارِسه","حاموا عن الدين والدنيا فما وقفوا",81,"ف",3,0],["أشجَاكَ رَبْعٌ بالصَّفيحةِ مائحُ","عاف فَدْمعُك فوقَ خدك سافحُ",82,"ح",1,1],["أَشُجُّ بِهِ رُؤوسَ البيدِ شَجّاً","إِذا ما الآلُ أَلوى بِالرعانِ",83,"ن",1,0],["أَشجَت لهاةَ البِرنْسِ هَبوَتَها","وَكَم عَتا عاتِياً فَأَشجاها",84,"ا",1,0],["أَشجارُها تَنَوَّعَت أَزهارُها","غَنى عَلى أَفانِها هَزارُها",85,"ه",2,0],["اشجع الناسف ي الحروب لمن يذ","كر عذراً أحيا من العذراء",86,"ا",2,0],["أَشجارُ خطٍّ إن تشاجرت العدى","أَضحتْ لها هاماتُ مُخيطهم ثمر",87,"ر",1,0],["اشجى تميم بن مرّ لا مكايدة","حتى استعادوا له أسرى وانعاما",88,"م",2,0],["أَشجاك مُجتمَعٌ عَفَت آياته","وَتعاورته شَمالُه وَقَبولهُ",89,"ل",2,0],["أشجى الجهات الستَّ إذ زعزع السبَ","بع الأقاليم فلم تهجع",90,"ع",1,0],["أشجع من عيينة في أشجع","حابس مجد حابس والأقرع",91,"ع",1,0],["أشجت قوافيّ السعيدة طفلةٌ","حرفي كنايٍ والقصائد عودُ",92,"د",1,0],["اشجان في قلبي ولاني بقاويها","واشواق في وسط الشرايين مدفونه",93,"ن",2,0],["أشجارها الخضراء باسقة","في كل غصن فاتن خضعا",94,"ع",2,0],["أشجاه نوح حمامات فصاغ لَهَا","من أسود الْعين يَوْم الْبَين أطواقا",95,"ق",2,0],["أشجار علم عروضٍ بعد ثامنةٍ","من رائع الفكر والإبداع تسقيه",96,"ي",2,0],["أَشْجَارُهَا الْتَحَمَتْ بَالظِّلِ وَارِفَةٌ","وَالْعُشْبُ غَطَّى رِيَاضاً تَحْتَهَا وَسُفُوحْ",97,"ح",1,0],["أشجع الناس من الحرب اشتهى","وإذا واقف قرنا ما سها",98,"ه",2,1],["أشجى بها الشهداء بين قبورهم","وأثار شجو الليل في الغابات",99,"ت",1,0],["أشجارُك َ احترقت بماء ِ وعودِهم","وضلالُك َ انصهرت ْ ولومُك َ فاسد ُ",100,"د",1,0],["أشجارُ الحبِّ أعانقها","سيقانُ الحبِّ ليَ المُهَرُ",101,"ر",1,0],["أشجارُ وصلي على أرضِ النوى ذبلتْ","هلّا زرعنا على الأشجارَ أغصانا؟",102,"ن",2,0],["١٥-أ شجباً فعلتم وها قد رأيتم","قبابي وساحي برجسٍ تُطال",103,"ل",1,0],["اشجو لشجو حبيبتي قيدَ النوى","دون الغياب مع النوى تتكسّرُ",104,"ر",1,0],["أشجو عليهم بكاءً زادني ولعاً","بالذكرياتِ وهم في لحنها الكلمُ",105,"م",1,0],["أشجارُكَ الجَرداءُ يجهَلُها","صوتُ الهَزار وخضرةُالفَنَن ِ",106,"ن",1,0],["أشجاكَ في ذكرِ الأحبَةِ صادحُ","وغشاكَ من فيضِ الموَدَّةِ قارحُ",107,"ح",1,1],["اشجاه شادٍ تغنّى في الحجون اسى","اذكاهُ حزناً كسوط النار لهّابِ",108,"ب",1,0],["أشْجارُهم في مجرّاتٍ قد اتسعتْ","وأصلُها ثابتٌ يُدعى اليمانينا",109,"ن",2,0],["أشجاني تَلِدُ الأشجاناْ","ألحاني تُذكي الأحزانا",110,"ا",1,0],["أَشَجاً يُغَاديها إذا هيَ أَصْبَحَتْ","وأسىً يراوحُها لَدَى إمسائها",111,"ا",3,0],["أشجيت قلب المصطفى بالمرتضى","فأذقت فيه الفخر طعم ذعاق",112,"ق",1,0],["أشجار أشجان بشعرك طلعها","وجذور عشق في الحشا تتمدد",113,"د",1,1],["أشجانُ الليلِ تواتيني","تنسجُ ثوبَ الحزنِ على البابِ",114,"ب",1,1],["أَشجى بِبَهجَتِهِ الهَزارَ وَغُصنَهُ","فَشَدا وَمالَ وَذي حَلى العُشّاقِ",115,"ق",1,0],["أشجيتُ قافلةَ الرحيلِ بغنوةٍ","فلعلها اتخذتْ رؤايَ مواكبا",116,"ب",2,0],["أشجرتَ ذاتك في أحشاء تُربتِهِ","ورحتُ تفصح عمرا في نبوءته",117,"ت",2,1],["أشجارٌ تهذي.. ناقوسٌ","مِنْ غيمٍ.. وحطامٍ خالبْ",118,"ب",1,0]]}