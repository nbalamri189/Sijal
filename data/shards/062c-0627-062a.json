{"poems":[[119,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77565","المجتث"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136816",""],[4702,"الشعب في غلاف الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=155323",""],[4726,"ام ذي عقود في سموط بلاغة","https://www.poetsgate.com/ViewPoem.aspx?id=146657",""],[4747,"رسالة إلى صدام","https://www.poetsgate.com/ViewPoem.aspx?id=17213",""],[4750,"زيارة","https://www.poetsgate.com/ViewPoem.aspx?id=180413",""],[4750,"بسم رحمن ٍ رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=180427",""],[4788,"وجدي على الراحه وجود ام الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=132265",""],[4797,"هجن الرئاسة","https://www.poetsgate.com/ViewPoem.aspx?id=133829",""],[4816,"باقي الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=8451",""],[4816,"ملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=8490",""],[5055,"القاعه","https://www.poetsgate.com/ViewPoem.aspx?id=103541",""],[5122,"ذرب القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=17648",""],[5488,"تجنّب رذال الناس يا نسل الأجواد","https://www.poetsgate.com/ViewPoem.aspx?id=100729",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5739,"فرقى بعز .. ولا مذلة تعالي ..!","https://www.poetsgate.com/ViewPoem.aspx?id=135075",""],[5739,"اغراب لكن .....!","https://www.poetsgate.com/ViewPoem.aspx?id=145119",""],[5747,"البث المباشر","https://www.poetsgate.com/ViewPoem.aspx?id=61658",""]],"verses":[["جأت لنا عنه آيات الهدى حكما","تنظم الدر فيها واليواقيت",0,"ت",1,0],["جات مزاياه عن مدحي فصرت اذا","رمت الغلو أراها عنه في شعم",1,"م",1,0],["جاتوت يا لَيتَ رُمّان","كُله مسوِّس وَخاوي",2,"ي",1,0],["جآت لتفصيل بين ما قد لا يرى","أو ما يرى من فلك بالروية",3,"ه",1,0],["جات بأسرار ذي قد لي ليالي بهم عد","بعد وهده فقام الروح فيها مهدد",4,"د",1,0],["جاتك علوم عنا من وكيل ووزير","صورة الشعب حلوة في غلاف الكتاب",5,"ب",1,0],["جآتني غيداء المديح تميس في","برد المحبة بالطراز المعلم",6,"م",1,0],["جاته من الغرب عبر اجواء صديق (ن) له","تحمل على متنها حزنه وسلاله",7,"ل",2,0],["جات قُدم الليل والصبح سابقها","نوّها الصافي حجب شمسها عنّا",8,"ن",2,1],["جاته الأسياد تعطيه الولا ومبايعنيه","بعد شافوا ضرب أبو تركي ومركاض العبيّه",9,"ي",2,0],["جات المنيّه في وجه رجّالها","والبارحه يبغى يشوف ولادها",10,"د",3,0],["جات الذياب اللي تعاوى من عصر","وقامت على راسه تقيم أعيادها",10,"د",3,0],["جاتك اللي كلها غارب وجوف","جايعة ركظ وعلى السبقه ظمية",11,"ي",2,0],["جاتك الذيبة نعامية وصوف","حايرة بين السما والجاذبية",11,"ي",2,0],["جاتني مواعيدك على رمشة العين","لاسلهمت تسرح بها الروح وترد",12,"د",1,1],["جات شاعر من مشاعرهم نجوى وإغتراب","ليل وسهاد وتجافي والخوافق مقلمة",13,"م",2,0],["جاتني منهم ولاء الطاعة","عن مسافر نازل إجيها",14,"ي",3,0],["جاتك تحلى بجزل الشعر وجداده","خواطر ..جزلتن ذربات وسماني",15,"ن",2,0],["جاتك نتيّه تسير فالشعر نقّاد","شبه الزمرد في حروزٍ جدادي",16,"د",2,0],["جات العلل لا قلت منهم تعافيت","يدمون قلبي كل ماقلت عوفي",17,"ف",2,0],["جاتك حروف ٍ واضحه ماتنكر.","فرقى بعز ....... ولا مذلة تعالي.",18,"ل",2,0],["جاتك حروفي كلها ورد واعناب.","مشاعر ٍ متعطره بالصراحه.!",19,"ح",2,0],["جات القوافي شرّدٍ بلسان شاعرها الفصيح","تحمل مضامين الخبر واخبار لندن ذاعته",20,"ت",2,1]]}