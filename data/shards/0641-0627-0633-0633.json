{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86670","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141194","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122455","الوافر"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106741","الوافر"],[402,"بدا نور صبح بالهدى متنفس","https://www.poetsgate.com/ViewPoem.aspx?id=36000",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""]],"verses":[["فَأَسَّسْنَ فَخْراً لِلبِلاَدِ مُجَدَّداً","وَهَلْ يَثْبُتُ البُنْيَانُ غَيْرَ مُؤسَّسِ",0,"س",1,0],["فَأَسّس بالسعدينِ أَوتادَ عزّه","وَفرّق بِالنحسينِ من ضدّه الشعبا",1,"ب",2,0],["فَأَسس بِالتَقوى حُصوناً عَديدةً","بِثَاني جَمادى بَعد إِبداء دَعوة",2,"ه",1,0],["فأسست السؤال لمن تكلم","ودلست الجواب لكي يسلم",3,"م",1,0],["فَأسِّسَت المَلاَجِىءُ بِالنَّوَاحِي","وَهُيىءَ للضَّعِيفِ بِهِنَّ مَهدُ",4,"د",1,0],["فَاسَّس للهُدى ركناً شَديداً","وآل الكُفرُ مِنهُ لِلزَوالِ",5,"ل",1,0],["فأسسن فخرا للبلاد مجددا","وهي يثبت البنبان غير مؤسس",6,"س",1,0],["فأسس جرم الكون عن أصل عالم الت","تقادير لم يخطئ مواقع حكمتي",7,"ت",2,0],["فأسَّس في صغار النا","س روحانية الكُبَرا",8,"ر",2,0]]}