{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[85,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[52,"يا عبد ضاق بحبكم جلدي","https://www.aldiwan.net/poem63920.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142025","الكامل"],[108,"تغريدات الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=179704",""],[199,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[203,"يا للغرام ويا لعز بنانه","https://www.aldiwan.net/poem45225.html","الكامل"],[226,"أيهما كان الظلوم البليد","https://www.aldiwan.net/poem55291.html","المتقارب"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[382,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[409,"وافى إلى سوح الأمير","https://www.aldiwan.net/poem33909.html","مجزوء الكامل"],[487,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[519,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[580,"سمراء إلا رقة الأسمر","https://www.aldiwan.net/poem2947.html","السريع"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96298","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95557","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120739","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199930","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126274","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108220","الكامل"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205636","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92381","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205553",""],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203269","السريع"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99109","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204179","الكامل"],[3591,"أهلاًٍ بطلعة وجهك المتهلّل","https://www.poetsgate.com/ViewPoem.aspx?id=149437",""],[5106,"هَٰذَا الحَبِيْبُ مِنَ العِرَاق","https://www.poetsgate.com/ViewPoem.aspx?id=150031",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5187,"زورق الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29708",""],[5277,"أملٌ لَحوح","https://www.poetsgate.com/ViewPoem.aspx?id=191905",""],[5285,"باقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203581",""],[5324,"شهادة في حضرة الحب .","https://www.poetsgate.com/ViewPoem.aspx?id=207309",""],[5556,"لاتنس من لم ينس ذكرك أحمدا","https://www.poetsgate.com/ViewPoem.aspx?id=181204",""],[5574,"مشاهداتٌ من روضةِ الباري","https://www.poetsgate.com/ViewPoem.aspx?id=206021",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5853,"كلاسيكية على جدار التجريد","https://www.poetsgate.com/ViewPoem.aspx?id=175721",""],[5957,"ولماذا الساعة لا تعمل؟","https://www.poetsgate.com/ViewPoem.aspx?id=181672",""],[6213,"ميناء المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76248&r=&rc=5",""]],"verses":[["كالزَّهَرِ المَطْلولِ أخْلاقُهُ","والرّوْضُ مَشْمولٌ ومَجْنوبُ",0,"ب",1,0],["كالزَهر في لألائه والبدر في","عليائه والزُّهر في الإِبْراقِ",1,"ق",1,0],["كالزَّهر في إيراقهِ والبدر في","إشراقه والزُّهر في لألاءِ",2,"ا",2,0],["كالزَّهْرِ في تَرَفٍ والبَدْرٍ في شَرَفٍ","والبَحْر في كَرَمٍ والدَّهْرِ في هَمَمِ",3,"م",1,0],["كَالزَمهَريرِ يَكونُ صائِفَةً","وَهَوى المُعانِقِ لَيلَةَ الصَرَدِ",4,"د",1,0],["كَالزَّهْرِ خَامَرَهُ النَّدَى فَتَأَرَّجَتْ","أَنْفَاسُهُ بِالْعَنْبَرِ الْمُتَضَوِّعِ",5,"ع",1,0],["كالزهرِ مات مكَفّناً بأريجهِ","ووَسيمِ نصرتِهِ ونشوَةِ طثهرِهِ",6,"ه",1,0],["كالزَّهرِ، إلا أنّه خالدٌ","مثلَ خُلودِ الهرم الأكبر",7,"ر",1,0],["كَالزينِ في وَجهِ العَروسِ تَبَذَّلَت","بَعدَ الحَياءِ فَلا عَبَت أَرآدَها",8,"د",3,0],["كالزهرِ في أغصانهِ والنجمِ في","آفاقهِ والدرُّ في صدفاتهِ",9,"ت",2,0],["كالزهرة قد ألقيت في الثرى","ومنهتعفر بخد وجيد",10,"د",1,0],["كَالزَندِ بِالقَدَحِ إِن أَوروهُ يَشتَعِلِ","وَخَلِّ نُصحَكَ لا تَصرِفُهُ في هَزَلٍ",11,"ل",1,0],["كالزورق الهيمان ضل","لَ طريقه وخبا الشعاع",12,"ع",1,0],["كالزهر يبدو للعيون مورَّداً","بيننا تراه يميس غضّاً ييبس",13,"س",1,0],["كالزُّهر أو كالزَّهْرِ لا","ما للزواهر والزُّهور",14,"ر",1,0],["كالزاهر الدكناء والظهران والت","تنعيمِ والزوراء ثم الفيد",15,"د",1,0],["كالزَّنْدِ يُلهِبُه الحديدُ بقَرْعِهِ","فيكادُ يوري البأس من أعضائِهِ",16,"ا",3,0],["كالزَّهْرةِ الغرَّاءِ لكنها","ما نظرتْ قطُّ إِلى المُشْتَرِي",17,"ر",2,0],["كالزَّنبريِّ تقاذَفَتهُ لُجَّة","يَصدَ عَنها بكلا كِل وهوادي",18,"د",2,0],["كَالزَّهْرِ في تَرَفٍ وَالظَّبْيِ فِي غَيَدٍ","وَالزُّهْر فِي شَرَفٍ وَالغُصْنِ فِي لِينِ",19,"ن",1,0],["كالزائر البستان يج","نى أطيب الثمر النضيد",20,"د",1,0],["كآل زُرارة نكحوا بجهل","بناتَهم بكسرى مُقتدينا",21,"ن",2,0],["كَالزَّرعِ يَنبُتُ حَولَهُ دَغَلٌ فَيَم","نَعُهُ النَّمَا فَتَرَاهُ ذَا نُقصَانِ",22,"ن",1,0],["كالزبد لينا في نعومة ملمس","أصداف در دورت بوزان",22,"ن",1,0],["كالزهرِ لكن لا أقولُ لنُورِها","كالزهرِ لكن لَم يُشقَ بنطاقِ",23,"ق",1,1],["كالزهر جاد علينا بالشذى كرما","والنجم شع على ذي مقلة وعَم",24,"م",1,0],["كالزهر في ترف وَالبدر في شرف","قد جل عن صلف وازداد في شمم",25,"م",1,0],["كَالزَهر في تَرف وَالبدر في شَرَف","إِن شبهت ذاته وَالوَجه مِن قدم",26,"م",1,0],["كالزهر ما ان شمت نجما غاربا","الا ونجم اثره يتألق",27,"ق",1,0],["كالزرع للرجل فوقه عملٌ","إن ينم حسن النمو في قضبه",28,"ب",2,0],["كالزهر توضع في المياه إذا ذوت","فتعود زاهيةً كمثل الأول",29,"ل",1,0],["كالزهر إلا أنه لم يستنم","إلا بغصن ذابلٍ لم يورق",30,"ق",1,0],["كالزهر مبتسماً كالغصن منعطفا","غمزُ الحَواجب يهدينا لمطلبهِ",31,"ه",1,0],["كالزهرة الحسناء أو","كالغصن في الروض انعطفْ",32,"ف",1,0],["كالزرد المنظوم أصداغه","وخده كالورد لما ورد",33,"د",1,1],["كالزبرقان تهافتت أنواره","ليلاً بمضطرب الخليج السابح",34,"ح",1,0],["كالزئبق الفرار ينظره ولا","يستطيع يمسك من قفاه صوفا",35,"ف",2,0],["كالزهرة الزهراء أنت لديهم","مسعودة بالمشتري وعطارد",36,"د",1,0],["كالزهر فتّح ردنه وشقيقه","في جنبه يزهو ولمّا يذبل",37,"ل",1,0],["كَالزَّهْرِ .. كَالأَنسَامِ .. كَالعِطْرِ المُفَرْ","رِطِ بِالأَنَاقَةِ .. كَالنَّدَىْ .. طَرِبَاً شَجِيَّا",38,"ي",2,0],["كالزهرة الزهراء يلمع نورها","يستعصم القاضي به والداني",39,"ن",2,0],["كالزهر في تَرَف والبدر في شرف","والمزن في وكف والنوء في ديم",40,"م",1,0],["كالزَّورقِ تاهَ بلا مرسىً","في عمق الرُّعبِ الغدّارِ",41,"ر",1,0],["كالزمهريرَ يكظُّ رجفةَ مهجتي","وتحيلني قِطَعاً من الأحزانِ",42,"ن",1,0],["كالزهرةِ البيضاءِ فاضَ بهاؤها","لتنيرَ درباً شائكاً وطويلا",43,"ل",2,0],["كالزهرة الفيحاء يقطر عطرها","للنا شقين.. وجرحها أدماها",44,"ا",3,0],["كالزهر يسقى الزهر صيب أفقها","فيعود منه نشره متصعدا",45,"د",2,0],["١- كالزّهْرِ في وجهِ الرّبيعِ المُنشدِ","بِيضُ الحجيجِ تلألأتْ كالعسْجدِ",46,"د",1,1],["كالزَّهَرِ الناعِفِ ماءً وفي","أعطافهنَّ العطرُ مِنهُنَّ ذِيقْ",47,"ق",1,0],["كالزهرةِ الحمراء تعبق طيبها","إن شمّها المشتاق ترتاح الأنا",48,"ن",2,0],["كالزهرة ِ يسمو برباها","بعروق الوردة يتغلغل",49,"ل",1,0],["كالزورق الأسمى يميس شراعه","أمل يلوح بأرض ميناء المطر",50,"ر",1,0]]}