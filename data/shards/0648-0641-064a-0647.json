عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[458,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[458,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[461,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[461,"اذا ما انتدى حلت عليه مهابة","https://www.aldiwan.net/poem15483.html","الطويل"],[464,"أخل الظبي واصلاً والظبي","https://www.aldiwan.net/poem3268.html","عموديه"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[468,"وهيف عليها معلمات القراطق","https://www.aldiwan.net/poem59812.html","الطويل"],[477,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[495,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[498,"مها القفر لا دمية المرمر","https://www.aldiwan.net/poem3704.html","المتقارب"],[500,"محمد مثالها الفرداني","https://www.aldiwan.net/poem37767.html","الرجز"],[500,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[505,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[536,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[551,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[551,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[551,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[551,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[551,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[558,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[558,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[558,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[558,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"أصابع الغيب فينا حركت عوده","https://www.aldiwan.net/poem34566.html","البسيط"],[558,"هو الله ربي هو المبتدا","https://www.aldiwan.net/poem34598.html","المتقارب"],[558,"يا حسن بستان في اللوان اسمه البرج","https://www.aldiwan.net/poem34686.html","المواليا"],[559,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لقد طهر الرحمان آل محمد","https://www.aldiwan.net/poem3643.html","الطويل"],[575,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[575,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[587,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["وَفيها القُضُبُ الرَيّان الن","نَدى وَالقُضُبُ الجَذلُ",0,"ل",1,0],["وَفيهم كُلُّ واضِحَةِ المُحَيّا","كأَنَّ وِشاحَها قَلِقاً وِسادي",1,"ي",1,0],["وَفيهِم مِن ظِباءِ الإِنسِ غيدٌ","عَفائِفُ لا يَطورُ بِها أَثامُ",2,"م",1,0],["وَفيها عَفَّةُ الخَلَواتِ خَوْدٌ","مَنيعَةُ ما يُصافِحُهُ الخِدامُ",2,"م",1,0],["وَفيهنَّ مِقلاقُ الوِشاحِ إِذا مَشَتْ","وَأَثقَلَها الرِّدفانِ خَفَّ بِها الخَصرُ",3,"ر",1,0],["وَفِيها سُرُورُ النَّفْسِ وَاليُسْرُ جَاذِبٌ","بِضَبْعِي وَإِنْ أَعْسَرْتُ فَهْيَ هُمومُ",4,"م",1,0],["وَفِيهِنَّ هِنْدٌ وَهْيَ خَوْدٌ غَزيرةٌ","وَمُنْيَةُ نَفْسِي دونَ أَتْرابِها هِنْدُ",5,"د",1,0],["وَفي هَمَلانِ العَينِ أَعدَلُ شاهِدٍ","عَلى غَيبِ ما يُخفي الضَّميرُ مِنَ الوَجدِ",6,"د",1,0],["وَفيها إِذا ما هَجَّرَت عَجرَفِيَّةٌ","إِذا خِلتَ حِرباءَ الظَهيرَةِ أَصيَدا",7,"د",2,0],["وَفيهِ هَوى عَبدُ العَزيزِ وَعَرشُهُ","وَأَخنى عَلَيهِ الدَهرُ وَالأَمرُ مُدبِرُ",8,"ر",1,0],["وَفيهِ نَمَت في الهِندِ لِلعِلمِ نَهضَةٌ","أَرى تَحتَها سِرّاً خَفِيّاً سَيَظهَرُ",8,"ر",1,0],["وَفيهِ بَدَت في أُفقِ جاوَةَ لَمعَةٌ","أَضاءَت لِأَهليها السَبيلَ فَبَكَّروا",8,"ر",3,0],["وَفيهِ سَرَت في مِصرَ روحٌ جَديدَةٌ","مُبارَكَةٌ مِن غَيرَةٍ تَتَسَعَّرُ",8,"ر",1,0],["وَفيها وَفي نيلِها سَلوَةٌ","لِكُلِّ غَريبٍ رَمَتهُ النَوى",9,"ا",1,0],["وَفيها غِذاءٌ لِأَهلِ العُقول","إِذا الرَأسُ إِثرَ كَلالٍ خَوى",9,"ا",1,0],["وفِيهِ القَطَا والبُومُ وابنُ حبَوكَلِ","وطَيرُ القَطاطِ والبَلندَدُ والحَجَل",10,"ل",1,0],["وَفيهِنَّ أَشباهُ المَها رَعَتِ المَلا","نَواعِمُ بيضٌ في الهَوى غَيرُ خُرَّعِ",11,"ع",1,0],["وَفيها عَلى أَنَّ الفُؤادَ يُحِبُّها","صُدودٌ إِذا لاقَيتُها وَذِرارُ",12,"ر",1,0],["وَفِي هَذَا التَّنَافُسِ كلُّ خَيرٍ","يُرَجَّى لِلْحَضارَةِ وَالرُّقِيِّ",13,"ي",1,0],["وَفيهِ عُيوبٌ لَيسَ يُحصى عِدادُها","فَأَصغَرُها عَيباً يَجِلُّ عَنِ الكُفرِ",14,"ر",1,0],["وفيها على ضعف الجوارح جرأة","يزيد بها فوق الوجوه طلوعها",15,"ع",3,0],["وفيهم كان للأوطان حبّ","وفي أوطانهم منهم رجاء",16,"ا",2,0],["وَفِيهم نُجُومُ النَّاسِ والمُهتَدى بِهِم","إِذا اللَّيلُ أمسَى وهو بالنَّاسِ أَليَلُ",17,"ل",1,0],["وفيه سَرائر أَفشيتُهنَّ","إليكَ وكاتمتهُنَّ الحِجابا",18,"ب",2,0],["وفيه مَعْ ما قد تجاوزْتُهُ","خزيٌ طويلٌ غير مُستوعبِ",19,"ب",1,0],["وفيها لمن قدَّمْتُ ذكراه مَلْبَسٌ","تظلُّ به والطَّرفُ نَحْوك أقْوَدُ",20,"د",1,0],["وفيه ما يأخذ التخيُّرُ من","غالٍ ثمينٍ وفيه ما يَذر",21,"ر",1,0],["وفيهم مذاقان للذائقي","ن حلوٌ لذيذٌ ومرٌّ بشِع",22,"ع",1,0],["وفي هذه الدنيا عصائبُ لم تزل","لخطة ضيم لا لحقٍّ خنوعها",23,"ع",3,0],["وفيه فرصةٌ لك فانتهزْها","فإن اللَّه يكبتُ حاسديكا",24,"ك",2,0],["وفي هذه كلُّ اشتطاطِ وإنها","لتعظُمُ إلا عندَ كلّ جليل",25,"ل",1,0],["وفيه أشياءُ صالحاتٌ","حَماكَها الله والرسولُ",26,"ل",1,0],["وفيه لعينَيْ ناظرٍ متوسَّمٌ","شهودٌ وأعلامٌ من الفضلِ مُثّلُ",27,"ل",1,0],["وفي هذه من دعوةٍ لي شِرْكةٌ","ولا بأس قد يدعو الصديقُ مقاسما",28,"م",2,0],["وفي هذا الأوان وفي نُهاهُ","شواغلُ عن صِبَى ذاك الأوان",29,"ن",1,0],["وَفيهِ بُؤسي وَفيهِ نُعمى","وَأَردِياءٌ وَأَتقِياء",30,"ا",2,0],["وَفيها مِنَ الشَيخِ الحَكيمِ وَقارُهُ","وَفيها مِنَ الخودِ المَلاحَة وَالطُهرُ",31,"ر",1,0],["وَفيهِم كُلُّ ذي حُسنٍ","مِنَ الإِحسانِ مَوفورِ",32,"ر",1,0],["وفيها تَمِيسُ عذارى السَّماءِ","عواريَ يُنْشِدْنَ لحناً بَديعْ",33,"ع",1,0],["وفيها البَديعُ وفيها الشَّنيعُ","وفيها الوديعُ وفيها العنيدْ",34,"د",1,0],["وَفيها السَلامُ الوَطيدُ البِناءِ","لِمَن آثَرَ السِلمَ أَو يُؤثِرُ",35,"ر",1,0],["وَفيهِ رِقَّةُ القَلبِ","لِآلامِ بَني الجِنسِ",36,"س",1,0],["وَفيهِ هِمَّةُ نَفسٍ زانَها خُلُقٌ","هُما لِباغي المَعالي خَيرُ مِنوالِ",37,"ل",1,0],["وَفيهِ أَلوِيَةٌ عَزَّ الجِهادُ بِهِم","لَولا المَنِيَّةِ ما مالوا وَلا رَقَدوا",38,"د",3,0],["وَفيها اللِواءُ وَفيها المَنا","رُ وَفيها التَبيعُ وَفيها النَبي",39,"ب",2,0],["وَفيها المُؤَخَّرُ خَلفَ الزِحا","مِ وَفيها المُقَدَّمُ في المَوكِبِ",39,"ب",1,0],["وَفي هَذا الزَمانِ مَسيحُ عِلمٍ","يَرُدُّ عَلى بَني الأُمَمِ الشَبابا",40,"ب",2,0],["وفيه مجرى الطباق السبع حالته","طورا وحالته بالنجم الزهر",41,"ر",1,0],["وَفيها ما تَرُدُّ بِهِ ال","ظَماءَ وَتُذهِبُ السَغَبا",42,"ب",2,0],["وَفيهِ عَتبٌ نَفى نَومي وَوَكَّلَني","مِنَ الهُمومِ بِرَعيِ الكَوكَبِ الساري",43,"ر",2,0],["وَفيهِ النَبِيُّ المُصطَفى وَعَلِيُّهُ","وَعَبّاسُهُ وَجَعفَراهُ وَقاسِمُه",44,"م",2,0],["وَفيها بَنو الحَربِ الَّتي يُتَّقى بِها","وَغاها إِذا ما الحَربُ جاشَت شِعابُها",45,"ب",3,0],["وَفيهِمِ مائَتا أَلفٍ فَوارِسُهُم","وَحَرشَفٌ كَجُشاءِ اللَيلِ إِذ زَخَرا",46,"ر",2,0],["وَفيهِم مَقاماتٌ حِسانٌ وُجوهُهُم","وَأَندِيَةٌ يَنتابُها القَولُ وَالفِعلُ",47,"ل",1,0],["وَفيهِنَّ مَلهىً لِلصَديقِ وَمَنظَرٌ","أَنيقٌ لِعَينِ الناظِرِ المُتَوَسِّمِ",48,"م",1,0],["وَفيهِنّ مَن تَأتيهِ وَهوَ مُيَسَّرٌ","فَيُصبِحُ لا يَملُكُ عَليقَ حِمارِهِ",49,"ر",2,0],["وَفيهِنّ مَن لا بَيَّضَ اللَهُ عَرضَها","إِذا غابَ عَنها الشَخصُ طَلَّت لِجارِهِ",49,"ر",2,0],["وَفيهِنَّ نِسوَةٌ يخربُ كَعبُها","وَفيهِنَّ مَن تُغنيهِ عِندَ اِفتقارِهِ",49,"ر",2,0],["وفيهِ الصلاةُ وفيهِ الزكاةُ","وفيهِ الوصايا وفيهِ الجهادُ",50,"د",1,0],["وفيهِ القطعُ والوصلُ","وفيهِ الرفعُ والخفضُ",51,"ض",1,0],["وفيه ظبيٌ يقولُ شيئاً","وأغيدٌ لا يقولُ شيئا",52,"ا",2,0],["وَفيهِنَّ مِن نُجلِ النِساءِ نَجيبَةٌ","تَكادُ عَلى غُرِّ السَحابِ تَروقُ",53,"ق",1,0],["وفيها رسولُ اللهِ والنَّفَرُ الأُلى","يَهُونُ عليهم أن تَهُولَ الوقائِعُ",54,"ع",1,0],["وفيه من التُّقى ما ليس يَخفى","وما حاولتُ ترجمةً ووصفا",55,"ف",2,0],["وَفيها لَحمُ ساهِرَةٍ وَبَحرٍ","وَما فاهوا بِهِ لَهُمُ مُقيمُ",56,"م",1,0],["وَفيها مِن أَرومَتِهِ عِيالٌ","لَديهِ لا الظِماءُ وَلا السِغابُ",57,"ب",1,0],["وَفيها مِن عِبادِ اللَهِ قَومٌ","مَلائِكُ ذُلِّلوا وَهُمُ صِعابُ",57,"ب",1,0],["وَفِيهم حُرَّةٌ مُبَتَّلَةٌ","مَهضُومَةُ الكَشحِ ما لَها مَثَلُ",58,"ل",1,0],["وَفيهِم أَلعَسٌ أَغيَ","دُ ساجي الطَرفِ وَسنانُ",59,"ن",1,0],["وَفِيها عُصْبَةُ لا خَيرَ فِيهِمْ","عَلَى كُلِّ الوَرَى يَتَعَصَّبُونا",60,"ن",2,0],["وَفيها رَعاكَ اللَهُ عَنكَ تَثاقُلٌ","وَما ذاكَ إِلّا أَنَّها فيكَ زاهِدُ",61,"د",1,0],["وَفيهِ مِنَ طَريفِ النَب","تِ وَالأَزهارِ أَلوانُ",62,"ن",1,0],["وَفي هَذِهِ الأَرضِ الرَكودِ مَنابِتٌ","فَمِنها عَلَندى ساطِعٌ وَكِباءُ",63,"ب",3,0],["وَفيه غياض إن ولجت بها وَلَم","يدلك دارٍ بالطَريق تضيع",64,"ع",1,0],["وفيهِ تهْمسُ أرواحٌ وأفئدةٌ","منهن عانٍ ورَحمنٌ وجبَّارُ",65,"ر",1,0],["وفيهم جراءةُ مستأسدٍ","تحدَّى المنيةَ باسمِ الشجاعهْ",66,"ه",1,0],["وفيهِمِ البِيضُ أدْمَتْها أساوِرُها","رَمْيَ الأساوِرِ إجْلاً حارَ مَبْغوتا",67,"ت",2,0],["وفيه أَيضاً يدخُلُ المُذالُ","مُقَيِّداً في كلِّ ما يُقالُ",68,"ل",1,0],["وَفيهِم كُلُّ جَبّارٍ عَنيدٍ","شَديدِ البَأسِ مَفتولِ السِبالِ",69,"ل",1,0],["وَفِيهِمْ أَوَّلاً سَامٍ","وَفِيهِمْ ثانِياً فِكْرِي",70,"ر",2,0],["وفيها جسمه انصبَّ انصبابًا","فما تدري الثياب من الإِهاب",71,"ب",1,0],["وفيها بات يطمع مَنْ إذَا مَا","رأى الأهرامَ أدركه دُوَار!",72,"ر",1,0],["وفيه لكل محزون مكانٌ","وفيه لكل مكروب مجال؟",73,"ل",1,0],["وفيهِمْ حسينٌ قِبلةُ الناس أصيدٌ","إذا ما مَشَى والصِيدُ فاتَ وغبَّرا",74,"ر",2,0],["وفيه القَطاَ والبومُ وابن حبَوْكَل","وطيرُ القطاطى واليَلندَدُ والحَجَل