{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[63,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[72,"شكت من شيبتي عين الفتاة","https://www.aldiwan.net/poem18402.html","الوافر"],[72,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[58,"آلى ابن عبد حين جاء محاربا","https://www.aldiwan.net/poem31190.html","الكامل"],[66,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[97,"يا سجين الحياة أين الفرار","https://www.aldiwan.net/poem24992.html","الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[74,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141023",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[3,"عفتِ الديارَ وباقي الأطلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10735&r=&rc=89",""]],"verses":[["وَعَفَّرَ فُرسانَ العِدا وَدِماؤُهُم","جَوامِدُ ما بَينَ اللِحى وَالعَمائِمِ",0,"م",1,0],["وَعِفنا القاعَ نَسكُنُهُ وَمِلنا","عَنِ السَمُراتِ وَالنَعَمِ المِراحِ",1,"ح",1,0],["وَعَفا اليَومَ عَلى كَر","رَي قِطارٍ وَجَنوبِ",2,"ب",1,0],["وعِفْتُ ثَراءً دونَه يَدُ باخِلٍ","إذا لَم أصُنْ عِرضي فلا حَبّذا المالُ",3,"ل",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَه","تَردادُ وَكفِ العارِضِ الهَطّالِ",4,"ل",1,0],["وَعَفَفْتَ حَتَّى عَنْ خَيَالٍ طَارِقٍ","وَوَهَبْتَ حَتَّى أَعْذَرَ اسْتِجْدَاءُ",5,"ا",2,0],["وَعَفوٌ عَن مُسيئِهِمُ وَصَفحٌ","يَعودُ بِهِ إِذا غَلِقَ الحُجولُ",6,"ل",1,0],["وعفت الظبيَ أيضاً لا لفكرٍ","يطالبنا الوداد بلا التفات",7,"ت",1,0],["وعفو يقول لساري الذنو","ب إلى جبلِ الحلم يا ساريه",8,"ي",2,0],["وعفا نُبوُّك عن وَلِّيك إنه","أحدوثةٌ في جانبيْ بغدادِ",9,"د",1,0],["وعفافٍ في القلبِ والطَّرفِ والأط","رافِ عن كل مَحرمٍ ممنوعِ",10,"ع",1,0],["وعفا الثَرى عن حُرّ وجهٍ لم يزلْ","حُرَّ اللقاء إذا عرا السؤّالُ",11,"ل",1,0],["وعفا وعامَل بالأَناةِ عَدُوَّه","فكأنه لاهٍ وليس بلاهي",12,"ه",2,0],["وَعَفَّيتَ مِنهُم بَعدَ آثارِ فِتنَةٍ","وَأَحيَيتَ باباً لِلنَدى كانَ خاوِيا",13,"ي",2,0],["وَعَفَت قُبورُ الفاتِحينَ وَفُضَّ عَن","حُفَرِ الخَلائِفِ جَندَلٌ وَرِجامُ",14,"م",1,0],["وَعَفا الطِرادُ فَلا سِنانٌ راعِفٌ","فَوقَ القَناةِ وَلا حُسامٌ يَلمَعُ",15,"ع",1,0],["وَعَفَوتَ عَفواً عَمَّ أُمَّةَ أَحمَدٍ","في الغَربِ مِن أَوطانِهِم وَالمَشرِقِ",16,"ق",1,0],["وَعِفْتَ العارَ إلا عَيْرَ أُنْسٍ","تَخُرُّ له إذا أَدلى صَريعا",17,"ع",2,0],["وعَفا فردَّ البِيضَ في أغمادِها","وسَطا فَعلَّ متونَها بخِضابِ",18,"ب",1,0],["وَعَفَفتُ عَن اَثوابِهِ وَلَوَ اَنَّني","كُنتُ المُقَطَّرَ بَزَّني أَثوابي",19,"ي",1,0],["وَعِفتُ حِسابَهُم وَالأَصلُ عِندي","وَفي كَفَّيَّ دَستورُ البَقايا",20,"ا",3,0],["وعفا القيد عنك كفاً وساقا","فإذا الأرض كلها لك دار",21,"ر",1,0],["وعفافٌ لو كان في الأرض عادتْ","كلَّ عظم من الدفين ولحمِ",22,"م",1,0],["وَعِفّةُ سيفٍ ليس يبْرُقُ بالرّدى","إذا سلّهُ إلّا على رأس ظالمِ",23,"م",1,0],["وَعِفَّةُ نَفْسٍ لا تُزَنُّ بِرِيبَةٍ","وَجُودٌ بِهِ ظَلَّتْ عُفَاةُ النَّدَى تَرْوَى",24,"و",2,0],["وعفْتُ شرابَ أمداحي فلما","وجدتُكَ أهلَها حَسُنَ امتداحي",25,"ح",2,0],["وعفْتُ بني الدنيا وغادرْتُ برَّهُمْ","لغيري فلا أشكو ولا أتعتَّبُ",26,"ب",1,0],["وعَفَّرْتُ خَدِّي بحيثُ استراحَ","خَدٌّ تَفَرَّى ولم يَضْرَعِ",27,"ع",1,0],["وَعِفتُ كَراهَةً لِلشَيءِ شَيئاً","يَكونُ لَهُ شَبيهاً أَو نَسيبا",28,"ب",2,0],["وَعَفَت مِنَ الدُنيا الفَضائِلُ وَاِنمَحَت","أَعقابُها وَبَقِيَّةُ الآثارِ",29,"ر",1,0],["وعفا الطّراد فلا سنانٌ راعفٌ","فوق القناة ولا سنانٌ يلمع",30,"ع",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَها","تَردادُ وَكفِ العارِضِ الهَطّالِ",31,"ل",1,0],["وَعَفَا حَدِيثٌ كَانَ فِي","أَسْمَاعِنَا سِحْراً حَلاَلاَ",32,"ل",2,0],["وَعَفَا ذَكَاءٌ بَاهِرٌ","يَجْلُو الظَّلاَمَ إِذَا تَلاَلاَ",32,"ل",2,0],["وَعَفَا اللهُ عَنْكُمُ وَوَقَاكُمْ","فِي بَنِيكُمْ وَمَالِكُمْ أَنْ تُضَامُوا",33,"م",3,0],["وَعَفَتْ مَعَاهِدُ بَطشِهِمْ أَوْ أَوْشَكَتْ","وَهَوَتْ صُرُوحُ العِزَّةِ الْقَعْساءِ",34,"ا",2,0],["وَعَفا كَما يَعفو السَحابُ وَرَعدُهُ","قَصِفٌ وَبارِقُهُ حَريقٌ مُشعَلُ",35,"ل",1,0],["وعِفْنَا ورودَ الماءِ أكدرَ آسناً","وحنّتْ حنايانا لعذب المناهل",36,"ل",1,0],["وعفَتْ كأن لم يمشِ في ارجائها","\" عيسى \" ، و\" أحمدُ \" لم يَطِرْ محمولا",37,"ل",2,0],["وعفا مَغانِيَها فأَخْلقَ رسْمِها","تردادُ وكفِ العارضِ الهطال",38,"ل",1,0]]}