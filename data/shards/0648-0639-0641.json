{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[63,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[72,"شكت من شيبتي عين الفتاة","https://www.aldiwan.net/poem18402.html","الوافر"],[72,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[58,"آلى ابن عبد حين جاء محاربا","https://www.aldiwan.net/poem31190.html","الكامل"],[66,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[97,"يا سجين الحياة أين الفرار","https://www.aldiwan.net/poem24992.html","الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[74,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141023",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[94,"يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=15656",""],[3,"عفتِ الديارَ وباقي الأطلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10735&r=&rc=89",""],[125,"مللت عمري وملا","https://www.aldiwan.net/poem23806.html","مجزوء الكامل"],[129,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[136,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[144,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[151,"أصخ فلخير العالمين مناقب","https://www.aldiwan.net/poem68460.html","الطويل"],[151,"ماذا أقول ولا عتب على القدر","https://www.aldiwan.net/poem68476.html","البسيط"],[153,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[161,"بك للأماني موعد لم يخلف","https://www.aldiwan.net/poem58928.html","الكامل"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[170,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[183,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[187,"ولي هر رميت به خبيث","https://www.aldiwan.net/poem43306.html","الوافر"],[187,"غلام كان يعشق وهو علق","https://www.aldiwan.net/poem43596.html","الوافر"],[187,"ألم تر فعلة ابن الياس يوما","https://www.aldiwan.net/poem43951.html","الوافر"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[194,"هل إلى سلوة وصبر سبيل","https://www.aldiwan.net/poem13106.html","الخفيف"],[222,"يا خليلا أجل كل خليل","https://www.aldiwan.net/poem55251.html","الخفيف"],[242,"العيد أقبل باسم الثغر","https://www.aldiwan.net/poem45767.html","الكامل"],[298,"إلهي أنت ذو فضل","https://www.aldiwan.net/poem33141.html","الوافر"],[298,"مثال نعل رسول الله ذي الكرم","https://www.aldiwan.net/poem33178.html","البسيط"],[298,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[304,"رأيته بعد حين من ملاحته","https://www.aldiwan.net/poem57928.html","البسيط"],[306,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[310,"ولم يمرر به يوم فظيع","https://www.aldiwan.net/poem50239.html","الوافر"],[331,"سالمت قومي بعد طول مظاظة","https://www.aldiwan.net/poem550.html",""],[343,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[343,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[365,"محلك سام والعلاء به اعتكف","https://www.aldiwan.net/poem60840.html","الطويل"],[381,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[381,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[392,"كلام الناس ما له راس فاترك","https://www.aldiwan.net/poem54556.html","عموديه"],[392,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[403,"من ذا إلى عدله أنهي شكاياتي","https://www.aldiwan.net/poem47013.html","البسيط"],[404,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[417,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[433,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[435,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[438,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[440,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[454,"يا نجمة في الأفق","https://www.aldiwan.net/poem61564.html","مجزوء الرجز"],[459,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[459,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[465,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[539,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[552,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[559,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"],[559,"إن هذا بعض ما قد ظهرا","https://www.aldiwan.net/poem34511.html","الرمل"],[576,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[576,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["وَعَفَّرَ فُرسانَ العِدا وَدِماؤُهُم","جَوامِدُ ما بَينَ اللِحى وَالعَمائِمِ",0,"م",1,0],["وَعِفنا القاعَ نَسكُنُهُ وَمِلنا","عَنِ السَمُراتِ وَالنَعَمِ المِراحِ",1,"ح",1,0],["وَعَفا اليَومَ عَلى كَر","رَي قِطارٍ وَجَنوبِ",2,"ب",1,0],["وعِفْتُ ثَراءً دونَه يَدُ باخِلٍ","إذا لَم أصُنْ عِرضي فلا حَبّذا المالُ",3,"ل",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَه","تَردادُ وَكفِ العارِضِ الهَطّالِ",4,"ل",1,0],["وَعَفَفْتَ حَتَّى عَنْ خَيَالٍ طَارِقٍ","وَوَهَبْتَ حَتَّى أَعْذَرَ اسْتِجْدَاءُ",5,"ا",2,0],["وَعَفوٌ عَن مُسيئِهِمُ وَصَفحٌ","يَعودُ بِهِ إِذا غَلِقَ الحُجولُ",6,"ل",1,0],["وعفت الظبيَ أيضاً لا لفكرٍ","يطالبنا الوداد بلا التفات",7,"ت",1,0],["وعفو يقول لساري الذنو","ب إلى جبلِ الحلم يا ساريه",8,"ي",2,0],["وعفا نُبوُّك عن وَلِّيك إنه","أحدوثةٌ في جانبيْ بغدادِ",9,"د",1,0],["وعفافٍ في القلبِ والطَّرفِ والأط","رافِ عن كل مَحرمٍ ممنوعِ",10,"ع",1,0],["وعفا الثَرى عن حُرّ وجهٍ لم يزلْ","حُرَّ اللقاء إذا عرا السؤّالُ",11,"ل",1,0],["وعفا وعامَل بالأَناةِ عَدُوَّه","فكأنه لاهٍ وليس بلاهي",12,"ه",2,0],["وَعَفَّيتَ مِنهُم بَعدَ آثارِ فِتنَةٍ","وَأَحيَيتَ باباً لِلنَدى كانَ خاوِيا",13,"ي",2,0],["وَعَفَت قُبورُ الفاتِحينَ وَفُضَّ عَن","حُفَرِ الخَلائِفِ جَندَلٌ وَرِجامُ",14,"م",1,0],["وَعَفا الطِرادُ فَلا سِنانٌ راعِفٌ","فَوقَ القَناةِ وَلا حُسامٌ يَلمَعُ",15,"ع",1,0],["وَعَفَوتَ عَفواً عَمَّ أُمَّةَ أَحمَدٍ","في الغَربِ مِن أَوطانِهِم وَالمَشرِقِ",16,"ق",1,0],["وَعِفْتَ العارَ إلا عَيْرَ أُنْسٍ","تَخُرُّ له إذا أَدلى صَريعا",17,"ع",2,0],["وعَفا فردَّ البِيضَ في أغمادِها","وسَطا فَعلَّ متونَها بخِضابِ",18,"ب",1,0],["وَعَفَفتُ عَن اَثوابِهِ وَلَوَ اَنَّني","كُنتُ المُقَطَّرَ بَزَّني أَثوابي",19,"ب",2,0],["وَعِفتُ حِسابَهُم وَالأَصلُ عِندي","وَفي كَفَّيَّ دَستورُ البَقايا",20,"ا",3,0],["وعفا القيد عنك كفاً وساقا","فإذا الأرض كلها لك دار",21,"ر",1,0],["وعفافٌ لو كان في الأرض عادتْ","كلَّ عظم من الدفين ولحمِ",22,"م",1,0],["وَعِفّةُ سيفٍ ليس يبْرُقُ بالرّدى","إذا سلّهُ إلّا على رأس ظالمِ",23,"م",1,0],["وَعِفَّةُ نَفْسٍ لا تُزَنُّ بِرِيبَةٍ","وَجُودٌ بِهِ ظَلَّتْ عُفَاةُ النَّدَى تَرْوَى",24,"و",2,0],["وعفْتُ شرابَ أمداحي فلما","وجدتُكَ أهلَها حَسُنَ امتداحي",25,"ح",2,0],["وعفْتُ بني الدنيا وغادرْتُ برَّهُمْ","لغيري فلا أشكو ولا أتعتَّبُ",26,"ب",1,0],["وعَفَّرْتُ خَدِّي بحيثُ استراحَ","خَدٌّ تَفَرَّى ولم يَضْرَعِ",27,"ع",1,0],["وَعِفتُ كَراهَةً لِلشَيءِ شَيئاً","يَكونُ لَهُ شَبيهاً أَو نَسيبا",28,"ب",2,0],["وَعَفَت مِنَ الدُنيا الفَضائِلُ وَاِنمَحَت","أَعقابُها وَبَقِيَّةُ الآثارِ",29,"ر",1,0],["وعفا الطّراد فلا سنانٌ راعفٌ","فوق القناة ولا سنانٌ يلمع",30,"ع",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَها","تَردادُ وَكفِ العارِضِ الهَطّالِ",31,"ل",1,0],["وَعَفَا حَدِيثٌ كَانَ فِي","أَسْمَاعِنَا سِحْراً حَلاَلاَ",32,"ل",2,0],["وَعَفَا ذَكَاءٌ بَاهِرٌ","يَجْلُو الظَّلاَمَ إِذَا تَلاَلاَ",32,"ل",2,0],["وَعَفَا اللهُ عَنْكُمُ وَوَقَاكُمْ","فِي بَنِيكُمْ وَمَالِكُمْ أَنْ تُضَامُوا",33,"م",3,0],["وَعَفَتْ مَعَاهِدُ بَطشِهِمْ أَوْ أَوْشَكَتْ","وَهَوَتْ صُرُوحُ العِزَّةِ الْقَعْساءِ",34,"ا",2,0],["وَعَفا كَما يَعفو السَحابُ وَرَعدُهُ","قَصِفٌ وَبارِقُهُ حَريقٌ مُشعَلُ",35,"ل",1,0],["وعِفْنَا ورودَ الماءِ أكدرَ آسناً","وحنّتْ حنايانا لعذب المناهل",36,"ل",1,0],["وعفَتْ كأن لم يمشِ في ارجائها","\" عيسى \" ، و\" أحمدُ \" لم يَطِرْ محمولا",37,"ل",2,0],["وعفت من ظباء صقر قريش","وأغاني قيانه الزهراء",38,"ا",2,0],["وعفا مَغانِيَها فأَخْلقَ رسْمِها","تردادُ وكفِ العارضِ الهطال",39,"ل",1,0],["وعفت كل نديم","قد آثر العقل جهلا",40,"ل",2,0],["وعفواً لعبدٍ أقرَّ بذَنْبهِ","وإنّك غفارُ الذنوبِ تكرُّمَا",41,"م",2,0],["وعفتَ قصوراً بالمصابيح زُينت","وراقك قبر في البلاقع مظلم",42,"م",1,0],["وَعَفَوتَ حَتّى لَو رَجا غُيّابُهُم","ذا العَفوَ وَدّوا أَنَّهُم شُهّادُ",43,"د",1,0],["وعفَّى رسوم الكافرين وأهلها","فلا قيصر من بعد ذاك ولا كسرى",44,"ر",2,0],["وعفَّةٌ لم ينل منها الصِّبا وطراً","ما للصِّبا من أبي حفص وللوطر",45,"ر",1,0],["وَعِفْتُ السَّلاَلِمَ لِلْمُغْرَمِينَ","وَعِفْتُ الكَرَاسِيَّ وَهْيَ تُشَدُّ",46,"د",1,0],["وَعِفْتُ المَسَارِحَ حَتَّى لَأَجْهَ","لُ إِنْ غَابَ نَجْمٌ مَتَى كَانَ يَبْدُو",46,"د",2,0],["وَعِفْتُ البَرِيقَ، فَلَوْ قَدْ تَأَلَّ","هَ كُلُّ العَبِيدِ، فَإِنِّيَ عَبْدُ",46,"د",1,0],["وعفوت عمّن من تاب غير مناقش","عن جرمه ووفيت إذ عُدم الوفي",47,"ف",2,0],["وعفو عظيم منك عني وعنهم","إذا هجروا القول الذي منه يغضب",48,"ب",1,0],["وَعَفَّ فَلم يَمدُد إِلى مُسلِمٍ يَداً","بِسُوءٍ وَلا باتَت لَهُ عَقرَبٌ تَسري",49,"ر",2,0],["وَعِفةُ نَفسٍ لَو ثَوتْ قَلبَ عاشقٍ","لَما باتَ مَجهوداً يُعاني التَّسَهُّدا",50,"د",2,0],["وعفّوا عن ملاح الناس هذا","محالٌ في الحلال وفي الحرام",51,"م",1,0],["وعف الناس عنه فصار يحفى","على كره يلقب بالعفيف",52,"ف",1,0],["وعفت الشعر والدنيا عجوز","وقد أثرى بها نذل ووغد",53,"د",1,0],["وَعَفواً أَيا ذات المحاسنِ إنّني","حَصِرتُ ولَم أبلُغ بِمدحي لكِ الحصرا",54,"ر",2,0],["وَعَفا عن آدمٍ لمّا هفا","وَسِواه مِن ذوي القدرِ السني",55,"ي",1,0],["وَعَفافٌ يُثنيهِ عَن مَوقِفِ الشَك","كِ إِذا أَطلَقَ العِنانَ الجَهولُ",56,"ل",1,0],["وعفيفا وإن تهتك في الحسن","وأشفاه سهم قال وقيل",57,"ل",1,0],["وعفوتَ عني عفوَ مقتدرٍ","والذنبُ فوقَ العَفوِ والغُفرِ",58,"ر",1,0],["وَعفوك شاملٌ أَهلَ الخَطايا","وإِنّي ذو خَطاءٍ فاِعفُ عنّي",59,"ن",2,0],["وعفِّر الخدَّ فيه واِكتحل نظراً","به فرؤيتُه تَشفي من الأَلَمِ",60,"م",1,0],["وعفّرتُ وَجهي في ثَراهُ لوجهِهِ","وَطابَ لي التَعفيرُ إِذ جئتُ عن عُفرِ",61,"ر",1,0],["وعفش الحسن ذاك الوجه حين خبا","ديباج خديه في مسحٍ من الشعر",62,"ر",1,0],["وعفوٍ عندَ حردٍ واِقتدار","أبى أَن يسبقَ العذل الوعيدُ",63,"د",1,0],["وَعَفوُ اللَهِ أَوسَعُ كُلّ شَيءٍ","تَعالى اللَهُ خَلّاقُ الأَنامِ",64,"م",1,0],["وَعَفَفتُ عَنهُ يا أُمَيمُ تَكَرُّماً","وَكَذاكَ يَفعَلُ ذو الحِجى المُتَعَفِّفُ",65,"ف",1,0],["وعفا الحب لا الاغاني اغانٍ","حين عفى ولا الاماني اماني",66,"ن",2,0],["وعفا ما كان يعت","ز به هذا الشباب",67,"ب",1,0],["وعَفَّ عنِ الخُلُقِ الدَّنيءِ وعافَه","وقاك الرَّدى مَنْ لم يَعِفَّ ولم يَعَفْ",68,"ف",1,0],["وَعَفافُنا بِالطَبع لا","عَن خَوف واشٍ أَو مُلام",69,"م",1,0],["وَعِفة نَساك وَتَكريه شاطر","وَتَمويهُ مَنّاع وَأَطماع بِذّال",70,"ل",1,0],["وعفو يا كثير العفو عفوا","وغفرانا لعاصي الجن والناس",71,"س",1,0],["وعفوا سيدي فضلا ومنا","وغفرا للذنوب الموبقات",72,"ت",1,0],["وعفوُك الجسمُّ يا مولايَ أَوسَعُ مِمَّ","إذا ضاق عنْهُ احْتِمالي مِنْ خطيئاتي",73,"ت",2,0],["وعففت عن أموالهم لا قطعة","أقطعت أو مكس من الأسواق",74,"ق",1,0],["وعفت منازل للهوى ومعالم","كانَ الزمان بها عليه رونق",75,"ق",1,0],["وعُفاةٍ أَغناهُمُ بمَعَانِي","هِ سريعاً فلا عَفَتْ من عُفاةِ",76,"ه",1,0],["وَعَفا مِنَ الأَقْطارِ بَعْدَ خَلائِها","ما بَيْنَ أَنْدَلُسٍ إِلى حُلْوانِ",77,"ن",1,0],["وعفاة تسنموا خطر الاه","وال بالبيد يعملون بالرجاء",78,"ا",2,0],["وعفا أَعلامَهُمْ حَتَّى لقد","كادَ أَنْ يَخْفَى لَهُمْ يَوْمُ الأَحَدْ",79,"د",1,0],["وعَفَتْ مَحاسِنه العِدى فكأَنَّها","فِي مَعْهَدِ الْوَطَنِ الفَقيدِ طُلُولُهُ",80,"ل",2,0],["وعفتها حين خانت","أنفاسها كل حي",81,"ي",1,0],["وعفَّ فبات يحلبهنّ مَذقاً","وأخلافُ الزمان له غِزارُ",82,"ر",1,0],["وعفةَ مذهبي ظَلِفاً ومَيْلي","إلى العيش المُرَمَّق وأنصبابي",83,"ب",2,0],["وعفا وعفَّ فلو يطيق مع الصدَّا","صدَّ المباحَ فعاف وردَ المشرع",84,"ع",1,0],["وعَفواً عن التَّقصيرِ منِّي فَوصفُكم","تَضيقُ قَوافٍ عنه قبلَ بُحورِ",85,"ر",1,0],["وعفوا أيا مولايَ إن كنتُ عاجزاً","على حصرِ ما الأرقامُ أعجزَها حَصرا",86,"ر",2,0],["وعِفتُ حرامَه فأنال عيني","وقلبي في الدُّجى منه حلالَهْ",87,"ل",2,0],["وعفناه دوداً في شراب ومأكل","ونفليه قمل في الثياب وسوس",88,"س",1,0],["وعفا الرحمن عما حدثت","أمتي أنفسها قد أثرا",89,"ر",2,0],["وعِفْتُ دُنْيَا تُسَمَّى من دَنَاءَتها","دُنْيا وإِلاَّ فَما مَكْرُوهُها الدَانِي",90,"ن",2,0],["وعِفْتُ طيفيَ لم جَاءَ سيِّدُه","يا عين عفِّي طريقَ الطَّيفِ بالأَرَق",91,"ق",1,0]]}