لبسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117319","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4412,"","https://poetry.dctabudhabi.ae/diwan/poem/104197","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33484","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72448","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4922,"هل إلى سَلوة ٍ وصبرٍ سبيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=16464",""],[4927,"جُنُوْحُ الْقَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=29640",""],[4927,"حِجابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=30186",""],[4935,"تحيي الملائك في كل آن","https://www.poetsgate.com/ViewPoem.aspx?id=129438",""],[5039,"عفرى","https://www.poetsgate.com/ViewPoem.aspx?id=48141",""],[5136,"كمل الكتاب تكاملت","https://www.poetsgate.com/ViewPoem.aspx?id=121944",""],[5136,"زارني طيفه فأهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=121785",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5189,"عَلامَ الهمُّ والعتَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=192892",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"سمراءُ غيداءُ خلفَ الأسرِ تكويني","https://www.poetsgate.com/ViewPoem.aspx?id=188442",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5409,"قل للمجانين في الدنيا لكم طوبى","https://www.poetsgate.com/ViewPoem.aspx?id=155254",""],[5431,"وعفريتُ قنديلي يئنُ ويشتكيٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189638",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5725,"الى الحلاج","https://www.poetsgate.com/ViewPoem.aspx?id=201834",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5977,"ستار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213264",""],[5997,"لَبَّيْكَ حَبِيْبِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214238",""],[5309,"عرفت سبيل الطالبين تعاليا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573658",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[1333,"يا أيها المغتر بالله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56036&r=&rc=14",""]],"verses":[["وَعَفَّرَ فُرسانَ العِدا وَدِماؤُهُم","جَوامِدُ ما بَينَ اللِحى وَالعَمائِمِ",0,"م",1,0],["وَعِفنا القاعَ نَسكُنُهُ وَمِلنا","عَنِ السَمُراتِ وَالنَعَمِ المِراحِ",1,"ح",1,0],["وَعَفا اليَومَ عَلى كَر","رَي قِطارٍ وَجَنوبِ",2,"ب",1,0],["وعِفْتُ ثَراءً دونَه يَدُ باخِلٍ","إذا لَم أصُنْ عِرضي فلا حَبّذا المالُ",3,"ل",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَه","تَردادُ وَكفِ العارِضِ الهَطّالِ",4,"ل",1,0],["وَعَفَفْتَ حَتَّى عَنْ خَيَالٍ طَارِقٍ","وَوَهَبْتَ حَتَّى أَعْذَرَ اسْتِجْدَاءُ",5,"ا",2,0],["وَعَفوٌ عَن مُسيئِهِمُ وَصَفحٌ","يَعودُ بِهِ إِذا غَلِقَ الحُجولُ",6,"ل",1,0],["وعفت الظبيَ أيضاً لا لفكرٍ","يطالبنا الوداد بلا التفات",7,"ت",1,0],["وعفو يقول لساري الذنو","ب إلى جبلِ الحلم يا ساريه",8,"ي",2,0],["وعفا نُبوُّك عن وَلِّيك إنه","أحدوثةٌ في جانبيْ بغدادِ",9,"د",1,0],["وعفافٍ في القلبِ والطَّرفِ والأط","رافِ عن كل مَحرمٍ ممنوعِ",10,"ع",1,0],["وعفا الثَرى عن حُرّ وجهٍ لم يزلْ","حُرَّ اللقاء إذا عرا السؤّالُ",11,"ل",1,0],["وعفا وعامَل بالأَناةِ عَدُوَّه","فكأنه لاهٍ وليس بلاهي",12,"ه",2,0],["وَعَفَّيتَ مِنهُم بَعدَ آثارِ فِتنَةٍ","وَأَحيَيتَ باباً لِلنَدى كانَ خاوِيا",13,"ي",2,0],["وَعَفَت قُبورُ الفاتِحينَ وَفُضَّ عَن","حُفَرِ الخَلائِفِ جَندَلٌ وَرِجامُ",14,"م",1,0],["وَعَفا الطِرادُ فَلا سِنانٌ راعِفٌ","فَوقَ القَناةِ وَلا حُسامٌ يَلمَعُ",15,"ع",1,0],["وَعَفَوتَ عَفواً عَمَّ أُمَّةَ أَحمَدٍ","في الغَربِ مِن أَوطانِهِم وَالمَشرِقِ",16,"ق",1,0],["وَعِفْتَ العارَ إلا عَيْرَ أُنْسٍ","تَخُرُّ له إذا أَدلى صَريعا",17,"ع",2,0],["وعَفا فردَّ البِيضَ في أغمادِها","وسَطا فَعلَّ متونَها بخِضابِ",18,"ب",1,0],["وَعَفَفتُ عَن اَثوابِهِ وَلَوَ اَنَّني","كُنتُ المُقَطَّرَ بَزَّني أَثوابي",19,"ب",2,0],["وَعِفتُ حِسابَهُم وَالأَصلُ عِندي","وَفي كَفَّيَّ دَستورُ البَقايا",20,"ا",3,0],["وعفا القيد عنك كفاً وساقا","فإذا الأرض كلها لك دار",21,"ر",1,0],["وعفافٌ لو كان في الأرض عادتْ","كلَّ عظم من الدفين ولحمِ",22,"م",1,0],["وَعِفّةُ سيفٍ ليس يبْرُقُ بالرّدى","إذا سلّهُ إلّا على رأس ظالمِ",23,"م",1,0],["وَعِفَّةُ نَفْسٍ لا تُزَنُّ بِرِيبَةٍ","وَجُودٌ بِهِ ظَلَّتْ عُفَاةُ النَّدَى تَرْوَى",24,"و",2,0],["وعفْتُ شرابَ أمداحي فلما","وجدتُكَ أهلَها حَسُنَ امتداحي",25,"ح",2,0],["وعفْتُ بني الدنيا وغادرْتُ برَّهُمْ","لغيري فلا أشكو ولا أتعتَّبُ",26,"ب",1,0],["وعَفَّرْتُ خَدِّي بحيثُ استراحَ","خَدٌّ تَفَرَّى ولم يَضْرَعِ",27,"ع",1,0],["وَعِفتُ كَراهَةً لِلشَيءِ شَيئاً","يَكونُ لَهُ شَبيهاً أَو نَسيبا",28,"ب",2,0],["وَعَفَت مِنَ الدُنيا الفَضائِلُ وَاِنمَحَت","أَعقابُها وَبَقِيَّةُ الآثارِ",29,"ر",1,0],["وعفا الطّراد فلا سنانٌ راعفٌ","فوق القناة ولا سنانٌ يلمع",30,"ع",1,0],["وَعَفا مَغانِيَها وَأَخلَقَ رَسمَها","تَردادُ وَكفِ العارِضِ الهَطّالِ",31,"ل",1,0],["وَعَفَا حَدِيثٌ كَانَ فِي","أَسْمَاعِنَا سِحْراً حَلاَلاَ",32,"ل",2,0],["وَعَفَا ذَكَاءٌ بَاهِرٌ","يَجْلُو الظَّلاَمَ إِذَا تَلاَلاَ",32,"ل",2,0],["وَعَفَا اللهُ عَنْكُمُ وَوَقَاكُمْ","فِي بَنِيكُمْ وَمَالِكُمْ أَنْ تُضَامُوا",33,"م",3,0],["وَعَفَتْ مَعَاهِدُ بَطشِهِمْ أَوْ أَوْشَكَتْ","وَهَوَتْ صُرُوحُ العِزَّةِ الْقَعْساءِ",34,"ا",2,0],["وَعَفا كَما يَعفو السَحابُ وَرَعدُهُ","قَصِفٌ وَبارِقُهُ حَريقٌ مُشعَلُ",35,"ل",1,0],["وعِفْنَا ورودَ الماءِ أكدرَ آسناً","وحنّتْ حنايانا لعذب المناهل",36,"ل",1,0],["وعفَتْ كأن لم يمشِ في ارجائها","\" عيسى \" ، و\" أحمدُ \" لم يَطِرْ محمولا",37,"ل",2,0],["وعفت من ظباء صقر قريش","وأغاني قيانه الزهراء",38,"ا",2,0],["وعفا مَغانِيَها فأَخْلقَ رسْمِها","تردادُ وكفِ العارضِ الهطال",39,"ل",1,0],["وعفت كل نديم","قد آثر العقل جهلا",40,"ل",2,0],["وعفواً لعبدٍ أقرَّ بذَنْبهِ","وإنّك غفارُ الذنوبِ تكرُّمَا",41,"م",2,0],["وعفتَ قصوراً بالمصابيح زُينت","وراقك قبر في البلاقع مظلم",42,"م",1,0],["وَعَفَوتَ حَتّى لَو رَجا غُيّابُهُم","ذا العَفوَ وَدّوا أَنَّهُم شُهّادُ",43,"د",1,0],["وعفَّى رسوم الكافرين وأهلها","فلا قيصر من بعد ذاك ولا كسرى",44,"ر",2,0],["وعفَّةٌ لم ينل منها الصِّبا وطراً","ما للصِّبا من أبي حفص وللوطر",45,"ر",1,0],["وَعِفْتُ السَّلاَلِمَ لِلْمُغْرَمِينَ","وَعِفْتُ الكَرَاسِيَّ وَهْيَ تُشَدُّ",46,"د",1,0],["وَعِفْتُ المَسَارِحَ حَتَّى لَأَجْهَ","لُ إِنْ غَابَ نَجْمٌ مَتَى كَانَ يَبْدُو",46,"د",2,0],["وَعِفْتُ البَرِيقَ، فَلَوْ قَدْ تَأَلَّ","هَ كُلُّ العَبِيدِ، فَإِنِّيَ عَبْدُ",46,"د",1,0],["وعفوت عمّن من تاب غير مناقش","عن جرمه ووفيت إذ عُدم الوفي",47,"ف",2,0],["وعفو عظيم منك عني وعنهم","إذا هجروا القول الذي منه يغضب",48,"ب",1,0],["وَعَفَّ فَلم يَمدُد إِلى مُسلِمٍ يَداً","بِسُوءٍ وَلا باتَت لَهُ عَقرَبٌ تَسري",49,"ر",2,0],["وَعِفةُ نَفسٍ لَو ثَوتْ قَلبَ عاشقٍ","لَما باتَ مَجهوداً يُعاني التَّسَهُّدا",50,"د",2,0],["وعفّوا عن ملاح الناس هذا","محالٌ في الحلال وفي الحرام",51,"م",1,0],["وعف الناس عنه فصار يحفى","على كره يلقب بالعفيف",52,"ف",1,0],["وعفت الشعر والدنيا عجوز","وقد أثرى بها نذل ووغد",53,"د",1,0],["وَعَفواً أَيا ذات المحاسنِ إنّني","حَصِرتُ ولَم أبلُغ بِمدحي لكِ الحصرا",54,"ر",2,0],["وَعَفا عن آدمٍ لمّا هفا","وَسِواه مِن ذوي القدرِ السني",55,"ي",1,0],["وَعَفافٌ يُثنيهِ عَن مَوقِفِ الشَك","كِ إِذا أَطلَقَ العِنانَ الجَهولُ",56,"ل",1,0],["وعفيفا وإن تهتك في الحسن","وأشفاه سهم قال وقيل",57,"ل",1,0],["وعفوتَ عني عفوَ مقتدرٍ","والذنبُ فوقَ العَفوِ والغُفرِ",58,"ر",1,0],["وَعفوك شاملٌ أَهلَ الخَطايا","وإِنّي ذو خَطاءٍ فاِعفُ عنّي",59,"ن",2,0],["وعفِّر الخدَّ فيه واِكتحل نظراً","به فرؤيتُه تَشفي من الأَلَمِ",60,"م",1,0],["وعفّرتُ وَجهي في ثَراهُ لوجهِهِ","وَطابَ لي التَعفيرُ إِذ جئتُ عن عُفرِ",61,"ر",1,0],["وعفش الحسن ذاك الوجه حين خبا","ديباج خديه في مسحٍ من الشعر",62,"ر",1,0],["وعفوٍ عندَ حردٍ واِقتدار","أبى أَن يسبقَ العذل الوعيدُ",63,"د",1,0],["وَعَفوُ اللَهِ أَوسَعُ كُلّ شَيءٍ","تَعالى اللَهُ خَلّاقُ الأَنامِ",64,"م",1,0],["وَعَفَفتُ عَنهُ يا أُمَيمُ تَكَرُّماً","وَكَذاكَ يَفعَلُ ذو الحِجى المُتَعَفِّفُ",65,"ف",1,0],["وعفا الحب لا الاغاني اغانٍ","حين عفى ولا الاماني اماني",66,"ن",2,0],["وعفا ما كان يعت","ز به هذا الشباب",67,"ب",1,0],["وعَفَّ عنِ الخُلُقِ الدَّنيءِ وعافَه","وقاك الرَّدى مَنْ لم يَعِفَّ ولم يَعَفْ",68,"ف",1,0],["وَعَفافُنا بِالطَبع لا","عَن خَوف واشٍ أَو مُلام",69,"م",1,0],["وَعِفة نَساك وَتَكريه شاطر","وَتَمويهُ مَنّاع وَأَطماع بِذّال",70,"ل",1,0],["وعفو يا كثير العفو عفوا","وغفرانا لعاصي الجن والناس",71,"س",1,0],["وعفوا سيدي فضلا ومنا","وغفرا للذنوب الموبقات",72,"ت",1,0],["وعفوُك الجسمُّ يا مولايَ أَوسَعُ مِمَّ","إذا ضاق عنْهُ احْتِمالي مِنْ خطيئاتي",73,"ت",2,0],["وعففت عن أموالهم لا قطعة","أقطعت أو مكس من الأسواق",74,"ق",1,0],["وعفت منازل للهوى ومعالم","كانَ الزمان بها عليه رونق",75,"ق",1,0],["وعُفاةٍ أَغناهُمُ بمَعَانِي","هِ سريعاً فلا عَفَتْ من عُفاةِ",76,"ه",1,0],["وَعَفا مِنَ الأَقْطارِ بَعْدَ خَلائِها","ما بَيْنَ أَنْدَلُسٍ إِلى حُلْوانِ",77,"ن",1,0],["وعفاة تسنموا خطر الاه","وال بالبيد يعملون بالرجاء",78,"ا",2,0],["وعفا أَعلامَهُمْ حَتَّى لقد","كادَ أَنْ يَخْفَى لَهُمْ يَوْمُ الأَحَدْ",79,"د",1,0],["وعَفَتْ مَحاسِنه العِدى فكأَنَّها","فِي مَعْهَدِ الْوَطَنِ الفَقيدِ طُلُولُهُ",80,"ل",2,0],["وعفتها حين خانت","أنفاسها كل حي",81,"ي",1,0],["وعفَّ فبات يحلبهنّ مَذقاً","وأخلافُ الزمان له غِزارُ",82,"ر",1,0],["وعفةَ مذهبي ظَلِفاً ومَيْلي","إلى العيش المُرَمَّق وأنصبابي",83,"ب",2,0],["وعفا وعفَّ فلو يطيق مع الصدَّا","صدَّ المباحَ فعاف وردَ المشرع",84,"ع",1,0],["وعَفواً عن التَّقصيرِ منِّي فَوصفُكم","تَضيقُ قَوافٍ عنه قبلَ بُحورِ",85,"ر",1,0],["وعفوا أيا مولايَ إن كنتُ عاجزاً","على حصرِ ما الأرقامُ أعجزَها حَصرا",86,"ر",2,