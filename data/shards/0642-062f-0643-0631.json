{"poems":[[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[71,"كم ملك جاء وكم نائب","https://www.aldiwan.net/poem28081.html","السريع"],[76,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[108,"حمل القلادة","https://www.poetsgate.com/ViewPoem.aspx?id=179508",""],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[409,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[556,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108497","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201949","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201699","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204450","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112300","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111406","الخفيف"],[4767,"اضطراب","https://www.poetsgate.com/ViewPoem.aspx?id=175318",""],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[5246,"إني لفي أسف مما له انقلبوا","https://www.poetsgate.com/ViewPoem.aspx?id=187030",""],[5956,"فلسطين أرض العرب*","https://www.poetsgate.com/ViewPoem.aspx?id=182863",""],[5956,"فلسطين عربية باعتراف التوراة والإنجيل والقرآن","https://www.poetsgate.com/ViewPoem.aspx?id=192361",""],[5966,"بريقه ومصراته","https://www.poetsgate.com/ViewPoem.aspx?id=158314",""]],"verses":[["قَد كَرِهنا المُقامَ في الأَرضِ لَمّا","قيلَ إِنَّ السَما مَقَرُّ الهَناءِ",0,"ا",2,0],["قد كرروا الزينةَ حتى اللحى","ما بقيتْ تلحقُ أنْ تنبتا",1,"ت",2,0],["قَد كَرَّ في لَأمَةٍ حَصداءَ تَحسِبُها","بَحراً يُلاطِمُ مِن أَعطافِهِ جَبَلا",2,"ل",2,0],["قَدْ كَرُمَتْ خِصَالُكُمْ فِي السِّرِّ","وَقَدْ سَمَتْ خِلاَلُكُمْ فِي الْجَهْرِ",3,"ر",1,0],["قد كرَّم الفاروقُ كلَّ معلم","في شخص «عبد الرازق السنهوري»",4,"ر",2,0],["قد كرر اللّه في القرآن ذكركما","فالفضل بينكما في الذكر منقسم",5,"م",1,0],["قد كرّه العلم إلى أهله","وحبب الجهل لمن يجهل",6,"ل",1,0],["قد كَرَعْنا منه ولا ظَمَأٌ في","نا من البَوِّ في بحورٍ طَوامِ",7,"م",1,0],["قد كرهت الوجود قبلاً فاحيى","بي هذا اللقا حب الخلود",8,"د",1,0],["قد كرهت الفروق في الكون حتى","ضقت ذرعاً بأفعل التفضيل",9,"ل",1,0],["قد كرّموك وما استحيت عيونهم","أن لا ترى لك فيما بينهم نُظرا",10,"ر",2,0],["قد كرهناك إذ جهلناك يا من","منتهى العلم أنت والاختيار",11,"ر",1,0],["قد كَرّمَتهُم بطيّها كُتُبٌ","وقَبّحَتهُم بطيّها الكُتُبُ",12,"ب",1,0],["قَد كَرِهتُ استِيدَاعَ سِرِّك عندِي","إِن أَغِب رُمتَ سِرَّ أَلِيفِ",13,"ف",1,0],["قد كرَّم يوماً ذا إحَنٍ","تغلي في الصدر وتضطرب",14,"ب",1,0],["قد كرّت الأعوامُ يتلو بعضُها","بعضاً وما في الأفْق إلاّ الغيهبُ",15,"ب",1,0],["قد كرس الهم في تحسين وجهته","ولم يفرط بنصح الناس ما رغبوا",16,"ب",3,0],["قد كَرَّرَ الإنجيلُ هذا الاسمَ ما","أرْبَى على مئةٍ كنفْيٍ للكذبْ",17,"ب",1,0],["قد كَرَّرَ الإنجيلُ هذا الاسمَ ما","أرْبَى على مائةٍ كنفْيٍ للكذبْ",18,"ب",1,0],["قد كرر الأسماء في ألقابهِ","أفكارهُ قد أطفأت مشكاته",19,"ت",2,0]]}