{"poems":[[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[53,"لاح شيب فنهنه الحلم جهلا","https://www.aldiwan.net/poem65914.html","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[107,"يا أيها الناس إن الله يأمركم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54979&r=&rc=149",""],[168,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[369,"أسهر الناظر بعض الليالي","https://www.aldiwan.net/poem60640.html","المديد"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122566","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137343",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53955","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63791","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137083",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34651","الرمل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83165","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139677",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""]],"verses":[["كل مجدُ يبنى على غير سعيٍ","فهو مجد مهدّد بالزوال",0,"ل",1,0],["كلُّ مجدٍ تراه في الناس حيّاً","هو أحياهُ بعدما مات هزلا",1,"ل",2,0],["كلّ مجد يفنى ويبقى لشعري","شرف باذخ ومجد أثيل",2,"ل",1,0],["كل مجد وراء الحق يطلبه","من غاضبٍ سامه خسفاً وإهوانا",3,"ن",2,0],["كُلُّ مَجدٍ لَم يُسَمّن","هُ اليَمانونَ نَحيفُ",4,"ف",1,0],["كُلُّ مَجْبولٍ على الطّعْنِ طَبْعاً","يَرْضَعُ الصَّعْدةَ يومَ الفِطام",5,"م",1,0],["كلّ مجرٍ سعيُ أيّوب له","في ظلام الخطب شعشاعُ الذُّبالِ",6,"ل",1,0],["كلُّ مَجدُولةِ القوامِ تُعاني","كَفَلاً يَجذبُ القُلُوبَ رَداحا",7,"ح",2,0],["كلُّ مجدٍ لم يقُم يوماً على","أُسِ فضلٍ كان واهي الجانبين",8,"ن",1,0],["كلُّ مجدٍ فإنّه دون شكٍّ","قاصِرٌ عن مكانِ تلك المَجادَهْ",9,"د",2,0],["كلُّ مجدولةٍ يجولُ وشاحا","نِ على خصرِها ويشجَى السِّوار",10,"ر",1,0],["كُلٌّ مَجَازٌ لاَ حَقِيقَةَ تَحتَهُ","أوِّل وَزِد وَانقُص بِلاَ بُرهَانِ",11,"ن",1,0],["كل مجد يبنى على غير علم","وكمال مصيره للزوال",12,"ل",1,0],["كل مجدٍ دون ما أثلهُ","لبني كاوس أملاك العجَم",13,"م",1,0],["كل مجد حقيقة في علاه","وسواه يرى له كالمجاز",14,"ز",1,0],["كُلُّ مَجدٍ لَهُ مَدى غَيرَ مَجدِ العَب","قَريِّينَ جلَّ عَن أَن يُحَدّا",15,"د",2,0],["كل مجدٍ قد قام فيه وفيه","كل بيتٍ من العلى معمور",16,"ر",1,0],["كلّ مجدٍ أتى بدون بلاء","باطلٌ لا يعدّ عنه الحساب",17,"ب",1,0],["كل مجد لحادث أو قديم","مستعار من مجدك المستطيل",18,"ل",1,0]]}