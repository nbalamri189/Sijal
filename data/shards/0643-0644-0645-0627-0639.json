],[5461,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=27708",""],[5596,"آه نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206780",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[5720,"كيف للحلِّ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200877",""],[5837,"سارعي يا بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=179452",""],[5956,"كل ما عندك لطفٌ وجَمال","https://www.poetsgate.com/ViewPoem.aspx?id=182049",""],[5956,"تَغْزِل العينان","https://www.poetsgate.com/ViewPoem.aspx?id=182075",""],[5956,"حسْن هذا النهد من أجلي أنا","https://www.poetsgate.com/ViewPoem.aspx?id=182645",""],[5957,"يا شجي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=53772",""],[5970,"ساحة الأرض ضيقت بي فهاتوا","https://www.poetsgate.com/ViewPoem.aspx?id=130613",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6056,"عبير الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130354",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6323,"واحة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82170&r=&rc=1",""]],"verses":[["كُلَّما عَجَّ رَمى في عُرضِهِ","شُعَلَ البَرقِ الرَبابُ المُتَعالي",0,"ل",2,0],["كُلَّما عِفتَ صَبوحَ ال","عُمرِ عوطيتَ غَبوقَه",1,"ق",2,0],["كُلَّما عَضَّهُ الأَذى غَضَّ بِالصَب","رِ يُزَجّي الأَيّامَ وَهيَ غَصيصُ",2,"ص",1,0],["كُلَّما عاوَدَ قَلبي ذِكرُها","لَعِبَ الدَمعُ بِجَفنَيَّ وَجَدِّ",3,"د",1,0],["كُلَّما عادَني السُلُوُّ رَماني","غَنجُ أَلحاظِهِ بِسَهمٍ مُصيبِ",4,"ب",1,0],["كل ما عدَّدْتُ أثمانَ العُلا","ولمَا يُبْتاعُ منهنَّ نُقُودُ",5,"د",1,0],["كُلَّما عَدَّ مالَهُ مُطمَئِنّاً","أَبصَرَ الفَقرَ واقِفاً بِالبابِ",6,"ب",1,0],["كل ما عندنا من النظم والنثر","قبسناه منسنى آياتك",7,"ك",1,0],["كُلُّ ما عَلَّمَكَ الدَهرُ اِعلَمِ","التَجاريبُ عُلومُ الفَهِمِ",8,"م",1,0],["كُلَّما عادَ مَن بَعَثتُ إِلَيها","غارَ مِنّي وَخانَ فيما يَقولُ",9,"ل",1,0],["كَلمٌ أُعيدَ عَلى حَخاكَ وَلَمحَةٌ","مِمّا عَهِدتَ الحادِثاتِ تُريكا",10,"ك",2,0],["كلَّما عدت ترى القي","د وتلقاني سجينَك",11,"ك",1,0],["كلَّما علَّني منَ الرَّاحِ صِرْفاً","علَّني بالرُّضابِ مِن شَفَتيهِ",12,"ي",2,0],["كلما عودُ ثقابٍ أومضا","دفعَ النيلَ وأرغى ومضى",13,"ض",2,0],["كلّما عب جيفه مدّ للأخرى","كؤوسا كحنجرات الضراغم",14,"م",1,0],["كلّما عندنا يزيد ضياعا","والذي نرتجيه ينأى امتناعا",15,"ع",2,1],["كَلْمٌ أُعِيدَ على حَشَاكَ، وَلَمْحَةٌ","مِمّا عَهِدْتَ الحَادِثاتِ تُريكَا",16,"ك",2,0],["كلّما عارضوا الصّوارم فيه","كان امضى شبا وأصفى فرندا",17,"د",2,0],["كلّما عَلّني ثَناياه حيّا","ني بوَرْدِ الشَّقِيق مِن وجْنَتيْهِ",18,"ي",2,0],["كلَّما عاوَدَني تذكارُهُ","مرَّ طيفٌ من صباي المؤنس",19,"س",1,0],["كلّما عمدتُ لتب","ريدِ حرِّها",20,"ه",2,0],["كلّما عَنّت لهُ الذّكرى لها","قالَ فازَت وهيَ بِالفوزِ جَديرَه",21,"ر",2,0],["كُلَّما عُدنا لِنائلِهِ","عادَ في مَعروفِهِ جَذَعا",22,"ع",2,0],["كلما عاد ذكرها","خاطري مدمعي هتن",23,"ن",1,0],["كلّما عنَّ لي حبيبٌ وَفِيٌّ","عَنَّ من دونهِ زمانٌ خَؤون",24,"ن",1,0],["كلّما عاد منه عندَ ادِّكارٍ","بَحّر الشّوقُ مُقْلتي فيه بَحرا",25,"ر",2,0],["كلُّ ما عزَّ من المالِ غَدا","بأبي البِشرِ ذَليلاً مُمتَهَن",26,"ن",1,0],["كلما عزَّ من ذُراها مكانٌ","جعلَته كما تَرى مستَقرَّه",27,"ر",2,0],["كُلَّما عَرَّض بِاللَوم هُما","عارض مِن دَمع عَيني وَاِنسَكَب",28,"ب",1,0],["كلَّما عَلَّلها الحادي بمَن","سَكَنوا سلعاً أحبَّت منه ذكرا",29,"ر",2,0],["كلّما عرَّجت بنادي قبيلٍ","تركت ألسُنَ الفصاحةِ لُكْنا",30,"ن",2,0],["كلّما عاتبتُ في حَظِّيَ دهِري","زاده العتبُ لجَاجا وعُراما",31,"م",2,0],["كلّما عنَّ ترنحتُ له","فيشكُّون أفكرٌ أم ثَمَلْ",32,"ل",1,0],["كَلِمٌ أعور المعادن مطرو","قٌ ومعنىً مردّدٌ مطرورُ",33,"ر",1,0],["كلّما عاند فيها حاسدٌ","ظهرتْ باهرةً مَن يتحدّى",34,"د",2,0],["كلما عرَّضَتْ له رغبةُ الدن","يا توانى عنها عَفافاً وزُهدا",35,"د",2,0],["كلَّما عَفِّرَ طِرْفٌ فارساً","عكفَ الطِّرْفُ عليه وصَفَنْ",36,"ن",1,0],["كلما عضت الحوادث نادى","رضي اللّه عن سعيد بن سَلْمِ",37,"م",1,0],["كل ما عنده مواعيدُ يلقي","ها لقُصَّاده كذوباً مُضِلّا",38,"ل",2,0],["كلما عابني الدقيشيُّ بانَتْ","ليَ أُكرومةٌ تعيبُ الدقيشي",39,"ش",2,0],["كلما عنّ لقلبي ذكرهم","أوقد الشوق به جمر الغضا",40,"ض",2,0],["كلَّما عنَّ مشكلٌ حضرته","فكرةٌ فيه أطلعته الغيوبا",41,"ب",2,0],["كلما عنَّ مفخرٌ يوم سبقٍ","فيه تلقاهما شريكي عنان",42,"ن",1,0],["كُلَّما عزَّيتُ نفسي هاجَني","لابنِ أُمّي ذكرُ الأيّامِ الأوَل",43,"ل",1,0],["كُلّما عَرَّجَتْ بوادٍ من الأر","ض حداها فحثّها ذكر واد",44,"د",1,0],["كلما عنّ ذكرهم رنحته","لوعة ملء خليه والجنوب",45,"ب",1,0],["كلَّما عُطِّلَ نَجمٌ","لاح لي نجمٌ محلّى",46,"ل",2,0],["كُلّما عَزك البكاءُ فأنفد","ت لعبدِ المجيدِ سجلاً فعودي",47,"د",2,0],["كلما عن رثائك الفكر كلاَّ","أسعد الدمع مقولي فاستهلا",48,"ل",2,1],["كُلَّما عَرَّضَ بِالحَمدِ لَهُ","أَكثَرَ السَّومَ وَأَغلى الثَّمَنا",49,"ن",2,0],["كُلّمَا عَجَتِ الجنائِبُ حوليه","أجابت عُفاتُه بالنشيد",50,"د",1,0],["كلّما عرّض ركْبٌ بالحِمَا","قلْتُ يا ركبُ عَسَى مِنْ خبري",51,"ر",2,0],["كلما عن أمر خطب مهم","بك فيما نراه عن استعنا",52,"ن",2,0],["كلما عرفت حالي","صد عني وتنكر",53,"ر",1,0],["كلما عب في جمالك لحظي","ظل روحي معطشا ظمآنا",54,"ن",2,0],["كلما عفته رجعت اليه","كرجوع الأفياء للأغصان",55,"ن",1,0],["كُلُّ ما عَزَّ يَهون","في رِضاها لا كَلام",56,"م",1,0],["كلّما عنّ لي به ذكر ما فا","ت تنهّدت حسرةً وَشجاءَ",57,"ا",2,0],["كُلَّما عَن ذكر قَومي فيها","زادَني الذكر لوعة وَاِشتياقا",58,"ق",2,0],["كُلَّما عَدَّدَت نُواحَ نواها","حَرَّكَت للنَوَى سُكونَ هِيامي",59,"م",2,0],["كل ما عارض سعيًا باقيًا","عَرَضٌ فانٍ وزورٌ ورياء",60,"ا",2,0],["كلما عللتُها من صفوةٍ","أشرقت وجهاً وخَلقاً وخُلقْ",61,"ق",1,0],["كلما عاين المخاوف نادا","ه نداها فامل الآمالا",62,"ل",2,0],["كلما عللت نفسي ضحكت","ضحكة الهازئ من هذي الرغاب",63,"ب",1,0],["كُلَّما عاودها مَطلع شَمس","زاد في يَنبوعها الدافق حَوضا",64,"ض",2,0],["كلَّما عزّ زادَ ذُلي وحالت","بِيَ فيهِ معَ الزَّمانِ الحَالُ",65,"ل",1,0],["كل ما عنهم وفيهم ولهم","من حسان ومراسيل ومسند",66,"د",1,0],["كل ما على الدنيا","لا يفوته اجل",67,"ل",1,1],["كلُّ مَا عَانَيْتُمُوهُ فِي مَضَايَا","مُدْرَجٌ فِي أَوْلَوِيَّاتِ السَّرَايَا",68,"ا",3,0],["كلما عاتبتها ما أخذت من العتاب","غير كلمة ما ورى قولها غير 