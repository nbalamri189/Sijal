{"poems":[[403,"يا جارَ نَضلَةَ قد أنى لكَ","https://www.aldiwan.net/poem702.html",""],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2459","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133773","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25317","الرجز"],[1533,"","https://poetry.dctabudhabi.ae/diwan/poem/105654","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131591",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93659","البسيط"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205561","المنسرح"]],"verses":[["يا نَضل للضَّيفِ الغَريبِ ولل","جارِ المضيمِ وحامِلِ الغُرمِ",0,"م",1,0],["يا نَضَّرَ اللَهُ بَيتاً أَنتَ عامِرُهُ","يا أُمَّ بِشرٍ وَأَسقى دارَكِ المَطَرا",1,"ر",2,0],["يا نضرة الأحلام يا طيبها","ويا حنين الوتر المشفق",2,"ق",1,1],["يا نَضْرَ قَد أُولِعْتِ بِاللَجاجِ","وَالقَوْلِ مِنْ بَواطِلِ السِمْهاجِ",3,"ج",1,0],["يا نضرة الملك الرحمن عودي على","آل النبي مما قد فاتهم عودي",4,"د",2,0],["يا نضيره غرام النسا شبه الجون","ويل أولاه من شر عقباه",5,"ه",1,0],["يا نَضو سارَت تَجد السَير عيسهم","وَزوّدوني صداً مِنهمُ وَجَفا",6,"ف",2,0],["يا نَضلُ لا يوقِعَنَّ البَغيُ بَعضَكُمُ","في مُحصَدٍ حَبلُهُ لِلشَرِّ مَمدودُ",7,"د",1,0],["يا نضرة في الشتاء أبصرها","أبهج من كل منظر نضِرِ",8,"ر",1,1]]}