{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[3,"يا عبل خلي عنك قول المفتري","https://www.aldiwan.net/poem164.html",""],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[35,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[37,"يؤلف بين ضفدعة وضب","https://www.aldiwan.net/poem7641.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[47,"وعطاف على الغمرات نحوي","https://www.aldiwan.net/poem25200.html","الوافر"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[72,"العيد أنت وهذا عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[85,"لما أتم نوح السفينه","https://www.aldiwan.net/poem8025.html","الرجز"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[45,"يأبى سموك واعتلاؤك","https://www.aldiwan.net/poem10206.html","مجزوء الكامل"],[45,"تذكر محزونا وأنى له الذكرى","https://www.aldiwan.net/poem10214.html","الطويل"],[45,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[28,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[61,"لو رحبت كاس بذي أوبة","https://www.aldiwan.net/poem51653.html","السريع"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[74,"صحا عن اللهو صاح عافه خلقا","https://www.aldiwan.net/poem13189.html","البسيط"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[102,"بكوري عند شباكي","https://www.aldiwan.net/poem33125.html","مجزوء الوافر"],[52,"بليت ومل العائدون ورابني","https://www.aldiwan.net/poem26581.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[46,"لو أن كل نفوس الناس رائية","https://www.aldiwan.net/poem23577.html","البسيط"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""]],"verses":[["وَعَطاءٌ تَزَيَّدَ البَحرَ يَعلو","كُلَّما قيلَ قَد بَلَغتَ مُناكا",0,"ك",2,0],["وَعَطَّفَ خِرصانَ الرِماحِ كَأَنَّها","مِنَ الدَمِ في أَطرافِها شَجَرُ الوَردِ",1,"د",1,0],["وَعَطَفتُ نَحوَهُمُ وَصُلتُ عَلَيهِمُ","وَصَدَمتُ مَوكِبَهُم بِصَدرِ الأَبجَرِ",2,"ر",1,0],["وعطَفْنَ قُضْباً للقُدودِ نَواعِماً","بوِّئْنَ أدْواحَ النّعيمِ غُروسا",3,"س",2,0],["وَعَطاءٌ إِذا سَأَلتَ إِذا العِذ","رَةُ كانَت عَطِيَّةَ البُخّالِ",4,"ل",1,0],["وَعَطَّلتَها مِن بَعدِ ذَلِكَ كَالَّذي","نَهى نَفسَهُ أَن خالَفَتهُ يُهينها",5,"ن",3,0],["وَعَطايا يَهُزُها بِسَماحٍ","وَطِماحٍ لِمَن أَرادَ طِماحا",6,"ح",2,0],["وَعَطْفٌ عَلَى جَرْحَى عَدَدْنَا جِرَاحَهُمْ","مُكَفِّرَةً عَمَّا أَسَاءُوا وَأَجْرَمُوا",7,"م",3,0],["وعطفت الضباب أكف قوم","على فُتخ الضفادع مرئمينا",8,"ن",2,0],["وَعَطَّلت الأحكامُ حتى كأنَّنا","على مِلَّةٍ غيرِ التي نَتَنَحَّلُ",9,"ل",1,0],["وَعَطّافٍ عَلى الغَمَراتِ نَحوي","تَحُفُّ بِهِ المُشَقَّفَةُ الطِوالُ",10,"ل",1,1],["وعطَّل مغناها اتّباعاً لزهده","وإن محلاَّ بان عنه لعاطل",11,"ل",1,0],["وعطلت كتباً في الدين مارقةً","فكلّ درع كتاب قدَّ من قبل",12,"ل",1,0],["وعطلتني عن الأوزانِ أنظمها","مدحاً وما عطلت جدواه ميزاني",13,"ي",1,0],["وعطاؤُهم فوق العطاء لأنهم","يُعطون كسْب مَناصِلٍ ورماحِ",14,"ح",1,0],["وعطركمْ تَدرُس آثارهُ","ويسأم السيرَ ولا يفخر",15,"ر",1,0],["وعطَّلْتَني عما غَمرتهُمُ به","ورَيْعيَ أزكى ريعِ ما أنت عامر",16,"ر",1,0],["وعطايا كوامن في المواعي","د كُمونَ الثِّمارِ في الأكمام",17,"م",1,0],["وَعَطَفَ البازُ عَلى الغَزالِ","وَاِجتَمَعَ النَملُ عَلى الأَكّالِ",18,"ل",1,0],["وَعَطاءُ مالٍ لَو عَداهُ طالِبٌ","أَنفَقتَهُ في أَن تُلاقِيَ طالِبا",19,"ب",2,0],["وَعَطاءُ غَيرِكَ إِن بَذَل","تَ عِنايَةً فيهِ عَطاؤُك",20,"ك",1,0],["وَعَطفُ أَبي الجَيشِ الجَوادَ يَكُرُّهُ","مُدافَعَةً عَن دَيرِ مُرّانَ أَو مَقرى",21,"ر",2,0],["وَعَطايا تَأتي رِفاقاً فَيَصدُر","نَ رِفاقَ العافينَ بَعدَ الرِفاقِ",22,"ق",1,0],["وَعَطاياكَ في الفُضولِ عِدادَ الرَم","لِ مِن عالِجٍ فَكَيفَ الحُقوقِ",23,"ق",1,0],["وَعَطاءٌ مِنَ الإِلَهِ فَلا زِل","تَ مُهَنّاً ذاكَ العَطاءَ مُمَلّى",24,"ل",2,0],["وَعُطارِدٌ وَأَبوهُ مِنهُم حاجِبٌ","وَالشَيخُ ناجِيَةُ الخِضَمُّ المِصقَعُ",25,"ع",1,0],["وعطَّرَ الدُّنيا فطابت به","لا عَدِمتَ دنياكَ عَطَّارَها",26,"ر",3,0],["وعطفتَ عطفةَ قادمٍ أسيافُهُ","غُمِدَتْ على الجانين في الغفرانِ",27,"ن",1,0],["وَعَطْفُ قُلوبٍ من دُمَاها بِمَنطِقٍ","كَفيلٌ بِتأنيسِ الظباءِ الشوارِدِ",28,"د",1,0],["وَعَطَّلَ الكَأسَ مِن شَقراءَ سابِحَةٍ","أَلا كَفاها بِرَيعانِ الصِبا طَلَقا",29,"ق",2,0],["وَعُطِّلَ مِن نورِ الخِلافَةِ أُفقُهُ","فَأَمسى وَما تَنجابُ عَنهُ غَياهِبُه",30,"ب",2,0],["وعطفٌ من لدنكِ على","أسى في النفسِ فتَّاكِ",31,"ك",1,0],["وَعُطِّلَ مِن نَفسي مَكانُ رَجائِها","فَإِن لَم يَكُن مَوتٌ فَكَالمَوتِ ما بِيا",32,"ي",2,0],["وَعَطَّلنا بَجيلَةَ مِن يَزيدٍ","وَكانَ حُلِيُّهُم لا يُستَعارُ",33,"ر",1,0],["وَعَطَّلوا هَذِهِ الدُنِّيا فَما وَلَدوا","وَلا اِقتَنوا وَاِستَراحوا مِن رَزاياها",34,"ه",2,0],["وعَطْفَةٍ من صَديقٍ لا يَدومُ بها","كعَطْفَةِ اللّيلِ بينَ الصّبْحِ والفَلَقِ",35,"ق",1,0],["وعطاءٌ بلا عناء ويا رُبْ","بَ عطاءٍ جَمِّ المِطال مُعَنِّي",36,"ي",1,0],["وعَطَّلَ للفصحى يراعًا، ومنبرًا","وقوَّضَ للإِسلام صرحًا مُمرَّدَا",37,"د",2,0],["وعطّري ريحَ الصَّبا بالشَّذى","وانفتقي عن فار مسك فتيق",38,"ق",1,0],["وَعَّطْلت مِنّي مَنْطِقَ العقلِ مُلقياً","لعاطفةٍ عَمْيا زِمامَ المُتابِع",39,"ع",1,0],["وَعَطَاياكَ في الفُضُولِ عِدادُ ال","رّمْلِ من عالجٍ، فقُل في الحُقوقِ",40,"ق",1,0]]}