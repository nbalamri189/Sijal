{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[3,"يا عبل خلي عنك قول المفتري","https://www.aldiwan.net/poem164.html",""],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[35,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[37,"يؤلف بين ضفدعة وضب","https://www.aldiwan.net/poem7641.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[47,"وعطاف على الغمرات نحوي","https://www.aldiwan.net/poem25200.html","الوافر"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[72,"العيد أنت وهذا عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[85,"لما أتم نوح السفينه","https://www.aldiwan.net/poem8025.html","الرجز"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[45,"يأبى سموك واعتلاؤك","https://www.aldiwan.net/poem10206.html","مجزوء الكامل"],[45,"تذكر محزونا وأنى له الذكرى","https://www.aldiwan.net/poem10214.html","الطويل"],[45,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[28,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[61,"لو رحبت كاس بذي أوبة","https://www.aldiwan.net/poem51653.html","السريع"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[74,"صحا عن اللهو صاح عافه خلقا","https://www.aldiwan.net/poem13189.html","البسيط"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[102,"بكوري عند شباكي","https://www.aldiwan.net/poem33125.html","مجزوء الوافر"],[52,"بليت ومل العائدون ورابني","https://www.aldiwan.net/poem26581.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[46,"لو أن كل نفوس الناس رائية","https://www.aldiwan.net/poem23577.html","البسيط"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[115,"لعمري خالدي ذو عباة","https://www.aldiwan.net/poem41716.html","الوافر"],[124,"هل تذكرين وأنت من غزلانه","https://www.aldiwan.net/poem23738.html","الكامل"],[128,"وعليك نفسك لا تعب أحدا ولا","https://www.aldiwan.net/poem50568.html","الكامل"],[135,"نسيم البشر حين سرى","https://www.aldiwan.net/poem48888.html","مجزوء الوافر"],[143,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[143,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[166,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[185,"وساعة جاد بها العمر","https://www.aldiwan.net/poem14528.html","السريع"],[198,"يا رشأ مسكنه فاس","https://www.aldiwan.net/poem51936.html","السريع"],[210,"حديث غرامي فيك أضحى مقيدا","https://www.aldiwan.net/poem13468.html","الطويل"],[210,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[225,"إن الليالي من أخلافها الكدر","https://www.aldiwan.net/poem55100.html","البسيط"],[226,"على أطلال الحب","https://www.aldiwan.net/poem24227.html","عموديه"],[235,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[235,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[259,"أدرها على العشاق يا أيها الساقي","https://www.aldiwan.net/poem35519.html","الطويل"],[271,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[282,"أتى نعي ملك أظلم الشمس والقمر","https://www.aldiwan.net/poem32742.html","الطويل"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[305,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[328,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[348,"ترددي اليوم للخباز يشغلني","https://www.aldiwan.net/poem20400.html","البسيط"],[364,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[371,"شرف كالسماء تطلع فيه","https://www.aldiwan.net/poem57130.html","الخفيف"],[410,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[424,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[432,"تقلب الدهر من حال إلى حال","https://www.aldiwan.net/poem12337.html","البسيط"],[432,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[432,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[439,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[439,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[441,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[453,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[458,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[458,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[500,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[500,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[538,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[551,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[551,"ولقد رجوت وصالكم فكأنني","https://www.aldiwan.net/poem47361.html","الكامل"],[551,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[558,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"رب شخص تقوده الأقدار","https://www.aldiwan.net/poem34547.html","الخفيف"],[560,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"]],"verses":[["وَعَطاءٌ تَزَيَّدَ البَحرَ يَعلو","كُلَّما قيلَ قَد بَلَغتَ مُناكا",0,"ك",2,0],["وَعَطَّفَ خِرصانَ الرِماحِ كَأَنَّها","مِنَ الدَمِ في أَطرافِها شَجَرُ الوَردِ",1,"د",1,0],["وَعَطَفتُ نَحوَهُمُ وَصُلتُ عَلَيهِمُ","وَصَدَمتُ مَوكِبَهُم بِصَدرِ الأَبجَرِ",2,"ر",1,0],["وعطَفْنَ قُضْباً للقُدودِ نَواعِماً","بوِّئْنَ أدْواحَ النّعيمِ غُروسا",3,"س",2,0],["وَعَطاءٌ إِذا سَأَلتَ إِذا العِذ","رَةُ كانَت عَطِيَّةَ البُخّالِ",4,"ل",1,0],["وَعَطَّلتَها مِن بَعدِ ذَلِكَ كَالَّذي","نَهى نَفسَهُ أَن خالَفَتهُ يُهينها",5,"ن",3,0],["وَعَطايا يَهُزُها بِسَماحٍ","وَطِماحٍ لِمَن أَرادَ طِماحا",6,"ح",2,0],["وَعَطْفٌ عَلَى جَرْحَى عَدَدْنَا جِرَاحَهُمْ","مُكَفِّرَةً عَمَّا أَسَاءُوا وَأَجْرَمُوا",7,"م",3,0],["وعطفت الضباب أكف قوم","على فُتخ الضفادع مرئمينا",8,"ن",2,0],["وَعَطَّلت الأحكامُ حتى كأنَّنا","على مِلَّةٍ غيرِ التي نَتَنَحَّلُ",9,"ل",1,0],["وَعَطّافٍ عَلى الغَمَراتِ نَحوي","تَحُفُّ بِهِ المُشَقَّفَةُ الطِوالُ",10,"ل",1,1],["وعطَّل مغناها اتّباعاً لزهده","وإن محلاَّ بان عنه لعاطل",11,"ل",1,0],["وعطلت كتباً في الدين مارقةً","فكلّ درع كتاب قدَّ من قبل",12,"ل",1,0],["وعطلتني عن الأوزانِ أنظمها","مدحاً وما عطلت جدواه ميزاني",13,"ي",1,0],["وعطاؤُهم فوق العطاء لأنهم","يُعطون كسْب مَناصِلٍ ورماحِ",14,"ح",1,0],["وعطركمْ تَدرُس آثارهُ","ويسأم السيرَ ولا يفخر",15,"ر",1,0],["وعطَّلْتَني عما غَمرتهُمُ به","ورَيْعيَ أزكى ريعِ ما أنت عامر",16,"ر",1,0],["وعطايا كوامن في المواعي","د كُمونَ الثِّمارِ في الأكمام",17,"م",1,0],["وَعَطَفَ البازُ عَلى الغَزالِ","وَاِجتَمَعَ النَملُ عَلى الأَكّالِ",18,"ل",1,0],["وَعَطاءُ مالٍ لَو عَداهُ طالِبٌ","أَنفَقتَهُ في أَن تُلاقِيَ طالِبا",19,"ب",2,0],["وَعَطاءُ غَيرِكَ إِن بَذَل","تَ عِنايَةً فيهِ عَطاؤُك",20,"ك",1,0],["وَعَطفُ أَبي الجَيشِ الجَوادَ يَكُرُّهُ","مُدافَعَةً عَن دَيرِ مُرّانَ أَو مَقرى",21,"ر",2,0],["وَعَطايا تَأتي رِفاقاً فَيَصدُر","نَ رِفاقَ العافينَ بَعدَ الرِفاقِ",22,"ق",1,0],["وَعَطاياكَ في الفُضولِ عِدادَ الرَم","لِ مِن عالِجٍ فَكَيفَ الحُقوقِ",23,"ق",1,0],["وَعَطاءٌ مِنَ الإِلَهِ فَلا زِل","تَ مُهَنّاً ذاكَ العَطاءَ مُمَلّى",24,"ل",2,0],["وَعُطارِدٌ وَأَبوهُ مِنهُم حاجِبٌ","وَالشَيخُ ناجِيَةُ الخِضَمُّ المِصقَعُ",25,"ع",1,0],["وعطَّرَ الدُّنيا فطابت به","لا عَدِمتَ دنياكَ عَطَّارَها",26,"ر",3,0],["وعطفتَ عطفةَ قادمٍ أسيافُهُ","غُمِدَتْ على الجانين في الغفرانِ",27,"ن",1,0],["وَعَطْفُ قُلوبٍ من دُمَاها بِمَنطِقٍ","كَفيلٌ بِتأنيسِ الظباءِ الشوارِدِ",28,"د",1,0],["وَعَطَّلَ الكَأسَ مِن شَقراءَ سابِحَةٍ","أَلا كَفاها بِرَيعانِ الصِبا طَلَقا",29,"ق",2,0],["وَعُطِّلَ مِن نورِ الخِلافَةِ أُفقُهُ","فَأَمسى وَما تَنجابُ عَنهُ غَياهِبُه",30,"ب",2,0],["وعطفٌ من لدنكِ على","أسى في النفسِ فتَّاكِ",31,"ك",1,0],["وَعُطِّلَ مِن نَفسي مَكانُ رَجائِها","فَإِن لَم يَكُن مَوتٌ فَكَالمَوتِ ما بِيا",32,"ي",2,0],["وَعَطَّلنا بَجيلَةَ مِن يَزيدٍ","وَكانَ حُلِيُّهُم لا يُستَعارُ",33,"ر",1,0],["وَعَطَّلوا هَذِهِ الدُنِّيا فَما وَلَدوا","وَلا اِقتَنوا وَاِستَراحوا مِن رَزاياها",34,"ه",2,0],["وعَطْفَةٍ من صَديقٍ لا يَدومُ بها","كعَطْفَةِ اللّيلِ بينَ الصّبْحِ والفَلَقِ",35,"ق",1,0],["وعطاءٌ بلا عناء ويا رُبْ","بَ عطاءٍ جَمِّ المِطال مُعَنِّي",36,"ي",1,0],["وعَطَّلَ للفصحى يراعًا، ومنبرًا","وقوَّضَ للإِسلام صرحًا مُمرَّدَا",37,"د",2,0],["وعطّري ريحَ الصَّبا بالشَّذى","وانفتقي عن فار مسك فتيق",38,"ق",1,0],["وَعَّطْلت مِنّي مَنْطِقَ العقلِ مُلقياً","لعاطفةٍ عَمْيا زِمامَ المُتابِع",39,"ع",1,0],["وَعَطَاياكَ في الفُضُولِ عِدادُ ال","رّمْلِ من عالجٍ، فقُل في الحُقوقِ",40,"ق",1,0],["وعطفي للغريب بعيد أهلي","لأن اللَه الزم بالقريب",41,"ب",1,0],["وعطاء سيدنا مقال ممتع","في الزهد يسكرني بسحر بيانه",42,"ن",2,0],["وعطاؤُه جَزلاً لمن هو حازِمٌ","قلاّ وفيه لمِنْ رآه تَلطفُ",43,"ف",1,0],["وعطّر مسك مولده","ذرى الأرجاء وانتشرا",44,"ر",2,0],["وَعَطايا لَمّا تَعالَمَها العا","لَمُ لَم يُنكِروا لِبَحرٍ عُبابا",45,"ب",2,0],["وَعَطِيَّةً ما فازَ مَروانٌ بِها","عِندَ الرَشيدِ وَلَم يَنَلها أَشجَعُ",46,"ع",1,0],["وَعَطِّفِ النَفسَ عَلى سُبلِ الأَسا","إِن اِستَفَزَّ القَلبَ تَبريحُ الجَوى",47,"ا",1,0],["وعطرّ شعرَ صدغَيْها بمِسْكٍ","ونقّطَ وردَ خدَّيْها بخالِ",48,"ل",1,0],["وعَطَّر الدنيا بأوصافه","في الفضل حتى خَجِل القَطْر",49,"ر",1,0],["وعطفكَ اللَّدْنُ انثنى نشوةً","أم غُصُنٌ للأيكِ مَيّاس",50,"س",1,0],["وعطفك تأكيد لبرك نحونا","فلله ما احلاه عطفا مؤكدا",51,"د",2,0],["وعطفا عسى الايام تسمح باللقا","ولو مرة لو انها بغية العمر",52,"ر",1,0],["وَعَطَّلوا من رُبوعِ العِلمِ أَندِيَةً","كانت بِعَ