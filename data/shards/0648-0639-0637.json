فشى الوباء وزاد","https://www.poetsgate.com/ViewPoem.aspx?id=215392",""],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[5055,"قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=106078",""],[5061,"رسمي ولابس غترة","https://www.poetsgate.com/ViewPoem.aspx?id=153508",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5145,"ويح المعالي فقد شالت نعامتها","https://www.poetsgate.com/ViewPoem.aspx?id=108050",""],[5190,"في ذكرى ملحمة العبور","https://www.poetsgate.com/ViewPoem.aspx?id=9716",""],[5219,"نصيحتي","https://www.poetsgate.com/ViewPoem.aspx?id=194910",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5274,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203694",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[5324,"المرأة الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=210925",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[2079,"إلى كم أداري والحبيب نفور","https://www.poetsgate.com/ViewPoem.aspx?id=123849",""],[5431,"بريد مستعجل لمحمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=208569",""],[5436,"زفرات(على لسان العراق)للشاعر إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=129741",""],[5442,"أيها السائل الذي رزق التوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=114767",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5473,"كم قلت إِذْ عذر من","https://www.poetsgate.com/ViewPoem.aspx?id=189608",""],[5497,"فروا إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=210920",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5943,"إلى من رخصت نفسها فخسرتها","https://www.poetsgate.com/ViewPoem.aspx?id=61959",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[5956,"لله درك من ذواقة وناقدة","https://www.poetsgate.com/ViewPoem.aspx?id=215549",""],[6084,"حيت تزف سلافة الصهباء","https://www.poetsgate.com/ViewPoem.aspx?id=170811",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6213,"العربية الصامدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81775&r=&rc=84",""],[5957,"دموع الانتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82572&r=&rc=116",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""],[4222,"لائم للمحب غير ملائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52884&r=&rc=176",""]],"verses":[["وَعَطاءٌ تَزَيَّدَ البَحرَ يَعلو","كُلَّما قيلَ قَد بَلَغتَ مُناكا",0,"ك",2,0],["وَعَطَّفَ خِرصانَ الرِماحِ كَأَنَّها","مِنَ الدَمِ في أَطرافِها شَجَرُ الوَردِ",1,"د",1,0],["وَعَطَفتُ نَحوَهُمُ وَصُلتُ عَلَيهِمُ","وَصَدَمتُ مَوكِبَهُم بِصَدرِ الأَبجَرِ",2,"ر",1,0],["وعطَفْنَ قُضْباً للقُدودِ نَواعِماً","بوِّئْنَ أدْواحَ النّعيمِ غُروسا",3,"س",2,0],["وَعَطاءٌ إِذا سَأَلتَ إِذا العِذ","رَةُ كانَت عَطِيَّةَ البُخّالِ",4,"ل",1,0],["وَعَطَّلتَها مِن بَعدِ ذَلِكَ كَالَّذي","نَهى نَفسَهُ أَن خالَفَتهُ يُهينها",5,"ن",3,0],["وَعَطايا يَهُزُها بِسَماحٍ","وَطِماحٍ لِمَن أَرادَ طِماحا",6,"ح",2,0],["وَعَطْفٌ عَلَى جَرْحَى عَدَدْنَا جِرَاحَهُمْ","مُكَفِّرَةً عَمَّا أَسَاءُوا وَأَجْرَمُوا",7,"م",3,0],["وعطفت الضباب أكف قوم","على فُتخ الضفادع مرئمينا",8,"ن",2,0],["وَعَطَّلت الأحكامُ حتى كأنَّنا","على مِلَّةٍ غيرِ التي نَتَنَحَّلُ",9,"ل",1,0],["وَعَطّافٍ عَلى الغَمَراتِ نَحوي","تَحُفُّ بِهِ المُشَقَّفَةُ الطِوالُ",10,"ل",1,1],["وعطَّل مغناها اتّباعاً لزهده","وإن محلاَّ بان عنه لعاطل",11,"ل",1,0],["وعطلت كتباً في الدين مارقةً","فكلّ درع كتاب قدَّ من قبل",12,"ل",1,0],["وعطلتني عن الأوزانِ أنظمها","مدحاً وما عطلت جدواه ميزاني",13,"ن",2,0],["وعطاؤُهم فوق العطاء لأنهم","يُعطون كسْب مَناصِلٍ ورماحِ",14,"ح",1,0],["وعطركمْ تَدرُس آثارهُ","ويسأم السيرَ ولا يفخر",15,"ر",1,0],["وعطَّلْتَني عما غَمرتهُمُ به","ورَيْعيَ أزكى ريعِ ما أنت عامر",16,"ر",1,0],["وعطايا كوامن في المواعي","د كُمونَ الثِّمارِ في الأكمام",17,"م",1,0],["وَعَطَفَ البازُ عَلى الغَزالِ","وَاِجتَمَعَ النَملُ عَلى الأَكّالِ",18,"ل",1,0],["وَعَطاءُ مالٍ لَو عَداهُ طالِبٌ","أَنفَقتَهُ في أَن تُلاقِيَ طالِبا",19,"ب",2,0],["وَعَطاءُ غَيرِكَ إِن بَذَل","تَ عِنايَةً فيهِ عَطاؤُك",20,"ك",1,0],["وَعَطفُ أَبي الجَيشِ الجَوادَ يَكُرُّهُ","مُدافَعَةً عَن دَيرِ مُرّانَ أَو مَقرى",21,"ر",2,0],["وَعَطايا تَأتي رِفاقاً فَيَصدُر","نَ رِفاقَ العافينَ بَعدَ الرِفاقِ",22,"ق",1,0],["وَعَطاياكَ في الفُضولِ عِدادَ الرَم","لِ مِن عالِجٍ فَكَيفَ الحُقوقِ",23,"ق",1,0],["وَعَطاءٌ مِنَ الإِلَهِ فَلا زِل","تَ مُهَنّاً ذاكَ العَطاءَ مُمَلّى",24,"ل",2,0],["وَعُطارِدٌ وَأَبوهُ مِنهُم حاجِبٌ","وَالشَيخُ ناجِيَةُ الخِضَمُّ المِصقَعُ",25,"ع",1,0],["وعطَّرَ الدُّنيا فطابت به","لا عَدِمتَ دنياكَ عَطَّارَها",26,"ر",3,0],["وعطفتَ عطفةَ قادمٍ أسيافُهُ","غُمِدَتْ على الجانين في الغفرانِ",27,"ن",1,0],["وَعَطْفُ قُلوبٍ من دُمَاها بِمَنطِقٍ","كَفيلٌ بِتأنيسِ الظباءِ الشوارِدِ",28,"د",1,0],["وَعَطَّلَ الكَأسَ مِن شَقراءَ سابِحَةٍ","أَلا كَفاها بِرَيعانِ الصِبا طَلَقا",29,"ق",2,0],["وَعُطِّلَ مِن نورِ الخِلافَةِ أُفقُهُ","فَأَمسى وَما تَنجابُ عَنهُ غَياهِبُه",30,"ب",2,0],["وعطفٌ من لدنكِ على","أسى في النفسِ فتَّاكِ",31,"ك",1,0],["وَعُطِّلَ مِن نَفسي مَكانُ رَجائِها","فَإِن لَم يَكُن مَوتٌ فَكَالمَوتِ ما بِيا",32,"ي",2,0],["وَعَطَّلنا بَجيلَةَ مِن يَزيدٍ","وَكانَ حُلِيُّهُم لا يُستَعارُ",33,"ر",1,0],["وَعَطَّلوا هَذِهِ الدُنِّيا فَما وَلَدوا","وَلا اِقتَنوا وَاِستَراحوا مِن رَزاياها",34,"ه",2,0],["وعَطْفَةٍ من صَديقٍ لا يَدومُ بها","كعَطْفَةِ اللّيلِ بينَ الصّبْحِ والفَلَقِ",35,"ق",1,0],["وعطاءٌ بلا عناء ويا رُبْ","بَ عطاءٍ جَمِّ المِطال مُعَنِّي",36,"ن",2,0],["وعَطَّلَ للفصحى يراعًا، ومنبرًا","وقوَّضَ للإِسلام صرحًا مُمرَّدَا",37,"د",2,0],["وعطّري ريحَ الصَّبا بالشَّذى","وانفتقي عن فار مسك فتيق",38,"ق",1,0],["وَعَّطْلت مِنّي مَنْطِقَ العقلِ مُلقياً","لعاطفةٍ عَمْيا زِمامَ المُتابِع",39,"ع",1,0],["وَعَطَاياكَ في الفُضُولِ عِدادُ ال","رّمْلِ من عالجٍ، فقُل في الحُقوقِ",40,"ق",1,0],["وعطفي للغريب بعيد أهلي","لأن اللَه الزم بالقريب",41,"ب",1,0],["وعطاء سيدنا مقال ممتع","في الزهد يسكرني بسحر بيانه",42,"ن",2,0],["وعطاؤُه جَزلاً لمن هو حازِمٌ","قلاّ وفيه لمِنْ رآه تَلطفُ",43,"ف",1,0],["وعطّر مسك مولده","ذرى الأرجاء وانتشرا",44,"ر",2,0],["وَعَطايا لَمّا تَعالَمَها العا","لَمُ لَم يُنكِروا لِبَحرٍ عُبابا",45,"ب",2,0],["وَعَطِيَّةً ما فازَ مَروانٌ بِها","عِندَ الرَشيدِ وَلَم يَنَلها أَشجَعُ",46,"ع",1,0],["وَعَطِّفِ النَفسَ عَلى سُبلِ الأَسا","إِن اِستَفَزَّ القَلبَ تَبريحُ الجَوى",47,"ا",1,0],["وعطرّ شعرَ صدغَيْها بمِسْكٍ","ونقّطَ وردَ خدَّيْها بخالِ",48,"ل",1,0],["وعَطَّر الدنيا بأوصافه","في الفضل حتى خَجِل القَطْر",49,"ر",1,0],["وعطفكَ اللَّدْنُ انثنى نشوةً","أم غُصُنٌ للأيكِ مَيّاس",50,"س",1,0],["وعطفك تأكيد لبرك نحونا","فلله ما احلاه عطفا مؤكدا",51,"د",2,0],["وعطفا عسى الايام تسمح باللقا","ولو مرة لو انها بغية العمر",52,"ر",1,0],["وَعَطَّلوا من رُبوعِ العِلمِ أَندِيَةً","كانت بِعَلياهُ يومَ الفَخرِ تَفتَخِر",53,"ر",1,0],["وعطل كل فاتنة","من الإغراء والسحر",54,"ر",1,0],["وَعِطاشُ آمالي وَهُنَّ حَوائِمٌ","لَولاكُمُ ما ذُقنَ يَومَ شُروعِ",55,"ع",1,0],["وَعَطِيَّةٍ بِكرٍ يَجِلُّ حِباؤُها","عَن أَن يُثَمَّلَ بِالحَبِيِّ الباكِرِ",56,"ر",1,0],["وعطّر بروح الروح راحي وكأسه","وكرّر فدتك الروح يا أيّها الساقي",57,"ق",2,0],["وَعطر افق الارض من عرف عرفه","وان عماد الدين في بطن كفه",58,"ه",1,0],["وَعُطِّلَتِ البيضُ الصِفاحُ وَأُهمِلَت","مُتونُ العَوالي في الكِفاحِ مِنَ الأَطَر",59,"ر",1,0],["وعطفيك لا تنظر رداء