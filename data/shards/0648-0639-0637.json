,79,"ر",2,0],["وعَطَّت القُورَ والأجراعَ نوقُكُمُ","طُروحَ عيني وحالت بيننا الكثُبُ",80,"ب",1,0],["وعَطِّرْ ضَريحاً حَفَّهُ فَثَوى به","بِعِطْرٍ يَعُمُّ العَرْشَ والفَرْشَ بالنَّشْرِ",81,"ر",1,0],["وعَطِّلي الحُزنَ وتيهي طَرباً","وبِفَسيحِ رُحْبنا تَبَحْبَحي",82,"ي",1,0],["وعطّلْتَ بئرَ الظُلْمِ حتّى تهدّمتْ","فأصبحَ قصْرُ العدلِ وهْوَ مَشيدُ",83,"د",1,0],["وعَطايا جديدةٍ","تُقتَفَي منه بالأَجَد",84,"د",1,0],["وعطاءٍ يُخجلُ الدَّر","راتِ من ماء الغَمامِ",85,"م",1,0],["وعطفتُكم أُدنِي إليَّ وِصالَكم","فكأنّني أُدني به العَيُّوقا",86,"ق",2,0],["وَعَطاءٌ خَلفه مِن","هُ اِبتِزازٌ واِستِلابُ",87,"ب",1,0],["وعطاياه بلا علل","وكذا الحرمان والنعم",88,"م",1,0],["وعطرت الأنفاس مني بنفحها","جميع الورى حتى استطيبت مصانع",89,"ع",1,0],["وعطايا من المهيمن دلت","أنه الله فاعل مختار",90,"ر",1,0],["وعِطْراً طاشَ في صمتِ المقاهيْ","تُسرِّبُهُ من الماضيْ ثقوبُ",91,"ب",1,0],["وعطّلت معالم الأحكام","ونزل المكروه بالإسلام",92,"م",1,0],["وعِطْفٌ فيه تفتيت","وجَفْنٌ فيه تفتيرْ",93,"ر",1,0],["وعَطِّر لفْظِي في الحَديثِ سُلوكُه","على قُبلةٍ قد كان أَوْدَعَها فَمي",94,"م",2,0]]}