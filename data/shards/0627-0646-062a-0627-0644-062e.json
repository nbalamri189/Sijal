{"poems":[[57,"يا من يلوم على هوى","https://www.aldiwan.net/poem26385.html","مجزوء الكامل"],[29,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[74,"أوجز مديحك فالمقام عظيم","https://www.aldiwan.net/poem19667.html","الكامل"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[81,"أنتَ الخصيبُ وهذه مصر","https://www.aldiwan.net/poem29559.html","الكامل"],[87,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[132,"أبلعرب الملك الإمام العادل","https://www.aldiwan.net/poem50537.html","الكامل"],[132,"أبلعرب الملك الهمام العادل","https://www.aldiwan.net/poem50543.html","الكامل"],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[164,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[275,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[280,"فتح البسيطة عنكم محكي","https://www.aldiwan.net/poem25548.html","أحذ الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[447,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[567,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"],[567,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[567,"أنت الخليل وفي الأطلال برد لظى","https://www.aldiwan.net/poem52975.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138322",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138247",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53914","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96704","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112738","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114771","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71060","الكامل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200346","الكامل"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131460",""],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100741","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87398","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89231","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126980","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86289","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86282","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45892","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77187","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94612","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120479","البسيط"],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5277,"ختام الخواتيم","https://www.poetsgate.com/ViewPoem.aspx?id=187287",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5453,"أم(بك)وت","https://www.poetsgate.com/ViewPoem.aspx?id=28016",""],[5853,"((أنتِ الخلود ))","https://www.poetsgate.com/ViewPoem.aspx?id=175663",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6241,"احتجاج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77051&r=&rc=9",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["أَنتَ الخَلِيُّ مِنَ الَّذي","يَلقى الشَقِيُّ المُقصَدُ",0,"د",1,0],["أَنتَ الخَليفَةُ لِلرَحمَنِ يَعرِفُهُ","أَهلُ الزَبورِ وَفي التَوراةِ مَكتوبُ",1,"ب",1,0],["أنتَ الختام لهم وأنتَ فخارهم","وبمسكِه فليفخر المختوم",2,"م",1,0],["أَنتَ الخَليفَةُ حِلمُهُ وَفَعالُهُ","وَإِذا أَرَدتَ لِظالِمٍ تَنكيلا",3,"ل",2,0],["أنتَ الخصيبُ وهذه مصر","فتدفّقا فكلاكما بحرُ",4,"ر",1,1],["أَنتِ الخيالُ : بديعُهُ ، وغريبُه","اللهُ صاغك ، والزمانُ رَواكِ",5,"ك",1,0],["أنتِ الخِزانَةُ للزّمانِ وَرَيْبهِ","إن حَلَّ صعبٌ أو ألَمَّ عَسيرُ",6,"ر",1,0],["أنت الخضمُّ الزاخرُ البحرُ الذي","من جودِه خجل الأنىُّ النائلُ",7,"ل",1,0],["أنت الخصمُّ الزاخرُ العذبُ الذي","من جوده خَجِلُ الأنىُّ السائلُ",8,"ل",1,0],["أنت الخلائقُ والدنيا وبهجتها","لولاكَ ما كانت الدنيا ولا البشَرُ",9,"ر",1,0],["أنت الخليل لأنفس منا فما اشت","قت وحقك سيبويه زمان هب",10,"ب",1,0],["أنتِ الخفيفة والأعناقُ مثقلةٌ","أنتِ اللطيفةُ والأعلاجُ أعداك",11,"ك",1,0],["أنتَ الخليفَة لا خِلافَ وهَلْ","نُورُ النهارِ من الدُّجَى الحُلْكِ",12,"ك",1,0],["أَنتَ الخليفةُ في الوجودِ جميعه","وَبكَ اِنطوى ما في الوجود موسّعُ",13,"ع",1,0],["أنت الخطيب الذي طاع الخطيب له","هيهات مثلك من باق من السلف",14,"ف",1,0],["أنتَ الخَليقُ بأنْ يَزُورَكَ ماشياً","مَن زارَ آثارَ الزَّمانِ الأوَّلِ",15,"ل",1,0],["أنتَ الخَيالُ تَزُورُ مثلَكَ في الضَّنَى","لو كانَ مِثلَكَ في خُفوقِ الطَّائرِ",16,"ر",1,0],["أنت الخليلُ وفي الأطلال بردُ لظىً","أطلالِ عكَّا ورَفضُ الرُعْبِ والحَذَرِ",17,"ر",1,1],["أنت الخضم العظيم البحر بحر لهى","للاستقا منه كل العالمين سعت",18,"ت",1,0],["أنت الخليق بكل مدح رائق","نثرا حلت أسجاعه وقصيدا",19,"د",2,0],["أنت الخطيب المصقع المقوال من","كلماته هزت من القلب الوتر",20,"ر",1,0],["أنت الخبيرُ بحلِّ المشكلاتِ إذا","كانت مسائلُها تَعْيَى عن البَشَرِ",21,"ر",1,0],["أَنتَ الخطيبُ لدى أهلِ العلوم وفي","شَوامخِ المجدِ أنت الحاذق الوقلُ",22,"ل",1,0],["انت الخبير بما يكون وما جرى","انت الحليم فلا ترد سؤالي",23,"ل",2,0],["أَنتَ الخَبيرُ عن الجِنانِ وإنَّهُ","لولا المهابَةُ قُلتُ شَوقاً خَبِّر",24,"ر",1,0],["أَنتَ الخبيرُ بصِدْقِ ما أَنا قائِلٌ","وإِن اسْتَرَبْتَ بصِدْقِهِ فاستخبر",25,"ر",1,0],["أنت الخلي ولو لبست من الهوى","حللا لجئت كما العري الحافي",26,"ف",2,0],["أنت الخليل وانا الكليم بالحد","من سيف مقله فاتره قويه",27,"ي",2,0],["أنتَ الخليلُ فلا تجزَع لنارِ هوى","في القلب منى ولا من حرّ أحشائي",28,"ا",2,0],["أنت الخطيب الذي إن قال أفحمهم","يوم النضال وأجثى القوم إن قاما",29,"م",2,0],["انتَ الخَليفةُ للالهِ وظِلُّهُ","وَعَلى عباد اللَه قمتَ رَقيبا",30,"ب",2,0],["أنت الخبير ولا أعلّم مثله","لا ملك إلا بعد طول ينزع",31,"ع",1,0],["أنت الخليل فلا ضل سواك فصل","قلبا ببعدك يصلى نار نمرود",32,"د",1,0],["انتَ الخَبيرُ بِدَهر يا اخا ادَب","وَما عَلَيهِ اِنطَوَت غَدراً سَجاياهُ",33,"ا",2,0],["انتَ الخَبيرُ بِدار الدَهرِ تَعرِفُهُ","هَيهاتَ يَرعي لاِهل الفَضلِ من ذِمَم",34,"م",1,0],["أَنتَ الخَليل وَلَكن لَو بَعَثت لَنا","لَقُلت قَد جئت يا موسى على قَدَر",35,"ر",1,0],["أَنتَ الخَليقُ بِفَضلِ صرت مُنفَرِداً","بِهِ وَشَمس ذَكاء عَينِه اِتقدت",36,"ت",1,0],["أَنت الخَبير بِحالي وَالبَصيرُ بِهِ","فَاِفتَج لِهذا الدعا بابَ الاِجابات",37,"ت",1,0],["أنت الخير وعالمٌ بسريرتي","وسموت خبراً في الأنام ومخبرا",38,"ر",2,0],["أنت الخصم لعلم لا مرآء به","فكنه للحلم وامنحني تغاضيكا",39,"ك",2,0],["أنت الخليل ذبحتنى وفديتنى","واليوم لا فادٍ ولا متعطفُ",40,"ف",1,0],["أنتُ الختامُ وما إنْ ثمَّ منْ أَحَدٍ","يلاعبُ الروحَ أو يأتي ليغشانا",41,"ن",2,0],["انت الخلاص الذي نرجو عوارفه","فان رضيت فان العز مكفول",42,"ل",1,0],["انت الخطر وإلا الخطر من خيالك","غديت لسهوم الخطر تقل نبراس",43,"س",1,0],["أنتِ الخلود وما أنا الإكِ في","قلبي ووجداني شذا الأزهارِ",44,"ر",1,0],["أنتَ الخليفَةُ فِي الدُّنَا طُوبَى لمَنْ","أثرَى الحياةَ بسَاعدَيهِ وَ عَمَّرَا",45,"ر",2,0],["أنت الخبير بسحر القول معذرة","فاذكر أخاك بخير في مناجاتك",46,"ك",1,0],["أنتَ الخلودُ فما فمِي لِيقُولا؟","ألِقولتي أنْ تبلُغَ التَّنزيلا؟",47,"ل",2,1]]}