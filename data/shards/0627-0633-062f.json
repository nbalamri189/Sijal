html","الطويل"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[461,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[461,"أسد بات يتقي سورة الذئ","https://www.aldiwan.net/poem15969.html","الخفيف"],[461,"أسد الدين والنداء لغيرا","https://www.aldiwan.net/poem16178.html","الخفيف"],[461,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[464,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[464,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[464,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[464,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[464,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"],[464,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[464,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[464,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[464,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[475,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[500,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[500,"ته غراما فللغرام رجال","https://www.aldiwan.net/poem37808.html","الخفيف"],[500,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[500,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[500,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[514,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[514,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[514,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[514,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[538,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[540,"أسد في الغيل يحمي أشبلا","https://www.aldiwan.net/poem56678.html","الرمل"],[540,"أألحمامة في نخل ابن هداج","https://www.aldiwan.net/poem56877.html","البسيط"],[542,"أسد رابض حواليه أسد","https://www.aldiwan.net/poem34039.html","الخفيف"],[551,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[567,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[584,"من حس لي الأخوين كالغصنين","https://www.aldiwan.net/poem69383.html","مجزوء الكامل"]],"verses":[["أُسدٌ كَأَنَّ عَلى سَنابِكِ خَيلِهِم","يَومَ اللِقاءِ مُسِفَّةَ العِقبانِ",0,"ن",1,0],["أُسدٌ بَرى الإِسادُ نَحضَ جِيادِهِم","بِالكَرِّ وَالتَضرابِ وَالتَطعانِ",1,"ن",1,0],["أَسُدُّ سَمعي إِذا غَنّى الحَمامُ بِهِ","إِلّا يُبَيِّنَ سِرَّ الوَجدِ إِعلانُ",2,"ن",1,0],["أُسداً تَراها عِندَهُ بِهاما","شُلَّت يَدُ الجاذِبِ ماذا راما",3,"م",2,0],["أَسَدٍ إِذا بَصُرَ الرِجالُ بِهِ","خُفِضَ الكَلامُ وَطومَنَ الشَخصُ",4,"ص",1,0],["أُسدٌ إِذا جَرَّ القَبائِلَ خَلفَهُ","حَلَّ الطُلى بِلِوائِهِ المَعقودِ",5,"د",1,0],["أَسَدٌ في اللِقاءَ وَردٌ هَموسٌ","وَرَبيعٌ إِن شَنَّعَت غَبراءُ",6,"ا",2,0],["أسَدُ الهَياجِ إذا خَطا قُدُماً سَطا","فيُخلِّفُ الأسَدَ الهِزَبْرَ فَريسا",7,"س",2,0],["أُسُدُ الشَّرَى سُرُجُ الْوَرَى فَمَقَامُهُمْ","للهِ بَيْنَ مُحَارِبٍ وَحُرُوبِ",8,"ب",1,0],["أَسُدُّ إِذا اِستَدبَرتُهُ مِنهُ فُرجَةً","بِضافٍ فُوَيقَ الأَرضِ لَيسَ بِأَعزَلِ",9,"ل",1,0],["أُسدٌ مَخالِبُها بيضُ الظُبى وَلَها","مِنَ الذَوابِلِ غيلٌ نَبتُهُ أَشِبُ",10,"ب",1,0],["أُسدٌ فَرائِسُها الفَوارِسُ في الوَغى","لَكِن بَراثِنُها هُناكَ صِعادُ",11,"د",1,0],["أَسَداً تَناذَرَهُ الرِفاقُ ضُبارِماً","شَثنَ البَراثِنِ لاحِقَ الأَقرابِ",12,"ب",1,0],["أَسَدانِ مُحمَرّا المَخالِبِ نَجدَةً","بَحرانِ في الزَمَنِ الغَضوبِ الأَنمَرِ",13,"ر",1,1],["أسدت إلي جميلاً","وما قضيت نصابه",14,"ب",2,0],["أُسدٌ إِذا لَحِقوا بِالخَيلِ لَم يَقِفوا","نِعمَ الفَوارِسُ لا عُزلٌ وَلا ميلُ",15,"ل",1,0],["أُسدُ حَربٍ غُيوثُ جَدبٍ بَهَالِي","لُ مَقَاوِيلُ غَيرُ ما أفدَامِ",16,"م",1,0],["أسدى الرغائب حتَّى ما يشاركُه","في لفظها غيرُ هذا العشرِ من رجب",17,"ب",1,0],["أسدٌ تآلفني الظباءُ وتختشي","من صارمي الصقر الغيور ذبابا",18,"ب",2,0],["أسدّ بطول اللثم فاها مخافةً","على ليلتي أن يهجم الثغر بالصبح",19,"ح",1,0],["أسدى إليك القومُ مع","روفاً فلم تحسن ثوابهْ",20,"ب",2,0],["أسديتَ أمراً فألْحِمْهُ بلُحمته","لنا وسبَّبْت فاجدُل مِرَّةَ السَّببِ",21,"ب",1,0],["أسدَى وألحمتُ أخٌ لم أزل","أحمدُ ما سدَّى وما سبَّبا",22,"ب",2,0],["أسدى إليَّ أبو الحسين يدا","أرجو الثوابَ بها لديه غدا",23,"د",2,1],["أسدٌ مضى وتخلفتْ أشبالُه","وعليَّ أن تستأسِدَ الأشبالُ",24,"ل",1,0],["أسدٌ إذا أسرى لمُقْتنِصٍ","أسرى من الخطِّيِّ في أجَمِ",25,"م",1,0],["أسدِ إلى البينِ كل عارفةٍ","يَجْزِك من سيِّئٍ بضعفين",26,"ن",1,0],["أَسدَيتُهُ نُصحي فَزادَ تَمادِياً","في غَيِّهِ وَاِزدادَ فيهِ بَلائي",27,"ي",1,0],["أَسَدُ الرُخامِ وَإِن حَكى في شَكلِهِ","شَكلَ الغَضَنفَرِ لَيسَ بِالفَرّاسِ",28,"س",1,0],["أُسدٌ تَجولُ بِغَيرِ ظُف","رٍ أَو تَصولُ بِغَيرِ نابِ",29,"ب",1,0],["أَسَدٌ وَراءَ السِنِّ مَعقودُ الحُبا","يَأبى وَيَغضَبُ لِلشَرى وَيَغارُ",30,"ر",1,0],["أَسدَلَ الطَرفَ كاهِنٌ وَمَليكٌ","في ثَراها وَأَرسَلَ الرَأسَ خَفضا",31,"ض",2,0],["أَسدَت إِلى أَهلِ الجُنو","دِ يَداً وَغالَت في الحِفايَه",32,"ا",3,0],["أَسَدٌ هَصورٌ أَنشَبَ ال","أَظفارَ في أَسَدٍ هَصور",33,"ر",1,0],["أَسَدٌ لَعَمرُكَ مَن يَموتُ بِظُفرِهِ","عِندَ اللِقاءِ كَمَن يَموتُ بِنابِهِ",34,"ب",2,0],["أُسْدٌ يَرَوْنَ الرَّدى المُفْضي بأَنْفُسِهِمْ","إلى الثّرَى عُمُراً يُفْضِي إلى الهَرَمِ",35,"م",1,0],["أُسُدٌ فَرائِسُها الأُسودُ يَقودُها","أَسَدٌ تَصيرُ لَهُ الأُسودُ ثَعالِبا",36,"ب",2,0],["أَسَدٌ دَمُ الأَسَدِ الهِزَبرِ خِضابُهُ","مَوتٌ فَريصُ المَوتِ مِنهُ تُرعَدُ",37,"د",1,0],["أَسَدٌ يَرى عُضوَيهِ فيكَ كِلَيهِما","مَتناً أَزَلَّ وَساعِداً مَفتولا",38,"ل",2,0],["أَسَدٌ يُبدِعُ في أَعدائِهِ","سَطوَةً ما يَتَعاطاها الأَسَد",39,"د",1,0],["أَسَدٌ يَركَبُ السُيوفَ إِذا ما","قَلَّ تَحتَ السُيوفِ صَبرَ الأُسودِ",40,"د",1,0],["أُسَدُّ بِقُربٍ مِن مُلِمٍّ مُسَلِّمِ","وَأَشجى بِبَينٍ مِن حَبيبٍ مُوَدِّعِ",41,"ع",1,0],["أَسَدٌ إِذا فَرَسَت يَداهُ أَخيذَةً","لِلمَجدِ زاوَلَ مِثلَها شِبلاهُ",42,"ا",2,0],["أَسَدَّ لَكُم شُكراً وَخَيرَ مَوَدَّةٍ","إِذا ما اِلتَقَت رُكبانُ غَربٍ وَمَشرِقِ",43,"ق",1,0],["أَسَدٌ في الحديدِ تَستَوحِشُ الأُسْ","دُ لدَيهِ ويأنَسُ الزُّوَّارُ",44,"ر",1,0],["أُسْدٌ إذا ما سلَبَت أُسْدَ الوَغى","أنفسَها عَافت نفيساتِ السَّلَبْ",45,"ب",1,0],["أَسْدٌ إذا حاولتْ أرضَ العِدا حمَلتْ","على الكواهلِ غَاباً لِلْقنَا أَشَبَا",46,"ب",2,0],["أَسَدٌ خَلَّفَ شِبلَي عَرينٍ","شَيَّدا مَجداً لَهُ لَن يُنالا",47,"ل",2,0],["أُسدٌ رَوَت يَومَ الهِياجِ أَكُفُّهُم","بِدَمِ الأُسودِ ثَعالِبَ الخِرصانِ",48,"ن",1,0],["أُسْدٌ كأنّ سكونَها متحرّكٌ","في النفس لو وجدتْ هناك مثيرا",49,"ر",2,0],["أسَدٌ على الفُرْسانِ يَفْرِسُها","عندَ انقِراضِ الأمنِ بالوجَلِ",50,"ل",1,0],["أسَدَدْتِ مسراه فلم يُطِقِ السُّرَى","أمْ باتَ عِندَكِ نائِماً عن ساهِرِ",51,"ر",1,0],["أَسدٍ تَحسبُ في عامِلِه","أَسْوَداً يَنهَشُ أَعضاءَ الحُقود",52,"د",1,0],["أُسْدٌ عَلَيهِم من جُلودِ أَراقمٍ","قُمُصٌ أزِرّتُها عيونُ جرادِ",53,"د",1,0],["أُسْدٌ لَبُوسُهُمُ جلودُ أراقمٍ","بُهِتَتْ لرؤيتها عيونُ جَرَاد",54,"د",1,0],["أسَدُ الرّوع الذي حِمْلاقُهُ","يُرْسِلُ اللحظةَ موتاً فَيُهاب",55,"ب",1,0],["أُسدُ عَرينٍ إِذا ما الرَوعُ صَبَّحَها","أَو صَبَّحَتهُ وَلَكِن غَابُها الأَسَلُ",56,"ل",1,0],["أَسَدانِ شَدّا مِن دِمَشقَ وَذَلَّلا","مِن حِمصَ أَمنَعَ بَلدَةٍ عِرّيسا",57,"س",2,0],["أسدُّ من السهامِ مضاءَ أمرٍ","وأجرى في الخطوبِ من الرياحِ",58,"ح",1,0],["أَسدى وَشَيَّدَ ما اِستَطاعَ وَإِنَّما","أَسدى المِدادَ وَشَيَّدَ الأَوراقا",59,"ق",2,0],["أسديتَها يا ابنَ سعدٍ خيرَ عارفةٍ","جاءَتْ على قَدَرٍ في خيرِ إبّانِ",60,"ن",1,0],["أسُدُّ عليكمُ الأسواقَ حتّى","يَصيحَ جِياعُكم أينَ الطّعامُ",61,"م",1,0],["أسْدَى الجميلَ ومَنَّ يأ","خُذُ نَفْسَهُ بالمكرماتِ",62,"ت",1,0],["أَسدُ اللّهِ رماهُ ثَعلبٌ","يا له من حادثٍ ما أبدعا",63,"ع",2,0],["أَسَدٌ فَوقَ ضامر عَرَبي","شاهر لِلوَغى حساماً يَماني",64,"ن",2,0],["أَسَدٌ بَدا مِن غابِهِ فَتَضَعضَعَت","مِنهُ الثَعالِبُ عِندَ شَدٍّ صادِقِ",65,"ق",1,0],["أُسدٌ فَرائِسُها الفَوارِسُ لا تَطا","إِلّا عَلى الأَقرانِ يَومَ حُروبِها",66,"ب",3,0],["أُسْدٌ إذا زارت وِجارَ ثعالِبٍ","ما إنْ لهَا إلاّ القلوبَ وِجار",67,"ر",1,0],["أَسَداً باسِطاً ذِراعَيهِ يَعدو","أَهرَتَ الشِدقِ كالِحَ الأَنيابِ",68,"ب",1,0],["أَسَدٌ يُرقِدُ نيرانَ الوَغى","وَإِذا زَلزَلَهُ الرَوعُ وَقَر",69,"ر",1,0],["أَسَدِيٌّ إِذا تَرَجَّفَ وَاِنشَق","قَ سَناهُ أَكَلَّ طَرقَ البَصيرِ",70,"ر",1,0],["أَسَدُ الخَليفَةِ تَلتَقي","بِشَباتِهِ نَحرُ المَكايِد",71,"د",1,0],["أَسَدٌ تَصَيَّدَهُ غَزالٌ شادِنٌ","ما اِصطادَ قَبلَكِ شادِنٌ آسادا",72,"د",2,0],["أَسَدٌ يَقضُمُ الرِجالَ وَإِن شِئ","تَ فَغَيثٌ أَجَشُّ ثَرُّ السَماءِ",73,"ا",2,0],["أَسَدانِ يَفتَرِسانِ مَن","مَرّا بِهِ فَأَبَه لِذالِك",74,"ك",1,0],["أُسدُ غابٍ فَإِذا ما فَزَعوا","غَيرُ أَنكاسٍ وَلا هوجٍ هُذُر",75,"ر",1,0],["أَسَدِيَّةٌ تَرعَى الصِرَادَ إِذا","ضاقَت وَتَحضُرُ جانَبي شَعرِ",76,"ر",1,0],["أسدٌ فرائسها الأسود يقودها","أسدٌ يصير له الأسود ثعالبا",77,"ب",2,0],["أسدَلَ القلبُ دونه ألفَ سِترٍ","عبراتٍ ومثلهنَّ نجيعا",78,"ع",2,0],["أَسدى إِلَينا أَميرَ المُؤمِنينَ يَداً","جَلَّت كَما جَلَّ في الأَملاكِ مُسديها",79,"ي",3,0],["أسد العراق وما الريا","ح الهوج طاغية الهبوب",80,"ب",1,0],["أسدُ الشَرى وَاللُيوثُ تَبكي","عَلَيهِ وَالأَنجُمُ السَوامي",81,"ي",1,1],["أُسدُ الشَرى مِمّا مَلَأت عُيونها","ظَنَّت بِأَنَّ حِمى أَبيكَ الخيسُ",82,"س",1,0],["أُسْدٌ لَها من بِيضِها وسُمرِها","جَداوِلٌ مُطَّرَداتٌ وأجَمْ",83,"م",1,0],["أسدٌ في اللقاء وردٌ هموسٌ","وربيعٌ إن شمرت غبراء",84,"ا",2,0],["أسْدَى إليَّ بكَ الزَّمانُ صنيعا","فحمِدْتُ صيفاً طَيَّباً وربيعا",85,"ع",2,1],["أسد يبدع في أعدائه","سطوة ما يتعاطاه الأسد",86,"د",1,0],["أسد إلى البينِ كل عارفة ٍ","يَجْزِك من شيْ بضعفين",87,"ن",1,0],["أسدُ العرينَ إذا ما الروعُ صبحَها","أوصَبَّحْتهُ، ولكِنْ غَابُها الاسَلُ",88,"ل",1,0],["اسد نمته لآل قيس في