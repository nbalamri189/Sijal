{"poems":[[65,"زاهر العود وطيبه","https://www.aldiwan.net/poem45824.html","مجزوء الرمل"],[73,"أخلق الشعر مدلويه وأهليه","https://www.aldiwan.net/poem3829.html","الخفيف"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[90,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[53,"أغلاء وبلاء","https://www.aldiwan.net/poem65018.html","مجزوء الرمل"],[47,"غلس الشيب أو تعجل ورده","https://www.aldiwan.net/poem62743.html","الخفيف"],[47,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[50,"كلنا يا ابن حديج","https://www.aldiwan.net/poem66235.html","مجزوء الرمل"],[48,"يا أم دفر إنما أكرمت عن","https://www.aldiwan.net/poem22714.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[190,"حادثات دهمن في أسبوع","https://www.aldiwan.net/poem43630.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[264,"حادي الركب سر وحث المطيه","https://www.aldiwan.net/poem35574.html","الخفيف"],[276,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[366,"لا تأمن الدهر ان الدهر خوان","https://www.aldiwan.net/poem68052.html","البسيط"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[484,"حادث في البحر ماذا","https://www.aldiwan.net/poem36875.html","مجزوء الرمل"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[563,"إنني كن وإنني فيكون","https://www.aldiwan.net/poem33740.html","الخفيف"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64774","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64740","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136366","الخفيف"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82260","الرمل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77944","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77858","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128068","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141257","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123030","المتقارب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104802","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104823","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104796","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104805","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102137","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102156","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67280","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126205","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129966","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93778","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94273","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93781","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58513","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104678","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74307","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126298","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68091","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52979","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48276","السريع"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138646",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110229","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91992","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206144",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205658","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132095","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117855","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35571","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44697","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123489","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117285","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104541","البسيط"],[4767,"تقرير إلى صاحب العصر","https://www.poetsgate.com/ViewPoem.aspx?id=211351",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5273,"فنجان قهوة","https://www.poetsgate.com/ViewPoem.aspx?id=198524",""],[5277,"ربابٌ بلا وتر","https://www.poetsgate.com/ViewPoem.aspx?id=186503",""],[5324,"أنا لا أسميه شيا","https://www.poetsgate.com/ViewPoem.aspx?id=207173",""],[5431,"حب صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=182991",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[2110,"حسبي من الوجد ما بي أيها اللاحي","https://www.poetsgate.com/ViewPoem.aspx?id=156268",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""],[520,"ليت يوم الإثنين لم يتبسم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577506",""]],"verses":[["حاديهمُ ذو زَجَلٍ يَس","تَضحِكُ الرَوضَ نَحيبُهْ",0,"ب",2,0],["حادَ عَن مَذهَبِ التَصَوُّفِ إِلّا","كَثرَةَ الأَكلِ فيهِ وَاللوطِيَّه",1,"ه",1,0],["حادي مُخَطَّطَةٍ قُمرٍ يُسَتِّرُها","بِالصَيفِ مِن ذِروَةِ الصَمّانِ خَيشومُ",2,"م",1,0],["حادث أظلمت به الأرض واستو","حش منها حزونها والسهول",3,"ل",1,0],["حادثٌ يا آل وهب","فيه للقدرِ سُقوطُ",4,"ط",1,0],["حادَ عَنهُ المُساجِلونَ وَهابوا","حَفلَةَ البَحرِ وَالبِحارُ تَمُدُّه",5,"د",2,0],["حادَ عَن مَجدِكَ المَسامي وَأَمعَن","تَ عُلُوّاً فَصَدَّ عَنكَ الحَسودُ",6,"د",1,0],["حادَتْ بهم عن بقاع المحل جامِحَةٌ","ومن بنانِ عليّ زارَتِ الدّيَما",7,"م",2,0],["حادثٌ ذلك فيهِ","أم قديمٌ لم يزل",8,"ل",1,0],["حادِث كِتابَكَ فَهُوَ آمَنُ جانِباً","مِن أَهَلِ تَسبيدٍ وَأَهلِ وِفارِ",9,"ر",1,0],["حادِثة فِي رِيفِ مِصْرٍ جَرَتْ","وَمِثْلها فِي الرِّيفِ كم يَجْرِي",10,"ر",2,0],["حَادِثٌ رَوَّعَ العَمِيدَ أَيَخْشَا","هُ وَسُلْطَانُهُ وَطِيدُ العِمَادِ",11,"د",1,0],["حادِثٌ عَمَّ عامِراً بِالرَزايا","فَاِستَكانَت لَهُ وَخَصَّ كِلابا",12,"ب",2,0],["حادثات دهمنَ في أسبوع","صحن بالبين في محل الجميع",13,"ع",1,1],["حادثَ البدرَ وهو كان له في ال","مهدِ كالظئرِ طابَ منها الغناءُ",14,"ا",2,0],["حاديَ الركبِ سر وحثّ المطيّهْ","لديار العطا بدير العطيّهْ",15,"ي",2,1],["حادى المَطي قف المطي لعلها","تحظى بحظ من غَرام المغرم",16,"م",1,0],["حادى المَطايا بِهِم مَهلا فَبُعدُهُم","لا الناسُ ناس وَلا البُلدان بُلدان",17,"ن",1,0],["حادَ عنك اللَّعينُ فاستقبلَتْه","بِمِحالِ يُرِى اللَّعِينَ مُحالا",18,"ل",2,0],["حادثٌ صغَّر القديمَ فلا تجلبْ","بياجوج بعدها والسدِّ",19,"د",1,0],["حادث في البحر ماذا","فيه يا ابن الباي قلتا",20,"ت",2,1],["حادث ظلت الحوادث مما","شاهدته من جوره تستجير",21,"ر",1,0],["حادثات به له ظهرت","وهو حق وكلهن ظنونْ",22,"ن",1,0],["حادَ عنه المرادُ حِيناً لِكي يُع","لَمَ مقدارُه وَيُرْوى وُرُودُه",23,"د",2,0],["حادثٌ من عجايب الدهر خطبٌ","بات فيه لسان وصفي كليلا",24,"ل",2,0],["حادُوا عَنِ الحَربِ على غِرَّةٍ","فكَرَّ فيْها بَعْدَما فكَّرَا",25,"ر",2,0],["حادُوا عن الظُّلمِ ولولا سُطاً","تَحدُّهُمْ عنهُ لَمَا حادُوا",26,"د",3,0],["حادي العيس ان مررت بنجد","بلغ الساكنين لسنى التحيه",27,"ي",2,1],["حادِي الجَنوبِ فحَدَت كَمَا حَدا","يُؤمَنُ عِندَ سَحِّهِ مِن حَشكِهِ",28,"ه",1,0],["حادِثٌ في الأَرضِ يَرتا","عُ لَهُ أَهلُ السماءِ",29,"ا",2,0],["حادي العيس ترفق بالحشا","فلقد أودى بقلبي ذا الهوي",30,"ي",1,0],["حادي المَطايا بهم","خذ بي إِلى قربهم",31,"م",1,1],["حادي الحداة حدا لكم وَدعا بكم","داعي الدعاة فأنصتوا بِيَقين",32,"ن",1,0],["حادث الدهر بالمنون يفاجى","والبرايا من ريبه في انزعاج",33,"ج",1,1],["حادثات الدّهر جلّت حكمة","منكم للشعب إذ كان نسيّا",34,"ي",2,0],["حاد عن سنة النبي فأوصى","أم بترك الوصاة قد جاراها",35,"ا",3,0],["حاد عما كانا عليه أقاما","أبيا ملة الهدى أم أباها",35,"ا",3,0],["حادي الأظعان فقف بهما","وانشُد قلباً منّي شردا",36,"د",2,0],["حَادِى النِّياقِ إِلَى خَيرِ البَرِيَّاتِ","مَهلاً فإِنِّىَ ذُو شُغلٍ وَحاجاتِ",37,"ت",1,0],["حادِيهِمِ لَو عَرَفتَ البَينَ لَوعَتَهُ","عَذلتَ صَبًّا بَكى فِى ظُلمَةِ السَّحَرِ",38,"ر",1,0],["حادِياً لِلعِيسِ قِف ثُمَّ احمِلَن","لِى تَحِيَّاتٍ إِلَى خَيرِ الوَرَى",39,"ر",2,1],["حَادِى النِّياقِ هَل دُعائِى تَسمَعُ","وَتُغِيثُ لِلمَلهُوفِ ثُمَّ وَتُسرِعُ",40,"ع",1,0],["حادي المطايا بالمولى سلّم","على المُعَظّم على المعظّم",41,"م",1,0],["حادي السُرى عرِّج لنحو الطائفِ","لتحوزَ كلّ مكارمٍ ولطائفِ",42,"ف",1,0],["حادوهُ عنه بقلبٍ للأوام يحن","قد حرَّموه عليه في الحياة ومن",43,"ن",1,0],["حادِيَ العيسِ ليتنى أسترِيحُ","قف رويداً فقد يضامُ النَجِيحُ",44,"ح",1,1],["حاديَ العيس كم تنيخُ المطايا","سق فروحي من من بعدهِم في سياقِ",45,"ق",1,1],["حادي العيس نحو سربي سر بي","على يوما ينال فيه العلاء",46,"ا",2,0],["حادي العيس كم بنشر خطاها","تبتغي طي شقة الأسفار",47,"ر",1,0],["حادي العيس قف عسى أن أملي","بحبيبي هيهات للترجاع",48,"ع",1,0],["حادي العيس جد بنشر خطاها","إن في نشرها لطيّ الفيافي",49,"ف",2,0],["حادي العيس سر وحث المطايا","لا تكلها إلى الكلال الغريزي",50,"ز",2,0],["حادي العيس قف نطف بمقامٍ","لوعتي فيه تنطفي بالطواف",51,"ف",1,0],["حادِي السُّرى قِفْ بي على الأعلام","لِيَشْتَفي قَلبي مِنَ الغرامِ",52,"م",1,0],["حادٍ عَنِ اللَبِّ أَحشا الصَبِّ أَعراها","شادٍ زِنادَ هَوى المُشتاقِ أَوراها",53,"ه",2,1],["حادي الركب إِن وصلت إِلَيه","وَلذاك الحمى وَتِلكَ البطاح",54,"ح",1,0],["حادى اليعملات قف بالمطيه","فى فناء بروضه أريحيه",55,"ي",2,1],["حادِيَ العيسِ هل مررتَ برَكْبِ","تَرك القلبَ فِي همومٍ وكَرْبِ",56,"ب",1,1],["حادي السعودِ به حَدا","والطيرُ صاح وغرَّدا",57,"د",2,0],["حادى السرور رجّعَا","بعزّنا مذ رجعا",58,"ع",2,0],["حاديَها أيْنَ بها تَذْهبُ","إذْ ليْسَ عن ورْدِ المنى مَذْهبُ",59,"ب",1,1],["حادث قد أمرض الدين فيا","لمصابٍ أورث الداء العضالا",60,"ل",2,0],["حادي المنية لا يألو المسير رجا","قلص النفوس بتأديبٍ يلي الدَلَجا",61,"ج",2,1],["حاد بي عَنها غريرٌ من هَوى","وَلَقد كانَت زَماناً يُغتَنم",62,"م",1,0],["حادثته والنفس شيِّقة","للنهل من فمه وللعَلل",63,"ل",1,0],["حادي الظلام على جناحٍ صاعدِ","يا أرضُ أَصغي، يا كواكبُ شاهدي",64,"د",2,1],["حادثات الزمان درسٌ مفيدٌ","فاستفيدوا من حادثات الزمان",65,"ن",1,0],["حادت عن السنن القويم وقصرت","عن واجبات أوامر الجبار",66,"ر",1,0],["حادِث أَرخَصَ الدُّموعَ الغَوالي","وَلِعَهدي بِهنّ غَيرُ رِخاصِ",67,"ص",1,0],["حادَ الغُرورُ بِهِم عَن كُلِّ صالِحَة","فَأَظهَروا البَغيَ وَالعُدوان في السُبُل",68,"ل",1,0],["حادي العُلوم حَدا بِرَكبكَ مُسرِعاً","وَنَأى بِكُم عِن مَوطنِ الأَجدادِ",69,"د",1,0],["حادى السرى حث المسير وأدلجا","واذا وصلت لطيبة بيى عرّجا",70,"ج",2,1],["حادي الركب إن حططت بسلع","بعد قطع الوهاد والأقواز",71,"ز",1,0],["حاديَ العيسِ كَما في","عَهدِ قيسٍ والمهلّب",72,"ب",1,0],["حادى الرفاق لأرض طيبة كن إذا","جئت العقيق لما