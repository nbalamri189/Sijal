{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"يا صانعي لله ما أحكمته","https://www.aldiwan.net/poem35889.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[71,"كم أوري عن لوعتي وأواري","https://www.aldiwan.net/poem4006.html","الخفيف"],[93,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[47,"أقلي فأيام المحب قلائل","https://www.aldiwan.net/poem25203.html","الطويل"],[72,"عندي غلام بعلم الحرف مشتغل","https://www.aldiwan.net/poem19317.html","البسيط"],[72,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[51,"هجاني حفيص ولم أهجه","https://www.aldiwan.net/poem61875.html","المتقارب"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[28,"فدى لرؤوس من تميم تتابعوا","https://www.aldiwan.net/poem5292.html","الطويل"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"بعد التحية والكرامة كلها","https://www.aldiwan.net/poem43109.html","الكامل"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54738","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43891","السريع"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[4,"إنَّ تَقْوَى رَبِّنَا خَيرُ نَفَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10941&r=&rc=36",""],[116,"جلوس سلطان ملوك الورى","https://www.aldiwan.net/poem41211.html","عموديه"],[129,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[138,"نام من كان خليا من ألم","https://www.aldiwan.net/poem67948.html","الرمل"],[187,"لا تصحبن اميرا","https://www.aldiwan.net/poem43753.html","المجتث"],[211,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[224,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[236,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[236,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[280,"أحكمت عرسه ضروب الأغاني","https://www.aldiwan.net/poem2634.html","الخفيف"],[291,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[298,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[298,"هذه الأرض قد سقتها السماء","https://www.aldiwan.net/poem33341.html","الخفيف"],[329,"قلب يعذبه هواه","https://www.aldiwan.net/poem55001.html","مجزوء الكامل"],[365,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[392,"حسين إعلم أن الشيطنه قد لها ناس","https://www.aldiwan.net/poem54560.html","عموديه"],[404,"سلام على الدار التي جمعت شملي","https://www.aldiwan.net/poem33607.html","الطويل"],[404,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[404,"يا من له الذهن الشريف والذكا","https://www.aldiwan.net/poem34103.html","الرجز"],[417,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[433,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[453,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[480,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[480,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[480,"قل ما بدا لك تلق السمع صاغيه","https://www.aldiwan.net/poem37039.html","البسيط"],[501,"أحكمت دولة العلى تبجيلى","https://www.aldiwan.net/poem37680.html","الخفيف"],[501,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[501,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[501,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[559,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[563,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[563,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"]],"verses":[["أحْكَمْتَ حِيلَةَ بُرْئِهِمْ بلَطافَةٍ","قدْ أعْجَزَتْ في الطِّبِّ جالِينوسا",0,"س",2,0],["أحْكَمْتَ تاجِيَ يوْمَ صُغْتَ رُقوشَهُ","فصَبَتْ إليْهِ مَفارِقٌ ورؤوسُ",1,"س",1,0],["أَحْكَمْتَ بِالرَّأَيِ السَّدِيدِ أُصُولَهَا","وَفَرَيْتَهَا لَمَّا اسْتَبَانَ الْمَفْصِلُ",2,"ل",1,0],["أَحكَمَ الصُنعَ شَهرُ كانونَ فيها","فَشَذاها يُثني عَلى آذارِ",3,"ر",1,0],["أحْكَامُهُ شَرْعٌ وَآرَاؤُهُ","صَادِرَةٌ عَنْ عِلْمِ مِلْفَانِ",4,"ن",1,0],["أَحكَمَ الجِنثِيُّ مِن عَوراتِها","كُلَّ حِرباءٍ إِذا أُكرِهَ صَل",5,"ل",1,0],["أُحَكِّمُ في الأَعداءِ مِنها صَوارِماً","أُحَكِّمُها فيها إِذا ضاقَ نازِلُ",6,"ل",1,0],["أحكى الأنام لدالٍ في تفاجعه","وأنفقَ الناسَ من ميمٍ على ألف",7,"ف",1,0],["أحكامه الزهر وهي واصلة","بالحق أيدي أسباب إعظامه",8,"م",2,0],["أحُكُّ بفيْشته كَيْنَها","وأكْحُلُ جارَ استها الأرمدا",9,"د",2,0],["أحكمَ إتقانها بحكمته","وشاد بنيانها وقدرها",10,"ر",3,0],["أَحكَمُ الناسِ في الحَياةِ أُناسٌ","عَلَّلوها فَأَحسَنوا التَعليلا",11,"ل",2,0],["احكوا البراكين التي","تأتي من الضغط انفجارا",12,"ر",2,0],["أَحكَمتَ ما دَبَّرتَ بِالتَبعيدِ وَال","تَقريبِ وَالتَصعيبِ وَالتَسهيلِ",13,"ل",1,0],["أَحُكمُ حَرورِيٍّ مِنَ الدينِ مارِقٍ","أَضَلُّ وَأَغوى مِن حِمارٍ مُجَدَّعِ",14,"ع",1,0],["أَحْكَمْتُ مَنْطِقَهُ بِلَهْجَةِ مُفْلِقٍ","يَقِظِ الْبَدِيهَةِ فِي الْقَرِيضِ مُحَكَّمِ",15,"م",1,0],["أحكامُه الجُرْدُ الصّوافِنُ تَرتمي","وَحُدودُه الأسيافُ والأجنادُ",16,"د",1,0],["احكُم بِما شَرَعَ الكِتابُ وَلا تَخَف","خَصماً يَلومُ وَلا صَديقاً يَعتَبُ",17,"ب",1,0],["اِحكُم كَحُكمِ فَتاةِ الحَيِّ إِذ نَظَرَت","إِلى حَمامِ شِراعٍ وارِدِ الثَمَدِ",18,"د",1,0],["أَحْكَمَ الرَّأْيَ وَالتَّصَرُّفَ فِي الْمَالِ","قدَّرَتْ أَخْلاقُهُ الرِّبْحَ دُرَّا",19,"ر",2,0],["أَحْكِمْ بِرَأْيِكَ مُبْديءِ السُّنَنِ الَّتي","هِيَ فِي الخِلاَفِ مَنَائِرُ الرُّوَّاد",20,"د",1,0],["أحكامُه بالحقِّ مَرضيّةٌ","واللّهُ بعدَ الخَلْقِ راضِيها",21,"ي",3,0],["أحكامكم عَاطِلاتٌ لا يُنَفِّذُها","إلا الحديدُ وإلا النَّارُ تلتهب",22,"ب",1,0],["أحكمَ الجنيُّ منْ عوراتِهَا","كلَّ حِرْباءٍ إذا أُكْرِهَ صَلّ",23,"ل",1,0],["احكم بالانصاف احكامها","فانبلجت تجلى بطرز عجيب",24,"ب",1,0],["أحكمت شعرى فيه حتى","صرتُ منه فتىً حكيما",25,"م",2,0],["أُحكُمي في الوَصلِ إِذ وُلِّيتِهِ","لَيسَ قَتلُ النَفسِ مِن عَدلِ الحكَم",26,"م",1,0],["أحكامهُ فيك تحري","بغيا وظلما وزورا",27,"ر",2,0],["احكم يا سلطان الملاح","بما تشا في الخافقين",28,"ن",1,0],["أَحَكيمٌ مِن العتاة تذرّي","شَعرَهُ قينَةٌ من الماخور",29,"ر",1,0],["أَحكَمَتهُ عَلى مُرو","رِ اللَيالي يَدُ الزَمَن",30,"ن",1,0],["أَحكَمَها جودُهُم فَتَلاً فَما","في نَقضِها طَماعَةٌ لِناشِرِ",31,"ر",1,0],["أَحكمتْ عِرسُه ضُروبَ الأَغاني","من ثقيلٍ في رأسه وخفيفِ",32,"ف",1,1],["أحكامهم ملئت عتوّا","فهي من ظلم وجور",33,"ر",1,0],["أَحكَمتُ نظمَ قَريضها فَتَناسقَت","كالعِقد يَزهو في مُقلَّد جُؤذَرِ",34,"ر",1,0],["أَحكَم الوُدّ منه عقد إِخائي","هَكَذا هَكَذا يَكونُ الإِخاءُ",35,"ا",2,0],["احكم عليّ بما تشا","ءُ فأَنت لي كلُّ الأماني",36,"ي",1,0],["أَحكي الحَمامَ مُطَوَّقاً بنَوالِ مَن","ما خاطري لجَميلهِ بكَنود",37,"د",1,0],["احكموها ولا بالواعلى الرجل والراس","دابهم في بحور الشر من كاس إلى كاس",38,"س",1,0],["أُحَكَّمُ في أموالهم فتصرفي","تصرفهم فيها وفعلهم فعلي",39,"ل",2,0],["أحكامه جارت كما حكامنا","لا غَرْوَ في ذا فالملوك تعدي",40,"د",2,0],["أحكامه الفتح لدى المضاف هل","تحكم بالفتح إذا أضفته",41,"ت",2,0],["أحكَمْتَها بالصِّدقِ منك مبانياً","في غاية الإِحكام والإِتقان",42,"ن",1,0],["احكُمْ على الثَقَلَيْنِ الإنس والجانِ","فأنت أقومُ بالمُلكِ السُلَيْماني",43,"ن",2,1],["أُحكم النسجَ حين انتخب الدر","ر ابتكاراً بصيده واعتقاله",44,"ل",2,0],["احكم فحكمك ماض","ما شئته كان عدلا",45,"ل",2,0],["أحكامه في البرايا كلها حكم","والحاكمون بما فيها كأطواد",46,"د",1,0],["أحكمته فاستحق التاج مالكه","فيه توازي معاليه لآليه",47,"ي",2,0],["أحكمت دولةُ العلى تبجيلى","وبطولى سبقتص سادات جيلي",48,"ي",1,1],["أُحْكِمَتْ قِسمَتُنا حيثُ بِها","نُقِشَ اللَّوْحُ وخطَّ القلَمُ",49,"م",1,0],["أحْكَمَها اللهُ تَعالى شَأنُهُ","وأنَّهُ مُنَزَّهٌ عنِ المَثَلْ",50,"ل",1,0],["أحْكَمَ الأمرَ وأدَّى","صادقاً كُلَّ الرَّسائلْ",51,"ل",1,0],["احْكمِ الأمرَ بالفُروضِ وبالسُّ","نَّةِ واعْمَل بِحكمِها يا صاحِ",52,"ح",1,0],["أحْكموا أمرَهُمْ وراحوا بأمْنٍ","يا لإحْكامهم وذاكَ الرَّواحِ",52,"ح",1,0],["أحكم الأمر فهو بالحكم باد","في جميع الشئون حَلاً وربطا",53,"ط",2,0],["أحكَمتَ في الخيرِ سِرّاً بارعاً حَسَناً","فاترُكْ مُؤَارَبَتي يا طاهِرَ الحُرَمِ",54,"م",1,0],["أحكامُ دَهرٍ ليسَ يَعلَمُ سِرَّها","إلا حكيمٌ بالإلهِ عليمُ",55,"م",1,0]]}