العمر الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36477",""],[5842,"الموت/ صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128792",""],[5922,"قبضة من أثر الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=185115",""],[6019,"تفيّأتْ روحٌ ظِلالَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=200951",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[5355,"دنيا القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87209&r=&rc=34",""],[6225,"أبنائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80989&r=&rc=258",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""]],"verses":[["أحْكَمْتَ حِيلَةَ بُرْئِهِمْ بلَطافَةٍ","قدْ أعْجَزَتْ في الطِّبِّ جالِينوسا",0,"س",2,0],["أحْكَمْتَ تاجِيَ يوْمَ صُغْتَ رُقوشَهُ","فصَبَتْ إليْهِ مَفارِقٌ ورؤوسُ",1,"س",1,0],["أَحْكَمْتَ بِالرَّأَيِ السَّدِيدِ أُصُولَهَا","وَفَرَيْتَهَا لَمَّا اسْتَبَانَ الْمَفْصِلُ",2,"ل",1,0],["أَحكَمَ الصُنعَ شَهرُ كانونَ فيها","فَشَذاها يُثني عَلى آذارِ",3,"ر",1,0],["أحْكَامُهُ شَرْعٌ وَآرَاؤُهُ","صَادِرَةٌ عَنْ عِلْمِ مِلْفَانِ",4,"ن",1,0],["أَحكَمَ الجِنثِيُّ مِن عَوراتِها","كُلَّ حِرباءٍ إِذا أُكرِهَ صَل",5,"ل",1,0],["أُحَكِّمُ في الأَعداءِ مِنها صَوارِماً","أُحَكِّمُها فيها إِذا ضاقَ نازِلُ",6,"ل",1,0],["أحكى الأنام لدالٍ في تفاجعه","وأنفقَ الناسَ من ميمٍ على ألف",7,"ف",1,0],["أحكامه الزهر وهي واصلة","بالحق أيدي أسباب إعظامه",8,"م",2,0],["أحُكُّ بفيْشته كَيْنَها","وأكْحُلُ جارَ استها الأرمدا",9,"د",2,0],["أحكمَ إتقانها بحكمته","وشاد بنيانها وقدرها",10,"ر",3,0],["أَحكَمُ الناسِ في الحَياةِ أُناسٌ","عَلَّلوها فَأَحسَنوا التَعليلا",11,"ل",2,0],["احكوا البراكين التي","تأتي من الضغط انفجارا",12,"ر",2,0],["أَحكَمتَ ما دَبَّرتَ بِالتَبعيدِ وَال","تَقريبِ وَالتَصعيبِ وَالتَسهيلِ",13,"ل",1,0],["أَحُكمُ حَرورِيٍّ مِنَ الدينِ مارِقٍ","أَضَلُّ وَأَغوى مِن حِمارٍ مُجَدَّعِ",14,"ع",1,0],["أَحْكَمْتُ مَنْطِقَهُ بِلَهْجَةِ مُفْلِقٍ","يَقِظِ الْبَدِيهَةِ فِي الْقَرِيضِ مُحَكَّمِ",15,"م",1,0],["أحكامُه الجُرْدُ الصّوافِنُ تَرتمي","وَحُدودُه الأسيافُ والأجنادُ",16,"د",1,0],["احكُم بِما شَرَعَ الكِتابُ وَلا تَخَف","خَصماً يَلومُ وَلا صَديقاً يَعتَبُ",17,"ب",1,0],["اِحكُم كَحُكمِ فَتاةِ الحَيِّ إِذ نَظَرَت","إِلى حَمامِ شِراعٍ وارِدِ الثَمَدِ",18,"د",1,0],["أَحْكَمَ الرَّأْيَ وَالتَّصَرُّفَ فِي الْمَالِ","قدَّرَتْ أَخْلاقُهُ الرِّبْحَ دُرَّا",19,"ر",2,0],["أَحْكِمْ بِرَأْيِكَ مُبْديءِ السُّنَنِ الَّتي","هِيَ فِي الخِلاَفِ مَنَائِرُ الرُّوَّاد",20,"د",1,0],["أحكامُه بالحقِّ مَرضيّةٌ","واللّهُ بعدَ الخَلْقِ راضِيها",21,"ي",3,0],["أحكامكم عَاطِلاتٌ لا يُنَفِّذُها","إلا الحديدُ وإلا النَّارُ تلتهب",22,"ب",1,0],["أحكمَ الجنيُّ منْ عوراتِهَا","كلَّ حِرْباءٍ إذا أُكْرِهَ صَلّ",23,"ل",1,0],["احكم بالانصاف احكامها","فانبلجت تجلى بطرز عجيب",24,"ب",1,0],["أحكمت شعرى فيه حتى","صرتُ منه فتىً حكيما",25,"م",2,0],["أُحكُمي في الوَصلِ إِذ وُلِّيتِهِ","لَيسَ قَتلُ النَفسِ مِن عَدلِ الحكَم",26,"م",1,0],["أحكامهُ فيك تحري","بغيا وظلما وزورا",27,"ر",2,0],["احكم يا سلطان الملاح","بما تشا في الخافقين",28,"ن",1,0],["أَحَكيمٌ مِن العتاة تذرّي","شَعرَهُ قينَةٌ من الماخور",29,"ر",1,0],["أَحكَمَتهُ عَلى مُرو","رِ اللَيالي يَدُ الزَمَن",30,"ن",1,0],["أَحكَمَها جودُهُم فَتَلاً فَما","في نَقضِها طَماعَةٌ لِناشِرِ",31,"ر",1,0],["أَحكمتْ عِرسُه ضُروبَ الأَغاني","من ثقيلٍ في رأسه وخفيفِ",32,"ف",1,1],["أحكامهم ملئت عتوّا","فهي من ظلم وجور",33,"ر",1,0],["أَحكَمتُ نظمَ قَريضها فَتَناسقَت","كالعِقد يَزهو في مُقلَّد جُؤذَرِ",34,"ر",1,0],["أَحكَم الوُدّ منه عقد إِخائي","هَكَذا هَكَذا يَكونُ الإِخاءُ",35,"ا",2,0],["احكم عليّ بما تشا","ءُ فأَنت لي كلُّ الأماني",36,"ي",1,0],["أَحكي الحَمامَ مُطَوَّقاً بنَوالِ مَن","ما خاطري لجَميلهِ بكَنود",37,"د",1,0],["احكموها ولا بالواعلى الرجل والراس","دابهم في بحور الشر من كاس إلى كاس",38,"س",1,0],["أُحَكَّمُ في أموالهم فتصرفي","تصرفهم فيها وفعلهم فعلي",39,"ل",2,0],["أحكامه جارت كما حكامنا","لا غَرْوَ في ذا فالملوك تعدي",40,"د",2,0],["أحكامه الفتح لدى المضاف هل","تحكم بالفتح إذا أضفته",41,"ت",2,0],["أحكَمْتَها بالصِّدقِ منك مبانياً","في غاية الإِحكام والإِتقان",42,"ن",1,0],["احكُمْ على الثَقَلَيْنِ الإنس والجانِ","فأنت أقومُ بالمُلكِ السُلَيْماني",43,"ن",2,1],["أُحكم النسجَ حين انتخب الدر","ر ابتكاراً بصيده واعتقاله",44,"ل",2,0],["احكم فحكمك ماض","ما شئته كان عدلا",45,"ل",2,0],["أحكامه في البرايا كلها حكم","والحاكمون بما فيها كأطواد",46,"د",1,0],["أحكمته فاستحق التاج مالكه","فيه توازي معاليه لآليه",47,"ي",2,0],["أحكمت دولةُ العلى تبجيلى","وبطولى سبقتص سادات جيلي",48,"ي",1,1],["أُحْكِمَتْ قِسمَتُنا حيثُ بِها","نُقِشَ اللَّوْحُ وخطَّ القلَمُ",49,"م",1,0],["أحْكَمَها اللهُ تَعالى شَأنُهُ","وأنَّهُ مُنَزَّهٌ عنِ المَثَلْ",50,"ل",1,0],["أحْكَمَ الأمرَ وأدَّى","صادقاً كُلَّ الرَّسائلْ",51,"ل",1,0],["احْكمِ الأمرَ بالفُروضِ وبالسُّ","نَّةِ واعْمَل بِحكمِها يا صاحِ",52,"ح",1,0],["أحْكموا أمرَهُمْ وراحوا بأمْنٍ","يا لإحْكامهم وذاكَ الرَّواحِ",52,"ح",1,0],["أحكم الأمر فهو بالحكم باد","في جميع الشئون حَلاً وربطا",53,"ط",2,0],["أحكَمتَ في الخيرِ سِرّاً بارعاً حَسَناً","فاترُكْ مُؤَارَبَتي يا طاهِرَ الحُرَمِ",54,"م",1,0],["أحكامُ دَهرٍ ليسَ يَعلَمُ سِرَّها","إلا حكيمٌ بالإلهِ عليمُ",55,"م",1,0],["أَحكمت بنيانه في مصرنا فَخَلا","بِحُسن رَأيك عَن عَيبٍ وَعَن خَلل",56,"ل",1,0],["أحكامه في الخلق أمضاها الذي","خلق الجميع وليته لم يخلق",57,"ق",1,0],["أحكامُ قاضٍ لا يُرَدُّ قضاؤُهُ","فيما قضاهُ ولا يُرى مسؤولاَ",58,"ل",2,0],["أَحكامُها في العَقلِ إِن هِيَ حُكِّمَت","أَحكامُ صَرفِ الدَهرِ في الأَحرارِ",59,"ر",1,0],["أحكمته خلف السدود خزائناً","وعدلت وهو جداول تتفرع",60,"ع",1,0],["أَحكَمت إِبرامَ الوِدادِ بحبّكم","لا نَقضَ يَعرو مُحكَمَ الإِبرامِ",61,"م",1,0],["أَحكي الَّذي بِالجَهلِ يَجعَلُ كَفَّهُ","شَرَكاً يَصيدُ الطَّيرَ في وَهمِ الغَبي",62,"ب",2,0],["أَحكَمَت كَفّا حَكيمٍ صُنعَها","فَأَتَت مَجدولَةً فيها رَهَف",63,"ف",1,0],["أَحكمَ خَلقَ كُلّ شَيءٍ خَلَقَه","وَمَدَّنا مِن مُضغَةٍ وَعَلَقَه",64,"ه",1,0],["أحكمتها الألفاظ نسجاً ووشت","ها المعاني كما توشى البرودُ",65,"د",1,0],["أحكموا الطعن والضراب فبنوا","لعداهم أسنة ونصولا",66,"ل",2,0],["أحكامه لماعة منيره","مشرقة كالشمس في الظهيره",67,"ه",1,0],["أحكمت يا مولاي خير محامدٍ","في كل يوم حسنها يتجدّدُ",68,"د",1,0],["أحكمتُ للتبغ المعطّس علبةً","متقونةً صيغت باحسن صيغةِ",69,"ه",1,1],["احكُمْ بمِا شِئْتَ فقاضي الهَوَى","قد حكَّمَ المعشوقَ في العاشِقِ",70,"ق",1,0],["أَحكمتُ مبدأَ نسجِها وخِتامَها","ونسيبَها ومديحَها والمخلَصا",71,"ص",2,0],["أَحْكِمْ بِفَضْلِكَ أسبابي فقد مَرِحَتْ","واحْكُمْ بِعَدْلِكَ في صَبْري فقد جارَا",72,"ر",2,0],["احكامُ ترتيب الحروف تختلف","في الفرد والتركيب مثل ما عُرِف",73,"ف",1,0],["أَحكَمت عقدها كِرام شُيوخ","هُم لِدين الإِلَهِ خَير أَساس",74,"س",1,0],["أَحكَمَت مِرآتَها عُقَداً","تَمنَعُ المُحتالَ في نَفقِه",75,"ق",2,0],["أحكامه عدلٌ وأرزاقه","فَضل فما للناس لم تقنع",76,"ع",1,0],["أُحكُم فإِن العَدلَ شِيمَتُكَ التي","أوصى بِها جَدٌّ إِلَيكَ ووالِدُ",77,"د",1,0],["أحكَمُ الحاكمين كَنزُ العطايا","أرحمُ الراحمينَ رحبُ الحنانِ",78,"ن",1,0],["احكم بماذا تشتهي","حكم القوي على الضعيف",79,"ف",1,0],["أحكم في غصن من البان مورق","وأكرع في عذب من الريق سلسل",80,"ل",1,0],["أحكَمَت النَّفسَ مَاشِطةٌ","مُتُّ من وَجدي بِها كَمَدَا",81,"د",2,1],["إحكَامُ هَذَا الخَلقِ إذ إيجَادُهُ","فِي غَايَةِ الإِحكَامِ وَالإتقَانِ",82,"ن",1,0],["أحكمت عروة قفلها وكشفت عن","أسرار شرعة أحمد أشكالها",83,"ل",3,0],["أَحكمت مَن ذا السور ما لَم تَجد","وَاللَه مِن أَحكامِهِ بُدّا",84,"د",2,0],["اُحْكُمْ على الثلاثة الأَصناف","من تَمْرةِ التُّوتِ بلا خِلافِ",85,"ف",1,0],["اُحْكمْ عَلَى البَطيخِ قَبْلَ الأكْلِ","طويلِه والمستدير الشكل",85,"ل",1,0],["أحكام شرع محبتي لا تنسخ","الوجد يملي والصبابة تنسخ",86,"خ",1,1],["أحكما في بناء ألف أساس","فسما اليوم هازئاً بالقصور",87,"ر",1,0],["أُحكِمَت منهُ مَرائرُهُ","حينَ كفَّ الرَبطُ مِن مَدَرِه",88,"ر",2,0],["احكامها احكمت بالعدل رفعتها","على اساس التقى شيدت مبانيها",89,"ي",3,0],["احكم الحكم بالمعارف علماً","بالخفايا في كل امر يريده",90,"د",2,0],["احكامهم غالبا ليست على نهج","نعم على عوج عاجت عن القوم",91,"م",1,0],["أحكمتك الأيام يا ابن حكيم","فأريت الزمان حكم الزمان",