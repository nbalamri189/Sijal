{"poems":[[55,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[90,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[53,"وقائل إن أبا حفصل أحمق محتاج إلى ضرب","https://www.aldiwan.net/poem8501.html","السريع"],[80,"أقوم على الأيام خير مقام","https://www.aldiwan.net/poem14269.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85512","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147462","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[101,"التمثيلية","https://www.poetsgate.com/ViewPoem.aspx?id=36365",""],[119,"رمتني من العين الكحيلة يا مي","https://www.aldiwan.net/poem40416.html","عموديه"],[119,"تطارحني الايام بالبؤس والرضا","https://www.aldiwan.net/poem41136.html","عموديه"],[261,"يقول قوم أبصروني وقد","https://www.aldiwan.net/poem48561.html","السريع"],[309,"أقوم بفرض العامرية والنفل","https://www.aldiwan.net/poem16749.html","الطويل"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[534,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[542,"إذا مت فادفني إلى أصل كرمة","https://www.aldiwan.net/poem69400.html","الطويل"],[556,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136214","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136119","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64588","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27860","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27425","الوافر"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140204",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100277","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100278","الطويل"],[3123,"","https://poetry.dctabudhabi.ae/diwan/poem/21153","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74104","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62951","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3622,"","https://poetry.dctabudhabi.ae/diwan/poem/204343","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91134","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135610","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83660","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"أيا هندُ هلاّ زرتِ بيت صبابتي","https://www.poetsgate.com/ViewPoem.aspx?id=156951",""],[4718,"ضاقت بي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=137245",""],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4924,"سيد الجيل","https://www.poetsgate.com/ViewPoem.aspx?id=19691",""],[4984,"حيَّ على الصبح *","https://www.poetsgate.com/ViewPoem.aspx?id=175747",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5200,"جعلت فداءك من صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=200818",""],[5431,"فأَجْرِ العشق في نهديَ نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=185820",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5461,"الجرحين","https://www.poetsgate.com/ViewPoem.aspx?id=5240",""],[5525,"عض النواجذ","https://www.poetsgate.com/ViewPoem.aspx?id=950",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5703,"إلى عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=210393",""],[5704,"على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=194468",""],[5839,"السهاد","https://www.poetsgate.com/ViewPoem.aspx?id=62050",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[2220,"أنا انتا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11225&r=&rc=99",""]],"verses":[["أُقَوِّمُها حَتّى إِذا قيلَ راكِبٌ","تَظالَعتُ مَرَّ المائِلِ المُتَجانِفِ",0,"ف",1,0],["أقوم إلى كبرى الزُجاجات مُدْهِقاً","بمُستقطَر من خالص التمر رائق",1,"ق",1,0],["أقومُ عنهُ بمعاذيرِهِ","وهو يحوكُ الشعر في سِّبي",2,"ب",2,0],["أَقومُ عَلى الأَيّام خَيرَ مُقامِ","وَأُوقِدُ في الأَعداءِ شَرَّ ضِرامِ",3,"م",1,1],["أَقَومُكِ أم ذِئابٌ عادياتٌ","وأمرُ يسوعَ أم ما تأمرينا",4,"ن",2,0],["أَقوم في روضتي صباحاً","مستمعاً نغمة الهزار",5,"ر",1,1],["أقوم خمسي وصوم الدهر آلفه","وأدمن الذكر أبكاراً بآصال",6,"ل",1,0],["أَقْوَمُ النَّهْجِ نَهْجُهُ","فِي التِّجَارَاتِ وَالحِرَفْ",7,"ف",1,0],["أقوم بدور مضحك ، يا حبيبتي","وأرجع من تمثيل دوري خائبا",8,"ب",2,0],["اقوم بأوابي فلم ير قالبي","ولي شاخص والهفتي ماله في",9,"ي",1,0],["اقوم بظل الاحمدين مؤيداً","نبي الهدى بالغوث احمد ذي اليد",10,"د",1,0],["أقوم والركعة من عند من","نعم وإن قمت فمن يقرا",11,"ر",2,0],["أَقومُ بِفَرضِ العامِرِيَّةِ وَالنَفلِ","وَأَصدِقُها في القَصدِ وَالقَولِ وَالفِعلِ",12,"ل",1,1],["أقوم وصاحبي فأثيرُ عنه","بواركَها البوازلَ والثنِيَّا",13,"ي",2,0],["أقومُ لكم بقوانينه","وأنطِقُ ما دمتمُ تسمعونا",14,"ن",2,0],["أَقومُ والليلُ مُدْجاةٌ عوالِمُهُ","وذيلُهُ ساقِطٌ في شكلِ مسْحوبِ",15,"ب",1,0],["أَقُومُ بِهِ إذا قَعَدُوا لَدَيْهِ","وأَدْفَعُهُ إذا أَعْيا سِوائي",16,"ا",2,0],["أقوِّمُها زِقاً بِحِقِّ بِذاكُمُ","يُساقُ الينا تَجرُها ونَسوقُها",17,"ق",3,0],["أقوم وما بيني وبين سريره","مقامٌ ولا لِي دونه الدّهرَ حائلُ",18,"ل",1,0],["أقوم به من حيث قامت شواهد ال","تعلق بالمختار في ذلك المجرا",19,"ر",2,0],["أقوم فيه بداعي الصدق يحملني","إليك فيه اشتياق كان مرغوبا",20,"ب",2,0],["أقوم بما أقوم به ولكن","حقيقة ما أقوم به خلاء",21,"ا",2,0],["أقوم لكم فيما تقومون لي به","فدنا بما قد كنت أنت به دنتا",22,"ت",2,0],["أقوم به وعنه إليه حتى","أبينه لأبناءِ السبيلِ",23,"ل",1,0],["أقوم بنفسي للمكارم بانيا","تشرفني نفسي الأبية لا الأب",24,"ب",1,0],["أقوم على شوق واقعد عن جوىً","ففيه قيامي في الهوى وقعودي",25,"د",2,0],["أقوم وأهوي في هواه كأنني","لما بيَ أمشي راسفاً بقيود",26,"د",1,0],["أُقومُ عَلى قَبرَيكُما لَستُ بارِحاً","طِوالَ اللَيالي أَو يُجيبَ صَداكُما",27,"م",2,0],["أَقومُ فأهوى في هَواكَ صَبابَةً","وَما أَنا عَمّا همّك اليَوم قاعدُ",28,"د",1,0],["أقومُ أَغصانَ الخطوبِ اذا التوتْ","برفْقى ومثلى في الرجالِ قليلُ",29,"ل",1,0],["أقومُ لدَيْها مُطْنِباً في ثنائِها","مدَى الدّهْرِ لا أُلْفَى عن الشكْر مَثْنيّا",30,"ي",2,0],["أقوم زيغ الخط منه بحاذق","صبور جليد واسطي مقوم",31,"م",1,0],["أَقوم إِلى الطِّلا وَالكَرم جَوّي","وَشَمسي قَهوتي رَوضي فراشي",32,"ش",2,0],["أقوم عن الفراش أناجي ربي","وربي للمناجاة السميعُ",33,"ع",1,1],["أَقَومَ الطَّرَاوِدِ جُندَ البُؤوس","وَنُجَّادَهُم مُسجِيشي النُّفُوسِ",34,"س",1,0],["أَقوم وَالضيم تَطويني تَوائِبه","طَيّ السجل وَلَم اِسمَعُه أَناتي",35,"ت",2,0],["أقومُ به طوراً وأقعد تارةً","فلستَ ترالي مَضجعاً بمكان",36,"ن",1,0],["أقوم أداةَ إِصلاح لمن قد","يَرى الإِصلاحَ إِذ يَبغي الثَوابا",37,"ب",2,0],["أَقومُ أُصَلّي أَي أُقيمُ عَلى الوَفا","بِأَنَّكَ فَردٌ واحِدُ الحُسنِ جامِعُ",38,"ع",1,0],["أقوّم ُقلبي إن ْ تعرّجَ غيرُهُ","وأمنحُ من أحببتُ ودّي وأعطفُ",39,"ف",1,0],["اقوم واقعد ماهنالي ولا رقت","واشوف انا ايامي سوا مع دروبي",40,"ب",2,0],["أ قوم هكذا ينجون مما","سيقضي الله في يوم الذهول",41,"ل",1,0],["اقوم من ليل واصبح على ليل","وما ادري النهار اللي يقولون وينه",42,"ن",2,1],["أقوِّم فحوى الصدور وأُنهي","بأعجازها الحذف خبْنا وطيا",43,"ي",2,0],["أقومي لا ينسى المروءة والوفا","كريم وما أحلى الوفاء بأروع",44,"ع",1,0],["أقوم بأعباء المشقات دونهم","بنفس على كأس الوفا ذات إدمان",45,"ن",1,0],["أقوم بها عجلا مسرعا","ولا أر نفسي لها قاليه",46,"ي",2,0],["أقوم إلى الصلاة بكل وجدٍ","وقد صارت شفاهي منك سكرى",47,"ر",2,0],["أقومُ لو جاءَني صوتُ التي برقتْ","في مقلتيّ ، وراحَتْ تغزِلُ السُّحُبا",48,"ب",2,0],["أقوم بجرح لكن ثاني الجرحين ساق وعاق","مشى سمه مع عرقي ويبست منه كفّيني",49,"ن",2,0],["أقوم بجبالٍ ولا أقيم في سفح","لو أطعموا لحمي لعوج المخالب",50,"ب",1,1],["أقوم أحمد مضروب على يدهم","بالذل من هول ذاك الفتح واعجبا",51,"ب",2,0],["أقومُ منَ الصَباحِ وأنتَ ظِلٌّ","يُرافقُني. ولي قلبٌ كَئيبُ",52,"ب",1,0],["أقوم لفرط العشق ألثم ثغره","وأسقيه كأسًا من لمى الشهد ناخبهْ",53,"ب",2,0],["أقومُ الّليلَ أسري معْ نجومٍ","ولكنْ ضاعَ.. ضيّعني طريقي",54,"ق",2,0],["أقوم الليل سهرانا","أعود صخور أحزاني",55,"ن",2,0],["أقوم لكم فيما تقومون لي به","فدنا بما قدْ كنتَ أنتَ بهِ دنا",56,"ن",2,0]]}