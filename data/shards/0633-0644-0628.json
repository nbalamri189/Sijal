//www.aldiwan.net/poem16438.html","الكامل"],[464,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[464,"شغفي بأعطاف الغصون الهيف","https://www.aldiwan.net/poem3453.html","عموديه"],[464,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[471,"ولقد دعوت طريفُ دعوة جاهلٍ","https://www.aldiwan.net/poem755.html",""],[477,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[479,"فيك يحلو الغزل","https://www.aldiwan.net/poem36917.html","مجزوء الرمل"],[479,"يوم عظيم لم تلده الأزمن","https://www.aldiwan.net/poem36963.html","الكامل"],[482,"يا واردا من ليلى قف متصاغيا","https://www.aldiwan.net/poem24336.html","عموديه"],[482,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[482,"أحديقة رقّمت بوشي أزاهر","https://www.aldiwan.net/poem24435.html","عموديه"],[493,"في خميس كأنما السمر والأب","https://www.aldiwan.net/poem67396.html","الخفيف"],[500,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[514,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[514,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[515,"يا باذلاً رزق الورى ومانعا","https://www.aldiwan.net/poem12169.html","الرجز"],[515,"يا دهر قد أكثرت في التلوين","https://www.aldiwan.net/poem12301.html","الكامل"],[536,"أشاقك من عهد الخليط مغان","https://www.aldiwan.net/poem23856.html","الطويل"],[538,"يا دار نلت العز والتكريما","https://www.aldiwan.net/poem47930.html","عموديه"],[551,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[551,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[553,"شخصت مذ يوم نادوا بالرحيل على","https://www.aldiwan.net/poem68367.html","البسيط"],[553,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[558,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[559,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[562,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[567,"سل بي وبالأيام تعرف","https://www.aldiwan.net/poem69589.html","مجزوء الكامل"],[569,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[586,"كيف يلحى على هواك الكئيب","https://www.aldiwan.net/poem17414.html","الخفيف"],[586,"فدتك نفوس قد حلا بك حالها","https://www.aldiwan.net/poem17657.html","الطويل"],[586,"بأبي شادن غدا الوجه منه","https://www.aldiwan.net/poem18006.html","الخفيف"]],"verses":[["سَلَبتَ ما أَعجَزَنا رَدُّهُ","في قُوَّةِ السالِبِ عُذرٌ لَنا",0,"ن",2,0],["سَلَبتَهُمُ عِزَّ الثَراءِ فَلَم تَدَع","لَهُم ما يَرى مِنهُ العَدوُّ المُنافِسُ",1,"س",1,0],["سَل بِقَومٍ نَزَلَ الدَهرُ بِهِم","فَأَساءَ اللُبثَ فيهِم وَالجِوارا",2,"ر",2,0],["سَلَبَ العِدَى كُتْبِي فَقَامَ بِنُصْرَتِي","حِفْظِي عَلَى عَجَلٍ وَفهْمِ جَنَانِ",3,"ن",1,0],["سَلَبَتْ نَسِيمَ الرَّوْضِ رِقَّةَ عِطْفِهِ","وَوَقَارُهَا يَزْكُو عَلَى ثَهْلاَنِ",4,"ن",1,0],["سَلَبَ السَماءَ نُجومَها","فَهَوَت بِلُجَّتِهِ تَعومُ",5,"م",1,0],["سَلَبتَ بِحارَ الأَرضِ دُرَّ كُنوزِها","فَأَمسَت بِحارُ الشِعرِ لِلدُرِّ مَورِدا",6,"د",2,0],["سلْ بالمشارق صبحَها عن وجهه","يفتر منه عن جبين نهارِ",7,"ر",1,0],["سلْ بالغمائم صوبَها عن كفه","تُنْبئْكَ عن بحر بها زخّارِ",7,"ر",1,0],["سلْ بالبروق صفاحها عن عزمه","تُخْبِرْكَ عن أمضى شباً وغِرارِ",7,"ر",1,0],["سل بنا العلم والفنون جميعاً","هل ملكنا بغيرها الأقطارا",8,"ر",2,0],["سل بنا العدل في جميع الرعايا","هل عَمَرْنا بغيره الأمصارا",8,"ر",2,0],["سل بنا الغُرّ من كبار المساعي","هل طلبنا بغيرهنّ فَخارا",8,"ر",2,0],["سل بنا هذه الدماء الدوامي","هل غسلنا بغيرهنّ العِمارا",8,"ر",2,0],["سل بنا هذه النجوم الدَراري","هل رضينا تحت النجوم قرارا",8,"ر",2,0],["سَلَبتُ بِها هَجراً بُيوتَ نِعاجِهِ","وَرُعتُ قَطاهُ في المَبيتِ وَقائِلا",9,"ل",2,0],["سَلَبنا عَرشَ رَبَّتِكُم فَبِتنَا","بِهَا وَسطَ الاَسِنَّةِ مُعرِسِينَا",10,"ن",2,0],["سلبت بمقلتها فؤاداً واجباً","حتى عرفت السلب والإيجابا",11,"ب",2,0],["سلبت عقلي بأحداقٍ وأقداح","يا ساجيَ الطرف أو يا ساقيَ الرَّاح",12,"ح",1,1],["سلبت محاسنك الغزال صفاته","حتى تحيَّر كلّ ظبي فيك",13,"ك",1,1],["سلبتْني سوادَ رأسِي ولكن","عوّضتْني رياشَ كلِّ سليبِ",14,"ب",1,0],["سلَبته الخطوب ما في يديه","وله من تَجمُّلٍ أثوابُ",15,"ب",1,0],["سُلِبتُ سوادَ العارضِيْن وقبلُهُ","بياضَهما المحمودَ إذ أنا أمْردُ",16,"د",1,0],["سلبَ الزمانُ جمالَه عن نفسهِ","فغدا وراحَ وما عليه جمالُ",17,"ل",1,0],["سَلَبَ الفُؤادَ رَواه وَالجَفنَ الكَرى","هَمٌّ عَرا فَكِلاهُما مَوتورُ",18,"ر",1,0],["سلب المال من صنوف الرعايا","وعليهم منه بقايا بعد",19,"د",1,0],["سلبوا القبائل مالها بوسائل","لا يستطيع كخلقها الشيطان",20,"ن",1,0],["سَل بِلَفنا أَكُنتَ تُدرَكُ فيها","وَلَوَ أَنَّ المُحاصِرينَ الأَنامُ",21,"م",1,0],["سَل بِهِ أَندَلُساً هَل سَلِما","مِن أَخي صَيدٍ رَفيقٍ مَرِسِ",22,"س",1,0],["سُلِبَ العِزَّ بِشَرقٍ فَرَمى","جانِبَ الغَربِ لِعِزٍّ أَقعَسِ",22,"س",1,0],["سَل بِها أَندَلُساً هَل قَصَّرَت","دونَ مِضمارِ العُلى حينَ أَهابا",23,"ب",2,0],["سَلَبَت مِصرَ عِزَّها وَكَسَتها","ذِلَّةً ما لَها الزَمانَ اِنقِضاءُ",24,"ا",2,0],["سَلَبَتها الحَياةَ فَاِعجَب لِرَقطا","ءَ أَراحَت مِنها الوَرى رَقطاءُ",24,"ا",2,0],["سَلْ بي بناتِ الدهرِ فهي خبيرةٌ","أني عن المرعَى الذميمِ عَزُوبُ",25,"ب",1,0],["سَل بِهِ إِن جَهِلتَ قَولي وَهَل يَج","هَلُ ذو الناظِرَينِ هَذا الضِياءَ",26,"ا",2,0],["سُلِبوا وَأَشرَقَتِ الدِماءُ عَلَيهِمُ","مُحمَرَّةً فَكَأَنَّهُم لَم يُسلَبوا",27,"ب",3,0],["سَلَبتُ صَدرَ النَهارِ لَذَّتَهُ","ثُمَّ اِستَباحَ العَشِيُّ لَذّاتي",28,"ي",1,0],["سَلَبوا أَبيضَ بَزَّها فَأَقاموا","بِظُباها التَأويلَ وَالتَنزيلا",29,"ل",2,0],["سَل بِهِ تَخبَرِ العَجيبَ وَإِن كا","نَ السَماعُ المَأثورُ دونَ العِيانِ",30,"ن",1,0],["سَلَبْناها الزِّقاقَ ونحنُ أَولَى","بما تحوي الزِّقاقُ من الزِّقاقِ",31,"ق",1,0],["سَلَبَتْه النَّوى بدورَ تَمامٍ","تركتني من العَزاءِ سَليبا",32,"ب",2,0],["سَل بانَةَ المَنصورِ أَينَ حَديثُهُ ال","مَرفوعُ عَن ذَيلِ الصَبا المَجرورِ",33,"ر",1,0],["سَلَبَت مَحاسِنُهُ العُقولَ بِناظِرٍ","يُصدي القُلوبَ وَمَنظَرٍ يَجلو الصَدا",34,"د",2,0],["سَلَبَتهُ الأَيّامُ غَدراً وَكانَت","طَوعَ كَفَّيهِ في الأُمورِ الشِدادِ",35,"د",1,0],["سَلَبَتنا فَواتِكُ اللَفَتاتِ","إِذ سَبَقنا بِالخَيفِ كُلَّ فَتاةِ",36,"ه",1,1],["سلبُوا سَيْفَهُ وفيه نجيعٌ","منهمُ كالشقيق فوق الأتيِّ",37,"ي",1,0],["سَلَبنا غِطاءَ الحُسنِ عَن حُرِّ أَوجُهٍ","تَظَلُّ لِلُبِّ السالِبيها سَوالِبا",38,"ب",2,0],["سلبَ الأغصانَ ليناً","فَهْيَ بالأوراقِ تشكو",39,"و",1,0],["سَلَبَ القَلبَ دَلُّها وَنَقيٌّ","مِثلُ جيدِ الغَزالِ يَعلوهُ نَظمُ",40,"م",1,0],["سَلَبَتني عَقلي غَداةَ تَبَدَّت","بَينَ خَودَينِ كَالغَزالَينِ رَيعا",41,"ع",2,0],["سَلَبتِ هَداكِ اللَهُ قَلبي فَأَنعِمي","عَلَيهِ وَرُدّي إِذ ذَهَبتِ بِهِ قَمرا",42,"ر",2,0],["سَلَبتِ عِظامي لَحمَها فَتَرَكتِها","مُعَرَّقَةٌ تَضحى إِلَيهِ وَتَخصَرُ",43,"ر",1,1],["سلبوه العقلَ ممّا عَربدوا","وسَقَوهُ من خَبالٍ وَلمَمْ",44,"م",1,0],["سَلَبَ الجبانُ بها الشجاعَ ذِراعَه","وهَوى الضَّعيفُ بهامةِ الجبّارِ",45,"ر",1,0],["سلبوا التراثَ المُستباحَ وأولعوا","ببقيّةِ الأسلابِ والأنفالِ",46,"ل",1,0],["سَلَبُ الشُعوبِ لِمَن يُقَلِّبُ حَولَها","ظُفراً مِنَ العِلمِ العَتيدِ وَنابا",47,"ب",2,0],["سَلَبوا اللِقاحَ وَإِنَّ دينَ مُحَمَّدٍ","لَأَعَزُّ مِن إِبلٍ عَلَيهِ وَضانِ",48,"ن",1,0],["سَلَبَ المُغيرُ حَياتَهُ وَاِستَأصَلَت","أَيدي الجَوانِحِ عِزَّهُ اِستِئصالا",49,"ل",2,0],["سَلْ بَغْلَةً حَملتْ رَسولَ اللَّهِ هل","حَمدتْ فَوارِسَهَا العتاقُ الشُّزَّبُ",50,"ب",1,0],["سَلَبَ الثُرَيّا في البُعادِ مَحَلَّها","وَأَعارَ جَفني نَوءَها المُستَغزَرا",51,"ر",2,0],["سُلِبَ الذِكرَ في الحَياةِ جَزاءً","وَأَراهُ العَذابَ وَالتَدميرا",52,"ر",2,0],["سَلَبتَ سِلاحي بائِساً وَشَتَمتَني","فَيا خَيرَ مَسلوبٍ وَيا شَرَّ سالِبِ",53,"ب",1,0],["سَل بِحَقِّ اللَهِ عَينَكِ عَنّي","هَل أَحَسَّت في الوَرى بِقَتيلِ",54,"ل",1,0],["سَل بِالصَبوحِ غَبوقا","وَلاتَكُن مُستَفيقا",55,"ق",2,1],["سَلَبْتُهُ الرُّقادَ بَيْضَةُ خِدْرٍ","ذاتُ حُسْنٍ كالدُّرَّةِ المَكْنُونَهْ",56,"ن",2