{"poems":[[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[79,"أيا سبع الميدان غير مدافع","https://www.aldiwan.net/poem36347.html","الطويل"],[53,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[72,"لئن صدقتني في الحديث ظنوني","https://www.aldiwan.net/poem42435.html","الطويل"],[47,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[47,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[30,"ألكني إلى راعي الخليفة والذي","https://www.aldiwan.net/poem5167.html","الطويل"],[30,"لئن صبر الحجاج ما من مصيبة","https://www.aldiwan.net/poem5279.html","الطويل"],[54,"أقول وقد ضاقت بأحزانها نفسي","https://www.aldiwan.net/poem26918.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[108,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[102,"عتيادان","https://www.poetsgate.com/ViewPoem.aspx?id=50338",""],[102,"اعتيادان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67682&r=&rc=169",""],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[164,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[186,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[203,"تميل بالأفلاك مثلي آمال","https://www.aldiwan.net/poem45367.html","الطويل"],[255,"بذل وجهي إلا لمثلك بذله","https://www.aldiwan.net/poem15011.html","الخفيف"],[266,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[302,"ليقعد الدهر بي ما شاء وليقم","https://www.aldiwan.net/poem33170.html","البسيط"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[376,"لئن صدقت في وعدها أن سنلتقي","https://www.aldiwan.net/poem57268.html","الطويل"],[409,"أتاني در النظم من عالم مهدي","https://www.aldiwan.net/poem33950.html","الطويل"],[411,"أقول وروعي للفراق مروع","https://www.aldiwan.net/poem49882.html","الطويل"],[445,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[447,"يا من تفرد بالإجلال والكرم","https://www.aldiwan.net/poem14292.html","البسيط"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[500,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[592,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86591","الطويل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203796","الوافر"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29603","الطويل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205466","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82614","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26676","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118317","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118424","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48265","البسيط"],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134210","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115627","المجتث"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100824","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48325","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129431","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91127","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117997","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75681","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94704","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136619",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[5136,"بكى سحرة لما تألق باسما","https://www.poetsgate.com/ViewPoem.aspx?id=121672",""],[5155,"تحية وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=176276",""],[5277,"بنتُ العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=185881",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5401,"سوار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=142367",""],[5431,"أنا سوري","https://www.poetsgate.com/ViewPoem.aspx?id=185605",""],[5596,"رد على خليل الجابري","https://www.poetsgate.com/ViewPoem.aspx?id=206719",""],[5606,"الليالي تكشف الزيف وتبين الوجيه","https://www.poetsgate.com/ViewPoem.aspx?id=197128",""],[5790,"تعشقت بدرا وجهه مشرقٌ كذا","https://www.poetsgate.com/ViewPoem.aspx?id=111948",""],[5950,"غثى ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128333",""]],"verses":[["لَئِنْ صافَحَتْ أخرى على نأي دارِها","يَميني فلا سَلَّتْ على القِرْنِ مُنصُلا",0,"ل",2,0],["لَئِنْ صَغَّرُوا مِنْكَ السُّبَيْعَ فَإِنَّهُ","لَتَصْغِيرُ تَعْظِيمٍ بِهِ الْفَخرُ حَاصِلُ",1,"ل",1,0],["لئن صُغِّرَ ما تُدعى","به ما كُبِّر المعنَى",2,"ن",2,0],["لَئِن صَدَّقَتني في الحَديثِ ظُنوني","لَقَد نَقَلَت سِرّي وُشاةُ جُفوني",3,"ن",2,1],["لَئِن صَدَفَت عَنّا فَرُبَّةَ أَنفُسٍ","صَوادٍ إِلى تِلكَ الخُدودِ الصَوادِفِ",4,"ف",1,0],["لَئِن صُنتُ شِعري عَن رِجالٍ أَعِزَّةٍ","فَإِنَّ قَوافيهِ بِوَصفِكَ أَليَقُ",5,"ق",1,0],["لَئِن صَبَرَت نَفسي لَقَد أُمِرَت بِهِ","وَخَيرُ عِبادِ اللَهِ مَن كانَ أَصبَرا",6,"ر",2,0],["لَئِن صَبَرَ الحَجّاجُ ما مِن مُصيبَةٍ","تَكونُ لِمَرزوءٍ أَجَلَّ وَأَوجَعا",7,"ع",2,1],["لَئِن صِرتِ لِلبَقالِ يا شُرُّ زَوجَةً","فَلا عَجَبٌ قَد يَربُضُ الكَلبُ في الشَمسِ",8,"س",1,0],["لئنْ صحَّ ما كان من أمرهِ","فيا شِقْوَةَ الأرضِ ممَّا يكونْ",9,"ن",1,0],["لئن صدَّت اليومَ عني، فكم قا","بلَتني مقابلةَ الفاتحين!",10,"ن",1,0],["لي نصيبي من التفاهات، لكن","لن تريني.. أريد منها ازديادا",11,"د",2,0],["لي نصيبي من التفاهات ، لكن","لن تريبي … أريد منها ازديادا",12,"د",2,0],["لَئِن صَحَّ أَنَّ العَدلَ في العُمرِ زائِدٌ","فَأَيسَرُ ما تَأتيهِ يُفضي إِلى الخُلدِ",13,"د",1,0],["لئن صد عني معرضا فلكم ثنا","إلي محياه وكم زارني عجبا",14,"ب",2,0],["لَئن صَدَقَتْ فيكَ العُيونُ بِدَمعِها","فَإِنَّ قُلوبَ القَومِ بِالجَرحِ تَدَّعِي",15,"ع",2,0],["لئن صرتِ معطالاً فكلُّ مليحةٍ","كمثلكِ تمضي للكرى وهيَ معطالُ",16,"ل",1,0],["لي نصفيَّةٌ تَعُدُّ من العُم","ر سنينا غَسَلتُها ألفَ غَسلَه",17,"ل",2,0],["لئن صدني مع عظم شوقي ملازم","إليك بقلبي واجتهاد مواظب",18,"ب",1,0],["لئن صدعتَ صَفاةَ الشمل مجتهداً","فَما عطفتَ على قُربى ولا رحِمِ",19,"م",1,0],["لَئِن صِرتَ فَوقَ الأَرضِ أَرضاً فَرُبَّما","عَهِدناكَ مِن فَوقِ السَماءِ لَنا سَما",20,"م",2,0],["لئِن صدَقَت في وَعدِها أن سَنَلتَقي","فذاكَ لتَعجيلِ اجتِماعٍ مُفرِّقِ",21,"ق",1,1],["لينصر شرع اللّه ممن أصابه","بجهل وتقليد الأوائل عن عمد",22,"د",1,0],["لئنْ صَدَّعَ الدَّهرُ المُشِّتتُ جمعَنا","فلِلدَّهرِ حُكمٌ للجُموعِ صَدوعُ",23,"ع",1,0],["لئِنْ صَدِئَتْ أَلبابُ قومٍ بمكرِهِمْ","فسيفُ الهدى فِي راحَتَيْكَ صَقيلُ",24,"ل",1,0],["لئن صفحت عن الجاني فذا أملي","وإن غضبت فلا جور فمن جرمي",25,"م",2,0],["لئن صار مدفوناً وحيداً بقبره","فإني بأحزاني عليه لأوحد",26,"د",1,0],["لئن صوَّت الرعد في أفقِهِ","وأبدَى السحاب سنا بَرْقِهِ",27,"ق",2,1],["لينصبوا من قد رأوا واتفقوا","عليه قال إنني لأشفق",28,"ق",1,0],["لينصر هذا الدين من بعد ما عفت","معالمه في الأرض بين العوالم",29,"م",1,0],["لينصر مظلوماً وَيزجر ظالِماً","وَيَقضى بِما تُمحى لَدَيهِ المَتاعب",30,"ب",1,0],["لئن صنت في تلك المعاهد أدمعي","لقد عهدت منى الخيانة والغدر",31,"ر",1,0],["لئن صلب المسيح فألف فجرٍ","تدفق من جراحات المسيح",32,"ح",1,0],["لَئِن صَبَّحَتكُم يَومَ نَحسٍ جِيادُهُ","رِعالاً وَرَيعانُ العَجاجِ مُثارُ",33,"ر",1,0],["لئن صبرت عن رزئها وتجملت","ففي الصبر عن امثاله يعظم الأجر",34,"ر",1,0],["لَئِن صَدَرَت لي زَورَة عَن محمد","بِمَنع لَقَد فارَقتُه وَمعي قَدري",35,"ي",1,1],["لئن صحوتُ فعن كَرهٍ وقد علموا","بأيّ علقٍ من الدنيا فتحتُ يدي",36,"د",2,0],["لئن صرمت حبال الوصل مني","لما خنت العهود ولا صرمت",37,"ت",1,0],["لئن صدئت من عينك اليوم صفحة","ما في الصدا عار على الهندوانيه",38,"ي",2,0],["لئن صَدَدْنَ لشيبي وارْعَوَوْا مَللاً","فمذهبُ البِيضِ يأبى الشيبَ والهرَما",39,"م",2,0],["لئن صح ما قد قيل من ان عزلكم","بتدبير ذي الراي المسدد انطون",40,"ن",1,0],["لئن صُرفت وحاشا","كَ فالدنانيرُ تصرف",41,"ف",1,1],["لئن صادفت منك القبول فقد غدا","مُحرّرُها من رقّة يتحرّرُ",42,"ر",1,0],["لئن صادها غيرى بناب وبرثن","وبات بها تحت الجدار ممتعا",43,"ع",2,0],["لَئن صدِئَتْ بالأمْنِ أفْئِدَةُ العِدى","فهذِي التي يجْلو صَداها صَقيلُها",44,"ل",3,0],["لئن صرمت حبلي فإني مغيثها","بهتان دمع غير منصرم الحبل",45,"ل",1,0],["لَئن صدّني الأَقدار أَو رَدَّني المُنى","فَقد يَكهُمُ الهندي وَقَد تُقصَفُ السمرُ",46,"ر",1,1],["لينصر مظلوماً ويزجر ظالماً","ويفرح محزوناً ويسعف مسكينا",47,"ن",2,0],["لئن صدئت أَفكارهم من غواية","فَفي كفك السيف الصَقيل التَرائب",48,"ب",1,0],["لئن صقلت دهري محاسن صالح","فأجدر بأن تجلي غبار مساويه",49,"ي",2,0],["لئِن صالت الأسباب في كل مانعٍ","عليَّ بأسيافٍ مواضٍ لوامعِ",50,"ع",1,1],["لئن صَفحت عيناه في يَوم قُربه","فسيفُ نواه اليومَ لا شك قاتلي",51,"ل",2,0],["لئن صحت إني أسمع الصوت صارخاً","إلى بأبناء الجزيرة يجهر",52,"ر",1,0],["لين صد عني طال فلطالما","ترشفت فاه في العناق وطالما",53,"م",2,0],["لئن صرت ترنو الى صورتي","فانت معي بخيالي اراك",54,"ك",1,0],["لي نصفك المملوءُ من رأدِ الضحى","ولهم فراغُ الكأسِ صارَ وعيدا",55,"د",2,0],["لئن صح عرس ابن الزكي بكربلا","فقد كانت الأعراس فيها مآتما",56,"م",2,0],["لئن صفرت بيضاء كفي من الثرى","فبالبيض من نطقي أدافع عن عرضي",57,"ض",2,0],["لين صارت دنيتي مبحص قطاتي","والعزي إن الخلق من ماء وطينه",58,"ن",2,0],["لئِنْ صبرتُ على جوعٍ يُقطعني","ويهتك الجسم هتكا كالسكاكينِ",59,"ن",1,0],["لينصبه على قمم الرواسي","عليّاً ثابتاً صلب الأساس",60,"س",1,0],["لين صار الناس من شين طبعه ماتبيه","ماترد على هروجه يكون بصبعها",61,"ع",3,0],["لئن صدعني معرضا متدللا","وأصبح حبل الود ما بيننا كذا",62,"ذ",2,0],["لين صوتك بسمعي مرّ حتى عثى","فيني وقام يقطف كل حزنٍ خبيث",63,"ث",1,0]]}