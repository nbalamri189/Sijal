ww.poetsgate.com/ViewPoem.aspx?id=201997",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[4190,"حيا العهاد معاهد الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=152454",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5184,"لأنك العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186052",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[2365,"ألاهل الى ورد العراق سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=200655",""],[5232,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213462",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"نورس الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=186441",""],[5277,"القصيدةُ القيسيّة","https://www.poetsgate.com/ViewPoem.aspx?id=199277",""],[5281,"تاجُ الوقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=208058",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5362,"وزهرة طيبها من طبع صاحبها","https://www.poetsgate.com/ViewPoem.aspx?id=170343",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5388,"أفديك لولا الرّدى","https://www.poetsgate.com/ViewPoem.aspx?id=206907",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5431,"أن ليس قلبك يشقى","https://www.poetsgate.com/ViewPoem.aspx?id=197046",""],[5431,"يامصر...","https://www.poetsgate.com/ViewPoem.aspx?id=202807",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5628,"ثورة حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178669",""],[5667,"لا ترحلي عني","https://www.poetsgate.com/ViewPoem.aspx?id=215056",""],[5704,"لَيْلُ الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=191213",""],[5785,"ذكرتك وقد فاض دمع الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131563",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[5853,"((رهطٌ من الجن))","https://www.poetsgate.com/ViewPoem.aspx?id=175656",""],[5861,"هذا نداه","https://www.poetsgate.com/ViewPoem.aspx?id=188089",""],[5956,"جمال جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182670",""],[5956,"أصدقاء خالدون","https://www.poetsgate.com/ViewPoem.aspx?id=194831",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6093,"ما كل ما فات مات","https://www.poetsgate.com/ViewPoem.aspx?id=199359",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""],[6134,"هذي الرواية قد أتت بنفائس","https://www.poetsgate.com/ViewPoem.aspx?id=169552",""],[5309,"دع عنك لومي ولا تسأل عن الخبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573960",""],[6171,"بيت شعري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86322&r=&rc=0",""],[6176,"رأيت جرحي واقفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65154&r=&rc=5",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["وزُهْدُكَ في الأنْثى شَهيدٌ مُثبِتٌ","وما ضَلّ مَنْ بالحَقِّ جاءَ ولا غَوى",0,"و",2,0],["وزهرةُ الرَّوضِ لولا حُسنُ رونقِها","لمَا استَطالَتْ عليها كفُّ جانيها",1,"ي",3,0],["وَزَهرَةٌ غَضَّةٌ أَلقى الإِمامَ بِها","لَها عَلى أُختِها في الرَوضِ إِدلالُ",2,"ل",1,0],["وَزَها جَنابُ الشُكرِ حينَ مَطَرتَهُ","بِسَحائِبِ النُعمى فَرُدَّ خَصيبا",3,"ب",2,0],["وزهر الورى خضرٌ بالهنا","وملك البريَّة إسكندر",4,"ر",1,0],["وزهادة تبع ابنُ أدهم سبقها","في غرَّة أجرى بقاها الأبرشا",5,"ش",2,0],["وزهت برؤيته الديار كأنما","كلُّ النسيم على الديار قبول",6,"ل",1,0],["وزهَّدني في الناس معرفتي بهم","وطُول اختياري صاحباً بعد صاحبِ",7,"ب",1,1],["وزهَّدتْني أياديكُمْ وفضْلُكُمُ","في كل شيء سواها كل تزهيدِ",8,"د",1,0],["وزهاها من فَرْعِها ومن الخد","ديْنِ ذاك السَّوادُ والتَّوْريدُ",9,"د",1,0],["وزهاها سوادُ فرعٍ بهيمٌ","فهْي سكرى لذاك سُكْر اختيالِ",10,"ل",1,0],["وَزَهِدتُ في وَلَعِ الصِبا","فَاليَومُ نَهري ساقِيَه",11,"ي",2,0],["وزهورُ الحياة تهوي بِصَمْتٍ","محزنٍ مُضْجِرٍ على قدميَّا",12,"ي",2,0],["وزهورٍ من الأَمانيِّ تذوي","في شُحُوبٍ وخيبةٍ وخمولِ",13,"ل",1,0],["وزهورُ الحَيَاةِ تعبقُ بالعِطْرِ","وبالسِّحْرِ والصِّبا في يديْنَا",14,"ن",2,0],["وزهرٌ ينمِّقُ تِلْكََ التِّلالَ","ويَنْهَلُ من كلِّ ضَوءٍ جَديدْ",15,"د",1,0],["وزهرتين على عود يُقِلهما","كعاشقين أطمأنا باللقا الهاني",16,"ن",2,1],["وَزَهو الأُبُوَّةِ مِن مُنجِبٍ","يُفاخِرُ مَن لَيسَ بِالمُنجِبِ",17,"ب",1,0],["وَزَهَت لِناظِرِها السَماءُ وَقَرَّ ما","في البَحرِ مِن عُبُبٍ وَمِن تَيّارِ",18,"ر",1,0],["وزهَّدنِي بالكَدِّ علمي بأنني","خُلقتُ على ما فِيَّ غيرَ مُخَيَّرِ",19,"ر",1,0],["وَزُهدِها في الدُنُوِّ مِنكَ فَما","تُعطيكَ إِلّا بِالتَعسِ وَالعُنُفِ",20,"ف",1,0],["وَزَهرانُ أَلقى في دُجَيلٍ بِنَفسِهِ","مُنافِقُها إِذ لَم يَجِد مُتَعَبَّرا",21,"ر",2,0],["وزَهَتْ بلادُ الحِصنِ بالقَمَر الذي","أهدى إلى القمرِ المُنيرِ كُسوفا",22,"ف",2,0],["وزَهَّدَني عارُها في الخِضابِ","فجانبْتُ زُورَ الشَّبابِ المُعارِ",23,"ر",1,0],["وزَهْرٌ إذا ما اعتَبَرْنا النسيمَ","حَسِبناهُ يمسَحُ منه العَبيرا",24,"ر",2,0],["وزهَّدَه خِضابُ الناسِ لمَّا","تولَّى عنه في زُورِ الخِضابِ",25,"ب",1,0],["وَزَهرُ نيلوفَرٍ لَولا تَشَعُّبُهُ","لَظَنَّ أَنواعَهُ الراؤونَ ياقوتا",26,"ت",2,1],["وَزَها زَهرُها الأَنيق","إِذ بَكَت أَعيُنُ الغَمام",27,"م",1,0],["وزهورُها وطيورُها وسرورُها","وقصورُها وديورُها للمجتلي",28,"ل",2,0],["وَزَهَّدَني في ذَلِكَ الخالِ نِسبَةٌ","أَراها بِخالِ الخَدِّ مِن جُعلِ الوَردِ",29,"د",1,0],["وَزَهرَةٌ غَضَّةٌ تَفتَرُّ عاطِرَةٌ","مِن رَوضَةٍ لَدنَةِ الأَنفاسِ مِخضالِ",30,"ل",1,0],["وَزُهَيْرٌ وَالْمُطْعِمُ بنُ عَدِيٍّ","وَأبو البَخْتَرِيِّ مِنْ حيث شاؤوا",31,"ا",1,0],["وَزَها بِالحُسنِ لَمّا","صارَ في الحُسنِ حَكاكا",32,"ك",2,0],["وَزَهَّدَني في الخَلقِ مَعرِفَتي بِهِم","وَعِلمي بِأَنَّ العالَمينَ هَباءُ",33,"ب",3,0],["وَزَهَّدَني في هَضبَةِ المَجدِ خَبرَتي","بِأَنَّ قَراراتِ الرِجالِ وُهودُ",34,"د",1,0],["وزَهَتْ بمصباحٍ جوانبُها","صاف الزُّجاجةِ راقصِ اللهَبِ",35,"ب",1,0],["وَزَهَتْ فَرَائِدُهُ فَصَارَتْ غُرَّةً","لِجَبِينِ كُلِّ مُتَوَّجٍ وَمُقَنَّعِ",36,"ع",1,0],["وَزَهَتْ بِأَقْمَارِ الْهُدَى","وَسَطَتْ بِأَظْفَارِ الأُسُودِ",37,"د",1,0],["وزهدٌ له الدنيا جناح بعوضة","وكل الذي تحت الهباءِ هَباءُ",38,"ا",2,0],["وزَهْرٌ من الآمالِ رفّ بروضةٍ","بها الأرضُ مسكٌ والنسيمُ مَلاب",39,"ب",1,0],["وَزَهَا النِّيلُ بابْنَةِ النِّيلِ فَاخْتَا","لَ يَجُرُّ الذُّيُولَ مِنْ إِعجَابِهْ",40,"ب",2,0],["وَزَهَتْ بهِ العَزَمَاتُ بَعْدَ ذُبُولِهَا","وَصَحَتْ به الآمالُ بَعْدَ رُقُودِ",41,"د",1,0],["وَزَهَتْ في مَقَاصِرِ الْمُلْكِ زَهْرَا","ءَ فَزَانَتْ مَقَامَهُ الْمَحْمُودا",42,"د",2,0],["وزهرة ما رأى النيل الوفي لها","بين الأزاهر في واديه أشباها",43,"ا",3,0],["وزهت ثريَّاتٌ حلفت بأنها","ليست كنور جبينه في النادي",44,"د",2,0],["وَزَهَّدَنِي في كِسْرَة الخبز: أنني","وَجَدتُ صِراعًا حولها، وتفانيا",45,"ي",2,0],["وزهرة أخشى على حسنها","من خطرة الفكر ونجوى العيون",46,"ن",1,0],["وزهَّدني في الناس معرفتي بهم","وطُول اختباري صاحباً بعد صاحبِ",47,"ب",1,1],["وزهاها من فرعها ومن الخدي","ن ذاك السواد والتوريد",48,"د",1,0],["وزها يشرق في سم","ك العلا بادي سناها",49,"ا",3,0],["وزهد قد زوى الاكوان طرا","وصدق زان رونقه الوفاء",50,"ا",2,0],["وزهى به الكرسي وهو معظم","وبه تفاخر منبر وسرير",51,"ر",1,0],["وزَها في الدُّجى بِأَدْمُعِهِ الحَرَّاءِ","يَخْشَى مِنَ الإلهِ عِقابَه",52,"ب",2,0],["وَزهرَةٍ كانوا أَوليائي وَناصِري","وَأَنتُم إِذا تُدعَونَ في سَمعِكُم وَقرُ",53,"ر",1,0],["وزهر الربا والنجم عند طلوعه","وبدر الدجى كل عليه يسلم",54,"م",1,0],["وزهت ثغور الاقحوان على الربا","وتبسمت عن لؤلؤ الانداء",55,"ا",2,0],["وزهور الحقل تفتر لنا","عن ثغور خلقت للقبل",56,"ل",1,0],["وَزَهَت خِلافَتُهُ عَلى الم","اضينَ مِن خُلَفائِها",57,"ا",3,0],["وَزَهْوُنَا بِتَلاقِينَا وَأُلْفَتِنَا","أَغْرَى بِنا الأَعْجَمَيْنِ الطَّيْرَ وَالْوَتَرَا",58,"ر",2,0],["وَزَهْرُكَ يَبْقَى الدَّهْرَ وَالزَّهْرُ ذَابِلٌ","بَقِيتَ بَقَاءَ الدَّهْرِ لاَ الزَّهْرِ وَالزُّهْرِ",59,"ر",1,0],["وزهراً تُحيِّيكِ أنفاسُهُ","وطلّاً عليهِ كدمعي انتَثر",60,"ر",1,0],["وَزها بأحمد برده وَقَضيبه","وَالتاج وَالحوض المعين وَخاتمه",61,"م",2,0],["وزهرتهم أبو بكر فاكرم","بمشهور الفضائل والكمال",62,"ل",1,0],["وَزَها بِهِ دَستُ الوِزا","رَةِ منذ لُقِّبَ بالوَزيرِ",63,"ر",1,0],["وَزهرةٍ تخجلُ الياقوتَ حمرتُها","حييتُها بفمي إِذْ أشبهتْ فاك",64,"ك",1,0],["وزهادة وعبادة وشهادة","منه الغيوب بمنظر وبمسمع",65,"ع",1,0],["وزهرها عبقريّ النظم جن به","شعر الزمان فأمسى جدّ أسوان",66,"ن",1,0],["وزهور الرياض ترنو الينا","زاهيات الاشكال والالوان",67,"ن",1,0],["وَزَهَّدتُ فِيَّ الراغِبينَ عَنِ الهُدى","بِخَلعِ التُقى مِن بَعدِ لُبسِ التَنَسُّكِ",68,"ك",1,0],["وَزَهَت بِالعلم مَع أَدَبٍ","وَجَمال العلم بِالأَدَبِ",69,"ب",1,0],["وزَهِدْتُ في دُنيا تَشُحُّ بنَيْلِها","وإذا سَخَتْ لم تُولِ غيرَ زهيد",70,"د",1,0],["وزَهرةِ خدٍّ ما سقَتها دُموعُه","كذلكَ أذكى الزَّهرِ يَنبتُ في المَحلِ",71,"ل",1,0],["وزهوره تحكي الثغورَ","مقبلات فيه ورده",72,"د",2,0],["وزهره مُنَوَّع","والطير فيه تسجع",73,"ع",1,0],["وزهورها مقل وسجع طيورها","صوت الحلى على ذوات البرقع",74,"ع",1,0],["وَزَهَتْ خَلائِقُهُ فَرَفَّتْ جَنَّةَ","كمَّا أسالَ بها نَداهُ كَوْثَرَا",75,"ر",2,0],["وزهّرَتْ نجومُه","فويلَ من لم يهتدِ",76,"د",1,0],["وَزَهَتْ على مِصْرٍ وَحُقَّ لَها كَما","تَزْهُو بِهِمْ وَغَدتْ على بَغْدانِ",77,"ن",1,0],["وزهابك العهد الذي أوتيتهُ","وتفاخرت بك ألسُنُ الأقلام",78,"م",1,0],["وزهده أبقى حياة له","كالغيث في زهر الربا الباسم",79,"م",1,0],["وزهرٌ كأمثالِ الشُنوفِ لطافةً","تداخل من أجزائه البعض في البعضِ",80,"ض",1,1],["وَزَهرَةٍ في ذَكاءٍ مُختَبَري","وَقَهوَةٍ في صَفاءٍ مُعتَقِدي",81,"د",2,0],["وزهدنا في الكون طرا وأهله","وأودع سر العلم تحت الشراسح",82,"ح",1,0],["وزَها الرَّوضُ حينَ رُشَّ بِطَلٍّ","وتدَلَّتْ بالانْكِسارِ وُرُودُهْ",83,"د",2,0],["وزهدت في عيش نبت أكنافه","عني وفي حلف أضاع لبيدا",84,"د",2,0],["وزُهورُ ذاكَ الرَّوْقَ باسِمَةٌ بِهِ","فكأنَّها زَهْرٌ بصَحْنِ خُدودِ",85,"د",1,0],["وزهورنا بنسيمكم فواحة","هل للمتيم من جفاكم راحة",86,"ه",1,0],["وزَهرُها يحكِي بأَغْصانِه","قلائداً تعْلُو على خُرَّد",87,"د",1,0],["وزهت به تلك البلاد فلم تزل","مختالة في حلة اللألاء",88,"ا",2,0],["وزهت رياض البشر فوق غصونها","شدت الطيور فانعشت كل المهج",89,"ج",1,0],["وَزَهرَةً ذَهَبَت أَيدي الخُطُوبِ بِها","ما بَينَنا فَظَنَّنا أنَّها حُلُمُ",90,"م",1,0],["وَزَهلقُ النّارِ لا يَنسابُ طارِقُه","خَوفَ الكِلابُ ولا في خُلقِهِ زَهَقُ",91,"ق",1,0],["وَزَهِدتُ في العَشراتِ عِلماً أنَّني","أثرى وأمّا مِنكُمُ فَأُؤَلِّفُ",92,"ف",1,0],["وَزهَت بِدَولته رِياض مَدارسٍ","دَرست مَعالم جاهل وَمُنافق",93,"ق",1,0],["وَزَها وَقالَ مؤرّخاً","لُب اللواء لمظهر",94,"ر",1,0],["وَزَهَت وَعَمَّ سُهولَها وَجِبالَها","خصبٌ كَثير ما عَلَيهِ مَزيد",95,"د",1,0],["وَزَهَت أَيامُ نَجلِهْ","طوسنِ المَحفوظِ شبلِهْ",96,"ه",1,0],["وَزَهرٍ شَقيقٍ نازَعَ الوَردَ فَضلَهُ","فَزادَ عَلَيهِ الوَردُ فَضلاً وَقَدَّما",97,"م",2,0],["وزهدني في الحب أني رأيته","ضياعاً لنفسي يورث السخط والحقدا",98,"د",2,1],["وزُهْدي في قناطيرِ ال","غنى فاترُكْ قراريطَه",99,"ط",2,0],["وَزُهورُها مِن فَوقِها قَد نوّرَت","أَحْسِنْ بِرَوضٍ بِالزّهورِ مُنوَّرِ",100,"ر",1,0],["وزهاء كل خميلة أزهقتها","مهلاً تمهله وكل خبار",101,"ر",1,0],["وزهد المرء في الدنيا","يَقِيهِ من بلاياها",102,"ا",3,0],["وَزَهدتمُ وغفلتُمُ","عن ذي غرامٍ ساهرِ",103,"ر",1,0],["وَزَهَّدتِنِي في كُلِّ بَيضاءَ كاعِبٍ","تَهيمُ بِها للعَاشِقِينَ قُلُوبُ",104,"ب",1,0],["وزهدت بالدنيا التي طلقتها","متعففاً عن رجعة بطلاقها",105,"ق",3,0],["وَزَهَا خدُّ الرُّبَى فَانْسَجَمَا","دمعُ عينِ العارض المُنبجِسِ",106,"س",1,0],["وَزَهرَةٌ بِإِزاءِ البَدرِ واقِفَةٌ","كَأَنَّهُ غَرَضٌ يَنحوهُ نَشّابُ",107,"ب",1,0],["وَزَهرَةٌ أَشرَقَت مَصابِحُها","لَولا النَدى طارَ حَولَها شَرَر",108,"ر",1,0],["وزهتْ تيهاً كأن لها","منبتاً تزهى بمفتخرهْ",109,"ر",2,0],["وزها الوجود بخير مولودٍ أتى","لبشيرنا بالعز ذي القدر الفخيمْ",110,"م",1,0],["وزها الياسمين فوق خدودٍ","قد كساها الحياء منه ورودا",111,"د",2,0],["وزها أفق العلا وابتهجا","إذ تلألئ الكوكب الباهي السنا",112,"ن",2,0],["وزها 