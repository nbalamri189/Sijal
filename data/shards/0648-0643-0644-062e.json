{"poems":[[65,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[37,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"تأمل العيب عيب","https://www.aldiwan.net/poem8150.html","المجتث"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[87,"اللى يحب الجمال","https://www.aldiwan.net/poem6807.html","عموديه"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[45,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[35,"صفا ود ليلى ما صفا لم نطع به","https://www.aldiwan.net/poem25725.html","الطويل"],[50,"أنعت كلبا أهله من كده","https://www.aldiwan.net/poem63250.html","الرجز"],[52,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202689","المجتث"],[108,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[93,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=1208",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[37,"تظلُّ ابنة ُ الضَّمريِّ في ظلِّ نعمة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22010",""],[93,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67966&r=&rc=244",""],[185,"ألا يا خليلى اللذين أراهما","https://www.aldiwan.net/poem58875.html","الطويل"],[190,"العيش بين الرذال شوم","https://www.aldiwan.net/poem43297.html","مخلع البسيط"],[190,"يا قاتلا نفسه باللوم والعذل","https://www.aldiwan.net/poem43482.html","البسيط"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[234,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[303,"تركت هوى بيض الطلى والترائب","https://www.aldiwan.net/poem36291.html","عموديه"],[353,"يارب لا تشمت بنا حمزه","https://www.aldiwan.net/poem20391.html","السريع"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[396,"وليس للمرء بعد الموت من شجر","https://www.aldiwan.net/poem54444.html","عموديه"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[475,"تذكر سلمى بعد ما حال دونها","https://www.aldiwan.net/poem4693.html","الطويل"],[510,"خيال الحقل","https://www.aldiwan.net/poem27894.html","مجزوء الوافر"],[543,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[563,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86863","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38870","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145802","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56292","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64902","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144126","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50013","المتقارب"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115991","المجتث"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96058","الوافر"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20458","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106885","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75979","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102470","البسيط"],[2886,"","https://poetry.dctabudhabi.ae/diwan/poem/147792","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100795","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130062","المتقارب"],[3440,"","https://poetry.dctabudhabi.ae/diwan/poem/202298","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92430","الرجز"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18585","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124043","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4884,"بِشُؤْمِ المُتنبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=201772",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[4969,"سألت عن التكسير فاعلم بانها","https://www.poetsgate.com/ViewPoem.aspx?id=181709",""],[5490,"عاشق الزنبق","https://www.poetsgate.com/ViewPoem.aspx?id=176417",""],[5667,"الحياة ظل زائل","https://www.poetsgate.com/ViewPoem.aspx?id=214838",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5790,"وكل خضابٍ سوف ينصل صبغه","https://www.poetsgate.com/ViewPoem.aspx?id=111893",""]],"verses":[["وَكُلُّ خَليلٍ كُنْتُ أَرْقُبُ عَطْفَهُ","تَوَلَّى بِذَمٍّ وَالزَّمانُ مُرِيبُ",0,"ب",1,0],["وَكُلُّ خَليلٍ راءَني فَهوَ قائِلٌ","مِن اجلِكِ هَذا هامَةُ اليومِ أَو غَدِ",1,"د",1,0],["وكُلُّ خَلِيفَة وَوَلِيِّ عَهدٍ","وَمُنتَظَرٍ لأَمرِ المُؤمِنِينَا",2,"ن",2,0],["وكلُّ خيرٍ وشرٍّ","خلفَ العواقبِ غيبُ",3,"ب",1,0],["وَكُلُّ خَطيآتِهِم أَنَّهُم","يَقولونَ لا تُسرِفوا بَيتَنا",4,"ن",2,0],["وكل خالي مسيره","يعذب الحب باله",5,"ه",1,0],["وَكُلُّ خُرطومٍ أَدا","ةُ العَسَلِ المُقَطِّرَه",6,"ر",2,0],["وَكُلُّ خَطِّيَّةٍ مُثَقَّفَةٍ","يَهُزُّها مارِدٌ عَلى مارِد",7,"د",1,0],["وَكُلُّ خَليلٍ بَعدَ لَيلى يَخافُني","عَلى الغَدرِ أَو يُرضى بِوُدٍّ مُقارِبِ",8,"ب",1,0],["وَكُلُّ خَيرٍ عِندَهُم مِن عِندِهِ","يَظَلُّ مَولاهُ لَهُ كَعَبدِهِ",9,"د",2,0],["وَكُلُّ خَليلٍ بَعدَ عَينِكِ عَينُهُ","سَتُنكِرُني إِلّا بَقايا التَجَلُّدِ",10,"د",1,0],["وَكُلُّ خَيرٍ يُلَقّى في أَوامِرِها","وَكُلُّ شَرٍّ يُوَقّى في نَواهيها",11,"ي",3,0],["وكل خالى مصيره","يعذّب الحب باله",12,"ه",1,0],["وكل خدٍ به تفاحةٌ نضجت","وكل نَهْد حواه الصدرُ رمّان",13,"ن",1,0],["وكلُّ خطيئاتهمْ أنَّهمْ","يقولونَ º لا تسرقوا بيتنا",14,"ن",2,0],["وكلّ خصيب الكف فتحا وصولة","فداء لكف بالعبير خضيب",15,"ب",1,0],["وكلُّ خليلٍ راءَني فهو قائلٌ:","مِنْ کجْلِكِ هذَا هَامَة ُ اليومِ أوْ غَدِ",16,"د",1,0],["وكلّ خطيئاتهم أنّهم","يقولون : لا تسرفوا بيتنا",17,"ن",2,0],["وكُلُّ خَليلِ لا أَبالَكَ سائِقِى","إِلى غَدرَةٍ أو بائِعِى بِخَلِيلِ",18,"ل",1,0],["وكل خلق له مقام","فيه على طبعه ويقوم",19,"م",1,0],["وكل خلق له في جنسه عصب","من الرذال وأهل الفضل والنبل",20,"ل",1,0],["وَكلُّ خِلافٍ جاء عنهم فإنّه","لَنا رَحمةٌ مع أنّه قَد أتى نزرا",21,"ر",2,0],["وكلُّ خيرٍ عندنا نؤتاه","فبَعْضُ ما عاد به مَسْعاه",22,"ا",2,0],["وكلّ خليلٍ كنت آملُ ودَّه","نأَى ثانياً عطفيه عني بجانب",23,"ب",1,0],["وَكلُّ خَزَّانٍ أَذِقْهُ من ال","عمودِ في قلبٍ لهُ وَكْزَهْ",24,"ز",2,0],["وَكُلُّ خَوطٍ خاطِرُ مَيّادُهُ","هَزَّ القَنا فَالنَهيُ كَالمُرتَعِد",25,"د",1,0],["وكل خير فهو منه إليك أنى","ومن يقى السيآت أن تقع فيها",26,"ي",3,0],["وكُلِّ خَليٍّ عن الإِنْسِ رَهْنٍ","لِجَنْبَيْ خَلِيَّةِ بَحْرٍ خَلاءِ",27,"ا",2,0],["وكلُّ خرقٍ بذَّ السحائب سبقاً","وحثا الترب في وجوه الكرامِ",28,"م",1,0],["وَكُلُّ خَليطٍ لا مَحالَةَ أنَّهُ","إِلى فُرقَةٍ يَوماً مِنَ الدَهرِ صائِرُ",29,"ر",1,0],["وكلّ خيالِ حقلٍ وال","قلوبُ لربّها أقربْ",30,"ب",1,0],["وكلُّ خادِم فأَم","رُهُ إلى مَولاه",31,"ا",2,0],["وكل خمر له مدير","وكل كأس له سقاة",32,"ه",1,0],["وكل خطيب في قد جل خطبه","كما كل عبد في منى ربه",33,"ه",1,0],["وَكُل خَير يَدا عَلياك قَد مَنحت","بِهِ البَرية عِندَ اللَه مَبرور",34,"ر",1,0],["وَكُلّ خَدٍّ وَفيهِ قَد زَها خَفر","عليهِ خالٌ بِأَسنى الحُسنِ مَغمورُ",35,"ر",1,0],["وكلُّ خُطىً رَهْنُ ما تقتفي","وما سوفَ تتركُ أقدامُها",36,"م",3,0],["وكل خطاة الأرض طرّاً مآلهم","رجوع إلى وادي جحيم تسعّرا",37,"ر",2,0],["وكلُّ خُلْقٍ يُؤاتيني تخلُّقُهُ","إلاَّ عبادةَ مَخْلوقٍ لمِخْلوقِ",38,"ق",1,0],["وكلّ خدٍّ أسمرٍ أحمرٍ","عِذارُه كالماءِ في النّصلِ",39,"ل",1,0],["وكل خلوب صَيود القُلوب","بحسن عَروبٍ وغنج ودَلَّ",40,"ل",1,0],["وكلُّ خطبٍ أراهُ","إلاَّ فِراقَك سهلا",41,"ل",2,0],["وكل خمسين لها حقةٌ","تنوخ في قابلها الأصبع",42,"ع",1,0],["وكل خليفة ووليّ عهد","لكم يا آل مروان الفداء",43,"ا",2,1],["وَكُلُّ خَليلٍ عَلَيهِ الرِعا","ثُ وَالجُبُلاتُ كَذوبٌ مَلِق",44,"ق",1,1],["وكلُّ خُلفٍ بالوعدِ ضعفٌ","وكل صعبٍ عالجتَ هينُ",45,"ن",1,0],["وَكُلّ خَطيب في النَوائِبِ مُفحِمٍ","وَهُم في رَخاءِ العَيشِ فُصحٌ مَساقِعُ",46,"ع",1,0],["وكل خبيث عند ربك قد نهى وخذ","آية في النحل من في فتى قرا",47,"ر",2,0],["وكلُّ خلٍّ له خليل","وكلُّ رقٍّ لهُ سادات",48,"ت",1,0],["وكل خفيف الشأن يسعى مشمراً","إذا فتح البواب بابك اصبعا",49,"ع",2,1],["وَكل خَمّارٍ وفي كفهِ","كأسٌ على عاتقهِ جرَّه",50,"ر",2,0],["وكلٌّ خافض عينيه حزناً","لفقدكِ من بكاء وانتحاب",51,"ب",1,0],["وكلّ خلافٍ إذا ما سرى","بقومٍ تراخوا وحلَّ الفشل",52,"ل",1,0],["وكل خير مضى أو ناله سلف","للمرء في اللوح عند الله محسوب",53,"ب",1,0],["وكل خيرٍ واهبٍ","يتلوه شرٌ ناهبُ",54,"ب",1,0],["وَكُلُّ خَيرٍ وَكُلُّ شَرٍّ","فيها قَمينٌ بِأَن يَحولا",55,"ل",2,0],["وكل خلٍ معنا لقد فتن","وظل يرمينا بقوس الطرد",56,"د",1,0],["وكل خرق لدى الأواء ذي منح","وكل قرم إلى الهيجاء منتدب",57,"ب",1,0],["وكل خفيٍّ سوف يظهر معلناً","وكل فسادٍ سوف يندم صاحبُه",58,"ب",2,0],["وكلّ خرعَبَة في خلقها عممٌ","من سر خرعبة في خلقها عمم",59,"م",1,0],["وكل خطيب كلَّ عن عدٍّ بعضه","أفضت عباب الفضل من بعد غيضه",60,"ه",1,0],["وكُلُّ خليلٍ خانَ ودِّيَ خِفْتُهُ","وإِن لم يَخُنْي فَهْوَ بِالشُّؤْمِ يُنْظَرُ",61,"ر",1,0],["وكلُّ خليِّةٍ أضحتْ بجسمي","تحبُّ المرتضى ولهُ توالي",62,"ل",2,0],["وكل خماسيٍ إذا ماجمعته","فآخره فاحذف ولاتتعثر",63,"ر",1,0],["وكل خدٍّ بوهج الشوق ملتهبٌ","يزداد ذَوباً إذا المحبوب قبّله",64,"ل",2,0],["وكلُّ خلٍّ إذا ما يَنقضي زَمَنُ","يَبِينُ معدِنُهُ الصافي أو الصَدَفُ",65,"ف",1,0],["وكل خير غدا نظمي يؤرخهُ","نهديه سوريةً ما دامت واليها",66,"ي",3,0],["وكل خودٍ بدت خرسٌ أساورها","وسائر الحلي يبدي أعذب النغمِ",67,"م",1,0],["وكل خضابٍ سوف ينصل صبغه","وما لخضاب الود فيك نصول",68,"ل",1,1]]}