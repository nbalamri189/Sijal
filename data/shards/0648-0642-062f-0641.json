bi.ae/diwan/poem/66104","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33378","الوافر"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22805","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120478","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139622",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139546",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"ضمان الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179967",""],[463,"حمامَ اللوى رفقاً به فهو لبهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14527",""],[4915,"شريعةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211502",""],[4927,"لَيْلُ الْعُشَّاْق","https://www.poetsgate.com/ViewPoem.aspx?id=29950",""],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[585,"يا ليل هل فرجٌ لي حان أو فلق","https://www.poetsgate.com/ViewPoem.aspx?id=161885",""],[5239,"لئن كان حمل الفقه ذنباً فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=190939",""],[5269,"نأتك أمامة نأياً طويلاً","https://www.poetsgate.com/ViewPoem.aspx?id=81490",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"ألا بلغن يا راكباً حرفداً نضوي","https://www.poetsgate.com/ViewPoem.aspx?id=128825",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5409,"بنفسي التي ذكرت خلها","https://www.poetsgate.com/ViewPoem.aspx?id=155501",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5605,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=159677",""],[5661,"خليلي قد اتسعت محنتي","https://www.poetsgate.com/ViewPoem.aspx?id=181396",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5937,"لاهوتُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211812",""],[6070,"حياةُ المرءِ تحكمُها الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=188425",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[6149,"أناخ على قلبي الكآبة والكرب","https://www.poetsgate.com/ViewPoem.aspx?id=169622",""]],"verses":[["وَقَد فاضَ دَمعٌ ضاقَ عَنهُ مَسيلُهُ","عَلى صَحنِ خَدٍّ لَم يَسَعهُ أَسيلِ",0,"ل",1,0],["وَقَدْ فَضَلْتُهُمُ في كُلِّ مَكْرُمَةٍ","إِلّا الغِنى وَالعُلا في الفَضْلِ لا المالِ",1,"ل",1,0],["وقد فَلَيْتُ الوَرى حتى قَلَيْتُهُمُ","إلا بَقايا كِرامٍ منْ بَني خَلَفِ",2,"ف",1,0],["وقد فرّقَ البَيْنُ المُشتِّتُ بَيْنَنا","فشَطَّ مَزارٌ واسْتَقَلَّ رَفيقُ",3,"ق",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِل","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",4,"ب",1,0],["وُقَد فَعَلَت كُلَّ الأَفاعيلِ عَينُهُ","بِجِسمي فَأَمسى وَالسِقامُ مُخامِرُه",5,"ر",2,0],["وَقَد فَرَرتُم وَما صَبَرتُم","وَذاكَ شَينٌ لَكُم وَعارُ",6,"ر",1,0],["وَقَد فَقَدَتكَ طَلقَةُ فَاِستَراحَت","فَلَيتَ الخَيلَ فارِسُها يَراها",7,"ا",3,0],["وقد فاته أنّا أولو ألْمَعِيّة","بها نخطُف الأسرار من قلبه خطفا",8,"ف",2,0],["وقد فاض غَرْبُ عند برقاء جُنْدُب","لعينيك من عِرفانِ ما كنت تعرفُ",9,"ف",1,1],["وقد فتحتُ عليك الشرقَ متصلاً","بالغرب لم تخلُ من نصر وتثبيتِ",10,"ت",1,0],["وقد فَغرتْ فاهاً له غير أنها","تراقب إذناً منك غير مساعدِ",11,"د",1,0],["وقد فُزْتَ أن أصبحت عبداً مُسلِّماً","لما أوْجبتهُ في الرقاب القلائدُ",12,"د",1,0],["وقد فعلتْ بك القالاتُ قبلي","كفعلِ النار بالحطب اليبيس",13,"س",1,0],["وقد فهمتني فرجعتُ عمّا","نكرتَ عليَّ فاكففْ حدَّ باسك",14,"ك",1,0],["وقد فتحتَ لواشٍ بابَ حيلته","فاستعملِ العينَ بعد اليوم لا الأذنا",15,"ن",2,0],["وَقَد فَكَكتَ عَنِ الأَسرى وِثاقَهُمُ","وَلَيسَ يَرجونَ تَلجاءً وَلا دَخَلا",16,"ل",2,0],["وَقَد فَرَشَت أَقطارُها لَكَ سُندُساً","لَهُ مِن فُنونِ الزَهرِ وَالنَورِ أَلوانُ",17,"ن",1,0],["وقد فقدت كل العروبة سعدها","وما مصر إلا بعض تلك الفواقد",18,"د",1,0],["وقد فتشت قبلي القلوب فاجفلت","لما راعها فيما هنالك من رين",19,"ن",1,0],["وقد فرحت أعاديه شِماتاً","وفارقه أحبتهُ مَلالا",20,"ل",2,0],["وَقَد فارَقَ الناسُ الأَحِبَّةَ قَبلَنا","وَأَعيا دَواءُ المَوتِ كُلَّ طَبيبِ",21,"ب",1,0],["وَقَد فَجَعَتهُ بِاِبنِهِ وَاِبنِ صِهرِهِ","وَبِالصِهرِ حَملاتُ الأَميرِ الغَواشِمُ",22,"م",1,0],["وقد فرشت برضراض كريم","يولدّ صبغ جوهره نضارك",23,"ك",1,0],["وَقَد فُتِحَ الأُفقانِ عَن سَيفِ مُصلِتٍ","لَهُ سَطَواتٌ ما تُهَرُّ وَما تُعوى",24,"و",2,0],["وَقَد فاتَهُم شَأوي بِتَقصيرِ شَأوِهِم","فَلَم يَملِكوا سَبقي وَلَم يَملِكوا رَدّي",25,"د",2,0],["وَقَد فَرَشَت لَكَ الدُنيا مِراراً","مَراتِبَ كُلُّها نَجدٌ يَفاعُ",26,"ع",1,0],["وَقَد فَضَلَت بَكرٌ رَبيعَةَ كُلَّها","بِفِعلِ العُلى وَالمَأثُراتِ الأَوائِلِ",27,"ل",1,0],["وقَد فَوَّقنَ بالألحاظِ نَبلاً","قلوبُ العاشِقين لها رَمايا",28,"ا",3,0],["وقد فَتَقَ الإصباحُ رتقَ جفونِهِم","وقارعَ طيبَ الغُمْضِ قَرْعُ النَّواقسِ",29,"س",1,0],["وقد فَضُلَت بيضُ القِبابِ لأنني","نصبْتُ عليها بالقصائدِ مِطرَدا",30,"د",2,0],["وَقَد فَلَّلتَ خَيلَهُمُ بِبَدرٍ","وَأَتبَعتَ الهَزيمَةَ بِالرِجالِ",31,"ل",1,0],["وَقَد فَرَشَ الوَردُ الخُدودَ وَنُشَّرَت","لِمَقدَمِهِ لِلسَوسَنِ الغَضِّ أَعلامُ",32,"م",1,0],["وقد فَرَغَتْ للقَوْمِ في غَفَلاتهمْ","حتوفٌ بهم تُمسي وتُصبحُ في شُغْلِ",33,"ل",1,0],["وَقَد فَغَرَ الحَمامُ هُناكَ فاهُ","وَأَتلَعَ جيدَهُ الأَجَلُ المُتاحُ",34,"ح",1,0],["وَقَد فَلَّهُ طولُ الجِلادِ كَأَنَّما","يُضاحِكُ مِنهُ مَفرِقَ الفَرقِ أَدرَدُ",35,"د",1,0],["وَقَد فَضَّضَ النُوّارُ كُلَّ رَباوَةٍ","وَسالَ عَلَيها لِلأَصيلِ نُضارُ",36,"ر",1,0],["وَقَد فَضَّ عِقدَ القَطرِ في كُلِّ تَلعَةٍ","نَسيمٌ تَمَشّى بَينَها فَتَضَوَّعا",37,"ع",2,0],["وَقَد فاتَ ذاكَ العَهدُ إِلّا تَذَكُّراً","لَواني عَلى ظَهرِ المَطِيِّ تَوَجَّعا",38,"ع",2,0],["وَقَد فَنَيتُ بَعدَهُ","وَضاعَ ذاكَ الحَذَرُ",39,"ر",1,0],["وقدْ فُدِيَتْ مِنْ مالِهِ خيرُ أُمَّةٍ","وَلَو خُيِّروا في ذلكَ الأمرِ لَمْ يَفْدُوا",40,"د",3,0],["وَقَد فَتَحَ الهَوى بِيَدَي","كَ أَلواناً مِنَ العِبَرِ",41,"ر",1,0],["وقد فوّهتُ فيه كلَّ","مَن قالَ ومَن عابا",42,"ب",2,0],["وَقَد فَتَّشتُ عَن أَصحابِ دينٍ","لَهُم نُسكٌ وَلَيسَ لَهُم رِياءُ",43,"ي",3,0],["وَقَد فُجِعَت بِالفَرخِ أَمسِ حَمامَةٌ","فَما بالُها تُلفي بِمَوضِعِها فَرخا",44,"خ",2,0],["وقد فنيت أضراسه غير واحد","رميم إذا ما مس يدمى ويضرس",45,"س",1,0],["وقد فرح الأحزاب من صحة به","فهنَّأ حزب بالسلام له حزبا",46,"ب",2,0],["وقد فل من فرسانهن صوارم","وحطم في لباتهن إلال",47,"ل",1,0],["وقد فَغَرَتْ فاها بها كُلُّ زَهْرة","إِلى كُلِّ ضَرْعٍ للغَمَامةِ حافِلِ",48,"ل",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِلاً","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",49,"ب",1,0],["وقد فهِمَتني عينُه وفهمْتُه","وكان بحمدِ اللّهِ أسرَعَنا فهما",50,"م",2,0],["وقد فاتنا أنّ الذي نستلذُّهُ","قلوبٌ رقاقٌ ذُوِّبَتْ ومرائر",51,"ر",1,0],["وَقد فقَدَتْ أُنسَ الخِلافةِ، وَانتحى","على أهلِها خَطبٌ، من الدّهرِ، مُعضِلُ",52,"ل",1,0],["وقد فاتهم شأوي بتقصير شأوهم","ذخائر ما في الصدر من صادق الود",53,"د",1,0],["وَقَد فَتَقَت أَزاهره","فَضاعَ المِندل الثَمل",54,"ل",1,0],["وقد فنيت به عني ورحت على","طوري ولو نالني لوم وتبكيت",55,"ت",1,0],["وقَد فَتَنَتكَ الدُّورُ يَومَ عَرفتَها","لَوائِحَ آىٍ كَالوُشُوم فُتُونَا",56,"ن",2,0],["وقَد فَارَقتني وأرَقتِ دَمعِى","أَمَا تَرَيِنَّ مَدمَعِىَ المُرَاقَا",57,"ق",2,0],["وَقَد فَرَعتَ بِهَذا الدَستِ مَنزِلَةً","نَصيبُ شانيكَ مِنها الهَمُّ وَالتَعَبُ",58,"ب",1,0],["وَقَد فَخَرَت قِدماً تَميمٌ بِدارِمٍ","عَلى أَنَّها قُلٌّ وَإِن كَثُرَت سَعدُ",59,"د",1,0],["وقد فعلوا بجسمي والحوايا","فعال النار في جلّ الحصيد",60,"د",1,0],["وَقَد فضَلَ القرآنُ كلَّ مقالةٍ","كَما فضَل المَولى خلائقَهُ طرّا",61,"ر",2,0],["وَقَد فتَحوا بالسيف جلَّ بلادهِ","ودينَ الحِجازي عمّموا في عبادهِ",62,"ه",1,0],["وَقَد فارَقَ الأَحبابَ قَومٌ فَأَسبَلُوا","دُمُوعَهُمُ بَيضاً وَأَسبَلتُها حُمرا",63,"ر",2,0],["وقد فَصَل التفريق بين أحبَّةٍ","وليس لأرواح الأحبَّة فاصلُ",64,"ل",1,0],["وقد فوقت منها سهاما مصيبة","ولم ار يوما مثلها من مصيبة",65,"ه",1,0],["وقد فزت من لقياكم اليوم بالمنى","وقلت لعمري هذه ساعة العمر",66,"ر",1,0],["وقد فاتك الإيمانُ والسيفُ والندى","ولبسك مسودّ وباللومِ يُرْقَع",67,"ع",1,0],["وقد فصلت بين ثِقل الكثيب","ولين القضيب بزُنَّارها",68,"ر",3,0],["وقد فهمنا لهذا الفصل ترجمة","إن المهيمن يحي كل مقبور",69,"ر",1,0],["وَقَدْ فَهِمْنَا فَهْمَنَا بِالذِي شَرِبَتْ","أَفْكَارُنَا مِنْ عُقَارٍ حَكَتِ الضَّرَبَا",70,"ب",2,0],["وقد فقدوا أموالهم وعيالهم","وأضحوا وبراق الأماني خلب",71,"ب",1,0],["وقد فت في عضدي ما بهِ","ولكن عليه غلبت علتي",72,"ت",2,0],["وقد فاقهم بالمكرمات محمّدٌ","فلله فردٌ قد تفرّد بالرفد",73,"د",1,0],["وقد فنيت والروح عائشة التقى","ومَن غير هذا قال قد جاء بالإفك",74,"ك",1,0],["وقد فر منه لجين الصباح","وغاص بلجة فيروزج",75,"ج",1,0],["وقد فعلت كذا مِثلي وكانت","نُجومُ الليلِ تَرقُبنا شهودا",76,"د",2,0],["وَقَدْ فَسَحَ الوَصْلَ لِلْعاشِقينَ","فَصادَفَ مِنْهُمْ صُدُوراً فِساحا",77,"ح",2,0],["وقد فقدت عفيف الدين واأسفي","فليت بعد عفيف الدين لم أكن",78,"ن",1,0],["وقد فنيت وولى العمر أكثره","في غير شيء وهذا غاية الخسر",79,"ر",1,0],["وقد فرَّق الكُتْبَ اللِّطافَ مَواعِداً","وروّع بالجيشِ الكثيفِ تَوعُّدا",80,"د",2,0],["وَقَد فَنِيَت مِنّا عَلَيهِ المَدائِحُ","وَما فَنِيَت مِنّا عَلَيهِ المَنائِحُ",81,"ح",1,0],["وقد فتكت فينا مساجدُ طورِها","فأضحيت ميتاً بين شاكٍ وفاتك",82,"ك",1,0],["وَقَد فاضَت مَكارِمُهُ","كَصَوب العارض الهَطل",83,"ل",1,0],["وقد فتحو باب العداوات بينهم","على بدع كل بها قد تحكما",84,"م",2,0],["وقد فتحت أبوابها لصعوده","فما زال يرقى من سماء إلى سما",85,"م",2,0],["وقد فرشتها عبقري زهورها","فخلنا العيون الباليات في الرمل",86,"ل",1,0],["وقد فتحت صنعا بأسياف جِدِّنَا","وأهلك فيها كل باغ ومفسد",87,"د",1,0],["وقد فرقت بيني وبين أعز من","ظهرها عندي من العجم والعرب",88,"ب",1,0],["وقد فعلَ الشَّوق المبرّح في الحشا","كما تفعلُ النِّيران بالحطب الجزل",89,"ل",1,0],["وقد فارقت من بعد لمياءَ أوجهاً","يسيل لها دمع العيون على الخدِّ",90,"د",1,0],["وقد فرش الربيعُ لنا بساطاً","من الأزهار مختلف الرقوم",91,"م",1,0],["وقد فتق الزَّمان على فؤادي","هموماً فهي بارزة الفتوق",92,"ق",1,0],["وقد فاز من يأتي جنابك إن غدا","إلي مقاليد الأمور مفوّضا",93,"ض",2,0],["وقد فَتَأَتْ سُمْرُ القنا بِدِمائِهَا","وَغَالَتْ صُدُورَ الدارعين صُدُورُها",94,"ر",3,0],["وقد فاته أن الحقيقة أبلجت","تضىء بنور الزاهدين المفرزِ",95,"ز",1,0],["وقد فلّلتْ عنك حدّ العدوّ","عُرى الصبر أو عالياتُ الهممْ",96,"م",1,0],["وقد فعَلَ اللّهُ لكنني","أرى كبِدي بعدُ لم تبرُدِ",97,"د",1,0],["وقد فَطِنتْ للشوق فهي تسرّعا","تكاد تعدّ السير يومَ بغِبُّهُ",98,"ب",2,0],["وَقَد فَصَّلتُ جُملَةَ ما دَهاني","بِلا غَلَطٍ فَرَأيُكَ وَالسَلامُ",99,"م",1,0],["وقد فارق الأم الحنون ووالدا","قضى نحبه في الحرب بين الخنادق",100,"ق",1,0],["وقد فاجأتهم منقدات مواقع الن","نجوم إلى أن آبوا أوبة راحل",101,"ل",1,0],["وقد فتكت فيها لواحظ نكبة","يشيب لها الطفل الرضيع بأحزان",102,"ن",1,0],["وقدْ فُجِرَتْ يَنابيعُ التَّجَلِّي","بقَلْبي عن أَنابيبٍ زَكِيَّهْ",103,"ي",2,0],["وقد فَنيتُ في الهَوَى","إنَّ الفَنا عينُ البَقا",104,"ق",2,0],["وقَدْ فَرشْتُ بِثَراهمْ مُقْلةً","سوى جمالِ نورهمْ لم تَلمحِ",105,"ح",1,0],["وقد فزعت بآمالي إليك وفي","رحاب جودك للعافين ترحيب",106,"ب",1,0],["وقد فزنا بما نهوى","وأدركنا الثواب الجَمّْ",107,"م",1,0],["وقد فهمت منه النصارى بأنه","هو الله جل الله عن موجب الحصر",108,"ر",1,0],["وقد فَطمتْني النائباتُ وإِنَّني","علمتُ بها أَنَّ الفطامَ أَخُو الثُّكل",109,"ل",1,0],["وقد فتقت في الدين أعظم ثلمة","لمن غيبوا في الدمس بدر المنابر",110,"ر",1,0],["وقد فقت أبناء الملوك جميعهم","بجد وإقدام بكل الملاحم",111,"م",1,0],["وَقَد فُزتُ حَظّاً بِالمُعَلّى مِنَ العُلى","فَتَقَدَّحَ ناراً في يَدَيكَ صُلودُها",112,"د",3,0],["وَقد فُزتُم ذا اليَومَ بِالغايَةِ الَّتي","عَلَيها رِجالٌ قَد قَضوا دونَكُم قَهرا",113,"ر",2,0],["وَقَد فَرَّعوا مِن كُلِّ مَلكٍ عَقيلَةٌ","رِياضَتُها أَعيَت عَلى كُلِّ خاطِبٍ",114,"ب",1,0],["وقد فارقتُ من ساداتِ قَومي","ومِن سَرَواتِهم شيباً ومُردا",115,"د",2,0],["وقد فطرت بالحق في كل فطرة","تكون منها كل نفس كريمة",116,"ه",1,0],["وَقَد فازَ في الدُنيا بعز ورفعة","وَنالَ بِها الآمال وَهيَ صِعاب",117,"ب",1,0],["وَقَد فاقَ الوَرى بالحقّ فَضلاً","وَمِن ستين عاماً لا يوازى",118,"ز",2,0],["وقد فككتُ فم الأفعى فما قدرت","يوما على إصبع مني فتلسعه",119,"ع",2,0],["وقد فقت كل الناس جداً ووالداً","كما فاقهم في مهده العلم المهدي",120,"د",2,0],["وقد فرغوا إلا من العهد مرجعاً","إلى جسمك الطهر الخوالج والنبضا",121,"ض",2,0],["وقد فقد الرهط المكان الذي له","ولا يسترد الرهط ما هو فاقد",122,"د",1,0],["وَقَد فَهِمت كُلَّ ما لَهُ حَوى","وَما عَلَيهِ يا أَخا المَجدِ اِنطَوى",123,"ط",3,0],["وَقَد فَنِيت مِنهُ الجُفونُ مِنَ البكا","فَأَنّى كراه في الهَوى وَمَنامُهُ",124,"م",2,0],["وقد فزْتَ بالفتح المبينِ وبالثَّنا","وبالأمنِ والإقبال والعِزِّ والنصر",125,"ر",1,0],["وقد فاقهمْ فخرا ومجدا وهيْبةً","تصَيِّرهم مِلكا لديه وأعْبدا",126,"د",2,0],["وقد فَرَتْها الزهاليلُ الضَّراجعُ والزِّ","لُّ الفهودُ الضوارى والجلاميسُ",127,"س",1,0],["وقد فاحَ نشرُ الروضِ مِنْ كلِّ وِجهةٍ","كما فاحَ مدْحُ ابن الكرام الأطايبِ",128,"ب",1,0],["وَقَدْ فَرَّ مِنْ جَفْنِي الكَرَى فَلأجْلِ ذَا","عَلَيْهِ جُفُونِي فِي الظَّلاَمِ دَوَائِرُ",129,"ر",1,0],["وَقَد فتّشت أَهليهِ جميعاً","وَقَد قلّبتهُم بطناً وظهرا",130,"ر",2,0],["وَقد فاحَ فوها بنشرٍ حكى","شَذا المسكِ زايلت عنه الفداما",131,"م",2,0],["وقَدْ فارَقَتِ الرُّوحُ","وما فُرْقتُها سَهْلَهْ",132,"ل",2,0],["وقد فَطِنّا وأَجَبْناكَ عن","تَفْسيرِهِ فافْطَنْ لهذا الكَلامْ",133,"م",1,0],["وقد فقدت هاشم فخرها","فليس لها اليوم ان تفخرا",134,"ر",2,0],["وقَدْ فَضَحَ الظَّلْماءَ بَرْقٌ كَأَنَّهُ","فُؤادُ مَشوقٌ مولَعٌ بِخَفوقِ",135,"ق",1,0],["وقد فضَضْتُ لعَمري من كتابكُمُ","ما يشبه الوُدَّ منكم رقَةً وصفا",136,"ف",2,0],["وقد فزت بالدنيا ونلت بك المنى","وأطمع أن ألقى بك الفوز في الأخرى",137,"ر",2,0],["وقد فتحَ الريَّ فراشُهُ","وكرمانُ يَفْتَحها سائِسُهْ",138,"س",2,0],["وقد فقدوا به علما شهيرا","وكان بكل مكرمة قمينا",139,"ن",2,0],["وقد فاتهم من قربكَ الأُنسُ والمنى","وحَارَبَهُم فيك اختيارُكَ والدهر",140,"ر",1,0],["وقد فقتَ بالفَضْلِ المُلوكً نيابةً","بأن كثيراً منهم لك حاسِدُ",141,"د",1,0],["وقد فجعته بالنّجيب الذي بهِ","رأت فوتَ عيش لا يؤوول إلى ردِّ",142,"د",1,0],["وَقَدْ فَجَّرَ الفجر نَهْرَ النَّهَارِ","فَغَاصَتْ حَصَى الشُّهْبِ فِيهِ جِهَارَا",143,"ر",2,0],["وقد فرت شراذمهم","مولولة الى البحر",144,"ر",1,0],["وقد فتحت تبريز قهرا ومورة","بأيّامه وجه الزمان المطهّم",145,"م",1,0],["وقد فتحت من الخيرات ماغلقت","أبوابه بل رأينا نور تجديد",146,"د",1,0],["وقد فتح الأفق للناظرين","عن شهلة الصبح هدب الغبش",147,"ش",1,0],["وقد فَقَدْنا أناساً من أماثِلِنا","ومثلهمْ فكذاكَ القومُ قد فَقَدُوا",148,"د",3,0],["وَقَد فَضَّلَ اللَهُ الرَسولَ مُحَمَّداً","عَلى كُلِّ مَن قَد كانَ مِن قَبلُ مُرسَلا",149,"ل",2,0],["وقد فتكوا بأحرار كرام","أرادوا بعض عدل ان يكونا",150,"ن",2,0],["وقد فاتني رؤيا حماك بناظري","فصفه لعلي أن أراه بمسمعي",151,"ع",2,0],["وقد فاز من سلطاننا بعطيةٍ","لصدق بدا منه فكان لها اهلا",152,"ل",2,0],["وقد فرض الرحمن في الذكر ودّها","وللمصطفى كانت مودتها أجرا",153,"ر",2,0],["وقد فارقتُ أعظم منك رزءاً","وواريتُ الأحبة في التراب",154,"ب",1,0],["وقد فزعت إليك اليوم معتصماً","بحبل فضلك يا كهفي ومعتصمي",155,"م",2,0],["وَقَد فَخَرتُ بِانتِمائي لَكُم","أَعزِز بِعَبدٍ بِكُمُ فاخِرِ",156,"ر",1,0],["وَقَد فَسَّروا القُرآنَ مِن مُخ رُوسِهِم","تَخاليطَ كُفرانٍ تَبدَّت فَواضِحا",157,"ح",2,0],["وقد فرض الباري على الناس ودهم","فود ذوي القربى لجدهم أجر",158,"ر",1,0],["وقد فكَّ شدقيه فعضَّ حمامة","تزق بنيها بالمدام المروق",159,"ق",1,0],["وقد فرش ابن السحب أسنى مطارف","على اجرعيها وهي من سندس خضر",160,"ر",1,0],["وَقَد فاقَت الجوزا بصون حجابها","أعوّذها من كل حُسّادِ بابِها",161,"ه",2,0],["وَقَد فديت بِالقُرب مِنكُم قُلوبنا","كَما أَصبَحت يا آل بَدر لَكُم أَسرى",162,"ر",2,0],["وقد فاح نفح الطيب في نسماته","ففاق اريج الندأ وما زكا العود",163,"د",1,0],["وقد فاز من أعطى وأحسن واتقى","وصدق بالحسنى ويسر لليسر",164,"ر",1,0],["وقد فرق الحين الجميع وانما","خليلي من بعد الحبيب عويل",165,"ل",1,0],["وقد فقدت ابناء هاشم كلها","عماد علاها والعميد المحاميا",166,"ي",2,0],["وقد فوّق السهم المراش إلى الفتى","فخرّ على الغبراءِ وهو قتيل",167,"ل",1,0],["وقد فسخت عن الأعناق بيعته","فلا خطيب له يدعو إذا اختطبا",168,"ب",2,0],["وقد فني بربه واستنى","واختار ما يبقى على ما يفنى",169,"ن",2,0],["وقد فارقتُ أطفالا صغاراً","بطهطا دونَ عَوْدي واعتيادي",170,"د",2,0],["وقد فوضتُ للمولى أموري","وذا عينُ الإصابة والسداد",170,"د",1,0],["وقد فتِنَ الأَنامُ بها وغُرُّوا","كما يُغْتَرُّ بالحَدَقِ المِلاحِ",171,"ح",1,0],["وقد فُوِّقَتْ للأسَى نحْوَهُ","سِهامٌ فلمْ يُلْفَ منها مُفيقا",172,"ق",2,0],["وقد فرّق السيفُ منهمْ جُموعاً","وقد جمعَ السّيْبُ منهُم فُروقا",172,"ق",2,0],["وقد فرقت جمع الهوى طبية النوى","وغودرت فرداً شاهداً مثل غائب",173,"ب",1,0],["وقد فقت في نظمي النوابغ كلهم","وكل فصيح عاد ألكن ألثغا",174,"غ",2,0],["وقد فقت الورى شرفاً ومجداً","فما لك في الانام نرى نديد",175,"د",1,0],["وقد فرضوا بغضاً على من يقام في","مقام رسول الله ايذاء قرباه",176,"ا",2,0],["وقد فرق الأحزاب إذ جاء عمرهم","يقودهم حرى القلوب من الحقد",177,"د",1,0],["وقد فرقت شمل الظلام ببهجة","تضيء كما ضاءت به نار طارق",178,"ق",1,0],["وقَد فَخَرتُ على كُلِّ السِّلاحِ بِهِ","وَمَا لِمَن كَلَّمتهُ ضَربَتي رَاقي",179,"ي",1,0],["وقد فصلت الورى في رتبة شمخت","ورثتها صاحِ عن آبائك النجب",180,"ب",1,0],["وقد فتكتَ بشمسٍ لو تُقاسُ بها","شمسُ الظهيرة لم تنحط عن زُحَلِ",181,"ل",1,0],["وقد فرح الأموات منه بمقدمٍ","عليهم كذا ولدانهم والوصائف",182,"ف",1,0],["وقد فاز بالدينار كلُّ مذللٍ","ولوّامُه دهرٌ فتبرٌ خفيرُهُ",183,"ه",1,0],["وَقَد فعلت في عارضيّ وحسنِها","يَدُ الدَهر ما شاءت عداها وَعُذَّلي",184,"ل",2,0],["وقد فعلت آباؤهم وجدودهم","بأجدادكم ما اللوح يروي عن القلم",185,"م",1,0],["وقد فطر اللَه العظيم عباده","على أنه من فوقهم فلهم سلوا",186,"ل",3,0],["وقد فرض اللَه الجهاد على الورى","لمن كان عن نهج الشريعة يصدف",187,"ف",1,0],["وَقد فرَّ عن نارها المائقونَ","وكلٌ تكشَّف عن عابِه",188,"ب",2,0],["وقد فسَدت يا غلام تفسُد","وقد عمَدت للقتال أَعمُد",189,"د",1,0],["وقد فقأت عينه لمّا نظر","وجهي وأومأت إليه فحضر",190,"ر",1,0],["وَقد فَعَل السَقم بي وَالنّحو","ل فعل عَوارِفه بِالنَشَب",191,"ب",1,0],["وَقَد فاتنا انا نشاهد بعده","نظيرا وان الدهر اشبه بالدهر",192,"ر",1,0],["وَقَدفقتَ بالطَّعنِ كُلَّ الأَغارِق","فَدَعنا مَجالَ الكِفاحِ نُفارِق",193,"ق",1,0],["وَقَد فاتَهُ كَم قَبلُ صُنتُ حَبِيبَهُ","هِرَقلَ ابنَهُ في حُكمِ إِفرِستَ مُجهَدا",194,"د",2,0],["وقد فاز بالنصر أعداؤنا","وضجوا وعجوا ونادوا بسبق",195,"ق",1,0],["وقد فرقته الرعاة بجهلٍ","فيدهمه بفسيح المجال",195,"ل",1,0],["وقد فاتها حمقاً أن تهاب","بني الخلد إن نهضت للعقاب",195,"ب",1,0],["وَقَد فَرَّ عَنهُ المُلحِدونَ وَحَلَّقَت","بِهِ وَبِمَن آساهُ عَنقاءُ مُغرِبُ",196,"ب",1,0],["وقد فُقت الملوك الصيد فخراً","ونُفت على الألى للمجد شادوا",197,"د",3,0],["وقد فاخرت قدمي الراس إذ","إلى نحوكم أصبحت ماشيه",198,"ي",2,0],["وقد فاق داودا بتأثير وطئه","على الصخر لما أن مشى مترفقا",199,"ق",2,0],["وَقَد فَوَّقَت لِلرَميِ اِسهُم عَتبُها","فَيا لَكَ مِن عَتبٍ رَمَتهُ وَأَسهُمِ",200,"م",1,0],["وَقَد فاحَ رَيّاهُ وَلاحَ ضِياؤُهُ","كَما لاحَ في أَفُقِ الظَلامِ شِهابُهُ",201,"ب",2,0],["وقد فتكت بأهل الشرك قوم","كما الاساد تفتك بالسخال",202,"ل",1,0],["وقد فقت سحباناً وحسانَ مفصحاً","وانشدت أشعاراً بملءِ السباسبِ",203,"ب",1,0],["وقد فَصَّم الأكباد منهُ قواضبٌ","فلا مُكِّنت في الناس يوماً قواضبه",204,"ب",2,0],["وقد فُزتُ من سلمى ومن أمّ معبَدَ","ومن أم أوفى والرباب بما أرضى",205,"ض",2,0],["وقد فرَّ منصاعٌ كما فرَّ خاضبٌ","لدى سمُرات الحيِّ ناقفُ حنظل",206,"ل",1,0],["وقد فزتم بمجدٍ واعتلاءٍ","وفضلٍ فاق متن النيرانِ",207,"ن",1,0],["وقد فاز من كان لكم حسب الإمكان","فأنتم كما كان غاية فنوني",208,"ي",1,0],["وَقَد فاقَ في العِلمِ وَالفَهمِ مِنهُ","كَما تَمَّ مِلحاً وَحُسناً وَطيبا",209,"ب",2,0],["وقَدْ فَكَّكُوا عنْ كُلِّ عقلٍ عِقالَهُ","وكانَ دُعاةُ الرُّشْدِ مَسْلَكُهُمْ ضَيْقُ",210,"ق",1,0],["وَقدّ فوقَهُ قَمَرٌ منيرٌ","قَليلُ الشبهِ ممتنع الطلوعِ",211,"ع",1,0],["وَقَد فَهِمتُ الَّذي أَخفَت فَقُلتُ لَها","بوحي بِلا وَنَعَم مِن بَيّنِ الكَلِمِ",212,"م",1,0],["وقد فاتني عدد عاشر","به شاع بحث مع الترجمان",213,"ن",1,0],["وقد فتحتها همةٌ همُّها العلى","وحسن ثواب الله والفضل الندى",214,"د",2,0],["وقد فكَّت له الأبواب منه","وما قد سدَّ عنه الله بابا",215,"ب",2,0],["وقد فاض من هذى السحائب إذ همت","سحائبُ جود تستقل السحائبا",216,"ب",2,0],["وقد فاز منهم في علىً دونه العلى","همامق غدا دون النام له أهلا",217,"ل",2,0],["وقد فاح نشر البشر في كل فدفدٍ","وضاع لنا من طيب عنبره الندُّ",218,"د",1,0],["وَقَد فَنِيَت روحي لِقارِعَةِ الهَوى","وَأُفنِيتُ عَن مَحوي بِما أَنا قارِعُ",219,"ع",1,0],["وقد فاز الذي يسعى إليها","وخاب السعي من قالٍ مُعادِ",220,"د",1,0],["وقد فطنتْ للشوق فهي تسرعا","تكاد تعدّ السير يومَ تغبهُ",221,"ب",2,0],["وقد فتحتُ فمي بالحقِّ فاستمعوا","قولي فإنَّ مقالي خطَّهُ القدرُ",222,"ر",1,0],["وَقَدْ فَاْرَقْتُ عَفْرَاْ رُغْمَ أَنْفِيْ","وَبِيْ شَوْقٌº وَقَلْبِيْ مُسْتَبَاْحُ",223,"ح",1,0],["وقد فضح الحياة الموت لما","تمكن في الرقاب له القضاء",224,"ا",2,0],["وقد فتكت فما أدركت من أربٍ","وكل سيفٍ بطول الضرب ينثلم",225,"م",1,0],["وقد فنيت عن الدنيا وبهجتها","فلست أشعر إلا أنني رمق",226,"ق",1,0],["وقد فتح الأمصار ما رد جيشه","جالت خيول الله في الشرق والغرب",227,"ب",1,0],["وقد فني الناسُ في دينهم","وخل ابن عفان شراً طويلاً",228,"ل",2,0],["وَقَدْ فَاحَ غِلٌّ ومَكْرٌ وغَدْرٌ","وَكُلٌّ زَانَ الكَلامَ رَقَشْ",229,"ش",1,0],["وقد فسخت حكم الرسول محمد","وأصحابه من كل هاد ومهتد",230,"د",1,0],["وقد فجرت أنهارها بمعارف","وتحقيق إثبات ثقاة ذوي تقوى",231,"و",2,0],["وقد فل عرش الكفر وانهد ركنه","وقد جهد الأعداء أن يحكموا الرتقا",232,"ق",2,0],["وقد فتحوا باب الوسائل جهرة","وقد جهلوا الأمر الخطير المحرما",233,"م",2,0],["وقد فتحت باعها للعنا","ق بوجهٍ تهلل من بشره",234,"ر",2,0],["وقد فات الأوان وبات حِكراً","على الأوهام تجتاح العظاما",235,"م",2,0],["وقد فتح بالسيف عنوة","جميع بلاد المسلمين ومهدا",236,"د",2,0],["[ وَقَدْ فَرَّقَتْ بَيْنِي وَبَيْنَ أَحِبَّتِي","بِشِرْعَةِ جَوْرٍ بِئْسَ ما هِيَ تَشْرَعُ ]",237,"ع",1,0],["وقد فلقت بحور العلم فانكشفت","لك اللآلئُ والأصداف في الظُلَم",238,"م",1,0],["وقد فات الذي أرجوه ذكرى","كما ضاع السبيل ولا يرد",239,"د",1,0],["وقد فت في عضدي ما به","ولكن به غلبت علتي",240,"ت",2,0],["وقد فتحت باب الخلافة بعده","بكم ظهرت اسرارها بالوصية",241,"ه",1,0],["وقد فاض منك الحسن ، حتى كأنه","على كل أرض إثر ممشاكِ منكوتُ",242,"ت",1,0],["وقدْ فازَ الذي يسعى لخيرٍ","بطيبِ القولِ أوفعلِ الحسانِ",243,"ن",1,0],["وقد فاز بالمجد الأثيل وراثة","وزاد فمجداه تليد وطارف",244,"ف",1,0],["وقد فقدت عيني الرقاد بفقدهم","فلم يلق مذ لم ألقهم هدبا هدب",245,"ب",1,0]]}