5892.html","المتقارب"],[461,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[461,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[471,"أيا من نون حاجبه سقام","https://www.aldiwan.net/poem59664.html","الوافر"],[482,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[485,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[485,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[503,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[503,"برق حبيبي برقا","https://www.aldiwan.net/poem37943.html","مجزوء الرجز"],[503,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[518,"يا كاشف الضر إذا ناداه أيوب","https://www.aldiwan.net/poem12035.html","البسيط"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[578,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[590,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[590,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[512,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"]],"verses":[["وَقَد فاضَ دَمعٌ ضاقَ عَنهُ مَسيلُهُ","عَلى صَحنِ خَدٍّ لَم يَسَعهُ أَسيلِ",0,"ل",1,0],["وَقَدْ فَضَلْتُهُمُ في كُلِّ مَكْرُمَةٍ","إِلّا الغِنى وَالعُلا في الفَضْلِ لا المالِ",1,"ل",1,0],["وقد فَلَيْتُ الوَرى حتى قَلَيْتُهُمُ","إلا بَقايا كِرامٍ منْ بَني خَلَفِ",2,"ف",1,0],["وقد فرّقَ البَيْنُ المُشتِّتُ بَيْنَنا","فشَطَّ مَزارٌ واسْتَقَلَّ رَفيقُ",3,"ق",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِل","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",4,"ب",1,0],["وُقَد فَعَلَت كُلَّ الأَفاعيلِ عَينُهُ","بِجِسمي فَأَمسى وَالسِقامُ مُخامِرُه",5,"ر",2,0],["وَقَد فَرَرتُم وَما صَبَرتُم","وَذاكَ شَينٌ لَكُم وَعارُ",6,"ر",1,0],["وَقَد فَقَدَتكَ طَلقَةُ فَاِستَراحَت","فَلَيتَ الخَيلَ فارِسُها يَراها",7,"ا",3,0],["وقد فاته أنّا أولو ألْمَعِيّة","بها نخطُف الأسرار من قلبه خطفا",8,"ف",2,0],["وقد فاض غَرْبُ عند برقاء جُنْدُب","لعينيك من عِرفانِ ما كنت تعرفُ",9,"ف",1,1],["وقد فتحتُ عليك الشرقَ متصلاً","بالغرب لم تخلُ من نصر وتثبيتِ",10,"ت",1,0],["وقد فَغرتْ فاهاً له غير أنها","تراقب إذناً منك غير مساعدِ",11,"د",1,0],["وقد فُزْتَ أن أصبحت عبداً مُسلِّماً","لما أوْجبتهُ في الرقاب القلائدُ",12,"د",1,0],["وقد فعلتْ بك القالاتُ قبلي","كفعلِ النار بالحطب اليبيس",13,"س",1,0],["وقد فهمتني فرجعتُ عمّا","نكرتَ عليَّ فاكففْ حدَّ باسك",14,"ك",1,0],["وقد فتحتَ لواشٍ بابَ حيلته","فاستعملِ العينَ بعد اليوم لا الأذنا",15,"ن",2,0],["وَقَد فَكَكتَ عَنِ الأَسرى وِثاقَهُمُ","وَلَيسَ يَرجونَ تَلجاءً وَلا دَخَلا",16,"ل",2,0],["وَقَد فَرَشَت أَقطارُها لَكَ سُندُساً","لَهُ مِن فُنونِ الزَهرِ وَالنَورِ أَلوانُ",17,"ن",1,0],["وقد فقدت كل العروبة سعدها","وما مصر إلا بعض تلك الفواقد",18,"د",1,0],["وقد فتشت قبلي القلوب فاجفلت","لما راعها فيما هنالك من رين",19,"ن",1,0],["وقد فرحت أعاديه شِماتاً","وفارقه أحبتهُ مَلالا",20,"ل",2,0],["وَقَد فارَقَ الناسُ الأَحِبَّةَ قَبلَنا","وَأَعيا دَواءُ المَوتِ كُلَّ طَبيبِ",21,"ب",1,0],["وَقَد فَجَعَتهُ بِاِبنِهِ وَاِبنِ صِهرِهِ","وَبِالصِهرِ حَملاتُ الأَميرِ الغَواشِمُ",22,"م",1,0],["وقد فرشت برضراض كريم","يولدّ صبغ جوهره نضارك",23,"ك",1,0],["وَقَد فُتِحَ الأُفقانِ عَن سَيفِ مُصلِتٍ","لَهُ سَطَواتٌ ما تُهَرُّ وَما تُعوى",24,"و",2,0],["وَقَد فاتَهُم شَأوي بِتَقصيرِ شَأوِهِم","فَلَم يَملِكوا سَبقي وَلَم يَملِكوا رَدّي",25,"د",2,0],["وَقَد فَرَشَت لَكَ الدُنيا مِراراً","مَراتِبَ كُلُّها نَجدٌ يَفاعُ",26,"ع",1,0],["وَقَد فَضَلَت بَكرٌ رَبيعَةَ كُلَّها","بِفِعلِ العُلى وَالمَأثُراتِ الأَوائِلِ",27,"ل",1,0],["وقَد فَوَّقنَ بالألحاظِ نَبلاً","قلوبُ العاشِقين لها رَمايا",28,"ا",3,0],["وقد فَتَقَ الإصباحُ رتقَ جفونِهِم","وقارعَ طيبَ الغُمْضِ قَرْعُ النَّواقسِ",29,"س",1,0],["وقد فَضُلَت بيضُ القِبابِ لأنني","نصبْتُ عليها بالقصائدِ مِطرَدا",30,"د",2,0],["وَقَد فَلَّلتَ خَيلَهُمُ بِبَدرٍ","وَأَتبَعتَ الهَزيمَةَ بِالرِجالِ",31,"ل",1,0],["وَقَد فَرَشَ الوَردُ الخُدودَ وَنُشَّرَت","لِمَقدَمِهِ لِلسَوسَنِ الغَضِّ أَعلامُ",32,"م",1,0],["وقد فَرَغَتْ للقَوْمِ في غَفَلاتهمْ","حتوفٌ بهم تُمسي وتُصبحُ في شُغْلِ",33,"ل",1,0],["وَقَد فَغَرَ الحَمامُ هُناكَ فاهُ","وَأَتلَعَ جيدَهُ الأَجَلُ المُتاحُ",34,"ح",1,0],["وَقَد فَلَّهُ طولُ الجِلادِ كَأَنَّما","يُضاحِكُ مِنهُ مَفرِقَ الفَرقِ أَدرَدُ",35,"د",1,0],["وَقَد فَضَّضَ النُوّارُ كُلَّ رَباوَةٍ","وَسالَ عَلَيها لِلأَصيلِ نُضارُ",36,"ر",1,0],["وَقَد فَضَّ عِقدَ القَطرِ في كُلِّ تَلعَةٍ","نَسيمٌ تَمَشّى بَينَها فَتَضَوَّعا",37,"ع",2,0],["وَقَد فاتَ ذاكَ العَهدُ إِلّا تَذَكُّراً","لَواني عَلى ظَهرِ المَطِيِّ تَوَجَّعا",38,"ع",2,0],["وَقَد فَنَيتُ بَعدَهُ","وَضاعَ ذاكَ الحَذَرُ",39,"ر",1,0],["وقدْ فُدِيَتْ مِنْ مالِهِ خيرُ أُمَّةٍ","وَلَو خُيِّروا في ذلكَ الأمرِ لَمْ يَفْدُوا",40,"د",3,0],["وَقَد فَتَحَ الهَوى بِيَدَي","كَ أَلواناً مِنَ العِبَرِ",41,"ر",1,0],["وقد فوّهتُ فيه كلَّ","مَن قالَ ومَن عابا",42,"ب",2,0],["وَقَد فَتَّشتُ عَن أَصحابِ دينٍ","لَهُم نُسكٌ وَلَيسَ لَهُم رِياءُ",43,"ي",3,0],["وَقَد فُجِعَت بِالفَرخِ أَمسِ حَمامَةٌ","فَما بالُها تُلفي بِمَوضِعِها فَرخا",44,"خ",2,0],["وقد فنيت أضراسه غير واحد","رميم إذا ما مس يدمى ويضرس",45,"س",1,0],["وقد فرح الأحزاب من صحة به","فهنَّأ حزب بالسلام له حزبا",46,"ب",2,0],["وقد فل من فرسانهن صوارم","وحطم في لباتهن إلال",47,"ل",1,0],["وقد فَغَرَتْ فاها بها كُلُّ زَهْرة","إِلى كُلِّ ضَرْعٍ للغَمَامةِ حافِلِ",48,"ل",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِلاً","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",49,"ب",1,0],["وقد فهِمَتني عينُه وفهمْتُه","وكان بحمدِ اللّهِ أسرَعَنا فهما",50,"م",2,0],["وقد فاتنا أنّ الذي نستلذُّهُ","قلوبٌ رقاقٌ ذُوِّبَتْ ومرائر",51,"ر",1,0],["وَقد فقَدَتْ أُنسَ الخِلافةِ، وَانتحى","على أهلِها خَطبٌ، من الدّهرِ، مُعضِلُ",52,"ل",1,0],["وقد فاتهم شأوي بتقصير شأوهم","ذخائر ما في الصدر من صادق الود",53,"د",1,0],["وَقَد فَتَقَت أَزاهره","فَضاعَ المِندل الثَمل",54,"ل",1,0],["وقد فنيت به عني ورحت على","طوري ولو نالني لوم وتبكيت",55,"ت",1,0],["وقَد فَتَنَتكَ الدُّورُ يَومَ عَرفتَها","لَوائِحَ آىٍ كَالوُشُوم فُتُونَا",56,"ن",2,0],["وقَد فَارَقتني وأرَقتِ دَمعِى","أَمَا تَرَيِنَّ مَدمَعِىَ المُرَاقَا",57,"ق",2,0],["وَقَد فَرَعتَ بِهَذا الدَستِ مَنزِلَةً","نَصيبُ شانيكَ مِنها الهَمُّ وَالتَعَبُ",58,"ب",1,0],["وَقَد فَخَرَت قِدماً تَميمٌ بِدارِمٍ","عَلى أَنَّها قُلٌّ وَإِن كَثُرَت سَعدُ",59,"د",1,0],["وقد فعلوا بجسمي والحوايا","فعال النار في جلّ الحصيد",60,"د",1,0],["وَقَد فضَلَ القرآنُ كلَّ مقالةٍ","كَما فضَل المَولى خلائقَهُ طرّا",61,"ر",2,0],["وَقَد فتَحوا بالسيف جلَّ بلادهِ","ودينَ الحِجازي عمّموا في عبادهِ",62,"ه",1,0],["وَقَد فارَقَ الأَحبابَ قَومٌ فَأَسبَلُوا","دُمُوعَهُمُ بَيضاً وَأَسبَلتُها حُمرا",63,"ر",2,0],["وقد فَصَل التفريق بين أحبَّةٍ","وليس لأرواح الأحبَّة فاصلُ",64,"ل",1,0],["وقد فوقت منها سهاما مصيبة","ولم ار يوما مثلها من مصيبة",65,"ه",1,0],["وقد فزت من لقياكم اليوم بالمنى","وقلت لعمري هذه ساعة العمر",66,"ر",1,0],["وقد فاتك الإيمانُ والسيفُ والندى","ولبسك مسودّ وباللومِ يُرْقَع",67,"ع",1,0],["وقد فصلت بين ثِقل الكثيب","ولين القضيب بزُنَّارها",68,"ر",3,0],["وقد فهمنا لهذا الفصل ترجمة","إن المهيمن يحي كل مقبور",69,"ر",1,0],["وَقَدْ فَهِمْنَا فَهْمَنَا بِالذِي شَرِبَتْ","أَفْكَارُنَا مِنْ عُقَارٍ حَكَتِ الضَّرَبَا",70,"ب",2,0],["وقد فقدوا أموالهم وعيالهم","وأضحوا وبراق الأماني خلب",71,"ب",1,0],["وقد فت في عضدي ما بهِ","ولكن عليه غلبت علتي",72,"ت",2,0],["وقد فاقهم بالمكرمات محمّدٌ","فلله فردٌ قد تفرّد بالرفد",73,"د",1,0],["وقد فنيت والروح عائشة التقى","ومَن غير هذا قال قد جاء بالإفك",74,"ك",1,0],["وقد فر منه لجين الصباح","وغاص بلجة فيروزج",75,"ج",1,0],["وقد فعلت كذا مِثلي وكانت","نُجومُ الليلِ تَرقُبنا شهودا",76,"د",2,0],["وَقَدْ فَسَحَ الوَصْلَ لِلْعاشِقينَ","فَصادَفَ مِنْهُمْ صُدُوراً فِساحا",77,"ح",2,0],["وقد فقدت عفيف الدين واأسفي","فليت بعد عفيف الدين لم أكن",78,"ن",1,0],["وقد فنيت وولى العمر أكثره","في غير شيء وهذا غاية الخسر",79,"ر",1,0],["وقد فرَّق الكُتْبَ اللِّطافَ مَواعِداً","وروّع بالجيشِ الكثيفِ تَوعُّدا",80,"د",2,0],["وَقَد فَنِيَت مِنّا عَلَيهِ المَدائِحُ","وَما فَنِيَت مِنّا عَلَيهِ المَنائِحُ",81,"ح",1,0],["وقد فتكت فينا مساجدُ طورِها","فأضحيت ميتاً بين شاكٍ وفاتك",82,"ك",1,0],["وَقَد فاضَت مَكارِمُهُ","كَصَوب العارض الهَطل",83,"ل",1,0],["وقد فتحو باب العداوات بينهم","على بدع كل بها قد تحكما",84,"م",2,0],["وقد فتحت أبوابها لصعوده","فما زال يرقى من سماء إلى سما",85,"م",2,0],["وقد فرشتها عبقري زهورها","فخلنا العيون الباليات في الرمل",86,"ل",1,0],["وقد فتحت صنعا بأسياف جِدِّنَا","وأهلك فيها كل باغ ومفسد",87,"د",1,0],["وقد فرقت بيني وبين أعز من","ظهرها عندي من العجم والعرب",88,"ب",1,0],["وقد فعلَ الشَّوق المبرّح في الحشا","كما تفعلُ النِّيران بالحطب الجزل",89,"ل",1,0],["وقد فارقت من بعد لمياءَ أوجهاً","يسيل لها دمع العيون على الخدِّ",90,"د",1,0],["وقد فرش الربيعُ لنا بساطاً","من الأزهار مختلف الرقوم",91,"م",1,0],["وقد فتق الزَّمان على فؤادي","هموماً فهي بارزة الفتوق",92,"ق",1,0],["وقد فاز من يأتي جنابك إن غدا","إلي مقاليد الأمور مفوّضا",93,"ض",2,0],["وقد فَتَأَتْ سُمْرُ القنا بِدِمائِهَا","وَغَالَتْ صُدُورَ الدارعين صُدُورُها",94,"ر",3,0],["وقد فاته أن الحقيقة أبلجت","تضىء بنور الزاهدين المفرزِ",95,"ز",1,0],["وقد فلّلتْ عنك حدّ العدوّ","عُرى الصبر أو عالياتُ الهممْ",96,"م",1,0],["وقد فعَلَ اللّهُ لكنني","أرى كبِدي بعدُ لم تبرُدِ",97,"د",1,0],["وقد فَطِنتْ للشوق فهي تسرّعا","تكاد تعدّ السير يومَ بغِبُّهُ",98,"ب",2,0],["وَقَد فَصَّلتُ جُملَةَ ما دَهاني","بِلا غَلَطٍ فَرَأيُكَ وَالسَلامُ",99,"م",1,0],["وقد فارق الأم الحنون ووالدا","قضى نحبه في الحرب بين الخنادق",100,"ق",1,0],["وقد فاجأتهم منقدات مواقع الن","نجوم إلى أن آبوا أوبة راحل",101,"ل",1,0],["وقد فتكت فيها لواحظ نكبة","يشيب لها الطفل الرضيع بأحزان",102,"ن",1,0],["وقدْ فُجِرَتْ يَنابيعُ التَّجَلِّي","بقَلْبي عن أَنابيبٍ زَكِيَّهْ",103,"ي",2,0],["وقد فَنيتُ في الهَوَى","إنَّ الفَنا عينُ البَقا",104,"ق",2,0],["وقَدْ فَرشْتُ بِثَراهمْ مُقْلةً","سوى جمالِ نورهمْ لم تَلمحِ",105,"ح",1,0],["وقد فزعت بآمالي إليك وفي","رحاب جودك للعافين ترحيب",106,"ب",1,0],["وقد فزنا بما نهوى","وأدركنا الثواب الجَمّْ",107,"م",1,0],["وقد فهمت منه النصارى بأنه","هو الله جل الله عن موجب الحصر",108,"ر",1,0],["وقد فَطمتْني النائباتُ وإِنَّني","علمتُ بها أَنَّ الفطامَ أَخُو الثُّكل",109,"ل",1,0],["وقد فتقت في الدين أعظم ثلمة","لمن غيبوا في الدمس بدر المنابر",110,"ر",1,0],["وقد فقت أبناء الملوك جميعهم","بجد وإقدام بكل الملاحم",111,"م",1,0],["وقد فَقَدْنا أناساً من أماثِلِنا","ومثلهمْ فكذاكَ القومُ قد فَقَدُوا",112,"د",3,0]]}