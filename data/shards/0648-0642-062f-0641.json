ml","الطويل"],[257,"سلام حكى نظم الجواهر في السلك","https://www.aldiwan.net/poem35792.html","الطويل"],[259,"قفي ربة الوقف والدملج","https://www.aldiwan.net/poem38353.html","المتقارب"],[268,"إلام تعالج الأسد القيودا","https://www.aldiwan.net/poem35176.html","الوافر"],[278,"نشدتك لا تعدم الراح راحا","https://www.aldiwan.net/poem60715.html","المتقارب"],[287,"يا بين بالغت في الأشجان والمحن","https://www.aldiwan.net/poem2170.html","البسيط"],[302,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[362,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[364,"وأرضيت فيك الحب والحب جائر","https://www.aldiwan.net/poem17170.html","الطويل"],[374,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[377,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[400,"فقد غش في الأديان من كان عالما","https://www.aldiwan.net/poem33445.html","الطويل"],[400,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[400,"سلام على الدار التي جمعت شملي","https://www.aldiwan.net/poem33607.html","الطويل"],[400,"بذكرك يا رب الخلائق أبتدي","https://www.aldiwan.net/poem33942.html","الطويل"],[400,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[413,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[413,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[413,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[413,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[434,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[436,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[449,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[456,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[456,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[456,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[466,"أيا من نون حاجبه سقام","https://www.aldiwan.net/poem59664.html","الوافر"],[477,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[480,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[498,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[498,"برق حبيبي برقا","https://www.aldiwan.net/poem37943.html","مجزوء الرجز"],[498,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[513,"يا كاشف الضر إذا ناداه أيوب","https://www.aldiwan.net/poem12035.html","البسيط"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[585,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَقَد فاضَ دَمعٌ ضاقَ عَنهُ مَسيلُهُ","عَلى صَحنِ خَدٍّ لَم يَسَعهُ أَسيلِ",0,"ل",1,0],["وَقَدْ فَضَلْتُهُمُ في كُلِّ مَكْرُمَةٍ","إِلّا الغِنى وَالعُلا في الفَضْلِ لا المالِ",1,"ل",1,0],["وقد فَلَيْتُ الوَرى حتى قَلَيْتُهُمُ","إلا بَقايا كِرامٍ منْ بَني خَلَفِ",2,"ف",1,0],["وقد فرّقَ البَيْنُ المُشتِّتُ بَيْنَنا","فشَطَّ مَزارٌ واسْتَقَلَّ رَفيقُ",3,"ق",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِل","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",4,"ب",1,0],["وُقَد فَعَلَت كُلَّ الأَفاعيلِ عَينُهُ","بِجِسمي فَأَمسى وَالسِقامُ مُخامِرُه",5,"ر",2,0],["وَقَد فَرَرتُم وَما صَبَرتُم","وَذاكَ شَينٌ لَكُم وَعارُ",6,"ر",1,0],["وَقَد فَقَدَتكَ طَلقَةُ فَاِستَراحَت","فَلَيتَ الخَيلَ فارِسُها يَراها",7,"ا",3,0],["وقد فاته أنّا أولو ألْمَعِيّة","بها نخطُف الأسرار من قلبه خطفا",8,"ف",2,0],["وقد فاض غَرْبُ عند برقاء جُنْدُب","لعينيك من عِرفانِ ما كنت تعرفُ",9,"ف",1,1],["وقد فتحتُ عليك الشرقَ متصلاً","بالغرب لم تخلُ من نصر وتثبيتِ",10,"ت",1,0],["وقد فَغرتْ فاهاً له غير أنها","تراقب إذناً منك غير مساعدِ",11,"د",1,0],["وقد فُزْتَ أن أصبحت عبداً مُسلِّماً","لما أوْجبتهُ في الرقاب القلائدُ",12,"د",1,0],["وقد فعلتْ بك القالاتُ قبلي","كفعلِ النار بالحطب اليبيس",13,"س",1,0],["وقد فهمتني فرجعتُ عمّا","نكرتَ عليَّ فاكففْ حدَّ باسك",14,"ك",1,0],["وقد فتحتَ لواشٍ بابَ حيلته","فاستعملِ العينَ بعد اليوم لا الأذنا",15,"ن",2,0],["وَقَد فَكَكتَ عَنِ الأَسرى وِثاقَهُمُ","وَلَيسَ يَرجونَ تَلجاءً وَلا دَخَلا",16,"ل",2,0],["وَقَد فَرَشَت أَقطارُها لَكَ سُندُساً","لَهُ مِن فُنونِ الزَهرِ وَالنَورِ أَلوانُ",17,"ن",1,0],["وقد فقدت كل العروبة سعدها","وما مصر إلا بعض تلك الفواقد",18,"د",1,0],["وقد فتشت قبلي القلوب فاجفلت","لما راعها فيما هنالك من رين",19,"ن",1,0],["وقد فرحت أعاديه شِماتاً","وفارقه أحبتهُ مَلالا",20,"ل",2,0],["وَقَد فارَقَ الناسُ الأَحِبَّةَ قَبلَنا","وَأَعيا دَواءُ المَوتِ كُلَّ طَبيبِ",21,"ب",1,0],["وَقَد فَجَعَتهُ بِاِبنِهِ وَاِبنِ صِهرِهِ","وَبِالصِهرِ حَملاتُ الأَميرِ الغَواشِمُ",22,"م",1,0],["وقد فرشت برضراض كريم","يولدّ صبغ جوهره نضارك",23,"ك",1,0],["وَقَد فُتِحَ الأُفقانِ عَن سَيفِ مُصلِتٍ","لَهُ سَطَواتٌ ما تُهَرُّ وَما تُعوى",24,"و",2,0],["وَقَد فاتَهُم شَأوي بِتَقصيرِ شَأوِهِم","فَلَم يَملِكوا سَبقي وَلَم يَملِكوا رَدّي",25,"ي",1,0],["وَقَد فَرَشَت لَكَ الدُنيا مِراراً","مَراتِبَ كُلُّها نَجدٌ يَفاعُ",26,"ع",1,0],["وَقَد فَضَلَت بَكرٌ رَبيعَةَ كُلَّها","بِفِعلِ العُلى وَالمَأثُراتِ الأَوائِلِ",27,"ل",1,0],["وقَد فَوَّقنَ بالألحاظِ نَبلاً","قلوبُ العاشِقين لها رَمايا",28,"ا",3,0],["وقد فَتَقَ الإصباحُ رتقَ جفونِهِم","وقارعَ طيبَ الغُمْضِ قَرْعُ النَّواقسِ",29,"س",1,0],["وقد فَضُلَت بيضُ القِبابِ لأنني","نصبْتُ عليها بالقصائدِ مِطرَدا",30,"د",2,0],["وَقَد فَلَّلتَ خَيلَهُمُ بِبَدرٍ","وَأَتبَعتَ الهَزيمَةَ بِالرِجالِ",31,"ل",1,0],["وَقَد فَرَشَ الوَردُ الخُدودَ وَنُشَّرَت","لِمَقدَمِهِ لِلسَوسَنِ الغَضِّ أَعلامُ",32,"م",1,0],["وقد فَرَغَتْ للقَوْمِ في غَفَلاتهمْ","حتوفٌ بهم تُمسي وتُصبحُ في شُغْلِ",33,"ل",1,0],["وَقَد فَغَرَ الحَمامُ هُناكَ فاهُ","وَأَتلَعَ جيدَهُ الأَجَلُ المُتاحُ",34,"ح",1,0],["وَقَد فَلَّهُ طولُ الجِلادِ كَأَنَّما","يُضاحِكُ مِنهُ مَفرِقَ الفَرقِ أَدرَدُ",35,"د",1,0],["وَقَد فَضَّضَ النُوّارُ كُلَّ رَباوَةٍ","وَسالَ عَلَيها لِلأَصيلِ نُضارُ",36,"ر",1,0],["وَقَد فَضَّ عِقدَ القَطرِ في كُلِّ تَلعَةٍ","نَسيمٌ تَمَشّى بَينَها فَتَضَوَّعا",37,"ع",2,0],["وَقَد فاتَ ذاكَ العَهدُ إِلّا تَذَكُّراً","لَواني عَلى ظَهرِ المَطِيِّ تَوَجَّعا",38,"ع",2,0],["وَقَد فَنَيتُ بَعدَهُ","وَضاعَ ذاكَ الحَذَرُ",39,"ر",1,0],["وقدْ فُدِيَتْ مِنْ مالِهِ خيرُ أُمَّةٍ","وَلَو خُيِّروا في ذلكَ الأمرِ لَمْ يَفْدُوا",40,"د",3,0],["وَقَد فَتَحَ الهَوى بِيَدَي","كَ أَلواناً مِنَ العِبَرِ",41,"ر",1,0],["وقد فوّهتُ فيه كلَّ","مَن قالَ ومَن عابا",42,"ب",2,0],["وَقَد فَتَّشتُ عَن أَصحابِ دينٍ","لَهُم نُسكٌ وَلَيسَ لَهُم رِياءُ",43,"ي",3,0],["وَقَد فُجِعَت بِالفَرخِ أَمسِ حَمامَةٌ","فَما بالُها تُلفي بِمَوضِعِها فَرخا",44,"خ",2,0],["وقد فرح الأحزاب من صحة به","فهنَّأ حزب بالسلام له حزبا",45,"ب",2,0],["وقد فل من فرسانهن صوارم","وحطم في لباتهن إلال",46,"ل",1,0],["وقد فَغَرَتْ فاها بها كُلُّ زَهْرة","إِلى كُلِّ ضَرْعٍ للغَمَامةِ حافِلِ",47,"ل",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِلاً","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",48,"ب",1,0],["وقد فهِمَتني عينُه وفهمْتُه","وكان بحمدِ اللّهِ أسرَعَنا فهما",49,"م",2,0],["وقد فاتنا أنّ الذي نستلذُّهُ","قلوبٌ رقاقٌ ذُوِّبَتْ ومرائر",50,"ر",1,0],["وَقد فقَدَتْ أُنسَ الخِلافةِ، وَانتحى","على أهلِها خَطبٌ، من الدّهرِ، مُعضِلُ",51,"ل",1,0],["وقد فاتهم شأوي بتقصير شأوهم","ذخائر ما في الصدر من صادق الود",52,"د",1,0],["وَقَد فَتَقَت أَزاهره","فَضاعَ المِندل الثَمل",53,"ل",1,0],["وقد فنيت به عني ورحت على","طوري ولو نالني لوم وتبكيت",54,"ت",1,0],["وقَد فَتَنَتكَ الدُّورُ يَومَ عَرفتَها","لَوائِحَ آىٍ كَالوُشُوم فُتُونَا",55,"ن",2,0],["وقَد فَارَقتني وأرَقتِ دَمعِى","أَمَا تَرَيِنَّ مَدمَعِىَ المُرَاقَا",56,"ق",2,0],["وَقَد فَرَعتَ بِهَذا الدَستِ مَنزِلَةً","نَصيبُ شانيكَ مِنها الهَمُّ وَالتَعَبُ",57,"ب",1,0],["وَقَد فَخَرَت قِدماً تَميمٌ بِدارِمٍ","عَلى أَنَّها قُلٌّ وَإِن كَثُرَت سَعدُ",58,"د",1,0],["وقد فعلوا بجسمي والحوايا","فعال النار في جلّ الحصيد",59,"د",1,0],["وَقَد فضَلَ القرآنُ كلَّ مقالةٍ","كَما فضَل المَولى خلائقَهُ طرّا",60,"ر",2,0],["وَقَد فتَحوا بالسيف جلَّ بلادهِ","ودينَ الحِجازي عمّموا في عبادهِ",61,"ه",1,0],["وَقَد فارَقَ الأَحبابَ قَومٌ فَأَسبَلُوا","دُمُوعَهُمُ بَيضاً وَأَسبَلتُها حُمرا",62,"ر",2,0],["وقد فَصَل التفريق بين أحبَّةٍ","وليس لأرواح الأحبَّة فاصلُ",63,"ل",1,0],["وقد فوقت منها سهاما مصيبة","ولم ار يوما مثلها من مصيبة",64,"ه",1,0],["وقد فزت من لقياكم اليوم بالمنى","وقلت لعمري هذه ساعة العمر",65,"ر",1,0],["وقد فاتك الإيمانُ والسيفُ والندى","ولبسك مسودّ وباللومِ يُرْقَع",66,"ع",1,0],["وقد فصلت بين ثِقل الكثيب","ولين القضيب بزُنَّارها",67,"ر",3,0],["وقد فهمنا لهذا الفصل ترجمة","إن المهيمن يحي كل مقبور",68,"ر",1,0],["وَقَدْ فَهِمْنَا فَهْمَنَا بِالذِي شَرِبَتْ","أَفْكَارُنَا مِنْ عُقَارٍ حَكَتِ الضَّرَبَا",69,"ب",2,0],["وقد فقدوا أموالهم وعيالهم","وأضحوا وبراق الأماني خلب",70,"ب",1,0],["وقد فت في عضدي ما بهِ","ولكن عليه غلبت علتي",71,"ت",2,0],["وقد فاقهم بالمكرمات محمّدٌ","فلله فردٌ قد تفرّد بالرفد",72,"د",1,0],["وقد فنيت والروح عائشة التقى","ومَن غير هذا قال قد جاء بالإفك",73,"ك",1,0],["وقد فر منه لجين الصباح","وغاص بلجة فيروزج",74,"ج",1,0],["وقد فعلت كذا مِثلي وكانت","نُجومُ الليلِ تَرقُبنا شهودا",75,"د",2,0],["وَقَدْ فَسَحَ الوَصْلَ لِلْعاشِقينَ","فَصادَفَ مِنْهُمْ صُدُوراً فِساحا",76,"ح",2,0],["وقد فقدت عفيف الدين واأسفي","فليت بعد عفيف الدين لم أكن",77,"ن",1,0],["وقد فنيت وولى العمر أكثره","في غير شيء وهذا غاية الخسر",78,"ر",1,0],["وقد فرَّق الكُتْبَ اللِّطافَ مَواعِداً","وروّع بالجيشِ الكثيفِ تَوعُّدا",79,"د",2,0],["وَقَد فَنِيَت مِنّا عَلَيهِ المَدائِحُ","وَما فَنِيَت مِنّا عَلَيهِ المَنائِحُ",80,"ح",1,0],["وقد فتكت فينا مساجدُ طورِها","فأضحيت ميتاً بين شاكٍ وفاتك",81,"ك",1,0],["وَقَد فاضَت مَكارِمُهُ","كَصَوب العارض الهَطل",82,"ل",1,0],["وقد فتحو باب العداوات بينهم","على بدع كل بها قد تحكما",83,"م",2,0],["وقد فتحت أبوابها لصعوده","فما زال يرقى من سماء إلى سما",84,"م",2,0],["وقد فرشتها عبقري زهورها","فخلنا العيون الباليات في الرمل",85,"ل",1,0],["وقد فتحت صنعا بأسياف جِدِّنَا","وأهلك فيها كل باغ ومفسد",86,"د",1,0],["وقد فرقت بيني وبين أعز من","ظهرها عندي من العجم والعرب",87,"ب",1,0],["وقد فعلَ الشَّوق المبرّح في الحشا","كما تفعلُ النِّيران بالحطب الجزل",88,"ل",1,0],["وقد فارقت من بعد لمياءَ أوجهاً","يسيل لها دمع العيون على الخدِّ",89,"د",1,0],["وقد فرش الربيعُ لنا بساطاً","من الأزهار مختلف الرقوم",90,"م",1,0],["وقد فتق الزَّمان على فؤادي","هموماً فهي بارزة الفتوق",91,"ق",1,0],["وقد فاز من يأتي جنابك إن غدا","إلي مقاليد الأمور مفوّضا",92,"ض",2,0],["وقد فَتَأَتْ سُمْرُ القنا بِدِمائِهَا","وَغَالَتْ صُدُورَ الدارعين صُدُورُها",93,"ر",3,0],["وقد فاته أن الحقيقة أبلجت","تضىء بنور الزاهدين المفرزِ",94,"ز",1,0],["وقد فلّلتْ عنك حدّ العدوّ","عُرى الصبر أو عالياتُ الهممْ",95,"م",1,0],["وقد فعَلَ اللّهُ لكنني","أرى كبِدي بعدُ لم تبرُدِ",96,"د",1,0],["وقد فَطِنتْ للشوق فهي تسرّعا","تكاد تعدّ السير يومَ بغِبُّهُ",97,"ب",2,0],["وَقَد فَصَّلتُ جُملَةَ ما دَهاني","بِلا غَلَطٍ فَرَأيُكَ وَالسَلامُ",98,"م",1,0],["وقد فارق الأم الحنون ووالدا","قضى نحبه في الحرب بين الخنادق",99,"ق",1,0],["وقد فاجأتهم منقدات مواقع الن","نجوم إلى أن آبوا أوبة راحل",100,"ل",1,0],["وقد فتكت فيها لواحظ نكبة","يشيب لها الطفل الرضيع بأحزان",101,"ن",1,0],["وقدْ فُجِرَتْ يَنابيعُ التَّجَلِّي","بقَلْبي عن أَنابيبٍ زَكِيَّهْ",102,"ي",2,0],["وقد فَنيتُ في الهَوَى","إنَّ الفَنا عينُ البَقا",103,"ق",2,0],["وقَدْ فَرشْتُ بِثَراهمْ مُقْلةً","سوى جمالِ نورهمْ لم تَلمحِ",104,"ح",1,0],["وقد فزعت بآمالي إليك وفي","رحاب جودك للعافين ترحيب",105,"ب",1,0],["وقد فزنا بما نهوى","وأدركنا الثواب الجَمّْ",106,"م",1,0],["وقد فهمت منه النصارى بأنه","هو الله جل الله عن موجب الحصر",107,"ر",1,0],["وقد فَطمتْني النائباتُ وإِنَّني","علمتُ بها أَنَّ الفطامَ أَخُو الثُّكل",108,"ل",1,0],["وقد فتقت في الدين أعظم ثلمة","لمن غيبوا في الدمس بدر المنابر",109,"ر",1,0],["وقد فقت أبناء الملوك جميعهم","بجد وإقدام بكل الملاحم",110,"م",1,0]]}