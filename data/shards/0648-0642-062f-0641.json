{"poems":[[63,"نظرت وكم من نظرة تلد الردى","https://www.aldiwan.net/poem45788.html","الطويل"],[63,"ضلت قبيلة راموا مساجلتي","https://www.aldiwan.net/poem45928.html","البسيط"],[63,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[3,"سلا القلب عما كان يهوى","https://www.aldiwan.net/poem128.html",""],[55,"أتيح لقلبي من شقاوة جده","https://www.aldiwan.net/poem26288.html","الطويل"],[9,"ألم تروا إرما وعادا","https://www.aldiwan.net/poem21934.html","مجزوء البسيط"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[88,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[37,"وقد فاض غرب عند برقاء جندب","https://www.aldiwan.net/poem7235.html","الطويل"],[51,"قل للأمير أدام الله دولته","https://www.aldiwan.net/poem8700.html","البسيط"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[51,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[51,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[51,"ألا يا ابن القنوط عجبت جدا","https://www.aldiwan.net/poem65793.html","الوافر"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[29,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[89,"يضيق بما يلقاه قلبي من البين","https://www.aldiwan.net/poem44784.html","الكامل"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[43,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[62,"إذا ما الشمس في السرطان صارت","https://www.aldiwan.net/poem52157.html","الوافر"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"تصدت لنا دعد وصضت على عمد","https://www.aldiwan.net/poem63549.html","الطويل"],[45,"فدتك أكف قوم ما استطاعوا","https://www.aldiwan.net/poem64659.html","الوافر"],[28,"ستأتيك مني إن بقيت قصائد","https://www.aldiwan.net/poem5426.html","الطويل"],[61,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[61,"عفاء على اللذات من بعد فارس","https://www.aldiwan.net/poem51595.html","الطويل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[58,"رأيت المشركين بغوا علينا","https://www.aldiwan.net/poem30914.html","الوافر"],[66,"ولم أنس إذ زار الحبيب بروضة","https://www.aldiwan.net/poem38796.html","الطويل"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[74,"تهاداني لذكركم ارتياح","https://www.aldiwan.net/poem12882.html","الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"ألا رب يوم حثت الكاس خطوه","https://www.aldiwan.net/poem12938.html","الطويل"],[74,"أجبت وقد نادى الغرام فأسمعا","https://www.aldiwan.net/poem13172.html","الطويل"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[52,"قد صد قلبي قمر","https://www.aldiwan.net/poem27040.html","مجزوء الرجز"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[48,"ولا أفرق غلابا","https://www.aldiwan.net/poem66291.html","الهزج"],[46,"تعالى رازق الأحياء طرا","https://www.aldiwan.net/poem22002.html","الوافر"],[46,"أرى طولا عم البرية كلها","https://www.aldiwan.net/poem22309.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9895","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[45,"فُؤادٌ، بذِكْرِ الظّاعنينَ، مُوَكَّلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32198",""],[45,"تصدت لنا دعد وصدت على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=31307",""]],"verses":[["وَقَد فاضَ دَمعٌ ضاقَ عَنهُ مَسيلُهُ","عَلى صَحنِ خَدٍّ لَم يَسَعهُ أَسيلِ",0,"ل",1,0],["وَقَدْ فَضَلْتُهُمُ في كُلِّ مَكْرُمَةٍ","إِلّا الغِنى وَالعُلا في الفَضْلِ لا المالِ",1,"ل",1,0],["وقد فَلَيْتُ الوَرى حتى قَلَيْتُهُمُ","إلا بَقايا كِرامٍ منْ بَني خَلَفِ",2,"ف",1,0],["وقد فرّقَ البَيْنُ المُشتِّتُ بَيْنَنا","فشَطَّ مَزارٌ واسْتَقَلَّ رَفيقُ",3,"ق",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِل","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",4,"ب",1,0],["وُقَد فَعَلَت كُلَّ الأَفاعيلِ عَينُهُ","بِجِسمي فَأَمسى وَالسِقامُ مُخامِرُه",5,"ر",2,0],["وَقَد فَرَرتُم وَما صَبَرتُم","وَذاكَ شَينٌ لَكُم وَعارُ",6,"ر",1,0],["وَقَد فَقَدَتكَ طَلقَةُ فَاِستَراحَت","فَلَيتَ الخَيلَ فارِسُها يَراها",7,"ا",3,0],["وقد فاته أنّا أولو ألْمَعِيّة","بها نخطُف الأسرار من قلبه خطفا",8,"ف",2,0],["وقد فاض غَرْبُ عند برقاء جُنْدُب","لعينيك من عِرفانِ ما كنت تعرفُ",9,"ف",1,1],["وقد فتحتُ عليك الشرقَ متصلاً","بالغرب لم تخلُ من نصر وتثبيتِ",10,"ت",1,0],["وقد فَغرتْ فاهاً له غير أنها","تراقب إذناً منك غير مساعدِ",11,"د",1,0],["وقد فُزْتَ أن أصبحت عبداً مُسلِّماً","لما أوْجبتهُ في الرقاب القلائدُ",12,"د",1,0],["وقد فعلتْ بك القالاتُ قبلي","كفعلِ النار بالحطب اليبيس",13,"س",1,0],["وقد فهمتني فرجعتُ عمّا","نكرتَ عليَّ فاكففْ حدَّ باسك",14,"ك",1,0],["وقد فتحتَ لواشٍ بابَ حيلته","فاستعملِ العينَ بعد اليوم لا الأذنا",15,"ن",2,0],["وَقَد فَكَكتَ عَنِ الأَسرى وِثاقَهُمُ","وَلَيسَ يَرجونَ تَلجاءً وَلا دَخَلا",16,"ل",2,0],["وَقَد فَرَشَت أَقطارُها لَكَ سُندُساً","لَهُ مِن فُنونِ الزَهرِ وَالنَورِ أَلوانُ",17,"ن",1,0],["وقد فقدت كل العروبة سعدها","وما مصر إلا بعض تلك الفواقد",18,"د",1,0],["وقد فتشت قبلي القلوب فاجفلت","لما راعها فيما هنالك من رين",19,"ن",1,0],["وقد فرحت أعاديه شِماتاً","وفارقه أحبتهُ مَلالا",20,"ل",2,0],["وَقَد فارَقَ الناسُ الأَحِبَّةَ قَبلَنا","وَأَعيا دَواءُ المَوتِ كُلَّ طَبيبِ",21,"ب",1,0],["وَقَد فَجَعَتهُ بِاِبنِهِ وَاِبنِ صِهرِهِ","وَبِالصِهرِ حَملاتُ الأَميرِ الغَواشِمُ",22,"م",1,0],["وقد فرشت برضراض كريم","يولدّ صبغ جوهره نضارك",23,"ك",1,0],["وَقَد فُتِحَ الأُفقانِ عَن سَيفِ مُصلِتٍ","لَهُ سَطَواتٌ ما تُهَرُّ وَما تُعوى",24,"و",2,0],["وَقَد فاتَهُم شَأوي بِتَقصيرِ شَأوِهِم","فَلَم يَملِكوا سَبقي وَلَم يَملِكوا رَدّي",25,"ي",1,0],["وَقَد فَرَشَت لَكَ الدُنيا مِراراً","مَراتِبَ كُلُّها نَجدٌ يَفاعُ",26,"ع",1,0],["وَقَد فَضَلَت بَكرٌ رَبيعَةَ كُلَّها","بِفِعلِ العُلى وَالمَأثُراتِ الأَوائِلِ",27,"ل",1,0],["وقَد فَوَّقنَ بالألحاظِ نَبلاً","قلوبُ العاشِقين لها رَمايا",28,"ا",3,0],["وقد فَتَقَ الإصباحُ رتقَ جفونِهِم","وقارعَ طيبَ الغُمْضِ قَرْعُ النَّواقسِ",29,"س",1,0],["وقد فَضُلَت بيضُ القِبابِ لأنني","نصبْتُ عليها بالقصائدِ مِطرَدا",30,"د",2,0],["وَقَد فَلَّلتَ خَيلَهُمُ بِبَدرٍ","وَأَتبَعتَ الهَزيمَةَ بِالرِجالِ",31,"ل",1,0],["وَقَد فَرَشَ الوَردُ الخُدودَ وَنُشَّرَت","لِمَقدَمِهِ لِلسَوسَنِ الغَضِّ أَعلامُ",32,"م",1,0],["وقد فَرَغَتْ للقَوْمِ في غَفَلاتهمْ","حتوفٌ بهم تُمسي وتُصبحُ في شُغْلِ",33,"ل",1,0],["وَقَد فَغَرَ الحَمامُ هُناكَ فاهُ","وَأَتلَعَ جيدَهُ الأَجَلُ المُتاحُ",34,"ح",1,0],["وَقَد فَلَّهُ طولُ الجِلادِ كَأَنَّما","يُضاحِكُ مِنهُ مَفرِقَ الفَرقِ أَدرَدُ",35,"د",1,0],["وَقَد فَضَّضَ النُوّارُ كُلَّ رَباوَةٍ","وَسالَ عَلَيها لِلأَصيلِ نُضارُ",36,"ر",1,0],["وَقَد فَضَّ عِقدَ القَطرِ في كُلِّ تَلعَةٍ","نَسيمٌ تَمَشّى بَينَها فَتَضَوَّعا",37,"ع",2,0],["وَقَد فاتَ ذاكَ العَهدُ إِلّا تَذَكُّراً","لَواني عَلى ظَهرِ المَطِيِّ تَوَجَّعا",38,"ع",2,0],["وَقَد فَنَيتُ بَعدَهُ","وَضاعَ ذاكَ الحَذَرُ",39,"ر",1,0],["وقدْ فُدِيَتْ مِنْ مالِهِ خيرُ أُمَّةٍ","وَلَو خُيِّروا في ذلكَ الأمرِ لَمْ يَفْدُوا",40,"د",3,0],["وَقَد فَتَحَ الهَوى بِيَدَي","كَ أَلواناً مِنَ العِبَرِ",41,"ر",1,0],["وقد فوّهتُ فيه كلَّ","مَن قالَ ومَن عابا",42,"ب",2,0],["وَقَد فَتَّشتُ عَن أَصحابِ دينٍ","لَهُم نُسكٌ وَلَيسَ لَهُم رِياءُ",43,"ي",3,0],["وَقَد فُجِعَت بِالفَرخِ أَمسِ حَمامَةٌ","فَما بالُها تُلفي بِمَوضِعِها فَرخا",44,"خ",2,0],["وقد فرح الأحزاب من صحة به","فهنَّأ حزب بالسلام له حزبا",45,"ب",2,0],["وقد فل من فرسانهن صوارم","وحطم في لباتهن إلال",46,"ل",1,0],["وقد فَغَرَتْ فاها بها كُلُّ زَهْرة","إِلى كُلِّ ضَرْعٍ للغَمَامةِ حافِلِ",47,"ل",1,0],["وَقَد فازَ مَن في الحَربِ أَصبَحَ جائِلاً","يُطاعِنُ قِرناً وَالغُبارُ مُطَنِّبُ",48,"ب",1,0],["وقد فهِمَتني عينُه وفهمْتُه","وكان بحمدِ اللّهِ أسرَعَنا فهما",49,"م",2,0],["وقد فاتنا أنّ الذي نستلذُّهُ","قلوبٌ رقاقٌ ذُوِّبَتْ ومرائر",50,"ر",1,0],["وَقد فقَدَتْ أُنسَ الخِلافةِ، وَانتحى","على أهلِها خَطبٌ، من الدّهرِ، مُعضِلُ",51,"ل",1,0],["وقد فاتهم شأوي بتقصير شأوهم","ذخائر ما في الصدر من صادق الود",52,"د",1,0]]}