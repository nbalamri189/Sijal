],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5648,"حنين القلب","https://www.poetsgate.com/ViewPoem.aspx?id=154662",""],[5725,"سلاما للعراق","https://www.poetsgate.com/ViewPoem.aspx?id=191774",""],[5732,"مصايب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=177822",""],[5842,"يا شام (د. جمال مرسي)","https://www.poetsgate.com/ViewPoem.aspx?id=65846",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6056,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=130142",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""]],"verses":[["عَلى غُصَصٍ لَو كُنَّ في البَدرِ لَم يُنِر","وَفي العودِ لَم يورِق وَفي السَهمِ لَم يَمضِ",0,"ض",1,0],["عَلى غَوراءَ تَشتَجِرُ الأَداوى","بِعَرصَتِها وَتَزدَحِمُ الدِلاءُ",1,"ا",2,0],["عَلى غَيرِ شيءٍ غَيرَ أَنّي مُعاتِبٌ","وَذَلِكَ أَمرٌ سَنَّهُ الناسُ نافِذُ",2,"ذ",1,0],["عَلى غَيرِ ذَنبٍ غَيرَ أَنَّ عَداوَةً","طَمَت بِكَ فَاِستَأخِر لَها أَو تَقَدَّمِ",3,"م",1,0],["عَلى غَيرِ السِواءِ مَدَحتَ سَعداً","فَزِدهُم ما اِستَطَعتَ مِنَ الثَوابِ",4,"ب",1,0],["على غير تقى اللَّه","غدْت أَبياتُهم تُبنَى",5,"ن",2,0],["عَلى غَيرِ إِسلامٍ وَلا عَن بَصيرَةٍ","وَلَكِنَّهُم سيقوا إِلَيكَ عَلى صُغرِ",6,"ر",1,0],["عَلى غَمَراتِ المَوتِ تَشكو عِتاقُها","إِذا ساوَرَت وَقعَ القَنا وَالتَحَمحُمِ",7,"م",1,0],["على غَيرِ عَتْبٍ ما طَوَيْتُ عِتابَها","وآثرْتُ من بعدِ الوِصالِ احتسابَها",8,"ب",3,1],["على غناءٍ بعودِ غانيَةٍ","يُجْري عليها بنانُها عَنَمه",9,"م",2,0],["عَلى غَيرِ شَيءٍ غَيرَ أَنّي أُحِبُّها","وَأَنَّ فُؤادي عِندَ لَيلى أَسيرُها",10,"ر",3,0],["عَلَى غيرِ شيءٍ غير أنّا نَظنُّها","مَخائلَ ما ترجو النُّفوسُ الجَوازعُ",11,"ع",1,0],["عَلى غِرَّةٍ أَو جَهلَةٍ مِن مُكانِسٍ","أَطالَ نِزالَ المَوتِ حَتّى تَسَعسَعا",12,"ع",2,0],["عَلى غَيرِ ذَنبٍ قُلتُهُ غَيرَ أَنَّني","نَشَدتُ فَلَم أُغفِل حَمولَةَ مَعبَدِ",13,"د",1,0],["على غير شيء لم يضفنا ابن عما","ولم يتعرض عندنا لمتاع",14,"ع",1,0],["على غَيْرِ جُرْمٍ غيرَ أنْ قُلْتُ عمّهم","يَعِيشُ أبوهم في ذُراهُ مغفَّلا",15,"ل",2,0],["على غير جرم غير أن قلت: عنهم","يعيش أبوهم في ذراه مغفلاَ",16,"ل",2,0],["على غير ذنب غير إنكار قسطهم","وللجور من نفس المحق نكير",17,"ر",1,0],["على غردان الايك مني تحية","كما هيمنت ريح الصبا والبشائم",18,"م",1,0],["عَلَى غِرَّةٍ أوْ نُهْزَةٍ مِنْ مُكَانِسٍ","أطَالَ نِزَالَ الْقَوْمِ حَتَّى تَسَعْسَعَا",19,"ع",2,0],["على غيرِ ما سنَّ الكرامُ وما التقت","عليه شعوبٌ جمةٌ وقبائل",20,"ل",1,0],["على غناء ورؤى ووتر","ترنّحت ترنّح النزيف",21,"ف",1,0],["على غير ذنب غير انكار قسطهم","وللجور من نفس الحق نكير",22,"ر",1,0],["على غير شئٍ قلتهُ غير أنني","نَشَدْتُ فلم أُغْفِلْ حَمُولة َ مَعبَد",23,"د",1,0],["على غوراء تشتجر الاداوى","بعرضتها وتزدحم الدلاء",24,"ا",2,0],["على غير عِلمي وحُرِّيَّتي","تَحُلُّ مَكانَكِ جِنِّيَّتي",25,"ي",1,0],["على غيرك البهتان والزور ينفق","وما ينقل الواشي افتراء ويخلق",26,"ق",1,1],["على غير ذنب كان مني هجركم","ولو كان ذنب كان منه متاب",27,"ب",1,0],["عَلى غُصنٍ لَوَتهُ يَدُ المَنايا","وَفي تاريخِها قَصَفَتهُ غَدرا",28,"ر",2,0],["على غريق بحبل الماء معتصم","والحبل في لمسات الكف ينقطع",29,"ع",1,0],["على غاربي ألقيتم حبل هجركم","وخيل اصطباري في الاعنة عنت",30,"ت",1,0],["على غبطةٍ لم تخْش من كَيد حاسدٍ","وأوْقَاتُنا مَحْضُورةٌ غَفَلاتُها",31,"ت",3,0],["عَلَى غَمْرِ الْمَوَاهِبِ وَالْعَطَايَا","عَلَى مَنْ لاَ يُضَافُ إِلَى ضَنِينِ",32,"ن",1,0],["عَلَى غَيْرِ ثَارٍ آثَرَتْ فَوْتَ مُهْجَتِي","قَنِيصاً وَمَازَالَتْ تُراعُ مِنَ القَنْصِ",33,"ص",1,0],["عَلى غرَّة العَليا عَلى هامَة العُلى","على من له المَجدُ المؤثَّل أَجمَعُ",34,"ع",1,0],["على غرر الأيام لما تصرمت","وأصبحت منها رهن شؤم المكاسب",35,"ب",1,0],["عَلى غَيرِ آسٍ قَد نَبَستَ بِسَلوَةٍ","وَزوحِمتُ مِن وَجدي بِأَلفِ مُزاحِمِ",36,"م",1,0],["على غصن شوقي حمائم ذكركم","تنوح فَتُبْكِي القلبَ وهو عميد",37,"د",1,0],["عَلى غَيرِ شَيءٍ غَيرَ أَن كُنتَ مِنهُمُ","أَعَفَّ وَأَعطى لِلجَزيلِ وَأَشجَعا",38,"ع",2,0],["على غلمة في النَّاس لله درُّه","تصرَّف فيها همَّة وتقدّما",39,"م",2,0],["عليّ غدا في الفضل مثل سميّه","بقدر سما فوق السماء رفيعه",40,"ع",2,0],["عَلى غَولِ بحرٍ من هُمومٍ عُبابُهُ","بِرَحلي إلى غَول المتالفِ طوَّاح",41,"ح",1,0],["على غَرَرٍ وساعةَ لا طُروقٌ","ألا ما للجبان وللصرامَهْ",42,"م",2,0],["عَلى غَديرٍ رَقَّ تَدريجُهُ","كَأَنَّهُ مَقعَدُ سامانِ",43,"ن",1,0],["عَلى غِناءٍ كَدَوامِ الغِنى","من مُحسِنٍ مِن أَحسَنِ الناسِ",44,"س",1,0],["عَلى غَيرِ شَيءٍ غَيرَ أَن لَيسَ تَابِعاً","عَلِيّاً ومَن لاَ يَتبَعِ الحَقِّ ينَدَمِ",45,"م",1,0],["عَلى غَيرِ بُغض وَلا عَن قِلى","وَإِلّا حَياءَ وَإِلّا ذُهولا",46,"ل",2,0],["على غفلةٍ جاء الكرى باعثاً لنا","بلا موعدٍ والزّائرون هُمُودُ",47,"د",1,0],["على غير الدعاء لأهل ظلم","بدون صلاح حال كل آن",48,"ن",1,0],["على غير ضَلاَّتِ الأَمانِي تَعَوُّلِي","ومن غيرِ علاَّت المُدامِ تَعَلُّلِي",49,"ل",2,1],["عَلى غَيرِ عَهدٍ بِالثَناءِ وَلَم يَكُن","حِداها إِلى ناديكَ إِلّا عُهودَها",50,"د",3,0],["عَلى غَيرِ شَيءٍ غَيرَ أَنّا عِصابَةً","غِضابٌ لَدَينا المُسلِمينَ وَدينَها",51,"ن",3,0],["على غَديرٍ غَيرِ عَذب","إذ تلُبّي",52,"ي",1,0],["عليٌّ غداً يُدعى فيكسوهُ ربُّهُ","ويُدنيه حَقّاً من رفيقٍ مُكَرَّمِ",53,"م",1,0],["على غير ذي الحال التي أنت ناقم","عليها وقد أنذرتهم بفناء",54,"ا",2,0],["عَلى غُصن دَوح العز وَالنصر وَالسَعدِ","ترنّم طَير الأُنس في رَوضة الوَردِ",55,"د",1,1],["على غمرات الردى هجموا","وطود اللهيب قد اقتحموا",56,"م",3,1],["عَلى غَيرِها يَغلو وَقَد صارَ عِندَها","رَخيصاً فَمن هَذين داخِلها العجبُ",57,"ب",1,0],["عَلِيٌّ غادَرَ الأَبطالَ صَرعى","وَأَخرَسَ عَن شَقاشِقِها الفُحولا",58,"ل",2,0],["على غيرِ رأسك لم يخفقِ","وحينَ عرجتَ لأسنا مُقام",59,"م",1,0],["على غير ما ذنبٍ جنينا فما لنا","نسام الدنايا لم نحارب ولم نجن",60,"ن",1,0],["على غير ذنب كان إلا تنزها","عن الناس حتى أدركته المصارع",61,"ع",1,0],["عَلى غَيرِ حزم في الاِمورِ وَلا تقى","وَلا نائِل جَزل تعد مَواهِبُه",62,"ب",2,0],["على غشيانها في الفرج حتى","يغيب رأسه في الشفرتين",63,"ن",1,0],["علَى غَيرِكم فالطِّينُ طِينٌ وَثمَّ ما","عَرَفناكَ أَنتَ الحِبُّ لِلِهِ أَينَما",64,"م",2,0],["على غُرةٍ كالشمسِ من تحتِ طُرةٍ","تزينُ الضيا منها بأسوَدَ فاحمِ",65,"م",1,0],["على غير من يقوى على دحض قوله","ويدفع أضرار المضل بمذود",66,"د",1,0],["على غَربِهِ خُذهُم وعندَ شُروقِهِ","مَدَى دَهرِهِم في طَالِعٍ ثُمَّ غَارِبِ",67,"ب",1,0],["على غنم يغدو يتيما بلا اب","ولا ام واستولى على دارة السر",68,"ر",1,0],["على غديرٍ برَوْضَةٍ نظمَتْ","نُوّارُها حول بدره شُهُبا",69,"ب",2,0],["على غصصٌ في الصدر لو حلّ وقعها","من الشيخ في راس الفتى شاب مفرق",70,"ق",1,0],["على غير حبك من باطني","قضى حسنك اليوسفي بالجلا",71,"ل",2,0],["على غفلةٍ لا في زحام كريهةٍ","له سددت كف الردى أسهم الغدر",72,"ر",1,0],["عَلى غَيرِ ذَنبٍ كانَ مِنهُ إِلَيهِمِ","سِوى أَنَّهُ جادَت عَلَيهِم مَواطِرُه",73,"ر",2,0],["على غيرك العلياء أضيق مسلك","وصدرك من ظهر البسيطة أوسع",74,"ع",1,0],["عَلى غَيرِ ذَنبٍ أَن أَكونَ جَنَيتُهُ","سِوى قَولِ باغٍ كادَني فَتَجَهَّدا",75,"د",2,0],["عَلى غَيرِ جُرمٍ أَن جارَ ظالِمٌ","عَليَّ فَجَهَزتُ القَصيدَ المُفرَّعا",76,"ع",2,0],["على غير ذنب كان منّي عملته","سوى أنّني نوّهت: أن غلب الصّبر",77,"ر",1,0],["على غيرها الفيحاء تسمو وتعتلي","إذا افتخرت أرخ بيت المفاخر",78,"ر",1,0],["على غير ذنبٍ غير حسن وفائهم","فما أخلفوا وعداً ولا نقضوا عهداً",79,"د",2,0],["على غرة الواشي تقضت حميدة","وغرة وضاح الجبين طليقه",80,"ق",2,0],["علي غزال غير ان لحاظه","لها في فؤادي دائما وقعة الجمل",81,"ل",1,0],["عَلى غَيرِ شَيءٍ كانَ مِنهُ علِمتَهُ","وَلَم يَكُ مِنهُ في اِبنِ عَفّانَ مِن ذَنبِ",82,"ب",1,0],["على غير هوى منك","تجافي ربعك السلم",83,"م",1,0],["على غُرُفٍ بها سُرُرٌ","قريراً جَارَ صفوته",84,"ت",2,0],["على غُرَفِ من الإبريز تدعى","على ما تشتَهيه من العطاء",85,"ا",2,0],["على غصنٍ غصٍّ من البان لم يطب","له الريح إلا زانه ذلك القدُّ",86,"د",1,0],["على غصونك ظل الياسمين بها","يطل عن فجره البسام إشراقي",87,"ق",2,0],["عَلى غِصنٍ /غِفا فَوقه/ ورَفرف لي جناح الطير","بأرضٍ ما يِبارحها .. حَنين الروحِ مَجهوله",88,"ل",2,0],["على غصن الوله يآآآمآ غفيت وجيت لك طآير","وعطيتك قلب من حبك وفكره تحت رغبآتك",89,"ك",1,0],["على غزلٍ نوّمْت فيه قساوة ً","وعللْت حزنا في تبسّمك اليسرُ",90,"ر",1,0],["على غدنا سترقصُ ذكرياتي","غدًا قَدُّ الأماسيْ البكرِ مَشْقُ",91,"ق",1,0],["على غيمةٍ من يباس النَّدى","تَهَاوَى مِنَ المُقْلَتَيْنِ الحَجَرْ",92,"ر",1,0],["عَلى غلامٍ من بَني الخَليقِ","بِكُلِّ فِعلٍ حَسَنٍ خَليق",93,"ق",1,0],["على غَفْلَةٍ في اللَّيْلِ قد جئتِ زائِرَة","وبيني وبين الشوقِ نِيلٌ وقاهِرَة",94,"ر",2,1],["على غدير اذا الصبا درجت","في متنه اظهرت لنا حبكه",95,"ك",2,0],["على غُصنِ التفاؤُلِ جئتُ أشدو","ولحنُ الحبّ أبياتٌ عِذابُ",96,"ب",1,0],["على غامضات الغيب سلطت فكرة","اميطت بها استاره وبراقعه",97,"ع",2,0],["على غير ذنب موجب قد جنيته","يسوغ به للشامت القدح والقذف",98,"ف",1,0],["على غير شيء غير توحيد ربنا","بإخلاصٍ أنواع العبادة للفرد",99,"د",1,0],["على غصون الحب نبني عشنا","قشه بقشه هكذا ويداً بأيد",100,"د",1,0],["على غيمة نشوى وضعتُ صبابتي","فهامت على درب الحنين تُعرّجُ",101,"ج",1,0],["على غيمة يبقى يُناجي هطولها","ومازال للعشاق غيمٌ ومرتفعْ!!",102,"ع",1,0],["على غنمي أهشًّ إذا تناءتْ","وأنعم بالشهيق وبالزفيرِ",103,"ر",1,0],["على غيابه مانقص من معاليه","ولو طال بعده خافقي عنه ماتاب",104,"ب",1,0],["على غصّةٍ تستهين الصعاب","كما لان للناسك المنسكُ",105,"ك",1,0],["على غالي عنا حجب دونه الثرى","وفرقاه ترث بالفواد لهيب",106,"ب",1,0],["عَلَى غُصنِكِ المَذبُوحِ نَاحَ الحَمَامُ","وفِي نَهرِكِ المَسفُوحِ ضَجَّ الحِمَامُ",107,"م",1,1],["على غَيْرِ شَيءٍ غيرَ أنكُمُ مَعاً","إذَا حَصَّلَ الأَنْسَابَ كَفٌّ وسَاعِدُ",108,"د",1,0],["على غرير ٍفي البلد ما بعد داج","عمره ثمان وخمس واربع سنيني",109,"ن",2,0],["عَلَى غُنُجٍ يَهتَزُّ خَلخَالُ رِجلِها","فَيَشطُرُنِي - يَا قَومُ - فِي جَرسِهِ شَطرا",110,"ر",2,0]]}