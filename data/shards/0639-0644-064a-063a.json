{"poems":[[53,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[53,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[42,"أبلغ أبا الجارود عني رسالة","https://www.aldiwan.net/poem50415.html","الطويل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[27,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[51,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[28,"أعيني ما بعد ابن موسى ذخيرة","https://www.aldiwan.net/poem5563.html","الطويل"],[61,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[80,"هبوا فقد رحل الدجى ظلمه","https://www.aldiwan.net/poem31305.html","المنسرح"],[33,"ألا حجبت ليلى وآلى أميرها","https://www.aldiwan.net/poem25920.html","الطويل"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[13,"وقالوا لها لا تنكحيه فإنه","https://www.aldiwan.net/poem2219.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72213","الطويل"],[36,"أَتاني مِنَ الأَنْباءِ أَنّ عَشِيرة ً","https://www.poetsgate.com/ViewPoem.aspx?id=15883",""],[13,"وَقَالُوا لَهَا لاَ تُنْكِحِيهِ فَإنَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180832",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[53,"خُطُوبٌ لا يُقَاوِمُهَا البَقَاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9811&r=&rc=8",""],[127,"تعالي صباحا إلى غرفتي","https://www.aldiwan.net/poem67444.html","المتقارب"],[158,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[158,"إلى كم عتاب دائم وعتاب","https://www.aldiwan.net/poem58982.html","الطويل"],[180,"مضى جرجي العزيز إلى مناه","https://www.aldiwan.net/poem61187.html","الوافر"],[197,"يا ظلة الموج يطغى البحر منتفضاً","https://www.aldiwan.net/poem45135.html","البسيط"],[208,"سفحت عقيق الدمع من سفح مقلتي","https://www.aldiwan.net/poem13304.html","الطويل"],[210,"فمن مقلتي روحي جرت عبراتها","https://www.aldiwan.net/poem37908.html","الطويل"],[235,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[273,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[295,"سلام على بدر له السعد مطلع","https://www.aldiwan.net/poem33228.html","الطويل"],[302,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[364,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[400,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[407,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[413,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[434,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[456,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[466,"يا من غدا روضي وبستاني","https://www.aldiwan.net/poem59640.html","السريع"],[466,"قم فاجلها في خلعة الكاس","https://www.aldiwan.net/poem59945.html","السريع"],[501,"وأشعث سجاد بآيات ربه","https://www.aldiwan.net/poem21750.html","الطويل"],[524,"هجرت أمامة هجرا طويلا","https://www.aldiwan.net/poem1935.html","المتقارب"],[549,"ألا ليت عيشا ماضيا عنك بالحمى","https://www.aldiwan.net/poem47878.html","الطويل"],[556,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[573,"على غير ضلات الأماني تعولي","https://www.aldiwan.net/poem2876.html","الطويل"]],"verses":[["عَلى غُصَصٍ لَو كُنَّ في البَدرِ لَم يُنِر","وَفي العودِ لَم يورِق وَفي السَهمِ لَم يَمضِ",0,"ض",1,0],["عَلى غَوراءَ تَشتَجِرُ الأَداوى","بِعَرصَتِها وَتَزدَحِمُ الدِلاءُ",1,"ا",2,0],["عَلى غَيرِ شيءٍ غَيرَ أَنّي مُعاتِبٌ","وَذَلِكَ أَمرٌ سَنَّهُ الناسُ نافِذُ",2,"ذ",1,0],["عَلى غَيرِ ذَنبٍ غَيرَ أَنَّ عَداوَةً","طَمَت بِكَ فَاِستَأخِر لَها أَو تَقَدَّمِ",3,"م",1,0],["عَلى غَيرِ السِواءِ مَدَحتَ سَعداً","فَزِدهُم ما اِستَطَعتَ مِنَ الثَوابِ",4,"ب",1,0],["على غير تقى اللَّه","غدْت أَبياتُهم تُبنَى",5,"ن",2,0],["عَلى غَيرِ إِسلامٍ وَلا عَن بَصيرَةٍ","وَلَكِنَّهُم سيقوا إِلَيكَ عَلى صُغرِ",6,"ر",1,0],["عَلى غَمَراتِ المَوتِ تَشكو عِتاقُها","إِذا ساوَرَت وَقعَ القَنا وَالتَحَمحُمِ",7,"م",1,0],["على غَيرِ عَتْبٍ ما طَوَيْتُ عِتابَها","وآثرْتُ من بعدِ الوِصالِ احتسابَها",8,"ب",3,1],["على غناءٍ بعودِ غانيَةٍ","يُجْري عليها بنانُها عَنَمه",9,"م",2,0],["عَلى غَيرِ شَيءٍ غَيرَ أَنّي أُحِبُّها","وَأَنَّ فُؤادي عِندَ لَيلى أَسيرُها",10,"ر",3,0],["عَلَى غيرِ شيءٍ غير أنّا نَظنُّها","مَخائلَ ما ترجو النُّفوسُ الجَوازعُ",11,"ع",1,0],["عَلى غِرَّةٍ أَو جَهلَةٍ مِن مُكانِسٍ","أَطالَ نِزالَ المَوتِ حَتّى تَسَعسَعا",12,"ع",2,0],["عَلى غَيرِ ذَنبٍ قُلتُهُ غَيرَ أَنَّني","نَشَدتُ فَلَم أُغفِل حَمولَةَ مَعبَدِ",13,"د",1,0],["على غَيْرِ جُرْمٍ غيرَ أنْ قُلْتُ عمّهم","يَعِيشُ أبوهم في ذُراهُ مغفَّلا",14,"ل",2,0],["على غير جرم غير أن قلت: عنهم","يعيش أبوهم في ذراه مغفلاَ",15,"ل",2,0],["عَلَى غِرَّةٍ أوْ نُهْزَةٍ مِنْ مُكَانِسٍ","أطَالَ نِزَالَ الْقَوْمِ حَتَّى تَسَعْسَعَا",16,"ع",2,0],["على غيرِ ما سنَّ الكرامُ وما التقت","عليه شعوبٌ جمةٌ وقبائل",17,"ل",1,0],["على غير شئٍ قلتهُ غير أنني","نَشَدْتُ فلم أُغْفِلْ حَمُولة َ مَعبَد",18,"د",1,0],["على غوراء تشتجر الاداوى","بعرضتها وتزدحم الدلاء",19,"ا",2,0],["على غير عِلمي وحُرِّيَّتي","تَحُلُّ مَكانَكِ جِنِّيَّتي",20,"ي",1,0],["على غيرك البهتان والزور ينفق","وما ينقل الواشي افتراء ويخلق",21,"ق",1,1],["على غير ذنب كان مني هجركم","ولو كان ذنب كان منه متاب",22,"ب",1,0],["عَلى غُصنٍ لَوَتهُ يَدُ المَنايا","وَفي تاريخِها قَصَفَتهُ غَدرا",23,"ر",2,0],["على غريق بحبل الماء معتصم","والحبل في لمسات الكف ينقطع",24,"ع",1,0],["على غاربي ألقيتم حبل هجركم","وخيل اصطباري في الاعنة عنت",25,"ت",1,0],["على غبطةٍ لم تخْش من كَيد حاسدٍ","وأوْقَاتُنا مَحْضُورةٌ غَفَلاتُها",26,"ت",3,0],["عَلَى غَمْرِ الْمَوَاهِبِ وَالْعَطَايَا","عَلَى مَنْ لاَ يُضَافُ إِلَى ضَنِينِ",27,"ن",1,0],["عَلَى غَيْرِ ثَارٍ آثَرَتْ فَوْتَ مُهْجَتِي","قَنِيصاً وَمَازَالَتْ تُراعُ مِنَ القَنْصِ",28,"ص",1,0],["عَلى غرَّة العَليا عَلى هامَة العُلى","على من له المَجدُ المؤثَّل أَجمَعُ",29,"ع",1,0],["على غرر الأيام لما تصرمت","وأصبحت منها رهن شؤم المكاسب",30,"ب",1,0],["عَلى غَيرِ آسٍ قَد نَبَستَ بِسَلوَةٍ","وَزوحِمتُ مِن وَجدي بِأَلفِ مُزاحِمِ",31,"م",1,0],["على غصن شوقي حمائم ذكركم","تنوح فَتُبْكِي القلبَ وهو عميد",32,"د",1,0],["عَلى غَيرِ شَيءٍ غَيرَ أَن كُنتَ مِنهُمُ","أَعَفَّ وَأَعطى لِلجَزيلِ وَأَشجَعا",33,"ع",2,0],["على غلمة في النَّاس لله درُّه","تصرَّف فيها همَّة وتقدّما",34,"م",2,0],["عليّ غدا في الفضل مثل سميّه","بقدر سما فوق السماء رفيعه",35,"ع",2,0],["عَلى غَولِ بحرٍ من هُمومٍ عُبابُهُ","بِرَحلي إلى غَول المتالفِ طوَّاح",36,"ح",1,0],["على غَرَرٍ وساعةَ لا طُروقٌ","ألا ما للجبان وللصرامَهْ",37,"م",2,0],["عَلى غَديرٍ رَقَّ تَدريجُهُ","كَأَنَّهُ مَقعَدُ سامانِ",38,"ن",1,0],["عَلى غِناءٍ كَدَوامِ الغِنى","من مُحسِنٍ مِن أَحسَنِ الناسِ",39,"س",1,0],["عَلى غَيرِ شَيءٍ غَيرَ أَن لَيسَ تَابِعاً","عَلِيّاً ومَن لاَ يَتبَعِ الحَقِّ ينَدَمِ",40,"م",1,0],["عَلى غَيرِ بُغض وَلا عَن قِلى","وَإِلّا حَياءَ وَإِلّا ذُهولا",41,"ل",2,0],["على غفلةٍ جاء الكرى باعثاً لنا","بلا موعدٍ والزّائرون هُمُودُ",42,"د",1,0],["على غير الدعاء لأهل ظلم","بدون صلاح حال كل آن",43,"ن",1,0],["على غير ضَلاَّتِ الأَمانِي تَعَوُّلِي","ومن غيرِ علاَّت المُدامِ تَعَلُّلِي",44,"ي",1,1]]}