{"poems":[[91,"ما انت يا احمد في دولة الادب","https://www.aldiwan.net/poem44620.html","البسيط"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[70,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[309,"ما في الوجود ولا في الكون من أحد","https://www.aldiwan.net/poem16764.html","البسيط"],[447,"يا خالق الخلق يا من جوده الجود","https://www.aldiwan.net/poem14289.html","البسيط"],[447,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[556,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[563,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[567,"دعوت جنح الدجى مولاي مبتهلا","https://www.aldiwan.net/poem52736.html","البسيط"],[567,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[567,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59386","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112738","الكامل"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205528","الكامل"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188166","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27698","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135159","الكامل"],[4691,"خذ ما تريد لك الفدا","https://www.poetsgate.com/ViewPoem.aspx?id=125341",""],[4691,"أنتِ القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=149779",""],[4791,"سحابة الغره","https://www.poetsgate.com/ViewPoem.aspx?id=36948",""],[4968,"قل ياسميرة","https://www.poetsgate.com/ViewPoem.aspx?id=206750",""],[4978,"لا بل على الناس يا أستاذتي تيهي","https://www.poetsgate.com/ViewPoem.aspx?id=177629",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5122,"(( روح هشه ))","https://www.poetsgate.com/ViewPoem.aspx?id=24264",""],[5190,"شهر زاد","https://www.poetsgate.com/ViewPoem.aspx?id=153472",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5277,"صبا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=193677",""],[5277,"زاجلةٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198942",""],[5277,"أطيافُ ربيعيةِ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206790",""],[5282,"ففروا الى الله","https://www.poetsgate.com/ViewPoem.aspx?id=215075",""],[5295,"بَيْنَ الثُّلُوجِ","https://www.poetsgate.com/ViewPoem.aspx?id=177209",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5431,"لك سحنة الخنزير حين تباغتُ","https://www.poetsgate.com/ViewPoem.aspx?id=194352",""],[5431,"ويشق قلبي بدرها المتكور","https://www.poetsgate.com/ViewPoem.aspx?id=196923",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5480,"دمع اللقى","https://www.poetsgate.com/ViewPoem.aspx?id=25515",""],[5491,"أنت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=215088",""],[5595,"لا لنْ أبيعَ ضمائِري لوشاة","https://www.poetsgate.com/ViewPoem.aspx?id=150627",""],[5674,"ليل الصمت خناس","https://www.poetsgate.com/ViewPoem.aspx?id=198678",""],[5847,"عاشق العلم","https://www.poetsgate.com/ViewPoem.aspx?id=45480",""],[5934,"من وسط لندن لين حي السويدي","https://www.poetsgate.com/ViewPoem.aspx?id=35633",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6125,"أنتِ القصيدُ وأنتِ الوزنُ والقافيةْ","https://www.poetsgate.com/ViewPoem.aspx?id=210968",""],[6189,"بهو الفيروز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83569&r=&rc=36",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""]],"verses":[["انت القتيل الذي لا قبر يجمعه","من بعدما مزقته اظفر النوب",0,"ب",1,0],["أنت القتيلُ إذا حَيِيتَ مُذَمَّماً","فاذهبْ فما في الصّالحين مُذَمَّمُ",1,"م",1,0],["أَنتَ القَتيلُ وَما جَنَيتَ وَإِنَّما","صادَفتَ مَن تَشقى فَيَنعَمُ بالا",2,"ل",2,0],["أنتَ القَتِيْلُ بأيّ مَنْ أحبَبْتَهُ","فاختر لنَفْسِكَ في الهوى من تصطفي",3,"ف",2,0],["أَنتَ القَريبُ المُجيبُ المُستَغاثُ بِهِ","وَأَنتَ يا رَبِّ لِلراجينَ بِالرَصَدِ",4,"د",1,0],["أنت القديم وما في ذاك من غير","والمحدث الشيء والمحدوث منفود",5,"د",1,0],["أنت القدير بلا عون ولا وزر","أنت الغفور الرحيم الفرد مبتدعا",6,"ع",2,0],["أنتَ ألقيتني على ذِرْوةِ الأَمْ","نِ وقد كان لِي الحِذارُ نديما",7,"م",2,0],["أنت القوي على ضعفي تدبرني","في كل أمر وعما شئت تغنيني",8,"ن",2,0],["أنت القديرُ الذي تُخشَى مَهابتُهُ","وتَرجُفُ الأرضُ منهُ والسَّما وجَلا",9,"ل",2,0],["أنتَ القديرُ متى دَعاكَ ضعيفُنا","أن تبسطَ الأيديْ إلى إمدادِهِ",10,"د",2,0],["أَنتَ القديرُ الذي الأَفلاكُ في يَدِهِ","تُطوى ومنهُ جِبالُ الأرض تَرتَعِدُ",11,"د",1,0],["أنْتَ القَرِيب المُجِيب المُسْتَغَاث إذَا","عَزَّ النصيرُ وَخَانَ الصَّبْرُ وَالجَلَدُ",12,"د",1,0],["انت القوي انت المتين كذا الولي","فلا تكلنا للضعيف الخال",13,"ل",1,0],["أنت القتيل بأي من أحببته","إن كان ينصف أو يكن لم ينصف",14,"ف",1,0],["أنت القيادة كم يزهو الوجود بها","ويفخر الكون والإسلام والعرب",15,"ب",1,0],["أنت القدير عليه","فكن بعقدي عفوّا",16,"و",2,0],["أنت القريبُ لو بعدتُ بالذنوبْ","أنت مجيب ذي الذنوب في الغيوبْ",17,"ب",1,0],["أنت القناطرُ والبحورُ وسَيْبُها","رحب المناخ لآب رأدِ النافش",18,"ش",1,0],["أنت القصيدة وردة","والقلب يكتبها إليك",19,"ك",1,0],["أنت القصيدة والقوافي والرؤى","لولاك أشعاري بلا معنى",20,"ن",2,1],["أنت القمر علَّق بمتن السما وارق","ابْلَغْ ورا حدّ العيون وتسوَّر",21,"ر",1,0],["أنتِ القَصيِدَةُ بَيتُها وعَمُودُهَا","وَإلَيْكِ شَاعِرَتِي شَذَا أشْعَارِي",22,"ر",2,0],["أنت القوية في دين وفي خلقٍ","كوني المثال لنا للعفو نرويه",23,"ي",2,0],["أنتِ الْقَصَائِدُ وَالْمَعَانِي فِيْ غَدِيْ","مِنْ كَاسِ جِيْدكِ هَامَتِ الأشْعَارُ",24,"ر",1,0],["أنت القساوة والحلى والدماثه","والحب والاخلاص زايد مغشه",25,"ش",2,0],["أنت القصيدة في أبهى مفاتنها","تغري يراعي فيسري نبض أبياتي",26,"ت",2,0],["أنت القَريبةُ وَالحَبيَبةُ وَالَهوى","وَحَقيقَةٌ بانَتْ بِغَيرِ سَرابِ",27,"ب",1,0],["أنتِ القصيدةُ والجمالُ بمتنِها","وأنا لحكمِ الحسنِ منكِ لأخضعُ",28,"ع",1,0],["أنت القوافي كلها بقصيدتي","أحبيبتي.......ألديكِ ثمَّ مزيدُ؟",29,"د",1,0],["أنتِ القصيدةُ تزدهي في خدرِها","ما رامَ \" طرفةُ\" مثلَها أو \"جرْوَلُ\"",30,"ل",1,0],["أنتَ القويُ الذي لا شَىء يُعجِزُهُ","والعبدُ دونكُ لا يُبقِي ولا يَدعُ",31,"ع",1,0],["أَنْتَ القَصِيدُ خَتمْتُ بَعْدكَ جُمْلَتي","وهَواكَ حينَ بَدَأتُ كانَ الْمُبْتَدَا",32,"د",2,0],["أنت القدير على جبري بوصلك لي","أنت العليم بأسرار الخفيات",33,"ت",1,0],["أنت القميئ من الدنائة ترتوي","وعلى لسانك خسةٌ وزوافتُ",34,"ت",1,0],["أنت القديم بذات عشق سيدي","أنت العتيق من المحبة جوهر",35,"ر",1,0],["أنت القريب وللجوارح مالك","متأمر ...متنمرٌ..متجبرُ",35,"ر",1,0],["أنت القصائد أعلى الأفقِ شاردة","منك التجلّي بطور الشوق مكتحلُ",36,"ل",1,0],["أنت القمر وآنا على ضَو مسراك،،","قلبي صويب ٍ وأنت وحدك طبيبي",37,"ب",2,0],["أنت القصيد الذي في القلب أقصدُهُ","النبضُ يوحيه والأ نفاسُ تنشدُهُ",38,"د",2,1],["أنتَ القريبُ إليّ حينَ دعُوتكَ","فتكسّرتْ كلّ القيودِ بذاتي",39,"ت",2,0],["أنت القريضُ وقرطاسي وذاكرتي","يبقى بصدري وذي الأضلاع حرّاسُ",40,"س",1,0],["أنت القريب من المجيب فسل تنل","من فضل وهاب كريم أيادي",41,"د",2,0],["انت القمر من طلتك صار مفضوح","وكل الكواكب في جمالك تشيدي",42,"د",2,0],["أنتِ القصيدةُ لي ما كنتُ أنسبها","حتى أصيرَ إلى الأشعارِ أنتسبُ",43,"ب",1,0],["أنت القويّ على شر الزمان بنا","لطفا فذا الأعور الدجال يحتربُ",44,"ب",1,0],["أنتِ القصيدُ وأنتِ الوزنُ والقافيةْ","أنتِ السَّماءُ وأنتِ النَّجمُ والباديةْ",45,"ي",2,1],["أنتَ القصيدة ، فيك رعشتها","فيك الضنى ، والزهو ، والترف",46,"ف",1,1],["أنتِ القصيد ،، فما أنا لولا الهوى؟","ما الشّعر؟ ما الكلمات؟ ما الألقاب؟",47,"ب",1,0],["أنت القدير إليك نرفع همنا","فرّج كروباً مالها إحصاء",48,"ا",2,0],["أنت القدير ومن سواك أرومه","فطرقت باب الحافظ الغفار",49,"ر",1,0],["أنتَ القضاءُكَ ما نامتْ لهُ مُثُلٌ،","على التِّراتِ ، ولا عَيَّتْ بهِ البُكَرُ!‏",50,"ر",1,0],["أنت ألقيته بكفيك في النار","وأحرقته فؤاداً وعضوا",51,"و",2,0]]}