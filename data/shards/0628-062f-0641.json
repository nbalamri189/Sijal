{"poems":[[47,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[87,"يا ثَرَى النيلِ، في نَواحيكَ طيرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9621&r=&rc=111",""],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89398","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62829","الخفيف"],[3589,"","https://poetry.dctabudhabi.ae/diwan/poem/34906","الوافر"],[5055,"أذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=104032",""],[5057,"أبكيك بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=197173",""],[5368,"يا صرخة المخنوق","https://www.poetsgate.com/ViewPoem.aspx?id=186650",""],[5387,"أعودُ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53780",""],[5431,"حبكِ ثابتي حاءٌ...وباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=183467",""],[5764,"سوء حظي شاعره","https://www.poetsgate.com/ViewPoem.aspx?id=137075",""]],"verses":[["بِدَفعٍ عَنِ الحاجاتِ حَتّى كَأَنَّما","سُئِلتُم أَناسِيَّ الحِداقِ اللَوامِحِ",0,"ح",1,0],["بِدِفَّيهِ آثارُ النُسوعِ كَأَنَّها","مَجَرُّ سُيولٍ في الصَفا حينَ خَدَّدا",1,"د",2,0],["بدفنُ الصالحين في ورقِ المصْ","حَفِ، أَو في صحائف الإنجيل",2,"ل",1,0],["بِدفعَةٍ لَم تُيَسَّر","لِغَيرِ طَبعي وَفِكري",3,"ر",2,0],["بدفاع يمل البيد رجالا","وهجوم يملأ البطحاء جردا",4,"د",2,0],["بدفع بقاياها وأموالها وما","عليها فثمن المال والمال ولاني",5,"ن",2,0],["بدَفينِ الحِبالِ تخدعُها طَوراً","وطوراً بالنّزعِ والإغْراقِ",6,"ق",1,0],["بِدَفعِ الذَمِّ عَن حَسَبي بِمالي","وَزَبّوناتِ أَشوَسَ تَيَّجانِ",7,"ن",1,0],["بْدفنك يا قلب لو تسمع نداك","وبحْمدك يا رب واختمة بْيقين",8,"ن",1,0],["بدفعِكَ النّارَ عنّي زِدتها لهباً","أيُخمِدُ النارَ من بالزيتِ يُطفيها ؟!",9,"ي",3,0],["بدَفاتِر السَّلْوَى أَبوءُ بلَوْعتِي","ما نِلْتُ غَيْرَ وقودِها لجِراحي",10,"ح",2,0],["بدفئهما شموسُ كنتُ أجهلها","تساوي ملئ هذا الكون من ذهبِ",11,"ب",1,0],["بدفع الظلم يزدهرُ البقاءُ","وحق شعوبنا فجرٌ مضاءُ",12,"ا",2,1],["بدفنك مابين أحضان السطور","وبنزفك لاوجآع وقتي خآطره",13,"ر",2,0]]}