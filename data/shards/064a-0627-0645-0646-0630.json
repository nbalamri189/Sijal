{"poems":[[107,"يا منذر السوء غض الصوت إن لنا","https://www.aldiwan.net/poem43124.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[92,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[107,"يا منذر السور غض الصوت إن لنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54937&r=&rc=107",""],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[580,"أغناك طرفك أن تسل الأبترا","https://www.aldiwan.net/poem2954.html","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108639","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100952","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100989","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101812","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137132",""],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146373","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110221","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91316","الكامل"],[4830,"غُصّةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=193542",""],[5064,"قالَتْ: تضوَّعتُ مِنْ نجد","https://www.poetsgate.com/ViewPoem.aspx?id=199137",""],[5212,"وَدَّعت دجلةَ","https://www.poetsgate.com/ViewPoem.aspx?id=212026",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""]],"verses":[["يا مُنذِرَ السوءِ غُضَّ الصَوتَ إِنَّ لَنا","رَبّاً يَرُدُّ الأَذى عَنّا وَيَحيمنا",0,"ن",2,1],["يا مُنذِرَ السوءِ لا تُحدِث لَنا فَزَعاً","يا مُنذِرَ السوءِ إِنَّ اللَهَ يَكفينا",0,"ن",2,0],["يَا مَنْ ذوَت فِي زَهْرَةِ العُمْرِ مَا","أَقْسَى الرَّدَى فِي زهْرَةِ العُمْرِ",1,"ر",1,0],["يا من ذكرناه والالبابُ طائشةٌ","ظلم على خطرات الأنس تنسانا",2,"ن",2,0],["يا منذر السور غض الصوت إن لنا","ربا يرد الأذى عنا ويحمينا",3,"ن",2,1],["يا مَن ذخَرْتُ ولاءه زَمناً","من أجلِ يومٍ يَحمَدُ الذُّخرا",4,"ر",2,0],["يا مُنذرِي بالعذْلِ لستُ وخدُّه","كشقائقِ النُّعمانِ أَخْشى المنذِرا",5,"ر",2,0],["يا من ذكا النادي بطيب حديثه","وترنم الحادي به والساري",6,"ر",2,0],["يا منذرَ الدنيا بقوته","إن الزمان بأهله انقلبا",7,"ب",2,0],["يا منذر الأفلاك هل","للأرض دونك من نصير",8,"ر",1,0],["يا من ذكرت دلالها قل لي متى","تركت ربيبات الجمال دلاها",9,"ه",2,0],["يا من ذوى غصن لبنان لغيبته","عنه ولما اتاه اورق العود",10,"د",1,0],["يا مَنْ ذنوبي عنده الفضل الذي","لولا مَزِيَّتُه لكان مُسالمي",11,"م",2,0],["يا من ذَكاه في الحِجَى أَربى وأَنمى","ماذا يُرادِف بالنِدا أَي إِقصِدِ الما",12,"م",2,1],["يا منذري بِالسَيف مِن لَحظاتهِ","وَشقائقُ النعمان في وَجناتهِ",13,"ت",2,1],["يامَنْ ذبحتمْ على الأوتارِ أغنيتي","حتى توارى بشجوٍ لحنُها العَذِبُ",14,"ب",1,0],["يا مَنْ ذكرتُمْ صِفاتِ المَوتِ لَمْ تصِفُوا","بأنَّ للمَوتِ قَدًّا كانَ ميَّاسَا",15,"س",2,0],["يا مَنْ ذَكرتَ السِّبط في أَرضِ البَلا","أحزنتَ نَفسي مُذْ قَرأتَ لِكربلا",16,"ل",2,1],["يا مَنْ ذُخِرتَ لهذا، قد أسخْتَ بها","قاعاً وخلقاً وقد صاروا لها حطبا",17,"ب",2,0]]}